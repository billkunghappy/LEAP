theorem wc_lpl_linalg (E : Type u) [Field E] (N : ℕ) (hN : 1 ≤ N)
    (v₀ v₁ : Fin (N + 1) × Fin (N + 1) → E)
    (hind : ∀ l₀ l₁ : E, (∀ q, l₀ * v₀ q + l₁ * v₁ q = 0) → l₀ = 0 ∧ l₁ = 0) :
    ∃ (ψ : MvPolynomial (Fin 2) E →ₐ[E] MvPolynomial (Fin (wcLdnmM N + 1)) E)
      (L : Fin (wcLdnmM N - 1) → MvPolynomial (Fin (wcLdnmM N + 1)) E),
      (∀ (n : ℕ) (b : MvPolynomial (Fin 2) E), b.IsHomogeneous n → (ψ b).IsHomogeneous n) ∧
      (∀ b, MvPolynomial.aeval (fun r : Fin (wcLdnmM N + 1) =>
          MvPolynomial.C (v₁ ((wcLdnmIdx N).symm r)) * (MvPolynomial.X 0 : MvPolynomial (Fin 2) E) -
            MvPolynomial.C (v₀ ((wcLdnmIdx N).symm r)) * MvPolynomial.X 1) (ψ b) = b) ∧
      (∀ a, (L a).IsHomogeneous 1) ∧ LinearIndependent E L ∧
      (∀ a, MvPolynomial.aeval (fun r : Fin (wcLdnmM N + 1) =>
          MvPolynomial.C (v₁ ((wcLdnmIdx N).symm r)) * (MvPolynomial.X 0 : MvPolynomial (Fin 2) E) -
            MvPolynomial.C (v₀ ((wcLdnmIdx N).symm r)) * MvPolynomial.X 1) (L a) = 0) ∧
      ∀ s : MvPolynomial (Fin (wcLdnmM N + 1)) E,
        s - ψ (MvPolynomial.aeval (fun r : Fin (wcLdnmM N + 1) =>
          MvPolynomial.C (v₁ ((wcLdnmIdx N).symm r)) * (MvPolynomial.X 0 : MvPolynomial (Fin 2) E) -
            MvPolynomial.C (v₀ ((wcLdnmIdx N).symm r)) * MvPolynomial.X 1) s) ∈
          Ideal.span (Set.range L) :=
by
  have key : ∀ (M : ℕ) (idx : Fin (N + 1) × Fin (N + 1) ≃ Fin (M + 1)),
    ∃ (ψ : MvPolynomial (Fin 2) E →ₐ[E] MvPolynomial (Fin (M + 1)) E)
      (L : Fin (M - 1) → MvPolynomial (Fin (M + 1)) E),
      (∀ (n : ℕ) (b : MvPolynomial (Fin 2) E), b.IsHomogeneous n → (ψ b).IsHomogeneous n) ∧
      (∀ b, MvPolynomial.aeval (fun r : Fin (M + 1) =>
          MvPolynomial.C (v₁ (idx.symm r)) * (MvPolynomial.X 0 : MvPolynomial (Fin 2) E) -
            MvPolynomial.C (v₀ (idx.symm r)) * MvPolynomial.X 1) (ψ b) = b) ∧
      (∀ a, (L a).IsHomogeneous 1) ∧ LinearIndependent E L ∧
      (∀ a, MvPolynomial.aeval (fun r : Fin (M + 1) =>
          MvPolynomial.C (v₁ (idx.symm r)) * (MvPolynomial.X 0 : MvPolynomial (Fin 2) E) -
            MvPolynomial.C (v₀ (idx.symm r)) * MvPolynomial.X 1) (L a) = 0) ∧
      ∀ s : MvPolynomial (Fin (M + 1)) E,
        s - ψ (MvPolynomial.aeval (fun r : Fin (M + 1) =>
          MvPolynomial.C (v₁ (idx.symm r)) * (MvPolynomial.X 0 : MvPolynomial (Fin 2) E) -
            MvPolynomial.C (v₀ (idx.symm r)) * MvPolynomial.X 1) s) ∈
          Ideal.span (Set.range L) := open MvPolynomial in by
    intro M idx
    classical

    have hminor : ∃ q₀ q₁, v₁ q₀ * v₀ q₁ - v₀ q₀ * v₁ q₁ ≠ 0 := by
      by_contra h
      push_neg at h
      by_cases h0 : ∀ q, v₀ q = 0
      · have := (hind 1 0 (fun q => by rw [h0 q]; ring)).1
        exact one_ne_zero this
      · push_neg at h0
        obtain ⟨p, hp⟩ := h0
        have := (hind (v₁ p) (-v₀ p) (fun q => by linear_combination h p q)).2
        exact hp (neg_eq_zero.mp this)
    obtain ⟨q₀, q₁, hD⟩ := hminor
    obtain ⟨r₀, rfl⟩ := idx.symm.surjective q₀
    obtain ⟨r₁, rfl⟩ := idx.symm.surjective q₁
    have hr : r₀ ≠ r₁ := by
      rintro rfl; apply hD; ring
    set u := (v₁ (idx.symm r₀) * v₀ (idx.symm r₁) - v₀ (idx.symm r₀) * v₁ (idx.symm r₁))⁻¹ with hu
    have huD : u * (v₁ (idx.symm r₀) * v₀ (idx.symm r₁) - v₀ (idx.symm r₀) * v₁ (idx.symm r₁)) = 1 :=
      inv_mul_cancel₀ hD
    have hC1 : (C u : MvPolynomial (Fin 2) E) * (C (v₁ (idx.symm r₀)) * C (v₀ (idx.symm r₁)) -
        C (v₀ (idx.symm r₀)) * C (v₁ (idx.symm r₁))) = 1 := by
      rw [← map_mul, ← map_mul, ← map_sub, ← map_mul, huD, map_one]
    have hC2 : (C u : MvPolynomial (Fin (M + 1)) E) * (C (v₁ (idx.symm r₀)) * C (v₀ (idx.symm r₁)) -
        C (v₀ (idx.symm r₀)) * C (v₁ (idx.symm r₁))) = 1 := by
      rw [← map_mul, ← map_mul, ← map_sub, ← map_mul, huD, map_one]

    obtain ⟨g₀, hg₀⟩ : ∃ g : MvPolynomial (Fin (M + 1)) E,
        g = C (u * v₀ (idx.symm r₁)) * X r₀ - C (u * v₀ (idx.symm r₀)) * X r₁ := ⟨_, rfl⟩
    obtain ⟨g₁, hg₁⟩ : ∃ g : MvPolynomial (Fin (M + 1)) E,
        g = C (u * v₁ (idx.symm r₁)) * X r₀ - C (u * v₁ (idx.symm r₀)) * X r₁ := ⟨_, rfl⟩
    obtain ⟨ψ, hψ⟩ : ∃ ψ : MvPolynomial (Fin 2) E →ₐ[E] MvPolynomial (Fin (M + 1)) E,
        ψ = aeval ![g₀, g₁] := ⟨_, rfl⟩
    have hψ0 : ψ (X 0) = g₀ := by rw [hψ, aeval_X]; rfl
    have hψ1 : ψ (X 1) = g₁ := by rw [hψ, aeval_X]; rfl
    have hψC : ∀ x : E, ψ (C x) = C x := fun x => ψ.commutes x
    have hhg₀ : g₀.IsHomogeneous 1 := by
      rw [hg₀]; exact (isHomogeneous_C_mul_X _ _).sub (isHomogeneous_C_mul_X _ _)
    have hhg₁ : g₁.IsHomogeneous 1 := by
      rw [hg₁]; exact (isHomogeneous_C_mul_X _ _).sub (isHomogeneous_C_mul_X _ _)
    have hψhom : ∀ (n : ℕ) (b : MvPolynomial (Fin 2) E), b.IsHomogeneous n →
        (ψ b).IsHomogeneous n := by
      intro n b hb
      have := hb.aeval ![g₀, g₁] (Fin.forall_fin_two.mpr ⟨hhg₀, hhg₁⟩)
      rw [one_mul] at this
      rw [hψ]; exact this
    have hφψ : ∀ b, MvPolynomial.aeval (fun r : Fin (M + 1) =>
            MvPolynomial.C (v₁ (idx.symm r)) * (MvPolynomial.X 0 : MvPolynomial (Fin 2) E) -
              MvPolynomial.C (v₀ (idx.symm r)) * MvPolynomial.X 1) (ψ b) = b := by
      have hcomp : (MvPolynomial.aeval (fun r : Fin (M + 1) =>
            MvPolynomial.C (v₁ (idx.symm r)) * (MvPolynomial.X 0 : MvPolynomial (Fin 2) E) -
              MvPolynomial.C (v₀ (idx.symm r)) * MvPolynomial.X 1)).comp ψ = AlgHom.id E _ := by
        apply MvPolynomial.algHom_ext
        intro i
        fin_cases i
        · simp only [AlgHom.comp_apply, AlgHom.id_apply]
          rw [show ((⟨0, by norm_num⟩ : Fin 2)) = 0 from rfl, hψ0, hg₀]
          simp only [map_sub, map_mul, aeval_C, aeval_X, algebraMap_eq]
          linear_combination (X 0 : MvPolynomial (Fin 2) E) * hC1
        · simp only [AlgHom.comp_apply, AlgHom.id_apply]
          rw [show ((⟨1, by norm_num⟩ : Fin 2)) = 1 from rfl, hψ1, hg₁]
          simp only [map_sub, map_mul, aeval_C, aeval_X, algebraMap_eq]
          linear_combination (X 1 : MvPolynomial (Fin 2) E) * hC1
      intro b
      exact AlgHom.congr_fun hcomp b
    have hθ : ∀ r, ψ (C (v₁ (idx.symm r)) * (X 0 : MvPolynomial (Fin 2) E) - C (v₀ (idx.symm r)) * X 1)
        = C (v₁ (idx.symm r)) * g₀ - C (v₀ (idx.symm r)) * g₁ := by
      intro r
      rw [map_sub, map_mul, map_mul, hψC, hψC, hψ0, hψ1]
    have hθ0 : ψ (C (v₁ (idx.symm r₀)) * (X 0 : MvPolynomial (Fin 2) E) - C (v₀ (idx.symm r₀)) * X 1)
        = X r₀ := by
      rw [hθ, hg₀, hg₁]
      simp only [map_mul]
      linear_combination (X r₀ : MvPolynomial (Fin (M + 1)) E) * hC2
    have hθ1 : ψ (C (v₁ (idx.symm r₁)) * (X 0 : MvPolynomial (Fin 2) E) - C (v₀ (idx.symm r₁)) * X 1)
        = X r₁ := by
      rw [hθ, hg₀, hg₁]
      simp only [map_mul]
      linear_combination (X r₁ : MvPolynomial (Fin (M + 1)) E) * hC2

    have hcard : Fintype.card {r : Fin (M + 1) // r ≠ r₀ ∧ r ≠ r₁} = M - 1 := by
      rw [Fintype.card_subtype]
      have : (Finset.univ.filter fun r : Fin (M + 1) => r ≠ r₀ ∧ r ≠ r₁) =
          (Finset.univ.erase r₀).erase r₁ := by
        ext r; simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_erase]; tauto
      rw [this, Finset.card_erase_of_mem (by simp [hr.symm]), Finset.card_erase_of_mem (by simp),
        Finset.card_univ, Fintype.card_fin]
      omega
    set e := (Fintype.equivFinOfCardEq hcard).symm with he
    obtain ⟨L, hL⟩ : ∃ L : Fin (M - 1) → MvPolynomial (Fin (M + 1)) E, ∀ a, L a =
        X (e a).1 - ψ (C (v₁ (idx.symm (e a).1)) * (X 0 : MvPolynomial (Fin 2) E) -
          C (v₀ (idx.symm (e a).1)) * X 1) := ⟨_, fun a => rfl⟩
    have hcoef : ∀ (r s : Fin (M + 1)), s ≠ r₀ → s ≠ r₁ →
        (ψ (C (v₁ (idx.symm r)) * (X 0 : MvPolynomial (Fin 2) E) -
          C (v₀ (idx.symm r)) * X 1)).coeff (Finsupp.single s 1) = 0 := by
      intro r s h0 h1
      have hs0 : (Finsupp.single r₀ 1 : Fin (M + 1) →₀ ℕ) ≠ Finsupp.single s 1 :=
        fun h => h0 ((Finsupp.single_left_inj one_ne_zero).mp h).symm
      have hs1 : (Finsupp.single r₁ 1 : Fin (M + 1) →₀ ℕ) ≠ Finsupp.single s 1 :=
        fun h => h1 ((Finsupp.single_left_inj one_ne_zero).mp h).symm
      rw [hθ, hg₀, hg₁]
      simp only [coeff_sub, coeff_C_mul, coeff_X', if_neg hs0, if_neg hs1, mul_zero, sub_zero]
    refine ⟨ψ, L, hψhom, hφψ, ?_, ?_, ?_, ?_⟩
    · intro a
      rw [hL]
      exact (isHomogeneous_X E _).sub
        (hψhom 1 _ ((isHomogeneous_C_mul_X _ _).sub (isHomogeneous_C_mul_X _ _)))
    · rw [Fintype.linearIndependent_iff]
      intro g hg b
      have h2 := congrArg
        (fun p : MvPolynomial (Fin (M + 1)) E => p.coeff (Finsupp.single (e b).1 1)) hg
      try simp only at h2
      rw [coeff_sum] at h2
      change _ = (0 : E) at h2
      simp only [coeff_smul, smul_eq_mul, hL, coeff_sub,
        hcoef _ (e b).1 (e b).2.1 (e b).2.2, sub_zero] at h2
      rw [Finset.sum_eq_single b] at h2
      · rw [coeff_X', if_pos rfl, mul_one] at h2
        exact h2
      · intro i _ hib
        rw [coeff_X', if_neg, mul_zero]
        intro h
        exact hib (e.injective (Subtype.ext ((Finsupp.single_left_inj one_ne_zero).mp h)))
      · intro h; exact absurd (Finset.mem_univ b) h
    · intro a
      rw [hL, map_sub, hφψ, aeval_X, sub_self]
    · intro s
      set J := Ideal.span (Set.range L) with hJ
      have hπ : (Ideal.Quotient.mkₐ E J).comp (ψ.comp (MvPolynomial.aeval (fun r : Fin (M + 1) =>
            MvPolynomial.C (v₁ (idx.symm r)) * (MvPolynomial.X 0 : MvPolynomial (Fin 2) E) -
              MvPolynomial.C (v₀ (idx.symm r)) * MvPolynomial.X 1))) = Ideal.Quotient.mkₐ E J := by
        apply MvPolynomial.algHom_ext
        intro r
        simp only [AlgHom.comp_apply, aeval_X]
        by_cases h0 : r = r₀
        · subst h0; rw [hθ0]
        by_cases h1 : r = r₁
        · subst h1; rw [hθ1]
        have hmem : X r - ψ (C (v₁ (idx.symm r)) * (X 0 : MvPolynomial (Fin 2) E) -
            C (v₀ (idx.symm r)) * X 1) ∈ J := by
          apply Ideal.subset_span
          refine ⟨e.symm ⟨r, h0, h1⟩, ?_⟩
          rw [hL]
          simp only [Equiv.apply_symm_apply]
        try simp only [Ideal.Quotient.mkₐ_eq_mk]
        exact (Ideal.Quotient.eq.mpr hmem).symm
      have h3 := AlgHom.congr_fun hπ s
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at h3
      exact Ideal.Quotient.eq.mp h3.symm
  exact key (wcLdnmM N) (wcLdnmIdx N)

theorem wc_lpl_proj_map_range {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
    [CommRing B] [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜]
    [GradedRing ℬ] (f : 𝒜 →+*ᵍ ℬ)
    (hf : HomogeneousIdeal.irrelevant ℬ ≤ HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜))
    (ψ : ℬ →+*ᵍ 𝒜) {ι : Type} (L : ι → A) (hL : ∀ i, f (L i) = 0)
    (hJ : ∀ a : A, a - ψ (f a) ∈ Ideal.span (Set.range L))
    (hirr : ∀ a ∈ HomogeneousIdeal.irrelevant 𝒜, f a ∈ HomogeneousIdeal.irrelevant ℬ) :
    Set.range (Proj.map f hf) = {x | ∀ i, x ∉ Proj.basicOpen 𝒜 (L i)} :=
by
  classical
  have s2 : ∀ (y : Proj ℬ) (s : A), s ∈ (Proj.map f hf y).asHomogeneousIdeal ↔
      f s ∈ y.asHomogeneousIdeal := by
    intro y s
    have h := Proj.map_preimage_basicOpen f hf s
    have h2 : y ∈ Proj.map f hf ⁻¹ᵁ Proj.basicOpen 𝒜 s ↔ y ∈ Proj.basicOpen ℬ (f s) := by
      rw [h]
    rw [Scheme.Hom.mem_preimage, Proj.mem_basicOpen, Proj.mem_basicOpen] at h2
    exact not_iff_not.mp h2
  ext x
  simp only [Set.mem_range, Set.mem_setOf_eq, Proj.mem_basicOpen, not_not]
  constructor
  · rintro ⟨y, rfl⟩ i
    rw [s2, hL i]
    exact zero_mem _
  · intro hx
    have hJx : Ideal.span (Set.range L) ≤ x.asHomogeneousIdeal.toIdeal := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      exact hx i
    have key : ∀ a : A, a ∈ x.asHomogeneousIdeal ↔ ψ (f a) ∈ x.asHomogeneousIdeal := by
      intro a
      have h : a - ψ (f a) ∈ x.asHomogeneousIdeal.toIdeal := hJx (hJ a)
      constructor
      · intro ha
        have ha' : a ∈ x.asHomogeneousIdeal.toIdeal := ha
        have e : ψ (f a) = a - (a - ψ (f a)) := by ring
        show ψ (f a) ∈ x.asHomogeneousIdeal.toIdeal
        rw [e]
        exact Ideal.sub_mem _ ha' h
      · intro ha
        have ha' : ψ (f a) ∈ x.asHomogeneousIdeal.toIdeal := ha
        have e : a = (a - ψ (f a)) + ψ (f a) := by ring
        show a ∈ x.asHomogeneousIdeal.toIdeal
        rw [e]
        exact Ideal.add_mem _ h ha'
    let Q : HomogeneousIdeal ℬ := HomogeneousIdeal.comap ψ x.asHomogeneousIdeal
    have hprime : Q.toIdeal.IsPrime := by
      have := x.isPrime
      show (HomogeneousIdeal.comap ψ x.asHomogeneousIdeal).toIdeal.IsPrime
      rw [HomogeneousIdeal.toIdeal_comap]
      exact Ideal.comap_isPrime _ _
    have hnirr : ¬ HomogeneousIdeal.irrelevant ℬ ≤ Q := by
      intro hle
      apply x.not_irrelevant_le
      intro a ha
      exact (key a).mpr (hle (hirr a ha))
    refine ⟨⟨Q, hprime, hnirr⟩, ?_⟩
    apply ProjectiveSpectrum.ext
    apply HomogeneousIdeal.ext
    ext s
    have := s2 ⟨Q, hprime, hnirr⟩ s
    exact this.trans (key s).symm

theorem wc_lpl_germ_linear (E : Type u) [Field E] (e : Fin 2) (t : wcProjK E 1)
    (he : t ∈ wcSgD E 1 e) (c₀ c₁ : E)
    (hXe : (MvPolynomial.X e : MvPolynomial (Fin 2) E) ∈ MvPolynomial.homogeneousSubmodule (Fin 2) E 1)
    (hx : MvPolynomial.C c₀ * MvPolynomial.X 0 - MvPolynomial.C c₁ * MvPolynomial.X 1 ∈
      MvPolynomial.homogeneousSubmodule (Fin 2) E (1 • 1)) :
    ((wcProjK E 1).presheaf.germ (wcSgD E 1 e) t he).hom
      ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin 2) E) (MvPolynomial.X e)).hom
        (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin 2) E) hXe 1
          (MvPolynomial.C c₀ * MvPolynomial.X 0 - MvPolynomial.C c₁ * MvPolynomial.X 1) hx)) =
      wcLdpConst E (wcProjKStr E 1) t c₀ *
          ((wcProjK E 1).presheaf.germ (wcSgD E 1 e) t he).hom (wcSgE E 1 e 0) -
        wcLdpConst E (wcProjKStr E 1) t c₁ *
          ((wcProjK E 1).presheaf.germ (wcSgD E 1 e) t he).hom (wcSgE E 1 e 1) :=
by

  have hconst : ∀ (K : Type u) [Field K] (m : ℕ) (a : Fin (m + 1)) (p : wcProjK K m)
      (hp : p ∈ wcSgD K m a) (c : K),
      ((wcProjK K m).presheaf.germ (wcSgD K m a) p hp).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
            (MvPolynomial.X a)).hom
          (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0) c))) =
        wcLdpConst K (wcProjKStr K m) p c := by
    intro K _ m a p hp c
    have f_deg : (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a)
    have h1 : (wcSgD K m a).ι =
        Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a) ≫
          Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a)
            f_deg one_pos := by
      rw [← Proj.basicOpenIsoSpec_hom _ _ f_deg one_pos,
        ← Proj.basicOpenIsoSpec_inv_ι _ _ f_deg one_pos, Iso.hom_inv_id_assoc]
    have h2 : (wcSgD K m a).ι ≫ wcProjKStr K m =
        Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a) ≫
          Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)) ≫
            CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
              (Submonoid.powers (MvPolynomial.X a)))) := by
      rw [h1, Spec.map_comp, ← Proj.awayι_toSpecZero _ _ f_deg one_pos]
      simp only [wcProjKStr, Category.assoc]
    have h4 : (Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
          (MvPolynomial.X a)).appTop =
        (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a)))).hom ≫
          Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a) ≫
          (wcSgD K m a).topIso.inv :=
      Proj.basicOpenToSpec_app_top _ _
    have H : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ (wcProjKStr K m).appTop ≫
          (wcSgD K m a).ι.appTop =
        CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)) ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))) ≫
          Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a) ≫
          (wcSgD K m a).topIso.inv := by
      rw [← Scheme.Hom.comp_appTop, h2, Scheme.Hom.comp_appTop, ← Category.assoc,
        ← Scheme.ΓSpecIso_inv_naturality, h4]
      simp only [Category.assoc, Iso.inv_hom_id_assoc]
    have h3 : (wcSgD K m a).ι.appTop ≫ (wcSgD K m a).topIso.hom =
        (wcProjK K m).presheaf.map (homOfLE (le_top : wcSgD K m a ≤ ⊤)).op := by
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
      first
        | (erw [← Functor.map_comp]; rfl)
        | (simp only [← Functor.map_comp]; rfl)
        | exact ((wcProjK K m).presheaf.map_comp _ _).symm
    have H' : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ (wcProjKStr K m).appTop ≫
          (wcProjK K m).presheaf.map (homOfLE (le_top : wcSgD K m a ≤ ⊤)).op =
        CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)) ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))) ≫
          Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
            (MvPolynomial.X a) := by
      rw [← h3, reassoc_of% H, Iso.inv_hom_id, Category.comp_id]
    have e := congrArg (fun φ => φ.hom c) H'
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e
    have hg := congrArg (fun φ => φ.hom ((wcProjKStr K m).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom c)))
      (TopCat.Presheaf.germ_res (wcProjK K m).presheaf (homOfLE (le_top : wcSgD K m a ≤ ⊤)) p hp)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hg
    rw [← e]
    exact hg

  have hX0 : (MvPolynomial.X 0 : MvPolynomial (Fin 2) E) ∈
      MvPolynomial.homogeneousSubmodule (Fin 2) E (1 • 1) :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X E 0)
  have hX1 : (MvPolynomial.X 1 : MvPolynomial (Fin 2) E) ∈
      MvPolynomial.homogeneousSubmodule (Fin 2) E (1 • 1) :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X E 1)
  have hsub : ∀ (a b : MvPolynomial (Fin 2) E) (s : Submonoid.powers (MvPolynomial.X e :
      MvPolynomial (Fin 2) E)),
      Localization.mk (a - b) s = Localization.mk a s - Localization.mk b s := by
    intro a b s
    rw [sub_eq_add_neg a b, sub_eq_add_neg (Localization.mk a s) (Localization.mk b s),
      Localization.neg_mk, Localization.add_mk_self]
  have hfz : ∀ c : E, (HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin 2) E) (Submonoid.powers (MvPolynomial.X e))
      (algebraMap E _ c)).val =
      Localization.mk (algebraMap E (MvPolynomial (Fin 2) E) c) 1 := fun c => rfl
  have s1 : HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin 2) E) hXe 1
        (MvPolynomial.C c₀ * MvPolynomial.X 0 - MvPolynomial.C c₁ * MvPolynomial.X 1) hx =
      HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin 2) E)
          (Submonoid.powers (MvPolynomial.X e)) (algebraMap E _ c₀) *
          HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin 2) E) hXe 1
            (MvPolynomial.X 0) hX0 -
        HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin 2) E)
          (Submonoid.powers (MvPolynomial.X e)) (algebraMap E _ c₁) *
          HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin 2) E) hXe 1
            (MvPolynomial.X 1) hX1 := by
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_sub, HomogeneousLocalization.val_mul,
      HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, hfz, hfz,
      Localization.mk_mul, Localization.mk_mul, ← hsub,
      MvPolynomial.algebraMap_eq]
    all_goals first
      | rfl
      | (congr 1; apply Subtype.ext; simp)
  have k0 : ((wcProjK E 1).presheaf.germ (wcSgD E 1 e) t he).hom
      ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin 2) E) (MvPolynomial.X e)).hom
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin 2) E)
          (Submonoid.powers (MvPolynomial.X e)) (algebraMap E _ c₀))) =
      wcLdpConst E (wcProjKStr E 1) t c₀ := hconst E 1 e t he c₀
  have k1 : ((wcProjK E 1).presheaf.germ (wcSgD E 1 e) t he).hom
      ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin 2) E) (MvPolynomial.X e)).hom
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin 2) E)
          (Submonoid.powers (MvPolynomial.X e)) (algebraMap E _ c₁))) =
      wcLdpConst E (wcProjKStr E 1) t c₁ := hconst E 1 e t he c₁
  rw [s1, map_sub, map_sub, map_mul, map_mul, map_mul, map_mul, k0, k1]
  all_goals rfl

theorem wc_lpl_stalk_identity (E : Type u) [Field E] (M : ℕ)
    (φ : MvPolynomial.homogeneousSubmodule (Fin (M + 1)) E →+*ᵍ
      MvPolynomial.homogeneousSubmodule (Fin 2) E)
    (hf : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) E) ≤
      HomogeneousIdeal.map φ
        (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) E)))
    (t : wcProjK E 1) (r s : Fin (M + 1)) (hr : Proj.map φ hf t ∈ wcSgD E M r) (e : Fin 2)
    (he : t ∈ wcSgD E 1 e)
    (hXe : (MvPolynomial.X e : MvPolynomial (Fin 2) E) ∈ MvPolynomial.homogeneousSubmodule (Fin 2) E 1)
    (h₁ : φ (MvPolynomial.X r) ∈ MvPolynomial.homogeneousSubmodule (Fin 2) E (1 • 1))
    (h₂ : φ (MvPolynomial.X s) ∈ MvPolynomial.homogeneousSubmodule (Fin 2) E (1 • 1)) :
    ((Proj.map φ hf).stalkMap t).hom
        (((wcProjK E M).presheaf.germ (wcSgD E M r) (Proj.map φ hf t) hr).hom (wcSgE E M r s)) *
      ((wcProjK E 1).presheaf.germ (wcSgD E 1 e) t he).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin 2) E) (MvPolynomial.X e)).hom
          (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin 2) E) hXe 1
            (φ (MvPolynomial.X r)) h₁)) =
      ((wcProjK E 1).presheaf.germ (wcSgD E 1 e) t he).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin 2) E) (MvPolynomial.X e)).hom
          (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin 2) E) hXe 1
            (φ (MvPolynomial.X s)) h₂)) :=
by
  classical

  have s1 : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
      [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
      (f : 𝒜 →+*ᵍ ℬ)
      (hf : HomogeneousIdeal.irrelevant ℬ ≤ HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜))
      {i : ℕ} (s : A) (hs : s ∈ 𝒜 i) (t : Proj ℬ) (ht : Proj.map f hf t ∈ Proj.basicOpen 𝒜 s)
      (ht' : t ∈ Proj.basicOpen ℬ (f s)) (y : HomogeneousLocalization.Away 𝒜 s),
      ((Proj.map f hf).stalkMap t).hom (((Proj 𝒜).presheaf.germ (Proj.basicOpen 𝒜 s)
          (Proj.map f hf t) ht).hom ((Proj.awayToSection 𝒜 s).hom y)) =
        ((Proj ℬ).presheaf.germ (Proj.basicOpen ℬ (f s)) t ht').hom
          ((Proj.awayToSection ℬ (f s)).hom (HomogeneousLocalization.Away.map f s y)) := by
    intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hf i s hs t ht ht' y
    have h1 := congrArg (fun φ => φ.hom ((Proj.awayToSection 𝒜 s).hom y))
      (Scheme.Hom.germ_stalkMap (Proj.map f hf) (Proj.basicOpen 𝒜 s) t ht)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h1
    rw [h1, Scheme.Hom.app_eq_appLE]
    have h2 := congrArg (fun φ => φ.hom y) (Proj.awayToSection_comp_appLE f hf hs)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h2
    exact congrArg (((Proj ℬ).presheaf.germ (Proj.basicOpen ℬ (f s)) t ht').hom) h2

  have s2 : ∀ {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ)
      [GradedRing 𝒜] {f g x : A} {m : ℕ} (hg : g ∈ 𝒜 m) (hx : x = f * g) (t : Proj 𝒜)
      (ht : t ∈ Proj.basicOpen 𝒜 f) (htx : t ∈ Proj.basicOpen 𝒜 x)
      (y : HomogeneousLocalization.Away 𝒜 f),
      ((Proj 𝒜).presheaf.germ (Proj.basicOpen 𝒜 f) t ht).hom ((Proj.awayToSection 𝒜 f).hom y) =
        ((Proj 𝒜).presheaf.germ (Proj.basicOpen 𝒜 x) t htx).hom
          ((Proj.awayToSection 𝒜 x).hom (HomogeneousLocalization.awayMap 𝒜 hg hx y)) := by
    intro A σ _ _ _ 𝒜 _ f g x m hg hx t ht htx y
    have h2 := congrArg (fun φ => φ.hom y) (Proj.awayMap_awayToSection 𝒜 hg hx)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h2
    rw [h2]
    exact (TopCat.Presheaf.germ_res_apply (Proj 𝒜).presheaf _ t htx _).symm

  have s3 : ∀ {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ)
      [GradedRing 𝒜] {x : A} {d₁ d₂ d₃ : ℕ} (hx₁ : x ∈ 𝒜 d₁) (hx₂ : x ∈ 𝒜 d₂) (hx₃ : x ∈ 𝒜 d₃)
      (n₁ n₂ n₃ : A) (h₁ : n₁ ∈ 𝒜 (1 • d₁)) (h₂ : n₂ ∈ 𝒜 (1 • d₂)) (h₃ : n₃ ∈ 𝒜 (1 • d₃)),
      n₁ * n₂ = x * n₃ →
      HomogeneousLocalization.Away.mk 𝒜 hx₁ 1 n₁ h₁ * HomogeneousLocalization.Away.mk 𝒜 hx₂ 1 n₂ h₂ =
        HomogeneousLocalization.Away.mk 𝒜 hx₃ 1 n₃ h₃ := by
    intro A σ _ _ _ 𝒜 _ x d₁ d₂ d₃ hx₁ hx₂ hx₃ n₁ n₂ n₃ h₁ h₂ h₃ hn
    rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_mul,
      HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk, Localization.mk_mul, Localization.mk_eq_mk_iff,
      Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [OneMemClass.coe_one, Submonoid.coe_mul, one_mul, pow_one]
    linear_combination x * hn

  have hXr : (MvPolynomial.X r : MvPolynomial (Fin (M + 1)) E) ∈
      MvPolynomial.homogeneousSubmodule (Fin (M + 1)) E 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X E r)
  have hXs : (MvPolynomial.X s : MvPolynomial (Fin (M + 1)) E) ∈
      MvPolynomial.homogeneousSubmodule (Fin (M + 1)) E (1 • 1) := by
    rw [smul_eq_mul, mul_one]
    exact (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X E s)
  have hfdeg : φ (MvPolynomial.X r) ∈ MvPolynomial.homogeneousSubmodule (Fin 2) E 1 :=
    φ.map_mem hXr
  have ht' : t ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) E)
      (φ (MvPolynomial.X r)) := hr
  have htW : t ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) E)
      (φ (MvPolynomial.X r) * MvPolynomial.X e) := by
    rw [Proj.basicOpen_mul]
    exact ⟨ht', he⟩
  have e1 : ((Proj.map φ hf).stalkMap t).hom
        (((wcProjK E M).presheaf.germ (wcSgD E M r) (Proj.map φ hf t) hr).hom (wcSgE E M r s)) =
      ((Proj (MvPolynomial.homogeneousSubmodule (Fin 2) E)).presheaf.germ
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) E)
            (φ (MvPolynomial.X r) * MvPolynomial.X e)) t htW).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin 2) E)
            (φ (MvPolynomial.X r) * MvPolynomial.X e)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin 2) E) hXe
            (rfl : φ (MvPolynomial.X r) * MvPolynomial.X e = φ (MvPolynomial.X r) * MvPolynomial.X e)
            (HomogeneousLocalization.Away.map φ (MvPolynomial.X r)
              (HomogeneousLocalization.Away.mk _ hXr 1 (MvPolynomial.X s) hXs)))) :=
    (s1 φ hf (MvPolynomial.X r) hXr t hr ht'
      (HomogeneousLocalization.Away.mk _ hXr 1 (MvPolynomial.X s) hXs)).trans
      (s2 _ hXe rfl t ht' htW _)
  have e2 : ((wcProjK E 1).presheaf.germ (wcSgD E 1 e) t he).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin 2) E) (MvPolynomial.X e)).hom
          (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin 2) E) hXe 1
            (φ (MvPolynomial.X r)) h₁)) =
      ((Proj (MvPolynomial.homogeneousSubmodule (Fin 2) E)).presheaf.germ
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) E)
            (φ (MvPolynomial.X r) * MvPolynomial.X e)) t htW).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin 2) E)
            (φ (MvPolynomial.X r) * MvPolynomial.X e)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin 2) E) hfdeg
            (mul_comm _ _ : φ (MvPolynomial.X r) * MvPolynomial.X e = MvPolynomial.X e * φ (MvPolynomial.X r))
            (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin 2) E) hXe 1
              (φ (MvPolynomial.X r)) h₁))) :=
    s2 _ hfdeg (mul_comm _ _) t he htW _
  have e3 : ((wcProjK E 1).presheaf.germ (wcSgD E 1 e) t he).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin 2) E) (MvPolynomial.X e)).hom
          (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin 2) E) hXe 1
            (φ (MvPolynomial.X s)) h₂)) =
      ((Proj (MvPolynomial.homogeneousSubmodule (Fin 2) E)).presheaf.germ
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) E)
            (φ (MvPolynomial.X r) * MvPolynomial.X e)) t htW).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin 2) E)
            (φ (MvPolynomial.X r) * MvPolynomial.X e)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin 2) E) hfdeg
            (mul_comm _ _ : φ (MvPolynomial.X r) * MvPolynomial.X e = MvPolynomial.X e * φ (MvPolynomial.X r))
            (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin 2) E) hXe 1
              (φ (MvPolynomial.X s)) h₂))) :=
    s2 _ hfdeg (mul_comm _ _) t he htW _
  rw [e1, e2, e3]
  simp only [HomogeneousLocalization.Away.map_mk, HomogeneousLocalization.awayMap_mk]
  rw [← map_mul, ← map_mul]
  congr 1
  congr 1
  exact s3 _ _ _ _ _ _ _ _ _ _ (by ring)

theorem wc_ldnm_pencil_line (E : Type u) [Field E] (N : ℕ) (hN : 1 ≤ N)
    (v₀ v₁ : Fin (N + 1) × Fin (N + 1) → E)
    (hind : ∀ l₀ l₁ : E, (∀ q, l₀ * v₀ q + l₁ * v₁ q = 0) → l₀ = 0 ∧ l₁ = 0) :
    ∃ lam : (wcP1Over E).left ⟶ wcProjK E (wcLdnmM N),
      IsClosedImmersion lam ∧ lam ≫ wcProjKStr E (wcLdnmM N) = (wcP1Over E).hom ∧
      (∃ L : Fin (wcLdnmM N - 1) → MvPolynomial.homogeneousSubmodule (Fin (wcLdnmM N + 1)) E 1,
        LinearIndependent E (fun a => (L a : MvPolynomial (Fin (wcLdnmM N + 1)) E)) ∧
        Set.range lam = {x | ∀ a, x ∉ @Proj.basicOpen _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (wcLdnmM N + 1)) E) MvPolynomial.gradedAlgebra
          (L a : MvPolynomial (Fin (wcLdnmM N + 1)) E)}) ∧
      wcLdnmPencilRule E N v₀ v₁ lam :=
by
  classical
  obtain ⟨ψ, L, hψ, hφψ, hLh, hLi, hL0, hJ⟩ := wc_lpl_linalg E N hN v₀ v₁ hind

  have s4 : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
      [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
      (f : 𝒜 →+*ᵍ ℬ)
      (hf : HomogeneousIdeal.irrelevant ℬ ≤ HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜))
      {ι : Type} (s : ι → A) (d : ι → ℕ), (∀ i, s i ∈ 𝒜 (d i)) → (∀ i, 0 < d i) →
      (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤ Ideal.span (Set.range s) →
      (∀ i, Function.Surjective (HomogeneousLocalization.Away.map f (s i))) →
      IsClosedImmersion (Proj.map f hf) := by
    intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hf ι s d hs hd hcov hsurj
    refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsClosedImmersion)
      (fun i => Proj.basicOpen 𝒜 (s i)) (Proj.iSup_basicOpen_eq_top 𝒜 s hcov) ?_
    intro i
    have hs' : f (s i) ∈ ℬ (d i) := f.map_mem (hs i)
    let iV := Proj.awayι 𝒜 (s i) (hs i) (hd i)
    let iU := Proj.awayι ℬ (f (s i)) hs' (hd i)
    let g := Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (s i)))
    have hc : iU ≫ Proj.map f hf = g ≫ iV := Proj.awayι_comp_map f hf (hd i) (s i) (hs i)
    have hpre : Proj.map f hf ⁻¹ᵁ iV.opensRange = iU.opensRange := by
      simp only [iV, iU, Proj.opensRange_awayι]
      exact Proj.map_preimage_basicOpen f hf (s i)
    have hpb : IsPullback g iU iV (Proj.map f hf) := IsOpenImmersion.isPullback g iU iV _ hc hpre
    have hg : IsClosedImmersion g :=
      IsClosedImmersion.spec_of_surjective _ (by simpa using hsurj i)
    have h1 : IsClosedImmersion (Limits.pullback.snd (Proj.map f hf) iV) :=
      (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
        (Arrow.isoMk hpb.flip.isoPullback (Iso.refl _)
          (by
            dsimp only [Arrow.mk_hom, Iso.refl_hom]
            rw [Category.comp_id]
            exact IsPullback.isoPullback_hom_snd _))).mp hg
    have h2 : IsClosedImmersion (Proj.map f hf ∣_ iV.opensRange) :=
      (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
        (morphismRestrictOpensRange _ iV)).mpr h1
    exact (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
      (morphismRestrictEq _ (Proj.opensRange_awayι 𝒜 (s i) (hs i) (hd i)))).mp h2

  have s3 : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
      [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
      (f : 𝒜 →+*ᵍ ℬ), (∀ (n : ℕ) (b : B), b ∈ ℬ n → ∃ a ∈ 𝒜 n, f a = b) →
      ∀ (s : A) (d : ℕ), s ∈ 𝒜 d → Function.Surjective (HomogeneousLocalization.Away.map f s) := by
    intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hsurj s d hs y
    obtain ⟨n, b, hb, rfl⟩ := HomogeneousLocalization.Away.mk_surjective ℬ (f.map_mem hs) y
    obtain ⟨a, ha, rfl⟩ := hsurj _ b hb
    exact ⟨_, HomogeneousLocalization.Away.map_mk f s hs n a ha⟩

  have s1 : ∀ (n : ℕ) (p : MvPolynomial (Fin n) E),
      p ∈ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin n) E) ↔
        p.coeff 0 = 0 := by
    intro n p
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
    erw [MvPolynomial.decomposition.decompose'_apply]
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero]
  have hom1 : ∀ (n : ℕ) (p : MvPolynomial (Fin n) E), p.IsHomogeneous 1 →
      p ∈ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin n) E) := by
    intro n p hp
    exact (s1 n p).mpr (hp.coeff_eq_zero (by simp))
  have hspan : ∀ (n : ℕ) (x : MvPolynomial (Fin n) E),
      x ∈ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin n) E) →
      x ∈ Ideal.span (Set.range (MvPolynomial.X : Fin n → MvPolynomial (Fin n) E)) := by
    intro n x hx
    have hx0 : x.coeff 0 = 0 := (s1 n x).mp hx
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) hx0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨i, Set.mem_univ _, by simpa using hi⟩

  have hℓ : ∀ r : Fin (wcLdnmM N + 1),
      (MvPolynomial.C (v₁ ((wcLdnmIdx N).symm r)) * (MvPolynomial.X 0 : MvPolynomial (Fin 2) E) -
        MvPolynomial.C (v₀ ((wcLdnmIdx N).symm r)) * MvPolynomial.X 1).IsHomogeneous 1 := fun r =>
    (MvPolynomial.isHomogeneous_C_mul_X _ _).sub (MvPolynomial.isHomogeneous_C_mul_X _ _)
  let φ : GradedRingHom (MvPolynomial.homogeneousSubmodule (Fin (wcLdnmM N + 1)) E)
      (MvPolynomial.homogeneousSubmodule (Fin 2) E) :=
    ⟨(MvPolynomial.aeval (fun r : Fin (wcLdnmM N + 1) =>
        MvPolynomial.C (v₁ ((wcLdnmIdx N).symm r)) * (MvPolynomial.X 0 : MvPolynomial (Fin 2) E) -
          MvPolynomial.C (v₀ ((wcLdnmIdx N).symm r)) * MvPolynomial.X 1)).toRingHom,
      fun {n x} hx => by
        rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
        have := hx.aeval _ hℓ
        rw [one_mul] at this
        exact this⟩
  have hφX : ∀ r : Fin (wcLdnmM N + 1), φ (MvPolynomial.X r) =
      MvPolynomial.C (v₁ ((wcLdnmIdx N).symm r)) * (MvPolynomial.X 0 : MvPolynomial (Fin 2) E) -
        MvPolynomial.C (v₀ ((wcLdnmIdx N).symm r)) * MvPolynomial.X 1 := fun r =>
    MvPolynomial.aeval_X _ r
  have hφψ' : ∀ b, φ (ψ b) = b := fun b => hφψ b
  let ψg : GradedRingHom (MvPolynomial.homogeneousSubmodule (Fin 2) E)
      (MvPolynomial.homogeneousSubmodule (Fin (wcLdnmM N + 1)) E) :=
    ⟨ψ.toRingHom, fun {n x} hx =>
      (MvPolynomial.mem_homogeneousSubmodule n _).2
        (hψ n x ((MvPolynomial.mem_homogeneousSubmodule n x).1 hx))⟩
  have hf : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) E) ≤
      HomogeneousIdeal.map φ
        (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (wcLdnmM N + 1)) E)) := by
    intro b hb
    rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_map]
    refine (Ideal.span_le.mpr ?_) (hspan 2 b hb)
    rintro _ ⟨i, rfl⟩
    rw [← hφψ' (MvPolynomial.X i)]
    exact Ideal.mem_map_of_mem φ (HomogeneousIdeal.mem_iff.mpr
      (hom1 _ _ (hψ 1 _ (MvPolynomial.isHomogeneous_X E i))))
  have hX : ∀ i : Fin (wcLdnmM N + 1),
      (MvPolynomial.X i : MvPolynomial (Fin (wcLdnmM N + 1)) E) ∈
        MvPolynomial.homogeneousSubmodule (Fin (wcLdnmM N + 1)) E 1 :=
    fun i => (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X E i)
  have hdeg : ∀ (n : ℕ) (b : MvPolynomial (Fin 2) E),
      b ∈ MvPolynomial.homogeneousSubmodule (Fin 2) E n →
      ∃ a ∈ MvPolynomial.homogeneousSubmodule (Fin (wcLdnmM N + 1)) E n, φ a = b :=
    fun n b hb => ⟨ψ b, (MvPolynomial.mem_homogeneousSubmodule n _).2
      (hψ n b ((MvPolynomial.mem_homogeneousSubmodule n b).1 hb)), hφψ' b⟩
  have hcl : IsClosedImmersion (Proj.map φ hf) :=
    s4 φ hf (fun i : Fin (wcLdnmM N + 1) => MvPolynomial.X i) (fun _ => 1) hX
      (fun _ => Nat.one_pos) (fun x hx => hspan _ x (HomogeneousIdeal.mem_iff.mp hx))
      (fun i => s3 φ hdeg _ 1 (hX i))
  have hirr : ∀ a ∈ HomogeneousIdeal.irrelevant
      (MvPolynomial.homogeneousSubmodule (Fin (wcLdnmM N + 1)) E),
      φ a ∈ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) E) := by
    intro a ha
    have hle : Ideal.span (Set.range (MvPolynomial.X :
        Fin (wcLdnmM N + 1) → MvPolynomial (Fin (wcLdnmM N + 1)) E)) ≤
        Ideal.comap φ (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) E)).toIdeal := by
      rw [Ideal.span_le]
      rintro _ ⟨r, rfl⟩
      refine Ideal.mem_comap.mpr ?_
      rw [hφX r]
      exact HomogeneousIdeal.mem_iff.mpr (hom1 _ _ (hℓ r))
    exact HomogeneousIdeal.mem_iff.mp (Ideal.mem_comap.mp (hle (hspan _ a ha)))
  refine ⟨Proj.map φ hf, hcl, ?_, ?_, ?_⟩
  ·
    let f₀ : ↥(MvPolynomial.homogeneousSubmodule (Fin (wcLdnmM N + 1)) E 0) →+*
        ↥(MvPolynomial.homogeneousSubmodule (Fin 2) E 0) :=
      { toFun := fun a => ⟨φ a, φ.map_mem a.2⟩
        map_one' := Subtype.ext (by simp)
        map_mul' := fun a b => Subtype.ext (by simp)
        map_zero' := Subtype.ext (by simp)
        map_add' := fun a b => Subtype.ext (by simp) }
    have h1 := wc_bc_proj_map_toSpecZero φ hf f₀ (fun a => rfl)
    have h2 : CommRingCat.ofHom (algebraMap E
          ↥(MvPolynomial.homogeneousSubmodule (Fin (wcLdnmM N + 1)) E 0)) ≫ CommRingCat.ofHom f₀ =
        CommRingCat.ofHom (algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin 2) E 0)) := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro c
      apply Subtype.ext
      show φ ((algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin (wcLdnmM N + 1)) E 0) c :
          ↥(MvPolynomial.homogeneousSubmodule (Fin (wcLdnmM N + 1)) E 0)) :
            MvPolynomial (Fin (wcLdnmM N + 1)) E) =
        ((algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin 2) E 0) c :
          ↥(MvPolynomial.homogeneousSubmodule (Fin 2) E 0)) : MvPolynomial (Fin 2) E)
      rw [SetLike.GradeZero.coe_algebraMap, SetLike.GradeZero.coe_algebraMap]
      exact AlgHom.commutes _ c
    show Proj.map φ hf ≫ (Proj.toSpecZero _ ≫ Spec.map (CommRingCat.ofHom (algebraMap E
        ↥(MvPolynomial.homogeneousSubmodule (Fin (wcLdnmM N + 1)) E 0)))) =
      Proj.toSpecZero _ ≫ Spec.map (CommRingCat.ofHom (algebraMap E
        ↥(MvPolynomial.homogeneousSubmodule (Fin 2) E 0)))
    rw [← Category.assoc, h1, Category.assoc, ← Spec.map_comp, h2]
  ·
    refine ⟨fun a => ⟨L a, (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (hLh a)⟩, hLi, ?_⟩
    exact wc_lpl_proj_map_range φ hf ψg L (fun i => hL0 i) (fun a => hJ a) hirr
  ·
    intro t r hr e he q
    have hXe : (MvPolynomial.X e : MvPolynomial (Fin 2) E) ∈
        MvPolynomial.homogeneousSubmodule (Fin 2) E 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X E e)
    have hmem : ∀ r' : Fin (wcLdnmM N + 1), φ (MvPolynomial.X r') ∈
        MvPolynomial.homogeneousSubmodule (Fin 2) E (1 • 1) := fun r' => by
      rw [smul_eq_mul, mul_one]
      exact φ.map_mem (hX r')
    have hℓmem : ∀ r' : Fin (wcLdnmM N + 1),
        MvPolynomial.C (v₁ ((wcLdnmIdx N).symm r')) * (MvPolynomial.X 0 : MvPolynomial (Fin 2) E) -
          MvPolynomial.C (v₀ ((wcLdnmIdx N).symm r')) * MvPolynomial.X 1 ∈
        MvPolynomial.homogeneousSubmodule (Fin 2) E (1 • 1) := fun r' => by
      rw [← hφX r']
      exact hmem r'
    have H3 : ∀ (x y : MvPolynomial (Fin 2) E)
        (hx : x ∈ MvPolynomial.homogeneousSubmodule (Fin 2) E (1 • 1))
        (hy : y ∈ MvPolynomial.homogeneousSubmodule (Fin 2) E (1 • 1)), x = y →
        HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin 2) E) hXe 1 x hx =
        HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin 2) E) hXe 1 y hy := by
      rintro x y hx hy rfl
      rfl
    have key := wc_lpl_stalk_identity E (wcLdnmM N) φ hf t r (wcLdnmIdx N q) hr e he hXe
      (hmem r) (hmem (wcLdnmIdx N q))
    rw [H3 _ _ (hmem r) (hℓmem r) (hφX r),
      H3 _ _ (hmem (wcLdnmIdx N q)) (hℓmem (wcLdnmIdx N q)) (hφX (wcLdnmIdx N q)),
      wc_lpl_germ_linear E e t he _ _ hXe (hℓmem r),
      wc_lpl_germ_linear E e t he _ _ hXe (hℓmem (wcLdnmIdx N q))] at key
    simp only [Equiv.symm_apply_apply] at key
    exact key

theorem wc_ldnm_sq_closed_compare {P Q : Scheme.{u}} (Λ : P ⟶ Q) {I J : Type}
    (W : I → P.Opens) (H : ∀ i, Γ(P, W i)) (W' : J → Q.Opens) (Φ : ∀ j, Γ(Q, W' j))
    (hWcov : (⨆ i, W i) = ⊤) (hW'cov : (⨆ j, W' j) = ⊤)
    (Yt Z : Scheme.{u}) (g : Yt ⟶ P) (k : Z ⟶ Q)
    (hY : wcLdnmLocEq P I W H Yt g) (hZ : wcLdnmLocEq Q J W' Φ Z k)
    (hassoc : ∀ (w : P) (i : I) (j : J) (hw : w ∈ W i) (hj : Λ w ∈ W' j),
      ∃ u : P.presheaf.stalk w, IsUnit u ∧
        (Λ.stalkMap w).hom ((Q.presheaf.germ (W' j) (Λ w) hj).hom (Φ j)) =
          u * (P.presheaf.germ (W i) w hw).hom (H i)) :
    ∃ p : Yt ⟶ Z, IsPullback p g k Λ :=
by
  classical
  haveI := hY.1
  haveI := hZ.1
  have chartP : ∀ w : P, ∃ i, w ∈ W i := by
    intro w
    have hw : w ∈ (⊤ : P.Opens) := trivial
    rw [← hWcov] at hw
    exact TopologicalSpace.Opens.mem_iSup.mp hw
  have chartQ : ∀ x : Q, ∃ j, x ∈ W' j := by
    intro x
    have hx : x ∈ (⊤ : Q.Opens) := trivial
    rw [← hW'cov] at hx
    exact TopologicalSpace.Opens.mem_iSup.mp hx

  have hR : ∀ w : P, w ∈ Set.range g ↔ Λ w ∈ Set.range k := by
    intro w
    constructor
    · intro hw
      rw [hZ.2.2.1 (Λ w)]
      intro j hj
      obtain ⟨i, hi⟩ := chartP w
      have hη := (hY.2.2.1 w).1 hw i hi
      obtain ⟨u, _, he⟩ := hassoc w i j hi hj
      by_contra hγ
      rw [IsLocalRing.notMem_maximalIdeal] at hγ
      have h1 : IsUnit ((Λ.stalkMap w).hom ((Q.presheaf.germ (W' j) (Λ w) hj).hom (Φ j))) :=
        hγ.map _
      rw [he] at h1
      exact (IsLocalRing.notMem_maximalIdeal.mpr h1) (Ideal.mul_mem_left _ _ hη)
    · intro hw
      rw [hY.2.2.1 w]
      intro i hi
      obtain ⟨j, hj⟩ := chartQ (Λ w)
      have hγ := (hZ.2.2.1 (Λ w)).1 hw j hj
      obtain ⟨u, hu, he⟩ := hassoc w i j hi hj
      by_contra hη
      rw [IsLocalRing.notMem_maximalIdeal] at hη
      have h1 : IsUnit ((Λ.stalkMap w).hom ((Q.presheaf.germ (W' j) (Λ w) hj).hom (Φ j))) := by
        rw [he]; exact hu.mul hη
      have h2 := isUnit_of_map_unit (Λ.stalkMap w).hom _ h1
      exact (IsLocalRing.notMem_maximalIdeal.mpr h2) hγ

  have C3g : ∀ (y : Yt) (i : I) (hi : g y ∈ W i),
      (g.stalkMap y).hom ((P.presheaf.germ (W i) (g y) hi).hom (H i)) = 0 := by
    intro y i hi
    have h2 : (P.presheaf.germ (W i) (g y) hi).hom (H i) ∈ RingHom.ker (g.stalkMap y).hom := by
      rw [(hY.2.2.2 y i hi).2]; exact Ideal.mem_span_singleton_self _
    exact h2
  have C3k : ∀ (z : Z) (j : J) (hj : k z ∈ W' j),
      (k.stalkMap z).hom ((Q.presheaf.germ (W' j) (k z) hj).hom (Φ j)) = 0 := by
    intro z j hj
    have h2 : (Q.presheaf.germ (W' j) (k z) hj).hom (Φ j) ∈ RingHom.ker (k.stalkMap z).hom := by
      rw [(hZ.2.2.2 z j hj).2]; exact Ideal.mem_span_singleton_self _
    exact h2

  have C1 : ∀ (U : Q.Opens) (s : Γ(Q, U)), (k.app U).hom s = 0 →
      ∀ x : Q, x ∈ Set.range k → ∀ (j : J) (hj : x ∈ W' j) (hU : x ∈ U),
      (Q.presheaf.germ U x hU).hom s ∈ Ideal.span {(Q.presheaf.germ (W' j) x hj).hom (Φ j)} := by
    rintro U s hs _ ⟨z, rfl⟩ j hj hU
    rw [← (hZ.2.2.2 z j hj).2, RingHom.mem_ker]
    have hs' : (ConcreteCategory.hom (k.app U)) s = 0 := hs
    refine (Scheme.Hom.germ_stalkMap_apply k U z hU s).trans ?_
    rw [hs', map_zero]
  have C2 : ∀ (U : P.Opens) (s : Γ(P, U)), (g.app U).hom s = 0 →
      ∀ x : P, x ∈ Set.range g → ∀ (i : I) (hi : x ∈ W i) (hU : x ∈ U),
      (P.presheaf.germ U x hU).hom s ∈ Ideal.span {(P.presheaf.germ (W i) x hi).hom (H i)} := by
    rintro U s hs _ ⟨y, rfl⟩ i hi hU
    rw [← (hY.2.2.2 y i hi).2, RingHom.mem_ker]
    have hs' : (ConcreteCategory.hom (g.app U)) s = 0 := hs
    refine (Scheme.Hom.germ_stalkMap_apply g U y hU s).trans ?_
    rw [hs', map_zero]

  have hle1 : k.ker ≤ (g ≫ Λ).ker := by
    rw [Scheme.Hom.ker.eq_1 (g ≫ Λ), Scheme.IdealSheafData.le_ofIdeals_iff]
    intro U
    rw [Scheme.Hom.ker_apply k U]
    intro s hs
    rw [RingHom.mem_ker] at hs ⊢
    apply TopCat.Presheaf.section_ext Yt.sheaf _ _ 0
    intro y hy
    refine (Scheme.Hom.germ_stalkMap_apply (g ≫ Λ) U y hy s).symm.trans
      (Eq.trans ?_ (map_zero _).symm)
    rw [Scheme.Hom.stalkMap_comp]
    change (g.stalkMap y).hom ((Λ.stalkMap (g y)).hom ((Q.presheaf.germ U (Λ (g y)) hy).hom s)) = 0
    obtain ⟨i, hi⟩ := chartP (g y)
    obtain ⟨j, hj⟩ := chartQ (Λ (g y))
    have hmem := C1 U s hs (Λ (g y)) ((hR (g y)).1 ⟨y, rfl⟩) j hj hy
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hmem
    obtain ⟨u, _, he⟩ := hassoc (g y) i j hi hj
    rw [← ha, map_mul, he]
    simp only [map_mul, C3g y i hi, mul_zero]

  have hle2 : g.ker ≤ k.ker.comap Λ := by
    rw [← Scheme.IdealSheafData.ker_fst_of_isClosedImmersion k Λ,
      Scheme.Hom.ker.eq_1 (Limits.pullback.fst Λ k), Scheme.IdealSheafData.le_ofIdeals_iff]
    intro U
    rw [Scheme.Hom.ker_apply g U]
    intro s hs
    rw [RingHom.mem_ker] at hs ⊢
    apply TopCat.Presheaf.section_ext (Limits.pullback Λ k).sheaf _ _ 0
    intro q hq
    refine (Scheme.Hom.germ_stalkMap_apply (Limits.pullback.fst Λ k) U q hq s).symm.trans
      (Eq.trans ?_ (map_zero _).symm)
    have hcond : Λ (Limits.pullback.fst Λ k q) = k (Limits.pullback.snd Λ k q) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
    have hwg : Limits.pullback.fst Λ k q ∈ Set.range g :=
      (hR _).2 ⟨Limits.pullback.snd Λ k q, hcond.symm⟩
    obtain ⟨i, hi⟩ := chartP (Limits.pullback.fst Λ k q)
    obtain ⟨j, hj⟩ := chartQ (Λ (Limits.pullback.fst Λ k q))
    have hmem := C2 U s hs _ hwg i hi hq
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hmem
    obtain ⟨u, hu, he⟩ := hassoc _ i j hi hj
    obtain ⟨v, rfl⟩ := hu
    have hη : (P.presheaf.germ (W i) (Limits.pullback.fst Λ k q) hi).hom (H i) =
        ↑v⁻¹ * (Λ.stalkMap (Limits.pullback.fst Λ k q)).hom
          ((Q.presheaf.germ (W' j) (Λ (Limits.pullback.fst Λ k q)) hj).hom (Φ j)) := by
      rw [he, Units.inv_mul_cancel_left]
    have C4 : ∀ (φ : Limits.pullback Λ k ⟶ Q), φ = Limits.pullback.snd Λ k ≫ k →
        ∀ (hφ : φ q ∈ W' j), (φ.stalkMap q).hom ((Q.presheaf.germ (W' j) (φ q) hφ).hom (Φ j)) = 0 := by
      rintro φ rfl hφ
      rw [Scheme.Hom.stalkMap_comp]
      change ((Limits.pullback.snd Λ k).stalkMap q).hom ((k.stalkMap (Limits.pullback.snd Λ k q)).hom
        ((Q.presheaf.germ (W' j) (k (Limits.pullback.snd Λ k q)) hφ).hom (Φ j))) = 0
      have h0 := C3k (Limits.pullback.snd Λ k q) j hφ
      exact (congrArg (fun t => ((Limits.pullback.snd Λ k).stalkMap q).hom t) h0).trans
        (map_zero _)
    have h4 := C4 (Limits.pullback.fst Λ k ≫ Λ) Limits.pullback.condition hj
    rw [Scheme.Hom.stalkMap_comp] at h4
    change ((Limits.pullback.fst Λ k).stalkMap q).hom ((Λ.stalkMap (Limits.pullback.fst Λ k q)).hom
        ((Q.presheaf.germ (W' j) (Λ (Limits.pullback.fst Λ k q)) hj).hom (Φ j))) = 0 at h4
    change ((Limits.pullback.fst Λ k).stalkMap q).hom
      ((P.presheaf.germ U (Limits.pullback.fst Λ k q) hq).hom s) = 0
    rw [← ha, map_mul, hη, map_mul, h4, mul_zero, mul_zero]
  have hle3 : k.ker.comap Λ ≤ g.ker := by
    apply (Scheme.IdealSheafData.map_gc Λ).l_le
    show k.ker ≤ g.ker.map Λ
    rw [Scheme.IdealSheafData.map_ker]
    exact hle1
  refine ⟨IsClosedImmersion.lift k (g ≫ Λ) hle1, ?_⟩
  exact (isPullback_of_isClosedImmersion g k _ Λ
    (IsClosedImmersion.lift_fac k (g ≫ Λ) hle1).symm (le_antisymm hle3 hle2)).flip

theorem wc_ldnm_sq_local_assoc (E : Type u) [Field E] (N : ℕ) (X : Over (Spec (.of E)))
    (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr E N = X.hom)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
    (v₀ v₁ : Fin (N + 1) × Fin (N + 1) → E)
    (hv₀ : G₀ = wcLdpQuad E N (fun p q => v₀ (p, q)))
    (hv₁ : G₁ = wcLdpQuad E N (fun p q => v₁ (p, q)))
    (hind : ∀ l₀ l₁ : E, (∀ q, l₀ * v₀ q + l₁ * v₁ q = 0) → l₀ = 0 ∧ l₁ = 0)
    (lam : (wcP1Over E).left ⟶ wcProjK E (wcLdnmM N))
    (hrule : wcLdnmPencilRule E N v₀ v₁ lam)
    (Λ : Limits.pullback X.hom (wcProjKStr E 1) ⟶ Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
    (hΛ1 : Λ ≫ Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)) =
      Limits.pullback.fst X.hom (wcProjKStr E 1))
    (hΛ2 : Λ ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)) =
      Limits.pullback.snd X.hom (wcProjKStr E 1) ≫ lam) :
    ∀ (w : ↥(Limits.pullback X.hom (wcProjKStr E 1))) (i : Fin (N + 1) × Fin 2)
      (j : Fin (N + 1) × Fin (wcLdnmM N + 1)) (hw : w ∈ wcLdpW E N X ι i)
      (hj : Λ w ∈ wcLdnmU E N X ι j),
      ∃ u : (Limits.pullback X.hom (wcProjKStr E 1)).presheaf.stalk w, IsUnit u ∧
        (Λ.stalkMap w).hom
          (((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.germ
            (wcLdnmU E N X ι j) (Λ w) hj).hom (wcLdnmPhi E N X ι j)) =
        u * ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.germ
            (wcLdpW E N X ι i) w hw).hom (wcLdpH E N X ι G₀ G₁ i) :=
by
  classical

  have ellUnit : ∀ (O : Type u) [CommRing O] [IsLocalRing O] (ρ : E →+* O)
      (σ₀ σ₁ : O) (_ : σ₀ = 1 ∨ σ₁ = 1) (r : Fin (N + 1) × Fin (N + 1))
      (β : Fin (N + 1) × Fin (N + 1) → O)
      (_ : ∀ q, β q * (ρ (v₁ r) * σ₀ - ρ (v₀ r) * σ₁) = ρ (v₁ q) * σ₀ - ρ (v₀ q) * σ₁),
      IsUnit (ρ (v₁ r) * σ₀ - ρ (v₀ r) * σ₁) := by
    intro O _ _ ρ σ₀ σ₁ hσ r β hβ
    have hminor : ∃ q₀ q₁, v₀ q₀ * v₁ q₁ - v₀ q₁ * v₁ q₀ ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      by_cases h0 : ∀ q, v₀ q = 0
      · exact one_ne_zero (hind 1 0 (fun q => by simp [h0 q])).1
      · push_neg at h0
        obtain ⟨qs, hqs⟩ := h0
        exact hqs (neg_eq_zero.mp
          (hind (v₁ qs) (-v₀ qs) (fun q => by linear_combination -(hcon qs q))).2)
    obtain ⟨q₀, q₁, hD⟩ := hminor
    by_contra hℓ
    have h0 : IsLocalRing.residue O (ρ (v₁ r) * σ₀ - ρ (v₀ r) * σ₁) = 0 :=
      (IsLocalRing.residue_eq_zero_iff _).mpr ((IsLocalRing.mem_maximalIdeal _).mpr hℓ)
    have hq : ∀ q, IsLocalRing.residue O (ρ (v₁ q)) * IsLocalRing.residue O σ₀ -
        IsLocalRing.residue O (ρ (v₀ q)) * IsLocalRing.residue O σ₁ = 0 := by
      intro q
      have h := congrArg (IsLocalRing.residue O) (hβ q)
      rw [map_mul, h0, mul_zero] at h
      simp only [map_sub, map_mul] at h
      exact h.symm
    have hinj : Function.Injective ((IsLocalRing.residue O).comp ρ) := RingHom.injective _
    have hD' : IsLocalRing.residue O (ρ (v₀ q₀)) * IsLocalRing.residue O (ρ (v₁ q₁)) -
        IsLocalRing.residue O (ρ (v₀ q₁)) * IsLocalRing.residue O (ρ (v₁ q₀)) ≠ 0 := by
      intro h
      apply hD
      apply hinj
      simp only [RingHom.comp_apply, map_sub, map_mul, map_zero]
      exact h
    have e0 := hq q₀
    have e1 := hq q₁
    have hs0 : IsLocalRing.residue O σ₀ = 0 := by
      have : IsLocalRing.residue O σ₀ * (IsLocalRing.residue O (ρ (v₀ q₀)) *
          IsLocalRing.residue O (ρ (v₁ q₁)) - IsLocalRing.residue O (ρ (v₀ q₁)) *
          IsLocalRing.residue O (ρ (v₁ q₀))) = 0 := by
        linear_combination IsLocalRing.residue O (ρ (v₀ q₀)) * e1 -
          IsLocalRing.residue O (ρ (v₀ q₁)) * e0
      exact (mul_eq_zero.mp this).resolve_right hD'
    have hs1 : IsLocalRing.residue O σ₁ = 0 := by
      have : IsLocalRing.residue O σ₁ * (IsLocalRing.residue O (ρ (v₀ q₀)) *
          IsLocalRing.residue O (ρ (v₁ q₁)) - IsLocalRing.residue O (ρ (v₀ q₁)) *
          IsLocalRing.residue O (ρ (v₁ q₀))) = 0 := by
        linear_combination IsLocalRing.residue O (ρ (v₁ q₀)) * e1 -
          IsLocalRing.residue O (ρ (v₁ q₁)) * e0
      exact (mul_eq_zero.mp this).resolve_right hD'
    rcases hσ with h | h
    · rw [h, map_one] at hs0; exact one_ne_zero hs0
    · rw [h, map_one] at hs1; exact one_ne_zero hs1

  have F0 : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (U₀ : B.Opens) (V : A.Opens) (h : V ≤ f ⁻¹ᵁ U₀)
      (a : A) (ha : a ∈ V) (s : Γ(B, U₀)),
      (A.presheaf.germ V a ha).hom ((f.appLE U₀ V h).hom s) =
        (f.stalkMap a).hom ((B.presheaf.germ U₀ (f a) (h ha)).hom s) := by
    intro A B f U₀ V h a ha s
    exact (TopCat.Presheaf.germ_res_apply A.presheaf (homOfLE h) a ha ((f.app U₀).hom s)).trans
      (Scheme.Hom.germ_stalkMap_apply f U₀ a (h ha) s).symm
  have PULL : ∀ {A B C : Scheme.{u}} (g : A ⟶ B) (g' : B ⟶ C) (k : A ⟶ C) (_ : g ≫ g' = k)
      (a : A) (U : C.Opens) (h1 : g' (g a) ∈ U) (h2 : k a ∈ U) (s : Γ(C, U)),
      (g.stalkMap a).hom ((g'.stalkMap (g a)).hom ((C.presheaf.germ U (g' (g a)) h1).hom s)) =
        (k.stalkMap a).hom ((C.presheaf.germ U (k a) h2).hom s) := by
    intro A B C g g' k hk a U h1 h2 s
    subst hk
    rw [Scheme.Hom.stalkMap_comp]
    rfl
  have CONST : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (s : B ⟶ Spec (.of E)) (a : A) (c : E),
      (f.stalkMap a).hom (wcLdpConst E s (f a) c) = wcLdpConst E (f ≫ s) a c := by
    intro A B f s a c
    simp only [wcLdpConst, RingHom.comp_apply]
    refine (Scheme.Hom.germ_stalkMap_apply f ⊤ a trivial _).trans ?_
    rw [Scheme.Hom.comp_appTop]
    rfl
  have hmk1 : ∀ (m : ℕ) (f : MvPolynomial (Fin (m + 1)) E) (d : ℕ)
      (hf : f ∈ MvPolynomial.homogeneousSubmodule (Fin (m + 1)) E d) (n : ℕ)
      (x : MvPolynomial (Fin (m + 1)) E)
      (hx : x ∈ MvPolynomial.homogeneousSubmodule (Fin (m + 1)) E (n • d)), x = f ^ n →
      HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) E)
        hf n x hx = 1 := by
    intro m f d hf n x hx h
    subst h
    apply HomogeneousLocalization.val_injective
    simp [HomogeneousLocalization.Away.val_mk]
  have hE1 : ∀ (m : ℕ) (j : Fin (m + 1)), wcSgE E m j j = 1 := by
    intro m j
    unfold wcSgE
    rw [hmk1 _ _ _ _ _ _ _ (pow_one _).symm, map_one]
  have hQ : ∀ v : Fin (N + 1) × Fin (N + 1) → E,
      wcLdpQuad E N (fun p q => v (p, q)) = ∑ q, v q • wcLdnmMono E N q := by
    intro v
    apply Subtype.ext
    rw [Submodule.coe_sum]
    simp only [wcLdnmMono, wcLdpQuad, Submodule.coe_smul, Finset.smul_sum,
      MvPolynomial.smul_eq_C_mul]
    symm
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun p' _ => ?_)
    rw [Finset.sum_eq_single (p, p')]
    · simp
    · intro q _ hq
      rw [if_neg (fun h => hq h.symm)]
      simp
    · intro h; exact absurd (Finset.mem_univ _) h

  subst hv₀ hv₁
  intro w i j hw hj
  obtain ⟨b, e⟩ := i
  obtain ⟨b', r⟩ := j
  obtain ⟨_, _, htr⟩ := wc_ldnm_univ_chart_data E N X ι hι
  have hx : Limits.pullback.fst X.hom (wcProjKStr E 1) w ∈ ι ⁻¹ᵁ wcSgD E N b := hw.1
  have he : Limits.pullback.snd X.hom (wcProjKStr E 1) w ∈ wcSgD E 1 e := hw.2
  have pt1 : Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)) (Λ w) =
      Limits.pullback.fst X.hom (wcProjKStr E 1) w := by
    rw [← Scheme.Hom.comp_apply, hΛ1]
  have pt2 : Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)) (Λ w) =
      lam (Limits.pullback.snd X.hom (wcProjKStr E 1) w) := by
    rw [← Scheme.Hom.comp_apply, hΛ2, Scheme.Hom.comp_apply]
  have ht : lam (Limits.pullback.snd X.hom (wcProjKStr E 1) w) ∈ wcSgD E (wcLdnmM N) r := by
    rw [← pt2]; exact hj.2
  have hr : Λ w ∈ wcLdnmU E N X ι (b, r) :=
    ⟨(by rw [pt1]; exact hx :
      Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)) (Λ w) ∈ ι ⁻¹ᵁ wcSgD E N b), hj.2⟩

  have GR : ∀ {Y : Scheme.{u}} {U V : Y.Opens} (h : U ≤ V) (y : Y) (hy : y ∈ U) (s : Γ(Y, V)),
      (Y.presheaf.germ U y hy).hom ((Y.presheaf.map (homOfLE h).op).hom s) =
        (Y.presheaf.germ V y (h hy)).hom s :=
    fun h y hy s => TopCat.Presheaf.germ_res_apply _ (homOfLE h) y hy s
  have FIN0 : ∀ {O : Type u} [CommRing O] (c Aa Hh : O) (Lu : Oˣ), (Lu : O) * Aa = Hh →
      c * Aa = c * ((Lu⁻¹ : Oˣ) : O) * Hh := by
    intro O _ c Aa Hh Lu h
    rw [← h, mul_assoc c, Units.inv_mul_cancel_left]
  have FIN1 : ∀ {O : Type u} [CommRing O] (c Aa Hh : O) (Lu : Oˣ), (Lu : O) * Aa = -Hh →
      c * Aa = c * ((Lu⁻¹ : Oˣ) : O) * (-1) * Hh := by
    intro O _ c Aa Hh Lu h
    rw [mul_assoc (c * ((Lu⁻¹ : Oˣ) : O)) (-1) Hh, neg_one_mul, ← h, mul_assoc c,
      Units.inv_mul_cancel_left]
  have ALG : ∀ {O O₁ O₂ : Type u} [CommRing O] [CommRing O₁] [CommRing O₂]
      (fS : O₁ →+* O) (sS : O₂ →+* O) (κ : E →+* O₁) (ρ : E →+* O₂)
      (_ : ∀ c, sS (ρ c) = fS (κ c)) (β : Fin (N + 1) × Fin (N + 1) → O₂)
      (m : Fin (N + 1) × Fin (N + 1) → O₁) (σ₀ σ₁ : O₂) (r' : Fin (N + 1) × Fin (N + 1))
      (_ : ∀ q, β q * (ρ (v₁ r') * σ₀ - ρ (v₀ r') * σ₁) = ρ (v₁ q) * σ₀ - ρ (v₀ q) * σ₁),
      sS (ρ (v₁ r') * σ₀ - ρ (v₀ r') * σ₁) * ∑ q, sS (β q) * fS (m q) =
        sS σ₀ * fS (∑ q, κ (v₁ q) * m q) - sS σ₁ * fS (∑ q, κ (v₀ q) * m q) := by
    intro O O₁ O₂ _ _ _ fS sS κ ρ hC β m σ₀ σ₁ r' hβ
    rw [Finset.mul_sum, map_sum, map_sum, Finset.mul_sum, Finset.mul_sum,
      ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    have h := congrArg sS (hβ q)
    simp only [map_mul, map_sub, hC] at h ⊢
    linear_combination fS (m q) * h
  have hC : ∀ c : E, ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom
        (wcLdpConst E (wcP1Over E).hom (Limits.pullback.snd X.hom (wcProjKStr E 1) w) c) =
      ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom
        (wcLdpConst E X.hom (Limits.pullback.fst X.hom (wcProjKStr E 1) w) c) := by
    intro c
    rw [CONST, CONST]
    exact congrArg (fun g => wcLdpConst E g w c) Limits.pullback.condition.symm
  have hD : ∀ v : Fin (N + 1) × Fin (N + 1) → E,
      wcLdpGerm E N ι (wcLdpQuad E N (fun p q => v (p, q))) b
          (Limits.pullback.fst X.hom (wcProjKStr E 1) w) hx =
        ∑ q, wcLdpConst E X.hom (Limits.pullback.fst X.hom (wcProjKStr E 1) w) (v q) *
          wcLdpGerm E N ι (wcLdnmMono E N q) b (Limits.pullback.fst X.hom (wcProjKStr E 1) w) hx := by
    intro v
    obtain ⟨hadd, hsmul, -⟩ := wc_ldp_germ_linear E N X.hom ι hιX
      (Limits.pullback.fst X.hom (wcProjKStr E 1) w) b b hx hx
    rw [hQ v]
    exact (map_sum (AddMonoidHom.mk' (fun G => wcLdpGerm E N ι G b
      (Limits.pullback.fst X.hom (wcProjKStr E 1) w) hx) hadd) _ _).trans
      (Finset.sum_congr rfl (fun q _ => hsmul _ _))
  have hA : (Λ.stalkMap w).hom
        (((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.germ
          (wcLdnmU E N X ι (b, r)) (Λ w) hr).hom (wcLdnmPhi E N X ι (b, r))) =
      ∑ q, ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom
          ((lam.stalkMap (Limits.pullback.snd X.hom (wcProjKStr E 1) w)).hom
            (((wcProjK E (wcLdnmM N)).presheaf.germ (wcSgD E (wcLdnmM N) r)
              (lam (Limits.pullback.snd X.hom (wcProjKStr E 1) w)) ht).hom
              (wcSgE E (wcLdnmM N) r (wcLdnmIdx N q)))) *
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom
          (wcLdpGerm E N ι (wcLdnmMono E N q) b (Limits.pullback.fst X.hom (wcProjKStr E 1) w) hx) := by
    unfold wcLdnmPhi
    rw [map_sum, map_sum]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    rw [map_mul, map_mul, F0, F0]
    congr 1
    · exact (PULL Λ (Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)))
        (Limits.pullback.snd X.hom (wcProjKStr E 1) ≫ lam) hΛ2 w (wcSgD E (wcLdnmM N) r) hj.2 ht
        (wcSgE E (wcLdnmM N) r (wcLdnmIdx N q))).trans
        (PULL (Limits.pullback.snd X.hom (wcProjKStr E 1)) lam _ rfl w (wcSgD E (wcLdnmM N) r)
          ht ht (wcSgE E (wcLdnmM N) r (wcLdnmIdx N q))).symm
    · exact PULL Λ (Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)))
        (Limits.pullback.fst X.hom (wcProjKStr E 1)) hΛ1 w (ι ⁻¹ᵁ wcSgD E N b) hr.1 hx
        ((ι.app (wcSgD E N b)).hom (wcLdpSec E N (wcLdnmMono E N q) b))
  have hPhiL : ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom
        (wcLdpConst E (wcP1Over E).hom (Limits.pullback.snd X.hom (wcProjKStr E 1) w)
            (v₁ ((wcLdnmIdx N).symm r)) *
          ((wcP1Over E).left.presheaf.germ (wcSgD E 1 e)
            (Limits.pullback.snd X.hom (wcProjKStr E 1) w) he).hom (wcSgE E 1 e 0) -
        wcLdpConst E (wcP1Over E).hom (Limits.pullback.snd X.hom (wcProjKStr E 1) w)
            (v₀ ((wcLdnmIdx N).symm r)) *
          ((wcP1Over E).left.presheaf.germ (wcSgD E 1 e)
            (Limits.pullback.snd X.hom (wcProjKStr E 1) w) he).hom (wcSgE E 1 e 1)) *
      (Λ.stalkMap w).hom
        (((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.germ
          (wcLdnmU E N X ι (b, r)) (Λ w) hr).hom (wcLdnmPhi E N X ι (b, r))) =
      ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom
          (((wcP1Over E).left.presheaf.germ (wcSgD E 1 e)
            (Limits.pullback.snd X.hom (wcProjKStr E 1) w) he).hom (wcSgE E 1 e 0)) *
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom
          (wcLdpGerm E N ι (wcLdpQuad E N (fun p q => v₁ (p, q))) b
            (Limits.pullback.fst X.hom (wcProjKStr E 1) w) hx) -
      ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom
          (((wcP1Over E).left.presheaf.germ (wcSgD E 1 e)
            (Limits.pullback.snd X.hom (wcProjKStr E 1) w) he).hom (wcSgE E 1 e 1)) *
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom
          (wcLdpGerm E N ι (wcLdpQuad E N (fun p q => v₀ (p, q))) b
            (Limits.pullback.fst X.hom (wcProjKStr E 1) w) hx) := by
    rw [hA, hD v₁, hD v₀]
    exact ALG ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom
      ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom
      (wcLdpConst E X.hom (Limits.pullback.fst X.hom (wcProjKStr E 1) w))
      (wcLdpConst E (wcP1Over E).hom (Limits.pullback.snd X.hom (wcProjKStr E 1) w)) hC _ _ _ _ _
      (hrule (Limits.pullback.snd X.hom (wcProjKStr E 1) w) r ht e he)
  have he01 : e = 0 ∨ e = 1 := by
    have key : ∀ e' : Fin 2, e' = 0 ∨ e' = 1 := by decide
    exact key e
  have hσ : ((wcP1Over E).left.presheaf.germ (wcSgD E 1 e)
        (Limits.pullback.snd X.hom (wcProjKStr E 1) w) he).hom (wcSgE E 1 e 0) = 1 ∨
      ((wcP1Over E).left.presheaf.germ (wcSgD E 1 e)
        (Limits.pullback.snd X.hom (wcProjKStr E 1) w) he).hom (wcSgE E 1 e 1) = 1 := by
    rcases he01 with rfl | rfl
    · left; rw [hE1, map_one]
    · right; rw [hE1, map_one]
  have hL := ellUnit _ (wcLdpConst E (wcP1Over E).hom (Limits.pullback.snd X.hom (wcProjKStr E 1) w))
    _ _ hσ ((wcLdnmIdx N).symm r) _ (hrule (Limits.pullback.snd X.hom (wcProjKStr E 1) w) r ht e he)
  obtain ⟨Lu, hLu⟩ := hL.map ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom

  have hmem : Λ w ∈ wcLdnmU E N X ι (b, r) ⊓ wcLdnmU E N X ι (b', r) := ⟨hr, hj⟩
  obtain ⟨u₁, hu₁, hu₁eq⟩ := htr (b, r) (b', r)
  have hchg : ((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.germ
        (wcLdnmU E N X ι (b', r)) (Λ w) hj).hom (wcLdnmPhi E N X ι (b', r)) =
      ((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.germ _ (Λ w) hmem).hom u₁ *
      ((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.germ
        (wcLdnmU E N X ι (b, r)) (Λ w) hr).hom (wcLdnmPhi E N X ι (b, r)) := by
    have e1 := congrArg
      ((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.germ _ (Λ w) hmem).hom hu₁eq
    rw [map_mul] at e1
    rw [← GR (inf_le_right : wcLdnmU E N X ι (b, r) ⊓ wcLdnmU E N X ι (b', r) ≤
        wcLdnmU E N X ι (b', r)) (Λ w) hmem,
      ← GR (inf_le_left : wcLdnmU E N X ι (b, r) ⊓ wcLdnmU E N X ι (b', r) ≤
        wcLdnmU E N X ι (b, r)) (Λ w) hmem]
    exact e1
  rw [hchg, map_mul]
  rcases he01 with rfl | rfl
  · have hH0 : ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.germ
          (wcLdpW E N X ι (b, 0)) w hw).hom (wcLdpH E N X ι (wcLdpQuad E N fun p q => v₀ (p, q))
            (wcLdpQuad E N fun p q => v₁ (p, q)) (b, 0)) =
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom
            (wcLdpGerm E N ι (wcLdpQuad E N (fun p q => v₁ (p, q))) b
              (Limits.pullback.fst X.hom (wcProjKStr E 1) w) hx) -
          ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom
            (((wcP1Over E).left.presheaf.germ (wcSgD E 1 0)
              (Limits.pullback.snd X.hom (wcProjKStr E 1) w) he).hom (wcSgE E 1 0 1)) *
          ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom
            (wcLdpGerm E N ι (wcLdpQuad E N (fun p q => v₀ (p, q))) b
              (Limits.pullback.fst X.hom (wcProjKStr E 1) w) hx) := by
      unfold wcLdpH
      rw [map_sub, map_mul, F0, F0, F0] <;> rfl
    have hσ0 : ((wcP1Over E).left.presheaf.germ (wcSgD E 1 0)
        (Limits.pullback.snd X.hom (wcProjKStr E 1) w) he).hom (wcSgE E 1 0 0) = 1 := by
      rw [hE1, map_one]
    have hfin : (Lu : (Limits.pullback X.hom (wcProjKStr E 1)).presheaf.stalk w) *
        (Λ.stalkMap w).hom
          (((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.germ
            (wcLdnmU E N X ι (b, r)) (Λ w) hr).hom (wcLdnmPhi E N X ι (b, r))) =
        ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.germ
          (wcLdpW E N X ι (b, 0)) w hw).hom (wcLdpH E N X ι (wcLdpQuad E N fun p q => v₀ (p, q))
            (wcLdpQuad E N fun p q => v₁ (p, q)) (b, 0)) := by
      rw [hLu, hPhiL, hH0, hσ0, map_one, one_mul]
    refine ⟨_, ?_, FIN0 _ _ _ Lu hfin⟩
    exact ((hu₁.map ((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.germ _ (Λ w)
      hmem).hom).map (Λ.stalkMap w).hom).mul Lu⁻¹.isUnit
  · have hH1 : ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.germ
          (wcLdpW E N X ι (b, 1)) w hw).hom (wcLdpH E N X ι (wcLdpQuad E N fun p q => v₀ (p, q))
            (wcLdpQuad E N fun p q => v₁ (p, q)) (b, 1)) =
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom
            (wcLdpGerm E N ι (wcLdpQuad E N (fun p q => v₀ (p, q))) b
              (Limits.pullback.fst X.hom (wcProjKStr E 1) w) hx) -
          ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom
            (((wcP1Over E).left.presheaf.germ (wcSgD E 1 1)
              (Limits.pullback.snd X.hom (wcProjKStr E 1) w) he).hom (wcSgE E 1 1 0)) *
          ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom
            (wcLdpGerm E N ι (wcLdpQuad E N (fun p q => v₁ (p, q))) b
              (Limits.pullback.fst X.hom (wcProjKStr E 1) w) hx) := by
      unfold wcLdpH
      rw [map_sub, map_mul, F0, F0, F0] <;> rfl
    have hσ1 : ((wcP1Over E).left.presheaf.germ (wcSgD E 1 1)
        (Limits.pullback.snd X.hom (wcProjKStr E 1) w) he).hom (wcSgE E 1 1 1) = 1 := by
      rw [hE1, map_one]
    have hfin : (Lu : (Limits.pullback X.hom (wcProjKStr E 1)).presheaf.stalk w) *
        (Λ.stalkMap w).hom
          (((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.germ
            (wcLdnmU E N X ι (b, r)) (Λ w) hr).hom (wcLdnmPhi E N X ι (b, r))) =
        -((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.germ
          (wcLdpW E N X ι (b, 1)) w hw).hom (wcLdpH E N X ι (wcLdpQuad E N fun p q => v₀ (p, q))
            (wcLdpQuad E N fun p q => v₁ (p, q)) (b, 1)) := by
      rw [hLu, hPhiL, hH1, hσ1, map_one]
      ring
    refine ⟨_, ?_, FIN1 _ _ _ Lu hfin⟩
    exact (((hu₁.map ((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.germ _ (Λ w)
      hmem).hom).map (Λ.stalkMap w).hom).mul Lu⁻¹.isUnit).mul isUnit_one.neg

theorem wc_ldnm_di_projmap_pb (E Ω : Type u) [Field E] [Field Ω] [Algebra E Ω] (M : ℕ) :
    IsPullback (wcLdpProjMap E Ω M) (wcProjKStr Ω M) (wcProjKStr E M)
      (Spec.map (CommRingCat.ofHom (algebraMap E Ω))) :=
by
  classical
  have PB : ∀ (N : ℕ) (F F' : Type u) [Field F] [Field F'] [Algebra F F'],
      IsPullback (wcLdpProjMap F F' N) (wcProjKStr F' N) (wcProjKStr F N)
        (Spec.map (CommRingCat.ofHom (algebraMap F F'))) := by
    intro N
    have s6 : ∀ {W X Y Z : Scheme.{u}} (φ : W ⟶ X) (p' : W ⟶ Y) (p : X ⟶ Z) (g : Y ⟶ Z) {ι : Type}
        (U U' : ι → Scheme.{u}) (j : ∀ i, U i ⟶ X) (j' : ∀ i, U' i ⟶ W) (φi : ∀ i, U' i ⟶ U i)
        [∀ i, IsOpenImmersion (j i)] [∀ i, IsOpenImmersion (j' i)],
        (⨆ i, (j i).opensRange) = ⊤ → (∀ i, j' i ≫ φ = φi i ≫ j i) →
        (∀ i, φ ⁻¹ᵁ (j i).opensRange = (j' i).opensRange) →
        (∀ i, IsPullback (φi i) (j' i ≫ p') (j i ≫ p) g) → IsPullback φ p' p g := by
      intro W X Y Z φ p' p g ι U U' j j' φi hjI hj'I hcov hcomm hpre hpb
      have hc : ∀ x : X, ∃ i y, j i y = x := by
        intro x
        have hx : x ∈ (⨆ i, (j i).opensRange) := by rw [hcov]; trivial
        obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
        obtain ⟨y, hy⟩ := Scheme.Hom.mem_opensRange.mp hi
        exact ⟨i, y, hy⟩
      refine Scheme.isPullback_of_openCover φ p' p g
        (Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) ι U j hc) ?_
      intro i
      have Q := (@IsOpenImmersion.isPullback _ _ _ _ (φi i) (j' i) (j i) φ (hj'I i) (hjI i)
        (hcomm i) (hpre i)).flip
      refine IsPullback.of_iso (hpb i) Q.isoPullback (Iso.refl _) (Iso.refl _) (Iso.refl _)
        ?_ ?_ ?_ ?_
      · show φi i ≫ 𝟙 _ = Q.isoPullback.hom ≫ Limits.pullback.snd φ (j i)
        rw [Category.comp_id, IsPullback.isoPullback_hom_snd]
      · show (j' i ≫ p') ≫ 𝟙 _ = Q.isoPullback.hom ≫ (Limits.pullback.fst φ (j i) ≫ p')
        rw [Category.comp_id, ← Category.assoc, IsPullback.isoPullback_hom_fst]
      · show (j i ≫ p) ≫ 𝟙 _ = 𝟙 _ ≫ (j i ≫ p)
        rw [Category.comp_id, Category.id_comp]
      · show g ≫ 𝟙 _ = 𝟙 _ ≫ g
        rw [Category.comp_id, Category.id_comp]
    intro F F' _ _ _

    have s2 : ∀ (K : Type u) [Field K] (a : Fin (N + 1)),
        letI := (MvPolynomial.gradedAlgebra :
          GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K));
        ∀ (s : MvPolynomial (Fin (N + 1)) K), s = MvPolynomial.X a →
        ∃ e : MvPolynomial (Fin N) K ≃+*
          HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) s,
        (∀ c : K, e (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers s)
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)) ∧
        ∀ j : Fin N, (e (MvPolynomial.X j)).val =
          Localization.mk (MvPolynomial.X (a.succAbove j)) ⟨s, Submonoid.mem_powers s⟩ := by
      intro K _ a
      letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))
      intro s hs
      subst hs

      have scale : ∀ {S : Type u} [CommRing S] (φ : K →+* S) (x : Fin (N + 1) → S) (t : S) (n : ℕ)
          (F : MvPolynomial (Fin (N + 1)) K), F.IsHomogeneous n →
          MvPolynomial.eval₂ φ (fun j => t * x j) F = t ^ n * MvPolynomial.eval₂ φ x F := by
        intro S _ φ x t n F hF
        conv_lhs => rw [F.as_sum]
        conv_rhs => rw [F.as_sum]
        rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun d hd => ?_)
        have hdeg : Finsupp.degree d = n := by
          by_contra h
          exact (MvPolynomial.mem_support_iff.mp hd) (hF.coeff_eq_zero h)
        rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
        have hp : (d.prod fun i e => (t * x i) ^ e) = t ^ n * d.prod fun i e => x i ^ e := by
          simp only [mul_pow]
          rw [Finsupp.prod_mul]
          congr 1
          rw [← hdeg, Finsupp.degree_apply]
          unfold Finsupp.prod
          rw [Finset.prod_pow_eq_pow_sum]
        rw [hp]
        ring
      have hX : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X K a)
      have hg : ∀ i : Fin N, (MvPolynomial.X (a.succAbove i) : MvPolynomial (Fin (N + 1)) K) ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (1 • 1) := fun i =>
        (MvPolynomial.mem_homogeneousSubmodule _ _).2 (MvPolynomial.isHomogeneous_X K _)

      obtain ⟨ψ, hψC, hψX⟩ : ∃ ψ : MvPolynomial (Fin N) K →+*
          HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (MvPolynomial.X a),
          (∀ c : K, ψ (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X a))
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)) ∧
          (∀ i : Fin N, ψ (MvPolynomial.X i) = HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hX 1
            (MvPolynomial.X (a.succAbove i)) (hg i)) :=
        ⟨MvPolynomial.eval₂Hom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X a))).comp
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)))
          (fun i => HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            hX 1 (MvPolynomial.X (a.succAbove i)) (hg i)),
          fun c => by rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply],
          fun i => by rw [MvPolynomial.eval₂Hom_X']⟩

      obtain ⟨ρt, hρC, hρa, hρs⟩ : ∃ ρt : MvPolynomial (Fin (N + 1)) K →+* MvPolynomial (Fin N) K,
          (∀ c : K, ρt (MvPolynomial.C c) = MvPolynomial.C c) ∧ ρt (MvPolynomial.X a) = 1 ∧
          (∀ i : Fin N, ρt (MvPolynomial.X (a.succAbove i)) = MvPolynomial.X i) :=
        ⟨MvPolynomial.eval₂Hom MvPolynomial.C
            (Fin.insertNth (α := fun _ => MvPolynomial (Fin N) K) a 1 MvPolynomial.X),
          fun c => by rw [MvPolynomial.eval₂Hom_C],
          by rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_same],
          fun i => by rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove]⟩
      have hu : IsUnit (ρt (MvPolynomial.X a)) := by rw [hρa]; exact isUnit_one
      have hu1 : (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) *
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) (MvPolynomial.X a) = 1 := by
        rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
        exact Localization.mk_self (⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
          Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))

      obtain ⟨ρ, hρ1, hρ2⟩ : ∃ ρ : HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a) →+*
          MvPolynomial (Fin N) K,
          (∀ z y, algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) z =
            algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) y → ρ z = ρt y) ∧
          (∀ (n : ℕ) (F : MvPolynomial (Fin (N + 1)) K)
            (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (n • 1)),
            ρ (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
              hX n F hF) = ρt F) := by
        refine ⟨(IsLocalization.Away.lift (MvPolynomial.X a) hu :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) →+*
              MvPolynomial (Fin N) K).comp (algebraMap _ _), ?_, ?_⟩
        · intro z y hzy
          rw [RingHom.comp_apply, hzy, IsLocalization.Away.lift_eq]
        · intro n F hF
          rw [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
            HomogeneousLocalization.Away.val_mk]
          have hs := IsLocalization.mk'_spec
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) F
            (⟨MvPolynomial.X a ^ n, pow_mem (Submonoid.mem_powers _) n⟩ :
              Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
          rw [← Localization.mk_eq_mk'_apply] at hs
          have hs2 := congrArg (IsLocalization.Away.lift (MvPolynomial.X a) hu :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) →+*
              MvPolynomial (Fin N) K) hs
          rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq] at hs2
          simp only [map_pow, hρa, one_pow, mul_one] at hs2
          exact hs2
      have hΨC : ∀ c : K, algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
            (ψ (MvPolynomial.C c)) =
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) (MvPolynomial.C c) := by
        intro c
        rw [hψC, HomogeneousLocalization.algebraMap_apply, ← Localization.mk_one_eq_algebraMap]
        have h1 : ((algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c :
            ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) : MvPolynomial (Fin (N + 1)) K) =
            MvPolynomial.C c := by
          rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        rw [← h1]
        rfl
      have hΨX : ∀ i : Fin N, algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
            (ψ (MvPolynomial.X i)) =
          (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) *
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
            (MvPolynomial.X (a.succAbove i)) := by
        intro i
        rw [hψX, HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
          ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
        congr 1
        ext
        simp
      have hcomp : ((algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))).comp ψ).comp ρt =
          MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))).comp MvPolynomial.C)
            (fun j => (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
              Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) *
              algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
                (MvPolynomial.X j)) := by
        apply MvPolynomial.ringHom_ext
        · intro c
          rw [RingHom.comp_apply, RingHom.comp_apply, hρC, hΨC, MvPolynomial.eval₂Hom_C,
            RingHom.comp_apply]
        · intro j
          rw [MvPolynomial.eval₂Hom_X', RingHom.comp_apply, RingHom.comp_apply]
          rcases Fin.eq_self_or_eq_succAbove a j with h | ⟨i, h⟩
          · subst h
            rw [hρa, map_one, map_one, hu1]
          · subst h
            rw [hρs, hΨX]
      have hev : MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))).comp MvPolynomial.C)
            (fun j => algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
                (MvPolynomial.X j)) =
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) := by
        apply MvPolynomial.ringHom_ext
        · intro c
          rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
        · intro j
          rw [MvPolynomial.eval₂Hom_X']
      have key : ∀ (n : ℕ) (F : MvPolynomial (Fin (N + 1)) K), F.IsHomogeneous n →
          algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) (ψ (ρt F)) *
            algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
              (MvPolynomial.X a ^ n) =
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) F := by
        intro n F hF
        have h1 := RingHom.congr_fun hcomp F
        rw [RingHom.comp_apply, RingHom.comp_apply] at h1
        rw [h1, MvPolynomial.coe_eval₂Hom]
        have hs := scale ((algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))).comp MvPolynomial.C)
          (fun j => algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
                (MvPolynomial.X j))
          (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩) n F hF
        rw [hs, ← MvPolynomial.coe_eval₂Hom, hev, map_pow]
        calc (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
              Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) ^ n *
              algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) F *
              algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
                (MvPolynomial.X a) ^ n
            = ((Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
              Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) *
              algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
                (MvPolynomial.X a)) ^ n *
              algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) F := by ring
          _ = _ := by rw [hu1, one_pow, one_mul]
      have h1 : ψ.comp ρ = RingHom.id _ := by
        apply RingHom.ext
        intro z
        obtain ⟨n, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hX z
        rw [RingHom.comp_apply, hρ2, RingHom.id_apply]
        have hFh : F.IsHomogeneous n := by
          rw [smul_eq_mul, mul_one] at hF
          exact (MvPolynomial.mem_homogeneousSubmodule n F).1 hF
        apply HomogeneousLocalization.val_injective (Submonoid.powers (MvPolynomial.X a))
        rw [HomogeneousLocalization.Away.val_mk, ← HomogeneousLocalization.algebraMap_apply,
          Localization.mk_eq_mk'_apply, IsLocalization.eq_mk'_iff_mul_eq]
        exact key n F hFh
      have h2 : ρ.comp ψ = RingHom.id _ := by
        apply MvPolynomial.ringHom_ext
        · intro c
          rw [RingHom.comp_apply, hρ1 _ _ (hΨC c), hρC, RingHom.id_apply]
        · intro i
          rw [RingHom.comp_apply, hψX, hρ2, hρs, RingHom.id_apply]
      refine ⟨RingEquiv.ofRingHom ψ ρ h1 h2, fun c => ?_, fun j => ?_⟩
      · rw [RingEquiv.ofRingHom_apply, hψC]
      · rw [RingEquiv.ofRingHom_apply, hψX, HomogeneousLocalization.Away.val_mk]
        congr 1
        ext
        simp

    have hspan : ∀ (K : Type u) [Field K],
        letI := (MvPolynomial.gradedAlgebra :
          GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K));
        (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)).toIdeal ≤
          Ideal.span (Set.range MvPolynomial.X) := by
      intro K _
      letI := (MvPolynomial.gradedAlgebra :
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))
      intro p hp
      have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          p).mp hp
      have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0 p =
          MvPolynomial.homogeneousComponent 0 p :=
        (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
      rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro e he
      rw [MvPolynomial.mem_support_iff] at he
      have hne : e ≠ 0 := by
        rintro rfl
        exact he h0
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
      exact ⟨i, Set.mem_univ i, by simpa using hi⟩

    have V0 : ∀ (K : Type u) [Field K],
        letI := (MvPolynomial.gradedAlgebra :
          GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K));
        ∀ (s : MvPolynomial (Fin (N + 1)) K) (c : K),
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (Submonoid.powers s)
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)).val =
          Localization.mk (MvPolynomial.C c) 1 := by
      intro K _
      letI := (MvPolynomial.gradedAlgebra :
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))
      intro s c
      have h1 : ((algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c :
          ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) : MvPolynomial (Fin (N + 1)) K) =
          MvPolynomial.C c := by
        rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
      rw [← h1]
      rfl
    letI iF : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) :=
      MvPolynomial.gradedAlgebra
    letI iF' : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') :=
      MvPolynomial.gradedAlgebra
    obtain ⟨f, hfmap, hfdef⟩ : ∃ f : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F →+*ᵍ
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F',
        (∀ p, f p = MvPolynomial.map (algebraMap F F') p) ∧ f = wcLdpGrHom F F' N :=
      ⟨wcLdpGrHom F F' N, fun p => rfl, rfl⟩
    have hX : ∀ a : Fin (N + 1), (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) F) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 1 := fun a =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X F a)
    have hfX : ∀ a : Fin (N + 1), f (MvPolynomial.X a) = MvPolynomial.X a := fun a => by
      rw [hfmap, MvPolynomial.map_X]

    have hf : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≤
        HomogeneousIdeal.map f
          (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F)) := by
      intro p hp
      have hp' : p ∈ Ideal.span (Set.range (MvPolynomial.X :
          Fin (N + 1) → MvPolynomial (Fin (N + 1)) F')) := hspan F' hp
      change p ∈ (HomogeneousIdeal.map f _).toIdeal
      rw [HomogeneousIdeal.toIdeal_map]
      refine (Ideal.span_le.mpr ?_) hp'
      rintro _ ⟨i, rfl⟩
      rw [← hfX i]
      apply Ideal.mem_map_of_mem
      change MvPolynomial.X i ∈ HomogeneousIdeal.irrelevant _
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
      exact DirectSum.decompose_of_mem_ne _ (hX i) one_ne_zero

    have s3 : ∀ {P : Submonoid (MvPolynomial (Fin (N + 1)) F)}
        {Q : Submonoid (MvPolynomial (Fin (N + 1)) F')} (comap_le : P ≤ Submonoid.comap f Q)
        (z : HomogeneousLocalization (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) P)
        (n : MvPolynomial (Fin (N + 1)) F) (d : P), z.val = Localization.mk n d →
        (HomogeneousLocalization.map f comap_le z).val =
          Localization.mk (f n) ⟨f d, comap_le d.2⟩ := by
      intro P Q comap_le z n d h
      obtain ⟨x, rfl⟩ := HomogeneousLocalization.mk_surjective z
      rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk]
      rw [HomogeneousLocalization.val_mk, Localization.mk_eq_mk_iff, Localization.r_iff_exists] at h
      obtain ⟨c, hc⟩ := h
      rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨⟨f c, comap_le c.2⟩, ?_⟩
      have := congrArg f hc
      simp only [map_mul] at this
      exact this

    have hchart : ∀ a : Fin (N + 1), IsPullback
        (Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))))
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
            (f.map_mem (hX a)) Nat.one_pos ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))))
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
            Nat.one_pos ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0)))))
        (Spec.map (CommRingCat.ofHom (algebraMap F F'))) := by
      intro a
      obtain ⟨e, heC, heX⟩ := s2 F a (MvPolynomial.X a) rfl
      obtain ⟨e', he'C, he'X⟩ := s2 F' a (f (MvPolynomial.X a)) (hfX a)

      have hcompat : ∀ p : MvPolynomial (Fin N) F,
          HomogeneousLocalization.Away.map f (MvPolynomial.X a) (e p) =
            e' (MvPolynomial.map (algebraMap F F') p) := by
        have key : (HomogeneousLocalization.Away.map f (MvPolynomial.X a)).comp e.toRingHom =
            e'.toRingHom.comp (MvPolynomial.map (algebraMap F F')) := by
          apply MvPolynomial.ringHom_ext
          · intro c
            show HomogeneousLocalization.Away.map f (MvPolynomial.X a) (e (MvPolynomial.C c)) =
              e' (MvPolynomial.map (algebraMap F F') (MvPolynomial.C c))
            rw [MvPolynomial.map_C, heC, he'C]
            apply HomogeneousLocalization.val_injective _
            rw [HomogeneousLocalization.Away.map.eq_1, s3 _ _ (MvPolynomial.C c) 1 (V0 F _ c),
              V0 F' _ (algebraMap F F' c)]
            congr 1
            · rw [hfmap, MvPolynomial.map_C]
            · ext
              simp
          · intro j
            show HomogeneousLocalization.Away.map f (MvPolynomial.X a) (e (MvPolynomial.X j)) =
              e' (MvPolynomial.map (algebraMap F F') (MvPolynomial.X j))
            rw [MvPolynomial.map_X]
            apply HomogeneousLocalization.val_injective _
            rw [HomogeneousLocalization.Away.map.eq_1, s3 _ _ _ _ (heX j), he'X j]
            congr 1
            rw [hfmap, MvPolynomial.map_X]
        intro p
        exact RingHom.congr_fun key p

      have P : IsPushout
          (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (Submonoid.powers (MvPolynomial.X a))).comp
            (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0))))
          (CommRingCat.ofHom (algebraMap F F'))
          (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a)))
          (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
            (Submonoid.powers (f (MvPolynomial.X a)))).comp
            (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) := by
        letI := (MvPolynomial.algebraMvPolynomial :
          Algebra (MvPolynomial (Fin N) F) (MvPolynomial (Fin N) F'))
        have P0 := CommRingCat.isPushout_of_isPushout F (MvPolynomial (Fin N) F) F'
          (MvPolynomial (Fin N) F')
        refine IsPushout.of_iso P0 (Iso.refl _) e.toCommRingCatIso (Iso.refl _) e'.toCommRingCatIso
          ?_ ?_ ?_ ?_
        · apply CommRingCat.hom_ext
          apply RingHom.ext
          intro c
          exact heC c
        · simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
        · apply CommRingCat.hom_ext
          apply RingHom.ext
          intro p
          exact (hcompat p).symm
        · apply CommRingCat.hom_ext
          apply RingHom.ext
          intro c
          exact he'C c
      have hj : Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
            Nat.one_pos ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0)))) =
          Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (Submonoid.powers (MvPolynomial.X a))).comp
            (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0)))) := by
        rw [← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hj' : Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
            (f.map_mem (hX a)) Nat.one_pos ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) =
          Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
            (Submonoid.powers (f (MvPolynomial.X a)))).comp
            (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) := by
        rw [← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      rw [hj, hj']
      exact isPullback_SpecMap_of_isPushout _ _ _ _ P
    have hcov : (⨆ a : Fin (N + 1), (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F)
        (MvPolynomial.X a) (hX a) Nat.one_pos).opensRange) = ⊤ := by
      simp only [Proj.opensRange_awayι]
      exact Proj.iSup_basicOpen_eq_top _ _ (hspan F)
    have hcomm : ∀ a : Fin (N + 1),
        Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
            (f.map_mem (hX a)) Nat.one_pos ≫ Proj.map f hf =
          Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))) ≫
            Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
              Nat.one_pos := fun a =>
      Proj.awayι_comp_map f hf Nat.one_pos (MvPolynomial.X a) (hX a)
    have hpre : ∀ a : Fin (N + 1), Proj.map f hf ⁻¹ᵁ
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
          Nat.one_pos).opensRange =
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
            (f.map_mem (hX a)) Nat.one_pos).opensRange := fun a => by
      rw [Proj.opensRange_awayι, Proj.opensRange_awayι, Proj.map_preimage_basicOpen]
    have H := s6 (Proj.map f hf)
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))))
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0))))
      (Spec.map (CommRingCat.ofHom (algebraMap F F')))
      (fun a : Fin (N + 1) => Spec (CommRingCat.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a))))
      (fun a : Fin (N + 1) => Spec (CommRingCat.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a)))))
      (fun a => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a)
        (hX a) Nat.one_pos)
      (fun a => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
        (f.map_mem (hX a)) Nat.one_pos)
      (fun a => Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))))
      hcov hcomm hpre hchart
    subst hfdef
    exact H
  exact PB M E Ω

theorem wc_ldnm_di_projmap_sec (E Ω : Type u) [Field E] [Field Ω] [Algebra E Ω] (M : ℕ) :
    (∀ a : Fin (M + 1), wcLdpProjMap E Ω M ⁻¹ᵁ wcSgD E M a = wcSgD Ω M a) ∧
    (∀ (a b : Fin (M + 1)) (h : wcSgD Ω M a ≤ wcLdpProjMap E Ω M ⁻¹ᵁ wcSgD E M a),
      ((wcLdpProjMap E Ω M).appLE (wcSgD E M a) (wcSgD Ω M a) h).hom (wcSgE E M a b) =
        wcSgE Ω M a b) ∧
    (∀ (a : Fin (M + 1)) (G : MvPolynomial.homogeneousSubmodule (Fin (M + 1)) E 2)
      (h : wcSgD Ω M a ≤ wcLdpProjMap E Ω M ⁻¹ᵁ wcSgD E M a),
      ((wcLdpProjMap E Ω M).appLE (wcSgD E M a) (wcSgD Ω M a) h).hom (wcLdpSec E M G a) =
        wcLdpSec Ω M (wcLdpMapQ E Ω M G) a) :=
by
  classical
  have htop : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y), ⊤ ≤ g ⁻¹ᵁ ⊤ := fun g =>
    le_of_eq (Scheme.Hom.preimage_top g).symm
  have H1 : ∀ {X Y : Scheme.{u}} (g g' : X ⟶ Y) (hg : g = g') (U : Y.Opens) (V : X.Opens)
      (e : V ≤ g ⁻¹ᵁ U), g.appLE U V e = g'.appLE U V (hg ▸ e) := by
    intro X Y g g' hg U V e
    subst hg
    rfl
  have H2 : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y) (e : ⊤ ≤ g ⁻¹ᵁ ⊤), g.appLE ⊤ ⊤ e = g.appTop := by
    intro X Y g e
    rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
    rfl
  have ΓI : ∀ (R : CommRingCat.{u}) (y : R),
      (Scheme.ΓSpecIso R).hom.hom ((Scheme.ΓSpecIso R).inv.hom y) = y := by
    intro R y
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, Iso.inv_hom_id, CommRingCat.hom_id,
      RingHom.id_apply]
  have chart : ∀ {σ A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (c : A) {m : ℕ} (hc : c ∈ 𝒜 m) (hm : 0 < m)
      (e : ⊤ ≤ Proj.awayι 𝒜 c hc hm ⁻¹ᵁ Proj.basicOpen 𝒜 c)
      (x : HomogeneousLocalization.Away 𝒜 c),
      ((Proj.awayι 𝒜 c hc hm).appLE (Proj.basicOpen 𝒜 c) ⊤ e).hom
          ((Proj.awayToSection 𝒜 c).hom x) =
        (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 c))).inv.hom x := by
    intro σ A _ _ _ 𝒜 _ c m hc hm e x
    have hi : ∀ y, (Proj.basicOpenIsoSpec 𝒜 c hc hm).hom.appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 c))).inv.hom y) =
        (Proj.basicOpen 𝒜 c).topIso.inv.hom ((Proj.awayToSection 𝒜 c).hom y) := by
      intro y
      rw [Proj.basicOpenIsoSpec_hom, Scheme.Hom.appTop, Proj.basicOpenToSpec_app_top]
      simp only [CommRingCat.hom_comp, RingHom.comp_apply]
      rw [ΓI]
    have e1 : (Proj.awayι 𝒜 c hc hm).appLE (Proj.basicOpen 𝒜 c) ⊤ e =
        (Proj.basicOpen 𝒜 c).ι.appLE (Proj.basicOpen 𝒜 c) ⊤
            (Scheme.Opens.ι_preimage_self (Proj.basicOpen 𝒜 c)).symm.le ≫
          (Proj.basicOpenIsoSpec 𝒜 c hc hm).inv.appLE ⊤ ⊤ (htop _) := by
      rw [Scheme.Hom.appLE_comp_appLE, H1 _ _ (Proj.basicOpenIsoSpec_inv_ι 𝒜 c hc hm).symm]
    have e2 : (Proj.basicOpen 𝒜 c).ι.appLE (Proj.basicOpen 𝒜 c) ⊤
        (Scheme.Opens.ι_preimage_self (Proj.basicOpen 𝒜 c)).symm.le =
        (Proj.basicOpen 𝒜 c).topIso.inv := by
      rw [Scheme.Opens.ι_appLE, Scheme.Opens.topIso_inv]
      rfl
    rw [e1, e2, H2, CommRingCat.hom_comp, RingHom.comp_apply, ← hi, ← RingHom.comp_apply,
      ← CommRingCat.hom_comp, ← Scheme.Hom.comp_appTop, Iso.inv_hom_id, Scheme.Hom.id_appTop,
      CommRingCat.hom_id, RingHom.id_apply]
  have sec : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      [CommRing B] [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ}
      [GradedRing 𝒜] [GradedRing ℬ] (f : 𝒜 →+*ᵍ ℬ)
      (hf : HomogeneousIdeal.irrelevant ℬ ≤
        HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜))
      (s : A) (t : B) (hst : f s = t) {m : ℕ} (hs : s ∈ 𝒜 m) (ht : t ∈ ℬ m) (hm : 0 < m)
      (h : Proj.basicOpen ℬ t ≤ Proj.map f hf ⁻¹ᵁ Proj.basicOpen 𝒜 s)
      (n : ℕ) (a : A) (ha : a ∈ 𝒜 (n • m)),
      ((Proj.map f hf).appLE (Proj.basicOpen 𝒜 s) (Proj.basicOpen ℬ t) h).hom
          ((Proj.awayToSection 𝒜 s).hom (HomogeneousLocalization.Away.mk 𝒜 hs n a ha)) =
        (Proj.awayToSection ℬ t).hom
          (HomogeneousLocalization.Away.mk ℬ ht n (f a) (f.map_mem ha)) := by
    intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hf s t hst m hs ht hm h n a ha
    subst hst
    have eB : ⊤ ≤ Proj.awayι ℬ (f s) ht hm ⁻¹ᵁ Proj.basicOpen ℬ (f s) := by
      intro z _
      show Proj.awayι ℬ (f s) ht hm z ∈ Proj.basicOpen ℬ (f s)
      rw [← Proj.opensRange_awayι ℬ (f s) ht hm]
      exact ⟨z, rfl⟩
    have eA : ⊤ ≤ Proj.awayι 𝒜 s hs hm ⁻¹ᵁ Proj.basicOpen 𝒜 s := by
      intro z _
      show Proj.awayι 𝒜 s hs hm z ∈ Proj.basicOpen 𝒜 s
      rw [← Proj.opensRange_awayι 𝒜 s hs hm]
      exact ⟨z, rfl⟩
    have inj : ∀ z₁ z₂ : Γ(Proj ℬ, Proj.basicOpen ℬ (f s)),
        ((Proj.awayι ℬ (f s) ht hm).appLE (Proj.basicOpen ℬ (f s)) ⊤ eB).hom z₁ =
          ((Proj.awayι ℬ (f s) ht hm).appLE (Proj.basicOpen ℬ (f s)) ⊤ eB).hom z₂ →
            z₁ = z₂ := by
      have hsur : ∀ z : Γ(Proj ℬ, Proj.basicOpen ℬ (f s)), ∃ y,
          (Proj.awayToSection ℬ (f s)).hom y = z := by
        intro z
        refine ⟨(Proj.basicOpenIsoAway ℬ (f s) ht hm).inv.hom z, ?_⟩
        rw [← Proj.basicOpenIsoAway_hom ℬ (f s) ht hm, ← RingHom.comp_apply,
          ← CommRingCat.hom_comp, Iso.inv_hom_id, CommRingCat.hom_id, RingHom.id_apply]
      intro z₁ z₂ hz
      obtain ⟨y₁, rfl⟩ := hsur z₁
      obtain ⟨y₂, rfl⟩ := hsur z₂
      rw [chart, chart] at hz
      have hz' := congrArg (Scheme.ΓSpecIso _).hom.hom hz
      rw [ΓI, ΓI] at hz'
      rw [hz']
    apply inj
    rw [chart]
    have c1 := congrArg (fun φ => φ.hom ((Proj.awayToSection 𝒜 s).hom
        (HomogeneousLocalization.Away.mk 𝒜 hs n a ha)))
      (Scheme.Hom.appLE_comp_appLE (Proj.awayι ℬ (f s) ht hm) (Proj.map f hf)
        (Proj.basicOpen 𝒜 s) (Proj.basicOpen ℬ (f s)) ⊤ h eB)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at c1
    rw [c1, H1 _ _ (Proj.awayι_comp_map f hf hm s hs)]
    have c2 := congrArg (fun φ => φ.hom ((Proj.awayToSection 𝒜 s).hom
        (HomogeneousLocalization.Away.mk 𝒜 hs n a ha)))
      (Scheme.Hom.appLE_comp_appLE
        (Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f s)))
        (Proj.awayι 𝒜 s hs hm) (Proj.basicOpen 𝒜 s) ⊤ ⊤ eA (htop _))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at c2
    refine c2.symm.trans ?_
    rw [chart, H2]
    have c3 := congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk 𝒜 hs n a ha))
      (Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom (HomogeneousLocalization.Away.map f s)))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at c3
    rw [← c3, HomogeneousLocalization.Away.map_mk]

  letI iE : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) E) :=
    MvPolynomial.gradedAlgebra
  letI iΩ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω) :=
    MvPolynomial.gradedAlgebra
  obtain ⟨hf, hpm⟩ : ∃ hf, wcLdpProjMap E Ω M = Proj.map (wcLdpGrHom E Ω M) hf := ⟨_, rfl⟩
  have hXE : ∀ a : Fin (M + 1), (MvPolynomial.X a : MvPolynomial (Fin (M + 1)) E) ∈
      MvPolynomial.homogeneousSubmodule (Fin (M + 1)) E 1 := fun a =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X E a)
  have hXΩ : ∀ a : Fin (M + 1), (MvPolynomial.X a : MvPolynomial (Fin (M + 1)) Ω) ∈
      MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω 1 := fun a =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω a)
  have hfX : ∀ a : Fin (M + 1), wcLdpGrHom E Ω M (MvPolynomial.X a) = MvPolynomial.X a :=
    fun a => MvPolynomial.map_X (algebraMap E Ω) a
  have hpre : ∀ a : Fin (M + 1), wcLdpProjMap E Ω M ⁻¹ᵁ wcSgD E M a = wcSgD Ω M a := by
    intro a
    rw [hpm]
    show Proj.map (wcLdpGrHom E Ω M) hf ⁻¹ᵁ Proj.basicOpen _ (MvPolynomial.X a) =
      Proj.basicOpen _ (MvPolynomial.X a)
    rw [Proj.map_preimage_basicOpen, hfX]
  refine ⟨hpre, ?_, ?_⟩
  · intro a b h
    rw [H1 _ _ hpm]
    have hXb : (MvPolynomial.X b : MvPolynomial (Fin (M + 1)) E) ∈
        MvPolynomial.homogeneousSubmodule (Fin (M + 1)) E (1 • 1) := by
      simpa only [smul_eq_mul, mul_one] using hXE b
    have key := sec (wcLdpGrHom E Ω M) hf (MvPolynomial.X a) (MvPolynomial.X a) (hfX a)
      (hXE a) (hXΩ a) Nat.one_pos (hpm ▸ h) 1 (MvPolynomial.X b) hXb
    have H3 : ∀ (x y : MvPolynomial (Fin (M + 1)) Ω)
        (hx : x ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω (1 • 1))
        (hy : y ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω (1 • 1)), x = y →
        HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω)
          (hXΩ a) 1 x hx =
        HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω)
          (hXΩ a) 1 y hy := by
      rintro x y hx hy rfl
      rfl
    refine key.trans ?_
    exact congrArg _ (H3 _ _ _ _ (hfX b))
  · intro a G h
    rw [H1 _ _ hpm]
    have hG : (G : MvPolynomial (Fin (M + 1)) E) ∈
        MvPolynomial.homogeneousSubmodule (Fin (M + 1)) E (2 • 1) := by
      simpa only [smul_eq_mul, mul_one] using G.2
    have key := sec (wcLdpGrHom E Ω M) hf (MvPolynomial.X a) (MvPolynomial.X a) (hfX a)
      (hXE a) (hXΩ a) Nat.one_pos (hpm ▸ h) 2 (G : MvPolynomial (Fin (M + 1)) E) hG
    have H3 : ∀ (x y : MvPolynomial (Fin (M + 1)) Ω)
        (hx : x ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω (2 • 1))
        (hy : y ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω (2 • 1)), x = y →
        HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω)
          (hXΩ a) 2 x hx =
        HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω)
          (hXΩ a) 2 y hy := by
      rintro x y hx hy rfl
      rfl
    unfold wcLdpSec
    refine key.trans ?_
    exact congrArg _ (H3 _ _ _ _ rfl)

theorem wc_ldnm_di_theta_germ (E Ω : Type u) [Field E] [Field Ω] [Algebra E Ω] (N : ℕ)
    (X : Over (Spec (.of E))) (ι : X.left ⟶ wcProjK E N)
    (XΩ : Over (Spec (.of Ω))) (q : XΩ.left ⟶ X.left) (ιΩ : XΩ.left ⟶ wcProjK Ω N)
    (hιq : ιΩ ≫ wcLdpProjMap E Ω N = q ≫ ι)
    (θ : Limits.pullback XΩ.hom (wcProjKStr Ω (wcLdnmM N)) ⟶
      Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
    (hθ1 : θ ≫ Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)) =
      Limits.pullback.fst XΩ.hom (wcProjKStr Ω (wcLdnmM N)) ≫ q)
    (hθ2 : θ ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)) =
      Limits.pullback.snd XΩ.hom (wcProjKStr Ω (wcLdnmM N)) ≫ wcLdpProjMap E Ω (wcLdnmM N))
    (hpreN : ∀ a, wcLdpProjMap E Ω N ⁻¹ᵁ wcSgD E N a = wcSgD Ω N a)
    (hpreM : ∀ a, wcLdpProjMap E Ω (wcLdnmM N) ⁻¹ᵁ wcSgD E (wcLdnmM N) a =
      wcSgD Ω (wcLdnmM N) a)
    (hsecM : ∀ (a b : Fin (wcLdnmM N + 1))
      (h : wcSgD Ω (wcLdnmM N) a ≤ wcLdpProjMap E Ω (wcLdnmM N) ⁻¹ᵁ wcSgD E (wcLdnmM N) a),
      ((wcLdpProjMap E Ω (wcLdnmM N)).appLE (wcSgD E (wcLdnmM N) a)
        (wcSgD Ω (wcLdnmM N) a) h).hom (wcSgE E (wcLdnmM N) a b) = wcSgE Ω (wcLdnmM N) a b)
    (hsecN : ∀ (a : Fin (N + 1)) (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
      (h : wcSgD Ω N a ≤ wcLdpProjMap E Ω N ⁻¹ᵁ wcSgD E N a),
      ((wcLdpProjMap E Ω N).appLE (wcSgD E N a) (wcSgD Ω N a) h).hom (wcLdpSec E N G a) =
        wcLdpSec Ω N (wcLdpMapQ E Ω N G) a) :
    (∀ p, θ ⁻¹ᵁ wcLdnmU E N X ι p = wcLdnmU Ω N XΩ ιΩ p) ∧
    ∀ (p : Fin (N + 1) × Fin (wcLdnmM N + 1))
      (w : ↥(Limits.pullback XΩ.hom (wcProjKStr Ω (wcLdnmM N))))
      (hw : w ∈ wcLdnmU Ω N XΩ ιΩ p) (hθw : θ w ∈ wcLdnmU E N X ι p),
      (θ.stalkMap w).hom
        (((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.germ
          (wcLdnmU E N X ι p) (θ w) hθw).hom (wcLdnmPhi E N X ι p)) =
      ((Limits.pullback XΩ.hom (wcProjKStr Ω (wcLdnmM N))).presheaf.germ
        (wcLdnmU Ω N XΩ ιΩ p) w hw).hom (wcLdnmPhi Ω N XΩ ιΩ p) :=
by
  classical

  have G1 : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (U : B.Opens) (V : A.Opens) (e : V ≤ f ⁻¹ᵁ U)
      (x : A) (hx : x ∈ V) (hx' : f x ∈ U) (s : Γ(B, U)),
      (A.presheaf.germ V x hx).hom ((f.appLE U V e).hom s) =
        (f.stalkMap x).hom ((B.presheaf.germ U (f x) hx').hom s) := by
    intro A B f U V e x hx hx' s
    rw [Scheme.Hom.germ_stalkMap_apply, Scheme.Hom.appLE.eq_1, CommRingCat.comp_apply,
      TopCat.Presheaf.germ_res_apply]

  have G2 : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C) (U : C.Opens) (V : B.Opens)
      (e : V ≤ g ⁻¹ᵁ U) (x : A) (hx : f x ∈ V) (hx' : (f ≫ g) x ∈ U) (s : Γ(C, U)),
      ((f ≫ g).stalkMap x).hom ((C.presheaf.germ U ((f ≫ g) x) hx').hom s) =
        (f.stalkMap x).hom ((B.presheaf.germ V (f x) hx).hom ((g.appLE U V e).hom s)) := by
    intro A B C f g U V e x hx hx' s
    rw [G1 g U V e (f x) hx hx' s, Scheme.Hom.stalkMap_comp]
    rfl

  have C : ∀ {A B : Scheme.{u}} (f₁ f₂ : A ⟶ B), f₁ = f₂ → ∀ (x : A) (U : B.Opens)
      (h₁ : f₁ x ∈ U) (h₂ : f₂ x ∈ U) (s : Γ(B, U)),
      (f₁.stalkMap x).hom ((B.presheaf.germ U (f₁ x) h₁).hom s) =
        (f₂.stalkMap x).hom ((B.presheaf.germ U (f₂ x) h₂).hom s) := by
    rintro A B f₁ f₂ rfl x U h₁ h₂ s
    rfl
  have hcomp : (θ ≫ Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N))) ≫ ι =
      (Limits.pullback.fst XΩ.hom (wcProjKStr Ω (wcLdnmM N)) ≫ ιΩ) ≫ wcLdpProjMap E Ω N := by
    calc (θ ≫ Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N))) ≫ ι
        = (Limits.pullback.fst XΩ.hom (wcProjKStr Ω (wcLdnmM N)) ≫ q) ≫ ι := by rw [hθ1]
      _ = (Limits.pullback.fst XΩ.hom (wcProjKStr Ω (wcLdnmM N)) ≫ ιΩ) ≫ wcLdpProjMap E Ω N := by
        rw [Category.assoc, Category.assoc, hιq]

  have hA : ∀ (p : Fin (N + 1) × Fin (wcLdnmM N + 1)) (c : Fin (wcLdnmM N + 1))
      (w : ↥(Limits.pullback XΩ.hom (wcProjKStr Ω (wcLdnmM N))))
      (hw : w ∈ wcLdnmU Ω N XΩ ιΩ p) (hθw : θ w ∈ wcLdnmU E N X ι p),
      (θ.stalkMap w).hom
        (((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.germ
          (wcLdnmU E N X ι p) (θ w) hθw).hom
          (((Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))).appLE
            (wcSgD E (wcLdnmM N) p.2) (wcLdnmU E N X ι p) inf_le_right).hom
            (wcSgE E (wcLdnmM N) p.2 c))) =
      ((Limits.pullback XΩ.hom (wcProjKStr Ω (wcLdnmM N))).presheaf.germ
        (wcLdnmU Ω N XΩ ιΩ p) w hw).hom
        (((Limits.pullback.snd XΩ.hom (wcProjKStr Ω (wcLdnmM N))).appLE
          (wcSgD Ω (wcLdnmM N) p.2) (wcLdnmU Ω N XΩ ιΩ p) inf_le_right).hom
          (wcSgE Ω (wcLdnmM N) p.2 c)) := by
    intro p c w hw hθw
    have hle : wcSgD Ω (wcLdnmM N) p.2 ≤
        wcLdpProjMap E Ω (wcLdnmM N) ⁻¹ᵁ wcSgD E (wcLdnmM N) p.2 := (hpreM p.2).ge
    have h1 : (θ ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) w ∈
        wcSgD E (wcLdnmM N) p.2 := (TopologicalSpace.Opens.mem_inf.mp hθw).2
    have h2 : Limits.pullback.snd XΩ.hom (wcProjKStr Ω (wcLdnmM N)) w ∈
        wcSgD Ω (wcLdnmM N) p.2 := (TopologicalSpace.Opens.mem_inf.mp hw).2
    have h3 : (Limits.pullback.snd XΩ.hom (wcProjKStr Ω (wcLdnmM N)) ≫
        wcLdpProjMap E Ω (wcLdnmM N)) w ∈ wcSgD E (wcLdnmM N) p.2 := hle h2
    rw [← G2 θ (Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) _ _ inf_le_right w hθw h1,
      C _ _ hθ2 w _ h1 h3, G2 _ _ _ _ hle w h2 h3, hsecM p.2 c hle,
      G1 _ _ _ inf_le_right w hw h2]

  have hB : ∀ (p : Fin (N + 1) × Fin (wcLdnmM N + 1))
      (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
      (w : ↥(Limits.pullback XΩ.hom (wcProjKStr Ω (wcLdnmM N))))
      (hw : w ∈ wcLdnmU Ω N XΩ ιΩ p) (hθw : θ w ∈ wcLdnmU E N X ι p),
      (θ.stalkMap w).hom
        (((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.germ
          (wcLdnmU E N X ι p) (θ w) hθw).hom
          (((Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N))).appLE
            (ι ⁻¹ᵁ wcSgD E N p.1) (wcLdnmU E N X ι p) inf_le_left).hom
            ((ι.app (wcSgD E N p.1)).hom (wcLdpSec E N G p.1)))) =
      ((Limits.pullback XΩ.hom (wcProjKStr Ω (wcLdnmM N))).presheaf.germ
        (wcLdnmU Ω N XΩ ιΩ p) w hw).hom
        (((Limits.pullback.fst XΩ.hom (wcProjKStr Ω (wcLdnmM N))).appLE
          (ιΩ ⁻¹ᵁ wcSgD Ω N p.1) (wcLdnmU Ω N XΩ ιΩ p) inf_le_left).hom
          ((ιΩ.app (wcSgD Ω N p.1)).hom (wcLdpSec Ω N (wcLdpMapQ E Ω N G) p.1))) := by
    intro p G w hw hθw
    have hle : wcSgD Ω N p.1 ≤ wcLdpProjMap E Ω N ⁻¹ᵁ wcSgD E N p.1 := (hpreN p.1).ge
    have h1 : (θ ≫ Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N))) w ∈
        ι ⁻¹ᵁ wcSgD E N p.1 := (TopologicalSpace.Opens.mem_inf.mp hθw).1
    have h2 : ((θ ≫ Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N))) ≫ ι) w ∈
        wcSgD E N p.1 := h1
    have k1 : Limits.pullback.fst XΩ.hom (wcProjKStr Ω (wcLdnmM N)) w ∈ ιΩ ⁻¹ᵁ wcSgD Ω N p.1 :=
      (TopologicalSpace.Opens.mem_inf.mp hw).1
    have k2 : (Limits.pullback.fst XΩ.hom (wcProjKStr Ω (wcLdnmM N)) ≫ ιΩ) w ∈
        wcSgD Ω N p.1 := k1
    have k3 : ((Limits.pullback.fst XΩ.hom (wcProjKStr Ω (wcLdnmM N)) ≫ ιΩ) ≫
        wcLdpProjMap E Ω N) w ∈ wcSgD E N p.1 := hle k2
    rw [← G2 θ (Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N))) _ _ inf_le_left w hθw h1,
      Scheme.Hom.app_eq_appLE ι, ← G2 _ ι _ _ _ w h1 h2, C _ _ hcomp w _ h2 k3,
      G2 _ _ _ _ hle w k2 k3, hsecN p.1 G hle,
      G2 _ ιΩ _ (ιΩ ⁻¹ᵁ wcSgD Ω N p.1) le_rfl w k1 k2,
      G1 _ _ _ inf_le_left w hw k1, Scheme.Hom.app_eq_appLE ιΩ]
  have hmono : ∀ q : Fin (N + 1) × Fin (N + 1),
      wcLdpMapQ E Ω N (wcLdnmMono E N q) = wcLdnmMono Ω N q := by
    intro r
    apply Subtype.ext
    simp only [wcLdpMapQ, wcLdnmMono, wcLdpQuad, map_sum, map_mul, MvPolynomial.map_C,
      MvPolynomial.map_X]
    refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => ?_))
    split_ifs <;> simp
  refine ⟨fun p => ?_, fun p w hw hθw => ?_⟩
  · apply SetLike.ext
    intro w
    have e1 : ι (Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)) (θ w)) =
        wcLdpProjMap E Ω N (ιΩ (Limits.pullback.fst XΩ.hom (wcProjKStr Ω (wcLdnmM N)) w)) :=
      congrArg (fun φ => φ w) hcomp
    have e2 : Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)) (θ w) =
        wcLdpProjMap E Ω (wcLdnmM N) (Limits.pullback.snd XΩ.hom (wcProjKStr Ω (wcLdnmM N)) w) :=
      congrArg (fun φ => φ w) hθ2
    simp only [wcLdnmU, Scheme.Hom.mem_preimage, TopologicalSpace.Opens.mem_inf]
    rw [← hpreN p.1, ← hpreM p.2]
    simp only [Scheme.Hom.mem_preimage]
    rw [e1, e2]
  · simp only [wcLdnmPhi, map_sum, map_mul]
    refine Finset.sum_congr rfl (fun r _ => ?_)
    rw [hA p (wcLdnmIdx N r) w hw hθw, hB p (wcLdnmMono E N r) w hw hθw, hmono r]

theorem wc_smooth_reldim_of_comp_reldim {X Y S : Scheme.{u}} (g : X ⟶ Y) (h : Y ⟶ S) (n d : ℕ)
    [Smooth g] [SmoothOfRelativeDimension d h] [SmoothOfRelativeDimension n (g ≫ h)] :
    SmoothOfRelativeDimension (n - d) g :=
by
  classical
  have s1 : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C] [Algebra A B] [Algebra B C]
      [Algebra A C] [IsScalarTower A B C] [Nontrivial C] [Algebra.IsStandardSmooth A B]
      [Algebra.IsStandardSmooth B C],
      Module.rank C Ω[C⁄A] = Module.rank B Ω[B⁄A] + Module.rank C Ω[C⁄B] := by
    intro A B C _ _ _ _ _ _ _ _ _ _
    have : Nontrivial B := (algebraMap B C).domain_nontrivial
    have hex := KaehlerDifferential.exact_mapBaseChange_map A B C
    have hsurj := KaehlerDifferential.map_surjective A B C
    have hinj : Function.Injective (KaehlerDifferential.mapBaseChange A B C) := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨y, rfl⟩ := (Algebra.H1Cotangent.exact_δ_mapBaseChange A B C x).mp hx
      rw [Subsingleton.elim y 0, map_zero]
    obtain ⟨l, hl⟩ := Module.projective_lifting_property (KaehlerDifferential.map A B C C)
      LinearMap.id hsurj
    have h13 := (Function.Exact.split_tfae hex hinj hsurj).out 1 3
    obtain ⟨e, _, _⟩ := h13.mp ⟨l, hl⟩
    rw [e.rank_eq, rank_prod', Module.rank_baseChange, Cardinal.lift_id]
  have s2 : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C] [Nontrivial C]
      (φ : A →+* B) (χ : B →+* C), RingHom.IsStandardSmoothOfRelativeDimension d φ →
      χ.IsStandardSmooth → RingHom.IsStandardSmoothOfRelativeDimension n (χ.comp φ) →
      RingHom.IsStandardSmoothOfRelativeDimension (n - d) χ := by
    intro A B C _ _ _ _ φ χ hφ hχ hχφ
    letI := φ.toAlgebra
    letI := χ.toAlgebra
    letI := (χ.comp φ).toAlgebra
    haveI : IsScalarTower A B C := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Nontrivial B := χ.domain_nontrivial
    haveI : Algebra.IsStandardSmoothOfRelativeDimension d A B := hφ
    haveI : Algebra.IsStandardSmooth B C := hχ
    haveI : Algebra.IsStandardSmoothOfRelativeDimension n A C := hχφ
    haveI : Algebra.IsStandardSmooth A B :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth d
    have h1 := s1 (A := A) (B := B) (C := C)
    rw [Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential (R := A) (S := C) n,
      Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential (R := A) (S := B) d,
      ← Module.finrank_eq_rank] at h1
    have h2 : n = d + Module.finrank C Ω[C⁄B] := by exact_mod_cast h1
    show Algebra.IsStandardSmoothOfRelativeDimension (n - d) B C
    rw [Algebra.IsStandardSmoothOfRelativeDimension.iff_of_isStandardSmooth,
      ← Module.finrank_eq_rank]
    exact_mod_cast (by omega : Module.finrank C Ω[C⁄B] = n - d)
  have s3 : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C] (φ : A →+* B) (ψ : B →+* C),
      RingHom.IsStandardSmoothOfRelativeDimension d φ → ψ.Smooth →
      RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension n) (ψ.comp φ) →
      RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension (n - d)) ψ := by
    intro A B C _ _ _ φ ψ hφ hψ hn
    obtain ⟨s₁, hs₁, H₁⟩ := hψ.locally_isStandardSmooth
    apply RingHom.locally_ofLocalizationSpanTarget
      RingHom.isStandardSmoothOfRelativeDimension_respectsIso ψ s₁ hs₁
    rintro ⟨t, ht⟩
    have hn' : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension n)
        (((algebraMap C (Localization.Away t)).comp ψ).comp φ) := by
      have := RingHom.locally_stableUnderCompositionWithLocalizationAwayTarget
        (RingHom.isStandardSmoothOfRelativeDimension_stableUnderCompositionWithLocalizationAway n).2
        (Localization.Away t) t (ψ.comp φ) hn
      rwa [RingHom.comp_assoc]
    obtain ⟨s₂, hs₂, H₂⟩ := hn'
    refine ⟨{t' | t' ∈ s₂ ∧ ¬ IsNilpotent t'}, ?_, ?_⟩
    · by_contra hne
      obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ hne
      apply hM.ne_top
      rw [eq_top_iff, ← hs₂, Ideal.span_le]
      intro x hx
      by_cases hxn : IsNilpotent x
      · obtain ⟨k, hk⟩ := hxn
        exact hM.isPrime.mem_of_pow_mem k (hk ▸ M.zero_mem)
      · exact hle (Ideal.subset_span ⟨hx, hxn⟩)
    · rintro t' ⟨ht', hnil⟩
      haveI : Nontrivial (Localization.Away t') := OreLocalization.nontrivial_iff.mpr hnil
      have hχ : ((algebraMap _ (Localization.Away t')).comp
          ((algebraMap C (Localization.Away t)).comp ψ)).IsStandardSmooth :=
        RingHom.isStandardSmooth_stableUnderCompositionWithLocalizationAway.2 _ t' _ (H₁ t ht)
      have H := H₂ t' ht'
      rw [← RingHom.comp_assoc] at H
      exact s2 φ _ hφ hχ H
  rw [HasRingHomProperty.iff_exists_appLE (P := @SmoothOfRelativeDimension (n - d))
    (RingHom.locally_stableUnderCompositionWithLocalizationAwaySource
      (RingHom.isStandardSmoothOfRelativeDimension_stableUnderCompositionWithLocalizationAway
        (n - d)).1)]
  intro x
  obtain ⟨W, hW, V, hV, hxV, eV, hφ⟩ :=
    SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := d) (f := h) (g x)
  obtain ⟨U, hU, hxU, hUV⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (X.isBasis_affineOpens)) (show x ∈ g ⁻¹ᵁ V from hxV)
  have eWU : U ≤ (g ≫ h) ⁻¹ᵁ W := fun y hy => eV (hUV hy)
  have hn := HasRingHomProperty.appLE (@SmoothOfRelativeDimension n) (g ≫ h) inferInstance
    ⟨W, hW⟩ ⟨U, hU⟩ eWU
  rw [← Scheme.Hom.appLE_comp_appLE g h W V U eV hUV, CommRingCat.hom_comp] at hn
  exact ⟨⟨V, hV⟩, ⟨U, hU⟩, hxU, hUV, s3 _ _ hφ (Smooth.smooth_appLE g hV hU hUV) hn⟩

theorem wc_ldnm_di_ns_descent (E Ω : Type u) [Field E] [Field Ω] [Algebra E Ω] (N n : ℕ)
    (hn : 1 ≤ n) (X : Over (Spec (.of E))) [SmoothOfRelativeDimension n X.hom]
    (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι)
    (XΩ : Over (Spec (.of Ω))) [SmoothOfRelativeDimension n XΩ.hom]
    (ιΩ : XΩ.left ⟶ wcProjK Ω N) (hιΩ : IsClosedImmersion ιΩ)
    (hιΩX : ιΩ ≫ wcProjKStr Ω N = XΩ.hom)
    (θ : Limits.pullback XΩ.hom (wcProjKStr Ω (wcLdnmM N)) ⟶
      Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
    (hθ2 : θ ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)) =
      Limits.pullback.snd XΩ.hom (wcProjKStr Ω (wcLdnmM N)) ≫ wcLdpProjMap E Ω (wcLdnmM N))
    (hpre : ∀ p, θ ⁻¹ᵁ wcLdnmU E N X ι p = wcLdnmU Ω N XΩ ιΩ p)
    (hgerm : ∀ (p : Fin (N + 1) × Fin (wcLdnmM N + 1))
      (w : ↥(Limits.pullback XΩ.hom (wcProjKStr Ω (wcLdnmM N))))
      (hw : w ∈ wcLdnmU Ω N XΩ ιΩ p) (hθw : θ w ∈ wcLdnmU E N X ι p),
      (θ.stalkMap w).hom
        (((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.germ
          (wcLdnmU E N X ι p) (θ w) hθw).hom (wcLdnmPhi E N X ι p)) =
      ((Limits.pullback XΩ.hom (wcProjKStr Ω (wcLdnmM N))).presheaf.germ
        (wcLdnmU Ω N XΩ ιΩ p) w hw).hom (wcLdnmPhi Ω N XΩ ιΩ p))
    (Z : Scheme.{u}) (k : Z ⟶ Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
    (hZ : wcLdnmLocEq (Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
      (Fin (N + 1) × Fin (wcLdnmM N + 1)) (wcLdnmU E N X ι) (wcLdnmPhi E N X ι) Z k)
    (ZΩ : Scheme.{u}) (kΩ : ZΩ ⟶ Limits.pullback XΩ.hom (wcProjKStr Ω (wcLdnmM N)))
    (hZΩ : wcLdnmLocEq (Limits.pullback XΩ.hom (wcProjKStr Ω (wcLdnmM N)))
      (Fin (N + 1) × Fin (wcLdnmM N + 1)) (wcLdnmU Ω N XΩ ιΩ) (wcLdnmPhi Ω N XΩ ιΩ) ZΩ kΩ)
    (z : ZΩ) (x : Z) (hx : k x = θ (kΩ z)) (U : ZΩ.Opens) (hzU : z ∈ U)
    (hU : Smooth (U.ι ≫ kΩ ≫ Limits.pullback.snd XΩ.hom (wcProjKStr Ω (wcLdnmM N)))) :
    ∃ V : Z.Opens, x ∈ V ∧
      Smooth (V.ι ≫ k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) :=
by
  classical

  have conormal : ∀ (R P A : Type u) [CommRing R] [CommRing P] [CommRing A]
      [IsLocalRing P] [IsLocalRing A] [Algebra R P] [Algebra R A] [Algebra.FormallySmooth R P]
      [Algebra.FormallySmooth R A] [Module.Free P Ω[P⁄R]] [Module.Finite P Ω[P⁄R]]
      [Module.Free A Ω[A⁄R]] [Module.Finite A Ω[A⁄R]]
      (_ : Module.finrank A Ω[A⁄R] + 1 = Module.finrank P Ω[P⁄R])
      (ψ : P →ₐ[R] A) (_ : Function.Surjective ψ) (h : P)
      (_ : RingHom.ker ψ = Ideal.span {h}),
      ∃ δ : P →+ IsLocalRing.ResidueField A,
        (∀ a b, δ (a * b) = IsLocalRing.residue A (ψ a) * δ b + IsLocalRing.residue A (ψ b) * δ a) ∧
        (∀ c : R, δ (algebraMap R P c) = 0) ∧ δ h ≠ 0 := by
    intro R P A _ _ _ _ _ _ _ _ _ _ _ _ _ hrk ψ hψ h hker
    letI iPA : Algebra P A := ψ.toRingHom.toAlgebra
    haveI : IsScalarTower R P A := IsScalarTower.of_algebraMap_eq (fun c => (ψ.commutes c).symm)
    have hsurjA : Function.Surjective (algebraMap P A) := hψ
    have hIker : RingHom.ker (algebraMap P A) = Ideal.span {h} := hker
    have hhI : h ∈ RingHom.ker (algebraMap P A) := by
      rw [hIker]; exact Ideal.subset_span rfl
    obtain ⟨l, hl⟩ := (Algebra.FormallySmooth.iff_split_injection (R := R) (P := P) (A := A)
      hsurjA).mp inferInstance
    set hbar : (RingHom.ker (algebraMap P A)).Cotangent :=
      (RingHom.ker (algebraMap P A)).toCotangent ⟨h, hhI⟩ with hhbar
    set v : TensorProduct P A Ω[P⁄R] := (1 : A) ⊗ₜ[P] KaehlerDifferential.D R P h with hv
    have hkv : KaehlerDifferential.kerCotangentToTensor R P A hbar = v := by
      rw [hhbar, KaehlerDifferential.kerCotangentToTensor_toCotangent]
    have hlv : l v = hbar := by
      rw [← hkv]
      exact LinearMap.congr_fun hl hbar
    have hgen : ∀ z : (RingHom.ker (algebraMap P A)).Cotangent, ∃ c : P, z = c • hbar := by
      intro z
      obtain ⟨⟨x, hx⟩, rfl⟩ := Ideal.toCotangent_surjective _ z
      have hx' : x ∈ Ideal.span {h} := hIker ▸ hx
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hx'
      refine ⟨c, ?_⟩
      have e : (⟨c * h, hx⟩ : RingHom.ker (algebraMap P A)) = c • ⟨h, hhI⟩ := Subtype.ext rfl
      rw [e, map_smul]
    have hvnot : v ∉ (IsLocalRing.maximalIdeal A) •
        (⊤ : Submodule A (TensorProduct P A Ω[P⁄R])) := by
      intro hvm
      have hmem : hbar ∈ (IsLocalRing.maximalIdeal P) •
          (⊤ : Submodule P (RingHom.ker (algebraMap P A)).Cotangent) := by
        rw [← hlv]
        refine Submodule.smul_induction_on (p := fun t => l t ∈ (IsLocalRing.maximalIdeal P) •
          (⊤ : Submodule P (RingHom.ker (algebraMap P A)).Cotangent)) hvm ?_ ?_
        · intro a ha t _
          obtain ⟨p, rfl⟩ := hψ a
          have hp : p ∈ IsLocalRing.maximalIdeal P := by
            rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
            intro hu
            exact (IsLocalRing.mem_maximalIdeal _).mp ha (hu.map ψ)
          have e : (ψ p) • t = p • t := algebraMap_smul A p t
          show l ((ψ p) • t) ∈ _
          rw [e, map_smul]
          exact Submodule.smul_mem_smul hp Submodule.mem_top
        · intro x y hx hy
          show l (x + y) ∈ _
          rw [map_add]
          exact Submodule.add_mem _ hx hy
      have htop : (⊤ : Submodule P (RingHom.ker (algebraMap P A)).Cotangent) ≤
          (IsLocalRing.maximalIdeal P) • ⊤ := by
        intro z _
        obtain ⟨c, rfl⟩ := hgen z
        exact Submodule.smul_mem _ c hmem
      have hfg : (⊤ : Submodule P (RingHom.ker (algebraMap P A)).Cotangent).FG := by
        refine ⟨{hbar}, ?_⟩
        rw [eq_top_iff]
        intro z _
        obtain ⟨c, rfl⟩ := hgen z
        exact Submodule.smul_mem _ c (Submodule.subset_span (by simp))
      have hbot := Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (IsLocalRing.maximalIdeal P) ⊤
        hfg htop (IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge
      have hinj : Function.Injective (KaehlerDifferential.mapBaseChange R P A) := by
        refine (injective_iff_map_eq_zero (KaehlerDifferential.mapBaseChange R P A)).mpr ?_
        intro t ht
        obtain ⟨z, rfl⟩ :=
          (KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange R P A hsurjA t).mp ht
        have hz : z = 0 := by
          have hz' : z ∈ (⊥ : Submodule P (RingHom.ker (algebraMap P A)).Cotangent) :=
            hbot ▸ Submodule.mem_top
          exact (Submodule.mem_bot P).mp hz'
        rw [hz, map_zero]
      have hsurj := KaehlerDifferential.mapBaseChange_surjective R P A hsurjA
      have e1 := LinearEquiv.finrank_eq (LinearEquiv.ofBijective
        (KaehlerDifferential.mapBaseChange R P A) ⟨hinj, hsurj⟩)
      have e2 : Module.finrank A (TensorProduct P A Ω[P⁄R]) = Module.finrank P Ω[P⁄R] :=
        Module.finrank_baseChange
      omega
    have hmkv : (Submodule.Quotient.mk v : TensorProduct P A Ω[P⁄R] ⧸ ((IsLocalRing.maximalIdeal A) •
        (⊤ : Submodule A (TensorProduct P A Ω[P⁄R])))) ≠ 0 := by
      rw [Ne, Submodule.Quotient.mk_eq_zero]
      exact hvnot
    letI : Field (A ⧸ IsLocalRing.maximalIdeal A) := Ideal.Quotient.field _
    haveI : Module.Free (A ⧸ IsLocalRing.maximalIdeal A)
        (TensorProduct P A Ω[P⁄R] ⧸ ((IsLocalRing.maximalIdeal A) •
          (⊤ : Submodule A (TensorProduct P A Ω[P⁄R])))) := Module.Free.of_divisionRing _ _
    obtain ⟨φ, hφ⟩ : ∃ φ : Module.Dual (A ⧸ IsLocalRing.maximalIdeal A)
        (TensorProduct P A Ω[P⁄R] ⧸ ((IsLocalRing.maximalIdeal A) •
          (⊤ : Submodule A (TensorProduct P A Ω[P⁄R])))),
        φ (Submodule.Quotient.mk v) ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      exact hmkv ((Module.forall_dual_apply_eq_zero_iff (A ⧸ IsLocalRing.maximalIdeal A) _).mp hcon)
    have hkey : ∀ (a : P) (t : Ω[P⁄R]),
        (Submodule.Quotient.mk ((1 : A) ⊗ₜ[P] (a • t)) : TensorProduct P A Ω[P⁄R] ⧸
          ((IsLocalRing.maximalIdeal A) • (⊤ : Submodule A (TensorProduct P A Ω[P⁄R])))) =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal A) (ψ a) •
          Submodule.Quotient.mk ((1 : A) ⊗ₜ[P] t) := by
      intro a t
      rw [TensorProduct.tmul_smul, ← algebraMap_smul A a ((1 : A) ⊗ₜ[P] t)]
      exact (Module.Quotient.mk_smul_mk (TensorProduct P A Ω[P⁄R]) (IsLocalRing.maximalIdeal A)
        (algebraMap P A a) _).symm
    let δ : P →+ IsLocalRing.ResidueField A :=
      AddMonoidHom.mk' (fun a => (φ (Submodule.Quotient.mk
          ((1 : A) ⊗ₜ[P] KaehlerDifferential.D R P a)) : A ⧸ IsLocalRing.maximalIdeal A))
        (fun a b => by
          rw [map_add, TensorProduct.tmul_add, Submodule.Quotient.mk_add, map_add]
          rfl)
    refine ⟨δ, ?_, ?_, ?_⟩
    · intro a b
      show φ (Submodule.Quotient.mk ((1 : A) ⊗ₜ[P] KaehlerDifferential.D R P (a * b))) =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal A) (ψ a) *
          φ (Submodule.Quotient.mk ((1 : A) ⊗ₜ[P] KaehlerDifferential.D R P b)) +
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal A) (ψ b) *
          φ (Submodule.Quotient.mk ((1 : A) ⊗ₜ[P] KaehlerDifferential.D R P a))
      rw [Derivation.leibniz, TensorProduct.tmul_add, Submodule.Quotient.mk_add, hkey, hkey,
        map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
    · intro c
      show φ (Submodule.Quotient.mk
        ((1 : A) ⊗ₜ[P] KaehlerDifferential.D R P (algebraMap R P c))) = 0
      rw [Derivation.map_algebraMap, TensorProduct.tmul_zero, Submodule.Quotient.mk_zero, map_zero]
    · exact hφ

  have descent : ∀ {R S L : Type u} [CommRing R] [IsLocalRing R] [CommRing S] [Field L]
      (σ : S →+* R) (j : IsLocalRing.ResidueField R →+* L) (δ : R →+ L),
      (∀ a c, δ (a * c) = j (IsLocalRing.residue R a) * δ c + j (IsLocalRing.residue R c) * δ a) →
      (∀ c, δ (σ c) = 0) → ∀ Φ : R, δ Φ ≠ 0 →
      ∃ δ₁ : R →+ IsLocalRing.ResidueField R,
        (∀ a c, δ₁ (a * c) = IsLocalRing.residue R a * δ₁ c + IsLocalRing.residue R c * δ₁ a) ∧
        (∀ c, δ₁ (σ c) = 0) ∧ δ₁ Φ ≠ 0 := by
    intro R S L _ _ _ _ σ j δ hL hS Φ hΦ
    letI : Module (IsLocalRing.ResidueField R) L := Module.compHom L j
    obtain ⟨φ, hφ⟩ : ∃ φ : Module.Dual (IsLocalRing.ResidueField R) L, φ (δ Φ) ≠ 0 := by
      by_contra hcon
      push_neg at hcon
