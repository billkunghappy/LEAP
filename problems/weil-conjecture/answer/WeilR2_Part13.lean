  haveI : AlgebraicGeometry.IsReduced X.left := by
    haveI : ∀ x : X.left, _root_.IsReduced (X.left.presheaf.stalk x) := by
      intro x
      have hx : ι x ∈ (⨆ j : Fin (N + 1), Proj.basicOpen
