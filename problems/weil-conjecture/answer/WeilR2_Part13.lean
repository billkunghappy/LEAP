theorem wc_ldnm_dia_closed_crit (K : Type u) [Field K] [IsAlgClosed K] (N n : ℕ) (hn : 1 ≤ n)
    (X : Over (Spec (.of K))) [SmoothOfRelativeDimension n X.hom]
    (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr K N = X.hom)
    (Z : Scheme.{u}) (k : Z ⟶ Limits.pullback X.hom (wcProjKStr K (wcLdnmM N)))
    (hZ : wcLdnmLocEq (Limits.pullback X.hom (wcProjKStr K (wcLdnmM N)))
      (Fin (N + 1) × Fin (wcLdnmM N + 1)) (wcLdnmU K N X ι) (wcLdnmPhi K N X ι) Z k)
    (w : ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N))))
    (hw : IsClosed ({w} : Set ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N)))))
    (r : Fin (wcLdnmM N + 1)) (α : Fin (wcLdnmM N + 1) → K)
    (hα : wcLdnmDiaCoord K (wcLdnmM N)
      (Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N)) w) r α) :
    w ∈ k '' wcLdnmNS (k ≫ Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N))) ↔
      wcLdnmDiaSing K N ι (fun q => α (wcLdnmIdx N q))
        (Limits.pullback.fst X.hom (wcProjKStr K (wcLdnmM N)) w) :=
by
  classical



  have appLE_germ : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (V : B.Opens) (U : A.Opens)
      (e : U ≤ f ⁻¹ᵁ V) (a : A) (ha : a ∈ U) (t : Γ(B, V)),
      (A.presheaf.germ U a ha).hom ((f.appLE V U e).hom t) =
        (f.stalkMap a).hom ((B.presheaf.germ V (f a) (e ha)).hom t) := by
    intro A B f V U e a ha t
    have h1 := Scheme.Hom.germ_stalkMap_apply f V a (e ha) t
    refine Eq.trans ?_ h1.symm
    have h2 := TopCat.Presheaf.germ_res_apply A.presheaf (homOfLE e) a ha ((f.app V).hom t)
    refine Eq.trans ?_ h2
    rfl
  have const_nat : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (s : B ⟶ Spec (.of K)) (a : A) (c : K),
      (f.stalkMap a).hom (wcLdpConst K s (f a) c) = wcLdpConst K (f ≫ s) a c := by
    intro A B f s a c
    have h1 := Scheme.Hom.germ_stalkMap_apply f ⊤ a trivial
      (s.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom c))
    refine h1.trans ?_
    simp only [wcLdpConst, RingHom.comp_apply]
    rw [Scheme.Hom.comp_appTop]
    rfl
  have loc_iff : ∀ {O R : Type u} [CommRing O] [IsLocalRing O] [CommRing R] [IsLocalRing R]
      (F : O →+* R) [IsLocalHom F] (g : O),
      F g ∈ IsLocalRing.maximalIdeal R ↔ g ∈ IsLocalRing.maximalIdeal O := by
    intro O R _ _ _ _ F _ g
    constructor
    · intro h
      by_contra hg
      exact (IsLocalRing.notMem_maximalIdeal.mpr
        ((IsLocalRing.notMem_maximalIdeal.mp hg).map F)) h
    · intro h
      exact map_nonunit F g h
  have loc_sq : ∀ {O R : Type u} [CommRing O] [IsLocalRing O] [CommRing R] [IsLocalRing R]
      (F : O →+* R) [IsLocalHom F] (g : O), g ∈ IsLocalRing.maximalIdeal O ^ 2 →
      F g ∈ IsLocalRing.maximalIdeal R ^ 2 := by
    intro O R _ _ _ _ F _ g hg
    rw [pow_two] at hg ⊢
    refine Submodule.mul_induction_on hg ?_ ?_
    · intro a ha b hb
      rw [map_mul]
      exact Ideal.mul_mem_mul (map_nonunit F a ha) (map_nonunit F b hb)
    · intro a b ha hb
      rw [map_add]
      exact Ideal.add_mem _ ha hb
  have der_sq : ∀ {R A : Type u} [CommRing R] [IsLocalRing R] [CommRing A] [IsLocalRing A]
      (ψ : R →+* A) [IsLocalHom ψ] (δ : R →+ IsLocalRing.ResidueField A),
      (∀ x y, δ (x * y) = IsLocalRing.residue A (ψ x) * δ y +
        IsLocalRing.residue A (ψ y) * δ x) →
      ∀ y, y ∈ IsLocalRing.maximalIdeal R ^ 2 → δ y = 0 := by
    intro R A _ _ _ _ ψ _ δ hL y hy
    rw [pow_two] at hy
    refine Submodule.mul_induction_on hy ?_ ?_
    · intro a ha b hb
      rw [hL, (IsLocalRing.residue_eq_zero_iff _).mpr (map_nonunit ψ a ha),
        (IsLocalRing.residue_eq_zero_iff _).mpr (map_nonunit ψ b hb), zero_mul, zero_mul,
        add_zero]
    · intro a b ha hb
      rw [map_add, ha, hb, add_zero]
  have cot_deriv : ∀ (O : Type u) [CommRing O] [IsLocalRing O]
      (κ : K →+* O), (∀ r : O, ∃ c : K, r - κ c ∈ IsLocalRing.maximalIdeal O) →
      ∀ (g : O), g ∈ IsLocalRing.maximalIdeal O → g ∉ IsLocalRing.maximalIdeal O ^ 2 →
      ∃ δ : O →+ IsLocalRing.ResidueField O,
        (∀ a b, δ (a * b) = IsLocalRing.residue O a * δ b + IsLocalRing.residue O b * δ a) ∧
        (∀ c, δ (κ c) = 0) ∧ δ g ≠ 0 := by
    intro O _ _ κ hres g hg hg2
    have huniq : ∀ c : K, κ c ∈ IsLocalRing.maximalIdeal O → c = 0 := by
      intro c hc
      by_contra h0
      exact IsLocalRing.notMem_maximalIdeal.mpr ((Ne.isUnit h0).map κ) hc
    choose cst hcst using hres
    have cst_add : ∀ a b, cst (a + b) = cst a + cst b := by
      intro a b
      have h : κ (cst a + cst b - cst (a + b)) ∈ IsLocalRing.maximalIdeal O := by
        have e : κ (cst a + cst b - cst (a + b)) =
            (a + b - κ (cst (a + b))) - (a - κ (cst a)) - (b - κ (cst b)) := by
          rw [map_sub, map_add]; ring
        rw [e]
        exact Ideal.sub_mem _ (Ideal.sub_mem _ (hcst _) (hcst _)) (hcst _)
      have := huniq _ h
      rw [sub_eq_zero] at this
      exact this.symm
    have cst_mul : ∀ a b, cst (a * b) = cst a * cst b := by
      intro a b
      have h : κ (cst a * cst b - cst (a * b)) ∈ IsLocalRing.maximalIdeal O := by
        have e : κ (cst a * cst b - cst (a * b)) =
            (a * b - κ (cst (a * b))) - ((a - κ (cst a)) * b + κ (cst a) * (b - κ (cst b))) := by
          rw [map_sub, map_mul]; ring
        rw [e]
        exact Ideal.sub_mem _ (hcst _) (Ideal.add_mem _ (Ideal.mul_mem_right _ _ (hcst _))
          (Ideal.mul_mem_left _ _ (hcst _)))
      have := huniq _ h
      rw [sub_eq_zero] at this
      exact this.symm
    have cst_κ : ∀ c, cst (κ c) = c := by
      intro c
      have h : κ (c - cst (κ c)) ∈ IsLocalRing.maximalIdeal O := by
        rw [map_sub]; exact hcst _
      have := huniq _ h
      rw [sub_eq_zero] at this
      exact this.symm
    set m := IsLocalRing.maximalIdeal O with hm
    let T : O → IsLocalRing.CotangentSpace O := fun f => m.toCotangent ⟨f - κ (cst f), hcst f⟩
    have hTadd : ∀ a b, T (a + b) = T a + T b := by
      intro a b
      have e : (⟨a + b - κ (cst (a + b)), hcst (a + b)⟩ : m) =
          ⟨a - κ (cst a), hcst a⟩ + ⟨b - κ (cst b), hcst b⟩ := by
        apply Subtype.ext
        simp only [Submodule.coe_add, cst_add, map_add]
        ring
      show m.toCotangent _ = m.toCotangent _ + m.toCotangent _
      rw [e, map_add]
    have hres_eq : ∀ a, IsLocalRing.residue O (κ (cst a)) = IsLocalRing.residue O a := by
      intro a
      have h := (IsLocalRing.residue_eq_zero_iff _).mpr (hcst a)
      rw [map_sub, sub_eq_zero] at h
      exact h.symm
    have hsmul : ∀ (r : O) (v : IsLocalRing.CotangentSpace O),
        r • v = IsLocalRing.residue O r • v := fun r v => (algebraMap_smul _ r v).symm
    have hTmul : ∀ a b, T (a * b) =
        IsLocalRing.residue O a • T b + IsLocalRing.residue O b • T a := by
      intro a b
      have e : (⟨a * b - κ (cst (a * b)), hcst (a * b)⟩ : m) =
          κ (cst a) • ⟨b - κ (cst b), hcst b⟩ + κ (cst b) • ⟨a - κ (cst a), hcst a⟩ +
            ⟨(a - κ (cst a)) * (b - κ (cst b)), Ideal.mul_mem_left _ _ (hcst b)⟩ := by
        apply Subtype.ext
        simp only [Submodule.coe_add, Submodule.coe_smul, smul_eq_mul, cst_mul, map_mul]
        ring
      have h0 : m.toCotangent ⟨(a - κ (cst a)) * (b - κ (cst b)),
          Ideal.mul_mem_left _ _ (hcst b)⟩ = 0 := by
        rw [Ideal.toCotangent_eq_zero, pow_two]
        exact Ideal.mul_mem_mul (hcst a) (hcst b)
      show m.toCotangent _ = _
      rw [e, map_add, map_add, h0, add_zero, map_smul, map_smul, hsmul, hsmul, hres_eq, hres_eq]
    set t := m.toCotangent ⟨g, hg⟩ with ht
    have hTg : T g = t := by
      have hc : cst g = 0 := by
        apply huniq
        have : κ (cst g) = g - (g - κ (cst g)) := by ring
        rw [this]
        exact Ideal.sub_mem _ hg (hcst g)
      show m.toCotangent _ = m.toCotangent _
      congr 1
      apply Subtype.ext
      simp [hc]
    have ht0 : t ≠ 0 := by
      rw [ht, Ne, Ideal.toCotangent_eq_zero]
      exact hg2
    obtain ⟨φ, hφ⟩ : ∃ φ : Module.Dual (IsLocalRing.ResidueField O)
        (IsLocalRing.CotangentSpace O), φ t ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      exact ht0 ((Module.forall_dual_apply_eq_zero_iff (IsLocalRing.ResidueField O) t).mp hcon)
    refine ⟨AddMonoidHom.mk' (fun f => φ (T f)) (fun a b => by rw [hTadd, map_add]),
      ?_, ?_, ?_⟩
    · intro a b
      show φ (T (a * b)) = _ * φ (T b) + _ * φ (T a)
      rw [hTmul, map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
    · intro c
      show φ (T (κ c)) = 0
      have e : T (κ c) = 0 := by
        show m.toCotangent _ = 0
        have : (⟨κ c - κ (cst (κ c)), hcst (κ c)⟩ : m) = 0 := by
          apply Subtype.ext
          simp [cst_κ]
        rw [this, map_zero]
      rw [e, map_zero]
    · show φ (T g) ≠ 0
      rw [hTg]
      exact hφ

  have conormal : ∀ (R P A : Type u) [CommRing R] [CommRing P] [CommRing A]
      [IsLocalRing P] [IsLocalRing A] [Algebra R P] [Algebra R A] [Algebra.FormallySmooth R P]
      [Algebra.FormallySmooth R A] [Module.Free P Ω[P⁄R]] [Module.Finite P Ω[P⁄R]]
      [Module.Free A Ω[A⁄R]] [Module.Finite A Ω[A⁄R]]
      (_ : Module.finrank A Ω[A⁄R] + 1 = Module.finrank P Ω[P⁄R])
      (ψ : P →ₐ[R] A) (_ : Function.Surjective ψ) (h : P)
      (_ : RingHom.ker ψ = Ideal.span {h}),
      ∃ δ : P →+ IsLocalRing.ResidueField A,
        (∀ a b, δ (a * b) = IsLocalRing.residue A (ψ a) * δ b + IsLocalRing.residue A (ψ b) * δ a) ∧
        (∀ c : R, δ (algebraMap R P c) = 0) ∧ δ h ≠ 0 := by
    intro R P A _ _ _ _ _ _ _ _ _ _ _ _ _ hrk ψ hψ h hker
    letI iPA : Algebra P A := ψ.toRingHom.toAlgebra
    haveI : IsScalarTower R P A := IsScalarTower.of_algebraMap_eq (fun c => (ψ.commutes c).symm)
    have hsurjA : Function.Surjective (algebraMap P A) := hψ
    have hIker : RingHom.ker (algebraMap P A) = Ideal.span {h} := hker
    have hhI : h ∈ RingHom.ker (algebraMap P A) := by
      rw [hIker]; exact Ideal.subset_span rfl
    obtain ⟨l, hl⟩ := (Algebra.FormallySmooth.iff_split_injection (R := R) (P := P) (A := A)
      hsurjA).mp inferInstance
    set hbar : (RingHom.ker (algebraMap P A)).Cotangent :=
      (RingHom.ker (algebraMap P A)).toCotangent ⟨h, hhI⟩ with hhbar
    set v : TensorProduct P A Ω[P⁄R] := (1 : A) ⊗ₜ[P] KaehlerDifferential.D R P h with hv
    have hkv : KaehlerDifferential.kerCotangentToTensor R P A hbar = v := by
      rw [hhbar, KaehlerDifferential.kerCotangentToTensor_toCotangent]
    have hlv : l v = hbar := by
