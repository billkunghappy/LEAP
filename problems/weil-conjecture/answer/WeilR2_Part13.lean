  refine ⟨ι₀, σ₀, inferInstance, inferInstance, inferInstance, mp, f, val, g₀, q, hmp, hfval,
    hcert, ?_, hq⟩
  intro g hg
  apply hker'
  rw [← aeval_map]
  have hfe : (fun k => Φ (q k)) = e := funext hq
  rw [hfe]
  exact he g hg

theorem wc_std_etale_cert_relation_descent : ∀ (A C : Type u) [CommRing A] [CommRing C] (γ : A →+* C) {ι₀ σ₀ : Type} [Fintype σ₀] [DecidableEq σ₀] (mp : σ₀ → ι₀) (f : σ₀ → MvPolynomial ι₀ (Polynomial A)) (g₀ : MvPolynomial ι₀ (Polynomial A)), g₀ * (Matrix.of fun a b => MvPolynomial.pderiv (mp a) (f b)).det - 1 ∈ Ideal.span (Set.range f) → ∀ (κ : Type u) [Fintype κ] (G : Finset (MvPolynomial κ ℤ)) (q : κ → MvPolynomial ι₀ (Polynomial C)), (∀ g ∈ G, MvPolynomial.aeval q g ∈ Ideal.span (Set.range fun j => MvPolynomial.map (Polynomial.mapRingHom γ) (f j))) → ∃ (SA : Finset A) (SC : Finset C), ∀ (A0 : Subring A) (C0 : Subring C) (hAC : ∀ a ∈ A0, γ a ∈ C0), (∀ a ∈ SA, a ∈ A0) → (∀ c ∈ SC, c ∈ C0) → ∃ (f0 : σ₀ → MvPolynomial ι₀ (Polynomial ↥A0)) (g0 : MvPolynomial ι₀ (Polynomial ↥A0)) (q0 : κ → MvPolynomial ι₀ (Polynomial ↥C0)), (∀ j, MvPolynomial.map (Polynomial.mapRingHom A0.subtype) (f0 j) = f j) ∧ (∀ k, MvPolynomial.map (Polynomial.mapRingHom C0.subtype) (q0 k) = q k) ∧ g0 * (Matrix.of fun a b => MvPolynomial.pderiv (mp a) (f0 b)).det - 1 ∈ Ideal.span (Set.range f0) ∧ ∀ g ∈ G, MvPolynomial.aeval q0 g ∈ Ideal.span (Set.range fun j => MvPolynomial.map (Polynomial.mapRingHom ((γ.comp A0.subtype).codRestrict C0 (fun a => hAC a a.2))) (f0 j)) :=
by
  classical

  have s1 : ∀ (R : Type u) [CommRing R] {ι : Type} (P : MvPolynomial ι (Polynomial R)),
      ∃ T : Finset R, ∀ S : Subring R, (∀ a ∈ T, a ∈ S) →
        ∃ P0 : MvPolynomial ι (Polynomial ↥S),
          MvPolynomial.map (Polynomial.mapRingHom S.subtype) P0 = P := by
    intro R _ ι P
    refine ⟨P.support.biUnion (fun m => (P.coeff m).coeffs), fun S hS => ?_⟩
    have hP : P ∈ Set.range (MvPolynomial.map (σ := ι) (Polynomial.mapRingHom S.subtype)) := by
      rw [MvPolynomial.mem_range_map_iff_coeffs_subset]
      intro c hc
      obtain ⟨m, hm, rfl⟩ := MvPolynomial.mem_coeffs_iff.mp hc
      rw [Polynomial.coe_mapRingHom, ← Polynomial.lifts_iff_set_range,
        Polynomial.lifts_iff_coeff_lifts]
      intro n
      by_cases h0 : (P.coeff m).coeff n = 0
      · exact ⟨0, by rw [h0, map_zero]⟩
      · have hmem : (P.coeff m).coeff n ∈ S :=
          hS _ (Finset.mem_biUnion.mpr ⟨m, hm, Polynomial.coeff_mem_coeffs h0⟩)
        exact ⟨⟨_, hmem⟩, rfl⟩
    exact hP

  have inj : ∀ (R : Type u) [CommRing R] (S : Subring R) {ι : Type},
      Function.Injective (MvPolynomial.map (σ := ι) (Polynomial.mapRingHom S.subtype)) := by
    intro R _ S ι
    apply MvPolynomial.map_injective
    rw [Polynomial.coe_mapRingHom]
    exact Polynomial.map_injective _ Subtype.val_injective
  intro A C _ _ γ ι₀ σ₀ _ _ mp f g₀ hcert κ _ G q hq
  obtain ⟨v, hv⟩ := Ideal.mem_span_range_iff_exists_fun.mp hcert
  choose u hu using fun g : G => Ideal.mem_span_range_iff_exists_fun.mp (hq g.1 g.2)
  choose Tf hTf using fun j => s1 A (f j)
  obtain ⟨Tg, hTg⟩ := s1 A g₀
  choose Tv hTv using fun j => s1 A (v j)
  choose Tq hTq using fun k => s1 C (q k)
  choose Tu hTu using fun (g : G) j => s1 C (u g j)
  refine ⟨(Finset.univ.biUnion Tf) ∪ Tg ∪ (Finset.univ.biUnion Tv),
    (Finset.univ.biUnion Tq) ∪ (Finset.univ.biUnion fun g : G => Finset.univ.biUnion (Tu g)), ?_⟩
  intro A0 C0 hAC hSA hSC
  choose f0 hf0 using fun j => hTf j A0 (fun a ha => hSA a
    (Finset.mem_union_left _ (Finset.mem_union_left _
      (Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ _, ha⟩))))
  obtain ⟨g0, hg0⟩ := hTg A0 (fun a ha => hSA a
    (Finset.mem_union_left _ (Finset.mem_union_right _ ha)))
  choose v0 hv0 using fun j => hTv j A0 (fun a ha => hSA a
    (Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ _, ha⟩)))
  choose q0 hq0 using fun k => hTq k C0 (fun c hc => hSC c
    (Finset.mem_union_left _ (Finset.mem_biUnion.mpr ⟨k, Finset.mem_univ _, hc⟩)))
  choose u0 hu0 using fun (g : G) j => hTu g j C0 (fun c hc => hSC c
    (Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨g, Finset.mem_univ _,
      Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ _, hc⟩⟩)))
  have hjac : MvPolynomial.map (Polynomial.mapRingHom A0.subtype)
      (Matrix.of fun a b => MvPolynomial.pderiv (mp a) (f0 b)).det =
      (Matrix.of fun a b => MvPolynomial.pderiv (mp a) (f b)).det := by
    have hd := RingHom.map_det
      (MvPolynomial.map (σ := ι₀) (Polynomial.mapRingHom A0.subtype) :
        MvPolynomial ι₀ (Polynomial ↥A0) →+* MvPolynomial ι₀ (Polynomial A))
      (Matrix.of fun a b => MvPolynomial.pderiv (mp a) (f0 b))
    refine hd.trans ?_
    rw [RingHom.mapMatrix_apply]
    congr 1
    refine Matrix.ext fun a b => ?_
    simp only [Matrix.map_apply, Matrix.of_apply]
    rw [← MvPolynomial.pderiv_map, hf0]
  have hrel : ∀ γ0 : ↥A0 →+* ↥C0, C0.subtype.comp γ0 = γ.comp A0.subtype →
      ∀ g ∈ G, MvPolynomial.aeval q0 g ∈ Ideal.span (Set.range fun j =>
        MvPolynomial.map (Polynomial.mapRingHom γ0) (f0 j)) := by
    intro γ0 hγ0 g hg
    rw [Ideal.mem_span_range_iff_exists_fun]
    refine ⟨u0 ⟨g, hg⟩, inj C C0 ?_⟩
    have e : MvPolynomial.map (Polynomial.mapRingHom C0.subtype) (MvPolynomial.aeval q0 g) =
        MvPolynomial.aeval q g := by
      clear hu hSC hTu hTq hq hg
      induction g using MvPolynomial.induction_on with
      | C a => simp
      | add p r hp hr => rw [map_add, map_add, map_add, hp, hr]
      | mul_X p i hp => rw [map_mul, map_mul, map_mul, hp, MvPolynomial.aeval_X,
          MvPolynomial.aeval_X, hq0]
    rw [map_sum, e, ← hu ⟨g, hg⟩]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_mul, hu0, ← hf0 j, MvPolynomial.map_map, MvPolynomial.map_map,
      Polynomial.mapRingHom_comp, Polynomial.mapRingHom_comp, hγ0]
  refine ⟨f0, g0, q0, hf0, hq0, ?_, hrel _ (RingHom.ext fun _ => rfl)⟩
  rw [Ideal.mem_span_range_iff_exists_fun]
  refine ⟨v0, inj A A0 ?_⟩
  rw [map_sum, map_sub, map_mul, map_one, hjac, hg0, ← hv]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [map_mul, hv0, hf0]

theorem wc_descended_std_etale_stage_build : ∀ (A C D0 : Type u) [CommRing A] [CommRing C] [CommRing D0] (p0 : Polynomial A →+* D0) (γ : A →+* C) (A0 : Subring A) (C0 : Subring C) (hAC : ∀ a ∈ A0, γ a ∈ C0) {ι₀ σ₀ : Type} [Fintype ι₀] [Fintype σ₀] [DecidableEq σ₀] (mp : σ₀ → ι₀), Function.Bijective mp → ∀ (val : ι₀ → D0) (f : σ₀ → MvPolynomial ι₀ (Polynomial A)), (∀ j, MvPolynomial.eval₂Hom p0 val (f j) = 0) → ∀ (f0 : σ₀ → MvPolynomial ι₀ (Polynomial ↥A0)) (g0 : MvPolynomial ι₀ (Polynomial ↥A0)), (∀ j, MvPolynomial.map (Polynomial.mapRingHom A0.subtype) (f0 j) = f j) → g0 * (Matrix.of fun a b => MvPolynomial.pderiv (mp a) (f0 b)).det - 1 ∈ Ideal.span (Set.range f0) → ∀ (κ : Type u) [Fintype κ] (G : Finset (MvPolynomial κ ℤ)) (q0 : κ → MvPolynomial ι₀ (Polynomial ↥C0)), (∀ g ∈ G, MvPolynomial.aeval q0 g ∈ Ideal.span (Set.range fun j => MvPolynomial.map (Polynomial.mapRingHom ((γ.comp A0.subtype).codRestrict C0 (fun a => hAC a a.2))) (f0 j))) → letI : Algebra A D0 := (p0.comp (algebraMap A (Polynomial A))).toAlgebra; letI : Algebra A C := γ.toAlgebra; ∃ (E : Type u) (_ : CommRing E) (pE : Polynomial ↥A0 →+* E) (ε0 : E →+* D0), pE.Etale ∧ ε0.comp pE = p0.comp (Polynomial.mapRingHom A0.subtype) ∧ (letI : Algebra ↥A0 E := (pE.comp (algebraMap ↥A0 (Polynomial ↥A0))).toAlgebra; letI : Algebra ↥A0 ↥C0 := ((γ.comp A0.subtype).codRestrict C0 (fun a => hAC a a.2)).toAlgebra; ∃ t : κ → TensorProduct ↥A0 E ↥C0, (∀ g ∈ G, MvPolynomial.aeval t g = 0) ∧ ∀ (M : Type u) [AddCommGroup M] (Λ : TensorProduct ↥A0 E ↥C0 →+ M) (Λ0 : TensorProduct A D0 C →+ M), (∀ (x : E) (z : ↥C0), Λ (x ⊗ₜ[↥A0] z) = Λ0 (ε0 x ⊗ₜ[A] (z : C))) → ∀ k, Λ (t k) = Λ0 (MvPolynomial.eval₂Hom (Polynomial.eval₂RingHom (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A D0 C).toRingHom (p0 Polynomial.X ⊗ₜ[A] (1 : C))) (fun i => val i ⊗ₜ[A] (1 : C)) (MvPolynomial.map (Polynomial.mapRingHom C0.subtype) (q0 k)))) :=
by
  intro A C D0 _ _ _ p0 γ A0 C0 hAC ι₀ σ₀ _ _ _ mp hmp val f hfval f0 g0 hf0 hcert κ _ G q0 hrel0
  letI instAD : Algebra A D0 := (p0.comp (algebraMap A (Polynomial A))).toAlgebra
  letI instAC : Algebra A C := γ.toAlgebra

  have main : ∀ (E : Type u) [CommRing E] (pE : Polynomial ↥A0 →+* E) (ε0 : E →+* D0)
      (mkE : MvPolynomial ι₀ (Polynomial ↥A0) →+* E),
      (∀ a, pE a = mkE (MvPolynomial.C a)) → (∀ j, mkE (f0 j) = 0) →
      ε0.comp pE = p0.comp (Polynomial.mapRingHom A0.subtype) →
      (∀ i, ε0 (mkE (MvPolynomial.X i)) = val i) →
      (letI : Algebra ↥A0 E := (pE.comp (algebraMap ↥A0 (Polynomial ↥A0))).toAlgebra;
        letI : Algebra ↥A0 ↥C0 :=
          ((γ.comp A0.subtype).codRestrict C0 (fun a => hAC a a.2)).toAlgebra;
        ∃ t : κ → TensorProduct ↥A0 E ↥C0, (∀ g ∈ G, MvPolynomial.aeval t g = 0) ∧
          ∀ (M : Type u) [AddCommGroup M] (Λ : TensorProduct ↥A0 E ↥C0 →+ M)
            (Λ0 : TensorProduct A D0 C →+ M),
            (∀ (x : E) (z : ↥C0), Λ (x ⊗ₜ[↥A0] z) = Λ0 (ε0 x ⊗ₜ[A] (z : C))) →
            ∀ k, Λ (t k) = Λ0 (MvPolynomial.eval₂Hom (Polynomial.eval₂RingHom
              (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A D0 C).toRingHom
              (p0 Polynomial.X ⊗ₜ[A] (1 : C))) (fun i => val i ⊗ₜ[A] (1 : C))
              (MvPolynomial.map (Polynomial.mapRingHom C0.subtype) (q0 k)))) := by
    intro E _ pE ε0 mkE hpE hmk0 hfac hε0X
    letI instE : Algebra ↥A0 E := (pE.comp (algebraMap ↥A0 (Polynomial ↥A0))).toAlgebra
    letI instC0 : Algebra ↥A0 ↥C0 :=
      ((γ.comp A0.subtype).codRestrict C0 (fun a => hAC a a.2)).toAlgebra

    let Ψ : MvPolynomial ι₀ (Polynomial ↥C0) →+* TensorProduct ↥A0 E ↥C0 :=
      MvPolynomial.eval₂Hom (Polynomial.eval₂RingHom
        (Algebra.TensorProduct.includeRight : ↥C0 →ₐ[↥A0] TensorProduct ↥A0 E ↥C0).toRingHom
        (pE Polynomial.X ⊗ₜ[↥A0] (1 : ↥C0)))
        (fun i => mkE (MvPolynomial.X i) ⊗ₜ[↥A0] (1 : ↥C0))
    have hΨC : ∀ z : ↥C0, Ψ (MvPolynomial.C (Polynomial.C z)) = (1 : E) ⊗ₜ[↥A0] z := by
      intro z
      simp only [Ψ, MvPolynomial.eval₂Hom_C, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      rfl
    have hΨX0 : Ψ (MvPolynomial.C Polynomial.X) = pE Polynomial.X ⊗ₜ[↥A0] (1 : ↥C0) := by
      simp only [Ψ, MvPolynomial.eval₂Hom_C, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
    have hΨX : ∀ i, Ψ (MvPolynomial.X i) = mkE (MvPolynomial.X i) ⊗ₜ[↥A0] (1 : ↥C0) := by
      intro i
      simp only [Ψ, MvPolynomial.eval₂Hom_X']

    have e1 : ∀ a' : ↥A0, (1 : E) ⊗ₜ[↥A0] (algebraMap ↥A0 ↥C0 a') =
        (algebraMap ↥A0 E a') ⊗ₜ[↥A0] (1 : ↥C0) := by
      intro a'
      rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one]
      exact (TensorProduct.smul_tmul a' (1 : E) (1 : ↥C0)).symm
    have hΨmap : ∀ F : MvPolynomial ι₀ (Polynomial ↥A0),
        Ψ (MvPolynomial.map (Polynomial.mapRingHom
          ((γ.comp A0.subtype).codRestrict C0 (fun a => hAC a a.2))) F) =
        mkE F ⊗ₜ[↥A0] (1 : ↥C0) := by
      have h : Ψ.comp (MvPolynomial.map (Polynomial.mapRingHom
          ((γ.comp A0.subtype).codRestrict C0 (fun a => hAC a a.2)))) =
          (Algebra.TensorProduct.includeLeftRingHom :
            E →+* TensorProduct ↥A0 E ↥C0).comp mkE := by
        apply MvPolynomial.ringHom_ext
        · intro a
          have h2 : (Ψ.comp (MvPolynomial.map (Polynomial.mapRingHom
              ((γ.comp A0.subtype).codRestrict C0 (fun a => hAC a a.2))))).comp MvPolynomial.C =
              ((Algebra.TensorProduct.includeLeftRingHom :
                E →+* TensorProduct ↥A0 E ↥C0).comp mkE).comp MvPolynomial.C := by
            apply Polynomial.ringHom_ext
            · intro a'
              simp only [RingHom.comp_apply, MvPolynomial.map_C, Polynomial.coe_mapRingHom,
                Polynomial.map_C, hΨC, Algebra.TensorProduct.includeLeftRingHom_apply]
              rw [← hpE]
              exact e1 a'
            · simp only [RingHom.comp_apply, MvPolynomial.map_C, Polynomial.coe_mapRingHom,
                Polynomial.map_X, hΨX0, Algebra.TensorProduct.includeLeftRingHom_apply, hpE]
          exact RingHom.congr_fun h2 a
        · intro i
          simp only [RingHom.comp_apply, MvPolynomial.map_X, hΨX,
            Algebra.TensorProduct.includeLeftRingHom_apply]
      intro F
      exact (RingHom.congr_fun h F).trans (Algebra.TensorProduct.includeLeftRingHom_apply _)
    have hΨker : ∀ x ∈ Ideal.span (Set.range fun j => MvPolynomial.map (Polynomial.mapRingHom
        ((γ.comp A0.subtype).codRestrict C0 (fun a => hAC a a.2))) (f0 j)), Ψ x = 0 := by
      intro x hx
      have hle : Ideal.span (Set.range fun j => MvPolynomial.map (Polynomial.mapRingHom
          ((γ.comp A0.subtype).codRestrict C0 (fun a => hAC a a.2))) (f0 j)) ≤ RingHom.ker Ψ := by
        rw [Ideal.span_le, Set.range_subset_iff]
        intro j
        rw [SetLike.mem_coe, RingHom.mem_ker, hΨmap, hmk0 j, TensorProduct.zero_tmul]
      exact (RingHom.mem_ker).mp (hle hx)

    have HS : ε0.comp (algebraMap ↥A0 E) = (algebraMap A D0).comp A0.subtype :=
      RingHom.ext fun a => by
        have h := RingHom.congr_fun hfac (Polynomial.C a)
        simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C] at h
        exact h
    have HT : C0.subtype.comp (algebraMap ↥A0 ↥C0) = (algebraMap A C).comp A0.subtype :=
      RingHom.ext fun a => rfl
    let Θ : TensorProduct ↥A0 E ↥C0 →+* TensorProduct A D0 C :=
      Algebra.TensorProduct.mapRingHom A0.subtype ε0 C0.subtype HS HT
    have hΘ : ∀ (x : E) (z : ↥C0), Θ (x ⊗ₜ[↥A0] z) = ε0 x ⊗ₜ[A] (z : C) :=
      fun x z => Algebra.TensorProduct.mapRingHom_tmul _ _ _ _ _ x z
    have key : Θ.comp Ψ = (MvPolynomial.eval₂Hom (Polynomial.eval₂RingHom
        (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A D0 C).toRingHom
        (p0 Polynomial.X ⊗ₜ[A] (1 : C))) (fun i => val i ⊗ₜ[A] (1 : C))).comp
        (MvPolynomial.map (Polynomial.mapRingHom C0.subtype)) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        have h2 : (Θ.comp Ψ).comp MvPolynomial.C = ((MvPolynomial.eval₂Hom (Polynomial.eval₂RingHom
            (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A D0 C).toRingHom
            (p0 Polynomial.X ⊗ₜ[A] (1 : C))) (fun i => val i ⊗ₜ[A] (1 : C))).comp
            (MvPolynomial.map (Polynomial.mapRingHom C0.subtype))).comp MvPolynomial.C := by
          apply Polynomial.ringHom_ext
          · intro c
            rw [RingHom.comp_apply, RingHom.comp_apply, hΨC, hΘ, map_one, RingHom.comp_apply,
              RingHom.comp_apply, MvPolynomial.map_C, Polynomial.coe_mapRingHom, Polynomial.map_C,
              MvPolynomial.eval₂Hom_C, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
            rfl
          · rw [RingHom.comp_apply, RingHom.comp_apply, hΨX0, hΘ, RingHom.comp_apply,
              RingHom.comp_apply, MvPolynomial.map_C, Polynomial.coe_mapRingHom, Polynomial.map_X,
              MvPolynomial.eval₂Hom_C, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
            have hX : ε0 (pE Polynomial.X) = p0 Polynomial.X := by
              have h := RingHom.congr_fun hfac Polynomial.X
              simpa only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X] using h
            rw [hX]
            rfl
        exact RingHom.congr_fun h2 r
      · intro i
        rw [RingHom.comp_apply, RingHom.comp_apply, hΨX, hΘ, hε0X, MvPolynomial.map_X,
          MvPolynomial.eval₂Hom_X']
        rfl
    have aevalΨ : ∀ g : MvPolynomial κ ℤ,
        MvPolynomial.aeval (fun k => Ψ (q0 k)) g = Ψ (MvPolynomial.aeval q0 g) := by
      intro g
      induction g using MvPolynomial.induction_on with
      | C n => simp only [eq_intCast, map_intCast]
      | add p q hp hq => rw [map_add, map_add, map_add, hp, hq]
      | mul_X p i hp => rw [map_mul, map_mul, map_mul, hp, MvPolynomial.aeval_X,
          MvPolynomial.aeval_X]
    refine ⟨fun k => Ψ (q0 k), ?_, ?_⟩
    · intro g hg
      exact (aevalΨ g).trans (hΨker _ (hrel0 g hg))
    · intro M _ Λ Λ0 hΛ k
      have hΛΘ : ∀ w, Λ w = Λ0 (Θ w) := by
        intro w
        induction w using TensorProduct.induction_on with
        | zero => rw [map_zero, map_zero, map_zero]
        | tmul x z => rw [hΛ, hΘ]
        | add x y hx hy => rw [map_add, map_add, map_add, hx, hy]
      rw [hΛΘ]
      exact congrArg Λ0 (RingHom.congr_fun key (q0 k))

  letI instPA0 : CommRing (Polynomial ↥A0) := inferInstance
  letI instMv : CommRing (MvPolynomial ι₀ (Polynomial ↥A0)) := inferInstance
  letI instQ : CommRing (MvPolynomial ι₀ (Polynomial ↥A0) ⧸ Ideal.span (Set.range f0)) :=
    Ideal.Quotient.commRing _
  have hEt : Algebra.Etale (Polynomial ↥A0)
      (MvPolynomial ι₀ (Polynomial ↥A0) ⧸ Ideal.span (Set.range f0)) := by
    let P : Algebra.PreSubmersivePresentation (Polynomial ↥A0)
        (MvPolynomial ι₀ (Polynomial ↥A0) ⧸ Ideal.span (Set.range f0)) ι₀ σ₀ :=
      { Algebra.Presentation.naive (v := f0) with map := mp, map_inj := hmp.1 }
    have hJ : P.jacobiMatrix = Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f0 j) := by
      ext i j
      rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      rfl
    have halg : ∀ x : MvPolynomial ι₀ (Polynomial ↥A0),
        algebraMap P.Ring (MvPolynomial ι₀ (Polynomial ↥A0) ⧸ Ideal.span (Set.range f0)) x =
          Ideal.Quotient.mk (Ideal.span (Set.range f0)) x := fun x => rfl
    have hunit : IsUnit P.jacobian := by
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, hJ, halg]
      have h1 : Ideal.Quotient.mk (Ideal.span (Set.range f0))
          (g0 * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f0 j)).det) = 1 := by
        rw [← map_one (Ideal.Quotient.mk (Ideal.span (Set.range f0))), Ideal.Quotient.eq]
        exact hcert
      rw [map_mul] at h1
      exact IsUnit.of_mul_eq_one _ ((mul_comm _ _).trans h1)
    let Q : Algebra.SubmersivePresentation (Polynomial ↥A0)
        (MvPolynomial ι₀ (Polynomial ↥A0) ⧸ Ideal.span (Set.range f0)) ι₀ σ₀ :=
      { P with jacobian_isUnit := hunit }
    have hdim : Q.dimension = 0 := by
      show Nat.card ι₀ - Nat.card σ₀ = 0
      rw [Nat.card_eq_of_bijective mp hmp, Nat.sub_self]
    haveI := Q.isStandardSmoothOfRelativeDimension hdim
    infer_instance
  set pE : Polynomial ↥A0 →+* (MvPolynomial ι₀ (Polynomial ↥A0) ⧸ Ideal.span (Set.range f0)) :=
    algebraMap (Polynomial ↥A0) _ with hpEdef
  have hpE : ∀ a, pE a = Ideal.Quotient.mk (Ideal.span (Set.range f0)) (MvPolynomial.C a) :=
    fun a => (Ideal.Quotient.mk_algebraMap (Polynomial ↥A0) (Ideal.span (Set.range f0)) a).symm

  obtain ⟨ε0, hε0C, hε0X⟩ : ∃ ε0 : (MvPolynomial ι₀ (Polynomial ↥A0) ⧸ Ideal.span (Set.range f0)) →+* D0,
      (∀ a, ε0 (Ideal.Quotient.mk (Ideal.span (Set.range f0)) (MvPolynomial.C a)) =
        p0 (Polynomial.mapRingHom A0.subtype a)) ∧
      ∀ i, ε0 (Ideal.Quotient.mk (Ideal.span (Set.range f0)) (MvPolynomial.X i)) = val i := by
    refine ⟨Ideal.Quotient.lift _
      (MvPolynomial.eval₂Hom (p0.comp (Polynomial.mapRingHom A0.subtype)) val) ?_,
      fun a => ?_, fun i => ?_⟩
    · intro a ha
      have hle : Ideal.span (Set.range f0) ≤
          RingHom.ker (MvPolynomial.eval₂Hom (p0.comp (Polynomial.mapRingHom A0.subtype)) val) := by
        rw [Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker, ← MvPolynomial.eval₂Hom_map_hom, hf0 j, hfval j]
      exact (RingHom.mem_ker).mp (hle ha)
    · rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
    · rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
  have hfac : ε0.comp pE = p0.comp (Polynomial.mapRingHom A0.subtype) :=
    RingHom.ext fun a => by rw [RingHom.comp_apply, hpE, hε0C, RingHom.comp_apply]
  exact ⟨MvPolynomial ι₀ (Polynomial ↥A0) ⧸ Ideal.span (Set.range f0), instQ, pE, ε0,
    RingHom.etale_algebraMap.mpr hEt, hfac,
    main _ pE ε0 (Ideal.Quotient.mk (Ideal.span (Set.range f0))) hpE
      (fun j => Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩)) hfac hε0X⟩

theorem wc_poly_tube_stage_finite_descent : ∀ (A B C : Type u) [CommRing A] [CommRing B] [CommRing C] (β : Polynomial A →+* B) (γ : A →+* C) (I : Type u) [SmallCategory I] [IsFiltered I] (D : I ⥤ CommRingCat.{u}) (p : ∀ i, Polynomial A →+* D.obj i) (ι : ∀ i, D.obj i →+* B), (∀ i, (p i).Etale) → (∀ {i j : I} (h : i ⟶ j), (D.map h).hom.comp (p i) = p j) → (∀ {i j : I} (h : i ⟶ j), (ι j).comp (D.map h).hom = ι i) → (∀ i, (ι i).comp (p i) = β) → (∀ b : B, ∃ (i : I) (s : D.obj i), ι i s = b) → (∀ (i : I) (s : D.obj i), ι i s = 0 → ∃ (j : I) (h : i ⟶ j), (D.map h).hom s = 0) → letI : Algebra A B := (β.comp (algebraMap A (Polynomial A))).toAlgebra; letI : Algebra A C := γ.toAlgebra; ∀ (κ : Type u) [Fintype κ] (r : κ → TensorProduct A B C) (G : Finset (MvPolynomial κ ℤ)), (∀ g ∈ G, MvPolynomial.aeval r g = 0) → ∃ (SA : Finset A) (SC : Finset C), ∀ (A0 : Subring A) (C0 : Subring C) (hAC : ∀ a ∈ A0, γ a ∈ C0), (∀ a ∈ SA, a ∈ A0) → (∀ c ∈ SC, c ∈ C0) → ∃ (E : Type u) (_ : CommRing E) (pE : Polynomial ↥A0 →+* E) (ε : E →+* B), pE.Etale ∧ ε.comp pE = β.comp (Polynomial.mapRingHom A0.subtype) ∧ (letI : Algebra ↥A0 E := (pE.comp (algebraMap ↥A0 (Polynomial ↥A0))).toAlgebra; letI : Algebra ↥A0 ↥C0 := ((γ.comp A0.subtype).codRestrict C0 (fun a => hAC a a.2)).toAlgebra; ∃ t : κ → TensorProduct ↥A0 E ↥C0, (∀ g ∈ G, MvPolynomial.aeval t g = 0) ∧ ∀ Λ : TensorProduct ↥A0 E ↥C0 →+ TensorProduct A B C, (∀ (x : E) (z : ↥C0), Λ (x ⊗ₜ z) = ε x ⊗ₜ (z : C)) → ∀ k, Λ (t k) = r k) :=
by
  intro A B C _ _ _ β γ I _ _ D p ι hp hDp hιD hιp hsurj hker
  letI : Algebra A B := (β.comp (algebraMap A (Polynomial A))).toAlgebra
  letI : Algebra A C := γ.toAlgebra
  intro κ _ r G hr
  obtain ⟨i, e, he, hΛe⟩ :=
    wc_tube_stage_filtered_lift A B C β γ I D p ι hDp hιD hιp hsurj hker κ r G hr
  letI : Algebra A (D.obj i) := ((p i).comp (algebraMap A (Polynomial A))).toAlgebra
  obtain ⟨ι₀, σ₀, _, _, _, mp, f, val, g₀, q, hmp, hfval, hcert, hq, hΦq⟩ :=
    wc_etale_stage_tensor_poly_rep A C (D.obj i) (p i) γ (hp i) κ e G he
  obtain ⟨SA, SC, hdesc⟩ := wc_std_etale_cert_relation_descent A C γ mp f g₀ hcert κ G q hq
  refine ⟨SA, SC, fun A0 C0 hAC hSA hSC => ?_⟩
  obtain ⟨f0, g0, q0, hf0, hq0, hcert0, hrel0⟩ := hdesc A0 C0 hAC hSA hSC
  obtain ⟨E, _, pE, ε0, hpE, hε0, t, ht, hΛt⟩ :=
    wc_descended_std_etale_stage_build A C (D.obj i) (p i) γ A0 C0 hAC mp hmp val f hfval
      f0 g0 hf0 hcert0 κ G q0 hrel0
  let ιA : D.obj i →ₐ[A] B :=
    { ι i with commutes' := fun a => RingHom.congr_fun (hιp i) (algebraMap A (Polynomial A) a) }
  let Λ0' : TensorProduct A (D.obj i) C →+ TensorProduct A B C :=
    (Algebra.TensorProduct.map ιA (AlgHom.id A C)).toRingHom.toAddMonoidHom
  have hΛ0' : ∀ (x : D.obj i) (z : C), Λ0' (x ⊗ₜ[A] z) = ι i x ⊗ₜ[A] z := fun x z => rfl
  refine ⟨E, inferInstance, pE, (ι i).comp ε0, hpE, ?_, ?_⟩
  · rw [RingHom.comp_assoc, hε0, ← RingHom.comp_assoc, hιp i]
  · letI : Algebra ↥A0 E := (pE.comp (algebraMap ↥A0 (Polynomial ↥A0))).toAlgebra
    letI : Algebra ↥A0 ↥C0 := ((γ.comp A0.subtype).codRestrict C0 (fun a => hAC a a.2)).toAlgebra
    refine ⟨t, ht, fun Λ hΛ k => ?_⟩
    have h1 := hΛt (TensorProduct A B C) Λ Λ0'
      (fun x z => by rw [hΛ, hΛ0', RingHom.comp_apply]) k
    rw [h1, hq0 k, hΦq k]
    exact hΛe Λ0' hΛ0' k

theorem wc_shens_poly_stage_lift : ∀ (P0 P : Type u) [CommRing P0] [CommRing P] (π : P0 →+* P) (y : Spec (.of P)) (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of P)) y)) (Scheme.Etale.forget (Spec (.of P)))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of P)), wcHalShData y B Λ W' φ a → ∀ (B' : Type u) [CommRing B'] [HenselianLocalRing B'] [IsSepClosed (IsLocalRing.ResidueField B')] (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ'] (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of P0)) (Spec.map (CommRingCat.ofHom π) y))) (Scheme.Etale.forget (Spec (.of P0)))) (φ' : ∀ l, Spec (.of B') ⟶ (W''.obj l).right.left) (a' : Spec (.of B') ⟶ Spec (.of P0)), wcHalShData (Spec.map (CommRingCat.ofHom π) y) B' Λ' W'' φ' a' → ∀ (E : Type u) [CommRing E] (pE : P0 →+* E), pE.Etale → ∀ ε : E →+* B, ε.comp pE = (Spec.preimage a).hom.comp π → ∃ (u : Spec (.of B) ⟶ Spec (.of B')) (σ : E →+* B'), u ≫ a' = a ≫ Spec.map (CommRingCat.ofHom π) ∧ σ.comp pE = (Spec.preimage a').hom ∧ (Spec.preimage u).hom.comp σ = ε :=
by

  have s1 : ∀ {Y Y' : Scheme.{u}} (p : Y' ⟶ Y) (y' : Y'), ∃ j : AlgebraicClosure (Y.residueField (p y')) →+* AlgebraicClosure (Y'.residueField y'), Spec.map (CommRingCat.ofHom j) ≫ wcEtGeomPt Y (p y') = wcEtGeomPt Y' y' ≫ p := by
    intro Y Y' p y'
    let ρ := p.residueFieldMap y'
    letI : Algebra (Y.residueField (p y')) (AlgebraicClosure (Y'.residueField y')) :=
      ((algebraMap (Y'.residueField y') (AlgebraicClosure (Y'.residueField y'))).comp ρ.hom).toAlgebra
    let j0 : AlgebraicClosure (Y.residueField (p y')) →ₐ[Y.residueField (p y')]
        AlgebraicClosure (Y'.residueField y') := IsAlgClosed.lift
    refine ⟨j0.toRingHom, ?_⟩
    have hj : j0.toRingHom.comp (algebraMap (Y.residueField (p y')) (AlgebraicClosure (Y.residueField (p y')))) =
        (algebraMap (Y'.residueField y') (AlgebraicClosure (Y'.residueField y'))).comp ρ.hom := by
      ext x
      exact j0.commutes x
    have h1 : Spec.map (CommRingCat.ofHom j0.toRingHom) ≫ Spec.map (CommRingCat.ofHom
        (algebraMap (Y.residueField (p y')) (AlgebraicClosure (Y.residueField (p y'))))) =
        Spec.map (CommRingCat.ofHom (algebraMap (Y'.residueField y') (AlgebraicClosure (Y'.residueField y')))) ≫
          Spec.map ρ := by
      rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hj, CommRingCat.ofHom_comp,
        CommRingCat.ofHom_hom]
    show Spec.map (CommRingCat.ofHom j0.toRingHom) ≫ (Spec.map (CommRingCat.ofHom
        (algebraMap (Y.residueField (p y')) (AlgebraicClosure (Y.residueField (p y'))))) ≫
        Y.fromSpecResidueField (p y')) =
      (Spec.map (CommRingCat.ofHom (algebraMap (Y'.residueField y') (AlgebraicClosure (Y'.residueField y')))) ≫
        Y'.fromSpecResidueField y') ≫ p
    rw [← Category.assoc, h1, Category.assoc, Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
      Category.assoc]

  have s2 : ∀ (B B' Ω Ω' : Type u) [CommRing B] [IsLocalRing B] [CommRing B'] [IsLocalRing B'] [Field Ω] [Field Ω'] (e : IsLocalRing.ResidueField B →+* Ω) (e' : IsLocalRing.ResidueField B' →+* Ω') (j : Ω' →+* Ω) (u : Spec (.of B) ⟶ Spec (.of B')), Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) ≫ u = Spec.map (CommRingCat.ofHom j) ≫ Spec.map (CommRingCat.ofHom e') ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B')) → IsLocalHom (Spec.preimage u).hom := by
    intro B B' Ω Ω' _ _ _ _ _ _ e e' j u h
    have h2 : Spec.map (CommRingCat.ofHom (e.comp ((IsLocalRing.residue B).comp (Spec.preimage u).hom))) =
        Spec.map (CommRingCat.ofHom (j.comp (e'.comp (IsLocalRing.residue B')))) := by
      simp only [CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc, CommRingCat.ofHom_hom,
        Spec.map_preimage]
      exact h
    have h3 := congrArg CommRingCat.Hom.hom (Spec.map_injective h2)
    simp only [CommRingCat.hom_ofHom] at h3
    constructor
    intro x hx
    by_contra hxn
    have h4 : IsLocalRing.residue B' x = 0 :=
      (IsLocalRing.residue_eq_zero_iff x).mpr ((IsLocalRing.mem_maximalIdeal x).mpr hxn)
    have h5 : IsLocalRing.residue B ((Spec.preimage u).hom x) ≠ 0 :=
      (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hx
    have h6 := RingHom.congr_fun h3 x
    simp only [RingHom.comp_apply, h4, map_zero] at h6
    exact h5 ((map_eq_zero e).mp h6)

  have s3 : ∀ (P0 E L K : Type u) [CommRing P0] [CommRing E] [Field L] [Field K] [IsSepClosed K] (pE : P0 →+* E), pE.Etale → ∀ (h : E →+* L) (j : K →+* L), (∀ x : P0, ∃ c : K, h (pE x) = j c) → ∀ y : E, ∃ c : K, h y = j c := by
    intro P0 E L K _ _ _ _ _ pE hpE h j hP y
    choose ψf hψf using hP
    have hj : Function.Injective j := j.injective
    let ψ0 : P0 →+* K :=
      { toFun := ψf
        map_one' := hj (by rw [← hψf]; simp)
        map_mul' := fun a b => hj (by rw [map_mul]; simp only [← hψf]; simp only [map_mul])
        map_zero' := hj (by rw [← hψf]; simp)
        map_add' := fun a b => hj (by rw [map_add]; simp only [← hψf]; simp only [map_add]) }
    letI : Algebra P0 K := ψ0.toAlgebra
    letI : Algebra P0 E := pE.toAlgebra
    haveI : Algebra.Etale P0 E := hpE
    letI : Algebra K L := j.toAlgebra
    letI : Algebra P0 L := (h.comp pE).toAlgebra
    haveI : IsScalarTower P0 K L := IsScalarTower.of_algebraMap_eq' (RingHom.ext hψf)
    haveI : Algebra.Etale K (TensorProduct P0 K E) := Algebra.Etale.baseChange P0 E K
    haveI : Module.Finite K (TensorProduct P0 K E) := Algebra.FormallyUnramified.finite_of_free K _
    let hE : E →ₐ[P0] L := { h with commutes' := fun x => rfl }
    let hbar : TensorProduct P0 K E →ₐ[K] L :=
      Algebra.TensorProduct.lift (Algebra.ofId K L) hE (fun _ _ => Commute.all _ _)
    have hbar1 : hbar ((1 : K) ⊗ₜ[P0] y) = h y := by
      simp [hbar, hE, Algebra.TensorProduct.lift_tmul]
    let L1 : Subalgebra K L := hbar.range
    haveI : Module.Finite K L1 :=
      Module.Finite.of_surjective hbar.rangeRestrict.toLinearMap hbar.rangeRestrict_surjective
    have hfield : IsField L1 := by
      haveI : Algebra.IsIntegral K L1 := Algebra.IsIntegral.of_finite K L1
      exact (Algebra.IsIntegral.isField_iff_isField (algebraMap K L1).injective).mp (Field.toIsField K)
    let F : IntermediateField K L := L1.toIntermediateField' hfield
    have hFL : ∀ t, hbar t ∈ F.toSubalgebra := by
      intro t
      show hbar t ∈ L1
      exact AlgHom.mem_range_self hbar t
    let r : TensorProduct P0 K E →ₐ[K] F := hbar.codRestrict F.toSubalgebra hFL
    have hr : Function.Surjective r := by
      rintro ⟨z, hz⟩
      have hz' : z ∈ L1 := hz
      obtain ⟨t, ht⟩ := hz'
      exact ⟨t, Subtype.ext ht⟩
    haveI : Algebra.FormallyUnramified K F := Algebra.FormallyUnramified.of_surjective r hr
    haveI : Module.Finite K F := Module.Finite.of_surjective r.toLinearMap hr
    haveI : Algebra.EssFiniteType K F := inferInstance
    haveI : Algebra.IsSeparable K F := Algebra.FormallyUnramified.isSeparable K F
    obtain ⟨c, hc⟩ := IsSepClosed.algebraMap_surjective K F (r ((1 : K) ⊗ₜ[P0] y))
    refine ⟨c, ?_⟩
    have := congrArg Subtype.val hc
    rw [← hbar1]
    exact this.symm

  have s4 : ∀ (B' B : Type u) [CommRing B'] [HenselianLocalRing B'] [CommRing B] [IsLocalRing B] (g : B' →+* B), IsLocalHom g → ∀ (P0 E : Type u) [CommRing P0] [CommRing E] (β' : P0 →+* B') (pE : P0 →+* E), pE.Etale → ∀ ε : E →+* B, ε.comp pE = g.comp β' → (∀ y : E, ∃ b : B', IsLocalRing.residue B (ε y) = IsLocalRing.residue B (g b)) → ∃ σ : E →+* B', σ.comp pE = β' ∧ g.comp σ = ε := by
    intro B' B _ _ _ _ g hg P0 E _ _ β' pE hpE ε hε hvals
    let gbar := IsLocalRing.ResidueField.map g
    have hgbar : ∀ b, gbar (IsLocalRing.residue B' b) = IsLocalRing.residue B (g b) :=
      fun b => IsLocalRing.ResidueField.map_residue g b
    have hginj : Function.Injective gbar := gbar.injective
    choose bf hbf using hvals
    have key : ∀ z, gbar (IsLocalRing.residue B' (bf z)) = IsLocalRing.residue B (ε z) :=
      fun z => (hgbar _).trans (hbf z).symm
    let σbar : E →+* IsLocalRing.ResidueField B' :=
      { toFun := fun z => IsLocalRing.residue B' (bf z)
        map_one' := hginj (by simp only [key, map_one])
        map_mul' := fun a b => hginj (by simp only [key, map_mul])
        map_zero' := hginj (by simp only [key, map_zero])
        map_add' := fun a b => hginj (by simp only [key, map_add]) }
    have hσbar : ∀ z, gbar (σbar z) = IsLocalRing.residue B (ε z) := key
    have hc : σbar.comp pE = (IsLocalRing.residue B').comp β' := by
      ext x
      apply hginj
      rw [RingHom.comp_apply, hσbar, RingHom.comp_apply, hgbar, ← RingHom.comp_apply ε pE, hε,
        RingHom.comp_apply]
    letI : Algebra P0 B' := β'.toAlgebra
    letI : Algebra P0 E := pE.toAlgebra
    haveI : Algebra.Etale P0 E := hpE
    obtain ⟨τ, hτ⟩ := wc_hnas_hs_etale_section_over_base P0 B'
      (fun E₁ _ _ _ σ₁ => wc_hnas_smooth_section_henselian B' E₁ σ₁) E σbar hc
    refine ⟨τ.toRingHom, ?_, ?_⟩
    · ext x
      exact τ.commutes x
    · letI : Algebra P0 B := (g.comp β').toAlgebra
      let τ₁ : E →ₐ[P0] B :=
        { g.comp τ.toRingHom with
          commutes' := fun x => by
            show g (τ (algebraMap P0 E x)) = g (β' x)
            rw [τ.commutes]
            rfl }
      let τ₂ : E →ₐ[P0] B := { ε with commutes' := fun x => RingHom.congr_fun hε x }
      have hu := wc_hnas_hs_etale_hom_unique_residue P0 E B τ₁ τ₂ (fun x => by
        show IsLocalRing.residue B (g (τ x)) = IsLocalRing.residue B (ε x)
        rw [← hgbar, hτ x]
        exact hσbar x)
      ext x
      exact AlgHom.congr_fun hu x

  intro P0 P _ _ π y B _ _ _ Λ _ _ W' φ a hd B' _ _ _ Λ' _ _ W'' φ' a' hd' E _ pE hpE ε hεp
  obtain ⟨j, hj⟩ := s1 (Spec.map (CommRingCat.ofHom π)) y
  obtain ⟨eB, heB⟩ := wc_shdata_normalized_residue y B Λ W' φ a hd
  obtain ⟨eB', -, heB'⟩ := hd'.2.2.2.2.2
  obtain ⟨u, hu, hsq⟩ := wc_shdata_comparison_map (Spec.map (CommRingCat.ofHom π))
    (Spec.map (CommRingCat.ofHom π) y) y (Spec.map (CommRingCat.ofHom j)) hj B' Λ' W'' φ' a' hd'
    eB' heB' B Λ W' φ a hd eB heB
  have hloc : IsLocalHom (Spec.preimage u).hom := s2 B B' _ _ eB eB' j u hsq
  have hg : (Spec.preimage u).hom.comp (Spec.preimage a').hom = (Spec.preimage a).hom.comp π := by
    have h1 : Spec.map (CommRingCat.ofHom ((Spec.preimage u).hom.comp (Spec.preimage a').hom)) =
        Spec.map (CommRingCat.ofHom ((Spec.preimage a).hom.comp π)) := by
      rw [CommRingCat.ofHom_comp, CommRingCat.ofHom_comp, Spec.map_comp, Spec.map_comp,
        CommRingCat.ofHom_hom, CommRingCat.ofHom_hom, CommRingCat.ofHom_hom, Spec.map_preimage,
        Spec.map_preimage, Spec.map_preimage]
      exact hu
    have h2 := congrArg CommRingCat.Hom.hom (Spec.map_injective h1)
    simpa only [CommRingCat.hom_ofHom] using h2
  haveI := hloc
  have hv := s3 P0 E (IsLocalRing.ResidueField B) (IsLocalRing.ResidueField B') pE hpE
    ((IsLocalRing.residue B).comp ε) (IsLocalRing.ResidueField.map (Spec.preimage u).hom)
    (fun x => ⟨IsLocalRing.residue B' ((Spec.preimage a').hom x), by
      show IsLocalRing.residue B (ε (pE x)) = _
      rw [IsLocalRing.ResidueField.map_residue, ← RingHom.comp_apply ε pE, hεp,
        ← RingHom.comp_apply (Spec.preimage u).hom (Spec.preimage a').hom, hg]⟩)
  have hvals : ∀ z : E, ∃ b : B', IsLocalRing.residue B (ε z) =
      IsLocalRing.residue B ((Spec.preimage u).hom b) := by
    intro z
    obtain ⟨c, hc⟩ := hv z
    obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective c
    refine ⟨b, ?_⟩
    rw [← IsLocalRing.ResidueField.map_residue (Spec.preimage u).hom b]
    exact hc
  obtain ⟨σ, hσ1, hσ2⟩ := s4 B' B (Spec.preimage u).hom hloc P0 E (Spec.preimage a').hom pE hpE
    ε (hεp.trans hg.symm) hvals
  exact ⟨u, σ, hu, hσ1, hσ2⟩

theorem wc_shens_tube_noetherian_factorisation : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (sA : Spec (.of A) ⟶ Spec (.of K)) (x : Spec (.of (Polynomial A))), Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (Polynomial A))) x)) (Scheme.Etale.forget (Spec (.of (Polynomial A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (Polynomial A))), wcHalShData x B Λ W' φ a → ∀ (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)] (c : Spec (.of C) ⟶ Spec (.of A)) (F : Finset Γ(Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c, ⊤)), ∃ (A' : Type u) (_ : CommRing A') (_ : HenselianLocalRing A') (_ : IsSepClosed (IsLocalRing.ResidueField A')) (sA' : Spec (.of A') ⟶ Spec (.of K)) (x' : Spec (.of (Polynomial A'))) (_ : Spec.map (CommRingCat.ofHom (algebraMap A' (Polynomial A'))) x' = IsLocalRing.closedPoint A') (B' : Type u) (_ : CommRing B') (_ : HenselianLocalRing B') (_ : IsSepClosed (IsLocalRing.ResidueField B')) (Λ' : Type u) (_ : SmallCategory Λ') (_ : IsCofiltered Λ') (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (Polynomial A'))) x')) (Scheme.Etale.forget (Spec (.of (Polynomial A'))))) (φ' : ∀ l, Spec (.of B') ⟶ (W''.obj l).right.left) (a' : Spec (.of B') ⟶ Spec (.of (Polynomial A'))) (_ : wcHalShData x' B' Λ' W'' φ' a') (C' : Type u) (_ : CommRing C') (_ : HenselianLocalRing C') (_ : IsSepClosed (IsLocalRing.ResidueField C')) (_ : IsNoetherianRing C') (c' : Spec (.of C') ⟶ Spec (.of A')) (θ : Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c ⟶ Limits.pullback (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (Polynomial A')))) c') (ψ : ↥(Subring.closure (F : Set Γ(Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c, ⊤))) →+* Γ(Limits.pullback (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (Polynomial A')))) c', ⊤)), θ.appTop.hom.comp ψ = (Subring.closure (F : Set Γ(Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c, ⊤))).subtype :=
by
  intro K _ A _ _ _ sA x hx B _ _ _ Λ _ _ W' φ a hd C _ _ _ c F
  classical

  have aeval_map : ∀ {R S σ : Type u} [CommRing R] [CommRing S] (j : R →+* S) (v : σ → R)
      (g : MvPolynomial σ ℤ),
      MvPolynomial.aeval (fun i => j (v i)) g = j (MvPolynomial.aeval v g) := by
    intro R S σ _ _ j v g
    have h : (j.toIntAlgHom).comp (MvPolynomial.aeval v) =
        MvPolynomial.aeval (fun i => j (v i)) :=
      MvPolynomial.algHom_ext (fun i => by simp)
    exact (congrArg (fun ψ => ψ g) h).symm

  obtain ⟨β, hβ, I, _, _, D, p, ι, hp, hDp, hιD, hιp, hsurj, hker⟩ :=
    wc_shdata_filtered_etale_presentation x B Λ W' φ a hd (Polynomial A) (Iso.refl _)
  have hβ' : Spec.map (CommRingCat.ofHom β) = a := hβ.trans (Category.comp_id a)
  have hpa : (Spec.preimage a).hom = β := by
    rw [← hβ', Spec.preimage_map]; rfl
  have hf : Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (Polynomial A)))) =
      a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp, hβ']
  obtain ⟨γ, hc⟩ : ∃ γ : A →+* C, Spec.map (CommRingCat.ofHom γ) = c :=
    ⟨(Spec.preimage c).hom, Spec.map_preimage c⟩
  obtain ⟨κK, -⟩ : ∃ κ : K →+* A, True := ⟨(Spec.preimage sA).hom, trivial⟩
  letI : Algebra A B := (β.comp (algebraMap A (Polynomial A))).toAlgebra
  letI : Algebra A C := γ.toAlgebra

  obtain ⟨e, he1, he2⟩ := wc_spec_pullback_gamma_tensor A B C
    (β.comp (algebraMap A (Polynomial A))) γ
    (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c hf hc

  obtain ⟨G, hG0, hGψ⟩ := wc_subring_closure_factor_of_lifts
    Γ(Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c, ⊤) F
  have hr : ∀ g ∈ G, MvPolynomial.aeval (fun k : ↥F => e k.1) g = 0 := by
    intro g hg
    have h1 := aeval_map e.toRingHom (fun r : ↥F => (r : Γ(Limits.pullback
      (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c, ⊤))) g
    rw [hG0 g hg, map_zero] at h1
    exact h1

  obtain ⟨SA, SC, hdesc⟩ := wc_poly_tube_stage_finite_descent A B C β γ I D p ι hp hDp hιD hιp
    hsurj hker ↥F (fun k : ↥F => e k.1) G hr

  obtain ⟨A0, hSA, hKA, hHA, hsepA, hnA, hlocA⟩ :=
    wc_shens_noetherian_subring_local K A κK SA

  obtain ⟨C0, hSC, hAC', hHC, hsepC, hnC, -⟩ :=
    wc_shens_noetherian_subring_local (↥A0) C (γ.comp A0.subtype) SC
  have hAC : ∀ a ∈ A0, γ a ∈ C0 := fun a ha => hAC' ⟨a, ha⟩

  obtain ⟨E, _, pE, ε, hpE, hεp, t0, ht0G, ht0Λ⟩ := hdesc A0 C0 hAC hSA hSC

  have hring : (Polynomial.mapRingHom A0.subtype).comp (algebraMap (↥A0) (Polynomial ↥A0)) =
      (algebraMap A (Polynomial A)).comp A0.subtype := by
    refine RingHom.ext fun r => ?_
    simp [Polynomial.algebraMap_eq]
  have hsq : Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom A0.subtype)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap (↥A0) (Polynomial ↥A0))) =
      Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) ≫
      Spec.map (CommRingCat.ofHom A0.subtype) := by
    rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
      hring]
  have hx' : Spec.map (CommRingCat.ofHom (algebraMap (↥A0) (Polynomial ↥A0)))
      (Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom A0.subtype)) x) =
      IsLocalRing.closedPoint ↥A0 := by
    rw [← Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom A0.subtype)))
      (Spec.map (CommRingCat.ofHom (algebraMap (↥A0) (Polynomial ↥A0)))) x, hsq,
      Scheme.Hom.comp_apply, hx]
    haveI : IsLocalHom (CommRingCat.ofHom A0.subtype).hom := hlocA
    exact Spec_closedPoint

  obtain ⟨B', _, _, _, Λ', _, _, W'', φ', a', e', hinit', haff', hφ', hφa', hlim', he', hpt'⟩ :=
    wc_et_geom_strict_henselization
      (Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom A0.subtype)) x)
  have hd' : wcHalShData (Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom A0.subtype)) x)
      B' Λ' W'' φ' a' := ⟨hinit', haff', hφ', hφa', hlim', e', he', hpt'⟩

  obtain ⟨u, σ, hu, hσp, hσε⟩ := wc_shens_poly_stage_lift (Polynomial ↥A0) (Polynomial A)
    (Polynomial.mapRingHom A0.subtype) x B Λ W' φ a hd B' Λ' W'' φ' a' hd' E pE hpE ε
    (by rw [hpa]; exact hεp)
  obtain ⟨β₁, hβ₁⟩ : ∃ β₁ : Polynomial ↥A0 →+* B', Spec.map (CommRingCat.ofHom β₁) = a' :=
    ⟨(Spec.preimage a').hom, Spec.map_preimage a'⟩
  have hpa' : (Spec.preimage a').hom = β₁ := by
    rw [← hβ₁, Spec.preimage_map]; rfl

  have h₁ : (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) ≫
      Spec.map (CommRingCat.ofHom A0.subtype) =
      u ≫ (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap (↥A0) (Polynomial ↥A0)))) := by
    rw [Category.assoc, ← hsq, ← Category.assoc, ← hu, Category.assoc]
  have h₂ : c ≫ Spec.map (CommRingCat.ofHom A0.subtype) =
      Spec.map (CommRingCat.ofHom C0.subtype) ≫
        Spec.map (CommRingCat.ofHom ((γ.comp A0.subtype).codRestrict C0
          (fun a => hAC a a.2))) := by
    rw [← hc, ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← CommRingCat.ofHom_comp]
    exact congrArg (fun g : ↥A0 →+* C => Spec.map (CommRingCat.ofHom g))
      (RingHom.ext fun _ => rfl)
  let θ := Limits.pullback.map (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c
    (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap (↥A0) (Polynomial ↥A0))))
    (Spec.map (CommRingCat.ofHom ((γ.comp A0.subtype).codRestrict C0 (fun a => hAC a a.2))))
    u (Spec.map (CommRingCat.ofHom C0.subtype)) (Spec.map (CommRingCat.ofHom A0.subtype)) h₁ h₂

  have hf' : Spec.map (CommRingCat.ofHom (β₁.comp (algebraMap (↥A0) (Polynomial ↥A0)))) =
      a' ≫ Spec.map (CommRingCat.ofHom (algebraMap (↥A0) (Polynomial ↥A0))) := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp, hβ₁]
  obtain ⟨e₁, he₁1, he₁2⟩ := wc_spec_pullback_gamma_tensor (↥A0) B' (↥C0)
    (β₁.comp (algebraMap (↥A0) (Polynomial ↥A0)))
    ((γ.comp A0.subtype).codRestrict C0 (fun a => hAC a a.2))
    (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap (↥A0) (Polynomial ↥A0))))
    (Spec.map (CommRingCat.ofHom ((γ.comp A0.subtype).codRestrict C0 (fun a => hAC a a.2))))
    hf' rfl

  letI : Algebra (↥A0) B' := (β₁.comp (algebraMap (↥A0) (Polynomial ↥A0))).toAlgebra
  letI : Algebra (↥A0) (↥C0) :=
    ((γ.comp A0.subtype).codRestrict C0 (fun a => hAC a a.2)).toAlgebra
  letI : Algebra (↥A0) E := (pE.comp (algebraMap (↥A0) (Polynomial ↥A0))).toAlgebra
  have hσp' : σ.comp pE = β₁ := hσp.trans hpa'
  let σA : E →ₐ[↥A0] B' :=
    { σ with commutes' := fun r => RingHom.congr_fun hσp' (algebraMap (↥A0) (Polynomial ↥A0) r) }
  let Φ' := Algebra.TensorProduct.map σA (AlgHom.id (↥A0) (↥C0))

  let Λ₀ : TensorProduct (↥A0) E (↥C0) →+ TensorProduct A B C :=
    e.toRingHom.toAddMonoidHom.comp ((θ.appTop.hom.toAddMonoidHom).comp
      (e₁.symm.toRingHom.toAddMonoidHom.comp Φ'.toRingHom.toAddMonoidHom))
  have hΛ : ∀ (y : E) (z : ↥C0), Λ₀ (y ⊗ₜ z) = ε y ⊗ₜ (z : C) := by
    intro y z
    have hnat := wc_spec_pullback_gamma_tensor_natural A B C (↥A0) B' (↥C0)
      (β.comp (algebraMap A (Polynomial A))) γ
      (β₁.comp (algebraMap (↥A0) (Polynomial ↥A0)))
      ((γ.comp A0.subtype).codRestrict C0 (fun a => hAC a a.2))
      (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c
      (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap (↥A0) (Polynomial ↥A0))))
      (Spec.map (CommRingCat.ofHom ((γ.comp A0.subtype).codRestrict C0 (fun a => hAC a a.2))))
      u (Spec.map (CommRingCat.ofHom C0.subtype)) (Spec.map (CommRingCat.ofHom A0.subtype)) h₁ h₂
      e e₁ he1 he2 he₁1 he₁2 (σ y) z
    rw [Spec.preimage_map] at hnat
    have h3 : (Spec.preimage u).hom (σ y) = ε y := RingHom.congr_fun hσε y
    rw [h3] at hnat
    show e (θ.appTop.hom (e₁.symm (Φ' (y ⊗ₜ z)))) = _
    rw [Algebra.TensorProduct.map_tmul]
    exact hnat

  let t : ↥F → Γ(Limits.pullback
      (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap (↥A0) (Polynomial ↥A0))))
      (Spec.map (CommRingCat.ofHom ((γ.comp A0.subtype).codRestrict C0
        (fun a => hAC a a.2)))), ⊤) :=
    fun k => e₁.symm (Φ' (t0 k))
  have hrel : ∀ g ∈ G, MvPolynomial.aeval t g = 0 := by
    intro g hg
    have h1 := aeval_map ((e₁.symm.toRingHom).comp Φ'.toRingHom) t0 g
    refine h1.trans ((congrArg ((e₁.symm.toRingHom).comp Φ'.toRingHom) ?_).trans (map_zero _))
    exact ht0G g hg
  have hlift : ∀ k : ↥F, θ.appTop.hom (t k) = k := by
    intro k
    apply e.injective
    exact ht0Λ Λ₀ hΛ k

  obtain ⟨ψ, hψ⟩ := hGψ _ θ.appTop.hom t hlift hrel

  exact ⟨↥A0, inferInstance, hHA, hsepA,
    Spec.map (CommRingCat.ofHom (κK.codRestrict A0 hKA)),
    Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom A0.subtype)) x, hx',
    B', inferInstance, inferInstance, inferInstance, Λ', inferInstance, inferInstance,
    W'', φ', a', hd', ↥C0, inferInstance, hHC, hsepC, hnC,
    Spec.map (CommRingCat.ofHom ((γ.comp A0.subtype).codRestrict C0 (fun a => hAC a a.2))),
    θ, ψ, hψ⟩

theorem wc_shens_poly_closed_fibre_surjective : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (y : Spec (.of (Polynomial R))), Spec.map (CommRingCat.ofHom (algebraMap R (Polynomial R))) y = IsLocalRing.closedPoint R → ∀ (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (Polynomial R))) y)) (Scheme.Etale.forget (Spec (.of (Polynomial R))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (Polynomial R))), wcHalShData y B Λ W' φ a → Surjective (a ≫ Spec.map (CommRingCat.ofHom (algebraMap R (Polynomial R)))) :=
by
  intro R _ _ y hy B _ _ Λ _ _ W' φ a hd
  obtain ⟨β, hβ, I, _, _, F, p, ι, h1, h2, h3, h4, h5, h6⟩ :=
    wc_shdata_filtered_etale_presentation y B Λ W' φ a hd (Polynomial R) (Iso.refl _)
  rw [Iso.refl_hom, Category.comp_id] at hβ

  have hβflat : β.Flat := by
    letI : Algebra (Polynomial R) B := β.toAlgebra
    have hfl := (wc_ring_fep_flat_and_base_change (Polynomial R) B (Polynomial R) I F p ι
      h1 h2 h3 h4 h5 h6).1
    exact hfl
  have hCflat : (algebraMap R (Polynomial R)).Flat :=
    RingHom.flat_algebraMap_iff.mpr inferInstance
  have hgflat : (β.comp (algebraMap R (Polynomial R))).Flat := RingHom.Flat.comp hCflat hβflat

  obtain ⟨-, -, -, -, -, e, -, hpt⟩ := hd
  have hay : a (IsLocalRing.closedPoint B) = y := by
    obtain ⟨pt⟩ : Nonempty (Spec (.of (AlgebraicClosure
        ((Spec (.of (Polynomial R))).residueField y)))) := ⟨IsLocalRing.closedPoint _⟩
    have k1 := congrArg (fun t => t pt) hpt
    simp only [wcEtGeomPt, Scheme.Hom.comp_apply] at k1
    have k2 : (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)))
        ((Spec.map (CommRingCat.ofHom e)) pt) = IsLocalRing.closedPoint B :=
      IsLocalRing.PrimeSpectrum.comap_residue B _
    rw [k2, Scheme.fromSpecResidueField_apply] at k1
    exact k1
  have hay' : PrimeSpectrum.comap β (IsLocalRing.closedPoint B) = y := by
    rw [← hβ] at hay
    exact hay
  have E1 : Ideal.comap β (IsLocalRing.maximalIdeal B) =
      PrimeSpectrum.asIdeal (y : PrimeSpectrum (Polynomial R)) := by
    rw [← hay']
    rfl
  have hy' : PrimeSpectrum.comap (algebraMap R (Polynomial R)) y = IsLocalRing.closedPoint R := hy
  have E2 : Ideal.comap (algebraMap R (Polynomial R))
      (PrimeSpectrum.asIdeal (y : PrimeSpectrum (Polynomial R))) =
      IsLocalRing.maximalIdeal R := by
    have k := congrArg PrimeSpectrum.asIdeal hy'
    exact k
  have E : Ideal.comap (β.comp (algebraMap R (Polynomial R))) (IsLocalRing.maximalIdeal B) =
      IsLocalRing.maximalIdeal R := by
    rw [← Ideal.comap_comap, E1, E2]

  letI : Algebra R B := (β.comp (algebraMap R (Polynomial R))).toAlgebra
  haveI : Module.Flat R B := hgflat
  haveI : IsLocalHom (algebraMap R B) := by
    refine ⟨fun r hr => ?_⟩
    by_contra hnu
    have hrm : r ∈ IsLocalRing.maximalIdeal R := (IsLocalRing.mem_maximalIdeal r).mpr hnu
    rw [← E, Ideal.mem_comap] at hrm
    exact ((IsLocalRing.mem_maximalIdeal _).mp hrm) hr
  haveI : Module.FaithfullyFlat R B := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hsurj : Function.Surjective (PrimeSpectrum.comap (algebraMap R B)) :=
    PrimeSpectrum.comap_surjective_of_faithfullyFlat
  refine ⟨fun x => ?_⟩
  obtain ⟨z, hz⟩ : ∃ z : Spec (.of B), PrimeSpectrum.comap (algebraMap R B) z = x := hsurj x
  refine ⟨z, ?_⟩
  rw [Scheme.Hom.comp_apply, ← hβ]
  first
    | exact hz
    | (rw [← hz]; rfl)

theorem wc_affine_line_shens_strict_test_noetherian_reduction : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (sA : Spec (.of A) ⟶ Spec (.of K)) (x : Spec (.of (Polynomial A))), Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (Polynomial A))) x)) (Scheme.Etale.forget (Spec (.of (Polynomial A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (Polynomial A))), wcHalShData x B Λ W' φ a → ∀ (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)] [IsNoetherianRing C] (c : Spec (.of C) ⟶ Spec (.of A)), Nat.card (wcEtCoh (Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c) ℓ 0) = ℓ ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c) ℓ q)) → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (sA : Spec (.of A) ⟶ Spec (.of K)) (x : Spec (.of (Polynomial A))), Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (Polynomial A))) x)) (Scheme.Etale.forget (Spec (.of (Polynomial A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (Polynomial A))), wcHalShData x B Λ W' φ a → ∀ (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)] (c : Spec (.of C) ⟶ Spec (.of A)), Nat.card (wcEtCoh (Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c) ℓ 0) = ℓ ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c) ℓ q) :=
by
  intro K _ _ ℓ hℓ hℓK HN A _ _ _ sA x hx B _ _ _ Λ _ _ W' φ a hd C _ _ _ c
  classical

  have hconn_spec : ∀ (R : Type u) [CommRing R], Nonempty (PrimeSpectrum R) →
      (∀ e : R, IsIdempotentElem e → e = 0 ∨ e = 1) → ConnectedSpace (PrimeSpectrum R) := by
    intro R _ hne hid
    rw [connectedSpace_iff_clopen]
    refine ⟨hne, fun s hs => ?_⟩
    obtain ⟨e, he, rfl⟩ := PrimeSpectrum.isClopen_iff.mp hs
    rcases hid e he with h | h
    · left
      rw [h, PrimeSpectrum.basicOpen_zero]
      rfl
    · right
      rw [h, PrimeSpectrum.basicOpen_one]
      rfl
  have hidem_spec : ∀ (R : Type u) [CommRing R] [ConnectedSpace (PrimeSpectrum R)] (e : R),
      IsIdempotentElem e → e = 0 ∨ e = 1 := by
    intro R _ _ e he
    have hcl : IsClopen ((PrimeSpectrum.basicOpen e : TopologicalSpace.Opens (PrimeSpectrum R)) :
        Set (PrimeSpectrum R)) := PrimeSpectrum.isClopen_iff.mpr ⟨e, he, rfl⟩
    rcases isClopen_iff.mp hcl with h | h
    · left
      have hb : PrimeSpectrum.basicOpen e = ⊥ :=
        TopologicalSpace.Opens.ext (h.trans TopologicalSpace.Opens.coe_bot.symm)
      obtain ⟨n, hn⟩ := (PrimeSpectrum.basicOpen_eq_bot_iff e).mp hb
      have hpow : ∀ k : ℕ, e ^ (k + 1) = e := by
        intro k
        induction k with
        | zero => simp
        | succ k ih => rw [pow_succ, ih]; exact he
      cases n with
      | zero => rw [pow_zero] at hn; rw [← mul_one e, hn, mul_zero]
      | succ n => rw [← hpow n, hn]
    · right
      have hb : PrimeSpectrum.basicOpen (1 - e) = ⊥ := by
        rw [eq_bot_iff]
        intro p hp
        have h1 : p ∈ PrimeSpectrum.basicOpen e := by
          rw [← SetLike.mem_coe, h]
          trivial
        have h2 : p ∈ PrimeSpectrum.basicOpen (e * (1 - e)) := by
          rw [PrimeSpectrum.basicOpen_mul]
          exact ⟨h1, hp⟩
        rw [show e * (1 - e) = 0 by rw [mul_sub, mul_one, he.eq, sub_self],
          PrimeSpectrum.basicOpen_zero] at h2
        exact h2
      obtain ⟨n, hn⟩ := (PrimeSpectrum.basicOpen_eq_bot_iff (1 - e)).mp hb
      have he1 : IsIdempotentElem (1 - e) := he.one_sub
      have hpow : ∀ k : ℕ, (1 - e) ^ (k + 1) = 1 - e := by
        intro k
        induction k with
        | zero => simp
        | succ k ih => rw [pow_succ, ih]; exact he1
      have h0 : 1 - e = 0 := by
        cases n with
        | zero => rw [pow_zero] at hn; rw [← mul_one (1 - e), hn, mul_zero]
        | succ n => rw [← hpow n, hn]
      exact (sub_eq_zero.mp h0).symm

  have hiso_surj : ∀ {X Y : Scheme.{u}} (i : X ≅ Y), Function.Surjective i.hom := by
    intro X Y i y
    refine ⟨i.inv y, ?_⟩
    rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]
    rfl
  have hconnX : ∀ (X : Scheme.{u}), IsAffine X → Nonempty X →
      (∀ e : Γ(X, ⊤), IsIdempotentElem e → e = 0 ∨ e = 1) → ConnectedSpace X := by
    intro X _ hne hid
    obtain ⟨p⟩ := hne
    have hR : ConnectedSpace (PrimeSpectrum Γ(X, ⊤)) :=
      hconn_spec _ ⟨X.isoSpec.hom p⟩ hid
    haveI : ConnectedSpace (Spec Γ(X, ⊤)) := hR
    exact Function.Surjective.connectedSpace (hiso_surj X.isoSpec.symm) X.isoSpec.inv.continuous
  have hidX : ∀ (X : Scheme.{u}), IsAffine X → ConnectedSpace X →
      ∀ e : Γ(X, ⊤), IsIdempotentElem e → e = 0 ∨ e = 1 := by
    intro X _ hc e he
    haveI := hc
    have h1 : ConnectedSpace (Spec Γ(X, ⊤)) :=
      Function.Surjective.connectedSpace (hiso_surj X.isoSpec) X.isoSpec.hom.continuous
    have h2 : ConnectedSpace (PrimeSpectrum Γ(X, ⊤)) := h1
    exact @hidem_spec _ _ h2 e he

  have hgen : ∀ (R T₀ : Type u) [CommRing R] [CommRing T₀] (S : Subring R) (ψ : S →+* T₀)
      (j : T₀ →+* R), j.comp ψ = S.subtype →
      (∀ t : T₀, IsIdempotentElem t → t = 0 ∨ t = 1) →
      ∀ e : R, e ∈ S → IsIdempotentElem e → e = 0 ∨ e = 1 := by
    intro R T₀ _ _ S ψ j hj hT e heS he
    have hsq : (⟨e, heS⟩ : S) * ⟨e, heS⟩ = ⟨e, heS⟩ :=
      Subtype.ext (show e * e = e from he.eq)
    have hid : IsIdempotentElem (ψ ⟨e, heS⟩) := by
      unfold IsIdempotentElem
      rw [← map_mul, hsq]
    have hje : j (ψ ⟨e, heS⟩) = e := by
      rw [← RingHom.comp_apply, hj]
      rfl
    rcases hT _ hid with h | h
    · left
      rw [← hje, h, map_zero]
    · right
      rw [← hje, h, map_one]

  have haff : ∀ (A₀ B₀ C₀ : Type u) [CommRing A₀] [CommRing B₀] [CommRing C₀]
      (f₀ : Spec (.of B₀) ⟶ Spec (.of A₀)) (c₀ : Spec (.of C₀) ⟶ Spec (.of A₀)),
      IsAffine (Limits.pullback f₀ c₀) := by
    intro A₀ B₀ C₀ _ _ _ f₀ c₀
    infer_instance
  have hTaff := haff A B C (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c

  haveI hsurj := wc_shens_poly_closed_fibre_surjective A x hx B Λ W' φ a hd
  have hsnd : Surjective (Limits.pullback.snd
      (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c) := inferInstance
  obtain ⟨t, -⟩ := hsnd.surj (IsLocalRing.closedPoint C)

  have hidT : ∀ e : Γ(Limits.pullback
      (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c, ⊤),
      IsIdempotentElem e → e = 0 ∨ e = 1 := by
    intro e he
    obtain ⟨A', _, _, _, sA', x', hx', B', _, _, _, Λ', _, _, W'', φ', a', hd', C', _, _, _, _, c',
      θ, ψ, hψ⟩ := wc_shens_tube_noetherian_factorisation K A sA x hx B Λ W' φ a hd C c {e}
    have hT'conn := wc_et_coh0_card_prime_connected _ ℓ hℓ
      (HN A' sA' x' hx' B' Λ' W'' φ' a' hd' C' c').1
    have hT'id := hidX _
      (haff A' B' C' (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (Polynomial A')))) c')
      hT'conn
    exact hgen _ _ _ ψ θ.appTop.hom hψ hT'id e
      (Subring.subset_closure (Finset.mem_coe.mpr (Finset.mem_singleton_self e))) he
  have hconn := hconnX _ hTaff ⟨t⟩ hidT
  refine ⟨@wc_et_coh_zero_connected_card _ hconn ℓ hℓ.ne_zero, fun q hq => ?_⟩

  haveI := hTaff
  have hR := wc_et_coh_subring_factor_vanishing
    Γ(Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c, ⊤) ℓ q
    (fun F => by
      obtain ⟨A', _, _, _, sA', x', hx', B', _, _, _, Λ', _, _, W'', φ', a', hd', C', _, _, _, _, c',
        θ, ψ, hψ⟩ := wc_shens_tube_noetherian_factorisation K A sA x hx B Λ W' φ a hd C c F
      haveI := haff A' B' C' (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (Polynomial A')))) c'
      haveI := (HN A' sA' x' hx' B' Λ' W'' φ' a' hd' C' c').2 q hq
      obtain ⟨E⟩ := wc_et_coh_iso_invariance (Limits.pullback
        (a' ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (Polynomial A')))) c').isoSpec.hom ℓ q
      exact ⟨_, inferInstance, ψ, θ.appTop.hom, hψ, E.subsingleton⟩)
  obtain ⟨E⟩ := wc_et_coh_iso_invariance (Limits.pullback
    (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c).isoSpec.hom ℓ q
  exact E.symm.subsingleton

theorem wc_gacyc_colim : ∀ {X : Scheme.{u}} [IsAffine X] (A : Type u) [CommRing A] (g : X ⟶ Spec (.of A)) (L : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush g) → Limits.PreservesFiniteLimits L → ∀ (e : L.obj (wcZSh (Spec (.of A))) ≅ wcZSh X) (n : ℕ), (∀ (J : Type (u+1)) [SmallCategory J] [IsFiltered J] (D : J ⥤ Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}) (c : Limits.Cocone D), Limits.IsColimit c → (∀ j, wcHalAcyc L e (D.obj j) n) → wcHalAcyc L e c.pt n) ∧ (∀ (F G : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}), (F ≅ G) → wcHalAcyc L e F n → wcHalAcyc L e G n) ∧ (∀ (k : ℕ) (F : Fin k → Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}), (∀ i, wcHalAcyc L e (F i) n) → wcHalAcyc L e (⨁ F) n) :=
by
  intro X _ A _ g L hadj hL e n
  obtain ⟨adj⟩ := hadj
  haveI : L.Additive := adj.left_adjoint_additive

  have AFF : ∀ (T : Scheme.{u}) [IsAffine T] (Λ : Type (u+1)) [SmallCategory Λ] [IsFiltered Λ]
      (G : Λ ⥤ Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) (c : Limits.Cocone G),
      Limits.IsColimit c →
      (∀ x : wcZSh T ⟶ c.pt, ∃ (i : Λ) (y : wcZSh T ⟶ G.obj i), y ≫ c.ι.app i = x) ∧
      (∀ (i : Λ) (y : wcZSh T ⟶ G.obj i), y ≫ c.ι.app i = 0 →
        ∃ (j : Λ) (f : i ⟶ j), y ≫ G.map f = 0) ∧
      (letI : HasExt (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) := HasExt.standard _
       ∀ (p : ℕ) (x : Abelian.Ext (wcZSh T) c.pt p),
        ∃ (i : Λ) (y : Abelian.Ext (wcZSh T) (G.obj i) p),
          y.comp (Abelian.Ext.mk₀ (c.ι.app i)) (add_zero p) = x) := by
    intro T _ Λ _ _ G c hc
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) := HasExt.standard _
    haveI : EssentiallySmall.{u+1} T.Etale := inferInstance
    haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) :=
      Sheaf.isGrothendieckAbelian_of_essentiallySmall (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}
    have cc : ∀ {A B C' : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}} {p : ℕ}
        (v : Abelian.Ext (wcZSh T) A p) (f : A ⟶ B) (g : B ⟶ C'),
        (v.comp (Abelian.Ext.mk₀ f) (add_zero p)).comp (Abelian.Ext.mk₀ g) (add_zero p) =
          v.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero p) := by
      intro A B C' p v f g
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀]
    have hT : Limits.IsTerminal (Scheme.Etale.mk (𝟙 T)) :=
      Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
        (fun V m => MorphismProperty.Over.Hom.ext
          ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
    have hTaff : IsAffine (Scheme.Etale.mk (𝟙 T)).left := by
      change IsAffine T
      infer_instance
    have mk0inj : ∀ {F₁ F₂ : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}}
        (a b : F₁ ⟶ F₂), Abelian.Ext.mk₀ a = Abelian.Ext.mk₀ b → a = b := by
      intro F₁ F₂ a b h
      apply Abelian.Ext.homEquiv₀.symm.injective
      rw [Abelian.Ext.homEquiv₀_symm_apply, Abelian.Ext.homEquiv₀_symm_apply]
      exact h
    have nat : ∀ {F₁ F₂ : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}}
        (f : F₁ ⟶ F₂) (y : wcZSh T ⟶ F₁),
        (f.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 T)))).hom
          ((Sheaf.H.equiv₀ F₁ hT) (Abelian.Ext.mk₀ y)) =
          (Sheaf.H.equiv₀ F₂ hT) (Abelian.Ext.mk₀ (y ≫ f)) := by
      intro F₁ F₂ f y
      rw [Sheaf.H.equiv₀_naturality hT f, Sheaf.H.map_apply, Abelian.Ext.mk₀_comp_mk₀]
    have Φsurj : ∀ (F₁ : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})
        (t : F₁.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 T)))),
        ∃ y : wcZSh T ⟶ F₁, (Sheaf.H.equiv₀ F₁ hT) (Abelian.Ext.mk₀ y) = t := by
      intro F₁ t
      refine ⟨Abelian.Ext.homEquiv₀ ((Sheaf.H.equiv₀ F₁ hT).symm t), ?_⟩
      rw [Abelian.Ext.mk₀_homEquiv₀_apply, AddEquiv.apply_symm_apply]
    have Φinj : ∀ {F₁ : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}}
        (a b : wcZSh T ⟶ F₁),
        (Sheaf.H.equiv₀ F₁ hT) (Abelian.Ext.mk₀ a) = (Sheaf.H.equiv₀ F₁ hT) (Abelian.Ext.mk₀ b) →
        a = b := fun a b h => mk0inj a b ((Sheaf.H.equiv₀ _ hT).injective h)
    obtain ⟨hA, hB⟩ := wc_et_sheaf_colimit_cocone_local T Λ G
    obtain ⟨hsurj, hinj⟩ := wc_et_affine_sections_local_cocone T Λ G (Limits.colimit G)
      (Limits.colimit.ι G) (fun i j f => Limits.colimit.w G f) hA hB (Scheme.Etale.mk (𝟙 T)) hTaff
    let E : Limits.colimit G ≅ c.pt := (Limits.colimit.isColimit G).coconePointUniqueUpToIso hc
    have hE : ∀ i, Limits.colimit.ι G i ≫ E.hom = c.ι.app i := fun i =>
      (Limits.colimit.isColimit G).comp_coconePointUniqueUpToIso_hom hc i
    have hE' : ∀ i, c.ι.app i ≫ E.inv = Limits.colimit.ι G i := fun i => by
      rw [← hE i, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    refine ⟨?_, ?_, ?_⟩
    · intro x
      obtain ⟨i, t, ht⟩ := hsurj ((Sheaf.H.equiv₀ (Limits.colimit G) hT) (Abelian.Ext.mk₀ (x ≫ E.inv)))
      obtain ⟨y, rfl⟩ := Φsurj (G.obj i) t
      refine ⟨i, y, ?_⟩
      rw [nat] at ht
      have h1 : y ≫ Limits.colimit.ι G i = x ≫ E.inv := Φinj _ _ ht
      rw [← hE i, ← Category.assoc, h1, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    · intro i y hy
      have h1 : y ≫ Limits.colimit.ι G i = 0 := by
        rw [← hE' i, ← Category.assoc, hy, Limits.zero_comp]
      have h0 : ((Limits.colimit.ι G i).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 T)))).hom
          ((Sheaf.H.equiv₀ (G.obj i) hT) (Abelian.Ext.mk₀ y)) = 0 := by
        rw [nat, h1, Abelian.Ext.mk₀_zero, map_zero]
      obtain ⟨j, f, hf⟩ := hinj i _ h0
      rw [nat] at hf
      refine ⟨j, f, Φinj _ _ ?_⟩
      rw [hf, Abelian.Ext.mk₀_zero, map_zero]
    · have H0 : ∀ (G' : Λ ⥤ Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})
          (x : Abelian.Ext (wcZSh T) (Limits.colimit G') 0),
          ∃ (i : Λ) (y : Abelian.Ext (wcZSh T) (G'.obj i) 0),
            y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G' i)) (add_zero 0) = x := by
        intro G' x
        obtain ⟨hA', hB'⟩ := wc_et_sheaf_colimit_cocone_local T Λ G'
        obtain ⟨hsurj', -⟩ := wc_et_affine_sections_local_cocone T Λ G' (Limits.colimit G')
          (Limits.colimit.ι G') (fun i j f => Limits.colimit.w G' f) hA' hB'
          (Scheme.Etale.mk (𝟙 T)) hTaff
        obtain ⟨i, t, ht⟩ := hsurj' ((Sheaf.H.equiv₀ (Limits.colimit G') hT) x)
        refine ⟨i, (Sheaf.H.equiv₀ (G'.obj i) hT).symm t,
          (Sheaf.H.equiv₀ (Limits.colimit G') hT).injective ?_⟩
        have h := Sheaf.H.equiv₀_naturality hT (Limits.colimit.ι G' i)
          ((Sheaf.H.equiv₀ (G'.obj i) hT).symm t)
        rw [AddEquiv.apply_symm_apply, Sheaf.H.map_apply] at h
        rw [← h, ht]
      have Hemb : ∀ G' : Λ ⥤ Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1},
          ∃ (I : Λ ⥤ Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) (α : G' ⟶ I), Mono α ∧
            ∀ (q : ℕ) (e : Abelian.Ext (wcZSh T) (Limits.colimit I) (q + 1)), e = 0 := by
        intro G'
        obtain ⟨I, α, hα, hinjI⟩ := wc_et_functorial_injective_embedding T Λ G'
        obtain ⟨hA', hB'⟩ := wc_et_sheaf_colimit_cocone_local T Λ I
        exact ⟨I, α, hα, wc_et_affine_colim_injective_acyclic T Λ I hinjI (fun U hU =>
          wc_et_affine_sections_local_cocone T Λ I (Limits.colimit I) (Limits.colimit.ι I)
            (fun i j f => Limits.colimit.w I f) hA' hB' U hU)⟩
      have Blift : ∀ (G' : Λ ⥤ Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) (p : ℕ)
          (z : Abelian.Ext (wcZSh T) (Limits.colimit G') p),
          ∃ (i : Λ) (y : Abelian.Ext (wcZSh T) (G'.obj i) p),
            y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G' i)) (add_zero p) = z :=
        wc_ext_filtered_colim_lift _ Λ H0 Hemb
      intro p x
      obtain ⟨i, y, hy⟩ := Blift G p (x.comp (Abelian.Ext.mk₀ E.inv) (add_zero p))
      refine ⟨i, y, ?_⟩
      calc y.comp (Abelian.Ext.mk₀ (c.ι.app i)) (add_zero p)
          = y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G i ≫ E.hom)) (add_zero p) := by rw [hE]
        _ = (y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G i)) (add_zero p)).comp
              (Abelian.Ext.mk₀ E.hom) (add_zero p) := (cc _ _ _).symm
        _ = (x.comp (Abelian.Ext.mk₀ E.inv) (add_zero p)).comp
              (Abelian.Ext.mk₀ E.hom) (add_zero p) := by rw [hy]
        _ = x := by rw [cc, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]

  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  have toExt : ∀ (G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (p : ℕ),
      Subsingleton (wcEtExt X G p) ↔
        Subsingleton (Abelian.Ext (wcZSh X) G p) := fun _ _ => Iff.rfl
  have ccX : ∀ {A B C' : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}} {p : ℕ}
      (v : Abelian.Ext (wcZSh X) A p) (f : A ⟶ B) (g : B ⟶ C'),
      (v.comp (Abelian.Ext.mk₀ f) (add_zero p)).comp (Abelian.Ext.mk₀ g) (add_zero p) =
        v.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero p) := by
    intro A B C' p v f g
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]

  have hIso : ∀ (F G : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}),
      (F ≅ G) → wcHalAcyc L e F n → wcHalAcyc L e G n := by
    intro F G i h
    refine ⟨fun ψ => ?_, fun p h1 h2 => ?_⟩
    · obtain ⟨φ', hφ', huniq⟩ := h.1 (ψ ≫ L.map i.inv)
      have hφ'' : e.inv ≫ L.map φ' = ψ ≫ L.map i.inv := hφ'
      refine ⟨φ' ≫ i.hom, ?_, fun φ₁ hφ₁ => ?_⟩
      · show e.inv ≫ L.map (φ' ≫ i.hom) = ψ
        rw [L.map_comp, ← Category.assoc, hφ'', Category.assoc, ← L.map_comp, Iso.inv_hom_id,
          L.map_id, Category.comp_id]
      · have hφ₁' : e.inv ≫ L.map φ₁ = ψ := hφ₁
        have : φ₁ ≫ i.inv = φ' := huniq _ (by
          show e.inv ≫ L.map (φ₁ ≫ i.inv) = ψ ≫ L.map i.inv
          rw [L.map_comp, ← Category.assoc, hφ₁'])
        rw [← this, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    · haveI := (toExt _ p).1 (h.2 p h1 h2)
      apply (toExt _ p).2
      have hinj : Function.Injective (fun x : Abelian.Ext (wcZSh X) (L.obj G) p =>
          x.comp (Abelian.Ext.mk₀ (L.map i.inv)) (add_zero p)) := by
        intro a b hab
        have hab' := congrArg (fun z => z.comp (Abelian.Ext.mk₀ (L.map i.hom)) (add_zero p)) hab
        simp only [ccX, ← L.map_comp, Iso.inv_hom_id, L.map_id, Abelian.Ext.comp_mk₀_id] at hab'
        exact hab'
      exact hinj.subsingleton

  have hBip : ∀ (k : ℕ) (F : Fin k → Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}),
      (∀ i, wcHalAcyc L e (F i) n) → wcHalAcyc L e (⨁ F) n := by
    intro k F hF
    refine ⟨fun ψ => ?_, fun p h1 h2 => ?_⟩
    · have hex : ∀ j, ∃ φj : wcZSh (Spec (.of A)) ⟶ F j,
          e.inv ≫ L.map φj = ψ ≫ L.map (Limits.biproduct.π F j) :=
        fun j => ((hF j).1 _).exists
      choose φj hφj using hex
      refine ⟨Limits.biproduct.lift φj, ?_, fun φ' hφ' => ?_⟩
      · show e.inv ≫ L.map (Limits.biproduct.lift φj) = ψ
        rw [Limits.biproduct.lift_eq, L.map_sum, Preadditive.comp_sum]
        conv_rhs => rw [← Category.comp_id ψ, ← L.map_id, ← Limits.biproduct.total, L.map_sum,
          Preadditive.comp_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [L.map_comp, L.map_comp, ← Category.assoc, hφj, Category.assoc]
      · have hφ'' : e.inv ≫ L.map φ' = ψ := hφ'
        apply Limits.biproduct.hom_ext
        intro j
        rw [Limits.biproduct.lift_π]
        apply ((hF j).1 (ψ ≫ L.map (Limits.biproduct.π F j))).unique
        · show e.inv ≫ L.map (φ' ≫ Limits.biproduct.π F j) = ψ ≫ L.map (Limits.biproduct.π F j)
          rw [L.map_comp, ← Category.assoc, hφ'']
        · exact hφj j
    · apply (toExt _ p).2
      have hz : ∀ x : Abelian.Ext (wcZSh X) (L.obj (⨁ F)) p, x = 0 := by
        intro x
        have hj : ∀ j, x.comp (Abelian.Ext.mk₀ (L.map (Limits.biproduct.π F j))) (add_zero p) = 0 := by
          intro j
          haveI := (toExt _ p).1 ((hF j).2 p h1 h2)
          exact Subsingleton.elim _ _
        calc x = x.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero p) := (Abelian.Ext.comp_mk₀_id x).symm
          _ = x.comp (Abelian.Ext.mk₀ (L.map (∑ j, Limits.biproduct.π F j ≫
                Limits.biproduct.ι F j))) (add_zero p) := by rw [Limits.biproduct.total, L.map_id]
          _ = ∑ j, (x.comp (Abelian.Ext.mk₀ (L.map (Limits.biproduct.π F j))) (add_zero p)).comp
                (Abelian.Ext.mk₀ (L.map (Limits.biproduct.ι F j))) (add_zero p) := by
              rw [L.map_sum, Abelian.Ext.mk₀_sum, Abelian.Ext.comp_sum]
              refine Finset.sum_congr rfl (fun j _ => ?_)
              rw [ccX, L.map_comp]
          _ = 0 := by simp only [hj, Abelian.Ext.zero_comp, Finset.sum_const_zero]
      exact ⟨fun a b => by rw [hz a, hz b]⟩

  have hCol : ∀ (J : Type (u+1)) [SmallCategory J] [IsFiltered J]
      (D : J ⥤ Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1})
      (c : Limits.Cocone D), Limits.IsColimit c → (∀ j, wcHalAcyc L e (D.obj j) n) →
      wcHalAcyc L e c.pt n := by
    intro J _ _ D c hc hD
    haveI : Limits.PreservesColimitsOfSize.{u+1, u+1} L := adj.leftAdjoint_preservesColimits
    have hc' : Limits.IsColimit (L.mapCocone c) := Limits.isColimitOfPreserves L hc
    obtain ⟨hXa, hXb, hXc⟩ := AFF X J (D ⋙ L) (L.mapCocone c) hc'
    obtain ⟨hYa, -, -⟩ := AFF (Spec (.of A)) J D c hc
    refine ⟨fun ψ => ?_, fun p h1 h2 => ?_⟩
    · obtain ⟨i, y, hy⟩ := hXa ψ
      obtain ⟨φi, hφi, -⟩ := (hD i).1 y
      have hφi' : e.inv ≫ L.map φi = y := hφi
      let φ₀ : wcZSh (Spec (.of A)) ⟶ c.pt := φi ≫ c.ι.app i
      have hφ₂ : e.inv ≫ L.map φ₀ = ψ := by
        show e.inv ≫ L.map (φi ≫ c.ι.app i) = ψ
        rw [L.map_comp, ← Category.assoc, hφi']
        exact hy
      refine ⟨φ₀, hφ₂, fun φ₁ hφ₁ => ?_⟩
      have hφ₁' : e.inv ≫ L.map φ₁ = ψ := hφ₁
      rw [← sub_eq_zero]
      have hLδ : e.inv ≫ L.map (φ₁ - φ₀) = 0 := by
        rw [L.map_sub, Preadditive.comp_sub, hφ₁', hφ₂, sub_self]
      obtain ⟨i', χ, hχ⟩ := hYa (φ₁ - φ₀)
      have h0 : (e.inv ≫ L.map χ) ≫ (L.mapCocone c).ι.app i' = 0 := by
        rw [Functor.mapCocone_ι_app, Category.assoc, ← L.map_comp, hχ, hLδ]
      obtain ⟨j, f, hf⟩ := hXb i' (e.inv ≫ L.map χ) h0
      have hf' : e.inv ≫ L.map (χ ≫ D.map f) = e.inv ≫ L.map 0 := by
        rw [L.map_comp, ← Category.assoc, L.map_zero, Limits.comp_zero]
        exact hf
      have hz : χ ≫ D.map f = 0 := ((hD j).1 (e.inv ≫ L.map 0)).unique hf' rfl
      rw [← hχ, ← c.w f, ← Category.assoc, hz, Limits.zero_comp]
    · apply (toExt _ p).2
      have hz : ∀ x : Abelian.Ext (wcZSh X) (L.obj c.pt) p, x = 0 := by
        intro x
        obtain ⟨i, y, hy⟩ := hXc p x
        have hy0 : y = 0 := @Subsingleton.elim _ ((toExt _ p).1 ((hD i).2 p h1 h2)) y 0
        rw [← hy, hy0, Abelian.Ext.zero_comp]
      exact ⟨fun a b => by rw [hz a, hz b]⟩
  exact ⟨hCol, hIso, hBip⟩

theorem wc_gacyc_of_good_embeddings : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {X : Scheme.{u}} (g : X ⟶ Spec (.of A)) (ℓ : ℕ) (L : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush g) → Limits.PreservesFiniteLimits L → ∀ (e : L.obj (wcZSh (Spec (.of A))) ≅ wcZSh X), (∀ F : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}, ℓ • 𝟙 F = 0 → ∃ (G : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}) (u : F ⟶ G), ℓ • 𝟙 G = 0 ∧ (∀ n, wcHalAcyc L e G n) ∧ (∀ n, wcHalAcyc L e (Limits.kernel u) n)) → ∀ F : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}, ℓ • 𝟙 F = 0 → ∀ n, wcHalAcyc L e F n :=
by
  intro A _ _ _ X g ℓ L hadj hL e hgood
  classical
  obtain ⟨adj⟩ := hadj
  haveI := hL
  haveI : L.Additive := adj.left_adjoint_additive
  haveI : Limits.PreservesColimitsOfSize.{0, 0} L := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits L := Limits.PreservesColimitsOfSize.preservesFiniteColimits L
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  have H1 : ∀ (F' : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1})
      (y : Abelian.Ext (wcZSh (Spec (.of A))) F' 1), y = 0 :=
    fun F' y => @Subsingleton.elim (Abelian.Ext (wcZSh (Spec (.of A))) F' 1)
      (wc_et_strictly_local_ext_vanishing A F' 0) y 0
  have extZ : ∀ (G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (p : ℕ),
      Subsingleton (wcEtExt X G p) →
      ∀ y : Abelian.Ext (wcZSh X) G p, y = 0 :=
    fun G p h y => @Subsingleton.elim (Abelian.Ext (wcZSh X) G p) h y 0
  have mkSub : ∀ (G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (p : ℕ),
      (∀ y : Abelian.Ext (wcZSh X) G p, y = 0) →
      Subsingleton (wcEtExt X G p) :=
    fun G p h => ⟨fun a b => (h a).trans (h b).symm⟩
  have LF : ∀ (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1})),
      S.ShortExact → ∀ φ₃ : wcZSh (Spec (.of A)) ⟶ S.X₃,
      ∃ φ₂ : wcZSh (Spec (.of A)) ⟶ S.X₂, φ₂ ≫ S.g = φ₃ := by
    intro S hS φ₃
    have h0 : (Abelian.Ext.mk₀ φ₃).comp hS.extClass (zero_add 1) = 0 := H1 _ _
    obtain ⟨x₂, hx₂⟩ :=
      Abelian.Ext.covariant_sequence_exact₃ (wcZSh (Spec (.of A))) hS (Abelian.Ext.mk₀ φ₃) (zero_add 1) h0
    obtain ⟨φ₂, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x₂
    refine ⟨φ₂, (Abelian.Ext.mk₀_bijective _ _).1 ?_⟩
    rw [← Abelian.Ext.mk₀_comp_mk₀]
    exact hx₂
  have inj0_of : ∀ (F : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}),
      (∀ ψ : wcZSh X ⟶ L.obj F, ∃! φ : wcZSh (Spec (.of A)) ⟶ F, e.inv ≫ L.map φ = ψ) →
      ∀ φ : wcZSh (Spec (.of A)) ⟶ F, e.inv ≫ L.map φ = 0 → φ = 0 := by
    intro F h φ hφ
    exact (h 0).unique hφ (by rw [Functor.map_zero, Limits.comp_zero])
  have uniq_of : ∀ (F : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}),
      (∀ φ : wcZSh (Spec (.of A)) ⟶ F, e.inv ≫ L.map φ = 0 → φ = 0) →
      ∀ φ φ' : wcZSh (Spec (.of A)) ⟶ F, e.inv ≫ L.map φ = e.inv ≫ L.map φ' → φ = φ' := by
    intro F h φ φ' hφ
    rw [← sub_eq_zero]
    apply h
    rw [Functor.map_sub, Preadditive.comp_sub, hφ, sub_self]
  have ses_sub : ∀ (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1})),
      S.ShortExact → (∀ φ : wcZSh (Spec (.of A)) ⟶ S.X₃, e.inv ≫ L.map φ = 0 → φ = 0) →
      ∀ n : ℕ, wcHalAcyc L e S.X₂ n → (∀ m : ℕ, m + 1 = n → wcHalAcyc L e S.X₃ m) →
      wcHalAcyc L e S.X₁ n := by
    intro S hS hinj3 n h2 h3
    have hLS := hS.map_of_exact L
    haveI := hS.mono_f
    haveI : Mono (L.map S.f) := hLS.mono_f
    have hfg : L.map S.f ≫ L.map S.g = 0 := by
      rw [← L.map_comp, S.zero, Functor.map_zero]
    have inj2 := inj0_of _ h2.1
    have inj1 : ∀ φ : wcZSh (Spec (.of A)) ⟶ S.X₁, e.inv ≫ L.map φ = 0 → φ = 0 := by
      intro φ hφ
      have h' : φ ≫ S.f = 0 :=
        inj2 _ (by rw [L.map_comp, ← Category.assoc, hφ, Limits.zero_comp])
      rw [← cancel_mono S.f, h', Limits.zero_comp]
    refine ⟨fun ψ => ?_, fun p hp1 hpn => ?_⟩
    · obtain ⟨φ₂, hφ₂, -⟩ := h2.1 (ψ ≫ L.map S.f)
      have hq : φ₂ ≫ S.g = 0 :=
        hinj3 _ (by rw [L.map_comp, ← Category.assoc, hφ₂, Category.assoc, hfg, Limits.comp_zero])
      obtain ⟨φ, hφ⟩ := hS.exact.lift' φ₂ hq
      have hφψ : e.inv ≫ L.map φ = ψ := by
        rw [← cancel_mono (L.map S.f), Category.assoc, ← L.map_comp, hφ, hφ₂]
      exact ⟨φ, hφψ, fun φ' hφ' => uniq_of _ inj1 _ _ (hφ'.trans hφψ.symm)⟩
    · apply mkSub
      intro y
      have hy2 : y.comp (Abelian.Ext.mk₀ (S.map L).f) (add_zero p) = 0 :=
        extZ _ _ (h2.2 p hp1 hpn) _
      obtain ⟨m', rfl⟩ : ∃ m', p = m' + 1 := ⟨p - 1, by omega⟩
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ (wcZSh X) hLS y hy2 rfl
      rw [← hx₃]
      obtain ⟨m, hm⟩ : ∃ m, m + 1 = n := ⟨n - 1, by omega⟩
      have H3 := h3 m hm
      rcases Nat.eq_zero_or_pos m' with h0 | hpos
      · subst h0
        obtain ⟨ψ₃, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x₃
        obtain ⟨φ₃, hφ₃, -⟩ := H3.1 ψ₃
        obtain ⟨φ₂, hφ₂⟩ := LF S hS φ₃
        have hψ : ψ₃ = (e.inv ≫ L.map φ₂) ≫ (S.map L).g := by
          change ψ₃ = (e.inv ≫ L.map φ₂) ≫ L.map S.g
          rw [Category.assoc, ← L.map_comp, hφ₂, hφ₃]
        rw [hψ, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero,
          hLS.comp_extClass, Abelian.Ext.comp_zero]
      · rw [extZ _ _ (H3.2 m' hpos (by omega)) x₃, Abelian.Ext.zero_comp]
  have ses_mid : ∀ (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1})),
      S.ShortExact → ∀ n : ℕ, wcHalAcyc L e S.X₁ n → wcHalAcyc L e S.X₃ n →
      wcHalAcyc L e S.X₂ n := by
    intro S hS n h1 h3
    have hLS := hS.map_of_exact L
    haveI := hS.mono_f
    haveI : Mono (L.map S.f) := hLS.mono_f
    haveI : Mono (S.map L).f := hLS.mono_f
    have inj1 := inj0_of _ h1.1
    have inj3 := inj0_of _ h3.1
    have inj2 : ∀ φ : wcZSh (Spec (.of A)) ⟶ S.X₂, e.inv ≫ L.map φ = 0 → φ = 0 := by
      intro δ hδ
      have hq : δ ≫ S.g = 0 :=
        inj3 _ (by rw [L.map_comp, ← Category.assoc, hδ, Limits.zero_comp])
      obtain ⟨κ, hκ⟩ := hS.exact.lift' δ hq
      have hκ0 : e.inv ≫ L.map κ = 0 := by
        rw [← cancel_mono (L.map S.f), Category.assoc, ← L.map_comp, hκ, hδ, Limits.zero_comp]
      rw [← hκ, inj1 κ hκ0, Limits.zero_comp]
    refine ⟨fun ψ => ?_, fun p hp1 hpn => ?_⟩
    · obtain ⟨φ₃, hφ₃, -⟩ := h3.1 (ψ ≫ L.map S.g)
      obtain ⟨φ₂', hφ₂'⟩ := LF S hS φ₃
      have hχ : (ψ - e.inv ≫ L.map φ₂') ≫ (S.map L).g = 0 := by
        change (ψ - e.inv ≫ L.map φ₂') ≫ L.map S.g = 0
        rw [Preadditive.sub_comp, Category.assoc, ← L.map_comp, hφ₂', hφ₃, sub_self]
      obtain ⟨χ, hχ'⟩ := hLS.exact.lift' _ hχ
      obtain ⟨φ₁, hφ₁, -⟩ := h1.1 χ
      have hφψ : e.inv ≫ L.map (φ₂' + φ₁ ≫ S.f) = ψ := by
        rw [Functor.map_add, Preadditive.comp_add, L.map_comp, ← Category.assoc, hφ₁]
        have hχ'' : χ ≫ L.map S.f = ψ - e.inv ≫ L.map φ₂' := hχ'
        rw [hχ'']
        abel
      exact ⟨_, hφψ, fun φ' hφ' => uniq_of _ inj2 _ _ (hφ'.trans hφψ.symm)⟩
    · apply mkSub
      intro y
      have hy3 : y.comp (Abelian.Ext.mk₀ (S.map L).g) (add_zero p) = 0 :=
        extZ _ _ (h3.2 p hp1 hpn) _
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ (wcZSh X) hLS y hy3
      rw [← hx₁, extZ _ _ (h1.2 p hp1 hpn) x₁, Abelian.Ext.zero_comp]
  have inj0_good : ∀ {F G : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}}
      (u : F ⟶ G), wcHalAcyc L e G 0 → wcHalAcyc L e (Limits.kernel u) 0 →
      ∀ φ : wcZSh (Spec (.of A)) ⟶ F, e.inv ≫ L.map φ = 0 → φ = 0 := by
    intro F G u hG hK φ hφ
    have hu : φ ≫ u = 0 :=
      inj0_of _ hG.1 _ (by rw [L.map_comp, ← Category.assoc, hφ, Limits.zero_comp])
    haveI : Mono (L.map (Limits.kernel.ι u)) := inferInstance
    have hy : Limits.kernel.lift u φ hu = 0 := inj0_of _ hK.1 _ (by
      rw [← cancel_mono (L.map (Limits.kernel.ι u)), Category.assoc, ← L.map_comp,
        Limits.kernel.lift_ι, hφ, Limits.zero_comp])
    rw [← Limits.kernel.lift_ι u φ hu, hy, Limits.zero_comp]
  have tors_coker : ∀ {F G : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}}
      (u : F ⟶ G), ℓ • 𝟙 G = 0 → ℓ • 𝟙 (Limits.cokernel u) = 0 := by
    intro F G u hG
    rw [← cancel_epi (Limits.cokernel.π u), Preadditive.comp_nsmul, Category.comp_id,
      Limits.comp_zero]
    calc ℓ • Limits.cokernel.π u = (ℓ • 𝟙 G) ≫ Limits.cokernel.π u := by
          rw [Preadditive.nsmul_comp, Category.id_comp]
      _ = 0 := by rw [hG, Limits.zero_comp]
  have hinj : ∀ F : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1},
      ℓ • 𝟙 F = 0 → ∀ φ : wcZSh (Spec (.of A)) ⟶ F, e.inv ≫ L.map φ = 0 → φ = 0 := by
    intro F hF
    obtain ⟨G, u, -, hG, hK⟩ := hgood F hF
    exact inj0_good u (hG 0) (hK 0)
  have step : ∀ n : ℕ, (∀ m : ℕ, m + 1 = n →
      ∀ F : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1},
        ℓ • 𝟙 F = 0 → wcHalAcyc L e F m) →
      ∀ F : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1},
        ℓ • 𝟙 F = 0 → wcHalAcyc L e F n := by
    intro n ih F hF
    obtain ⟨G, u, hGt, hG, hK⟩ := hgood F hF
    have hQ := tors_coker u hGt
    have hS₂ : (ShortComplex.mk (Limits.kernel.ι (Limits.cokernel.π u)) (Limits.cokernel.π u)
        (Limits.kernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk'
        (ShortComplex.exact_of_f_is_kernel _ (Limits.kernelIsKernel (Limits.cokernel.π u)))
        (show Mono (Limits.kernel.ι (Limits.cokernel.π u)) from inferInstance)
        (show Epi (Limits.cokernel.π u) from inferInstance)
    have w : Limits.kernel.ι u ≫ Limits.kernel.lift (Limits.cokernel.π u) u
        (Limits.cokernel.condition u) = 0 := by
      rw [← cancel_mono (Limits.kernel.ι (Limits.cokernel.π u)), Category.assoc,
        Limits.kernel.lift_ι, Limits.kernel.condition, Limits.zero_comp]
    have hS₁ : (ShortComplex.mk (Limits.kernel.ι u) (Limits.kernel.lift (Limits.cokernel.π u) u
        (Limits.cokernel.condition u)) w).ShortExact :=
      ShortComplex.ShortExact.mk'
        (ShortComplex.exact_of_f_is_kernel _
          (Limits.isKernelOfComp (Limits.kernel.ι (Limits.cokernel.π u)) u
            (Limits.kernelIsKernel u) w (Limits.kernel.lift_ι _ _ _)))
        (show Mono (Limits.kernel.ι u) from inferInstance)
        (show Epi (Limits.kernel.lift (Limits.cokernel.π u) u (Limits.cokernel.condition u)) from
          inferInstance)
    have hI : wcHalAcyc L e (Limits.kernel (Limits.cokernel.π u)) n :=
      ses_sub _ hS₂ (hinj _ hQ) n (hG n) (fun m hm => ih m hm _ hQ)
    exact ses_mid _ hS₁ n (hK n) hI
  have main : ∀ n : ℕ, ∀ F : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1},
      ℓ • 𝟙 F = 0 → wcHalAcyc L e F n := by
    intro n
    induction n with
    | zero => exact step 0 (fun m hm => absurd hm (Nat.succ_ne_zero m))
    | succ n ih =>
      exact step (n + 1) (fun m hm => by
        obtain rfl : m = n := by omega
        exact ih)
  intro F hF n
  exact main n F hF

theorem wc_gacyc_closed_push : ∀ {X : Scheme.{u}} (A : Type u) [CommRing A] (g : X ⟶ Spec (.of A)) (L : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush g) → Limits.PreservesFiniteLimits L → ∀ (e : L.obj (wcZSh (Spec (.of A))) ≅ wcZSh X) (A' : Type u) [CommRing A'] (φ : A →+* A'), Function.Surjective φ → ∀ {X' : Scheme.{u}} (g' : X' ⟶ Spec (.of A')) (i' : X' ⟶ X), IsPullback i' g' g (Spec.map (CommRingCat.ofHom φ)) → ∀ (E : Sheaf (Scheme.smallEtaleTopology (Spec (.of A'))) AddCommGrpCat.{u+1}), (Subsingleton A' ∨ ∀ (L' : Sheaf (Scheme.smallEtaleTopology (Spec (.of A'))) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}), Nonempty (L' ⊣ wcEtPush g') → Limits.PreservesFiniteLimits L' → ∀ (e' : L'.obj (wcZSh (Spec (.of A'))) ≅ wcZSh X') (n : ℕ), wcHalAcyc L' e' E n) → ∀ n, wcHalAcyc L e ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E) n :=
by
  intro X A _ g L hadj _ e A' _ φ hφ X' g' i' hsq E hyp n
  classical
  obtain ⟨adj⟩ := hadj
  haveI hiC : IsClosedImmersion (Spec.map (CommRingCat.ofHom φ)) :=
    IsClosedImmersion.spec_of_surjective _ hφ
  haveI : L.IsLeftAdjoint := adj.isLeftAdjoint
  haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint L
  obtain ⟨Li, ⟨adji⟩, -, ⟨ei⟩⟩ := wc_et_push_left_adjoint (Spec.map (CommRingCat.ofHom φ))
  haveI : (wcEtPush (Spec.map (CommRingCat.ofHom φ))).IsRightAdjoint := adji.isRightAdjoint
  haveI : (wcEtPush (Spec.map (CommRingCat.ofHom φ))).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isRightAdjoint _
  have tr : ∀ {Y : Scheme.{u}} {M N : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}},
      (M ≅ N) → ∀ q : ℕ, Nonempty (wcEtExt Y M q ≃ wcEtExt Y N q) := by
    intro Y M N f q
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    let E' : Abelian.Ext (wcZSh Y) M q ≃ Abelian.Ext (wcZSh Y) N q :=
      { toFun := fun x => x.comp (Abelian.Ext.mk₀ f.hom) (add_zero q)
        invFun := fun y => y.comp (Abelian.Ext.mk₀ f.inv) (add_zero q)
        left_inv := fun x => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
        right_inv := fun y => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }
    exact ⟨E'⟩
  rcases hyp with hsub | hyp
  · haveI : IsEmpty ↥(Spec (.of A')) := PrimeSpectrum.isEmpty_iff_subsingleton.mpr hsub
    have hE0 : Limits.IsZero E := wc_et_sheaf_isZero_of_isEmpty _ inferInstance E
    have hF0 : Limits.IsZero ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E) :=
      Functor.map_isZero _ hE0
    have hLF0 : Limits.IsZero (L.obj ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E)) :=
      Functor.map_isZero L hF0
    refine ⟨fun ψ => ⟨0, hLF0.eq_of_tgt _ _, fun φ' _ => hF0.eq_of_tgt _ _⟩, fun p _ _ => ?_⟩
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    have key : ∀ z : Abelian.Ext (wcZSh X)
        (L.obj ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E)) p, z = 0 := by
      intro z
      calc z = z.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero p) := (Abelian.Ext.comp_mk₀_id z).symm
        _ = z.comp (Abelian.Ext.mk₀ 0) (add_zero p) := by rw [hLF0.eq_of_src (𝟙 _) 0]
        _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    exact ⟨fun x y => (key x).trans (key y).symm⟩
  · obtain ⟨L', ⟨adj'⟩, hL', ⟨e'⟩⟩ := wc_et_push_left_adjoint g'
    have hE : ∀ m, wcHalAcyc L' e' E m := fun m => hyp L' ⟨adj'⟩ hL' e' m
    have h4 : ∀ {Y X : Scheme.{u}}
        (L₀ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⥤
          Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
        (G₀ : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⥤
          Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
        (adj₀ : L₀ ⊣ G₀) (OC : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
        (OD : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (e₀ : L₀.obj OC ≅ OD)
        (F₀ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
        (∀ ψ : OD ⟶ L₀.obj F₀, ∃! φ₀ : OC ⟶ F₀, e₀.inv ≫ L₀.map φ₀ = ψ) ↔
          Function.Bijective (fun φ₀ : OC ⟶ F₀ => φ₀ ≫ adj₀.unit.app F₀) := by
      intro Y X L₀ G₀ adj₀ OC OD e₀ F₀
      have hfac : ∀ φ₀ : OC ⟶ F₀, e₀.inv ≫ L₀.map φ₀ =
          e₀.inv ≫ (adj₀.homEquiv OC (L₀.obj F₀)).symm (φ₀ ≫ adj₀.unit.app F₀) := by
        intro φ₀
        rw [Adjunction.homEquiv_counit, Functor.map_comp, Category.assoc,
          adj₀.left_triangle_components, Category.comp_id]
      have hM : (fun φ₀ : OC ⟶ F₀ => e₀.inv ≫ L₀.map φ₀) =
          (fun χ : L₀.obj OC ⟶ L₀.obj F₀ => e₀.inv ≫ χ) ∘
            ((adj₀.homEquiv OC (L₀.obj F₀)).symm ∘ (fun φ₀ : OC ⟶ F₀ => φ₀ ≫ adj₀.unit.app F₀)) := by
        funext φ₀
        exact hfac φ₀
      have hb1 : Function.Bijective (fun χ : L₀.obj OC ⟶ L₀.obj F₀ => e₀.inv ≫ χ) := by
        refine ⟨fun a b h => ?_, fun c => ⟨e₀.hom ≫ c, by simp⟩⟩
        simpa using congrArg (fun t => e₀.hom ≫ t) h
      refine (Function.bijective_iff_existsUnique
        (fun φ₀ : OC ⟶ F₀ => e₀.inv ≫ L₀.map φ₀)).symm.trans ?_
      rw [hM, Function.Bijective.of_comp_iff' hb1,
        Function.Bijective.of_comp_iff' (Equiv.bijective _)]
    have hi'C : IsClosedImmersion i' :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq.flip hiC
    have hrange : Set.range i' = g ⁻¹' Set.range (Spec.map (CommRingCat.ofHom φ)) := by
      have hfac : hsq.isoPullback.hom ≫
          Limits.pullback.fst g (Spec.map (CommRingCat.ofHom φ)) = i' :=
        hsq.isoPullback_hom_fst
      rw [← Scheme.Pullback.range_fst, ← hfac]
      ext x
      constructor
      · rintro ⟨y, rfl⟩
        exact ⟨hsq.isoPullback.hom y, by rw [Scheme.Hom.comp_apply]⟩
      · rintro ⟨z, rfl⟩
        refine ⟨hsq.isoPullback.inv z, ?_⟩
        rw [Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply hsq.isoPullback.inv hsq.isoPullback.hom,
          Iso.inv_hom_id]
        rfl
    haveI := hi'C
    haveI : IsFinite i' := inferInstance
    obtain ⟨Li', ⟨adji'⟩, -, -⟩ := wc_et_push_left_adjoint i'
    have hcounit : IsIso adji.counit :=
      (wc_et_closed_push_adj_isos (Spec.map (CommRingCat.ofHom φ)) Li adji).1
    haveI := hcounit
    have hunit : IsIso (adji'.unit.app
        (L.obj ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E))) := by
      apply (wc_et_closed_push_adj_isos i' Li' adji').2
      intro V t v hv
      rw [hrange] at hv
      exact wc_et_left_adjoint_closed_push_vanish_off g
        (Spec.map (CommRingCat.ofHom φ)) L ⟨adj⟩ E V t v hv
    haveI := hunit
    let ν : wcEtPush i' ⋙ wcEtPush g ≅
        wcEtPush g' ⋙ wcEtPush (Spec.map (CommRingCat.ofHom φ)) :=
      Classical.choice (wc_et_push_id_comp_iso i' g).2 ≪≫
        eqToIso (congrArg (fun f => wcEtPush f) hsq.w) ≪≫
        (Classical.choice (wc_et_push_id_comp_iso g' (Spec.map (CommRingCat.ofHom φ))).2).symm
    let α : L ⋙ Li' ≅ Li ⋙ L' :=
      (adj.comp adji').leftAdjointUniq ((adji.comp adj').ofNatIsoRight ν.symm)
    have hbijE : Function.Bijective (fun ψ : wcZSh (Spec (.of A')) ⟶ E => ψ ≫ adj'.unit.app E) :=
      (h4 L' _ adj' _ _ e' E).1 (hE 0).1
    have hbijF := wc_adj_closed_bc_h0_transfer L (wcEtPush g) adj Li
      (wcEtPush (Spec.map (CommRingCat.ofHom φ))) adji L'
      (wcEtPush g') adj' Li' (wcEtPush i') adji'
      ν hcounit (wcZSh (Spec (.of A))) (wcZSh (Spec (.of A'))) ei E hunit hbijE
    refine ⟨(h4 L (wcEtPush g) adj _ _ e _).2 hbijF, ?_⟩
    intro p hp1 hpn
    haveI hsub : Subsingleton (wcEtExt X' (L'.obj E) p) := (hE n).2 p hp1 hpn
    obtain ⟨T1⟩ := tr (M := L.obj ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E))
      (N := (wcEtPush i').obj (Li'.obj (L.obj ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E))))
      (asIso (adji'.unit.app (L.obj ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E)))) p
    obtain ⟨T2⟩ := wc_et_finite_push_ext_equiv i'
      (Li'.obj (L.obj ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E))) p
    obtain ⟨T3⟩ := tr (M := Li'.obj (L.obj ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E)))
