  have sq := IsPullback.of_bot outer (Limits.pullback.lift_fst _ _ w).symm
    (IsPullback.of_hasPullback (wcHalA1Proj (c ≫ sA)) z)

  haveI : IsAffineHom (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) :=
