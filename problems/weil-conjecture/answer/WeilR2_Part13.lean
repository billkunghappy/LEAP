  have key : ∀ (J : Ideal C) (C' : Type u) [CommRing C'] [Nontrivial C'] (φ : C →+* C'),
      Function.Surjective φ → RingHom.ker φ = J →
      ∀ (L' : Sheaf (Scheme.smallEtaleTopology (Spec (.of C'))) AddCommGrpCat.{u+1} ⥤
          Sheaf (Scheme.smallEtaleTopology (Limits.pullback f (Spec.map (CommRingCat.ofHom φ) ≫ c)))
            AddCommGrpCat.{u+1}),
        Nonempty (L' ⊣ wcEtPush (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom φ) ≫ c))) →
        Limits.PreservesFiniteLimits L' →
        ∀ (e' : L'.obj (wcZSh (Spec (.of C'))) ≅
            wcZSh (Limits.pullback f (Spec.map (CommRingCat.ofHom φ) ≫ c)))
          (F : Sheaf (Scheme.smallEtaleTopology (Spec (.of C'))) AddCommGrpCat.{u+1}),
          ℓ • 𝟙 F = 0 → ∀ n, wcHalAcyc L' e' F n := by
    intro J
    induction J using WellFoundedGT.induction
    rename_i J ih
    intro C' _ _ φ hφ hker L' hadj' hL' e'
    obtain ⟨hH, hS, hN⟩ := wc_quot_strictly_henselian C C' φ hφ
    letI := hH
    haveI := hS
    haveI := hN
    have IH : ∀ (I : Ideal C'), (∀ 𝔮 ∈ minimalPrimes C', ¬ I ≤ 𝔮) → Nontrivial (C' ⧸ I) →
        ∀ (L'' : Sheaf (Scheme.smallEtaleTopology (Spec (.of (C' ⧸ I)))) AddCommGrpCat.{u+1} ⥤
          Sheaf (Scheme.smallEtaleTopology (Limits.pullback f
            (Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk I).comp φ)) ≫ c))) AddCommGrpCat.{u+1}),
        Nonempty (L'' ⊣ wcEtPush (Limits.pullback.snd f
          (Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk I).comp φ)) ≫ c))) →
        Limits.PreservesFiniteLimits L'' →
        ∀ (e'' : L''.obj (wcZSh (Spec (.of (C' ⧸ I)))) ≅ wcZSh (Limits.pullback f
            (Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk I).comp φ)) ≫ c)))
          (E₀ : Sheaf (Scheme.smallEtaleTopology (Spec (.of (C' ⧸ I)))) AddCommGrpCat.{u+1}),
          ℓ • 𝟙 E₀ = 0 → ∀ n, wcHalAcyc L'' e'' E₀ n := by
      intro I hI hnt L'' hadj'' hL'' e'' E₀ hE₀ n
      haveI := hnt
      have hlt : J < I.comap φ := by
        rw [← hker]
        have h1 : RingHom.ker φ = (⊥ : Ideal C').comap φ := by
          ext x
          simp [RingHom.mem_ker]
        rw [h1]
        refine lt_of_le_of_ne (Ideal.comap_mono bot_le) ?_
        intro heq
        have hIb : I = ⊥ := (Ideal.comap_injective_of_surjective φ hφ heq).symm
        obtain ⟨𝔮, h𝔮, -⟩ :=
          Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal C') ≤ IsLocalRing.maximalIdeal C')
        exact hI 𝔮 h𝔮 (by rw [hIb]; exact bot_le)
      have hkerI : RingHom.ker ((Ideal.Quotient.mk I).comp φ) = I.comap φ := by
        ext x
        simp [RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem]
      exact ih (I.comap φ) hlt (C' ⧸ I) ((Ideal.Quotient.mk I).comp φ)
        (Ideal.Quotient.mk_surjective.comp hφ) hkerI L'' hadj'' hL'' e'' E₀ hE₀ n
    have hsurj : Surjective (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom φ) ≫ c)) :=
      SURJ _ (fun y => (H C' φ hφ (AlgebraicClosure ((Spec (.of C')).residueField y))
        (wcEtGeomPt (Spec (.of C')) y)).1.1)
    have hfin := minimalPrimes.finite_of_isNoetherianRing C'
    let Smin := hfin.toFinset
    let eqv : Fin Smin.card ≃ Smin := Smin.equivFin.symm
    let y : Fin Smin.card → Spec (.of C') := fun i =>
      (⟨(eqv i).1, Ideal.minimalPrimes_isPrime (hfin.mem_toFinset.mp (eqv i).2)⟩ : PrimeSpectrum C')
    intro F hF
    refine wc_gacyc_of_good_embeddings C' (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom φ) ≫ c))
      ℓ L' hadj' hL' e' ?_ F hF
    intro F₀ hF₀
    obtain ⟨M, uF, hM, hG, hstalk⟩ :=
      wc_et_geom_point_skyscraper_embed (Spec (.of C')) ℓ F₀ hF₀ Smin.card y
    refine ⟨_, uF, hG, ?_, ?_⟩
    · intro n
      apply (wc_gacyc_colim C' _ L' hadj' hL' e' n).2.2 Smin.card
      intro i
      obtain ⟨G1, G2, G3⟩ := H C' φ hφ (AlgebraicClosure ((Spec (.of C')).residueField (y i)))
        (wcEtGeomPt (Spec (.of C')) (y i))
      have h1 := wc_gacyc_geom_push_good ℓ hℓ C' _ hsurj L' hadj' hL' e'
        (AlgebraicClosure ((Spec (.of C')).residueField (y i))) (wcEtGeomPt (Spec (.of C')) (y i))
        G1 G2 G3
      exact wc_gacyc_geom_push_good_const ℓ hℓ C' _ L' hadj' hL' e'
        (AlgebraicClosure ((Spec (.of C')).residueField (y i))) (wcEtGeomPt (Spec (.of C')) (y i))
        h1 (M i) (hM i) n
    · have hKt : ℓ • 𝟙 (Limits.kernel uF) = 0 := by
        rw [← cancel_mono (Limits.kernel.ι uF), Limits.zero_comp, Preadditive.nsmul_comp,
          Category.id_comp]
        calc ℓ • Limits.kernel.ι uF = Limits.kernel.ι uF ≫ (ℓ • 𝟙 F₀) := by
              rw [Preadditive.comp_nsmul, Category.comp_id]
          _ = 0 := by rw [hF₀, Limits.comp_zero]
      have hgen : ∀ (𝔭 : PrimeSpectrum C'), 𝔭.asIdeal ∈ minimalPrimes C' →
          Subsingleton ((wcEtStalk (Spec (.of C')) 𝔭).obj (Limits.kernel uF)) := by
        intro 𝔭 h𝔭
        have hmem : 𝔭.asIdeal ∈ Smin := hfin.mem_toFinset.mpr h𝔭
        have hy : y (eqv.symm ⟨𝔭.asIdeal, hmem⟩) = 𝔭 := by
          apply PrimeSpectrum.ext
          show (eqv (eqv.symm ⟨𝔭.asIdeal, hmem⟩)).1 = 𝔭.asIdeal
          rw [Equiv.apply_symm_apply]
        have h2 := hstalk (eqv.symm ⟨𝔭.asIdeal, hmem⟩)
        rw [hy] at h2
        exact h2
      obtain ⟨J', instJ, instF, D, c₀, ⟨hc₀⟩, ⟨ec⟩, hD⟩ :=
        wc_et_generic_vanish_decomp C' ℓ (Limits.kernel uF) hKt hgen
      intro n
      have hDj : ∀ j, wcHalAcyc L' e' (D.obj j) n := by
        intro j
        obtain ⟨I, Ej, hI, hEj, ⟨eD⟩⟩ := hD j
        obtain ⟨i', hsq⟩ := BC C' (C' ⧸ I) φ (Ideal.Quotient.mk I)
        have h4 := wc_gacyc_closed_push C' _ L' hadj' hL' e' (C' ⧸ I) (Ideal.Quotient.mk I)
          Ideal.Quotient.mk_surjective _ i' hsq Ej (by
            by_cases hsub : Subsingleton (C' ⧸ I)
            · exact Or.inl hsub
            · right
              haveI : Nontrivial (C' ⧸ I) := not_subsingleton_iff_nontrivial.mp hsub
              intro L'' hadj'' hL'' e'' m
              exact IH I hI inferInstance L'' hadj'' hL'' e'' Ej hEj m) n
        exact (wc_gacyc_colim C' _ L' hadj' hL' e' n).2.1 _ _ eD.symm h4
      have hcpt := (wc_gacyc_colim C' _ L' hadj' hL' e' n).1 J' D c₀ hc₀ hDj
      exact (wc_gacyc_colim C' _ L' hadj' hL' e' n).2.1 _ _ ec hcpt

  have hc0 : Spec.map (CommRingCat.ofHom (RingHom.id C)) ≫ c = c := by
    rw [CommRingCat.ofHom_id, Spec.map_id, Category.id_comp]
  let ι : Limits.pullback f (Spec.map (CommRingCat.ofHom (RingHom.id C)) ≫ c) ≅
      Limits.pullback f c := Limits.pullback.congrHom rfl hc0
  obtain ⟨L, ⟨adj⟩, hL, ⟨e⟩⟩ :=
    wc_et_push_left_adjoint (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom (RingHom.id C)) ≫ c))
  obtain ⟨hE, hΛ⟩ := wc_et_pull_const_zmod
    (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom (RingHom.id C)) ≫ c)) L ⟨adj⟩ hL e ℓ
  have hker0 : RingHom.ker (RingHom.id C) = ⊥ := by
    ext x
    simp [RingHom.mem_ker]
  have hac := key ⊥ C (RingHom.id C) Function.surjective_id hker0 L ⟨adj⟩ hL e _ hΛ
  refine ⟨?_, fun q hq => ?_⟩
  · letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of C))) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology
        (Limits.pullback f (Spec.map (CommRingCat.ofHom (RingHom.id C)) ≫ c)))
        AddCommGrpCat.{u+1}) := HasExt.standard _
    haveI hconn : ConnectedSpace (Spec (.of C)) := by
      rw [connectedSpace_iff_clopen]
      refine ⟨⟨IsLocalRing.closedPoint C⟩, fun s hs => ?_⟩
      by_cases h : (IsLocalRing.closedPoint C : Spec (.of C)) ∈ s
      · right
        ext p
        simp only [Set.mem_univ, iff_true]
        exact (IsLocalRing.specializes_closedPoint (R := C) p).mem_open hs.2 h
      · left
        ext p
        simp only [Set.mem_empty_iff_false, iff_false]
        intro hp
        exact h ((IsLocalRing.specializes_closedPoint (R := C) p).mem_closed hs.1 hp)
    have hbij : Function.Bijective (fun φ0 : wcZSh (Spec (.of C)) ⟶
        (constantSheaf (Scheme.smallEtaleTopology (Spec (.of C))) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) => e.inv ≫ L.map φ0) :=
      (Function.bijective_iff_existsUnique _).2 (hac 0).1
    have hLc : Nat.card (wcZSh (Spec (.of C)) ⟶
        (constantSheaf (Scheme.smallEtaleTopology (Spec (.of C))) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) = ℓ := by
      have E0 : (wcZSh (Spec (.of C)) ⟶
          (constantSheaf (Scheme.smallEtaleTopology (Spec (.of C))) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) ≃
          Abelian.Ext (wcZSh (Spec (.of C)))
            ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of C))) AddCommGrpCat.{u+1}).obj
              (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) 0 := Abelian.Ext.homEquiv₀.symm
      rw [Nat.card_congr E0]
      exact wc_et_coh_zero_connected_card (Spec (.of C)) ℓ hℓ.ne_zero
    have hR : Nat.card (wcZSh (Limits.pullback f (Spec.map (CommRingCat.ofHom (RingHom.id C)) ≫ c)) ⟶
        L.obj ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of C))) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) = Nat.card (wcEtCoh (Limits.pullback f c) ℓ 0) := by
      obtain ⟨eq0⟩ := hE 0
      obtain ⟨E1⟩ := wc_et_coh_iso_invariance ι.hom ℓ 0
      have E0 : (wcZSh (Limits.pullback f (Spec.map (CommRingCat.ofHom (RingHom.id C)) ≫ c)) ⟶
          L.obj ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of C))) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) ≃
          Abelian.Ext (wcZSh (Limits.pullback f (Spec.map (CommRingCat.ofHom (RingHom.id C)) ≫ c)))
            (L.obj ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of C))) AddCommGrpCat.{u+1}).obj
              (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) 0 := Abelian.Ext.homEquiv₀.symm
      rw [Nat.card_congr E0]
      exact (Nat.card_congr (E1.trans eq0)).symm
    rw [← hR, ← Nat.card_congr (Equiv.ofBijective _ hbij)]
    exact hLc
  · obtain ⟨eq⟩ := hE q
    obtain ⟨E1⟩ := wc_et_coh_iso_invariance ι.hom ℓ q
    have h1 : Subsingleton (wcEtCoh
        (Limits.pullback f (Spec.map (CommRingCat.ofHom (RingHom.id C)) ≫ c)) ℓ q) :=
      @Equiv.subsingleton _ _ eq ((hac q).2 q hq le_rfl)
    exact @Equiv.subsingleton _ _ E1 h1

theorem wc_affine_line_shens_field_test_acyclic : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (sA : Spec (.of A) ⟶ Spec (.of K)) (x : Spec (.of (Polynomial A))), Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (Polynomial A))) x)) (Scheme.Etale.forget (Spec (.of (Polynomial A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (Polynomial A))), wcHalShData x B Λ W' φ a → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), Nat.card (wcEtCoh (Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) z) ℓ 0) = ℓ ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) z) ℓ q) :=
by
  intro K _ _ ℓ hℓ hℓK A _ _ _ sA x hx B _ _ _ Λ _ _ W' φ a hd Ω _ _ z
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero

  have c2 : ∀ (R S T : Type u) [CommRing R] [CommRing S] [CommRing T] [Algebra R S] [Algebra R T],
      IsDomain (TensorProduct R S T) →
      IrreducibleSpace ↥(Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap R S)))
        (Spec.map (CommRingCat.ofHom (algebraMap R T))) : Scheme.{u}) := by
    intro R S T _ _ _ _ _ hD
    have h1 : IrreducibleSpace (PrimeSpectrum (TensorProduct R S T)) := PrimeSpectrum.irreducibleSpace
    have h2 : IsIrreducible (⊤ : Set (Spec (CommRingCat.of (TensorProduct R S T)))) :=
      (irreducibleSpace_def _).mp h1
    have h3 := h2.image (Scheme.homeoOfIso (pullbackSpecIso R S T)).symm
      (Homeomorph.continuous _).continuousOn
    rw [Set.top_eq_univ, Set.image_univ, Homeomorph.range_coe] at h3
    exact (irreducibleSpace_def _).mpr h3

  have H0 : Nat.card (wcEtCoh (Limits.pullback
      (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) z) ℓ 0) = ℓ := by
    let pB : ↥(Spec (.of B)) := IsLocalRing.closedPoint B
    have c5 : a pB = x := by
      obtain ⟨-, -, -, -, -, e0, -, he0⟩ := hd
      obtain ⟨pt⟩ : Nonempty ↥(Spec (.of (AlgebraicClosure
          ((Spec (.of (Polynomial A))).residueField x)))) :=
        ⟨IsLocalRing.closedPoint _⟩
      have h := congrArg
        (fun f : Spec (.of (AlgebraicClosure ((Spec (.of (Polynomial A))).residueField x))) ⟶
          Spec (.of (Polynomial A)) => f pt) he0
      have h2 : (Spec.map (CommRingCat.ofHom e0) ≫
          Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) ≫ a) pt = a pB := by
        rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
        exact congrArg a (IsLocalRing.PrimeSpectrum.comap_residue B _)
      have h3 : (wcEtGeomPt (Spec (.of (Polynomial A))) x) pt = x := by
        rw [Scheme.Hom.comp_apply]
        exact Scheme.fromSpecResidueField_apply x _
      exact h2.symm.trans ((congrArg (fun y => y) h).trans h3)
    obtain ⟨β, hβ, hFEP⟩ :=
      wc_shdata_filtered_etale_presentation x B Λ W' φ a hd (Polynomial A) (Iso.refl _)
    have hα : Spec.map (CommRingCat.ofHom (β.comp Polynomial.C)) =
        a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) := by
      rw [CommRingCat.ofHom_comp, Spec.map_comp, hβ, Iso.refl_hom, Category.comp_id,
        Polynomial.algebraMap_eq]
    letI : Algebra A B := (β.comp Polynomial.C).toAlgebra
    haveI hloc : IsLocalHom (algebraMap A B) := by
      rw [IsLocalRing.isLocalHom_iff_comap_closedPoint]
      have h1 := congrArg (fun f : Spec (.of B) ⟶ Spec (.of A) => f pB) hα
      simp only at h1
      rw [Scheme.Hom.comp_apply, c5] at h1
      exact h1.trans hx
    let ζ : A →+* Ω := (Spec.preimage z).hom
    have hz : z = Spec.map (CommRingCat.ofHom ζ) := by
      simp only [ζ, CommRingCat.ofHom_hom, Spec.map_preimage]
    letI : Algebra A Ω := ζ.toAlgebra
    haveI hdom : IsDomain (TensorProduct A B Ω) :=
      wc_ring_milnor_fibre_isDomain A B Ω β rfl hFEP
    have hconn : ConnectedSpace ↥(Limits.pullback
        (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) z : Scheme.{u}) := by
      have key : ∀ (f : Spec (.of B) ⟶ Spec (.of A)) (g : Spec (.of Ω) ⟶ Spec (.of A)),
          f = Spec.map (CommRingCat.ofHom (algebraMap A B)) →
          g = Spec.map (CommRingCat.ofHom (algebraMap A Ω)) →
          ConnectedSpace ↥(Limits.pullback f g : Scheme.{u}) := by
        rintro f g rfl rfl
        haveI := c2 A B Ω hdom
        exact IrreducibleSpace.connectedSpace _
      exact key _ _ hα.symm hz
    exact wc_et_coh_zero_connected_card _ ℓ hℓ0
  refine ⟨H0, fun q hq => ?_⟩

  have c3 : ∀ (s' : Spec (.of A) ⟶ Spec (.of K)), ∃ e : wcHalA1 s' ≅ Spec (.of (Polynomial A)),
      e.hom ≫ Spec.map (CommRingCat.ofHom (Polynomial.C : A →+* Polynomial A)) = wcHalA1Proj s' := by
    intro s'
    obtain ⟨σ, rfl⟩ : ∃ σ : K →+* A, s' = Spec.map (CommRingCat.ofHom σ) :=
      ⟨(Spec.preimage s').hom, by rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
    letI : Algebra K A := σ.toAlgebra
    let ψ : CommRingCat.of (Polynomial A) ≅ CommRingCat.of (TensorProduct K A (Polynomial K)) :=
      (polyEquivTensor K A).toRingEquiv.toCommRingCatIso
    have hψ : CommRingCat.ofHom (Polynomial.C : A →+* Polynomial A) ≫ ψ.hom =
        CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
          A →+* TensorProduct K A (Polynomial K)) := by
      ext a
      change polyEquivTensor K A (Polynomial.C a) = a ⊗ₜ[K] (1 : Polynomial K)
      simp [polyEquivTensor_apply]
    refine ⟨pullbackSpecIso K A (Polynomial K) ≪≫ Scheme.Spec.mapIso ψ.op, ?_⟩
    rw [Iso.trans_hom, Category.assoc]
    change (pullbackSpecIso K A (Polynomial K)).hom ≫ Spec.map ψ.hom ≫
      Spec.map (CommRingCat.ofHom (Polynomial.C : A →+* Polynomial A)) = _
    rw [← Spec.map_comp, hψ, pullbackSpecIso_hom_fst]
  obtain ⟨e, he⟩ := c3 sA
  have he' : e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) =
      wcHalA1Proj sA := by
    rw [Polynomial.algebraMap_eq]
    exact he
  obtain ⟨B₁, _, _, _, Λ₁, _, _, W₁, φ₁, a₁, e₁, hinit₁, haff₁, hφ₁, hφa₁, hlim₁, he₁, hpt₁⟩ :=
    wc_et_geom_strict_henselization (e.inv x)
  have hd₁ : wcHalShData (e.inv x) B₁ Λ₁ W₁ φ₁ a₁ :=
    ⟨hinit₁, haff₁, hφ₁, hφa₁, hlim₁, e₁, he₁, hpt₁⟩
  obtain ⟨ι₀, hι₀iso, hι₀⟩ :=
    wc_closed_immersion_geomPt_compat (Spec (.of (Polynomial A))) (wcHalA1 sA) e.inv x
  haveI := hι₀iso
  have hιc : (asIso ι₀).symm.hom ≫ wcEtGeomPt (wcHalA1 sA) (e.inv x) =
      wcEtGeomPt (Spec (.of (Polynomial A))) x ≫ e.inv := by
    rw [Iso.symm_hom, asIso_inv, ← hι₀, IsIso.inv_hom_id_assoc]
  obtain ⟨θ', hθ'⟩ := wc_shdata_etale_iso e.inv x (e.inv x) (asIso ι₀).symm hιc
    B Λ W' φ a hd B₁ Λ₁ W₁ φ₁ a₁ hd₁
  have eq1 : (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) ≫ 𝟙 _ =
      θ'.hom ≫ (a₁ ≫ wcHalA1Proj sA) := by
    rw [Category.comp_id, ← he', ← Category.assoc θ'.hom, hθ', Category.assoc,
      Iso.inv_hom_id_assoc]
  have eq2 : z ≫ 𝟙 (Spec (.of A)) = 𝟙 (Spec (.of Ω)) ≫ z := by
    rw [Category.comp_id, Category.id_comp]
  obtain ⟨E⟩ := wc_et_coh_iso_invariance (Limits.pullback.map
    (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) z
    (a₁ ≫ wcHalA1Proj sA) z θ'.hom (𝟙 _) (𝟙 _) eq1 eq2) ℓ q

  have H : ∀ (A' : Type u) [CommRing A'] [HenselianLocalRing A']
      [IsSepClosed (IsLocalRing.ResidueField A')] (s' : Spec (.of A') ⟶ Spec (.of K))
      (x' : wcHalA1 s'), IsClosed ({x'} : Set (wcHalA1 s')) →
      wcHalA1Proj s' x' = IsLocalRing.closedPoint A' →
      ∀ (B' : Type u) [CommRing B'] [HenselianLocalRing B']
      [IsSepClosed (IsLocalRing.ResidueField B')] (Λ' : Type u) [SmallCategory Λ']
      [IsCofiltered Λ'] (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcHalA1 s') x'))
        (Scheme.Etale.forget (wcHalA1 s')))
      (φ' : ∀ l, Spec (.of B') ⟶ (W''.obj l).right.left) (a' : Spec (.of B') ⟶ wcHalA1 s'),
      wcHalShData x' B' Λ' W'' φ' a' → ∀ (Ω' : Type u) [Field Ω'] [IsAlgClosed Ω']
      (z' : Spec (.of Ω') ⟶ Spec (.of A')),
      Nat.card (wcEtCoh (Limits.pullback (a' ≫ wcHalA1Proj s') z') ℓ 0) = ℓ ∧
      ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (a' ≫ wcHalA1Proj s') z') ℓ q) := by
    intro A' _ _ _ s' x' hx' hxc' B' _ _ _ Λ' _ _ W'' φ' a' hd' Ω' _ _ z'
    refine ⟨wc_et_milnor_fibre_connected K ℓ hℓ hℓK A' s' x' hx' hxc' B' Λ' W'' φ' a' hd' Ω' z',
      fun q' hq' => ?_⟩
    rcases Nat.lt_or_ge q' 2 with h2 | h2
    · obtain rfl : q' = 1 := by omega
      exact wc_et_milnor_fibre_h1_vanishing K ℓ hℓ hℓK A' s' x' hx' hxc' B' Λ' W'' φ' a' hd' Ω' z'
    · exact wc_et_milnor_fibre_cd_one K ℓ hℓ hℓK A' s' x' hx' hxc' B' Λ' W'' φ' a' hd' Ω' z' q' h2
  have Htube := wc_hal_milnor_tube_acyclic K ℓ hℓ hℓK H A sA Ω z
  haveI := wc_et_enough_injectives (Limits.pullback (wcHalA1Proj sA) z)
  obtain ⟨I⟩ : Nonempty (InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology
      (Limits.pullback (wcHalA1Proj sA) z)) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) := ⟨InjectiveResolution.of _⟩
  have hZ := wc_hal_geom_higher_direct_vanish K ℓ hℓ hℓK A sA Ω z Htube I q hq
  haveI hS : Subsingleton ((wcEtStalk (wcHalA1 sA) (e.inv x)).obj
      ((((wcEtPush (Limits.pullback.fst (wcHalA1Proj sA) z)).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex).homology q)) :=
    AddCommGrpCat.isZero_iff_subsingleton.mp ((wcEtStalk (wcHalA1 sA) (e.inv x)).map_isZero hZ)
  haveI hhaff : IsAffineHom (Limits.pullback.fst (wcHalA1Proj sA) z) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback (wcHalA1Proj sA) z).flip inferInstance
  obtain ⟨E₁⟩ := wc_et_stalk_push_homology (Limits.pullback.fst (wcHalA1Proj sA) z) (e.inv x)
    Λ₁ W₁ hinit₁ I.cocomplex q
  obtain ⟨E₂⟩ := wc_et_limit_push_homology_affine (Limits.pullback.fst (wcHalA1Proj sA) z) B₁ Λ₁
    (W₁ ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt (wcHalA1 sA) (e.inv x)))
      (Scheme.Etale.forget (wcHalA1 sA)))
    φ₁ a₁ haff₁ hφ₁ hφa₁ hlim₁ ℓ I q
  obtain ⟨E₃⟩ := wc_et_coh_iso_invariance
    ((Limits.pullbackSymmetry (Limits.pullback.fst (wcHalA1Proj sA) z) a₁).hom ≫
      (Limits.pullbackRightPullbackFstIso (wcHalA1Proj sA) z a₁).hom) ℓ q
  haveI hsub : Subsingleton (wcEtCoh (Limits.pullback (a₁ ≫ wcHalA1Proj sA) z) ℓ q) :=
    (E₁.trans (E₂.trans E₃.symm)).symm.subsingleton
  exact E.symm.subsingleton

theorem wc_et_limit_base_change_cone : ∀ {Y P Z : Scheme.{u}} (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W : Λ ⥤ Y.Etale) (φ : ∀ l, Z ⟶ (W.obj l).left) (a : Z ⟶ Y), (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W.map t).left = φ l') → (∀ l, φ l ≫ (W.obj l).hom = a) → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (W.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (W.map t).left = z l') → ∃! z₀ : T ⟶ Z, ∀ l, z₀ ≫ φ l = z l) → ∀ (g : P ⟶ Y), ∃ π : ∀ l, Limits.pullback a g ⟶ ((W ⋙ wcEtBaseChange g).obj l).left, (∀ l, π l ≫ ((W ⋙ wcEtBaseChange g).obj l).hom = Limits.pullback.snd a g) ∧ (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ ((W ⋙ wcEtBaseChange g).map t).left = π l') ∧ (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ ((W ⋙ wcEtBaseChange g).obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ ((W ⋙ wcEtBaseChange g).map t).left = z l') → ∃! z₀ : T ⟶ Limits.pullback a g, ∀ l, z₀ ≫ π l = z l) :=
by
  intro Y P Z Λ _ _ W φ a hφ hφa hlim g
  let f1 : ∀ l, ((W ⋙ wcEtBaseChange g).obj l).left ⟶ (W.obj l).left :=
    fun l => Limits.pullback.fst (W.obj l).hom g
  let s1 : ∀ l, ((W ⋙ wcEtBaseChange g).obj l).left ⟶ P :=
    fun l => Limits.pullback.snd (W.obj l).hom g
  have cond : ∀ l, f1 l ≫ (W.obj l).hom = s1 l ≫ g := fun l => Limits.pullback.condition
  have E3a : ∀ {l l' : Λ} (t : l ⟶ l'),
      ((W ⋙ wcEtBaseChange g).map t).left ≫ f1 l' = f1 l ≫ (W.map t).left := by
    intro l l' t
    exact Limits.pullback.lift_fst _ _ _
  have E3b : ∀ {l l' : Λ} (t : l ⟶ l'),
      ((W ⋙ wcEtBaseChange g).map t).left ≫ s1 l' = s1 l := by
    intro l l' t
    exact Limits.pullback.lift_snd _ _ _
  have hext : ∀ (l : Λ) {T : Scheme.{u}} (x y : T ⟶ ((W ⋙ wcEtBaseChange g).obj l).left),
      x ≫ f1 l = y ≫ f1 l → x ≫ s1 l = y ≫ s1 l → x = y :=
    fun l T x y h1 h2 => Limits.pullback.hom_ext h1 h2
  have hw : ∀ l, (Limits.pullback.fst a g ≫ φ l) ≫ (W.obj l).hom =
      Limits.pullback.snd a g ≫ g := by
    intro l
    rw [Category.assoc, hφa l]
    exact Limits.pullback.condition
  let π : ∀ l, Limits.pullback a g ⟶ ((W ⋙ wcEtBaseChange g).obj l).left := fun l =>
    Limits.pullback.lift (Limits.pullback.fst a g ≫ φ l) (Limits.pullback.snd a g) (hw l)
  have P1 : ∀ l, π l ≫ f1 l = Limits.pullback.fst a g ≫ φ l :=
    fun l => Limits.pullback.lift_fst _ _ _
  have P2 : ∀ l, π l ≫ s1 l = Limits.pullback.snd a g :=
    fun l => Limits.pullback.lift_snd _ _ _
  refine ⟨π, fun l => P2 l, ?_, ?_⟩
  · intro l l' t
    apply hext l'
    · rw [Category.assoc, E3a, ← Category.assoc, P1, Category.assoc, hφ, P1]
    · rw [Category.assoc, E3b, P2, P2]
  · intro T z hz
    have hu : ∀ {l l' : Λ} (t : l ⟶ l'), (z l ≫ f1 l) ≫ (W.map t).left = z l' ≫ f1 l' := by
      intro l l' t
      rw [Category.assoc, ← E3a, ← Category.assoc, hz]
    obtain ⟨z₀', hz₀', huniq⟩ := hlim T (fun l => z l ≫ f1 l) hu
    have hz₀'' : ∀ l, z₀' ≫ φ l = z l ≫ f1 l := hz₀'
    have hv1 : ∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ s1 l = z l' ≫ s1 l' := by
      intro l l' t
      rw [← hz t, Category.assoc, E3b]
    have hv : ∀ l l', z l ≫ s1 l = z l' ≫ s1 l' := fun l l' =>
      (hv1 (IsCofiltered.minToLeft l l')).symm.trans (hv1 (IsCofiltered.minToRight l l'))
    obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
    have hcond : z₀' ≫ a = (z l₀ ≫ s1 l₀) ≫ g := by
      rw [← hφa l₀, ← Category.assoc, hz₀'' l₀, Category.assoc, cond, Category.assoc]
    refine ⟨Limits.pullback.lift z₀' (z l₀ ≫ s1 l₀) hcond, ?_, ?_⟩
    · intro l
      apply hext l
      · rw [Category.assoc, P1, ← Category.assoc, Limits.pullback.lift_fst, hz₀'']
      · rw [Category.assoc, P2, Limits.pullback.lift_snd]
        exact hv l₀ l
    · intro y hy
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst]
        apply huniq
        intro l
        show (y ≫ Limits.pullback.fst a g) ≫ φ l = z l ≫ f1 l
        rw [Category.assoc, ← P1, ← Category.assoc, hy]
      · rw [Limits.pullback.lift_snd, ← P2 l₀, ← Category.assoc, hy]

theorem wc_et_affine_limit_etale_descend : ∀ {Y Y' : Scheme.{u}} (I : Type u) [SmallCategory I] [IsCofiltered I] (D : I ⥤ Y.Etale) (π : ∀ i, Y' ⟶ (D.obj i).left), (∀ {i j : I} (t : i ⟶ j), π i ≫ (D.map t).left = π j) → (∀ (T : Scheme.{u}) (z : ∀ i, T ⟶ (D.obj i).left), (∀ {i j : I} (t : i ⟶ j), z i ≫ (D.map t).left = z j) → ∃! z₀ : T ⟶ Y', ∀ i, z₀ ≫ π i = z i) → IsAffine Y' → (∀ i, IsAffine (D.obj i).left) → ∀ (V : Scheme.{u}) (v : V ⟶ Y'), Etale v → IsAffine V → ∃ (i : I) (Vi : Scheme.{u}) (ei : Vi ⟶ (D.obj i).left) (w : V ⟶ Vi), Etale ei ∧ IsPullback w v ei (π i) :=
by
  classical
  intro Y Y' I _ _ D π hc hlim hY' hD V v hv hV
  haveI := hY'
  haveI := hV
  haveI hDaff : ∀ i, IsAffine (D.obj i).left := hD

  let F : I ⥤ Scheme.{u} :=
    { obj := fun i => (D.obj i).left
      map := fun t => (D.map t).left
      map_id := fun i => by
        show (D.map (𝟙 i)).left = 𝟙 _
        rw [D.map_id]; rfl
      map_comp := fun f g => by
        show (D.map (f ≫ g)).left = (D.map f).left ≫ (D.map g).left
        rw [D.map_comp]; rfl }
  haveI hFaff : ∀ i, IsAffine (F.obj i) := hD
  let c : Limits.Cone F :=
    { pt := Y'
      π := { app := fun i => π i
             naturality := fun i j t => by
               show 𝟙 Y' ≫ π j = π i ≫ (D.map t).left
               rw [Category.id_comp, hc t] } }
  have hclim : Limits.IsLimit c := by
    refine Limits.IsLimit.ofExistsUnique (fun s => ?_)
    exact hlim s.pt (fun i => s.π.app i) (fun {i j} t => s.w t)

  have hcomp : ∀ {i j k : I} (f : k ⟶ j) (g : j ⟶ i) (b : Γ((D.obj i).left, ⊤)),
      (D.map (f ≫ g)).left.appTop.hom b =
        (D.map f).left.appTop.hom ((D.map g).left.appTop.hom b) := by
    intro i j k f g b
    have hFc : (D.map (f ≫ g)).left = (D.map f).left ≫ (D.map g).left := F.map_comp f g
    rw [hFc, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
  have hcompat : ∀ {i j : I} (f : j ⟶ i) (b : Γ((D.obj i).left, ⊤)),
      (π j).appTop.hom ((D.map f).left.appTop.hom b) = (π i).appTop.hom b := by
    intro i j f b
    rw [← hc f, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
  have hlift : ∀ r : Γ(Y', ⊤), ∃ (i : I) (b : Γ((D.obj i).left, ⊤)),
      (π i).appTop.hom b = r := by
    intro r
    obtain ⟨i, t, ht⟩ := exists_appTop_π_eq_of_isAffine_of_isLimit F c hclim r
    exact ⟨i, t, ht⟩
  have hvan : ∀ (i : I) (b : Γ((D.obj i).left, ⊤)), (π i).appTop.hom b = 0 →
      ∃ (j : I) (f : j ⟶ i), (D.map f).left.appTop.hom b = 0 := by
    intro i b hb
    exact exists_appTop_map_eq_zero_of_isAffine_of_isLimit F c hclim i b hb

  letI algYV : Algebra Γ(Y', ⊤) Γ(V, ⊤) := v.appTop.hom.toAlgebra
  have hEt : Algebra.Etale Γ(Y', ⊤) Γ(V, ⊤) :=
    RingHom.Etale.toAlgebra (HasRingHomProperty.appTop @Etale v hv)

  obtain ⟨n, fP, val, hs, hk, g₁, hg⟩ := wc_sh_standard_presentation_fin Γ(Y', ⊤) Γ(V, ⊤) hEt
  let eW : (MvPolynomial (Fin n) Γ(Y', ⊤) ⧸ Ideal.span (Set.range fP)) ≃ₐ[Γ(Y', ⊤)] Γ(V, ⊤) :=
    (Ideal.quotientEquivAlgOfEq Γ(Y', ⊤) hk.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective hs)

  obtain ⟨i, f₀, g₀, hmap, hcert⟩ := wc_colim_standard_etale_data_descend I
    (fun i => (Γ((D.obj i).left, ⊤) : Type u)) Γ(Y', ⊤) (fun i => (π i).appTop.hom)
    (fun f => (D.map f).left.appTop.hom) hcomp hcompat hlift hvan n fP g₁ hg

  have hAet : Algebra.Etale Γ((D.obj i).left, ⊤)
      (MvPolynomial (Fin n) Γ((D.obj i).left, ⊤) ⧸ Ideal.span (Set.range f₀)) :=
    wc_standard_etale_quotient Γ((D.obj i).left, ⊤) id Function.bijective_id f₀ g₀ hcert

  letI algYP : Algebra Γ((D.obj i).left, ⊤) Γ(Y', ⊤) := (π i).appTop.hom.toAlgebra
  obtain ⟨e4⟩ := wc_tensor_mvpoly_quotient_equiv Γ((D.obj i).left, ⊤) Γ(Y', ⊤) n f₀
  have hfun : (fun b => MvPolynomial.map (algebraMap Γ((D.obj i).left, ⊤) Γ(Y', ⊤)) (f₀ b)) =
      fP :=
    funext hmap
  have hideal : Ideal.span (Set.range fun b =>
      MvPolynomial.map (algebraMap Γ((D.obj i).left, ⊤) Γ(Y', ⊤)) (f₀ b)) =
      Ideal.span (Set.range fP) :=
    congrArg (fun s => Ideal.span (Set.range s)) hfun
  let ε := e4.trans ((Ideal.quotientEquivAlgOfEq Γ(Y', ⊤) hideal).trans eW)

  obtain ⟨E₀, e, j₃, hj₃iso, _hE₀aff, he, hj₃⟩ := wc_affine_etale_realize_tensor Y'
    (D.obj i).left V (π i) v
    (MvPolynomial (Fin n) Γ((D.obj i).left, ⊤) ⧸ Ideal.span (Set.range f₀)) hAet
    (Nonempty.intro ε)

  haveI := hj₃iso
  have H := (IsPullback.of_hasPullback (π i) e).flip
  refine ⟨i, E₀, e, inv j₃ ≫ Limits.pullback.snd (π i) e, he, ?_⟩
  refine IsPullback.of_iso H (asIso j₃) (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
  · simp
  · rw [Iso.refl_hom, Category.comp_id, asIso_hom, hj₃]
  · simp
  · simp

theorem wc_shdata_prolim_etale_iso : ∀ {Y Y' : Scheme.{u}} (I : Type u) [SmallCategory I] [IsCofiltered I] (D : I ⥤ Y.Etale) (π : ∀ i, Y' ⟶ (D.obj i).left) (ρ : Y' ⟶ Y), (∀ i, π i ≫ (D.obj i).hom = ρ) → (∀ {i j : I} (t : i ⟶ j), π i ≫ (D.map t).left = π j) → (∀ (T : Scheme.{u}) (z : ∀ i, T ⟶ (D.obj i).left), (∀ {i j : I} (t : i ⟶ j), z i ≫ (D.map t).left = z j) → ∃! z₀ : T ⟶ Y', ∀ i, z₀ ≫ π i = z i) → (∀ (V : Scheme.{u}) (v : V ⟶ Y'), Etale v → IsAffine V → ∃ (i : I) (Vi : Scheme.{u}) (ei : Vi ⟶ (D.obj i).left) (w : V ⟶ Vi), Etale ei ∧ IsPullback w v ei (π i)) → ∀ (y' : Y') (ι : Spec (.of (AlgebraicClosure (Y'.residueField y'))) ⟶ Spec (.of (AlgebraicClosure (Y.residueField (ρ y'))))), ι ≫ wcEtGeomPt Y (ρ y') = wcEtGeomPt Y' y' ≫ ρ → ∀ (B' : Type u) [CommRing B'] [HenselianLocalRing B'] [IsSepClosed (IsLocalRing.ResidueField B')] (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ'] (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y' y')) (Scheme.Etale.forget Y')) (φ' : ∀ l, Spec (.of B') ⟶ (W''.obj l).right.left) (a' : Spec (.of B') ⟶ Y'), wcHalShData y' B' Λ' W'' φ' a' → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y (ρ y'))) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData (ρ y') B Λ W' φ a → ∃ θ : Spec (.of B') ≅ Spec (.of B), θ.hom ≫ a = a' ≫ ρ :=
by
  intro Y Y' I _ _ D π ρ H1 H2 H3 H4 y' ι hι B' _ _ _ Λ' _ _ W'' φ' a' hd' B _ _ _ Λ _ _ W' φ a hd

  have hqpt : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (K : Type u) [Field K]
      (e : IsLocalRing.ResidueField R →+* K) (x : Spec (.of K)),
      (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x =
        IsLocalRing.closedPoint R := by
    intro R _ _ K _ e x
    rw [Scheme.Hom.comp_apply]
    exact IsLocalRing.PrimeSpectrum.comap_residue R _

  have s0 : ∀ {P E S : Scheme.{u}} (ee : E ⟶ S) [Etale ee] (aa bb : P ⟶ E), aa ≫ ee = bb ≫ ee →
      ∀ (Ω : Type u) [Field Ω] (π : Spec (.of Ω) ⟶ P), π ≫ aa = π ≫ bb →
      ∃ U : P.Opens, π (IsLocalRing.closedPoint Ω) ∈ U ∧ U.ι ≫ aa = U.ι ≫ bb := by
    intro P E S ee _ aa bb hab Ω _ π hπ
    let c : P ⟶ Limits.pullback ee ee := Limits.pullback.lift aa bb hab
    have hcf : c ≫ Limits.pullback.fst ee ee = aa := Limits.pullback.lift_fst _ _ _
    have hcs : c ≫ Limits.pullback.snd ee ee = bb := Limits.pullback.lift_snd _ _ _
    have hkey : π ≫ c = (π ≫ aa) ≫ Limits.pullback.diagonal ee := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hcf, Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      · rw [Category.assoc, hcs, Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
          hπ]
    have hpt : ∀ w : Spec (.of Ω), c (π w) = Limits.pullback.diagonal ee (aa (π w)) := by
      intro w
      rw [← Scheme.Hom.comp_apply, hkey, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    refine ⟨c ⁻¹ᵁ (Limits.pullback.diagonal ee).opensRange, ?_, ?_⟩
    · show c (π (IsLocalRing.closedPoint Ω)) ∈ (Limits.pullback.diagonal ee).opensRange
      rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
      exact ⟨_, (hpt _).symm⟩
    · set U := c ⁻¹ᵁ (Limits.pullback.diagonal ee).opensRange with hU
      have hrange : Set.range (U.ι ≫ c) ⊆ Set.range (Limits.pullback.diagonal ee) := by
        rintro _ ⟨x, rfl⟩
        have hx0 : U.ι x ∈ Set.range U.ι := ⟨x, rfl⟩
        rw [Scheme.Opens.range_ι] at hx0
        have hx' : c (U.ι x) ∈ (Limits.pullback.diagonal ee).opensRange := hx0
        rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange] at hx'
        rw [Scheme.Hom.comp_apply]
        exact hx'
      obtain ⟨t, ht⟩ : ∃ t, t ≫ Limits.pullback.diagonal ee = U.ι ≫ c :=
        ⟨_, IsOpenImmersion.lift_fac (Limits.pullback.diagonal ee) (U.ι ≫ c) hrange⟩
      have h1 : U.ι ≫ aa = t := by
        calc U.ι ≫ aa = (U.ι ≫ c) ≫ Limits.pullback.fst ee ee := by rw [Category.assoc, hcf]
          _ = (t ≫ Limits.pullback.diagonal ee) ≫ Limits.pullback.fst ee ee := by rw [ht]
          _ = t := by rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      have h2 : U.ι ≫ bb = t := by
        calc U.ι ≫ bb = (U.ι ≫ c) ≫ Limits.pullback.snd ee ee := by rw [Category.assoc, hcs]
          _ = (t ≫ Limits.pullback.diagonal ee) ≫ Limits.pullback.snd ee ee := by rw [ht]
          _ = t := by rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id]
      rw [h1, h2]

  have hAG : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (Ω : Type u) [Field Ω]
      (π : Spec (.of Ω) ⟶ Spec (.of R)), π (IsLocalRing.closedPoint Ω) = IsLocalRing.closedPoint R →
      ∀ {V S : Scheme.{u}} (h : V ⟶ S) [Etale h] (g₁ g₂ : Spec (.of R) ⟶ V),
      g₁ ≫ h = g₂ ≫ h → π ≫ g₁ = π ≫ g₂ → g₁ = g₂ := by
    intro R _ _ Ω _ π hπ V S h _ g₁ g₂ hh hq
    obtain ⟨U, hU, hUeq⟩ := s0 h g₁ g₂ hh Ω π hq
