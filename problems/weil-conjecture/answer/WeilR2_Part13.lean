  · obtain ⟨h0, hq⟩ := wc_affine_line_shens_field_test_acyclic K ℓ hℓ hℓK A sA x hx B Λ W' φ a hd
      Ω (z ≫ Spec.map (CommRingCat.ofHom ψ) ≫ c)
    have E : ∀ q : ℕ, Nonempty (wcEtCoh (Limits.pullback
