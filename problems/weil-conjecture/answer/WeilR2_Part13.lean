  obtain ⟨m, b', f', hne, hg, hcov⟩ := atlas
  choose g hgE hgC using hg
  letI algK : ∀ j, Algebra K Γ(X.left, X.left.basicOpen (f' j)) := fun j =>
    ((X.left.presheaf.map (homOfLE (le_top : X.left.basicOpen (f' j) ≤ ⊤)).op).hom.comp
      (X.hom.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom)).toAlgebra
  obtain ⟨gh, hgh⟩ : ∃ gh : ∀ j, MvPolynomial (Fin n) K →ₐ[K] Γ(X.left, X.left.basicOpen (f' j)),
      ∀ j, (gh j : MvPolynomial (Fin n) K →+* Γ(X.left, X.left.basicOpen (f' j))) = g j :=
    ⟨fun j => { toRingHom := g j, commutes' := fun c => RingHom.congr_fun (hgC j) c }, fun j => rfl⟩
  have hgE' : ∀ j, (gh j : MvPolynomial (Fin n) K →+* Γ(X.left, X.left.basicOpen (f' j))).Etale :=
    fun j => by rw [hgh j]; exact hgE j
