        Ideal.span (Set.range fun j => (Z.presheaf.germ W z hzW).hom (ψ j)) :=
by
  classical

  have hlocsurj : ∀ {A B Aₚ Bq : Type u} [CommRing A] [CommRing B] [CommRing Aₚ] [CommRing Bq]
      [Algebra A Aₚ] [Algebra B Bq] (θ : A →+* B) (_ : Function.Surjective θ)
      (P : Ideal A) [P.IsPrime] (Q : Ideal B) [Q.IsPrime] (_ : P = Q.comap θ)
      [IsLocalization.AtPrime Aₚ P] [IsLocalization.AtPrime Bq Q]
      (φ : Aₚ →+* Bq) (_ : ∀ a : A, φ (algebraMap A Aₚ a) = algebraMap B Bq (θ a)),
      Function.Surjective φ ∧ RingHom.ker φ = Ideal.map (algebraMap A Aₚ) (RingHom.ker θ) := by
    intro A B Aₚ Bq _ _ _ _ _ _ θ hθ P _ Q _ hPQ _ _ φ hφ
    have hT : Submonoid.map θ P.primeCompl = Q.primeCompl := by
      ext b
      constructor
      · rintro ⟨a, ha, rfl⟩
        have ha' : a ∉ P := ha
