    exact (heG (E.obj i) (E.obj i') (E.map t) x y).trans (hz y)

  obtain ⟨d, hd⟩ : ∃ d : U ⟶ U, d = 𝟙 U := ⟨_, rfl⟩
  have hdl : d.left = 𝟙 U.left := by
