      (fun m => by simp only [Category.assoc])


  have BG : β ≫ G = a' := by
    have hc : ∀ {i j : I} (t : i ⟶ j), (a' ≫ π i) ≫ (D.map t).left = a' ≫ π j := by
      intro i j t; rw [Category.assoc, H2 t]
    refine (H3 _ _ hc).unique (y₁ := β ≫ G) (y₂ := a') (fun i => ?_) (fun i => rfl)
    haveI : Etale (D.obj i).hom := (D.obj i).prop
