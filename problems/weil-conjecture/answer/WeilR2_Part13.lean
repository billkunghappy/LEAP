    refine ⟨e ⟨b, ⟨i, hiT⟩⟩, by simp, ?_⟩
    show x ∈ X.left.basicOpen (F (e.symm (e ⟨b, ⟨i, hiT⟩⟩)).1 (e.symm (e ⟨b, ⟨i, hiT⟩⟩)).2.1)
    rw [e.symm_apply_apply]
