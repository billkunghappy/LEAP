import WeilR2_Part12
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_ldp_smooth_quadric_charts (K : Type u) [Field K] [IsAlgClosed K] (N n : ℕ)
    (X : Over (Spec (.of K))) [GeometricallyIrreducible X.hom] [SmoothOfRelativeDimension n X.hom]
    (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr K N = X.hom) :
    ∃ (m : ℕ) (a : Fin m → Fin (N + 1)) (R : Fin m → Type u) (_ : ∀ j, CommRing (R j))
      (_ : ∀ j, Algebra K (R j)),
      (∀ j, Algebra.FiniteType K (R j)) ∧ (∀ j, IsDomain (R j)) ∧ (∀ j, ringKrullDim (R j) ≤ n) ∧
      ∃ (u : ∀ j, Fin (N + 1) → R j) (t : ∀ j, Fin n → R j)
        (D : ∀ j, Fin n → Derivation K (R j) (R j)),
        (∀ j, u j (a j) = 1) ∧ (∀ j i k, D j i (t j k) = if i = k then 1 else 0) ∧
        (∀ j (χ : R j →ₐ[K] K), RingHom.ker χ =
          Ideal.span (Set.range fun p => u j p - algebraMap K (R j) (χ (u j p)))) ∧
        ∀ (x : X.left), IsClosed ({x} : Set X.left) → ∀ (b : Fin (N + 1))
          (hx : x ∈ ι ⁻¹ᵁ wcSgD K N b),
          ∃ j, a j = b ∧ ∃ (χ : R j →ₐ[K] K) (lam : R j →+* X.left.presheaf.stalk x)
            (δ : Fin n → (X.left.presheaf.stalk x →+ X.left.presheaf.stalk x)),
            (∀ r, lam r - wcLdpConst K X.hom x (χ r) ∈
              IsLocalRing.maximalIdeal (X.left.presheaf.stalk x)) ∧
            (∀ y : X.left.presheaf.stalk x, ∃ c, y - wcLdpConst K X.hom x c ∈
              IsLocalRing.maximalIdeal (X.left.presheaf.stalk x)) ∧
            (∀ w : Fin (N + 1) × Fin (N + 1) → K, lam (∑ q, w q • (u j q.1 * u j q.2)) =
              wcLdpGerm K N ι (wcLdpQuad K N fun p q => w (p, q)) b x hx) ∧
            IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) =
              Ideal.span (Set.range fun k => lam (t j k) - wcLdpConst K X.hom x (χ (t j k))) ∧
            (∀ i f g, δ i (f * g) = f * δ i g + g * δ i f) ∧
            (∀ i c, δ i (wcLdpConst K X.hom x c) = 0) ∧ (∀ i r, δ i (lam r) = lam (D j i r)) :=
by
  classical

  have qs1 : ∀ (K : Type u) [Field K] (n : ℕ) (J : Fin (n + 1)) (x : Γ(wcProjK K n, wcSgD K n J)),
      x ∈ Subring.closure (Set.range (wcSgE K n J) ∪ Set.range (fun c : K =>
        (wcProjK K n).presheaf.map (homOfLE (le_top : wcSgD K n J ≤ ⊤)).op
          ((wcProjKStr K n).appTop ((Scheme.ΓSpecIso (.of K)).inv c)))) := by
    intro K _ n
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) := MvPolynomial.gradedAlgebra
    have hX : ∀ k : Fin (n + 1), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun k =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
    intro J x
    have GEN : ∀ (k : Fin (n + 1)) (d : ℕ) (F : MvPolynomial (Fin (n + 1)) K)
        (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (d • 1)),
        MvPolynomial.eval₂ ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X k))).comp
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))
          (fun l => HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX k) 1
            (MvPolynomial.X l) (hX l)) F =
        HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX k) d F hF := by
      intro k d F hF
      have hFh : F.IsHomogeneous d := by
        have := (MvPolynomial.mem_homogeneousSubmodule (d • 1) F).mp hF
        simpa using this
      have scale : ∀ {L : Type u} [CommRing L] (χ : K →+* L) (g : Fin (n + 1) → L) (t : L),
          MvPolynomial.eval₂ χ (fun l => g l * t) F = t ^ d * MvPolynomial.eval₂ χ g F := by
        intro L _ χ g t
        rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun e he => ?_)
        have hdeg : ∑ i ∈ e.support, e i = d := by
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp he) (hFh.coeff_eq_zero hne)
        simp_rw [mul_pow]
        rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
        ring
      apply HomogeneousLocalization.val_injective
      rw [← HomogeneousLocalization.algebraMap_apply, ← HomogeneousLocalization.algebraMap_apply,
        MvPolynomial.eval₂_comp_left, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk]
      calc _ = MvPolynomial.eval₂
            ((algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))).comp
              MvPolynomial.C)
            (fun l => algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))
              (MvPolynomial.X l) * Localization.mk 1 (⟨MvPolynomial.X k ^ 1, ⟨1, rfl⟩⟩ :
                Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K))) F := by
            congr 1
            funext l
            simp only [Function.comp_apply, HomogeneousLocalization.algebraMap_apply,
              HomogeneousLocalization.Away.val_mk, ← Localization.mk_one_eq_algebraMap,
              Localization.mk_mul, mul_one, one_mul]
        _ = _ := by
            rw [scale]
            have h2 := MvPolynomial.eval₂_comp_left (algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K))))
              MvPolynomial.C MvPolynomial.X F
            rw [MvPolynomial.eval₂_eta] at h2
            rw [show (fun l => algebraMap (MvPolynomial (Fin (n + 1)) K)
                (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))
                (MvPolynomial.X l)) = ⇑(algebraMap (MvPolynomial (Fin (n + 1)) K)
                (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))) ∘
                MvPolynomial.X from rfl, ← h2, Localization.mk_pow,
              ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, Localization.mk_eq_mk_iff,
              Localization.r_iff_exists]
            refine ⟨1, ?_⟩
            simp only [one_pow, one_mul, mul_one, OneMemClass.coe_one, SubmonoidClass.coe_pow, ← pow_mul]
    have hι : ∀ (U : (Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).Opens) a,
        U.ι.appTop a = U.topIso.inv ((Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op a) := by
      intro U a
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
      erw [← CategoryTheory.comp_apply, ← Functor.map_comp]
      rfl
    have hconst : ∀ c : K, (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
          (Submonoid.powers (MvPolynomial.X J)) (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0) c)) =
        ((Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).presheaf.map (homOfLE (le_top : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)) ≤ ⊤)).op).hom ((Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) 0)))).appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) := by
      intro c
      have e0 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).ι =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom ≫
            Proj.awayι _ (MvPolynomial.X J) (hX J) Nat.one_pos := by
        rw [← Proj.basicOpenIsoSpec_inv_ι, Iso.hom_inv_id_assoc]
      have e1 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).ι ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) 0)))) =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom ≫
            Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X J))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))) := by
        rw [e0, Category.assoc, Proj.awayι_toSpecZero_assoc, ← Spec.map_comp]
        rfl
      have e2 := congrArg (fun g => (Scheme.Hom.appTop g).hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) e1
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at e2
      have e3 := congrArg (fun g => g.hom c) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X J))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e3
      rw [← e3] at e2
      have hi : ∀ y, (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom.appTop
          ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).inv y) =
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv
            ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom y) := by
        intro y
        rw [Proj.basicOpenIsoSpec_hom]
        have hh := Proj.basicOpenToSpec_app_top (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)
        calc _ = ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).hom ≫ Proj.awayToSection _ (MvPolynomial.X J) ≫ (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv) ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).inv y) := by rw [← hh]
          _ = _ := by
            change (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv
              ((Proj.awayToSection _ (MvPolynomial.X J)) ((Scheme.ΓSpecIso _).hom ((Scheme.ΓSpecIso _).inv y))) = _
            rw [Iso.inv_hom_id_apply]
      have e4 := e2.trans (hi _)
      rw [hι] at e4
      have hinj : ∀ a b : Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K), Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)),
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv a =
            (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv b → a = b := by
        intro a b h
        have h' := congrArg (fun w => (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.hom w) h
        simp only [Iso.inv_hom_id_apply] at h'
        exact h'
      exact (hinj _ _ e4).symm
    have hs : Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (MvPolynomial.X J) ((Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos).inv x) = x := by
      have := Iso.inv_hom_id_apply (Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos) x
      rwa [Proj.basicOpenIsoAway_hom] at this
    obtain ⟨d, F, hF, hmk⟩ := HomogeneousLocalization.Away.mk_surjective
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX J)
      ((Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos).inv x)
    rw [← hs, ← hmk, ← GEN J d F hF]
    change (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom _ ∈ _
    rw [MvPolynomial.eval₂_comp_left]
    apply MvPolynomial.eval₂_mem
    · intro i _
      apply Subring.subset_closure
      right
      exact ⟨F.coeff i, (hconst (F.coeff i)).symm⟩
    · intro l
      apply Subring.subset_closure
      left
      exact ⟨l, rfl⟩

  have qs2 : ∀ (K : Type u) [Field K] (N : ℕ) (b : Fin (N + 1)),
      wcSgE K N b b = 1 ∧ ∀ a : Fin (N + 1) → Fin (N + 1) → K,
        wcLdpSec K N (wcLdpQuad K N a) b = ∑ p, ∑ q,
          ((wcProjK K N).presheaf.map (homOfLE (le_top : wcSgD K N b ≤ ⊤)).op).hom
              ((wcProjKStr K N).appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom (a p q))) *
            (wcSgE K N b p * wcSgE K N b q) := by
    intro K _ N b
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) := MvPolynomial.gradedAlgebra
    have hX : ∀ k : Fin (N + 1), (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 := fun k =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
    have hι : ∀ (U : (Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)).Opens) a,
        U.ι.appTop a = U.topIso.inv ((Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op a) := by
      intro U a
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
      erw [← CategoryTheory.comp_apply, ← Functor.map_comp]
      rfl
    have hconst : ∀ c : K, (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X b)).hom
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (Submonoid.powers (MvPolynomial.X b)) (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)) =
        ((Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)).presheaf.map (homOfLE (le_top : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X b)) ≤ ⊤)).op).hom ((Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0)))).appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) := by
      intro c
      have e0 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X b)).ι =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X b) (hX b) Nat.one_pos).hom ≫
            Proj.awayι _ (MvPolynomial.X b) (hX b) Nat.one_pos := by
        rw [← Proj.basicOpenIsoSpec_inv_ι, Iso.hom_inv_id_assoc]
      have e1 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X b)).ι ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0)))) =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X b) (hX b) Nat.one_pos).hom ≫
            Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X b))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)))) := by
        rw [e0, Category.assoc, Proj.awayι_toSpecZero_assoc, ← Spec.map_comp]
        rfl
      have e2 := congrArg (fun g => (Scheme.Hom.appTop g).hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) e1
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at e2
      have e3 := congrArg (fun g => g.hom c) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X b))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e3
      rw [← e3] at e2
      have hi : ∀ y, (Proj.basicOpenIsoSpec _ (MvPolynomial.X b) (hX b) Nat.one_pos).hom.appTop
          ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X b)))).inv y) =
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X b)).topIso.inv
            ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X b)).hom y) := by
        intro y
        rw [Proj.basicOpenIsoSpec_hom]
        have hh := Proj.basicOpenToSpec_app_top (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X b)
        calc _ = ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X b)))).hom ≫ Proj.awayToSection _ (MvPolynomial.X b) ≫ (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X b)).topIso.inv) ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X b)))).inv y) := by rw [← hh]
          _ = _ := by
            change (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X b)).topIso.inv
              ((Proj.awayToSection _ (MvPolynomial.X b)) ((Scheme.ΓSpecIso _).hom ((Scheme.ΓSpecIso _).inv y))) = _
            rw [Iso.inv_hom_id_apply]
      have e4 := e2.trans (hi _)
      rw [hι] at e4
      have hinj : ∀ a b' : Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K), Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X b)),
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X b)).topIso.inv a =
            (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X b)).topIso.inv b' → a = b' := by
        intro a b' h
        have h' := congrArg (fun w => (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X b)).topIso.hom w) h
        simp only [Iso.inv_hom_id_apply] at h'
        exact h'
      exact (hinj _ _ e4).symm
    have hmk1 : HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (hX b) 1 (MvPolynomial.X b) (hX b) = 1 := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one,
        ← Localization.mk_one, Localization.mk_eq_mk_iff]
      apply Localization.r_of_eq
      simp
    refine ⟨?_, fun a => ?_⟩
    · show (Proj.awayToSection _ (MvPolynomial.X b)).hom
        (HomogeneousLocalization.Away.mk _ (hX b) 1 (MvPolynomial.X b) (hX b)) = 1
      rw [hmk1, map_one]
    · have hmk2 : HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (hX b) 2 ((wcLdpQuad K N a : MvPolynomial (Fin (N + 1)) K)) (wcLdpQuad K N a).2 =
          ∑ p, ∑ q, HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X b))
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) (a p q)) *
            (HomogeneousLocalization.Away.mk _ (hX b) 1 (MvPolynomial.X p) (hX p) *
              HomogeneousLocalization.Away.mk _ (hX b) 1 (MvPolynomial.X q) (hX q)) := by
        have GEN : ∀ (k : Fin (N + 1)) (d : ℕ) (F : MvPolynomial (Fin (N + 1)) K)
            (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (d • 1)),
            MvPolynomial.eval₂ ((HomogeneousLocalization.fromZeroRingHom
                (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X k))).comp
                (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)))
              (fun l => HomogeneousLocalization.Away.mk
                (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hX k) 1
                (MvPolynomial.X l) (hX l)) F =
            HomogeneousLocalization.Away.mk
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hX k) d F hF := by
          intro k d F hF
          have hFh : F.IsHomogeneous d := by
            have := (MvPolynomial.mem_homogeneousSubmodule (d • 1) F).mp hF
            simpa using this
          have scale : ∀ {L : Type u} [CommRing L] (χ : K →+* L) (g : Fin (N + 1) → L) (t : L),
              MvPolynomial.eval₂ χ (fun l => g l * t) F = t ^ d * MvPolynomial.eval₂ χ g F := by
            intro L _ χ g t
            rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
            refine Finset.sum_congr rfl (fun e he => ?_)
            have hdeg : ∑ i ∈ e.support, e i = d := by
              by_contra hne
              exact (MvPolynomial.mem_support_iff.mp he) (hFh.coeff_eq_zero hne)
            simp_rw [mul_pow]
            rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
            ring
          apply HomogeneousLocalization.val_injective
          rw [← HomogeneousLocalization.algebraMap_apply, ← HomogeneousLocalization.algebraMap_apply,
            MvPolynomial.eval₂_comp_left, HomogeneousLocalization.algebraMap_apply,
            HomogeneousLocalization.Away.val_mk]
          calc _ = MvPolynomial.eval₂
                ((algebraMap (MvPolynomial (Fin (N + 1)) K)
                  (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) K)))).comp
                  MvPolynomial.C)
                (fun l => algebraMap (MvPolynomial (Fin (N + 1)) K)
                  (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) K)))
                  (MvPolynomial.X l) * Localization.mk 1 (⟨MvPolynomial.X k ^ 1, ⟨1, rfl⟩⟩ :
                    Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) K))) F := by
                congr 1
                funext l
                simp only [Function.comp_apply, HomogeneousLocalization.algebraMap_apply,
                  HomogeneousLocalization.Away.val_mk, ← Localization.mk_one_eq_algebraMap,
                  Localization.mk_mul, mul_one, one_mul]
            _ = _ := by
                rw [scale]
                have h2 := MvPolynomial.eval₂_comp_left (algebraMap (MvPolynomial (Fin (N + 1)) K)
                  (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) K))))
                  MvPolynomial.C MvPolynomial.X F
                rw [MvPolynomial.eval₂_eta] at h2
                rw [show (fun l => algebraMap (MvPolynomial (Fin (N + 1)) K)
                    (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) K)))
                    (MvPolynomial.X l)) = ⇑(algebraMap (MvPolynomial (Fin (N + 1)) K)
                    (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) K)))) ∘
                    MvPolynomial.X from rfl, ← h2, Localization.mk_pow,
                  ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, Localization.mk_eq_mk_iff,
                  Localization.r_iff_exists]
                refine ⟨1, ?_⟩
                simp only [one_pow, one_mul, mul_one, OneMemClass.coe_one, SubmonoidClass.coe_pow,
                  ← pow_mul]
        rw [← GEN b 2 _ (wcLdpQuad K N a).2]
        simp only [wcLdpQuad, MvPolynomial.eval₂_sum, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_C,
          MvPolynomial.eval₂_X, RingHom.comp_apply]
      show (Proj.awayToSection _ (MvPolynomial.X b)).hom
        (HomogeneousLocalization.Away.mk _ (hX b) 2 _ _) = _
      rw [hmk2, map_sum]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      rw [map_sum]
      refine Finset.sum_congr rfl (fun q _ => ?_)
      rw [map_mul, map_mul, hconst]

  have qs3 : ∀ (K : Type u) [Field K] (n : ℕ) (R : Type u) [CommRing R]
      [Algebra K R] (g : MvPolynomial (Fin n) K →ₐ[K] R),
      (g : MvPolynomial (Fin n) K →+* R).Etale → Algebra.FiniteType K R ∧ ringKrullDim R ≤ n := by
    intro K _ n R _ _ g hg
    have flat_dim : ∀ (P A : Type u) [CommRing P] [CommRing A] [IsLocalRing P]
        [IsLocalRing A] [IsNoetherianRing P] [IsNoetherianRing A] [Algebra P A] [Module.Flat P A]
        [IsLocalHom (algebraMap P A)],
        Ideal.map (algebraMap P A) (IsLocalRing.maximalIdeal P) = IsLocalRing.maximalIdeal A →
        ringKrullDim A = ringKrullDim P := by
      intro P A _ _ _ _ _ _ _ _ _ hmax
      haveI : Algebra.HasGoingDown P A := Algebra.HasGoingDown.of_flat
      haveI : (IsLocalRing.maximalIdeal A).LiesOver (IsLocalRing.maximalIdeal P) :=
        ⟨by rw [Ideal.under_def, IsLocalRing.maximalIdeal_comap]⟩
      have h1 := Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown
        (IsLocalRing.maximalIdeal P) (IsLocalRing.maximalIdeal A)
      have h5 : Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap P A) (IsLocalRing.maximalIdeal P)))
          (IsLocalRing.maximalIdeal A) = ⊥ := by
        rw [Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
        exact hmax.ge
      haveI : Nontrivial (A ⧸ Ideal.map (algebraMap P A) (IsLocalRing.maximalIdeal P)) := by
        rw [Ideal.Quotient.nontrivial_iff, hmax]
        exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top
      rw [h5, Ideal.height_bot, add_zero] at h1
      rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim,
        ← IsLocalRing.maximalIdeal_height_eq_ringKrullDim, h1]
    have polyht : ∀ (n : ℕ) (M : Ideal (MvPolynomial (Fin n) K)), M.IsMaximal →
        M.height = (n : ℕ∞) := by
      intro n
      induction n with
      | zero =>
        intro M hM
        let e := (MvPolynomial.isEmptyAlgEquiv K (Fin 0)).toRingEquiv
        haveI : (Ideal.map e M).IsMaximal := Ideal.map_isMaximal_of_equiv e
        have h2 : Ideal.map e M = ⊥ := Ideal.eq_bot_of_prime _
        rw [← RingEquiv.height_map e M, h2, Ideal.height_bot]
        simp
      | succ n ih =>
        intro M hM
        let e := (MvPolynomial.finSuccEquiv K n).toRingEquiv
        haveI : (Ideal.map e M).IsMaximal := Ideal.map_isMaximal_of_equiv e
        haveI := Ideal.over_under (A := MvPolynomial (Fin n) K) (Ideal.map e M)
        have h3 := Polynomial.height_eq_height_add_one
          (Ideal.under (MvPolynomial (Fin n) K) (Ideal.map e M)) (Ideal.map e M)
        have h4 : (Ideal.under (MvPolynomial (Fin n) K) (Ideal.map e M)).IsMaximal := by
          have := Polynomial.isMaximal_comap_C_of_isJacobsonRing (Ideal.map e M)
          unfold Ideal.under
          rw [Polynomial.algebraMap_eq]
          exact this
        rw [← RingEquiv.height_map e M, h3, ih _ h4]
        push_cast
        rfl
    have zariski : ∀ (S : Type u) [CommRing S] (g : MvPolynomial (Fin n) K →+* S), g.FiniteType →
        ∀ (Q : Ideal S), Q.IsMaximal → (Ideal.comap g Q).IsMaximal := by
      intro S _ g hg Q hQ
      letI := g.toAlgebra
      haveI : Algebra.FiniteType (MvPolynomial (Fin n) K) S := hg
      letI : Field (S ⧸ Q) := Ideal.Quotient.field Q
      haveI : Algebra.FiniteType (MvPolynomial (Fin n) K) (S ⧸ Q) :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ _ Q)
          (Ideal.Quotient.mkₐ_surjective _ Q)
      haveI : Module.Finite (MvPolynomial (Fin n) K) (S ⧸ Q) :=
        finite_of_finite_type_of_isJacobsonRing _ _
      haveI : (⊥ : Ideal (S ⧸ Q)).IsMaximal := Ideal.bot_isMaximal
      have h := Ideal.isMaximal_comap_of_isIntegral_of_isMaximal
        (algebraMap (MvPolynomial (Fin n) K) (S ⧸ Q))
        (fun x => Algebra.IsIntegral.isIntegral x) (⊥ : Ideal (S ⧸ Q))
      have heq : Ideal.comap (algebraMap (MvPolynomial (Fin n) K) (S ⧸ Q)) ⊥ = Ideal.comap g Q := by
        ext x
        rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_bot]
        rw [← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.eq_zero_iff_mem]
        rfl
      rw [heq] at h
      exact h
    have key : ∀ (S : Type u) [CommRing S] (g : MvPolynomial (Fin n) K →+* S), g.Etale →
        ∀ (Q : Ideal S), Q.IsMaximal → Q.height = (n : ℕ∞) := by
      intro S _ g hg Q hQ
      haveI := hQ.isPrime
      letI := g.toAlgebra
      haveI : Algebra.Etale (MvPolynomial (Fin n) K) S := hg
      have hft : g.FiniteType := (inferInstance : Algebra.FiniteType (MvPolynomial (Fin n) K) S)
      have hfl : g.Flat := (inferInstance : Module.Flat (MvPolynomial (Fin n) K) S)
      haveI : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing (MvPolynomial (Fin n) K) S
      have hpmax := zariski S g hft Q hQ
      have hpd := polyht n _ hpmax
      let φ := Localization.localRingHom (Ideal.comap g Q) Q g rfl
      letI : Algebra (Localization.AtPrime (Ideal.comap g Q)) (Localization.AtPrime Q) := φ.toAlgebra
      haveI : IsLocalHom (algebraMap (Localization.AtPrime (Ideal.comap g Q)) (Localization.AtPrime Q)) :=
        Localization.isLocalHom_localRingHom (Ideal.comap g Q) Q g rfl
      haveI : Module.Flat (Localization.AtPrime (Ideal.comap g Q)) (Localization.AtPrime Q) :=
        RingHom.Flat.localRingHom hfl Q (Ideal.comap g Q) rfl
      haveI : IsNoetherianRing (Localization.AtPrime (Ideal.comap g Q)) :=
        IsLocalization.isNoetherianRing (Ideal.comap g Q).primeCompl _ inferInstance
      haveI : IsNoetherianRing (Localization.AtPrime Q) :=
        IsLocalization.isNoetherianRing Q.primeCompl _ inferInstance
      haveI : IsScalarTower (MvPolynomial (Fin n) K) (Localization.AtPrime (Ideal.comap g Q))
          (Localization.AtPrime Q) :=
        IsScalarTower.of_algebraMap_eq (fun x => by
          rw [IsScalarTower.algebraMap_apply (MvPolynomial (Fin n) K) S (Localization.AtPrime Q) x,
            RingHom.algebraMap_toAlgebra φ, Localization.localRingHom_to_map]
          rfl)
      haveI : Algebra.FormallyUnramified S (Localization.AtPrime Q) :=
        Algebra.FormallyUnramified.of_isLocalization Q.primeCompl
      haveI : Algebra.FormallyUnramified (MvPolynomial (Fin n) K) (Localization.AtPrime Q) :=
        Algebra.FormallyUnramified.comp (MvPolynomial (Fin n) K) S (Localization.AtPrime Q)
      haveI : Algebra.FormallyUnramified (Localization.AtPrime (Ideal.comap g Q))
          (Localization.AtPrime Q) :=
        Algebra.FormallyUnramified.localization_base (Ideal.comap g Q).primeCompl
      haveI : Algebra.EssFiniteType (MvPolynomial (Fin n) K) S :=
        Algebra.EssFiniteType.of_finiteType _ _
      haveI : Algebra.EssFiniteType S (Localization.AtPrime Q) :=
        Algebra.EssFiniteType.of_isLocalization _ Q.primeCompl
      haveI : Algebra.EssFiniteType (MvPolynomial (Fin n) K) (Localization.AtPrime Q) :=
        Algebra.EssFiniteType.comp (MvPolynomial (Fin n) K) S (Localization.AtPrime Q)
      haveI : Algebra.EssFiniteType (Localization.AtPrime (Ideal.comap g Q))
          (Localization.AtPrime Q) :=
        Algebra.EssFiniteType.of_comp (MvPolynomial (Fin n) K) _ _
      have hmap := Algebra.FormallyUnramified.map_maximalIdeal
        (R := Localization.AtPrime (Ideal.comap g Q)) (S := Localization.AtPrime Q)
      have hdim := flat_dim _ _ hmap
      rw [IsLocalization.AtPrime.ringKrullDim_eq_height Q (Localization.AtPrime Q),
        IsLocalization.AtPrime.ringKrullDim_eq_height (Ideal.comap g Q)
          (Localization.AtPrime (Ideal.comap g Q))] at hdim
      have hdim' : Q.height = (Ideal.comap g Q).height := by exact_mod_cast hdim
      rw [hdim', hpd]
    letI := (g : MvPolynomial (Fin n) K →+* R).toAlgebra
    haveI : IsScalarTower K (MvPolynomial (Fin n) K) R :=
      IsScalarTower.of_algebraMap_eq (fun c => (g.commutes c).symm)
    haveI : Algebra.Etale (MvPolynomial (Fin n) K) R := hg
    refine ⟨Algebra.FiniteType.trans (S := MvPolynomial (Fin n) K) inferInstance inferInstance, ?_⟩
    rw [ringKrullDim_le_iff_isMaximal_height_le]
    intro Q hQ
    rw [key R _ hg Q hQ]
    rfl

  have qs4 : ∀ (K : Type u) [Field K] (n : ℕ) (R : Type u) [CommRing R]
      [Algebra K R] (g : MvPolynomial (Fin n) K →ₐ[K] R),
      (g : MvPolynomial (Fin n) K →+* R).Etale →
      ∃ D : Fin n → Derivation K R R, ∀ i k, D i (g (MvPolynomial.X k)) = if i = k then 1 else 0 := by
    intro K _ n R _ _ g hg
    letI := (g : MvPolynomial (Fin n) K →+* R).toAlgebra
    haveI : IsScalarTower K (MvPolynomial (Fin n) K) R :=
      IsScalarTower.of_algebraMap_eq (fun c => (g.commutes c).symm)
    haveI : Algebra.Etale (MvPolynomial (Fin n) K) R := hg
    haveI : Algebra.FormallyEtale (MvPolynomial (Fin n) K) R := Algebra.Etale.formallyEtale
    let e := KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K (MvPolynomial (Fin n) K) R
    let B : Module.Basis (Fin n) R Ω[R⁄K] :=
      (Algebra.TensorProduct.basis R (KaehlerDifferential.mvPolynomialBasis K (Fin n))).map e
    refine ⟨fun i => (B.coord i).compDer (KaehlerDifferential.D K R), fun i k => ?_⟩
    have hb : KaehlerDifferential.mvPolynomialBasis K (Fin n) k =
        KaehlerDifferential.D K _ (MvPolynomial.X k) := by
      apply (KaehlerDifferential.mvPolynomialBasis K (Fin n)).repr.injective
      rw [Module.Basis.repr_self, KaehlerDifferential.mvPolynomialBasis_repr_D_X]
    have hB : KaehlerDifferential.D K R (g (MvPolynomial.X k)) = B k := by
      show _ = e ((Algebra.TensorProduct.basis R (KaehlerDifferential.mvPolynomialBasis K (Fin n))) k)
      rw [Algebra.TensorProduct.basis_apply, hb,
        KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply,
        KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D]
      rfl
    show B.coord i (KaehlerDifferential.D K R (g (MvPolynomial.X k))) = _
    rw [hB, Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply]
    by_cases h : i = k
    · subst h; simp
    · rw [if_neg (Ne.symm h), if_neg h]

  have qs5 : ∀ (K : Type u) [Field K] (n : ℕ) (R : Type u) [CommRing R]
      [Algebra K R] (g : MvPolynomial (Fin n) K →ₐ[K] R),
      (g : MvPolynomial (Fin n) K →+* R).Etale → ∀ (P : Ideal R) [P.IsMaximal]
      (χ : R →ₐ[K] K), RingHom.ker χ = P → ∀ (O : Type u) [CommRing O] [IsLocalRing O]
      [Algebra R O] [IsLocalization.AtPrime O P],
      IsLocalRing.maximalIdeal O = Ideal.span (Set.range fun k =>
        algebraMap R O (g (MvPolynomial.X k) - algebraMap K R (χ (g (MvPolynomial.X k))))) := by
    intro K _ n R _ _ g hg P _ χ hχ O _ _ _ _
    set ξ : Fin n → K := fun k => χ (g (MvPolynomial.X k)) with hξ
    set J : Ideal (MvPolynomial (Fin n) K) :=
      Ideal.span (Set.range fun k => MvPolynomial.X k - MvPolynomial.C (ξ k)) with hJ
    have hcomp : χ.comp g = MvPolynomial.aeval ξ :=
      MvPolynomial.algHom_ext (fun k => by simp [ξ])
    have hsub : ∀ p : MvPolynomial (Fin n) K, p - MvPolynomial.C (MvPolynomial.aeval ξ p) ∈ J := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a => simp
      | add p q hp hq =>
        have e : p + q - MvPolynomial.C (MvPolynomial.aeval ξ (p + q)) =
            (p - MvPolynomial.C (MvPolynomial.aeval ξ p)) +
              (q - MvPolynomial.C (MvPolynomial.aeval ξ q)) := by
          simp only [map_add]; ring
        rw [e]; exact J.add_mem hp hq
      | mul_X p k hp =>
        have e : p * MvPolynomial.X k - MvPolynomial.C (MvPolynomial.aeval ξ (p * MvPolynomial.X k)) =
            (p - MvPolynomial.C (MvPolynomial.aeval ξ p)) * MvPolynomial.X k +
              MvPolynomial.C (MvPolynomial.aeval ξ p) * (MvPolynomial.X k - MvPolynomial.C (ξ k)) := by
          simp only [map_mul, MvPolynomial.aeval_X]; ring
        rw [e]
        exact J.add_mem (J.mul_mem_right _ hp) (J.mul_mem_left _ (Ideal.subset_span ⟨k, rfl⟩))
    have hJle : J ≤ RingHom.ker (MvPolynomial.aeval ξ : MvPolynomial (Fin n) K →ₐ[K] K) := by
      rw [hJ, Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      simp [ξ]
    set gr : MvPolynomial (Fin n) K →+* R := (g : MvPolynomial (Fin n) K →+* R) with hgr
    have hQ : Ideal.comap gr P = J := by
      ext p
      rw [Ideal.mem_comap, ← hχ, RingHom.mem_ker]
      constructor
      · intro h
        have h1 : MvPolynomial.aeval ξ p = 0 := by rw [← hcomp]; exact h
        have := hsub p
        rwa [h1, map_zero, sub_zero] at this
      · intro h
        have h2 := hJle h
        rw [RingHom.mem_ker, ← hcomp] at h2
        exact h2
    letI := gr.toAlgebra
    haveI : Algebra.Etale (MvPolynomial (Fin n) K) R := hg
    let Q := Ideal.comap gr P
    let φ := Localization.localRingHom Q P gr rfl
    letI : Algebra (Localization.AtPrime Q) (Localization.AtPrime P) := φ.toAlgebra
    haveI : IsLocalHom (algebraMap (Localization.AtPrime Q) (Localization.AtPrime P)) :=
      Localization.isLocalHom_localRingHom Q P gr rfl
    haveI : IsScalarTower (MvPolynomial (Fin n) K) (Localization.AtPrime Q)
        (Localization.AtPrime P) :=
      IsScalarTower.of_algebraMap_eq (fun x => by
        rw [IsScalarTower.algebraMap_apply (MvPolynomial (Fin n) K) R (Localization.AtPrime P) x,
          RingHom.algebraMap_toAlgebra φ, Localization.localRingHom_to_map]
        rfl)
    haveI : Algebra.FormallyUnramified R (Localization.AtPrime P) :=
      Algebra.FormallyUnramified.of_isLocalization P.primeCompl
    haveI : Algebra.FormallyUnramified (MvPolynomial (Fin n) K) (Localization.AtPrime P) :=
      Algebra.FormallyUnramified.comp (MvPolynomial (Fin n) K) R (Localization.AtPrime P)
    haveI : Algebra.FormallyUnramified (Localization.AtPrime Q) (Localization.AtPrime P) :=
      Algebra.FormallyUnramified.localization_base Q.primeCompl
    haveI : Algebra.EssFiniteType (MvPolynomial (Fin n) K) R :=
      Algebra.EssFiniteType.of_finiteType _ _
    haveI : Algebra.EssFiniteType R (Localization.AtPrime P) :=
      Algebra.EssFiniteType.of_isLocalization _ P.primeCompl
    haveI : Algebra.EssFiniteType (MvPolynomial (Fin n) K) (Localization.AtPrime P) :=
      Algebra.EssFiniteType.comp (MvPolynomial (Fin n) K) R (Localization.AtPrime P)
    haveI : Algebra.EssFiniteType (Localization.AtPrime Q) (Localization.AtPrime P) :=
      Algebra.EssFiniteType.of_comp (MvPolynomial (Fin n) K) _ _
    have hmap := Algebra.FormallyUnramified.map_maximalIdeal
      (R := Localization.AtPrime Q) (S := Localization.AtPrime P)
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal Q (Localization.AtPrime Q), Ideal.map_map]
      at hmap
    have hce : (algebraMap (Localization.AtPrime Q) (Localization.AtPrime P)).comp
        (algebraMap (MvPolynomial (Fin n) K) (Localization.AtPrime Q)) =
          (algebraMap R (Localization.AtPrime P)).comp gr :=
      RingHom.ext fun x => Localization.localRingHom_to_map Q P gr rfl x
    have hQJ : Q = J := hQ
    rw [hce, ← Ideal.map_map, hQJ, hJ, Ideal.map_span,
      Ideal.map_span, ← Set.range_comp, ← Set.range_comp] at hmap
    let e := IsLocalization.algEquiv P.primeCompl (Localization.AtPrime P) O
    haveI := IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime P)
    have hmO : IsLocalRing.maximalIdeal O =
        Ideal.map e (IsLocalRing.maximalIdeal (Localization.AtPrime P)) :=
      (IsLocalRing.eq_maximalIdeal (Ideal.map_isMaximal_of_equiv e)).symm
    rw [hmO, ← hmap, Ideal.map_span, ← Set.range_comp]
    refine congrArg Ideal.span (congrArg Set.range (funext fun k => ?_))
    have hC : gr (MvPolynomial.C (ξ k)) = algebraMap K R (ξ k) := by
      show g (MvPolynomial.C (ξ k)) = _
      rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]
    show e ((algebraMap R (Localization.AtPrime P)) (gr (MvPolynomial.X k - MvPolynomial.C (ξ k)))) = _
    rw [AlgEquiv.commutes, map_sub, hC]
    rfl

  have qs6 : ∀ (R O : Type u) [CommRing R] [CommRing O] [Algebra R O]
      (M : Submonoid R) [IsLocalization M O] (D : R →+ R),
      (∀ a b, D (a * b) = a * D b + b * D a) →
      ∃ δ : O →+ O, (∀ f g, δ (f * g) = f * δ g + g * δ f) ∧
        ∀ r, δ (algebraMap R O r) = algebraMap R O (D r) := by
    intro R O _ _ _ M _ D hD
    have hD1 : D 1 = 0 := by
      have h := hD 1 1
      simp only [mul_one, one_mul] at h
      have : D 1 + D 1 = D 1 + 0 := by rw [add_zero]; exact h.symm
      exact add_left_cancel this
    let ψ : R →+* TrivSqZeroExt O O :=
      { toFun := fun r => TrivSqZeroExt.inl (algebraMap R O r) +
          TrivSqZeroExt.inr (algebraMap R O (D r))
        map_one' := by
          ext <;> simp [hD1]
        map_mul' := fun a b => by
          ext
          · simp
          · simp [hD, TrivSqZeroExt.snd_mul, Algebra.smul_def]
            ring
        map_zero' := by
          ext <;> simp
        map_add' := fun a b => by
          ext
          · simp
          · simp [Algebra.smul_def] }
    have hψf : ∀ r, (ψ r).fst = algebraMap R O r := fun r => by simp [ψ]
    have hψs : ∀ r, (ψ r).snd = algebraMap R O (D r) := fun r => by simp [ψ, Algebra.smul_def]
    have hunit : ∀ y : M, IsUnit (ψ y) := fun y =>
      TrivSqZeroExt.isUnit_iff_isUnit_fst.mpr (by rw [hψf]; exact IsLocalization.map_units O y)
    let L : O →+* TrivSqZeroExt O O := IsLocalization.lift hunit
    have hL : ∀ r, L (algebraMap R O r) = ψ r := fun r => IsLocalization.lift_eq hunit r
    let fstR : TrivSqZeroExt O O →+* O :=
      { toFun := TrivSqZeroExt.fst
        map_one' := TrivSqZeroExt.fst_one
        map_mul' := TrivSqZeroExt.fst_mul
        map_zero' := TrivSqZeroExt.fst_zero
        map_add' := TrivSqZeroExt.fst_add }
    have hfst : fstR.comp L = RingHom.id O := IsLocalization.ringHom_ext M (RingHom.ext fun r => by
      show (L (algebraMap R O r)).fst = algebraMap R O r
      rw [hL, hψf])
    have hfst' : ∀ y, (L y).fst = y := fun y => RingHom.congr_fun hfst y
    let δ : O →+ O :=
      { toFun := fun y => (L y).snd
        map_zero' := by simp
        map_add' := fun a b => by simp }
    refine ⟨δ, fun f g => ?_, fun r => ?_⟩
    · show (L (f * g)).snd = f * (L g).snd + g * (L f).snd
      rw [map_mul, TrivSqZeroExt.snd_mul, op_smul_eq_smul, hfst', hfst', smul_eq_mul, smul_eq_mul]
    · show (L (algebraMap R O r)).snd = _
      rw [hL, hψs]

  have qs7 : ∀ (K : Type u) [Field K] (A R : Type u) [CommRing A] [CommRing R]
      [Algebra K A] [Algebra K R] [Algebra A R] [IsScalarTower K A R] (ι' : Type) (u : ι' → A),
      (∀ a : A, a ∈ Subring.closure (Set.range u ∪ Set.range (algebraMap K A))) →
      ∀ (f : A) [IsLocalization.Away f R] (χ : R →ₐ[K] K),
      RingHom.ker χ = Ideal.span (Set.range fun p =>
        algebraMap A R (u p) - algebraMap K R (χ (algebraMap A R (u p)))) := by
    intro K _ A R _ _ _ _ _ _ ι' u hgen f _ χ
    set I := Ideal.span (Set.range fun p =>
        algebraMap A R (u p) - algebraMap K R (χ (algebraMap A R (u p)))) with hI
    have key : ∀ a : A, algebraMap A R a - algebraMap K R (χ (algebraMap A R a)) ∈ I := by
      intro a
      refine Subring.closure_induction (fun x hx => ?_) ?_ ?_ (fun x y _ _ hx hy => ?_)
        (fun x _ hx => ?_) (fun x y _ _ hx hy => ?_) (hgen a)
      · rcases hx with ⟨p, rfl⟩ | ⟨c, rfl⟩
        · exact Ideal.subset_span ⟨p, rfl⟩
        · rw [← IsScalarTower.algebraMap_apply, AlgHom.commutes, Algebra.algebraMap_self,
            RingHom.id_apply, sub_self]
          exact I.zero_mem
      · simp
      · simp
      · have e : algebraMap A R (x + y) - algebraMap K R (χ (algebraMap A R (x + y))) =
            (algebraMap A R x - algebraMap K R (χ (algebraMap A R x))) +
              (algebraMap A R y - algebraMap K R (χ (algebraMap A R y))) := by
          simp only [map_add]; ring
        rw [e]; exact I.add_mem hx hy
      · have e : algebraMap A R (-x) - algebraMap K R (χ (algebraMap A R (-x))) =
            -(algebraMap A R x - algebraMap K R (χ (algebraMap A R x))) := by
          simp only [map_neg]; ring
        rw [e]; exact I.neg_mem hx
      · have e : algebraMap A R (x * y) - algebraMap K R (χ (algebraMap A R (x * y))) =
            (algebraMap A R x - algebraMap K R (χ (algebraMap A R x))) * algebraMap A R y +
              algebraMap K R (χ (algebraMap A R x)) *
                (algebraMap A R y - algebraMap K R (χ (algebraMap A R y))) := by
          simp only [map_mul]; ring
        rw [e]; exact I.add_mem (I.mul_mem_right _ hx) (I.mul_mem_left _ hy)
    apply le_antisymm
    · intro r hr
      rw [RingHom.mem_ker] at hr
      obtain ⟨k, a, h⟩ := IsLocalization.Away.surj f r
      have hu : IsUnit (algebraMap A R f ^ k) := (IsLocalization.Away.algebraMap_isUnit f).pow k
      have h1 : χ (algebraMap A R a) = 0 := by rw [← h, map_mul, hr, zero_mul]
      have h2 := key a
      rw [h1, map_zero, sub_zero] at h2
      obtain ⟨v, hv⟩ := hu
      have e : r = algebraMap A R a * ↑v⁻¹ := by rw [← h, ← hv, mul_assoc, Units.mul_inv, mul_one]
      rw [e]; exact I.mul_mem_right _ h2
    · rw [Ideal.span_le]
      rintro _ ⟨p, rfl⟩
      simp [RingHom.mem_ker]

  have qs8 : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : Type u) [CommRing R]
      [Algebra K R] [Algebra.FiniteType K R] (P : Ideal R) [P.IsMaximal],
      ∃ χ : R →ₐ[K] K, RingHom.ker χ = P ∧
        ∀ (O : Type u) [CommRing O] [IsLocalRing O] [Algebra R O] [IsLocalization.AtPrime O P],
          (∀ r, algebraMap R O r - algebraMap R O (algebraMap K R (χ r)) ∈
              IsLocalRing.maximalIdeal O) ∧
          ∀ y : O, ∃ c : K, y - algebraMap R O (algebraMap K R c) ∈ IsLocalRing.maximalIdeal O := by
    intro K _ _ R _ _ _ P _
    letI : Field (R ⧸ P) := Ideal.Quotient.field P
    haveI : Algebra.FiniteType K (R ⧸ P) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ K P) (Ideal.Quotient.mkₐ_surjective K P)
    haveI : Module.Finite K (R ⧸ P) := finite_of_finite_type_of_isJacobsonRing K (R ⧸ P)
    haveI : Algebra.IsIntegral K (R ⧸ P) := Algebra.IsIntegral.of_finite K _
    have hbij : Function.Bijective (algebraMap K (R ⧸ P)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let e : K ≃ₐ[K] R ⧸ P := AlgEquiv.ofBijective (Algebra.ofId K (R ⧸ P)) hbij
    let χ : R →ₐ[K] K := (e.symm : R ⧸ P →ₐ[K] K).comp (Ideal.Quotient.mkₐ K P)
    have hχ : ∀ r, Ideal.Quotient.mk P (algebraMap K R (χ r)) = Ideal.Quotient.mk P r := by
      intro r
      rw [Ideal.Quotient.mk_algebraMap]
      exact e.apply_symm_apply (Ideal.Quotient.mkₐ K P r)
    have hmem : ∀ r, r - algebraMap K R (χ r) ∈ P := fun r => Ideal.Quotient.eq.mp (hχ r).symm
    have hker : RingHom.ker χ = P := by
      ext r
      rw [RingHom.mem_ker]
      constructor
      · intro h
        have := hmem r
        rwa [h, map_zero, sub_zero] at this
      · intro h
        have h2 : algebraMap K R (χ r) ∈ P := by
          have := P.sub_mem h (hmem r)
          rwa [sub_sub_cancel] at this
        have h3 : algebraMap K (R ⧸ P) (χ r) = 0 := by
          rw [← Ideal.Quotient.mk_algebraMap]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr h2
        exact (algebraMap K (R ⧸ P)).injective (h3.trans (map_zero _).symm)
    refine ⟨χ, hker, fun O _ _ _ _ => ⟨fun r => ?_, fun y => ?_⟩⟩
    · rw [← map_sub]
      exact (IsLocalization.AtPrime.to_map_mem_maximal_iff O P _).mpr (hmem r)
    · obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl y
      have hs : χ s ≠ 0 := by
        intro h
        apply s.2
        have : (s : R) ∈ RingHom.ker χ := RingHom.mem_ker.mpr h
        rwa [hker] at this
      refine ⟨χ a / χ s, ?_⟩
      have e1 : IsLocalization.mk' O a s = algebraMap R O a * IsLocalization.mk' O (1 : R) s :=
        IsLocalization.mk'_eq_mul_mk'_one a s
      have e2 : IsLocalization.mk' O (1 : R) s * algebraMap R O s = 1 := by
        rw [IsLocalization.mk'_spec, map_one]
      have e3 : IsLocalization.mk' O a s - algebraMap R O (algebraMap K R (χ a / χ s)) =
          algebraMap R O (a - algebraMap K R (χ a / χ s) * s) * IsLocalization.mk' O (1 : R) s := by
        rw [map_sub, map_mul, e1]
        linear_combination (algebraMap R O (algebraMap K R (χ a / χ s))) * e2
      have e4 : a - algebraMap K R (χ a / χ s) * s ∈ P := by
        have : a - algebraMap K R (χ a / χ s) * s ∈ RingHom.ker χ := by
          rw [RingHom.mem_ker, map_sub, map_mul, AlgHom.commutes, Algebra.algebraMap_self,
            RingHom.id_apply, div_mul_cancel₀ _ hs, sub_self]
        rwa [hker] at this
      show IsLocalization.mk' O a s - _ ∈ _
      rw [e3]
      exact Ideal.mul_mem_right _ _ ((IsLocalization.AtPrime.to_map_mem_maximal_iff O P _).mpr e4)

  have qs9 : ∀ (K : Type u) [Field K] (N : ℕ) (Y : Scheme.{u}) (sY : Y ⟶ Spec (.of K))
      (κ : Y ⟶ wcProjK K N), κ ≫ wcProjKStr K N = sY → ∀ (b : Fin (N + 1)) (c : K),
      (κ.app (wcSgD K N b)).hom (((wcProjK K N).presheaf.map (homOfLE (le_top : wcSgD K N b ≤ ⊤)).op).hom
          ((wcProjKStr K N).appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c))) =
        (Y.presheaf.map (homOfLE (le_top : κ ⁻¹ᵁ wcSgD K N b ≤ ⊤)).op).hom
          (sY.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) := by
    intro K _ N Y sY κ hκY b c
    subst hκY
    have h := congrArg (fun φ => φ.hom ((wcProjKStr K N).appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)))
      (Scheme.Hom.naturality κ (homOfLE (le_top : wcSgD K N b ≤ ⊤)).op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h
    rw [h, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    rfl

  have qs10 : ∀ (K : Type u) [Field K] (n : ℕ) (Y : Scheme.{u})
      (s : Y ⟶ Spec (.of K)) [SmoothOfRelativeDimension n s] (V : Y.Opens), IsAffineOpen V →
      ∀ x ∈ V, ∃ (f : Γ(Y, V)) (g : MvPolynomial (Fin n) K →+* Γ(Y, Y.basicOpen f)),
        x ∈ Y.basicOpen f ∧ g.Etale ∧
        g.comp MvPolynomial.C = (Y.presheaf.map (homOfLE (le_top : Y.basicOpen f ≤ ⊤)).op).hom.comp
          (s.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom) := by
    intro K _ n Y s _ V hV x hxV
    obtain ⟨U, hU, V', hV', hxV', e, hss⟩ :=
      SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := n) (f := s) x
    obtain ⟨g₀, hg₀C, hg₀⟩ := hss.exists_etale_mvPolynomial
    have hUtop : U = ⊤ := by
      have h1 : s x ∈ U := e hxV'
      refine eq_top_iff.mpr (fun w _ => ?_)
      rwa [Subsingleton.elim w (s x)]
    subst hUtop
    let e₀ : K ≃+* Γ(Spec (.of K), ⊤) :=
      (Scheme.ΓSpecIso (CommRingCat.of K)).symm.commRingCatIsoToRingEquiv
    let g₁ := g₀.comp (MvPolynomial.mapEquiv (Fin n) e₀).toRingHom
    have hg₁ : g₁.Etale := RingHom.Etale.respectsIso.2 g₀ (MvPolynomial.mapEquiv (Fin n) e₀) hg₀
    obtain ⟨f, f', hff', hxf⟩ := exists_basicOpen_le_affine_inter hV hV' x ⟨hxV, hxV'⟩
    let r : Γ(Y, V') →+* Γ(Y, Y.basicOpen f') :=
      (Y.presheaf.map (homOfLE (Y.basicOpen_le f')).op).hom
    have hr : r.Etale := by
      haveI := hV'.isLocalization_basicOpen f'
      haveI : Algebra.Etale Γ(Y, V') Γ(Y, Y.basicOpen f') := Algebra.Etale.of_isLocalizationAway f'
      exact RingHom.etale_algebraMap.mpr inferInstance
    have h : Opposite.op (Y.basicOpen f') = Opposite.op (Y.basicOpen f) := congrArg Opposite.op hff'.symm
    let ι₁ : Γ(Y, Y.basicOpen f') ≃+* Γ(Y, Y.basicOpen f) :=
      (Y.presheaf.mapIso (eqToIso h)).commRingCatIsoToRingEquiv
    have hle : Y.basicOpen f ≤ s ⁻¹ᵁ ⊤ := fun _ _ => trivial
    have key : ∀ y, ι₁ (r ((s.appLE ⊤ V' e).hom y)) = (s.appLE ⊤ (Y.basicOpen f) hle).hom y := by
      intro y
      change ((s.appLE ⊤ V' e ≫ Y.presheaf.map (homOfLE (Y.basicOpen_le f')).op) ≫
        Y.presheaf.map (eqToHom h)).hom y = _
      rw [Scheme.Hom.appLE_map, Scheme.Hom.appLE_map]
    refine ⟨f, ι₁.toRingHom.comp (r.comp g₁), hxf, ?_, ?_⟩
    · exact RingHom.Etale.respectsIso.1 _ ι₁ (RingHom.Etale.stableUnderComposition _ _ hg₁ hr)
    · refine RingHom.ext fun c => ?_
      have h1 : g₁ (MvPolynomial.C c) = (s.appLE ⊤ V' e).hom ((Scheme.ΓSpecIso (.of K)).inv.hom c) := by
        show g₀ ((MvPolynomial.mapEquiv (Fin n) e₀) (MvPolynomial.C c)) = _
        rw [MvPolynomial.mapEquiv_apply, MvPolynomial.map_C]
        exact RingHom.congr_fun hg₀C _
      show ι₁ (r (g₁ (MvPolynomial.C c))) = _
      rw [h1, key]
      rfl


  haveI := hι
  have hXb : ∀ b : Fin (N + 1), (MvPolynomial.X b : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 := fun b =>
