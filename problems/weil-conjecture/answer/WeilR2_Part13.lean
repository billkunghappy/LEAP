hh x)) q = eG V x (κ q)) → ∀ (U : Z.Etale), IsAffine U.left → ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (E : I ⥤ S.Etale) (πE : ∀ i, U.left ⟶ (E.obj i).left) (hπE : ∀ i, πE i ≫ (E.obj i).hom = U.hom ≫ p), (∀ {i i' : I} (t : i ⟶ i'), πE i ≫ (E.map t).left = πE i') → (∀ (T : Scheme.{u}) (w : ∀ i, T ⟶ (E.obj i).left), (∀ {i i' : I} (t : i ⟶ i'), w i ≫ (E.map t).left = w i') → ∃! w₀ : T ⟶ U.left, ∀ i, w₀ ≫ πE i = w i) → (∀ i, IsAffine (E.obj i).left) → (∀ {i i' : I} (t : i ⟶ i'), IsAffineHom (E.map t).left) → Function.Injective (β.hom.app (Opposite.op U)).hom :=
by
  intro S Z P P' p k _ hP kP hpb m F ρ hρU eG heG eH β hβ U hU I _ _ E πE hπE hcomp hlimE haffE htrE

  have sq : IsPullback (Limits.pullback.snd U.hom hP ≫ kP) (Limits.pullback.fst U.hom hP) k
