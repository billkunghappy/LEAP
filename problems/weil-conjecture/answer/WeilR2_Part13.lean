        refine IsPushout.of_iso P0 (Iso.refl _) e.toCommRingCatIso (Iso.refl _) e'.toCommRingCatIso
          ?_ ?_ ?_ ?_
        · apply CommRingCat.hom_ext
          apply RingHom.ext
          intro c
          exact heC c
        · simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
        · apply CommRingCat.hom_ext
          apply RingHom.ext
          intro p
          exact (hcompat p).symm
        · apply CommRingCat.hom_ext
          apply RingHom.ext
          intro c
          exact he'C c
      have hj : Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
            Nat.one_pos ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0)))) =
          Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (Submonoid.powers (MvPolynomial.X a))).comp
            (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0)))) := by
        rw [← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hj' : Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
            (f.map_mem (hX a)) Nat.one_pos ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) =
          Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
            (Submonoid.powers (f (MvPolynomial.X a)))).comp
            (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) := by
        rw [← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      rw [hj, hj']
      exact isPullback_SpecMap_of_isPushout _ _ _ _ P
    have hcov : (⨆ a : Fin (N + 1), (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F)
        (MvPolynomial.X a) (hX a) Nat.one_pos).opensRange) = ⊤ := by
      simp only [Proj.opensRange_awayι]
      exact Proj.iSup_basicOpen_eq_top _ _ (hspan F)
    have hcomm : ∀ a : Fin (N + 1),
        Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
            (f.map_mem (hX a)) Nat.one_pos ≫ Proj.map f hf =
          Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))) ≫
            Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
              Nat.one_pos := fun a =>
      Proj.awayι_comp_map f hf Nat.one_pos (MvPolynomial.X a) (hX a)
    have hpre : ∀ a : Fin (N + 1), Proj.map f hf ⁻¹ᵁ
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
          Nat.one_pos).opensRange =
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
            (f.map_mem (hX a)) Nat.one_pos).opensRange := fun a => by
      rw [Proj.opensRange_awayι, Proj.opensRange_awayι, Proj.map_preimage_basicOpen]
    have H := s6 (Proj.map f hf)
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))))
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0))))
      (Spec.map (CommRingCat.ofHom (algebraMap F F')))
      (fun a : Fin (N + 1) => Spec (CommRingCat.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a))))
      (fun a : Fin (N + 1) => Spec (CommRingCat.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a)))))
      (fun a => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a)
        (hX a) Nat.one_pos)
      (fun a => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
        (f.map_mem (hX a)) Nat.one_pos)
      (fun a => Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))))
      hcov hcomm hpre hchart
    subst hfdef
    exact H

  have hQconn : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ Spec (.of L)),
      ConnectedSpace ↥(Limits.pullback (ιZ ≫ w) t) := by
    intro Ω _ _ t

    have hwQ : (Limits.pullback.fst (ιZ ≫ w) t ≫ ιZ) ≫ w = Limits.pullback.snd (ιZ ≫ w) t ≫ t := by
      rw [Category.assoc]; exact Limits.pullback.condition
    let g := Limits.pullback.lift (Limits.pullback.fst (ιZ ≫ w) t ≫ ιZ)
      (Limits.pullback.snd (ιZ ≫ w) t) hwQ
    have hg1 : g ≫ Limits.pullback.fst w t = Limits.pullback.fst (ιZ ≫ w) t ≫ ιZ :=
      Limits.pullback.lift_fst _ _ _
    have hg2 : g ≫ Limits.pullback.snd w t = Limits.pullback.snd (ιZ ≫ w) t :=
      Limits.pullback.lift_snd _ _ _
    have hO : IsPullback (g ≫ Limits.pullback.snd w t) (Limits.pullback.fst (ιZ ≫ w) t) t
        (ιZ ≫ w) := by
      rw [hg2]; exact (IsPullback.of_hasPullback _ _).flip
    have hP : IsPullback g (Limits.pullback.fst (ιZ ≫ w) t) (Limits.pullback.fst w t) ιZ :=
      IsPullback.of_right hO hg1 (IsPullback.of_hasPullback w t).flip
    haveI hgc : IsClosedImmersion g :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hP.flip hιZ
    have hrg : Set.range g = (Limits.pullback.fst w t) ⁻¹' Set.range ιZ := by
      ext q
      constructor
      · rintro ⟨z, rfl⟩
        refine ⟨Limits.pullback.fst (ιZ ≫ w) t z, ?_⟩
        show (Limits.pullback.fst (ιZ ≫ w) t ≫ ιZ) z = (g ≫ Limits.pullback.fst w t) z
        rw [hg1]
      · intro hq
        rw [← Scheme.Pullback.range_fst] at hq
        obtain ⟨r, hr⟩ := hq
        refine ⟨hP.isoPullback.inv r, ?_⟩
        have e2 : hP.isoPullback.inv ≫ g = Limits.pullback.fst (Limits.pullback.fst w t) ιZ := by
          rw [Iso.inv_comp_eq, hP.isoPullback_hom_fst]
        show (hP.isoPullback.inv ≫ g) r = q
        rw [e2]
        exact hr

    letI : Algebra L Ω := (Spec.preimage t).hom.toAlgebra
    have ht : Spec.map (CommRingCat.ofHom (algebraMap L Ω)) = t := Spec.map_preimage t
    have hPB := PB M L Ω
    rw [ht] at hPB
    have hκ1 : (Limits.pullback.fst w t ≫ κ) ≫ wcProjKStr L M = Limits.pullback.snd w t ≫ t := by
      rw [Category.assoc, hκw]; exact Limits.pullback.condition
    let κt := hPB.lift (Limits.pullback.fst w t ≫ κ) (Limits.pullback.snd w t) hκ1
    have hκt1 : κt ≫ wcLdpProjMap L Ω M = Limits.pullback.fst w t ≫ κ := hPB.lift_fst _ _ _
    have hκt2 : κt ≫ wcProjKStr Ω M = Limits.pullback.snd w t := hPB.lift_snd _ _ _
    have hO2 : IsPullback (κt ≫ wcProjKStr Ω M) (Limits.pullback.fst w t) t
        (κ ≫ wcProjKStr L M) := by
      rw [hκt2, hκw]; exact (IsPullback.of_hasPullback w t).flip
    have hP2 : IsPullback κt (Limits.pullback.fst w t) (wcLdpProjMap L Ω M) κ :=
      IsPullback.of_right hO2 hκt1 hPB.flip
    have hκtc : IsClosedImmersion κt :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hP2.flip hκ
    have hbo : ∀ (G : MvPolynomial (Fin (M + 1)) L) (x : ↥(Limits.pullback w t)),
        κt x ∈ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω)
          MvPolynomial.gradedAlgebra (MvPolynomial.map (algebraMap L Ω) G) ↔
        κ (Limits.pullback.fst w t x) ∈ @Proj.basicOpen _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L) MvPolynomial.gradedAlgebra G := by
      intro G x
      letI := (MvPolynomial.gradedAlgebra :
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L))
      letI := (MvPolynomial.gradedAlgebra :
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω))
      obtain ⟨hf, ehf⟩ : ∃ h, wcLdpProjMap L Ω M = Proj.map (wcLdpGrHom L Ω M) h := ⟨_, rfl⟩
      have h1 := Proj.map_preimage_basicOpen (wcLdpGrHom L Ω M) hf G
      have e1 : κ (Limits.pullback.fst w t x) = wcLdpProjMap L Ω M (κt x) := by
        show (Limits.pullback.fst w t ≫ κ) x = (κt ≫ wcLdpProjMap L Ω M) x
        rw [hκt1]
      have h2 : (Proj.map (wcLdpGrHom L Ω M) hf) (κt x) ∈
          Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L) G ↔
          κt x ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω)
            (wcLdpGrHom L Ω M G) := by
        rw [← h1]; exact (Scheme.Hom.mem_preimage _).symm
      rw [e1, ehf]
      exact h2.symm

    haveI : IrreducibleSpace ↥(Limits.pullback w t) :=
      (geometrically_iff_of_isClosedUnderIsomorphisms.mp
        (GeometricallyIrreducible.geometrically_irreducibleSpace (f := w))) Ω t
    haveI : SmoothOfRelativeDimension e (Limits.pullback.snd w t) :=
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension e)
        (IsPullback.of_hasPullback w t) inferInstance

    have hHom : (MvPolynomial.map (algebraMap L Ω)
        (H : MvPolynomial (Fin (M + 1)) L)).IsHomogeneous 1 :=
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mp H.2).map _
    have hHom2 : ((MvPolynomial.map (algebraMap L Ω)
        (H : MvPolynomial (Fin (M + 1)) L)) ^ 2).IsHomogeneous 2 := by
      have := hHom.pow 2
      rwa [one_mul] at this
    let G₂ : MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω 2 :=
      ⟨(MvPolynomial.map (algebraMap L Ω) (H : MvPolynomial (Fin (M + 1)) L)) ^ 2,
        (MvPolynomial.mem_homogeneousSubmodule 2 _).mpr hHom2⟩
    have hconn := wc_ldp_quadric_section_connected Ω M e he (Limits.pullback w t)
      (Limits.pullback.snd w t) κt hκtc hκt2 G₂
    have hset : {x : ↥(Limits.pullback w t) | wcLdpZero Ω M κt G₂ x} = Set.range g := by
      ext x
      have hpow : (G₂ : MvPolynomial (Fin (M + 1)) Ω) =
          (MvPolynomial.map (algebraMap L Ω) (H : MvPolynomial (Fin (M + 1)) L)) ^ 2 := rfl
      rw [Set.mem_setOf_eq, s5 Ω M _ κt G₂ x, hrg, Set.mem_preimage, hrange, Set.mem_setOf_eq,
        hpow, Proj.basicOpen_pow _ _ 2 two_pos, hbo]
    rw [hset] at hconn
    haveI : ConnectedSpace ↥(Set.range g) := isConnected_iff_connectedSpace.mp hconn
    exact ((Scheme.Hom.isClosedEmbedding g).isEmbedding.toHomeomorph).symm.surjective.connectedSpace
      ((Scheme.Hom.isClosedEmbedding g).isEmbedding.toHomeomorph).symm.continuous

  rw [GeometricallyIrreducible.eq_geometrically]
  intro K _ y V fst snd h

  haveI : Smooth snd := MorphismProperty.of_isPullback (P := @Smooth) h inferInstance
  haveI : IsLocallyNoetherian V := LocallyOfFiniteType.isLocallyNoetherian snd

  haveI : ConnectedSpace V := by
    let yb : Spec (.of (AlgebraicClosure K)) ⟶ Spec (.of K) :=
      Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
    haveI := hQconn (AlgebraicClosure K) (yb ≫ y)
    have hQ := IsPullback.of_hasPullback (ιZ ≫ w) (yb ≫ y)
    have w0 : Limits.pullback.fst (ιZ ≫ w) (yb ≫ y) ≫ (ιZ ≫ w) =
        (Limits.pullback.snd (ιZ ≫ w) (yb ≫ y) ≫ yb) ≫ y := by
      rw [Limits.pullback.condition, Category.assoc]
    let c := h.lift _ _ w0
    have hc1 : c ≫ fst = Limits.pullback.fst (ιZ ≫ w) (yb ≫ y) := h.lift_fst _ _ w0
    have hc2 : c ≫ snd = Limits.pullback.snd (ιZ ≫ w) (yb ≫ y) ≫ yb := h.lift_snd _ _ w0
    have houter : IsPullback (c ≫ fst) (Limits.pullback.snd (ιZ ≫ w) (yb ≫ y)) (ιZ ≫ w)
        (yb ≫ y) := by
      rw [hc1]; exact hQ
    have hc : IsPullback c (Limits.pullback.snd (ιZ ≫ w) (yb ≫ y)) snd yb :=
      IsPullback.of_right houter hc2 h
    haveI : Surjective c := MorphismProperty.of_isPullback (P := @Surjective) hc.flip inferInstance
    exact Function.Surjective.connectedSpace (Surjective.surj (f := c)) c.continuous

  have hdom : ∀ v : V, IsDomain (V.presheaf.stalk v) := by
    intro v
    obtain ⟨U, hU, O, hO, hvO, e', hss⟩ := Smooth.exists_isStandardSmooth snd v
    letI := (Scheme.Hom.appLE snd U O e').hom.toAlgebra
    have hss' : Algebra.IsStandardSmooth Γ(Spec (.of K), U) Γ(V, O) := hss
    obtain ⟨ι, σ, hσ, hι, ⟨P⟩⟩ := hss'.out
    have hrel : RingHom.IsStandardSmoothOfRelativeDimension P.dimension
        (Scheme.Hom.appLE snd U O e').hom := ⟨⟨ι, σ, hσ, hι, P, rfl⟩⟩
    have himg : O.ι ''ᵁ ⊤ = O := Scheme.Opens.ι_image_top O
    have hsmV : SmoothOfRelativeDimension P.dimension (O.ι ≫ snd) := by
      haveI : IsAffine (O : Scheme) := hO
      have e2 : ⊤ ≤ O.ι ⁻¹ᵁ O := (Scheme.Opens.ι_preimage_self O).ge
      have e'' : ⊤ ≤ (O.ι ≫ snd) ⁻¹ᵁ U := by
        intro z hz
        exact e' (e2 hz)
      refine SmoothOfRelativeDimension.mk (fun x => ⟨U, hU, ⊤, isAffineOpen_top _, trivial,
        e'', ?_⟩)
      rw [← Scheme.Hom.appLE_comp_appLE O.ι snd U O ⊤ e' e2, CommRingCat.hom_comp,
        Scheme.Opens.ι_appLE]
      have hle : O.ι ''ᵁ ⊤ ≤ O := himg.le
      haveI : IsIso (homOfLE hle) :=
        ⟨⟨homOfLE himg.ge, Subsingleton.elim _ _, Subsingleton.elim _ _⟩⟩
      have h0 : RingHom.IsStandardSmoothOfRelativeDimension 0
          (V.presheaf.map (homOfLE hle).op).hom :=
        RingHom.IsStandardSmoothOfRelativeDimension.equiv
          (asIso (V.presheaf.map (homOfLE hle).op)).commRingCatIsoToRingEquiv
      have := h0.comp hrel
      rwa [zero_add] at this
    have hV' := wcpa_smooth_stalk_isDomain K O (O.ι ≫ snd) P.dimension ⟨v, hvO⟩
    exact MulEquiv.isDomain _
      (Scheme.Opens.stalkIso O ⟨v, hvO⟩).symm.commRingCatIsoToRingEquiv.toMulEquiv
  exact wcpa_irreducible_of_connected_domain_stalks V hdom

theorem wc_ldnm_complete_predatum_bc (F' : Type u) [Finite F'] [Field F']
    (Y : Over (Spec (.of F'))) [GeometricallyIrreducible Y.hom] [IsProper Y.hom] (n : ℕ)
    [SmoothOfRelativeDimension n Y.hom] (hn2 : 2 ≤ n)
    (F₁ : Type u) [Field F₁] [Finite F₁] [Algebra F' F₁] (P : wcPreDatum F' F₁ Y n) :
    ∃ (F'' : Type u) (_ : Field F'') (_ : Finite F'') (_ : Algebra F' F'') (_ : Algebra F₁ F'')
      (D : wcLefschetzDatum F' F'' Y n) (ρ : (wcP1Over F'').left ⟶ (wcP1Over F₁).left)
      (β : D.Yt.left ⟶ P.Yt.left) (e : D.m = P.m),
      IsPullback ρ (wcP1Over F'').hom (wcP1Over F₁).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F₁ F''))) ∧
      IsPullback β D.f P.f ρ ∧
      ∀ i, D.S i ≫ ρ = Spec.map (CommRingCat.ofHom (algebraMap F₁ F'')) ≫ P.S (Fin.cast e i) :=
by
  classical

  have hbc : ∀ (K L : Type u) [Field K] [Field L] [Finite K] [Finite L] [Algebra F' K]
      [Algebra K L] [Algebra F' L] [IsScalarTower F' K L] (P : wcPreDatum F' K Y n),
      ∃ (P₂ : wcPreDatum F' L Y n) (ρ : (wcP1Over L).left ⟶ (wcP1Over K).left)
        (β : P₂.Yt.left ⟶ P.Yt.left) (e : P₂.m = P.m),
        IsPullback ρ (wcP1Over L).hom (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K L))) ∧
        IsPullback β P₂.f P.f ρ ∧
        ∀ i, P₂.S i ≫ ρ = Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ P.S (Fin.cast e i) := by
    intro K L _ _ _ _ _ _ _ _ P
    haveI := P.gi
    haveI := P.proper
    haveI := P.smooth

    have MIcomp : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C),
        (∀ x, Ideal.map (f.stalkMap x).hom (IsLocalRing.maximalIdeal _) = IsLocalRing.maximalIdeal _) →
        (∀ y, Ideal.map (g.stalkMap y).hom (IsLocalRing.maximalIdeal _) = IsLocalRing.maximalIdeal _) →
        ∀ x, Ideal.map ((f ≫ g).stalkMap x).hom (IsLocalRing.maximalIdeal _) =
          IsLocalRing.maximalIdeal _ := by
      intro A B C f g hf hg x
      have heq : ((f ≫ g).stalkMap x).hom = (f.stalkMap x).hom.comp (g.stalkMap (f x)).hom :=
        congrArg (fun φ => CommRingCat.Hom.hom φ) (Scheme.Hom.stalkMap_comp f g x)
      have h3 : Ideal.map ((f.stalkMap x).hom.comp (g.stalkMap (f x)).hom)
          (IsLocalRing.maximalIdeal (C.presheaf.stalk (g (f x)))) =
          IsLocalRing.maximalIdeal (A.presheaf.stalk x) := by
        rw [← Ideal.map_map]
        exact (congrArg (Ideal.map (f.stalkMap x).hom) (hg (f x))).trans (hf x)
      exact (congrArg (fun φ => Ideal.map φ
        (IsLocalRing.maximalIdeal (C.presheaf.stalk (g (f x))))) heq).trans h3
    have MIiso : ∀ {A B : Scheme.{u}} (f : A ⟶ B) [IsIso f], ∀ x,
        Ideal.map (f.stalkMap x).hom (IsLocalRing.maximalIdeal _) = IsLocalRing.maximalIdeal _ :=
      fun f _ x => IsLocalRing.map_maximalIdeal_of_surjective _
        (ConcreteCategory.bijective_of_isIso (f.stalkMap x)).2

    have s5 : ∀ {X X₂ : Scheme.{u}} (h : X ⟶ Spec (.of K)) [LocallyOfFiniteType h]
        (h₂ : X₂ ⟶ Spec (.of L)) (b : X₂ ⟶ X),
        IsPullback b h₂ h (Spec.map (CommRingCat.ofHom (algebraMap K L))) →
        ∀ x₂ : X₂, Ideal.map (b.stalkMap x₂).hom (IsLocalRing.maximalIdeal _) =
          IsLocalRing.maximalIdeal _ := by
      intro X X₂ h _ h₂ b hsq
      haveI : LocallyOfFiniteType (Over.mk h).hom := ‹_›
      haveI : IsIso (Spec.map (CommRingCat.ofHom (algebraMap K K))) := by
        rw [Algebra.algebraMap_self, CommRingCat.ofHom_id, Spec.map_id]; infer_instance
      have hm0 := wc_ldp_dgp_rho_maxideal K K L (Over.mk h)
      have hρ₀ : wcLdpRho K K L (Over.mk h) ≫
          Limits.pullback.fst (Over.mk h).hom (Spec.map (CommRingCat.ofHom (algebraMap K K))) =
          Limits.pullback.fst (Over.mk h).hom (Spec.map (CommRingCat.ofHom (algebraMap K L))) := by
        unfold wcLdpRho
        exact Limits.pullback.lift_fst _ _ _
      have hb : b = hsq.isoPullback.hom ≫ wcLdpRho K K L (Over.mk h) ≫
          Limits.pullback.fst (Over.mk h).hom (Spec.map (CommRingCat.ofHom (algebraMap K K))) := by
        rw [hρ₀]; exact hsq.isoPullback_hom_fst.symm
      rw [hb]
      exact MIcomp _ _ (MIiso _) (MIcomp _ _ hm0 (MIiso _))

    have s6 : ∀ {W₂ W B₂ B : Scheme.{u}} (f₂ : W₂ ⟶ B₂) (f : W ⟶ B) (β : W₂ ⟶ W) (ρ : B₂ ⟶ B),
        β ≫ f = f₂ ≫ ρ → ∀ (x₂ : W₂),
        Ideal.map (β.stalkMap x₂).hom (IsLocalRing.maximalIdeal (W.presheaf.stalk (β x₂))) =
          IsLocalRing.maximalIdeal (W₂.presheaf.stalk x₂) →
        Ideal.map (ρ.stalkMap (f₂ x₂)).hom
            (IsLocalRing.maximalIdeal (B.presheaf.stalk (ρ (f₂ x₂)))) =
          IsLocalRing.maximalIdeal (B₂.presheaf.stalk (f₂ x₂)) →
        ∀ (x : W), β x₂ = x →
        (∃ (t : Fin n → W.presheaf.stalk x) (τ : B.presheaf.stalk (f x))
            (A : Matrix (Fin n) (Fin n) (W.presheaf.stalk x)),
            IsLocalRing.maximalIdeal (W.presheaf.stalk x) = Ideal.span (Set.range t) ∧
            IsLocalRing.maximalIdeal (B.presheaf.stalk (f x)) = Ideal.span {τ} ∧
            (f.stalkMap x).hom τ - ∑ a, ∑ c, A a c * t a * t c ∈
              IsLocalRing.maximalIdeal (W.presheaf.stalk x) ^ 3 ∧
            IsUnit (A + A.transpose).det) →
        ∃ (t : Fin n → W₂.presheaf.stalk x₂) (τ : B₂.presheaf.stalk (f₂ x₂))
          (A : Matrix (Fin n) (Fin n) (W₂.presheaf.stalk x₂)),
          IsLocalRing.maximalIdeal (W₂.presheaf.stalk x₂) = Ideal.span (Set.range t) ∧
          IsLocalRing.maximalIdeal (B₂.presheaf.stalk (f₂ x₂)) = Ideal.span {τ} ∧
          (f₂.stalkMap x₂).hom τ - ∑ a, ∑ c, A a c * t a * t c ∈
            IsLocalRing.maximalIdeal (W₂.presheaf.stalk x₂) ^ 3 ∧
          IsUnit (A + A.transpose).det := by
      intro W₂ W B₂ B f₂ f β ρ hsq x₂ hβm hρm x hx hodp
      subst hx
      obtain ⟨t, τ, A, ht, hτ, hq, hA⟩ := hodp
      have e : f (β x₂) = ρ (f₂ x₂) := by
        change (β ≫ f) x₂ = (f₂ ≫ ρ) x₂
        rw [hsq]
      obtain ⟨ψ, hψ⟩ : ∃ ψ : B.presheaf.stalk (f (β x₂)) →+* B₂.presheaf.stalk (f₂ x₂),
          ψ = (ρ.stalkMap (f₂ x₂)).hom.comp
            (B.presheaf.stalkCongr (Inseparable.of_eq e)).hom.hom := ⟨_, rfl⟩
      have KC : ∀ σ, (f₂.stalkMap x₂).hom (ψ σ) = (β.stalkMap x₂).hom ((f.stalkMap (β x₂)).hom σ) := by
        intro σ
        have h1 := Scheme.Hom.stalkMap_congr_hom (β ≫ f) (f₂ ≫ ρ) hsq x₂
        rw [Scheme.Hom.stalkMap_comp, Scheme.Hom.stalkMap_comp] at h1
        have h2 := congrArg (fun g => g.hom σ) h1
        simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2
        rw [hψ, RingHom.comp_apply]
        exact h2.symm
      have hψm : Ideal.map ψ (IsLocalRing.maximalIdeal (B.presheaf.stalk (f (β x₂)))) =
          IsLocalRing.maximalIdeal (B₂.presheaf.stalk (f₂ x₂)) := by
        rw [hψ, ← Ideal.map_map, IsLocalRing.map_maximalIdeal_of_surjective _
          (ConcreteCategory.bijective_of_isIso (B.presheaf.stalkCongr (Inseparable.of_eq e)).hom).2,
          hρm]
      refine ⟨fun a => (β.stalkMap x₂).hom (t a), ψ τ, A.map (β.stalkMap x₂).hom, ?_, ?_, ?_, ?_⟩
      · rw [← hβm, ht, Ideal.map_span, ← Set.range_comp]
        try rfl
      · rw [← hψm, hτ, Ideal.map_span, Set.image_singleton]
      · have hmem := Ideal.mem_map_of_mem (β.stalkMap x₂).hom hq
        rw [Ideal.map_pow, hβm] at hmem
        convert hmem using 1
        rw [KC τ, map_sub]
        simp only [map_sum, map_mul, Matrix.map_apply]
      · have hM : (A + A.transpose).map (β.stalkMap x₂).hom =
            A.map (β.stalkMap x₂).hom + (A.map (β.stalkMap x₂).hom).transpose := by
          ext a c
          simp [Matrix.map_apply, Matrix.transpose_apply]
        rw [← hM, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
        exact hA.map _

    obtain ⟨e, he_iso, he⟩ := wcpa_proj_base_change K L 1
    haveI := he_iso
    have hρ' : IsPullback (inv e ≫ Limits.pullback.fst (wcProjKStr K 1)
        (Spec.map (CommRingCat.ofHom (algebraMap K L)))) (wcP1Over L).hom (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K L))) := by
      refine IsPullback.of_iso (IsPullback.of_hasPullback (wcProjKStr K 1)
        (Spec.map (CommRingCat.ofHom (algebraMap K L)))) (asIso e) (Iso.refl _) (Iso.refl _)
        (Iso.refl _) ?_ ?_ ?_ ?_
      · simp
      · simp only [Iso.refl_hom, Category.comp_id, asIso_hom]
        exact he.symm
      · simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
        try rfl
      · simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
    obtain ⟨ρ, hρ⟩ : ∃ ρ : (wcP1Over L).left ⟶ (wcP1Over K).left, IsPullback ρ (wcP1Over L).hom
        (wcP1Over K).hom (Spec.map (CommRingCat.ofHom (algebraMap K L))) := ⟨_, hρ'⟩

    have hιc : Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F' K)) =
        Spec.map (CommRingCat.ofHom (algebraMap F' L)) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]
    have hr_fst : wcLdpRho F' K L Y ≫ Limits.pullback.fst Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' K))) =
        Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' L))) := by
      unfold wcLdpRho
      exact Limits.pullback.lift_fst _ _ _
    have hr_snd : wcLdpRho F' K L Y ≫ Limits.pullback.snd Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' K))) =
        Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' L))) ≫
          Spec.map (CommRingCat.ofHom (algebraMap K L)) := by
      unfold wcLdpRho
      exact Limits.pullback.lift_snd _ _ _
    have hrY : IsPullback (wcLdpRho F' K L Y)
        (Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' L))))
        (Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))))
        (Spec.map (CommRingCat.ofHom (algebraMap K L))) := by
      refine IsPullback.of_right ?_ hr_snd
        (IsPullback.of_hasPullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))))
      rw [hr_fst, hιc]
      exact IsPullback.of_hasPullback _ _

    have hβ := IsPullback.of_hasPullback P.f ρ
    have hYt : IsPullback (Limits.pullback.fst P.f ρ)
        (Limits.pullback.snd P.f ρ ≫ (wcP1Over L).hom) P.Yt.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K L))) := by
      have h := hβ.paste_vert hρ
      rw [P.hf] at h
      exact h
    have gi₂ : GeometricallyIrreducible (Limits.pullback.snd P.f ρ ≫ (wcP1Over L).hom) :=
      MorphismProperty.of_isPullback (P := @GeometricallyIrreducible) hYt P.gi
    have pr₂ : IsProper (Limits.pullback.snd P.f ρ ≫ (wcP1Over L).hom) :=
      MorphismProperty.of_isPullback (P := @IsProper) hYt P.proper
    have sm₂ : SmoothOfRelativeDimension n (Limits.pullback.snd P.f ρ ≫ (wcP1Over L).hom) :=
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension n) hYt P.smooth

    have hw : (Limits.pullback.fst P.f ρ ≫ P.b ≫ Limits.pullback.fst Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' K)))) ≫ Y.hom =
        (Limits.pullback.snd P.f ρ ≫ (wcP1Over L).hom) ≫
          Spec.map (CommRingCat.ofHom (algebraMap F' L)) := by
      simp only [Category.assoc, Limits.pullback.condition, reassoc_of% P.hb, reassoc_of% hYt.w,
        ← hιc]
    obtain ⟨b₂, hb₂f, hb₂s⟩ : ∃ b₂ : Limits.pullback P.f ρ ⟶
        Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' L))),
        b₂ ≫ Limits.pullback.fst _ _ =
          Limits.pullback.fst P.f ρ ≫ P.b ≫ Limits.pullback.fst _ _ ∧
        b₂ ≫ Limits.pullback.snd _ _ = Limits.pullback.snd P.f ρ ≫ (wcP1Over L).hom :=
      ⟨Limits.pullback.lift _ _ hw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hbsq : IsPullback (Limits.pullback.fst P.f ρ) b₂ P.b (wcLdpRho F' K L Y) := by
      refine IsPullback.of_bot ?_ ?_ hrY
      · rw [hb₂s, P.hb]; exact hYt
      · apply Limits.pullback.hom_ext
        · simp only [Category.assoc, hr_fst, hb₂f]
        · simp only [Category.assoc, hr_snd, reassoc_of% hb₂s, P.hb, hYt.w]
    have bsurj₂ : Surjective b₂ := MorphismProperty.of_isPullback (P := @Surjective) hbsq P.bsurj

    obtain ⟨V, hV0, hVfin⟩ := P.bfin
    have hιsurj : Surjective (Spec.map (CommRingCat.ofHom (algebraMap K L))) :=
      ⟨fun y => ⟨IsLocalRing.closedPoint L, Subsingleton.elim _ _⟩⟩
    have hrsurj : Surjective (wcLdpRho F' K L Y) :=
      MorphismProperty.of_isPullback (P := @Surjective) hrY.flip hιsurj
    have hV2 : wcLdpRho F' K L Y ⁻¹ᵁ V ≠ ⊥ := by
      rw [TopologicalSpace.Opens.ne_bot_iff_nonempty] at hV0 ⊢
      obtain ⟨y, hy⟩ := hV0
      obtain ⟨z, rfl⟩ := hrsurj.surj y
      exact ⟨z, hy⟩
    have hfin : IsFinite (b₂ ∣_ (wcLdpRho F' K L Y ⁻¹ᵁ V)) := by
      have R1 := isPullback_morphismRestrict b₂ (wcLdpRho F' K L Y ⁻¹ᵁ V)
      have R2 := isPullback_morphismRestrict P.b V
      have w : ((b₂ ∣_ (wcLdpRho F' K L Y ⁻¹ᵁ V)) ≫ (wcLdpRho F' K L Y ∣_ V)) ≫ V.ι =
          ((b₂ ⁻¹ᵁ (wcLdpRho F' K L Y ⁻¹ᵁ V)).ι ≫ Limits.pullback.fst P.f ρ) ≫ P.b := by
        simp only [Category.assoc, morphismRestrict_ι,
          reassoc_of% (morphismRestrict_ι b₂ (wcLdpRho F' K L Y ⁻¹ᵁ V)), hbsq.w]
      have hsq : IsPullback (R2.lift _ _ w) (b₂ ∣_ (wcLdpRho F' K L Y ⁻¹ᵁ V)) (P.b ∣_ V)
          (wcLdpRho F' K L Y ∣_ V) := by
        refine IsPullback.of_right ?_ (R2.lift_fst _ _ w) R2.flip
        rw [IsPullback.lift_snd, morphismRestrict_ι]
        exact R1.flip.paste_horiz hbsq
      exact MorphismProperty.of_isPullback (P := @IsFinite) hsq hVfin

    have fconn₂ : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ (wcP1Over L).left),
        ConnectedSpace ↥(Limits.pullback (Limits.pullback.snd P.f ρ) t) := by
      intro Ω _ _ t
      haveI := P.fconn Ω (t ≫ ρ)
      have h := (IsPullback.of_hasPullback (Limits.pullback.snd P.f ρ) t).paste_horiz hβ
      exact (inferInstance : Surjective h.isoPullback.inv).surj.connectedSpace
        h.isoPullback.inv.continuous

    have hwS : ∀ i, (Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ P.S i) ≫ (wcP1Over K).hom =
        𝟙 _ ≫ Spec.map (CommRingCat.ofHom (algebraMap K L)) := fun i => by
      rw [Category.assoc, P.hS i, Category.comp_id, Category.id_comp]
    have hS₂ex : ∀ i : Fin P.m, ∃ s : Spec (.of L) ⟶ (wcP1Over L).left,
        s ≫ ρ = Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ P.S i ∧
        s ≫ (wcP1Over L).hom = 𝟙 _ :=
      fun i => ⟨hρ.lift _ _ (hwS i), hρ.lift_fst _ _ _, hρ.lift_snd _ _ _⟩
    choose S₂ hS₂ρ hS₂ using hS₂ex
    have hSpt : ∀ i, ρ (S₂ i (IsLocalRing.closedPoint L)) = P.S i (IsLocalRing.closedPoint K) := by
      intro i
      change (S₂ i ≫ ρ) (IsLocalRing.closedPoint L) = _
      rw [hS₂ρ i]
      exact congrArg (fun z => P.S i z) (Subsingleton.elim _ _)
    have hSinj₂ : Function.Injective (fun i => S₂ i (IsLocalRing.closedPoint L)) := by
      intro i j hij
      apply P.hSinj
      exact (hSpt i).symm.trans ((congrArg (fun x => ρ x) hij).trans (hSpt j))
    have hwx : ∀ i, (Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ P.xs i) ≫ P.f = S₂ i ≫ ρ :=
      fun i => by rw [Category.assoc, P.hxs i, hS₂ρ i]
    have hxs₂ex : ∀ i, ∃ x : Spec (.of L) ⟶ Limits.pullback P.f ρ,
        x ≫ Limits.pullback.fst P.f ρ = Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ P.xs i ∧
        x ≫ Limits.pullback.snd P.f ρ = S₂ i :=
      fun i => ⟨Limits.pullback.lift _ _ (hwx i), Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    choose xs₂ hxsβ hxs₂ using hxs₂ex
    have hxpt : ∀ i, Limits.pullback.fst P.f ρ (xs₂ i (IsLocalRing.closedPoint L)) =
        P.xs i (IsLocalRing.closedPoint K) := by
      intro i
      change (xs₂ i ≫ Limits.pullback.fst P.f ρ) (IsLocalRing.closedPoint L) = _
      rw [hxsβ i]
      exact congrArg (fun z => P.xs i z) (Subsingleton.elim _ _)

    have hsec : ∀ i, P.xs i ≫ P.Yt.hom = 𝟙 _ := fun i => by
      rw [← P.hf, ← Category.assoc, P.hxs i, P.hS i]
    have hfib : ∀ i (y₂ : ↥(Limits.pullback P.f ρ)),
        Limits.pullback.fst P.f ρ y₂ = P.xs i (IsLocalRing.closedPoint K) →
        y₂ = xs₂ i (IsLocalRing.closedPoint L) := by
      intro i y₂ hy
      have h1 := (IsPullback.of_hasPullback (Limits.pullback.fst P.f ρ) (P.xs i)).flip.paste_vert hYt
      rw [hsec i] at h1
      let φ := IsPullback.isoIsPullback _ _ h1
        (IsPullback.id_vert (Spec.map (CommRingCat.ofHom (algebraMap K L))))
      obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := Limits.pullback.fst P.f ρ) (g := P.xs i) y₂ (IsLocalRing.closedPoint K) hy
      obtain ⟨z', hz', -⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := Limits.pullback.fst P.f ρ) (g := P.xs i)
        (xs₂ i (IsLocalRing.closedPoint L)) (IsLocalRing.closedPoint K) (hxpt i)
      have hzz : z = z' := by
        have h2 : φ.hom z = φ.hom z' := Subsingleton.elim _ _
        first
          | exact φ.hom.homeomorph.injective h2
          | (have h3 := congrArg (fun w => φ.inv w) h2
             simp only at h3
             rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, φ.hom_inv_id] at h3
             simpa using h3)
      rw [← hz, ← hz', hzz]
    have smooth_off₂ : ∀ y : ↥(Limits.pullback P.f ρ),
        (∀ i, y ≠ xs₂ i (IsLocalRing.closedPoint L)) →
        ∃ U : (Limits.pullback P.f ρ).Opens, y ∈ U ∧ Smooth (U.ι ≫ Limits.pullback.snd P.f ρ) := by
      intro y hy
      obtain ⟨U, hyU, hU⟩ :=
        P.smooth_off (Limits.pullback.fst P.f ρ y) (fun i h => hy i (hfib i y h))
      refine ⟨Limits.pullback.fst P.f ρ ⁻¹ᵁ U, hyU, ?_⟩
      have h := (isPullback_morphismRestrict (Limits.pullback.fst P.f ρ) U).paste_vert hβ
      exact MorphismProperty.of_isPullback (P := @Smooth) h hU

    haveI : IsProper (wcP1Over K).hom := wc_pp_proper K 1
    have hβm := s5 P.Yt.hom (Limits.pullback.snd P.f ρ ≫ (wcP1Over L).hom)
      (Limits.pullback.fst P.f ρ) hYt
    have hρm := s5 (wcP1Over K).hom (wcP1Over L).hom ρ hρ

    obtain ⟨jE, hjE, hjEs⟩ := wc_ldp_base_change_embedded K P.Yt P.M P.jt P.hjt P.hjtY L
    haveI := hjE
    have hjt₂ : IsClosedImmersion (hYt.isoPullback.hom ≫ jE) := inferInstance
    have hjtY₂ : (hYt.isoPullback.hom ≫ jE) ≫ wcProjKStr L P.M =
        Limits.pullback.snd P.f ρ ≫ (wcP1Over L).hom := by
      rw [Category.assoc, hjEs]
