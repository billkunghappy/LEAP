    refine ⟨{ Yt := Over.mk (Limits.pullback.snd P.f ρ ≫ (wcP1Over L).hom)
              gi := gi₂
              proper := pr₂
              smooth := sm₂
              b := b₂
              hb := hb₂s
              bsurj := bsurj₂
              bfin := ⟨_, hV2, hfin⟩
              f := Limits.pullback.snd P.f ρ
              hf := rfl
              fconn := fconn₂
              m := P.m
              S := S₂
              hS := hS₂
              hSinj := hSinj₂
              xs := xs₂
              hxs := hxs₂
              smooth_off := smooth_off₂
              odp := fun i => s6 (Limits.pullback.snd P.f ρ) P.f (Limits.pullback.fst P.f ρ) ρ
                Limits.pullback.condition (xs₂ i (IsLocalRing.closedPoint L)) (hβm _) (hρm _)
                (P.xs i (IsLocalRing.closedPoint K)) (hxpt i) (P.odp i)
              M := P.M
              jt := hYt.isoPullback.hom ≫ jE
              hjt := hjt₂
              hjtY := hjtY₂ },
      ρ, Limits.pullback.fst P.f ρ, rfl, hρ, hβ, fun i => hS₂ρ i⟩

  obtain ⟨L₁, _, _, _, v, hv, hvS⟩ := wc_ldc_avoiding_point F₁ P.m P.S P.hS

  obtain ⟨hgi₁, hpr₁, hsm₁⟩ := wc_ldc_fibre_props F' F₁ L₁ Y n (by omega) P v hv hvS
  obtain ⟨κ₁, hκ₁, hκ₁w⟩ := wc_ldc_fibre_embedding F' F₁ L₁ Y n P v hv
  haveI := hgi₁
  haveI := hpr₁
  haveI := hsm₁

  obtain ⟨L, _, _, _, H, κL, Z₀, ιZ', hκL, hκLw, hιZ', hrange, hsm⟩ :=
    wc_ldc_bertini_hyperplane L₁ (Limits.pullback P.f v) (Limits.pullback.snd P.f v) (n - 1)
      (by omega) P.M κ₁ hκ₁ hκ₁w

  letI : Algebra F₁ L := ((algebraMap L₁ L).comp (algebraMap F₁ L₁)).toAlgebra
  letI : Algebra F' L := ((algebraMap F₁ L).comp (algebraMap F' F₁)).toAlgebra
  haveI : IsScalarTower F' F₁ L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hι : Spec.map (CommRingCat.ofHom (algebraMap F₁ L)) =
      Spec.map (CommRingCat.ofHom (algebraMap L₁ L)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F₁ L₁)) := by
    rw [← Spec.map_comp]
    rfl

  obtain ⟨P₂, ρ, β, e, hρ, hβ, hS₂⟩ := hbc F₁ L P

  let u0 : Spec (.of L) ⟶ (wcP1Over L).left :=
    hρ.lift (Spec.map (CommRingCat.ofHom (algebraMap L₁ L)) ≫ v) (𝟙 _)
      (by rw [Category.assoc, hv, Category.id_comp, hι])
  have hu0 : u0 ≫ (wcP1Over L).hom = 𝟙 _ := hρ.lift_snd _ _ _
  have hu0ρ : u0 ≫ ρ = Spec.map (CommRingCat.ofHom (algebraMap L₁ L)) ≫ v :=
    hρ.lift_fst _ _ _

  have hu0S : ∀ i, u0 (IsLocalRing.closedPoint L) ≠ P₂.S i (IsLocalRing.closedPoint L) := by
    intro i h
    have hj := hS₂ i
    have h2 : (u0 ≫ ρ) (IsLocalRing.closedPoint L) = (P₂.S i ≫ ρ) (IsLocalRing.closedPoint L) :=
      congrArg ρ h
    rw [hu0ρ, hj] at h2
    have e1 : (Spec.map (CommRingCat.ofHom (algebraMap L₁ L)) ≫ v) (IsLocalRing.closedPoint L) =
        v (IsLocalRing.closedPoint L₁) := congrArg v (Subsingleton.elim _ _)
    have e2 : (Spec.map (CommRingCat.ofHom (algebraMap F₁ L)) ≫ P.S (Fin.cast e i))
        (IsLocalRing.closedPoint L) = P.S (Fin.cast e i) (IsLocalRing.closedPoint F₁) :=
      congrArg (P.S (Fin.cast e i)) (Subsingleton.elim _ _)
    exact hvS (Fin.cast e i) (e1.symm.trans (h2.trans e2))

  have hpb : IsPullback (Limits.pullback.fst P₂.f u0 ≫ β) (Limits.pullback.snd P₂.f u0) P.f
      (Spec.map (CommRingCat.ofHom (algebraMap L₁ L)) ≫ v) := by
    have h0 := IsPullback.paste_horiz (IsPullback.of_hasPullback P₂.f u0) hβ
    rw [hu0ρ] at h0
    exact h0
  let φ₁ := IsPullback.isoIsPullback _ _ hpb
    (IsPullback.of_hasPullback P.f (Spec.map (CommRingCat.ofHom (algebraMap L₁ L)) ≫ v))
  have hφ₁ : φ₁.hom ≫ Limits.pullback.snd P.f
      (Spec.map (CommRingCat.ofHom (algebraMap L₁ L)) ≫ v) = Limits.pullback.snd P₂.f u0 :=
    IsPullback.isoIsPullback_hom_snd _ _ _ _
  let φ₂ := Limits.pullbackLeftPullbackSndIso P.f v (Spec.map (CommRingCat.ofHom (algebraMap L₁ L)))
  have hφ₂ : φ₂.inv ≫ Limits.pullback.snd (Limits.pullback.snd P.f v)
      (Spec.map (CommRingCat.ofHom (algebraMap L₁ L))) =
      Limits.pullback.snd P.f (Spec.map (CommRingCat.ofHom (algebraMap L₁ L)) ≫ v) := by
    rw [← Limits.pullbackLeftPullbackSndIso_hom_snd, Iso.inv_hom_id_assoc]
  let φ := φ₁ ≪≫ φ₂.symm
  have hφ : φ.hom ≫ Limits.pullback.snd (Limits.pullback.snd P.f v)
      (Spec.map (CommRingCat.ofHom (algebraMap L₁ L))) = Limits.pullback.snd P₂.f u0 := by
    show (φ₁.hom ≫ φ₂.inv) ≫ _ = _
    rw [Category.assoc, hφ₂, hφ₁]

  haveI : IsClosedImmersion ιZ' := hιZ'
  haveI : IsClosedImmersion κL := hκL
  haveI : SmoothOfRelativeDimension (n - 1)
      (Limits.pullback.snd (Limits.pullback.snd P.f v)
        (Spec.map (CommRingCat.ofHom (algebraMap L₁ L)))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (n - 1))
      (IsPullback.of_hasPullback _ _) hsm₁
  haveI := hsm
  haveI : Smooth (ιZ' ≫ Limits.pullback.snd (Limits.pullback.snd P.f v)
      (Spec.map (CommRingCat.ofHom (algebraMap L₁ L)))) :=
    SmoothOfRelativeDimension.smooth (n - 1 - 1) _
  have hsm' : SmoothOfRelativeDimension (n - 2) (ιZ' ≫ Limits.pullback.snd
      (Limits.pullback.snd P.f v) (Spec.map (CommRingCat.ofHom (algebraMap L₁ L)))) := by
    have e : n - 1 - 1 = n - 2 := by omega
    rw [e] at hsm
    exact hsm

  refine ⟨L, inferInstance, inferInstance, inferInstance, inferInstance, {
    Yt := P₂.Yt
    gi := P₂.gi
    proper := P₂.proper
    smooth := P₂.smooth
    b := P₂.b
    hb := P₂.hb
    bsurj := P₂.bsurj
    bfin := P₂.bfin
    f := P₂.f
    hf := P₂.hf
    fconn := P₂.fconn
    m := P₂.m
    S := P₂.S
    hS := P₂.hS
    hSinj := P₂.hSinj
    xs := P₂.xs
    hxs := P₂.hxs
    smooth_off := P₂.smooth_off
    odp := P₂.odp
    u0 := u0
    hu0 := hu0
    hu0S := hu0S
    Z := Over.mk (ιZ' ≫ Limits.pullback.snd (Limits.pullback.snd P.f v)
      (Spec.map (CommRingCat.ofHom (algebraMap L₁ L))))
    ιZ := ιZ' ≫ φ.inv
    hιZ := inferInstance
    hιZY := by
      rw [← hφ, Category.assoc, Iso.inv_hom_id_assoc]
      rfl
    Zaff := by
      refine ⟨φ.hom ⁻¹ᵁ (κL ⁻¹ᵁ (@Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (P.M + 1)) L) MvPolynomial.gradedAlgebra
        (H : MvPolynomial (Fin (P.M + 1)) L))), ?_, ?_⟩
      · ext x
        constructor
        · rintro hx ⟨z, hz⟩
          have h1 : φ.hom x ∈ Set.range ιZ' := by
            refine ⟨z, ?_⟩
            rw [← hz, Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply φ.inv φ.hom, φ.inv_hom_id]
            rfl
          rw [hrange] at h1
          exact h1 hx
        · intro hx
          by_contra hx'
          apply hx
          have h1 : φ.hom x ∈ Set.range ιZ' := by
            rw [hrange]
            exact hx'
          obtain ⟨z, hz⟩ := h1
          refine ⟨z, ?_⟩
          rw [Scheme.Hom.comp_apply, hz, ← Scheme.Hom.comp_apply, φ.hom_inv_id]
          rfl
      · exact IsAffineOpen.preimage_of_isIso
          (IsAffineOpen.preimage (@Proj.isAffineOpen_basicOpen _ _ _ _ _
            (MvPolynomial.homogeneousSubmodule (Fin (P.M + 1)) L) MvPolynomial.gradedAlgebra
            (H : MvPolynomial (Fin (P.M + 1)) L) 1 H.2 one_pos) κL) φ.hom
    Zproper := by
      show IsProper (ιZ' ≫ Limits.pullback.snd (Limits.pullback.snd P.f v)
        (Spec.map (CommRingCat.ofHom (algebraMap L₁ L))))
      infer_instance
    Zsmooth := hsm'
    Zgi := fun _ => wc_ldc_hyperplane_section_gi L
      (Limits.pullback (Limits.pullback.snd P.f v) (Spec.map (CommRingCat.ofHom (algebraMap L₁ L))))
      (Limits.pullback.snd (Limits.pullback.snd P.f v)
        (Spec.map (CommRingCat.ofHom (algebraMap L₁ L)))) (n - 1) (by omega) P.M κL hκL hκLw
      H Z₀ ιZ' hιZ' hrange
    N' := P.M
    jZ := ιZ' ≫ κL
    hjZ := inferInstance
    hjZY := by
      rw [Category.assoc]
      exact congrArg (fun g => ιZ' ≫ g) hκLw }, ρ, β, e, hρ, hβ, ?_⟩
  intro i
  exact hS₂ i

theorem wc_ldnm_family_transport (K L : Type u) [Field K] [Field L] [Finite K] [Finite L]
    [Algebra K L] (T : Scheme.{u}) (f : T ⟶ (wcP1Over K).left) (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left)) (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (T₂ : Scheme.{u}) (f₂ : T₂ ⟶ (wcP1Over L).left) (m₂ : ℕ) (e : m₂ = m)
    (S₂ : Fin m₂ → (Spec (.of L) ⟶ (wcP1Over L).left))
    (hS₂ : ∀ i, S₂ i ≫ (wcP1Over L).hom = 𝟙 _)
    (ρ : (wcP1Over L).left ⟶ (wcP1Over K).left) (β : T₂ ⟶ T)
    (hρ : IsPullback ρ (wcP1Over L).hom (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K L))))
    (hβ : IsPullback β f₂ f ρ)
    (hSρ : ∀ i, S₂ i ≫ ρ = Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ S (Fin.cast e i))
    (hW : wcFamWit K T f m S) :
    wcFamWit L T₂ f₂ m₂ S₂ :=
by
  classical

  have PB : ∀ (N : ℕ) (F F' : Type u) [Field F] [Field F'] [Algebra F F'],
      IsPullback (wcLdpProjMap F F' N) (wcProjKStr F' N) (wcProjKStr F N)
        (Spec.map (CommRingCat.ofHom (algebraMap F F'))) := by
    intro N
    have s6 : ∀ {W X Y Z : Scheme.{u}} (φ : W ⟶ X) (p' : W ⟶ Y) (p : X ⟶ Z) (g : Y ⟶ Z) {ι : Type}
        (U U' : ι → Scheme.{u}) (j : ∀ i, U i ⟶ X) (j' : ∀ i, U' i ⟶ W) (φi : ∀ i, U' i ⟶ U i)
        [∀ i, IsOpenImmersion (j i)] [∀ i, IsOpenImmersion (j' i)],
        (⨆ i, (j i).opensRange) = ⊤ → (∀ i, j' i ≫ φ = φi i ≫ j i) →
        (∀ i, φ ⁻¹ᵁ (j i).opensRange = (j' i).opensRange) →
        (∀ i, IsPullback (φi i) (j' i ≫ p') (j i ≫ p) g) → IsPullback φ p' p g := by
      intro W X Y Z φ p' p g ι U U' j j' φi hjI hj'I hcov hcomm hpre hpb
      have hc : ∀ x : X, ∃ i y, j i y = x := by
        intro x
        have hx : x ∈ (⨆ i, (j i).opensRange) := by rw [hcov]; trivial
        obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
        obtain ⟨y, hy⟩ := Scheme.Hom.mem_opensRange.mp hi
        exact ⟨i, y, hy⟩
      refine Scheme.isPullback_of_openCover φ p' p g
        (Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) ι U j hc) ?_
      intro i
      have Q := (@IsOpenImmersion.isPullback _ _ _ _ (φi i) (j' i) (j i) φ (hj'I i) (hjI i)
        (hcomm i) (hpre i)).flip
      refine IsPullback.of_iso (hpb i) Q.isoPullback (Iso.refl _) (Iso.refl _) (Iso.refl _)
        ?_ ?_ ?_ ?_
      · show φi i ≫ 𝟙 _ = Q.isoPullback.hom ≫ Limits.pullback.snd φ (j i)
        rw [Category.comp_id, IsPullback.isoPullback_hom_snd]
      · show (j' i ≫ p') ≫ 𝟙 _ = Q.isoPullback.hom ≫ (Limits.pullback.fst φ (j i) ≫ p')
        rw [Category.comp_id, ← Category.assoc, IsPullback.isoPullback_hom_fst]
      · show (j i ≫ p) ≫ 𝟙 _ = 𝟙 _ ≫ (j i ≫ p)
        rw [Category.comp_id, Category.id_comp]
      · show g ≫ 𝟙 _ = 𝟙 _ ≫ g
        rw [Category.comp_id, Category.id_comp]
    intro F F' _ _ _

    have s2 : ∀ (K : Type u) [Field K] (a : Fin (N + 1)),
        letI := (MvPolynomial.gradedAlgebra :
          GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K));
        ∀ (s : MvPolynomial (Fin (N + 1)) K), s = MvPolynomial.X a →
        ∃ e : MvPolynomial (Fin N) K ≃+*
          HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) s,
        (∀ c : K, e (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers s)
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)) ∧
        ∀ j : Fin N, (e (MvPolynomial.X j)).val =
          Localization.mk (MvPolynomial.X (a.succAbove j)) ⟨s, Submonoid.mem_powers s⟩ := by
      intro K _ a
      letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))
      intro s hs
      subst hs

      have scale : ∀ {S : Type u} [CommRing S] (φ : K →+* S) (x : Fin (N + 1) → S) (t : S) (n : ℕ)
          (F : MvPolynomial (Fin (N + 1)) K), F.IsHomogeneous n →
          MvPolynomial.eval₂ φ (fun j => t * x j) F = t ^ n * MvPolynomial.eval₂ φ x F := by
        intro S _ φ x t n F hF
        conv_lhs => rw [F.as_sum]
        conv_rhs => rw [F.as_sum]
        rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun d hd => ?_)
        have hdeg : Finsupp.degree d = n := by
          by_contra h
          exact (MvPolynomial.mem_support_iff.mp hd) (hF.coeff_eq_zero h)
        rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
        have hp : (d.prod fun i e => (t * x i) ^ e) = t ^ n * d.prod fun i e => x i ^ e := by
          simp only [mul_pow]
          rw [Finsupp.prod_mul]
          congr 1
          rw [← hdeg, Finsupp.degree_apply]
          unfold Finsupp.prod
          rw [Finset.prod_pow_eq_pow_sum]
        rw [hp]
        ring
      have hX : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X K a)
      have hg : ∀ i : Fin N, (MvPolynomial.X (a.succAbove i) : MvPolynomial (Fin (N + 1)) K) ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (1 • 1) := fun i =>
        (MvPolynomial.mem_homogeneousSubmodule _ _).2 (MvPolynomial.isHomogeneous_X K _)

      obtain ⟨ψ, hψC, hψX⟩ : ∃ ψ : MvPolynomial (Fin N) K →+*
          HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (MvPolynomial.X a),
          (∀ c : K, ψ (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X a))
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)) ∧
          (∀ i : Fin N, ψ (MvPolynomial.X i) = HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hX 1
            (MvPolynomial.X (a.succAbove i)) (hg i)) :=
        ⟨MvPolynomial.eval₂Hom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X a))).comp
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)))
          (fun i => HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            hX 1 (MvPolynomial.X (a.succAbove i)) (hg i)),
          fun c => by rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply],
          fun i => by rw [MvPolynomial.eval₂Hom_X']⟩

      obtain ⟨ρt, hρC, hρa, hρs⟩ : ∃ ρt : MvPolynomial (Fin (N + 1)) K →+* MvPolynomial (Fin N) K,
          (∀ c : K, ρt (MvPolynomial.C c) = MvPolynomial.C c) ∧ ρt (MvPolynomial.X a) = 1 ∧
          (∀ i : Fin N, ρt (MvPolynomial.X (a.succAbove i)) = MvPolynomial.X i) :=
        ⟨MvPolynomial.eval₂Hom MvPolynomial.C
            (Fin.insertNth (α := fun _ => MvPolynomial (Fin N) K) a 1 MvPolynomial.X),
          fun c => by rw [MvPolynomial.eval₂Hom_C],
          by rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_same],
          fun i => by rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove]⟩
      have hu : IsUnit (ρt (MvPolynomial.X a)) := by rw [hρa]; exact isUnit_one
      have hu1 : (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) *
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) (MvPolynomial.X a) = 1 := by
        rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
        exact Localization.mk_self (⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
          Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))

      obtain ⟨ρ, hρ1, hρ2⟩ : ∃ ρ : HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a) →+*
          MvPolynomial (Fin N) K,
          (∀ z y, algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) z =
            algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) y → ρ z = ρt y) ∧
          (∀ (n : ℕ) (F : MvPolynomial (Fin (N + 1)) K)
            (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (n • 1)),
            ρ (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
              hX n F hF) = ρt F) := by
        refine ⟨(IsLocalization.Away.lift (MvPolynomial.X a) hu :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) →+*
              MvPolynomial (Fin N) K).comp (algebraMap _ _), ?_, ?_⟩
        · intro z y hzy
          rw [RingHom.comp_apply, hzy, IsLocalization.Away.lift_eq]
        · intro n F hF
          rw [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
            HomogeneousLocalization.Away.val_mk]
          have hs := IsLocalization.mk'_spec
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) F
            (⟨MvPolynomial.X a ^ n, pow_mem (Submonoid.mem_powers _) n⟩ :
              Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
          rw [← Localization.mk_eq_mk'_apply] at hs
          have hs2 := congrArg (IsLocalization.Away.lift (MvPolynomial.X a) hu :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) →+*
              MvPolynomial (Fin N) K) hs
          rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq] at hs2
          simp only [map_pow, hρa, one_pow, mul_one] at hs2
          exact hs2
      have hΨC : ∀ c : K, algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
            (ψ (MvPolynomial.C c)) =
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) (MvPolynomial.C c) := by
        intro c
        rw [hψC, HomogeneousLocalization.algebraMap_apply, ← Localization.mk_one_eq_algebraMap]
        have h1 : ((algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c :
            ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) : MvPolynomial (Fin (N + 1)) K) =
            MvPolynomial.C c := by
          rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        rw [← h1]
        rfl
      have hΨX : ∀ i : Fin N, algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
            (ψ (MvPolynomial.X i)) =
          (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) *
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
            (MvPolynomial.X (a.succAbove i)) := by
        intro i
        rw [hψX, HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
          ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
        congr 1
        ext
        simp
      have hcomp : ((algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))).comp ψ).comp ρt =
          MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))).comp MvPolynomial.C)
            (fun j => (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
              Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) *
              algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
                (MvPolynomial.X j)) := by
        apply MvPolynomial.ringHom_ext
        · intro c
          rw [RingHom.comp_apply, RingHom.comp_apply, hρC, hΨC, MvPolynomial.eval₂Hom_C,
            RingHom.comp_apply]
        · intro j
          rw [MvPolynomial.eval₂Hom_X', RingHom.comp_apply, RingHom.comp_apply]
          rcases Fin.eq_self_or_eq_succAbove a j with h | ⟨i, h⟩
          · subst h
            rw [hρa, map_one, map_one, hu1]
          · subst h
            rw [hρs, hΨX]
      have hev : MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))).comp MvPolynomial.C)
            (fun j => algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
                (MvPolynomial.X j)) =
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) := by
        apply MvPolynomial.ringHom_ext
        · intro c
          rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
        · intro j
          rw [MvPolynomial.eval₂Hom_X']
      have key : ∀ (n : ℕ) (F : MvPolynomial (Fin (N + 1)) K), F.IsHomogeneous n →
          algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) (ψ (ρt F)) *
            algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
              (MvPolynomial.X a ^ n) =
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) F := by
        intro n F hF
        have h1 := RingHom.congr_fun hcomp F
        rw [RingHom.comp_apply, RingHom.comp_apply] at h1
        rw [h1, MvPolynomial.coe_eval₂Hom]
        have hs := scale ((algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))).comp MvPolynomial.C)
          (fun j => algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
                (MvPolynomial.X j))
          (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩) n F hF
        rw [hs, ← MvPolynomial.coe_eval₂Hom, hev, map_pow]
        calc (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
              Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) ^ n *
              algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) F *
              algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
                (MvPolynomial.X a) ^ n
            = ((Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
              Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) *
              algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
                (MvPolynomial.X a)) ^ n *
              algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) F := by ring
          _ = _ := by rw [hu1, one_pow, one_mul]
      have h1 : ψ.comp ρ = RingHom.id _ := by
        apply RingHom.ext
        intro z
        obtain ⟨n, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hX z
        rw [RingHom.comp_apply, hρ2, RingHom.id_apply]
        have hFh : F.IsHomogeneous n := by
          rw [smul_eq_mul, mul_one] at hF
          exact (MvPolynomial.mem_homogeneousSubmodule n F).1 hF
        apply HomogeneousLocalization.val_injective (Submonoid.powers (MvPolynomial.X a))
        rw [HomogeneousLocalization.Away.val_mk, ← HomogeneousLocalization.algebraMap_apply,
          Localization.mk_eq_mk'_apply, IsLocalization.eq_mk'_iff_mul_eq]
        exact key n F hFh
      have h2 : ρ.comp ψ = RingHom.id _ := by
        apply MvPolynomial.ringHom_ext
        · intro c
          rw [RingHom.comp_apply, hρ1 _ _ (hΨC c), hρC, RingHom.id_apply]
        · intro i
          rw [RingHom.comp_apply, hψX, hρ2, hρs, RingHom.id_apply]
      refine ⟨RingEquiv.ofRingHom ψ ρ h1 h2, fun c => ?_, fun j => ?_⟩
      · rw [RingEquiv.ofRingHom_apply, hψC]
      · rw [RingEquiv.ofRingHom_apply, hψX, HomogeneousLocalization.Away.val_mk]
        congr 1
        ext
        simp

    have hspan : ∀ (K : Type u) [Field K],
        letI := (MvPolynomial.gradedAlgebra :
          GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K));
        (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)).toIdeal ≤
          Ideal.span (Set.range MvPolynomial.X) := by
      intro K _
      letI := (MvPolynomial.gradedAlgebra :
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))
      intro p hp
      have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          p).mp hp
      have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0 p =
          MvPolynomial.homogeneousComponent 0 p :=
        (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
      rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro e he
      rw [MvPolynomial.mem_support_iff] at he
      have hne : e ≠ 0 := by
        rintro rfl
        exact he h0
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
      exact ⟨i, Set.mem_univ i, by simpa using hi⟩

    have V0 : ∀ (K : Type u) [Field K],
        letI := (MvPolynomial.gradedAlgebra :
          GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K));
        ∀ (s : MvPolynomial (Fin (N + 1)) K) (c : K),
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (Submonoid.powers s)
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)).val =
          Localization.mk (MvPolynomial.C c) 1 := by
      intro K _
      letI := (MvPolynomial.gradedAlgebra :
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))
      intro s c
      have h1 : ((algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c :
          ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) : MvPolynomial (Fin (N + 1)) K) =
          MvPolynomial.C c := by
        rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
      rw [← h1]
      rfl
    letI iF : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) :=
      MvPolynomial.gradedAlgebra
    letI iF' : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') :=
      MvPolynomial.gradedAlgebra
    obtain ⟨f, hfmap, hfdef⟩ : ∃ f : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F →+*ᵍ
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F',
        (∀ p, f p = MvPolynomial.map (algebraMap F F') p) ∧ f = wcLdpGrHom F F' N :=
      ⟨wcLdpGrHom F F' N, fun p => rfl, rfl⟩
    have hX : ∀ a : Fin (N + 1), (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) F) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 1 := fun a =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X F a)
    have hfX : ∀ a : Fin (N + 1), f (MvPolynomial.X a) = MvPolynomial.X a := fun a => by
      rw [hfmap, MvPolynomial.map_X]

    have hf : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≤
        HomogeneousIdeal.map f
          (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F)) := by
      intro p hp
      have hp' : p ∈ Ideal.span (Set.range (MvPolynomial.X :
          Fin (N + 1) → MvPolynomial (Fin (N + 1)) F')) := hspan F' hp
      change p ∈ (HomogeneousIdeal.map f _).toIdeal
      rw [HomogeneousIdeal.toIdeal_map]
      refine (Ideal.span_le.mpr ?_) hp'
      rintro _ ⟨i, rfl⟩
      rw [← hfX i]
      apply Ideal.mem_map_of_mem
      change MvPolynomial.X i ∈ HomogeneousIdeal.irrelevant _
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
      exact DirectSum.decompose_of_mem_ne _ (hX i) one_ne_zero

    have s3 : ∀ {P : Submonoid (MvPolynomial (Fin (N + 1)) F)}
        {Q : Submonoid (MvPolynomial (Fin (N + 1)) F')} (comap_le : P ≤ Submonoid.comap f Q)
        (z : HomogeneousLocalization (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) P)
        (n : MvPolynomial (Fin (N + 1)) F) (d : P), z.val = Localization.mk n d →
        (HomogeneousLocalization.map f comap_le z).val =
          Localization.mk (f n) ⟨f d, comap_le d.2⟩ := by
      intro P Q comap_le z n d h
      obtain ⟨x, rfl⟩ := HomogeneousLocalization.mk_surjective z
      rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk]
      rw [HomogeneousLocalization.val_mk, Localization.mk_eq_mk_iff, Localization.r_iff_exists] at h
      obtain ⟨c, hc⟩ := h
      rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨⟨f c, comap_le c.2⟩, ?_⟩
      have := congrArg f hc
      simp only [map_mul] at this
      exact this

    have hchart : ∀ a : Fin (N + 1), IsPullback
        (Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))))
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
            (f.map_mem (hX a)) Nat.one_pos ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))))
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
            Nat.one_pos ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0)))))
        (Spec.map (CommRingCat.ofHom (algebraMap F F'))) := by
      intro a
      obtain ⟨e, heC, heX⟩ := s2 F a (MvPolynomial.X a) rfl
      obtain ⟨e', he'C, he'X⟩ := s2 F' a (f (MvPolynomial.X a)) (hfX a)

      have hcompat : ∀ p : MvPolynomial (Fin N) F,
          HomogeneousLocalization.Away.map f (MvPolynomial.X a) (e p) =
            e' (MvPolynomial.map (algebraMap F F') p) := by
        have key : (HomogeneousLocalization.Away.map f (MvPolynomial.X a)).comp e.toRingHom =
            e'.toRingHom.comp (MvPolynomial.map (algebraMap F F')) := by
          apply MvPolynomial.ringHom_ext
          · intro c
            show HomogeneousLocalization.Away.map f (MvPolynomial.X a) (e (MvPolynomial.C c)) =
              e' (MvPolynomial.map (algebraMap F F') (MvPolynomial.C c))
            rw [MvPolynomial.map_C, heC, he'C]
            apply HomogeneousLocalization.val_injective _
            rw [HomogeneousLocalization.Away.map.eq_1, s3 _ _ (MvPolynomial.C c) 1 (V0 F _ c),
              V0 F' _ (algebraMap F F' c)]
            congr 1
            · rw [hfmap, MvPolynomial.map_C]
            · ext
              simp
          · intro j
            show HomogeneousLocalization.Away.map f (MvPolynomial.X a) (e (MvPolynomial.X j)) =
              e' (MvPolynomial.map (algebraMap F F') (MvPolynomial.X j))
            rw [MvPolynomial.map_X]
            apply HomogeneousLocalization.val_injective _
            rw [HomogeneousLocalization.Away.map.eq_1, s3 _ _ _ _ (heX j), he'X j]
            congr 1
            rw [hfmap, MvPolynomial.map_X]
        intro p
        exact RingHom.congr_fun key p

      have P : IsPushout
          (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (Submonoid.powers (MvPolynomial.X a))).comp
            (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0))))
          (CommRingCat.ofHom (algebraMap F F'))
          (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a)))
          (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
            (Submonoid.powers (f (MvPolynomial.X a)))).comp
            (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) := by
        letI := (MvPolynomial.algebraMvPolynomial :
          Algebra (MvPolynomial (Fin N) F) (MvPolynomial (Fin N) F'))
        have P0 := CommRingCat.isPushout_of_isPushout F (MvPolynomial (Fin N) F) F'
          (MvPolynomial (Fin N) F')
        refine IsPushout.of_iso P0 (Iso.refl _) e.toCommRingCatIso (Iso.refl _) e'.toCommRingCatIso
          ?_ ?_ ?_ ?_
        · apply CommRingCat.hom_ext
          apply RingHom.ext
          intro c
          exact heC c
        · simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
        · apply CommRingCat.hom_ext
          apply RingHom.ext
          intro p
          exact (hcompat p).symm
        · apply CommRingCat.hom_ext
          apply RingHom.ext
          intro c
          exact he'C c
      have hj : Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
            Nat.one_pos ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0)))) =
          Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (Submonoid.powers (MvPolynomial.X a))).comp
            (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0)))) := by
        rw [← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hj' : Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
            (f.map_mem (hX a)) Nat.one_pos ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) =
          Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
            (Submonoid.powers (f (MvPolynomial.X a)))).comp
            (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) := by
        rw [← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      rw [hj, hj']
      exact isPullback_SpecMap_of_isPushout _ _ _ _ P
    have hcov : (⨆ a : Fin (N + 1), (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F)
        (MvPolynomial.X a) (hX a) Nat.one_pos).opensRange) = ⊤ := by
      simp only [Proj.opensRange_awayι]
      exact Proj.iSup_basicOpen_eq_top _ _ (hspan F)
    have hcomm : ∀ a : Fin (N + 1),
        Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
            (f.map_mem (hX a)) Nat.one_pos ≫ Proj.map f hf =
          Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))) ≫
            Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
              Nat.one_pos := fun a =>
      Proj.awayι_comp_map f hf Nat.one_pos (MvPolynomial.X a) (hX a)
    have hpre : ∀ a : Fin (N + 1), Proj.map f hf ⁻¹ᵁ
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
          Nat.one_pos).opensRange =
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
            (f.map_mem (hX a)) Nat.one_pos).opensRange := fun a => by
      rw [Proj.opensRange_awayι, Proj.opensRange_awayι, Proj.map_preimage_basicOpen]
    have H := s6 (Proj.map f hf)
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))))
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0))))
      (Spec.map (CommRingCat.ofHom (algebraMap F F')))
      (fun a : Fin (N + 1) => Spec (CommRingCat.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a))))
      (fun a : Fin (N + 1) => Spec (CommRingCat.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a)))))
      (fun a => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a)
        (hX a) Nat.one_pos)
      (fun a => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
        (f.map_mem (hX a)) Nat.one_pos)
      (fun a => Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))))
      hcov hcomm hpre hchart
    subst hfdef
    exact H

  have COMP : ∀ (N : ℕ) (A B C : Type u) [Field A] [Field B] [Field C] [Algebra A B] [Algebra B C]
      [Algebra A C] [IsScalarTower A B C],
      wcLdpProjMap B C N ≫ wcLdpProjMap A B N = wcLdpProjMap A C N := by
    intro N A B C _ _ _ _ _ _ _
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A))
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B))
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) C))
    have hgf : (wcLdpGrHom B C N).comp (wcLdpGrHom A B N) = wcLdpGrHom A C N := by
      apply GradedRingHom.ext
      intro p
      show MvPolynomial.map (algebraMap B C) (MvPolynomial.map (algebraMap A B) p) =
        MvPolynomial.map (algebraMap A C) p
      rw [MvPolynomial.map_map, ← IsScalarTower.algebraMap_eq]
    have key : ∀ (f₁ f₂ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A →+*ᵍ
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) C)
        (h₁ : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) C) ≤
          HomogeneousIdeal.map f₁
            (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A)))
        (h₂ : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) C) ≤
          HomogeneousIdeal.map f₂
            (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A))),
        f₁ = f₂ → Proj.map f₁ h₁ = Proj.map f₂ h₂ := by
      intro f₁ f₂ h₁ h₂ e
      subst e
      rfl
    obtain ⟨hAB, eAB⟩ : ∃ h, wcLdpProjMap A B N = Proj.map (wcLdpGrHom A B N) h := ⟨_, rfl⟩
    obtain ⟨hBC, eBC⟩ : ∃ h, wcLdpProjMap B C N = Proj.map (wcLdpGrHom B C N) h := ⟨_, rfl⟩
    obtain ⟨hAC, eAC⟩ : ∃ h, wcLdpProjMap A C N = Proj.map (wcLdpGrHom A C N) h := ⟨_, rfl⟩
    rw [eAB, eBC, eAC, ← Proj.map_comp]
    exact key _ _ _ _ hgf

  have MIcomp : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C),
      (∀ x, Ideal.map (f.stalkMap x).hom (IsLocalRing.maximalIdeal _) = IsLocalRing.maximalIdeal _) →
      (∀ y, Ideal.map (g.stalkMap y).hom (IsLocalRing.maximalIdeal _) = IsLocalRing.maximalIdeal _) →
      ∀ x, Ideal.map ((f ≫ g).stalkMap x).hom (IsLocalRing.maximalIdeal _) =
        IsLocalRing.maximalIdeal _ := by
    intro A B C f g hf hg x
    have heq : ((f ≫ g).stalkMap x).hom = (f.stalkMap x).hom.comp (g.stalkMap (f x)).hom :=
      congrArg (fun φ => CommRingCat.Hom.hom φ) (Scheme.Hom.stalkMap_comp f g x)
    have h3 : Ideal.map ((f.stalkMap x).hom.comp (g.stalkMap (f x)).hom)
        (IsLocalRing.maximalIdeal (C.presheaf.stalk (g (f x)))) =
        IsLocalRing.maximalIdeal (A.presheaf.stalk x) := by
      rw [← Ideal.map_map]
      exact (congrArg (Ideal.map (f.stalkMap x).hom) (hg (f x))).trans (hf x)
    exact (congrArg (fun φ => Ideal.map φ
      (IsLocalRing.maximalIdeal (C.presheaf.stalk (g (f x))))) heq).trans h3
  have MIiso : ∀ {A B : Scheme.{u}} (f : A ⟶ B) [IsIso f], ∀ x,
      Ideal.map (f.stalkMap x).hom (IsLocalRing.maximalIdeal _) = IsLocalRing.maximalIdeal _ :=
    fun f _ x => IsLocalRing.map_maximalIdeal_of_surjective _
      (ConcreteCategory.bijective_of_isIso (f.stalkMap x)).2
  have s5 : ∀ {X X₂ : Scheme.{u}} (h : X ⟶ Spec (.of K)) [LocallyOfFiniteType h]
      (h₂ : X₂ ⟶ Spec (.of L)) (b : X₂ ⟶ X),
      IsPullback b h₂ h (Spec.map (CommRingCat.ofHom (algebraMap K L))) →
      ∀ x₂ : X₂, Ideal.map (b.stalkMap x₂).hom (IsLocalRing.maximalIdeal _) =
        IsLocalRing.maximalIdeal _ := by
    intro X X₂ h _ h₂ b hsq
    haveI : LocallyOfFiniteType (Over.mk h).hom := ‹_›
    haveI : IsIso (Spec.map (CommRingCat.ofHom (algebraMap K K))) := by
      rw [Algebra.algebraMap_self, CommRingCat.ofHom_id, Spec.map_id]; infer_instance
    have hm0 := wc_ldp_dgp_rho_maxideal K K L (Over.mk h)
    have hρ₀ : wcLdpRho K K L (Over.mk h) ≫
        Limits.pullback.fst (Over.mk h).hom (Spec.map (CommRingCat.ofHom (algebraMap K K))) =
        Limits.pullback.fst (Over.mk h).hom (Spec.map (CommRingCat.ofHom (algebraMap K L))) := by
      unfold wcLdpRho
      exact Limits.pullback.lift_fst _ _ _
    have hb : b = hsq.isoPullback.hom ≫ wcLdpRho K K L (Over.mk h) ≫
        Limits.pullback.fst (Over.mk h).hom (Spec.map (CommRingCat.ofHom (algebraMap K K))) := by
      rw [hρ₀]; exact hsq.isoPullback_hom_fst.symm
    rw [hb]
    exact MIcomp _ _ (MIiso _) (MIcomp _ _ hm0 (MIiso _))
  haveI : IsProper (wcP1Over K).hom := wc_pp_proper K 1
  have hρm := s5 (wcP1Over K).hom (wcP1Over L).hom ρ hρ

  have T4 : ∀ {B₂ B P₂ P : Scheme.{u}} (ρ' : B₂ ⟶ B) (lam' : B ⟶ P) (lam₂' : B₂ ⟶ P₂)
      (pm' : P₂ ⟶ P), lam₂' ≫ pm' = ρ' ≫ lam' →
      (∀ x, Ideal.map (ρ'.stalkMap x).hom (IsLocalRing.maximalIdeal _) =
        IsLocalRing.maximalIdeal _) →
      ∀ (Δ' : Set P) (U : P.Opens) (φ : Γ(P, U)) (t₂ : B₂) (t : B), ρ' t₂ = t →
      ∀ (hU : lam' t ∈ U),
      (∀ (x : P) (hx : x ∈ U), x ∈ Δ' ↔
        (P.presheaf.germ U x hx).hom φ ∈ IsLocalRing.maximalIdeal (P.presheaf.stalk x)) →
      IsLocalRing.maximalIdeal (B.presheaf.stalk t) =
        Ideal.span {(lam'.stalkMap t).hom ((P.presheaf.germ U _ hU).hom φ)} →
      ∃ (hU₂ : lam₂' t₂ ∈ pm' ⁻¹ᵁ U),
        (∀ (x : P₂) (hx : x ∈ pm' ⁻¹ᵁ U), x ∈ ⇑pm' ⁻¹' Δ' ↔
          (P₂.presheaf.germ (pm' ⁻¹ᵁ U) x hx).hom ((pm'.app U).hom φ) ∈
            IsLocalRing.maximalIdeal (P₂.presheaf.stalk x)) ∧
        IsLocalRing.maximalIdeal (B₂.presheaf.stalk t₂) =
          Ideal.span {(lam₂'.stalkMap t₂).hom
            ((P₂.presheaf.germ (pm' ⁻¹ᵁ U) _ hU₂).hom ((pm'.app U).hom φ))} := by
    intro B₂ B P₂ P ρ' lam' lam₂' pm' hcomm hmax Δ' U φ t₂ t ht hU hT1 hT2
    subst ht
    have hpt2 : pm' (lam₂' t₂) = lam' (ρ' t₂) := by
      change (lam₂' ≫ pm') t₂ = (ρ' ≫ lam') t₂
      rw [hcomm]
    have hU₂ : lam₂' t₂ ∈ pm' ⁻¹ᵁ U := by
      show pm' (lam₂' t₂) ∈ U
      rw [hpt2]; exact hU
    have GS : ∀ (x : P₂) (hx : x ∈ pm' ⁻¹ᵁ U),
        (pm'.stalkMap x).hom ((P.presheaf.germ U (pm' x) hx).hom φ) =
          (P₂.presheaf.germ (pm' ⁻¹ᵁ U) x hx).hom ((pm'.app U).hom φ) :=
      fun x hx => Scheme.Hom.germ_stalkMap_apply pm' U x hx φ
    refine ⟨hU₂, ?_, ?_⟩
    · intro x hx
      rw [← GS x hx, Set.mem_preimage, hT1 (pm' x) hx]
      exact (map_mem_nonunits_iff (pm'.stalkMap x).hom _).symm
    · have T : ∀ (g₁ g₂ : B₂ ⟶ P) (e : g₁ = g₂) (hx₁ : t₂ ∈ g₁ ⁻¹ᵁ U) (hx₂ : t₂ ∈ g₂ ⁻¹ᵁ U),
          g₁.app U ≫ B₂.presheaf.germ (g₁ ⁻¹ᵁ U) t₂ hx₁ =
            g₂.app U ≫ B₂.presheaf.germ (g₂ ⁻¹ᵁ U) t₂ hx₂ := by
        intro g₁ g₂ e hx₁ hx₂
        subst e
        rfl
      have hx1 : t₂ ∈ (lam₂' ≫ pm') ⁻¹ᵁ U := hU₂
      have hx2 : t₂ ∈ (ρ' ≫ lam') ⁻¹ᵁ U := hU
      have e1 : pm'.app U ≫ P₂.presheaf.germ (pm' ⁻¹ᵁ U) (lam₂' t₂) hU₂ ≫ lam₂'.stalkMap t₂ =
          (lam₂' ≫ pm').app U ≫ B₂.presheaf.germ ((lam₂' ≫ pm') ⁻¹ᵁ U) t₂ hx1 := by
        rw [Scheme.Hom.germ_stalkMap lam₂' (pm' ⁻¹ᵁ U) t₂ hU₂, Scheme.Hom.comp_app]
        all_goals exact (Category.assoc _ _ _).symm
      have hU' : ρ' t₂ ∈ lam' ⁻¹ᵁ U := hU
      have e2 : P.presheaf.germ U (lam' (ρ' t₂)) hU ≫ lam'.stalkMap (ρ' t₂) ≫ ρ'.stalkMap t₂ =
          (ρ' ≫ lam').app U ≫ B₂.presheaf.germ ((ρ' ≫ lam') ⁻¹ᵁ U) t₂ hx2 := by
        rw [← Category.assoc, Scheme.Hom.germ_stalkMap lam' U (ρ' t₂) hU, Category.assoc,
          Scheme.Hom.germ_stalkMap ρ' (lam' ⁻¹ᵁ U) t₂ hU', Scheme.Hom.comp_app]
        all_goals exact (Category.assoc _ _ _).symm
      have k := e1.trans ((T _ _ hcomm hx1 hx2).trans e2.symm)
      have key : (lam₂'.stalkMap t₂).hom ((P₂.presheaf.germ (pm' ⁻¹ᵁ U) (lam₂' t₂) hU₂).hom
            ((pm'.app U).hom φ)) =
          (ρ'.stalkMap t₂).hom ((lam'.stalkMap (ρ' t₂)).hom
            ((P.presheaf.germ U (lam' (ρ' t₂)) hU).hom φ)) :=
        congrArg (fun ψ => CommRingCat.Hom.hom ψ φ) k
      rw [key, ← hmax t₂, hT2, Ideal.map_span, Set.image_singleton]

  obtain ⟨M', Xu, d, hsm, h, hprop, hstr, Δ, lam, p, hM, hΔ, hirr, hsmooth, hci, hlam,
    ⟨Lf, hLi, hrange⟩, hpb, hcrit, htrans⟩ := hW
  have PBK := PB M' K L

  have SQ := IsPullback.of_hasPullback h (wcLdpProjMap K L M')
  have hXu : IsPullback (Limits.pullback.fst h (wcLdpProjMap K L M'))
      (Limits.pullback.snd h (wcLdpProjMap K L M') ≫ wcProjKStr L M') Xu.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K L))) := by
    have h0 := SQ.paste_vert PBK
    rw [hstr] at h0
    exact h0
  have sm₂ : SmoothOfRelativeDimension d
      (Limits.pullback.snd h (wcLdpProjMap K L M') ≫ wcProjKStr L M') :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d) hXu hsm
  have pr₂ : IsProper (Limits.pullback.snd h (wcLdpProjMap K L M')) :=
    MorphismProperty.of_isPullback (P := @IsProper) SQ hprop

  have hirr₂ : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] [Algebra L Ω],
      IsIrreducible (⇑(wcLdpProjMap L Ω M') ⁻¹' (⇑(wcLdpProjMap K L M') ⁻¹' Δ)) := by
    intro Ω _ _ _
    letI : Algebra K Ω := ((algebraMap L Ω).comp (algebraMap K L)).toAlgebra
    haveI : IsScalarTower K L Ω := IsScalarTower.of_algebraMap_eq' rfl
    have hc := COMP M' K L Ω
    have hset : ⇑(wcLdpProjMap L Ω M') ⁻¹' (⇑(wcLdpProjMap K L M') ⁻¹' Δ) =
        ⇑(wcLdpProjMap K Ω M') ⁻¹' Δ := by
      ext x
      change (wcLdpProjMap L Ω M' ≫ wcLdpProjMap K L M') x ∈ Δ ↔ _
      rw [hc]
      rfl
    rw [hset]
    exact hirr Ω
  have hsmooth₂ : ∀ x : ↥(Limits.pullback h (wcLdpProjMap K L M')),
      Limits.pullback.snd h (wcLdpProjMap K L M') x ∉ ⇑(wcLdpProjMap K L M') ⁻¹' Δ →
      ∃ U : (Limits.pullback h (wcLdpProjMap K L M')).Opens, x ∈ U ∧
        Smooth (U.ι ≫ Limits.pullback.snd h (wcLdpProjMap K L M')) := by
    intro x hx
    have e1 : h (Limits.pullback.fst h (wcLdpProjMap K L M') x) =
        wcLdpProjMap K L M' (Limits.pullback.snd h (wcLdpProjMap K L M') x) := by
      change (Limits.pullback.fst h (wcLdpProjMap K L M') ≫ h) x =
        (Limits.pullback.snd h (wcLdpProjMap K L M') ≫ wcLdpProjMap K L M') x
      rw [Limits.pullback.condition]
    obtain ⟨U, hxU, hU⟩ := hsmooth (Limits.pullback.fst h (wcLdpProjMap K L M') x)
      (by rw [e1]; exact hx)
    refine ⟨Limits.pullback.fst h (wcLdpProjMap K L M') ⁻¹ᵁ U, hxU, ?_⟩
    have hq := (isPullback_morphismRestrict (Limits.pullback.fst h (wcLdpProjMap K L M')) U).paste_vert SQ
    exact MorphismProperty.of_isPullback (P := @Smooth) hq hU

  have wl : (ρ ≫ lam) ≫ wcProjKStr K M' =
      (wcP1Over L).hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K L)) := by
    rw [Category.assoc, hlam, hρ.w]
  obtain ⟨lam₂, hl1, hl2⟩ : ∃ lam₂ : (wcP1Over L).left ⟶ wcProjK L M',
      lam₂ ≫ wcLdpProjMap K L M' = ρ ≫ lam ∧ lam₂ ≫ wcProjKStr L M' = (wcP1Over L).hom :=
    ⟨PBK.lift _ _ wl, PBK.lift_fst _ _ wl, PBK.lift_snd _ _ wl⟩
  have LSQ : IsPullback ρ lam₂ lam (wcLdpProjMap K L M') := by
    refine IsPullback.of_bot ?_ hl1.symm PBK
    rw [hl2, hlam]
    exact hρ
  have hci₂ : IsClosedImmersion lam₂ :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) LSQ hci

  have hmem : ∀ a, MvPolynomial.map (algebraMap K L) (Lf a : MvPolynomial (Fin (M' + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) L 1 := fun a =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
      (((MvPolynomial.mem_homogeneousSubmodule 1 _).mp (Lf a).2).map _)
  have hLi₂ : LinearIndependent L
      (fun a => MvPolynomial.map (algebraMap K L) (Lf a : MvPolynomial (Fin (M' + 1)) K)) := by
    rw [Fintype.linearIndependent_iff] at hLi ⊢
    intro c hc a
    have b := Module.finBasis K L
    have key : ∀ ν μ, ∑ i, (Lf i : MvPolynomial (Fin (M' + 1)) K).coeff μ * b.repr (c i) ν = 0 := by
      intro ν μ
      have h0 : ∑ i, c i * algebraMap K L ((Lf i : MvPolynomial (Fin (M' + 1)) K).coeff μ) = 0 := by
        have := congrArg (fun P : MvPolynomial (Fin (M' + 1)) L => P.coeff μ) hc
        simpa [MvPolynomial.coeff_sum, MvPolynomial.coeff_smul, MvPolynomial.coeff_map] using this
      have h2 : b.repr (∑ i, c i * algebraMap K L
          ((Lf i : MvPolynomial (Fin (M' + 1)) K).coeff μ)) ν = 0 := by
        rw [h0]; simp
      rw [map_sum, Finsupp.finset_sum_apply] at h2
      refine (Finset.sum_congr rfl (fun i _ => ?_)).trans h2
      rw [mul_comm (c i), ← Algebra.smul_def, map_smul, Finsupp.smul_apply, smul_eq_mul]
    have hz : ∀ ν, ∀ i, b.repr (c i) ν = 0 := by
      intro ν
      apply hLi (fun i => b.repr (c i) ν)
      apply MvPolynomial.ext
      intro μ
      rw [MvPolynomial.coeff_sum]
      have h3 := key ν μ
      simp only [MvPolynomial.coeff_smul, smul_eq_mul]
      rw [show ((0 : MvPolynomial (Fin (M' + 1)) K)).coeff μ = 0 from rfl]
      exact (Finset.sum_congr rfl (fun i _ => mul_comm _ _)).trans h3
    have hr : b.repr (c a) = 0 := by
      ext ν
      exact hz ν a
    exact b.repr.map_eq_zero_iff.mp hr
  have hBO : ∀ (a : Fin (M' - 1)) (x : wcProjK L M'),
      x ∈ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) L)
        MvPolynomial.gradedAlgebra
        (MvPolynomial.map (algebraMap K L) (Lf a : MvPolynomial (Fin (M' + 1)) K)) ↔
      wcLdpProjMap K L M' x ∈ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) K) MvPolynomial.gradedAlgebra
        (Lf a : MvPolynomial (Fin (M' + 1)) K) := by
    intro a x
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) K))
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) L))
    obtain ⟨hf, ehf⟩ : ∃ h, wcLdpProjMap K L M' = Proj.map (wcLdpGrHom K L M') h := ⟨_, rfl⟩
    have h1 : Proj.map (wcLdpGrHom K L M') hf ⁻¹ᵁ
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) K)
          (Lf a : MvPolynomial (Fin (M' + 1)) K) =
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) L)
          (wcLdpGrHom K L M' (Lf a : MvPolynomial (Fin (M' + 1)) K)) :=
      Proj.map_preimage_basicOpen _ _ _
    rw [ehf, ← Scheme.Hom.mem_preimage, h1]
    rfl
  have hrange₂ : Set.range lam₂ = {x | ∀ a, x ∉ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) L) MvPolynomial.gradedAlgebra
      (MvPolynomial.map (algebraMap K L) (Lf a : MvPolynomial (Fin (M' + 1)) K))} := by
    ext x
    have hR : x ∈ Set.range lam₂ ↔ wcLdpProjMap K L M' x ∈ Set.range lam := by
      constructor
      · rintro ⟨t, rfl⟩
        refine ⟨ρ t, ?_⟩
        change (ρ ≫ lam) t = (lam₂ ≫ wcLdpProjMap K L M') t
        rw [hl1]
      · rintro ⟨t, ht⟩
        obtain ⟨z, -, hz2⟩ := Scheme.Pullback.exists_preimage_pullback
          (f := lam) (g := wcLdpProjMap K L M') t x ht
        refine ⟨LSQ.isoPullback.inv z, ?_⟩
        rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_snd]
        exact hz2
    rw [hR, hrange]
    simp only [Set.mem_setOf_eq]
    exact forall_congr' (fun a => not_congr (hBO a x).symm)

  have wp : (β ≫ p) ≫ h = (f₂ ≫ lam₂) ≫ wcLdpProjMap K L M' := by
    calc (β ≫ p) ≫ h = β ≫ f ≫ lam := by rw [Category.assoc, hpb.w]
      _ = f₂ ≫ ρ ≫ lam := by rw [← Category.assoc, hβ.w, Category.assoc]
      _ = (f₂ ≫ lam₂) ≫ wcLdpProjMap K L M' := by rw [Category.assoc, hl1]
  obtain ⟨p₂, hp1, hp2⟩ : ∃ p₂ : T₂ ⟶ Limits.pullback h (wcLdpProjMap K L M'),
      p₂ ≫ Limits.pullback.fst _ _ = β ≫ p ∧ p₂ ≫ Limits.pullback.snd _ _ = f₂ ≫ lam₂ :=
    ⟨Limits.pullback.lift _ _ wp, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hpb₂ : IsPullback p₂ f₂ (Limits.pullback.snd h (wcLdpProjMap K L M')) lam₂ := by
    refine IsPullback.of_right ?_ hp2 SQ
    rw [hp1, hl1]
    exact hβ.paste_horiz hpb

  have hpt : ∀ i : Fin m₂, ρ (S₂ i (IsLocalRing.closedPoint L)) =
      S (Fin.cast e i) (IsLocalRing.closedPoint K) := by
    intro i
    change (S₂ i ≫ ρ) (IsLocalRing.closedPoint L) = _
    rw [hSρ i]
    exact congrArg (fun z => S (Fin.cast e i) z) (Subsingleton.elim _ _)
  have hfib : ∀ (j : Fin m) (t t' : (wcP1Over L).left), ρ t = S j (IsLocalRing.closedPoint K) →
      ρ t' = S j (IsLocalRing.closedPoint K) → t = t' := by
    intro j t t' ht ht'
    have h1 := (IsPullback.of_hasPullback ρ (S j)).flip.paste_vert hρ
    rw [hS j] at h1
    let φ := IsPullback.isoIsPullback _ _ h1
      (IsPullback.id_vert (Spec.map (CommRingCat.ofHom (algebraMap K L))))
    obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := ρ) (g := S j) t (IsLocalRing.closedPoint K) ht
    obtain ⟨z', hz', -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := ρ) (g := S j) t' (IsLocalRing.closedPoint K) ht'
    have hzz : z = z' := by
      have h2 : φ.hom z = φ.hom z' := Subsingleton.elim _ _
      first
        | exact φ.hom.homeomorph.injective h2
        | (have h3 := congrArg (fun w => φ.inv w) h2
           simp only at h3
           rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, φ.hom_inv_id] at h3
           simpa using h3)
    rw [← hz, ← hz', hzz]
  have hcrit₂ : ∀ t : (wcP1Over L).left, lam₂ t ∈ ⇑(wcLdpProjMap K L M') ⁻¹' Δ ↔
      ∃ i, t = S₂ i (IsLocalRing.closedPoint L) := by
    intro t
    have e1 : wcLdpProjMap K L M' (lam₂ t) = lam (ρ t) := by
      change (lam₂ ≫ wcLdpProjMap K L M') t = (ρ ≫ lam) t
      rw [hl1]
    rw [Set.mem_preimage, e1, hcrit]
    constructor
    · rintro ⟨j, hj⟩
      refine ⟨Fin.cast e.symm j, ?_⟩
      have hj' : Fin.cast e (Fin.cast e.symm j) = j := Fin.ext rfl
      have h3 := hpt (Fin.cast e.symm j)
      rw [hj'] at h3
      exact hfib j t _ hj h3
    · rintro ⟨i, rfl⟩
      exact ⟨Fin.cast e i, hpt i⟩

  refine ⟨M', Over.mk (Limits.pullback.snd h (wcLdpProjMap K L M') ≫ wcProjKStr L M'), d, sm₂,
    Limits.pullback.snd h (wcLdpProjMap K L M'), pr₂, rfl, ⇑(wcLdpProjMap K L M') ⁻¹' Δ, lam₂, p₂,
    hM, hΔ.preimage (wcLdpProjMap K L M').continuous, hirr₂, hsmooth₂, hci₂, hl2,
    ⟨fun a => ⟨_, hmem a⟩, hLi₂, hrange₂⟩, hpb₂, hcrit₂, ?_⟩

  intro i
  obtain ⟨U, hU, φ, hT1, hT2⟩ := htrans (Fin.cast e i)
  obtain ⟨hU₂, h1, h2⟩ := T4 ρ lam lam₂ (wcLdpProjMap K L M') hl1 hρm Δ U φ
    (S₂ i (IsLocalRing.closedPoint L)) _ (hpt i) hU hT1 hT2
  exact ⟨_, hU₂, _, h1, h2⟩

theorem wc_ldnm_family_datum_exists (F' : Type u) [Finite F'] [Field F']
    (Y : Over (Spec (.of F'))) [GeometricallyIrreducible Y.hom] [IsProper Y.hom] (n : ℕ)
    [SmoothOfRelativeDimension n Y.hom] (hn : Even n) (hn2 : 2 ≤ n)
    (N : ℕ) (j : Y.left ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
      MvPolynomial.gradedAlgebra)
    (hj : IsClosedImmersion j)
    (hjY : j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))) = Y.hom) :
    ∃ (F'' : Type u) (_ : Field F'') (_ : Finite F'') (_ : Algebra F' F''),
      ∃ D : wcLefschetzDatum F' F'' Y n, wcPencilFamily D :=
by
  obtain ⟨F₁, _, _, _, P, hW⟩ := wc_ldnm_predatum_family F' Y n hn hn2 N j hj hjY
  obtain ⟨F'', _, _, _, _, D, ρ, β, e, hρ, hβ, hS⟩ :=
    wc_ldnm_complete_predatum_bc F' Y n hn2 F₁ P
  exact ⟨F'', inferInstance, inferInstance, inferInstance, D,
    wc_ldnm_family_transport F₁ F'' P.Yt.left P.f P.m P.S P.hS D.Yt.left D.f D.m e D.S D.hS
      ρ β hρ hβ hS hW⟩

theorem wc_P1bar_facts (F'' : Type u) [Field F''] [Finite F'']
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    IsIntegral (wcGeomPoint F'' (wcP1Over F'') hP).left ∧
      topologicalKrullDim (wcGeomPoint F'' (wcP1Over F'') hP).left = ((1 : ℕ) : WithBot ℕ∞) :=
by
  classical

  have hirr : ∀ (K : Type u) [Field K] (n : ℕ), IrreducibleSpace ↥(wcProjK K n) := by
    intro K _ n
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
      MvPolynomial.gradedAlgebra
    show IrreducibleSpace (ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K))
    have hX : (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K) ∈
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) := by
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
      exact DirectSum.decompose_of_mem_ne _
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K 0))
        one_ne_zero
    have hprime : (⊥ : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).toIdeal.IsPrime := by
      rw [HomogeneousIdeal.toIdeal_bot]; exact Ideal.isPrime_bot
    have hrel : ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) ≤ ⊥ := by
      intro h
      have h1 : (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K) ∈
          (⊥ : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)) := h hX
      have h2 : (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K) ∈
          (⊥ : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).toIdeal := h1
      rw [HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at h2
      exact MvPolynomial.X_ne_zero 0 h2
    obtain ⟨η, hη⟩ : ∃ η : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K),
        η = ⟨⊥, hprime, hrel⟩ := ⟨_, rfl⟩
    have hcl : closure ({η} : Set _) = Set.univ := Set.eq_univ_of_forall fun x =>
      (ProjectiveSpectrum.le_iff_mem_closure _ η x).mp
        ((ProjectiveSpectrum.as_ideal_le_as_ideal _ η x).mp (by rw [hη]; exact bot_le))
    have hirrU : IsIrreducible (Set.univ : Set (ProjectiveSpectrum
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K))) :=
      hcl ▸ isIrreducible_singleton.closure
    exact (irreducibleSpace_def _).mpr hirrU

  have hred : ∀ (K : Type u) [Field K] (n : ℕ), IsReduced (wcProjK K n) := by
    intro K _ n
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hst : ∀ x : ↥(wcProjK K n), _root_.IsReduced ((wcProjK K n).presheaf.stalk x) := by
      intro x
      haveI hp : x.asHomogeneousIdeal.toIdeal.IsPrime := x.isPrime
      haveI : IsDomain (Localization x.asHomogeneousIdeal.toIdeal.primeCompl) :=
        IsLocalization.isDomain_localization
          (Ideal.primeCompl_le_nonZeroDivisors x.asHomogeneousIdeal.toIdeal)
      haveI hR : _root_.IsReduced (HomogeneousLocalization.AtPrime
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) x.asHomogeneousIdeal.toIdeal) := by
        refine isReduced_of_injective (algebraMap (HomogeneousLocalization
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) x.asHomogeneousIdeal.toIdeal.primeCompl)
          (Localization x.asHomogeneousIdeal.toIdeal.primeCompl)) ?_
        intro a b hab
        simp only [HomogeneousLocalization.algebraMap_apply] at hab
        exact HomogeneousLocalization.val_injective _ hab
      exact isReduced_of_injective
        (Proj.stalkIso (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) x).commRingCatIsoToRingEquiv
        (RingEquiv.injective _)
    exact isReduced_of_isReduced_stalk _
  obtain ⟨e, he, -⟩ := wcpa_proj_base_change F'' (AlgebraicClosure F'') 1
  haveI := he
  haveI := hirr (AlgebraicClosure F'') 1
  haveI := hred (AlgebraicClosure F'') 1
  haveI : IsIntegral (wcProjK (AlgebraicClosure F'') 1) :=
    isIntegral_of_irreducibleSpace_of_isReduced _
  refine ⟨?_, ?_⟩
  · have hI := @IsIntegral.of_isIso _ _ inferInstance (@asIso _ _ _ _ e he).inv inferInstance
    exact hI
