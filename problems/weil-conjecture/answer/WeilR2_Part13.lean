    · simp only [Category.assoc]
      rw [← Category.assoc q' β, F2, Category.assoc, ← Category.assoc q G, g2, Category.assoc,
        IsIso.hom_inv_id_assoc, ← Category.assoc q' a', hya']


  have e1 : γ ≫ β = 𝟙 _ := by
    refine (hlim (Spec (.of B)) φ hcomp).unique (y₁ := γ ≫ β) (y₂ := 𝟙 _) (fun l => ?_)
