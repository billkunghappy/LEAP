    Proj.isAffineOpen_basicOpen _ (MvPolynomial.X b) (hXb b) Nat.one_pos
  have hVaff : ∀ b : Fin (N + 1), IsAffineOpen (ι ⁻¹ᵁ wcSgD K N b) := fun b =>
    (hDaff b).preimage ι

  have hred : ∀ (R : Type u) [CommRing R] (g : MvPolynomial (Fin n) K →+* R), g.Etale →
      _root_.IsReduced R := by
    intro R _ g hg
    letI := g.toAlgebra
    haveI : Algebra.Etale (MvPolynomial (Fin n) K) R := hg
    have hinj := Algebra.TensorProduct.includeRight_injective (R := MvPolynomial (Fin n) K)
      (A := FractionRing (MvPolynomial (Fin n) K)) (B := R)
      (IsFractionRing.injective (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K)))
    haveI : _root_.IsReduced (TensorProduct (MvPolynomial (Fin n) K)
        (FractionRing (MvPolynomial (Fin n) K)) R) :=
      Algebra.FormallyUnramified.isReduced_of_field (FractionRing (MvPolynomial (Fin n) K)) _
    exact isReduced_of_injective _ hinj
  have hY : (⨆ j : Fin (N + 1), Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X j)) = ⊤ := by
    apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
    intro a ha
