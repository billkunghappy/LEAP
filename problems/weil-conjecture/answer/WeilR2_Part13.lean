    constructor
    · rw [← hφeq]
      intro x
      obtain ⟨⟨b, t⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl x
      obtain ⟨a, rfl⟩ := hθ b
      have ht : (t : B) ∈ Submonoid.map θ P.primeCompl := by rw [hT]; exact t.2
      obtain ⟨a', ha', hta⟩ := ht
      refine ⟨IsLocalization.mk' Aₚ a ⟨a', ha'⟩, ?_⟩
      show _ = IsLocalization.mk' Bq (θ a) t
