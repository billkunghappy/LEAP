  let μ : ∀ (e : ℕ), MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e →
      (∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)) →ₗ[K]
      (∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)) := fun e F =>
    { toFun := wcEszMul κ e F
      map_add' := fun c c' => by
        funext a b
        simp only [wcEszMul, Pi.add_apply, mul_add]
      map_smul' := fun t c => by
        funext a b
        show (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
            κ ⁻¹ᵁ wcSgD K N a)).op).hom (wcEszDh κ e F a) *
            (wcEszScal κ (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b) t * c a b) =
          wcEszScal κ (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b) t *
            ((W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
              κ ⁻¹ᵁ wcSgD K N a)).op).hom (wcEszDh κ e F a) * c a b)
        ring }
  have hμapp : ∀ e F c, μ e F c = wcEszMul κ e F c := fun _ _ _ => rfl

  have alg : ∀ {R : Type u} [CommRing R] (f f' fb γ x y z : R) (m e : ℕ), f' = f →
      fb = γ ^ e * f → x + γ ^ (m + e) * y = z → f * x + γ ^ m * (fb * y) = f' * z := by
    intro R _ f f' fb γ x y z m e h1 h2 h3
    subst h1 h2
    rw [← h3]
    ring
  have hμ : ∀ (e : ℕ) (F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) (m : ℕ)
      (c : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)),
      (wcEszCoc κ (m + e) c → wcEszCoc κ m (wcEszMul κ e F c)) ∧
      (wcEszCob κ (m + e) c → wcEszCob κ m (wcEszMul κ e F c)) := by
    intro e F m c
    constructor
    · intro hc a b l
      have e1 := congrArg (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓
        κ ⁻¹ᵁ wcSgD K N b ⊓ κ ⁻¹ᵁ wcSgD K N l ≤ κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)).op).hom
        (htw e F a b)
      rw [map_mul, map_pow, resW, resW] at e1
      simp only [wcEszMul, wcEszDh, map_mul, resW]
      exact alg _ _ _ _ _ _ _ m e rfl e1 (hc a b l)
    · rintro ⟨d, hd⟩
      refine ⟨fun a => (κ.app (wcSgD K N a)).hom (wcEszSec K N e F a) * d a, fun a b => ?_⟩
      simp only [wcEszMul, wcEszDh, map_mul]
      rw [hd a b, htw e F a b, pow_add]
      ring
  have hg3 : ∀ (d M : ℕ) (t : Fin (M + 1) → K)
      (G : Fin (M + 1) → MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d)
      (z : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)),
      wcEszMul κ d (∑ i, t i • G i) z = (∑ i, t i • μ d (G i)) z := by
    intro d M t G z
    funext a b
    rw [LinearMap.sum_apply, Finset.sum_apply, Finset.sum_apply]
    simp only [wcEszMul, wcEszDh]
    rw [hDsum, map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_mul, hR4]
    show _ = wcEszScal κ (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b) (t i) *
      ((W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
        κ ⁻¹ᵁ wcSgD K N a)).op).hom ((κ.app (wcSgD K N a)).hom (wcEszSec K N d (G i) a)) * z a b)
    ring
  have hexp : ∀ (q : ℕ)
      (z : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)) (s : Fin q → K)
      (D : Fin q → ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)),
      (z - ∑ l, s l • D l) = fun a b => z a b -
        ∑ l, wcEszScal κ (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b) (s l) * D l a b := by
    intro q z s D
    funext a b
    simp only [Pi.sub_apply, Finset.sum_apply]
    rfl
  obtain ⟨m₀, hm₀⟩ := L1 _ Zs Bs
    (by
      intro m
      obtain ⟨p, v, hv, hsp⟩ := H1 m
      refine ⟨p, v, hv, fun z hz => ?_⟩
      obtain ⟨t, ht⟩ := hsp z hz
      refine ⟨t, ?_⟩
      show wcEszCob κ m (z - ∑ i, t i • v i)
      rw [hexp]
      exact ht)
    (μ 1 ℓF)
    (fun m z hz => (hμ 1 ℓF m z).1 hz)
    (fun m z hz => (hμ 1 ℓF m z).2 hz)
    (by
      obtain ⟨m₁, h⟩ := H2 1 le_rfl ℓF hℓF
      exact ⟨m₁, fun m hm z hz hℓz => h m hm z hz hℓz⟩)
    (by
      intro M₀
      obtain ⟨d, hd, G, hG⟩ := H4 M₀
      refine ⟨d, fun i => μ d (G i), fun i m z hz => (hμ d (G i) m z).1 hz,
        fun i m z hz => (hμ d (G i) m z).2 hz, fun i z => ?_, fun t ht => ?_⟩
      · rw [hμapp, hμapp, hμapp, hμapp]
        funext a b
        simp only [wcEszMul]
        ring
      · obtain ⟨m₂, hm₂⟩ := H2 d hd (∑ i, t i • G i) (hG t ht)
        refine ⟨m₂, fun m hm z hz hs => hm₂ m hm z hz ?_⟩
        rw [hg3]
        exact hs)
  exact ⟨m₀, fun m hm c hc => hm₀ m hm c hc⟩

theorem wc_esz_vk_of_vanishing (K : Type u) [Field K] (N : ℕ) (W : Scheme.{u})
    [AlgebraicGeometry.IsIntegral W] (κ : W ⟶ wcProjK K N)
    (H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2) (k : ℕ) (hk : 1 ≤ k)
    (hvan : ∀ c : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b),
      wcEszCoc κ (2 * k) c → wcEszCob κ (2 * k) c)
    (c : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b))
    (hc : ∀ a b l : Fin (N + 1),
      (W.presheaf.map (homOfLE (inf_le_left.trans inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓
          κ ⁻¹ᵁ wcSgD K N b ⊓ κ ⁻¹ᵁ wcSgD K N l ≤ κ ⁻¹ᵁ wcSgD K N a)).op).hom
          ((κ.app (wcSgD K N a)).hom (wcLdpSec K N H a)) ^ k *
        (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ⊓
          κ ⁻¹ᵁ wcSgD K N l ≤ κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)).op).hom (c a b) +
      (W.presheaf.map (homOfLE (inf_le_left.trans inf_le_right : κ ⁻¹ᵁ wcSgD K N a ⊓
          κ ⁻¹ᵁ wcSgD K N b ⊓ κ ⁻¹ᵁ wcSgD K N l ≤ κ ⁻¹ᵁ wcSgD K N b)).op).hom
          ((κ.app (wcSgD K N b)).hom (wcLdpSec K N H b)) ^ k *
        (W.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
          κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ⊓ κ ⁻¹ᵁ wcSgD K N l ≤
            κ ⁻¹ᵁ wcSgD K N b ⊓ κ ⁻¹ᵁ wcSgD K N l)).op).hom (c b l) =
      (W.presheaf.map (homOfLE (inf_le_left.trans inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓
          κ ⁻¹ᵁ wcSgD K N b ⊓ κ ⁻¹ᵁ wcSgD K N l ≤ κ ⁻¹ᵁ wcSgD K N a)).op).hom
          ((κ.app (wcSgD K N a)).hom (wcLdpSec K N H a)) ^ k *
        (W.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
          κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ⊓ κ ⁻¹ᵁ wcSgD K N l ≤
            κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N l)).op).hom (c a l)) :
    ∃ d : ∀ a : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a), ∀ a b : Fin (N + 1),
      (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
          κ ⁻¹ᵁ wcSgD K N a)).op).hom ((κ.app (wcSgD K N a)).hom (wcLdpSec K N H a)) ^ k *
        c a b =
      (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
          κ ⁻¹ᵁ wcSgD K N a)).op).hom ((κ.app (wcSgD K N a)).hom (wcLdpSec K N H a)) ^ k *
        (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
          κ ⁻¹ᵁ wcSgD K N a)).op).hom (d a) -
      (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
          κ ⁻¹ᵁ wcSgD K N b)).op).hom ((κ.app (wcSgD K N b)).hom (wcLdpSec K N H b)) ^ k *
        (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
          κ ⁻¹ᵁ wcSgD K N b)).op).hom (d b) :=
by

  have htw : ∀ a b : Fin (N + 1),
      (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
          κ ⁻¹ᵁ wcSgD K N b)).op).hom ((κ.app (wcSgD K N b)).hom (wcLdpSec K N H b)) =
        wcEszG κ a b ^ 2 *
        (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
          κ ⁻¹ᵁ wcSgD K N a)).op).hom ((κ.app (wcSgD K N a)).hom (wcLdpSec K N H a)) := by
    intro a b
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hXa : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a)
    have hXb : (MvPolynomial.X b : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K b)
    have hXa' : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (1 • 1) := by
      rw [smul_eq_mul, mul_one]; exact hXa
    have hle_a : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X a * MvPolynomial.X b) ≤ wcSgD K N a := fun y hy =>
      ((Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) _ _).le hy).1
    have hle_b : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X a * MvPolynomial.X b) ≤ wcSgD K N b := fun y hy =>
      ((Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) _ _).le hy).2
    have hA : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a * MvPolynomial.X b)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            hXb (rfl : MvPolynomial.X a * MvPolynomial.X b = MvPolynomial.X a * MvPolynomial.X b)
            (HomogeneousLocalization.Away.mk _ hXa 2 (H : MvPolynomial (Fin (N + 1)) K) H.2)) =
        ((wcProjK K N).presheaf.map (homOfLE hle_a).op).hom (wcLdpSec K N H a) :=
      congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hXa 2
        (H : MvPolynomial (Fin (N + 1)) K) H.2))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (f := MvPolynomial.X a) hXb (x := MvPolynomial.X a * MvPolynomial.X b) rfl)
    have hB : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a * MvPolynomial.X b)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
            (HomogeneousLocalization.Away.mk _ hXb 2 (H : MvPolynomial (Fin (N + 1)) K) H.2)) =
        ((wcProjK K N).presheaf.map (homOfLE hle_b).op).hom (wcLdpSec K N H b) :=
      congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hXb 2
        (H : MvPolynomial (Fin (N + 1)) K) H.2))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (f := MvPolynomial.X b) hXa (x := MvPolynomial.X a * MvPolynomial.X b)
        (mul_comm (MvPolynomial.X a) (MvPolynomial.X b)))
    have hEa : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a * MvPolynomial.X b)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
            (HomogeneousLocalization.Away.mk _ hXb 1 (MvPolynomial.X a) hXa')) =
        ((wcProjK K N).presheaf.map (homOfLE hle_b).op).hom (wcSgE K N b a) :=
      congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hXb 1 (MvPolynomial.X a) hXa'))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (f := MvPolynomial.X b) hXa (x := MvPolynomial.X a * MvPolynomial.X b)
        (mul_comm (MvPolynomial.X a) (MvPolynomial.X b)))
    have c1 : HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
          (HomogeneousLocalization.Away.mk _ hXb 2 (H : MvPolynomial (Fin (N + 1)) K) H.2) =
        HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
          (HomogeneousLocalization.Away.mk _ hXb 1 (MvPolynomial.X a) hXa') *
        HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
          (HomogeneousLocalization.Away.mk _ hXb 1 (MvPolynomial.X a) hXa') *
        HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          hXb (rfl : MvPolynomial.X a * MvPolynomial.X b = MvPolynomial.X a * MvPolynomial.X b)
          (HomogeneousLocalization.Away.mk _ hXa 2 (H : MvPolynomial (Fin (N + 1)) K) H.2) := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.val_mul,
        HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.mk_mul, Localization.mk_mul, Localization.mk_eq_mk_iff]
      apply Localization.r_of_eq
      simp only [Submonoid.coe_mul]
      ring
    have e : wcSgD K N a ⊓ wcSgD K N b ≤
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a * MvPolynomial.X b) :=
      (Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) _ _).ge
    have kl : ∀ s : Γ(wcProjK K N, wcSgD K N a),
        ((wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N a ⊓ wcSgD K N b ≤
            wcSgD K N a)).op).hom s =
          ((wcProjK K N).presheaf.map (homOfLE e).op).hom
            (((wcProjK K N).presheaf.map (homOfLE hle_a).op).hom s) := fun s =>
      congrArg (fun φ => φ.hom s)
        ((wcProjK K N).presheaf.map_comp (homOfLE hle_a).op (homOfLE e).op)
    have kr : ∀ s : Γ(wcProjK K N, wcSgD K N b),
        ((wcProjK K N).presheaf.map (homOfLE (inf_le_right : wcSgD K N a ⊓ wcSgD K N b ≤
            wcSgD K N b)).op).hom s =
          ((wcProjK K N).presheaf.map (homOfLE e).op).hom
            (((wcProjK K N).presheaf.map (homOfLE hle_b).op).hom s) := fun s =>
      congrArg (fun φ => φ.hom s)
        ((wcProjK K N).presheaf.map_comp (homOfLE hle_b).op (homOfLE e).op)
    have hP : ((wcProjK K N).presheaf.map (homOfLE (inf_le_right : wcSgD K N a ⊓ wcSgD K N b ≤
            wcSgD K N b)).op).hom (wcLdpSec K N H b) =
        ((wcProjK K N).presheaf.map (homOfLE (inf_le_right : wcSgD K N a ⊓ wcSgD K N b ≤
            wcSgD K N b)).op).hom (wcSgE K N b a) ^ 2 *
        ((wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N a ⊓ wcSgD K N b ≤
            wcSgD K N a)).op).hom (wcLdpSec K N H a) := by
      rw [kr, kr, kl, ← hA, ← hB, ← hEa, c1]
      simp only [map_mul, sq]
    have el : (κ.app (wcSgD K N a ⊓ wcSgD K N b)).hom
        (((wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N a ⊓ wcSgD K N b ≤
            wcSgD K N a)).op).hom (wcLdpSec K N H a)) =
        (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
            κ ⁻¹ᵁ wcSgD K N a)).op).hom ((κ.app (wcSgD K N a)).hom (wcLdpSec K N H a)) :=
      congrArg (fun φ => φ.hom (wcLdpSec K N H a))
        (Scheme.Hom.naturality κ (homOfLE (inf_le_left : wcSgD K N a ⊓ wcSgD K N b ≤
            wcSgD K N a)).op)
    have er : (κ.app (wcSgD K N a ⊓ wcSgD K N b)).hom
        (((wcProjK K N).presheaf.map (homOfLE (inf_le_right : wcSgD K N a ⊓ wcSgD K N b ≤
            wcSgD K N b)).op).hom (wcLdpSec K N H b)) =
        (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
            κ ⁻¹ᵁ wcSgD K N b)).op).hom ((κ.app (wcSgD K N b)).hom (wcLdpSec K N H b)) :=
      congrArg (fun φ => φ.hom (wcLdpSec K N H b))
        (Scheme.Hom.naturality κ (homOfLE (inf_le_right : wcSgD K N a ⊓ wcSgD K N b ≤
            wcSgD K N b)).op)
    have eg : (κ.app (wcSgD K N a ⊓ wcSgD K N b)).hom
        (((wcProjK K N).presheaf.map (homOfLE (inf_le_right : wcSgD K N a ⊓ wcSgD K N b ≤
            wcSgD K N b)).op).hom (wcSgE K N b a)) =
        (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
            κ ⁻¹ᵁ wcSgD K N b)).op).hom ((κ.app (wcSgD K N b)).hom (wcSgE K N b a)) :=
      congrArg (fun φ => φ.hom (wcSgE K N b a))
        (Scheme.Hom.naturality κ (homOfLE (inf_le_right : wcSgD K N a ⊓ wcSgD K N b ≤
            wcSgD K N b)).op)
    unfold wcEszG
    rw [← el, ← er, ← eg, hP, map_mul, map_pow] <;> rfl
  by_cases hB : ∃ a₀, (κ.app (wcSgD K N a₀)).hom (wcLdpSec K N H a₀) ≠ 0
  · obtain ⟨a₀, h₀⟩ := hB

    have hE : ∀ (V : W.Opens), genericPoint W ∉ V → ∀ s t : Γ(W, V), s = t := by
      intro V hV s t
      apply TopCat.Presheaf.section_ext W.sheaf V s t
      intro x hx
      exact absurd (((genericPoint_spec W).mem_open_set_iff V.isOpen).mpr ⟨x, trivial, hx⟩) hV
    have gr : ∀ {U V : W.Opens} (i : U ⟶ V) (hx : genericPoint W ∈ U) (s : Γ(W, V)),
        (W.presheaf.germ U (genericPoint W) hx).hom ((W.presheaf.map i.op).hom s) =
        (W.presheaf.germ V (genericPoint W) (leOfHom i hx)).hom s :=
      fun i hx s => TopCat.Presheaf.germ_res_apply W.presheaf i _ hx s
    have alg : ∀ {R : Type u} [CommRing R] [IsDomain R] (A B G X Y Z : R), A ≠ 0 →
        B = G ^ 2 * A → A ^ k * X + B ^ k * Y = A ^ k * Z → X + G ^ (2 * k) * Y = Z := by
      intro R _ _ A B G X Y Z hA hBA h
      subst hBA
      have key : A ^ k * (X + G ^ (2 * k) * Y - Z) = 0 := by linear_combination h
      have h2 := (mul_eq_zero.mp key).resolve_left (pow_ne_zero k hA)
      linear_combination h2
    have hη0 : genericPoint W ∈ κ ⁻¹ᵁ wcSgD K N a₀ := by
      by_contra hn
      exact h₀ (hE _ hn _ _)
    have hg0 : (W.presheaf.germ _ (genericPoint W) hη0).hom
        ((κ.app (wcSgD K N a₀)).hom (wcLdpSec K N H a₀)) ≠ 0 := by
      intro h
      apply h₀
      exact germ_injective_of_isIntegral W _ hη0
        (h.trans (map_zero (W.presheaf.germ _ (genericPoint W) hη0).hom).symm)
    have hga : ∀ (a : Fin (N + 1)) (ha : genericPoint W ∈ κ ⁻¹ᵁ wcSgD K N a),
        (W.presheaf.germ _ (genericPoint W) ha).hom
          ((κ.app (wcSgD K N a)).hom (wcLdpSec K N H a)) ≠ 0 := by
      intro a ha h
      have hm : genericPoint W ∈ κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N a₀ :=
        TopologicalSpace.Opens.mem_inf.mpr ⟨ha, hη0⟩
      have e := congrArg (W.presheaf.germ _ (genericPoint W) hm).hom (htw a a₀)
      rw [map_mul, map_pow, gr, gr, h, mul_zero] at e
      exact hg0 e
    have hcoc : wcEszCoc κ (2 * k) c := by
      unfold wcEszCoc
      intro a b l
      by_cases hV : genericPoint W ∈
          κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ⊓ κ ⁻¹ᵁ wcSgD K N l
      swap
      · exact hE _ hV _ _
      have hab : genericPoint W ∈ κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b :=
        (TopologicalSpace.Opens.mem_inf.mp hV).1
      have ha : genericPoint W ∈ κ ⁻¹ᵁ wcSgD K N a :=
        (TopologicalSpace.Opens.mem_inf.mp hab).1
      refine germ_injective_of_isIntegral W _ hV ?_
      show (W.presheaf.germ _ (genericPoint W) hV).hom _ =
        (W.presheaf.germ _ (genericPoint W) hV).hom _
      have e1 := congrArg (W.presheaf.germ _ (genericPoint W) hV).hom (hc a b l)
      have e2 := congrArg (W.presheaf.germ _ (genericPoint W) hab).hom (htw a b)
      simp only [map_add, map_mul, map_pow, gr] at e1 e2 ⊢
      exact alg _ _ _ _ _ _ (hga a ha) e2 e1
    obtain ⟨d, hd⟩ := hvan c hcoc
    refine ⟨d, fun a b => ?_⟩
    rw [hd a b, htw a b]
    ring
  · push_neg at hB
    refine ⟨0, fun a b => ?_⟩
    rw [hB a, hB b]
    simp only [map_zero, Pi.zero_apply, zero_pow (show k ≠ 0 by omega), zero_mul, sub_self]

theorem wc_ldp_qsc_esz_lift (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (N n : ℕ)
    (hn2 : 2 ≤ n) (W : Scheme.{u}) (r : W ⟶ Spec (.of Ω)) [IrreducibleSpace W]
    [SmoothOfRelativeDimension n r] (κ : W ⟶ wcProjK Ω N) (hκ : IsClosedImmersion κ)
    (hκr : κ ≫ wcProjKStr Ω N = r) (H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 2) :
    ∃ k : ℕ, 1 ≤ k ∧ ∀ f : ∀ a : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD Ω N a),
      (∀ a b : Fin (N + 1),
        (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
            κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (f a) -
          (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
            κ ⁻¹ᵁ wcSgD Ω N b)).op).hom (f b) ∈
        Ideal.span {((W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓
            κ ⁻¹ᵁ wcSgD Ω N b ≤ κ ⁻¹ᵁ wcSgD Ω N a)).op).hom
          ((κ.app (wcSgD Ω N a)).hom (wcLdpSec Ω N H a))) ^ k}) →
      ∃ g : Γ(W, ⊤), ∀ a : Fin (N + 1),
        (W.presheaf.map (homOfLE (le_top : κ ⁻¹ᵁ wcSgD Ω N a ≤ ⊤)).op).hom g - f a ∈
          Ideal.span {((κ.app (wcSgD Ω N a)).hom (wcLdpSec Ω N H a)) ^ k} :=
by
  classical

  have hdom : ∀ w : W, IsDomain (W.presheaf.stalk w) := fun w =>
    wcpa_smooth_stalk_isDomain Ω W r n w
  haveI : ∀ w : W, _root_.IsReduced (W.presheaf.stalk w) := fun w => by
    haveI := hdom w
    infer_instance
  haveI : IsReduced W := isReduced_of_isReduced_stalk W
  haveI : IsIntegral W := isIntegral_of_irreducibleSpace_of_isReduced W
  obtain ⟨w₀⟩ : Nonempty W := inferInstance

  have hcov : ∀ w : W, ∃ a : Fin (N + 1), w ∈ κ ⁻¹ᵁ wcSgD Ω N a := by
    intro w
    have hY : (⨆ j : Fin (N + 1), Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) (MvPolynomial.X j)) = ⊤ := by
      apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
      intro a ha
      have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
      have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
        rw [← MvPolynomial.decomposition.decompose'_apply]
        exact ha'
      rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.mp hm) h0
      obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨l, Set.mem_univ _, hl⟩
    have hx : κ w ∈ (⨆ j : Fin (N + 1), Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) (MvPolynomial.X j)) := by
      rw [hY]; trivial
    obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    exact ⟨j, hj⟩

  obtain ⟨m₀, hm₀⟩ := wc_esz_eventual_vanishing Ω N W w₀ κ
    (fun m => wc_esz_twisted_h1_finite Ω N W κ hκ m)
    (fun e he F hF => wc_esz_twisted_mul_injective Ω N n hn2 W r κ hκ hκr e he F hF)
    (fun M₀ => wc_esz_forms_independent Ω N n hn2 W r κ hκ hκr M₀)

  refine ⟨m₀ + 1, by omega, ?_⟩
  intro f hf
  have res : ∀ {V V' V'' : W.Opens} (h1 : V ≤ V') (h2 : V' ≤ V'') (t : Γ(W, V'')),
      (W.presheaf.map (homOfLE h1).op).hom ((W.presheaf.map (homOfLE h2).op).hom t) =
      (W.presheaf.map (homOfLE (h1.trans h2)).op).hom t := by
    intro V V' V'' h1 h2 t
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  choose c hc using fun a b => Ideal.mem_span_singleton'.mp (hf a b)

  have htrip : ∀ a b l : Fin (N + 1),
      (W.presheaf.map (homOfLE (inf_le_left.trans inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓
          κ ⁻¹ᵁ wcSgD Ω N b ⊓ κ ⁻¹ᵁ wcSgD Ω N l ≤ κ ⁻¹ᵁ wcSgD Ω N a)).op).hom
          ((κ.app (wcSgD Ω N a)).hom (wcLdpSec Ω N H a)) ^ (m₀ + 1) *
        (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ⊓
          κ ⁻¹ᵁ wcSgD Ω N l ≤ κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b)).op).hom (c a b) +
      (W.presheaf.map (homOfLE (inf_le_left.trans inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓
          κ ⁻¹ᵁ wcSgD Ω N b ⊓ κ ⁻¹ᵁ wcSgD Ω N l ≤ κ ⁻¹ᵁ wcSgD Ω N b)).op).hom
          ((κ.app (wcSgD Ω N b)).hom (wcLdpSec Ω N H b)) ^ (m₀ + 1) *
        (W.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
          κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ⊓ κ ⁻¹ᵁ wcSgD Ω N l ≤
            κ ⁻¹ᵁ wcSgD Ω N b ⊓ κ ⁻¹ᵁ wcSgD Ω N l)).op).hom (c b l) =
      (W.presheaf.map (homOfLE (inf_le_left.trans inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓
          κ ⁻¹ᵁ wcSgD Ω N b ⊓ κ ⁻¹ᵁ wcSgD Ω N l ≤ κ ⁻¹ᵁ wcSgD Ω N a)).op).hom
          ((κ.app (wcSgD Ω N a)).hom (wcLdpSec Ω N H a)) ^ (m₀ + 1) *
        (W.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
          κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ⊓ κ ⁻¹ᵁ wcSgD Ω N l ≤
            κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N l)).op).hom (c a l) := by
    intro a b l
    have e1 := congrArg (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓
      κ ⁻¹ᵁ wcSgD Ω N b ⊓ κ ⁻¹ᵁ wcSgD Ω N l ≤ κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b)).op).hom
      (hc a b)
    have e2 := congrArg (W.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right)
      inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ⊓ κ ⁻¹ᵁ wcSgD Ω N l ≤
        κ ⁻¹ᵁ wcSgD Ω N b ⊓ κ ⁻¹ᵁ wcSgD Ω N l)).op).hom (hc b l)
    have e3 := congrArg (W.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left)
      inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ⊓ κ ⁻¹ᵁ wcSgD Ω N l ≤
        κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N l)).op).hom (hc a l)
    simp only [map_mul, map_pow, map_sub, res] at e1 e2 e3
    linear_combination e1 + e2 - e3

  obtain ⟨d, hd⟩ := wc_esz_vk_of_vanishing Ω N W κ H (m₀ + 1) (by omega)
    (fun c' hc' => hm₀ (2 * (m₀ + 1)) (by omega) c' hc') c htrip
  have hcomp : TopCat.Presheaf.IsCompatible W.sheaf.obj (fun a => κ ⁻¹ᵁ wcSgD Ω N a)
      (fun a => f a - ((κ.app (wcSgD Ω N a)).hom (wcLdpSec Ω N H a)) ^ (m₀ + 1) * d a) := by
    intro i j
    have key : (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N i ⊓ κ ⁻¹ᵁ wcSgD Ω N j ≤
          κ ⁻¹ᵁ wcSgD Ω N i)).op).hom
          (f i - ((κ.app (wcSgD Ω N i)).hom (wcLdpSec Ω N H i)) ^ (m₀ + 1) * d i) =
        (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N i ⊓ κ ⁻¹ᵁ wcSgD Ω N j ≤
          κ ⁻¹ᵁ wcSgD Ω N j)).op).hom
          (f j - ((κ.app (wcSgD Ω N j)).hom (wcLdpSec Ω N H j)) ^ (m₀ + 1) * d j) := by
      simp only [map_sub, map_mul, map_pow]
      linear_combination hd i j - hc i j
    exact key
  obtain ⟨s, hs, -⟩ := TopCat.Sheaf.existsUnique_gluing' W.sheaf
    (fun a => κ ⁻¹ᵁ wcSgD Ω N a) ⊤ (fun a => homOfLE le_top)
    (by
      intro x _
      rw [TopologicalSpace.Opens.mem_iSup]
      exact hcov x) _ hcomp
  refine ⟨s, fun a => ?_⟩
  have hsa : (W.presheaf.map (homOfLE (le_top : κ ⁻¹ᵁ wcSgD Ω N a ≤ ⊤)).op).hom s =
      f a - ((κ.app (wcSgD Ω N a)).hom (wcLdpSec Ω N H a)) ^ (m₀ + 1) * d a := hs a
  rw [hsa]
  exact Ideal.mem_span_singleton'.mpr ⟨-d a, by ring⟩

theorem wc_ldp_quadric_section_connected (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (N n : ℕ)
    (hn2 : 2 ≤ n) (W : Scheme.{u}) (r : W ⟶ Spec (.of Ω)) [IrreducibleSpace W]
    [SmoothOfRelativeDimension n r] (κ : W ⟶ wcProjK Ω N) (hκ : IsClosedImmersion κ)
    (hκr : κ ≫ wcProjKStr Ω N = r) (H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 2) :
    _root_.IsConnected {w : W | wcLdpZero Ω N κ H w} :=
by
  classical

  have hdom : ∀ w : W, IsDomain (W.presheaf.stalk w) := fun w =>
    wcpa_smooth_stalk_isDomain Ω W r n w
  haveI : ∀ w : W, _root_.IsReduced (W.presheaf.stalk w) := fun w => by
    haveI := hdom w
    infer_instance
  haveI : IsReduced W := isReduced_of_isReduced_stalk W
  haveI : IsIntegral W := isIntegral_of_irreducibleSpace_of_isReduced W
  haveI : IsProper (wcProjKStr Ω N) := wc_pp_proper Ω N
  haveI := hκ
  haveI : UniversallyClosed r := by
    rw [← hκr]
    infer_instance
  have hfield : IsField Γ(W, ⊤) := isField_of_universallyClosed Ω r

  have hcov : ∀ w : W, ∃ a : Fin (N + 1), w ∈ κ ⁻¹ᵁ wcSgD Ω N a := by
    intro w
    have hY : (⨆ j : Fin (N + 1), Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) (MvPolynomial.X j)) = ⊤ := by
      apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
      intro a ha
      have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
      have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
        rw [← MvPolynomial.decomposition.decompose'_apply]
        exact ha'
      rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.mp hm) h0
      obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨l, Set.mem_univ _, hl⟩
    have hx : κ w ∈ (⨆ j : Fin (N + 1), Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) (MvPolynomial.X j)) := by
      rw [hY]; trivial
    obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    exact ⟨j, hj⟩
  refine ⟨wc_ldp_qsc_zero_nonempty Ω N n (by omega) W r κ hκ hκr H, ?_⟩
  rw [isPreconnected_closed_iff]
  intro t t' ht ht' hsub hne₁ hne₂
  obtain ⟨s₁, hs₁Z, hs₁t⟩ := hne₁
  obtain ⟨s₂, hs₂Z, hs₂t'⟩ := hne₂
  by_contra hne
  have hdisj : ∀ w : W, wcLdpZero Ω N κ H w → w ∈ t → w ∈ t' → False :=
    fun w hw h1 h2 => hne ⟨w, hw, h1, h2⟩

  obtain ⟨k, hk, hlift⟩ := wc_ldp_qsc_esz_lift Ω N n hn2 W r κ hκ hκr H
  obtain ⟨e, hecomp, he1, he2⟩ :=
    wc_ldp_qsc_clopen_idempotents Ω N W κ hκ H k hk t t' ht ht' hsub hdisj
  obtain ⟨g, hg⟩ := hlift e hecomp

  have key : ∀ (c : Fin (N + 1)) (w : W) (hw : w ∈ κ ⁻¹ᵁ wcSgD Ω N c), wcLdpZero Ω N κ H w →
      (W.presheaf.germ ⊤ w trivial).hom g - (W.presheaf.germ _ w hw).hom (e c) ∈
        IsLocalRing.maximalIdeal (W.presheaf.stalk w) := by
    intro c w hw hZ
    obtain ⟨x, hx⟩ := Ideal.mem_span_singleton'.mp (hg c)
    have h1 : (W.presheaf.germ _ w hw).hom
        ((W.presheaf.map (homOfLE (le_top : κ ⁻¹ᵁ wcSgD Ω N c ≤ ⊤)).op).hom g) =
        (W.presheaf.germ ⊤ w trivial).hom g :=
      TopCat.Presheaf.germ_res_apply W.presheaf (homOfLE (le_top : κ ⁻¹ᵁ wcSgD Ω N c ≤ ⊤))
        w hw g
    rw [← h1, ← map_sub, ← hx, map_mul, map_pow]
    exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ (hZ c hw) k (by omega))
  obtain ⟨a, ha⟩ := hcov s₁
  obtain ⟨b, hb⟩ := hcov s₂
  have hs1 : (W.presheaf.germ ⊤ s₁ trivial).hom g - 1 ∈
      IsLocalRing.maximalIdeal (W.presheaf.stalk s₁) := by
    have := Ideal.add_mem _ (key a s₁ ha hs₁Z) (he1 a s₁ ha hs₁Z hs₁t)
    rwa [sub_add_sub_cancel] at this
  have hs2 : (W.presheaf.germ ⊤ s₂ trivial).hom g ∈
      IsLocalRing.maximalIdeal (W.presheaf.stalk s₂) := by
    have := Ideal.add_mem _ (key b s₂ hb hs₂Z) (he2 b s₂ hb hs₂Z hs₂t')
    rwa [sub_add_cancel] at this
  by_cases hg0 : g = 0
  · rw [hg0, map_zero, zero_sub, Ideal.neg_mem_iff] at hs1
    exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top
      (Ideal.eq_top_of_isUnit_mem _ hs1 isUnit_one)
  · obtain ⟨g', hg'⟩ := hfield.mul_inv_cancel hg0
    have hu : IsUnit ((W.presheaf.germ ⊤ s₂ trivial).hom g) :=
      IsUnit.of_mul_eq_one ((W.presheaf.germ ⊤ s₂ trivial).hom g') (by
        rw [← map_mul, hg', map_one])
    exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top
      (Ideal.eq_top_of_isUnit_mem _ hs2 hu)

theorem wc_ldp_gi_of_connected_fibres (E : Type u) [Field E] (Yt : Over (Spec (.of E))) (n : ℕ)
    [IsProper Yt.hom] [SmoothOfRelativeDimension n Yt.hom]
    (f : Yt.left ⟶ (wcP1Over E).left) (hf : f ≫ (wcP1Over E).hom = Yt.hom)
    (hconn : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ (wcP1Over E).left),
      ConnectedSpace ↥(Limits.pullback f t)) :
    GeometricallyIrreducible Yt.hom :=
by
  classical

  have s5 : ∀ {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y] [ConnectedSpace Y]
      (g : X → Y), Continuous g → IsClosedMap g → (∀ y : Y, IsConnected (g ⁻¹' {y})) →
      ConnectedSpace X := by
    intro X Y _ _ _ g hc hcl hfib
    have hsurj : Function.Surjective g := fun y => by
      obtain ⟨x, hx⟩ := (hfib y).nonempty
      exact ⟨x, hx⟩
    have hq := hcl.isQuotientMap hc hsurj
    have h := hq.isCoinducing.isConnected_preimage_of_isClosed hfib isClosed_univ isConnected_univ
    rw [Set.preimage_univ] at h
    exact connectedSpace_iff_univ.mpr h

  have s2 : ∀ (K : Type u) [Field K] (m : ℕ), IrreducibleSpace ↥(wcProjK K m) := by
    intro K _ m
    have h1 : (⊥ : HomogeneousIdeal
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)).toIdeal.IsPrime := by
      rw [HomogeneousIdeal.toIdeal_bot]; exact Ideal.isPrime_bot
    have h2 : ¬ HomogeneousIdeal.irrelevant
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) ≤ ⊥ := by
      intro h
      have hX : (MvPolynomial.X 0 : MvPolynomial (Fin (m + 1)) K) ∈
          HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) := by
        rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
        exact DirectSum.decompose_of_mem_ne _
          ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K 0))
          one_ne_zero
      have h3 : (MvPolynomial.X 0 : MvPolynomial (Fin (m + 1)) K) ∈
          (⊥ : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)).toIdeal :=
        h hX
      rw [HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at h3
      exact MvPolynomial.X_ne_zero _ h3
    let η : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) := ⟨⊥, h1, h2⟩
    have hcl : closure ({η} : Set (ProjectiveSpectrum
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K))) = Set.univ :=
      Set.eq_univ_of_forall fun x => (ProjectiveSpectrum.le_iff_mem_closure _ η x).mp
        (show (⊥ : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)) ≤
          x.asHomogeneousIdeal from bot_le)
    show IrreducibleSpace (ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K))
    rw [irreducibleSpace_def, Set.top_eq_univ, ← hcl]
    exact isIrreducible_singleton.closure

  have s3 : ∀ (K : Type u) [Field K] (y : Spec (.of K) ⟶ Spec (.of E)),
      ConnectedSpace ↥(Limits.pullback (wcP1Over E).hom y) := by
    intro K _ y
    letI : Algebra E K := (Spec.preimage y).hom.toAlgebra
    have hy : Spec.map (CommRingCat.ofHom (algebraMap E K)) = y :=
      (congrArg Spec.map (CommRingCat.ofHom_hom (Spec.preimage y))).trans (Spec.map_preimage y)
    rw [← hy]
    obtain ⟨e, he, -⟩ := wcpa_proj_base_change E K 1
    haveI := he
    haveI := s2 K 1
    haveI : IrreducibleSpace ↥(Limits.pullback (wcP1Over E).hom
        (Spec.map (CommRingCat.ofHom (algebraMap E K)))) :=
      Function.Surjective.irreducibleSpace (Scheme.Hom.homeomorph e).symm.continuous
        (Scheme.Hom.homeomorph e).symm.surjective
    exact connectedSpace_iff_univ.mpr (IrreducibleSpace.isIrreducible_univ _).isConnected

  constructor
  intro K _ y Z fst snd hZ
  haveI : SmoothOfRelativeDimension n snd :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension n) hZ inferInstance
  haveI : IsProper snd := MorphismProperty.of_isPullback (P := @IsProper) hZ inferInstance
  have hdom := wcpa_smooth_stalk_isDomain K Z snd n
  haveI := SmoothOfRelativeDimension.smooth n snd
  haveI := LocallyOfFiniteType.isLocallyNoetherian snd
  have w : (fst ≫ f) ≫ (wcP1Over E).hom = snd ≫ y := by
    rw [Category.assoc, hf]; exact hZ.w
  let g : Z ⟶ Limits.pullback (wcP1Over E).hom y := Limits.pullback.lift (fst ≫ f) snd w
  have hg1 : g ≫ Limits.pullback.fst (wcP1Over E).hom y = fst ≫ f :=
    Limits.pullback.lift_fst _ _ _
  have hg2 : g ≫ Limits.pullback.snd (wcP1Over E).hom y = snd := Limits.pullback.lift_snd _ _ _
  haveI : IsProper (g ≫ Limits.pullback.snd (wcP1Over E).hom y) := by rw [hg2]; infer_instance
  haveI hsep0 : IsSeparated (wcP1Over E).hom := by
    show IsSeparated (wcProjKStr E 1); infer_instance
  haveI : IsSeparated (Limits.pullback.snd (wcP1Over E).hom y) :=
    MorphismProperty.of_isPullback (P := @IsSeparated) (IsPullback.of_hasPullback _ _) hsep0
  haveI : IsProper g := IsProper.of_comp g (Limits.pullback.snd (wcP1Over E).hom y)
  have hcl := g.isClosedMap
  haveI := s3 K y

  have hL : IsPullback fst g f (Limits.pullback.fst (wcP1Over E).hom y) := by
    refine IsPullback.of_bot (h₃₁ := y) (v₂₁ := Limits.pullback.snd (wcP1Over E).hom y)
      (v₂₂ := (wcP1Over E).hom) ?_ hg1.symm (IsPullback.of_hasPullback _ _)
    rw [hg2, hf]; exact hZ
  have hfib : ∀ p, _root_.IsConnected (g ⁻¹' {p}) := by
    intro p
    let t' : Spec (.of (AlgebraicClosure ((Limits.pullback (wcP1Over E).hom y).residueField p))) ⟶
        Limits.pullback (wcP1Over E).hom y :=
      Spec.map (CommRingCat.ofHom (algebraMap ((Limits.pullback (wcP1Over E).hom y).residueField p)
        (AlgebraicClosure ((Limits.pullback (wcP1Over E).hom y).residueField p)))) ≫
        (Limits.pullback (wcP1Over E).hom y).fromSpecResidueField p
    have ht' : ∀ a, t' a = p := fun a => by
      simp only [t', Scheme.Hom.comp_apply]
      exact Scheme.fromSpecResidueField_apply p _
    have hrange : Set.range t' = {p} := by
      ext s
      constructor
      · rintro ⟨a, rfl⟩; exact ht' a
      · rintro rfl
        exact ⟨IsLocalRing.closedPoint _, ht' _⟩
    have hpb := IsPullback.paste_horiz (IsPullback.of_hasPullback g t') hL
    let θ := hpb.isoIsPullback _ _ (IsPullback.of_hasPullback f
      (t' ≫ Limits.pullback.fst (wcP1Over E).hom y))
    haveI := hconn (AlgebraicClosure ((Limits.pullback (wcP1Over E).hom y).residueField p))
      (t' ≫ Limits.pullback.fst (wcP1Over E).hom y)
    haveI : ConnectedSpace ↥(Limits.pullback g t') :=
      (Scheme.homeoOfIso θ.symm).surjective.connectedSpace (Scheme.homeoOfIso θ.symm).continuous
    have hc := isConnected_range (Limits.pullback.fst g t').continuous
    rwa [Scheme.Pullback.range_fst, hrange] at hc
  haveI : ConnectedSpace Z := s5 g g.continuous hcl hfib
  exact wcpa_irreducible_of_connected_domain_stalks Z hdom

theorem wc_ldnm_glue_ctx (F' : Type u) [Finite F'] [Field F']
    (Y : Over (Spec (.of F'))) [GeometricallyIrreducible Y.hom] [IsProper Y.hom] (n : ℕ)
    [SmoothOfRelativeDimension n Y.hom] (hn : Even n) (hn2 : 2 ≤ n)
    (N : ℕ) (j : Y.left ⟶ wcProjK F' N) (hj : IsClosedImmersion j)
    (hjY : j ≫ wcProjKStr F' N = Y.hom) :
    ∃ (E : Type u) (_ : Field E) (_ : Finite E) (_ : Algebra F' E) (P : wcPreDatum F' E Y n)
      (X : Over (Spec (.of E))) (_ : IsProper X.hom) (_ : GeometricallyIrreducible X.hom)
      (_ : SmoothOfRelativeDimension n X.hom) (ι : X.left ⟶ wcProjK E N)
      (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
      (y : Fin P.m → (Spec (.of E) ⟶ X.left)) (c : Fin P.m → Fin 2 → E)
      (g : P.Yt.left ⟶ Limits.pullback X.hom (wcProjKStr E 1)),
      IsClosedImmersion ι ∧ ι ≫ wcProjKStr E N = X.hom ∧
      wcLdpGoodPencil E N n X ι G₀ G₁ P.m y c ∧
      wcLdnmLocEq (Limits.pullback X.hom (wcProjKStr E 1)) (Fin (N + 1) × Fin 2)
        (wcLdpW E N X ι) (wcLdpH E N X ι G₀ G₁) P.Yt.left g ∧
      g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom = P.Yt.hom ∧
      P.f = g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1) ∧
      ∀ i, P.xs i ≫ g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) = y i :=
by
  classical


  have hinc : ∀ (E : Type u) [Field E] (N : ℕ) (X : Over (Spec (.of E)))
      [IsProper X.hom] (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι)
      (hιX : ι ≫ wcProjKStr E N = X.hom)
      (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2),
      ∃ (Yt : Over (Spec (.of E))) (g : Yt.left ⟶ Limits.pullback X.hom (wcProjKStr E 1)),
        wcLdnmLocEq (Limits.pullback X.hom (wcProjKStr E 1)) (Fin (N + 1) × Fin 2)
          (wcLdpW E N X ι) (wcLdpH E N X ι G₀ G₁) Yt.left g ∧
        IsClosedImmersion g ∧
        g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom = Yt.hom ∧
        IsProper Yt.hom ∧
        Surjective (g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ∧
        (∃ V : X.left.Opens, (∀ x, x ∈ V ↔ ¬ wcLdpOnAxis E N ι G₀ G₁ x) ∧
          IsIso ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ∣_ V)) ∧
        wcLdpIncLocal E N X ι G₀ G₁ Yt g ∧
        (∀ y : Spec (.of E) ⟶ X.left,
          ¬ wcLdpOnAxis E N ι G₀ G₁ (y (IsLocalRing.closedPoint E)) →
          ∃ z : Spec (.of E) ⟶ Yt.left, z ≫ g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) = y) ∧
        (∀ (w w' : Yt.left) (c c' : Fin 2 → E), c ≠ 0 → c' ≠ 0 →
          ¬ wcLdpOnAxis E N ι G₀ G₁ ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) w) →
          ¬ wcLdpOnAxis E N ι G₀ G₁ ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) w') →
          wcLdpZero E N ι (c 1 • G₀ - c 0 • G₁)
            ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) w) →
          wcLdpZero E N ι (c' 1 • G₀ - c' 0 • G₁)
            ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) w') →
          (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) w =
            (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) w' →
          c 0 * c' 1 - c 1 * c' 0 = 0) ∧
        (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ wcProjK E 1),
          ∃ (W : Scheme.{u}) (q : W ⟶ X.left) (r : W ⟶ Spec (.of Ω)) (κ : W ⟶ wcProjK Ω N)
            (H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 2),
            IsPullback q r X.hom (t ≫ wcProjKStr E 1) ∧ IsClosedImmersion κ ∧
            κ ≫ wcProjKStr Ω N = r ∧
            Nonempty (↥(Limits.pullback (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) t) ≃ₜ
              ↥{w : W | wcLdpZero Ω N κ H w})) ∧
        ∃ (M : ℕ) (jt : Yt.left ⟶ wcProjK E M), IsClosedImmersion jt ∧
          jt ≫ wcProjKStr E M = Yt.hom := by
    intro E _ N X _ ι hι hιX G₀ G₁
    have appLE_germ : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (U : B.Opens) (V : A.Opens)
        (e : V ≤ f ⁻¹ᵁ U) (p : A) (hp : p ∈ V) (s : Γ(B, U)),
        (A.presheaf.germ V p hp).hom ((f.appLE U V e).hom s) =
          (f.stalkMap p).hom ((B.presheaf.germ U (f p) (show f p ∈ U from e hp)).hom s) := by
      intro A B f U V e p hp s
      simp [Scheme.Hom.appLE]
    obtain ⟨hWaff, hWcov, hWu⟩ := wc_ldpi_chart_data E N X ι hι G₀ G₁
    obtain ⟨Z, g, hgc, hgsec, hgrange, hgstalk⟩ :=
      wc_ldpi_principal_subscheme (Limits.pullback X.hom (wcProjKStr E 1)) (Fin (N + 1) × Fin 2)
        (wcLdpW E N X ι) hWaff hWcov (wcLdpH E N X ι G₀ G₁) hWu
    haveI := hgc
    haveI : IsProper (wcProjKStr E 1) := wc_pp_proper E 1
    let Yt : Over (Spec (.of E)) :=
      Over.mk (g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom)
    have hgerm : ∀ (p : ↥(Limits.pullback X.hom (wcProjKStr E 1))) (i : Fin (N + 1) × Fin 2)
        (hp : p ∈ wcLdpW E N X ι i),
        ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.germ (wcLdpW E N X ι i) p hp).hom
            (wcLdpH E N X ι G₀ G₁ i) =
          ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap p).hom
              (wcLdpGerm E N ι (![G₀, G₁] (i.2 + 1)) i.1
                (Limits.pullback.fst X.hom (wcProjKStr E 1) p) hp.1) -
            ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap p).hom
              (((wcProjK E 1).presheaf.germ (wcSgD E 1 i.2)
                (Limits.pullback.snd X.hom (wcProjKStr E 1) p) hp.2).hom
                (wcSgE E 1 i.2 (i.2 + 1))) *
            ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap p).hom
