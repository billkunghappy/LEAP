    exact @isAffine_of_isAffineHom _ _ (Limits.pullback.fst (E.obj j).hom k) hA (haffE j)
  have htrDS : ∀ {j j' : I} (t : j ⟶ j'), IsAffineHom (DS.map t) := by
    intro j j' t
