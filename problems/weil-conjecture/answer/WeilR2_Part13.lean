      Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)),
      ∀ c : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b),
        wcEszCoc κ m c → ∃ s : Fin k → K, wcEszCob κ m (fun a b => c a b -
          ∑ l, wcEszScal κ (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b) (s l) * C l a b) := by
    obtain ⟨-, k, C0, hC0⟩ := hH
    have surjAB : ∀ (a b : Fin (N + 1)) (y : Γ(L, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)),
        ∃ t : Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b),
          t • (L.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
            κ ⁻¹ᵁ wcSgD K N a)).op).hom (ε a) = y :=
      fun a b y => (hbij a _ inf_le_left).2 y
    choose Cf hCf using surjAB
    have hwrep : ∀ (a : Fin (N + 1)) (x : Γ(L, κ ⁻¹ᵁ wcSgD K N a)),
        ∃ t : Γ(W, κ ⁻¹ᵁ wcSgD K N a), t • ε a = x := by
      intro a x
      obtain ⟨t, ht⟩ := (hbij a _ le_rfl).2 x
      exact ⟨t, (congrArg (fun y => t • y) (resLid le_rfl (ε a))).symm.trans ht⟩
    choose d' hd' using hwrep
    refine ⟨k, fun l a b => Cf a b (C0 l (a, b)), fun c hc => ?_⟩
    obtain ⟨bb, w, hzw⟩ := hC0 (fun p => c p.1 p.2 • (L.presheaf.map (homOfLE (inf_le_left :
      κ ⁻¹ᵁ wcSgD K N p.1 ⊓ κ ⁻¹ᵁ wcSgD K N p.2 ≤ κ ⁻¹ᵁ wcSgD K N p.1)).op).hom (ε p.1)) (by
      intro a b l
      show (L.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ⊓
          κ ⁻¹ᵁ wcSgD K N l ≤ κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)).op).hom
          (c a b • (L.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓
            κ ⁻¹ᵁ wcSgD K N b ≤ κ ⁻¹ᵁ wcSgD K N a)).op).hom (ε a)) +
        (L.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
          κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ⊓ κ ⁻¹ᵁ wcSgD K N l ≤
            κ ⁻¹ᵁ wcSgD K N b ⊓ κ ⁻¹ᵁ wcSgD K N l)).op).hom
          (c b l • (L.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N b ⊓
            κ ⁻¹ᵁ wcSgD K N l ≤ κ ⁻¹ᵁ wcSgD K N b)).op).hom (ε b)) =
        (L.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
          κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ⊓ κ ⁻¹ᵁ wcSgD K N l ≤
            κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N l)).op).hom
          (c a l • (L.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓
            κ ⁻¹ᵁ wcSgD K N l ≤ κ ⁻¹ᵁ wcSgD K N a)).op).hom (ε a))
      rw [smulL, smulL, smulL, resL, resL, resL,
        F2 a b (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ⊓ κ ⁻¹ᵁ wcSgD K N l) inf_le_left
          (inf_le_left.trans inf_le_left)
          ((le_inf (inf_le_left.trans inf_le_right) inf_le_right :
            κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ⊓ κ ⁻¹ᵁ wcSgD K N l ≤
              κ ⁻¹ᵁ wcSgD K N b ⊓ κ ⁻¹ᵁ wcSgD K N l).trans inf_le_left),
        smul_smul, ← add_smul]
      refine congrArg (fun r => r • _) ?_
      rw [← hc a b l]
      ring)
    refine ⟨bb, fun a => -d' a (w a), fun a b => ?_⟩
    have hz : c a b • (L.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓
          κ ⁻¹ᵁ wcSgD K N b ≤ κ ⁻¹ᵁ wcSgD K N a)).op).hom (ε a) =
        ∑ l, wcEszScal κ (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b) (bb l) •
          (C0 l (a, b) : Γ(L, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)) +
        ((L.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
            κ ⁻¹ᵁ wcSgD K N b)).op).hom (w b) -
          (L.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
            κ ⁻¹ᵁ wcSgD K N a)).op).hom (w a)) :=
      congrFun hzw (a, b)
    have hsum : (∑ l, wcEszScal κ (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b) (bb l) •
          (C0 l (a, b) : Γ(L, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b))) =
        ∑ l, (wcEszScal κ (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b) (bb l) *
          Cf a b (C0 l (a, b))) • (L.presheaf.map (homOfLE (inf_le_left :
            κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤ κ ⁻¹ᵁ wcSgD K N a)).op).hom (ε a) :=
      Finset.sum_congr rfl (fun l _ => by rw [mul_smul, hCf a b])
    rw [hsum, ← hd' b (w b), ← hd' a (w a), smulL, smulL, F1 a b, smul_smul, ← Finset.sum_smul,
      ← sub_smul, ← add_smul] at hz
    have hc' := (hbij a _ (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
      κ ⁻¹ᵁ wcSgD K N a)).1 hz
    show c a b - _ = _
    beta_reduce
    rw [hc']
    simp only [map_neg]
    ring
  obtain ⟨k, C, hspan⟩ := hspan5

  let φ : K →+* (∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)) :=
    Pi.ringHom (fun a => Pi.ringHom (fun b =>
      wcEszScal κ (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)))
  letI : Module K (∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)) :=
    Module.compHom _ φ
  let Zs : Submodule K (∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)) :=
    { carrier := {c | wcEszCoc κ m c}
      add_mem' := fun {c c'} hc hc' => hZadd c c' hc hc'
      zero_mem' := hZ0
      smul_mem' := fun t c hc => hZsmul t c hc }
  let Bs : Submodule K (∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)) :=
    { carrier := {c | wcEszCob κ m c}
      add_mem' := fun {c c'} hc hc' => hBadd c c' hc hc'
      zero_mem' := hB0
      smul_mem' := fun t c hc => hBsmul t c hc }
  have hexp : ∀ (q : ℕ)
      (z : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)) (s : Fin q → K)
      (D : Fin q → ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)),
      (z - ∑ l, s l • D l) = fun a b => z a b -
        ∑ l, wcEszScal κ (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b) (s l) * D l a b := by
    intro q z s D
    funext a b
    simp only [Pi.sub_apply, Finset.sum_apply]
    rfl
  obtain ⟨p, v, hv, hfin⟩ := s6 _ Zs Bs k C (by
    intro z hz
    obtain ⟨s, hs⟩ := hspan z hz
    refine ⟨s, ?_⟩
    show wcEszCob κ m (z - ∑ l, s l • C l)
    rw [hexp]
    exact hs)
  refine ⟨p, v, fun i => hv i, fun c hc => ?_⟩
  obtain ⟨t, ht⟩ := hfin c hc
  refine ⟨t, ?_⟩
  have ht' : wcEszCob κ m (c - ∑ i, t i • v i) := ht
  rw [hexp] at ht'
  exact ht'

theorem wc_esz_mi_chart_depth (Ω : Type u) [Field Ω] (n : ℕ) (hn : 2 ≤ n) (W : Scheme.{u})
    (r : W ⟶ Spec (.of Ω)) [SmoothOfRelativeDimension n r] [AlgebraicGeometry.IsIntegral W]
    (U : W.Opens) (hU : IsAffineOpen U) (f : Γ(W, U)) (hf : f ≠ 0) (M : Ideal Γ(W, U))
    (hM : M.IsMaximal) (y : Γ(W, U)) (hy : ∀ t ∈ M, t * y ∈ Ideal.span {f}) :
    y ∈ Ideal.span {f} :=
by
  classical

  have local_depth : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R] [IsNoetherianRing R]
      [IsIntegrallyClosed R], (2 : WithBot ℕ∞) ≤ ringKrullDim R → ∀ (f : R), f ≠ 0 → ∀ (y : R),
      (∀ t ∈ IsLocalRing.maximalIdeal R, t * y ∈ Ideal.span {f}) → y ∈ Ideal.span {f} := by
    intro R _ _ _ _ _ hdim f hf y hy
    choose q hq using fun t (ht : t ∈ IsLocalRing.maximalIdeal R) =>
      Ideal.mem_span_singleton'.mp (hy t ht)
    have hne : IsLocalRing.maximalIdeal R ≠ ⊥ := by
      intro h
      have hfield : IsField R := IsLocalRing.isField_iff_maximalIdeal_eq.mpr h
      have h0 : ringKrullDim R = 0 := ringKrullDim_eq_zero_of_isField hfield
      rw [h0] at hdim
      exact absurd hdim (by decide)
    by_cases hall : ∀ t (ht : t ∈ IsLocalRing.maximalIdeal R), q t ht ∈ IsLocalRing.maximalIdeal R
    · have hφ : Function.Injective (algebraMap R (FractionRing R)) := IsFractionRing.injective R _
      have hφf : algebraMap R (FractionRing R) f ≠ 0 := fun h =>
        hf (hφ (h.trans (map_zero _).symm))
      set z : FractionRing R := algebraMap R (FractionRing R) y / algebraMap R (FractionRing R) f
        with hz
      have hA1 : ∀ t (ht : t ∈ IsLocalRing.maximalIdeal R),
          z * algebraMap R (FractionRing R) t = algebraMap R (FractionRing R) (q t ht) := by
        intro t ht
        rw [hz, div_mul_eq_mul_div, div_eq_iff hφf, ← map_mul, ← map_mul, hq t ht, mul_comm]
      let N : Submodule R (FractionRing R) :=
        Submodule.map (Algebra.linearMap R (FractionRing R)) (IsLocalRing.maximalIdeal R)
      have hNfg : N.FG := (IsNoetherian.noetherian (IsLocalRing.maximalIdeal R)).map _
      have hN0 : N ≠ ⊥ := by
        obtain ⟨t, ht, ht0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
        intro hN
        have : algebraMap R (FractionRing R) t ∈ N := Submodule.mem_map_of_mem ht
        rw [hN, Submodule.mem_bot] at this
        exact ht0 (hφ (this.trans (map_zero _).symm))
      have hA3 : ∀ m ∈ N, z • m ∈ N := by
        intro m hm
        obtain ⟨t, ht, rfl⟩ := Submodule.mem_map.mp hm
        rw [smul_eq_mul]
        change z * algebraMap R (FractionRing R) t ∈ N
        rw [hA1 t ht]
        exact Submodule.mem_map_of_mem (hall t ht)
      have hint : IsIntegral R z := isIntegral_of_smul_mem_submodule N hN0 hNfg z hA3
      obtain ⟨w, hw⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
      refine Ideal.mem_span_singleton'.mpr ⟨w, hφ ?_⟩
      rw [map_mul, hw, hz, div_mul_cancel₀ _ hφf]
    · push_neg at hall
      obtain ⟨t₀, h₀, hu⟩ := hall
      have hunit : IsUnit (q t₀ h₀) := by
        by_contra h
        exact hu ((IsLocalRing.mem_maximalIdeal _).mpr h)
      by_cases hy0 : y = 0
      · rw [hy0]; exact Ideal.zero_mem _
      exfalso
      have hle : IsLocalRing.maximalIdeal R ≤ Ideal.span {t₀} := by
        intro t ht
        have key : (q t₀ h₀ * t - q t ht * t₀) * y = 0 := by
          linear_combination (-(q t₀ h₀)) * hq t ht + q t ht * hq t₀ h₀
        have h1 : q t₀ h₀ * t = q t ht * t₀ :=
          sub_eq_zero.mp ((mul_eq_zero.mp key).resolve_right hy0)
        refine Ideal.mem_span_singleton'.mpr ⟨(↑hunit.unit⁻¹ : R) * q t ht, ?_⟩
        rw [mul_assoc, ← h1, ← mul_assoc, hunit.val_inv_mul, one_mul]
      have heq : IsLocalRing.maximalIdeal R = Ideal.span {t₀} :=
        le_antisymm hle ((Ideal.span_singleton_le_iff_mem _).mpr h₀)
      have hfr : (IsLocalRing.maximalIdeal R).spanFinrank ≤ 1 := by
        rw [heq]
        have := Submodule.spanFinrank_span_le_ncard_of_finite (R := R) (Set.finite_singleton t₀)
        rwa [Set.ncard_singleton] at this
      have h2 := ringKrullDim_le_spanFinrank_maximalIdeal R
      have h3 : (2 : WithBot ℕ∞) ≤ ((IsLocalRing.maximalIdeal R).spanFinrank : WithBot ℕ∞) :=
        hdim.trans h2
      have h4 : 2 ≤ (IsLocalRing.maximalIdeal R).spanFinrank := by exact_mod_cast h3
      omega

  have descend : ∀ (B : Type u) [CommRing B] (M : Ideal B) [M.IsMaximal] (R : Type u) [CommRing R]
      [IsLocalRing R] [Algebra B R] [IsLocalization.AtPrime R M] (f y : B),
      (∀ y' : R, (∀ t ∈ IsLocalRing.maximalIdeal R, t * y' ∈ Ideal.span {algebraMap B R f}) →
        y' ∈ Ideal.span {algebraMap B R f}) →
      (∀ t ∈ M, t * y ∈ Ideal.span {f}) → y ∈ Ideal.span {f} := by
    intro B _ M hMm R _ _ _ _ f y H hy
    have h1 : algebraMap B R y ∈ Ideal.span {algebraMap B R f} := by
      apply H
      intro t' ht'
      obtain ⟨⟨t, s⟩, rfl⟩ := IsLocalization.mk'_surjective M.primeCompl t'
      change IsLocalization.mk' R t s ∈ IsLocalRing.maximalIdeal R at ht'
      have htM : t ∈ M := (IsLocalization.AtPrime.mk'_mem_maximal_iff R M t s).mp ht'
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp (hy t htM)
      refine Ideal.mem_span_singleton'.mpr ⟨algebraMap B R a * IsLocalization.mk' R (1 : B) s, ?_⟩
      change _ = IsLocalization.mk' R t s * algebraMap B R y
      rw [IsLocalization.mk'_eq_mul_mk'_one t s]
      calc algebraMap B R a * IsLocalization.mk' R (1 : B) s * algebraMap B R f
          = algebraMap B R (a * f) * IsLocalization.mk' R (1 : B) s := by rw [map_mul]; ring
        _ = _ := by rw [ha, map_mul]; ring
    obtain ⟨z, hz⟩ := Ideal.mem_span_singleton'.mp h1
    obtain ⟨⟨w, s₀⟩, rfl⟩ := IsLocalization.mk'_surjective M.primeCompl z
    change IsLocalization.mk' R w s₀ * algebraMap B R f = algebraMap B R y at hz
    have h2 : algebraMap B R (w * f) = algebraMap B R (y * s₀) := by
      have : IsLocalization.mk' R w s₀ * algebraMap B R f * algebraMap B R s₀ =
          algebraMap B R y * algebraMap B R s₀ := by rw [hz]
      rw [map_mul, map_mul, ← this, mul_right_comm, IsLocalization.mk'_spec]
    obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists M.primeCompl R).mp h2
    have hu : (c : B) * s₀ ∉ M := by
      intro h
      rcases hMm.isPrime.mem_or_mem h with h | h
      · exact c.2 h
      · exact s₀.2 h
    obtain ⟨a, i, hi, hai⟩ := Ideal.IsMaximal.exists_inv hMm hu
    have hyeq : y = (a * c * w) * f + i * y := by
      linear_combination (-y) * hai - a * hc
    rw [hyeq]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self f)) (hy i hi)

  haveI : Smooth r := SmoothOfRelativeDimension.smooth n r
  haveI : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian r
  haveI := hM
  set p : PrimeSpectrum Γ(W, U) := ⟨M, hM.isPrime⟩ with hp
  have hxU : hU.fromSpec p ∈ U := by
    show hU.fromSpec p ∈ (U : Set W)
    rw [← hU.range_fromSpec]; exact Set.mem_range_self p
  letI : Algebra Γ(W, U) (W.presheaf.stalk (hU.fromSpec p)) :=
    TopCat.Presheaf.algebra_section_stalk W.presheaf ⟨hU.fromSpec p, hxU⟩
  haveI hloc : IsLocalization.AtPrime (W.presheaf.stalk (hU.fromSpec p)) M :=
    hU.isLocalization_stalk' p hxU

  have hdimZ : ringKrullDim ((Spec Γ(W, U)).presheaf.stalk p) = ((0 + n : ℕ) : WithBot ℕ∞) := by
    haveI := hU.isOpenImmersion_fromSpec
    haveI := smoothOfRelativeDimension_comp 0 n hU.fromSpec r
    exact wc_lfi_smooth_stalk_dim Ω (Spec Γ(W, U)) (hU.fromSpec ≫ r) (0 + n) p
      ((PrimeSpectrum.isClosed_singleton_iff_isMaximal p).mpr hM)
  have hdim : ringKrullDim (W.presheaf.stalk (hU.fromSpec p)) = (n : WithBot ℕ∞) := by
    haveI := hU.isOpenImmersion_fromSpec
    haveI hiso : IsIso (hU.fromSpec.stalkMap p) :=
      AlgebraicGeometry.IsOpenImmersion.instIsIsoCommRingCatStalkMap _ _
    rw [ringKrullDim_eq_of_ringEquiv
      (asIso (hU.fromSpec.stalkMap p)).commRingCatIsoToRingEquiv, hdimZ, Nat.zero_add]
  obtain ⟨hdom, hic⟩ := wc_fntame_smooth_stalk_normal Ω W r (hU.fromSpec p)
  haveI := hdom
  haveI := hic
  haveI : IsNoetherianRing Γ(W, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  haveI : IsNoetherianRing (W.presheaf.stalk (hU.fromSpec p)) :=
    IsLocalization.isNoetherianRing M.primeCompl _ inferInstance
  haveI : Nonempty U := ⟨⟨_, hxU⟩⟩
  have hinj : Function.Injective (algebraMap Γ(W, U) (W.presheaf.stalk (hU.fromSpec p))) :=
    IsLocalization.injective (M := M.primeCompl) _ (Ideal.primeCompl_le_nonZeroDivisors M)
  have hf' : algebraMap Γ(W, U) (W.presheaf.stalk (hU.fromSpec p)) f ≠ 0 := fun h =>
    hf (hinj (h.trans (map_zero _).symm))
  have h2 : (2 : WithBot ℕ∞) ≤ ringKrullDim (W.presheaf.stalk (hU.fromSpec p)) := by
    rw [hdim]; exact_mod_cast hn
  exact descend Γ(W, U) M (W.presheaf.stalk (hU.fromSpec p)) f y
    (fun y' hy' => local_depth _ h2 _ hf' y' hy') hy

theorem wc_esz_mi_h0D_finite (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (N n : ℕ)
    (hn2 : 2 ≤ n) (W : Scheme.{u}) (r : W ⟶ Spec (.of Ω)) [IrreducibleSpace W]
    [SmoothOfRelativeDimension n r] (κ : W ⟶ wcProjK Ω N) (hκ : IsClosedImmersion κ)
    (hκr : κ ≫ wcProjKStr Ω N = r) (e : ℕ) (he : 1 ≤ e)
    (F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω e) (hF : ¬ wcEszVanish κ e F) :
    ∃ (q : ℕ) (v : Fin q → ∀ a : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD Ω N a)),
      ∀ g : ∀ a : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD Ω N a),
        (∀ a b : Fin (N + 1),
          (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
              κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (g a) -
            (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
              κ ⁻¹ᵁ wcSgD Ω N b)).op).hom (g b) ∈
          Ideal.span {(W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓
              κ ⁻¹ᵁ wcSgD Ω N b ≤ κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (wcEszDh κ e F a)}) →
        ∃ t : Fin q → Ω, ∀ a : Fin (N + 1),
          g a - ∑ i, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (t i) * v i a ∈
            Ideal.span {wcEszDh κ e F a} :=
by
  classical

  have hdom : ∀ w : W, IsDomain (W.presheaf.stalk w) := fun w =>
    wcpa_smooth_stalk_isDomain Ω W r n w
  haveI : ∀ w : W, _root_.IsReduced (W.presheaf.stalk w) := fun w => by
    haveI := hdom w
    infer_instance
  haveI : IsReduced W := isReduced_of_isReduced_stalk W
  haveI : IsIntegral W := isIntegral_of_irreducibleSpace_of_isReduced W
  haveI := hκ

  have hcov : ∀ w : W, ∃ a : Fin (N + 1), w ∈ κ ⁻¹ᵁ wcSgD Ω N a := by
    intro w
    have hY : (⨆ j : Fin (N + 1), Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) (MvPolynomial.X j)) = ⊤ := by
      apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
      intro a ha
      have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
      have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
        rw [← MvPolynomial.decomposition.decompose'_apply]
        exact ha'
      rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.mp hm) h0
      obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨l, Set.mem_univ _, hl⟩
    have hx : κ w ∈ (⨆ j : Fin (N + 1), Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) (MvPolynomial.X j)) := by
      rw [hY]; trivial
    obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    exact ⟨j, hj⟩

  have res : ∀ {V V' V'' : W.Opens} (h1 : V ≤ V') (h2 : V' ≤ V'') (t : Γ(W, V'')),
      (W.presheaf.map (homOfLE h1).op).hom ((W.presheaf.map (homOfLE h2).op).hom t) =
      (W.presheaf.map (homOfLE (h1.trans h2)).op).hom t := by
    intro V V' V'' h1 h2 t
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  have hscal : ∀ {V V' : W.Opens} (hle : V' ≤ V) (x : Ω),
      (W.presheaf.map (homOfLE hle).op).hom (wcEszScal κ V x) = wcEszScal κ V' x := by
    intro V V' hle x
    unfold wcEszScal
    simp only [RingHom.comp_apply]
    exact res hle le_top _

  have htw : ∀ a b : Fin (N + 1),
      (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
          κ ⁻¹ᵁ wcSgD Ω N b)).op).hom (wcEszDh κ e F b) =
        wcEszG κ a b ^ e *
        (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
          κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (wcEszDh κ e F a) := by
    intro a b
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) :=
      MvPolynomial.gradedAlgebra
    have hXa : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω a)
    have hXb : (MvPolynomial.X b : MvPolynomial (Fin (N + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω b)
    have hXa' : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω (1 • 1) := by
      rw [smul_eq_mul, mul_one]; exact hXa
    have hFe : (F : MvPolynomial (Fin (N + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω (e • 1) := by
      simpa only [smul_eq_mul, mul_one] using F.2
    have hle_a : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
        (MvPolynomial.X a * MvPolynomial.X b) ≤ wcSgD Ω N a := fun y hy =>
      ((Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) _ _).le hy).1
    have hle_b : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
        (MvPolynomial.X a * MvPolynomial.X b) ≤ wcSgD Ω N b := fun y hy =>
      ((Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) _ _).le hy).2
    have hA : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          (MvPolynomial.X a * MvPolynomial.X b)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
            hXb (rfl : MvPolynomial.X a * MvPolynomial.X b = MvPolynomial.X a * MvPolynomial.X b)
            (HomogeneousLocalization.Away.mk _ hXa e (F : MvPolynomial (Fin (N + 1)) Ω) hFe)) =
        ((wcProjK Ω N).presheaf.map (homOfLE hle_a).op).hom (wcEszSec Ω N e F a) :=
      congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) hXa e
        (F : MvPolynomial (Fin (N + 1)) Ω) hFe))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
        (f := MvPolynomial.X a) hXb (x := MvPolynomial.X a * MvPolynomial.X b) rfl)
    have hB : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          (MvPolynomial.X a * MvPolynomial.X b)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
            hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
            (HomogeneousLocalization.Away.mk _ hXb e (F : MvPolynomial (Fin (N + 1)) Ω) hFe)) =
        ((wcProjK Ω N).presheaf.map (homOfLE hle_b).op).hom (wcEszSec Ω N e F b) :=
      congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) hXb e
        (F : MvPolynomial (Fin (N + 1)) Ω) hFe))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
        (f := MvPolynomial.X b) hXa (x := MvPolynomial.X a * MvPolynomial.X b)
        (mul_comm (MvPolynomial.X a) (MvPolynomial.X b)))
    have hEa : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          (MvPolynomial.X a * MvPolynomial.X b)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
            hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
            (HomogeneousLocalization.Away.mk _ hXb 1 (MvPolynomial.X a) hXa')) =
        ((wcProjK Ω N).presheaf.map (homOfLE hle_b).op).hom (wcSgE Ω N b a) :=
      congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) hXb 1 (MvPolynomial.X a) hXa'))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
        (f := MvPolynomial.X b) hXa (x := MvPolynomial.X a * MvPolynomial.X b)
        (mul_comm (MvPolynomial.X a) (MvPolynomial.X b)))
    have c1 : HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
          (HomogeneousLocalization.Away.mk _ hXb e (F : MvPolynomial (Fin (N + 1)) Ω) hFe) =
        HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
          (HomogeneousLocalization.Away.mk _ hXb 1 (MvPolynomial.X a) hXa') ^ e *
        HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          hXb (rfl : MvPolynomial.X a * MvPolynomial.X b = MvPolynomial.X a * MvPolynomial.X b)
          (HomogeneousLocalization.Away.mk _ hXa e (F : MvPolynomial (Fin (N + 1)) Ω) hFe) := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.val_mul,
        HomogeneousLocalization.val_pow, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.mk_pow, Localization.mk_mul, Localization.mk_eq_mk_iff]
      apply Localization.r_of_eq
      simp only [Submonoid.coe_mul, SubmonoidClass.coe_pow]
      ring
    have e0 : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          (MvPolynomial.X a * MvPolynomial.X b) :=
      (Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) _ _).ge
    have kl : ∀ s : Γ(wcProjK Ω N, wcSgD Ω N a),
        ((wcProjK Ω N).presheaf.map (homOfLE (inf_le_left : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N a)).op).hom s =
          ((wcProjK Ω N).presheaf.map (homOfLE e0).op).hom
            (((wcProjK Ω N).presheaf.map (homOfLE hle_a).op).hom s) := fun s =>
      congrArg (fun φ => φ.hom s)
        ((wcProjK Ω N).presheaf.map_comp (homOfLE hle_a).op (homOfLE e0).op)
    have kr : ∀ s : Γ(wcProjK Ω N, wcSgD Ω N b),
        ((wcProjK Ω N).presheaf.map (homOfLE (inf_le_right : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N b)).op).hom s =
          ((wcProjK Ω N).presheaf.map (homOfLE e0).op).hom
            (((wcProjK Ω N).presheaf.map (homOfLE hle_b).op).hom s) := fun s =>
      congrArg (fun φ => φ.hom s)
        ((wcProjK Ω N).presheaf.map_comp (homOfLE hle_b).op (homOfLE e0).op)
    have hP : ((wcProjK Ω N).presheaf.map (homOfLE (inf_le_right : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N b)).op).hom (wcEszSec Ω N e F b) =
        ((wcProjK Ω N).presheaf.map (homOfLE (inf_le_right : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N b)).op).hom (wcSgE Ω N b a) ^ e *
        ((wcProjK Ω N).presheaf.map (homOfLE (inf_le_left : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N a)).op).hom (wcEszSec Ω N e F a) := by
      rw [kr, kr, kl, ← hA, ← hB, ← hEa, c1]
      simp only [map_mul, map_pow]
    have el : (κ.app (wcSgD Ω N a ⊓ wcSgD Ω N b)).hom
        (((wcProjK Ω N).presheaf.map (homOfLE (inf_le_left : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N a)).op).hom (wcEszSec Ω N e F a)) =
        (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
            κ ⁻¹ᵁ wcSgD Ω N a)).op).hom ((κ.app (wcSgD Ω N a)).hom (wcEszSec Ω N e F a)) :=
      congrArg (fun φ => φ.hom (wcEszSec Ω N e F a))
        (Scheme.Hom.naturality κ (homOfLE (inf_le_left : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N a)).op)
    have er : (κ.app (wcSgD Ω N a ⊓ wcSgD Ω N b)).hom
        (((wcProjK Ω N).presheaf.map (homOfLE (inf_le_right : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N b)).op).hom (wcEszSec Ω N e F b)) =
        (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
            κ ⁻¹ᵁ wcSgD Ω N b)).op).hom ((κ.app (wcSgD Ω N b)).hom (wcEszSec Ω N e F b)) :=
      congrArg (fun φ => φ.hom (wcEszSec Ω N e F b))
        (Scheme.Hom.naturality κ (homOfLE (inf_le_right : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N b)).op)
    have eg : (κ.app (wcSgD Ω N a ⊓ wcSgD Ω N b)).hom
        (((wcProjK Ω N).presheaf.map (homOfLE (inf_le_right : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N b)).op).hom (wcSgE Ω N b a)) =
        (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
            κ ⁻¹ᵁ wcSgD Ω N b)).op).hom ((κ.app (wcSgD Ω N b)).hom (wcSgE Ω N b a)) :=
      congrArg (fun φ => φ.hom (wcSgE Ω N b a))
        (Scheme.Hom.naturality κ (homOfLE (inf_le_right : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N b)).op)
    unfold wcEszG wcEszDh
    rw [← el, ← er, ← eg, hP, map_mul, map_pow] <;> rfl

  have hE : ∀ (V : W.Opens), genericPoint W ∉ V → ∀ s t : Γ(W, V), s = t := by
    intro V hV s t
    apply TopCat.Presheaf.section_ext W.sheaf V s t
    intro x hx
    exact absurd (((genericPoint_spec W).mem_open_set_iff V.isOpen).mpr ⟨x, trivial, hx⟩) hV
  have gr : ∀ {U V : W.Opens} (i : U ⟶ V) (hx : genericPoint W ∈ U) (s : Γ(W, V)),
      (W.presheaf.germ U (genericPoint W) hx).hom ((W.presheaf.map i.op).hom s) =
      (W.presheaf.germ V (genericPoint W) (leOfHom i hx)).hom s :=
    fun i hx s => TopCat.Presheaf.germ_res_apply W.presheaf i _ hx s
  obtain ⟨a₀, ha₀⟩ : ∃ a₀, wcEszDh κ e F a₀ ≠ 0 := by
    by_contra h
    push_neg at h
    exact hF h
  have hη0 : genericPoint W ∈ κ ⁻¹ᵁ wcSgD Ω N a₀ := by
    by_contra hn
    exact ha₀ (hE _ hn _ _)
  have hg0 : (W.presheaf.germ _ (genericPoint W) hη0).hom (wcEszDh κ e F a₀) ≠ 0 := by
    intro h
    apply ha₀
    exact germ_injective_of_isIntegral W _ hη0
      (h.trans (map_zero (W.presheaf.germ _ (genericPoint W) hη0).hom).symm)
  have hga : ∀ (a : Fin (N + 1)) (ha : genericPoint W ∈ κ ⁻¹ᵁ wcSgD Ω N a),
      (W.presheaf.germ _ (genericPoint W) ha).hom (wcEszDh κ e F a) ≠ 0 := by
    intro a ha h
    have hm : genericPoint W ∈ κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N a₀ :=
      TopologicalSpace.Opens.mem_inf.mpr ⟨ha, hη0⟩
    have e' := congrArg (W.presheaf.germ _ (genericPoint W) hm).hom (htw a a₀)
    rw [map_mul, map_pow, gr, gr, h, mul_zero] at e'
    exact hg0 e'

  have hcoc : ∀ (g' : ∀ a : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD Ω N a))
      (c' : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b)),
      (∀ a b : Fin (N + 1), c' a b *
          (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
            κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (wcEszDh κ e F a) =
        (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
            κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (g' a) -
          (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
            κ ⁻¹ᵁ wcSgD Ω N b)).op).hom (g' b)) →
      wcEszCoc κ e c' := by
    intro g' c' hc'
    unfold wcEszCoc
    intro a b l
    by_cases hV : genericPoint W ∈
      κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ⊓ κ ⁻¹ᵁ wcSgD Ω N l
    swap
    · exact hE _ hV _ _
    have hab : genericPoint W ∈ κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b :=
      (TopologicalSpace.Opens.mem_inf.mp hV).1
    have hl : genericPoint W ∈ κ ⁻¹ᵁ wcSgD Ω N l := (TopologicalSpace.Opens.mem_inf.mp hV).2
    have ha : genericPoint W ∈ κ ⁻¹ᵁ wcSgD Ω N a := (TopologicalSpace.Opens.mem_inf.mp hab).1
    have hb : genericPoint W ∈ κ ⁻¹ᵁ wcSgD Ω N b := (TopologicalSpace.Opens.mem_inf.mp hab).2
    have hbl : genericPoint W ∈ κ ⁻¹ᵁ wcSgD Ω N b ⊓ κ ⁻¹ᵁ wcSgD Ω N l :=
      TopologicalSpace.Opens.mem_inf.mpr ⟨hb, hl⟩
    have hal : genericPoint W ∈ κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N l :=
      TopologicalSpace.Opens.mem_inf.mpr ⟨ha, hl⟩
    refine germ_injective_of_isIntegral W _ hV ?_
    have e1 := congrArg (W.presheaf.germ _ (genericPoint W) hab).hom (hc' a b)
    have e2 := congrArg (W.presheaf.germ _ (genericPoint W) hbl).hom (hc' b l)
    have e3 := congrArg (W.presheaf.germ _ (genericPoint W) hal).hom (hc' a l)
    have et := congrArg (W.presheaf.germ _ (genericPoint W) hab).hom (htw a b)
    simp only [map_add, map_sub, map_mul, map_pow, gr] at e1 e2 e3 et ⊢
    apply mul_left_cancel₀ (hga a ha)
    linear_combination e1 + e2 - e3 - (W.presheaf.germ _ (genericPoint W) hbl).hom (c' b l) * et

  haveI : IsProper (wcProjKStr Ω N) := wc_pp_proper Ω N
  haveI : UniversallyClosed r := by
    rw [← hκr]
    infer_instance
  haveI : Smooth r := SmoothOfRelativeDimension.smooth n r
  have hglobal : ∀ s : Γ(W, ⊤), ∃ x : Ω, s = wcEszScal κ ⊤ x := by
    have hfin : r.appTop.hom.Finite := finite_appTop_of_universallyClosed Ω r
    have hinvs : Function.Surjective (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom := by
      intro x
      refine ⟨(Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom x, ?_⟩
      simp
    have hφ : (r.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom).Finite :=
      hfin.comp (RingHom.Finite.of_surjective _ hinvs)
    letI : Algebra Ω Γ(W, ⊤) :=
      (r.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom).toAlgebra
    haveI : Algebra.IsIntegral Ω Γ(W, ⊤) := ⟨hφ.to_isIntegral⟩
    have hbij := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := Ω) (K := Γ(W, ⊤))
    intro s
    obtain ⟨x, hx⟩ := hbij.2 s
    refine ⟨x, ?_⟩
    rw [← hx]
    have h1 : (homOfLE (le_top : (⊤ : W.Opens) ≤ ⊤)).op = 𝟙 (Opposite.op (⊤ : W.Opens)) := rfl
    unfold wcEszScal
    rw [RingHom.comp_apply, RingHom.comp_apply, hκr]
    have h2 : W.presheaf.map (homOfLE (le_top : (⊤ : W.Opens) ≤ ⊤)).op = 𝟙 _ := by
      rw [h1, W.presheaf.map_id]
    rw [h2]
    rfl

  obtain ⟨p, w, -, hspan⟩ := wc_esz_twisted_h1_finite Ω N W κ hκ e

  have s5 : ∀ (P : (Fin p → Ω) → Prop), ∃ (k : ℕ) (ψ : Fin k → Fin p → Ω),
      (∀ j, P (ψ j)) ∧ ∀ t, P t → ∃ μ : Fin k → Ω, ∑ j, μ j • ψ j = t := by
    intro P
    have hfg : (Submodule.span Ω {t | P t}).FG := IsNoetherian.noetherian _
    obtain ⟨s', hs'S, hs'span⟩ := (Submodule.fg_span_iff_fg_span_finset_subset _).mp hfg
    refine ⟨s'.card, fun j => (s'.equivFin.symm j : Fin p → Ω),
      fun j => hs'S (s'.equivFin.symm j).2, ?_⟩
    intro t ht
    apply (Submodule.mem_span_range_iff_exists_fun Ω).mp
    have hr : Set.range (fun j => (s'.equivFin.symm j : Fin p → Ω)) =
        (s' : Set (Fin p → Ω)) := by
      ext x
      constructor
      · rintro ⟨j, rfl⟩
        exact (s'.equivFin.symm j).2
      · intro hx
        exact ⟨s'.equivFin ⟨x, hx⟩, by simp⟩
    rw [hr, ← hs'span]
    exact Submodule.subset_span ht

  obtain ⟨k, ψ, hψP, hψspan⟩ := s5 (fun t =>
    ∃ (g' : ∀ a : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD Ω N a))
      (c' : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b))
      (d' : ∀ a : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD Ω N a)),
      (∀ a b : Fin (N + 1), c' a b *
          (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
            κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (wcEszDh κ e F a) =
        (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
            κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (g' a) -
          (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
            κ ⁻¹ᵁ wcSgD Ω N b)).op).hom (g' b)) ∧
      (∀ a b : Fin (N + 1), c' a b -
          ∑ i, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b) (t i) * w i a b =
        (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
            κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (d' a) -
          wcEszG κ a b ^ e *
            (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
              κ ⁻¹ᵁ wcSgD Ω N b)).op).hom (d' b)))
  beta_reduce at hψP
  choose gw cw dw hgw hdw using hψP

  have alg : ∀ {R : Type u} [CommRing R] (σ : Ω →+* R) (Fa Ge xa xb da db cc : R)
      (ww : Fin p → R) (tt : Fin p → Ω) (μ' : Fin k → Ω) (xa' xb' c' da' db' : Fin k → R),
      cc * Fa = xa - xb → (∀ j, c' j * Fa = xa' j - xb' j) →
      cc - ∑ i, σ (tt i) * ww i = da - Ge * db →
      (∀ j, c' j - ∑ i, σ (ψ j i) * ww i = da' j - Ge * db' j) →
      ∑ j, μ' j • ψ j = tt →
      (xa - ∑ j, σ (μ' j) * xa' j) - Fa * (da - ∑ j, σ (μ' j) * da' j) =
        (xb - ∑ j, σ (μ' j) * xb' j) - (Ge * Fa) * (db - ∑ j, σ (μ' j) * db' j) := by
    intro R _ σ Fa Ge xa xb da db cc ww tt μ' xa' xb' c' da' db' h1 h2 h3 h4 h5
    subst h5
    have A1 : ∑ j, σ (μ' j) * xa' j - ∑ j, σ (μ' j) * xb' j =
        (∑ j, σ (μ' j) * c' j) * Fa := by
      rw [← Finset.sum_sub_distrib, Finset.sum_mul]
      exact Finset.sum_congr rfl fun j _ => by linear_combination -(σ (μ' j)) * h2 j
    have hGe : Ge * ∑ j, σ (μ' j) * db' j = ∑ j, Ge * (σ (μ' j) * db' j) := by
      rw [Finset.mul_sum]
    have A2 : ∑ j, σ (μ' j) * da' j - Ge * ∑ j, σ (μ' j) * db' j =
        ∑ j, σ (μ' j) * c' j - ∑ j, σ (μ' j) * ∑ i, σ (ψ j i) * ww i := by
      rw [hGe, ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl fun j _ => by linear_combination -(σ (μ' j)) * h4 j
    have star : ∑ i, σ ((∑ j, μ' j • ψ j) i) * ww i =
        ∑ j, σ (μ' j) * ∑ i, σ (ψ j i) * ww i := by
      have hi : ∀ i, σ ((∑ j, μ' j • ψ j) i) * ww i =
          ∑ j, σ (μ' j) * (σ (ψ j i) * ww i) := by
        intro i
        rw [Finset.sum_apply, map_sum, Finset.sum_mul]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [Pi.smul_apply, smul_eq_mul, map_mul]
        ring
      rw [Finset.sum_congr rfl fun i _ => hi i, Finset.sum_comm]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Finset.mul_sum]
    linear_combination -h1 - A1 + Fa * A2 + Fa * h3 + Fa * star

  refine ⟨k + 1, Fin.cons (fun a => (1 : Γ(W, κ ⁻¹ᵁ wcSgD Ω N a))) gw, ?_⟩
  intro g hg
  choose c hc using fun a b => Ideal.mem_span_singleton'.mp (hg a b)
  have hcc := hcoc g c hc
  obtain ⟨t, d, hd⟩ := hspan c hcc
  have hPt : ∃ (g' : ∀ a : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD Ω N a))
      (c' : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b))
      (d' : ∀ a : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD Ω N a)),
      (∀ a b : Fin (N + 1), c' a b *
          (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
            κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (wcEszDh κ e F a) =
        (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
            κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (g' a) -
          (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
            κ ⁻¹ᵁ wcSgD Ω N b)).op).hom (g' b)) ∧
      (∀ a b : Fin (N + 1), c' a b -
          ∑ i, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b) (t i) * w i a b =
        (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
            κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (d' a) -
          wcEszG κ a b ^ e *
            (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
              κ ⁻¹ᵁ wcSgD Ω N b)).op).hom (d' b)) :=
    ⟨g, c, d, hc, fun a b => hd a b⟩
  obtain ⟨μ, hμ⟩ := hψspan t hPt
  have hcomp : TopCat.Presheaf.IsCompatible W.sheaf.obj (fun a => κ ⁻¹ᵁ wcSgD Ω N a)
      (fun a => (g a - ∑ j, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (μ j) * gw j a) -
        wcEszDh κ e F a * (d a - ∑ j, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (μ j) * dw j a)) := by
    intro a b
    have key : (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
          κ ⁻¹ᵁ wcSgD Ω N a)).op).hom
          ((g a - ∑ j, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (μ j) * gw j a) -
            wcEszDh κ e F a * (d a - ∑ j, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (μ j) * dw j a)) =
        (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
          κ ⁻¹ᵁ wcSgD Ω N b)).op).hom
          ((g b - ∑ j, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N b) (μ j) * gw j b) -
            wcEszDh κ e F b * (d b - ∑ j, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N b) (μ j) * dw j b)) := by
      simp only [map_sub, map_mul, map_sum, hscal]
      rw [htw a b]
      have := alg (wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b))
        ((W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
          κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (wcEszDh κ e F a))
        (wcEszG κ a b ^ e)
        ((W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
          κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (g a))
        ((W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
          κ ⁻¹ᵁ wcSgD Ω N b)).op).hom (g b))
        ((W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
          κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (d a))
        ((W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
          κ ⁻¹ᵁ wcSgD Ω N b)).op).hom (d b))
        (c a b) (fun i => w i a b) t μ
        (fun j => (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓
          κ ⁻¹ᵁ wcSgD Ω N b ≤ κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (gw j a))
        (fun j => (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓
          κ ⁻¹ᵁ wcSgD Ω N b ≤ κ ⁻¹ᵁ wcSgD Ω N b)).op).hom (gw j b))
        (fun j => cw j a b)
        (fun j => (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓
          κ ⁻¹ᵁ wcSgD Ω N b ≤ κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (dw j a))
        (fun j => (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓
          κ ⁻¹ᵁ wcSgD Ω N b ≤ κ ⁻¹ᵁ wcSgD Ω N b)).op).hom (dw j b))
        (hc a b) (fun j => hgw j a b) (hd a b) (fun j => hdw j a b) hμ
      beta_reduce at this
      linear_combination this
    exact key
  obtain ⟨s, hs, -⟩ := TopCat.Sheaf.existsUnique_gluing' W.sheaf
    (fun a => κ ⁻¹ᵁ wcSgD Ω N a) ⊤ (fun a => homOfLE le_top)
    (by
      intro x _
      rw [TopologicalSpace.Opens.mem_iSup]
      exact hcov x) _ hcomp
  obtain ⟨c₀, hc₀⟩ := hglobal s
  refine ⟨Fin.cons c₀ μ, fun a => ?_⟩
  have hsa : (W.presheaf.map (homOfLE (le_top : κ ⁻¹ᵁ wcSgD Ω N a ≤ ⊤)).op).hom s =
      (g a - ∑ j, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (μ j) * gw j a) -
        wcEszDh κ e F a * (d a - ∑ j, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (μ j) * dw j a) := hs a
  rw [hc₀, hscal] at hsa
  rw [Fin.sum_univ_succ]
  simp only [Fin.cons_zero, Fin.cons_succ, mul_one]
  exact Ideal.mem_span_singleton'.mpr
    ⟨d a - ∑ j, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (μ j) * dw j a, by linear_combination hsa⟩

theorem wc_esz_mi_colon_primes_maximal (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (N n : ℕ)
    (hn2 : 2 ≤ n) (W : Scheme.{u}) (r : W ⟶ Spec (.of Ω)) [IrreducibleSpace W]
    [SmoothOfRelativeDimension n r] (κ : W ⟶ wcProjK Ω N) (hκ : IsClosedImmersion κ)
    (hκr : κ ≫ wcProjKStr Ω N = r) (e : ℕ) (he : 1 ≤ e)
    (F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω e) (hF : ¬ wcEszVanish κ e F)
    (q : ℕ) (v : Fin q → ∀ a : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD Ω N a))
    (hv : ∀ g : ∀ a : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD Ω N a),
        (∀ a b : Fin (N + 1),
          (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
              κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (g a) -
            (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
              κ ⁻¹ᵁ wcSgD Ω N b)).op).hom (g b) ∈
          Ideal.span {(W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓
              κ ⁻¹ᵁ wcSgD Ω N b ≤ κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (wcEszDh κ e F a)}) →
        ∃ t : Fin q → Ω, ∀ a : Fin (N + 1),
          g a - ∑ i, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (t i) * v i a ∈
            Ideal.span {wcEszDh κ e F a})
    (m : ℕ) (hm : q ≤ m) (b : ∀ a : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD Ω N a))
    (hb : ∀ a c : Fin (N + 1),
      (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N c ≤
          κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (b a) -
        wcEszG κ a c ^ m *
          (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N c ≤
            κ ⁻¹ᵁ wcSgD Ω N c)).op).hom (b c) ∈
        Ideal.span {(W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓
            κ ⁻¹ᵁ wcSgD Ω N c ≤ κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (wcEszDh κ e F a)})
    (a : Fin (N + 1)) (p : Ideal Γ(W, κ ⁻¹ᵁ wcSgD Ω N a)) (hp : p.IsPrime)
    (hpb : ∀ s, s * b a ∈ Ideal.span {wcEszDh κ e F a} → s ∈ p) :
    p.IsMaximal :=
by
  classical
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) :=
    MvPolynomial.gradedAlgebra
  haveI := hκ
  haveI := hp
  by_contra hpm
  have hX : ∀ c : Fin (N + 1), (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) Ω) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 1 := fun c =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω c)
  have hXa := hX a

  have htw : ∀ (E : ℕ) (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω E)
      (c l : Fin (N + 1)),
      (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N c ⊓ κ ⁻¹ᵁ wcSgD Ω N l ≤
          κ ⁻¹ᵁ wcSgD Ω N l)).op).hom (wcEszDh κ E G l) =
        wcEszG κ c l ^ E *
        (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N c ⊓ κ ⁻¹ᵁ wcSgD Ω N l ≤
          κ ⁻¹ᵁ wcSgD Ω N c)).op).hom (wcEszDh κ E G c) := by
    intro E G c l
    have hXc := hX c
    have hXl := hX l
    have hXc' : (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω (1 • 1) := by
      rw [smul_eq_mul, mul_one]; exact hXc
    have hFe : (G : MvPolynomial (Fin (N + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω (E • 1) := by
      simpa only [smul_eq_mul, mul_one] using G.2
    have hle_a : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
        (MvPolynomial.X c * MvPolynomial.X l) ≤ wcSgD Ω N c := fun y hy =>
      ((Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) _ _).le hy).1
    have hle_b : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
        (MvPolynomial.X c * MvPolynomial.X l) ≤ wcSgD Ω N l := fun y hy =>
      ((Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) _ _).le hy).2
    have hA : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          (MvPolynomial.X c * MvPolynomial.X l)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
            hXl (rfl : MvPolynomial.X c * MvPolynomial.X l = MvPolynomial.X c * MvPolynomial.X l)
            (HomogeneousLocalization.Away.mk _ hXc E (G : MvPolynomial (Fin (N + 1)) Ω) hFe)) =
        ((wcProjK Ω N).presheaf.map (homOfLE hle_a).op).hom (wcEszSec Ω N E G c) :=
      congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) hXc E
        (G : MvPolynomial (Fin (N + 1)) Ω) hFe))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
        (f := MvPolynomial.X c) hXl (x := MvPolynomial.X c * MvPolynomial.X l) rfl)
    have hB : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          (MvPolynomial.X c * MvPolynomial.X l)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
            hXc (mul_comm (MvPolynomial.X c) (MvPolynomial.X l))
            (HomogeneousLocalization.Away.mk _ hXl E (G : MvPolynomial (Fin (N + 1)) Ω) hFe)) =
        ((wcProjK Ω N).presheaf.map (homOfLE hle_b).op).hom (wcEszSec Ω N E G l) :=
      congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) hXl E
        (G : MvPolynomial (Fin (N + 1)) Ω) hFe))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
        (f := MvPolynomial.X l) hXc (x := MvPolynomial.X c * MvPolynomial.X l)
        (mul_comm (MvPolynomial.X c) (MvPolynomial.X l)))
    have hEa : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          (MvPolynomial.X c * MvPolynomial.X l)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
            hXc (mul_comm (MvPolynomial.X c) (MvPolynomial.X l))
            (HomogeneousLocalization.Away.mk _ hXl 1 (MvPolynomial.X c) hXc')) =
        ((wcProjK Ω N).presheaf.map (homOfLE hle_b).op).hom (wcSgE Ω N l c) :=
      congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) hXl 1 (MvPolynomial.X c) hXc'))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
        (f := MvPolynomial.X l) hXc (x := MvPolynomial.X c * MvPolynomial.X l)
        (mul_comm (MvPolynomial.X c) (MvPolynomial.X l)))
    have c1 : HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          hXc (mul_comm (MvPolynomial.X c) (MvPolynomial.X l))
          (HomogeneousLocalization.Away.mk _ hXl E (G : MvPolynomial (Fin (N + 1)) Ω) hFe) =
        HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          hXc (mul_comm (MvPolynomial.X c) (MvPolynomial.X l))
          (HomogeneousLocalization.Away.mk _ hXl 1 (MvPolynomial.X c) hXc') ^ E *
        HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          hXl (rfl : MvPolynomial.X c * MvPolynomial.X l = MvPolynomial.X c * MvPolynomial.X l)
          (HomogeneousLocalization.Away.mk _ hXc E (G : MvPolynomial (Fin (N + 1)) Ω) hFe) := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.val_mul,
        HomogeneousLocalization.val_pow, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.mk_pow, Localization.mk_mul, Localization.mk_eq_mk_iff]
      apply Localization.r_of_eq
      simp only [Submonoid.coe_mul, SubmonoidClass.coe_pow]
      ring
    have e0 : wcSgD Ω N c ⊓ wcSgD Ω N l ≤
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          (MvPolynomial.X c * MvPolynomial.X l) :=
