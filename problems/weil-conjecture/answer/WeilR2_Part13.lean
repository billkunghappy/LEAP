theorem wc_poly_pullback_iso_hal_a1 : ∀ (K : Type u) [Field K] (A C : Type u) [CommRing A] [CommRing C] (s : Spec (.of A) ⟶ Spec (.of K)) (c : Spec (.of C) ⟶ Spec (.of A)), ∃ j : Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c ≅ wcHalA1 (c ≫ s), j.hom ≫ wcHalA1Proj (c ≫ s) = Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c :=
