          _ = z' ≫ (π'' l ≫ Limits.pullback.fst (E.obj l).hom k) := whisker_eq _ (P1 l).symm
          _ = (z' ≫ π'' l) ≫ Limits.pullback.fst (E.obj l).hom k := (Category.assoc _ _ _).symm
          _ = z l ≫ Limits.pullback.fst (E.obj l).hom k := eq_whisker (hz' l) _
