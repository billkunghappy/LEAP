      { (φ.stalkMap z).hom with commutes' := fun c => hcomm c }
    obtain ⟨δ, hL, hB, hne⟩ :=
      conormal _ _ _ (by rw [hrk', hrk]) ψ hs h hk
    exact ⟨δ, hL, hB, hne⟩

  haveI hkc : IsClosedImmersion k := hZ.1
  haveI hsnd' : SmoothOfRelativeDimension n
