      exact IsLocalization.ker_map Bq θ hT

  have hgermcomp : ∀ {X Z : Scheme.{u}} (j : X ⟶ Z) (W : Z.Opens)
      (V : X.Opens) (hle : V ≤ j ⁻¹ᵁ W) (s : X) (hs : s ∈ V) (a : Γ(Z, W)),
      (j.stalkMap s).hom ((Z.presheaf.germ W (j s) (hle hs)).hom a) =
        (X.presheaf.germ V s hs).hom ((j.appLE W V hle).hom a) := by
    intro X Z j W V hle s hs a
    have e1 := Scheme.Hom.germ_stalkMap j W s (hle hs)
    have e2 : j.appLE W V hle ≫ X.presheaf.germ V s hs =
        j.app W ≫ X.presheaf.germ (j ⁻¹ᵁ W) s (hle hs) := by
      rw [Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
    have := congrArg (fun f => f.hom a) (e1.trans e2.symm)
    simpa using this

  have hstalk : ∀ {X Z : Scheme.{u}} (j : X ⟶ Z) (W : Z.Opens) (_ : IsAffineOpen W)
      (V : X.Opens) (_ : IsAffineOpen V) (hle : V ≤ j ⁻¹ᵁ W) (s : X) (hs : s ∈ V)
      (_ : Function.Surjective (j.appLE W V hle).hom),
      Function.Surjective (j.stalkMap s).hom ∧
      RingHom.ker (j.stalkMap s).hom =
        Ideal.map (Z.presheaf.germ W (j s) (hle hs)).hom (RingHom.ker (j.appLE W V hle).hom) := by
    intro X Z j W hW V hV hle s hs hsurj
    letI : Algebra Γ(Z, W) (Z.presheaf.stalk (j s)) :=
      TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨j s, hle hs⟩
    letI : Algebra Γ(X, V) (X.presheaf.stalk s) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨s, hs⟩
    haveI h1 : IsLocalization.AtPrime (Z.presheaf.stalk (j s))
        (hW.primeIdealOf ⟨j s, hle hs⟩).asIdeal := hW.isLocalization_stalk ⟨j s, hle hs⟩
    haveI h2 : IsLocalization.AtPrime (X.presheaf.stalk s)
        (hV.primeIdealOf ⟨s, hs⟩).asIdeal := hV.isLocalization_stalk ⟨s, hs⟩
    have hgW : algebraMap Γ(Z, W) (Z.presheaf.stalk (j s)) =
        (Z.presheaf.germ W (j s) (hle hs)).hom :=
      TopCat.Presheaf.stalk_open_algebraMap Z.presheaf ⟨j s, hle hs⟩
    have hgV : algebraMap Γ(X, V) (X.presheaf.stalk s) = (X.presheaf.germ V s hs).hom :=
      TopCat.Presheaf.stalk_open_algebraMap X.presheaf ⟨s, hs⟩
    have hPQ : (hW.primeIdealOf ⟨j s, hle hs⟩).asIdeal =
        Ideal.comap (j.appLE W V hle).hom (hV.primeIdealOf ⟨s, hs⟩).asIdeal := by
      ext a
      rw [Ideal.mem_comap,
        ← IsLocalization.AtPrime.to_map_mem_maximal_iff (X.presheaf.stalk s)
          (hV.primeIdealOf ⟨s, hs⟩).asIdeal,
        ← IsLocalization.AtPrime.to_map_mem_maximal_iff (Z.presheaf.stalk (j s))
          (hW.primeIdealOf ⟨j s, hle hs⟩).asIdeal, hgW, hgV,
        ← hgermcomp, IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal]
      exact (map_mem_nonunits_iff (j.stalkMap s).hom _).symm
    have hφ : ∀ a, (j.stalkMap s).hom (algebraMap Γ(Z, W) (Z.presheaf.stalk (j s)) a) =
        algebraMap Γ(X, V) (X.presheaf.stalk s) ((j.appLE W V hle).hom a) := by
      intro a
      rw [hgW, hgV]
      exact hgermcomp j W V hle s hs a
    have := hlocsurj (j.appLE W V hle).hom hsurj
      (hW.primeIdealOf ⟨j s, hle hs⟩).asIdeal (hV.primeIdealOf ⟨s, hs⟩).asIdeal hPQ
      (j.stalkMap s).hom hφ
    rw [hgW] at this
    exact this

  have hspecapp : ∀ (I : Ideal Γ(Z, W))
      (hle : (⊤ : (Spec (CommRingCat.of (Γ(Z, W) ⧸ I))).Opens) ≤
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ hW.fromSpec) ⁻¹ᵁ W),
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ hW.fromSpec).appLE W ⊤ hle =
        CommRingCat.ofHom (Ideal.Quotient.mk I) ≫
          (Scheme.ΓSpecIso (CommRingCat.of (Γ(Z, W) ⧸ I))).inv := by
    intro I hle
    set f := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) with hf
    have hle' : (⊤ : (Spec (CommRingCat.of (Γ(Z, W) ⧸ I))).Opens) ≤
        f ⁻¹ᵁ (hW.fromSpec ⁻¹ᵁ W) := hle
    have hle'' : (⊤ : (Spec (CommRingCat.of (Γ(Z, W) ⧸ I))).Opens) ≤ f ⁻¹ᵁ ⊤ := le_top
    calc (f ≫ hW.fromSpec).appLE W ⊤ hle
        = hW.fromSpec.app W ≫ f.appLE (hW.fromSpec ⁻¹ᵁ W) ⊤ hle' :=
          Scheme.Hom.comp_appLE _ _ _ _ _
      _ = (Scheme.ΓSpecIso Γ(Z, W)).inv ≫ ((Spec Γ(Z, W)).presheaf.map
            (eqToHom hW.fromSpec_preimage_self).op ≫ f.appLE (hW.fromSpec ⁻¹ᵁ W) ⊤ hle') := by
          rw [IsAffineOpen.fromSpec_app_self, Category.assoc]
      _ = (Scheme.ΓSpecIso Γ(Z, W)).inv ≫ f.appLE ⊤ ⊤ hle'' := by
          rw [Scheme.Hom.map_appLE]
      _ = (Scheme.ΓSpecIso Γ(Z, W)).inv ≫ f.appTop := by
          congr 1
      _ = _ := by
          rw [← Scheme.ΓSpecIso_inv_naturality]
  have hcomp : ∀ {X₁ X₂ X₃ : Scheme.{u}} (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃),
      Set.range (f ≫ g) = g '' Set.range f := by
    intro X₁ X₂ X₃ f g
    ext x
    simp only [Set.mem_range, Set.mem_image, Scheme.Hom.comp_apply]
    constructor
    · rintro ⟨a, rfl⟩; exact ⟨f a, ⟨a, rfl⟩, rfl⟩
    · rintro ⟨_, ⟨a, rfl⟩, rfl⟩; exact ⟨a, rfl⟩

  have hspecrange : Set.range (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (Ideal.span (Set.range ψ)))) ≫ hW.fromSpec) =
      {x : Z | ∃ hx : x ∈ W, ∀ j, (Z.presheaf.germ W x hx).hom (ψ j) ∈
        IsLocalRing.maximalIdeal (Z.presheaf.stalk x)} := by
    have h1 : Set.range (Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk (Ideal.span (Set.range ψ))))) =
        PrimeSpectrum.zeroLocus (Set.range ψ) := by
      have := range_comap_of_surjective _ (Ideal.Quotient.mk (Ideal.span (Set.range ψ)))
        Ideal.Quotient.mk_surjective
      rw [Ideal.mk_ker, PrimeSpectrum.zeroLocus_span] at this
      rw [← this]
      ext x
      simp only [Set.mem_range, Spec.map_apply, CommRingCat.hom_ofHom]
      exact Iff.rfl
    rw [hcomp, h1, hW.fromSpec_image_zeroLocus]
    ext x
    simp only [Set.mem_inter_iff, Scheme.mem_zeroLocus_iff, Set.mem_setOf_eq,
      Set.forall_mem_range, SetLike.mem_coe]
    constructor
    · rintro ⟨H, hx⟩
      refine ⟨hx, fun j => ?_⟩
      have := H j
      rw [Scheme.mem_basicOpen _ _ _ hx] at this
      rwa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    · rintro ⟨hx, H⟩
      refine ⟨fun j => ?_, hx⟩
      rw [Scheme.mem_basicOpen _ _ _ hx]
      have := H j
      rwa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at this

  have hproper : ∀ {S : Scheme.{u}} (jS : S ⟶ Z) [IsPreimmersion jS] (U₀ : Y.Opens)
      (T : Set Z) (_ : IsClosed T) (_ : Set.range jS = T ∩ h ⁻¹' (U₀ : Set Y)),
      IsProper ((jS ≫ h) ∣_ U₀) := by
    intro S jS _ U₀ T hT hrange
    haveI : IsClosedImmersion (jS ∣_ (h ⁻¹ᵁ U₀)) := by
      apply IsClosedImmersion.of_isPreimmersion
      have : Set.range (jS ∣_ (h ⁻¹ᵁ U₀)) = (h ⁻¹ᵁ U₀).ι ⁻¹' T := by
        ext v
        constructor
        · rintro ⟨x, rfl⟩
          show ((jS ∣_ (h ⁻¹ᵁ U₀)) x).1 ∈ T
          rw [morphismRestrict_base_coe]
          have : jS x.1 ∈ Set.range jS := ⟨_, rfl⟩
          rw [hrange] at this
          exact this.1
        · intro hv
          change v.1 ∈ T at hv
          have hvU : v.1 ∈ h ⁻¹' (U₀ : Set Y) := v.2
          have : v.1 ∈ Set.range jS := by rw [hrange]; exact ⟨hv, hvU⟩
          obtain ⟨s, hs⟩ := this
          have hs' : s ∈ jS ⁻¹ᵁ (h ⁻¹ᵁ U₀) := by
            show jS s ∈ h ⁻¹ᵁ U₀
            rw [hs]; exact v.2
          exact ⟨⟨s, hs'⟩, Subtype.ext ((morphismRestrict_base_coe jS _ ⟨s, hs'⟩).trans hs)⟩
      rw [this]
      exact hT.preimage (Scheme.Hom.continuous _)
    have key : IsProper (jS ∣_ (h ⁻¹ᵁ U₀) ≫ h ∣_ U₀) := inferInstance
    rw [morphismRestrict_comp]
    exact key

  set I : Ideal Γ(Z, W) := Ideal.span (Set.range ψ) with hI
  haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  set j₁ : Spec (CommRingCat.of (Γ(Z, W) ⧸ I)) ⟶ Z :=
    Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ hW.fromSpec with hj₁
  have hFc : IsClosed (h '' (NS \ (W : Set Z))) :=
    Scheme.Hom.isClosedMap h _ (hNS.sdiff W.isOpen)
  let U₀ : Y.Opens := ⟨(h '' (NS \ (W : Set Z)))ᶜ, hFc.isOpen_compl⟩
  have hmemU₀ : ∀ w : Y, w ∈ U₀ ↔ w ∉ h '' (NS \ (W : Set Z)) := fun w => Iff.rfl
  have hyU₀ : y ∈ U₀ := by
    rw [hmemU₀]
    rintro ⟨x, ⟨hxNS, hxW⟩, hx⟩
    exact hxW (hfib x hxNS hx ▸ hzW)
  have hkey : ∀ x ∈ NS, h x ∈ U₀ → x ∈ W := by
    intro x hx hxU
    by_contra hxW
    exact (hmemU₀ _).mp hxU ⟨x, ⟨hx, hxW⟩, rfl⟩
  let O : (Spec (CommRingCat.of (Γ(Z, W) ⧸ I))).Opens := (j₁ ≫ h) ⁻¹ᵁ U₀
  have hmemO : ∀ t, t ∈ O ↔ h (j₁ t) ∈ U₀ := by
    intro t
    show (j₁ ≫ h) t ∈ U₀ ↔ _
    rw [Scheme.Hom.comp_apply]
  have hrange1 : Set.range j₁ = NS ∩ W := by
    rw [hj₁, hspecrange]
    ext x
    constructor
    · rintro ⟨hx, H⟩; exact ⟨(hψ x hx).mpr H, hx⟩
    · rintro ⟨hx, hxW⟩; exact ⟨hxW, (hψ x hxW).mp hx⟩
  set jS : (O : Scheme.{u}) ⟶ Z := O.ι ≫ j₁ with hjS
  have hrangeS : Set.range jS = NS ∩ h ⁻¹' (U₀ : Set Y) := by
    ext x
    constructor
    · rintro ⟨s, rfl⟩
      show j₁ s.1 ∈ _
      have h1 : j₁ s.1 ∈ Set.range j₁ := ⟨_, rfl⟩
      rw [hrange1] at h1
      exact ⟨h1.1, (hmemO s.1).mp s.2⟩
    · rintro ⟨hx, hxU⟩
      have : x ∈ Set.range j₁ := by rw [hrange1]; exact ⟨hx, hkey x hx hxU⟩
      obtain ⟨t, rfl⟩ := this
      have htO : t ∈ O := (hmemO t).mpr hxU
      exact ⟨⟨t, htO⟩, rfl⟩
  haveI : IsPreimmersion jS := by rw [hjS]; infer_instance
  have hinj : Function.Injective jS := (Scheme.Hom.isEmbedding jS).injective
  have hzS : z ∈ Set.range jS := by
    rw [hrangeS]
    refine ⟨hz, ?_⟩
    show h z ∈ U₀
    rw [e]; exact hyU₀
  obtain ⟨s₀, ej⟩ := hzS
  refine ⟨U₀, O, jS, s₀, ej, hyU₀, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hjS]; infer_instance
  · exact hproper jS U₀ NS hNS hrangeS
  · rw [hcomp, hrangeS, Set.image_inter_preimage]
  · intro s hs
    rw [Scheme.Hom.comp_apply] at hs
    have h1 : jS s ∈ Set.range jS := ⟨_, rfl⟩
    rw [hrangeS] at h1
    exact hinj ((hfib _ h1.1 hs).trans ej.symm)
  · subst ej
    have hρ : wcLdnmTvRho jS s₀ (jS s₀) rfl = (jS.stalkMap s₀).hom := by
      unfold wcLdnmTvRho
      rw [TopCat.Presheaf.stalkSpecializes_refl, CommRingCat.hom_id, RingHom.comp_id]
    rw [hρ]
    have hle : (⊤ : (Spec (CommRingCat.of (Γ(Z, W) ⧸ I))).Opens) ≤ j₁ ⁻¹ᵁ W := by
      intro t _
      show j₁ t ∈ W
      have : j₁ t ∈ Set.range j₁ := ⟨t, rfl⟩
      rw [hrange1] at this
      exact this.2
    have happ := hspecapp I hle
    have hsurj : Function.Surjective (j₁.appLE W ⊤ hle).hom := by
      rw [happ, CommRingCat.hom_comp, RingHom.coe_comp]
      exact (ConcreteCategory.bijective_of_isIso
        (Scheme.ΓSpecIso (CommRingCat.of (Γ(Z, W) ⧸ I))).inv).surjective.comp
        Ideal.Quotient.mk_surjective
    have hker : RingHom.ker (j₁.appLE W ⊤ hle).hom = I := by
      rw [happ, CommRingCat.hom_comp, RingHom.ker_comp_of_injective]
      · exact Ideal.mk_ker
      · exact (ConcreteCategory.bijective_of_isIso
          (Scheme.ΓSpecIso (CommRingCat.of (Γ(Z, W) ⧸ I))).inv).injective
    obtain ⟨hs1, hs2⟩ := hstalk j₁ W hW ⊤ (isAffineOpen_top _) hle
      (O.ι s₀) trivial hsurj
    have hst : jS.stalkMap s₀ = j₁.stalkMap (O.ι s₀) ≫ O.ι.stalkMap s₀ :=
      Scheme.Hom.stalkMap_comp O.ι j₁ s₀
    have key : (jS.stalkMap s₀).hom =
        (O.ι.stalkMap s₀).hom.comp (j₁.stalkMap (O.ι s₀)).hom := by
      rw [hst]; rfl
    have hbij := ConcreteCategory.bijective_of_isIso (O.ι.stalkMap s₀)
    rw [key]
    refine ⟨?_, ?_⟩
    · exact hbij.surjective.comp hs1
    · refine (RingHom.ker_comp_of_injective (j₁.stalkMap (O.ι s₀)).hom
        (f := (O.ι.stalkMap s₀).hom) hbij.injective).trans ?_
      rw [hs2, hker]
      show Ideal.map _ (Ideal.span (Set.range ψ)) = _
      rw [Ideal.map_span, ← Set.range_comp]
      rfl

theorem wc_tvs_finite_near {S Y : Scheme.{u}} (g : S ⟶ Y) [LocallyOfFiniteType g] (U₀ : Y.Opens)
    (hP : IsProper (g ∣_ U₀)) (s : S) (y : Y) (e : g s = y) (hyU : y ∈ U₀)
    (hfib : ∀ s', g s' = y → s' = s)
    (hm : Ideal.map (wcLdnmTvRho g s y e) (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) =
      IsLocalRing.maximalIdeal (S.presheaf.stalk s))
    (hres : ∀ a : S.presheaf.stalk s, ∃ b : Y.presheaf.stalk y,
      a - wcLdnmTvRho g s y e b ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk s)) :
    ∃ U₁ : Y.Opens, y ∈ U₁ ∧ U₁ ≤ U₀ ∧ IsFinite (g ∣_ U₁) :=
by
  classical
  subst e

  have L1 : ∀ (R A : Type u) [CommRing R] [CommRing A] [Algebra R A]
      [Algebra.FormallyUnramified R A] [Algebra.EssFiniteType R A], Algebra.QuasiFinite R A := by
    intro R A _ _ _ _ _
    refine Algebra.QuasiFinite.mk (fun P _ => ?_)
    have : Algebra.FormallyUnramified P.ResidueField (P.Fiber A) :=
      Algebra.FormallyUnramified.base_change (R := R) (A := A) P.ResidueField
    have : Algebra.EssFiniteType P.ResidueField (P.Fiber A) :=
      Algebra.EssFiniteType.baseChange R A P.ResidueField
    exact Algebra.FormallyUnramified.finite_of_free P.ResidueField (P.Fiber A)

  have L4 : ∀ U₁ : Y.Opens, U₁ ≤ U₀ → IsProper (g ∣_ U₁) := by
    intro U₁ hle
    have := hP
    have h1 : IsProper ((g ∣_ U₀) ∣_ (U₀.ι ⁻¹ᵁ U₁)) := inferInstance
    have h2 : IsProper (g ∣_ (U₀.ι ''ᵁ (U₀.ι ⁻¹ᵁ U₁))) :=
      (MorphismProperty.arrow_mk_iso_iff @IsProper (morphismRestrictRestrict g U₀ _)).mp h1
    have hW : U₀.ι ''ᵁ (U₀.ι ⁻¹ᵁ U₁) = U₁ := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr hle
    rw [hW] at h2
    exact h2

  have hρ : wcLdnmTvRho g s (g s) rfl = (g.stalkMap s).hom := by
    unfold wcLdnmTvRho
    rw [TopCat.Presheaf.stalkSpecializes_refl]
    rfl
  rw [hρ] at hm hres
  have hE : (g.stalkMap s).hom.EssFiniteType := LocallyOfFiniteType.stalkMap g s
  letI : Algebra (Y.presheaf.stalk (g s)) (S.presheaf.stalk s) := (g.stalkMap s).hom.toAlgebra
  have : Algebra.EssFiniteType (Y.presheaf.stalk (g s)) (S.presheaf.stalk s) := hE
  have : IsLocalHom (algebraMap (Y.presheaf.stalk (g s)) (S.presheaf.stalk s)) :=
    (inferInstance : IsLocalHom (g.stalkMap s).hom)
  have hbij : Function.Bijective (algebraMap (IsLocalRing.ResidueField (Y.presheaf.stalk (g s)))
      (IsLocalRing.ResidueField (S.presheaf.stalk s))) := by
    refine ⟨by exact RingHom.injective _, fun x => ?_⟩
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective x
    obtain ⟨b, hb⟩ := hres a
    refine ⟨IsLocalRing.residue _ b, ?_⟩
    rw [IsLocalRing.ResidueField.algebraMap_residue, ← sub_eq_zero, ← map_sub,
      IsLocalRing.residue_eq_zero_iff]
    have := (IsLocalRing.maximalIdeal (S.presheaf.stalk s)).neg_mem hb
    rw [neg_sub] at this
    exact this
  have : Algebra.IsSeparable (IsLocalRing.ResidueField (Y.presheaf.stalk (g s)))
      (IsLocalRing.ResidueField (S.presheaf.stalk s)) := by
    let φ := AlgEquiv.ofBijective (Algebra.ofId (IsLocalRing.ResidueField (Y.presheaf.stalk (g s)))
      (IsLocalRing.ResidueField (S.presheaf.stalk s))) hbij
    exact Algebra.IsSeparable.of_algHom _ _ φ.symm.toAlgHom
  have hFU : Algebra.FormallyUnramified (Y.presheaf.stalk (g s)) (S.presheaf.stalk s) :=
    Algebra.FormallyUnramified.of_map_maximalIdeal hm
  have hQF : Algebra.QuasiFinite (Y.presheaf.stalk (g s)) (S.presheaf.stalk s) := L1 _ _
  have hs : s ∈ g.quasiFiniteLocus := Scheme.Hom.mem_quasiFiniteLocus.mpr hQF

  have := hP
  set L := g.quasiFiniteLocus with hLdef
  let C : Set (g ⁻¹ᵁ U₀ : Scheme.{u}) := (g ⁻¹ᵁ U₀).ι ⁻¹' (L : Set S)ᶜ
  have hC : IsClosed C := L.isOpen.isClosed_compl.preimage (g ⁻¹ᵁ U₀).ι.continuous
  have hD : IsClosed ((g ∣_ U₀) '' C) := (g ∣_ U₀).isClosedMap C hC
  let T : (U₀ : Scheme.{u}).Opens := ⟨((g ∣_ U₀) '' C)ᶜ, hD.isOpen_compl⟩
  refine ⟨U₀.ι ''ᵁ T, ?_, Scheme.Opens.ι_image_le _ _, ?_⟩
  · show g s ∈ ((U₀.ι ''ᵁ T : Y.Opens) : Set Y)
    rw [Scheme.Hom.coe_image]
    refine ⟨⟨g s, hyU⟩, ?_, rfl⟩
    rintro ⟨x', hx'C, hx'⟩
    apply hx'C
    have h1 : x'.1 = s := by
      apply hfib
      have := morphismRestrict_base_coe g U₀ x'
      rw [hx'] at this
      exact this.symm
    have h2 : (g ⁻¹ᵁ U₀).ι x' = x'.1 := Scheme.Opens.ι_apply _ _
    show (g ⁻¹ᵁ U₀).ι x' ∈ L
    rw [h2, h1]
    exact hs
  · have hL : ∀ x : S, g x ∈ U₀.ι ''ᵁ T → x ∈ L := by
      intro x hx
      have hx' : g x ∈ ((U₀.ι ''ᵁ T : Y.Opens) : Set Y) := hx
      rw [Scheme.Hom.coe_image] at hx'
      obtain ⟨w, hwT, hw⟩ := hx'
      have hw1 : U₀.ι w = w.1 := Scheme.Opens.ι_apply _ _
      rw [hw1] at hw
      have hxU : x ∈ g ⁻¹ᵁ U₀ := by
        show g x ∈ U₀
        rw [← hw]; exact w.2
      by_contra hxL
      apply hwT
      refine ⟨⟨x, hxU⟩, ?_, ?_⟩
      · have h3 : (g ⁻¹ᵁ U₀).ι ⟨x, hxU⟩ = x := Scheme.Opens.ι_apply _ _
        show (g ⁻¹ᵁ U₀).ι ⟨x, hxU⟩ ∉ L
        rw [h3]
        exact hxL
      · exact Subtype.ext ((morphismRestrict_base_coe g U₀ ⟨x, hxU⟩).trans hw.symm)
    have := L4 (U₀.ι ''ᵁ T) (Scheme.Opens.ι_image_le _ _)
    have : LocallyQuasiFinite (g ∣_ (U₀.ι ''ᵁ T)) := by
      rw [← Scheme.Hom.quasiFiniteLocus_eq_top_iff, eq_top_iff]
      intro x _
      rw [Scheme.Hom.mem_quasiFiniteLocus]
      show ((g ∣_ (U₀.ι ''ᵁ T)).stalkMap x).hom.QuasiFinite
      rw [RingHom.QuasiFinite.respectsIso.arrow_mk_iso_iff
        (morphismRestrictStalkMap g (U₀.ι ''ᵁ T) x)]
      exact Scheme.Hom.mem_quasiFiniteLocus.mp (hL x.1 x.2)
    exact IsFinite.of_isProper_of_locallyQuasiFinite _

theorem wc_tvs_closed_imm_of_finite {S Y : Scheme.{u}} (g : S ⟶ Y) (U₁ : Y.Opens)
    (hF : IsFinite (g ∣_ U₁)) (s : S) (y : Y) (e : g s = y) (hyU : y ∈ U₁)
    (hfib : ∀ s', g s' = y → s' = s)
    (hm : Ideal.map (wcLdnmTvRho g s y e) (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) =
      IsLocalRing.maximalIdeal (S.presheaf.stalk s))
    (hres : ∀ a : S.presheaf.stalk s, ∃ b : Y.presheaf.stalk y,
      a - wcLdnmTvRho g s y e b ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk s)) :
    ∃ V : Y.Opens, y ∈ V ∧ V ≤ U₁ ∧ IsClosedImmersion (g ∣_ V) :=
by
  classical
  subst e
  have hρ : wcLdnmTvRho g s (g s) rfl = (g.stalkMap s).hom := by
    unfold wcLdnmTvRho
    rw [TopCat.Presheaf.stalkSpecializes_refl]
    simp
  rw [hρ] at hm hres

  have K5 : ∀ {R B : Type u} [CommRing R] [CommRing B] (φ : R →+* B), φ.Finite →
      ∀ (p : Ideal R) [p.IsPrime] (q : Ideal B),
      (∀ Q : Ideal B, Q.IsPrime → Q.comap φ = p → Q = q) →
      ∀ u ∉ q, ∃ v : B, ∃ m ∉ p, u * v = φ m := by
    intro R B _ _ φ hφ p _ q huniq u hu
    classical
    letI := φ.toAlgebra
    haveI : Module.Finite R B := hφ
    haveI : Algebra.IsIntegral R B := Algebra.IsIntegral.of_finite R B
    by_contra hcon
    push_neg at hcon
    have hdisj : Disjoint ((Ideal.span {u} : Ideal B) : Set B) (Submonoid.map φ p.primeCompl) := by
      rw [Set.disjoint_left]
      rintro x hx hxT
      obtain ⟨m, hm, rfl⟩ := Submonoid.mem_map.mp hxT
      obtain ⟨v, hv⟩ := Ideal.mem_span_singleton'.mp hx
      exact hcon v m hm (by rw [mul_comm]; exact hv)
    obtain ⟨Q, hQ, hle, hQdisj⟩ := Ideal.exists_le_prime_disjoint (Ideal.span {u}) _ hdisj
    have hcomap : Q.comap (algebraMap R B) ≤ p := by
      intro r hr
      by_contra hrp
      exact Set.disjoint_left.mp hQdisj hr (Submonoid.mem_map.mpr ⟨r, hrp, rfl⟩)
    obtain ⟨Q', hQQ', hQ'prime, hQ'over⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime p Q hcomap
    have := huniq Q' hQ'prime hQ'over
    exact hu (this ▸ hQQ' (hle (Ideal.mem_span_singleton_self u)))

  have K6 : ∀ {R B : Type u} [CommRing R] [CommRing B] (φ : R →+* B), φ.Finite →
      ∀ (p : Ideal R) [hp : p.IsPrime],
      (∀ b : B, ∃ m ∉ p, ∃ r : R, φ m * b - φ r ∈ Ideal.map φ p) →
      ∃ t ∉ p, ∀ b : B, ∃ r : R, φ t * b = φ r := by
    intro R B _ _ φ hφ p hp H
    classical
    letI := φ.toAlgebra
    haveI : Module.Finite R B := hφ
    have hφa : algebraMap R B = φ := RingHom.algebraMap_toAlgebra φ
    obtain ⟨n, bs, hbs⟩ := Module.Finite.exists_fin (R := R) (M := B)
    choose m hm r hr using fun i : Fin n => H (bs i)
    set s : R := ∏ i, m i with hs_def
    have hs : s ∉ p := by
      intro h
      obtain ⟨i, _, hi⟩ := Ideal.IsPrime.prod_mem_iff.mp h
      exact hm i hi
    set N : Submodule R B := LinearMap.range (Algebra.linearMap R B) with hN
    set L : Submodule R B := N ⊔ p • (⊤ : Submodule R B) with hL
    have hpt : ∀ x ∈ Ideal.map φ p, x ∈ p • (⊤ : Submodule R B) := by
      intro x hx
      rw [Ideal.smul_top_eq_map, hφa]
      exact hx
    have hmi : ∀ i, m i • bs i ∈ L := by
      intro i
      have e : m i • bs i = φ (r i) + (φ (m i) * bs i - φ (r i)) := by
        rw [Algebra.smul_def, hφa]; ring
      rw [e]
      refine Submodule.add_mem_sup ?_ (hpt _ (hr i))
      exact ⟨r i, by rw [Algebra.linearMap_apply, hφa]⟩
    have hsi : ∀ i, s • bs i ∈ L := by
      intro i
      obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem m (Finset.mem_univ i)
      rw [← hs_def] at hc
      rw [hc, mul_comm, mul_smul]
      exact L.smul_mem c (hmi i)
    have hsb : ∀ b : B, s • b ∈ L := by
      intro b
      have hb : b ∈ Submodule.span R (Set.range bs) := by rw [hbs]; trivial
      obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hb
      rw [Finset.smul_sum]
      refine L.sum_mem fun i _ => ?_
      rw [smul_comm]
      exact L.smul_mem _ (hsi i)
    let f : Module.End R (B ⧸ N) := algebraMap R (Module.End R (B ⧸ N)) s
    have hrange : LinearMap.range f ≤ p • (⊤ : Submodule R (B ⧸ N)) := by
      rintro x ⟨z, rfl⟩
      obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective N z
      obtain ⟨ν, hν, y, hy, hνy⟩ := Submodule.mem_sup.mp (hsb b)
      have : f (Submodule.Quotient.mk b) = N.mkQ y := by
        show (algebraMap R (Module.End R (B ⧸ N)) s) (Submodule.Quotient.mk b) = _
        rw [Module.algebraMap_end_apply, ← Submodule.Quotient.mk_smul, ← hνy,
          Submodule.mkQ_apply, Submodule.Quotient.eq]
        simpa using hν
      rw [this]
      have h1 : N.mkQ y ∈ (p • (⊤ : Submodule R B)).map N.mkQ := Submodule.mem_map_of_mem hy
      rw [Submodule.map_smul''] at h1
      exact Submodule.smul_mono le_rfl le_top h1
    obtain ⟨P, hPm, -, hPc, hPf⟩ :=
      LinearMap.exists_monic_and_natDegree_eq_and_coeff_mem_pow_and_aeval_eq_zero R f p hrange
    set t : R := P.eval s with ht
    have hft : algebraMap R (Module.End R (B ⧸ N)) t = 0 := by
      rw [ht, ← Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval]
      exact hPf
    refine ⟨t, ?_, ?_⟩
    · intro htp
      set d := P.natDegree with hd
      have hsum : t = ∑ i ∈ Finset.range d, P.coeff i * s ^ i + s ^ d := by
        rw [ht, Polynomial.eval_eq_sum_range, Finset.sum_range_succ, ← hd, hPm.coeff_natDegree, one_mul]
      have hrest : ∑ i ∈ Finset.range d, P.coeff i * s ^ i ∈ p := by
        refine Ideal.sum_mem _ fun i hi => ?_
        have hi' : i < d := Finset.mem_range.mp hi
        refine Ideal.mul_mem_right _ _ ?_
        exact Ideal.pow_le_self (by omega) (hPc i)
      have : s ^ d ∈ p := by
        have := p.sub_mem htp hrest
        rwa [hsum, add_sub_cancel_left] at this
      exact hs (hp.mem_of_pow_mem d this)
    · intro b
      have h0 : (algebraMap R (Module.End R (B ⧸ N)) t) (Submodule.Quotient.mk b) = 0 := by
        rw [hft]; rfl
      rw [Module.algebraMap_end_apply, ← Submodule.Quotient.mk_smul,
        Submodule.Quotient.mk_eq_zero] at h0
      obtain ⟨r', hr'⟩ := h0
      refine ⟨r', ?_⟩
      rw [Algebra.linearMap_apply, Algebra.smul_def, hφa] at hr'
      exact hr'.symm

  have K1 : ∃ V₀ : Y.Opens, IsAffineOpen V₀ ∧ g s ∈ V₀ ∧ V₀ ≤ U₁ ∧ IsAffineOpen (g ⁻¹ᵁ V₀) ∧
      (g.app V₀).hom.Finite := by
    have hy : g s ∈ U₁ := hyU
    obtain ⟨W, hW, hyW, hWU⟩ := exists_isAffineOpen_mem_and_subset hy
    have hWle : W ≤ U₁.ι.opensRange := by rw [Scheme.Opens.opensRange_ι]; exact hWU
    have hW' : IsAffineOpen (U₁.ι ⁻¹ᵁ W) := hW.preimage_of_isOpenImmersion U₁.ι hWle
    refine ⟨U₁.ι ''ᵁ (U₁.ι ⁻¹ᵁ W), hW'.image_of_isOpenImmersion U₁.ι, ?_, ?_, ?_, ?_⟩
    · rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact ⟨hy, hyW⟩
    · have := U₁.ι.image_le_opensRange (U₁.ι ⁻¹ᵁ W)
      rwa [Scheme.Opens.opensRange_ι] at this
    · rw [← image_morphismRestrict_preimage]
      exact (IsAffineHom.isAffine_preimage (f := g ∣_ U₁) _ hW').image_of_isOpenImmersion _
    · have h1 := IsFinite.finite_app (g ∣_ U₁) _ hW'
      rw [morphismRestrict_app'] at h1
      rw [Scheme.Hom.app_eq_appLE]
      exact (Scheme.Hom.appLE_congr g _ rfl (image_morphismRestrict_preimage g U₁ _)
        (fun f => f.hom.Finite)).mp h1
  obtain ⟨V₀, hV₀, hs, hV₀U₁, hW, hφfin⟩ := K1

  have K2 : ∀ (Q : Ideal Γ(S, g ⁻¹ᵁ V₀)) (hQ : Q.IsPrime),
      Q.comap (g.app V₀).hom = (hV₀.primeIdealOf ⟨g s, hs⟩).asIdeal →
      Q = (hW.primeIdealOf ⟨s, hs⟩).asIdeal := by
    intro Q hQ hQp
    let P : Spec Γ(S, g ⁻¹ᵁ V₀) := (⟨Q, hQ⟩ : PrimeSpectrum Γ(S, g ⁻¹ᵁ V₀))
    have key := IsAffineOpen.SpecMap_appLE_fromSpec g hV₀ hW le_rfl
    have h1 : g (hW.fromSpec P) = hV₀.fromSpec (Spec.map (g.appLE V₀ (g ⁻¹ᵁ V₀) le_rfl) P) := by
      have := congrArg (fun φ : Spec Γ(S, g ⁻¹ᵁ V₀) ⟶ Y => φ P) key
      simpa only [Scheme.Hom.comp_apply] using this.symm
    have h2 : Spec.map (g.appLE V₀ (g ⁻¹ᵁ V₀) le_rfl) P = hV₀.primeIdealOf ⟨g s, hs⟩ := by
      apply PrimeSpectrum.ext
      rw [← hQp, g.app_eq_appLE]
      rfl
    have h3 : hW.fromSpec P = s := by
      apply hfib
      rw [h1, h2, hV₀.fromSpec_primeIdealOf]
    have h4 : hW.fromSpec P = hW.fromSpec (hW.primeIdealOf ⟨s, hs⟩) := by
      rw [h3, hW.fromSpec_primeIdealOf]
    have := hW.fromSpec.isOpenEmbedding.isEmbedding.injective h4
    exact congrArg PrimeSpectrum.asIdeal this

  have K3 : ∀ b ∈ (hW.primeIdealOf ⟨s, hs⟩).asIdeal, ∃ u ∉ (hW.primeIdealOf ⟨s, hs⟩).asIdeal,
      u * b ∈ Ideal.map (g.app V₀).hom (hV₀.primeIdealOf ⟨g s, hs⟩).asIdeal := by
    intro b hb
    set p := (hV₀.primeIdealOf ⟨g s, hs⟩).asIdeal with hp
    set q := (hW.primeIdealOf ⟨s, hs⟩).asIdeal with hq
    letI := TopCat.Presheaf.algebra_section_stalk Y.presheaf (⟨g s, hs⟩ : V₀)
    letI := TopCat.Presheaf.algebra_section_stalk S.presheaf (⟨s, hs⟩ : g ⁻¹ᵁ V₀)
    haveI : IsLocalization.AtPrime (Y.presheaf.stalk (g s)) p := hV₀.isLocalization_stalk ⟨g s, hs⟩
    haveI : IsLocalization.AtPrime (S.presheaf.stalk s) q := hW.isLocalization_stalk ⟨s, hs⟩
    have hcomm : (g.stalkMap s).hom.comp (algebraMap Γ(Y, V₀) (Y.presheaf.stalk (g s))) =
        (algebraMap Γ(S, g ⁻¹ᵁ V₀) (S.presheaf.stalk s)).comp (g.app V₀).hom := by
      ext a; exact Scheme.Hom.germ_stalkMap_apply g V₀ s hs a
    have hmax : IsLocalRing.maximalIdeal (S.presheaf.stalk s) =
        Ideal.map (algebraMap Γ(S, g ⁻¹ᵁ V₀) (S.presheaf.stalk s)) (Ideal.map (g.app V₀).hom p) := by
      rw [← hm, ← IsLocalization.AtPrime.map_eq_maximalIdeal p (Y.presheaf.stalk (g s)),
        Ideal.map_map, hcomm, ← Ideal.map_map]
    have hbm : algebraMap Γ(S, g ⁻¹ᵁ V₀) (S.presheaf.stalk s) b ∈
        IsLocalRing.maximalIdeal (S.presheaf.stalk s) :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff (S.presheaf.stalk s) q b).mpr hb
    rw [hmax] at hbm
    obtain ⟨⟨x, m⟩, hxm⟩ :=
      (IsLocalization.mem_map_algebraMap_iff q.primeCompl (S.presheaf.stalk s)).mp hbm
    rw [← map_mul] at hxm
    obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists q.primeCompl (S.presheaf.stalk s)).mp hxm
    refine ⟨c * m, fun h => ?_, ?_⟩
    · rcases (inferInstance : q.IsPrime).mem_or_mem h with h' | h'
      · exact c.2 h'
      · exact m.2 h'
    · have e : (c : Γ(S, g ⁻¹ᵁ V₀)) * m * b = c * x := by rw [← hc]; ring
      rw [e]
      exact Ideal.mul_mem_left _ _ x.2

  have K4 : ∀ b : Γ(S, g ⁻¹ᵁ V₀), ∃ r : Γ(Y, V₀), ∃ m ∉ (hV₀.primeIdealOf ⟨g s, hs⟩).asIdeal,
      (g.app V₀).hom m * b - (g.app V₀).hom r ∈ (hW.primeIdealOf ⟨s, hs⟩).asIdeal := by
    intro b
    set p := (hV₀.primeIdealOf ⟨g s, hs⟩).asIdeal with hp
    set q := (hW.primeIdealOf ⟨s, hs⟩).asIdeal with hq
    letI := TopCat.Presheaf.algebra_section_stalk Y.presheaf (⟨g s, hs⟩ : V₀)
    letI := TopCat.Presheaf.algebra_section_stalk S.presheaf (⟨s, hs⟩ : g ⁻¹ᵁ V₀)
    haveI : IsLocalization.AtPrime (Y.presheaf.stalk (g s)) p := hV₀.isLocalization_stalk ⟨g s, hs⟩
    haveI : IsLocalization.AtPrime (S.presheaf.stalk s) q := hW.isLocalization_stalk ⟨s, hs⟩
    have hσ : ∀ a, (g.stalkMap s).hom (algebraMap Γ(Y, V₀) (Y.presheaf.stalk (g s)) a) =
        algebraMap Γ(S, g ⁻¹ᵁ V₀) (S.presheaf.stalk s) ((g.app V₀).hom a) :=
      fun a => Scheme.Hom.germ_stalkMap_apply g V₀ s hs a
    obtain ⟨c, hc⟩ := hres (algebraMap Γ(S, g ⁻¹ᵁ V₀) (S.presheaf.stalk s) b)
    obtain ⟨⟨r, m⟩, hrm⟩ := IsLocalization.mk'_surjective p.primeCompl c
    have hrm' : IsLocalization.mk' (Y.presheaf.stalk (g s)) r m = c := hrm
    subst hrm'
    refine ⟨r, m, m.2, ?_⟩
    rw [← IsLocalization.AtPrime.to_map_mem_maximal_iff (S.presheaf.stalk s) q]
    have h2 := congrArg (g.stalkMap s).hom (IsLocalization.mk'_spec (Y.presheaf.stalk (g s)) r m)
    rw [map_mul, hσ, hσ] at h2
    have e : algebraMap Γ(S, g ⁻¹ᵁ V₀) (S.presheaf.stalk s) ((g.app V₀).hom m * b - (g.app V₀).hom r) =
        algebraMap Γ(S, g ⁻¹ᵁ V₀) (S.presheaf.stalk s) ((g.app V₀).hom m) *
          (algebraMap Γ(S, g ⁻¹ᵁ V₀) (S.presheaf.stalk s) b -
            (g.stalkMap s).hom (IsLocalization.mk' (Y.presheaf.stalk (g s)) r m)) := by
      rw [map_sub, map_mul, ← h2]; ring
    rw [e]
    exact Ideal.mul_mem_left _ _ hc

  have K7 : ∀ t : Γ(Y, V₀),
      (∀ b : Γ(S, g ⁻¹ᵁ V₀), ∃ r : Γ(Y, V₀), (g.app V₀).hom t * b = (g.app V₀).hom r) →
      IsClosedImmersion (g ∣_ Y.basicOpen t) := by
    intro t ht
    set φ' := (g.appLE V₀ (g ⁻¹ᵁ V₀) le_rfl).hom with hφ'
    have ht' : ∀ b : Γ(S, g ⁻¹ᵁ V₀), ∃ r : Γ(Y, V₀), φ' t * b = φ' r := by
      rw [hφ', ← g.app_eq_appLE]; exact ht
    have hpre : g ⁻¹ᵁ Y.basicOpen t = S.basicOpen (φ' t) := by
      rw [Scheme.preimage_basicOpen, hφ', Scheme.Hom.app_eq_appLE]
    have hD : IsAffineOpen (Y.basicOpen t) := hV₀.basicOpen t
    have hD' : IsAffineOpen (g ⁻¹ᵁ Y.basicOpen t) := by rw [hpre]; exact hW.basicOpen _
    haveI : IsAffine (Y.basicOpen t) := hD
    haveI : IsAffine (g ⁻¹ᵁ Y.basicOpen t) := hD'
    apply IsClosedImmersion.of_surjective_of_isAffine
    show Function.Surjective ((g ∣_ Y.basicOpen t).app ⊤).hom
    rw [morphismRestrict_app']
    have e₂ : (g ⁻¹ᵁ Y.basicOpen t).ι ''ᵁ ((g ∣_ Y.basicOpen t) ⁻¹ᵁ ⊤) = S.basicOpen (φ' t) := by
      rw [Scheme.Hom.preimage_top, Scheme.Opens.ι_image_top, hpre]
    refine (Scheme.Hom.appLE_congr g _ (Scheme.Opens.ι_image_top _) e₂
      (fun f => Function.Surjective f.hom)).mpr ?_
    show Function.Surjective (g.appLE (Y.basicOpen t) (S.basicOpen (φ' t)) _).hom
    rw [IsAffineOpen.appLE_eq_away_map g hV₀ hW le_rfl t, CommRingCat.hom_ofHom]
    haveI := hV₀.isLocalization_basicOpen t
    haveI := hW.isLocalization_basicOpen (φ' t)
    intro z
    obtain ⟨n, a, hz⟩ := IsLocalization.Away.surj (S := Γ(S, S.basicOpen (φ' t))) (φ' t) z
    obtain ⟨r, hr⟩ := ht' a
    set ψ := IsLocalization.Away.map Γ(Y, Y.basicOpen t) Γ(S, S.basicOpen (φ' t)) φ' t with hψdef
    have hψ : ∀ x, ψ (algebraMap Γ(Y, V₀) Γ(Y, Y.basicOpen t) x) =
        algebraMap Γ(S, g ⁻¹ᵁ V₀) Γ(S, S.basicOpen (φ' t)) (φ' x) := fun x =>
      IsLocalization.map_eq _ x
    have hTU : algebraMap Γ(S, g ⁻¹ᵁ V₀) Γ(S, S.basicOpen (φ' t)) (φ' t) *
        ψ (IsLocalization.Away.invSelf (S := Γ(Y, Y.basicOpen t)) t) = 1 := by
      rw [← hψ, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
    refine ⟨algebraMap Γ(Y, V₀) Γ(Y, Y.basicOpen t) r *
      (IsLocalization.Away.invSelf (S := Γ(Y, Y.basicOpen t)) t) ^ (n + 1), ?_⟩
    rw [map_mul, map_pow, hψ, ← hr, map_mul, ← hz]
    calc algebraMap Γ(S, g ⁻¹ᵁ V₀) Γ(S, S.basicOpen (φ' t)) (φ' t) *
          (z * algebraMap Γ(S, g ⁻¹ᵁ V₀) Γ(S, S.basicOpen (φ' t)) (φ' t) ^ n) *
          ψ (IsLocalization.Away.invSelf (S := Γ(Y, Y.basicOpen t)) t) ^ (n + 1)
        = z * (algebraMap Γ(S, g ⁻¹ᵁ V₀) Γ(S, S.basicOpen (φ' t)) (φ' t) *
          ψ (IsLocalization.Away.invSelf (S := Γ(Y, Y.basicOpen t)) t)) ^ (n + 1) := by ring
      _ = z := by rw [hTU, one_pow, mul_one]

  have hcomb : ∀ b : Γ(S, g ⁻¹ᵁ V₀), ∃ m ∉ (hV₀.primeIdealOf ⟨g s, hs⟩).asIdeal, ∃ r : Γ(Y, V₀),
      (g.app V₀).hom m * b - (g.app V₀).hom r ∈
        Ideal.map (g.app V₀).hom (hV₀.primeIdealOf ⟨g s, hs⟩).asIdeal := by
    intro b
    obtain ⟨r₁, m₁, hm₁, hx⟩ := K4 b
    obtain ⟨u, hu, hux⟩ := K3 _ hx
    obtain ⟨v, m₂, hm₂, huv⟩ := K5 (g.app V₀).hom hφfin _ _ K2 u hu
    refine ⟨m₂ * m₁, fun h => ?_, m₂ * r₁, ?_⟩
    · rcases (inferInstance : (hV₀.primeIdealOf ⟨g s, hs⟩).asIdeal.IsPrime).mem_or_mem h with h' | h'
      · exact hm₂ h'
      · exact hm₁ h'
    · have e : (g.app V₀).hom (m₂ * m₁) * b - (g.app V₀).hom (m₂ * r₁) =
          v * (u * ((g.app V₀).hom m₁ * b - (g.app V₀).hom r₁)) := by
        rw [map_mul, map_mul, ← huv]; ring
      rw [e]
      exact Ideal.mul_mem_left _ _ hux
  obtain ⟨t, htp, ht⟩ := K6 (g.app V₀).hom hφfin _ hcomb
  refine ⟨Y.basicOpen t, ?_, (Y.basicOpen_le t).trans hV₀U₁, K7 t ht⟩
  rw [Scheme.mem_basicOpen Y t (g s) hs]
  letI := TopCat.Presheaf.algebra_section_stalk Y.presheaf (⟨g s, hs⟩ : V₀)
  haveI : IsLocalization.AtPrime (Y.presheaf.stalk (g s)) (hV₀.primeIdealOf ⟨g s, hs⟩).asIdeal :=
    hV₀.isLocalization_stalk ⟨g s, hs⟩
  exact (IsLocalization.AtPrime.isUnit_to_map_iff (Y.presheaf.stalk (g s))
    (hV₀.primeIdealOf ⟨g s, hs⟩).asIdeal t).mpr htp

theorem wc_tvs_principal_spread {S Y : Scheme.{u}} [IsLocallyNoetherian Y] (g : S ⟶ Y)
    (V : Y.Opens) (hV : IsClosedImmersion (g ∣_ V)) (s : S) (y : Y) (e : g s = y) (hyV : y ∈ V)
    (x₀ : Y.presheaf.stalk y) (hk : RingHom.ker (wcLdnmTvRho g s y e) = Ideal.span {x₀}) :
    ∃ (U : Y.Opens) (hU : y ∈ U) (φ : Γ(Y, U)), U ≤ V ∧
      (∀ (x : Y) (hx : x ∈ U), x ∈ Set.range g ↔
        (Y.presheaf.germ U x hx).hom φ ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk x)) ∧
      Ideal.span {(Y.presheaf.germ U y hU).hom φ} = Ideal.span {x₀} :=
by
  classical

  have s4 : ∀ (R L : Type u) [CommRing R] [IsNoetherianRing R] [CommRing L] [Algebra R L]
      (P : Ideal R) [P.IsPrime] [IsLocalization.AtPrime L P] (𝔞 : Ideal R) (x₀ : L),
      Ideal.map (algebraMap R L) 𝔞 = Ideal.span {x₀} →
      ∃ φ₀ ∈ 𝔞, ∃ θ ∉ P, (∀ a ∈ 𝔞, θ * a ∈ Ideal.span {φ₀}) ∧
        Ideal.span {algebraMap R L φ₀} = Ideal.span {x₀} := by
    intro R L _ _ _ _ P _ _ 𝔞 x₀ h
    have hx : x₀ ∈ Ideal.map (algebraMap R L) 𝔞 := h ▸ Ideal.mem_span_singleton_self x₀
    obtain ⟨⟨⟨φ₀, hφ₀⟩, σ⟩, hφσ⟩ := (IsLocalization.mem_map_algebraMap_iff P.primeCompl L).mp hx
    simp only at hφσ
    have hspan : Ideal.span {algebraMap R L φ₀} = Ideal.span {x₀} := by
      rw [← hφσ]
      exact Ideal.span_singleton_mul_right_unit (IsLocalization.map_units L σ) x₀
    have key : ∀ b ∈ 𝔞, ∃ t : P.primeCompl, (t : R) * b ∈ Ideal.span {φ₀} := by
      intro b hb
      have hb' : algebraMap R L b ∈ Ideal.span {algebraMap R L φ₀} := by
        rw [hspan, ← h]; exact Ideal.mem_map_of_mem _ hb
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hb'
      obtain ⟨⟨c₁, τ⟩, hcτ⟩ := IsLocalization.surj P.primeCompl c
      simp only at hcτ
      have h2 : algebraMap R L ((τ : R) * b) = algebraMap R L (c₁ * φ₀) := by
        rw [map_mul, map_mul, ← hc, ← hcτ]; ring
      obtain ⟨τ', hτ'⟩ := (IsLocalization.eq_iff_exists P.primeCompl L).mp h2
      refine ⟨τ' * τ, ?_⟩
      rw [Submonoid.coe_mul, mul_assoc, hτ']
      exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self φ₀))
    obtain ⟨G, hG⟩ := (IsNoetherian.noetherian 𝔞 : 𝔞.FG)
    choose! t ht using key
    refine ⟨φ₀, hφ₀, ∏ b ∈ G, (t b : R), ?_, ?_, hspan⟩
    · have hmem : ∏ b ∈ G, (t b : R) ∈ P.primeCompl := Submonoid.prod_mem _ (fun b _ => (t b).2)
      exact hmem
    · intro a ha
      rw [← hG] at ha
      refine Submodule.span_induction ?_ ?_ ?_ ?_ ha
      · intro b hb
        have hbG : b ∈ G := hb
        have hb𝔞 : b ∈ 𝔞 := hG ▸ Submodule.subset_span hb
        rw [← Finset.mul_prod_erase G (fun b => (t b : R)) hbG]
        have e1 : ((t b : R) * ∏ x ∈ G.erase b, (t x : R)) * b =
            (∏ x ∈ G.erase b, (t x : R)) * ((t b : R) * b) := by ring
        rw [e1]
        exact Ideal.mul_mem_left _ _ (ht b hb𝔞)
      · simp
      · intro x y _ _ hx hy
        rw [mul_add]
        exact Ideal.add_mem _ hx hy
      · intro r x _ hx
        rw [smul_eq_mul, mul_left_comm]
        exact Ideal.mul_mem_left _ r hx

  have s3 : ∀ (U : Y.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen (g ⁻¹ᵁ U))
      (hsurj : Function.Surjective (g.app U).hom) (s : S) (hs : g s ∈ U),
      RingHom.ker (g.stalkMap s).hom =
        Ideal.map (Y.presheaf.germ U (g s) hs).hom (RingHom.ker (g.app U).hom) := by
    intro U hU hU' hsurj s hs
    have hs' : s ∈ g ⁻¹ᵁ U := hs
    letI : Algebra Γ(Y, U) (Y.presheaf.stalk (g s)) := (Y.presheaf.germ U (g s) hs).hom.toAlgebra
    letI : Algebra Γ(S, g ⁻¹ᵁ U) (S.presheaf.stalk s) :=
      (S.presheaf.germ (g ⁻¹ᵁ U) s hs').hom.toAlgebra
    haveI : IsLocalization.AtPrime (Y.presheaf.stalk (g s)) (hU.primeIdealOf ⟨g s, hs⟩).asIdeal :=
      hU.isLocalization_stalk ⟨g s, hs⟩
    haveI : IsLocalization.AtPrime (S.presheaf.stalk s) (hU'.primeIdealOf ⟨s, hs'⟩).asIdeal :=
      hU'.isLocalization_stalk ⟨s, hs'⟩
    have hc : ∀ r, (g.stalkMap s).hom ((Y.presheaf.germ U (g s) hs).hom r) =
        (S.presheaf.germ (g ⁻¹ᵁ U) s hs').hom ((g.app U).hom r) :=
      fun r => Scheme.Hom.germ_stalkMap_apply g U s hs r
    apply le_antisymm
    · intro ξ hξ
      rw [RingHom.mem_ker] at hξ
      obtain ⟨⟨r, t⟩, hrt⟩ := IsLocalization.surj (hU.primeIdealOf ⟨g s, hs⟩).asIdeal.primeCompl ξ
      simp only at hrt
      have h0 : algebraMap Γ(S, g ⁻¹ᵁ U) (S.presheaf.stalk s) ((g.app U).hom r) = 0 := by
        change (S.presheaf.germ (g ⁻¹ᵁ U) s hs').hom ((g.app U).hom r) = 0
        rw [← hc]
        change (g.stalkMap s).hom (algebraMap Γ(Y, U) (Y.presheaf.stalk (g s)) r) = 0
        rw [← hrt, map_mul, hξ, zero_mul]
      obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff
        (hU'.primeIdealOf ⟨s, hs'⟩).asIdeal.primeCompl _ _).mp h0
      obtain ⟨u, hu⟩ := hsurj (m : Γ(S, g ⁻¹ᵁ U))
      have huP : u ∈ (hU.primeIdealOf ⟨g s, hs⟩).asIdeal.primeCompl := by
        intro huP
        have h1 : ¬ IsUnit (algebraMap Γ(Y, U) (Y.presheaf.stalk (g s)) u) := by
          rw [IsLocalization.AtPrime.isUnit_to_map_iff _ (hU.primeIdealOf ⟨g s, hs⟩).asIdeal]
          exact fun h => h huP
        apply h1
        apply isUnit_of_map_unit (g.stalkMap s).hom
        change IsUnit ((g.stalkMap s).hom ((Y.presheaf.germ U (g s) hs).hom u))
        rw [hc, hu]
        change IsUnit (algebraMap Γ(S, g ⁻¹ᵁ U) (S.presheaf.stalk s) (m : Γ(S, g ⁻¹ᵁ U)))
        exact IsLocalization.map_units _ m
      have hur : u * r ∈ RingHom.ker (g.app U).hom := by
        rw [RingHom.mem_ker, map_mul, hu, hm]
      have hut : IsUnit (algebraMap Γ(Y, U) (Y.presheaf.stalk (g s)) (u * t)) :=
        IsLocalization.map_units _ (⟨u, huP⟩ * t : (hU.primeIdealOf ⟨g s, hs⟩).asIdeal.primeCompl)
      refine (Ideal.unit_mul_mem_iff_mem _ hut).mp ?_
      have e2 : algebraMap Γ(Y, U) (Y.presheaf.stalk (g s)) (u * t) * ξ =
          (Y.presheaf.germ U (g s) hs).hom (u * r) := by
        rw [map_mul, mul_assoc, mul_comm _ ξ, hrt, ← map_mul]
        rfl
      rw [e2]
      exact Ideal.mem_map_of_mem _ hur
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, RingHom.mem_ker, hc, RingHom.mem_ker.mp ha, map_zero]

  have s2 : ∀ (U : Y.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen (g ⁻¹ᵁ U))
      (hsurj : Function.Surjective (g.app U).hom) (x : Y) (hx : x ∈ U),
      x ∈ Set.range g ↔ ∀ a ∈ RingHom.ker (g.app U).hom,
        (Y.presheaf.germ U x hx).hom a ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk x) := by
    intro U hU hU' hsurj x hx
    have hcomm : ∀ q : Spec Γ(S, g ⁻¹ᵁ U),
        hU.fromSpec (Spec.map (g.app U) q) = g (hU'.fromSpec q) := by
      intro q
      have h1 := IsAffineOpen.SpecMap_appLE_fromSpec g hU hU' le_rfl
      rw [Scheme.Hom.appLE_eq_app] at h1
      rw [← Scheme.Hom.comp_apply, h1, Scheme.Hom.comp_apply]
    have key : x ∈ Set.range g ↔ x ∈ hU.fromSpec ''
        PrimeSpectrum.zeroLocus (RingHom.ker (g.app U).hom : Set Γ(Y, U)) := by
      rw [← range_comap_of_surjective _ _ hsurj]
      constructor
      · rintro ⟨s', rfl⟩
        have hs' : s' ∈ (g ⁻¹ᵁ U : Set S) := hx
        rw [← hU'.range_fromSpec] at hs'
        obtain ⟨q, rfl⟩ := hs'
        exact ⟨_, ⟨q, rfl⟩, hcomm q⟩
      · rintro ⟨_, ⟨q, rfl⟩, rfl⟩
        exact ⟨_, (hcomm q).symm⟩
    rw [key, hU.fromSpec_image_zeroLocus, Set.mem_inter_iff, Scheme.mem_zeroLocus_iff]
    constructor
    · rintro ⟨h, -⟩ a ha
      have h3 := h a ha
      rw [Scheme.mem_basicOpen _ _ _ hx] at h3
      exact (IsLocalRing.mem_maximalIdeal _).mpr h3
    · intro h
      refine ⟨fun a ha hxa => ?_, hx⟩
      rw [Scheme.mem_basicOpen _ _ _ hx] at hxa
      exact (IsLocalRing.mem_maximalIdeal _).mp (h a ha) hxa

  have s1 : ∀ (y' : Y) (hyV' : y' ∈ V),
      ∃ V₁ : Y.Opens, y' ∈ V₁ ∧ V₁ ≤ V ∧ IsAffineOpen V₁ ∧ IsAffineOpen (g ⁻¹ᵁ V₁) ∧
        Function.Surjective (g.app V₁).hom := by
    intro y' hyV'
    obtain ⟨hAff, -⟩ := isClosedImmersion_iff_isAffineHom.mp hV
    have hmem : (⟨y', hyV'⟩ : (V : Scheme)) ∈ (⊤ : (V : Scheme).Opens) := trivial
    obtain ⟨W, hW, hyW, -⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens (V : Scheme)) hmem
    have hy1 : y' ∈ V.ι ''ᵁ W := by
      rw [← SetLike.mem_coe, Scheme.Hom.coe_image]
      exact ⟨⟨y', hyV'⟩, hyW, rfl⟩
    refine ⟨V.ι ''ᵁ W, hy1, V.ι_image_le W,
      (show IsAffineOpen W from hW).image_of_isOpenImmersion V.ι, ?_, ?_⟩
    · rw [← image_morphismRestrict_preimage g V W]
      haveI := hAff
      exact (IsAffineHom.isAffine_preimage W hW).image_of_isOpenImmersion _
    · haveI := hV
      have h1 := Scheme.Hom.app_surjective (g ∣_ V) W hW
      rw [morphismRestrict_app] at h1
      have key : ∀ {A : CommRingCat} (O₁ O₂ : S.Opens) (h : O₂ = O₁)
          (f : A ⟶ S.presheaf.obj (Opposite.op O₁)),
          Function.Surjective (ConcreteCategory.hom (f ≫ S.presheaf.map (eqToHom h).op)) →
            Function.Surjective (ConcreteCategory.hom f) := by
        intro A O₁ O₂ h f hf
        subst h
        simpa using hf
      exact key _ _ _ _ h1

  subst e
  have hρ : wcLdnmTvRho g s (g s) rfl = (g.stalkMap s).hom := by
    unfold wcLdnmTvRho
    rw [TopCat.Presheaf.stalkSpecializes_refl]
    simp
  rw [hρ] at hk
  obtain ⟨V₁, hyV₁, hV₁V, hV₁, hV₁', hsurj⟩ := s1 (g s) hyV
  haveI : IsNoetherianRing Γ(Y, V₁) := IsLocallyNoetherian.component_noetherian ⟨V₁, hV₁⟩
  have h3 := s3 V₁ hV₁ hV₁' hsurj s hyV₁
  rw [hk] at h3
  letI : Algebra Γ(Y, V₁) (Y.presheaf.stalk (g s)) :=
    (Y.presheaf.germ V₁ (g s) hyV₁).hom.toAlgebra
  haveI : IsLocalization.AtPrime (Y.presheaf.stalk (g s))
      (hV₁.primeIdealOf ⟨g s, hyV₁⟩).asIdeal := hV₁.isLocalization_stalk ⟨g s, hyV₁⟩
  obtain ⟨φ₀, hφ₀, θ, hθP, hθ, hspan⟩ := s4 Γ(Y, V₁) (Y.presheaf.stalk (g s))
    (hV₁.primeIdealOf ⟨g s, hyV₁⟩).asIdeal (RingHom.ker (g.app V₁).hom) x₀ h3.symm
  have hyU : g s ∈ Y.basicOpen θ := by
    rw [Scheme.mem_basicOpen _ _ _ hyV₁]
    exact (IsLocalization.AtPrime.isUnit_to_map_iff (Y.presheaf.stalk (g s)) _ θ).mpr hθP
  refine ⟨Y.basicOpen θ, hyU, (Y.presheaf.map (homOfLE (Y.basicOpen_le θ)).op).hom φ₀,
    (Y.basicOpen_le θ).trans hV₁V, ?_, ?_⟩
  · intro x hx
    have hxV₁ : x ∈ V₁ := Y.basicOpen_le θ hx
    rw [TopCat.Presheaf.germ_res_apply, s2 V₁ hV₁ hV₁' hsurj x hxV₁]
    have hθu : IsUnit ((Y.presheaf.germ V₁ x hxV₁).hom θ) :=
      (Scheme.mem_basicOpen _ _ _ hxV₁).mp hx
    constructor
    · intro h
      exact h φ₀ hφ₀
    · intro h a ha
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (hθ a ha)
      rw [← Ideal.unit_mul_mem_iff_mem _ hθu, ← map_mul, ← hc, map_mul]
      exact Ideal.mul_mem_left _ _ h
  · rw [TopCat.Presheaf.germ_res_apply]
    exact hspan

theorem wc_ldnm_tv_spread (K : Type u) [Field K] (m : ℕ) {Z : Scheme.{u}}
    (h : Z ⟶ wcProjK K m) [IsProper h] (NS : Set Z) (hNS : IsClosed NS) (z : Z) (hz : z ∈ NS)
    (y : wcProjK K m) (e : h z = y) (hfib : ∀ x ∈ NS, h x = y → x = z)
    (W : Z.Opens) (hW : IsAffineOpen W) (hzW : z ∈ W) (r : ℕ) (ψ : Fin r → Γ(Z, W))
    (hψ : ∀ (x : Z) (hx : x ∈ W), x ∈ NS ↔
      ∀ j, (Z.presheaf.germ W x hx).hom (ψ j) ∈ IsLocalRing.maximalIdeal (Z.presheaf.stalk x))
    (hm : IsLocalRing.maximalIdeal (Z.presheaf.stalk z) ≤
      Ideal.span (Set.range fun j => (Z.presheaf.germ W z hzW).hom (ψ j)) ⊔
        Ideal.map (wcLdnmTvRho h z y e) (IsLocalRing.maximalIdeal ((wcProjK K m).presheaf.stalk y)))
    (hres : ∀ a : Z.presheaf.stalk z, ∃ b : (wcProjK K m).presheaf.stalk y,
      a - wcLdnmTvRho h z y e b ∈ IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) :
    Function.Surjective ((Ideal.Quotient.mk (Ideal.span (Set.range fun j =>
        (Z.presheaf.germ W z hzW).hom (ψ j)))).comp (wcLdnmTvRho h z y e)) ∧
    ∀ x₀ : (wcProjK K m).presheaf.stalk y,
      RingHom.ker ((Ideal.Quotient.mk (Ideal.span (Set.range fun j =>
        (Z.presheaf.germ W z hzW).hom (ψ j)))).comp (wcLdnmTvRho h z y e)) = Ideal.span {x₀} →
      ∃ (U : (wcProjK K m).Opens) (hU : y ∈ U) (φ : Γ(wcProjK K m, U)),
        (∀ (x : wcProjK K m) (hx : x ∈ U), x ∈ h '' NS ↔
          ((wcProjK K m).presheaf.germ U x hx).hom φ ∈
            IsLocalRing.maximalIdeal ((wcProjK K m).presheaf.stalk x)) ∧
        Ideal.span {((wcProjK K m).presheaf.germ U y hU).hom φ} = Ideal.span {x₀} :=
by
  classical

  haveI := wc_pp_proper K m
  haveI : IsLocallyNoetherian (wcProjK K m) :=
    LocallyOfFiniteType.isLocallyNoetherian (wcProjKStr K m)

  have hcomp : ∀ {A B C : Scheme.{u}} (f₁ : A ⟶ B) (f₂ : B ⟶ C) (a : A) (b : B) (c : C)
      (e₁ : f₁ a = b) (e₂ : f₂ b = c) (e₃ : (f₁ ≫ f₂) a = c),
      wcLdnmTvRho (f₁ ≫ f₂) a c e₃ = (wcLdnmTvRho f₁ a b e₁).comp (wcLdnmTvRho f₂ b c e₂) := by
    intro A B C f₁ f₂ a b c e₁ e₂ e₃
    subst e₁ e₂
    simp [wcLdnmTvRho, Scheme.Hom.stalkMap_comp]
    try rfl
  have hloc : ∀ {Z' Y' : Scheme.{u}} (h' : Z' ⟶ Y') (z' : Z') (y' : Y') (e' : h' z' = y'),
      IsLocalHom (wcLdnmTvRho h' z' y' e') := by
    intro Z' Y' h' z' y' e'
    subst e'
    unfold wcLdnmTvRho
    rw [TopCat.Presheaf.stalkSpecializes_refl]
    simpa using (inferInstance : IsLocalHom (h'.stalkMap z').hom)
  have hsurjT : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (a : A) (b : B) (e' : f a = b),
      Function.Surjective (f.stalkMap a).hom → Function.Surjective (wcLdnmTvRho f a b e') := by
    intro A B f a b e' hs
    subst e'
    unfold wcLdnmTvRho
    rw [TopCat.Presheaf.stalkSpecializes_refl]
    simpa using hs

  obtain ⟨U₀, S, jS, s₀, ej, hyU₀, hLFT, hprop, hrange, hfibS, hπsurj, hπker⟩ :=
    wc_tvs_ns_subscheme h NS hNS z hz y e hfib W hW hzW r ψ hψ
  have eg : (jS ≫ h) s₀ = y := by rw [Scheme.Hom.comp_apply, ej, e]
  have hρg : wcLdnmTvRho (jS ≫ h) s₀ y eg =
      (wcLdnmTvRho jS s₀ z ej).comp (wcLdnmTvRho h z y e) := hcomp jS h s₀ z y ej e eg
  haveI := hloc jS s₀ z ej
  haveI := hloc h z y e
  haveI := hloc (jS ≫ h) s₀ y eg
  have hmapJ : Ideal.map (wcLdnmTvRho jS s₀ z ej)
      (Ideal.span (Set.range fun j => (Z.presheaf.germ W z hzW).hom (ψ j))) = ⊥ :=
    (Ideal.map_eq_bot_iff_le_ker _).mpr hπker.ge

  have hm' : Ideal.map (wcLdnmTvRho (jS ≫ h) s₀ y eg)
      (IsLocalRing.maximalIdeal ((wcProjK K m).presheaf.stalk y)) =
      IsLocalRing.maximalIdeal (S.presheaf.stalk s₀) := by
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx
      exact fun hu => hx (isUnit_of_map_unit _ _ hu)
    · intro a' ha'
      obtain ⟨a, rfl⟩ := hπsurj a'
      have ha : a ∈ IsLocalRing.maximalIdeal (Z.presheaf.stalk z) := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at ha' ⊢
        exact fun hu => ha' (hu.map _)
      have h1 := Ideal.mem_map_of_mem (wcLdnmTvRho jS s₀ z ej) (hm ha)
      rw [Ideal.map_sup, hmapJ, bot_sup_eq, Ideal.map_map, ← hρg] at h1
      exact h1

  have hres' : ∀ a : S.presheaf.stalk s₀, ∃ b : (wcProjK K m).presheaf.stalk y,
      a - wcLdnmTvRho (jS ≫ h) s₀ y eg b ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk s₀) := by
    intro a'
    obtain ⟨a, rfl⟩ := hπsurj a'
    obtain ⟨b, hb⟩ := hres a
    refine ⟨b, ?_⟩
    rw [hρg, RingHom.comp_apply, ← map_sub]
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hb ⊢
    exact fun hu => hb (isUnit_of_map_unit (wcLdnmTvRho jS s₀ z ej) _ hu)

  haveI := hLFT
  obtain ⟨U₁, hyU₁, hU₁₀, hfin⟩ :=
    wc_tvs_finite_near (jS ≫ h) U₀ hprop s₀ y eg hyU₀ hfibS hm' hres'
  obtain ⟨V, hyV, hVU₁, hci⟩ :=
    wc_tvs_closed_imm_of_finite (jS ≫ h) U₁ hfin s₀ y eg hyU₁ hfibS hm' hres'
  have hs₀V : s₀ ∈ (jS ≫ h) ⁻¹ᵁ V := by
    show (jS ≫ h) s₀ ∈ V
    rw [eg]
    exact hyV
  haveI := hci
  have hstalk : Function.Surjective ((jS ≫ h).stalkMap s₀).hom :=
    (RingHom.surjective_respectsIso.arrow_mk_iso_iff
      (morphismRestrictStalkMap (jS ≫ h) V ⟨s₀, hs₀V⟩)).mp
      (SurjectiveOnStalks.stalkMap_surjective _ _)
  have hρgsurj : Function.Surjective (wcLdnmTvRho (jS ≫ h) s₀ y eg) :=
    hsurjT _ _ _ _ hstalk
  refine ⟨?_, ?_⟩
  ·
    intro q
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective q
    obtain ⟨b, hb⟩ := hρgsurj (wcLdnmTvRho jS s₀ z ej a)
    refine ⟨b, ?_⟩
    have hb' : wcLdnmTvRho jS s₀ z ej (wcLdnmTvRho h z y e b) = wcLdnmTvRho jS s₀ z ej a := by
      rw [← hb, hρg, RingHom.comp_apply]
    rw [RingHom.comp_apply, Ideal.Quotient.eq, ← hπker, RingHom.mem_ker, map_sub, hb', sub_self]
  ·
    intro x₀ hx₀
    have hker : RingHom.ker (wcLdnmTvRho (jS ≫ h) s₀ y eg) = Ideal.span {x₀} := by
      rw [← hx₀]
      ext b
      rw [RingHom.mem_ker, RingHom.mem_ker, hρg, RingHom.comp_apply, RingHom.comp_apply,
        Ideal.Quotient.eq_zero_iff_mem, ← hπker, RingHom.mem_ker]
    obtain ⟨U, hU, φ, hUV, hG1, hG2⟩ :=
      wc_tvs_principal_spread (jS ≫ h) V hci s₀ y eg hyV x₀ hker
    refine ⟨U, hU, φ, ?_, hG2⟩
    intro x hx
    rw [← hG1 x hx, hrange]
    have hxU₀ : x ∈ U₀ := hU₁₀ (hVU₁ (hUV hx))
    constructor
    · intro hx'
      exact ⟨hx', hxU₀⟩
    · intro hx'
      exact hx'.1

theorem wc_ldnm_tv_principal (R A O : Type u) [CommRing R] [CommRing A] [CommRing O]
    [IsRegularLocalRing R] [IsRegularLocalRing A] [IsRegularLocalRing O]
    (ρ : R →+* A) [IsLocalHom ρ] (lam : R →+* O) (hlam : Function.Surjective lam)
    (M n : ℕ) (hR : ringKrullDim R = ((M : ℕ) : WithBot ℕ∞))
    (hA : ringKrullDim A = ((n + M - 1 : ℕ) : WithBot ℕ∞))
    (hO : ringKrullDim O = ((1 : ℕ) : WithBot ℕ∞))
    (ψ : Fin n → A) (hψ : ∀ j, ψ j ∈ IsLocalRing.maximalIdeal A)
    (hm : IsLocalRing.maximalIdeal A ≤
      Ideal.span (Set.range ψ) ⊔ Ideal.map ρ (RingHom.ker lam))
    (hsurj : Function.Surjective ((Ideal.Quotient.mk (Ideal.span (Set.range ψ))).comp ρ)) :
    ∃ x₀ : R, RingHom.ker ((Ideal.Quotient.mk (Ideal.span (Set.range ψ))).comp ρ) =
        Ideal.span {x₀} ∧
      IsLocalRing.maximalIdeal O = Ideal.span {lam x₀} :=
by
  classical

  have hQR : ∀ (T : Type u) [CommRing T] [IsRegularLocalRing T] (r : ℕ)
      (x : Fin r → IsLocalRing.maximalIdeal T),
      LinearIndependent (IsLocalRing.ResidueField T)
        (fun i => (IsLocalRing.maximalIdeal T).toCotangent (x i)) →
      IsRegularLocalRing (T ⧸ Ideal.span (Set.range (fun i => (x i : T)))) ∧
        ringKrullDim (T ⧸ Ideal.span (Set.range (fun i => (x i : T)))) + r = ringKrullDim T := by
    intro T _ _ r x hli
    set J' := Ideal.span (Set.range (fun i => (x i : T))) with hJ'
    set d := Module.finrank (IsLocalRing.ResidueField T) (IsLocalRing.CotangentSpace T) with hd
    have hdR : ((d : ℕ) : WithBot ℕ∞) = ringKrullDim T := by
      rw [hd, ← IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace]
      exact IsRegularLocalRing.spanFinrank_maximalIdeal
    have hrd : r ≤ d := by
