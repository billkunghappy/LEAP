        rw [Preadditive.comp_nsmul, Category.comp_id, h1, hI0, Limits.zero_comp]
      let j := Limits.kernel.lift (ℓ • 𝟙 E) ι hιn
      have hj : j ≫ Limits.kernel.ι (ℓ • 𝟙 E) = ι := Limits.kernel.lift_ι _ _ _
      have : Mono j := mono_of_mono_fac hj
      have hK0 : ℓ • 𝟙 (Limits.kernel (ℓ • 𝟙 E)) = 0 := by
        apply (cancel_mono (Limits.kernel.ι (ℓ • 𝟙 E))).1
        have h1 : Limits.kernel.ι (ℓ • 𝟙 E) ≫ (ℓ • 𝟙 E) = ℓ • Limits.kernel.ι (ℓ • 𝟙 E) := by
          rw [Preadditive.comp_nsmul, Category.comp_id]
        rw [Preadditive.nsmul_comp, Category.id_comp, ← h1, Limits.kernel.condition, Limits.zero_comp]
      obtain ⟨M', ⟨β⟩⟩ := hess _ hK0
      let g := Φ.preimage (j ≫ β.inv)
      have hg : Φ.map g = j ≫ β.inv := Φ.map_preimage _
      have : Mono g := Φ.mono_of_mono_map (by rw [hg]; infer_instance)
      let rr := Injective.factorThru (𝟙 I) g
      have hr : g ≫ rr = 𝟙 I := Injective.comp_factorThru _ _
      let ρ := β.inv ≫ Φ.map rr
      have hjρ : j ≫ ρ = 𝟙 _ := by
        calc j ≫ ρ = (j ≫ β.inv) ≫ Φ.map rr := by simp only [ρ, Category.assoc]
          _ = Φ.map (g ≫ rr) := by rw [Φ.map_comp, hg]
          _ = 𝟙 _ := by rw [hr, Φ.map_id]
      have hEinj : Injective ((wcEtPush r).obj E) := by
        obtain ⟨L, ⟨adj⟩, hL, _⟩ := wc_et_push_left_adjoint r
        haveI := hL
        exact adj.map_injective E inferInstance
      haveI := hEinj
      have hepi : Epi ((wcEtPush r).map (ℓ • 𝟙 E)) := by
        rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
        exact s1 T _
      have hK := hker E hepi k
      rw [Limits.IsZero.iff_id_eq_zero]
      calc 𝟙 _ = ((wcEtPush r).rightDerived (k + 1)).map (𝟙 (Φ.obj I)) :=
            (CategoryTheory.Functor.map_id _ _).symm
        _ = ((wcEtPush r).rightDerived (k + 1)).map j ≫
              ((wcEtPush r).rightDerived (k + 1)).map ρ := by
            rw [← hjρ, CategoryTheory.Functor.map_comp]
        _ = 0 := by
            rw [hK.eq_of_tgt (((wcEtPush r).rightDerived (k + 1)).map j) 0, Limits.zero_comp]
    obtain ⟨βc⟩ := wc_et_toSheaf_pushforward_iso r ℓ D
    have hiso := wc_rightDerived_exact_conj_iso
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ) (wcEtPush r)
      (SheafOfModules.toSheaf (wcEtZModRing Q ℓ)) (SheafOfModules.toSheaf (wcEtZModRing T ℓ))
      ⟨βc⟩ hacyc
    obtain ⟨Θ⟩ := hiso (SheafOfModules.unit (wcEtZModRing Q ℓ)) n
    obtain ⟨e⟩ := wc_et_zmod_unit_toSheaf_iso Q ℓ
    exact ⟨(SheafOfModules.toSheaf (wcEtZModRing T ℓ)).mapIso
        (I.isoRightDerivedObj
          (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ) n).symm ≪≫
      Θ.symm ≪≫ ((wcEtPush r).rightDerived n).mapIso e ≪≫ J.isoRightDerivedObj (wcEtPush r) n⟩

  intro A _ Y f m hm Ω _ _ z D I x hM q hq
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology (Limits.pullback f z)) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives (Limits.pullback f z)
  let J := InjectiveResolution.of ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback f z))
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
  obtain ⟨θ⟩ := L3 (Limits.pullback.fst f z) m hm D I J q

  haveI hhaff : IsAffineHom (Limits.pullback.fst f z) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback f z).flip inferInstance
  obtain ⟨B, _, _, _, Λ, _, _, W', φ, a, e, hinit, haff, hφ, hφa, hlim, he, hcomp⟩ :=
    wc_et_geom_strict_henselization x
  have hd : wcHalShData x B Λ W' φ a := ⟨hinit, haff, hφ, hφa, hlim, e, he, hcomp⟩
  obtain ⟨E₁⟩ := wc_et_stalk_push_homology (Limits.pullback.fst f z) x Λ W' hinit J.cocomplex q
  obtain ⟨E₂⟩ := wc_et_limit_push_homology_affine (Limits.pullback.fst f z) B Λ
    (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt Y x)) (Scheme.Etale.forget Y))
    φ a haff hφ hφa hlim m J q
  obtain ⟨E₃⟩ := wc_et_coh_iso_invariance
    ((Limits.pullbackSymmetry (Limits.pullback.fst f z) a).hom ≫
      (Limits.pullbackRightPullbackFstIso f z a).hom) m q
  haveI := hM B Λ W' φ a hd q hq
  haveI hS : Subsingleton ((wcEtStalk Y x).obj ((((wcEtPush (Limits.pullback.fst f z)).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj J.cocomplex).homology q)) :=
    (E₁.trans (E₂.trans E₃.symm)).subsingleton

  let ψ := (wcEtStalk Y x).mapIso θ
  exact (Equiv.ofBijective (⇑ψ.hom) (ConcreteCategory.bijective_of_isIso ψ.hom)).subsingleton

theorem wc_shens_equal_char_alg_closed_subfield : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)], (∀ r : ℕ, r.Prime → (r : IsLocalRing.ResidueField A) = 0 → (r : A) = 0) → ∃ (K : Type u) (_ : Field K) (_ : IsAlgClosed K), Nonempty (K →+* A) :=
by
  intro A _ _ _ hEC
  classical

  have s1 : ∃ (P : Type) (_ : Field P) (_ : PerfectField P), Nonempty (P →+* A) := by
    rcases CharP.char_is_prime_or_zero (IsLocalRing.ResidueField A)
        (ringChar (IsLocalRing.ResidueField A)) with hp | h0
    · haveI : Fact (ringChar (IsLocalRing.ResidueField A)).Prime := ⟨hp⟩
      have hpA : ((ringChar (IsLocalRing.ResidueField A) : ℕ) : A) = 0 :=
        hEC _ hp (ringChar.Nat.cast_ringChar)
      haveI : CharP A (ringChar (IsLocalRing.ResidueField A)) := ⟨fun x => by
        constructor
        · intro hx
          apply ringChar.dvd
          have := congrArg (IsLocalRing.residue A) hx
          rwa [map_natCast, map_zero] at this
        · rintro ⟨t, rfl⟩
          rw [Nat.cast_mul, hpA, zero_mul]⟩
      exact ⟨ZMod (ringChar (IsLocalRing.ResidueField A)), inferInstance, inferInstance,
        ⟨ZMod.castHom (dvd_refl _) A⟩⟩
    · haveI : CharP (IsLocalRing.ResidueField A) 0 := by
        rw [← h0]; exact ringChar.charP _
      haveI : CharZero (IsLocalRing.ResidueField A) := CharP.charP_to_charZero _
      have hu : ∀ y : nonZeroDivisors ℤ, IsUnit ((Int.castRingHom A) (y : ℤ)) := by
        intro y
        have hy0 : (y : ℤ) ≠ 0 := nonZeroDivisors.coe_ne_zero y
        have hres : IsLocalRing.residue A ((Int.castRingHom A) (y : ℤ)) ≠ 0 := by
          rw [eq_intCast, map_intCast]
          exact_mod_cast hy0
        by_contra hnu
        apply hres
        exact (IsLocalRing.residue_eq_zero_iff _).mpr ((IsLocalRing.mem_maximalIdeal _).mpr hnu)
      exact ⟨ℚ, inferInstance, inferInstance,
        ⟨IsLocalization.lift (M := nonZeroDivisors ℤ) (S := ℚ) hu⟩⟩
  obtain ⟨P, _, _, ⟨ι⟩⟩ := s1
  letI : Algebra P A := ι.toAlgebra

  let Good : Subring A → Prop := fun S => (∀ c : P, algebraMap P A c ∈ S) ∧
    (∀ x ∈ S, x ≠ 0 → ∃ y ∈ S, x * y = 1) ∧ (∀ x ∈ S, IsIntegral P x)
  have hS0 : Good (algebraMap P A).range := by
    refine ⟨fun c => ⟨c, rfl⟩, ?_, ?_⟩
    · rintro x ⟨c, rfl⟩ hx
      have hc : c ≠ 0 := by rintro rfl; exact hx (map_zero _)
      exact ⟨algebraMap P A c⁻¹, ⟨c⁻¹, rfl⟩, by rw [← map_mul, mul_inv_cancel₀ hc, map_one]⟩
    · rintro x ⟨c, rfl⟩
      exact isIntegral_algebraMap
  obtain ⟨L, -, hLmax⟩ := zorn_le_nonempty₀ {S : Subring A | Good S} (by
    intro c hc hchain y hy
    have hne : c.Nonempty := ⟨y, hy⟩
    have hdir : DirectedOn (· ≤ ·) c := hchain.directedOn
    refine ⟨sSup c, ⟨fun p => le_sSup hy ((hc hy).1 p), ?_, ?_⟩, fun z hz => le_sSup hz⟩
    · intro x hx hx0
      obtain ⟨S, hS, hxS⟩ := (Subring.mem_sSup_of_directedOn hne hdir).mp hx
      obtain ⟨w, hw, hxw⟩ := (hc hS).2.1 x hxS hx0
      exact ⟨w, le_sSup hS hw, hxw⟩
    · intro x hx
      obtain ⟨S, hS, hxS⟩ := (Subring.mem_sSup_of_directedOn hne hdir).mp hx
      exact (hc hS).2.2 x hxS) _ hS0
  have hLgood : Good L := hLmax.prop
  have hLmax' : ∀ L' : Subring A, Good L' → L ≤ L' → L' ≤ L :=
    fun L' h1 h2 => hLmax.le_of_ge h1 h2
  obtain ⟨hL1, hL2, hL3⟩ := hLgood

  have hfield : IsField L := by
    refine ⟨exists_pair_ne L, mul_comm, ?_⟩
    intro b hb
    have hb' : (b : A) ≠ 0 := fun h => hb (Subtype.ext h)
    obtain ⟨y, hy, hby⟩ := hL2 b b.2 hb'
    exact ⟨⟨y, hy⟩, Subtype.ext hby⟩
  letI : Field L := hfield.toField

  have hcrux : ∀ g : Polynomial L, g.Monic → Irreducible g → ∀ a : A,
      Polynomial.eval₂ L.subtype a g = 0 → a ∈ L := by
    intro g hgm hgi a ha
    haveI : Fact (Irreducible g) := ⟨hgi⟩
    let φ : AdjoinRoot g →+* A := AdjoinRoot.lift L.subtype a ha
    let R := integralClosure P A
    have hLR : ∀ x ∈ L, x ∈ R := fun x hx => (mem_integralClosure_iff _ _).mpr (hL3 x hx)
    let ψ : L →+* R := L.subtype.codRestrict R (fun x => hLR x x.2)
    have hψ : (algebraMap R A).comp ψ = L.subtype := by ext x; rfl
    have haR : a ∈ R := by
      rw [mem_integralClosure_iff]
      have hint : IsIntegral R a :=
        ⟨g.map ψ, hgm.map ψ, by rw [Polynomial.eval₂_map, hψ]; exact ha⟩
      exact isIntegral_trans a hint
    let aR : R := ⟨a, haR⟩
    have hφR : ∀ z, φ z ∈ R := by
      intro z
      obtain ⟨h, rfl⟩ := AdjoinRoot.mk_surjective z
      have e : φ (AdjoinRoot.mk g h) = algebraMap R A (Polynomial.eval₂ ψ aR h) := by
        rw [Polynomial.hom_eval₂, hψ]
        show AdjoinRoot.lift L.subtype a ha (AdjoinRoot.mk g h) = _
        rw [AdjoinRoot.lift_mk]
        rfl
      rw [e]
      exact (Polynomial.eval₂ ψ aR h).2
    have hgood' : Good φ.range := by
      refine ⟨fun c => ⟨AdjoinRoot.of g ⟨_, hL1 c⟩, AdjoinRoot.lift_of ha⟩, ?_, ?_⟩
      · rintro x ⟨z, rfl⟩ hx
        have hz : z ≠ 0 := by rintro rfl; exact hx (map_zero φ)
        exact ⟨φ z⁻¹, ⟨z⁻¹, rfl⟩, by rw [← map_mul, mul_inv_cancel₀ hz, map_one]⟩
      · rintro x ⟨z, rfl⟩
        exact (mem_integralClosure_iff _ _).mp (hφR z)
    have hLL' : L ≤ φ.range := fun x hx => ⟨AdjoinRoot.of g ⟨x, hx⟩, AdjoinRoot.lift_of ha⟩
    exact hLmax' _ hgood' hLL' ⟨AdjoinRoot.root g, AdjoinRoot.lift_root ha⟩

  have hsep : ∀ g : Polynomial L, Irreducible g → g.Separable := by
    letI : Algebra P L := ((algebraMap P A).codRestrict L hL1).toAlgebra
    have halg : Algebra.IsAlgebraic P L := by
      refine ⟨fun x => ?_⟩
      let f : L →ₐ[P] A := { L.subtype with commutes' := fun c => rfl }
      have hx : IsIntegral P (f x) := hL3 x x.2
      exact ((isIntegral_algHom_iff f Subtype.val_injective).mp hx).isAlgebraic
    haveI : PerfectField L := Algebra.IsAlgebraic.perfectField (K := P)
    intro g hg
    exact PerfectField.separable_of_irreducible hg

  haveI : IsAlgClosed L := by
    apply IsAlgClosed.of_exists_root
    intro g hgm hgi
    have hgsep := hsep g hgi
    set G : Polynomial A := g.map L.subtype with hG
    have hGm : G.Monic := hgm.map _
    have hGdeg : G.natDegree = g.natDegree := hgm.natDegree_map _
    have hgpos : 0 < g.natDegree := hgi.natDegree_pos
    set Gb := G.map (IsLocalRing.residue A) with hGb
    have hGbsep : Gb.Separable := by
      rw [hGb, hG, Polynomial.map_map]; exact hgsep.map
    have hGbm : Gb.Monic := hGm.map _
    have hGbdeg : Gb.natDegree = g.natDegree := by rw [hGb, hGm.natDegree_map, hGdeg]
    have hGbdeg' : Gb.degree ≠ 0 := by
      rw [Polynomial.degree_eq_natDegree hGbm.ne_zero, hGbdeg]; exact_mod_cast hgpos.ne'
    obtain ⟨ab, hab⟩ := IsSepClosed.exists_root Gb hGbdeg' hGbsep
    obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective ab
    have hresev : ∀ (H : Polynomial A) (x : A), IsLocalRing.residue A (H.eval x) =
        (H.map (IsLocalRing.residue A)).eval (IsLocalRing.residue A x) := by
      intro H x
      rw [Polynomial.eval_map, Polynomial.eval₂_at_apply]
    have h1 : G.eval a₀ ∈ IsLocalRing.maximalIdeal A := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      have e1 : IsLocalRing.residue A (G.eval a₀) = Gb.eval ab := by
        rw [hresev, ha₀, hGb]
      rw [e1]; exact hab
    have h2 : IsUnit ((Polynomial.derivative G).eval a₀) := by
      have e2 : IsLocalRing.residue A ((Polynomial.derivative G).eval a₀) =
          (Polynomial.derivative Gb).eval ab := by
        rw [hresev, ha₀, hGb]
        first
          | exact congrArg (Polynomial.eval ab) (Polynomial.derivative_map G _).symm
          | exact congrArg (Polynomial.eval ab) (Polynomial.derivative_map _ _).symm
          | (rw [Polynomial.derivative_map G])
      have hne : (Polynomial.derivative Gb).eval ab ≠ 0 := by
        have := hGbsep.eval₂_derivative_ne_zero (RingHom.id _)
          (by rw [Polynomial.eval₂_id]; exact hab)
        rwa [Polynomial.eval₂_id] at this
      by_contra hnu
      apply hne
      rw [← e2]
      exact (IsLocalRing.residue_eq_zero_iff _).mpr ((IsLocalRing.mem_maximalIdeal _).mpr hnu)
    obtain ⟨a, haroot, -⟩ := HenselianLocalRing.is_henselian G hGm a₀ h1 h2
    have ha : Polynomial.eval₂ L.subtype a g = 0 := by
      rw [← Polynomial.eval_map]; exact haroot
    have haL := hcrux g hgm hgi a ha
    refine ⟨⟨a, haL⟩, ?_⟩
    apply Subtype.val_injective
    show L.subtype (g.eval ⟨a, haL⟩) = L.subtype 0
    rw [map_zero, ← Polynomial.eval₂_at_apply]
    exact ha
  exact ⟨L, inferInstance, inferInstance, ⟨L.subtype⟩⟩

theorem wc_smooth_local_etale_chart_mvpoly : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)), Smooth f → ∀ (x : Y₀), f x = IsLocalRing.closedPoint A → ∃ (d : ℕ) (U : Y₀.Opens) (ε : (U : Scheme.{u}) ⟶ Spec (.of (MvPolynomial (Fin d) A))), x ∈ U ∧ Etale ε ∧ ε ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A))) = U.ι ≫ f :=
by
  intro A _ _ Y₀ f hf x hx
  have := hf
  obtain ⟨UA, hUA, V, hV, hxV, e, hstd⟩ := Smooth.exists_isStandardSmooth f x
  have h1 : f x ∈ UA := e hxV
  rw [hx] at h1
  have hU : UA = ⊤ := (IsLocalRing.closedPoint_mem_iff (U := UA)).mp h1
  subst hU
  obtain ⟨n, g, hg, hgEt⟩ := hstd.exists_etale_mvPolynomial
  set ρ := Scheme.ΓSpecIso (CommRingCat.of A) with hρ
  set r : A →+* Γ(Spec (.of A), ⊤) := ρ.inv.hom with hr
  set r' : Γ(Spec (.of A), ⊤) →+* A := ρ.hom.hom with hr'
  have hrr' : r'.comp r = RingHom.id A := by
    rw [hr, hr', ← CommRingCat.hom_comp, ρ.inv_hom_id, CommRingCat.hom_id]
  have hr'r : r.comp r' = RingHom.id _ := by
    rw [hr, hr', ← CommRingCat.hom_comp, ρ.hom_inv_id, CommRingCat.hom_id]
  set μ : MvPolynomial (Fin n) A →+* MvPolynomial (Fin n) Γ(Spec (.of A), ⊤) :=
    MvPolynomial.map r with hμ
  have hμbij : Function.Bijective μ := by
    refine Function.bijective_iff_has_inverse.mpr ⟨MvPolynomial.map r', ?_, ?_⟩
    · intro p
      rw [hμ, MvPolynomial.map_map, hrr', MvPolynomial.map_id]
    · intro p
      rw [hμ, MvPolynomial.map_map, hr'r, MvPolynomial.map_id]
  have hμEt : μ.Etale := RingHom.Etale.of_bijective hμbij
  set g' := g.comp μ with hg'
  have hg'Et : g'.Etale := RingHom.Etale.stableUnderComposition μ g hμEt hgEt
  have hstar : g'.comp (algebraMap A (MvPolynomial (Fin n) A)) =
      (f.appLE ⊤ V e).hom.comp r := by
    rw [MvPolynomial.algebraMap_eq]
    ext a
    simp only [RingHom.comp_apply, hg', hμ, MvPolynomial.map_C]
    exact RingHom.congr_fun hg (r a)
  have hSpecEt : Etale (Spec.map (CommRingCat.ofHom g')) :=
    (HasRingHomProperty.Spec_iff (P := @Etale)).mpr hg'Et
  refine ⟨n, V, hV.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom g'), hxV, inferInstance, ?_⟩
  have hring : CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin n) A)) ≫ CommRingCat.ofHom g' =
      ρ.inv ≫ f.appLE ⊤ V e := by
    ext a
    exact RingHom.congr_fun hstar a
  have hρtop : Spec.map ρ.inv = hUA.fromSpec := by
    rw [hρ, ← Scheme.isoSpec_Spec_inv, ← IsAffineOpen.fromSpec_top]
  have key : Spec.map (CommRingCat.ofHom g') ≫
      Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin n) A))) =
      Spec.map (f.appLE ⊤ V e) ≫ hUA.fromSpec := by
    rw [← Spec.map_comp, hring, Spec.map_comp, hρtop]
  rw [Category.assoc, key, IsAffineOpen.SpecMap_appLE_fromSpec f hUA hV e, ← Category.assoc,
    IsAffineOpen.isoSpec_hom_fromSpec]

theorem wcpa_dj_ssm_gf_residue_finite : ∀ {X P : Scheme.{u}} (f : X ⟶ P) [LocallyOfFiniteType f] (x : X), (∀ y : X, f y = f x → x ⤳ y → y = x) → (f.residueFieldMap x).hom.Finite :=
by
  intro X P f _ x h
  have hsq : X.fromSpecResidueField x ≫ f =
      Spec.map (f.residueFieldMap x) ≫ P.fromSpecResidueField (f x) :=
    (Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField f x).symm
  set p₁ := Limits.pullback.fst f (P.fromSpecResidueField (f x)) with hp₁
  set p₂ := Limits.pullback.snd f (P.fromSpecResidueField (f x)) with hp₂
  set ι : Spec (X.residueField x) ⟶ Limits.pullback f (P.fromSpecResidueField (f x)) :=
    Limits.pullback.lift (X.fromSpecResidueField x) (Spec.map (f.residueFieldMap x)) hsq with hι
  have h1 : ι ≫ p₁ = X.fromSpecResidueField x := Limits.pullback.lift_fst _ _ hsq
  have h2 : ι ≫ p₂ = Spec.map (f.residueFieldMap x) := Limits.pullback.lift_snd _ _ hsq
  have hp₁pre : IsPreimmersion p₁ := inferInstance
  have : IsPreimmersion (ι ≫ p₁) := by rw [h1]; infer_instance
  have hιpre : IsPreimmersion ι := IsPreimmersion.of_comp ι p₁
  have hcl : IsClosed (Set.range ι) := by
    rw [Set.range_unique]
    apply isClosed_of_closure_subset
    intro v hv
    have hwv : ι default ⤳ v := specializes_iff_mem_closure.mpr hv
    have ha : p₁ (ι default) = x := by
      have hm : p₁ (ι default) ∈ Set.range (X.fromSpecResidueField x) := by
        refine ⟨default, ?_⟩
        rw [← Scheme.Hom.comp_apply, h1]
      rw [Scheme.range_fromSpecResidueField] at hm
      exact hm
    have hb : x ⤳ p₁ v := by
      have := hwv.map p₁.continuous
      rwa [ha] at this
    have hc : f (p₁ v) = f x := by
      have hm : f (p₁ v) ∈ Set.range (P.fromSpecResidueField (f x)) := by
        refine ⟨p₂ v, ?_⟩
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hp₁, hp₂,
          Limits.pullback.condition]
      rw [Scheme.range_fromSpecResidueField] at hm
      exact hm
    have hd : p₁ v = p₁ (ι default) := by rw [h (p₁ v) hc hb, ha]
    exact Set.mem_singleton_iff.mpr ((Scheme.Hom.isEmbedding p₁).injective hd)
  have : IsClosedImmersion ι := IsClosedImmersion.of_isPreimmersion ι hcl
  have : LocallyOfFiniteType p₂ := inferInstance
  have h5 : LocallyOfFiniteType (Spec.map (f.residueFieldMap x)) := by
    rw [← h2]; infer_instance
  have h6 : (f.residueFieldMap x).hom.FiniteType :=
    (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp h5
  exact RingHom.finite_iff_finiteType_of_isJacobsonRing.mpr h6

theorem wc_etale_geom_point_residue_iso : ∀ {Y Z : Scheme.{u}} (ε : Y ⟶ Z) [Etale ε] (y : Y) (z : Z), ε y = z → ∃ ι : Spec (.of (AlgebraicClosure (Y.residueField y))) ≅ Spec (.of (AlgebraicClosure (Z.residueField z))), ι.hom ≫ wcEtGeomPt Z z = wcEtGeomPt Y y ≫ ε :=
by
  intro Y Z ε _ y z hz
  subst hz
  have hfin : (ε.residueFieldMap y).hom.Finite := by
    apply wcpa_dj_ssm_gf_residue_finite ε y
    intro y' hy' hsp
    obtain ⟨U', hy'U, hU'⟩ := wc_etale_fibre_point_isolated ε y'
    have hyU : y ∈ U' := hsp.mem_open U'.isOpen hy'U
    exact (hU' y hyU hy'.symm).symm
  have hr : (ε.residueFieldMap y).hom.IsIntegral := RingHom.Finite.to_isIntegral hfin
  letI : Algebra (Z.residueField (ε y)) (AlgebraicClosure (Y.residueField y)) :=
    ((algebraMap (Y.residueField y) (AlgebraicClosure (Y.residueField y))).comp
      (ε.residueFieldMap y).hom).toAlgebra
  let g : AlgebraicClosure (Z.residueField (ε y)) →ₐ[Z.residueField (ε y)]
      AlgebraicClosure (Y.residueField y) := IsAlgClosed.lift
  let j : AlgebraicClosure (Z.residueField (ε y)) →+* AlgebraicClosure (Y.residueField y) := g
  have hcomp : j.comp (algebraMap (Z.residueField (ε y)) (AlgebraicClosure (Z.residueField (ε y)))) =
      (algebraMap (Y.residueField y) (AlgebraicClosure (Y.residueField y))).comp
        (ε.residueFieldMap y).hom := by
    have := g.comp_algebraMap
    rw [RingHom.algebraMap_toAlgebra] at this
    exact this
  have hK : (algebraMap (Y.residueField y) (AlgebraicClosure (Y.residueField y))).IsIntegral :=
    fun x => Algebra.IsIntegral.isIntegral x
  have hjint : j.IsIntegral := by
    apply RingHom.IsIntegral.tower_top
      (algebraMap (Z.residueField (ε y)) (AlgebraicClosure (Z.residueField (ε y)))) j
    rw [hcomp]
    exact RingHom.IsIntegral.trans _ _ hr hK
  have hbij : Function.Bijective j := IsAlgClosed.ringHom_bijective_of_isIntegral j hjint
  haveI : IsIso (Spec.map (CommRingCat.ofHom j)) := isIso_SpecMap_iff.mpr hbij
  refine ⟨asIso (Spec.map (CommRingCat.ofHom j)), ?_⟩
  have key2 : Spec.map (CommRingCat.ofHom j) ≫ Spec.map (CommRingCat.ofHom
      (algebraMap (Z.residueField (ε y)) (AlgebraicClosure (Z.residueField (ε y))))) =
      Spec.map (CommRingCat.ofHom
        (algebraMap (Y.residueField y) (AlgebraicClosure (Y.residueField y)))) ≫
        Spec.map (ε.residueFieldMap y) := by
    rw [← Spec.map_comp, ← Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    exact hcomp
  simp only [wcEtGeomPt, asIso_hom]
  rw [reassoc_of% key2, Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, Category.assoc]

theorem wc_shdata_etale_iso : ∀ {Y Z : Scheme.{u}} (ε : Y ⟶ Z) [Etale ε] (y : Y) (z : Z) (ι : Spec (.of (AlgebraicClosure (Y.residueField y))) ≅ Spec (.of (AlgebraicClosure (Z.residueField z)))), ι.hom ≫ wcEtGeomPt Z z = wcEtGeomPt Y y ≫ ε → ∀ (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData y B Λ W' φ a → ∀ (B' : Type u) [CommRing B'] [IsLocalRing B'] (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ'] (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt Z z)) (Scheme.Etale.forget Z)) (φ' : ∀ l, Spec (.of B') ⟶ (W''.obj l).right.left) (a' : Spec (.of B') ⟶ Z), wcHalShData z B' Λ' W'' φ' a' → ∃ θ : Spec (.of B) ≅ Spec (.of B'), θ.hom ≫ a' = a ≫ ε :=
by
  intro Y Z ε _ y z ι hι B _ _ Λ _ _ W' φ a hd B' _ _ Λ' _ _ W'' φ' a' hd'

  have hqpt : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (K : Type u) [Field K]
      (e : IsLocalRing.ResidueField R →+* K) (x : Spec (.of K)),
      (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x =
        IsLocalRing.closedPoint R := by
    intro R _ _ K _ e x
    rw [Scheme.Hom.comp_apply]
    exact IsLocalRing.PrimeSpectrum.comap_residue R _


  have s0 : ∀ {P E S : Scheme.{u}} (ee : E ⟶ S) [Etale ee] (aa bb : P ⟶ E), aa ≫ ee = bb ≫ ee →
      ∀ (Ω : Type u) [Field Ω] (π : Spec (.of Ω) ⟶ P), π ≫ aa = π ≫ bb →
      ∃ U : P.Opens, π (IsLocalRing.closedPoint Ω) ∈ U ∧ U.ι ≫ aa = U.ι ≫ bb := by
    intro P E S ee _ aa bb hab Ω _ π hπ
    let c : P ⟶ Limits.pullback ee ee := Limits.pullback.lift aa bb hab
    have hcf : c ≫ Limits.pullback.fst ee ee = aa := Limits.pullback.lift_fst _ _ _
    have hcs : c ≫ Limits.pullback.snd ee ee = bb := Limits.pullback.lift_snd _ _ _
    have hkey : π ≫ c = (π ≫ aa) ≫ Limits.pullback.diagonal ee := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hcf, Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      · rw [Category.assoc, hcs, Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
          hπ]
    have hpt : ∀ w : Spec (.of Ω), c (π w) = Limits.pullback.diagonal ee (aa (π w)) := by
      intro w
      rw [← Scheme.Hom.comp_apply, hkey, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    refine ⟨c ⁻¹ᵁ (Limits.pullback.diagonal ee).opensRange, ?_, ?_⟩
    · show c (π (IsLocalRing.closedPoint Ω)) ∈ (Limits.pullback.diagonal ee).opensRange
      rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
      exact ⟨_, (hpt _).symm⟩
    · set U := c ⁻¹ᵁ (Limits.pullback.diagonal ee).opensRange with hU
      have hrange : Set.range (U.ι ≫ c) ⊆ Set.range (Limits.pullback.diagonal ee) := by
        rintro _ ⟨x, rfl⟩
        have hx0 : U.ι x ∈ Set.range U.ι := ⟨x, rfl⟩
        rw [Scheme.Opens.range_ι] at hx0
        have hx' : c (U.ι x) ∈ (Limits.pullback.diagonal ee).opensRange := hx0
        rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange] at hx'
        rw [Scheme.Hom.comp_apply]
        exact hx'
      obtain ⟨t, ht⟩ : ∃ t, t ≫ Limits.pullback.diagonal ee = U.ι ≫ c :=
        ⟨_, IsOpenImmersion.lift_fac (Limits.pullback.diagonal ee) (U.ι ≫ c) hrange⟩
      have h1 : U.ι ≫ aa = t := by
        calc U.ι ≫ aa = (U.ι ≫ c) ≫ Limits.pullback.fst ee ee := by rw [Category.assoc, hcf]
          _ = (t ≫ Limits.pullback.diagonal ee) ≫ Limits.pullback.fst ee ee := by rw [ht]
          _ = t := by rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      have h2 : U.ι ≫ bb = t := by
        calc U.ι ≫ bb = (U.ι ≫ c) ≫ Limits.pullback.snd ee ee := by rw [Category.assoc, hcs]
          _ = (t ≫ Limits.pullback.diagonal ee) ≫ Limits.pullback.snd ee ee := by rw [ht]
          _ = t := by rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id]
      rw [h1, h2]

  have hAG : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (Ω : Type u) [Field Ω]
      (π : Spec (.of Ω) ⟶ Spec (.of R)), π (IsLocalRing.closedPoint Ω) = IsLocalRing.closedPoint R →
      ∀ {V S : Scheme.{u}} (h : V ⟶ S) [Etale h] (g₁ g₂ : Spec (.of R) ⟶ V),
      g₁ ≫ h = g₂ ≫ h → π ≫ g₁ = π ≫ g₂ → g₁ = g₂ := by
    intro R _ _ Ω _ π hπ V S h _ g₁ g₂ hh hq
    obtain ⟨U, hU, hUeq⟩ := s0 h g₁ g₂ hh Ω π hq
    have hU' : IsLocalRing.closedPoint R ∈ U := by
      rw [← hπ]
      exact hU
    have hsub : Set.range ⇑(𝟙 (Spec (.of R))) ⊆ Set.range ⇑U.ι := by
      intro x _
      rw [Scheme.Opens.range_ι]
      exact (IsLocalRing.specializes_closedPoint (R := R) x).mem_open U.isOpen hU'
    have hk := IsOpenImmersion.lift_fac U.ι (𝟙 _) hsub
    calc g₁ = (IsOpenImmersion.lift U.ι (𝟙 _) hsub ≫ U.ι) ≫ g₁ := by
          rw [hk, Category.id_comp]
      _ = (IsOpenImmersion.lift U.ι (𝟙 _) hsub ≫ U.ι) ≫ g₂ := by
          simp only [Category.assoc, hUeq]
      _ = g₂ := by rw [hk, Category.id_comp]

  have hNR : ∀ {Y : Scheme.{u}} (y : Y) (B0 : Type u) [CommRing B0] [IsLocalRing B0] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B0) ⟶ (W'.obj l).right.left) (a0 : Spec (.of B0) ⟶ Y), wcHalShData y B0 Λ W' φ a0 → ∃ e' : IsLocalRing.ResidueField B0 →+* AlgebraicClosure (Y.residueField y), ∀ l, Spec.map (CommRingCat.ofHom e') ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B0)) ≫ φ l = (W'.obj l).hom.left := by
    intro Y y B0 _ _ Λ _ _ W' φ a0 hd
    have hd' := hd
    obtain ⟨hinit, haff, hcomp, hφa, hlim, e, -, he⟩ := hd'
    have s3 : ∀ l, φ l (IsLocalRing.closedPoint B0) =
        (W'.obj l).hom.left (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) := by
      intro l
      have hEt : Etale (W'.obj l).right.hom := (W'.obj l).right.prop
      have hgeom : ∀ z, wcEtGeomPt Y y z = y := by
        intro z
        rw [wcEtGeomPt, Scheme.Hom.comp_apply]
        exact Scheme.fromSpecResidueField_apply y _
      have hres : ∀ z, (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B0))) z =
          IsLocalRing.closedPoint B0 :=
        fun z => IsLocalRing.PrimeSpectrum.comap_residue B0 z
      have ha : a0 (IsLocalRing.closedPoint B0) = y := by
        have h1 := congrArg (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) he
        have h1' := (Scheme.Hom.comp_apply _ _ _).symm.trans
          ((Scheme.Hom.comp_apply _ _ _).symm.trans (h1.trans (hgeom _)))
        rw [hres] at h1'
        exact h1'
      have h2 : (W'.obj l).right.hom (φ l (IsLocalRing.closedPoint B0)) = y :=
        (Scheme.Hom.comp_apply _ _ _).symm.trans
          ((congrArg (fun f => f (IsLocalRing.closedPoint B0)) (hφa l)).trans ha)
      have h3 : (W'.obj l).right.hom ((W'.obj l).hom.left
          (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) = y :=
        (Scheme.Hom.comp_apply _ _ _).symm.trans
          ((congrArg (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))))
            (Over.w (W'.obj l).hom)).trans (hgeom _))
      have hisoGen : ∀ {V S : Scheme.{u}} (f : V ⟶ S) [Etale f] (v : V),
          ∃ U : V.Opens, v ∈ U ∧ ∀ w ∈ U, f w = f v → w = v := by
        intro V S f _ v
        haveI hlqf : LocallyQuasiFinite f := by
          rw [HasRingHomProperty.iff_appLE (P := @LocallyQuasiFinite)]
          intro U W e
          have h := HasRingHomProperty.appLE @Etale f ‹Etale f› U W e
          letI := (f.appLE U W e).hom.toAlgebra
          haveI : Algebra.Etale _ _ := RingHom.Etale.toAlgebra h
          exact RingHom.quasiFinite_algebraMap.mpr inferInstance
        haveI hd : DiscreteTopology ↑(f ⁻¹' {f v}) := (f.fiberHomeo (f v)).discreteTopology
        have hv : f v ∈ ({f v} : Set S) := Set.mem_singleton _
        have hopen : IsOpen ({⟨v, hv⟩} : Set ↑(f ⁻¹' {f v})) := isOpen_discrete _
        obtain ⟨t, ht, hteq⟩ := isOpen_induced_iff.mp hopen
        refine ⟨⟨t, ht⟩, ?_, ?_⟩
        · have : (⟨v, hv⟩ : ↑(f ⁻¹' {f v})) ∈ Subtype.val ⁻¹' t := by
            rw [hteq]; exact Set.mem_singleton _
          exact this
        · intro w hwU hw
          have hw' : w ∈ f ⁻¹' {f v} := by
            simp only [Set.mem_preimage, Set.mem_singleton_iff]; exact hw
          have : (⟨w, hw'⟩ : ↑(f ⁻¹' {f v})) ∈ Subtype.val ⁻¹' t := hwU
          rw [hteq, Set.mem_singleton_iff] at this
          exact congrArg Subtype.val this
      obtain ⟨O, hwO, hiso⟩ := hisoGen (W'.obj l).right.hom
        ((W'.obj l).hom.left (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))))
      have hr : Set.range (W'.obj l).hom.left ⊆ Set.range O.ι := by
        rintro _ ⟨z, rfl⟩
        have hz : z = IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)) :=
          Subsingleton.elim (α := PrimeSpectrum (AlgebraicClosure (Y.residueField y))) _ _
        subst hz
        exact (Set.ext_iff.mp (Scheme.Opens.range_ι O) _).mpr hwO
      let lam := IsOpenImmersion.lift O.ι (W'.obj l).hom.left hr
      have hlam : lam ≫ O.ι = (W'.obj l).hom.left := IsOpenImmersion.lift_fac _ _ _
      let R : Y.Etale := Scheme.Etale.mk (O.ι ≫ (W'.obj l).right.hom)
      have hlamR : lam ≫ ((Scheme.Etale.forget Y).obj R).hom = (Over.mk (wcEtGeomPt Y y)).hom := by
        show lam ≫ O.ι ≫ (W'.obj l).right.hom = wcEtGeomPt Y y
        rw [← Category.assoc, hlam]
        exact Over.w (W'.obj l).hom
      let d : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y) :=
        StructuredArrow.mk (Y := R) (Over.homMk lam hlamR)
      let iR : R ⟶ (W'.obj l).right := MorphismProperty.Over.homMk O.ι rfl trivial
      let i : d ⟶ W'.obj l := StructuredArrow.homMk iR (by
        apply Over.OverMorphism.ext
        exact hlam)
      obtain ⟨hI1, hI2⟩ := (Functor.initial_iff_of_isCofiltered W').mp hinit
      obtain ⟨l₁, ⟨g₁⟩⟩ := hI1 d
      obtain ⟨l₃, t', ht'⟩ := hI2 (W'.map (IsCofiltered.minToLeft l₁ l) ≫ g₁ ≫ i)
        (W'.map (IsCofiltered.minToRight l₁ l))
      have hg : (W'.map t' ≫ W'.map (IsCofiltered.minToLeft l₁ l) ≫ g₁) ≫ i =
          W'.map (t' ≫ IsCofiltered.minToRight l₁ l) := by
        rw [Functor.map_comp, Category.assoc, Category.assoc]
        exact ht'
      have hg' : (W'.map t' ≫ W'.map (IsCofiltered.minToLeft l₁ l) ≫ g₁).right.left ≫ O.ι =
          (W'.map (t' ≫ IsCofiltered.minToRight l₁ l)).right.left :=
        congrArg (fun k => k.right.left) hg
      have e1 : φ l = φ l₃ ≫ (W'.map t' ≫ W'.map (IsCofiltered.minToLeft l₁ l) ≫ g₁).right.left ≫ O.ι := by
        rw [hg', hcomp]
      have hmem : φ l (IsLocalRing.closedPoint B0) ∈ O := by
        have h4 : φ l (IsLocalRing.closedPoint B0) = O.ι
            ((W'.map t' ≫ W'.map (IsCofiltered.minToLeft l₁ l) ≫ g₁).right.left
              (φ l₃ (IsLocalRing.closedPoint B0))) :=
          (congrArg (fun f => f (IsLocalRing.closedPoint B0)) e1).trans
            ((Scheme.Hom.comp_apply _ _ _).trans (Scheme.Hom.comp_apply _ _ _))
        rw [h4]
        exact (Set.ext_iff.mp (Scheme.Opens.range_ι O) _).mp (Set.mem_range_self _)
      exact hiso _ hmem (h2.trans h3.symm)
    have hv : ∀ {l l' : Λ} (t : l ⟶ l'),
        (W'.obj l).hom.left ≫ (W'.map t).right.left = (W'.obj l').hom.left := fun t =>
      congrArg (fun f => f.left) (StructuredArrow.w (W'.map t))
    obtain ⟨q, hq, -⟩ := hlim _ (fun l => (W'.obj l).hom.left) hv
    have s1 : ∀ (G : Λ ⥤ Scheme.{u}) (X : Scheme.{u}) [IsAffine X] (ψ : ∀ l, X ⟶ G.obj l),
        (∀ l, IsAffine (G.obj l)) → (∀ {l l' : Λ} (t : l ⟶ l'), ψ l ≫ G.map t = ψ l') →
        (∀ (T : Scheme.{u}) (zz : ∀ l, T ⟶ G.obj l),
          (∀ {l l' : Λ} (t : l ⟶ l'), zz l ≫ G.map t = zz l') → ∃! z₀ : T ⟶ X, ∀ l, z₀ ≫ ψ l = zz l) →
        ∀ f : Γ(X, ⊤), ∃ (l : Λ) (g : Γ(G.obj l, ⊤)), (ψ l).appTop g = f := by
      intro G X _ ψ hGa hψ hlim f
      let F : Λᵒᵖ ⥤ CommRingCat.{u} := G.op ⋙ Scheme.Γ
      have hnat : ∀ (i j : Λᵒᵖ) (f : i ⟶ j), F.map f ≫ (ψ j.unop).appTop = (ψ i.unop).appTop := by
        intro i j f
        rw [← hψ f.unop, Scheme.Hom.comp_appTop]
        rfl
      let c : Limits.Cocone F :=
        { pt := Γ(X, ⊤)
          ι := { app := fun l => (ψ l.unop).appTop
                 naturality := fun i j f => by
                   erw [Category.comp_id]
                   exact hnat i j f } }
      let κ : Limits.colimit F ⟶ Γ(X, ⊤) := Limits.colimit.desc F c
      let ι' : ∀ l : Λ, Γ(G.obj l, ⊤) ⟶ Limits.colimit F := fun l =>
        Limits.colimit.ι F (Opposite.op l)
      have hκ : ∀ l : Λ, ι' l ≫ κ = (ψ l).appTop := fun l => Limits.colimit.ι_desc c (Opposite.op l)
      have hιw : ∀ {l l' : Λ} (t : l ⟶ l'), (G.map t).appTop ≫ ι' l = ι' l' := fun t =>
        Limits.colimit.w F t.op
      let ψ' : ∀ l, Spec (Limits.colimit F) ⟶ G.obj l := fun l =>
        Spec.map (ι' l) ≫ (G.obj l).isoSpec.inv
      have hψ' : ∀ {l l' : Λ} (t : l ⟶ l'), ψ' l ≫ G.map t = ψ' l' := by
        intro l l' t
        simp only [ψ']
        rw [Category.assoc, ← Scheme.isoSpec_inv_naturality, ← Category.assoc, ← Spec.map_comp,
          hιw t]
      obtain ⟨z₀, hz₀, -⟩ := hlim _ ψ' hψ'
      obtain ⟨w, -, hwu⟩ := hlim X ψ hψ
      let ρ : X ⟶ Spec (Limits.colimit F) := X.isoSpec.hom ≫ Spec.map κ
      have hρ : ρ ≫ z₀ = 𝟙 X := by
        have e1 : ρ ≫ z₀ = w := hwu _ (fun l => by
          rw [Category.assoc, hz₀]
          simp only [ρ, ψ', Category.assoc]
          rw [← Category.assoc (Spec.map κ), ← Spec.map_comp, hκ l,
            Scheme.isoSpec_inv_naturality, Iso.hom_inv_id_assoc])
        have e2 : 𝟙 X = w := hwu _ (fun l => Category.id_comp _)
        rw [e1, e2]
      have h2 : Spec.map κ ≫ (z₀ ≫ X.isoSpec.hom) = 𝟙 _ := by
        have : Spec.map κ ≫ z₀ = X.isoSpec.inv := by
          rw [← Iso.hom_comp_eq_id, ← Category.assoc]
          exact hρ
        rw [← Category.assoc, this, Iso.inv_hom_id]
      let ζ : Γ(X, ⊤) ⟶ Limits.colimit F := Spec.preimage (z₀ ≫ X.isoSpec.hom)
      have hζκ : ζ ≫ κ = 𝟙 _ := by
        apply Spec.map_injective
        rw [Spec.map_comp, Spec.map_preimage, h2, Spec.map_id]
      obtain ⟨j, g, hg⟩ := Limits.Concrete.colimit_exists_rep F (ζ f)
      refine ⟨j.unop, g, ?_⟩
      have e3 : κ (ζ f) = f := by
        show (ζ ≫ κ) f = f
        rw [hζκ]
        rfl
      have e4 : (ψ j.unop).appTop g = κ (ι' j.unop g) := by
        rw [← hκ j.unop]
        rfl
      rw [e4, ← e3, ← hg]
      rfl
    let G : Λ ⥤ Scheme.{u} :=
      { obj := fun l => (W'.obj l).right.left
        map := fun t => (W'.map t).right.left
        map_id := fun l => by rw [W'.map_id]; rfl
        map_comp := fun t₁ t₂ => by rw [W'.map_comp]; rfl }
    have hrep := s1 G (Spec (.of B0)) φ haff hcomp hlim
    have s2 : ∀ n₁ n₂ : Spec (.of B0), (∀ l, φ l n₁ = φ l n₂) → n₁ = n₂ := by
      intro n₁ n₂ hn
      have key : ∀ f : Γ(Spec (.of B0), ⊤),
          n₁ ∈ (Spec (.of B0)).basicOpen f → n₂ ∈ (Spec (.of B0)).basicOpen f := by
        intro f hf
        obtain ⟨l, g, hg⟩ := hrep f
        rw [← hg, ← Scheme.Hom.preimage_basicOpen_top] at hf ⊢
        rw [Scheme.Hom.mem_preimage] at hf ⊢
        exact (hn l) ▸ hf
      have key' : ∀ f : Γ(Spec (.of B0), ⊤),
          n₂ ∈ (Spec (.of B0)).basicOpen f → n₁ ∈ (Spec (.of B0)).basicOpen f := by
        intro f hf
        obtain ⟨l, g, hg⟩ := hrep f
        rw [← hg, ← Scheme.Hom.preimage_basicOpen_top] at hf ⊢
        rw [Scheme.Hom.mem_preimage] at hf ⊢
        exact (hn l).symm ▸ hf
      have hb : ∀ {U : TopologicalSpace.Opens (Spec (.of B0))} {x : Spec (.of B0)}, x ∈ U →
          ∃ U' ∈ Set.range (Spec (.of B0)).basicOpen, x ∈ U' ∧ U' ≤ U :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd).mp (isBasis_basicOpen (Spec (.of B0)))
      apply Inseparable.eq
      rw [inseparable_iff_forall_isOpen]
      intro s hs
      constructor
      · intro h1
        obtain ⟨U', ⟨f, rfl⟩, hU1, hU2⟩ := @hb ⟨s, hs⟩ n₁ h1
        exact (show ((Spec (.of B0)).basicOpen f : Set (Spec (.of B0))) ⊆ s from hU2) (key f hU1)
      · intro h1
        obtain ⟨U', ⟨f, rfl⟩, hU1, hU2⟩ := @hb ⟨s, hs⟩ n₂ h1
        exact (show ((Spec (.of B0)).basicOpen f : Set (Spec (.of B0))) ⊆ s from hU2) (key' f hU1)
    have hpt : q (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) =
        IsLocalRing.closedPoint B0 := by
      apply s2
      intro l
      exact (Scheme.Hom.comp_apply q (φ l) _).symm.trans
        ((congrArg (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))))
          (hq l)).trans (s3 l).symm)
    let ψ : CommRingCat.of B0 ⟶ CommRingCat.of (AlgebraicClosure (Y.residueField y)) :=
      Spec.preimage q
    have hψ : Spec.map ψ = q := Spec.map_preimage q
    haveI : IsLocalHom ψ.hom := by
      rw [IsLocalRing.isLocalHom_iff_comap_closedPoint]
      exact (Spec.map_apply ψ _).symm.trans
        ((congrArg (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) hψ).trans
          hpt)
    let e' : IsLocalRing.ResidueField B0 →+* AlgebraicClosure (Y.residueField y) :=
      IsLocalRing.ResidueField.lift ψ.hom
    have he' : e'.comp (IsLocalRing.residue B0) = ψ.hom :=
      IsLocalRing.ResidueField.lift_comp_residue ψ.hom
    have hq' : Spec.map (CommRingCat.ofHom e') ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B0)) = q := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, he', CommRingCat.ofHom_hom, hψ]
    refine ⟨e', fun l => ?_⟩
    rw [← Category.assoc, hq']
    exact hq l

  have hRIG : ∀ {Y₀ Z₀ : Scheme.{u}} (ε₀ : Y₀ ⟶ Z₀) [Etale ε₀] (y₀ : Y₀) (R : Type u) [CommRing R]
      [IsLocalRing R] (L : Type u) [SmallCategory L] [IsCofiltered L]
      (V : L ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y₀ y₀)) (Scheme.Etale.forget Y₀))
      (ψ : ∀ l, Spec (.of R) ⟶ (V.obj l).right.left) (b : Spec (.of R) ⟶ Y₀),
      (∀ l, ψ l ≫ (V.obj l).right.hom = b) →
      (∀ (T : Scheme.{u}) (zz : ∀ l, T ⟶ (V.obj l).right.left),
        (∀ {l l' : L} (t : l ⟶ l'), zz l ≫ (V.map t).right.left = zz l') →
        ∃! z₀ : T ⟶ Spec (.of R), ∀ l, z₀ ≫ ψ l = zz l) →
      (∀ {l l' : L} (t : l ⟶ l'), ψ l ≫ (V.map t).right.left = ψ l') →
      ∀ (Ω : Type u) [Field Ω] (π : Spec (.of Ω) ⟶ Spec (.of R)),
      π (IsLocalRing.closedPoint Ω) = IsLocalRing.closedPoint R →
      ∀ σ : Spec (.of R) ⟶ Spec (.of R), σ ≫ b ≫ ε₀ = b ≫ ε₀ → π ≫ σ = π → σ = 𝟙 _ := by
    intro Y₀ Z₀ ε₀ _ y₀ R _ _ L _ _ V ψ b hψb hlimR hcompR Ω _ π hπ σ hσ1 hσ2
    have hψb' : ∀ l, ψ l ≫ (V.obj l).right.hom ≫ ε₀ = b ≫ ε₀ := fun l => by
      rw [← Category.assoc, hψb]
    refine (hlimR (Spec (.of R)) ψ hcompR).unique (y₁ := σ) (y₂ := 𝟙 _) (fun l => ?_)
      (fun l => Category.id_comp _)
    haveI : Etale (V.obj l).right.hom := (V.obj l).right.prop
    apply hAG R Ω π hπ ((V.obj l).right.hom ≫ ε₀)
    · simp only [Category.assoc, hψb', hσ1]
    · rw [← Category.assoc, hσ2]

  obtain ⟨e, hN⟩ := hNR y B Λ W' φ a hd
  obtain ⟨e', hN'⟩ := hNR z B' Λ' W'' φ' a' hd'
  obtain ⟨hinit, -, hcomp, hφa, hlim, -⟩ := hd
  obtain ⟨hinit', -, hcomp', hφa', hlim', -⟩ := hd'
  obtain ⟨q, hqdef⟩ : ∃ q, q = Spec.map (CommRingCat.ofHom e) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) := ⟨_, rfl⟩
  obtain ⟨q', hq'def⟩ : ∃ q', q' = Spec.map (CommRingCat.ofHom e') ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue B')) := ⟨_, rfl⟩
  have hNq : ∀ l, q ≫ φ l = (W'.obj l).hom.left := fun l => by
    rw [hqdef, Category.assoc]; exact hN l
  have hN'q : ∀ l, q' ≫ φ' l = (W''.obj l).hom.left := fun l => by
    rw [hq'def, Category.assoc]; exact hN' l
  have hqpt0 : q (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) =
      IsLocalRing.closedPoint B := by
    rw [hqdef]; exact hqpt B _ e _
  have hq'pt : q' (IsLocalRing.closedPoint (AlgebraicClosure (Z.residueField z))) =
      IsLocalRing.closedPoint B' := by
    rw [hq'def]; exact hqpt B' _ e' _
  have hv : ∀ l, (W'.obj l).hom.left ≫ (W'.obj l).right.hom = wcEtGeomPt Y y := fun l =>
    Over.w (W'.obj l).hom
  have hv' : ∀ l, (W''.obj l).hom.left ≫ (W''.obj l).right.hom = wcEtGeomPt Z z := fun l =>
    Over.w (W''.obj l).hom
  have hvt : ∀ {l l₁ : Λ} (t : l ⟶ l₁),
      (W'.obj l).hom.left ≫ (W'.map t).right.left = (W'.obj l₁).hom.left := fun t =>
    congrArg (fun f => f.left) (StructuredArrow.w (W'.map t))


  have he' : q' ≫ a' = wcEtGeomPt Z z := by
    obtain ⟨l'₀⟩ := IsCofiltered.nonempty (C := Λ')
    rw [← hφa' l'₀, ← Category.assoc, hN'q l'₀]
    exact hv' l'₀
  have hfleg : ∀ l : Λ', ∃ w : Spec (.of B) ⟶ (W''.obj l).right.left,
      w ≫ (W''.obj l).right.hom = a ≫ ε ∧ q ≫ w = ι.hom ≫ q' ≫ φ' l := by
    intro l
    haveI : Etale (W''.obj l).right.hom := (W''.obj l).right.prop
    have ht : (ι.hom ≫ q' ≫ φ' l) ≫ (W''.obj l).right.hom = wcEtGeomPt Y y ≫ ε := by
      simp only [Category.assoc]
      rw [hφa' l, he']
      exact hι
    obtain ⟨pt, hpt1, hpt2⟩ : ∃ pt : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶
        Limits.pullback (W''.obj l).right.hom ε,
        pt ≫ Limits.pullback.fst (W''.obj l).right.hom ε = ι.hom ≫ q' ≫ φ' l ∧
        pt ≫ Limits.pullback.snd (W''.obj l).right.hom ε = wcEtGeomPt Y y :=
      ⟨Limits.pullback.lift _ _ ht, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    let D : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y) :=
      StructuredArrow.mk (Y := Scheme.Etale.mk (Limits.pullback.snd (W''.obj l).right.hom ε))
        (Over.homMk pt hpt2)
    obtain ⟨l₁, ⟨g⟩⟩ := ((Functor.initial_iff_of_isCofiltered W').mp hinit).1 D
    obtain ⟨gl, F1, F2⟩ : ∃ gl : (W'.obj l₁).right.left ⟶ Limits.pullback (W''.obj l).right.hom ε,
        gl ≫ Limits.pullback.snd (W''.obj l).right.hom ε = (W'.obj l₁).right.hom ∧
        (W'.obj l₁).hom.left ≫ gl = pt :=
      ⟨g.right.left, MorphismProperty.Over.w g.right,
        congrArg (fun f => f.left) (StructuredArrow.w g)⟩
    refine ⟨φ l₁ ≫ gl ≫ Limits.pullback.fst (W''.obj l).right.hom ε, ?_, ?_⟩
    · calc (φ l₁ ≫ gl ≫ Limits.pullback.fst (W''.obj l).right.hom ε) ≫ (W''.obj l).right.hom
          = φ l₁ ≫ (gl ≫ Limits.pullback.snd (W''.obj l).right.hom ε) ≫ ε := by
            simp only [Category.assoc, Limits.pullback.condition, Limits.pullback.condition_assoc]
        _ = a ≫ ε := by rw [F1, ← Category.assoc, hφa l₁]
    · calc q ≫ φ l₁ ≫ gl ≫ Limits.pullback.fst (W''.obj l).right.hom ε
          = ((q ≫ φ l₁) ≫ gl) ≫ Limits.pullback.fst (W''.obj l).right.hom ε := by
            simp only [Category.assoc]
        _ = pt ≫ Limits.pullback.fst (W''.obj l).right.hom ε := by
            rw [hNq l₁]
            exact congrArg (fun k => k ≫ Limits.pullback.fst (W''.obj l).right.hom ε) F2
        _ = _ := hpt1
  choose w hw1 hw2 using hfleg
  have hwc : ∀ {l l₁ : Λ'} (t : l ⟶ l₁), w l ≫ (W''.map t).right.left = w l₁ := by
    intro l l₁ t
    haveI : Etale (W''.obj l₁).right.hom := (W''.obj l₁).right.prop
    apply hAG B _ q hqpt0 (W''.obj l₁).right.hom
    · rw [Category.assoc, MorphismProperty.Over.w (W''.map t).right, hw1, hw1]
    · rw [← Category.assoc, hw2, hw2]
      simp only [Category.assoc, hcomp' t]
  obtain ⟨β, hβ, -⟩ := hlim' (Spec (.of B)) w hwc
  obtain ⟨l'₀⟩ := IsCofiltered.nonempty (C := Λ')
  have F1 : β ≫ a' = a ≫ ε := by
    rw [← hφa' l'₀, ← Category.assoc, hβ l'₀, hw1 l'₀]
  have F2 : q ≫ β = ι.hom ≫ q' := by
    have hu : ∀ {l l₁ : Λ'} (t : l ⟶ l₁),
        (ι.hom ≫ q' ≫ φ' l) ≫ (W''.map t).right.left = ι.hom ≫ q' ≫ φ' l₁ := by
      intro l l₁ t
      simp only [Category.assoc, hcomp' t]
    exact (hlim' _ _ hu).unique (y₁ := q ≫ β) (y₂ := ι.hom ≫ q')
      (fun l => by rw [Category.assoc, hβ l, hw2 l]) (fun l => by simp only [Category.assoc])


  have hκ : ι.inv ≫ wcEtGeomPt Y y ≫ ε = wcEtGeomPt Z z := by
    rw [← hι, Iso.inv_hom_id_assoc]
  have hleg : ∀ l : Λ, ∃ zl : Spec (.of B') ⟶ (W'.obj l).right.left,
      zl ≫ (W'.obj l).right.hom ≫ ε = a' ∧ q' ≫ zl = ι.inv ≫ (W'.obj l).hom.left := by
    intro l
    haveI : Etale (W'.obj l).right.hom := (W'.obj l).right.prop
    have hL2 : (ι.inv ≫ (W'.obj l).hom.left) ≫ (W'.obj l).right.hom ≫ ε = wcEtGeomPt Z z :=
      ((Category.assoc _ _ _).trans (congrArg (ι.inv ≫ ·)
        ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ ε) (hv l))))).trans hκ
    let D : StructuredArrow (Over.mk (wcEtGeomPt Z z)) (Scheme.Etale.forget Z) :=
      StructuredArrow.mk (Y := Scheme.Etale.mk ((W'.obj l).right.hom ≫ ε))
        (Over.homMk (ι.inv ≫ (W'.obj l).hom.left) hL2)
    obtain ⟨l'', ⟨g⟩⟩ := ((Functor.initial_iff_of_isCofiltered W'').mp hinit').1 D
    obtain ⟨gl, G1, G2⟩ : ∃ gl : (W''.obj l'').right.left ⟶ (W'.obj l).right.left,
        gl ≫ (W'.obj l).right.hom ≫ ε = (W''.obj l'').right.hom ∧
        (W''.obj l'').hom.left ≫ gl = ι.inv ≫ (W'.obj l).hom.left :=
      ⟨g.right.left, MorphismProperty.Over.w g.right,
        congrArg (fun f => f.left) (StructuredArrow.w g)⟩
    refine ⟨φ' l'' ≫ gl, ?_, ?_⟩
    · rw [Category.assoc, G1, hφa' l'']
    · exact (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ gl) (hN'q l'')).trans G2)
  choose zl hz1 hz2 using hleg
  have hwt : ∀ {l l₁ : Λ} (t : l ⟶ l₁),
      (W'.map t).right.left ≫ (W'.obj l₁).right.hom ≫ ε = (W'.obj l).right.hom ≫ ε := by
    intro l l₁ t
    rw [← Category.assoc, MorphismProperty.Over.w (W'.map t).right]
  have hzc : ∀ {l l₁ : Λ} (t : l ⟶ l₁), zl l ≫ (W'.map t).right.left = zl l₁ := by
    intro l l₁ t
    haveI : Etale (W'.obj l₁).right.hom := (W'.obj l₁).right.prop
    apply hAG B' _ q' hq'pt ((W'.obj l₁).right.hom ≫ ε)
    · rw [Category.assoc, hwt t, hz1, hz1]
    · exact (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ (W'.map t).right.left) (hz2 l)).trans
        ((Category.assoc _ _ _).trans ((congrArg (ι.inv ≫ ·) (hvt t)).trans (hz2 l₁).symm)))
  obtain ⟨γ, hγ, -⟩ := hlim (Spec (.of B')) zl hzc
  obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
  have R1 : γ ≫ a ≫ ε = a' := by
    rw [← hφa l₀, Category.assoc, ← Category.assoc γ, hγ l₀, hz1 l₀]
  have R2 : q' ≫ γ = ι.inv ≫ q := by
    have hu : ∀ {l l₁ : Λ} (t : l ⟶ l₁),
        (ι.inv ≫ q ≫ φ l) ≫ (W'.map t).right.left = ι.inv ≫ q ≫ φ l₁ := by
      intro l l₁ t
      simp only [Category.assoc, hcomp t]
    exact (hlim _ _ hu).unique (y₁ := q' ≫ γ) (y₂ := ι.inv ≫ q)
      (fun l => (Category.assoc _ _ _).trans ((congrArg (q' ≫ ·) (hγ l)).trans
        ((hz2 l).trans (congrArg (ι.inv ≫ ·) (hNq l).symm))))
      (fun l => by simp only [Category.assoc])


  have e1 : β ≫ γ = 𝟙 _ := hRIG ε y B Λ W' φ a hφa hlim hcomp _ q hqpt0 (β ≫ γ)
    (by rw [Category.assoc, R1, F1])
    (by rw [← Category.assoc, F2, Category.assoc, R2, Iso.hom_inv_id_assoc])
  have e2 : γ ≫ β = 𝟙 _ := hRIG (𝟙 Z) z B' Λ' W'' φ' a' hφa' hlim' hcomp' _ q' hq'pt (γ ≫ β)
    (by simp only [Category.comp_id, Category.assoc, F1, R1])
    (by rw [← Category.assoc, R2, Category.assoc, F2, Iso.inv_hom_id_assoc])
  exact ⟨⟨β, γ, e1, e2⟩, F1⟩

theorem wc_smooth_shens_affine_space_model : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)), Smooth f → ∀ (x : Y₀), f x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y₀ x)) (Scheme.Etale.forget Y₀)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y₀), wcHalShData x B Λ W' φ a → ∃ (d : ℕ) (x' : Spec (.of (MvPolynomial (Fin d) A))) (B' : Type u) (_ : CommRing B') (_ : HenselianLocalRing B') (_ : IsSepClosed (IsLocalRing.ResidueField B')) (Λ' : Type u) (_ : SmallCategory Λ') (_ : IsCofiltered Λ') (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Fin d) A))) x')) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Fin d) A))))) (φ' : ∀ l, Spec (.of B') ⟶ (W''.obj l).right.left) (a' : Spec (.of B') ⟶ Spec (.of (MvPolynomial (Fin d) A))), wcHalShData x' B' Λ' W'' φ' a' ∧ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A))) x' = IsLocalRing.closedPoint A ∧ ∃ θ : Spec (.of B) ≅ Spec (.of B'), θ.hom ≫ a' ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A))) = a ≫ f :=
by
  intro A _ _ _ Y₀ f hf x hx B _ _ _ Λ _ _ W' φ a hd
  obtain ⟨d, U, ε, hxU, hε, hcomm⟩ := wc_smooth_local_etale_chart_mvpoly A Y₀ f hf x hx
  haveI := hε
  have hmem : x ∈ Set.range U.ι := by
    rw [Scheme.Opens.range_ι]
    exact hxU
  obtain ⟨xU, hxUx⟩ := hmem
  obtain ⟨B₁, _, _, _, Λ₁, _, _, W₁, φ₁, a₁, e₁, hinit₁, haff₁, hφ₁, hφa₁, hlim₁, he₁, hcomp₁⟩ :=
    wc_et_geom_strict_henselization xU
  have hd₁ : wcHalShData xU B₁ Λ₁ W₁ φ₁ a₁ := ⟨hinit₁, haff₁, hφ₁, hφa₁, hlim₁, e₁, he₁, hcomp₁⟩
  obtain ⟨B', _, _, _, Λ', _, _, W'', φ', a', e', hinit', haff', hφ', hφa', hlim', he', hcomp'⟩ :=
    wc_et_geom_strict_henselization (ε xU)
  have hd' : wcHalShData (ε xU) B' Λ' W'' φ' a' :=
    ⟨hinit', haff', hφ', hφa', hlim', e', he', hcomp'⟩
  obtain ⟨ι₁, hι₁⟩ := wc_etale_geom_point_residue_iso U.ι xU x hxUx
  obtain ⟨ι₂, hι₂⟩ := wc_etale_geom_point_residue_iso ε xU (ε xU) rfl
  obtain ⟨θ₁, hθ₁⟩ := wc_shdata_etale_iso U.ι xU x ι₁ hι₁ B₁ Λ₁ W₁ φ₁ a₁ hd₁ B Λ W' φ a hd
  obtain ⟨θ₂, hθ₂⟩ := wc_shdata_etale_iso ε xU (ε xU) ι₂ hι₂ B₁ Λ₁ W₁ φ₁ a₁ hd₁ B' Λ' W'' φ' a' hd'
  have hx' : Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A))) (ε xU) =
      IsLocalRing.closedPoint A := by
    rw [← Scheme.Hom.comp_apply, hcomm, Scheme.Hom.comp_apply, hxUx, hx]
  refine ⟨d, ε xU, B', inferInstance, inferInstance, inferInstance, Λ', inferInstance,
    inferInstance, W'', φ', a', hd', hx', θ₁.symm ≪≫ θ₂, ?_⟩
  have h2 : θ₂.hom ≫ a' ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin d) A))) =
      a₁ ≫ U.ι ≫ f := by
    rw [← Category.assoc, hθ₂, Category.assoc, hcomm]
  have h1 : a₁ ≫ U.ι ≫ f = θ₁.hom ≫ a ≫ f := by
    rw [← Category.assoc, ← hθ₁, Category.assoc]
  rw [Iso.trans_hom, Iso.symm_hom, Category.assoc, h2, h1, Iso.inv_hom_id_assoc]

theorem wc_affine_space_zero_shens_isIso : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (x : Spec (.of (MvPolynomial (Fin 0) A))), Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin 0) A))) x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial (Fin 0) A))) x)) (Scheme.Etale.forget (Spec (.of (MvPolynomial (Fin 0) A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (MvPolynomial (Fin 0) A))), wcHalShData x B Λ W' φ a → IsIso (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin 0) A)))) :=
by
  intro A _ _ hAsep x hx B _ _ _ Λ _ _ W' φ a hd
  classical

  have s0 : ∀ {P E S : Scheme.{u}} (ee : E ⟶ S) [Etale ee] (aa bb : P ⟶ E), aa ≫ ee = bb ≫ ee →
      ∀ (Ω : Type u) [Field Ω] (pp : Spec (.of Ω) ⟶ P), pp ≫ aa = pp ≫ bb →
      ∃ U : P.Opens, pp (IsLocalRing.closedPoint Ω) ∈ U ∧ U.ι ≫ aa = U.ι ≫ bb := by
    intro P E S ee _ aa bb hab Ω _ pp hπ
    let c : P ⟶ Limits.pullback ee ee := Limits.pullback.lift aa bb hab
    have hcf : c ≫ Limits.pullback.fst ee ee = aa := Limits.pullback.lift_fst _ _ _
    have hcs : c ≫ Limits.pullback.snd ee ee = bb := Limits.pullback.lift_snd _ _ _
    have hkey : pp ≫ c = (pp ≫ aa) ≫ Limits.pullback.diagonal ee := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hcf, Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      · rw [Category.assoc, hcs, Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
          hπ]
    have hpt : ∀ w : Spec (.of Ω), c (pp w) = Limits.pullback.diagonal ee (aa (pp w)) := by
      intro w
      rw [← Scheme.Hom.comp_apply, hkey, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    refine ⟨c ⁻¹ᵁ (Limits.pullback.diagonal ee).opensRange, ?_, ?_⟩
    · show c (pp (IsLocalRing.closedPoint Ω)) ∈ (Limits.pullback.diagonal ee).opensRange
