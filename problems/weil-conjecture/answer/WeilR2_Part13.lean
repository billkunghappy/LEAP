      exact (hmem _).mp (hall j) hj



  have MAIN : ∀ {Z₁ P₁ Q₁ : Scheme.{u}} (k₁ : Z₁ ⟶ P₁) [IsAffineHom k₁] (q₁ : P₁ ⟶ Q₁) (n₁ : ℕ)
      [SmoothOfRelativeDimension n₁ q₁] [LocallyOfFinitePresentation (k₁ ≫ q₁)]
      (U : P₁.Opens) (Φ : Γ(P₁, U))
      (hloc : ∀ (x : Z₁) (hx : k₁ x ∈ U), Function.Surjective (k₁.stalkMap x).hom ∧
        RingHom.ker (k₁.stalkMap x).hom = Ideal.span {(P₁.presheaf.germ U (k₁ x) hx).hom Φ})
      (hne : ∀ (x : Z₁) (hx : k₁ x ∈ U), (P₁.presheaf.germ U (k₁ x) hx).hom Φ ≠ 0)
      (z : Z₁) (hz : k₁ z ∈ U),
      ∃ (W : Z₁.Opens) (_ : IsAffineOpen W) (hzW : z ∈ W) (ψ : Fin n₁ → Γ(Z₁, W)),
        (∀ (x : Z₁) (hx : x ∈ W), x ∈ wcLdnmNS (k₁ ≫ q₁) ↔
          ∀ j, (Z₁.presheaf.germ W x hx).hom (ψ j) ∈
            IsLocalRing.maximalIdeal (Z₁.presheaf.stalk x)) ∧
        letI := (q₁.stalkMap (k₁ z)).hom.toAlgebra
        ∃ e : Module.Basis (Fin n₁) (P₁.presheaf.stalk (k₁ z))
            Ω[P₁.presheaf.stalk (k₁ z)⁄Q₁.presheaf.stalk (q₁ (k₁ z))],
          ∀ j, (Z₁.presheaf.germ W _ hzW).hom (ψ j) =
            (k₁.stalkMap z).hom (e.coord j (KaehlerDifferential.D (Q₁.presheaf.stalk (q₁ (k₁ z)))
              (P₁.presheaf.stalk (k₁ z)) ((P₁.presheaf.germ U _ hz).hom Φ))) := by
    intro Z₁ P₁ Q₁ k₁ _ q₁ n₁ _ _ U Φ hloc hne z hz
    obtain ⟨V, hV, O, hO, hzO, hOU, hOV, ⟨ε⟩⟩ :=
      wc_ldnm_tv_smooth_chart_basis q₁ n₁ (k₁ z) U hz
    letI algO : Algebra Γ(Q₁, V) Γ(P₁, O) := (q₁.appLE V O hOV).hom.toAlgebra
    obtain ⟨ψ, hψ⟩ : ∃ ψ : Fin n₁ → Γ(Z₁, k₁ ⁻¹ᵁ O), ∀ j, ψ j = (k₁.app O).hom
        (ε.coord j (KaehlerDifferential.D Γ(Q₁, V) Γ(P₁, O)
          ((P₁.presheaf.map (homOfLE hOU).op).hom Φ))) := ⟨_, fun j => rfl⟩
    have hgermψ : ∀ (x : Z₁) (hx : x ∈ k₁ ⁻¹ᵁ O) (j : Fin n₁),
        (Z₁.presheaf.germ (k₁ ⁻¹ᵁ O) x hx).hom (ψ j) = (k₁.stalkMap x).hom
          ((P₁.presheaf.germ O (k₁ x) hx).hom (ε.coord j (KaehlerDifferential.D Γ(Q₁, V) Γ(P₁, O)
            ((P₁.presheaf.map (homOfLE hOU).op).hom Φ)))) := by
      intro x hx j
      rw [hψ j]
      exact (Scheme.Hom.germ_stalkMap_apply k₁ O x hx _).symm
    have hcoord : ∀ (x : Z₁) (hx : k₁ x ∈ O) (hxU : k₁ x ∈ U),
        letI := (q₁.stalkMap (k₁ x)).hom.toAlgebra
        ∃ e : Module.Basis (Fin n₁) (P₁.presheaf.stalk (k₁ x))
            Ω[P₁.presheaf.stalk (k₁ x)⁄Q₁.presheaf.stalk (q₁ (k₁ x))],
          ∀ j, e.coord j (KaehlerDifferential.D (Q₁.presheaf.stalk (q₁ (k₁ x)))
              (P₁.presheaf.stalk (k₁ x)) ((P₁.presheaf.germ U (k₁ x) hxU).hom Φ)) =
            (P₁.presheaf.germ O (k₁ x) hx).hom (ε.coord j (KaehlerDifferential.D Γ(Q₁, V) Γ(P₁, O)
              ((P₁.presheaf.map (homOfLE hOU).op).hom Φ))) := by
      intro x hx hxU
      obtain ⟨e, he⟩ := wc_ldnm_tv_stalk_basis q₁ V hV O hO hOV n₁ ε (k₁ x) hx
      refine ⟨e, fun j => ?_⟩
      have hres : (P₁.presheaf.germ O (k₁ x) hx).hom
          ((P₁.presheaf.map (homOfLE hOU).op).hom Φ) = (P₁.presheaf.germ U (k₁ x) hxU).hom Φ :=
        TopCat.Presheaf.germ_res_apply P₁.presheaf (homOfLE hOU) (k₁ x) hx Φ
      rw [← hres]
      exact he _ j
    refine ⟨k₁ ⁻¹ᵁ O, hO.preimage k₁, hzO, ψ, ?_, ?_⟩
    · intro x hx
      have hxU : k₁ x ∈ U := hOU hx
      obtain ⟨hs, hk⟩ := hloc x hxU
      obtain ⟨e, he⟩ := hcoord x hx hxU
      rw [L7 k₁ q₁ n₁ x _ hs hk (hne x hxU) e]
      refine forall_congr' fun j => ?_
      rw [he j, hgermψ x hx j, IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal,
        mem_nonunits_iff, mem_nonunits_iff]
      exact ⟨fun h h' => h (isUnit_of_map_unit (k₁.stalkMap x).hom _ h'),
        fun h h' => h (h'.map (k₁.stalkMap x).hom)⟩
    · obtain ⟨e, he⟩ := hcoord z hzO hz
      exact ⟨e, fun j => by rw [hgermψ z hzO j, he j]⟩



  intro i
  haveI hk1 : IsClosedImmersion k := hZ.1
  haveI hsnd : SmoothOfRelativeDimension n
      (Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension n)
      (IsPullback.of_hasPullback X.hom (wcProjKStr E (wcLdnmM N))) inferInstance
  haveI : SmoothOfRelativeDimension (wcLdnmM N) (wcProjKStr E (wcLdnmM N)) :=
    wc_proj_space_smooth E (wcLdnmM N)
  haveI hPs : SmoothOfRelativeDimension (n + wcLdnmM N)
      (Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)) ≫ X.hom) := by
    rw [Limits.pullback.condition]
    exact smoothOfRelativeDimension_comp n (wcLdnmM N) _ _
  haveI hZs := wc_ldnm_univ_smooth E N n X ι hι hιX Z k hZ
  haveI : IsLocallyNoetherian (Spec (.of E)) := isLocallyNoetherian_Spec.mpr inferInstance
  haveI : Smooth (Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)) ≫ X.hom) :=
    SmoothOfRelativeDimension.smooth (n + wcLdnmM N) _
  haveI : IsLocallyNoetherian (Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))) :=
    LocallyOfFiniteType.isLocallyNoetherian
      (Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)) ≫ X.hom)
  haveI : LocallyOfFinitePresentation k := L1 k
  haveI : Smooth (Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) :=
    SmoothOfRelativeDimension.smooth n _
  haveI : LocallyOfFinitePresentation (k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) :=
    inferInstance
  obtain ⟨-, hUcov, -⟩ := wc_ldnm_univ_chart_data E N X ι hι
  have hmemU : k (p (P.xs i (IsLocalRing.closedPoint E))) ∈ ⨆ q, wcLdnmU E N X ι q := by
    rw [hUcov]; trivial
  obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hmemU
  have hne : ∀ (x : Z) (hx : k x ∈ wcLdnmU E N X ι a),
      ((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.germ (wcLdnmU E N X ι a)
        (k x) hx).hom (wcLdnmPhi E N X ι a) ≠ 0 :=
    fun x hx => wc_ldnm_tv_germ_ne_zero E
      (Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)) ≫ X.hom) k
      (n + wcLdnmM N) (n + wcLdnmM N - 1) (by omega) x _ (hZ.2.2.2 x a hx).1 (hZ.2.2.2 x a hx).2
  obtain ⟨W, hW, hzW, ψ, hA, hB⟩ := MAIN k (Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)))
    n (wcLdnmU E N X ι a) (wcLdnmPhi E N X ι a) (fun x hx => hZ.2.2.2 x a hx) hne _ ha
  exact ⟨a, ha, W, hW, hzW, ψ, hA, hB⟩

theorem wc_ldnm_tvj_pullback_stalk : ∀ {T Z L Y : Scheme.{u}} (p : T ⟶ Z) (f : T ⟶ L) (h : Z ⟶ Y)
    (lam : L ⟶ Y), IsPullback p f h lam → IsClosedImmersion lam →
    ∀ (ξ : T) (t : L) (ht : f ξ = t) (e : h (p ξ) = lam t),
      Function.Surjective (p.stalkMap ξ).hom ∧
        RingHom.ker (p.stalkMap ξ).hom =
          Ideal.map (wcLdnmTvRho h (p ξ) (lam t) e) (RingHom.ker (lam.stalkMap t).hom) :=
by
  intro T Z L Y p f h lam hp hlam ξ t ht e
  subst ht
  haveI : IsClosedImmersion lam := hlam
  haveI hpc : IsClosedImmersion p :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hp.flip hlam
  have hπs : Function.Surjective (p.stalkMap ξ).hom := SurjectiveOnStalks.stalkMap_surjective p ξ
  have hlams : Function.Surjective (lam.stalkMap (f ξ)).hom :=
    SurjectiveOnStalks.stalkMap_surjective lam (f ξ)
  have hpinj : Function.Injective p := p.isClosedEmbedding.injective

  have key : Y.presheaf.stalkSpecializes (specializes_of_eq e) ≫
      h.stalkMap (p ξ) ≫ p.stalkMap ξ = lam.stalkMap (f ξ) ≫ f.stalkMap ξ := by
    have helper : ∀ (g₁ g₂ : T ⟶ Y) (hg : g₁ = g₂) (y : Y) (e1 : g₁ ξ = y) (e2 : g₂ ξ = y),
        Y.presheaf.stalkSpecializes (specializes_of_eq e1) ≫ g₁.stalkMap ξ =
          Y.presheaf.stalkSpecializes (specializes_of_eq e2) ≫ g₂.stalkMap ξ := by
      intro g₁ g₂ hg y e1 e2
      subst hg
      rfl
    have h1 := helper (p ≫ h) (f ≫ lam) hp.w ((f ≫ lam) ξ) e rfl
    rw [Scheme.Hom.stalkMap_comp p h ξ, Scheme.Hom.stalkMap_comp f lam ξ,
      TopCat.Presheaf.stalkSpecializes_refl] at h1
    exact h1.trans (Category.id_comp _)
  have s2 : ∀ x : Y.presheaf.stalk (lam (f ξ)),
      (p.stalkMap ξ).hom (wcLdnmTvRho h (p ξ) (lam (f ξ)) e x) =
        (f.stalkMap ξ).hom ((lam.stalkMap (f ξ)).hom x) := by
    intro x
    exact congrArg (fun φ => φ.hom x) key

  have s3 : Ideal.map (wcLdnmTvRho h (p ξ) (lam (f ξ)) e) (RingHom.ker (lam.stalkMap (f ξ)).hom) ≤
      RingHom.ker (p.stalkMap ξ).hom := by
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap, RingHom.mem_ker, s2 x, RingHom.mem_ker.mp hx, map_zero]
  refine ⟨hπs, le_antisymm ?_ s3⟩

  set I := Ideal.map (wcLdnmTvRho h (p ξ) (lam (f ξ)) e)
    (RingHom.ker (lam.stalkMap (f ξ)).hom) with hIdef
  by_cases hI : I = ⊤
  · rw [hI]; exact le_top
  haveI : Nontrivial (Z.presheaf.stalk (p ξ) ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
  haveI hQloc : IsLocalRing (Z.presheaf.stalk (p ξ) ⧸ I) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  let Q : CommRingCat.{u} := CommRingCat.of (Z.presheaf.stalk (p ξ) ⧸ I)
  haveI : IsLocalRing Q := hQloc
  let φ : Z.presheaf.stalk (p ξ) ⟶ Q := CommRingCat.ofHom (Ideal.Quotient.mk I)
  haveI : IsLocalHom φ.hom :=
    Function.Surjective.isLocalHom (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  have hK : RingHom.ker (lam.stalkMap (f ξ)).hom ≤
      RingHom.ker ((Ideal.Quotient.mk I).comp (wcLdnmTvRho h (p ξ) (lam (f ξ)) e)) := by
    intro x hx
    rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_map_of_mem _ hx
  let μ0 := ((lam.stalkMap (f ξ)).hom.liftOfSurjective hlams) ⟨_, hK⟩
  have hμ0 : μ0.comp (lam.stalkMap (f ξ)).hom =
      (Ideal.Quotient.mk I).comp (wcLdnmTvRho h (p ξ) (lam (f ξ)) e) :=
    RingHom.liftOfSurjective_comp _ hlams _
  let μ : L.presheaf.stalk (f ξ) ⟶ Q := CommRingCat.ofHom μ0
  have hcone : lam.stalkMap (f ξ) ≫ μ =
      Y.presheaf.stalkSpecializes (specializes_of_eq e) ≫ h.stalkMap (p ξ) ≫ φ := by
    ext x
    exact RingHom.congr_fun hμ0 x
  have hY1 : Y.fromSpecStalk (h (p ξ)) =
      Spec.map (Y.presheaf.stalkSpecializes (specializes_of_eq e)) ≫ Y.fromSpecStalk (lam (f ξ)) :=
    (Scheme.SpecMap_stalkSpecializes_fromSpecStalk (specializes_of_eq e)).symm
  have w : (Spec.map φ ≫ Z.fromSpecStalk (p ξ)) ≫ h = (Spec.map μ ≫ L.fromSpecStalk (f ξ)) ≫ lam := by
    have e1 := congrArg Spec.map hcone
    simp only [Spec.map_comp, Category.assoc] at e1
    rw [Category.assoc, Category.assoc, ← Scheme.SpecMap_stalkMap_fromSpecStalk h,
      ← Scheme.SpecMap_stalkMap_fromSpecStalk lam, hY1, reassoc_of% e1]
  let ℓ : Spec Q ⟶ T := hp.lift _ _ w
  have hℓ : ℓ ≫ p = Spec.map φ ≫ Z.fromSpecStalk (p ξ) := hp.lift_fst _ _ w
  have hcp : (Spec.map φ) (IsLocalRing.closedPoint Q) =
      IsLocalRing.closedPoint (Z.presheaf.stalk (p ξ)) := Spec_closedPoint
  have hapt0 : (Spec.map φ ≫ Z.fromSpecStalk (p ξ)) (IsLocalRing.closedPoint Q) = p ξ := by
    change Z.fromSpecStalk (p ξ) ((Spec.map φ) (IsLocalRing.closedPoint Q)) = p ξ
    exact (congrArg (Z.fromSpecStalk (p ξ)) hcp).trans Scheme.fromSpecStalk_closedPoint
  have hpt : ℓ (IsLocalRing.closedPoint Q) = ξ := by
    apply hpinj
    change (ℓ ≫ p) (IsLocalRing.closedPoint Q) = p ξ
    exact (congrArg (fun g : Spec Q ⟶ Z => g (IsLocalRing.closedPoint Q)) hℓ).trans hapt0
  intro v hv
  rw [RingHom.mem_ker] at hv
  obtain ⟨U, hU, s, rfl⟩ := Z.presheaf.exists_germ_eq v
  have H0 : (T.presheaf.germ (p ⁻¹ᵁ U) ξ hU) ((p.app U) s) = 0 := by
    rw [← Scheme.Hom.germ_stalkMap_apply p U ξ hU s]; exact hv
  have hU' : (Spec.map φ ≫ Z.fromSpecStalk (p ξ)) (IsLocalRing.closedPoint Q) ∈ U :=
    Eq.mpr (congrArg (· ∈ U) hapt0) hU
  have E1s := congrArg (fun g => g.hom s) (Scheme.germ_stalkClosedPointTo_Spec_fromSpecStalk φ U hU')
  have gen : ∀ (g : Spec Q ⟶ Z) (hg : g = ℓ ≫ p) (hgU : g (IsLocalRing.closedPoint Q) ∈ U),
      (Scheme.stalkClosedPointTo g).hom ((Z.presheaf.germ U _ hgU).hom s) =
        (Scheme.stalkClosedPointTo ℓ).hom ((T.presheaf.germ (p ⁻¹ᵁ U)
          (ℓ (IsLocalRing.closedPoint Q)) (by subst hg; exact hgU)).hom ((p.app U).hom s)) := by
    rintro g rfl hgU
    rw [Scheme.stalkClosedPointTo_comp]
    exact congrArg (Scheme.stalkClosedPointTo ℓ).hom (Scheme.Hom.germ_stalkMap_apply p U _ hgU s)
  have gen2 : ∀ (x : T) (hx : x ∈ p ⁻¹ᵁ U), x = ξ →
      (T.presheaf.germ (p ⁻¹ᵁ U) x hx).hom ((p.app U).hom s) = 0 := by
    rintro x hx rfl; exact H0
  have h3 := gen _ hℓ.symm hU'
  rw [gen2 _ _ hpt, map_zero] at h3
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  exact E1s.symm.trans h3

theorem wc_ldnm_tvj_coord_matrix_unit : ∀ (C B O : Type u) [CommRing C] [CommRing B] [IsLocalRing B]
    [CommRing O] [IsLocalRing O] [Algebra C B] (n : ℕ) (e : Module.Basis (Fin n) B Ω[B⁄C])
    (q : B →+* O), Function.Surjective q → ∀ (F : B) (K : Ideal C),
    RingHom.ker q = Ideal.span {F} ⊔ Ideal.map (algebraMap C B) K →
    (∀ b : B, ∃ c : C, b - algebraMap C B c ∈ IsLocalRing.maximalIdeal B) →
    ∀ (t : Fin n → O), IsLocalRing.maximalIdeal O = Ideal.span (Set.range t) →
    ∀ (T : Fin n → B), (∀ a, q (T a) = t a) →
    (∀ j, q (e.coord j (KaehlerDifferential.D C B F)) ∈ IsLocalRing.maximalIdeal O) →
    IsUnit (Matrix.of fun c j => q (e.coord j (KaehlerDifferential.D C B (T c)))).det :=
by
  intro C B O _ _ _ _ _ _ n e q hq F K hker hres t ht T hT hψ
  classical

  let S : Ideal B :=
    { carrier := {x | q x = 0 ∧ ∀ j, q (e.coord j (KaehlerDifferential.D C B x)) ∈
          IsLocalRing.maximalIdeal O}
      add_mem' := by
        rintro a b ⟨ha1, ha2⟩ ⟨hb1, hb2⟩
        refine ⟨by rw [map_add, ha1, hb1, add_zero], fun j => ?_⟩
        rw [map_add, map_add, map_add]
        exact Ideal.add_mem _ (ha2 j) (hb2 j)
      zero_mem' := ⟨map_zero q, fun j => by simp⟩
      smul_mem' := by
        rintro b x ⟨hx1, hx2⟩
        refine ⟨by rw [smul_eq_mul, map_mul, hx1, mul_zero], fun j => ?_⟩
        rw [smul_eq_mul, Derivation.leibniz, map_add, map_smul, map_smul, smul_eq_mul,
          smul_eq_mul, map_add, map_mul, map_mul, hx1, zero_mul, add_zero]
        exact Ideal.mul_mem_left _ _ (hx2 j) }
  have hFS : F ∈ S := by
    refine ⟨?_, hψ⟩
    have : F ∈ RingHom.ker q := by
      rw [hker]; exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self F)
    exact this
  have hβS : ∀ k ∈ K, algebraMap C B k ∈ S := by
    intro k hk
    refine ⟨?_, fun j => by simp [Derivation.map_algebraMap]⟩
    have : algebraMap C B k ∈ RingHom.ker q := by
      rw [hker]; exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hk)
    exact this
  have hle : RingHom.ker q ≤ S := by
    rw [hker]
    exact sup_le ((Ideal.span_singleton_le_iff_mem _).mpr hFS)
      (Ideal.map_le_iff_le_comap.mpr fun k hk => hβS k hk)
  have s1 : ∀ x ∈ RingHom.ker q, ∀ j,
      q (e.coord j (KaehlerDifferential.D C B x)) ∈ IsLocalRing.maximalIdeal O :=
    fun x hx j => (hle hx).2 j

  have hloc : ∀ x ∈ IsLocalRing.maximalIdeal B, q x ∈ IsLocalRing.maximalIdeal O := by
    intro x hx
    have : IsLocalHom q := Function.Surjective.isLocalHom q hq
    exact (IsLocalRing.mem_maximalIdeal _).mpr fun h =>
      (IsLocalRing.mem_maximalIdeal _).mp hx (isUnit_of_map_unit q x h)
  have htm : ∀ c, t c ∈ IsLocalRing.maximalIdeal O := by
    intro c; rw [ht]; exact Ideal.subset_span ⟨c, rfl⟩
  have s2 : ∀ y : B, ∃ u : Fin n → B, ∀ j, q (e.coord j (KaehlerDifferential.D C B y)) -
      ∑ c, q (u c) * q (e.coord j (KaehlerDifferential.D C B (T c))) ∈
        IsLocalRing.maximalIdeal O := by
    intro y
    obtain ⟨c₀, hc₀⟩ := hres y
    have h1 : q (y - algebraMap C B c₀) ∈ Ideal.span (Set.range t) := ht ▸ hloc _ hc₀
    obtain ⟨v, hv⟩ := Ideal.mem_span_range_iff_exists_fun.mp h1
    choose u hu using fun c => hq (v c)
    refine ⟨u, fun j => ?_⟩
    obtain ⟨z, hz_def⟩ : ∃ z, z = y - algebraMap C B c₀ - ∑ c, u c * T c := ⟨_, rfl⟩
    have hz : z ∈ RingHom.ker q := by
      rw [RingHom.mem_ker, hz_def, map_sub, map_sum]
      simp only [map_mul, hu, hT]
      rw [hv, sub_self]
    have hy : y = algebraMap C B c₀ + ∑ c, u c * T c + z := by rw [hz_def]; ring
    have key : q (e.coord j (KaehlerDifferential.D C B y)) -
        ∑ c, q (u c) * q (e.coord j (KaehlerDifferential.D C B (T c))) =
        ∑ c, t c * q (e.coord j (KaehlerDifferential.D C B (u c))) +
          q (e.coord j (KaehlerDifferential.D C B z)) := by
      conv_lhs => rw [hy]
      simp only [map_add, Derivation.map_algebraMap, map_sum, Derivation.leibniz, map_smul,
        smul_eq_mul, map_mul, map_zero, zero_add, hT, Finset.sum_add_distrib]
      ring
    rw [key]
    exact Ideal.add_mem _ (Ideal.sum_mem _ fun c _ => Ideal.mul_mem_right _ _ (htm c)) (s1 z hz j)

  have hP : ∀ ω : Ω[B⁄C], ∃ w : Fin n → O, ∀ j, q (e.coord j ω) -
      ∑ c, w c * q (e.coord j (KaehlerDifferential.D C B (T c))) ∈
        IsLocalRing.maximalIdeal O := by
    intro ω
    have hω : ω ∈ Submodule.span B (Set.range (KaehlerDifferential.D C B)) := by
      rw [KaehlerDifferential.span_range_derivation]; trivial
    induction hω using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨y, rfl⟩ := hx
      obtain ⟨u, hu⟩ := s2 y
      exact ⟨fun c => q (u c), hu⟩
    | zero => exact ⟨0, fun j => by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨w₁, h₁⟩ := hx
      obtain ⟨w₂, h₂⟩ := hy
      refine ⟨w₁ + w₂, fun j => ?_⟩
      have := Ideal.add_mem _ (h₁ j) (h₂ j)
      convert this using 1
      simp only [map_add, Pi.add_apply, add_mul, Finset.sum_add_distrib]
      ring
    | smul b x _ hx =>
      obtain ⟨w, h⟩ := hx
      refine ⟨fun c => q b * w c, fun j => ?_⟩
      have := Ideal.mul_mem_left (IsLocalRing.maximalIdeal O) (q b) (h j)
      convert this using 1
      rw [mul_sub, Finset.mul_sum]
      simp only [map_smul, smul_eq_mul, map_mul, mul_assoc]
  choose w hw using fun i => hP (e i)
  have hcoord : ∀ i j, q (e.coord j (e i)) = (1 : Matrix (Fin n) (Fin n) O) i j := by
    intro i j
    rw [Module.Basis.coord_apply, Module.Basis.repr_self]
    by_cases h : i = j <;> simp [h, Matrix.one_apply, Finsupp.single_apply]
  set M := Matrix.of fun c j => q (e.coord j (KaehlerDifferential.D C B (T c))) with hM
  set W : Matrix (Fin n) (Fin n) O := Matrix.of fun i c => w i c with hW
  have hWM : (W * M).map (IsLocalRing.residue O) = 1 := by
    ext i j
    have h := hw i j
    rw [hcoord] at h
    have h2 : IsLocalRing.residue O ((1 : Matrix (Fin n) (Fin n) O) i j - (W * M) i j) = 0 :=
      (IsLocalRing.residue_eq_zero_iff _).mpr (by rw [Matrix.mul_apply]; exact h)
    rw [map_sub, sub_eq_zero] at h2
    rw [Matrix.map_apply, ← h2, Matrix.one_apply, Matrix.one_apply]
    split_ifs <;> simp
  have hdet : IsUnit (M.map (IsLocalRing.residue O)).det :=
    Matrix.isUnit_det_of_left_inverse (B := W.map (IsLocalRing.residue O))
      (by rw [← Matrix.map_mul]; exact hWM)
  have hne : IsLocalRing.residue O M.det ≠ 0 := by
    rw [RingHom.map_det]; exact hdet.ne_zero
  exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mp hne

theorem wc_ldnm_tvj_relation_mod_sq : ∀ (C B O : Type u) [CommRing C] [CommRing B] [CommRing O]
    [IsLocalRing O] [Algebra C B] (n : ℕ) (e : Module.Basis (Fin n) B Ω[B⁄C]) (q : B →+* O),
    Function.Surjective q → ∀ (F : B) (K : Ideal C),
    RingHom.ker q = Ideal.span {F} ⊔ Ideal.map (algebraMap C B) K →
    ∀ (t : Fin n → O), IsLocalRing.maximalIdeal O = Ideal.span (Set.range t) →
    ∀ (T : Fin n → B), (∀ a, q (T a) = t a) →
    ∀ (σ : C) (A : Matrix (Fin n) (Fin n) O),
    q (algebraMap C B σ) - ∑ a, ∑ c, A a c * t a * t c ∈ IsLocalRing.maximalIdeal O ^ 3 →
    IsUnit (A + A.transpose).det →
    IsUnit (Matrix.of fun c j => q (e.coord j (KaehlerDifferential.D C B (T c)))).det →
    ∀ a, t a ∈ Ideal.span (Set.range fun j => q (e.coord j (KaehlerDifferential.D C B F))) ⊔
      IsLocalRing.maximalIdeal O ^ 2 :=
by
  intro C B O _ _ _ _ _ n e q hq F K hker t hspan T hT σ A hσ hA hM
  classical
  set M : Matrix (Fin n) (Fin n) O :=
    Matrix.of fun c j => q (e.coord j (KaehlerDifferential.D C B (T c))) with hMdef
  set I : Ideal O := Ideal.span (Set.range fun j => q (e.coord j (KaehlerDifferential.D C B F))) ⊔
      IsLocalRing.maximalIdeal O ^ 2 with hI
  obtain ⟨d, hd⟩ : ∃ d : Fin n → B → O,
      ∀ j b, d j b = q (e.coord j (KaehlerDifferential.D C B b)) := ⟨_, fun _ _ => rfl⟩

  have dL : ∀ j x y, d j (x * y) = q x * d j y + q y * d j x := by
    intro j x y
    simp only [hd, Derivation.leibniz, map_add, map_smul, smul_eq_mul, map_mul]
  have dA : ∀ j x y, d j (x + y) = d j x + d j y := by
    intro j x y; simp only [hd, map_add]
  have dS : ∀ j x y, d j (x - y) = d j x - d j y := by
    intro j x y; simp only [hd, map_sub]
  have dC : ∀ j c, d j (algebraMap C B c) = 0 := by
    intro j c; simp only [hd, Derivation.map_algebraMap, map_zero]
  have dSum : ∀ j (s : Finset (Fin n)) (f : Fin n → B),
      d j (∑ i ∈ s, f i) = ∑ i ∈ s, d j (f i) := by
    intro j s f; simp only [hd, map_sum]
  have h𝔪2 : IsLocalRing.maximalIdeal O ^ 2 ≤ I := le_sup_right
  have hFI : ∀ j, d j F ∈ I := fun j => by
    rw [hd]; exact Ideal.mem_sup_left (Ideal.subset_span ⟨j, rfl⟩)
  have ht𝔪 : ∀ a, t a ∈ IsLocalRing.maximalIdeal O := fun a => by
    rw [hspan]; exact Ideal.subset_span ⟨a, rfl⟩

  have hzker : ∀ w ∈ Ideal.map (algebraMap C B) K, q w = 0 := by
    intro w hw
    have : w ∈ RingHom.ker q := by rw [hker]; exact Ideal.mem_sup_right hw
    exact this
  have hqF : q F = 0 := by
    have : F ∈ RingHom.ker q := by
      rw [hker]; exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self F)
    exact this
  have s1z : ∀ j, ∀ z ∈ Ideal.map (algebraMap C B) K, d j z ∈ I := by
    intro j z hz
    have hz' : z ∈ Ideal.span (⇑(algebraMap C B) '' (K : Set C)) := hz
    clear hz
    induction hz' using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨c, _, rfl⟩ := hx
      rw [dC]; exact Ideal.zero_mem _
    | zero =>
      have h0 : d j 0 = 0 := by simp only [hd, map_zero]
      rw [h0]; exact Ideal.zero_mem _
    | add x y _ _ hx hy => rw [dA]; exact Ideal.add_mem _ hx hy
    | smul a x hx' hx =>
      rw [smul_eq_mul, dL, hzker x hx', zero_mul, add_zero]
      exact Ideal.mul_mem_left _ _ hx
  have s1 : ∀ x : B, q x = 0 → ∀ j, d j x ∈ I := by
    intro x hx j
    have hx' : x ∈ Ideal.span {F} ⊔ Ideal.map (algebraMap C B) K := by
      rw [← hker]; exact hx
    obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp hx'
    rw [dA]
    refine Ideal.add_mem _ ?_ (s1z j z hz)
    obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton'.mp hy
    rw [dL, hqF, zero_mul, add_zero]
    exact Ideal.mul_mem_left _ _ (hFI j)

  have cA : ∀ y ∈ Ideal.comap q (IsLocalRing.maximalIdeal O) ^ 2,
      q y ∈ IsLocalRing.maximalIdeal O ^ 2 := by
    intro y hy
    rw [pow_two] at hy
    refine Submodule.mul_induction_on hy ?_ ?_
    · intro a ha b hb
      rw [map_mul, pow_two]
      exact Ideal.mul_mem_mul (Ideal.mem_comap.mp ha) (Ideal.mem_comap.mp hb)
    · intro a b ha hb
      rw [map_add]; exact Ideal.add_mem _ ha hb
  have cB : ∀ y ∈ Ideal.comap q (IsLocalRing.maximalIdeal O) ^ 2, ∀ j,
      ∀ x ∈ Ideal.comap q (IsLocalRing.maximalIdeal O), q x * d j y ∈ I := by
    intro y hy j
    rw [pow_two] at hy
    refine Submodule.mul_induction_on hy ?_ ?_
    · intro a ha b hb x hx
      rw [dL]
      have h1 : q x * q a ∈ I := h𝔪2 (by
        rw [pow_two]; exact Ideal.mul_mem_mul (Ideal.mem_comap.mp hx) (Ideal.mem_comap.mp ha))
      have h2 : q x * q b ∈ I := h𝔪2 (by
        rw [pow_two]; exact Ideal.mul_mem_mul (Ideal.mem_comap.mp hx) (Ideal.mem_comap.mp hb))
      have : q x * (q a * d j b + q b * d j a) = (q x * q a) * d j b + (q x * q b) * d j a := by
        ring
      rw [this]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ h1) (Ideal.mul_mem_right _ _ h2)
    · intro a b ha hb x hx
      rw [dA, mul_add]; exact Ideal.add_mem _ (ha x hx) (hb x hx)
  have s2 : ∀ R ∈ Ideal.comap q (IsLocalRing.maximalIdeal O) ^ 3, ∀ j, d j R ∈ I := by
    intro R hR j
    have h3 : Ideal.comap q (IsLocalRing.maximalIdeal O) ^ 3 =
        Ideal.comap q (IsLocalRing.maximalIdeal O) ^ 2 *
          Ideal.comap q (IsLocalRing.maximalIdeal O) := pow_succ _ _
    rw [h3] at hR
    refine Submodule.mul_induction_on hR ?_ ?_
    · intro y hy x hx
      rw [dL]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (h𝔪2 (cA y hy))) (cB y hy j x hx)
    · intro a b ha hb
      rw [dA]; exact Ideal.add_mem _ ha hb

  have s3 : ∀ N : Matrix (Fin n) (Fin n) O, IsUnit N.det →
      (∀ j, ∑ a, t a * N a j ∈ I) → ∀ a, t a ∈ I := by
    intro N hN hv a
    have h1 : t = Matrix.vecMul (Matrix.vecMul t N) N⁻¹ := by
      rw [Matrix.vecMul_vecMul, Matrix.mul_nonsing_inv N hN, Matrix.vecMul_one]
    rw [h1]
    simp only [Matrix.vecMul, dotProduct]
    exact Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_right _ _ (hv j))

  choose A' hA' using fun a c => hq (A a c)
  have hmap : Ideal.map q (Ideal.comap q (IsLocalRing.maximalIdeal O) ^ 3) =
      IsLocalRing.maximalIdeal O ^ 3 := by
    rw [Ideal.map_pow, Ideal.map_comap_of_surjective q hq]
  have hσ' : q (algebraMap C B σ) - ∑ a, ∑ c, A a c * t a * t c ∈
      Ideal.map q (Ideal.comap q (IsLocalRing.maximalIdeal O) ^ 3) := by
    rw [hmap]; exact hσ
  obtain ⟨R, hR, hqR⟩ := (Ideal.mem_map_iff_of_surjective q hq).mp hσ'
  set Y := algebraMap C B σ - ∑ a, ∑ c, A' a c * T a * T c - R with hY
  have hqY : q Y = 0 := by
    simp only [hY, map_sub, map_sum, map_mul, hA', hT, hqR, sub_self]

  have hW : ∀ j, ∑ a, t a * ((A + A.transpose) * M) a j ∈ I := by
    intro j
    have hdY := s1 Y hqY j
    have hdR := s2 R hR j
    have hexp : ∑ a, ∑ c, d j (A' a c * T a * T c) = -d j Y - d j R := by
      rw [hY, dS, dS, dC, dSum]
      simp only [dSum]
      ring
    have hS : ∑ a, ∑ c, d j (A' a c * T a * T c) ∈ I := by
      rw [hexp]; exact Ideal.sub_mem _ (neg_mem hdY) hdR
    have hE : ∑ a, ∑ c, t a * t c * d j (A' a c) ∈ I :=
      Ideal.sum_mem _ fun a _ => Ideal.sum_mem _ fun c _ => Ideal.mul_mem_right _ _
        (h𝔪2 (by rw [pow_two]; exact Ideal.mul_mem_mul (ht𝔪 a) (ht𝔪 c)))
    have hterm : ∀ a c, d j (A' a c * T a * T c) =
        A a c * (t a * d j (T c) + t c * d j (T a)) + t a * t c * d j (A' a c) := by
      intro a c
      simp only [dL, map_mul, hA', hT]
      ring
    have hsplit : ∑ a, ∑ c, d j (A' a c * T a * T c) =
        ∑ a, ∑ c, A a c * (t a * d j (T c) + t c * d j (T a)) +
          ∑ a, ∑ c, t a * t c * d j (A' a c) := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun c _ => hterm a c
    have hid : ∑ a, ∑ c, A a c * (t a * d j (T c) + t c * d j (T a)) =
        ∑ a, t a * ((A + A.transpose) * M) a j := by
      calc ∑ a, ∑ c, A a c * (t a * d j (T c) + t c * d j (T a))
          = ∑ a, ∑ c, A a c * t a * d j (T c) + ∑ a, ∑ c, A a c * t c * d j (T a) := by
            rw [← Finset.sum_add_distrib]
            refine Finset.sum_congr rfl fun a _ => ?_
            rw [← Finset.sum_add_distrib]
            exact Finset.sum_congr rfl fun c _ => by ring
        _ = ∑ a, ∑ c, A a c * t a * d j (T c) + ∑ a, ∑ c, A c a * t a * d j (T c) := by
            rw [Finset.sum_comm (f := fun a c => A a c * t c * d j (T a))]
        _ = ∑ a, t a * ((A + A.transpose) * M) a j := by
            rw [← Finset.sum_add_distrib]
            refine Finset.sum_congr rfl fun a _ => ?_
            rw [← Finset.sum_add_distrib, Matrix.mul_apply, Finset.mul_sum]
            refine Finset.sum_congr rfl fun c _ => ?_
            simp only [hMdef, Matrix.add_apply, Matrix.transpose_apply, Matrix.of_apply, hd]
            ring
    rw [← hid]
    have hWS : ∑ a, ∑ c, A a c * (t a * d j (T c) + t c * d j (T a)) =
        ∑ a, ∑ c, d j (A' a c * T a * T c) - ∑ a, ∑ c, t a * t c * d j (A' a c) := by
      rw [hsplit]; ring
    rw [hWS]
    exact Ideal.sub_mem _ hS hE

  have hNunit : IsUnit ((A + A.transpose) * M).det := by
    rw [Matrix.det_mul]; exact hA.mul hM
  exact s3 _ hNunit hW

theorem wc_ldnm_tv_regular (F' : Type u) [Field F'] (E : Type u) [Field E] [Finite E]
    [Algebra F' E] (Y : Over (Spec (.of F'))) (n N : ℕ) (hn2 : 2 ≤ n)
    (P : wcPreDatum F' E Y n) (X : Over (Spec (.of E))) [IsProper X.hom]
    [GeometricallyIrreducible X.hom] [SmoothOfRelativeDimension n X.hom]
    (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr E N = X.hom)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
    (y : Fin P.m → (Spec (.of E) ⟶ X.left)) (c : Fin P.m → Fin 2 → E)
    (hP : wcLdpGoodPencil E N n X ι G₀ G₁ P.m y c)
    (g : P.Yt.left ⟶ Limits.pullback X.hom (wcProjKStr E 1))
    (hY : wcLdnmLocEq (Limits.pullback X.hom (wcProjKStr E 1)) (Fin (N + 1) × Fin 2)
      (wcLdpW E N X ι) (wcLdpH E N X ι G₀ G₁) P.Yt.left g)
    (hg : g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom = P.Yt.hom)
    (hPf : P.f = g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1))
    (hxs : ∀ i, P.xs i ≫ g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) = y i)
    (v₀ v₁ : Fin (N + 1) × Fin (N + 1) → E)
    (hv₀ : G₀ = wcLdpQuad E N (fun p q => v₀ (p, q)))
    (hv₁ : G₁ = wcLdpQuad E N (fun p q => v₁ (p, q)))
    (Z : Scheme.{u}) (k : Z ⟶ Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
    (hZ : wcLdnmLocEq (Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
      (Fin (N + 1) × Fin (wcLdnmM N + 1)) (wcLdnmU E N X ι) (wcLdnmPhi E N X ι) Z k)
    (lam : (wcP1Over E).left ⟶ wcProjK E (wcLdnmM N)) (hlam : IsClosedImmersion lam)
    (hlamS : lam ≫ wcProjKStr E (wcLdnmM N) = (wcP1Over E).hom)
    (hrule : wcLdnmPencilRule E N v₀ v₁ lam)
    (p : P.Yt.left ⟶ Z)
    (hp : IsPullback p P.f (k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) lam) :
    ∀ (i : Fin P.m)
      (e' : (k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)))
        (p (P.xs i (IsLocalRing.closedPoint E))) = lam (P.S i (IsLocalRing.closedPoint E))),
      IsRegularLocalRing
          ((wcProjK E (wcLdnmM N)).presheaf.stalk (lam (P.S i (IsLocalRing.closedPoint E)))) ∧
        ringKrullDim
            ((wcProjK E (wcLdnmM N)).presheaf.stalk (lam (P.S i (IsLocalRing.closedPoint E)))) =
          ((wcLdnmM N : ℕ) : WithBot ℕ∞) ∧
        IsRegularLocalRing (Z.presheaf.stalk (p (P.xs i (IsLocalRing.closedPoint E)))) ∧
        ringKrullDim (Z.presheaf.stalk (p (P.xs i (IsLocalRing.closedPoint E)))) =
          ((n + wcLdnmM N - 1 : ℕ) : WithBot ℕ∞) ∧
        IsRegularLocalRing ((wcP1Over E).left.presheaf.stalk (P.S i (IsLocalRing.closedPoint E))) ∧
        ringKrullDim ((wcP1Over E).left.presheaf.stalk (P.S i (IsLocalRing.closedPoint E))) =
          ((1 : ℕ) : WithBot ℕ∞) ∧
        ∀ a : Z.presheaf.stalk (p (P.xs i (IsLocalRing.closedPoint E))),
          ∃ b : (wcProjK E (wcLdnmM N)).presheaf.stalk (lam (P.S i (IsLocalRing.closedPoint E))),
            a - wcLdnmTvRho (k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)))
                (p (P.xs i (IsLocalRing.closedPoint E))) (lam (P.S i (IsLocalRing.closedPoint E)))
                e' b ∈
              IsLocalRing.maximalIdeal (Z.presheaf.stalk (p (P.xs i (IsLocalRing.closedPoint E)))) :=
by
  intro i e'

  have L2 : ∀ {Z' Y' : Scheme.{u}} (h' : Z' ⟶ Y') (sY : Y' ⟶ Spec (.of E)) (z' : Z') (y' : Y')
      (e : h' z' = y') (c' : E),
      wcLdnmTvRho h' z' y' e (wcLdpConst E sY y' c') = wcLdpConst E (h' ≫ sY) z' c' := by
    intro Z' Y' h' sY z' y' e c'
    subst e
    unfold wcLdnmTvRho
    rw [TopCat.Presheaf.stalkSpecializes_refl]
    simp only [CommRingCat.hom_id, RingHom.comp_id]
    simp only [wcLdpConst, RingHom.comp_apply]
    have := Scheme.Hom.germ_stalkMap_apply h' ⊤ z' trivial
      (sY.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom c'))
    rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    exact this

  have L1a : ∀ (V : Scheme.{u}) (sV : V ⟶ Spec (.of E)) (σ : Spec (.of E) ⟶ V)
      (_ : σ ≫ sV = 𝟙 _) (pt : Spec (.of E)) (v : V) (_ : σ pt = v),
      IsClosed ({v} : Set V) ∧
        ∀ y' : V.presheaf.stalk v, ∃ c' : E,
          y' - wcLdpConst E sV v c' ∈ IsLocalRing.maximalIdeal (V.presheaf.stalk v) := by
    intro V sV σ hσ pt v hv
    subst hv
    haveI hci : IsClosedImmersion σ := isClosedImmersion_of_comp_eq_id sV σ hσ
    constructor
    · have hr : Set.range σ = {σ pt} := by
        ext x
        constructor
        · rintro ⟨w, rfl⟩
          rw [Subsingleton.elim w pt]
          rfl
        · rintro rfl
          exact ⟨_, rfl⟩
      rw [← hr]
      exact σ.isClosedEmbedding.isClosed_range
    · intro y'
      have key : ∀ c' : E, (σ.stalkMap pt).hom (wcLdpConst E sV (σ pt) c') =
          ((Spec (.of E)).presheaf.germ ⊤ pt trivial).hom
            ((Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom c') := by
        intro c'
        simp only [wcLdpConst, RingHom.comp_apply]
        have h0 := Scheme.Hom.germ_stalkMap_apply σ ⊤ pt trivial
          (sV.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom c'))
        have h1 : (σ.appTop).hom
            (sV.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom c')) =
            (Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom c' := by
          rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Scheme.Hom.comp_appTop, hσ,
            Scheme.Hom.id_appTop, CommRingCat.hom_id, RingHom.id_apply]
        refine h0.trans ?_
        exact congrArg _ h1
      obtain ⟨U, hU, w, hw⟩ :=
        (Spec (.of E)).presheaf.exists_germ_eq ((σ.stalkMap pt).hom y')
      have hUt : U = ⊤ := by
        ext x
        simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true, SetLike.mem_coe]
        exact Subsingleton.elim pt x ▸ hU
      subst hUt
      refine ⟨(Scheme.ΓSpecIso (CommRingCat.of E)).hom.hom w, ?_⟩
      have hinv : (Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom
          ((Scheme.ΓSpecIso (CommRingCat.of E)).hom.hom w) = w := by
        rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, Iso.hom_inv_id, CommRingCat.hom_id,
          RingHom.id_apply]
      have hzero : (σ.stalkMap pt).hom
          (y' - wcLdpConst E sV (σ pt) ((Scheme.ΓSpecIso (CommRingCat.of E)).hom.hom w)) = 0 := by
        rw [map_sub, key, hinv, ← hw]
        exact sub_self _
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have := hu.map (σ.stalkMap pt).hom
      rw [hzero] at this
      exact not_isUnit_zero this

  have L1b : ∀ (V : Scheme.{u}) (sV : V ⟶ Spec (.of E)) (m : ℕ)
      [SmoothOfRelativeDimension m sV] (v : V), IsClosed ({v} : Set V) →
      (∀ y' : V.presheaf.stalk v, ∃ c' : E,
        y' - wcLdpConst E sV v c' ∈ IsLocalRing.maximalIdeal (V.presheaf.stalk v)) →
      IsRegularLocalRing (V.presheaf.stalk v) ∧
        ringKrullDim (V.presheaf.stalk v) = (m : WithBot ℕ∞) := by
    intro V sV m _ v hv hrat
    haveI := SmoothOfRelativeDimension.smooth m sV
    haveI : IsLocallyNoetherian V := LocallyOfFiniteType.isLocallyNoetherian sV
    have hdim := wc_lfi_smooth_stalk_dim E V sV m v hv
    letI := (wcLdpConst E sV v).toAlgebra
    obtain ⟨hfs, hfree, hfin, hrk, -⟩ := wc_ldp_il_stalk_of_smooth_field E sV m v
    have hκ : Algebra.FormallySmooth E (IsLocalRing.ResidueField (V.presheaf.stalk v)) := by
      have hsurj : Function.Surjective
          (Algebra.ofId E (IsLocalRing.ResidueField (V.presheaf.stalk v))) := by
        intro x
        obtain ⟨y', rfl⟩ := IsLocalRing.residue_surjective x
        obtain ⟨c', hc⟩ := hrat y'
        refine ⟨c', ?_⟩
        rw [Algebra.ofId_apply]
        show IsLocalRing.residue _ (wcLdpConst E sV v c') = IsLocalRing.residue _ y'
        rw [eq_comm, ← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
        exact hc
      exact Algebra.FormallySmooth.of_equiv
        (AlgEquiv.ofBijective (Algebra.ofId E _) ⟨RingHom.injective _, hsurj⟩)
    have hle := wcpa_embdim_le_rank_omega E (V.presheaf.stalk v) hfs hfree hfin hκ
    rw [hrk] at hle
    have hge := ringKrullDim_le_spanFinrank_maximalIdeal (V.presheaf.stalk v)
    rw [hdim] at hge
    have hge' : m ≤ Submodule.spanFinrank (IsLocalRing.maximalIdeal (V.presheaf.stalk v)) := by
      exact_mod_cast hge
    have heq : Submodule.spanFinrank (IsLocalRing.maximalIdeal (V.presheaf.stalk v)) = m :=
      le_antisymm hle hge'
    exact ⟨IsRegularLocalRing.mk (by rw [heq, hdim]), hdim⟩

  haveI hP1 : SmoothOfRelativeDimension 1 (wcP1Over E).hom := wc_proj_space_smooth E 1
  haveI hPM : SmoothOfRelativeDimension (wcLdnmM N) (wcProjKStr E (wcLdnmM N)) :=
    wc_proj_space_smooth E (wcLdnmM N)
  have heq : k ≫ Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)) ≫ X.hom =
      (k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) ≫ wcProjKStr E (wcLdnmM N) := by
    rw [Limits.pullback.condition, Category.assoc]
  haveI hZs : SmoothOfRelativeDimension (n + wcLdnmM N - 1)
      ((k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) ≫ wcProjKStr E (wcLdnmM N)) := by
    rw [← heq]
    exact wc_ldnm_univ_smooth E N n X ι hι hιX Z k hZ

  obtain ⟨hc3, hr3⟩ := L1a (wcP1Over E).left (wcP1Over E).hom (P.S i) (P.hS i)
    (IsLocalRing.closedPoint E) _ rfl
  obtain ⟨r3, d3⟩ := L1b _ _ 1 _ hc3 hr3

  have hσ1 : (P.S i ≫ lam) ≫ wcProjKStr E (wcLdnmM N) = 𝟙 _ := by
    rw [Category.assoc, hlamS, P.hS i]
  obtain ⟨hc1, hr1⟩ := L1a _ (wcProjKStr E (wcLdnmM N)) (P.S i ≫ lam) hσ1
    (IsLocalRing.closedPoint E) (lam (P.S i (IsLocalRing.closedPoint E)))
    (Scheme.Hom.comp_apply _ _ _)
  obtain ⟨r1, d1⟩ := L1b _ _ (wcLdnmM N) _ hc1 hr1

  have hσ2 : (P.xs i ≫ p) ≫ (k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) ≫
      wcProjKStr E (wcLdnmM N) = 𝟙 _ := by
    have hw := hp.w
    calc (P.xs i ≫ p) ≫ (k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) ≫
          wcProjKStr E (wcLdnmM N)
        = P.xs i ≫ (p ≫ (k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)))) ≫
          wcProjKStr E (wcLdnmM N) := by simp only [Category.assoc]
      _ = P.xs i ≫ (P.f ≫ lam) ≫ wcProjKStr E (wcLdnmM N) := by rw [hw]
      _ = (P.xs i ≫ P.f) ≫ (lam ≫ wcProjKStr E (wcLdnmM N)) := by simp only [Category.assoc]
      _ = 𝟙 _ := by rw [P.hxs i, hlamS, P.hS i]
  obtain ⟨hc2, hr2⟩ := L1a _ _ (P.xs i ≫ p) hσ2
    (IsLocalRing.closedPoint E) (p (P.xs i (IsLocalRing.closedPoint E)))
    (Scheme.Hom.comp_apply _ _ _)
  obtain ⟨r2, d2⟩ := L1b _ _ (n + wcLdnmM N - 1) _ hc2 hr2
  refine ⟨r1, d1, r2, d2, r3, d3, ?_⟩

  intro a
  obtain ⟨c', hc'⟩ := hr2 a
  refine ⟨wcLdpConst E (wcProjKStr E (wcLdnmM N)) (lam (P.S i (IsLocalRing.closedPoint E))) c', ?_⟩
  rw [L2]
