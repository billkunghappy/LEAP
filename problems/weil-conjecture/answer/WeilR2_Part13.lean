  obtain ⟨E, _, _, _, jE, hjE, hjEY, G₀, G₁, m, y, c, hP⟩ :=
    wc_ldp_good_pencil_exists F' Y n hn hn2 N j hj hjY
      (fun E _ _ => wc_ldp_base_change_embedded F' Y N j hj hjY E)

  set X : Over (Spec (.of E)) :=
    Over.mk (Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))))
    with hXdef
  haveI hXp : IsProper X.hom :=
    (inferInstance : IsProper
      (Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E)))))
  haveI hXgi : GeometricallyIrreducible X.hom :=
    (inferInstance : GeometricallyIrreducible
      (Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E)))))
  haveI hXs : SmoothOfRelativeDimension n X.hom :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension n)
      (IsPullback.of_hasPullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))))
      (inferInstance : SmoothOfRelativeDimension n Y.hom)
  have hP' := hP
  obtain ⟨hP0, _, hy, hoff, hc0, hnp, _, hodp⟩ := hP'

  obtain ⟨Yt, g, hLoc, hgc, hg, hYtp, hbs, ⟨V, hV, hbV⟩, hloc, hlift, hrat, hfib, M, jt, hjt,
      hjtY⟩ := hinc E N X jE hjE hjEY G₀ G₁

  have hxs0 : ∀ i, ∃ z : Spec (.of E) ⟶ Yt.left,
      z ≫ g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) = y i := fun i => hlift (y i) (hoff i)
  choose xs hxs using hxs0
  haveI : IsProper Yt.hom := hYtp
  obtain ⟨hsm, hsmoff, hodpY⟩ :=
    wc_ldp_incidence_local E N n X jE hjE hjEY G₀ G₁ m y c hP Yt g hgc hg V hV hbV hloc xs hxs
  haveI : SmoothOfRelativeDimension n Yt.hom := hsm
  have hf : (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) ≫ (wcP1Over E).hom = Yt.hom := by
    show (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) ≫ wcProjKStr E 1 = Yt.hom
    rw [Category.assoc, ← Limits.pullback.condition]
    exact hg
  have hconn : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (t : Spec (.of Ω) ⟶ (wcP1Over E).left),
      ConnectedSpace ↥(Limits.pullback (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) t) := by
    intro Ω _ _ t
    obtain ⟨W, q, r, κ, H, hpb, hκ, hκr, ⟨e⟩⟩ := hfib Ω t
    haveI : IrreducibleSpace W :=
      GeometricallyIrreducible.geometrically_irreducibleSpace (f := X.hom)
        (t ≫ wcProjKStr E 1) q r hpb
    haveI : SmoothOfRelativeDimension n r :=
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension n) hpb hXs
    have hc := wc_ldp_quadric_section_connected Ω N n hn2 W r κ hκ hκr H
    haveI : ConnectedSpace ↥{w : W | wcLdpZero Ω N κ H w} :=
      isConnected_iff_connectedSpace.mp hc
    exact e.symm.surjective.connectedSpace e.symm.continuous
  have hgi : GeometricallyIrreducible Yt.hom :=
    wc_ldp_gi_of_connected_fibres E Yt n (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) hf hconn
  have hb_pt : ∀ k, (g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1))
      (xs k (IsLocalRing.closedPoint E)) = y k (IsLocalRing.closedPoint E) := by
    intro k
    rw [← hxs k]
    first
      | rfl
      | exact (Scheme.Hom.comp_apply (xs k) (g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) _).symm
  have hzero : ∀ k, wcLdpZero E N jE (c k 1 • G₀ - c k 0 • G₁)
      (y k (IsLocalRing.closedPoint E)) := by
    intro k a hx
    obtain ⟨t, A, hm, h3, -⟩ := hodp k a hx
    have ht : ∀ l, t l ∈ IsLocalRing.maximalIdeal
        (X.left.presheaf.stalk (y k (IsLocalRing.closedPoint E))) := fun l => by
      rw [hm]; exact Ideal.subset_span ⟨l, rfl⟩
    have hs : ∑ k', ∑ l, A k' l * t k' * t l ∈ IsLocalRing.maximalIdeal
        (X.left.presheaf.stalk (y k (IsLocalRing.closedPoint E))) :=
      Ideal.sum_mem _ fun k' _ => Ideal.sum_mem _ fun l _ => Ideal.mul_mem_left _ _ (ht l)
    have h1 := Ideal.add_mem _ (Ideal.pow_le_self (by norm_num) h3) hs
    rwa [sub_add_cancel] at h1

  have hbfin : ∃ V' : (Limits.pullback Y.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' E)))).Opens,
      V' ≠ ⊥ ∧ IsFinite ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ∣_ V') := by
    obtain ⟨x, hx⟩ := hP0
    refine ⟨V, ?_, ?_⟩
    · intro hV0
      have hxV : x ∈ V := (hV x).mpr hx
      rw [hV0] at hxV
      exact TopologicalSpace.Opens.mem_bot.mp hxV
    · haveI := hbV
      exact (inferInstance : IsFinite ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ∣_ V))
  have hS : ∀ i, (xs i ≫ g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) ≫
      (wcP1Over E).hom = 𝟙 _ := by
    intro i
    show (xs i ≫ g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) ≫ wcProjKStr E 1 = 𝟙 _
    rw [Category.assoc, Category.assoc, ← Limits.pullback.condition, ← hy i, ← hxs i]
    simp only [Category.assoc]
    rfl
  have hSinj : Function.Injective (fun i =>
      (xs i ≫ g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) (IsLocalRing.closedPoint E)) := by
    intro i i' hii'
    by_contra hne
    have key := hrat (xs i (IsLocalRing.closedPoint E)) (xs i' (IsLocalRing.closedPoint E))
      (c i) (c i') (hc0 i) (hc0 i')
      (by rw [hb_pt]; exact hoff i) (by rw [hb_pt]; exact hoff i')
      (by rw [hb_pt]; exact hzero i) (by rw [hb_pt]; exact hzero i')
      hii'
    exact hnp i i' hne key

  let P : wcPreDatum F' E Y n := {
    Yt := Yt
    gi := hgi
    proper := hYtp
    smooth := hsm
    b := g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)
    hb := by rw [Category.assoc]; exact hg
    bsurj := hbs
    bfin := hbfin
    f := g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)
    hf := hf
    fconn := hconn
    m := m
    S := fun i => xs i ≫ g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)
    hS := hS
    hSinj := hSinj
    xs := xs
    hxs := fun i => rfl
    smooth_off := hsmoff
    odp := hodpY
    M := M
    jt := jt
    hjt := hjt
    hjtY := hjtY }

  exact ⟨E, inferInstance, inferInstance, inferInstance, P, X, hXp, hXgi, hXs, jE, G₀, G₁, y, c,
    g, hjE, hjEY, hP, hLoc, hg, rfl, hxs⟩

theorem wc_ldnm_N_pos (E : Type u) [Field E] (N n : ℕ) (X : Over (Spec (.of E)))
    [IsProper X.hom] [GeometricallyIrreducible X.hom] [SmoothOfRelativeDimension n X.hom]
    (hn : 1 ≤ n) (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι) : 1 ≤ N :=
by
  classical

  have s2fin : ∀ (k : ℕ) (𝔪 : Ideal (MvPolynomial (Fin k) E)),
      𝔪.IsMaximal → (k : ℕ∞) ≤ 𝔪.height := by
    intro k
    induction k with
    | zero => intro _ _; simp
    | succ k ih =>
      intro 𝔪 h𝔪
      let φ := (MvPolynomial.finSuccEquiv E k).toRingEquiv
      have hPm : (Ideal.map φ 𝔪).IsMaximal := Ideal.map_isMaximal_of_equiv φ
      have hPh : (Ideal.map φ 𝔪).height = 𝔪.height := RingEquiv.height_map φ 𝔪
      have hpm : (Ideal.comap Polynomial.C (Ideal.map φ 𝔪)).IsMaximal :=
        Polynomial.isMaximal_comap_C_of_isJacobsonRing _
      haveI : (Ideal.map φ 𝔪).LiesOver (Ideal.comap Polynomial.C (Ideal.map φ 𝔪)) :=
        ⟨by rw [Ideal.under_def, Polynomial.algebraMap_eq]⟩
      have h := Polynomial.height_eq_height_add_one (Ideal.comap Polynomial.C (Ideal.map φ 𝔪))
        (Ideal.map φ 𝔪)
      have h2 := ih _ hpm
      rw [← hPh, h]
      push_cast
      exact add_le_add h2 le_rfl
  have s2 : ∀ (ι' : Type) [Finite ι'] (𝔭 : Ideal (MvPolynomial ι' E)), 𝔭.IsMaximal →
      (Nat.card ι' : ℕ∞) ≤ 𝔭.height := by
    intro ι' _ 𝔭 h𝔭
    let e := (MvPolynomial.renameEquiv E (Finite.equivFin ι')).toRingEquiv
    have hm : (Ideal.map e 𝔭).IsMaximal := Ideal.map_isMaximal_of_equiv e
    rw [← RingEquiv.height_map e 𝔭]
    exact s2fin _ _ hm

  have s3 : ∀ (S : Type u) [CommRing S] [Algebra E S] [Nontrivial S]
      [Subsingleton (PrimeSpectrum S)] (ι' σ : Type) [Finite ι'] [Finite σ]
      (P : Algebra.Presentation E S ι' σ),
      ∃ 𝔭 : Ideal (MvPolynomial ι' E), 𝔭.IsMaximal ∧ 𝔭.height ≤ (Nat.card σ : ℕ∞) := by
    intro S _ _ _ _ ι' σ _ _ P
    haveI := Fintype.ofFinite σ
    let φ : MvPolynomial ι' E →+* S := algebraMap P.Ring S
    have hφ : Function.Surjective φ := P.algebraMap_surjective
    obtain ⟨M, hM⟩ := Ideal.exists_maximal S
    refine ⟨Ideal.comap φ M, Ideal.comap_isMaximal_of_surjective φ hφ, ?_⟩
    have hker : Ideal.span (Set.range P.relation) = RingHom.ker φ := P.span_range_relation_eq_ker
    have hmin : Ideal.comap φ M ∈ (Ideal.span ((Finset.univ.image P.relation : Finset _) :
        Set (MvPolynomial ι' E))).minimalPrimes := by
      rw [Finset.coe_image, Finset.coe_univ, Set.image_univ, hker]
      refine ⟨⟨Ideal.comap_isPrime φ M, ?_⟩, ?_⟩
      · rw [RingHom.ker_eq_comap_bot]; exact Ideal.comap_mono bot_le
      · rintro q ⟨hq, hkq⟩ _
        haveI := hq
        have hmq : (Ideal.map φ q).IsPrime := Ideal.map_isPrime_of_surjective hφ hkq
        have hqM : Ideal.map φ q = M := congrArg PrimeSpectrum.asIdeal
          (Subsingleton.elim (⟨_, hmq⟩ : PrimeSpectrum S) ⟨M, hM.isPrime⟩)
        rw [← hqM, Ideal.comap_map_of_surjective φ hφ q]
        exact sup_le le_rfl (by rwa [← RingHom.ker_eq_comap_bot])
    refine (Ideal.height_le_card_of_mem_minimalPrimes_span_finset hmin).trans ?_
    have : (Finset.univ.image P.relation).card ≤ Nat.card σ := by
      rw [Nat.card_eq_fintype_card, ← Finset.card_univ]
      exact Finset.card_image_le
    exact_mod_cast this

  have s4 : ∀ [Subsingleton ↥X.left] (x : ↥X.left),
      ∃ (S : Type u) (_ : CommRing S) (_ : Algebra E S),
        Algebra.IsStandardSmoothOfRelativeDimension n E S ∧ Nontrivial S ∧
          Subsingleton (PrimeSpectrum S) := by
    intro _ x
    obtain ⟨U, hU, V, hV, hxV, e, hstd⟩ :=
      SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := n) (f := X.hom) x
    have hUtop : U = ⊤ := by
      have hx : X.hom x ∈ U := e hxV
      ext y
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      rwa [Subsingleton.elim y (X.hom x)]
    subst hUtop
    let f : E →+* Γ(Spec (.of E), ⊤) := (Scheme.ΓSpecIso (.of E)).inv.hom
    have hfb : Function.Bijective f :=
      ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of E)).inv
    have hf : RingHom.IsStandardSmoothOfRelativeDimension 0 f := by
      letI := f.toAlgebra
      exact Algebra.IsStandardSmoothOfRelativeDimension.of_algebraMap_bijective hfb
    have hc := hstd.comp hf
    rw [add_zero] at hc
    letI alg : Algebra E Γ(X.left, V) := ((X.hom.appLE ⊤ V e).hom.comp f).toAlgebra
    let h := Scheme.Hom.homeomorph hV.isoSpec.hom
    haveI : Subsingleton ↥(V : Scheme) :=
      ⟨fun a b => Subtype.ext (Subsingleton.elim (α := X.left) _ _)⟩
    refine ⟨Γ(X.left, V), inferInstance, alg, hc, ?_, ?_⟩
    · exact PrimeSpectrum.nonempty_iff_nontrivial.mp ⟨h ⟨x, hxV⟩⟩
    · exact h.symm.toEquiv.subsingleton
  by_contra hN
  have hN0 : N = 0 := by omega
  subst hN0

  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (0 + 1)) E) :=
    MvPolynomial.gradedAlgebra
  have s1 : ∀ x : ↥(wcProjK E 0), x.asHomogeneousIdeal.toIdeal = ⊥ := by
    intro x
    set I := x.asHomogeneousIdeal.toIdeal with hI
    have hdd : ∀ d : Fin (0 + 1) →₀ ℕ, d = Finsupp.single 0 (d 0) := by
      intro d
      ext j
      rw [show j = 0 from Fin.fin_one_eq_zero j]
      simp
    have hF : ∀ (a : MvPolynomial (Fin (0 + 1)) E) (i : ℕ), MvPolynomial.homogeneousComponent i a =
        MvPolynomial.C (a.coeff (Finsupp.single 0 i)) * MvPolynomial.X 0 ^ i := by
      intro a i
      ext d
      rw [MvPolynomial.coeff_homogeneousComponent, MvPolynomial.C_mul_X_pow_eq_monomial,
        MvPolynomial.coeff_monomial]
      have hdeg : Finsupp.degree d = d 0 := by
        rw [hdd d]; simp
      rw [hdeg]
      by_cases h : d 0 = i
      · subst h
        rw [if_pos rfl, if_pos (hdd d).symm, ← hdd d]
      · rw [if_neg h, if_neg]
        intro h'
        apply h
        rw [← h']
        simp
    have hH : ∀ y ∈ I, ∀ i, MvPolynomial.homogeneousComponent i y ∈ I := by
      intro y hy i
      have := (Ideal.IsHomogeneous.mem_iff _ x.asHomogeneousIdeal.isHomogeneous).mp hy i
      rwa [← MvPolynomial.decomposition.decompose'_apply]
    have ha : (MvPolynomial.X 0 : MvPolynomial (Fin (0 + 1)) E) ∉ I := by
      intro hX
      apply x.not_irrelevant_le
      intro a ha
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at ha
      have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
        rw [← MvPolynomial.decomposition.decompose'_apply]
        exact ha
      show a ∈ I
      rw [← MvPolynomial.sum_homogeneousComponent a]
      refine Ideal.sum_mem _ (fun i _ => ?_)
      rcases Nat.eq_zero_or_pos i with rfl | hi
      · rw [h0]; exact I.zero_mem
      · rw [hF, show i = (i - 1) + 1 by omega, pow_succ, ← mul_assoc]
        exact Ideal.mul_mem_left _ _ hX
    ext y
    simp only [Submodule.mem_bot]
    constructor
    · intro hy
      ext d
      rw [hdd d, MvPolynomial.coeff_zero]
      by_contra hc
      have h1 := hH y hy (d 0)
      rw [hF] at h1
      have h2 : (MvPolynomial.X 0 : MvPolynomial (Fin (0 + 1)) E) ^ (d 0) ∈ I := by
        have := Ideal.mul_mem_left I
          (MvPolynomial.C (y.coeff (Finsupp.single 0 (d 0)))⁻¹) h1
        rwa [← mul_assoc, ← MvPolynomial.C_mul, inv_mul_cancel₀ hc, MvPolynomial.C_1,
          one_mul] at this
      exact ha (x.isPrime.mem_of_pow_mem _ h2)
    · rintro rfl; exact I.zero_mem
  haveI hsub0 : Subsingleton ↥(wcProjK E 0) :=
    ⟨fun a b => ProjectiveSpectrum.ext (HomogeneousIdeal.ext ((s1 a).trans (s1 b).symm))⟩
  have hinj : Function.Injective ι := ι.isClosedEmbedding.isEmbedding.injective
  haveI : Subsingleton ↥X.left := hinj.subsingleton
  haveI : IrreducibleSpace ↥X.left :=
    GeometricallyIrreducible.geometrically_irreducibleSpace (f := X.hom) (𝟙 (Spec (.of E)))
      (𝟙 X.left) X.hom (IsPullback.id_horiz X.hom)
  obtain ⟨x⟩ := (inferInstance : Nonempty ↥X.left)
  obtain ⟨S, _, _, hstd, hnt, hsub⟩ := s4 x
  obtain ⟨ι', σ, _, _, P, hP⟩ := hstd.out
  obtain ⟨𝔭, h𝔭max, h𝔭⟩ := s3 S ι' σ P.toPresentation
  have h2 := s2 ι' 𝔭 h𝔭max
  have h3 : Nat.card ι' ≤ Nat.card σ := by exact_mod_cast h2.trans h𝔭
  have h4 : Nat.card ι' - Nat.card σ = n := hP
  omega

theorem wc_ldnm_pencil_coeffs (E : Type u) [Field E] (N n : ℕ) (hn2 : 2 ≤ n)
    (X : Over (Spec (.of E))) [IsProper X.hom] [GeometricallyIrreducible X.hom]
    [SmoothOfRelativeDimension n X.hom] (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι)
    (hιX : ι ≫ wcProjKStr E N = X.hom)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) (m : ℕ)
    (y : Fin m → (Spec (.of E) ⟶ X.left)) (c : Fin m → Fin 2 → E)
    (hP : wcLdpGoodPencil E N n X ι G₀ G₁ m y c) :
    ∃ v₀ v₁ : Fin (N + 1) × Fin (N + 1) → E,
      G₀ = wcLdpQuad E N (fun p q => v₀ (p, q)) ∧ G₁ = wcLdpQuad E N (fun p q => v₁ (p, q)) ∧
      ∀ l₀ l₁ : E, (∀ q, l₀ * v₀ q + l₁ * v₁ q = 0) → l₀ = 0 ∧ l₁ = 0 :=
by
  classical

  have quad_reconstruct : ∀ (P : MvPolynomial (Fin (N+1)) E), P.IsHomogeneous 2 →
      P = ∑ p, ∑ q, MvPolynomial.C (if p ≤ q then
        P.coeff (Finsupp.single p 1 + Finsupp.single q 1) else 0) *
        (MvPolynomial.X p * MvPolynomial.X q) := by
    intro P hP
    have huniq : ∀ p q p' q' : Fin (N + 1), p ≤ q → p' ≤ q' →
        Finsupp.single p 1 + Finsupp.single q 1 = Finsupp.single p' 1 + Finsupp.single q' 1 →
        p = p' ∧ q = q' := by
      intro p q p' q' hpq hpq' h
      rw [Finsupp.single_add_single_eq_single_add_single one_ne_zero one_ne_zero] at h
      rcases h with ⟨h1, h2⟩ | ⟨_, h1, h2⟩ | ⟨h, _⟩
      · exact ⟨h1, h2⟩
      · subst h1 h2
        exact ⟨le_antisymm hpq hpq', le_antisymm hpq' hpq⟩
      · exact absurd h (by norm_num)
    have hX : ∀ i : Fin (N + 1), (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) E) =
        MvPolynomial.monomial (Finsupp.single i 1) 1 := fun i => rfl
    ext e
    simp only [MvPolynomial.coeff_sum]
    have hterm : ∀ p q : Fin (N+1), (MvPolynomial.C (if p ≤ q then
        P.coeff (Finsupp.single p 1 + Finsupp.single q 1) else 0) *
        (MvPolynomial.X p * MvPolynomial.X q)).coeff e =
        if Finsupp.single p 1 + Finsupp.single q 1 = e ∧ p ≤ q then P.coeff e
        else 0 := by
      intro p q
      rw [hX, hX, MvPolynomial.monomial_mul, MvPolynomial.C_mul_monomial,
        MvPolynomial.coeff_monomial]
      by_cases h1 : Finsupp.single p 1 + Finsupp.single q 1 = e
      · by_cases h2 : p ≤ q
        · simp [h1, h2]
        · simp [h1, h2]
      · simp [h1]
    simp only [hterm]
    by_cases hdeg : Finsupp.degree e = 2
    · have hcard : Multiset.card (Finsupp.toMultiset e) = 2 := by
        rw [Finsupp.card_toMultiset, ← hdeg, Finsupp.degree_eq_sum, Finsupp.sum_fintype]
        · rfl
        · intro; rfl
      obtain ⟨a, b, hab⟩ := Multiset.card_eq_two.mp hcard
      have he : e = Finsupp.single a 1 + Finsupp.single b 1 := by
        have h1 : Multiset.toFinsupp (Finsupp.toMultiset e) = e := Finsupp.toMultiset_toFinsupp e
        rw [← h1, hab]
        rw [Multiset.insert_eq_cons, ← Multiset.singleton_add, Multiset.toFinsupp_add,
          Multiset.toFinsupp_singleton, Multiset.toFinsupp_singleton]
      obtain ⟨p₀, q₀, hpq₀, he₀⟩ : ∃ p₀ q₀ : Fin (N + 1), p₀ ≤ q₀ ∧
          e = Finsupp.single p₀ 1 + Finsupp.single q₀ 1 := by
        rcases le_total a b with h | h
        · exact ⟨a, b, h, he⟩
        · exact ⟨b, a, h, he.trans (add_comm _ _)⟩
      rw [Finset.sum_eq_single p₀, Finset.sum_eq_single q₀]
      · simp [he₀, hpq₀]
      · intro q _ hq
        rw [if_neg]
        rintro ⟨h1, h2⟩
        exact hq (huniq p₀ q p₀ q₀ h2 hpq₀ (h1.trans he₀)).2
      · simp
      · intro p _ hp
        apply Finset.sum_eq_zero
        intro q _
        rw [if_neg]
        rintro ⟨h1, h2⟩
        exact hp (huniq p q p₀ q₀ h2 hpq₀ (h1.trans he₀)).1
      · simp
    · rw [hP.coeff_eq_zero hdeg]
      simp
  have recon : ∀ G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2,
      ∃ v : Fin (N + 1) × Fin (N + 1) → E, G = wcLdpQuad E N (fun p q => v (p, q)) := by
    intro G
    refine ⟨fun pq => if pq.1 ≤ pq.2 then
      (G : MvPolynomial (Fin (N + 1)) E).coeff (Finsupp.single pq.1 1 + Finsupp.single pq.2 1)
      else 0, ?_⟩
    apply Subtype.ext
    exact quad_reconstruct (G : MvPolynomial (Fin (N + 1)) E)
      ((MvPolynomial.mem_homogeneousSubmodule 2 _).mp G.2)
  obtain ⟨v₀, hv₀⟩ := recon G₀
  obtain ⟨v₁, hv₁⟩ := recon G₁
  refine ⟨v₀, v₁, hv₀, hv₁, ?_⟩
  intro l₀ l₁ h

  have hrel : l₀ • G₀ + l₁ • G₁ = 0 := by
    rw [hv₀, hv₁]
    apply Subtype.ext
    simp only [wcLdpQuad, Submodule.coe_add, Submodule.coe_smul, Submodule.coe_zero]
    rw [Finset.smul_sum, Finset.smul_sum, ← Finset.sum_add_distrib]
    apply Finset.sum_eq_zero
    intro p _
    rw [Finset.smul_sum, Finset.smul_sum, ← Finset.sum_add_distrib]
    apply Finset.sum_eq_zero
    intro q _
    rw [MvPolynomial.smul_eq_C_mul, MvPolynomial.smul_eq_C_mul,
      ← mul_assoc (MvPolynomial.C l₀), ← mul_assoc (MvPolynomial.C l₁),
      ← MvPolynomial.C_mul, ← MvPolynomial.C_mul, ← add_mul, ← MvPolynomial.C_add, h (p, q),
      MvPolynomial.C_0, zero_mul]

  have omega_zero : ∀ (O : Type u) [CommRing O] (κ : E →+* O) (g₀ g₁ : O)
      (c : E), (g₁ = κ c * g₀ ∨ g₀ = κ c * g₁) →
      letI := κ.toAlgebra
      g₀ • KaehlerDifferential.D E O g₁ - g₁ • KaehlerDifferential.D E O g₀ = 0 := by
    intro O _ κ g₀ g₁ c hc
    letI := κ.toAlgebra
    have hD : ∀ g : O, KaehlerDifferential.D E O (κ c * g) =
        κ c • KaehlerDifferential.D E O g := by
      intro g
      rw [Derivation.leibniz]
      have : KaehlerDifferential.D E O (κ c) = 0 := (KaehlerDifferential.D E O).map_algebraMap c
      rw [this, smul_zero, add_zero]
    rcases hc with h | h
    · rw [h, hD, smul_smul, mul_comm g₀, sub_self]
    · rw [h, hD, smul_smul, mul_comm g₁, sub_self]

  have hclosed : ∀ i, IsClosed ({y i (IsLocalRing.closedPoint E)} : Set X.left) := by
    intro i
    haveI : IsClosedImmersion (y i ≫ X.hom) := by rw [hP.2.2.1 i]; infer_instance
    haveI : IsClosedImmersion (y i) := IsClosedImmersion.of_comp (y i) X.hom
    have hr : Set.range (y i) = {y i (IsLocalRing.closedPoint E)} := by
      ext z
      constructor
      · rintro ⟨w, rfl⟩
        have : Subsingleton (Spec (.of E)) := inferInstanceAs (Subsingleton (PrimeSpectrum E))
        rw [Subsingleton.elim w (IsLocalRing.closedPoint E)]
        rfl
      · rintro rfl
        exact ⟨_, rfl⟩
    rw [← hr]
    exact (y i).isClosedEmbedding.isClosed_range
  have hgen_unit : ∀ (U : X.left.Opens) (σ : Γ(X.left, U)) (x' x₀ : X.left), x' ⤳ x₀ →
      ∀ (h0 : x₀ ∈ U) (h1 : x' ∈ U),
      (X.left.presheaf.germ U x₀ h0).hom σ ∉ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x₀) →
      (X.left.presheaf.germ U x' h1).hom σ ∉
        IsLocalRing.maximalIdeal (X.left.presheaf.stalk x') := by
    intro U σ x' x₀ hs h0 h1 hG
    rw [IsLocalRing.notMem_maximalIdeal] at hG ⊢
    have h2 : x₀ ∈ X.left.basicOpen σ := (X.left.mem_basicOpen σ x₀ h0).mpr hG
    have h3 := hs.mem_open (X.left.basicOpen σ).isOpen h2
    exact (X.left.mem_basicOpen σ x' h1).mp h3
  have hgood : ∃ x : X.left, ¬ wcLdpOnAxis E N ι G₀ G₁ x ∧
      ∀ i, x ≠ y i (IsLocalRing.closedPoint E) := by
    obtain ⟨x₀, hx₀⟩ := hP.1
    by_cases hall : ∀ i, x₀ ≠ y i (IsLocalRing.closedPoint E)
    · exact ⟨x₀, hx₀, hall⟩
    push_neg at hall
    obtain ⟨i₀, hi₀⟩ := hall
    have hc₀ : IsClosed ({x₀} : Set X.left) := by rw [hi₀]; exact hclosed i₀
    have hd := wc_lfi_smooth_stalk_dim E X.left X.hom n x₀ hc₀
    have hpos : (0 : WithBot ℕ∞) < ringKrullDim (X.left.presheaf.stalk x₀) := by
      rw [hd]; exact_mod_cast (by omega : 0 < n)
    obtain ⟨P, Q, hPQ⟩ := Order.krullDim_pos_iff.mp hpos
    obtain ⟨𝔭, h𝔭⟩ : ∃ 𝔭 : PrimeSpectrum (X.left.presheaf.stalk x₀),
        𝔭 ≠ IsLocalRing.closedPoint (X.left.presheaf.stalk x₀) := by
      by_cases hP' : P = IsLocalRing.closedPoint (X.left.presheaf.stalk x₀)
      · exact ⟨Q, fun hQ => hPQ.ne (hP'.trans hQ.symm)⟩
      · exact ⟨P, hP'⟩
    set x' := X.left.fromSpecStalk x₀ 𝔭 with hx'def
    have hs : x' ⤳ x₀ := by
      have : x' ∈ Set.range (X.left.fromSpecStalk x₀) := ⟨𝔭, rfl⟩
      rw [Scheme.range_fromSpecStalk] at this
      exact this
    have hne : x' ≠ x₀ := by
      intro h
      apply h𝔭
      apply (X.left.fromSpecStalk x₀).isEmbedding.injective
      rw [← hx'def, h, Scheme.fromSpecStalk_closedPoint]
    refine ⟨x', ?_, ?_⟩
    · obtain ⟨a, ha, hnot⟩ : ∃ (a : Fin (N + 1)) (ha : x₀ ∈ ι ⁻¹ᵁ wcSgD E N a),
          ¬ (wcLdpGerm E N ι G₀ a x₀ ha ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x₀) ∧
            wcLdpGerm E N ι G₁ a x₀ ha ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x₀)) := by
        by_contra hcon
        push_neg at hcon
        exact hx₀ (fun a ha => hcon a ha)
      have ha' : x' ∈ ι ⁻¹ᵁ wcSgD E N a := hs.mem_open (ι ⁻¹ᵁ wcSgD E N a).isOpen ha
      intro hon
      have hon' := hon a ha'
      apply hnot
      constructor
      · by_contra hk
        exact hgen_unit _ _ x' x₀ hs ha ha' hk hon'.1
      · by_contra hk
        exact hgen_unit _ _ x' x₀ hs ha ha' hk hon'.2
    · intro j hj
      have : x₀ ∈ closure ({x'} : Set X.left) := specializes_iff_mem_closure.mp hs
      rw [hj, (hclosed j).closure_eq] at this
      exact hne (hj.trans (Set.mem_singleton_iff.mp this).symm)

  by_contra hne
  obtain ⟨c', hA⟩ : ∃ c' : E, G₁ = c' • G₀ ∨ G₀ = c' • G₁ := by
    by_cases h1 : l₁ = 0
    · have h0 : l₀ ≠ 0 := fun h0 => hne ⟨h0, h1⟩
      rw [h1, zero_smul, add_zero] at hrel
      have hG0 : G₀ = 0 := (smul_eq_zero.mp hrel).resolve_left h0
      exact ⟨0, Or.inr (by rw [hG0, zero_smul])⟩
    · have h2 : l₁ • G₁ = -(l₀ • G₀) := eq_neg_of_add_eq_zero_right hrel
      refine ⟨-(l₁⁻¹ * l₀), Or.inl ?_⟩
      calc G₁ = l₁⁻¹ • (l₁ • G₁) := by rw [smul_smul, inv_mul_cancel₀ h1, one_smul]
        _ = -(l₁⁻¹ * l₀) • G₀ := by
          rw [h2, smul_neg, smul_smul]
          first
            | exact (neg_smul (l₁⁻¹ * l₀) G₀).symm
            | simp [neg_smul]
  obtain ⟨x, hoff, hxne⟩ := hgood
  obtain ⟨a, hx, -⟩ : ∃ (a : Fin (N + 1)) (hx : x ∈ ι ⁻¹ᵁ wcSgD E N a),
      ¬ (wcLdpGerm E N ι G₀ a x hx ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ∧
        wcLdpGerm E N ι G₁ a x hx ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x)) := by
    by_contra hcon
    push_neg at hcon
    exact hoff (fun a ha => hcon a ha)
  have hsub := hP.2.2.2.2.2.2.1 x a hx hoff hxne
  have hlin := (wc_ldp_germ_linear E N X.hom ι hιX x a a hx hx).2.1
  have hrelg : wcLdpGerm E N ι G₁ a x hx =
        wcLdpConst E X.hom x c' * wcLdpGerm E N ι G₀ a x hx ∨
      wcLdpGerm E N ι G₀ a x hx =
        wcLdpConst E X.hom x c' * wcLdpGerm E N ι G₁ a x hx := by
    rcases hA with hA | hA
    · left; rw [hA]; exact hlin c' G₀
    · right; rw [hA]; exact hlin c' G₁
  have hω := omega_zero (X.left.presheaf.stalk x) (wcLdpConst E X.hom x)
    (wcLdpGerm E N ι G₀ a x hx) (wcLdpGerm E N ι G₁ a x hx) c' hrelg
  unfold wcLdpSubmersive at hsub
  rw [hω] at hsub
  exact hsub (Submodule.zero_mem _)

theorem wc_ldnm_univ_chart_data (E : Type u) [Field E] (N : ℕ) (X : Over (Spec (.of E)))
    (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι) :
    (∀ p, IsAffineOpen (wcLdnmU E N X ι p)) ∧ (⨆ p, wcLdnmU E N X ι p) = ⊤ ∧
    ∀ p q, ∃ u : Γ(Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)),
        wcLdnmU E N X ι p ⊓ wcLdnmU E N X ι q),
      IsUnit u ∧
      (Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.map
          (homOfLE (inf_le_right : wcLdnmU E N X ι p ⊓ wcLdnmU E N X ι q ≤ wcLdnmU E N X ι q)).op
          (wcLdnmPhi E N X ι q) =
        u * (Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.map
          (homOfLE (inf_le_left : wcLdnmU E N X ι p ⊓ wcLdnmU E N X ι q ≤ wcLdnmU E N X ι p)).op
          (wcLdnmPhi E N X ι p) :=
by
  classical
  haveI : IsClosedImmersion ι := hι

  have haff : ∀ (n : ℕ) (J : Fin (n + 1)), IsAffineOpen (wcSgD E n J) := by
    intro n J
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) E) :=
      MvPolynomial.gradedAlgebra
    exact Proj.isAffineOpen_basicOpen _ (MvPolynomial.X J)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ J)) Nat.one_pos
  have hX : ∀ (n : ℕ) (k : Fin (n + 1)), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) E) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) E 1 := fun n k =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)

  have GL1 : ∀ {A B C : Scheme.{u}} (g : A ⟶ B) (k : B ⟶ C) (U U' : C.Opens) (hU' : U' ≤ U)
      (V V' : A.Opens) (hV : V ≤ V') (e' : V' ≤ g ⁻¹ᵁ (k ⁻¹ᵁ U)) (e : V ≤ (g ≫ k) ⁻¹ᵁ U')
      (s : Γ(C, U)),
      (A.presheaf.map (homOfLE hV).op).hom ((g.appLE (k ⁻¹ᵁ U) V' e').hom ((k.app U).hom s)) =
        ((g ≫ k).appLE U' V e).hom ((C.presheaf.map (homOfLE hU').op).hom s) := by
    intro A B C g k U U' hU' V V' hV e' e s
    have h1 := Scheme.Hom.appLE_map g e' (homOfLE hV).op
    have h2 := Scheme.Hom.map_appLE (g ≫ k) e (homOfLE hU').op
    have h3 := Scheme.Hom.comp_appLE g k U V (le_trans hV e')
    show ((k.app U ≫ g.appLE (k ⁻¹ᵁ U) V' e') ≫ A.presheaf.map (homOfLE hV).op).hom s =
      (C.presheaf.map (homOfLE hU').op ≫ (g ≫ k).appLE U' V e).hom s
    rw [Category.assoc, h1, h2, h3]
  have GL2 : ∀ {A B : Scheme.{u}} (g : A ⟶ B) (U : B.Opens) (V V' : A.Opens) (hV : V ≤ V')
      (e' : V' ≤ g ⁻¹ᵁ U) (e : V ≤ g ⁻¹ᵁ U) (s : Γ(B, U)),
      (A.presheaf.map (homOfLE hV).op).hom ((g.appLE U V' e').hom s) = (g.appLE U V e).hom s := by
    intro A B g U V V' hV e' e s
    exact congrArg (fun φ => CommRingCat.Hom.hom φ s) (Scheme.Hom.appLE_map g e' (homOfLE hV).op)
  have GL3 : ∀ {A B : Scheme.{u}} (g : A ⟶ B) (U U' : B.Opens) (V : A.Opens) (hU' : U' ≤ U)
      (e : V ≤ g ⁻¹ᵁ U) (e' : V ≤ g ⁻¹ᵁ U') (s : Γ(B, U)),
      (g.appLE U' V e').hom ((B.presheaf.map (homOfLE hU').op).hom s) = (g.appLE U V e).hom s := by
    intro A B g U U' V hU' e e' s
    exact congrArg (fun φ => CommRingCat.Hom.hom φ s) (Scheme.Hom.map_appLE g e' (homOfLE hU').op)

  have T0 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g G : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1) (hG : G ∈ 𝒜 (2 • 1)),
      (Proj 𝒜).presheaf.map (homOfLE (inf_le_right :
          Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 g)).op
          (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 2 G hG)) =
        (Proj 𝒜).presheaf.map (homOfLE (inf_le_right :
            Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 g)).op
          (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 f hf)) ^ 2 *
        (Proj 𝒜).presheaf.map (homOfLE (inf_le_left :
            Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op
          (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 2 G hG)) := by
    intro σ A _ _ _ 𝒜 _ f g G hf hg hG
    have key : ∀ (W : (Proj 𝒜).Opens) (_ : W = Proj.basicOpen 𝒜 (f * g))
        (h₁ : W ≤ Proj.basicOpen 𝒜 f) (h₂ : W ≤ Proj.basicOpen 𝒜 g),
        (Proj 𝒜).presheaf.map (homOfLE h₂).op
            (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 2 G hG)) =
          (Proj 𝒜).presheaf.map (homOfLE h₂).op
            (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 f hf)) ^ 2 *
          (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 2 G hG)) := by
      rintro W rfl h₁ h₂
      have e1 : ∀ a, (Proj 𝒜).presheaf.map (homOfLE h₁).op (Proj.awayToSection 𝒜 f a) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hg rfl a) := by
        intro a
        exact (ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 hg (rfl : f * g = f * g)) a).symm
      have e2 : ∀ b, (Proj 𝒜).presheaf.map (homOfLE h₂).op (Proj.awayToSection 𝒜 g b) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hf (mul_comm f g) b) := by
        intro b
        exact (ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 (f := g) hf (mul_comm f g)) b).symm
      rw [e2, e2, e1, ← map_pow, ← map_mul]
      congr 1
      rw [sq, HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.awayMap_mk]
      apply HomogeneousLocalization.val_injective
      simp only [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
        Localization.mk_mul]
      rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [Submonoid.coe_mul, pow_one, OneMemClass.coe_one, one_mul]
      ring
    exact key _ (Proj.basicOpen_mul 𝒜 f g).symm _ _

  have T1 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g h : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1) (hh : h ∈ 𝒜 1),
      (Proj 𝒜).presheaf.map (homOfLE (inf_le_right :
          Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 g)).op
          (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 h hh)) =
        (Proj 𝒜).presheaf.map (homOfLE (inf_le_right :
            Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 g)).op
          (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 f hf)) *
        (Proj 𝒜).presheaf.map (homOfLE (inf_le_left :
            Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op
          (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 h hh)) := by
    intro σ A _ _ _ 𝒜 _ f g h hf hg hh
    have key : ∀ (W : (Proj 𝒜).Opens) (_ : W = Proj.basicOpen 𝒜 (f * g))
        (h₁ : W ≤ Proj.basicOpen 𝒜 f) (h₂ : W ≤ Proj.basicOpen 𝒜 g),
        (Proj 𝒜).presheaf.map (homOfLE h₂).op
            (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 h hh)) =
          (Proj 𝒜).presheaf.map (homOfLE h₂).op
            (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 f hf)) *
          (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 h hh)) := by
      rintro W rfl h₁ h₂
      have e1 : ∀ a, (Proj 𝒜).presheaf.map (homOfLE h₁).op (Proj.awayToSection 𝒜 f a) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hg rfl a) := by
        intro a
        exact (ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 hg (rfl : f * g = f * g)) a).symm
      have e2 : ∀ b, (Proj 𝒜).presheaf.map (homOfLE h₂).op (Proj.awayToSection 𝒜 g b) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hf (mul_comm f g) b) := by
        intro b
        exact (ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 (f := g) hf (mul_comm f g)) b).symm
      rw [e2, e2, e1, ← map_mul]
      congr 1
      rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.awayMap_mk]
      apply HomogeneousLocalization.val_injective
      simp only [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
        Localization.mk_mul]
      rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [Submonoid.coe_mul, pow_one, OneMemClass.coe_one, one_mul]
      ring
    exact key _ (Proj.basicOpen_mul 𝒜 f g).symm _ _

  have I0 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1),
      (Proj 𝒜).presheaf.map (homOfLE (inf_le_left :
          Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op
          (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) *
        (Proj 𝒜).presheaf.map (homOfLE (inf_le_right :
          Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 g)).op
          (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 f hf)) = 1 := by
    intro σ A _ _ _ 𝒜 _ f g hf hg
    have key : ∀ (W : (Proj 𝒜).Opens) (_ : W = Proj.basicOpen 𝒜 (f * g))
        (h₁ : W ≤ Proj.basicOpen 𝒜 f) (h₂ : W ≤ Proj.basicOpen 𝒜 g),
        (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) *
          (Proj 𝒜).presheaf.map (homOfLE h₂).op
            (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 f hf)) = 1 := by
      rintro W rfl h₁ h₂
      have e1 : ∀ a, (Proj 𝒜).presheaf.map (homOfLE h₁).op (Proj.awayToSection 𝒜 f a) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hg rfl a) := by
        intro a
        exact (ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 hg (rfl : f * g = f * g)) a).symm
      have e2 : ∀ b, (Proj 𝒜).presheaf.map (homOfLE h₂).op (Proj.awayToSection 𝒜 g b) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hf (mul_comm f g) b) := by
        intro b
        exact (ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 (f := g) hf (mul_comm f g)) b).symm
      rw [e1, e2, ← map_mul]
      have h1 : HomogeneousLocalization.awayMap 𝒜 hg (rfl : f * g = f * g)
            (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) *
          HomogeneousLocalization.awayMap 𝒜 hf (mul_comm f g)
            (HomogeneousLocalization.Away.mk 𝒜 hg 1 f hf) = 1 := by
        rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk]
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
          HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one,
          ← Localization.mk_one, Localization.mk_mul, Localization.mk_eq_mk_iff,
          Localization.r_iff_exists]
        refine ⟨1, ?_⟩
        simp only [Submonoid.coe_mul, pow_one, OneMemClass.coe_one, one_mul, mul_one]
        ring
      rw [h1, map_one]
    exact key _ (Proj.basicOpen_mul 𝒜 f g).symm _ _

  have Tw : ∀ (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) (a b : Fin (N + 1)),
      ((wcProjK E N).presheaf.map (homOfLE (inf_le_right :
          wcSgD E N a ⊓ wcSgD E N b ≤ wcSgD E N b)).op).hom (wcLdpSec E N G b) =
        ((wcProjK E N).presheaf.map (homOfLE (inf_le_right :
          wcSgD E N a ⊓ wcSgD E N b ≤ wcSgD E N b)).op).hom (wcSgE E N b a) ^ 2 *
        ((wcProjK E N).presheaf.map (homOfLE (inf_le_left :
          wcSgD E N a ⊓ wcSgD E N b ≤ wcSgD E N a)).op).hom (wcLdpSec E N G a) := by
    intro G a b
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) :=
      MvPolynomial.gradedAlgebra
    exact T0 (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) (MvPolynomial.X a)
      (MvPolynomial.X b) (G : MvPolynomial (Fin (N + 1)) E) (hX N a) (hX N b) G.2
  have Tv : ∀ (n : ℕ) (r s l : Fin (n + 1)),
      ((wcProjK E n).presheaf.map (homOfLE (inf_le_right :
          wcSgD E n r ⊓ wcSgD E n s ≤ wcSgD E n s)).op).hom (wcSgE E n s l) =
        ((wcProjK E n).presheaf.map (homOfLE (inf_le_right :
          wcSgD E n r ⊓ wcSgD E n s ≤ wcSgD E n s)).op).hom (wcSgE E n s r) *
        ((wcProjK E n).presheaf.map (homOfLE (inf_le_left :
          wcSgD E n r ⊓ wcSgD E n s ≤ wcSgD E n r)).op).hom (wcSgE E n r l) := by
    intro n r s l
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) E) :=
      MvPolynomial.gradedAlgebra
    exact T1 (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) E) (MvPolynomial.X r)
      (MvPolynomial.X s) (MvPolynomial.X l) (hX n r) (hX n s) (hX n l)
  have Iw : ∀ (n : ℕ) (J L : Fin (n + 1)),
      ((wcProjK E n).presheaf.map (homOfLE (inf_le_left :
          wcSgD E n J ⊓ wcSgD E n L ≤ wcSgD E n J)).op).hom (wcSgE E n J L) *
        ((wcProjK E n).presheaf.map (homOfLE (inf_le_right :
          wcSgD E n J ⊓ wcSgD E n L ≤ wcSgD E n L)).op).hom (wcSgE E n L J) = 1 := by
    intro n J L
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) E) :=
      MvPolynomial.gradedAlgebra
    exact I0 (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) E) (MvPolynomial.X J)
      (MvPolynomial.X L) (hX n J) (hX n L)

  have MAIN : ∀ (P : Scheme.{u}) (p1 : P ⟶ X.left) (p2 : P ⟶ wcProjK E (wcLdnmM N))
      (a b : Fin (N + 1)) (r s : Fin (wcLdnmM N + 1)) (Wp Wq : P.Opens)
      (hWa : Wp ≤ p1 ⁻¹ᵁ (ι ⁻¹ᵁ wcSgD E N a)) (hWr : Wp ≤ p2 ⁻¹ᵁ wcSgD E (wcLdnmM N) r)
      (hWb : Wq ≤ p1 ⁻¹ᵁ (ι ⁻¹ᵁ wcSgD E N b)) (hWs : Wq ≤ p2 ⁻¹ᵁ wcSgD E (wcLdnmM N) s),
      ∃ u : Γ(P, Wp ⊓ Wq), IsUnit u ∧
        (P.presheaf.map (homOfLE (inf_le_right : Wp ⊓ Wq ≤ Wq)).op).hom
          (∑ q : Fin (N + 1) × Fin (N + 1),
            (p2.appLE (wcSgD E (wcLdnmM N) s) Wq hWs).hom
                (wcSgE E (wcLdnmM N) s (wcLdnmIdx N q)) *
              (p1.appLE (ι ⁻¹ᵁ wcSgD E N b) Wq hWb).hom
                ((ι.app (wcSgD E N b)).hom (wcLdpSec E N (wcLdnmMono E N q) b))) =
        u * (P.presheaf.map (homOfLE (inf_le_left : Wp ⊓ Wq ≤ Wp)).op).hom
          (∑ q : Fin (N + 1) × Fin (N + 1),
            (p2.appLE (wcSgD E (wcLdnmM N) r) Wp hWr).hom
                (wcSgE E (wcLdnmM N) r (wcLdnmIdx N q)) *
              (p1.appLE (ι ⁻¹ᵁ wcSgD E N a) Wp hWa).hom
                ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (wcLdnmMono E N q) a))) := by
    intro P p1 p2 a b r s Wp Wq hWa hWr hWb hWs
    have hOX : Wp ⊓ Wq ≤ (p1 ≫ ι) ⁻¹ᵁ (wcSgD E N a ⊓ wcSgD E N b) :=
      fun x hx => ⟨hWa hx.1, hWb hx.2⟩
    have hOP : Wp ⊓ Wq ≤ p2 ⁻¹ᵁ (wcSgD E (wcLdnmM N) r ⊓ wcSgD E (wcLdnmM N) s) :=
      fun x hx => ⟨hWr hx.1, hWs hx.2⟩
    have hOr : Wp ⊓ Wq ≤ p2 ⁻¹ᵁ wcSgD E (wcLdnmM N) r := le_trans inf_le_left hWr
    have hOs : Wp ⊓ Wq ≤ p2 ⁻¹ᵁ wcSgD E (wcLdnmM N) s := le_trans inf_le_right hWs
    have hw : ((p1 ≫ ι).appLE (wcSgD E N a ⊓ wcSgD E N b) (Wp ⊓ Wq) hOX).hom
          (((wcProjK E N).presheaf.map (homOfLE (inf_le_left :
            wcSgD E N a ⊓ wcSgD E N b ≤ wcSgD E N a)).op).hom (wcSgE E N a b)) *
        ((p1 ≫ ι).appLE (wcSgD E N a ⊓ wcSgD E N b) (Wp ⊓ Wq) hOX).hom
          (((wcProjK E N).presheaf.map (homOfLE (inf_le_right :
            wcSgD E N a ⊓ wcSgD E N b ≤ wcSgD E N b)).op).hom (wcSgE E N b a)) = 1 := by
      rw [← map_mul, Iw N a b, map_one]
    have hss : (p2.appLE (wcSgD E (wcLdnmM N) r ⊓ wcSgD E (wcLdnmM N) s) (Wp ⊓ Wq) hOP).hom
          (((wcProjK E (wcLdnmM N)).presheaf.map (homOfLE (inf_le_left :
            wcSgD E (wcLdnmM N) r ⊓ wcSgD E (wcLdnmM N) s ≤ wcSgD E (wcLdnmM N) r)).op).hom
            (wcSgE E (wcLdnmM N) r s)) *
        (p2.appLE (wcSgD E (wcLdnmM N) r ⊓ wcSgD E (wcLdnmM N) s) (Wp ⊓ Wq) hOP).hom
          (((wcProjK E (wcLdnmM N)).presheaf.map (homOfLE (inf_le_right :
            wcSgD E (wcLdnmM N) r ⊓ wcSgD E (wcLdnmM N) s ≤ wcSgD E (wcLdnmM N) s)).op).hom
            (wcSgE E (wcLdnmM N) s r)) = 1 := by
      rw [← map_mul, Iw (wcLdnmM N) r s, map_one]
    refine ⟨((p1 ≫ ι).appLE (wcSgD E N a ⊓ wcSgD E N b) (Wp ⊓ Wq) hOX).hom
          (((wcProjK E N).presheaf.map (homOfLE (inf_le_right :
            wcSgD E N a ⊓ wcSgD E N b ≤ wcSgD E N b)).op).hom (wcSgE E N b a)) ^ 2 *
        (p2.appLE (wcSgD E (wcLdnmM N) r ⊓ wcSgD E (wcLdnmM N) s) (Wp ⊓ Wq) hOP).hom
          (((wcProjK E (wcLdnmM N)).presheaf.map (homOfLE (inf_le_right :
            wcSgD E (wcLdnmM N) r ⊓ wcSgD E (wcLdnmM N) s ≤ wcSgD E (wcLdnmM N) s)).op).hom
            (wcSgE E (wcLdnmM N) s r)),
      ((IsUnit.of_mul_eq_one _ (by rw [mul_comm]; exact hw)).pow 2).mul
        (IsUnit.of_mul_eq_one _ (by rw [mul_comm]; exact hss)), ?_⟩
    rw [map_sum, map_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    rw [map_mul, map_mul,
      GL1 p1 ι (wcSgD E N b) (wcSgD E N a ⊓ wcSgD E N b) inf_le_right (Wp ⊓ Wq) Wq
        inf_le_right hWb hOX,
      GL1 p1 ι (wcSgD E N a) (wcSgD E N a ⊓ wcSgD E N b) inf_le_left (Wp ⊓ Wq) Wp
        inf_le_left hWa hOX,
      GL2 p2 (wcSgD E (wcLdnmM N) s) (Wp ⊓ Wq) Wq inf_le_right hWs hOs,
      GL2 p2 (wcSgD E (wcLdnmM N) r) (Wp ⊓ Wq) Wp inf_le_left hWr hOr,
      ← GL3 p2 (wcSgD E (wcLdnmM N) s) (wcSgD E (wcLdnmM N) r ⊓ wcSgD E (wcLdnmM N) s)
        (Wp ⊓ Wq) inf_le_right hOs hOP,
      ← GL3 p2 (wcSgD E (wcLdnmM N) r) (wcSgD E (wcLdnmM N) r ⊓ wcSgD E (wcLdnmM N) s)
        (Wp ⊓ Wq) inf_le_left hOr hOP,
      Tw (wcLdnmMono E N q) a b, Tv (wcLdnmM N) r s (wcLdnmIdx N q)]
    simp only [map_mul, map_pow]
    ring

  have AFF : ∀ (S X Y : Scheme.{u}) [IsAffine S] (f : X ⟶ S) (g : Y ⟶ S) (U : X.Opens)
      (C : Y.Opens), IsAffineOpen U → IsAffineOpen C →
      IsAffineOpen ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C) := by
    intro S X Y _ f g U C hU hC
    have hP : IsPullback
        ((Limits.pullback.fst f g).resLE U ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
          (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_left)
        ((Limits.pullback.snd f g).resLE C ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
          (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_right)
        (U.ι ≫ f) (C.ι ≫ g) := by
      have comm : (Limits.pullback.fst f g).resLE U ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
          (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_left ≫ (U.ι ≫ f) =
          (Limits.pullback.snd f g).resLE C ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
          (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_right ≫ (C.ι ≫ g) := by
        rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc, Scheme.Hom.resLE_comp_ι,
          Category.assoc, Category.assoc, Limits.pullback.condition]
      have hc : ∀ (s : Limits.PullbackCone (U.ι ≫ f) (C.ι ≫ g)),
          (s.fst ≫ U.ι) ≫ f = (s.snd ≫ C.ι) ≫ g := by
        intro s
        rw [Category.assoc, Category.assoc]
        exact s.condition
      have hrange : ∀ (s : Limits.PullbackCone (U.ι ≫ f) (C.ι ≫ g)),
          Set.range (Limits.pullback.lift (s.fst ≫ U.ι) (s.snd ≫ C.ι) (hc s)) ⊆
            Set.range ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C).ι := by
        intro s
        rw [Scheme.Opens.range_ι]
        rintro _ ⟨x, rfl⟩
        refine ⟨?_, ?_⟩
        · show (Limits.pullback.fst f g) (Limits.pullback.lift (s.fst ≫ U.ι) (s.snd ≫ C.ι) (hc s) x) ∈ U
          rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_fst, Scheme.Hom.comp_apply]
          have h : U.ι (s.fst x) ∈ Set.range U.ι := ⟨_, rfl⟩
          rwa [Scheme.Opens.range_ι] at h
        · show (Limits.pullback.snd f g) (Limits.pullback.lift (s.fst ≫ U.ι) (s.snd ≫ C.ι) (hc s) x) ∈ C
          rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_snd, Scheme.Hom.comp_apply]
          have h : C.ι (s.snd x) ∈ Set.range C.ι := ⟨_, rfl⟩
          rwa [Scheme.Opens.range_ι] at h
      refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk _ _ comm) ?_
      refine Limits.PullbackCone.IsLimit.mk comm
        (fun s => IsOpenImmersion.lift _ _ (hrange s)) ?_ ?_ ?_
      · intro s
        rw [← cancel_mono U.ι, Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc,
          IsOpenImmersion.lift_fac, Limits.pullback.lift_fst]
      · intro s
        rw [← cancel_mono C.ι, Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc,
          IsOpenImmersion.lift_fac, Limits.pullback.lift_snd]
      · intro s m h1 h2
        apply IsOpenImmersion.lift_uniq
        apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, ← h1, Category.assoc, Category.assoc, Scheme.Hom.resLE_comp_ι]
        · rw [Limits.pullback.lift_snd, ← h2, Category.assoc, Category.assoc, Scheme.Hom.resLE_comp_ι]
    haveI : IsAffine (U : Scheme.{u}) := hU
    haveI : IsAffine (C : Scheme.{u}) := hC
    exact IsAffine.of_isIso hP.isoPullback.hom

  have COV : ∀ (m : ℕ), (⨆ a : Fin (m + 1), wcSgD E m a) = ⊤ := by
    intro m
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) E) :=
      MvPolynomial.gradedAlgebra
    refine Proj.iSup_basicOpen_eq_top _ _ ?_
    intro p hp
    have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) E) 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (m + 1)) E)
        p).mp hp
    have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) E) 0 p =
        MvPolynomial.homogeneousComponent 0 p :=
      (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
    rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ]
    rw [MvPolynomial.mem_ideal_span_X_image]
    intro e he
    rw [MvPolynomial.mem_support_iff] at he
    have hne : e ≠ 0 := by
      rintro rfl
      exact he h0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
    exact ⟨i, Set.mem_univ i, by simpa using hi⟩
  refine ⟨?_, ?_, ?_⟩
  ·
    rintro ⟨b, r⟩
    exact AFF (Spec (.of E)) X.left (wcProjK E (wcLdnmM N)) X.hom (wcProjKStr E (wcLdnmM N))
      (ι ⁻¹ᵁ wcSgD E N b) (wcSgD E (wcLdnmM N) r) ((haff N b).preimage ι) (haff (wcLdnmM N) r)
  ·
    rw [eq_top_iff]
    intro x _
    have hc1 : (⨆ a : Fin (N + 1), wcSgD E N a) = ⊤ := COV N
    have hc2 : (⨆ e : Fin (wcLdnmM N + 1), wcSgD E (wcLdnmM N) e) = ⊤ := COV (wcLdnmM N)
    have h1 : ι (Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)) x) ∈
        (⨆ a : Fin (N + 1), wcSgD E N a) := by
      rw [hc1]; trivial
    have h2 : Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)) x ∈
        (⨆ e : Fin (wcLdnmM N + 1), wcSgD E (wcLdnmM N) e) := by
      rw [hc2]; trivial
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp h1
    obtain ⟨e, he⟩ := TopologicalSpace.Opens.mem_iSup.mp h2
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨(a, e), ⟨ha, he⟩⟩
  ·
    rintro ⟨a, r⟩ ⟨b, s⟩
    exact MAIN _ (Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)))
      (Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) a b r s
      (wcLdnmU E N X ι (a, r)) (wcLdnmU E N X ι (b, s)) inf_le_left inf_le_right inf_le_left
      inf_le_right

theorem wc_ldnm_univ_smooth (E : Type u) [Field E] (N n : ℕ) (X : Over (Spec (.of E)))
    [SmoothOfRelativeDimension n X.hom] (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι)
    (hιX : ι ≫ wcProjKStr E N = X.hom) (Z : Scheme.{u})
    (k : Z ⟶ Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
    (hk : wcLdnmLocEq (Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
      (Fin (N + 1) × Fin (wcLdnmM N + 1)) (wcLdnmU E N X ι) (wcLdnmPhi E N X ι) Z k) :
    SmoothOfRelativeDimension (n + wcLdnmM N - 1)
      (k ≫ Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)) ≫ X.hom) :=
by
  classical

  have hcc : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (s : B ⟶ Spec (.of E)) (y : A),
      wcLdpConst E (f ≫ s) y = (f.stalkMap y).hom.comp (wcLdpConst E s (f y)) := by
    intro A B f s y
    ext c
    simp only [wcLdpConst, RingHom.comp_apply, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
    exact (Scheme.Hom.germ_stalkMap_apply f ⊤ y trivial _).symm

  have htrans : ∀ {A B C : Type u} [CommRing A] [CommRing B] [IsLocalRing B] [CommRing C]
      [IsLocalRing C] (f : B →+* C) [IsLocalHom f] (ρ : A →+* B)
      (d : A →+ IsLocalRing.ResidueField B),
      (∀ a b, d (a * b) = IsLocalRing.residue B (ρ a) * d b + IsLocalRing.residue B (ρ b) * d a) →
      ∀ a b, ((IsLocalRing.ResidueField.map f).toAddMonoidHom.comp d) (a * b) =
        IsLocalRing.residue C (f (ρ a)) * ((IsLocalRing.ResidueField.map f).toAddMonoidHom.comp d) b +
        IsLocalRing.residue C (f (ρ b)) * ((IsLocalRing.ResidueField.map f).toAddMonoidHom.comp d) a := by
    intro A B C _ _ _ _ _ f _ ρ d hd a b
    show IsLocalRing.ResidueField.map f (d (a * b)) =
      IsLocalRing.residue C (f (ρ a)) * IsLocalRing.ResidueField.map f (d b) +
      IsLocalRing.residue C (f (ρ b)) * IsLocalRing.ResidueField.map f (d a)
    rw [hd, map_add, map_mul, map_mul, IsLocalRing.ResidueField.map_residue,
      IsLocalRing.ResidueField.map_residue]

  have hgLE : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (V : B.Opens) (U : A.Opens) (e : U ≤ f ⁻¹ᵁ V)
      (w : A) (hw : w ∈ U) (σ : Γ(B, V)),
      (A.presheaf.germ U w hw).hom ((f.appLE V U e).hom σ) =
        (f.stalkMap w).hom ((B.presheaf.germ V (f w) (show f w ∈ V from e hw)).hom σ) := by
    intro A B f V U e w hw σ
    have h1 := Scheme.Hom.germ_stalkMap_apply f V w (show f w ∈ V from e hw) σ
    refine Eq.trans ?_ h1.symm
    show (A.presheaf.germ U w hw).hom ((A.presheaf.map (homOfLE e).op).hom ((f.app V).hom σ)) = _
    exact TopCat.Presheaf.germ_res_apply _ _ _ _ _



  have L1 : ∀ (m : ℕ) (a t : Fin (m + 1)), t ≠ a →
      ∀ (y : wcProjK E m) (hy : y ∈ wcSgD E m a),
      ∃ δ₀ : (wcProjK E m).presheaf.stalk y →+
          IsLocalRing.ResidueField ((wcProjK E m).presheaf.stalk y),
        (∀ f g, δ₀ (f * g) = IsLocalRing.residue _ f * δ₀ g + IsLocalRing.residue _ g * δ₀ f) ∧
        (∀ c : E, δ₀ (wcLdpConst E (wcProjKStr E m) y c) = 0) ∧
        ∀ s, δ₀ (((wcProjK E m).presheaf.germ (wcSgD E m a) y hy).hom (wcSgE E m a s)) =
          if s = t then 1 else 0 := by
    intro m a t hta y hy
    haveI := wc_proj_space_smooth E m
    obtain ⟨hYfs, hYfree, hYfin, hYrk, -⟩ :=
      wc_ldp_il_stalk_of_smooth_field E (wcProjKStr E m) m y
    letI algY : Algebra E ((wcProjK E m).presheaf.stalk y) :=
      (wcLdpConst E (wcProjKStr E m) y).toAlgebra
    haveI := hYfree
    haveI := hYfin
    obtain ⟨u, hu_def⟩ : ∃ u : Fin (m + 1) → (wcProjK E m).presheaf.stalk y,
        ∀ e, u e = ((wcProjK E m).presheaf.germ (wcSgD E m a) y hy).hom (wcSgE E m a e) :=
      ⟨_, fun e => rfl⟩
    have hua : u a = 1 := by
      rw [hu_def, (wc_ldp_lnf_sec_quad E m a (fun _ _ => 0)).1, map_one]
    have hspan : Submodule.span ((wcProjK E m).presheaf.stalk y)
        (Set.range fun i : Fin m =>
          KaehlerDifferential.D E ((wcProjK E m).presheaf.stalk y) (u (a.succAbove i))) = ⊤ := by
      set Sp := Submodule.span ((wcProjK E m).presheaf.stalk y)
        (Set.range fun i : Fin m =>
          KaehlerDifferential.D E ((wcProjK E m).presheaf.stalk y) (u (a.succAbove i))) with hSp
      have hDu : ∀ e, KaehlerDifferential.D E ((wcProjK E m).presheaf.stalk y) (u e) ∈ Sp := by
        intro e
        by_cases hea : e = a
        · rw [hea, hua, Derivation.map_one_eq_zero]; exact Sp.zero_mem
        · obtain ⟨i, hi⟩ := Fin.exists_succAbove_eq hea
          rw [← hi]; exact Submodule.subset_span ⟨i, rfl⟩
      let T : Subring ((wcProjK E m).presheaf.stalk y) :=
        { carrier := {x | KaehlerDifferential.D E ((wcProjK E m).presheaf.stalk y) x ∈ Sp}
          mul_mem' := fun {x y'} hx hy' => by
            show KaehlerDifferential.D E ((wcProjK E m).presheaf.stalk y) (x * y') ∈ Sp
            rw [Derivation.leibniz]; exact Sp.add_mem (Sp.smul_mem _ hy') (Sp.smul_mem _ hx)
          one_mem' := by
            show KaehlerDifferential.D E ((wcProjK E m).presheaf.stalk y) 1 ∈ Sp
            rw [Derivation.map_one_eq_zero]; exact Sp.zero_mem
          add_mem' := fun {x y'} hx hy' => by
            show KaehlerDifferential.D E ((wcProjK E m).presheaf.stalk y) (x + y') ∈ Sp
            rw [map_add]; exact Sp.add_mem hx hy'
          zero_mem' := by
            show KaehlerDifferential.D E ((wcProjK E m).presheaf.stalk y) 0 ∈ Sp
            rw [map_zero]; exact Sp.zero_mem
          neg_mem' := fun {x} hx => by
            show KaehlerDifferential.D E ((wcProjK E m).presheaf.stalk y) (-x) ∈ Sp
            rw [map_neg]; exact Sp.neg_mem hx }
      have hconst : ∀ c' : E, ((wcProjK E m).presheaf.germ (wcSgD E m a) y hy).hom
          ((wcProjK E m).presheaf.map (homOfLE (le_top : wcSgD E m a ≤ ⊤)).op
            ((wcProjKStr E m).appTop ((Scheme.ΓSpecIso (.of E)).inv c'))) =
          algebraMap E ((wcProjK E m).presheaf.stalk y) c' := by
        intro c'
        rw [RingHom.algebraMap_toAlgebra]
