        exact Scheme.fromSpecResidueField_apply y _
      obtain ⟨φ, hφ1, hφ2⟩ := factor Y V h y _ hy t ht hpt
      obtain ⟨ψ, hψ1, hψ2⟩ := factor Y V h y _ hy t₀ ht₀ rfl
      obtain ⟨σ, hσ1, hσ2⟩ := fieldext (Y.residueField y) _
        ((Scheme.residueFieldCongr hy.symm).hom ≫ h.residueFieldMap _).hom φ.hom ψ.hom
        (congrArg CommRingCat.Hom.hom ((Category.assoc _ _ _).trans hφ2))
        (congrArg CommRingCat.Hom.hom ((Category.assoc _ _ _).trans hψ2))
      haveI : IsPurelyInseparable (Y.residueField y) (AlgebraicClosure (Y.residueField y)) :=
        Algebra.IsAlgebraic.isPurelyInseparable_of_isSepClosed
      let σA : AlgebraicClosure (Y.residueField y) →ₐ[Y.residueField y]
          AlgebraicClosure (Y.residueField y) :=
        { σ with commutes' := fun r => congrArg (fun g => g r) hσ2 }
      have hσid : ∀ x, σ x = x := fun x =>
        DFunLike.congr_fun (Subsingleton.elim σA (AlgHom.id _ _)) x
      have hφψ : φ = ψ := by
        apply CommRingCat.hom_ext
        ext l
        rw [← hσ1, RingHom.comp_apply, hσid]
      rw [hφ1, hφψ]
      exact hψ1.symm

    have hetale : ∀ (E : Type u) [CommRing E] [Algebra R E] [Algebra.Etale R E]
        (σ : E →ₐ[R] IsLocalRing.ResidueField R), ∃ τ : E →ₐ[R] R,
          ∀ x : E, IsLocalRing.residue R (τ x) = σ x := by
      intro E _ _ _ σ
      haveI hq : (RingHom.ker σ).IsPrime := RingHom.ker_isPrime σ
      haveI : Algebra.FormallyEtale E (Localization.AtPrime (RingHom.ker σ)) :=
        Algebra.FormallyEtale.of_isLocalization (RingHom.ker σ).primeCompl
      haveI : Algebra.IsEtaleAt R (RingHom.ker σ) :=
        Algebra.FormallyEtale.comp R E (Localization.AtPrime (RingHom.ker σ))
      obtain ⟨g, hg, hstd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := R) (RingHom.ker σ)
      have hσg : IsUnit (σ g) := isUnit_iff_ne_zero.mpr (fun h => hg (RingHom.mem_ker.mpr h))
      let σg : Localization.Away g →ₐ[R] IsLocalRing.ResidueField R :=
        IsLocalization.Away.liftAlgHom g hσg
      have hσg_apply : ∀ y : E, σg (algebraMap E (Localization.Away g) y) = σ y := by
        intro y
        rw [IsLocalization.Away.liftAlgHom_apply, IsLocalization.Away.lift_eq]
        rfl
      obtain ⟨Q⟩ := hstd.nonempty_standardEtalePresentation
      let e : Q.Ring ≃ₐ[R] Localization.Away g :=
        AlgEquiv.ofBijective (Q.lift Q.x Q.hasMap) Q.lift_bijective
      have heX : e Q.X = Q.x := by
        rw [AlgEquiv.ofBijective_apply]
        exact Q.lift_X _ _
      set a₀ := σg Q.x with ha₀
      have hf0 : Polynomial.aeval a₀ Q.f = 0 := by
        rw [ha₀, Polynomial.aeval_algHom_apply, Q.hasMap.1, map_zero]
      have hf' : Polynomial.aeval a₀ (Polynomial.derivative Q.f) ≠ 0 := by
        rw [ha₀, Polynomial.aeval_algHom_apply]
        exact ((StandardEtalePair.HasMap.isUnit_derivative_f Q.P Q.hasMap).map σg).ne_zero
      have hg0 : Polynomial.aeval a₀ Q.g ≠ 0 := by
        rw [ha₀, Polynomial.aeval_algHom_apply]
        exact (Q.hasMap.2.map σg).ne_zero
      have hHen := ((HenselianLocalRing.TFAE R).out 1 2).mp (inferInstance : HenselianLocalRing R)
      obtain ⟨a, hroot, hres⟩ := hHen Q.f Q.monic_f a₀ hf0 hf'
      have hres' : ∀ p : Polynomial R,
          IsLocalRing.residue R (Polynomial.aeval a p) = Polynomial.aeval a₀ p := by
        intro p
        rw [← hres, ← IsLocalRing.ResidueField.algebraMap_eq, ← Algebra.ofId_apply,
          ← Algebra.ofId_apply, ← Polynomial.aeval_algHom_apply]
      have hHas : Q.HasMap a := by
        refine ⟨?_, ?_⟩
        · rw [Polynomial.coe_aeval_eq_eval]
          exact hroot
        · rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hres']
          exact hg0
      have hcomp : (Algebra.ofId R (IsLocalRing.ResidueField R)).comp (Q.lift a hHas) =
          σg.comp (e : Q.Ring →ₐ[R] Localization.Away g) := by
        apply StandardEtalePair.hom_ext
        rw [AlgHom.comp_apply, AlgHom.comp_apply, Q.lift_X, AlgEquiv.coe_toAlgHom, heX,
          Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq, hres]
      refine ⟨((Q.lift a hHas).comp (e.symm : Localization.Away g →ₐ[R] Q.Ring)).comp
        (IsScalarTower.toAlgHom R E (Localization.Away g)), fun y => ?_⟩
      have h1 := congrArg (fun φ => φ (e.symm (algebraMap E (Localization.Away g) y))) hcomp
      simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, AlgEquiv.apply_symm_apply,
        Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at h1
      rw [AlgHom.comp_apply, AlgHom.comp_apply, IsScalarTower.coe_toAlgHom',
        AlgEquiv.coe_toAlgHom, h1, hσg_apply]

    have hres : ∀ (S : Type u) [CommRing S] [Algebra R S], Algebra.Etale R S →
        ∀ (P : Ideal S) [P.IsPrime], P.comap (algebraMap R S) = IsLocalRing.maximalIdeal R →
        ∃ φ₀ : S →ₐ[R] IsLocalRing.ResidueField R, ∀ x, φ₀ x = 0 ↔ x ∈ P := by
      intro S _ _ hE P _ hP
      have hker : RingHom.ker (algebraMap R P.ResidueField) = IsLocalRing.maximalIdeal R := by
        rw [IsScalarTower.algebraMap_eq R S P.ResidueField, ← RingHom.comap_ker,
          Ideal.ker_algebraMap_residueField, hP]
      have : IsLocalHom (algebraMap R P.ResidueField) := by
        constructor
        intro a ha
        by_contra hna
        have hm : a ∈ IsLocalRing.maximalIdeal R := hna
        rw [← hker, RingHom.mem_ker] at hm
        exact ha.ne_zero hm
      let j : IsLocalRing.ResidueField R →+* P.ResidueField :=
        IsLocalRing.ResidueField.lift (algebraMap R P.ResidueField)
      letI : Algebra (IsLocalRing.ResidueField R) P.ResidueField := j.toAlgebra
      have : IsScalarTower R (IsLocalRing.ResidueField R) P.ResidueField :=
        IsScalarTower.of_algebraMap_eq (fun r => by
          rw [RingHom.algebraMap_toAlgebra, IsLocalRing.ResidueField.algebraMap_eq,
            IsLocalRing.ResidueField.lift_residue_apply])
      have : Algebra.FormallyUnramified S (Localization.AtPrime P) :=
        Algebra.FormallyUnramified.of_isLocalization P.primeCompl
      have : Algebra.FormallyUnramified S P.ResidueField :=
        Algebra.FormallyUnramified.comp S (Localization.AtPrime P) P.ResidueField
      have : Algebra.FormallyUnramified R P.ResidueField :=
        Algebra.FormallyUnramified.comp R S P.ResidueField
      have : Algebra.EssFiniteType R P.ResidueField := Algebra.EssFiniteType.comp R S P.ResidueField
      have : Algebra.FormallyUnramified (IsLocalRing.ResidueField R) P.ResidueField :=
        Algebra.FormallyUnramified.of_restrictScalars R _ P.ResidueField
      have : Algebra.EssFiniteType (IsLocalRing.ResidueField R) P.ResidueField :=
        Algebra.EssFiniteType.of_comp R _ P.ResidueField
      have : Algebra.IsSeparable (IsLocalRing.ResidueField R) P.ResidueField :=
        Algebra.FormallyUnramified.isSeparable _ P.ResidueField
      have hsurj := IsSepClosed.algebraMap_surjective (IsLocalRing.ResidueField R) P.ResidueField
      let eq : IsLocalRing.ResidueField R ≃ₐ[R] P.ResidueField :=
        AlgEquiv.ofBijective (IsScalarTower.toAlgHom R (IsLocalRing.ResidueField R) P.ResidueField)
          ⟨(algebraMap (IsLocalRing.ResidueField R) P.ResidueField).injective, hsurj⟩
      refine ⟨eq.symm.toAlgHom.comp (IsScalarTower.toAlgHom R S P.ResidueField), fun x => ?_⟩
      show eq.symm (algebraMap S P.ResidueField x) = 0 ↔ x ∈ P
      rw [EmbeddingLike.map_eq_zero_iff, ← RingHom.mem_ker, Ideal.ker_algebraMap_residueField]

    have hlift : ∀ {V : Scheme.{u}} (h : V ⟶ Y) [Etale h] (v : V),
        h v = c (IsLocalRing.closedPoint R) →
        ∃ g : Spec (.of R) ⟶ V, g ≫ h = c ∧ g (IsLocalRing.closedPoint R) = v := by
      intro V h _ v hv
      obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := h) (g := c) v
        (IsLocalRing.closedPoint R) hv
      obtain ⟨E, ι, hι, hzι, -⟩ :=
        Scheme.exists_affine_mem_range_and_range_subset
          (U := (⊤ : (Limits.pullback h c).Opens)) (x := z) trivial
      obtain ⟨w, hw⟩ := hzι
      have := hι
      let hh : Spec E ⟶ Spec (.of R) := ι ≫ Limits.pullback.snd h c
      have : Etale hh := inferInstance
      let φ : CommRingCat.of R ⟶ E := Spec.preimage hh
      have hφ : Spec.map φ = hh := Spec.map_preimage hh
      have hEt : (CommRingCat.Hom.hom φ).Etale := by
        have : Etale (Spec.map φ) := by rw [hφ]; infer_instance
        exact (HasRingHomProperty.Spec_iff (P := @Etale)).mp this
      letI : Algebra R E := (CommRingCat.Hom.hom φ).toAlgebra
      have hAE : Algebra.Etale R E := RingHom.Etale.toAlgebra hEt
      haveI := hAE
      have hqw : (w.asIdeal).comap (algebraMap R E) = IsLocalRing.maximalIdeal R := by
        have h1 : (Spec.map φ) w = IsLocalRing.closedPoint R := by
          rw [hφ]
          show Limits.pullback.snd h c (ι w) = _
          rw [hw, hz2]
        have h2 := congrArg PrimeSpectrum.asIdeal h1
        exact h2
      haveI hwP : w.asIdeal.IsPrime := PrimeSpectrum.isPrime (show PrimeSpectrum E from w)
      obtain ⟨φ₀, hφ₀⟩ := hres E hAE w.asIdeal hqw
      obtain ⟨τ, hτ⟩ := hetale E φ₀
      let τ' : E ⟶ CommRingCat.of R := CommRingCat.ofHom (τ : E →+* R)
      have hret : φ ≫ τ' = 𝟙 _ := by
        ext r
        exact τ.commutes r
      have hpt : (Spec.map τ') (IsLocalRing.closedPoint R) = w := by
        refine (Spec.map_apply τ' _).trans (PrimeSpectrum.ext (Ideal.ext fun x => ?_))
        change (τ : E →+* R) x ∈ IsLocalRing.maximalIdeal R ↔ x ∈ w.asIdeal
        rw [← hφ₀ x, ← hτ x, IsLocalRing.residue_eq_zero_iff]
        exact Iff.rfl
      refine ⟨Spec.map τ' ≫ ι ≫ Limits.pullback.fst h c, ?_, ?_⟩
      · have h3 : ι ≫ Limits.pullback.snd h c = Spec.map φ := hφ.symm
        rw [Category.assoc, Category.assoc, Limits.pullback.condition, ← Category.assoc ι,
          h3, ← Category.assoc, ← Spec.map_comp, hret, Spec.map_id, Category.id_comp]
      · exact (Scheme.Hom.comp_apply _ _ _).trans ((Scheme.Hom.comp_apply _ _ _).trans
          ((congrArg (fun p => Limits.pullback.fst h c (ι p)) hpt).trans
            ((congrArg (Limits.pullback.fst h c) hw).trans hz1)))

    have s6 : ∀ {Z V : Scheme.{u}} (h : V ⟶ Z) [Etale h] (g₁ g₂ : Spec (.of R) ⟶ V),
        g₁ ≫ h = g₂ ≫ h → q ≫ g₁ = q ≫ g₂ → g₁ = g₂ := by
      intro Z V h _ g₁ g₂ hh hg
      obtain ⟨U, hU, hUeq⟩ := s0 h g₁ g₂ hh _ q hg
      have hU' : IsLocalRing.closedPoint R ∈ U := by
        rw [← hq]
        exact hU
      have hsub : Set.range ⇑(𝟙 (Spec (.of R))) ⊆ Set.range ⇑U.ι := by
        intro x _
        rw [Scheme.Opens.range_ι]
        exact (IsLocalRing.specializes_closedPoint (R := R) x).mem_open U.isOpen hU'
      have hk := IsOpenImmersion.lift_fac U.ι (𝟙 _) hsub
      calc g₁ = (IsOpenImmersion.lift U.ι (𝟙 _) hsub ≫ U.ι) ≫ g₁ := by
            rw [hk, Category.id_comp]
        _ = (IsOpenImmersion.lift U.ι (𝟙 _) hsub ≫ U.ι) ≫ g₂ := by
            simp only [Category.assoc, hUeq]
        _ = g₂ := by rw [hk, Category.id_comp]

    have hcm : c (IsLocalRing.closedPoint R) =
        wcEtGeomPt Y y (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) :=
      (congrArg c hq).symm.trans ((Scheme.Hom.comp_apply q c _).symm.trans
        (congrArg (fun g : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶ Y =>
          g (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) hqc))
    have hleg : ∀ l, ∃ d : Spec (.of R) ⟶ (W'.obj l).right.left,
        d ≫ (W'.obj l).right.hom = c ∧ q ≫ d = (W'.obj l).hom.left := by
      intro l
      haveI : Etale (W'.obj l).right.hom := (W'.obj l).right.prop
      have hpt_l : (W'.obj l).hom.left ≫ (W'.obj l).right.hom = wcEtGeomPt Y y :=
        Over.w (W'.obj l).hom
      obtain ⟨d, hd1, hd2⟩ := hlift (W'.obj l).right.hom
        ((W'.obj l).hom.left (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))))
        ((Scheme.Hom.comp_apply _ _ _).symm.trans
          ((congrArg (fun g : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶ Y =>
            g (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) hpt_l).trans
            hcm.symm))
      refine ⟨d, hd1, ?_⟩
      apply geomlift y hsep (W'.obj l).right.hom
      · rw [Category.assoc, hd1, hqc]
      · exact hpt_l
      · exact (Scheme.Hom.comp_apply q d _).trans ((congrArg d hq).trans hd2)
    choose d hd1 hd3 using hleg

    have hdc : ∀ {l l₁ : Λ} (t : l ⟶ l₁), d l ≫ (W'.map t).right.left = d l₁ := by
      intro l l₁ t
      haveI : Etale (W'.obj l₁).right.hom := (W'.obj l₁).right.prop
      apply s6 (W'.obj l₁).right.hom
      · rw [Category.assoc, MorphismProperty.Over.w (W'.map t).right, hd1, hd1]
      · rw [← Category.assoc, hd3, hd3]
        exact congrArg (fun f => f.left) (StructuredArrow.w (W'.map t))

    obtain ⟨δ, hδ, -⟩ := hlim (Spec (.of R)) d hdc
    obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
    refine ⟨δ, ?_, fun l => ?_⟩
    · rw [← hφa l₀, ← Category.assoc, hδ l₀, hd1]
    · rw [hδ l, hd3]
  set ρ₀ := Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin 0) A))) with hρ₀

  haveI hiso : IsIso ρ₀ := by
    rw [hρ₀, isIso_SpecMap_iff, CommRingCat.hom_ofHom]
    have hc : ∀ r : A, MvPolynomial.isEmptyAlgEquiv A (Fin 0) (algebraMap A _ r) = r := fun r => by
      rw [AlgEquiv.commutes]; rfl
    refine ⟨fun r s h => by rw [← hc r, ← hc s, h], fun p => ⟨MvPolynomial.isEmptyAlgEquiv A (Fin 0) p,
      (MvPolynomial.isEmptyAlgEquiv A (Fin 0)).injective (by rw [hc])⟩⟩

  have sepTransfer : ∀ (k k' : Type u) [Field k] [Field k'], (k ≃+* k') → IsSepClosed k →
      IsSepClosed k' := by
    intro k k' _ _ e hk
    apply IsSepClosed.of_exists_root
    intro p _ hirr hsep
    have hq : (p.map (e.symm : k' →+* k)).Separable := hsep.map
    have hdeg : (p.map (e.symm : k' →+* k)).degree ≠ 0 := by
      rw [Polynomial.degree_map]
      exact (Polynomial.degree_pos_of_irreducible hirr).ne'
    obtain ⟨r, hr⟩ := IsSepClosed.exists_root _ hdeg hq
    refine ⟨e r, ?_⟩
    have h0 : (e.symm : k' →+* k) (e r) = r := e.symm_apply_apply r
    have h1 : (e.symm : k' →+* k) (p.eval (e r)) = 0 := by
      rw [← Polynomial.eval₂_at_apply, h0, ← Polynomial.eval_map]
      exact hr
    exact (map_eq_zero_iff _ (e.symm : k' →+* k).injective).mp h1

  have hκ : Nonempty ((Spec (.of (MvPolynomial (Fin 0) A))).residueField x ≃+*
      IsLocalRing.ResidueField A) := by
    haveI : IsOpenImmersion ρ₀ := IsOpenImmersion.of_isIso ρ₀
    have gen : ∀ (X : Scheme.{u}) (p : X), IsLocalRing (X.presheaf.stalk p) := fun X p => inferInstance
    haveI := gen (Spec (.of A)) (IsLocalRing.closedPoint A)
    let i1 : (Spec (.of A)).residueField (ρ₀ x) ≅ (Spec (.of (MvPolynomial (Fin 0) A))).residueField x :=
      asIso (ρ₀.residueFieldMap x)
    let i2 : (Spec (.of A)).residueField (ρ₀ x) ≅ (Spec (.of A)).residueField (IsLocalRing.closedPoint A) :=
      Scheme.residueFieldCongr hx
    let i3 : (Spec (.of A)).presheaf.stalk (IsLocalRing.closedPoint A) ≅ CommRingCat.of A :=
      stalkClosedPointIso (CommRingCat.of A)
    exact ⟨(i1.symm ≪≫ i2).commRingCatIsoToRingEquiv.trans
      (IsLocalRing.ResidueField.mapEquiv i3.commRingCatIsoToRingEquiv)⟩
  obtain ⟨eκ⟩ := hκ
  have hsep : IsSepClosed ((Spec (.of (MvPolynomial (Fin 0) A))).residueField x) :=
    sepTransfer (IsLocalRing.ResidueField A) ((Spec (.of (MvPolynomial (Fin 0) A))).residueField x)
      eκ.symm hAsep

  have hgeom : ∀ z, wcEtGeomPt (Spec (.of (MvPolynomial (Fin 0) A))) x z = x := by
    intro z
    rw [wcEtGeomPt, Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply x _
  have hq1gen : ∀ z : Spec (.of (AlgebraicClosure ((Spec (.of (MvPolynomial (Fin 0) A))).residueField x))),
      (wcEtGeomPt (Spec (.of (MvPolynomial (Fin 0) A))) x ≫ ρ₀) z = IsLocalRing.closedPoint A := by
    intro z
    rw [Scheme.Hom.comp_apply, hgeom, hx]
  have hq1 : (wcEtGeomPt (Spec (.of (MvPolynomial (Fin 0) A))) x ≫ ρ₀)
      (IsLocalRing.closedPoint (AlgebraicClosure ((Spec (.of (MvPolynomial (Fin 0) A))).residueField x))) =
      IsLocalRing.closedPoint A := hq1gen _
  have hq2 : (wcEtGeomPt (Spec (.of (MvPolynomial (Fin 0) A))) x ≫ ρ₀) ≫ inv ρ₀ =
      wcEtGeomPt (Spec (.of (MvPolynomial (Fin 0) A))) x := by
    rw [Category.assoc, IsIso.hom_inv_id, Category.comp_id]
  obtain ⟨δ, hδa, hδφ⟩ := @Lift _ x hsep B _ _ Λ _ _ W' φ a hd A _ _ hAsep (inv ρ₀)
    (wcEtGeomPt (Spec (.of (MvPolynomial (Fin 0) A))) x ≫ ρ₀) hq1 hq2
  have R1 : δ ≫ (a ≫ ρ₀) = 𝟙 _ := by
    rw [← Category.assoc, hδa, IsIso.inv_hom_id]

  obtain ⟨e', hN⟩ := hNR x B Λ W' φ a hd
  obtain ⟨-, -, hcomp, hφa, hlim, -⟩ := hd
  have hqpt : ∀ (z : Spec (.of (AlgebraicClosure ((Spec (.of (MvPolynomial (Fin 0) A))).residueField x)))),
      (Spec.map (CommRingCat.ofHom e') ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) z =
        IsLocalRing.closedPoint B := by
    intro z
    rw [Scheme.Hom.comp_apply]
    exact IsLocalRing.PrimeSpectrum.comap_residue B _
  obtain ⟨π, hπdef⟩ : ∃ π, π = Spec.map (CommRingCat.ofHom e') ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) := ⟨_, rfl⟩
  have hπpt : π (IsLocalRing.closedPoint
      (AlgebraicClosure ((Spec (.of (MvPolynomial (Fin 0) A))).residueField x))) =
      IsLocalRing.closedPoint B := by
    rw [hπdef]; exact hqpt _
  have hNπ : ∀ l, π ≫ φ l = (W'.obj l).hom.left := fun l => by
    rw [hπdef, Category.assoc]; exact hN l
  obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
  have hπa : π ≫ a = wcEtGeomPt (Spec (.of (MvPolynomial (Fin 0) A))) x := by
    rw [← hφa l₀, ← Category.assoc, hNπ l₀]
    exact Over.w (W'.obj l₀).hom

  have hAG : ∀ {V S : Scheme.{u}} (h : V ⟶ S) [Etale h] (g₁ g₂ : Spec (.of B) ⟶ V),
      g₁ ≫ h = g₂ ≫ h → π ≫ g₁ = π ≫ g₂ → g₁ = g₂ := by
    intro V S h _ g₁ g₂ hh hq
    obtain ⟨U, hU, hUeq⟩ := s0 h g₁ g₂ hh _ π hq
    have hU' : IsLocalRing.closedPoint B ∈ U := by
      rw [← hπpt]
      exact hU
    have hsub : Set.range ⇑(𝟙 (Spec (.of B))) ⊆ Set.range ⇑U.ι := by
      intro p _
      rw [Scheme.Opens.range_ι]
      exact (IsLocalRing.specializes_closedPoint (R := B) p).mem_open U.isOpen hU'
    have hk := IsOpenImmersion.lift_fac U.ι (𝟙 _) hsub
    calc g₁ = (IsOpenImmersion.lift U.ι (𝟙 _) hsub ≫ U.ι) ≫ g₁ := by
          rw [hk, Category.id_comp]
      _ = (IsOpenImmersion.lift U.ι (𝟙 _) hsub ≫ U.ι) ≫ g₂ := by
          simp only [Category.assoc, hUeq]
      _ = g₂ := by rw [hk, Category.id_comp]
  have hagree : ∀ l, ((a ≫ ρ₀) ≫ δ) ≫ φ l = φ l := by
    intro l
    haveI : Etale (W'.obj l).right.hom := (W'.obj l).right.prop
    apply hAG (W'.obj l).right.hom
    · simp only [Category.assoc]
      rw [hφa l, hδa, IsIso.hom_inv_id, Category.comp_id]
    · have e1 : π ≫ ((a ≫ ρ₀) ≫ δ) ≫ φ l = ((π ≫ a) ≫ ρ₀) ≫ δ ≫ φ l := by
        simp only [Category.assoc]
      have e2 : ((π ≫ a) ≫ ρ₀) ≫ δ ≫ φ l =
          (wcEtGeomPt (Spec (.of (MvPolynomial (Fin 0) A))) x ≫ ρ₀) ≫ δ ≫ φ l := by
        rw [hπa]
      have e3 : π ≫ φ l = (wcEtGeomPt (Spec (.of (MvPolynomial (Fin 0) A))) x ≫ ρ₀) ≫ δ ≫ φ l :=
        (hNπ l).trans (hδφ l).symm
      exact e1.trans (e2.trans e3.symm)
  have R2 : (a ≫ ρ₀) ≫ δ = 𝟙 _ :=
    (hlim (Spec (.of B)) φ hcomp).unique hagree (fun l => Category.id_comp _)
  exact ⟨⟨δ, R2, R1⟩⟩

theorem wc_et_coh_subring_factor_vanishing : ∀ (R : Type u) [CommRing R] (m q : ℕ), (∀ F : Finset R, ∃ (T : Type u) (_ : CommRing T) (ψ : ↥(Subring.closure (F : Set R)) →+* T) (j : T →+* R), j.comp ψ = (Subring.closure (F : Set R)).subtype ∧ Subsingleton (wcEtCoh (Spec (.of T)) m q)) → Subsingleton (wcEtCoh (Spec (.of R)) m q) :=
by
  intro R _ m q hyp
  haveI := wc_et_enough_injectives (Spec (.of R))
  let J := InjectiveResolution.of ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of R)))
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
  refine (wc_et_coh_subsingleton_iff_injres_cocycles (Spec (.of R)) m q J).mpr ?_
  intro z hz
  obtain ⟨K, εK, hεK, hmono, hex0, hex, hacyc, I, τ, hτ, hdesc⟩ :=
    wc_et_subring_colimit_resolution R m
  obtain ⟨α, hα⟩ := wc_et_acyclic_res_cocycle_comparison (Spec (.of R)) _ K εK hεK hmono hex0 hex
    hacyc J
  obtain ⟨k, b, hk, hzk⟩ := hα q z hz
  obtain ⟨F, c, hc, hck⟩ := hdesc q k hk
  obtain ⟨T, _, ψ, j, hψ, hT⟩ := hyp F
  have hp : Spec.map (CommRingCat.ofHom j) ≫ Spec.map (CommRingCat.ofHom ψ) =
      Spec.map (CommRingCat.ofHom (Subring.closure (F : Set R)).subtype) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hψ]
  let τ' : ∀ n : ℕ, wcEtTransport (Spec.map (CommRingCat.ofHom (Subring.closure (F : Set R)).subtype))
      ((I F).cocomplex.X n) (J.cocomplex.X n) := fun n =>
    { ρ := fun V O h hh => ((α.f n).hom.app (Opposite.op O)).hom.comp ((τ F n).ρ V O h hh)
      nat := by
        intro V V' c' O O' d h hh h' hh' hc' x
        show ((α.f n).hom.app (Opposite.op O')).hom ((τ F n).ρ V' O' h' hh' _) = _
        rw [(τ F n).nat V V' c' O O' d h hh h' hh' hc' x]
        exact congrArg (fun φ => AddCommGrpCat.Hom.hom φ ((τ F n).ρ V O h hh x))
          ((α.f n).hom.naturality d.op) }
  have hτ' : ∀ (n : ℕ) (V : (Spec (.of ↥(Subring.closure (F : Set R)))).Etale)
      (O : (Spec (.of R)).Etale) (k' : O.left ⟶ V.left)
      (hk' : k' ≫ V.hom = O.hom ≫ Spec.map (CommRingCat.ofHom (Subring.closure (F : Set R)).subtype))
      (x : ((I F).cocomplex.X n).obj.obj (Opposite.op V)),
      (τ' (n + 1)).ρ V O k' hk' ((((I F).cocomplex.d n (n + 1)).hom.app (Opposite.op V)).hom x) =
        ((J.cocomplex.d n (n + 1)).hom.app (Opposite.op O)).hom ((τ' n).ρ V O k' hk' x) := by
    intro n V O k' hk' x
    show ((α.f (n + 1)).hom.app (Opposite.op O)).hom ((τ F (n + 1)).ρ V O k' hk' _) =
      ((J.cocomplex.d n (n + 1)).hom.app (Opposite.op O)).hom
        (((α.f n).hom.app (Opposite.op O)).hom ((τ F n).ρ V O k' hk' x))
    rw [hτ F n V O k' hk' x]
    exact (congrArg (fun φ => AddCommGrpCat.Hom.hom (φ.hom.app (Opposite.op O))
      ((τ F n).ρ V O k' hk' x)) (α.comm n (n + 1))).symm
  obtain ⟨b', hb'⟩ := wc_et_injres_transport_factor_coboundary (Spec.map (CommRingCat.ofHom j))
    (Spec.map (CommRingCat.ofHom ψ))
    (Spec.map (CommRingCat.ofHom (Subring.closure (F : Set R)).subtype)) hp m q hT (I F) J τ' hτ'
    c hc
  refine ⟨b' + b, ?_⟩
  rw [map_add, hb', hzk]
  congr 1
  show ((α.f q).hom.app _).hom ((τ F q).ρ _ _ _ _ c) = _
  rw [hck]

theorem wc_shens_noetherian_subring_local : ∀ (N A : Type u) [CommRing N] [IsNoetherianRing N] [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (κ : N →+* A) (S : Finset A), ∃ B : Subring A, (∀ a ∈ S, a ∈ B) ∧ (∀ c : N, κ c ∈ B) ∧ ∃ (_ : HenselianLocalRing ↥B), IsSepClosed (IsLocalRing.ResidueField ↥B) ∧ IsNoetherianRing ↥B ∧ IsLocalHom B.subtype :=
by
  intro N A _ _ _ _ hsepA κ S
  classical
  letI : Algebra N A := κ.toAlgebra

  let C : Subalgebra N A := Algebra.adjoin N (↑S : Set A)
  haveI : Algebra.FiniteType N C :=
    (Subalgebra.fg_iff_finiteType C).mp (Subalgebra.fg_adjoin_finset S)
  haveI : IsNoetherianRing C := Algebra.FiniteType.isNoetherianRing N C

  obtain ⟨R, _, σ, ρ, _, hρσ, hHR, hsepR, hρloc, hind⟩ := wc_strict_hull C A hsepA

  have happrox := wc_indEtale_local_noetherian_approx C R σ hind
  have hmFG : (IsLocalRing.maximalIdeal R).FG := by
    obtain ⟨R', _, _, _, φ, -, hmap, -⟩ := happrox ∅
    rw [← hmap]
    exact Ideal.FG.map (IsNoetherian.noetherian _) φ
  have hclosed : ∀ J : Ideal R, J.FG →
      ⨅ n : ℕ, (J ⊔ IsLocalRing.maximalIdeal R ^ n) = J := by
    intro J hJ
    obtain ⟨G₀, hG₀⟩ := hJ
    refine le_antisymm ?_ (le_iInf fun n => le_sup_left)
    intro x hx
    have hx' : ∀ n : ℕ, x ∈ J ⊔ IsLocalRing.maximalIdeal R ^ n :=
      fun n => (Submodule.mem_iInf _).mp hx n
    obtain ⟨R', _, _, _, φ, hrange, hmap, hcomap⟩ := happrox (insert x G₀)
    choose! pre hpre using fun g (hg : g ∈ insert x G₀) => RingHom.mem_range.mp (hrange g hg)
    set J' : Ideal R' := Ideal.span (pre '' (G₀ : Set R)) with hJ'
    have himg : (fun g => φ (pre g)) '' (G₀ : Set R) = (G₀ : Set R) := by
      ext y
      constructor
      · rintro ⟨g, hg, rfl⟩
        show φ (pre g) ∈ (G₀ : Set R)
        rw [hpre g (Finset.mem_insert_of_mem hg)]
        exact hg
      · intro hy
        exact ⟨y, hy, hpre y (Finset.mem_insert_of_mem hy)⟩
    have hJmap : Ideal.map φ J' = J := by
      rw [hJ', Ideal.map_span, Set.image_image, himg]
      exact hG₀
    have hxx : φ (pre x) = x := hpre x (Finset.mem_insert_self _ _)
    have hmem : ∀ n : ℕ, pre x ∈ J' ⊔ IsLocalRing.maximalIdeal R' ^ n := by
      intro n
      rw [← hcomap (J' ⊔ IsLocalRing.maximalIdeal R' ^ n), Ideal.mem_comap,
        Ideal.map_sup, Ideal.map_pow, hmap, hJmap, hxx]
      exact hx' n
    haveI : Module.Finite R' (R' ⧸ J') :=
      Module.Finite.of_surjective (Submodule.mkQ J') (Submodule.mkQ_surjective _)
    have hK := Ideal.iInf_pow_smul_eq_bot_of_isLocalRing (M := R' ⧸ J')
      (IsLocalRing.maximalIdeal R') (Ideal.IsMaximal.ne_top inferInstance)
    have hq : (Submodule.Quotient.mk (pre x) : R' ⧸ J') ∈ (⊥ : Submodule R' (R' ⧸ J')) := by
      rw [← hK, Submodule.mem_iInf]
      intro n
      obtain ⟨j, hj, y, hy, hjy⟩ := Submodule.mem_sup.mp (hmem n)
      have hjz : (Submodule.Quotient.mk j : R' ⧸ J') = 0 := (Submodule.Quotient.mk_eq_zero J').mpr hj
      have hxy : (Submodule.Quotient.mk (pre x) : R' ⧸ J') = y • Submodule.Quotient.mk 1 := by
        rw [← hjy, ← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one, Submodule.Quotient.mk_add,
          hjz, zero_add]
      rw [hxy]
      exact Submodule.smul_mem_smul hy Submodule.mem_top
    rw [Submodule.mem_bot, Submodule.Quotient.mk_eq_zero] at hq
    rw [← hJmap, ← hxx]
    exact Ideal.mem_map_of_mem φ hq

  haveI : IsNoetherianRing R := wc_local_noetherian_of_closed_fg_ideals R hmFG hclosed

  haveI := hHR
  obtain ⟨hHB, hloc⟩ := wc_hnas_range_henselian R A ρ hρloc
  haveI := hHB
  refine ⟨ρ.range, ?_, ?_, hHB, ?_, isNoetherianRing_range ρ, hloc⟩
  · intro a ha
    have haC : a ∈ C := Algebra.subset_adjoin (Finset.mem_coe.mpr ha)
    exact RingHom.mem_range.mpr ⟨σ ⟨a, haC⟩, RingHom.congr_fun hρσ ⟨a, haC⟩⟩
  · intro c
    have hcC : κ c ∈ C := C.algebraMap_mem c
    exact RingHom.mem_range.mpr ⟨σ ⟨κ c, hcC⟩, RingHom.congr_fun hρσ ⟨κ c, hcC⟩⟩
  ·
    let f : R →+* ρ.range := ρ.rangeRestrict
    have hf : Function.Surjective f := ρ.rangeRestrict_surjective
    haveI : IsLocalHom f := IsLocalHom.of_surjective f hf
    let g := IsLocalRing.ResidueField.map f
    have hg : Function.Bijective g := by
      refine ⟨g.injective, ?_⟩
      intro y
      obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective y
      obtain ⟨r, rfl⟩ := hf b
      exact ⟨IsLocalRing.residue R r, IsLocalRing.ResidueField.map_residue f r⟩
    let e := RingEquiv.ofBijective g hg
    let eR : IsLocalRing.ResidueField R →+* IsLocalRing.ResidueField ρ.range := e.toRingHom
    let eS : IsLocalRing.ResidueField ρ.range →+* IsLocalRing.ResidueField R := e.symm.toRingHom
    have heRS : ∀ c, eR (eS c) = c := fun c => e.apply_symm_apply c
    apply IsSepClosed.of_exists_root
    intro p _ hirr hsep
    obtain ⟨x', hx'⟩ := IsSepClosed.exists_root (p.map eS)
      (by rw [Polynomial.degree_map p eS]
          exact (Polynomial.degree_pos_of_irreducible hirr).ne')
      hsep.map
    refine ⟨eR x', ?_⟩
    have hp : p = (p.map eS).map eR := by
      rw [Polynomial.map_map]
      ext n
      rw [Polynomial.coeff_map, RingHom.comp_apply, heRS]
    rw [hp, Polynomial.eval_map, Polynomial.eval₂_at_apply, hx'.eq_zero, map_zero]

theorem wc_subring_closure_factor_of_lifts : ∀ (R : Type u) [CommRing R] (F : Finset R), ∃ G : Finset (MvPolynomial (↥F) ℤ), (∀ g ∈ G, MvPolynomial.aeval (fun r : ↥F => (r : R)) g = 0) ∧ ∀ (S : Type u) [CommRing S] (j : S →+* R) (t : ↥F → S), (∀ r : ↥F, j (t r) = r) → (∀ g ∈ G, MvPolynomial.aeval t g = 0) → ∃ ψ : ↥(Subring.closure (F : Set R)) →+* S, j.comp ψ = (Subring.closure (F : Set R)).subtype :=
by
  intro R _ F
  classical
  set T : Subring R := Subring.closure (F : Set R) with hT
  set ev : MvPolynomial (↥F) ℤ →+* R :=
    (MvPolynomial.aeval (fun r : ↥F => (r : R))).toRingHom with hev
  have hFG : (RingHom.ker ev).FG := IsNoetherian.noetherian (RingHom.ker ev)
  obtain ⟨G, hG⟩ := hFG
  have hGker : ∀ g ∈ G, ev g = 0 := by
    intro g hg
    have : g ∈ RingHom.ker ev := by
      rw [← hG]
      exact Submodule.subset_span (Finset.mem_coe.mpr hg)
    exact (RingHom.mem_ker).mp this
  refine ⟨G, fun g hg => hGker g hg, ?_⟩
  intro S _ j t hlift hrel
  have hmem : ∀ p, ev p ∈ T := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C n =>
      have : ev (MvPolynomial.C n) = (n : R) := by
        simp [hev]
      rw [this]
      exact intCast_mem T n
    | add p q hp hq =>
      rw [map_add]
      exact add_mem hp hq
    | mul_X p r hp =>
      rw [map_mul]
      refine mul_mem hp ?_
      have : ev (MvPolynomial.X r) = (r : R) := by
        simp [hev]
      rw [this]
      exact Subring.subset_closure (Finset.mem_coe.mpr r.2)
  set π : MvPolynomial (↥F) ℤ →+* T := ev.codRestrict T hmem with hπ
  have hπev : T.subtype.comp π = ev := RingHom.ext fun _ => rfl
  have hsurj : Function.Surjective π := by
    have hle : T ≤ ev.range := by
      rw [hT, Subring.closure_le]
      intro x hx
      refine ⟨MvPolynomial.X ⟨x, Finset.mem_coe.mp hx⟩, ?_⟩
      simp [hev]
    intro y
    obtain ⟨p, hp⟩ := hle y.2
    exact ⟨p, Subtype.ext hp⟩
  set evS : MvPolynomial (↥F) ℤ →+* S := (MvPolynomial.aeval t).toRingHom with hevS
  have hker : RingHom.ker π ≤ RingHom.ker evS := by
    have h1 : RingHom.ker π = RingHom.ker ev := by
      ext p
      simp only [RingHom.mem_ker]
      constructor
      · intro h
        have := congrArg Subtype.val h
        exact this
      · intro h
        exact Subtype.ext h
    rw [h1, ← hG]
    refine Submodule.span_le.mpr ?_
    intro g hg
    exact (RingHom.mem_ker).mpr (hrel g (Finset.mem_coe.mp hg))
  set ψ : T →+* S := (RingHom.liftOfSurjective π hsurj) ⟨evS, hker⟩ with hψ
  have hψπ : ψ.comp π = evS := RingHom.liftOfSurjective_comp π hsurj ⟨evS, hker⟩
  have hjev : j.comp evS = ev := by
    apply MvPolynomial.ringHom_ext
    · intro n
      simp [hevS, hev]
    · intro r
      simp [hevS, hev, hlift]
  refine ⟨ψ, ?_⟩
  apply (RingHom.cancel_right hsurj).mp
  rw [RingHom.comp_assoc, hψπ, hjev, hπev]

theorem wc_spec_pullback_gamma_tensor : ∀ (P B C : Type u) [CommRing P] [CommRing B] [CommRing C] (α : P →+* B) (γ : P →+* C) (f : Spec (.of B) ⟶ Spec (.of P)) (g : Spec (.of C) ⟶ Spec (.of P)), Spec.map (CommRingCat.ofHom α) = f → Spec.map (CommRingCat.ofHom γ) = g → letI : Algebra P B := α.toAlgebra; letI : Algebra P C := γ.toAlgebra; ∃ e : Γ(Limits.pullback f g, ⊤) ≃+* TensorProduct P B C, (∀ b : B, e ((Limits.pullback.fst f g).appTop.hom ((Scheme.ΓSpecIso (.of B)).inv.hom b)) = b ⊗ₜ[P] 1) ∧ (∀ c : C, e ((Limits.pullback.snd f g).appTop.hom ((Scheme.ΓSpecIso (.of C)).inv.hom c)) = 1 ⊗ₜ[P] c) :=
by
  intro P B C _ _ _ α γ f g hf hg
  subst hf hg
  letI : Algebra P B := α.toAlgebra
  letI : Algebra P C := γ.toAlgebra
  change ∃ e : Γ(Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap P B)))
      (Spec.map (CommRingCat.ofHom (algebraMap P C))), ⊤) ≃+* TensorProduct P B C,
    (∀ b : B, e ((Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap P B)))
      (Spec.map (CommRingCat.ofHom (algebraMap P C)))).appTop.hom
        ((Scheme.ΓSpecIso (.of B)).inv.hom b)) = b ⊗ₜ[P] 1) ∧
    (∀ c : C, e ((Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap P B)))
      (Spec.map (CommRingCat.ofHom (algebraMap P C)))).appTop.hom
        ((Scheme.ΓSpecIso (.of C)).inv.hom c)) = 1 ⊗ₜ[P] c)
  have k1 : ∀ z, (pullbackSpecIso P B C).inv.appTop.hom
      ((pullbackSpecIso P B C).hom.appTop.hom z) = z := fun z => by
    rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, Iso.inv_hom_id,
      Scheme.Hom.id_appTop, CommRingCat.id_apply]
  have k2 : ∀ z, (pullbackSpecIso P B C).hom.appTop.hom
      ((pullbackSpecIso P B C).inv.appTop.hom z) = z := fun z => by
    rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, Iso.hom_inv_id,
      Scheme.Hom.id_appTop, CommRingCat.id_apply]
  have k3 : ∀ y, (Scheme.ΓSpecIso (CommRingCat.of (TensorProduct P B C))).hom.hom
      ((Scheme.ΓSpecIso (CommRingCat.of (TensorProduct P B C))).inv.hom y) = y := fun y => by
    rw [← CommRingCat.comp_apply, Iso.inv_hom_id, CommRingCat.id_apply]
  have k4 : ∀ y, (Scheme.ΓSpecIso (CommRingCat.of (TensorProduct P B C))).inv.hom
      ((Scheme.ΓSpecIso (CommRingCat.of (TensorProduct P B C))).hom.hom y) = y := fun y => by
    rw [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply]
  let e : Γ(Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap P B)))
      (Spec.map (CommRingCat.ofHom (algebraMap P C))), ⊤) ≃+* TensorProduct P B C :=
    RingEquiv.ofRingHom
      ((Scheme.ΓSpecIso (CommRingCat.of (TensorProduct P B C))).hom.hom.comp
        (pullbackSpecIso P B C).inv.appTop.hom)
      ((pullbackSpecIso P B C).hom.appTop.hom.comp
        (Scheme.ΓSpecIso (CommRingCat.of (TensorProduct P B C))).inv.hom)
      (RingHom.ext fun y => by
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [k1, k3])
      (RingHom.ext fun z => by
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [k4, k2])
  refine ⟨e, fun b => ?_, fun c => ?_⟩
  · show (Scheme.ΓSpecIso (CommRingCat.of (TensorProduct P B C))).hom.hom
      ((pullbackSpecIso P B C).inv.appTop.hom
        ((Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap P B)))
          (Spec.map (CommRingCat.ofHom (algebraMap P C)))).appTop.hom
        ((Scheme.ΓSpecIso (.of B)).inv.hom b))) = _
    have hc : ∀ x, (pullbackSpecIso P B C).inv.appTop.hom
        ((Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap P B)))
          (Spec.map (CommRingCat.ofHom (algebraMap P C)))).appTop.hom x) =
        (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
          (R := P) (A := B) (B := C)))).appTop.hom x := by
      intro x
      rw [← pullbackSpecIso_inv_fst, Scheme.Hom.comp_appTop, CommRingCat.hom_comp,
        RingHom.comp_apply]
    rw [hc]
    have h := RingHom.congr_fun (congrArg CommRingCat.Hom.hom (Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := P) (A := B) (B := C))))) b
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h
    rw [← h, k3]
    rfl
  · show (Scheme.ΓSpecIso (CommRingCat.of (TensorProduct P B C))).hom.hom
      ((pullbackSpecIso P B C).inv.appTop.hom
        ((Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap P B)))
          (Spec.map (CommRingCat.ofHom (algebraMap P C)))).appTop.hom
        ((Scheme.ΓSpecIso (.of C)).inv.hom c))) = _
    have hc : ∀ x, (pullbackSpecIso P B C).inv.appTop.hom
        ((Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap P B)))
          (Spec.map (CommRingCat.ofHom (algebraMap P C)))).appTop.hom x) =
        (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := P) (A := B)
          (B := C) : C →+* TensorProduct P B C))).appTop.hom x := by
      intro x
      rw [← pullbackSpecIso_inv_snd, Scheme.Hom.comp_appTop, CommRingCat.hom_comp,
        RingHom.comp_apply]
    rw [hc]
    have h := RingHom.congr_fun (congrArg CommRingCat.Hom.hom (Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := P) (A := B) (B := C) :
        C →+* TensorProduct P B C)))) c
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h
    rw [← h, k3]
    rfl

theorem wc_spec_pullback_gamma_tensor_natural : ∀ (P B C P' B' C' : Type u) [CommRing P] [CommRing B] [CommRing C] [CommRing P'] [CommRing B'] [CommRing C'] (α : P →+* B) (γ : P →+* C) (α' : P' →+* B') (γ' : P' →+* C') (f : Spec (.of B) ⟶ Spec (.of P)) (g : Spec (.of C) ⟶ Spec (.of P)) (f' : Spec (.of B') ⟶ Spec (.of P')) (g' : Spec (.of C') ⟶ Spec (.of P')) (u : Spec (.of B) ⟶ Spec (.of B')) (v : Spec (.of C) ⟶ Spec (.of C')) (w : Spec (.of P) ⟶ Spec (.of P')) (h₁ : f ≫ w = u ≫ f') (h₂ : g ≫ w = v ≫ g'), letI : Algebra P B := α.toAlgebra; letI : Algebra P C := γ.toAlgebra; letI : Algebra P' B' := α'.toAlgebra; letI : Algebra P' C' := γ'.toAlgebra; ∀ (e : Γ(Limits.pullback f g, ⊤) ≃+* TensorProduct P B C) (e' : Γ(Limits.pullback f' g', ⊤) ≃+* TensorProduct P' B' C'), (∀ b : B, e ((Limits.pullback.fst f g).appTop.hom ((Scheme.ΓSpecIso (.of B)).inv.hom b)) = b ⊗ₜ[P] 1) → (∀ c : C, e ((Limits.pullback.snd f g).appTop.hom ((Scheme.ΓSpecIso (.of C)).inv.hom c)) = 1 ⊗ₜ[P] c) → (∀ b : B', e' ((Limits.pullback.fst f' g').appTop.hom ((Scheme.ΓSpecIso (.of B')).inv.hom b)) = b ⊗ₜ[P'] 1) → (∀ c : C', e' ((Limits.pullback.snd f' g').appTop.hom ((Scheme.ΓSpecIso (.of C')).inv.hom c)) = 1 ⊗ₜ[P'] c) → ∀ (b : B') (c : C'), e ((Limits.pullback.map f g f' g' u v w h₁ h₂).appTop.hom (e'.symm (b ⊗ₜ[P'] c))) = (Spec.preimage u).hom b ⊗ₜ[P] (Spec.preimage v).hom c :=
by
  intro P B C P' B' C' _ _ _ _ _ _ α γ α' γ' f g f' g' u v w h₁ h₂
  letI : Algebra P B := α.toAlgebra
  letI : Algebra P C := γ.toAlgebra
  letI : Algebra P' B' := α'.toAlgebra
  letI : Algebra P' C' := γ'.toAlgebra
  intro e e' E1 E2 E1' E2' b c
  have s2b : e'.symm (b ⊗ₜ[P'] (1 : C')) = (Limits.pullback.fst f' g').appTop.hom
      ((Scheme.ΓSpecIso (.of B')).inv.hom b) := by
    apply e'.injective
    rw [RingEquiv.apply_symm_apply, E1']
  have s2c : e'.symm ((1 : B') ⊗ₜ[P'] c) = (Limits.pullback.snd f' g').appTop.hom
      ((Scheme.ΓSpecIso (.of C')).inv.hom c) := by
    apply e'.injective
    rw [RingEquiv.apply_symm_apply, E2']
  have s3 : b ⊗ₜ[P'] c = (b ⊗ₜ[P'] (1 : C')) * ((1 : B') ⊗ₜ[P'] c) := by
    rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
  have hfst : Limits.pullback.map f g f' g' u v w h₁ h₂ ≫ Limits.pullback.fst f' g' =
      Limits.pullback.fst f g ≫ u := Limits.pullback.lift_fst _ _ _
  have hsnd : Limits.pullback.map f g f' g' u v w h₁ h₂ ≫ Limits.pullback.snd f' g' =
      Limits.pullback.snd f g ≫ v := Limits.pullback.lift_snd _ _ _
  have Tfst : ∀ x, (Limits.pullback.map f g f' g' u v w h₁ h₂).appTop.hom
      ((Limits.pullback.fst f' g').appTop.hom x) =
      (Limits.pullback.fst f g).appTop.hom (u.appTop.hom x) := by
    intro x
    have h := congrArg (fun k => k.appTop.hom x) hfst
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h
    exact h
  have Tsnd : ∀ x, (Limits.pullback.map f g f' g' u v w h₁ h₂).appTop.hom
      ((Limits.pullback.snd f' g').appTop.hom x) =
      (Limits.pullback.snd f g).appTop.hom (v.appTop.hom x) := by
    intro x
    have h := congrArg (fun k => k.appTop.hom x) hsnd
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h
    exact h
  have Ku : ∀ x : B', u.appTop.hom ((Scheme.ΓSpecIso (.of B')).inv.hom x) =
      (Scheme.ΓSpecIso (.of B)).inv.hom ((Spec.preimage u).hom x) := by
    intro x
    have h := congrArg (fun k => k.hom x) (Scheme.ΓSpecIso_inv_naturality (Spec.preimage u))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h
    rw [Spec.map_preimage] at h
    exact h.symm
  have Kv : ∀ x : C', v.appTop.hom ((Scheme.ΓSpecIso (.of C')).inv.hom x) =
      (Scheme.ΓSpecIso (.of C)).inv.hom ((Spec.preimage v).hom x) := by
    intro x
    have h := congrArg (fun k => k.hom x) (Scheme.ΓSpecIso_inv_naturality (Spec.preimage v))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h
    rw [Spec.map_preimage] at h
    exact h.symm
  rw [s3, map_mul, s2b, s2c, map_mul, Tfst, Tsnd, Ku, Kv, map_mul, E1, E2,
    Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]

theorem wc_tube_stage_filtered_lift : ∀ (A B C : Type u) [CommRing A] [CommRing B] [CommRing C] (β : Polynomial A →+* B) (γ : A →+* C) (I : Type u) [SmallCategory I] [IsFiltered I] (D : I ⥤ CommRingCat.{u}) (p : ∀ i, Polynomial A →+* D.obj i) (ι : ∀ i, D.obj i →+* B), (∀ {i j : I} (h : i ⟶ j), (D.map h).hom.comp (p i) = p j) → (∀ {i j : I} (h : i ⟶ j), (ι j).comp (D.map h).hom = ι i) → (∀ i, (ι i).comp (p i) = β) → (∀ b : B, ∃ (i : I) (s : D.obj i), ι i s = b) → (∀ (i : I) (s : D.obj i), ι i s = 0 → ∃ (j : I) (h : i ⟶ j), (D.map h).hom s = 0) → letI : Algebra A B := (β.comp (algebraMap A (Polynomial A))).toAlgebra; letI : Algebra A C := γ.toAlgebra; ∀ (κ : Type u) [Fintype κ] (r : κ → TensorProduct A B C) (G : Finset (MvPolynomial κ ℤ)), (∀ g ∈ G, MvPolynomial.aeval r g = 0) → ∃ i : I, letI : Algebra A (D.obj i) := ((p i).comp (algebraMap A (Polynomial A))).toAlgebra; ∃ e : κ → TensorProduct A (D.obj i) C, (∀ g ∈ G, MvPolynomial.aeval e g = 0) ∧ ∀ Λ0 : TensorProduct A (D.obj i) C →+ TensorProduct A B C, (∀ (x : D.obj i) (z : C), Λ0 (x ⊗ₜ[A] z) = ι i x ⊗ₜ[A] z) → ∀ k, Λ0 (e k) = r k :=
by
  intro A B C _ _ _ β γ I _ _ D p ι hDp hιD hιp hsurj hker
  letI : Algebra A B := (β.comp (algebraMap A (Polynomial A))).toAlgebra
  letI : Algebra A C := γ.toAlgebra
  intro κ _ r G hr
  classical

  have aeval_map : ∀ {R S : Type u} [CommRing R] [CommRing S] (j : R →+* S) (v : κ → R)
      (g : MvPolynomial κ ℤ),
      MvPolynomial.aeval (fun i => j (v i)) g = j (MvPolynomial.aeval v g) := by
    intro R S _ _ j v g
    have h : (j.toIntAlgHom).comp (MvPolynomial.aeval v) =
        MvPolynomial.aeval (fun i => j (v i)) :=
      MvPolynomial.algHom_ext (fun i => by simp)
    exact (congrArg (fun ψ => ψ g) h).symm

  have s1 : ∀ (X : I → Type u) [∀ i, AddCommGroup (X i)] [∀ i, Module A (X i)]
      (τ : ∀ {i j : I}, (i ⟶ j) → (X i →ₗ[A] X j)),
      (∀ {i j k : I} (f : i ⟶ j) (g : j ⟶ k) (x : X i), τ (f ≫ g) x = τ g (τ f x)) →
      (∀ (i : I) (x : X i), τ (𝟙 i) x = x) →
      ∀ (M : Type u) [AddCommGroup M] [Module A M] (ι : ∀ i, X i →ₗ[A] M),
      (∀ {i j : I} (h : i ⟶ j) (x : X i), ι j (τ h x) = ι i x) →
      (∀ m : M, ∃ (i : I) (x : X i), ι i x = m) →
      (∀ (i : I) (x : X i), ι i x = 0 → ∃ (j : I) (h : i ⟶ j), τ h x = 0) →
      ∀ (N : Type u) [AddCommGroup N] [Module A N] (i : I) (z : TensorProduct A (X i) N),
      LinearMap.rTensor N (ι i) z = 0 → ∃ (j : I) (h : i ⟶ j), LinearMap.rTensor N (τ h) z = 0 := by
    intro X _ _ τ hcomp hid M _ _ ι hcoc hsurj' hker' N _ _ i z hz
    let G' : I ⥤ ModuleCat.{u} A :=
      { obj := fun i => ModuleCat.of A (TensorProduct A (X i) N)
        map := fun h => ModuleCat.ofHom (LinearMap.rTensor N (τ h))
        map_id := fun i => ModuleCat.hom_ext (TensorProduct.ext' fun x n => by
          simp [hid])
        map_comp := fun f g => ModuleCat.hom_ext (TensorProduct.ext' fun x n => by
          simp [hcomp]) }
    have hcw : ∀ {i j : I} (h : i ⟶ j) (x : X i) (n : N),
        (Limits.colimit.ι G' j).hom (TensorProduct.tmul A (τ h x) n) =
          (Limits.colimit.ι G' i).hom (TensorProduct.tmul A x n) := by
      intro i j h x n
      rw [← Limits.colimit.w G' h, ModuleCat.hom_comp, LinearMap.comp_apply]
      rfl
    have W : ∀ (i i' : I) (x : X i) (x' : X i'), ι i x = ι i' x' → ∀ n : N,
        (Limits.colimit.ι G' i).hom (TensorProduct.tmul A x n) =
          (Limits.colimit.ι G' i').hom (TensorProduct.tmul A x' n) := by
      intro i i' x x' hxx n
      obtain ⟨l, h, hh⟩ := hker' _ (τ (IsFiltered.leftToMax i i') x -
          τ (IsFiltered.rightToMax i i') x') (by rw [map_sub, hcoc, hcoc, hxx, sub_self])
      rw [map_sub, ← hcomp, ← hcomp, sub_eq_zero] at hh
      rw [← hcw (IsFiltered.leftToMax i i' ≫ h) x n, ← hcw (IsFiltered.rightToMax i i' ≫ h) x' n,
        hh]
    choose ii xx hxx using hsurj'
    let Ψ : M → N → (Limits.colimit G' : ModuleCat.{u} A) := fun m n =>
      (Limits.colimit.ι G' (ii m)).hom (TensorProduct.tmul A (xx m) n)
    have hΨ : ∀ (i : I) (x : X i) (n : N), Ψ (ι i x) n =
        (Limits.colimit.ι G' i).hom (TensorProduct.tmul A x n) :=
      fun i x n => W _ _ _ _ (hxx _) n
    have H1 : ∀ (m₁ m₂ : M) (n : N), Ψ (m₁ + m₂) n = Ψ m₁ n + Ψ m₂ n := by
      intro m₁ m₂ n
      have e : ι (IsFiltered.max (ii m₁) (ii m₂))
          (τ (IsFiltered.leftToMax (ii m₁) (ii m₂)) (xx m₁) +
            τ (IsFiltered.rightToMax (ii m₁) (ii m₂)) (xx m₂)) = m₁ + m₂ := by
        rw [map_add, hcoc, hcoc, hxx, hxx]
      rw [← e, hΨ, TensorProduct.add_tmul, map_add, hcw, hcw]
    have H2 : ∀ (c : A) (m : M) (n : N), Ψ (c • m) n = c • Ψ m n := by
      intro c m n
      have e : ι (ii m) (c • xx m) = c • m := by rw [map_smul, hxx]
      rw [← e, hΨ, ← TensorProduct.smul_tmul', map_smul]
    have H3 : ∀ (m : M) (n₁ n₂ : N), Ψ m (n₁ + n₂) = Ψ m n₁ + Ψ m n₂ := by
      intro m n₁ n₂
      show (Limits.colimit.ι G' (ii m)).hom (TensorProduct.tmul A (xx m) (n₁ + n₂)) = _
      rw [TensorProduct.tmul_add, map_add]
    have H4 : ∀ (c : A) (m : M) (n : N), Ψ m (c • n) = c • Ψ m n := by
      intro c m n
      show (Limits.colimit.ι G' (ii m)).hom (TensorProduct.tmul A (xx m) (c • n)) = _
      rw [TensorProduct.tmul_smul, map_smul]
    let Ψt := TensorProduct.lift (LinearMap.mk₂ A Ψ H1 H2 H3 H4)
    have hfac : ∀ w : TensorProduct A (X i) N,
        Ψt (LinearMap.rTensor N (ι i) w) = (Limits.colimit.ι G' i).hom w := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul x n =>
        rw [LinearMap.rTensor_tmul, TensorProduct.lift.tmul, LinearMap.mk₂_apply, hΨ]
      | add a b ha hb =>
        rw [map_add, map_add, ha, hb, map_add]
    have hc0 : (Limits.colimit.ι G' i).hom z = 0 := by
      rw [← hfac, hz, map_zero]
    obtain ⟨j, h, hh⟩ := Limits.Concrete.colimit_rep_eq_zero A G' i z hc0
    exact ⟨j, h, hh⟩

  have s2 : ∀ (X : I → Type u) [∀ i, AddCommGroup (X i)] [∀ i, Module A (X i)]
      (τ : ∀ {i j : I}, (i ⟶ j) → (X i →ₗ[A] X j)) (M : Type u) [AddCommGroup M] [Module A M]
      (ι : ∀ i, X i →ₗ[A] M), (∀ {i j : I} (h : i ⟶ j) (x : X i), ι j (τ h x) = ι i x) →
      (∀ m : M, ∃ (i : I) (x : X i), ι i x = m) →
      ∀ (N : Type u) [AddCommGroup N] [Module A N] (κ' : Type u) [Fintype κ']
      (r' : κ' → TensorProduct A M N), ∃ (i : I) (z : κ' → TensorProduct A (X i) N),
      ∀ k, LinearMap.rTensor N (ι i) (z k) = r' k := by
    intro X _ _ τ M _ _ ι hcoc hsurj' N _ _ κ' _ r'
    have push : ∀ {i j : I} (h : i ⟶ j) (w : TensorProduct A (X i) N),
        LinearMap.rTensor N (ι j) (LinearMap.rTensor N (τ h) w) = LinearMap.rTensor N (ι i) w := by
      intro i j h w
      have e : ι j ∘ₗ τ h = ι i := LinearMap.ext (hcoc h)
      rw [← LinearMap.rTensor_comp_apply, e]
    have one : ∀ w : TensorProduct A M N, ∃ (i : I) (z : TensorProduct A (X i) N),
        LinearMap.rTensor N (ι i) z = w := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero =>
        obtain ⟨i⟩ := IsFiltered.nonempty (C := I)
        exact ⟨i, 0, map_zero _⟩
      | tmul m n =>
        obtain ⟨i, x, hx⟩ := hsurj' m
        exact ⟨i, TensorProduct.tmul A x n, by rw [LinearMap.rTensor_tmul, hx]⟩
      | add w₁ w₂ ih₁ ih₂ =>
        obtain ⟨i₁, z₁, h₁⟩ := ih₁
        obtain ⟨i₂, z₂, h₂⟩ := ih₂
        refine ⟨IsFiltered.max i₁ i₂,
          LinearMap.rTensor N (τ (IsFiltered.leftToMax i₁ i₂)) z₁ +
            LinearMap.rTensor N (τ (IsFiltered.rightToMax i₁ i₂)) z₂, ?_⟩
        rw [map_add, push, push, h₁, h₂]
    choose ii zz hzz using one
    obtain ⟨S, hS⟩ := IsFiltered.sup_objs_exists (Finset.univ.image (fun k => ii (r' k)))
    have ha : ∀ k, Nonempty (ii (r' k) ⟶ S) :=
      fun k => hS (Finset.mem_image_of_mem _ (Finset.mem_univ k))
    refine ⟨S, fun k => LinearMap.rTensor N (τ (ha k).some) (zz (r' k)), fun k => ?_⟩
    rw [push, hzz]

  letI hAlg : ∀ i, Algebra A (D.obj i) :=
    fun i => ((p i).comp (algebraMap A (Polynomial A))).toAlgebra
  let τA : ∀ {i j : I}, (i ⟶ j) → (D.obj i →ₐ[A] D.obj j) := fun {i j} h =>
    { (D.map h).hom with
      commutes' := fun a => RingHom.congr_fun (hDp h) (algebraMap A (Polynomial A) a) }
  let ιA : ∀ i, D.obj i →ₐ[A] B := fun i =>
    { ι i with commutes' := fun a => RingHom.congr_fun (hιp i) (algebraMap A (Polynomial A) a) }
  let τL : ∀ {i j : I}, (i ⟶ j) → (D.obj i →ₗ[A] D.obj j) := fun h => (τA h).toLinearMap
  let ιL : ∀ i, D.obj i →ₗ[A] B := fun i => (ιA i).toLinearMap
  have hcomp : ∀ {i j k : I} (f : i ⟶ j) (g : j ⟶ k) (x : D.obj i),
      τL (f ≫ g) x = τL g (τL f x) := by
    intro i j k f g x
    show (D.map (f ≫ g)).hom x = (D.map g).hom ((D.map f).hom x)
    rw [D.map_comp, CommRingCat.hom_comp, RingHom.comp_apply]
  have hid : ∀ (i : I) (x : D.obj i), τL (𝟙 i) x = x := by
    intro i x
    show (D.map (𝟙 i)).hom x = x
    rw [D.map_id, CommRingCat.hom_id, RingHom.id_apply]
  have hcoc : ∀ {i j : I} (h : i ⟶ j) (x : D.obj i), ιL j (τL h x) = ιL i x :=
    fun h x => RingHom.congr_fun (hιD h) x
  have hτcomp : ∀ {i j k : I} (f : i ⟶ j) (g : j ⟶ k) (w : TensorProduct A (D.obj i) C),
      LinearMap.rTensor C (τL (f ≫ g)) w =
        LinearMap.rTensor C (τL g) (LinearMap.rTensor C (τL f) w) := by
    intro i j k f g w
    have e : τL (f ≫ g) = τL g ∘ₗ τL f := LinearMap.ext (hcomp f g)
    rw [e, LinearMap.rTensor_comp_apply]
  have hιcomp : ∀ {i j : I} (h : i ⟶ j) (w : TensorProduct A (D.obj i) C),
      LinearMap.rTensor C (ιL j) (LinearMap.rTensor C (τL h) w) = LinearMap.rTensor C (ιL i) w := by
    intro i j h w
    have e : ιL j ∘ₗ τL h = ιL i := LinearMap.ext (hcoc h)
    rw [← LinearMap.rTensor_comp_apply, e]

  obtain ⟨i₁, z, hz⟩ := s2 (fun i => D.obj i) τL B ιL hcoc hsurj C κ r

  have F2 : ∀ w : TensorProduct A (D.obj i₁) C,
      Algebra.TensorProduct.map (ιA i₁) (AlgHom.id A C) w = LinearMap.rTensor C (ιL i₁) w := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => simp
    | tmul x c =>
      rw [Algebra.TensorProduct.map_tmul, LinearMap.rTensor_tmul]
      rfl
    | add a b ha hb =>
      rw [map_add, map_add, ha, hb]
  have hwz : ∀ g ∈ G, LinearMap.rTensor C (ιL i₁) (MvPolynomial.aeval z g) = 0 := by
    intro g hg
    calc LinearMap.rTensor C (ιL i₁) (MvPolynomial.aeval z g)
        = (Algebra.TensorProduct.map (ιA i₁) (AlgHom.id A C)).toRingHom
            (MvPolynomial.aeval z g) := (F2 _).symm
      _ = MvPolynomial.aeval (fun k => (Algebra.TensorProduct.map (ιA i₁)
            (AlgHom.id A C)).toRingHom (z k)) g := (aeval_map _ _ _).symm
      _ = MvPolynomial.aeval r g :=
          congrArg (fun v => MvPolynomial.aeval v g) (funext fun k => (F2 _).trans (hz k))
      _ = 0 := hr g hg

  have kill : ∀ S : Finset (MvPolynomial κ ℤ), S ⊆ G → ∃ (k : I) (m : i₁ ⟶ k),
      ∀ g ∈ S, LinearMap.rTensor C (τL m) (MvPolynomial.aeval z g) = 0 := by
    intro S
    induction S using Finset.induction_on with
    | empty =>
      intro _
      exact ⟨i₁, 𝟙 i₁, fun g hg => by simp at hg⟩
    | insert g₀ S _ ih =>
      intro hS
      obtain ⟨k, m, hm⟩ := ih (fun g hg => hS (Finset.mem_insert_of_mem hg))
      have h0 : LinearMap.rTensor C (ιL k) (LinearMap.rTensor C (τL m)
          (MvPolynomial.aeval z g₀)) = 0 := by
        rw [hιcomp]
        exact hwz g₀ (hS (Finset.mem_insert_self _ _))
      obtain ⟨l, h, hh⟩ := s1 (fun i => D.obj i) τL hcomp hid B ιL hcoc hsurj hker C k _ h0
      refine ⟨l, m ≫ h, fun g hg => ?_⟩
      rw [hτcomp]
      rcases Finset.mem_insert.mp hg with rfl | hg
      · exact hh
      · rw [hm g hg, map_zero]
  obtain ⟨k, m, hm⟩ := kill G (subset_refl _)
  have F1 : ∀ w : TensorProduct A (D.obj i₁) C,
      Algebra.TensorProduct.map (τA m) (AlgHom.id A C) w = LinearMap.rTensor C (τL m) w := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => simp
    | tmul x c =>
      rw [Algebra.TensorProduct.map_tmul, LinearMap.rTensor_tmul]
      rfl
    | add a b ha hb =>
      rw [map_add, map_add, ha, hb]
  refine ⟨k, fun k' => Algebra.TensorProduct.map (τA m) (AlgHom.id A C) (z k'), ?_, ?_⟩
  · intro g hg
    calc MvPolynomial.aeval (fun k' => Algebra.TensorProduct.map (τA m) (AlgHom.id A C) (z k')) g
        = (Algebra.TensorProduct.map (τA m) (AlgHom.id A C)).toRingHom
            (MvPolynomial.aeval z g) := aeval_map _ _ _
      _ = 0 := (F1 _).trans (hm g hg)
  · intro Λ0 hΛ0 k'
    have F4 : ∀ w : TensorProduct A (D.obj i₁) C,
        Λ0 (Algebra.TensorProduct.map (τA m) (AlgHom.id A C) w) =
          LinearMap.rTensor C (ιL i₁) w := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul x c =>
        rw [Algebra.TensorProduct.map_tmul, LinearMap.rTensor_tmul]
        exact (hΛ0 _ _).trans (congrArg (fun y => TensorProduct.tmul A y c)
          (RingHom.congr_fun (hιD m) x))
      | add a b ha hb =>
        rw [map_add, map_add, ha, hb, map_add]
    exact (F4 _).trans (hz k')

theorem wc_etale_stage_tensor_poly_rep : ∀ (A C D0 : Type u) [CommRing A] [CommRing C] [CommRing D0] (p0 : Polynomial A →+* D0) (γ : A →+* C), p0.Etale → letI : Algebra A D0 := (p0.comp (algebraMap A (Polynomial A))).toAlgebra; letI : Algebra A C := γ.toAlgebra; ∀ (κ : Type u) [Fintype κ] (e : κ → TensorProduct A D0 C) (G : Finset (MvPolynomial κ ℤ)), (∀ g ∈ G, MvPolynomial.aeval e g = 0) → ∃ (ι₀ σ₀ : Type) (_ : Fintype ι₀) (_ : Fintype σ₀) (_ : DecidableEq σ₀) (mp : σ₀ → ι₀) (f : σ₀ → MvPolynomial ι₀ (Polynomial A)) (val : ι₀ → D0) (g₀ : MvPolynomial ι₀ (Polynomial A)) (q : κ → MvPolynomial ι₀ (Polynomial C)), Function.Bijective mp ∧ (∀ j, MvPolynomial.eval₂Hom p0 val (f j) = 0) ∧ g₀ * (Matrix.of fun a b => MvPolynomial.pderiv (mp a) (f b)).det - 1 ∈ Ideal.span (Set.range f) ∧ (∀ g ∈ G, MvPolynomial.aeval q g ∈ Ideal.span (Set.range fun j => MvPolynomial.map (Polynomial.mapRingHom γ) (f j))) ∧ ∀ k, MvPolynomial.eval₂Hom (Polynomial.eval₂RingHom (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A D0 C).toRingHom (p0 Polynomial.X ⊗ₜ[A] (1 : C))) (fun i => val i ⊗ₜ[A] (1 : C)) (q k) = e k :=
by
  intro A C D0 _ _ _ p0 γ hp0
  letI : Algebra A D0 := (p0.comp (algebraMap A (Polynomial A))).toAlgebra
  letI : Algebra A C := γ.toAlgebra
  intro κ _ e G he

  obtain ⟨ι₀, σ₀, _, _, _, mp, f, val, hmp, hsurj, hkerA, g₀, hcert⟩ :
      ∃ (ι σ : Type) (_ : Fintype ι) (_ : Fintype σ) (_ : DecidableEq σ) (mp : σ → ι)
        (f : σ → MvPolynomial ι (Polynomial A)) (val : ι → D0), Function.Bijective mp ∧
        Function.Surjective (MvPolynomial.eval₂Hom p0 val) ∧
        RingHom.ker (MvPolynomial.eval₂Hom p0 val) = Ideal.span (Set.range f) ∧
        ∃ g : MvPolynomial ι (Polynomial A),
          g * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j)).det - 1 ∈
            Ideal.span (Set.range f) := by
    letI : Algebra (Polynomial A) D0 := p0.toAlgebra
    have hE : Algebra.Etale (Polynomial A) D0 := hp0
    haveI : Algebra.IsStandardSmoothOfRelativeDimension 0 (Polynomial A) D0 :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp hE
    obtain ⟨ι, σ, hσ, hι, P, hdim⟩ :=
      Algebra.IsStandardSmoothOfRelativeDimension.out (n := 0) (R := Polynomial A) (S := D0)
    have hdim' : Nat.card ι - Nat.card σ = 0 := hdim
    have hle : Nat.card ι ≤ Nat.card σ := Nat.sub_eq_zero_iff_le.mp hdim'
    letI : Fintype ι := Fintype.ofFinite ι
    letI : Fintype σ := Fintype.ofFinite σ
    letI : DecidableEq σ := Classical.decEq σ
    have hev : ∀ Q, MvPolynomial.aeval (R := Polynomial A) P.val Q =
        MvPolynomial.eval₂Hom p0 P.val Q := fun Q => rfl
    have hker : RingHom.ker (MvPolynomial.eval₂Hom p0 P.val) =
        Ideal.span (Set.range P.relation) := by
      rw [P.span_range_relation_eq_ker.trans P.ker_eq_ker_aeval_val]
      ext Q
      rw [RingHom.mem_ker, RingHom.mem_ker, hev]
    refine ⟨ι, σ, inferInstance, inferInstance, inferInstance, P.map, P.relation, P.val,
      P.map_inj.bijective_of_nat_card_le hle,
      fun s => ⟨P.σ' s, (hev _).symm.trans (P.aeval_val_σ' s)⟩, hker, ?_⟩
    have hM : (Matrix.of fun i j => MvPolynomial.pderiv (P.map i) (P.relation j)) =
        P.jacobiMatrix := by
      ext i j
      rw [Matrix.of_apply, P.jacobiMatrix_apply]
    have hJ : P.jacobian = MvPolynomial.aeval P.val
        (Matrix.of fun i j => MvPolynomial.pderiv (P.map i) (P.relation j)).det := by
      rw [P.jacobian_eq_jacobiMatrix_det, hM, Algebra.Generators.algebraMap_apply]
    have hu : IsUnit P.jacobian := P.jacobian_isUnit
    rw [hJ] at hu
    obtain ⟨y, hy⟩ := hu.exists_left_inv
    refine ⟨P.σ' y, ?_⟩
    rw [← hker, RingHom.mem_ker, ← hev, map_sub, map_mul, map_one, P.aeval_val_σ', hy, sub_self]

  let Φ : MvPolynomial ι₀ (Polynomial C) →+* TensorProduct A D0 C :=
    MvPolynomial.eval₂Hom (Polynomial.eval₂RingHom
      (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A D0 C).toRingHom
      (p0 Polynomial.X ⊗ₜ[A] (1 : C))) (fun i => val i ⊗ₜ[A] (1 : C))
  have hΦC : ∀ c : C, Φ (MvPolynomial.C (Polynomial.C c)) = (1 : D0) ⊗ₜ[A] c := by
    intro c
    show MvPolynomial.eval₂Hom _ _ _ = _
    rw [MvPolynomial.eval₂Hom_C, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
    rfl
  have hΦX : Φ (MvPolynomial.C Polynomial.X) = p0 Polynomial.X ⊗ₜ[A] (1 : C) := by
    show MvPolynomial.eval₂Hom _ _ _ = _
    rw [MvPolynomial.eval₂Hom_C, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
  have hΦv : ∀ i, Φ (MvPolynomial.X i) = val i ⊗ₜ[A] (1 : C) := by
    intro i
    show MvPolynomial.eval₂Hom _ _ _ = _
    rw [MvPolynomial.eval₂Hom_X']

  have himg : ∀ P : MvPolynomial ι₀ (Polynomial A),
      Φ (MvPolynomial.map (Polynomial.mapRingHom γ) P) =
        MvPolynomial.eval₂Hom p0 val P ⊗ₜ[A] (1 : C) := by
    have h : Φ.comp (MvPolynomial.map (Polynomial.mapRingHom γ)) =
        (Algebra.TensorProduct.includeLeftRingHom).comp (MvPolynomial.eval₂Hom p0 val) := by
      apply MvPolynomial.ringHom_ext
      · intro a
        have h2 : (Φ.comp (MvPolynomial.map (Polynomial.mapRingHom γ))).comp MvPolynomial.C =
            ((Algebra.TensorProduct.includeLeftRingHom).comp
              (MvPolynomial.eval₂Hom p0 val)).comp MvPolynomial.C := by
          apply Polynomial.ringHom_ext
          · intro a'
            simp only [RingHom.comp_apply, MvPolynomial.map_C, Polynomial.coe_mapRingHom,
              Polynomial.map_C, MvPolynomial.eval₂Hom_C,
              Algebra.TensorProduct.includeLeftRingHom_apply]
            rw [hΦC]
            have h3 := (Algebra.TensorProduct.tmul_one_eq_one_tmul (R := A) (A := D0) (B := C) a')
            rw [Polynomial.C_eq_algebraMap]
            exact h3.symm
          · simp only [RingHom.comp_apply, MvPolynomial.map_C, Polynomial.coe_mapRingHom,
              Polynomial.map_X, MvPolynomial.eval₂Hom_C,
              Algebra.TensorProduct.includeLeftRingHom_apply]
            exact hΦX
        exact RingHom.congr_fun h2 a
      · intro i
        simp only [RingHom.comp_apply, MvPolynomial.map_X, MvPolynomial.eval₂Hom_X',
          Algebra.TensorProduct.includeLeftRingHom_apply]
        exact hΦv i
    intro P
    exact RingHom.congr_fun h P

  have hsurjΦ : Function.Surjective Φ := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => exact ⟨0, map_zero Φ⟩
    | tmul x c =>
      obtain ⟨P, hP⟩ := hsurj x
      refine ⟨MvPolynomial.map (Polynomial.mapRingHom γ) P * MvPolynomial.C (Polynomial.C c), ?_⟩
      rw [map_mul, himg, hΦC, hP, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    | add x y hx hy =>
      obtain ⟨a, ha⟩ := hx
      obtain ⟨b, hb⟩ := hy
      exact ⟨a + b, by rw [map_add, ha, hb]⟩

  have hker' : ∀ z, Φ z = 0 →
      z ∈ Ideal.span (Set.range fun j => MvPolynomial.map (Polynomial.mapRingHom γ) (f j)) := by
    intro z hz
    let J : Ideal (MvPolynomial ι₀ (Polynomial C)) :=
      Ideal.span (Set.range fun j => MvPolynomial.map (Polynomial.mapRingHom γ) (f j))
    let mC : MvPolynomial ι₀ (Polynomial A) →+* MvPolynomial ι₀ (Polynomial C) :=
      MvPolynomial.map (Polynomial.mapRingHom γ)
    let π : MvPolynomial ι₀ (Polynomial C) →+* (MvPolynomial ι₀ (Polynomial C) ⧸ J) :=
      Ideal.Quotient.mk J
    have hle : RingHom.ker (MvPolynomial.eval₂Hom p0 val) ≤ RingHom.ker (π.comp mC) := by
      rw [hkerA, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span ⟨j, rfl⟩
    let θ₁ : D0 →+* (MvPolynomial ι₀ (Polynomial C) ⧸ J) :=
      RingHom.liftOfSurjective (MvPolynomial.eval₂Hom p0 val) hsurj ⟨π.comp mC, hle⟩
    have hθ₁ : ∀ P, θ₁ (MvPolynomial.eval₂Hom p0 val P) = π (mC P) := fun P =>
      RingHom.liftOfSurjective_comp_apply _ hsurj ⟨π.comp mC, hle⟩ P
    let θ₂ : C →+* (MvPolynomial ι₀ (Polynomial C) ⧸ J) :=
      π.comp (MvPolynomial.C.comp Polynomial.C)
    have hQalg : ∀ a : A, algebraMap A (MvPolynomial ι₀ (Polynomial C) ⧸ J) a = θ₂ (γ a) := by
      intro a
      first
        | rfl
        | simp [θ₂, π, Ideal.Quotient.algebraMap_eq, MvPolynomial.algebraMap_eq,
            Polynomial.algebraMap_apply, RingHom.algebraMap_toAlgebra]
    let θ₂A : C →ₐ[A] (MvPolynomial ι₀ (Polynomial C) ⧸ J) :=
      { θ₂ with commutes' := fun a => (hQalg a).symm }
    let θ₁A : D0 →ₐ[A] (MvPolynomial ι₀ (Polynomial C) ⧸ J) :=
      { θ₁ with
        commutes' := fun a => by
          rw [hQalg]
          show θ₁ (p0 (algebraMap A (Polynomial A) a)) = θ₂ (γ a)
          have h1 : p0 (algebraMap A (Polynomial A) a) =
              MvPolynomial.eval₂Hom p0 val (MvPolynomial.C (Polynomial.C a)) := by
            rw [MvPolynomial.eval₂Hom_C, Polynomial.C_eq_algebraMap]
          rw [h1, hθ₁]
          show π (MvPolynomial.map (Polynomial.mapRingHom γ) (MvPolynomial.C (Polynomial.C a))) =
            π (MvPolynomial.C (Polynomial.C (γ a)))
          rw [MvPolynomial.map_C, Polynomial.coe_mapRingHom, Polynomial.map_C] }
    let Θ := Algebra.TensorProduct.lift θ₁A θ₂A (fun x y => (mul_comm (θ₁A x) (θ₂A y) : _))
    have hΘt : ∀ (x : D0) (c : C), Θ (x ⊗ₜ[A] c) = θ₁ x * θ₂ c := fun x c =>
      Algebra.TensorProduct.lift_tmul _ _ _ x c
    have hΘ : (Θ : TensorProduct A D0 C →+* (MvPolynomial ι₀ (Polynomial C) ⧸ J)).comp Φ = π := by
      apply MvPolynomial.ringHom_ext
      · intro a
        have h2 : ((Θ : TensorProduct A D0 C →+* (MvPolynomial ι₀ (Polynomial C) ⧸ J)).comp
            Φ).comp MvPolynomial.C = π.comp MvPolynomial.C := by
          apply Polynomial.ringHom_ext
          · intro c
            simp only [RingHom.comp_apply, RingHom.coe_coe]
            rw [hΦC, hΘt]
            rw [map_one, one_mul]
            rfl
          · simp only [RingHom.comp_apply, RingHom.coe_coe]
            rw [hΦX, hΘt]
            rw [map_one, mul_one]
            have h1 : p0 Polynomial.X =
                MvPolynomial.eval₂Hom p0 val (MvPolynomial.C Polynomial.X) :=
              (MvPolynomial.eval₂Hom_C _ _ _).symm
            rw [h1, hθ₁]
            show π (MvPolynomial.map (Polynomial.mapRingHom γ) (MvPolynomial.C Polynomial.X)) = _
            rw [MvPolynomial.map_C, Polynomial.coe_mapRingHom, Polynomial.map_X]
        exact RingHom.congr_fun h2 a
      · intro i
        simp only [RingHom.comp_apply, RingHom.coe_coe]
        rw [hΦv, hΘt]
        rw [map_one, mul_one]
        have h1 : val i = MvPolynomial.eval₂Hom p0 val (MvPolynomial.X i) :=
          (MvPolynomial.eval₂Hom_X' _ _ _).symm
        rw [h1, hθ₁]
        show π (MvPolynomial.map (Polynomial.mapRingHom γ) (MvPolynomial.X i)) = _
        rw [MvPolynomial.map_X]
    have hπz : π z = 0 := by
      rw [← hΘ, RingHom.comp_apply, hz, map_zero]
    exact Ideal.Quotient.eq_zero_iff_mem.mp hπz

  choose q hq using fun k => hsurjΦ (e k)
  have hfval : ∀ j, MvPolynomial.eval₂Hom p0 val (f j) = 0 := fun j => by
    rw [← RingHom.mem_ker, hkerA]
    exact Ideal.subset_span ⟨j, rfl⟩
  have aeval_map : ∀ (g : MvPolynomial κ ℤ),
      MvPolynomial.aeval (fun k => Φ (q k)) g = Φ (MvPolynomial.aeval q g) := by
    intro g
