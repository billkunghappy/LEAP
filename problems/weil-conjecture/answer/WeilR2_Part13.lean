        obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
        rw [map_mul, hq₁y, mul_zero])
    have hq₂ : Function.Surjective q₂ := Ideal.Quotient.lift_surjective_of_surjective _ _ hq₁
    have hle := ringKrullDim_le_of_surjective q₂ hq₂
    have e1 : ((M - 1 : ℕ) : WithBot ℕ∞) + 1 + 1 ≤ ringKrullDim R := by
      rw [← hSdim, Nat.cast_one]
      exact add_le_add ((add_le_add (hDdim.trans hle) le_rfl).trans hdimS) le_rfl
    rw [hR] at e1
    have e2 : ((M - 1 + 1 + 1 : ℕ) : WithBot ℕ∞) ≤ ((M : ℕ) : WithBot ℕ∞) := by
      exact_mod_cast e1
    have e3 : M - 1 + 1 + 1 ≤ M := by exact_mod_cast e2
    omega
  refine ⟨x₀, ?_, hmO_eq⟩
  rw [← hI₀eq]
  exact le_antisymm hkerle hI₀le

theorem wc_ldnm_transversal (F' : Type u) [Field F'] (E : Type u) [Field E] [Finite E]
    [Algebra F' E] (Y : Over (Spec (.of F'))) (n N : ℕ) (hn2 : 2 ≤ n)
    (P : wcPreDatum F' E Y n) (X : Over (Spec (.of E))) [IsProper X.hom]
    [GeometricallyIrreducible X.hom] [SmoothOfRelativeDimension n X.hom]
    (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr E N = X.hom)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
    (y : Fin P.m → (Spec (.of E) ⟶ X.left)) (c : Fin P.m → Fin 2 → E)
    (hP : wcLdpGoodPencil E N n X ι G₀ G₁ P.m y c)
    (g : P.Yt.left ⟶ Limits.pullback X.hom (wcProjKStr E 1))
    (hY : wcLdnmLocEq (Limits.pullback X.hom (wcProjKStr E 1)) (Fin (N + 1) × Fin 2)
      (wcLdpW E N X ι) (wcLdpH E N X ι G₀ G₁) P.Yt.left g)
    (hg : g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom = P.Yt.hom)
    (hPf : P.f = g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1))
    (hxs : ∀ i, P.xs i ≫ g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) = y i)
    (v₀ v₁ : Fin (N + 1) × Fin (N + 1) → E)
    (hv₀ : G₀ = wcLdpQuad E N (fun p q => v₀ (p, q)))
    (hv₁ : G₁ = wcLdpQuad E N (fun p q => v₁ (p, q)))
    (Z : Scheme.{u}) (k : Z ⟶ Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
    (hZ : wcLdnmLocEq (Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
      (Fin (N + 1) × Fin (wcLdnmM N + 1)) (wcLdnmU E N X ι) (wcLdnmPhi E N X ι) Z k)
    (lam : (wcP1Over E).left ⟶ wcProjK E (wcLdnmM N)) (hlam : IsClosedImmersion lam)
    (hlamS : lam ≫ wcProjKStr E (wcLdnmM N) = (wcP1Over E).hom)
    (hrule : wcLdnmPencilRule E N v₀ v₁ lam)
    (p : P.Yt.left ⟶ Z)
    (hp : IsPullback p P.f (k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) lam) :
    ∀ i : Fin P.m, ∃ (U : (wcProjK E (wcLdnmM N)).Opens)
      (hU : lam (P.S i (IsLocalRing.closedPoint E)) ∈ U) (φ : Γ(wcProjK E (wcLdnmM N), U)),
      (∀ (x : wcProjK E (wcLdnmM N)) (hx : x ∈ U),
        x ∈ (k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) ''
            wcLdnmNS (k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) ↔
          ((wcProjK E (wcLdnmM N)).presheaf.germ U x hx).hom φ ∈
            IsLocalRing.maximalIdeal ((wcProjK E (wcLdnmM N)).presheaf.stalk x)) ∧
      IsLocalRing.maximalIdeal
          ((wcP1Over E).left.presheaf.stalk (P.S i (IsLocalRing.closedPoint E))) =
        Ideal.span {(lam.stalkMap (P.S i (IsLocalRing.closedPoint E))).hom
          (((wcProjK E (wcLdnmM N)).presheaf.germ U _ hU).hom φ)} :=
by
  classical
  intro i

  set h : Z ⟶ wcProjK E (wcLdnmM N) :=
    k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)) with hhdef
  set s := P.S i (IsLocalRing.closedPoint E) with hsdef
  set ξ := P.xs i (IsLocalRing.closedPoint E) with hξdef

  have e' : h (p ξ) = lam s := by
    have h2 : P.f ξ = s := by
      have := Scheme.Hom.comp_apply (P.xs i) P.f (IsLocalRing.closedPoint E)
      rw [P.hxs i] at this
      exact this.symm
    calc h (p ξ) = (p ≫ h) ξ := (Scheme.Hom.comp_apply p h ξ).symm
      _ = (P.f ≫ lam) ξ := by rw [hp.w]
      _ = lam (P.f ξ) := Scheme.Hom.comp_apply _ _ _
      _ = lam s := by rw [h2]

  haveI := hZ.1
  haveI := hlam
  haveI hhp : IsProper h := by
    show IsProper (k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)))
    infer_instance
  have hloc : ∀ {Z' Y' : Scheme.{u}} (h' : Z' ⟶ Y') (z' : Z') (y' : Y') (e : h' z' = y'),
      IsLocalHom (wcLdnmTvRho h' z' y' e) := by
    intro Z' Y' h' z' y' e
    subst e
    unfold wcLdnmTvRho
    rw [TopCat.Presheaf.stalkSpecializes_refl]
    simpa using (inferInstance : IsLocalHom (h'.stalkMap z').hom)
  haveI := hloc h (p ξ) (lam s) e'
  have hNSclosed : IsClosed (wcLdnmNS h) := by
    have : (wcLdnmNS h)ᶜ = ⋃ (U : Z.Opens) (_ : Smooth (U.ι ≫ h)), (U : Set Z) := by
      ext x
      simp only [wcLdnmNS, Set.mem_compl_iff, Set.mem_setOf_eq, not_not, Set.mem_iUnion,
        SetLike.mem_coe, exists_prop]
      constructor
      · rintro ⟨U, hx, hU⟩; exact ⟨U, hU, hx⟩
      · rintro ⟨U, hU, hx⟩; exact ⟨U, hx, hU⟩
    rw [← isOpen_compl_iff, this]
    exact isOpen_iUnion fun U => isOpen_iUnion fun _ => U.isOpen

  obtain ⟨hz, hfib⟩ := wc_ldnm_tv_fibre F' E Y n N hn2 P X ι hι hιX G₀ G₁ y c hP g hY hg hPf hxs
    v₀ v₁ hv₀ hv₁ Z k hZ lam hlam hlamS hrule p hp i
  obtain ⟨a, ha, W, hWa, hzW, ψ, hψ, e₀, hgerm⟩ :=
    wc_ldnm_tv_ns_local_eqns F' E Y n N hn2 P X ι hι hιX G₀ G₁ y c hP g hY hg hPf hxs
      v₀ v₁ hv₀ hv₁ Z k hZ lam hlam hlamS hrule p hp i
  have hJ := wc_ldnm_tv_jacobian_relation F' E Y n N hn2 P X ι hι hιX G₀ G₁ y c hP g hY hg hPf
    hxs v₀ v₁ hv₀ hv₁ Z k hZ lam hlam hlamS hrule p hp i a ha e' e₀
  obtain ⟨hRreg, hRdim, hAreg, hAdim, hOreg, hOdim, hres⟩ :=
    wc_ldnm_tv_regular F' E Y n N hn2 P X ι hι hιX G₀ G₁ y c hP g hY hg hPf hxs
      v₀ v₁ hv₀ hv₁ Z k hZ lam hlam hlamS hrule p hp i e'

  have hfun : (fun j => (Z.presheaf.germ W (p ξ) hzW).hom (ψ j)) = _ := funext hgerm
  rw [← hfun] at hJ

  have hK : RingHom.ker (lam.stalkMap s).hom ≤
      IsLocalRing.maximalIdeal ((wcProjK E (wcLdnmM N)).presheaf.stalk (lam s)) := by
    intro x hx
    rw [RingHom.mem_ker] at hx
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have := hu.map (lam.stalkMap s).hom
    rw [hx] at this
    exact not_isUnit_zero this
  have hm' : IsLocalRing.maximalIdeal (Z.presheaf.stalk (p ξ)) ≤
      Ideal.span (Set.range fun j => (Z.presheaf.germ W (p ξ) hzW).hom (ψ j)) ⊔
        Ideal.map (wcLdnmTvRho h (p ξ) (lam s) e')
          (IsLocalRing.maximalIdeal ((wcProjK E (wcLdnmM N)).presheaf.stalk (lam s))) :=
    hJ.trans (sup_le_sup_left (Ideal.map_mono hK) _)
  have hψm : ∀ j, (Z.presheaf.germ W (p ξ) hzW).hom (ψ j) ∈
      IsLocalRing.maximalIdeal (Z.presheaf.stalk (p ξ)) := (hψ (p ξ) hzW).mp hz
  obtain ⟨hsurj, hspread⟩ := wc_ldnm_tv_spread E (wcLdnmM N) h (wcLdnmNS h) hNSclosed (p ξ) hz
    (lam s) e' hfib W hWa hzW n ψ hψ hm' hres
  haveI := hRreg
  haveI := hAreg
  haveI := hOreg
  have hlamsurj : Function.Surjective (lam.stalkMap s).hom :=
    SurjectiveOnStalks.stalkMap_surjective lam s
  obtain ⟨x₀, hker, hO⟩ := wc_ldnm_tv_principal
    ((wcProjK E (wcLdnmM N)).presheaf.stalk (lam s)) (Z.presheaf.stalk (p ξ))
    ((wcP1Over E).left.presheaf.stalk s) (wcLdnmTvRho h (p ξ) (lam s) e')
    (lam.stalkMap s).hom hlamsurj (wcLdnmM N) n hRdim hAdim hOdim
    (fun j => (Z.presheaf.germ W (p ξ) hzW).hom (ψ j)) hψm hJ hsurj
  obtain ⟨U, hU, φ, hG1, hG2⟩ := hspread x₀ hker
  refine ⟨U, hU, φ, hG1, ?_⟩
  rw [hO]
  have := congrArg (Ideal.map (lam.stalkMap s).hom) hG2
  rw [Ideal.map_span, Ideal.map_span, Set.image_singleton, Set.image_singleton] at this
  exact this.symm

theorem wc_ldnm_predatum_family (F' : Type u) [Finite F'] [Field F']
    (Y : Over (Spec (.of F'))) [GeometricallyIrreducible Y.hom] [IsProper Y.hom] (n : ℕ)
    [SmoothOfRelativeDimension n Y.hom] (hn : Even n) (hn2 : 2 ≤ n)
    (N : ℕ) (j : Y.left ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
      MvPolynomial.gradedAlgebra)
    (hj : IsClosedImmersion j)
    (hjY : j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))) = Y.hom) :
    ∃ (F₁ : Type u) (_ : Field F₁) (_ : Finite F₁) (_ : Algebra F' F₁)
      (P : wcPreDatum F' F₁ Y n), wcFamWit F₁ P.Yt.left P.f P.m P.S :=
by
  classical
  obtain ⟨E, _, _, _, P, X, hXp, hXgi, hXs, ι, G₀, G₁, y, c, g,
      hι, hιX, hP, hY, hg, hPf, hxs⟩ :=
    wc_ldnm_glue_ctx F' Y n hn hn2 N j hj hjY
  haveI := hXp
  haveI := hXgi
  haveI := hXs
  have hN : 1 ≤ N := wc_ldnm_N_pos E N n X (by omega) ι hι
  obtain ⟨v₀, v₁, hv₀, hv₁, hind⟩ :=
    wc_ldnm_pencil_coeffs E N n hn2 X ι hι hιX G₀ G₁ P.m y c hP

  obtain ⟨hUaff, hUcov, hUu⟩ := wc_ldnm_univ_chart_data E N X ι hι
  obtain ⟨Z, k, hk1, hk2, hk3, hk4⟩ :=
    wc_ldpi_principal_subscheme (Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
      (Fin (N + 1) × Fin (wcLdnmM N + 1)) (wcLdnmU E N X ι) hUaff hUcov (wcLdnmPhi E N X ι) hUu
  have hZ : wcLdnmLocEq (Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
      (Fin (N + 1) × Fin (wcLdnmM N + 1)) (wcLdnmU E N X ι) (wcLdnmPhi E N X ι) Z k :=
    ⟨hk1, hk2, hk3, hk4⟩
  haveI := hk1
  haveI : IsProper (wcProjKStr E (wcLdnmM N)) := wc_pp_proper E (wcLdnmM N)
  have hsm := wc_ldnm_univ_smooth E N n X ι hι hιX Z k hZ
  let Xu : Over (Spec (.of E)) :=
    Over.mk (k ≫ Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)) ≫ X.hom)
  let h : Xu.left ⟶ wcProjK E (wcLdnmM N) :=
    k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))
  haveI hhp : IsProper h := by
    show IsProper (k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)))
    infer_instance
  have hhS : h ≫ wcProjKStr E (wcLdnmM N) = Xu.hom := by
    show (k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) ≫ wcProjKStr E (wcLdnmM N) =
      k ≫ Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)) ≫ X.hom
    rw [Category.assoc, ← Limits.pullback.condition]

  obtain ⟨lam, hlam, hlamS, hL, hrule⟩ := wc_ldnm_pencil_line E N hN v₀ v₁ hind

  have w₀ : Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom =
      (Limits.pullback.snd X.hom (wcProjKStr E 1) ≫ lam) ≫ wcProjKStr E (wcLdnmM N) := by
    rw [Category.assoc, hlamS]
    exact Limits.pullback.condition
  let Λ : Limits.pullback X.hom (wcProjKStr E 1) ⟶
      Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)) :=
    Limits.pullback.lift (Limits.pullback.fst X.hom (wcProjKStr E 1))
      (Limits.pullback.snd X.hom (wcProjKStr E 1) ≫ lam) w₀
  have hΛ1 : Λ ≫ Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)) =
      Limits.pullback.fst X.hom (wcProjKStr E 1) := Limits.pullback.lift_fst _ _ _
  have hΛ2 : Λ ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)) =
      Limits.pullback.snd X.hom (wcProjKStr E 1) ≫ lam := Limits.pullback.lift_snd _ _ _
  have hΛpb : IsPullback Λ (Limits.pullback.snd X.hom (wcProjKStr E 1))
      (Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) lam := by
    have hout : IsPullback (Λ ≫ Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)))
        (Limits.pullback.snd X.hom (wcProjKStr E 1)) X.hom
        (lam ≫ wcProjKStr E (wcLdnmM N)) := by
      rw [hΛ1, hlamS]
      exact IsPullback.of_hasPullback X.hom (wcProjKStr E 1)
    exact IsPullback.of_right hout hΛ2 (IsPullback.of_hasPullback X.hom (wcProjKStr E (wcLdnmM N)))

  obtain ⟨_, hWcov, _⟩ := wc_ldpi_chart_data E N X ι hι G₀ G₁
  have hassoc := wc_ldnm_sq_local_assoc E N X ι hι hιX G₀ G₁ v₀ v₁ hv₀ hv₁ hind lam hrule Λ
    hΛ1 hΛ2
  obtain ⟨p, hp0⟩ := wc_ldnm_sq_closed_compare Λ (wcLdpW E N X ι) (wcLdpH E N X ι G₀ G₁)
    (wcLdnmU E N X ι) (wcLdnmPhi E N X ι) hWcov hUcov P.Yt.left Z g k hY hZ hassoc
  have hp : IsPullback p (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1))
      (k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) lam :=
    hp0.paste_vert hΛpb
  rw [← hPf] at hp

  have hNSclosed : IsClosed (wcLdnmNS h) := by
    have : (wcLdnmNS h)ᶜ = ⋃ (U : Xu.left.Opens) (_ : Smooth (U.ι ≫ h)), (U : Set Xu.left) := by
      ext x
      simp only [wcLdnmNS, Set.mem_compl_iff, Set.mem_setOf_eq, not_not, Set.mem_iUnion,
        SetLike.mem_coe, exists_prop]
      constructor
      · rintro ⟨U, hx, hU⟩; exact ⟨U, hU, hx⟩
      · rintro ⟨U, hU, hx⟩; exact ⟨U, hx, hU⟩
    rw [← isOpen_compl_iff, this]
    exact isOpen_iUnion fun U => isOpen_iUnion fun _ => U.isOpen
  refine ⟨E, inferInstance, inferInstance, inferInstance, P, wcLdnmM N, Xu,
    n + wcLdnmM N - 1, hsm, h, hhp, hhS, h '' wcLdnmNS h, lam, p, ?_, ?_, ?_, ?_, hlam, hlamS,
    hL, hp, ?_, ?_⟩
  · have h1 : 2 * 2 ≤ (N + 1) * (N + 1) := Nat.mul_le_mul (by omega) (by omega)
    show 2 ≤ (N + 1) * (N + 1) - 1
    omega
  · exact (Scheme.Hom.isClosedMap h) _ hNSclosed
  · exact wc_ldnm_disc_irreducible E N n hn2 X ι hι hιX Z k hZ
  · intro x hx
    by_contra hne
    exact hx ⟨x, hne, rfl⟩
  · exact wc_ldnm_line_meets_disc F' E Y n N hn2 P X ι hι hιX G₀ G₁ y c hP g hY hg hPf hxs
      v₀ v₁ hv₀ hv₁ Z k hZ lam hlam hlamS hrule p hp
  · exact wc_ldnm_transversal F' E Y n N hn2 P X ι hι hιX G₀ G₁ y c hP g hY hg hPf hxs
      v₀ v₁ hv₀ hv₁ Z k hZ lam hlam hlamS hrule p hp

theorem wc_ldc_avoiding_point (K : Type u) [Field K] [Finite K] (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left)) (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) :
    ∃ (L₁ : Type u) (_ : Field L₁) (_ : Finite L₁) (_ : Algebra K L₁)
      (v : Spec (.of L₁) ⟶ (wcP1Over K).left),
      v ≫ (wcP1Over K).hom = Spec.map (CommRingCat.ofHom (algebraMap K L₁)) ∧
      ∀ i, v (IsLocalRing.closedPoint L₁) ≠ S i (IsLocalRing.closedPoint K) :=
by
  classical

  obtain ⟨L₁, _, _, _, a, ha⟩ : ∃ (L₁ : Type u) (_ : Field L₁) (_ : Finite L₁) (_ : Algebra K L₁)
      (a : L₁), ∀ c : K, algebraMap K L₁ c ≠ a := by
    haveI : Fact (Nat.Prime (ringChar K)) := ⟨CharP.char_is_prime K (ringChar K)⟩
    refine ⟨ULift.{u} (FiniteField.Extension K (ringChar K) 2), inferInstance, inferInstance,
      inferInstance, ?_⟩
    haveI : Module.Finite K (ULift.{u} (FiniteField.Extension K (ringChar K) 2)) :=
      Module.Finite.equiv (ULift.moduleEquiv (R := K)).symm
    have hrank : Module.finrank K (ULift.{u} (FiniteField.Extension K (ringChar K) 2)) = 2 := by
      rw [LinearEquiv.finrank_eq (ULift.moduleEquiv (R := K))]
      exact FiniteField.finrank_extension K (ringChar K) 2
    have hcard : Nat.card (ULift.{u} (FiniteField.Extension K (ringChar K) 2)) =
        Nat.card K ^ 2 := by
      rw [Module.natCard_eq_pow_finrank (K := K), hrank]
    by_contra hcon
    push_neg at hcon
    have hsurj : Function.Surjective
        (algebraMap K (ULift.{u} (FiniteField.Extension K (ringChar K) 2))) := hcon
    have h1 := Nat.card_le_card_of_surjective _ hsurj
    have hq : 1 < Nat.card K := Finite.one_lt_card
    rw [hcard] at h1
    nlinarith

  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
    MvPolynomial.gradedAlgebra
  have hX0 : (MvPolynomial.X 0 : MvPolynomial (Fin (1 + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K 0)
  have hX1 : (MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K (1 • 1) := by
    rw [smul_eq_mul, mul_one]
    exact (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K 1)
  obtain ⟨U, hUdef⟩ : ∃ U : Spec (CommRingCat.of (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0))) ⟶
        (wcP1Over K).left,
      U = Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0)
        hX0 one_pos := ⟨_, rfl⟩
  haveI hUoi : IsOpenImmersion U := by rw [hUdef]; infer_instance
  have hUz : U ≫ (wcP1Over K).hom = Spec.map (CommRingCat.ofHom
      (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)) ≫
      CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (Submonoid.powers (MvPolynomial.X 0)))) := by
    rw [hUdef, Spec.map_comp]
    show _ ≫ (Proj.toSpecZero _ ≫ _) = _
    rw [← Category.assoc, Proj.awayι_toSpecZero]
  have hstruct : ∀ (R : CommRingCat.{u}) (ψ : CommRingCat.of (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0)) ⟶ R),
      (Spec.map ψ ≫ U) ≫ (wcP1Over K).hom = Spec.map (CommRingCat.ofHom
        (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)) ≫
        CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
          (Submonoid.powers (MvPolynomial.X 0))) ≫ ψ) := by
    intro R ψ
    rw [Category.assoc, hUz, ← Spec.map_comp, Category.assoc]

  obtain ⟨g, hg0, hg1, hgC⟩ : ∃ g : MvPolynomial (Fin (1 + 1)) K →+* L₁,
      g (MvPolynomial.X 0) = 1 ∧ g (MvPolynomial.X 1) = a ∧
        ∀ c, g (MvPolynomial.C c) = algebraMap K L₁ c :=
    ⟨MvPolynomial.eval₂Hom (algebraMap K L₁) (fun i => if i = 0 then 1 else a),
      by rw [MvPolynomial.eval₂Hom_X', if_pos rfl],
      by rw [MvPolynomial.eval₂Hom_X', if_neg (by decide)],
      fun c => MvPolynomial.eval₂Hom_C _ _ c⟩
  have hu : IsUnit (g (MvPolynomial.X 0)) := by rw [hg0]; exact isUnit_one
  obtain ⟨φ, hφ⟩ : ∃ φ : HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0) →+* L₁,
      ∀ y, φ y = Localization.awayLift g (MvPolynomial.X 0) hu y.val :=
    ⟨(Localization.awayLift g (MvPolynomial.X 0) hu).comp
      (algebraMap _ (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (1 + 1)) K))),
      fun y => by rw [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]⟩
  obtain ⟨t, ht⟩ : ∃ t, t = HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) hX0 1 (MvPolynomial.X 1) hX1 :=
    ⟨_, rfl⟩
  have hφt : φ t = a := by
    rw [ht, hφ, HomogeneousLocalization.Away.val_mk,
      Localization.awayLift_mk g _ _ 1 (by rw [hg0, mul_one]) 1, hg1, one_pow, mul_one]
  have hE1 : ∀ c : K, φ (HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (Submonoid.powers (MvPolynomial.X 0))
      (algebraMap K _ c)) = algebraMap K L₁ c := by
    intro c
    rw [hφ]
    have hval : (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (Submonoid.powers (MvPolynomial.X 0))
        (algebraMap K _ c)).val =
        Localization.mk (MvPolynomial.C c)
          (⟨MvPolynomial.X 0 ^ 0, pow_mem (Submonoid.mem_powers _) 0⟩ :
            Submonoid.powers (MvPolynomial.X 0 : MvPolynomial (Fin (1 + 1)) K)) := by
      show (HomogeneousLocalization.mk _).val = _
      rw [HomogeneousLocalization.val_mk]
      congr 1
    rw [hval, Localization.awayLift_mk g _ _ 1 (by rw [hg0, mul_one]) 0, pow_zero, mul_one, hgC]
  refine ⟨L₁, inferInstance, inferInstance, inferInstance,
    Spec.map (CommRingCat.ofHom φ) ≫ U, ?_, ?_⟩
  · rw [hstruct]
    exact congrArg Spec.map (CommRingCat.hom_ext (RingHom.ext fun c => hE1 c))
  · intro i heq
    have hrange : Set.range (S i) ⊆ Set.range U := by
      rintro _ ⟨y, rfl⟩
      rw [Subsingleton.elim y (IsLocalRing.closedPoint K), ← heq]
      exact ⟨_, (Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom φ)) U _).symm⟩
    obtain ⟨χ, hχ⟩ : ∃ χ, χ = Spec.preimage (IsOpenImmersion.lift U (S i) hrange) := ⟨_, rfl⟩
    have hsχ : Spec.map χ ≫ U = S i := by
      rw [hχ, Spec.map_preimage]; exact IsOpenImmersion.lift_fac _ _ _
    have h1 := hstruct _ χ
    rw [hsχ, hS i] at h1
    have h2 : CommRingCat.ofHom
        (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)) ≫
        CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
          (Submonoid.powers (MvPolynomial.X 0))) ≫ χ = 𝟙 (CommRingCat.of K) := by
      apply Spec.map_injective
      rw [Spec.map_id, ← h1]
    have hχε : ∀ c : K, χ.hom (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (Submonoid.powers (MvPolynomial.X 0))
        (algebraMap K _ c)) = c := fun c => by
      have := congrArg (fun f => CommRingCat.Hom.hom f c) h2
      exact this
    have h3 : (Spec.map (CommRingCat.ofHom φ)) (IsLocalRing.closedPoint L₁) =
        (Spec.map χ) (IsLocalRing.closedPoint K) := by
      apply (Scheme.Hom.isOpenEmbedding U).isEmbedding.injective
      have e := heq
      rw [← hsχ] at e
      exact (Scheme.Hom.comp_apply _ _ _).symm.trans (e.trans (Scheme.Hom.comp_apply _ _ _))
    have h4 : Ideal.comap φ (IsLocalRing.maximalIdeal L₁) =
        Ideal.comap χ.hom (IsLocalRing.maximalIdeal K) := by
      have h3' := (Spec.map_apply _ _).symm.trans (h3.trans (Spec.map_apply _ _))
      have := congrArg PrimeSpectrum.asIdeal h3'
      rw [PrimeSpectrum.comap_asIdeal, PrimeSpectrum.comap_asIdeal] at this
      exact this
    have hx : t - HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (Submonoid.powers (MvPolynomial.X 0))
        (algebraMap K _ (χ.hom t)) ∈ Ideal.comap χ.hom (IsLocalRing.maximalIdeal K) := by
      rw [Ideal.mem_comap, map_sub, hχε, sub_self]
      exact Ideal.zero_mem _
    rw [← h4, Ideal.mem_comap, IsLocalRing.maximalIdeal_eq_bot, Ideal.mem_bot, map_sub, hφt, hE1,
      sub_eq_zero] at hx
    exact ha _ hx.symm

theorem wc_ldc_fibre_props (F' K L₁ : Type u) [Field F'] [Field K] [Field L₁] [Algebra F' K]
    [Algebra K L₁] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : 1 ≤ n) (P : wcPreDatum F' K Y n)
    (v : Spec (.of L₁) ⟶ (wcP1Over K).left)
    (hv : v ≫ (wcP1Over K).hom = Spec.map (CommRingCat.ofHom (algebraMap K L₁)))
    (hvS : ∀ i, v (IsLocalRing.closedPoint L₁) ≠ P.S i (IsLocalRing.closedPoint K)) :
    GeometricallyIrreducible (Limits.pullback.snd P.f v) ∧
      IsProper (Limits.pullback.snd P.f v) ∧
      SmoothOfRelativeDimension (n - 1) (Limits.pullback.snd P.f v) :=
by
  classical
  have hB := IsPullback.of_hasPullback P.f v

  have hpt : ∀ x : (Limits.pullback P.f v : Scheme), ∃ U : P.Yt.left.Opens,
      (Limits.pullback.fst P.f v) x ∈ U ∧ Smooth (U.ι ≫ P.f) := by
    intro x
    apply P.smooth_off
    intro i hi
    have h1 : P.f ((Limits.pullback.fst P.f v) x) = (P.S i) (IsLocalRing.closedPoint K) := by
      rw [hi, ← P.hxs i]
      rfl
    have h2 : P.f ((Limits.pullback.fst P.f v) x) = v ((Limits.pullback.snd P.f v) x) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
    have h3 : (Limits.pullback.snd P.f v) x = IsLocalRing.closedPoint L₁ :=
      Subsingleton.elim _ _
    have h4 := h2.symm.trans h1
    rw [h3] at h4
    exact hvS i h4
  choose U hU hUs using hpt

  have hsmd : SmoothOfRelativeDimension (n - 1) (Limits.pullback.snd P.f v) := by
    haveI : IsZariskiLocalAtSource (@SmoothOfRelativeDimension (n - 1)) :=
      HasRingHomProperty.instIsZariskiLocalAtSource
    haveI : IsZariskiLocalAtSource (@SmoothOfRelativeDimension n) :=
      HasRingHomProperty.instIsZariskiLocalAtSource
    have hUd : ∀ x, SmoothOfRelativeDimension (n - 1) ((U x).ι ≫ P.f) := by
      intro x
      haveI := hUs x
      haveI := wc_p1_smooth_reldim_one K
      haveI := P.smooth
      haveI : SmoothOfRelativeDimension n (((U x).ι ≫ P.f) ≫ (wcP1Over K).hom) := by
        rw [Category.assoc, P.hf]
        exact IsZariskiLocalAtSource.comp P.smooth (U x).ι
      exact wc_smooth_reldim_of_comp_reldim ((U x).ι ≫ P.f) (wcP1Over K).hom n 1
    refine IsZariskiLocalAtSource.of_iSup_eq_top
      (fun x => (Limits.pullback.fst P.f v) ⁻¹ᵁ (U x)) ?_ ?_
    · rw [eq_top_iff]
      intro x _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hU x⟩
    · intro x
      have hsq := IsPullback.paste_vert
        (isPullback_morphismRestrict (Limits.pullback.fst P.f v) (U x)) hB
      exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (n - 1)) hsq (hUd x)
  have hsm : Smooth (Limits.pullback.snd P.f v) :=
    SmoothOfRelativeDimension.smooth (n - 1) _
  refine ⟨?_, ?_, hsmd⟩
  ·
    rw [GeometricallyIrreducible.eq_geometrically]
    intro K' _ y Z fst snd h
    haveI : Smooth snd := MorphismProperty.of_isPullback (P := @Smooth) h hsm
    haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian snd
    haveI : ConnectedSpace Z := by
      let yb : Spec (.of (AlgebraicClosure K')) ⟶ Spec (.of K') :=
        Spec.map (CommRingCat.ofHom (algebraMap K' (AlgebraicClosure K')))
      have hZ' := IsPullback.paste_horiz h hB
      haveI := P.fconn (AlgebraicClosure K') (yb ≫ y ≫ v)
      have hQ := IsPullback.of_hasPullback P.f (yb ≫ y ≫ v)
      have w : Limits.pullback.fst P.f (yb ≫ y ≫ v) ≫ P.f =
          (Limits.pullback.snd P.f (yb ≫ y ≫ v) ≫ yb) ≫ (y ≫ v) := by
        rw [Limits.pullback.condition, Category.assoc]
      let c := hZ'.lift _ _ w
      have hc1 : c ≫ (fst ≫ Limits.pullback.fst P.f v) =
          Limits.pullback.fst P.f (yb ≫ y ≫ v) := hZ'.lift_fst _ _ w
      have hc2 : c ≫ snd = Limits.pullback.snd P.f (yb ≫ y ≫ v) ≫ yb := hZ'.lift_snd _ _ w
      have houter : IsPullback (c ≫ (fst ≫ Limits.pullback.fst P.f v))
          (Limits.pullback.snd P.f (yb ≫ y ≫ v)) P.f (yb ≫ (y ≫ v)) := by
        rw [hc1]; exact hQ
      have hc : IsPullback c (Limits.pullback.snd P.f (yb ≫ y ≫ v)) snd yb :=
        IsPullback.of_right houter hc2 hZ'
      haveI : Surjective c := MorphismProperty.of_isPullback (P := @Surjective) hc.flip inferInstance
      exact Function.Surjective.connectedSpace (Surjective.surj (f := c)) c.continuous
    have hdom : ∀ w : Z, IsDomain (Z.presheaf.stalk w) := by
      intro w
      obtain ⟨U, hU, V, hV, hwV, e, hss⟩ := Smooth.exists_isStandardSmooth snd w
      letI := (Scheme.Hom.appLE snd U V e).hom.toAlgebra
      have hss' : Algebra.IsStandardSmooth Γ(Spec (.of K'), U) Γ(Z, V) := hss
      obtain ⟨ι, σ, hσ, hι, ⟨P₀⟩⟩ := hss'.out
      have hrel : RingHom.IsStandardSmoothOfRelativeDimension P₀.dimension
          (Scheme.Hom.appLE snd U V e).hom := ⟨⟨ι, σ, hσ, hι, P₀, rfl⟩⟩
      have himg : V.ι ''ᵁ ⊤ = V := Scheme.Opens.ι_image_top V
      have hsmV : SmoothOfRelativeDimension P₀.dimension (V.ι ≫ snd) := by
        haveI : IsAffine (V : Scheme) := hV
        have e2 : ⊤ ≤ V.ι ⁻¹ᵁ V := (Scheme.Opens.ι_preimage_self V).ge
        have e' : ⊤ ≤ (V.ι ≫ snd) ⁻¹ᵁ U := by
          intro z hz
          exact e (e2 hz)
        refine SmoothOfRelativeDimension.mk (fun x => ⟨U, hU, ⊤, isAffineOpen_top _, trivial,
          e', ?_⟩)
        rw [← Scheme.Hom.appLE_comp_appLE V.ι snd U V ⊤ e e2, CommRingCat.hom_comp,
          Scheme.Opens.ι_appLE]
        have hle : V.ι ''ᵁ ⊤ ≤ V := himg.le
        haveI : IsIso (homOfLE hle) :=
          ⟨⟨homOfLE himg.ge, Subsingleton.elim _ _, Subsingleton.elim _ _⟩⟩
        have h0 : RingHom.IsStandardSmoothOfRelativeDimension 0
            (Z.presheaf.map (homOfLE hle).op).hom :=
          RingHom.IsStandardSmoothOfRelativeDimension.equiv
            (asIso (Z.presheaf.map (homOfLE hle).op)).commRingCatIsoToRingEquiv
        have := h0.comp hrel
        rwa [zero_add] at this
      have hV' := wcpa_smooth_stalk_isDomain K' V (V.ι ≫ snd) P₀.dimension ⟨w, hwV⟩
      exact MulEquiv.isDomain _
        (Scheme.Opens.stalkIso V ⟨w, hwV⟩).symm.commRingCatIsoToRingEquiv.toMulEquiv
    exact wcpa_irreducible_of_connected_domain_stalks Z hdom
  ·
    haveI : IsProper (P.f ≫ (wcP1Over K).hom) := by rw [P.hf]; exact P.proper
    haveI : IsSeparated (wcP1Over K).hom := by
      dsimp only [wcP1Over, wcProjKStr, Over.mk_hom]
      infer_instance
    haveI : IsProper P.f := IsProper.of_comp P.f (wcP1Over K).hom
    infer_instance

theorem wc_ldc_fibre_embedding (F' K L₁ : Type u) [Field F'] [Field K] [Field L₁] [Algebra F' K]
    [Algebra K L₁] (Y : Over (Spec (.of F'))) (n : ℕ) (P : wcPreDatum F' K Y n)
    (v : Spec (.of L₁) ⟶ (wcP1Over K).left)
    (hv : v ≫ (wcP1Over K).hom = Spec.map (CommRingCat.ofHom (algebraMap K L₁))) :
    ∃ κ : Limits.pullback P.f v ⟶ wcProjK L₁ P.M,
      IsClosedImmersion κ ∧ κ ≫ wcProjKStr L₁ P.M = Limits.pullback.snd P.f v :=
by
  haveI hsep : IsSeparated (wcP1Over K).hom := by
    dsimp only [wcP1Over, wcProjKStr, Over.mk_hom]
    infer_instance
  obtain ⟨jE, hjE, hjEw⟩ := wc_ldp_base_change_embedded K P.Yt P.M P.jt P.hjt P.hjtY L₁
  haveI := hjE
  have a1 : Limits.pullback.mapDesc P.f v (wcP1Over K).hom ≫
      Limits.pullback.snd (P.f ≫ (wcP1Over K).hom) (v ≫ (wcP1Over K).hom) =
      Limits.pullback.snd P.f v := by
    simp [Limits.pullback.mapDesc, Limits.pullback.map, Limits.pullback.lift_snd]
  have b1 : (Limits.pullback.congrHom P.hf hv).hom ≫
      Limits.pullback.snd P.Yt.hom (Spec.map (CommRingCat.ofHom (algebraMap K L₁))) =
      Limits.pullback.snd (P.f ≫ (wcP1Over K).hom) (v ≫ (wcP1Over K).hom) := by
    rw [Limits.pullback.congrHom_hom]
    exact (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)
  refine ⟨Limits.pullback.mapDesc P.f v (wcP1Over K).hom ≫
    (Limits.pullback.congrHom P.hf hv).hom ≫ jE, inferInstance, ?_⟩
  rw [Category.assoc, Category.assoc, hjEw, b1, a1]

theorem wc_ldc_bh_bertini_closed (K : Type u) [Field K] [IsAlgClosed K] (M e : ℕ)
    (X : Over (Spec (.of K))) [GeometricallyIrreducible X.hom] [SmoothOfRelativeDimension e X.hom]
    (ι : X.left ⟶ wcProjK K M) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr K M = X.hom) :
    ∃ Ψ : MvPolynomial (Fin (M + 1)) K, Ψ ≠ 0 ∧
      ∀ h : Fin (M + 1) → K, MvPolynomial.eval h Ψ ≠ 0 →
        ∀ x : X.left, IsClosed ({x} : Set X.left) → ∀ (a : Fin (M + 1))
          (hx : x ∈ ι ⁻¹ᵁ wcSgD K M a),
          wcLdpGerm K M ι (wcLdpQuad K M fun p q => if q = a then h p else 0) a x hx ∈
            IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) →
          wcLdpSubmersive K X.hom x 1
            (wcLdpGerm K M ι (wcLdpQuad K M fun p q => if q = a then h p else 0) a x hx) :=
by
  classical

  have kaehler : ∀ (O : Type u) [CommRing O] [IsLocalRing O]
      (κ : K →+* O) (δ : O →+ O) (hδ : ∀ f g : O, δ (f * g) = f * δ g + g * δ f)
      (hδc : ∀ c : K, δ (κ c) = 0) (g : O)
      (hg : letI := κ.toAlgebra
        (1 : O) • KaehlerDifferential.D K O g - g • KaehlerDifferential.D K O 1 ∈
          (IsLocalRing.maximalIdeal O) • (⊤ : Submodule O (KaehlerDifferential K O))),
      δ g ∈ IsLocalRing.maximalIdeal O := by
    intro O _ _ κ δ hδ hδc g hg
    letI := κ.toAlgebra
    let δl : O →ₗ[K] O :=
      { toFun := δ
        map_add' := δ.map_add
        map_smul' := fun c f => by
          simp only [Algebra.smul_def, RingHom.algebraMap_toAlgebra, RingHom.id_apply]
          rw [hδ, hδc, mul_zero, add_zero] }
    let D' : Derivation K O O := Derivation.mk' δl (fun a b => by
      simp only [smul_eq_mul]
      exact hδ a b)
    have hD' : ∀ f, D' f = δ f := fun f => rfl
    have hg' : KaehlerDifferential.D K O g ∈
        (IsLocalRing.maximalIdeal O) • (⊤ : Submodule O (KaehlerDifferential K O)) := by
      simpa [Derivation.map_one_eq_zero] using hg
    have hl : ∀ z ∈ (IsLocalRing.maximalIdeal O) • (⊤ : Submodule O (KaehlerDifferential K O)),
        D'.liftKaehlerDifferential z ∈ IsLocalRing.maximalIdeal O := by
      intro z hz
      refine Submodule.smul_induction_on hz ?_ ?_
      · intro r hr n _
        rw [LinearMap.map_smul, smul_eq_mul]
        exact Ideal.mul_mem_right _ _ hr
      · intro a b ha hb
        rw [map_add]
        exact Ideal.add_mem _ ha hb
    have := hl _ hg'
    rwa [Derivation.liftKaehlerDifferential_comp_D, hD'] at this

  have jets : ∀ (R : Type u) [CommRing R] [Algebra K R]
      (b : Fin (M + 1)) (u : Fin (M + 1) → R) (hub : u b = 1)
      (t : Fin e → R) (D : Fin e → Derivation K R R)
      (hDt : ∀ i k, D i (t k) = if i = k then 1 else 0)
      (χ : R →ₐ[K] K)
      (hker : RingHom.ker χ = Ideal.span (Set.range fun p => u p - algebraMap K R (χ (u p)))),
      ∀ (y₀ : K) (y : Fin e → K), ∃ β : Fin (M + 1) → K,
        ∑ p, β p * χ (u p) = y₀ ∧ ∀ k, ∑ p, β p * χ (D k (u p)) = y k := by
    intro R _ _ b u hub t D hDt χ hker y₀ y
    have hmem : ∀ l, t l - algebraMap K R (χ (t l)) ∈
        Ideal.span (Set.range fun p => u p - algebraMap K R (χ (u p))) := by
      intro l
      rw [← hker, RingHom.mem_ker]
      simp
    choose c hc using fun l => (Ideal.mem_span_range_iff_exists_fun).mp (hmem l)
    have hdual : ∀ k l, ∑ p, χ (c l p) * χ (D k (u p)) = if k = l then 1 else 0 := by
      intro k l
      have hterm : ∀ p, χ (D k (c l p * (u p - algebraMap K R (χ (u p))))) =
          χ (c l p) * χ (D k (u p)) := by
        intro p
        simp [Derivation.leibniz, map_sub, Derivation.map_algebraMap, AlgHom.commutes]
      have h1 := congrArg (fun z => χ (D k z)) (hc l)
      simp only [map_sum, hterm] at h1
      rw [h1, map_sub, Derivation.map_algebraMap, sub_zero, hDt]
      split_ifs <;> simp
    have hub1 : χ (u b) = 1 := by rw [hub, map_one]
    have hDb : ∀ k, D k (u b) = 0 := fun k => by rw [hub]; exact Derivation.map_one_eq_zero _
    refine ⟨fun p => (∑ l, y l * χ (c l p)) +
      if p = b then y₀ - ∑ p', (∑ l, y l * χ (c l p')) * χ (u p') else 0, ?_, ?_⟩
    · simp only [add_mul, Finset.sum_add_distrib, ite_mul, zero_mul, Finset.sum_ite_eq',
        Finset.mem_univ, if_true, hub1, mul_one]
      ring
    · intro k
      simp only [add_mul, Finset.sum_add_distrib, ite_mul, zero_mul, Finset.sum_ite_eq',
        Finset.mem_univ, if_true, hDb, map_zero, mul_zero, add_zero]
      calc ∑ p, (∑ l, y l * χ (c l p)) * χ (D k (u p))
          = ∑ l, y l * ∑ p, χ (c l p) * χ (D k (u p)) := by
            simp only [Finset.sum_mul, Finset.mul_sum]
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl (fun _ _ => Finset.sum_congr rfl (fun _ _ => by ring))
        _ = y k := by
            simp only [hdual, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_univ,
              if_true]

  have point : ∀ (R : Type u) [CommRing R] [Algebra K R]
      (ρ ι' : Type) [Fintype ρ] [Fintype ι'] (L : ρ → ι' → R) (χ : R →ₐ[K] K) (h : ι' → K)
      (hrow : ∀ i, ∑ j, χ (L i j) * h j = 0),
      ∃ ψ : (MvPolynomial ι' R ⧸ Ideal.span (Set.range fun i =>
          ∑ j, MvPolynomial.C (L i j) * MvPolynomial.X j)) →ₐ[K] K,
        ψ.comp (MvPolynomial.aeval fun j => Ideal.Quotient.mk (Ideal.span (Set.range fun i =>
          ∑ j, MvPolynomial.C (L i j) * MvPolynomial.X j)) (MvPolynomial.X j)) =
          MvPolynomial.aeval h := by
    intro R _ _ ρ ι' _ _ L χ h hrow
    set I := Ideal.span (Set.range fun i => ∑ j, MvPolynomial.C (L i j) * MvPolynomial.X j)
      with hI
    let P : MvPolynomial ι' R →+* K := MvPolynomial.eval₂Hom (χ : R →+* K) h
    have hIP : I ≤ RingHom.ker P := by
      rw [hI, Ideal.span_le, Set.range_subset_iff]
      intro i
      simp only [SetLike.mem_coe, RingHom.mem_ker, P, map_sum, map_mul, MvPolynomial.eval₂Hom_C,
        MvPolynomial.eval₂Hom_X']
      exact hrow i
    let Pb : (MvPolynomial ι' R ⧸ I) →+* K := Ideal.Quotient.lift I P hIP
    have hPb : ∀ c : K, Pb (algebraMap K (MvPolynomial ι' R ⧸ I) c) = c := by
      intro c
      rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_apply]
      change P (MvPolynomial.C (algebraMap K R c)) = c
      simp only [P, MvPolynomial.eval₂Hom_C, RingHom.coe_coe]
      exact χ.commutes c
    refine ⟨{ Pb with commutes' := hPb }, ?_⟩
    apply MvPolynomial.algHom_ext
    intro j
    simp only [AlgHom.comp_apply, MvPolynomial.aeval_X]
    change P (MvPolynomial.X j) = h j
    exact MvPolynomial.eval₂Hom_X' _ _ _

  obtain ⟨m, a', R, _, _, hFT, hDom, hR, u, t, D, hub, hDt, hker, hch⟩ :=
    wc_ldp_smooth_quadric_charts K M e X ι hι hιX

  have unitFact : ∀ (O : Type u) [CommRing O] [IsLocalRing O] (κ : K →+* O) (d : K),
      κ d ∈ IsLocalRing.maximalIdeal O → d = 0 := by
    intro O _ _ κ d hd
    by_contra hne
    exact (IsLocalRing.mem_maximalIdeal _).mp hd ((isUnit_iff_ne_zero.mpr hne).map κ)

  have key : ∀ j : Fin m, ∃ Φj : MvPolynomial (Fin (M + 1)) K, Φj ≠ 0 ∧
      ∀ (χ : R j →ₐ[K] K) (h : Fin (M + 1) → K),
        χ (∑ p, h p • u j p) = 0 → (∀ k, χ (D j k (∑ p, h p • u j p)) = 0) →
        MvPolynomial.eval h Φj = 0 := by
    intro j
    haveI := hFT j
    let L : Option (Fin e) → Fin (M + 1) → R j :=
      fun o p => Option.elim o (u j p) (fun k => D j k (u j p))
    have hsurj : ∀ (χ : R j →ₐ[K] K) (y : Option (Fin e) → K),
        ∃ w : Fin (M + 1) → K, ∀ i, ∑ p, w p * χ (L i p) = y i := by
      intro χ y
      obtain ⟨β, hβ0, hβk⟩ := jets (R j) (a' j) (u j) (hub j) (t j) (D j) (hDt j) χ (hker j χ)
        (y none) (fun k => y (some k))
      refine ⟨β, ?_⟩
      intro i
      rcases i with _ | k
      · exact hβ0
      · exact hβk k
    have hC := wc_ldp_linear_fibres_dim K (R j) e (hR j) (Option (Fin e)) (Fin (M + 1)) L hsurj
    have hnat : e + Fintype.card (Fin (M + 1)) - Fintype.card (Option (Fin e)) = M := by
      simp only [Fintype.card_option, Fintype.card_fin]
      omega
    rw [hnat] at hC
    have hlt : ringKrullDim (MvPolynomial (Fin (M + 1)) (R j) ⧸ Ideal.span (Set.range fun i =>
        ∑ p, MvPolynomial.C (L i p) * MvPolynomial.X p)) <
          (Fintype.card (Fin (M + 1)) : WithBot ℕ∞) := by
      refine lt_of_le_of_lt hC ?_
      rw [Fintype.card_fin]
      exact_mod_cast Nat.lt_succ_self M
    obtain ⟨Φ, hΦ0, hΦ⟩ := wc_ldp_alg_dependence K _
      (MvPolynomial.aeval fun p => Ideal.Quotient.mk (Ideal.span (Set.range fun i =>
        ∑ p, MvPolynomial.C (L i p) * MvPolynomial.X p)) (MvPolynomial.X p)) hlt
    refine ⟨Φ, hΦ0, ?_⟩
    intro χ h e0 ek
    have hrow : ∀ i, ∑ p, χ (L i p) * h p = 0 := by
      intro i
      rcases i with _ | k
      · show ∑ p, χ (u j p) * h p = 0
        rw [← e0, map_sum]
        exact Finset.sum_congr rfl (fun p _ => by rw [map_smul, smul_eq_mul, mul_comm])
      · show ∑ p, χ (D j k (u j p)) * h p = 0
        rw [← ek k, map_sum, map_sum]
        exact Finset.sum_congr rfl (fun p _ => by
          rw [Derivation.map_smul, map_smul, smul_eq_mul, mul_comm])
    obtain ⟨ψ, hψ⟩ := point (R j) (Option (Fin e)) (Fin (M + 1)) L χ h hrow
    rw [← MvPolynomial.coe_aeval_eq_eval, ← hψ]
    exact (congrArg ψ hΦ).trans (map_zero ψ)
  choose Φj hΦj0 hΦj using key
  refine ⟨∏ j, Φj j, Finset.prod_ne_zero_iff.mpr (fun j _ => hΦj0 j), ?_⟩

  intro h hh x hxc a hx hgm
  rw [map_prod] at hh
  have hvj : ∀ j, MvPolynomial.eval h (Φj j) ≠ 0 := fun j =>
    Finset.prod_ne_zero_iff.mp hh j (Finset.mem_univ j)
  by_contra hT
  obtain ⟨j, ha, χ, lam, δ, hlamχ, -, hgerm, -, hδ, hδc, hδlam⟩ := hch x hxc a hx
  have hua : u j a = 1 := by rw [← ha]; exact hub j
  have hval : ∀ r : R j, lam r ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) →
      χ r = 0 := by
    intro r hr
    apply unitFact _ (wcLdpConst K X.hom x)
    have := Ideal.sub_mem _ hr (hlamχ r)
    rwa [sub_sub_cancel] at this
  have hcol : ∑ q : Fin (M + 1) × Fin (M + 1),
      (if q.2 = a then h q.1 else 0) • (u j q.1 * u j q.2) = ∑ p, h p • u j p := by
    rw [Fintype.sum_prod_type]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    simp [ite_smul, hua]
  have hg : lam (∑ p, h p • u j p) =
      wcLdpGerm K M ι (wcLdpQuad K M fun p q => if q = a then h p else 0) a x hx := by
    rw [← hcol]
    exact hgerm (fun q => if q.2 = a then h q.1 else 0)
  have e0 : χ (∑ p, h p • u j p) = 0 := hval _ (by rw [hg]; exact hgm)
  have ek : ∀ k, χ (D j k (∑ p, h p • u j p)) = 0 := by
    intro k
    apply hval
    rw [← hδlam, hg]
    apply kaehler _ (wcLdpConst K X.hom x) (δ k) (hδ k) (hδc k)
    unfold wcLdpSubmersive at hT
    exact not_not.mp hT
  exact hvj j (hΦj j χ h e0 ek)

theorem wc_ldc_bh_all_points (E : Type u) [Field E] (M e : ℕ) {X : Scheme.{u}}
    (s : X ⟶ Spec (.of E)) [SmoothOfRelativeDimension e s] (ι : X ⟶ wcProjK E M)
    (G : Fin (M + 1) → MvPolynomial.homogeneousSubmodule (Fin (M + 1)) E 2)
    (hcl : ∀ x : X, IsClosed ({x} : Set X) → ∀ (a : Fin (M + 1)) (hx : x ∈ ι ⁻¹ᵁ wcSgD E M a),
      wcLdpGerm E M ι (G a) a x hx ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) →
      wcLdpSubmersive E s x 1 (wcLdpGerm E M ι (G a) a x hx)) :
    ∀ (x : X) (a : Fin (M + 1)) (hx : x ∈ ι ⁻¹ᵁ wcSgD E M a),
      wcLdpGerm E M ι (G a) a x hx ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) →
      wcLdpSubmersive E s x 1 (wcLdpGerm E M ι (G a) a x hx) :=
by
  classical
  haveI : Smooth s := SmoothOfRelativeDimension.smooth e s
  haveI : JacobsonSpace X := LocallyOfFiniteType.jacobsonSpace s

  have hJ : ∀ (O : Set X), IsOpen O → ∀ x ∈ O,
      ∃ z : X, IsClosed ({z} : Set X) ∧ x ⤳ z ∧ z ∈ O := by
    intro O hO x hx
    have hZ : IsLocallyClosed (closure {x} ∩ O) :=
      (isClosed_closure.isLocallyClosed).inter hO.isLocallyClosed
    obtain ⟨z, ⟨hzc, hzO⟩, hz⟩ :=
      jacobsonSpace_iff_locallyClosed.mp (inferInstance : JacobsonSpace X)
        (closure {x} ∩ O) ⟨x, subset_closure (Set.mem_singleton x), hx⟩ hZ
    exact ⟨z, hz, specializes_iff_mem_closure.mpr hzc, hzO⟩

  have hgerm : ∀ {x z : X} (h : x ⤳ z) (U : X.Opens) (hz : z ∈ U) (f : Γ(X, U)),
      (X.presheaf.stalkSpecializes h).hom ((X.presheaf.germ U z hz).hom f) =
        (X.presheaf.germ U x (h.mem_open U.isOpen hz)).hom f := by
    intro x z h U hz f
    rw [← TopCat.Presheaf.germ_stalkSpecializes X.presheaf hz h]
    rfl
  have hgermL : ∀ {x z : X} (h : x ⤳ z) (Q : MvPolynomial.homogeneousSubmodule (Fin (M + 1)) E 2)
      (b : Fin (M + 1)) (hz : z ∈ ι ⁻¹ᵁ wcSgD E M b),
      (X.presheaf.stalkSpecializes h).hom (wcLdpGerm E M ι Q b z hz) =
        wcLdpGerm E M ι Q b x (h.mem_open (ι ⁻¹ᵁ wcSgD E M b).isOpen hz) :=
    fun h Q b hz => hgerm h _ hz _
  have hconst : ∀ {x z : X} (h : x ⤳ z) (c : E),
      (X.presheaf.stalkSpecializes h).hom (wcLdpConst E s z c) = wcLdpConst E s x c :=
    fun h c => hgerm h ⊤ trivial _

  have hU : ∀ {x z : X} (h : x ⤳ z) (g : X.presheaf.stalk z),
      (X.presheaf.stalkSpecializes h).hom g ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) →
        g ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk z) := by
    intro x z h g hg
    by_contra hn
    have hu : IsUnit g := IsLocalRing.notMem_maximalIdeal.mp hn
    exact IsLocalRing.notMem_maximalIdeal.mpr (hu.map (X.presheaf.stalkSpecializes h).hom) hg
  intro x a hx hm
  obtain ⟨z, hzc, h, hza⟩ := hJ _ (ι ⁻¹ᵁ wcSgD E M a).isOpen x hx
  have hmz : wcLdpGerm E M ι (G a) a z hza ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk z) :=
    hU h _ (by rw [hgermL h (G a) a hza]; exact hm)
  have hsub := hcl z hzc a hza hmz
  letI iA : Algebra E (X.presheaf.stalk z) := (wcLdpConst E s z).toAlgebra
  letI iB : Algebra E (X.presheaf.stalk x) := (wcLdpConst E s x).toAlgebra
  letI iAB : Algebra (X.presheaf.stalk z) (X.presheaf.stalk x) :=
    (X.presheaf.stalkSpecializes h).hom.toAlgebra
  haveI : IsScalarTower E (X.presheaf.stalk z) (X.presheaf.stalk x) :=
    IsScalarTower.of_algebraMap_eq (fun c => (hconst h c).symm)
  haveI := wc_ldp_nc_stalkSpecializes_isLocalization X x z h
  haveI : Module.Free (X.presheaf.stalk z) Ω[X.presheaf.stalk z⁄E] :=
    (wc_ldp_il_stalk_of_smooth_field E s e z).2.1
  have hB := wc_ldp_nc_submersive_localization E (X.presheaf.stalk z) (X.presheaf.stalk x)
    ((IsLocalRing.maximalIdeal (X.presheaf.stalk x)).comap
      (X.presheaf.stalkSpecializes h).hom).primeCompl _ _ hsub
  have e1 : algebraMap (X.presheaf.stalk z) (X.presheaf.stalk x)
      (wcLdpGerm E M ι (G a) a z hza) = wcLdpGerm E M ι (G a) a x hx := hgermL h (G a) a hza
  rw [e1, map_one] at hB
  exact hB

theorem wc_ldc_bh_descend (F' E K : Type u) [Field F'] [Field E] [Field K] [Algebra F' E]
    [Algebra F' K] [Algebra E K] [IsScalarTower F' E K] (Y : Over (Spec (.of F'))) (M : ℕ)
    (jK : Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))) ⟶ wcProjK K M)
    (jE : Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) ⟶ wcProjK E M)
    (hiff : ∀ (w : ↥(Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K)))))
        (a : Fin (M + 1)), w ∈ jK ⁻¹ᵁ wcSgD K M a ↔ wcLdpRho F' E K Y w ∈ jE ⁻¹ᵁ wcSgD E M a)
    (hgerm : ∀ (G : MvPolynomial.homogeneousSubmodule (Fin (M + 1)) E 2)
        (w : ↥(Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K)))))
        (a : Fin (M + 1)) (hw : w ∈ jK ⁻¹ᵁ wcSgD K M a)
        (hρw : wcLdpRho F' E K Y w ∈ jE ⁻¹ᵁ wcSgD E M a),
        ((wcLdpRho F' E K Y).stalkMap w).hom (wcLdpGerm E M jE G a _ hρw) =
          wcLdpGerm K M jK (wcLdpMapQ E K M G) a w hw)
    (G : Fin (M + 1) → MvPolynomial.homogeneousSubmodule (Fin (M + 1)) E 2)
    (hK : ∀ (w : ↥(Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K)))))
        (a : Fin (M + 1)) (hw : w ∈ jK ⁻¹ᵁ wcSgD K M a),
        wcLdpGerm K M jK (wcLdpMapQ E K M (G a)) a w hw ∈ IsLocalRing.maximalIdeal _ →
        wcLdpSubmersive K (Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))))
          w 1 (wcLdpGerm K M jK (wcLdpMapQ E K M (G a)) a w hw)) :
    ∀ (x : ↥(Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E)))))
      (a : Fin (M + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD E M a),
      wcLdpGerm E M jE (G a) a x hx ∈ IsLocalRing.maximalIdeal _ →
      wcLdpSubmersive E (Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))))
        x 1 (wcLdpGerm E M jE (G a) a x hx) :=
by
  classical

  have hsub : ∀ {XE XK : Scheme.{u}} (sE : XE ⟶ Spec (.of E)) (sK : XK ⟶ Spec (.of K))
      (ρ : XK ⟶ XE) (hρ : ρ ≫ sE = sK ≫ Spec.map (CommRingCat.ofHom (algebraMap E K)))
      (w : XK) (g₀ g₁ : XE.presheaf.stalk (ρ w))
      (h : wcLdpSubmersive K sK w ((ρ.stalkMap w).hom g₀) ((ρ.stalkMap w).hom g₁)),
      wcLdpSubmersive E sE (ρ w) g₀ g₁ := by
    intro XE XK sE sK ρ hρ w g₀ g₁ h
    have hcomm : (ρ.stalkMap w).hom.comp (wcLdpConst E sE (ρ w)) =
        (wcLdpConst K sK w).comp (algebraMap E K) := by
      ext e
      have h1 : ∀ y, (ρ.stalkMap w).hom ((XE.presheaf.germ ⊤ (ρ w) trivial).hom y) =
          (XK.presheaf.germ ⊤ w trivial).hom (ρ.appTop.hom y) := fun y =>
        Scheme.Hom.germ_stalkMap_apply ρ ⊤ w trivial y
      have h2 : ∀ z, ρ.appTop.hom (sE.appTop.hom z) =
          sK.appTop.hom ((Spec.map (CommRingCat.ofHom (algebraMap E K))).appTop.hom z) := by
        intro z
        have := congrArg (fun g => g.appTop.hom z) hρ
        simp only [Scheme.Hom.comp_appTop] at this
        exact this
      have h3 : (Spec.map (CommRingCat.ofHom (algebraMap E K))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom e) =
          (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom (algebraMap E K e) := by
        have := congrArg (fun g => g.hom e)
          (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap E K)))
        exact this.symm
      show (ρ.stalkMap w).hom ((XE.presheaf.germ ⊤ (ρ w) trivial).hom
          (sE.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom e))) =
        (XK.presheaf.germ ⊤ w trivial).hom
          (sK.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom (algebraMap E K e)))
      rw [h1, h2, h3]
    have key : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
        (iA : E →+* A) (iB : K →+* B) (f : A →+* B) [IsLocalHom f]
        (_ : f.comp iA = iB.comp (algebraMap E K)) (g₀ g₁ : A),
        (letI := iB.toAlgebra;
          f g₀ • KaehlerDifferential.D K B (f g₁) - f g₁ • KaehlerDifferential.D K B (f g₀) ∉
            (IsLocalRing.maximalIdeal B) • (⊤ : Submodule B (KaehlerDifferential K B))) →
        (letI := iA.toAlgebra;
          g₀ • KaehlerDifferential.D E A g₁ - g₁ • KaehlerDifferential.D E A g₀ ∉
            (IsLocalRing.maximalIdeal A) • (⊤ : Submodule A (KaehlerDifferential E A))) := by
      intro A B _ _ _ _ iA iB f _ hc g₀ g₁ hB
      letI : Algebra E A := iA.toAlgebra
      letI : Algebra K B := iB.toAlgebra
      letI : Algebra A B := f.toAlgebra
      letI : Algebra E B := (f.comp iA).toAlgebra
      haveI : IsScalarTower E A B := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      haveI : IsScalarTower E K B :=
        IsScalarTower.of_algebraMap_eq (fun x => (congrArg (fun g => g x) hc : _))
      haveI : SMulCommClass K A B :=
        ⟨fun k a b => by simp only [Algebra.smul_def]; ring⟩
      haveI : IsScalarTower A B (KaehlerDifferential K B) :=
        KaehlerDifferential.isScalarTower_of_tower K B
      set L := KaehlerDifferential.map E K A B with hL
      intro hA
      apply hB
      have hω : L (g₀ • KaehlerDifferential.D E A g₁ - g₁ • KaehlerDifferential.D E A g₀) =
          f g₀ • KaehlerDifferential.D K B (f g₁) - f g₁ • KaehlerDifferential.D K B (f g₀) := by
        rw [map_sub, LinearMap.map_smul, LinearMap.map_smul, KaehlerDifferential.map_D,
          KaehlerDifferential.map_D, ← algebraMap_smul B g₀, ← algebraMap_smul B g₁]
        rfl
      rw [← hω]
      have hmap : ∀ x, x ∈ (IsLocalRing.maximalIdeal A) •
          (⊤ : Submodule A (KaehlerDifferential E A)) →
          L x ∈ (IsLocalRing.maximalIdeal B) • (⊤ : Submodule B (KaehlerDifferential K B)) := by
        intro x hx
        refine Submodule.smul_induction_on hx ?_ ?_
        · intro r hr n _
          rw [LinearMap.map_smul, ← algebraMap_smul B r (L n)]
          exact Submodule.smul_mem_smul
            ((IsLocalRing.mem_maximalIdeal _).mpr
              (map_nonunit f r ((IsLocalRing.mem_maximalIdeal _).mp hr))) Submodule.mem_top
        · intro x y hx hy
          rw [map_add]
          exact Submodule.add_mem _ hx hy
      exact hmap _ hA
    unfold wcLdpSubmersive at h ⊢
    exact key _ _ (wcLdpConst E sE (ρ w)) (wcLdpConst K sK w) (ρ.stalkMap w).hom hcomm g₀ g₁ h

  have hfst : wcLdpRho F' E K Y ≫
      Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) =
      Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))) :=
    Limits.pullback.lift_fst _ _ _
  have hρ : wcLdpRho F' E K Y ≫
      Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) =
      Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap E K)) :=
    Limits.pullback.lift_snd _ _ _
  have hφ : Spec.map (CommRingCat.ofHom (algebraMap E K)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap F' E)) =
      Spec.map (CommRingCat.ofHom (algebraMap F' K)) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]
  have hout : IsPullback (wcLdpRho F' E K Y ≫
      Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))))
      (Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K)))) Y.hom
      (Spec.map (CommRingCat.ofHom (algebraMap E K)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F' E))) := by
    rw [hfst, hφ]
    exact IsPullback.of_hasPullback _ _
  have hpb := IsPullback.of_right hout hρ
    (IsPullback.of_hasPullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))))
  have hSurj : Surjective (wcLdpRho F' E K Y) :=
    MorphismProperty.of_isPullback (P := @Surjective) hpb.flip inferInstance

  intro x a hx hm
  obtain ⟨w, rfl⟩ := hSurj.surj x
  have hw := (hiff w a).mpr hx
  have he := hgerm (G a) w a hw hx
  have hmK : wcLdpGerm K M jK (wcLdpMapQ E K M (G a)) a w hw ∈ IsLocalRing.maximalIdeal _ := by
    rw [← he]
    exact map_nonunit ((wcLdpRho F' E K Y).stalkMap w).hom _ hm
  have hT := hK w a hw hmK
  have hT' : wcLdpSubmersive K
      (Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K)))) w
      (((wcLdpRho F' E K Y).stalkMap w).hom 1)
      (((wcLdpRho F' E K Y).stalkMap w).hom (wcLdpGerm E M jE (G a) a _ hx)) := by
    rw [map_one, he]
    exact hT
  exact hsub _ _ (wcLdpRho F' E K Y) hρ w 1 _ hT'

theorem wc_ldc_bh_finite_subfield (L₁ : Type u) [Field L₁] [Finite L₁] (M : ℕ)
    (Ψ : MvPolynomial (Fin (M + 1)) (AlgebraicClosure L₁)) (hΨ : Ψ ≠ 0) :
    ∃ (L : IntermediateField L₁ (AlgebraicClosure L₁)) (_ : Finite L) (h : Fin (M + 1) → L),
      MvPolynomial.eval (fun i => (h i : AlgebraicClosure L₁)) Ψ ≠ 0 :=
by
  classical
  have hex : ∃ x : Fin (M + 1) → AlgebraicClosure L₁, MvPolynomial.eval x Ψ ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    exact hΨ (MvPolynomial.funext fun x => by rw [hcon x, map_zero])
  obtain ⟨x, hx⟩ := hex
  haveI hfd : FiniteDimensional L₁ (IntermediateField.adjoin L₁ (Set.range x)) :=
    IntermediateField.finiteDimensional_adjoin (K := L₁) (S := Set.range x)
      (fun y _ => Algebra.IsIntegral.isIntegral y)
  haveI hfin : Finite (IntermediateField.adjoin L₁ (Set.range x)) := Module.finite_of_finite L₁
  refine ⟨IntermediateField.adjoin L₁ (Set.range x), hfin,
    fun i => ⟨x i, IntermediateField.subset_adjoin L₁ (Set.range x) ⟨i, rfl⟩⟩, ?_⟩
  exact hx

theorem wc_ldc_bh_cut (L : Type u) [Field L] (M : ℕ) (P : Scheme.{u}) (κL : P ⟶ wcProjK L M)
    (hκL : IsClosedImmersion κL) (h : Fin (M + 1) → L)
    (H : MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L 1)
    (hH : (H : MvPolynomial (Fin (M + 1)) L) = ∑ p, MvPolynomial.C (h p) * MvPolynomial.X p) :
    ∃ (Z : Scheme.{u}) (ιZ : Z ⟶ P), IsClosedImmersion ιZ ∧
      Set.range ιZ = {x | κL x ∉ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L) MvPolynomial.gradedAlgebra
        (H : MvPolynomial (Fin (M + 1)) L)} ∧
      (∀ x : P, ∃ a : Fin (M + 1), x ∈ κL ⁻¹ᵁ wcSgD L M a) ∧
      ∀ (z : Z) (a : Fin (M + 1)) (hz : ιZ z ∈ κL ⁻¹ᵁ wcSgD L M a),
        wcLdpGerm L M κL (wcLdpQuad L M fun p q => if q = a then h p else 0) a (ιZ z) hz ∈
          IsLocalRing.maximalIdeal (P.presheaf.stalk (ιZ z)) ∧
        Function.Surjective (ιZ.stalkMap z).hom ∧
        RingHom.ker (ιZ.stalkMap z).hom =
          Ideal.span {wcLdpGerm L M κL (wcLdpQuad L M fun p q => if q = a then h p else 0) a (ιZ z) hz} :=
by
  classical
  haveI : IsClosedImmersion κL := hκL
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L) :=
    MvPolynomial.gradedAlgebra
  have hX : ∀ k : Fin (M + 1), (MvPolynomial.X k : MvPolynomial (Fin (M + 1)) L) ∈
      MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L 1 := fun k =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)

  have L1 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1),
      Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g = (Proj 𝒜).basicOpen
        (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
    intro σ A _ _ _ 𝒜 _ f g hf hg
    have ha : HomogeneousLocalization.Away.isLocalizationElem hf hg =
        HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg := by
      apply HomogeneousLocalization.val_injective
      simp [HomogeneousLocalization.Away.val_mk]
    have hb : (Proj.basicOpen 𝒜 f).ι ⁻¹ᵁ Proj.basicOpen 𝒜 g =
        (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) := by
      have h1 := Proj.awayι_preimage_basicOpen 𝒜 hf Nat.one_pos hg Nat.one_pos
      rw [← Proj.basicOpenIsoSpec_inv_ι, Scheme.Hom.comp_preimage, ha] at h1
      rw [← h1, ← Scheme.Hom.comp_preimage, Iso.hom_inv_id, Scheme.Hom.id_preimage]
    have hd : (Proj 𝒜).basicOpen
        (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) =
        (Proj.basicOpen 𝒜 f).ι ''ᵁ ((Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
      have hsp := basicOpen_eq_of_affine (R := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))
        (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)
      have h3 : (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) =
          (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          (Spec _).basicOpen ((Scheme.ΓSpecIso _).inv
            (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) :=
        congrArg (fun V => (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ V) hsp.symm
      rw [h3, ← Scheme.Opens.ι_image_basicOpen_topIso_inv, Scheme.preimage_basicOpen_top]
      congr 2
      rw [Proj.basicOpenIsoSpec_hom]
      change _ = ConcreteCategory.hom (Scheme.Hom.app (Proj.basicOpenToSpec 𝒜 f) ⊤) _
      rw [Proj.basicOpenToSpec_app_top]
      exact congrArg (fun y => ConcreteCategory.hom (Proj.basicOpen 𝒜 f).topIso.inv
        (ConcreteCategory.hom (Proj.awayToSection 𝒜 f) y))
        (Iso.inv_hom_id_apply (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)))
          (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)).symm
    rw [hd, ← hb, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]

  have T2 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g F : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1) (hF : F ∈ 𝒜 1),
      (Proj 𝒜).presheaf.map (homOfLE (inf_le_right :
          Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 g)).op
          (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 F hF)) =
        (Proj 𝒜).presheaf.map (homOfLE (inf_le_right :
            Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 g)).op
          (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 f hf)) *
        (Proj 𝒜).presheaf.map (homOfLE (inf_le_left :
            Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op
          (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 F hF)) := by
    intro σ A _ _ _ 𝒜 _ f g F hf hg hF
    have key : ∀ (W : (Proj 𝒜).Opens) (_ : W = Proj.basicOpen 𝒜 (f * g))
        (h₁ : W ≤ Proj.basicOpen 𝒜 f) (h₂ : W ≤ Proj.basicOpen 𝒜 g),
        (Proj 𝒜).presheaf.map (homOfLE h₂).op
            (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 F hF)) =
          (Proj 𝒜).presheaf.map (homOfLE h₂).op
            (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 f hf)) *
          (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 F hF)) := by
      rintro W rfl h₁ h₂
      have e1 : ∀ a, (Proj 𝒜).presheaf.map (homOfLE h₁).op (Proj.awayToSection 𝒜 f a) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hg rfl a) := by
        intro a
        exact (ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 hg (rfl : f * g = f * g)) a).symm
      have e2 : ∀ b, (Proj 𝒜).presheaf.map (homOfLE h₂).op (Proj.awayToSection 𝒜 g b) =
          Proj.awayToSection 𝒜 (f * g)
            (HomogeneousLocalization.awayMap 𝒜 hf (mul_comm f g) b) := by
        intro b
        exact (ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 (f := g) hf (mul_comm f g)) b).symm
      rw [e2, e2, e1, ← map_mul]
      congr 1
      rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.awayMap_mk]
      apply HomogeneousLocalization.val_injective
      simp only [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
        Localization.mk_mul]
      rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [Submonoid.coe_mul, pow_one, OneMemClass.coe_one, one_mul]
      ring
    exact key _ (Proj.basicOpen_mul 𝒜 f g).symm _ _

  have I0 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1),
      (Proj 𝒜).presheaf.map (homOfLE (inf_le_left :
          Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op
          (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) *
        (Proj 𝒜).presheaf.map (homOfLE (inf_le_right :
          Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 g)).op
          (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 f hf)) = 1 := by
    intro σ A _ _ _ 𝒜 _ f g hf hg
    have key : ∀ (W : (Proj 𝒜).Opens) (_ : W = Proj.basicOpen 𝒜 (f * g))
        (h₁ : W ≤ Proj.basicOpen 𝒜 f) (h₂ : W ≤ Proj.basicOpen 𝒜 g),
        (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) *
          (Proj 𝒜).presheaf.map (homOfLE h₂).op
            (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 f hf)) = 1 := by
      rintro W rfl h₁ h₂
      have e1 : ∀ a, (Proj 𝒜).presheaf.map (homOfLE h₁).op (Proj.awayToSection 𝒜 f a) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hg rfl a) := by
        intro a
        exact (ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 hg (rfl : f * g = f * g)) a).symm
      have e2 : ∀ b, (Proj 𝒜).presheaf.map (homOfLE h₂).op (Proj.awayToSection 𝒜 g b) =
          Proj.awayToSection 𝒜 (f * g)
            (HomogeneousLocalization.awayMap 𝒜 hf (mul_comm f g) b) := by
        intro b
        exact (ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 (f := g) hf (mul_comm f g)) b).symm
      rw [e1, e2, ← map_mul]
      have h1 : HomogeneousLocalization.awayMap 𝒜 hg (rfl : f * g = f * g)
            (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) *
          HomogeneousLocalization.awayMap 𝒜 hf (mul_comm f g)
            (HomogeneousLocalization.Away.mk 𝒜 hg 1 f hf) = 1 := by
        rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk]
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
          HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one,
          ← Localization.mk_one, Localization.mk_mul, Localization.mk_eq_mk_iff,
          Localization.r_iff_exists]
        refine ⟨1, ?_⟩
        simp only [Submonoid.coe_mul, pow_one, OneMemClass.coe_one, one_mul, mul_one]
        ring
      rw [h1, map_one]
    exact key _ (Proj.basicOpen_mul 𝒜 f g).symm _ _

  have COV : (⨆ a : Fin (M + 1), wcSgD L M a) = ⊤ := by
    refine Proj.iSup_basicOpen_eq_top _ _ ?_
    intro p hp
    have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L) 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff
        (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L) p).mp hp
    have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L) 0 p =
        MvPolynomial.homogeneousComponent 0 p :=
      (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
    rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ]
    rw [MvPolynomial.mem_ideal_span_X_image]
    intro e he
    rw [MvPolynomial.mem_support_iff] at he
    have hne : e ≠ 0 := by
      rintro rfl
      exact he h0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
    exact ⟨i, Set.mem_univ i, by simpa using hi⟩

  have QUAD : ∀ a : Fin (M + 1),
      ((wcLdpQuad L M fun p q => if q = a then h p else 0 :
          MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L 2) : MvPolynomial (Fin (M + 1)) L) =
        MvPolynomial.X a * ∑ p, MvPolynomial.C (h p) * MvPolynomial.X p := by
    intro a
    simp only [wcLdpQuad, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    rw [Finset.sum_eq_single a]
    · rw [if_pos rfl]; ring
    · intro q _ hq; simp [hq]
    · intro ha; exact absurd (Finset.mem_univ a) ha

  have SEC : ∀ a : Fin (M + 1),
      wcLdpSec L M (wcLdpQuad L M fun p q => if q = a then h p else 0) a =
      (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L)
        (MvPolynomial.X a)).hom
        (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L)
          (hX a) 1 (H : MvPolynomial (Fin (M + 1)) L) H.2) := by
    intro a
    unfold wcLdpSec
    congr 1
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
      Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [OneMemClass.coe_one, one_mul, pow_one]
    rw [QUAD a, hH]
    ring

  have TR : ∀ a b : Fin (M + 1),
      ((wcProjK L M).presheaf.map (homOfLE (inf_le_right :
          wcSgD L M a ⊓ wcSgD L M b ≤ wcSgD L M b)).op).hom
          (wcLdpSec L M (wcLdpQuad L M fun p q => if q = b then h p else 0) b) =
        ((wcProjK L M).presheaf.map (homOfLE (inf_le_right :
          wcSgD L M a ⊓ wcSgD L M b ≤ wcSgD L M b)).op).hom (wcSgE L M b a) *
        ((wcProjK L M).presheaf.map (homOfLE (inf_le_left :
          wcSgD L M a ⊓ wcSgD L M b ≤ wcSgD L M a)).op).hom
          (wcLdpSec L M (wcLdpQuad L M fun p q => if q = a then h p else 0) a) := by
    intro a b
    rw [SEC a, SEC b]
    exact T2 (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L) (MvPolynomial.X a)
      (MvPolynomial.X b) (H : MvPolynomial (Fin (M + 1)) L) (hX a) (hX b) H.2
  have Iw : ∀ a b : Fin (M + 1),
      ((wcProjK L M).presheaf.map (homOfLE (inf_le_left :
          wcSgD L M a ⊓ wcSgD L M b ≤ wcSgD L M a)).op).hom (wcSgE L M a b) *
        ((wcProjK L M).presheaf.map (homOfLE (inf_le_right :
          wcSgD L M a ⊓ wcSgD L M b ≤ wcSgD L M b)).op).hom (wcSgE L M b a) = 1 := by
    intro a b
    exact I0 (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L) (MvPolynomial.X a)
      (MvPolynomial.X b) (hX a) (hX b)

  have BO : ∀ a : Fin (M + 1),
      (wcProjK L M).basicOpen
          (wcLdpSec L M (wcLdpQuad L M fun p q => if q = a then h p else 0) a) =
        wcSgD L M a ⊓ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L)
          (H : MvPolynomial (Fin (M + 1)) L) := by
    intro a
    rw [SEC a]
    exact (L1 (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L) (MvPolynomial.X a)
      (H : MvPolynomial (Fin (M + 1)) L) (hX a) H.2).symm

  have PUSH : ∀ (U₀ U' : (wcProjK L M).Opens) (hU' : U' ≤ U₀) (V₀ : P.Opens)
      (hV : V₀ ≤ κL ⁻¹ᵁ U₀) (e' : V₀ ≤ κL ⁻¹ᵁ U') (t : Γ(wcProjK L M, U₀)),
      (P.presheaf.map (homOfLE hV).op).hom ((κL.app U₀).hom t) =
        (κL.appLE U' V₀ e').hom (((wcProjK L M).presheaf.map (homOfLE hU').op).hom t) := by
    intro U₀ U' hU' V₀ hV e' t
    rw [Scheme.Hom.app_eq_appLE]
    exact (congrArg (fun φ => CommRingCat.Hom.hom φ t)
      (Scheme.Hom.appLE_map κL _ (homOfLE hV).op)).trans
      (congrArg (fun φ => CommRingCat.Hom.hom φ t)
        (Scheme.Hom.map_appLE κL e' (homOfLE hU').op)).symm

  have COVP : ∀ x : P, ∃ a : Fin (M + 1), x ∈ κL ⁻¹ᵁ wcSgD L M a := by
    intro x
    have h1 : κL x ∈ (⨆ a : Fin (M + 1), wcSgD L M a) := by
      rw [COV]; trivial
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp h1
    exact ⟨a, ha⟩
  have hcov : (⨆ a : Fin (M + 1), κL ⁻¹ᵁ wcSgD L M a) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    obtain ⟨a, ha⟩ := COVP x
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, ha⟩
  have hW : ∀ a : Fin (M + 1), IsAffineOpen (κL ⁻¹ᵁ wcSgD L M a) := fun a =>
    (Proj.isAffineOpen_basicOpen _ (MvPolynomial.X a) (hX a) Nat.one_pos).preimage κL
  have hu : ∀ a b : Fin (M + 1),
      ∃ u : Γ(P, κL ⁻¹ᵁ wcSgD L M a ⊓ κL ⁻¹ᵁ wcSgD L M b), IsUnit u ∧
        (P.presheaf.map (homOfLE (inf_le_right :
            κL ⁻¹ᵁ wcSgD L M a ⊓ κL ⁻¹ᵁ wcSgD L M b ≤ κL ⁻¹ᵁ wcSgD L M b)).op).hom
          ((κL.app (wcSgD L M b)).hom
            (wcLdpSec L M (wcLdpQuad L M fun p q => if q = b then h p else 0) b)) =
        u * (P.presheaf.map (homOfLE (inf_le_left :
            κL ⁻¹ᵁ wcSgD L M a ⊓ κL ⁻¹ᵁ wcSgD L M b ≤ κL ⁻¹ᵁ wcSgD L M a)).op).hom
          ((κL.app (wcSgD L M a)).hom
            (wcLdpSec L M (wcLdpQuad L M fun p q => if q = a then h p else 0) a)) := by
    intro a b
    have e : κL ⁻¹ᵁ wcSgD L M a ⊓ κL ⁻¹ᵁ wcSgD L M b ≤
        κL ⁻¹ᵁ (wcSgD L M a ⊓ wcSgD L M b) := fun x hx => ⟨hx.1, hx.2⟩
    have h1 := PUSH (wcSgD L M b) (wcSgD L M a ⊓ wcSgD L M b) inf_le_right
      (κL ⁻¹ᵁ wcSgD L M a ⊓ κL ⁻¹ᵁ wcSgD L M b) inf_le_right e
      (wcLdpSec L M (wcLdpQuad L M fun p q => if q = b then h p else 0) b)
    have h2 := PUSH (wcSgD L M a) (wcSgD L M a ⊓ wcSgD L M b) inf_le_left
      (κL ⁻¹ᵁ wcSgD L M a ⊓ κL ⁻¹ᵁ wcSgD L M b) inf_le_left e
      (wcLdpSec L M (wcLdpQuad L M fun p q => if q = a then h p else 0) a)
    refine ⟨(κL.appLE (wcSgD L M a ⊓ wcSgD L M b) _ e).hom
      (((wcProjK L M).presheaf.map (homOfLE (inf_le_right :
          wcSgD L M a ⊓ wcSgD L M b ≤ wcSgD L M b)).op).hom (wcSgE L M b a)), ?_, ?_⟩
    · exact (IsUnit.of_mul_eq_one _ (by rw [mul_comm]; exact Iw a b)).map _
    · rw [h1, TR a b, map_mul, ← h2]

  have GI : ∀ (x : P) (a : Fin (M + 1)) (hx : x ∈ κL ⁻¹ᵁ wcSgD L M a),
      (P.presheaf.germ (κL ⁻¹ᵁ wcSgD L M a) x hx).hom ((κL.app (wcSgD L M a)).hom
          (wcLdpSec L M (wcLdpQuad L M fun p q => if q = a then h p else 0) a)) ∈
        IsLocalRing.maximalIdeal (P.presheaf.stalk x) ↔
      κL x ∉ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L)
          (H : MvPolynomial (Fin (M + 1)) L) := by
    intro x a hx
    rw [← not_iff_not, not_not, IsLocalRing.notMem_maximalIdeal, ← Scheme.mem_basicOpen P _ x hx,
      ← Scheme.preimage_basicOpen, BO a]
    exact ⟨fun h => h.2, fun h => ⟨hx, h⟩⟩
  obtain ⟨Z, g, hg, -, hrng, hst⟩ := wc_ldpi_principal_subscheme P (Fin (M + 1))
    (fun a => κL ⁻¹ᵁ wcSgD L M a) hW hcov
    (fun a => (κL.app (wcSgD L M a)).hom
      (wcLdpSec L M (wcLdpQuad L M fun p q => if q = a then h p else 0) a)) hu
  refine ⟨Z, g, hg, ?_, COVP, ?_⟩
  · ext x
    rw [hrng x]
    constructor
    · intro hall
      obtain ⟨a, ha⟩ := COVP x
      exact (GI x a ha).mp (hall a ha)
    · intro hx a ha
      exact (GI x a ha).mpr hx
  · intro z a hz
    exact ⟨(hrng (g z)).mp ⟨z, rfl⟩ a hz, (hst z a hz).1, (hst z a hz).2⟩

theorem wc_ldc_bh_smooth_of_cut (L : Type u) [Field L] {P Z : Scheme.{u}} (s : P ⟶ Spec (.of L))
    (e : ℕ) (he : 1 ≤ e) [SmoothOfRelativeDimension e s] (ιZ : Z ⟶ P) [IsClosedImmersion ιZ]
    (hloc : ∀ z : Z, ∃ f : P.presheaf.stalk (ιZ z), Function.Surjective (ιZ.stalkMap z).hom ∧
      RingHom.ker (ιZ.stalkMap z).hom = Ideal.span {f} ∧ wcLdpSubmersive L s (ιZ z) 1 f) :
    SmoothOfRelativeDimension (e - 1) (ιZ ≫ s) :=
by
  classical
  haveI : Smooth s := SmoothOfRelativeDimension.smooth e s
  haveI : LocallyOfFiniteType (ιZ ≫ s) := inferInstance
  have hcc : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (t : B ⟶ Spec (.of L)) (y : A),
      wcLdpConst L (f ≫ t) y = (f.stalkMap y).hom.comp (wcLdpConst L t (f y)) := by
    intro A B f t y
    ext c
    simp only [wcLdpConst, RingHom.comp_apply, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
    exact (Scheme.Hom.germ_stalkMap_apply f ⊤ y trivial _).symm
  apply wc_ldp_il_smooth_local (ιZ ≫ s) (e - 1)
  intro z
  obtain ⟨f, hsurj, hker, htr⟩ := hloc z
  obtain ⟨hRfs, hRfree, hRfin, hRrk, -⟩ := wc_ldp_il_stalk_of_smooth_field L s e (ιZ z)
  letI algR : Algebra L (P.presheaf.stalk (ιZ z)) := (wcLdpConst L s (ιZ z)).toAlgebra
  letI algS : Algebra L (Z.presheaf.stalk z) := (wcLdpConst L (ιZ ≫ s) z).toAlgebra
  haveI := hRfs
  haveI := hRfree
  haveI := hRfin
  obtain ⟨δ₀, hδ₀L, hδ₀E, hδ₀1⟩ :=
    wc_ldp_il_submersive_derivation L (P.presheaf.stalk (ιZ z)) 1 f htr
  have hδ₀one : δ₀ 1 = 0 := by
    have h1 := hδ₀E 1
    rwa [map_one] at h1
  have hδ₀f : δ₀ f = 1 := by
    rw [hδ₀one, map_one, one_mul, mul_zero, sub_zero] at hδ₀1
    exact hδ₀1
  let ψ : P.presheaf.stalk (ιZ z) →ₐ[L] Z.presheaf.stalk z :=
    { (ιZ.stalkMap z).hom with
      commutes' := fun c => by
        show (ιZ.stalkMap z).hom (wcLdpConst L s (ιZ z) c) = wcLdpConst L (ιZ ≫ s) z c
        rw [hcc]; rfl }
  have hker' : RingHom.ker ψ = Ideal.span {f} := by
    rw [← hker]; ext r; rw [RingHom.mem_ker, RingHom.mem_ker]; rfl
  let δS : P.presheaf.stalk (ιZ z) →+ IsLocalRing.ResidueField (Z.presheaf.stalk z) :=
    (IsLocalRing.ResidueField.map (ιZ.stalkMap z).hom).toAddMonoidHom.comp δ₀
  have hδSL : ∀ a b, δS (a * b) =
      IsLocalRing.residue _ (ψ a) * δS b + IsLocalRing.residue _ (ψ b) * δS a := by
    intro a b
    show IsLocalRing.ResidueField.map (ιZ.stalkMap z).hom (δ₀ (a * b)) =
      IsLocalRing.residue _ ((ιZ.stalkMap z).hom a) *
          IsLocalRing.ResidueField.map (ιZ.stalkMap z).hom (δ₀ b) +
        IsLocalRing.residue _ ((ιZ.stalkMap z).hom b) *
          IsLocalRing.ResidueField.map (ιZ.stalkMap z).hom (δ₀ a)
    rw [hδ₀L, map_add, map_mul, map_mul, IsLocalRing.ResidueField.map_residue,
      IsLocalRing.ResidueField.map_residue]
  have hδSE : ∀ c : L, δS (algebraMap L _ c) = 0 := fun c =>
    (congrArg (IsLocalRing.ResidueField.map (ιZ.stalkMap z).hom) (hδ₀E c)).trans (map_zero _)
  have hδSh : δS f ≠ 0 := by
    have e2 := (congrArg (IsLocalRing.ResidueField.map (ιZ.stalkMap z).hom) hδ₀f).trans
      (map_one _)
    exact e2.symm ▸ one_ne_zero
  obtain ⟨hSfs, hSfree, hSfin, hSrk⟩ :=
    wc_ldp_il_hypersurface_criterion L _ _ ψ hsurj f hker' δS hδSL hδSE hδSh
  have hrk : Module.finrank (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄L] = e - 1 := by
    omega
  exact wc_ldp_il_spread_abs L (ιZ ≫ s) (e - 1) z hSfs hSfree hSfin hrk

theorem wc_ldc_bertini_hyperplane (L₁ : Type u) [Field L₁] [Finite L₁] (W : Scheme.{u})
    (w : W ⟶ Spec (.of L₁)) [IsProper w] [GeometricallyIrreducible w] (e : ℕ)
    [SmoothOfRelativeDimension e w] (he : 1 ≤ e) (M : ℕ) (κ : W ⟶ wcProjK L₁ M)
    (hκ : IsClosedImmersion κ) (hκw : κ ≫ wcProjKStr L₁ M = w) :
    ∃ (L : Type u) (_ : Field L) (_ : Finite L) (_ : Algebra L₁ L)
      (H : MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L 1)
      (κL : Limits.pullback w (Spec.map (CommRingCat.ofHom (algebraMap L₁ L))) ⟶ wcProjK L M)
      (Z : Scheme.{u})
      (ιZ : Z ⟶ Limits.pullback w (Spec.map (CommRingCat.ofHom (algebraMap L₁ L)))),
      IsClosedImmersion κL ∧
      κL ≫ wcProjKStr L M =
        Limits.pullback.snd w (Spec.map (CommRingCat.ofHom (algebraMap L₁ L))) ∧
      IsClosedImmersion ιZ ∧
      Set.range ιZ = {x | κL x ∉ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L) MvPolynomial.gradedAlgebra
        (H : MvPolynomial (Fin (M + 1)) L)} ∧
      SmoothOfRelativeDimension (e - 1)
        (ιZ ≫ Limits.pullback.snd w (Spec.map (CommRingCat.ofHom (algebraMap L₁ L)))) :=
by
  classical

  obtain ⟨jK, hjK, hjKs, hall⟩ :=
    wc_ldp_dgp_embed L₁ (AlgebraicClosure L₁) (Over.mk w) M κ hκ hκw

  haveI hgiΩ : GeometricallyIrreducible (Limits.pullback.snd (Over.mk w).hom
      (Spec.map (CommRingCat.ofHom (algebraMap L₁ (AlgebraicClosure L₁))))) :=
    MorphismProperty.of_isPullback (P := @GeometricallyIrreducible)
      (IsPullback.of_hasPullback _ _) (show GeometricallyIrreducible w from inferInstance)
  haveI hsmΩ : SmoothOfRelativeDimension e (Limits.pullback.snd (Over.mk w).hom
      (Spec.map (CommRingCat.ofHom (algebraMap L₁ (AlgebraicClosure L₁))))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension e)
      (IsPullback.of_hasPullback _ _) (show SmoothOfRelativeDimension e w from inferInstance)
  haveI hgiΩ' : GeometricallyIrreducible (Over.mk (Limits.pullback.snd (Over.mk w).hom
      (Spec.map (CommRingCat.ofHom (algebraMap L₁ (AlgebraicClosure L₁)))))).hom := hgiΩ
  haveI hsmΩ' : SmoothOfRelativeDimension e (Over.mk (Limits.pullback.snd (Over.mk w).hom
      (Spec.map (CommRingCat.ofHom (algebraMap L₁ (AlgebraicClosure L₁)))))).hom := hsmΩ

  obtain ⟨Ψ, hΨ, hgood⟩ := wc_ldc_bh_bertini_closed (AlgebraicClosure L₁) M e
    (Over.mk (Limits.pullback.snd (Over.mk w).hom
      (Spec.map (CommRingCat.ofHom (algebraMap L₁ (AlgebraicClosure L₁)))))) jK hjK hjKs

  obtain ⟨L, hLfin, h, hh⟩ := wc_ldc_bh_finite_subfield L₁ M Ψ hΨ

  have hHmem : (∑ p, MvPolynomial.C (h p) * MvPolynomial.X p : MvPolynomial (Fin (M + 1)) L) ∈
      MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L 1 := by
    refine Submodule.sum_mem _ (fun p _ => ?_)
    rw [MvPolynomial.mem_homogeneousSubmodule]
    simpa using (MvPolynomial.isHomogeneous_C (Fin (M + 1)) (h p)).mul
      (MvPolynomial.isHomogeneous_X L p)
  let H : MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L 1 := ⟨_, hHmem⟩

  have hmapQ : ∀ a : Fin (M + 1), wcLdpMapQ L (AlgebraicClosure L₁) M
      (wcLdpQuad L M fun p q => if q = a then h p else 0) =
      wcLdpQuad (AlgebraicClosure L₁) M
        (fun p q => if q = a then (h p : AlgebraicClosure L₁) else 0) := by
    intro a
    apply Subtype.ext
    simp only [wcLdpMapQ, wcLdpQuad, map_sum, map_mul, MvPolynomial.map_C, MvPolynomial.map_X]
    refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => ?_))
    split_ifs <;> simp

  have hallΩ := wc_ldc_bh_all_points (AlgebraicClosure L₁) M e
    (Limits.pullback.snd (Over.mk w).hom
      (Spec.map (CommRingCat.ofHom (algebraMap L₁ (AlgebraicClosure L₁))))) jK
    (fun a => wcLdpQuad (AlgebraicClosure L₁) M
      (fun p q => if q = a then (h p : AlgebraicClosure L₁) else 0))
    (hgood (fun i => (h i : AlgebraicClosure L₁)) hh)

  obtain ⟨jE, hjE, hjEs, hiff, hgerm⟩ := hall L
  have htrans := wc_ldc_bh_descend L₁ L (AlgebraicClosure L₁) (Over.mk w) M jK jE hiff hgerm
    (fun a => wcLdpQuad L M fun p q => if q = a then h p else 0)
    (by
      intro x a hx hm
      rw [hmapQ a] at hm ⊢
      exact hallΩ x a hx hm)

  obtain ⟨Z, ιZ, hιZ, hrange, hcov, hst⟩ := wc_ldc_bh_cut L M _ jE hjE h H rfl

  haveI : SmoothOfRelativeDimension e (Limits.pullback.snd (Over.mk w).hom
      (Spec.map (CommRingCat.ofHom (algebraMap L₁ L)))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension e)
      (IsPullback.of_hasPullback _ _) (show SmoothOfRelativeDimension e w from inferInstance)
  haveI := hιZ
  have hsm := wc_ldc_bh_smooth_of_cut L (Limits.pullback.snd (Over.mk w).hom
      (Spec.map (CommRingCat.ofHom (algebraMap L₁ L)))) e he ιZ (fun z => by
    obtain ⟨a, ha⟩ := hcov (ιZ z)
    obtain ⟨hm, hsurj, hker⟩ := hst z a ha
    exact ⟨_, hsurj, hker, htrans (ιZ z) a ha hm⟩)

  exact ⟨L, inferInstance, hLfin, inferInstance, H, jE, Z, ιZ, hjE, hjEs, hιZ, hrange, hsm⟩

theorem wc_ldc_hyperplane_section_gi (L : Type u) [Field L] (W : Scheme.{u})
    (w : W ⟶ Spec (.of L)) [GeometricallyIrreducible w] [IsProper w] (e : ℕ)
    [SmoothOfRelativeDimension e w] (he : 2 ≤ e) (M : ℕ) (κ : W ⟶ wcProjK L M)
    (hκ : IsClosedImmersion κ) (hκw : κ ≫ wcProjKStr L M = w)
    (H : MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L 1) (Z : Scheme.{u}) (ιZ : Z ⟶ W)
    (hιZ : IsClosedImmersion ιZ)
    (hrange : Set.range ιZ = {x | κ x ∉ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) L) MvPolynomial.gradedAlgebra
      (H : MvPolynomial (Fin (M + 1)) L)})
    [Smooth (ιZ ≫ w)] :
    GeometricallyIrreducible (ιZ ≫ w) :=
by
  classical

  have s1gen : ∀ {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ)
      [GradedRing 𝒜] (f : A) (hf : f ∈ 𝒜 1) (g : A) (hg : g ∈ 𝒜 (2 • 1)) (p : Proj 𝒜)
      (hp : p ∈ Proj.basicOpen 𝒜 f),
      IsUnit (((Proj 𝒜).presheaf.germ (Proj.basicOpen 𝒜 f) p hp).hom
        ((Proj.awayToSection 𝒜 f).hom (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg))) ↔
      p ∈ Proj.basicOpen 𝒜 g := by
    intro A σ _ _ _ 𝒜 _ f hf g hg p hp
    have key := ProjectiveSpectrum.Proj.awayToSection_germ 𝒜 f p hp
    have key2 := congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg)) key
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at key2
    change IsUnit (((ProjectiveSpectrum.Proj.structureSheaf 𝒜).presheaf.germ
      (ProjectiveSpectrum.basicOpen 𝒜 f) p hp).hom
      ((ProjectiveSpectrum.Proj.awayToSection 𝒜 f).hom
        (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg))) ↔ _
    rw [key2, Proj.mem_basicOpen]
    constructor
    · intro h
      have h3 := (Proj.stalkIso' 𝒜 p).toRingHom.isUnit_map h
      simp at h3
      rw [← HomogeneousLocalization.isUnit_iff_isUnit_val] at h3
      simp only [HomogeneousLocalization.mapId, HomogeneousLocalization.Away.mk] at h3
      erw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk, Localization.mk_eq_mk',
        IsLocalization.AtPrime.isUnit_mk'_iff] at h3
      exact h3
    · intro h
      apply (Proj.stalkIso' 𝒜 p).symm.toRingHom.isUnit_map
      rw [← HomogeneousLocalization.isUnit_iff_isUnit_val]
      simp only [CommRingCat.hom_ofHom, HomogeneousLocalization.mapId,
        HomogeneousLocalization.Away.mk]
      erw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk, Localization.mk_eq_mk',
        IsLocalization.AtPrime.isUnit_mk'_iff]
      exact h

  have s5 : ∀ (K : Type u) [Field K] (N : ℕ) (X : Scheme.{u}) (κ : X ⟶ wcProjK K N)
      (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2) (x : X),
      wcLdpZero K N κ G x ↔ κ x ∉ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) MvPolynomial.gradedAlgebra
        (G : MvPolynomial (Fin (N + 1)) K) := by
    intro K _ N X κ G x
    have hunit : ∀ (a : Fin (N + 1)) (hx : x ∈ κ ⁻¹ᵁ wcSgD K N a),
        IsUnit (wcLdpGerm K N κ G a x hx) ↔ κ x ∈ @Proj.basicOpen _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) MvPolynomial.gradedAlgebra
          (G : MvPolynomial (Fin (N + 1)) K) := by
      intro a hx
      have heq := Scheme.Hom.germ_stalkMap_apply κ (wcSgD K N a) x hx (wcLdpSec K N G a)
      have e1 : IsUnit (wcLdpGerm K N κ G a x hx) ↔
          IsUnit ((κ.stalkMap x).hom (((wcProjK K N).presheaf.germ (wcSgD K N a) (κ x) hx).hom
            (wcLdpSec K N G a))) := Iff.of_eq (congrArg IsUnit heq).symm
      refine (e1.trans (isUnit_map_iff (κ.stalkMap x).hom _)).trans ?_
      exact @s1gen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        MvPolynomial.gradedAlgebra (MvPolynomial.X a)
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a))
        (G : MvPolynomial (Fin (N + 1)) K) G.2 (κ x) hx
    have hcov : ∃ a : Fin (N + 1), x ∈ κ ⁻¹ᵁ wcSgD K N a := by
      have hY : (⨆ j : Fin (N + 1), @Proj.basicOpen _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) MvPolynomial.gradedAlgebra
          (MvPolynomial.X j)) = ⊤ := by
        apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
        intro a ha
        have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
        have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
          rw [← MvPolynomial.decomposition.decompose'_apply]
          exact ha'
        rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
        rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
        intro m hm
        have hm0 : m ≠ 0 := by
          rintro rfl
          exact (MvPolynomial.mem_support_iff.mp hm) h0
        obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
        exact ⟨l, Set.mem_univ _, hl⟩
      have hx : κ x ∈ (⨆ j : Fin (N + 1), @Proj.basicOpen _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) MvPolynomial.gradedAlgebra
          (MvPolynomial.X j)) := by
        rw [hY]; trivial
      obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
      exact ⟨j, hj⟩
    constructor
    · intro hz hD
      obtain ⟨a, ha⟩ := hcov
      exact (IsLocalRing.notMem_maximalIdeal.mpr ((hunit a ha).mpr hD)) (hz a ha)
    · intro hD a ha
      by_contra hn
      exact hD ((hunit a ha).mp (IsLocalRing.notMem_maximalIdeal.mp hn))

  have PB : ∀ (N : ℕ) (F F' : Type u) [Field F] [Field F'] [Algebra F F'],
      IsPullback (wcLdpProjMap F F' N) (wcProjKStr F' N) (wcProjKStr F N)
        (Spec.map (CommRingCat.ofHom (algebraMap F F'))) := by
    intro N
    have s6 : ∀ {W X Y Z : Scheme.{u}} (φ : W ⟶ X) (p' : W ⟶ Y) (p : X ⟶ Z) (g : Y ⟶ Z) {ι : Type}
        (U U' : ι → Scheme.{u}) (j : ∀ i, U i ⟶ X) (j' : ∀ i, U' i ⟶ W) (φi : ∀ i, U' i ⟶ U i)
        [∀ i, IsOpenImmersion (j i)] [∀ i, IsOpenImmersion (j' i)],
        (⨆ i, (j i).opensRange) = ⊤ → (∀ i, j' i ≫ φ = φi i ≫ j i) →
        (∀ i, φ ⁻¹ᵁ (j i).opensRange = (j' i).opensRange) →
        (∀ i, IsPullback (φi i) (j' i ≫ p') (j i ≫ p) g) → IsPullback φ p' p g := by
      intro W X Y Z φ p' p g ι U U' j j' φi hjI hj'I hcov hcomm hpre hpb
      have hc : ∀ x : X, ∃ i y, j i y = x := by
        intro x
        have hx : x ∈ (⨆ i, (j i).opensRange) := by rw [hcov]; trivial
        obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
        obtain ⟨y, hy⟩ := Scheme.Hom.mem_opensRange.mp hi
        exact ⟨i, y, hy⟩
      refine Scheme.isPullback_of_openCover φ p' p g
        (Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) ι U j hc) ?_
      intro i
      have Q := (@IsOpenImmersion.isPullback _ _ _ _ (φi i) (j' i) (j i) φ (hj'I i) (hjI i)
        (hcomm i) (hpre i)).flip
      refine IsPullback.of_iso (hpb i) Q.isoPullback (Iso.refl _) (Iso.refl _) (Iso.refl _)
        ?_ ?_ ?_ ?_
      · show φi i ≫ 𝟙 _ = Q.isoPullback.hom ≫ Limits.pullback.snd φ (j i)
        rw [Category.comp_id, IsPullback.isoPullback_hom_snd]
      · show (j' i ≫ p') ≫ 𝟙 _ = Q.isoPullback.hom ≫ (Limits.pullback.fst φ (j i) ≫ p')
        rw [Category.comp_id, ← Category.assoc, IsPullback.isoPullback_hom_fst]
      · show (j i ≫ p) ≫ 𝟙 _ = 𝟙 _ ≫ (j i ≫ p)
        rw [Category.comp_id, Category.id_comp]
      · show g ≫ 𝟙 _ = 𝟙 _ ≫ g
        rw [Category.comp_id, Category.id_comp]
    intro F F' _ _ _
    have s2 : ∀ (K : Type u) [Field K] (a : Fin (N + 1)),
        letI := (MvPolynomial.gradedAlgebra :
          GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K));
        ∀ (s : MvPolynomial (Fin (N + 1)) K), s = MvPolynomial.X a →
        ∃ e : MvPolynomial (Fin N) K ≃+*
          HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) s,
        (∀ c : K, e (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers s)
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)) ∧
        ∀ j : Fin N, (e (MvPolynomial.X j)).val =
          Localization.mk (MvPolynomial.X (a.succAbove j)) ⟨s, Submonoid.mem_powers s⟩ := by
      intro K _ a
      letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))
      intro s hs
      subst hs
      have scale : ∀ {S : Type u} [CommRing S] (φ : K →+* S) (x : Fin (N + 1) → S) (t : S) (n : ℕ)
          (F : MvPolynomial (Fin (N + 1)) K), F.IsHomogeneous n →
          MvPolynomial.eval₂ φ (fun j => t * x j) F = t ^ n * MvPolynomial.eval₂ φ x F := by
        intro S _ φ x t n F hF
        conv_lhs => rw [F.as_sum]
        conv_rhs => rw [F.as_sum]
        rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun d hd => ?_)
        have hdeg : Finsupp.degree d = n := by
          by_contra h
          exact (MvPolynomial.mem_support_iff.mp hd) (hF.coeff_eq_zero h)
        rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
        have hp : (d.prod fun i e => (t * x i) ^ e) = t ^ n * d.prod fun i e => x i ^ e := by
          simp only [mul_pow]
          rw [Finsupp.prod_mul]
          congr 1
          rw [← hdeg, Finsupp.degree_apply]
          unfold Finsupp.prod
          rw [Finset.prod_pow_eq_pow_sum]
        rw [hp]
        ring
      have hX : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X K a)
      have hg : ∀ i : Fin N, (MvPolynomial.X (a.succAbove i) : MvPolynomial (Fin (N + 1)) K) ∈
