      IsClosed ({s (IsLocalRing.closedPoint K)} : Set P) ∧
      ∀ y : ↥(Limits.pullback p (Spec.map (CommRingCat.ofHom (algebraMap K L)))),
        Limits.pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap K L))) y =
          s (IsLocalRing.closedPoint K) →
        IsClosed ({y} : Set ↥(Limits.pullback p (Spec.map (CommRingCat.ofHom (algebraMap K L))))) := by
