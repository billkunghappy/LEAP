      rfl
    have hloc : wcLdpIncLocal E N X ι G₀ G₁ Yt g := by
      intro z a ha e he
      have hz : g z ∈ wcLdpW E N X ι (a, e) := ⟨ha, he⟩
      obtain ⟨hs, hk⟩ := hgstalk z (a, e) hz
      refine ⟨hs, ?_⟩
      rw [hk, hgerm (g z) (a, e) hz]
    obtain ⟨V, hV, hiso⟩ := wc_ldpi_offaxis_iso E N X ι hι hιX G₀ G₁ Z g hgc hgsec
    haveI := hiso
    refine ⟨Yt, g, ⟨hgc, hgsec, hgrange, hgstalk⟩, hgc, rfl, ?_, ?_, ⟨V, hV, hiso⟩, hloc,
      ?_, ?_, ?_, ?_⟩
    · show IsProper (g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom)
      infer_instance
    · refine ⟨fun x => ?_⟩
      by_cases hx : wcLdpOnAxis E N ι G₀ G₁ x
      · obtain ⟨pt, -, -⟩ := wc_pp_rational_point E 1
        have hq : X.hom x = wcProjKStr E 1 (pt (IsLocalRing.closedPoint E)) :=
          Subsingleton.elim _ _
        obtain ⟨p, hp1, -⟩ := Scheme.Pullback.exists_preimage_pullback x _ hq
        subst hp1
        have hmap : ∀ y ∈ IsLocalRing.maximalIdeal
            (X.left.presheaf.stalk (Limits.pullback.fst X.hom (wcProjKStr E 1) p)),
            ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap p).hom y ∈
              IsLocalRing.maximalIdeal
                ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.stalk p) :=
          fun y hy => (map_mem_nonunits_iff _ y).mpr hy
        have hpr : p ∈ Set.range g := by
          refine (hgrange p).2 (fun i hi => ?_)
          rw [hgerm p i hi]
          have hk : ∀ k : Fin 2, wcLdpGerm E N ι (![G₀, G₁] k) i.1
              (Limits.pullback.fst X.hom (wcProjKStr E 1) p) hi.1 ∈
              IsLocalRing.maximalIdeal
                (X.left.presheaf.stalk (Limits.pullback.fst X.hom (wcProjKStr E 1) p)) :=
            Fin.forall_fin_two.mpr ⟨(hx i.1 hi.1).1, (hx i.1 hi.1).2⟩
          exact Ideal.sub_mem _ (hmap _ (hk _)) (Ideal.mul_mem_left _ _ (hmap _ (hk _)))
        obtain ⟨z, hz⟩ := hpr
        refine ⟨z, ?_⟩
        rw [Scheme.Hom.comp_apply, hz]
      · have hxV : x ∈ V := (hV x).2 hx
        obtain ⟨z, hz⟩ :=
          ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ∣_ V).surjective ⟨x, hxV⟩
        refine ⟨z.1, ?_⟩
        have h1 := morphismRestrict_base_coe (g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) V z
        rw [hz] at h1
        exact h1.symm
    · intro y hy
      have hr : Set.range y ⊆ Set.range V.ι := by
        rw [Scheme.Opens.range_ι]
        rintro _ ⟨s, rfl⟩
        have hs : s = IsLocalRing.closedPoint E := Subsingleton.elim _ _
        subst hs
        exact (hV _).2 hy
      refine ⟨IsOpenImmersion.lift V.ι y hr ≫
        inv ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ∣_ V) ≫
        ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ⁻¹ᵁ V).ι, ?_⟩
      have e1 : ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ⁻¹ᵁ V).ι ≫ g ≫
          Limits.pullback.fst X.hom (wcProjKStr E 1) =
          (g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ∣_ V ≫ V.ι := by
        rw [← Category.assoc]
        exact (morphismRestrict_ι _ _).symm
      simp only [Category.assoc, e1, IsIso.inv_hom_id_assoc, IsOpenImmersion.lift_fac]
    · intro w w' c c' _ _
      exact wc_ldpi_rational_criterion E N X ι hι hιX G₀ G₁ Yt g hgc hloc w w' c c'
    · exact wc_ldpi_fibre_homeo E N X ι hι hιX G₀ G₁ Z g hgc hgrange
    · obtain ⟨M, σ, hσ, hσstr⟩ := wc_segre_proj_closed_immersion E N 1
