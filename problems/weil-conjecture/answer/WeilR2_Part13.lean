theorem wc_ldnm_di_bc_disc (E Ω : Type u) [Field E] [Field Ω] [Algebra E Ω] (N n : ℕ)
    (hn : 1 ≤ n) (X : Over (Spec (.of E))) [SmoothOfRelativeDimension n X.hom]
    (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr E N = X.hom)
    (XΩ : Over (Spec (.of Ω))) [SmoothOfRelativeDimension n XΩ.hom] (q : XΩ.left ⟶ X.left)
    (hq : IsPullback q XΩ.hom X.hom (Spec.map (CommRingCat.ofHom (algebraMap E Ω))))
    (ιΩ : XΩ.left ⟶ wcProjK Ω N) (hιΩ : IsClosedImmersion ιΩ)
    (hιΩX : ιΩ ≫ wcProjKStr Ω N = XΩ.hom) (hιq : ιΩ ≫ wcLdpProjMap E Ω N = q ≫ ι)
