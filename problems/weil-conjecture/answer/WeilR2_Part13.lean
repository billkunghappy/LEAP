          hι (inferInstance : IsClosedImmersion (𝟙 (wcProjK E 1))) hιX.symm
          (Category.id_comp _).symm, by rw [Limits.pullback.map]; exact Limits.pullback.lift_fst _ _ _⟩
      haveI := hm
      haveI := hσ
      refine ⟨M, g ≫ m ≫ σ, inferInstance, ?_⟩
      show (g ≫ m ≫ σ) ≫ wcProjKStr E M = g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom
