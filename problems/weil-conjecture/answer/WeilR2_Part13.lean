      · calc q ≫ (φ l ≫ fm) ≫ ei = (q ≫ φ l ≫ fm) ≫ ei := by simp only [Category.assoc]
          _ = inv ι ≫ vm ≫ wm ≫ ei := by
              rw [hcq]; simp only [Category.assoc]
          _ = inv ι ≫ (vm ≫ (W''.obj m).right.hom) ≫ π i := by
              rw [hsqm]; simp only [Category.assoc]
          _ = (q ≫ G) ≫ π i := by rw [hvmv, g2, Category.assoc]
          _ = q ≫ G ≫ π i := Category.assoc _ _ _
    refine ⟨hpb.lift (φ l ≫ fm) G hsq2, hpb.lift_snd _ _ _, ?_⟩
    rw [← hvm]
    apply hpb.hom_ext
    · simp only [Category.assoc, IsPullback.lift_fst]
      exact hcq
    · simp only [Category.assoc, IsPullback.lift_snd]
      first
        | exact g2.trans ((congrArg (inv ι ≫ ·) hvmv).symm.trans (Category.assoc _ _ _).symm)
        | exact g2.trans (congrArg (inv ι ≫ ·) hvmv).symm
  choose z hz1 hz2 using hzleg
  have hzc : ∀ {m m₁ : Λ'} (t : m ⟶ m₁), z m ≫ (W''.map t).right.left = z m₁ := by
    intro m m₁ t
