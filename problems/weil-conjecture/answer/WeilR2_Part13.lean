theorem wc_tube_A1C_proetale_presentation : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A] (sA : Spec (.of A) ⟶ Spec (.of K)) (x : Spec (.of (Polynomial A))) (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (Polynomial A))) x)) (Scheme.Etale.forget (Spec (.of (Polynomial A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (Polynomial A))), wcHalShData x B Λ W' φ a → ∀ (C : Type u) [CommRing C] (c : Spec (.of C) ⟶ Spec (.of A)), ∃ (ρ : Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c ⟶ wcHalA1 (c ≫ sA)) (Λ₀ : Type u) (_ : SmallCategory Λ₀) (_ : IsCofiltered Λ₀) (D : Λ₀ ⥤ (wcHalA1 (c ≫ sA)).Etale) (π : ∀ l, Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c ⟶ (D.obj l).left), ρ ≫ wcHalA1Proj (c ≫ sA) = Limits.pullback.snd (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c ∧ (∀ l, π l ≫ (D.obj l).hom = ρ) ∧ (∀ {l l' : Λ₀} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') ∧ (∀ (T : Scheme.{u}) (w : ∀ l, T ⟶ (D.obj l).left), (∀ {l l' : Λ₀} (t : l ⟶ l'), w l ≫ (D.map t).left = w l') → ∃! w₀ : T ⟶ Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c, ∀ l, w₀ ≫ π l = w l) ∧ (∀ l, IsAffine (D.obj l).left) ∧ (∀ {l l' : Λ₀} (t : l ⟶ l'), IsAffineHom (D.map t).left) :=
by
  intro K _ A _ sA x B _ _ Λ _ _ W' φ a hd C _ c
  unfold wcHalShData at hd
  obtain ⟨_hinit, haffW, hφ, hφa, hlim, _⟩ := hd

  have LC : ∀ {X' Y' : Scheme.{u}} (h : X' ⟶ Y') (A : Type u) [CommRing A] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W : Λ ⥤ Y'.Etale) (φ : ∀ l, Spec (.of A) ⟶ (W.obj l).left) (a : Spec (.of A) ⟶ Y'), (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W.map t).left = φ l') → (∀ l, φ l ≫ (W.obj l).hom = a) → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (W.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (W.map t).left = z l') → ∃! z₀ : T ⟶ Spec (.of A), ∀ l, z₀ ≫ φ l = z l) → ∀ (XZ : Scheme.{u}) (p : XZ ⟶ X') (hZ : XZ ⟶ Spec (.of A)), IsPullback p hZ h a → ∃ π : ∀ l, XZ ⟶ ((W ⋙ wcEtBaseChange h).obj l).left, (∀ l, π l ≫ ((W ⋙ wcEtBaseChange h).obj l).hom = p) ∧ (∀ l, π l ≫ Limits.pullback.fst (W.obj l).hom h = hZ ≫ φ l) ∧ (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ ((W ⋙ wcEtBaseChange h).map t).left = π l') ∧ ∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ ((W ⋙ wcEtBaseChange h).obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ ((W ⋙ wcEtBaseChange h).map t).left = z l') → ∃! z₀ : T ⟶ XZ, ∀ l, z₀ ≫ π l = z l := by
    intro X' Y' h A _ Λ _ _ W φ a hφ hφa hlim XZ p hZ hpb
    have M1 : ∀ {l l' : Λ} (t : l ⟶ l'),
        ((W ⋙ wcEtBaseChange h).map t).left ≫ Limits.pullback.fst (W.obj l').hom h =
          Limits.pullback.fst (W.obj l).hom h ≫ (W.map t).left := by
      intro l l' t
      exact Limits.pullback.lift_fst _ _ _
    have M2 : ∀ {l l' : Λ} (t : l ⟶ l'),
        ((W ⋙ wcEtBaseChange h).map t).left ≫ Limits.pullback.snd (W.obj l').hom h =
          Limits.pullback.snd (W.obj l).hom h := by
      intro l l' t
      exact Limits.pullback.lift_snd _ _ _
    have hw : p ≫ h = hZ ≫ a := hpb.w
    have wl : ∀ l, (hZ ≫ φ l) ≫ (W.obj l).hom = p ≫ h := by
      intro l
      rw [Category.assoc, hφa l, hw]
    let π : ∀ l, XZ ⟶ ((W ⋙ wcEtBaseChange h).obj l).left := fun l =>
      Limits.pullback.lift (hZ ≫ φ l) p (wl l)
    have P1 : ∀ l, π l ≫ Limits.pullback.fst (W.obj l).hom h = hZ ≫ φ l := fun l =>
      Limits.pullback.lift_fst _ _ _
    have P2 : ∀ l, π l ≫ Limits.pullback.snd (W.obj l).hom h = p := fun l =>
      Limits.pullback.lift_snd _ _ _
    have C2 : ∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ ((W ⋙ wcEtBaseChange h).map t).left = π l' := by
      intro l l' t
      refine Limits.pullback.hom_ext (f := (W.obj l').hom) (g := h) ?_ ?_
      · calc (π l ≫ ((W ⋙ wcEtBaseChange h).map t).left) ≫ Limits.pullback.fst (W.obj l').hom h
            = π l ≫ (((W ⋙ wcEtBaseChange h).map t).left ≫
                Limits.pullback.fst (W.obj l').hom h) := Category.assoc _ _ _
          _ = π l ≫ (Limits.pullback.fst (W.obj l).hom h ≫ (W.map t).left) := whisker_eq _ (M1 t)
          _ = (π l ≫ Limits.pullback.fst (W.obj l).hom h) ≫ (W.map t).left :=
              (Category.assoc _ _ _).symm
          _ = (hZ ≫ φ l) ≫ (W.map t).left := eq_whisker (P1 l) _
          _ = hZ ≫ φ l' := by rw [Category.assoc, hφ t]
          _ = π l' ≫ Limits.pullback.fst (W.obj l').hom h := (P1 l').symm
      · calc (π l ≫ ((W ⋙ wcEtBaseChange h).map t).left) ≫ Limits.pullback.snd (W.obj l').hom h
            = π l ≫ (((W ⋙ wcEtBaseChange h).map t).left ≫
                Limits.pullback.snd (W.obj l').hom h) := Category.assoc _ _ _
          _ = π l ≫ Limits.pullback.snd (W.obj l).hom h := whisker_eq _ (M2 t)
          _ = p := P2 l
          _ = π l' ≫ Limits.pullback.snd (W.obj l').hom h := (P2 l').symm
    have C3 : ∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ ((W ⋙ wcEtBaseChange h).obj l).left),
        (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ ((W ⋙ wcEtBaseChange h).map t).left = z l') →
        ∃! z₀ : T ⟶ XZ, ∀ l, z₀ ≫ π l = z l := by
      intro T z hz
      have hs : ∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ Limits.pullback.snd (W.obj l).hom h =
          z l' ≫ Limits.pullback.snd (W.obj l').hom h := by
        intro l l' t
        calc z l ≫ Limits.pullback.snd (W.obj l).hom h
            = z l ≫ (((W ⋙ wcEtBaseChange h).map t).left ≫
                Limits.pullback.snd (W.obj l').hom h) := (whisker_eq _ (M2 t)).symm
          _ = (z l ≫ ((W ⋙ wcEtBaseChange h).map t).left) ≫
                Limits.pullback.snd (W.obj l').hom h := (Category.assoc _ _ _).symm
          _ = z l' ≫ Limits.pullback.snd (W.obj l').hom h := eq_whisker (hz t) _
      obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
      have hX : ∀ l, z l ≫ Limits.pullback.snd (W.obj l).hom h =
          z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h := fun l =>
        (hs (IsCofiltered.minToLeft l l₀)).symm.trans (hs (IsCofiltered.minToRight l l₀))
      have hf : ∀ {l l' : Λ} (t : l ⟶ l'), (z l ≫ Limits.pullback.fst (W.obj l).hom h) ≫
          (W.map t).left = z l' ≫ Limits.pullback.fst (W.obj l').hom h := by
        intro l l' t
        calc (z l ≫ Limits.pullback.fst (W.obj l).hom h) ≫ (W.map t).left
            = z l ≫ (Limits.pullback.fst (W.obj l).hom h ≫ (W.map t).left) := Category.assoc _ _ _
          _ = z l ≫ (((W ⋙ wcEtBaseChange h).map t).left ≫
                Limits.pullback.fst (W.obj l').hom h) := whisker_eq _ (M1 t).symm
          _ = (z l ≫ ((W ⋙ wcEtBaseChange h).map t).left) ≫
                Limits.pullback.fst (W.obj l').hom h := (Category.assoc _ _ _).symm
          _ = z l' ≫ Limits.pullback.fst (W.obj l').hom h := eq_whisker (hz t) _
      obtain ⟨y, hy, hyu⟩ := hlim T (fun l => z l ≫ Limits.pullback.fst (W.obj l).hom h) hf
      have hy' : ∀ l, y ≫ φ l = z l ≫ Limits.pullback.fst (W.obj l).hom h := hy
      have hxy : (z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h) ≫ h = y ≫ a := by
        calc (z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h) ≫ h
            = z l₀ ≫ (Limits.pullback.snd (W.obj l₀).hom h ≫ h) := Category.assoc _ _ _
          _ = z l₀ ≫ (Limits.pullback.fst (W.obj l₀).hom h ≫ (W.obj l₀).hom) :=
              whisker_eq _ Limits.pullback.condition.symm
          _ = (z l₀ ≫ Limits.pullback.fst (W.obj l₀).hom h) ≫ (W.obj l₀).hom :=
              (Category.assoc _ _ _).symm
          _ = (y ≫ φ l₀) ≫ (W.obj l₀).hom := eq_whisker (hy' l₀).symm _
          _ = y ≫ a := by rw [Category.assoc, hφa l₀]
      obtain ⟨z₀, hz₀p, hz₀Z⟩ : ∃ z₀ : T ⟶ XZ,
          z₀ ≫ p = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h ∧ z₀ ≫ hZ = y :=
        ⟨hpb.lift _ y hxy, hpb.lift_fst _ _ _, hpb.lift_snd _ _ _⟩
      refine ⟨z₀, fun l => ?_, fun z' hz' => ?_⟩
      · refine Limits.pullback.hom_ext (f := (W.obj l).hom) (g := h) ?_ ?_
        · calc (z₀ ≫ π l) ≫ Limits.pullback.fst (W.obj l).hom h
              = z₀ ≫ (π l ≫ Limits.pullback.fst (W.obj l).hom h) := Category.assoc _ _ _
            _ = z₀ ≫ (hZ ≫ φ l) := whisker_eq _ (P1 l)
            _ = (z₀ ≫ hZ) ≫ φ l := (Category.assoc _ _ _).symm
            _ = y ≫ φ l := eq_whisker hz₀Z _
            _ = z l ≫ Limits.pullback.fst (W.obj l).hom h := hy' l
        · calc (z₀ ≫ π l) ≫ Limits.pullback.snd (W.obj l).hom h
              = z₀ ≫ (π l ≫ Limits.pullback.snd (W.obj l).hom h) := Category.assoc _ _ _
            _ = z₀ ≫ p := whisker_eq _ (P2 l)
            _ = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h := hz₀p
            _ = z l ≫ Limits.pullback.snd (W.obj l).hom h := (hX l).symm
      · have e1 : z' ≫ p = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h := by
          calc z' ≫ p = z' ≫ (π l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h) :=
                whisker_eq _ (P2 l₀).symm
            _ = (z' ≫ π l₀) ≫ Limits.pullback.snd (W.obj l₀).hom h := (Category.assoc _ _ _).symm
            _ = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h := eq_whisker (hz' l₀) _
        have e2 : z' ≫ hZ = y := by
          apply hyu
          intro l
          calc (z' ≫ hZ) ≫ φ l = z' ≫ (hZ ≫ φ l) := Category.assoc _ _ _
            _ = z' ≫ (π l ≫ Limits.pullback.fst (W.obj l).hom h) := whisker_eq _ (P1 l).symm
            _ = (z' ≫ π l) ≫ Limits.pullback.fst (W.obj l).hom h := (Category.assoc _ _ _).symm
            _ = z l ≫ Limits.pullback.fst (W.obj l).hom h := eq_whisker (hz' l) _
        exact hpb.hom_ext (e1.trans hz₀p.symm) (e2.trans hz₀Z.symm)
    exact ⟨π, P2, P1, C2, C3⟩

  have s1 : ∃ m : Spec (.of (Polynomial A)) ⟶ Spec (.of (Polynomial K)),
      IsPullback (Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) m sA
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) := by
    letI : Algebra K A := (Spec.preimage sA).hom.toAlgebra
    letI : Algebra (Polynomial K) (Polynomial A) := Polynomial.algebra K A
    haveI : IsScalarTower K (Polynomial K) (Polynomial A) := inferInstance
    haveI : IsScalarTower K A (Polynomial A) := inferInstance
    have hpo := CommRingCat.isPushout_of_isPushout K A (Polynomial K) (Polynomial A)
    have hpb := isPullback_SpecMap_of_isPushout _ _ _ _ hpo
    have e : Spec.map (CommRingCat.ofHom (algebraMap K A)) = sA := by
      have : CommRingCat.ofHom (algebraMap K A) = Spec.preimage sA := rfl
      rw [this, Spec.map_preimage]
    rw [e] at hpb
    exact ⟨_, hpb⟩
  obtain ⟨m, sq1⟩ := s1

  have wX : (wcHalA1Proj (c ≫ sA) ≫ c) ≫ sA =
      Limits.pullback.snd (c ≫ sA) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) := by
    rw [Category.assoc]
    exact Limits.pullback.condition
  obtain ⟨h0, hh0ρ, hh0m⟩ : ∃ h0 : wcHalA1 (c ≫ sA) ⟶ Spec (.of (Polynomial A)),
      h0 ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) = wcHalA1Proj (c ≫ sA) ≫ c ∧
      h0 ≫ m = Limits.pullback.snd (c ≫ sA)
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) :=
    ⟨sq1.lift _ _ wX, sq1.lift_fst _ _ _, sq1.lift_snd _ _ _⟩
  have outerX : IsPullback (h0 ≫ m) (wcHalA1Proj (c ≫ sA))
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) (c ≫ sA) := by
    rw [hh0m]
    exact (IsPullback.of_hasPullback (c ≫ sA)
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).flip
  have sqX : IsPullback h0 (wcHalA1Proj (c ≫ sA))
      (Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c :=
    IsPullback.of_right outerX hh0ρ sq1.flip

  have wT : (Limits.pullback.fst (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c ≫ a) ≫
      Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) =
      Limits.pullback.snd (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c ≫ c := by
    rw [Category.assoc]
    exact Limits.pullback.condition
  obtain ⟨p, hp1, hp2⟩ : ∃ p : Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c ⟶ wcHalA1 (c ≫ sA),
      p ≫ h0 = Limits.pullback.fst (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c ≫ a ∧
      p ≫ wcHalA1Proj (c ≫ sA) =
        Limits.pullback.snd (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c :=
    ⟨sqX.lift _ _ wT, sqX.lift_fst _ _ _, sqX.lift_snd _ _ _⟩
  have outerT : IsPullback
      (Limits.pullback.fst (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c)
      (p ≫ wcHalA1Proj (c ≫ sA))
      (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c := by
    rw [hp2]
    exact IsPullback.of_hasPullback _ _
  have sqT : IsPullback p
      (Limits.pullback.fst (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c)
      h0 a :=
    (IsPullback.of_bot outerT hp1.symm sqX).flip

  let W := W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt (Spec (.of (Polynomial A))) x))
    (Scheme.Etale.forget (Spec (.of (Polynomial A))))
  obtain ⟨π, hπ, -, hcomp, hlimT⟩ := LC h0 B Λ W φ a (fun t => hφ t) hφa hlim _ p _ sqT

  haveI : IsAffine (wcHalA1 (c ≫ sA)) := by
    dsimp only [wcHalA1]
    infer_instance
  have haff : ∀ l, IsAffine ((W ⋙ wcEtBaseChange h0).obj l).left := by
    intro l
    have h1 : IsAffineHom (W'.obj l).right.hom :=
      @isAffineHom_of_isAffine _ _ (W'.obj l).right.hom (haffW l)
        (inferInstanceAs (IsAffine (Spec (.of (Polynomial A)))))
    have h2 : IsAffineHom (Limits.pullback.snd (W'.obj l).right.hom h0) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasPullback (W'.obj l).right.hom h0) h1
    show IsAffine (Limits.pullback (W'.obj l).right.hom h0)
    exact isAffine_of_isAffineHom (Limits.pullback.snd (W'.obj l).right.hom h0)

  refine ⟨p, Λ, inferInstance, inferInstance, W ⋙ wcEtBaseChange h0, π, hp2, hπ, hcomp, hlimT,
    haff, ?_⟩
  intro l l' t
  haveI := haff l
  haveI := haff l'
  exact isAffineHom_of_isAffine _

theorem wc_et_isIso_of_local_bijective : ∀ {B : Scheme.{u}} {F G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}} (β : F ⟶ G), (∀ (O : B.Etale) (o : O.left), ∃ (O₁ : B.Etale) (c : O₁ ⟶ O) (o₁ : O₁.left), c.left o₁ = o ∧ Function.Bijective (β.hom.app (Opposite.op O₁)).hom) → IsIso β :=
by
  intro B F G β hyp
  have cover : ∀ (V : B.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : B.Etale) (c : V₁ ⟶ V),
      S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology B V := by
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale B V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  have hinj : Sheaf.IsLocallyInjective β := by
    constructor
    intro X x y hxy
    obtain ⟨V⟩ := X
    change (β.hom.app (Opposite.op V)).hom x = (β.hom.app (Opposite.op V)).hom y at hxy
    apply cover V
    intro v
    obtain ⟨O₁, c, o₁, hc, hbij⟩ := hyp V v
    refine ⟨O₁, c, ?_, ⟨o₁, hc⟩⟩
    change (F.obj.map c.op).hom x = (F.obj.map c.op).hom y
    apply hbij.1
    have h1 : (β.hom.app (Opposite.op O₁)).hom ((F.obj.map c.op).hom x) =
        (G.obj.map c.op).hom ((β.hom.app (Opposite.op V)).hom x) :=
      congrArg (fun φ => φ.hom x) (β.hom.naturality c.op)
    have h2 : (β.hom.app (Opposite.op O₁)).hom ((F.obj.map c.op).hom y) =
        (G.obj.map c.op).hom ((β.hom.app (Opposite.op V)).hom y) :=
      congrArg (fun φ => φ.hom y) (β.hom.naturality c.op)
    rw [h1, h2, hxy]
  have hsurj : Sheaf.IsLocallySurjective β := by
    constructor
    intro V s
    apply cover V
    intro v
    obtain ⟨O₁, c, o₁, hc, hbij⟩ := hyp V v
    obtain ⟨t, ht⟩ := hbij.2 ((G.obj.map c.op).hom s)
    exact ⟨O₁, c, ⟨t, ht⟩, ⟨o₁, hc⟩⟩
  exact (Sheaf.isLocallyBijective_iff_isIso β).mp ⟨hinj, hsurj⟩

theorem wc_et_proetale_nbhd_presentation : ∀ {Z S : Scheme.{u}} [IsAffine Z] (p : Z ⟶ S) (Λ₀ : Type u) [SmallCategory Λ₀] [IsCofiltered Λ₀] (D : Λ₀ ⥤ S.Etale) (π : ∀ l, Z ⟶ (D.obj l).left), (∀ l, π l ≫ (D.obj l).hom = p) → (∀ {l l' : Λ₀} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') → (∀ (T : Scheme.{u}) (w : ∀ l, T ⟶ (D.obj l).left), (∀ {l l' : Λ₀} (t : l ⟶ l'), w l ≫ (D.map t).left = w l') → ∃! w₀ : T ⟶ Z, ∀ l, w₀ ≫ π l = w l) → (∀ l, IsAffine (D.obj l).left) → (∀ {l l' : Λ₀} (t : l ⟶ l'), IsAffineHom (D.map t).left) → ∀ (O : Z.Etale) (o : O.left), ∃ (O₁ : Z.Etale) (c : O₁ ⟶ O) (o₁ : O₁.left) (I : Type u) (_ : SmallCategory I) (_ : IsCofiltered I) (E : I ⥤ S.Etale) (πE : ∀ i, O₁.left ⟶ (E.obj i).left), c.left o₁ = o ∧ IsAffine O₁.left ∧ (∀ i, πE i ≫ (E.obj i).hom = O₁.hom ≫ p) ∧ (∀ {i i' : I} (t : i ⟶ i'), πE i ≫ (E.map t).left = πE i') ∧ (∀ (T : Scheme.{u}) (w : ∀ i, T ⟶ (E.obj i).left), (∀ {i i' : I} (t : i ⟶ i'), w i ≫ (E.map t).left = w i') → ∃! w₀ : T ⟶ O₁.left, ∀ i, w₀ ≫ πE i = w i) ∧ (∀ i, IsAffine (E.obj i).left) ∧ (∀ {i i' : I} (t : i ⟶ i'), IsAffineHom (E.map t).left) :=
by
  intro Z S _ p Λ₀ _ _ D π hπ hcomp hlim haff htr O o
  classical

  let U : Z.Etale := wcEtTop Z
  let d : O ⟶ U := MorphismProperty.Over.homMk (A := O) (B := U) O.hom (Category.comp_id _) trivial
  have hπ' : ∀ l, π l ≫ (D.obj l).hom = U.hom ≫ p := fun l =>
    (hπ l).trans (Category.id_comp p).symm

  obtain ⟨l₁, E₀, c₁, j₁, q, hE₀, hj, hjq⟩ :=
    wc_et_limit_etale_descend p U Λ₀ D π hπ' hcomp hlim htr O d o
  haveI := hE₀
  haveI := haff l₁

  haveI hEc : Etale c₁.left := by
    haveI : Etale (D.obj l₁).hom := (D.obj l₁).prop
    haveI : Etale (c₁.left ≫ (D.obj l₁).hom) := by
      rw [MorphismProperty.Over.w c₁]; exact E₀.prop
    exact Etale.of_comp c₁.left (D.obj l₁).hom
  haveI hc₁aff : IsAffineHom c₁.left := isAffineHom_of_isAffine c₁.left
  haveI hPfEt : Etale (Limits.pullback.fst (π l₁) c₁.left) := inferInstance
  haveI hPfAff : IsAffineHom (Limits.pullback.fst (π l₁) c₁.left) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback (π l₁) c₁.left).flip hc₁aff
  have hP₀aff : IsAffine (Limits.pullback (π l₁) c₁.left) :=
    isAffine_of_isAffineHom (Limits.pullback.fst (π l₁) c₁.left)

  let O₁ : Z.Etale := MorphismProperty.Over.mk ⊤ (Limits.pullback.fst (π l₁) c₁.left) hPfEt
  let c : O₁ ⟶ O := MorphismProperty.Over.homMk (A := O₁) (B := O) j₁ hj trivial

  let F : Λ₀ ⥤ Scheme.{u} :=
    { obj := fun l => (D.obj l).left
      map := fun t => (D.map t).left
      map_id := fun l => by rw [D.map_id]; rfl
      map_comp := fun f g => by rw [D.map_comp]; rfl }
  have hcF : ∀ {l l' : Λ₀} (t : l ⟶ l'), π l ≫ F.map t = π l' := fun t => hcomp t
  have hlimF : ∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ F.obj l),
      (∀ {l l' : Λ₀} (t : l ⟶ l'), z l ≫ F.map t = z l') → ∃! z₀ : T ⟶ Z, ∀ l, z₀ ≫ π l = z l :=
    fun T z hz => hlim T z hz
  have haffF : ∀ {l l' : Λ₀} (t : l ⟶ l'), IsAffineHom (F.map t) := fun t => htr t
  let cP : Limits.Cone F :=
    ⟨Z, { app := π, naturality := fun k k' t => (Category.id_comp _).trans (hcF t).symm }⟩
  have hL : Limits.IsLimit cP :=
    Limits.IsLimit.ofExistsUnique (fun s => hlimF s.pt s.π.app (fun t => s.w t))
  have hW : Limits.IsLimit (cP.whisker (Over.forget l₁)) :=
    (Functor.Initial.isLimitWhiskerEquiv (Over.forget l₁) cP).symm hL
  have hres : ∀ (W : Scheme.{u}) (a : ∀ i : Over l₁, W ⟶ F.obj i.left),
      (∀ {i i' : Over l₁} (g : i ⟶ i'), a i ≫ F.map g.left = a i') →
      ∃! z₀ : W ⟶ Z, ∀ i : Over l₁, z₀ ≫ π i.left = a i := by
    intro W a ha
    let sa : Limits.Cone (Over.forget l₁ ⋙ F) :=
      ⟨W, { app := a, naturality := fun i i' g => by simp [ha g] }⟩
    exact hW.existsUnique sa
  let Ey : Over l₁ ⥤ Scheme.{u} := Over.post F ⋙ Over.pullback c₁.left ⋙ Over.forget E₀.left
  let i₀ : Over l₁ := Over.mk (𝟙 l₁)
  let fst : ∀ i : Over l₁, Ey.obj i ⟶ F.obj i.left := fun i =>
    Limits.pullback.fst (F.map i.hom) c₁.left
  let snd : ∀ i : Over l₁, Ey.obj i ⟶ E₀.left := fun i =>
    Limits.pullback.snd (F.map i.hom) c₁.left
  have hcondE : ∀ i : Over l₁, fst i ≫ F.map i.hom = snd i ≫ c₁.left := fun i =>
    Limits.pullback.condition
  have ext : ∀ (i : Over l₁) {W : Scheme.{u}} (u v : W ⟶ Ey.obj i), u ≫ fst i = v ≫ fst i →
      u ≫ snd i = v ≫ snd i → u = v := fun i W u v h1 h2 => Limits.pullback.hom_ext h1 h2
  have F1 : ∀ {i i' : Over l₁} (g : i ⟶ i'), Ey.map g ≫ fst i' = fst i ≫ F.map g.left := by
    intro i i' g
    have h := Over.pullback_map_left c₁.left ((Over.post F).obj i) (k := (Over.post F).map g)
    refine (congrArg (· ≫ fst i') h).trans ?_
    exact Limits.pullback.lift_fst _ _ _
  have F2 : ∀ {i i' : Over l₁} (g : i ⟶ i'), Ey.map g ≫ snd i' = snd i := by
    intro i i' g
    exact Over.w ((Over.pullback c₁.left).map ((Over.post F).map g))
  have hleg : ∀ i : Over l₁, (Limits.pullback.fst (π l₁) c₁.left ≫ π i.left) ≫ F.map i.hom =
      Limits.pullback.snd (π l₁) c₁.left ≫ c₁.left := by
    intro i
    rw [Category.assoc, hcF i.hom]
    exact Limits.pullback.condition
  let leg : ∀ i : Over l₁, Limits.pullback (π l₁) c₁.left ⟶ Ey.obj i := fun i =>
    Limits.pullback.lift (Limits.pullback.fst (π l₁) c₁.left ≫ π i.left)
      (Limits.pullback.snd (π l₁) c₁.left) (hleg i)
  have leg_fst : ∀ i : Over l₁, leg i ≫ fst i = Limits.pullback.fst (π l₁) c₁.left ≫ π i.left :=
    fun i => Limits.pullback.lift_fst _ _ _
  have leg_snd : ∀ i : Over l₁, leg i ≫ snd i = Limits.pullback.snd (π l₁) c₁.left :=
    fun i => Limits.pullback.lift_snd _ _ _
  have hnat : ∀ {i i' : Over l₁} (g : i ⟶ i'), leg i ≫ Ey.map g = leg i' := by
    intro i i' g
    apply ext i'
    · rw [Category.assoc, F1 g, ← Category.assoc, leg_fst, leg_fst, Category.assoc, hcF g.left]
    · rw [Category.assoc, F2 g, leg_snd, leg_snd]
  let cc : Limits.Cone Ey := ⟨Limits.pullback (π l₁) c₁.left,
    { app := leg, naturality := fun i i' g => by
        simp only [Functor.const_obj_map]
        exact ((Category.id_comp _).trans (hnat g).symm) }⟩
  have hcc : Limits.IsLimit cc := by
    refine Limits.IsLimit.ofExistsUnique (fun s => ?_)
    let a : ∀ i : Over l₁, s.pt ⟶ F.obj i.left := fun i => s.π.app i ≫ fst i
    have ha : ∀ {i i' : Over l₁} (g : i ⟶ i'), a i ≫ F.map g.left = a i' := by
      intro i i' g
      show (s.π.app i ≫ fst i) ≫ F.map g.left = s.π.app i' ≫ fst i'
      rw [Category.assoc, ← F1 g, ← Category.assoc, s.w g]
    obtain ⟨z₀, hz₀, hz₀u⟩ := hres s.pt a ha
    let b : s.pt ⟶ E₀.left := s.π.app i₀ ≫ snd i₀
    have hb : ∀ i : Over l₁, s.π.app i ≫ snd i = b := by
      intro i
      have g : i ⟶ i₀ := Over.homMk i.hom (by simp [i₀])
      show s.π.app i ≫ snd i = s.π.app i₀ ≫ snd i₀
      rw [← s.w g, Category.assoc, F2 g]
    have hcond : z₀ ≫ π l₁ = b ≫ c₁.left := by
      have h1 : z₀ ≫ π l₁ = s.π.app i₀ ≫ fst i₀ := hz₀ i₀
      have h2 : fst i₀ ≫ F.map i₀.hom = snd i₀ ≫ c₁.left := hcondE i₀
      have h3 : F.map i₀.hom = 𝟙 (F.obj l₁) := F.map_id l₁
      rw [h3] at h2
      have h4 : fst i₀ = snd i₀ ≫ c₁.left := (Category.comp_id (fst i₀)).symm.trans h2
      show z₀ ≫ π l₁ = (s.π.app i₀ ≫ snd i₀) ≫ c₁.left
      rw [h1, Category.assoc, ← h4]
    refine ⟨Limits.pullback.lift z₀ b hcond, fun i => ?_, fun m hm => ?_⟩
    · change Limits.pullback.lift z₀ b hcond ≫ leg i = s.π.app i
      apply ext i
      · rw [Category.assoc, leg_fst, ← Category.assoc, Limits.pullback.lift_fst]
        exact hz₀ i
      · rw [Category.assoc, leg_snd, Limits.pullback.lift_snd, hb i]
    · have hm' : ∀ i, m ≫ leg i = s.π.app i := hm
      have e1 : m ≫ Limits.pullback.fst (π l₁) c₁.left = z₀ := by
        apply hz₀u
        intro i
        rw [Category.assoc, ← leg_fst i, ← Category.assoc, hm' i]
      have e2 : m ≫ Limits.pullback.snd (π l₁) c₁.left = b := by
        rw [← leg_snd i₀, ← Category.assoc, hm' i₀]
      refine Limits.pullback.hom_ext (f := π l₁) (g := c₁.left) ?_ ?_
      · rw [e1, Limits.pullback.lift_fst]
      · rw [e2, Limits.pullback.lift_snd]

  have hsndAff : ∀ i : Over l₁, IsAffineHom (snd i) := fun i =>
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback (F.map i.hom) c₁.left) (haffF i.hom)
  have hEaff : ∀ {i i' : Over l₁} (f : i ⟶ i'), IsAffineHom (Ey.map f) := by
    intro i i' f
    have big : IsPullback (Ey.map f ≫ snd i') (fst i) c₁.left (F.map f.left ≫ F.map i'.hom) := by
      rw [F2 f, ← F.map_comp, Over.w f]
      exact (IsPullback.of_hasPullback (F.map i.hom) c₁.left).flip
    have right : IsPullback (snd i') (fst i') c₁.left (F.map i'.hom) :=
      (IsPullback.of_hasPullback (F.map i'.hom) c₁.left).flip
    have sq := IsPullback.of_right big (F1 f) right
    exact MorphismProperty.of_isPullback (P := @IsAffineHom) sq.flip (haffF f.left)
  have hEyAff : ∀ i : Over l₁, IsAffine (Ey.obj i) := fun i => by
    haveI := hsndAff i
    exact isAffine_of_isAffineHom (snd i)

  have hEtW : ∀ i : Over l₁, Etale (fst i ≫ (D.obj i.left).hom) := by
    intro i
    haveI : Etale (D.obj i.left).hom := (D.obj i.left).prop
    haveI : Etale (fst i) := by
      show Etale (Limits.pullback.fst (F.map i.hom) c₁.left)
      infer_instance
    infer_instance
  have hwt : ∀ {i i' : Over l₁} (t : i ⟶ i'),
      Ey.map t ≫ fst i' ≫ (D.obj i'.left).hom = fst i ≫ (D.obj i.left).hom := by
    intro i i' t
    rw [← Category.assoc, F1 t, Category.assoc]
    exact congrArg (fst i ≫ ·) (MorphismProperty.Over.w (D.map t.left))
  let Efun : Over l₁ ⥤ S.Etale :=
    { obj := fun i => MorphismProperty.Over.mk ⊤ (fst i ≫ (D.obj i.left).hom) (hEtW i)
      map := fun {i i'} t => MorphismProperty.Over.homMk
        (A := MorphismProperty.Over.mk ⊤ (fst i ≫ (D.obj i.left).hom) (hEtW i))
        (B := MorphismProperty.Over.mk ⊤ (fst i' ≫ (D.obj i'.left).hom) (hEtW i'))
        (Ey.map t) (hwt t) trivial
      map_id := fun i => by
        apply MorphismProperty.Over.Hom.ext
        exact Ey.map_id i
      map_comp := fun f g => by
        apply MorphismProperty.Over.Hom.ext
        exact Ey.map_comp f g }

  refine ⟨O₁, c, q, Over l₁, inferInstance, IsCofiltered.over l₁, Efun, leg, hjq, hP₀aff,
    ?_, ?_, ?_, ?_, ?_⟩
  · intro i
    show leg i ≫ fst i ≫ (D.obj i.left).hom = Limits.pullback.fst (π l₁) c₁.left ≫ p
    rw [← Category.assoc, leg_fst, Category.assoc, hπ i.left]
  · intro i i' t
    exact hnat t
  · intro T w hw
    have hw' : ∀ {i i' : Over l₁} (t : i ⟶ i'), w i ≫ Ey.map t = w i' := fun t => hw t
    let s : Limits.Cone Ey :=
      { pt := T
        π := { app := w
               naturality := fun i i' t => (Category.id_comp _).trans (hw' t).symm } }
    exact hcc.existsUnique s
  · intro i
    exact hEyAff i
  · intro i i' t
    exact hEaff t

theorem wc_et_proetale_push_lc_surj_std : ∀ {S Z P P' : Scheme.{u}} (p : Z ⟶ S) (k : P ⟶ S) [IsAffineHom k] (hP : P' ⟶ Z) (kP : P' ⟶ P), IsPullback hP kP p k → ∀ (m : ℕ) (F : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (ρ : wcEtTransport p ((wcEtPush k).obj ((constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) F), wcEtTransportUniv ρ → ∀ (eG : ∀ V : S.Etale, ((wcEtPush k).obj ((constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).obj.obj (Opposite.op V) ≃+ LocallyConstant ↥(Limits.pullback V.hom k) (ZMod m)), (∀ (V V' : S.Etale) (g : V' ⟶ V) (s : ((wcEtPush k).obj ((constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).obj.obj (Opposite.op V)) (x : ↥(Limits.pullback V'.hom k)), eG V' ((((wcEtPush k).obj ((constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).obj.map g.op).hom s) x = eG V s (((wcEtBaseChange k).map g).left x)) → ∀ (eH : ∀ O : Z.Etale, ((wcEtPush hP).obj ((constantSheaf (Scheme.smallEtaleTopology P') AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).obj.obj (Opposite.op O) ≃+ LocallyConstant ↥(Limits.pullback O.hom hP) (ZMod m)) (β : F ⟶ (wcEtPush hP).obj ((constantSheaf (Scheme.smallEtaleTopology P') AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))), (∀ (V : S.Etale) (O : Z.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ p) (x : ((wcEtPush k).obj ((constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).obj.obj (Opposite.op V)) (κ : Limits.pullback O.hom hP ⟶ Limits.pullback V.hom k), κ ≫ Limits.pullback.fst V.hom k = Limits.pullback.fst O.hom hP ≫ h → κ ≫ Limits.pullback.snd V.hom k = Limits.pullback.snd O.hom hP ≫ kP → ∀ q : ↥(Limits.pullback O.hom hP), eH O ((β.hom.app (Opposite.op O)).hom (ρ.ρ V O h hh x)) q = eG V x (κ q)) → ∀ (U : Z.Etale), IsAffine U.left → ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (E : I ⥤ S.Etale) (πE : ∀ i, U.left ⟶ (E.obj i).left) (hπE : ∀ i, πE i ≫ (E.obj i).hom = U.hom ≫ p), (∀ {i i' : I} (t : i ⟶ i'), πE i ≫ (E.map t).left = πE i') → (∀ (T : Scheme.{u}) (w : ∀ i, T ⟶ (E.obj i).left), (∀ {i i' : I} (t : i ⟶ i'), w i ≫ (E.map t).left = w i') → ∃! w₀ : T ⟶ U.left, ∀ i, w₀ ≫ πE i = w i) → (∀ i, IsAffine (E.obj i).left) → (∀ {i i' : I} (t : i ⟶ i'), IsAffineHom (E.map t).left) → Function.Surjective (β.hom.app (Opposite.op U)).hom :=
by
  classical
  intro S Z P P' p k _ hP kP hpb m F ρ _ eG _ eH β hβ U hU I _ _ E πE hπE hcompE hlimE haffE _


  have desc : ∀ (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ Scheme.{u}) (P : Scheme.{u}) [IsAffine P] (π : ∀ l, P ⟶ D.obj l), (∀ l, IsAffine (D.obj l)) → (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ D.map t = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ D.obj l), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ D.map t = z l') → ∃! z₀ : T ⟶ P, ∀ l, z₀ ≫ π l = z l) → ∀ (M : Type) (g : LocallyConstant P M), ∃ (l : Λ) (d : LocallyConstant (D.obj l) M), ∀ p : P, d (π l p) = g p := by
    intro Λ _ _ D P _ π haff hπ hlim M g
    haveI := haff
    haveI hAH : ∀ {i j : Λ} (f : i ⟶ j), IsAffineHom (D.map f) := fun {i j} f =>
      @isAffineHom_of_isAffine _ _ (D.map f) (haff i) (haff j)
    let c : Limits.Cone D :=
      { pt := P, π := { app := π, naturality := fun k k' t => by simp [hπ t] } }
    have hc : Limits.IsLimit c :=
      Limits.IsLimit.ofExistsUnique (fun s => hlim s.pt s.π.app (fun t => s.w t))
    have s2 : ∀ (X : Scheme.{u}) (e : Γ(X, ⊤)), IsIdempotentElem e →
        IsClopen (X.basicOpen e : Set X) := by
      intro X e he
      have h1 : X.basicOpen e ⊓ X.basicOpen (1 - e) = ⊥ := by
        rw [← Scheme.basicOpen_mul]
        have : e * (1 - e) = 0 := by rw [mul_sub, mul_one, he.eq, sub_self]
        rw [this, Scheme.basicOpen_zero]
      have h2 : (⊤ : X.Opens) ≤ X.basicOpen e ⊔ X.basicOpen (1 - e) := by
        have := Scheme.basicOpen_add_le X e (1 - e)
        rwa [add_sub_cancel, Scheme.basicOpen_one] at this
      have hcpl : (X.basicOpen e : Set X)ᶜ = (X.basicOpen (1 - e) : Set X) := by
        ext x
        simp only [Set.mem_compl_iff, SetLike.mem_coe]
        constructor
        · intro hx
          have hx2 : x ∈ X.basicOpen e ⊔ X.basicOpen (1 - e) := h2 (show x ∈ (⊤ : X.Opens) from trivial)
          rcases (TopologicalSpace.Opens.mem_sup.mp hx2) with h | h
          · exact absurd h hx
          · exact h
        · intro hy hx
          have hxy : x ∈ X.basicOpen e ⊓ X.basicOpen (1 - e) := ⟨hx, hy⟩
          rw [h1] at hxy
          simpa using hxy
      refine ⟨?_, (X.basicOpen e).isOpen⟩
      rw [← isOpen_compl_iff, hcpl]
      exact (X.basicOpen (1 - e)).isOpen
    have s1 : ∀ (X : Scheme.{u}) [IsAffine X] (U : Set X), IsClopen U →
        ∃ e : Γ(X, ⊤), IsIdempotentElem e ∧ (X.basicOpen e : Set X) = U := by
      intro X _ U hU
      let h : X ≃ₜ Spec Γ(X, ⊤) := Scheme.homeoOfIso X.isoSpec
      have hU' : IsClopen (h.symm ⁻¹' U) := hU.preimage h.symm.continuous
      obtain ⟨e, he, heU⟩ := PrimeSpectrum.isClopen_iff.mp hU'
      refine ⟨e, he, ?_⟩
      ext x
      have hx : h x = X.toSpecΓ x := by
        rw [Scheme.homeoOfIso_apply, Scheme.isoSpec_hom]
      have key : x ∈ (X.basicOpen e : Set X) ↔ h x ∈ h.symm ⁻¹' U := by
        rw [heU, hx, ← Scheme.toSpecΓ_preimage_basicOpen]; exact Iff.rfl
      rw [key, Set.mem_preimage, Homeomorph.symm_apply_apply]
    have lift : ∀ e : Γ(P, ⊤), IsIdempotentElem e →
        ∃ (l : Λ) (t : Γ(D.obj l, ⊤)), IsIdempotentElem t ∧ (π l).appTop t = e := by
      intro e he
      obtain ⟨l₀, t₀, ht₀⟩ := exists_appTop_π_eq_of_isAffine_of_isLimit D c hc e
      have ht₀' : (π l₀).appTop t₀ = e := ht₀
      have h1 : (π l₀).app ⊤ (t₀ * t₀) = (π l₀).app ⊤ t₀ := by
        change (π l₀).appTop (t₀ * t₀) = (π l₀).appTop t₀
        rw [map_mul, ht₀', he.eq]
      have hcpt : IsCompact ((⊤ : (D.obj l₀).Opens) : Set (D.obj l₀)) := by
        rw [TopologicalSpace.Opens.coe_top]; exact isCompact_univ
      obtain ⟨j, f, hf⟩ := exists_app_map_eq_map_of_isLimit D c hc hcpt (t₀ * t₀) t₀ h1
      refine ⟨j, (D.map f).appTop t₀, ?_, ?_⟩
      · change (D.map f).appTop t₀ * (D.map f).appTop t₀ = (D.map f).appTop t₀
        rw [← map_mul]
        exact hf
      · have h3 : (π j ≫ D.map f).appTop t₀ = e := by rw [hπ f]; exact ht₀'
        rw [Scheme.Hom.comp_appTop] at h3
        exact h3
    rcases isEmpty_or_nonempty P with hP | ⟨⟨p₀⟩⟩
    · have hex : ∃ l, IsEmpty (D.obj l) := by
        by_contra hne
        haveI : ∀ l, Nonempty (D.obj l) := fun l => not_isEmpty_iff.mp (fun h => hne ⟨l, h⟩)
        have hn : Nonempty c.pt := Scheme.nonempty_of_isLimit D c hc
        exact hP.false hn.some
      obtain ⟨l, hl⟩ := hex
      exact ⟨l, ⟨fun x => (hl.false x).elim, IsLocallyConstant.of_constant _
        (fun x _ => (hl.false x).elim)⟩, fun p => (hP.false p).elim⟩
    · haveI : Nonempty M := ⟨g p₀⟩
      have desc : ∀ m : M, ∃ (l : Λ) (W : Set (D.obj l)), IsClopen W ∧
          ∀ p : P, π l p ∈ W ↔ g p = m := by
        intro m
        have hU : IsClopen {p : P | g p = m} := g.isLocallyConstant.isClopen_fiber m
        obtain ⟨e, he, heU⟩ := s1 P {p : P | g p = m} hU
        obtain ⟨l, t, ht, hte⟩ := lift e he
        refine ⟨l, ((D.obj l).basicOpen t : Set (D.obj l)), s2 _ t ht, fun p => ?_⟩
        have h1 : π l p ∈ ((D.obj l).basicOpen t : Set (D.obj l)) ↔
            p ∈ (P.basicOpen e : Set P) := by
          rw [← hte, ← Scheme.Hom.preimage_basicOpen_top]
          exact Iff.rfl
        have h2 : p ∈ (P.basicOpen e : Set P) ↔ g p = m := by
          rw [heU]; exact Iff.rfl
        exact h1.trans h2
      choose L W hWc hWp using desc
      obtain ⟨S, hS⟩ := IsCofiltered.inf_objs_exists ((g.range_finite.toFinset).image L)
      have hSm : ∀ m ∈ Set.range g, Nonempty (S ⟶ L m) := fun m hm =>
        hS (Finset.mem_image_of_mem L (g.range_finite.mem_toFinset.mpr hm))
      let fm : ∀ m ∈ Set.range g, S ⟶ L m := fun m hm => (hSm m hm).some
      let ι := Set.range g
      haveI : Finite ι := g.range_finite.to_subtype
      let W' : ι → Set (D.obj S) := fun i => ⇑(D.map (fm i.1 i.2)) ⁻¹' W i.1
      have hW'c : ∀ i, IsClopen (W' i) := fun i =>
        (hWc i.1).preimage (D.map (fm i.1 i.2)).continuous
      have hW'p : ∀ (i : ι) (p : P), π S p ∈ W' i ↔ g p = i.1 := by
        intro i p
        show D.map (fm i.1 i.2) (π S p) ∈ W i.1 ↔ _
        rw [← Scheme.Hom.comp_apply, hπ]
        exact hWp i.1 p
      let sig : D.obj S → (ι → Prop) := fun x i => x ∈ W' i
      have hsig : IsLocallyConstant sig := by
        rw [IsLocallyConstant.iff_exists_open]
        intro x
        refine ⟨⋂ i, (if x ∈ W' i then W' i else (W' i)ᶜ),
          isOpen_iInter_of_finite (fun i => ?_), ?_, ?_⟩
        · split_ifs
          · exact (hW'c i).isOpen
          · exact (hW'c i).compl.isOpen
        · rw [Set.mem_iInter]
          intro i
          split_ifs with h
          · exact h
          · exact h
        · intro x' hx'
          rw [Set.mem_iInter] at hx'
          funext i
          have hi := hx' i
          apply propext
          split_ifs at hi with h
          · exact iff_of_true hi h
          · exact iff_of_false hi h
      let H : (ι → Prop) → M := fun s =>
        if h : ∃ i, s i then (h.choose).1 else Classical.arbitrary M
      refine ⟨S, ⟨H ∘ sig, hsig.comp H⟩, fun p => ?_⟩
      have hex : ∃ i, sig (π S p) i := ⟨⟨g p, p, rfl⟩, (hW'p _ p).mpr rfl⟩
      show H (sig (π S p)) = g p
      simp only [H, dif_pos hex]
      exact ((hW'p _ p).mp hex.choose_spec).symm


  have cone : ∀ {X' Y' : Scheme.{u}} (h : X' ⟶ Y') (Y₀ : Scheme.{u}) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W : Λ ⥤ Y'.Etale) (φ : ∀ l, Y₀ ⟶ (W.obj l).left) (a : Y₀ ⟶ Y'), (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W.map t).left = φ l') → (∀ l, φ l ≫ (W.obj l).hom = a) → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (W.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (W.map t).left = z l') → ∃! z₀ : T ⟶ Y₀, ∀ l, z₀ ≫ φ l = z l) → ∀ (XZ : Scheme.{u}) (p : XZ ⟶ X') (hZ : XZ ⟶ Y₀), IsPullback p hZ h a → ∃ π : ∀ l, XZ ⟶ ((W ⋙ wcEtBaseChange h).obj l).left, (∀ l, π l ≫ ((W ⋙ wcEtBaseChange h).obj l).hom = p) ∧ (∀ l, π l ≫ Limits.pullback.fst (W.obj l).hom h = hZ ≫ φ l) ∧ (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ ((W ⋙ wcEtBaseChange h).map t).left = π l') ∧ ∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ ((W ⋙ wcEtBaseChange h).obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ ((W ⋙ wcEtBaseChange h).map t).left = z l') → ∃! z₀ : T ⟶ XZ, ∀ l, z₀ ≫ π l = z l := by
    intro X' Y' h Y₀ Λ _ _ W φ a hφ hφa hlim XZ p hZ hpb
    have M1 : ∀ {l l' : Λ} (t : l ⟶ l'),
        ((W ⋙ wcEtBaseChange h).map t).left ≫ Limits.pullback.fst (W.obj l').hom h =
          Limits.pullback.fst (W.obj l).hom h ≫ (W.map t).left := by
      intro l l' t
      exact Limits.pullback.lift_fst _ _ _
    have M2 : ∀ {l l' : Λ} (t : l ⟶ l'),
        ((W ⋙ wcEtBaseChange h).map t).left ≫ Limits.pullback.snd (W.obj l').hom h =
          Limits.pullback.snd (W.obj l).hom h := by
      intro l l' t
      exact Limits.pullback.lift_snd _ _ _
    have hw : p ≫ h = hZ ≫ a := hpb.w
    have wl : ∀ l, (hZ ≫ φ l) ≫ (W.obj l).hom = p ≫ h := by
      intro l
      rw [Category.assoc, hφa l, hw]
    let π : ∀ l, XZ ⟶ ((W ⋙ wcEtBaseChange h).obj l).left := fun l =>
      Limits.pullback.lift (hZ ≫ φ l) p (wl l)
    have P1 : ∀ l, π l ≫ Limits.pullback.fst (W.obj l).hom h = hZ ≫ φ l := fun l =>
      Limits.pullback.lift_fst _ _ _
    have P2 : ∀ l, π l ≫ Limits.pullback.snd (W.obj l).hom h = p := fun l =>
      Limits.pullback.lift_snd _ _ _
    have C2 : ∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ ((W ⋙ wcEtBaseChange h).map t).left = π l' := by
      intro l l' t
      refine Limits.pullback.hom_ext (f := (W.obj l').hom) (g := h) ?_ ?_
      · calc (π l ≫ ((W ⋙ wcEtBaseChange h).map t).left) ≫ Limits.pullback.fst (W.obj l').hom h
            = π l ≫ (((W ⋙ wcEtBaseChange h).map t).left ≫
                Limits.pullback.fst (W.obj l').hom h) := Category.assoc _ _ _
          _ = π l ≫ (Limits.pullback.fst (W.obj l).hom h ≫ (W.map t).left) := whisker_eq _ (M1 t)
          _ = (π l ≫ Limits.pullback.fst (W.obj l).hom h) ≫ (W.map t).left :=
              (Category.assoc _ _ _).symm
          _ = (hZ ≫ φ l) ≫ (W.map t).left := eq_whisker (P1 l) _
          _ = hZ ≫ φ l' := by rw [Category.assoc, hφ t]
          _ = π l' ≫ Limits.pullback.fst (W.obj l').hom h := (P1 l').symm
      · calc (π l ≫ ((W ⋙ wcEtBaseChange h).map t).left) ≫ Limits.pullback.snd (W.obj l').hom h
            = π l ≫ (((W ⋙ wcEtBaseChange h).map t).left ≫
                Limits.pullback.snd (W.obj l').hom h) := Category.assoc _ _ _
          _ = π l ≫ Limits.pullback.snd (W.obj l).hom h := whisker_eq _ (M2 t)
          _ = p := P2 l
          _ = π l' ≫ Limits.pullback.snd (W.obj l').hom h := (P2 l').symm
    have C3 : ∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ ((W ⋙ wcEtBaseChange h).obj l).left),
        (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ ((W ⋙ wcEtBaseChange h).map t).left = z l') →
        ∃! z₀ : T ⟶ XZ, ∀ l, z₀ ≫ π l = z l := by
      intro T z hz
      have hs : ∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ Limits.pullback.snd (W.obj l).hom h =
          z l' ≫ Limits.pullback.snd (W.obj l').hom h := by
        intro l l' t
        calc z l ≫ Limits.pullback.snd (W.obj l).hom h
            = z l ≫ (((W ⋙ wcEtBaseChange h).map t).left ≫
                Limits.pullback.snd (W.obj l').hom h) := (whisker_eq _ (M2 t)).symm
          _ = (z l ≫ ((W ⋙ wcEtBaseChange h).map t).left) ≫
                Limits.pullback.snd (W.obj l').hom h := (Category.assoc _ _ _).symm
          _ = z l' ≫ Limits.pullback.snd (W.obj l').hom h := eq_whisker (hz t) _
      obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
      have hX : ∀ l, z l ≫ Limits.pullback.snd (W.obj l).hom h =
          z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h := fun l =>
        (hs (IsCofiltered.minToLeft l l₀)).symm.trans (hs (IsCofiltered.minToRight l l₀))
      have hf : ∀ {l l' : Λ} (t : l ⟶ l'), (z l ≫ Limits.pullback.fst (W.obj l).hom h) ≫
          (W.map t).left = z l' ≫ Limits.pullback.fst (W.obj l').hom h := by
        intro l l' t
        calc (z l ≫ Limits.pullback.fst (W.obj l).hom h) ≫ (W.map t).left
            = z l ≫ (Limits.pullback.fst (W.obj l).hom h ≫ (W.map t).left) := Category.assoc _ _ _
          _ = z l ≫ (((W ⋙ wcEtBaseChange h).map t).left ≫
                Limits.pullback.fst (W.obj l').hom h) := whisker_eq _ (M1 t).symm
          _ = (z l ≫ ((W ⋙ wcEtBaseChange h).map t).left) ≫
                Limits.pullback.fst (W.obj l').hom h := (Category.assoc _ _ _).symm
          _ = z l' ≫ Limits.pullback.fst (W.obj l').hom h := eq_whisker (hz t) _
      obtain ⟨y, hy, hyu⟩ := hlim T (fun l => z l ≫ Limits.pullback.fst (W.obj l).hom h) hf
      have hy' : ∀ l, y ≫ φ l = z l ≫ Limits.pullback.fst (W.obj l).hom h := hy
      have hxy : (z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h) ≫ h = y ≫ a := by
        calc (z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h) ≫ h
            = z l₀ ≫ (Limits.pullback.snd (W.obj l₀).hom h ≫ h) := Category.assoc _ _ _
          _ = z l₀ ≫ (Limits.pullback.fst (W.obj l₀).hom h ≫ (W.obj l₀).hom) :=
              whisker_eq _ Limits.pullback.condition.symm
          _ = (z l₀ ≫ Limits.pullback.fst (W.obj l₀).hom h) ≫ (W.obj l₀).hom :=
              (Category.assoc _ _ _).symm
          _ = (y ≫ φ l₀) ≫ (W.obj l₀).hom := eq_whisker (hy' l₀).symm _
          _ = y ≫ a := by rw [Category.assoc, hφa l₀]
      obtain ⟨z₀, hz₀p, hz₀Z⟩ : ∃ z₀ : T ⟶ XZ,
          z₀ ≫ p = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h ∧ z₀ ≫ hZ = y :=
        ⟨hpb.lift _ y hxy, hpb.lift_fst _ _ _, hpb.lift_snd _ _ _⟩
      refine ⟨z₀, fun l => ?_, fun z' hz' => ?_⟩
      · refine Limits.pullback.hom_ext (f := (W.obj l).hom) (g := h) ?_ ?_
        · calc (z₀ ≫ π l) ≫ Limits.pullback.fst (W.obj l).hom h
              = z₀ ≫ (π l ≫ Limits.pullback.fst (W.obj l).hom h) := Category.assoc _ _ _
            _ = z₀ ≫ (hZ ≫ φ l) := whisker_eq _ (P1 l)
            _ = (z₀ ≫ hZ) ≫ φ l := (Category.assoc _ _ _).symm
            _ = y ≫ φ l := eq_whisker hz₀Z _
            _ = z l ≫ Limits.pullback.fst (W.obj l).hom h := hy' l
        · calc (z₀ ≫ π l) ≫ Limits.pullback.snd (W.obj l).hom h
              = z₀ ≫ (π l ≫ Limits.pullback.snd (W.obj l).hom h) := Category.assoc _ _ _
            _ = z₀ ≫ p := whisker_eq _ (P2 l)
            _ = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h := hz₀p
            _ = z l ≫ Limits.pullback.snd (W.obj l).hom h := (hX l).symm
      · have e1 : z' ≫ p = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h := by
          calc z' ≫ p = z' ≫ (π l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h) :=
                whisker_eq _ (P2 l₀).symm
            _ = (z' ≫ π l₀) ≫ Limits.pullback.snd (W.obj l₀).hom h := (Category.assoc _ _ _).symm
            _ = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h := eq_whisker (hz' l₀) _
        have e2 : z' ≫ hZ = y := by
          apply hyu
          intro l
          calc (z' ≫ hZ) ≫ φ l = z' ≫ (hZ ≫ φ l) := Category.assoc _ _ _
            _ = z' ≫ (π l ≫ Limits.pullback.fst (W.obj l).hom h) := whisker_eq _ (P1 l).symm
            _ = (z' ≫ π l) ≫ Limits.pullback.fst (W.obj l).hom h := (Category.assoc _ _ _).symm
            _ = z l ≫ Limits.pullback.fst (W.obj l).hom h := eq_whisker (hz' l) _
        exact hpb.hom_ext (e1.trans hz₀p.symm) (e2.trans hz₀Z.symm)
    exact ⟨π, P2, P1, C2, C3⟩

  haveI : IsAffineHom hP := MorphismProperty.of_isPullback (P := @IsAffineHom) hpb.flip inferInstance
  haveI : IsAffineHom (Limits.pullback.fst U.hom hP) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback U.hom hP).flip inferInstance
  haveI : IsAffine U.left := hU
  haveI : IsAffine ((𝟭 Scheme.{u}).obj U.left) := hU
  haveI : IsAffine (Limits.pullback U.hom hP) :=
    isAffine_of_isAffineHom (Limits.pullback.fst U.hom hP)
  have haffS : ∀ i, IsAffine (Limits.pullback (E.obj i).hom k) := fun i => by
    haveI := haffE i
    haveI : IsAffine ((𝟭 Scheme.{u}).obj (E.obj i).left) := haffE i
    haveI : IsAffineHom (Limits.pullback.fst (E.obj i).hom k) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasPullback (E.obj i).hom k).flip inferInstance
    exact isAffine_of_isAffineHom (Limits.pullback.fst (E.obj i).hom k)

  have sq : IsPullback (Limits.pullback.snd U.hom hP ≫ kP) (Limits.pullback.fst U.hom hP) k
      (U.hom ≫ p) :=
    IsPullback.paste_horiz (IsPullback.of_hasPullback U.hom hP).flip hpb.flip

  obtain ⟨π'', c1, c2, c3, c4⟩ := cone k U.left I E πE (U.hom ≫ p) hcompE hπE hlimE _ _ _ sq

  intro s
  let DS : I ⥤ Scheme.{u} := E ⋙ wcEtBaseChange k ⋙ Scheme.Etale.forget P ⋙ Over.forget P
  obtain ⟨i, d, hd⟩ := desc I DS (Limits.pullback U.hom hP) π'' haffS (fun t => c3 t)
    (fun T z hz => c4 T z hz) (ZMod m) (eH U s)

  refine ⟨ρ.ρ (E.obj i) U (πE i) (hπE i) ((eG (E.obj i)).symm d), ?_⟩
  apply (eH U).injective
  ext q
  refine (hβ (E.obj i) U (πE i) (hπE i) _ (π'' i) (c2 i) (c1 i) q).trans ?_
  exact (DFunLike.congr_fun ((eG (E.obj i)).apply_symm_apply d) (π'' i q)).trans (hd q)

