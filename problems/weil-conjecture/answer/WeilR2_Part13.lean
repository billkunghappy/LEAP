  have hDom : ∀ j, IsDomain Γ(X.left, X.left.basicOpen (f' j)) := fun j => by
    obtain ⟨y, hy⟩ := hne j
    exact @IsIntegral.component_integral _ _ _ ⟨⟨y, hy⟩⟩
  have hker : ∀ j (χ : Γ(X.left, X.left.basicOpen (f' j)) →ₐ[K] K), RingHom.ker χ =
      Ideal.span (Set.range fun p =>
        (X.left.presheaf.map (homOfLE (X.left.basicOpen_le (f' j))).op).hom
            ((ι.app (wcSgD K N (b' j))).hom (wcSgE K N (b' j) p)) -
          algebraMap K _ (χ ((X.left.presheaf.map (homOfLE (X.left.basicOpen_le (f' j))).op).hom
            ((ι.app (wcSgD K N (b' j))).hom (wcSgE K N (b' j) p))))) := by
    intro j χ
    letI algA : Algebra K Γ(X.left, ι ⁻¹ᵁ wcSgD K N (b' j)) :=
      ((X.left.presheaf.map (homOfLE (le_top : ι ⁻¹ᵁ wcSgD K N (b' j) ≤ ⊤)).op).hom.comp
        (X.hom.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom)).toAlgebra
    haveI : IsScalarTower K Γ(X.left, ι ⁻¹ᵁ wcSgD K N (b' j)) Γ(X.left, X.left.basicOpen (f' j)) :=
      IsScalarTower.of_algebraMap_eq (fun c =>
        congrArg (fun φ => φ.hom (X.hom.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)))
          (X.left.presheaf.map_comp (homOfLE (le_top : ι ⁻¹ᵁ wcSgD K N (b' j) ≤ ⊤)).op
            (homOfLE (X.left.basicOpen_le (f' j))).op))
    haveI := (hVaff (b' j)).isLocalization_basicOpen (f' j)
    refine qs7 K _ _ (Fin (N + 1)) (fun p => (ι.app (wcSgD K N (b' j))).hom (wcSgE K N (b' j) p))
      ?_ (f' j) χ
    intro a
    obtain ⟨z, rfl⟩ := Scheme.Hom.app_surjective ι _ (hDaff (b' j)) a
    have hz := qs1 K N (b' j) z
    have hz' : (ι.app (wcSgD K N (b' j))).hom z ∈
        (Subring.closure _).map (ι.app (wcSgD K N (b' j))).hom := Subring.mem_map.mpr ⟨z, hz, rfl⟩
    rw [RingHom.map_closure] at hz'
    refine (Subring.closure_le.mpr ?_) hz'
    rintro _ ⟨y, (⟨p, rfl⟩ | ⟨c, rfl⟩), rfl⟩
    · exact Subring.subset_closure (Or.inl ⟨p, rfl⟩)
    · apply Subring.subset_closure
      right
      exact ⟨c, (qs9 K N X.left X.hom ι hιX (b' j) c).symm⟩
  refine ⟨m, b', fun j => Γ(X.left, X.left.basicOpen (f' j)), fun j => inferInstance, algK,
    fun j => (hFTd j).1, hDom, fun j => (hFTd j).2,
    fun j p => (X.left.presheaf.map (homOfLE (X.left.basicOpen_le (f' j))).op).hom
      ((ι.app (wcSgD K N (b' j))).hom (wcSgE K N (b' j) p)),
    fun j k => gh j (MvPolynomial.X k), D, ?_, fun j i k => hD j i k, hker, ?_⟩
  · intro j
    show (X.left.presheaf.map _).hom ((ι.app _).hom (wcSgE K N (b' j) (b' j))) = 1
    rw [(qs2 K N (b' j)).1, map_one, map_one]
  · intro x hxc b hx
    obtain ⟨j, rfl, hxj⟩ := hcov b x hx
    refine ⟨j, rfl, ?_⟩
    obtain ⟨x', rfl⟩ : ∃ x' : ↥(X.left.basicOpen (f' j)), (x' : X.left) = x := ⟨⟨x, hxj⟩, rfl⟩
    have hW : IsAffineOpen (X.left.basicOpen (f' j)) := (hVaff (b' j)).basicOpen (f' j)
    have hPmax : (hW.primeIdealOf x').asIdeal.IsMaximal := by
      haveI := hW.isOpenImmersion_fromSpec
      have hinj := hW.fromSpec.isOpenEmbedding.injective
      have hpre : hW.fromSpec ⁻¹' {(x' : X.left)} = {hW.primeIdealOf x'} := by
        ext w
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        constructor
        · intro hw
          apply hinj
          rw [hw, hW.fromSpec_primeIdealOf]
        · intro hw
          rw [hw, hW.fromSpec_primeIdealOf]
      have hc : IsClosed ({hW.primeIdealOf x'} : Set (Spec Γ(X.left, X.left.basicOpen (f' j)))) := by
        rw [← hpre]
        exact hxc.preimage hW.fromSpec.continuous
      exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal (hW.primeIdealOf x')).mp hc
    haveI := hPmax
    haveI := hW.isLocalization_stalk x'
    haveI := (hFTd j).1
    obtain ⟨χ, hχ, hres⟩ := qs8 K Γ(X.left, X.left.basicOpen (f' j)) (hW.primeIdealOf x').asIdeal
    obtain ⟨hF1, hF2⟩ := hres (X.left.presheaf.stalk (x' : X.left))
    have hlam : ∀ r, algebraMap Γ(X.left, X.left.basicOpen (f' j))
        (X.left.presheaf.stalk (x' : X.left)) r =
          (X.left.presheaf.germ _ (x' : X.left) x'.2).hom r := fun r => by
      rw [TopCat.Presheaf.stalk_open_algebraMap]
    have Kc : ∀ c : K, algebraMap Γ(X.left, X.left.basicOpen (f' j))
        (X.left.presheaf.stalk (x' : X.left)) (algebraMap K Γ(X.left, X.left.basicOpen (f' j)) c) =
          wcLdpConst K X.hom x' c := fun c => by
      rw [hlam]
      exact X.left.presheaf.germ_res_apply (homOfLE le_top) (x' : X.left) x'.2 _
    have hu : ∀ y : Γ(X.left, ι ⁻¹ᵁ wcSgD K N (b' j)),
        (X.left.presheaf.germ _ (x' : X.left) x'.2).hom
          ((X.left.presheaf.map (homOfLE (X.left.basicOpen_le (f' j))).op).hom y) =
        (X.left.presheaf.germ _ (x' : X.left) hx).hom y := fun y =>
      X.left.presheaf.germ_res_apply _ _ _ y
    choose δ hδ1 hδ2 using fun i => qs6 Γ(X.left, X.left.basicOpen (f' j))
      (X.left.presheaf.stalk (x' : X.left)) (hW.primeIdealOf x').asIdeal.primeCompl
      (D j i).toLinearMap.toAddMonoidHom (fun a b => (D j i).leibniz a b)
    refine ⟨χ, algebraMap _ _, δ, fun r => ?_, fun y => ?_, fun w => ?_, ?_, hδ1, fun i c => ?_,
      fun i r => hδ2 i r⟩
    · have h := hF1 r
      rwa [Kc] at h
    · obtain ⟨c, hc⟩ := hF2 y
      exact ⟨c, by rwa [Kc] at hc⟩
    · have e2 : wcLdpGerm K N ι (wcLdpQuad K N fun p q => w (p, q)) (b' j) (x' : X.left) hx =
          ∑ p, ∑ q, wcLdpConst K X.hom x' (w (p, q)) *
            ((X.left.presheaf.germ _ (x' : X.left) hx).hom
                ((ι.app (wcSgD K N (b' j))).hom (wcSgE K N (b' j) p)) *
              (X.left.presheaf.germ _ (x' : X.left) hx).hom
                ((ι.app (wcSgD K N (b' j))).hom (wcSgE K N (b' j) q))) := by
        unfold wcLdpGerm
        rw [(qs2 K N (b' j)).2, map_sum, map_sum]
        refine Finset.sum_congr rfl (fun p _ => ?_)
        rw [map_sum, map_sum]
        refine Finset.sum_congr rfl (fun q _ => ?_)
        rw [map_mul, map_mul, map_mul, map_mul, qs9 K N X.left X.hom ι hιX (b' j)]
        congr 1
        exact X.left.presheaf.germ_res_apply (homOfLE le_top) (x' : X.left) hx _
      rw [e2, map_sum, Fintype.sum_prod_type]
      refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => ?_))
      rw [Algebra.smul_def, map_mul, map_mul, Kc, hlam, hlam, hu, hu]
    · have h5 := qs5 K n _ (gh j) (hgE' j) (hW.primeIdealOf x').asIdeal χ hχ
        (X.left.presheaf.stalk (x' : X.left))
      rw [h5]
      congr 2
      funext k
      rw [map_sub, Kc]
    · rw [← Kc c, hδ2 i]
      exact (congrArg (algebraMap _ _) ((D j i).map_algebraMap c)).trans (map_zero _)

theorem wc_ldp_quadric_jets_one (K : Type u) [Field K] (R : Type u) [CommRing R] [Algebra K R]
    (N n : ℕ) (b : Fin (N + 1)) (u : Fin (N + 1) → R) (hub : u b = 1)
    (t : Fin n → R) (D : Fin n → Derivation K R R) (hDt : ∀ i k, D i (t k) = if i = k then 1 else 0)
    (χ : R →ₐ[K] K)
    (hker : RingHom.ker χ = Ideal.span (Set.range fun p => u p - algebraMap K R (χ (u p)))) :
    ∀ (y₀ : K) (y : Fin n → K), ∃ w : Fin (N + 1) × Fin (N + 1) → K,
      χ (∑ q, w q • (u q.1 * u q.2)) = y₀ ∧ ∀ k, χ (D k (∑ q, w q • (u q.1 * u q.2))) = y k :=
by
  classical
  intro y₀ y

  have hmem : ∀ l, t l - algebraMap K R (χ (t l)) ∈
      Ideal.span (Set.range fun p => u p - algebraMap K R (χ (u p))) := by
    intro l
    rw [← hker, RingHom.mem_ker]
    simp
  choose c hc using fun l => (Ideal.mem_span_range_iff_exists_fun).mp (hmem l)

  have hdual : ∀ k l, ∑ p, χ (c l p) * χ (D k (u p)) = if k = l then 1 else 0 := by
    intro k l
    have hterm : ∀ p, χ (D k (c l p * (u p - algebraMap K R (χ (u p))))) =
        χ (c l p) * χ (D k (u p)) := by
      intro p
      simp [Derivation.leibniz, map_sub, Derivation.map_algebraMap, AlgHom.commutes]
    have h1 := congrArg (fun z => χ (D k z)) (hc l)
    simp only [map_sum, hterm] at h1
    rw [h1, map_sub, Derivation.map_algebraMap, sub_zero, hDt]
    split_ifs <;> simp

  have hcol : ∀ γ : Fin (N + 1) → K, ∑ q : Fin (N + 1) × Fin (N + 1),
      (if q.2 = b then γ q.1 else 0) • (u q.1 * u q.2) = ∑ p, γ p • u p := by
    intro γ
    rw [Fintype.sum_prod_type]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    simp [ite_smul, hub]
  have hub1 : χ (u b) = 1 := by rw [hub, map_one]
  have hDb : ∀ k, D k (u b) = 0 := fun k => by rw [hub]; exact Derivation.map_one_eq_zero _
  obtain ⟨γ, hγ⟩ : ∃ γ : Fin (N + 1) → K, γ = fun p => (∑ l, y l * χ (c l p)) +
      if p = b then y₀ - ∑ p', (∑ l, y l * χ (c l p')) * χ (u p') else 0 := ⟨_, rfl⟩
  refine ⟨fun q => if q.2 = b then γ q.1 else 0, ?_, ?_⟩
  · beta_reduce
    rw [hcol γ, map_sum]
    simp only [map_smul, smul_eq_mul]
    subst hγ
    simp only [add_mul, Finset.sum_add_distrib, ite_mul, zero_mul, Finset.sum_ite_eq',
      Finset.mem_univ, if_true, hub1, mul_one]
    ring
  · intro k
    beta_reduce
    rw [hcol γ, map_sum, map_sum]
    simp only [Derivation.map_smul, map_smul, smul_eq_mul]
    subst hγ
    simp only [add_mul, Finset.sum_add_distrib, ite_mul, zero_mul, Finset.sum_ite_eq',
      Finset.mem_univ, if_true, hDb, map_zero, mul_zero, add_zero]
    calc ∑ p, (∑ l, y l * χ (c l p)) * χ (D k (u p))
        = ∑ l, y l * ∑ p, χ (c l p) * χ (D k (u p)) := by
          simp only [Finset.sum_mul, Finset.mul_sum]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun _ _ => Finset.sum_congr rfl (fun _ _ => by ring))
      _ = y k := by
          simp only [hdual, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_univ,
            if_true]

theorem wc_ldp_linear_fibres_dim (K : Type u) [Field K] [IsAlgClosed K] (R : Type u) [CommRing R]
    [Algebra K R] [Algebra.FiniteType K R] (e : ℕ) (hR : ringKrullDim R ≤ e)
    (ρ ι' : Type) [Fintype ρ] [Fintype ι'] (L : ρ → ι' → R)
    (hsurj : ∀ (χ : R →ₐ[K] K) (y : ρ → K), ∃ w : ι' → K, ∀ i, ∑ j, w j * χ (L i j) = y i) :
    ringKrullDim (MvPolynomial ι' R ⧸ Ideal.span (Set.range fun i =>
        ∑ j, MvPolynomial.C (L i j) * MvPolynomial.X j)) ≤
      ((e + Fintype.card ι' - Fintype.card ρ : ℕ) : WithBot ℕ∞) :=
by
  classical

  have s1 : Ideal.span (Set.range fun a : {a : ρ → ι' // Function.Injective a} =>
      (Matrix.of fun i k => L i (a.1 k)).det) = ⊤ := by
    by_contra hJ
    obtain ⟨m, hm, hJm⟩ := Ideal.exists_le_maximal _ hJ
    letI : Field (R ⧸ m) := Ideal.Quotient.field m
    have : Algebra.FiniteType K (R ⧸ m) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ K m)
        (Ideal.Quotient.mkₐ_surjective K m)
    have : Module.Finite K (R ⧸ m) := finite_of_finite_type_of_isJacobsonRing K (R ⧸ m)
    have : Algebra.IsIntegral K (R ⧸ m) := Algebra.IsIntegral.of_finite K _
    have hbij := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K) (K := R ⧸ m)
    let eK : K ≃ₐ[K] R ⧸ m := AlgEquiv.ofBijective (Algebra.ofId K (R ⧸ m)) hbij
    let χ : R →ₐ[K] K := eK.symm.toAlgHom.comp (Ideal.Quotient.mkₐ K m)
    have hχ : ∀ r ∈ m, χ r = 0 := by
      intro r hr
      have h0 : Ideal.Quotient.mkₐ K m r = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hr
      show eK.symm (Ideal.Quotient.mkₐ K m r) = 0
      rw [h0, map_zero]
    let c : ι' → (ρ → K) := fun j i => χ (L i j)
    have hspan : Submodule.span K (Set.range c) = ⊤ := by
      rw [eq_top_iff]
      intro y _
      obtain ⟨w, hw⟩ := hsurj χ y
      have hy : y = ∑ j, w j • c j := by
        ext i
        rw [Finset.sum_apply, ← hw i]
        rfl
      rw [hy]
      exact Submodule.sum_mem _ (fun j _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩))
    obtain ⟨κ, b, hb, hbspan, hbli⟩ := exists_linearIndependent' K c
    have : Finite κ := Finite.of_injective b hb
    letI : Fintype κ := Fintype.ofFinite κ
    have hcard : Fintype.card κ = Fintype.card ρ := by
      let B := Module.Basis.mk hbli (by rw [hbspan, hspan])
      have := Module.finrank_eq_card_basis B
      rw [Module.finrank_fintype_fun_eq_card] at this
      exact this.symm
    let σ : ρ ≃ κ := Fintype.equivOfCardEq hcard.symm
    let a : ρ → ι' := b ∘ σ
    have ha : Function.Injective a := hb.comp σ.injective
    let N : Matrix ρ ρ K := Matrix.of fun i k => χ (L i (a k))
    have hN : LinearIndependent K N.col := by
      have : N.col = (c ∘ b) ∘ σ := by
        ext k i
        rfl
      rw [this]
      exact hbli.comp σ σ.injective
    have hdet : N.det ≠ 0 :=
      ((Matrix.isUnit_iff_isUnit_det N).mp (Matrix.linearIndependent_cols_iff_isUnit.mp hN)).ne_zero
    apply hdet
    have h1 : χ (Matrix.of fun i k => L i (a k)).det = 0 :=
      hχ _ (hJm (Ideal.subset_span ⟨⟨a, ha⟩, rfl⟩))
    rw [AlgHom.map_det] at h1
    exact h1

  have s2 : ∀ x : R, ringKrullDim (Localization.Away x) ≤ ringKrullDim R := by
    intro x
    rw [ringKrullDim_le_iff_height_le]
    intro p hp
    rw [← IsLocalization.height_under (Submonoid.powers x) p]
    exact Ideal.height_le_ringKrullDim_of_ne_top (Ideal.IsPrime.ne_top inferInstance)

  have s3 : ∀ (S : Type u) [CommRing S] {κ : Type} (f : κ → S),
      Ideal.span (Set.range f) = ⊤ → ∀ (d : WithBot ℕ∞),
      (∀ k, ringKrullDim (Localization.Away (f k)) ≤ d) → ringKrullDim S ≤ d := by
    intro S _ κ f hf d hd
    rw [ringKrullDim_le_iff_height_le]
    intro Q hQ
    obtain ⟨k, hk⟩ : ∃ k, f k ∉ Q := by
      by_contra h
      push_neg at h
      apply hQ.ne_top
      rw [eq_top_iff, ← hf, Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      exact h k
    have hdisj : Disjoint (Submonoid.powers (f k) : Set S) (Q : Set S) := by
      rw [Set.disjoint_left]
      rintro _ ⟨n, rfl⟩ hn
      exact hk (hQ.mem_of_pow_mem n hn)
    have hP := IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers (f k))
      (Localization.Away (f k)) Q hQ hdisj
    rw [← IsLocalization.height_map_of_disjoint (S := Localization.Away (f k))
      (Submonoid.powers (f k)) Q hdisj]
    exact (Ideal.height_le_ringKrullDim_of_ne_top hP.ne_top).trans (hd k)

  have s4 : ∀ (a : ρ → ι'), Function.Injective a →
      ∃ f : MvPolynomial {j : ι' // j ∉ Set.range a}
          (Localization.Away (Matrix.of fun i k => L i (a k)).det) →+*
        Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range fun i =>
            ∑ j, MvPolynomial.C (L i j) * MvPolynomial.X j))
          (MvPolynomial.C (Matrix.of fun i k => L i (a k)).det)),
        Function.Surjective f := by
    intro a ha
    set I := Ideal.span (Set.range fun i =>
            ∑ j, MvPolynomial.C (L i j) * MvPolynomial.X j) with hI
    set A : Matrix ρ ρ R := Matrix.of fun i k => L i (a k) with hA
    set δ := A.det with hδ
    set π := Ideal.Quotient.mk I with hπ
    set δS := π (MvPolynomial.C δ) with hδS
    let T := Localization.Away δS
    let g₀ : R →+* T := (algebraMap _ T).comp (π.comp MvPolynomial.C)
    have hg₀δ : g₀ δ = algebraMap _ T δS := rfl
    have hg₀u : IsUnit (g₀ δ) := by
      rw [hg₀δ]; exact IsLocalization.Away.algebraMap_isUnit δS
    let g : Localization.Away δ →+* T := IsLocalization.Away.lift δ hg₀u
    have hg : ∀ r : R, g (algebraMap R _ r) = g₀ r := fun r =>
      IsLocalization.Away.lift_eq δ hg₀u r
    let y : ι' → T := fun j => algebraMap _ T (π (MvPolynomial.X j))
    let f : MvPolynomial {j : ι' // j ∉ Set.range a} (Localization.Away δ) →+* T :=
      MvPolynomial.eval₂Hom g (fun j => y j.1)
    refine ⟨f, ?_⟩
    have hi : ∀ r : R, g₀ r ∈ f.range := fun r =>
      ⟨MvPolynomial.C (algebraMap R _ r), by
        simp only [f, MvPolynomial.eval₂Hom_C, hg]⟩
    set u := g (IsLocalization.Away.invSelf δ) with hu
    have hii : u ∈ f.range := ⟨MvPolynomial.C (IsLocalization.Away.invSelf δ), by
        simp only [f, MvPolynomial.eval₂Hom_C, hu]⟩
    have hδu : g₀ δ * u = 1 := by
      rw [← hg, hu, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
    have hiii : ∀ (j : ι') (hj : j ∉ Set.range a), y j ∈ f.range := fun j hj =>
      ⟨MvPolynomial.X ⟨j, hj⟩, by simp only [f, MvPolynomial.eval₂Hom_X']⟩
    have hrel : ∀ i, ∑ j, g₀ (L i j) * y j = 0 := by
      intro i
      have h0 : π (∑ j, MvPolynomial.C (L i j) * MvPolynomial.X j) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
      have h1 := congrArg (algebraMap _ T) h0
      rw [map_zero, map_sum, map_sum] at h1
      simp only [map_mul] at h1
      exact h1
    let b : ρ → T := fun i => ∑ j : {j : ι' // j ∉ Set.range a}, g₀ (L i j.1) * y j.1
    let v : ρ → T := fun k => y (a k)
    let A' : Matrix ρ ρ T := g₀.mapMatrix A
    have hmv : A'.mulVec v = -b := by
      funext i
      have h := Fintype.sum_subtype_add_sum_subtype (fun j => j ∈ Set.range a)
        (fun j => g₀ (L i j) * y j)
      have hs : ∑ j : {j : ι' // j ∈ Set.range a}, g₀ (L i j.1) * y j.1 =
          ∑ k, g₀ (L i (a k)) * y (a k) := by
        symm
        exact Fintype.sum_bijective (fun k => (⟨a k, k, rfl⟩ : {j : ι' // j ∈ Set.range a}))
          ⟨fun k k' hkk' => ha (congrArg Subtype.val hkk'),
            fun ⟨_, k, hk⟩ => ⟨k, Subtype.ext hk⟩⟩
          _ _ (fun k => rfl)
      have e1 : A'.mulVec v i = ∑ k, g₀ (L i (a k)) * y (a k) := rfl
      rw [Pi.neg_apply, e1, ← hs]
      convert eq_neg_of_add_eq_zero_left (h.trans (hrel i))
    have hdet : A'.det = g₀ δ := (RingHom.map_det g₀ A).symm
    have hiv : ∀ k, v k ∈ f.range := by
      intro k
      have h1 : A'.adjugate.mulVec (A'.mulVec v) = A'.det • v := by
        rw [Matrix.mulVec_mulVec, Matrix.adjugate_mul, Matrix.smul_mulVec, Matrix.one_mulVec]
      rw [hmv, hdet] at h1
      have h2 := congrFun h1 k
      rw [Pi.smul_apply, smul_eq_mul] at h2
      have h3 : v k = u * (A'.adjugate.mulVec (-b)) k := by
        rw [h2, ← mul_assoc, mul_comm u, hδu, one_mul]
      rw [h3]
      refine f.range.mul_mem hii ?_
      rw [Matrix.mulVec_neg, Pi.neg_apply]
      refine f.range.neg_mem ?_
      show ∑ i, A'.adjugate k i * b i ∈ f.range
      refine f.range.sum_mem (fun i _ => f.range.mul_mem ?_ ?_)
      · rw [← RingHom.map_adjugate]
        exact hi _
      · exact f.range.sum_mem (fun j _ => f.range.mul_mem (hi _) (hiii j.1 j.2))
    have hy : ∀ j, y j ∈ f.range := by
      intro j
      by_cases hj : j ∈ Set.range a
      · obtain ⟨k, rfl⟩ := hj
        exact hiv k
      · exact hiii j hj
    have hv : ∀ p : MvPolynomial ι' R, algebraMap _ T (π p) ∈ f.range := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C r => exact hi r
      | add p q hp hq => rw [map_add, map_add]; exact f.range.add_mem hp hq
      | mul_X p j hp => rw [map_mul, map_mul]; exact f.range.mul_mem hp (hy j)
    intro t
    obtain ⟨n, s, hn⟩ := IsLocalization.Away.surj δS t
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective s
    have ht : t = algebraMap _ T (π p) * u ^ n := by
      calc t = t * (g₀ δ * u) ^ n := by rw [hδu, one_pow, mul_one]
        _ = (t * algebraMap _ T δS ^ n) * u ^ n := by rw [hg₀δ]; ring
        _ = _ := by rw [hn]
    rw [ht]
    exact f.range.mul_mem (hv p) (f.range.pow_mem hii n)

  have hNoeth : IsNoetherianRing R := Algebra.FiniteType.isNoetherianRing K R
  set I := Ideal.span (Set.range fun i =>
      ∑ j, MvPolynomial.C (L i j) * MvPolynomial.X j) with hI
  refine s3 _ (fun a : {a : ρ → ι' // Function.Injective a} =>
    Ideal.Quotient.mk I (MvPolynomial.C (Matrix.of fun i k => L i (a.1 k)).det)) ?_ _ ?_
  · have hrange : (Set.range fun a : {a : ρ → ι' // Function.Injective a} =>
        Ideal.Quotient.mk I (MvPolynomial.C (Matrix.of fun i k => L i (a.1 k)).det)) =
        ((Ideal.Quotient.mk I).comp MvPolynomial.C) '' (Set.range fun a :
          {a : ρ → ι' // Function.Injective a} => (Matrix.of fun i k => L i (a.1 k)).det) := by
      rw [← Set.range_comp]
      rfl
    rw [hrange, ← Ideal.map_span, s1, Ideal.map_top]
  · rintro ⟨a, ha⟩
    obtain ⟨f, hf⟩ := s4 a ha
    have hle : Fintype.card ρ ≤ Fintype.card ι' := Fintype.card_le_of_injective a ha
    have hc : Fintype.card {j : ι' // j ∉ Set.range a} =
        Fintype.card ι' - Fintype.card ρ := by
      rw [Fintype.card_subtype_compl, ← Set.card_range_of_injective ha]
      try (congr 1; exact Fintype.card_congr (Equiv.refl _))
    refine (ringKrullDim_le_of_surjective f hf).trans ?_
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ENat.card_eq_coe_fintype_card, hc,
      show e + Fintype.card ι' - Fintype.card ρ = e + (Fintype.card ι' - Fintype.card ρ) by omega,
      Nat.cast_add]
    exact add_le_add ((s2 _).trans hR) (le_of_eq rfl)

theorem wc_ldp_axis_incidence (K : Type u) [Field K] (n : ℕ) (Q : Type) [Fintype Q] [Nonempty Q]
    (R : Type u) [CommRing R] [Algebra K R] [Algebra.FiniteType K R]
    (ℓ : Q → R) (D : Fin n → Derivation K R R)
    (hC : ringKrullDim (MvPolynomial (Fin 2 × Q) R ⧸ Ideal.span (Set.range
        fun o : Option (Option (Fin n)) => ∑ j : Fin 2 × Q, MvPolynomial.C
          (Option.elim o (if j.1 = 0 then ℓ j.2 else 0)
            (fun o' => if j.1 = 1 then Option.elim o' (ℓ j.2) (fun k => D k (ℓ j.2)) else 0)) *
          MvPolynomial.X j)) ≤ ((2 * Fintype.card Q - 2 : ℕ) : WithBot ℕ∞)) :
    ∃ (A : Type u) (_ : CommRing A) (_ : Algebra K A) (_ : Algebra.FiniteType K A)
      (φ₀ φ₁ : MvPolynomial (Fin 2 × Q) K →ₐ[K] A),
      ringKrullDim A < (Fintype.card (Fin 2 × Q) : WithBot ℕ∞) ∧
      ∀ (χ : R →ₐ[K] K) (v : Fin 2 × Q → K) (c : Fin 2 → K), c ≠ 0 →
        χ (∑ q, v (0, q) • ℓ q) = 0 → χ (∑ q, v (1, q) • ℓ q) = 0 →
        (∀ k, χ (D k (∑ q, (c 0 * v (0, q) + c 1 * v (1, q)) • ℓ q)) = 0) →
        (∃ ψ : A →ₐ[K] K, ψ.comp φ₀ = MvPolynomial.aeval v) ∨
        (∃ ψ : A →ₐ[K] K, ψ.comp φ₁ = MvPolynomial.aeval v) :=
by
  classical
  have hRN : IsNoetherianRing R := Algebra.FiniteType.isNoetherianRing K R
  set I : Ideal (MvPolynomial (Fin 2 × Q) R) := Ideal.span (Set.range
        fun o : Option (Option (Fin n)) => ∑ j : Fin 2 × Q, MvPolynomial.C
          (Option.elim o (if j.1 = 0 then ℓ j.2 else 0)
            (fun o' => if j.1 = 1 then Option.elim o' (ℓ j.2) (fun k => D k (ℓ j.2)) else 0)) *
          MvPolynomial.X j) with hIdef

  have hdim : ringKrullDim (MvPolynomial Unit (MvPolynomial (Fin 2 × Q) R ⧸ I)) <
      (Fintype.card (Fin 2 × Q) : WithBot ℕ∞) := by
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing]
    have hcard : (ENat.card Unit : ℕ∞) = 1 := by simp
    rw [hcard]
    have hpos : 0 < Fintype.card Q := Fintype.card_pos
    have h1 : ringKrullDim (MvPolynomial (Fin 2 × Q) R ⧸ I) + ((1 : ℕ∞) : WithBot ℕ∞) ≤
        ((2 * Fintype.card Q - 2 : ℕ) : WithBot ℕ∞) + ((1 : ℕ∞) : WithBot ℕ∞) :=
      add_le_add hC le_rfl
    have h2 : ((2 * Fintype.card Q - 2 : ℕ) : WithBot ℕ∞) + ((1 : ℕ∞) : WithBot ℕ∞) =
        ((2 * Fintype.card Q - 2 + 1 : ℕ) : WithBot ℕ∞) := by
      push_cast; rfl
    have h3 : ((2 * Fintype.card Q - 2 + 1 : ℕ) : WithBot ℕ∞) <
        ((Fintype.card (Fin 2 × Q) : ℕ) : WithBot ℕ∞) := by
      rw [Fintype.card_prod, Fintype.card_fin]
      exact_mod_cast (by omega : 2 * Fintype.card Q - 2 + 1 < 2 * Fintype.card Q)
    exact lt_of_le_of_lt (h1.trans h2.le) h3

  have point : ∀ (χ : R →ₐ[K] K) (V W : Q → K) (τ₀ : K),
      ∑ q, χ (ℓ q) * V q = 0 → ∑ q, χ (ℓ q) * W q = 0 →
      (∀ k, ∑ q, χ (D k (ℓ q)) * W q = 0) →
      ∃ ψ : MvPolynomial Unit (MvPolynomial (Fin 2 × Q) R ⧸ I) →ₐ[K] K,
        (∀ q, ψ (MvPolynomial.C (Ideal.Quotient.mk I (MvPolynomial.X (0, q)))) = V q) ∧
        (∀ q, ψ (MvPolynomial.C (Ideal.Quotient.mk I (MvPolynomial.X (1, q)))) = W q) ∧
        ψ (MvPolynomial.X ()) = τ₀ := by
    intro χ V W τ₀ hV hW hD
    let g : Fin 2 × Q → K := fun j => if j.1 = 0 then V j.2 else W j.2
    let P : MvPolynomial (Fin 2 × Q) R →+* K := MvPolynomial.eval₂Hom (χ : R →+* K) g
    have hP : ∀ a ∈ I, P a = 0 := by
      have hle : I ≤ RingHom.ker P := by
        rw [hIdef, Ideal.span_le, Set.range_subset_iff]
        intro o
        rw [SetLike.mem_coe, RingHom.mem_ker]
        simp only [P, map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
        rw [Fintype.sum_prod_type, Fin.sum_univ_two]
        rcases o with _ | _ | k
        · simp [g]
          exact hV
        · simp [g]
          exact hW
        · simp [g]
          exact hD k
      exact fun a ha => (RingHom.mem_ker).mp (hle ha)
    let Pb : (MvPolynomial (Fin 2 × Q) R ⧸ I) →+* K := Ideal.Quotient.lift I P hP
    let ψ₀ : MvPolynomial Unit (MvPolynomial (Fin 2 × Q) R ⧸ I) →+* K :=
      MvPolynomial.eval₂Hom Pb (fun _ => τ₀)
    have hcomm : ∀ r : K, ψ₀ (algebraMap K _ r) = r := by
      intro r
      rw [MvPolynomial.algebraMap_apply, ← Ideal.Quotient.mk_algebraMap,
        MvPolynomial.algebraMap_apply]
      simp [ψ₀, Pb, P]
    refine ⟨{ ψ₀ with commutes' := hcomm }, ?_, ?_, ?_⟩
    · intro q
      show ψ₀ _ = _
      simp [ψ₀, Pb, P, g]
    · intro q
      show ψ₀ _ = _
      simp [ψ₀, Pb, P, g]
    · show ψ₀ _ = _
      simp [ψ₀]

  have L1 : ∀ (χ : R →ₐ[K] K) (w : Q → K), χ (∑ q, w q • ℓ q) = ∑ q, χ (ℓ q) * w q := by
    intro χ w
    rw [map_sum]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    rw [map_smul, smul_eq_mul, mul_comm]
  have L2 : ∀ (χ : R →ₐ[K] K) (k : Fin n) (w : Q → K),
      χ (D k (∑ q, w q • ℓ q)) = ∑ q, χ (D k (ℓ q)) * w q := by
    intro χ k w
    rw [map_sum, map_sum]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    rw [Derivation.map_smul, map_smul, smul_eq_mul, mul_comm]

  let Vb : Q → MvPolynomial Unit (MvPolynomial (Fin 2 × Q) R ⧸ I) := fun q =>
    MvPolynomial.C (Ideal.Quotient.mk I (MvPolynomial.X (0, q)))
  let Wb : Q → MvPolynomial Unit (MvPolynomial (Fin 2 × Q) R ⧸ I) := fun q =>
    MvPolynomial.C (Ideal.Quotient.mk I (MvPolynomial.X (1, q)))
  let τ : MvPolynomial Unit (MvPolynomial (Fin 2 × Q) R ⧸ I) := MvPolynomial.X ()
  let g₀ : Fin 2 × Q → MvPolynomial Unit (MvPolynomial (Fin 2 × Q) R ⧸ I) := fun j =>
    if j.1 = 0 then Wb j.2 - τ * Vb j.2 else Vb j.2
  let g₁ : Fin 2 × Q → MvPolynomial Unit (MvPolynomial (Fin 2 × Q) R ⧸ I) := fun j =>
    if j.1 = 0 then Vb j.2 else Wb j.2 - τ * Vb j.2
  refine ⟨MvPolynomial Unit (MvPolynomial (Fin 2 × Q) R ⧸ I), inferInstance, inferInstance,
    inferInstance, MvPolynomial.aeval g₀, MvPolynomial.aeval g₁, hdim, ?_⟩
  intro χ v c hc e0 e1 ek
  have s0 : ∑ q, χ (ℓ q) * v (0, q) = 0 := by rw [← e0, L1]
  have s1 : ∑ q, χ (ℓ q) * v (1, q) = 0 := by rw [← e1, L1]
  have sk : ∀ k, ∑ q, χ (D k (ℓ q)) * (c 0 * v (0, q) + c 1 * v (1, q)) = 0 := by
    intro k; rw [← ek k, L2]
  by_cases h0 : c 0 = 0
  ·
    have h1 : c 1 ≠ 0 := by
      intro h1
      apply hc
      funext i
      fin_cases i
      · simpa using h0
      · simpa using h1
    have hD : ∀ k, ∑ q, χ (D k (ℓ q)) * v (1, q) = 0 := by
      intro k
      have e : c 1 * ∑ q, χ (D k (ℓ q)) * v (1, q) =
          ∑ q, χ (D k (ℓ q)) * (c 0 * v (0, q) + c 1 * v (1, q)) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun q _ => ?_)
        rw [h0]; ring
      rw [sk k] at e
      exact (mul_eq_zero.mp e).resolve_left h1
    obtain ⟨ψ, hψV, hψW, hψτ⟩ := point χ (fun q => v (0, q)) (fun q => v (1, q)) 0 s0 s1 hD
    right
    refine ⟨ψ, MvPolynomial.algHom_ext (fun j => ?_)⟩
    rcases j with ⟨b, q⟩
    fin_cases b
    · simp only [AlgHom.comp_apply, MvPolynomial.aeval_X, g₁]
      simp only [Fin.zero_eta, Fin.isValue, ite_true]
      exact hψV q
    · simp only [AlgHom.comp_apply, MvPolynomial.aeval_X, g₁]
      simp only [Fin.mk_one, Fin.isValue, one_ne_zero, ite_false]
      rw [map_sub, map_mul, hψW, hψτ, hψV]
      ring
  ·
    have hW : ∑ q, χ (ℓ q) * (v (0, q) + c 1 / c 0 * v (1, q)) = 0 := by
      have e : ∑ q, χ (ℓ q) * (v (0, q) + c 1 / c 0 * v (1, q)) =
          ∑ q, χ (ℓ q) * v (0, q) + c 1 / c 0 * ∑ q, χ (ℓ q) * v (1, q) := by
        rw [Finset.mul_sum, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun q _ => ?_)
        ring
      rw [e, s0, s1]; ring
    have hcc : c 0 * (c 1 / c 0) = c 1 := mul_div_cancel₀ _ h0
    have hD : ∀ k, ∑ q, χ (D k (ℓ q)) * (v (0, q) + c 1 / c 0 * v (1, q)) = 0 := by
      intro k
      have e : c 0 * ∑ q, χ (D k (ℓ q)) * (v (0, q) + c 1 / c 0 * v (1, q)) =
          ∑ q, χ (D k (ℓ q)) * (c 0 * v (0, q) + c 1 * v (1, q)) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun q _ => ?_)
        linear_combination (χ (D k (ℓ q)) * v (1, q)) * hcc
      rw [sk k] at e
      exact (mul_eq_zero.mp e).resolve_left h0
    obtain ⟨ψ, hψV, hψW, hψτ⟩ := point χ (fun q => v (1, q))
      (fun q => v (0, q) + c 1 / c 0 * v (1, q)) (c 1 / c 0) s1 hW hD
    left
    refine ⟨ψ, MvPolynomial.algHom_ext (fun j => ?_)⟩
    rcases j with ⟨b, q⟩
    fin_cases b
    · simp only [AlgHom.comp_apply, MvPolynomial.aeval_X, g₀]
      simp only [Fin.zero_eta, Fin.isValue, ite_true]
      rw [map_sub, map_mul, hψW, hψτ, hψV]
      ring
    · simp only [AlgHom.comp_apply, MvPolynomial.aeval_X, g₀]
      simp only [Fin.mk_one, Fin.isValue, one_ne_zero, ite_false]
      exact hψV q

theorem wc_ldp_extend_params (K : Type u) [Field K] (O : Type u) [CommRing O] [IsLocalRing O]
    (κ : K →+* O) (hres : ∀ y : O, ∃ c : K, y - κ c ∈ IsLocalRing.maximalIdeal O)
    (n : ℕ) (hn : 2 ≤ n) (s : Fin n → O)
    (hm : IsLocalRing.maximalIdeal O = Ideal.span (Set.range s))
    (g₀ g₁ : O) (hg₀ : g₀ ∈ IsLocalRing.maximalIdeal O) (hg₁ : g₁ ∈ IsLocalRing.maximalIdeal O)
    (hind : ∀ l₀ l₁ : K, κ l₀ * g₀ + κ l₁ * g₁ ∈ IsLocalRing.maximalIdeal O ^ 2 → l₀ = 0 ∧ l₁ = 0) :
    ∃ t : Fin (n - 2) → O,
      IsLocalRing.maximalIdeal O = Ideal.span (insert g₀ (insert g₁ (Set.range t))) :=
by
  classical
  have exch : ∀ (G : Set O) (k : ℕ) (u : Fin (k + 1) → O),
      IsLocalRing.maximalIdeal O = Ideal.span (G ∪ Set.range u) →
      ∀ g ∈ IsLocalRing.maximalIdeal O,
      (∀ z ∈ Ideal.span G, g - z ∉ IsLocalRing.maximalIdeal O ^ 2) →
      ∃ v : Fin k → O, IsLocalRing.maximalIdeal O = Ideal.span (insert g (G ∪ Set.range v)) := by
    intro G k u hMu g hgM hg
    have huM : ∀ l, u l ∈ IsLocalRing.maximalIdeal O := fun l => by
      rw [hMu]; exact Ideal.subset_span (Set.mem_union_right _ (Set.mem_range_self l))
    have hGM : ∀ x ∈ G, x ∈ IsLocalRing.maximalIdeal O := fun x hx => by
      rw [hMu]; exact Ideal.subset_span (Set.mem_union_left _ hx)
    have hg' := hgM
    rw [hMu, Ideal.span_union, Submodule.mem_sup] at hg'
    obtain ⟨z, hz, w, hw, hzw⟩ := hg'
    obtain ⟨a, ha⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hw
    have hunit : ∃ i, IsUnit (a i) := by
      by_contra hcon
      push_neg at hcon
      apply hg z hz
      have e : g - z = w := by rw [← hzw]; ring
      rw [e, ← ha, pow_two]
      refine Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_mul ?_ (huM i))
      exact (IsLocalRing.mem_maximalIdeal _).mpr (hcon i)
    obtain ⟨i, hi⟩ := hunit
    obtain ⟨b, hb⟩ := hi.exists_left_inv
    refine ⟨fun j => u (i.succAbove j), le_antisymm ?_ ?_⟩
    · rw [hMu, Ideal.span_le]
      rintro x (hx | ⟨j, rfl⟩)
      · exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_union_left _ hx))
      · by_cases hj : j = i
        · subst hj
          have e : g - z = a j * u j + ∑ l : Fin k, a (j.succAbove l) * u (j.succAbove l) := by
            rw [← hzw, ← ha, Fin.sum_univ_succAbove _ j]
            ring
          have key : u j = b * (g - z - ∑ l : Fin k, a (j.succAbove l) * u (j.succAbove l)) := by
            rw [e, add_sub_cancel_right, ← mul_assoc, hb, one_mul]
          rw [key]
          refine Ideal.mul_mem_left _ _ (Ideal.sub_mem _ (Ideal.sub_mem _ ?_ ?_)
            (Ideal.sum_mem _ fun l _ => Ideal.mul_mem_left _ _ ?_))
          · exact Ideal.subset_span (Set.mem_insert _ _)
          · exact Ideal.span_mono
              (fun x hx => Set.mem_insert_of_mem _ (Set.mem_union_left _ hx)) hz
          · exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_union_right _ ⟨l, rfl⟩))
        · obtain ⟨l, hl⟩ := Fin.exists_succAbove_eq hj
          rw [← hl]
          exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_union_right _ ⟨l, rfl⟩))
    · rw [Ideal.span_le]
      rintro x (rfl | hx | ⟨j, rfl⟩)
      · exact hgM
      · exact hGM x hx
      · exact huM _
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le' hn
  show ∃ t : Fin k → O,
    IsLocalRing.maximalIdeal O = Ideal.span (insert g₀ (insert g₁ (Set.range t)))
  have h0 : ∀ z ∈ Ideal.span (∅ : Set O), g₀ - z ∉ IsLocalRing.maximalIdeal O ^ 2 := by
    intro z hz hmem
    rw [Ideal.span_empty, Ideal.mem_bot] at hz
    rw [hz, sub_zero] at hmem
    have := hind 1 0 (by rw [map_one, map_zero, one_mul, zero_mul, add_zero]; exact hmem)
    exact one_ne_zero this.1
  obtain ⟨v₁, hv₁⟩ := exch ∅ (k + 1) s (by rw [Set.empty_union]; exact hm) g₀ hg₀ h0
  have h1 : ∀ z ∈ Ideal.span ({g₀} : Set O), g₁ - z ∉ IsLocalRing.maximalIdeal O ^ 2 := by
    intro z hz hmem
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp hz
    obtain ⟨c, hc⟩ := hres b
    have h2 : (b - κ c) * g₀ ∈ IsLocalRing.maximalIdeal O ^ 2 := by
      rw [pow_two]; exact Ideal.mul_mem_mul hc hg₀
    have e : κ (-c) * g₀ + κ 1 * g₁ = (g₁ - b * g₀) + (b - κ c) * g₀ := by
      rw [map_neg, map_one]; ring
    have := hind (-c) 1 (by rw [e]; exact Ideal.add_mem _ hmem h2)
    exact one_ne_zero this.2
  obtain ⟨v₂, hv₂⟩ := exch {g₀} k v₁ (by rw [hv₁, Set.empty_union, Set.insert_eq]) g₁ hg₁ h1
  refine ⟨v₂, ?_⟩
  rw [hv₂, Set.singleton_union, Set.insert_comm]

theorem wcpa_dj_sst_smooth_reduced : ∀ {Y B : Scheme.{u}} [AlgebraicGeometry.IsIntegral B] (g : Y ⟶ B)
    (n : ℕ), SmoothOfRelativeDimension n g → AlgebraicGeometry.IsReduced Y :=
by
  intro Y B _ g n hsm
  haveI hBirr : IrreducibleSpace B := irreducibleSpace_of_isIntegral B

  have s2 : AlgebraicGeometry.IsReduced (Limits.pullback g (B.fromSpecStalk (genericPoint B))) ∧
      True := by
    refine ⟨?_, trivial⟩
    haveI := hsm
    haveI hsmG : SmoothOfRelativeDimension n
        (Limits.pullback.snd g (B.fromSpecStalk (genericPoint B))) :=
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension n)
        (IsPullback.of_hasPullback g (B.fromSpecStalk (genericPoint B))) hsm
    have hd := wcpa_smooth_stalk_isDomain (B.presheaf.stalk (genericPoint B))
      (Limits.pullback g (B.fromSpecStalk (genericPoint B)))
      (Limits.pullback.snd g (B.fromSpecStalk (genericPoint B))) n
    haveI : ∀ z : ↥(Limits.pullback g (B.fromSpecStalk (genericPoint B))),
        _root_.IsReduced ((Limits.pullback g (B.fromSpecStalk (genericPoint B))).presheaf.stalk z) :=
      fun z => by
        haveI := hd z
        infer_instance
    exact isReduced_of_isReduced_stalk _

  have s4 : ∀ (S X : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [IrreducibleSpace S] (f : X ⟶ S)
      (V : S.Opens)
      (hV : IsAffineOpen V) (W : X.Opens) (hW : IsAffineOpen W) (e : W ≤ f ⁻¹ᵁ V)
      (hη : genericPoint S ∈ V),
      AlgebraicGeometry.IsReduced (Limits.pullback f (S.fromSpecStalk (genericPoint S))) →
      AlgebraicGeometry.IsReduced (Limits.pullback (Spec.map (f.appLE V W e))
        (Spec.map (S.presheaf.germ V (genericPoint S) hη))) ∧ True := by
    intro S X _ _ f V hV W hW e hη hG
    refine ⟨?_, trivial⟩
    have h0 : IsPullback (Limits.pullback.fst (Spec.map (f.appLE V W e))
        (Spec.map (S.presheaf.germ V (genericPoint S) hη)))
        (Limits.pullback.snd (Spec.map (f.appLE V W e))
          (Spec.map (S.presheaf.germ V (genericPoint S) hη)))
        (Spec.map (f.appLE V W e) ≫ hV.fromSpec)
        (Spec.map (S.presheaf.germ V (genericPoint S) hη) ≫ hV.fromSpec) :=
      IsPullback.of_isLimit (Limits.pullbackIsPullbackOfCompMono (Spec.map (f.appLE V W e))
        (Spec.map (S.presheaf.germ V (genericPoint S) hη)) hV.fromSpec)
    have e1 : Spec.map (S.presheaf.germ V (genericPoint S) hη) ≫ hV.fromSpec =
        S.fromSpecStalk (genericPoint S) := hV.fromSpecStalk_eq_fromSpecStalk hη
    rw [IsAffineOpen.SpecMap_appLE_fromSpec f hV hW e, e1] at h0
    have sqG := (IsPullback.of_hasPullback f (S.fromSpecStalk (genericPoint S))).flip
    have w : (Limits.pullback.fst (Spec.map (f.appLE V W e))
        (Spec.map (S.presheaf.germ V (genericPoint S) hη)) ≫ hW.fromSpec) ≫ f =
        Limits.pullback.snd (Spec.map (f.appLE V W e))
          (Spec.map (S.presheaf.germ V (genericPoint S) hη)) ≫ S.fromSpecStalk (genericPoint S) := by
      rw [Category.assoc]
      exact h0.w
    have Sq := IsPullback.of_right (h₁₁ := Limits.pullback.lift _ _ w) ?_
      (Limits.pullback.lift_fst _ _ w) sqG
    · haveI : IsOpenImmersion (Limits.pullback.lift _ _ w) :=
        MorphismProperty.of_isPullback (P := @IsOpenImmersion) Sq.flip inferInstance
      exact isReduced_of_isOpenImmersion (Limits.pullback.lift _ _ w)
    · rw [Limits.pullback.lift_snd]
      exact h0.flip

  have s5 : ∀ (S X : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [IrreducibleSpace S] (f : X ⟶ S),
      Flat f →
      (∀ (V : S.Opens) (_ : IsAffineOpen V) (W : X.Opens) (_ : IsAffineOpen W) (e : W ≤ f ⁻¹ᵁ V)
        (hη : genericPoint S ∈ V), AlgebraicGeometry.IsReduced (Limits.pullback
          (Spec.map (f.appLE V W e)) (Spec.map (S.presheaf.germ V (genericPoint S) hη)))) →
      AlgebraicGeometry.IsReduced X ∧ True := by
    intro S X _ _ f hf H
    haveI := hf
    have hst : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := by
      intro x
      obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset (x := f x) (U := ⊤) trivial
      obtain ⟨W, hW, hxW, hWV⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := f ⁻¹ᵁ V) hxV
      have hη : genericPoint S ∈ V := (genericPoint_specializes (f x)).mem_open V.isOpen hxV
      have hT := H V hV W hW hWV hη
      letI := (f.appLE V W hWV).hom.toAlgebra
      letI := (S.presheaf.germ V (genericPoint S) hη).hom.toAlgebra
      haveI : Module.Flat Γ(S, V) Γ(X, W) := Flat.flat_appLE f hV hW hWV
      have hinj : Function.Injective (algebraMap Γ(S, V) (S.presheaf.stalk (genericPoint S))) :=
        germ_injective_of_isIntegral S _ hη
      have hinc := Algebra.TensorProduct.includeLeft_injective (R := Γ(S, V)) (S := Γ(S, V))
        (A := Γ(X, W)) (B := S.presheaf.stalk (genericPoint S)) hinj
      haveI : AlgebraicGeometry.IsReduced
          (Spec (.of (TensorProduct Γ(S, V) Γ(X, W) (S.presheaf.stalk (genericPoint S))))) := by
        haveI : AlgebraicGeometry.IsReduced (Limits.pullback
            (Spec.map (CommRingCat.ofHom (algebraMap Γ(S, V) Γ(X, W))))
            (Spec.map (CommRingCat.ofHom
              (algebraMap Γ(S, V) (S.presheaf.stalk (genericPoint S)))))) := hT
        exact isReduced_of_isOpenImmersion (pullbackSpecIso _ _ _).inv
      haveI : _root_.IsReduced
          (TensorProduct Γ(S, V) Γ(X, W) (S.presheaf.stalk (genericPoint S))) :=
        (affine_isReduced_iff (CommRingCat.of
          (TensorProduct Γ(S, V) Γ(X, W) (S.presheaf.stalk (genericPoint S))))).mp inferInstance
      haveI : _root_.IsReduced Γ(X, W) := isReduced_of_injective _ hinc
      letI := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxW⟩ : W)
      haveI := hW.isLocalization_stalk ⟨x, hxW⟩
      exact isReduced_localizationPreserves (hW.primeIdealOf ⟨x, hxW⟩).asIdeal.primeCompl
        (X.presheaf.stalk (⟨x, hxW⟩ : W)) ‹_›
    exact ⟨isReduced_of_isReduced_stalk X, trivial⟩

  haveI := hsm
  haveI : Smooth g := SmoothOfRelativeDimension.smooth n g
  have hfl : Flat g := inferInstance
  exact (s5 B Y g hfl (fun V hV W hW e hη => (s4 B Y g V hV W hW e hη s2.1).1)).1

theorem wc_ldp_axis_generic (K : Type u) [Field K] [IsAlgClosed K] (N n : ℕ) (hn2 : 2 ≤ n)
    (X : Over (Spec (.of K))) [GeometricallyIrreducible X.hom] [IsProper X.hom]
    [SmoothOfRelativeDimension n X.hom] (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι)
    (hιX : ι ≫ wcProjKStr K N = X.hom) :
    ∃ Φ : MvPolynomial (Fin 2 × Fin (N + 1) × Fin (N + 1)) K, Φ ≠ 0 ∧
      ∀ v : Fin 2 × Fin (N + 1) × Fin (N + 1) → K, MvPolynomial.eval v Φ ≠ 0 →
        (∃ x : X.left, ¬ wcLdpOnAxis K N ι (wcLdpQuad K N fun p q => v (0, p, q))
            (wcLdpQuad K N fun p q => v (1, p, q)) x) ∧
        ∀ x : X.left, IsClosed ({x} : Set X.left) →
          wcLdpAxisReg K N ι (wcLdpQuad K N fun p q => v (0, p, q))
            (wcLdpQuad K N fun p q => v (1, p, q)) x :=
by
  classical
  obtain ⟨m, a, R, _, _, hFT, hDom, hR, u, t, D, hub, hDt, hker, hcharts⟩ :=
    wc_ldp_smooth_quadric_charts K N n X ι hι hιX

  have unitFact : ∀ (O : Type u) [CommRing O] [IsLocalRing O] (κ : K →+* O) (d : K),
      κ d ∈ IsLocalRing.maximalIdeal O → d = 0 := by
    intro O _ _ κ d hd
    by_contra hne
    exact (IsLocalRing.mem_maximalIdeal _).mp hd ((isUnit_iff_ne_zero.mpr hne).map κ)

  have leib : ∀ (O : Type u) [CommRing O] [IsLocalRing O] (δ : O →+ O),
      (∀ f g : O, δ (f * g) = f * δ g + g * δ f) → ∀ y : O,
      y ∈ IsLocalRing.maximalIdeal O ^ 2 → δ y ∈ IsLocalRing.maximalIdeal O := by
    intro O _ _ δ hδ y hy
    rw [pow_two] at hy
    refine Submodule.mul_induction_on hy ?_ ?_
    · intro a ha b hb
      rw [hδ]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_right _ _ hb)
    · intro a b ha hb
      rw [map_add]
      exact Ideal.add_mem _ ha hb

  have key : ∀ j : Fin m, ∃ Φj : MvPolynomial (Fin 2 × Fin (N + 1) × Fin (N + 1)) K, Φj ≠ 0 ∧
      ∀ (χ : R j →ₐ[K] K) (v : Fin 2 × Fin (N + 1) × Fin (N + 1) → K) (c : Fin 2 → K), c ≠ 0 →
        χ (∑ q, v (0, q) • (u j q.1 * u j q.2)) = 0 →
        χ (∑ q, v (1, q) • (u j q.1 * u j q.2)) = 0 →
        (∀ k, χ (D j k (∑ q, (c 0 * v (0, q) + c 1 * v (1, q)) • (u j q.1 * u j q.2))) = 0) →
        MvPolynomial.eval v Φj = 0 := by
    intro j
    haveI := hFT j
    have hsurj : ∀ (χ : R j →ₐ[K] K) (y : Option (Option (Fin n)) → K),
        ∃ w : Fin 2 × (Fin (N + 1) × Fin (N + 1)) → K, ∀ i, ∑ jj, w jj * χ
          (Option.elim i (if jj.1 = 0 then u j jj.2.1 * u j jj.2.2 else 0)
            (fun o' => if jj.1 = 1 then Option.elim o' (u j jj.2.1 * u j jj.2.2)
              (fun k => D j k (u j jj.2.1 * u j jj.2.2)) else 0)) = y i := by
      intro χ y
      obtain ⟨w0, hw0a, -⟩ := wc_ldp_quadric_jets_one K (R j) N n (a j) (u j) (hub j) (t j) (D j)
        (hDt j) χ (hker j χ) (y none) (fun _ => 0)
      obtain ⟨w1, hw1a, hw1b⟩ := wc_ldp_quadric_jets_one K (R j) N n (a j) (u j) (hub j) (t j)
        (D j) (hDt j) χ (hker j χ) (y (some none)) (fun k => y (some (some k)))
      refine ⟨fun jj => if jj.1 = 0 then w0 jj.2 else w1 jj.2, ?_⟩
      intro i
      rw [Fintype.sum_prod_type, Fin.sum_univ_two]
      rcases i with _ | _ | k
      · rw [← hw0a]
        simp [map_sum, map_smul, smul_eq_mul]
      · rw [← hw1a]
        simp [map_sum, map_smul, smul_eq_mul]
      · rw [← hw1b k]
        simp [map_sum, map_smul, smul_eq_mul, mul_add]
    have hC := wc_ldp_linear_fibres_dim K (R j) n (hR j) (Option (Option (Fin n)))
      (Fin 2 × (Fin (N + 1) × Fin (N + 1)))
      (fun i jj => Option.elim i (if jj.1 = 0 then u j jj.2.1 * u j jj.2.2 else 0)
            (fun o' => if jj.1 = 1 then Option.elim o' (u j jj.2.1 * u j jj.2.2)
              (fun k => D j k (u j jj.2.1 * u j jj.2.2)) else 0)) hsurj
    have hnat : n + Fintype.card (Fin 2 × (Fin (N + 1) × Fin (N + 1))) -
        Fintype.card (Option (Option (Fin n))) =
          2 * Fintype.card (Fin (N + 1) × Fin (N + 1)) - 2 := by
      rw [Fintype.card_prod (Fin 2), Fintype.card_option, Fintype.card_option, Fintype.card_fin,
        Fintype.card_fin]
      omega
    rw [hnat] at hC
    obtain ⟨A, _, _, _, φ₀, φ₁, hdimA, hpt⟩ := wc_ldp_axis_incidence K n
      (Fin (N + 1) × Fin (N + 1)) (R j) (fun q => u j q.1 * u j q.2) (D j) hC
    obtain ⟨Φ0, h0ne, h0⟩ := wc_ldp_alg_dependence K A φ₀ hdimA
    obtain ⟨Φ1, h1ne, h1⟩ := wc_ldp_alg_dependence K A φ₁ hdimA
    refine ⟨Φ0 * Φ1, mul_ne_zero h0ne h1ne, ?_⟩
    intro χ v c hc e0 e1 ek
    rcases hpt χ v c hc e0 e1 ek with ⟨ψ, hψ⟩ | ⟨ψ, hψ⟩
    · have e : MvPolynomial.eval v Φ0 = 0 := by
        rw [← MvPolynomial.coe_aeval_eq_eval, ← hψ]
        exact (congrArg ψ h0).trans (map_zero ψ)
      rw [map_mul, e, zero_mul]
    · have e : MvPolynomial.eval v Φ1 = 0 := by
        rw [← MvPolynomial.coe_aeval_eq_eval, ← hψ]
        exact (congrArg ψ h1).trans (map_zero ψ)
      rw [map_mul, e, mul_zero]
  choose Φj hΦj0 hΦj using key
  refine ⟨∏ j, Φj j, Finset.prod_ne_zero_iff.mpr (fun j _ => hΦj0 j), ?_⟩
  intro v hv
  rw [map_prod] at hv
  have hvj : ∀ j, MvPolynomial.eval v (Φj j) ≠ 0 := fun j =>
    Finset.prod_ne_zero_iff.mp hv j (Finset.mem_univ j)

  have indep : ∀ (x : X.left), IsClosed ({x} : Set X.left) → ∀ (b : Fin (N + 1))
      (hx : x ∈ ι ⁻¹ᵁ wcSgD K N b),
      wcLdpGerm K N ι (wcLdpQuad K N fun p q => v (0, p, q)) b x hx ∈
        IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) →
      wcLdpGerm K N ι (wcLdpQuad K N fun p q => v (1, p, q)) b x hx ∈
        IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) →
      ∀ l₀ l₁ : K, wcLdpConst K X.hom x l₀ *
          wcLdpGerm K N ι (wcLdpQuad K N fun p q => v (0, p, q)) b x hx +
        wcLdpConst K X.hom x l₁ * wcLdpGerm K N ι (wcLdpQuad K N fun p q => v (1, p, q)) b x hx ∈
          IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ^ 2 → l₀ = 0 ∧ l₁ = 0 := by
    intro x hxc b hx hg0 hg1 l₀ l₁ hsq
    by_contra hne
    obtain ⟨j, -, χ, lam, δ, hlamχ, -, hgerm, -, hδ, -, hδlam⟩ := hcharts x hxc b hx
    have hval : ∀ r : R j, lam r ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) →
        χ r = 0 := by
      intro r hr
      apply unitFact _ (wcLdpConst K X.hom x)
      have := Ideal.sub_mem _ hr (hlamχ r)
      rwa [sub_sub_cancel] at this
    have hg0' : lam (∑ q, v (0, q) • (u j q.1 * u j q.2)) =
        wcLdpGerm K N ι (wcLdpQuad K N fun p q => v (0, p, q)) b x hx :=
      hgerm (fun q => v (0, q))
    have hg1' : lam (∑ q, v (1, q) • (u j q.1 * u j q.2)) =
        wcLdpGerm K N ι (wcLdpQuad K N fun p q => v (1, p, q)) b x hx :=
      hgerm (fun q => v (1, q))
    have e0 : χ (∑ q, v (0, q) • (u j q.1 * u j q.2)) = 0 := hval _ (by rw [hg0']; exact hg0)
    have e1 : χ (∑ q, v (1, q) • (u j q.1 * u j q.2)) = 0 := hval _ (by rw [hg1']; exact hg1)
    have hsplit : (∑ q, (l₀ * v (0, q) + l₁ * v (1, q)) • (u j q.1 * u j q.2)) =
        algebraMap K (R j) l₀ * (∑ q, v (0, q) • (u j q.1 * u j q.2)) +
          algebraMap K (R j) l₁ * (∑ q, v (1, q) • (u j q.1 * u j q.2)) := by
      rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun q _ => ?_)
      rw [add_smul, mul_smul, mul_smul, Algebra.smul_def l₀, Algebra.smul_def l₁]
    have a0 : lam (algebraMap K (R j) l₀) - wcLdpConst K X.hom x l₀ ∈
        IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) := by
      simpa using hlamχ (algebraMap K (R j) l₀)
    have a1 : lam (algebraMap K (R j) l₁) - wcLdpConst K X.hom x l₁ ∈
        IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) := by
      simpa using hlamχ (algebraMap K (R j) l₁)
    have hlamh : lam (∑ q, (l₀ * v (0, q) + l₁ * v (1, q)) • (u j q.1 * u j q.2)) ∈
        IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ^ 2 := by
      rw [hsplit, map_add, map_mul, map_mul, hg0', hg1']
      have hre : lam (algebraMap K (R j) l₀) *
            wcLdpGerm K N ι (wcLdpQuad K N fun p q => v (0, p, q)) b x hx +
          lam (algebraMap K (R j) l₁) *
            wcLdpGerm K N ι (wcLdpQuad K N fun p q => v (1, p, q)) b x hx =
          (lam (algebraMap K (R j) l₀) - wcLdpConst K X.hom x l₀) *
            wcLdpGerm K N ι (wcLdpQuad K N fun p q => v (0, p, q)) b x hx +
          (lam (algebraMap K (R j) l₁) - wcLdpConst K X.hom x l₁) *
            wcLdpGerm K N ι (wcLdpQuad K N fun p q => v (1, p, q)) b x hx +
          (wcLdpConst K X.hom x l₀ *
            wcLdpGerm K N ι (wcLdpQuad K N fun p q => v (0, p, q)) b x hx +
          wcLdpConst K X.hom x l₁ *
            wcLdpGerm K N ι (wcLdpQuad K N fun p q => v (1, p, q)) b x hx) := by ring
      rw [hre]
      refine Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) hsq
      · rw [pow_two]; exact Ideal.mul_mem_mul a0 hg0
      · rw [pow_two]; exact Ideal.mul_mem_mul a1 hg1
    have hk : ∀ k, χ (D j k (∑ q, (l₀ * v (0, q) + l₁ * v (1, q)) • (u j q.1 * u j q.2))) = 0 := by
      intro k
      apply hval
      rw [← hδlam]
      exact leib _ (δ k) (hδ k) _ hlamh
    have hc0 : (![l₀, l₁] : Fin 2 → K) ≠ 0 := by
      intro h
      apply hne
      exact ⟨by simpa using congrFun h 0, by simpa using congrFun h 1⟩
    exact hvj j (hΦj j χ v ![l₀, l₁] hc0 e0 e1 hk)
  refine ⟨?_, ?_⟩
  ·
    by_contra hall
    push_neg at hall
    haveI : AlgebraicGeometry.IsReduced X.left :=
      wcpa_dj_sst_smooth_reduced (B := Spec (.of K)) X.hom n inferInstance
    haveI : IrreducibleSpace X.left :=
      GeometricallyIrreducible.geometrically_irreducibleSpace (f := X.hom) (𝟙 _) (𝟙 X.left) X.hom
        IsPullback.of_id_fst
    haveI : CompactSpace X.left := QuasiCompact.compactSpace_of_compactSpace X.hom
    obtain ⟨x, -, hxc⟩ := IsClosed.exists_closed_singleton (X := X.left) isClosed_univ
      Set.univ_nonempty
    have hxtop : ι x ∈ (⨆ a : Fin (N + 1), @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) MvPolynomial.gradedAlgebra
        (MvPolynomial.X a)) := by
      rw [wc_pp_basicOpen_cover K N]; trivial
    obtain ⟨b, hb⟩ := TopologicalSpace.Opens.mem_iSup.mp hxtop
    have hx : x ∈ ι ⁻¹ᵁ wcSgD K N b := hb
    have hbo : X.left.basicOpen ((ι.app (wcSgD K N b)).hom
        (wcLdpSec K N (wcLdpQuad K N fun p q => v (0, p, q)) b)) = ⊥ := by
      refine eq_bot_iff.mpr (fun y hy => ?_)
      have hyU : y ∈ ι ⁻¹ᵁ wcSgD K N b := Scheme.basicOpen_le _ _ hy
      have hunit := (Scheme.mem_basicOpen X.left _ y hyU).mp hy
      exact ((IsLocalRing.mem_maximalIdeal _).mp (hall y b hyU).1 hunit).elim
    have hs0 := (basicOpen_eq_bot_iff _).mp hbo
    have hg0 : wcLdpGerm K N ι (wcLdpQuad K N fun p q => v (0, p, q)) b x hx = 0 := by
      show (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N b) x hx).hom ((ι.app (wcSgD K N b)).hom
        (wcLdpSec K N (wcLdpQuad K N fun p q => v (0, p, q)) b)) = 0
      rw [hs0, map_zero]
    have hax := hall x b hx
    have h10 := indep x hxc b hx hax.1 hax.2 1 0 (by
      rw [hg0, mul_zero, map_zero, zero_mul, add_zero]
      exact Ideal.zero_mem _)
    exact one_ne_zero h10.1
  ·
    intro x hxc hax b hx
    obtain ⟨hg0, hg1⟩ := hax b hx
    obtain ⟨j, -, χ, lam, δ, -, hres, -, hm, -, -, -⟩ := hcharts x hxc b hx
    obtain ⟨t', ht'⟩ := wc_ldp_extend_params K (X.left.presheaf.stalk x) (wcLdpConst K X.hom x)
      hres n hn2 (fun k => lam (t j k) - wcLdpConst K X.hom x (χ (t j k))) hm _ _ hg0 hg1
      (indep x hxc b hx hg0 hg1)
    refine ⟨n - 2, t', ht', ?_⟩
    rw [wc_lfi_smooth_stalk_dim K X.left X.hom n x hxc, show n - 2 + 2 = n by omega]

theorem wc_ldp_germ_linear (K : Type u) [Field K] (N : ℕ) {X : Scheme.{u}} (s : X ⟶ Spec (.of K))
    (ι : X ⟶ wcProjK K N) (hιs : ι ≫ wcProjKStr K N = s) (x : X) (a b : Fin (N + 1))
    (ha : x ∈ ι ⁻¹ᵁ wcSgD K N a) (hb : x ∈ ι ⁻¹ᵁ wcSgD K N b) :
    (∀ G G' : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2,
      wcLdpGerm K N ι (G + G') a x ha = wcLdpGerm K N ι G a x ha + wcLdpGerm K N ι G' a x ha) ∧
    (∀ (c : K) (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2),
      wcLdpGerm K N ι (c • G) a x ha = wcLdpConst K s x c * wcLdpGerm K N ι G a x ha) ∧
    ∃ u : X.presheaf.stalk x, IsUnit u ∧ ∀ G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2,
      wcLdpGerm K N ι G b x hb = u * wcLdpGerm K N ι G a x ha :=
by
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
    MvPolynomial.gradedAlgebra

  have isoapp : ∀ {P Q : CommRingCat.{u}} (i : P ≅ Q) (w : Q), i.hom.hom (i.inv.hom w) = w := by
    intro P Q i w
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, Iso.inv_hom_id, CommRingCat.hom_id,
      RingHom.id_apply]

  have gres : ∀ {U V : (wcProjK K N).Opens} (h : V ≤ U) (hx : x ∈ ι ⁻¹ᵁ V)
      (t : Γ(wcProjK K N, U)),
      (X.presheaf.germ (ι ⁻¹ᵁ V) x hx).hom
          ((ι.app V).hom (((wcProjK K N).presheaf.map (homOfLE h).op).hom t)) =
        (X.presheaf.germ (ι ⁻¹ᵁ U) x (h hx)).hom ((ι.app U).hom t) := by
    intro U V h hx t
    have e1 : (ι.app V).hom (((wcProjK K N).presheaf.map (homOfLE h).op).hom t) =
        (X.presheaf.map ((TopologicalSpace.Opens.map ι.base).map (homOfLE h)).op).hom
          ((ι.app U).hom t) :=
      congrArg (fun φ => φ.hom t) (Scheme.Hom.naturality ι (homOfLE h).op)
    rw [e1]
    exact congrArg (fun φ => φ.hom ((ι.app U).hom t))
      (X.presheaf.germ_res ((TopologicalSpace.Opens.map ι.base).map (homOfLE h)) x hx)

  have s2 : ∀ {σ A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (f : A) {m : ℕ} (f_deg : f ∈ 𝒜 m) (hm : 0 < m)
      {R : CommRingCat.{u}} (φ : R ⟶ CommRingCat.of (𝒜 0)) (r : R),
      (Proj.awayToSection 𝒜 f).hom
          (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f) (φ.hom r)) =
        ((Proj 𝒜).presheaf.map (homOfLE (le_top : Proj.basicOpen 𝒜 f ≤ ⊤)).op).hom
          ((Proj.toSpecZero 𝒜 ≫ Spec.map φ).appTop.hom ((Scheme.ΓSpecIso R).inv.hom r)) := by
    intro σ A _ _ _ 𝒜 _ f m f_deg hm R φ r
    have hι : (Proj.basicOpen 𝒜 f).ι =
        (Proj.basicOpenIsoSpec 𝒜 f f_deg hm).hom ≫ Proj.awayι 𝒜 f f_deg hm := by
      rw [← Proj.basicOpenIsoSpec_inv_ι 𝒜 f f_deg hm, Iso.hom_inv_id_assoc]
    have hb : (Proj.basicOpen 𝒜 f).ι ≫ (Proj.toSpecZero 𝒜 ≫ Spec.map φ) =
        Proj.basicOpenToSpec 𝒜 f ≫ Spec.map (φ ≫ CommRingCat.ofHom
          (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f))) := by
      rw [hι, Category.assoc, Proj.awayι_toSpecZero_assoc, Spec.map_comp,
        Proj.basicOpenIsoSpec_hom]
    have hc := congrArg (fun g => (Scheme.Hom.appTop g).hom ((Scheme.ΓSpecIso R).inv.hom r)) hb
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at hc
    have h1 : (Scheme.Hom.appTop (Spec.map (φ ≫ CommRingCat.ofHom
          (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f))))).hom
          ((Scheme.ΓSpecIso R).inv.hom r) =
        (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))).inv.hom
          (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f) (φ.hom r)) :=
      (congrArg (fun g => g.hom r) (Scheme.ΓSpecIso_inv_naturality (φ ≫ CommRingCat.ofHom
          (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f))))).symm
    have h2 : ∀ z, (Scheme.Hom.appTop (Proj.basicOpenToSpec 𝒜 f)).hom
          ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))).inv.hom z) =
        (Proj.basicOpen 𝒜 f).topIso.inv.hom ((Proj.awayToSection 𝒜 f).hom z) := by
      intro z
      rw [show Scheme.Hom.appTop (Proj.basicOpenToSpec 𝒜 f) = _ from
        Proj.basicOpenToSpec_app_top 𝒜 f]
      rw [CommRingCat.hom_comp, CommRingCat.hom_comp, RingHom.comp_apply, RingHom.comp_apply,
        isoapp]
    rw [h1, h2] at hc
    have resres : ∀ {U V W : (Proj 𝒜).Opens} (i : U ⟶ V) (j : V ⟶ W) (y : Γ(Proj 𝒜, W)),
        ((Proj 𝒜).presheaf.map i.op).hom (((Proj 𝒜).presheaf.map j.op).hom y) =
          ((Proj 𝒜).presheaf.map (i ≫ j).op).hom y := by
      intro U V W i j y
      rw [op_comp, Functor.map_comp, CommRingCat.hom_comp, RingHom.comp_apply]
    have key : ∀ y, (Proj.basicOpen 𝒜 f).topIso.hom.hom
        ((Scheme.Hom.appTop (Proj.basicOpen 𝒜 f).ι).hom y) =
        ((Proj 𝒜).presheaf.map (homOfLE (le_top : Proj.basicOpen 𝒜 f ≤ ⊤)).op).hom y := by
      intro y
      rw [Scheme.Opens.topIso_hom, Scheme.Opens.ι_appTop]
      refine (resres _ _ y).trans ?_
      exact congrArg (fun k : Proj.basicOpen 𝒜 f ⟶ (⊤ : (Proj 𝒜).Opens) =>
        ((Proj 𝒜).presheaf.map k.op).hom y) (Subsingleton.elim _ _)
    rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, ← key, hc, isoapp]

  have hXa : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a)
  have hXb : (MvPolynomial.X b : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K b)

  have madd : ∀ G G' : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2,
      HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hXa 2
        ((G + G' : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2) :
          MvPolynomial (Fin (N + 1)) K) (G + G').2 =
      HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hXa 2
        (G : MvPolynomial (Fin (N + 1)) K) G.2 +
      HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hXa 2
        (G' : MvPolynomial (Fin (N + 1)) K) G'.2 := by
    intro G G'
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_add, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
      Localization.add_mk_self, Submodule.coe_add]
  have msmul : ∀ (c : K) (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2),
      HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hXa 2
        ((c • G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2) :
          MvPolynomial (Fin (N + 1)) K) (c • G).2 =
      HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (Submonoid.powers (MvPolynomial.X a))
          (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c) *
      HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hXa 2
        (G : MvPolynomial (Fin (N + 1)) K) G.2 := by
    intro c G
    have hcoe : ((algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c :
        MvPolynomial (Fin (N + 1)) K)) = MvPolynomial.C c := by
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    have hz : (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X a))
        (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)).val =
        Localization.mk (MvPolynomial.C c) 1 := by
      rw [← hcoe]
      rfl
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk, hz, Localization.mk_mul, Localization.mk_eq_mk_iff]
    apply Localization.r_of_eq
    simp only [Submonoid.coe_mul, OneMemClass.coe_one, Submodule.coe_smul,
      MvPolynomial.smul_eq_C_mul]
    ring
  have hconst : ∀ c : K,
      (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X a)).hom
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (Submonoid.powers (MvPolynomial.X a))
          (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)) =
      ((wcProjK K N).presheaf.map (homOfLE (le_top : wcSgD K N a ≤ ⊤)).op).hom
        ((wcProjKStr K N).appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom c)) :=
    fun c => s2 (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a) hXa
      Nat.one_pos
      (CommRingCat.ofHom (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0))) c
  refine ⟨?_, ?_, ?_⟩
  ·
    intro G G'
    unfold wcLdpGerm wcLdpSec
    rw [madd G G', map_add, map_add, map_add]
  ·
    intro c G
    unfold wcLdpGerm wcLdpSec
    rw [msmul c G, map_mul, map_mul, map_mul]
    congr 1
    rw [hconst c]
    refine (gres le_top ha _).trans ?_
    subst hιs
    first
      | rfl
      | (show _ = (X.presheaf.germ ⊤ x trivial).hom ((ι ≫ wcProjKStr K N).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom c))
         rw [Scheme.Hom.comp_appTop]
         rfl)
  ·
    have hx : (MvPolynomial.X a * MvPolynomial.X b : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2 :=
      (MvPolynomial.mem_homogeneousSubmodule 2 _).mpr
        ((MvPolynomial.isHomogeneous_X K a).mul (MvPolynomial.isHomogeneous_X K b))
    have h4a : (MvPolynomial.X a ^ 4 : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (2 • 2) := by
      rw [show (2 • 2 : ℕ) = 4 from rfl]
      exact (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X_pow a 4)
    have h4b : (MvPolynomial.X b ^ 4 : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (2 • 2) := by
      rw [show (2 • 2 : ℕ) = 4 from rfl]
      exact (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X_pow b 4)
    have hle_a : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X a * MvPolynomial.X b) ≤ wcSgD K N a := fun y hy =>
      ((Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) _ _).le hy).1
    have hle_b : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X a * MvPolynomial.X b) ≤ wcSgD K N b := fun y hy =>
      ((Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) _ _).le hy).2
    have hA : ∀ G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2,
        (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a * MvPolynomial.X b)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            hXb (rfl : MvPolynomial.X a * MvPolynomial.X b = MvPolynomial.X a * MvPolynomial.X b)
            (HomogeneousLocalization.Away.mk _ hXa 2 (G : MvPolynomial (Fin (N + 1)) K) G.2)) =
        ((wcProjK K N).presheaf.map (homOfLE hle_a).op).hom (wcLdpSec K N G a) := fun G =>
      congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hXa 2
        (G : MvPolynomial (Fin (N + 1)) K) G.2))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (f := MvPolynomial.X a) hXb (x := MvPolynomial.X a * MvPolynomial.X b) rfl)
    have hB : ∀ G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2,
        (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a * MvPolynomial.X b)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
            (HomogeneousLocalization.Away.mk _ hXb 2 (G : MvPolynomial (Fin (N + 1)) K) G.2)) =
        ((wcProjK K N).presheaf.map (homOfLE hle_b).op).hom (wcLdpSec K N G b) := fun G =>
      congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hXb 2
        (G : MvPolynomial (Fin (N + 1)) K) G.2))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (f := MvPolynomial.X b) hXa (x := MvPolynomial.X a * MvPolynomial.X b)
        (mul_comm (MvPolynomial.X a) (MvPolynomial.X b)))
    have c1 : ∀ G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2,
        HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
          (HomogeneousLocalization.Away.mk _ hXb 2 (G : MvPolynomial (Fin (N + 1)) K) G.2) =
        HomogeneousLocalization.Away.mk _ hx 2 (MvPolynomial.X a ^ 4) h4a *
        HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hXb
          (rfl : MvPolynomial.X a * MvPolynomial.X b = MvPolynomial.X a * MvPolynomial.X b)
          (HomogeneousLocalization.Away.mk _ hXa 2 (G : MvPolynomial (Fin (N + 1)) K) G.2) := by
      intro G
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.mk_mul, Localization.mk_eq_mk_iff]
      apply Localization.r_of_eq
      simp only [Submonoid.coe_mul]
      ring
    have c2 : HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          hx 2 (MvPolynomial.X a ^ 4) h4a *
        HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          hx 2 (MvPolynomial.X b ^ 4) h4b = 1 := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one,
        Localization.mk_mul, ← Localization.mk_one, Localization.mk_eq_mk_iff]
      apply Localization.r_of_eq
      simp only [Submonoid.coe_mul, OneMemClass.coe_one]
      ring
    have e : wcSgD K N a ⊓ wcSgD K N b ≤
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a * MvPolynomial.X b) :=
      (Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) _ _).ge
    have kl : ∀ t : Γ(wcProjK K N, wcSgD K N a),
        ((wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N a ⊓ wcSgD K N b ≤
            wcSgD K N a)).op).hom t =
          ((wcProjK K N).presheaf.map (homOfLE e).op).hom
            (((wcProjK K N).presheaf.map (homOfLE hle_a).op).hom t) := fun t =>
      congrArg (fun φ => φ.hom t) ((wcProjK K N).presheaf.map_comp (homOfLE hle_a).op (homOfLE e).op)
    have kr : ∀ t : Γ(wcProjK K N, wcSgD K N b),
        ((wcProjK K N).presheaf.map (homOfLE (inf_le_right : wcSgD K N a ⊓ wcSgD K N b ≤
            wcSgD K N b)).op).hom t =
          ((wcProjK K N).presheaf.map (homOfLE e).op).hom
            (((wcProjK K N).presheaf.map (homOfLE hle_b).op).hom t) := fun t =>
      congrArg (fun φ => φ.hom t) ((wcProjK K N).presheaf.map_comp (homOfLE hle_b).op (homOfLE e).op)
    set r := ((wcProjK K N).presheaf.map (homOfLE e).op).hom with hr
    set T := (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a * MvPolynomial.X b)).hom with hT
    set v := r (T (HomogeneousLocalization.Away.mk _ hx 2 (MvPolynomial.X a ^ 4) h4a)) with hvdef
    have hv : IsUnit v := by
      refine ⟨⟨_, r (T (HomogeneousLocalization.Away.mk _ hx 2 (MvPolynomial.X b ^ 4) h4b)),
        ?_, ?_⟩, rfl⟩
      · rw [← map_mul r, ← map_mul T, c2, map_one, map_one]
      · rw [← map_mul r, ← map_mul T, mul_comm (HomogeneousLocalization.Away.mk _ hx 2
          (MvPolynomial.X b ^ 4) h4b), c2, map_one, map_one]
    have hrel : ∀ G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2,
        ((wcProjK K N).presheaf.map (homOfLE (inf_le_right : wcSgD K N a ⊓ wcSgD K N b ≤
            wcSgD K N b)).op).hom (wcLdpSec K N G b) =
          v * ((wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N a ⊓ wcSgD K N b ≤
            wcSgD K N a)).op).hom (wcLdpSec K N G a) := by
      intro G
      rw [kl, kr, ← hA, ← hB, c1, map_mul T, map_mul r]
    have hW : x ∈ ι ⁻¹ᵁ (wcSgD K N a ⊓ wcSgD K N b) := by
      first
        | exact ⟨ha, hb⟩
        | exact Set.mem_inter ha hb
        | (rw [Scheme.Hom.preimage_inf]; exact ⟨ha, hb⟩)
    refine ⟨(X.presheaf.germ (ι ⁻¹ᵁ (wcSgD K N a ⊓ wcSgD K N b)) x hW).hom
      ((ι.app (wcSgD K N a ⊓ wcSgD K N b)).hom v), (hv.map _).map _, ?_⟩
    intro G
    have e1 := gres (inf_le_right : wcSgD K N a ⊓ wcSgD K N b ≤ wcSgD K N b) hW (wcLdpSec K N G b)
    have e2 := gres (inf_le_left : wcSgD K N a ⊓ wcSgD K N b ≤ wcSgD K N a) hW (wcLdpSec K N G a)
    unfold wcLdpGerm
    rw [← e1, ← e2, hrel G, map_mul, map_mul]

theorem wc_ldp_crit_member_sq (K : Type u) [Field K] (O : Type u) [CommRing O] [IsLocalRing O]
    (κ : K →+* O) (hres : ∀ y : O, ∃ c : K, y - κ c ∈ IsLocalRing.maximalIdeal O)
    (g₀ g₁ : O) (c₀ c₁ : K)
    (hoff : g₀ ∉ IsLocalRing.maximalIdeal O ∨ g₁ ∉ IsLocalRing.maximalIdeal O)
    (hz : κ c₁ * g₀ - κ c₀ * g₁ ∈ IsLocalRing.maximalIdeal O)
    (hcrit : letI := κ.toAlgebra
      g₀ • KaehlerDifferential.D K O g₁ - g₁ • KaehlerDifferential.D K O g₀ ∈
        (IsLocalRing.maximalIdeal O) • (⊤ : Submodule O (KaehlerDifferential K O))) :
    κ c₁ * g₀ - κ c₀ * g₁ ∈ IsLocalRing.maximalIdeal O ^ 2 :=
by
  classical
  letI := κ.toAlgebra
  set m := IsLocalRing.maximalIdeal O with hm
  have hU : ∀ c c' : K, κ c - κ c' ∈ m → c = c' := by
    intro c c' h
    by_contra hne
    rw [← map_sub] at h
    exact (IsLocalRing.mem_maximalIdeal _).mp h
      ((isUnit_iff_ne_zero.mpr (sub_ne_zero.mpr hne)).map κ)
  choose cf hcf using hres
  have hU' : ∀ f c, f - κ c ∈ m → c = cf f := by
    intro f c h
    apply hU
    have h2 := Ideal.sub_mem _ (hcf f) h
    have e : f - κ (cf f) - (f - κ c) = κ c - κ (cf f) := by ring
    rwa [e] at h2
  let T : O → m.Cotangent := fun f => m.toCotangent ⟨f - κ (cf f), hcf f⟩
  have hT : ∀ f c (h : f - κ c ∈ m), T f = m.toCotangent ⟨f - κ c, h⟩ := by
    intro f c h
    obtain rfl := hU' f c h
    rfl
  have hTadd : ∀ f g, T (f + g) = T f + T g := by
    intro f g
    have h : f + g - κ (cf f + cf g) ∈ m := by
      have h2 := Ideal.add_mem _ (hcf f) (hcf g)
      have e : f + g - κ (cf f + cf g) = (f - κ (cf f)) + (g - κ (cf g)) := by
        rw [map_add]; ring
      rw [e]; exact h2
    rw [hT _ _ h, hT f _ (hcf f), hT g _ (hcf g), ← map_add]
    congr 1
    apply Subtype.ext
    show f + g - κ (cf f + cf g) = (f - κ (cf f)) + (g - κ (cf g))
    rw [map_add]; ring
  have hTsmul : ∀ (k : K) f, T (k • f) = k • T f := by
    intro k f
    have h : k • f - κ (k * cf f) ∈ m := by
      rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra, map_mul, ← mul_sub]
      exact Ideal.mul_mem_left _ _ (hcf f)
    have e : (⟨k • f - κ (k * cf f), h⟩ : m) = κ k • (⟨f - κ (cf f), hcf f⟩ : m) := by
      apply Subtype.ext
      show k • f - κ (k * cf f) = κ k * (f - κ (cf f))
      rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra, map_mul]; ring
    rw [hT _ _ h, hT f _ (hcf f), e, map_smul]
    exact algebraMap_smul O k _
  have hTmul : ∀ f g, T (f * g) = f • T g + g • T f := by
    intro f g
    have h : f * g - κ (cf f * cf g) ∈ m := by
      have e : f * g - κ (cf f * cf g) = (f - κ (cf f)) * g + κ (cf f) * (g - κ (cf g)) := by
        rw [map_mul]; ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (hcf f)) (Ideal.mul_mem_left _ _ (hcf g))
    have h2 : (f - κ (cf f)) * (g - κ (cf g)) ∈ m ^ 2 := by
      rw [pow_two]; exact Ideal.mul_mem_mul (hcf f) (hcf g)
    rw [hT _ _ h, hT f _ (hcf f), hT g _ (hcf g), ← sub_eq_zero, ← map_smul, ← map_smul,
      ← map_add, ← map_sub, Ideal.toCotangent_eq_zero]
    have e : f * g - κ (cf f * cf g) - (f * (g - κ (cf g)) + g * (f - κ (cf f))) =
        -((f - κ (cf f)) * (g - κ (cf g))) := by
      rw [map_mul]; ring
    show f * g - κ (cf f * cf g) - (f * (g - κ (cf g)) + g * (f - κ (cf f))) ∈ m ^ 2
    rw [e]
    exact neg_mem h2
  let Tl : O →ₗ[K] m.Cotangent :=
    { toFun := T, map_add' := hTadd, map_smul' := hTsmul }
  let d : Derivation K O m.Cotangent := Derivation.mk' Tl hTmul
  have hLD : ∀ f, d.liftKaehlerDifferential (KaehlerDifferential.D K O f) = T f :=
    fun f => d.liftKaehlerDifferential_comp_D f
  have hkill : ∀ x ∈ m • (⊤ : Submodule O (KaehlerDifferential K O)),
      d.liftKaehlerDifferential x = 0 := by
    intro x hx
    refine Submodule.smul_induction_on (p := fun y => d.liftKaehlerDifferential y = 0) hx ?_ ?_
    · intro r hr n _
      show d.liftKaehlerDifferential (r • n) = 0
      rw [map_smul]; exact Ideal.Cotangent.smul_eq_zero_of_mem hr _
    · intro x y hx hy
      show d.liftKaehlerDifferential (x + y) = 0
      rw [map_add, hx, hy, add_zero]
  have hE : g₀ • T g₁ = g₁ • T g₀ := by
    have h1 := hkill _ hcrit
    rw [map_sub, map_smul, map_smul, hLD, hLD, sub_eq_zero] at h1
    exact h1
  have hTc : ∀ c, T (κ c) = 0 := by
    intro c
    rw [hT (κ c) c (by simp), Ideal.toCotangent_eq_zero]
    simp
  have hTsub : ∀ f g, T (f - g) = T f - T g := fun f g => d.map_sub f g
  have hTh : T (κ c₁ * g₀ - κ c₀ * g₁) = κ c₁ • T g₀ - κ c₀ • T g₁ := by
    rw [hTsub, hTmul, hTmul, hTc, hTc, smul_zero, smul_zero, add_zero, add_zero]
  have hzero : κ c₁ • T g₀ - κ c₀ • T g₁ = 0 := by
    rcases hoff with h0 | h1
    · have hu : IsUnit g₀ := by
        by_contra hn
        exact h0 ((IsLocalRing.mem_maximalIdeal _).mpr hn)
      have e : g₀ • (κ c₁ • T g₀ - κ c₀ • T g₁) = (κ c₁ * g₀ - κ c₀ * g₁) • T g₀ := by
        rw [smul_sub, smul_comm g₀ (κ c₁), smul_comm g₀ (κ c₀), hE, sub_smul, mul_smul,
          mul_smul]
      apply hu.smul_left_cancel.mp
      rw [e, smul_zero]
      exact Ideal.Cotangent.smul_eq_zero_of_mem hz _
    · have hu : IsUnit g₁ := by
        by_contra hn
        exact h1 ((IsLocalRing.mem_maximalIdeal _).mpr hn)
      have e : g₁ • (κ c₁ • T g₀ - κ c₀ • T g₁) = (κ c₁ * g₀ - κ c₀ * g₁) • T g₁ := by
        rw [smul_sub, smul_comm g₁ (κ c₁), smul_comm g₁ (κ c₀), ← hE, sub_smul, mul_smul,
          mul_smul]
      apply hu.smul_left_cancel.mp
      rw [e, smul_zero]
      exact Ideal.Cotangent.smul_eq_zero_of_mem hz _
  have hfin : T (κ c₁ * g₀ - κ c₀ * g₁) = 0 := by rw [hTh, hzero]
  have hz' : κ c₁ * g₀ - κ c₀ * g₁ - κ 0 ∈ m := by rw [map_zero, sub_zero]; exact hz
  rw [hT _ 0 hz', Ideal.toCotangent_eq_zero] at hfin
  have e : κ c₁ * g₀ - κ c₀ * g₁ - κ 0 = κ c₁ * g₀ - κ c₀ * g₁ := by rw [map_zero, sub_zero]
  exact e ▸ hfin

theorem wc_ldp_hessian_odp (K : Type u) [Field K] (O : Type u) [CommRing O] [IsLocalRing O]
    (κ : K →+* O) (hres : ∀ y : O, ∃ c : K, y - κ c ∈ IsLocalRing.maximalIdeal O)
    (n : ℕ) (δ : Fin n → (O →+ O))
    (hδ : ∀ i (f g : O), δ i (f * g) = f * δ i g + g * δ i f) (hδκ : ∀ i c, δ i (κ c) = 0)
    (s : Fin n → O) (hm : IsLocalRing.maximalIdeal O = Ideal.span (Set.range s))
    (hds : ∀ i k, δ i (s k) = if i = k then 1 else 0)
    (h : O) (hh : h ∈ IsLocalRing.maximalIdeal O ^ 2) (e : Matrix (Fin n) (Fin n) K)
    (he : ∀ i j, δ i (δ j h) - κ (e i j) ∈ IsLocalRing.maximalIdeal O) (hdet : e.det ≠ 0) :
    ∃ A : Matrix (Fin n) (Fin n) O,
      h - ∑ k, ∑ l, A k l * s k * s l ∈ IsLocalRing.maximalIdeal O ^ 3 ∧
        IsUnit (A + A.transpose).det :=
by
  classical
  have hs : ∀ k, s k ∈ IsLocalRing.maximalIdeal O := fun k => by
    rw [hm]; exact Ideal.subset_span ⟨k, rfl⟩

  have hrep : ∀ x ∈ IsLocalRing.maximalIdeal O ^ 2,
      ∃ A : Matrix (Fin n) (Fin n) O, x = ∑ k, ∑ l, A k l * s k * s l := by
    intro x hx
    rw [pow_two] at hx
    refine Submodule.mul_induction_on hx ?_ ?_
    · intro a ha b hb
      rw [hm] at ha hb
      obtain ⟨c, rfl⟩ := (Ideal.mem_span_range_iff_exists_fun).mp ha
      obtain ⟨d, rfl⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hb
      refine ⟨Matrix.of fun k l => c k * d l, ?_⟩
      rw [Finset.sum_mul_sum]
      refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun l _ => ?_
      simp only [Matrix.of_apply]
      ring
    · rintro x y ⟨A, rfl⟩ ⟨B, rfl⟩
      refine ⟨A + B, ?_⟩
      simp only [Matrix.add_apply, add_mul, Finset.sum_add_distrib]
  obtain ⟨A, hA⟩ := hrep h hh
  refine ⟨A, ?_, ?_⟩
  · rw [← hA, sub_self]
    exact Submodule.zero_mem _

  set π := IsLocalRing.residue O with hπ
  have hπs : ∀ k, π (s k) = 0 := fun k => (IsLocalRing.residue_eq_zero_iff _).mpr (hs k)
  have hterm : ∀ (a : O) (i j k l : Fin n), π (δ i (δ j (a * s k * s l))) =
      π a * (π (δ i (s k)) * π (δ j (s l)) + π (δ j (s k)) * π (δ i (s l))) := by
    intro a i j k l
    simp only [hδ, map_add, map_mul, hπs]
    ring
  have hsum : ∀ i j, π (δ i (δ j h)) = π (A i j) + π (A j i) := by
    intro i j
    rw [hA]
    simp only [map_sum, hterm, hds, apply_ite π, map_one, map_zero]
    simp [mul_add, Finset.sum_add_distrib, mul_ite]

  have hM : (A + A.transpose).map π = e.map (π.comp κ) := by
    ext i j
    have h1 : π (δ i (δ j h) - κ (e i j)) = 0 := (IsLocalRing.residue_eq_zero_iff _).mpr (he i j)
    rw [map_sub, sub_eq_zero, hsum] at h1
    simp only [Matrix.map_apply, Matrix.add_apply, Matrix.transpose_apply, map_add,
      RingHom.comp_apply]
    exact h1
  have hdetπ : π (A + A.transpose).det = (π.comp κ) e.det := by
    rw [RingHom.map_det, RingHom.map_det, RingHom.mapMatrix_apply, RingHom.mapMatrix_apply, hM]
  have hne : π (A + A.transpose).det ≠ 0 := by
    rw [hdetπ]
    intro h0
    apply hdet
    exact (π.comp κ).injective (h0.trans (map_zero _).symm)
  have hnm : (A + A.transpose).det ∉ IsLocalRing.maximalIdeal O := fun hmem =>
    hne ((IsLocalRing.residue_eq_zero_iff _).mpr hmem)
  exact IsLocalRing.notMem_maximalIdeal.mp hnm

theorem wc_ldp_quadric_jets (K : Type u) [Field K] (R : Type u) [CommRing R] [Algebra K R]
    (N n : ℕ) (hn : Even n) (b : Fin (N + 1)) (u : Fin (N + 1) → R) (hub : u b = 1)
    (t : Fin n → R) (D : Fin n → Derivation K R R) (hDt : ∀ i k, D i (t k) = if i = k then 1 else 0)
    (χ : R →ₐ[K] K)
    (hker : RingHom.ker χ = Ideal.span (Set.range fun p => u p - algebraMap K R (χ (u p)))) :
    (∀ (y₀ : K) (y : Fin n → K), ∃ w : Fin (N + 1) × Fin (N + 1) → K,
      χ (∑ q, w q • (u q.1 * u q.2)) = y₀ ∧ ∀ k, χ (D k (∑ q, w q • (u q.1 * u q.2))) = y k) ∧
    ∃ w : Fin (N + 1) × Fin (N + 1) → K, χ (∑ q, w q • (u q.1 * u q.2)) = 0 ∧
      (∀ k, χ (D k (∑ q, w q • (u q.1 * u q.2))) = 0) ∧
      (Matrix.of fun i j => χ (D i (D j (∑ q, w q • (u q.1 * u q.2))))).det ≠ 0 :=
by
  classical

  have hmulW : ∀ x y : R, x ∈ Submodule.span K (Set.range u) →
      y ∈ Submodule.span K (Set.range u) →
      x * y ∈ Submodule.span K (Set.range fun q : Fin (N + 1) × Fin (N + 1) => u q.1 * u q.2) := by
    intro x y hx hy
    obtain ⟨α, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp hx
    obtain ⟨β, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp hy
    rw [Finset.sum_mul_sum]
    refine Submodule.sum_mem _ (fun p _ => Submodule.sum_mem _ (fun p' _ => ?_))
    rw [smul_mul_smul_comm]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨(p, p'), rfl⟩)
  have h1W : (1 : R) ∈ Submodule.span K (Set.range u) := by
    rw [← hub]; exact Submodule.subset_span ⟨b, rfl⟩
  have hubarW : ∀ p, u p - algebraMap K R (χ (u p)) ∈ Submodule.span K (Set.range u) := by
    intro p
    rw [Algebra.algebraMap_eq_smul_one]
    exact Submodule.sub_mem _ (Submodule.subset_span ⟨p, rfl⟩) (Submodule.smul_mem _ _ h1W)

  have hmem : ∀ l, t l - algebraMap K R (χ (t l)) ∈
      Ideal.span (Set.range fun p => u p - algebraMap K R (χ (u p))) := by
    intro l
    rw [← hker, RingHom.mem_ker]
    simp
  choose c hc using fun l => (Ideal.mem_span_range_iff_exists_fun).mp (hmem l)
  have hdual : ∀ k l, ∑ p, χ (c l p) * χ (D k (u p)) = if k = l then 1 else 0 := by
    intro k l
    have hterm : ∀ p, χ (D k (c l p * (u p - algebraMap K R (χ (u p))))) =
        χ (c l p) * χ (D k (u p)) := by
      intro p
      simp [Derivation.leibniz, map_sub, Derivation.map_algebraMap, AlgHom.commutes]
    have h1 := congrArg (fun z => χ (D k z)) (hc l)
    simp only [map_sum, hterm] at h1
    rw [h1, map_sub, Derivation.map_algebraMap, sub_zero, hDt]
    split_ifs <;> simp

  obtain ⟨z, hz⟩ : ∃ z : Fin n → R,
      z = fun l => ∑ p, χ (c l p) • (u p - algebraMap K R (χ (u p))) := ⟨_, rfl⟩
  have hzW : ∀ l, z l ∈ Submodule.span K (Set.range u) := by
    intro l
    rw [hz]
    exact Submodule.sum_mem _ (fun p _ => Submodule.smul_mem _ _ (hubarW p))
  have hz0 : ∀ l, χ (z l) = 0 := by
    intro l
    rw [hz]
    simp [map_sum]
  have hzD : ∀ k l, χ (D k (z l)) = if k = l then 1 else 0 := by
    intro k l
    rw [← hdual k l, hz]
    simp only [map_sum, Derivation.map_smul, map_sub, Derivation.map_algebraMap, sub_zero,
      map_smul, smul_eq_mul]

  have hprod : ∀ x y : R, χ x = 0 → χ y = 0 →
      χ (x * y) = 0 ∧ (∀ k, χ (D k (x * y)) = 0) ∧
      ∀ l k, χ (D l (D k (x * y))) = χ (D l x) * χ (D k y) + χ (D l y) * χ (D k x) := by
    intro x y hx hy
    refine ⟨by rw [map_mul, hx, zero_mul], fun k => ?_, fun l k => ?_⟩
    · simp only [Derivation.leibniz, smul_eq_mul, map_add, map_mul, hx, hy]; ring
    · simp only [Derivation.leibniz, smul_eq_mul, map_add, map_mul, hx, hy]; ring

  have hmemV : ∀ x ∈ Submodule.span K (Set.range u),
      x ∈ Submodule.span K (Set.range fun q : Fin (N + 1) × Fin (N + 1) => u q.1 * u q.2) := by
    intro x hx
    simpa using hmulW x 1 hx h1W
  refine ⟨fun y₀ y => ?_, ?_⟩
  · have hV : algebraMap K R y₀ + ∑ l, y l • z l ∈
        Submodule.span K (Set.range fun q : Fin (N + 1) × Fin (N + 1) => u q.1 * u q.2) := by
      refine Submodule.add_mem _ (hmemV _ ?_) (Submodule.sum_mem _ (fun l _ =>
        Submodule.smul_mem _ _ (hmemV _ (hzW l))))
      rw [Algebra.algebraMap_eq_smul_one]
      exact Submodule.smul_mem _ _ h1W
    obtain ⟨w, hw⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp hV
    have hw' : ∑ q, w q • (u q.1 * u q.2) = algebraMap K R y₀ + ∑ l, y l • z l := hw
    refine ⟨w, ?_, fun k => ?_⟩
    · rw [hw', map_add, map_sum]
      simp [hz0]
    · rw [hw', map_add, Derivation.map_algebraMap, zero_add, map_sum, map_sum]
      simp only [Derivation.map_smul, map_smul, smul_eq_mul, hzD, mul_ite, mul_one, mul_zero,
        Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ, if_true]

  obtain ⟨S, hS⟩ : ∃ S : Finset (Fin n),
      S = Finset.univ.filter (fun i : Fin n => i.val < (Fin.rev i).val) := ⟨_, rfl⟩
  have hhV : (∑ i ∈ S, z i * z (Fin.rev i)) ∈
      Submodule.span K (Set.range fun q : Fin (N + 1) × Fin (N + 1) => u q.1 * u q.2) :=
    Submodule.sum_mem _ (fun i _ => hmulW _ _ (hzW i) (hzW _))
  obtain ⟨w, hw⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp hhV
  have hw' : ∑ q, w q • (u q.1 * u q.2) = ∑ i ∈ S, z i * z (Fin.rev i) := hw
  refine ⟨w, ?_, ?_, ?_⟩
  · rw [hw', map_sum]
    exact Finset.sum_eq_zero (fun i _ => (hprod _ _ (hz0 i) (hz0 _)).1)
  · intro k
    rw [hw', map_sum, map_sum]
    exact Finset.sum_eq_zero (fun i _ => (hprod _ _ (hz0 i) (hz0 _)).2.1 k)
  · have hH : (Matrix.of fun i j => χ (D i (D j (∑ q, w q • (u q.1 * u q.2))))) =
        Matrix.of fun l k : Fin n => if k = Fin.rev l then (1 : K) else 0 := by
      ext l k
      simp only [Matrix.of_apply]
      rw [hw', map_sum, map_sum, map_sum]
      rw [Finset.sum_congr rfl (fun i _ => (hprod _ _ (hz0 i) (hz0 (Fin.rev i))).2.2 l k)]
      simp only [hzD]
      have e1 : ∀ i : Fin n, (if l = i then (1 : K) else 0) * (if k = Fin.rev i then 1 else 0)
          = if l = i then (if k = Fin.rev l then 1 else 0) else 0 := by
        intro i
        by_cases h1 : l = i
        · subst h1; simp
        · simp [h1]
      have e2 : ∀ i : Fin n, (if l = Fin.rev i then (1 : K) else 0) * (if k = i then 1 else 0)
          = if Fin.rev l = i then (if k = Fin.rev l then 1 else 0) else 0 := by
        intro i
        by_cases h1 : l = Fin.rev i
        · subst h1; simp
        · have h2 : Fin.rev l ≠ i := fun h2 => h1 (by rw [← h2, Fin.rev_rev])
          simp [h1, h2]
      simp only [e1, e2, Finset.sum_add_distrib, Finset.sum_ite_eq]
      have hpar : (l ∈ S ∧ Fin.rev l ∉ S) ∨ (l ∉ S ∧ Fin.rev l ∈ S) := by
        simp only [hS, Finset.mem_filter, Finset.mem_univ, true_and, Fin.val_rev]
        obtain ⟨m, hm⟩ := hn
        have := l.isLt
        omega
      rcases hpar with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> simp [h1, h2]
    rw [hH]
    apply Matrix.det_ne_zero_of_left_inverse
      (B := Matrix.of fun l k : Fin n => if k = Fin.rev l then (1 : K) else 0)
    ext l m
    simp only [Matrix.mul_apply, Matrix.of_apply, Matrix.one_apply]
    rw [Finset.sum_eq_single (Fin.rev l)]
    · simp only [if_pos rfl, one_mul, Fin.rev_rev]
      by_cases hlm : l = m
      · subst hlm; simp
      · simp [hlm, Ne.symm hlm]
    · intro x _ hx; simp [hx]
    · intro h; exact absurd (Finset.mem_univ _) h

theorem wc_ldp_hessian_incidence (K : Type u) [Field K] [IsAlgClosed K] (n : ℕ) (Q : Type)
    [Fintype Q] (R : Type u) [CommRing R] [IsDomain R] [Algebra K R] [Algebra.FiniteType K R]
    (hR : ringKrullDim R ≤ n) (ℓ : Q → R) (D : Fin n → Derivation K R R)
    (hJ1 : ∀ (χ : R →ₐ[K] K) (y₀ : K) (y : Fin n → K), ∃ w : Q → K,
      χ (∑ q, w q • ℓ q) = y₀ ∧ ∀ k, χ (D k (∑ q, w q • ℓ q)) = y k)
    (hJ2 : ∀ χ : R →ₐ[K] K, ∃ w : Q → K, χ (∑ q, w q • ℓ q) = 0 ∧
      (∀ k, χ (D k (∑ q, w q • ℓ q)) = 0) ∧
      (Matrix.of fun i j => χ (D i (D j (∑ q, w q • ℓ q)))).det ≠ 0) :
    ∃ (A₁ A₂ : Type u) (_ : CommRing A₁) (_ : CommRing A₂) (_ : Algebra K A₁) (_ : Algebra K A₂)
      (_ : Algebra.FiniteType K A₁) (_ : Algebra.FiniteType K A₂)
      (φ₁ : MvPolynomial (Fin 2 × Q) K →ₐ[K] A₁) (φ₂ : MvPolynomial (Fin 2 × Q) K →ₐ[K] A₂),
      ringKrullDim A₁ < (Fintype.card (Fin 2 × Q) : WithBot ℕ∞) ∧
      ringKrullDim A₂ < (Fintype.card (Fin 2 × Q) : WithBot ℕ∞) ∧
      ∀ (χ : R →ₐ[K] K) (v : Fin 2 × Q → K) (c : Fin 2 → K), c ≠ 0 →
        χ (∑ q, (c 1 * v (0, q) - c 0 * v (1, q)) • ℓ q) = 0 →
        (∀ k, χ (D k (∑ q, (c 1 * v (0, q) - c 0 * v (1, q)) • ℓ q)) = 0) →
        (Matrix.of fun i j => χ (D i (D j (∑ q, (c 1 * v (0, q) - c 0 * v (1, q)) • ℓ q)))).det = 0 →
        (∃ ψ : A₁ →ₐ[K] K, ψ.comp φ₁ = MvPolynomial.aeval v) ∨
        (∃ ψ : A₂ →ₐ[K] K, ψ.comp φ₂ = MvPolynomial.aeval v) :=
by
  classical
  haveI hNoeth : IsNoetherianRing R := Algebra.FiniteType.isNoetherianRing K R

  set L : Option (Fin n) → Q → R := fun i j => Option.elim i (ℓ j) (fun k => D k (ℓ j)) with hLdef
  obtain ⟨Ilin, hIlin⟩ : ∃ J : Ideal (MvPolynomial Q R),
      J = Ideal.span (Set.range fun i => ∑ j, MvPolynomial.C (L i j) * MvPolynomial.X j) :=
    ⟨_, rfl⟩
  obtain ⟨Δ, hΔ⟩ : ∃ Δ : MvPolynomial Q R, Δ = (Matrix.of fun i j : Fin n =>
      ∑ q, MvPolynomial.C (D i (D j (ℓ q))) * MvPolynomial.X q).det := ⟨_, rfl⟩
  obtain ⟨I, hI⟩ : ∃ J : Ideal (MvPolynomial Q R), J = Ilin ⊔ Ideal.span {Δ} := ⟨_, rfl⟩
  have hle : Ilin ≤ I := by rw [hI]; exact le_sup_left
  have hΔI : Δ ∈ I := by rw [hI]; exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self Δ)
  have hgen : ∀ i, (∑ j, MvPolynomial.C (L i j) * MvPolynomial.X j) ∈ Ilin := by
    intro i; rw [hIlin]; exact Ideal.subset_span ⟨i, rfl⟩

  have hev : ∀ (χ : R →ₐ[K] K) (w : Q → K) (r : Q → R),
      MvPolynomial.aevalTower χ w (∑ q, MvPolynomial.C (r q) * MvPolynomial.X q) =
        ∑ q, w q * χ (r q) := by
    intro χ w r
    simp only [map_sum, map_mul, MvPolynomial.aevalTower_C, MvPolynomial.aevalTower_X]
    exact Finset.sum_congr rfl (fun q _ => mul_comm _ _)
  have hχs : ∀ (χ : R →ₐ[K] K) (w : Q → K) (r : Q → R),
      χ (∑ q, w q • r q) = ∑ q, w q * χ (r q) := by
    intro χ w r
    simp only [map_sum, map_smul, smul_eq_mul]
  have hDs : ∀ (k : Fin n) (w : Q → K) (r : Q → R),
      D k (∑ q, w q • r q) = ∑ q, w q • D k (r q) := by
    intro k w r
    simp only [map_sum, Derivation.map_smul]
  have hEval : ∀ (χ : R →ₐ[K] K) (w : Q → K) (i : Option (Fin n)),
      ∑ j, w j * χ (L i j) =
        Option.elim i (χ (∑ q, w q • ℓ q)) (fun k => χ (D k (∑ q, w q • ℓ q))) := by
    intro χ w i
    cases i with
    | none => exact (hχs χ w ℓ).symm
    | some k =>
      show ∑ j, w j * χ (D k (ℓ j)) = χ (D k (∑ q, w q • ℓ q))
      rw [hDs, hχs]
  have hEvΔ : ∀ (χ : R →ₐ[K] K) (w : Q → K), MvPolynomial.aevalTower χ w Δ =
      (Matrix.of fun i j => χ (D i (D j (∑ q, w q • ℓ q)))).det := by
    intro χ w
    rw [hΔ, AlgHom.map_det]
    congr 1
    ext i j
    simp only [AlgHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply]
    rw [hev, hDs, hDs, hχs]
  have hIlinker : ∀ (χ : R →ₐ[K] K) (w : Q → K), χ (∑ q, w q • ℓ q) = 0 →
      (∀ k, χ (D k (∑ q, w q • ℓ q)) = 0) → Ilin ≤ RingHom.ker (MvPolynomial.aevalTower χ w) := by
    intro χ w h0 hk
    rw [hIlin, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker, hev, hEval]
    cases i with
    | none => exact h0
    | some k => exact hk k

  have hscale : ∀ (χ : R →ₐ[K] K) (a : K), a ≠ 0 → ∀ (u w : Q → K), (∀ q, u q = a * w q) →
      χ (∑ q, u q • ℓ q) = 0 → (∀ k, χ (D k (∑ q, u q • ℓ q)) = 0) →
      (Matrix.of fun i j => χ (D i (D j (∑ q, u q • ℓ q)))).det = 0 →
      χ (∑ q, w q • ℓ q) = 0 ∧ (∀ k, χ (D k (∑ q, w q • ℓ q)) = 0) ∧
        (Matrix.of fun i j => χ (D i (D j (∑ q, w q • ℓ q)))).det = 0 := by
    intro χ a ha u w hu h0 hk hdet
    have hsc : ∑ q, u q • ℓ q = a • ∑ q, w q • ℓ q := by
      rw [Finset.smul_sum]
      exact Finset.sum_congr rfl (fun q _ => by rw [hu q, smul_smul])
    rw [hsc] at h0 hk hdet
    simp only [map_smul, Derivation.map_smul, smul_eq_mul] at h0 hk hdet
    refine ⟨(mul_eq_zero.mp h0).resolve_left ha, fun k => (mul_eq_zero.mp (hk k)).resolve_left ha, ?_⟩
    have hM : (Matrix.of fun i j => a * χ (D i (D j (∑ q, w q • ℓ q)))) =
        a • Matrix.of fun i j => χ (D i (D j (∑ q, w q • ℓ q))) := by
      ext i j; simp
    rw [hM, Matrix.det_smul] at hdet
    exact (mul_eq_zero.mp hdet).resolve_left (pow_ne_zero _ ha)

  have hpt : ∀ (χ : R →ₐ[K] K) (w : Q → K), χ (∑ q, w q • ℓ q) = 0 →
      (∀ k, χ (D k (∑ q, w q • ℓ q)) = 0) →
      (Matrix.of fun i j => χ (D i (D j (∑ q, w q • ℓ q)))).det = 0 →
      ∃ ψ₀ : (MvPolynomial Q R ⧸ I) →ₐ[K] K,
        ∀ q, ψ₀ (Ideal.Quotient.mk I (MvPolynomial.X q)) = w q := by
    intro χ w h0 hk hdet
    have hle' : I ≤ RingHom.ker (MvPolynomial.aevalTower χ w) := by
      rw [hI]
      refine sup_le (hIlinker χ w h0 hk) ?_
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker, hEvΔ]
      exact hdet
    refine ⟨Ideal.Quotient.liftₐ I (MvPolynomial.aevalTower χ w)
      (fun p hp => RingHom.mem_ker.mp (hle' hp)), fun q => ?_⟩
    show MvPolynomial.aevalTower χ w (MvPolynomial.X q) = w q
    exact MvPolynomial.aevalTower_X χ w q

  have s6 : ∀ r : R, r ≠ 0 → ∃ χ : R →ₐ[K] K, χ r ≠ 0 := by
    intro r hr
    haveI : IsDomain (Localization.Away r) :=
      IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hr)
    obtain ⟨m, hm⟩ := Ideal.exists_maximal (Localization.Away r)
    letI : Field (Localization.Away r ⧸ m) := Ideal.Quotient.field m
    have : Algebra.FiniteType K (Localization.Away r ⧸ m) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ K m)
        (Ideal.Quotient.mkₐ_surjective K m)
    have : Module.Finite K (Localization.Away r ⧸ m) :=
      finite_of_finite_type_of_isJacobsonRing K (Localization.Away r ⧸ m)
    have : Algebra.IsIntegral K (Localization.Away r ⧸ m) := Algebra.IsIntegral.of_finite K _
    have hbij := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K)
      (K := Localization.Away r ⧸ m)
    let eK : K ≃ₐ[K] Localization.Away r ⧸ m :=
      AlgEquiv.ofBijective (Algebra.ofId K (Localization.Away r ⧸ m)) hbij
    refine ⟨eK.symm.toAlgHom.comp ((Ideal.Quotient.mkₐ K m).comp
      (IsScalarTower.toAlgHom K R (Localization.Away r))), ?_⟩
    intro h0
    have hu : IsUnit (algebraMap R (Localization.Away r) r) :=
      IsLocalization.Away.algebraMap_isUnit r
    have hu2 : IsUnit (Ideal.Quotient.mk m (algebraMap R (Localization.Away r) r)) := hu.map _
    apply hu2.ne_zero
    have h1 : eK.symm (Ideal.Quotient.mk m (algebraMap R (Localization.Away r) r)) = eK.symm 0 := by
      rw [map_zero]; exact h0
    exact eK.symm.injective h1

  have hsurj : ∀ (χ : R →ₐ[K] K) (y : Option (Fin n) → K), ∃ w : Q → K,
      ∀ i, ∑ j, w j * χ (L i j) = y i := by
    intro χ y
    obtain ⟨w, hw1, hw2⟩ := hJ1 χ (y none) (fun k => y (some k))
    refine ⟨w, fun i => ?_⟩
    rw [hEval]
    cases i with
    | none => exact hw1
    | some k => exact hw2 k

  have s1 : Ideal.span (Set.range fun a : {a : Option (Fin n) → Q // Function.Injective a} =>
      (Matrix.of fun i k => L i (a.1 k)).det) = ⊤ := by
    by_contra hJ
    obtain ⟨m, hm, hJm⟩ := Ideal.exists_le_maximal _ hJ
    letI : Field (R ⧸ m) := Ideal.Quotient.field m
    have : Algebra.FiniteType K (R ⧸ m) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ K m)
        (Ideal.Quotient.mkₐ_surjective K m)
    have : Module.Finite K (R ⧸ m) := finite_of_finite_type_of_isJacobsonRing K (R ⧸ m)
    have : Algebra.IsIntegral K (R ⧸ m) := Algebra.IsIntegral.of_finite K _
    have hbij := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K) (K := R ⧸ m)
    let eK : K ≃ₐ[K] R ⧸ m := AlgEquiv.ofBijective (Algebra.ofId K (R ⧸ m)) hbij
    let χ : R →ₐ[K] K := eK.symm.toAlgHom.comp (Ideal.Quotient.mkₐ K m)
    have hχ : ∀ r ∈ m, χ r = 0 := by
      intro r hr
      have h0 : Ideal.Quotient.mkₐ K m r = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hr
      show eK.symm (Ideal.Quotient.mkₐ K m r) = 0
      rw [h0, map_zero]
    let c : Q → (Option (Fin n) → K) := fun j i => χ (L i j)
    have hspan : Submodule.span K (Set.range c) = ⊤ := by
      rw [eq_top_iff]
      intro y _
      obtain ⟨w, hw⟩ := hsurj χ y
      have hy : y = ∑ j, w j • c j := by
        ext i
        rw [Finset.sum_apply, ← hw i]
        rfl
      rw [hy]
      exact Submodule.sum_mem _ (fun j _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩))
    obtain ⟨κ, b, hb, hbspan, hbli⟩ := exists_linearIndependent' K c
    have : Finite κ := Finite.of_injective b hb
    letI : Fintype κ := Fintype.ofFinite κ
    have hcard : Fintype.card κ = Fintype.card (Option (Fin n)) := by
      let B := Module.Basis.mk hbli (by rw [hbspan, hspan])
      have := Module.finrank_eq_card_basis B
      rw [Module.finrank_fintype_fun_eq_card] at this
      exact this.symm
    let σ : Option (Fin n) ≃ κ := Fintype.equivOfCardEq hcard.symm
    let a : Option (Fin n) → Q := b ∘ σ
    have ha : Function.Injective a := hb.comp σ.injective
    let N : Matrix (Option (Fin n)) (Option (Fin n)) K := Matrix.of fun i k => χ (L i (a k))
    have hN : LinearIndependent K N.col := by
      have : N.col = (c ∘ b) ∘ σ := by
        ext k i
        rfl
      rw [this]
      exact hbli.comp σ σ.injective
    have hdet : N.det ≠ 0 :=
      ((Matrix.isUnit_iff_isUnit_det N).mp (Matrix.linearIndependent_cols_iff_isUnit.mp hN)).ne_zero
    apply hdet
    have h1 : χ (Matrix.of fun i k => L i (a k)).det = 0 :=
      hχ _ (hJm (Ideal.subset_span ⟨⟨a, ha⟩, rfl⟩))
    rw [AlgHom.map_det] at h1
    exact h1

  have s2 : ∀ x : R, ringKrullDim (Localization.Away x) ≤ ringKrullDim R := by
    intro x
    rw [ringKrullDim_le_iff_height_le]
    intro p hp
    rw [← IsLocalization.height_under (Submonoid.powers x) p]
    exact Ideal.height_le_ringKrullDim_of_ne_top (Ideal.IsPrime.ne_top inferInstance)

  have s3 : ∀ (S : Type u) [CommRing S] {κ : Type} (f : κ → S),
      Ideal.span (Set.range f) = ⊤ → ∀ (d : WithBot ℕ∞),
      (∀ k, ringKrullDim (Localization.Away (f k)) ≤ d) → ringKrullDim S ≤ d := by
    intro S _ κ f hf d hd
    rw [ringKrullDim_le_iff_height_le]
    intro Q' hQ'
    obtain ⟨k, hk⟩ : ∃ k, f k ∉ Q' := by
      by_contra h
      push_neg at h
      apply hQ'.ne_top
      rw [eq_top_iff, ← hf, Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      exact h k
    have hdisj : Disjoint (Submonoid.powers (f k) : Set S) (Q' : Set S) := by
      rw [Set.disjoint_left]
      rintro _ ⟨m, rfl⟩ hm
      exact hk (hQ'.mem_of_pow_mem m hm)
    have hP := IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers (f k))
      (Localization.Away (f k)) Q' hQ' hdisj
    rw [← IsLocalization.height_map_of_disjoint (S := Localization.Away (f k))
      (Submonoid.powers (f k)) Q' hdisj]
    exact (Ideal.height_le_ringKrullDim_of_ne_top hP.ne_top).trans (hd k)

  have s4 : ∀ (a : Option (Fin n) → Q), Function.Injective a →
      ∃ f : MvPolynomial {j : Q // j ∉ Set.range a}
          (Localization.Away (Matrix.of fun i k => L i (a k)).det) →+*
        Localization.Away (Ideal.Quotient.mk Ilin
          (MvPolynomial.C (Matrix.of fun i k => L i (a k)).det)),
        Function.Surjective f := by
    intro a ha
    set A : Matrix (Option (Fin n)) (Option (Fin n)) R := Matrix.of fun i k => L i (a k) with hA
    set δ := A.det with hδ
    set π := Ideal.Quotient.mk Ilin with hπ
    set δS := π (MvPolynomial.C δ) with hδS
    let T := Localization.Away δS
    let g₀ : R →+* T := (algebraMap _ T).comp (π.comp MvPolynomial.C)
    have hg₀δ : g₀ δ = algebraMap _ T δS := rfl
    have hg₀u : IsUnit (g₀ δ) := by
      rw [hg₀δ]; exact IsLocalization.Away.algebraMap_isUnit δS
    let g : Localization.Away δ →+* T := IsLocalization.Away.lift δ hg₀u
    have hg : ∀ r : R, g (algebraMap R _ r) = g₀ r := fun r =>
      IsLocalization.Away.lift_eq δ hg₀u r
    let y : Q → T := fun j => algebraMap _ T (π (MvPolynomial.X j))
    let f : MvPolynomial {j : Q // j ∉ Set.range a} (Localization.Away δ) →+* T :=
      MvPolynomial.eval₂Hom g (fun j => y j.1)
    refine ⟨f, ?_⟩
    have hi : ∀ r : R, g₀ r ∈ f.range := fun r =>
      ⟨MvPolynomial.C (algebraMap R _ r), by
        simp only [f, MvPolynomial.eval₂Hom_C, hg]⟩
    set u := g (IsLocalization.Away.invSelf δ) with hu
    have hii : u ∈ f.range := ⟨MvPolynomial.C (IsLocalization.Away.invSelf δ), by
        simp only [f, MvPolynomial.eval₂Hom_C, hu]⟩
    have hδu : g₀ δ * u = 1 := by
      rw [← hg, hu, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
    have hiii : ∀ (j : Q) (hj : j ∉ Set.range a), y j ∈ f.range := fun j hj =>
      ⟨MvPolynomial.X ⟨j, hj⟩, by simp only [f, MvPolynomial.eval₂Hom_X']⟩
    have hrel : ∀ i, ∑ j, g₀ (L i j) * y j = 0 := by
      intro i
      have h0 : π (∑ j, MvPolynomial.C (L i j) * MvPolynomial.X j) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (hgen i)
      have h1 := congrArg (algebraMap _ T) h0
      rw [map_zero, map_sum, map_sum] at h1
      simp only [map_mul] at h1
      exact h1
    let b : Option (Fin n) → T := fun i =>
      ∑ j : {j : Q // j ∉ Set.range a}, g₀ (L i j.1) * y j.1
    let v : Option (Fin n) → T := fun k => y (a k)
    let A' : Matrix (Option (Fin n)) (Option (Fin n)) T := g₀.mapMatrix A
    have hmv : A'.mulVec v = -b := by
      funext i
      have h := Fintype.sum_subtype_add_sum_subtype (fun j => j ∈ Set.range a)
        (fun j => g₀ (L i j) * y j)
      have hs : ∑ j : {j : Q // j ∈ Set.range a}, g₀ (L i j.1) * y j.1 =
          ∑ k, g₀ (L i (a k)) * y (a k) := by
        symm
        exact Fintype.sum_bijective (fun k => (⟨a k, k, rfl⟩ : {j : Q // j ∈ Set.range a}))
          ⟨fun k k' hkk' => ha (congrArg Subtype.val hkk'),
            fun ⟨_, k, hk⟩ => ⟨k, Subtype.ext hk⟩⟩
          _ _ (fun k => rfl)
      have e1 : A'.mulVec v i = ∑ k, g₀ (L i (a k)) * y (a k) := rfl
      rw [Pi.neg_apply, e1, ← hs]
      convert eq_neg_of_add_eq_zero_left (h.trans (hrel i))
    have hdet : A'.det = g₀ δ := (RingHom.map_det g₀ A).symm
    have hiv : ∀ k, v k ∈ f.range := by
      intro k
      have h1 : A'.adjugate.mulVec (A'.mulVec v) = A'.det • v := by
        rw [Matrix.mulVec_mulVec, Matrix.adjugate_mul, Matrix.smul_mulVec, Matrix.one_mulVec]
      rw [hmv, hdet] at h1
      have h2 := congrFun h1 k
      rw [Pi.smul_apply, smul_eq_mul] at h2
      have h3 : v k = u * (A'.adjugate.mulVec (-b)) k := by
        rw [h2, ← mul_assoc, mul_comm u, hδu, one_mul]
      rw [h3]
      refine f.range.mul_mem hii ?_
      rw [Matrix.mulVec_neg, Pi.neg_apply]
      refine f.range.neg_mem ?_
      show ∑ i, A'.adjugate k i * b i ∈ f.range
      refine f.range.sum_mem (fun i _ => f.range.mul_mem ?_ ?_)
      · rw [← RingHom.map_adjugate]
        exact hi _
      · exact f.range.sum_mem (fun j _ => f.range.mul_mem (hi _) (hiii j.1 j.2))
    have hy : ∀ j, y j ∈ f.range := by
      intro j
      by_cases hj : j ∈ Set.range a
      · obtain ⟨k, rfl⟩ := hj
        exact hiv k
      · exact hiii j hj
    have hv : ∀ p : MvPolynomial Q R, algebraMap _ T (π p) ∈ f.range := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C r => exact hi r
      | add p q hp hq => rw [map_add, map_add]; exact f.range.add_mem hp hq
      | mul_X p j hp => rw [map_mul, map_mul]; exact f.range.mul_mem hp (hy j)
    intro t
    obtain ⟨m, s, hn⟩ := IsLocalization.Away.surj δS t
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective s
    have ht : t = algebraMap _ T (π p) * u ^ m := by
      calc t = t * (g₀ δ * u) ^ m := by rw [hδu, one_pow, mul_one]
        _ = (t * algebraMap _ T δS ^ m) * u ^ m := by rw [hg₀δ]; ring
        _ = _ := by rw [hn]
    rw [ht]
    exact f.range.mul_mem (hv p) (f.range.pow_mem hii m)

  have arith1 : ∀ (y : WithBot ℕ∞) (m : ℕ), y + 1 ≤ ((m - 1 : ℕ) : WithBot ℕ∞) →
      y ≤ (if 2 ≤ m then ((m - 2 : ℕ) : WithBot ℕ∞) else ⊥) := by
    intro y m hy
    induction y using WithBot.recBotCoe with
    | bot => exact bot_le
    | coe e =>
      have h2 : ((m - 1 : ℕ) : WithBot ℕ∞) = (((m - 1 : ℕ) : ℕ∞) : WithBot ℕ∞) := rfl
      rw [h2, ← WithBot.coe_one, ← WithBot.coe_add, WithBot.coe_le_coe] at hy
      induction e using ENat.recTopCoe with
      | top =>
        exfalso
        rw [top_add] at hy
        exact ENat.coe_ne_top _ (top_le_iff.mp hy)
      | coe k =>
        have hk : k + 1 ≤ m - 1 := by exact_mod_cast hy
        rw [if_pos (by omega)]
        have h3 : ((m - 2 : ℕ) : WithBot ℕ∞) = (((m - 2 : ℕ) : ℕ∞) : WithBot ℕ∞) := rfl
        rw [h3, WithBot.coe_le_coe]
        exact_mod_cast (by omega : k ≤ m - 2)
  have arith2 : ∀ (x : WithBot ℕ∞) (m e : ℕ),
      x ≤ (if 2 ≤ m then ((m - 2 : ℕ) : WithBot ℕ∞) else ⊥) →
      e ≤ m + 1 → x + (((e : ℕ) : ℕ∞) : WithBot ℕ∞) < ((2 * m : ℕ) : WithBot ℕ∞) := by
    intro x m e hx he
    split_ifs at hx with hm
    · induction x using WithBot.recBotCoe with
      | bot => rw [WithBot.bot_add]; exact WithBot.bot_lt_coe _
      | coe z =>
        have h2 : ((m - 2 : ℕ) : WithBot ℕ∞) = (((m - 2 : ℕ) : ℕ∞) : WithBot ℕ∞) := rfl
        rw [h2, WithBot.coe_le_coe] at hx
        induction z using ENat.recTopCoe with
        | top => exact absurd (top_le_iff.mp hx) (ENat.coe_ne_top _)
        | coe k =>
          have hk : k ≤ m - 2 := by exact_mod_cast hx
          have h3 : ((2 * m : ℕ) : WithBot ℕ∞) = (((2 * m : ℕ) : ℕ∞) : WithBot ℕ∞) := rfl
          rw [h3, ← WithBot.coe_add, WithBot.coe_lt_coe]
          exact_mod_cast (by omega : k + e < 2 * m)
    · rw [le_bot_iff] at hx
      rw [hx, WithBot.bot_add]
      exact WithBot.bot_lt_coe _

  have g3 : ∀ a : {a : Option (Fin n) → Q // Function.Injective a},
      ringKrullDim (Localization.Away (Ideal.Quotient.mk I
        (MvPolynomial.C (Matrix.of fun i k => L i (a.1 k)).det))) + 1 ≤
        ((Fintype.card Q - 1 : ℕ) : WithBot ℕ∞) := by
    rintro ⟨a, ha⟩
    show ringKrullDim (Localization.Away (Ideal.Quotient.mk I
        (MvPolynomial.C (Matrix.of fun i k => L i (a k)).det))) + 1 ≤ _
    set δ := (Matrix.of fun i k => L i (a k)).det with hδ
    obtain ⟨f, hf⟩ : ∃ f : MvPolynomial {j : Q // j ∉ Set.range a} (Localization.Away δ) →+*
        Localization.Away (Ideal.Quotient.mk Ilin (MvPolynomial.C δ)),
        Function.Surjective f := s4 a ha
    by_cases hδ0 : δ = 0
    · have h0 : (0 : MvPolynomial Q R ⧸ I) ∈
          Submonoid.powers (Ideal.Quotient.mk I (MvPolynomial.C δ)) :=
        (Submonoid.mem_powers_iff _ _).mpr ⟨1, by rw [pow_one, hδ0, map_zero, map_zero]⟩
      haveI := IsLocalization.uniqueOfZeroMem
        (S := Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C δ))) h0
      rw [ringKrullDim_eq_bot_of_subsingleton, WithBot.bot_add]
      exact bot_le
    · have hg₀u : IsUnit (((algebraMap (MvPolynomial Q R ⧸ I)
          (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C δ)))).comp
          (Ideal.Quotient.factor hle)) (Ideal.Quotient.mk Ilin (MvPolynomial.C δ))) := by
        rw [RingHom.comp_apply, Ideal.Quotient.factor_mk]
        exact IsLocalization.Away.algebraMap_isUnit _
      obtain ⟨g, hgx⟩ : ∃ g : Localization.Away (Ideal.Quotient.mk Ilin (MvPolynomial.C δ)) →+*
          Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C δ)),
          ∀ z, g (algebraMap _ _ z) = algebraMap _ _ (Ideal.Quotient.factor hle z) :=
        ⟨IsLocalization.Away.lift _ hg₀u, fun z => IsLocalization.Away.lift_eq _ hg₀u z⟩
      have hgs : Function.Surjective g := by
        intro t
        obtain ⟨m, z, hz⟩ := IsLocalization.Away.surj (Ideal.Quotient.mk I (MvPolynomial.C δ)) t
        obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
        have e1 := hgx (Ideal.Quotient.mk Ilin (MvPolynomial.C δ))
        rw [Ideal.Quotient.factor_mk] at e1
        have hyu : algebraMap _ (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C δ)))
            (Ideal.Quotient.mk I (MvPolynomial.C δ)) *
            g (IsLocalization.Away.invSelf (Ideal.Quotient.mk Ilin (MvPolynomial.C δ))) = 1 := by
          rw [← e1, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
        refine ⟨algebraMap _ _ (Ideal.Quotient.mk Ilin p) *
          IsLocalization.Away.invSelf (Ideal.Quotient.mk Ilin (MvPolynomial.C δ)) ^ m, ?_⟩
        rw [map_mul, map_pow, hgx, Ideal.Quotient.factor_mk]
        calc _ = (t * algebraMap _ _ (Ideal.Quotient.mk I (MvPolynomial.C δ)) ^ m) *
              g (IsLocalization.Away.invSelf (Ideal.Quotient.mk Ilin (MvPolynomial.C δ))) ^ m := by
              rw [hz]
          _ = t * (algebraMap _ _ (Ideal.Quotient.mk I (MvPolynomial.C δ)) *
              g (IsLocalization.Away.invSelf (Ideal.Quotient.mk Ilin (MvPolynomial.C δ)))) ^ m := by
              ring
          _ = t := by rw [hyu, one_pow, mul_one]
      have hΔlin : algebraMap _ (Localization.Away (Ideal.Quotient.mk Ilin (MvPolynomial.C δ)))
          (Ideal.Quotient.mk Ilin Δ) ≠ 0 := by
        obtain ⟨χ, hχ⟩ := s6 δ hδ0
        obtain ⟨w, hw0, hwk, hwdet⟩ := hJ2 χ
        have hker := hIlinker χ w hw0 hwk
        obtain ⟨evL, hevL⟩ : ∃ evL : (MvPolynomial Q R ⧸ Ilin) →+* K,
            ∀ p, evL (Ideal.Quotient.mk Ilin p) = MvPolynomial.aevalTower χ w p :=
          ⟨Ideal.Quotient.lift Ilin (MvPolynomial.aevalTower χ w : MvPolynomial Q R →+* K)
            (fun p hp => RingHom.mem_ker.mp (hker hp)), fun p => Ideal.Quotient.lift_mk _ _ _⟩
        have hu : IsUnit (evL (Ideal.Quotient.mk Ilin (MvPolynomial.C δ))) := by
          rw [hevL, MvPolynomial.aevalTower_C]; exact isUnit_iff_ne_zero.mpr hχ
        intro h0
        have h1 := congrArg (IsLocalization.Away.lift
          (S := Localization.Away (Ideal.Quotient.mk Ilin (MvPolynomial.C δ))) _ hu) h0
        rw [map_zero, IsLocalization.Away.lift_eq, hevL, hEvΔ] at h1
        exact hwdet h1
      obtain ⟨b, hb⟩ := hf (algebraMap _ (Localization.Away (Ideal.Quotient.mk Ilin
        (MvPolynomial.C δ))) (Ideal.Quotient.mk Ilin Δ))
      have hb0 : b ≠ 0 := by
        rintro rfl
        rw [map_zero] at hb
        exact hΔlin hb.symm
      have hτb : (g.comp f) b = 0 := by
        rw [RingHom.comp_apply, hb, hgx, Ideal.Quotient.factor_mk,
          Ideal.Quotient.eq_zero_iff_mem.mpr hΔI, map_zero]
      haveI : IsDomain (Localization.Away δ) :=
        IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hδ0)
      have hτs : Function.Surjective (g.comp f) := hgs.comp hf
      have hker : ∀ z ∈ Ideal.span {b}, (g.comp f) z = 0 := by
        intro z hz
        obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hz
        rw [map_mul, hτb, mul_zero]
      have h1 : ringKrullDim (Localization.Away (Ideal.Quotient.mk I (MvPolynomial.C δ))) ≤
          ringKrullDim (MvPolynomial {j : Q // j ∉ Set.range a} (Localization.Away δ) ⧸
            Ideal.span {b}) := by
        have hs := Ideal.Quotient.lift_surjective_of_surjective (Ideal.span {b}) hker hτs
        exact ringKrullDim_le_of_surjective _ hs
      have h2 := ringKrullDim_quotient_succ_le_of_nonZeroDivisor (mem_nonZeroDivisors_of_ne_zero hb0)
      have hB : ringKrullDim (MvPolynomial {j : Q // j ∉ Set.range a} (Localization.Away δ)) ≤
          ((Fintype.card Q - 1 : ℕ) : WithBot ℕ∞) := by
        have hle' : Fintype.card (Option (Fin n)) ≤ Fintype.card Q :=
          Fintype.card_le_of_injective a ha
        rw [Fintype.card_option, Fintype.card_fin] at hle'
        have hc : Fintype.card {j : Q // j ∉ Set.range a} =
            Fintype.card Q - Fintype.card (Option (Fin n)) := by
          rw [Fintype.card_subtype_compl, ← Set.card_range_of_injective ha]
          try (congr 1; exact Fintype.card_congr (Equiv.refl _))
        rw [Fintype.card_option, Fintype.card_fin] at hc
        rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ENat.card_eq_coe_fintype_card, hc,
          show Fintype.card Q - 1 = n + (Fintype.card Q - (n + 1)) by omega, Nat.cast_add]
        exact add_le_add ((s2 δ).trans hR) (le_of_eq rfl)
      calc _ ≤ ringKrullDim (MvPolynomial {j : Q // j ∉ Set.range a} (Localization.Away δ) ⧸
            Ideal.span {b}) + 1 := add_le_add h1 le_rfl
        _ ≤ _ := h2
        _ ≤ _ := hB

  have hC : ringKrullDim (MvPolynomial Q R ⧸ I) ≤
      (if 2 ≤ Fintype.card Q then ((Fintype.card Q - 2 : ℕ) : WithBot ℕ∞) else ⊥) := by
    refine s3 _ (fun a : {a : Option (Fin n) → Q // Function.Injective a} =>
      Ideal.Quotient.mk I (MvPolynomial.C (Matrix.of fun i k => L i (a.1 k)).det)) ?_ _ ?_
    · have hrange : (Set.range fun a : {a : Option (Fin n) → Q // Function.Injective a} =>
          Ideal.Quotient.mk I (MvPolynomial.C (Matrix.of fun i k => L i (a.1 k)).det)) =
          ((Ideal.Quotient.mk I).comp MvPolynomial.C) '' (Set.range fun a :
            {a : Option (Fin n) → Q // Function.Injective a} =>
              (Matrix.of fun i k => L i (a.1 k)).det) := by
        rw [← Set.range_comp]
        rfl
      rw [hrange, ← Ideal.map_span, s1, Ideal.map_top]
    · intro a
      exact arith1 _ _ (g3 a)

  refine ⟨MvPolynomial (Option Q) (MvPolynomial Q R ⧸ I), MvPolynomial Q (MvPolynomial Q R ⧸ I),
    inferInstance, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    MvPolynomial.aeval (fun s : Fin 2 × Q => if s.1 = 0 then
      (MvPolynomial.X (some s.2) : MvPolynomial (Option Q) (MvPolynomial Q R ⧸ I)) else
      MvPolynomial.X none * MvPolynomial.X (some s.2) -
        MvPolynomial.C (Ideal.Quotient.mk I (MvPolynomial.X s.2))),
    MvPolynomial.aeval (fun s : Fin 2 × Q => if s.1 = 0 then
      MvPolynomial.C (Ideal.Quotient.mk I (MvPolynomial.X s.2)) else
      (MvPolynomial.X s.2 : MvPolynomial Q (MvPolynomial Q R ⧸ I))), ?_, ?_, ?_⟩
  · rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ENat.card_eq_coe_fintype_card,
      Fintype.card_prod, Fintype.card_fin]
    exact arith2 _ _ _ hC (le_of_eq Fintype.card_option)
  · rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ENat.card_eq_coe_fintype_card,
      Fintype.card_prod, Fintype.card_fin]
    exact arith2 _ _ _ hC (Nat.le_succ _)
  · intro χ v c hc h0 hk hdet
    by_cases hc0 : c 0 = 0
    · right
      have hc1 : c 1 ≠ 0 := by
        intro h1
        apply hc
        funext i
        fin_cases i <;> simp [hc0, h1]
      obtain ⟨h0', hk', hdet'⟩ := hscale χ (c 1) hc1 (fun q => c 1 * v (0, q) - c 0 * v (1, q))
        (fun q => v (0, q)) (fun q => by rw [hc0]; ring) h0 hk hdet
      obtain ⟨ψ₀, hψ₀⟩ := hpt χ _ h0' hk' hdet'
      refine ⟨MvPolynomial.aevalTower ψ₀ (fun q => v (1, q)), ?_⟩
      apply MvPolynomial.algHom_ext
      rintro ⟨e, q⟩
      fin_cases e
      · simp [MvPolynomial.aevalTower_C, MvPolynomial.aevalTower_X, hψ₀]
      · simp [MvPolynomial.aevalTower_C, MvPolynomial.aevalTower_X, hψ₀]
    · left
      obtain ⟨τ, hτ⟩ : ∃ τ : K, c 0 * τ = c 1 := ⟨c 1 / c 0, by field_simp⟩
      obtain ⟨h0', hk', hdet'⟩ := hscale χ (c 0) hc0 (fun q => c 1 * v (0, q) - c 0 * v (1, q))
        (fun q => τ * v (0, q) - v (1, q)) (fun q => by rw [← hτ]; ring) h0 hk hdet
      obtain ⟨ψ₀, hψ₀⟩ := hpt χ _ h0' hk' hdet'
      refine ⟨MvPolynomial.aevalTower ψ₀ (fun o => Option.elim o τ (fun q => v (0, q))), ?_⟩
      apply MvPolynomial.algHom_ext
      rintro ⟨e, q⟩
      fin_cases e
      · simp [MvPolynomial.aevalTower_C, MvPolynomial.aevalTower_X, hψ₀]
      · simp [MvPolynomial.aevalTower_C, MvPolynomial.aevalTower_X, hψ₀]

theorem wc_ldp_odp_generic (K : Type u) [Field K] [IsAlgClosed K] (N n : ℕ) (hn : Even n)
    (hn2 : 2 ≤ n)
    (X : Over (Spec (.of K))) [GeometricallyIrreducible X.hom] [IsProper X.hom]
    [SmoothOfRelativeDimension n X.hom] (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι)
    (hιX : ι ≫ wcProjKStr K N = X.hom) :
    ∃ Φ : MvPolynomial (Fin 2 × Fin (N + 1) × Fin (N + 1)) K, Φ ≠ 0 ∧
      ∀ v : Fin 2 × Fin (N + 1) × Fin (N + 1) → K, MvPolynomial.eval v Φ ≠ 0 →
        ∀ x : X.left, IsClosed ({x} : Set X.left) →
          wcLdpCrit K N X.hom ι (wcLdpQuad K N fun p q => v (0, p, q))
            (wcLdpQuad K N fun p q => v (1, p, q)) x →
          ∀ c : Fin 2 → K, c ≠ 0 →
            wcLdpZero K N ι (c 1 • (wcLdpQuad K N fun p q => v (0, p, q)) -
              c 0 • (wcLdpQuad K N fun p q => v (1, p, q))) x →
            wcLdpODPAt K N n ι (c 1 • (wcLdpQuad K N fun p q => v (0, p, q)) -
              c 0 • (wcLdpQuad K N fun p q => v (1, p, q))) x :=
by
  classical
  obtain ⟨m, a, R, _, _, hFT, hDom, hR, u, t, D, hub, hDt, hker, hcharts⟩ :=
    wc_ldp_smooth_quadric_charts K N n X ι hι hιX

  have unitFact : ∀ (O : Type u) [CommRing O] [IsLocalRing O] (κ : K →+* O) (d : K),
      κ d ∈ IsLocalRing.maximalIdeal O → d = 0 := by
    intro O _ _ κ d hd
    by_contra hne
    exact (IsLocalRing.mem_maximalIdeal _).mp hd ((isUnit_iff_ne_zero.mpr hne).map κ)

  have leib : ∀ (O : Type u) [CommRing O] [IsLocalRing O] (δ : O →+ O),
      (∀ f g : O, δ (f * g) = f * δ g + g * δ f) → ∀ y : O,
      y ∈ IsLocalRing.maximalIdeal O ^ 2 → δ y ∈ IsLocalRing.maximalIdeal O := by
    intro O _ _ δ hδ y hy
    rw [pow_two] at hy
    refine Submodule.mul_induction_on hy ?_ ?_
    · intro a ha b hb
      rw [hδ]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_right _ _ hb)
    · intro a b ha hb
      rw [map_add]
      exact Ideal.add_mem _ ha hb

  have key : ∀ j : Fin m, ∃ Φj : MvPolynomial (Fin 2 × Fin (N + 1) × Fin (N + 1)) K, Φj ≠ 0 ∧
      ∀ (χ : R j →ₐ[K] K) (v : Fin 2 × Fin (N + 1) × Fin (N + 1) → K) (c : Fin 2 → K), c ≠ 0 →
        χ (∑ q, (c 1 * v (0, q) - c 0 * v (1, q)) • (u j q.1 * u j q.2)) = 0 →
        (∀ k, χ (D j k (∑ q, (c 1 * v (0, q) - c 0 * v (1, q)) • (u j q.1 * u j q.2))) = 0) →
        (Matrix.of fun i k => χ (D j i (D j k
          (∑ q, (c 1 * v (0, q) - c 0 * v (1, q)) • (u j q.1 * u j q.2))))).det = 0 →
        MvPolynomial.eval v Φj = 0 := by
    intro j
    haveI := hFT j
    haveI := hDom j
    have hJ1 := fun χ => (wc_ldp_quadric_jets K (R j) N n hn (a j) (u j) (hub j) (t j) (D j)
      (hDt j) χ (hker j χ)).1
    have hJ2 := fun χ => (wc_ldp_quadric_jets K (R j) N n hn (a j) (u j) (hub j) (t j) (D j)
      (hDt j) χ (hker j χ)).2
    obtain ⟨A₁, A₂, _, _, _, _, _, _, φ₁, φ₂, hd1, hd2, hbad⟩ :=
      wc_ldp_hessian_incidence K n (Fin (N + 1) × Fin (N + 1)) (R j) (hR j)
        (fun q => u j q.1 * u j q.2) (D j) hJ1 hJ2
    obtain ⟨Φ1, h1ne, h1⟩ := wc_ldp_alg_dependence K A₁ φ₁ hd1
    obtain ⟨Φ2, h2ne, h2⟩ := wc_ldp_alg_dependence K A₂ φ₂ hd2
    refine ⟨Φ1 * Φ2, mul_ne_zero h1ne h2ne, ?_⟩
    intro χ v c hc h0 hk hdet
    rcases hbad χ v c hc h0 hk hdet with ⟨ψ, hψ⟩ | ⟨ψ, hψ⟩
    · have e1 : MvPolynomial.eval v Φ1 = 0 := by
        have h := congrArg (fun f => f Φ1) hψ
        simp only [AlgHom.comp_apply, h1, map_zero] at h
        first
          | exact h.symm
          | simpa only [MvPolynomial.coe_aeval_eq_eval] using h.symm
          | simpa [MvPolynomial.aeval_def, MvPolynomial.eval] using h.symm
      rw [map_mul, e1, zero_mul]
    · have e2 : MvPolynomial.eval v Φ2 = 0 := by
        have h := congrArg (fun f => f Φ2) hψ
        simp only [AlgHom.comp_apply, h2, map_zero] at h
        first
          | exact h.symm
          | simpa only [MvPolynomial.coe_aeval_eq_eval] using h.symm
          | simpa [MvPolynomial.aeval_def, MvPolynomial.eval] using h.symm
      rw [map_mul, e2, mul_zero]
  choose Φj hΦj0 hΦj using key
  refine ⟨∏ j, Φj j, Finset.prod_ne_zero_iff.mpr (fun j _ => hΦj0 j), ?_⟩
  intro v hv x hxc hcrit c hc hzero b hx
  rw [map_prod] at hv
  have hvj : ∀ j, MvPolynomial.eval v (Φj j) ≠ 0 := fun j =>
    Finset.prod_ne_zero_iff.mp hv j (Finset.mem_univ j)
  set G0 := wcLdpQuad K N fun p q => v (0, p, q) with hG0
  set G1 := wcLdpQuad K N fun p q => v (1, p, q) with hG1
  set κ := wcLdpConst K X.hom x with hκ
  obtain ⟨hnoax, b₁, hb₁, hnsub⟩ := hcrit
  obtain ⟨j, -, χ, lam, δ, hlamχ, hres, hgerm, hm, hδ, hδκ, hδlam⟩ := hcharts x hxc b hx

  have hoff : wcLdpGerm K N ι G0 b₁ x hb₁ ∉ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ∨
      wcLdpGerm K N ι G1 b₁ x hb₁ ∉ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) := by
    by_contra hcon
    push_neg at hcon
    apply hnoax
    intro a₂ ha₂
    obtain ⟨-, -, w, hw, hwG⟩ := wc_ldp_germ_linear K N X.hom ι hιX x a₂ b₁ ha₂ hb₁
    refine ⟨?_, ?_⟩
    · have h1 := hcon.1
      rw [hwG] at h1
      exact (Ideal.unit_mul_mem_iff_mem _ hw).mp h1
    · have h1 := hcon.2
      rw [hwG] at h1
      exact (Ideal.unit_mul_mem_iff_mem _ hw).mp h1

  obtain ⟨hadd, hsmul, -⟩ := wc_ldp_germ_linear K N X.hom ι hιX x b₁ b₁ hb₁ hb₁
  have hsub : ∀ G G' : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2,
      wcLdpGerm K N ι (G - G') b₁ x hb₁ =
        wcLdpGerm K N ι G b₁ x hb₁ - wcLdpGerm K N ι G' b₁ x hb₁ := by
    intro G G'
    have := hadd (G - G') G'
    rw [sub_add_cancel] at this
    rw [this]
    ring
  have hlin : wcLdpGerm K N ι (c 1 • G0 - c 0 • G1) b₁ x hb₁ =
      κ (c 1) * wcLdpGerm K N ι G0 b₁ x hb₁ - κ (c 0) * wcLdpGerm K N ι G1 b₁ x hb₁ := by
    rw [hsub, hsmul, hsmul]
  have hz := hzero b₁ hb₁
  rw [hlin] at hz

  have hsq₁ := wc_ldp_crit_member_sq K (X.left.presheaf.stalk x) κ hres
    (wcLdpGerm K N ι G0 b₁ x hb₁) (wcLdpGerm K N ι G1 b₁ x hb₁) (c 0) (c 1) hoff hz
    (of_not_not hnsub)
  rw [← hlin] at hsq₁

  obtain ⟨-, -, w, -, hwG⟩ := wc_ldp_germ_linear K N X.hom ι hιX x b₁ b hb₁ hx
  have hsq : wcLdpGerm K N ι (c 1 • G0 - c 0 • G1) b x hx ∈
      IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ^ 2 := by
    rw [hwG]
    exact Ideal.mul_mem_left _ _ hsq₁

  have hquad : c 1 • G0 - c 0 • G1 =
      wcLdpQuad K N fun p q => (fun r : Fin (N + 1) × Fin (N + 1) =>
        c 1 * v (0, r) - c 0 * v (1, r)) (p, q) := by
    apply Subtype.ext
    simp only [hG0, hG1, wcLdpQuad, Submodule.coe_sub, Submodule.coe_smul]
    rw [Finset.smul_sum, Finset.smul_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    rw [Finset.smul_sum, Finset.smul_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    simp only [MvPolynomial.smul_eq_C_mul, map_sub, map_mul]
    ring
  set h := ∑ q : Fin (N + 1) × Fin (N + 1), (c 1 * v (0, q) - c 0 * v (1, q)) •
    (u j q.1 * u j q.2) with hh
  have hlh : lam h = wcLdpGerm K N ι (c 1 • G0 - c 0 • G1) b x hx := by
    rw [hquad]
    exact hgerm (fun r => c 1 * v (0, r) - c 0 * v (1, r))
  have hlh2 : lam h ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ^ 2 := by
    rw [hlh]; exact hsq

  have hval : ∀ r : R j, lam r ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) →
      χ r = 0 := by
    intro r hr
    apply unitFact _ κ
    have := Ideal.sub_mem _ hr (hlamχ r)
    rwa [sub_sub_cancel] at this
  have h0 : χ h = 0 := hval h (Ideal.pow_le_self (by norm_num) hlh2)
  have hk : ∀ k, χ (D j k h) = 0 := by
    intro k
    apply hval
    rw [← hδlam]
    exact leib _ (δ k) (hδ k) _ hlh2

  have hdet : (Matrix.of fun i k => χ (D j i (D j k h))).det ≠ 0 := by
    intro hdet0
    exact hvj j (hΦj j χ v c hc h0 hk hdet0)

  obtain ⟨A, hA3, hAu⟩ := wc_ldp_hessian_odp K (X.left.presheaf.stalk x) κ hres n δ hδ hδκ
    (fun k => lam (t j k) - κ (χ (t j k))) hm
    (by
      intro i k
      rw [map_sub, hδκ, sub_zero, hδlam, hDt j i k]
      split_ifs <;> simp)
    (lam h) hlh2 (Matrix.of fun i k => χ (D j i (D j k h)))
    (by
      intro i k
      rw [hδlam, hδlam]
      exact hlamχ _)
    hdet
  refine ⟨fun k => lam (t j k) - κ (χ (t j k)), A, hm, ?_, hAu⟩
  rw [← hlh]
  exact hA3

theorem wc_ldp_loc_cotangent (K : Type u) [Field K] [IsAlgClosed K] {Z : Scheme.{u}}
    (s : Z ⟶ Spec (.of K)) [LocallyOfFiniteType s] (n : ℕ) [SmoothOfRelativeDimension n s]
    (z : Z) (hz : IsClosed ({z} : Set Z)) :
    (∀ y : Z.presheaf.stalk z, ∃ c : K,
      y - wcLdpConst K s z c ∈ IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) ∧
    (∀ y : Fin n → Z.presheaf.stalk z,
      IsLocalRing.maximalIdeal (Z.presheaf.stalk z) = Ideal.span (Set.range y) →
      ∀ c : Fin n → K, ∑ k, wcLdpConst K s z (c k) * y k ∈
        IsLocalRing.maximalIdeal (Z.presheaf.stalk z) ^ 2 → c = 0) :=
by
  classical

  have hA : ∀ y : Z.presheaf.stalk z, ∃ c : K,
      y - wcLdpConst K s z c ∈ IsLocalRing.maximalIdeal (Z.presheaf.stalk z) := by
    haveI : JacobsonSpace Z := LocallyOfFiniteType.jacobsonSpace s
    haveI : LocallyOfFiniteType (Z.fromSpecResidueField z) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hz
    set g := Z.fromSpecResidueField z ≫ s with hg
    have hψ : Spec.map (Spec.preimage g) = g := Spec.map_preimage g
    have hft : (Spec.preimage g).hom.FiniteType := by
      have : LocallyOfFiniteType (Spec.map (Spec.preimage g)) := by rw [hψ]; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
    have hs2 : (Z.fromSpecResidueField z).appTop ≫ (Scheme.ΓSpecIso (Z.residueField z)).hom =
        Z.evaluation ⊤ z trivial := by
      rw [Scheme.fromSpecResidueField, Scheme.Hom.comp_appTop, Scheme.fromSpecStalk_appTop]
      simp only [Category.assoc]
      erw [CategoryTheory.Functor.map_id, Category.id_comp, Scheme.ΓSpecIso_naturality,
        Iso.inv_hom_id_assoc, Scheme.germ_residue]
    have heq : Spec.preimage g = (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ s.appTop ≫
        Z.evaluation ⊤ z trivial := by
      rw [Iso.eq_inv_comp, ← Scheme.ΓSpecIso_naturality, hψ, hg, Scheme.Hom.comp_appTop,
        Category.assoc, hs2]
    letI : Algebra K (Z.residueField z) := (Spec.preimage g).hom.toAlgebra
    haveI : Algebra.FiniteType K (Z.residueField z) := hft
    haveI : Module.Finite K (Z.residueField z) := finite_of_finite_type_of_isJacobsonRing K _
    have hsurj : Function.Surjective (Spec.preimage g).hom := by
      intro t
      have ht : IsIntegral K t := Algebra.IsIntegral.isIntegral t
      have hdeg := IsAlgClosed.degree_eq_one_of_irreducible K (minpoly.irreducible ht)
      obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one K t hdeg
      exact ⟨c, hc⟩
    have hres : ∀ c : K, (Spec.preimage g).hom c =
        IsLocalRing.residue (Z.presheaf.stalk z) (wcLdpConst K s z c) := by
      intro c
      rw [heq]
      rfl
    intro y
    obtain ⟨c, hc⟩ := hsurj (IsLocalRing.residue (Z.presheaf.stalk z) y)
    refine ⟨c, ?_⟩
    rw [← IsLocalRing.residue_eq_zero_iff, map_sub, ← hres, hc, sub_self]
  refine ⟨hA, ?_⟩

  intro y hy c hc
  letI := (wcLdpConst K s z).toAlgebra
  obtain ⟨_, hfree, hfin, hrank, _⟩ := wc_ldp_il_stalk_of_smooth_field K s n z
  haveI := hfree
  haveI := hfin
  let b : Module.Basis (Fin n) (Z.presheaf.stalk z) (KaehlerDifferential K (Z.presheaf.stalk z)) :=
    Module.finBasisOfFinrankEq _ _ hrank
  let δ : Fin n → Z.presheaf.stalk z → IsLocalRing.ResidueField (Z.presheaf.stalk z) :=
    fun l a => IsLocalRing.residue (Z.presheaf.stalk z)
      (b.coord l (KaehlerDifferential.D K (Z.presheaf.stalk z) a))
  have hδadd : ∀ l a a', δ l (a + a') = δ l a + δ l a' := by
    intro l a a'
    simp only [δ, map_add]
  have hδmul : ∀ l a a', δ l (a * a') =
      IsLocalRing.residue (Z.presheaf.stalk z) a * δ l a' +
        IsLocalRing.residue (Z.presheaf.stalk z) a' * δ l a := by
    intro l a a'
    simp only [δ, Derivation.leibniz, map_add, map_smul, smul_eq_mul, map_mul]
  have hδc : ∀ l (c : K), δ l (wcLdpConst K s z c) = 0 := by
    intro l c
    show δ l (algebraMap K (Z.presheaf.stalk z) c) = 0
    simp only [δ, Derivation.map_algebraMap, map_zero]
  have hδ0 : ∀ l, δ l 0 = 0 := by
    intro l
    simp only [δ, map_zero]
  have hym : ∀ k, y k ∈ IsLocalRing.maximalIdeal (Z.presheaf.stalk z) := fun k => by
    rw [hy]; exact Ideal.subset_span ⟨k, rfl⟩
  have hry : ∀ k, IsLocalRing.residue (Z.presheaf.stalk z) (y k) = 0 := fun k =>
    (IsLocalRing.residue_eq_zero_iff _).mpr (hym k)
  have hsum : ∀ (r : Fin n → Z.presheaf.stalk z) (l : Fin n) (t : Finset (Fin n)),
      δ l (∑ k ∈ t, r k * y k) =
        ∑ k ∈ t, IsLocalRing.residue (Z.presheaf.stalk z) (r k) * δ l (y k) := by
    intro r l t
    induction t using Finset.induction_on with
    | empty => simp only [Finset.sum_empty, hδ0]
    | insert k t hk ih =>
      rw [Finset.sum_insert hk, Finset.sum_insert hk, hδadd, ih, hδmul, hry, zero_mul, add_zero]
  let M : Matrix (Fin n) (Fin n) (IsLocalRing.ResidueField (Z.presheaf.stalk z)) :=
    Matrix.of fun l k => δ l (y k)
  have hMv : ∀ v l, M.mulVec v l = ∑ k, v k * δ l (y k) := by
    intro v l
    simp only [Matrix.mulVec, dotProduct, M, Matrix.of_apply]
    exact Finset.sum_congr rfl fun k _ => mul_comm _ _
  have hP : ∀ ω : KaehlerDifferential K (Z.presheaf.stalk z),
      ∃ v : Fin n → IsLocalRing.ResidueField (Z.presheaf.stalk z),
        M.mulVec v = fun l => IsLocalRing.residue (Z.presheaf.stalk z) (b.coord l ω) := by
    intro ω
    have hω : ω ∈ Submodule.span (Z.presheaf.stalk z)
        (Set.range (KaehlerDifferential.D K (Z.presheaf.stalk z))) := by
      rw [KaehlerDifferential.span_range_derivation]; trivial
    induction hω using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨a, rfl⟩ := hx
      obtain ⟨c0, hc0⟩ := hA a
      rw [hy] at hc0
      obtain ⟨r, hr⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hc0
      refine ⟨fun k => IsLocalRing.residue (Z.presheaf.stalk z) (r k), ?_⟩
      funext l
      have ha : a = wcLdpConst K s z c0 + ∑ k, r k * y k := by rw [hr]; abel
      show M.mulVec _ l = δ l a
      rw [ha, hδadd, hδc, zero_add, hsum, hMv]
    | zero => exact ⟨0, by funext l; simp⟩
    | add x x' _ _ hx hx' =>
      obtain ⟨v, hv⟩ := hx
      obtain ⟨v', hv'⟩ := hx'
      exact ⟨v + v', by rw [Matrix.mulVec_add, hv, hv']; funext l; simp⟩
    | smul r x _ hx =>
      obtain ⟨v, hv⟩ := hx
      exact ⟨IsLocalRing.residue (Z.presheaf.stalk z) r • v, by
        rw [Matrix.mulVec_smul, hv]; funext l; simp⟩
  have hsurjM : Function.Surjective M.mulVec := by
    intro w
    choose w' hw' using fun l => IsLocalRing.residue_surjective (w l)
    obtain ⟨v, hv⟩ := hP (∑ l, w' l • b l)
    refine ⟨v, ?_⟩
    rw [hv]
    funext l
    simp [Module.Basis.coord_apply, Finsupp.single_apply, hw']
  have hM : IsUnit M := Matrix.mulVec_surjective_iff_isUnit.mp hsurjM
  have hinj : Function.Injective M.mulVec := Matrix.mulVec_injective_iff_isUnit.mpr hM
  have hm2 : ∀ l, ∀ x ∈ IsLocalRing.maximalIdeal (Z.presheaf.stalk z) ^ 2, δ l x = 0 := by
    intro l x hx
    rw [pow_two] at hx
    refine Submodule.mul_induction_on hx ?_ ?_
    · intro a ha a' ha'
      rw [hδmul, (IsLocalRing.residue_eq_zero_iff a).mpr ha,
        (IsLocalRing.residue_eq_zero_iff a').mpr ha', zero_mul, zero_mul, add_zero]
    · intro u u' hu hu'
      rw [hδadd, hu, hu', add_zero]
  have hvec : M.mulVec (fun k => IsLocalRing.residue (Z.presheaf.stalk z)
      (wcLdpConst K s z (c k))) = M.mulVec 0 := by
    rw [Matrix.mulVec_zero]
    funext l
    have h1 : δ l (∑ k, wcLdpConst K s z (c k) * y k) =
        ∑ k, IsLocalRing.residue (Z.presheaf.stalk z) (wcLdpConst K s z (c k)) * δ l (y k) :=
      hsum _ l _
    rw [Pi.zero_apply, hMv, ← h1]
    exact hm2 l _ hc
  have he := hinj hvec
  funext k
  have hk := congrFun he k
  simp only [Pi.zero_apply] at hk
  by_contra hne
  have hu : IsUnit (wcLdpConst K s z (c k)) := (Ne.isUnit hne).map _
  exact (IsLocalRing.notMem_maximalIdeal.mpr hu) ((IsLocalRing.residue_eq_zero_iff _).mp hk)

theorem wc_ldp_odp_congr_degenerate (k R : Type u) [Field k] [CommRing R] [IsLocalRing R]
    [Algebra k R] [Algebra.FormallySmooth k R]
    (hres : ∀ y : R, ∃ c : k, y - algebraMap k R c ∈ IsLocalRing.maximalIdeal R)
    (n : ℕ) (t : Fin n → R) (ht : IsLocalRing.maximalIdeal R = Ideal.span (Set.range t))
    (hind : ∀ c : Fin n → k, ∑ i, algebraMap k R (c i) * t i ∈ IsLocalRing.maximalIdeal R ^ 2 →
      c = 0)
    (c : Matrix (Fin n) (Fin n) k) (hc : (c + c.transpose).det = 0)
    (t' : Fin n → R) (A : Matrix (Fin n) (Fin n) R)
    (ht' : IsLocalRing.maximalIdeal R = Ideal.span (Set.range t'))
    (hA : ∑ i, ∑ j, algebraMap k R (c i j) * t i * t j - ∑ i, ∑ j, A i j * t' i * t' j ∈
      IsLocalRing.maximalIdeal R ^ 3) :
    ¬ IsUnit (A + A.transpose).det :=
by

  have jet_two : ∀ (r : ℕ) (x : Fin r → R),
      (∀ y : R, ∃ c : k, y - algebraMap k R c ∈ IsLocalRing.maximalIdeal R) →
      (∀ i, x i ∈ IsLocalRing.maximalIdeal R) →
      (∀ y ∈ IsLocalRing.maximalIdeal R, ∃ c : Fin r → k,
        y - ∑ i, c i • x i ∈ IsLocalRing.maximalIdeal R ^ 2) →
      (∀ c : Fin r → k, ∑ i, c i • x i ∈ IsLocalRing.maximalIdeal R ^ 2 → ∀ i, c i = 0) →
      ∃ γ : R →ₐ[k] MvPolynomial (Fin r) k ⧸ MvPolynomial.idealOfVars (Fin r) k ^ 2,
        (∀ i, γ (x i) = Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin r) k ^ 2)
          (MvPolynomial.X i)) ∧
        ∀ y ∈ IsLocalRing.maximalIdeal R, γ y ∈ Ideal.map
          (Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin r) k ^ 2))
          (MvPolynomial.idealOfVars (Fin r) k) := by
    intro r x hRES hx hspan hindep
    classical
    set 𝔪 := IsLocalRing.maximalIdeal R with h𝔪
    set I := MvPolynomial.idealOfVars (Fin r) k with hI
    have hmapI : Ideal.map (MvPolynomial.aeval x : MvPolynomial (Fin r) k →ₐ[k] R) I ≤ 𝔪 := by
      rw [hI, MvPolynomial.idealOfVars.eq_1, Ideal.map_span, Ideal.span_le]
      rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
      simpa using hx i
    have hpow : ∀ (n : ℕ) (F : MvPolynomial (Fin r) k), F ∈ I ^ n →
        MvPolynomial.aeval x F ∈ 𝔪 ^ n := by
      intro n F hF
      have h1 : MvPolynomial.aeval x F ∈
          Ideal.map (MvPolynomial.aeval x : MvPolynomial (Fin r) k →ₐ[k] R) (I ^ n) :=
        Ideal.mem_map_of_mem _ hF
      rw [Ideal.map_pow] at h1
      exact Ideal.pow_right_mono hmapI n h1
    have hI1 : ∀ F : MvPolynomial (Fin r) k, F.coeff 0 = 0 → F ∈ I := by
      intro F hF
      have h := (MvPolynomial.mem_pow_idealOfVars_iff 1 F).mpr ?_
      · simpa using h
      intro m hm
      by_contra hlt
      have h0 : m.degree = 0 := by omega
      rw [Finsupp.degree_eq_zero_iff] at h0
      subst h0
      exact (MvPolynomial.mem_support_iff.mp hm) hF
    have hI1' : ∀ F ∈ I, F.coeff 0 = 0 := by
      intro F hF
      have h := (MvPolynomial.mem_pow_idealOfVars_iff 1 F).mp (by simpa using hF)
      by_contra hc
      have := h 0 (MvPolynomial.mem_support_iff.mpr hc)
      simp at this
    have hvar : ∀ F : MvPolynomial (Fin r) k, MvPolynomial.aeval x F ∈ 𝔪 → F ∈ I := by
      intro F hF
      apply hI1
      by_contra hc
      have hG : F - MvPolynomial.C (F.coeff 0) ∈ I := hI1 _ (by simp)
      have h1 : MvPolynomial.aeval x (F - MvPolynomial.C (F.coeff 0)) ∈ 𝔪 := by
        have h := hpow 1 _ (by rw [pow_one]; exact hG)
        rwa [pow_one] at h
      have h2 : algebraMap k R (F.coeff 0) ∈ 𝔪 := by
        have e : algebraMap k R (F.coeff 0) = MvPolynomial.aeval x F -
            MvPolynomial.aeval x (F - MvPolynomial.C (F.coeff 0)) := by
          rw [map_sub, MvPolynomial.aeval_C, sub_sub_cancel]
        rw [e]
        exact Ideal.sub_mem _ hF h1
      have hu : IsUnit (algebraMap k R (F.coeff 0)) := (IsUnit.mk0 _ hc).map _
      exact (IsLocalRing.mem_maximalIdeal _).mp h2 hu
    have hdeg1 : ∀ m : Fin r →₀ ℕ, m.degree = 1 → ∃ j, m = Finsupp.single j 1 := by
      intro m hm
      rw [Finsupp.degree_eq_sum] at hm
      obtain ⟨j, -, hj⟩ := Finset.exists_ne_zero_of_sum_ne_zero (by rw [hm]; exact one_ne_zero)
      refine ⟨j, ?_⟩
      ext i
      by_cases hij : i = j
      · subst hij
        have hle : m i ≤ 1 :=
          hm ▸ Finset.single_le_sum (f := fun i => m i) (fun _ _ => Nat.zero_le _)
            (Finset.mem_univ i)
        simp only [Finsupp.single_eq_same]
        omega
      · rw [Finsupp.single_apply, if_neg (Ne.symm hij)]
        have := Finset.add_le_sum (f := fun i => m i) (fun _ _ => Nat.zero_le _)
          (Finset.mem_univ i) (Finset.mem_univ j) hij
        omega
    have hsplit : ∀ F : MvPolynomial (Fin r) k, F - MvPolynomial.C (F.coeff 0) -
        ∑ i, MvPolynomial.C (F.coeff (Finsupp.single i 1)) * MvPolynomial.X i ∈ I ^ 2 := by
      intro F
      rw [MvPolynomial.mem_pow_idealOfVars_iff]
      intro m hm
      rw [MvPolynomial.mem_support_iff] at hm
      by_contra hlt
      apply hm
      rcases (by omega : m.degree = 0 ∨ m.degree = 1) with h0 | h1
      · rw [Finsupp.degree_eq_zero_iff] at h0
        subst h0
        simp [MvPolynomial.coeff_X']
      · obtain ⟨j, rfl⟩ := hdeg1 m h1
        simp only [MvPolynomial.coeff_sub, MvPolynomial.coeff_sum, MvPolynomial.coeff_C_mul,
          MvPolynomial.coeff_X', MvPolynomial.coeff_C]
        have e1 : ¬ ((0 : Fin r →₀ ℕ) = Finsupp.single j 1) := fun h =>
          (Finsupp.single_ne_zero.mpr (one_ne_zero (α := ℕ))) h.symm
        have e2 : ∀ i, (Finsupp.single i 1 = Finsupp.single j 1) ↔ i = j := fun i =>
          Finsupp.single_left_inj one_ne_zero
        simp only [e1, e2, if_false, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq',
          Finset.mem_univ, if_true]
        ring
    have hker2 : ∀ F : MvPolynomial (Fin r) k, MvPolynomial.aeval x F ∈ 𝔪 ^ 2 → F ∈ I ^ 2 := by
      intro F hF
      have hF1 : MvPolynomial.aeval x F ∈ 𝔪 := Ideal.pow_le_self two_ne_zero hF
      have h0 : F.coeff 0 = 0 := hI1' F (hvar F hF1)
      have hF2 := hsplit F
      have hsum : ∑ i, F.coeff (Finsupp.single i 1) • x i ∈ 𝔪 ^ 2 := by
        have e : ∑ i, F.coeff (Finsupp.single i 1) • x i = MvPolynomial.aeval x F -
            MvPolynomial.aeval x (F - MvPolynomial.C (F.coeff 0) -
              ∑ i, MvPolynomial.C (F.coeff (Finsupp.single i 1)) * MvPolynomial.X i) := by
          simp only [h0, map_sub, map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X,
            Algebra.smul_def, map_zero]
          ring
        rw [e]
        exact Ideal.sub_mem _ hF (hpow 2 _ hF2)
      have hc := hindep _ hsum
      have e : F = F - MvPolynomial.C (F.coeff 0) -
          ∑ i, MvPolynomial.C (F.coeff (Finsupp.single i 1)) * MvPolynomial.X i := by
        simp only [h0, hc, map_zero, zero_mul, Finset.sum_const_zero, sub_zero]
      rw [e]
      exact hF2
    let ψ : MvPolynomial (Fin r) k →ₐ[k] R ⧸ 𝔪 ^ 2 :=
      (Ideal.Quotient.mkₐ k (𝔪 ^ 2)).comp (MvPolynomial.aeval x)
    have hψ : ∀ F, ψ F = Ideal.Quotient.mk (𝔪 ^ 2) (MvPolynomial.aeval x F) := fun F => rfl
    have hsurj : Function.Surjective ψ := by
      intro z
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨c₀, hc₀⟩ := hRES y
      obtain ⟨c, hc⟩ := hspan _ hc₀
      refine ⟨MvPolynomial.C c₀ + ∑ i, MvPolynomial.C (c i) * MvPolynomial.X i, ?_⟩
      rw [hψ, Ideal.Quotient.eq]
      have e : MvPolynomial.aeval x (MvPolynomial.C c₀ + ∑ i, MvPolynomial.C (c i) *
          MvPolynomial.X i) - y = -(y - algebraMap k R c₀ - ∑ i, c i • x i) := by
        simp only [map_add, map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X,
          Algebra.smul_def]
        ring
      rw [e]
      exact (Ideal.neg_mem_iff _).mpr hc
    have hker : RingHom.ker ψ = I ^ 2 := by
      ext F
      rw [RingHom.mem_ker, hψ, Ideal.Quotient.eq_zero_iff_mem]
      exact ⟨hker2 F, hpow 2 F⟩
    let Φ : (MvPolynomial (Fin r) k ⧸ I ^ 2) ≃ₐ[k] R ⧸ 𝔪 ^ 2 :=
      (Ideal.quotientEquivAlgOfEq k hker.symm).trans (Ideal.quotientKerAlgEquivOfSurjective hsurj)
    have hΦ : ∀ F, Φ (Ideal.Quotient.mk (I ^ 2) F) =
        Ideal.Quotient.mk (𝔪 ^ 2) (MvPolynomial.aeval x F) := fun F => rfl
    refine ⟨Φ.symm.toAlgHom.comp (Ideal.Quotient.mkₐ k (𝔪 ^ 2)), ?_, ?_⟩
    · intro i
      show Φ.symm (Ideal.Quotient.mk (𝔪 ^ 2) (x i)) = _
      rw [AlgEquiv.symm_apply_eq, hΦ, MvPolynomial.aeval_X]
    · intro y hy
      show Φ.symm (Ideal.Quotient.mk (𝔪 ^ 2) y) ∈ _
      obtain ⟨F, hF⟩ := Ideal.Quotient.mk_surjective (Φ.symm (Ideal.Quotient.mk (𝔪 ^ 2) y))
      rw [← hF]
      have h1 := congrArg Φ hF
      rw [hΦ, AlgEquiv.apply_symm_apply, Ideal.Quotient.eq] at h1
      have h2 : MvPolynomial.aeval x F ∈ 𝔪 := by
        have := Ideal.add_mem _ (Ideal.pow_le_self two_ne_zero h1) hy
        simpa using this
      exact Ideal.mem_map_of_mem _ (hvar F h2)

  set m := IsLocalRing.maximalIdeal R with hm
  have htm : ∀ i, t i ∈ m := fun i => by rw [ht]; exact Ideal.subset_span ⟨i, rfl⟩
  have ht'm : ∀ i, t' i ∈ m := fun i => by rw [ht']; exact Ideal.subset_span ⟨i, rfl⟩
  have hmm2 : ∀ a b, a ∈ m → b ∈ m → a * b ∈ m ^ 2 := fun a b ha hb => by
    rw [pow_two]; exact Ideal.mul_mem_mul ha hb
  have E1 : ∀ v : Fin n → R, m = Ideal.span (Set.range v) → ∀ y ∈ m,
      ∃ s : Fin n → k, y - ∑ j, algebraMap k R (s j) * v j ∈ m ^ 2 := by
    intro v hv y hy
    have hvm : ∀ j, v j ∈ m := fun j => by rw [hv]; exact Ideal.subset_span ⟨j, rfl⟩
    rw [hv] at hy
    obtain ⟨r, hr⟩ := Ideal.mem_span_range_iff_exists_fun.mp hy
    choose s hs using fun j => hres (r j)
    refine ⟨s, ?_⟩
    rw [← hr, ← Finset.sum_sub_distrib]
    exact Ideal.sum_mem _ fun j _ => by rw [← sub_mul]; exact hmm2 _ _ (hs j) (hvm j)

  have hspan : ∀ y ∈ m, ∃ c : Fin n → k, y - ∑ i, c i • t i ∈ m ^ 2 := by
    intro y hy
    obtain ⟨s, hs⟩ := E1 t ht y hy
    exact ⟨s, by simpa only [Algebra.smul_def] using hs⟩
  have hindep : ∀ c : Fin n → k, ∑ i, c i • t i ∈ m ^ 2 → ∀ i, c i = 0 := by
    intro c hc i
    exact congrFun (hind c (by simpa only [Algebra.smul_def] using hc)) i
  set I := MvPolynomial.idealOfVars (Fin n) k with hI
  obtain ⟨γ, hγ1, hγ2⟩ : ∃ γ : R →ₐ[k] MvPolynomial (Fin n) k ⧸ I ^ 2,
      (∀ i, γ (t i) = Ideal.Quotient.mk (I ^ 2) (MvPolynomial.X i)) ∧
      ∀ y ∈ m, γ y ∈ Ideal.map (Ideal.Quotient.mk (I ^ 2)) I :=
    jet_two n t hres htm hspan hindep
  have hle : I ^ 3 ≤ I ^ 2 := Ideal.pow_le_pow_right (by norm_num)
  have hsurjf : Function.Surjective (Ideal.Quotient.factorₐ k hle) := by
    intro v
    obtain ⟨u, hu⟩ := Ideal.Quotient.factor_surjective hle v
    exact ⟨u, by rw [Ideal.Quotient.factorₐ_apply]; exact hu⟩
  have hnil : IsNilpotent (RingHom.ker (Ideal.Quotient.factorₐ k hle)) := by
    have hker : RingHom.ker (Ideal.Quotient.factorₐ k hle) =
        Ideal.map (Ideal.Quotient.mk (I ^ 3)) (I ^ 2) := by
      rw [← Ideal.Quotient.factor_ker hle]
      ext u
      simp only [RingHom.mem_ker, Ideal.Quotient.factorₐ_apply]
    rw [hker]
    refine ⟨2, ?_⟩
    rw [← Ideal.map_pow, ← pow_mul, Ideal.zero_eq_bot, eq_bot_iff]
    calc Ideal.map (Ideal.Quotient.mk (I ^ 3)) (I ^ (2 * 2))
        ≤ Ideal.map (Ideal.Quotient.mk (I ^ 3)) (I ^ 3) :=
          Ideal.map_mono (Ideal.pow_le_pow_right (by norm_num))
      _ = ⊥ := Ideal.map_quotient_self _
  obtain ⟨β, hβ⟩ : ∃ β : R →ₐ[k] MvPolynomial (Fin n) k ⧸ I ^ 3,
      ∀ y, Ideal.Quotient.factor hle (β y) = γ y := by
    refine ⟨Algebra.FormallySmooth.liftOfSurjective γ (Ideal.Quotient.factorₐ k hle) hsurjf hnil,
      fun y => ?_⟩
    have := Algebra.FormallySmooth.liftOfSurjective_apply γ (Ideal.Quotient.factorₐ k hle) hsurjf
      hnil y
    rw [Ideal.Quotient.factorₐ_apply] at this
    exact this
  have L2 : ∀ J : Ideal (MvPolynomial (Fin n) k), I ^ 2 ≤ J →
      ∀ u : MvPolynomial (Fin n) k ⧸ I ^ 3,
        Ideal.Quotient.factor hle u ∈ Ideal.map (Ideal.Quotient.mk (I ^ 2)) J →
        u ∈ Ideal.map (Ideal.Quotient.mk (I ^ 3)) J := by
    intro J hJ u hu
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective u
    rw [Ideal.Quotient.factor_mk] at hu
    obtain ⟨q, hq, hqp⟩ := (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp hu
    have hd : q - p ∈ I ^ 2 := Ideal.Quotient.eq.mp hqp
    have hp : p ∈ J := by
      have := J.sub_mem hq (hJ hd)
      simpa using this
    exact Ideal.mem_map_of_mem _ hp
  have hβm : ∀ y ∈ m, β y ∈ Ideal.map (Ideal.Quotient.mk (I ^ 3)) I := fun y hy =>
    L2 I (Ideal.pow_le_self (by norm_num)) _ (by rw [hβ]; exact hγ2 y hy)
  have hJ3 : (Ideal.map (Ideal.Quotient.mk (I ^ 3)) I) ^ 3 = ⊥ := by
    rw [← Ideal.map_pow, Ideal.map_quotient_self]
  have hε : ∀ i, β (t i) - Ideal.Quotient.mk (I ^ 3) (MvPolynomial.X i) ∈
      (Ideal.map (Ideal.Quotient.mk (I ^ 3)) I) ^ 2 := by
    intro i
    rw [← Ideal.map_pow]
    apply L2 (I ^ 2) le_rfl
    rw [map_sub, hβ, Ideal.Quotient.factor_mk, hγ1 i, sub_self]
    exact Ideal.zero_mem _
  have hXI : ∀ i, Ideal.Quotient.mk (I ^ 3) (MvPolynomial.X i) ∈
      Ideal.map (Ideal.Quotient.mk (I ^ 3)) I := by
    intro i
    apply Ideal.mem_map_of_mem
    rw [hI, MvPolynomial.idealOfVars.eq_1]
    exact Ideal.subset_span ⟨i, rfl⟩
  have hprod : ∀ i j, β (t i) * β (t j) =
      Ideal.Quotient.mk (I ^ 3) (MvPolynomial.X i) * Ideal.Quotient.mk (I ^ 3) (MvPolynomial.X j) := by
    intro i j
    have e : β (t i) * β (t j) - Ideal.Quotient.mk (I ^ 3) (MvPolynomial.X i) *
        Ideal.Quotient.mk (I ^ 3) (MvPolynomial.X j) =
        (β (t i) - Ideal.Quotient.mk (I ^ 3) (MvPolynomial.X i)) * β (t j) +
        Ideal.Quotient.mk (I ^ 3) (MvPolynomial.X i) *
          (β (t j) - Ideal.Quotient.mk (I ^ 3) (MvPolynomial.X j)) := by ring
    have h : (β (t i) - Ideal.Quotient.mk (I ^ 3) (MvPolynomial.X i)) * β (t j) +
        Ideal.Quotient.mk (I ^ 3) (MvPolynomial.X i) *
          (β (t j) - Ideal.Quotient.mk (I ^ 3) (MvPolynomial.X j)) ∈
        (Ideal.map (Ideal.Quotient.mk (I ^ 3)) I) ^ 3 := by
      refine Ideal.add_mem _ ?_ ?_
      · have h' := Ideal.mul_mem_mul (hε i) (hβm _ (htm j))
        rwa [← pow_succ] at h'
      · have h' := Ideal.mul_mem_mul (hXI i) (hε j)
        rwa [← pow_succ'] at h'
    rw [hJ3, Ideal.mem_bot, ← e] at h
    exact sub_eq_zero.mp h
  have hXX : ∀ a b i j : Fin n, (MvPolynomial.X a * MvPolynomial.X b :
      MvPolynomial (Fin n) k).coeff (Finsupp.single i 1 + Finsupp.single j 1) =
      if (a = i ∧ b = j) ∨ (a = j ∧ b = i) then 1 else 0 := by
    intro a b i j
    rw [show (MvPolynomial.X a * MvPolynomial.X b : MvPolynomial (Fin n) k) =
        MvPolynomial.monomial (Finsupp.single a 1 + Finsupp.single b 1) 1 by
      simp [MvPolynomial.X], MvPolynomial.coeff_monomial]
    simp only [Finsupp.single_add_single_eq_single_add_single one_ne_zero one_ne_zero]
    simp
  have hs1 : ∀ D : Matrix (Fin n) (Fin n) k,
      ∑ i, ∑ j, algebraMap k R (D i j) * t i * t j ∈ m ^ 3 → ∀ i j, D i j + D j i = 0 := by
    intro D hD
    have hz0 : β (∑ i, ∑ j, algebraMap k R (D i j) * t i * t j) = 0 := by
      have h1 := Ideal.mem_map_of_mem β hD
      rw [Ideal.map_pow] at h1
      have h2 := Ideal.pow_right_mono (Ideal.map_le_iff_le_comap.mpr
        (fun y hy => Ideal.mem_comap.mpr (hβm y hy))) 3 h1
      rw [hJ3] at h2
      exact Ideal.mem_bot.mp h2
    obtain ⟨p, hp⟩ : ∃ p : MvPolynomial (Fin n) k, p = ∑ a, ∑ b,
        algebraMap k (MvPolynomial (Fin n) k) (D a b) * MvPolynomial.X a * MvPolynomial.X b :=
      ⟨_, rfl⟩
    have hpz : Ideal.Quotient.mk (I ^ 3) p = 0 := by
      have e : Ideal.Quotient.mk (I ^ 3) p =
          β (∑ i, ∑ j, algebraMap k R (D i j) * t i * t j) := by
        rw [hp]
        simp only [map_sum, map_mul, AlgHom.commutes, Ideal.Quotient.mk_algebraMap, mul_assoc,
          hprod]
      rw [e, hz0]
    have hp3 : p ∈ I ^ 3 := Ideal.Quotient.eq_zero_iff_mem.mp hpz
    have hcoef : ∀ i j, p.coeff (Finsupp.single i 1 + Finsupp.single j 1) = 0 := by
      intro i j
      by_contra hne
      have := (MvPolynomial.mem_pow_idealOfVars_iff 3 p).mp hp3 _
        (MvPolynomial.mem_support_iff.mpr hne)
      rw [map_add, Finsupp.degree_single, Finsupp.degree_single] at this
      omega
    have hcoefp : ∀ i j, p.coeff (Finsupp.single i 1 + Finsupp.single j 1) =
        ∑ a, ∑ b, D a b * (if (a = i ∧ b = j) ∨ (a = j ∧ b = i) then 1 else 0) := by
      intro i j
      rw [hp]
      simp only [MvPolynomial.coeff_sum, mul_assoc, MvPolynomial.algebraMap_eq,
        MvPolynomial.coeff_C_mul, hXX]
    have hsum1 : ∀ i j, (∑ a, ∑ b, if a = i ∧ b = j then D a b else 0) = D i j := by
      intro i j
      simp [ite_and]
    intro i j
    have h0 := hcoef i j
    rw [hcoefp] at h0
    by_cases hij : i = j
    · subst hij
      simp only [or_self, mul_ite, mul_one, mul_zero, hsum1] at h0
      rw [h0, add_zero]
    · have hterm : ∀ a b, D a b * (if (a = i ∧ b = j) ∨ (a = j ∧ b = i) then (1 : k) else 0) =
          (if a = i ∧ b = j then D a b else 0) + (if a = j ∧ b = i then D a b else 0) := by
        intro a b
        by_cases h1 : a = i ∧ b = j
        · have h2 : ¬ (a = j ∧ b = i) := fun h => hij (h1.1.symm.trans h.1)
          rw [if_pos (Or.inl h1), if_pos h1, if_neg h2]; ring
        · by_cases h2 : a = j ∧ b = i
          · rw [if_pos (Or.inr h2), if_neg h1, if_pos h2]; ring
          · rw [if_neg (not_or.mpr ⟨h1, h2⟩), if_neg h1, if_neg h2]; ring
      simp only [hterm, Finset.sum_add_distrib, hsum1] at h0
      exact h0

  obtain ⟨φ, hφ⟩ : ∃ φ : Matrix (Fin n) (Fin n) k →+* Matrix (Fin n) (Fin n) R,
      ∀ M i j, φ M i j = algebraMap k R (M i j) := ⟨(algebraMap k R).mapMatrix, fun _ _ _ => rfl⟩
  have hφT : ∀ M, φ M.transpose = (φ M).transpose := by
    intro M; ext i j; simp only [hφ, Matrix.transpose_apply]
  have hmv : ∀ (M : Matrix (Fin n) (Fin n) k) (v : Fin n → R) i,
      Matrix.mulVec (φ M) v i = ∑ j, algebraMap k R (M i j) * v j := by
    intro M v i
    show ∑ j, φ M i j * v j = _
    simp only [hφ]
  have mvI : ∀ (M : Matrix (Fin n) (Fin n) R) (v : Fin n → R) (J : Ideal R),
      (∀ i, v i ∈ J) → ∀ i, Matrix.mulVec M v i ∈ J := by
    intro M v J hv i
    show ∑ j, M i j * v j ∈ J
    exact Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (hv j)
  obtain ⟨P, hP⟩ : ∃ P : Matrix (Fin n) (Fin n) k, ∀ i, t' i - Matrix.mulVec (φ P) t i ∈ m ^ 2 := by
    choose P hP using fun i => E1 t ht (t' i) (ht'm i)
    exact ⟨Matrix.of P, fun i => by rw [hmv]; exact hP i⟩
  obtain ⟨Q, hQ⟩ : ∃ Q : Matrix (Fin n) (Fin n) k, ∀ i, t i - Matrix.mulVec (φ Q) t' i ∈ m ^ 2 := by
    choose Q hQ using fun i => E1 t' ht' (t i) (htm i)
    exact ⟨Matrix.of Q, fun i => by rw [hmv]; exact hQ i⟩
  have hQP : Q * P = 1 := by
    have key : ∀ i, Matrix.mulVec (φ (1 - Q * P)) t i = (t i - Matrix.mulVec (φ Q) t' i) +
        Matrix.mulVec (φ Q) (t' - Matrix.mulVec (φ P) t) i := by
      intro i
      rw [map_sub, map_one, map_mul, Matrix.sub_mulVec, Matrix.one_mulVec, ← Matrix.mulVec_mulVec,
        Matrix.mulVec_sub]
      simp only [Pi.sub_apply]
      abel
    ext i l
    have h2 : Matrix.mulVec (φ (1 - Q * P)) t i ∈ m ^ 2 := by
      rw [key]
      exact Ideal.add_mem _ (hQ i) (mvI _ _ _ hP i)
    rw [hmv] at h2
    have h3 := congrFun (hind (fun l => (1 - Q * P) i l) h2) l
    simp only [Matrix.sub_apply, Pi.zero_apply, sub_eq_zero] at h3
    exact h3.symm
  have hPdet : P.det ≠ 0 := Matrix.det_ne_zero_of_left_inverse hQP

  obtain ⟨Ab, hAb⟩ : ∃ Ab : Matrix (Fin n) (Fin n) k, ∀ i j, A i j - algebraMap k R (Ab i j) ∈ m := by
    choose Ab hAb using fun i j => hres (A i j)
    exact ⟨Ab, hAb⟩
  obtain ⟨u, hu⟩ : ∃ u : Fin n → R, u = Matrix.mulVec (φ P) t := ⟨_, rfl⟩
  have hum : ∀ i, u i ∈ m := by rw [hu]; exact mvI _ _ _ htm
  have hε' : ∀ i, (t' - u) i ∈ m ^ 2 := by rw [hu]; exact hP
  have hδ : ∀ i j, (A - φ Ab) i j ∈ m := fun i j => by rw [Matrix.sub_apply, hφ]; exact hAb i j
  have dotI : ∀ (a b : Fin n → R) (J J' : Ideal R), (∀ i, a i ∈ J) → (∀ i, b i ∈ J') →
      dotProduct a b ∈ J * J' := fun a b J J' ha hb => by
    show ∑ i, a i * b i ∈ J * J'
    exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_mul (ha i) (hb i)
  have e3a : m * (m * m) = m ^ 3 := by ring
  have e3b : m ^ 2 * m = m ^ 3 := by ring
  have e3c : m * m ^ 2 = m ^ 3 := by ring
  have hs3 : dotProduct t' (Matrix.mulVec A t') -
      dotProduct t (Matrix.mulVec (φ (P.transpose * Ab * P)) t) ∈ m ^ 3 := by
    have hquad : dotProduct u (Matrix.mulVec (φ Ab) u) =
        dotProduct t (Matrix.mulVec (φ (P.transpose * Ab * P)) t) := by
      rw [map_mul, map_mul, hφT, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
      conv_rhs => rw [Matrix.dotProduct_mulVec, Matrix.vecMul_transpose]
      rw [hu]
    have hid : dotProduct t' (Matrix.mulVec A t') - dotProduct u (Matrix.mulVec (φ Ab) u) =
        dotProduct t' (Matrix.mulVec (A - φ Ab) t') +
          (dotProduct (t' - u) (Matrix.mulVec (φ Ab) t') +
            dotProduct u (Matrix.mulVec (φ Ab) (t' - u))) := by
      simp only [Matrix.sub_mulVec, Matrix.mulVec_sub, dotProduct_sub, sub_dotProduct]
      abel
    rw [← hquad, hid]
    refine Ideal.add_mem _ ?_ (Ideal.add_mem _ ?_ ?_)
    · rw [← e3a]
      refine dotI _ _ _ _ ht'm (fun i => ?_)
      show ∑ j, (A - φ Ab) i j * t' j ∈ m * m
      exact Ideal.sum_mem _ fun j _ => Ideal.mul_mem_mul (hδ i j) (ht'm j)
    · rw [← e3b]
      exact dotI _ _ _ _ hε' (mvI _ _ _ ht'm)
    · rw [← e3c]
      exact dotI _ _ _ _ hum (mvI _ _ _ hε')

  have Qf : ∀ (M : Matrix (Fin n) (Fin n) R) (v : Fin n → R),
      ∑ i, ∑ j, M i j * v i * v j = dotProduct v (Matrix.mulVec M v) := by
    intro M v
    show _ = ∑ i, v i * ∑ j, M i j * v j
    simp only [Finset.mul_sum]
    exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring
  have Qf' : ∀ (M : Matrix (Fin n) (Fin n) k) (v : Fin n → R),
      ∑ i, ∑ j, algebraMap k R (M i j) * v i * v j = dotProduct v (Matrix.mulVec (φ M) v) := by
    intro M v
    rw [← Qf]
    simp only [hφ]
  rw [Qf' c t, Qf A t'] at hA
  have hD3 := Ideal.add_mem _ hA hs3
  rw [sub_add_sub_cancel, ← dotProduct_sub, ← Matrix.sub_mulVec, ← map_sub φ, ← Qf'] at hD3
  have hDsym := hs1 _ hD3

  have hsym : c + c.transpose = P.transpose * (Ab + Ab.transpose) * P := by
    have e1 : (P.transpose * Ab * P).transpose = P.transpose * Ab.transpose * P := by
      rw [Matrix.transpose_mul, Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.mul_assoc]
    rw [mul_add, add_mul, ← e1]
    ext i j
    have := hDsym i j
    simp only [Matrix.add_apply, Matrix.transpose_apply, Matrix.sub_apply] at this ⊢
    linear_combination this
  have hdet : (Ab + Ab.transpose).det = 0 := by
    rw [hsym, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose] at hc
    rcases mul_eq_zero.mp hc with h | h
    · rcases mul_eq_zero.mp h with h' | h'
      · exact absurd h' hPdet
      · exact h'
    · exact absurd h hPdet

  have hρ : ∀ i j, IsLocalRing.residue R (A i j) =
      IsLocalRing.residue R (algebraMap k R (Ab i j)) := by
    intro i j
    have := (IsLocalRing.residue_eq_zero_iff _).mpr (hAb i j)
    rwa [map_sub, sub_eq_zero] at this
  intro hunit
  have h1 : IsLocalRing.residue R (A + A.transpose).det = 0 := by
    rw [RingHom.map_det]
    have e : (IsLocalRing.residue R).mapMatrix (A + A.transpose) =
        ((IsLocalRing.residue R).comp (algebraMap k R)).mapMatrix (Ab + Ab.transpose) := by
      ext i j
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.add_apply,
        Matrix.transpose_apply, map_add, RingHom.comp_apply, hρ]
    rw [e, ← RingHom.map_det, hdet, map_zero]
  have h2 := (IsLocalRing.residue_eq_zero_iff _).mp h1
  exact (IsLocalRing.mem_maximalIdeal _).mp h2 hunit

theorem wc_ldp_il_proj_const (K : Type u) [Field K] (m : ℕ) (a : Fin (m + 1)) (p : wcProjK K m)
    (hp : p ∈ wcSgD K m a) (c : K) :
    ((wcProjK K m).presheaf.germ (wcSgD K m a) p hp).hom
      ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a)).hom
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
          (Submonoid.powers (MvPolynomial.X a))
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0) c))) =
      wcLdpConst K (wcProjKStr K m) p c :=
by
  have f_deg : (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a)

  have h1 : (wcSgD K m a).ι =
      Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a) ≫
        Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a)
          f_deg one_pos := by
    rw [← Proj.basicOpenIsoSpec_hom _ _ f_deg one_pos,
      ← Proj.basicOpenIsoSpec_inv_ι _ _ f_deg one_pos, Iso.hom_inv_id_assoc]

  have h2 : (wcSgD K m a).ι ≫ wcProjKStr K m =
      Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a) ≫
        Spec.map (CommRingCat.ofHom
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)) ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
            (Submonoid.powers (MvPolynomial.X a)))) := by
    rw [h1, Spec.map_comp, ← Proj.awayι_toSpecZero _ _ f_deg one_pos]
    simp only [wcProjKStr, Category.assoc]

  have h4 : (Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
        (MvPolynomial.X a)).appTop =
      (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a)))).hom ≫
        Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a) ≫
        (wcSgD K m a).topIso.inv :=
    Proj.basicOpenToSpec_app_top _ _

  have H : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ (wcProjKStr K m).appTop ≫
        (wcSgD K m a).ι.appTop =
      CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)) ≫
        CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
          (Submonoid.powers (MvPolynomial.X a))) ≫
        Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a) ≫
        (wcSgD K m a).topIso.inv := by
    rw [← Scheme.Hom.comp_appTop, h2, Scheme.Hom.comp_appTop, ← Category.assoc,
      ← Scheme.ΓSpecIso_inv_naturality, h4]
    simp only [Category.assoc, Iso.inv_hom_id_assoc]

  have h3 : (wcSgD K m a).ι.appTop ≫ (wcSgD K m a).topIso.hom =
      (wcProjK K m).presheaf.map (homOfLE (le_top : wcSgD K m a ≤ ⊤)).op := by
    rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
    first
      | (erw [← Functor.map_comp]; rfl)
      | (simp only [← Functor.map_comp]; rfl)
      | exact ((wcProjK K m).presheaf.map_comp _ _).symm
  have H' : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ (wcProjKStr K m).appTop ≫
        (wcProjK K m).presheaf.map (homOfLE (le_top : wcSgD K m a ≤ ⊤)).op =
      CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)) ≫
        CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
          (Submonoid.powers (MvPolynomial.X a))) ≫
        Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
          (MvPolynomial.X a) := by
    rw [← h3, reassoc_of% H, Iso.inv_hom_id, Category.comp_id]
  have e := congrArg (fun φ => φ.hom c) H'
  simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e

  have hg := congrArg (fun φ => φ.hom ((wcProjKStr K m).appTop.hom
      ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom c)))
    (TopCat.Presheaf.germ_res (wcProjK K m).presheaf (homOfLE (le_top : wcSgD K m a ≤ ⊤)) p hp)
  simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hg
  rw [← e]
  exact hg

theorem wc_ldp_il_proj_stalk_frac (K : Type u) [Field K] (m : ℕ) (a : Fin (m + 1))
    (p : wcProjK K m) (hp : p ∈ wcSgD K m a) :
    ∀ y : (wcProjK K m).presheaf.stalk p,
      ∃ r σ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
          (MvPolynomial.X a),
        IsUnit (((wcProjK K m).presheaf.germ (wcSgD K m a) p hp).hom
          ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
            (MvPolynomial.X a)).hom σ)) ∧
        y * ((wcProjK K m).presheaf.germ (wcSgD K m a) p hp).hom
            ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
              (MvPolynomial.X a)).hom σ) =
          ((wcProjK K m).presheaf.germ (wcSgD K m a) p hp).hom
            ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
              (MvPolynomial.X a)).hom r) :=
by
  intro y
  have f_deg : (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a)
  have hD : IsAffineOpen (wcSgD K m a) :=
    Proj.isAffineOpen_basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
      (MvPolynomial.X a) f_deg one_pos
  obtain ⟨x, hx⟩ : ∃ x : (wcSgD K m a), x.1 = p := ⟨⟨p, hp⟩, rfl⟩
  subst hx
  letI := TopCat.Presheaf.algebra_section_stalk (wcProjK K m).presheaf x
  have hloc := hD.isLocalization_stalk x
  obtain ⟨⟨r', s'⟩, hrs⟩ := IsLocalization.surj (hD.primeIdealOf x).asIdeal.primeCompl y
  have hu := IsLocalization.map_units ((wcProjK K m).presheaf.stalk x.1) s'
  rw [TopCat.Presheaf.stalk_open_algebraMap] at hrs hu
  let ι := Proj.basicOpenIsoAway (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
    (MvPolynomial.X a) f_deg one_pos
  have key : ∀ z : Γ(wcProjK K m, wcSgD K m a),
      (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
      (MvPolynomial.X a)).hom (ι.inv.hom z) = z := by
    intro z
    rw [← Proj.basicOpenIsoAway_hom (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
      (MvPolynomial.X a) f_deg one_pos]
    exact Iso.inv_hom_id_apply ι z
  refine ⟨ι.inv.hom r', ι.inv.hom s'.1, ?_, ?_⟩
  · rw [key s'.1]; exact hu
  · rw [key s'.1, key r']; exact hrs

theorem wc_ldp_lnf_quad_surj (K : Type u) [Field K] (N : ℕ)
    (H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2) :
    ∃ w : Fin (N + 1) → Fin (N + 1) → K, wcLdpQuad K N w = H :=
by
  classical
  obtain ⟨h, hH⟩ := H
  have hHom : h.IsHomogeneous 2 := (MvPolynomial.mem_homogeneousSubmodule 2 h).mp hH
  have hdeg : ∀ d ∈ h.support, Finsupp.degree d = 2 := by
    intro d hd
    by_contra hne
    exact (MvPolynomial.mem_support_iff.mp hd) (hHom.coeff_eq_zero hne)
  have KF : ∀ d : Fin (N + 1) →₀ ℕ, ∃ x y : Fin (N + 1),
      Finsupp.degree d = 2 → d = Finsupp.single x 1 + Finsupp.single y 1 := by
    intro d
    by_cases hd : Finsupp.degree d = 2
    · have hc : Multiset.card (Finsupp.toMultiset d) = 2 := by
        rw [Finsupp.card_toMultiset, ← hd, Finsupp.degree_apply]
        rfl
      obtain ⟨x, y, hxy⟩ := Multiset.card_eq_two.mp hc
      refine ⟨x, y, fun _ => ?_⟩
      have e : d = Multiset.toFinsupp (Finsupp.toMultiset d) :=
        (Finsupp.toMultiset_toFinsupp d).symm
      rw [hxy, Multiset.insert_eq_cons, ← Multiset.singleton_add, Multiset.toFinsupp_add,
        Multiset.toFinsupp_singleton, Multiset.toFinsupp_singleton] at e
      exact e
    · exact ⟨0, 0, fun h' => absurd h' hd⟩
  choose P Q hPQ using KF
  refine ⟨fun p q => ∑ d ∈ h.support,
    if p = P d ∧ q = Q d then h.coeff d else 0, ?_⟩
  apply Subtype.ext
  show (∑ p : Fin (N + 1), ∑ q : Fin (N + 1),
      MvPolynomial.C (∑ d ∈ h.support, if p = P d ∧ q = Q d then h.coeff d else 0) *
        (MvPolynomial.X p * MvPolynomial.X q) : MvPolynomial (Fin (N + 1)) K) = h
  have e1 : ∀ p q : Fin (N + 1),
      MvPolynomial.C (∑ d ∈ h.support, if p = P d ∧ q = Q d then h.coeff d else 0) *
        (MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin (N + 1)) K) =
      ∑ d ∈ h.support, if p = P d ∧ q = Q d then
        MvPolynomial.C (h.coeff d) * (MvPolynomial.X p * MvPolynomial.X q) else 0 := by
    intro p q
    rw [map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun d _ => ?_
    split_ifs <;> simp
  have e2 : ∀ d : Fin (N + 1) →₀ ℕ,
      (∑ p : Fin (N + 1), ∑ q : Fin (N + 1), if p = P d ∧ q = Q d then
        MvPolynomial.C (h.coeff d) * (MvPolynomial.X p * MvPolynomial.X q) else 0 :
          MvPolynomial (Fin (N + 1)) K) =
        MvPolynomial.C (h.coeff d) * (MvPolynomial.X (P d) * MvPolynomial.X (Q d)) := by
    intro d
    rw [Finset.sum_eq_single (P d), Finset.sum_eq_single (Q d)]
    · simp
    · intro q _ hq
      simp [hq]
    · intro hq; exact absurd (Finset.mem_univ _) hq
    · intro p _ hp
      simp [hp]
    · intro hp; exact absurd (Finset.mem_univ _) hp
  have e3 : ∀ d : Fin (N + 1) →₀ ℕ, ∀ c : K,
      MvPolynomial.C c * (MvPolynomial.X (P d) * MvPolynomial.X (Q d)) =
        (MvPolynomial.monomial (Finsupp.single (P d) 1 + Finsupp.single (Q d) 1) c :
          MvPolynomial (Fin (N + 1)) K) := by
    intro d c
    rw [MvPolynomial.X, MvPolynomial.X, MvPolynomial.monomial_mul_monomial,
      MvPolynomial.C_mul_monomial, mul_one, mul_one]
  simp_rw [e1]
  rw [Finset.sum_congr rfl (fun p _ => Finset.sum_comm), Finset.sum_comm]
  rw [Finset.sum_congr rfl (fun d _ => e2 d)]
  conv_rhs => rw [MvPolynomial.as_sum h]
  refine Finset.sum_congr rfl fun d hd => ?_
  rw [e3, ← hPQ d (hdeg d hd)]

theorem wc_ldp_lnf_sec_quad (K : Type u) [Field K] (N : ℕ) (a : Fin (N + 1))
    (w : Fin (N + 1) → Fin (N + 1) → K) :
    wcSgE K N a a = 1 ∧
    wcLdpSec K N (wcLdpQuad K N w) a =
      ∑ p, ∑ q, (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)).hom
          (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) (w p q))) *
        wcSgE K N a p * wcSgE K N a q :=
by
  have hc : ∀ c : K, (HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      (Submonoid.powers (MvPolynomial.X a))
      (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)).val =
      Localization.mk (MvPolynomial.C c) 1 := by
    intro c
    rfl
  refine ⟨?_, ?_⟩
  · unfold wcSgE
    rw [← map_one (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      (MvPolynomial.X a)).hom]
    congr 1
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one, ← Localization.mk_one,
      Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    exact ⟨1, by simp⟩
  · unfold wcLdpSec wcSgE
    simp only [← map_mul, ← map_sum]
    congr 1
    apply HomogeneousLocalization.val_injective
    rw [← HomogeneousLocalization.algebraMap_apply, ← HomogeneousLocalization.algebraMap_apply]
    simp only [map_sum, map_mul, HomogeneousLocalization.algebraMap_apply, hc,
      HomogeneousLocalization.Away.val_mk]
    unfold wcLdpQuad
    simp only [Localization.mk_sum]
    refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => ?_))
    rw [Localization.mk_mul, Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [Submonoid.coe_mul, Submonoid.coe_one, OneMemClass.coe_one]
    ring

theorem wc_ldp_lnf_chart_germ (K : Type u) [Field K] (N : ℕ) (X : Over (Spec (.of K)))
    (ι : X.left ⟶ wcProjK K N) (hιX : ι ≫ wcProjKStr K N = X.hom)
    (hconst : ∀ (a : Fin (N + 1)) (p : wcProjK K N) (hp : p ∈ wcSgD K N a) (c : K),
      ((wcProjK K N).presheaf.germ (wcSgD K N a) p hp).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)).hom
          (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c))) =
        wcLdpConst K (wcProjKStr K N) p c)
    (hsec : ∀ (a : Fin (N + 1)) (w : Fin (N + 1) → Fin (N + 1) → K), wcSgE K N a a = 1 ∧
      wcLdpSec K N (wcLdpQuad K N w) a =
        ∑ p, ∑ q, (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)).hom
            (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
              (Submonoid.powers (MvPolynomial.X a))
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) (w p q))) *
          wcSgE K N a p * wcSgE K N a q)
    (a : Fin (N + 1)) (y : X.left) (hy : y ∈ ι ⁻¹ᵁ wcSgD K N a) :
    (∀ c : K, (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom ((ι.app (wcSgD K N a)).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)).hom
          (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)))) =
        wcLdpConst K X.hom y c) ∧
    (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom ((ι.app (wcSgD K N a)).hom (wcSgE K N a a)) = 1 ∧
    (∀ w : Fin (N + 1) → Fin (N + 1) → K, wcLdpGerm K N ι (wcLdpQuad K N w) a y hy =
      ∑ p, ∑ q, wcLdpConst K X.hom y (w p q) *
        (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom ((ι.app (wcSgD K N a)).hom (wcSgE K N a p)) *
        (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom ((ι.app (wcSgD K N a)).hom (wcSgE K N a q))) ∧
    (∀ ℓ : Fin (N + 1) → K, (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom ((ι.app (wcSgD K N a)).hom
        (wcLdpSec K N (wcLdpQuad K N fun p q => if q = a then ℓ p else 0) a)) =
      ∑ p, wcLdpConst K X.hom y (ℓ p) *
        (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom ((ι.app (wcSgD K N a)).hom (wcSgE K N a p))) :=
by

  have s2 : ∀ c : K, (ι.stalkMap y).hom (wcLdpConst K (wcProjKStr K N) (ι y) c) =
      wcLdpConst K X.hom y c := by
    intro c
    simp only [wcLdpConst, RingHom.comp_apply]
    refine (Scheme.Hom.germ_stalkMap_apply (f := ι) (U := ⊤) (x := y) (hx := trivial) _).trans ?_
    rw [← hιX, Scheme.Hom.comp_appTop]
    rfl

  have s3 : ∀ c : K, (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom ((ι.app (wcSgD K N a)).hom
      ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)).hom
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (Submonoid.powers (MvPolynomial.X a))
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)))) =
      wcLdpConst K X.hom y c := by
    intro c
    refine (Scheme.Hom.germ_stalkMap_apply (f := ι) (U := wcSgD K N a) (x := y) (hx := hy) _).symm.trans ?_
    rw [hconst a (ι y) hy c]
    exact s2 c

  have hEa : wcSgE K N a a = 1 := (hsec a (fun _ _ => 0)).1
  have s4 : (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom
      ((ι.app (wcSgD K N a)).hom (wcSgE K N a a)) = 1 := by
    rw [hEa, map_one, map_one]

  have s5 : ∀ w : Fin (N + 1) → Fin (N + 1) → K, wcLdpGerm K N ι (wcLdpQuad K N w) a y hy =
      ∑ p, ∑ q, wcLdpConst K X.hom y (w p q) *
        (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom ((ι.app (wcSgD K N a)).hom (wcSgE K N a p)) *
        (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom
          ((ι.app (wcSgD K N a)).hom (wcSgE K N a q)) := by
    intro w
    unfold wcLdpGerm
    rw [(hsec a w).2]
    simp only [map_sum, map_mul, s3]
  refine ⟨s3, s4, s5, ?_⟩

  intro ℓ
  refine (s5 (fun p q => if q = a then ℓ p else 0)).trans ?_
  refine Finset.sum_congr rfl (fun p _ => ?_)
  rw [Finset.sum_eq_single a]
  · rw [if_pos rfl, s4, mul_one]
  · intro b _ hb
    rw [if_neg hb, map_zero, zero_mul, zero_mul]
  · intro h
    exact absurd (Finset.mem_univ a) h

theorem wc_ldp_lnf_stalk_gen (K : Type u) [Field K] (N : ℕ) (X : Over (Spec (.of K)))
    (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι) (a : Fin (N + 1)) (y : X.left)
    (hy : y ∈ ι ⁻¹ᵁ wcSgD K N a)
    (hcy : ∀ c : K, (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom ((ι.app (wcSgD K N a)).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)).hom
          (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)))) =
        wcLdpConst K X.hom y c)
    (hfrac : ∀ z : (wcProjK K N).presheaf.stalk (ι y),
      ∃ r σ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a),
        IsUnit (((wcProjK K N).presheaf.germ (wcSgD K N a) (ι y) hy).hom
          ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)).hom σ)) ∧
        z * ((wcProjK K N).presheaf.germ (wcSgD K N a) (ι y) hy).hom
            ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)).hom σ) =
          ((wcProjK K N).presheaf.germ (wcSgD K N a) (ι y) hy).hom
            ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)).hom r))
    (hgen : Subring.closure (Set.range (fun i : Fin (N + 1) => HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K a)) 1
      (MvPolynomial.X i)
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i))) ∪
      Set.range ((HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap K _))) = ⊤)
    (ξ : Fin (N + 1) → K)
    (hξ : ∀ i, (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom ((ι.app (wcSgD K N a)).hom (wcSgE K N a i)) -
      wcLdpConst K X.hom y (ξ i) ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk y)) :
    IsLocalRing.maximalIdeal (X.left.presheaf.stalk y) = Ideal.span (Set.range fun i =>
      (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom ((ι.app (wcSgD K N a)).hom (wcSgE K N a i)) -
        wcLdpConst K X.hom y (ξ i)) :=
by
  classical
  haveI := hι

  have alg : ∀ {A O : Type u} [CommRing A] [CommRing O] [IsLocalRing O]
      (κ : K →+* A) (φ : A →+* O) (C : K →+* O), (∀ c : K, φ (κ c) = C c) →
      ∀ {J : Type} (g : J → A), Subring.closure (Set.range g ∪ Set.range κ) = ⊤ →
      ∀ (ξ : J → K), (∀ i, φ (g i) - C (ξ i) ∈ IsLocalRing.maximalIdeal O) →
      (∀ y₀ ∈ IsLocalRing.maximalIdeal O, ∃ r σ : A, IsUnit (φ σ) ∧ y₀ * φ σ = φ r) →
      IsLocalRing.maximalIdeal O = Ideal.span (Set.range fun i => φ (g i) - C (ξ i)) := by
    intro A O _ _ _ κ φ C hC J g hg ξ hξ' hfr
    set I := Ideal.span (Set.range fun i => φ (g i) - C (ξ i)) with hI
    have RU : ∀ c : K, C c ∈ IsLocalRing.maximalIdeal O → c = 0 := by
      intro c hc
      by_contra h0
      exact (IsLocalRing.mem_maximalIdeal _).mp hc ((isUnit_iff_ne_zero.mpr h0).map C)
    have P : ∀ s : A, ∃ c : K, φ s - C c ∈ I := by
      intro s
      have hs : s ∈ Subring.closure (Set.range g ∪ Set.range κ) := hg ▸ Subring.mem_top s
      induction hs using Subring.closure_induction with
      | mem x hx =>
        rcases hx with ⟨i, rfl⟩ | ⟨c, rfl⟩
        · exact ⟨ξ i, Ideal.subset_span ⟨i, rfl⟩⟩
        · exact ⟨c, by rw [hC, sub_self]; exact I.zero_mem⟩
      | zero => exact ⟨0, by rw [map_zero, map_zero, sub_self]; exact I.zero_mem⟩
      | one => exact ⟨1, by rw [map_one, map_one, sub_self]; exact I.zero_mem⟩
      | add x y _ _ hx hy =>
        obtain ⟨c, hc⟩ := hx
        obtain ⟨c', hc'⟩ := hy
        refine ⟨c + c', ?_⟩
        have e : φ (x + y) - C (c + c') = (φ x - C c) + (φ y - C c') := by
          rw [map_add, map_add]; ring
        rw [e]; exact I.add_mem hc hc'
      | neg x _ hx =>
        obtain ⟨c, hc⟩ := hx
        refine ⟨-c, ?_⟩
        have e : φ (-x) - C (-c) = -(φ x - C c) := by rw [map_neg, map_neg]; ring
        rw [e]; exact I.neg_mem hc
      | mul x y _ _ hx hy =>
        obtain ⟨c, hc⟩ := hx
        obtain ⟨c', hc'⟩ := hy
        refine ⟨c * c', ?_⟩
        have e : φ (x * y) - C (c * c') = φ x * (φ y - C c') + C c' * (φ x - C c) := by
          rw [map_mul, map_mul]; ring
        rw [e]; exact I.add_mem (I.mul_mem_left _ hc') (I.mul_mem_left _ hc)
    have hIm : I ≤ IsLocalRing.maximalIdeal O := by
      rw [hI, Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      exact hξ' i
    refine le_antisymm ?_ hIm
    intro y₀ hy₀
    obtain ⟨r, σ, hu, he⟩ := hfr y₀ hy₀
    have hr : φ r ∈ IsLocalRing.maximalIdeal O := he ▸ Ideal.mul_mem_right _ _ hy₀
    obtain ⟨c, hc⟩ := P r
    have hCc : C c ∈ IsLocalRing.maximalIdeal O := by
      have h1 := Ideal.sub_mem _ hr (hIm hc)
      rwa [sub_sub_cancel] at h1
    have hc0 := RU c hCc
    rw [hc0, map_zero, sub_zero, ← he] at hc
    exact (Ideal.mul_unit_mem_iff_mem I hu).mp hc

  let φ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      (MvPolynomial.X a) →+* X.left.presheaf.stalk y :=
    (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom.comp ((ι.app (wcSgD K N a)).hom.comp
      (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)).hom)
  have G : ∀ s, (ι.stalkMap y).hom (((wcProjK K N).presheaf.germ (wcSgD K N a) (ι y) hy).hom
      ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X a)).hom s)) = φ s := by
    intro s
    exact Scheme.Hom.germ_stalkMap_apply ι (wcSgD K N a) y hy _
  have hfrac' : ∀ y₀ ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk y),
      ∃ r σ, IsUnit (φ σ) ∧ y₀ * φ σ = φ r := by
    intro y₀ _
    obtain ⟨z, rfl⟩ := ι.stalkMap_surjective y y₀
    obtain ⟨r, σ, hu, he⟩ := hfrac z
    refine ⟨r, σ, ?_, ?_⟩
    · rw [← G σ]; exact hu.map _
    · rw [← G σ, ← G r, ← map_mul, he]
  exact alg _ φ (wcLdpConst K X.hom y) hcy _ hgen ξ hξ hfrac'

theorem wc_ldp_lnf_chart_change (K : Type u) [Field K] (N : ℕ) (X : Over (Spec (.of K)))
    (ι : X.left ⟶ wcProjK K N) (a b : Fin (N + 1)) (y : X.left) (hb : y ∈ ι ⁻¹ᵁ wcSgD K N b)
    (ξ' : Fin (N + 1) → K)
    (hξ' : ∀ i, (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N b) y hb).hom ((ι.app (wcSgD K N b)).hom (wcSgE K N b i)) -
      wcLdpConst K X.hom y (ξ' i) ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk y))
    (ha0 : ξ' a ≠ 0) :
    ∃ ha : y ∈ ι ⁻¹ᵁ wcSgD K N a, ∀ i,
      (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y ha).hom ((ι.app (wcSgD K N a)).hom (wcSgE K N a i)) -
        wcLdpConst K X.hom y (ξ' i / ξ' a) ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk y) :=
by
  classical

  have L1 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1), Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g = (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
    intro σ A _ _ _ 𝒜 _ f g hf hg
    have ha : HomogeneousLocalization.Away.isLocalizationElem hf hg =
        HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg := by
      apply HomogeneousLocalization.val_injective
      simp [HomogeneousLocalization.Away.val_mk]
    have hb : (Proj.basicOpen 𝒜 f).ι ⁻¹ᵁ Proj.basicOpen 𝒜 g =
        (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) := by
      have h1 := Proj.awayι_preimage_basicOpen 𝒜 hf Nat.one_pos hg Nat.one_pos
      rw [← Proj.basicOpenIsoSpec_inv_ι, Scheme.Hom.comp_preimage, ha] at h1
      rw [← h1, ← Scheme.Hom.comp_preimage, Iso.hom_inv_id, Scheme.Hom.id_preimage]
    have hd : (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) =
        (Proj.basicOpen 𝒜 f).ι ''ᵁ ((Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
      have hsp := basicOpen_eq_of_affine (R := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))
        (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)
      have h3 : (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) =
          (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          (Spec _).basicOpen ((Scheme.ΓSpecIso _).inv (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) :=
        congrArg (fun V => (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ V) hsp.symm
      rw [h3, ← Scheme.Opens.ι_image_basicOpen_topIso_inv, Scheme.preimage_basicOpen_top]
      congr 2
      rw [Proj.basicOpenIsoSpec_hom]
      change _ = ConcreteCategory.hom (Scheme.Hom.app (Proj.basicOpenToSpec 𝒜 f) ⊤) _
      rw [Proj.basicOpenToSpec_app_top]
      exact congrArg (fun y => ConcreteCategory.hom (Proj.basicOpen 𝒜 f).topIso.inv
        (ConcreteCategory.hom (Proj.awayToSection 𝒜 f) y))
        (Iso.inv_hom_id_apply (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)))
          (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)).symm
    rw [hd, ← hb, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]

  have L2 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g h : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1) (hh : h ∈ 𝒜 1), (Proj 𝒜).presheaf.map (homOfLE (inf_le_left : Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 h hh)) = (Proj 𝒜).presheaf.map (homOfLE (inf_le_left : Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) * (Proj 𝒜).presheaf.map (homOfLE (inf_le_right : Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 g)).op (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 h hh)) := by
    intro σ A _ _ _ 𝒜 _ f g h hf hg hh
    have key : ∀ (W : (Proj 𝒜).Opens) (_ : W = Proj.basicOpen 𝒜 (f * g))
        (h₁ : W ≤ Proj.basicOpen 𝒜 f) (h₂ : W ≤ Proj.basicOpen 𝒜 g),
        (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 h hh)) =
          (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) *
          (Proj 𝒜).presheaf.map (homOfLE h₂).op
            (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 h hh)) := by
      rintro W rfl h₁ h₂
      have e1 : ∀ a, (Proj 𝒜).presheaf.map (homOfLE h₁).op (Proj.awayToSection 𝒜 f a) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hg rfl a) := by
        intro a
        have := ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 hg (rfl : f * g = f * g)) a
        exact this.symm
      have e2 : ∀ b, (Proj 𝒜).presheaf.map (homOfLE h₂).op (Proj.awayToSection 𝒜 g b) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hf (mul_comm f g) b) := by
        intro b
        have := ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 (f := g) hf (mul_comm f g)) b
        exact this.symm
      rw [e1, e1, e2, ← map_mul]
      congr 1
      rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.awayMap_mk]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [Submonoid.coe_mul, pow_one, OneMemClass.coe_one, one_mul]
      ring
    exact key _ (Proj.basicOpen_mul 𝒜 f g).symm _ _

  have S2 : ∀ (J L j : Fin (N + 1)),
      (wcProjK K N).basicOpen (wcSgE K N J L) = wcSgD K N J ⊓ wcSgD K N L ∧
      (wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N J ⊓ wcSgD K N L ≤ wcSgD K N J)).op (wcSgE K N J j) =
        (wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N J ⊓ wcSgD K N L ≤ wcSgD K N J)).op (wcSgE K N J L) *
        (wcProjK K N).presheaf.map (homOfLE (inf_le_right : wcSgD K N J ⊓ wcSgD K N L ≤ wcSgD K N L)).op (wcSgE K N L j) := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) := MvPolynomial.gradedAlgebra
    have hX : ∀ k : Fin (N + 1), (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 := fun k =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
    intro J L j
    refine ⟨?_, ?_⟩
    · exact (L1 _ (MvPolynomial.X J) (MvPolynomial.X L) (hX J) (hX L)).symm
    · exact L2 _ (MvPolynomial.X J) (MvPolynomial.X L) (MvPolynomial.X j) (hX J) (hX L) (hX j)

  have transfer : ∀ (O : Type u) [CommRing O] [IsLocalRing O] (C : K →+* O) (ub : Fin (N + 1) → O),
      (∀ i, ub i - C (ξ' i) ∈ IsLocalRing.maximalIdeal O) →
      IsUnit (ub a) ∧ ∀ ua : Fin (N + 1) → O, (∀ i, ub i = ub a * ua i) →
        ∀ i, ua i - C (ξ' i / ξ' a) ∈ IsLocalRing.maximalIdeal O := by
    intro O _ _ C ub hres
    have hCa : IsUnit (C (ξ' a)) := (IsUnit.mk0 _ ha0).map C
    have hunit : IsUnit (ub a) := by
      by_contra hnu
      have h1 : ub a ∈ IsLocalRing.maximalIdeal O := (IsLocalRing.mem_maximalIdeal _).mpr hnu
      have h2 := Ideal.sub_mem _ h1 (hres a)
      rw [sub_sub_cancel] at h2
      exact IsLocalRing.notMem_maximalIdeal.mpr hCa h2
    refine ⟨hunit, fun ua hmul i => ?_⟩
    have hc : C (ξ' i / ξ' a) * C (ξ' a) = C (ξ' i) := by
      rw [← map_mul, div_mul_cancel₀ _ ha0]
    have hkey : ub a * (ua i - C (ξ' i / ξ' a)) =
        (ub i - C (ξ' i)) - (ub a - C (ξ' a)) * C (ξ' i / ξ' a) := by
      linear_combination -(hmul i) - hc
    have hm : ub a * (ua i - C (ξ' i / ξ' a)) ∈ IsLocalRing.maximalIdeal O := by
      rw [hkey]
      exact Ideal.sub_mem _ (hres i) (Ideal.mul_mem_right _ _ (hres a))
    have hinv : ua i - C (ξ' i / ξ' a) = ↑hunit.unit⁻¹ * (ub a * (ua i - C (ξ' i / ξ' a))) := by
      rw [← mul_assoc, IsUnit.val_inv_mul, one_mul]
    rw [hinv]
    exact Ideal.mul_mem_left _ _ hm

  obtain ⟨hunit, htr⟩ := transfer (X.left.presheaf.stalk y) (wcLdpConst K X.hom y)
    (fun i => (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N b) y hb).hom
      ((ι.app (wcSgD K N b)).hom (wcSgE K N b i))) hξ'
  have hy1 := (Scheme.mem_basicOpen X.left ((ι.app (wcSgD K N b)).hom (wcSgE K N b a)) y hb).mpr hunit
  rw [← Scheme.preimage_basicOpen, Scheme.Hom.mem_preimage, (S2 b a a).1] at hy1
  have ha : y ∈ ι ⁻¹ᵁ wcSgD K N a := (TopologicalSpace.Opens.mem_inf.mp hy1).2
  refine ⟨ha, htr (fun i => (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y ha).hom
      ((ι.app (wcSgD K N a)).hom (wcSgE K N a i))) fun i => ?_⟩
  have e := congrArg (fun s => ((wcProjK K N).presheaf.germ _ (ι y) hy1).hom s) (S2 b a i).2
  simp only [map_mul, TopCat.Presheaf.germ_res_apply] at e
  have e2 := congrArg (fun s => (ι.stalkMap y).hom s) e
  simp only [map_mul, Scheme.Hom.germ_stalkMap_apply] at e2
  exact e2

theorem wc_ldp_lnf_chart_sep (K : Type u) [Field K] (N : ℕ) (X : Over (Spec (.of K)))
    (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι) (a : Fin (N + 1))
    (hgen : Subring.closure (Set.range (fun i : Fin (N + 1) => HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K a)) 1
      (MvPolynomial.X i)
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i))) ∪
      Set.range ((HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap K _))) = ⊤)
    (hsep : ∀ (p p' : wcProjK K N) (hp : p ∈ wcSgD K N a) (hp' : p' ∈ wcSgD K N a),
      IsClosed ({p} : Set (wcProjK K N)) → p ≠ p' →
      ∃ s : Γ(wcProjK K N, wcSgD K N a), ((wcProjK K N).evaluation (wcSgD K N a) p hp).hom s = 0 ∧
        ((wcProjK K N).evaluation (wcSgD K N a) p' hp').hom s ≠ 0)
    (y y' : X.left) (hy : y ∈ ι ⁻¹ᵁ wcSgD K N a) (hy' : y' ∈ ι ⁻¹ᵁ wcSgD K N a)
    (hcl : IsClosed ({y} : Set X.left))
    (hcy : ∀ c : K, (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom ((ι.app (wcSgD K N a)).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)).hom
          (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)))) =
        wcLdpConst K X.hom y c)
    (hcy' : ∀ c : K, (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y' hy').hom ((ι.app (wcSgD K N a)).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)).hom
          (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)))) =
        wcLdpConst K X.hom y' c)
    (ξ : Fin (N + 1) → K)
    (hξ : ∀ i, (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom ((ι.app (wcSgD K N a)).hom (wcSgE K N a i)) -
      wcLdpConst K X.hom y (ξ i) ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk y))
    (hξ' : ∀ i, (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y' hy').hom ((ι.app (wcSgD K N a)).hom (wcSgE K N a i)) -
      wcLdpConst K X.hom y' (ξ i) ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk y')) :
    y = y' :=
by
  classical

  have transfer : ∀ {R O O' : Type u} {ιt : Type} [CommRing R] [CommRing O] [IsLocalRing O]
      [CommRing O'] [IsLocalRing O'] (g : ιt → R) (κ : K →+* R)
      (_ : Subring.closure (Set.range g ∪ Set.range κ) = ⊤)
      (φ : R →+* O) (φ' : R →+* O') (C : K →+* O) (C' : K →+* O')
      (_ : ∀ c, φ (κ c) = C c) (_ : ∀ c, φ' (κ c) = C' c) (ξ : ιt → K)
      (_ : ∀ i, φ (g i) - C (ξ i) ∈ IsLocalRing.maximalIdeal O)
      (_ : ∀ i, φ' (g i) - C' (ξ i) ∈ IsLocalRing.maximalIdeal O') (r : R),
      φ r ∈ IsLocalRing.maximalIdeal O → φ' r ∈ IsLocalRing.maximalIdeal O' := by
    intro R O O' ιt _ _ _ _ _ g κ hgen' φ φ' C C' hC hC' ξ hξ hξ' r hr
    have P : ∀ s : R, ∃ c : K, φ s - C c ∈ IsLocalRing.maximalIdeal O ∧
        φ' s - C' c ∈ IsLocalRing.maximalIdeal O' := by
      intro s
      have hs : s ∈ (⊤ : Subring R) := Subring.mem_top s
      rw [← hgen'] at hs
      induction hs using Subring.closure_induction with
      | mem x hx =>
        rcases hx with ⟨i, rfl⟩ | ⟨c, rfl⟩
        · exact ⟨ξ i, hξ i, hξ' i⟩
        · refine ⟨c, ?_, ?_⟩
          · rw [hC, sub_self]; exact Ideal.zero_mem _
          · rw [hC', sub_self]; exact Ideal.zero_mem _
      | zero => exact ⟨0, by simp, by simp⟩
      | one => exact ⟨1, by simp, by simp⟩
      | add x y _ _ hx hy =>
        obtain ⟨c₁, h₁, h₁'⟩ := hx
        obtain ⟨c₂, h₂, h₂'⟩ := hy
        refine ⟨c₁ + c₂, ?_, ?_⟩
        · have e : φ (x + y) - C (c₁ + c₂) = (φ x - C c₁) + (φ y - C c₂) := by
            rw [map_add, map_add]; ring
          rw [e]; exact Ideal.add_mem _ h₁ h₂
        · have e : φ' (x + y) - C' (c₁ + c₂) = (φ' x - C' c₁) + (φ' y - C' c₂) := by
            rw [map_add, map_add]; ring
          rw [e]; exact Ideal.add_mem _ h₁' h₂'
      | neg x _ hx =>
        obtain ⟨c, h, h'⟩ := hx
        refine ⟨-c, ?_, ?_⟩
        · have e : φ (-x) - C (-c) = -(φ x - C c) := by rw [map_neg, map_neg]; ring
          rw [e]; exact neg_mem h
        · have e : φ' (-x) - C' (-c) = -(φ' x - C' c) := by rw [map_neg, map_neg]; ring
          rw [e]; exact neg_mem h'
      | mul x y _ _ hx hy =>
        obtain ⟨c₁, h₁, h₁'⟩ := hx
        obtain ⟨c₂, h₂, h₂'⟩ := hy
        refine ⟨c₁ * c₂, ?_, ?_⟩
        · have e : φ (x * y) - C (c₁ * c₂) = φ x * (φ y - C c₂) + C c₂ * (φ x - C c₁) := by
            rw [map_mul, map_mul]; ring
          rw [e]; exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ h₂) (Ideal.mul_mem_left _ _ h₁)
        · have e : φ' (x * y) - C' (c₁ * c₂) =
              φ' x * (φ' y - C' c₂) + C' c₂ * (φ' x - C' c₁) := by
            rw [map_mul, map_mul]; ring
          rw [e]; exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ h₂') (Ideal.mul_mem_left _ _ h₁')
    obtain ⟨c, h, h'⟩ := P r
    have hCc : C c ∈ IsLocalRing.maximalIdeal O := by
      have e : C c = φ r - (φ r - C c) := by ring
      rw [e]; exact Ideal.sub_mem _ hr h
    have hc0 : c = 0 := by
      by_contra hc
      exact (IsLocalRing.notMem_maximalIdeal.mpr ((Ne.isUnit hc).map C)) hCc
    rw [hc0, map_zero, sub_zero] at h'
    exact h'

  have evz : ∀ {Z W : Scheme.{u}} (f : Z ⟶ W) (U : W.Opens) (s : Γ(W, U)) (x : Z)
      (hx : x ∈ f ⁻¹ᵁ U), (W.evaluation U (f x) hx).hom s = 0 ↔
        (Z.presheaf.germ (f ⁻¹ᵁ U) x hx).hom ((f.app U).hom s) ∈
          IsLocalRing.maximalIdeal (Z.presheaf.stalk x) := by
    intro Z W f U s x hx
    refine (Scheme.evaluation_eq_zero_iff_notMem_basicOpen W (f x) hx s).trans ?_
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← Scheme.mem_basicOpen Z _ x hx,
      ← Scheme.preimage_basicOpen]
    exact Iff.rfl
  by_contra hne
  haveI := hι
  have hinj : ι y ≠ ι y' := fun h => hne (ι.isClosedEmbedding.isEmbedding.injective h)
  have hclι : IsClosed ({ι y} : Set (wcProjK K N)) := by
    have h1 := ι.isClosedEmbedding.isClosedMap {y} hcl
    rwa [Set.image_singleton] at h1
  obtain ⟨s, hs0, hs1⟩ := hsep (ι y) (ι y') hy hy' hclι hinj
  obtain ⟨z, hz⟩ : ∃ z, (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      (MvPolynomial.X a)).hom z = s := by
    refine ⟨(Proj.basicOpenIsoAway (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      (MvPolynomial.X a)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a))
      one_pos).inv.hom s, ?_⟩
    have h1 := Iso.inv_hom_id_apply (Proj.basicOpenIsoAway
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a))
      one_pos) s
    rw [Proj.basicOpenIsoAway_hom] at h1
    exact h1
  subst hz
  have hr := (evz ι (wcSgD K N a) _ y hy).mp hs0
  apply hs1
  refine (evz ι (wcSgD K N a) _ y' hy').mpr ?_
  exact transfer _ _ hgen
    ((X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom.comp ((ι.app (wcSgD K N a)).hom.comp
      (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X a)).hom))
    ((X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y' hy').hom.comp ((ι.app (wcSgD K N a)).hom.comp
      (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X a)).hom))
    (wcLdpConst K X.hom y) (wcLdpConst K X.hom y') (fun c => hcy c) (fun c => hcy' c) ξ
    (fun i => hξ i) (fun i => hξ' i) z hr

theorem wc_ldp_lnf_basis (K : Type u) [Field K] (O : Type*) [CommRing O] (C : K →+* O)
    (N n : ℕ) (a : Fin (N + 1)) (Λ : Submodule K (Fin (N + 1) → K)) (hΛ : Module.finrank K Λ = n + 1)
    (ξ : Fin (N + 1) → K) (hξΛ : ξ ∈ Λ) (hξa : ξ a = 1) :
    ∃ e lam : Fin n → Fin (N + 1) → K, (∀ k, e k ∈ Λ ∧ e k a = 0) ∧
      (∀ η ∈ Λ, η = η a • ξ + ∑ k, (∑ p, lam k p * η p) • e k) ∧
      ∀ v : Fin (N + 1) → O, v a = 0 →
        (∀ ℓ : Fin (N + 1) → K, (∀ η ∈ Λ, ∑ p, ℓ p * η p = 0) → ∑ p, C (ℓ p) * v p = 0) →
        ∀ i, v i = ∑ k, C (e k i) * ∑ p, C (lam k p) * v p :=
by
  classical
  have hA : ∃ e lam : Fin n → Fin (N + 1) → K, (∀ k, e k ∈ Λ ∧ e k a = 0) ∧
      (∀ η ∈ Λ, η = η a • ξ + ∑ k, (∑ p, lam k p * η p) • e k) := by
    let f : Λ →ₗ[K] K := (LinearMap.proj a).comp Λ.subtype
    have hf : ∀ η : Λ, f η = (η : Fin (N + 1) → K) a := fun η => rfl
    have hsurj : LinearMap.range f = ⊤ := by
      rw [LinearMap.range_eq_top]
      intro c
      refine ⟨c • ⟨ξ, hξΛ⟩, ?_⟩
      rw [hf]
      simp [hξa]
    have hW : Module.finrank K (LinearMap.ker f) = n := by
      have h := LinearMap.finrank_range_add_finrank_ker f
      rw [hsurj, finrank_top, Module.finrank_self, hΛ] at h
      omega
    have : Module.Free K (LinearMap.ker f) := Module.Free.of_divisionRing K (LinearMap.ker f)
    have : Module.Finite K (LinearMap.ker f) := inferInstance
    let bW := Module.finBasisOfFinrankEq K (LinearMap.ker f) hW
    let g0 : Λ →ₗ[K] Λ := (LinearMap.id : Λ →ₗ[K] Λ) - LinearMap.smulRight f (⟨ξ, hξΛ⟩ : Λ)
    have hgmem : ∀ η : Λ, g0 η ∈ LinearMap.ker f := by
      intro η
      rw [LinearMap.mem_ker]
      simp only [g0, LinearMap.sub_apply, LinearMap.id_apply,
        LinearMap.smulRight_apply, hf, Submodule.coe_sub, Submodule.coe_smul, Pi.sub_apply,
        Pi.smul_apply, hξa, smul_eq_mul, mul_one, sub_self]
    let g : Λ →ₗ[K] LinearMap.ker f := LinearMap.codRestrict (LinearMap.ker f) g0 hgmem
    have hg : ∀ η : Λ, ((g η : Λ) : Fin (N + 1) → K) =
        (η : Fin (N + 1) → K) - (η : Fin (N + 1) → K) a • ξ := by
      intro η
      simp only [g, g0, LinearMap.codRestrict_apply, LinearMap.sub_apply, LinearMap.id_apply,
        LinearMap.smulRight_apply, Submodule.coe_sub, Submodule.coe_smul, hf]
    choose L hL using fun k : Fin n => LinearMap.exists_extend ((bW.coord k).comp g)
    refine ⟨fun k => ((bW k : Λ) : Fin (N + 1) → K),
      fun k p => L k (fun j => if p = j then 1 else 0), ?_, ?_⟩
    · intro k
      refine ⟨(bW k : Λ).2, ?_⟩
      have := (bW k).2
      rw [LinearMap.mem_ker, hf] at this
      exact this
    · intro η hη
      have h1 := bW.sum_repr (g ⟨η, hη⟩)
      have h2 := congrArg (fun x : LinearMap.ker f => ((x : Λ) : Fin (N + 1) → K)) h1
      simp only [Submodule.coe_sum, Submodule.coe_smul] at h2
      rw [hg] at h2
      have h3 : ∀ k, bW.repr (g ⟨η, hη⟩) k =
          ∑ p, L k (fun j => if p = j then 1 else 0) * η p := by
        intro k
        have := LinearMap.congr_fun (hL k) ⟨η, hη⟩
        simp only [LinearMap.comp_apply, Module.Basis.coord_apply, Submodule.subtype_apply] at this
        rw [← this, LinearMap.pi_apply_eq_sum_univ (L k) η]
        exact Finset.sum_congr rfl (fun p _ => by rw [smul_eq_mul, mul_comm])
      simp only [h3] at h2
      rw [h2]
      abel
  obtain ⟨e, lam, h1, h2⟩ := hA
  refine ⟨e, lam, h1, h2, ?_⟩
  intro v hva hann i
  have hℓ : ∀ η ∈ Λ, ∑ p, ((if p = i then (1 : K) else 0) - (if p = a then ξ i else 0) -
      ∑ k, lam k p * e k i) * η p = 0 := by
    intro η hη
    have hstar := congrFun (h2 η hη) i
    simp only [Pi.add_apply, Pi.smul_apply, Finset.sum_apply, smul_eq_mul] at hstar
    have hd : ∑ p, (∑ k, lam k p * e k i) * η p = ∑ k, (∑ p, lam k p * η p) * e k i := by
      simp only [Finset.sum_mul]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring
    simp only [sub_mul, Finset.sum_sub_distrib, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq',
      Finset.mem_univ, ite_true, hd]
    linear_combination hstar
  have hB := hann _ hℓ
  have hd : ∑ p, (∑ k, C (lam k p) * C (e k i)) * v p =
      ∑ k, C (e k i) * ∑ p, C (lam k p) * v p := by
    simp only [Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring
  simp only [map_sub, map_sum, map_mul, apply_ite C, map_one, map_zero, sub_mul,
    Finset.sum_sub_distrib, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ,
    ite_true, hva, mul_zero, sub_zero, hd] at hB
  exact sub_eq_zero.mp hB

theorem wc_ldp_lnf_res_mem (K : Type u) [Field K] (O : Type*) [CommRing O] [IsLocalRing O]
    (C : K →+* O) (N : ℕ) (a : Fin (N + 1)) (Λ : Submodule K (Fin (N + 1) → K)) (u : Fin (N + 1) → O)
    (ξ : Fin (N + 1) → K) (hua : u a = 1)
    (hres : ∀ i, u i - C (ξ i) ∈ IsLocalRing.maximalIdeal O)
    (hlin : ∀ ℓ : Fin (N + 1) → K, (∀ η ∈ Λ, ∑ p, ℓ p * η p = 0) → ∑ p, C (ℓ p) * u p = 0) :
    ξ a = 1 ∧ ξ ∈ Λ ∧
      ∀ ℓ : Fin (N + 1) → K, (∀ η ∈ Λ, ∑ p, ℓ p * η p = 0) → ∑ p, C (ℓ p) * (u p - C (ξ p)) = 0 :=
by
  classical
  have s1 : ∀ z : K, C z ∈ IsLocalRing.maximalIdeal O → z = 0 := by
    intro z hz
    by_contra hne
    have hu : IsUnit (C z) := (Ne.isUnit hne).map C
    exact (IsLocalRing.mem_maximalIdeal _).mp hz hu
  have s2 : ξ a = 1 := by
    have h := hres a
    rw [hua] at h
    have h' : C (1 - ξ a) ∈ IsLocalRing.maximalIdeal O := by
      rw [map_sub, map_one]; exact h
    exact (sub_eq_zero.mp (s1 _ h')).symm
  have key : ∀ ℓ : Fin (N + 1) → K, C (∑ p, ℓ p * ξ p) =
      ∑ p, C (ℓ p) * u p - ∑ p, C (ℓ p) * (u p - C (ξ p)) := by
    intro ℓ
    rw [map_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    rw [map_mul]; ring
  have s3 : ∀ ℓ : Fin (N + 1) → K, (∀ η ∈ Λ, ∑ p, ℓ p * η p = 0) → ∑ p, ℓ p * ξ p = 0 := by
    intro ℓ hℓ
    have hS := hlin ℓ hℓ
    have hT : ∑ p, C (ℓ p) * (u p - C (ξ p)) ∈ IsLocalRing.maximalIdeal O :=
      Ideal.sum_mem _ (fun p _ => Ideal.mul_mem_left _ _ (hres p))
    apply s1
    rw [key ℓ, hS, zero_sub]
    exact neg_mem hT
  have s5 : ξ ∈ Λ := by
    rw [← Subspace.forall_mem_dualAnnihilator_apply_eq_zero_iff]
    intro φ hφ
    rw [Submodule.mem_dualAnnihilator] at hφ
    have hexp : ∀ x : Fin (N + 1) → K,
        φ x = ∑ p, (φ (fun j => if p = j then 1 else 0)) * x p := by
      intro x
      rw [LinearMap.pi_apply_eq_sum_univ φ x]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      rw [smul_eq_mul, mul_comm]
    rw [hexp]
    apply s3
    intro η hη
    rw [← hexp]
    exact hφ η hη
  refine ⟨s2, s5, ?_⟩
  intro ℓ hℓ
  have h0 := s3 ℓ hℓ
  have hS := hlin ℓ hℓ
  have e := key ℓ
  rw [h0, map_zero, hS, zero_sub, eq_comm, neg_eq_zero] at e
  exact e

theorem wc_ldp_lnf_point_alg (K : Type u) [Field K] (O : Type*) [CommRing O] [IsLocalRing O]
    (C : K →+* O) (N n : ℕ) (a : Fin (N + 1)) (Λ : Submodule K (Fin (N + 1) → K))
    (w : Fin (N + 1) → Fin (N + 1) → K) (u : Fin (N + 1) → O) (ξ : Fin (N + 1) → K)
    (e lam : Fin n → Fin (N + 1) → K) (hξΛ : ξ ∈ Λ) (hξa : ξ a = 1) (he : ∀ k, e k ∈ Λ ∧ e k a = 0)
    (hdec : ∀ η ∈ Λ, η = η a • ξ + ∑ k, (∑ p, lam k p * η p) • e k)
    (hv : ∀ i, u i - C (ξ i) = ∑ k, C (e k i) * ∑ p, C (lam k p) * (u p - C (ξ p)))
    (hgen : IsLocalRing.maximalIdeal O = Ideal.span (Set.range fun i => u i - C (ξ i)))
    (hsing : ∑ p, ∑ q, C (w p q) * u p * u q ∈ IsLocalRing.maximalIdeal O ^ 2)
    (hind : ∀ t : Fin n → O, IsLocalRing.maximalIdeal O = Ideal.span (Set.range t) →
      ∀ c : Fin n → K, ∑ k, C (c k) * t k ∈ IsLocalRing.maximalIdeal O ^ 2 → c = 0) :
    IsLocalRing.maximalIdeal O = Ideal.span (Set.range fun k => ∑ p, C (lam k p) * (u p - C (ξ p))) ∧
    ∑ p, ∑ q, C (w p q) * u p * u q =
      ∑ k, ∑ l, C (∑ p, ∑ q, w p q * e k p * e l q) *
        (∑ p, C (lam k p) * (u p - C (ξ p))) * (∑ p, C (lam l p) * (u p - C (ξ p))) ∧
    ∀ η ∈ Λ, ∑ p, ∑ q, w p q * (ξ p * η q + η p * ξ q) = 0 :=
by
  classical
  obtain ⟨T, hTdef⟩ : ∃ T : Fin n → O, ∀ k, T k = ∑ p, C (lam k p) * (u p - C (ξ p)) :=
    ⟨_, fun k => rfl⟩
  simp only [← hTdef] at hv ⊢

  have hG1 : IsLocalRing.maximalIdeal O = Ideal.span (Set.range T) := by
    rw [hgen]
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      show u i - C (ξ i) ∈ _
      rw [hv i]
      exact Ideal.sum_mem _ fun k _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩)
    · rw [Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      show T k ∈ _
      rw [hTdef k]
      exact Ideal.sum_mem _ fun p _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨p, rfl⟩)

  obtain ⟨V, hV⟩ : ∃ V : Fin (N + 1) → O, ∀ p, V p = ∑ k, C (e k p) * T k := ⟨_, fun p => rfl⟩
  have hu : ∀ p, u p = C (ξ p) + V p := fun p => by rw [hV, ← hv]; ring
  have hlin : ∀ p q, C (w p q) * C (ξ p) * V q + C (w p q) * V p * C (ξ q) =
      ∑ k, C (w p q) * (C (ξ p) * C (e k q) + C (e k p) * C (ξ q)) * T k := by
    intro p q
    have h1 : C (w p q) * C (ξ p) * V q + C (w p q) * V p * C (ξ q) =
        (C (w p q) * C (ξ p)) * V q + (C (w p q) * C (ξ q)) * V p := by ring
    rw [h1, hV q, hV p, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun k _ => by ring
  have hquad : ∀ p q, C (w p q) * V p * V q =
      ∑ k, ∑ l, C (w p q) * C (e k p) * C (e l q) * T k * T l := by
    intro p q
    rw [mul_assoc, hV p, hV q, Finset.sum_mul_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun l _ => by ring
  have hterm : ∀ p q, C (w p q) * u p * u q = C (w p q) * C (ξ p) * C (ξ q) +
      ∑ k, C (w p q) * (C (ξ p) * C (e k q) + C (e k p) * C (ξ q)) * T k +
      ∑ k, ∑ l, C (w p q) * C (e k p) * C (e l q) * T k * T l := by
    intro p q
    rw [← hlin p q, ← hquad p q, hu p, hu q]
    ring
  have swap3 : ∀ f : Fin (N + 1) → Fin (N + 1) → Fin n → O,
      ∑ p, ∑ q, ∑ k, f p q k = ∑ k, ∑ p, ∑ q, f p q k := fun f =>
    (Finset.sum_congr rfl fun p _ => Finset.sum_comm).trans Finset.sum_comm
  have hE : ∑ p, ∑ q, C (w p q) * u p * u q = C (∑ p, ∑ q, w p q * ξ p * ξ q) +
      ∑ k, C (∑ p, ∑ q, w p q * (ξ p * e k q + e k p * ξ q)) * T k +
      ∑ k, ∑ l, C (∑ p, ∑ q, w p q * e k p * e l q) * T k * T l := by
    simp only [hterm, Finset.sum_add_distrib, map_sum, map_mul, map_add, Finset.sum_mul]
    congr 1
    · congr 1
      exact swap3 _
    · refine (swap3 _).trans ?_
      exact Finset.sum_congr rfl fun k _ => swap3 _

  have hTm : ∀ k, T k ∈ IsLocalRing.maximalIdeal O := fun k => by
    rw [hG1]; exact Ideal.subset_span ⟨k, rfl⟩
  have hR : ∑ k, ∑ l, C (∑ p, ∑ q, w p q * e k p * e l q) * T k * T l ∈
      IsLocalRing.maximalIdeal O ^ 2 := by
    refine Ideal.sum_mem _ fun k _ => Ideal.sum_mem _ fun l _ => ?_
    rw [mul_assoc, pow_two]
    exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_mul (hTm k) (hTm l))
  have hS : ∑ k, C (∑ p, ∑ q, w p q * (ξ p * e k q + e k p * ξ q)) * T k ∈
      IsLocalRing.maximalIdeal O :=
    Ideal.sum_mem _ fun k _ => Ideal.mul_mem_left _ _ (hTm k)
  have hsing' := hsing
  rw [hE] at hsing'
  have h2le : IsLocalRing.maximalIdeal O ^ 2 ≤ IsLocalRing.maximalIdeal O :=
    Ideal.pow_le_self two_ne_zero
  have hCQ : C (∑ p, ∑ q, w p q * ξ p * ξ q) ∈ IsLocalRing.maximalIdeal O := by
    have h := Ideal.sub_mem _ (Ideal.sub_mem _ (h2le hsing') (h2le hR)) hS
    convert h using 1
    ring
  have hQ : ∑ p, ∑ q, w p q * ξ p * ξ q = 0 := by
    by_contra hne
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hCQ)) ((Ne.isUnit hne).map C)
  have hSm2 : ∑ k, C (∑ p, ∑ q, w p q * (ξ p * e k q + e k p * ξ q)) * T k ∈
      IsLocalRing.maximalIdeal O ^ 2 := by
    have h := Ideal.sub_mem _ hsing' hR
    convert h using 1
    rw [hQ, map_zero]
    ring
  have hc0 := hind T hG1 (fun k => ∑ p, ∑ q, w p q * (ξ p * e k q + e k p * ξ q)) hSm2
  have hck : ∀ k, ∑ p, ∑ q, w p q * (ξ p * e k q + e k p * ξ q) = 0 := fun k => congrFun hc0 k
  refine ⟨hG1, ?_, ?_⟩
  · rw [hE, hQ, map_zero, zero_add,
      Finset.sum_eq_zero (fun k _ => by rw [hck k, map_zero, zero_mul]), zero_add]
  · intro η hη
    obtain ⟨μ, hμ⟩ : ∃ μ : Fin n → K, ∀ k, μ k = ∑ p', lam k p' * η p' := ⟨_, fun k => rfl⟩
    obtain ⟨s, hs⟩ : ∃ s : K, s = η a := ⟨_, rfl⟩
    have hp : ∀ p, η p = s * ξ p + ∑ k, μ k * e k p := by
      intro p
      have h := congrFun (hdec η hη) p
      simp only [Pi.add_apply, Pi.smul_apply, Finset.sum_apply, smul_eq_mul, ← hμ, ← hs] at h
      exact h
    have swap3K : ∀ f : Fin (N + 1) → Fin (N + 1) → Fin n → K,
        ∑ p, ∑ q, ∑ k, f p q k = ∑ k, ∑ p, ∑ q, f p q k := fun f =>
      (Finset.sum_congr rfl fun p _ => Finset.sum_comm).trans Finset.sum_comm
    calc ∑ p, ∑ q, w p q * (ξ p * η q + η p * ξ q)
        = ∑ p, ∑ q, (s * (w p q * ξ p * ξ q) + s * (w p q * ξ p * ξ q) +
            ∑ k, μ k * (w p q * (ξ p * e k q + e k p * ξ q))) := by
          refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => ?_
          have h1 : ∑ k, μ k * (w p q * (ξ p * e k q + e k p * ξ q)) =
              w p q * ξ p * ∑ k, μ k * e k q + w p q * ξ q * ∑ k, μ k * e k p := by
            rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
            exact Finset.sum_congr rfl fun k _ => by ring
          rw [h1, hp p, hp q]
          ring
      _ = s * ∑ p, ∑ q, w p q * ξ p * ξ q + s * ∑ p, ∑ q, w p q * ξ p * ξ q +
            ∑ k, μ k * ∑ p, ∑ q, w p q * (ξ p * e k q + e k p * ξ q) := by
          simp only [Finset.sum_add_distrib, Finset.mul_sum]
          congr 1
          exact swap3K _
      _ = 0 := by
          rw [hQ]
          simp only [hck, mul_zero, Finset.sum_const_zero, add_zero]

theorem wc_ldp_lnf_gram (K : Type u) [Field K] (N n : ℕ) (a : Fin (N + 1))
    (Λ : Submodule K (Fin (N + 1) → K)) (w : Fin (N + 1) → Fin (N + 1) → K) (ξ ξ' : Fin (N + 1) → K)
    (e lam : Fin n → Fin (N + 1) → K) (hξΛ : ξ ∈ Λ) (hξ'Λ : ξ' ∈ Λ) (hξa : ξ a = 1)
    (he : ∀ k, e k ∈ Λ ∧ e k a = 0)
    (hdec : ∀ η ∈ Λ, η = η a • ξ + ∑ k, (∑ p, lam k p * η p) • e k)
    (hB : ∀ η ∈ Λ, ∑ p, ∑ q, w p q * (ξ p * η q + η p * ξ q) = 0)
    (hB' : ∀ η ∈ Λ, ∑ p, ∑ q, w p q * (ξ' p * η q + η p * ξ' q) = 0)
    (hnp : ¬ ∀ i, ξ' i = ξ' a * ξ i) :
    ((Matrix.of fun k l => ∑ p, ∑ q, w p q * e k p * e l q) +
      (Matrix.of fun k l => ∑ p, ∑ q, w p q * e k p * e l q).transpose).det = 0 :=
by
  classical
  obtain ⟨v, hv⟩ : ∃ v : Fin (N + 1) → K, v = ξ' - ξ' a • ξ := ⟨_, rfl⟩
  have hvi : ∀ i, v i = ξ' i - ξ' a * ξ i := by
    intro i; rw [hv]; simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
  have hvΛ : v ∈ Λ := by rw [hv]; exact Λ.sub_mem hξ'Λ (Λ.smul_mem _ hξΛ)
  have hva : v a = 0 := by rw [hvi, hξa, mul_one, sub_self]
  have hv0 : v ≠ 0 := by
    intro h0
    apply hnp
    intro i
    have h1 := hvi i
    rw [h0, Pi.zero_apply] at h1
    exact (sub_eq_zero.mp h1.symm)
  obtain ⟨c, hc⟩ : ∃ c : Fin n → K, c = fun k => ∑ p, lam k p * v p := ⟨_, rfl⟩
  have hvq : ∀ q, v q = ∑ l, c l * e l q := by
    intro q
    have h := congrFun (hdec v hvΛ) q
    simp only [Pi.add_apply, Pi.smul_apply, Finset.sum_apply, smul_eq_mul, hva, zero_mul,
      zero_add] at h
    rw [h, hc]
  have hc0 : c ≠ 0 := by
    intro h0
    apply hv0
    funext q
    rw [hvq q, h0]
    simp
  have hBv : ∀ k, ∑ p, ∑ q, w p q * (v p * e k q + e k p * v q) = 0 := by
    intro k
    have h1 := hB' (e k) (he k).1
    have h2 := hB (e k) (he k).1
    have h3 : ∑ p, ∑ q, w p q * (v p * e k q + e k p * v q) =
        ∑ p, ∑ q, w p q * (ξ' p * e k q + e k p * ξ' q) -
          ξ' a * ∑ p, ∑ q, w p q * (ξ p * e k q + e k p * ξ q) := by
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun p _ => ?_
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun q _ => ?_
      rw [hvi p, hvi q]
      ring
    rw [h3, h1, h2, mul_zero, sub_zero]
  have hmul : ∀ k, (((Matrix.of fun k l => ∑ p, ∑ q, w p q * e k p * e l q) +
      (Matrix.of fun k l => ∑ p, ∑ q, w p q * e k p * e l q).transpose).mulVec c) k =
      ∑ p, ∑ q, w p q * (e k p * (∑ l, c l * e l q) + (∑ l, c l * e l p) * e k q) := by
    intro k
    simp only [Matrix.mulVec, dotProduct, Matrix.add_apply, Matrix.transpose_apply,
      Matrix.of_apply, add_mul, mul_add, Finset.sum_mul, Finset.mul_sum, Finset.sum_add_distrib]
    congr 1
    · rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun p _ => ?_
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun q _ => ?_
      refine Finset.sum_congr rfl fun l _ => ?_
      ring
    · rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun p _ => ?_
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun q _ => ?_
      refine Finset.sum_congr rfl fun l _ => ?_
      ring
  apply Matrix.exists_mulVec_eq_zero_iff.mp
  refine ⟨c, hc0, ?_⟩
  funext k
  rw [hmul k, Pi.zero_apply]
  simp only [← hvq]
  rw [← hBv k]
  refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => ?_
  ring

theorem wc_ldp_lin_normal_form (K : Type u) [Field K] [IsAlgClosed K] (N n : ℕ)
    (X : Over (Spec (.of K))) [IsProper X.hom]
    [SmoothOfRelativeDimension n X.hom] (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι)
    (hιX : ι ≫ wcProjKStr K N = X.hom) (hL : wcLdpLin K N n ι)
    (H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2) (x x' : X.left)
    (hx : IsClosed ({x} : Set X.left)) (hx' : IsClosed ({x'} : Set X.left)) (hne : x ≠ x')
    (hsx : wcLdpSing2 K N ι H x) (hsx' : wcLdpSing2 K N ι H x') :
    ∃ (a : Fin (N + 1)) (ha : x ∈ ι ⁻¹ᵁ wcSgD K N a) (t : Fin n → X.left.presheaf.stalk x)
      (c : Matrix (Fin n) (Fin n) K),
      IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) = Ideal.span (Set.range t) ∧
      wcLdpGerm K N ι H a x ha =
        ∑ i, ∑ j, wcLdpConst K X.hom x (c i j) * t i * t j ∧
      (c + c.transpose).det = 0 :=
by
  classical
  haveI : LocallyOfFiniteType X.hom := inferInstance

  obtain ⟨w, rfl⟩ := wc_ldp_lnf_quad_surj K N H
  obtain ⟨Λ, hΛ, hlin0⟩ := hL

  have CG := fun (a : Fin (N + 1)) (y : X.left) (hy : y ∈ ι ⁻¹ᵁ wcSgD K N a) =>
    wc_ldp_lnf_chart_germ K N X ι hιX (wc_ldp_il_proj_const K N) (wc_ldp_lnf_sec_quad K N) a y hy

  have pt : ∀ (y : X.left) (hy0 : IsClosed ({y} : Set X.left)) (b : Fin (N + 1))
      (hb : y ∈ ι ⁻¹ᵁ wcSgD K N b), wcLdpSing2 K N ι (wcLdpQuad K N w) y →
      ∃ (ξ : Fin (N + 1) → K) (e lam : Fin n → Fin (N + 1) → K),
        (∀ i, (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N b) y hb).hom
            ((ι.app (wcSgD K N b)).hom (wcSgE K N b i)) -
          wcLdpConst K X.hom y (ξ i) ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk y)) ∧
        ξ ∈ Λ ∧ ξ b = 1 ∧ (∀ k, e k ∈ Λ ∧ e k b = 0) ∧
        (∀ η ∈ Λ, η = η b • ξ + ∑ k, (∑ p, lam k p * η p) • e k) ∧
        IsLocalRing.maximalIdeal (X.left.presheaf.stalk y) = Ideal.span (Set.range fun k =>
          ∑ p, wcLdpConst K X.hom y (lam k p) *
            ((X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N b) y hb).hom
              ((ι.app (wcSgD K N b)).hom (wcSgE K N b p)) - wcLdpConst K X.hom y (ξ p))) ∧
        wcLdpGerm K N ι (wcLdpQuad K N w) b y hb =
          ∑ k, ∑ l, wcLdpConst K X.hom y (∑ p, ∑ q, w p q * e k p * e l q) *
            (∑ p, wcLdpConst K X.hom y (lam k p) *
              ((X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N b) y hb).hom
                ((ι.app (wcSgD K N b)).hom (wcSgE K N b p)) - wcLdpConst K X.hom y (ξ p))) *
            (∑ p, wcLdpConst K X.hom y (lam l p) *
              ((X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N b) y hb).hom
                ((ι.app (wcSgD K N b)).hom (wcSgE K N b p)) - wcLdpConst K X.hom y (ξ p))) ∧
        ∀ η ∈ Λ, ∑ p, ∑ q, w p q * (ξ p * η q + η p * ξ q) = 0 := by
    intro y hy0 b hb hs
    obtain ⟨hA, hB⟩ := wc_ldp_loc_cotangent K X.hom n y hy0
    choose ξ hξ using fun i => hA ((X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N b) y hb).hom
      ((ι.app (wcSgD K N b)).hom (wcSgE K N b i)))
    obtain ⟨hcy, hUb, hgerm, hlinf⟩ := CG b y hb
    have hlin : ∀ ℓ : Fin (N + 1) → K, (∀ η ∈ Λ, ∑ p, ℓ p * η p = 0) →
        ∑ p, wcLdpConst K X.hom y (ℓ p) * (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N b) y hb).hom
          ((ι.app (wcSgD K N b)).hom (wcSgE K N b p)) = 0 := by
      intro ℓ hℓ
      rw [← hlinf ℓ, hlin0 ℓ hℓ b, map_zero]
    obtain ⟨hξb, hξΛ, hann⟩ := wc_ldp_lnf_res_mem K (X.left.presheaf.stalk y)
      (wcLdpConst K X.hom y) N b Λ _ ξ hUb hξ hlin
    obtain ⟨e, lam, he, hdec, hvid⟩ := wc_ldp_lnf_basis K (X.left.presheaf.stalk y)
      (wcLdpConst K X.hom y) N n b Λ hΛ ξ hξΛ hξb
    have hv := hvid (fun i => (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N b) y hb).hom
        ((ι.app (wcSgD K N b)).hom (wcSgE K N b i)) - wcLdpConst K X.hom y (ξ i))
      (by simp only [hUb, hξb, map_one, sub_self]) hann
    have hgen := wc_ldp_lnf_stalk_gen K N X ι hι b y hb hcy
      (wc_ldp_il_proj_stalk_frac K N b (ι y) hb) (wc_away_X_closure_top K N b) ξ hξ
    have hsing : ∑ p, ∑ q, wcLdpConst K X.hom y (w p q) *
        (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N b) y hb).hom
          ((ι.app (wcSgD K N b)).hom (wcSgE K N b p)) *
        (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N b) y hb).hom
          ((ι.app (wcSgD K N b)).hom (wcSgE K N b q)) ∈
        IsLocalRing.maximalIdeal (X.left.presheaf.stalk y) ^ 2 := by
      rw [← hgerm w]
      exact hs b hb
    obtain ⟨h1, h2, h3⟩ := wc_ldp_lnf_point_alg K (X.left.presheaf.stalk y)
      (wcLdpConst K X.hom y) N n b Λ w _ ξ e lam hξΛ hξb he hdec hv hgen hsing hB
    exact ⟨ξ, e, lam, hξ, hξΛ, hξb, he, hdec, h1, (hgerm w).trans h2, h3⟩

  have hcov : ∀ p : wcProjK K N, ∃ a : Fin (N + 1), p ∈ wcSgD K N a := by
    intro p
    have hY : (⨆ j : Fin (N + 1), Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X j)) = ⊤ := by
      apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
      intro f hf
      have hf' := (HomogeneousIdeal.mem_irrelevant_iff _ f).mp hf
      have h0 : MvPolynomial.homogeneousComponent 0 f = 0 := by
        rw [← MvPolynomial.decomposition.decompose'_apply]
        exact hf'
      rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.mp hm) h0
      obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨l, Set.mem_univ _, hl⟩
    have hp : p ∈ (⨆ j : Fin (N + 1), Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X j)) := by
      rw [hY]; trivial
    exact TopologicalSpace.Opens.mem_iSup.mp hp
  obtain ⟨a, ha0⟩ := hcov (ι x)
  obtain ⟨b, hb0⟩ := hcov (ι x')
  have ha : x ∈ ι ⁻¹ᵁ wcSgD K N a := ha0
  have hb : x' ∈ ι ⁻¹ᵁ wcSgD K N b := hb0
  obtain ⟨ξ, e, lam, hξ, hξΛ, hξa, he, hdec, hm, hg, hB⟩ := pt x hx a ha hsx
  obtain ⟨ξ', e', lam', hξ', hξ'Λ, hξ'b, -, -, -, -, hB'⟩ := pt x' hx' b hb hsx'
  refine ⟨a, ha, fun k => ∑ p, wcLdpConst K X.hom x (lam k p) *
      ((X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) x ha).hom
        ((ι.app (wcSgD K N a)).hom (wcSgE K N a p)) - wcLdpConst K X.hom x (ξ p)),
    Matrix.of fun k l => ∑ p, ∑ q, w p q * e k p * e l q, hm, hg, ?_⟩

  by_cases hprop : ∀ i, ξ' i = ξ' a * ξ i
  · exfalso
    have hξ'a : ξ' a ≠ 0 := by
      intro h0
      have h1 := hprop b
      rw [h0, zero_mul, hξ'b] at h1
      exact one_ne_zero h1
    obtain ⟨ha', hres⟩ := wc_ldp_lnf_chart_change K N X ι a b x' hb ξ' hξ' hξ'a
    have hres' : ∀ i, (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) x' ha').hom
        ((ι.app (wcSgD K N a)).hom (wcSgE K N a i)) - wcLdpConst K X.hom x' (ξ i) ∈
        IsLocalRing.maximalIdeal (X.left.presheaf.stalk x') := by
      intro i
      have e1 : ξ' i / ξ' a = ξ i := by
        rw [hprop i]
        field_simp
      have h1 := hres i
      rw [e1] at h1
      exact h1
    have hW : IsAffineOpen (wcSgD K N a) :=
      Proj.isAffineOpen_basicOpen _ _
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a)) one_pos
    exact hne (wc_ldp_lnf_chart_sep K N X ι hι a (wc_away_X_closure_top K N a)
      (fun p p' hp hp' => wc_affine_closed_point_separation (wcProjK K N) (wcSgD K N a) hW p p' hp hp')
      x x' ha ha' hx (CG a x ha).1 (CG a x' ha').1 ξ hξ hres')
  · exact wc_ldp_lnf_gram K N n a Λ w ξ ξ' e lam hξΛ hξ'Λ hξa he hdec hB hB' hprop

theorem wc_ldp_linear_odp_contra (K : Type u) [Field K] [IsAlgClosed K] (N n : ℕ) (hn2 : 2 ≤ n)
    (X : Over (Spec (.of K))) [GeometricallyIrreducible X.hom] [IsProper X.hom]
    [SmoothOfRelativeDimension n X.hom] (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι)
    (hιX : ι ≫ wcProjKStr K N = X.hom) (hL : wcLdpLin K N n ι)
    (H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2) (x x' : X.left)
    (hx : IsClosed ({x} : Set X.left)) (hx' : IsClosed ({x'} : Set X.left)) (hne : x ≠ x')
    (hsx : wcLdpSing2 K N ι H x) (hsx' : wcLdpSing2 K N ι H x') :
    ¬ wcLdpODPAt K N n ι H x :=
by
  classical
  intro hodp
  obtain ⟨a, ha, t, c, ht, hg, hc⟩ :=
    wc_ldp_lin_normal_form K N n X ι hι hιX hL H x x' hx hx' hne hsx hsx'
  obtain ⟨t', A, ht', h3, hu⟩ := hodp a ha
  obtain ⟨hres, hind⟩ := wc_ldp_loc_cotangent K X.hom n x hx
  letI := (wcLdpConst K X.hom x).toAlgebra
  obtain ⟨hfs, -⟩ := wc_ldp_il_stalk_of_smooth_field K X.hom n x
  haveI := hfs
  rw [hg] at h3
  exact wc_ldp_odp_congr_degenerate K (X.left.presheaf.stalk x) hres n t ht (hind t ht) c hc t' A ht'
    h3 hu

theorem wc_ldp_cf_uniform_transition (E : Type u) [Field E] (N : ℕ) {W : Scheme.{u}}
    (κ : W ⟶ wcProjK E N) (a b : Fin (N + 1)) (w : W)
    (hwa : w ∈ κ ⁻¹ᵁ wcSgD E N a) (hwb : w ∈ κ ⁻¹ᵁ wcSgD E N b) :
    ∃ u : W.presheaf.stalk w, IsUnit u ∧
      ∀ H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2,
        wcLdpGerm E N κ H a w hwa = u * wcLdpGerm E N κ H b w hwb :=
by
  classical
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) :=
    MvPolynomial.gradedAlgebra

  have hXa : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) E) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X E a)
  have hXb : (MvPolynomial.X b : MvPolynomial (Fin (N + 1)) E) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X E b)
  have hx : (MvPolynomial.X a * MvPolynomial.X b : MvPolynomial (Fin (N + 1)) E) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2 :=
    (MvPolynomial.mem_homogeneousSubmodule 2 _).mpr
      ((MvPolynomial.isHomogeneous_X E a).mul (MvPolynomial.isHomogeneous_X E b))
  have h4a : (MvPolynomial.X a ^ 4 : MvPolynomial (Fin (N + 1)) E) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E (2 • 2) := by
    rw [show (2 • 2 : ℕ) = 4 from rfl]
    exact (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X_pow a 4)
  have h4b : (MvPolynomial.X b ^ 4 : MvPolynomial (Fin (N + 1)) E) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E (2 • 2) := by
    rw [show (2 • 2 : ℕ) = 4 from rfl]
    exact (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X_pow b 4)
  have hle_a : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
      (MvPolynomial.X a * MvPolynomial.X b) ≤ wcSgD E N a := fun y hy =>
    ((Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) _ _).le hy).1
  have hle_b : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
      (MvPolynomial.X a * MvPolynomial.X b) ≤ wcSgD E N b := fun y hy =>
    ((Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) _ _).le hy).2
  have c2 : HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
        hx 2 (MvPolynomial.X b ^ 4) h4b *
      HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
        hx 2 (MvPolynomial.X a ^ 4) h4a = 1 := by
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one,
      Localization.mk_mul, ← Localization.mk_one, Localization.mk_eq_mk_iff]
    apply Localization.r_of_eq
    simp only [Submonoid.coe_mul, OneMemClass.coe_one]
    ring
  have e : wcSgD E N a ⊓ wcSgD E N b ≤
      Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
        (MvPolynomial.X a * MvPolynomial.X b) :=
    (Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) _ _).ge
  have kl : ∀ s : Γ(wcProjK E N, wcSgD E N a),
      ((wcProjK E N).presheaf.map (homOfLE (inf_le_left : wcSgD E N a ⊓ wcSgD E N b ≤
          wcSgD E N a)).op).hom s =
        ((wcProjK E N).presheaf.map (homOfLE e).op).hom
          (((wcProjK E N).presheaf.map (homOfLE hle_a).op).hom s) := fun s =>
    congrArg (fun φ => φ.hom s) ((wcProjK E N).presheaf.map_comp (homOfLE hle_a).op (homOfLE e).op)
  have kr : ∀ s : Γ(wcProjK E N, wcSgD E N b),
      ((wcProjK E N).presheaf.map (homOfLE (inf_le_right : wcSgD E N a ⊓ wcSgD E N b ≤
          wcSgD E N b)).op).hom s =
        ((wcProjK E N).presheaf.map (homOfLE e).op).hom
          (((wcProjK E N).presheaf.map (homOfLE hle_b).op).hom s) := fun s =>
    congrArg (fun φ => φ.hom s) ((wcProjK E N).presheaf.map_comp (homOfLE hle_b).op (homOfLE e).op)
  set r := ((wcProjK E N).presheaf.map (homOfLE e).op).hom with hr
  set T := (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
        (MvPolynomial.X a * MvPolynomial.X b)).hom with hT

  obtain ⟨v, hvdef⟩ : ∃ v : Γ(wcProjK E N, wcSgD E N a ⊓ wcSgD E N b),
      v = r (T (HomogeneousLocalization.Away.mk _ hx 2 (MvPolynomial.X b ^ 4) h4b)) := ⟨_, rfl⟩
  have hv : IsUnit v := by
    rw [hvdef]
    refine ⟨⟨_, r (T (HomogeneousLocalization.Away.mk _ hx 2 (MvPolynomial.X a ^ 4) h4a)),
      ?_, ?_⟩, rfl⟩
    · rw [← map_mul r, ← map_mul T, c2, map_one, map_one]
    · rw [← map_mul r, ← map_mul T, mul_comm (HomogeneousLocalization.Away.mk _ hx 2
        (MvPolynomial.X a ^ 4) h4a), c2, map_one, map_one]

  have hrel : ∀ H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2,
      ((wcProjK E N).presheaf.map (homOfLE (inf_le_left : wcSgD E N a ⊓ wcSgD E N b ≤
          wcSgD E N a)).op).hom (wcLdpSec E N H a) =
        v * ((wcProjK E N).presheaf.map (homOfLE (inf_le_right : wcSgD E N a ⊓ wcSgD E N b ≤
          wcSgD E N b)).op).hom (wcLdpSec E N H b) := by
    intro H
    have hA : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
          (MvPolynomial.X a * MvPolynomial.X b)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
            hXb (rfl : MvPolynomial.X a * MvPolynomial.X b = MvPolynomial.X a * MvPolynomial.X b)
            (HomogeneousLocalization.Away.mk _ hXa 2 (H : MvPolynomial (Fin (N + 1)) E) H.2)) =
        ((wcProjK E N).presheaf.map (homOfLE hle_a).op).hom (wcLdpSec E N H a) :=
      congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) hXa 2
        (H : MvPolynomial (Fin (N + 1)) E) H.2))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
        (f := MvPolynomial.X a) hXb (x := MvPolynomial.X a * MvPolynomial.X b) rfl)
    have hB : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
          (MvPolynomial.X a * MvPolynomial.X b)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
            hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
            (HomogeneousLocalization.Away.mk _ hXb 2 (H : MvPolynomial (Fin (N + 1)) E) H.2)) =
        ((wcProjK E N).presheaf.map (homOfLE hle_b).op).hom (wcLdpSec E N H b) :=
      congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) hXb 2
        (H : MvPolynomial (Fin (N + 1)) E) H.2))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
        (f := MvPolynomial.X b) hXa (x := MvPolynomial.X a * MvPolynomial.X b)
        (mul_comm (MvPolynomial.X a) (MvPolynomial.X b)))
    have c1 : HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
          hXb (rfl : MvPolynomial.X a * MvPolynomial.X b = MvPolynomial.X a * MvPolynomial.X b)
          (HomogeneousLocalization.Away.mk _ hXa 2 (H : MvPolynomial (Fin (N + 1)) E) H.2) =
        HomogeneousLocalization.Away.mk _ hx 2 (MvPolynomial.X b ^ 4) h4b *
        HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) hXa
          (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
          (HomogeneousLocalization.Away.mk _ hXb 2 (H : MvPolynomial (Fin (N + 1)) E) H.2) := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.mk_mul, Localization.mk_eq_mk_iff]
      apply Localization.r_of_eq
      simp only [Submonoid.coe_mul]
      ring
    rw [kl, kr, ← hA, ← hB, c1, map_mul T, map_mul r, hvdef]

  obtain ⟨V, hVdef⟩ : ∃ V : Γ(W, κ ⁻¹ᵁ wcSgD E N a ⊓ κ ⁻¹ᵁ wcSgD E N b),
      V = (κ.app (wcSgD E N a ⊓ wcSgD E N b)).hom v := ⟨_, rfl⟩
  have hV : IsUnit V := by
    rw [hVdef]
    exact hv.map _
  have hpull : ∀ H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2,
      (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD E N a ⊓ κ ⁻¹ᵁ wcSgD E N b ≤
          κ ⁻¹ᵁ wcSgD E N a)).op).hom ((κ.app (wcSgD E N a)).hom (wcLdpSec E N H a)) =
        V * (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD E N a ⊓ κ ⁻¹ᵁ wcSgD E N b ≤
          κ ⁻¹ᵁ wcSgD E N b)).op).hom ((κ.app (wcSgD E N b)).hom (wcLdpSec E N H b)) := by
    intro H
    have el : (κ.app (wcSgD E N a ⊓ wcSgD E N b)).hom
        (((wcProjK E N).presheaf.map (homOfLE (inf_le_left : wcSgD E N a ⊓ wcSgD E N b ≤
            wcSgD E N a)).op).hom (wcLdpSec E N H a)) =
        (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD E N a ⊓ κ ⁻¹ᵁ wcSgD E N b ≤
            κ ⁻¹ᵁ wcSgD E N a)).op).hom ((κ.app (wcSgD E N a)).hom (wcLdpSec E N H a)) :=
      congrArg (fun φ => φ.hom (wcLdpSec E N H a))
        (Scheme.Hom.naturality κ (homOfLE (inf_le_left : wcSgD E N a ⊓ wcSgD E N b ≤
            wcSgD E N a)).op)
    have er : (κ.app (wcSgD E N a ⊓ wcSgD E N b)).hom
        (((wcProjK E N).presheaf.map (homOfLE (inf_le_right : wcSgD E N a ⊓ wcSgD E N b ≤
            wcSgD E N b)).op).hom (wcLdpSec E N H b)) =
        (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD E N a ⊓ κ ⁻¹ᵁ wcSgD E N b ≤
            κ ⁻¹ᵁ wcSgD E N b)).op).hom ((κ.app (wcSgD E N b)).hom (wcLdpSec E N H b)) :=
      congrArg (fun φ => φ.hom (wcLdpSec E N H b))
        (Scheme.Hom.naturality κ (homOfLE (inf_le_right : wcSgD E N a ⊓ wcSgD E N b ≤
            wcSgD E N b)).op)
    rw [hVdef, ← el, hrel H, map_mul, er]
    rfl

  have hw : w ∈ κ ⁻¹ᵁ wcSgD E N a ⊓ κ ⁻¹ᵁ wcSgD E N b := ⟨hwa, hwb⟩
  refine ⟨(W.presheaf.germ (κ ⁻¹ᵁ wcSgD E N a ⊓ κ ⁻¹ᵁ wcSgD E N b) w hw).hom V,
    hV.map _, fun H => ?_⟩
  have gl : (W.presheaf.germ (κ ⁻¹ᵁ wcSgD E N a ⊓ κ ⁻¹ᵁ wcSgD E N b) w hw).hom
      ((W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD E N a ⊓ κ ⁻¹ᵁ wcSgD E N b ≤
          κ ⁻¹ᵁ wcSgD E N a)).op).hom ((κ.app (wcSgD E N a)).hom (wcLdpSec E N H a))) =
      (W.presheaf.germ (κ ⁻¹ᵁ wcSgD E N a) w hwa).hom
        ((κ.app (wcSgD E N a)).hom (wcLdpSec E N H a)) :=
    congrArg (fun φ => φ.hom ((κ.app (wcSgD E N a)).hom (wcLdpSec E N H a)))
      (W.presheaf.germ_res (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD E N a ⊓ κ ⁻¹ᵁ wcSgD E N b ≤
          κ ⁻¹ᵁ wcSgD E N a)) w hw)
  have gr : (W.presheaf.germ (κ ⁻¹ᵁ wcSgD E N a ⊓ κ ⁻¹ᵁ wcSgD E N b) w hw).hom
      ((W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD E N a ⊓ κ ⁻¹ᵁ wcSgD E N b ≤
          κ ⁻¹ᵁ wcSgD E N b)).op).hom ((κ.app (wcSgD E N b)).hom (wcLdpSec E N H b))) =
      (W.presheaf.germ (κ ⁻¹ᵁ wcSgD E N b) w hwb).hom
        ((κ.app (wcSgD E N b)).hom (wcLdpSec E N H b)) :=
    congrArg (fun φ => φ.hom ((κ.app (wcSgD E N b)).hom (wcLdpSec E N H b)))
      (W.presheaf.germ_res (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD E N a ⊓ κ ⁻¹ᵁ wcSgD E N b ≤
          κ ⁻¹ᵁ wcSgD E N b)) w hw)
  have h5 := congrArg (W.presheaf.germ (κ ⁻¹ᵁ wcSgD E N a ⊓ κ ⁻¹ᵁ wcSgD E N b) w hw).hom
    (hpull H)
  rw [map_mul, gl, gr] at h5
  exact h5

theorem wc_ldp_dgc_chart_presentation (K : Type u) [Field K] [IsAlgClosed K] (N n : ℕ)
    (X : Over (Spec (.of K))) [SmoothOfRelativeDimension n X.hom] (ι : X.left ⟶ wcProjK K N)
    (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr K N = X.hom) (a : Fin (N + 1)) :
    ∃ I : Ideal (MvPolynomial (Fin (N + 1)) K),
      ringKrullDim (MvPolynomial (Fin (N + 1)) K ⧸ I) ≤ (n : WithBot ℕ∞) ∧
      ∀ (x : X.left) (hx : x ∈ ι ⁻¹ᵁ wcSgD K N a), IsClosed ({x} : Set X.left) →
        ∃ ξ : Fin (N + 1) → K, (∀ g ∈ I, MvPolynomial.eval ξ g = 0) ∧
          ∀ w : Fin (N + 1) → Fin (N + 1) → K,
            wcLdpGerm K N ι (wcLdpQuad K N w) a x hx ∈
                IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ^ 2 ↔
              (wcLdpQuad K N w : MvPolynomial (Fin (N + 1)) K) ∈
                RingHom.ker (MvPolynomial.eval ξ) ^ 2 ⊔ I :=
by
  classical

  have transfer : ∀ (A S : Type u) [CommRing A] [CommRing S] [Algebra A S] (M : Ideal A)
      [M.IsMaximal] [IsLocalization.AtPrime S M] [IsLocalRing S] (r : A),
      algebraMap A S r ∈ IsLocalRing.maximalIdeal S ^ 2 ↔ r ∈ M ^ 2 := by
    intro A S _ _ _ M hM _ _ r
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal M S, ← Ideal.map_pow]
    have hprim : (M ^ 2).IsPrimary := Ideal.isPrimary_of_isMaximal_radical (by
      rw [Ideal.radical_pow M two_ne_zero, hM.isPrime.radical]; exact hM)
    have hdisj : Disjoint (M.primeCompl : Set A) ((M ^ 2 : Ideal A) : Set A) := by
      rw [Set.disjoint_left]
      intro s hs hs2
      exact hs (Ideal.pow_le_self two_ne_zero hs2)
    have hund := IsLocalization.under_map_of_isPrimary_disjoint M.primeCompl S hprim hdisj
    exact SetLike.ext_iff.mp hund r

  have hXa : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 :=
    (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K a)
  obtain ⟨θ₀, hθC, hθX⟩ : ∃ θ₀ : MvPolynomial (Fin (N + 1)) K →+*
      HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X a),
      (∀ c : K, θ₀ (MvPolynomial.C c) = ((HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (Submonoid.powers (MvPolynomial.X a))).comp
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0))) c) ∧
      ∀ i, θ₀ (MvPolynomial.X i) = HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hXa 1 (MvPolynomial.X i)
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i)) :=
    ⟨MvPolynomial.eval₂Hom _ _, fun c => MvPolynomial.eval₂Hom_C _ _ _,
      fun i => MvPolynomial.eval₂Hom_X' _ _ _⟩
  have hθs : Function.Surjective θ₀ := by
    rw [← RingHom.range_eq_top, eq_top_iff, ← wc_away_X_closure_top K N a, Subring.closure_le]
    rintro _ (⟨i, rfl⟩ | ⟨c, rfl⟩)
    · exact RingHom.mem_range.mpr ⟨MvPolynomial.X i, hθX i⟩
    · exact RingHom.mem_range.mpr ⟨MvPolynomial.C c, hθC c⟩
  have hσ : Function.Bijective (Proj.awayToSection
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)).hom := by
    rw [← Proj.basicOpenIsoAway_hom _ _ hXa one_pos]
    exact ConcreteCategory.bijective_of_isIso _
  have hD : IsAffineOpen (wcSgD K N a) := Proj.isAffineOpen_basicOpen _ _ hXa one_pos
  have hρ : Function.Surjective (ι.app (wcSgD K N a)).hom :=
    (isClosedImmersion_iff_isAffineHom.mp hι).2 _ hD
  obtain ⟨Θ, hΘs, hΘq⟩ : ∃ Θ : MvPolynomial (Fin (N + 1)) K →+* Γ(X.left, ι ⁻¹ᵁ wcSgD K N a),
      Function.Surjective Θ ∧ ∀ w : Fin (N + 1) → Fin (N + 1) → K,
        Θ (wcLdpQuad K N w : MvPolynomial (Fin (N + 1)) K) =
          (ι.app (wcSgD K N a)).hom (wcLdpSec K N (wcLdpQuad K N w) a) := by
    refine ⟨(ι.app (wcSgD K N a)).hom.comp ((Proj.awayToSection
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)).hom.comp θ₀),
      hρ.comp (hσ.2.comp hθs), fun w => ?_⟩
    rw [RingHom.comp_apply, RingHom.comp_apply, (wc_ldp_lnf_sec_quad K N a w).2]
    refine congrArg (ι.app (wcSgD K N a)).hom ?_
    show (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X a)).hom (θ₀ (∑ p, ∑ q, MvPolynomial.C (w p q) *
          (MvPolynomial.X p * MvPolynomial.X q))) = _
    simp only [map_sum, map_mul, hθC, hθX]
    refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => ?_
    rw [mul_assoc]
    rfl

  haveI : IsAffineHom ι := (isClosedImmersion_iff_isAffineHom.mp hι).1
  have hU : IsAffineOpen (ι ⁻¹ᵁ wcSgD K N a) := hD.preimage ι

  haveI : Smooth X.hom := SmoothOfRelativeDimension.smooth n X.hom
  haveI : JacobsonSpace X.left := LocallyOfFiniteType.jacobsonSpace X.hom
  haveI := hU.isOpenImmersion_fromSpec
  have hdimU : ringKrullDim Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) ≤ (n : WithBot ℕ∞) := by
    rw [ringKrullDim_le_iff_height_le]
    intro p hp
    obtain ⟨M, hM, hpM⟩ := Ideal.exists_le_maximal p hp.ne_top
    refine le_trans (WithBot.coe_le_coe.mpr (Ideal.height_mono hpM)) ?_
    obtain ⟨pt, hpt⟩ : ∃ pt : PrimeSpectrum Γ(X.left, ι ⁻¹ᵁ wcSgD K N a), pt.asIdeal = M :=
      ⟨⟨M, hM.isPrime⟩, rfl⟩
    subst hpt
    have hyU : hU.fromSpec pt ∈ ι ⁻¹ᵁ wcSgD K N a := by
      rw [← SetLike.mem_coe, ← hU.range_fromSpec]
      exact ⟨pt, rfl⟩
    have hloc' := hU.isLocalization_stalk' pt hyU
    have hy : IsClosed ({hU.fromSpec pt} : Set X.left) := by
      apply isClosed_singleton_of_isLocallyClosed_singleton
      have h1 : IsLocallyClosed ({pt} : Set (PrimeSpectrum Γ(X.left, ι ⁻¹ᵁ wcSgD K N a))) :=
        ((PrimeSpectrum.isClosed_singleton_iff_isMaximal pt).mpr hM).isLocallyClosed
      have h2 := h1.image hU.fromSpec.isOpenEmbedding.isInducing
        hU.fromSpec.isOpenEmbedding.isOpen_range.isLocallyClosed
      convert h2 using 1
      ext y
      constructor
      · rintro rfl
        exact ⟨pt, Set.mem_singleton pt, rfl⟩
      · rintro ⟨q, hq, rfl⟩
        rw [Set.mem_singleton_iff] at hq
        subst hq
        exact Set.mem_singleton _
    have h3 := wc_lfi_smooth_stalk_dim K X.left X.hom n (hU.fromSpec pt) hy
    have h4 := @IsLocalization.AtPrime.ringKrullDim_eq_height _ _ pt.asIdeal _ _ _
      (TopCat.Presheaf.algebra_section_stalk X.left.presheaf ⟨hU.fromSpec pt, hyU⟩) hloc'
    rw [h4] at h3
    exact h3.le
  refine ⟨RingHom.ker Θ, ?_, ?_⟩
  · rw [ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective hΘs)]
    exact hdimU

  intro x hx hxc
  letI : Algebra Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) (X.left.presheaf.stalk x) :=
    TopCat.Presheaf.algebra_section_stalk X.left.presheaf ⟨x, hx⟩
  obtain ⟨pt, hMmax, hloc⟩ : ∃ pt : PrimeSpectrum Γ(X.left, ι ⁻¹ᵁ wcSgD K N a),
      pt.asIdeal.IsMaximal ∧ IsLocalization.AtPrime (X.left.presheaf.stalk x) pt.asIdeal :=
    ⟨_, hU.primeIdealOf_isMaximal_of_isClosed ⟨x, hx⟩ hxc, hU.isLocalization_stalk ⟨x, hx⟩⟩
  set M := pt.asIdeal with hMdef
  haveI := hMmax
  haveI : (Ideal.comap Θ M).IsMaximal := Ideal.comap_isMaximal_of_surjective Θ hΘs
  obtain ⟨ξ, hξ⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp this
  have hker : Ideal.comap Θ M = RingHom.ker (MvPolynomial.eval ξ) := by
    rw [hξ]
    ext p
    rw [MvPolynomial.mem_vanishingIdeal_singleton_iff, RingHom.mem_ker]
    exact Iff.rfl
  have e2 : Ideal.comap Θ (M ^ 2) = Ideal.comap Θ M ^ 2 ⊔ RingHom.ker Θ := by
    conv_lhs => rw [← Ideal.map_comap_of_surjective Θ hΘs M]
    rw [← Ideal.map_pow, Ideal.comap_map_of_surjective Θ hΘs, ← RingHom.ker_eq_comap_bot]
  refine ⟨ξ, fun g hg => ?_, fun w => ?_⟩
  · have hgM : g ∈ Ideal.comap Θ M := by
      rw [Ideal.mem_comap, RingHom.mem_ker.mp hg]
      exact M.zero_mem
    rw [hker] at hgM
    exact RingHom.mem_ker.mp hgM
  · have key := @transfer _ _ _ _ _ M hMmax hloc _
      (Θ (wcLdpQuad K N w : MvPolynomial (Fin (N + 1)) K))
    refine Iff.trans ?_ (key.trans ?_)
    · unfold wcLdpGerm
      rw [hΘq w]
      exact Iff.rfl
    · rw [← hker, ← e2]
      exact Iff.rfl

theorem wc_ldp_dgc_jet_strata (K : Type u) [Field K] (N e : ℕ)
    (I : Ideal (MvPolynomial (Fin (N + 1)) K))
    (hI : ringKrullDim (MvPolynomial (Fin (N + 1)) K ⧸ I) ≤ (e : WithBot ℕ∞)) :
    ∃ (T : ℕ) (C : Fin T → Type u) (_ : ∀ t, CommRing (C t)) (_ : ∀ t, Algebra K (C t))
      (_ : ∀ t, Algebra.FiniteType K (C t)) (k : Fin T → ℕ)
      (ℓ : ∀ t, Matrix (Fin (k t)) (Fin (N + 1) × Fin (N + 1)) (C t)),
      (∀ t, ringKrullDim (C t) ≤ (e : WithBot ℕ∞)) ∧
      ∀ ξ : Fin (N + 1) → K, (∀ g ∈ I, MvPolynomial.eval ξ g = 0) →
        ∃ (t : Fin T) (χ : C t →ₐ[K] K), ∀ w : Fin (N + 1) → Fin (N + 1) → K,
          ((ℓ t).map χ).mulVec (fun q => w q.1 q.2) = 0 ↔
            (wcLdpQuad K N w : MvPolynomial (Fin (N + 1)) K) ∈
              RingHom.ker (MvPolynomial.eval ξ) ^ 2 ⊔ I :=
by
  classical

  have hlin : ∀ (Φ : MvPolynomial (Fin (N + 1)) K →ₗ[K] K) (w : Fin (N + 1) → Fin (N + 1) → K),
      ∑ q : Fin (N + 1) × Fin (N + 1), Φ (MvPolynomial.X q.1 * MvPolynomial.X q.2) * w q.1 q.2 =
        Φ (wcLdpQuad K N w : MvPolynomial (Fin (N + 1)) K) := by
    intro Φ w
    show _ = Φ (∑ p, ∑ q, MvPolynomial.C (w p q) * (MvPolynomial.X p * MvPolynomial.X q))
    simp only [map_sum, MvPolynomial.C_mul', LinearMap.map_smul, smul_eq_mul]
    rw [Fintype.sum_prod_type]
    exact Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => mul_comm _ _

  obtain ⟨s, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (Ideal.fg_of_isNoetherianRing I)
  have hgI : ∀ j, g j ∈ I := fun j => hg ▸ Submodule.subset_span ⟨j, rfl⟩

  have s1 : ∀ (ξ : Fin (N + 1) → K), (∀ j, MvPolynomial.eval ξ (g j) = 0) →
      ∀ f : MvPolynomial (Fin (N + 1)) K,
      f ∈ RingHom.ker (MvPolynomial.eval ξ) ^ 2 ⊔ Ideal.span (Set.range g) ↔
       (MvPolynomial.eval ξ f = 0 ∧ ∃ c : Fin s → K, ∀ i,
          MvPolynomial.eval ξ (MvPolynomial.pderiv i f) =
          ∑ j, c j * MvPolynomial.eval ξ (MvPolynomial.pderiv i (g j))) := by
    open MvPolynomial in
    intro ξ hg f
    have hmem : ∀ a, a ∈ RingHom.ker (eval ξ) ↔ eval ξ a = 0 := fun a => RingHom.mem_ker
    have hA : ∀ a ∈ RingHom.ker (eval ξ) ^ 2, ∀ i, eval ξ (pderiv i a) = 0 := by
      intro a ha i
      rw [sq] at ha
      refine Submodule.mul_induction_on ha ?_ ?_
      · intro x hx y hy
        rw [Derivation.leibniz, map_add, smul_eq_mul, smul_eq_mul, map_mul, map_mul,
          (hmem x).1 hx, (hmem y).1 hy]
        ring
      · intro x y hx hy
        rw [map_add, map_add, hx, hy, add_zero]
    have hℓ : ∀ i, X i - C (ξ i) ∈ RingHom.ker (eval ξ) := fun i => by
      rw [hmem]; simp
    have hB : ∀ h : MvPolynomial (Fin (N+1)) K, h - C (eval ξ h) -
        ∑ i, C (eval ξ (pderiv i h)) * (X i - C (ξ i)) ∈ RingHom.ker (eval ξ) ^ 2 := by
      intro h
      induction h using MvPolynomial.induction_on with
      | C a =>
        simp
      | add p q hp hq =>
        have e : (p + q) - C (eval ξ (p + q)) -
            ∑ i, C (eval ξ (pderiv i (p + q))) * (X i - C (ξ i))
            = (p - C (eval ξ p) - ∑ i, C (eval ξ (pderiv i p)) * (X i - C (ξ i))) +
              (q - C (eval ξ q) - ∑ i, C (eval ξ (pderiv i q)) * (X i - C (ξ i))) := by
          simp only [map_add, add_mul, Finset.sum_add_distrib]
          ring
        rw [e]
        exact add_mem hp hq
      | mul_X p n hp =>
        have hsum : ∑ i, C (eval ξ (pderiv i (p * X n))) * (X i - C (ξ i)) =
            C (ξ n) * ∑ i, C (eval ξ (pderiv i p)) * (X i - C (ξ i)) +
              C (eval ξ p) * (X n - C (ξ n)) := by
          have e : ∀ i, C (eval ξ (pderiv i (p * X n))) * (X i - C (ξ i)) =
              C (ξ n) * (C (eval ξ (pderiv i p)) * (X i - C (ξ i))) +
                (if n = i then C (eval ξ p) * (X i - C (ξ i)) else 0) := by
            intro i
            rw [Derivation.leibniz, pderiv_X]
            by_cases hni : n = i
            · subst hni
              simp only [Pi.single_eq_same, smul_eq_mul, map_add, map_mul, eval_X, mul_one,
                if_true]
              ring
            · simp only [Pi.single_eq_of_ne hni, smul_eq_mul, map_add, map_mul, eval_X,
                mul_zero, map_zero, if_neg hni]
              ring
          rw [Finset.sum_congr rfl (fun i _ => e i), Finset.sum_add_distrib, Finset.mul_sum,
            Finset.sum_ite_eq]
          simp
        have key : p * X n - C (eval ξ (p * X n)) -
            ∑ i, C (eval ξ (pderiv i (p * X n))) * (X i - C (ξ i)) =
            (∑ i, C (eval ξ (pderiv i p)) * (X i - C (ξ i))) * (X n - C (ξ n)) +
              (p - C (eval ξ p) - ∑ i, C (eval ξ (pderiv i p)) * (X i - C (ξ i))) * X n := by
          rw [hsum, map_mul, eval_X, map_mul]
          ring
        rw [key]
        refine add_mem ?_ (Ideal.mul_mem_right _ _ hp)
        rw [sq]
        refine Ideal.mul_mem_mul ?_ (hℓ n)
        exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (hℓ i))
    constructor
    · intro hf
      obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp hf
      obtain ⟨d, rfl⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hz
      have hy0 : eval ξ y = 0 := (hmem y).1 (Ideal.pow_le_self two_ne_zero hy)
      refine ⟨by simp [hy0, hg], fun j => eval ξ (d j), fun i => ?_⟩
      simp [map_sum, Derivation.leibniz, hA y hy i, hg]
    · rintro ⟨hf0, c, hc⟩
      have hmemh := hB (f - ∑ j, C (c j) * g j)
      have e1 : eval ξ (f - ∑ j, C (c j) * g j) = 0 := by simp [hf0, hg]
      have e2 : ∀ i, eval ξ (pderiv i (f - ∑ j, C (c j) * g j)) = 0 := by
        intro i
        simp [map_sum, Derivation.leibniz, hc i]
      simp only [e1, e2, C_0, zero_mul, sub_zero, Finset.sum_const_zero] at hmemh
      exact Submodule.mem_sup.mpr ⟨_, hmemh, _,
        Ideal.mem_span_range_iff_exists_fun.mpr ⟨fun j => C (c j), rfl⟩, sub_add_cancel _ _⟩

  have s2 : ∀ {r : ℕ} (J : Matrix (Fin s) (Fin (N + 1)) K)
      (ρ : Fin r → Fin s) (κ : Fin r → Fin (N + 1)), (J.submatrix ρ κ).det ≠ 0 →
      J.rank ≤ r → ∀ (y : Fin (N + 1) → K),
      (∃ c : Fin s → K, ∀ i, y i = ∑ j, c j * J j i) ↔
        (J.submatrix ρ κ).det • y = Matrix.vecMul (Matrix.vecMul (fun a => y (κ a))
          (J.submatrix ρ κ).adjugate) (J.submatrix ρ id) := by
    intro r J ρ κ hdet hrank y
    set E := J.submatrix ρ κ with hE
    have hvJ : ∀ d : Fin r → K, Matrix.vecMul d (J.submatrix ρ id) = ∑ a, d a • J (ρ a) := by
      intro d; funext i
      simp [Matrix.vecMul, dotProduct, Finset.sum_apply]
    have hvE : ∀ d : Fin r → K, Matrix.vecMul d E = fun b => (∑ a, d a • J (ρ a)) (κ b) := by
      intro d; funext b
      simp [hE, Matrix.vecMul, dotProduct, Finset.sum_apply]
    constructor
    · rintro ⟨c, hc⟩
      set W := Submodule.span K (Set.range J) with hW
      set Wρ := Submodule.span K (Set.range (fun a => J (ρ a))) with hWρ
      have hle : Wρ ≤ W := Submodule.span_mono (by rintro _ ⟨a, rfl⟩; exact ⟨ρ a, rfl⟩)
      have hfW : Module.finrank K W = J.rank := (Matrix.rank_eq_finrank_span_row J).symm
      have hli : LinearIndependent K (fun a => J (ρ a)) := by
        rw [Fintype.linearIndependent_iff]
        intro d hd
        have h0 : Matrix.vecMul d E = 0 := by
          rw [hvE, hd]; rfl
        exact congrFun (Matrix.eq_zero_of_vecMul_eq_zero hdet h0)
      have hfWρ : Module.finrank K Wρ = r := by
        rw [hWρ, finrank_span_eq_card hli, Fintype.card_fin]
      have heq : Wρ = W :=
        Submodule.eq_of_le_of_finrank_le hle (by rw [hfW, hfWρ]; exact hrank)
      have hyW : y ∈ W := by
        refine (Submodule.mem_span_range_iff_exists_fun K).mpr ⟨c, ?_⟩
        funext i
        simp [Finset.sum_apply, hc i]
      rw [← heq] at hyW
      obtain ⟨d, hd⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp hyW
      have hyκ : (fun a => y (κ a)) = Matrix.vecMul d E := by
        rw [hvE, hd]
      rw [hyκ, Matrix.vecMul_vecMul d E E.adjugate, Matrix.mul_adjugate, Matrix.vecMul_smul,
        Matrix.vecMul_one, Matrix.smul_vecMul, hvJ, hd]
    · intro h
      set d : Fin r → K := E.det⁻¹ • Matrix.vecMul (fun a => y (κ a)) E.adjugate with hd
      have hy : y = ∑ a, d a • J (ρ a) := by
        rw [← hvJ, hd, Matrix.smul_vecMul, ← h, smul_smul, inv_mul_cancel₀ hdet, one_smul]
      refine ⟨fun j => ∑ a, if ρ a = j then d a else 0, fun i => ?_⟩
      rw [hy]
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Finset.sum_mul, ite_mul, zero_mul]
      rw [Finset.sum_comm]
      simp

  let Jp : Matrix (Fin s) (Fin (N + 1)) (MvPolynomial (Fin (N + 1)) K) :=
    Matrix.of fun j i => MvPolynomial.pderiv i (g j)
  let Λ : ∀ (r : ℕ), (Fin r → Fin s) → (Fin r → Fin (N + 1)) →
      Matrix (Fin (N + 2)) (Fin (N + 1) × Fin (N + 1)) (MvPolynomial (Fin (N + 1)) K) :=
    fun r ρ κ => Matrix.of fun i q => Fin.cases (motive := fun _ => MvPolynomial (Fin (N + 1)) K)
      (MvPolynomial.X q.1 * MvPolynomial.X q.2)
      (fun i' => (Jp.submatrix ρ κ).det *
          MvPolynomial.pderiv i' (MvPolynomial.X q.1 * MvPolynomial.X q.2) -
        ∑ b, Jp (ρ b) i' * ∑ a, (Jp.submatrix ρ κ).adjugate a b *
          MvPolynomial.pderiv (κ a) (MvPolynomial.X q.1 * MvPolynomial.X q.2)) i
  let S := Σ r : Fin (N + 2), (Fin r → Fin s) × (Fin r → Fin (N + 1))
  let eS : S ≃ Fin (Fintype.card S) := Fintype.equivFin S
  refine ⟨Fintype.card S, fun _ => MvPolynomial (Fin (N + 1)) K ⧸ I, fun _ => inferInstance,
    fun _ => inferInstance, fun _ => inferInstance, fun _ => N + 2,
    fun t => (Λ (eS.symm t).1 (eS.symm t).2.1 (eS.symm t).2.2).map (Ideal.Quotient.mk I),
    fun _ => hI, ?_⟩
  intro ξ hξ
  have hev : ∀ x, MvPolynomial.aeval ξ x = MvPolynomial.eval ξ x := fun x => by
    rw [← MvPolynomial.coe_aeval_eq_eval]; rfl
  let χ : (MvPolynomial (Fin (N + 1)) K ⧸ I) →ₐ[K] K :=
    Ideal.Quotient.liftₐ I (MvPolynomial.aeval ξ) (fun a ha => (hev a).trans (hξ a ha))
  have hχ : ∀ x, χ (Ideal.Quotient.mk I x) = MvPolynomial.eval ξ x := fun x => hev x
  let J0 : Matrix (Fin s) (Fin (N + 1)) K :=
    Matrix.of fun j i => MvPolynomial.eval ξ (MvPolynomial.pderiv i (g j))
  have hr : J0.rank ≤ N + 1 := Matrix.rank_le_width J0
  have hrm : ∃ (rr : Fin J0.rank → Fin s) (cc : Fin J0.rank → Fin (N + 1)),
      (J0.submatrix rr cc).det ≠ 0 := by
    obtain ⟨κ, a, ha, hspan, hli⟩ := exists_linearIndependent' K J0.col
    haveI : Finite κ := Finite.of_injective a ha
    letI : Fintype κ := Fintype.ofFinite κ
    have hrank : J0.rank = Fintype.card κ := by
      rw [Matrix.rank_eq_finrank_span_cols, ← hspan, finrank_span_eq_card hli]
    have hcard : Fintype.card (Fin J0.rank) ≤ Fintype.card κ := by
      rw [Fintype.card_fin]; omega
    obtain ⟨e⟩ := Function.Embedding.nonempty_of_card_le hcard
    let c : Fin J0.rank → Fin (N + 1) := a ∘ e
    have hcli : LinearIndependent K (fun j : Fin J0.rank => fun i : Fin s => J0 i (c j)) :=
      hli.comp e e.injective
    let M : Matrix (Fin s) (Fin J0.rank) K := J0.submatrix id c
    have hW : Submodule.span K (Set.range M) = ⊤ := by
      by_contra hne
      obtain ⟨f, hf0, hfle⟩ :=
        Submodule.exists_le_ker_of_lt_top _ (lt_top_iff_ne_top.mpr hne)
      let v : Fin J0.rank → K := fun j => f (fun k => if j = k then 1 else 0)
      have hfx : ∀ x : Fin J0.rank → K, f x = ∑ j, x j * v j := by
        intro x
        rw [LinearMap.pi_apply_eq_sum_univ f x]
        rfl
      have hrow : ∀ i : Fin s, ∑ j, M i j * v j = 0 := by
        intro i
        rw [← hfx]
        exact LinearMap.mem_ker.mp (hfle (Submodule.subset_span ⟨i, rfl⟩))
      have hsum : ∑ j, v j • (fun i : Fin s => J0 i (c j)) = 0 := by
        funext i
        rw [Finset.sum_apply]
        simp only [Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
        rw [← hrow i]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [mul_comm]
        rfl
      have hv0 := Fintype.linearIndependent_iff.mp hcli v hsum
      apply hf0
      apply LinearMap.ext
      intro x
      rw [hfx]
      simp [v, hv0]
    obtain ⟨κ', b, hb, hspan', hli'⟩ := exists_linearIndependent' K M
    haveI : Finite κ' := hli'.finite
    letI : Fintype κ' := Fintype.ofFinite κ'
    have hcard' : Fintype.card κ' = J0.rank := by
      have h1 := finrank_span_eq_card hli'
      rw [hspan', hW, finrank_top, Module.finrank_fin_fun] at h1
      exact h1.symm
    let e' : Fin J0.rank ≃ κ' := (Fintype.equivFinOfCardEq hcard').symm
    let r : Fin J0.rank → Fin s := b ∘ e'
    have hSli : LinearIndependent K (fun k => (M.submatrix r id) k) :=
      hli'.comp e' e'.injective
    have hU : IsUnit (M.submatrix r id) := Matrix.linearIndependent_rows_iff_isUnit.mp hSli
    exact ⟨r, c, ((Matrix.isUnit_iff_isUnit_det _).mp hU).ne_zero⟩
  obtain ⟨ρ, κ, hdet⟩ := hrm
  let σ : S := ⟨⟨J0.rank, by omega⟩, ρ, κ⟩
  have hM : ((Λ (eS.symm (eS σ)).1 (eS.symm (eS σ)).2.1 (eS.symm (eS σ)).2.2).map
      (Ideal.Quotient.mk I)).map χ = (Λ J0.rank ρ κ).map (MvPolynomial.eval ξ) := by
    rw [Equiv.symm_apply_apply]
    ext i q
    exact hχ _
  refine ⟨eS σ, χ, fun w => ?_⟩
  beta_reduce
  rw [hM]

  set Δ0 := (J0.submatrix ρ κ).det with hΔ0
  set A0 := (J0.submatrix ρ κ).adjugate with hA0
  have hdet' : MvPolynomial.eval ξ (Jp.submatrix ρ κ).det = Δ0 := by
    rw [RingHom.map_det]; rfl
  have hadj : ∀ a b, MvPolynomial.eval ξ ((Jp.submatrix ρ κ).adjugate a b) = A0 a b := by
    intro a b
    exact congrFun (congrFun (RingHom.map_adjugate (MvPolynomial.eval ξ) (Jp.submatrix ρ κ)) a) b
  set y : Fin (N + 1) → K := fun i => MvPolynomial.eval ξ
    (MvPolynomial.pderiv i (wcLdpQuad K N w : MvPolynomial (Fin (N + 1)) K)) with hy
  let Ev : MvPolynomial (Fin (N + 1)) K →ₗ[K] K := (MvPolynomial.aeval ξ).toLinearMap
  let D : Fin (N + 1) → MvPolynomial (Fin (N + 1)) K →ₗ[K] MvPolynomial (Fin (N + 1)) K :=
    fun i => (MvPolynomial.pderiv i).toLinearMap
  have hEvD : ∀ i x, (Ev ∘ₗ D i) x = MvPolynomial.eval ξ (MvPolynomial.pderiv i x) := by
    intro i x
    exact hev _
  have hrow0 : ((Λ J0.rank ρ κ).map (MvPolynomial.eval ξ)).mulVec (fun q => w q.1 q.2) 0 =
      MvPolynomial.eval ξ (wcLdpQuad K N w : MvPolynomial (Fin (N + 1)) K) := by
    have hq : MvPolynomial.eval ξ (wcLdpQuad K N w : MvPolynomial (Fin (N + 1)) K) =
        Ev (wcLdpQuad K N w : MvPolynomial (Fin (N + 1)) K) := (hev _).symm
    rw [hq, ← hlin Ev w]
    simp only [Matrix.mulVec, dotProduct, Matrix.map_apply]
    refine Finset.sum_congr rfl fun q _ => ?_
    simp only [Λ, Matrix.of_apply, Fin.cases_zero]
    exact congrArg (· * w q.1 q.2) (hev _).symm
  have hrowS : ∀ i' : Fin (N + 1),
      ((Λ J0.rank ρ κ).map (MvPolynomial.eval ξ)).mulVec (fun q => w q.1 q.2) i'.succ =
      Δ0 * y i' - ∑ b, J0 (ρ b) i' * ∑ a, A0 a b * y (κ a) := by
    intro i'
    let Φ : MvPolynomial (Fin (N + 1)) K →ₗ[K] K :=
      Δ0 • (Ev ∘ₗ D i') - ∑ b, J0 (ρ b) i' • ∑ a, A0 a b • (Ev ∘ₗ D (κ a))
    have hΦ : ∀ x, Φ x = Δ0 * MvPolynomial.eval ξ (MvPolynomial.pderiv i' x) -
        ∑ b, J0 (ρ b) i' * ∑ a, A0 a b * MvPolynomial.eval ξ (MvPolynomial.pderiv (κ a) x) := by
      intro x
      simp only [Φ, LinearMap.sub_apply, LinearMap.smul_apply, LinearMap.sum_apply,
        hEvD, smul_eq_mul]
    have hRHS : Δ0 * y i' - ∑ b, J0 (ρ b) i' * ∑ a, A0 a b * y (κ a) =
        Φ (wcLdpQuad K N w : MvPolynomial (Fin (N + 1)) K) := (hΦ _).symm
    rw [hRHS, ← hlin Φ w]
    simp only [Matrix.mulVec, dotProduct, Matrix.map_apply]
    refine Finset.sum_congr rfl fun q _ => ?_
    rw [hΦ]
    congr 1
    simp only [Λ, Matrix.of_apply, Fin.cases_succ, map_sub, map_mul, map_sum, hdet', hadj]
    rfl
  have hv : ∀ i, Matrix.vecMul (Matrix.vecMul (fun a => y (κ a)) A0) (J0.submatrix ρ id) i =
      ∑ b, J0 (ρ b) i * ∑ a, A0 a b * y (κ a) := by
    intro i
    simp only [Matrix.vecMul, dotProduct, Matrix.submatrix_apply, id]
    refine Finset.sum_congr rfl fun b _ => ?_
    rw [mul_comm]
    congr 1
    exact Finset.sum_congr rfl fun a _ => mul_comm _ _
  have hg0 : ∀ j, MvPolynomial.eval ξ (g j) = 0 := fun j => hξ _ (hgI j)
  have hiff := (s1 ξ hg0 (wcLdpQuad K N w : MvPolynomial (Fin (N + 1)) K)).trans
    (and_congr_right' (s2 J0 ρ κ hdet le_rfl y))
  have hI' : (RingHom.ker (MvPolynomial.eval ξ) ^ 2 ⊔ I) =
      RingHom.ker (MvPolynomial.eval ξ) ^ 2 ⊔ Ideal.span (Set.range g) := by
    rw [← hg]
  rw [hI']
  refine Iff.trans ?_ hiff.symm
  constructor
  · intro h
    refine ⟨hrow0.symm.trans (congrFun h 0), funext fun i => ?_⟩
    have hi : Δ0 * y i - ∑ b, J0 (ρ b) i * ∑ a, A0 a b * y (κ a) = 0 :=
      (hrowS i).symm.trans (congrFun h i.succ)
    rw [Pi.smul_apply, smul_eq_mul, hv]
    exact sub_eq_zero.mp hi
  · rintro ⟨h0, h1⟩
    funext i
    refine Fin.cases ?_ (fun i' => ?_) i
    · exact hrow0.trans h0
    · have h2 := congrFun h1 i'
      rw [Pi.smul_apply, smul_eq_mul, hv] at h2
      show _ = (0 : K)
      rw [hrowS, h2, sub_self]

theorem wc_ldp_dgc_tensor_dim (K : Type u) [Field K] (R S : Type u) [CommRing R] [CommRing S]
    [Algebra K R] [Algebra K S] [Algebra.FiniteType K R] [Algebra.FiniteType K S] (d d' : ℕ)
    (hR : ringKrullDim R ≤ (d : WithBot ℕ∞)) (hS : ringKrullDim S ≤ (d' : WithBot ℕ∞)) :
    Algebra.FiniteType K (TensorProduct K R S) ∧
      ringKrullDim (TensorProduct K R S) ≤ ((d + d' : ℕ) : WithBot ℕ∞) :=
by
  classical

  have dimLe : ∀ {A B : Type u} [CommRing A] [CommRing B] (f : A →+* B), f.IsIntegral →
      ringKrullDim B ≤ ringKrullDim A := by
    intro A B _ _ f hf
    letI := f.toAlgebra
    show Order.krullDim (PrimeSpectrum B) ≤ Order.krullDim (PrimeSpectrum A)
    refine iSup_le fun p => ?_
    let q : LTSeries (PrimeSpectrum A) :=
      { length := p.length
        toFun := fun i => ⟨Ideal.comap f (p i).asIdeal, Ideal.IsPrime.comap f⟩
        step := fun i => by
          have hlt : p i.castSucc < p i.succ := p.step i
          have hlt' : (p i.castSucc).asIdeal < (p i.succ).asIdeal :=
            hlt
          obtain ⟨x, hxJ, hxI⟩ := SetLike.exists_of_lt hlt'
          have h := Ideal.under_lt_under_of_integral_mem_sdiff (R := A)
            (I := (p i.castSucc).asIdeal) hlt'.le ⟨hxJ, hxI⟩ (hf x)
          show (⟨Ideal.comap f (p i.castSucc).asIdeal, Ideal.IsPrime.comap f⟩ : PrimeSpectrum A) <
            ⟨Ideal.comap f (p i.succ).asIdeal, Ideal.IsPrime.comap f⟩
          exact h }
    exact Order.LTSeries.length_le_krullDim q

  have dimGe : ∀ {A B : Type u} [CommRing A] [CommRing B] (f : A →+* B), f.IsIntegral →
      Function.Injective f → ringKrullDim A ≤ ringKrullDim B := by
    intro A B _ _ f hf hinj
    letI := f.toAlgebra
    haveI : Algebra.IsIntegral A B := ⟨hf⟩
    have key : ∀ p : LTSeries (PrimeSpectrum A), ∃ q : LTSeries (PrimeSpectrum B),
        q.length = p.length ∧ Ideal.comap f q.last.asIdeal = p.last.asIdeal := by
      intro p
      refine RelSeries.inductionOn' (motive := fun p : LTSeries (PrimeSpectrum A) =>
          ∃ q : LTSeries (PrimeSpectrum B),
            q.length = p.length ∧ Ideal.comap f q.last.asIdeal = p.last.asIdeal) ?_ ?_ p
      · intro x
        obtain ⟨Q, -, hQ, hQx⟩ := Ideal.exists_ideal_over_prime_of_isIntegral (S := B)
          x.asIdeal ⊥ (by
            show Ideal.comap f ⊥ ≤ x.asIdeal
            rw [Ideal.comap_bot_of_injective f hinj]
            exact bot_le)
        exact ⟨RelSeries.singleton _ ⟨Q, hQ⟩, rfl, hQx⟩
      · intro p y hy ih
        obtain ⟨q, hql, hqc⟩ := ih
        have hlt : p.last < y := hy
        obtain ⟨Q, hQge, hQ, hQy⟩ := Ideal.exists_ideal_over_prime_of_isIntegral (S := B)
          y.asIdeal q.last.asIdeal (by
            show Ideal.comap f q.last.asIdeal ≤ y.asIdeal
            rw [hqc]
            exact hlt.le)
        have hlt' : q.last < (⟨Q, hQ⟩ : PrimeSpectrum B) := by
          show q.last.asIdeal < Q
          refine lt_of_le_of_ne hQge ?_
          intro heq
          apply hlt.ne
          apply PrimeSpectrum.ext
          rw [← hqc, heq]
          exact hQy
        refine ⟨q.snoc ⟨Q, hQ⟩ hlt', ?_, ?_⟩
        · rw [RelSeries.snoc_length, RelSeries.snoc_length, hql]
        · rw [RelSeries.last_snoc, RelSeries.last_snoc]
          exact hQy
    show Order.krullDim (PrimeSpectrum A) ≤ Order.krullDim (PrimeSpectrum B)
    refine iSup_le fun p => ?_
    obtain ⟨q, hq, -⟩ := key p
    rw [← hq]
    exact Order.LTSeries.length_le_krullDim q

  haveI hFT : Algebra.FiniteType K (TensorProduct K R S) :=
    Algebra.FiniteType.trans (S := R) inferInstance
      (Algebra.FiniteType.baseChange (R := K) (A := S) R)
  refine ⟨hFT, ?_⟩
  by_cases hRs : Subsingleton R
  · haveI : Subsingleton (TensorProduct K R S) := by
      apply subsingleton_of_zero_eq_one
      rw [Algebra.TensorProduct.one_def, Subsingleton.elim (1 : R) 0, TensorProduct.zero_tmul]
    rw [ringKrullDim_eq_bot_of_subsingleton]
    exact bot_le
  by_cases hSs : Subsingleton S
  · haveI : Subsingleton (TensorProduct K R S) := by
      apply subsingleton_of_zero_eq_one
      rw [Algebra.TensorProduct.one_def, Subsingleton.elim (1 : S) 0, TensorProduct.tmul_zero]
    rw [ringKrullDim_eq_bot_of_subsingleton]
    exact bot_le
  rw [not_subsingleton_iff_nontrivial] at hRs hSs
  obtain ⟨e, α, hαi, hαf⟩ := exists_finite_inj_algHom_of_fg K R
  obtain ⟨f, β, hβi, hβf⟩ := exists_finite_inj_algHom_of_fg K S
  have hdimMv : ∀ (ι : Type) [Fintype ι],
      ringKrullDim (MvPolynomial ι K) = ((Fintype.card ι : ℕ) : WithBot ℕ∞) := by
    intro ι _
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field, zero_add,
      ENat.card_eq_coe_fintype_card]
    rfl
  have he : ((e : ℕ) : WithBot ℕ∞) ≤ (d : WithBot ℕ∞) := by
    have h1 := dimGe α.toRingHom (RingHom.Finite.to_isIntegral hαf) hαi
    rw [hdimMv, Fintype.card_fin] at h1
    exact h1.trans hR
  have hf : ((f : ℕ) : WithBot ℕ∞) ≤ (d' : WithBot ℕ∞) := by
    have h1 := dimGe β.toRingHom (RingHom.Finite.to_isIntegral hβf) hβi
    rw [hdimMv, Fintype.card_fin] at h1
    exact h1.trans hS
  have hμ := RingHom.Finite.tensorProductMap hαf hβf
  have h2 := dimLe (Algebra.TensorProduct.map α β).toRingHom (RingHom.Finite.to_isIntegral hμ)
  have h3 : ringKrullDim (TensorProduct K (MvPolynomial (Fin e) K) (MvPolynomial (Fin f) K)) =
      ((e + f : ℕ) : WithBot ℕ∞) := by
    rw [ringKrullDim_eq_of_ringEquiv (MvPolynomial.tensorEquivSum K (Fin e) (Fin f) K).toRingEquiv,
      hdimMv, Fintype.card_sum, Fintype.card_fin, Fintype.card_fin]
  rw [h3] at h2
  refine h2.trans ?_
  have he' : e ≤ d := by exact_mod_cast he
  have hf' : f ≤ d' := by exact_mod_cast hf
  exact_mod_cast Nat.add_le_add he' hf'

theorem wc_ldp_dtc_rank_minor (K : Type u) [Field K] {m' q' : Type} [Fintype q']
    (P : Matrix m' q' K) (s : ℕ) :
    s ≤ P.rank ↔ ∃ (r : Fin s → m') (c : Fin s → q'), (P.submatrix r c).det ≠ 0 :=
by
  classical
  constructor
  · intro hs
    obtain ⟨κ, a, ha, hspan, hli⟩ := exists_linearIndependent' K P.col
    haveI : Finite κ := Finite.of_injective a ha
    letI : Fintype κ := Fintype.ofFinite κ
    have hrank : P.rank = Fintype.card κ := by
      rw [Matrix.rank_eq_finrank_span_cols, ← hspan, finrank_span_eq_card hli]
    have hcard : Fintype.card (Fin s) ≤ Fintype.card κ := by
      rw [Fintype.card_fin]; omega
    obtain ⟨e⟩ := Function.Embedding.nonempty_of_card_le hcard
    let c : Fin s → q' := a ∘ e
    have hcli : LinearIndependent K (fun j : Fin s => fun i : m' => P i (c j)) :=
      hli.comp e e.injective
    let M : Matrix m' (Fin s) K := P.submatrix id c
    have hW : Submodule.span K (Set.range M) = ⊤ := by
      by_contra hne
      obtain ⟨f, hf0, hfle⟩ :=
        Submodule.exists_le_ker_of_lt_top _ (lt_top_iff_ne_top.mpr hne)
      let v : Fin s → K := fun j => f (fun k => if j = k then 1 else 0)
      have hfx : ∀ x : Fin s → K, f x = ∑ j, x j * v j := by
        intro x
        rw [LinearMap.pi_apply_eq_sum_univ f x]
        rfl
      have hrow : ∀ i : m', ∑ j, M i j * v j = 0 := by
        intro i
        rw [← hfx]
        exact LinearMap.mem_ker.mp (hfle (Submodule.subset_span ⟨i, rfl⟩))
      have hsum : ∑ j, v j • (fun i : m' => P i (c j)) = 0 := by
        funext i
        rw [Finset.sum_apply]
        simp only [Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
        rw [← hrow i]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [mul_comm]
        rfl
      have hv0 := Fintype.linearIndependent_iff.mp hcli v hsum
      apply hf0
      apply LinearMap.ext
      intro x
      rw [hfx]
      simp [v, hv0]
    obtain ⟨κ', b, hb, hspan', hli'⟩ := exists_linearIndependent' K M
    haveI : Finite κ' := hli'.finite
    letI : Fintype κ' := Fintype.ofFinite κ'
    have hcard' : Fintype.card κ' = s := by
      have h1 := finrank_span_eq_card hli'
      rw [hspan', hW, finrank_top, Module.finrank_fin_fun] at h1
      exact h1.symm
    let e' : Fin s ≃ κ' := (Fintype.equivFinOfCardEq hcard').symm
    let r : Fin s → m' := b ∘ e'
    have hSli : LinearIndependent K (fun k => (M.submatrix r id) k) :=
      hli'.comp e' e'.injective
    have hU : IsUnit (M.submatrix r id) := Matrix.linearIndependent_rows_iff_isUnit.mp hSli
    exact ⟨r, c, ((Matrix.isUnit_iff_isUnit_det _).mp hU).ne_zero⟩
  · rintro ⟨r, c, h⟩
    have hU : IsUnit (P.submatrix r c) :=
      (Matrix.isUnit_iff_isUnit_det _).mpr (isUnit_iff_ne_zero.mpr h)
    have h1 := Matrix.rank_of_isUnit (P.submatrix r c) hU
    have h2 := Matrix.rank_submatrix_le P r c
    rw [h1, Fintype.card_fin] at h2
    exact h2

theorem wc_ldp_dtc_fibre_count (K : Type u) [Field K] [IsAlgClosed K] (N : ℕ) {ι' : Type}
    [Fintype ι'] (B : Type u) [CommRing B] [Algebra K B] [Algebra.FiniteType K B] (e ρ : ℕ)
    (hB : ringKrullDim B ≤ (e : WithBot ℕ∞)) (hρ : e + 1 < ρ)
    (L : Matrix ι' (Fin (N + 1) × Fin (N + 1)) B)
    (hL : ∀ χ : B →ₐ[K] K, ρ ≤ (L.map χ).rank) :
    ∃ (A : Type u) (_ : CommRing A) (_ : Algebra K A) (_ : Algebra.FiniteType K A),
      ringKrullDim A < (Fintype.card (Fin 2 × Fin (N + 1) × Fin (N + 1)) : WithBot ℕ∞) ∧
      ∃ φ : MvPolynomial (Fin 2 × Fin (N + 1) × Fin (N + 1)) K →ₐ[K] A,
        ∀ (χ : B →ₐ[K] K) (τ : K) (g h : Fin (N + 1) × Fin (N + 1) → K),
          (L.map χ).mulVec h = 0 →
          (∃ ψ : A →ₐ[K] K, ∀ Φ, ψ (φ Φ) = MvPolynomial.eval
            (fun s : Fin 2 × Fin (N + 1) × Fin (N + 1) =>
              if s.1 = 0 then g s.2 else τ * g s.2 - h s.2) Φ) ∧
          (∃ ψ : A →ₐ[K] K, ∀ Φ, ψ (φ Φ) = MvPolynomial.eval
            (fun s : Fin 2 × Fin (N + 1) × Fin (N + 1) =>
              if s.1 = 0 then τ * g s.2 + h s.2 else g s.2) Φ) :=
by
  classical


  have LFD : ∀ (R : Type u) [CommRing R] [Algebra K R] [Algebra.FiniteType K R] (e : ℕ)
      (hR : ringKrullDim R ≤ e) (ρ ι' : Type) [Fintype ρ] [Fintype ι'] (L : ρ → ι' → R)
      (hsurj : ∀ (χ : R →ₐ[K] K) (y : ρ → K), ∃ w : ι' → K, ∀ i, ∑ j, w j * χ (L i j) = y i),
      ringKrullDim (MvPolynomial ι' R ⧸ Ideal.span (Set.range fun i =>
        ∑ j, MvPolynomial.C (L i j) * MvPolynomial.X j)) ≤
      ((e + Fintype.card ι' - Fintype.card ρ : ℕ) : WithBot ℕ∞) := by
    intro R _ _ _ e hR ρ ι' _ _ L hsurj
    have s1 : Ideal.span (Set.range fun a : {a : ρ → ι' // Function.Injective a} =>
        (Matrix.of fun i k => L i (a.1 k)).det) = ⊤ := by
      by_contra hJ
      obtain ⟨m, hm, hJm⟩ := Ideal.exists_le_maximal _ hJ
      letI : Field (R ⧸ m) := Ideal.Quotient.field m
      have : Algebra.FiniteType K (R ⧸ m) :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ K m)
          (Ideal.Quotient.mkₐ_surjective K m)
      have : Module.Finite K (R ⧸ m) := finite_of_finite_type_of_isJacobsonRing K (R ⧸ m)
      have : Algebra.IsIntegral K (R ⧸ m) := Algebra.IsIntegral.of_finite K _
      have hbij := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K) (K := R ⧸ m)
      let eK : K ≃ₐ[K] R ⧸ m := AlgEquiv.ofBijective (Algebra.ofId K (R ⧸ m)) hbij
      let χ : R →ₐ[K] K := eK.symm.toAlgHom.comp (Ideal.Quotient.mkₐ K m)
      have hχ : ∀ r ∈ m, χ r = 0 := by
        intro r hr
        have h0 : Ideal.Quotient.mkₐ K m r = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hr
        show eK.symm (Ideal.Quotient.mkₐ K m r) = 0
        rw [h0, map_zero]
      let c : ι' → (ρ → K) := fun j i => χ (L i j)
      have hspan : Submodule.span K (Set.range c) = ⊤ := by
        rw [eq_top_iff]
        intro y _
        obtain ⟨w, hw⟩ := hsurj χ y
        have hy : y = ∑ j, w j • c j := by
          ext i
          rw [Finset.sum_apply, ← hw i]
          rfl
        rw [hy]
        exact Submodule.sum_mem _ (fun j _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩))
      obtain ⟨κ, b, hb, hbspan, hbli⟩ := exists_linearIndependent' K c
      have : Finite κ := Finite.of_injective b hb
      letI : Fintype κ := Fintype.ofFinite κ
      have hcard : Fintype.card κ = Fintype.card ρ := by
        let B := Module.Basis.mk hbli (by rw [hbspan, hspan])
        have := Module.finrank_eq_card_basis B
        rw [Module.finrank_fintype_fun_eq_card] at this
        exact this.symm
      let σ : ρ ≃ κ := Fintype.equivOfCardEq hcard.symm
      let a : ρ → ι' := b ∘ σ
      have ha : Function.Injective a := hb.comp σ.injective
      let N : Matrix ρ ρ K := Matrix.of fun i k => χ (L i (a k))
      have hN : LinearIndependent K N.col := by
        have : N.col = (c ∘ b) ∘ σ := by
          ext k i
          rfl
        rw [this]
        exact hbli.comp σ σ.injective
      have hdet : N.det ≠ 0 :=
        ((Matrix.isUnit_iff_isUnit_det N).mp (Matrix.linearIndependent_cols_iff_isUnit.mp hN)).ne_zero
      apply hdet
      have h1 : χ (Matrix.of fun i k => L i (a k)).det = 0 :=
        hχ _ (hJm (Ideal.subset_span ⟨⟨a, ha⟩, rfl⟩))
      rw [AlgHom.map_det] at h1
      exact h1
    have s2 : ∀ x : R, ringKrullDim (Localization.Away x) ≤ ringKrullDim R := by
      intro x
      rw [ringKrullDim_le_iff_height_le]
      intro p hp
      rw [← IsLocalization.height_under (Submonoid.powers x) p]
      exact Ideal.height_le_ringKrullDim_of_ne_top (Ideal.IsPrime.ne_top inferInstance)
    have s3 : ∀ (S : Type u) [CommRing S] {κ : Type} (f : κ → S),
        Ideal.span (Set.range f) = ⊤ → ∀ (d : WithBot ℕ∞),
        (∀ k, ringKrullDim (Localization.Away (f k)) ≤ d) → ringKrullDim S ≤ d := by
      intro S _ κ f hf d hd
      rw [ringKrullDim_le_iff_height_le]
      intro Q hQ
      obtain ⟨k, hk⟩ : ∃ k, f k ∉ Q := by
        by_contra h
        push_neg at h
        apply hQ.ne_top
        rw [eq_top_iff, ← hf, Ideal.span_le]
        rintro _ ⟨k, rfl⟩
        exact h k
      have hdisj : Disjoint (Submonoid.powers (f k) : Set S) (Q : Set S) := by
        rw [Set.disjoint_left]
        rintro _ ⟨n, rfl⟩ hn
        exact hk (hQ.mem_of_pow_mem n hn)
      have hP := IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers (f k))
        (Localization.Away (f k)) Q hQ hdisj
      rw [← IsLocalization.height_map_of_disjoint (S := Localization.Away (f k))
        (Submonoid.powers (f k)) Q hdisj]
      exact (Ideal.height_le_ringKrullDim_of_ne_top hP.ne_top).trans (hd k)
    have s4 : ∀ (a : ρ → ι'), Function.Injective a →
        ∃ f : MvPolynomial {j : ι' // j ∉ Set.range a}
            (Localization.Away (Matrix.of fun i k => L i (a k)).det) →+*
          Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range fun i =>
              ∑ j, MvPolynomial.C (L i j) * MvPolynomial.X j))
            (MvPolynomial.C (Matrix.of fun i k => L i (a k)).det)),
          Function.Surjective f := by
      intro a ha
      set I := Ideal.span (Set.range fun i =>
              ∑ j, MvPolynomial.C (L i j) * MvPolynomial.X j) with hI
      set A : Matrix ρ ρ R := Matrix.of fun i k => L i (a k) with hA
      set δ := A.det with hδ
      set π := Ideal.Quotient.mk I with hπ
      set δS := π (MvPolynomial.C δ) with hδS
      let T := Localization.Away δS
      let g₀ : R →+* T := (algebraMap _ T).comp (π.comp MvPolynomial.C)
      have hg₀δ : g₀ δ = algebraMap _ T δS := rfl
      have hg₀u : IsUnit (g₀ δ) := by
        rw [hg₀δ]; exact IsLocalization.Away.algebraMap_isUnit δS
      let g : Localization.Away δ →+* T := IsLocalization.Away.lift δ hg₀u
      have hg : ∀ r : R, g (algebraMap R _ r) = g₀ r := fun r =>
        IsLocalization.Away.lift_eq δ hg₀u r
      let y : ι' → T := fun j => algebraMap _ T (π (MvPolynomial.X j))
      let f : MvPolynomial {j : ι' // j ∉ Set.range a} (Localization.Away δ) →+* T :=
        MvPolynomial.eval₂Hom g (fun j => y j.1)
      refine ⟨f, ?_⟩
      have hi : ∀ r : R, g₀ r ∈ f.range := fun r =>
        ⟨MvPolynomial.C (algebraMap R _ r), by
          simp only [f, MvPolynomial.eval₂Hom_C, hg]⟩
      set u := g (IsLocalization.Away.invSelf δ) with hu
      have hii : u ∈ f.range := ⟨MvPolynomial.C (IsLocalization.Away.invSelf δ), by
          simp only [f, MvPolynomial.eval₂Hom_C, hu]⟩
      have hδu : g₀ δ * u = 1 := by
        rw [← hg, hu, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
      have hiii : ∀ (j : ι') (hj : j ∉ Set.range a), y j ∈ f.range := fun j hj =>
        ⟨MvPolynomial.X ⟨j, hj⟩, by simp only [f, MvPolynomial.eval₂Hom_X']⟩
      have hrel : ∀ i, ∑ j, g₀ (L i j) * y j = 0 := by
        intro i
        have h0 : π (∑ j, MvPolynomial.C (L i j) * MvPolynomial.X j) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
        have h1 := congrArg (algebraMap _ T) h0
        rw [map_zero, map_sum, map_sum] at h1
        simp only [map_mul] at h1
        exact h1
      let b : ρ → T := fun i => ∑ j : {j : ι' // j ∉ Set.range a}, g₀ (L i j.1) * y j.1
      let v : ρ → T := fun k => y (a k)
      let A' : Matrix ρ ρ T := g₀.mapMatrix A
      have hmv : A'.mulVec v = -b := by
        funext i
        have h := Fintype.sum_subtype_add_sum_subtype (fun j => j ∈ Set.range a)
          (fun j => g₀ (L i j) * y j)
        have hs : ∑ j : {j : ι' // j ∈ Set.range a}, g₀ (L i j.1) * y j.1 =
            ∑ k, g₀ (L i (a k)) * y (a k) := by
          symm
          exact Fintype.sum_bijective (fun k => (⟨a k, k, rfl⟩ : {j : ι' // j ∈ Set.range a}))
            ⟨fun k k' hkk' => ha (congrArg Subtype.val hkk'),
              fun ⟨_, k, hk⟩ => ⟨k, Subtype.ext hk⟩⟩
            _ _ (fun k => rfl)
        have e1 : A'.mulVec v i = ∑ k, g₀ (L i (a k)) * y (a k) := rfl
        rw [Pi.neg_apply, e1, ← hs]
        convert eq_neg_of_add_eq_zero_left (h.trans (hrel i))
      have hdet : A'.det = g₀ δ := (RingHom.map_det g₀ A).symm
      have hiv : ∀ k, v k ∈ f.range := by
        intro k
        have h1 : A'.adjugate.mulVec (A'.mulVec v) = A'.det • v := by
          rw [Matrix.mulVec_mulVec, Matrix.adjugate_mul, Matrix.smul_mulVec, Matrix.one_mulVec]
        rw [hmv, hdet] at h1
        have h2 := congrFun h1 k
        rw [Pi.smul_apply, smul_eq_mul] at h2
        have h3 : v k = u * (A'.adjugate.mulVec (-b)) k := by
          rw [h2, ← mul_assoc, mul_comm u, hδu, one_mul]
        rw [h3]
        refine f.range.mul_mem hii ?_
        rw [Matrix.mulVec_neg, Pi.neg_apply]
        refine f.range.neg_mem ?_
        show ∑ i, A'.adjugate k i * b i ∈ f.range
        refine f.range.sum_mem (fun i _ => f.range.mul_mem ?_ ?_)
        · rw [← RingHom.map_adjugate]
          exact hi _
        · exact f.range.sum_mem (fun j _ => f.range.mul_mem (hi _) (hiii j.1 j.2))
      have hy : ∀ j, y j ∈ f.range := by
        intro j
        by_cases hj : j ∈ Set.range a
        · obtain ⟨k, rfl⟩ := hj
          exact hiv k
        · exact hiii j hj
      have hv : ∀ p : MvPolynomial ι' R, algebraMap _ T (π p) ∈ f.range := by
        intro p
        induction p using MvPolynomial.induction_on with
        | C r => exact hi r
        | add p q hp hq => rw [map_add, map_add]; exact f.range.add_mem hp hq
        | mul_X p j hp => rw [map_mul, map_mul]; exact f.range.mul_mem hp (hy j)
      intro t
      obtain ⟨n, s, hn⟩ := IsLocalization.Away.surj δS t
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective s
      have ht : t = algebraMap _ T (π p) * u ^ n := by
        calc t = t * (g₀ δ * u) ^ n := by rw [hδu, one_pow, mul_one]
          _ = (t * algebraMap _ T δS ^ n) * u ^ n := by rw [hg₀δ]; ring
          _ = _ := by rw [hn]
      rw [ht]
      exact f.range.mul_mem (hv p) (f.range.pow_mem hii n)
    have hNoeth : IsNoetherianRing R := Algebra.FiniteType.isNoetherianRing K R
    set I := Ideal.span (Set.range fun i =>
        ∑ j, MvPolynomial.C (L i j) * MvPolynomial.X j) with hI
    refine s3 _ (fun a : {a : ρ → ι' // Function.Injective a} =>
      Ideal.Quotient.mk I (MvPolynomial.C (Matrix.of fun i k => L i (a.1 k)).det)) ?_ _ ?_
    · have hrange : (Set.range fun a : {a : ρ → ι' // Function.Injective a} =>
          Ideal.Quotient.mk I (MvPolynomial.C (Matrix.of fun i k => L i (a.1 k)).det)) =
          ((Ideal.Quotient.mk I).comp MvPolynomial.C) '' (Set.range fun a :
            {a : ρ → ι' // Function.Injective a} => (Matrix.of fun i k => L i (a.1 k)).det) := by
        rw [← Set.range_comp]
        rfl
      rw [hrange, ← Ideal.map_span, s1, Ideal.map_top]
    · rintro ⟨a, ha⟩
      obtain ⟨f, hf⟩ := s4 a ha
      have hle : Fintype.card ρ ≤ Fintype.card ι' := Fintype.card_le_of_injective a ha
      have hc : Fintype.card {j : ι' // j ∉ Set.range a} =
          Fintype.card ι' - Fintype.card ρ := by
        rw [Fintype.card_subtype_compl, ← Set.card_range_of_injective ha]
        try (congr 1; exact Fintype.card_congr (Equiv.refl _))
      refine (ringKrullDim_le_of_surjective f hf).trans ?_
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ENat.card_eq_coe_fintype_card, hc,
        show e + Fintype.card ι' - Fintype.card ρ = e + (Fintype.card ι' - Fintype.card ρ) by omega,
        Nat.cast_add]
      exact add_le_add ((s2 _).trans hR) (le_of_eq rfl)

  have PID : ∀ {κ : Type} [Fintype κ] (A : κ → Type u) [∀ i, CommRing (A i)]
      [∀ i, Algebra K (A i)] [∀ i, Algebra.FiniteType K (A i)]
      (c : WithBot ℕ∞) (hc : ⊥ < c) (hA : ∀ i, ringKrullDim (A i) < c),
      Algebra.FiniteType K (∀ i, A i) ∧ ringKrullDim (∀ i, A i) < c := by
    intro κ _ A _ _ _ c hc hA
    constructor
    · have hfg : ∀ i, ∃ t : Finset (A i), Algebra.adjoin K (t : Set (A i)) = ⊤ := fun i =>
        (Algebra.FiniteType.out (R := K) (A := A i))
      choose t ht using hfg
      let T : Set (∀ i, A i) :=
        ⋃ i, (fun a => (Pi.single i a : ∀ i, A i)) '' (insert 1 (t i : Set (A i)))
      have hT : T.Finite := Set.finite_iUnion (fun i => ((t i).finite_toSet.insert 1).image _)
      have hsingle : ∀ i (y : A i), (Pi.single i y : ∀ i, A i) ∈ Algebra.adjoin K T := by
        intro i y
        have hy : y ∈ Algebra.adjoin K (t i : Set (A i)) := by rw [ht i]; trivial
        induction hy using Algebra.adjoin_induction with
        | mem x hx =>
          exact Algebra.subset_adjoin
            (Set.mem_iUnion.mpr ⟨i, x, Set.mem_insert_of_mem _ hx, rfl⟩)
        | algebraMap r =>
          have h1 : (Pi.single i (1 : A i) : ∀ i, A i) ∈ Algebra.adjoin K T :=
            Algebra.subset_adjoin (Set.mem_iUnion.mpr ⟨i, 1, Set.mem_insert _ _, rfl⟩)
          have e : (Pi.single i (algebraMap K (A i) r) : ∀ i, A i) =
              r • Pi.single i (1 : A i) := by
            ext j
            rcases eq_or_ne j i with rfl | h
            · simp [Algebra.algebraMap_eq_smul_one]
            · simp [h]
          rw [e]
          exact Subalgebra.smul_mem _ h1 r
        | add x y _ _ hx hy => rw [Pi.single_add]; exact add_mem hx hy
        | mul x y _ _ hx hy => rw [Pi.single_mul]; exact mul_mem hx hy
      refine ⟨Subalgebra.fg_def.mpr ⟨T, hT, ?_⟩⟩
      rw [eq_top_iff]
      intro x _
      rw [← Finset.univ_sum_single x]
      exact Subalgebra.sum_mem _ (fun i _ => hsingle i (x i))
    · have hle : ringKrullDim (∀ i, A i) ≤ Finset.univ.sup (fun i => ringKrullDim (A i)) := by
        show Order.krullDim (PrimeSpectrum (∀ i, A i)) ≤ _
        refine iSup_le fun p => ?_
        have hex : ∃ i₀, (Pi.single i₀ (1 : A i₀) : ∀ i, A i) ∉ p.last.asIdeal := by
          by_contra hcon
          push_neg at hcon
          apply p.last.isPrime.ne_top
          rw [Ideal.eq_top_iff_one]
          have e : (1 : ∀ i, A i) = ∑ i, (Pi.single i (1 : A i) : ∀ i, A i) :=
            (Finset.univ_sum_single (1 : ∀ i, A i)).symm
          rw [e]
          exact Ideal.sum_mem _ (fun i _ => hcon i)
        obtain ⟨i₀, hi₀⟩ := hex
        have hnot : ∀ k, (Pi.single i₀ (1 : A i₀) : ∀ i, A i) ∉ (p k).asIdeal := fun k h =>
          hi₀ ((PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr (p.monotone (Fin.le_last k)) h)
        let ev : (∀ i, A i) →+* A i₀ := Pi.evalRingHom A i₀
        have hsurj : Function.Surjective ev := fun y => ⟨Pi.single i₀ y, by simp [ev]⟩
        have hker : ∀ k, RingHom.ker ev ≤ (p k).asIdeal := by
          intro k x hx
          rw [RingHom.mem_ker] at hx
          have h0 : x * (Pi.single i₀ (1 : A i₀) : ∀ i, A i) = 0 := by
            ext j
            rcases eq_or_ne j i₀ with rfl | h
            · have hx' : x j = 0 := hx
              simp [hx']
            · simp [h]
          have hm := (p k).isPrime.mem_or_mem (h0 ▸ (p k).asIdeal.zero_mem)
          exact hm.resolve_right (hnot k)
        have hprime : ∀ k, (Ideal.map ev (p k).asIdeal).IsPrime := fun k =>
          Ideal.map_isPrime_of_surjective hsurj (hker k)
        have hcomap : ∀ k, Ideal.comap ev (Ideal.map ev (p k).asIdeal) = (p k).asIdeal :=
          fun k => by
            rw [Ideal.comap_map_of_surjective _ hsurj]
            exact sup_eq_left.mpr (hker k)
        let f : Fin (p.length + 1) → PrimeSpectrum (A i₀) := fun k => ⟨_, hprime k⟩
        have hf : StrictMono f := by
          intro a b hab
          have hlt : (p a).asIdeal < (p b).asIdeal :=
            (PrimeSpectrum.asIdeal_lt_asIdeal _ _).mpr (p.strictMono hab)
          refine (PrimeSpectrum.asIdeal_lt_asIdeal (f a) (f b)).mp ?_
          show Ideal.map ev (p a).asIdeal < Ideal.map ev (p b).asIdeal
          refine lt_of_le_of_ne (Ideal.map_mono hlt.le) (fun heq => hlt.ne ?_)
          rw [← hcomap a, ← hcomap b, heq]
        exact le_trans (Order.LTSeries.length_le_krullDim (LTSeries.mk p.length f hf))
          (Finset.le_sup (f := fun i => ringKrullDim (A i)) (Finset.mem_univ i₀))
      exact lt_of_le_of_lt hle ((Finset.sup_lt_iff hc).mpr (fun i _ => hA i))

  have cramer : ∀ (D : Matrix ι' (Fin (N + 1) × Fin (N + 1)) K) (r : Fin ρ → ι')
      (c : Fin ρ → Fin (N + 1) × Fin (N + 1)), (D.submatrix r c).det ≠ 0 →
      ∀ y : Fin ρ → K, ∃ w : Fin (N + 1) × Fin (N + 1) → K, ∀ i, ∑ q, w q * D (r i) q = y i := by
    intro D r c hdet y
    set S := D.submatrix r c with hS
    have hu : IsUnit S.det := isUnit_iff_ne_zero.mpr hdet
    set z := S⁻¹.mulVec y with hz
    have hSz : S.mulVec z = y := by
      rw [hz, Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv _ hu, Matrix.one_mulVec]
    refine ⟨fun q => ∑ k, if c k = q then z k else 0, fun i => ?_⟩
    rw [← hSz]
    simp only [Finset.sum_mul, ite_mul, zero_mul]
    rw [Finset.sum_comm]
    simp only [Finset.sum_ite_eq, Finset.mem_univ, if_true]
    simp only [Matrix.mulVec, dotProduct, hS, Matrix.submatrix_apply]
    exact Finset.sum_congr rfl (fun k _ => mul_comm _ _)
  have split : ∀ F : Fin 2 × (Fin (N + 1) × Fin (N + 1)) → K,
      ∑ x, F x = ∑ q, F (0, q) + ∑ q, F (1, q) := fun F => by
    rw [Fintype.sum_prod_type F, Fin.sum_univ_two]

  have piece : ∀ (ε : Fin 2) (r : Fin ρ → ι') (c : Fin ρ → Fin (N + 1) × Fin (N + 1)),
      ∃ (A : Type u) (_ : CommRing A) (_ : Algebra K A) (_ : Algebra.FiniteType K A),
        ringKrullDim A < (Fintype.card (Fin 2 × Fin (N + 1) × Fin (N + 1)) : WithBot ℕ∞) ∧
        ∃ φ : MvPolynomial (Fin 2 × Fin (N + 1) × Fin (N + 1)) K →ₐ[K] A,
          ∀ (χ : B →ₐ[K] K) (τ : K) (g h : Fin (N + 1) × Fin (N + 1) → K),
            (L.map χ).mulVec h = 0 → ((L.map χ).submatrix r c).det ≠ 0 →
            ∃ ψ : A →ₐ[K] K, ∀ Φ, ψ (φ Φ) = MvPolynomial.eval
              (fun s : Fin 2 × Fin (N + 1) × Fin (N + 1) =>
                if ε = 0 then (if s.1 = 0 then g s.2 else τ * g s.2 - h s.2)
                else (if s.1 = 0 then τ * g s.2 + h s.2 else g s.2)) Φ := by
    intro ε r c
    obtain ⟨δ, hδ⟩ : ∃ δ : B, δ = (L.submatrix r c).det := ⟨_, rfl⟩
    obtain ⟨Lb, hLb⟩ : ∃ Lb : Fin ρ → Option (Fin 2 × Fin (N + 1) × Fin (N + 1)) → B,
        Lb = fun i j => Option.elim j 0 (fun aq => if aq.1 = 1 then L (r i) aq.2 else 0) :=
      ⟨_, rfl⟩
    have hχδ : ∀ χ : B →ₐ[K] K, χ δ = ((L.map χ).submatrix r c).det := by
      intro χ
      rw [hδ, AlgHom.map_det, AlgHom.mapMatrix_apply, Matrix.submatrix_map]
    have hLbsum : ∀ (χ : B →ₐ[K] K) (i : Fin ρ) (pt : Option (Fin 2 × Fin (N + 1) × Fin (N + 1)) → K),
        ∑ j, χ (Lb i j) * pt j = ∑ q, χ (L (r i) q) * pt (some (1, q)) := by
      intro χ i pt
      rw [Fintype.sum_option, split]
      simp [hLb]
    obtain ⟨I, hI⟩ : ∃ I : Ideal (MvPolynomial (Option (Fin 2 × Fin (N + 1) × Fin (N + 1)))
        (Localization.Away δ)), I = Ideal.span (Set.range fun i =>
          ∑ j, MvPolynomial.C (algebraMap B (Localization.Away δ) (Lb i j)) * MvPolynomial.X j) :=
      ⟨_, rfl⟩
    have hsurj : ∀ (χ' : Localization.Away δ →ₐ[K] K) (y : Fin ρ → K),
        ∃ w : Option (Fin 2 × Fin (N + 1) × Fin (N + 1)) → K,
          ∀ i, ∑ j, w j * χ' (algebraMap B (Localization.Away δ) (Lb i j)) = y i := by
      intro χ' y
      obtain ⟨χ, hχ⟩ : ∃ χ : B →ₐ[K] K, ∀ b, χ b = χ' (algebraMap B (Localization.Away δ) b) :=
        ⟨χ'.comp (IsScalarTower.toAlgHom K B (Localization.Away δ)), fun b => rfl⟩
      have hδ0 : χ δ ≠ 0 := by
        rw [hχ]
        exact (IsUnit.map χ'
          (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away δ) δ)).ne_zero
      rw [hχδ] at hδ0
      obtain ⟨w₀, hw₀⟩ := cramer (L.map χ) r c hδ0 y
      obtain ⟨w, hw⟩ : ∃ w : Option (Fin 2 × Fin (N + 1) × Fin (N + 1)) → K,
          w = fun j => Option.elim j 0 (fun aq => if aq.1 = 1 then w₀ aq.2 else 0) := ⟨_, rfl⟩
      refine ⟨w, fun i => ?_⟩
      calc ∑ j, w j * χ' (algebraMap B (Localization.Away δ) (Lb i j))
          = ∑ j, χ (Lb i j) * w j := Finset.sum_congr rfl (fun j _ => by rw [hχ, mul_comm])
        _ = ∑ q, χ (L (r i) q) * w (some (1, q)) := hLbsum χ i w
        _ = y i := by
          rw [← hw₀ i]
          refine Finset.sum_congr rfl (fun q _ => ?_)
          simp [hw, mul_comm]
    have hdim : ringKrullDim (MvPolynomial (Option (Fin 2 × Fin (N + 1) × Fin (N + 1)))
        (Localization.Away δ) ⧸ I) <
        (Fintype.card (Fin 2 × Fin (N + 1) × Fin (N + 1)) : WithBot ℕ∞) := by
      have hR : ringKrullDim (Localization.Away δ) ≤ (e : WithBot ℕ∞) := by
        refine le_trans ?_ hB
        rw [ringKrullDim_le_iff_height_le]
        intro p hp
        rw [← IsLocalization.height_under (Submonoid.powers δ) p]
        exact Ideal.height_le_ringKrullDim_of_ne_top (Ideal.IsPrime.ne_top inferInstance)
      have h1 := LFD (Localization.Away δ) e hR (Fin ρ)
        (Option (Fin 2 × Fin (N + 1) × Fin (N + 1)))
        (fun i j => algebraMap B (Localization.Away δ) (Lb i j)) hsurj
      rw [hI]
      refine lt_of_le_of_lt h1 ?_
      rw [Fintype.card_option, Fintype.card_fin]
      have hpos : 0 < Fintype.card (Fin 2 × Fin (N + 1) × Fin (N + 1)) := Fintype.card_pos
      exact Nat.cast_lt.mpr (by omega)
    obtain ⟨Y, hY⟩ : ∃ Y : Option (Fin 2 × Fin (N + 1) × Fin (N + 1)) →
        MvPolynomial (Option (Fin 2 × Fin (N + 1) × Fin (N + 1))) (Localization.Away δ) ⧸ I,
        Y = fun j => Ideal.Quotient.mk I (MvPolynomial.X j) := ⟨_, rfl⟩
    obtain ⟨F, hF⟩ : ∃ F : Fin 2 × Fin (N + 1) × Fin (N + 1) →
        MvPolynomial (Option (Fin 2 × Fin (N + 1) × Fin (N + 1))) (Localization.Away δ) ⧸ I,
        F = fun s => if ε = 0 then
            (if s.1 = 0 then Y (some (0, s.2)) else Y none * Y (some (0, s.2)) - Y (some (1, s.2)))
          else
            (if s.1 = 0 then Y none * Y (some (0, s.2)) + Y (some (1, s.2)) else Y (some (0, s.2))) :=
      ⟨_, rfl⟩
    refine ⟨MvPolynomial (Option (Fin 2 × Fin (N + 1) × Fin (N + 1))) (Localization.Away δ) ⧸ I,
      inferInstance, inferInstance, inferInstance, hdim, MvPolynomial.aeval F, ?_⟩
    intro χ τ g h hh hdet
    rw [← hχδ] at hdet
    have hu : ∀ y : Submonoid.powers δ, IsUnit (χ y) := by
      rintro ⟨y, n, rfl⟩
      show IsUnit (χ (δ ^ n))
      rw [map_pow]
      exact (isUnit_iff_ne_zero.mpr hdet).pow n
    obtain ⟨χ', hχ'⟩ : ∃ χ' : Localization.Away δ →ₐ[K] K,
        ∀ b, χ' (algebraMap B (Localization.Away δ) b) = χ b :=
      ⟨IsLocalization.liftAlgHom (M := Submonoid.powers δ) (S := Localization.Away δ) hu,
        fun b => by simp [IsLocalization.liftAlgHom_apply]⟩
    obtain ⟨pt, hpt⟩ : ∃ pt : Option (Fin 2 × Fin (N + 1) × Fin (N + 1)) → K,
        pt = fun j => Option.elim j τ (fun aq => if aq.1 = 0 then g aq.2 else h aq.2) :=
      ⟨_, rfl⟩
    obtain ⟨Θ, hΘ⟩ : ∃ Θ : MvPolynomial (Option (Fin 2 × Fin (N + 1) × Fin (N + 1)))
        (Localization.Away δ) →ₐ[K] K,
        Θ = (MvPolynomial.aeval pt).comp (MvPolynomial.mapAlgHom χ') := ⟨_, rfl⟩
    have hΘX : ∀ j, Θ (MvPolynomial.X j) = pt j := fun j => by
      rw [hΘ, AlgHom.comp_apply, MvPolynomial.mapAlgHom_apply, MvPolynomial.map_X,
        MvPolynomial.aeval_X]
    have hΘC : ∀ b : B, Θ (MvPolynomial.C (algebraMap B (Localization.Away δ) b)) = χ b :=
      fun b => by
        rw [hΘ, AlgHom.comp_apply, MvPolynomial.mapAlgHom_apply, MvPolynomial.map_C,
          MvPolynomial.aeval_C]
        simp [hχ']
    have hker : ∀ a ∈ I, Θ a = 0 := by
      intro a ha
      rw [hI] at ha
      have hle : Ideal.span (Set.range fun i =>
          ∑ j, MvPolynomial.C (algebraMap B (Localization.Away δ) (Lb i j)) * MvPolynomial.X j) ≤
          RingHom.ker Θ := by
        rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        simp only [SetLike.mem_coe, RingHom.mem_ker, map_sum, map_mul, hΘX, hΘC]
        rw [hLbsum χ i pt]
        have h1 := congrFun hh (r i)
        rw [hpt]
        simpa [Matrix.mulVec, dotProduct] using h1
      exact (RingHom.mem_ker).mp (hle ha)
    obtain ⟨ψ, hψ⟩ : ∃ ψ : (MvPolynomial (Option (Fin 2 × Fin (N + 1) × Fin (N + 1)))
        (Localization.Away δ) ⧸ I) →ₐ[K] K, ∀ j, ψ (Y j) = pt j :=
      ⟨Ideal.Quotient.liftₐ I Θ hker, fun j => by
        rw [hY]
        simp only [Ideal.Quotient.liftₐ_apply, Ideal.Quotient.lift_mk]
        exact hΘX j⟩
    have hτ : ψ (Y none) = τ := by simp [hψ, hpt]
    have hg : ∀ q, ψ (Y (some (0, q))) = g q := fun q => by simp [hψ, hpt]
    have hh' : ∀ q, ψ (Y (some (1, q))) = h q := fun q => by simp [hψ, hpt]
    refine ⟨ψ, fun Φ => ?_⟩
    have hcomp : ψ.comp (MvPolynomial.aeval F) = MvPolynomial.aeval
        (fun s : Fin 2 × Fin (N + 1) × Fin (N + 1) =>
          if ε = 0 then (if s.1 = 0 then g s.2 else τ * g s.2 - h s.2)
          else (if s.1 = 0 then τ * g s.2 + h s.2 else g s.2)) := by
      apply MvPolynomial.algHom_ext
      intro s
      rw [AlgHom.comp_apply, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
      simp only [hF]
      split_ifs <;> simp [hτ, hg, hh']
    exact (DFunLike.congr_fun hcomp Φ).trans rfl
  choose Ap iAp1 iAp2 iAp3 hAp φp hφp using piece
  obtain ⟨hfin, hdimA⟩ := PID
    (fun u : Fin 2 × (Fin ρ → ι') × (Fin ρ → Fin (N + 1) × Fin (N + 1)) => Ap u.1 u.2.1 u.2.2)
    (Fintype.card (Fin 2 × Fin (N + 1) × Fin (N + 1)) : WithBot ℕ∞)
    (WithBot.bot_lt_coe _) (fun u => hAp u.1 u.2.1 u.2.2)
  refine ⟨∀ u : Fin 2 × (Fin ρ → ι') × (Fin ρ → Fin (N + 1) × Fin (N + 1)), Ap u.1 u.2.1 u.2.2,
    inferInstance, inferInstance, hfin, hdimA, AlgHom.pi (fun u => φp u.1 u.2.1 u.2.2), ?_⟩
  intro χ τ g h hh

  have RM : ∀ (P : Matrix ι' (Fin (N + 1) × Fin (N + 1)) K) (s : ℕ), s ≤ P.rank →
      ∃ (r : Fin s → ι') (c : Fin s → Fin (N + 1) × Fin (N + 1)), (P.submatrix r c).det ≠ 0 := by
    intro P s hs
    obtain ⟨κ, a, ha, hspan, hli⟩ := exists_linearIndependent' K P.col
    haveI : Finite κ := Finite.of_injective a ha
    letI : Fintype κ := Fintype.ofFinite κ
    have hrank : P.rank = Fintype.card κ := by
      rw [Matrix.rank_eq_finrank_span_cols, ← hspan, finrank_span_eq_card hli]
    have hcard : Fintype.card (Fin s) ≤ Fintype.card κ := by
      rw [Fintype.card_fin]; omega
    obtain ⟨e⟩ := Function.Embedding.nonempty_of_card_le hcard
    let c : Fin s → Fin (N + 1) × Fin (N + 1) := a ∘ e
    have hcli : LinearIndependent K (fun j : Fin s => fun i : ι' => P i (c j)) :=
      hli.comp e e.injective
    let M : Matrix ι' (Fin s) K := P.submatrix id c
    have hW : Submodule.span K (Set.range M) = ⊤ := by
      by_contra hne
      obtain ⟨f, hf0, hfle⟩ :=
        Submodule.exists_le_ker_of_lt_top _ (lt_top_iff_ne_top.mpr hne)
      let v : Fin s → K := fun j => f (fun k => if j = k then 1 else 0)
      have hfx : ∀ x : Fin s → K, f x = ∑ j, x j * v j := by
        intro x
        rw [LinearMap.pi_apply_eq_sum_univ f x]
        rfl
      have hrow : ∀ i : ι', ∑ j, M i j * v j = 0 := by
        intro i
        rw [← hfx]
        exact LinearMap.mem_ker.mp (hfle (Submodule.subset_span ⟨i, rfl⟩))
      have hsum : ∑ j, v j • (fun i : ι' => P i (c j)) = 0 := by
        funext i
        rw [Finset.sum_apply]
        simp only [Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
        rw [← hrow i]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [mul_comm]
        rfl
      have hv0 := Fintype.linearIndependent_iff.mp hcli v hsum
      apply hf0
      apply LinearMap.ext
      intro x
      rw [hfx]
      simp [v, hv0]
    obtain ⟨κ', b, hb, hspan', hli'⟩ := exists_linearIndependent' K M
    haveI : Finite κ' := hli'.finite
    letI : Fintype κ' := Fintype.ofFinite κ'
    have hcard' : Fintype.card κ' = s := by
      have h1 := finrank_span_eq_card hli'
      rw [hspan', hW, finrank_top, Module.finrank_fin_fun] at h1
      exact h1.symm
    let e' : Fin s ≃ κ' := (Fintype.equivFinOfCardEq hcard').symm
    let r : Fin s → ι' := b ∘ e'
    have hSli : LinearIndependent K (fun k => (M.submatrix r id) k) :=
      hli'.comp e' e'.injective
    have hU : IsUnit (M.submatrix r id) := Matrix.linearIndependent_rows_iff_isUnit.mp hSli
    exact ⟨r, c, ((Matrix.isUnit_iff_isUnit_det _).mp hU).ne_zero⟩
  obtain ⟨r, c, hrc⟩ := RM (L.map χ) ρ (hL χ)
  refine ⟨?_, ?_⟩
  · obtain ⟨ψ, hψ⟩ := hφp 0 r c χ τ g h hh hrc
    refine ⟨ψ.comp (Pi.evalAlgHom K
      (fun u : Fin 2 × (Fin ρ → ι') × (Fin ρ → Fin (N + 1) × Fin (N + 1)) => Ap u.1 u.2.1 u.2.2)
      (0, r, c)), fun Φ => ?_⟩
    refine (hψ Φ).trans ?_
    simp
  · obtain ⟨ψ, hψ⟩ := hφp 1 r c χ τ g h hh hrc
    refine ⟨ψ.comp (Pi.evalAlgHom K
      (fun u : Fin 2 × (Fin ρ → ι') × (Fin ρ → Fin (N + 1) × Fin (N + 1)) => Ap u.1 u.2.1 u.2.2)
      (1, r, c)), fun Φ => ?_⟩
    refine (hψ Φ).trans ?_
    simp

theorem wc_ldp_dtc_pi_dim (K : Type u) [Field K] {ι' : Type} [Fintype ι'] (A : ι' → Type u)
    [∀ i, CommRing (A i)] [∀ i, Algebra K (A i)] [∀ i, Algebra.FiniteType K (A i)]
    (c : WithBot ℕ∞) (hc : ⊥ < c) (hA : ∀ i, ringKrullDim (A i) < c) :
    Algebra.FiniteType K (∀ i, A i) ∧ ringKrullDim (∀ i, A i) < c :=
by
  classical
  constructor
  · have hfg : ∀ i, ∃ t : Finset (A i), Algebra.adjoin K (t : Set (A i)) = ⊤ := fun i =>
      (Algebra.FiniteType.out (R := K) (A := A i))
    choose t ht using hfg
    let T : Set (∀ i, A i) := ⋃ i, (fun a => (Pi.single i a : ∀ i, A i)) '' (insert 1 (t i : Set (A i)))
    have hT : T.Finite := Set.finite_iUnion (fun i => ((t i).finite_toSet.insert 1).image _)
    have hsingle : ∀ i (y : A i), (Pi.single i y : ∀ i, A i) ∈ Algebra.adjoin K T := by
      intro i y
      have hy : y ∈ Algebra.adjoin K (t i : Set (A i)) := by rw [ht i]; trivial
      induction hy using Algebra.adjoin_induction with
      | mem x hx =>
        exact Algebra.subset_adjoin
          (Set.mem_iUnion.mpr ⟨i, x, Set.mem_insert_of_mem _ hx, rfl⟩)
      | algebraMap r =>
        have h1 : (Pi.single i (1 : A i) : ∀ i, A i) ∈ Algebra.adjoin K T :=
          Algebra.subset_adjoin (Set.mem_iUnion.mpr ⟨i, 1, Set.mem_insert _ _, rfl⟩)
        have e : (Pi.single i (algebraMap K (A i) r) : ∀ i, A i) = r • Pi.single i (1 : A i) := by
          ext j
          rcases eq_or_ne j i with rfl | h
          · simp [Algebra.algebraMap_eq_smul_one]
          · simp [h]
        rw [e]
        exact Subalgebra.smul_mem _ h1 r
      | add x y _ _ hx hy => rw [Pi.single_add]; exact add_mem hx hy
      | mul x y _ _ hx hy => rw [Pi.single_mul]; exact mul_mem hx hy
    refine ⟨Subalgebra.fg_def.mpr ⟨T, hT, ?_⟩⟩
    rw [eq_top_iff]
    intro x _
    rw [← Finset.univ_sum_single x]
    exact Subalgebra.sum_mem _ (fun i _ => hsingle i (x i))
  · have hle : ringKrullDim (∀ i, A i) ≤ Finset.univ.sup (fun i => ringKrullDim (A i)) := by
      show Order.krullDim (PrimeSpectrum (∀ i, A i)) ≤ _
      refine iSup_le fun p => ?_
      have hex : ∃ i₀, (Pi.single i₀ (1 : A i₀) : ∀ i, A i) ∉ p.last.asIdeal := by
        by_contra hcon
        push_neg at hcon
        apply p.last.isPrime.ne_top
        rw [Ideal.eq_top_iff_one]
        have e : (1 : ∀ i, A i) = ∑ i, (Pi.single i (1 : A i) : ∀ i, A i) :=
          (Finset.univ_sum_single (1 : ∀ i, A i)).symm
        rw [e]
        exact Ideal.sum_mem _ (fun i _ => hcon i)
      obtain ⟨i₀, hi₀⟩ := hex
      have hnot : ∀ k, (Pi.single i₀ (1 : A i₀) : ∀ i, A i) ∉ (p k).asIdeal := fun k h =>
        hi₀ ((PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr (p.monotone (Fin.le_last k)) h)
      let ev : (∀ i, A i) →+* A i₀ := Pi.evalRingHom A i₀
      have hsurj : Function.Surjective ev := fun y => ⟨Pi.single i₀ y, by simp [ev]⟩
      have hker : ∀ k, RingHom.ker ev ≤ (p k).asIdeal := by
        intro k x hx
        rw [RingHom.mem_ker] at hx
        have h0 : x * (Pi.single i₀ (1 : A i₀) : ∀ i, A i) = 0 := by
          ext j
          rcases eq_or_ne j i₀ with rfl | h
          · have hx' : x j = 0 := hx
            simp [hx']
          · simp [h]
        have hm := (p k).isPrime.mem_or_mem (h0 ▸ (p k).asIdeal.zero_mem)
        exact hm.resolve_right (hnot k)
      have hprime : ∀ k, (Ideal.map ev (p k).asIdeal).IsPrime := fun k =>
        Ideal.map_isPrime_of_surjective hsurj (hker k)
      have hcomap : ∀ k, Ideal.comap ev (Ideal.map ev (p k).asIdeal) = (p k).asIdeal := fun k => by
        rw [Ideal.comap_map_of_surjective _ hsurj]
        exact sup_eq_left.mpr (hker k)
      let f : Fin (p.length + 1) → PrimeSpectrum (A i₀) := fun k => ⟨_, hprime k⟩
      have hf : StrictMono f := by
        intro a b hab
        have hlt : (p a).asIdeal < (p b).asIdeal :=
          (PrimeSpectrum.asIdeal_lt_asIdeal _ _).mpr (p.strictMono hab)
        refine (PrimeSpectrum.asIdeal_lt_asIdeal (f a) (f b)).mp ?_
        show Ideal.map ev (p a).asIdeal < Ideal.map ev (p b).asIdeal
        refine lt_of_le_of_ne (Ideal.map_mono hlt.le) (fun heq => hlt.ne ?_)
        rw [← hcomap a, ← hcomap b, heq]
      exact le_trans (Order.LTSeries.length_le_krullDim (LTSeries.mk p.length f hf))
        (Finset.le_sup (f := fun i => ringKrullDim (A i)) (Finset.mem_univ i₀))
    exact lt_of_le_of_lt hle ((Finset.sup_lt_iff hc).mpr (fun i _ => hA i))

theorem wc_ldp_double_generic_count (K : Type u) [Field K] [IsAlgClosed K] (N n : ℕ)
    (hn2 : 2 ≤ n) (X : Over (Spec (.of K))) [GeometricallyIrreducible X.hom] [IsProper X.hom]
    [SmoothOfRelativeDimension n X.hom] (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι)
    (hιX : ι ≫ wcProjKStr K N = X.hom) :
    ∃ (A : Type u) (_ : CommRing A) (_ : Algebra K A) (_ : Algebra.FiniteType K A),
      ringKrullDim A < (Fintype.card (Fin 2 × Fin (N + 1) × Fin (N + 1)) : WithBot ℕ∞) ∧
      ∃ φ : MvPolynomial (Fin 2 × Fin (N + 1) × Fin (N + 1)) K →ₐ[K] A,
        ∀ (v : Fin 2 × Fin (N + 1) × Fin (N + 1) → K) (x x' : X.left),
          IsClosed ({x} : Set X.left) → IsClosed ({x'} : Set X.left) → x ≠ x' →
          ∀ c : Fin 2 → K, c ≠ 0 →
          wcLdpSing2 K N ι (c 1 • (wcLdpQuad K N fun p q => v (0, p, q)) -
            c 0 • (wcLdpQuad K N fun p q => v (1, p, q))) x →
          wcLdpSing2 K N ι (c 1 • (wcLdpQuad K N fun p q => v (0, p, q)) -
            c 0 • (wcLdpQuad K N fun p q => v (1, p, q))) x' →
          ¬ wcLdpDT K N n ι x x' →
          ∃ χ : A →ₐ[K] K, ∀ Φ, χ (φ Φ) = MvPolynomial.eval v Φ :=
by
  classical

  have hchart := fun a => wc_ldp_dgc_chart_presentation K N n X ι hι hιX a
  choose I hIdim hIpt using hchart
  have hstrata := fun a => wc_ldp_dgc_jet_strata K N n (I a) (hIdim a)
  choose T C iC1 iC2 iC3 k ℓ hCdim hCpt using hstrata

  have hsing : ∀ (H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2) (y : X.left)
      (a : Fin (N + 1)) (hy : y ∈ ι ⁻¹ᵁ wcSgD K N a),
      wcLdpSing2 K N ι H y ↔
        wcLdpGerm K N ι H a y hy ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk y) ^ 2 := by
    intro H y a hy
    constructor
    · intro h
      exact h a hy
    · intro h b hyb
      obtain ⟨u, _, hEq⟩ := wc_ldp_cf_uniform_transition K N ι b a y hyb hy
      rw [hEq H]
      exact Ideal.mul_mem_left _ _ h

  have hcov : ∀ y : X.left, ∃ a, y ∈ ι ⁻¹ᵁ wcSgD K N a := by
    intro y
    have htop : (⨆ a : Fin (N + 1), wcSgD K N a) = ⊤ := wc_pp_basicOpen_cover K N
    have h : ι y ∈ (⨆ a : Fin (N + 1), wcSgD K N a) := by
      rw [htop]
      trivial
    obtain ⟨a, ha⟩ := (TopologicalSpace.Opens.mem_iSup (x := ι y)).mp h
    exact ⟨a, ha⟩

  have hpt : ∀ x : X.left, IsClosed ({x} : Set X.left) →
      ∃ (a : Fin (N + 1)) (t : Fin (T a)) (χ : C a t →ₐ[K] K),
        ∀ w : Fin (N + 1) → Fin (N + 1) → K,
          ((ℓ a t).map χ).mulVec (fun q => w q.1 q.2) = 0 ↔
            wcLdpSing2 K N ι (wcLdpQuad K N w) x := by
    intro x hx
    obtain ⟨a, hxa⟩ := hcov x
    obtain ⟨ξ, hξI, hξ⟩ := hIpt a x hxa hx
    obtain ⟨t, χ, hχ⟩ := hCpt a ξ hξI
    refine ⟨a, t, χ, fun w => ?_⟩
    rw [hχ w, ← hξ w, hsing _ x a hxa]

  have hpiece : ∀ p : (Σ a : Fin (N + 1), Σ t : Fin (T a), Σ b : Fin (N + 1), Σ t' : Fin (T b),
      (Fin (2 * n + 2) → Fin (k a t) ⊕ Fin (k b t')) ×
        (Fin (2 * n + 2) → Fin (N + 1) × Fin (N + 1))),
      ∃ (Ap : Type u) (_ : CommRing Ap) (_ : Algebra K Ap) (_ : Algebra.FiniteType K Ap),
      ringKrullDim Ap < (Fintype.card (Fin 2 × Fin (N + 1) × Fin (N + 1)) : WithBot ℕ∞) ∧
      ∃ φp : MvPolynomial (Fin 2 × Fin (N + 1) × Fin (N + 1)) K →ₐ[K] Ap,
        ∀ (χ : C p.1 p.2.1 →ₐ[K] K) (χ' : C p.2.2.1 p.2.2.2.1 →ₐ[K] K),
          ((Matrix.fromRows ((ℓ p.1 p.2.1).map χ) ((ℓ p.2.2.1 p.2.2.2.1).map χ')).submatrix
            p.2.2.2.2.1 p.2.2.2.2.2).det ≠ 0 →
          ∀ (τ : K) (g h : Fin (N + 1) × Fin (N + 1) → K),
          (Matrix.fromRows ((ℓ p.1 p.2.1).map χ) ((ℓ p.2.2.1 p.2.2.2.1).map χ')).mulVec h = 0 →
          (∃ ψ : Ap →ₐ[K] K, ∀ Φ, ψ (φp Φ) = MvPolynomial.eval
            (fun s : Fin 2 × Fin (N + 1) × Fin (N + 1) =>
              if s.1 = 0 then g s.2 else τ * g s.2 - h s.2) Φ) ∧
          (∃ ψ : Ap →ₐ[K] K, ∀ Φ, ψ (φp Φ) = MvPolynomial.eval
            (fun s : Fin 2 × Fin (N + 1) × Fin (N + 1) =>
              if s.1 = 0 then τ * g s.2 + h s.2 else g s.2) Φ) := by
    rintro ⟨a, t, b, t', r, cc⟩
    dsimp only
    obtain ⟨hfinD, hdimD⟩ :=
      wc_ldp_dgc_tensor_dim K (C a t) (C b t') n n (hCdim a t) (hCdim b t')
    haveI := hfinD
    obtain ⟨Lp, hLp⟩ : ∃ Lp : Matrix (Fin (k a t) ⊕ Fin (k b t')) (Fin (N + 1) × Fin (N + 1))
        (TensorProduct K (C a t) (C b t')),
        Lp = Matrix.fromRows ((ℓ a t).map fun z => z ⊗ₜ[K] (1 : C b t'))
          ((ℓ b t').map fun z => (1 : C a t) ⊗ₜ[K] z) := ⟨_, rfl⟩
    have hmap0 : ∀ (χ : C a t →ₐ[K] K) (χ' : C b t' →ₐ[K] K),
        Lp.map (Algebra.TensorProduct.productMap χ χ') =
          Matrix.fromRows ((ℓ a t).map χ) ((ℓ b t').map χ') := by
      intro χ χ'
      rw [hLp]
      ext i j
      rcases i with i | i <;>
        simp [Matrix.map_apply, Algebra.TensorProduct.productMap_apply_tmul]
    obtain ⟨ν, hν⟩ : ∃ ν : TensorProduct K (C a t) (C b t'), ν = (Lp.submatrix r cc).det :=
      ⟨_, rfl⟩
    have hdetΨ : ∀ Ψ : TensorProduct K (C a t) (C b t') →ₐ[K] K,
        Ψ ν = ((Lp.map Ψ).submatrix r cc).det := by
      intro Ψ
      rw [hν, AlgHom.map_det]
      rfl
    haveI : Algebra.FiniteType (TensorProduct K (C a t) (C b t')) (Localization.Away ν) :=
      IsLocalization.finiteType_of_monoid_fg (Submonoid.powers ν) (Localization.Away ν)
    haveI hfinB : Algebra.FiniteType K (Localization.Away ν) :=
      Algebra.FiniteType.trans (S := TensorProduct K (C a t) (C b t')) inferInstance inferInstance
    have hdimB : ringKrullDim (Localization.Away ν) ≤ ((n + n : ℕ) : WithBot ℕ∞) := by
      refine le_trans ?_ hdimD
      apply Order.krullDim_le_of_strictMono
        (PrimeSpectrum.comap (algebraMap (TensorProduct K (C a t) (C b t')) (Localization.Away ν)))
      apply Monotone.strictMono_of_injective
      · intro p q h
        exact Ideal.comap_mono h
      · exact PrimeSpectrum.localization_comap_injective _ (Submonoid.powers ν)
    have hL : ∀ Θ : Localization.Away ν →ₐ[K] K,
        2 * n + 2 ≤ ((Lp.map (algebraMap _ (Localization.Away ν))).map Θ).rank := by
      intro Θ
      apply (wc_ldp_dtc_rank_minor K _ (2 * n + 2)).mpr
      refine ⟨r, cc, ?_⟩
      have h1 := hdetΨ (Θ.comp (IsScalarTower.toAlgHom K _ (Localization.Away ν)))
      have h2 : ((Lp.map (algebraMap _ (Localization.Away ν))).map Θ).submatrix r cc =
          (Lp.map (Θ.comp (IsScalarTower.toAlgHom K _ (Localization.Away ν)))).submatrix r cc := by
        ext i j
        rfl
      rw [h2, ← h1]
      exact ((IsLocalization.Away.algebraMap_isUnit ν).map Θ).ne_zero
    obtain ⟨A', iA1, iA2, iA3, hdimA', φ', hφ'⟩ :=
      wc_ldp_dtc_fibre_count K N (Localization.Away ν) (n + n) (2 * n + 2) hdimB (by omega)
        (Lp.map (algebraMap _ (Localization.Away ν))) hL
    refine ⟨A', iA1, iA2, iA3, hdimA', φ', ?_⟩
    intro χ χ' hdet τ g h hh
    have hmin : Algebra.TensorProduct.productMap χ χ' ν ≠ 0 := by
      rw [hdetΨ, hmap0]
      exact hdet
    have hunit : ∀ y : Submonoid.powers ν,
        IsUnit (Algebra.TensorProduct.productMap χ χ' (y : TensorProduct K (C a t) (C b t'))) := by
      intro y
      obtain ⟨m, hm⟩ := (Submonoid.mem_powers_iff _ _).mp y.2
      rw [← hm, map_pow]
      exact (isUnit_iff_ne_zero.mpr hmin).pow m
    obtain ⟨Ψ, hval⟩ : ∃ Ψ : Localization.Away ν →ₐ[K] K,
        ∀ z, Ψ (algebraMap _ (Localization.Away ν) z) = Algebra.TensorProduct.productMap χ χ' z :=
      ⟨IsLocalization.liftAlgHom (M := Submonoid.powers ν) (S := Localization.Away ν) hunit,
        fun z => by
          rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
          rfl⟩
    have hLΨ : (Lp.map (algebraMap _ (Localization.Away ν))).map Ψ =
        Matrix.fromRows ((ℓ a t).map χ) ((ℓ b t').map χ') := by
      rw [← hmap0 χ χ']
      ext i j
      exact hval _
    exact hφ' Ψ τ g h (by rw [hLΨ]; exact hh)

  choose Ap iAp1 iAp2 iAp3 hAp φp hφp using hpiece
  have hbot : (⊥ : WithBot ℕ∞) <
      (Fintype.card (Fin 2 × Fin (N + 1) × Fin (N + 1)) : WithBot ℕ∞) :=
    bot_lt_iff_ne_bot.mpr (WithBot.natCast_ne_bot _)
  obtain ⟨hfinA, hdimA⟩ := wc_ldp_dtc_pi_dim K Ap _ hbot hAp
  refine ⟨∀ p, Ap p, inferInstance, inferInstance, hfinA, hdimA, AlgHom.pi φp, ?_⟩

  intro v x x' hx hx' hne c hc hs1 hs2 hnDT
  obtain ⟨a, t, χa, hχa⟩ := hpt x hx
  obtain ⟨b, t', χb, hχb⟩ := hpt x' hx'
  obtain ⟨P, hP⟩ : ∃ P : Matrix (Fin (k a t) ⊕ Fin (k b t')) (Fin (N + 1) × Fin (N + 1)) K,
      P = Matrix.fromRows ((ℓ a t).map χa) ((ℓ b t').map χb) := ⟨_, rfl⟩
  have hker : ∀ w : Fin (N + 1) → Fin (N + 1) → K,
      P.mulVec (fun q => w q.1 q.2) = 0 ↔
        wcLdpSing2 K N ι (wcLdpQuad K N w) x ∧ wcLdpSing2 K N ι (wcLdpQuad K N w) x' := by
    intro w
    rw [hP, Matrix.fromRows_mulVec, ← hχa w, ← hχb w]
    constructor
    · intro h
      exact ⟨funext fun i => congrFun h (Sum.inl i), funext fun i => congrFun h (Sum.inr i)⟩
    · rintro ⟨h1, h2⟩
      funext i
      rcases i with i | i
      · exact congrFun h1 i
      · exact congrFun h2 i

  have hminor : ∃ (r : Fin (2 * n + 2) → Fin (k a t) ⊕ Fin (k b t'))
      (cc : Fin (2 * n + 2) → Fin (N + 1) × Fin (N + 1)), (P.submatrix r cc).det ≠ 0 := by
    apply (wc_ldp_dtc_rank_minor K P (2 * n + 2)).mp
    by_contra hlt
    push_neg at hlt
    have hr : P.rank ≤ 2 * n + 1 := by omega
    apply hnDT
    let U : (Fin (N + 1) → Fin (N + 1) → K) →ₗ[K] (Fin (N + 1) × Fin (N + 1) → K) :=
      { toFun := fun w q => w q.1 q.2, map_add' := fun _ _ => rfl, map_smul' := fun _ _ => rfl }
    let Tm := P.mulVecLin ∘ₗ U
    have hTle : Module.finrank K (LinearMap.range Tm) ≤ 2 * n + 1 := by
      have h1 : LinearMap.range Tm ≤ LinearMap.range P.mulVecLin :=
        LinearMap.range_comp_le_range _ _
      exact (Submodule.finrank_mono h1).trans hr
    let bs := Module.finBasis K (LinearMap.range Tm)
    refine ⟨fun i => if h : (i : ℕ) < Module.finrank K (LinearMap.range Tm) then
        (bs.coord ⟨i, h⟩) ∘ₗ Tm.rangeRestrict else 0, ?_⟩
    intro w hw
    have h0 : Tm.rangeRestrict w = 0 := by
      apply bs.ext_elem
      intro j
      have hj := hw ⟨j, lt_of_lt_of_le j.2 hTle⟩
      simp only [Fin.is_lt, dite_true, Fin.eta, LinearMap.comp_apply,
        Module.Basis.coord_apply] at hj
      rw [hj, map_zero, Finsupp.zero_apply]
    have h1 : Tm w = 0 := by
      have h2 : ((Tm.rangeRestrict w : LinearMap.range Tm) :
          Fin (k a t) ⊕ Fin (k b t') → K) = Tm w := rfl
      rw [← h2, h0]
      rfl
    exact (hker w).mp h1
  obtain ⟨r, cc, hrc⟩ := hminor

  obtain ⟨w, hw⟩ : ∃ w : Fin (N + 1) → Fin (N + 1) → K,
      ∀ p q, w p q = c 1 * v (0, p, q) - c 0 * v (1, p, q) := ⟨_, fun _ _ => rfl⟩
  have hQ : wcLdpQuad K N w = c 1 • (wcLdpQuad K N fun p q => v (0, p, q)) -
      c 0 • (wcLdpQuad K N fun p q => v (1, p, q)) := by
    rw [show w = fun p q => c 1 * v (0, p, q) - c 0 * v (1, p, q) from
      funext fun p => funext fun q => hw p q]
    apply Subtype.ext
    simp only [wcLdpQuad, Submodule.coe_sub, Submodule.coe_smul, Finset.smul_sum,
      ← Finset.sum_sub_distrib, MvPolynomial.C_sub, MvPolynomial.C_mul, sub_mul,
      MvPolynomial.smul_eq_C_mul, mul_assoc]
  have hPw : P.mulVec (fun q => w q.1 q.2) = 0 :=
    (hker w).mpr ⟨by rw [hQ]; exact hs1, by rw [hQ]; exact hs2⟩
  subst hP

  by_cases h0 : c 0 = 0
  · have h1 : c 1 ≠ 0 := fun h1 => hc (funext fun i => by fin_cases i <;> simp [h0, h1])
    obtain ⟨ψ, hψ⟩ := (hφp ⟨a, t, b, t', r, cc⟩ χa χb hrc (c 0 / c 1)
      (fun q => v (1, q.1, q.2)) ((c 1)⁻¹ • fun q => w q.1 q.2)
      (by
        show (Matrix.fromRows ((ℓ a t).map χa) ((ℓ b t').map χb)).mulVec
          ((c 1)⁻¹ • fun q => w q.1 q.2) = 0
        rw [Matrix.mulVec_smul, hPw, smul_zero])).2
    refine ⟨ψ.comp (Pi.evalAlgHom K Ap ⟨a, t, b, t', r, cc⟩), fun Φ => ?_⟩
    show ψ (φp ⟨a, t, b, t', r, cc⟩ Φ) = _
    rw [hψ]
    refine congrArg (fun z => MvPolynomial.eval z Φ) ?_
    funext s
    obtain ⟨s, p, q⟩ := s
    fin_cases s <;> simp [hw, h0, h1]
  · obtain ⟨ψ, hψ⟩ := (hφp ⟨a, t, b, t', r, cc⟩ χa χb hrc (c 1 / c 0)
      (fun q => v (0, q.1, q.2)) ((c 0)⁻¹ • fun q => w q.1 q.2)
      (by
        show (Matrix.fromRows ((ℓ a t).map χa) ((ℓ b t').map χb)).mulVec
          ((c 0)⁻¹ • fun q => w q.1 q.2) = 0
        rw [Matrix.mulVec_smul, hPw, smul_zero])).1
    refine ⟨ψ.comp (Pi.evalAlgHom K Ap ⟨a, t, b, t', r, cc⟩), fun Φ => ?_⟩
    show ψ (φp ⟨a, t, b, t', r, cc⟩ Φ) = _
    rw [hψ]
    refine congrArg (fun z => MvPolynomial.eval z Φ) ?_
    funext s
    obtain ⟨s, p, q⟩ := s
    fin_cases s
    · simp
    · simp [hw]
      field_simp
      ring

theorem wc_ldp_dtc_nullstellensatz (K : Type u) [Field K] [IsAlgClosed K] (R : Type u)
    [CommRing R] [Algebra K R] [Algebra.FiniteType K R] :
    (Nontrivial R → Nonempty (R →ₐ[K] K)) ∧
    ∀ f : R, (∀ χ : R →ₐ[K] K, χ f = 0) → IsNilpotent f :=
by
  classical
  have s1 : ∀ (M : Ideal R), M.IsMaximal → ∃ χ : R →ₐ[K] K, ∀ r, χ r = 0 → r ∈ M := by
    intro M hM
    letI : Field (R ⧸ M) := Ideal.Quotient.field M
    haveI : Algebra.FiniteType K (R ⧸ M) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ K M) (Ideal.Quotient.mkₐ_surjective K M)
    haveI : Module.Finite K (R ⧸ M) := finite_of_finite_type_of_isJacobsonRing K (R ⧸ M)
    haveI : Algebra.IsIntegral K (R ⧸ M) := Algebra.IsIntegral.of_finite K (R ⧸ M)
    have hb : Function.Bijective (algebraMap K (R ⧸ M)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let e : K ≃ₐ[K] (R ⧸ M) := AlgEquiv.ofBijective (Algebra.ofId K (R ⧸ M)) hb
    refine ⟨(e.symm : (R ⧸ M) →ₐ[K] K).comp (Ideal.Quotient.mkₐ K M), fun r hr => ?_⟩
    have h1 : e.symm (Ideal.Quotient.mkₐ K M r) = 0 := hr
    have h2 : Ideal.Quotient.mkₐ K M r = 0 := by
      have := congrArg e h1
      rwa [AlgEquiv.apply_symm_apply, map_zero] at this
    rw [Ideal.Quotient.mkₐ_eq_mk] at h2
    exact Ideal.Quotient.eq_zero_iff_mem.mp h2
  refine ⟨fun h => ?_, fun f hf => ?_⟩
  · obtain ⟨M, hM⟩ := Ideal.exists_maximal R
    obtain ⟨χ, -⟩ := s1 M hM
    exact ⟨χ⟩
  · haveI : IsJacobsonRing R := isJacobsonRing_of_finiteType (A := K) (B := R)
    have hjac : f ∈ (⊥ : Ideal R).jacobson := by
      rw [Ideal.jacobson, Ideal.mem_sInf]
      intro J hJ
      obtain ⟨χ, hχ⟩ := s1 J hJ.2
      exact hχ f (hf χ)
    rw [← Ideal.radical_eq_jacobson, Ideal.mem_radical_iff] at hjac
    obtain ⟨n, hn⟩ := hjac
    exact ⟨n, (Ideal.mem_bot).mp hn⟩

theorem wc_ldp_dtc_chart_generated (K : Type u) [Field K] (N : ℕ) (X : Over (Spec (.of K)))
    (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr K N = X.hom)
    (a : Fin (N + 1)) :
    letI := (wcCnSigma X.hom (ι ⁻¹ᵁ wcSgD K N a)).toAlgebra
    Algebra.adjoin K (Set.range fun p => (ι.app (wcSgD K N a)).hom (wcSgE K N a p)) = ⊤ :=
by
  classical
  haveI : IsClosedImmersion ι := hι
  letI := (wcCnSigma X.hom (ι ⁻¹ᵁ wcSgD K N a)).toAlgebra
  have PG : ∀ (n : ℕ) (J : Fin (n + 1)) (x : Γ(wcProjK K n, wcSgD K n J)),
      x ∈ Subring.closure (Set.range (wcSgE K n J) ∪ Set.range (fun c : K => (wcProjK K n).presheaf.map
        (homOfLE (le_top : wcSgD K n J ≤ ⊤)).op ((wcProjKStr K n).appTop ((Scheme.ΓSpecIso (.of K)).inv c)))) := by
    intro n J x
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) := MvPolynomial.gradedAlgebra
    have hX : ∀ k : Fin (n + 1), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun k =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
    have GEN : ∀ (k : Fin (n + 1)) (d : ℕ) (F : MvPolynomial (Fin (n + 1)) K)
        (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (d • 1)),
        MvPolynomial.eval₂ ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X k))).comp
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))
          (fun l => HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX k) 1
            (MvPolynomial.X l) (hX l)) F =
        HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX k) d F hF := by
      intro k d F hF
      have hFh : F.IsHomogeneous d := by
        have := (MvPolynomial.mem_homogeneousSubmodule (d • 1) F).mp hF
        simpa using this
      have scale : ∀ {L : Type u} [CommRing L] (χ : K →+* L) (g : Fin (n + 1) → L) (t : L),
          MvPolynomial.eval₂ χ (fun l => g l * t) F = t ^ d * MvPolynomial.eval₂ χ g F := by
        intro L _ χ g t
        rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun e he => ?_)
        have hdeg : ∑ i ∈ e.support, e i = d := by
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp he) (hFh.coeff_eq_zero hne)
        simp_rw [mul_pow]
        rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
        ring
      apply HomogeneousLocalization.val_injective
      rw [← HomogeneousLocalization.algebraMap_apply, ← HomogeneousLocalization.algebraMap_apply,
        MvPolynomial.eval₂_comp_left, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk]
      calc _ = MvPolynomial.eval₂
            ((algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))).comp
              MvPolynomial.C)
            (fun l => algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))
              (MvPolynomial.X l) * Localization.mk 1 (⟨MvPolynomial.X k ^ 1, ⟨1, rfl⟩⟩ :
                Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K))) F := by
            congr 1
            funext l
            simp only [Function.comp_apply, HomogeneousLocalization.algebraMap_apply,
              HomogeneousLocalization.Away.val_mk, ← Localization.mk_one_eq_algebraMap,
              Localization.mk_mul, mul_one, one_mul]
        _ = _ := by
            rw [scale]
            have h2 := MvPolynomial.eval₂_comp_left (algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K))))
              MvPolynomial.C MvPolynomial.X F
            rw [MvPolynomial.eval₂_eta] at h2
            rw [show (fun l => algebraMap (MvPolynomial (Fin (n + 1)) K)
                (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))
                (MvPolynomial.X l)) = ⇑(algebraMap (MvPolynomial (Fin (n + 1)) K)
                (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))) ∘
                MvPolynomial.X from rfl, ← h2, Localization.mk_pow,
              ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, Localization.mk_eq_mk_iff,
              Localization.r_iff_exists]
            refine ⟨1, ?_⟩
            simp only [one_pow, one_mul, mul_one, OneMemClass.coe_one, SubmonoidClass.coe_pow, ← pow_mul]
    have hι : ∀ (U : (Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).Opens) a,
        U.ι.appTop a = U.topIso.inv ((Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op a) := by
      intro U a
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
      erw [← CategoryTheory.comp_apply, ← Functor.map_comp]
      rfl
    have hconst : ∀ c : K, (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
          (Submonoid.powers (MvPolynomial.X J)) (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0) c)) =
        ((Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).presheaf.map (homOfLE (le_top : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)) ≤ ⊤)).op).hom ((Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) 0)))).appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) := by
      intro c
      have e0 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).ι =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom ≫
            Proj.awayι _ (MvPolynomial.X J) (hX J) Nat.one_pos := by
        rw [← Proj.basicOpenIsoSpec_inv_ι, Iso.hom_inv_id_assoc]
      have e1 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).ι ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) 0)))) =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom ≫
            Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X J))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))) := by
        rw [e0, Category.assoc, Proj.awayι_toSpecZero_assoc, ← Spec.map_comp]
        rfl
      have e2 := congrArg (fun g => (Scheme.Hom.appTop g).hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) e1
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at e2
      have e3 := congrArg (fun g => g.hom c) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X J))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e3
      rw [← e3] at e2
      have hi : ∀ y, (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom.appTop
          ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).inv y) =
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv
            ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom y) := by
        intro y
        rw [Proj.basicOpenIsoSpec_hom]
        have hh := Proj.basicOpenToSpec_app_top (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)
        calc _ = ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).hom ≫ Proj.awayToSection _ (MvPolynomial.X J) ≫ (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv) ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).inv y) := by rw [← hh]
          _ = _ := by
            change (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv
              ((Proj.awayToSection _ (MvPolynomial.X J)) ((Scheme.ΓSpecIso _).hom ((Scheme.ΓSpecIso _).inv y))) = _
            rw [Iso.inv_hom_id_apply]
      have e4 := e2.trans (hi _)
      rw [hι] at e4
      have hinj : ∀ a b : Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K), Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)),
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv a =
            (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv b → a = b := by
        intro a b h
        have h' := congrArg (fun w => (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.hom w) h
        simp only [Iso.inv_hom_id_apply] at h'
        exact h'
      exact (hinj _ _ e4).symm
    have hs : Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (MvPolynomial.X J) ((Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos).inv x) = x := by
      have := Iso.inv_hom_id_apply (Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos) x
      rwa [Proj.basicOpenIsoAway_hom] at this
    obtain ⟨d, F, hF, hmk⟩ := HomogeneousLocalization.Away.mk_surjective
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX J)
      ((Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos).inv x)
    rw [← hs, ← hmk, ← GEN J d F hF]
    change (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom _ ∈ _
    rw [MvPolynomial.eval₂_comp_left]
    apply MvPolynomial.eval₂_mem
    · intro i _
      apply Subring.subset_closure
      right
      exact ⟨F.coeff i, (hconst (F.coeff i)).symm⟩
    · intro l
      apply Subring.subset_closure
      left
      exact ⟨l, rfl⟩
  have hD : IsAffineOpen (wcSgD K N a) :=
    @Proj.isAffineOpen_basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      MvPolynomial.gradedAlgebra (MvPolynomial.X a) 1
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a)) one_pos
  have hconst : ∀ c : K, (ι.app (wcSgD K N a)).hom ((wcProjK K N).presheaf.map
      (homOfLE (le_top : wcSgD K N a ≤ ⊤)).op ((wcProjKStr K N).appTop
        ((Scheme.ΓSpecIso (.of K)).inv c))) =
      algebraMap K Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) c := by
    intro c
    rw [RingHom.algebraMap_toAlgebra, ← hιX]
    have h := congrArg (fun φ => φ.hom ((wcProjKStr K N).appTop ((Scheme.ΓSpecIso (.of K)).inv c)))
      (ι.naturality (homOfLE (le_top : wcSgD K N a ≤ ⊤)).op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h
    rw [h]
    simp only [wcCnSigma, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    rfl
  rw [Algebra.eq_top_iff]
  intro y
  obtain ⟨z, rfl⟩ := Scheme.Hom.app_surjective ι (wcSgD K N a) hD y
  have hz := PG N a z
  have hmem : z ∈ (Algebra.adjoin K (Set.range fun p =>
      (ι.app (wcSgD K N a)).hom (wcSgE K N a p))).toSubring.comap (ι.app (wcSgD K N a)).hom := by
    refine (Subring.closure_le.mpr ?_) hz
    rintro _ (⟨p, rfl⟩ | ⟨c, rfl⟩)
    · exact Algebra.subset_adjoin ⟨p, rfl⟩
    · show _ ∈ Algebra.adjoin K _
      rw [hconst c]
      exact Subalgebra.algebraMap_mem _ c
  exact hmem

theorem wc_ldp_dtc_chart_lin (K : Type u) [Field K] (N : ℕ) (X : Over (Spec (.of K)))
    (ι : X.left ⟶ wcProjK K N) (hιX : ι ≫ wcProjKStr K N = X.hom) (a : Fin (N + 1)) :
    (ι.app (wcSgD K N a)).hom (wcSgE K N a a) = 1 ∧
    ∀ ℓ : Fin (N + 1) → K, (ι.app (wcSgD K N a)).hom
        (wcLdpSec K N (wcLdpQuad K N fun p q => if q = a then ℓ p else 0) a) =
      ∑ p, wcCnSigma X.hom (ι ⁻¹ᵁ wcSgD K N a) (ℓ p) *
        (ι.app (wcSgD K N a)).hom (wcSgE K N a p) :=
by
  have hEa : wcSgE K N a a = 1 := (wc_ldp_lnf_sec_quad K N a (fun _ _ => 0)).1
  refine ⟨by rw [hEa, map_one], fun ℓ => ?_⟩
  have hsig : ∀ (y : X.left) (hy : y ∈ ι ⁻¹ᵁ wcSgD K N a) (c : K),
      (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom
        (wcCnSigma X.hom (ι ⁻¹ᵁ wcSgD K N a) c) = wcLdpConst K X.hom y c := by
    intro y hy c
    simp only [wcCnSigma, wcLdpConst, RingHom.comp_apply]
    exact TopCat.Presheaf.germ_res_apply X.left.presheaf
      (homOfLE (le_top : ι ⁻¹ᵁ wcSgD K N a ≤ ⊤)) y hy _
  apply TopCat.Presheaf.section_ext X.left.sheaf (ι ⁻¹ᵁ wcSgD K N a)
  intro y hy
  have h4 := (wc_ldp_lnf_chart_germ K N X ι hιX
    (fun a p hp c => wc_ldp_il_proj_const K N a p hp c)
    (fun a w => wc_ldp_lnf_sec_quad K N a w) a y hy).2.2.2 ℓ
  change (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom _ =
    (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom _
  rw [h4, map_sum]
  refine Finset.sum_congr rfl (fun p _ => ?_)
  rw [map_mul, hsig]

theorem wc_ldp_dtc_chart_domain (K : Type u) [Field K] (n : ℕ) (X : Over (Spec (.of K)))
    [GeometricallyIrreducible X.hom] [SmoothOfRelativeDimension n X.hom] (U : X.left.Opens) :
    IsDomain Γ(X.left, U) ∨ Subsingleton Γ(X.left, U) :=
by
  haveI hdisc : DiscreteTopology (Spec (.of K)) := Subsingleton.discreteTopology
  haveI hirr : IrreducibleSpace X.left :=
    GeometricallyIrreducible.irreducibleSpace X.hom (fun V _ => isOpen_discrete _)
  haveI hred' : ∀ x : X.left, _root_.IsReduced (X.left.presheaf.stalk x) := fun x => by
    haveI := wcpa_smooth_stalk_isDomain K X.left X.hom n x
    infer_instance
  haveI hred : AlgebraicGeometry.IsReduced X.left := isReduced_of_isReduced_stalk X.left
  haveI hint : AlgebraicGeometry.IsIntegral X.left :=
    isIntegral_of_irreducibleSpace_of_isReduced X.left
  by_cases h : (U : Set X.left).Nonempty
  · haveI : Nonempty U := h.to_subtype
    exact Or.inl (IsIntegral.component_integral U)
  · exact Or.inr ⟨fun s s' => TopCat.Presheaf.section_ext X.left.sheaf U s s'
      (fun x hx => absurd ⟨x, hx⟩ h)⟩

theorem wc_ldp_dtc_chart_dim (K : Type u) [Field K] {Z : Scheme.{u}} (s : Z ⟶ Spec (.of K))
    (n : ℕ) [SmoothOfRelativeDimension n s] (U : Z.Opens) (hU : IsAffineOpen U) :
    ringKrullDim Γ(Z, U) ≤ n :=
by
  classical
  haveI : Smooth s := SmoothOfRelativeDimension.smooth n s
  haveI : JacobsonSpace Z := LocallyOfFiniteType.jacobsonSpace s
  haveI := hU.isOpenImmersion_fromSpec
  rw [ringKrullDim_le_iff_height_le]
  intro p hp
  obtain ⟨M, hM, hpM⟩ := Ideal.exists_le_maximal p hp.ne_top
  refine le_trans (WithBot.coe_le_coe.mpr (Ideal.height_mono hpM)) ?_
  obtain ⟨pt, hpt⟩ : ∃ pt : PrimeSpectrum Γ(Z, U), pt.asIdeal = M :=
    ⟨⟨M, hM.isPrime⟩, rfl⟩
  subst hpt
  have hyU : hU.fromSpec pt ∈ U := by
    rw [← SetLike.mem_coe, ← hU.range_fromSpec]
    exact ⟨pt, rfl⟩
  have hloc' := hU.isLocalization_stalk' pt hyU
  have hy : IsClosed ({hU.fromSpec pt} : Set Z) := by
    apply isClosed_singleton_of_isLocallyClosed_singleton
    have h1 : IsLocallyClosed ({pt} : Set (PrimeSpectrum Γ(Z, U))) :=
      ((PrimeSpectrum.isClosed_singleton_iff_isMaximal pt).mpr hM).isLocallyClosed
    have h2 := h1.image hU.fromSpec.isOpenEmbedding.isInducing
      hU.fromSpec.isOpenEmbedding.isOpen_range.isLocallyClosed
    convert h2 using 1
    ext y
    constructor
    · rintro rfl
      exact ⟨pt, Set.mem_singleton pt, rfl⟩
    · rintro ⟨q, hq, rfl⟩
      rw [Set.mem_singleton_iff] at hq
      subst hq
      exact Set.mem_singleton _
  have h3 := wc_lfi_smooth_stalk_dim K Z s n (hU.fromSpec pt) hy
  have h4 := @IsLocalization.AtPrime.ringKrullDim_eq_height _ _ pt.asIdeal _ _ _
    (TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨hU.fromSpec pt, hyU⟩) hloc'
  rw [h4] at h3
  exact h3.le

theorem wc_ldp_dtc_chart_frame (K : Type u) [Field K] (N n : ℕ) (X : Over (Spec (.of K)))
    [SmoothOfRelativeDimension n X.hom] (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι)
    (hιX : ι ≫ wcProjKStr K N = X.hom) (a : Fin (N + 1)) :
    letI := (wcCnSigma X.hom (ι ⁻¹ᵁ wcSgD K N a)).toAlgebra
    ∃ (t : ℕ) (D : Fin t → Derivation K Γ(X.left, ι ⁻¹ᵁ wcSgD K N a)
        Γ(X.left, ι ⁻¹ᵁ wcSgD K N a)),
      ∀ χ : Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) →ₐ[K] K,
        Module.finrank K (Submodule.span K (Set.range fun k => fun p =>
          χ (D k ((ι.app (wcSgD K N a)).hom (wcSgE K N a p))))) = n :=
by
  classical



  have s5 : ∀ (R : Type u) [CommRing R] [Algebra K R] (u : Fin (N + 1) → R),
      Algebra.adjoin K (Set.range u) = ⊤ → ∀ (χ : R →ₐ[K] K) (δ : R →ₗ[K] K),
      (∀ a b, δ (a * b) = χ a * δ b + χ b * δ a) → (∀ p, δ (u p) = 0) → ∀ r, δ r = 0 := by
    intro R _ _ u hu χ δ hδ h0
    have h1 : δ 1 = 0 := by
      have := hδ 1 1
      simp only [mul_one, map_one, one_mul] at this
      linear_combination -this
    intro r
    have hr : r ∈ Algebra.adjoin K (Set.range u) := hu ▸ Algebra.mem_top
    induction hr using Algebra.adjoin_induction with
    | mem x hx => obtain ⟨p, rfl⟩ := hx; exact h0 p
    | algebraMap c => rw [Algebra.algebraMap_eq_smul_one, map_smul, h1, smul_zero]
    | add x y _ _ hx hy => rw [map_add, hx, hy, add_zero]
    | mul x y _ _ hx hy => rw [hδ, hx, hy, mul_zero, mul_zero, add_zero]



  have s3 : ∀ (R : Type u) [CommRing R] [Algebra K R] [Algebra.FiniteType K R]
      [Algebra.FormallySmooth K R], ∃ (t : ℕ) (D : Fin t → Derivation K R R),
      ∀ (χ : R →ₐ[K] K) (δ : R →ₗ[K] K), (∀ a b, δ (a * b) = χ a * δ b + χ b * δ a) →
        ∃ c : Fin t → K, ∀ r, δ r = ∑ k, c k * χ (D k r) := by
    intro R _ _ _ _
    haveI : Algebra.EssFiniteType K R := Algebra.EssFiniteType.of_finiteType K R
    haveI : Module.Finite R Ω[R⁄K] := KaehlerDifferential.finite K R
    haveI : Module.Projective R Ω[R⁄K] := Algebra.FormallySmooth.projective_kaehlerDifferential
    obtain ⟨t, f, g, -, -, hfg⟩ := Module.Finite.exists_comp_eq_id_of_projective R Ω[R⁄K]
    refine ⟨t, fun k => ((LinearMap.proj k : (Fin t → R) →ₗ[R] R) ∘ₗ g).compDer
      (KaehlerDifferential.D K R), ?_⟩
    intro χ δ hδ
    letI : Algebra R K := χ.toRingHom.toAlgebra
    haveI : IsScalarTower K R K := IsScalarTower.of_algebraMap_eq (fun c => (χ.commutes c).symm)
    let δ' : Derivation K R K := Derivation.mk' δ (fun a b => by
      change δ (a * b) = χ a * δ b + χ b * δ a
      exact hδ a b)
    refine ⟨fun k => δ'.liftKaehlerDifferential (f (fun j => if k = j then 1 else 0)),
      fun r => ?_⟩
    have e1 : δ r = δ'.liftKaehlerDifferential (f (g (KaehlerDifferential.D K R r))) := by
      rw [← LinearMap.comp_apply f g, hfg, LinearMap.id_apply,
        Derivation.liftKaehlerDifferential_comp_D]
      rfl
    rw [e1]
    conv_lhs => rw [pi_eq_sum_univ (g (KaehlerDifferential.D K R r))]
    rw [map_sum, map_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [map_smul, map_smul, mul_comm]
    rfl



  have s6 : ∀ (R : Type u) [CommRing R] [Algebra K R] (χ : R →ₐ[K] K) (t : ℕ)
      (u : Fin (N + 1) → R) (D : Fin t → Derivation K R R) (δ : Fin n → (R →ₗ[K] K)),
      (∀ i a b, δ i (a * b) = χ a * δ i b + χ b * δ i a) →
      (∀ g : Fin n → K, (∀ r, ∑ i, g i * δ i r = 0) → ∀ i, g i = 0) →
      (∀ δ' : R →ₗ[K] K, (∀ a b, δ' (a * b) = χ a * δ' b + χ b * δ' a) →
        ∃ c : Fin n → K, ∀ r, δ' r = ∑ i, c i * δ i r) →
      (∀ δ' : R →ₗ[K] K, (∀ a b, δ' (a * b) = χ a * δ' b + χ b * δ' a) →
        ∃ c : Fin t → K, ∀ r, δ' r = ∑ k, c k * χ (D k r)) →
      (∀ δ' : R →ₗ[K] K, (∀ a b, δ' (a * b) = χ a * δ' b + χ b * δ' a) →
        (∀ p, δ' (u p) = 0) → ∀ r, δ' r = 0) →
      Module.finrank K (Submodule.span K (Set.range fun k => fun p => χ (D k (u p)))) = n := by
    intro R _ _ χ t u D δ hδ hind hspan hD hu
    set w : Fin n → Fin (N + 1) → K := fun i p => δ i (u p) with hw
    have hρ : ∀ k, ∀ a b, (χ.toLinearMap ∘ₗ ((D k).toLinearMap)) (a * b) =
        χ a * (χ.toLinearMap ∘ₗ (D k).toLinearMap) b +
          χ b * (χ.toLinearMap ∘ₗ (D k).toLinearMap) a := by
      intro k a b
      change χ (D k (a * b)) = χ a * χ (D k b) + χ b * χ (D k a)
      rw [Derivation.leibniz, map_add, smul_eq_mul, smul_eq_mul, map_mul, map_mul]
    have hEq : Submodule.span K (Set.range fun k => fun p => χ (D k (u p))) =
        Submodule.span K (Set.range w) := by
      apply le_antisymm
      · rw [Submodule.span_le]
        rintro _ ⟨k, rfl⟩
        obtain ⟨c, hc⟩ := hspan _ (hρ k)
        rw [SetLike.mem_coe, Submodule.mem_span_range_iff_exists_fun]
        refine ⟨c, ?_⟩
        funext p
        simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, hw]
        exact (hc (u p)).symm
      · rw [Submodule.span_le]
        rintro _ ⟨i, rfl⟩
        obtain ⟨c, hc⟩ := hD _ (hδ i)
        rw [SetLike.mem_coe, Submodule.mem_span_range_iff_exists_fun]
        refine ⟨c, ?_⟩
        funext p
        simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, hw]
        exact (hc (u p)).symm
    have hli : LinearIndependent K w := by
      rw [Fintype.linearIndependent_iff]
      intro g hg
      let δ' : R →ₗ[K] K := ∑ i, g i • δ i
      have hδ'apply : ∀ r, δ' r = ∑ i, g i * δ i r := by
        intro r
        simp [δ']
      apply hind g
      intro r
      rw [← hδ'apply]
      apply hu δ'
      · intro a b
        simp only [hδ'apply, hδ, Finset.mul_sum, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        ring
      · intro p
        rw [hδ'apply]
        have := congrFun hg p
        simpa [hw] using this
    rw [hEq, finrank_span_eq_card hli, Fintype.card_fin]



  have s4 : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra K R] [Algebra K S]
      [Algebra R S] [IsScalarTower K R S] (M : Submonoid R) [IsLocalization M S]
      (χ : R →ₐ[K] K), (∀ m ∈ M, χ m ≠ 0) → Module.Free S Ω[S⁄K] →
      Module.Finite S Ω[S⁄K] → Module.finrank S Ω[S⁄K] = n →
      ∃ δ : Fin n → (R →ₗ[K] K), (∀ i a b, δ i (a * b) = χ a * δ i b + χ b * δ i a) ∧
        (∀ g : Fin n → K, (∀ r, ∑ i, g i * δ i r = 0) → ∀ i, g i = 0) ∧
        ∀ δ' : R →ₗ[K] K, (∀ a b, δ' (a * b) = χ a * δ' b + χ b * δ' a) →
          ∃ c : Fin n → K, ∀ r, δ' r = ∑ i, c i * δ i r := by
    intro R S _ _ _ _ _ _ M _ χ hM hfree hfin hn
    have hunit : ∀ y : M, IsUnit ((χ : R →+* K) y) := fun y =>
      isUnit_iff_ne_zero.mpr (hM y y.2)
    let χS : S →+* K := IsLocalization.lift hunit
    have hχS : ∀ r, χS (algebraMap R S r) = χ r := fun r => IsLocalization.lift_eq hunit r
    have hχSK : ∀ c : K, χS (algebraMap K S c) = c := by
      intro c
      rw [IsScalarTower.algebraMap_apply K R S, hχS, AlgHom.commutes]
      rfl
    let χSA : S →ₐ[K] K := { χS with commutes' := hχSK }
    haveI : Nontrivial S := RingHom.domain_nontrivial χS
    haveI := hfree
    haveI := hfin
    let B := Module.finBasisOfFinrankEq S Ω[S⁄K] hn
    let dS := KaehlerDifferential.D K S
    let θ : Fin n → Derivation K S S := fun i => (B.coord i).compDer dS
    have hθ : ∀ i s, θ i s = B.coord i (dS s) := fun i s => rfl
    let δ : Fin n → (R →ₗ[K] K) := fun i =>
      χSA.toLinearMap ∘ₗ (θ i).toLinearMap ∘ₗ (IsScalarTower.toAlgHom K R S).toLinearMap
    have hδ : ∀ i r, δ i r = χS (B.coord i (dS (algebraMap R S r))) := fun i r => rfl
    have key : ∀ φ : Ω[S⁄K] →ₗ[S] S, (∀ r, χS (φ (dS (algebraMap R S r))) = 0) →
        ∀ ω, χS (φ ω) = 0 := by
      intro φ hφ
      let E : Derivation K S S := φ.compDer dS
      have hE : ∀ s, E s = φ (dS s) := fun s => rfl
      have hgen : ∀ s, χS (φ (dS s)) = 0 := by
        intro s
        obtain ⟨⟨r, m⟩, hs⟩ := IsLocalization.surj M s
        simp only at hs
        have h1 : χS (E (s * algebraMap R S m)) = χS (E (algebraMap R S r)) := by rw [hs]
        rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, map_add, map_mul, map_mul,
          hE, hE, hE, hφ, hφ, mul_zero, zero_add, hχS] at h1
        exact (mul_eq_zero.mp h1).resolve_left (hM m m.2)
      intro ω
      have hω : ω ∈ Submodule.span S (Set.range dS) := by
        rw [KaehlerDifferential.span_range_derivation]; trivial
      induction hω using Submodule.span_induction with
      | mem x hx => obtain ⟨s, rfl⟩ := hx; exact hgen s
      | zero => rw [map_zero, map_zero]
      | add x y _ _ hx hy => rw [map_add, map_add, hx, hy, add_zero]
      | smul a x _ hx => rw [map_smul, smul_eq_mul, map_mul, hx, mul_zero]
    refine ⟨δ, ?_, ?_, ?_⟩
    · intro i a b
      rw [hδ, hδ, hδ, map_mul, ← hθ, Derivation.leibniz, smul_eq_mul, smul_eq_mul, map_add,
        map_mul, map_mul, hχS, hχS, hθ, hθ]
    · intro g hg
      let φ : Ω[S⁄K] →ₗ[S] S := ∑ i, algebraMap K S (g i) • B.coord i
      have hφ : ∀ ω, φ ω = ∑ i, algebraMap K S (g i) * B.coord i ω := by
        intro ω
        simp [φ, Algebra.smul_def]
      have hall := key φ (by
        intro r
        rw [hφ, map_sum, ← hg r]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [map_mul, hχSK, hδ])
      intro j
      have := hall (B j)
      rw [hφ, Finset.sum_eq_single j] at this
      · rw [Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_eq_same, mul_one,
          hχSK] at this
        exact this
      · intro i _ hij
        rw [Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply,
          if_neg (Ne.symm hij), mul_zero]
      · intro h; exact absurd (Finset.mem_univ j) h
    · intro δ' hδ'
      have h1 : δ' 1 = 0 := by
        have := hδ' 1 1
        simp only [mul_one, map_one, one_mul] at this
        linear_combination -this
      let ψ : R →+* TrivSqZeroExt K K :=
        { toFun := fun r => TrivSqZeroExt.inl (χ r) + TrivSqZeroExt.inr (δ' r)
          map_one' := by
            ext <;> simp [h1]
          map_mul' := by
            intro x y
            ext
            · simp
            · simp [hδ']
              ring
          map_zero' := by
            ext <;> simp
          map_add' := by
            intro x y
            ext
            · simp
            · simp }
      have hψfst : ∀ r, (ψ r).fst = χ r := fun r => by simp [ψ]
      have hψsnd : ∀ r, (ψ r).snd = δ' r := fun r => by simp [ψ]
      have hψunit : ∀ y : M, IsUnit (ψ y) := by
        intro y
        rw [TrivSqZeroExt.isUnit_iff_isUnit_fst, hψfst]
        exact isUnit_iff_ne_zero.mpr (hM y y.2)
      let Ψ : S →+* TrivSqZeroExt K K := IsLocalization.lift hψunit
      have hΨ : ∀ r, Ψ (algebraMap R S r) = ψ r := fun r => IsLocalization.lift_eq hψunit r
      have hΨfst : ∀ s, (Ψ s).fst = χS s := by
        intro s
        obtain ⟨⟨r, m⟩, hs⟩ := IsLocalization.surj M s
        simp only at hs
        have e1 := congrArg (fun z => (Ψ z).fst) hs
        have e2 := congrArg χS hs
        simp only [map_mul, TrivSqZeroExt.fst_mul, hΨ, hψfst, hχS] at e1 e2
        have hm := hM m m.2
        apply mul_right_cancel₀ hm
        rw [e1, e2]
      let E' : S → K := fun s => (Ψ s).snd
      have hE'mul : ∀ x y, E' (x * y) = χS x * E' y + χS y * E' x := by
        intro x y
        simp only [E', map_mul, TrivSqZeroExt.snd_mul, hΨfst, smul_eq_mul,
          MulOpposite.smul_eq_mul_unop, MulOpposite.unop_op]
        ring
      have hE'add : ∀ x y, E' (x + y) = E' x + E' y := by
        intro x y
        simp only [E', map_add, TrivSqZeroExt.snd_add]
      have hE'alg : ∀ c : K, E' (algebraMap K S c) = 0 := by
        intro c
        simp only [E']
        rw [IsScalarTower.algebraMap_apply K R S, hΨ, hψsnd, Algebra.algebraMap_eq_smul_one,
          map_smul, h1, smul_zero]
      let E'l : S →ₗ[K] K :=
        { toFun := E'
          map_add' := hE'add
          map_smul' := by
            intro c x
            rw [Algebra.smul_def, hE'mul, hE'alg, hχSK, mul_zero, add_zero]
            rfl }
      letI : Algebra S K := χS.toAlgebra
      haveI : IsScalarTower K S K :=
        IsScalarTower.of_algebraMap_eq (fun c => (hχSK c).symm)
      let Ed : Derivation K S K := Derivation.mk' E'l (fun a b => by
        change E' (a * b) = χS a * E' b + χS b * E' a
        exact hE'mul a b)
      let lam := Ed.liftKaehlerDifferential
      refine ⟨fun i => lam (B i), fun r => ?_⟩
      have e1 : δ' r = lam (dS (algebraMap R S r)) := by
        rw [Derivation.liftKaehlerDifferential_comp_D]
        change δ' r = E' (algebraMap R S r)
        simp only [E', hΨ, hψsnd]
      rw [e1]
      conv_lhs => rw [← B.sum_repr (dS (algebraMap R S r))]
      rw [map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_smul, hδ, Module.Basis.coord_apply, mul_comm]
      rfl



  have s1 : ∀ (U : X.left.Opens), IsAffineOpen U →
      letI := (wcCnSigma X.hom U).toAlgebra; Algebra.Smooth K Γ(X.left, U) := by
    intro U hU
    haveI : Smooth X.hom := SmoothOfRelativeDimension.smooth n X.hom
    have e : U ≤ X.hom ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
    have h1 := HasRingHomProperty.appLE @Smooth X.hom ‹Smooth X.hom›
      ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ e
    have h2 : (wcCnSigma X.hom U) =
        (X.hom.appLE ⊤ U e).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom := by
      rfl
    have h3 : (wcCnSigma X.hom U).Smooth := by
      rw [h2]
      refine RingHom.Smooth.comp ?_ h1
      apply RingHom.Smooth.of_bijective
      exact (Scheme.ΓSpecIso (CommRingCat.of K)).symm.commRingCatIsoToRingEquiv.bijective
    exact RingHom.Smooth.toAlgebra h3



  have s2 : ∀ (U : X.left.Opens), IsAffineOpen U →
      letI := (wcCnSigma X.hom U).toAlgebra
      ∀ χ : Γ(X.left, U) →ₐ[K] K, ∃ (S : Type u) (_ : CommRing S) (_ : Algebra Γ(X.left, U) S)
        (_ : Algebra K S) (_ : IsScalarTower K Γ(X.left, U) S) (M : Submonoid Γ(X.left, U))
        (_ : IsLocalization M S), (∀ m ∈ M, χ m ≠ 0) ∧ Module.Free S Ω[S⁄K] ∧
          Module.Finite S Ω[S⁄K] ∧ Module.finrank S Ω[S⁄K] = n := by
    intro U hU χ
    letI : Algebra K Γ(X.left, U) := (wcCnSigma X.hom U).toAlgebra
    haveI hP : (RingHom.ker χ).IsPrime := RingHom.ker_isPrime χ
    let 𝔭 : Spec Γ(X.left, U) := (⟨RingHom.ker χ, hP⟩ : PrimeSpectrum Γ(X.left, U))
    have hx : hU.fromSpec 𝔭 ∈ U := by
      have : hU.fromSpec 𝔭 ∈ (U : Set X.left) := by
        rw [← hU.range_fromSpec]; exact ⟨𝔭, rfl⟩
      exact this
    let y : U := ⟨hU.fromSpec 𝔭, hx⟩
    have hy : hU.primeIdealOf y = 𝔭 :=
      hU.fromSpec.isOpenEmbedding.injective (by rw [hU.fromSpec_primeIdealOf])
    letI : Algebra K (X.left.presheaf.stalk (hU.fromSpec 𝔭)) :=
      (wcLdpConst K X.hom (hU.fromSpec 𝔭)).toAlgebra
    letI : Algebra Γ(X.left, U) (X.left.presheaf.stalk (hU.fromSpec 𝔭)) :=
      TopCat.Presheaf.algebra_section_stalk X.left.presheaf y
    haveI : IsScalarTower K Γ(X.left, U) (X.left.presheaf.stalk (hU.fromSpec 𝔭)) := by
      refine IsScalarTower.of_algebraMap_eq (fun c => ?_)
      show wcLdpConst K X.hom (hU.fromSpec 𝔭) c =
        (X.left.presheaf.germ U (hU.fromSpec 𝔭) hx).hom (wcCnSigma X.hom U c)
      simp only [wcLdpConst, wcCnSigma, RingHom.comp_apply]
      exact (TopCat.Presheaf.germ_res_apply X.left.presheaf (homOfLE le_top) _ hx _).symm
    haveI hloc : IsLocalization (hU.primeIdealOf y).asIdeal.primeCompl
        (X.left.presheaf.stalk (hU.fromSpec 𝔭)) := hU.isLocalization_stalk y
    obtain ⟨-, h1, h2, h3, -⟩ := wc_ldp_il_stalk_of_smooth_field K X.hom n (hU.fromSpec 𝔭)
    refine ⟨X.left.presheaf.stalk (hU.fromSpec 𝔭), inferInstance, inferInstance, inferInstance,
      inferInstance, (hU.primeIdealOf y).asIdeal.primeCompl, hloc, ?_, h1, h2, h3⟩
    intro m hm h0
    apply hm
    rw [hy]
    exact RingHom.mem_ker.mpr h0



  letI inst : Algebra K Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) :=
    (wcCnSigma X.hom (ι ⁻¹ᵁ wcSgD K N a)).toAlgebra
  haveI : IsClosedImmersion ι := hι
  have hU : IsAffineOpen (ι ⁻¹ᵁ wcSgD K N a) :=
    (@Proj.isAffineOpen_basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      MvPolynomial.gradedAlgebra (MvPolynomial.X a) 1
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a))
      one_pos).preimage ι
  have hgen : Algebra.adjoin K
      (Set.range fun p => (ι.app (wcSgD K N a)).hom (wcSgE K N a p)) = ⊤ :=
    wc_ldp_dtc_chart_generated K N X ι hι hιX a
  haveI hFT : Algebra.FiniteType K Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) := by
    refine ⟨⟨Finset.univ.image (fun p => (ι.app (wcSgD K N a)).hom (wcSgE K N a p)), ?_⟩⟩
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
    exact hgen
  haveI hsm : Algebra.Smooth K Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) := s1 _ hU
  haveI : Algebra.FormallySmooth K Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) :=
    Algebra.Smooth.formallySmooth
  obtain ⟨t, D, hD⟩ := s3 Γ(X.left, ι ⁻¹ᵁ wcSgD K N a)
  refine ⟨t, D, fun χ => ?_⟩
  obtain ⟨S, _, _, _, _, M, _, hM, hfree, hfin, hrk⟩ := s2 _ hU χ
  obtain ⟨δ, hδ, hind, hspan⟩ := s4 Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) S M χ hM hfree hfin hrk
  exact s6 Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) χ t
    (fun p => (ι.app (wcSgD K N a)).hom (wcSgE K N a p)) D δ hδ hind hspan (hD χ)
    (fun δ' h h0 => s5 Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) _ hgen χ δ' h h0)

theorem wc_ldp_cf_rational_point (K : Type u) [Field K] [IsAlgClosed K] {Z : Scheme.{u}}
    (s : Z ⟶ Spec (.of K)) [hs : LocallyOfFiniteType s] (x : Z)
    (hx : IsClosed ({x} : Set Z)) :
    (∃ y : Spec (.of K) ⟶ Z, y ≫ s = 𝟙 _ ∧ y (IsLocalRing.closedPoint K) = x) ∧
      ∀ r : Z.presheaf.stalk x, ∃ c : K,
        r - wcLdpConst K s x c ∈ IsLocalRing.maximalIdeal (Z.presheaf.stalk x) :=
by
  classical
  set φ : CommRingCat.of K ⟶ Z.residueField x :=
    CommRingCat.ofHom (wcLdpConst K s x) ≫ Z.residue x with hφdef
  have hconst : CommRingCat.ofHom (wcLdpConst K s x) =
      (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ s.appTop ≫ Z.presheaf.germ ⊤ x trivial := by
    rfl
  have hstalk : Z.fromSpecStalk x ≫ s = Spec.map (CommRingCat.ofHom (wcLdpConst K s x)) := by
    calc Z.fromSpecStalk x ≫ s
        = Z.fromSpecStalk x ≫ s ≫ (Spec (CommRingCat.of K)).toSpecΓ ≫
            Spec.map (Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
          rw [toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
      _ = Z.fromSpecStalk x ≫ Z.toSpecΓ ≫ Spec.map s.appTop ≫
            Spec.map (Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
          rw [← Category.assoc s, Scheme.toSpecΓ_naturality, Category.assoc]
      _ = Spec.map (Z.presheaf.germ ⊤ x trivial) ≫ Spec.map s.appTop ≫
            Spec.map (Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
          rw [← Category.assoc, Scheme.fromSpecStalk_toSpecΓ]
      _ = Spec.map (CommRingCat.ofHom (wcLdpConst K s x)) := by
          rw [hconst, Spec.map_comp, Spec.map_comp, Category.assoc]
  have hcompat : Z.fromSpecResidueField x ≫ s = Spec.map φ := by
    rw [hφdef, Spec.map_comp, Scheme.fromSpecResidueField, Category.assoc, hstalk]
  haveI : JacobsonSpace Z := LocallyOfFiniteType.jacobsonSpace s
  haveI : LocallyOfFiniteType (Z.fromSpecResidueField x) :=
    isClosed_singleton_iff_locallyOfFiniteType.mp hx
  have h1 : LocallyOfFiniteType (Spec.map φ) := by
    rw [← hcompat]; infer_instance
  have h2 : φ.hom.FiniteType := (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp h1
  have h3 : φ.hom.Finite := RingHom.finite_iff_finiteType_of_isJacobsonRing.mpr h2
  have hbij : Function.Bijective φ.hom :=
    IsAlgClosed.ringHom_bijective_of_isIntegral φ.hom h3.to_isIntegral
  let e : K ≃+* Z.residueField x := RingEquiv.ofBijective φ.hom hbij
  have he : ∀ c, e c = φ.hom c := fun _ => rfl
  refine ⟨⟨Spec.map (CommRingCat.ofHom (e.symm : Z.residueField x →+* K)) ≫
    Z.fromSpecResidueField x, ?_, ?_⟩, ?_⟩
  · rw [Category.assoc, hcompat, ← Spec.map_comp]
    have hid : φ ≫ CommRingCat.ofHom (e.symm : Z.residueField x →+* K) = 𝟙 _ := by
      ext c
      show e.symm (φ.hom c) = c
      rw [← he, RingEquiv.symm_apply_apply]
    exact (congrArg Spec.map hid).trans (by rw [Spec.map_id])
  · have hpt : ∀ p : Spec (CommRingCat.of K),
        (Spec.map (CommRingCat.ofHom (e.symm : Z.residueField x →+* K)) ≫
          Z.fromSpecResidueField x) p = x := by
      intro p
      rw [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
    exact hpt (IsLocalRing.closedPoint K)
  · intro r
    refine ⟨e.symm ((Z.residue x).hom r), ?_⟩
    rw [← IsLocalRing.residue_eq_zero_iff, map_sub, sub_eq_zero]
    have h := e.apply_symm_apply ((Z.residue x).hom r)
    rw [he] at h
    exact h.symm

theorem wc_ldp_dtc_rational_eval (K : Type u) [Field K] [IsAlgClosed K] {Z : Scheme.{u}}
    (s : Z ⟶ Spec (.of K)) [LocallyOfFiniteType s] (U : Z.Opens) (x : Z) (hx : x ∈ U)
    (hxc : IsClosed ({x} : Set Z)) :
    letI := (wcCnSigma s U).toAlgebra
    ∃ χ : Γ(Z, U) →ₐ[K] K, ∀ r, (Z.presheaf.germ U x hx).hom r - wcLdpConst K s x (χ r) ∈
      IsLocalRing.maximalIdeal (Z.presheaf.stalk x) :=
by
  classical
  letI := (wcCnSigma s U).toAlgebra

  have hgs : ∀ c : K, (Z.presheaf.germ U x hx).hom (wcCnSigma s U c) = wcLdpConst K s x c := by
    intro c
    simp only [wcCnSigma, wcLdpConst, RingHom.comp_apply]
    exact TopCat.Presheaf.germ_res_apply _ _ _ _ _

  set ρ : K →+* IsLocalRing.ResidueField (Z.presheaf.stalk x) :=
    (IsLocalRing.residue (Z.presheaf.stalk x)).comp (wcLdpConst K s x) with hρ
  have hρbij : Function.Bijective ρ := by
    refine ⟨ρ.injective, fun y => ?_⟩
    obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective y
    obtain ⟨c, hc⟩ := (wc_ldp_cf_rational_point K s x hxc).2 r
    refine ⟨c, ?_⟩
    have h0 := (IsLocalRing.residue_eq_zero_iff _).mpr hc
    rw [map_sub, sub_eq_zero] at h0
    rw [hρ, RingHom.comp_apply, h0]
  set e := RingEquiv.ofBijective ρ hρbij with he
  have heρ : ∀ c, e c = IsLocalRing.residue (Z.presheaf.stalk x) (wcLdpConst K s x c) := fun c => rfl
  let χ₀ : Γ(Z, U) →+* K := e.symm.toRingHom.comp
    ((IsLocalRing.residue (Z.presheaf.stalk x)).comp (Z.presheaf.germ U x hx).hom)
  have hχ₀ : ∀ r, χ₀ r = e.symm (IsLocalRing.residue (Z.presheaf.stalk x)
      ((Z.presheaf.germ U x hx).hom r)) := fun r => rfl
  refine ⟨{ χ₀ with commutes' := fun c => ?_ }, fun r => ?_⟩
  · show χ₀ (wcCnSigma s U c) = c
    rw [hχ₀, hgs, ← heρ, RingEquiv.symm_apply_apply]
  · show (Z.presheaf.germ U x hx).hom r - wcLdpConst K s x (χ₀ r) ∈ _
    rw [← IsLocalRing.residue_eq_zero_iff, map_sub, ← heρ, hχ₀, RingEquiv.apply_symm_apply,
      sub_self]

theorem wc_ldp_dtc_chart_jet (K : Type u) [Field K] (N : ℕ) (X : Over (Spec (.of K)))
    (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr K N = X.hom)
    (a : Fin (N + 1)) (x : X.left) (hx : x ∈ ι ⁻¹ᵁ wcSgD K N a) :
    letI := (wcCnSigma X.hom (ι ⁻¹ᵁ wcSgD K N a)).toAlgebra
    ∀ χ : Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) →ₐ[K] K,
      (∀ r, (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) x hx).hom r - wcLdpConst K X.hom x (χ r) ∈
        IsLocalRing.maximalIdeal (X.left.presheaf.stalk x)) →
      ∀ w : Fin (N + 1) → Fin (N + 1) → K,
      wcLdpGerm K N ι (wcLdpQuad K N w) a x hx ∈
        IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ^ 2 →
      (∑ q : Fin (N + 1) × Fin (N + 1),
          χ ((ι.app (wcSgD K N a)).hom (wcSgE K N a q.1)) *
            χ ((ι.app (wcSgD K N a)).hom (wcSgE K N a q.2)) * w q.1 q.2 = 0) ∧
      ∀ D : Derivation K Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) Γ(X.left, ι ⁻¹ᵁ wcSgD K N a),
        ∑ q : Fin (N + 1) × Fin (N + 1),
          (χ ((ι.app (wcSgD K N a)).hom (wcSgE K N a q.1)) *
              χ (D ((ι.app (wcSgD K N a)).hom (wcSgE K N a q.2))) +
            χ (D ((ι.app (wcSgD K N a)).hom (wcSgE K N a q.1))) *
              χ ((ι.app (wcSgD K N a)).hom (wcSgE K N a q.2))) * w q.1 q.2 = 0 :=
by
  classical
  intro χ hχ w hw
  letI : Algebra K Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) := (wcCnSigma X.hom (ι ⁻¹ᵁ wcSgD K N a)).toAlgebra
  haveI : IsClosedImmersion ι := hι

  have hU : IsAffineOpen (ι ⁻¹ᵁ wcSgD K N a) :=
    (@Proj.isAffineOpen_basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      MvPolynomial.gradedAlgebra (MvPolynomial.X a) 1
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a))
      one_pos).preimage ι

  have hconstP : ∀ (p : wcProjK K N) (hp : p ∈ wcSgD K N a) (c : K),
      ((wcProjK K N).presheaf.germ (wcSgD K N a) p hp).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)).hom
          (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c))) =
        wcLdpConst K (wcProjKStr K N) p c := by
    intro p hp c
    have f_deg : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a)
    have h1 : (wcSgD K N a).ι =
        Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a) ≫
          Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)
            f_deg one_pos := by
      rw [← Proj.basicOpenIsoSpec_hom _ _ f_deg one_pos,
        ← Proj.basicOpenIsoSpec_inv_ι _ _ f_deg one_pos, Iso.hom_inv_id_assoc]
    have h2 : (wcSgD K N a).ι ≫ wcProjKStr K N =
        Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a) ≫
          Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) ≫
            CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
              (Submonoid.powers (MvPolynomial.X a)))) := by
      rw [h1, Spec.map_comp, ← Proj.awayι_toSpecZero _ _ f_deg one_pos]
      simp only [wcProjKStr, Category.assoc]
    have h4 : (Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a)).appTop =
        (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)))).hom ≫
          Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a) ≫
          (wcSgD K N a).topIso.inv :=
      Proj.basicOpenToSpec_app_top _ _
    have H : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ (wcProjKStr K N).appTop ≫
          (wcSgD K N a).ι.appTop =
        CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))) ≫
          Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a) ≫
          (wcSgD K N a).topIso.inv := by
      rw [← Scheme.Hom.comp_appTop, h2, Scheme.Hom.comp_appTop, ← Category.assoc,
        ← Scheme.ΓSpecIso_inv_naturality, h4]
      simp only [Category.assoc, Iso.inv_hom_id_assoc]
    have h3 : (wcSgD K N a).ι.appTop ≫ (wcSgD K N a).topIso.hom =
        (wcProjK K N).presheaf.map (homOfLE (le_top : wcSgD K N a ≤ ⊤)).op := by
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
      first
        | (erw [← Functor.map_comp]; rfl)
        | (simp only [← Functor.map_comp]; rfl)
        | exact ((wcProjK K N).presheaf.map_comp _ _).symm
    have H' : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ (wcProjKStr K N).appTop ≫
          (wcProjK K N).presheaf.map (homOfLE (le_top : wcSgD K N a ≤ ⊤)).op =
        CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))) ≫
          Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (MvPolynomial.X a) := by
      rw [← h3, reassoc_of% H, Iso.inv_hom_id, Category.comp_id]
    have e := congrArg (fun φ => φ.hom c) H'
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e
    have hg := congrArg (fun φ => φ.hom ((wcProjKStr K N).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom c)))
      (TopCat.Presheaf.germ_res (wcProjK K N).presheaf (homOfLE (le_top : wcSgD K N a ≤ ⊤)) p hp)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hg
    rw [← e]
    exact hg

  have hsecq : wcLdpSec K N (wcLdpQuad K N w) a =
      ∑ p, ∑ q, (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)).hom
          (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) (w p q))) *
        wcSgE K N a p * wcSgE K N a q := by
    have hc : ∀ c : K, (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (Submonoid.powers (MvPolynomial.X a))
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)).val =
        Localization.mk (MvPolynomial.C c) 1 := by
      intro c
      rfl
    unfold wcLdpSec wcSgE
    simp only [← map_mul, ← map_sum]
    congr 1
    apply HomogeneousLocalization.val_injective
    rw [← HomogeneousLocalization.algebraMap_apply, ← HomogeneousLocalization.algebraMap_apply]
    simp only [map_sum, map_mul, HomogeneousLocalization.algebraMap_apply, hc,
      HomogeneousLocalization.Away.val_mk]
    unfold wcLdpQuad
    simp only [Localization.mk_sum]
    refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => ?_))
    rw [Localization.mk_mul, Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [Submonoid.coe_mul, Submonoid.coe_one, OneMemClass.coe_one]
    ring

  have s2 : ∀ c : K, (ι.stalkMap x).hom (wcLdpConst K (wcProjKStr K N) (ι x) c) =
      wcLdpConst K X.hom x c := by
    intro c
    simp only [wcLdpConst, RingHom.comp_apply]
    refine (Scheme.Hom.germ_stalkMap_apply (f := ι) (U := ⊤) (x := x) (hx := trivial) _).trans ?_
    rw [← hιX, Scheme.Hom.comp_appTop]
    rfl
  have s3 : ∀ c : K, (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) x hx).hom ((ι.app (wcSgD K N a)).hom
      ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)).hom
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (Submonoid.powers (MvPolynomial.X a))
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)))) =
      wcLdpConst K X.hom x c := by
    intro c
    refine (Scheme.Hom.germ_stalkMap_apply (f := ι) (U := wcSgD K N a) (x := x) (hx := hx) _).symm.trans ?_
    rw [hconstP (ι x) hx c]
    exact s2 c

  have hk : ∀ c : K, (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) x hx).hom
      (algebraMap K Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) c) = wcLdpConst K X.hom x c := by
    intro c
    exact TopCat.Presheaf.germ_res_apply X.left.presheaf (homOfLE le_top) x hx _
  have hgerm : (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) x hx).hom
      (∑ p, ∑ q, algebraMap K Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) (w p q) *
        (ι.app (wcSgD K N a)).hom (wcSgE K N a p) * (ι.app (wcSgD K N a)).hom (wcSgE K N a q)) =
      wcLdpGerm K N ι (wcLdpQuad K N w) a x hx := by
    unfold wcLdpGerm
    rw [hsecq]
    simp only [map_sum, map_mul, hk, s3]
  rw [← hgerm] at hw

  have hc2 : ∀ g : Γ(X.left, ι ⁻¹ᵁ wcSgD K N a),
      (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) x hx).hom g ∈
        IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ^ 2 →
      ∃ t : Γ(X.left, ι ⁻¹ᵁ wcSgD K N a), χ t ≠ 0 ∧ t * g ∈ RingHom.ker χ.toRingHom ^ 2 := by
    intro g hg
    set y : (ι ⁻¹ᵁ wcSgD K N a : X.left.Opens) := ⟨x, hx⟩ with hy
    set P := (hU.primeIdealOf y).asIdeal with hP
    have : P.IsPrime := (hU.primeIdealOf y).isPrime
    letI : Algebra Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) (X.left.presheaf.stalk (y : X.left)) :=
      TopCat.Presheaf.algebra_section_stalk X.left.presheaf y
    have hloc : IsLocalization.AtPrime (X.left.presheaf.stalk (y : X.left)) P :=
      hU.isLocalization_stalk y
    have halg : ∀ r, algebraMap Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) (X.left.presheaf.stalk (y : X.left)) r =
        (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) x hx).hom r := fun r => rfl
    have hconst : ∀ c : K, wcLdpConst K X.hom x c ∈
        IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ↔ c = 0 := by
      intro c
      constructor
      · intro hc
        by_contra hne
        exact (IsLocalRing.mem_maximalIdeal _).mp hc ((isUnit_iff_ne_zero.mpr hne).map _)
      · rintro rfl
        rw [map_zero]; exact Ideal.zero_mem _
    have hPmem : ∀ r : Γ(X.left, ι ⁻¹ᵁ wcSgD K N a), r ∈ P ↔ χ r = 0 := by
      intro r
      rw [← hconst,
        ← IsLocalization.AtPrime.to_map_mem_maximal_iff (X.left.presheaf.stalk (y : X.left)) P r,
        halg]
      constructor
      · intro h
        have := Ideal.sub_mem _ h (hχ r)
        rwa [sub_sub_cancel] at this
      · intro h
        have := Ideal.add_mem _ (hχ r) h
        rwa [sub_add_cancel] at this
    have hPker : P = RingHom.ker χ.toRingHom := by
      ext r
      rw [RingHom.mem_ker]
      exact hPmem r
    have hm : IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ^ 2 =
        Ideal.map (algebraMap Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) (X.left.presheaf.stalk (y : X.left)))
          (P ^ 2) := by
      rw [Ideal.map_pow, IsLocalization.AtPrime.map_eq_maximalIdeal]
    rw [hm, ← halg] at hg
    obtain ⟨⟨b, σ⟩, hbσ⟩ := (IsLocalization.mem_map_algebraMap_iff P.primeCompl
      (X.left.presheaf.stalk (y : X.left))).mp hg
    simp only at hbσ
    rw [← map_mul] at hbσ
    obtain ⟨c, hc⟩ :=
      (IsLocalization.eq_iff_exists P.primeCompl (X.left.presheaf.stalk (y : X.left))).mp hbσ
    refine ⟨c * σ, ?_, ?_⟩
    · have hmem : (c : Γ(X.left, ι ⁻¹ᵁ wcSgD K N a)) * σ ∈ P.primeCompl :=
        P.primeCompl.mul_mem c.2 σ.2
      have hmem' : ¬ ((c : Γ(X.left, ι ⁻¹ᵁ wcSgD K N a)) * σ ∈ P) := hmem
      exact fun h0 => hmem' ((hPmem _).mpr h0)
    · rw [← hPker]
      have : (c : Γ(X.left, ι ⁻¹ᵁ wcSgD K N a)) * σ * g = c * (g * σ) := by ring
      rw [this, hc]
      exact Ideal.mul_mem_left _ _ b.2

  have hc3 : ∀ (D : Derivation K Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) Γ(X.left, ι ⁻¹ᵁ wcSgD K N a))
      (I : Ideal Γ(X.left, ι ⁻¹ᵁ wcSgD K N a)) (_ : ∀ b ∈ I, χ b = 0)
      (t f : Γ(X.left, ι ⁻¹ᵁ wcSgD K N a)) (_ : χ t ≠ 0) (_ : t * f ∈ I ^ 2),
      χ f = 0 ∧ χ (D f) = 0 := by
    intro D I hI t f ht hf
    have h1 : t * f ∈ I := Ideal.pow_le_self two_ne_zero hf
    have hf0 : χ f = 0 := by
      have := hI _ h1
      rw [map_mul] at this
      exact (mul_eq_zero.mp this).resolve_left ht
    refine ⟨hf0, ?_⟩
    have hD : ∀ z ∈ I ^ 2, D z ∈ I := by
      intro z hz
      rw [pow_two] at hz
      refine Submodule.mul_induction_on (C := fun z => D z ∈ I) hz ?_ ?_
      · intro b hb b' hb'
        rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
        exact I.add_mem (I.mul_mem_right _ hb) (I.mul_mem_right _ hb')
      · intro z₁ z₂ h₁ h₂
        rw [map_add]; exact I.add_mem h₁ h₂
    have h2 := hI _ (hD _ hf)
    rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, map_add, map_mul, map_mul, hf0,
      zero_mul, add_zero] at h2
    exact (mul_eq_zero.mp h2).resolve_left ht

  have hc4 : ∀ (D : Derivation K Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) Γ(X.left, ι ⁻¹ᵁ wcSgD K N a))
      (u : Fin (N + 1) → Γ(X.left, ι ⁻¹ᵁ wcSgD K N a)),
      χ (∑ p, ∑ q, algebraMap K Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) (w p q) * u p * u q) =
        ∑ q : Fin (N + 1) × Fin (N + 1), χ (u q.1) * χ (u q.2) * w q.1 q.2 ∧
      χ (D (∑ p, ∑ q, algebraMap K Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) (w p q) * u p * u q)) =
        ∑ q : Fin (N + 1) × Fin (N + 1),
          (χ (u q.1) * χ (D (u q.2)) + χ (D (u q.1)) * χ (u q.2)) * w q.1 q.2 := by
    intro D u
    rw [Fintype.sum_prod_type, Fintype.sum_prod_type]
    constructor
    · simp only [map_sum, map_mul, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]
      refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => ?_
      ring
    · simp only [map_sum]
      refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => ?_
      rw [Derivation.leibniz, Derivation.leibniz, Derivation.map_algebraMap]
      simp only [smul_eq_mul, map_add, map_mul, mul_zero, add_zero,
        AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]
      ring

  obtain ⟨t, ht, htf⟩ := hc2 _ hw
  have hI : ∀ b ∈ RingHom.ker χ.toRingHom, χ b = 0 := fun b hb => RingHom.mem_ker.mp hb
  refine ⟨?_, fun D => ?_⟩
  · rw [← (hc4 0 (fun p => (ι.app (wcSgD K N a)).hom (wcSgE K N a p))).1]
    exact (hc3 0 _ hI t _ ht htf).1
  · rw [← (hc4 D (fun p => (ι.app (wcSgD K N a)).hom (wcSgE K N a p))).2]
    exact (hc3 D _ hI t _ ht htf).2

theorem wc_ldp_dtc_chart_sep (K : Type u) [Field K] [IsAlgClosed K] (N : ℕ)
    (X : Over (Spec (.of K))) [LocallyOfFiniteType X.hom]
    (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr K N = X.hom)
    (a b : Fin (N + 1)) (x x' : X.left) (hx : x ∈ ι ⁻¹ᵁ wcSgD K N a)
    (hx' : x' ∈ ι ⁻¹ᵁ wcSgD K N b) (hxc : IsClosed ({x} : Set X.left))
    (hxc' : IsClosed ({x'} : Set X.left)) (hne : x ≠ x')
    (χ : Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) →+* K) (χ' : Γ(X.left, ι ⁻¹ᵁ wcSgD K N b) →+* K)
    (hχ : ∀ r, (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) x hx).hom r -
      wcLdpConst K X.hom x (χ r) ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x))
    (hχ' : ∀ r, (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N b) x' hx').hom r -
      wcLdpConst K X.hom x' (χ' r) ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x')) :
    ∃ i j, χ ((ι.app (wcSgD K N a)).hom (wcSgE K N a i)) *
        χ' ((ι.app (wcSgD K N b)).hom (wcSgE K N b j)) -
      χ ((ι.app (wcSgD K N a)).hom (wcSgE K N a j)) *
        χ' ((ι.app (wcSgD K N b)).hom (wcSgE K N b i)) ≠ 0 :=
by
  classical
  by_contra H
  push_neg at H
  have hξa : χ ((ι.app (wcSgD K N a)).hom (wcSgE K N a a)) = 1 := by
    rw [(wc_ldp_dtc_chart_lin K N X ι hιX a).1, map_one]
  have hξb : χ' ((ι.app (wcSgD K N b)).hom (wcSgE K N b b)) = 1 := by
    rw [(wc_ldp_dtc_chart_lin K N X ι hιX b).1, map_one]
  have hba := H b a
  rw [hξa, hξb] at hba
  have ha0 : χ' ((ι.app (wcSgD K N b)).hom (wcSgE K N b a)) ≠ 0 := by
    intro h0
    rw [h0, mul_zero, zero_sub, neg_eq_zero] at hba
    exact one_ne_zero (by rw [one_mul] at hba; exact hba)
  have hrat : ∀ i, χ' ((ι.app (wcSgD K N b)).hom (wcSgE K N b i)) /
      χ' ((ι.app (wcSgD K N b)).hom (wcSgE K N b a)) =
      χ ((ι.app (wcSgD K N a)).hom (wcSgE K N a i)) := by
    intro i
    have hi := H i a
    rw [hξa, one_mul, sub_eq_zero] at hi
    rw [div_eq_iff ha0, hi]
  obtain ⟨hxa', hξ'⟩ := wc_ldp_lnf_chart_change K N X ι a b x' hx'
    (fun i => χ' ((ι.app (wcSgD K N b)).hom (wcSgE K N b i))) (fun i => hχ' _) ha0
  have hconst := fun (c : Fin (N + 1)) (p : wcProjK K N) (hp : p ∈ wcSgD K N c) (e : K) =>
    wc_ldp_il_proj_const K N c p hp e
  have hsec := fun (c : Fin (N + 1)) (w : Fin (N + 1) → Fin (N + 1) → K) =>
    wc_ldp_lnf_sec_quad K N c w
  have hDa : IsAffineOpen (wcSgD K N a) :=
    @Proj.isAffineOpen_basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      MvPolynomial.gradedAlgebra (MvPolynomial.X a) 1
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a)) one_pos
  have hsep : ∀ (p p' : wcProjK K N) (hp : p ∈ wcSgD K N a) (hp' : p' ∈ wcSgD K N a),
      IsClosed ({p} : Set (wcProjK K N)) → p ≠ p' →
      ∃ s : Γ(wcProjK K N, wcSgD K N a), ((wcProjK K N).evaluation (wcSgD K N a) p hp).hom s = 0 ∧
        ((wcProjK K N).evaluation (wcSgD K N a) p' hp').hom s ≠ 0 :=
    fun p p' hp hp' => wc_affine_closed_point_separation (wcProjK K N) (wcSgD K N a) hDa p p' hp hp'
  apply hne
  refine wc_ldp_lnf_chart_sep K N X ι hι a (wc_away_X_closure_top K N a) hsep x x' hx hxa' hxc
    (wc_ldp_lnf_chart_germ K N X ι hιX hconst hsec a x hx).1
    (wc_ldp_lnf_chart_germ K N X ι hιX hconst hsec a x' hxa').1
    (fun i => χ ((ι.app (wcSgD K N a)).hom (wcSgE K N a i))) (fun i => hχ _) ?_
  intro i
  have h := hξ' i
  rw [hrat i] at h
  exact h

theorem wc_ldp_dtc_chart_model (K : Type u) [Field K] [IsAlgClosed K] (N n : ℕ)
    (X : Over (Spec (.of K))) [GeometricallyIrreducible X.hom] [IsProper X.hom]
    [SmoothOfRelativeDimension n X.hom] (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι)
    (hιX : ι ≫ wcProjKStr K N = X.hom) :
    ∃ (R : Fin (N + 1) → Type u) (_ : ∀ a, CommRing (R a)) (_ : ∀ a, Algebra K (R a))
      (_ : ∀ a, Algebra.FiniteType K (R a))
      (u : ∀ a, Fin (N + 1) → R a) (t : Fin (N + 1) → ℕ)
      (η : ∀ a, Fin (t a) → Fin (N + 1) → R a)
      (pt : ∀ a (x : X.left), x ∈ ι ⁻¹ᵁ wcSgD K N a → (R a →ₐ[K] K)),
      (∀ a, IsDomain (R a) ∨ Subsingleton (R a)) ∧
      (∀ a, ringKrullDim (R a) ≤ n) ∧
      (∀ a, u a a = 1) ∧
      (∀ a (χ : R a →ₐ[K] K),
        Module.finrank K (Submodule.span K (Set.range fun k => fun p => χ (η a k p))) = n ∧
        ∀ k, χ (η a k a) = 0) ∧
      (∀ a (ℓ : Fin (N + 1) → K), ∑ p, algebraMap K (R a) (ℓ p) * u a p = 0 →
        (ι.app (wcSgD K N a)).hom
          (wcLdpSec K N (wcLdpQuad K N fun p q => if q = a then ℓ p else 0) a) = 0) ∧
      (∀ a, Nonempty (R a →ₐ[K] K) → ∃ x : X.left, x ∈ ι ⁻¹ᵁ wcSgD K N a) ∧
      (∀ x : X.left, ∃ a, x ∈ ι ⁻¹ᵁ wcSgD K N a) ∧
      (∀ a (x : X.left) (hx : x ∈ ι ⁻¹ᵁ wcSgD K N a), IsClosed ({x} : Set X.left) →
        ∀ w : Fin (N + 1) → Fin (N + 1) → K,
        wcLdpGerm K N ι (wcLdpQuad K N w) a x hx ∈
          IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ^ 2 →
        ∀ r : Option (Fin (t a)), ∑ q : Fin (N + 1) × Fin (N + 1),
          wcLdpDtcRow (fun p => pt a x hx (u a p)) (fun k p => pt a x hx (η a k p)) r q *
            w q.1 q.2 = 0) ∧
      (∀ a b (x x' : X.left) (hx : x ∈ ι ⁻¹ᵁ wcSgD K N a) (hx' : x' ∈ ι ⁻¹ᵁ wcSgD K N b),
        IsClosed ({x} : Set X.left) → IsClosed ({x'} : Set X.left) → x ≠ x' →
        ∃ i j, pt a x hx (u a i) * pt b x' hx' (u b j) -
          pt a x hx (u a j) * pt b x' hx' (u b i) ≠ 0) :=
by
  classical
  haveI : Smooth X.hom := SmoothOfRelativeDimension.smooth n X.hom
  haveI : IsClosedImmersion ι := hι
  letI inst : ∀ a : Fin (N + 1), Algebra K Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) :=
    fun a => (wcCnSigma X.hom (ι ⁻¹ᵁ wcSgD K N a)).toAlgebra

  have hUaff : ∀ a : Fin (N + 1), IsAffineOpen (ι ⁻¹ᵁ wcSgD K N a) := fun a =>
    (@Proj.isAffineOpen_basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      MvPolynomial.gradedAlgebra (MvPolynomial.X a) 1
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a))
      one_pos).preimage ι

  have hFT : ∀ a : Fin (N + 1), Algebra.FiniteType K Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) := by
    intro a
    refine ⟨⟨Finset.univ.image (fun p => (ι.app (wcSgD K N a)).hom (wcSgE K N a p)), ?_⟩⟩
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
    exact wc_ldp_dtc_chart_generated K N X ι hι hιX a

  choose t D hD using fun a => wc_ldp_dtc_chart_frame K N n X ι hι hιX a

  have hpt : ∀ (a : Fin (N + 1)) (x : X.left) (hx : x ∈ ι ⁻¹ᵁ wcSgD K N a),
      ∃ χ : Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) →ₐ[K] K, IsClosed ({x} : Set X.left) →
        ∀ r, (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) x hx).hom r -
          wcLdpConst K X.hom x (χ r) ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) := by
    intro a x hx
    by_cases hc : IsClosed ({x} : Set X.left)
    · obtain ⟨χ, hχ⟩ := wc_ldp_dtc_rational_eval K X.hom (ι ⁻¹ᵁ wcSgD K N a) x hx hc
      exact ⟨χ, fun _ => hχ⟩
    · have hnt : Nontrivial Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) :=
        RingHom.domain_nontrivial (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) x hx).hom
      haveI := hFT a
      obtain ⟨χ⟩ := (wc_ldp_dtc_nullstellensatz K Γ(X.left, ι ⁻¹ᵁ wcSgD K N a)).1 hnt
      exact ⟨χ, fun h => absurd h hc⟩
  choose pt hpt using hpt
  refine ⟨fun a => Γ(X.left, ι ⁻¹ᵁ wcSgD K N a), fun a => inferInstance, inst, hFT,
    fun a p => (ι.app (wcSgD K N a)).hom (wcSgE K N a p), t,
    fun a k p => D a k ((ι.app (wcSgD K N a)).hom (wcSgE K N a p)), pt,
    ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  ·
    intro a
    exact wc_ldp_dtc_chart_domain K n X (ι ⁻¹ᵁ wcSgD K N a)
  ·
    intro a
    exact wc_ldp_dtc_chart_dim K X.hom n (ι ⁻¹ᵁ wcSgD K N a) (hUaff a)
  ·
    intro a
    exact (wc_ldp_dtc_chart_lin K N X ι hιX a).1
  ·
    intro a χ
    refine ⟨hD a χ, fun k => ?_⟩
    show χ (D a k ((ι.app (wcSgD K N a)).hom (wcSgE K N a a))) = 0
    rw [(wc_ldp_dtc_chart_lin K N X ι hιX a).1, Derivation.map_one_eq_zero, map_zero]
  ·
    intro a ℓ h
    rw [(wc_ldp_dtc_chart_lin K N X ι hιX a).2 ℓ]
    exact h
  ·
    rintro a ⟨χ⟩
    by_contra hne
    push_neg at hne
    have hss : Subsingleton Γ(X.left, ι ⁻¹ᵁ wcSgD K N a) :=
      ⟨fun s s' => TopCat.Presheaf.section_ext X.left.sheaf _ s s'
        (fun x hx => absurd hx (hne x))⟩
    have h1 := χ.map_one
    rw [Subsingleton.elim (1 : Γ(X.left, ι ⁻¹ᵁ wcSgD K N a)) 0, map_zero] at h1
    exact zero_ne_one h1
  ·
    intro x
    have hY : (⨆ j : Fin (N + 1), wcSgD K N j) = ⊤ := by
      apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
      intro p hp
      have hp' := (HomogeneousIdeal.mem_irrelevant_iff _ p).mp hp
      have h0 : MvPolynomial.homogeneousComponent 0 p = 0 := by
        rw [← MvPolynomial.decomposition.decompose'_apply]
        exact hp'
      rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.mp hm) h0
      obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨l, Set.mem_univ _, hl⟩
    have hx : ι x ∈ (⨆ j : Fin (N + 1), wcSgD K N j) := by rw [hY]; trivial
    obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    exact ⟨j, (Scheme.Hom.mem_preimage ι).mpr hj⟩
  ·
    intro a x hx hc w hw r
    obtain ⟨h0, hDer⟩ := wc_ldp_dtc_chart_jet K N X ι hι hιX a x hx (pt a x hx)
      (hpt a x hx hc) w hw
    cases r with
    | none => exact h0
    | some k => exact hDer (D a k)
  ·
    intro a b x x' hx hx' hc hc' hne
    exact wc_ldp_dtc_chart_sep K N X ι hι hιX a b x x' hx hx' hc hc' hne
      (pt a x hx).toRingHom (pt b x' hx').toRingHom (hpt a x hx hc) (hpt b x' hx' hc')

theorem wc_ldp_dtc_lin_of_chart (K : Type u) [Field K] [IsAlgClosed K] (N n : ℕ)
    (X : Over (Spec (.of K))) [GeometricallyIrreducible X.hom] [IsProper X.hom]
    [SmoothOfRelativeDimension n X.hom] (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι)
    (hιX : ι ≫ wcProjKStr K N = X.hom) (b : Fin (N + 1))
    (hb : ∃ x : X.left, x ∈ ι ⁻¹ᵁ wcSgD K N b)
    (Λ : Submodule K (Fin (N + 1) → K)) (hΛ : Module.finrank K Λ = n + 1)
    (h : ∀ ℓ : Fin (N + 1) → K, (∀ η ∈ Λ, ∑ p, ℓ p * η p = 0) →
      (ι.app (wcSgD K N b)).hom
        (wcLdpSec K N (wcLdpQuad K N fun p q => if q = b then ℓ p else 0) b) = 0) :
    wcLdpLin K N n ι :=
by
  classical

  haveI hirr : IrreducibleSpace X.left :=
    GeometricallyIrreducible.geometrically_irreducibleSpace (K := K) (𝟙 _) (𝟙 X.left) X.hom
      IsPullback.of_id_fst
  haveI : ∀ x : X.left, _root_.IsReduced (X.left.presheaf.stalk x) := fun x => by
    haveI := wcpa_smooth_stalk_isDomain K X.left X.hom n x
    infer_instance
  haveI : AlgebraicGeometry.IsReduced X.left :=
    AlgebraicGeometry.isReduced_of_isReduced_stalk X.left
  haveI : AlgebraicGeometry.IsIntegral X.left :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced X.left

  have hq : ∀ (ℓ : Fin (N + 1) → K) (c : Fin (N + 1)),
      ((wcLdpQuad K N fun p q => if q = c then ℓ p else 0 :
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2) : MvPolynomial (Fin (N + 1)) K) =
        (∑ p, MvPolynomial.C (ℓ p) * MvPolynomial.X p) * MvPolynomial.X c := by
    intro ℓ c
    show (∑ p, ∑ q, MvPolynomial.C (if q = c then ℓ p else 0) *
      (MvPolynomial.X p * MvPolynomial.X q) : MvPolynomial (Fin (N + 1)) K) = _
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    simp only [apply_ite MvPolynomial.C, MvPolynomial.C_0, ite_mul, zero_mul,
      Finset.sum_ite_eq', Finset.mem_univ, if_true]
    ring

  have hsec : ∀ (ℓ : Fin (N + 1) → K) (a : Fin (N + 1)),
      wcLdpSec K N (wcLdpQuad K N fun p q => if q = a then ℓ p else 0) b =
        wcSgE K N b a * wcLdpSec K N (wcLdpQuad K N fun p q => if q = b then ℓ p else 0) b := by
    intro ℓ a
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
      MvPolynomial.gradedAlgebra
    simp only [wcLdpSec, wcSgE]
    rw [← map_mul]
    congr 1
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
      Localization.mk_mul, Localization.mk_eq_mk_iff]
    apply Localization.r_of_eq
    simp only [Submonoid.coe_mul, hq]
    ring
  refine ⟨Λ, hΛ, fun ℓ hℓ a => ?_⟩
  have hb0 : (ι.app (wcSgD K N b)).hom
      (wcLdpSec K N (wcLdpQuad K N fun p q => if q = a then ℓ p else 0) b) = 0 := by
    rw [hsec ℓ a, map_mul, h ℓ hℓ, mul_zero]
  apply TopCat.Presheaf.section_ext X.left.sheaf (ι ⁻¹ᵁ wcSgD K N a)
  intro x hx
  obtain ⟨x₁, hx₁⟩ := hb
  obtain ⟨w, hwa, hwb⟩ := nonempty_preirreducible_inter (ι ⁻¹ᵁ wcSgD K N a).isOpen
    (ι ⁻¹ᵁ wcSgD K N b).isOpen ⟨x, hx⟩ ⟨x₁, hx₁⟩
  obtain ⟨u, -, hu⟩ := wc_ldp_cf_uniform_transition K N ι a b w hwa hwb
  have hgerm := hu (wcLdpQuad K N fun p q => if q = a then ℓ p else 0)
  unfold wcLdpGerm at hgerm
  rw [hb0, map_zero, mul_zero] at hgerm
  have hA : (ι.app (wcSgD K N a)).hom
      (wcLdpSec K N (wcLdpQuad K N fun p q => if q = a then ℓ p else 0) a) = 0 := by
    apply AlgebraicGeometry.germ_injective_of_isIntegral X.left w hwa
    rw [hgerm, map_zero]
  rw [hA]

theorem wc_ldp_dtc_pair_rank (K : Type u) [Field K] (N n t t' : ℕ)
    (ξ ξ' : Fin (N + 1) → K) (η : Fin t → Fin (N + 1) → K) (η' : Fin t' → Fin (N + 1) → K)
    (hT : Module.finrank K (Submodule.span K (Set.range η)) = n)
    (hT' : Module.finrank K (Submodule.span K (Set.range η')) = n)
    (hξ : ξ ∉ Submodule.span K (Set.range η)) (hξ' : ξ' ∉ Submodule.span K (Set.range η')) :
    ((∃ i j, ξ i * ξ' j - ξ j * ξ' i ≠ 0) → 2 * n + 1 ≤ (wcLdpDtcPM ξ η ξ' η').rank) ∧
    ((wcLdpDtcPM ξ η ξ' η').rank ≤ 2 * n + 1 →
      ξ' ∈ Submodule.span K (insert ξ (Set.range η))) ∧
    Module.finrank K (Submodule.span K (insert ξ (Set.range η))) = n + 1 :=
by
  classical

  have s1 : ∀ {t : ℕ} (x : Fin (N + 1) → K) (η : Fin t → Fin (N + 1) → K)
      (S : Fin (N + 1) × Fin (N + 1) → K),
      S ∈ Submodule.span K (Set.range (wcLdpDtcRow x η)) ↔
        ∃ α : K, ∃ v ∈ Submodule.span K (Set.range η),
          S = fun q => α * (x q.1 * x q.2) + (x q.1 * v q.2 + v q.1 * x q.2) := by
    intro t x η S
    constructor
    · intro hS
      induction hS using Submodule.span_induction with
      | mem y hy =>
        obtain ⟨k, rfl⟩ := hy
        cases k with
        | none => exact ⟨1, 0, Submodule.zero_mem _, by funext q; simp [wcLdpDtcRow]⟩
        | some k =>
          exact ⟨0, η k, Submodule.subset_span ⟨k, rfl⟩, by funext q; simp [wcLdpDtcRow]⟩
      | zero => exact ⟨0, 0, Submodule.zero_mem _, by funext q; simp⟩
      | add y z _ _ hy hz =>
        obtain ⟨a, v, hv, rfl⟩ := hy
        obtain ⟨b, w, hw, rfl⟩ := hz
        exact ⟨a + b, v + w, Submodule.add_mem _ hv hw, by
          funext q; simp only [Pi.add_apply]; ring⟩
      | smul c y _ hy =>
        obtain ⟨a, v, hv, rfl⟩ := hy
        exact ⟨c * a, c • v, Submodule.smul_mem _ c hv, by
          funext q; simp only [Pi.smul_apply, smul_eq_mul]; ring⟩
    · rintro ⟨α, v, hv, rfl⟩
      let πm : (Fin (N + 1) → K) →ₗ[K] (Fin (N + 1) × Fin (N + 1) → K) :=
        { toFun := fun v q => x q.1 * v q.2 + v q.1 * x q.2
          map_add' := fun a b => by funext q; simp only [Pi.add_apply]; ring
          map_smul' := fun c a => by
            funext q; simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]; ring }
      have hπm : ∀ w : Fin (N + 1) → K, πm w = fun q => x q.1 * w q.2 + w q.1 * x q.2 :=
        fun w => rfl
      have hle : Submodule.span K (Set.range η) ≤
          (Submodule.span K (Set.range (wcLdpDtcRow x η))).comap πm := by
        rw [Submodule.span_le]
        rintro _ ⟨k, rfl⟩
        rw [SetLike.mem_coe, Submodule.mem_comap]
        have : πm (η k) = wcLdpDtcRow x η (some k) := by
          rw [hπm]; funext q; simp [wcLdpDtcRow]
        rw [this]
        exact Submodule.subset_span ⟨some k, rfl⟩
      have h1 := hle hv
      rw [Submodule.mem_comap] at h1
      have h0 : wcLdpDtcRow x η none ∈ Submodule.span K (Set.range (wcLdpDtcRow x η)) :=
        Submodule.subset_span ⟨none, rfl⟩
      have hsplit : (fun q : Fin (N + 1) × Fin (N + 1) =>
          α * (x q.1 * x q.2) + (x q.1 * v q.2 + v q.1 * x q.2)) =
          α • wcLdpDtcRow x η none + πm v := by
        rw [hπm]; funext q; simp [wcLdpDtcRow]
      rw [hsplit]
      exact Submodule.add_mem _ (Submodule.smul_mem _ α h0) h1

  have s2 : ∀ {t : ℕ} (x v : Fin (N + 1) → K) (η : Fin t → Fin (N + 1) → K) (α : K),
      x ∉ Submodule.span K (Set.range η) → v ∈ Submodule.span K (Set.range η) →
      (fun q : Fin (N + 1) × Fin (N + 1) =>
        α * (x q.1 * x q.2) + (x q.1 * v q.2 + v q.1 * x q.2)) = 0 →
      α = 0 ∧ v = 0 := by
    intro t x v η α hx hv h0
    obtain ⟨f, hfx, hle⟩ := Submodule.exists_le_ker_of_notMem hx
    have hfv : f v = 0 := hle hv
    have hrow : ∀ p, (α * x p) • x + x p • v + v p • x = 0 := by
      intro p; funext r
      have := congrFun h0 (p, r)
      simp only [Pi.zero_apply] at this
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
      linear_combination this
    have hvp : ∀ p, v p = (-α) * x p := by
      intro p
      have := congrArg f (hrow p)
      simp only [map_add, map_smul, smul_eq_mul, map_zero] at this
      have h3 : (α * x p + v p) * f x = 0 := by linear_combination this - x p * hfv
      have h4 := (mul_eq_zero.mp h3).resolve_right hfx
      linear_combination h4
    have hv' : v = (-α) • x := by
      funext p; rw [Pi.smul_apply, smul_eq_mul, hvp p]
    by_cases hα : α = 0
    · refine ⟨hα, ?_⟩
      rw [hv', hα, neg_zero, zero_smul]
    · exfalso; apply hx
      have : x = (-α)⁻¹ • v := by
        rw [hv', smul_smul, inv_mul_cancel₀ (neg_ne_zero.mpr hα), one_smul]
      rw [this]; exact Submodule.smul_mem _ _ hv

  have s3 : ∀ (v v' : Fin (N + 1) → K) (α α' : K) (i j : Fin (N + 1)),
      ξ i * ξ' j - ξ j * ξ' i ≠ 0 →
      (fun q : Fin (N + 1) × Fin (N + 1) =>
        α * (ξ q.1 * ξ q.2) + (ξ q.1 * v q.2 + v q.1 * ξ q.2)) =
        (fun q => α' * (ξ' q.1 * ξ' q.2) + (ξ' q.1 * v' q.2 + v' q.1 * ξ' q.2)) →
      ∃ c : K, (fun q : Fin (N + 1) × Fin (N + 1) =>
        α * (ξ q.1 * ξ q.2) + (ξ q.1 * v q.2 + v q.1 * ξ q.2)) =
        c • (fun q => ξ q.1 * ξ' q.2 + ξ' q.1 * ξ q.2) := by
    intro v v' α α' i j hd heq
    have h : ∀ p r, α * (ξ p * ξ r) + (ξ p * v r + v p * ξ r) =
        α' * (ξ' p * ξ' r) + (ξ' p * v' r + v' p * ξ' r) := fun p r => congrFun heq (p, r)
    have E1 : ∀ p, (ξ i * ξ' j - ξ j * ξ' i) * v p =
        ξ' p * (ξ' j * v' i - ξ' i * v' j) -
          (α * (ξ i * ξ' j - ξ j * ξ' i) + (ξ' j * v i - ξ' i * v j)) * ξ p := by
      intro p
      linear_combination ξ' j * h p i - ξ' i * h p j
    have E2 : (ξ i * ξ' j - ξ j * ξ' i) *
        (α * (ξ i * ξ' j - ξ j * ξ' i) + 2 * (ξ' j * v i - ξ' i * v j)) = 0 := by
      linear_combination (ξ' j * ξ' j) * h i i - (ξ' j * ξ' i) * h i j -
        (ξ' i * ξ' j) * h j i + (ξ' i * ξ' i) * h j j
    have E2' : α * (ξ i * ξ' j - ξ j * ξ' i) + 2 * (ξ' j * v i - ξ' i * v j) = 0 :=
      (mul_eq_zero.mp E2).resolve_left hd
    refine ⟨(ξ' j * v' i - ξ' i * v' j) / (ξ i * ξ' j - ξ j * ξ' i), ?_⟩
    funext q
    obtain ⟨p, r⟩ := q
    simp only [Pi.smul_apply, smul_eq_mul]
    rw [div_mul_eq_mul_div, eq_div_iff hd]
    linear_combination ξ r * E1 p + ξ p * E1 r - ξ p * ξ r * E2'

  have s4 : ∀ (v v' : Fin (N + 1) → K) (α α' : K),
      ξ' ∉ Submodule.span K (insert ξ (Set.range η)) →
      v ∈ Submodule.span K (Set.range η) → v' ∈ Submodule.span K (Set.range η') →
      (fun q : Fin (N + 1) × Fin (N + 1) =>
        α * (ξ q.1 * ξ q.2) + (ξ q.1 * v q.2 + v q.1 * ξ q.2)) =
        (fun q => α' * (ξ' q.1 * ξ' q.2) + (ξ' q.1 * v' q.2 + v' q.1 * ξ' q.2)) →
      (fun q : Fin (N + 1) × Fin (N + 1) =>
        α * (ξ q.1 * ξ q.2) + (ξ q.1 * v q.2 + v q.1 * ξ q.2)) = 0 := by
    intro v v' α α' hnot hv hv' heq
    obtain ⟨f, hf, hle⟩ := Submodule.exists_le_ker_of_notMem hnot
    have hfξ : f ξ = 0 := hle (Submodule.subset_span (Set.mem_insert _ _))
    have hfv : f v = 0 := hle (Submodule.span_mono (Set.subset_insert _ _) hv)
    have hrow : ∀ p, (α * ξ p) • ξ + ξ p • v + v p • ξ =
        (α' * ξ' p) • ξ' + ξ' p • v' + v' p • ξ' := by
      intro p; funext r
      have := congrFun heq (p, r)
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      linear_combination this
    have hc : ∀ p, (α' * ξ' p) * f ξ' + ξ' p * f v' + v' p * f ξ' = 0 := by
      intro p
      have := congrArg f (hrow p)
      simp only [map_add, map_smul, smul_eq_mul] at this
      linear_combination -this + (α * ξ p + v p) * hfξ + ξ p * hfv
    have hv'p : ∀ p, v' p = (-(α' * f ξ' + f v') / f ξ') * ξ' p := by
      intro p
      rw [div_mul_eq_mul_div, eq_div_iff hf]
      linear_combination hc p
    have hc0 : -(α' * f ξ' + f v') / f ξ' = 0 := by
      by_contra hne
      apply hξ'
      have : ξ' = (-(α' * f ξ' + f v') / f ξ')⁻¹ • v' := by
        funext p
        rw [Pi.smul_apply, smul_eq_mul, hv'p p, ← mul_assoc, inv_mul_cancel₀ hne, one_mul]
      rw [this]; exact Submodule.smul_mem _ _ hv'
    have hv'0 : v' = 0 := by
      funext p; rw [hv'p p, hc0, zero_mul]; rfl
    have hξ'0 : ξ' ≠ 0 := fun h => hξ' (by rw [h]; exact Submodule.zero_mem _)
    obtain ⟨p0, hp0⟩ := Function.ne_iff.mp hξ'0
    have hp0' : ξ' p0 ≠ 0 := hp0
    have hα' : α' = 0 := by
      have := hc p0
      rw [hv'0, map_zero, Pi.zero_apply] at this
      have h2 : α' * (ξ' p0 * f ξ') = 0 := by linear_combination this
      exact (mul_eq_zero.mp h2).resolve_right (mul_ne_zero hp0' hf)
    rw [heq, hv'0, hα']
    funext q; simp

  have hξ0 : ξ ≠ 0 := fun h => hξ (by rw [h]; exact Submodule.zero_mem _)
  have s5 : Module.finrank K (Submodule.span K (insert ξ (Set.range η))) = n + 1 := by
    rw [Submodule.span_insert]
    have h1 := Submodule.finrank_sup_add_finrank_inf_eq (K ∙ ξ) (Submodule.span K (Set.range η))
    have h2 : (K ∙ ξ) ⊓ Submodule.span K (Set.range η) = ⊥ := by
      rw [Submodule.eq_bot_iff]
      intro x hx
      rw [Submodule.mem_inf, Submodule.mem_span_singleton] at hx
      obtain ⟨⟨a, rfl⟩, hx2⟩ := hx
      by_cases ha : a = 0
      · rw [ha, zero_smul]
      · exfalso; apply hξ
        have := Submodule.smul_mem _ a⁻¹ hx2
        rwa [smul_smul, inv_mul_cancel₀ ha, one_smul] at this
    rw [h2, finrank_bot, finrank_span_singleton hξ0, hT] at h1
    omega

  have s6 : ∀ {t : ℕ} (x : Fin (N + 1) → K) (η : Fin t → Fin (N + 1) → K),
      x ∉ Submodule.span K (Set.range η) →
      Module.finrank K (Submodule.span K (Set.range (wcLdpDtcRow x η))) =
        Module.finrank K (Submodule.span K (Set.range η)) + 1 := by
    intro t x η hx
    let Ψ : (K × Submodule.span K (Set.range η)) →ₗ[K] (Fin (N + 1) × Fin (N + 1) → K) :=
      { toFun := fun p q => p.1 * (x q.1 * x q.2) +
          (x q.1 * (p.2 : Fin (N + 1) → K) q.2 + (p.2 : Fin (N + 1) → K) q.1 * x q.2)
        map_add' := fun a b => by
          funext q
          simp only [Prod.fst_add, Prod.snd_add, Submodule.coe_add, Pi.add_apply]
          ring
        map_smul' := fun c a => by
          funext q
          simp only [Prod.smul_fst, Prod.smul_snd, Submodule.coe_smul, Pi.smul_apply,
            smul_eq_mul, RingHom.id_apply]
          ring }
    have hΨ : ∀ p : K × Submodule.span K (Set.range η), Ψ p = fun q => p.1 * (x q.1 * x q.2) +
          (x q.1 * (p.2 : Fin (N + 1) → K) q.2 + (p.2 : Fin (N + 1) → K) q.1 * x q.2) :=
      fun p => rfl
    have hrange : LinearMap.range Ψ = Submodule.span K (Set.range (wcLdpDtcRow x η)) := by
      ext S
      rw [LinearMap.mem_range, s1]
      constructor
      · rintro ⟨⟨α, v⟩, rfl⟩
        exact ⟨α, v, v.2, hΨ _⟩
      · rintro ⟨α, v, hv, rfl⟩
        exact ⟨(α, ⟨v, hv⟩), hΨ _⟩
    have hinj : Function.Injective Ψ := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      rintro ⟨α, v⟩ hp
      rw [LinearMap.mem_ker, hΨ] at hp
      obtain ⟨h1, h2⟩ := s2 x v η α hx v.2 hp
      exact Prod.ext h1 (Subtype.ext h2)
    rw [← hrange, LinearMap.finrank_range_of_inj hinj, Module.finrank_prod, Module.finrank_self]
    ring

  have hrow : (wcLdpDtcPM ξ η ξ' η').row = Sum.elim (wcLdpDtcRow ξ η) (wcLdpDtcRow ξ' η') := by
    funext r q
    rcases r with r | r <;> rfl
  have hrank : (wcLdpDtcPM ξ η ξ' η').rank =
      Module.finrank K ↥(Submodule.span K (Set.range (wcLdpDtcRow ξ η)) ⊔
        Submodule.span K (Set.range (wcLdpDtcRow ξ' η'))) := by
    rw [Matrix.rank_eq_finrank_span_row, hrow, Set.Sum.elim_range, Submodule.span_union]
  have hsum := Submodule.finrank_sup_add_finrank_inf_eq
    (Submodule.span K (Set.range (wcLdpDtcRow ξ η)))
    (Submodule.span K (Set.range (wcLdpDtcRow ξ' η')))
  rw [s6 ξ η hξ, s6 ξ' η' hξ', hT, hT', ← hrank] at hsum
  have key1 : ∀ w : Fin (N + 1) × Fin (N + 1) → K, Module.finrank K (K ∙ w) ≤ 1 := by
    intro w
    by_cases hw : w = 0
    · rw [hw, Submodule.span_singleton_eq_bot.mpr rfl, finrank_bot]; exact zero_le_one
    · rw [finrank_span_singleton hw]
  refine ⟨fun ⟨i, j, hd⟩ => ?_, fun hle => ?_, s5⟩
  · have hsub : Submodule.span K (Set.range (wcLdpDtcRow ξ η)) ⊓
        Submodule.span K (Set.range (wcLdpDtcRow ξ' η')) ≤
        K ∙ (fun q : Fin (N + 1) × Fin (N + 1) => ξ q.1 * ξ' q.2 + ξ' q.1 * ξ q.2) := by
      intro S hS
      rw [Submodule.mem_inf, s1, s1] at hS
      obtain ⟨⟨α, v, hv, rfl⟩, ⟨α', v', hv', heq⟩⟩ := hS
      obtain ⟨c, hc⟩ := s3 v v' α α' i j hd heq
      rw [Submodule.mem_span_singleton]
      exact ⟨c, hc.symm⟩
    have h1 := (Submodule.finrank_mono hsub).trans (key1 _)
    omega
  · by_contra hnot
    have hbot : Submodule.span K (Set.range (wcLdpDtcRow ξ η)) ⊓
        Submodule.span K (Set.range (wcLdpDtcRow ξ' η')) = ⊥ := by
      rw [Submodule.eq_bot_iff]
      intro S hS
      rw [Submodule.mem_inf, s1, s1] at hS
      obtain ⟨⟨α, v, hv, rfl⟩, ⟨α', v', hv', heq⟩⟩ := hS
      exact s4 v v' α α' hnot hv hv' heq
    rw [hbot, finrank_bot] at hsum
    omega

theorem wc_ldp_dtc_rank_of_ker (K : Type u) [Field K] {m' : Type} (N r : ℕ)
    (P : Matrix m' (Fin (N + 1) × Fin (N + 1)) K)
    (f : Fin r → ((Fin (N + 1) → Fin (N + 1) → K) →ₗ[K] K))
    (h : ∀ w : Fin (N + 1) → Fin (N + 1) → K, (∀ i, f i w = 0) →
      P.mulVec (fun q => w q.1 q.2) = 0) :
    P.rank ≤ r :=
by
  classical
  let u : (Fin (N + 1) → Fin (N + 1) → K) →ₗ[K] (Fin (N + 1) × Fin (N + 1) → K) :=
    { toFun := fun w q => w q.1 q.2
      map_add' := fun w w' => rfl
      map_smul' := fun c w => rfl }
  have hu : LinearMap.range u = ⊤ := by
    rw [LinearMap.range_eq_top]
    intro g
    exact ⟨fun a b => g (a, b), rfl⟩
  let F : (Fin (N + 1) → Fin (N + 1) → K) →ₗ[K] (Fin r → K) := LinearMap.pi f
  let L : (Fin (N + 1) → Fin (N + 1) → K) →ₗ[K] (m' → K) := P.mulVecLin ∘ₗ u
  have hker : LinearMap.ker F ≤ LinearMap.ker L := by
    intro w hw
    rw [LinearMap.mem_ker] at hw ⊢
    have hi : ∀ i, f i w = 0 := by
      intro i
      have := congrFun hw i
      simpa [F, LinearMap.pi_apply] using this
    show P.mulVec (fun q => w q.1 q.2) = 0
    exact h w hi
  have hrank : P.rank = Module.finrank K (LinearMap.range L) := by
    unfold Matrix.rank
    rw [LinearMap.range_comp_of_range_eq_top _ hu]
  have ha := LinearMap.finrank_range_add_finrank_ker F
  have hb := LinearMap.finrank_range_add_finrank_ker L
  have hc : Module.finrank K (LinearMap.ker F) ≤ Module.finrank K (LinearMap.ker L) :=
    Submodule.finrank_mono hker
  have hd : Module.finrank K (LinearMap.range F) ≤ r := by
    have := Submodule.finrank_le (LinearMap.range F)
    rwa [Module.finrank_fin_fun] at this
  rw [hrank]
  omega

theorem wc_ldp_dtc_bd_tensor_domain (K : Type u) [Field K] [IsAlgClosed K] (R S : Type u)
    [CommRing R] [CommRing S] [Algebra K R] [Algebra K S] [Algebra.FiniteType K R]
    [IsDomain R] [IsDomain S] : IsDomain (TensorProduct K R S) :=
by
  classical
  have hN : ∀ f : R, (∀ χ : R →ₐ[K] K, χ f = 0) → IsNilpotent f := by
    have s1 : ∀ (M : Ideal R), M.IsMaximal → ∃ χ : R →ₐ[K] K, ∀ r, χ r = 0 → r ∈ M := by
      intro M hM
      letI : Field (R ⧸ M) := Ideal.Quotient.field M
      haveI : Algebra.FiniteType K (R ⧸ M) :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ K M)
          (Ideal.Quotient.mkₐ_surjective K M)
      haveI : Module.Finite K (R ⧸ M) := finite_of_finite_type_of_isJacobsonRing K (R ⧸ M)
      haveI : Algebra.IsIntegral K (R ⧸ M) := Algebra.IsIntegral.of_finite K (R ⧸ M)
      have hb : Function.Bijective (algebraMap K (R ⧸ M)) :=
        IsAlgClosed.algebraMap_bijective_of_isIntegral
      let e : K ≃ₐ[K] (R ⧸ M) := AlgEquiv.ofBijective (Algebra.ofId K (R ⧸ M)) hb
      refine ⟨(e.symm : (R ⧸ M) →ₐ[K] K).comp (Ideal.Quotient.mkₐ K M), fun r hr => ?_⟩
      have h1 : e.symm (Ideal.Quotient.mkₐ K M r) = 0 := hr
      have h2 : Ideal.Quotient.mkₐ K M r = 0 := by
        have := congrArg e h1
        rwa [AlgEquiv.apply_symm_apply, map_zero] at this
      rw [Ideal.Quotient.mkₐ_eq_mk] at h2
      exact Ideal.Quotient.eq_zero_iff_mem.mp h2
    intro f hf
    haveI : IsJacobsonRing R := isJacobsonRing_of_finiteType (A := K) (B := R)
    have hjac : f ∈ (⊥ : Ideal R).jacobson := by
      rw [Ideal.jacobson, Ideal.mem_sInf]
      intro J hJ
      obtain ⟨χ, hχ⟩ := s1 J hJ.2
      exact hχ f (hf χ)
    rw [← Ideal.radical_eq_jacobson, Ideal.mem_radical_iff] at hjac
    obtain ⟨n, hn⟩ := hjac
    exact ⟨n, (Ideal.mem_bot).mp hn⟩
  have : Nontrivial (TensorProduct K R S) :=
    Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_isDomain K R S
      (algebraMap K R).injective (algebraMap K S).injective
  have hpz : ∀ a c : R, (∀ χ : R →ₐ[K] K, χ a = 0 ∨ χ c = 0) → a = 0 ∨ c = 0 := by
    intro a c h
    have hnil : IsNilpotent (a * c) := hN _ (fun χ => by
      rw [map_mul]
      rcases h χ with h' | h'
      · rw [h', zero_mul]
      · rw [h', mul_zero])
    exact mul_eq_zero.mp hnil.eq_zero
  let 𝒞 := Module.Free.chooseBasis K S
  let Φ : (R →ₐ[K] K) → TensorProduct K R S →ₐ[K] S := fun χ =>
    (Algebra.TensorProduct.lid K S).toAlgHom.comp (Algebra.TensorProduct.map χ (AlgHom.id K S))
  have hcoord : ∀ (χ : R →ₐ[K] K) (b : Module.Free.ChooseBasisIndex K S →₀ R),
      Φ χ (b.sum fun i m => TensorProduct.tmul K m (𝒞 i)) = 0 → ∀ i, χ (b i) = 0 := by
    intro χ b h i
    have h1 : Φ χ (b.sum fun i m => TensorProduct.tmul K m (𝒞 i)) =
        𝒞.repr.symm (b.mapRange χ (map_zero χ)) := by
      rw [map_finsuppSum, Module.Basis.repr_symm_apply, Finsupp.linearCombination_apply,
        Finsupp.sum_mapRange_index (fun j => zero_smul K (𝒞 j))]
      apply Finsupp.sum_congr
      intro j _
      simp [Φ]
    rw [h1, LinearEquiv.map_eq_zero_iff] at h
    have h2 := congrArg (fun f => f i) h
    simpa using h2
  have hnzd : NoZeroDivisors (TensorProduct K R S) := by
    constructor
    intro x y hxy
    obtain ⟨b, rfl⟩ := TensorProduct.eq_repr_basis_right 𝒞 x
    obtain ⟨c, rfl⟩ := TensorProduct.eq_repr_basis_right 𝒞 y
    have hdisj : ∀ χ : R →ₐ[K] K, (∀ i, χ (b i) = 0) ∨ (∀ j, χ (c j) = 0) := by
      intro χ
      have h0 : Φ χ (b.sum fun i m => TensorProduct.tmul K m (𝒞 i)) *
          Φ χ (c.sum fun i m => TensorProduct.tmul K m (𝒞 i)) = 0 := by
        rw [← map_mul, hxy, map_zero]
      rcases mul_eq_zero.mp h0 with h | h
      · exact Or.inl (hcoord χ b h)
      · exact Or.inr (hcoord χ c h)
    by_cases hb : b = 0
    · left
      rw [hb, Finsupp.sum_zero_index]
    · right
      obtain ⟨i0, hi0⟩ : ∃ i, b i ≠ 0 := by
        by_contra hcon
        exact hb (Finsupp.ext fun i => not_not.mp fun hne => hcon ⟨i, hne⟩)
      have hc : c = 0 := by
        ext j
        rcases hpz (b i0) (c j) (fun χ => (hdisj χ).imp (fun h => h i0) (fun h => h j)) with h | h
        · exact absurd h hi0
        · rw [h, Finsupp.coe_zero, Pi.zero_apply]
      rw [hc, Finsupp.sum_zero_index]
  exact NoZeroDivisors.to_isDomain _

theorem wc_ldp_dtc_bd_noether_le (K : Type u) [Field K] (R : Type u) [CommRing R] [Algebra K R]
    [Algebra.FiniteType K R] [Nontrivial R] (n : ℕ) (hd : ringKrullDim R ≤ n) :
    ∃ (e : ℕ) (g : MvPolynomial (Fin e) K →ₐ[K] R), e ≤ n ∧ Function.Injective g ∧ g.Finite :=
by
  obtain ⟨s, g, hinj, hfin⟩ := exists_finite_inj_algHom_of_fg K R
  refine ⟨s, g, ?_, hinj, hfin⟩
  letI : Algebra (MvPolynomial (Fin s) K) R := g.toRingHom.toAlgebra
  haveI : Module.Finite (MvPolynomial (Fin s) K) R := hfin
  haveI : Algebra.IsIntegral (MvPolynomial (Fin s) K) R :=
    Algebra.IsIntegral.of_finite (MvPolynomial (Fin s) K) R
  have hinj' : Function.Injective (algebraMap (MvPolynomial (Fin s) K) R) := hinj
  have hlift : ∀ p : LTSeries (PrimeSpectrum (MvPolynomial (Fin s) K)),
      ∃ q : LTSeries (PrimeSpectrum R), q.length = p.length ∧
        Ideal.comap (algebraMap (MvPolynomial (Fin s) K) R) q.last.asIdeal = p.last.asIdeal := by
    intro p
    induction p using RelSeries.inductionOn' with
    | singleton x =>
      obtain ⟨Q, -, hQ, hQc⟩ := Ideal.exists_ideal_over_prime_of_isIntegral x.asIdeal (⊥ : Ideal R)
        (by
          show Ideal.comap (algebraMap (MvPolynomial (Fin s) K) R) ⊥ ≤ x.asIdeal
          rw [Ideal.comap_bot_of_injective _ hinj']; exact bot_le)
      have hQc' : Ideal.comap (algebraMap (MvPolynomial (Fin s) K) R) Q = x.asIdeal := hQc
      exact ⟨RelSeries.singleton _ ⟨Q, hQ⟩, rfl, hQc'⟩
    | snoc p x hx ih =>
      obtain ⟨q, hql, hqc⟩ := ih
      have hlt : p.last < x := hx
      obtain ⟨Q, hQge, hQ, hQc⟩ :=
        Ideal.exists_ideal_over_prime_of_isIntegral x.asIdeal q.last.asIdeal
          (by
            show Ideal.comap (algebraMap (MvPolynomial (Fin s) K) R) q.last.asIdeal ≤ x.asIdeal
            rw [hqc]; exact hlt.le)
      have hQc' : Ideal.comap (algebraMap (MvPolynomial (Fin s) K) R) Q = x.asIdeal := hQc
      have hlt' : q.last < (⟨Q, hQ⟩ : PrimeSpectrum R) := by
        refine lt_of_le_of_ne (by exact hQge) ?_
        intro heq
        apply hlt.ne
        ext1
        rw [← hqc, ← hQc', heq]
      refine ⟨q.snoc ⟨Q, hQ⟩ hlt', ?_, ?_⟩
      · rw [RelSeries.snoc_length, RelSeries.snoc_length, hql]
      · rw [RelSeries.last_snoc, RelSeries.last_snoc]
        exact hQc'
  have hdimA : ringKrullDim (MvPolynomial (Fin s) K) = ((s : ℕ) : WithBot ℕ∞) := by
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
      ENat.card_eq_coe_fintype_card, Fintype.card_fin, zero_add]
    rfl
  have hle : ((s : ℕ) : WithBot ℕ∞) ≤ ringKrullDim R := by
    have h1 : ((s : ℕ) : WithBot ℕ∞) ≤ Order.krullDim (PrimeSpectrum (MvPolynomial (Fin s) K)) :=
      hdimA.symm.le
    obtain ⟨p, hp⟩ := Order.le_krullDim_iff.mp h1
    obtain ⟨q, hql, -⟩ := hlift p
    have h2 := Order.LTSeries.length_le_krullDim q
    rw [hql, hp] at h2
    exact h2
  have h3 := hle.trans hd
  exact_mod_cast h3

theorem wc_ldp_dtc_bd_tensor_embed (K : Type u) [Field K] (R S : Type u) [CommRing R] [CommRing S]
    [Algebra K R] [Algebra K S] (e f : ℕ) (g₁ : MvPolynomial (Fin e) K →ₐ[K] R)
    (g₂ : MvPolynomial (Fin f) K →ₐ[K] S) (h₁ : Function.Injective g₁)
    (h₂ : Function.Injective g₂) (hf₁ : g₁.Finite) (hf₂ : g₂.Finite) :
    Function.Injective (Algebra.TensorProduct.map g₁ g₂) ∧
      (Algebra.TensorProduct.map g₁ g₂).Finite ∧
      ringKrullDim (TensorProduct K (MvPolynomial (Fin e) K) (MvPolynomial (Fin f) K)) =
        ((e + f : ℕ) : WithBot ℕ∞) :=
by
  refine ⟨?_, RingHom.Finite.tensorProductMap hf₁ hf₂, ?_⟩
  · have hinj := TensorProduct.map_injective_of_flat_flat g₁.toLinearMap g₂.toLinearMap h₁ h₂
    have heq : ∀ z, Algebra.TensorProduct.map g₁ g₂ z =
        TensorProduct.map g₁.toLinearMap g₂.toLinearMap z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => rw [map_zero, map_zero]
      | tmul a b => rw [Algebra.TensorProduct.map_tmul, TensorProduct.map_tmul]; rfl
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    intro x y hxy
    apply hinj
    rw [← heq, ← heq]
    exact hxy
  · rw [ringKrullDim_eq_of_ringEquiv
      (MvPolynomial.algebraTensorAlgEquiv K (σ := Fin f) (MvPolynomial (Fin e) K)).toRingEquiv,
      MvPolynomial.ringKrullDim_of_isNoetherianRing, MvPolynomial.ringKrullDim_of_isNoetherianRing,
      ringKrullDim_eq_zero_of_field, ENat.card_eq_coe_fintype_card, ENat.card_eq_coe_fintype_card,
      Fintype.card_fin, Fintype.card_fin, zero_add]
    norm_cast

theorem wc_ldp_dtc_bd_loc_quot (A : Type u) [CommRing A] (g : A) (I : Ideal (Localization.Away g)) :
    ringKrullDim (Localization.Away g ⧸ I) ≤
      ringKrullDim (A ⧸ Ideal.comap (algebraMap A (Localization.Away g)) I) ∧
    (I ≠ ⊥ → Ideal.comap (algebraMap A (Localization.Away g)) I ≠ ⊥) :=
by
  set φ := algebraMap A (Localization.Away g) with hφ
  set J := Ideal.comap φ I with hJ
  refine ⟨?_, ?_⟩
  · let ψ : A ⧸ J →+* Localization.Away g ⧸ I := Ideal.quotientMap I φ le_rfl
    have hsq : ψ.comp (Ideal.Quotient.mk J) = (Ideal.Quotient.mk I).comp φ :=
      Ideal.quotientMap_comp_mk le_rfl
    have hinjφ : Function.Injective (PrimeSpectrum.comap φ) :=
      PrimeSpectrum.localization_comap_injective (Localization.Away g) (Submonoid.powers g)
    have hinjI : Function.Injective (PrimeSpectrum.comap (Ideal.Quotient.mk I)) :=
      PrimeSpectrum.comap_injective_of_surjective _ Ideal.Quotient.mk_surjective
    have hinj : Function.Injective (PrimeSpectrum.comap ψ) := by
      intro p q hpq
      apply hinjI
      apply hinjφ
      have h1 : PrimeSpectrum.comap (Ideal.Quotient.mk J) (PrimeSpectrum.comap ψ p) =
          PrimeSpectrum.comap (Ideal.Quotient.mk J) (PrimeSpectrum.comap ψ q) := by rw [hpq]
      ext1
      have h2 := congrArg PrimeSpectrum.asIdeal h1
      simp only [PrimeSpectrum.comap_asIdeal, Ideal.comap_comap] at h2 ⊢
      rw [hsq] at h2
      exact h2
    have hmono : Monotone (PrimeSpectrum.comap ψ) := by
      intro p q hpq
      show Ideal.comap ψ p.asIdeal ≤ Ideal.comap ψ q.asIdeal
      exact Ideal.comap_mono hpq
    exact Order.krullDim_le_of_strictMono _ (hmono.strictMono_of_injective hinj)
  · intro hI hJ0
    apply hI
    have h := IsLocalization.map_comap (Submonoid.powers g) (Localization.Away g) I
    rw [← h]
    show Ideal.map φ J = ⊥
    rw [hJ0, Ideal.map_bot]

theorem wc_ldp_dtc_bd_integral_drop (P A : Type u) [CommRing P] [CommRing A] [IsDomain A]
    (φ : P →+* A) (hinj : Function.Injective φ) (hint : φ.IsIntegral) (m : ℕ)
    (hP : ringKrullDim P ≤ m) (J : Ideal A) (hJ : J ≠ ⊥) :
    ringKrullDim (A ⧸ J) ≤ ((m - 1 : ℕ) : WithBot ℕ∞) :=
by
  classical

  have s1 : ringKrullDim A ≤ ringKrullDim P := by
    letI := φ.toAlgebra
    haveI : Algebra.IsIntegral P A := ⟨fun x => hint x⟩
    apply Order.krullDim_le_of_strictMono (PrimeSpectrum.comap φ)
    intro p q hpq
    rw [← PrimeSpectrum.asIdeal_lt_asIdeal] at hpq ⊢
    have h := Ideal.IsIntegral.under_lt_under (R := P) hpq
    rw [Ideal.under_def, Ideal.under_def] at h
    exact h

  obtain ⟨x, hxJ, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hJ
  have hxnzd : x ∈ nonZeroDivisors A := mem_nonZeroDivisors_of_ne_zero hx0
  have s3 := ringKrullDim_quotient_succ_le_of_nonZeroDivisor hxnzd
  have hle : Ideal.span {x} ≤ J := (Ideal.span_singleton_le_iff_mem J).mpr hxJ
  have s4 : ringKrullDim (A ⧸ J) ≤ ringKrullDim (A ⧸ Ideal.span {x}) :=
    ringKrullDim_le_of_surjective _ (Ideal.Quotient.factor_surjective hle)
  have hstar : ringKrullDim (A ⧸ J) + 1 ≤ (m : WithBot ℕ∞) :=
    (add_le_add s4 le_rfl).trans (s3.trans (s1.trans hP))

  generalize ringKrullDim (A ⧸ J) = d at hstar ⊢
  induction d using WithBot.recBotCoe with
  | bot => exact bot_le
  | coe e =>
    induction e using ENat.recTopCoe with
    | top =>
      exfalso
      have : ((⊤ : ℕ∞) : WithBot ℕ∞) + 1 = ((⊤ : ℕ∞) : WithBot ℕ∞) := rfl
      rw [this] at hstar
      have h2 : (⊤ : ℕ∞) ≤ (m : ℕ∞) := by exact_mod_cast hstar
      exact ENat.coe_ne_top m (top_le_iff.mp h2)
    | coe k =>
      have h2 : k + 1 ≤ m := by exact_mod_cast hstar
      have h3 : k ≤ m - 1 := by omega
      rw [← WithBot.coe_natCast]
      exact WithBot.coe_le_coe.mpr (Nat.cast_le.mpr h3)

theorem wc_ldp_dtc_base_dim (K : Type u) [Field K] [IsAlgClosed K] (n : ℕ) (hn : 1 ≤ n)
    (R S : Type u) [CommRing R] [CommRing S] [Algebra K R] [Algebra K S]
    [Algebra.FiniteType K R] [Algebra.FiniteType K S]
    (hR : IsDomain R ∨ Subsingleton R) (hS : IsDomain S ∨ Subsingleton S)
    (hdR : ringKrullDim R ≤ n) (hdS : ringKrullDim S ≤ n) (g : TensorProduct K R S) :
    Algebra.FiniteType K (Localization.Away g) ∧
    ∀ I : Ideal (Localization.Away g), I ≠ ⊥ →
      ringKrullDim (Localization.Away g ⧸ I) ≤ ((2 * n - 1 : ℕ) : WithBot ℕ∞) :=
by
  classical

  haveI hFTRD : Algebra.FiniteType R (TensorProduct K R S) :=
    Algebra.FiniteType.baseChange (R := K) (A := S) R
  haveI hFTD : Algebra.FiniteType K (TensorProduct K R S) :=
    Algebra.FiniteType.trans (inferInstance : Algebra.FiniteType K R) hFTRD
  refine ⟨Algebra.FiniteType.trans hFTD
    (inferInstance : Algebra.FiniteType (TensorProduct K R S) (Localization.Away g)), ?_⟩
  intro I hI

  have hsub : Subsingleton R ∨ Subsingleton S → False := by
    intro h
    have hD : Subsingleton (TensorProduct K R S) := by
      apply subsingleton_of_zero_eq_one
      rcases h with h | h
      · calc (0 : TensorProduct K R S) = (0 : R) ⊗ₜ[K] (1 : S) :=
              (TensorProduct.zero_tmul _ _).symm
          _ = (1 : R) ⊗ₜ[K] (1 : S) := by rw [Subsingleton.elim (0 : R) 1]
          _ = 1 := rfl
      · calc (0 : TensorProduct K R S) = (1 : R) ⊗ₜ[K] (0 : S) :=
              (TensorProduct.tmul_zero _ _).symm
          _ = (1 : R) ⊗ₜ[K] (1 : S) := by rw [Subsingleton.elim (0 : S) 1]
          _ = 1 := rfl
    have h01 : (0 : Localization.Away g) = 1 := by
      rw [← map_zero (algebraMap (TensorProduct K R S) (Localization.Away g)),
        Subsingleton.elim (0 : TensorProduct K R S) 1, map_one]
    haveI : Subsingleton (Localization.Away g) := subsingleton_of_zero_eq_one h01
    exact hI (Subsingleton.elim _ _)
  rcases hR with hR | hR
  swap
  · exact (hsub (Or.inl hR)).elim
  rcases hS with hS | hS
  swap
  · exact (hsub (Or.inr hS)).elim

  haveI := hR
  haveI := hS
  haveI hDdom : IsDomain (TensorProduct K R S) := wc_ldp_dtc_bd_tensor_domain K R S
  obtain ⟨e, g₁, he, hi₁, hf₁⟩ := wc_ldp_dtc_bd_noether_le K R n hdR
  obtain ⟨f, g₂, hf, hi₂, hf₂⟩ := wc_ldp_dtc_bd_noether_le K S n hdS
  obtain ⟨hinj, hfin, hdim⟩ := wc_ldp_dtc_bd_tensor_embed K R S e f g₁ g₂ hi₁ hi₂ hf₁ hf₂
  obtain ⟨hlq, hJ⟩ := wc_ldp_dtc_bd_loc_quot (TensorProduct K R S) g I
  have hdrop := wc_ldp_dtc_bd_integral_drop
    (TensorProduct K (MvPolynomial (Fin e) K) (MvPolynomial (Fin f) K)) (TensorProduct K R S)
    (Algebra.TensorProduct.map g₁ g₂).toRingHom hinj (RingHom.Finite.to_isIntegral hfin)
    (e + f) hdim.le _ (hJ hI)
  refine hlq.trans (hdrop.trans ?_)
  have harith : e + f - 1 ≤ 2 * n - 1 := by omega
  exact_mod_cast harith

theorem wc_ldp_double_tangent_count (K : Type u) [Field K] [IsAlgClosed K] (N n : ℕ)
    (hn2 : 2 ≤ n) (X : Over (Spec (.of K))) [GeometricallyIrreducible X.hom] [IsProper X.hom]
    [SmoothOfRelativeDimension n X.hom] (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι)
    (hιX : ι ≫ wcProjKStr K N = X.hom) (hnl : ¬ wcLdpLin K N n ι) :
    ∃ (A : Type u) (_ : CommRing A) (_ : Algebra K A) (_ : Algebra.FiniteType K A),
      ringKrullDim A < (Fintype.card (Fin 2 × Fin (N + 1) × Fin (N + 1)) : WithBot ℕ∞) ∧
      ∃ φ : MvPolynomial (Fin 2 × Fin (N + 1) × Fin (N + 1)) K →ₐ[K] A,
        ∀ (v : Fin 2 × Fin (N + 1) × Fin (N + 1) → K) (x x' : X.left),
          IsClosed ({x} : Set X.left) → IsClosed ({x'} : Set X.left) → x ≠ x' →
          ∀ c : Fin 2 → K, c ≠ 0 →
          wcLdpSing2 K N ι (c 1 • (wcLdpQuad K N fun p q => v (0, p, q)) -
            c 0 • (wcLdpQuad K N fun p q => v (1, p, q))) x →
          wcLdpSing2 K N ι (c 1 • (wcLdpQuad K N fun p q => v (0, p, q)) -
            c 0 • (wcLdpQuad K N fun p q => v (1, p, q))) x' →
          wcLdpDT K N n ι x x' →
          ∃ χ : A →ₐ[K] K, ∀ Φ, χ (φ Φ) = MvPolynomial.eval v Φ :=
by
  classical

  obtain ⟨R, _, _, _, u, t, η, pt, hdom, hdimR, hu1, hP1, hP4, hP5, hcov, hP2, hP3⟩ :=
    wc_ldp_dtc_chart_model K N n X ι hι hιX

  have hmapPM : ∀ {C D : Type u} [CommRing C] [CommRing D] [Algebra K C] [Algebra K D]
      (f : C →ₐ[K] D) {t₁ t₂ : ℕ} (ξ ξ' : Fin (N + 1) → C) (e : Fin t₁ → Fin (N + 1) → C)
      (e' : Fin t₂ → Fin (N + 1) → C),
      (wcLdpDtcPM ξ e ξ' e').map f =
        wcLdpDtcPM (fun p => f (ξ p)) (fun k p => f (e k p)) (fun p => f (ξ' p))
          (fun k p => f (e' k p)) := by
    intro C D _ _ _ _ f t₁ t₂ ξ ξ' e e'
    ext r q
    rcases r with (_ | k) | (_ | k) <;> simp [wcLdpDtcPM, wcLdpDtcRow]

  have hnotin : ∀ (a : Fin (N + 1)) (χ : R a →ₐ[K] K),
      (fun p => χ (u a p)) ∉ Submodule.span K (Set.range fun k => fun p => χ (η a k p)) := by
    intro a χ hmem
    have hle : Submodule.span K (Set.range fun k => fun p => χ (η a k p)) ≤
        LinearMap.ker (LinearMap.proj a : (Fin (N + 1) → K) →ₗ[K] K) := by
      rw [Submodule.span_le]
      rintro _ ⟨k, rfl⟩
      simp [(hP1 a χ).2 k]
    have h1 := hle hmem
    simp [hu1 a] at h1

  have hpiece : ∀ a b i j : Fin (N + 1), ∃ (Ap : Type u) (_ : CommRing Ap) (_ : Algebra K Ap)
      (_ : Algebra.FiniteType K Ap),
      ringKrullDim Ap < (Fintype.card (Fin 2 × Fin (N + 1) × Fin (N + 1)) : WithBot ℕ∞) ∧
      ∃ φp : MvPolynomial (Fin 2 × Fin (N + 1) × Fin (N + 1)) K →ₐ[K] Ap,
        ∀ (χ : R a →ₐ[K] K) (χ' : R b →ₐ[K] K),
          χ (u a i) * χ' (u b j) - χ (u a j) * χ' (u b i) ≠ 0 →
          (wcLdpDtcPM (fun p => χ (u a p)) (fun k p => χ (η a k p))
            (fun p => χ' (u b p)) (fun k p => χ' (η b k p))).rank ≤ 2 * n + 1 →
          ∀ (τ : K) (g h : Fin (N + 1) × Fin (N + 1) → K),
          (wcLdpDtcPM (fun p => χ (u a p)) (fun k p => χ (η a k p))
            (fun p => χ' (u b p)) (fun k p => χ' (η b k p))).mulVec h = 0 →
          (∃ ψ : Ap →ₐ[K] K, ∀ Φ, ψ (φp Φ) = MvPolynomial.eval
            (fun s : Fin 2 × Fin (N + 1) × Fin (N + 1) =>
              if s.1 = 0 then g s.2 else τ * g s.2 - h s.2) Φ) ∧
          (∃ ψ : Ap →ₐ[K] K, ∀ Φ, ψ (φp Φ) = MvPolynomial.eval
            (fun s : Fin 2 × Fin (N + 1) × Fin (N + 1) =>
              if s.1 = 0 then τ * g s.2 + h s.2 else g s.2) Φ) := by
    intro a b i j
    obtain ⟨δ, hδ⟩ : ∃ δ : TensorProduct K (R a) (R b),
        δ = (u a i ⊗ₜ[K] (1 : R b)) * ((1 : R a) ⊗ₜ[K] u b j) -
          (u a j ⊗ₜ[K] (1 : R b)) * ((1 : R a) ⊗ₜ[K] u b i) := ⟨_, rfl⟩
    obtain ⟨hfinB, hdimB⟩ := wc_ldp_dtc_base_dim K n (by omega) (R a) (R b) (hdom a) (hdom b)
      (hdimR a) (hdimR b) δ
    haveI := hfinB
    have hδalg : algebraMap (TensorProduct K (R a) (R b)) (Localization.Away δ) δ =
        algebraMap _ (Localization.Away δ) (u a i ⊗ₜ[K] (1 : R b)) *
          algebraMap _ (Localization.Away δ) ((1 : R a) ⊗ₜ[K] u b j) -
        algebraMap _ (Localization.Away δ) (u a j ⊗ₜ[K] (1 : R b)) *
          algebraMap _ (Localization.Away δ) ((1 : R a) ⊗ₜ[K] u b i) := by
      rw [← map_mul, ← map_mul, ← map_sub, ← hδ]
    obtain ⟨Lp, hLp⟩ : ∃ Lp : Matrix (Option (Fin (t a)) ⊕ Option (Fin (t b)))
        (Fin (N + 1) × Fin (N + 1)) (Localization.Away δ),
        Lp = wcLdpDtcPM
          (fun p => algebraMap (TensorProduct K (R a) (R b)) (Localization.Away δ)
            (u a p ⊗ₜ[K] (1 : R b)))
          (fun k p => algebraMap (TensorProduct K (R a) (R b)) (Localization.Away δ)
            (η a k p ⊗ₜ[K] (1 : R b)))
          (fun p => algebraMap (TensorProduct K (R a) (R b)) (Localization.Away δ)
            ((1 : R a) ⊗ₜ[K] u b p))
          (fun k p => algebraMap (TensorProduct K (R a) (R b)) (Localization.Away δ)
            ((1 : R a) ⊗ₜ[K] η b k p)) := ⟨_, rfl⟩

    have hrestrict : ∀ Θ : Localization.Away δ →ₐ[K] K, ∃ (χ : R a →ₐ[K] K) (χ' : R b →ₐ[K] K),
        χ (u a i) * χ' (u b j) - χ (u a j) * χ' (u b i) ≠ 0 ∧
        Lp.map Θ = wcLdpDtcPM (fun p => χ (u a p)) (fun k p => χ (η a k p))
          (fun p => χ' (u b p)) (fun k p => χ' (η b k p)) := by
      intro Θ
      refine ⟨(Θ.comp (IsScalarTower.toAlgHom K (TensorProduct K (R a) (R b))
          (Localization.Away δ))).comp Algebra.TensorProduct.includeLeft,
        (Θ.comp (IsScalarTower.toAlgHom K (TensorProduct K (R a) (R b))
          (Localization.Away δ))).comp Algebra.TensorProduct.includeRight, ?_, ?_⟩
      · intro h0
        apply ((IsLocalization.Away.algebraMap_isUnit δ :
          IsUnit (algebraMap (TensorProduct K (R a) (R b)) (Localization.Away δ) δ)).map
            Θ).ne_zero
        rw [hδalg, map_sub, map_mul, map_mul]
        exact h0
      · rw [hLp, hmapPM]
        rfl

    have hlift : ∀ (χ : R a →ₐ[K] K) (χ' : R b →ₐ[K] K),
        χ (u a i) * χ' (u b j) - χ (u a j) * χ' (u b i) ≠ 0 →
        ∃ Ψ : Localization.Away δ →ₐ[K] K,
          Lp.map Ψ = wcLdpDtcPM (fun p => χ (u a p)) (fun k p => χ (η a k p))
            (fun p => χ' (u b p)) (fun k p => χ' (η b k p)) := by
      intro χ χ' hmin
      have hδv : Algebra.TensorProduct.productMap χ χ' δ =
          χ (u a i) * χ' (u b j) - χ (u a j) * χ' (u b i) := by
        rw [hδ]
        simp only [map_sub, map_mul, Algebra.TensorProduct.productMap_apply_tmul, map_one,
          mul_one, one_mul]
      have hunit : ∀ y : Submonoid.powers δ,
          IsUnit (Algebra.TensorProduct.productMap χ χ' (y : TensorProduct K (R a) (R b))) := by
        intro y
        obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp y.2
        rw [← hk, map_pow, hδv]
        exact (isUnit_iff_ne_zero.mpr hmin).pow k
      refine ⟨IsLocalization.liftAlgHom (M := Submonoid.powers δ) (S := Localization.Away δ)
        hunit, ?_⟩
      have hval : ∀ z, IsLocalization.liftAlgHom (M := Submonoid.powers δ)
          (S := Localization.Away δ) hunit (algebraMap _ _ z) =
          Algebra.TensorProduct.productMap χ χ' z := by
        intro z
        rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
        rfl
      rw [hLp, hmapPM]
      simp only [hval, Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one, one_mul]

    obtain ⟨J, hJdef⟩ : ∃ J : Ideal (Localization.Away δ),
        J = Ideal.span (Set.range fun rc : (Fin (2 * n + 2) → Option (Fin (t a)) ⊕ Option (Fin (t b))) ×
          (Fin (2 * n + 2) → Fin (N + 1) × Fin (N + 1)) => (Lp.submatrix rc.1 rc.2).det) :=
      ⟨_, rfl⟩
    have hdetmap : ∀ (Θ : Localization.Away δ →ₐ[K] K)
        (r : Fin (2 * n + 2) → Option (Fin (t a)) ⊕ Option (Fin (t b)))
        (c : Fin (2 * n + 2) → Fin (N + 1) × Fin (N + 1)),
        Θ ((Lp.submatrix r c).det) = ((Lp.map Θ).submatrix r c).det := by
      intro Θ r c
      rw [AlgHom.map_det, AlgHom.mapMatrix_apply]
      rfl
    have hF1 : ∀ Θ : Localization.Away δ →ₐ[K] K,
        (∀ z ∈ J, Θ z = 0) ↔ (Lp.map Θ).rank ≤ 2 * n + 1 := by
      intro Θ
      constructor
      · intro hJ
        by_contra hlt
        push_neg at hlt
        obtain ⟨r, c, hrc⟩ := (wc_ldp_dtc_rank_minor K (Lp.map Θ) (2 * n + 2)).mp (by omega)
        apply hrc
        rw [← hdetmap]
        exact hJ _ (by rw [hJdef]; exact Ideal.subset_span ⟨(r, c), rfl⟩)
      · intro hrk z hz
        have hle : J ≤ RingHom.ker Θ := by
          rw [hJdef, Ideal.span_le]
          rintro _ ⟨rc, rfl⟩
          rw [SetLike.mem_coe, RingHom.mem_ker]
          by_contra hne
          have h2 := (wc_ldp_dtc_rank_minor K (Lp.map Θ) (2 * n + 2)).mpr
            ⟨rc.1, rc.2, by rw [← hdetmap]; exact hne⟩
          omega
        exact (RingHom.mem_ker).mp (hle hz)
    obtain ⟨L', hL'⟩ : ∃ L' : Matrix (Option (Fin (t a)) ⊕ Option (Fin (t b)))
        (Fin (N + 1) × Fin (N + 1)) (Localization.Away δ ⧸ J),
        L' = Lp.map (Ideal.Quotient.mkₐ K J) := ⟨_, rfl⟩

    have hrankB' : ∀ Ψ' : (Localization.Away δ ⧸ J) →ₐ[K] K, 2 * n + 1 ≤ (L'.map Ψ').rank := by
      intro Ψ'
      have e1 : L'.map Ψ' = Lp.map (Ψ'.comp (Ideal.Quotient.mkₐ K J)) := by
        rw [hL']
        ext r q
        rfl
      obtain ⟨χ, χ', hmin, hΘ⟩ := hrestrict (Ψ'.comp (Ideal.Quotient.mkₐ K J))
      rw [e1, hΘ]
      exact (wc_ldp_dtc_pair_rank K N n (t a) (t b) _ _ _ _ (hP1 a χ).1 (hP1 b χ').1
        (hnotin a χ) (hnotin b χ')).1 ⟨i, j, hmin⟩

    have hdimB' : ringKrullDim (Localization.Away δ ⧸ J) ≤ ((2 * n - 1 : ℕ) : WithBot ℕ∞) := by
      by_cases hJ : J = ⊥
      · have hsub : Subsingleton (Localization.Away δ) := by
          by_contra hns
          rw [not_subsingleton_iff_nontrivial] at hns
          obtain ⟨Ψ0⟩ := (wc_ldp_dtc_nullstellensatz K (Localization.Away δ)).1 hns
          obtain ⟨χ0, χ0', hmin0, -⟩ := hrestrict Ψ0
          have hpr := wc_ldp_dtc_pair_rank K N n (t a) (t b) (fun p => χ0 (u a p))
            (fun p => χ0' (u b p)) (fun k p => χ0 (η a k p)) (fun k p => χ0' (η b k p))
            (hP1 a χ0).1 (hP1 b χ0').1 (hnotin a χ0) (hnotin b χ0')
          apply hnl
          refine wc_ldp_dtc_lin_of_chart K N n X ι hι hιX b (hP5 b ⟨χ0'⟩)
            (Submodule.span K (insert (fun p => χ0 (u a p)) (Set.range fun k p => χ0 (η a k p))))
            hpr.2.2 ?_
          intro ℓ hℓ
          apply hP4 b ℓ
          obtain ⟨d, hd⟩ : ∃ d : R b, d = algebraMap K (R b) (χ0 (u a i)) * u b j -
              algebraMap K (R b) (χ0 (u a j)) * u b i := ⟨_, rfl⟩
          have hd0 : χ0' d ≠ 0 := by
            rw [hd]
            simpa [AlgHom.commutes] using hmin0
          have hall : ∀ χ' : R b →ₐ[K] K,
              χ' (d * ∑ p, algebraMap K (R b) (ℓ p) * u b p) = 0 := by
            intro χ'
            rw [map_mul]
            by_cases hχd : χ' d = 0
            · rw [hχd, zero_mul]
            · apply mul_eq_zero_of_right
              have hmin' : χ0 (u a i) * χ' (u b j) - χ0 (u a j) * χ' (u b i) ≠ 0 := by
                rw [hd] at hχd
                simpa [AlgHom.commutes] using hχd
              obtain ⟨Ψ', hΨ'⟩ := hlift χ0 χ' hmin'
              have hrk : (Lp.map Ψ').rank ≤ 2 * n + 1 :=
                (hF1 Ψ').mp (fun z hz => by
                  rw [hJ, Ideal.mem_bot] at hz
                  rw [hz, map_zero])
              rw [hΨ'] at hrk
              have hmem := (wc_ldp_dtc_pair_rank K N n (t a) (t b) (fun p => χ0 (u a p))
                (fun p => χ' (u b p)) (fun k p => χ0 (η a k p)) (fun k p => χ' (η b k p))
                (hP1 a χ0).1 (hP1 b χ').1 (hnotin a χ0) (hnotin b χ')).2.1 hrk
              have h3 := hℓ _ hmem
              simpa [map_sum, AlgHom.commutes] using h3
          have hnil := (wc_ldp_dtc_nullstellensatz K (R b)).2 _ hall
          haveI hdomb : IsDomain (R b) := by
            rcases hdom b with h | h
            · exact h
            · exfalso
              apply hd0
              rw [Subsingleton.elim d 0, map_zero]
          rcases mul_eq_zero.mp hnil.eq_zero with h | h
          · exact (hd0 (by rw [h, map_zero])).elim
          · exact h
        haveI : Subsingleton (Localization.Away δ ⧸ J) :=
          (Ideal.Quotient.mk_surjective (I := J)).subsingleton
        rw [ringKrullDim_eq_bot_iff_subsingleton.mpr this]
        exact bot_le
      · exact hdimB J hJ

    obtain ⟨A', iA1, iA2, iA3, hdimA', φ', hφ'⟩ :=
      wc_ldp_dtc_fibre_count K N (Localization.Away δ ⧸ J) (2 * n - 1) (2 * n + 1) hdimB'
        (by omega) L' hrankB'
    refine ⟨A', iA1, iA2, iA3, hdimA', φ', ?_⟩
    intro χ χ' hmin hrk τ g h hh
    obtain ⟨Ψ, hΨ⟩ := hlift χ χ' hmin
    have hkillJ : ∀ z ∈ J, Ψ z = 0 := (hF1 Ψ).mpr (by rw [hΨ]; exact hrk)
    have hL'Ψ' : L'.map (Ideal.Quotient.liftₐ J Ψ hkillJ) = Lp.map Ψ := by
      rw [hL']
      ext r q
      simp only [Matrix.map_apply, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.liftₐ_apply]
      exact Ideal.Quotient.lift_mk J _ _
    exact hφ' (Ideal.Quotient.liftₐ J Ψ hkillJ) τ g h (by rw [hL'Ψ', hΨ]; exact hh)

  choose Ap iAp1 iAp2 iAp3 hAp φp hφp using hpiece
  obtain ⟨hfinA, hdimA⟩ := wc_ldp_dtc_pi_dim K
    (fun p : Fin (N + 1) × Fin (N + 1) × Fin (N + 1) × Fin (N + 1) =>
      Ap p.1 p.2.1 p.2.2.1 p.2.2.2)
    ((Fintype.card (Fin 2 × Fin (N + 1) × Fin (N + 1)) : ℕ) : WithBot ℕ∞)
    (bot_le.trans_lt (hAp 0 0 0 0)) (fun p => hAp p.1 p.2.1 p.2.2.1 p.2.2.2)
  refine ⟨∀ p : Fin (N + 1) × Fin (N + 1) × Fin (N + 1) × Fin (N + 1),
      Ap p.1 p.2.1 p.2.2.1 p.2.2.2, inferInstance, inferInstance, hfinA, hdimA,
    AlgHom.pi (fun p => φp p.1 p.2.1 p.2.2.1 p.2.2.2), ?_⟩

  intro v x x' hx hx' hne c hc hs1 hs2 hDT
  obtain ⟨a, hxa⟩ := hcov x
  obtain ⟨b, hxb⟩ := hcov x'
  obtain ⟨i, j, hij⟩ := hP3 a b x x' hxa hxb hx hx' hne
  have hkill : ∀ w' : Fin (N + 1) → Fin (N + 1) → K,
      wcLdpSing2 K N ι (wcLdpQuad K N w') x → wcLdpSing2 K N ι (wcLdpQuad K N w') x' →
      (wcLdpDtcPM (fun p => pt a x hxa (u a p)) (fun k p => pt a x hxa (η a k p))
        (fun p => pt b x' hxb (u b p)) (fun k p => pt b x' hxb (η b k p))).mulVec
        (fun q => w' q.1 q.2) = 0 := by
    intro w' h1 h2
    funext r
    rcases r with r | r
    · exact hP2 a x hxa hx w' (h1 a hxa) r
    · exact hP2 b x' hxb hx' w' (h2 b hxb) r
  obtain ⟨f, hf⟩ := hDT
  have hrank := wc_ldp_dtc_rank_of_ker K N (2 * n + 1)
    (wcLdpDtcPM (fun p => pt a x hxa (u a p)) (fun k p => pt a x hxa (η a k p))
        (fun p => pt b x' hxb (u b p)) (fun k p => pt b x' hxb (η b k p))) f
    (fun w' hw' => hkill w' (hf w' hw').1 (hf w' hw').2)
  obtain ⟨w, hw⟩ : ∃ w : Fin (N + 1) → Fin (N + 1) → K,
      ∀ p q, w p q = c 1 * v (0, p, q) - c 0 * v (1, p, q) := ⟨_, fun _ _ => rfl⟩
  have hQ : wcLdpQuad K N w = c 1 • (wcLdpQuad K N fun p q => v (0, p, q)) -
      c 0 • (wcLdpQuad K N fun p q => v (1, p, q)) := by
    rw [show w = fun p q => c 1 * v (0, p, q) - c 0 * v (1, p, q) from
      funext fun p => funext fun q => hw p q]
    apply Subtype.ext
    simp only [wcLdpQuad, Submodule.coe_sub, Submodule.coe_smul, Finset.smul_sum,
      ← Finset.sum_sub_distrib, MvPolynomial.C_sub, MvPolynomial.C_mul, sub_mul,
      MvPolynomial.smul_eq_C_mul, mul_assoc]
  have hPw := hkill w (by rw [hQ]; exact hs1) (by rw [hQ]; exact hs2)
  by_cases h0 : c 0 = 0
  · have h1 : c 1 ≠ 0 := fun h1 => hc (funext fun k => by fin_cases k <;> simp [h0, h1])
    obtain ⟨ψ, hψ⟩ := (hφp a b i j (pt a x hxa) (pt b x' hxb) hij hrank (c 0 / c 1)
      (fun q => v (1, q.1, q.2)) ((c 1)⁻¹ • fun q => w q.1 q.2)
      (by rw [Matrix.mulVec_smul, hPw, smul_zero])).2
    refine ⟨ψ.comp (Pi.evalAlgHom K (fun p : Fin (N + 1) × Fin (N + 1) × Fin (N + 1) × Fin (N + 1) =>
      Ap p.1 p.2.1 p.2.2.1 p.2.2.2) (a, b, i, j)), fun Φ => ?_⟩
    show ψ (φp a b i j Φ) = _
    rw [hψ]
    refine congrArg (fun z => MvPolynomial.eval z Φ) ?_
    funext s
    obtain ⟨s, p, q⟩ := s
    fin_cases s <;> simp [hw, h0, h1]
  · obtain ⟨ψ, hψ⟩ := (hφp a b i j (pt a x hxa) (pt b x' hxb) hij hrank (c 1 / c 0)
      (fun q => v (0, q.1, q.2)) ((c 0)⁻¹ • fun q => w q.1 q.2)
      (by rw [Matrix.mulVec_smul, hPw, smul_zero])).1
    refine ⟨ψ.comp (Pi.evalAlgHom K (fun p : Fin (N + 1) × Fin (N + 1) × Fin (N + 1) × Fin (N + 1) =>
      Ap p.1 p.2.1 p.2.2.1 p.2.2.2) (a, b, i, j)), fun Φ => ?_⟩
    show ψ (φp a b i j Φ) = _
    rw [hψ]
    refine congrArg (fun z => MvPolynomial.eval z Φ) ?_
    funext s
    obtain ⟨s, p, q⟩ := s
    fin_cases s
    · simp
    · simp [hw]
      field_simp
      ring

theorem wc_ldp_double_generic (K : Type u) [Field K] [IsAlgClosed K] (N n : ℕ) (hn2 : 2 ≤ n)
    (X : Over (Spec (.of K))) [GeometricallyIrreducible X.hom] [IsProper X.hom]
    [SmoothOfRelativeDimension n X.hom] (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι)
    (hιX : ι ≫ wcProjKStr K N = X.hom) :
    ∃ Φ : MvPolynomial (Fin 2 × Fin (N + 1) × Fin (N + 1)) K, Φ ≠ 0 ∧
      ∀ v : Fin 2 × Fin (N + 1) × Fin (N + 1) → K, MvPolynomial.eval v Φ ≠ 0 →
        ∀ x x' : X.left, IsClosed ({x} : Set X.left) → IsClosed ({x'} : Set X.left) → x ≠ x' →
          wcLdpCrit K N X.hom ι (wcLdpQuad K N fun p q => v (0, p, q))
            (wcLdpQuad K N fun p q => v (1, p, q)) x →
          wcLdpCrit K N X.hom ι (wcLdpQuad K N fun p q => v (0, p, q))
            (wcLdpQuad K N fun p q => v (1, p, q)) x' →
          ∀ c c' : Fin 2 → K, c ≠ 0 → c' ≠ 0 →
            wcLdpZero K N ι (c 1 • (wcLdpQuad K N fun p q => v (0, p, q)) -
              c 0 • (wcLdpQuad K N fun p q => v (1, p, q))) x →
            wcLdpZero K N ι (c' 1 • (wcLdpQuad K N fun p q => v (0, p, q)) -
              c' 0 • (wcLdpQuad K N fun p q => v (1, p, q))) x' →
            wcLdpODPAt K N n ι (c 1 • (wcLdpQuad K N fun p q => v (0, p, q)) -
              c 0 • (wcLdpQuad K N fun p q => v (1, p, q))) x →
            wcLdpODPAt K N n ι (c' 1 • (wcLdpQuad K N fun p q => v (0, p, q)) -
              c' 0 • (wcLdpQuad K N fun p q => v (1, p, q))) x' →
            c 0 * c' 1 - c 1 * c' 0 ≠ 0 :=
by
  classical
  letI := (MvPolynomial.gradedAlgebra :
    GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))

  have hmk : ∀ μ : K, μ ≠ 0 → ∀ (a : Fin (N + 1))
      (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2),
      ∃ u, IsUnit u ∧
      HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a)) 2
        ((μ • G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2) :
          MvPolynomial (Fin (N + 1)) K) (μ • G).2 =
      u * HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a)) 2
        (G : MvPolynomial (Fin (N + 1)) K) G.2 := by
    intro μ hμ a G
    have key : ∀ (c : K) (y : HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)),
        c • y = (c • 1) * y := by
      intro c y
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_smul, HomogeneousLocalization.val_mul,
        HomogeneousLocalization.val_smul, HomogeneousLocalization.val_one, smul_one_mul]
    refine ⟨μ • 1, ?_, ?_⟩
    · refine ⟨⟨μ • 1, μ⁻¹ • 1, ?_, ?_⟩, rfl⟩
      · apply HomogeneousLocalization.val_injective
        simp [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_smul, smul_smul, hμ]
      · apply HomogeneousLocalization.val_injective
        simp [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_smul, smul_smul, hμ]
    · rw [← key]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_smul, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, Localization.smul_mk]
      rfl

  have hscale : ∀ μ : K, μ ≠ 0 → ∀ (H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2)
      (y : X.left) (a : Fin (N + 1)) (hy : y ∈ ι ⁻¹ᵁ wcSgD K N a),
      ∃ u, IsUnit u ∧ wcLdpGerm K N ι (μ • H) a y hy = u * wcLdpGerm K N ι H a y hy := by
    intro μ hμ H y a hy
    obtain ⟨w, hw, he⟩ := hmk μ hμ a H
    have hsec : ∃ u0, IsUnit u0 ∧ wcLdpSec K N (μ • H) a = u0 * wcLdpSec K N H a :=
      ⟨(Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X a)).hom w, hw.map _, by unfold wcLdpSec; rw [he, map_mul]⟩
    obtain ⟨u0, hu0, hs⟩ := hsec
    refine ⟨(X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N a) y hy).hom ((ι.app (wcSgD K N a)).hom u0),
      (hu0.map _).map _, ?_⟩
    unfold wcLdpGerm
    rw [hs, map_mul, map_mul]

  have hodp2 : ∀ (H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2) (y : X.left),
      wcLdpODPAt K N n ι H y → wcLdpSing2 K N ι H y := by
    intro H y h a hy
    obtain ⟨t, A, hm, h3, -⟩ := h a hy
    have ht : ∀ l, t l ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk y) := fun l => by
      rw [hm]; exact Ideal.subset_span ⟨l, rfl⟩
    have hs : ∑ k, ∑ l, A k l * t k * t l ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk y) ^ 2 :=
      Ideal.sum_mem _ fun k _ => Ideal.sum_mem _ fun l _ => by
        rw [mul_assoc]
        exact Ideal.mul_mem_left _ _ (by rw [pow_two]; exact Ideal.mul_mem_mul (ht k) (ht l))
    have h1 := Ideal.add_mem _ (Ideal.pow_le_pow_right (by norm_num : 2 ≤ 3) h3) hs
    rwa [sub_add_cancel] at h1

  have hpar : ∀ (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2) (μ : K)
      (d : Fin 2 → K), (μ * d 1) • G₀ - (μ * d 0) • G₁ = μ • (d 1 • G₀ - d 0 • G₁) := by
    intro G₀ G₁ μ d
    rw [mul_smul, mul_smul, smul_sub]
  have hlam : ∀ c c' : Fin 2 → K, c ≠ 0 → c' ≠ 0 → c 0 * c' 1 - c 1 * c' 0 = 0 →
      ∃ μ : K, μ ≠ 0 ∧ c' 0 = μ * c 0 ∧ c' 1 = μ * c 1 := by
    intro c c' hc hc' hdet
    by_cases h0 : c 0 = 0
    · have h1 : c 1 ≠ 0 := fun h1 => hc (funext fun i => by fin_cases i <;> simp [h0, h1])
      have h0' : c' 0 = 0 := by
        rw [h0, zero_mul, zero_sub, neg_eq_zero] at hdet
        exact (mul_eq_zero.mp hdet).resolve_left h1
      refine ⟨c' 1 / c 1, ?_, by rw [h0', h0, mul_zero], (div_mul_cancel₀ _ h1).symm⟩
      intro h
      have h1' : c' 1 = 0 := (div_eq_zero_iff.mp h).resolve_right h1
      exact hc' (funext fun i => by fin_cases i <;> simp [h0', h1'])
    · refine ⟨c' 0 / c 0, ?_, (div_mul_cancel₀ _ h0).symm, ?_⟩
      · intro h
        have h0' : c' 0 = 0 := (div_eq_zero_iff.mp h).resolve_right h0
        rw [h0', mul_zero, sub_zero] at hdet
        have h1' : c' 1 = 0 := (mul_eq_zero.mp hdet).resolve_left h0
        exact hc' (funext fun i => by fin_cases i <;> simp [h0', h1'])
      · rw [div_mul_eq_mul_div, eq_div_iff h0]
        linear_combination hdet
  have hbad : ∀ (v : Fin 2 × Fin (N + 1) × Fin (N + 1) → K) (x' : X.left) (c c' : Fin 2 → K),
      c ≠ 0 → c' ≠ 0 → c 0 * c' 1 - c 1 * c' 0 = 0 →
      wcLdpODPAt K N n ι (c' 1 • (wcLdpQuad K N fun p q => v (0, p, q)) -
        c' 0 • (wcLdpQuad K N fun p q => v (1, p, q))) x' →
      wcLdpSing2 K N ι (c 1 • (wcLdpQuad K N fun p q => v (0, p, q)) -
        c 0 • (wcLdpQuad K N fun p q => v (1, p, q))) x' := by
    intro v x' c c' hc hc' hdet hodx'
    obtain ⟨μ, hμ, h0', h1'⟩ := hlam c c' hc hc' hdet
    rw [h0', h1', hpar] at hodx'
    have hsc := hodp2 _ _ hodx'
    intro a hy
    obtain ⟨u, hu, hEq⟩ := hscale μ hμ _ x' a hy
    have h2 := hsc a hy
    rw [hEq] at h2
    obtain ⟨u', rfl⟩ := hu
    have h3 := Ideal.mul_mem_left _ (↑u'⁻¹ : X.left.presheaf.stalk x') h2
    rwa [← mul_assoc, Units.inv_mul, one_mul] at h3
  by_cases hL : wcLdpLin K N n ι
  ·
    refine ⟨1, one_ne_zero, ?_⟩
    intro v _ x x' hx hx' hne _ _ c c' hc hc' _ _ hodx hodx' hdet
    exact wc_ldp_linear_odp_contra K N n hn2 X ι hι hιX hL _ x x' hx hx' hne
      (hodp2 _ _ hodx) (hbad v x' c c' hc hc' hdet hodx') hodx
  ·
    obtain ⟨A₁, _, _, _, hA₁, φ₁, h₁⟩ :=
      wc_ldp_double_generic_count K N n hn2 X ι hι hιX
    obtain ⟨A₂, _, _, _, hA₂, φ₂, h₂⟩ :=
      wc_ldp_double_tangent_count K N n hn2 X ι hι hιX hL
    obtain ⟨Φ₁, hΦ₁, hφ₁⟩ := wc_ldp_alg_dependence K A₁ φ₁ hA₁
    obtain ⟨Φ₂, hΦ₂, hφ₂⟩ := wc_ldp_alg_dependence K A₂ φ₂ hA₂
    refine ⟨Φ₁ * Φ₂, mul_ne_zero hΦ₁ hΦ₂, ?_⟩
    intro v hv x x' hx hx' hne _ _ c c' hc hc' _ _ hodx hodx' hdet
    have hs1 := hodp2 _ _ hodx
    have hs2 := hbad v x' c c' hc hc' hdet hodx'
    apply hv
    rw [map_mul]
    by_cases hDT : wcLdpDT K N n ι x x'
    · obtain ⟨χ, hχ⟩ := h₂ v x x' hx hx' hne c hc hs1 hs2 hDT
      rw [← hχ Φ₂, hφ₂, map_zero, mul_zero]
    · obtain ⟨χ, hχ⟩ := h₁ v x x' hx hx' hne c hc hs1 hs2 hDT
      rw [← hχ Φ₁, hφ₁, map_zero, zero_mul]

theorem wc_ldp_cf_germ_linear (E : Type u) [Field E] (N : ℕ) {X : Scheme.{u}}
    (s : X ⟶ Spec (.of E)) (ι : X ⟶ wcProjK E N) (hιs : ι ≫ wcProjKStr E N = s)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) (c₀ c₁ : E)
    (a : Fin (N + 1)) (x : X) (hx : x ∈ ι ⁻¹ᵁ wcSgD E N a) :
    wcLdpGerm E N ι (c₁ • G₀ - c₀ • G₁) a x hx =
      wcLdpConst E s x c₁ * wcLdpGerm E N ι G₀ a x hx -
        wcLdpConst E s x c₀ * wcLdpGerm E N ι G₁ a x hx :=
by
  classical
  subst hιs
  have hcc : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (s' : B ⟶ Spec (.of E)) (y : A),
      wcLdpConst E (f ≫ s') y = (f.stalkMap y).hom.comp (wcLdpConst E s' (f y)) := by
    intro A B f s' y
    ext r
    simp only [wcLdpConst, RingHom.comp_apply, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
    exact (Scheme.Hom.germ_stalkMap_apply f ⊤ y trivial _).symm
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) :=
    MvPolynomial.gradedAlgebra
  have hXa : ∀ k : Fin (N + 1), (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) E) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 1 := fun k =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
  have hA : HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
        (hXa a) 2 ((c₁ • G₀ - c₀ • G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) :
          MvPolynomial (Fin (N + 1)) E) (c₁ • G₀ - c₀ • G₁).2 =
      HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
          (Submonoid.powers (MvPolynomial.X a))
          (algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 0) c₁) *
        HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
          (hXa a) 2 (G₀ : MvPolynomial (Fin (N + 1)) E) G₀.2 -
      HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
          (Submonoid.powers (MvPolynomial.X a))
          (algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 0) c₀) *
        HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
          (hXa a) 2 (G₁ : MvPolynomial (Fin (N + 1)) E) G₁.2 := by
    apply HomogeneousLocalization.val_injective
    have hZ : ∀ r : E, (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) (Submonoid.powers (MvPolynomial.X a))
        (algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 0) r)).val =
        algebraMap (MvPolynomial (Fin (N + 1)) E)
          (Localization (Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) E)))
          (MvPolynomial.C r) := by
      intro r
      rw [← Localization.mk_one_eq_algebraMap]
      have e : ((algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 0) r :
          ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 0)) :
            MvPolynomial (Fin (N + 1)) E) = MvPolynomial.C r := by
        rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
      rw [← e]
      rfl
    have hmk : ∀ (p : MvPolynomial (Fin (N + 1)) E)
        (t : Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) E)),
        Localization.mk p t = algebraMap (MvPolynomial (Fin (N + 1)) E)
          (Localization (Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) E))) p *
          Localization.mk 1 t := by
      intro p t
      rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, mul_one, one_mul]
    have hcoe : ((c₁ • G₀ - c₀ • G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) :
        MvPolynomial (Fin (N + 1)) E) =
        MvPolynomial.C c₁ * (G₀ : MvPolynomial (Fin (N + 1)) E) -
          MvPolynomial.C c₀ * (G₁ : MvPolynomial (Fin (N + 1)) E) := by
      rw [Submodule.coe_sub, Submodule.coe_smul, Submodule.coe_smul, MvPolynomial.smul_eq_C_mul,
        MvPolynomial.smul_eq_C_mul]
    rw [HomogeneousLocalization.val_sub, HomogeneousLocalization.val_mul,
      HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, hZ, hZ, hcoe,
      hmk (MvPolynomial.C c₁ * (G₀ : MvPolynomial (Fin (N + 1)) E) -
        MvPolynomial.C c₀ * (G₁ : MvPolynomial (Fin (N + 1)) E)),
      hmk (G₀ : MvPolynomial (Fin (N + 1)) E), hmk (G₁ : MvPolynomial (Fin (N + 1)) E),
      map_sub, map_mul, map_mul]
    ring
  have hιt : ∀ (U : (Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)).Opens) b,
      U.ι.appTop b = U.topIso.inv ((Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)).presheaf.map
        (homOfLE (le_top : U ≤ ⊤)).op b) := by
    intro U b
    rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
    erw [← CategoryTheory.comp_apply, ← Functor.map_comp]
    rfl
  have hconst : ∀ r : E, (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
      (MvPolynomial.X a)).hom
      (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
        (Submonoid.powers (MvPolynomial.X a))
        (algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 0) r)) =
      ((Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)).presheaf.map
        (homOfLE (le_top : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
          (MvPolynomial.X a)) ≤ ⊤)).op).hom
        ((Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) ≫
          Spec.map (CommRingCat.ofHom (algebraMap E
            ↥((MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) 0)))).appTop.hom
          ((Scheme.ΓSpecIso (.of E)).inv.hom r)) := by
    intro r
    have e0 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
        (MvPolynomial.X a)).ι =
        (Proj.basicOpenIsoSpec _ (MvPolynomial.X a) (hXa a) Nat.one_pos).hom ≫
          Proj.awayι _ (MvPolynomial.X a) (hXa a) Nat.one_pos := by
      rw [← Proj.basicOpenIsoSpec_inv_ι, Iso.hom_inv_id_assoc]
    have e1 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
        (MvPolynomial.X a)).ι ≫
        (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) ≫
          Spec.map (CommRingCat.ofHom (algebraMap E
            ↥((MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) 0)))) =
        (Proj.basicOpenIsoSpec _ (MvPolynomial.X a) (hXa a) Nat.one_pos).hom ≫
          Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
              (Submonoid.powers (MvPolynomial.X a))).comp
            (algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 0)))) := by
      rw [e0, Category.assoc, Proj.awayι_toSpecZero_assoc, ← Spec.map_comp]
      rfl
    have e2 := congrArg (fun g =>
      (Scheme.Hom.appTop g).hom ((Scheme.ΓSpecIso (.of E)).inv.hom r)) e1
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at e2
    have e3 := congrArg (fun g => g.hom r) (Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
          (Submonoid.powers (MvPolynomial.X a))).comp
        (algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 0)))))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e3
    rw [← e3] at e2
    have hi : ∀ y, (Proj.basicOpenIsoSpec _ (MvPolynomial.X a) (hXa a) Nat.one_pos).hom.appTop
        ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) (MvPolynomial.X a)))).inv y) =
        (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
          (MvPolynomial.X a)).topIso.inv
          ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
            (MvPolynomial.X a)).hom y) := by
      intro y
      rw [Proj.basicOpenIsoSpec_hom]
      have hh := Proj.basicOpenToSpec_app_top
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) (MvPolynomial.X a)
      calc _ = ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) (MvPolynomial.X a)))).hom ≫
            Proj.awayToSection _ (MvPolynomial.X a) ≫
            (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
              (MvPolynomial.X a)).topIso.inv)
            ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) (MvPolynomial.X a)))).inv y) := by
            rw [← hh]
        _ = _ := by
          change (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
              (MvPolynomial.X a)).topIso.inv
            ((Proj.awayToSection _ (MvPolynomial.X a))
              ((Scheme.ΓSpecIso _).hom ((Scheme.ΓSpecIso _).inv y))) = _
          rw [Iso.inv_hom_id_apply]
    have e4 := e2.trans (hi _)
    rw [hιt] at e4
    have hinj : ∀ b b' : Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E),
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) (MvPolynomial.X a)),
        (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
          (MvPolynomial.X a)).topIso.inv b =
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
            (MvPolynomial.X a)).topIso.inv b' → b = b' := by
      intro b b' h
      have h' := congrArg (fun w => (Proj.basicOpen (MvPolynomial.homogeneousSubmodule
        (Fin (N + 1)) E) (MvPolynomial.X a)).topIso.hom w) h
      simp only [Iso.inv_hom_id_apply] at h'
      exact h'
    exact (hinj _ _ e4).symm
  have hsec : wcLdpSec E N (c₁ • G₀ - c₀ • G₁) a =
      ((wcProjK E N).presheaf.map (homOfLE (le_top : wcSgD E N a ≤ ⊤)).op).hom
          ((wcProjKStr E N).appTop.hom ((Scheme.ΓSpecIso (.of E)).inv.hom c₁)) *
        wcLdpSec E N G₀ a -
      ((wcProjK E N).presheaf.map (homOfLE (le_top : wcSgD E N a ≤ ⊤)).op).hom
          ((wcProjKStr E N).appTop.hom ((Scheme.ΓSpecIso (.of E)).inv.hom c₀)) *
        wcLdpSec E N G₁ a := by
    show (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
        (MvPolynomial.X a)).hom
      (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
        (hXa a) 2 ((c₁ • G₀ - c₀ • G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) :
          MvPolynomial (Fin (N + 1)) E) (c₁ • G₀ - c₀ • G₁).2) = _
    rw [hA, map_sub, map_mul, map_mul, hconst, hconst]
    rfl
  have hk : ∀ r : E, (X.presheaf.germ (ι ⁻¹ᵁ wcSgD E N a) x hx).hom ((ι.app (wcSgD E N a)).hom
      (((wcProjK E N).presheaf.map (homOfLE (le_top : wcSgD E N a ≤ ⊤)).op).hom
        ((wcProjKStr E N).appTop.hom ((Scheme.ΓSpecIso (.of E)).inv.hom r)))) =
      wcLdpConst E (ι ≫ wcProjKStr E N) x r := by
    intro r
    have f1 := Scheme.Hom.germ_stalkMap_apply ι (wcSgD E N a) x hx
      (((wcProjK E N).presheaf.map (homOfLE (le_top : wcSgD E N a ≤ ⊤)).op).hom
        ((wcProjKStr E N).appTop.hom ((Scheme.ΓSpecIso (.of E)).inv.hom r)))
    have f2 := TopCat.Presheaf.germ_res_apply (wcProjK E N).presheaf
      (homOfLE (le_top : wcSgD E N a ≤ ⊤)) (ι x) hx
      ((wcProjKStr E N).appTop.hom ((Scheme.ΓSpecIso (.of E)).inv.hom r))
    rw [hcc]
    exact f1.symm.trans (congrArg (ι.stalkMap x).hom f2)
  show (X.presheaf.germ (ι ⁻¹ᵁ wcSgD E N a) x hx).hom
      ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (c₁ • G₀ - c₀ • G₁) a)) =
    wcLdpConst E (ι ≫ wcProjKStr E N) x c₁ * (X.presheaf.germ (ι ⁻¹ᵁ wcSgD E N a) x hx).hom
      ((ι.app (wcSgD E N a)).hom (wcLdpSec E N G₀ a)) -
    wcLdpConst E (ι ≫ wcProjKStr E N) x c₀ * (X.presheaf.germ (ι ⁻¹ᵁ wcSgD E N a) x hx).hom
      ((ι.app (wcSgD E N a)).hom (wcLdpSec E N G₁ a))
  rw [hsec]
  simp only [map_sub, map_mul]
  rw [hk, hk]

theorem wc_ldp_cf_odp_jacobian (K O : Type u) [Field K] [CommRing O] [IsLocalRing O]
    [instA : Algebra K O] (n : ℕ) [instF : Module.Free O Ω[O⁄K]]
    [instFin : Module.Finite O Ω[O⁄K]]
    (hrk : Module.finrank O Ω[O⁄K] = n)
    (hres : ∀ r : O, ∃ c : K, r - algebraMap K O c ∈ IsLocalRing.maximalIdeal O)
    (g₀ g₁ : O)
    (hoff : ¬ (g₀ ∈ IsLocalRing.maximalIdeal O ∧ g₁ ∈ IsLocalRing.maximalIdeal O))
    (c : Fin 2 → K) (hc : c ≠ 0) (t : Fin n → O) (A : Matrix (Fin n) (Fin n) O)
    (hm : IsLocalRing.maximalIdeal O = Ideal.span (Set.range t))
    (hq : algebraMap K O (c 1) * g₀ - algebraMap K O (c 0) * g₁ - ∑ k, ∑ l, A k l * t k * t l ∈
      IsLocalRing.maximalIdeal O ^ 3)
    (hA : IsUnit (A + A.transpose).det) :
    ∃ φ : Fin n → (Ω[O⁄K] →ₗ[O] O),
      IsLocalRing.maximalIdeal O = Ideal.span (Set.range fun j =>
        φ j (g₀ • KaehlerDifferential.D K O g₁ - g₁ • KaehlerDifferential.D K O g₀)) :=
by
  classical
  have ht : ∀ k, t k ∈ IsLocalRing.maximalIdeal O := fun k => by
    rw [hm]; exact Ideal.subset_span ⟨k, rfl⟩

  have s1 : ∃ φ : Fin n → (Ω[O⁄K] →ₗ[O] O),
      ∀ j l, φ j (KaehlerDifferential.D K O (t l)) = if j = l then 1 else 0 := by
    have ha : ∀ r : O, KaehlerDifferential.D K O r ∈
        Submodule.span O (Set.range fun l => KaehlerDifferential.D K O (t l)) ⊔
          IsLocalRing.maximalIdeal O • (⊤ : Submodule O Ω[O⁄K]) := by
      intro r
      obtain ⟨c', hc'⟩ := hres r
      rw [hm] at hc'
      obtain ⟨a, ha⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hc'
      have e1 : KaehlerDifferential.D K O r =
          KaehlerDifferential.D K O (r - algebraMap K O c') := by
        rw [map_sub, Derivation.map_algebraMap, sub_zero]
      rw [e1, ← ha, map_sum]
      refine Submodule.sum_mem _ (fun i _ => ?_)
      rw [Derivation.leibniz]
      refine Submodule.add_mem _ ?_ ?_
      · exact Submodule.mem_sup_left (Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩))
      · exact Submodule.mem_sup_right (Submodule.smul_mem_smul (ht i) Submodule.mem_top)
    have htop : (⊤ : Submodule O Ω[O⁄K]) ≤
        Submodule.span O (Set.range fun l => KaehlerDifferential.D K O (t l)) := by
      apply Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top
        (IsLocalRing.maximalIdeal_le_jacobson ⊥)
      intro x _
      have hx : x ∈ Submodule.span O (Set.range (KaehlerDifferential.D K O)) := by
        rw [KaehlerDifferential.span_range_derivation]; trivial
      exact (Submodule.span_le.mpr (by rintro _ ⟨r, rfl⟩; exact ha r)) hx
    let L : (Fin n → O) →ₗ[O] Ω[O⁄K] :=
      Fintype.linearCombination O (fun l => KaehlerDifferential.D K O (t l))
    have hLs : Function.Surjective L := by
      rw [← LinearMap.range_eq_top, Fintype.range_linearCombination]
      exact eq_top_iff.mpr htop
    let b := Module.finBasisOfFinrankEq O Ω[O⁄K] hrk
    have hLi : Function.Injective L := by
      have hf : Function.Surjective (b.equivFun.toLinearMap ∘ₗ L) :=
        b.equivFun.surjective.comp hLs
      have hfi := OrzechProperty.injective_of_surjective_endomorphism _ hf
      intro x y hxy
      apply hfi
      simp only [LinearMap.coe_comp, Function.comp_apply, hxy]
    let e := LinearEquiv.ofBijective L ⟨hLi, hLs⟩
    refine ⟨fun j => (LinearMap.proj j) ∘ₗ e.symm.toLinearMap, fun j l => ?_⟩
    have hel : e.symm (KaehlerDifferential.D K O (t l)) = Pi.single l 1 := by
      rw [LinearEquiv.symm_apply_eq]
      show _ = L (Pi.single l 1)
      simp only [L, Fintype.linearCombination_apply_single, one_smul]
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe, hel,
      LinearMap.coe_proj, Function.eval, Pi.single_apply]

  have s2 : ∀ (φ : Ω[O⁄K] →ₗ[O] O) (k : ℕ) (r : O), r ∈ IsLocalRing.maximalIdeal O ^ (k + 1) →
      φ (KaehlerDifferential.D K O r) ∈ IsLocalRing.maximalIdeal O ^ k := by
    have P : ∀ k : ℕ, ∀ r ∈ IsLocalRing.maximalIdeal O ^ (k + 1),
        KaehlerDifferential.D K O r ∈
          IsLocalRing.maximalIdeal O ^ k • (⊤ : Submodule O Ω[O⁄K]) := by
      intro k
      induction k with
      | zero => intro r _; simp
      | succ k ih =>
        intro r hr
        rw [pow_succ', ← Ideal.smul_eq_mul] at hr
        refine Submodule.smul_induction_on
          (p := fun r => KaehlerDifferential.D K O r ∈
            IsLocalRing.maximalIdeal O ^ (k + 1) • (⊤ : Submodule O Ω[O⁄K])) hr ?_ ?_
        · intro a ha b hb
          rw [smul_eq_mul, Derivation.leibniz]
          refine Submodule.add_mem _ ?_ ?_
          · rw [pow_succ', Submodule.mul_smul]
            exact Submodule.smul_mem_smul ha (ih b hb)
          · exact Submodule.smul_mem_smul hb Submodule.mem_top
        · intro x y hx hy
          rw [map_add]; exact Submodule.add_mem _ hx hy
    intro φ k r hr
    refine Submodule.smul_induction_on (p := fun x => φ x ∈ IsLocalRing.maximalIdeal O ^ k)
      (P k r hr) ?_ ?_
    · intro a ha x _
      rw [map_smul, smul_eq_mul]; exact Ideal.mul_mem_right _ _ ha
    · intro x y hx hy
      rw [map_add]; exact Ideal.add_mem _ hx hy
  obtain ⟨φ, hφ⟩ := s1

  have s3 : ∀ j, φ j (KaehlerDifferential.D K O (∑ k, ∑ l, A k l * t k * t l)) -
      ∑ k, (A + A.transpose) j k * t k ∈ IsLocalRing.maximalIdeal O ^ 2 := by
    intro j
    have hterm : ∀ k l, φ j (KaehlerDifferential.D K O (A k l * t k * t l)) =
        (if j = l then A k l * t k else 0) + (if j = k then A k l * t l else 0) +
          t l * t k * φ j (KaehlerDifferential.D K O (A k l)) := by
      intro k l
      rw [Derivation.leibniz, Derivation.leibniz]
      simp only [map_add, map_smul, smul_eq_mul, hφ]
      split_ifs <;> ring
    have key : φ j (KaehlerDifferential.D K O (∑ k, ∑ l, A k l * t k * t l)) -
        ∑ k, (A + A.transpose) j k * t k =
          ∑ k, ∑ l, t l * t k * φ j (KaehlerDifferential.D K O (A k l)) := by
      simp only [map_sum, hterm, Finset.sum_add_distrib, Finset.sum_ite_eq, Finset.mem_univ,
        ite_true, Finset.sum_ite_irrel, Finset.sum_const_zero, Matrix.add_apply,
        Matrix.transpose_apply, add_mul]
      ring
    rw [key]
    refine Ideal.sum_mem _ (fun k _ => Ideal.sum_mem _ (fun l _ => ?_))
    rw [pow_two]
    exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_mul (ht l) (ht k))

  set m := IsLocalRing.maximalIdeal O with hmdef
  set D := KaehlerDifferential.D K O with hDdef
  set h := algebraMap K O (c 1) * g₀ - algebraMap K O (c 0) * g₁ with hhdef
  set Q := ∑ k, ∑ l, A k l * t k * t l with hQdef
  set ω := g₀ • D g₁ - g₁ • D g₀ with hωdef
  have hQ2 : Q ∈ m ^ 2 := by
    refine Ideal.sum_mem _ (fun k _ => Ideal.sum_mem _ (fun l _ => ?_))
    rw [pow_two]
    exact Ideal.mul_mem_mul (Ideal.mul_mem_left _ _ (ht k)) (ht l)
  have hh2 : h ∈ m ^ 2 := by
    have h32 : m ^ 3 ≤ m ^ 2 := Ideal.pow_le_pow_right (by norm_num)
    have := Ideal.add_mem _ (h32 hq) hQ2
    rwa [sub_add_cancel] at this
  have hh1 : h ∈ m := Ideal.pow_le_self two_ne_zero hh2
  have hDh : D h = algebraMap K O (c 1) • D g₀ - algebraMap K O (c 0) • D g₁ := by
    rw [hhdef, map_sub, Derivation.leibniz, Derivation.leibniz, Derivation.map_algebraMap,
      Derivation.map_algebraMap, smul_zero, smul_zero, add_zero, add_zero]
  have hsel : ∃ (γ : K) (g : O), γ ≠ 0 ∧ IsUnit g ∧
      algebraMap K O γ • ω = h • D g - g • D h := by
    by_cases h0 : c 0 = 0
    · have h1 : c 1 ≠ 0 := by
        intro h1
        apply hc
        funext i
        fin_cases i
        · exact h0
        · exact h1
      refine ⟨c 1, g₁, h1, ?_, ?_⟩
      · rw [← IsLocalRing.notMem_maximalIdeal]
        intro hg1
        apply hoff
        refine ⟨?_, hg1⟩
        have hu : IsUnit (algebraMap K O (c 1)) := (Ne.isUnit h1).map (algebraMap K O)
        rw [← Ideal.unit_mul_mem_iff_mem _ hu]
        have e : algebraMap K O (c 1) * g₀ = h + algebraMap K O (c 0) * g₁ := by
          rw [hhdef]; ring
        rw [e]
        exact Ideal.add_mem _ hh1 (Ideal.mul_mem_left _ _ hg1)
      · rw [hDh, hωdef]
        module
    · refine ⟨c 0, g₀, h0, ?_, ?_⟩
      · rw [← IsLocalRing.notMem_maximalIdeal]
        intro hg0
        apply hoff
        refine ⟨hg0, ?_⟩
        have hu : IsUnit (algebraMap K O (c 0)) := (Ne.isUnit h0).map (algebraMap K O)
        rw [← Ideal.unit_mul_mem_iff_mem _ hu]
        have e : algebraMap K O (c 0) * g₁ = algebraMap K O (c 1) * g₀ - h := by
          rw [hhdef]; ring
        rw [e]
        exact Ideal.sub_mem _ (Ideal.mul_mem_left _ _ hg0) hh1
      · rw [hDh, hωdef]
        module
  obtain ⟨γ, g, hγ, hg, hid⟩ := hsel
  set γ' := algebraMap K O γ⁻¹ with hγ'def
  have hinv : γ' * algebraMap K O γ = 1 := by
    rw [hγ'def, ← map_mul, inv_mul_cancel₀ hγ, map_one]
  set e := -(γ' * g) with hedef
  have he : IsUnit e := by
    rw [hedef]
    exact ((((Ne.isUnit (inv_ne_zero hγ)).map (algebraMap K O))).mul hg).neg
  set B := A + A.transpose with hBdef
  set s : Fin n → O := fun j => ∑ k, B j k * t k with hsdef
  set w : Fin n → O := fun j => φ j ω with hwdef

  have hw : ∀ j, w j - e * s j ∈ m ^ 2 := by
    intro j
    have heq : algebraMap K O γ * w j = h * φ j (D g) - g * φ j (D h) := by
      have := congrArg (φ j) hid
      simp only [map_smul, map_sub, smul_eq_mul] at this
      exact this
    have hi : φ j (D h) - φ j (D Q) ∈ m ^ 2 := by
      rw [← map_sub, ← map_sub]
      exact s2 (φ j) 2 (h - Q) hq
    have hii : φ j (D Q) - s j ∈ m ^ 2 := s3 j
    have hiii : h * φ j (D g) ∈ m ^ 2 := Ideal.mul_mem_right _ _ hh2
    have e1 : w j - e * s j = γ' * (h * φ j (D g) -
        g * ((φ j (D h) - φ j (D Q)) + (φ j (D Q) - s j))) := by
      rw [hedef]
      linear_combination γ' * heq - w j * hinv
    rw [e1]
    exact Ideal.mul_mem_left _ _ (Ideal.sub_mem _ hiii
      (Ideal.mul_mem_left _ _ (Ideal.add_mem _ hi hii)))

  refine ⟨φ, ?_⟩
  change m = Ideal.span (Set.range w)
  have hs : ∀ j, s j ∈ m := fun j =>
    Ideal.sum_mem _ (fun k _ => Ideal.mul_mem_left _ _ (ht k))
  apply le_antisymm
  · obtain ⟨e', he'⟩ := he.exists_left_inv
    have hCB : B⁻¹ * B = 1 := Matrix.nonsing_inv_mul B hA
    have hts : ∀ i, t i = ∑ j, B⁻¹ i j * s j := by
      intro i
      have h1 : (B⁻¹ * B).mulVec t = t := by rw [hCB, Matrix.one_mulVec]
      rw [← Matrix.mulVec_mulVec] at h1
      exact (congrFun h1 i).symm
    have hti : ∀ i, t i ∈ Ideal.span (Set.range w) ⊔ m • m := by
      intro i
      have e2 : t i = ∑ j, B⁻¹ i j * (e' * w j) - ∑ j, B⁻¹ i j * (e' * (w j - e * s j)) := by
        rw [hts i, ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        linear_combination (-(B⁻¹ i j * s j)) * he'
      rw [e2]
      refine Submodule.sub_mem _ (Submodule.mem_sup_left ?_) (Submodule.mem_sup_right ?_)
      · exact Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_left _ _
          (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)))
      · rw [Ideal.smul_eq_mul, ← pow_two]
        exact Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ (hw j)))
    have hm' : IsLocalRing.maximalIdeal O = Ideal.span (Set.range t) := hm
    have hfg : (IsLocalRing.maximalIdeal O : Submodule O O).FG := by
      rw [hm']; exact Submodule.fg_span (Set.finite_range t)
    apply Submodule.le_of_le_smul_of_le_jacobson_bot hfg (IsLocalRing.maximalIdeal_le_jacobson ⊥)
    intro x hx
    rw [hm'] at hx
    exact (Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact hti i)) hx
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨j, rfl⟩
    have : w j = (w j - e * s j) + e * s j := by ring
    rw [this]
    exact Ideal.add_mem _ (Ideal.pow_le_self two_ne_zero (hw j)) (Ideal.mul_mem_left _ _ (hs j))

theorem wc_ldp_cf_spread (E : Type u) [Field E] (N : ℕ) {X : Scheme.{u}}
    (s : X ⟶ Spec (.of E)) [hs : LocallyOfFiniteType s] (ι : X ⟶ wcProjK E N)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) (a : Fin (N + 1)) (x : X)
    (hxc : IsClosed ({x} : Set X)) (hx : x ∈ ι ⁻¹ᵁ wcSgD E N a)
    [instA : Algebra E (X.presheaf.stalk x)]
    (hE : algebraMap E (X.presheaf.stalk x) = wcLdpConst E s x)
    (k : ℕ) (φ : Fin k → (Ω[X.presheaf.stalk x⁄E] →ₗ[X.presheaf.stalk x] X.presheaf.stalk x))
    (hφ : IsLocalRing.maximalIdeal (X.presheaf.stalk x) = Ideal.span (Set.range fun j => φ j
      (wcLdpGerm E N ι G₀ a x hx •
          KaehlerDifferential.D E (X.presheaf.stalk x) (wcLdpGerm E N ι G₁ a x hx) -
        wcLdpGerm E N ι G₁ a x hx •
          KaehlerDifferential.D E (X.presheaf.stalk x) (wcLdpGerm E N ι G₀ a x hx)))) :
    ∃ U : X.Opens, x ∈ U ∧ U ≤ ι ⁻¹ᵁ wcSgD E N a ∧
      ∀ (x' : X) (hx' : x' ∈ ι ⁻¹ᵁ wcSgD E N a), x' ∈ U → x' ≠ x →
        wcLdpSubmersive E s x' (wcLdpGerm E N ι G₀ a x' hx') (wcLdpGerm E N ι G₁ a x' hx') :=
by
  classical

  have s3 : ∀ (R O : Type u) [CommRing R] [CommRing O] [IsLocalRing O]
      [Algebra E R] [Algebra R O] [Algebra E O] [IsScalarTower E R O]
      (q : Ideal R) [q.IsPrime] [IsLocalization.AtPrime O q] (h : Ω[R⁄E] →ₗ[R] R) (ω : Ω[R⁄E]),
      h ω ∉ q → KaehlerDifferential.map E E R O ω ∉
        (IsLocalRing.maximalIdeal O) • (⊤ : Submodule O Ω[O⁄E]) := by
    intro R O _ _ _ _ _ _ _ q _ _ h ω hq
    haveI := KaehlerDifferential.isLocalizedModule_map E R O q.primeCompl
    let g : Ω[R⁄E] →ₗ[R] O := (Algebra.linearMap R O) ∘ₗ h
    have hu : ∀ x : q.primeCompl, IsUnit ((algebraMap R (Module.End R O)) x) :=
      IsLocalizedModule.map_units (Algebra.linearMap R O)
    let ψ := IsLocalizedModule.lift q.primeCompl (KaehlerDifferential.map E E R O) g hu
    let ψ' : Ω[O⁄E] →ₗ[O] O := LinearMap.extendScalarsOfIsLocalization q.primeCompl O ψ
    have key : ψ' (KaehlerDifferential.map E E R O ω) = algebraMap R O (h ω) := by
      show ψ (KaehlerDifferential.map E E R O ω) = _
      exact IsLocalizedModule.lift_apply _ _ _ _ _
    intro hmem
    have hm : ψ' (KaehlerDifferential.map E E R O ω) ∈ IsLocalRing.maximalIdeal O := by
      refine Submodule.smul_induction_on hmem ?_ ?_
      · intro r hr n _
        rw [map_smul, smul_eq_mul]
        exact Ideal.mul_mem_right _ _ hr
      · intro x y hx hy
        rw [map_add]
        exact Ideal.add_mem _ hx hy
    rw [key] at hm
    exact hq ((IsLocalization.AtPrime.to_map_mem_maximal_iff O q _).mp hm)

  have s2 : ∀ (R O : Type u) [CommRing R] [CommRing O] [IsLocalRing O]
      [Algebra E R] [Algebra.FiniteType E R] [Algebra R O] [Algebra E O] [IsScalarTower E R O]
      (p : Ideal R) [p.IsPrime] [IsLocalization.AtPrime O p] (ω : Ω[R⁄E])
      (φ : Fin k → (Ω[O⁄E] →ₗ[O] O)),
      IsLocalRing.maximalIdeal O =
        Ideal.span (Set.range fun j => φ j (KaehlerDifferential.map E E R O ω)) →
      ∃ (f : R) (h : Fin k → (Ω[R⁄E] →ₗ[R] R)), f ∉ p ∧
        ∀ π ∈ p, f * π ∈ Ideal.span (Set.range fun j => h j ω) := by
    intro R O _ _ _ _ _ _ _ _ p _ _ ω φ hφ
    haveI : IsNoetherianRing R := Algebra.FiniteType.isNoetherianRing E R
    haveI : Module.FinitePresentation R Ω[R⁄E] := Module.finitePresentation_of_finite R _
    have hlift : ∀ j, ∃ (h : Ω[R⁄E] →ₗ[R] R) (s : p.primeCompl),
        Algebra.linearMap R O ∘ₗ h =
          s • ((φ j).restrictScalars R ∘ₗ KaehlerDifferential.map E E R O) :=
      fun j => Module.FinitePresentation.exists_lift_of_isLocalizedModule p.primeCompl
        (Algebra.linearMap R O) _
    choose h s hs using hlift
    have hstar : ∀ j, algebraMap R O (h j ω) =
        algebraMap R O (s j) * φ j (KaehlerDifferential.map E E R O ω) := by
      intro j
      have := congrArg (fun L => L ω) (hs j)
      simp only [LinearMap.comp_apply, LinearMap.smul_apply, Algebra.linearMap_apply,
        LinearMap.restrictScalars_apply] at this
      rw [this, Submonoid.smul_def, Algebra.smul_def]
    have hmJ : IsLocalRing.maximalIdeal O ≤
        (Ideal.span (Set.range fun j => h j ω)).map (algebraMap R O) := by
      rw [hφ, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      obtain ⟨u, hu⟩ := (IsLocalization.AtPrime.isUnit_to_map_iff O p (s j : R)).mpr (s j).2
      have e : φ j (KaehlerDifferential.map E E R O ω) =
          (↑u⁻¹ : O) * algebraMap R O (h j ω) := by
        rw [hstar j, ← hu, ← mul_assoc, Units.inv_mul, one_mul]
      show φ j (KaehlerDifferential.map E E R O ω) ∈ _
      rw [e]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨j, rfl⟩))
    have hpt : ∀ π ∈ p, ∃ t ∈ p.primeCompl, t * π ∈ Ideal.span (Set.range fun j => h j ω) := by
      intro π hπ
      have h1 : algebraMap R O π ∈ IsLocalRing.maximalIdeal O :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff O p π).mpr hπ
      obtain ⟨⟨a, m⟩, hm⟩ := (IsLocalization.mem_map_algebraMap_iff p.primeCompl O).mp (hmJ h1)
      simp only at hm
      rw [← map_mul] at hm
      obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists p.primeCompl O).mp hm
      refine ⟨(c : R) * (m : R), p.primeCompl.mul_mem c.2 m.2, ?_⟩
      have e : (c : R) * (m : R) * π = (c : R) * (a : R) := by rw [← hc]; ring
      rw [e]
      exact Ideal.mul_mem_left _ _ a.2
    obtain ⟨S, hS⟩ := (IsNoetherian.noetherian p : p.FG)
    have hSp : ∀ π ∈ S, π ∈ p := fun π hπ => hS ▸ Submodule.subset_span hπ
    choose! t ht htJ using fun π (hπ : π ∈ S) => hpt π (hSp π hπ)
    refine ⟨∏ π ∈ S, t π, h, ?_, ?_⟩
    · exact Submonoid.prod_mem p.primeCompl fun π hπ => ht π hπ
    · intro π hπ
      rw [← hS] at hπ
      induction hπ using Submodule.span_induction with
      | mem x hx =>
        rw [← Finset.mul_prod_erase S t hx]
        have e : t x * (∏ y ∈ S.erase x, t y) * x = (∏ y ∈ S.erase x, t y) * (t x * x) := by
          ring
        rw [e]
        exact Ideal.mul_mem_left _ _ (htJ x hx)
      | zero => rw [mul_zero]; exact Ideal.zero_mem _
      | add x y _ _ hx hy => rw [mul_add]; exact Ideal.add_mem _ hx hy
      | smul r x _ hx =>
        rw [smul_eq_mul, mul_left_comm]
        exact Ideal.mul_mem_left _ _ hx

  have s5 : ∀ (R O : Type u) [CommRing R] [CommRing O]
      [Algebra E R] [Algebra R O] [Algebra E O] [IsScalarTower E R O] (r₀ r₁ : R),
      KaehlerDifferential.map E E R O
          (r₀ • KaehlerDifferential.D E R r₁ - r₁ • KaehlerDifferential.D E R r₀) =
        algebraMap R O r₀ • KaehlerDifferential.D E O (algebraMap R O r₁) -
          algebraMap R O r₁ • KaehlerDifferential.D E O (algebraMap R O r₀) := by
    intro R O _ _ _ _ _ _ r₀ r₁
    rw [map_sub, LinearMap.map_smul, LinearMap.map_smul, KaehlerDifferential.map_D,
      KaehlerDifferential.map_D, algebraMap_smul, algebraMap_smul]

  obtain ⟨V, hVaff, hxV, hVW⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens X)) hx
  have hV : IsAffineOpen V := hVaff
  obtain ⟨ρ, hρft, hρ⟩ : ∃ ρ : E →+* Γ(X, V), ρ.FiniteType ∧
      ∀ (y : X) (hy : y ∈ V), (X.presheaf.germ V y hy).hom.comp ρ = wcLdpConst E s y := by
    refine ⟨(s.appLE ⊤ V le_top).hom.comp (Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom, ?_, ?_⟩
    · refine RingHom.FiniteType.comp
        (HasRingHomProperty.appLE @LocallyOfFiniteType s hs ⟨⊤, isAffineOpen_top _⟩ ⟨V, hV⟩
          le_top) ?_
      apply RingHom.FiniteType.of_surjective
      intro y
      exact ⟨(Scheme.ΓSpecIso (CommRingCat.of E)).hom.hom y, by simp⟩
    · intro y hy
      ext c
      simp only [wcLdpConst, Scheme.Hom.appLE, CommRingCat.hom_comp, RingHom.comp_apply]
      exact TopCat.Presheaf.germ_res_apply _ _ _ _ _
  letI : Algebra E Γ(X, V) := ρ.toAlgebra
  haveI : Algebra.FiniteType E Γ(X, V) := RingHom.finiteType_algebraMap.mp hρft
  have hloc : ∀ (y : X) (hy : y ∈ V), letI := (X.presheaf.germ V y hy).hom.toAlgebra
      IsLocalization.AtPrime (X.presheaf.stalk y)
        (Ideal.comap (X.presheaf.germ V y hy).hom (IsLocalRing.maximalIdeal (X.presheaf.stalk y))) := by
    intro y hy
    have h := hV.isLocalization_stalk ⟨y, hy⟩
    rw [hV.primeIdealOf_eq_map_closedPoint] at h
    exact h

  have s4 : ∀ (y : X) (hy : y ∈ V),
      Ideal.comap (X.presheaf.germ V x hxV).hom (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) ≤
        Ideal.comap (X.presheaf.germ V y hy).hom (IsLocalRing.maximalIdeal (X.presheaf.stalk y)) →
      y = x := by
    intro y hy hle
    have hprime : ∀ (z : X) (hz : z ∈ V), (hV.primeIdealOf ⟨z, hz⟩).asIdeal =
        Ideal.comap (X.presheaf.germ V z hz).hom (IsLocalRing.maximalIdeal (X.presheaf.stalk z)) := by
      intro z hz
      rw [hV.primeIdealOf_eq_map_closedPoint]
      rfl
    have hle' : hV.primeIdealOf ⟨x, hxV⟩ ≤ hV.primeIdealOf ⟨y, hy⟩ := by
      rw [← PrimeSpectrum.asIdeal_le_asIdeal, hprime, hprime]
      exact hle
    have hcl := (PrimeSpectrum.le_iff_mem_closure _ _).mp hle'
    have h2 : hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) ∈ closure ({x} : Set X) :=
      map_mem_closure hV.fromSpec.continuous hcl (by
        intro z hz
        rw [Set.mem_singleton_iff] at hz ⊢
        rw [hz]
        exact hV.fromSpec_primeIdealOf ⟨x, hxV⟩)
    rw [hxc.closure_eq, Set.mem_singleton_iff] at h2
    exact (hV.fromSpec_primeIdealOf ⟨y, hy⟩).symm.trans h2

  obtain ⟨σ, hσdef⟩ : ∃ σ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2 → Γ(X, V),
      ∀ G, σ G = (X.presheaf.map (homOfLE hVW).op).hom
        ((ι.app (wcSgD E N a)).hom (wcLdpSec E N G a)) := ⟨_, fun _ => rfl⟩
  have hσ : ∀ G (y : X) (hy : y ∈ V) (hy' : y ∈ ι ⁻¹ᵁ wcSgD E N a),
      (X.presheaf.germ V y hy).hom (σ G) = wcLdpGerm E N ι G a y hy' := by
    intro G y hy hy'
    rw [hσdef]
    exact TopCat.Presheaf.germ_res_apply _ _ _ _ _
  obtain ⟨ωR, hωR⟩ : ∃ ω : Ω[Γ(X, V)⁄E], ω = σ G₀ • KaehlerDifferential.D E Γ(X, V) (σ G₁) -
      σ G₁ • KaehlerDifferential.D E Γ(X, V) (σ G₀) := ⟨_, rfl⟩

  letI : Algebra Γ(X, V) (X.presheaf.stalk x) := (X.presheaf.germ V x hxV).hom.toAlgebra
  haveI : IsLocalization.AtPrime (X.presheaf.stalk x)
      (Ideal.comap (X.presheaf.germ V x hxV).hom (IsLocalRing.maximalIdeal (X.presheaf.stalk x))) :=
    hloc x hxV
  haveI : IsScalarTower E Γ(X, V) (X.presheaf.stalk x) :=
    IsScalarTower.of_algebraMap_eq' (hE.trans (hρ x hxV).symm)
  have hωx : KaehlerDifferential.map E E Γ(X, V) (X.presheaf.stalk x) ωR =
      wcLdpGerm E N ι G₀ a x hx •
          KaehlerDifferential.D E (X.presheaf.stalk x) (wcLdpGerm E N ι G₁ a x hx) -
        wcLdpGerm E N ι G₁ a x hx •
          KaehlerDifferential.D E (X.presheaf.stalk x) (wcLdpGerm E N ι G₀ a x hx) := by
    have e0 : algebraMap Γ(X, V) (X.presheaf.stalk x) (σ G₀) = wcLdpGerm E N ι G₀ a x hx :=
      hσ G₀ x hxV hx
    have e1 : algebraMap Γ(X, V) (X.presheaf.stalk x) (σ G₁) = wcLdpGerm E N ι G₁ a x hx :=
      hσ G₁ x hxV hx
    rw [hωR, s5, e0, e1]
  obtain ⟨f, h, hfp, hfJ⟩ := s2 Γ(X, V) (X.presheaf.stalk x)
    (Ideal.comap (X.presheaf.germ V x hxV).hom (IsLocalRing.maximalIdeal (X.presheaf.stalk x)))
    ωR φ (by rw [hωx]; exact hφ)

  have hmemU : ∀ (y : X) (hy : y ∈ V), y ∈ X.basicOpen f ↔
      f ∉ Ideal.comap (X.presheaf.germ V y hy).hom (IsLocalRing.maximalIdeal (X.presheaf.stalk y)) := by
    intro y hy
    rw [Scheme.mem_basicOpen X f y hy]
    exact IsLocalRing.notMem_maximalIdeal.symm
  refine ⟨X.basicOpen f, (hmemU x hxV).mpr hfp, (X.basicOpen_le f).trans hVW, ?_⟩
  intro x' hx' hx'U hne
  have hx'V : x' ∈ V := X.basicOpen_le f hx'U
  have hfq := (hmemU x' hx'V).mp hx'U
  have hnle : ¬ (Ideal.comap (X.presheaf.germ V x hxV).hom
        (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) ≤
      Ideal.comap (X.presheaf.germ V x' hx'V).hom
        (IsLocalRing.maximalIdeal (X.presheaf.stalk x'))) := fun hle => hne (s4 x' hx'V hle)
  obtain ⟨π, hπ, hπ'⟩ := SetLike.not_le_iff_exists.mp hnle
  have hfπ := hfJ π hπ
  have hfπ' : f * π ∉ Ideal.comap (X.presheaf.germ V x' hx'V).hom
      (IsLocalRing.maximalIdeal (X.presheaf.stalk x')) := fun hm =>
    (Ideal.IsPrime.mem_or_mem inferInstance hm).elim hfq hπ'
  obtain ⟨j, hj⟩ : ∃ j, h j ωR ∉ Ideal.comap (X.presheaf.germ V x' hx'V).hom
      (IsLocalRing.maximalIdeal (X.presheaf.stalk x')) := by
    by_contra hcon
    push_neg at hcon
    apply hfπ'
    exact (Ideal.span_le.mpr (by rintro _ ⟨j, rfl⟩; exact hcon j)) hfπ

  letI : Algebra E (X.presheaf.stalk x') := (wcLdpConst E s x').toAlgebra
  letI : Algebra Γ(X, V) (X.presheaf.stalk x') := (X.presheaf.germ V x' hx'V).hom.toAlgebra
  haveI : IsLocalization.AtPrime (X.presheaf.stalk x')
      (Ideal.comap (X.presheaf.germ V x' hx'V).hom
        (IsLocalRing.maximalIdeal (X.presheaf.stalk x'))) := hloc x' hx'V
  haveI : IsScalarTower E Γ(X, V) (X.presheaf.stalk x') :=
    IsScalarTower.of_algebraMap_eq' (hρ x' hx'V).symm
  have hns := s3 Γ(X, V) (X.presheaf.stalk x')
    (Ideal.comap (X.presheaf.germ V x' hx'V).hom (IsLocalRing.maximalIdeal (X.presheaf.stalk x')))
    (h j) ωR hj
  have e0 : algebraMap Γ(X, V) (X.presheaf.stalk x') (σ G₀) = wcLdpGerm E N ι G₀ a x' hx' :=
    hσ G₀ x' hx'V hx'
  have e1 : algebraMap Γ(X, V) (X.presheaf.stalk x') (σ G₁) = wcLdpGerm E N ι G₁ a x' hx' :=
    hσ G₁ x' hx'V hx'
  rw [hωR, s5, e0, e1] at hns
  unfold wcLdpSubmersive
  exact hns

theorem wc_ldp_crit_finite (K : Type u) [Field K] [IsAlgClosed K] (N n : ℕ)
    (X : Over (Spec (.of K))) [IsProper X.hom] [SmoothOfRelativeDimension n X.hom]
    (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr K N = X.hom)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2)
    (hreg : ∀ x : X.left, IsClosed ({x} : Set X.left) → wcLdpAxisReg K N ι G₀ G₁ x)
    (hodp : ∀ x : X.left, IsClosed ({x} : Set X.left) → wcLdpCrit K N X.hom ι G₀ G₁ x →
      ∀ c : Fin 2 → K, c ≠ 0 → wcLdpZero K N ι (c 1 • G₀ - c 0 • G₁) x →
        wcLdpODPAt K N n ι (c 1 • G₀ - c 0 • G₁) x) :
    ∃ (m : ℕ) (y : Fin m → (Spec (.of K) ⟶ X.left)) (c : Fin m → Fin 2 → K),
      Function.Injective (fun i => y i (IsLocalRing.closedPoint K)) ∧
      (∀ i, y i ≫ X.hom = 𝟙 _) ∧
      (∀ i, IsClosed ({y i (IsLocalRing.closedPoint K)} : Set X.left)) ∧
      (∀ i, wcLdpCrit K N X.hom ι G₀ G₁ (y i (IsLocalRing.closedPoint K))) ∧
      (∀ i, c i ≠ 0 ∧
        wcLdpZero K N ι (c i 1 • G₀ - c i 0 • G₁) (y i (IsLocalRing.closedPoint K))) ∧
      ∀ x : X.left, IsClosed ({x} : Set X.left) → wcLdpCrit K N X.hom ι G₀ G₁ x →
        ∃ i, x = y i (IsLocalRing.closedPoint K) :=
by
  classical

  have hLFT : @LocallyOfFiniteType X.left (Spec (.of K)) X.hom := inferInstance
  have hQC : @QuasiCompact X.left (Spec (.of K)) X.hom := inferInstance

  haveI : IsLocallyNoetherian X.left :=
    LocallyOfFiniteType.isLocallyNoetherian (Y := Spec (.of K)) X.hom
  haveI : CompactSpace X.left :=
    QuasiCompact.compactSpace_of_compactSpace (Y := Spec (.of K)) X.hom
  haveI : AlgebraicGeometry.IsNoetherian X.left := AlgebraicGeometry.IsNoetherian.mk

  have gen : ∀ (O : Type u) [CommRing O] [Algebra K O] (P : Submodule O Ω[O⁄K]) (u h₀ h₁ : O),
      IsUnit u →
      ((u * h₀) • KaehlerDifferential.D K O (u * h₁) -
          (u * h₁) • KaehlerDifferential.D K O (u * h₀) ∉ P ↔
        h₀ • KaehlerDifferential.D K O h₁ - h₁ • KaehlerDifferential.D K O h₀ ∉ P) := by
    intro O _ _ P u h₀ h₁ hu
    have key : (u * h₀) • KaehlerDifferential.D K O (u * h₁) -
        (u * h₁) • KaehlerDifferential.D K O (u * h₀) =
        (u * u) • (h₀ • KaehlerDifferential.D K O h₁ - h₁ • KaehlerDifferential.D K O h₀) := by
      rw [Derivation.leibniz, Derivation.leibniz]
      module
    rw [key]
    obtain ⟨v, hv⟩ := hu.mul hu
    constructor
    · intro hA hB
      exact hA (Submodule.smul_mem _ _ hB)
    · intro hB hA
      apply hB
      have h2 := Submodule.smul_mem _ (↑v⁻¹ : O) hA
      rwa [← hv, smul_smul, Units.inv_mul, one_smul] at h2
  have hsub_unit : ∀ (x : X.left) (g₀ g₁ h₀ h₁ u : X.left.presheaf.stalk x), IsUnit u →
      g₀ = u * h₀ → g₁ = u * h₁ →
      (wcLdpSubmersive K X.hom x g₀ g₁ ↔ wcLdpSubmersive K X.hom x h₀ h₁) := by
    intro x g₀ g₁ h₀ h₁ u hu e₀ e₁
    subst e₀ e₁
    unfold wcLdpSubmersive
    letI := (wcLdpConst K X.hom x).toAlgebra
    exact gen _ _ u h₀ h₁ hu

  have hpt : ∀ x : X.left, IsClosed ({x} : Set X.left) → wcLdpCrit K N X.hom ι G₀ G₁ x →
      ∃ (y : Spec (.of K) ⟶ X.left) (c : Fin 2 → K) (U : X.left.Opens),
        y ≫ X.hom = 𝟙 _ ∧ y (IsLocalRing.closedPoint K) = x ∧ c ≠ 0 ∧
        wcLdpZero K N ι (c 1 • G₀ - c 0 • G₁) x ∧ x ∈ U ∧
        ∀ x' : X.left, x' ∈ U → IsClosed ({x'} : Set X.left) →
          wcLdpCrit K N X.hom ι G₀ G₁ x' → x' = x := by
    intro x hxc hcrit
    obtain ⟨hoffAx, a, hxa, hns⟩ := hcrit
    have h1 : ∃ (a₀ : Fin (N + 1)) (hxa₀ : x ∈ ι ⁻¹ᵁ wcSgD K N a₀),
        ¬ (wcLdpGerm K N ι G₀ a₀ x hxa₀ ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ∧
          wcLdpGerm K N ι G₁ a₀ x hxa₀ ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x)) := by
      by_contra hcon
      apply hoffAx
      intro a₀ hxa₀
      by_contra h
      exact hcon ⟨a₀, hxa₀, h⟩
    obtain ⟨a₀, hxa₀, hoff₀⟩ := h1

    have hoff : ¬ (wcLdpGerm K N ι G₀ a x hxa ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ∧
        wcLdpGerm K N ι G₁ a x hxa ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x)) := by
      obtain ⟨u, -, hu⟩ := wc_ldp_cf_uniform_transition K N ι a₀ a x hxa₀ hxa
      rintro ⟨h0, h1⟩
      apply hoff₀
      rw [hu G₀, hu G₁]
      exact ⟨Ideal.mul_mem_left _ _ h0, Ideal.mul_mem_left _ _ h1⟩

    obtain ⟨⟨y, hy, hyx⟩, hres⟩ := wc_ldp_cf_rational_point K X.hom x hxc (hs := hLFT)
    obtain ⟨c₀, hc₀⟩ := hres (wcLdpGerm K N ι G₀ a x hxa)
    obtain ⟨c₁, hc₁⟩ := hres (wcLdpGerm K N ι G₁ a x hxa)
    obtain ⟨c, hc0, hc1⟩ : ∃ c : Fin 2 → K, c 0 = c₀ ∧ c 1 = c₁ := ⟨![c₀, c₁], rfl, rfl⟩
    have hcne : c ≠ 0 := by
      intro hc
      have e0 : c₀ = 0 := by
        have h := congrFun hc 0
        rw [hc0] at h
        exact h
      have e1 : c₁ = 0 := by
        have h := congrFun hc 1
        rw [hc1] at h
        exact h
      apply hoff
      rw [e0, map_zero, sub_zero] at hc₀
      rw [e1, map_zero, sub_zero] at hc₁
      exact ⟨hc₀, hc₁⟩
    have hlin := wc_ldp_cf_germ_linear K N X.hom ι hιX G₀ G₁ (c 0) (c 1) a x hxa
    have hza : wcLdpGerm K N ι (c 1 • G₀ - c 0 • G₁) a x hxa ∈
        IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) := by
      rw [hlin, hc0, hc1]
      have e : wcLdpConst K X.hom x c₁ * wcLdpGerm K N ι G₀ a x hxa -
            wcLdpConst K X.hom x c₀ * wcLdpGerm K N ι G₁ a x hxa =
          wcLdpConst K X.hom x c₁ * (wcLdpGerm K N ι G₀ a x hxa - wcLdpConst K X.hom x c₀) -
            wcLdpConst K X.hom x c₀ * (wcLdpGerm K N ι G₁ a x hxa - wcLdpConst K X.hom x c₁) := by
        ring
      rw [e]
      exact Ideal.sub_mem _ (Ideal.mul_mem_left _ _ hc₀) (Ideal.mul_mem_left _ _ hc₁)
    have hzero : wcLdpZero K N ι (c 1 • G₀ - c 0 • G₁) x := by
      intro b hxb
      obtain ⟨v, -, hv⟩ := wc_ldp_cf_uniform_transition K N ι b a x hxb hxa
      rw [hv]
      exact Ideal.mul_mem_left _ _ hza

    obtain ⟨t, A, hmt, hq, hA⟩ := hodp x hxc ⟨hoffAx, a, hxa, hns⟩ c hcne hzero a hxa
    rw [hlin] at hq
    obtain ⟨-, hfree, hfin, hrk, -⟩ := wc_ldp_il_stalk_of_smooth_field K X.hom n x

    obtain ⟨φ, hφ⟩ := wc_ldp_cf_odp_jacobian K (X.left.presheaf.stalk x)
      (instA := (wcLdpConst K X.hom x).toAlgebra) n (instF := hfree) (instFin := hfin) hrk hres
      (wcLdpGerm K N ι G₀ a x hxa) (wcLdpGerm K N ι G₁ a x hxa) hoff c hcne t A hmt hq hA

    obtain ⟨U, hxU, hUa, hU⟩ :=
      wc_ldp_cf_spread K N X.hom ι G₀ G₁ a x hxc hxa (hs := hLFT)
        (instA := (wcLdpConst K X.hom x).toAlgebra) rfl n φ hφ
    refine ⟨y, c, U, hy, hyx, hcne, hzero, hxU, ?_⟩
    intro x' hx'U _ hcrit'
    by_contra hne
    obtain ⟨-, b, hx'b, hns'⟩ := hcrit'
    have hx'a : x' ∈ ι ⁻¹ᵁ wcSgD K N a := hUa hx'U
    obtain ⟨v, hv, hvH⟩ := wc_ldp_cf_uniform_transition K N ι b a x' hx'b hx'a
    exact hns' ((hsub_unit x' _ _ _ _ v hv (hvH G₀) (hvH G₁)).mpr (hU x' hx'a hx'U hne))

  choose yf cf Uf hyf hyfx hcf hzf hxUf hisol using hpt
  let C : Set X.left := {x | IsClosed ({x} : Set X.left) ∧ wcLdpCrit K N X.hom ι G₀ G₁ x}
  have memC : ∀ x, x ∈ C ↔ IsClosed ({x} : Set X.left) ∧ wcLdpCrit K N X.hom ι G₀ G₁ x :=
    fun x => Iff.rfl
  have hfinC : C.Finite := by
    obtain ⟨t, ht⟩ := (TopologicalSpace.NoetherianSpace.isCompact C).elim_finite_subcover
      (fun p : C => (Uf p.1 ((memC p.1).mp p.2).1 ((memC p.1).mp p.2).2 : Set X.left))
      (fun p => (Uf p.1 ((memC p.1).mp p.2).1 ((memC p.1).mp p.2).2).isOpen)
      (fun x hx => Set.mem_iUnion.mpr ⟨⟨x, hx⟩, hxUf x ((memC x).mp hx).1 ((memC x).mp hx).2⟩)
    apply (t.finite_toSet.image (fun p : C => p.1)).subset
    intro x hx
    obtain ⟨p, hp, hxp⟩ := Set.mem_iUnion₂.mp (ht hx)
    exact ⟨p, hp, (hisol p.1 _ _ x hxp ((memC x).mp hx).1 ((memC x).mp hx).2).symm⟩
  haveI : Finite C := hfinC.to_subtype
  let e : Fin (Nat.card C) ≃ C := (Finite.equivFin C).symm
  refine ⟨Nat.card C,
    fun i => yf (e i).1 ((memC _).mp (e i).2).1 ((memC _).mp (e i).2).2,
    fun i => cf (e i).1 ((memC _).mp (e i).2).1 ((memC _).mp (e i).2).2, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro i j hij
    dsimp only at hij
    rw [hyfx, hyfx] at hij
    exact e.injective (Subtype.ext hij)
  · intro i
    exact hyf _ _ _
  · intro i
    dsimp only
    rw [hyfx]
    exact ((memC _).mp (e i).2).1
  · intro i
    dsimp only
    rw [hyfx]
    exact ((memC _).mp (e i).2).2
  · intro i
    dsimp only
    refine ⟨hcf _ _ _, ?_⟩
    rw [hyfx]
    exact hzf _ _ _
  · intro x hxc hcr
    refine ⟨e.symm ⟨x, (memC x).mpr ⟨hxc, hcr⟩⟩, ?_⟩
    dsimp only
    rw [hyfx, Equiv.apply_symm_apply]

theorem wc_ldp_nc_stalkSpecializes_isLocalization : ∀ (X : Scheme.{u}) (x z : X) (h : x ⤳ z),
    letI := (X.presheaf.stalkSpecializes h).hom.toAlgebra
    IsLocalization.AtPrime (X.presheaf.stalk x)
      ((IsLocalRing.maximalIdeal (X.presheaf.stalk x)).comap (X.presheaf.stalkSpecializes h).hom) :=
by
  intro X x z h
  have key : ∀ (A R S : Type u) [CommRing A] [CommRing R] [CommRing S] [IsLocalRing S]
      (gR : A →+* R) (gS : A →+* S) (φ : R →+* S), φ.comp gR = gS →
      ∀ (P Q : Ideal A) [P.IsPrime] [Q.IsPrime],
      @IsLocalization.AtPrime A _ R _ gR.toAlgebra P _ →
      @IsLocalization.AtPrime A _ S _ gS.toAlgebra Q _ →
      letI := φ.toAlgebra; IsLocalization.AtPrime S ((IsLocalRing.maximalIdeal S).comap φ) := by
    intro A R S _ _ _ _ gR gS φ hcomp P Q _ _ hR hS
    letI : Algebra A R := gR.toAlgebra
    letI : Algebra A S := gS.toAlgebra
    letI : Algebra R S := φ.toAlgebra
    have hc : ∀ a, φ (gR a) = gS a := fun a => by rw [← hcomp]; rfl
    haveI : IsScalarTower A R S := IsScalarTower.of_algebraMap_eq (fun a => (hc a).symm)
    have hle : P.primeCompl ≤ Q.primeCompl := by
      intro a ha haQ
      have hu : IsUnit (gR a) := IsLocalization.map_units R (⟨a, ha⟩ : P.primeCompl)
      have hu' : IsUnit (gS a) := hc a ▸ hu.map φ
      have hm : gS a ∈ IsLocalRing.maximalIdeal S := by
        rw [← IsLocalization.AtPrime.map_eq_maximalIdeal Q S]
        exact Ideal.mem_map_of_mem _ haQ
      exact (IsLocalRing.notMem_maximalIdeal.mpr hu') hm
    haveI := IsLocalization.isLocalization_of_submonoid_le R S P.primeCompl Q.primeCompl hle
    show IsLocalization _ S
    refine IsLocalization.of_le (Submonoid.map (algebraMap A R) Q.primeCompl) _ ?_ ?_
    · rintro _ ⟨a, ha, rfl⟩
      show φ (gR a) ∉ IsLocalRing.maximalIdeal S
      rw [hc a]
      exact IsLocalRing.notMem_maximalIdeal.mpr
        (IsLocalization.map_units S (⟨a, ha⟩ : Q.primeCompl))
    · intro r hr
      exact IsLocalRing.notMem_maximalIdeal.mp hr
  obtain ⟨W, hW, hzW, -⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z) (U := ⊤) trivial
  have hxW : x ∈ W := h.mem_open W.isOpen hzW
  have hLz := hW.isLocalization_stalk ⟨z, hzW⟩
  have hLx := hW.isLocalization_stalk ⟨x, hxW⟩
  have hcomp : (X.presheaf.stalkSpecializes h).hom.comp (X.presheaf.germ W z hzW).hom =
      (X.presheaf.germ W x hxW).hom := by
    rw [← CommRingCat.hom_comp, TopCat.Presheaf.germ_stalkSpecializes]
  exact key Γ(X, W) _ _ _ _ _ hcomp _ _ hLz hLx

theorem wc_ldp_nc_submersive_localization : ∀ (E A B : Type u) [Field E] [CommRing A] [IsLocalRing A]
    [CommRing B] [IsLocalRing B] [Algebra E A] [Algebra E B] [Algebra A B] [IsScalarTower E A B]
    (M : Submonoid A) [IsLocalization M B] [Module.Free A Ω[A⁄E]] (g₀ g₁ : A),
    g₀ • KaehlerDifferential.D E A g₁ - g₁ • KaehlerDifferential.D E A g₀ ∉
      (IsLocalRing.maximalIdeal A) • (⊤ : Submodule A Ω[A⁄E]) →
    algebraMap A B g₀ • KaehlerDifferential.D E B (algebraMap A B g₁) -
        algebraMap A B g₁ • KaehlerDifferential.D E B (algebraMap A B g₀) ∉
      (IsLocalRing.maximalIdeal B) • (⊤ : Submodule B Ω[B⁄E]) :=
by
  intro E A B _ _ _ _ _ _ _ _ _ M _ _ g₀ g₁ hA
  classical
  have mem_imp : ∀ {R N : Type u} [CommRing R] [AddCommGroup N] [Module R N] {ι : Type u}
      (b : Module.Basis ι R N) (I : Ideal R) (x : N),
      x ∈ I • (⊤ : Submodule R N) → ∀ i, b.repr x i ∈ I := by
    intro R N _ _ _ ι b I x hx
    refine Submodule.smul_induction_on (p := fun y => ∀ i, b.repr y i ∈ I) hx ?_ ?_
    · intro r hr n _ i
      rw [map_smul, Finsupp.smul_apply, smul_eq_mul]
      exact I.mul_mem_right _ hr
    · intro y z hy hz i
      rw [map_add, Finsupp.add_apply]
      exact I.add_mem (hy i) (hz i)
  have imp_mem : ∀ {R N : Type u} [CommRing R] [AddCommGroup N] [Module R N] {ι : Type u}
      (b : Module.Basis ι R N) (I : Ideal R) (x : N),
      (∀ i, b.repr x i ∈ I) → x ∈ I • (⊤ : Submodule R N) := by
    intro R N _ _ _ ι b I x h
    rw [← b.linearCombination_repr x, Finsupp.linearCombination_apply, Finsupp.sum]
    exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem_smul (h i) Submodule.mem_top
  let φΩ := KaehlerDifferential.map E E A B
  let b := Module.Free.chooseBasis A Ω[A⁄E]
  let b' := Module.Basis.ofIsLocalizedModule B M φΩ b
  have h3 : φΩ (g₀ • KaehlerDifferential.D E A g₁ - g₁ • KaehlerDifferential.D E A g₀) =
      algebraMap A B g₀ • KaehlerDifferential.D E B (algebraMap A B g₁) -
        algebraMap A B g₁ • KaehlerDifferential.D E B (algebraMap A B g₀) := by
    rw [map_sub, map_smul, map_smul, KaehlerDifferential.map_D, KaehlerDifferential.map_D,
      algebraMap_smul, algebraMap_smul]
  have hex : ¬ ∀ i, b.repr (g₀ • KaehlerDifferential.D E A g₁ - g₁ • KaehlerDifferential.D E A g₀) i
      ∈ IsLocalRing.maximalIdeal A := fun h => hA (imp_mem b _ _ h)
  obtain ⟨i₀, hi₀⟩ := not_forall.mp hex
  have hu := IsLocalRing.notMem_maximalIdeal.mp hi₀
  intro hB
  have hc := mem_imp b' _ _ hB i₀
  rw [← h3, Module.Basis.ofIsLocalizedModule_repr_apply] at hc
  exact IsLocalRing.notMem_maximalIdeal.mpr (hu.map (algebraMap A B)) hc

theorem wc_ldp_nc_axis_regular_sequence : ∀ (A : Type u) [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A],
    (∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] (r : ℕ)
      (x : Fin r → IsLocalRing.maximalIdeal R),
      LinearIndependent (IsLocalRing.ResidueField R)
        (fun i => (IsLocalRing.maximalIdeal R).toCotangent (x i)) →
      IsRegularLocalRing (R ⧸ Ideal.span (Set.range (fun i => (x i : R)))) ∧
        ringKrullDim (R ⧸ Ideal.span (Set.range (fun i => (x i : R)))) + r = ringKrullDim R) →
    (∀ (T : Type u) [CommRing T], IsRegularLocalRing T → IsDomain T) →
    ∀ (g₀ g₁ : A) (k : ℕ) (t : Fin k → A),
      IsLocalRing.maximalIdeal A = Ideal.span (insert g₀ (insert g₁ (Set.range t))) →
      ((k + 2 : ℕ) : WithBot ℕ∞) = ringKrullDim A →
      RingTheory.Sequence.IsWeaklyRegular A [g₀, g₁] ∧ IsRegularLocalRing (A ⧸ Ideal.span {g₀, g₁}) :=
by
  intro A _ _ _ HQ HD g₀ g₁ k t hm hdim
  classical
  let v : Fin (k + 2) → A := Fin.cons g₀ (Fin.cons g₁ t)
  have hrange : Set.range v = insert g₀ (insert g₁ (Set.range t)) := by
    simp only [v, Fin.range_cons]
  have hm' : IsLocalRing.maximalIdeal A = Ideal.span (Set.range v) := by
    rw [hrange]; exact hm

  have hle : Submodule.spanFinrank (IsLocalRing.maximalIdeal A) ≤ k + 2 := by
    rw [hm']
    refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range v)).trans ?_
    rw [← Set.image_univ]
    refine (Set.ncard_image_le Set.finite_univ).trans ?_
    rw [Set.ncard_univ, Nat.card_eq_fintype_card, Fintype.card_fin]
  have hReg : IsRegularLocalRing A := by
    apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
    rw [← hdim]
    exact_mod_cast hle
  haveI := hReg
  have hrank : Submodule.spanFinrank (IsLocalRing.maximalIdeal A) = k + 2 := by
    have h1 := hReg.spanFinrank_maximalIdeal
    rw [← hdim] at h1
    exact_mod_cast h1

  have hv : ∀ i, v i ∈ IsLocalRing.maximalIdeal A := fun i => by
    rw [hm']; exact Ideal.subset_span (Set.mem_range_self i)
  let v' : Fin (k + 2) → IsLocalRing.maximalIdeal A := fun i => ⟨v i, hv i⟩
  have hspan : Submodule.span A (Set.range v') = ⊤ := by
    apply Submodule.map_injective_of_injective
      (f := (IsLocalRing.maximalIdeal A).subtype) (fun a b h => Subtype.ext h)
    rw [Submodule.map_span, Submodule.map_subtype_top, ← Set.range_comp]
    exact hm'.symm
  have hspan2 := IsLocalRing.CotangentSpace.span_image_eq_top_iff.mpr hspan
  rw [← Set.range_comp] at hspan2
  have hLI : LinearIndependent (IsLocalRing.ResidueField A)
      ((IsLocalRing.maximalIdeal A).toCotangent ∘ v') := by
    apply linearIndependent_of_top_le_span_of_card_eq_finrank
    · rw [hspan2]
    · rw [Fintype.card_fin, ← hrank]
      exact IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace A

  have vs0 : v 0 = g₀ := by simp [v]
  have vs1 : v (Fin.succ 0) = g₁ := by simp [v]
  have h2 : 2 ≤ k + 2 := by omega
  have c0 : Fin.castLE h2 (0 : Fin 2) = 0 := Fin.ext (by simp)
  have c1 : Fin.castLE h2 (1 : Fin 2) = Fin.succ 0 := Fin.ext (by simp)
  have hp0 : ((v' (Fin.castLE h2 0) : IsLocalRing.maximalIdeal A) : A) = g₀ := by
    show v (Fin.castLE h2 0) = g₀
    rw [c0, vs0]
  have hp1 : ((v' (Fin.castLE h2 1) : IsLocalRing.maximalIdeal A) : A) = g₁ := by
    show v (Fin.castLE h2 1) = g₁
    rw [c1, vs1]
  have hLI2 := hLI.comp (Fin.castLE h2) (Fin.castLE_injective h2)
  have hfi := Fintype.linearIndependent_iff.mp hLI2

  have hg0 : g₀ ≠ 0 := by
    intro hz
    have hp : v' (Fin.castLE h2 0) = 0 := Subtype.ext (by rw [hp0, hz]; rfl)
    have hsum : ∑ i, (![1, 0] : Fin 2 → IsLocalRing.ResidueField A) i •
        ((IsLocalRing.maximalIdeal A).toCotangent ∘ v' ∘ Fin.castLE h2) i = 0 := by
      rw [Fin.sum_univ_two]
      show (1 : IsLocalRing.ResidueField A) •
          (IsLocalRing.maximalIdeal A).toCotangent (v' (Fin.castLE h2 0)) +
        (0 : IsLocalRing.ResidueField A) •
          (IsLocalRing.maximalIdeal A).toCotangent (v' (Fin.castLE h2 1)) = 0
      rw [hp, map_zero, smul_zero, zero_smul, add_zero]
    have := hfi _ hsum 0
    simp at this
  have hndvd : ¬ g₀ ∣ g₁ := by
    rintro ⟨c, hc⟩
    have hp : v' (Fin.castLE h2 1) = c • v' (Fin.castLE h2 0) := Subtype.ext (by
      rw [Submodule.coe_smul, hp0, hp1, hc, smul_eq_mul, mul_comm])
    have hsum : ∑ i, (![algebraMap A (IsLocalRing.ResidueField A) c, -1] :
        Fin 2 → IsLocalRing.ResidueField A) i •
        ((IsLocalRing.maximalIdeal A).toCotangent ∘ v' ∘ Fin.castLE h2) i = 0 := by
      rw [Fin.sum_univ_two]
      show algebraMap A (IsLocalRing.ResidueField A) c •
          (IsLocalRing.maximalIdeal A).toCotangent (v' (Fin.castLE h2 0)) +
        (-1 : IsLocalRing.ResidueField A) •
          (IsLocalRing.maximalIdeal A).toCotangent (v' (Fin.castLE h2 1)) = 0
      rw [hp, map_smul, algebraMap_smul, neg_one_smul, add_neg_cancel]
    have := hfi _ hsum 1
    simp at this

  have hRq' := (HQ A 2 (v' ∘ Fin.castLE h2) hLI2).1
  have hr2 : Set.range (fun i => (((v' ∘ Fin.castLE h2) i : IsLocalRing.maximalIdeal A) : A))
      = {g₀, g₁} := by
    ext y
    simp only [Set.mem_range, Fin.exists_fin_two, Function.comp_apply, hp0, hp1,
      Set.mem_insert_iff, Set.mem_singleton_iff]
    exact ⟨fun h => h.imp Eq.symm Eq.symm, fun h => h.imp Eq.symm Eq.symm⟩
  rw [hr2] at hRq'

  have h1' : 1 ≤ k + 2 := by omega
  have hLI1 := hLI.comp (Fin.castLE h1') (Fin.castLE_injective h1')
  have hR1' := (HQ A 1 (v' ∘ Fin.castLE h1') hLI1).1
  have hr1 : Set.range (fun i => (((v' ∘ Fin.castLE h1') i : IsLocalRing.maximalIdeal A) : A))
      = {g₀} := by
    rw [Set.range_unique]
    have e : Fin.castLE h1' (default : Fin 1) = 0 := Fin.ext (by simp)
    show {v (Fin.castLE h1' default)} = ({g₀} : Set A)
    rw [e, vs0]
  rw [hr1] at hR1'
  haveI hDom : IsDomain A := HD A hReg
  haveI hDom0 : IsDomain (A ⧸ Ideal.span {g₀}) := HD _ hR1'

  refine ⟨?_, hRq'⟩
  refine RingTheory.Sequence.IsWeaklyRegular.cons (IsSMulRegular.of_ne_zero hg0) ?_
  refine RingTheory.Sequence.IsWeaklyRegular.cons ?_ (RingTheory.Sequence.IsWeaklyRegular.nil _ _)
  intro x y hxy
  obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ y
  dsimp only at hxy
  rw [← Submodule.Quotient.mk_smul, ← Submodule.Quotient.mk_smul, Submodule.Quotient.eq] at hxy
  rw [Submodule.Quotient.eq]
  obtain ⟨d, -, hd⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).mp hxy
  simp only [smul_eq_mul] at hd
  have hdvd : g₀ ∣ g₁ * (a - b) := ⟨d, by rw [mul_sub, ← hd]⟩
  have hq : Ideal.Quotient.mk (Ideal.span {g₀}) g₁ * Ideal.Quotient.mk (Ideal.span {g₀}) (a - b)
      = 0 := by
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_dvd]; exact hdvd
  rcases mul_eq_zero.mp hq with h | h
  · exact absurd ((Ideal.Quotient.eq_zero_iff_dvd _ _).mp h) hndvd
  · obtain ⟨e, he⟩ := (Ideal.Quotient.eq_zero_iff_dvd _ _).mp h
    rw [he]
    exact Submodule.smul_mem_pointwise_smul e g₀ ⊤ Submodule.mem_top

theorem wc_ldp_nc_quotient_localization_regular : ∀ (A B : Type u) [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A] [CommRing B] [IsLocalRing B] [Algebra A B] (p : Ideal A) [p.IsPrime]
    [IsLocalization.AtPrime B p],
    (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], IsRegularLocalRing A →
      ∀ (𝔭 : Ideal A) [𝔭.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔭)) →
    ∀ (I : Ideal A), I ≤ p → IsRegularLocalRing (A ⧸ I) →
      IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) I) :=
by
  intro A B _ _ _ _ _ _ p _ _ HL I hIp hR
  haveI := hR
  have hfs : Function.Surjective (Ideal.Quotient.mk I) := Ideal.Quotient.mk_surjective
  have hker : RingHom.ker (Ideal.Quotient.mk I) ≤ p := by rw [Ideal.mk_ker]; exact hIp
  haveI hpb : (Ideal.map (Ideal.Quotient.mk I) p).IsPrime :=
    Ideal.map_isPrime_of_surjective hfs hker
  have hmem : ∀ x : A, Ideal.Quotient.mk I x ∈ Ideal.map (Ideal.Quotient.mk I) p ↔ x ∈ p := by
    intro x
    constructor
    · intro hx
      have h1 : x ∈ Ideal.comap (Ideal.Quotient.mk I) (Ideal.map (Ideal.Quotient.mk I) p) :=
        Ideal.mem_comap.mpr hx
      rw [Ideal.comap_map_of_surjective _ hfs p, ← RingHom.ker_eq_comap_bot,
        sup_eq_left.mpr hker] at h1
      exact h1
    · intro hx
      exact Ideal.mem_map_of_mem _ hx
  have hsq : (Ideal.Quotient.mk (Ideal.map (algebraMap A B) I)).comp (algebraMap A B) =
      (algebraMap (A ⧸ I) (B ⧸ Ideal.map (algebraMap A B) I)).comp (Ideal.Quotient.mk I) :=
    RingHom.ext fun x => (Ideal.Quotient.algebraMap_quotient_map_quotient x).symm
  have hL0 : IsLocalization (p.primeCompl.map (Ideal.Quotient.mk I))
      (B ⧸ Ideal.map (algebraMap A B) I) :=
    IsLocalization.of_surjective p.primeCompl B (Ideal.Quotient.mk I) hfs
      (Ideal.Quotient.mk (Ideal.map (algebraMap A B) I)) Ideal.Quotient.mk_surjective hsq
      (by rw [Ideal.mk_ker, Ideal.mk_ker])
  have hL : IsLocalization (Ideal.map (Ideal.Quotient.mk I) p).primeCompl
      (B ⧸ Ideal.map (algebraMap A B) I) := by
    refine IsLocalization.of_le (p.primeCompl.map (Ideal.Quotient.mk I)) _ ?_ ?_
    · rintro y ⟨x, hx, rfl⟩
      exact fun h => hx ((hmem x).mp h)
    · intro r hr
      obtain ⟨x, rfl⟩ := hfs r
      have hx : x ∈ p.primeCompl := fun h => hr ((hmem x).mpr h)
      exact IsLocalization.map_units (B ⧸ Ideal.map (algebraMap A B) I)
        (⟨Ideal.Quotient.mk I x, ⟨x, hx, rfl⟩⟩ : p.primeCompl.map (Ideal.Quotient.mk I))
  haveI := hL
  haveI := HL (A ⧸ I) hR (Ideal.map (Ideal.Quotient.mk I) p)
  exact IsRegularLocalRing.of_ringEquiv
    (IsLocalization.algEquiv (Ideal.map (Ideal.Quotient.mk I) p).primeCompl
      (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk I) p))
      (B ⧸ Ideal.map (algebraMap A B) I)).toRingEquiv

theorem wc_ldp_nc_axis_localize : ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    [CommRing B] [IsLocalRing B] [Algebra A B] (p : Ideal A) [p.IsPrime]
    [IsLocalization.AtPrime B p] (g₀ g₁ : A), g₀ ∈ p → g₁ ∈ p →
    RingTheory.Sequence.IsWeaklyRegular A [g₀, g₁] →
    IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (Ideal.span {g₀, g₁})) →
    ∃ (k' : ℕ) (t' : Fin k' → B),
      IsLocalRing.maximalIdeal B =
        Ideal.span (insert (algebraMap A B g₀) (insert (algebraMap A B g₁) (Set.range t'))) ∧
      ((k' + 2 : ℕ) : WithBot ℕ∞) = ringKrullDim B :=
by
  intro A B _ _ _ _ _ _ p _ _ g₀ g₁ hg₀ hg₁ hW hRC
  classical
  set φ := algebraMap A B with hφ
  set I : Ideal B := Ideal.map φ (Ideal.span {g₀, g₁}) with hI
  haveI : IsNoetherianRing B := IsLocalization.isNoetherianRing p.primeCompl B inferInstance
  have hIeq : I = Ideal.span {φ g₀, φ g₁} := by
    rw [hI, Ideal.map_span, Set.image_pair]

  have hReg : RingTheory.Sequence.IsRegular B (List.map φ [g₀, g₁]) :=
    RingTheory.Sequence.IsWeaklyRegular.isRegular_of_isLocalizedModule_of_mem
      (S := B) (N := B) p (Algebra.linearMap A B) hW (by
        intro r hr
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
        rcases hr with rfl | rfl
        · exact hg₀
        · exact hg₁)
  have hdim := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular _ hReg
  have hof : Ideal.ofList (List.map φ [g₀, g₁]) = I := by
    rw [hIeq]
    simp only [List.map_cons, List.map_nil, Ideal.ofList_cons, Ideal.ofList_nil, sup_bot_eq]
    rw [Ideal.span_insert]
  rw [hof] at hdim

  haveI := hRC
  set k := Submodule.spanFinrank (IsLocalRing.maximalIdeal (B ⧸ I)) with hk
  have hkdim : (k : WithBot ℕ∞) = ringKrullDim (B ⧸ I) :=
    IsRegularLocalRing.spanFinrank_maximalIdeal

  have hfg : (IsLocalRing.maximalIdeal (B ⧸ I)).FG := IsNoetherian.noetherian _
  obtain ⟨s, hs, hspan⟩ := Submodule.FG.exists_span_set_encard_eq_spanFinrank hfg
  have hsfin : s.Finite := Set.finite_of_encard_eq_coe hs
  haveI : Finite s := hsfin.to_subtype
  have hncard : Nat.card s = k := by
    rw [Nat.card_coe_set_eq]
    have := hsfin.cast_ncard_eq
    rw [hs] at this
    exact_mod_cast this
  let f : Fin k → B ⧸ I := fun i => ((Finite.equivFin s).symm (Fin.cast hncard.symm i) : B ⧸ I)
  have hfr : Set.range f = s := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact Subtype.mem _
    · intro hx
      refine ⟨Fin.cast hncard (Finite.equivFin s ⟨x, hx⟩), ?_⟩
      have hc : ∀ y, Fin.cast hncard.symm (Fin.cast hncard y) = y := fun y => Fin.ext rfl
      show (((Finite.equivFin s).symm (Fin.cast hncard.symm
        (Fin.cast hncard (Finite.equivFin s ⟨x, hx⟩)))) : B ⧸ I) = x
      rw [hc, Equiv.symm_apply_apply]
  let t : Fin k → B := fun i => Function.surjInv Ideal.Quotient.mk_surjective (f i)
  have ht : ∀ i, Ideal.Quotient.mk I (t i) = f i := fun i =>
    Function.surjInv_eq Ideal.Quotient.mk_surjective (f i)
  have hcomap : (IsLocalRing.maximalIdeal (B ⧸ I)).comap (Ideal.Quotient.mk I) =
      IsLocalRing.maximalIdeal B := by
    haveI := Ideal.comap_isMaximal_of_surjective (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective (K := IsLocalRing.maximalIdeal (B ⧸ I))
    exact IsLocalRing.eq_maximalIdeal this
  have hh₀ : φ g₀ ∈ IsLocalRing.maximalIdeal B :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff B p g₀).mpr hg₀
  have hh₁ : φ g₁ ∈ IsLocalRing.maximalIdeal B :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff B p g₁).mpr hg₁
  refine ⟨k, t, ?_, ?_⟩
  · apply le_antisymm
    · intro y hy
      rw [← hcomap, Ideal.mem_comap, ← hspan, ← hfr] at hy
      have hmap : Ideal.map (Ideal.Quotient.mk I) (Ideal.span (Set.range t)) =
          Submodule.span (B ⧸ I) (Set.range f) := by
        rw [Ideal.map_span, ← Set.range_comp]
        congr 1
        ext x
        simp [ht]
      rw [← hmap, Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective] at hy
      obtain ⟨w, hw, hwy⟩ := hy
      have hyw : y - w ∈ I := by
        rw [← Ideal.Quotient.eq]; exact hwy.symm
      rw [hIeq] at hyw
      have h1 : y - w ∈ Ideal.span (insert (φ g₀) (insert (φ g₁) (Set.range t))) := by
        refine Ideal.span_mono ?_ hyw
        intro z hz
        rcases hz with rfl | hz
        · exact Set.mem_insert _ _
        · rw [Set.mem_singleton_iff] at hz
          subst hz
          exact Set.mem_insert_of_mem _ (Set.mem_insert _ _)
      have h2 : w ∈ Ideal.span (insert (φ g₀) (insert (φ g₁) (Set.range t))) :=
        Ideal.span_mono ((Set.subset_insert _ _).trans (Set.subset_insert _ _)) hw
      have := Ideal.add_mem _ h1 h2
      rwa [sub_add_cancel] at this
    · rw [Ideal.span_le]
      intro z hz
      rcases hz with rfl | rfl | ⟨i, rfl⟩
      · exact hh₀
      · exact hh₁
      · rw [← hcomap, SetLike.mem_coe, Ideal.mem_comap, ht, ← hspan]
        exact Submodule.subset_span (hfr ▸ ⟨i, rfl⟩)
  · rw [← hdim, ← hkdim]
    simp

theorem wc_ldp_nonclosed_points (E : Type u) [Field E] (N n : ℕ)
    (X : Over (Spec (.of E))) [IsProper X.hom] [SmoothOfRelativeDimension n X.hom]
    (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr E N = X.hom)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
    (S : Set X.left) (hS : S.Finite) (hScl : ∀ x ∈ S, IsClosed ({x} : Set X.left))
    (hreg : ∀ x : X.left, IsClosed ({x} : Set X.left) → wcLdpAxisReg E N ι G₀ G₁ x)
    (hcrit : ∀ x : X.left, IsClosed ({x} : Set X.left) → wcLdpCrit E N X.hom ι G₀ G₁ x → x ∈ S) :
    (∀ x : X.left, wcLdpAxisReg E N ι G₀ G₁ x) ∧
      ∀ x : X.left, wcLdpCrit E N X.hom ι G₀ G₁ x → x ∈ S :=
by
  classical
  haveI : JacobsonSpace X.left := LocallyOfFiniteType.jacobsonSpace X.hom
  haveI : IsLocallyNoetherian X.left := LocallyOfFiniteType.isLocallyNoetherian X.hom

  have hJ : ∀ (O : Set X.left), IsOpen O → ∀ x ∈ O,
      ∃ z : X.left, IsClosed ({z} : Set X.left) ∧ x ⤳ z ∧ z ∈ O := by
    intro O hO x hx
    have hZ : IsLocallyClosed (closure {x} ∩ O) :=
      (isClosed_closure.isLocallyClosed).inter hO.isLocallyClosed
    obtain ⟨z, ⟨hzc, hzO⟩, hz⟩ :=
      jacobsonSpace_iff_locallyClosed.mp (inferInstance : JacobsonSpace X.left)
        (closure {x} ∩ O) ⟨x, subset_closure (Set.mem_singleton x), hx⟩ hZ
    exact ⟨z, hz, specializes_iff_mem_closure.mpr hzc, hzO⟩

  have hgerm : ∀ {x z : X.left} (h : x ⤳ z) (U : X.left.Opens) (hz : z ∈ U) (f : Γ(X.left, U)),
      (X.left.presheaf.stalkSpecializes h).hom ((X.left.presheaf.germ U z hz).hom f) =
        (X.left.presheaf.germ U x (h.mem_open U.isOpen hz)).hom f := by
    intro x z h U hz f
    rw [← TopCat.Presheaf.germ_stalkSpecializes X.left.presheaf hz h]
    rfl
  have hgermL : ∀ {x z : X.left} (h : x ⤳ z) (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
      (b : Fin (N + 1)) (hz : z ∈ ι ⁻¹ᵁ wcSgD E N b),
      (X.left.presheaf.stalkSpecializes h).hom (wcLdpGerm E N ι G b z hz) =
        wcLdpGerm E N ι G b x (h.mem_open (ι ⁻¹ᵁ wcSgD E N b).isOpen hz) :=
    fun h G b hz => hgerm h _ hz _
  have hconst : ∀ {x z : X.left} (h : x ⤳ z) (c : E),
      (X.left.presheaf.stalkSpecializes h).hom (wcLdpConst E X.hom z c) = wcLdpConst E X.hom x c :=
    fun h c => hgerm h ⊤ trivial _

  have hU : ∀ {x z : X.left} (h : x ⤳ z) (g : X.left.presheaf.stalk z),
      (X.left.presheaf.stalkSpecializes h).hom g ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) →
        g ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk z) := by
    intro x z h g hg
    by_contra hn
    have hu : IsUnit g := IsLocalRing.notMem_maximalIdeal.mp hn
    exact IsLocalRing.notMem_maximalIdeal.mpr (hu.map (X.left.presheaf.stalkSpecializes h).hom) hg
  refine ⟨?_, ?_⟩
  ·
    intro x hax a hxa
    obtain ⟨z, hzc, h, hza⟩ := hJ _ (ι ⁻¹ᵁ wcSgD E N a).isOpen x hxa
    have hzax : wcLdpOnAxis E N ι G₀ G₁ z := by
      intro b hzb
      obtain ⟨h0, h1⟩ := hax b (h.mem_open (ι ⁻¹ᵁ wcSgD E N b).isOpen hzb)
      exact ⟨hU h _ (by rw [hgermL h G₀ b hzb]; exact h0),
        hU h _ (by rw [hgermL h G₁ b hzb]; exact h1)⟩
    obtain ⟨k, t, hm, hdim⟩ := hreg z hzc hzax a hza
    obtain ⟨hW, hRq⟩ := wc_ldp_nc_axis_regular_sequence _ wcpa_rs_quotient_regular
      (fun T _ hT => wcpa_regular_isDomain T wcpa_rs_quotient_regular hT) _ _ k t hm hdim
    letI : Algebra (X.left.presheaf.stalk z) (X.left.presheaf.stalk x) :=
      (X.left.presheaf.stalkSpecializes h).hom.toAlgebra
    haveI := wc_ldp_nc_stalkSpecializes_isLocalization X.left x z h
    have hg0 : wcLdpGerm E N ι G₀ a z hza ∈
        (IsLocalRing.maximalIdeal (X.left.presheaf.stalk x)).comap
          (X.left.presheaf.stalkSpecializes h).hom := by
      rw [Ideal.mem_comap, hgermL h G₀ a hza]; exact (hax a hxa).1
    have hg1 : wcLdpGerm E N ι G₁ a z hza ∈
        (IsLocalRing.maximalIdeal (X.left.presheaf.stalk x)).comap
          (X.left.presheaf.stalkSpecializes h).hom := by
      rw [Ideal.mem_comap, hgermL h G₁ a hza]; exact (hax a hxa).2
    have hle : Ideal.span {wcLdpGerm E N ι G₀ a z hza, wcLdpGerm E N ι G₁ a z hza} ≤
        (IsLocalRing.maximalIdeal (X.left.presheaf.stalk x)).comap
          (X.left.presheaf.stalkSpecializes h).hom := by
      rw [Ideal.span_le]
      intro y hy
      rcases hy with rfl | rfl
      · exact hg0
      · exact hg1
    have hRB := wc_ldp_nc_quotient_localization_regular _ (X.left.presheaf.stalk x) _
      wc_hnas_pfc_regular_localization _ hle hRq
    obtain ⟨k', t', hm', hdim'⟩ := wc_ldp_nc_axis_localize _ (X.left.presheaf.stalk x) _ _ _
      hg0 hg1 hW hRB
    have e0 : algebraMap (X.left.presheaf.stalk z) (X.left.presheaf.stalk x)
        (wcLdpGerm E N ι G₀ a z hza) = wcLdpGerm E N ι G₀ a x hxa := hgermL h G₀ a hza
    have e1 : algebraMap (X.left.presheaf.stalk z) (X.left.presheaf.stalk x)
        (wcLdpGerm E N ι G₁ a z hza) = wcLdpGerm E N ι G₁ a x hxa := hgermL h G₁ a hza
    rw [e0, e1] at hm'
    exact ⟨k', t', hm', hdim'⟩
  ·
    intro x hcr
    by_cases hxc : IsClosed ({x} : Set X.left)
    · exact hcrit x hxc hcr
    exfalso
    obtain ⟨hoff, a, hxa, hns⟩ := hcr
    have hSc : IsClosed S := by
      have := hS.isClosed_biUnion hScl
      rwa [Set.biUnion_of_singleton] at this
    have hxS : x ∉ S := fun hxS => hxc (hScl x hxS)
    have key : ∀ (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) (b : Fin (N + 1))
        (hxb : x ∈ ι ⁻¹ᵁ wcSgD E N b),
        (∀ (y : X.left) (hyb : y ∈ ι ⁻¹ᵁ wcSgD E N b), wcLdpOnAxis E N ι G₀ G₁ y →
          wcLdpGerm E N ι G b y hyb ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk y)) →
        wcLdpGerm E N ι G b x hxb ∉ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) → False := by
      intro G b hxb hGax hxG
      set f : Γ(X.left, ι ⁻¹ᵁ wcSgD E N b) := (ι.app (wcSgD E N b)).hom (wcLdpSec E N G b) with hf
      have hxf : x ∈ X.left.basicOpen f :=
        (X.left.mem_basicOpen f x hxb).mpr (IsLocalRing.notMem_maximalIdeal.mp hxG)
      set O : Set X.left := ((ι ⁻¹ᵁ wcSgD E N a : X.left.Opens) : Set X.left) ∩
        ((X.left.basicOpen f : X.left.Opens) : Set X.left) ∩ Sᶜ with hO
      have hOo : IsOpen O :=
        ((ι ⁻¹ᵁ wcSgD E N a).isOpen.inter (X.left.basicOpen f).isOpen).inter hSc.isOpen_compl
      obtain ⟨z, hzc, h, ⟨⟨hza, hzf⟩, hzS⟩⟩ := hJ O hOo x ⟨⟨hxa, hxf⟩, hxS⟩
      have hzb : z ∈ ι ⁻¹ᵁ wcSgD E N b := X.left.basicOpen_le f hzf
      have hzu : IsUnit (wcLdpGerm E N ι G b z hzb) := (X.left.mem_basicOpen f z hzb).mp hzf
      have hnoax : ¬ wcLdpOnAxis E N ι G₀ G₁ z := fun hzax =>
        IsLocalRing.notMem_maximalIdeal.mpr hzu (hGax z hzb hzax)
      have hnsub : ¬ wcLdpSubmersive E X.hom z (wcLdpGerm E N ι G₀ a z hza)
          (wcLdpGerm E N ι G₁ a z hza) := by
        intro hsub
        letI iA : Algebra E (X.left.presheaf.stalk z) := (wcLdpConst E X.hom z).toAlgebra
        letI iB : Algebra E (X.left.presheaf.stalk x) := (wcLdpConst E X.hom x).toAlgebra
        letI iAB : Algebra (X.left.presheaf.stalk z) (X.left.presheaf.stalk x) :=
          (X.left.presheaf.stalkSpecializes h).hom.toAlgebra
        haveI : IsScalarTower E (X.left.presheaf.stalk z) (X.left.presheaf.stalk x) :=
          IsScalarTower.of_algebraMap_eq (fun c => (hconst h c).symm)
        haveI := wc_ldp_nc_stalkSpecializes_isLocalization X.left x z h
        haveI : Module.Free (X.left.presheaf.stalk z) Ω[X.left.presheaf.stalk z⁄E] :=
          (wc_ldp_il_stalk_of_smooth_field E X.hom n z).2.1
        have hB := wc_ldp_nc_submersive_localization E (X.left.presheaf.stalk z)
          (X.left.presheaf.stalk x)
          ((IsLocalRing.maximalIdeal (X.left.presheaf.stalk x)).comap
            (X.left.presheaf.stalkSpecializes h).hom).primeCompl _ _ hsub
        have e0 : algebraMap (X.left.presheaf.stalk z) (X.left.presheaf.stalk x)
            (wcLdpGerm E N ι G₀ a z hza) = wcLdpGerm E N ι G₀ a x hxa := hgermL h G₀ a hza
        have e1 : algebraMap (X.left.presheaf.stalk z) (X.left.presheaf.stalk x)
            (wcLdpGerm E N ι G₁ a z hza) = wcLdpGerm E N ι G₁ a x hxa := hgermL h G₁ a hza
        rw [e0, e1] at hB
        exact hns hB
      exact hzS (hcrit z hzc ⟨hnoax, a, hza, hnsub⟩)
    by_cases h0 : wcLdpGerm E N ι G₀ a x hxa ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x)
    ·
      have : ∃ (b : Fin (N + 1)) (hxb : x ∈ ι ⁻¹ᵁ wcSgD E N b),
          wcLdpGerm E N ι G₀ b x hxb ∉ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ∨
          wcLdpGerm E N ι G₁ b x hxb ∉ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) := by
        by_contra hc
        push_neg at hc
        exact hoff hc
      obtain ⟨b, hxb, hb | hb⟩ := this
      · exact key G₀ b hxb (fun y hyb hy => (hy b hyb).1) hb
      · exact key G₁ b hxb (fun y hyb hy => (hy b hyb).2) hb
    · exact key G₀ a hxa (fun y hyb hy => (hy a hyb).1) h0

theorem wc_ldp_good_pencil_exists (F' : Type u) [Finite F'] [Field F']
    (Y : Over (Spec (.of F'))) [GeometricallyIrreducible Y.hom] [IsProper Y.hom] (n : ℕ)
    [SmoothOfRelativeDimension n Y.hom] (hn : Even n) (hn2 : 2 ≤ n)
    (N : ℕ) (j : Y.left ⟶ wcProjK F' N) (hj : IsClosedImmersion j)
    (hjY : j ≫ wcProjKStr F' N = Y.hom)
    (hemb : ∀ (E : Type u) [Field E] [Algebra F' E],
      ∃ jE : Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) ⟶ wcProjK E N,
        IsClosedImmersion jE ∧
        jE ≫ wcProjKStr E N =
          Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E)))) :
    ∃ (E : Type u) (_ : Field E) (_ : Finite E) (_ : Algebra F' E)
      (jE : Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) ⟶ wcProjK E N),
      IsClosedImmersion jE ∧
      jE ≫ wcProjKStr E N =
        Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) ∧
      ∃ (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) (m : ℕ)
        (y : Fin m → (Spec (.of E) ⟶
          Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E)))))
        (c : Fin m → Fin 2 → E),
        wcLdpGoodPencil E N n
          (Over.mk (Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E)))))
          jE G₀ G₁ m y c :=
by
  classical
  refine wc_ldp_descend_good_pencil F' Y n N j hj hjY ?_
  intro jK hjK hjKY
  set X : Over (Spec (.of (AlgebraicClosure F'))) :=
    Over.mk (Limits.pullback.snd Y.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) with hXdef
  haveI hXp : IsProper X.hom :=
    (inferInstance : IsProper (Limits.pullback.snd Y.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
  haveI hXgi : GeometricallyIrreducible X.hom :=
    (inferInstance : GeometricallyIrreducible (Limits.pullback.snd Y.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
  haveI hXs : SmoothOfRelativeDimension n X.hom :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension n)
      (IsPullback.of_hasPullback Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))
      (inferInstance : SmoothOfRelativeDimension n Y.hom)
  have hιX : jK ≫ wcProjKStr (AlgebraicClosure F') N = X.hom := hjKY
  obtain ⟨Φa, hΦa0, hΦa⟩ := wc_ldp_axis_generic (AlgebraicClosure F') N n hn2 X jK hjK hιX
  obtain ⟨Φb, hΦb0, hΦb⟩ := wc_ldp_odp_generic (AlgebraicClosure F') N n hn hn2 X jK hjK hιX
  obtain ⟨Φc, hΦc0, hΦc⟩ := wc_ldp_double_generic (AlgebraicClosure F') N n hn2 X jK hjK hιX
  have hΦ0 : Φa * Φb * Φc ≠ 0 := mul_ne_zero (mul_ne_zero hΦa0 hΦb0) hΦc0
  obtain ⟨v, hv⟩ : ∃ v, MvPolynomial.eval v (Φa * Φb * Φc) ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    apply hΦ0
    apply MvPolynomial.funext
    intro x
    rw [hcon x, map_zero]
  rw [map_mul, map_mul] at hv
  have hva : MvPolynomial.eval v Φa ≠ 0 := left_ne_zero_of_mul (left_ne_zero_of_mul hv)
  have hvb : MvPolynomial.eval v Φb ≠ 0 := right_ne_zero_of_mul (left_ne_zero_of_mul hv)
  have hvc : MvPolynomial.eval v Φc ≠ 0 := right_ne_zero_of_mul hv
  obtain ⟨hP0, hreg⟩ := hΦa v hva
  have hodp := hΦb v hvb
  have hdbl := hΦc v hvc
  obtain ⟨m, y, c, hyinj, hysec, hycl, hycrit, hc, hall⟩ :=
    wc_ldp_crit_finite (AlgebraicClosure F') N n X jK hjK hιX _ _ hreg hodp
  obtain ⟨hregAll, hcritAll⟩ :=
    wc_ldp_nonclosed_points (AlgebraicClosure F') N n X jK hjK hιX _ _
      (Set.range fun i => y i (IsLocalRing.closedPoint (AlgebraicClosure F')))
      (Set.finite_range _) (by rintro x ⟨i, rfl⟩; exact hycl i) hreg
      (fun x hx hcr => by obtain ⟨i, rfl⟩ := hall x hx hcr; exact ⟨i, rfl⟩)
  refine ⟨_, _, m, y, c, hP0, ?_, hysec, fun i => (hycrit i).1, fun i => (hc i).1, ?_, ?_, ?_⟩
  · intro x a hx hax
    exact hregAll x hax a hx
  · intro i i' hii'
    exact hdbl _ _ (hycl i) (hycl i') (fun h => hii' (hyinj h)) (hycrit i) (hycrit i')
      (c i) (c i') (hc i).1 (hc i').1 (hc i).2 (hc i').2
      (hodp _ (hycl i) (hycrit i) (c i) (hc i).1 (hc i).2)
      (hodp _ (hycl i') (hycrit i') (c i') (hc i').1 (hc i').2)
  · intro x a hx hax hne
    by_contra hns
    obtain ⟨i, hi⟩ := hcritAll x ⟨hax, a, hx, hns⟩
    exact hne i hi.symm
  · intro i a hx
    exact hodp _ (hycl i) (hycrit i) (c i) (hc i).1 (hc i).2 a hx

theorem wc_ldp_il_smooth_local {Z S : Scheme.{u}} (s : Z ⟶ S) (n : ℕ)
    (h : ∀ z : Z, ∃ U : Z.Opens, z ∈ U ∧ SmoothOfRelativeDimension n (U.ι ≫ s)) :
    SmoothOfRelativeDimension n s :=
by
  classical
  choose U hzU hU using h
  have hcover : iSup U = ⊤ := by
    rw [eq_top_iff]
    intro z _
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨z, hzU z⟩
  haveI : IsZariskiLocalAtSource (@SmoothOfRelativeDimension n) :=
    HasRingHomProperty.instIsZariskiLocalAtSource
  exact IsZariskiLocalAtSource.of_iSup_eq_top U hcover hU

theorem wc_p1_smooth_reldim_one (K : Type u) [Field K] :
    SmoothOfRelativeDimension 1 (wcP1Over K).hom :=
by
  classical
  haveI hloc : IsZariskiLocalAtSource (@SmoothOfRelativeDimension 1) :=
    HasRingHomProperty.instIsZariskiLocalAtSource
  show SmoothOfRelativeDimension 1 (wcProjKStr K 1)
  refine IsZariskiLocalAtSource.of_iSup_eq_top
    (fun a : Fin (1 + 1) => @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
      (MvPolynomial.X a))
    (wc_pp_basicOpen_cover K 1) (fun a => ?_)
  obtain ⟨e, he⟩ := wc_pp_dehomogenize_ringEquiv K 1 a
  obtain ⟨φ, hφ⟩ := wc_pp_chart_iso K 1 a e he
  have h𝔸 : SmoothOfRelativeDimension 1
      (AffineSpace (ULift.{u} (Fin 1)) (Spec (.of K)) ↘ Spec (.of K)) := inferInstance
  have h := IsZariskiLocalAtSource.comp h𝔸 φ.hom
  rw [← hφ] at h
  exact h

theorem wc_ldp_il_hypersurface_criterion (B R S : Type u) [CommRing B] [CommRing R] [CommRing S]
    [IsLocalRing S] [Algebra B R] [Algebra B S] [Algebra.FormallySmooth B R]
    [Module.Free R Ω[R⁄B]] [Module.Finite R Ω[R⁄B]]
    (ψ : R →ₐ[B] S) (hψ : Function.Surjective ψ) (h : R)
    (hker : RingHom.ker ψ = Ideal.span {h})
    (δ : R →+ IsLocalRing.ResidueField S)
    (hδ : ∀ a b : R, δ (a * b) =
      IsLocalRing.residue S (ψ a) * δ b + IsLocalRing.residue S (ψ b) * δ a)
    (hδB : ∀ c : B, δ (algebraMap B R c) = 0) (hδh : δ h ≠ 0) :
    Algebra.FormallySmooth B S ∧ Module.Free S Ω[S⁄B] ∧ Module.Finite S Ω[S⁄B] ∧
      Module.finrank S Ω[S⁄B] + 1 = Module.finrank R Ω[R⁄B] :=
by
  classical

  letI : Algebra R S := (ψ : R →+* S).toAlgebra
  haveI : IsScalarTower B R S := IsScalarTower.of_algebraMap_eq (fun c => (ψ.commutes c).symm)
  have hsurj : Function.Surjective (algebraMap R S) := hψ
  have hkerS : RingHom.ker (algebraMap R S) = Ideal.span {h} := by
    rw [← hker]; ext r; rw [RingHom.mem_ker, RingHom.mem_ker]; rfl
  have hδ' : ∀ a b : R, δ (a * b) =
      IsLocalRing.residue S (algebraMap R S a) * δ b +
        IsLocalRing.residue S (algebraMap R S b) * δ a := fun a b => hδ a b

  obtain ⟨φ, hφ⟩ : ∃ φ : TensorProduct R S Ω[R⁄B] →ₗ[S] S,
      φ (1 ⊗ₜ[R] KaehlerDifferential.D B R h) = 1 := by
    have hsm : ∀ (r : R) (k : IsLocalRing.ResidueField S),
        r • k = IsLocalRing.residue S (algebraMap R S r) * k := by
      intro r k
      rw [Algebra.smul_def, IsScalarTower.algebraMap_apply R S (IsLocalRing.ResidueField S),
        IsLocalRing.ResidueField.algebraMap_eq]
    have hsmB : ∀ (c : B) (k : IsLocalRing.ResidueField S),
        c • k = IsLocalRing.residue S (algebraMap R S (algebraMap B R c)) * k := by
      intro c k
      rw [← hsm, algebraMap_smul]
    let δL : R →ₗ[B] IsLocalRing.ResidueField S :=
      { toFun := δ
        map_add' := δ.map_add
        map_smul' := fun c r => by
          simp only [RingHom.id_apply]
          rw [Algebra.smul_def, hδ', hδB, mul_zero, add_zero, hsmB] }
    let d : Derivation B R (IsLocalRing.ResidueField S) :=
      Derivation.mk' δL (fun a b => by
        show δ (a * b) = a • δ b + b • δ a
        rw [hδ', hsm, hsm])
    let φb : Ω[R⁄B] →ₗ[R] IsLocalRing.ResidueField S := d.liftKaehlerDifferential
    have hφb : ∀ r : R, φb (KaehlerDifferential.D B R r) = δ r := fun r => by
      show d.liftKaehlerDifferential (KaehlerDifferential.D B R r) = δ r
      rw [Derivation.liftKaehlerDifferential_comp_D]
      rfl
    let b := Module.Free.chooseBasis R Ω[R⁄B]
    have hc : ∀ i, ∃ s : S, IsLocalRing.residue S s = φb (b i) :=
      fun i => IsLocalRing.residue_surjective _
    choose c hc using hc
    let bS := Algebra.TensorProduct.basis S b
    let φ₁ : TensorProduct R S Ω[R⁄B] →ₗ[S] S := bS.constr S c
    have hcompat : ∀ ω : Ω[R⁄B],
        IsLocalRing.residue S (φ₁ (1 ⊗ₜ[R] ω)) = φb ω := by
      have key : ((IsScalarTower.toAlgHom R S (IsLocalRing.ResidueField S)).toLinearMap ∘ₗ
          (φ₁.restrictScalars R) ∘ₗ (TensorProduct.mk R S Ω[R⁄B] 1)) = φb := by
        apply b.ext
        intro i
        simp only [LinearMap.coe_comp, Function.comp_apply, TensorProduct.mk_apply,
          LinearMap.coe_restrictScalars, AlgHom.toLinearMap_apply, IsScalarTower.coe_toAlgHom']
        have : (1 : S) ⊗ₜ[R] b i = bS i := by
          rw [Algebra.TensorProduct.basis_apply]
        rw [this, Module.Basis.constr_basis, ← hc i, IsLocalRing.ResidueField.algebraMap_eq]
      intro ω
      have := LinearMap.congr_fun key ω
      simpa [IsLocalRing.ResidueField.algebraMap_eq] using this
    have hu : IsUnit (φ₁ (1 ⊗ₜ[R] KaehlerDifferential.D B R h)) := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hcompat, hφb]
      exact hδh
    refine ⟨((hu.unit⁻¹ : Sˣ) : S) • φ₁, ?_⟩
    rw [LinearMap.smul_apply, smul_eq_mul]
    exact hu.val_inv_mul

  set I := RingHom.ker (algebraMap R S) with hI
  have hhI : h ∈ I := by rw [hkerS]; exact Ideal.subset_span rfl
  have hh0 : algebraMap R S h = 0 := hhI
  have hDrh : ∀ r : R, (1 : S) ⊗ₜ[R] KaehlerDifferential.D B R (r * h) =
      r • (1 ⊗ₜ[R] KaehlerDifferential.D B R h) := by
    intro r
    rw [Derivation.leibniz, TensorProduct.tmul_add, TensorProduct.tmul_smul,
      TensorProduct.tmul_smul, ← algebraMap_smul S h, hh0, zero_smul, add_zero]

  have hfs : Algebra.FormallySmooth B S := by
    set c₀ : I.Cotangent := I.toCotangent ⟨h, hhI⟩ with hc₀
    let f₀ : R →ₗ[R] I.Cotangent := LinearMap.toSpanSingleton R I.Cotangent c₀
    have hf₀ : ∀ r : R, f₀ r = I.toCotangent ⟨r * h, I.mul_mem_left r hhI⟩ := by
      intro r
      show r • c₀ = _
      rw [hc₀, ← map_smul]
      rfl
    have hle : I ≤ LinearMap.ker f₀ := by
      intro i hi
      rw [LinearMap.mem_ker, hf₀, Ideal.toCotangent_eq_zero, pow_two]
      exact Ideal.mul_mem_mul hi hhI
    let L : (R ⧸ I) →ₗ[R] I.Cotangent := Submodule.liftQ I f₀ hle
    let e : (R ⧸ RingHom.ker (Algebra.ofId R S)) ≃ₐ[R] S :=
      Ideal.quotientKerAlgEquivOfSurjective (f := Algebra.ofId R S) hsurj
    let l : TensorProduct R S Ω[R⁄B] →ₗ[R] I.Cotangent :=
      L ∘ₗ e.symm.toLinearEquiv.toLinearMap ∘ₗ φ.restrictScalars R
    have hl : ∀ r : R, l (r • (1 ⊗ₜ[R] KaehlerDifferential.D B R h)) =
        I.toCotangent ⟨r * h, I.mul_mem_left r hhI⟩ := by
      intro r
      have hl1 : l (1 ⊗ₜ[R] KaehlerDifferential.D B R h) = c₀ := by
        show L (e.symm (φ (1 ⊗ₜ[R] KaehlerDifferential.D B R h))) = c₀
        rw [hφ, map_one]
        show L (Submodule.Quotient.mk 1) = c₀
        rw [Submodule.liftQ_apply]
        show (1 : R) • c₀ = c₀
        rw [one_smul]
      rw [map_smul, hl1, ← hf₀]
      rfl
    refine (Algebra.FormallySmooth.iff_split_injection (P := R) hsurj).mpr ⟨l, ?_⟩
    apply LinearMap.ext
    intro ξ
    obtain ⟨⟨x, hx⟩, rfl⟩ := I.toCotangent_surjective ξ
    have hx' : x ∈ Ideal.span {h} := hkerS ▸ hx
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hx'
    rw [LinearMap.comp_apply, KaehlerDifferential.kerCotangentToTensor_toCotangent]
    show l ((1 : S) ⊗ₜ[R] KaehlerDifferential.D B R (r * h)) = _
    rw [hDrh, hl]
    rfl

  set v : TensorProduct R S Ω[R⁄B] := 1 ⊗ₜ[R] KaehlerDifferential.D B R h with hv
  set M := KaehlerDifferential.mapBaseChange B R S with hM
  have hMv : M v = 0 := by
    rw [hM, hv, KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D,
      hh0, map_zero]
  have hexact := KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange B R S hsurj
  have hkerM : ∀ x, M x = 0 → ∃ s : S, x = s • v := by
    intro x hx
    obtain ⟨ξ, rfl⟩ := (hexact x).mp hx
    obtain ⟨⟨y, hy⟩, rfl⟩ := I.toCotangent_surjective ξ
    have hy' : y ∈ Ideal.span {h} := hkerS ▸ hy
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hy'
    refine ⟨algebraMap R S r, ?_⟩
    rw [KaehlerDifferential.kerCotangentToTensor_toCotangent]
    show (1 : S) ⊗ₜ[R] KaehlerDifferential.D B R (r * h) = _
    rw [hDrh, algebraMap_smul]
  set K := LinearMap.ker φ with hK
  let π : TensorProduct R S Ω[R⁄B] →ₗ[S] K :=
    LinearMap.codRestrict K (LinearMap.id - (LinearMap.smulRight φ v)) (fun x => by
      rw [hK, LinearMap.mem_ker, LinearMap.sub_apply, map_sub, LinearMap.id_apply,
        LinearMap.smulRight_apply, map_smul, hφ, smul_eq_mul, mul_one, sub_self])
  have hπ : ∀ x, (π x : TensorProduct R S Ω[R⁄B]) = x - φ x • v := fun x => rfl
  have hπK : π ∘ₗ K.subtype = LinearMap.id := by
    apply LinearMap.ext
    intro k
    apply Subtype.ext
    rw [LinearMap.comp_apply, hπ, Submodule.subtype_apply, LinearMap.id_apply,
      LinearMap.mem_ker.mp k.2, zero_smul, sub_zero]
  let T : K →ₗ[S] Ω[S⁄B] := M ∘ₗ K.subtype
  have hTinj : Function.Injective T := by
    have hk0 : ∀ k : K, T k = 0 → k = 0 := by
      intro k hk
      obtain ⟨s, hs⟩ := hkerM k hk
      have h1 : φ k = 0 := LinearMap.mem_ker.mp k.2
      rw [hs, map_smul, hφ, smul_eq_mul, mul_one] at h1
      apply Subtype.ext
      rw [hs, h1, zero_smul]
      rfl
    intro a b hab
    have := hk0 (a - b) (by rw [LinearMap.map_sub T a b, hab, sub_self])
    exact sub_eq_zero.mp this
  have hTsurj : Function.Surjective T := by
    intro y
    obtain ⟨x, rfl⟩ := KaehlerDifferential.mapBaseChange_surjective B R S hsurj y
    refine ⟨π x, ?_⟩
    show M (π x : TensorProduct R S Ω[R⁄B]) = M x
    rw [hπ, map_sub, map_smul, hMv, smul_zero, sub_zero]
  let eT : K ≃ₗ[S] Ω[S⁄B] := LinearEquiv.ofBijective T ⟨hTinj, hTsurj⟩
  have : Module.Projective S K := Module.Projective.of_split K.subtype π hπK
  have : Module.Finite S K := Module.Finite.of_surjective π (fun k =>
    ⟨k, LinearMap.congr_fun hπK k⟩)
  have : Module.Flat S K := inferInstance
  have : Module.Free S K := Module.free_of_flat_of_isLocalRing (R := S) (P := K)
  have : Module.Free S Ω[S⁄B] := Module.Free.of_equiv eT
  have : Module.Finite S Ω[S⁄B] := Module.Finite.equiv eT
  refine ⟨hfs, inferInstance, inferInstance, ?_⟩
  let Θ : TensorProduct R S Ω[R⁄B] ≃ₗ[S] S × K :=
    LinearEquiv.ofLinear (φ.prod π) ((LinearMap.smulRight (LinearMap.id) v).coprod K.subtype)
      (by
        apply LinearMap.ext
        rintro ⟨s, k⟩
        have hk : φ k = 0 := LinearMap.mem_ker.mp k.2
        simp only [LinearMap.comp_apply, LinearMap.coprod_apply, LinearMap.smulRight_apply,
          LinearMap.id_apply, Submodule.subtype_apply, LinearMap.prod_apply]
        refine Prod.ext ?_ ?_
        · simp [map_add, map_smul, hφ, hk]
        · apply Subtype.ext
          simp [hπ, map_add, map_smul, hφ, hk])
      (by
        apply LinearMap.ext
        intro x
        show φ x • v + ((π x : K) : TensorProduct R S Ω[R⁄B]) = x
        rw [hπ]
        abel)
  have : Nontrivial R := RingHom.domain_nontrivial (algebraMap R S)
  have : StrongRankCondition R := commRing_strongRankCondition R
  have e1 : Module.finrank S (TensorProduct R S Ω[R⁄B]) = Module.finrank R Ω[R⁄B] :=
    Module.finrank_baseChange
  have e2 : Module.finrank S (TensorProduct R S Ω[R⁄B]) = Module.finrank S (S × K) :=
    LinearEquiv.finrank_eq Θ
  have e3 : Module.finrank S (S × K) = 1 + Module.finrank S K := by
    rw [Module.finrank_prod, Module.finrank_self]
  have e4 : Module.finrank S K = Module.finrank S Ω[S⁄B] := LinearEquiv.finrank_eq eT
  omega

theorem wc_ldp_il_product_derivation (E : Type u) [Field E] {X T : Scheme.{u}}
    (pX : X ⟶ Spec (.of E)) (pT : T ⟶ Spec (.of E)) (w : ↥(Limits.pullback pX pT))
    (δ₀ : X.presheaf.stalk (Limits.pullback.fst pX pT w) →+
      IsLocalRing.ResidueField ((Limits.pullback pX pT).presheaf.stalk w))
    (hδ₀ : ∀ a b, δ₀ (a * b) =
      IsLocalRing.residue _ (((Limits.pullback.fst pX pT).stalkMap w).hom a) * δ₀ b +
      IsLocalRing.residue _ (((Limits.pullback.fst pX pT).stalkMap w).hom b) * δ₀ a)
    (hδ₀E : ∀ c : E, δ₀ (wcLdpConst E pX (Limits.pullback.fst pX pT w) c) = 0) :
    ∃ δ : (Limits.pullback pX pT).presheaf.stalk w →+
        IsLocalRing.ResidueField ((Limits.pullback pX pT).presheaf.stalk w),
      (∀ a b, δ (a * b) = IsLocalRing.residue _ a * δ b + IsLocalRing.residue _ b * δ a) ∧
      (∀ a, δ (((Limits.pullback.fst pX pT).stalkMap w).hom a) = δ₀ a) ∧
      (∀ c, δ (((Limits.pullback.snd pX pT).stalkMap w).hom c) = 0) :=
by
  classical

  have hU : ∀ {Y : Scheme.{u}} (y : Y) (R' : CommRingCat.{u}) [IsLocalRing R']
      (f g : Y.presheaf.stalk y ⟶ R'), IsLocalHom f.hom → IsLocalHom g.hom →
      Spec.map f ≫ Y.fromSpecStalk y = Spec.map g ≫ Y.fromSpecStalk y → f = g := by
    intro Y y R' _ f g hf hg h
    have h1 : (SpecToEquivOfLocalRing Y R').symm ⟨y, ⟨f, hf⟩⟩ =
        (SpecToEquivOfLocalRing Y R').symm ⟨y, ⟨g, hg⟩⟩ := by
      rw [SpecToEquivOfLocalRing_symm_apply, SpecToEquivOfLocalRing_symm_apply]
      exact h
    have h2 := (Sigma.mk.inj_iff.mp ((SpecToEquivOfLocalRing Y R').symm.injective h1)).2
    exact congrArg Subtype.val (eq_of_heq h2)

  have hF : ∀ {Y : Scheme.{u}} (R' : CommRingCat.{u}) [IsLocalRing R'] (f : Spec R' ⟶ Y) (y : Y),
      f (IsLocalRing.closedPoint R') = y →
      ∃ θ : Y.presheaf.stalk y ⟶ R', IsLocalHom θ.hom ∧ f = Spec.map θ ≫ Y.fromSpecStalk y := by
    intro Y R' _ f y hy
    subst hy
    exact ⟨_, Scheme.isLocalHom_stalkClosedPointTo f,
      (Scheme.Spec_stalkClosedPointTo_fromSpecStalk f).symm⟩

  have hdual : ∀ {A B : Type u} [CommRing A] [CommRing B] [IsLocalRing B] (σ : A →+* B)
      [IsLocalHom σ] (δ : A →+ IsLocalRing.ResidueField B),
      (∀ a b, δ (a * b) =
        IsLocalRing.residue B (σ a) * δ b + IsLocalRing.residue B (σ b) * δ a) →
      ∃ φ : A →+* DualNumber (IsLocalRing.ResidueField B), IsLocalHom φ ∧
        ∀ a, TrivSqZeroExt.fst (φ a) = IsLocalRing.residue B (σ a) ∧
          TrivSqZeroExt.snd (φ a) = δ a := by
    intro A B _ _ _ σ _ δ hδ
    have h1 : δ 1 = 0 := by
      have := hδ 1 1
      simp only [mul_one, map_one, one_mul] at this
      exact left_eq_add.mp this
    refine ⟨{ toFun := fun a => (show DualNumber (IsLocalRing.ResidueField B) from
                (IsLocalRing.residue B (σ a), δ a))
              map_one' := ?_
              map_mul' := ?_
              map_zero' := ?_
              map_add' := ?_ }, ?_, fun a => ⟨rfl, rfl⟩⟩
    · refine TrivSqZeroExt.ext ?_ ?_
      · show IsLocalRing.residue B (σ 1) = TrivSqZeroExt.fst 1
        simp
      · show δ 1 = TrivSqZeroExt.snd 1
        simp [h1]
    · intro a b
      refine TrivSqZeroExt.ext ?_ ?_
      · rw [TrivSqZeroExt.fst_mul]
        show IsLocalRing.residue B (σ (a * b)) =
          IsLocalRing.residue B (σ a) * IsLocalRing.residue B (σ b)
        simp
      · rw [DualNumber.snd_mul]
        show δ (a * b) = IsLocalRing.residue B (σ a) * δ b + δ a * IsLocalRing.residue B (σ b)
        rw [hδ]
        ring
    · refine TrivSqZeroExt.ext ?_ ?_
      · show IsLocalRing.residue B (σ 0) = TrivSqZeroExt.fst 0
        simp
      · show δ 0 = TrivSqZeroExt.snd 0
        simp
    · intro a b
      refine TrivSqZeroExt.ext ?_ ?_
      · rw [TrivSqZeroExt.fst_add]
        show IsLocalRing.residue B (σ (a + b)) =
          IsLocalRing.residue B (σ a) + IsLocalRing.residue B (σ b)
        simp
      · rw [TrivSqZeroExt.snd_add]
        show δ (a + b) = δ a + δ b
        simp
    · refine ⟨fun a ha => ?_⟩
      have h2 : IsUnit (IsLocalRing.residue B (σ a)) :=
        TrivSqZeroExt.isUnit_iff_isUnit_fst.mp ha
      exact isUnit_of_map_unit σ a (isUnit_of_map_unit (IsLocalRing.residue B) (σ a) h2)

  have hcc : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (s : B ⟶ Spec (.of E)) (y : A),
      wcLdpConst E (f ≫ s) y = (f.stalkMap y).hom.comp (wcLdpConst E s (f y)) := by
    intro A B f s y
    ext c
    simp only [wcLdpConst, RingHom.comp_apply, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
    exact (Scheme.Hom.germ_stalkMap_apply f ⊤ y trivial _).symm
  have hconst : ∀ {Y : Scheme.{u}} (s : Y ⟶ Spec (.of E)) (y : Y),
      Y.fromSpecStalk y ≫ s = Spec.map (CommRingCat.ofHom (wcLdpConst E s y)) := by
    intro Y s y
    calc Y.fromSpecStalk y ≫ s = Y.fromSpecStalk y ≫ s ≫ (Spec (.of E)).toSpecΓ ≫
          Spec.map (Scheme.ΓSpecIso (.of E)).inv := by
          rw [toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
      _ = Spec.map (Y.presheaf.germ ⊤ y trivial) ≫ Spec.map s.appTop ≫
          Spec.map (Scheme.ΓSpecIso (.of E)).inv := by
          rw [Scheme.toSpecΓ_naturality_assoc, Scheme.fromSpecStalk_toSpecΓ_assoc]
      _ = Spec.map (CommRingCat.ofHom (wcLdpConst E s y)) := by
          rw [← Spec.map_comp, ← Spec.map_comp]
          rfl
  have hEE : ∀ c : E, ((Limits.pullback.fst pX pT).stalkMap w).hom
        (wcLdpConst E pX (Limits.pullback.fst pX pT w) c) =
      ((Limits.pullback.snd pX pT).stalkMap w).hom
        (wcLdpConst E pT (Limits.pullback.snd pX pT w) c) := by
    intro c
    have h1 := congrArg (fun f => f c) (hcc (Limits.pullback.fst pX pT) pX w)
    have h2 := congrArg (fun f => f c) (hcc (Limits.pullback.snd pX pT) pT w)
    simp only [RingHom.comp_apply] at h1 h2
    rw [← h1, ← h2, Limits.pullback.condition]

  obtain ⟨φ₁r, hφ₁loc, hφ₁⟩ := hdual ((Limits.pullback.fst pX pT).stalkMap w).hom δ₀ hδ₀
  obtain ⟨φ₂r, hφ₂loc, hφ₂⟩ := hdual ((Limits.pullback.snd pX pT).stalkMap w).hom 0
    (fun a b => by simp)
  obtain ⟨q, hq⟩ : ∃ q : CommRingCat.of (DualNumber (IsLocalRing.ResidueField
      ((Limits.pullback pX pT).presheaf.stalk w))) ⟶ CommRingCat.of (IsLocalRing.ResidueField
      ((Limits.pullback pX pT).presheaf.stalk w)), ∀ z, q.hom z = TrivSqZeroExt.fst z :=
    ⟨CommRingCat.ofHom (TrivSqZeroExt.fstHom (IsLocalRing.ResidueField
      ((Limits.pullback pX pT).presheaf.stalk w)) (IsLocalRing.ResidueField
      ((Limits.pullback pX pT).presheaf.stalk w)) (IsLocalRing.ResidueField
      ((Limits.pullback pX pT).presheaf.stalk w))).toRingHom, fun z => rfl⟩
  haveI hqloc : IsLocalHom q.hom := ⟨fun z hz => by
    rw [hq] at hz
    exact TrivSqZeroExt.isUnit_iff_isUnit_fst.mpr hz⟩
  obtain ⟨ρc, hρc⟩ : ∃ ρc : (Limits.pullback pX pT).presheaf.stalk w ⟶
      CommRingCat.of (IsLocalRing.ResidueField ((Limits.pullback pX pT).presheaf.stalk w)),
      ρc = CommRingCat.ofHom (IsLocalRing.residue ↑((Limits.pullback pX pT).presheaf.stalk w)) :=
    ⟨_, rfl⟩
  haveI hρloc : IsLocalHom ρc.hom := by
    rw [hρc]
    exact (inferInstance : IsLocalHom
      (IsLocalRing.residue ↑((Limits.pullback pX pT).presheaf.stalk w)))
  obtain ⟨φ₁, hφ₁d⟩ : ∃ φ₁ : X.presheaf.stalk (Limits.pullback.fst pX pT w) ⟶
      CommRingCat.of (DualNumber (IsLocalRing.ResidueField
        ((Limits.pullback pX pT).presheaf.stalk w))), φ₁ = CommRingCat.ofHom φ₁r := ⟨_, rfl⟩
  obtain ⟨φ₂, hφ₂d⟩ : ∃ φ₂ : T.presheaf.stalk (Limits.pullback.snd pX pT w) ⟶
      CommRingCat.of (DualNumber (IsLocalRing.ResidueField
        ((Limits.pullback pX pT).presheaf.stalk w))), φ₂ = CommRingCat.ofHom φ₂r := ⟨_, rfl⟩
  have hφ₁a : ∀ a, φ₁.hom a = φ₁r a := fun a => by rw [hφ₁d]; rfl
  have hφ₂a : ∀ a, φ₂.hom a = φ₂r a := fun a => by rw [hφ₂d]; rfl
  haveI : IsLocalHom φ₁.hom := by rw [hφ₁d]; exact hφ₁loc
  haveI : IsLocalHom φ₂.hom := by rw [hφ₂d]; exact hφ₂loc
  have h₁ : φ₁ ≫ q = (Limits.pullback.fst pX pT).stalkMap w ≫ ρc := by
    ext a
    rw [CommRingCat.comp_apply, CommRingCat.comp_apply, hq, hφ₁a, (hφ₁ a).1, hρc]
    rfl
  have h₂ : φ₂ ≫ q = (Limits.pullback.snd pX pT).stalkMap w ≫ ρc := by
    ext a
    rw [CommRingCat.comp_apply, CommRingCat.comp_apply, hq, hφ₂a, (hφ₂ a).1, hρc]
    rfl
  have hc : (Spec.map φ₁ ≫ X.fromSpecStalk (Limits.pullback.fst pX pT w)) ≫ pX =
      (Spec.map φ₂ ≫ T.fromSpecStalk (Limits.pullback.snd pX pT w)) ≫ pT := by
    rw [Category.assoc, Category.assoc, hconst, hconst, ← Spec.map_comp, ← Spec.map_comp]
    congr 1
    refine CommRingCat.hom_ext (RingHom.ext fun c => ?_)
    rw [CommRingCat.hom_comp, CommRingCat.hom_comp, RingHom.comp_apply, RingHom.comp_apply,
      hφ₁a, hφ₂a]
    refine TrivSqZeroExt.ext ?_ ?_
    · rw [(hφ₁ _).1, (hφ₂ _).1]
      exact congrArg _ (hEE c)
    · rw [(hφ₁ _).2, (hφ₂ _).2]
      exact hδ₀E c

  obtain ⟨L, hL1, hL2⟩ : ∃ L : Spec (CommRingCat.of (DualNumber (IsLocalRing.ResidueField
      ((Limits.pullback pX pT).presheaf.stalk w)))) ⟶ Limits.pullback pX pT,
      L ≫ Limits.pullback.fst pX pT = Spec.map φ₁ ≫ X.fromSpecStalk (Limits.pullback.fst pX pT w) ∧
      L ≫ Limits.pullback.snd pX pT = Spec.map φ₂ ≫ T.fromSpecStalk (Limits.pullback.snd pX pT w) :=
    ⟨Limits.pullback.lift _ _ hc, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hstep2 : Spec.map q ≫ L = Spec.map ρc ≫ (Limits.pullback pX pT).fromSpecStalk w := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, hL1, ← Scheme.SpecMap_stalkMap_fromSpecStalk,
        ← Category.assoc, ← Category.assoc, ← Spec.map_comp, ← Spec.map_comp, h₁]
    · rw [Category.assoc, Category.assoc, hL2, ← Scheme.SpecMap_stalkMap_fromSpecStalk,
        ← Category.assoc, ← Category.assoc, ← Spec.map_comp, ← Spec.map_comp, h₂]
  have hcp : ∀ {R S : CommRingCat.{u}} [IsLocalRing R] [IsLocalRing S] {Y : Scheme.{u}}
      (f : R ⟶ S) [IsLocalHom f.hom] (g : Spec R ⟶ Y),
      (Spec.map f ≫ g) (IsLocalRing.closedPoint S) = g (IsLocalRing.closedPoint R) := by
    intro R S _ _ Y f _ g
    exact congrArg g (Spec_closedPoint (f := f))
  obtain ⟨θ, hθloc, hL⟩ := hF _ L w (by
    have e1 := hcp q L
    rw [hstep2, hcp ρc, Scheme.fromSpecStalk_closedPoint] at e1
    exact e1.symm)
  haveI := hθloc
  have Hθ₁ : (Limits.pullback.fst pX pT).stalkMap w ≫ θ = φ₁ := by
    haveI : IsLocalHom ((Limits.pullback.fst pX pT).stalkMap w ≫ θ).hom := by
      rw [CommRingCat.hom_comp]; infer_instance
    refine hU _ _ _ _ inferInstance inferInstance ?_
    rw [Spec.map_comp, Category.assoc, Scheme.SpecMap_stalkMap_fromSpecStalk, ← Category.assoc,
      ← hL, hL1]
  have Hθ₂ : (Limits.pullback.snd pX pT).stalkMap w ≫ θ = φ₂ := by
    haveI : IsLocalHom ((Limits.pullback.snd pX pT).stalkMap w ≫ θ).hom := by
      rw [CommRingCat.hom_comp]; infer_instance
    refine hU _ _ _ _ inferInstance inferInstance ?_
    rw [Spec.map_comp, Category.assoc, Scheme.SpecMap_stalkMap_fromSpecStalk, ← Category.assoc,
      ← hL, hL2]
  have Hθq : θ ≫ q = ρc := by
    haveI : IsLocalHom (θ ≫ q).hom := by
      rw [CommRingCat.hom_comp]; infer_instance
    refine hU _ _ _ _ inferInstance inferInstance ?_
    rw [Spec.map_comp, Category.assoc, ← hL, hstep2]
  have hfst : ∀ r, TrivSqZeroExt.fst (θ.hom r) = IsLocalRing.residue _ r := by
    intro r
    have := congrArg (fun g => g.hom r) Hθq
    simp only at this
    rw [CommRingCat.hom_comp, RingHom.comp_apply, hq] at this
    rw [this, hρc]
    rfl
  refine ⟨{ toFun := fun r => TrivSqZeroExt.snd (θ.hom r)
            map_zero' := by simp
            map_add' := by intro a b; simp }, ?_, ?_, ?_⟩
  · intro a b
    show TrivSqZeroExt.snd (θ.hom (a * b)) = IsLocalRing.residue _ a * TrivSqZeroExt.snd (θ.hom b) +
      IsLocalRing.residue _ b * TrivSqZeroExt.snd (θ.hom a)
    rw [map_mul, DualNumber.snd_mul, hfst, hfst]
    ring
  · intro a
    show TrivSqZeroExt.snd (θ.hom (((Limits.pullback.fst pX pT).stalkMap w).hom a)) = δ₀ a
    have := congrArg (fun g => g.hom a) Hθ₁
    simp only at this
    rw [CommRingCat.hom_comp, RingHom.comp_apply] at this
    rw [this, hφ₁a, (hφ₁ a).2]
  · intro c
    show TrivSqZeroExt.snd (θ.hom (((Limits.pullback.snd pX pT).stalkMap w).hom c)) = 0
    have := congrArg (fun g => g.hom c) Hθ₂
    simp only at this
    rw [CommRingCat.hom_comp, RingHom.comp_apply] at this
    rw [this, hφ₂a, (hφ₂ c).2]
    rfl

theorem wc_ldp_il_axis_derivation (E O : Type u) [Field E] [CommRing O] [IsLocalRing O]
    [IsNoetherianRing O] [Algebra E O] [Algebra.FormallySmooth E O]
    [Algebra.FormallySmooth E (IsLocalRing.ResidueField O)]
    (g₀ g₁ : O) (k : ℕ) (t : Fin k → O)
    (hm : IsLocalRing.maximalIdeal O = Ideal.span (insert g₀ (insert g₁ (Set.range t))))
    (hdim : ((k + 2 : ℕ) : WithBot ℕ∞) = ringKrullDim O) :
    ∃ δ₀ : O →+ IsLocalRing.ResidueField O,
      (∀ a b, δ₀ (a * b) = IsLocalRing.residue O a * δ₀ b + IsLocalRing.residue O b * δ₀ a) ∧
      (∀ c : E, δ₀ (algebraMap E O c) = 0) ∧ δ₀ g₀ = 1 ∧ δ₀ g₁ = 0 :=
by
  classical
  have hg0m : g₀ ∈ IsLocalRing.maximalIdeal O := by
    rw [hm]; exact Ideal.subset_span (Set.mem_insert _ _)
  have hg1m : g₁ ∈ IsLocalRing.maximalIdeal O := by
    rw [hm]; exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert _ _))
  have htm : ∀ j, t j ∈ IsLocalRing.maximalIdeal O := by
    intro j
    rw [hm]
    exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ ⟨j, rfl⟩))

  have s1 : ∀ β : O, g₀ - β * g₁ ∉ IsLocalRing.maximalIdeal O ^ 2 := by
    intro β hw
    set N : Ideal O := Ideal.span (insert g₁ (Set.range t)) with hN
    have hg1N : g₁ ∈ N := Ideal.subset_span (Set.mem_insert _ _)
    have hle0 : Ideal.span (insert g₀ (insert g₁ (Set.range t))) ≤
        N ⊔ IsLocalRing.maximalIdeal O • IsLocalRing.maximalIdeal O := by
      rw [Ideal.span_le]
      intro x hx
      rcases hx with rfl | hx
      · have e : x = (x - β * g₁) + β * g₁ := by ring
        rw [e]
        refine add_mem (Submodule.mem_sup_right ?_) (Submodule.mem_sup_left ?_)
        · rw [Ideal.smul_eq_mul, ← pow_two]; exact hw
        · exact Ideal.mul_mem_left _ _ hg1N
      · exact Submodule.mem_sup_left (Ideal.subset_span hx)
    rw [← hm] at hle0
    have hmN : IsLocalRing.maximalIdeal O ≤ N :=
      Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian _)
        (IsLocalRing.maximalIdeal_le_jacobson ⊥) hle0
    have hNm : N ≤ IsLocalRing.maximalIdeal O := by
      rw [Ideal.span_le]
      intro x hx
      rcases hx with rfl | ⟨j, rfl⟩
      · exact hg1m
      · exact htm j
    have hmeq : IsLocalRing.maximalIdeal O = N := le_antisymm hmN hNm
    set s : Finset O := insert g₁ (Finset.univ.image t) with hs
    have hsN : Ideal.span (s : Set O) = IsLocalRing.maximalIdeal O := by
      rw [hmeq, hN, hs, Finset.coe_insert, Finset.coe_image, Finset.coe_univ, Set.image_univ]
    have hmin : IsLocalRing.maximalIdeal O ∈ (Ideal.span (s : Set O)).minimalPrimes := by
      rw [hsN, Ideal.minimalPrimes_eq_subsingleton_self]
      rfl
    have hh := Ideal.height_le_card_of_mem_minimalPrimes_span_finset hmin
    have hcard : s.card ≤ k + 1 := by
      calc s.card ≤ (Finset.univ.image t).card + 1 := Finset.card_insert_le _ _
        _ ≤ (Finset.univ : Finset (Fin k)).card + 1 := by
          gcongr; exact Finset.card_image_le
        _ = k + 1 := by rw [Finset.card_univ, Fintype.card_fin]
    have hht := IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := O)
    rw [← hdim] at hht
    have h2 : (IsLocalRing.maximalIdeal O).height = ((k + 2 : ℕ) : ℕ∞) := by
      have e : ((k + 2 : ℕ) : WithBot ℕ∞) = (((k + 2 : ℕ) : ℕ∞) : WithBot ℕ∞) := by simp
      rw [e] at hht
      exact WithBot.coe_injective hht
    rw [h2] at hh
    have h3 : k + 2 ≤ s.card := by exact_mod_cast hh
    omega

  have s2 : ∀ w : O, w ∈ IsLocalRing.maximalIdeal O →
      TensorProduct.tmul O (1 : IsLocalRing.ResidueField O) (KaehlerDifferential.D E O w) = 0 →
      w ∈ IsLocalRing.maximalIdeal O ^ 2 := by
    intro w hw h0
    have hsurj : Function.Surjective (algebraMap O (IsLocalRing.ResidueField O)) := by
      rw [IsLocalRing.ResidueField.algebraMap_eq]; exact IsLocalRing.residue_surjective
    obtain ⟨l, hl⟩ := (Algebra.FormallySmooth.iff_split_injection (R := E) (P := O)
      (A := IsLocalRing.ResidueField O) hsurj).mp inferInstance
    have hJ : RingHom.ker (algebraMap O (IsLocalRing.ResidueField O)) =
        IsLocalRing.maximalIdeal O := by
      rw [IsLocalRing.ResidueField.algebraMap_eq]; exact IsLocalRing.ker_residue
    have hwJ : w ∈ RingHom.ker (algebraMap O (IsLocalRing.ResidueField O)) := hJ ▸ hw
    have e1 := LinearMap.congr_fun hl
      ((RingHom.ker (algebraMap O (IsLocalRing.ResidueField O))).toCotangent ⟨w, hwJ⟩)
    rw [LinearMap.comp_apply, KaehlerDifferential.kerCotangentToTensor_toCotangent,
      LinearMap.id_apply] at e1
    have e2 : (RingHom.ker (algebraMap O (IsLocalRing.ResidueField O))).toCotangent
        ⟨w, hwJ⟩ = 0 := by
      rw [← e1]
      have h0' : TensorProduct.tmul O (1 : IsLocalRing.ResidueField O)
          (KaehlerDifferential.D E O ((⟨w, hwJ⟩ : RingHom.ker (algebraMap O
            (IsLocalRing.ResidueField O))) : O)) = 0 := h0
      rw [h0', map_zero]
    have h3 : w ∈ RingHom.ker (algebraMap O (IsLocalRing.ResidueField O)) ^ 2 :=
      (Ideal.toCotangent_eq_zero _ _).mp e2
    rw [hJ] at h3
    exact h3

  have hsm : ∀ (r : O) (ω : Ω[O⁄E]),
      TensorProduct.tmul O (1 : IsLocalRing.ResidueField O) (r • ω) =
      (IsLocalRing.residue O r) • TensorProduct.tmul O (1 : IsLocalRing.ResidueField O) ω := by
    intro r ω
    rw [← TensorProduct.smul_tmul, TensorProduct.smul_tmul', Algebra.smul_def, smul_eq_mul,
      IsLocalRing.ResidueField.algebraMap_eq]

  have s3 : TensorProduct.tmul O (1 : IsLocalRing.ResidueField O) (KaehlerDifferential.D E O g₀) ∉
      Submodule.span (IsLocalRing.ResidueField O)
        {TensorProduct.tmul O (1 : IsLocalRing.ResidueField O) (KaehlerDifferential.D E O g₁)} := by
    intro hv
    obtain ⟨b, hb⟩ := Submodule.mem_span_singleton.mp hv
    obtain ⟨β, rfl⟩ := IsLocalRing.residue_surjective b
    apply s1 β
    apply s2
    · exact sub_mem hg0m (Ideal.mul_mem_left _ _ hg1m)
    · rw [map_sub, Derivation.leibniz, TensorProduct.tmul_sub, TensorProduct.tmul_add, hsm, hsm,
        (IsLocalRing.residue_eq_zero_iff g₁).mpr hg1m, zero_smul, add_zero, hb, sub_self]

  obtain ⟨f, hf0, hfp⟩ := Submodule.exists_dual_map_eq_bot_of_notMem s3 inferInstance
  have hf1 : f (TensorProduct.tmul O (1 : IsLocalRing.ResidueField O)
      (KaehlerDifferential.D E O g₁)) = 0 := by
    have h1 := Submodule.mem_map_of_mem (f := f) (Submodule.mem_span_singleton_self
      (TensorProduct.tmul O (1 : IsLocalRing.ResidueField O) (KaehlerDifferential.D E O g₁)))
    rw [hfp] at h1
    exact (Submodule.mem_bot _).mp h1

  let T : O →+ TensorProduct O (IsLocalRing.ResidueField O) Ω[O⁄E] :=
    { toFun := fun r => TensorProduct.tmul O (1 : IsLocalRing.ResidueField O)
        (KaehlerDifferential.D E O r)
      map_zero' := by simp
      map_add' := fun a b => by simp [TensorProduct.tmul_add] }
  refine ⟨(AddMonoidHom.mulLeft
    (f (TensorProduct.tmul O (1 : IsLocalRing.ResidueField O)
      (KaehlerDifferential.D E O g₀)))⁻¹).comp (f.toAddMonoidHom.comp T), ?_, ?_, ?_, ?_⟩
  · intro a b
    show (f (TensorProduct.tmul O (1 : IsLocalRing.ResidueField O)
          (KaehlerDifferential.D E O g₀)))⁻¹ *
        f (TensorProduct.tmul O (1 : IsLocalRing.ResidueField O)
          (KaehlerDifferential.D E O (a * b))) =
      IsLocalRing.residue O a *
        ((f (TensorProduct.tmul O (1 : IsLocalRing.ResidueField O)
          (KaehlerDifferential.D E O g₀)))⁻¹ *
          f (TensorProduct.tmul O (1 : IsLocalRing.ResidueField O)
            (KaehlerDifferential.D E O b))) +
      IsLocalRing.residue O b *
        ((f (TensorProduct.tmul O (1 : IsLocalRing.ResidueField O)
          (KaehlerDifferential.D E O g₀)))⁻¹ *
          f (TensorProduct.tmul O (1 : IsLocalRing.ResidueField O)
            (KaehlerDifferential.D E O a)))
    rw [Derivation.leibniz, TensorProduct.tmul_add, hsm, hsm, map_add, map_smul, map_smul,
      smul_eq_mul, smul_eq_mul]
    ring
  · intro c
    show (f (TensorProduct.tmul O (1 : IsLocalRing.ResidueField O)
          (KaehlerDifferential.D E O g₀)))⁻¹ *
        f (TensorProduct.tmul O (1 : IsLocalRing.ResidueField O)
          (KaehlerDifferential.D E O (algebraMap E O c))) = 0
    rw [Derivation.map_algebraMap, TensorProduct.tmul_zero, map_zero, mul_zero]
  · show (f (TensorProduct.tmul O (1 : IsLocalRing.ResidueField O)
          (KaehlerDifferential.D E O g₀)))⁻¹ *
        f (TensorProduct.tmul O (1 : IsLocalRing.ResidueField O)
          (KaehlerDifferential.D E O g₀)) = 1
    exact inv_mul_cancel₀ hf0
  · show (f (TensorProduct.tmul O (1 : IsLocalRing.ResidueField O)
          (KaehlerDifferential.D E O g₀)))⁻¹ *
        f (TensorProduct.tmul O (1 : IsLocalRing.ResidueField O)
          (KaehlerDifferential.D E O g₁)) = 0
    rw [hf1, mul_zero]

theorem wc_ldp_il_spread_abs (E : Type u) [Field E] {Z : Scheme.{u}} (s : Z ⟶ Spec (.of E))
    [LocallyOfFiniteType s] (n : ℕ) (z : Z)
    (hfs : letI := (wcLdpConst E s z).toAlgebra; Algebra.FormallySmooth E (Z.presheaf.stalk z))
    (hfree : letI := (wcLdpConst E s z).toAlgebra; Module.Free (Z.presheaf.stalk z) (Ω[Z.presheaf.stalk z⁄E]))
    (hfin : letI := (wcLdpConst E s z).toAlgebra; Module.Finite (Z.presheaf.stalk z) (Ω[Z.presheaf.stalk z⁄E]))
    (hrk : letI := (wcLdpConst E s z).toAlgebra; Module.finrank (Z.presheaf.stalk z) (Ω[Z.presheaf.stalk z⁄E]) = n) :
    ∃ U : Z.Opens, z ∈ U ∧ SmoothOfRelativeDimension n (U.ι ≫ s) :=
by
  classical


  have alg : ∀ (C O : Type u) [CommRing C] [CommRing O] [IsLocalRing O] [Algebra C O]
      (R : Type u) [CommRing R] (ε : E ≃+* R) (φ : R →+* C) (_hφ : φ.FiniteType)
      (q : Ideal C) [q.IsPrime] [IsLocalization.AtPrime O q]
      (g : E →+* O), g = (algebraMap C O).comp (φ.comp ε.toRingHom) →
      (letI := g.toAlgebra; Algebra.FormallySmooth E O) →
      (letI := g.toAlgebra; Module.finrank O Ω[O⁄E] = n) →
      ∃ b : C, b ∉ q ∧ (letI := φ.toAlgebra;
        Algebra.IsStandardSmoothOfRelativeDimension n R (Localization.Away b)) := by
    intro C O _ _ _ _ R _ ε φ hφ q _ _ g hg hfsO hrkO
    subst hg
    letI : Algebra E C := (φ.comp ε.toRingHom).toAlgebra
    letI : Algebra E O := ((algebraMap C O).comp (φ.comp ε.toRingHom)).toAlgebra
    haveI : IsScalarTower E C O := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Algebra.FormallySmooth E O := hfsO
    have hrkO' : Module.finrank O Ω[O⁄E] = n := hrkO

    haveI : Algebra.FiniteType E C := by
      have h : (φ.comp ε.toRingHom).FiniteType :=
        hφ.comp (RingHom.FiniteType.of_surjective _ ε.surjective)
      exact h
    haveI : Algebra.FinitePresentation E C :=
      Algebra.FinitePresentation.of_finiteType.mp inferInstance

    have hsmq : Algebra.IsSmoothAt E q := by
      have e1 : O ≃ₐ[C] Localization.AtPrime q :=
        IsLocalization.algEquiv q.primeCompl O (Localization.AtPrime q)
      exact Algebra.FormallySmooth.of_equiv (e1.restrictScalars E)
    obtain ⟨b, hb, hstd⟩ :=
      @Algebra.IsSmoothAt.exists_notMem_isStandardSmooth E C _ _ _ _ q _ hsmq
    obtain ⟨ι, σ, hσ, hι, ⟨P⟩⟩ := hstd.out
    haveI hstdm : Algebra.IsStandardSmoothOfRelativeDimension P.dimension E
        (Localization.Away b) := ⟨⟨ι, σ, hσ, hι, P, rfl⟩⟩
    haveI := hstd

    have hle : Submonoid.powers b ≤ q.primeCompl := Submonoid.powers_le.mpr hb
    letI : Algebra (Localization.Away b) O :=
      IsLocalization.localizationAlgebraOfSubmonoidLe (Localization.Away b) O
        (Submonoid.powers b) q.primeCompl hle
    haveI : IsScalarTower C (Localization.Away b) O :=
      IsLocalization.localization_isScalarTower_of_submonoid_le (Localization.Away b) O _ _ hle
    haveI : IsLocalization (Submonoid.map (algebraMap C (Localization.Away b)) q.primeCompl) O :=
      IsLocalization.isLocalization_of_submonoid_le (Localization.Away b) O _ _ hle
    haveI : Algebra.FormallyEtale (Localization.Away b) O :=
      Algebra.FormallyEtale.of_isLocalization
        (Submonoid.map (algebraMap C (Localization.Away b)) q.primeCompl)
    haveI : IsScalarTower E (Localization.Away b) O := IsScalarTower.of_algebraMap_eq (fun x => by
      rw [IsScalarTower.algebraMap_apply E C (Localization.Away b) x,
        ← IsScalarTower.algebraMap_apply C (Localization.Away b) O]
      rfl)
    haveI : Nontrivial (Localization.Away b) :=
      RingHom.domain_nontrivial (algebraMap (Localization.Away b) O)
    haveI : Module.Free (Localization.Away b) Ω[Localization.Away b⁄E] :=
      Algebra.IsStandardSmooth.free_kaehlerDifferential
    have hrkL : Module.finrank (Localization.Away b) Ω[Localization.Away b⁄E] = P.dimension :=
      Module.finrank_eq_of_rank_eq
        (Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential P.dimension)
    obtain ⟨Φ, -⟩ : ∃ Φ : TensorProduct (Localization.Away b) O Ω[Localization.Away b⁄E] ≃ₗ[O]
        Ω[O⁄E], Φ = KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale E
          (Localization.Away b) O := ⟨_, rfl⟩
    have hdim : P.dimension = n := by
      rw [← hrkO', ← LinearEquiv.finrank_eq Φ, Module.finrank_baseChange, hrkL]
    have hstdn : Algebra.IsStandardSmoothOfRelativeDimension n E (Localization.Away b) :=
      hdim ▸ hstdm

    refine ⟨b, hb, ?_⟩
    letI algR : Algebra R C := φ.toAlgebra
    have h1 : RingHom.IsStandardSmoothOfRelativeDimension n (algebraMap E (Localization.Away b)) :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap n).mpr hstdn
    have h2 : RingHom.IsStandardSmoothOfRelativeDimension 0 (ε.symm : R →+* E) :=
      RingHom.IsStandardSmoothOfRelativeDimension.equiv ε.symm
    have h3 := h1.comp h2
    refine (RingHom.isStandardSmoothOfRelativeDimension_algebraMap n).mp ?_
    have h4 : algebraMap R (Localization.Away b) =
        (algebraMap E (Localization.Away b)).comp (ε.symm : R →+* E) := by
      ext x
      rw [RingHom.comp_apply, IsScalarTower.algebraMap_apply R C (Localization.Away b),
        IsScalarTower.algebraMap_apply E C (Localization.Away b)]
      show algebraMap C (Localization.Away b) (φ x) =
        algebraMap C (Localization.Away b) (φ (ε (ε.symm x)))
      rw [RingEquiv.apply_symm_apply]
    rw [h4]
    exact h3

  obtain ⟨V₀, hV₀mem, hzV₀, -⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens Z))
      (show z ∈ (⊤ : Z.Opens) from trivial)
  have hV₀ : IsAffineOpen V₀ := hV₀mem
  have e₀ : V₀ ≤ s ⁻¹ᵁ ⊤ := fun x _ => trivial
  have hU₀ : IsAffineOpen (⊤ : (Spec (CommRingCat.of E)).Opens) := isAffineOpen_top _
  have hφ : (s.appLE ⊤ V₀ e₀).hom.FiniteType :=
    HasRingHomProperty.appLE @LocallyOfFiniteType s inferInstance ⟨⊤, hU₀⟩ ⟨V₀, hV₀⟩ e₀
  letI : Algebra Γ(Z, V₀) (Z.presheaf.stalk z) :=
    TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨z, hzV₀⟩
  haveI : IsLocalization.AtPrime (Z.presheaf.stalk z) (hV₀.primeIdealOf ⟨z, hzV₀⟩).asIdeal :=
    hV₀.isLocalization_stalk ⟨z, hzV₀⟩
  have key : s.appTop ≫ Z.presheaf.germ ⊤ z trivial =
      s.appLE ⊤ V₀ e₀ ≫ Z.presheaf.germ V₀ z hzV₀ := by
    rw [Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
    rfl
  have hg : wcLdpConst E s z = (algebraMap Γ(Z, V₀) (Z.presheaf.stalk z)).comp
      ((s.appLE ⊤ V₀ e₀).hom.comp
        ((Scheme.ΓSpecIso (CommRingCat.of E)).symm.commRingCatIsoToRingEquiv).toRingHom) := by
    ext c
    exact congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom c)) key
  obtain ⟨b, hb, hstd⟩ := alg Γ(Z, V₀) (Z.presheaf.stalk z) Γ(Spec (CommRingCat.of E), ⊤)
    ((Scheme.ΓSpecIso (CommRingCat.of E)).symm.commRingCatIsoToRingEquiv)
    (s.appLE ⊤ V₀ e₀).hom hφ (hV₀.primeIdealOf ⟨z, hzV₀⟩).asIdeal (wcLdpConst E s z) hg hfs hrk

  have hD : IsAffineOpen (Z.basicOpen b) := hV₀.basicOpen b
  have hzD : z ∈ Z.basicOpen b := by
    have h2 : hV₀.primeIdealOf ⟨z, hzV₀⟩ ∈ hV₀.fromSpec ⁻¹ᵁ Z.basicOpen b := by
      rw [hV₀.fromSpec_preimage_basicOpen]
      exact hb
    have h3 : hV₀.fromSpec (hV₀.primeIdealOf ⟨z, hzV₀⟩) ∈ Z.basicOpen b := h2
    rw [hV₀.fromSpec_primeIdealOf] at h3
    exact h3
  have e' : Z.basicOpen b ≤ s ⁻¹ᵁ ⊤ := (Z.basicOpen_le b).trans e₀
  have hcomp : (s.appLE ⊤ (Z.basicOpen b) e').hom =
      (Z.presheaf.map (homOfLE (Z.basicOpen_le b)).op).hom.comp (s.appLE ⊤ V₀ e₀).hom := by
    rw [← Scheme.Hom.appLE_map s e₀ (homOfLE (Z.basicOpen_le b)).op]
    rfl
  have H : RingHom.IsStandardSmoothOfRelativeDimension n
      ((algebraMap Γ(Z, V₀) (Localization.Away b)).comp (s.appLE ⊤ V₀ e₀).hom) := by
    letI := (s.appLE ⊤ V₀ e₀).hom.toAlgebra
    have h := (RingHom.isStandardSmoothOfRelativeDimension_algebraMap n).mpr hstd
    have h2 : algebraMap Γ(Spec (CommRingCat.of E), ⊤) (Localization.Away b) =
        (algebraMap Γ(Z, V₀) (Localization.Away b)).comp (s.appLE ⊤ V₀ e₀).hom :=
      IsScalarTower.algebraMap_eq _ _ _
    rw [h2] at h
    exact h
  haveI hloc : IsLocalization.Away b Γ(Z, Z.basicOpen b) := hV₀.isLocalization_basicOpen b
  obtain ⟨εb, -⟩ : ∃ εb : Localization.Away b ≃ₐ[Γ(Z, V₀)] Γ(Z, Z.basicOpen b),
      εb = IsLocalization.algEquiv (Submonoid.powers b) (Localization.Away b)
        Γ(Z, Z.basicOpen b) := ⟨_, rfl⟩
  have hε : (εb.toRingEquiv.toRingHom).comp (algebraMap Γ(Z, V₀) (Localization.Away b)) =
      (Z.presheaf.map (homOfLE (Z.basicOpen_le b)).op).hom := by
    ext r
    exact εb.commutes r
  have hV'std := (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso n).1 _ εb.toRingEquiv H
  rw [← RingHom.comp_assoc, hε, ← hcomp] at hV'std

  have hIsoGen : ∀ {A B : Z.Opens} (h : A ≤ B), A = B → IsIso (Z.presheaf.map (homOfLE h).op) := by
    intro A B h hAB
    subst hAB
    have : homOfLE h = 𝟙 A := Subsingleton.elim _ _
    rw [this, op_id, CategoryTheory.Functor.map_id]
    infer_instance
  have hsm : SmoothOfRelativeDimension n ((Z.basicOpen b).ι ≫ s) := by
    rw [smoothOfRelativeDimension_iff]
    intro x
    haveI : IsAffine (Z.basicOpen b) := hD
    refine ⟨⊤, hU₀, ⊤, isAffineOpen_top _, trivial, fun _ _ => trivial, ?_⟩
    have e'' : (⊤ : (Z.basicOpen b).toScheme.Opens) ≤ (Z.basicOpen b).ι ⁻¹ᵁ (Z.basicOpen b) :=
      fun y _ => y.2
    obtain ⟨gι, hgι⟩ : ∃ gι, gι = Scheme.Hom.appLE (Z.basicOpen b).ι (Z.basicOpen b) ⊤ e'' :=
      ⟨_, rfl⟩
    have hgiso : IsIso gι := by
      rw [hgι, Scheme.Opens.ι_appLE]
      exact hIsoGen _ (Scheme.Opens.ι_image_top (Z.basicOpen b))
    rw [← Scheme.Hom.appLE_comp_appLE (Z.basicOpen b).ι s ⊤ (Z.basicOpen b) ⊤ e' e'', ← hgι,
      CommRingCat.hom_comp]
    have h0 : RingHom.IsStandardSmoothOfRelativeDimension 0 gι.hom :=
      RingHom.IsStandardSmoothOfRelativeDimension.equiv (asIso gι).commRingCatIsoToRingEquiv
    have h5 := h0.comp hV'std
    rwa [zero_add] at h5
  exact ⟨Z.basicOpen b, hzD, hsm⟩

theorem wc_ldp_il_axis_smooth (E : Type u) [Field E] [PerfectField E] (N n : ℕ)
    (X : Over (Spec (.of E))) [SmoothOfRelativeDimension n X.hom]
    (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr E N = X.hom)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
    (hP1 : ∀ (x : X.left) (a : Fin (N + 1)) (hx : x ∈ ι ⁻¹ᵁ wcSgD E N a),
      wcLdpOnAxis E N ι G₀ G₁ x →
      ∃ (k : ℕ) (t : Fin k → X.left.presheaf.stalk x),
        IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) =
          Ideal.span (insert (wcLdpGerm E N ι G₀ a x hx)
            (insert (wcLdpGerm E N ι G₁ a x hx) (Set.range t))) ∧
        ((k + 2 : ℕ) : WithBot ℕ∞) = ringKrullDim (X.left.presheaf.stalk x))
    (Yt : Over (Spec (.of E))) (g : Yt.left ⟶ Limits.pullback X.hom (wcProjKStr E 1))
    (hgc : IsClosedImmersion g)
    (hg : g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom = Yt.hom)
    (hloc : wcLdpIncLocal E N X ι G₀ G₁ Yt g)
    (z : Yt.left)
    (hz : wcLdpOnAxis E N ι G₀ G₁ ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) z)) :
    ∃ U : Yt.left.Opens, z ∈ U ∧ SmoothOfRelativeDimension n (U.ι ≫ Yt.hom) :=
by
  classical

  have hx : wcLdpOnAxis E N ι G₀ G₁ (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z)) := hz
  have hmemX : ι (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z)) ∈
      (⨆ a : Fin (N + 1), @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
        MvPolynomial.gradedAlgebra (MvPolynomial.X a)) := by
    rw [wc_pp_basicOpen_cover E N]; simp
  obtain ⟨a, ha0⟩ := TopologicalSpace.Opens.mem_iSup.mp hmemX
  have ha : Limits.pullback.fst X.hom (wcProjKStr E 1) (g z) ∈ ι ⁻¹ᵁ wcSgD E N a := ha0
  have hmemT : Limits.pullback.snd X.hom (wcProjKStr E 1) (g z) ∈
      (⨆ e : Fin (1 + 1), @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) E)
        MvPolynomial.gradedAlgebra (MvPolynomial.X e)) := by
    rw [wc_pp_basicOpen_cover E 1]; simp
  obtain ⟨e, he0⟩ := TopologicalSpace.Opens.mem_iSup.mp hmemT
  have he : Limits.pullback.snd X.hom (wcProjKStr E 1) (g z) ∈ wcSgD E 1 e := he0

  haveI : SmoothOfRelativeDimension n (Limits.pullback.snd X.hom (wcProjKStr E 1)) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension n)
      (IsPullback.of_hasPullback X.hom (wcProjKStr E 1)) inferInstance
  haveI : SmoothOfRelativeDimension 1 (wcProjKStr E 1) := wc_p1_smooth_reldim_one E
  haveI hPs : SmoothOfRelativeDimension (n + 1)
      (Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom) := by
    rw [Limits.pullback.condition]
    exact smoothOfRelativeDimension_comp n 1 _ _
  haveI : Smooth (Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom) :=
    SmoothOfRelativeDimension.smooth (n + 1) _
  haveI : LocallyOfFiniteType (Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom) :=
    inferInstance
  haveI : IsClosedImmersion g := hgc
  haveI hYlft : LocallyOfFiniteType Yt.hom := by
    rw [← hg]; infer_instance
  haveI : Smooth X.hom := SmoothOfRelativeDimension.smooth n X.hom
  haveI : IsLocallyNoetherian X.left := LocallyOfFiniteType.isLocallyNoetherian X.hom

  have hcc : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (s : B ⟶ Spec (.of E)) (y : A),
      wcLdpConst E (f ≫ s) y = (f.stalkMap y).hom.comp (wcLdpConst E s (f y)) := by
    intro A B f s y
    ext c
    simp only [wcLdpConst, RingHom.comp_apply, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
    exact (Scheme.Hom.germ_stalkMap_apply f ⊤ y trivial _).symm

  have htrans : ∀ {A B C : Type u} [CommRing A] [CommRing B] [IsLocalRing B] [CommRing C]
      [IsLocalRing C] (f : B →+* C) [IsLocalHom f] (ρ : A →+* B)
      (d : A →+ IsLocalRing.ResidueField B),
      (∀ a b, d (a * b) = IsLocalRing.residue B (ρ a) * d b + IsLocalRing.residue B (ρ b) * d a) →
      ∀ a b, ((IsLocalRing.ResidueField.map f).toAddMonoidHom.comp d) (a * b) =
        IsLocalRing.residue C (f (ρ a)) * ((IsLocalRing.ResidueField.map f).toAddMonoidHom.comp d) b +
        IsLocalRing.residue C (f (ρ b)) * ((IsLocalRing.ResidueField.map f).toAddMonoidHom.comp d) a := by
    intro A B C _ _ _ _ _ f _ ρ d hd a b
    show IsLocalRing.ResidueField.map f (d (a * b)) =
      IsLocalRing.residue C (f (ρ a)) * IsLocalRing.ResidueField.map f (d b) +
      IsLocalRing.residue C (f (ρ b)) * IsLocalRing.ResidueField.map f (d a)
    rw [hd, map_add, map_mul, map_mul, IsLocalRing.ResidueField.map_residue,
      IsLocalRing.ResidueField.map_residue]

  obtain ⟨hRfs, hRfree, hRfin, hRrk, -⟩ :=
    wc_ldp_il_stalk_of_smooth_field E (Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom)
      (n + 1) (g z)
  obtain ⟨hOfs, -, -, -, hOeft⟩ :=
    wc_ldp_il_stalk_of_smooth_field E X.hom n (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z))
  letI algO : Algebra E (X.left.presheaf.stalk (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z))) :=
    (wcLdpConst E X.hom (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z))).toAlgebra
  haveI := hOfs
  haveI := hOeft
  haveI : Algebra.EssFiniteType E (IsLocalRing.ResidueField
      (X.left.presheaf.stalk (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z)))) :=
    Algebra.EssFiniteType.of_surjective
      (IsScalarTower.toAlgHom E _ (IsLocalRing.ResidueField
        (X.left.presheaf.stalk (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z)))))
      IsLocalRing.residue_surjective
  haveI : Algebra.FormallySmooth E (IsLocalRing.ResidueField
      (X.left.presheaf.stalk (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z)))) :=
    Algebra.FormallySmooth.of_perfectField

  obtain ⟨δ₀, hδ₀L, hδ₀E, hδ₀1, hδ₀0⟩ : ∃ δ₀ :
      X.left.presheaf.stalk (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z)) →+
        IsLocalRing.ResidueField
          (X.left.presheaf.stalk (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z))),
      (∀ a b, δ₀ (a * b) = IsLocalRing.residue _ a * δ₀ b + IsLocalRing.residue _ b * δ₀ a) ∧
      (∀ c : E, δ₀ (algebraMap E _ c) = 0) ∧
      δ₀ (wcLdpGerm E N ι (![G₀, G₁] (e + 1)) a _ ha) = 1 ∧
      δ₀ (wcLdpGerm E N ι (![G₀, G₁] e) a _ ha) = 0 := by
    obtain ⟨k, t, hm, hdim⟩ := hP1 _ a ha hx
    obtain rfl | rfl : e = 0 ∨ e = 1 := by fin_cases e <;> simp
    · have hm' : IsLocalRing.maximalIdeal
          (X.left.presheaf.stalk (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z))) =
          Ideal.span (insert (wcLdpGerm E N ι G₁ a _ ha)
            (insert (wcLdpGerm E N ι G₀ a _ ha) (Set.range t))) := by
        rw [hm, Set.insert_comm]
      exact wc_ldp_il_axis_derivation E _ _ _ k t hm' hdim
    · exact wc_ldp_il_axis_derivation E _ _ _ k t hm hdim

  let δ₀' : X.left.presheaf.stalk (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z)) →+
      IsLocalRing.ResidueField ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.stalk (g z)) :=
    (IsLocalRing.ResidueField.map
      ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom).toAddMonoidHom.comp δ₀
  have hδ₀'L : ∀ a b, δ₀' (a * b) =
      IsLocalRing.residue _ (((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom a) *
        δ₀' b +
      IsLocalRing.residue _ (((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom b) *
        δ₀' a :=
    htrans ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom (RingHom.id _) δ₀ hδ₀L
  have hδ₀'E : ∀ c : E, δ₀' (wcLdpConst E X.hom
      (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z)) c) = 0 := fun c =>
    (congrArg (IsLocalRing.ResidueField.map
      ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom) (hδ₀E c)).trans
      (map_zero _)

  obtain ⟨δ, hδL, hδ1, hδ2⟩ :=
    wc_ldp_il_product_derivation E X.hom (wcProjKStr E 1) (g z) δ₀' hδ₀'L hδ₀'E
  have hδE : ∀ c : E, δ (wcLdpConst E (Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom)
      (g z) c) = 0 := by
    intro c
    rw [hcc, RingHom.comp_apply, hδ1]
    exact hδ₀'E c
  have hδh : δ (((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
          (wcLdpGerm E N ι (![G₀, G₁] (e + 1)) a _ ha) -
        ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
          (((wcProjK E 1).presheaf.germ (wcSgD E 1 e) _ he).hom (wcSgE E 1 e (e + 1))) *
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
          (wcLdpGerm E N ι (![G₀, G₁] e) a _ ha)) = 1 := by
    rw [map_sub, hδL, hδ1, hδ1, hδ2]
    have e1 : ∀ y, δ₀' y = IsLocalRing.ResidueField.map
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom (δ₀ y) := fun y => rfl
    rw [e1, e1, hδ₀1, hδ₀0, map_one, map_zero, mul_zero, mul_zero, add_zero, sub_zero]

  obtain ⟨hsurj, hkerg⟩ := hloc z a ha e he
  have hconstS : wcLdpConst E Yt.hom z = (g.stalkMap z).hom.comp
      (wcLdpConst E (Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom) (g z)) := by
    rw [← hg]; exact hcc g _ z
  letI algR : Algebra E ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.stalk (g z)) :=
    (wcLdpConst E (Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom) (g z)).toAlgebra
  letI algS : Algebra E (Yt.left.presheaf.stalk z) := (wcLdpConst E Yt.hom z).toAlgebra
  haveI := hRfs
  haveI := hRfree
  haveI := hRfin
  let ψ : (Limits.pullback X.hom (wcProjKStr E 1)).presheaf.stalk (g z) →ₐ[E]
      Yt.left.presheaf.stalk z :=
    { (g.stalkMap z).hom with
      commutes' := fun c => by
        show (g.stalkMap z).hom
            (wcLdpConst E (Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom) (g z) c) =
          wcLdpConst E Yt.hom z c
        rw [hconstS]; rfl }
  have hker' : RingHom.ker ψ = Ideal.span {((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
          (wcLdpGerm E N ι (![G₀, G₁] (e + 1)) a _ ha) -
        ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
          (((wcProjK E 1).presheaf.germ (wcSgD E 1 e) _ he).hom (wcSgE E 1 e (e + 1))) *
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
          (wcLdpGerm E N ι (![G₀, G₁] e) a _ ha)} := by
    rw [← hkerg]; ext r; rw [RingHom.mem_ker, RingHom.mem_ker]; rfl
  let δS : (Limits.pullback X.hom (wcProjKStr E 1)).presheaf.stalk (g z) →+
      IsLocalRing.ResidueField (Yt.left.presheaf.stalk z) :=
    (IsLocalRing.ResidueField.map (g.stalkMap z).hom).toAddMonoidHom.comp δ
  have hδSL : ∀ a b, δS (a * b) =
      IsLocalRing.residue _ (ψ a) * δS b + IsLocalRing.residue _ (ψ b) * δS a :=
    htrans (g.stalkMap z).hom (RingHom.id _) δ hδL
  have hδSE : ∀ c : E, δS (algebraMap E _ c) = 0 := fun c =>
    (congrArg (IsLocalRing.ResidueField.map (g.stalkMap z).hom) (hδE c)).trans (map_zero _)
  have hδSh : δS (((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
          (wcLdpGerm E N ι (![G₀, G₁] (e + 1)) a _ ha) -
        ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
          (((wcProjK E 1).presheaf.germ (wcSgD E 1 e) _ he).hom (wcSgE E 1 e (e + 1))) *
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
          (wcLdpGerm E N ι (![G₀, G₁] e) a _ ha)) ≠ 0 := by
    have e2 := (congrArg (IsLocalRing.ResidueField.map (g.stalkMap z).hom) hδh).trans (map_one _)
    exact e2.symm ▸ one_ne_zero
  obtain ⟨hSfs, hSfree, hSfin, hSrk⟩ :=
    wc_ldp_il_hypersurface_criterion E _ _ ψ hsurj _ hker' δS hδSL hδSE hδSh

  have hrk : Module.finrank (Yt.left.presheaf.stalk z) Ω[Yt.left.presheaf.stalk z⁄E] = n := by
    omega
  exact wc_ldp_il_spread_abs E Yt.hom n z hSfs hSfree hSfin hrk

theorem wc_ldp_il_stalk_of_smooth {Z T : Scheme.{u}} (φ : Z ⟶ T) (m : ℕ)
    [SmoothOfRelativeDimension m φ] (z : Z) :
    letI := (φ.stalkMap z).hom.toAlgebra
    Algebra.FormallySmooth (T.presheaf.stalk (φ z)) (Z.presheaf.stalk z) ∧
      Module.Free (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄T.presheaf.stalk (φ z)] ∧
      Module.Finite (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄T.presheaf.stalk (φ z)] ∧
      Module.finrank (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄T.presheaf.stalk (φ z)] = m :=
by

  have s1 : ∀ (A R L : Type u) [CommRing A] [CommRing R] [CommRing L] [Algebra A R]
      [Algebra R L] [Algebra A L] [IsScalarTower A R L] (M : Submonoid A) [IsLocalization M R],
      Function.Bijective (KaehlerDifferential.map A R L L) := by
    intro A R L _ _ _ _ _ _ _ M _
    haveI : Algebra.FormallyUnramified A R := Algebra.FormallyUnramified.of_isLocalization M
    haveI : Subsingleton Ω[R⁄A] := Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
    refine ⟨?_, KaehlerDifferential.map_surjective A R L⟩
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨y, rfl⟩ := (KaehlerDifferential.exact_mapBaseChange_map A R L x).mp hx
    have hsub : ∀ y : TensorProduct R L Ω[R⁄A], y = 0 := by
      intro y
      induction y using TensorProduct.induction_on with
      | zero => rfl
      | tmul l ω => rw [Subsingleton.elim ω 0, TensorProduct.tmul_zero]
      | add a b ha hb => rw [ha, hb, add_zero]
    rw [hsub y, map_zero]

  have s2 : ∀ (A C L : Type u) [CommRing A] [CommRing C] [CommRing L] [Algebra C L]
      (f : A →+* C) (_hf : RingHom.IsStandardSmoothOfRelativeDimension m f)
      (q : Ideal C) [q.IsPrime] [IsLocalization.AtPrime L q]
      (g : A →+* L), g = (algebraMap C L).comp f →
      letI := g.toAlgebra
      Algebra.FormallySmooth A L ∧ Module.Free L Ω[L⁄A] ∧ Module.Finite L Ω[L⁄A] ∧
        Module.finrank L Ω[L⁄A] = m := by
    intro A C L _ _ _ _ f hf q _ _ g hg
    subst hg
    letI : Algebra A C := f.toAlgebra
    letI : Algebra A L := ((algebraMap C L).comp f).toAlgebra
    haveI : IsScalarTower A C L := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Algebra.IsStandardSmoothOfRelativeDimension m A C :=
      RingHom.IsStandardSmoothOfRelativeDimension.toAlgebra m hf
    haveI : Algebra.IsStandardSmooth A C :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth m
    haveI : Algebra.FormallySmooth A C := inferInstance
    haveI : Algebra.FinitePresentation A C := Algebra.IsStandardSmooth.finitePresentation
    haveI : Algebra.FiniteType A C := Algebra.FiniteType.of_finitePresentation
    haveI : Algebra.EssFiniteType A C := Algebra.EssFiniteType.of_finiteType A C
    haveI : Module.Free C Ω[C⁄A] := Algebra.IsStandardSmooth.free_kaehlerDifferential
    haveI : Module.Finite C Ω[C⁄A] := KaehlerDifferential.finite A C
    haveI : Nontrivial C := by
      refine ⟨⟨0, 1, fun h => ?_⟩⟩
      apply (‹q.IsPrime›).ne_top
      rw [Ideal.eq_top_iff_one, ← h]
      exact q.zero_mem
    haveI : IsLocalRing L := IsLocalization.AtPrime.isLocalRing L q
    have hrkC : Module.finrank C Ω[C⁄A] = m :=
      Module.finrank_eq_of_rank_eq
        (Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential m)
    haveI : Algebra.FormallyEtale C L := Algebra.FormallyEtale.of_isLocalization q.primeCompl
    haveI : Algebra.FormallySmooth C L := Algebra.FormallySmooth.of_isLocalization q.primeCompl
    obtain ⟨Φ, -⟩ : ∃ Φ : TensorProduct C L Ω[C⁄A] ≃ₗ[L] Ω[L⁄A],
        Φ = KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale A C L := ⟨_, rfl⟩
    refine ⟨Algebra.FormallySmooth.comp A C L, Module.Free.of_equiv Φ, Module.Finite.equiv Φ,
      ?_⟩
    rw [← LinearEquiv.finrank_eq Φ, Module.finrank_baseChange, hrkC]

  obtain ⟨U, hU, V, hV, hz, e, hstd⟩ :=
    SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := m) (f := φ) z
  have hφz : φ z ∈ U := e hz
  letI : Algebra Γ(T, U) (T.presheaf.stalk (φ z)) :=
    TopCat.Presheaf.algebra_section_stalk T.presheaf ⟨φ z, hφz⟩
  haveI : IsLocalization.AtPrime (T.presheaf.stalk (φ z)) (hU.primeIdealOf ⟨φ z, hφz⟩).asIdeal :=
    hU.isLocalization_stalk ⟨φ z, hφz⟩
  letI : Algebra Γ(Z, V) (Z.presheaf.stalk z) :=
    TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨z, hz⟩
  haveI : IsLocalization.AtPrime (Z.presheaf.stalk z) (hV.primeIdealOf ⟨z, hz⟩).asIdeal :=
    hV.isLocalization_stalk ⟨z, hz⟩
  have key : φ.appLE U V e ≫ Z.presheaf.germ V z hz =
      T.presheaf.germ U (φ z) hφz ≫ φ.stalkMap z := by
    rw [Scheme.Hom.germ_stalkMap, Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
  have hg : (φ.stalkMap z).hom.comp (algebraMap Γ(T, U) (T.presheaf.stalk (φ z))) =
      (algebraMap Γ(Z, V) (Z.presheaf.stalk z)).comp (φ.appLE U V e).hom := by
    ext c
    exact congrArg (fun ψ => ψ.hom c) key.symm
  have H := s2 Γ(T, U) Γ(Z, V) (Z.presheaf.stalk z)
    (φ.appLE U V e).hom hstd (hV.primeIdealOf ⟨z, hz⟩).asIdeal _ hg
  letI : Algebra (T.presheaf.stalk (φ z)) (Z.presheaf.stalk z) := (φ.stalkMap z).hom.toAlgebra
  letI : Algebra Γ(T, U) (Z.presheaf.stalk z) :=
    ((φ.stalkMap z).hom.comp (algebraMap Γ(T, U) (T.presheaf.stalk (φ z)))).toAlgebra
  obtain ⟨hFS, hFree, hFin, hrk⟩ := H
  haveI : IsScalarTower Γ(T, U) (T.presheaf.stalk (φ z)) (Z.presheaf.stalk z) :=
    IsScalarTower.of_algebraMap_eq' rfl
  haveI : Algebra.FormallySmooth Γ(T, U) (Z.presheaf.stalk z) := hFS
  haveI : Module.Free (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄Γ(T, U)] := hFree
  haveI : Module.Finite (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄Γ(T, U)] := hFin
  obtain ⟨Φ, -⟩ : ∃ Φ : Ω[Z.presheaf.stalk z⁄Γ(T, U)] ≃ₗ[Z.presheaf.stalk z]
      Ω[Z.presheaf.stalk z⁄T.presheaf.stalk (φ z)],
      Φ = LinearEquiv.ofBijective (KaehlerDifferential.map Γ(T, U) (T.presheaf.stalk (φ z))
        (Z.presheaf.stalk z) (Z.presheaf.stalk z))
        (s1 Γ(T, U) (T.presheaf.stalk (φ z)) (Z.presheaf.stalk z)
          (hU.primeIdealOf ⟨φ z, hφz⟩).asIdeal.primeCompl) := ⟨_, rfl⟩
  exact ⟨Algebra.FormallySmooth.localization_base
      (hU.primeIdealOf ⟨φ z, hφz⟩).asIdeal.primeCompl,
    Module.Free.of_equiv Φ, Module.Finite.equiv Φ, (LinearEquiv.finrank_eq Φ).symm.trans hrk⟩

theorem wc_ldp_il_submersive_derivation : ∀ (E O : Type u) [Field E] [CommRing O] [IsLocalRing O] [Algebra E O] [Module.Free O Ω[O⁄E]] (g₀ g₁ : O) (hω : g₀ • KaehlerDifferential.D E O g₁ - g₁ • KaehlerDifferential.D E O g₀ ∉ (IsLocalRing.maximalIdeal O) • (⊤ : Submodule O Ω[O⁄E])), ∃ δ₀ : O →+ IsLocalRing.ResidueField O, (∀ a b, δ₀ (a * b) = IsLocalRing.residue O a * δ₀ b + IsLocalRing.residue O b * δ₀ a) ∧ (∀ c : E, δ₀ (algebraMap E O c) = 0) ∧ IsLocalRing.residue O g₀ * δ₀ g₁ - IsLocalRing.residue O g₁ * δ₀ g₀ = 1 :=
by
  intro E O _ _ _ _ _ g₀ g₁ hω
  classical
  obtain ⟨b, hb⟩ : ∃ b, b = Module.Free.chooseBasis O Ω[O⁄E] := ⟨_, rfl⟩
  obtain ⟨ω, hωdef⟩ : ∃ ω, ω = g₀ • KaehlerDifferential.D E O g₁ - g₁ • KaehlerDifferential.D E O g₀ :=
    ⟨_, rfl⟩
  rw [← hωdef] at hω
  have hex : ∃ i, b.repr ω i ∉ IsLocalRing.maximalIdeal O := by
    by_contra hcon
    push_neg at hcon
    apply hω
    rw [← b.linearCombination_repr ω, Finsupp.linearCombination_apply, Finsupp.sum]
    exact Submodule.sum_mem _ (fun j _ => Submodule.smul_mem_smul (hcon j) Submodule.mem_top)
  obtain ⟨i, hi⟩ := hex
  have hc : IsLocalRing.residue O (b.repr ω i) ≠ 0 := by
    rwa [Ne, IsLocalRing.residue_eq_zero_iff]
  obtain ⟨u, hu⟩ : ∃ u, u = (IsLocalRing.residue O (b.repr ω i))⁻¹ := ⟨_, rfl⟩
  obtain ⟨f, hf⟩ : ∃ f : O →+ IsLocalRing.ResidueField O, f = AddMonoidHom.mk'
      (fun a => u * IsLocalRing.residue O (b.coord i (KaehlerDifferential.D E O a)))
      (by intro a c; simp only [map_add, mul_add]) := ⟨_, rfl⟩
  have hfa : ∀ a, f a = u * IsLocalRing.residue O (b.coord i (KaehlerDifferential.D E O a)) := by
    intro a; rw [hf]; rfl
  refine ⟨f, ?_, ?_, ?_⟩
  · intro a c
    rw [hfa, hfa, hfa, Derivation.leibniz]
    simp only [map_add, map_smul, smul_eq_mul, map_mul]
    ring
  · intro c
    rw [hfa, Derivation.map_algebraMap, map_zero, map_zero, mul_zero]
  · rw [hfa, hfa]
    have h1 : g₀ * b.coord i (KaehlerDifferential.D E O g₁) -
        g₁ * b.coord i (KaehlerDifferential.D E O g₀) = b.repr ω i := by
      rw [← b.coord_apply i ω, hωdef, map_sub, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
    have h2 := congrArg (IsLocalRing.residue O) h1
    rw [map_sub, map_mul, map_mul] at h2
    calc _ = u * (IsLocalRing.residue O g₀ *
            IsLocalRing.residue O (b.coord i (KaehlerDifferential.D E O g₁)) -
          IsLocalRing.residue O g₁ *
            IsLocalRing.residue O (b.coord i (KaehlerDifferential.D E O g₀))) := by ring
      _ = 1 := by rw [h2, hu, inv_mul_cancel₀ hc]

theorem wc_ldp_il_spread_rel : ∀ {Z T : Scheme.{u}} (φ : Z ⟶ T) [LocallyOfFinitePresentation φ] (z : Z), (φ.stalkMap z).hom.FormallySmooth → ∃ U : Z.Opens, z ∈ U ∧ Smooth (U.ι ≫ φ) :=
by
  classical
  intro Z T φ _ z hφ

  obtain ⟨U₀, hU₀mem, hφzU₀, -⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens T))
      (show φ z ∈ (⊤ : T.Opens) from trivial)
  have hU₀ : IsAffineOpen U₀ := hU₀mem
  obtain ⟨V₀, hV₀mem, hzV₀, e₀⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens Z))
      (show z ∈ φ ⁻¹ᵁ U₀ from hφzU₀)
  have hV₀ : IsAffineOpen V₀ := hV₀mem

  letI iAC : Algebra Γ(T, U₀) Γ(Z, V₀) := (φ.appLE U₀ V₀ e₀).hom.toAlgebra
  haveI hFP : Algebra.FinitePresentation Γ(T, U₀) Γ(Z, V₀) :=
    LocallyOfFinitePresentation.finitePresentation_appLE φ hU₀ hV₀ e₀
  letI iCO : Algebra Γ(Z, V₀) (Z.presheaf.stalk z) :=
    TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨z, hzV₀⟩
  letI iAO : Algebra Γ(T, U₀) (Z.presheaf.stalk z) :=
    (φ.appLE U₀ V₀ e₀ ≫ Z.presheaf.germ V₀ z hzV₀).hom.toAlgebra
  haveI : IsScalarTower Γ(T, U₀) Γ(Z, V₀) (Z.presheaf.stalk z) :=
    IsScalarTower.of_algebraMap_eq (fun x => rfl)
  haveI : IsLocalization.AtPrime (Z.presheaf.stalk z) (hV₀.primeIdealOf ⟨z, hzV₀⟩).asIdeal :=
    hV₀.isLocalization_stalk ⟨z, hzV₀⟩

  letI iAP : Algebra Γ(T, U₀) (T.presheaf.stalk (φ z)) :=
    TopCat.Presheaf.algebra_section_stalk T.presheaf ⟨φ z, hφzU₀⟩
  haveI : IsLocalization.AtPrime (T.presheaf.stalk (φ z))
      (hU₀.primeIdealOf ⟨φ z, hφzU₀⟩).asIdeal :=
    hU₀.isLocalization_stalk ⟨φ z, hφzU₀⟩
  haveI : Algebra.FormallySmooth Γ(T, U₀) (T.presheaf.stalk (φ z)) :=
    Algebra.FormallySmooth.of_isLocalization (hU₀.primeIdealOf ⟨φ z, hφzU₀⟩).asIdeal.primeCompl
  letI iPO : Algebra (T.presheaf.stalk (φ z)) (Z.presheaf.stalk z) :=
    (φ.stalkMap z).hom.toAlgebra
  haveI : Algebra.FormallySmooth (T.presheaf.stalk (φ z)) (Z.presheaf.stalk z) := hφ
  have key : φ.appLE U₀ V₀ e₀ ≫ Z.presheaf.germ V₀ z hzV₀ =
      T.presheaf.germ U₀ (φ z) hφzU₀ ≫ φ.stalkMap z := by
    rw [Scheme.Hom.germ_stalkMap, Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
  haveI : IsScalarTower Γ(T, U₀) (T.presheaf.stalk (φ z)) (Z.presheaf.stalk z) :=
    IsScalarTower.of_algebraMap_eq (fun x => congrArg (fun f => f.hom x) key)
  haveI : Algebra.FormallySmooth Γ(T, U₀) (Z.presheaf.stalk z) :=
    Algebra.FormallySmooth.comp Γ(T, U₀) (T.presheaf.stalk (φ z)) (Z.presheaf.stalk z)

  have hsmq : Algebra.IsSmoothAt Γ(T, U₀) (hV₀.primeIdealOf ⟨z, hzV₀⟩).asIdeal := by
    have e1 : Z.presheaf.stalk z ≃ₐ[Γ(Z, V₀)]
        Localization.AtPrime (hV₀.primeIdealOf ⟨z, hzV₀⟩).asIdeal :=
      IsLocalization.algEquiv (hV₀.primeIdealOf ⟨z, hzV₀⟩).asIdeal.primeCompl _ _
    exact Algebra.FormallySmooth.of_equiv (e1.restrictScalars Γ(T, U₀))
  obtain ⟨b, hb, hstd⟩ :=
    @Algebra.IsSmoothAt.exists_notMem_isStandardSmooth Γ(T, U₀) Γ(Z, V₀) _ _ _ _
      (hV₀.primeIdealOf ⟨z, hzV₀⟩).asIdeal _ hsmq
  obtain ⟨ι, σ, hσ, hι, ⟨P⟩⟩ := hstd.out
  haveI hstdm : Algebra.IsStandardSmoothOfRelativeDimension P.dimension Γ(T, U₀)
      (Localization.Away b) := ⟨⟨ι, σ, hσ, hι, P, rfl⟩⟩

  have hD : IsAffineOpen (Z.basicOpen b) := hV₀.basicOpen b
  have hzD : z ∈ Z.basicOpen b := by
    have h2 : hV₀.primeIdealOf ⟨z, hzV₀⟩ ∈ hV₀.fromSpec ⁻¹ᵁ Z.basicOpen b := by
      rw [hV₀.fromSpec_preimage_basicOpen]
      exact hb
    have h3 : hV₀.fromSpec (hV₀.primeIdealOf ⟨z, hzV₀⟩) ∈ Z.basicOpen b := h2
    rw [hV₀.fromSpec_primeIdealOf] at h3
    exact h3
  have e' : Z.basicOpen b ≤ φ ⁻¹ᵁ U₀ := (Z.basicOpen_le b).trans e₀
  have hcomp : (φ.appLE U₀ (Z.basicOpen b) e').hom =
      (Z.presheaf.map (homOfLE (Z.basicOpen_le b)).op).hom.comp (φ.appLE U₀ V₀ e₀).hom := by
    rw [← Scheme.Hom.appLE_map φ e₀ (homOfLE (Z.basicOpen_le b)).op]
    rfl
  have H : RingHom.IsStandardSmoothOfRelativeDimension P.dimension
      ((algebraMap Γ(Z, V₀) (Localization.Away b)).comp (φ.appLE U₀ V₀ e₀).hom) := by
    have h := (RingHom.isStandardSmoothOfRelativeDimension_algebraMap P.dimension).mpr hstdm
    have h2 : algebraMap Γ(T, U₀) (Localization.Away b) =
        (algebraMap Γ(Z, V₀) (Localization.Away b)).comp (φ.appLE U₀ V₀ e₀).hom :=
      IsScalarTower.algebraMap_eq _ _ _
    rw [h2] at h
    exact h
  haveI hloc : IsLocalization.Away b Γ(Z, Z.basicOpen b) := hV₀.isLocalization_basicOpen b
  obtain ⟨εb, -⟩ : ∃ εb : Localization.Away b ≃ₐ[Γ(Z, V₀)] Γ(Z, Z.basicOpen b),
      εb = IsLocalization.algEquiv (Submonoid.powers b) (Localization.Away b)
        Γ(Z, Z.basicOpen b) := ⟨_, rfl⟩
  have hε : (εb.toRingEquiv.toRingHom).comp (algebraMap Γ(Z, V₀) (Localization.Away b)) =
      (Z.presheaf.map (homOfLE (Z.basicOpen_le b)).op).hom := by
    ext r
    exact εb.commutes r
  have hV'std :=
    (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso P.dimension).1 _ εb.toRingEquiv H
  rw [← RingHom.comp_assoc, hε, ← hcomp] at hV'std
  have hIsoGen : ∀ {A B : Z.Opens} (h : A ≤ B), A = B →
      IsIso (Z.presheaf.map (homOfLE h).op) := by
    intro A B h hAB
    subst hAB
    have : homOfLE h = 𝟙 A := Subsingleton.elim _ _
    rw [this, op_id, CategoryTheory.Functor.map_id]
    infer_instance
  have hsm : SmoothOfRelativeDimension P.dimension ((Z.basicOpen b).ι ≫ φ) := by
    rw [smoothOfRelativeDimension_iff]
    intro x
    haveI : IsAffine (Z.basicOpen b) := hD
    have e3 : (⊤ : (Z.basicOpen b).toScheme.Opens) ≤ ((Z.basicOpen b).ι ≫ φ) ⁻¹ᵁ U₀ :=
      fun y _ => e' y.2
    refine ⟨U₀, hU₀, ⊤, isAffineOpen_top _, trivial, e3, ?_⟩
    have e'' : (⊤ : (Z.basicOpen b).toScheme.Opens) ≤ (Z.basicOpen b).ι ⁻¹ᵁ (Z.basicOpen b) :=
      fun y _ => y.2
    obtain ⟨gι, hgι⟩ : ∃ gι, gι = Scheme.Hom.appLE (Z.basicOpen b).ι (Z.basicOpen b) ⊤ e'' :=
      ⟨_, rfl⟩
    have hgiso : IsIso gι := by
      rw [hgι, Scheme.Opens.ι_appLE]
      exact hIsoGen _ (Scheme.Opens.ι_image_top (Z.basicOpen b))
    rw [← Scheme.Hom.appLE_comp_appLE (Z.basicOpen b).ι φ U₀ (Z.basicOpen b) ⊤ e' e'', ← hgι,
      CommRingCat.hom_comp]
    have h0 : RingHom.IsStandardSmoothOfRelativeDimension 0 gι.hom :=
      RingHom.IsStandardSmoothOfRelativeDimension.equiv (asIso gι).commRingCatIsoToRingEquiv
    have h5 := h0.comp hV'std
    rwa [zero_add] at h5
  haveI := hsm
  exact ⟨Z.basicOpen b, hzD, SmoothOfRelativeDimension.smooth P.dimension _⟩

theorem wc_ldp_il_rel_smooth (E : Type u) [Field E] [PerfectField E] (N n : ℕ)
    (X : Over (Spec (.of E))) [SmoothOfRelativeDimension n X.hom]
    (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr E N = X.hom)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
    (hP1 : ∀ (x : X.left) (a : Fin (N + 1)) (hx : x ∈ ι ⁻¹ᵁ wcSgD E N a),
      wcLdpOnAxis E N ι G₀ G₁ x →
      ∃ (k : ℕ) (t : Fin k → X.left.presheaf.stalk x),
        IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) =
          Ideal.span (insert (wcLdpGerm E N ι G₀ a x hx)
            (insert (wcLdpGerm E N ι G₁ a x hx) (Set.range t))) ∧
        ((k + 2 : ℕ) : WithBot ℕ∞) = ringKrullDim (X.left.presheaf.stalk x))
    (Yt : Over (Spec (.of E))) (g : Yt.left ⟶ Limits.pullback X.hom (wcProjKStr E 1))
    (hgc : IsClosedImmersion g)
    (hg : g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom = Yt.hom)
    (hloc : wcLdpIncLocal E N X ι G₀ G₁ Yt g)
    (z : Yt.left)
    (hsub : ¬ wcLdpOnAxis E N ι G₀ G₁ ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) z) →
      ∀ (a : Fin (N + 1))
        (hx : (g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) z ∈ ι ⁻¹ᵁ wcSgD E N a),
        wcLdpSubmersive E X.hom ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) z)
          (wcLdpGerm E N ι G₀ a _ hx) (wcLdpGerm E N ι G₁ a _ hx)) :
    ∃ U : Yt.left.Opens, z ∈ U ∧
      Smooth (U.ι ≫ g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) :=
by
  classical
  have alg : ∀ {K : Type u} [CommRing K] (a b c d s : K), b - s * d = 0 → c - s * a = 0 →
      a * b - c * d = 0 := by
    intro K _ a b c d s h1 h2
    linear_combination a * h1 - d * h2
  have hcase : ∀ e' : Fin 2, (![G₀, G₁] (e' + 1) = G₁ ∧ ![G₀, G₁] e' = G₀) ∨
      (![G₀, G₁] (e' + 1) = G₀ ∧ ![G₀, G₁] e' = G₁) := by
    intro e'
    fin_cases e'
    · left; exact ⟨rfl, rfl⟩
    · right; exact ⟨rfl, rfl⟩
  haveI hπ₂ : SmoothOfRelativeDimension n (Limits.pullback.snd X.hom (wcProjKStr E 1)) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension n)
      (IsPullback.of_hasPullback X.hom (wcProjKStr E 1)) ‹_›
  haveI := hgc
  haveI : IsProper (wcProjKStr E 1) := wc_pp_proper E 1
  haveI : IsLocallyNoetherian (wcProjK E 1) :=
    LocallyOfFiniteType.isLocallyNoetherian (wcProjKStr E 1)
  haveI : Smooth (Limits.pullback.snd X.hom (wcProjKStr E 1)) :=
    SmoothOfRelativeDimension.smooth n _
  haveI : Smooth X.hom := SmoothOfRelativeDimension.smooth n _
  haveI : IsLocallyNoetherian X.left := LocallyOfFiniteType.isLocallyNoetherian X.hom

  obtain ⟨e, he⟩ : ∃ e : Fin 2,
      Limits.pullback.snd X.hom (wcProjKStr E 1) (g z) ∈ wcSgD E 1 e := by
    have hmem : Limits.pullback.snd X.hom (wcProjKStr E 1) (g z) ∈
        (⊤ : (wcProjK E 1).Opens) := trivial
    rw [← wc_pp_basicOpen_cover E 1] at hmem
    obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hmem
    exact ⟨i, hi⟩
  obtain ⟨a, ha⟩ : ∃ a : Fin (N + 1),
      Limits.pullback.fst X.hom (wcProjKStr E 1) (g z) ∈ ι ⁻¹ᵁ wcSgD E N a := by
    have hmem : ι (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z)) ∈
        (⊤ : (wcProjK E N).Opens) := trivial
    rw [← wc_pp_basicOpen_cover E N] at hmem
    obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hmem
    exact ⟨i, hi⟩

  obtain ⟨hsurj, hker⟩ := hloc z a ha e he
  obtain ⟨GA, GC, hGG, h, σ, hh, hker'⟩ : ∃ (GA GC : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2),
      ((GA = G₁ ∧ GC = G₀) ∨ (GA = G₀ ∧ GC = G₁)) ∧
      ∃ (h : (Limits.pullback X.hom (wcProjKStr E 1)).presheaf.stalk (g z))
        (σ : (wcProjK E 1).presheaf.stalk (Limits.pullback.snd X.hom (wcProjKStr E 1) (g z))),
        h = ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
              (wcLdpGerm E N ι GA a _ ha) -
            ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap (g z)).hom σ *
            ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
              (wcLdpGerm E N ι GC a _ ha) ∧
        RingHom.ker (g.stalkMap z).hom = Ideal.span {h} :=
    ⟨_, _, hcase e, _, _, rfl, hker⟩
  clear hker

  have build : ∀ δ₀ : X.left.presheaf.stalk (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z)) →+
        IsLocalRing.ResidueField
          (X.left.presheaf.stalk (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z))),
      (∀ a b, δ₀ (a * b) = IsLocalRing.residue _ a * δ₀ b + IsLocalRing.residue _ b * δ₀ a) →
      (∀ c : E, δ₀ (wcLdpConst E X.hom (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z)) c) = 0) →
      ∃ δR : (Limits.pullback X.hom (wcProjKStr E 1)).presheaf.stalk (g z) →+
          IsLocalRing.ResidueField ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.stalk (g z)),
        (∀ a b, δR (a * b) = IsLocalRing.residue _ a * δR b + IsLocalRing.residue _ b * δR a) ∧
        (∀ c, δR (((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap (g z)).hom c) = 0) ∧
        δR h = IsLocalRing.ResidueField.map
              ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
              (δ₀ (wcLdpGerm E N ι GA a _ ha)) -
          IsLocalRing.residue _
              (((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap (g z)).hom σ) *
            IsLocalRing.ResidueField.map
              ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
              (δ₀ (wcLdpGerm E N ι GC a _ ha)) := by
    intro δ₀ hδ₀ hδ₀E
    let δ₀' : X.left.presheaf.stalk (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z)) →+
        IsLocalRing.ResidueField ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.stalk (g z)) :=
      AddMonoidHom.mk' (fun r => IsLocalRing.ResidueField.map
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom (δ₀ r))
        (fun r s => by rw [map_add, map_add])
    obtain ⟨δR, hL, h1, h2⟩ := wc_ldp_il_product_derivation E X.hom (wcProjKStr E 1) (g z) δ₀'
      (by
        intro r s
        simp only [δ₀', AddMonoidHom.mk'_apply]
        rw [hδ₀, map_add, map_mul, map_mul, IsLocalRing.ResidueField.map_residue,
          IsLocalRing.ResidueField.map_residue])
      (by
        intro c
        simp only [δ₀', AddMonoidHom.mk'_apply]
        rw [hδ₀E, map_zero])
    refine ⟨δR, hL, h2, ?_⟩
    rw [hh, map_sub, hL, h1, h1, h2]
    simp only [δ₀', AddMonoidHom.mk'_apply, mul_zero, add_zero]

  have finish : ∀ δR : (Limits.pullback X.hom (wcProjKStr E 1)).presheaf.stalk (g z) →+
        IsLocalRing.ResidueField ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.stalk (g z)),
      (∀ a b, δR (a * b) = IsLocalRing.residue _ a * δR b + IsLocalRing.residue _ b * δR a) →
      (∀ c, δR (((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap (g z)).hom c) = 0) →
      δR h ≠ 0 →
      ∃ U : Yt.left.Opens, z ∈ U ∧
        Smooth (U.ι ≫ g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) := by
    intro δR hL hB hne
    letI iBR : Algebra
        ((wcProjK E 1).presheaf.stalk (Limits.pullback.snd X.hom (wcProjKStr E 1) (g z)))
        ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.stalk (g z)) :=
      ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap (g z)).hom.toAlgebra
    letI iBS : Algebra
        ((wcProjK E 1).presheaf.stalk (Limits.pullback.snd X.hom (wcProjKStr E 1) (g z)))
        (Yt.left.presheaf.stalk z) :=
      ((g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap z).hom.toAlgebra
    obtain ⟨hFS, hFree, hFin, -⟩ :=
      wc_ldp_il_stalk_of_smooth (Limits.pullback.snd X.hom (wcProjKStr E 1)) n (g z)
    haveI := hFS
    haveI := hFree
    haveI := hFin
    have hcomm : ∀ c, (g.stalkMap z).hom
        (((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap (g z)).hom c) =
        ((g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap z).hom c := by
      intro c
      rw [Scheme.Hom.stalkMap_comp]
      rfl
    let ψ : (Limits.pullback X.hom (wcProjKStr E 1)).presheaf.stalk (g z) →ₐ[
        (wcProjK E 1).presheaf.stalk (Limits.pullback.snd X.hom (wcProjKStr E 1) (g z))]
        Yt.left.presheaf.stalk z :=
      { (g.stalkMap z).hom with commutes' := fun c => hcomm c }
    have hj : Function.Injective (IsLocalRing.ResidueField.map (g.stalkMap z).hom) :=
      (IsLocalRing.ResidueField.map (g.stalkMap z).hom).injective
    let δ : (Limits.pullback X.hom (wcProjKStr E 1)).presheaf.stalk (g z) →+
        IsLocalRing.ResidueField (Yt.left.presheaf.stalk z) :=
      AddMonoidHom.mk' (fun r => IsLocalRing.ResidueField.map (g.stalkMap z).hom (δR r))
        (fun r s => by rw [map_add, map_add])
    have hS := wc_ldp_il_hypersurface_criterion _ _ _ ψ hsurj h hker' δ
      (by
        intro r s
        show IsLocalRing.ResidueField.map (g.stalkMap z).hom (δR (r * s)) = _
        rw [hL, map_add, map_mul, map_mul, IsLocalRing.ResidueField.map_residue,
          IsLocalRing.ResidueField.map_residue]
        rfl)
      (by
        intro c
        show IsLocalRing.ResidueField.map (g.stalkMap z).hom
          (δR (((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap (g z)).hom c)) = 0
        rw [hB, map_zero])
      (by
        intro h0
        apply hne
        apply hj
        rw [map_zero]
        exact h0)
    obtain ⟨U, hzU, hU⟩ :=
      wc_ldp_il_spread_rel (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) z hS.1
    exact ⟨U, hzU, hU⟩
  by_cases hax : wcLdpOnAxis E N ι G₀ G₁ (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z))
  ·
    obtain ⟨k, t, hm, hdim⟩ := hP1 _ a ha hax
    letI := (wcLdpConst E X.hom (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z))).toAlgebra
    obtain ⟨hFS, -, -, -, hEFT⟩ :=
      wc_ldp_il_stalk_of_smooth_field E X.hom n (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z))
    haveI := hFS
    haveI := hEFT
    haveI : Algebra.EssFiniteType E (IsLocalRing.ResidueField
        (X.left.presheaf.stalk (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z)))) :=
      Algebra.EssFiniteType.of_surjective (IsScalarTower.toAlgHom E _ _) (by
        intro y
        obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective y
        exact ⟨r, rfl⟩)
    haveI : Algebra.FormallySmooth E (IsLocalRing.ResidueField
        (X.left.presheaf.stalk (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z)))) :=
      Algebra.FormallySmooth.of_perfectField
    obtain ⟨δ₀, hδ₀, hδ₀E, hA, hC⟩ : ∃ δ₀ :
        X.left.presheaf.stalk (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z)) →+
          IsLocalRing.ResidueField
            (X.left.presheaf.stalk (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z))),
        (∀ a b, δ₀ (a * b) = IsLocalRing.residue _ a * δ₀ b + IsLocalRing.residue _ b * δ₀ a) ∧
        (∀ c : E, δ₀ (algebraMap E
          (X.left.presheaf.stalk (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z))) c) = 0) ∧
        δ₀ (wcLdpGerm E N ι GA a _ ha) = 1 ∧ δ₀ (wcLdpGerm E N ι GC a _ ha) = 0 := by
      rcases hGG with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · exact wc_ldp_il_axis_derivation E _ _ _ k t (by rw [hm, Set.insert_comm]) hdim
      · exact wc_ldp_il_axis_derivation E _ _ _ k t hm hdim
    obtain ⟨δR, hL, hB, hδh⟩ := build δ₀ hδ₀ hδ₀E
    refine finish δR hL hB ?_
    rw [hδh, hA, hC, map_one, map_zero, mul_zero, sub_zero]
    exact one_ne_zero
  ·
    letI := (wcLdpConst E X.hom (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z))).toAlgebra
    obtain ⟨-, hFree, -, -, -⟩ :=
      wc_ldp_il_stalk_of_smooth_field E X.hom n (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z))
    haveI := hFree
    have hω : wcLdpSubmersive E X.hom (Limits.pullback.fst X.hom (wcProjKStr E 1) (g z))
        (wcLdpGerm E N ι G₀ a _ ha) (wcLdpGerm E N ι G₁ a _ ha) := hsub hax a ha
    obtain ⟨δ₀, hδ₀, hδ₀E, hval⟩ := wc_ldp_il_submersive_derivation E _ _ _ hω
    obtain ⟨δR, hL, hB, hδh⟩ := build δ₀ hδ₀ hδ₀E
    refine finish δR hL hB ?_
    have hψh : (g.stalkMap z).hom h = 0 := by
      have hmem : h ∈ RingHom.ker (g.stalkMap z).hom := by
        rw [hker']
        exact Ideal.subset_span rfl
      exact hmem
    have hhm : IsLocalRing.residue _ h = 0 := by
      rw [IsLocalRing.residue_eq_zero_iff, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have hu' := hu.map (g.stalkMap z).hom
      rw [hψh] at hu'
      exact not_isUnit_zero hu'
    rw [hh, map_sub, map_mul] at hhm
    have hhm' : IsLocalRing.ResidueField.map
          ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
          (IsLocalRing.residue _ (wcLdpGerm E N ι GA a _ ha)) -
        IsLocalRing.residue _
          (((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap (g z)).hom σ) *
        IsLocalRing.ResidueField.map
          ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
          (IsLocalRing.residue _ (wcLdpGerm E N ι GC a _ ha)) = 0 := by
      rw [IsLocalRing.ResidueField.map_residue, IsLocalRing.ResidueField.map_residue]
      exact hhm
    intro h0
    rw [hδh] at h0
    have key : IsLocalRing.ResidueField.map
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
        (IsLocalRing.residue _ (wcLdpGerm E N ι GC a _ ha) * δ₀ (wcLdpGerm E N ι GA a _ ha) -
          IsLocalRing.residue _ (wcLdpGerm E N ι GA a _ ha) * δ₀ (wcLdpGerm E N ι GC a _ ha)) =
        0 := by
      rw [map_sub, map_mul, map_mul]
      exact alg _ _ _ _ _ h0 hhm'
    have key2 := (IsLocalRing.ResidueField.map
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom).injective
      (key.trans (map_zero _).symm)
    rcases hGG with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact one_ne_zero (hval.symm.trans key2)
    · exact one_ne_zero (hval.symm.trans (by linear_combination -key2))

theorem wc_ldp_il_sec_linear (E : Type u) [Field E] (N : ℕ)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) (a : Fin (N + 1)) (d₀ d₁ : E) :
    wcLdpSec E N (d₁ • G₀ - d₀ • G₁) a =
      (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) (MvPolynomial.X a)).hom
          (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
            (Submonoid.powers (MvPolynomial.X a))
            (algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 0) d₁)) *
        wcLdpSec E N G₀ a -
      (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) (MvPolynomial.X a)).hom
          (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
            (Submonoid.powers (MvPolynomial.X a))
            (algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 0) d₀)) *
        wcLdpSec E N G₁ a :=
by
  have key : ∀ (x y g h : MvPolynomial (Fin (N + 1)) E)
      (s : Submonoid.powers (MvPolynomial.X (R := E) a)),
      (Localization.mk (x * g - y * h) s : Localization (Submonoid.powers (MvPolynomial.X a))) =
        Localization.mk x 1 * Localization.mk g s - Localization.mk y 1 * Localization.mk h s := by
    intro x y g h s
    rw [Localization.mk_mul, Localization.mk_mul, one_mul, sub_eq_add_neg, sub_eq_add_neg,
      Localization.neg_mk, Localization.add_mk_self]
  have hnum : ((d₁ • G₀ - d₀ • G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) :
      MvPolynomial (Fin (N + 1)) E) =
      MvPolynomial.C d₁ * (G₀ : MvPolynomial (Fin (N + 1)) E) -
        MvPolynomial.C d₀ * (G₁ : MvPolynomial (Fin (N + 1)) E) := by
    rw [Submodule.coe_sub, Submodule.coe_smul, Submodule.coe_smul,
      MvPolynomial.smul_eq_C_mul, MvPolynomial.smul_eq_C_mul]
  unfold wcLdpSec
  rw [← map_mul, ← map_mul, ← map_sub]
  congr 1
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_sub, HomogeneousLocalization.val_mul,
    HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
    HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk]
  have hc : ∀ c : E, (HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
      (Submonoid.powers (MvPolynomial.X a))
      (algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 0) c)).val =
      Localization.mk (MvPolynomial.C c) 1 := by
    intro c
    rfl
  rw [hc, hc]
  simp only [hnum]
  exact key _ _ _ _ _

theorem wc_ldp_il_p1_away_poly (K : Type u) [Field K] (e : Fin 2) :
    ∀ x : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (MvPolynomial.X e),
      ∃ P : Polynomial K, x = P.eval₂
        ((HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
            (Submonoid.powers (MvPolynomial.X e))).comp
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)))
        (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
          ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K e)) 1
          (MvPolynomial.X (e + 1))
          ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K (e + 1)))) :=
by
  intro x
  have hne : e + 1 ≠ e := by fin_cases e <;> decide
  have hcases : ∀ j : Fin 2, j = e ∨ j = e + 1 := by
    intro j; fin_cases e <;> fin_cases j <;> simp

  have scale : ∀ {S : Type u} [CommRing S] (φ : K →+* S) (y : Fin (1 + 1) → S) (t : S) (n : ℕ)
      (F : MvPolynomial (Fin (1 + 1)) K), F.IsHomogeneous n →
      MvPolynomial.eval₂ φ (fun j => t * y j) F = t ^ n * MvPolynomial.eval₂ φ y F := by
    intro S _ φ y t n F hF
    conv_lhs => rw [F.as_sum]
    conv_rhs => rw [F.as_sum]
    rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun d hd => ?_)
    have hdeg : Finsupp.degree d = n := by
      by_contra h
      exact (MvPolynomial.mem_support_iff.mp hd) (hF.coeff_eq_zero h)
    rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
    have hp : (d.prod fun i e => (t * y i) ^ e) = t ^ n * d.prod fun i e => y i ^ e := by
      simp only [mul_pow]
      rw [Finsupp.prod_mul]
      congr 1
      rw [← hdeg, Finsupp.degree_apply]
      unfold Finsupp.prod
      rw [Finset.prod_pow_eq_pow_sum]
    rw [hp]
    ring
  have hX : (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K e)
  obtain ⟨n, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective
    (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) hX x
  have hFh : F.IsHomogeneous n := by
    rw [smul_eq_mul, mul_one] at hF
    exact (MvPolynomial.mem_homogeneousSubmodule n F).1 hF

  obtain ⟨ρt, hρC, hρa, hρs⟩ : ∃ ρt : MvPolynomial (Fin (1 + 1)) K →+* Polynomial K,
      (∀ c : K, ρt (MvPolynomial.C c) = Polynomial.C c) ∧ ρt (MvPolynomial.X e) = 1 ∧
      ρt (MvPolynomial.X (e + 1)) = Polynomial.X :=
    ⟨MvPolynomial.eval₂Hom Polynomial.C (fun j => if j = e then (1 : Polynomial K) else Polynomial.X),
      fun c => by rw [MvPolynomial.eval₂Hom_C],
      by rw [MvPolynomial.eval₂Hom_X', if_pos rfl],
      by rw [MvPolynomial.eval₂Hom_X', if_neg hne]⟩
  refine ⟨ρt F, ?_⟩
  have hu1 : (Localization.mk 1 ⟨MvPolynomial.X e, Submonoid.mem_powers _⟩ :
      Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K)) *
      algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K)) (MvPolynomial.X e) = 1 := by
    rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
    exact Localization.mk_self (⟨MvPolynomial.X e, Submonoid.mem_powers _⟩ :
      Submonoid.powers (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K))
  have hcomp : ((algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X e))
        (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K))).comp
        (Polynomial.eval₂RingHom
          ((HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
            (Submonoid.powers (MvPolynomial.X e))).comp
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)))
          (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
            ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K e)) 1
            (MvPolynomial.X (e + 1))
            ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
              (MvPolynomial.isHomogeneous_X K (e + 1)))))).comp ρt =
      MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K))).comp MvPolynomial.C)
        (fun j => (Localization.mk 1 ⟨MvPolynomial.X e, Submonoid.mem_powers _⟩ :
          Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K)) *
          algebraMap (MvPolynomial (Fin (1 + 1)) K)
            (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K))
            (MvPolynomial.X j)) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      rw [RingHom.comp_apply, RingHom.comp_apply, hρC, Polynomial.coe_eval₂RingHom,
        Polynomial.eval₂_C, MvPolynomial.eval₂Hom_C, RingHom.comp_apply, RingHom.comp_apply,
        HomogeneousLocalization.algebraMap_apply, ← Localization.mk_one_eq_algebraMap]
      have h1 : ((algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0) c :
          ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)) : MvPolynomial (Fin (1 + 1)) K) =
          MvPolynomial.C c := by
        rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
      rw [← h1]
      rfl
    · intro j
      rw [MvPolynomial.eval₂Hom_X', RingHom.comp_apply, RingHom.comp_apply]
      rcases hcases j with h | h
      · subst h
        rw [hρa, map_one, map_one, hu1]
      · subst h
        rw [hρs, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
          HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
          ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
        congr 1
        ext
        simp
  have hev : MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K))).comp MvPolynomial.C)
        (fun j => algebraMap (MvPolynomial (Fin (1 + 1)) K)
            (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K))
            (MvPolynomial.X j)) =
      algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K)) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
    · intro j
      rw [MvPolynomial.eval₂Hom_X']
  have h1 := RingHom.congr_fun hcomp F
  rw [RingHom.comp_apply, RingHom.comp_apply, Polynomial.coe_eval₂RingHom] at h1
  apply HomogeneousLocalization.val_injective (Submonoid.powers (MvPolynomial.X e))
  rw [HomogeneousLocalization.Away.val_mk, ← HomogeneousLocalization.algebraMap_apply,
    Localization.mk_eq_mk'_apply, eq_comm, IsLocalization.eq_mk'_iff_mul_eq]
  rw [h1, MvPolynomial.coe_eval₂Hom]
  have hs := scale ((algebraMap (MvPolynomial (Fin (1 + 1)) K)
      (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K))).comp MvPolynomial.C)
    (fun j => algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K))
          (MvPolynomial.X j))
    (Localization.mk 1 ⟨MvPolynomial.X e, Submonoid.mem_powers _⟩) n F hFh
  rw [hs, ← MvPolynomial.coe_eval₂Hom, hev]
  show _ * algebraMap (MvPolynomial (Fin (1 + 1)) K)
      (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K)) (MvPolynomial.X e ^ n) = _
  rw [map_pow]
  calc (Localization.mk 1 ⟨MvPolynomial.X e, Submonoid.mem_powers _⟩ :
        Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K)) ^ n *
        algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K)) F *
        algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K))
          (MvPolynomial.X e) ^ n
      = ((Localization.mk 1 ⟨MvPolynomial.X e, Submonoid.mem_powers _⟩ :
        Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K)) *
        algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K))
          (MvPolynomial.X e)) ^ n *
        algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K)) F := by ring
    _ = _ := by rw [hu1, one_pow, one_mul]

theorem wc_ldp_il_odp (E : Type u) [Field E] (N n : ℕ)
    (X : Over (Spec (.of E))) [SmoothOfRelativeDimension n X.hom]
    (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr E N = X.hom)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
    (Yt : Over (Spec (.of E))) (g : Yt.left ⟶ Limits.pullback X.hom (wcProjKStr E 1))
    (hgc : IsClosedImmersion g)
    (hg : g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom = Yt.hom)
    (V : X.left.Opens) (hV : ∀ x, x ∈ V ↔ ¬ wcLdpOnAxis E N ι G₀ G₁ x)
    (hbV : IsIso ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ∣_ V))
    (hloc : wcLdpIncLocal E N X ι G₀ G₁ Yt g)
    (y0 : Spec (.of E) ⟶ X.left) (hy0 : y0 ≫ X.hom = 𝟙 _)
    (hoff : ¬ wcLdpOnAxis E N ι G₀ G₁ (y0 (IsLocalRing.closedPoint E)))
    (c0 : Fin 2 → E) (hc0 : c0 ≠ 0)
    (hodp : ∀ (a : Fin (N + 1)) (hx : y0 (IsLocalRing.closedPoint E) ∈ ι ⁻¹ᵁ wcSgD E N a),
      ∃ (t : Fin n → X.left.presheaf.stalk (y0 (IsLocalRing.closedPoint E)))
        (A : Matrix (Fin n) (Fin n) (X.left.presheaf.stalk (y0 (IsLocalRing.closedPoint E)))),
        IsLocalRing.maximalIdeal (X.left.presheaf.stalk (y0 (IsLocalRing.closedPoint E))) =
            Ideal.span (Set.range t) ∧
          wcLdpGerm E N ι (c0 1 • G₀ - c0 0 • G₁) a (y0 (IsLocalRing.closedPoint E)) hx -
              ∑ k, ∑ l, A k l * t k * t l ∈
            IsLocalRing.maximalIdeal (X.left.presheaf.stalk (y0 (IsLocalRing.closedPoint E))) ^ 3 ∧
          IsUnit (A + A.transpose).det)
    (x0 : Spec (.of E) ⟶ Yt.left)
    (hx0 : x0 ≫ g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) = y0) :
    ∃ (t : Fin n → Yt.left.presheaf.stalk (x0 (IsLocalRing.closedPoint E)))
      (τ : (wcProjK E 1).presheaf.stalk
        ((g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) (x0 (IsLocalRing.closedPoint E))))
      (A : Matrix (Fin n) (Fin n) (Yt.left.presheaf.stalk (x0 (IsLocalRing.closedPoint E)))),
      IsLocalRing.maximalIdeal (Yt.left.presheaf.stalk (x0 (IsLocalRing.closedPoint E))) =
          Ideal.span (Set.range t) ∧
        IsLocalRing.maximalIdeal ((wcProjK E 1).presheaf.stalk
          ((g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) (x0 (IsLocalRing.closedPoint E)))) =
          Ideal.span {τ} ∧
        ((g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap
            (x0 (IsLocalRing.closedPoint E))).hom τ - ∑ a, ∑ b, A a b * t a * t b ∈
          IsLocalRing.maximalIdeal (Yt.left.presheaf.stalk (x0 (IsLocalRing.closedPoint E))) ^ 3 ∧
        IsUnit (A + A.transpose).det :=
by
  classical

  have s1 : ∀ {Z W : Scheme.{u}} (φ : Z ⟶ W) (s : W ⟶ Spec (.of E)) (z : Z) (c : E),
      (φ.stalkMap z).hom (wcLdpConst E s (φ z) c) = wcLdpConst E (φ ≫ s) z c := by
    intro Z W φ s z c
    simp only [wcLdpConst, RingHom.comp_apply]
    rw [Scheme.Hom.comp_appTop]
    exact Scheme.Hom.germ_stalkMap_apply φ ⊤ z trivial _

  have s8 : ∀ {X' Y' : Scheme.{u}} (f : X' ⟶ Y') (U : Y'.Opens) (_ : IsIso (f ∣_ U)) (x : X')
      (hx : f x ∈ U), Function.Bijective (f.stalkMap x).hom := by
    intro X' Y' f U hU x hx
    haveI := hU
    haveI : IsOpenImmersion (f ∣_ U) := inferInstance
    haveI : IsIso (f.stalkMap x) := by
      have h1 : IsIso ((f ∣_ U).stalkMap (⟨x, hx⟩ : (f ⁻¹ᵁ U).toScheme)) :=
        IsOpenImmersion.instIsIsoCommRingCatStalkMap _ _
      exact (Arrow.isIso_iff_isIso_of_isIso (morphismRestrictStalkMap f U ⟨x, hx⟩).hom).mp h1
    exact ConcreteCategory.bijective_of_isIso _

  have s9 : ∀ {R S : Type u} [CommRing R] [IsLocalRing R] [CommRing S] [IsLocalRing S]
      (β : R →+* S) (_ : Function.Bijective β) (r : R) (t : Fin n → R)
      (A : Matrix (Fin n) (Fin n) R),
      IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) →
      r - ∑ k, ∑ l, A k l * t k * t l ∈ IsLocalRing.maximalIdeal R ^ 3 →
      IsUnit (A + A.transpose).det →
      IsLocalRing.maximalIdeal S = Ideal.span (Set.range (fun k => β (t k))) ∧
      β r - ∑ k, ∑ l, A.map β k l * β (t k) * β (t l) ∈ IsLocalRing.maximalIdeal S ^ 3 ∧
      IsUnit (A.map β + (A.map β).transpose).det := by
    intro R S _ _ _ _ β hβ r t A hm h3 hdet
    let ε := RingEquiv.ofBijective β hβ
    have hmap : Ideal.map β (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal S := by
      have : (Ideal.map ε (IsLocalRing.maximalIdeal R)).IsMaximal :=
        Ideal.map_isMaximal_of_equiv ε
      exact IsLocalRing.eq_maximalIdeal this
    refine ⟨?_, ?_, ?_⟩
    · rw [← hmap, hm, Ideal.map_span, ← Set.range_comp]
      rfl
    · have h := Ideal.mem_map_of_mem β h3
      rw [Ideal.map_pow, hmap] at h
      simpa [map_sub, map_sum, map_mul, Matrix.map_apply] using h
    · have h := hdet.map β
      rw [RingHom.map_det] at h
      convert h using 2
      ext i j
      simp [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.transpose_apply]

  have s7 : ∀ {S : Type u} [CommRing S] [IsLocalRing S] (κ : E →+* S) (e : Fin 2)
      (u : Fin 2 → S) (σ : S) (d : Fin 2 → E), d ≠ 0 → ∀ (t : Fin n → S)
      (A : Matrix (Fin n) (Fin n) S), (∀ k, t k ∈ IsLocalRing.maximalIdeal S) →
      (κ (d 1) * u 0 - κ (d 0) * u 1) - ∑ k, ∑ l, A k l * t k * t l ∈
        IsLocalRing.maximalIdeal S ^ 3 →
      IsUnit (A + A.transpose).det → u (e + 1) = σ * u e → IsUnit (u e) →
      ∃ (lam : E) (A' : Matrix (Fin n) (Fin n) S), σ - κ lam ∈ IsLocalRing.maximalIdeal S ∧
        (σ - κ lam) - ∑ k, ∑ l, A' k l * t k * t l ∈ IsLocalRing.maximalIdeal S ^ 3 ∧
        IsUnit (A' + A'.transpose).det := by
    intro S _ _ κ e u σ d hd t A ht h3 hdet hrel hunit
    have hsum : ∑ k, ∑ l, A k l * t k * t l ∈ IsLocalRing.maximalIdeal S :=
      Ideal.sum_mem _ fun k _ => Ideal.sum_mem _ fun l _ => Ideal.mul_mem_left _ _ (ht l)
    have hq : κ (d 1) * u 0 - κ (d 0) * u 1 ∈ IsLocalRing.maximalIdeal S := by
      have := Ideal.add_mem _ (Ideal.pow_le_self (by norm_num) h3) hsum
      rwa [sub_add_cancel] at this
    have hκ : ∀ c : E, κ c ∈ IsLocalRing.maximalIdeal S → c = 0 := by
      intro c hc
      by_contra h0
      exact (IsLocalRing.mem_maximalIdeal _).mp hc ((IsUnit.mk0 c h0).map κ)
    have key : ∃ (lam : E) (w : S), IsUnit w ∧
        σ - κ lam = w * (κ (d 1) * u 0 - κ (d 0) * u 1) := by
      have he : e = 0 ∨ e = 1 := by fin_cases e <;> simp
      rcases he with rfl | rfl
      · rw [zero_add] at hrel
        obtain ⟨uu, huu⟩ := hunit
        have h1 : (↑uu⁻¹ : S) * ↑uu = 1 := Units.inv_mul uu
        have e1 : κ (d 1) - κ (d 0) * σ = ↑uu⁻¹ * (κ (d 1) * u 0 - κ (d 0) * u 1) := by
          rw [hrel, ← huu]
          linear_combination (-(κ (d 1) - κ (d 0) * σ)) * h1
        have hq0 : κ (d 1) - κ (d 0) * σ ∈ IsLocalRing.maximalIdeal S := by
          rw [e1]; exact Ideal.mul_mem_left _ _ hq
        have hd0 : d 0 ≠ 0 := by
          intro h0
          rw [h0, map_zero, zero_mul, sub_zero] at hq0
          have h1' := hκ _ hq0
          exact hd (funext fun i => by fin_cases i <;> simp [h0, h1'])
        refine ⟨d 1 / d 0, -(κ (d 0)⁻¹ * ↑uu⁻¹), ?_, ?_⟩
        · exact (((IsUnit.mk0 _ (inv_ne_zero hd0)).map κ).mul uu⁻¹.isUnit).neg
        · have hk1 : κ (d 0) * κ (d 0)⁻¹ = 1 := by
            rw [← map_mul, mul_inv_cancel₀ hd0, map_one]
          have hk2 : κ (d 1) = κ (d 0) * κ (d 1 / d 0) := by
            rw [← map_mul, mul_div_cancel₀ _ hd0]
          rw [hrel, ← huu, hk2]
          linear_combination (κ (d 1 / d 0) - σ) * (↑uu⁻¹ * ↑uu) * hk1 +
            (κ (d 1 / d 0) - σ) * h1
      · have h11 : (1 : Fin 2) + 1 = 0 := rfl
        rw [h11] at hrel
        obtain ⟨uu, huu⟩ := hunit
        have h1 : (↑uu⁻¹ : S) * ↑uu = 1 := Units.inv_mul uu
        have e1 : κ (d 1) * σ - κ (d 0) = ↑uu⁻¹ * (κ (d 1) * u 0 - κ (d 0) * u 1) := by
          rw [hrel, ← huu]
          linear_combination (-(κ (d 1) * σ - κ (d 0))) * h1
        have hq0 : κ (d 1) * σ - κ (d 0) ∈ IsLocalRing.maximalIdeal S := by
          rw [e1]; exact Ideal.mul_mem_left _ _ hq
        have hd1 : d 1 ≠ 0 := by
          intro h0
          rw [h0, map_zero, zero_mul, zero_sub] at hq0
          have h1' := hκ _ ((Ideal.neg_mem_iff _).mp hq0)
          exact hd (funext fun i => by fin_cases i <;> simp [h0, h1'])
        refine ⟨d 0 / d 1, κ (d 1)⁻¹ * ↑uu⁻¹, ?_, ?_⟩
        · exact ((IsUnit.mk0 _ (inv_ne_zero hd1)).map κ).mul uu⁻¹.isUnit
        · have hk1 : κ (d 1) * κ (d 1)⁻¹ = 1 := by
            rw [← map_mul, mul_inv_cancel₀ hd1, map_one]
          have hk2 : κ (d 0) = κ (d 1) * κ (d 0 / d 1) := by
            rw [← map_mul, mul_div_cancel₀ _ hd1]
          rw [hrel, ← huu, hk2]
          linear_combination (-(σ - κ (d 0 / d 1))) * (↑uu⁻¹ * ↑uu) * hk1 +
            (-(σ - κ (d 0 / d 1))) * h1
    obtain ⟨lam, w, hw, hσ⟩ := key
    refine ⟨lam, w • A, ?_, ?_, ?_⟩
    · rw [hσ]; exact Ideal.mul_mem_left _ _ hq
    · have hsw : ∑ k, ∑ l, (w • A) k l * t k * t l = w * ∑ k, ∑ l, A k l * t k * t l := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun l _ => ?_
        rw [Matrix.smul_apply, smul_eq_mul]
        ring
      have e2 : (σ - κ lam) - ∑ k, ∑ l, (w • A) k l * t k * t l =
          w * ((κ (d 1) * u 0 - κ (d 0) * u 1) - ∑ k, ∑ l, A k l * t k * t l) := by
        rw [hsw, hσ]
        ring
      rw [e2]; exact Ideal.mul_mem_left _ _ h3
    · have e3 : w • A + (w • A).transpose = w • (A + A.transpose) := by
        rw [Matrix.transpose_smul, smul_add]
      rw [e3, Matrix.det_smul]
      exact (hw.pow _).mul hdet

  have s5 : ∀ {Ar T : Type u} [CommRing Ar] [CommRing T] [IsLocalRing T] (φ : E →+* Ar)
      (j : Ar →+* T) (s : Ar), (∀ a : Ar, ∃ P : Polynomial E, a = P.eval₂ φ s) →
      (∀ y : T, ∃ r σ : Ar, IsUnit (j σ) ∧ y * j σ = j r) → ∀ lam : E,
      j s - j (φ lam) ∈ IsLocalRing.maximalIdeal T →
      IsLocalRing.maximalIdeal T = Ideal.span {j s - j (φ lam)} := by
    intro Ar T _ _ _ φ j s hgen hfrac lam hlam
    refine le_antisymm ?_ ((Ideal.span_singleton_le_iff_mem _).mpr hlam)
    intro y hy
    obtain ⟨r, σ, hσ, hyr⟩ := hfrac y
    obtain ⟨P, rfl⟩ := hgen r
    have hdiv := Polynomial.modByMonic_add_div P (Polynomial.X - Polynomial.C lam)
    rw [Polynomial.modByMonic_X_sub_C_eq_C_eval] at hdiv
    have hev : j (P.eval₂ φ s) = j (φ (P.eval lam)) + (j s - j (φ lam)) *
        j ((P /ₘ (Polynomial.X - Polynomial.C lam)).eval₂ φ s) := by
      conv_lhs => rw [← hdiv]
      simp only [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C,
        Polynomial.eval₂_X, Polynomial.eval₂_sub, map_add, map_mul, map_sub]
    have hc : P.eval lam = 0 := by
      by_contra h0
      have hu : IsUnit (j (φ (P.eval lam))) := ((IsUnit.mk0 _ h0).map φ).map j
      have h1 : j (P.eval₂ φ s) ∈ IsLocalRing.maximalIdeal T := by
        rw [← hyr]; exact Ideal.mul_mem_right _ _ hy
      have h2 := Ideal.sub_mem _ h1 (Ideal.mul_mem_right
        (j ((P /ₘ (Polynomial.X - Polynomial.C lam)).eval₂ φ s)) _ hlam)
      rw [hev, add_sub_cancel_right] at h2
      exact (IsLocalRing.mem_maximalIdeal _).mp h2 hu
    rw [hc, map_zero, map_zero, zero_add] at hev
    rw [Ideal.mem_span_singleton]
    obtain ⟨v, hv⟩ := hσ
    refine ⟨j ((P /ₘ (Polynomial.X - Polynomial.C lam)).eval₂ φ s) * ↑v⁻¹, ?_⟩
    have e4 : y = y * j σ * ↑v⁻¹ := by rw [← hv, mul_assoc, Units.mul_inv, mul_one]
    rw [e4, hyr, hev, mul_assoc]
  have kerz : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (w : R),
      RingHom.ker φ = Ideal.span {w} → φ w = 0 := by
    intro R S _ _ φ w h
    rw [← RingHom.mem_ker, h]
    exact Ideal.mem_span_singleton_self w

  have hy0z : y0 (IsLocalRing.closedPoint E) =
      Limits.pullback.fst X.hom (wcProjKStr E 1) (g (x0 (IsLocalRing.closedPoint E))) := by
    rw [← hx0]
    first | rfl | simp only [Scheme.Hom.comp_apply]
  rw [hy0z] at hoff hodp
  set z := x0 (IsLocalRing.closedPoint E) with hz
  set x := Limits.pullback.fst X.hom (wcProjKStr E 1) (g z) with hxdef
  have hzV : x ∈ V := (hV x).mpr hoff
  simp only [wcLdpOnAxis, not_forall] at hoff
  obtain ⟨a, hxa, hna⟩ := hoff
  obtain ⟨t, A, hm, h3, hdet⟩ := hodp a hxa
  have hpcov : Limits.pullback.snd X.hom (wcProjKStr E 1) (g z) ∈
      (⨆ a : Fin (1 + 1), @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) E) MvPolynomial.gradedAlgebra
        (MvPolynomial.X a)) := by
    rw [wc_pp_basicOpen_cover E 1]
    first | trivial | simp
  obtain ⟨e, he⟩ := TopologicalSpace.Opens.mem_iSup.mp hpcov
  set p := Limits.pullback.snd X.hom (wcProjKStr E 1) (g z) with hpdef
  set β : X.left.presheaf.stalk x →+* Yt.left.presheaf.stalk z :=
    (g.stalkMap z).hom.comp ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
    with hβdef
  set fs : (wcProjK E 1).presheaf.stalk p →+* Yt.left.presheaf.stalk z :=
    (g.stalkMap z).hom.comp ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap (g z)).hom
    with hfsdef
  have hβeq : ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap z).hom = β := by
    rw [Scheme.Hom.stalkMap_comp]; rfl
  have hfseq : ((g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap z).hom = fs := by
    rw [Scheme.Hom.stalkMap_comp]; rfl
  have hβ : Function.Bijective β := by
    have h0 := s8 (g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) V hbV z
      (by first | exact hzV | (rw [Scheme.Hom.comp_apply]; exact hzV))
    rwa [hβeq] at h0

  obtain ⟨-, hker⟩ := hloc z a hxa e he
  have hh := kerz _ _ hker
  simp only [map_sub, map_mul] at hh
  set sp : (wcProjK E 1).presheaf.stalk p :=
    ((wcProjK E 1).presheaf.germ (wcSgD E 1 e) p he).hom (wcSgE E 1 e (e + 1)) with hspdef
  set σ := fs sp with hσdef
  have hrel : β (wcLdpGerm E N ι (![G₀, G₁] (e + 1)) a x hxa) =
      σ * β (wcLdpGerm E N ι (![G₀, G₁] e) a x hxa) := by
    rw [sub_eq_zero] at hh
    exact hh
  have hunit : IsUnit (β (wcLdpGerm E N ι (![G₀, G₁] e) a x hxa)) := by
    by_contra hnu
    have hue : β (wcLdpGerm E N ι (![G₀, G₁] e) a x hxa) ∈
        IsLocalRing.maximalIdeal (Yt.left.presheaf.stalk z) :=
      (IsLocalRing.mem_maximalIdeal _).mpr hnu
    have hue1 : β (wcLdpGerm E N ι (![G₀, G₁] (e + 1)) a x hxa) ∈
        IsLocalRing.maximalIdeal (Yt.left.presheaf.stalk z) := by
      rw [hrel]; exact Ideal.mul_mem_left _ _ hue
    have hg' : ∀ k : Fin 2, β (wcLdpGerm E N ι (![G₀, G₁] k) a x hxa) ∈
        IsLocalRing.maximalIdeal (Yt.left.presheaf.stalk z) →
        wcLdpGerm E N ι (![G₀, G₁] k) a x hxa ∈
          IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) := by
      intro k hk
      by_contra hc
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hc
      exact (IsLocalRing.mem_maximalIdeal _).mp hk (hc.map β)
    have he2 : e = 0 ∨ e = 1 := by fin_cases e <;> simp
    rcases he2 with rfl | rfl
    · exact hna ⟨hg' 0 hue, hg' 1 hue1⟩
    · exact hna ⟨hg' 0 hue1, hg' 1 hue⟩

  obtain ⟨hm', h3₁, hdet₁⟩ :=
    s9 β hβ (wcLdpGerm E N ι (c0 1 • G₀ - c0 0 • G₁) a x hxa) t A hm h3 hdet
  have hcX : ∀ c : E, (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD E N a) x hxa).hom
      ((ι.app (wcSgD E N a)).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
          (MvPolynomial.X a)).hom
          (HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
            (Submonoid.powers (MvPolynomial.X a))
            (algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 0) c)))) =
      wcLdpConst E X.hom x c := by
    intro c
    have e3 := s1 ι (wcProjKStr E N) x c
    rw [hιX] at e3
    exact (Scheme.Hom.germ_stalkMap_apply ι (wcSgD E N a) x hxa _).symm.trans
      ((congrArg (ι.stalkMap x).hom (wc_ldp_il_proj_const E N a (ι x) hxa c)).trans e3)
  have hlin : wcLdpGerm E N ι (c0 1 • G₀ - c0 0 • G₁) a x hxa =
      wcLdpConst E X.hom x (c0 1) * wcLdpGerm E N ι G₀ a x hxa -
        wcLdpConst E X.hom x (c0 0) * wcLdpGerm E N ι G₁ a x hxa := by
    unfold wcLdpGerm
    rw [wc_ldp_il_sec_linear]
    simp only [map_sub, map_mul]
    rw [hcX, hcX]
  have hκS : ∀ c : E, β (wcLdpConst E X.hom x c) = wcLdpConst E Yt.hom z c := by
    intro c
    simp only [hβdef, RingHom.comp_apply]
    rw [s1, s1, hg]
  have hκT : ∀ c : E, fs (wcLdpConst E (wcProjKStr E 1) p c) = wcLdpConst E Yt.hom z c := by
    intro c
    simp only [hfsdef, RingHom.comp_apply]
    rw [s1, s1, ← Limits.pullback.condition, hg]
  rw [hlin, map_sub, map_mul, map_mul, hκS, hκS] at h3₁

  have ht' : ∀ k, β (t k) ∈ IsLocalRing.maximalIdeal (Yt.left.presheaf.stalk z) := by
    intro k; rw [hm']; exact Ideal.subset_span ⟨k, rfl⟩
  obtain ⟨lam, A₂, hσm, h3₂, hdet₂⟩ := s7 (wcLdpConst E Yt.hom z) e
    (fun k => β (wcLdpGerm E N ι (![G₀, G₁] k) a x hxa)) σ c0 hc0 (fun k => β (t k))
    (A.map β) ht' h3₁ hdet₁ hrel hunit

  have hfτ : fs (sp - wcLdpConst E (wcProjKStr E 1) p lam) = σ - wcLdpConst E Yt.hom z lam := by
    rw [map_sub, hκT]
  have hτm : sp - wcLdpConst E (wcProjKStr E 1) p lam ∈
      IsLocalRing.maximalIdeal ((wcProjK E 1).presheaf.stalk p) := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have := hu.map fs
    rw [hfτ] at this
    exact (IsLocalRing.mem_maximalIdeal _).mp hσm this
  have hmT := s5
    ((HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) E)
        (Submonoid.powers (MvPolynomial.X e))).comp
      (algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) E 0)))
    (((wcProjK E 1).presheaf.germ (wcSgD E 1 e) p he).hom.comp
      (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) E)
        (MvPolynomial.X e)).hom)
    (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) E)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X E e)) 1
      (MvPolynomial.X (e + 1))
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X E (e + 1))))
    (wc_ldp_il_p1_away_poly E e) (wc_ldp_il_proj_stalk_frac E 1 e p he) lam
    (by
      simp only [RingHom.comp_apply]
      rw [wc_ldp_il_proj_const E 1 e p he lam]
      exact hτm)
  simp only [RingHom.comp_apply] at hmT
  rw [wc_ldp_il_proj_const E 1 e p he lam] at hmT
  refine ⟨fun k => β (t k), sp - wcLdpConst E (wcProjKStr E 1) p lam, A₂, hm', hmT, ?_, hdet₂⟩
  rw [hfseq]
  have hfin : fs (sp - wcLdpConst E (wcProjKStr E 1) p lam) -
      ∑ a, ∑ b, A₂ a b * β (t a) * β (t b) ∈
      IsLocalRing.maximalIdeal (Yt.left.presheaf.stalk z) ^ 3 := by
    rw [hfτ]; exact h3₂
  exact hfin

theorem wc_ldp_incidence_local (E : Type u) [Field E] [PerfectField E] (N n : ℕ)
    (X : Over (Spec (.of E))) [SmoothOfRelativeDimension n X.hom]
    (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr E N = X.hom)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) (m : ℕ)
    (y : Fin m → (Spec (.of E) ⟶ X.left)) (c : Fin m → Fin 2 → E)
    (hP : wcLdpGoodPencil E N n X ι G₀ G₁ m y c)
    (Yt : Over (Spec (.of E))) (g : Yt.left ⟶ Limits.pullback X.hom (wcProjKStr E 1))
    (hgc : IsClosedImmersion g)
    (hg : g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom = Yt.hom)
    (V : X.left.Opens) (hV : ∀ x, x ∈ V ↔ ¬ wcLdpOnAxis E N ι G₀ G₁ x)
    (hbV : IsIso ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ∣_ V))
    (hloc : wcLdpIncLocal E N X ι G₀ G₁ Yt g)
    (xs : Fin m → (Spec (.of E) ⟶ Yt.left))
    (hxs : ∀ i, xs i ≫ g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) = y i) :
    SmoothOfRelativeDimension n Yt.hom ∧
    (∀ z : Yt.left, (∀ i, z ≠ xs i (IsLocalRing.closedPoint E)) →
      ∃ U : Yt.left.Opens, z ∈ U ∧
        Smooth (U.ι ≫ g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1))) ∧
    (∀ i : Fin m,
      ∃ (t : Fin n → Yt.left.presheaf.stalk (xs i (IsLocalRing.closedPoint E)))
        (τ : (wcProjK E 1).presheaf.stalk
          ((g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) (xs i (IsLocalRing.closedPoint E))))
        (A : Matrix (Fin n) (Fin n) (Yt.left.presheaf.stalk (xs i (IsLocalRing.closedPoint E)))),
        IsLocalRing.maximalIdeal (Yt.left.presheaf.stalk (xs i (IsLocalRing.closedPoint E))) =
            Ideal.span (Set.range t) ∧
          IsLocalRing.maximalIdeal ((wcProjK E 1).presheaf.stalk
            ((g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) (xs i (IsLocalRing.closedPoint E)))) =
            Ideal.span {τ} ∧
          ((g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap
              (xs i (IsLocalRing.closedPoint E))).hom τ - ∑ a, ∑ b, A a b * t a * t b ∈
            IsLocalRing.maximalIdeal (Yt.left.presheaf.stalk (xs i (IsLocalRing.closedPoint E))) ^ 3 ∧
          IsUnit (A + A.transpose).det) :=
by
  classical
  obtain ⟨hP0, hP1, hy, hoff, hc0, hnp, hP7, hodp⟩ := hP
  set b := g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) with hb

  have hcomm : ∀ w : (b ⁻¹ᵁ V).toScheme, V.ι ((b ∣_ V) w) = b ((b ⁻¹ᵁ V).ι w) := by
    intro w
    have e := congrArg (fun h : (b ⁻¹ᵁ V).toScheme ⟶ X.left => h w) (morphismRestrict_ι b V)
    first
      | exact e
      | (rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply]; exact e)
      | (simp only [Scheme.Hom.comp_apply] at e; exact e)
  have hinj : ∀ z₁ z₂ : Yt.left, (h₁ : b z₁ ∈ V) → (h₂ : b z₂ ∈ V) → b z₁ = b z₂ → z₁ = z₂ := by
    intro z₁ z₂ h₁ h₂ h
    have e1 := hcomm ⟨z₁, h₁⟩
    have e2 := hcomm ⟨z₂, h₂⟩
    have e3 : (b ∣_ V) ⟨z₁, h₁⟩ = (b ∣_ V) ⟨z₂, h₂⟩ := by
      apply V.ι.isOpenEmbedding.injective
      rw [e1, e2]
      exact h
    have e4 := (b ∣_ V).isOpenEmbedding.injective e3
    exact congrArg Subtype.val e4

  have hsm : SmoothOfRelativeDimension n Yt.hom := by
    apply wc_ldp_il_smooth_local
    intro z
    by_cases hzV : b z ∈ V
    · refine ⟨b ⁻¹ᵁ V, hzV, ?_⟩
      have e : (b ⁻¹ᵁ V).ι ≫ Yt.hom = (b ∣_ V) ≫ V.ι ≫ X.hom := by
        calc (b ⁻¹ᵁ V).ι ≫ Yt.hom = ((b ⁻¹ᵁ V).ι ≫ b) ≫ X.hom := by
              rw [← hg, hb]; simp only [Category.assoc]
          _ = ((b ∣_ V) ≫ V.ι) ≫ X.hom := by rw [morphismRestrict_ι]
          _ = (b ∣_ V) ≫ V.ι ≫ X.hom := Category.assoc _ _ _
      rw [e]
      haveI : SmoothOfRelativeDimension 0 (b ∣_ V) := inferInstance
      haveI : SmoothOfRelativeDimension 0 V.ι := inferInstance
      have h1 : SmoothOfRelativeDimension (0 + n) (V.ι ≫ X.hom) :=
        smoothOfRelativeDimension_comp 0 n V.ι X.hom
      rw [zero_add] at h1
      haveI := h1
      have h2 : SmoothOfRelativeDimension (0 + n) ((b ∣_ V) ≫ V.ι ≫ X.hom) :=
        smoothOfRelativeDimension_comp 0 n (b ∣_ V) (V.ι ≫ X.hom)
      rwa [zero_add] at h2
    · have hax : wcLdpOnAxis E N ι G₀ G₁ (b z) := by
        by_contra hc
        exact hzV ((hV _).mpr hc)
      exact wc_ldp_il_axis_smooth E N n X ι hι hιX G₀ G₁ hP1 Yt g hgc hg hloc z hax

  have hrel : ∀ z : Yt.left, (∀ i, z ≠ xs i (IsLocalRing.closedPoint E)) →
      ∃ U : Yt.left.Opens, z ∈ U ∧
        Smooth (U.ι ≫ g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) := by
    intro z hz
    refine wc_ldp_il_rel_smooth E N n X ι hι hιX G₀ G₁ hP1 Yt g hgc hg hloc z ?_
    intro hnax a hx
    apply hP7 (b z) a hx hnax
    intro i hi
    have hzV : b z ∈ V := (hV _).mpr hnax
    have hbxs : b (xs i (IsLocalRing.closedPoint E)) = y i (IsLocalRing.closedPoint E) := by
      rw [← hxs i]
      first
        | rfl
        | exact (Scheme.Hom.comp_apply (xs i) b _).symm
        | simp
    apply hz i
    refine hinj z _ hzV ?_ ?_
    · rw [hbxs, ← hi]; exact hzV
    · rw [hbxs, hi]

  have hodpY : ∀ i : Fin m,
      ∃ (t : Fin n → Yt.left.presheaf.stalk (xs i (IsLocalRing.closedPoint E)))
        (τ : (wcProjK E 1).presheaf.stalk
          ((g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) (xs i (IsLocalRing.closedPoint E))))
        (A : Matrix (Fin n) (Fin n) (Yt.left.presheaf.stalk (xs i (IsLocalRing.closedPoint E)))),
        IsLocalRing.maximalIdeal (Yt.left.presheaf.stalk (xs i (IsLocalRing.closedPoint E))) =
            Ideal.span (Set.range t) ∧
          IsLocalRing.maximalIdeal ((wcProjK E 1).presheaf.stalk
            ((g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) (xs i (IsLocalRing.closedPoint E)))) =
            Ideal.span {τ} ∧
          ((g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap
              (xs i (IsLocalRing.closedPoint E))).hom τ - ∑ a, ∑ b, A a b * t a * t b ∈
            IsLocalRing.maximalIdeal (Yt.left.presheaf.stalk (xs i (IsLocalRing.closedPoint E))) ^ 3 ∧
          IsUnit (A + A.transpose).det := by
    intro i
    exact wc_ldp_il_odp E N n X ι hι hιX G₀ G₁ Yt g hgc hg V hV hbV hloc (y i) (hy i) (hoff i)
      (c i) (hc0 i) (hodp i) (xs i) (hxs i)
  exact ⟨hsm, hrel, hodpY⟩

theorem wc_ldp_qsc_zero_nonempty (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (N n : ℕ)
    (hn : 1 ≤ n) (W : Scheme.{u}) (r : W ⟶ Spec (.of Ω)) [IrreducibleSpace W]
    [SmoothOfRelativeDimension n r] (κ : W ⟶ wcProjK Ω N) (hκ : IsClosedImmersion κ)
    (hκr : κ ≫ wcProjKStr Ω N = r) (H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 2) :
    ∃ w : W, wcLdpZero Ω N κ H w :=
by
  classical

  have s1gen : ∀ {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ)
      [GradedRing 𝒜] (f : A) (hf : f ∈ 𝒜 1) (g : A) (hg : g ∈ 𝒜 (2 • 1)) (p : Proj 𝒜)
      (hp : p ∈ Proj.basicOpen 𝒜 f),
      IsUnit (((Proj 𝒜).presheaf.germ (Proj.basicOpen 𝒜 f) p hp).hom
        ((Proj.awayToSection 𝒜 f).hom (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg))) →
      p ∈ Proj.basicOpen 𝒜 g := by
    intro A σ _ _ _ 𝒜 _ f hf g hg p hp h
    have key := ProjectiveSpectrum.Proj.awayToSection_germ 𝒜 f p hp
    have key2 := congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg)) key
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at key2
    change IsUnit (((ProjectiveSpectrum.Proj.structureSheaf 𝒜).presheaf.germ
      (ProjectiveSpectrum.basicOpen 𝒜 f) p hp).hom
      ((ProjectiveSpectrum.Proj.awayToSection 𝒜 f).hom
        (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg))) at h
    rw [key2] at h
    rw [Proj.mem_basicOpen]
    have h3 := (Proj.stalkIso' 𝒜 p).toRingHom.isUnit_map h
    simp at h3
    rw [← HomogeneousLocalization.isUnit_iff_isUnit_val] at h3
    simp only [HomogeneousLocalization.mapId, HomogeneousLocalization.Away.mk] at h3
    erw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk, Localization.mk_eq_mk',
      IsLocalization.AtPrime.isUnit_mk'_iff] at h3
    exact h3
  by_contra hcon
  have hall : ∀ w : W, κ w ∈ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) MvPolynomial.gradedAlgebra
      (H : MvPolynomial (Fin (N + 1)) Ω) := by
    intro w
    have hw : ¬ wcLdpZero Ω N κ H w := fun h => hcon ⟨w, h⟩
    simp only [wcLdpZero, not_forall] at hw
    obtain ⟨a, hx, hnot⟩ := hw
    rw [IsLocalRing.notMem_maximalIdeal] at hnot
    unfold wcLdpGerm at hnot
    have heq := Scheme.Hom.germ_stalkMap_apply κ (wcSgD Ω N a) w hx (wcLdpSec Ω N H a)
    have hu' := (congrArg IsUnit heq).mpr hnot
    have hu := isUnit_of_map_unit (κ.stalkMap w).hom _ hu'
    exact @s1gen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
      MvPolynomial.gradedAlgebra (MvPolynomial.X a)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω a))
      (H : MvPolynomial (Fin (N + 1)) Ω) H.2 (κ w) hx hu

  haveI := hκ
  have hA := (@Proj.isAffineOpen_basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) MvPolynomial.gradedAlgebra
      (H : MvPolynomial (Fin (N + 1)) Ω) 2 H.2 two_pos).preimage κ
  have htop : κ ⁻¹ᵁ (@Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) MvPolynomial.gradedAlgebra
      (H : MvPolynomial (Fin (N + 1)) Ω)) = ⊤ := by
    ext w
    exact iff_of_true (hall w) trivial
  rw [htop] at hA
  haveI : IsAffine (⊤ : W.Opens) := hA
  haveI : IsAffine W := IsAffine.of_isIso W.topIso.inv

  haveI : IsProper (wcProjKStr Ω N) := wc_pp_proper Ω N
  haveI : IsProper r := by
    rw [← hκr]
    infer_instance
  haveI : ∀ w : W, _root_.IsReduced (W.presheaf.stalk w) := fun w => by
    haveI := wcpa_smooth_stalk_isDomain Ω W r n w
    infer_instance
  haveI : IsReduced W := isReduced_of_isReduced_stalk W
  haveI : IsIntegral W := isIntegral_of_irreducibleSpace_of_isReduced W

  have hfin := finite_appTop_of_universallyClosed Ω r
  have hfield := isField_of_universallyClosed Ω r
  set φ : Ω →+* Γ(W, ⊤) := r.appTop.hom.comp (Scheme.ΓSpecIso (.of Ω)).inv.hom with hφ
  have hinvs : Function.Surjective (Scheme.ΓSpecIso (.of Ω)).inv.hom := fun x =>
    ⟨(Scheme.ΓSpecIso (.of Ω)).hom.hom x, by simp⟩
  have hφfin : φ.Finite := hfin.comp (RingHom.Finite.of_surjective _ hinvs)
  have hs : Function.Surjective r.appTop.hom := by
    letI := φ.toAlgebra
    haveI : Module.Finite Ω Γ(W, ⊤) := hφfin
    letI := hfield.toField
    haveI : Algebra.IsIntegral Ω Γ(W, ⊤) := Algebra.IsIntegral.of_finite Ω _
    have hbij := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := Ω) (K := Γ(W, ⊤))
    intro y
    obtain ⟨x, hx⟩ := hbij.2 y
    exact ⟨(Scheme.ΓSpecIso (.of Ω)).inv.hom x, hx⟩
  haveI : Subsingleton W := by
    letI := hfield.toField
    haveI : Subsingleton (PrimeSpectrum Γ(W, ⊤)) := ⟨fun x y => by
      ext1
      rw [Ideal.eq_bot_of_prime x.asIdeal, Ideal.eq_bot_of_prime y.asIdeal]⟩
    haveI : Subsingleton (Spec Γ(W, ⊤)) := this
    exact (Scheme.homeoOfIso W.isoSpec).toEquiv.subsingleton

  obtain ⟨w⟩ := (inferInstance : Nonempty W)
  obtain ⟨U, hU, V, hV, hwV, e, hsm⟩ :=
    SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := n) (f := r) w
  have hVtop : V = ⊤ := by
    ext x
    simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
    rw [Subsingleton.elim x w]
    exact hwV
  subst hVtop
  have hUtop : U = ⊤ := by
    ext x
    simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
    rw [Subsingleton.elim x (r w)]
    exact e hwV
  subst hUtop
  have happ : r.appLE ⊤ ⊤ e = r.appTop := r.appLE_eq_app (U := ⊤)
  rw [happ] at hsm
  letI := r.appTop.hom.toAlgebra
  haveI := hsm.toAlgebra
  haveI : Nontrivial Γ(W, ⊤) := RingHom.domain_nontrivial (W.presheaf.germ ⊤ w trivial).hom
  have h1 := Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential
    (R := Γ(Spec (.of Ω), ⊤)) (S := Γ(W, ⊤)) n
  haveI := KaehlerDifferential.subsingleton_of_surjective Γ(Spec (.of Ω), ⊤) Γ(W, ⊤) hs
  rw [rank_subsingleton'] at h1
  have hn0 : n = 0 := by exact_mod_cast h1.symm
  omega

theorem wc_ldp_qsc_h_transition (K : Type u) [Field K] (N : ℕ) (W : Scheme.{u})
    (κ : W ⟶ wcProjK K N) (H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2)
    (a b : Fin (N + 1)) :
    ∃ u : Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b), IsUnit u ∧
      (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
          κ ⁻¹ᵁ wcSgD K N a)).op).hom ((κ.app (wcSgD K N a)).hom (wcLdpSec K N H a)) =
        u * (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
          κ ⁻¹ᵁ wcSgD K N b)).op).hom ((κ.app (wcSgD K N b)).hom (wcLdpSec K N H b)) :=
by
  classical
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
    MvPolynomial.gradedAlgebra

  have hXa : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a)
  have hXb : (MvPolynomial.X b : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K b)
  have hx : (MvPolynomial.X a * MvPolynomial.X b : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2 :=
    (MvPolynomial.mem_homogeneousSubmodule 2 _).mpr
      ((MvPolynomial.isHomogeneous_X K a).mul (MvPolynomial.isHomogeneous_X K b))
  have h4a : (MvPolynomial.X a ^ 4 : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (2 • 2) := by
    rw [show (2 • 2 : ℕ) = 4 from rfl]
    exact (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X_pow a 4)
  have h4b : (MvPolynomial.X b ^ 4 : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (2 • 2) := by
    rw [show (2 • 2 : ℕ) = 4 from rfl]
    exact (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X_pow b 4)
  have hle_a : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      (MvPolynomial.X a * MvPolynomial.X b) ≤ wcSgD K N a := fun y hy =>
    ((Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) _ _).le hy).1
  have hle_b : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      (MvPolynomial.X a * MvPolynomial.X b) ≤ wcSgD K N b := fun y hy =>
    ((Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) _ _).le hy).2

  have hA : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X a * MvPolynomial.X b)).hom
        (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          hXb (rfl : MvPolynomial.X a * MvPolynomial.X b = MvPolynomial.X a * MvPolynomial.X b)
          (HomogeneousLocalization.Away.mk _ hXa 2 (H : MvPolynomial (Fin (N + 1)) K) H.2)) =
      ((wcProjK K N).presheaf.map (homOfLE hle_a).op).hom (wcLdpSec K N H a) :=
    congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hXa 2
      (H : MvPolynomial (Fin (N + 1)) K) H.2))
    (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      (f := MvPolynomial.X a) hXb (x := MvPolynomial.X a * MvPolynomial.X b) rfl)
  have hB : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X a * MvPolynomial.X b)).hom
        (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
          (HomogeneousLocalization.Away.mk _ hXb 2 (H : MvPolynomial (Fin (N + 1)) K) H.2)) =
      ((wcProjK K N).presheaf.map (homOfLE hle_b).op).hom (wcLdpSec K N H b) :=
    congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hXb 2
      (H : MvPolynomial (Fin (N + 1)) K) H.2))
    (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      (f := MvPolynomial.X b) hXa (x := MvPolynomial.X a * MvPolynomial.X b)
      (mul_comm (MvPolynomial.X a) (MvPolynomial.X b)))

  have c1 : HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        hXb (rfl : MvPolynomial.X a * MvPolynomial.X b = MvPolynomial.X a * MvPolynomial.X b)
        (HomogeneousLocalization.Away.mk _ hXa 2 (H : MvPolynomial (Fin (N + 1)) K) H.2) =
      HomogeneousLocalization.Away.mk _ hx 2 (MvPolynomial.X b ^ 4) h4b *
      HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hXa
        (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
        (HomogeneousLocalization.Away.mk _ hXb 2 (H : MvPolynomial (Fin (N + 1)) K) H.2) := by
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
      HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
      Localization.mk_mul, Localization.mk_eq_mk_iff]
    apply Localization.r_of_eq
    simp only [Submonoid.coe_mul]
    ring
  have c2 : HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        hx 2 (MvPolynomial.X b ^ 4) h4b *
      HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        hx 2 (MvPolynomial.X a ^ 4) h4a = 1 := by
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one,
      Localization.mk_mul, ← Localization.mk_one, Localization.mk_eq_mk_iff]
    apply Localization.r_of_eq
    simp only [Submonoid.coe_mul, OneMemClass.coe_one]
    ring

  have e : wcSgD K N a ⊓ wcSgD K N b ≤
      Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X a * MvPolynomial.X b) :=
    (Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) _ _).ge
  have kl : ∀ s : Γ(wcProjK K N, wcSgD K N a),
      ((wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N a ⊓ wcSgD K N b ≤
          wcSgD K N a)).op).hom s =
        ((wcProjK K N).presheaf.map (homOfLE e).op).hom
          (((wcProjK K N).presheaf.map (homOfLE hle_a).op).hom s) := fun s =>
    congrArg (fun φ => φ.hom s) ((wcProjK K N).presheaf.map_comp (homOfLE hle_a).op (homOfLE e).op)
  have kr : ∀ s : Γ(wcProjK K N, wcSgD K N b),
      ((wcProjK K N).presheaf.map (homOfLE (inf_le_right : wcSgD K N a ⊓ wcSgD K N b ≤
          wcSgD K N b)).op).hom s =
        ((wcProjK K N).presheaf.map (homOfLE e).op).hom
          (((wcProjK K N).presheaf.map (homOfLE hle_b).op).hom s) := fun s =>
    congrArg (fun φ => φ.hom s) ((wcProjK K N).presheaf.map_comp (homOfLE hle_b).op (homOfLE e).op)
  set r := ((wcProjK K N).presheaf.map (homOfLE e).op).hom with hr
  set T := (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X a * MvPolynomial.X b)).hom with hT

  have s1 : ∃ v : Γ(wcProjK K N, wcSgD K N a ⊓ wcSgD K N b), IsUnit v ∧
      ((wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N a ⊓ wcSgD K N b ≤
          wcSgD K N a)).op).hom (wcLdpSec K N H a) =
        v * ((wcProjK K N).presheaf.map (homOfLE (inf_le_right : wcSgD K N a ⊓ wcSgD K N b ≤
          wcSgD K N b)).op).hom (wcLdpSec K N H b) := by
    refine ⟨r (T (HomogeneousLocalization.Away.mk _ hx 2 (MvPolynomial.X b ^ 4) h4b)), ?_, ?_⟩
    · refine ⟨⟨_, r (T (HomogeneousLocalization.Away.mk _ hx 2 (MvPolynomial.X a ^ 4) h4a)),
        ?_, ?_⟩, rfl⟩
      · rw [← map_mul r, ← map_mul T, c2, map_one, map_one]
      · rw [← map_mul r, ← map_mul T, mul_comm (HomogeneousLocalization.Away.mk _ hx 2
          (MvPolynomial.X a ^ 4) h4a), c2, map_one, map_one]
    · rw [kl, kr, ← hA, ← hB, c1, map_mul T, map_mul r]

  obtain ⟨v, hv, hrel⟩ := s1
  refine ⟨(κ.app (wcSgD K N a ⊓ wcSgD K N b)).hom v, hv.map _, ?_⟩
  have el : (κ.app (wcSgD K N a ⊓ wcSgD K N b)).hom
      (((wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N a ⊓ wcSgD K N b ≤
          wcSgD K N a)).op).hom (wcLdpSec K N H a)) =
      (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
          κ ⁻¹ᵁ wcSgD K N a)).op).hom ((κ.app (wcSgD K N a)).hom (wcLdpSec K N H a)) :=
    congrArg (fun φ => φ.hom (wcLdpSec K N H a))
      (Scheme.Hom.naturality κ (homOfLE (inf_le_left : wcSgD K N a ⊓ wcSgD K N b ≤
          wcSgD K N a)).op)
  have er : (κ.app (wcSgD K N a ⊓ wcSgD K N b)).hom
      (((wcProjK K N).presheaf.map (homOfLE (inf_le_right : wcSgD K N a ⊓ wcSgD K N b ≤
          wcSgD K N b)).op).hom (wcLdpSec K N H b)) =
      (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
          κ ⁻¹ᵁ wcSgD K N b)).op).hom ((κ.app (wcSgD K N b)).hom (wcLdpSec K N H b)) :=
    congrArg (fun φ => φ.hom (wcLdpSec K N H b))
      (Scheme.Hom.naturality κ (homOfLE (inf_le_right : wcSgD K N a ⊓ wcSgD K N b ≤
          wcSgD K N b)).op)
  rw [← el, hrel, map_mul, er]
  rfl

theorem wc_ldp_qsc_clopen_idempotents (K : Type u) [Field K] (N : ℕ) (W : Scheme.{u})
    (κ : W ⟶ wcProjK K N) (hκ : IsClosedImmersion κ)
    (H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2) (k : ℕ) (hk : 1 ≤ k)
    (S₁ S₂ : Set W) (h₁ : IsClosed S₁) (h₂ : IsClosed S₂)
    (hcov : {w : W | wcLdpZero K N κ H w} ⊆ S₁ ∪ S₂)
    (hdisj : ∀ w : W, wcLdpZero K N κ H w → w ∈ S₁ → w ∈ S₂ → False) :
    ∃ e : ∀ a : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a),
      (∀ a b : Fin (N + 1),
        (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
            κ ⁻¹ᵁ wcSgD K N a)).op).hom (e a) -
          (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
            κ ⁻¹ᵁ wcSgD K N b)).op).hom (e b) ∈
        Ideal.span {((W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓
            κ ⁻¹ᵁ wcSgD K N b ≤ κ ⁻¹ᵁ wcSgD K N a)).op).hom
          ((κ.app (wcSgD K N a)).hom (wcLdpSec K N H a))) ^ k}) ∧
      (∀ (a : Fin (N + 1)) (w : W) (hw : w ∈ κ ⁻¹ᵁ wcSgD K N a), wcLdpZero K N κ H w →
        w ∈ S₁ → (W.presheaf.germ _ w hw).hom (e a) - 1 ∈
          IsLocalRing.maximalIdeal (W.presheaf.stalk w)) ∧
      (∀ (a : Fin (N + 1)) (w : W) (hw : w ∈ κ ⁻¹ᵁ wcSgD K N a), wcLdpZero K N κ H w →
        w ∈ S₂ → (W.presheaf.germ _ w hw).hom (e a) ∈
          IsLocalRing.maximalIdeal (W.presheaf.stalk w)) :=
by
  classical
  haveI := hκ

  have hAff : ∀ a : Fin (N + 1), IsAffineOpen (κ ⁻¹ᵁ wcSgD K N a) := fun a =>
    (Proj.isAffineOpen_basicOpen _ _
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a))
      one_pos).preimage κ
  have hAff2 : ∀ a b : Fin (N + 1),
      IsAffineOpen (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b) := by
    intro a b
    have h2 : (MvPolynomial.X a * MvPolynomial.X b : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2 :=
      (MvPolynomial.mem_homogeneousSubmodule 2 _).mpr
        ((MvPolynomial.isHomogeneous_X K a).mul (MvPolynomial.isHomogeneous_X K b))
    have := (Proj.isAffineOpen_basicOpen _ _ h2 two_pos).preimage κ
    rw [Proj.basicOpen_mul] at this
    exact this

  have gd1 : ∀ (U : W.Opens) (hU : IsAffineOpen U) (f : Γ(W, U)) (w : W) (hw : w ∈ U),
      (W.presheaf.germ U w hw).hom f ∈ IsLocalRing.maximalIdeal (W.presheaf.stalk w) ↔
        f ∈ (hU.primeIdealOf ⟨w, hw⟩).asIdeal := by
    intro U hU f w hw
    have hl := hU.isLocalization_stalk ⟨w, hw⟩
    exact @IsLocalization.AtPrime.to_map_mem_maximal_iff _ _ _ _
      (TopCat.Presheaf.algebra_section_stalk W.presheaf ⟨w, hw⟩) _ _ hl f _
  have gd2 : ∀ (U : W.Opens) (hU : IsAffineOpen U) (f : Γ(W, U)) (y : PrimeSpectrum Γ(W, U))
      (hy : hU.fromSpec y ∈ U),
      (W.presheaf.germ U (hU.fromSpec y) hy).hom f ∈
          IsLocalRing.maximalIdeal (W.presheaf.stalk (hU.fromSpec y)) ↔ f ∈ y.asIdeal := by
    intro U hU f y hy
    have hl := hU.isLocalization_stalk' y hy
    exact @IsLocalization.AtPrime.to_map_mem_maximal_iff _ _ _ _
      (TopCat.Presheaf.algebra_section_stalk W.presheaf ⟨_, hy⟩) y.asIdeal y.isPrime hl f _
  have hmemU : ∀ (U : W.Opens) (hU : IsAffineOpen U) (y : PrimeSpectrum Γ(W, U)),
      hU.fromSpec y ∈ U := by
    intro U hU y
    have : hU.fromSpec y ∈ Set.range hU.fromSpec := ⟨y, rfl⟩
    rw [hU.range_fromSpec] at this
    exact this

  have s3 : ∀ (a : Fin (N + 1)) (w : W) (hw : w ∈ κ ⁻¹ᵁ wcSgD K N a),
      (W.presheaf.germ _ w hw).hom ((κ.app (wcSgD K N a)).hom (wcLdpSec K N H a)) ∈
        IsLocalRing.maximalIdeal (W.presheaf.stalk w) → wcLdpZero K N κ H w := by
    intro a w hw hZ c hc
    obtain ⟨u, -, heq⟩ := wc_ldp_qsc_h_transition K N W κ H c a
    have hwV : w ∈ κ ⁻¹ᵁ wcSgD K N c ⊓ κ ⁻¹ᵁ wcSgD K N a := ⟨hc, hw⟩
    have e1 : (W.presheaf.germ _ w hwV).hom
        ((W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N c ⊓ κ ⁻¹ᵁ wcSgD K N a ≤
          κ ⁻¹ᵁ wcSgD K N c)).op).hom ((κ.app (wcSgD K N c)).hom (wcLdpSec K N H c))) =
        (W.presheaf.germ _ w hc).hom ((κ.app (wcSgD K N c)).hom (wcLdpSec K N H c)) :=
      TopCat.Presheaf.germ_res_apply W.presheaf _ w hwV _
    have e2 : (W.presheaf.germ _ w hwV).hom
        ((W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD K N c ⊓ κ ⁻¹ᵁ wcSgD K N a ≤
          κ ⁻¹ᵁ wcSgD K N a)).op).hom ((κ.app (wcSgD K N a)).hom (wcLdpSec K N H a))) =
        (W.presheaf.germ _ w hw).hom ((κ.app (wcSgD K N a)).hom (wcLdpSec K N H a)) :=
      TopCat.Presheaf.germ_res_apply W.presheaf _ w hwV _
    show (W.presheaf.germ _ w hc).hom ((κ.app (wcSgD K N c)).hom (wcLdpSec K N H c)) ∈ _
    rw [← e1, heq, map_mul, e2]
    exact Ideal.mul_mem_left _ _ hZ

  have s4 : ∀ (R : Type u) [CommRing R] (h : R) (T₁ T₂ : Set (PrimeSpectrum R)),
      IsClosed T₁ → IsClosed T₂ →
      (∀ q : PrimeSpectrum R, h ∈ q.asIdeal → q ∈ T₁ ∨ q ∈ T₂) →
      (∀ q : PrimeSpectrum R, h ∈ q.asIdeal → q ∈ T₁ → q ∈ T₂ → False) →
      ∃ e : R, e * e - e ∈ Ideal.span {h ^ k} ∧
        (∀ q : PrimeSpectrum R, h ∈ q.asIdeal → q ∈ T₁ → 1 - e ∈ q.asIdeal) ∧
        (∀ q : PrimeSpectrum R, h ∈ q.asIdeal → q ∈ T₂ → e ∈ q.asIdeal) := by
    intro R _ h T₁ T₂ hT₁ hT₂ hc hd
    have hπs : Function.Surjective (Ideal.Quotient.mk (Ideal.span {h ^ k})) :=
      Ideal.Quotient.mk_surjective
    have hφc : Continuous (PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {h ^ k}))) :=
      PrimeSpectrum.continuous_comap _
    have hφh : ∀ P : PrimeSpectrum (R ⧸ Ideal.span {h ^ k}),
        h ∈ (PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {h ^ k})) P).asIdeal := by
      intro P
      have hp : h ^ k ∈
          (PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {h ^ k})) P).asIdeal := by
        show Ideal.Quotient.mk (Ideal.span {h ^ k}) (h ^ k) ∈ P.asIdeal
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self (h ^ k))]
        exact P.asIdeal.zero_mem
      exact (PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {h ^ k})) P).isPrime.mem_of_pow_mem
        k hp
    have hcompl : (PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {h ^ k})) ⁻¹' T₁)ᶜ =
        PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {h ^ k})) ⁻¹' T₂ := by
      ext P
      simp only [Set.mem_compl_iff, Set.mem_preimage]
      constructor
      · intro hP
        exact (hc _ (hφh P)).resolve_left hP
      · intro hP h1
        exact hd _ (hφh P) h1 hP
    have hcl : IsClopen (PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {h ^ k})) ⁻¹' T₁) := by
      refine ⟨hT₁.preimage hφc, ?_⟩
      rw [← isClosed_compl_iff, hcompl]
      exact hT₂.preimage hφc
    obtain ⟨ē, hidem, hs⟩ := PrimeSpectrum.isClopen_iff.mp hcl
    obtain ⟨e, rfl⟩ := hπs ē
    have key : ∀ q : PrimeSpectrum R, h ∈ q.asIdeal → ∃ Q : PrimeSpectrum (R ⧸ Ideal.span {h ^ k}),
        PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {h ^ k})) Q = q := by
      intro q hq
      have hIq : Ideal.span {h ^ k} ≤ q.asIdeal :=
        (Ideal.span_singleton_le_iff_mem _).mpr (q.asIdeal.pow_mem_of_mem hq k (by omega))
      have hker : RingHom.ker (Ideal.Quotient.mk (Ideal.span {h ^ k})) ≤ q.asIdeal := by
        rw [Ideal.mk_ker]; exact hIq
      have hQp := Ideal.map_isPrime_of_surjective hπs hker
      refine ⟨⟨q.asIdeal.map (Ideal.Quotient.mk (Ideal.span {h ^ k})), hQp⟩, ?_⟩
      ext1
      show Ideal.comap (Ideal.Quotient.mk (Ideal.span {h ^ k}))
        (Ideal.map (Ideal.Quotient.mk (Ideal.span {h ^ k})) q.asIdeal) = q.asIdeal
      rw [Ideal.comap_map_of_surjective' _ hπs, sup_eq_left.mpr hker]
    refine ⟨e, ?_, ?_, ?_⟩
    · rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, hidem.eq, sub_self]
    · intro q hq hq1
      obtain ⟨Q, rfl⟩ := key q hq
      have hQ : Q ∈ (PrimeSpectrum.basicOpen (Ideal.Quotient.mk (Ideal.span {h ^ k}) e) :
          Set (PrimeSpectrum (R ⧸ Ideal.span {h ^ k}))) := by
        rw [← hs]; exact hq1
      have hQ' : Ideal.Quotient.mk (Ideal.span {h ^ k}) e ∉ Q.asIdeal :=
        (PrimeSpectrum.mem_basicOpen _ _).mp hQ
      have h0 : Ideal.Quotient.mk (Ideal.span {h ^ k}) e *
          (1 - Ideal.Quotient.mk (Ideal.span {h ^ k}) e) ∈ Q.asIdeal := by
        rw [mul_sub, mul_one, hidem.eq, sub_self]; exact Q.asIdeal.zero_mem
      have h1 := (Q.isPrime.mem_or_mem h0).resolve_left hQ'
      show Ideal.Quotient.mk (Ideal.span {h ^ k}) (1 - e) ∈ Q.asIdeal
      rw [map_sub, map_one]; exact h1
    · intro q hq hq2
      obtain ⟨Q, rfl⟩ := key q hq
      have hQ : Q ∉ (PrimeSpectrum.basicOpen (Ideal.Quotient.mk (Ideal.span {h ^ k}) e) :
          Set (PrimeSpectrum (R ⧸ Ideal.span {h ^ k}))) := by
        rw [← hs]; exact fun h1 => hd _ hq h1 hq2
      rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen, not_not] at hQ
      exact hQ

  have s5 : ∀ (R : Type u) [CommRing R] (I : Ideal R) (x y : R), x * x - x ∈ I →
      y * y - y ∈ I →
      (∀ q : Ideal R, q.IsPrime → I ≤ q → (x ∈ q ∧ y ∈ q) ∨ (1 - x ∈ q ∧ 1 - y ∈ q)) →
      x - y ∈ I := by
    intro R _ I x y hx hy hP
    have aux : ∀ z : R, z * z - z ∈ I → (∀ q : Ideal R, q.IsPrime → I ≤ q → z ∈ q) → z ∈ I := by
      intro z hz hq
      have hpow : ∀ n : ℕ, z ^ (n + 1) - z ∈ I := by
        intro n
        induction n with
        | zero => simp
        | succ n ih =>
          have e : z ^ (n + 1 + 1) - z = z * (z ^ (n + 1) - z) + (z * z - z) := by ring
          rw [e]; exact I.add_mem (I.mul_mem_left z ih) hz
      have hrad : z ∈ I.radical := by
        rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
        rintro J ⟨hIJ, hJ⟩
        exact hq J hJ hIJ
      obtain ⟨n, hn⟩ := hrad
      cases n with
      | zero =>
        have hI : I = ⊤ := (Ideal.eq_top_iff_one I).mpr (by simpa using hn)
        rw [hI]; exact Submodule.mem_top
      | succ n =>
        have h3 := I.sub_mem hn (hpow n)
        rwa [sub_sub_cancel] at h3
    have hz1 : x * (1 - y) ∈ I := by
      apply aux
      · have e : x * (1 - y) * (x * (1 - y)) - x * (1 - y) =
            (x * x - x) * ((1 - y) * (1 - y)) + x * (y * y - y) := by ring
        rw [e]; exact I.add_mem (I.mul_mem_right _ hx) (I.mul_mem_left _ hy)
      · intro q hq hIq
        rcases hP q hq hIq with ⟨h1, _⟩ | ⟨_, h2⟩
        · exact q.mul_mem_right _ h1
        · exact q.mul_mem_left _ h2
    have hz2 : y * (1 - x) ∈ I := by
      apply aux
      · have e : y * (1 - x) * (y * (1 - x)) - y * (1 - x) =
            (y * y - y) * ((1 - x) * (1 - x)) + y * (x * x - x) := by ring
        rw [e]; exact I.add_mem (I.mul_mem_right _ hy) (I.mul_mem_left _ hx)
      · intro q hq hIq
        rcases hP q hq hIq with ⟨_, h1⟩ | ⟨h2, _⟩
        · exact q.mul_mem_right _ h1
        · exact q.mul_mem_left _ h2
    have e : x - y = x * (1 - y) - y * (1 - x) := by ring
    rw [e]; exact I.sub_mem hz1 hz2

  have s8 : ∀ a : Fin (N + 1), ∃ e : Γ(W, κ ⁻¹ᵁ wcSgD K N a),
      e * e - e ∈ Ideal.span {((κ.app (wcSgD K N a)).hom (wcLdpSec K N H a)) ^ k} ∧
      (∀ (w : W) (hw : w ∈ κ ⁻¹ᵁ wcSgD K N a), wcLdpZero K N κ H w → w ∈ S₁ →
        (W.presheaf.germ _ w hw).hom e - 1 ∈ IsLocalRing.maximalIdeal (W.presheaf.stalk w)) ∧
      (∀ (w : W) (hw : w ∈ κ ⁻¹ᵁ wcSgD K N a), wcLdpZero K N κ H w → w ∈ S₂ →
        (W.presheaf.germ _ w hw).hom e ∈ IsLocalRing.maximalIdeal (W.presheaf.stalk w)) := by
    intro a
    have hU := hAff a
    have hZq : ∀ q : PrimeSpectrum Γ(W, κ ⁻¹ᵁ wcSgD K N a),
        (κ.app (wcSgD K N a)).hom (wcLdpSec K N H a) ∈ q.asIdeal →
          wcLdpZero K N κ H (hU.fromSpec q) := fun q hq =>
      s3 a _ (hmemU _ hU q) ((gd2 _ hU _ q (hmemU _ hU q)).mpr hq)
    obtain ⟨e, hidem, he1, he2⟩ := s4 _ ((κ.app (wcSgD K N a)).hom (wcLdpSec K N H a))
      {q | hU.fromSpec q ∈ S₁} {q | hU.fromSpec q ∈ S₂}
      (h₁.preimage hU.fromSpec.continuous) (h₂.preimage hU.fromSpec.continuous)
      (fun q hq => (Set.mem_union _ _ _).mp (hcov (hZq q hq)))
      (fun q hq h1 h2 => hdisj _ (hZq q hq) h1 h2)
    refine ⟨e, hidem, ?_, ?_⟩
    · intro w hw hZ hS
      have hfq : hU.fromSpec (hU.primeIdealOf ⟨w, hw⟩) = w := hU.fromSpec_primeIdealOf ⟨w, hw⟩
      have hq : (κ.app (wcSgD K N a)).hom (wcLdpSec K N H a) ∈
          (hU.primeIdealOf ⟨w, hw⟩).asIdeal := (gd1 _ hU _ w hw).mp (hZ a hw)
      have h1 := he1 (hU.primeIdealOf ⟨w, hw⟩) hq
        (by show hU.fromSpec (hU.primeIdealOf ⟨w, hw⟩) ∈ S₁; rw [hfq]; exact hS)
      have h2 := (gd1 _ hU _ w hw).mpr h1
      rw [map_sub, map_one] at h2
      have h3 := Submodule.neg_mem _ h2
      rwa [neg_sub] at h3
    · intro w hw hZ hS
      have hfq : hU.fromSpec (hU.primeIdealOf ⟨w, hw⟩) = w := hU.fromSpec_primeIdealOf ⟨w, hw⟩
      have hq : (κ.app (wcSgD K N a)).hom (wcLdpSec K N H a) ∈
          (hU.primeIdealOf ⟨w, hw⟩).asIdeal := (gd1 _ hU _ w hw).mp (hZ a hw)
      have h1 := he2 (hU.primeIdealOf ⟨w, hw⟩) hq
        (by show hU.fromSpec (hU.primeIdealOf ⟨w, hw⟩) ∈ S₂; rw [hfq]; exact hS)
      exact (gd1 _ hU _ w hw).mpr h1

  choose e hidem he1 he2 using s8
  refine ⟨e, ?_, he1, he2⟩
  intro a b
  have hV := hAff2 a b
  obtain ⟨u, hu, heq⟩ := wc_ldp_qsc_h_transition K N W κ H a b
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (hidem a)
  obtain ⟨c', hc'⟩ := Ideal.mem_span_singleton'.mp (hidem b)
  obtain ⟨u', hu'⟩ := hu.exists_left_inv
  set ρl := (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
      κ ⁻¹ᵁ wcSgD K N a)).op).hom with hρl
  set ρr := (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
      κ ⁻¹ᵁ wcSgD K N b)).op).hom with hρr
  set ha := (κ.app (wcSgD K N a)).hom (wcLdpSec K N H a) with hha
  set hb := (κ.app (wcSgD K N b)).hom (wcLdpSec K N H b) with hhb
  apply s5
  · rw [Ideal.mem_span_singleton']
    refine ⟨ρl c, ?_⟩
    rw [← map_pow, ← map_mul, hc, map_sub, map_mul]
  · rw [Ideal.mem_span_singleton']
    have hb' : ρr hb = u' * ρl ha := by rw [heq, ← mul_assoc, hu', one_mul]
    refine ⟨ρr c' * u' ^ k, ?_⟩
    rw [mul_assoc, ← mul_pow, ← hb', ← map_pow, ← map_mul, hc', map_sub, map_mul]
  · intro q hq hIq
    have hhaq : ρl ha ∈ q := hq.mem_of_pow_mem k (hIq (Ideal.mem_span_singleton_self _))
    have hwV := hmemU _ hV ⟨q, hq⟩
    have hwa : hV.fromSpec ⟨q, hq⟩ ∈ κ ⁻¹ᵁ wcSgD K N a := hwV.1
    have hwb : hV.fromSpec ⟨q, hq⟩ ∈ κ ⁻¹ᵁ wcSgD K N b := hwV.2
    have gl : ∀ s, (W.presheaf.germ _ (hV.fromSpec ⟨q, hq⟩) hwV).hom (ρl s) =
        (W.presheaf.germ _ (hV.fromSpec ⟨q, hq⟩) hwa).hom s := fun s =>
      TopCat.Presheaf.germ_res_apply W.presheaf _ _ hwV s
    have gr : ∀ s, (W.presheaf.germ _ (hV.fromSpec ⟨q, hq⟩) hwV).hom (ρr s) =
        (W.presheaf.germ _ (hV.fromSpec ⟨q, hq⟩) hwb).hom s := fun s =>
      TopCat.Presheaf.germ_res_apply W.presheaf _ _ hwV s
    have hZ : wcLdpZero K N κ H (hV.fromSpec ⟨q, hq⟩) := by
      apply s3 a _ hwa
      rw [← gl]
      exact (gd2 _ hV (ρl ha) ⟨q, hq⟩ hwV).mpr hhaq
    rcases (Set.mem_union _ _ _).mp (hcov hZ) with hS | hS
    · right
      have h1 := he1 a _ hwa hZ hS
      have h2 := he1 b _ hwb hZ hS
      constructor
      · apply (gd2 _ hV _ ⟨q, hq⟩ hwV).mp
        rw [map_sub, map_one, gl, ← neg_sub]
        exact Submodule.neg_mem _ h1
      · apply (gd2 _ hV _ ⟨q, hq⟩ hwV).mp
        rw [map_sub, map_one, gr, ← neg_sub]
        exact Submodule.neg_mem _ h2
    · left
      constructor
      · apply (gd2 _ hV _ ⟨q, hq⟩ hwV).mp
        rw [gl]
        exact he2 a _ hwa hZ hS
      · apply (gd2 _ hV _ ⟨q, hq⟩ hwV).mp
        rw [gr]
        exact he2 b _ hwb hZ hS

theorem wc_esz_twisted_h1_finite (K : Type u) [Field K] (N : ℕ) (W : Scheme.{u})
    (κ : W ⟶ wcProjK K N) (hκ : IsClosedImmersion κ) (m : ℕ) :
    ∃ (p : ℕ) (v : Fin p → ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)),
      (∀ i, wcEszCoc κ m (v i)) ∧
      ∀ c : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b),
        wcEszCoc κ m c → ∃ t : Fin p → K, wcEszCob κ m (fun a b => c a b -
          ∑ i, wcEszScal κ (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b) (t i) * v i a b) :=
by
  classical

  have resW : ∀ {A B C : W.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(W, A)),
      (W.presheaf.map (homOfLE h2).op).hom ((W.presheaf.map (homOfLE h1).op).hom x) =
      (W.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro A B C h1 h2 x
    change (W.presheaf.map (homOfLE h1).op ≫ W.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl

  have hR4 : ∀ (V V' : W.Opens) (h : V' ≤ V) (t : K),
      (W.presheaf.map (homOfLE h).op).hom (wcEszScal κ V t) = wcEszScal κ V' t := by
    intro V V' h t
    show (W.presheaf.map (homOfLE h).op).hom ((W.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom _) =
      (W.presheaf.map (homOfLE (le_top : V' ≤ ⊤)).op).hom _
    rw [resW]

  have hZ0 : wcEszCoc κ m 0 := by
    intro a b l
    simp only [Pi.zero_apply, map_zero, mul_zero, add_zero]
  have hZadd : ∀ c c' : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b),
      wcEszCoc κ m c → wcEszCoc κ m c' → wcEszCoc κ m (c + c') := by
    intro c c' hc hc' a b l
    simp only [Pi.add_apply, map_add]
    rw [← hc a b l, ← hc' a b l]
    ring
  have hZsmul : ∀ (t : K) (c : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)),
      wcEszCoc κ m c →
      wcEszCoc κ m (fun a b => wcEszScal κ (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b) t * c a b) := by
    intro t c hc a b l
    simp only [map_mul, hR4]
    linear_combination (wcEszScal κ (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ⊓
      κ ⁻¹ᵁ wcSgD K N l) t) * hc a b l
  have hB0 : wcEszCob κ m 0 := by
    refine ⟨0, fun a b => ?_⟩
    simp only [Pi.zero_apply, map_zero, mul_zero, sub_zero]
  have hBadd : ∀ c c' : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b),
      wcEszCob κ m c → wcEszCob κ m c' → wcEszCob κ m (c + c') := by
    rintro c c' ⟨d, hd⟩ ⟨d', hd'⟩
    refine ⟨d + d', fun a b => ?_⟩
    simp only [Pi.add_apply, map_add]
    rw [hd a b, hd' a b]
    ring
  have hBsmul : ∀ (t : K) (c : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)),
      wcEszCob κ m c →
      wcEszCob κ m (fun a b => wcEszScal κ (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b) t * c a b) := by
    rintro t c ⟨d, hd⟩
    refine ⟨fun a => wcEszScal κ (κ ⁻¹ᵁ wcSgD K N a) t * d a, fun a b => ?_⟩
    simp only [map_mul, hR4]
    rw [hd a b]
    ring

  have s6 : ∀ (C : Type u) [AddCommGroup C] [Module K C] (Z Bd : Submodule K C) (k : ℕ)
      (c : Fin k → C), (∀ z ∈ Z, ∃ b : Fin k → K, z - ∑ l, b l • c l ∈ Bd) →
      ∃ (p : ℕ) (v : Fin p → C), (∀ i, v i ∈ Z) ∧
        ∀ z ∈ Z, ∃ t : Fin p → K, z - ∑ i, t i • v i ∈ Bd := by
    intro C _ _ Z Bd k c hspan
    let Λ : (Fin k → K) →ₗ[K] C :=
      { toFun := fun b => ∑ l, b l • c l
        map_add' := fun b b' => by
          simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
        map_smul' := fun r b => by
          simp only [Pi.smul_apply, smul_eq_mul, mul_smul, RingHom.id_apply, Finset.smul_sum] }
    have hΛ : ∀ b, Λ b = ∑ l, b l • c l := fun b => rfl
    let T : Submodule K (Fin k → K) :=
      { carrier := {b | ∃ z ∈ Z, z - Λ b ∈ Bd}
        add_mem' := by
          intro b b' hb hb'
          obtain ⟨z, hz, hzb⟩ := hb
          obtain ⟨z', hz', hzb'⟩ := hb'
          refine ⟨z + z', Z.add_mem hz hz', ?_⟩
          have e : z + z' - Λ (b + b') = (z - Λ b) + (z' - Λ b') := by
            rw [map_add]; abel
          rw [e]
          exact Bd.add_mem hzb hzb'
        zero_mem' := ⟨0, Z.zero_mem, by rw [map_zero, sub_zero]; exact Bd.zero_mem⟩
        smul_mem' := by
          intro r b hb
          obtain ⟨z, hz, hzb⟩ := hb
          refine ⟨r • z, Z.smul_mem r hz, ?_⟩
          have e : r • z - Λ (r • b) = r • (z - Λ b) := by
            rw [map_smul, smul_sub]
          rw [e]
          exact Bd.smul_mem r hzb }
    have hfg : T.FG := IsNoetherian.noetherian T
    obtain ⟨p, β, hβ⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
    have hβT : ∀ j, ∃ z ∈ Z, z - Λ (β j) ∈ Bd := by
      intro j
      have h : β j ∈ T := hβ ▸ Submodule.subset_span ⟨j, rfl⟩
      exact h
    choose z hzZ hzB using hβT
    refine ⟨p, z, hzZ, fun w hw => ?_⟩
    obtain ⟨b, hb⟩ := hspan w hw
    have hbT : b ∈ T := ⟨w, hw, hb⟩
    rw [← hβ, Submodule.mem_span_range_iff_exists_fun] at hbT
    obtain ⟨t, ht⟩ := hbT
    refine ⟨t, ?_⟩
    have hb' : Λ b = ∑ j, t j • Λ (β j) := by
      rw [← ht, map_sum]
      simp only [map_smul]
    have key : w - ∑ j, t j • z j = (w - Λ b) - ∑ j, t j • (z j - Λ (β j)) := by
      rw [hb']
      simp only [smul_sub, Finset.sum_sub_distrib]
      abel
    rw [key]
    exact Bd.sub_mem hb (Bd.sum_mem fun j _ => Bd.smul_mem _ (hzB j))

  have hcover : (∀ a : Fin (N + 1), IsAffineOpen (κ ⁻¹ᵁ wcSgD K N a)) ∧
      (∀ a b : Fin (N + 1), IsAffineOpen (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)) ∧
      ∀ w : W, ∃ a : Fin (N + 1), w ∈ κ ⁻¹ᵁ wcSgD K N a := by
    haveI := hκ
    have hX : ∀ a : Fin (N + 1), (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ∈
