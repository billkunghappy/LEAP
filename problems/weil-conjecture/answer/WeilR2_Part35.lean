    refine ⟨Polynomial.X ^ ℓ - (Polynomial.C (d ^ (ℓ - 1)) * Polynomial.X + Polynomial.C c₀), ?_, ?_⟩
    · apply Polynomial.monic_X_pow_sub
      exact lt_of_le_of_lt Polynomial.degree_linear_le (by exact_mod_cast hℓ.one_lt)
    · rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_add, Polynomial.eval₂_mul,
        Polynomial.eval₂_C, Polynomial.eval₂_C, Polynomial.eval₂_X, hRL, hRL, Subalgebra.coe_pow,
        map_pow]
      linear_combination hstarL'
  obtain ⟨y, hy⟩ : ∃ y : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L),
      (y : L) = algebraMap K L (d : K) * (α - algebraMap K L h) := ⟨⟨_, hint⟩, rfl⟩
  have hstarB : y ^ ℓ - algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L) d ^ (ℓ - 1) * y =
      algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L) c₀ := by
    apply Subtype.ext
    rw [Subalgebra.coe_sub, Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_pow, hcoeB, hcoeB, hy]
    exact hstarL'
  rw [hc₀] at hstarB
  have hirr := wcLlsASre_no_rational_residue Ω W A K L 𝔭 t hPD ℓ hℓ c b υ μ hc hb hb0 hυ hμ Q
    hQprime hQcomap y d x hd hstarB
  have hloc := wcLlsVd_gi_local_normal Ω W A K 𝔭 t hPD c b hc hb hb0 _ hMprime hMlt.le
  have hU := wcLlsASre_uniq_of_irrational ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) K L ℓ hℓ hdeg
    _ Q hQprime hQcomap hloc y hirr
  have hR := wcLlsASre_no_inertia ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) K L ℓ hℓ hK hdeg α f
