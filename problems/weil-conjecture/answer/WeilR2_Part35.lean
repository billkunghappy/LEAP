  have hFL : algebraMap K L F ≠ 0 := (map_ne_zero _).mpr hF0
  obtain ⟨θ', hθ'def⟩ : ∃ x : L, x = θ / algebraMap K L F := ⟨_, rfl⟩
  obtain ⟨f', hf'def⟩ : ∃ x : K, x = algebraMap A K f / F ^ ℓ := ⟨_, rfl⟩
