        algebraMap A K (algebraMap ↥W A cW) ^ (ℓ - 1) * algebraMap A K (algebraMap ↥W A πW) := by
      rw [← map_pow, ← map_pow, ← map_mul, ← map_mul, ← hπW, map_natCast, map_natCast]
    obtain ⟨J, hJ⟩ := wcpa_dj_llsm_kpwulbc_cap_bound K O O₁ ℓ hℓ hO₁O hmO₁ (algebraMap A K u)
      (algebraMap A K (algebraMap ↥W A cW)) (algebraMap A K (algebraMap ↥W A πW)) f' hϖ0 hϖO₁
      (hι0 cW hcW0) (hwv cW hcWm) (hwv πW hπWm) hℓK KR (fun h₀ hh₀ => by
        rw [hcℓ]
        exact G1 h₀ hh₀)
    refine ⟨J, ?_⟩
    intro h' w' n' k' ε₀' ε₁' r₀' r₁' g₀' g₁' hh' hNF' _
    obtain ⟨-, -, hw', he0', he1', hE'⟩ := hNF'
    by_contra hlt
    push_neg at hlt
    obtain ⟨d, rfl⟩ : ∃ d, k' = n' + J + 1 + d := ⟨k' - (n' + J + 1), by omega⟩
    obtain ⟨hB1ne, -, hX1i⟩ := hbr n' ε₁' r₁' g₁' w' he1' hw'
    obtain ⟨hB0ne, hX0, -⟩ := hbr (n' + J + 1 + d) ε₀' r₀' g₀' w' he0' hw'
    apply hJ h' hh'
    have e : (f' / h' ^ ℓ - 1) / algebraMap A K (algebraMap ↥W A cW) ^ ℓ /
        algebraMap A K u ^ (J + 1) =
        algebraMap A K u ^ d *
          (algebraMap A K (u ^ (n' + J + 1 + d) * ε₀' + v * r₀' + algebraMap ↥W A w' * g₀') /
            algebraMap A K u ^ (n' + J + 1 + d)) *
          (algebraMap A K (u ^ n' * ε₁' + v * r₁' + algebraMap ↥W A w' * g₁') /
            algebraMap A K u ^ n')⁻¹ := by
      rw [hcℓ, hFe' h' w' n' (n' + J + 1 + d) ε₀' ε₁' r₀' r₁' g₀' g₁' hB1ne hE']
      field_simp
      ring
    rw [e]
    exact mul_mem (mul_mem (pow_mem hϖO₁ d) hX0) hX1i

theorem wcpa_dj_llsm_kpwulbc_kummer_step : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) → ∀ (f' : K) (a s : A), a ∉ 𝔭 → s ∉ 𝔭 → f' * algebraMap A K s = algebraMap A K a → ∀ (h : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A), h ≠ 0 → (lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀ ∉ 𝔭 ∧ ε₁ ∉ 𝔭 ∧ (f' / h ^ ℓ - 1) * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) * algebraMap A K (algebraMap ↥W A lam₂) = algebraMap A K (algebraMap ↥W A lam₁) * algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀)) → lam₂ ∣ lam₁ → (lam₁ ∣ lam₂ → n < k) → ¬ lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∣ lam₁ ^ (ℓ - 1) → (∀ (h' : K) (lam₁' lam₂' w' : ↥W) (n' k' : ℕ) (ε₀' ε₁' r₀' r₁' g₀' g₁' : A), h' ≠ 0 → (lam₁' ≠ 0 ∧ lam₂' ≠ 0 ∧ w' ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀' ∉ 𝔭 ∧ ε₁' ∉ 𝔭 ∧ (f' / h' ^ ℓ - 1) * algebraMap A K (u ^ n' * ε₁' + v * r₁' + algebraMap ↥W A w' * g₁') * algebraMap A K (algebraMap ↥W A lam₂') = algebraMap A K (algebraMap ↥W A lam₁') * algebraMap A K (u ^ k' * ε₀' + v * r₀' + algebraMap ↥W A w' * g₀')) → lam₁' * lam₂ ∣ lam₁ * lam₂') → (ℓ : ℤ) ∣ ((k : ℤ) - n) → ∃ (h' : K) (w' : ↥W) (n' k' : ℕ) (ε₀' ε₁' r₀' r₁' g₀' g₁' : A), h' ≠ 0 ∧ (lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w' ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀' ∉ 𝔭 ∧ ε₁' ∉ 𝔭 ∧ (f' / h' ^ ℓ - 1) * algebraMap A K (u ^ n' * ε₁' + v * r₁' + algebraMap ↥W A w' * g₁') * algebraMap A K (algebraMap ↥W A lam₂) = algebraMap A K (algebraMap ↥W A lam₁) * algebraMap A K (u ^ k' * ε₀' + v * r₀' + algebraMap ↥W A w' * g₀')) ∧ (k : ℤ) - n < (k' : ℤ) - n' :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ 𝔭 u v g hPD f' a s ha hs hf h lam₁ lam₂ w n k
    ε₀ ε₁ r₀ r₁ g₀ g₁ hh hNF hd hP0 hnGE hMAX hdiv
  classical
  obtain ⟨hl1, hl2, hw, he0, he1, hE⟩ := hNF
  have hPD' := hPD
  obtain ⟨hFT, hNZ, -, hmax, h𝔪, hgm, hg0, huv, h𝔭eq, -⟩ := hPD'
  haveI := hNZ
  have h𝔭p : 𝔭.IsPrime := hmax.isPrime
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h => h𝔭p.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have haW0 : ∀ c : ↥W, c ≠ 0 → algebraMap ↥W A c ≠ 0 := by
    intro c hc h0
    rw [Algebra.algebraMap_eq_smul_one] at h0
    rcases smul_eq_zero.mp h0 with h1 | h1
    · exact hc h1
    · exact one_ne_zero h1
  have hφ0 : ∀ y : A, y ≠ 0 → algebraMap A K y ≠ 0 := fun y hy h0 =>
    hy (IsFractionRing.injective A K (by rw [h0, map_zero]))
  have hι0 : ∀ c : ↥W, c ≠ 0 → algebraMap A K (algebraMap ↥W A c) ≠ 0 := fun c hc =>
    hφ0 _ (haW0 c hc)
  have hmapA : ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W →
      algebraMap ↥W A x ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) :=
    fun x hx => Ideal.mem_map_of_mem _ hx
  have hmap : ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → algebraMap ↥W A x ∈ 𝔭 :=
    fun x hx => h𝔪 (hmapA x hx)
  have hu𝔭 : u ∈ 𝔭 := by
    rw [h𝔭eq]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert u {v}))
  have hu0 : u ≠ 0 := by
    intro h0; apply haW0 g hg0; rw [← huv, h0, zero_mul]
  have hℓW0 : ((ℓ : ℕ) : ↥W) ≠ 0 := by
    intro h0
    have h1 : ((ℓ : ℕ) : Ω) = 0 := by
      have := congrArg W.subtype h0
      rwa [map_natCast, map_zero] at this
    have h2 := (ringChar.spec Ω ℓ).mp h1
    rcases (Nat.dvd_prime hℓ).mp h2 with h | h
    · exact CharP.ringChar_ne_one h
    · exact hΩ h
  have hℓWm : ((ℓ : ℕ) : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [← IsLocalRing.residue_eq_zero_iff, map_natCast]
    exact (ringChar.spec _ ℓ).mpr (by rw [hκ])
  have hV2 : ∀ (N : ℕ) (x y : ↥W), N ≠ 0 → x ^ N ∣ y ^ N → x ∣ y := by
    intro N x y hN hxy
    rcases ValuationRing.dvd_total x y with h | h
    · exact h
    · obtain ⟨z, rfl⟩ := h
      by_cases hy : y = 0
      · rw [hy]; exact dvd_zero _
      · rw [mul_pow] at hxy
        have h2 : y ^ N * z ^ N ∣ y ^ N * 1 := by rwa [mul_one]
        have h3 : z ^ N ∣ 1 := (mul_dvd_mul_iff_left (pow_ne_zero N hy)).mp h2
        have hzu : IsUnit z := (isUnit_pow_iff hN).mp (isUnit_of_dvd_one h3)
        exact (hzu.mul_right_dvd).mpr dvd_rfl
  have hsingle : ∀ x : A, x ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      ∃ (m : ↥W) (b : A), m ∈ IsLocalRing.maximalIdeal ↥W ∧ x = algebraMap ↥W A m * b := by
    intro x hx
    change x ∈ Submodule.span A (⇑(algebraMap ↥W A) '' ↑(IsLocalRing.maximalIdeal ↥W)) at hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨m, hm, rfl⟩ := hx
      exact ⟨m, 1, hm, (mul_one _).symm⟩
    | zero => exact ⟨0, 0, Ideal.zero_mem _, (mul_zero _).symm⟩
    | add x y _ _ hx hy =>
      obtain ⟨m₁, b₁, hm₁, rfl⟩ := hx
      obtain ⟨m₂, b₂, hm₂, rfl⟩ := hy
      rcases ValuationRing.dvd_total m₁ m₂ with ⟨c, rfl⟩ | ⟨c, rfl⟩
      · exact ⟨m₁, b₁ + algebraMap ↥W A c * b₂, hm₁, by rw [map_mul]; ring⟩
      · exact ⟨m₂, algebraMap ↥W A c * b₁ + b₂, hm₂, by rw [map_mul]; ring⟩
    | smul a x _ hx =>
      obtain ⟨m, b, hm, rfl⟩ := hx
      exact ⟨m, a * b, hm, by rw [smul_eq_mul]; ring⟩

  have NODE : ∀ (p : ℕ) (ε : A), ε ∉ 𝔭 → u ^ p * ε ∉ Ideal.span {v, u ^ (p + 1)} ⊔
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
    intro p ε hε hmem
    obtain ⟨y₁, hy₁, y₂, hy₂, hsum⟩ := Submodule.mem_sup.mp hmem
    obtain ⟨a₁, b₁, rfl⟩ := Ideal.mem_span_pair.mp hy₁
    obtain ⟨m, b'', hm, rfl⟩ := hsingle y₂ hy₂
    have hε' : ε - u * b₁ ∉ 𝔭 := by
      intro h0; apply hε
      have := 𝔭.add_mem h0 (𝔭.mul_mem_right b₁ hu𝔭)
      rwa [sub_add_cancel] at this
    have hz : u ^ p * (ε - u * b₁) + v * (-a₁) + algebraMap ↥W A m * (-b'') = 0 := by
      linear_combination (-1 : A) * hsum
    have hdvd := (wcpa_dj_llsm_kpwulb_nf_bound Ω W hW hWt A (FractionRing A) 𝔭 u v g hPD 1 1 1
      h1𝔭 (by rw [one_mul]) 1 g m p p (ε - u * b₁) (ε - u * b₁) (-a₁) (-a₁) (-b'') (-b'')
      ⟨one_ne_zero, hg0, hm, hε', hε', by rw [hz]; simp⟩).1
    exact (IsLocalRing.notMem_maximalIdeal.mpr (isUnit_of_dvd_one hdvd)) hgm

  obtain ⟨Λ, hΛ⟩ := hd
  have hΛ0 : Λ ≠ 0 := by rintro rfl; exact hl1 (by rw [hΛ, mul_zero])
  obtain ⟨c, hcΛ, -, hc0'⟩ := wcpa_dj_lr1k_ebnt_dms_root Ω W Λ ℓ hℓ.pos
  have hc0 : c ≠ 0 := hc0' hΛ0
  have hLE : lam₁ ^ (ℓ - 1) ∣ lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ :=
    (ValuationRing.dvd_total _ _).resolve_left hnGE
  have hLE' : Λ ^ (ℓ - 1) ∣ ((ℓ : ℕ) : ↥W) ^ ℓ := by
    rw [hΛ, mul_pow] at hLE
    exact (mul_dvd_mul_iff_left (pow_ne_zero _ hl2)).mp hLE
  have hcc : (c ^ (ℓ - 1)) ^ ℓ = Λ ^ (ℓ - 1) := by
    rw [← hcΛ, ← pow_mul, ← pow_mul, mul_comm]
  have hcd : c ^ (ℓ - 1) ∣ ((ℓ : ℕ) : ↥W) := hV2 ℓ _ _ hℓ.ne_zero (by rw [hcc]; exact hLE')
  obtain ⟨π₀, hπ₀⟩ := hcd
  have hπ₀m : π₀ ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hπm
    have hπu : IsUnit π₀ := IsLocalRing.notMem_maximalIdeal.mp hπm
    apply hnGE
    have e1 : lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ = lam₁ ^ (ℓ - 1) * π₀ ^ ℓ := by
      rw [hπ₀, hΛ]
      simp only [mul_pow]
      rw [hcc]; ring
    rw [e1]; exact ((hπu.pow ℓ).mul_right_dvd).mpr dvd_rfl

  obtain ⟨γ₀, hγ₀⟩ := wcpa_dj_llsm_kptf_residue_trivial Ω W A 𝔭 hFT hmax h𝔪 ε₀
  obtain ⟨γ₁, hγ₁⟩ := wcpa_dj_llsm_kptf_residue_trivial Ω W A 𝔭 hFT hmax h𝔪 ε₁
  have hγ₁u : IsUnit γ₁ := IsLocalRing.notMem_maximalIdeal.mp (fun hm => he1 (by
    have := 𝔭.add_mem hγ₁ (hmap γ₁ hm); rwa [sub_add_cancel] at this))
  obtain ⟨ζ, hζ, -, -⟩ := wcpa_dj_lr1k_ebnt_dms_root Ω W (γ₀ * ↑hγ₁u.unit⁻¹) ℓ hℓ.pos
  have hζγ : ζ ^ ℓ * γ₁ = γ₀ := by rw [hζ, mul_assoc, hγ₁u.val_inv_mul, mul_one]
  have hres𝔭 : ε₀ - algebraMap ↥W A ζ ^ ℓ * ε₁ ∈ 𝔭 := by
    have e : ε₀ - algebraMap ↥W A ζ ^ ℓ * ε₁ = (ε₀ - algebraMap ↥W A γ₀) -
        algebraMap ↥W A ζ ^ ℓ * (ε₁ - algebraMap ↥W A γ₁) := by
      rw [← hζγ, map_mul, map_pow]; ring
    rw [e]; exact 𝔭.sub_mem hγ₀ (𝔭.mul_mem_left _ hγ₁)
  rw [h𝔭eq] at hres𝔭
  obtain ⟨y₁, hy₁, y₀, hy₀, hsum0⟩ := Submodule.mem_sup.mp hres𝔭
  obtain ⟨b₁, b₂, rfl⟩ := Ideal.mem_span_pair.mp hy₁

  obtain ⟨e, he⟩ := hdiv
  obtain ⟨ep, hep⟩ : ∃ m : ℕ, m = e.toNat := ⟨_, rfl⟩
  obtain ⟨em, hem⟩ : ∃ m : ℕ, m = (-e).toNat := ⟨_, rfl⟩
  have hepem : (ep : ℤ) - em = e := by rw [hep, hem]; exact Int.toNat_sub_toNat_neg e
  have hN : n + ℓ * ep = k + ℓ * em := by
    have h1 : (ℓ : ℤ) * e = ℓ * ep - ℓ * em := by rw [← hepem]; ring
    have h2 : ((n + ℓ * ep : ℕ) : ℤ) = ((k + ℓ * em : ℕ) : ℤ) := by push_cast; linarith
    exact_mod_cast h2

  obtain ⟨x, hx⟩ : ∃ x : A, x = u ^ em := ⟨_, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : A, z = algebraMap ↥W A ζ * u ^ ep := ⟨_, rfl⟩
  obtain ⟨r, hr⟩ := exists_add_pow_prime_eq hℓ x (algebraMap ↥W A c * z)
  have hℓA : ((ℓ : ℕ) : A) = algebraMap ↥W A c ^ (ℓ - 1) * algebraMap ↥W A π₀ := by
    rw [← map_natCast (algebraMap ↥W A) ℓ, hπ₀, map_mul, map_pow]
  have hcl : algebraMap ↥W A c ^ ℓ = algebraMap ↥W A Λ := by rw [← map_pow, hcΛ]
  have hcpow : algebraMap ↥W A c ^ (ℓ - 1) * algebraMap ↥W A c = algebraMap ↥W A Λ := by
    rw [← pow_succ, Nat.sub_add_cancel hℓ.one_le, hcl]
  obtain ⟨ρ, hρ⟩ : ∃ ρ : A, ρ = x + algebraMap ↥W A c * z := ⟨_, rfl⟩
  obtain ⟨T, hT⟩ : ∃ T : A, T = z ^ ℓ + algebraMap ↥W A π₀ * (x * z * r) := ⟨_, rfl⟩
  have hρℓ : ρ ^ ℓ = x ^ ℓ + algebraMap ↥W A Λ * T := by
    rw [hρ, hr, hℓA, mul_pow, hcl, ← hcpow, hT]; ring
  obtain ⟨B₁, hB₁⟩ : ∃ B : A, B = u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁ := ⟨_, rfl⟩
  obtain ⟨B₀, hB₀⟩ : ∃ B : A, B = u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀ := ⟨_, rfl⟩
  rw [← hB₁, ← hB₀] at hE

  have hXdec : ∃ α yv : A, yv ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ∧
      x ^ ℓ * B₀ - T * B₁ = v * α + u ^ (k + ℓ * em + 1) * b₁ + yv := by
    have hxk : x ^ ℓ * u ^ k = u ^ (k + ℓ * em) := by rw [hx]; ring
    have hzn : z ^ ℓ * u ^ n = algebraMap ↥W A ζ ^ ℓ * u ^ (k + ℓ * em) := by
      rw [hz, ← hN]; ring
    refine ⟨u ^ (k + ℓ * em) * b₂ + x ^ ℓ * r₀ - z ^ ℓ * r₁,
      u ^ (k + ℓ * em) * y₀ + algebraMap ↥W A w * (x ^ ℓ * g₀ - z ^ ℓ * g₁) -
        algebraMap ↥W A π₀ * (x * z * r) * B₁, ?_, ?_⟩
    · exact Ideal.sub_mem _ (Ideal.add_mem _ (Ideal.mul_mem_left _ _ hy₀)
        (Ideal.mul_mem_right _ _ (hmapA w hw)))
        (Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _ (hmapA π₀ hπ₀m)))
    · rw [hB₀, hB₁, hT]
      linear_combination ε₀ * hxk - ε₁ * hzn - u ^ (k + ℓ * em) * hsum0

  have hDB : ρ ≠ 0 ∧ ∃ (wD : ↥W) (εD rD gD : A), εD ∉ 𝔭 ∧ wD ∈ IsLocalRing.maximalIdeal ↥W ∧
      ρ ^ ℓ * B₁ = u ^ (n + ℓ * em) * εD + v * rD + algebraMap ↥W A wD * gD := by
    have hxn : x ^ ℓ * u ^ n = u ^ (n + ℓ * em) := by rw [hx]; ring
    by_cases hcm : c ∈ IsLocalRing.maximalIdeal ↥W
    · refine ⟨?_, ?_⟩
      · intro h0
        apply NODE em 1 h1𝔭
        have e1 : u ^ em * 1 = algebraMap ↥W A c * (-z) := by
          rw [← hx]; linear_combination h0 - hρ
        rw [e1]
        exact Ideal.mem_sup_right (Ideal.mul_mem_right _ _ (hmapA c hcm))
      · have hΛm : Λ ∈ IsLocalRing.maximalIdeal ↥W := by
          rw [← hcΛ]; exact Ideal.pow_mem_of_mem _ hcm ℓ hℓ.pos
        rcases ValuationRing.dvd_total w Λ with ⟨d, hdw⟩ | ⟨d, hdw⟩
        · have hA : algebraMap ↥W A Λ = algebraMap ↥W A w * algebraMap ↥W A d := by
            rw [hdw, map_mul]
          refine ⟨w, ε₁, x ^ ℓ * r₁, x ^ ℓ * g₁ + algebraMap ↥W A d * (T * B₁), he1, hw, ?_⟩
          linear_combination B₁ * hρℓ + x ^ ℓ * hB₁ + ε₁ * hxn + (T * B₁) * hA
        · have hA : algebraMap ↥W A w = algebraMap ↥W A Λ * algebraMap ↥W A d := by
            rw [hdw, map_mul]
          refine ⟨Λ, ε₁, x ^ ℓ * r₁, algebraMap ↥W A d * (x ^ ℓ * g₁) + T * B₁, he1, hΛm, ?_⟩
          linear_combination B₁ * hρℓ + x ^ ℓ * hB₁ + ε₁ * hxn + (x ^ ℓ * g₁) * hA
    · have hcu : IsUnit c := IsLocalRing.notMem_maximalIdeal.mp hcm
      have h12 : lam₁ ∣ lam₂ := by
        rw [hΛ, ← hcΛ]; exact ((hcu.pow ℓ).mul_right_dvd).mpr dvd_rfl
      have hnk : n < k := hP0 h12
      have he_pos : 0 < e := by
        have h1 : (n : ℤ) < k := by exact_mod_cast hnk
        have h2 : (0 : ℤ) < ℓ := by exact_mod_cast hℓ.pos
        by_contra hneg
        push_neg at hneg
        have : (ℓ : ℤ) * e ≤ 0 := mul_nonpos_of_nonneg_of_nonpos h2.le hneg
        linarith
      have hem0 : em = 0 := by rw [hem]; exact Int.toNat_eq_zero.mpr (by linarith)
      have hep1 : 0 < ep := by
        have : (ep : ℤ) = e := by rw [hem0] at hepem; simpa using hepem
        omega
      have hz𝔭 : z ∈ 𝔭 := by
        rw [hz]; exact 𝔭.mul_mem_left _ (Ideal.pow_mem_of_mem _ hu𝔭 _ hep1)
      have hρ𝔭 : ρ ∉ 𝔭 := by
        intro hm; apply h1𝔭
        have e1 : (1 : A) = ρ - algebraMap ↥W A c * z := by rw [hρ, hx, hem0, pow_zero]; ring
        rw [e1]; exact 𝔭.sub_mem hm (𝔭.mul_mem_left _ hz𝔭)
      have hρℓ𝔭 : ρ ^ ℓ ∉ 𝔭 := fun hm => hρ𝔭 (h𝔭p.mem_of_pow_mem ℓ hm)
      refine ⟨fun h0 => hρ𝔭 (by rw [h0]; exact 𝔭.zero_mem), w, ρ ^ ℓ * ε₁, ρ ^ ℓ * r₁,
        ρ ^ ℓ * g₁, h𝔭p.mul_notMem hρℓ𝔭 he1, hw, ?_⟩
      rw [hem0, mul_zero, add_zero, hB₁]; ring
  obtain ⟨hρ0, wD, εD, rD, gD, hεD, hwD, hDBeq⟩ := hDB

  have hx0 : x ≠ 0 := by rw [hx]; exact pow_ne_zero _ hu0
  have hφρ : algebraMap A K ρ ≠ 0 := hφ0 ρ hρ0
  have hφx : algebraMap A K x ≠ 0 := hφ0 x hx0
  have hh'' : h * algebraMap A K ρ / algebraMap A K x ≠ 0 :=
    div_ne_zero (mul_ne_zero hh hφρ) hφx
  have hRℓK : algebraMap A K ρ ^ ℓ = algebraMap A K x ^ ℓ +
      algebraMap A K (algebraMap ↥W A Λ) * algebraMap A K T := by
    rw [← map_pow, hρℓ, map_add, map_mul, map_pow]
  have hL : algebraMap A K (algebraMap ↥W A lam₁) =
      algebraMap A K (algebraMap ↥W A lam₂) * algebraMap A K (algebraMap ↥W A Λ) := by
    rw [hΛ, map_mul, map_mul]
  have hkey : f' / (h * algebraMap A K ρ / algebraMap A K x) ^ ℓ * algebraMap A K ρ ^ ℓ =
      f' / h ^ ℓ * algebraMap A K x ^ ℓ := by
    rw [div_pow, mul_pow]
    field_simp
  obtain ⟨X, hXdef⟩ : ∃ X : A, X = x ^ ℓ * B₀ - T * B₁ := ⟨_, rfl⟩
  have KI : (f' / (h * algebraMap A K ρ / algebraMap A K x) ^ ℓ - 1) *
      algebraMap A K (u ^ (n + ℓ * em) * εD + v * rD + algebraMap ↥W A wD * gD) *
      algebraMap A K (algebraMap ↥W A lam₂) =
      algebraMap A K (algebraMap ↥W A lam₁) * algebraMap A K X := by
    rw [← hDBeq, hXdef]
    simp only [map_sub, map_mul, map_pow]
    linear_combination (algebraMap A K B₁ * algebraMap A K (algebraMap ↥W A lam₂)) * hkey +
      algebraMap A K x ^ ℓ * hE -
      (algebraMap A K B₁ * algebraMap A K (algebraMap ↥W A lam₂)) * hRℓK +
      (algebraMap A K T * algebraMap A K B₁) * hL
  have hB₁0 : B₁ ≠ 0 := by
    intro hB0
    apply NODE n ε₁ he1
    refine Submodule.mem_sup.mpr ⟨(-r₁) * v + 0 * u ^ (n + 1), Ideal.mem_span_pair.mpr ⟨_, _, rfl⟩,
      algebraMap ↥W A w * (-g₁), Ideal.mul_mem_right _ _ (hmapA w hw), ?_⟩
    linear_combination hB₁ - hB0

  have hX0 : X ≠ 0 := by
    intro hX0
    rw [hX0, map_zero, mul_zero] at KI
    have hDne : algebraMap A K (u ^ (n + ℓ * em) * εD + v * rD + algebraMap ↥W A wD * gD) ≠ 0 := by
      rw [← hDBeq]; exact hφ0 _ (mul_ne_zero (pow_ne_zero _ hρ0) hB₁0)
    have hQ : f' / (h * algebraMap A K ρ / algebraMap A K x) ^ ℓ - 1 = 0 := by
      rcases mul_eq_zero.mp KI with h1 | h1
      · rcases mul_eq_zero.mp h1 with h2 | h2
        · exact h2
        · exact absurd h2 hDne
      · exact absurd h1 (hι0 lam₂ hl2)
    have hf'H : f' = (h * algebraMap A K ρ / algebraMap A K x) ^ ℓ := by
      rw [sub_eq_zero, div_eq_one_iff_eq (pow_ne_zero _ hh'')] at hQ; exact hQ
    generalize h * algebraMap A K ρ / algebraMap A K x = H at hf'H hh''
    have hbin : ∀ (y : ↥W) (N : ℕ), ∃ Q : ↥W, (1 + y) ^ N = 1 + (N : ↥W) * y + y ^ 2 * Q := by
      intro y N
      induction N with
      | zero => exact ⟨0, by simp⟩
      | succ N ih =>
        obtain ⟨Q, hQ⟩ := ih
        exact ⟨N + Q + y * Q, by rw [pow_succ, hQ]; push_cast; ring⟩
    have hunit1 : ∀ m : ↥W, m ∈ IsLocalRing.maximalIdeal ↥W → IsUnit (1 + m) := by
      intro m hm
      by_contra hu
      have h1 : 1 + m ∈ IsLocalRing.maximalIdeal ↥W := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact hu
      have h2 := Ideal.sub_mem _ h1 hm
      rw [add_sub_cancel_right] at h2
      exact IsLocalRing.notMem_maximalIdeal.mpr isUnit_one h2
    obtain ⟨π, hπ⟩ : ∃ π : ↥W, π = lam₁ * ((ℓ : ℕ) : ↥W) ^ 2 := ⟨_, rfl⟩
    obtain ⟨Qb, hQb⟩ := hbin π ℓ
    have hπm : π ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [hπ]; exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hℓWm 2 two_pos)
    have hυ : IsUnit (1 + lam₁ * ((ℓ : ℕ) : ↥W) * Qb) :=
      hunit1 _ (Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ hℓWm))
    have h1π : IsUnit (1 + π) := hunit1 _ hπm
    have hδ : (1 + π) ^ ℓ - 1 =
        lam₁ * (((ℓ : ℕ) : ↥W) ^ 3 * (1 + lam₁ * ((ℓ : ℕ) : ↥W) * Qb)) := by
      rw [hQb, hπ]; ring
    have hδ0 : (1 + π) ^ ℓ - 1 ≠ 0 := by
      rw [hδ]; exact mul_ne_zero hl1 (mul_ne_zero (pow_ne_zero _ hℓW0) hυ.ne_zero)
    have hZ0 : algebraMap A K (algebraMap ↥W A (1 + π)) ≠ 0 := hι0 _ h1π.ne_zero
    have hYA : algebraMap ↥W A ((1 + π) ^ ℓ) ∉ 𝔭 := fun hm =>
      h𝔭p.ne_top (Ideal.eq_top_of_isUnit_mem _ hm ((h1π.pow ℓ).map _))
    have hm1 : (-1 : A) ∉ 𝔭 := fun hm => h1𝔭 (by have := 𝔭.neg_mem hm; rwa [neg_neg] at this)
    have heq : (f' / (H * algebraMap A K (algebraMap ↥W A (1 + π))) ^ ℓ - 1) *
        algebraMap A K (u ^ 0 * algebraMap ↥W A ((1 + π) ^ ℓ) + v * 0 + algebraMap ↥W A 0 * 0) *
        algebraMap A K (algebraMap ↥W A 1) =
        algebraMap A K (algebraMap ↥W A ((1 + π) ^ ℓ - 1)) *
        algebraMap A K (u ^ 0 * (-1) + v * 0 + algebraMap ↥W A 0 * 0) := by
      rw [hf'H]
      simp only [pow_zero, one_mul, mul_zero, add_zero, map_zero, map_one, mul_one, map_pow,
        map_sub, map_neg]
      field_simp
      ring
    have hM := hMAX (H * algebraMap A K (algebraMap ↥W A (1 + π))) ((1 + π) ^ ℓ - 1) 1 0 0 0 (-1)
      (algebraMap ↥W A ((1 + π) ^ ℓ)) 0 0 0 0 (mul_ne_zero hh'' hZ0)
      ⟨hδ0, one_ne_zero, Ideal.zero_mem _, hm1, hYA, heq⟩
    rw [hδ] at hM
    have h2 : lam₁ * (((ℓ : ℕ) : ↥W) ^ 3 * (1 + lam₁ * ((ℓ : ℕ) : ↥W) * Qb) * lam₂) ∣ lam₁ * 1 := by
      calc lam₁ * (((ℓ : ℕ) : ↥W) ^ 3 * (1 + lam₁ * ((ℓ : ℕ) : ↥W) * Qb) * lam₂)
          = lam₁ * (((ℓ : ℕ) : ↥W) ^ 3 * (1 + lam₁ * ((ℓ : ℕ) : ↥W) * Qb)) * lam₂ := by ring
        _ ∣ lam₁ * 1 := hM
    have h3 := (mul_dvd_mul_iff_left hl1).mp h2
    have h4 : ((ℓ : ℕ) : ↥W) ∣ 1 :=
      dvd_trans (Dvd.intro (((ℓ : ℕ) : ↥W) ^ 2 * (1 + lam₁ * ((ℓ : ℕ) : ↥W) * Qb) * lam₂)
        (by ring)) h3
    exact IsLocalRing.notMem_maximalIdeal.mpr (isUnit_of_dvd_one h4) hℓWm

  obtain ⟨α, yv, hy, hXd⟩ := hXdec
  rw [← hXdef] at hXd
  obtain ⟨j, kX, σ, εX, rX, gX, lX, wX, hσ, hεX, hlX, hwX, EB⟩ :=
    wcpa_dj_llsm_kpwul_bracket Ω W hW hWt A 𝔭 u v g hPD X hX0
  obtain ⟨w', d₁, d₂, hw', hd₁, hd₂⟩ : ∃ w' d₁ d₂ : ↥W, w' ∈ IsLocalRing.maximalIdeal ↥W ∧
      wD = w' * d₁ ∧ wX = w' * d₂ := by
    rcases ValuationRing.dvd_total wD wX with ⟨d, hd⟩ | ⟨d, hd⟩
    · exact ⟨wD, 1, d, hwD, (mul_one _).symm, hd⟩
    · exact ⟨wX, d, 1, hwX, hd, (mul_one _).symm⟩
  have EB' := congrArg (algebraMap A K) EB
  simp only [map_mul, map_pow] at EB'
  have hD' : u ^ (n + ℓ * em + j) * (σ * εD) + v * (σ * u ^ j * rD) +
      algebraMap ↥W A w' * (algebraMap ↥W A d₁ * (σ * u ^ j * gD)) =
      σ * u ^ j * (u ^ (n + ℓ * em) * εD + v * rD + algebraMap ↥W A wD * gD) := by
    rw [hd₁, map_mul]; ring
  have hBX' : u ^ kX * εX + v * rX + algebraMap ↥W A w' * (algebraMap ↥W A d₂ * gX) =
      u ^ kX * εX + v * rX + algebraMap ↥W A wX * gX := by
    rw [hd₂, map_mul]; ring
  have hBX'' : u ^ kX * (algebraMap ↥W A lX * εX) + v * (algebraMap ↥W A lX * rX) +
      algebraMap ↥W A w' * (algebraMap ↥W A lX * (algebraMap ↥W A d₂ * gX)) =
      algebraMap ↥W A lX * (u ^ kX * εX + v * rX + algebraMap ↥W A wX * gX) := by
    rw [hd₂, map_mul]; ring
  have E1 : (f' / (h * algebraMap A K ρ / algebraMap A K x) ^ ℓ - 1) *
      algebraMap A K (u ^ (n + ℓ * em + j) * (σ * εD) + v * (σ * u ^ j * rD) +
        algebraMap ↥W A w' * (algebraMap ↥W A d₁ * (σ * u ^ j * gD))) *
      algebraMap A K (algebraMap ↥W A lam₂) =
      algebraMap A K (algebraMap ↥W A (lam₁ * lX)) *
      algebraMap A K (u ^ kX * εX + v * rX + algebraMap ↥W A w' * (algebraMap ↥W A d₂ * gX)) := by
    rw [hD', hBX']
    simp only [map_mul, map_pow]
    linear_combination (algebraMap A K σ * algebraMap A K u ^ j) * KI +
      algebraMap A K (algebraMap ↥W A lam₁) * EB'
  have hMX := hMAX (h * algebraMap A K ρ / algebraMap A K x) (lam₁ * lX) lam₂ w' (n + ℓ * em + j)
    kX εX (σ * εD) rX (σ * u ^ j * rD) (algebraMap ↥W A d₂ * gX)
    (algebraMap ↥W A d₁ * (σ * u ^ j * gD)) hh''
    ⟨mul_ne_zero hl1 hlX, hl2, hw', hεX, h𝔭p.mul_notMem hσ hεD, E1⟩
  have hlXu : lX ∣ 1 := by
    have h1 : lam₁ * lam₂ * lX ∣ lam₁ * lam₂ * 1 := by
      calc lam₁ * lam₂ * lX = lam₁ * lX * lam₂ := by ring
        _ ∣ lam₁ * lam₂ := hMX
        _ = lam₁ * lam₂ * 1 := (mul_one _).symm
    exact (mul_dvd_mul_iff_left (mul_ne_zero hl1 hl2)).mp h1
  obtain ⟨μ, hμ⟩ := hlXu
  have hμA : algebraMap ↥W A lX * algebraMap ↥W A μ = 1 := by rw [← map_mul, ← hμ, map_one]
  have hlX𝔭 : algebraMap ↥W A lX ∉ 𝔭 := fun hm =>
    h1𝔭 (by rw [← hμA]; exact 𝔭.mul_mem_right _ hm)
  have hord : k + ℓ * em + 1 + j ≤ kX := by
    by_contra hlt
    push_neg at hlt
    obtain ⟨t, ht⟩ : ∃ t, k + ℓ * em + 1 + j = kX + 1 + t :=
      ⟨k + ℓ * em + 1 + j - (kX + 1), by omega⟩
    have hut : u ^ (k + ℓ * em + 1) * u ^ j = u ^ (kX + 1) * u ^ t := by
      rw [← pow_add, ← pow_add, ht]
    apply NODE kX εX hεX
    refine Submodule.mem_sup.mpr ⟨(algebraMap ↥W A μ * σ * u ^ j * α - rX) * v +
        (algebraMap ↥W A μ * σ * b₁ * u ^ t) * u ^ (kX + 1),
      Ideal.mem_span_pair.mpr ⟨_, _, rfl⟩,
      algebraMap ↥W A μ * σ * u ^ j * yv - algebraMap ↥W A wX * gX,
      Ideal.sub_mem _ (Ideal.mul_mem_left _ _ hy) (Ideal.mul_mem_right _ _ (hmapA wX hwX)), ?_⟩
    linear_combination (-(algebraMap ↥W A μ * σ * u ^ j)) * hXd + algebraMap ↥W A μ * EB +
      (u ^ kX * εX + v * rX + algebraMap ↥W A wX * gX) * hμA -
      (algebraMap ↥W A μ * σ * b₁) * hut
  refine ⟨h * algebraMap A K ρ / algebraMap A K x, w', n + ℓ * em + j, kX,
    algebraMap ↥W A lX * εX, σ * εD, algebraMap ↥W A lX * rX, σ * u ^ j * rD,
    algebraMap ↥W A lX * (algebraMap ↥W A d₂ * gX), algebraMap ↥W A d₁ * (σ * u ^ j * gD),
    hh'', ⟨hl1, hl2, hw', h𝔭p.mul_notMem hlX𝔭 hεX, h𝔭p.mul_notMem hσ hεD, ?_⟩, ?_⟩
  · rw [hD', hBX'']
    simp only [map_mul, map_pow]
    linear_combination (algebraMap A K σ * algebraMap A K u ^ j) * KI +
      algebraMap A K (algebraMap ↥W A lam₁) * EB'
  · push_cast
    omega

theorem wcpa_dj_llsm_kpwulb_below_cap : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ (f' : K) (a s : A), a ∉ 𝔭 → s ∉ 𝔭 → f' * algebraMap A K s = algebraMap A K a →
    ∀ (h : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A), h ≠ 0 →
      (lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀ ∉ 𝔭 ∧ ε₁ ∉ 𝔭 ∧
        (f' / h ^ ℓ - 1) * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) *
          algebraMap A K (algebraMap ↥W A lam₂) =
        algebraMap A K (algebraMap ↥W A lam₁) *
          algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀)) →
      lam₂ ∣ lam₁ → (lam₁ ∣ lam₂ → n < k) →
      ¬ lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∣ lam₁ ^ (ℓ - 1) →
      (∀ (h' : K) (lam₁' lam₂' w' : ↥W) (n' k' : ℕ) (ε₀' ε₁' r₀' r₁' g₀' g₁' : A), h' ≠ 0 →
        (lam₁' ≠ 0 ∧ lam₂' ≠ 0 ∧ w' ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀' ∉ 𝔭 ∧ ε₁' ∉ 𝔭 ∧
          (f' / h' ^ ℓ - 1) *
              algebraMap A K (u ^ n' * ε₁' + v * r₁' + algebraMap ↥W A w' * g₁') *
            algebraMap A K (algebraMap ↥W A lam₂') =
          algebraMap A K (algebraMap ↥W A lam₁') *
            algebraMap A K (u ^ k' * ε₀' + v * r₀' + algebraMap ↥W A w' * g₀')) →
        lam₁' * lam₂ ∣ lam₁ * lam₂') →
      ∃ (h' : K) (lam₁' lam₂' w' : ↥W) (n' k' : ℕ) (ε₀' ε₁' r₀' r₁' g₀' g₁' : A), h' ≠ 0 ∧
        (lam₁' ≠ 0 ∧ lam₂' ≠ 0 ∧ w' ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀' ∉ 𝔭 ∧ ε₁' ∉ 𝔭 ∧
          (f' / h' ^ ℓ - 1) *
              algebraMap A K (u ^ n' * ε₁' + v * r₁' + algebraMap ↥W A w' * g₁') *
            algebraMap A K (algebraMap ↥W A lam₂') =
          algebraMap A K (algebraMap ↥W A lam₁') *
            algebraMap A K (u ^ k' * ε₀' + v * r₀' + algebraMap ↥W A w' * g₀')) ∧
        lam₂' ∣ lam₁' ∧ (lam₁' ∣ lam₂' → n' < k') ∧
        ¬ lam₂' ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∣ lam₁' ^ (ℓ - 1) ∧
        ¬ (ℓ : ℤ) ∣ ((k' : ℤ) - n') :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ 𝔭 u v g hPD f' a s ha hs hf h lam₁ lam₂ w n k
    ε₀ ε₁ r₀ r₁ g₀ g₁ hh hNF hd hP0 hnGE hMAX
  obtain ⟨J, hJ⟩ := wcpa_dj_llsm_kpwulbc_order_bound Ω W hW hWt ℓ hℓ hΩ hκ A K 𝔭 u v g hPD
    f' a s ha hs hf h lam₁ lam₂ w n k ε₀ ε₁ r₀ r₁ g₀ g₁ hh hNF hd hP0 hnGE hMAX
  have claim : ∀ D : ℕ, ∀ (h₁ : K) (w₁ : ↥W) (n₁ k₁ : ℕ) (e0 e1 q0 q1 p0 p1 : A), h₁ ≠ 0 →
      (lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w₁ ∈ IsLocalRing.maximalIdeal ↥W ∧ e0 ∉ 𝔭 ∧ e1 ∉ 𝔭 ∧
        (f' / h₁ ^ ℓ - 1) * algebraMap A K (u ^ n₁ * e1 + v * q1 + algebraMap ↥W A w₁ * p1) *
          algebraMap A K (algebraMap ↥W A lam₂) =
        algebraMap A K (algebraMap ↥W A lam₁) *
          algebraMap A K (u ^ k₁ * e0 + v * q0 + algebraMap ↥W A w₁ * p0)) →
      (lam₁ ∣ lam₂ → n₁ < k₁) → n₁ + J - k₁ ≤ D →
      ∃ (h' : K) (lam₁' lam₂' w' : ↥W) (n' k' : ℕ) (ε₀' ε₁' r₀' r₁' g₀' g₁' : A), h' ≠ 0 ∧
        (lam₁' ≠ 0 ∧ lam₂' ≠ 0 ∧ w' ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀' ∉ 𝔭 ∧ ε₁' ∉ 𝔭 ∧
          (f' / h' ^ ℓ - 1) *
              algebraMap A K (u ^ n' * ε₁' + v * r₁' + algebraMap ↥W A w' * g₁') *
            algebraMap A K (algebraMap ↥W A lam₂') =
          algebraMap A K (algebraMap ↥W A lam₁') *
            algebraMap A K (u ^ k' * ε₀' + v * r₀' + algebraMap ↥W A w' * g₀')) ∧
        lam₂' ∣ lam₁' ∧ (lam₁' ∣ lam₂' → n' < k') ∧
        ¬ lam₂' ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∣ lam₁' ^ (ℓ - 1) ∧
        ¬ (ℓ : ℤ) ∣ ((k' : ℤ) - n') := by
    intro D
    induction D using Nat.strong_induction_on with
    | _ D ih =>
      intro h₁ w₁ n₁ k₁ e0 e1 q0 q1 p0 p1 hh₁ hNF₁ hP₁ hD
      by_cases hdiv : (ℓ : ℤ) ∣ ((k₁ : ℤ) - n₁)
      · obtain ⟨h₂, w₂, n₂, k₂, e0', e1', q0', q1', p0', p1', hh₂, hNF₂, hlt⟩ :=
          wcpa_dj_llsm_kpwulbc_kummer_step Ω W hW hWt ℓ hℓ hΩ hκ A K 𝔭 u v g hPD f' a s ha hs hf
            h₁ lam₁ lam₂ w₁ n₁ k₁ e0 e1 q0 q1 p0 p1 hh₁ hNF₁ hd hP₁ hnGE hMAX hdiv
        have hP₂ : lam₁ ∣ lam₂ → n₂ < k₂ := fun h12 => by
          have := hP₁ h12
          omega
        have hb₁ := hJ h₁ w₁ n₁ k₁ e0 e1 q0 q1 p0 p1 hh₁ hNF₁ hP₁
        have hb₂ := hJ h₂ w₂ n₂ k₂ e0' e1' q0' q1' p0' p1' hh₂ hNF₂ hP₂
        exact ih (n₂ + J - k₂) (by omega) h₂ w₂ n₂ k₂ e0' e1' q0' q1' p0' p1' hh₂ hNF₂ hP₂ le_rfl
      · exact ⟨h₁, lam₁, lam₂, w₁, n₁, k₁, e0, e1, q0, q1, p0, p1, hh₁, hNF₁, hd, hP₁, hnGE, hdiv⟩
  exact claim _ h w n k ε₀ ε₁ r₀ r₁ g₀ g₁ hh hNF hP0 le_rfl

theorem wcpa_dj_llsm_kpwulbc_cap_binom : ∀ (R : Type u) [CommRing R] (ℓ : ℕ), ℓ.Prime → ∀ x y c : R, c ^ (ℓ - 1) = ((ℓ : ℕ) : R) → ∃ Q : R, (x + c * y) ^ ℓ = x ^ ℓ + c ^ ℓ * (y * x ^ (ℓ - 1) + y ^ ℓ + c * Q) :=
by
  intro R _ ℓ hℓ x y c hc
  obtain ⟨m, rfl⟩ : ∃ m, ℓ = m + 2 := ⟨ℓ - 2, by have := hℓ.two_le; omega⟩
  have h1 : m + 2 - 1 = m + 1 := by omega
  rw [h1] at hc ⊢
  have hb : ∀ i ∈ Finset.range m, (((m + 2).choose (i + 1 + 1) : ℕ) : R)
      = c ^ (m + 1) * (((m + 2).choose (i + 2) / (m + 2) : ℕ) : R) := by
    intro i hi
    have hi' := Finset.mem_range.mp hi
    have hd : (m + 2) ∣ (m + 2).choose (i + 2) := hℓ.dvd_choose_self (by omega) (by omega)
    rw [hc, ← Nat.cast_mul, Nat.mul_div_cancel' hd]
  refine ⟨∑ i ∈ Finset.range m,
    (((m + 2).choose (i + 2) / (m + 2) : ℕ) : R) * c ^ i * y ^ (i + 2) * x ^ (m - i), ?_⟩
  have hmid : ∑ i ∈ Finset.range m, (c * y) ^ (i + 1 + 1) * x ^ (m + 2 - (i + 1 + 1)) *
      (((m + 2).choose (i + 1 + 1) : ℕ) : R)
      = c ^ (m + 2) * (c * ∑ i ∈ Finset.range m,
        (((m + 2).choose (i + 2) / (m + 2) : ℕ) : R) * c ^ i * y ^ (i + 2) * x ^ (m - i)) := by
    rw [Finset.mul_sum, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i hi
    rw [hb i hi, show m + 2 - (i + 1 + 1) = m - i by omega]
    ring
  rw [add_comm x (c * y), add_pow, Finset.sum_range_succ, Finset.sum_range_succ',
    Finset.sum_range_succ', hmid]
  simp only [zero_add, pow_one, Nat.choose_one_right, Nat.choose_zero_right, Nat.choose_self,
    pow_zero, Nat.cast_one, mul_one, one_mul, Nat.sub_zero, Nat.sub_self, h1]
  linear_combination (-(c * y * x ^ (m + 1))) * hc

theorem wcpa_dj_llsm_kpwulb_cap_step : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ (f' : K) (a s : A), a ∉ 𝔭 → s ∉ 𝔭 → f' * algebraMap A K s = algebraMap A K a →
    ∀ (h : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A), h ≠ 0 →
      (lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀ ∉ 𝔭 ∧ ε₁ ∉ 𝔭 ∧
        (f' / h ^ ℓ - 1) * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) *
          algebraMap A K (algebraMap ↥W A lam₂) =
        algebraMap A K (algebraMap ↥W A lam₁) *
          algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀)) →
      lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∣ lam₁ ^ (ℓ - 1) →
      lam₁ ^ (ℓ - 1) ∣ lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ → k < n →
      ∃ h' : K, h' ≠ 0 ∧ (f' / h' ^ ℓ - 1 = 0 ∨
        ∃ (lam₁' lam₂' w' : ↥W) (n' k' : ℕ) (ε₀' ε₁' r₀' r₁' g₀' g₁' : A),
          (lam₁' ≠ 0 ∧ lam₂' ≠ 0 ∧ w' ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀' ∉ 𝔭 ∧ ε₁' ∉ 𝔭 ∧
            (f' / h' ^ ℓ - 1) *
                algebraMap A K (u ^ n' * ε₁' + v * r₁' + algebraMap ↥W A w' * g₁') *
              algebraMap A K (algebraMap ↥W A lam₂') =
            algebraMap A K (algebraMap ↥W A lam₁') *
              algebraMap A K (u ^ k' * ε₀' + v * r₀' + algebraMap ↥W A w' * g₀')) ∧
          lam₂' ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∣ lam₁' ^ (ℓ - 1) ∧
          (n' ≤ k' ∨ ¬ lam₁' ^ (ℓ - 1) ∣ lam₂' ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∨
            ¬ (ℓ : ℤ) ∣ ((k' : ℤ) - n'))) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ 𝔭 u v g hPD f' a s ha hs hf
  classical
  have hℓ2 : 2 ≤ ℓ := hℓ.two_le
  have hℓ1' : ℓ - 1 ≠ 0 := by omega
  have hPD' := hPD
  obtain ⟨hFT, hNZ, -, h𝔭max, hm𝔭, hgm, hg0, huv, hpeq, -⟩ := hPD'
  haveI := hNZ
  have h𝔭p : 𝔭.IsPrime := h𝔭max.isPrime
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h => h𝔭p.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have haW0 : ∀ c : ↥W, c ≠ 0 → algebraMap ↥W A c ≠ 0 := by
    intro c hc h0
    rw [Algebra.algebraMap_eq_smul_one] at h0
    rcases smul_eq_zero.mp h0 with h1 | h1
    · exact hc h1
    · exact one_ne_zero h1
  have hι0 : ∀ c : ↥W, c ≠ 0 → algebraMap A K (algebraMap ↥W A c) ≠ 0 := fun c hc h0 =>
    haW0 c hc (IsFractionRing.injective A K (by rw [h0, map_zero]))
  have hu0 : u ≠ 0 := fun h0 => haW0 g hg0 (by rw [← huv, h0, zero_mul])
  have hU0 : algebraMap A K u ≠ 0 := fun h0 =>
    hu0 (IsFractionRing.injective A K (by rw [h0, map_zero]))
  have hroot : ∀ x : ↥W, ∀ M : ℕ, 0 < M → ∃ y : ↥W, y ^ M = x ∧
      (x ∈ IsLocalRing.maximalIdeal ↥W → y ∈ IsLocalRing.maximalIdeal ↥W) ∧ (x ≠ 0 → y ≠ 0) := by
    intro x M hM
    obtain ⟨y₀, hy₀⟩ := IsAlgClosed.exists_pow_nat_eq (x : Ω) hM
    have hy₀W : y₀ ∈ W := by
      rcases W.mem_or_inv_mem y₀ with h1 | h1
      · exact h1
      · by_cases hy0 : y₀ = 0
        · rw [hy0]; exact W.toSubring.zero_mem
        · obtain ⟨M', rfl⟩ : ∃ M', M = M' + 1 := ⟨M - 1, by omega⟩
          have e : y₀ = (x : Ω) * (y₀⁻¹) ^ M' := by
            rw [← hy₀, pow_succ, mul_comm (y₀ ^ M') y₀, mul_assoc, ← mul_pow,
              mul_inv_cancel₀ hy0, one_pow, mul_one]
          rw [e]
          exact W.toSubring.mul_mem x.2 (W.toSubring.pow_mem h1 _)
    refine ⟨⟨y₀, hy₀W⟩, ?_, ?_, ?_⟩
    · apply Subtype.ext
      rw [SubmonoidClass.coe_pow]
      exact hy₀
    · intro hx
      have hyx : (⟨y₀, hy₀W⟩ : ↥W) ^ M = x := Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hy₀)
      rw [← hyx] at hx
      exact Ideal.IsPrime.mem_of_pow_mem inferInstance M hx
    · intro hx hy
      apply hx
      have hyx : (⟨y₀, hy₀W⟩ : ↥W) ^ M = x := Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hy₀)
      rw [← hyx, hy, zero_pow hM.ne']
  have hV2 : ∀ (N : ℕ) (x y : ↥W), N ≠ 0 → x ^ N ∣ y ^ N → x ∣ y := by
    intro N x y hN hxy
    rcases ValuationRing.dvd_total x y with h | h
    · exact h
    · obtain ⟨z, rfl⟩ := h
      by_cases hy : y = 0
      · rw [hy]; exact dvd_zero _
      · rw [mul_pow] at hxy
        have h2 : y ^ N * z ^ N ∣ y ^ N * 1 := by rwa [mul_one]
        have h3 : z ^ N ∣ 1 := (mul_dvd_mul_iff_left (pow_ne_zero N hy)).mp h2
        have hzu : IsUnit z := (isUnit_pow_iff hN).mp (isUnit_of_dvd_one h3)
        exact (hzu.mul_right_dvd).mpr dvd_rfl
  have hℓW0 : ((ℓ : ℕ) : ↥W) ≠ 0 := by
    intro h0
    have h1 : ((ℓ : ℕ) : Ω) = 0 := by
      have := congrArg W.subtype h0
      rwa [map_natCast, map_zero] at this
    have h2 := (ringChar.spec Ω ℓ).mp h1
    rcases (Nat.dvd_prime hℓ).mp h2 with h | h
    · exact CharP.ringChar_ne_one h
    · exact hΩ h
  have hℓWm : ((ℓ : ℕ) : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [← IsLocalRing.residue_eq_zero_iff, map_natCast]
    exact (ringChar.spec _ ℓ).mpr (by rw [hκ])
  obtain ⟨c₀, hc₀, hc₀m', hc₀0'⟩ := hroot ((ℓ : ℕ) : ↥W) (ℓ - 1) (by omega)
  have hc₀0 : c₀ ≠ 0 := hc₀0' hℓW0
  have hc₀m : c₀ ∈ IsLocalRing.maximalIdeal ↥W := hc₀m' hℓWm
  have hc₀pow : ∀ x : ↥W, (x * c₀ ^ ℓ) ^ (ℓ - 1) = x ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ := by
    intro x
    rw [mul_pow, ← pow_mul, mul_comm ℓ (ℓ - 1), pow_mul, hc₀]
  have hcA : (algebraMap ↥W A c₀) ^ (ℓ - 1) = ((ℓ : ℕ) : A) := by
    rw [← map_pow, hc₀, map_natCast]
  have hc₀ℓm : c₀ ^ ℓ ∈ IsLocalRing.maximalIdeal ↥W := Ideal.pow_mem_of_mem _ hc₀m ℓ hℓ.pos
  have hc₀ℓℓ : (c₀ ^ ℓ) ^ (ℓ - 1) = ((ℓ : ℕ) : ↥W) ^ ℓ := by
    rw [← pow_mul, mul_comm, pow_mul, hc₀]

  obtain ⟨J, hJ⟩ : ∃ J : Ideal A,
      J = Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := ⟨_, rfl⟩
  have hJm : ∀ μ ∈ IsLocalRing.maximalIdeal ↥W, ∀ z : A, algebraMap ↥W A μ * z ∈ J := by
    intro μ hμ z
    rw [hJ]
    exact Ideal.mem_sup_right (Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hμ))
  have hJv : ∀ z : A, v * z ∈ J := by
    intro z
    rw [hJ]
    exact Ideal.mem_sup_left (Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_singleton v)))
  have hJmA : ∀ y ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A), ∀ z : A, z * y ∈ J := by
    intro y hy z
    rw [hJ]
    exact Ideal.mem_sup_right (Ideal.mul_mem_left _ _ hy)
  have hJc : ∀ y ∈ J, ∃ (r g' : A) (w : ↥W), w ∈ IsLocalRing.maximalIdeal ↥W ∧
      y = v * r + algebraMap ↥W A w * g' := by
    intro y hy
    rw [hJ, Submodule.mem_sup] at hy
    obtain ⟨y₁, hy₁, y₂, hy₂, rfl⟩ := hy
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hy₁
    have key : ∀ z ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A),
        ∃ μ ∈ IsLocalRing.maximalIdeal ↥W, ∃ r : A, z = algebraMap ↥W A μ * r := by
      intro z hz
      induction hz using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨μ, hμ, rfl⟩ := hx
        exact ⟨μ, hμ, 1, (mul_one _).symm⟩
      | zero => exact ⟨0, Ideal.zero_mem _, 0, by simp⟩
      | add x y _ _ hx hy =>
        obtain ⟨μ₁, hμ₁, r₁, rfl⟩ := hx
        obtain ⟨μ₂, hμ₂, r₂, rfl⟩ := hy
        rcases ValuationRing.dvd_total μ₁ μ₂ with ⟨q, rfl⟩ | ⟨q, rfl⟩
        · exact ⟨μ₁, hμ₁, r₁ + algebraMap ↥W A q * r₂, by rw [map_mul]; ring⟩
        · exact ⟨μ₂, hμ₂, algebraMap ↥W A q * r₁ + r₂, by rw [map_mul]; ring⟩
      | smul b x _ hx =>
        obtain ⟨μ, hμ, r, rfl⟩ := hx
        exact ⟨μ, hμ, b * r, by rw [smul_eq_mul]; ring⟩
    obtain ⟨μ, hμ, r₂, rfl⟩ := key y₂ hy₂
    exact ⟨r, r₂, μ, hμ, by ring⟩
  have hBR : ∀ (Z ε : A) (e : ℕ), Z - u ^ e * ε ∈ J → ∃ (r g' : A) (w : ↥W),
      w ∈ IsLocalRing.maximalIdeal ↥W ∧ Z = u ^ e * ε + v * r + algebraMap ↥W A w * g' := by
    intro Z ε e hZ
    obtain ⟨r, g', w, hw, he⟩ := hJc _ hZ
    exact ⟨r, g', w, hw, by linear_combination he⟩
  have hCW : ∀ w₁ w₂ : ↥W, w₁ ∈ IsLocalRing.maximalIdeal ↥W → w₂ ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ w d₁ d₂ : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W ∧ w₁ = w * d₁ ∧ w₂ = w * d₂ := by
    intro w₁ w₂ hw₁ hw₂
    rcases ValuationRing.dvd_total w₁ w₂ with ⟨d, hd⟩ | ⟨d, hd⟩
    · exact ⟨w₁, 1, d, hw₁, (mul_one _).symm, hd⟩
    · exact ⟨w₂, d, 1, hw₂, hd, (mul_one _).symm⟩

  have MAIN : ∀ N : ℕ, ∀ (h : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A),
      n - k = N → h ≠ 0 →
      (lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀ ∉ 𝔭 ∧ ε₁ ∉ 𝔭 ∧
        (f' / h ^ ℓ - 1) * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) *
          algebraMap A K (algebraMap ↥W A lam₂) =
        algebraMap A K (algebraMap ↥W A lam₁) *
          algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀)) →
      lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∣ lam₁ ^ (ℓ - 1) → k < n →
      ∃ h' : K, h' ≠ 0 ∧ (f' / h' ^ ℓ - 1 = 0 ∨
        ∃ (lam₁' lam₂' w' : ↥W) (n' k' : ℕ) (ε₀' ε₁' r₀' r₁' g₀' g₁' : A),
          (lam₁' ≠ 0 ∧ lam₂' ≠ 0 ∧ w' ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀' ∉ 𝔭 ∧ ε₁' ∉ 𝔭 ∧
            (f' / h' ^ ℓ - 1) *
                algebraMap A K (u ^ n' * ε₁' + v * r₁' + algebraMap ↥W A w' * g₁') *
              algebraMap A K (algebraMap ↥W A lam₂') =
            algebraMap A K (algebraMap ↥W A lam₁') *
              algebraMap A K (u ^ k' * ε₀' + v * r₀' + algebraMap ↥W A w' * g₀')) ∧
          lam₂' ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∣ lam₁' ^ (ℓ - 1) ∧
          (n' ≤ k' ∨ ¬ lam₁' ^ (ℓ - 1) ∣ lam₂' ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∨
            ¬ (ℓ : ℤ) ∣ ((k' : ℤ) - n'))) := by
    intro N
    induction N using Nat.strong_induction_on with
    | _ N IH =>
    intro h lam₁ lam₂ w n k ε₀ ε₁ r₀ r₁ g₀ g₁ hN hh hNF hGE hkn
    obtain ⟨hl1, hl2, hw, he0, he1, hE⟩ := hNF
    by_cases hdvd : (ℓ : ℤ) ∣ ((k : ℤ) - n)
    swap
    · exact ⟨h, hh, Or.inr ⟨lam₁, lam₂, w, n, k, ε₀, ε₁, r₀, r₁, g₀, g₁,
        ⟨hl1, hl2, hw, he0, he1, hE⟩, hGE, Or.inr (Or.inr hdvd)⟩⟩
    obtain ⟨M, rfl⟩ : ∃ M, n = k + M := ⟨n - k, by omega⟩
    obtain ⟨q', hq'⟩ : ℓ ∣ M := by
      have h1 : (ℓ : ℤ) ∣ ((M : ℕ) : ℤ) := by
        have : ((M : ℕ) : ℤ) = -((k : ℤ) - ((k + M : ℕ) : ℤ)) := by push_cast; ring
        rw [this]
        exact dvd_neg.mpr hdvd
      exact Int.natCast_dvd_natCast.mp h1
    have hq1 : 0 < q' := by
      rcases Nat.eq_zero_or_pos q' with h0 | h0
      · rw [h0, mul_zero] at hq'; omega
      · exact h0
    obtain ⟨q, hq⟩ : ∃ q, q + 1 = q' * (ℓ - 1) := by
      have : 1 ≤ q' * (ℓ - 1) := Nat.one_le_iff_ne_zero.mpr (mul_ne_zero hq1.ne' hℓ1')
      exact ⟨q' * (ℓ - 1) - 1, by omega⟩

    have h1 : lam₂ * c₀ ^ ℓ ∣ lam₁ := hV2 (ℓ - 1) _ _ hℓ1' (by rw [hc₀pow]; exact hGE)
    obtain ⟨τ, hτ⟩ := h1
    have hF : (f' / h ^ ℓ - 1) *
        algebraMap A K (u ^ (k + M) * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) =
        algebraMap A K (algebraMap ↥W A c₀) ^ ℓ * algebraMap A K (algebraMap ↥W A τ) *
          algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀) := by
      apply mul_right_cancel₀ (hι0 lam₂ hl2)
      rw [hE, hτ]
      simp only [map_mul, map_pow]
      ring
    obtain ⟨B₀, hB₀⟩ : ∃ B : A, B = u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀ := ⟨_, rfl⟩
    obtain ⟨B₁, hB₁⟩ : ∃ B : A, B = u ^ (k + M) * ε₁ + v * r₁ + algebraMap ↥W A w * g₁ :=
      ⟨_, rfl⟩
    rw [← hB₀, ← hB₁] at hF

    obtain ⟨y₁, i₁, hi₁, hyx⟩ := Ideal.IsMaximal.exists_inv h𝔭max he1
    obtain ⟨β, hβ⟩ := wcpa_dj_llsm_kptf_residue_trivial Ω W A 𝔭 hFT h𝔭max hm𝔭
      (algebraMap ↥W A τ * ε₀ * y₁)
    obtain ⟨γ, hγ, -, -⟩ := hroot β ℓ hℓ.pos
    have hδ : algebraMap ↥W A τ * ε₀ - algebraMap ↥W A γ ^ ℓ * ε₁ ∈ 𝔭 := by
      have e : algebraMap ↥W A τ * ε₀ - algebraMap ↥W A γ ^ ℓ * ε₁ =
          (algebraMap ↥W A τ * ε₀ * y₁ - algebraMap ↥W A β) * ε₁ +
            algebraMap ↥W A τ * ε₀ * i₁ := by
        rw [← map_pow, hγ]
        linear_combination (-(algebraMap ↥W A τ * ε₀)) * hyx
      rw [e]
      exact 𝔭.add_mem (𝔭.mul_mem_right _ hβ) (𝔭.mul_mem_left _ hi₁)
    rw [hpeq, Submodule.mem_sup] at hδ
    obtain ⟨z₁, hz₁, y, hy, hδ'⟩ := hδ
    obtain ⟨α, b, hαb⟩ := Ideal.mem_span_pair.mp hz₁

    obtain ⟨Q, hQ⟩ := wcpa_dj_llsm_kpwulbc_cap_binom A ℓ hℓ (u ^ q') (algebraMap ↥W A γ)
      (algebraMap ↥W A c₀) hcA
    obtain ⟨p, hp⟩ : ∃ p : A, p = u ^ q' + algebraMap ↥W A c₀ * algebraMap ↥W A γ := ⟨_, rfl⟩
    obtain ⟨E, hEdef⟩ : ∃ E : A, E = algebraMap ↥W A γ * u ^ (q + 1) +
        algebraMap ↥W A γ ^ ℓ + algebraMap ↥W A c₀ * Q := ⟨_, rfl⟩
    have hu1 : (u ^ q') ^ ℓ = u ^ M := by rw [← pow_mul, hq', mul_comm]
    have hu2 : (u ^ q') ^ (ℓ - 1) = u ^ (q + 1) := by rw [← pow_mul, hq]
    have hpE : p ^ ℓ = u ^ M + algebraMap ↥W A c₀ ^ ℓ * E := by
      rw [hp, hQ, hEdef, hu1, hu2]
    have hp0 : algebraMap A K p ≠ 0 := by
      intro h0
      have hp0' : p = 0 := IsFractionRing.injective A K (by rw [h0, map_zero])
      apply wcpa_dj_llsm_kpwulbc_branch_upow Ω W A 𝔭 u v g hPD q' 1 h1𝔭
      rw [← hJ]
      have e : 1 * u ^ q' = algebraMap ↥W A c₀ * (-algebraMap ↥W A γ) := by
        rw [hp] at hp0'
        linear_combination hp0'
      rw [e]
      exact hJm c₀ hc₀m _
    have hD0 : algebraMap A K u ^ q' ≠ 0 := pow_ne_zero _ hU0
    obtain ⟨h', hh'def⟩ : ∃ h' : K, h' = h * algebraMap A K p / algebraMap A K u ^ q' :=
      ⟨_, rfl⟩
    have hh' : h' ≠ 0 := by
      rw [hh'def]; exact div_ne_zero (mul_ne_zero hh hp0) hD0
    have hu1K : (algebraMap A K u ^ q') ^ ℓ = algebraMap A K u ^ M := by
      rw [← pow_mul, hq', mul_comm]
    have key : f' / h' ^ ℓ * algebraMap A K p ^ ℓ = f' / h ^ ℓ * algebraMap A K u ^ M := by
      rw [hh'def, div_pow, mul_pow, ← hu1K]
      field_simp
    have hpK : algebraMap A K p ^ ℓ = algebraMap A K u ^ M +
        algebraMap A K (algebraMap ↥W A c₀) ^ ℓ * algebraMap A K E := by
      have := congrArg (algebraMap A K) hpE
      simpa only [map_pow, map_add, map_mul] using this
    obtain ⟨X, hXdef⟩ : ∃ X : A, X = algebraMap ↥W A τ * u ^ M * B₀ - E * B₁ := ⟨_, rfl⟩
    have hX : (f' / h' ^ ℓ - 1) * algebraMap A K (p ^ ℓ * B₁) =
        algebraMap A K (algebraMap ↥W A c₀) ^ ℓ * algebraMap A K X := by
      rw [hXdef]
      simp only [map_sub, map_mul, map_pow]
      linear_combination algebraMap A K B₁ * key + algebraMap A K u ^ M * hF -
        algebraMap A K B₁ * hpK
    have hX' := hX
    simp only [map_mul, map_pow] at hX'

    obtain ⟨Y, hYdef⟩ : ∃ Y : A, Y = α - algebraMap ↥W A γ * u ^ q * ε₁ := ⟨_, rfl⟩
    obtain ⟨P₀, hP₀⟩ : ∃ P : A, P = v * (u ^ (k + M) * b + algebraMap ↥W A τ * u ^ M * r₀ - E * r₁) +
        u ^ (k + M) * y + algebraMap ↥W A c₀ * (-(Q * u ^ (k + M) * ε₁)) +
        algebraMap ↥W A w * (algebraMap ↥W A τ * u ^ M * g₀ - E * g₁) := ⟨_, rfl⟩
    have hP0J : P₀ ∈ J := by
      rw [hP₀]
      exact J.add_mem (J.add_mem (J.add_mem (hJv _) (hJmA y hy _)) (hJm c₀ hc₀m _)) (hJm w hw _)
    have hXd : X = u ^ (k + M + 1) * Y + P₀ := by
      rw [hXdef, hB₀, hB₁, hYdef, hP₀]
      linear_combination (-u ^ (k + M)) * hδ' - u ^ (k + M) * hαb - u ^ (k + M) * ε₁ * hEdef
    have hB1side : ∀ σ : A, σ * (p ^ ℓ * B₁) - u ^ (k + M + M) * (σ * ε₁) ∈ J := by
      intro σ
      have e : σ * (p ^ ℓ * B₁) - u ^ (k + M + M) * (σ * ε₁) =
          algebraMap ↥W A (c₀ ^ ℓ) * (σ * E * u ^ (k + M) * ε₁) + v * (σ * p ^ ℓ * r₁) +
            algebraMap ↥W A w * (σ * p ^ ℓ * g₁) := by
        rw [hB₁, map_pow]
        linear_combination σ * u ^ (k + M) * ε₁ * hpE
      rw [e]
      exact J.add_mem (J.add_mem (hJm _ hc₀ℓm _) (hJv _)) (hJm w hw _)
    have hGE' : (1 : ↥W) ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∣ (c₀ ^ ℓ) ^ (ℓ - 1) := by
      rw [one_pow, one_mul, hc₀ℓℓ]

    rcases wcpa_dj_llsm_kpwulbc_branch_dichotomy Ω W A 𝔭 u v g hPD Y with
      ⟨t, ht, htY⟩ | ⟨e, σ, ε, hσ, hε, hσY⟩
    ·
      rw [← hJ] at htY
      have htX : t * X ∈ J := by
        rw [hXd, mul_add, show t * (u ^ (k + M + 1) * Y) = u ^ (k + M + 1) * (t * Y) by ring]
        exact J.add_mem (J.mul_mem_left _ htY) (J.mul_mem_left _ hP0J)
      have h1c : (1 + c₀ ^ ℓ) ∉ IsLocalRing.maximalIdeal ↥W := by
        intro hm
        have h1m := Ideal.sub_mem _ hm hc₀ℓm
        rw [add_sub_cancel_right] at h1m
        exact (IsLocalRing.notMem_maximalIdeal.mpr isUnit_one) h1m
      have h1cu : IsUnit (1 + c₀ ^ ℓ) := IsLocalRing.notMem_maximalIdeal.mp h1c
      obtain ⟨ρ, hρ, -, -⟩ := hroot (1 + c₀ ^ ℓ) ℓ hℓ.pos
      have hρ0 : ρ ≠ 0 := by
        rintro rfl
        rw [zero_pow hℓ.ne_zero] at hρ
        exact h1cu.ne_zero hρ.symm
      have hιρ : algebraMap A K (algebraMap ↥W A ρ) ≠ 0 := hι0 ρ hρ0
      have hh'' : h' * algebraMap A K (algebraMap ↥W A ρ) ≠ 0 := mul_ne_zero hh' hιρ
      have hρK : algebraMap A K (algebraMap ↥W A ρ) ^ ℓ =
          1 + algebraMap A K (algebraMap ↥W A c₀) ^ ℓ := by
        have := congrArg (fun x => algebraMap A K (algebraMap ↥W A x)) hρ
        simpa only [map_pow, map_add, map_one] using this
      have key2 : f' / (h' * algebraMap A K (algebraMap ↥W A ρ)) ^ ℓ *
          algebraMap A K (algebraMap ↥W A ρ) ^ ℓ = f' / h' ^ ℓ := by
        rw [mul_pow]
        field_simp
      have hFF : (f' / (h' * algebraMap A K (algebraMap ↥W A ρ)) ^ ℓ - 1) *
          algebraMap A K (algebraMap ↥W A ρ) ^ ℓ =
          (f' / h' ^ ℓ - 1) - algebraMap A K (algebraMap ↥W A c₀) ^ ℓ := by
        linear_combination key2 - hρK
      obtain ⟨r₁', gg₁, w₁, hw₁, hZ1⟩ := hBR _ _ _ (hB1side t)
      have hZ0m : (t * X - t * (p ^ ℓ * B₁)) - u ^ (k + M + M) * (-(t * ε₁)) ∈ J := by
        have e1 : (t * X - t * (p ^ ℓ * B₁)) - u ^ (k + M + M) * (-(t * ε₁)) =
            t * X - (t * (p ^ ℓ * B₁) - u ^ (k + M + M) * (t * ε₁)) := by ring
        rw [e1]
        exact J.sub_mem htX (hB1side t)
      obtain ⟨r₀', gg₀, w₂, hw₂, hZ0⟩ := hBR _ _ _ hZ0m
      obtain ⟨w', d₁, d₂, hw', hd₁, hd₂⟩ := hCW w₁ w₂ hw₁ hw₂
      have htε : t * ε₁ ∉ 𝔭 := h𝔭p.mul_notMem ht he1
      refine ⟨h' * algebraMap A K (algebraMap ↥W A ρ), hh'', Or.inr ⟨c₀ ^ ℓ, 1 + c₀ ^ ℓ, w',
        k + M + M, k + M + M, -(t * ε₁), t * ε₁, r₀', r₁', algebraMap ↥W A d₂ * gg₀,
        algebraMap ↥W A d₁ * gg₁, ⟨pow_ne_zero _ hc₀0, h1cu.ne_zero, hw',
        fun hm => htε (neg_mem_iff.mp hm), htε, ?_⟩, ?_, Or.inl le_rfl⟩⟩
      · have h1 : u ^ (k + M + M) * (t * ε₁) + v * r₁' + algebraMap ↥W A w' * (algebraMap ↥W A d₁ * gg₁) =
            t * (p ^ ℓ * B₁) := by
          rw [hZ1, hd₁, map_mul]; ring
        have h2 : u ^ (k + M + M) * -(t * ε₁) + v * r₀' + algebraMap ↥W A w' * (algebraMap ↥W A d₂ * gg₀) =
            t * X - t * (p ^ ℓ * B₁) := by
          rw [hZ0, hd₂, map_mul]; ring
        rw [h1, h2]
        simp only [map_add, map_one, map_pow, map_mul, map_sub]
        linear_combination (algebraMap A K t * (algebraMap A K p ^ ℓ * algebraMap A K B₁)) * hFF +
          algebraMap A K t * hX' -
          ((f' / (h' * algebraMap A K (algebraMap ↥W A ρ)) ^ ℓ - 1) * algebraMap A K t *
            (algebraMap A K p ^ ℓ * algebraMap A K B₁)) * hρK
      · rw [hc₀ℓℓ]
        exact ((h1cu.pow _).mul_left_dvd).mpr dvd_rfl
    ·
      rw [← hJ] at hσY
      have hσX : σ * X - u ^ (k + M + 1 + e) * ε ∈ J := by
        have e1 : σ * X - u ^ (k + M + 1 + e) * ε =
            u ^ (k + M + 1) * (σ * Y - u ^ e * ε) + σ * P₀ := by
          rw [hXd]; ring
        rw [e1]
        exact J.add_mem (J.mul_mem_left _ hσY) (J.mul_mem_left _ hP0J)
      obtain ⟨r₀', gg₀, w₂, hw₂, hZ0⟩ := hBR _ _ _ hσX
      obtain ⟨r₁', gg₁, w₁, hw₁, hZ1⟩ := hBR _ _ _ (hB1side σ)
      obtain ⟨w', d₁, d₂, hw', hd₁, hd₂⟩ := hCW w₁ w₂ hw₁ hw₂
      have hNF' : c₀ ^ ℓ ≠ 0 ∧ (1 : ↥W) ≠ 0 ∧ w' ∈ IsLocalRing.maximalIdeal ↥W ∧ ε ∉ 𝔭 ∧
          σ * ε₁ ∉ 𝔭 ∧
          (f' / h' ^ ℓ - 1) * algebraMap A K (u ^ (k + M + M) * (σ * ε₁) + v * r₁' +
              algebraMap ↥W A w' * (algebraMap ↥W A d₁ * gg₁)) *
            algebraMap A K (algebraMap ↥W A 1) =
          algebraMap A K (algebraMap ↥W A (c₀ ^ ℓ)) *
            algebraMap A K (u ^ (k + M + 1 + e) * ε + v * r₀' +
              algebraMap ↥W A w' * (algebraMap ↥W A d₂ * gg₀)) := by
        refine ⟨pow_ne_zero _ hc₀0, one_ne_zero, hw', hε, h𝔭p.mul_notMem hσ he1, ?_⟩
        have h1 : u ^ (k + M + M) * (σ * ε₁) + v * r₁' +
            algebraMap ↥W A w' * (algebraMap ↥W A d₁ * gg₁) = σ * (p ^ ℓ * B₁) := by
          rw [hZ1, hd₁, map_mul]; ring
        have h2 : u ^ (k + M + 1 + e) * ε + v * r₀' +
            algebraMap ↥W A w' * (algebraMap ↥W A d₂ * gg₀) = σ * X := by
          rw [hZ0, hd₂, map_mul]; ring
        rw [h1, h2]
        simp only [map_one, mul_one, map_pow, map_mul]
        linear_combination algebraMap A K σ * hX'
      by_cases hnk' : k + M + M ≤ k + M + 1 + e
      · exact ⟨h', hh', Or.inr ⟨c₀ ^ ℓ, 1, w', k + M + M, k + M + 1 + e, ε, σ * ε₁, r₀', r₁',
          algebraMap ↥W A d₂ * gg₀, algebraMap ↥W A d₁ * gg₁, hNF', hGE', Or.inl hnk'⟩⟩
      · exact IH (k + M + M - (k + M + 1 + e)) (by omega) h' (c₀ ^ ℓ) 1 w' (k + M + M)
          (k + M + 1 + e) ε (σ * ε₁) r₀' r₁' (algebraMap ↥W A d₂ * gg₀)
          (algebraMap ↥W A d₁ * gg₁) rfl hh' hNF' hGE' (by omega)
  intro h lam₁ lam₂ w n k ε₀ ε₁ r₀ r₁ g₀ g₁ hh hNF hGE _ hkn
  exact MAIN (n - k) h lam₁ lam₂ w n k ε₀ ε₁ r₀ r₁ g₀ g₁ rfl hh hNF hGE hkn

theorem wcpa_dj_llsm_kpwul_boundary_form : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ (f' : K) (a s : A), a ∉ 𝔭 → s ∉ 𝔭 → f' * algebraMap A K s = algebraMap A K a →
    ∃ (h : K) (c w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A), h ≠ 0 ∧ c ≠ 0 ∧
      w ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀ ∉ 𝔭 ∧ ε₁ ∉ 𝔭 ∧
      ((∃ τ : ↥W, c ^ (ℓ - 1) = ((ℓ : ℕ) : ↥W) ∧ (n ≤ k ∨ τ ∈ IsLocalRing.maximalIdeal ↥W) ∧
          (f' / h ^ ℓ - 1) * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) =
            algebraMap A K (algebraMap ↥W A c) ^ ℓ * algebraMap A K (algebraMap ↥W A τ) *
              algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀)) ∨
        (∃ κ : ↥W, ((ℓ : ℕ) : ↥W) ^ ℓ = c ^ (ℓ * (ℓ - 1)) * κ ∧ ¬ (ℓ : ℤ) ∣ ((k : ℤ) - n) ∧
          (n < k → κ ∈ IsLocalRing.maximalIdeal ↥W) ∧ (k < n → c ∈ IsLocalRing.maximalIdeal ↥W) ∧
          (f' / h ^ ℓ - 1) * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) =
            algebraMap A K (algebraMap ↥W A c) ^ ℓ *
              algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀))) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ 𝔭 u v g hPD f' a s ha hs hf
  classical
  by_contra hcon
  have hℓ1' : ℓ - 1 ≠ 0 := by have := hℓ.two_le; omega
  have hPD' := hPD
  obtain ⟨hFT, hNZ, -, h𝔭max, hm𝔭, -, -, -, -⟩ := hPD'
  haveI := hNZ
  have h𝔭p : 𝔭.IsPrime := h𝔭max.isPrime
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h => h𝔭p.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have haW0 : ∀ c : ↥W, c ≠ 0 → algebraMap ↥W A c ≠ 0 := by
    intro c hc h0
    rw [Algebra.algebraMap_eq_smul_one] at h0
    rcases smul_eq_zero.mp h0 with h1 | h1
    · exact hc h1
    · exact one_ne_zero h1
  have hι0 : ∀ c : ↥W, c ≠ 0 → algebraMap A K (algebraMap ↥W A c) ≠ 0 := fun c hc h0 =>
    haW0 c hc (IsFractionRing.injective A K (by rw [h0, map_zero]))

  have hroot : ∀ x : ↥W, ∀ M : ℕ, 0 < M → ∃ y : ↥W, y ^ M = x ∧
      (x ∈ IsLocalRing.maximalIdeal ↥W → y ∈ IsLocalRing.maximalIdeal ↥W) ∧ (x ≠ 0 → y ≠ 0) := by
    intro x M hM
    obtain ⟨y₀, hy₀⟩ := IsAlgClosed.exists_pow_nat_eq (x : Ω) hM
    have hy₀W : y₀ ∈ W := by
      rcases W.mem_or_inv_mem y₀ with h1 | h1
      · exact h1
      · by_cases hy0 : y₀ = 0
        · rw [hy0]; exact W.toSubring.zero_mem
        · obtain ⟨M', rfl⟩ : ∃ M', M = M' + 1 := ⟨M - 1, by omega⟩
          have e : y₀ = (x : Ω) * (y₀⁻¹) ^ M' := by
            rw [← hy₀, pow_succ, mul_comm (y₀ ^ M') y₀, mul_assoc, ← mul_pow,
              mul_inv_cancel₀ hy0, one_pow, mul_one]
          rw [e]
          exact W.toSubring.mul_mem x.2 (W.toSubring.pow_mem h1 _)
    refine ⟨⟨y₀, hy₀W⟩, ?_, ?_, ?_⟩
    · apply Subtype.ext
      rw [SubmonoidClass.coe_pow]
      exact hy₀
    · intro hx
      have hyx : (⟨y₀, hy₀W⟩ : ↥W) ^ M = x := Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hy₀)
      rw [← hyx] at hx
      exact Ideal.IsPrime.mem_of_pow_mem inferInstance M hx
    · intro hx hy
      apply hx
      have hyx : (⟨y₀, hy₀W⟩ : ↥W) ^ M = x := Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hy₀)
      rw [← hyx, hy, zero_pow hM.ne']

  have hV2 : ∀ (N : ℕ) (x y : ↥W), N ≠ 0 → x ^ N ∣ y ^ N → x ∣ y := by
    intro N x y hN hxy
    rcases ValuationRing.dvd_total x y with h | h
    · exact h
    · obtain ⟨z, rfl⟩ := h
      by_cases hy : y = 0
      · rw [hy]; exact dvd_zero _
      · rw [mul_pow] at hxy
        have h2 : y ^ N * z ^ N ∣ y ^ N * 1 := by rwa [mul_one]
        have h3 : z ^ N ∣ 1 := (mul_dvd_mul_iff_left (pow_ne_zero N hy)).mp h2
        have hzu : IsUnit z := (isUnit_pow_iff hN).mp (isUnit_of_dvd_one h3)
        exact (hzu.mul_right_dvd).mpr dvd_rfl

  have hℓW0 : ((ℓ : ℕ) : ↥W) ≠ 0 := by
    intro h0
    have h1 : ((ℓ : ℕ) : Ω) = 0 := by
      have := congrArg W.subtype h0
      rwa [map_natCast, map_zero] at this
    have h2 := (ringChar.spec Ω ℓ).mp h1
    rcases (Nat.dvd_prime hℓ).mp h2 with h | h
    · exact CharP.ringChar_ne_one h
    · exact hΩ h
  have hℓWm : ((ℓ : ℕ) : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [← IsLocalRing.residue_eq_zero_iff, map_natCast]
    exact (ringChar.spec _ ℓ).mpr (by rw [hκ])

  obtain ⟨c₀, hc₀, -, hc₀0'⟩ := hroot ((ℓ : ℕ) : ↥W) (ℓ - 1) (by omega)
  have hc₀0 : c₀ ≠ 0 := hc₀0' hℓW0
  have hc₀pow : ∀ x : ↥W, (x * c₀ ^ ℓ) ^ (ℓ - 1) = x ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ := by
    intro x
    rw [mul_pow, ← pow_mul, mul_comm ℓ (ℓ - 1), pow_mul, hc₀]

  have TRIV : ∀ h : K, h ≠ 0 → f' / h ^ ℓ - 1 = 0 → False := by
    intro h hh hF
    apply hcon
    refine ⟨h, c₀, 0, 0, 0, 1, 1, 0, 0, 0, 0, hh, hc₀0, Ideal.zero_mem _, h1𝔭, h1𝔭,
      Or.inl ⟨0, hc₀, Or.inl le_rfl, ?_⟩⟩
    rw [hF]
    simp

  have CONV1 : ∀ (h : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A), h ≠ 0 →
      lam₁ ≠ 0 → lam₂ ≠ 0 → w ∈ IsLocalRing.maximalIdeal ↥W → ε₀ ∉ 𝔭 → ε₁ ∉ 𝔭 →
      (f' / h ^ ℓ - 1) * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) *
          algebraMap A K (algebraMap ↥W A lam₂) =
        algebraMap A K (algebraMap ↥W A lam₁) *
          algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀) →
      lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∣ lam₁ ^ (ℓ - 1) →
      (n ≤ k ∨ ¬ lam₁ ^ (ℓ - 1) ∣ lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ) → False := by
    intro h lam₁ lam₂ w n k ε₀ ε₁ r₀ r₁ g₀ g₁ hh hl1 hl2 hw he0 he1 hE hGE hor
    have h1 : lam₂ * c₀ ^ ℓ ∣ lam₁ := hV2 (ℓ - 1) _ _ hℓ1' (by rw [hc₀pow]; exact hGE)
    obtain ⟨τ, hτ⟩ := h1
    apply hcon
    refine ⟨h, c₀, w, n, k, ε₀, ε₁, r₀, r₁, g₀, g₁, hh, hc₀0, hw, he0, he1,
      Or.inl ⟨τ, hc₀, ?_, ?_⟩⟩
    · rcases hor with hnk | hnLE
      · exact Or.inl hnk
      · right
        by_contra hτm
        have hτu : IsUnit τ := IsLocalRing.notMem_maximalIdeal.mp hτm
        apply hnLE
        rw [hτ, ← hc₀pow, mul_pow]
        exact ((hτu.pow _).mul_right_dvd).mpr dvd_rfl
    · apply mul_right_cancel₀ (hι0 lam₂ hl2)
      rw [hE, hτ]
      simp only [map_mul, map_pow]
      ring

  have CONV3 : ∀ (h : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A), h ≠ 0 →
      lam₁ ≠ 0 → lam₂ ≠ 0 → w ∈ IsLocalRing.maximalIdeal ↥W → ε₀ ∉ 𝔭 → ε₁ ∉ 𝔭 →
      (f' / h ^ ℓ - 1) * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) *
          algebraMap A K (algebraMap ↥W A lam₂) =
        algebraMap A K (algebraMap ↥W A lam₁) *
          algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀) →
      lam₂ ∣ lam₁ → lam₁ ^ (ℓ - 1) ∣ lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ →
      ¬ (ℓ : ℤ) ∣ ((k : ℤ) - n) →
      (n < k → ¬ lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∣ lam₁ ^ (ℓ - 1)) →
      (k < n → ¬ lam₁ ∣ lam₂) → False := by
    intro h lam₁ lam₂ w n k ε₀ ε₁ r₀ r₁ g₀ g₁ hh hl1 hl2 hw he0 he1 hE hdiv hLE hnd hnk hkn
    obtain ⟨Λ, hΛ⟩ := hdiv
    have hΛ0 : Λ ≠ 0 := by
      rintro rfl
      exact hl1 (by rw [hΛ, mul_zero])
    obtain ⟨c, hcΛ, -, hc0'⟩ := hroot Λ ℓ hℓ.pos
    have hc0 : c ≠ 0 := hc0' hΛ0
    have hLE' : Λ ^ (ℓ - 1) ∣ ((ℓ : ℕ) : ↥W) ^ ℓ := by
      rw [hΛ, mul_pow] at hLE
      exact (mul_dvd_mul_iff_left (pow_ne_zero _ hl2)).mp hLE
    obtain ⟨κ, hκ'⟩ := hLE'
    apply hcon
    refine ⟨h, c, w, n, k, ε₀, ε₁, r₀, r₁, g₀, g₁, hh, hc0, hw, he0, he1,
      Or.inr ⟨κ, ?_, hnd, ?_, ?_, ?_⟩⟩
    · rw [hκ', ← hcΛ, ← pow_mul]
    · intro hlt
      by_contra hκm
      have hκu : IsUnit κ := IsLocalRing.notMem_maximalIdeal.mp hκm
      apply hnk hlt
      rw [hκ', hΛ, mul_pow, ← mul_assoc]
      exact (hκu.mul_right_dvd).mpr dvd_rfl
    · intro hlt
      by_contra hcm
      have hcu : IsUnit c := IsLocalRing.notMem_maximalIdeal.mp hcm
      apply hkn hlt
      rw [hΛ, ← hcΛ]
      exact ((hcu.pow ℓ).mul_right_dvd).mpr dvd_rfl
    · apply mul_right_cancel₀ (hι0 lam₂ hl2)
      rw [hE, hΛ, ← hcΛ]
      simp only [map_mul, map_pow]
      ring

  have GEdvd : ∀ lam₁ lam₂ : ↥W, lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∣ lam₁ ^ (ℓ - 1) →
      lam₂ ∣ lam₁ := fun lam₁ lam₂ hGE =>
    hV2 (ℓ - 1) _ _ hℓ1' (dvd_trans (dvd_mul_right _ _) hGE)
  have GEnot : ∀ lam₁ lam₂ : ↥W, lam₂ ≠ 0 →
      lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∣ lam₁ ^ (ℓ - 1) → ¬ lam₁ ∣ lam₂ := by
    intro lam₁ lam₂ hl2 hGE h12
    have h1 : lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∣ lam₂ ^ (ℓ - 1) * 1 := by
      rw [mul_one]; exact dvd_trans hGE (pow_dvd_pow_of_dvd h12 _)
    have h2 := (mul_dvd_mul_iff_left (pow_ne_zero _ hl2)).mp h1
    have h3 : IsUnit ((ℓ : ℕ) : ↥W) := (isUnit_pow_iff hℓ.ne_zero).mp (isUnit_of_dvd_one h2)
    exact (IsLocalRing.notMem_maximalIdeal.mpr h3) hℓWm
  have LEofnotGE : ∀ lam₁ lam₂ : ↥W,
      ¬ lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∣ lam₁ ^ (ℓ - 1) →
      lam₁ ^ (ℓ - 1) ∣ lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ := fun lam₁ lam₂ h =>
    (ValuationRing.dvd_total (lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ) (lam₁ ^ (ℓ - 1))).resolve_left h

  have FRAC : ∀ (F : K) (p q : A), q ∉ 𝔭 → p ≠ 0 → F * algebraMap A K q = algebraMap A K p →
      ∃ (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A),
        lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀ ∉ 𝔭 ∧ ε₁ ∉ 𝔭 ∧
        F * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) *
          algebraMap A K (algebraMap ↥W A lam₂) =
        algebraMap A K (algebraMap ↥W A lam₁) *
          algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀) := by
    intro F p q hq hp0 hFq
    have hq0 : q ≠ 0 := fun h0 => hq (h0 ▸ 𝔭.zero_mem)
    obtain ⟨j₁, k₁, σ₁, e₁, r₁', g₁', lp, w₁, hσ₁, he₁, hlp, hw₁, E1⟩ :=
      wcpa_dj_llsm_kpwul_bracket Ω W hW hWt A 𝔭 u v g hPD p hp0
    obtain ⟨j₂, k₂, σ₂, e₂, r₂', g₂', lq, w₂, hσ₂, he₂, hlq, hw₂, E2⟩ :=
      wcpa_dj_llsm_kpwul_bracket Ω W hW hWt A 𝔭 u v g hPD q hq0
    obtain ⟨w, d₁, d₂, hw, hd₁, hd₂⟩ : ∃ w d₁ d₂ : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W ∧
        w₁ = w * d₁ ∧ w₂ = w * d₂ := by
      rcases ValuationRing.dvd_total w₁ w₂ with ⟨d, hd⟩ | ⟨d, hd⟩
      · exact ⟨w₁, 1, d, hw₁, (mul_one _).symm, hd⟩
      · exact ⟨w₂, d, 1, hw₂, hd, (mul_one _).symm⟩
    refine ⟨lp, lq, w, k₂ + j₁, k₁ + j₂, σ₂ * e₁, σ₁ * e₂, σ₂ * u ^ j₂ * r₁', σ₁ * u ^ j₁ * r₂',
      algebraMap ↥W A d₁ * (σ₂ * u ^ j₂ * g₁'), algebraMap ↥W A d₂ * (σ₁ * u ^ j₁ * g₂'),
      hlp, hlq, hw, h𝔭p.mul_notMem hσ₂ he₁, h𝔭p.mul_notMem hσ₁ he₂, ?_⟩
    rw [hd₁] at E1
    rw [hd₂] at E2
    have E1' := congrArg (algebraMap A K) E1
    have E2' := congrArg (algebraMap A K) E2
    simp only [map_mul, map_add, map_pow] at E1' E2' ⊢
    linear_combination (-(F * algebraMap A K σ₁ * algebraMap A K u ^ j₁)) * E2' +
      (algebraMap A K σ₁ * algebraMap A K u ^ j₁ * algebraMap A K σ₂ * algebraMap A K u ^ j₂) * hFq +
      (algebraMap A K σ₂ * algebraMap A K u ^ j₂) * E1'

  have hmap : ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → algebraMap ↥W A x ∈ 𝔭 :=
    fun x hx => hm𝔭 (Ideal.mem_map_of_mem _ hx)
  obtain ⟨γa, hγa⟩ := wcpa_dj_llsm_kptf_residue_trivial Ω W A 𝔭 hFT h𝔭max hm𝔭 a
  obtain ⟨γs, hγs⟩ := wcpa_dj_llsm_kptf_residue_trivial Ω W A 𝔭 hFT h𝔭max hm𝔭 s
  have haWa : algebraMap ↥W A γa ∉ 𝔭 := by
    intro hm
    apply ha
    have := 𝔭.add_mem hγa hm
    rwa [sub_add_cancel] at this
  have haWs : algebraMap ↥W A γs ∉ 𝔭 := by
    intro hm
    apply hs
    have := 𝔭.add_mem hγs hm
    rwa [sub_add_cancel] at this
  have hγau : IsUnit γa := IsLocalRing.notMem_maximalIdeal.mp (fun hm => haWa (hmap γa hm))
  have hγsu : IsUnit γs := IsLocalRing.notMem_maximalIdeal.mp (fun hm => haWs (hmap γs hm))
  obtain ⟨ρ, hρ, -, -⟩ := hroot (γa * ↑hγsu.unit⁻¹) ℓ hℓ.pos
  have hρs : ρ ^ ℓ * γs = γa := by rw [hρ, mul_assoc, hγsu.val_inv_mul, mul_one]
  have hρ0 : ρ ≠ 0 := by
    rintro rfl
    rw [zero_pow hℓ.ne_zero, zero_mul] at hρs
    exact hγau.ne_zero hρs.symm
  have hH0ne : algebraMap A K (algebraMap ↥W A ρ) ≠ 0 := hι0 ρ hρ0
  have hHρ : algebraMap A K (algebraMap ↥W A ρ) ^ ℓ * algebraMap A K (algebraMap ↥W A γs) =
      algebraMap A K (algebraMap ↥W A γa) := by
    rw [← map_pow, ← map_pow, ← map_mul, ← map_mul, hρs]
  have hq : s * algebraMap ↥W A γa ∉ 𝔭 := h𝔭p.mul_notMem hs haWa
  have hp𝔭 : a * algebraMap ↥W A γs - s * algebraMap ↥W A γa ∈ 𝔭 := by
    have e : a * algebraMap ↥W A γs - s * algebraMap ↥W A γa =
        (a - algebraMap ↥W A γa) * algebraMap ↥W A γs -
          (s - algebraMap ↥W A γs) * algebraMap ↥W A γa := by ring
    rw [e]
    exact 𝔭.sub_mem (𝔭.mul_mem_right _ hγa) (𝔭.mul_mem_right _ hγs)
  have hF₀ : (f' / algebraMap A K (algebraMap ↥W A ρ) ^ ℓ - 1) *
      algebraMap A K (s * algebraMap ↥W A γa) =
      algebraMap A K (a * algebraMap ↥W A γs - s * algebraMap ↥W A γa) := by
    have hX : f' / algebraMap A K (algebraMap ↥W A ρ) ^ ℓ *
        algebraMap A K (algebraMap ↥W A ρ) ^ ℓ = f' :=
      div_mul_cancel₀ f' (pow_ne_zero _ hH0ne)
    simp only [map_mul, map_sub]
    linear_combination (-(f' / algebraMap A K (algebraMap ↥W A ρ) ^ ℓ * algebraMap A K s)) * hHρ +
      (algebraMap A K s * algebraMap A K (algebraMap ↥W A γs)) * hX +
      algebraMap A K (algebraMap ↥W A γs) * hf
  have hφq : algebraMap A K (s * algebraMap ↥W A γa) ≠ 0 := by
    intro h0
    apply hq
    have := IsFractionRing.injective A K (h0.trans (map_zero _).symm)
    rw [this]
    exact 𝔭.zero_mem
  by_cases hp0 : a * algebraMap ↥W A γs - s * algebraMap ↥W A γa = 0
  · apply TRIV _ hH0ne
    have h2 := hF₀
    rw [hp0, map_zero] at h2
    exact (mul_eq_zero.mp h2).resolve_right hφq
  obtain ⟨l10, l20, w0, n0, k0, e00, e10, r00, r10, g00, g10, hl10, hl20, hw0, he00, he10, hE0⟩ :=
    FRAC _ _ _ hq hp0 hF₀
  obtain ⟨hP0a, hP0b'⟩ := wcpa_dj_llsm_kpwulb_nf_bound Ω W hW hWt A K 𝔭 u v g hPD _ _ _ hq hF₀
    l10 l20 w0 n0 k0 e00 e10 r00 r10 g00 g10 ⟨hl10, hl20, hw0, he00, he10, hE0⟩
  have hP0b := hP0b' hp𝔭

  have G3 : ∀ (h : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A), h ≠ 0 →
      (lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀ ∉ 𝔭 ∧ ε₁ ∉ 𝔭 ∧
        (f' / h ^ ℓ - 1) * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) *
          algebraMap A K (algebraMap ↥W A lam₂) =
        algebraMap A K (algebraMap ↥W A lam₁) *
          algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀)) →
      lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∣ lam₁ ^ (ℓ - 1) → False := by
    intro h lam₁ lam₂ w n k ε₀ ε₁ r₀ r₁ g₀ g₁ hh hNF hGE
    obtain ⟨hl1, hl2, hw, he0, he1, hE⟩ := hNF
    by_cases hc : lam₁ ^ (ℓ - 1) ∣ lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∧ k < n
    · obtain ⟨hLE, hkn⟩ := hc
      obtain ⟨h', hh', hout⟩ := wcpa_dj_llsm_kpwulb_cap_step Ω W hW hWt ℓ hℓ hΩ hκ A K 𝔭 u v g
        hPD f' a s ha hs hf h lam₁ lam₂ w n k ε₀ ε₁ r₀ r₁ g₀ g₁ hh
        ⟨hl1, hl2, hw, he0, he1, hE⟩ hGE hLE hkn
      rcases hout with hF | ⟨l1, l2, w', n', k', e0, e1, r0, r1, g0, g1,
        ⟨hl1', hl2', hw', he0', he1', hE'⟩, hGE', hor⟩
      · exact TRIV h' hh' hF
      · rcases hor with hnk | hnLE | hnd
        · exact CONV1 h' l1 l2 w' n' k' e0 e1 r0 r1 g0 g1 hh' hl1' hl2' hw' he0' he1' hE' hGE'
            (Or.inl hnk)
        · exact CONV1 h' l1 l2 w' n' k' e0 e1 r0 r1 g0 g1 hh' hl1' hl2' hw' he0' he1' hE' hGE'
            (Or.inr hnLE)
        · by_cases hLE' : l1 ^ (ℓ - 1) ∣ l2 ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ
          · by_cases hnk : n' ≤ k'
            · exact CONV1 h' l1 l2 w' n' k' e0 e1 r0 r1 g0 g1 hh' hl1' hl2' hw' he0' he1' hE' hGE'
                (Or.inl hnk)
            · exact CONV3 h' l1 l2 w' n' k' e0 e1 r0 r1 g0 g1 hh' hl1' hl2' hw' he0' he1' hE'
                (GEdvd l1 l2 hGE') hLE' hnd (fun hlt => absurd hlt.le hnk)
                (fun _ => GEnot l1 l2 hl2' hGE')
          · exact CONV1 h' l1 l2 w' n' k' e0 e1 r0 r1 g0 g1 hh' hl1' hl2' hw' he0' he1' hE' hGE'
              (Or.inr hLE')
    · rw [not_and_or] at hc
      apply CONV1 h lam₁ lam₂ w n k ε₀ ε₁ r₀ r₁ g₀ g₁ hh hl1 hl2 hw he0 he1 hE hGE
      rcases hc with hc | hc
      · exact Or.inr hc
      · exact Or.inl (not_lt.mp hc)

  have FIN : ∀ (h : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A), h ≠ 0 →
      (lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀ ∉ 𝔭 ∧ ε₁ ∉ 𝔭 ∧
        (f' / h ^ ℓ - 1) * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) *
          algebraMap A K (algebraMap ↥W A lam₂) =
        algebraMap A K (algebraMap ↥W A lam₁) *
          algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀)) →
      lam₂ ∣ lam₁ → (lam₁ ∣ lam₂ → n < k) →
      ¬ lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∣ lam₁ ^ (ℓ - 1) →
      (∀ (h' : K) (lam₁' lam₂' w' : ↥W) (n' k' : ℕ) (ε₀' ε₁' r₀' r₁' g₀' g₁' : A), h' ≠ 0 →
        (lam₁' ≠ 0 ∧ lam₂' ≠ 0 ∧ w' ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀' ∉ 𝔭 ∧ ε₁' ∉ 𝔭 ∧
          (f' / h' ^ ℓ - 1) *
              algebraMap A K (u ^ n' * ε₁' + v * r₁' + algebraMap ↥W A w' * g₁') *
            algebraMap A K (algebraMap ↥W A lam₂') =
          algebraMap A K (algebraMap ↥W A lam₁') *
            algebraMap A K (u ^ k' * ε₀' + v * r₀' + algebraMap ↥W A w' * g₀')) →
        lam₁' * lam₂ ∣ lam₁ * lam₂') → False := by
    intro h lam₁ lam₂ w n k ε₀ ε₁ r₀ r₁ g₀ g₁ hh hNF hd hP0 hnGE hMAX
    obtain ⟨h', l1, l2, w', n', k', e0, e1, r0, r1, g0, g1, hh', ⟨hl1', hl2', hw', he0', he1', hE'⟩,
      hd', hP0', hnGE', hnd'⟩ := wcpa_dj_llsm_kpwulb_below_cap Ω W hW hWt ℓ hℓ hΩ hκ A K 𝔭 u v g
        hPD f' a s ha hs hf h lam₁ lam₂ w n k ε₀ ε₁ r₀ r₁ g₀ g₁ hh hNF hd hP0 hnGE hMAX
    exact CONV3 h' l1 l2 w' n' k' e0 e1 r0 r1 g0 g1 hh' hl1' hl2' hw' he0' he1' hE' hd'
      (LEofnotGE l1 l2 hnGE') hnd' (fun _ => hnGE')
      (fun hkn h12 => by have := hP0' h12; omega)

  obtain ⟨h₁, hh₁, hout⟩ := wcpa_dj_llsm_kpwulb_best_approx Ω W hW hWt ℓ hℓ hΩ hκ A K 𝔭 u v g
    hPD f' a s ha hs hf
  rcases hout with hF | ⟨l11, l21, w1, n1, k1, e01, e11, r01, r11, g01, g11, hNF1, hGEMAX⟩
  · exact TRIV h₁ hh₁ hF
  rcases hGEMAX with hGE1 | hMAX1
  · exact G3 h₁ l11 l21 w1 n1 k1 e01 e11 r01 r11 g01 g11 hh₁ hNF1 hGE1
  by_cases hGE1 : l21 ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∣ l11 ^ (ℓ - 1)
  · exact G3 h₁ l11 l21 w1 n1 k1 e01 e11 r01 r11 g01 g11 hh₁ hNF1 hGE1
  have hl21 : l21 ≠ 0 := hNF1.2.1
  have hM := hMAX1 _ l10 l20 w0 n0 k0 e00 e10 r00 r10 g00 g10 hH0ne
    ⟨hl10, hl20, hw0, he00, he10, hE0⟩
  by_cases heq : l11 * l20 ∣ l10 * l21
  · have hMAX0 : ∀ (h' : K) (lam₁' lam₂' w' : ↥W) (n' k' : ℕ) (ε₀' ε₁' r₀' r₁' g₀' g₁' : A),
        h' ≠ 0 →
        (lam₁' ≠ 0 ∧ lam₂' ≠ 0 ∧ w' ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀' ∉ 𝔭 ∧ ε₁' ∉ 𝔭 ∧
          (f' / h' ^ ℓ - 1) *
              algebraMap A K (u ^ n' * ε₁' + v * r₁' + algebraMap ↥W A w' * g₁') *
            algebraMap A K (algebraMap ↥W A lam₂') =
          algebraMap A K (algebraMap ↥W A lam₁') *
            algebraMap A K (u ^ k' * ε₀' + v * r₀' + algebraMap ↥W A w' * g₀')) →
        lam₁' * l20 ∣ l10 * lam₂' := by
      intro h' lam₁' lam₂' w' n' k' e0 e1 r0 r1 g0 g1 hh' hNF'
      have h1 := hMAX1 h' lam₁' lam₂' w' n' k' e0 e1 r0 r1 g0 g1 hh' hNF'
      have h2 : lam₁' * l20 * l21 ∣ l10 * lam₂' * l21 := by
        calc lam₁' * l20 * l21 = (lam₁' * l21) * l20 := by ring
          _ ∣ (l11 * lam₂') * l20 := mul_dvd_mul_right h1 _
          _ = (l11 * l20) * lam₂' := by ring
          _ ∣ (l10 * l21) * lam₂' := mul_dvd_mul_right heq _
          _ = l10 * lam₂' * l21 := by ring
      exact (mul_dvd_mul_iff_right hl21).mp h2
    have hnGE0 : ¬ l20 ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∣ l10 ^ (ℓ - 1) := by
      intro hGE0
      apply hGE1
      have h1 : (l10 * l21) ^ (ℓ - 1) ∣ (l11 * l20) ^ (ℓ - 1) := pow_dvd_pow_of_dvd hM _
      have h2 : l21 ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ * l20 ^ (ℓ - 1) ∣
          l11 ^ (ℓ - 1) * l20 ^ (ℓ - 1) := by
        calc l21 ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ * l20 ^ (ℓ - 1)
            = (l20 ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ) * l21 ^ (ℓ - 1) := by ring
          _ ∣ l10 ^ (ℓ - 1) * l21 ^ (ℓ - 1) := mul_dvd_mul_right hGE0 _
          _ = (l10 * l21) ^ (ℓ - 1) := (mul_pow _ _ _).symm
          _ ∣ (l11 * l20) ^ (ℓ - 1) := h1
          _ = l11 ^ (ℓ - 1) * l20 ^ (ℓ - 1) := mul_pow _ _ _
      exact (mul_dvd_mul_iff_right (pow_ne_zero _ hl20)).mp h2
    exact FIN _ l10 l20 w0 n0 k0 e00 e10 r00 r10 g00 g10 hH0ne
      ⟨hl10, hl20, hw0, he00, he10, hE0⟩ hP0a hP0b hnGE0 hMAX0
  · have hd1 : l21 ∣ l11 := by
      obtain ⟨Λ, hΛ⟩ := hP0a
      have h3 : l20 * (Λ * l21) ∣ l20 * l11 := by
        calc l20 * (Λ * l21) = l10 * l21 := by rw [hΛ]; ring
          _ ∣ l11 * l20 := hM
          _ = l20 * l11 := mul_comm _ _
      exact dvd_trans (dvd_mul_left l21 Λ) ((mul_dvd_mul_iff_left hl20).mp h3)
    have hP01 : l11 ∣ l21 → n1 < k1 := by
      intro h12
      exfalso
      apply heq
      calc l11 * l20 ∣ l21 * l20 := mul_dvd_mul_right h12 _
        _ ∣ l21 * l10 := mul_dvd_mul_left _ hP0a
        _ = l10 * l21 := mul_comm _ _
    exact FIN h₁ l11 l21 w1 n1 k1 e01 e11 r01 r11 g01 g11 hh₁ hNF1 hd1 hP01 hGE1 hMAX1

theorem wcpa_dj_llsm_kpwbb_bracket : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (u v : A) (g b₀ w : ↥W) (j : ℕ) (ε r g' : A), algebraMap A K u ≠ 0 → u * v = algebraMap ↥W A g → b₀ ^ (j + 1) ∣ g → b₀ ^ j ∣ w → w ∈ IsLocalRing.maximalIdeal ↥W → ∃ P : ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u}), (P : K) * algebraMap A K u ^ j = algebraMap A K (u ^ j * ε + v * r + algebraMap ↥W A w * g') ∧ P - algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u}) ε ∈ Ideal.span {algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u}) u, ⟨algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u, Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔ (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u})).comp (algebraMap ↥W A)) :=
by
  intro Ω _ W A _ _ K _ _ u v g b₀ w j ε r g' hu huv hg hw hwm
  obtain ⟨gj, hgj⟩ := hg
  obtain ⟨wj, hwj⟩ := hw
  let S := Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u}
  let sS : S := ⟨algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u,
    Algebra.subset_adjoin (Set.mem_singleton _)⟩
  let ιW : ↥W →+* S := (algebraMap A S).comp (algebraMap ↥W A)
  let N : Ideal S := Ideal.span {algebraMap A S u, sS} ⊔
    (IsLocalRing.maximalIdeal ↥W).map ιW
  have hsN : sS ∈ N := Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
  have hιW : ∀ x : ↥W, ((ιW x : S) : K) = algebraMap A K (algebraMap ↥W A x) := fun x => rfl
  have hιA : ∀ x : A, ((algebraMap A S x : S) : K) = algebraMap A K x := fun x => rfl
  have hsK : ((sS : S) : K) = algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u := rfl
  refine ⟨algebraMap A S ε + ιW gj * sS ^ (j + 1) * algebraMap A S r +
    ιW wj * sS ^ j * algebraMap A S g', ?_, ?_⟩
  ·
    have hv : algebraMap A K v = algebraMap A K (algebraMap ↥W A g) / algebraMap A K u := by
