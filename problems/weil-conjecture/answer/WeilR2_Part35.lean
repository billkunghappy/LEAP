  obtain ⟨s₃, hs₃def⟩ : ∃ s : K, s = algebraMap A₃ K (algebraMap ↥W A₃ β') / algebraMap A₃ K u₃ :=
    ⟨_, rfl⟩
  obtain ⟨N₃, hN₃def⟩ : ∃ I : Ideal ↥(Algebra.adjoin A₃ {s₃}),
      I = Ideal.span {algebraMap A₃ ↥(Algebra.adjoin A₃ {s₃}) u₃,
          ⟨s₃, Algebra.subset_adjoin (Set.mem_singleton s₃)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A₃ ↥(Algebra.adjoin A₃ {s₃})).comp (algebraMap ↥W A₃)) := ⟨_, rfl⟩
  by_cases hN₃ : N₃ = ⊤
  ·
    subst hs₃def
    unfold wcLlsAnnSep wcLlsSepAt
    intro 𝔮 _ h𝔮
    exact ((Ideal.comap_isPrime _ 𝔮).ne_top (h𝔮.trans (hN₃def.symm.trans hN₃))).elim

  have hlift : ∀ x : K, x ∈ Algebra.adjoin A {wcLlsInnerS₁ W A K u c₁,
      wcLlsInnerS₂ W A K u (c₁ * β')} → x ∈ Algebra.adjoin A₃ {s₃} := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with rfl | hx
      · have e1 : wcLlsInnerS₁ W A K u c₁ = algebraMap A₃ K u₃ := by
          rw [hu₃]
          rfl
        rw [e1]
        exact Subalgebra.algebraMap_mem _ u₃
      · rw [Set.mem_singleton_iff] at hx
        subst hx
        have e1 : wcLlsInnerS₂ W A K u (c₁ * β') = s₃ := by
          rw [hs₃def, hs₃]
          rfl
        rw [e1]
        exact Algebra.subset_adjoin (Set.mem_singleton _)
    | algebraMap a =>
      obtain ⟨a₃, ha₃⟩ := hArange a
      rw [← ha₃]
      exact Subalgebra.algebraMap_mem _ a₃
    | add x y _ _ hx hy => exact Subalgebra.add_mem _ hx hy
    | mul x y _ _ hx hy => exact Subalgebra.mul_mem _ hx hy

  have hNspan : ∀ x : ↥(wcLlsInnerCR W A K u c₁ (c₁ * β')),
      x ∈ Ideal.span {(⟨wcLlsInnerS₁ W A K u c₁, Algebra.subset_adjoin (Set.mem_insert _ _)⟩ :
          ↥(wcLlsInnerCR W A K u c₁ (c₁ * β'))),
        ⟨wcLlsInnerS₂ W A K u (c₁ * β'),
          Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩} →
      x ∈ wcLlsInnerCN W A K u c₁ (c₁ * β') := fun x hx => Ideal.mem_sup_left hx
  have hNsup : ∀ x : ↥(wcLlsInnerCR W A K u c₁ (c₁ * β')),
      x ∈ (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(wcLlsInnerCR W A K u c₁ (c₁ * β'))).comp (algebraMap ↥W A)) →
      x ∈ wcLlsInnerCN W A K u c₁ (c₁ * β') := fun x hx => Ideal.mem_sup_right hx

  have h𝔭le : 𝔭 ≤ (wcLlsInnerCN W A K u c₁ (c₁ * β')).comap
      (algebraMap A ↥(wcLlsInnerCR W A K u c₁ (c₁ * β'))) := by
    rw [h𝔭eq]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rw [SetLike.mem_coe, Ideal.mem_comap]
      rcases hz with hz | hz
      · rw [hz]
        have e1 : algebraMap A ↥(wcLlsInnerCR W A K u c₁ (c₁ * β')) u =
            algebraMap A ↥(wcLlsInnerCR W A K u c₁ (c₁ * β')) (algebraMap ↥W A c₁) *
              ⟨wcLlsInnerS₁ W A K u c₁, Algebra.subset_adjoin (Set.mem_insert _ _)⟩ := by
          apply Subtype.ext
          rw [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, Subalgebra.coe_algebraMap]
          show _ = _ * (algebraMap A K u / algebraMap A K (algebraMap ↥W A c₁))
          field_simp
        rw [e1]
        exact Ideal.mul_mem_left _ _ (hNspan _ (Ideal.subset_span (Set.mem_insert _ _)))
      · rw [hz]
        have e1 : algebraMap A ↥(wcLlsInnerCR W A K u c₁ (c₁ * β')) v =
            algebraMap A ↥(wcLlsInnerCR W A K u c₁ (c₁ * β')) (algebraMap ↥W A t) *
              ⟨wcLlsInnerS₂ W A K u (c₁ * β'),
                Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ := by
          apply Subtype.ext
          rw [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, Subalgebra.coe_algebraMap]
          show _ = _ * (algebraMap A K (algebraMap ↥W A (c₁ * β')) / algebraMap A K u)
          rw [mul_div_assoc', eq_div_iff hû]
          linear_combination hK
        rw [e1]
        exact Ideal.mul_mem_left _ _ (hNspan _
          (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))))
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      exact hNsup _ (Ideal.mem_map_of_mem _ hw)
  have h𝔭N : ∀ p ∈ 𝔭, algebraMap A ↥(wcLlsInnerCR W A K u c₁ (c₁ * β')) p ∈
      wcLlsInnerCN W A K u c₁ (c₁ * β') := fun p hp => h𝔭le hp

  have hconst : ∀ x : K, x ∈ Algebra.adjoin A {wcLlsInnerS₁ W A K u c₁,
      wcLlsInnerS₂ W A K u (c₁ * β')} →
      ∃ (a : A) (n : ↥(wcLlsInnerCR W A K u c₁ (c₁ * β'))),
        n ∈ wcLlsInnerCN W A K u c₁ (c₁ * β') ∧ (n : K) = x - algebraMap A K a := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with rfl | hx
      · exact ⟨0, ⟨_, Algebra.subset_adjoin (Set.mem_insert _ _)⟩,
          hNspan _ (Ideal.subset_span (Set.mem_insert _ _)), by simp⟩
      · rw [Set.mem_singleton_iff] at hx
        subst hx
        exact ⟨0, ⟨_, Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩,
          hNspan _ (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))),
          by simp⟩
    | algebraMap a =>
      exact ⟨a, 0, Ideal.zero_mem _, by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨a, n, hn, hnv⟩ := hx
      obtain ⟨a', n', hn', hn'v⟩ := hy
      refine ⟨a + a', n + n', Ideal.add_mem _ hn hn', ?_⟩
      show (n : K) + (n' : K) = x + y - algebraMap A K (a + a')
      rw [hnv, hn'v, map_add]
      ring
    | mul x y hx' hy' hx hy =>
      obtain ⟨a, n, hn, hnv⟩ := hx
      obtain ⟨a', n', hn', hn'v⟩ := hy
      refine ⟨a * a', ⟨x, hx'⟩ * n' +
          algebraMap A ↥(wcLlsInnerCR W A K u c₁ (c₁ * β')) a' * n,
        Ideal.add_mem _ (Ideal.mul_mem_left _ _ hn') (Ideal.mul_mem_left _ _ hn), ?_⟩
      show x * (n' : K) + algebraMap A K a' * (n : K) = x * y - algebraMap A K (a * a')
      rw [hnv, hn'v, map_mul]
      ring

  obtain ⟨a, n, hnN, hnv⟩ := hconst (d : K) d.2
  have hdn : d = n + algebraMap A ↥(wcLlsInnerCR W A K u c₁ (c₁ * β')) a := by
    apply Subtype.ext
    rw [Subalgebra.coe_add, hnv, Subalgebra.coe_algebraMap]
    ring
  have ha𝔭 : a ∉ 𝔭 := by
    intro ha
    apply hd
    rw [hdn]
    exact Ideal.add_mem _ hnN (h𝔭N a ha)
  obtain ⟨b, p, hp, hbp⟩ := hmax.exists_inv ha𝔭
  have hinv : algebraMap A ↥(wcLlsInnerCR W A K u c₁ (c₁ * β')) b * d +
      (algebraMap A ↥(wcLlsInnerCR W A K u c₁ (c₁ * β')) p -
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ (c₁ * β')) b * n) = 1 := by
    have h1 : algebraMap A ↥(wcLlsInnerCR W A K u c₁ (c₁ * β')) b *
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ (c₁ * β')) a +
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ (c₁ * β')) p = 1 := by
      rw [← map_mul, ← map_add, hbp, map_one]
    rw [hdn]
    linear_combination h1
  have hm₀N : algebraMap A ↥(wcLlsInnerCR W A K u c₁ (c₁ * β')) p -
      algebraMap A ↥(wcLlsInnerCR W A K u c₁ (c₁ * β')) b * n ∈
      wcLlsInnerCN W A K u c₁ (c₁ * β') :=
    Ideal.sub_mem _ (h𝔭N p hp) (Ideal.mul_mem_left _ _ hnN)

  let ι : ↥(wcLlsInnerCR W A K u c₁ (c₁ * β')) →+* ↥(Algebra.adjoin A₃ {s₃}) :=
    { toFun := fun x => ⟨(x : K), hlift _ x.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hι : ∀ x, ((ι x : ↥(Algebra.adjoin A₃ {s₃})) : K) = (x : K) := fun _ => rfl
  have hle : wcLlsInnerCN W A K u c₁ (c₁ * β') ≤ N₃.comap ι := by
    unfold wcLlsInnerCN
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rw [SetLike.mem_coe, Ideal.mem_comap, hN₃def]
      rcases hz with hz | hz
      · rw [hz]
        refine Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_iff.mpr (Or.inl ?_)))
        apply Subtype.ext
        rw [hι]
        show wcLlsInnerS₁ W A K u c₁ = (algebraMap A₃ ↥(Algebra.adjoin A₃ {s₃}) u₃ : K)
        rw [Subalgebra.coe_algebraMap, hu₃]
        rfl
      · rw [hz]
        refine Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_iff.mpr
          (Or.inr (Set.mem_singleton_iff.mpr ?_))))
        apply Subtype.ext
        rw [hι]
        show wcLlsInnerS₂ W A K u (c₁ * β') = s₃
        rw [hs₃def, hs₃]
        rfl
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      show ι (algebraMap A ↥(wcLlsInnerCR W A K u c₁ (c₁ * β')) (algebraMap ↥W A w)) ∈ N₃
      rw [hN₃def]
      have e1 : ι (algebraMap A ↥(wcLlsInnerCR W A K u c₁ (c₁ * β')) (algebraMap ↥W A w)) =
          ((algebraMap A₃ ↥(Algebra.adjoin A₃ {s₃})).comp (algebraMap ↥W A₃)) w := by
        apply Subtype.ext
        rw [hι, RingHom.comp_apply, Subalgebra.coe_algebraMap, Subalgebra.coe_algebraMap, hcompat]
      rw [e1]
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)

  have hd₃ : ι d ∉ N₃ := by
    intro hmem
    apply hN₃
    rw [Ideal.eq_top_iff_one]
    have h1 := congrArg ι hinv
    rw [map_add, map_mul, map_one] at h1
    have h2 := N₃.add_mem (N₃.mul_mem_left (ι (algebraMap A _ b)) hmem) (hle hm₀N)
    rwa [h1] at h2

  have hde₃ : ((ι d : ↥(Algebra.adjoin A₃ {s₃})) : K) * (f' / h ^ ℓ - 1) =
      algebraMap A₃ K (algebraMap ↥W A₃ c) ^ ℓ * ((ι e : ↥(Algebra.adjoin A₃ {s₃})) : K) := by
    rw [hcompat, hι, hι]
    exact hde
  rw [hN₃def] at hd₃
  subst hs₃def
  exact wcpa_dj_llsm_kpwb_etale_chart Ω W hW hWt ℓ hℓ hΩ hκ A₃ K L 𝔭₃ u₃ v₃ (β' * t) β' hPD₃
    hβm hβ0 hβq hfr _ _ hθ'' hθ''f c η hc0 hη hcη (ι d) (ι e) hd₃ hde₃

theorem wcpa_dj_llsm_kpwi_monomial_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
      [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) → Module.finrank K L = ℓ →
    ∀ (θ' : L) (f' : K), θ' ∉ Set.range (algebraMap K L) → θ' ^ ℓ = algebraMap K L f' →
    ∀ m : ℕ, 0 < m → m < ℓ → ∀ a s : A, a ∉ 𝔭 → s ∉ 𝔭 →
    f' * algebraMap A K s = algebraMap A K u ^ m * algebraMap A K a →
    ∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
      c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
      wcLlsInnerSep W A K L u c₁ c₂ :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g hPD hfr θ' f' hθ' hθ'f
    m hm0 hmℓ a s ha hs hfac c₁ c₂ hc₁m hc₁0 hc₂m hc₂0 h12 h21 h2g
  classical

  obtain ⟨-, hnzd, -, hmax, -, -, hg0, -, h𝔭eq, -⟩ := id hPD
  haveI := hnzd
  obtain ⟨β, hβ⟩ := h12
  obtain ⟨t, ht⟩ := h2g
  have hβ0 : β ≠ 0 := by
    rintro rfl
    exact hc₂0 (by rw [hβ, mul_zero])
  have hβm : β ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    apply h21
    rw [hβ]
    exact hu.mul_right_dvd.mpr dvd_rfl
  have ht0 : t ≠ 0 := by
    rintro rfl
    exact hg0 (by rw [ht, mul_zero])
  obtain ⟨q, hqdef⟩ : ∃ q : ↥W, q = β * t := ⟨_, rfl⟩
  have hq0 : q ≠ 0 := by rw [hqdef]; exact mul_ne_zero hβ0 ht0
  have hqm : q ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [hqdef]; exact Ideal.mul_mem_right t _ hβm
  have hgq : g = c₁ * q := by rw [ht, hβ, hqdef, mul_assoc]
  have hβq : β ∣ q := ⟨t, hqdef⟩
  have hWA : ∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ≠ 0 := by
    intro w hw h0
    rw [Algebra.algebraMap_eq_smul_one] at h0
    rcases smul_eq_zero.mp h0 with h | h
    · exact hw h
    · exact one_ne_zero h
  have hinj := IsFractionRing.injective A K
  have hC₁ : algebraMap A K (algebraMap ↥W A c₁) ≠ 0 := fun h =>
    hWA c₁ hc₁0 (hinj (by rw [h, map_zero]))

  obtain ⟨A₃, i1, i2, i3, i4, i5, i6, i7, u₃, v₃, 𝔭₃, hBS, hu₃, hv₃, hPD₃, -⟩ :=
    wcpa_dj_llsm_br_inner_chart Ω W hW hWt A K L 𝔭 u v g c₁ q hPD hc₁m hc₁0 hqm hgq
  obtain ⟨hBSW, hBSsub, -⟩ := id hBS
  have hsurjA : ∀ x : A, ∃ x₃ : A₃, algebraMap A₃ K x₃ = algebraMap A K x := by
    intro x
    exact hBSsub (Subalgebra.algebraMap_mem _ x)
  have huu : algebraMap A K u = algebraMap A K (algebraMap ↥W A c₁) * algebraMap A₃ K u₃ := by
    rw [hu₃, mul_div_assoc', mul_comm, mul_div_assoc, div_self hC₁, mul_one]

  obtain ⟨-, -, -, hmax₃, -, -, -, -, h𝔭₃eq, -⟩ := id hPD₃
  have hinj₃ := IsFractionRing.injective A₃ K
  let J : Ideal A :=
    { carrier := {x | ∃ x₃ ∈ 𝔭₃, algebraMap A₃ K x₃ = algebraMap A K x}
      add_mem' := by
        rintro x y ⟨x₃, hx₃, hx⟩ ⟨y₃, hy₃, hy⟩
        exact ⟨x₃ + y₃, 𝔭₃.add_mem hx₃ hy₃, by rw [map_add, map_add, hx, hy]⟩
      zero_mem' := ⟨0, 𝔭₃.zero_mem, by rw [map_zero, map_zero]⟩
      smul_mem' := by
        rintro r x ⟨x₃, hx₃, hx⟩
        obtain ⟨r₃, hr⟩ := hsurjA r
        exact ⟨r₃ * x₃, 𝔭₃.mul_mem_left r₃ hx₃, by rw [smul_eq_mul, map_mul, map_mul, hr, hx]⟩ }
  have hJmem : ∀ x, x ∈ J ↔ ∃ x₃ ∈ 𝔭₃, algebraMap A₃ K x₃ = algebraMap A K x := fun x => Iff.rfl
  have h𝔭J : 𝔭 ≤ J := by
    rw [h𝔭eq]
    apply sup_le
    · rw [Ideal.span_le]
      intro x hx
      rcases hx with h | h
      · rw [h]
        refine (hJmem _).mpr ⟨algebraMap ↥W A₃ c₁ * u₃, ?_, ?_⟩
        · rw [h𝔭₃eq]
          exact Ideal.mem_sup_left (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _)))
        · rw [map_mul, hBSW, huu]
      · rw [Set.mem_singleton_iff.mp h]
        refine (hJmem _).mpr ⟨v₃, ?_, hv₃⟩
        rw [h𝔭₃eq]
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap]
      refine (hJmem _).mpr ⟨algebraMap ↥W A₃ w, ?_, hBSW w⟩
      rw [h𝔭₃eq]
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)
  have hJne : J ≠ ⊤ := by
    intro hJ
    have h1 : (1 : A) ∈ J := by rw [hJ]; exact Submodule.mem_top
    obtain ⟨x₃, hx₃, hx⟩ := (hJmem 1).mp h1
    rw [map_one, ← map_one (algebraMap A₃ K)] at hx
    have hx1 := hinj₃ hx
    rw [hx1] at hx₃
    exact hmax₃.ne_top ((Ideal.eq_top_iff_one _).mpr hx₃)
  have h𝔭J' : 𝔭 = J := hmax.eq_of_le hJne h𝔭J
  have htrans : ∀ x : A, x ∉ 𝔭 → ∃ x₃ : A₃, x₃ ∉ 𝔭₃ ∧ algebraMap A₃ K x₃ = algebraMap A K x := by
    intro x hx
    obtain ⟨x₃, hx₃⟩ := hsurjA x
    refine ⟨x₃, fun hmem => hx ?_, hx₃⟩
    rw [h𝔭J']
    exact (hJmem x).mpr ⟨x₃, hmem, hx₃⟩
  obtain ⟨a₃, ha₃, ha₃e⟩ := htrans a ha
  obtain ⟨s₃, hs₃, hs₃e⟩ := htrans s hs

  obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq ((c₁ : Ω)) hℓ.pos
  have hz0 : z ≠ 0 := by
    intro h0
    apply hc₁0
    apply Subtype.ext
    rw [← hz, h0]
    simp [hℓ.ne_zero]
  have hzW : z ∈ W := by
    rcases W.mem_or_inv_mem z with h | h
    · exact h
    · obtain ⟨n, hn⟩ : ∃ n, ℓ = n + 1 := ⟨ℓ - 1, (Nat.sub_add_cancel hℓ.one_le).symm⟩
      have e : z = (c₁ : Ω) * z⁻¹ ^ n := by
        rw [← hz, hn, pow_succ, inv_pow, mul_comm (z ^ n) z, mul_assoc,
          mul_inv_cancel₀ (pow_ne_zero n hz0), mul_one]
      rw [e]
      exact W.toSubring.mul_mem c₁.2 (W.toSubring.pow_mem h n)
  obtain ⟨γ, hγdef⟩ : ∃ γ : ↥W, γ = ⟨z, hzW⟩ := ⟨_, rfl⟩
  have hγℓ : γ ^ ℓ = c₁ := by
    apply Subtype.ext
    rw [hγdef, SubmonoidClass.coe_pow]
    exact hz
  have hγ0 : γ ≠ 0 := by
    rintro rfl
    apply hc₁0
    rw [← hγℓ, zero_pow hℓ.ne_zero]
  obtain ⟨G, hGdef⟩ : ∃ G : K, G = algebraMap A K (algebraMap ↥W A γ) := ⟨_, rfl⟩
  have hG0 : G ≠ 0 := by
    rw [hGdef]
    exact fun h => hWA γ hγ0 (hinj (by rw [h, map_zero]))
  have hGℓ : G ^ ℓ = algebraMap A K (algebraMap ↥W A c₁) := by
    rw [hGdef, ← map_pow, ← map_pow, hγℓ]
  have hGL : algebraMap K L G ≠ 0 := (map_ne_zero _).mpr hG0
  obtain ⟨θ'', hθ''def⟩ : ∃ x : L, x = θ' / algebraMap K L G ^ m := ⟨_, rfl⟩
  obtain ⟨f'', hf''def⟩ : ∃ x : K, x = f' / G ^ (ℓ * m) := ⟨_, rfl⟩
  have hθ''f : θ'' ^ ℓ = algebraMap K L f'' := by
    rw [hθ''def, hf''def, div_pow, hθ'f, map_div₀, map_pow, ← pow_mul, mul_comm m ℓ]
  have hθ'' : θ'' ∉ Set.range (algebraMap K L) := by
    rintro ⟨k, hk⟩
    apply hθ'
