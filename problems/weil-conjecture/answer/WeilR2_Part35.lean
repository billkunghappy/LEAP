    c₁ c₂ c₁' c₂' hc₁m hc₁0 hc₂m hc₂0 h12 h21 h2g hc₁'m hc₁'0 hc₂'m hc₂'0 h12' h21' h11 h22 hSH
  classical
  obtain ⟨-, hnzd, -, hmax, -, -, hg0, huv, h𝔭eq, -⟩ := id hPD
  haveI := hnzd
  have hWA : ∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ≠ 0 := by
    intro w hw h0
    rw [Algebra.algebraMap_eq_smul_one] at h0
    rcases smul_eq_zero.mp h0 with h | h
    · exact hw h
    · exact one_ne_zero h
  have hinjA := IsFractionRing.injective A K
  have hWK : ∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0 := fun w hw h0 =>
    hWA w hw (hinjA (by rw [h0, map_zero]))
  have hû : algebraMap A K u ≠ 0 := by
    intro h0
    apply hWK g hg0
    rw [← huv, map_mul, h0, zero_mul]
  have hmunit : ∀ z : ↥W, z ∈ IsLocalRing.maximalIdeal ↥W ↔ ¬ IsUnit z := fun z =>
    (IsLocalRing.mem_maximalIdeal z).trans mem_nonunits_iff

  obtain ⟨k₁, hk₁⟩ := h11
  obtain ⟨k₂, hk₂⟩ := h22
  obtain ⟨t, ht⟩ := h2g
  obtain ⟨q₂, hq₂⟩ := h12'
  have hq₂m : q₂ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [hmunit]
    intro hu
    apply h21'
    rw [hq₂]
    exact (hu.mul_right_dvd).mpr dvd_rfl
  have hC₁ := hWK c₁ hc₁0
  have hK₁ : algebraMap A K (algebraMap ↥W A k₁) ≠ 0 := by
    apply hWK
    rintro rfl
    exact hc₁'0 (by rw [hk₁, mul_zero])
  have hg' : g = c₂' * (k₂ * t) := by rw [ht, hk₂, mul_assoc]
  have huvK : algebraMap A K u * algebraMap A K v =
      algebraMap A K (algebraMap ↥W A c₂') *
        (algebraMap A K (algebraMap ↥W A k₂) * algebraMap A K (algebraMap ↥W A t)) := by
    have e := congrArg (algebraMap A K) huv
    rw [hg'] at e
    simpa only [map_mul] using e

  have hS1 : wcLlsInnerS₁ W A K u c₁ =
      algebraMap A K (algebraMap ↥W A k₁) * wcLlsInnerS₁ W A K u c₁' := by
    unfold wcLlsInnerS₁
    rw [hk₁, map_mul, map_mul, mul_div_assoc', div_eq_div_iff hC₁ (mul_ne_zero hC₁ hK₁)]
    ring
  have hS2 : wcLlsInnerS₂ W A K u c₂ =
      algebraMap A K (algebraMap ↥W A k₂) * wcLlsInnerS₂ W A K u c₂' := by
    unfold wcLlsInnerS₂
    rw [hk₂, map_mul, map_mul]
    ring

  have hle : wcLlsInnerCR W A K u c₁ c₂ ≤ wcLlsInnerCR W A K u c₁' c₂' := by
    apply Algebra.adjoin_le
    intro x hx
    rcases hx with rfl | rfl
    · rw [hS1]
      exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
        (Algebra.subset_adjoin (Set.mem_insert _ _))
    · rw [hS2]
      exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
        (Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _)))

  have hσmem : ∀ e₁ e₂ : ↥W,
      (⟨wcLlsInnerS₁ W A K u e₁, Algebra.subset_adjoin (Set.mem_insert _ _)⟩ :
          ↥(wcLlsInnerCR W A K u e₁ e₂)) ∈ wcLlsInnerCN W A K u e₁ e₂ ∧
      (⟨wcLlsInnerS₂ W A K u e₂,
          Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ :
          ↥(wcLlsInnerCR W A K u e₁ e₂)) ∈ wcLlsInnerCN W A K u e₁ e₂ := fun e₁ e₂ =>
    ⟨Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)),
      Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))⟩
  have hNsup : ∀ (e₁ e₂ : ↥W) (x : ↥(wcLlsInnerCR W A K u e₁ e₂)),
      x ∈ (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(wcLlsInnerCR W A K u e₁ e₂)).comp (algebraMap ↥W A)) →
      x ∈ wcLlsInnerCN W A K u e₁ e₂ := fun _ _ _ hx => Ideal.mem_sup_right hx

  have hpN : ∀ e₁ e₂ τ : ↥W, e₁ ≠ 0 → g = e₂ * τ → ∀ x ∈ 𝔭,
      algebraMap A ↥(wcLlsInnerCR W A K u e₁ e₂) x ∈ wcLlsInnerCN W A K u e₁ e₂ := by
    intro e₁ e₂ τ he₁ hgτ
    have hE₁ := hWK e₁ he₁
    have hKe : algebraMap A K u * algebraMap A K v =
        algebraMap A K (algebraMap ↥W A e₂) * algebraMap A K (algebraMap ↥W A τ) := by
      have e := congrArg (algebraMap A K) huv
      rw [hgτ] at e
      simpa only [map_mul] using e
    have hle' : 𝔭 ≤ (wcLlsInnerCN W A K u e₁ e₂).comap
        (algebraMap A ↥(wcLlsInnerCR W A K u e₁ e₂)) := by
      rw [h𝔭eq]
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro z hz
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
        rw [SetLike.mem_coe, Ideal.mem_comap]
        rcases hz with hz | hz
        · rw [hz]
          have e1 : algebraMap A ↥(wcLlsInnerCR W A K u e₁ e₂) u =
              algebraMap A ↥(wcLlsInnerCR W A K u e₁ e₂) (algebraMap ↥W A e₁) *
                ⟨wcLlsInnerS₁ W A K u e₁, Algebra.subset_adjoin (Set.mem_insert _ _)⟩ := by
            apply Subtype.ext
            rw [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, Subalgebra.coe_algebraMap]
            show _ = _ * (algebraMap A K u / algebraMap A K (algebraMap ↥W A e₁))
            field_simp
          rw [e1]
          exact Ideal.mul_mem_left _ _ (hσmem e₁ e₂).1
        · rw [hz]
          have e1 : algebraMap A ↥(wcLlsInnerCR W A K u e₁ e₂) v =
              algebraMap A ↥(wcLlsInnerCR W A K u e₁ e₂) (algebraMap ↥W A τ) *
                ⟨wcLlsInnerS₂ W A K u e₂,
                  Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ := by
            apply Subtype.ext
            rw [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, Subalgebra.coe_algebraMap]
            show _ = _ * (algebraMap A K (algebraMap ↥W A e₂) / algebraMap A K u)
            rw [mul_div_assoc', eq_div_iff hû]
            linear_combination hKe
          rw [e1]
          exact Ideal.mul_mem_left _ _ (hσmem e₁ e₂).2
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        exact hNsup e₁ e₂ _ (Ideal.mem_map_of_mem _ hw)
    exact fun x hx => hle' hx

  have hNtop : ∀ (B : Type u) [CommRing B] [Algebra ↥W B] [Algebra B K] (P : Ideal B),
      Function.Injective (algebraMap B K) → P ≠ ⊤ →
      (∀ w : ↥W, algebraMap B K (algebraMap ↥W B w) = algebraMap A K (algebraMap ↥W A w)) →
      (∀ a : A, ∃ b : B, algebraMap B K b = algebraMap A K a) →
      (∃ x ∈ P, algebraMap B K x = wcLlsInnerS₁ W A K u c₁') →
      (∃ y ∈ P, algebraMap B K y = wcLlsInnerS₂ W A K u c₂') →
      (∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → algebraMap ↥W B w ∈ P) →
      wcLlsInnerCN W A K u c₁' c₂' ≠ ⊤ := by
    intro B _ _ _ P hinj hP hWB hAB hxP hyP hmP
    obtain ⟨x, hxP, hx⟩ := hxP
    obtain ⟨y, hyP, hy⟩ := hyP
    have hex : ∀ z : K, z ∈ Algebra.adjoin A {wcLlsInnerS₁ W A K u c₁',
        wcLlsInnerS₂ W A K u c₂'} → ∃ b : B, algebraMap B K b = z := by
      intro z hz
      induction hz using Algebra.adjoin_induction with
      | mem z hz =>
        rcases hz with rfl | rfl
        · exact ⟨x, hx⟩
        · exact ⟨y, hy⟩
      | algebraMap r => exact hAB r
      | add x₁ x₂ _ _ ih₁ ih₂ =>
        obtain ⟨y₁, h₁⟩ := ih₁
        obtain ⟨y₂, h₂⟩ := ih₂
        exact ⟨y₁ + y₂, by rw [map_add, h₁, h₂]⟩
      | mul x₁ x₂ _ _ ih₁ ih₂ =>
        obtain ⟨y₁, h₁⟩ := ih₁
        obtain ⟨y₂, h₂⟩ := ih₂
        exact ⟨y₁ * y₂, by rw [map_mul, h₁, h₂]⟩
    have hex' : ∀ z : ↥(wcLlsInnerCR W A K u c₁' c₂'), ∃ b : B, algebraMap B K b = (z : K) :=
      fun z => hex z.1 z.2
    choose f hf using hex'
    obtain ⟨ψ, hψ⟩ : ∃ ψ : ↥(wcLlsInnerCR W A K u c₁' c₂') →+* B,
        ∀ z, algebraMap B K (ψ z) = (z : K) :=
      ⟨{ toFun := f
         map_one' := hinj (by rw [hf, map_one]; rfl)
         map_mul' := fun z₁ z₂ => hinj (by rw [hf, map_mul, hf, hf]; rfl)
         map_zero' := hinj (by rw [hf, map_zero]; rfl)
         map_add' := fun z₁ z₂ => hinj (by rw [hf, map_add, hf, hf]; rfl) }, hf⟩
    have hleP : wcLlsInnerCN W A K u c₁' c₂' ≤ P.comap ψ := by
      unfold wcLlsInnerCN
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro z hz
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
        rw [SetLike.mem_coe, Ideal.mem_comap]
        rcases hz with hz | hz
        · rw [hz]
          convert hxP using 1
          exact hinj ((hψ _).trans hx.symm)
        · rw [hz]
          convert hyP using 1
          exact hinj ((hψ _).trans hy.symm)
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [Ideal.mem_comap, Ideal.mem_comap]
        convert hmP w hw using 1
        apply hinj
        rw [hψ, hWB, RingHom.comp_apply, Subalgebra.coe_algebraMap]
    intro htop
    apply hP
    have h1 : (1 : ↥(wcLlsInnerCR W A K u c₁' c₂')) ∈ wcLlsInnerCN W A K u c₁' c₂' := by
      rw [htop]
      exact Submodule.mem_top
    have h2 := hleP h1
    rw [Ideal.mem_comap, map_one] at h2
    exact (Ideal.eq_top_iff_one _).mpr h2

  have hgq : g = c₁' * (q₂ * (k₂ * t)) := by rw [hg', hq₂]; ring
  have hqm : q₂ * (k₂ * t) ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right _ _ hq₂m
  have hb₁0 : k₂ * t ≠ 0 := by
    intro h0
    apply hg0
    rw [hg', h0, mul_zero]
  have hNtop' : wcLlsInnerCN W A K u c₁' c₂' ≠ ⊤ := by
    obtain ⟨A₃, iCR3, iDom3, iWA3, iAK3, iFr3, iAL3, iTow3, u₃, v₃, 𝔭₃, hsub₃, hu₃, hv₃, hPD₃,
      hj3⟩ := wcpa_dj_llsm_br_inner_chart Ω W hW hWt A K K 𝔭 u v g c₁' (q₂ * (k₂ * t)) hPD
        hc₁'m hc₁'0 hqm hgq
    clear hj3 iTow3 iAL3
    obtain ⟨hcomp₃, hrange₃, -⟩ := hsub₃
    have hAr₃ : ∀ a : A, ∃ b : A₃, algebraMap A₃ K b = algebraMap A K a :=
      fun a => hrange₃ (Subalgebra.algebraMap_mem _ a)
    obtain ⟨-, -, -, hmax₃, -, -, -, -, h𝔭₃eq, -⟩ := id hPD₃
    have hu₃mem : u₃ ∈ 𝔭₃ := by
      rw [h𝔭₃eq]
      exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
    have hv₃mem : v₃ ∈ 𝔭₃ := by
      rw [h𝔭₃eq]
      exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    have hmP₃ : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → algebraMap ↥W A₃ w ∈ 𝔭₃ := by
      intro w hw
      rw [h𝔭₃eq]
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)
    by_cases hunit : IsUnit (k₂ * t)
    · obtain ⟨β, hβ⟩ := hunit.exists_right_inv
      have hβK : algebraMap A K (algebraMap ↥W A k₂) * algebraMap A K (algebraMap ↥W A t) *
          algebraMap A K (algebraMap ↥W A β) = 1 := by
        have e := congrArg (fun w : ↥W => algebraMap A K (algebraMap ↥W A w)) hβ
        simpa only [map_mul, map_one] using e
      refine hNtop A₃ 𝔭₃ (IsFractionRing.injective A₃ K) hmax₃.ne_top hcomp₃ hAr₃
        ⟨u₃, hu₃mem, by rw [hu₃]; rfl⟩
        ⟨algebraMap ↥W A₃ β * v₃, Ideal.mul_mem_left _ _ hv₃mem, ?_⟩ hmP₃
      rw [map_mul, hcomp₃, hv₃]
      unfold wcLlsInnerS₂
      rw [eq_div_iff hû]
      linear_combination algebraMap A K (algebraMap ↥W A β) * huvK +
        algebraMap A K (algebraMap ↥W A c₂') * hβK
    · have hb₁m : k₂ * t ∈ IsLocalRing.maximalIdeal ↥W := (hmunit _).mpr hunit
      have hPD₃' := wcpa_dj_llsm_kpwic_pd_swap W A₃ 𝔭₃ u₃ v₃ (q₂ * (k₂ * t)) hPD₃
      obtain ⟨A₄, iCR4, iDom4, iWA4, iAK4, iFr4, iAL4, iTow4, u₄, v₄, 𝔭₄, hsub₄, hu₄, hv₄, hPD₄,
        hj4⟩ := wcpa_dj_llsm_br_inner_chart Ω W hW hWt A₃ K K 𝔭₃ v₃ u₃ (q₂ * (k₂ * t)) (k₂ * t)
          q₂ hPD₃' hb₁m hb₁0 hq₂m (mul_comm _ _)
      clear hj4 iTow4 iAL4
      obtain ⟨hcomp₄, hrange₄, -⟩ := hsub₄
      obtain ⟨-, -, -, hmax₄, -, -, -, -, h𝔭₄eq, -⟩ := id hPD₄
      have hB₁ : algebraMap A K (algebraMap ↥W A (k₂ * t)) ≠ 0 := hWK _ hb₁0
      refine hNtop A₄ 𝔭₄ (IsFractionRing.injective A₄ K) hmax₄.ne_top
        (fun w => (hcomp₄ w).trans (hcomp₃ w)) ?_ ⟨v₄, ?_, ?_⟩ ⟨u₄, ?_, ?_⟩ ?_
      · intro a'
        obtain ⟨b₃, hb₃⟩ := hAr₃ a'
        obtain ⟨b₄, hb₄⟩ := hrange₄ (Subalgebra.algebraMap_mem _ b₃)
        exact ⟨b₄, hb₄.trans hb₃⟩
      · rw [h𝔭₄eq]
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
      · rw [hv₄, hu₃]
        rfl
      · rw [h𝔭₄eq]
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
      · rw [hu₄, hcomp₃, hv₃]
        unfold wcLlsInnerS₂
        rw [div_eq_div_iff hB₁ hû]
        simp only [map_mul]
        linear_combination huvK
      · intro w hw
        rw [h𝔭₄eq]
        exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)

  have hdec : ∀ x : K, x ∈ Algebra.adjoin A {wcLlsInnerS₁ W A K u c₁,
      wcLlsInnerS₂ W A K u c₂} →
      ∃ (a₀ : A) (y z : ↥(wcLlsInnerCR W A K u c₁ c₂)),
        x = algebraMap A K a₀ + wcLlsInnerS₁ W A K u c₁ * (y : K) +
          wcLlsInnerS₂ W A K u c₂ * (z : K) := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with rfl | rfl
      · exact ⟨0, 1, 0, by simp⟩
      · exact ⟨0, 0, 1, by simp⟩
    | algebraMap r => exact ⟨r, 0, 0, by simp⟩
    | add x₁ x₂ _ _ ih₁ ih₂ =>
      obtain ⟨a₁, y₁, z₁, h₁⟩ := ih₁
      obtain ⟨a₂, y₂, z₂, h₂⟩ := ih₂
      refine ⟨a₁ + a₂, y₁ + y₂, z₁ + z₂, ?_⟩
      simp only [Subalgebra.coe_add, map_add]
      linear_combination h₁ + h₂
    | mul x₁ x₂ hx₁ hx₂ ih₁ ih₂ =>
      obtain ⟨a₁, y₁, z₁, h₁⟩ := ih₁
      obtain ⟨a₂, y₂, z₂, h₂⟩ := ih₂
      refine ⟨a₁ * a₂, y₁ * ⟨x₂, hx₂⟩ + algebraMap A _ a₁ * y₂,
        z₁ * ⟨x₂, hx₂⟩ + algebraMap A _ a₁ * z₂, ?_⟩
      simp only [Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_algebraMap, map_mul]
      linear_combination x₂ * h₁ + algebraMap A K a₁ * h₂

  have hkey : ∀ X Y Z : ↥(wcLlsInnerCR W A K u c₁' c₂'),
      X + (⟨wcLlsInnerS₁ W A K u c₁', Algebra.subset_adjoin (Set.mem_insert _ _)⟩ :
          ↥(wcLlsInnerCR W A K u c₁' c₂')) * Y +
        (⟨wcLlsInnerS₂ W A K u c₂',
          Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ :
          ↥(wcLlsInnerCR W A K u c₁' c₂')) * Z ∈ wcLlsInnerCN W A K u c₁' c₂' →
      X ∈ wcLlsInnerCN W A K u c₁' c₂' := by
    intro X Y Z hX
    have h3 := sub_mem (sub_mem hX (Ideal.mul_mem_right Y _ (hσmem c₁' c₂').1))
      (Ideal.mul_mem_right Z _ (hσmem c₁' c₂').2)
    convert h3 using 1
    ring
  have htr : ∀ d : ↥(wcLlsInnerCR W A K u c₁ c₂), d ∉ wcLlsInnerCN W A K u c₁ c₂ →
      (⟨(d : K), hle d.2⟩ : ↥(wcLlsInnerCR W A K u c₁' c₂')) ∉ wcLlsInnerCN W A K u c₁' c₂' := by
    intro d hd hd'
    obtain ⟨a₀, y, z, hdK⟩ := hdec (d : K) d.2
    have hdR : d = algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a₀ +
        (⟨wcLlsInnerS₁ W A K u c₁, Algebra.subset_adjoin (Set.mem_insert _ _)⟩ :
          ↥(wcLlsInnerCR W A K u c₁ c₂)) * y +
        (⟨wcLlsInnerS₂ W A K u c₂,
          Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ :
          ↥(wcLlsInnerCR W A K u c₁ c₂)) * z := by
      apply Subtype.ext
      simp only [Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
      linear_combination hdK
    have ha₀ : a₀ ∉ 𝔭 := by
      intro ha'
      apply hd
      rw [hdR]
      exact add_mem (add_mem (hpN c₁ c₂ t hc₁0 ht a₀ ha')
        (Ideal.mul_mem_right _ _ (hσmem c₁ c₂).1)) (Ideal.mul_mem_right _ _ (hσmem c₁ c₂).2)
    obtain ⟨β, i, hi, hβ⟩ := hmax.exists_inv ha₀
    have hdR' : (⟨(d : K), hle d.2⟩ : ↥(wcLlsInnerCR W A K u c₁' c₂')) =
        algebraMap A ↥(wcLlsInnerCR W A K u c₁' c₂') a₀ +
        (⟨wcLlsInnerS₁ W A K u c₁', Algebra.subset_adjoin (Set.mem_insert _ _)⟩ :
          ↥(wcLlsInnerCR W A K u c₁' c₂')) *
          (algebraMap A ↥(wcLlsInnerCR W A K u c₁' c₂') (algebraMap ↥W A k₁) *
            ⟨(y : K), hle y.2⟩) +
        (⟨wcLlsInnerS₂ W A K u c₂',
          Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ :
          ↥(wcLlsInnerCR W A K u c₁' c₂')) *
          (algebraMap A ↥(wcLlsInnerCR W A K u c₁' c₂') (algebraMap ↥W A k₂) *
            ⟨(z : K), hle z.2⟩) := by
      apply Subtype.ext
      simp only [Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
      linear_combination hdK + (y : K) * hS1 + (z : K) * hS2
    rw [hdR'] at hd'
    have hja := hkey _ _ _ hd'
    have hi' := hpN c₁' c₂' (k₂ * t) hc₁'0 hg' i hi
    apply hNtop'
    rw [Ideal.eq_top_iff_one]
    have h1 : algebraMap A ↥(wcLlsInnerCR W A K u c₁' c₂') β *
        algebraMap A ↥(wcLlsInnerCR W A K u c₁' c₂') a₀ +
        algebraMap A ↥(wcLlsInnerCR W A K u c₁' c₂') i = 1 := by
      rw [← map_mul, ← map_add, hβ, map_one]
    rw [← h1]
    exact add_mem (Ideal.mul_mem_left _ _ hja) hi'

  have hroot : ∀ x : ↥W, ∀ M : ℕ, 0 < M → x ≠ 0 → ∃ y : ↥W, y ^ M = x ∧ y ≠ 0 := by
    intro x M hM hx0
    obtain ⟨y₀, hy₀⟩ := IsAlgClosed.exists_pow_nat_eq (x : Ω) hM
    have hy₀W : y₀ ∈ W := by
      rcases W.mem_or_inv_mem y₀ with h1 | h1
      · exact h1
      · by_cases hy0 : y₀ = 0
        · rw [hy0]; exact W.toSubring.zero_mem
        · obtain ⟨M', rfl⟩ : ∃ M', M = M' + 1 := ⟨M - 1, by omega⟩
          have e : y₀ = (x : Ω) * (y₀⁻¹) ^ M' := by
            rw [← hy₀, pow_succ, mul_comm (y₀ ^ M') y₀, mul_assoc, ← mul_pow,
              mul_inv_cancel₀ hy0, one_pow, mul_one]
          rw [e]
          exact W.toSubring.mul_mem x.2 (W.toSubring.pow_mem h1 _)
    have hyx : (⟨y₀, hy₀W⟩ : ↥W) ^ M = x :=
      Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hy₀)
    refine ⟨⟨y₀, hy₀W⟩, hyx, ?_⟩
    intro hy
    apply hx0
    rw [← hyx, hy, zero_pow hM.ne']

  obtain ⟨h, c, hh0, hc0, hcase⟩ := hSH
  rcases hcase with ⟨η, hη, hcη, d, e, hd, hde⟩ | ⟨m, d, e, hm, hd, he, P1, P2, N1, N2, hde⟩
  · exact ⟨h, c, hh0, hc0,
      Or.inl ⟨η, hη, hcη, ⟨(d : K), hle d.2⟩, ⟨(e : K), hle e.2⟩, htr d hd, hde⟩⟩
  · have hp : 0 < ℓ - 1 := by have := hℓ.two_le; omega
    by_cases hmpos : 0 < m
    · have hn : 0 < m.toNat := by omega
      have hk₁0 : k₁ ≠ 0 := by
        rintro rfl
        exact hc₁'0 (by rw [hk₁, mul_zero])
      obtain ⟨δ, hδ, hδ0⟩ := hroot (k₁ ^ m.toNat) ℓ hℓ.pos (pow_ne_zero _ hk₁0)
      obtain ⟨ρ, hρ⟩ := P2 hmpos
      have hK : 0 < (ℓ - 1) * m.toNat := Nat.mul_pos hp hn
      have hkey' : (c * δ) ^ (ℓ * (ℓ - 1)) =
          c ^ (ℓ * (ℓ - 1)) * k₁ ^ ((ℓ - 1) * m.toNat) := by
        rw [mul_pow, pow_mul δ ℓ (ℓ - 1), hδ, ← pow_mul, Nat.mul_comm m.toNat (ℓ - 1)]
      have hstar : ((ℓ : ℕ) : ↥W) ^ ℓ = c ^ (ℓ * (ℓ - 1)) * k₁ ^ ((ℓ - 1) * m.toNat) *
          q₂ ^ ((ℓ - 1) * m.toNat) * k₂ ^ ((ℓ - 1) * m.toNat) * ρ := by
        apply mul_left_cancel₀ (pow_ne_zero ((ℓ - 1) * m.toNat) hc₁0)
        rw [hk₂, hq₂, hk₁] at hρ
        linear_combination -hρ
      have E1 : algebraMap A K (algebraMap ↥W A c₁') ^ m.toNat =
          algebraMap A K (algebraMap ↥W A c₁) ^ m.toNat *
            algebraMap A K (algebraMap ↥W A k₁) ^ m.toNat := by
        rw [hk₁, map_mul, map_mul, mul_pow]
      have E2 : algebraMap A K (algebraMap ↥W A (c * δ)) ^ ℓ =
          algebraMap A K (algebraMap ↥W A c) ^ ℓ *
            algebraMap A K (algebraMap ↥W A k₁) ^ m.toNat := by
        have e1 : algebraMap A K (algebraMap ↥W A (δ ^ ℓ)) =
            algebraMap A K (algebraMap ↥W A (k₁ ^ m.toNat)) := by rw [hδ]
        simp only [map_pow] at e1
        rw [map_mul, map_mul, mul_pow, e1]
      refine ⟨h, c * δ, hh0, mul_ne_zero hc0 hδ0, Or.inr ⟨m, ⟨(d : K), hle d.2⟩,
        ⟨(e : K), hle e.2⟩, hm, htr d hd, htr e he, ?_, ?_,
        fun h' => absurd h' (not_lt.mpr hmpos.le), fun h' => absurd h' (not_lt.mpr hmpos.le),
        ?_⟩⟩
      · intro _
        refine ⟨q₂ ^ ((ℓ - 1) * m.toNat) * (k₂ ^ ((ℓ - 1) * m.toNat) * ρ),
          Ideal.mul_mem_right _ _ (Ideal.pow_mem_of_mem _ hq₂m _ hK), ?_⟩
        rw [hkey']
        linear_combination hstar
      · intro _
        refine ⟨k₂ ^ ((ℓ - 1) * m.toNat) * ρ, ?_⟩
        rw [hkey', hq₂, hk₁]
        linear_combination (-(c₁ ^ ((ℓ - 1) * m.toNat) * k₁ ^ ((ℓ - 1) * m.toNat))) * hstar
      · change (d : K) * (f' / h ^ ℓ - 1) * algebraMap A K (algebraMap ↥W A c₁') ^ m.toNat =
          algebraMap A K (algebraMap ↥W A (c * δ)) ^ ℓ * algebraMap A K u ^ m * (e : K)
        linear_combination (d : K) * (f' / h ^ ℓ - 1) * E1 +
          algebraMap A K (algebraMap ↥W A k₁) ^ m.toNat * hde -
          algebraMap A K u ^ m * (e : K) * E2
    · have hm0 : m ≤ 0 := not_lt.mp hmpos
      have hmt : m.toNat = 0 := Int.toNat_eq_zero.mpr hm0
      refine ⟨h, c, hh0, hc0, Or.inr ⟨m, ⟨(d : K), hle d.2⟩, ⟨(e : K), hle e.2⟩, hm,
        htr d hd, htr e he, fun h' => absurd h' hmpos, fun h' => absurd h' hmpos, ?_, ?_, ?_⟩⟩
      · intro hm0
        obtain ⟨ρ, hρ⟩ := N2 hm0
        obtain ⟨_, _, r, _, hr⟩ := N1 hm0
        have hN : 0 < (ℓ - 1) * (-m).toNat := Nat.mul_pos hp (by omega)
        refine ⟨k₁ ^ ((ℓ - 1) * (-m).toNat) * ρ * q₂ ^ ((ℓ - 1) * (-m).toNat),
          Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hq₂m _ hN), k₂ ^ (-m).toNat * r, ?_, ?_⟩
        · rw [hq₂, hk₁]
          linear_combination (-(k₁ ^ ((ℓ - 1) * (-m).toNat) * q₂ ^ ((ℓ - 1) * (-m).toNat))) * hρ
        · rw [hr, hk₂]
          ring
      · intro hm0
        obtain ⟨ρ, hρ⟩ := N2 hm0
        refine ⟨k₁ ^ ((ℓ - 1) * (-m).toNat) * ρ, ?_⟩
        rw [hk₁]
        linear_combination k₁ ^ ((ℓ - 1) * (-m).toNat) * hρ
      · change (d : K) * (f' / h ^ ℓ - 1) * algebraMap A K (algebraMap ↥W A c₁') ^ m.toNat =
          algebraMap A K (algebraMap ↥W A c) ^ ℓ * algebraMap A K u ^ m * (e : K)
        rw [hmt, pow_zero, mul_one]
        rw [hmt, pow_zero, mul_one] at hde
        exact hde

theorem wcpa_dj_llsm_kpwug_right_germ_gam : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ (f' : K) (a s : A), a ∉ 𝔭 → s ∉ 𝔭 → f' * algebraMap A K s = algebraMap A K a →
    ∀ b₀ : ↥W, b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 → b₀ ∣ g → ¬ g ∣ b₀ →
    ∃ b : ↥W, b ∈ IsLocalRing.maximalIdeal ↥W ∧ b ≠ 0 ∧ b₀ ∣ b ∧ ¬ b ∣ b₀ ∧ b ∣ g ∧
      ∃ (h : K) (c : ↥W), h ≠ 0 ∧ c ≠ 0 ∧
        ((∃ η : ↥W, IsUnit η ∧ c ^ (ℓ - 1) * η = ((ℓ : ℕ) : ↥W) ∧
            ∃ d e : ↥(wcLlsInnerCR W A K u b₀ b), d ∉ wcLlsInnerCN W A K u b₀ b ∧
              (d : K) * (f' / h ^ ℓ - 1) = algebraMap A K (algebraMap ↥W A c) ^ ℓ * (e : K)) ∨
          (∃ (m : ℤ) (d e : ↥(wcLlsInnerCR W A K u b₀ b)), ¬ (ℓ : ℤ) ∣ m ∧
            d ∉ wcLlsInnerCN W A K u b₀ b ∧ e ∉ wcLlsInnerCN W A K u b₀ b ∧
            (0 < m → ∃ q ∈ IsLocalRing.maximalIdeal ↥W,
              ((ℓ : ℕ) : ↥W) ^ ℓ = c ^ (ℓ * (ℓ - 1)) * q) ∧
            (0 < m → ∃ ρ : ↥W,
              c ^ (ℓ * (ℓ - 1)) * b ^ ((ℓ - 1) * m.toNat) * ρ =
                ((ℓ : ℕ) : ↥W) ^ ℓ * b₀ ^ ((ℓ - 1) * m.toNat)) ∧
            (m < 0 → ∃ q ∈ IsLocalRing.maximalIdeal ↥W, ∃ r : ↥W,
              ((ℓ : ℕ) : ↥W) ^ ℓ * b ^ ((ℓ - 1) * (-m).toNat) = c ^ (ℓ * (ℓ - 1)) * q ∧
              c ^ ℓ = b ^ ((-m).toNat) * r) ∧
            (m < 0 → ∃ ρ : ↥W,
              c ^ (ℓ * (ℓ - 1)) * ρ = ((ℓ : ℕ) : ↥W) ^ ℓ * b₀ ^ ((ℓ - 1) * (-m).toNat)) ∧
            (d : K) * (f' / h ^ ℓ - 1) * algebraMap A K (algebraMap ↥W A b₀) ^ m.toNat =
              algebraMap A K (algebraMap ↥W A c) ^ ℓ * algebraMap A K u ^ m * (e : K))) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ 𝔭 u v g hPD f' a s ha hs hf b₀ hb₀m hb₀0
    hb₀g hgb₀
  classical

  have hPD0 := hPD
  simp only [wcLlsPD] at hPD0
  obtain ⟨_, hNZ, _, h𝔭max, _, _, hg0, huv, h𝔭eq, _⟩ := hPD0
  haveI := hNZ
  have hmunit : ∀ z : ↥W, z ∈ IsLocalRing.maximalIdeal ↥W ↔ ¬ IsUnit z := fun z =>
    (IsLocalRing.mem_maximalIdeal z).trans mem_nonunits_iff
  have hWA : ∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ≠ 0 := by
    intro w hw h0
    rw [Algebra.algebraMap_eq_smul_one] at h0
    rcases smul_eq_zero.mp h0 with h | h
    · exact hw h
    · exact one_ne_zero h
  have hWK : ∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0 := fun w hw h0 =>
    hWA w hw (IsFractionRing.injective A K (by rw [h0, map_zero]))
  have huK : algebraMap A K u ≠ 0 := by
    intro h0
    apply hWK g hg0
    rw [← huv, map_mul, h0, zero_mul]
  have hB0 := hWK b₀ hb₀0

  have hroot : ∀ x : ↥W, ∀ M : ℕ, 0 < M → ∃ y : ↥W, y ^ M = x ∧ (x ≠ 0 → y ≠ 0) := by
    intro x M hM
    obtain ⟨y₀, hy₀⟩ := IsAlgClosed.exists_pow_nat_eq (x : Ω) hM
    have hy₀W : y₀ ∈ W := by
      rcases W.mem_or_inv_mem y₀ with h1 | h1
      · exact h1
      · by_cases hy0 : y₀ = 0
        · rw [hy0]; exact W.toSubring.zero_mem
        · obtain ⟨M', rfl⟩ : ∃ M', M = M' + 1 := ⟨M - 1, by omega⟩
          have e : y₀ = (x : Ω) * (y₀⁻¹) ^ M' := by
            rw [← hy₀, pow_succ, mul_comm (y₀ ^ M') y₀, mul_assoc, ← mul_pow,
              mul_inv_cancel₀ hy0, one_pow, mul_one]
          rw [e]
          exact W.toSubring.mul_mem x.2 (W.toSubring.pow_mem h1 _)
    have hyx : (⟨y₀, hy₀W⟩ : ↥W) ^ M = x :=
      Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hy₀)
    refine ⟨⟨y₀, hy₀W⟩, hyx, ?_⟩
    intro hx hy
    apply hx
    rw [← hyx, hy, zero_pow hM.ne']

  obtain ⟨q₀, hq₀⟩ := hb₀g
  have hq₀m : q₀ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [hmunit]
    intro hu
    apply hgb₀
    obtain ⟨w, rfl⟩ := hu
    exact ⟨↑w⁻¹, by rw [hq₀, mul_assoc, Units.mul_inv, mul_one]⟩

  obtain ⟨A₃, iA1, iA2, iA3, iAK, iA4, iAL, iA5, u₃, v₃, 𝔭₃, hBr, hu₃, hv₃, hPD₃, -⟩ :=
    wcpa_dj_llsm_br_inner_chart Ω W hW hWt A K K 𝔭 u v g b₀ q₀ hPD hb₀m hb₀0 hq₀m hq₀
  clear iA5 iAL
  obtain ⟨sB, hsB⟩ : ∃ x : K, x = algebraMap A K u / algebraMap A K (algebraMap ↥W A b₀) :=
    ⟨_, rfl⟩
  rw [← hsB] at hBr hu₃
  unfold wcLlsBrSub at hBr
  obtain ⟨hcomm, hBr1, hBr2⟩ := hBr
  have hsS1 : sB = wcLlsInnerS₁ W A K u b₀ := hsB
  have hsBmul : sB * algebraMap A K (algebraMap ↥W A b₀) = algebraMap A K u := by
    rw [hsB, div_mul_cancel₀ _ hB0]
  have hψinj : Function.Injective (algebraMap A₃ K) := IsFractionRing.injective A₃ K
  have hPD₃0 := hPD₃
  simp only [wcLlsPD] at hPD₃0
  obtain ⟨_, _, _, h𝔭₃max, h𝔭₃map, _, _, _, h𝔭₃eq, _⟩ := hPD₃0
  have hu₃mem : u₃ ∈ 𝔭₃ := by
    rw [h𝔭₃eq]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hv₃mem : v₃ ∈ 𝔭₃ := by
    rw [h𝔭₃eq]
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))

  have hlift : ∀ x : A, ∃ x' : A₃, algebraMap A₃ K x' = algebraMap A K x := fun x =>
    hBr1 (Subalgebra.algebraMap_mem (Algebra.adjoin A {sB}) x)
  choose φf hφf using hlift
  let φ : A →+* A₃ :=
    { toFun := φf
      map_one' := hψinj (by simp only [hφf, map_one])
      map_mul' := fun x y => hψinj (by simp only [hφf, map_mul])
      map_zero' := hψinj (by simp only [hφf, map_zero])
      map_add' := fun x y => hψinj (by simp only [hφf, map_add]) }
  have hφ : ∀ x, algebraMap A₃ K (φ x) = algebraMap A K x := hφf
  have hφW : ∀ w : ↥W, φ (algebraMap ↥W A w) = algebraMap ↥W A₃ w := fun w =>
    hψinj (by rw [hφ, hcomm])
  have hφu : φ u = algebraMap ↥W A₃ b₀ * u₃ :=
    hψinj (by rw [hφ, map_mul, hcomm, hu₃, mul_comm, hsBmul])
  have hφv : φ v = v₃ := hψinj (by rw [hφ, hv₃])
  have h𝔭le : ∀ x : A, x ∈ 𝔭 → φ x ∈ 𝔭₃ := by
    have hle : 𝔭 ≤ 𝔭₃.comap φ := by
      rw [h𝔭eq]
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro x hx
        rcases hx with h | h
        · rw [h]; show φ u ∈ 𝔭₃; rw [hφu]; exact Ideal.mul_mem_left _ _ hu₃mem
        · rw [Set.mem_singleton_iff.mp h]; show φ v ∈ 𝔭₃; rw [hφv]; exact hv₃mem
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        show φ (algebraMap ↥W A w) ∈ 𝔭₃
        rw [hφW]
        exact h𝔭₃map (Ideal.mem_map_of_mem _ hw)
    exact fun x hx => hle hx
  have hunit : ∀ x : A, x ∉ 𝔭 → φ x ∉ 𝔭₃ := by
    intro x hx hφx
    obtain ⟨y, z, hz, hyz⟩ := h𝔭max.exists_inv hx
    apply h𝔭₃max.ne_top
    rw [Ideal.eq_top_iff_one]
    have e : φ (y * x + z) = 1 := by rw [hyz, map_one]
    rw [← e, map_add, map_mul]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hφx) (h𝔭le z hz)
  have hf₃ : f' * algebraMap A₃ K (φ s) = algebraMap A₃ K (φ a) := by rw [hφ, hφ, hf]

  obtain ⟨t₃, ht₃m, ht₃0, ht₃q, H⟩ := wcpa_dj_llsm_kpwug_low_collar_closed Ω W hW hWt ℓ hℓ hΩ
    hκ A₃ K 𝔭₃ u₃ v₃ q₀ hPD₃ f' (φ a) (φ s) (hunit a ha) (hunit s hs) hf₃
  have ht₃nu : ¬ IsUnit t₃ := (hmunit t₃).mp ht₃m
  obtain ⟨h, c, hh0, hc0, hcase⟩ := H 1 t₃ one_ne_zero ht₃m ht₃0 (one_dvd _)
    (fun h1 => ht₃nu (isUnit_of_dvd_one h1)) dvd_rfl

  obtain ⟨b, hbdef⟩ : ∃ b : ↥W, b = b₀ * t₃ := ⟨_, rfl⟩
  have hbm : b ∈ IsLocalRing.maximalIdeal ↥W := by rw [hbdef]; exact Ideal.mul_mem_right _ _ hb₀m
  have hb0 : b ≠ 0 := by rw [hbdef]; exact mul_ne_zero hb₀0 ht₃0
  have hb₀b : b₀ ∣ b := ⟨t₃, hbdef⟩
  have hbb₀ : ¬ b ∣ b₀ := by
    rintro ⟨x, hx⟩
    apply ht₃nu
    apply isUnit_of_dvd_one
    exact ⟨x, by
      apply mul_left_cancel₀ hb₀0
      rw [mul_one]
      rw [hbdef] at hx
      linear_combination hx⟩
  obtain ⟨κ, hκ⟩ := ht₃q
  have hgκ : g = b * κ := by rw [hq₀, hκ, hbdef]; ring
  have hbg : b ∣ g := ⟨κ, hgκ⟩
  have hvK : algebraMap A K v = algebraMap A K (algebraMap ↥W A κ) *
      (algebraMap A K (algebraMap ↥W A b) / algebraMap A K u) := by
    have h1 := congrArg (algebraMap A K) huv
    rw [map_mul, hgκ, map_mul, map_mul] at h1
    rw [mul_div_assoc', eq_div_iff huK]
    linear_combination h1

  have hN'top : wcLlsInnerCN W A₃ K u₃ 1 t₃ ≠ ⊤ := by
    intro htop
    rcases hcase with ⟨_, _, _, d, _, hd, _⟩ | ⟨_, d, _, _, hd, _⟩
    · exact hd (by rw [htop]; exact Submodule.mem_top)
    · exact hd (by rw [htop]; exact Submodule.mem_top)
  have hS1 : wcLlsInnerS₁ W A₃ K u₃ 1 = wcLlsInnerS₁ W A K u b₀ := by
    unfold wcLlsInnerS₁
    rw [hu₃, map_one, map_one, div_one]
    exact hsB
  have hS2 : wcLlsInnerS₂ W A₃ K u₃ t₃ = wcLlsInnerS₂ W A K u b := by
    unfold wcLlsInnerS₂
    rw [hu₃, hcomm, hsB, hbdef, map_mul, map_mul, div_div_eq_mul_div]
    ring
  have hRR' : ∀ y : K, y ∈ Algebra.adjoin A {wcLlsInnerS₁ W A K u b₀, wcLlsInnerS₂ W A K u b} →
      y ∈ Algebra.adjoin A₃ {wcLlsInnerS₁ W A₃ K u₃ 1, wcLlsInnerS₂ W A₃ K u₃ t₃} := by
    intro y hy
    induction hy using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with h | h
      · rw [h, ← hS1]; exact Algebra.subset_adjoin (Set.mem_insert _ _)
      · rw [Set.mem_singleton_iff.mp h, ← hS2]
        exact Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
    | algebraMap r => rw [← hφ r]; exact Subalgebra.algebraMap_mem _ _
    | add x y _ _ hx hy => exact Subalgebra.add_mem _ hx hy
    | mul x y _ _ hx hy => exact Subalgebra.mul_mem _ hx hy
  let jR : ↥(wcLlsInnerCR W A K u b₀ b) →+* ↥(wcLlsInnerCR W A₃ K u₃ 1 t₃) :=
    ((wcLlsInnerCR W A K u b₀ b).val : ↥(wcLlsInnerCR W A K u b₀ b) →ₐ[A] K).toRingHom.codRestrict
      (wcLlsInnerCR W A₃ K u₃ 1 t₃) (fun x => hRR' (x : K) x.2)
  have hS1N : (⟨wcLlsInnerS₁ W A K u b₀, Algebra.subset_adjoin (Set.mem_insert _ _)⟩ :
      ↥(wcLlsInnerCR W A K u b₀ b)) ∈ wcLlsInnerCN W A K u b₀ b := by
    unfold wcLlsInnerCN
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hS2N : (⟨wcLlsInnerS₂ W A K u b,
      Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ :
      ↥(wcLlsInnerCR W A K u b₀ b)) ∈ wcLlsInnerCN W A K u b₀ b := by
    unfold wcLlsInnerCN
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
  have hWN : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W →
      algebraMap A (↥(wcLlsInnerCR W A K u b₀ b)) (algebraMap ↥W A w) ∈
        wcLlsInnerCN W A K u b₀ b := by
    intro w hw
    unfold wcLlsInnerCN
    exact Ideal.mem_sup_right
      (Ideal.mem_map_of_mem ((algebraMap A (↥(wcLlsInnerCR W A K u b₀ b))).comp
        (algebraMap ↥W A)) hw)
  have huN : algebraMap A (↥(wcLlsInnerCR W A K u b₀ b)) u ∈ wcLlsInnerCN W A K u b₀ b := by
    have e : algebraMap A (↥(wcLlsInnerCR W A K u b₀ b)) u =
        algebraMap A (↥(wcLlsInnerCR W A K u b₀ b)) (algebraMap ↥W A b₀) *
          ⟨wcLlsInnerS₁ W A K u b₀, Algebra.subset_adjoin (Set.mem_insert _ _)⟩ := by
      apply Subtype.ext
      show algebraMap A K u = algebraMap A K (algebraMap ↥W A b₀) * wcLlsInnerS₁ W A K u b₀
