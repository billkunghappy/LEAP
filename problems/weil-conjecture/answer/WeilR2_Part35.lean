  obtain ⟨M, q₁, hq₁⟩ := wcFrmCp_arch Ω W hdim (b i₁) (ν * b 0) (hbm i₁) hνμ
  obtain ⟨J, q₂, hq₂⟩ := wcFrmCp_arch Ω W hdim ϖ (ν * b 0) hϖm hνμ
  have h1notin : (1 : A) ∉ 𝔭 := fun h => hp.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have hKP : wcLlsKPLoc A K 0 1 (algebraMap A K (a * g₀)) := by
    unfold wcLlsKPLoc
    refine ⟨0, ?_⟩
    rw [pow_zero, one_mul]
    exact Subalgebra.algebraMap_mem _ _
  obtain ⟨P, d', y, hd', hloc, htay⟩ := wcLlsKP_vde_taylor Ω W A K 𝔭 t hPD (c i₁) (hcm i₁)
    (algebraMap A K (a * g₀)) 1 h1notin hKP M
  obtain ⟨k, hk⟩ : ∃ k : ℕ, algebraMap A K d' ^ k * y ∈ Algebra.adjoin A {(0 : K)} := by
    unfold wcLlsKPLoc at hloc
