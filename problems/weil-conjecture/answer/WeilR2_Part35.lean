  have hclash : ∀ c₁ c₂ : ↥W, c₁ ≠ 0 → c₂ ∣ g → ∀ E₂ : ↥(wcLlsInnerCR W A K u c₁ c₂),
      algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) σ' * E₂ ∈ wcLlsInnerCN W A K u c₁ c₂ →
      E₂ ∈ wcLlsInnerCN W A K u c₁ c₂ := by
    intro c₁ c₂ hc₁ hc₂ E₂ hE
    obtain ⟨y, i, hi, hyi⟩ := Ideal.IsMaximal.exists_inv h𝔭max hσ'
    have h1 : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) y *
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) σ' +
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) i = 1 := by
      rw [← map_mul, ← map_add, hyi, map_one]
    have e : E₂ = algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) y *
        (algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) σ' * E₂) +
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) i * E₂ := by
