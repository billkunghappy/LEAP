theorem wcLlsASvmrs_recoord : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (R : Type u) [CommRing R] (K : Type u) [Field K] (L : Type u) [Field L] [Algebra K L] [Algebra R L] (𝔮 : Ideal ↥(integralClosure R L)) [𝔮.IsPrime] (wR : ↥W →+* R) (P : Type u) [CommRing P] [IsDomain P] [Algebra P K] [Algebra P L] [IsScalarTower P K L] (ψP : Polynomial ↥W →+* P) (G₀ : R) (μ : ↥W) (y : P), ψP.Etale → Function.Injective (algebraMap P K) → (∀ π : ↥W, algebraMap P L (ψP (Polynomial.C π)) = algebraMap R L (wR π)) → μ ∈ IsLocalRing.maximalIdeal ↥W → (∀ π ∈ IsLocalRing.maximalIdeal ↥W, algebraMap R ↥(integralClosure R L) (wR π) ∈ 𝔮) → algebraMap R ↥(integralClosure R L) G₀ ∉ 𝔮 → (∀ x : P, ∃ (r : R) (n : ℕ), algebraMap P L x * algebraMap R L G₀ ^ n = algebraMap R L r) → ∃ (P' : Type u) (_ : CommRing P') (_ : IsDomain P') (_ : Algebra P' K) (_ : Algebra P' L) (_ : IsScalarTower P' K L) (ψ' : Polynomial ↥W →+* P') (ι : P →+* P') (G : R), ψ'.Etale ∧ Function.Injective (algebraMap P' K) ∧ (∀ p : P, algebraMap P' K (ι p) = algebraMap P K p) ∧ (∀ π : ↥W, ψ' (Polynomial.C π) = ι (ψP (Polynomial.C π))) ∧ ψ' Polynomial.X = ι (ψP Polynomial.X + ψP (Polynomial.C μ) * y) ∧ algebraMap R ↥(integralClosure R L) G ∉ 𝔮 ∧ (∀ x : P', ∃ (r : R) (n : ℕ), algebraMap P' L x * algebraMap R L G ^ n = algebraMap R L r) :=
by
  have s2 : ∀ (R T : Type u) [CommRing R] [CommRing T] [Algebra R T] (f : Polynomial R →+* T) (hfC : f.comp Polynomial.C = algebraMap R T) (hf : RingHom.Etale f), Submodule.span T {KaehlerDifferential.D R T (f Polynomial.X)} = ⊤ := by
    intro R T _ _ _ f hfC hf
    letI := f.toAlgebra
    haveI : IsScalarTower R (Polynomial R) T := IsScalarTower.of_algebraMap_eq' (by
      rw [← hfC, Polynomial.algebraMap_eq]; rfl)
    haveI : Algebra.Etale (Polynomial R) T := hf.toAlgebra
    rw [eq_top_iff]
    rintro ω -
    obtain ⟨z, rfl⟩ :=
      (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale R (Polynomial R) T).surjective ω
    rw [KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply]
    induction z using TensorProduct.induction_on with
    | zero => rw [map_zero]; exact zero_mem _
    | tmul y w =>
      rw [KaehlerDifferential.mapBaseChange_tmul]
      have hw : w = (KaehlerDifferential.polynomialEquiv R w) •
          KaehlerDifferential.D R (Polynomial R) Polynomial.X := by
        rw [← KaehlerDifferential.polynomialEquiv_symm, LinearEquiv.symm_apply_apply]
      rw [hw, LinearMap.map_smul, KaehlerDifferential.map_D]
      apply Submodule.smul_mem
      rw [← algebraMap_smul T (KaehlerDifferential.polynomialEquiv R w)]
      apply Submodule.smul_mem
      exact Submodule.mem_span_singleton_self _
    | add z w hz hw => rw [map_add]; exact add_mem hz hw
  have s3 : ∀ (R0 T : Type u) [CommRing R0] [CommRing T] [Algebra R0 T] (x z : T) (q : Ideal T) [q.IsPrime] (c : R0) (hspan : Submodule.span T {KaehlerDifferential.D R0 T x} = ⊤) (hc : algebraMap R0 T c ∈ q), Submodule.span q.ResidueField (Set.range (fun j : Fin 1 => (1 : q.ResidueField) ⊗ₜ[T] KaehlerDifferential.D R0 T (![x + algebraMap R0 T c * z] j))) = ⊤ := by
    intro R0 T _ _ _ x z q _ c hspan hc
    rw [Set.range_unique]
    simp only [Fin.default_eq_zero, Matrix.cons_val_zero]
    have key : ∀ (r : T) (m : KaehlerDifferential R0 T), (1 : q.ResidueField) ⊗ₜ[T] (r • m) =
        (algebraMap T q.ResidueField r) • ((1 : q.ResidueField) ⊗ₜ[T] m) := by
      intro r m
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one, ← TensorProduct.smul_tmul,
        Algebra.smul_def, mul_one]
    have hD : KaehlerDifferential.D R0 T (x + algebraMap R0 T c * z) =
        KaehlerDifferential.D R0 T x + algebraMap R0 T c • KaehlerDifferential.D R0 T z := by
      rw [Derivation.map_add, Derivation.leibniz, Derivation.map_algebraMap, smul_zero, add_zero]
    have hc0 : algebraMap T q.ResidueField (algebraMap R0 T c) = 0 :=
      Ideal.algebraMap_residueField_eq_zero.mpr hc
    have hG : (1 : q.ResidueField) ⊗ₜ[T] KaehlerDifferential.D R0 T (x + algebraMap R0 T c * z) =
        (1 : q.ResidueField) ⊗ₜ[T] KaehlerDifferential.D R0 T x := by
      rw [hD, TensorProduct.tmul_add, key, hc0, zero_smul, add_zero]
    rw [eq_top_iff]
    rintro w -
    induction w using TensorProduct.induction_on with
    | zero => exact zero_mem _
    | tmul k ω =>
      have hω : ω ∈ Submodule.span T {KaehlerDifferential.D R0 T x} := by rw [hspan]; trivial
      obtain ⟨y, rfl⟩ := Submodule.mem_span_singleton.mp hω
      have e : k ⊗ₜ[T] (y • KaehlerDifferential.D R0 T x) =
          (k * algebraMap T q.ResidueField y) •
            ((1 : q.ResidueField) ⊗ₜ[T] KaehlerDifferential.D R0 T x) := by
        rw [mul_smul, ← key, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [e, ← hG]
      exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)
    | add z w hz hw => exact add_mem hz hw
  have s4 : ∀ (R T : Type u) [CommRing R] [CommRing T] [Algebra R T] (f : Polynomial R →+* T) (hfC : f.comp Polynomial.C = algebraMap R T) (hf : RingHom.Etale f), RingHom.IsStandardSmoothOfRelativeDimension 1 (algebraMap R T) := by
    intro R T _ _ _ f hfC hf
    let e : MvPolynomial (Fin 1) R →+* Polynomial R :=
      (MvPolynomial.uniqueAlgEquiv R (Fin 1)).toRingEquiv.toRingHom
    have h1 : RingHom.IsStandardSmoothOfRelativeDimension 1 (algebraMap R (MvPolynomial (Fin 1) R)) :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr inferInstance
    have h2 : RingHom.IsStandardSmoothOfRelativeDimension 0 e :=
      RingHom.etale_iff_isStandardSmoothOfRelativeDimension_zero.mp
        (RingHom.Etale.of_bijective (MvPolynomial.uniqueAlgEquiv R (Fin 1)).bijective)
    have h3 := RingHom.etale_iff_isStandardSmoothOfRelativeDimension_zero.mp hf
    have h4 := h3.comp (h2.comp h1)
    have heq : f.comp (e.comp (algebraMap R (MvPolynomial (Fin 1) R))) = algebraMap R T := by
      rw [← hfC]
      congr 1
      apply RingHom.ext
      intro r
      have := (MvPolynomial.uniqueAlgEquiv R (Fin 1)).commutes r
      rw [Polynomial.algebraMap_eq] at this
      exact this
    rw [heq] at h4
    simpa using h4
  intro Ω _ W R _ K _ L _ _ _ 𝔮 _ wR P _ _ _ _ _ ψP G₀ μ y hψet hPinj hψL hμ hm hG₀ hfrac
  classical
  have hq𝔮 : 𝔮.IsPrime := inferInstance
  have htr : ∀ a b : R, algebraMap R L a = algebraMap R L b →
      algebraMap R ↥(integralClosure R L) a = algebraMap R ↥(integralClosure R L) b :=
    fun a b h => Subtype.ext h
  have hcan : ∀ (r : R) (n : ℕ), algebraMap R ↥(integralClosure R L) (r * G₀ ^ n) ∈ 𝔮 →
      algebraMap R ↥(integralClosure R L) r ∈ 𝔮 := by
    intro r n h
    rw [map_mul, map_pow] at h
    rcases hq𝔮.mem_or_mem h with h | h
    · exact h
    · exact absurd (hq𝔮.mem_of_pow_mem n h) hG₀
  have hX : ∀ (p : P) (r r' : R) (n n' : ℕ),
      algebraMap P L p * algebraMap R L G₀ ^ n = algebraMap R L r →
      algebraMap P L p * algebraMap R L G₀ ^ n' = algebraMap R L r' →
      algebraMap R ↥(integralClosure R L) r' ∈ 𝔮 → algebraMap R ↥(integralClosure R L) r ∈ 𝔮 := by
    intro p r r' n n' e e' h'
    apply hcan r n'
    have h2 : algebraMap R ↥(integralClosure R L) (r * G₀ ^ n') =
        algebraMap R ↥(integralClosure R L) (r' * G₀ ^ n) := by
      apply htr
      simp only [map_mul, map_pow]
      rw [← e, ← e']
      ring
    rw [h2, map_mul]
    exact Ideal.mul_mem_right _ _ h'
  obtain ⟨Qp, hQp⟩ : ∃ Qp : P → Prop, ∀ p, Qp p ↔ (∀ (r : R) (n : ℕ),
      algebraMap P L p * algebraMap R L G₀ ^ n = algebraMap R L r →
      algebraMap R ↥(integralClosure R L) r ∈ 𝔮) := ⟨_, fun _ => Iff.rfl⟩
  have hzero : Qp 0 := by
    rw [hQp]
    intro r n e
    have h0 : algebraMap R ↥(integralClosure R L) r = algebraMap R ↥(integralClosure R L) 0 :=
      htr _ _ (by rw [← e, map_zero, zero_mul, map_zero])
    rw [h0, map_zero]
    exact zero_mem _
  have hadd : ∀ a b : P, Qp a → Qp b → Qp (a + b) := by
    intro a b ha hb
    obtain ⟨r1, n1, e1⟩ := hfrac a
    obtain ⟨r2, n2, e2⟩ := hfrac b
    have hr1 := (hQp a).1 ha r1 n1 e1
    have hr2 := (hQp b).1 hb r2 n2 e2
    rw [hQp]
    intro r n e
    refine hX (a + b) r (r1 * G₀ ^ n2 + r2 * G₀ ^ n1) n (n1 + n2) e ?_ ?_
    · simp only [map_add, map_mul, map_pow]
      rw [← e1, ← e2]
      ring
    · rw [map_add, map_mul, map_mul]
      exact add_mem (Ideal.mul_mem_right _ _ hr1) (Ideal.mul_mem_right _ _ hr2)
  have hmul : ∀ c p : P, Qp p → Qp (c * p) := by
    intro c p hp
    obtain ⟨rc, a, ec⟩ := hfrac c
    obtain ⟨rp, b, ep⟩ := hfrac p
    have hrp := (hQp p).1 hp rp b ep
    rw [hQp]
    intro r n e
    refine hX (c * p) r (rc * rp) n (a + b) e ?_ ?_
    · rw [map_mul, map_mul, ← ec, ← ep]
      ring
    · rw [map_mul]
      exact Ideal.mul_mem_left _ _ hrp
  have hone : ¬ Qp 1 := by
    intro h
    exact hG₀ ((hQp 1).1 h G₀ 1 (by rw [map_one, one_mul, pow_one]))
  have hwit : ∀ p : P, ¬ Qp p → ∃ (r : R) (n : ℕ),
      algebraMap P L p * algebraMap R L G₀ ^ n = algebraMap R L r ∧
      algebraMap R ↥(integralClosure R L) r ∉ 𝔮 := by
    intro p hp
    by_contra hc
    push_neg at hc
    exact hp ((hQp p).2 hc)
  have hprod : ∀ a b : P, ¬ Qp a → ¬ Qp b → ¬ Qp (a * b) := by
    intro a b ha hb hab
    obtain ⟨r1, n1, e1, h1⟩ := hwit a ha
    obtain ⟨r2, n2, e2, h2⟩ := hwit b hb
    have h := (hQp (a * b)).1 hab (r1 * r2) (n1 + n2) (by
      rw [map_mul, map_mul, ← e1, ← e2]
      ring)
    rw [map_mul] at h
    exact hq𝔮.mul_notMem h1 h2 h
  obtain ⟨q, hqprime, hq1, hq2⟩ : ∃ q : Ideal P, q.IsPrime ∧
      (∀ (p : P) (r : R) (n : ℕ), algebraMap P L p * algebraMap R L G₀ ^ n = algebraMap R L r →
        algebraMap R ↥(integralClosure R L) r ∈ 𝔮 → p ∈ q) ∧
      (∀ p : P, p ∉ q → ∀ (r : R) (n : ℕ),
        algebraMap P L p * algebraMap R L G₀ ^ n = algebraMap R L r →
        algebraMap R ↥(integralClosure R L) r ∉ 𝔮) := by
    let q0 : Ideal P :=
      { carrier := {p | Qp p}
        add_mem' := fun {a b} ha hb => hadd a b ha hb
        zero_mem' := hzero
        smul_mem' := fun c x hx => by
          show Qp (c • x)
          rw [smul_eq_mul]
          exact hmul c x hx }
    have hmem : ∀ p : P, p ∈ q0 ↔ Qp p := fun p => Iff.rfl
    have hq1' : ∀ (p : P) (r : R) (n : ℕ),
        algebraMap P L p * algebraMap R L G₀ ^ n = algebraMap R L r →
        algebraMap R ↥(integralClosure R L) r ∈ 𝔮 → p ∈ q0 := by
      intro p r n e h
      rw [hmem, hQp]
      intro r' n' e'
      exact hX p r' r n' n e' e h
    refine ⟨q0, ?_, hq1', ?_⟩
    · refine Ideal.isPrime_iff.mpr ⟨?_, ?_⟩
      · rw [Ideal.ne_top_iff_one, hmem]
        exact hone
      · intro a b hab
        rw [hmem] at hab
        rw [hmem, hmem]
        by_contra hn
        push_neg at hn
        exact hprod a b hn.1 hn.2 hab
    · intro p hp r n e h
      exact hp (hq1' p r n e h)
  haveI := hqprime
  have hμq : ψP (Polynomial.C μ) ∈ q :=
    hq1 _ (wR μ) 0 (by rw [pow_zero, mul_one]; exact hψL μ) (hm μ hμ)
  letI : Algebra ↥W P := (ψP.comp Polynomial.C).toAlgebra
  have hfC : ψP.comp Polynomial.C = algebraMap ↥W P := rfl
  have hspan := s2 ↥W P ψP hfC hψet
  have hμq' : algebraMap ↥W P μ ∈ q := hμq
  have hres := s3 ↥W P (ψP Polynomial.X) y q μ hspan hμq'
  have hsm := s4 ↥W P ψP hfC hψet
  obtain ⟨s, hs, hset⟩ := wc_tube_jacobian_etale ↥W P 1 (Fin 1)
    ![ψP Polynomial.X + algebraMap ↥W P μ * y] hsm (Fintype.card_fin 1) q hres
  have hθ := hset (Localization.Away s)
  let θ₁ := (algebraMap P (Localization.Away s)).comp
    (MvPolynomial.eval₂Hom (algebraMap ↥W P) ![ψP Polynomial.X + algebraMap ↥W P μ * y])
  let ε : Polynomial ↥W →+* MvPolynomial (Fin 1) ↥W :=
    (MvPolynomial.uniqueAlgEquiv ↥W (Fin 1)).symm.toRingEquiv.toRingHom
  have hεC : ∀ w : ↥W, ε (Polynomial.C w) = MvPolynomial.C w := by
    intro w
    show (MvPolynomial.uniqueAlgEquiv ↥W (Fin 1)).symm (Polynomial.C w) = _
    rw [MvPolynomial.uniqueAlgEquiv_symm_apply, Polynomial.eval₂_C]
  have hεX : ε Polynomial.X = MvPolynomial.X 0 := by
    show (MvPolynomial.uniqueAlgEquiv ↥W (Fin 1)).symm Polynomial.X = _
    rw [MvPolynomial.uniqueAlgEquiv_symm_apply, Polynomial.eval₂_X, Fin.default_eq_zero]
  have hφC : ∀ π : ↥W, (θ₁.comp ε) (Polynomial.C π) =
      algebraMap P (Localization.Away s) (ψP (Polynomial.C π)) := by
    intro π
    show θ₁ (ε (Polynomial.C π)) = _
    rw [hεC]
    show algebraMap P (Localization.Away s) (MvPolynomial.eval₂Hom (algebraMap ↥W P)
      ![ψP Polynomial.X + algebraMap ↥W P μ * y] (MvPolynomial.C π)) = _
    rw [MvPolynomial.eval₂Hom_C]
    rfl
  have hφX : (θ₁.comp ε) Polynomial.X =
      algebraMap P (Localization.Away s) (ψP Polynomial.X + ψP (Polynomial.C μ) * y) := by
    show θ₁ (ε Polynomial.X) = _
    rw [hεX]
    show algebraMap P (Localization.Away s) (MvPolynomial.eval₂Hom (algebraMap ↥W P)
      ![ψP Polynomial.X + algebraMap ↥W P μ * y] (MvPolynomial.X 0)) = _
    rw [MvPolynomial.eval₂Hom_X', Matrix.cons_val_zero]
    rfl
  have hφet : (θ₁.comp ε).Etale :=
    RingHom.Etale.stableUnderComposition ε θ₁
      (RingHom.Etale.of_bijective (MvPolynomial.uniqueAlgEquiv ↥W (Fin 1)).symm.bijective) hθ
  obtain ⟨rg, m, hrg⟩ := hfrac s
  have hrgq : algebraMap R ↥(integralClosure R L) rg ∉ 𝔮 := hq2 s hs rg m hrg
  have hsK : algebraMap P K s ≠ 0 := by
    intro h0
    apply hrgq
    have h1 : algebraMap R ↥(integralClosure R L) rg = algebraMap R ↥(integralClosure R L) 0 :=
      htr _ _ (by rw [← hrg, IsScalarTower.algebraMap_apply P K L, h0, map_zero, zero_mul, map_zero])
    rw [h1, map_zero]
    exact zero_mem _
  have hs0 : s ≠ 0 := fun h0 => hsK (by rw [h0, map_zero])
  haveI hdom : IsDomain (Localization.Away s) :=
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hs0)
  let lam : Localization.Away s →+* K := IsLocalization.Away.lift s (IsUnit.mk0 _ hsK)
  have hlam : ∀ p : P, lam (algebraMap P (Localization.Away s) p) = algebraMap P K p :=
    IsLocalization.Away.lift_eq s (IsUnit.mk0 _ hsK)
  letI iK : Algebra (Localization.Away s) K := lam.toAlgebra
  letI iL : Algebra (Localization.Away s) L := ((algebraMap K L).comp lam).toAlgebra
  haveI iT : IsScalarTower (Localization.Away s) K L :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hinj : Function.Injective (algebraMap (Localization.Away s) K) := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨k, p, hp⟩ := IsLocalization.Away.surj s x
    have hx' : lam x = 0 := hx
    have h1 : algebraMap P K p = 0 := by
      rw [← hlam, ← hp, map_mul, hx', zero_mul]
    have hp0 : p = 0 := hPinj (by rw [h1, map_zero])
    have hu : IsUnit (algebraMap P (Localization.Away s) s ^ k) :=
      (IsLocalization.Away.algebraMap_isUnit s).pow k
    rw [hp0, map_zero] at hp
    exact hu.mul_left_eq_zero.mp hp
  have hG : algebraMap R ↥(integralClosure R L) (G₀ * rg) ∉ 𝔮 := by
    rw [map_mul]
    exact hq𝔮.mul_notMem hG₀ hrgq
  have e1 : ∀ p' : P, algebraMap (Localization.Away s) L (algebraMap P (Localization.Away s) p') =
      algebraMap P L p' := by
    intro p'
    show algebraMap K L (lam (algebraMap P _ p')) = _
    rw [hlam, ← IsScalarTower.algebraMap_apply]
  have hfrac' : ∀ x : Localization.Away s, ∃ (r : R) (n : ℕ),
      algebraMap (Localization.Away s) L x * algebraMap R L (G₀ * rg) ^ n = algebraMap R L r := by
    intro x
    obtain ⟨k, p, hp⟩ := IsLocalization.Away.surj s x
    obtain ⟨rp, n, hrp⟩ := hfrac p
    refine ⟨rp * G₀ ^ (m * k + k) * rg ^ n, n + k, ?_⟩
    have hxL : algebraMap (Localization.Away s) L x * algebraMap P L s ^ k = algebraMap P L p := by
      have h3 := congrArg (algebraMap (Localization.Away s) L) hp
      rw [map_mul, map_pow, e1, e1] at h3
      exact h3
    simp only [map_mul, map_pow]
    rw [← hrp, ← hxL, ← hrg]
    ring
  exact ⟨Localization.Away s, inferInstance, hdom, iK, iL, iT, θ₁.comp ε,
    algebraMap P (Localization.Away s), G₀ * rg, hφet, hinj, hlam, hφC, hφX, hG, hfrac'⟩

theorem wcLlsASvmrs_adjoin_basechange : ∀ (R0 B : Type u) [CommRing R0] [CommRing B] (φ : Polynomial R0 →+* B) (H : Polynomial R0), RingHom.Etale φ → ∃ f : Polynomial R0 →+* AdjoinRoot (H.map (φ.comp Polynomial.C) - Polynomial.C (φ Polynomial.X)), f.comp Polynomial.C = (AdjoinRoot.of (H.map (φ.comp Polynomial.C) - Polynomial.C (φ Polynomial.X))).comp (φ.comp Polynomial.C) ∧ f Polynomial.X = AdjoinRoot.root (H.map (φ.comp Polynomial.C) - Polynomial.C (φ Polynomial.X)) ∧ RingHom.Etale f :=
by
  intro R0 B _ _ φ H hφ
  set F := H.map (φ.comp Polynomial.C) - Polynomial.C (φ Polynomial.X) with hF
  let σ : Polynomial R0 →+* Polynomial R0 := Polynomial.eval₂RingHom Polynomial.C H
  let f : Polynomial R0 →+* AdjoinRoot F :=
    Polynomial.eval₂RingHom ((AdjoinRoot.of F).comp (φ.comp Polynomial.C)) (AdjoinRoot.root F)
  have hfC : f.comp Polynomial.C = (AdjoinRoot.of F).comp (φ.comp Polynomial.C) := by
    ext r
    simp [f]
  have hfX : f Polynomial.X = AdjoinRoot.root F := by simp [f]
  have hfH : f H = AdjoinRoot.of F (φ Polynomial.X) := by
    have h0 : Polynomial.eval₂ (AdjoinRoot.of F) (AdjoinRoot.root F)
        (H.map (φ.comp Polynomial.C) - Polynomial.C (φ Polynomial.X)) = 0 :=
      AdjoinRoot.eval₂_root F
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_C, Polynomial.eval₂_map, sub_eq_zero] at h0
    exact h0
  have hsqR : f.comp σ = (AdjoinRoot.of F).comp φ := by
    apply Polynomial.ringHom_ext
    · intro a
      simp [σ, f]
    · simp only [RingHom.comp_apply]
      simp only [σ, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      exact hfH
  have key : ∀ (S : Type u) [CommRing S] (a : Polynomial R0 →+* S) (b : B →+* S),
      a.comp σ = b.comp φ → Polynomial.eval₂ b (a Polynomial.X) F = 0 := by
    intro S _ a b hab
    have hC : ∀ r : R0, b (φ (Polynomial.C r)) = a (Polynomial.C r) := by
      intro r
      have := congrArg (fun g => g (Polynomial.C r)) hab
      simpa [σ] using this.symm
    have hX : b (φ Polynomial.X) = a H := by
      have := congrArg (fun g => g Polynomial.X) hab
      simpa [σ] using this.symm
    have hbC : b.comp (φ.comp Polynomial.C) = a.comp Polynomial.C := by
      ext r
      exact hC r
    show Polynomial.eval₂ b (a Polynomial.X)
        (H.map (φ.comp Polynomial.C) - Polynomial.C (φ Polynomial.X)) = 0
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_C, Polynomial.eval₂_map, hbC, hX,
      ← Polynomial.hom_eval₂, Polynomial.eval₂_C_X, sub_self]
  have hsq : CommSq (CommRingCat.ofHom σ) (CommRingCat.ofHom φ) (CommRingCat.ofHom f)
      (CommRingCat.ofHom (AdjoinRoot.of F)) := ⟨by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hsqR]⟩
  have hs : ∀ s : Limits.PushoutCocone (CommRingCat.ofHom σ) (CommRingCat.ofHom φ),
      s.inl.hom.comp σ = s.inr.hom.comp φ := by
    intro s
    have := congrArg CommRingCat.Hom.hom s.condition
    simpa using this
  have hpush : IsPushout (CommRingCat.ofHom σ) (CommRingCat.ofHom φ) (CommRingCat.ofHom f)
      (CommRingCat.ofHom (AdjoinRoot.of F)) := by
    refine IsPushout.of_isColimit' hsq
      (Limits.PushoutCocone.IsColimit.mk _
        (fun s => CommRingCat.ofHom (AdjoinRoot.lift s.inr.hom (s.inl.hom Polynomial.X)
          (key _ s.inl.hom s.inr.hom (hs s)))) ?_ ?_ ?_)
    · intro s
      ext1
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
      apply Polynomial.ringHom_ext
      · intro r
        have h1 : f (Polynomial.C r) = AdjoinRoot.of F (φ (Polynomial.C r)) := by
          simp [f]
        have h2 := congrArg (fun g => g (Polynomial.C r)) (hs s)
        simp only [RingHom.comp_apply] at h2 ⊢
        rw [h1, AdjoinRoot.lift_of]
        simpa [σ] using h2.symm
      · simp only [RingHom.comp_apply]
        rw [hfX, AdjoinRoot.lift_root]
    · intro s
      ext1
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
      ext x
      simp only [RingHom.comp_apply]
      exact AdjoinRoot.lift_of _
    · intro s m h1 h2
      ext1
      rw [CommRingCat.hom_ofHom]
      have e1 := congrArg CommRingCat.Hom.hom h1
      have e2 := congrArg CommRingCat.Hom.hom h2
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom] at e1 e2
      apply AdjoinRoot.ringHom_ext
      · rw [e2]
        ext x
        exact (AdjoinRoot.lift_of (key _ s.inl.hom s.inr.hom (hs s))).symm
      · rw [AdjoinRoot.lift_root, ← e1, RingHom.comp_apply, hfX]
  have := RingHom.isStableUnderCobaseChange_toMorphismProperty_iff.mpr
    RingHom.Etale.isStableUnderBaseChange
  have hE := MorphismProperty.of_isPushout (P := RingHom.toMorphismProperty RingHom.Etale)
    hpush hφ
  exact ⟨f, hfC, hfX, hE⟩

theorem wcLlsASvmrs_root_model : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (R : Type u) [CommRing R] (L : Type u) [Field L] [Algebra R L] (𝔮 : Ideal ↥(integralClosure R L)) [𝔮.IsPrime] (wR : ↥W →+* R) (P : Type u) [CommRing P] [Algebra P L] (ψP : Polynomial ↥W →+* P) (G : R) (w : L) (F : Polynomial P) (f : Polynomial ↥W →+* AdjoinRoot F), f.Etale → f.comp Polynomial.C = (AdjoinRoot.of F).comp (ψP.comp Polynomial.C) → (∀ π : ↥W, algebraMap P L (ψP (Polynomial.C π)) = algebraMap R L (wR π)) → algebraMap R ↥(integralClosure R L) G ∉ 𝔮 → (∀ r : R, ∃ x : P, algebraMap P L x = algebraMap R L r) → (∀ x : P, ∃ (r : R) (n : ℕ), algebraMap P L x * algebraMap R L G ^ n = algebraMap R L r) → (∀ l : L, ∃ (y : R) (Gl : Polynomial P), algebraMap R L y ≠ 0 ∧ l * algebraMap R L y = Polynomial.aeval w Gl) → (∃ N : ℕ, IsIntegral R (algebraMap R L G ^ N * w)) → Polynomial.aeval w F = 0 → (∀ Gl : Polynomial P, Polynomial.aeval w Gl = 0 → F ∣ Gl) → ∃ (T : Type u) (_ : CommRing T) (ψ : Polynomial ↥W →+* T) (j₀ : T →+* L), ψ.Etale ∧ Function.Injective j₀ ∧ (∀ π : ↥W, j₀ (ψ (Polynomial.C π)) = algebraMap R L (wR π)) ∧ (∀ l : L, ∃ x y : T, j₀ y ≠ 0 ∧ l * j₀ y = j₀ x) ∧ (∀ r : R, ∃ x : T, j₀ x = algebraMap R L r) ∧ (∀ x : T, ∃ z s : ↥(integralClosure R L), s ∉ 𝔮 ∧ j₀ x * (s : L) = (z : L)) :=
by
  intro Ω _ W R _ L _ _ 𝔮 _ wR P _ _ ψP G w F f hf hfC hW hGq hRP hfrac hgen hint hFw hdvd
  have hev : Polynomial.eval₂ (algebraMap P L) w F = 0 := by
    rw [← Polynomial.aeval_def]; exact hFw
  set j : AdjoinRoot F →+* L := AdjoinRoot.lift (algebraMap P L) w hev with hj
  have hjof : ∀ p : P, j (AdjoinRoot.of F p) = algebraMap P L p := fun p =>
    AdjoinRoot.lift_of hev
  have hjmk : ∀ g : Polynomial P, j (AdjoinRoot.mk F g) = Polynomial.aeval w g := by
    intro g
    rw [hj, AdjoinRoot.lift_mk, Polynomial.aeval_def]
  have hjinj : Function.Injective j := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨g, rfl⟩ := AdjoinRoot.mk_surjective x
    rw [hjmk] at hx
    exact AdjoinRoot.mk_eq_zero.mpr (hdvd g hx)
  obtain ⟨N, hN⟩ := hint
  have hmono : ∀ (a : L) (k k' : ℕ), k ≤ k' → IsIntegral R (a * algebraMap R L G ^ k) →
      IsIntegral R (a * algebraMap R L G ^ k') := by
    intro a k k' hk ha
    have e : a * algebraMap R L G ^ k' =
        (a * algebraMap R L G ^ k) * algebraMap R L (G ^ (k' - k)) := by
      rw [map_pow, mul_assoc, ← pow_add, Nat.add_sub_cancel' hk]
    rw [e]
    exact ha.mul isIntegral_algebraMap
  have hsc : ∀ g : Polynomial P, ∃ k : ℕ,
      IsIntegral R (Polynomial.aeval w g * algebraMap R L G ^ k) := by
    intro g
    induction g using Polynomial.induction_on' with
    | add p q hp hq =>
      obtain ⟨kp, hkp⟩ := hp
      obtain ⟨kq, hkq⟩ := hq
      refine ⟨max kp kq, ?_⟩
      rw [map_add, add_mul]
      exact (hmono _ _ _ (le_max_left _ _) hkp).add (hmono _ _ _ (le_max_right _ _) hkq)
    | monomial n a =>
      obtain ⟨r, m, hr⟩ := hfrac a
      refine ⟨m + N * n, ?_⟩
      have e : Polynomial.aeval w (Polynomial.monomial n a) * algebraMap R L G ^ (m + N * n)
          = algebraMap R L r * (algebraMap R L G ^ N * w) ^ n := by
        rw [Polynomial.aeval_monomial, ← hr, pow_add, pow_mul, mul_pow]
        ring
      rw [e]
      exact isIntegral_algebraMap.mul (hN.pow n)
  refine ⟨AdjoinRoot F, inferInstance, f, j, hf, hjinj, ?_, ?_, ?_, ?_⟩
  · intro π
    have h1 : f (Polynomial.C π) = AdjoinRoot.of F (ψP (Polynomial.C π)) := by
      have := RingHom.congr_fun hfC π
      simpa only [RingHom.comp_apply] using this
    rw [h1, hjof, hW]
  · intro l
    obtain ⟨y, Gl, hy0, hy⟩ := hgen l
    obtain ⟨p, hp⟩ := hRP y
    refine ⟨AdjoinRoot.mk F Gl, AdjoinRoot.of F p, ?_, ?_⟩
    · rw [hjof, hp]; exact hy0
    · rw [hjof, hjmk, hp, hy]
  · intro r
    obtain ⟨p, hp⟩ := hRP r
    exact ⟨AdjoinRoot.of F p, by rw [hjof, hp]⟩
  · intro x
    obtain ⟨g, rfl⟩ := AdjoinRoot.mk_surjective x
    obtain ⟨k, hk⟩ := hsc g
    refine ⟨⟨Polynomial.aeval w g * algebraMap R L G ^ k, hk⟩,
      (algebraMap R (integralClosure R L) G) ^ k, ?_, ?_⟩
    · intro hmem
      exact hGq (Ideal.IsPrime.mem_of_pow_mem inferInstance k hmem)
    · rw [hjmk]
      simp

theorem wcLlsASvmrs_model_delta : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (R : Type u) [CommRing R] [IsDomain R] (L : Type u) [Field L] [Algebra R L] (wL : ↥W →+* L) (wR : ↥W →+* R) (𝔮 : Ideal ↥(integralClosure R L)) [𝔮.IsPrime] (T : Type u) [CommRing T] (ψ : Polynomial ↥W →+* T) (j₀ : T →+* L), (∀ π : ↥W, algebraMap R L (wR π) = wL π) → (∀ π ∈ IsLocalRing.maximalIdeal ↥W, algebraMap R ↥(integralClosure R L) (wR π) ∈ 𝔮) → ψ.Etale → Function.Injective j₀ → (∀ π : ↥W, j₀ (ψ (Polynomial.C π)) = algebraMap R L (wR π)) → (∀ l : L, ∃ x y : T, j₀ y ≠ 0 ∧ l * j₀ y = j₀ x) → (∀ r : R, ∃ x : T, j₀ x = algebraMap R L r) → (∀ x : T, ∃ z s : ↥(integralClosure R L), s ∉ 𝔮 ∧ j₀ x * (s : L) = (z : L)) → wcpaDjLkDelta (wcLlsFS W wL R 𝔮) = 0 :=
by
  intro Ω _ W R _ _ L _ _ wL wR 𝔮 _ T _ ψ j₀ hwL hm hψet hj₀inj hj₀W hj₀gen hj₀R hj₀B

  have s11 : ∀ (B : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B],
      wcpaDjLkDelta B = 0 := by
    intro B _ _ _
    unfold wcpaDjLkDelta
    rw [Module.length_eq_zero_iff]
    have htop : LinearMap.range
        (Algebra.linearMap B ↥(integralClosure B (FractionRing B))) = ⊤ := by
      rw [eq_top_iff]
      rintro ⟨x, hx⟩ -
      obtain ⟨b, hb⟩ := IsIntegrallyClosed.isIntegral_iff.mp (show IsIntegral B x from hx)
      exact LinearMap.mem_range.mpr ⟨b, Subtype.ext hb⟩
    constructor
    intro a b
    induction a using Submodule.Quotient.induction_on with
    | _ a =>
    induction b using Submodule.Quotient.induction_on with
    | _ b =>
    rw [Submodule.Quotient.eq, htop]
    exact Submodule.mem_top

  obtain ⟨Q', hQ', j, φ, hQm, hj, hφ, hWc, hfrac, hR, hzs⟩ :=
    wcLlsKPas_model_localize Ω W R L 𝔮 wR T ψ j₀ hj₀inj hm hj₀W hj₀gen hj₀R hj₀B

  obtain ⟨hD, hDn, hFd, hFn⟩ := wcLlsKPas_etale_fibre_normal Ω W T ψ hψet Q' hQm
  haveI := hD
  haveI := hDn
  have hbij := wcLlsKPas_local_model_bijective R L 𝔮
    (Localization.AtPrime Q') j φ hj hφ hfrac hR hzs
  let Φ : Localization.AtPrime Q' ≃+* Localization.AtPrime 𝔮 := RingEquiv.ofBijective φ hbij

  have hcomp : (Φ : Localization.AtPrime Q' →+* Localization.AtPrime 𝔮).comp
      ((algebraMap T (Localization.AtPrime Q')).comp (ψ.comp Polynomial.C)) =
      (algebraMap ↥(integralClosure R L) (Localization.AtPrime 𝔮)).comp
        ((algebraMap R ↥(integralClosure R L)).comp wR) := by
    ext π
    exact hWc π
  have hset : {z : ↥(integralClosure R L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (z : L) = wL w} =
      ((algebraMap R ↥(integralClosure R L)).comp wR) ''
        (IsLocalRing.maximalIdeal ↥W : Set ↥W) := by
    ext z
    constructor
    · rintro ⟨π, hπ, hz⟩
      exact ⟨π, hπ, Subtype.ext (hz.trans (hwL π).symm).symm⟩
    · rintro ⟨π, hπ, rfl⟩
      exact ⟨π, hπ, hwL π⟩
  have hIeq : (Ideal.span {z : ↥(integralClosure R L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (z : L) = wL w}).map
        (algebraMap ↥(integralClosure R L) (Localization.AtPrime 𝔮)) =
      ((IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap T (Localization.AtPrime Q')).comp (ψ.comp Polynomial.C))).map
        (Φ : Localization.AtPrime Q' →+* Localization.AtPrime 𝔮) := by
    rw [Ideal.map_map, hcomp, ← Ideal.map_map, hset]
    rfl
  let E := Ideal.quotientEquiv
    ((IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap T (Localization.AtPrime Q')).comp (ψ.comp Polynomial.C)))
    ((Ideal.span {z : ↥(integralClosure R L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (z : L) = wL w}).map
        (algebraMap ↥(integralClosure R L) (Localization.AtPrime 𝔮))) Φ hIeq
  haveI := hFd
  haveI := hFn
  haveI : IsDomain (wcLlsFS W wL R 𝔮) := MulEquiv.isDomain _ E.symm.toMulEquiv
  haveI : IsIntegrallyClosed (wcLlsFS W wL R 𝔮) := IsIntegrallyClosed.of_equiv E
  exact s11 _

theorem wcLlsASvm_read_small : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ((ℓ : ℕ) : K) = 0 → Module.finrank K L = ℓ → ∀ (α : L) (f : K), α ∉ Set.range (algebraMap K L) → α ^ ℓ - α = algebraMap K L f → ∀ c b κ μ : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → κ ≠ 0 → μ ∈ IsLocalRing.maximalIdeal ↥W → ∀ (h : K) (θ : ↥W), ((θ = 0 ∧ κ = 1) ∨ (θ = 1 ∧ κ ∈ IsLocalRing.maximalIdeal ↥W)) → wcLlsVmSmall W A K 𝔭 t c b μ (algebraMap A K (algebraMap ↥W A κ) ^ ℓ * (f - h ^ ℓ + h) - algebraMap A K (algebraMap ↥W A θ) * wcLlsScS W A K t c b) → ∀ e : ↥W, wcLlsInnerSmooth W A K L t c b e :=
by
  intro Ω _ _ W hW hWt ℓ hℓ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD hK hdeg α f hα hf c b κ μ hc hb
    hb0 hκ0 hμ h θ hθκ hsmall e
  classical

  have hnz : NoZeroSMulDivisors ↥W A := hPD.2.1
  have hι : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    rw [Algebra.algebraMap_eq_smul_one] at hx
    rcases smul_eq_zero.mp hx with h' | h'
    · exact h'
    · exact absurd h' one_ne_zero
  have hj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hinjW : ∀ x : ↥W, algebraMap A K (algebraMap ↥W A x) = 0 → x = 0 := by
    intro x hx
    apply hι
    apply hj
    rw [hx, map_zero, map_zero]
  have hℓL : ((ℓ : ℕ) : L) = 0 := by rw [← map_natCast (algebraMap K L), hK, map_zero]
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : CharP L ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hℓL
  obtain ⟨x, d, a, ha, hda, hE⟩ := hsmall

  have hfrob : ∀ k : K, (algebraMap K L k * (α - algebraMap K L h)) ^ ℓ -
      algebraMap K L k ^ (ℓ - 1) * (algebraMap K L k * (α - algebraMap K L h)) =
      algebraMap K L (k ^ ℓ * (f - h ^ ℓ + h)) := by
    intro k
    have e1 : algebraMap K L k ^ (ℓ - 1) * algebraMap K L k = algebraMap K L k ^ ℓ :=
      pow_sub_one_mul hℓ.ne_zero _
    have e2 : (α - algebraMap K L h) ^ ℓ = α ^ ℓ - algebraMap K L h ^ ℓ := sub_pow_char _ _
    simp only [map_mul, map_pow, map_sub, map_add]
    rw [mul_pow, e2]
    linear_combination (algebraMap K L k ^ ℓ) * hf - (α - algebraMap K L h) * e1

  have hnotK : ∀ k : K, k ≠ 0 →
      algebraMap K L k * (α - algebraMap K L h) ∉ Set.range (algebraMap K L) := by
    rintro k hk ⟨z, hz⟩
    apply hα
    refine ⟨z / k + h, ?_⟩
    have hkL : algebraMap K L k ≠ 0 := (map_ne_zero _).mpr hk
    rw [map_add, map_div₀, hz, mul_div_cancel_left₀ _ hkL, sub_add_cancel]
  intro 𝔮 _ h𝔮
  rcases hθκ with ⟨rfl, rfl⟩ | ⟨rfl, hκm⟩
  ·
    simp only [map_one, one_pow, one_mul, map_zero, zero_mul, sub_zero] at hE
    have hfr := hfrob 1
    simp only [map_one, one_mul, one_pow] at hfr
    have hnK := hnotK 1 one_ne_zero
    simp only [map_one, one_mul] at hnK
    have heq : ((α - algebraMap K L h) ^ ℓ - (α - algebraMap K L h)) * algebraMap K L (d : K) =
        algebraMap K L (algebraMap A K (algebraMap ↥W A μ) * (x : K)) := by
      rw [hfr, ← map_mul, hE]
    exact wcLlsASvmrs_split_smooth Ω W hW hWt ℓ hℓ A K L 𝔭 t c b e hPD hc hb hb0 hK hdeg _ hnK
      μ x d a ha hda heq 𝔮 h𝔮
  ·
    simp only [map_one, one_mul] at hE
    obtain ⟨hA, hm⟩ := wcLlsKPas_prime_contract Ω W A K L 𝔭 t hPD c b e hc hb hb0 𝔮 h𝔮
    have hinjRK : Function.Injective
        (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) K) := Subtype.val_injective
    have hRK : ∀ a' : A, algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) K
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) a') = algebraMap A K a' :=
      fun a' => rfl
    have hRL : ∀ r : ↥(Algebra.adjoin A {wcLlsScS W A K t c b}),
        algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L r =
          algebraMap K L (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) K r) :=
      fun r => rfl
    have hRne : ∀ a' : A, a' ∉ 𝔭 →
        algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) a' ≠ 0 := by
      intro a' ha' h0
      apply ha'
      have h1 : algebraMap A K a' = 0 := by rw [← hRK, h0, map_zero]
      have h2 := (map_eq_zero_iff (algebraMap A K) (IsFractionRing.injective A K)).mp h1
      rw [h2]
      exact 𝔭.zero_mem

    have hdQ : algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L) d ∉ 𝔮 := by
      intro hd
      have hmle : (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A)) ≤
          𝔮.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)) := by
        rw [h𝔮]; exact le_sup_right
      have h1 := hmle hda
      have h2 : d ∈ 𝔮.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)) := hd
      have h3 := Ideal.sub_mem _ h2 h1
      rw [sub_sub_cancel] at h3
      exact hA a ha h3
    have hd0 : d ≠ 0 := by
      intro h0
      apply hdQ
      rw [h0, map_zero]
      exact 𝔮.zero_mem
    have hdK : (d : K) ≠ 0 := fun h0 => hd0 (hinjRK (h0.trans (map_zero _).symm))

    obtain ⟨h₀, hh₀, ψ₀, hψ₀C, hψ₀X, hψ₀et⟩ :=
      wcLlsKPas_chart_etale Ω W A K 𝔭 t hPD c b hc hb hb0
    obtain ⟨P, iP1, iP2, iP3, iP4, iP5, ψP, ι, hψPet, hψPeq, hPinj, hPR, hPfrac, hPloc⟩ :=
      wcLlsKPas_chart_localize Ω W ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) K L
        (algebraMap A _ h₀) d hinjRK (hRne h₀ hh₀) hd0 ψ₀ hψ₀et

    have hψPK : ∀ π : ↥W, algebraMap P K (ψP (Polynomial.C π)) =
        algebraMap A K (algebraMap ↥W A π) := by
      intro π
      have e1 : ψ₀ (Polynomial.C π) =
          algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
            (Localization.Away (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) h₀))
            (algebraMap A _ (algebraMap ↥W A π)) := RingHom.congr_fun hψ₀C π
      rw [hψPeq, RingHom.comp_apply, e1, hPR, hRK]
    have hψPL : ∀ π : ↥W, algebraMap P L (ψP (Polynomial.C π)) =
        algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L
          (((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp
            (algebraMap ↥W A)) π) := by
      intro π
      rw [IsScalarTower.algebraMap_apply P K L, hψPK, hRL, RingHom.comp_apply, hRK]
    have hψPX : algebraMap P K (ψP Polynomial.X) = wcLlsScS W A K t c b := by
      rw [hψPeq, RingHom.comp_apply, hψ₀X, hPR]
      rfl

    have hxdK : algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) K d ^ 1 *
        ((x : K) / (d : K)) ∈
        Set.range (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) K) := by
      refine ⟨x, ?_⟩
      rw [pow_one]
      show (x : K) = (d : K) * ((x : K) / (d : K))
      rw [mul_div_cancel₀ _ hdK]
    obtain ⟨yP, hyP⟩ := hPloc ((x : K) / (d : K)) 1 hxdK

    have hG₀q : algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)
        (algebraMap A _ h₀ * d) ∉ 𝔮 := by
      rw [map_mul]
      exact (inferInstance : 𝔮.IsPrime).mul_notMem (hA h₀ hh₀) hdQ
    have hfracL : ∀ x' : P, ∃ (r : ↥(Algebra.adjoin A {wcLlsScS W A K t c b})) (n : ℕ),
        algebraMap P L x' * algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L
          (algebraMap A _ h₀ * d) ^ n =
        algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L r := by
      intro x'
      obtain ⟨r, n, hr⟩ := hPfrac x'
      refine ⟨r, n, ?_⟩
      rw [IsScalarTower.algebraMap_apply P K L, hRL, hRL, ← hr]
      simp only [map_mul, map_pow]

    obtain ⟨P', j1, j2, j3, j4, j5, ψ', ι', G, hψ'et, hP'inj, hι'K, hψ'C, hψ'X, hGq, hfrac'⟩ :=
      wcLlsASvmrs_recoord Ω W ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) K L 𝔮
        ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A))
        P ψP (algebraMap A _ h₀ * d) μ yP hψPet hPinj hψPL hμ hm hG₀q hfracL
    have hι'L : ∀ p : P, algebraMap P' L (ι' p) = algebraMap P L p := by
      intro p
      rw [IsScalarTower.algebraMap_apply P' K L, hι'K, ← IsScalarTower.algebraMap_apply P K L]
    have hψ'L : ∀ π : ↥W, algebraMap P' L (ψ' (Polynomial.C π)) =
        algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L
          (((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp
            (algebraMap ↥W A)) π) := by
      intro π
      rw [hψ'C, hι'L, hψPL]
    have hS'K : algebraMap P' K (ψ' Polynomial.X) = wcLlsScS W A K t c b +
        algebraMap A K (algebraMap ↥W A μ) * ((x : K) / (d : K)) := by
      rw [hψ'X, hι'K, map_add, map_mul, hψPX, hψPK, hyP]
    have hRP' : ∀ r : ↥(Algebra.adjoin A {wcLlsScS W A K t c b}), ∃ x' : P',
        algebraMap P' L x' = algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L r := by
      intro r
      refine ⟨ι' (ι (algebraMap _ _ r)), ?_⟩
      rw [hι'L, IsScalarTower.algebraMap_apply P K L, hPR, hRL]

    obtain ⟨H, hH⟩ : ∃ H : Polynomial ↥W,
        H = Polynomial.X ^ ℓ - Polynomial.C (κ ^ (ℓ - 1)) * Polynomial.X := ⟨_, rfl⟩
    obtain ⟨f₁, hf₁C, -, hf₁et⟩ := wcLlsASvmrs_adjoin_basechange ↥W P' ψ' H hψ'et
    have hFeq : H.map (ψ'.comp Polynomial.C) - Polynomial.C (ψ' Polynomial.X) =
        Polynomial.X ^ ℓ - (Polynomial.C (ψ' (Polynomial.C (κ ^ (ℓ - 1)))) * Polynomial.X +
          Polynomial.C (ψ' Polynomial.X)) := by
      rw [hH]
      simp only [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_mul,
        Polynomial.map_C, RingHom.comp_apply]
      ring
    have hℓ2 := hℓ.two_le
    have hFmon : (H.map (ψ'.comp Polynomial.C) - Polynomial.C (ψ' Polynomial.X)).Monic := by
      rw [hFeq]
      apply (Polynomial.monic_X_pow ℓ).sub_of_left
      calc _ ≤ 1 := Polynomial.degree_linear_le
        _ < _ := by
          rw [Polynomial.degree_X_pow]
          exact_mod_cast (show 1 < ℓ by omega)
    have hFdeg : (H.map (ψ'.comp Polynomial.C) - Polynomial.C (ψ' Polynomial.X)).natDegree =
        ℓ := by
      rw [hFeq, Polynomial.natDegree_sub_eq_left_of_natDegree_lt, Polynomial.natDegree_X_pow]
      rw [Polynomial.natDegree_X_pow]
      exact lt_of_le_of_lt Polynomial.natDegree_linear_le (by omega)
    have hκK0 : algebraMap A K (algebraMap ↥W A κ) ≠ 0 := fun h0 => hκ0 (hinjW _ h0)
    have hwnK := hnotK _ hκK0
    have hfr := hfrob (algebraMap A K (algebraMap ↥W A κ))
    have hE' : algebraMap A K (algebraMap ↥W A κ) ^ ℓ * (f - h ^ ℓ + h) =
        wcLlsScS W A K t c b + algebraMap A K (algebraMap ↥W A μ) * ((x : K) / (d : K)) := by
      have e3 : algebraMap A K (algebraMap ↥W A μ) * ((x : K) / (d : K)) =
          algebraMap A K (algebraMap ↥W A κ) ^ ℓ * (f - h ^ ℓ + h) -
            wcLlsScS W A K t c b := by
        rw [mul_div_assoc', div_eq_iff hdK, ← hE]
      rw [e3]
      ring
    have hFw : Polynomial.aeval (algebraMap K L (algebraMap A K (algebraMap ↥W A κ)) *
        (α - algebraMap K L h))
        (H.map (ψ'.comp Polynomial.C) - Polynomial.C (ψ' Polynomial.X)) = 0 := by
      rw [hFeq, map_sub, map_add, map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C,
        Polynomial.aeval_C]
      have hν : algebraMap P' L (ψ' (Polynomial.C (κ ^ (ℓ - 1)))) =
          algebraMap K L (algebraMap A K (algebraMap ↥W A κ)) ^ (ℓ - 1) := by
        rw [hψ'L, RingHom.comp_apply, hRL, hRK, map_pow, map_pow, map_pow]
      have hS' : algebraMap P' L (ψ' Polynomial.X) = algebraMap K L (wcLlsScS W A K t c b +
          algebraMap A K (algebraMap ↥W A μ) * ((x : K) / (d : K))) := by
        rw [IsScalarTower.algebraMap_apply P' K L, hS'K]
      rw [hν, hS', ← hE']
      linear_combination hfr

    obtain ⟨-, hdvd, hgen⟩ :=
      wcLlsKPas_minpoly_dvd K L P' hP'inj ℓ hℓ hdeg _ _ hwnK hFmon hFdeg hFw

    have hgenR := wcLlsKPas_generation A K L ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) P'
      (algebraMap A _) _ (fun a' => by rw [hRL, hRK]) hRP' hgen
    have hint := wcLlsKPas_scaled_integral ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) P' L G
      _ _ hFmon hFw hfrac'

    obtain ⟨T, iT, ψ, j₀, hψet, hj₀inj, hj₀W, hj₀gen, hj₀R, hj₀B⟩ :=
      wcLlsASvmrs_root_model Ω W ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L 𝔮
        ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A))
        P' ψ' G _ _ f₁ hf₁et hf₁C hψ'L hGq hRP' hfrac' hgenR hint hFw hdvd

    exact wcLlsASvmrs_model_delta Ω W ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L
      ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A))
      𝔮 T ψ j₀ (fun π => rfl) hm hψet hj₀inj hj₀W hj₀gen hj₀R hj₀B

theorem wcLlsASre_gauss_prime : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ c b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → ((IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A))).IsPrime ∧ (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A)) < Ideal.span {⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ - algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (algebraMap ↥W A 0)} ⊔ (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A)) ∧ ∀ (a : A) (d : ↥(Algebra.adjoin A {wcLlsScS W A K t c b})), a ∉ 𝔭 → d - algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) a ∈ (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A)) → d ∉ (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A)) :=
by
  intro Ω _ _ W A _ _ _ K _ _ _ 𝔭 t hPD c b hc hb hb0
  have h𝔭max : 𝔭.IsMaximal := hPD.2.2.2.1
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h => h𝔭max.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have hm1 : (1 : ↥W) ∉ IsLocalRing.maximalIdeal ↥W := fun h =>
    (IsLocalRing.maximalIdeal.isMaximal ↥W).ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have hcf : (∀ r : ↥(Algebra.adjoin A {wcLlsScS W A K t c b}), ∃ f : Polynomial ↥W,
      r - Polynomial.eval₂ ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp
          (algebraMap ↥W A))
        ⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ f ∈
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A))) ∧
    (∀ (a : A) (n : ℕ) (f : Polynomial ↥W), a ∉ 𝔭 →
      algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) a ^ n *
        Polynomial.eval₂ ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp
            (algebraMap ↥W A))
          ⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ f ∈
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A)) →
      ∀ i, f.coeff i ∈ IsLocalRing.maximalIdeal ↥W) := by
    classical
    unfold wcLlsPD at hPD
    simp only at hPD
    obtain ⟨hFT, hNZ, -, h𝔭max, hmA, ht𝔭, h𝔭eq, h, hh, f, hfC, hfX, hfet⟩ := hPD
    haveI := hNZ
    haveI := h𝔭max
    letI : Field (A ⧸ 𝔭) := Ideal.Quotient.field 𝔭
    have transfer : ∀ (P S : Type u) [CommRing P] [CommRing S] [Algebra P S] [Module.Flat P S]
        (p r : P), (∀ y : P, r * y ∈ Ideal.span {p} → y ∈ Ideal.span {p}) →
        ∀ x : S, algebraMap P S r * x ∈ Ideal.span {algebraMap P S p} →
          x ∈ Ideal.span {algebraMap P S p} := by
      intro P S _ _ _ _ p r hreg x hx
      obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp hx
      let f : Fin 2 → P := ![r, p]
      let v : Fin 2 → S := ![x, -y]
      have hrel : ∑ i, f i • v i = 0 := by
        rw [Fin.sum_univ_two]
        show r • x + p • (-y) = 0
        rw [Algebra.smul_def, Algebra.smul_def, ← hy]; ring
      obtain ⟨k, A, z, hx', hA⟩ :=
        Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (R := P) (M := S) hrel
      have hx0 : x = ∑ j, A 0 j • z j := hx' 0
      have hdiv : ∀ j, A 0 j ∈ Ideal.span {p} := by
        intro j
        apply hreg
        have h3 : ∑ i, f i * A i j = 0 := hA j
        rw [Fin.sum_univ_two] at h3
        change r * A 0 j + p * A 1 j = 0 at h3
        rw [Ideal.mem_span_singleton']
        exact ⟨-A 1 j, by linear_combination -h3⟩
      choose s hs using fun j => Ideal.mem_span_singleton'.mp (hdiv j)
      rw [hx0, Ideal.mem_span_singleton']
      refine ⟨∑ j, algebraMap P S (s j) * z j, ?_⟩
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Algebra.smul_def, ← hs j, map_mul]
      ring
    have rees : ∀ (B : Type u) [CommRing B] [IsDomain B] (K : Type u)
        [Field K] [Algebra B K], Function.Injective (algebraMap B K) → ∀ (h a : B), h ≠ 0 →
        (∀ x : B, a * x ∈ Ideal.span {h} → x ∈ Ideal.span {h}) →
        RingHom.ker (Polynomial.aeval (R := B) (algebraMap B K a / algebraMap B K h)) =
          Ideal.span {Polynomial.C h * Polynomial.X - Polynomial.C a} := by
      intro B _ _ K _ _ hinj h a hh hreg
      have hιh : algebraMap B K h ≠ 0 := by
        intro h0
        apply hh
        apply hinj
        rw [h0, map_zero]
      have hhr : algebraMap B K h * (algebraMap B K a / algebraMap B K h) = algebraMap B K a :=
        mul_div_cancel₀ _ hιh
      have s1 : Ideal.span {Polynomial.C h * Polynomial.X - Polynomial.C a} ≤
          RingHom.ker (Polynomial.aeval (R := B) (algebraMap B K a / algebraMap B K h)) := by
        rw [Ideal.span_le, Set.singleton_subset_iff]
        show _ ∈ RingHom.ker _
        rw [RingHom.mem_ker, map_sub, map_mul, Polynomial.aeval_C, Polynomial.aeval_C,
          Polynomial.aeval_X, hhr, sub_self]
      have s2 : ∀ P : Polynomial B,
          Polynomial.aeval (algebraMap B K a / algebraMap B K h) P = 0 →
          h ∣ P.leadingCoeff * a ^ P.natDegree := by
        intro P hP
        have hev : Polynomial.eval a (P.scaleRoots h) = 0 := by
          apply hinj
          rw [map_zero, ← Polynomial.eval₂_at_apply, ← hhr, Polynomial.scaleRoots_eval₂_mul,
            ← Polynomial.aeval_def, hP, mul_zero]
        rw [Polynomial.eval_eq_sum_range, Polynomial.natDegree_scaleRoots, Finset.sum_range_succ]
          at hev
        simp only [Polynomial.coeff_scaleRoots, Nat.sub_self, pow_zero, mul_one] at hev
        have hS : h ∣ ∑ i ∈ Finset.range P.natDegree,
            P.coeff i * h ^ (P.natDegree - i) * a ^ i := by
          apply Finset.dvd_sum
          intro i hi
          have hi' := Finset.mem_range.mp hi
          apply Dvd.dvd.mul_right
          apply Dvd.dvd.mul_left
          exact dvd_pow_self h (by omega)
        have hlc : P.leadingCoeff * a ^ P.natDegree = -(∑ i ∈ Finset.range P.natDegree,
            P.coeff i * h ^ (P.natDegree - i) * a ^ i) := by
          rw [Polynomial.leadingCoeff]
          linear_combination hev
        rw [hlc]
        exact dvd_neg.mpr hS
      have s3 : ∀ (m : ℕ) (x : B), a ^ m * x ∈ Ideal.span {h} → x ∈ Ideal.span {h} := by
        intro m
        induction m with
        | zero => intro x hx; simpa using hx
        | succ m ih =>
          intro x hx
          apply ih
          apply hreg
          rw [← mul_assoc, ← pow_succ']
          exact hx
      have s4 : ∀ (P : Polynomial B) (q : B), 1 ≤ P.natDegree → P.leadingCoeff = h * q →
          (P - Polynomial.C q * Polynomial.X ^ (P.natDegree - 1) *
            (Polynomial.C h * Polynomial.X - Polynomial.C a)).natDegree < P.natDegree := by
        intro P q hn hq
        have hXn : (Polynomial.X : Polynomial B) ^ P.natDegree =
            Polynomial.X ^ (P.natDegree - 1) * Polynomial.X := by
          rw [← pow_succ]
          congr 1
          omega
        have hD : Polynomial.C q * Polynomial.X ^ (P.natDegree - 1) *
            (Polynomial.C h * Polynomial.X - Polynomial.C a) =
            Polynomial.C (q * h) * Polynomial.X ^ P.natDegree -
              Polynomial.C (q * a) * Polynomial.X ^ (P.natDegree - 1) := by
          rw [hXn, Polynomial.C_mul, Polynomial.C_mul]
          ring
        have hle : (P - Polynomial.C q * Polynomial.X ^ (P.natDegree - 1) *
            (Polynomial.C h * Polynomial.X - Polynomial.C a)).natDegree ≤ P.natDegree - 1 := by
          rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
          intro N hN
          rw [hD, Polynomial.coeff_sub, Polynomial.coeff_sub, Polynomial.coeff_C_mul_X_pow,
            Polynomial.coeff_C_mul_X_pow]
          have hN1 : N ≠ P.natDegree - 1 := by
            have : P.natDegree - 1 < N := by exact_mod_cast hN
            omega
          rw [if_neg hN1]
          by_cases hNn : N = P.natDegree
          · rw [if_pos hNn, hNn, Polynomial.coeff_natDegree, hq]
            ring
          · have : P.natDegree - 1 < N := by exact_mod_cast hN
            rw [if_neg hNn, Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)]
            ring
        omega
      have s5 : ∀ n : ℕ, ∀ P : Polynomial B, P.natDegree = n →
          Polynomial.aeval (algebraMap B K a / algebraMap B K h) P = 0 →
          P ∈ Ideal.span {Polynomial.C h * Polynomial.X - Polynomial.C a} := by
        intro n
        induction n using Nat.strong_induction_on with
        | _ n ih =>
          intro P hPn hP
          rcases Nat.eq_zero_or_pos n with h0 | hpos
          · have hPC := Polynomial.eq_C_of_natDegree_eq_zero (hPn.trans h0)
            rw [hPC, Polynomial.aeval_C] at hP
            have hc : P.coeff 0 = 0 := hinj (by rw [hP, map_zero])
            rw [hPC, hc, map_zero]
            exact Ideal.zero_mem _
          · subst hPn
            have hd := s2 P hP
            have hmem : a ^ P.natDegree * P.leadingCoeff ∈ Ideal.span {h} := by
              rw [Ideal.mem_span_singleton, mul_comm]
              exact hd
            obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp (s3 _ _ hmem)
            have hDI : Polynomial.C q * Polynomial.X ^ (P.natDegree - 1) *
                (Polynomial.C h * Polynomial.X - Polynomial.C a) ∈
                Ideal.span {Polynomial.C h * Polynomial.X - Polynomial.C a} :=
              Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
            have hDk := RingHom.mem_ker.mp (s1 hDI)
            have hlt := s4 P q hpos hq
            have hP' := ih _ hlt _ rfl (by rw [map_sub, hP, hDk, sub_zero])
            have := Ideal.add_mem _ hP' hDI
            rwa [sub_add_cancel] at this
      exact le_antisymm (fun P hP => s5 _ P rfl (RingHom.mem_ker.mp hP)) s1
    have hres : ∀ a : A, ∃ w : ↥W, a - algebraMap ↥W A w ∈ 𝔭 := by
      have T1 : IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
        apply IsAlgClosed.of_exists_root
        intro p hpmon hpirr
        have hlift : p ∈ Polynomial.lifts (IsLocalRing.residue ↥W) := by
          rw [Polynomial.lifts_iff_coeff_lifts]
          intro n
          exact IsLocalRing.residue_surjective _
        obtain ⟨q, hqmap, hqdeg, hqmon⟩ :=
          Polynomial.lifts_and_natDegree_eq_and_monic hlift hpmon
        have hpdeg : 0 < p.natDegree := hpirr.natDegree_pos
        set j : ↥W →+* Ω := algebraMap ↥W Ω with hj
        have hQmon : (q.map j).Monic := hqmon.map j
        have hQdeg : (q.map j).natDegree = q.natDegree := hqmon.natDegree_map j
        have hQd : (q.map j).degree ≠ 0 := by
          rw [Polynomial.degree_eq_natDegree hQmon.ne_zero, hQdeg, hqdeg]
          exact_mod_cast hpdeg.ne'
        obtain ⟨z, hz⟩ := IsAlgClosed.exists_root (q.map j) hQd
        have hzint : _root_.IsIntegral ↥W z := by
          refine ⟨q, hqmon, ?_⟩
          rw [Polynomial.IsRoot, Polynomial.eval_map] at hz
          exact hz
        obtain ⟨y, hy⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hzint
        have hqy : q.eval y = 0 := by
          apply (IsFractionRing.injective ↥W Ω)
          rw [map_zero, ← Polynomial.eval_map_apply]
          rw [hy]
          exact hz
        refine ⟨IsLocalRing.residue ↥W y, ?_⟩
        rw [← hqmap, Polynomial.eval_map_apply, hqy, map_zero]
      have T2 : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
          [IsAlgClosed (IsLocalRing.ResidueField R)] (k : Type u) [Field k] (ρ : R →+* k),
          IsLocalHom ρ → ρ.FiniteType → Function.Surjective ρ := by
        intro R _ _ _ k _ ρ hloc hρFT
        set ψ := IsLocalRing.ResidueField.lift ρ with hψ
        have hψr : ψ.comp (IsLocalRing.residue R) = ρ :=
          IsLocalRing.ResidueField.lift_comp_residue ρ
        have hψFT : ψ.FiniteType := by
          rw [← hψr] at hρFT
          exact RingHom.FiniteType.of_comp_finiteType hρFT
        have hψfin : ψ.Finite := (RingHom.finite_iff_finiteType_of_isJacobsonRing).mpr hψFT
        have hψsurj : Function.Surjective ψ :=
          (IsAlgClosed.ringHom_bijective_of_isIntegral ψ hψfin.to_isIntegral).2
        rw [← hψr]
        exact hψsurj.comp (IsLocalRing.residue_surjective)
      let ρ0 : ↥W →+* A ⧸ 𝔭 := (Ideal.Quotient.mk 𝔭).comp (algebraMap ↥W A)
      have hloc : IsLocalHom ρ0 := by
        refine ⟨fun x hx => ?_⟩
        by_contra hxu
        have hxm : x ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal x).mpr hxu
        have h1 : algebraMap ↥W A x ∈ 𝔭 := hmA (Ideal.mem_map_of_mem _ hxm)
        have h2 : ρ0 x = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr h1
        rw [h2] at hx
        exact not_isUnit_zero hx
      have hρFT : ρ0.FiniteType :=
        RingHom.FiniteType.comp_surjective (RingHom.finiteType_algebraMap.mpr hFT)
          Ideal.Quotient.mk_surjective
      intro a
      obtain ⟨w, hw⟩ := T2 ↥W (A ⧸ 𝔭) ρ0 hloc hρFT (Ideal.Quotient.mk 𝔭 a)
      refine ⟨w, ?_⟩
      exact Ideal.Quotient.eq.mp hw.symm
    have hF1 : ∀ w : ↥W, algebraMap ↥W A w ∈ 𝔭 → w ∈ IsLocalRing.maximalIdeal ↥W := by
      intro w hw
      by_contra hwm
      have hu : IsUnit w := by
        by_contra hnu
        exact hwm ((IsLocalRing.mem_maximalIdeal w).mpr hnu)
      exact h𝔭max.ne_top (Ideal.eq_top_of_isUnit_mem _ hw (hu.map _))
    have hF2 : ∀ π ∈ IsLocalRing.maximalIdeal ↥W, algebraMap ↥W A π ∈ 𝔭 :=
      fun π hπ => hmA (Ideal.mem_map_of_mem _ hπ)
    have hbA : algebraMap ↥W A b ≠ 0 := by
      intro h0
      have h1 : b • (1 : A) = 0 := by rw [Algebra.smul_def, h0, zero_mul]
      rcases smul_eq_zero.mp h1 with h2 | h2
      · exact hb0 h2
      · exact one_ne_zero h2
    have hb0K : algebraMap A K (algebraMap ↥W A b) ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr hbA
    have hS : algebraMap A K (algebraMap ↥W A b) * wcLlsScS W A K t c b =
        algebraMap A K (t - algebraMap ↥W A c) := by
      unfold wcLlsScS
      exact mul_div_cancel₀ _ hb0K
    have hh0 : h ≠ 0 := fun h0 => hh (h0 ▸ 𝔭.zero_mem)
    haveI : IsDomain (Localization.Away h) :=
      IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
    have hhu : IsUnit (algebraMap A K h) :=
      ((map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr hh0).isUnit
    obtain ⟨ℓ, hℓA⟩ : ∃ ℓ : Localization.Away h →+* K,
        ∀ a, ℓ (algebraMap A (Localization.Away h) a) = algebraMap A K a :=
      ⟨IsLocalization.Away.lift h hhu, IsLocalization.Away.lift_eq h hhu⟩
    have hℓinj : Function.Injective ℓ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨x, hzs⟩ := IsLocalization.surj (Submonoid.powers h) z
      have h1 : algebraMap A K x.1 = 0 := by
        rw [← hℓA, ← hzs, map_mul, hz, zero_mul]
      have ha : x.1 = 0 := (map_eq_zero_iff _ (IsFractionRing.injective A K)).mp h1
      rw [ha, map_zero] at hzs
      exact (mul_eq_zero.mp hzs).resolve_right
        (IsLocalization.map_units (Localization.Away h) x.2).ne_zero
    have hρu : IsUnit (Ideal.Quotient.mk 𝔭 h) :=
      Ne.isUnit (fun h0 => hh (Ideal.Quotient.eq_zero_iff_mem.mp h0))
    obtain ⟨ρ, hρA⟩ : ∃ ρ : Localization.Away h →+* A ⧸ 𝔭,
        ∀ a, ρ (algebraMap A (Localization.Away h) a) = Ideal.Quotient.mk 𝔭 a :=
      ⟨IsLocalization.Away.lift h hρu, IsLocalization.Away.lift_eq h hρu⟩
    have hfc' : ∀ w : ↥W, f (Polynomial.C w) =
        algebraMap A (Localization.Away h) (algebraMap ↥W A w) := fun w => by
      rw [← RingHom.comp_apply, hfC, RingHom.comp_apply]
    have poly : ∀ y : Polynomial ↥W, (Polynomial.X - Polynomial.C c) * y ∈
        Ideal.span {Polynomial.C b} → y ∈ Ideal.span {Polynomial.C b} := by
      intro y hy
      obtain ⟨z, hz⟩ := Ideal.mem_span_singleton'.mp hy
      have hπb : Ideal.Quotient.mk (Ideal.span {b}) b = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self b)
      have h1 := congrArg (Polynomial.map (Ideal.Quotient.mk (Ideal.span {b}))) hz
      rw [Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_C, hπb, map_zero, mul_zero,
        Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C] at h1
      have h2 : Polynomial.map (Ideal.Quotient.mk (Ideal.span {b})) y = 0 :=
        (Polynomial.Monic.mul_right_eq_zero_iff (Polynomial.monic_X_sub_C _)).mp h1.symm
      rw [Ideal.mem_span_singleton, Polynomial.C_dvd_iff_dvd_coeff]
      intro n
      have h3 : Ideal.Quotient.mk (Ideal.span {b}) (y.coeff n) = 0 := by
        rw [← Polynomial.coeff_map, h2, Polynomial.coeff_zero]
      exact Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp h3)
    have hCb : (Polynomial.C b : Polynomial ↥W) ≠ 0 := by
      rw [Ne, Polynomial.C_eq_zero]; exact hb0
    have hsr : IsSMulRegular (Polynomial ↥W) (Polynomial.C b) :=
      IsLeftRegular.isSMulRegular (mul_right_injective₀ hCb)
    have hreg : (∀ x : Localization.Away h, (f Polynomial.X - f (Polynomial.C c)) * x ∈
        Ideal.span {f (Polynomial.C b)} → x ∈ Ideal.span {f (Polynomial.C b)}) ∧
        f (Polynomial.C b) ≠ 0 := by
      letI : Algebra (Polynomial ↥W) (Localization.Away h) := f.toAlgebra
      haveI : Algebra.Etale (Polynomial ↥W) (Localization.Away h) := hfet
      haveI : Module.Flat (Polynomial ↥W) (Localization.Away h) := inferInstance
      have hsrB : IsSMulRegular (Localization.Away h)
          (algebraMap (Polynomial ↥W) (Localization.Away h) (Polynomial.C b)) := hsr.of_flat
      have htr := transfer (Polynomial ↥W) (Localization.Away h) (Polynomial.C b)
        (Polynomial.X - Polynomial.C c) poly
      refine ⟨fun x hx => ?_, ?_⟩
      · apply htr x
        show f (Polynomial.X - Polynomial.C c) * x ∈ Ideal.span {f (Polynomial.C b)}
        rw [map_sub]; exact hx
      · intro h0
        apply one_ne_zero (α := Localization.Away h)
        apply hsrB
        show f (Polynomial.C b) * 1 = f (Polynomial.C b) * 0
        rw [h0, zero_mul, zero_mul]
    have hSB : ℓ (f Polynomial.X - f (Polynomial.C c)) / ℓ (f (Polynomial.C b)) =
        wcLlsScS W A K t c b := by
      rw [hfX, hfc', hfc', ← map_sub, hℓA, hℓA]
      rfl
    have hker : ∀ P : Polynomial (Localization.Away h),
        Polynomial.eval₂ ℓ (wcLlsScS W A K t c b) P = 0 →
        Polynomial.C (f (Polynomial.C b)) * Polynomial.X -
          Polynomial.C (f Polynomial.X - f (Polynomial.C c)) ∣ P := by
      intro P hP
      letI : Algebra (Localization.Away h) K := ℓ.toAlgebra
      have hk := rees (Localization.Away h) K hℓinj (f (Polynomial.C b))
        (f Polynomial.X - f (Polynomial.C c)) hreg.2 hreg.1
      have hmem : P ∈ RingHom.ker (Polynomial.aeval (R := Localization.Away h)
          (algebraMap (Localization.Away h) K (f Polynomial.X - f (Polynomial.C c)) /
            algebraMap (Localization.Away h) K (f (Polynomial.C b)))) := by
        rw [RingHom.mem_ker, Polynomial.aeval_def]
        exact (congrArg (fun s => Polynomial.eval₂ ℓ s P) hSB).trans hP
      rw [hk] at hmem
      exact Ideal.mem_span_singleton.mp hmem
    set R := Algebra.adjoin A {wcLlsScS W A K t c b} with hR
    set Sr : ↥R := ⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ with hSr
    set ι : ↥W →+* ↥R := (algebraMap A ↥R).comp (algebraMap ↥W A) with hι
    have hsurj : Function.Surjective (Polynomial.aeval (R := A) Sr).toRingHom := by
      intro r
      have hr : (r : K) ∈ (Polynomial.aeval (R := A) (wcLlsScS W A K t c b)).range := by
        rw [← Algebra.adjoin_singleton_eq_range_aeval]; exact r.2
      rw [AlgHom.mem_range] at hr
      obtain ⟨p, hp⟩ := hr
      refine ⟨p, Subtype.ext ?_⟩
      show ((Polynomial.aeval Sr p : ↥R) : K) = (r : K)
      rw [← hp]
      exact (Polynomial.aeval_algHom_apply R.val Sr p).symm
    have hkerle : RingHom.ker (Polynomial.aeval (R := A) Sr).toRingHom ≤
        RingHom.ker (Polynomial.mapRingHom (Ideal.Quotient.mk 𝔭)) := by
      intro p hp
      rw [RingHom.mem_ker] at hp ⊢
      have hp' : Polynomial.aeval Sr p = 0 := hp
      have h1 : Polynomial.aeval (wcLlsScS W A K t c b) p = 0 := by
        refine (Polynomial.aeval_algHom_apply R.val Sr p).trans ?_
        rw [hp', map_zero]
      have hℓcomp : ℓ.comp (algebraMap A (Localization.Away h)) = algebraMap A K :=
        RingHom.ext hℓA
      have h2 : Polynomial.eval₂ ℓ (wcLlsScS W A K t c b)
          (p.map (algebraMap A (Localization.Away h))) = 0 := by
        rw [Polynomial.eval₂_map, hℓcomp, ← Polynomial.aeval_def, h1]
      obtain ⟨q, hq⟩ := hker _ h2
      have hρcomp : ρ.comp (algebraMap A (Localization.Away h)) = Ideal.Quotient.mk 𝔭 :=
        RingHom.ext hρA
      have hρb : ρ (f (Polynomial.C b)) = 0 := by
        rw [hfc', hρA, Ideal.Quotient.eq_zero_iff_mem]; exact hF2 b hb
      have hρa : ρ (f Polynomial.X - f (Polynomial.C c)) = 0 := by
        rw [map_sub, hfX, hfc', hρA, hρA, Ideal.Quotient.eq_zero_iff_mem.mpr ht𝔭,
          Ideal.Quotient.eq_zero_iff_mem.mpr (hF2 c hc), sub_zero]
      show Polynomial.map (Ideal.Quotient.mk 𝔭) p = 0
      rw [← hρcomp, ← Polynomial.map_map, hq, Polynomial.map_mul, Polynomial.map_sub,
        Polynomial.map_mul, Polynomial.map_C, Polynomial.map_C, Polynomial.map_X, hρb, hρa,
        map_zero, zero_mul, sub_zero, zero_mul]
    let χ : ↥R →+* Polynomial (A ⧸ 𝔭) :=
      (Polynomial.aeval (R := A) Sr).toRingHom.liftOfSurjective hsurj
        ⟨Polynomial.mapRingHom (Ideal.Quotient.mk 𝔭), hkerle⟩
    have key : ∀ p : Polynomial A, χ (Polynomial.aeval Sr p) =
        Polynomial.map (Ideal.Quotient.mk 𝔭) p :=
      fun p => RingHom.liftOfSurjective_comp_apply _ hsurj _ p
    have hχS : χ Sr = Polynomial.X := by
      have := key Polynomial.X
      rwa [Polynomial.aeval_X, Polynomial.map_X] at this
    have hχA : ∀ a : A, χ (algebraMap A ↥R a) = Polynomial.C (Ideal.Quotient.mk 𝔭 a) := by
      intro a
      have := key (Polynomial.C a)
      rwa [Polynomial.aeval_C, Polynomial.map_C] at this
    set mR := (IsLocalRing.maximalIdeal ↥W).map ι with hmR
    have hmR_mem : ∀ π ∈ IsLocalRing.maximalIdeal ↥W, ι π ∈ mR :=
      fun π hπ => Ideal.mem_map_of_mem _ hπ
    have htR : algebraMap A ↥R t = ι c + ι b * Sr := by
      apply Subtype.ext
      show algebraMap A K t = algebraMap A K (algebraMap ↥W A c) +
        algebraMap A K (algebraMap ↥W A b) * wcLlsScS W A K t c b
      rw [hS, map_sub]; ring
    have htmR : algebraMap A ↥R t ∈ mR := by
      rw [htR]
      exact mR.add_mem (hmR_mem c hc) (mR.mul_mem_right _ (hmR_mem b hb))
    have hmAR : ∀ v ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A),
        algebraMap A ↥R v ∈ mR := by
      intro v hv
      have := Ideal.mem_map_of_mem (algebraMap A ↥R) hv
      rw [Ideal.map_map] at this
      exact this
    have hPA : ∀ a : A, ∃ g : Polynomial ↥W,
        algebraMap A ↥R a - Polynomial.eval₂ ι Sr g ∈ mR := by
      intro a
      obtain ⟨w, hw⟩ := hres a
      rw [h𝔭eq, Submodule.mem_sup] at hw
      obtain ⟨y, hy, v, hv, hyv⟩ := hw
      obtain ⟨x, rfl⟩ := Ideal.mem_span_singleton'.mp hy
      refine ⟨Polynomial.C w, ?_⟩
      rw [Polynomial.eval₂_C]
      have e : algebraMap A ↥R a - ι w = algebraMap A ↥R (x * t + v) := by
        rw [hyv, map_sub]; rfl
      rw [e, map_add, map_mul]
      exact mR.add_mem (mR.mul_mem_left _ htmR) (hmAR v hv)
    have hG1 : ∀ r : ↥R, ∃ g : Polynomial ↥W, r - Polynomial.eval₂ ι Sr g ∈ mR := by
      rintro ⟨x, hx⟩
      induction hx using Algebra.adjoin_induction with
      | mem x hx' =>
        rw [Set.mem_singleton_iff] at hx'
        subst hx'
        refine ⟨Polynomial.X, ?_⟩
        rw [Polynomial.eval₂_X]
        convert mR.zero_mem using 1
        exact sub_self _
      | algebraMap a => exact hPA a
      | add x y hx hy ihx ihy =>
        obtain ⟨g1, hg1⟩ := ihx
        obtain ⟨g2, hg2⟩ := ihy
        refine ⟨g1 + g2, ?_⟩
        have e : (⟨x + y, Subalgebra.add_mem _ hx hy⟩ : ↥R) - Polynomial.eval₂ ι Sr (g1 + g2) =
            ((⟨x, hx⟩ : ↥R) - Polynomial.eval₂ ι Sr g1) +
              ((⟨y, hy⟩ : ↥R) - Polynomial.eval₂ ι Sr g2) := by
          rw [Polynomial.eval₂_add]
          have : (⟨x + y, Subalgebra.add_mem _ hx hy⟩ : ↥R) = ⟨x, hx⟩ + ⟨y, hy⟩ := rfl
          rw [this]; ring
        rw [e]; exact mR.add_mem hg1 hg2
      | mul x y hx hy ihx ihy =>
        obtain ⟨g1, hg1⟩ := ihx
        obtain ⟨g2, hg2⟩ := ihy
        refine ⟨g1 * g2, ?_⟩
        have e : (⟨x * y, Subalgebra.mul_mem _ hx hy⟩ : ↥R) - Polynomial.eval₂ ι Sr (g1 * g2) =
            ((⟨x, hx⟩ : ↥R) - Polynomial.eval₂ ι Sr g1) * ⟨y, hy⟩ +
              Polynomial.eval₂ ι Sr g1 * ((⟨y, hy⟩ : ↥R) - Polynomial.eval₂ ι Sr g2) := by
          rw [Polynomial.eval₂_mul]
          have : (⟨x * y, Subalgebra.mul_mem _ hx hy⟩ : ↥R) = ⟨x, hx⟩ * ⟨y, hy⟩ := rfl
          rw [this]; ring
        rw [e]; exact mR.add_mem (mR.mul_mem_right _ hg1) (mR.mul_mem_left _ hg2)
    have hχι : ∀ w : ↥W, χ (ι w) = Polynomial.C (Ideal.Quotient.mk 𝔭 (algebraMap ↥W A w)) :=
      fun w => hχA _
    have hK0 : mR ≤ RingHom.ker χ := by
      refine Ideal.map_le_of_le_comap ?_
      intro π hπ
      rw [Ideal.mem_comap, RingHom.mem_ker, hχι, Ideal.Quotient.eq_zero_iff_mem.mpr (hF2 π hπ),
        map_zero]
    have hK1 : ∀ g : Polynomial ↥W, χ (Polynomial.eval₂ ι Sr g) =
        Polynomial.map ((Ideal.Quotient.mk 𝔭).comp (algebraMap ↥W A)) g := by
      intro g
      rw [Polynomial.hom_eval₂, hχS]
      have : χ.comp ι = Polynomial.C.comp ((Ideal.Quotient.mk 𝔭).comp (algebraMap ↥W A)) :=
        RingHom.ext hχι
      rw [this]
      rfl
    have hG2 : ∀ (a : A) (n : ℕ) (g : Polynomial ↥W), a ∉ 𝔭 →
        algebraMap A ↥R a ^ n * Polynomial.eval₂ ι Sr g ∈ mR →
        ∀ i, g.coeff i ∈ IsLocalRing.maximalIdeal ↥W := by
      intro a n g ha hmem i
      have h1 := hK0 hmem
      rw [RingHom.mem_ker, map_mul, map_pow, hχA, hK1] at h1
      have hCa : Polynomial.C (Ideal.Quotient.mk 𝔭 a) ^ n ≠ 0 := by
        refine pow_ne_zero _ ?_
        rw [Ne, Polynomial.C_eq_zero, Ideal.Quotient.eq_zero_iff_mem]
        exact ha
      have h2 := (mul_eq_zero.mp h1).resolve_left hCa
      apply hF1
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      have h3 := congrArg (fun p => Polynomial.coeff p i) h2
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero, RingHom.comp_apply] at h3
      exact h3
    exact ⟨hG1, hG2⟩
  obtain ⟨hi, hii⟩ := hcf
  set R := ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) with hR
  set φ : ↥W →+* R := (algebraMap A R).comp (algebraMap ↥W A) with hφ
  set S' : R := ⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ with hS'
  set M := (IsLocalRing.maximalIdeal ↥W).map φ with hM
  have ii0 : ∀ F : Polynomial ↥W, Polynomial.eval₂ φ S' F ∈ M →
      ∀ i, F.coeff i ∈ IsLocalRing.maximalIdeal ↥W := by
    intro F hF
    apply hii 1 0 F h1𝔭
    rw [pow_zero, one_mul]
    exact hF
  have Z : ∀ F : Polynomial ↥W, (∀ i, F.coeff i ∈ IsLocalRing.maximalIdeal ↥W) →
      Polynomial.eval₂ φ S' F ∈ M := by
    intro F hF
    rw [Polynomial.eval₂_eq_sum_range]
    exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem φ (hF i)))
  have hC1 : Polynomial.eval₂ φ S' (Polynomial.C 1) = 1 := by
    rw [Polynomial.eval₂_C, map_one]
  have hMtop : M ≠ ⊤ := by
    intro h
    have h1 : Polynomial.eval₂ φ S' (Polynomial.C 1) ∈ M := by
      rw [hC1, h]
      exact Submodule.mem_top
    have h2 := ii0 _ h1 0
    rw [Polynomial.coeff_C_zero] at h2
    exact hm1 h2
  haveI hmP : (IsLocalRing.maximalIdeal ↥W).IsPrime := (IsLocalRing.maximalIdeal.isMaximal ↥W).isPrime
  have hPC : (Ideal.map (Polynomial.C : ↥W →+* Polynomial ↥W)
      (IsLocalRing.maximalIdeal ↥W)).IsPrime := Ideal.isPrime_map_C_of_isPrime
  refine ⟨?_, ?_, ?_⟩
  · refine Ideal.isPrime_iff.mpr ⟨hMtop, ?_⟩
    intro r₁ r₂ h12
    obtain ⟨F₁, e₁⟩ := hi r₁
    obtain ⟨F₂, e₂⟩ := hi r₂
    have hprod : Polynomial.eval₂ φ S' (F₁ * F₂) ∈ M := by
      rw [Polynomial.eval₂_mul]
      have hring : Polynomial.eval₂ φ S' F₁ * Polynomial.eval₂ φ S' F₂ =
          r₁ * r₂ - (r₁ - Polynomial.eval₂ φ S' F₁) * r₂ -
            Polynomial.eval₂ φ S' F₁ * (r₂ - Polynomial.eval₂ φ S' F₂) := by ring
      rw [hring]
      exact M.sub_mem (M.sub_mem h12 (M.mul_mem_right _ e₁)) (M.mul_mem_left _ e₂)
    have hmem : F₁ * F₂ ∈ Ideal.map (Polynomial.C : ↥W →+* Polynomial ↥W)
        (IsLocalRing.maximalIdeal ↥W) := Ideal.mem_map_C_iff.mpr (ii0 _ hprod)
    rcases hPC.mem_or_mem hmem with h | h
    · left
      have h3 := M.add_mem e₁ (Z F₁ (Ideal.mem_map_C_iff.mp h))
      rwa [sub_add_cancel] at h3
    · right
      have h3 := M.add_mem e₂ (Z F₂ (Ideal.mem_map_C_iff.mp h))
      rwa [sub_add_cancel] at h3
  · have hg : S' - algebraMap A R (algebraMap ↥W A 0) = S' := by simp
    rw [hg]
    refine lt_of_le_of_ne le_sup_right ?_
    intro heq
    have hS : S' ∈ M := by
      rw [heq]
      exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)
    have h2 : Polynomial.eval₂ φ S' Polynomial.X ∈ M := by
      rw [Polynomial.eval₂_X]
      exact hS
    have h3 := ii0 _ h2 1
    rw [Polynomial.coeff_X_one] at h3
    exact hm1 h3
  · intro a d ha hda hd
    have haR : algebraMap A R a ∈ M := by
      have h3 := M.sub_mem hd hda
      rwa [sub_sub_cancel] at h3
    have h4 := hii a 1 (Polynomial.C 1) ha (by rw [pow_one, hC1, mul_one]; exact haR)
    have h0 := h4 0
    rw [Polynomial.coeff_C_zero] at h0
    exact hm1 h0

theorem wcLlsASre_no_inertia : ∀ (R : Type u) [CommRing R] (K : Type u) [Field K] [Algebra R K] (L : Type u) [Field L] [Algebra K L] [Algebra R L] [IsScalarTower R K L] [FiniteDimensional K L] [IsGalois K L] (ℓ : ℕ), ℓ.Prime → ((ℓ : ℕ) : K) = 0 → Module.finrank K L = ℓ → ∀ (α : L) (f : K), α ∉ Set.range (algebraMap K L) → α ^ ℓ - α = algebraMap K L f → ∀ (𝔔 : Ideal ↥(integralClosure R L)), 𝔔.IsPrime → ∀ (d : R) (h : K) (y : ↥(integralClosure R L)), algebraMap R ↥(integralClosure R L) d ∉ 𝔔 → (y : L) = algebraMap K L (algebraMap R K d) * (α - algebraMap K L h) → ¬ wcLlsRam R K L 𝔔 :=
by
  intro R _ K _ _ L _ _ _ _ _ _ ℓ hℓ hK hdeg α f hα hf 𝔔 _ d h y hd hy hRam
  obtain ⟨g, hg1, hg⟩ := hRam
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  have hLℓ : ((ℓ : ℕ) : L) = 0 := by
    rw [← map_natCast (algebraMap K L) ℓ, hK, map_zero]
  haveI : CharP L ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hLℓ

  have hmove : g α ≠ α := by
    intro hgα
    have hcard : Nat.card (L ≃ₐ[K] L) = ℓ := by
      rw [IsGalois.card_aut_eq_finrank, hdeg]
    haveI : Fact (Nat.card (L ≃ₐ[K] L)).Prime := ⟨by rw [hcard]; exact hℓ⟩
    have htop : Subgroup.zpowers g = ⊤ := by
      rcases Subgroup.eq_bot_or_eq_top_of_prime_card (Subgroup.zpowers g) with h1 | h1
      · exact absurd h1 (Subgroup.zpowers_ne_bot.mpr hg1)
      · exact h1
    have hS : Subgroup.zpowers g ≤ MulAction.stabilizer (L ≃ₐ[K] L) α := by
      rw [Subgroup.zpowers_le, MulAction.mem_stabilizer_iff, AlgEquiv.smul_def]
      exact hgα
    apply hα
    have hmem : α ∈ (⊥ : IntermediateField K L) := by
      rw [IsGalois.mem_bot_iff_fixed]
      intro σ
      have hσ : σ ∈ MulAction.stabilizer (L ≃ₐ[K] L) α := hS (htop ▸ Subgroup.mem_top σ)
      rw [MulAction.mem_stabilizer_iff, AlgEquiv.smul_def] at hσ
      exact hσ
    rw [IntermediateField.mem_bot] at hmem
    exact hmem

  have hgf : g α ^ ℓ - g α = algebraMap K L f := by
    have := congrArg g hf
    rwa [map_sub, map_pow, AlgEquiv.commutes] at this
  have hj0 : g α - α ≠ 0 := sub_ne_zero.mpr hmove
  have hjl : (g α - α) ^ ℓ = g α - α := by
    rw [sub_pow_char]
    linear_combination hgf - hf
  obtain ⟨m, rfl⟩ : ∃ m, ℓ = m + 2 := ⟨ℓ - 2, by have := hℓ.two_le; omega⟩
  have hjm : (g α - α) ^ m * (g α - α) = 1 := by
    have h1 : ((g α - α) ^ m * (g α - α) - 1) * (g α - α) = 0 := by
      linear_combination hjl
    exact sub_eq_zero.mp ((mul_eq_zero.mp h1).resolve_right hj0)

  have hjint : IsIntegral R (g α - α) := by
    refine ⟨Polynomial.X ^ (m + 2) - Polynomial.X, ?_, ?_⟩
    · apply Polynomial.monic_X_pow_sub
      exact lt_of_le_of_lt Polynomial.degree_X_le (by exact_mod_cast (by omega : 1 < m + 2))
    · rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_X, hjl, sub_self]
  let jB : ↥(integralClosure R L) := ⟨g α - α, hjint⟩

  have hgy : g (y : L) - (y : L) = algebraMap K L (algebraMap R K d) * (g α - α) := by
    rw [hy, map_mul, map_sub, AlgEquiv.commutes, AlgEquiv.commutes]
    ring

  obtain ⟨q, hq, hqe⟩ := hg y
  apply hd
  have heq : algebraMap R ↥(integralClosure R L) d = q * jB ^ m := by
    apply Subtype.ext
    have e1 : ((algebraMap R ↥(integralClosure R L) d : ↥(integralClosure R L)) : L)
        = algebraMap K L (algebraMap R K d) := by
      rw [← IsScalarTower.algebraMap_apply R K L d]
      rfl
    have e2 : ((q * jB ^ m : ↥(integralClosure R L)) : L) = (q : L) * (g α - α) ^ m := by
      rfl
    rw [e1, e2, hqe, hgy, mul_assoc, mul_comm (g α - α), hjm, mul_one]
  rw [heq]
  exact 𝔔.mul_mem_right _ hq

