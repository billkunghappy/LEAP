                W.valuation (Ψ.eval ((c i₀ : ↥W) : Ω)) := by
            rw [map_mul]; exact mul_comm _ _
          rw [key] at hb'
          exact absurd hinv (not_le.mpr hb')
      rw [hdec]
      refine ⟨?_, fun k hk => ?_⟩
      · rw [Polynomial.coeff_add, add_sub_right_comm]
        exact Valuation.map_add_lt _ hT'1 ((hXk 1).trans_lt hεM)
      · rw [Polynomial.coeff_add]
        exact Valuation.map_add_lt _ (hT'k k hk) ((hXk k).trans_lt hεM)

  intro Q
  obtain ⟨H, β, i₁, -, hH⟩ := hP _ Q rfl
  refine ⟨H, β, i₁, fun i hi => ?_⟩
  obtain ⟨h1, h2⟩ := hH i hi
  obtain ⟨δ, hδ⟩ : ∃ δ : Ω, δ ^ ℓ - δ = ((Q - (H ^ ℓ - H)).comp (φ i)).coeff 0 := by
    have hnd : (Polynomial.X ^ ℓ - Polynomial.X -
        Polynomial.C (((Q - (H ^ ℓ - H)).comp (φ i)).coeff 0)).natDegree = ℓ := by
      rw [Polynomial.natDegree_sub_C, FiniteField.X_pow_card_sub_X_natDegree_eq Ω hℓ.one_lt]
    obtain ⟨δ, hδ⟩ := IsAlgClosed.exists_root (Polynomial.X ^ ℓ - Polynomial.X -
        Polynomial.C (((Q - (H ^ ℓ - H)).comp (φ i)).coeff 0)) (by
      intro h
      have := Polynomial.natDegree_eq_zero_iff_degree_le_zero.mpr h.le
      rw [hnd] at this
      exact hℓ.ne_zero this)
    refine ⟨δ, ?_⟩
    simp only [Polynomial.IsRoot, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_C] at hδ
    linear_combination hδ
  refine ⟨δ, fun k => ?_⟩
  have hpoly : Q - (H + Polynomial.C δ) ^ ℓ + (H + Polynomial.C δ) =
      (Q - (H ^ ℓ - H)) - Polynomial.C (δ ^ ℓ - δ) := by
    rw [add_pow_char, ← Polynomial.C_pow, Polynomial.C_sub]; ring
  rw [← hφ i, hpoly, Polynomial.sub_comp, Polynomial.C_comp]
  have hpos : W.valuation (0 : Ω) < max 1 (W.valuation (β * ((b i : ↥W) : Ω))) := by
    rw [map_zero]; exact lt_of_lt_of_le zero_lt_one (le_max_left _ _)
  rcases k with _ | _ | k
  · convert hpos using 2
    rw [Polynomial.coeff_sub, Polynomial.coeff_sub, Polynomial.coeff_C_zero,
      Polynomial.coeff_C_mul_X, hδ]
    simp
  · convert h1 using 2
    rw [Polynomial.coeff_sub, Polynomial.coeff_sub, Polynomial.coeff_C, Polynomial.coeff_C_mul_X]
    simp
  · convert h2 (k + 2) (by omega) using 2
    rw [Polynomial.coeff_sub, Polynomial.coeff_sub, Polynomial.coeff_C, Polynomial.coeff_C_mul_X]
    simp

theorem wcLlsASvmrs_split_smooth : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] (𝔭 : Ideal A) (t : A) (c b e : ↥W), wcLlsPD W A 𝔭 (.disc t) → c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → ((ℓ : ℕ) : K) = 0 → Module.finrank K L = ℓ → ∀ β : L, β ∉ Set.range (algebraMap K L) → ∀ (μ : ↥W) (x d : ↥(Algebra.adjoin A {wcLlsScS W A K t c b})) (a : A), a ∉ 𝔭 → d - algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) a ∈ (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A)) → (β ^ ℓ - β) * algebraMap K L (d : K) = algebraMap K L (algebraMap A K (algebraMap ↥W A μ) * (x : K)) → wcLlsInnerSmooth W A K L t c b e :=
by
  intro Ω _ _ W hW hWt ℓ hℓ A _ _ _ K _ _ _ L _ _ _ _ _ 𝔭 t c b e hPD hc hb hb0 hK hdeg β hβ
    μ x d a ha hda heq
  classical
  have hnz : NoZeroSMulDivisors ↥W A := hPD.2.1
  have hι : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro x hx
