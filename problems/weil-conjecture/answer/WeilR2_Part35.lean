  obtain ⟨Pm, hPm⟩ : ∃ Pm : ℕ, Pm = (ℓ - 1) * (n + k) := ⟨_, rfl⟩
  obtain ⟨M, hM⟩ : ∃ M : ℕ, M = Pm + n + k + 1 := ⟨_, rfl⟩
  have hroot : ∀ z : ↥W, z ∈ IsLocalRing.maximalIdeal ↥W → ∃ b₀ : ↥W,
      b₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ b₀ ≠ 0 ∧
