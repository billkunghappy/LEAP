          Ideal.Quotient.mk _ (MvPolynomial.rename (Equiv.swap (0 : Fin 2) 1) x) := by
      refine ⟨(Ideal.quotientEquivAlg (R₁ := ↥W) _ _
        (MvPolynomial.renameEquiv ↥W (Equiv.swap (0 : Fin 2) 1)) hIJ).toRingEquiv, ?_⟩
      intro x
      exact Ideal.quotientEquivAlg_mk _ _ hIJ x
    have hτC : τ.toRingHom.comp ((Ideal.Quotient.mk (Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b})).comp MvPolynomial.C) =
        (Ideal.Quotient.mk (Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b})).comp MvPolynomial.C := by
      refine RingHom.ext fun w => ?_
      show τ (Ideal.Quotient.mk _ (MvPolynomial.C w)) = _
      rw [hτ, MvPolynomial.rename_C]
      rfl
    have hFτet := RingHom.Etale.respectsIso.2
      (R := MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b})
      (S := MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b})
      (T := Localization.Away h₀) F0 τ hF0et
    have hPDs : wcLlsPD W A' 𝔭' (.ann v' u' b) :=
      ⟨hFT', hNZ', hIC', hmax', hle', hb𝔪', hb0', by rw [mul_comm]; exact huv',
        by rw [h𝔭eq', Set.pair_comm], h₀, hh₀, F0.comp τ.toRingHom,
        by rw [RingHom.comp_assoc, hτC]; exact hF0C,
        by
          show F0 (τ (Ideal.Quotient.mk _ (MvPolynomial.X 0))) = _
          rw [hτ, MvPolynomial.rename_X, Equiv.swap_apply_left]; exact hF0X1,
        by
          show F0 (τ (Ideal.Quotient.mk _ (MvPolynomial.X 1))) = _
          rw [hτ, MvPolynomial.rename_X, Equiv.swap_apply_right]; exact hF0X0,
        hFτet⟩
    have hAnnv := wcLlsASi_ann_pole_sep Ω W hdim hWtop ℓ hℓ A' K L 𝔭' v' u' b hPDs hK hfin α f hα
      hf h κ₁ n (ιR q) (ιR p) hκ₁0 hn hℓn hq' hp' (by
        rw [hv', hW' κ₁, hιR, hιR]
        apply mul_left_cancel₀ (pow_ne_zero n hu)
        linear_combination hEQ - (f - h ^ ℓ + h) * (q : K) * hM)

    have hAnn := wcLlsASi_annsep_swap W A' K L u' v' b huv' (by rw [hu']; exact hu)
      (by rw [hv']; exact hs0) hAnnv
    exact (hiff b hb hb0 dvd_rfl).mpr hAnn

theorem wcLlsASbf_nf_exists : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → ∀ F : K, F ≠ 0 → ∃ (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ g₀ g₁ : A), lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀ ∉ 𝔭 ∧ ε₁ ∉ 𝔭 ∧ F * algebraMap A K ((t - algebraMap ↥W A c) ^ n * ε₁ + algebraMap ↥W A w * g₁) * algebraMap A K (algebraMap ↥W A lam₂) = algebraMap A K (algebraMap ↥W A lam₁) * algebraMap A K ((t - algebraMap ↥W A c) ^ k * ε₀ + algebraMap ↥W A w * g₀) :=
by
  intro Ω _ _ W hdim hWtop A _ _ _ K _ _ _ 𝔭 t hPD c hc F hF
  classical
  have hmax : 𝔭.IsMaximal := by
    obtain ⟨-, -, -, hm, -⟩ := hPD
    exact hm
  have hprime : 𝔭.IsPrime := hmax.isPrime
  obtain ⟨SF1, SF2, SF3⟩ := wcpa_dj_llsm_kpdf_special_fibre_dvr Ω W hdim hWtop A 𝔭 t hPD
  set mA : Ideal A := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) with hmA
  set U : A := t - algebraMap ↥W A c with hU
  have hcA : algebraMap ↥W A c ∈ mA := Ideal.mem_map_of_mem _ hc
  have hrec : ∀ r : ℕ, t ^ r - U ^ r ∈ mA := by
    intro r
    obtain ⟨q, hq⟩ := sub_dvd_pow_sub_pow t U r
    have htU : t - U = algebraMap ↥W A c := by rw [hU]; ring
    rw [hq, htU]
    exact mA.mul_mem_right _ hcA

  have bracket : ∀ x : A, x ≠ 0 → ∃ (d : ↥W) (i j : ℕ) (ε₀ ε₁ y₀ y₁ : A), d ≠ 0 ∧ ε₀ ∉ 𝔭 ∧
      ε₁ ∉ 𝔭 ∧ y₀ ∈ mA ∧ y₁ ∈ mA ∧
      x * (U ^ i * ε₁ + y₁) = algebraMap ↥W A d * (U ^ j * ε₀ + y₀) := by
    intro x hx
    obtain ⟨d, u, b, hd, hNu, hNb, hGV⟩ :=
      wcpa_dj_llsm_kpdf_generic_valuation Ω W hdim hWtop A 𝔭 t hPD SF1 SF2 x hx
    obtain ⟨j, eu, su, heu, hsu, hmu⟩ := SF3 u hNu
    obtain ⟨i, eb, sb, heb, hsb, hmb⟩ := SF3 b hNb
    have hm1 : su * u - eu * U ^ j ∈ mA := by
      have e1 : su * u - eu * U ^ j = (su * u - eu * t ^ j) + eu * (t ^ j - U ^ j) := by ring
      rw [e1]
      exact mA.add_mem hmu (mA.mul_mem_left _ (hrec j))
    have hm2 : sb * b - eb * U ^ i ∈ mA := by
      have e1 : sb * b - eb * U ^ i = (sb * b - eb * t ^ i) + eb * (t ^ i - U ^ i) := by ring
      rw [e1]
      exact mA.add_mem hmb (mA.mul_mem_left _ (hrec i))
    refine ⟨d, i, j, sb * eu, su * eb, sb * (su * u - eu * U ^ j), su * (sb * b - eb * U ^ i), hd,
      hprime.mul_notMem hsb heu, hprime.mul_notMem hsu heb, mA.mul_mem_left _ hm1,
      mA.mul_mem_left _ hm2, ?_⟩
    linear_combination (su * sb) * hGV

  have collapse1 : ∀ y ∈ mA, ∃ (w : ↥W) (g : A), w ∈ IsLocalRing.maximalIdeal ↥W ∧
      y = algebraMap ↥W A w * g := by
    intro y hy
    have hy' : y ∈ Ideal.span (algebraMap ↥W A '' (IsLocalRing.maximalIdeal ↥W : Set ↥W)) := hy
    clear hy
    induction hy' using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨w, hw, rfl⟩ := hx
      exact ⟨w, 1, hw, (mul_one _).symm⟩
    | zero => exact ⟨0, 0, (IsLocalRing.maximalIdeal ↥W).zero_mem, by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨w, g, hw, rfl⟩ := hx
      obtain ⟨w', g', hw', rfl⟩ := hy
      rcases ValuationRing.dvd_total w w' with ⟨r, hr⟩ | ⟨r, hr⟩
      · exact ⟨w, g + algebraMap ↥W A r * g', hw, by rw [hr, map_mul]; ring⟩
      · exact ⟨w', algebraMap ↥W A r * g + g', hw', by rw [hr, map_mul]; ring⟩
    | smul a x _ hx =>
      obtain ⟨w, g, hw, rfl⟩ := hx
      exact ⟨w, a * g, hw, by rw [smul_eq_mul]; ring⟩

  obtain ⟨a, e, he, hae⟩ := IsFractionRing.div_surjective (A := A) F
  have he0 : e ≠ 0 := nonZeroDivisors.ne_zero he
  have hφe : algebraMap A K e ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors he
  have ha0 : a ≠ 0 := by
    rintro rfl
    apply hF
    rw [← hae, map_zero, zero_div]
  obtain ⟨da, ia, ja, α₀, α₁, p₀, p₁, hda, hα₀, hα₁, hp₀, hp₁, hA⟩ := bracket a ha0
  obtain ⟨de, ie, je, β₀, β₁, q₀, q₁, hde, hβ₀, hβ₁, hq₀, hq₁, hE⟩ := bracket e he0
  have hY₁m : U ^ ia * α₁ * q₀ + p₁ * (U ^ je * β₀) + p₁ * q₀ ∈ mA :=
    mA.add_mem (mA.add_mem (mA.mul_mem_left _ hq₀) (mA.mul_mem_right _ hp₁))
      (mA.mul_mem_right _ hp₁)
  have hY₀m : U ^ ja * α₀ * q₁ + p₀ * (U ^ ie * β₁) + p₀ * q₁ ∈ mA :=
    mA.add_mem (mA.add_mem (mA.mul_mem_left _ hq₁) (mA.mul_mem_right _ hp₀))
      (mA.mul_mem_right _ hp₀)
  obtain ⟨w₀, h₀, hw₀, hY₀eq⟩ := collapse1 _ hY₀m
  obtain ⟨w₁, h₁, hw₁, hY₁eq⟩ := collapse1 _ hY₁m
  obtain ⟨w, g₀, g₁, hw, hg₀, hg₁⟩ : ∃ (w : ↥W) (g₀ g₁ : A), w ∈ IsLocalRing.maximalIdeal ↥W ∧
      U ^ ja * α₀ * q₁ + p₀ * (U ^ ie * β₁) + p₀ * q₁ = algebraMap ↥W A w * g₀ ∧
      U ^ ia * α₁ * q₀ + p₁ * (U ^ je * β₀) + p₁ * q₀ = algebraMap ↥W A w * g₁ := by
    rcases ValuationRing.dvd_total w₀ w₁ with ⟨r, hr⟩ | ⟨r, hr⟩
    · exact ⟨w₀, h₀, algebraMap ↥W A r * h₁, hw₀, hY₀eq, by rw [hY₁eq, hr, map_mul]; ring⟩
    · exact ⟨w₁, algebraMap ↥W A r * h₀, h₁, hw₁, by rw [hY₀eq, hr, map_mul]; ring, hY₁eq⟩
  refine ⟨da, de, w, ia + je, ja + ie, α₀ * β₁, α₁ * β₀, g₀, g₁, hda, hde, hw,
    hprime.mul_notMem hα₀ hβ₁, hprime.mul_notMem hα₁ hβ₀, ?_⟩
  have hB₁ : U ^ (ia + je) * (α₁ * β₀) + algebraMap ↥W A w * g₁ =
      (U ^ ia * α₁ + p₁) * (U ^ je * β₀ + q₀) := by
    rw [← hg₁, pow_add]; ring
  have hB₀ : U ^ (ja + ie) * (α₀ * β₁) + algebraMap ↥W A w * g₀ =
      (U ^ ja * α₀ + p₀) * (U ^ ie * β₁ + q₁) := by
    rw [← hg₀, pow_add]; ring
  rw [hB₁, hB₀]
  have key : a * ((U ^ ia * α₁ + p₁) * (U ^ je * β₀ + q₀)) * algebraMap ↥W A de =
      algebraMap ↥W A da * ((U ^ ja * α₀ + p₀) * (U ^ ie * β₁ + q₁)) * e := by
    linear_combination (algebraMap ↥W A de * (U ^ je * β₀ + q₀)) * hA -
      (algebraMap ↥W A da * (U ^ ja * α₀ + p₀)) * hE
  have key' := congrArg (algebraMap A K) key
  rw [← hae, div_mul_eq_mul_div, div_mul_eq_mul_div, div_eq_iff hφe]
  simp only [map_mul] at key' ⊢
  linear_combination key'

theorem wcLlsASbf_nf_compare : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → ∀ (F G : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ g₀ g₁ : A) (lam₁' lam₂' w' : ↥W) (n' k' : ℕ) (ε₀' ε₁' g₀' g₁' : A) (a b : A), lam₁ ≠ 0 → lam₂ ≠ 0 → w ∈ IsLocalRing.maximalIdeal ↥W → ε₀ ∉ 𝔭 → ε₁ ∉ 𝔭 → F * algebraMap A K ((t - algebraMap ↥W A c) ^ n * ε₁ + algebraMap ↥W A w * g₁) * algebraMap A K (algebraMap ↥W A lam₂) = algebraMap A K (algebraMap ↥W A lam₁) * algebraMap A K ((t - algebraMap ↥W A c) ^ k * ε₀ + algebraMap ↥W A w * g₀) → lam₁' ≠ 0 → lam₂' ≠ 0 → w' ∈ IsLocalRing.maximalIdeal ↥W → ε₀' ∉ 𝔭 → ε₁' ∉ 𝔭 → G * algebraMap A K ((t - algebraMap ↥W A c) ^ n' * ε₁' + algebraMap ↥W A w' * g₁') * algebraMap A K (algebraMap ↥W A lam₂') = algebraMap A K (algebraMap ↥W A lam₁') * algebraMap A K ((t - algebraMap ↥W A c) ^ k' * ε₀' + algebraMap ↥W A w' * g₀') → (∀ s : A, s ∉ 𝔭 → s * b ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) → F * algebraMap A K b = G * algebraMap A K a → lam₁' * lam₂ ∣ lam₁ * lam₂' :=
by
  intro Ω _ _ W hdim hWtop A _ _ _ K _ _ _ 𝔭 t hPD c hc F G lam₁ lam₂ w n k ε₀ ε₁ g₀ g₁
    lam₁' lam₂' w' n' k' ε₀' ε₁' g₀' g₁' a b h1 h2 h3 h4 h5 hEQ h1' h2' h3' h4' h5' hEQ' hb hab
  classical
  obtain ⟨hSF1, hSF2, -⟩ := wcpa_dj_llsm_kpdf_special_fibre_dvr Ω W hdim hWtop A 𝔭 t hPD
  obtain ⟨-, hnzd, -, hmax, hmA𝔭, -⟩ := hPD
  set mA := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) with hmA
  have h𝔭 : 𝔭.IsPrime := hmax.isPrime

  have hmul : ∀ x y : A, (∀ s : A, s ∉ 𝔭 → s * x ∉ mA) → (∀ s : A, s ∉ 𝔭 → s * y ∉ mA) →
      ∀ s : A, s ∉ 𝔭 → s * (x * y) ∉ mA := by
    intro x y hx hy s hs h
    rw [← mul_assoc] at h
    obtain ⟨s', hs', h'⟩ := hSF1 (s * x) y h
    rcases h' with h' | h'
    · apply hx (s' * s) (fun hm => (h𝔭.mem_or_mem hm).elim hs' hs)
      rwa [mul_assoc]
    · exact hy s' hs' h'
  have hunit : ∀ ε : A, ε ∉ 𝔭 → ∀ s : A, s ∉ 𝔭 → s * ε ∉ mA := by
    intro ε hε s hs h
    exact (h𝔭.mem_or_mem (hmA𝔭 h)).elim hs hε
  have hU : ∀ s : A, s ∉ 𝔭 → s * (t - algebraMap ↥W A c) ∉ mA := by
    intro s hs h
    apply hSF2 s hs
    have hc' : algebraMap ↥W A c ∈ mA := Ideal.mem_map_of_mem _ hc
    have e : s * t = s * (t - algebraMap ↥W A c) + s * algebraMap ↥W A c := by ring
    rw [e]
    exact mA.add_mem h (mA.mul_mem_left s hc')
  have hpow : ∀ (k : ℕ) (ε : A), ε ∉ 𝔭 → ∀ s : A, s ∉ 𝔭 →
      s * ((t - algebraMap ↥W A c) ^ k * ε) ∉ mA := by
    intro k ε hε
    induction k with
    | zero => simpa using hunit ε hε
    | succ k ih =>
      have e : (t - algebraMap ↥W A c) ^ (k + 1) * ε =
          (t - algebraMap ↥W A c) * ((t - algebraMap ↥W A c) ^ k * ε) := by ring
      rw [e]
      exact hmul _ _ hU ih
  have hbr : ∀ (k : ℕ) (ε : A) (w : ↥W) (g : A), ε ∉ 𝔭 → w ∈ IsLocalRing.maximalIdeal ↥W →
      ∀ s : A, s ∉ 𝔭 → s * ((t - algebraMap ↥W A c) ^ k * ε + algebraMap ↥W A w * g) ∉ mA := by
    intro k ε w g hε hw s hs h
    apply hpow k ε hε s hs
    have hm : s * (algebraMap ↥W A w * g) ∈ mA :=
      mA.mul_mem_left s (mA.mul_mem_right g (Ideal.mem_map_of_mem _ hw))
    have e : s * ((t - algebraMap ↥W A c) ^ k * ε) =
        s * ((t - algebraMap ↥W A c) ^ k * ε + algebraMap ↥W A w * g) -
          s * (algebraMap ↥W A w * g) := by ring
    rw [e]
    exact mA.sub_mem h hm
  have hX := hmul _ b (hmul _ _ (hbr k ε₀ w g₀ h4 h3) (hbr n' ε₁' w' g₁' h5' h3')) hb
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h => hmax.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have hX1 := hX 1 h1𝔭
  rw [one_mul] at hX1
  set B₀ := (t - algebraMap ↥W A c) ^ k * ε₀ + algebraMap ↥W A w * g₀ with hB₀
  set B₁ := (t - algebraMap ↥W A c) ^ n * ε₁ + algebraMap ↥W A w * g₁ with hB₁
  set B₀' := (t - algebraMap ↥W A c) ^ k' * ε₀' + algebraMap ↥W A w' * g₀' with hB₀'
  set B₁' := (t - algebraMap ↥W A c) ^ n' * ε₁' + algebraMap ↥W A w' * g₁' with hB₁'
  have hstar : algebraMap ↥W A (lam₁ * lam₂') * (B₀ * B₁' * b) =
      algebraMap ↥W A (lam₁' * lam₂) * (B₀' * a * B₁) := by
    apply IsFractionRing.injective A K
    simp only [map_mul]
    linear_combination (-(algebraMap A K (algebraMap ↥W A lam₂') * algebraMap A K B₁' *
        algebraMap A K b)) * hEQ +
      (algebraMap A K (algebraMap ↥W A lam₂) * algebraMap A K a * algebraMap A K B₁) * hEQ' +
      (algebraMap A K B₁ * algebraMap A K (algebraMap ↥W A lam₂) *
        algebraMap A K (algebraMap ↥W A lam₂') * algebraMap A K B₁') * hab
  rcases ValuationRing.dvd_total (lam₁' * lam₂) (lam₁ * lam₂') with h | ⟨ρ, hρ⟩
  · exact h
  by_cases hu : IsUnit ρ
  · obtain ⟨v, rfl⟩ := hu
    refine ⟨↑v⁻¹, ?_⟩
    rw [hρ, mul_assoc, Units.mul_inv, mul_one]
  · exfalso
    have hρm : ρ ∈ IsLocalRing.maximalIdeal ↥W :=
      (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hu)
    have hne : algebraMap ↥W A (lam₁ * lam₂') ≠ 0 := by
      intro h0
      have hl : lam₁ * lam₂' ≠ 0 := mul_ne_zero h1 h2'
      haveI := hnzd
      have e : (lam₁ * lam₂') • (1 : A) = 0 := by rw [Algebra.smul_def, mul_one, h0]
      rcases smul_eq_zero.mp e with h | h
      · exact hl h
      · exact one_ne_zero h
    have e2 : algebraMap ↥W A (lam₁ * lam₂') * (B₀ * B₁' * b) =
        algebraMap ↥W A (lam₁ * lam₂') * (algebraMap ↥W A ρ * (B₀' * a * B₁)) := by
      rw [hstar, hρ, map_mul]; ring
    have e3 := mul_left_cancel₀ hne e2
    apply hX1
    rw [e3]
    exact mA.mul_mem_right _ (Ideal.mem_map_of_mem _ hρm)

theorem wcLlsASbf_fibre_valring : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∃ O : ValuationSubring K, (∀ x : K, x ∈ O ↔ ∃ a b : A, (∀ s : A, s ∉ 𝔭 → s * b ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧ x * algebraMap A K b = algebraMap A K a) ∧ ∀ N : ℕ, 0 < N → ∀ x : K, x ≠ 0 → ∃ y : K, y ≠ 0 ∧ x / y ^ N ∈ O ∧ y ^ N / x ∈ O :=
by
  intro Ω _ _ W hdim hWtop A _ _ _ K _ _ _ 𝔭 t hPD
  classical
  have hmax : 𝔭.IsMaximal := by
    obtain ⟨-, -, -, hm, -⟩ := hPD
    exact hm
  have hle : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 := by
    obtain ⟨-, -, -, -, hl, -⟩ := hPD
    exact hl
  haveI := hPD.2.1

  obtain ⟨Nu, hNu⟩ : ∃ Nu : A → Prop, ∀ b : A, Nu b ↔
      ∀ s : A, s ∉ 𝔭 → s * b ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) :=
    ⟨_, fun _ => Iff.rfl⟩
  have Nu1 : Nu 1 := by
    rw [hNu]
    intro s hs hm
    rw [mul_one] at hm
    exact hs (hle hm)
  have hinj : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
    intro x hx h0
    have h1 : algebraMap ↥W A x = 0 :=
      (IsFractionRing.injective A K) (h0.trans (map_zero _).symm)
    have h2 : x • (1 : A) = 0 := by rw [Algebra.smul_def, mul_one]; exact h1
    exact hx ((smul_eq_zero.mp h2).resolve_right one_ne_zero)

  obtain ⟨hSF1, hSF2, -⟩ := wcpa_dj_llsm_kpdf_special_fibre_dvr Ω W hdim hWtop A 𝔭 t hPD
  have hGV := wcpa_dj_llsm_kpdf_generic_valuation Ω W hdim hWtop A 𝔭 t hPD hSF1 hSF2

  have Nmul : ∀ x y : A, Nu x → Nu y → Nu (x * y) := by
    intro x y hx hy
    rw [hNu] at hx hy ⊢
    intro s hs hm
    rw [← mul_assoc] at hm
    obtain ⟨s', hs', h | h⟩ := hSF1 (s * x) y hm
    · rw [← mul_assoc] at h
      exact hx (s' * s) (fun hm' => (hmax.isPrime.mem_or_mem hm').elim hs' hs) h
    · exact hy s' hs' h

  have hfac : ∀ x : K, x ≠ 0 → ∃ (d₁ d₂ : ↥W) (p q : A), d₁ ≠ 0 ∧ d₂ ≠ 0 ∧ Nu p ∧ Nu q ∧
      x * algebraMap A K (algebraMap ↥W A d₂) * algebraMap A K q =
        algebraMap A K (algebraMap ↥W A d₁) * algebraMap A K p := by
    intro x hx
    obtain ⟨a, e, he, rfl⟩ := IsFractionRing.div_surjective (A := A) x
    have hφe : algebraMap A K e ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors he
    have he0 : e ≠ 0 := nonZeroDivisors.ne_zero he
    have ha0 : a ≠ 0 := by
      rintro rfl
      apply hx
      rw [map_zero, zero_div]
    obtain ⟨da, ua, ba, hda, hua, hba, hEa⟩ := hGV a ha0
    obtain ⟨de, ue, be, hde, hue, hbe, hEe⟩ := hGV e he0
    refine ⟨da, de, ua * be, ba * ue, hda, hde,
      Nmul _ _ ((hNu _).mpr hua) ((hNu _).mpr hbe),
      Nmul _ _ ((hNu _).mpr hba) ((hNu _).mpr hue), ?_⟩
    have h1 := congrArg (algebraMap A K) hEa
    have h2 := congrArg (algebraMap A K) hEe
    simp only [map_mul] at h1 h2 ⊢
    rw [div_mul_eq_mul_div, div_mul_eq_mul_div, div_eq_iff hφe]
    linear_combination
      (algebraMap A K (algebraMap ↥W A de) * algebraMap A K ue) * h1 -
      (algebraMap A K (algebraMap ↥W A da) * algebraMap A K ua) * h2

  have rootW : ∀ N : ℕ, 0 < N → ∀ z : ↥W, ∃ r : ↥W, r ^ N = z := by
    intro N hN z
    obtain ⟨r, hr⟩ := IsAlgClosed.exists_pow_nat_eq (z : Ω) hN
    by_cases hrW : r ∈ W
    · refine ⟨⟨r, hrW⟩, Subtype.ext ?_⟩
      first
        | simpa using hr
        | exact hr
    · exfalso
      have hr0 : r ≠ 0 := fun h0 => hrW (h0 ▸ W.zero_mem)
      have hrinv : r⁻¹ ∈ W := (W.mem_or_inv_mem r).resolve_left hrW
      obtain ⟨N', rfl⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by omega⟩
      have h1 : r = (z : Ω) * r⁻¹ ^ N' := by
        rw [← hr, inv_pow, pow_succ, mul_assoc, mul_comm r, ← mul_assoc,
          mul_inv_cancel₀ (pow_ne_zero _ hr0), one_mul]
      apply hrW
      rw [h1]
      exact mul_mem z.2 (pow_mem hrinv N')

  obtain ⟨C, hC⟩ : ∃ C : K → Prop, ∀ x : K, C x ↔
      ∃ a b : A, Nu b ∧ x * algebraMap A K b = algebraMap A K a :=
    ⟨_, fun _ => Iff.rfl⟩
  have hCzero : C 0 := (hC 0).mpr ⟨0, 1, Nu1, by rw [zero_mul, map_zero]⟩
  have hCone : C 1 := (hC 1).mpr ⟨1, 1, Nu1, by rw [one_mul]⟩
  have hCmul : ∀ x x' : K, C x → C x' → C (x * x') := by
    intro x x' hx hx'
    obtain ⟨a, b, hb, h⟩ := (hC x).mp hx
    obtain ⟨a', b', hb', h'⟩ := (hC x').mp hx'
    refine (hC _).mpr ⟨a * a', b * b', Nmul _ _ hb hb', ?_⟩
    simp only [map_mul]
    linear_combination (x' * algebraMap A K b') * h + algebraMap A K a * h'
  have hCadd : ∀ x x' : K, C x → C x' → C (x + x') := by
    intro x x' hx hx'
    obtain ⟨a, b, hb, h⟩ := (hC x).mp hx
    obtain ⟨a', b', hb', h'⟩ := (hC x').mp hx'
    refine (hC _).mpr ⟨a * b' + a' * b, b * b', Nmul _ _ hb hb', ?_⟩
    simp only [map_mul, map_add]
    linear_combination algebraMap A K b' * h + algebraMap A K b * h'
  have hCneg : ∀ x : K, C x → C (-x) := by
    intro x hx
    obtain ⟨a, b, hb, h⟩ := (hC x).mp hx
    exact (hC _).mpr ⟨-a, b, hb, by rw [map_neg, neg_mul, h]⟩
  have hCinv : ∀ x : K, C x ∨ C x⁻¹ := by
    intro x
    by_cases hx : x = 0
    · left; rw [hx]; exact hCzero
    obtain ⟨d₁, d₂, p, q, hd₁, hd₂, hp, hq, hE⟩ := hfac x hx
    rcases ValuationRing.dvd_total d₁ d₂ with ⟨ρ, hρ⟩ | ⟨ρ, hρ⟩
    · right
      subst hρ
      simp only [map_mul] at hE
      have h' : x * (algebraMap A K (algebraMap ↥W A ρ) * algebraMap A K q) =
          algebraMap A K p :=
        mul_left_cancel₀ (hinj d₁ hd₁) (by linear_combination hE)
      refine (hC _).mpr ⟨algebraMap ↥W A ρ * q, p, hp, ?_⟩
      rw [map_mul, ← h', ← mul_assoc, inv_mul_cancel₀ hx, one_mul]
    · left
      subst hρ
      simp only [map_mul] at hE
      have h' : x * algebraMap A K q =
          algebraMap A K (algebraMap ↥W A ρ) * algebraMap A K p :=
        mul_left_cancel₀ (hinj d₂ hd₂) (by linear_combination hE)
      refine (hC _).mpr ⟨algebraMap ↥W A ρ * p, q, hq, ?_⟩
      rw [map_mul, h']
  obtain ⟨O, hO⟩ : ∃ O : ValuationSubring K, ∀ x : K, x ∈ O ↔ C x :=
    ⟨{ toSubring :=
        { carrier := setOf C
          mul_mem' := fun {x x'} hx hx' => hCmul x x' hx hx'
          one_mem' := hCone
          add_mem' := fun {x x'} hx hx' => hCadd x x' hx hx'
          zero_mem' := hCzero
          neg_mem' := fun {x} hx => hCneg x hx }
       mem_or_inv_mem' := hCinv }, fun x => Iff.rfl⟩
  refine ⟨O, ?_, ?_⟩
  · intro x
    rw [hO, hC]
    exact exists_congr fun a => exists_congr fun b => and_congr (hNu b) Iff.rfl
  · intro N hN x hx
    obtain ⟨d₁, d₂, p, q, hd₁, hd₂, hp, hq, hE⟩ := hfac x hx
    rcases ValuationRing.dvd_total d₁ d₂ with ⟨ρ, hρ⟩ | ⟨ρ, hρ⟩
    · subst hρ
      have hρ0 : ρ ≠ 0 := by
        rintro rfl
        exact hd₂ (mul_zero d₁)
      simp only [map_mul] at hE
      have h' : x * (algebraMap A K (algebraMap ↥W A ρ) * algebraMap A K q) =
          algebraMap A K p :=
        mul_left_cancel₀ (hinj d₁ hd₁) (by linear_combination hE)
      obtain ⟨r, hr⟩ := rootW N hN ρ
      have hr0 : r ≠ 0 := by
        rintro rfl
        exact hρ0 (by rw [← hr, zero_pow hN.ne'])
      have hrN : algebraMap A K (algebraMap ↥W A r) ^ N =
          algebraMap A K (algebraMap ↥W A ρ) := by
        rw [← map_pow, ← map_pow, hr]
      have hDρ := hinj ρ hρ0
      refine ⟨(algebraMap A K (algebraMap ↥W A r))⁻¹, inv_ne_zero (hinj r hr0), ?_, ?_⟩
      · rw [hO, hC]
        refine ⟨p, q, hq, ?_⟩
        rw [inv_pow, hrN, div_inv_eq_mul]
        linear_combination h'
      · rw [hO, hC]
        refine ⟨q, p, hp, ?_⟩
        rw [inv_pow, hrN, ← h']
        field_simp
    · subst hρ
      have hρ0 : ρ ≠ 0 := by
        rintro rfl
        exact hd₁ (mul_zero d₂)
      simp only [map_mul] at hE
      have h' : x * algebraMap A K q =
          algebraMap A K (algebraMap ↥W A ρ) * algebraMap A K p :=
        mul_left_cancel₀ (hinj d₂ hd₂) (by linear_combination hE)
      obtain ⟨r, hr⟩ := rootW N hN ρ
      have hr0 : r ≠ 0 := by
        rintro rfl
        exact hρ0 (by rw [← hr, zero_pow hN.ne'])
      have hrN : algebraMap A K (algebraMap ↥W A r) ^ N =
          algebraMap A K (algebraMap ↥W A ρ) := by
        rw [← map_pow, ← map_pow, hr]
      have hDρ := hinj ρ hρ0
      refine ⟨algebraMap A K (algebraMap ↥W A r), hinj r hr0, ?_, ?_⟩
      · rw [hO, hC]
        refine ⟨p, q, hq, ?_⟩
        rw [hrN, div_mul_eq_mul_div, div_eq_iff hDρ]
        linear_combination h'
      · rw [hO, hC]
        refine ⟨q, p, hp, ?_⟩
        rw [hrN, div_mul_eq_mul_div, div_eq_iff hx]
        linear_combination -h'

theorem wcLlsASbf_lattice_max : ∀ (K : Type u) [Field K] (O : ValuationSubring K) (ℓ : ℕ), ℓ.Prime → ((ℓ : ℕ) : K) = 0 → (∀ x : K, x ≠ 0 → ∃ y : K, y ≠ 0 ∧ x / y ^ ℓ ∈ O ∧ y ^ ℓ / x ∈ O) → (∀ (L' : Type u) [Field L'] [Algebra K L'] [FiniteDimensional K L'] [Algebra.IsSeparable K L'], letI : Algebra ↥O L' := ((algebraMap K L').comp O.subtype).toAlgebra; Module.Finite ↥O ↥(integralClosure ↥O L')) → ∀ (L : Type u) [Field L] [Algebra K L] (α : L) (f : K), α ∉ Set.range (algebraMap K L) → α ^ ℓ - α = algebraMap K L f → ∃ h₀ : K, f - h₀ ^ ℓ + h₀ ∈ O ∨ ∀ h' : K, f - h₀ ^ ℓ + h₀ - h' ^ ℓ + h' ≠ 0 → (f - h₀ ^ ℓ + h₀) / (f - h₀ ^ ℓ + h₀ - h' ^ ℓ + h') ∈ O :=
by
  have s1 : ∀ (K : Type u) [Field K] (ℓ : ℕ), ℓ.Prime → ((ℓ : ℕ) : K) = 0 → ∀ (L : Type u) [Field L] [Algebra K L] (α : L) (f : K), α ∉ Set.range (algebraMap K L) → α ^ ℓ - α = algebraMap K L f → ∃ (L' : Type u) (_ : Field L') (_ : Algebra K L') (_ : FiniteDimensional K L') (_ : Algebra.IsSeparable K L') (α' : L'), α' ∉ Set.range (algebraMap K L') ∧ α' ^ ℓ - α' = algebraMap K L' f := by
    intro K _ ℓ hℓ hK L _ _ α f hα hf
    set P : Polynomial K := Polynomial.X ^ ℓ - (Polynomial.X + Polynomial.C f) with hP
    have hPm : P.Monic := by
      apply Polynomial.monic_X_pow_sub
      rw [Polynomial.degree_X_add_C]
      exact_mod_cast hℓ.one_lt
    have hPα : Polynomial.aeval α P = 0 := by
      simp only [hP, map_sub, map_add, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
      rw [← hf]; ring
    have hint : IsIntegral K α := ⟨P, hPm, hPα⟩
    have hsepP : P.Separable := by
      rw [Polynomial.separable_def]
      have hd : Polynomial.derivative P = -1 := by
        simp only [hP, Polynomial.derivative_sub, Polynomial.derivative_X_pow,
          Polynomial.derivative_add, Polynomial.derivative_X, Polynomial.derivative_C, hK]
        simp
      rw [hd]
      exact ⟨0, -1, by ring⟩
    have hsep : IsSeparable K α := hsepP.of_dvd (minpoly.dvd K α hPα)
    haveI : FiniteDimensional K (IntermediateField.adjoin K {α}) :=
      IntermediateField.adjoin.finiteDimensional hint
    haveI : Algebra.IsSeparable K (IntermediateField.adjoin K {α}) :=
      (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable K L).mpr hsep
    refine ⟨IntermediateField.adjoin K {α}, inferInstance, inferInstance, inferInstance,
      inferInstance, IntermediateField.AdjoinSimple.gen K α, ?_, ?_⟩
    · rintro ⟨x, hx⟩
      apply hα
      refine ⟨x, ?_⟩
      have := congrArg Subtype.val hx
      simpa using this
    · apply Subtype.val_injective
      simp [hf]
  have s2 : ∀ (K : Type u) [Field K] (O : ValuationSubring K) (L' : Type u) [Field L'] [Algebra K L'], letI : Algebra ↥O L' := ((algebraMap K L').comp O.subtype).toAlgebra; ∀ (ℓ : ℕ), ℓ.Prime → ∀ (β : L') (F z : K), β ^ ℓ - β = algebraMap K L' F → z ≠ 0 → z⁻¹ ∈ O → (IsIntegral ↥O (algebraMap K L' z⁻¹ * β) ↔ F / z ^ ℓ ∈ O) := by
    intro K _ O L' _ _
    letI : Algebra ↥O L' := ((algebraMap K L').comp O.subtype).toAlgebra
    intro ℓ hℓ β F z hβ hz hzO
    haveI : IsScalarTower O K L' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    obtain ⟨m, rfl⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, (Nat.succ_pred_eq_of_pos hℓ.pos).symm⟩
    have hid : (algebraMap K L' z⁻¹ * β) ^ (m + 1) - algebraMap K L' (z⁻¹ ^ m) * (algebraMap K L' z⁻¹ * β)
        = algebraMap K L' (F / z ^ (m + 1)) := by
      have : algebraMap K L' (F / z ^ (m + 1)) = algebraMap K L' z⁻¹ ^ (m + 1) * (β ^ (m + 1) - β) := by
        rw [hβ, ← map_pow, ← map_mul, div_eq_mul_inv, inv_pow, mul_comm]
      rw [this, map_pow]
      ring
    have haO : z⁻¹ ^ m ∈ O := O.pow_mem hzO m
    constructor
    · intro hy
      have h1 : IsIntegral O (algebraMap K L' (F / z ^ (m + 1))) := by
        rw [← hid]
        refine (hy.pow _).sub ?_
        have : algebraMap K L' (z⁻¹ ^ m) = algebraMap O L' ⟨z⁻¹ ^ m, haO⟩ := rfl
        rw [this]
        exact isIntegral_algebraMap.mul hy
      have h2 : IsIntegral O (F / z ^ (m + 1)) := isIntegral_algebraMap_iff.mp h1
      obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp h2
      rw [← hy]
      exact y.2
    · intro hb
      refine ⟨Polynomial.X ^ (m + 1) - (Polynomial.C (⟨z⁻¹ ^ m, haO⟩ : O) * Polynomial.X
        + Polynomial.C (⟨F / z ^ (m + 1), hb⟩ : O)), ?_, ?_⟩
      · apply Polynomial.monic_X_pow_sub
        calc _ ≤ 1 := Polynomial.degree_linear_le
          _ < ((m + 1 : ℕ) : WithBot ℕ) := by exact_mod_cast hℓ.one_lt
      · rw [← Polynomial.aeval_def]
        simp only [map_sub, map_add, map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
        have e1 : algebraMap O L' ⟨z⁻¹ ^ m, haO⟩ = algebraMap K L' (z⁻¹ ^ m) := rfl
        have e2 : algebraMap O L' ⟨F / z ^ (m + 1), hb⟩ = algebraMap K L' (F / z ^ (m + 1)) := rfl
        rw [e1, e2, ← hid]
        ring
  have s3 : ∀ (K : Type u) [Field K] (O : ValuationSubring K) (V : Type u) [AddCommGroup V] [Module K V] (r : ℕ) (g : Fin r → V) (v : V), v ≠ 0 → (∃ c : Fin r → K, v = ∑ i, c i • g i) → ∃ z : K, z ≠ 0 ∧ (∃ c : Fin r → K, (∀ i, c i ∈ O) ∧ z⁻¹ • v = ∑ i, c i • g i) ∧ ∀ z' : K, z' ≠ 0 → (∃ c : Fin r → K, (∀ i, c i ∈ O) ∧ z'⁻¹ • v = ∑ i, c i • g i) → z / z' ∈ O := by
    intro K _ O V _ _ r
    have hdiv : ∀ a b : K, b ≠ 0 → O.valuation a ≤ O.valuation b → a / b ∈ O := by
      intro a b hb hab
      rw [← O.valuation_le_one_iff, map_div₀]
      exact div_le_one_of_le₀ hab zero_le'
    have hmax : ∀ {n : ℕ} (c : Fin n → K), (∃ i, c i ≠ 0) → ∃ i₀, c i₀ ≠ 0 ∧ ∀ i, c i / c i₀ ∈ O := by
      intro n c ⟨i₁, hi₁⟩
      obtain ⟨i₀, -, hi₀⟩ := Finset.exists_max_image Finset.univ (fun i => O.valuation (c i))
        ⟨i₁, Finset.mem_univ _⟩
      have h0 : c i₀ ≠ 0 := by
        intro h
        apply hi₁
        have := hi₀ i₁ (Finset.mem_univ _)
        rw [h, map_zero, le_zero_iff, Valuation.zero_iff] at this
        exact this
      exact ⟨i₀, h0, fun i => hdiv _ _ h0 (hi₀ i (Finset.mem_univ _))⟩
    induction r with
    | zero =>
      intro g v hv ⟨c, hc⟩
      exact absurd (by simpa using hc) hv
    | succ r ih =>
      intro g v hv hspan
      by_cases hli : LinearIndependent K g
      · obtain ⟨c, hc⟩ := hspan
        have hne : ∃ i, c i ≠ 0 := by
          by_contra h
          push_neg at h
          apply hv
          rw [hc]
          simp [h]
        obtain ⟨i₀, h0, hci⟩ := hmax c hne
        refine ⟨c i₀, h0, ⟨fun i => c i / c i₀, hci, ?_⟩, ?_⟩
        · rw [hc, Finset.smul_sum]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [smul_smul]
          simp only [div_eq_inv_mul]
        · rintro z' hz' ⟨d, hd, hdv⟩
          have hrel : ∑ i, (z' * d i - c i) • g i = 0 := by
            simp only [sub_smul, Finset.sum_sub_distrib, mul_smul]
            rw [← Finset.smul_sum, ← hdv, ← hc, smul_smul, mul_inv_cancel₀ hz', one_smul, sub_self]
          have := Fintype.linearIndependent_iff.mp hli _ hrel i₀
          have hc' : c i₀ = z' * d i₀ := (sub_eq_zero.mp this).symm
          rw [hc', mul_div_cancel_left₀ _ hz']
          exact hd i₀
      · rw [Fintype.linearIndependent_iff] at hli
        push_neg at hli
        obtain ⟨a, ha, hne⟩ := hli
        obtain ⟨j, hj0, haj⟩ := hmax a hne
        set ρ : Fin (r+1) → K := fun i => a i / a j with hρ
        have hρO : ∀ i, ρ i ∈ O := haj
        have hρj : ρ j = 1 := div_self hj0
        have hρrel : ∑ i, ρ i • g i = 0 := by
          have : ∑ i, ρ i • g i = (a j)⁻¹ • ∑ i, a i • g i := by
            rw [Finset.smul_sum]
            refine Finset.sum_congr rfl (fun i _ => ?_)
            rw [smul_smul, hρ]
            simp only [div_eq_inv_mul]
          rw [this, ha, smul_zero]
        set g' : Fin r → V := fun i' => g (j.succAbove i') with hg'
        have hgj : g j = -∑ i', ρ (j.succAbove i') • g' i' := by
          rw [Fin.sum_univ_succAbove _ j, hρj, one_smul] at hρrel
          exact eq_neg_of_add_eq_zero_left hρrel
        have key : ∀ (S : Subring K), (∀ i, ρ i ∈ S) → ∀ x : V,
            (∃ c : Fin (r+1) → K, (∀ i, c i ∈ S) ∧ x = ∑ i, c i • g i) ↔
            (∃ c : Fin r → K, (∀ i, c i ∈ S) ∧ x = ∑ i, c i • g' i) := by
          intro S hS x
          constructor
          · rintro ⟨c, hcS, hx⟩
            refine ⟨fun i' => c (j.succAbove i') - c j * ρ (j.succAbove i'),
              fun i' => S.sub_mem (hcS _) (S.mul_mem (hcS _) (hS _)), ?_⟩
            rw [hx, Fin.sum_univ_succAbove _ j, hgj, smul_neg, Finset.smul_sum]
            simp only [sub_smul, Finset.sum_sub_distrib, smul_smul]
            abel
          · rintro ⟨c, hcS, hx⟩
            refine ⟨Fin.insertNth j 0 c, ?_, ?_⟩
            · intro i
              by_cases hi : i = j
              · subst hi; simp [S.zero_mem]
              · obtain ⟨i', rfl⟩ := Fin.exists_succAbove_eq hi
                simpa using hcS i'
            · rw [hx, Fin.sum_univ_succAbove _ j]
              simp [hg']
        have keyO := key O.toSubring hρO
        have keyK := key ⊤ (fun _ => Subring.mem_top _)
        have hspan' : ∃ c : Fin r → K, v = ∑ i, c i • g' i := by
          obtain ⟨c, hc⟩ := hspan
          obtain ⟨c', -, hc'⟩ := (keyK v).mp ⟨c, fun _ => Subring.mem_top _, hc⟩
          exact ⟨c', hc'⟩
        obtain ⟨z, hz, hzmem, hzmax⟩ := ih g' v hv hspan'
        refine ⟨z, hz, ?_, ?_⟩
        · exact (keyO _).mpr hzmem
        · intro z' hz' hz'mem
          exact hzmax z' hz' ((keyO _).mp hz'mem)
  have s4 : ∀ (K : Type u) [Field K] (O : ValuationSubring K) (L' : Type u) [Field L'] [Algebra K L'] [FiniteDimensional K L'], letI : Algebra ↥O L' := ((algebraMap K L').comp O.subtype).toAlgebra; Module.Finite ↥O ↥(integralClosure ↥O L') → ∀ α' : L', ∃ (r : ℕ) (g : Fin r → L' ⧸ Submodule.span K {(1 : L')}), (∃ c : Fin r → K, (Submodule.Quotient.mk α' : L' ⧸ Submodule.span K {(1 : L')}) = ∑ i, c i • g i) ∧ ∀ z : K, z ≠ 0 → ((∃ c : Fin r → K, (∀ i, c i ∈ O) ∧ z⁻¹ • (Submodule.Quotient.mk α' : L' ⧸ Submodule.span K {(1 : L')}) = ∑ i, c i • g i) ↔ ∃ h : K, IsIntegral ↥O (algebraMap K L' z⁻¹ * (α' - algebraMap K L' h))) := by
    intro K _ O L' _ _ _
    letI : Algebra ↥O L' := ((algebraMap K L').comp O.subtype).toAlgebra
    intro hfin α'
    haveI : IsScalarTower O K L' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := O) (M := integralClosure O L')
    have hsmul : ∀ (e : O) (y : L'), e • y = (e : K) • y := fun e y => by
      rw [Algebra.smul_def, Algebra.smul_def]; rfl
    have hMsum : ∀ x : L', IsIntegral O x ↔ ∃ e : Fin n → O, x = ∑ i, (e i : K) • (s i : L') := by
      intro x
      constructor
      · intro hx
        have hmem : (⟨x, hx⟩ : integralClosure O L') ∈ Submodule.span O (Set.range s) := by
          rw [hs]; trivial
        obtain ⟨e, he⟩ := (Submodule.mem_span_range_iff_exists_fun O).mp hmem
        refine ⟨e, ?_⟩
        have hx' : x = ((∑ i, e i • s i : integralClosure O L') : L') := by rw [he]
        rw [hx']
        simp only [AddSubmonoidClass.coe_finset_sum, SetLike.val_smul, hsmul]
      · rintro ⟨e, rfl⟩
        refine IsIntegral.sum _ (fun i _ => ?_)
        rw [← hsmul, Algebra.smul_def]
        exact isIntegral_algebraMap.mul (s i).2
    set P := Submodule.span K {(1 : L')} with hP
    have hq1 : (Submodule.Quotient.mk (algebraMap K L' 1) : L' ⧸ P) = 0 := by
      rw [map_one, Submodule.Quotient.mk_eq_zero]
      exact Submodule.mem_span_singleton_self 1
    have hqι : ∀ a : K, (Submodule.Quotient.mk (algebraMap K L' a) : L' ⧸ P) = 0 := by
      intro a
      rw [Algebra.algebraMap_eq_smul_one, Submodule.Quotient.mk_smul, ← map_one (algebraMap K L'),
        hq1, smul_zero]
    have hqsum : ∀ (c : Fin n → K), (Submodule.Quotient.mk (∑ i, c i • (s i : L')) : L' ⧸ P)
        = ∑ i, c i • (Submodule.Quotient.mk (s i : L') : L' ⧸ P) := by
      intro c
      simp only [← Submodule.mkQ_apply, map_sum, map_smul]
    refine ⟨n, fun i => Submodule.Quotient.mk (s i : L'), ?_, ?_⟩
    · have halg : IsAlgebraic K α' := Algebra.IsAlgebraic.isAlgebraic α'
      have halgO : IsAlgebraic O α' := (IsFractionRing.isAlgebraic_iff O K L').mpr halg
      obtain ⟨y, hy0, hyint⟩ := halgO.exists_integral_multiple
      obtain ⟨e, he⟩ := (hMsum _).mp hyint
      have hyK : (y : K) ≠ 0 := fun h => hy0 (Subtype.ext h)
      refine ⟨fun i => (y : K)⁻¹ * e i, ?_⟩
      have h1 : (Submodule.Quotient.mk (y • α') : L' ⧸ P) = Submodule.Quotient.mk (∑ i, (e i : K) • (s i : L')) := by
        rw [he]
      rw [hsmul, Submodule.Quotient.mk_smul, hqsum] at h1
      have h2 := congrArg (fun w => (y : K)⁻¹ • w) h1
      simp only [smul_smul, inv_mul_cancel₀ hyK, one_smul, Finset.smul_sum] at h2
      rw [h2]
    · intro z hz
      constructor
      · rintro ⟨c, hcO, hc⟩
        set m : L' := ∑ i, c i • (s i : L') with hm
        have hmint : IsIntegral O m := (hMsum m).mpr ⟨fun i => ⟨c i, hcO i⟩, rfl⟩
        have hq0 : (Submodule.Quotient.mk (z⁻¹ • α' - m) : L' ⧸ P) = 0 := by
          rw [Submodule.Quotient.mk_sub, Submodule.Quotient.mk_smul, hc, hm, hqsum, sub_self]
        rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_span_singleton] at hq0
        obtain ⟨a, ha⟩ := hq0
        refine ⟨z * a, ?_⟩
        have e : algebraMap K L' z⁻¹ * (α' - algebraMap K L' (z * a)) = m := by
          have e1 : algebraMap K L' z⁻¹ * (α' - algebraMap K L' (z * a))
              = z⁻¹ • α' - a • (1 : L') := by
            rw [Algebra.smul_def, Algebra.smul_def, mul_one, mul_sub, ← map_mul, ← mul_assoc,
              inv_mul_cancel₀ hz, one_mul]
          rw [e1, ha]
          abel
        rw [e]; exact hmint
      · rintro ⟨h, hint⟩
        obtain ⟨e, he⟩ := (hMsum _).mp hint
        refine ⟨fun i => (e i : K), fun i => (e i).2, ?_⟩
        have h1 : (Submodule.Quotient.mk (algebraMap K L' z⁻¹ * (α' - algebraMap K L' h)) : L' ⧸ P)
            = Submodule.Quotient.mk (∑ i, (e i : K) • (s i : L')) := by
          rw [he]
        rw [hqsum] at h1
        rw [← h1]
        have e2 : algebraMap K L' z⁻¹ * (α' - algebraMap K L' h)
            = z⁻¹ • α' - algebraMap K L' (z⁻¹ * h) := by
          rw [Algebra.smul_def, mul_sub, map_mul]
        rw [e2, Submodule.Quotient.mk_sub, Submodule.Quotient.mk_smul, hqι, sub_zero]
  intro K _ O ℓ hℓ hK hroot hfin L _ _ α f hα hf
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI hcK : CharP K ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hK
  obtain ⟨L', iL', iA, iFD, iSep, α', hα', hf'⟩ := s1 K ℓ hℓ hK L α f hα hf
  letI : Algebra O L' := ((algebraMap K L').comp O.subtype).toAlgebra
  haveI hcL : CharP L' ℓ := charP_of_injective_algebraMap (algebraMap K L').injective ℓ
  have hM := hfin L'
  obtain ⟨r, g, hspan, hiff⟩ := s4 K O L' hM α'
  set v := (Submodule.Quotient.mk α' : L' ⧸ Submodule.span K {(1 : L')}) with hv
  have hv0 : v ≠ 0 := by
    intro h0
    rw [hv, Submodule.Quotient.mk_eq_zero, Submodule.mem_span_singleton] at h0
    obtain ⟨a, ha⟩ := h0
    exact hα' ⟨a, by rw [Algebra.algebraMap_eq_smul_one]; exact ha⟩
  obtain ⟨z, hz, hzmem, hzmax⟩ := s3 K O _ r g v hv0 hspan
  obtain ⟨h₀, hint₀⟩ := (hiff z hz).mp hzmem
  have hAS : ∀ h : K, (α' - algebraMap K L' h) ^ ℓ - (α' - algebraMap K L' h)
      = algebraMap K L' (f - h ^ ℓ + h) := by
    intro h
    rw [sub_pow_char, map_add, map_sub, map_pow, ← hf']
    ring
  have hiff1 : ∀ h : K, IsIntegral O (α' - algebraMap K L' h) ↔ f - h ^ ℓ + h ∈ O := by
    intro h
    have := s2 K O L' ℓ hℓ (α' - algebraMap K L' h) (f - h ^ ℓ + h) 1 (hAS h) one_ne_zero
      (by simpa using O.one_mem)
    simpa using this
  refine ⟨h₀, ?_⟩
  by_cases hzO : z ∈ O
  · left
    rw [← hiff1]
    have e : α' - algebraMap K L' h₀ = algebraMap O L' ⟨z, hzO⟩ *
        (algebraMap K L' z⁻¹ * (α' - algebraMap K L' h₀)) := by
      show _ = algebraMap K L' z * _
      rw [← mul_assoc, ← map_mul, mul_inv_cancel₀ hz, map_one, one_mul]
    rw [e]
    exact isIntegral_algebraMap.mul hint₀
  · right
    have hzi : z⁻¹ ∈ O := (O.mem_or_inv_mem z).resolve_left hzO
    have hA : (f - h₀ ^ ℓ + h₀) / z ^ ℓ ∈ O := (s2 K O L' ℓ hℓ _ _ z (hAS h₀) hz hzi).mp hint₀
    intro h' hF'
    have heq : f - h₀ ^ ℓ + h₀ - h' ^ ℓ + h' = f - (h₀ + h') ^ ℓ + (h₀ + h') := by
      rw [add_pow_char]; ring
    obtain ⟨y', hy0, hy1, hy2⟩ := hroot _ hF'
    rcases O.mem_or_inv_mem y' with hyO | hyi
    · exfalso
      apply hzO
      have hF'O : f - h₀ ^ ℓ + h₀ - h' ^ ℓ + h' ∈ O := by
        have e : f - h₀ ^ ℓ + h₀ - h' ^ ℓ + h'
            = y' ^ ℓ * ((f - h₀ ^ ℓ + h₀ - h' ^ ℓ + h') / y' ^ ℓ) := by
          field_simp
        rw [e]; exact mul_mem (pow_mem hyO _) hy1
      rw [heq, ← hiff1] at hF'O
      have h1 : IsIntegral O (algebraMap K L' (1 : K)⁻¹ * (α' - algebraMap K L' (h₀ + h'))) := by
        simpa using hF'O
      have h2 := (hiff 1 one_ne_zero).mpr ⟨_, h1⟩
      simpa using hzmax 1 one_ne_zero h2
    · have h1 : IsIntegral O (algebraMap K L' y'⁻¹ * (α' - algebraMap K L' (h₀ + h'))) := by
        apply (s2 K O L' ℓ hℓ _ _ y' (hAS (h₀ + h')) hy0 hyi).mpr
        rw [← heq]; exact hy1
      have h2 := hzmax y' hy0 ((hiff y' hy0).mpr ⟨_, h1⟩)
      have e : (f - h₀ ^ ℓ + h₀) / (f - h₀ ^ ℓ + h₀ - h' ^ ℓ + h')
          = ((f - h₀ ^ ℓ + h₀) / z ^ ℓ) * (z / y') ^ ℓ *
            (y' ^ ℓ / (f - h₀ ^ ℓ + h₀ - h' ^ ℓ + h')) := by
        rw [div_pow]
        field_simp
      rw [e]
      exact mul_mem (mul_mem hA (pow_mem h2 _)) hy2

theorem wcLlsASbfd_ratfunc_embed : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∃ ι : RatFunc Ω →+* K, (∀ a : ↥W, ι (algebraMap Ω (RatFunc Ω) (a : Ω)) = algebraMap A K (algebraMap ↥W A a)) ∧ ι RatFunc.X = algebraMap A K t :=
by
  intro Ω _ W A _ _ _ K _ _ _ 𝔭 t hPD
  classical

  have s1 : ∀ q : Polynomial ↥W, Polynomial.eval₂ (algebraMap ↥W A) t q = 0 → q = 0 := by
    intro q hq
    by_contra hq0
    obtain ⟨-, -, -, -, -, -, -, hh, hh𝔭, fch, hfC, hfX, hfet⟩ := hPD
    have hh0 : hh ≠ 0 := by
      rintro rfl
      exact hh𝔭 (Ideal.zero_mem 𝔭)
    have hfact : fch = (algebraMap A (Localization.Away hh)).comp
        (Polynomial.eval₂RingHom (algebraMap ↥W A) t) := by
      apply Polynomial.ringHom_ext
      · intro a
        have := congrArg (fun φ => φ a) hfC
        simpa using this
      · simp [hfX]
    have hfq : fch q = 0 := by
      rw [hfact, RingHom.comp_apply, Polynomial.coe_eval₂RingHom, hq, map_zero]
    letI : Algebra (Polynomial ↥W) (Localization.Away hh) := fch.toAlgebra
    haveI : Algebra.Etale (Polynomial ↥W) (Localization.Away hh) := hfet
    haveI : Module.Flat (Polynomial ↥W) (Localization.Away hh) := inferInstance
    have hreg0 : IsSMulRegular (Polynomial ↥W) q := by
      intro p r hpr
      exact mul_left_cancel₀ hq0 (by simpa only [smul_eq_mul] using hpr)
    have hreg := IsSMulRegular.of_flat (S := Localization.Away hh) hreg0
    have hmap : algebraMap (Polynomial ↥W) (Localization.Away hh) q = 0 := hfq
    rw [hmap] at hreg
    have h10 : (1 : Localization.Away hh) = 0 := by
      apply hreg
      simp
    have hinj := IsLocalization.injective (Localization.Away hh)
      (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
    exact one_ne_zero (hinj (by rw [map_one, map_zero]; exact h10))

  have hW : ∀ w : ↥W, algebraMap ↥W A w = 0 → w = 0 := by
    intro w hw
    have := s1 (Polynomial.C w) (by rw [Polynomial.eval₂_C]; exact hw)
    exact Polynomial.C_eq_zero.mp this
  have hg₀ : Function.Injective ((algebraMap A K).comp (algebraMap ↥W A)) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    apply hW
    apply IsFractionRing.injective A K
    rw [map_zero]
    exact hw

  let j₀ : Ω →+* K := IsFractionRing.lift (A := ↥W) (K := Ω) hg₀
  have hJ' : j₀.comp (algebraMap ↥W Ω) = (algebraMap A K).comp (algebraMap ↥W A) := by
    ext w
    exact IsFractionRing.lift_algebraMap hg₀ w
  have hJ : ∀ w : ↥W, j₀ (w : Ω) = algebraMap A K (algebraMap ↥W A w) := by
    intro w
    have := congrArg (fun f => f w) hJ'
    simpa using this

  let ψ : Polynomial Ω →+* K := Polynomial.eval₂RingHom j₀ (algebraMap A K t)
  have hψ : Function.Injective ψ := by
    rw [injective_iff_map_eq_zero]
    intro p hp
    have hp' : Polynomial.eval₂ j₀ (algebraMap A K t) p = 0 := hp
    have h1 := IsLocalization.integerNormalization_eval₂_eq_zero (nonZeroDivisors ↥W) j₀ p hp'
    rw [hJ'] at h1
    have h2 : algebraMap A K (Polynomial.eval₂ (algebraMap ↥W A) t
        (IsLocalization.integerNormalization (nonZeroDivisors ↥W) p)) = 0 := by
      rw [Polynomial.hom_eval₂]
      exact h1
    have h3 := s1 _ ((injective_iff_map_eq_zero (algebraMap A K)).mp
      (IsFractionRing.injective A K) _ h2)
    exact (IsFractionRing.integerNormalization_eq_zero_iff).mp h3

  let ι : RatFunc Ω →+* K := IsFractionRing.lift (A := Polynomial Ω) (K := RatFunc Ω) hψ
  refine ⟨ι, ?_, ?_⟩
  · intro a
    have e : algebraMap Ω (RatFunc Ω) (a : Ω) =
        algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C (a : Ω)) := by
      rw [RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
    rw [e]
    show IsFractionRing.lift hψ (algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C (a : Ω))) = _
    rw [IsFractionRing.lift_algebraMap]
    show Polynomial.eval₂ j₀ (algebraMap A K t) (Polynomial.C (a : Ω)) = _
    rw [Polynomial.eval₂_C, hJ]
  · rw [← RatFunc.algebraMap_X]
    show IsFractionRing.lift hψ (algebraMap (Polynomial Ω) (RatFunc Ω) Polynomial.X) = _
    rw [IsFractionRing.lift_algebraMap]
    show Polynomial.eval₂ j₀ (algebraMap A K t) Polynomial.X = _
    rw [Polynomial.eval₂_X]

theorem wcLlsASbfd_ratfunc_finsep : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ ι : RatFunc Ω →+* K, (∀ a : ↥W, ι (algebraMap Ω (RatFunc Ω) (a : Ω)) = algebraMap A K (algebraMap ↥W A a)) → ι RatFunc.X = algebraMap A K t → letI : Algebra (RatFunc Ω) K := ι.toAlgebra; FiniteDimensional (RatFunc Ω) K ∧ Algebra.IsSeparable (RatFunc Ω) K :=
by
  intro Ω _ W A _ _ _ K _ _ _ 𝔭 t hPD ι hι1 hι2
  obtain ⟨-, -, -, -, -, -, -, h, hh𝔭, f, hfC, hfX, hfet⟩ := hPD
  have hh0 : h ≠ 0 := by
    rintro rfl
    exact hh𝔭 (Ideal.zero_mem 𝔭)
  have hu : IsUnit (algebraMap A K h) := by
    refine IsUnit.mk0 _ ?_
    intro h0
    exact hh0 ((IsFractionRing.injective A K) (h0.trans (map_zero _).symm))
  let σ : Localization.Away h →+* K := IsLocalization.Away.lift h hu
  have hσ : ∀ a : A, σ (algebraMap A (Localization.Away h) a) = algebraMap A K a :=
    fun a => IsLocalization.Away.lift_eq h hu a
  let κ : Polynomial ↥W →+* RatFunc Ω :=
    (algebraMap (Polynomial Ω) (RatFunc Ω)).comp (Polynomial.mapRingHom W.subtype)
  have hsq : σ.comp f = ι.comp κ := by
    apply Polynomial.ringHom_ext
    · intro a
      have e1 := RingHom.congr_fun hfC a
      simp only [RingHom.comp_apply] at e1 ⊢
      rw [e1, hσ, ← hι1 a]
      congr 1
      simp [κ, RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
    · simp only [RingHom.comp_apply]
      rw [hfX, hσ, ← hι2]
      congr 1
      simp [κ, RatFunc.algebraMap_X]
  letI : Algebra (Polynomial ↥W) (Localization.Away h) := f.toAlgebra
  letI : Algebra (Localization.Away h) K := σ.toAlgebra
  letI : Algebra (Polynomial ↥W) K := (σ.comp f).toAlgebra
  letI : Algebra (Polynomial ↥W) (RatFunc Ω) := κ.toAlgebra
  letI : Algebra (RatFunc Ω) K := ι.toAlgebra
  haveI : IsScalarTower (Polynomial ↥W) (Localization.Away h) K :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : IsScalarTower (Polynomial ↥W) (RatFunc Ω) K :=
    IsScalarTower.of_algebraMap_eq (fun x => RingHom.congr_fun hsq x)
  haveI : Algebra.Etale (Polynomial ↥W) (Localization.Away h) := hfet
  haveI : IsScalarTower A (Localization.Away h) K :=
    IsScalarTower.of_algebraMap_eq (fun a => (hσ a).symm)
  haveI : IsFractionRing (Localization.Away h) K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers h)
      (Localization.Away h) K
  haveI : Algebra.FormallyUnramified (Localization.Away h) K :=
    Algebra.FormallyUnramified.of_isLocalization (nonZeroDivisors (Localization.Away h))
  haveI : Algebra.EssFiniteType (Localization.Away h) K :=
    Algebra.EssFiniteType.of_isLocalization K (nonZeroDivisors (Localization.Away h))
  haveI : Algebra.FormallyUnramified (Polynomial ↥W) K :=
    Algebra.FormallyUnramified.comp (Polynomial ↥W) (Localization.Away h) K
  haveI : Algebra.EssFiniteType (Polynomial ↥W) K :=
    Algebra.EssFiniteType.comp (Polynomial ↥W) (Localization.Away h) K
  haveI : Algebra.FormallyUnramified (RatFunc Ω) K :=
    Algebra.FormallyUnramified.of_restrictScalars (Polynomial ↥W) (RatFunc Ω) K
  haveI : Algebra.EssFiniteType (RatFunc Ω) K :=
    Algebra.EssFiniteType.of_comp (Polynomial ↥W) (RatFunc Ω) K
  exact ⟨Algebra.FormallyUnramified.finite_of_free (RatFunc Ω) K,
    Algebra.FormallyUnramified.isSeparable (RatFunc Ω) K⟩

theorem wcLlsASbfd_gauss_into_O : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ O : ValuationSubring K, (∀ x : K, x ∈ O ↔ ∃ a b : A, (∀ s : A, s ∉ 𝔭 → s * b ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧ x * algebraMap A K b = algebraMap A K a) → ∀ ι : RatFunc Ω →+* K, (∀ a : ↥W, ι (algebraMap Ω (RatFunc Ω) (a : Ω)) = algebraMap A K (algebraMap ↥W A a)) → ι RatFunc.X = algebraMap A K t → (∀ a b : A, a * b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) → ∃ s : A, s ∉ 𝔭 ∧ (s * a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ∨ s * b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A))) → (∀ s : A, s ∉ 𝔭 → s * t ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) → ∀ V : ValuationSubring (RatFunc Ω), V.toSubring = wcEbGauss W → (∀ a : Ω, algebraMap Ω (RatFunc Ω) a ∈ V ↔ a ∈ W) → (∀ f : RatFunc Ω, f ≠ 0 → ∃ a : Ω, a ≠ 0 ∧ ∃ u : Vˣ, f = algebraMap Ω (RatFunc Ω) a * ((u : V) : RatFunc Ω)) → (∀ f ∈ wcEbGauss W, ι f ∈ O) ∧ (∀ f ∈ V, f ≠ 0 → (ι f)⁻¹ ∈ O → f⁻¹ ∈ V) :=
by
  intro Ω _ W A _ _ _ K _ _ _ 𝔭 t hPD O hOmem ι hι1 hι2 hSF1 hSF2 V hV hV2 hV4
  classical
  obtain ⟨-, -, -, hmax, hmA, ht, -⟩ := hPD
  have hprime : 𝔭.IsPrime := hmax.isPrime
  have h1 : (1 : A) ∉ 𝔭 := fun h => hmax.ne_top ((Ideal.eq_top_iff_one _).mpr h)

  have F1 : ∀ ε : A, ε ∉ 𝔭 → ∀ s : A, s ∉ 𝔭 →
      s * ε ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
    intro ε hε s hs hm
    rcases hprime.mem_or_mem (hmA hm) with h | h
    · exact hs h
    · exact hε h

  have F2 : ∀ x y : A,
      (∀ s : A, s ∉ 𝔭 → s * x ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) →
      (∀ s : A, s ∉ 𝔭 → s * y ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) →
      ∀ s : A, s ∉ 𝔭 → s * (x * y) ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
    intro x y hx hy s hs hm
    rw [← mul_assoc] at hm
    obtain ⟨s', hs', h | h⟩ := hSF1 (s * x) y hm
    · apply hx (s' * s) (fun h' => (hprime.mem_or_mem h').elim hs' hs)
      rw [mul_assoc]; exact h
    · exact hy s' hs' h

  have F3 : ∀ b b' : A,
      (∀ s : A, s ∉ 𝔭 → s * b' ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) →
      b - b' ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      ∀ s : A, s ∉ 𝔭 → s * b ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
    intro b b' hb' hd s hs hm
    apply hb' s hs
    have e : s * b' = s * b - s * (b - b') := by ring
    rw [e]
    exact Ideal.sub_mem _ hm (Ideal.mul_mem_left _ s hd)
  have Hdec : ∀ q : Polynomial ↥W, Polynomial.eval₂ (algebraMap ↥W A) t q =
      Polynomial.eval₂ (algebraMap ↥W A) t q.divX * t + algebraMap ↥W A (q.coeff 0) := by
    intro q
    conv_lhs => rw [← Polynomial.X_mul_divX_add q]
    rw [Polynomial.eval₂_add, Polynomial.eval₂_X_mul, Polynomial.eval₂_C]
  have caseA : ∀ q : Polynomial ↥W, IsUnit (q.coeff 0) → ∀ s : A, s ∉ 𝔭 →
      s * Polynomial.eval₂ (algebraMap ↥W A) t q ∉
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
    intro q hq
    apply F1
    intro hq𝔭
    apply hprime.ne_top
    apply Ideal.eq_top_of_isUnit_mem _ _ (hq.map (algebraMap ↥W A))
    have e : algebraMap ↥W A (q.coeff 0) = Polynomial.eval₂ (algebraMap ↥W A) t q -
        Polynomial.eval₂ (algebraMap ↥W A) t q.divX * t := by
      rw [Hdec q]; ring
    rw [e]
    exact Ideal.sub_mem _ hq𝔭 (Ideal.mul_mem_left _ _ ht)

  have Hunit : ∀ i : ℕ, ∀ q : Polynomial ↥W, IsUnit (q.coeff i) → ∀ s : A, s ∉ 𝔭 →
      s * Polynomial.eval₂ (algebraMap ↥W A) t q ∉
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
    intro i
    induction i with
    | zero => exact caseA
    | succ j ih =>
      intro q hq
      by_cases h0 : IsUnit (q.coeff 0)
      · exact caseA q h0
      · have hm : q.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W :=
          (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr h0)
        have hdiv : IsUnit (q.divX.coeff j) := by rw [Polynomial.coeff_divX]; exact hq
        have hN := F2 _ t (ih q.divX hdiv) hSF2
        refine F3 _ _ hN ?_
        rw [Hdec q, add_sub_cancel_left]
        exact Ideal.mem_map_of_mem _ hm

  have Htr : ∀ r : Polynomial ↥W,
      ι (algebraMap (Polynomial Ω) (RatFunc Ω) (r.map W.subtype)) =
        algebraMap A K (Polynomial.eval₂ (algebraMap ↥W A) t r) := by
    intro r
    have e : (ι.comp (algebraMap (Polynomial Ω) (RatFunc Ω))).comp
        (Polynomial.mapRingHom W.subtype) =
        (algebraMap A K).comp (Polynomial.eval₂RingHom (algebraMap ↥W A) t) := by
      apply Polynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C,
          Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        rw [RatFunc.algebraMap_C, ← RatFunc.algebraMap_eq_C]
        exact hι1 a
      · simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X,
          Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, RatFunc.algebraMap_X]
        exact hι2
    exact RingHom.congr_fun e r

  have hC1 : ∀ f ∈ wcEbGauss W, ι f ∈ O := by
    intro f hf
    have hle : wcEbGauss W ≤ O.toSubring.comap ι := by
      unfold wcEbGauss
      rw [Subring.closure_le]
      rintro g ⟨p, q, hunit, -, hgq⟩
      obtain ⟨i, hi⟩ := hunit
      show ι g ∈ O
      have e := congrArg ι hgq
      rw [map_mul, Htr, Htr] at e
      exact (hOmem (ι g)).mpr ⟨_, _, Hunit i q hi, e⟩
    exact hle hf
  refine ⟨hC1, ?_⟩

  have hVO : ∀ f ∈ V, ι f ∈ O := by
    intro f hf
    apply hC1
    rw [← hV]
    exact hf
  intro f hf hf0 hinv
  obtain ⟨a, ha0, u, rfl⟩ := hV4 f hf0
  obtain ⟨c, hc⟩ : ∃ c, c = algebraMap Ω (RatFunc Ω) a := ⟨_, rfl⟩
  rw [← hc] at hf hinv ⊢
  have huu : ((u : V) : RatFunc Ω) * (((u⁻¹ : Vˣ) : V) : RatFunc Ω) = 1 :=
    congrArg Subtype.val u.mul_inv
  have hcV : c ∈ V := by
    have e : c = (c * ((u : V) : RatFunc Ω)) * (((u⁻¹ : Vˣ) : V) : RatFunc Ω) := by
      rw [mul_assoc, huu, mul_one]
    rw [e]
    exact mul_mem hf ((u⁻¹ : Vˣ) : V).2
  have haW : a ∈ W := (hV2 a).mp (by rw [← hc]; exact hcV)
  obtain ⟨a', ha'⟩ : ∃ a' : ↥W, (a' : Ω) = a := ⟨⟨a, haW⟩, rfl⟩
  have hιc : ι c = algebraMap A K (algebraMap ↥W A a') := by
    rw [hc, ← ha']; exact hι1 a'
  have hc0 : c ≠ 0 := by
    rw [hc]; exact (map_ne_zero _).mpr ha0
  have hu0 : ((u : V) : RatFunc Ω) ≠ 0 := by
    intro h; rw [h, zero_mul] at huu; exact zero_ne_one huu
  have hιc0 : ι c ≠ 0 := (map_ne_zero ι).mpr hc0
  have hιu0 : ι ((u : V) : RatFunc Ω) ≠ 0 := (map_ne_zero ι).mpr hu0
  have hιuO : ι ((u : V) : RatFunc Ω) ∈ O := hVO _ (u : V).2
  have hcinvO : (ι c)⁻¹ ∈ O := by
    have e : (ι c)⁻¹ = (ι (c * ((u : V) : RatFunc Ω)))⁻¹ * ι ((u : V) : RatFunc Ω) := by
      rw [map_mul, mul_inv, mul_assoc, inv_mul_cancel₀ hιu0, mul_one]
    rw [e]
    exact mul_mem hinv hιuO
  have hunitA : IsUnit a' := by
    by_contra hnu
    have hm : a' ∈ IsLocalRing.maximalIdeal ↥W :=
      (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu)
    rw [hιc] at hcinvO hιc0
    obtain ⟨a₂, b, hb, hab⟩ := (hOmem _).mp hcinvO
    have hb' : algebraMap A K b = algebraMap A K (algebraMap ↥W A a' * a₂) := by
      rw [map_mul, ← hab, ← mul_assoc, mul_inv_cancel₀ hιc0, one_mul]
    have hbeq := IsFractionRing.injective A K hb'
    apply hb 1 h1
    rw [one_mul, hbeq]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hm)
  obtain ⟨v, hv⟩ := hunitA
  have hainv : a⁻¹ ∈ W := by
    have h2 : a * (((v⁻¹ : Wˣ) : W) : Ω) = 1 := by
      rw [← ha', ← hv]
      exact congrArg Subtype.val v.mul_inv
    rw [inv_eq_of_mul_eq_one_right h2]
    exact ((v⁻¹ : Wˣ) : W).2
  have hfinv : (c * ((u : V) : RatFunc Ω))⁻¹ =
      algebraMap Ω (RatFunc Ω) a⁻¹ * (((u⁻¹ : Vˣ) : V) : RatFunc Ω) := by
    rw [mul_inv, map_inv₀, ← hc, inv_eq_of_mul_eq_one_right huu]
  rw [hfinv]
  exact mul_mem ((hV2 _).mpr hainv) ((u⁻¹ : Vˣ) : V).2

theorem wcLlsASbf_defectless : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ O : ValuationSubring K, (∀ x : K, x ∈ O ↔ ∃ a b : A, (∀ s : A, s ∉ 𝔭 → s * b ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧ x * algebraMap A K b = algebraMap A K a) → ∀ (L' : Type u) [Field L'] [Algebra K L'] [FiniteDimensional K L'] [Algebra.IsSeparable K L'], letI : Algebra ↥O L' := ((algebraMap K L').comp O.subtype).toAlgebra; Module.Finite ↥O ↥(integralClosure ↥O L') :=
by
  intro Ω _ _ W hdim hWtop A _ _ _ K _ _ _ 𝔭 t hPD O hOmem L' _ _ _ _
  obtain ⟨ι, hι1, hι2⟩ := wcLlsASbfd_ratfunc_embed Ω W A K 𝔭 t hPD
  letI : Algebra (RatFunc Ω) K := ι.toAlgebra
  obtain ⟨hfd, hsep⟩ := wcLlsASbfd_ratfunc_finsep Ω W A K 𝔭 t hPD ι hι1 hι2
  haveI := hfd
  haveI := hsep
  obtain ⟨V, hV1, hV2, -, hV4⟩ := wcpa_dj_lr1k_gd_gauss_valuation Ω W
  obtain ⟨hSF1, hSF2, -⟩ := wcpa_dj_llsm_kpdf_special_fibre_dvr Ω W hdim hWtop A 𝔭 t hPD
  obtain ⟨hG1, hG2⟩ := wcLlsASbfd_gauss_into_O Ω W A K 𝔭 t hPD O hOmem ι hι1 hι2 hSF1 hSF2
    V hV1 hV2 hV4
  have hR₀ : ∀ f ∈ wcEbGauss W, algebraMap (RatFunc Ω) K f ∈ O := hG1
  have hV₀ : ∀ f ∈ V, algebraMap (RatFunc Ω) K f ∈ O := by
    intro f hf
    apply hG1
    rw [← hV1]
    exact hf
  have hV₀' : ∀ f ∈ V, f ≠ 0 → (algebraMap (RatFunc Ω) K f)⁻¹ ∈ O → f⁻¹ ∈ V := hG2
  letI : Algebra (RatFunc Ω) L' := ((algebraMap K L').comp (algebraMap (RatFunc Ω) K)).toAlgebra
  haveI : IsScalarTower (RatFunc Ω) K L' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : FiniteDimensional (RatFunc Ω) L' := Module.Finite.trans K L'
  haveI : Algebra.IsSeparable (RatFunc Ω) L' := Algebra.IsSeparable.trans (RatFunc Ω) K L'
  have hD := wcpa_dj_lr1k_eb_gauss_defectless_r1 Ω W hdim hWtop L'
  haveI : Algebra.IsAlgebraic (RatFunc Ω) K := Algebra.IsAlgebraic.of_finite _ _
  letI : Algebra ↥(wcEbGauss W) K :=
    ((algebraMap (RatFunc Ω) K).comp (wcEbGauss W).subtype).toAlgebra
  have hU := wcLlsASbfd_unit_fraction (RatFunc Ω) K V (wcEbGauss W) hV1 O hV₀ hV₀'
    (fun n b x h k => wcLlsASbfd_bourbaki_integral ↥(wcEbGauss W) K n b x h k)
  exact wcLlsASbfd_finite_transfer (RatFunc Ω) K L' (wcEbGauss W) O hR₀ hU hD

theorem wcLlsASbf_best_approx : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ((ℓ : ℕ) : K) = 0 → ∀ (α : L) (f : K), α ∉ Set.range (algebraMap K L) → α ^ ℓ - α = algebraMap K L f → ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → ∃ (h₀ : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ g₀ g₁ : A), lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀ ∉ 𝔭 ∧ ε₁ ∉ 𝔭 ∧ (f - h₀ ^ ℓ + h₀) * algebraMap A K ((t - algebraMap ↥W A c) ^ n * ε₁ + algebraMap ↥W A w * g₁) * algebraMap A K (algebraMap ↥W A lam₂) = algebraMap A K (algebraMap ↥W A lam₁) * algebraMap A K ((t - algebraMap ↥W A c) ^ k * ε₀ + algebraMap ↥W A w * g₀) ∧ (lam₂ ∣ lam₁ ∨ ∀ (h' : K) (lam₁' lam₂' w' : ↥W) (n' k' : ℕ) (ε₀' ε₁' g₀' g₁' : A), lam₁' ≠ 0 → lam₂' ≠ 0 → w' ∈ IsLocalRing.maximalIdeal ↥W → ε₀' ∉ 𝔭 → ε₁' ∉ 𝔭 → (f - h₀ ^ ℓ + h₀ - h' ^ ℓ + h') * algebraMap A K ((t - algebraMap ↥W A c) ^ n' * ε₁' + algebraMap ↥W A w' * g₁') * algebraMap A K (algebraMap ↥W A lam₂') = algebraMap A K (algebraMap ↥W A lam₁') * algebraMap A K ((t - algebraMap ↥W A c) ^ k' * ε₀' + algebraMap ↥W A w' * g₀') → lam₁' * lam₂ ∣ lam₁ * lam₂') :=
by
  intro Ω _ _ W hdim hWtop ℓ hℓ A _ _ _ K _ _ _ L _ _ 𝔭 t hPD hK α f hα hf c hc
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI hcK : CharP K ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hK
  haveI hcL : CharP L ℓ := charP_of_injective_algebraMap (algebraMap K L).injective ℓ

  have hnwp : ∀ h : K, f - h ^ ℓ + h ≠ 0 := by
    intro h h0
    apply hα
    have hβ : (α - algebraMap K L h) ^ ℓ = α - algebraMap K L h := by
      rw [sub_pow_char]
      have e : algebraMap K L f = algebraMap K L (h ^ ℓ - h) := by
        congr 1; linear_combination h0
      rw [map_sub, map_pow] at e
      linear_combination hf + e
    have hmem : α - algebraMap K L h ∈ (⊥ : Subfield L) :=
      (Subfield.mem_bot_iff_pow_eq_self L ℓ).mpr hβ
    have hmem' : α - algebraMap K L h ∈ (algebraMap K L).fieldRange :=
      (bot_le : (⊥ : Subfield L) ≤ (algebraMap K L).fieldRange) hmem
    obtain ⟨h₁, hh₁⟩ := RingHom.mem_fieldRange.mp hmem'
    exact ⟨h₁ + h, by rw [map_add, hh₁]; ring⟩

  obtain ⟨O, hOmem, hroot⟩ := wcLlsASbf_fibre_valring Ω W hdim hWtop A K 𝔭 t hPD
  have hfin := wcLlsASbf_defectless Ω W hdim hWtop A K 𝔭 t hPD O hOmem
  obtain ⟨h₀, hdisj⟩ :=
    wcLlsASbf_lattice_max K O ℓ hℓ hK (hroot ℓ hℓ.pos) hfin L α f hα hf

  obtain ⟨lam₁, lam₂, w, n, k, ε₀, ε₁, g₀, g₁, h1, h2, h3, h4, h5, hEQ⟩ :=
    wcLlsASbf_nf_exists Ω W hdim hWtop A K 𝔭 t hPD c hc _ (hnwp h₀)
  refine ⟨h₀, lam₁, lam₂, w, n, k, ε₀, ε₁, g₀, g₁, h1, h2, h3, h4, h5, hEQ, ?_⟩
  have hmax : 𝔭.IsMaximal := by
    obtain ⟨-, -, -, hm, -⟩ := hPD
    exact hm
  have h𝔭 : (1 : A) ∉ 𝔭 := fun h => hmax.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  rcases hdisj with hO | hO
  · left
    obtain ⟨a, b, hb, hab⟩ := (hOmem _).mp hO
    have hcmp := wcLlsASbf_nf_compare Ω W hdim hWtop A K 𝔭 t hPD c hc (f - h₀ ^ ℓ + h₀) 1
      lam₁ lam₂ w n k ε₀ ε₁ g₀ g₁ 1 1 0 0 0 1 1 0 0 a b h1 h2 h3 h4 h5 hEQ one_ne_zero
      one_ne_zero (IsLocalRing.maximalIdeal ↥W).zero_mem h𝔭 h𝔭 (by simp) hb
      (by rw [hab, one_mul])
    simpa using hcmp
  · right
    intro h' lam₁' lam₂' w' n' k' ε₀' ε₁' g₀' g₁' h1' h2' h3' h4' h5' hEQ'
    have hF' : f - h₀ ^ ℓ + h₀ - h' ^ ℓ + h' ≠ 0 := by
      have e : f - h₀ ^ ℓ + h₀ - h' ^ ℓ + h' = f - (h₀ + h') ^ ℓ + (h₀ + h') := by
        rw [add_pow_char]; ring
      rw [e]; exact hnwp _
    obtain ⟨a, b, hb, hab⟩ := (hOmem _).mp (hO h' hF')
    refine wcLlsASbf_nf_compare Ω W hdim hWtop A K 𝔭 t hPD c hc _ _ lam₁ lam₂ w n k ε₀ ε₁ g₀ g₁
      lam₁' lam₂' w' n' k' ε₀' ε₁' g₀' g₁' a b h1 h2 h3 h4 h5 hEQ h1' h2' h3' h4' h5' hEQ' hb ?_
    rw [← hab]
    field_simp

theorem wcLlsASb_residue_lift : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [Algebra ↥W A] (𝔭 : Ideal A), Algebra.FiniteType ↥W A →
    𝔭.IsMaximal → (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 →
    ∀ a : A, ∃ γ : ↥W, a - algebraMap ↥W A γ ∈ 𝔭 :=
by
  intro Ω _ _ W A _ _ 𝔭 hFT hmax hle a
  have hac : IsAlgClosed (IsLocalRing.ResidueField ↥W) := wcpa_dj_nc_residue_algclosed Ω W
  have hcomap : 𝔭.comap (algebraMap A A) = 𝔭 := by
    rw [Algebra.algebraMap_self]
    exact Ideal.comap_id 𝔭
  obtain ⟨r, hr⟩ := wcpa_dj_llsm_kpwbe_residue_const Ω W hac A A 𝔭 𝔭 hFT hmax hle
    hmax.isPrime hcomap a
  exact ⟨r, by simpa [Algebra.algebraMap_self] using hr⟩

theorem wcLlsASbf_frob_span : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ((ℓ : ℕ) : K) = 0 → ∀ y : A, ∃ (s : A) (z : ℕ → A), s ∉ 𝔭 ∧ s ^ ℓ * y - ∑ i ∈ Finset.range ℓ, z i ^ ℓ * t ^ i ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) :=
by
  intro Ω _ _ W _hdim _hWtop ℓ hℓ A _ _ _ K _ _ _ 𝔭 t hPD hK y
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  obtain ⟨hFT, -, -, hmax, hmA, ht, h𝔭eq, -⟩ := hPD
  have RL := wcLlsASb_residue_lift Ω W A 𝔭 hFT hmax hmA

  haveI hcA : CharP A ℓ := by
    apply (CharP.charP_iff_prime_eq_zero hℓ).mpr
    apply IsFractionRing.injective A K
    rw [map_natCast, hK, map_zero]

  have hroot : ∀ w : ↥W, ∃ c : ↥W, c ^ ℓ = w := by
    intro w
    by_cases hw : w = 0
    · exact ⟨0, by rw [hw, zero_pow hℓ.ne_zero]⟩
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (w : Ω) hℓ.pos
    have hz0 : z ≠ 0 := by
      rintro rfl
      apply hw
      apply Subtype.ext
      rw [← hz, zero_pow hℓ.ne_zero]
      rfl
    have hzW : z ∈ W := by
      rcases W.mem_or_inv_mem z with h | h
      · exact h
      · have e : z = (w : Ω) * (z⁻¹) ^ (ℓ - 1) := by
          rw [← hz]
          obtain ⟨k, hk⟩ : ∃ k, ℓ = k + 1 := ⟨ℓ - 1, by have := hℓ.pos; omega⟩
          rw [hk, Nat.add_sub_cancel, inv_pow, pow_succ', mul_assoc,
            mul_inv_cancel₀ (pow_ne_zero _ hz0), mul_one]
        rw [e]
        exact mul_mem w.2 (pow_mem h _)
    refine ⟨⟨z, hzW⟩, Subtype.ext ?_⟩
    rw [SubmonoidClass.coe_pow]
    exact hz

  let S : Subring A := (frobenius A ℓ).range
  have hint : Algebra.IsIntegral S A := by
    constructor
    intro x
    refine ⟨Polynomial.X ^ ℓ - Polynomial.C ⟨x ^ ℓ, RingHom.mem_range.mpr ⟨x, frobenius_def ℓ x⟩⟩,
      Polynomial.monic_X_pow_sub_C _ hℓ.ne_zero, ?_⟩
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
    exact sub_self _
  have hft : Algebra.FiniteType S A := by
    obtain ⟨G, hG⟩ := hFT.out
    refine ⟨⟨G, ?_⟩⟩
    rw [eq_top_iff]
    intro x hxtop
    clear hxtop
    have hx : x ∈ Algebra.adjoin ↥W (G : Set A) := by rw [hG]; exact Algebra.mem_top
    induction hx using Algebra.adjoin_induction with
    | mem x hx => exact Algebra.subset_adjoin hx
    | algebraMap r =>
      obtain ⟨c, hc⟩ := hroot r
      have e : algebraMap ↥W A r = algebraMap S A ⟨(algebraMap ↥W A c) ^ ℓ,
          RingHom.mem_range.mpr ⟨_, frobenius_def ℓ _⟩⟩ := by
        show _ = (algebraMap ↥W A c) ^ ℓ
        rw [← map_pow, hc]
      rw [e]
      exact Subalgebra.algebraMap_mem _ _
    | add x y _ _ hx hy => exact add_mem hx hy
    | mul x y _ _ hx hy => exact mul_mem hx hy
  haveI := hint
  haveI := hft
  haveI hfin : Module.Finite S A := Algebra.IsIntegral.finite

  have htay : ∀ (k : ℕ) (y : A), ∃ (γ : ℕ → ↥W) (q : A),
      y - ∑ i ∈ Finset.range k, algebraMap ↥W A (γ i) * t ^ i - t ^ k * q ∈
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
    intro k
    induction k with
    | zero => intro y; exact ⟨0, y, by simp⟩
    | succ k ih =>
      intro y
      obtain ⟨γ₀, hγ₀⟩ := RL y
      rw [h𝔭eq, Submodule.mem_sup] at hγ₀
      obtain ⟨a, ha, m, hm, hsum⟩ := hγ₀
      obtain ⟨a', rfl⟩ := Ideal.mem_span_singleton'.mp ha
      obtain ⟨γ', q', hq'⟩ := ih a'
      refine ⟨fun i => if i = 0 then γ₀ else γ' (i - 1), q', ?_⟩
      rw [Finset.sum_range_succ']
      have h1 : ∑ i ∈ Finset.range k,
          algebraMap ↥W A ((fun i => if i = 0 then γ₀ else γ' (i - 1)) (i + 1)) * t ^ (i + 1) =
          t * ∑ i ∈ Finset.range k, algebraMap ↥W A (γ' i) * t ^ i := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        simp only [Nat.add_one_ne_zero, ite_false, Nat.add_sub_cancel]
        ring
      have h0 : algebraMap ↥W A ((fun i => if i = 0 then γ₀ else γ' (i - 1)) 0) * t ^ 0 =
          algebraMap ↥W A γ₀ := by
        simp
      rw [h1, h0]
      have key : y - (t * ∑ i ∈ Finset.range k, algebraMap ↥W A (γ' i) * t ^ i +
          algebraMap ↥W A γ₀) - t ^ (k + 1) * q' =
          m + t * (a' - ∑ i ∈ Finset.range k, algebraMap ↥W A (γ' i) * t ^ i - t ^ k * q') := by
        linear_combination (-1 : A) * hsum
      rw [key]
      exact Ideal.add_mem _ hm (Ideal.mul_mem_left _ t hq')

  let N : Submodule S A :=
    { carrier := {x | ∃ z : ℕ → A, x - ∑ i ∈ Finset.range ℓ, z i ^ ℓ * t ^ i ∈
          (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)}
      add_mem' := by
        rintro a b ⟨z, hz⟩ ⟨z', hz'⟩
        refine ⟨z + z', ?_⟩
        have e : a + b - ∑ i ∈ Finset.range ℓ, (z + z') i ^ ℓ * t ^ i =
            (a - ∑ i ∈ Finset.range ℓ, z i ^ ℓ * t ^ i) +
              (b - ∑ i ∈ Finset.range ℓ, z' i ^ ℓ * t ^ i) := by
          simp only [Pi.add_apply, add_pow_char, add_mul, Finset.sum_add_distrib]
          ring
        rw [e]
        exact Ideal.add_mem _ hz hz'
      zero_mem' := ⟨0, by simp [zero_pow hℓ.ne_zero]⟩
      smul_mem' := by
        rintro ⟨r, hr⟩ x ⟨z, hz⟩
        obtain ⟨a, rfl⟩ := RingHom.mem_range.mp hr
        refine ⟨fun i => a * z i, ?_⟩
        have e : (⟨frobenius A ℓ a, hr⟩ : S) • x - ∑ i ∈ Finset.range ℓ, (a * z i) ^ ℓ * t ^ i =
            a ^ ℓ * (x - ∑ i ∈ Finset.range ℓ, z i ^ ℓ * t ^ i) := by
          rw [Subring.smul_def, smul_eq_mul]
          simp only [frobenius_def, mul_pow, mul_sub, Finset.mul_sum, mul_assoc]
        rw [e]
        exact Ideal.mul_mem_left _ _ hz }
  let 𝔮 : Ideal S := 𝔭.comap S.subtype
  have hfg : (⊤ : Submodule S (A ⧸ N)).FG := Module.Finite.fg_top
  have hle : (⊤ : Submodule S (A ⧸ N)) ≤ 𝔮 • ⊤ := by
    rintro x -
    obtain ⟨y', rfl⟩ := Submodule.Quotient.mk_surjective N x
    obtain ⟨γ, q, hq⟩ := htay ℓ y'
    choose c hc using fun i => hroot (γ i)
    have hmem : y' - t ^ ℓ * q ∈ N := by
      refine ⟨fun i => algebraMap ↥W A (c i), ?_⟩
      have e : y' - t ^ ℓ * q - ∑ i ∈ Finset.range ℓ, (algebraMap ↥W A (c i)) ^ ℓ * t ^ i =
          y' - ∑ i ∈ Finset.range ℓ, algebraMap ↥W A (γ i) * t ^ i - t ^ ℓ * q := by
        simp only [← map_pow, hc]
        ring
      rw [e]
      exact hq
    let T : S := ⟨t ^ ℓ, RingHom.mem_range.mpr ⟨t, frobenius_def ℓ t⟩⟩
    have hT : T ∈ 𝔮 := Ideal.mem_comap.mpr (Ideal.pow_mem_of_mem 𝔭 ht ℓ hℓ.pos)
    have e : (Submodule.Quotient.mk y' : A ⧸ N) = T • Submodule.Quotient.mk q := by
      rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.eq]
      exact hmem
    rw [e]
    exact Submodule.smul_mem_smul hT Submodule.mem_top
  obtain ⟨r, hr1, hr⟩ :=
    Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul 𝔮 ⊤ hfg hle
  obtain ⟨s, hs⟩ := RingHom.mem_range.mp r.2
  have hy := hr (Submodule.Quotient.mk y) Submodule.mem_top
  rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hy
  obtain ⟨z, hz⟩ := hy
  refine ⟨s, z, ?_, ?_⟩
  · intro hs𝔭
    apply hmax.ne_top
    rw [Ideal.eq_top_iff_one]
    have h1 : (r : A) ∈ 𝔭 := by
      rw [← hs, frobenius_def]
      exact Ideal.pow_mem_of_mem 𝔭 hs𝔭 ℓ hℓ.pos
    have h2 : ((r - 1 : S) : A) ∈ 𝔭 := Ideal.mem_comap.mp hr1
    have e : (1 : A) = (r : A) - ((r - 1 : S) : A) := by push_cast; ring
    rw [e]
    exact Ideal.sub_mem _ h1 h2
  · have e : s ^ ℓ * y = r • y := by
      rw [Subring.smul_def, smul_eq_mul, ← hs, frobenius_def]
    rw [e]
    exact hz

theorem wcLlsASbf_step_unit : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (ℓ : ℕ), ℓ.Prime → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A) (c : ↥W), wcLlsPD W A 𝔭 (.disc t) → ((ℓ : ℕ) : K) = 0 → c ∈ IsLocalRing.maximalIdeal ↥W → (∀ a b : A, a * b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) → ∃ s : A, s ∉ 𝔭 ∧ (s * a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ∨ s * b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A))) → (∀ s : A, s ∉ 𝔭 → s * t ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) → (∀ b : A, (∀ s : A, s ∉ 𝔭 → s * b ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) → ∃ (k : ℕ) (u s : A), u ∉ 𝔭 ∧ s ∉ 𝔭 ∧ s * b - u * t ^ k ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) → (∀ x : A, x ≠ 0 → ∃ (d : ↥W) (u b : A), d ≠ 0 ∧ (∀ s : A, s ∉ 𝔭 → s * u ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧ (∀ s : A, s ∉ 𝔭 → s * b ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧ b * x = algebraMap ↥W A d * u) → (∀ a : A, ∃ γ : ↥W, a - algebraMap ↥W A γ ∈ 𝔭) → ∀ (F : K) (lam₂ lam' w : ↥W) (n k : ℕ) (ε₀ ε₁ g₀ g₁ : A), lam₂ ≠ 0 → IsUnit lam' → w ∈ IsLocalRing.maximalIdeal ↥W → ε₀ ∉ 𝔭 → ε₁ ∉ 𝔭 → k < n → (ℓ : ℤ) ∣ ((k : ℤ) - n) → (∀ h' : K, F - h' ^ ℓ + h' ≠ 0) → F * algebraMap A K ((t - algebraMap ↥W A c) ^ n * ε₁ + algebraMap ↥W A w * g₁) * algebraMap A K (algebraMap ↥W A lam₂) = algebraMap A K (algebraMap ↥W A (lam₂ * lam')) * algebraMap A K ((t - algebraMap ↥W A c) ^ k * ε₀ + algebraMap ↥W A w * g₀) → ∃ (h' : K) (lam₁' w' : ↥W) (n' k' : ℕ) (ε₀' ε₁' g₀' g₁' : A), lam₁' ≠ 0 ∧ w' ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀' ∉ 𝔭 ∧ ε₁' ∉ 𝔭 ∧ (F - h' ^ ℓ + h') * algebraMap A K ((t - algebraMap ↥W A c) ^ n' * ε₁' + algebraMap ↥W A w' * g₁') * algebraMap A K (algebraMap ↥W A 1) = algebraMap A K (algebraMap ↥W A lam₁') * algebraMap A K ((t - algebraMap ↥W A c) ^ k' * ε₀' + algebraMap ↥W A w' * g₀') ∧ (lam₁' ∈ IsLocalRing.maximalIdeal ↥W ∨ (lam₁' = 1 ∧ n' + k < n + k')) :=
by
  intro Ω _ _ W ℓ hℓ A _ _ _ K _ _ _ 𝔭 t c hPD hK hc H1 H2 H3 GV RL F lam₂ lam' w n k ε₀ ε₁ g₀ g₁
    hl2 hl' hw hε₀ hε₁ hkn hdiv hnz hE
  classical
  simp only [wcLlsPD] at hPD
  obtain ⟨-, hNZ, -, hmax, hmA, ht𝔭, h𝔭eq, -⟩ := hPD
  haveI := hNZ
  have h𝔭 : 𝔭.IsPrime := hmax.isPrime
  obtain ⟨U, hU⟩ : ∃ U : A, U = t - algebraMap ↥W A c := ⟨_, rfl⟩
  rw [← hU] at hE ⊢
  have hUt : t = U + algebraMap ↥W A c := by rw [hU]; ring
  obtain ⟨j, rfl⟩ : ∃ j, n = k + j := ⟨n - k, by omega⟩
  set mA := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) with hmA_def
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h => h𝔭.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have haW : ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → algebraMap ↥W A x ∈ mA :=
    fun x hx => Ideal.mem_map_of_mem _ hx
  have haWc : algebraMap ↥W A c ∈ mA := haW c hc
  have hU𝔭 : U ∈ 𝔭 := by
    rw [hU]; exact 𝔭.sub_mem ht𝔭 (hmA haWc)

  have CF1 : ∀ x : A, x ∈ mA → ∃ v : ↥W, v ∈ IsLocalRing.maximalIdeal ↥W ∧
      ∃ g : A, x = algebraMap ↥W A v * g := by
    intro x hx
    have hx' : x ∈ Submodule.span A
        (⇑(algebraMap ↥W A) '' (IsLocalRing.maximalIdeal ↥W : Set ↥W)) := hx
    clear hx
    induction hx' using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨v, hv, rfl⟩ := hy
      exact ⟨v, hv, 1, (mul_one _).symm⟩
    | zero => exact ⟨0, zero_mem _, 0, by rw [mul_zero]⟩
    | add y z _ _ ihy ihz =>
      obtain ⟨v₁, hv₁, a₁, rfl⟩ := ihy
      obtain ⟨v₂, hv₂, a₂, rfl⟩ := ihz
      rcases ValuationRing.dvd_total v₁ v₂ with ⟨q, rfl⟩ | ⟨q, rfl⟩
      · exact ⟨v₁, hv₁, a₁ + algebraMap ↥W A q * a₂, by rw [map_mul]; ring⟩
      · exact ⟨v₂, hv₂, algebraMap ↥W A q * a₁ + a₂, by rw [map_mul]; ring⟩
    | smul a y _ ihy =>
      obtain ⟨v, hv, g, rfl⟩ := ihy
      exact ⟨v, hv, a * g, by rw [smul_eq_mul]; ring⟩
  have CF : ∀ x y : A, x ∈ mA → y ∈ mA → ∃ v : ↥W, v ∈ IsLocalRing.maximalIdeal ↥W ∧
      ∃ g₁ g₂ : A, x = algebraMap ↥W A v * g₁ ∧ y = algebraMap ↥W A v * g₂ := by
    intro x y hx hy
    obtain ⟨v₁, hv₁, a₁, rfl⟩ := CF1 x hx
    obtain ⟨v₂, hv₂, a₂, rfl⟩ := CF1 y hy
    rcases ValuationRing.dvd_total v₁ v₂ with ⟨q, rfl⟩ | ⟨q, rfl⟩
    · exact ⟨v₁, hv₁, a₁, algebraMap ↥W A q * a₂, rfl, by rw [map_mul, mul_assoc]⟩
    · exact ⟨v₂, hv₂, algebraMap ↥W A q * a₁, a₂, by rw [map_mul, mul_assoc], rfl⟩

  have T4 : ∀ s : A, s ∉ 𝔭 → s * U ∉ mA := by
    intro s hs hsU
    apply H2 s hs
    rw [hUt, mul_add]
    exact mA.add_mem hsU (mA.mul_mem_left s haWc)
  have UC : ∀ (a : ℕ) (Y : A), U ^ a * Y ∈ mA → ∃ s : A, s ∉ 𝔭 ∧ s * Y ∈ mA := by
    intro a
    induction a with
    | zero => intro Y hY; exact ⟨1, h1𝔭, by simpa using hY⟩
    | succ a ih =>
      intro Y hY
      have h' : U * (U ^ a * Y) ∈ mA := by rw [← mul_assoc, ← pow_succ']; exact hY
      obtain ⟨s, hs, hor⟩ := H1 U (U ^ a * Y) h'
      rcases hor with h | h
      · exact absurd h (T4 s hs)
      · have h2 : U ^ a * (s * Y) ∈ mA := by
          have e : U ^ a * (s * Y) = s * (U ^ a * Y) := by ring
          rw [e]; exact h
        obtain ⟨s', hs', h3⟩ := ih (s * Y) h2
        exact ⟨s' * s, h𝔭.mul_notMem hs' hs, by rw [mul_assoc]; exact h3⟩

  have T9 : ∀ (a b : ℕ) (ε X : A), ε ∉ 𝔭 → U ^ a * ε - U ^ b * X ∈ mA → b ≤ a := by
    intro a b ε X hε h
    by_contra hlt
    push_neg at hlt
    obtain ⟨d, rfl⟩ : ∃ d, b = a + (d + 1) := ⟨b - a - 1, by omega⟩
    have h2 : U ^ a * (ε - U ^ (d + 1) * X) ∈ mA := by
      have e : U ^ a * (ε - U ^ (d + 1) * X) = U ^ a * ε - U ^ (a + (d + 1)) * X := by ring
      rw [e]; exact h
    obtain ⟨s, hs, h3⟩ := UC a _ h2
    have h4 : ε - U ^ (d + 1) * X ∈ 𝔭 := by
      rcases h𝔭.mem_or_mem (hmA h3) with h5 | h5
      · exact absurd h5 hs
      · exact h5
    have h5 : U ^ (d + 1) * X ∈ 𝔭 :=
      𝔭.mul_mem_right X (𝔭.pow_mem_of_mem hU𝔭 (d + 1) (Nat.succ_pos d))
    apply hε
    have e : ε = (ε - U ^ (d + 1) * X) + U ^ (d + 1) * X := by ring
    rw [e]; exact 𝔭.add_mem h4 h5

  have T7 : ∀ p : ℕ, t ^ p - U ^ p ∈ mA := by
    intro p
    obtain ⟨q, hq⟩ := sub_dvd_pow_sub_pow t U p
    rw [hq]
    have e : t - U = algebraMap ↥W A c := by rw [hUt]; ring
    rw [e]; exact mA.mul_mem_right _ haWc

  have haW0 : ∀ x : ↥W, x ≠ 0 → algebraMap ↥W A x ≠ 0 := by
    intro x hx h
    rw [Algebra.algebraMap_eq_smul_one] at h
    rcases smul_eq_zero.mp h with h' | h'
    · exact hx h'
    · exact one_ne_zero h'
  have hφ : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hφ0 : ∀ x : A, x ≠ 0 → algebraMap A K x ≠ 0 :=
    fun x hx h => hx (hφ (by rw [h, map_zero]))
  have E1 : F * algebraMap A K (U ^ (k + j) * ε₁ + algebraMap ↥W A w * g₁) =
      algebraMap A K (algebraMap ↥W A lam') *
        algebraMap A K (U ^ k * ε₀ + algebraMap ↥W A w * g₀) := by
    have hl2K := hφ0 _ (haW0 _ hl2)
    apply mul_right_cancel₀ hl2K
    rw [hE]; simp only [map_mul]; ring

  have hℓj : ℓ ∣ j := by
    have h1 : ((k : ℤ) - ((k + j : ℕ) : ℤ)) = -(j : ℤ) := by push_cast; ring
    rw [h1, dvd_neg] at hdiv
    exact Int.natCast_dvd_natCast.mp hdiv
  obtain ⟨r, hr⟩ := hℓj
  have hℓ2 := hℓ.two_le
  have hr1 : 1 ≤ r := by
    rcases Nat.eq_zero_or_pos r with h | h
    · subst h; rw [mul_zero] at hr; omega
    · exact h
  have h2r : 2 * r ≤ j := by rw [hr]; exact Nat.mul_le_mul_right r hℓ2
  obtain ⟨e, he⟩ : ∃ e, j = r + e + 1 := ⟨j - r - 1, by omega⟩

  obtain ⟨γ₀, hγ₀⟩ := RL ε₀
  obtain ⟨γ₁, hγ₁⟩ := RL ε₁
  have hγ₁u : IsUnit γ₁ := by
    by_contra hnu
    have hm : γ₁ ∈ IsLocalRing.maximalIdeal ↥W :=
      (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu)
    apply hε₁
    have e' : ε₁ = (ε₁ - algebraMap ↥W A γ₁) + algebraMap ↥W A γ₁ := by ring
    rw [e']; exact 𝔭.add_mem hγ₁ (hmA (haW _ hm))
  obtain ⟨uu, huu⟩ := hγ₁u
  obtain ⟨ν, hν⟩ : ∃ ν : ↥W, ν * γ₁ = 1 := ⟨↑uu⁻¹, by rw [← huu]; exact uu.inv_mul⟩
  obtain ⟨γ, hγ⟩ : ∃ γ : ↥W, γ * γ₁ = lam' * γ₀ :=
    ⟨lam' * γ₀ * ν, by rw [mul_assoc, hν, mul_one]⟩
  obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (γ : Ω) hℓ.pos
  have hzW : z ∈ W := by
    rcases W.mem_or_inv_mem z with h | h
    · exact h
    · by_cases hz0 : z = 0
      · rw [hz0]; exact W.zero_mem
      · obtain ⟨m, hm⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, by omega⟩
        have e' : z = (γ : Ω) * z⁻¹ ^ m := by
          rw [← hz, hm, pow_succ, mul_comm (z ^ m) z, mul_assoc, ← mul_pow,
            mul_inv_cancel₀ hz0, one_pow, mul_one]
        rw [e']
        exact mul_mem γ.2 (pow_mem h m)
  obtain ⟨c₁, hc₁⟩ : ∃ c₁ : ↥W, c₁ ^ ℓ = γ :=
    ⟨⟨z, hzW⟩, Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hz)⟩
  have hD𝔭 : algebraMap ↥W A lam' * ε₀ - algebraMap ↥W A γ * ε₁ ∈ 𝔭 := by
    have key : algebraMap ↥W A lam' * ε₀ - algebraMap ↥W A γ * ε₁ =
        algebraMap ↥W A lam' * (ε₀ - algebraMap ↥W A γ₀) -
          algebraMap ↥W A γ * (ε₁ - algebraMap ↥W A γ₁) := by
      have h0 : algebraMap ↥W A γ * algebraMap ↥W A γ₁ =
          algebraMap ↥W A lam' * algebraMap ↥W A γ₀ := by
        rw [← map_mul, ← map_mul, hγ]
      linear_combination (-1 : A) * h0
    rw [key]
    exact 𝔭.sub_mem (𝔭.mul_mem_left _ hγ₀) (𝔭.mul_mem_left _ hγ₁)
  rw [h𝔭eq, Submodule.mem_sup] at hD𝔭
  obtain ⟨y, hy, m₁, hm₁, hD⟩ := hD𝔭
  obtain ⟨a₁, rfl⟩ := Ideal.mem_span_singleton'.mp hy
  rw [hUt] at hD

  have hU0 : U ≠ 0 := by
    intro h0
    apply H2 1 h1𝔭
    rw [one_mul, hUt, h0, zero_add]; exact haWc
  have hPK : algebraMap A K U ≠ 0 := hφ0 U hU0
  obtain ⟨B, hB⟩ : ∃ B : A, B = U ^ (k + j + j) * ε₁ + algebraMap ↥W A w * (U ^ j * g₁) :=
    ⟨_, rfl⟩
  have hB0 : B ≠ 0 := by
    intro h0
    rw [hB] at h0
    have h1 : U ^ (k + j + j) * ε₁ ∈ mA := by
      have e' : U ^ (k + j + j) * ε₁ = -(algebraMap ↥W A w * (U ^ j * g₁)) :=
        eq_neg_of_add_eq_zero_left h0
      rw [e']; exact mA.neg_mem (mA.mul_mem_right _ (haW w hw))
    obtain ⟨s, hs, h2⟩ := UC _ _ h1
    rcases h𝔭.mem_or_mem (hmA h2) with h3 | h3
    · exact hs h3
    · exact hε₁ h3
  have hBeq : B = U ^ j * (U ^ (k + j) * ε₁ + algebraMap ↥W A w * g₁) := by rw [hB]; ring

  have s4 : ∀ (F' B₀' B₁' Λ Γ C P : K), P ≠ 0 → F' * B₁' = Λ * B₀' → C ^ ℓ = Γ →
      (F' - (C / P ^ r) ^ ℓ + C / P ^ r) * (P ^ j * B₁') =
        Λ * P ^ j * B₀' - Γ * B₁' + C * P ^ (e + 1) * B₁' := by
    intro F' B₀' B₁' Λ Γ C P hP hFB hCΓ
    have hEr : P ^ r ≠ 0 := pow_ne_zero r hP
    have hPj1 : P ^ j = (P ^ r) ^ ℓ := by rw [← pow_mul, hr, mul_comm]
    have hPj2 : P ^ j = P ^ r * P ^ (e + 1) := by rw [← pow_add, he, add_assoc]
    have e1 : (C / P ^ r) ^ ℓ * P ^ j = Γ := by
      rw [hPj1, ← mul_pow, div_mul_cancel₀ C hEr, hCΓ]
    have e2 : C / P ^ r * P ^ j = C * P ^ (e + 1) := by
      rw [hPj2, ← mul_assoc, div_mul_cancel₀ C hEr]
    calc (F' - (C / P ^ r) ^ ℓ + C / P ^ r) * (P ^ j * B₁')
        = (F' * B₁') * P ^ j - ((C / P ^ r) ^ ℓ * P ^ j) * B₁' +
            (C / P ^ r * P ^ j) * B₁' := by ring
      _ = Λ * P ^ j * B₀' - Γ * B₁' + C * P ^ (e + 1) * B₁' := by rw [hFB, e1, e2]; ring
  have hCΓ : algebraMap A K (algebraMap ↥W A c₁) ^ ℓ = algebraMap A K (algebraMap ↥W A γ) := by
    rw [← hc₁, map_pow, map_pow]
  obtain ⟨h', hh'⟩ : ∃ h' : K, h' = algebraMap A K (algebraMap ↥W A c₁) / algebraMap A K U ^ r :=
    ⟨_, rfl⟩
  obtain ⟨N, hN⟩ : ∃ N : A, N = algebraMap ↥W A lam' * U ^ j * (U ^ k * ε₀ + algebraMap ↥W A w * g₀) -
      algebraMap ↥W A γ * (U ^ (k + j) * ε₁ + algebraMap ↥W A w * g₁) +
      algebraMap ↥W A c₁ * U ^ (e + 1) * (U ^ (k + j) * ε₁ + algebraMap ↥W A w * g₁) := ⟨_, rfl⟩
  have hφN : algebraMap A K N = algebraMap A K (algebraMap ↥W A lam') * algebraMap A K U ^ j *
        algebraMap A K (U ^ k * ε₀ + algebraMap ↥W A w * g₀) -
      algebraMap A K (algebraMap ↥W A γ) * algebraMap A K (U ^ (k + j) * ε₁ + algebraMap ↥W A w * g₁) +
      algebraMap A K (algebraMap ↥W A c₁) * algebraMap A K U ^ (e + 1) *
        algebraMap A K (U ^ (k + j) * ε₁ + algebraMap ↥W A w * g₁) := by
    rw [hN]; simp only [map_add, map_sub, map_mul, map_pow]
  have hG : (F - h' ^ ℓ + h') * algebraMap A K B = algebraMap A K N := by
    rw [hBeq, map_mul (algebraMap A K) (U ^ j), map_pow, hh', hφN]
    exact s4 _ _ _ _ _ _ _ hPK E1 hCΓ

  obtain ⟨X, hX⟩ : ∃ X : A, X = a₁ + algebraMap ↥W A c₁ * U ^ e * ε₁ := ⟨_, rfl⟩
  obtain ⟨m₃, hm₃⟩ : ∃ m₃ : A, m₃ = U ^ (k + j) * (a₁ * algebraMap ↥W A c + m₁) +
      algebraMap ↥W A w * (algebraMap ↥W A lam' * U ^ j * g₀ - algebraMap ↥W A γ * g₁ +
        algebraMap ↥W A c₁ * U ^ (e + 1) * g₁) := ⟨_, rfl⟩
  have hN3 : N = U ^ (k + j + 1) * X + m₃ := by
    rw [hN, hX, hm₃]
    linear_combination (-(U ^ (k + j))) * hD
  have hm₃A : m₃ ∈ mA := by
    rw [hm₃]
    exact mA.add_mem (mA.mul_mem_left _ (mA.add_mem (mA.mul_mem_left _ haWc) hm₁))
      (mA.mul_mem_right _ (haW w hw))
  have hN0 : N ≠ 0 := by
    intro h0
    have h1 := hG
    rw [h0, map_zero] at h1
    rcases mul_eq_zero.mp h1 with h2 | h2
    · exact hnz h' h2
    · exact hφ0 B hB0 h2

  by_cases hNP : ∃ s : A, s ∉ 𝔭 ∧ s * N ∈ mA
  · obtain ⟨s₀, hs₀, hs₀N⟩ := hNP
    obtain ⟨d, u, b, hd0, hFUu, hFUb, hbN⟩ := GV N hN0
    obtain ⟨p, vb, sb, hvb, hsb, hb3⟩ := H3 b hFUb
    obtain ⟨q, vu, su, hvu, hsu, hu3⟩ := H3 u hFUu
    have hmb : sb * b - U ^ p * vb ∈ mA := by
      have e' : sb * b - U ^ p * vb = (sb * b - vb * t ^ p) + vb * (t ^ p - U ^ p) := by ring
      rw [e']; exact mA.add_mem hb3 (mA.mul_mem_left _ (T7 p))
    have hmu : su * u - U ^ q * vu ∈ mA := by
      have e' : su * u - U ^ q * vu = (su * u - vu * t ^ q) + vu * (t ^ q - U ^ q) := by ring
      rw [e']; exact mA.add_mem hu3 (mA.mul_mem_left _ (T7 q))
    have hdm : d ∈ IsLocalRing.maximalIdeal ↥W := by
      by_contra hdm
      have hdu : IsUnit d := by
        by_contra hnu
        exact hdm ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu))
      obtain ⟨dd, hdd⟩ := hdu
      apply hFUu s₀ hs₀
      have h1 : algebraMap ↥W A (↑dd⁻¹ : ↥W) * algebraMap ↥W A d = 1 := by
        rw [← map_mul, ← hdd, Units.inv_mul, map_one]
      have e' : s₀ * u = algebraMap ↥W A (↑dd⁻¹ : ↥W) * b * (s₀ * N) := by
        linear_combination (-(algebraMap ↥W A (↑dd⁻¹ : ↥W) * s₀)) * hbN - (s₀ * u) * h1
      rw [e']; exact mA.mul_mem_left _ hs₀N
    have hR₁ : algebraMap ↥W A w * (U ^ j * g₁ * su * (sb * b)) +
        U ^ (k + j + j) * ε₁ * su * (sb * b - U ^ p * vb) ∈ mA :=
      mA.add_mem (mA.mul_mem_right _ (haW w hw)) (mA.mul_mem_left _ hmb)
    have hR₀ : sb * (su * u - U ^ q * vu) ∈ mA := mA.mul_mem_left _ hmu
    obtain ⟨w', hw', g₁', g₀', hR1, hR0⟩ := CF _ _ hR₁ hR₀
    have eL : U ^ (k + j + j + p) * (ε₁ * su * vb) + algebraMap ↥W A w' * g₁' =
        B * (su * (sb * b)) := by rw [← hR1, hB]; ring
    have eR : U ^ q * (sb * vu) + algebraMap ↥W A w' * g₀' = sb * (su * u) := by
      rw [← hR0]; ring
    refine ⟨h', d, w', k + j + j + p, q, sb * vu, ε₁ * su * vb, g₀', g₁', hd0, hw',
      h𝔭.mul_notMem hsb hvu, h𝔭.mul_notMem (h𝔭.mul_notMem hε₁ hsu) hvb, ?_, Or.inl hdm⟩
    rw [eL, eR, map_one, map_one, mul_one]
    calc (F - h' ^ ℓ + h') * algebraMap A K (B * (su * (sb * b)))
        = ((F - h' ^ ℓ + h') * algebraMap A K B) * algebraMap A K (su * (sb * b)) := by
          rw [map_mul (algebraMap A K) B]; ring
      _ = algebraMap A K N * algebraMap A K (su * (sb * b)) := by rw [hG]
      _ = algebraMap A K (algebraMap ↥W A d) * algebraMap A K (sb * (su * u)) := by
          rw [← map_mul, ← map_mul]
          congr 1
          linear_combination (su * sb) * hbN
  · push_neg at hNP
    obtain ⟨k', u, s, hu, hs, h4⟩ := H3 N hNP
    have hm4 : s * N - u * U ^ k' ∈ mA := by
      have e' : s * N - u * U ^ k' = (s * N - u * t ^ k') + u * (t ^ k' - U ^ k') := by ring
      rw [e']; exact mA.add_mem h4 (mA.mul_mem_left _ (T7 k'))
    have hR : algebraMap ↥W A w * (s * (U ^ j * g₁)) ∈ mA := mA.mul_mem_right _ (haW w hw)
    obtain ⟨w', hw', g₁', g₀', hR1, hR0⟩ := CF _ _ hR hm4
    have eL : U ^ (k + j + j) * (s * ε₁) + algebraMap ↥W A w' * g₁' = s * B := by
      rw [← hR1, hB]; ring
    have eR : U ^ k' * u + algebraMap ↥W A w' * g₀' = s * N := by
      rw [← hR0]; ring
    have hord : k + j + 1 ≤ k' := by
      apply T9 k' (k + j + 1) u (s * X) hu
      have e' : U ^ k' * u - U ^ (k + j + 1) * (s * X) = s * m₃ - (s * N - u * U ^ k') := by
        rw [hN3]; ring
      rw [e']; exact mA.sub_mem (mA.mul_mem_left _ hm₃A) hm4
    refine ⟨h', 1, w', k + j + j, k', u, s * ε₁, g₀', g₁', one_ne_zero, hw', hu,
      h𝔭.mul_notMem hs hε₁, ?_, Or.inr ⟨rfl, by omega⟩⟩
    rw [eL, eR, map_one, map_one, mul_one, one_mul, map_mul, map_mul, ← hG]
    ring

theorem wcLlsASbf_step_pole : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (ℓ : ℕ), ℓ.Prime → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A) (c : ↥W), wcLlsPD W A 𝔭 (.disc t) → ((ℓ : ℕ) : K) = 0 → c ∈ IsLocalRing.maximalIdeal ↥W → (∀ a b : A, a * b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) → ∃ s : A, s ∉ 𝔭 ∧ (s * a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ∨ s * b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A))) → (∀ s : A, s ∉ 𝔭 → s * t ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) → (∀ b : A, (∀ s : A, s ∉ 𝔭 → s * b ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) → ∃ (k : ℕ) (u s : A), u ∉ 𝔭 ∧ s ∉ 𝔭 ∧ s * b - u * t ^ k ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) → (∀ x : A, x ≠ 0 → ∃ (d : ↥W) (u b : A), d ≠ 0 ∧ (∀ s : A, s ∉ 𝔭 → s * u ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧ (∀ s : A, s ∉ 𝔭 → s * b ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧ b * x = algebraMap ↥W A d * u) → (∀ y : A, ∃ (s : A) (z : ℕ → A), s ∉ 𝔭 ∧ s ^ ℓ * y - ∑ i ∈ Finset.range ℓ, z i ^ ℓ * t ^ i ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) → ∀ (F : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ g₀ g₁ : A), lam₁ ≠ 0 → lam₂ ≠ 0 → w ∈ IsLocalRing.maximalIdeal ↥W → ε₀ ∉ 𝔭 → ε₁ ∉ 𝔭 → F * algebraMap A K ((t - algebraMap ↥W A c) ^ n * ε₁ + algebraMap ↥W A w * g₁) * algebraMap A K (algebraMap ↥W A lam₂) = algebraMap A K (algebraMap ↥W A lam₁) * algebraMap A K ((t - algebraMap ↥W A c) ^ k * ε₀ + algebraMap ↥W A w * g₀) → ¬ lam₂ ∣ lam₁ → (∀ h' : K, F - h' ^ ℓ + h' ≠ 0) → (∀ (h' : K) (lam₁' lam₂' w' : ↥W) (n' k' : ℕ) (ε₀' ε₁' g₀' g₁' : A), lam₁' ≠ 0 → lam₂' ≠ 0 → w' ∈ IsLocalRing.maximalIdeal ↥W → ε₀' ∉ 𝔭 → ε₁' ∉ 𝔭 → (F - h' ^ ℓ + h') * algebraMap A K ((t - algebraMap ↥W A c) ^ n' * ε₁' + algebraMap ↥W A w' * g₁') * algebraMap A K (algebraMap ↥W A lam₂') = algebraMap A K (algebraMap ↥W A lam₁') * algebraMap A K ((t - algebraMap ↥W A c) ^ k' * ε₀' + algebraMap ↥W A w' * g₀') → lam₁' * lam₂ ∣ lam₁ * lam₂') → ∃ (h' : K) (lam₁' lam₂' w' : ↥W) (n' k' : ℕ) (ε₀' ε₁' g₀' g₁' : A), lam₁' ≠ 0 ∧ lam₂' ≠ 0 ∧ w' ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀' ∉ 𝔭 ∧ ε₁' ∉ 𝔭 ∧ (F - h' ^ ℓ + h') * algebraMap A K ((t - algebraMap ↥W A c) ^ n' * ε₁' + algebraMap ↥W A w' * g₁') * algebraMap A K (algebraMap ↥W A lam₂') = algebraMap A K (algebraMap ↥W A lam₁') * algebraMap A K ((t - algebraMap ↥W A c) ^ k' * ε₀' + algebraMap ↥W A w' * g₀') ∧ ¬ (ℓ : ℤ) ∣ ((k' : ℤ) - n') :=
by
  classical
  intro Ω _ _ W ℓ hℓ A _ _ _ K _ _ _ 𝔭 t c hPD hK hc H1 H2 H3 GV P F lam₁ lam₂ w n k ε₀ ε₁ g₀ g₁
    hl1 hl2 hw hε₀ hε₁ hE hndvd hnz hmax
  obtain ⟨_, hNZ, _, h𝔭max, hmA, ht𝔭, _⟩ := hPD
  haveI := hNZ
  have h𝔭 : 𝔭.IsPrime := h𝔭max.isPrime
  obtain ⟨N, rfl⟩ : ∃ N, ℓ = N + 1 := ⟨ℓ - 1, (Nat.succ_pred_eq_of_pos hℓ.pos).symm⟩
  have hN : 1 ≤ N := by have := hℓ.two_le; omega
  set mA := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) with hmAdef
  generalize hU : t - algebraMap ↥W A c = U at hE hmax ⊢
  have hcA : algebraMap ↥W A c ∈ mA := Ideal.mem_map_of_mem _ hc
  have htU : t - U ∈ mA := by rw [← hU, sub_sub_cancel]; exact hcA
  have T7 : ∀ i : ℕ, t ^ i - U ^ i ∈ mA := fun i =>
    Ideal.mem_of_dvd _ (sub_dvd_pow_sub_pow t U i) htU
  have hU𝔭 : U ∈ 𝔭 := by rw [← hU]; exact Ideal.sub_mem _ ht𝔭 (hmA hcA)
  have hne0 : ∀ a : A, a ∉ 𝔭 → a ≠ 0 := fun a ha h => ha (h ▸ 𝔭.zero_mem)
  have hpow : ∀ (a : A) (j : ℕ), a ∉ 𝔭 → a ^ j ∉ 𝔭 := fun a j ha h => ha (h𝔭.mem_of_pow_mem j h)
  have haW : ∀ v : ↥W, v ≠ 0 → algebraMap ↥W A v ≠ 0 := by
    intro v hv h
    rw [Algebra.algebraMap_eq_smul_one] at h
    rcases smul_eq_zero.mp h with h | h
    · exact hv h
    · exact one_ne_zero h
  have hφ : ∀ a : A, a ≠ 0 → algebraMap A K a ≠ 0 := fun a ha =>
    (map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr ha
  have hwA : ∀ v : ↥W, v ∈ IsLocalRing.maximalIdeal ↥W → algebraMap ↥W A v ∈ mA :=
    fun v hv => Ideal.mem_map_of_mem _ hv

  have hUnot : ∀ s : A, s ∉ 𝔭 → s * U ∉ mA := by
    intro s hs h
    apply H2 s hs
    have e : s * t = s * U + s * (t - U) := by ring
    rw [e]; exact Ideal.add_mem _ h (Ideal.mul_mem_left _ _ htU)
  have Cp : ∀ (p : ℕ) (ε : A), ε ∉ 𝔭 → ∀ s : A, s ∉ 𝔭 → s * (U ^ p * ε) ∉ mA := by
    intro p
    induction p with
    | zero =>
      intro ε hε s hs h
      rw [pow_zero, one_mul] at h
      exact h𝔭.mul_notMem hs hε (hmA h)
    | succ p ih =>
      intro ε hε s hs h
      have h' : (s * (U ^ p * ε)) * U ∈ mA := by
        have e : (s * (U ^ p * ε)) * U = s * (U ^ (p + 1) * ε) := by ring
        rw [e]; exact h
      obtain ⟨s', hs', h1 | h2⟩ := H1 _ _ h'
      · exact ih ε hε (s' * s) (h𝔭.mul_notMem hs' hs) (by rw [mul_assoc]; exact h1)
      · exact hUnot s' hs' h2
  have BN : ∀ (p : ℕ) (ε r s : A), ε ∉ 𝔭 → r ∈ mA → s ∉ 𝔭 → s * (U ^ p * ε + r) ∉ mA := by
    intro p ε r s hε hr hs h
    apply Cp p ε hε s hs
    have e : s * (U ^ p * ε) = s * (U ^ p * ε + r) - s * r := by ring
    rw [e]; exact Ideal.sub_mem _ h (Ideal.mul_mem_left _ _ hr)

  have single : ∀ x : A, x ∈ mA → ∃ (v : ↥W) (g : A), v ∈ IsLocalRing.maximalIdeal ↥W ∧
      x = algebraMap ↥W A v * g := by
    intro x hx
    have hx' : x ∈ Submodule.span A
        (algebraMap ↥W A '' (IsLocalRing.maximalIdeal ↥W : Set ↥W)) := hx
    clear hx
    induction hx' using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨v, hv, rfl⟩ := hy
      exact ⟨v, 1, hv, (mul_one _).symm⟩
    | zero => exact ⟨0, 0, Ideal.zero_mem _, (mul_zero _).symm⟩
    | add y₁ y₂ _ _ ih₁ ih₂ =>
      obtain ⟨v₁, a₁, hv₁, rfl⟩ := ih₁
      obtain ⟨v₂, a₂, hv₂, rfl⟩ := ih₂
      rcases ValuationRing.dvd_total v₁ v₂ with ⟨q, rfl⟩ | ⟨q, rfl⟩
      · exact ⟨v₁, a₁ + algebraMap ↥W A q * a₂, hv₁, by rw [map_mul]; ring⟩
      · exact ⟨v₂, algebraMap ↥W A q * a₁ + a₂, hv₂, by rw [map_mul]; ring⟩
    | smul a y _ ih =>
      obtain ⟨v, g, hv, rfl⟩ := ih
      exact ⟨v, a * g, hv, by rw [smul_eq_mul]; ring⟩
  have CF : ∀ x y : A, x ∈ mA → y ∈ mA → ∃ (v : ↥W) (a b : A),
      v ∈ IsLocalRing.maximalIdeal ↥W ∧ x = algebraMap ↥W A v * a ∧ y = algebraMap ↥W A v * b := by
    intro x y hx hy
    obtain ⟨v₁, a₁, hv₁, rfl⟩ := single x hx
    obtain ⟨v₂, a₂, hv₂, rfl⟩ := single y hy
    rcases ValuationRing.dvd_total v₁ v₂ with ⟨q, rfl⟩ | ⟨q, rfl⟩
    · exact ⟨v₁, a₁, algebraMap ↥W A q * a₂, hv₁, rfl, by rw [map_mul]; ring⟩
    · exact ⟨v₂, algebraMap ↥W A q * a₁, a₂, hv₂, by rw [map_mul]; ring, rfl⟩

  have ENF : ∀ x : A, x ≠ 0 → (∃ s : A, s ∉ 𝔭 ∧ s * x ∈ mA) →
      ∃ (δ : ↥W) (p q : ℕ) (εa εb ra rb : A), δ ≠ 0 ∧ δ ∈ IsLocalRing.maximalIdeal ↥W ∧
        εa ∉ 𝔭 ∧ εb ∉ 𝔭 ∧ ra ∈ mA ∧ rb ∈ mA ∧
        x * (U ^ p * εa + ra) = algebraMap ↥W A δ * (U ^ q * εb + rb) := by
    rintro x hx0 ⟨s0, hs0, hsx⟩
    obtain ⟨d, u, b, hd, hu, hb, hbx⟩ := GV x hx0
    obtain ⟨kb, vb, sb, hvb, hsb, hb'⟩ := H3 b hb
    obtain ⟨ku, vu, su, hvu, hsu, hu'⟩ := H3 u hu
    have hra : su * (sb * b - vb * U ^ kb) ∈ mA := by
      apply Ideal.mul_mem_left
      have e : sb * b - vb * U ^ kb = (sb * b - vb * t ^ kb) + vb * (t ^ kb - U ^ kb) := by ring
      rw [e]; exact Ideal.add_mem _ hb' (Ideal.mul_mem_left _ _ (T7 kb))
    have hrb : sb * (su * u - vu * U ^ ku) ∈ mA := by
      apply Ideal.mul_mem_left
      have e : su * u - vu * U ^ ku = (su * u - vu * t ^ ku) + vu * (t ^ ku - U ^ ku) := by ring
      rw [e]; exact Ideal.add_mem _ hu' (Ideal.mul_mem_left _ _ (T7 ku))
    have heq : x * (U ^ kb * (su * vb) + su * (sb * b - vb * U ^ kb)) =
        algebraMap ↥W A d * (U ^ ku * (sb * vu) + sb * (su * u - vu * U ^ ku)) := by
      linear_combination (su * sb) * hbx
    refine ⟨d, kb, ku, su * vb, sb * vu, su * (sb * b - vb * U ^ kb),
      sb * (su * u - vu * U ^ ku), hd, ?_, h𝔭.mul_notMem hsu hvb, h𝔭.mul_notMem hsb hvu,
      hra, hrb, heq⟩
    by_contra hdm
    have hdu : IsUnit d := IsLocalRing.notMem_maximalIdeal.mp hdm
    apply BN ku (sb * vu) (sb * (su * u - vu * U ^ ku)) s0 (h𝔭.mul_notMem hsb hvu) hrb hs0
    have key : algebraMap ↥W A (↑hdu.unit⁻¹ : ↥W) * algebraMap ↥W A d = 1 := by
      rw [← map_mul, hdu.val_inv_mul, map_one]
    have e : s0 * (U ^ ku * (sb * vu) + sb * (su * u - vu * U ^ ku)) =
        algebraMap ↥W A (↑hdu.unit⁻¹ : ↥W) *
          (U ^ kb * (su * vb) + su * (sb * b - vb * U ^ kb)) * (s0 * x) := by
      linear_combination (-(s0 * (U ^ ku * (sb * vu) + sb * (su * u - vu * U ^ ku)))) * key +
        (-(algebraMap ↥W A (↑hdu.unit⁻¹ : ↥W) * s0)) * heq
    rw [e]; exact Ideal.mul_mem_left _ _ hsx

  have hmod : ∀ j kk : ℕ, j < N → ((j + 1) + (N + 1) * kk) % (N + 1) = j + 1 := by
    intro j kk hj
    rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (by omega)]
  have ORD : ∀ z : ℕ → A, (∀ s : A, s ∉ 𝔭 →
      s * ∑ j ∈ Finset.range N, z (j + 1) ^ (N + 1) * U ^ (j + 1) ∉ mA) →
      ∃ (m : ℕ) (s ε : A), ¬ (N + 1) ∣ m ∧ s ∉ 𝔭 ∧ ε ∉ 𝔭 ∧
        s * ∑ j ∈ Finset.range N, z (j + 1) ^ (N + 1) * U ^ (j + 1) - U ^ m * ε ∈ mA := by
    intro z hz
    have hex : ∀ j : ℕ, ∃ (σ η : A) (kk : ℕ), σ ∉ 𝔭 ∧ σ * z (j + 1) - η * U ^ kk ∈ mA ∧
        (η ∉ 𝔭 ∨ η = 0) := by
      intro j
      by_cases h : ∃ s : A, s ∉ 𝔭 ∧ s * z (j + 1) ∈ mA
      · obtain ⟨s, hs, hsz⟩ := h
        exact ⟨s, 0, 0, hs, by rw [zero_mul, sub_zero]; exact hsz, Or.inr rfl⟩
      · push_neg at h
        obtain ⟨kk, u, s, hu, hs, hsu⟩ := H3 (z (j + 1)) h
        refine ⟨s, u, kk, hs, ?_, Or.inl hu⟩
        have e : s * z (j + 1) - u * U ^ kk = (s * z (j + 1) - u * t ^ kk) + u * (t ^ kk - U ^ kk) := by
          ring
        rw [e]; exact Ideal.add_mem _ hsu (Ideal.mul_mem_left _ _ (T7 kk))
    choose σ η kk hσ hσz hη using hex
    obtain ⟨e, he⟩ : ∃ e : ℕ → ℕ, ∀ j, e j = (j + 1) + (N + 1) * kk j := ⟨_, fun _ => rfl⟩
    obtain ⟨cc, hcc⟩ : ∃ cc : ℕ → A, ∀ j, cc j = ∏ j' ∈ (Finset.range N).erase j, σ j' ^ (N + 1) :=
      ⟨_, fun _ => rfl⟩
    obtain ⟨S, hSdef⟩ : ∃ S : A, S = ∏ j ∈ Finset.range N, σ j ^ (N + 1) := ⟨_, rfl⟩
    have hprod : ∀ T : Finset ℕ, ∏ j ∈ T, σ j ^ (N + 1) ∉ 𝔭 := by
      intro T h
      obtain ⟨i, _, hi⟩ := (Ideal.IsPrime.prod_mem_iff (hp := h𝔭)).mp h
      exact hσ i (h𝔭.mem_of_pow_mem _ hi)
    have hS : ∀ j ∈ Finset.range N, S = σ j ^ (N + 1) * cc j := fun j hj => by
      rw [hSdef, hcc]; exact (Finset.mul_prod_erase _ _ hj).symm
    have hterm : ∀ j ∈ Finset.range N, S * (z (j + 1) ^ (N + 1) * U ^ (j + 1)) -
        cc j * η j ^ (N + 1) * U ^ (e j) ∈ mA := by
      intro j hj
      have h1 := Ideal.mem_of_dvd _
        (sub_dvd_pow_sub_pow (σ j * z (j + 1)) (η j * U ^ (kk j)) (N + 1)) (hσz j)
      have e1 : S * (z (j + 1) ^ (N + 1) * U ^ (j + 1)) - cc j * η j ^ (N + 1) * U ^ (e j) =
          (cc j * U ^ (j + 1)) * ((σ j * z (j + 1)) ^ (N + 1) - (η j * U ^ (kk j)) ^ (N + 1)) := by
        rw [hS j hj, he j]; ring
      rw [e1]; exact Ideal.mul_mem_left _ _ h1
    have hsum : S * ∑ j ∈ Finset.range N, z (j + 1) ^ (N + 1) * U ^ (j + 1) -
        ∑ j ∈ Finset.range N, cc j * η j ^ (N + 1) * U ^ (e j) ∈ mA := by
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]; exact Ideal.sum_mem _ hterm
    have hsumI : ∑ j ∈ (Finset.range N).filter (fun j => η j ∉ 𝔭), cc j * η j ^ (N + 1) * U ^ (e j) =
        ∑ j ∈ Finset.range N, cc j * η j ^ (N + 1) * U ^ (e j) := by
      apply Finset.sum_filter_of_ne
      intro j _ hne
      rcases hη j with h | h
      · exact h
      · exfalso; apply hne; rw [h, zero_pow (Nat.succ_ne_zero N), mul_zero, zero_mul]
    have hIne : ((Finset.range N).filter (fun j => η j ∉ 𝔭)).Nonempty := by
      rw [Finset.nonempty_iff_ne_empty]
      intro hI
      apply hz S (by rw [hSdef]; exact hprod _)
      rw [← hsumI, hI, Finset.sum_empty, sub_zero] at hsum
      exact hsum
    obtain ⟨js, hjsI, hjsmin⟩ := Finset.exists_min_image _ e hIne
    have hjsR : js ∈ Finset.range N := (Finset.mem_filter.mp hjsI).1
    have hηjs : η js ∉ 𝔭 := (Finset.mem_filter.mp hjsI).2
    have hlt : ∀ j ∈ ((Finset.range N).filter (fun j => η j ∉ 𝔭)).erase js, e js < e j := by
      intro j hj
      obtain ⟨hne, hjI⟩ := Finset.mem_erase.mp hj
      have hjR := (Finset.mem_filter.mp hjI).1
      refine lt_of_le_of_ne (hjsmin j hjI) ?_
      intro heq
      apply hne
      have h1 : e js % (N + 1) = e j % (N + 1) := by rw [heq]
      rw [he js, he j, hmod _ _ (Finset.mem_range.mp hjsR), hmod _ _ (Finset.mem_range.mp hjR)] at h1
      omega
    refine ⟨e js, S, cc js * η js ^ (N + 1) + U * ∑ j ∈ ((Finset.range N).filter
      (fun j => η j ∉ 𝔭)).erase js, cc j * η j ^ (N + 1) * U ^ (e j - e js - 1), ?_,
      by rw [hSdef]; exact hprod _, ?_, ?_⟩
    · intro h
      rw [he js] at h
      have h2 := Nat.mod_eq_zero_of_dvd h
      rw [hmod _ _ (Finset.mem_range.mp hjsR)] at h2
      omega
    · intro h
      have h1 : cc js * η js ^ (N + 1) ∈ 𝔭 := by
        have e1 : cc js * η js ^ (N + 1) = (cc js * η js ^ (N + 1) + U * ∑ j ∈ ((Finset.range N).filter
            (fun j => η j ∉ 𝔭)).erase js, cc j * η j ^ (N + 1) * U ^ (e j - e js - 1)) -
            U * ∑ j ∈ ((Finset.range N).filter
            (fun j => η j ∉ 𝔭)).erase js, cc j * η j ^ (N + 1) * U ^ (e j - e js - 1) := by ring
        rw [e1]; exact Ideal.sub_mem _ h (Ideal.mul_mem_right _ _ hU𝔭)
      rcases h𝔭.mem_or_mem h1 with h2 | h2
      · rw [hcc] at h2; exact hprod _ h2
      · exact hηjs (h𝔭.mem_of_pow_mem _ h2)
    · have hfac : ∑ j ∈ Finset.range N, cc j * η j ^ (N + 1) * U ^ (e j) =
          U ^ (e js) * (cc js * η js ^ (N + 1) + U * ∑ j ∈ ((Finset.range N).filter
            (fun j => η j ∉ 𝔭)).erase js, cc j * η j ^ (N + 1) * U ^ (e j - e js - 1)) := by
        rw [← hsumI, ← Finset.add_sum_erase _ _ hjsI, mul_add, Finset.mul_sum, Finset.mul_sum]
        congr 1
        · ring
        · apply Finset.sum_congr rfl
          intro j hj
          have := hlt j hj
          have hexp : e j = e js + 1 + (e j - e js - 1) := by omega
          rw [hexp, pow_add, pow_add, pow_one]
          have hexp2 : e js + 1 + (e j - e js - 1) - e js - 1 = e j - e js - 1 := by omega
          rw [hexp2]; ring
      rw [← hfac]; exact hsum

  rcases ValuationRing.dvd_total lam₁ lam₂ with ⟨q₁, hq₁⟩ | h
  swap
  · exact absurd h hndvd
  have hq₁0 : q₁ ≠ 0 := by rintro rfl; rw [mul_zero] at hq₁; exact hl2 hq₁
  have hq₁m : q₁ ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hm
    have hu : IsUnit q₁ := IsLocalRing.notMem_maximalIdeal.mp hm
    exact hndvd ⟨↑hu.unit⁻¹, by rw [hq₁, mul_assoc, hu.mul_val_inv, mul_one]⟩

  obtain ⟨ζ, hζ⟩ := IsAlgClosed.exists_pow_nat_eq (q₁ : Ω) (Nat.succ_pos N)
  have hζ0 : ζ ≠ 0 := by
    rintro rfl
    apply hq₁0
    apply Subtype.ext
    rw [← hζ, zero_pow (Nat.succ_ne_zero N)]
    rfl
  have hζW : ζ ∈ W := by
    rcases W.mem_or_inv_mem ζ with h | h
    · exact h
    · have e : ζ = (q₁ : Ω) * ζ⁻¹ ^ N := by
        rw [← hζ, inv_pow, pow_succ, mul_comm (ζ ^ N) ζ, mul_assoc,
          mul_inv_cancel₀ (pow_ne_zero _ hζ0), mul_one]
      rw [e]; exact mul_mem q₁.2 (pow_mem h N)
  obtain ⟨μ, hμζ⟩ : ∃ μ : ↥W, (μ : Ω) = ζ := ⟨⟨ζ, hζW⟩, rfl⟩
  have hμq : μ ^ (N + 1) = q₁ := by
    apply Subtype.ext
    rw [SubmonoidClass.coe_pow, hμζ, hζ]
  have hμ0 : μ ≠ 0 := by
    rintro rfl; apply hq₁0; rw [← hμq, zero_pow (Nat.succ_ne_zero N)]
  have hμm : μ ∈ IsLocalRing.maximalIdeal ↥W :=
    (IsLocalRing.maximalIdeal.isMaximal ↥W).isPrime.mem_of_pow_mem (N + 1)
      (by rw [hμq]; exact hq₁m)
  have hlam : lam₂ = lam₁ * μ ^ (N + 1) := by rw [hμq]; exact hq₁

  obtain ⟨B₁, hB₁⟩ : ∃ B, B = U ^ n * ε₁ + algebraMap ↥W A w * g₁ := ⟨_, rfl⟩
  obtain ⟨B₀, hB₀⟩ : ∃ B, B = U ^ k * ε₀ + algebraMap ↥W A w * g₀ := ⟨_, rfl⟩
  rw [← hB₁, ← hB₀] at hE
  have E : F * algebraMap A K B₁ * algebraMap A K (algebraMap ↥W A μ) ^ (N + 1) =
      algebraMap A K B₀ := by
    apply mul_left_cancel₀ (hφ _ (haW _ hl1))
    rw [hlam] at hE
    simp only [map_mul, map_pow] at hE
    linear_combination hE

  have hB₁m : B₁ - U ^ n * ε₁ ∈ mA := by
    rw [hB₁, add_sub_cancel_left]; exact Ideal.mul_mem_right _ _ (hwA w hw)
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h => h𝔭.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have hB₁0 : B₁ ≠ 0 := by
    intro h0
    apply BN n ε₁ (algebraMap ↥W A w * g₁) 1 hε₁ (Ideal.mul_mem_right _ _ (hwA w hw)) h1𝔭
    rw [one_mul, ← hB₁, h0]; exact Ideal.zero_mem _
  obtain ⟨s, z, hs, hPz⟩ := P (B₀ * B₁ ^ N)
  obtain ⟨D, hD⟩ : ∃ D, D = algebraMap ↥W A μ * s * B₁ := ⟨_, rfl⟩
  have hDm : D ∈ mA := by
    rw [hD]; exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _ (hwA μ hμm))
  have hφD : algebraMap A K D ≠ 0 :=
    hφ _ (by rw [hD]; exact mul_ne_zero (mul_ne_zero (haW μ hμ0) (hne0 s hs)) hB₁0)
  obtain ⟨h', hh'⟩ : ∃ h' : K, h' = algebraMap A K (z 0) / algebraMap A K D := ⟨_, rfl⟩
  obtain ⟨Y, hY⟩ : ∃ Y : A, Y = s ^ (N + 1) * (B₀ * B₁ ^ N) - z 0 ^ (N + 1) + z 0 * D ^ N :=
    ⟨_, rfl⟩
  obtain ⟨Y', hY'⟩ : ∃ Y' : A, Y' = ∑ j ∈ Finset.range N, z (j + 1) ^ (N + 1) * U ^ (j + 1) :=
    ⟨_, rfl⟩
  have hR : (F - h' ^ (N + 1) + h') * algebraMap A K (s ^ (N + 1) * B₁ ^ (N + 1)) *
      algebraMap A K (algebraMap ↥W A (μ ^ (N + 1))) = algebraMap A K Y := by
    have e1 : algebraMap A K (s ^ (N + 1) * B₁ ^ (N + 1)) *
        algebraMap A K (algebraMap ↥W A (μ ^ (N + 1))) = algebraMap A K D ^ (N + 1) := by
      rw [hD]; simp only [map_mul, map_pow]; ring
    have e2 : h' * algebraMap A K D = algebraMap A K (z 0) := by
      rw [hh']; exact div_mul_cancel₀ _ hφD
    calc (F - h' ^ (N + 1) + h') * algebraMap A K (s ^ (N + 1) * B₁ ^ (N + 1)) *
          algebraMap A K (algebraMap ↥W A (μ ^ (N + 1)))
        = (F - h' ^ (N + 1) + h') * algebraMap A K D ^ (N + 1) := by rw [mul_assoc, e1]
      _ = F * algebraMap A K D ^ (N + 1) - (h' * algebraMap A K D) ^ (N + 1) +
            (h' * algebraMap A K D) * algebraMap A K D ^ N := by ring
      _ = F * algebraMap A K D ^ (N + 1) - algebraMap A K (z 0) ^ (N + 1) +
            algebraMap A K (z 0) * algebraMap A K D ^ N := by rw [e2]
      _ = algebraMap A K Y := by
        rw [hY]; simp only [map_add, map_sub, map_mul, map_pow]
        rw [hD]; simp only [map_mul]
        linear_combination (algebraMap A K s ^ (N + 1) * algebraMap A K B₁ ^ N) * E
  have hC : Y - Y' ∈ mA := by
    have hsplit : ∑ i ∈ Finset.range (N + 1), z i ^ (N + 1) * t ^ i =
        ∑ j ∈ Finset.range N, z (j + 1) ^ (N + 1) * t ^ (j + 1) + z 0 ^ (N + 1) := by
      rw [Finset.sum_range_succ', pow_zero, mul_one]
    have hdiff : ∑ j ∈ Finset.range N, z (j + 1) ^ (N + 1) * t ^ (j + 1) - Y' =
        ∑ j ∈ Finset.range N, z (j + 1) ^ (N + 1) * (t ^ (j + 1) - U ^ (j + 1)) := by
      rw [hY', ← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl (fun j _ => by ring)
    have e : Y - Y' = (s ^ (N + 1) * (B₀ * B₁ ^ N) -
        ∑ i ∈ Finset.range (N + 1), z i ^ (N + 1) * t ^ i) +
        ∑ j ∈ Finset.range N, z (j + 1) ^ (N + 1) * (t ^ (j + 1) - U ^ (j + 1)) + z 0 * D ^ N := by
      rw [hY]; linear_combination hsplit + hdiff
    rw [e]
    exact Ideal.add_mem _ (Ideal.add_mem _ hPz
      (Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_left _ _ (T7 _))))
      (Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hDm N (by omega)))
  have hsB : s ^ (N + 1) * B₁ ^ (N + 1) ≠ 0 :=
    mul_ne_zero (pow_ne_zero _ (hne0 s hs)) (pow_ne_zero _ hB₁0)
  have hY0 : Y ≠ 0 := by
    intro h0
    have h1 := hR
    rw [h0, map_zero] at h1
    exact mul_ne_zero (mul_ne_zero (hnz h') (hφ _ hsB)) (hφ _ (haW _ (pow_ne_zero _ hμ0))) h1

  have hρ : B₁ ^ (N + 1) - U ^ (n * (N + 1)) * ε₁ ^ (N + 1) ∈ mA := by
    have h2 := Ideal.mem_of_dvd _ (sub_dvd_pow_sub_pow B₁ (U ^ n * ε₁) (N + 1)) hB₁m
    rwa [mul_pow, ← pow_mul] at h2

  by_cases hYP : ∃ s₃ : A, s₃ ∉ 𝔭 ∧ s₃ * Y ∈ mA
  · exfalso
    obtain ⟨δ, p, q, εa, εb, ra, rb, hδ0, hδm, hεa, hεb, hra, hrb, hYeq⟩ := ENF Y hY0 hYP
    have hr₁ : s ^ (N + 1) * (U ^ (n * (N + 1)) * ε₁ ^ (N + 1) * ra +
        (B₁ ^ (N + 1) - U ^ (n * (N + 1)) * ε₁ ^ (N + 1)) * (U ^ p * εa + ra)) ∈ mA :=
      Ideal.mul_mem_left _ _ (Ideal.add_mem _ (Ideal.mul_mem_left _ _ hra)
        (Ideal.mul_mem_right _ _ hρ))
    obtain ⟨w', g₁', g₀', hw', hg₁', hg₀'⟩ := CF _ _ hr₁ hrb
    have hId : s ^ (N + 1) * B₁ ^ (N + 1) * (U ^ p * εa + ra) =
        U ^ (n * (N + 1) + p) * (s ^ (N + 1) * ε₁ ^ (N + 1) * εa) +
        s ^ (N + 1) * (U ^ (n * (N + 1)) * ε₁ ^ (N + 1) * ra +
        (B₁ ^ (N + 1) - U ^ (n * (N + 1)) * ε₁ ^ (N + 1)) * (U ^ p * εa + ra)) := by
      rw [pow_add]; ring
    have hε' : s ^ (N + 1) * ε₁ ^ (N + 1) * εa ∉ 𝔭 :=
      h𝔭.mul_notMem (h𝔭.mul_notMem (hpow s _ hs) (hpow ε₁ _ hε₁)) hεa
    have hYeqK : algebraMap A K Y * algebraMap A K (U ^ p * εa + ra) =
        algebraMap A K (algebraMap ↥W A δ) * algebraMap A K (U ^ q * εb + rb) := by
      have h1 := congrArg (algebraMap A K) hYeq
      rwa [map_mul, map_mul] at h1
    have EQ : (F - h' ^ (N + 1) + h') *
        algebraMap A K (U ^ (n * (N + 1) + p) * (s ^ (N + 1) * ε₁ ^ (N + 1) * εa) +
          algebraMap ↥W A w' * g₁') * algebraMap A K (algebraMap ↥W A (μ ^ (N + 1))) =
        algebraMap A K (algebraMap ↥W A δ) *
          algebraMap A K (U ^ q * εb + algebraMap ↥W A w' * g₀') := by
      rw [← hg₁', ← hg₀', ← hId,
        map_mul (algebraMap A K) (s ^ (N + 1) * B₁ ^ (N + 1)) (U ^ p * εa + ra)]
      linear_combination (algebraMap A K (U ^ p * εa + ra)) * hR + hYeqK
    have hdv := hmax h' δ (μ ^ (N + 1)) w' (n * (N + 1) + p) q εb
      (s ^ (N + 1) * ε₁ ^ (N + 1) * εa) g₀' g₁' hδ0 (pow_ne_zero _ hμ0) hw' hεb hε' EQ
    rw [hlam] at hdv
    have h1 : δ * (lam₁ * μ ^ (N + 1)) ∣ 1 * (lam₁ * μ ^ (N + 1)) := by rw [one_mul]; exact hdv
    have h2 : δ ∣ 1 := (mul_dvd_mul_iff_right (mul_ne_zero hl1 (pow_ne_zero _ hμ0))).mp h1
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal δ).mp hδm)) (isUnit_of_dvd_one h2)
  · push_neg at hYP
    have hY'P : ∀ s' : A, s' ∉ 𝔭 → s' * Y' ∉ mA := by
      intro s' hs' h
      apply hYP s' hs'
      have e : s' * Y = s' * Y' + s' * (Y - Y') := by ring
      rw [e]; exact Ideal.add_mem _ h (Ideal.mul_mem_left _ _ hC)
    rw [hY'] at hY'P
    obtain ⟨m, s₂, ε, hm, hs₂, hε, hr⟩ := ORD z hY'P
    rw [← hY'] at hr
    have hr₀ : s₂ * Y - U ^ m * ε ∈ mA := by
      have e : s₂ * Y - U ^ m * ε = (s₂ * Y' - U ^ m * ε) + s₂ * (Y - Y') := by ring
      rw [e]; exact Ideal.add_mem _ hr (Ideal.mul_mem_left _ _ hC)
    have hρ' : s₂ * s ^ (N + 1) * (B₁ ^ (N + 1) - U ^ (n * (N + 1)) * ε₁ ^ (N + 1)) ∈ mA :=
      Ideal.mul_mem_left _ _ hρ
    obtain ⟨w', g₁', g₀', hw', hg₁', hg₀'⟩ := CF _ _ hρ' hr₀
    have hε' : s₂ * s ^ (N + 1) * ε₁ ^ (N + 1) ∉ 𝔭 :=
      h𝔭.mul_notMem (h𝔭.mul_notMem hs₂ (hpow s _ hs)) (hpow ε₁ _ hε₁)
    refine ⟨h', 1, μ ^ (N + 1), w', n * (N + 1), m, ε, s₂ * s ^ (N + 1) * ε₁ ^ (N + 1), g₀', g₁',
      one_ne_zero, pow_ne_zero _ hμ0, hw', hε, hε', ?_, ?_⟩
    · rw [← hg₁', ← hg₀']
      have e1 : U ^ (n * (N + 1)) * (s₂ * s ^ (N + 1) * ε₁ ^ (N + 1)) +
          s₂ * s ^ (N + 1) * (B₁ ^ (N + 1) - U ^ (n * (N + 1)) * ε₁ ^ (N + 1)) =
          s₂ * (s ^ (N + 1) * B₁ ^ (N + 1)) := by ring
      have e2 : U ^ m * ε + (s₂ * Y - U ^ m * ε) = s₂ * Y := by ring
      rw [e1, e2, map_one, map_one, one_mul, map_mul (algebraMap A K) s₂,
        map_mul (algebraMap A K) s₂, ← hR]
      ring
    · intro h
      apply hm
      have h2 : ((N + 1 : ℕ) : ℤ) ∣ ((m : ℕ) : ℤ) := by
        have h3 := dvd_add h (dvd_mul_left ((N + 1 : ℕ) : ℤ) (n : ℤ))
        have e : (m : ℤ) - ((n * (N + 1) : ℕ) : ℤ) + (n : ℤ) * ((N + 1 : ℕ) : ℤ) = (m : ℤ) := by
          push_cast; ring
        rwa [e] at h3
      exact Int.natCast_dvd_natCast.mp h2

theorem wcLlsASbf_refine : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ((ℓ : ℕ) : K) = 0 → ∀ (α : L) (f : K), α ∉ Set.range (algebraMap K L) → α ^ ℓ - α = algebraMap K L f → ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → ∀ (h₀ : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ g₀ g₁ : A), lam₁ ≠ 0 → lam₂ ≠ 0 → w ∈ IsLocalRing.maximalIdeal ↥W → ε₀ ∉ 𝔭 → ε₁ ∉ 𝔭 → (f - h₀ ^ ℓ + h₀) * algebraMap A K ((t - algebraMap ↥W A c) ^ n * ε₁ + algebraMap ↥W A w * g₁) * algebraMap A K (algebraMap ↥W A lam₂) = algebraMap A K (algebraMap ↥W A lam₁) * algebraMap A K ((t - algebraMap ↥W A c) ^ k * ε₀ + algebraMap ↥W A w * g₀) → (lam₂ ∣ lam₁ ∨ ∀ (h' : K) (lam₁' lam₂' w' : ↥W) (n' k' : ℕ) (ε₀' ε₁' g₀' g₁' : A), lam₁' ≠ 0 → lam₂' ≠ 0 → w' ∈ IsLocalRing.maximalIdeal ↥W → ε₀' ∉ 𝔭 → ε₁' ∉ 𝔭 → (f - h₀ ^ ℓ + h₀ - h' ^ ℓ + h') * algebraMap A K ((t - algebraMap ↥W A c) ^ n' * ε₁' + algebraMap ↥W A w' * g₁') * algebraMap A K (algebraMap ↥W A lam₂') = algebraMap A K (algebraMap ↥W A lam₁') * algebraMap A K ((t - algebraMap ↥W A c) ^ k' * ε₀' + algebraMap ↥W A w' * g₀') → lam₁' * lam₂ ∣ lam₁ * lam₂') → ∃ (h : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ g₀ g₁ : A), lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀ ∉ 𝔭 ∧ ε₁ ∉ 𝔭 ∧ (f - h ^ ℓ + h) * algebraMap A K ((t - algebraMap ↥W A c) ^ n * ε₁ + algebraMap ↥W A w * g₁) * algebraMap A K (algebraMap ↥W A lam₂) = algebraMap A K (algebraMap ↥W A lam₁) * algebraMap A K ((t - algebraMap ↥W A c) ^ k * ε₀ + algebraMap ↥W A w * g₀) ∧ ((lam₂ ∣ lam₁ ∧ (n ≤ k ∨ ∃ lam' : ↥W, lam₁ = lam₂ * lam' ∧ lam' ∈ IsLocalRing.maximalIdeal ↥W)) ∨ ¬ (ℓ : ℤ) ∣ ((k : ℤ) - n)) :=
by
  intro Ω _ _ W hdim hWtop ℓ hℓ A _ _ _ K _ _ _ L _ _ 𝔭 t hPD hK α f hα hf c hc h₀ lam₁ lam₂ w n k
    ε₀ ε₁ g₀ g₁ hlam₁ hlam₂ hw hε₀ hε₁ hEQ hmax
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI hcK : CharP K ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hK
  haveI hcL : CharP L ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr
    (by rw [← map_natCast (algebraMap K L), hK, map_zero])

  have hnz : ∀ h : K, f - h ^ ℓ + h ≠ 0 := by
    intro h hzero
    apply hα
    have hβ : (α - algebraMap K L h) ^ ℓ = α - algebraMap K L h := by
      have hfh : f = h ^ ℓ - h := by linear_combination hzero
      have h1 : α ^ ℓ = α + algebraMap K L f := by linear_combination hf
      rw [sub_pow_char, h1, hfh, map_sub, map_pow]
      ring
    obtain ⟨i, hi⟩ : ∃ i : ℕ, α - algebraMap K L h = (i : L) := by
      by_contra hne
      push_neg at hne
      have hp0 : (Polynomial.X ^ ℓ - Polynomial.X : Polynomial L) ≠ 0 :=
        FiniteField.X_pow_card_sub_X_ne_zero L hℓ.one_lt
      have hroot : ∀ x : L, x ^ ℓ = x →
          x ∈ (Polynomial.X ^ ℓ - Polynomial.X : Polynomial L).roots := by
        intro x hx
        rw [Polynomial.mem_roots hp0]
        simp [Polynomial.IsRoot, hx]
      have hcast : ∀ i : ℕ, ((i : L)) ^ ℓ = (i : L) := by
        intro i
        have h2 := congrArg (ZMod.castHom (dvd_refl ℓ) L) (ZMod.pow_card (p := ℓ) (i : ZMod ℓ))
        rw [map_pow, map_natCast] at h2
        exact h2
      have hScard : ((Finset.range ℓ).image (fun i : ℕ => (i : L))).card = ℓ := by
        rw [Finset.card_image_of_injOn, Finset.card_range]
        intro a ha b hb hab
        simp only [Finset.coe_range, Set.mem_Iio] at ha hb
        have h3 := (CharP.natCast_eq_natCast L ℓ).mp hab
        simpa [Nat.ModEq, Nat.mod_eq_of_lt ha, Nat.mod_eq_of_lt hb] using h3
      have hβS : α - algebraMap K L h ∉ (Finset.range ℓ).image (fun i : ℕ => (i : L)) := by
        intro hm
        obtain ⟨i, -, hi⟩ := Finset.mem_image.mp hm
        exact hne i hi.symm
      have hsub : insert (α - algebraMap K L h) ((Finset.range ℓ).image (fun i : ℕ => (i : L))) ⊆
          (Polynomial.X ^ ℓ - Polynomial.X : Polynomial L).roots.toFinset := by
        intro x hx
        rw [Multiset.mem_toFinset]
        rcases Finset.mem_insert.mp hx with hx | hx
        · rw [hx]; exact hroot _ hβ
        · obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hx
          exact hroot _ (hcast i)
      have h4 := Finset.card_le_card hsub
      rw [Finset.card_insert_of_notMem hβS, hScard] at h4
      have h5 := (Multiset.toFinset_card_le
        (Polynomial.X ^ ℓ - Polynomial.X : Polynomial L).roots).trans
        (Polynomial.card_roots' (Polynomial.X ^ ℓ - Polynomial.X : Polynomial L))
      rw [FiniteField.X_pow_card_sub_X_natDegree_eq L hℓ.one_lt] at h5
      omega
    refine ⟨h + (i : K), ?_⟩
    rw [map_add, map_natCast, ← hi]
    ring

  have hID : ∀ h h' : K, f - h ^ ℓ + h - h' ^ ℓ + h' = f - (h + h') ^ ℓ + (h + h') := by
    intro h h'
    rw [add_pow_char]
    ring
  have hnz' : ∀ h h' : K, f - h ^ ℓ + h - h' ^ ℓ + h' ≠ 0 := fun h h' => by
    rw [hID]; exact hnz _

  obtain ⟨H1, H2, H3⟩ := wcpa_dj_llsm_kpdf_special_fibre_dvr Ω W hdim hWtop A 𝔭 t hPD
  have GV := wcpa_dj_llsm_kpdf_generic_valuation Ω W hdim hWtop A 𝔭 t hPD H1 H2
  have RL := wcLlsASb_residue_lift Ω W A 𝔭 hPD.1 hPD.2.2.2.1 hPD.2.2.2.2.1
  have hP := wcLlsASbf_frob_span Ω W hdim hWtop ℓ hℓ A K 𝔭 t hPD hK

  have Q : ∀ d : ℕ, ∀ (h : K) (lam₂ lam' w : ↥W) (n k : ℕ) (ε₀ ε₁ g₀ g₁ : A), n - k = d →
      lam₂ ≠ 0 → lam' ≠ 0 → w ∈ IsLocalRing.maximalIdeal ↥W → ε₀ ∉ 𝔭 → ε₁ ∉ 𝔭 →
      (f - h ^ ℓ + h) * algebraMap A K ((t - algebraMap ↥W A c) ^ n * ε₁ + algebraMap ↥W A w * g₁) *
          algebraMap A K (algebraMap ↥W A lam₂) =
        algebraMap A K (algebraMap ↥W A (lam₂ * lam')) *
          algebraMap A K ((t - algebraMap ↥W A c) ^ k * ε₀ + algebraMap ↥W A w * g₀) →
      ∃ (h : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ g₀ g₁ : A), lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧
        w ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀ ∉ 𝔭 ∧ ε₁ ∉ 𝔭 ∧
        (f - h ^ ℓ + h) * algebraMap A K ((t - algebraMap ↥W A c) ^ n * ε₁ + algebraMap ↥W A w * g₁) *
            algebraMap A K (algebraMap ↥W A lam₂) =
          algebraMap A K (algebraMap ↥W A lam₁) *
            algebraMap A K ((t - algebraMap ↥W A c) ^ k * ε₀ + algebraMap ↥W A w * g₀) ∧
        ((lam₂ ∣ lam₁ ∧ (n ≤ k ∨ ∃ lam' : ↥W, lam₁ = lam₂ * lam' ∧
          lam' ∈ IsLocalRing.maximalIdeal ↥W)) ∨ ¬ (ℓ : ℤ) ∣ ((k : ℤ) - n)) := by
    intro d
    induction d using Nat.strong_induction_on with
    | _ d ih =>
      intro h lam₂ lam' w n k ε₀ ε₁ g₀ g₁ hd hl2 hl' hw hε₀ hε₁ hE
      by_cases hnk : n ≤ k
      · exact ⟨h, lam₂ * lam', lam₂, w, n, k, ε₀, ε₁, g₀, g₁, mul_ne_zero hl2 hl', hl2, hw, hε₀,
          hε₁, hE, Or.inl ⟨⟨lam', rfl⟩, Or.inl hnk⟩⟩
      by_cases hm : lam' ∈ IsLocalRing.maximalIdeal ↥W
      · exact ⟨h, lam₂ * lam', lam₂, w, n, k, ε₀, ε₁, g₀, g₁, mul_ne_zero hl2 hl', hl2, hw, hε₀,
          hε₁, hE, Or.inl ⟨⟨lam', rfl⟩, Or.inr ⟨lam', rfl, hm⟩⟩⟩
      by_cases hdiv : (ℓ : ℤ) ∣ ((k : ℤ) - n)
      swap
      · exact ⟨h, lam₂ * lam', lam₂, w, n, k, ε₀, ε₁, g₀, g₁, mul_ne_zero hl2 hl', hl2, hw, hε₀,
          hε₁, hE, Or.inr hdiv⟩
      have hu : IsUnit lam' := by
        by_contra hnu
        exact hm ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu))
      obtain ⟨h', l1, w', n', k', e0', e1', g0', g1', hl1, hw', he0', he1', hE', hcase⟩ :=
        wcLlsASbf_step_unit Ω W ℓ hℓ A K 𝔭 t c hPD hK hc H1 H2 H3 GV RL (f - h ^ ℓ + h) lam₂ lam' w
          n k ε₀ ε₁ g₀ g₁ hl2 hu hw hε₀ hε₁ (by omega) hdiv (hnz' h) hE
      rw [hID] at hE'
      rcases hcase with hl1m | ⟨rfl, hlt⟩
      · exact ⟨h + h', l1, 1, w', n', k', e0', e1', g0', g1', hl1, one_ne_zero, hw', he0', he1', hE',
          Or.inl ⟨⟨l1, (one_mul _).symm⟩, Or.inr ⟨l1, (one_mul _).symm, hl1m⟩⟩⟩
      · exact ih (n' - k') (by omega) (h + h') 1 1 w' n' k' e0' e1' g0' g1' rfl one_ne_zero
          one_ne_zero hw' he0' he1' (by rw [mul_one]; exact hE')
  by_cases hdv : lam₂ ∣ lam₁
  · obtain ⟨lam', rfl⟩ := hdv
    exact Q (n - k) h₀ lam₂ lam' w n k ε₀ ε₁ g₀ g₁ rfl hlam₂
      (by rintro rfl; exact hlam₁ (mul_zero _)) hw hε₀ hε₁ hEQ
  · obtain ⟨h', l1, l2, w', n', k', e0', e1', g0', g1', hl1, hl2, hw', he0', he1', hE', hnd⟩ :=
      wcLlsASbf_step_pole Ω W ℓ hℓ A K 𝔭 t c hPD hK hc H1 H2 H3 GV hP (f - h₀ ^ ℓ + h₀) lam₁ lam₂
        w n k ε₀ ε₁ g₀ g₁ hlam₁ hlam₂ hw hε₀ hε₁ hEQ hdv (hnz' h₀) (hmax.resolve_left hdv)
    rw [hID] at hE'
    exact ⟨h₀ + h', l1, l2, w', n', k', e0', e1', g0', g1', hl1, hl2, hw', he0', he1', hE',
      Or.inr hnd⟩

theorem wcLlsAS_dse_boundary_form : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u)
    [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L]
    (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ((ℓ : ℕ) : K) = 0 →
    ∀ (α : L) (f : K), α ∉ Set.range (algebraMap K L) → α ^ ℓ - α = algebraMap K L f →
    ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W →
    algebraMap A K (t - algebraMap ↥W A c) ≠ 0 ∧
    ∃ (h : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ g₀ g₁ : A),
      lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀ ∉ 𝔭 ∧ ε₁ ∉ 𝔭 ∧
      (f - h ^ ℓ + h) * algebraMap A K ((t - algebraMap ↥W A c) ^ n * ε₁ + algebraMap ↥W A w * g₁) *
          algebraMap A K (algebraMap ↥W A lam₂) =
        algebraMap A K (algebraMap ↥W A lam₁) *
          algebraMap A K ((t - algebraMap ↥W A c) ^ k * ε₀ + algebraMap ↥W A w * g₀) ∧
      ((lam₂ ∣ lam₁ ∧ (n ≤ k ∨ ∃ lam' : ↥W, lam₁ = lam₂ * lam' ∧
          lam' ∈ IsLocalRing.maximalIdeal ↥W)) ∨ ¬ (ℓ : ℤ) ∣ ((k : ℤ) - n)) :=
by
  intro Ω _ _ W hdim hWtop ℓ hℓ A _ _ _ K _ _ _ L _ _ 𝔭 t hPD hK α f hα hf c hc
  classical

  have hu : algebraMap A K (t - algebraMap ↥W A c) ≠ 0 := by
    intro h0
    have ht : t - algebraMap ↥W A c = 0 :=
      (IsFractionRing.injective A K) (h0.trans (map_zero _).symm)
    obtain ⟨-, -, -, -, -, -, -, hh, hh𝔭, fch, hfC, hfX, hfet⟩ := hPD
    have hh0 : hh ≠ 0 := by
      rintro rfl
      exact hh𝔭 (Ideal.zero_mem 𝔭)
    letI : Algebra (Polynomial ↥W) (Localization.Away hh) := fch.toAlgebra
    haveI : Algebra.Etale (Polynomial ↥W) (Localization.Away hh) := hfet
    haveI : Module.Flat (Polynomial ↥W) (Localization.Away hh) := inferInstance
    have hreg0 : IsSMulRegular (Polynomial ↥W) (Polynomial.X - Polynomial.C c) := by
      intro p q hpq
      exact (Polynomial.monic_X_sub_C c).isRegular.left hpq
    have hreg := IsSMulRegular.of_flat (S := Localization.Away hh) hreg0
    have hmap : algebraMap (Polynomial ↥W) (Localization.Away hh)
        (Polynomial.X - Polynomial.C c) = 0 := by
      show fch (Polynomial.X - Polynomial.C c) = 0
      have hC : fch (Polynomial.C c) =
          algebraMap A (Localization.Away hh) (algebraMap ↥W A c) := by
        have := congrArg (fun φ => φ c) hfC
        simpa using this
      rw [map_sub, hfX, hC, ← map_sub, ht, map_zero]
    rw [hmap] at hreg
    have h10 : (1 : Localization.Away hh) = 0 := by
      apply hreg
      simp
    have hinj := IsLocalization.injective (Localization.Away hh)
      (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
    exact one_ne_zero (hinj (by rw [map_one, map_zero]; exact h10))
  refine ⟨hu, ?_⟩

  obtain ⟨h₀, lam₁, lam₂, w, n, k, ε₀, ε₁, g₀, g₁, h1, h2, h3, h4, h5, hEQ, hmax⟩ :=
    wcLlsASbf_best_approx Ω W hdim hWtop ℓ hℓ A K L 𝔭 t hPD hK α f hα hf c hc

  exact wcLlsASbf_refine Ω W hdim hWtop ℓ hℓ A K L 𝔭 t hPD hK α f hα hf c hc h₀ lam₁ lam₂ w n k
    ε₀ ε₁ g₀ g₁ h1 h2 h3 h4 h5 hEQ hmax

theorem wcLlsAS_disc_sep_exists : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y →
    wcLlsBR W A K L 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ α : L, α ∉ Set.range (algebraMap K L) → α ^ ℓ - α ∈ Set.range (algebraMap K L) →
    ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W →
    ∃ e : ↥W, e ∈ IsLocalRing.maximalIdeal ↥W ∧ e ≠ 0 ∧ wcLlsDiscSep W A K L t c e :=
by
  intro Ω _ _ W hdim hWtop ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD _ _ _ hfin α hα hα2
    c hc
  classical
  obtain ⟨f, hf⟩ := hα2

  have hK : ((ℓ : ℕ) : K) = 0 := by
    have h1 : ((ℓ : ℕ) : Ω) = 0 := by rw [← hchar]; exact ringChar.Nat.cast_ringChar
    have h2 : ((ℓ : ℕ) : ↥W) = 0 := by
      apply Subtype.ext
      first
        | simpa using h1
        | exact h1
        | exact (map_natCast W.subtype ℓ).trans h1
    rw [← map_natCast (algebraMap A K), ← map_natCast (algebraMap ↥W A), h2, map_zero, map_zero]

  have hinj : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
    intro x hx h0
    have h1 : algebraMap ↥W A x = 0 :=
      (IsFractionRing.injective A K) (h0.trans (map_zero _).symm)
    have h2 : x • (1 : A) = 0 := by rw [Algebra.smul_def, mul_one]; exact h1
    haveI := hPD.2.1
    exact hx ((smul_eq_zero.mp h2).resolve_right one_ne_zero)

  obtain ⟨hu, h, lam₁, lam₂, w, n, k, ε₀, ε₁, g₀, g₁, hlam₁, hlam₂, hw, hε₀, hε₁, hEQ, hD⟩ :=
    wcLlsAS_dse_boundary_form Ω W hdim hWtop ℓ hℓ A K L 𝔭 t hPD hK α f hα hf.symm c hc

  obtain ⟨x, hx⟩ : ∃ x : Ω, x ∉ W := by
    by_contra hcon
    push_neg at hcon
    apply hWtop
    first
      | exact top_unique fun y _ => hcon y
      | (ext y; simp [hcon y])
  have hx0 : x ≠ 0 := fun h0 => hx (h0 ▸ W.zero_mem)
  have hxinv : x⁻¹ ∈ W := (W.mem_or_inv_mem x).resolve_left hx
  obtain ⟨z₀, hz₀⟩ : ∃ z₀ : ↥W, (z₀ : Ω) = x⁻¹ := ⟨⟨x⁻¹, hxinv⟩, rfl⟩
  have hz₀0 : z₀ ≠ 0 := by
    rintro rfl
    apply hx0
    have : (x⁻¹ : Ω) = 0 := by rw [← hz₀]; rfl
    exact inv_eq_zero.mp this
  have hz₀m : z₀ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hunit
    obtain ⟨v, hv⟩ := hunit.exists_right_inv
    apply hx
    have h1 : (z₀ : Ω) * (v : Ω) = 1 := by
      have := congrArg Subtype.val hv
      first
        | exact this
        | simpa using this
    rw [hz₀] at h1
    have h2 : x = (v : Ω) := by
      calc x = x * (x⁻¹ * (v : Ω)) := by rw [h1, mul_one]
        _ = (v : Ω) := by rw [← mul_assoc, mul_inv_cancel₀ hx0, one_mul]
    rw [h2]
    exact v.2

  have rootW : ∀ N : ℕ, 0 < N → ∀ z : ↥W, ∃ r : ↥W, r ^ N = z := by
    intro N hN z
    obtain ⟨r, hr⟩ := IsAlgClosed.exists_pow_nat_eq (z : Ω) hN
    by_cases hrW : r ∈ W
    · refine ⟨⟨r, hrW⟩, Subtype.ext ?_⟩
      first
        | simpa using hr
        | exact hr
    · exfalso
      have hr0 : r ≠ 0 := fun h0 => hrW (h0 ▸ W.zero_mem)
      have hrinv : r⁻¹ ∈ W := (W.mem_or_inv_mem r).resolve_left hrW
      obtain ⟨N', rfl⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by omega⟩
      have h1 : r = (z : Ω) * r⁻¹ ^ N' := by
        rw [← hr, inv_pow, pow_succ, mul_assoc, mul_comm r, ← mul_assoc,
          mul_inv_cancel₀ (pow_ne_zero _ hr0), one_mul]
      apply hrW
      rw [h1]
      exact mul_mem z.2 (pow_mem hrinv N')

  have hdivm : ∀ x' : ↥W, x' ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ z ∈ IsLocalRing.maximalIdeal ↥W, z ≠ 0 ∧ z ∣ x' := by
    intro x' hx'
    by_cases h0 : x' = 0
    · refine ⟨z₀, hz₀m, hz₀0, ?_⟩
      rw [h0]; exact dvd_zero z₀
    · exact ⟨x', hx', h0, dvd_rfl⟩
  have hpick : ∀ N : ℕ, 0 < N → ∀ x₁ x₂ : ↥W, x₁ ∈ IsLocalRing.maximalIdeal ↥W →
      x₂ ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ e : ↥W, e ∈ IsLocalRing.maximalIdeal ↥W ∧ e ≠ 0 ∧ e ^ N ∣ x₁ ∧ e ^ N ∣ x₂ := by
    intro N hN x₁ x₂ h₁ h₂
    obtain ⟨z₁, hz₁m, hz₁0, hz₁⟩ := hdivm x₁ h₁
    obtain ⟨z₂, hz₂m, hz₂0, hz₂⟩ := hdivm x₂ h₂
    obtain ⟨z, hzm, hz0, hzx₁, hzx₂⟩ : ∃ z ∈ IsLocalRing.maximalIdeal ↥W,
        z ≠ 0 ∧ z ∣ x₁ ∧ z ∣ x₂ := by
      rcases ValuationRing.dvd_total z₁ z₂ with hd | hd
      · exact ⟨z₁, hz₁m, hz₁0, hz₁, hd.trans hz₂⟩
      · exact ⟨z₂, hz₂m, hz₂0, hd.trans hz₁, hz₂⟩
    obtain ⟨e, he⟩ := rootW N hN z
    refine ⟨e, ?_, ?_, ?_, ?_⟩
    · apply (IsLocalRing.maximalIdeal.isMaximal ↥W).isPrime.mem_of_pow_mem N
      rw [he]; exact hzm
    · rintro rfl
      apply hz0
      rw [← he, zero_pow hN.ne']
    · rw [he]; exact hzx₁
    · rw [he]; exact hzx₂

  have hchart : ∀ e : ↥W, e ∈ IsLocalRing.maximalIdeal ↥W → ∀ s : K,
      s = algebraMap A K (algebraMap ↥W A e) / algebraMap A K (t - algebraMap ↥W A c) →
      ∀ j : ℕ, e ^ j ∣ w → ∀ ε g : A, ∃ P : ↥(Algebra.adjoin A {s}),
        P - algebraMap A ↥(Algebra.adjoin A {s}) ε ∈
          Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c),
            ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
          (IsLocalRing.maximalIdeal ↥W).map
            ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) ∧
        algebraMap A K ((t - algebraMap ↥W A c) ^ j * ε + algebraMap ↥W A w * g) =
          algebraMap A K (t - algebraMap ↥W A c) ^ j * (P : K) := by
    intro e _ s hs j hj ε g
    obtain ⟨w', hw'⟩ := hj
    have hUs : algebraMap A K (t - algebraMap ↥W A c) * s = algebraMap A K (algebraMap ↥W A e) := by
      rw [hs]; field_simp
    refine ⟨algebraMap A _ ε + ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ ^ j *
      algebraMap A _ (algebraMap ↥W A w' * g), ?_, ?_⟩
    · rw [add_sub_cancel_left]
      rcases j with _ | j
      · apply Ideal.mem_sup_right
        rw [pow_zero, one_mul, map_mul]
        apply Ideal.mul_mem_right
        have hw'm : w' ∈ IsLocalRing.maximalIdeal ↥W := by
          rw [pow_zero, one_mul] at hw'; rw [← hw']; exact hw
        exact Ideal.mem_map_of_mem ((algebraMap A ↥(Algebra.adjoin A {s})).comp
          (algebraMap ↥W A)) hw'm
      · apply Ideal.mem_sup_left
        rw [pow_succ]
        apply Ideal.mul_mem_right
        apply Ideal.mul_mem_left
        exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
    · have hE : algebraMap A K (algebraMap ↥W A e) ^ j =
          algebraMap A K (t - algebraMap ↥W A c) ^ j * s ^ j := by
        rw [← hUs, mul_pow]
      rw [hw']
      simp only [map_add, map_mul, map_pow, Subalgebra.coe_add, Subalgebra.coe_mul,
        Subalgebra.coe_pow, Subalgebra.coe_algebraMap]
      linear_combination (algebraMap A K (algebraMap ↥W A w') * algebraMap A K g) * hE

  by_cases hE : lam₂ ∣ lam₁ ∧ (n ≤ k ∨ ∃ lam' : ↥W, lam₁ = lam₂ * lam' ∧
      lam' ∈ IsLocalRing.maximalIdeal ↥W)
  · obtain ⟨⟨lam', hlam'⟩, hnk⟩ := hE
    rcases le_or_gt n k with hnk' | hnk'
    ·
      obtain ⟨d, rfl⟩ : ∃ d, k = n + d := ⟨k - n, by omega⟩
      obtain ⟨e, he, he0, hew, -⟩ := hpick (n + (n + d) + 1) (by omega) w 0 hw
        (IsLocalRing.maximalIdeal ↥W).zero_mem
      refine ⟨e, he, he0, ?_⟩
      obtain ⟨s, hs⟩ : ∃ s : K, s = algebraMap A K (algebraMap ↥W A e) /
          algebraMap A K (t - algebraMap ↥W A c) := ⟨_, rfl⟩
      obtain ⟨P₀, -, hP₀⟩ := hchart e he s hs (n + d)
        ((pow_dvd_pow e (by omega)).trans hew) ε₀ g₀
      obtain ⟨P₁, hP₁N, hP₁⟩ := hchart e he s hs n ((pow_dvd_pow e (by omega)).trans hew) ε₁ g₁
      rw [hP₀, hP₁, hlam'] at hEQ
      refine wcLlsAS_dse_etale_sep Ω W hdim hWtop ℓ hℓ A K L 𝔭 t hPD hK hfin α f hα hf.symm c e
        hc he he0 hu h s hs
        (algebraMap A _ (algebraMap ↥W A lam') * algebraMap A _ (t - algebraMap ↥W A c) ^ d * P₀)
        P₁ ⟨ε₁, hε₁, hP₁N⟩ ?_
      have hΛ : algebraMap A K (algebraMap ↥W A (lam₂ * lam')) =
          algebraMap A K (algebraMap ↥W A lam₂) * algebraMap A K (algebraMap ↥W A lam') := by
        simp only [map_mul]
      apply mul_right_cancel₀ (mul_ne_zero (pow_ne_zero n hu) (hinj lam₂ hlam₂))
      simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap]
      linear_combination hEQ + algebraMap A K (t - algebraMap ↥W A c) ^ (n + d) * (P₀ : K) * hΛ
    ·
      obtain ⟨d, rfl⟩ : ∃ d, n = k + d := ⟨n - k, by omega⟩
      have hd : 0 < d := by omega
      obtain ⟨lam'', hlam'', hlam''m⟩ : ∃ lam'' : ↥W, lam₁ = lam₂ * lam'' ∧
          lam'' ∈ IsLocalRing.maximalIdeal ↥W := by
        rcases hnk with h' | h'
        · exact absurd h' (by omega)
        · exact h'
      obtain ⟨e, he, he0, hew, hel⟩ := hpick (k + d + k + 1) (by omega) w lam'' hw hlam''m
      refine ⟨e, he, he0, ?_⟩
      obtain ⟨lam3, hlam3⟩ : e ^ d ∣ lam'' := (pow_dvd_pow e (by omega)).trans hel
      obtain ⟨s, hs⟩ : ∃ s : K, s = algebraMap A K (algebraMap ↥W A e) /
          algebraMap A K (t - algebraMap ↥W A c) := ⟨_, rfl⟩
      have hUs : algebraMap A K (t - algebraMap ↥W A c) * s =
          algebraMap A K (algebraMap ↥W A e) := by
        rw [hs]; field_simp
      obtain ⟨P₀, -, hP₀⟩ := hchart e he s hs k ((pow_dvd_pow e (by omega)).trans hew) ε₀ g₀
      obtain ⟨P₁, hP₁N, hP₁⟩ := hchart e he s hs (k + d)
        ((pow_dvd_pow e (by omega)).trans hew) ε₁ g₁
      rw [hP₀, hP₁, hlam'', hlam3] at hEQ
      refine wcLlsAS_dse_etale_sep Ω W hdim hWtop ℓ hℓ A K L 𝔭 t hPD hK hfin α f hα hf.symm c e
        hc he he0 hu h s hs
        (algebraMap A _ (algebraMap ↥W A lam3) *
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ ^ d * P₀)
        P₁ ⟨ε₁, hε₁, hP₁N⟩ ?_
      have hΛ : algebraMap A K (algebraMap ↥W A (lam₂ * (e ^ d * lam3))) =
          algebraMap A K (algebraMap ↥W A lam₂) *
            (algebraMap A K (t - algebraMap ↥W A c) * s) ^ d *
            algebraMap A K (algebraMap ↥W A lam3) := by
        rw [hUs]; simp only [map_mul, map_pow, mul_assoc]
      apply mul_right_cancel₀ (mul_ne_zero (pow_ne_zero (k + d) hu) (hinj lam₂ hlam₂))
      simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap]
      linear_combination hEQ + algebraMap A K (t - algebraMap ↥W A c) ^ k * (P₀ : K) * hΛ
  ·
    have hI : ¬ (ℓ : ℤ) ∣ ((k : ℤ) - n) := hD.resolve_left hE
    obtain ⟨q₁, hq₁, hq₁m⟩ : ∃ q₁ : ↥W, lam₂ = lam₁ * q₁ ∧
        (n < k → q₁ ∈ IsLocalRing.maximalIdeal ↥W) := by
      by_cases h21 : lam₂ ∣ lam₁
      · obtain ⟨lam', hlam'⟩ := h21
        have hnk : k < n := by
          by_contra hcon
          exact hE ⟨⟨lam', hlam'⟩, Or.inl (by omega)⟩
        have hlam'u : IsUnit lam' := by
          by_contra hnu
          exact hE ⟨⟨lam', hlam'⟩, Or.inr ⟨lam', hlam', (IsLocalRing.mem_maximalIdeal _).mpr hnu⟩⟩
        obtain ⟨v, hv⟩ := hlam'u
        refine ⟨↑v⁻¹, ?_, fun h' => absurd h' (by omega)⟩
        rw [hlam', ← hv, mul_assoc, Units.mul_inv, mul_one]
      · rcases ValuationRing.dvd_total lam₁ lam₂ with ⟨q₁, hq⟩ | h12
        · refine ⟨q₁, hq, fun _ => ?_⟩
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          rintro ⟨v, hv⟩
          apply h21
          exact ⟨↑v⁻¹, by rw [hq, ← hv, mul_assoc, Units.mul_inv, mul_one]⟩
        · exact absurd h12 h21
    have hq₁0 : q₁ ≠ 0 := by
      rintro rfl
      exact hlam₂ (by rw [hq₁, mul_zero])
    obtain ⟨μ, hμ⟩ := rootW ℓ hℓ.pos q₁
    have hμ0 : μ ≠ 0 := by
      rintro rfl
      exact hq₁0 (by rw [← hμ, zero_pow hℓ.ne_zero])
    obtain ⟨e, he, he0, hew, heq⟩ := hpick (n + k + 1) (by omega) w (if n < k then q₁ else 0) hw
      (by
        split_ifs with hnk
        · exact hq₁m hnk
        · exact (IsLocalRing.maximalIdeal ↥W).zero_mem)
    refine ⟨e, he, he0, ?_⟩
    obtain ⟨s, hs⟩ : ∃ s : K, s = algebraMap A K (algebraMap ↥W A e) /
        algebraMap A K (t - algebraMap ↥W A c) := ⟨_, rfl⟩
    obtain ⟨P₀, hP₀N, hP₀⟩ := hchart e he s hs k ((pow_dvd_pow e (by omega)).trans hew) ε₀ g₀
    obtain ⟨P₁, hP₁N, hP₁⟩ := hchart e he s hs n ((pow_dvd_pow e (by omega)).trans hew) ε₁ g₁
    rw [hP₀, hP₁] at hEQ
    refine wcLlsAS_dse_insep_sep Ω W hdim hWtop ℓ hℓ A K L 𝔭 t hPD hK hfin α f hα hf.symm c e
      hc he he0 hu h s hs μ ((k : ℤ) - n) hμ0 hI ?_ P₀ P₁ ⟨ε₀, hε₀, hP₀N⟩ ⟨ε₁, hε₁, hP₁N⟩ ?_
    · intro hm
      have hnk : n < k := by omega
      rw [if_pos hnk] at heq
      rw [hμ]
      exact (pow_dvd_pow e (by omega)).trans heq
    · have hΛ : algebraMap A K (algebraMap ↥W A lam₂) =
          algebraMap A K (algebraMap ↥W A lam₁) * algebraMap A K (algebraMap ↥W A μ) ^ ℓ := by
        rw [hq₁, ← hμ]; simp only [map_mul, map_pow]
      have h1 : algebraMap A K (algebraMap ↥W A lam₁) *
          (algebraMap A K (algebraMap ↥W A μ) ^ ℓ * (f - h ^ ℓ + h) * (P₁ : K) *
              algebraMap A K (t - algebraMap ↥W A c) ^ n -
            algebraMap A K (t - algebraMap ↥W A c) ^ k * (P₀ : K)) = 0 := by
        linear_combination hEQ -
          (f - h ^ ℓ + h) * algebraMap A K (t - algebraMap ↥W A c) ^ n * (P₁ : K) * hΛ
      have h2 := (mul_eq_zero.mp h1).resolve_left (hinj lam₁ hlam₁)
      rw [zpow_sub₀ hu, zpow_natCast, zpow_natCast, div_mul_eq_mul_div,
        eq_div_iff (pow_ne_zero _ hu)]
      linear_combination h2

theorem wcLlsAS_dsbu_section : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) (t : A) (c : ↥W),
    wcLlsPD W A 𝔭 (.disc t) → c ∈ IsLocalRing.maximalIdeal ↥W →
    ∃ ev : A →+* ↥W, (∀ w : ↥W, ev (algebraMap ↥W A w) = w) ∧ ev t = c ∧
      ∀ a : A, ∃ s e : A, s ∉ 𝔭 ∧ s * (a - algebraMap ↥W A (ev a)) = (t - algebraMap ↥W A c) * e :=
by
  classical

  have s4 : ∀ (R : Type u) [CommRing R] [IsLocalRing R], IsAlgClosed (IsLocalRing.ResidueField R) →
      ∀ (A : Type u) [CommRing A] [Algebra R A] (𝔭 : Ideal A), Algebra.FiniteType R A →
      𝔭.IsMaximal → (IsLocalRing.maximalIdeal R).map (algebraMap R A) ≤ 𝔭 →
      ∃ ρ : A →+* IsLocalRing.ResidueField R,
        (∀ r : R, ρ (algebraMap R A r) = IsLocalRing.residue R r) ∧ ∀ a : A, ρ a = 0 ↔ a ∈ 𝔭 := by
    intro R _ _ hac A _ _ 𝔭 hFT hmax hm
    haveI := hac
    letI : Field (A ⧸ 𝔭) := Ideal.Quotient.field 𝔭
    have H : ∀ x ∈ IsLocalRing.maximalIdeal R, (Ideal.Quotient.mk 𝔭).comp (algebraMap R A) x = 0 := by
      intro x hx
      rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
      exact hm (Ideal.mem_map_of_mem _ hx)
    let φ : IsLocalRing.ResidueField R →+* A ⧸ 𝔭 := Ideal.Quotient.lift _ _ H
    have hφ : ∀ r : R, φ (IsLocalRing.residue R r) = Ideal.Quotient.mk 𝔭 (algebraMap R A r) :=
      fun r => Ideal.Quotient.lift_mk _ _ H
    letI : Algebra (IsLocalRing.ResidueField R) (A ⧸ 𝔭) := φ.toAlgebra
    haveI : IsScalarTower R (IsLocalRing.ResidueField R) (A ⧸ 𝔭) :=
      IsScalarTower.of_algebraMap_eq (fun r => by
        show Ideal.Quotient.mk 𝔭 (algebraMap R A r) = φ (algebraMap R (IsLocalRing.ResidueField R) r)
        rw [IsLocalRing.ResidueField.algebraMap_eq, hφ])
    haveI : Algebra.FiniteType R (A ⧸ 𝔭) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ R 𝔭) (Ideal.Quotient.mkₐ_surjective R 𝔭)
    haveI : Algebra.FiniteType (IsLocalRing.ResidueField R) (A ⧸ 𝔭) :=
      Algebra.FiniteType.of_restrictScalars_finiteType R _ _
    haveI : Module.Finite (IsLocalRing.ResidueField R) (A ⧸ 𝔭) :=
      finite_of_finite_type_of_isJacobsonRing _ _
    haveI : Algebra.IsIntegral (IsLocalRing.ResidueField R) (A ⧸ 𝔭) := Algebra.IsIntegral.of_finite _ _
    have hbij : Function.Bijective (algebraMap (IsLocalRing.ResidueField R) (A ⧸ 𝔭)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let e := RingEquiv.ofBijective φ hbij
    refine ⟨e.symm.toRingHom.comp (Ideal.Quotient.mk 𝔭), fun r => ?_, fun a => ?_⟩
    · show e.symm (Ideal.Quotient.mk 𝔭 (algebraMap R A r)) = _
      rw [RingEquiv.symm_apply_eq]
      show _ = φ (IsLocalRing.residue R r)
      rw [hφ]
    · show e.symm (Ideal.Quotient.mk 𝔭 a) = 0 ↔ a ∈ 𝔭
      rw [map_eq_zero_iff _ e.symm.injective, Ideal.Quotient.eq_zero_iff_mem]

  have s5 : ∀ (R : Type u) [CommRing R] (B : Type u) [CommRing B] (f : Polynomial R →+* B) (c : R),
      f.Etale → RingHom.Etale ((Ideal.Quotient.mk (Ideal.span {f (Polynomial.X - Polynomial.C c)})).comp
        (f.comp Polynomial.C)) := by
    intro R _ B _ f c hf
    letI := f.toAlgebra
    haveI : Algebra.Etale (Polynomial R) B := hf
    set J : Ideal (Polynomial R) := RingHom.ker (Polynomial.evalRingHom c) with hJ
    have hK : J.map (algebraMap (Polynomial R) B) = Ideal.span {f (Polynomial.X - Polynomial.C c)} := by
      rw [hJ, Polynomial.ker_evalRingHom, Ideal.map_span, Set.image_singleton]
      rfl
    have hπ : Function.Surjective (Polynomial.evalRingHom c) :=
      fun w => ⟨Polynomial.C w, Polynomial.eval_C⟩
    have h1 := RingHom.etale_algebraMap.mpr
      (inferInstance : Algebra.Etale (Polynomial R ⧸ J) (TensorProduct (Polynomial R) (Polynomial R ⧸ J) B))
    let e₁ : TensorProduct (Polynomial R) (Polynomial R ⧸ J) B ≃+*
        B ⧸ J.map (algebraMap (Polynomial R) B) :=
      (Algebra.TensorProduct.comm (Polynomial R) (Polynomial R ⧸ J) B).toRingEquiv.trans
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B J).symm.toRingEquiv
    let e₂ : B ⧸ J.map (algebraMap (Polynomial R) B) ≃+*
        B ⧸ Ideal.span {f (Polynomial.X - Polynomial.C c)} := Ideal.quotEquivOfEq hK
    have hg := RingHom.Etale.respectsIso.1 _ (e₁.trans e₂) h1
    have hfb := RingHom.Etale.respectsIso.2 _ (RingHom.quotientKerEquivOfSurjective hπ).symm hg
    convert hfb using 1
    apply RingHom.ext
    intro w
    have hs : (RingHom.quotientKerEquivOfSurjective hπ).symm w =
        Ideal.Quotient.mk J (Polynomial.C w) := by
      have := RingHom.quotientKerEquivOfSurjective_symm_apply hπ (Polynomial.C w)
      rw [Polynomial.coe_evalRingHom, Polynomial.eval_C] at this
      exact this
    show _ = e₂ (e₁ (algebraMap (Polynomial R ⧸ J) (TensorProduct (Polynomial R) (Polynomial R ⧸ J) B)
      ((RingHom.quotientKerEquivOfSurjective hπ).symm w)))
    rw [hs, Algebra.TensorProduct.algebraMap_apply]
    show _ = e₂ ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot B J).symm
      ((Algebra.TensorProduct.comm (Polynomial R) (Polynomial R ⧸ J) B)
        (_ ⊗ₜ[Polynomial R] (1 : B))))
    rw [Algebra.TensorProduct.comm_tmul, Algebra.algebraMap_self, RingHom.id_apply,
      Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul]
    rw [Algebra.smul_def, mul_one]
    rfl

  have s6 : ∀ (R : Type u) [CommRing R] (E : Type u) [CommRing E] [Algebra R E] [Algebra.Etale R E]
      (τ : E →ₐ[R] R), ∃ r : E, τ r = 1 ∧ ∀ x : E, r * (x - algebraMap R E (τ x)) = 0 := by
    intro R _ E _ _ _ τ
    set J : Ideal E := RingHom.ker τ.toRingHom with hJ
    have ha : ∀ x : E, x - algebraMap R E (τ x) ∈ J := by
      intro x
      rw [hJ, RingHom.mem_ker]
      show τ (x - algebraMap R E (τ x)) = 0
      rw [map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self]
    have hle : J ≤ J ^ 2 := by
      have hI2 : (J.map (Ideal.Quotient.mk (J ^ 2))) ^ 2 = ⊥ := by
        rw [← Ideal.map_pow, Ideal.map_quotient_self]
      have hnil : IsNilpotent (J.map (Ideal.Quotient.mk (J ^ 2))) := ⟨2, by rw [hI2]; rfl⟩
      let g₁ : E →ₐ[R] E ⧸ J ^ 2 := Ideal.Quotient.mkₐ R (J ^ 2)
      let g₂ : E →ₐ[R] E ⧸ J ^ 2 := (Algebra.ofId R (E ⧸ J ^ 2)).comp τ
      have e₂ : ∀ x, g₂ x = Ideal.Quotient.mk (J ^ 2) (algebraMap R E (τ x)) := by
        intro x
        show algebraMap R (E ⧸ J ^ 2) (τ x) = _
        rw [IsScalarTower.algebraMap_apply R E (E ⧸ J ^ 2), Ideal.Quotient.algebraMap_eq]
      have hg : g₁ = g₂ := by
        apply Algebra.FormallyUnramified.ext _ hnil
        intro x
        rw [Ideal.Quotient.eq, e₂]
        show Ideal.Quotient.mk (J ^ 2) x - Ideal.Quotient.mk (J ^ 2) (algebraMap R E (τ x)) ∈ _
        rw [← map_sub]
        exact Ideal.mem_map_of_mem _ (ha x)
      intro x hx
      have h2 : τ x = 0 := hx
      have h1 : g₁ x = g₂ x := by rw [hg]
      rw [e₂, h2, map_zero, map_zero] at h1
      exact Ideal.Quotient.eq_zero_iff_mem.mp h1
    have hsurj : Function.Surjective τ := fun r => ⟨algebraMap R E r, by
      rw [AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]⟩
    have hfg : J.FG := Algebra.FinitePresentation.ker_fG_of_surjective τ hsurj
    have hle' : J ≤ J • J := by
      rw [Ideal.smul_eq_mul, ← pow_two]
      exact hle
    obtain ⟨r, hr1, hr⟩ :=
      Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul J J hfg hle'
    refine ⟨r, ?_, fun x => ?_⟩
    · have h0 : τ (r - 1) = 0 := hr1
      rw [map_sub, map_one, sub_eq_zero] at h0
      exact h0
    · exact hr _ (ha x)

  have s7 : ∀ (A : Type u) [CommRing A] [IsDomain A] (𝔭 : Ideal A) [𝔭.IsPrime] (h : A), h ∉ 𝔭 →
      ∀ (r y : Localization.Away h) (a g : A), r ∉ 𝔭.map (algebraMap A (Localization.Away h)) →
      r * algebraMap A (Localization.Away h) a = algebraMap A (Localization.Away h) g * y →
      ∃ s e : A, s ∉ 𝔭 ∧ s * a = g * e := by
    intro A _ _ 𝔭 _ h hh r y a g hr hEq
    have hh0 : h ≠ 0 := fun h0 => hh (h0 ▸ 𝔭.zero_mem)
    have hinj : Function.Injective (algebraMap A (Localization.Away h)) :=
      IsLocalization.injective (Localization.Away h) (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
    obtain ⟨i, r₀, hr₀⟩ := IsLocalization.Away.surj h r
    obtain ⟨j, y₀, hy₀⟩ := IsLocalization.Away.surj h y
    have key : algebraMap A (Localization.Away h) (r₀ * h ^ j * a) =
        algebraMap A (Localization.Away h) (g * (h ^ i * y₀)) := by
      simp only [map_mul, map_pow]
      rw [← hr₀, ← hy₀]
      linear_combination (algebraMap A (Localization.Away h) h ^ i *
        algebraMap A (Localization.Away h) h ^ j) * hEq
    have hdisj : Disjoint (Submonoid.powers h : Set A) 𝔭 := by
      rw [Set.disjoint_left]
      rintro x ⟨n, rfl⟩ hx
      exact hh (Ideal.IsPrime.mem_of_pow_mem ‹_› n hx)
    have hhn : ∀ n : ℕ, h ^ n ∉ 𝔭 := fun n hn => hh (Ideal.IsPrime.mem_of_pow_mem ‹_› n hn)
    have hQp : (𝔭.map (algebraMap A (Localization.Away h))).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) _ 𝔭 ‹_› hdisj
    have hQc : (𝔭.map (algebraMap A (Localization.Away h))).comap
        (algebraMap A (Localization.Away h)) = 𝔭 :=
      IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers h) _ ‹_› hdisj
    refine ⟨r₀ * h ^ j, h ^ i * y₀, ?_, hinj key⟩
    intro hm
    rcases Ideal.IsPrime.mem_or_mem ‹_› hm with h1 | h1
    · have h2 : algebraMap A (Localization.Away h) r₀ ∈ 𝔭.map (algebraMap A (Localization.Away h)) :=
        Ideal.mem_map_of_mem _ h1
      rw [← hr₀] at h2
      rcases hQp.mem_or_mem h2 with h3 | h3
      · exact hr h3
      · rw [← map_pow, ← Ideal.mem_comap, hQc] at h3
        exact hhn i h3
    · exact hhn j h1

  intro Ω _ _ W _hW _hWt A _ _ _ 𝔭 t c hPD hc
  unfold wcLlsPD at hPD
  obtain ⟨hFT, _, _, hmax, hm𝔭, ht, _, h, hh, f, hfC, hfX, hfet⟩ := hPD
  haveI hpr : 𝔭.IsPrime := hmax.isPrime
  have hgen : f (Polynomial.X - Polynomial.C c) =
      algebraMap A (Localization.Away h) (t - algebraMap ↥W A c) := by
    rw [map_sub, map_sub, hfX, ← RingHom.comp_apply f Polynomial.C c, hfC, RingHom.comp_apply]

  haveI hκ : IsAlgClosed (IsLocalRing.ResidueField ↥W) := wcpa_dj_nc_residue_algclosed Ω W
  obtain ⟨ρ, hρW, hρ0⟩ := s4 ↥W hκ A 𝔭 hFT hmax hm𝔭
  have hρh : IsUnit (ρ h) := isUnit_iff_ne_zero.mpr (fun h0 => hh ((hρ0 h).mp h0))
  let ρh : Localization.Away h →+* IsLocalRing.ResidueField ↥W := IsLocalization.Away.lift h hρh
  have hρhA : ∀ a, ρh (algebraMap A (Localization.Away h) a) = ρ a :=
    fun a => IsLocalization.Away.lift_eq h hρh a
  set I : Ideal (Localization.Away h) := Ideal.span {f (Polynomial.X - Polynomial.C c)} with hIdef
  have hρc : ρ (algebraMap ↥W A c) = 0 := by
    rw [hρW, IsLocalRing.residue_eq_zero_iff]
    exact hc
  have hρt : ρ t = 0 := (hρ0 t).mpr ht
  have hI : ∀ z ∈ I, ρh z = 0 := by
    intro z hz
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp hz
    rw [map_mul, hgen, hρhA, map_sub, hρt, hρc, sub_self, mul_zero]

  have hEw : ∀ w : ↥W, algebraMap ↥W (Localization.Away h ⧸ I) w =
      Ideal.Quotient.mk I (algebraMap A (Localization.Away h) (algebraMap ↥W A w)) := by
    intro w
    rw [IsScalarTower.algebraMap_apply ↥W (Localization.Away h) (Localization.Away h ⧸ I),
      Ideal.Quotient.algebraMap_eq,
      IsScalarTower.algebraMap_apply ↥W A (Localization.Away h)]
  have hE : algebraMap ↥W (Localization.Away h ⧸ I) =
      (Ideal.Quotient.mk I).comp (f.comp Polynomial.C) := by
    apply RingHom.ext
    intro w
    rw [hEw, hfC]
    rfl
  haveI hEet : Algebra.Etale ↥W (Localization.Away h ⧸ I) := by
    rw [← RingHom.etale_algebraMap, hE]
    exact s5 ↥W (Localization.Away h) f c hfet
  let σ₀ : (Localization.Away h ⧸ I) →ₐ[↥W] IsLocalRing.ResidueField ↥W :=
    { Ideal.Quotient.lift I ρh hI with
      commutes' := fun w => by
        show Ideal.Quotient.lift I ρh hI (algebraMap ↥W (Localization.Away h ⧸ I) w) =
          algebraMap ↥W (IsLocalRing.ResidueField ↥W) w
        rw [hEw, Ideal.Quotient.lift_mk, hρhA, hρW, IsLocalRing.ResidueField.algebraMap_eq] }

  haveI : HenselianLocalRing ↥W := wcpa_dj_lmga_valuation_henselian Ω W
  obtain ⟨τ, hτ⟩ := wc_hnas_smooth_section_henselian ↥W (Localization.Away h ⧸ I) σ₀
  let ev : A →+* ↥W :=
    τ.toRingHom.comp ((Ideal.Quotient.mk I).comp (algebraMap A (Localization.Away h)))
  have hevW : ∀ w : ↥W, ev (algebraMap ↥W A w) = w := by
    intro w
    show τ (Ideal.Quotient.mk I (algebraMap A (Localization.Away h) (algebraMap ↥W A w))) = w
    rw [← hEw, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]
  have hmkt : Ideal.Quotient.mk I (algebraMap A (Localization.Away h) t) =
      Ideal.Quotient.mk I (algebraMap A (Localization.Away h) (algebraMap ↥W A c)) := by
    rw [Ideal.Quotient.eq, ← map_sub, ← hgen]
    exact Ideal.subset_span (Set.mem_singleton _)
  have hevt : ev t = c := by
    show τ (Ideal.Quotient.mk I (algebraMap A (Localization.Away h) t)) = c
    rw [hmkt]
    exact hevW c

  obtain ⟨r, hr1, hr⟩ := s6 ↥W (Localization.Away h ⧸ I) τ
  obtain ⟨r', rfl⟩ := Ideal.Quotient.mk_surjective r
  have hker : 𝔭.map (algebraMap A (Localization.Away h)) ≤ RingHom.ker ρh := by
    rw [Ideal.map_le_iff_le_comap]
    intro p hp
    rw [Ideal.mem_comap, RingHom.mem_ker, hρhA]
    exact (hρ0 p).mpr hp
  have hr'𝔭 : r' ∉ 𝔭.map (algebraMap A (Localization.Away h)) := by
    intro hm
    have h1 : ρh r' = 0 := hker hm
    have h2 : ρh r' = IsLocalRing.residue ↥W (τ (Ideal.Quotient.mk I r')) := by
      rw [hτ]
      rfl
    rw [hr1, map_one] at h2
    rw [h2] at h1
    exact one_ne_zero h1
  have hloc : ∀ a : A, ∃ s e : A, s ∉ 𝔭 ∧
      s * (a - algebraMap ↥W A (ev a)) = (t - algebraMap ↥W A c) * e := by
    intro a
    have h1 := hr (Ideal.Quotient.mk I (algebraMap A (Localization.Away h) a))
    have h2 : algebraMap ↥W (Localization.Away h ⧸ I)
        (τ (Ideal.Quotient.mk I (algebraMap A (Localization.Away h) a))) =
        Ideal.Quotient.mk I (algebraMap A (Localization.Away h) (algebraMap ↥W A (ev a))) := hEw _
    rw [h2, ← map_sub, ← map_mul, Ideal.Quotient.eq_zero_iff_mem, ← map_sub] at h1
    obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp h1
    rw [hgen] at hy
    exact s7 A 𝔭 h hh r' y (a - algebraMap ↥W A (ev a)) (t - algebraMap ↥W A c) hr'𝔭
      (hy.symm.trans (mul_comm _ _))
  exact ⟨ev, hevW, hevt, hloc⟩

theorem wcLlsAS_dsbu_fixed_prime_ram : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u)
    [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L]
    [IsScalarTower A K L] [FiniteDimensional K L] (ev : A →+* ↥W),
    (∀ w : ↥W, ev (algebraMap ↥W A w) = w) →
    ∀ (Q : Ideal ↥(integralClosure A L)), Q.IsPrime →
      Q.comap (algebraMap A ↥(integralClosure A L)) = RingHom.ker ev →
    ∀ g : L ≃ₐ[K] L, (∀ x : ↥(integralClosure A L), x ∈ Q → ∃ z ∈ Q, (z : L) = g x) →
    ∀ x : ↥(integralClosure A L), ∃ q ∈ Q, (q : L) = g x - x :=
by
  intro Ω _ _ W A _ _ _ K _ _ _ L _ _ _ _ _ ev hev Q hQ hQc g hg x
  classical

  have hlift : ∀ (D : Type u) [CommRing D] [IsDomain D] (ψ : ↥W →+* D) (n : ℕ)
      (f : Polynomial ↥W), f.Monic → f.natDegree = n → ∀ y : D,
      Polynomial.eval₂ ψ y f = 0 → ∃ w : ↥W, ψ w = y := by
    intro D _ _ ψ n
    induction n with
    | zero =>
      intro f hf hn y hy
      rw [Polynomial.eq_one_of_monic_natDegree_zero hf hn, Polynomial.eval₂_one] at hy
      exact absurd hy one_ne_zero
    | succ m ih =>
      intro f hf hn y hy
      have hfm : (f.map (algebraMap ↥W Ω)).Monic := hf.map _
      have hdeg : (f.map (algebraMap ↥W Ω)).degree ≠ 0 := by
        rw [Polynomial.degree_eq_natDegree hfm.ne_zero, hf.natDegree_map, hn]
        exact_mod_cast Nat.succ_ne_zero m
      obtain ⟨ω, hω⟩ := IsAlgClosed.exists_root (f.map (algebraMap ↥W Ω)) hdeg
      rw [Polynomial.IsRoot, Polynomial.eval_map] at hω
      have hωi : _root_.IsIntegral ↥W ω := ⟨f, hf, hω⟩
      obtain ⟨w₀, hw₀⟩ := IsIntegrallyClosed.isIntegral_iff.mp hωi
      have hroot : f.IsRoot w₀ := by
        have h1 : algebraMap ↥W Ω (f.eval w₀) = 0 := by
          rw [← Polynomial.eval₂_hom, hw₀]; exact hω
        exact (map_eq_zero_iff _ (IsFractionRing.injective ↥W Ω)).mp h1
      have hfac := (Polynomial.mul_divByMonic_eq_iff_isRoot).mpr hroot
      have hqm : (f /ₘ (Polynomial.X - Polynomial.C w₀)).Monic := by
        apply Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C w₀)
        rw [hfac]; exact hf
      have hqd : (f /ₘ (Polynomial.X - Polynomial.C w₀)).natDegree = m := by
        rw [Polynomial.natDegree_divByMonic _ (Polynomial.monic_X_sub_C w₀), hn,
          Polynomial.natDegree_X_sub_C]; rfl
      rw [← hfac, Polynomial.eval₂_mul, Polynomial.eval₂_sub, Polynomial.eval₂_X,
        Polynomial.eval₂_C] at hy
      rcases mul_eq_zero.mp hy with h | h
      · exact ⟨w₀, (sub_eq_zero.mp h).symm⟩
      · exact ih _ hqm hqd y h
  haveI := hQ

  have ha : (Ideal.Quotient.mk Q).comp (algebraMap A ↥(integralClosure A L)) =
      ((Ideal.Quotient.mk Q).comp ((algebraMap A ↥(integralClosure A L)).comp
        (algebraMap ↥W A))).comp ev := by
    refine RingHom.ext fun a => ?_
    simp only [RingHom.comp_apply]
    rw [Ideal.Quotient.eq, ← map_sub]
    have h1 : a - algebraMap ↥W A (ev a) ∈ Q.comap (algebraMap A ↥(integralClosure A L)) := by
      rw [hQc, RingHom.mem_ker, map_sub, hev, sub_self]
    exact h1
  obtain ⟨p, hpm, hpx⟩ := integralClosure.isIntegral x
  have hroot : Polynomial.eval₂ ((Ideal.Quotient.mk Q).comp
      ((algebraMap A ↥(integralClosure A L)).comp (algebraMap ↥W A)))
      (Ideal.Quotient.mk Q x) (p.map ev) = 0 := by
    rw [Polynomial.eval₂_map, ← ha, ← Polynomial.hom_eval₂, hpx, map_zero]
  obtain ⟨w, hw⟩ := hlift _ _ _ (p.map ev) (hpm.map ev) rfl _ hroot
  have hu : x - algebraMap A ↥(integralClosure A L) (algebraMap ↥W A w) ∈ Q :=
    Ideal.Quotient.eq.mp hw.symm
  obtain ⟨z, hzQ, hz⟩ := hg _ hu
  refine ⟨z - (x - algebraMap A ↥(integralClosure A L) (algebraMap ↥W A w)),
    Q.sub_mem hzQ hu, ?_⟩
  have hga : g (algebraMap A L (algebraMap ↥W A w)) = algebraMap A L (algebraMap ↥W A w) := by
    rw [IsScalarTower.algebraMap_apply A K L, AlgEquiv.commutes]
  push_cast at hz ⊢
  rw [hz, map_sub, hga]
  ring

theorem wcLlsAS_dsbu_integral_generator : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (ℓ : ℕ), ℓ.Prime →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [Algebra ↥W A] (K : Type u)
    [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L]
    [IsScalarTower A K L] [FiniteDimensional K L] [IsGalois K L],
    ((ℓ : ℕ) : K) = 0 → Module.finrank K L = ℓ →
    ∀ ev : A →+* ↥W, (∀ w : ↥W, ev (algebraMap ↥W A w) = w) →
    (∀ Q : Ideal ↥(integralClosure A L), Q.IsPrime →
      Q.comap (algebraMap A ↥(integralClosure A L)) = RingHom.ker ev →
      ∀ g : L ≃ₐ[K] L, g ≠ 1 → ¬ ∀ x : ↥(integralClosure A L), x ∈ Q → ∃ z ∈ Q, (z : L) = g x) →
    ∃ (β : L) (a d : A), β ∉ Set.range (algebraMap K L) ∧ ev a = 0 ∧ ev d ≠ 0 ∧
      algebraMap A L d * (β ^ ℓ - β) = algebraMap A L a :=
by
  classical
  intro Ω _ _ W ℓ hℓ A _ _ _ _ K _ _ _ L _ _ _ _ _ _ hK hdeg ev hevW H
  have hL : ((ℓ : ℕ) : L) = 0 := by rw [← map_natCast (algebraMap K L), hK, map_zero]
  have h2 := hℓ.two_le
  obtain ⟨m, rfl⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, by omega⟩
  haveI hfact : Fact (m + 1).Prime := ⟨hℓ⟩
  haveI hchar : CharP L (m + 1) := (CharP.charP_iff_prime_eq_zero hℓ).mpr hL
  have hL' : (m : L) + 1 = 0 := by exact_mod_cast hL
  have hm1 : 1 ≤ m := by omega

  have hinjAK : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hinjAL : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp hinjAK

  haveI hPprime : (RingHom.ker ev).IsPrime := RingHom.ker_isPrime ev
  have hker : RingHom.ker (algebraMap A (integralClosure A L)) ≤ RingHom.ker ev := by
    intro x hx
    rw [RingHom.mem_ker] at hx
    have h3 : algebraMap A L x = 0 := by
      have h4 := congrArg (fun y : integralClosure A L => (y : L)) hx
      exact h4
    rw [hinjAL (h3.trans (map_zero _).symm)]
    exact Ideal.zero_mem _
  obtain ⟨Q, hQ, hQc⟩ :=
    Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain (S := integralClosure A L)
      (RingHom.ker ev) hker
  haveI := hQ
  have hQc' : Q.comap (algebraMap A (integralClosure A L)) = RingHom.ker ev := hQc

  obtain ⟨φ, hφ⟩ : ∃ φ : (L ≃ₐ[K] L) → (integralClosure A L →ₐ[A] integralClosure A L),
      ∀ g x, ((φ g x : integralClosure A L) : L) = g (x : L) :=
    ⟨fun g => AlgHom.mapIntegralClosure ((g.restrictScalars A : L ≃ₐ[A] L) : L →ₐ[A] L),
      fun g x => (AlgHom.coe_mapIntegralClosure _ x).trans rfl⟩

  have hx : ∀ g : L ≃ₐ[K] L, g ≠ 1 → ∃ x : integralClosure A L, x ∈ Q ∧ φ g x ∉ Q := by
    intro g hg
    have h5 := H Q hQ hQc' g hg
    push_neg at h5
    obtain ⟨x, hxQ, hx⟩ := h5
    exact ⟨x, hxQ, fun hmem => hx _ hmem (hφ g x)⟩
  choose x hxQ hxn using hx
  obtain ⟨w, hw⟩ : ∃ w : (L ≃ₐ[K] L) → integralClosure A L, ∀ g (h : g ≠ 1), w g = φ g (x g h) :=
    ⟨fun g => if h : g = 1 then 1 else φ g (x g h), fun g h => dif_neg h⟩
  haveI : Fintype (L ≃ₐ[K] L) := Fintype.ofFinite _
  obtain ⟨u, hudef⟩ : ∃ u : integralClosure A L, u = ∏ g ∈ Finset.univ.erase 1, w g := ⟨_, rfl⟩
  have huQ : u ∉ Q := by
    intro hu
    rw [hudef] at hu
    obtain ⟨g, hg, hgQ⟩ := (Ideal.IsPrime.prod_mem_iff (p := Q)).mp hu
    have hg1 : g ≠ 1 := Finset.ne_of_mem_erase hg
    rw [hw g hg1] at hgQ
    exact hxn g hg1 hgQ
  have hmove : ∀ h : L ≃ₐ[K] L, h ≠ 1 → φ h u ∈ Q := by
    intro h hh
    have hh' : h⁻¹ ≠ 1 := inv_ne_one.mpr hh
    have hinv : h⁻¹ ∈ Finset.univ.erase (1 : L ≃ₐ[K] L) :=
      Finset.mem_erase.mpr ⟨hh', Finset.mem_univ _⟩
    rw [hudef, map_prod, ← Finset.mul_prod_erase _ _ hinv]
    apply Ideal.mul_mem_right
    have h6 : φ h (w h⁻¹) = x h⁻¹ hh' := by
      rw [hw _ hh']
      apply Subtype.ext
      rw [hφ, hφ, ← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
    rw [h6]
    exact hxQ _ _

  have hcard : Nat.card (L ≃ₐ[K] L) = m + 1 := by rw [IsGalois.card_aut_eq_finrank, hdeg]
  haveI : Nontrivial (L ≃ₐ[K] L) :=
    Finite.one_lt_card_iff_nontrivial.mp (by rw [hcard]; omega)
  obtain ⟨σ, hσ⟩ := exists_ne (1 : L ≃ₐ[K] L)
  have hσℓ : σ ^ (m + 1) = 1 := by rw [← hcard]; exact pow_card_eq_one'
  have hord : orderOf σ = m + 1 := orderOf_eq_prime hσℓ hσ
  have hσk : ∀ k, 0 < k → k < m + 1 → σ ^ k ≠ 1 :=
    fun k hk hk' => pow_ne_one_of_lt_orderOf hk.ne' (hord ▸ hk')
  have hsh : ∀ (k : ℕ) (v : L), σ ((σ ^ k) v) = (σ ^ (k + 1)) v := by
    intro k v; rw [pow_succ', AlgEquiv.mul_apply]
  have hfix : ∀ y : L, σ y = y → y ∈ Set.range (algebraMap K L) := by
    intro y hy
    have hpow : ∀ n : ℕ, (σ ^ n) y = y := by
      intro n
      induction n with
      | zero => rw [pow_zero, AlgEquiv.one_apply]
      | succ n ih => rw [← hsh, ih, hy]
    rw [IsGalois.mem_range_algebraMap_iff_fixed]
    intro f
    have hz : f ∈ Subgroup.zpowers σ := by
      rw [zpowers_eq_top_of_prime_card hcard hσ]; exact Subgroup.mem_top f
    obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp (mem_powers_iff_mem_zpowers.mpr hz)
    rw [← hn]
    exact hpow n

  obtain ⟨uL, huL⟩ : ∃ uL : L, uL = (u : L) := ⟨_, rfl⟩
  obtain ⟨τ, hτdef⟩ : ∃ τ : L, τ = ∑ k ∈ Finset.range (m + 1), (σ ^ k) uL := ⟨_, rfl⟩
  obtain ⟨η, hηdef⟩ : ∃ η : L, η = -∑ k ∈ Finset.range (m + 1), (k : L) * (σ ^ k) uL :=
    ⟨_, rfl⟩
  have e3 : τ = ∑ k ∈ Finset.range m, (σ ^ (k + 1)) uL + uL := by
    rw [hτdef, Finset.sum_range_succ', pow_zero, AlgEquiv.one_apply]
  have hτσ : σ τ = τ := by
    have e1 : σ τ = ∑ k ∈ Finset.range (m + 1), (σ ^ (k + 1)) uL := by
      rw [hτdef, map_sum]
      simp only [hsh]
    have e2 : ∑ k ∈ Finset.range (m + 1), (σ ^ (k + 1)) uL =
        ∑ k ∈ Finset.range m, (σ ^ (k + 1)) uL + uL := by
      rw [Finset.sum_range_succ, hσℓ, AlgEquiv.one_apply]
    rw [e1, e2, e3]
  have hησ : σ η = η + τ := by
    have e1 : σ η = -(∑ k ∈ Finset.range m, (k : L) * (σ ^ (k + 1)) uL + (m : L) * uL) := by
      rw [hηdef, map_neg, map_sum]
      simp only [map_mul, map_natCast, hsh]
      rw [Finset.sum_range_succ, hσℓ, AlgEquiv.one_apply]
    have e2 : η = -(∑ k ∈ Finset.range m, (k : L) * (σ ^ (k + 1)) uL +
        ∑ k ∈ Finset.range m, (σ ^ (k + 1)) uL) := by
      rw [hηdef, Finset.sum_range_succ']
      simp only [Nat.cast_add, Nat.cast_one, Nat.cast_zero, zero_mul, add_zero, add_mul, one_mul,
        Finset.sum_add_distrib]
    rw [e1, e2, e3]
    linear_combination (-uL) * hL'
  obtain ⟨N, hNdef⟩ : ∃ N : L, N = η ^ (m + 1) - τ ^ m * η := ⟨_, rfl⟩
  have hNσ : σ N = N := by
    rw [hNdef, map_sub, map_mul, map_pow, map_pow, hησ, hτσ, add_pow_char]
    ring

  have hintg : ∀ g : L ≃ₐ[K] L, g uL ∈ integralClosure A L := by
    intro g; rw [huL, ← hφ]; exact (φ g u).2
  have hτmem : τ ∈ integralClosure A L := by
    rw [hτdef]; exact Subalgebra.sum_mem _ (fun k _ => hintg _)
  have hηmem : η ∈ integralClosure A L := by
    rw [hηdef]
    exact Subalgebra.neg_mem _ (Subalgebra.sum_mem _ (fun k _ =>
      Subalgebra.mul_mem _ (Subalgebra.natCast_mem _ _) (hintg _)))
  have hNmem : N ∈ integralClosure A L := by
    rw [hNdef]
    exact Subalgebra.sub_mem _ (Subalgebra.pow_mem _ hηmem _)
      (Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hτmem _) hηmem)

  have hτB : (⟨τ, hτmem⟩ : integralClosure A L) =
      u + ∑ k ∈ Finset.range m, φ (σ ^ (k + 1)) u := by
    apply Subtype.ext
    simp only [AddMemClass.coe_add, AddSubmonoidClass.coe_finset_sum, hφ]
    rw [e3, huL, add_comm]
  have hτBQ : (⟨τ, hτmem⟩ : integralClosure A L) ∉ Q := by
    intro h
    apply huQ
    have h7 : u = (⟨τ, hτmem⟩ : integralClosure A L) -
        ∑ k ∈ Finset.range m, φ (σ ^ (k + 1)) u := by rw [hτB]; ring
    rw [h7]
    refine Q.sub_mem h (Q.sum_mem fun k hk => hmove _ (hσk (k + 1) (by omega) ?_))
    rw [Finset.mem_range] at hk; omega

  have hdesc : ∀ y : L, _root_.IsIntegral A y → y ∈ Set.range (algebraMap K L) →
      ∃ a : A, algebraMap A L a = y := by
    rintro y hy ⟨k, rfl⟩
    have hk : _root_.IsIntegral A k := (isIntegral_algebraMap_iff (A := K) (B := L)).mp hy
    obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp hk
    exact ⟨a, by rw [IsScalarTower.algebraMap_apply A K L, ha]⟩
  obtain ⟨τ₀, hτ₀⟩ := hdesc τ hτmem (hfix τ hτσ)
  have hevτ : ev τ₀ ≠ 0 := by
    intro h0
    have hmem : τ₀ ∈ Q.comap (algebraMap A (integralClosure A L)) := by
      rw [hQc']; exact h0
    apply hτBQ
    have h8 : algebraMap A (integralClosure A L) τ₀ = ⟨τ, hτmem⟩ := Subtype.ext hτ₀
    rw [← h8]; exact hmem
  have hτ0 : τ ≠ 0 := by
    rw [← hτ₀]; intro h
    apply hevτ
    rw [hinjAL (h.trans (map_zero _).symm), map_zero]
  obtain ⟨a₀, ha₀⟩ := hdesc N hNmem (hfix N hNσ)

  obtain ⟨β₀, hβ₀def⟩ : ∃ β₀ : L, β₀ = η / τ := ⟨_, rfl⟩
  have hσβ : σ β₀ = β₀ + 1 := by
    rw [hβ₀def, map_div₀, hησ, hτσ, add_div, div_self hτ0]
  have hβ₀ : β₀ ∉ Set.range (algebraMap K L) := by
    rintro ⟨k, hk⟩
    have h1 : σ β₀ = β₀ := by rw [← hk, AlgEquiv.commutes]
    rw [hσβ] at h1
    have h9 : (1 : L) = 0 := by linear_combination h1
    exact one_ne_zero h9
  obtain ⟨d₀, hd₀def⟩ : ∃ d₀ : A, d₀ = τ₀ ^ (m + 1) := ⟨_, rfl⟩
  have hd₀ : ev d₀ ≠ 0 := by rw [hd₀def, map_pow]; exact pow_ne_zero _ hevτ
  have hid : algebraMap A L d₀ * (β₀ ^ (m + 1) - β₀) = algebraMap A L a₀ := by
    have hητ : η = β₀ * τ := by rw [hβ₀def, div_mul_cancel₀ _ hτ0]
    rw [hd₀def, map_pow, hτ₀, ha₀, hNdef, hητ]
    ring

  obtain ⟨ea, hea⟩ : ∃ ea : Ω, ea = algebraMap W Ω (ev a₀) := ⟨_, rfl⟩
  obtain ⟨ed, hed⟩ : ∃ ed : Ω, ed = algebraMap W Ω (ev d₀) := ⟨_, rfl⟩
  have hinjW : Function.Injective (algebraMap W Ω) := IsFractionRing.injective W Ω
  have hed0 : ed ≠ 0 := by
    rw [hed]; intro h; apply hd₀; exact hinjW (h.trans (map_zero _).symm)
  obtain ⟨γ, hγ⟩ := IsAlgClosed.exists_root
    (Polynomial.X ^ (m + 1) - (Polynomial.X + Polynomial.C (ea / ed))) (by
      rw [Polynomial.degree_sub_eq_left_of_degree_lt] <;> rw [Polynomial.degree_X_pow]
      · exact_mod_cast (by omega : m + 1 ≠ 0)
      · rw [Polynomial.degree_X_add_C]; exact_mod_cast (by omega : 1 < m + 1))
  have hγ' : γ ^ (m + 1) - γ = ea / ed := by
    simp only [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow,
      Polynomial.eval_X, Polynomial.eval_add, Polynomial.eval_C] at hγ
    linear_combination hγ
  obtain ⟨g₁, g₂, hg₂, hγeq⟩ := IsFractionRing.div_surjective (A := W) γ
  have hg₂0 : g₂ ≠ 0 := nonZeroDivisors.ne_zero hg₂
  have hx₂0 : algebraMap W Ω g₂ ≠ 0 := by
    intro h; apply hg₂0; exact hinjW (h.trans (map_zero _).symm)
  have hG₂0 : algebraMap A L (algebraMap W A g₂) ≠ 0 := by
    intro h
    apply hg₂0
    have h10 := hinjAL (h.trans (map_zero _).symm)
    rw [← hevW g₂, h10, map_zero]
  obtain ⟨c, hc⟩ : ∃ c : L, c = algebraMap A L (algebraMap W A g₁) /
      algebraMap A L (algebraMap W A g₂) := ⟨_, rfl⟩
  have hG₁ : algebraMap A L (algebraMap W A g₁) = c * algebraMap A L (algebraMap W A g₂) := by
    rw [hc, div_mul_cancel₀ _ hG₂0]
  have hcK : c = algebraMap K L (algebraMap A K (algebraMap W A g₁) /
      algebraMap A K (algebraMap W A g₂)) := by
    rw [hc, map_div₀, IsScalarTower.algebraMap_apply A K L (algebraMap W A g₁),
      IsScalarTower.algebraMap_apply A K L (algebraMap W A g₂)]
  refine ⟨β₀ - c, a₀ * algebraMap W A g₂ ^ (m + 1) - d₀ * (algebraMap W A g₁ ^ (m + 1) -
      algebraMap W A g₁ * algebraMap W A g₂ ^ m), d₀ * algebraMap W A g₂ ^ (m + 1), ?_, ?_, ?_, ?_⟩
  · rintro ⟨k, hk⟩
    apply hβ₀
    refine ⟨k + algebraMap A K (algebraMap W A g₁) / algebraMap A K (algebraMap W A g₂), ?_⟩
    rw [map_add, hk, ← hcK]
    ring
  · apply hinjW
    have hx₁ : algebraMap W Ω g₁ = γ * algebraMap W Ω g₂ := by
      rw [← hγeq, div_mul_cancel₀ _ hx₂0]
    have hlam : ed * (γ ^ (m + 1) - γ) = ea := by
      rw [hγ']; field_simp
    simp only [map_mul, map_sub, map_pow, hevW, map_zero]
    rw [← hea, ← hed, hx₁]
    linear_combination (-(algebraMap W Ω g₂ ^ (m + 1))) * hlam
  · rw [map_mul, map_pow, hevW]
    exact mul_ne_zero hd₀ (pow_ne_zero _ hg₂0)
  · simp only [map_mul, map_sub, map_pow]
    rw [hG₁, sub_pow_char]
    linear_combination (algebraMap A L (algebraMap W A g₂) ^ (m + 1)) * hid

theorem wcLlsAS_dsbu_etale_chart_delta : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] (𝔭 : Ideal A) (t : A) (c r₀ : ↥W),
    wcLlsPD W A 𝔭 (.disc t) → c ∈ IsLocalRing.maximalIdeal ↥W →
    r₀ ∈ IsLocalRing.maximalIdeal ↥W → r₀ ≠ 0 → ((ℓ : ℕ) : K) = 0 → Module.finrank K L = ℓ →
    ∀ β : L, β ∉ Set.range (algebraMap K L) →
    ∀ (p q : ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀})) (s₀ : A), s₀ ∉ 𝔭 →
      q - algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) s₀ ∈ wcLlsScN W A K t c r₀ →
      (β ^ ℓ - β) * algebraMap K L (q : K) = algebraMap K L (p : K) →
    ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) L)) [Q.IsPrime],
      Q.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) L)) =
        wcLlsScN W A K t c r₀ →
      wcpaDjLkDelta (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
        ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) Q) = 0 :=
by
  intro Ω _ _ W hW hWt ℓ hℓ A _ _ _ K _ _ _ L _ _ _ _ _ 𝔭 t c r₀ hPD hc hr₀ hr₀0 hK hdeg
    β hβ p q s₀ hs₀ hqN hpq Q _ hQ

  have s11 : ∀ (B : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B],
      wcpaDjLkDelta B = 0 := by
    intro B _ _ _
    unfold wcpaDjLkDelta
    rw [Module.length_eq_zero_iff]
    have htop : LinearMap.range
        (Algebra.linearMap B ↥(integralClosure B (FractionRing B))) = ⊤ := by
