    rw [← map_mul, huv]
  have hF : algebraMap A K z * algebraMap A K 1 = algebraMap A K z := by
    rw [map_one, mul_one]

  have hprod : ∀ (x y m : A) (a b : ℕ) (e r h e' r' h' : A), e ∉ 𝔭 → e' ∉ 𝔭 →
      ∃ E R H : A, E ∉ 𝔭 ∧ (x ^ a * e + y * r + m * h) * (x ^ b * e' + y * r' + m * h') =
        x ^ (a + b) * E + y * R + m * H := by
    intro x y m a b e r h e' r' h' he he'
    exact ⟨e * e', r * (x ^ b * e' + y * r' + m * h') + x ^ a * e * r',
      h * (x ^ b * e' + y * r' + m * h') + x ^ a * e * h', hmul _ _ he he', by ring⟩
  have hpow : ∀ (x y m e h : A), e ∉ 𝔭 → ∀ n : ℕ, ∃ e' r' h' : A, e' ∉ 𝔭 ∧
