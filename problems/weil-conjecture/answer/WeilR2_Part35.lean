      have hxn : x ^ n = z * ρ ^ m' := by
        calc x ^ n = z ^ (a * n) / U ^ (m' * n) := by
                rw [hx, div_pow, ← pow_mul, ← pow_mul]
          _ = z * (z ^ (k + 1)) ^ m' / U ^ (m' * n) := by
                rw [hBez, pow_add, pow_one, ← pow_mul, mul_comm m' (k + 1)]
          _ = z * (U ^ n * ρ) ^ m' / U ^ (m' * n) := by rw [hzρ]
          _ = z * ρ ^ m' := by
                rw [mul_pow, ← pow_mul, mul_comm n m']
                field_simp
      have hw1 : w ^ (k + 1) * z ^ (k + 1) = 1 := by rw [← mul_pow, hwz, one_pow]
      have hw2 : w * z ^ (k + 1) = z ^ k := by rw [pow_succ', ← mul_assoc, hwz, one_mul]
      have key : D' * ρ = D * (1 - lam * z ^ k) := by
        apply mul_left_cancel₀ (pow_ne_zero n hU)
        linear_combination (-D') * hzρ - z ^ (k + 1) * hE + U ^ n * D * hw1 -
          U ^ n * D * lam * hw2
      refine ⟨a, m', x, ρ, ha1, haℓ, hBez, hρ0, hxl, ?_, ?_⟩
      · have hxnk : x ^ (n * k) = z ^ k * ρ ^ (m' * k) := by
          rw [pow_mul, hxn, mul_pow, ← pow_mul]
        rw [hxnk, pow_succ]
        linear_combination ρ ^ (m' * k) * key
      · rw [hx, div_mul_cancel₀ _ (pow_ne_zero m' hU), hz, ← mul_pow, inv_mul_cancel₀ hw, one_pow]
    obtain ⟨a, m', x, ρ, ha1, haℓ, hBez, hρ0, hxl, hrel, hxuw⟩ := pole _ _ _ _ _ hw0 hU0 hEL
    have hwK : algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h) ∉
        Set.range (algebraMap K L) := by
      rintro ⟨k0, hk0⟩
      apply hα
      refine ⟨h + k0 / algebraMap A K (algebraMap ↥W A μ), ?_⟩
      rw [map_add, map_div₀, hk0]
      field_simp
      ring
    have hxK : x ∉ Set.range (algebraMap K L) := by
      rintro ⟨k0, hk0⟩
      have h1 : x * algebraMap K L (algebraMap A K U ^ m') *
          (algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h)) ^ a = 1 := by
        rw [map_pow]; exact hxuw
      rw [← hk0] at h1
      have hwa : (algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h)) ^ a =
          algebraMap K L ((k0 * algebraMap A K U ^ m')⁻¹) := by
        rw [map_inv₀, map_mul]; exact eq_inv_of_mul_eq_one_right h1
      have haev : Polynomial.aeval
          (algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h))
          (Polynomial.X ^ a - Polynomial.C ((k0 * algebraMap A K U ^ m')⁻¹)) = 0 := by
        rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, hwa, sub_self]
      have hint : IsIntegral K
          (algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h)) :=
        Algebra.IsIntegral.isIntegral _
      have hdeg : (minpoly K
          (algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h))).natDegree
            ≤ a :=
        (Polynomial.natDegree_le_of_dvd (minpoly.dvd K _ haev)
          (Polynomial.X_pow_sub_C_ne_zero (by omega) _)).trans Polynomial.natDegree_X_pow_sub_C.le
      have hfr := IntermediateField.adjoin.finrank hint
      have hdvd : Module.finrank K (IntermediateField.adjoin K
          {algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h)}) ∣ k + 1 :=
        ⟨_, ((Module.finrank_mul_finrank K (IntermediateField.adjoin K
          {algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h)}) L).trans
            hfin).symm⟩
      rcases hℓ.eq_one_or_self_of_dvd _ hdvd with h2 | h2
      · apply hwK
        have hb := IntermediateField.finrank_eq_one_iff.mp h2
        have hmem := IntermediateField.mem_adjoin_simple_self K
          (algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h))
        rw [hb] at hmem
        exact IntermediateField.mem_bot.mp hmem
      · omega
    have hjinj : Function.Injective ((algebraMap A K).comp (algebraMap ↥W A)) := by
      intro x₁ x₂ hx12
      by_contra hne
      apply hinj (x₁ - x₂) (sub_ne_zero.mpr hne)
      simp only [RingHom.comp_apply] at hx12
      rw [map_sub, map_sub, hx12, sub_self]
