        (algebraMap A _ h * q) ^ n =
      algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) L r := by
    intro x
    obtain ⟨r, n, hr⟩ := hPfrac x
    refine ⟨r, n, ?_⟩
