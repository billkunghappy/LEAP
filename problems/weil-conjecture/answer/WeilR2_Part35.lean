  have hv : algebraMap A K v = algebraMap A K (algebraMap ↥W A g) * (algebraMap A K u)⁻¹ :=
    (eq_mul_inv_iff_mul_eq₀ huK).mpr (by rw [← map_mul, mul_comm, huv])
