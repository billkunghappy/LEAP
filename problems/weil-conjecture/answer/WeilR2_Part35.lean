          (fun w : ↥W => algebraMap A K (algebraMap ↥W A w)) ''
            (IsLocalRing.maximalIdeal ↥W : Set ↥W))) with hI
    have hBr3 : ∀ x ∈ Set.range (algebraMap A' K), ∃ p q : ↥(Algebra.adjoin A {s}),
        q ∉ I ∧ x * (q : K) = p := hBr.2.2
    have hsR : s ∈ Algebra.adjoin A {s} := Algebra.subset_adjoin (Set.mem_singleton s)
    have hsI : (⟨s, hsR⟩ : ↥(Algebra.adjoin A {s})) ∈ I :=
      Ideal.subset_span (Set.mem_preimage.mpr (Set.mem_union_left _ (Set.mem_insert_of_mem _ rfl)))
    have hUI : algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c) ∈ I :=
      Ideal.subset_span (Set.mem_preimage.mpr (Set.mem_union_left _
        (by rw [Subalgebra.coe_algebraMap]; exact Set.mem_insert _ _)))
    have hwI : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
        algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w) ∈ I := fun w hw =>
      Ideal.subset_span (Set.mem_preimage.mpr (Set.mem_union_right _
