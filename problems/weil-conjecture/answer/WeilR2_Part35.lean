        (algebraMap A K (u ^ k * ε + v * r + algebraMap ↥W A w' * h) *
          algebraMap A K (algebraMap ↥W A α) * algebraMap A K a) * key
  ·
    intro hN
    obtain ⟨M, hM⟩ : ∃ M : ℕ, (-N).toNat = M := ⟨_, rfl⟩
    have hNM : N = -(M : ℤ) := by omega
    rw [hM]
    rw [hNM, zpow_neg, zpow_natCast] at hfac
    have key : algebraMap A K u ^ M * (algebraMap A K u ^ M)⁻¹ = 1 :=
      mul_inv_cancel₀ (pow_ne_zero _ huK)
    obtain ⟨w'', hw''m, hw''⟩ := hcd (fun t => t.2.1) L (fun t ht => (hL t ht).2.1)
    obtain ⟨k', ε', r', h', hε', hV⟩ := hVb w'' L hw'' (fun t ht => (hL t ht).2.2)
    have hPD2 := wcpa_dj_llsm_kpwic_pd_swap W A 𝔭 u v g hPD
    refine (wcpa_dj_llsm_kpwulb_nf_bound Ω W hW hWt A K 𝔭 v u g hPD2 (algebraMap A K z) z 1
      h1 hF (α * (L.map (fun t => t.1 ^ t.2.2)).prod) (w * g ^ M) w''
      (L.map (fun t => t.2.2)).sum (k' + M) (ε' * a) σ (r' * v ^ M * a) 0 (h' * v ^ M * a) 0
      ⟨mul_ne_zero hα0 (hκ L (fun t ht => (hL t ht).2.2)), mul_ne_zero hw0 (pow_ne_zero _ hg0),
        hw''m, hmul _ _ hε' ha, hσ, ?_⟩).1
    rw [show v ^ (k' + M) * (ε' * a) + u * (r' * v ^ M * a) +
          algebraMap ↥W A w'' * (h' * v ^ M * a)
        = (v ^ k' * ε' + u * r' + algebraMap ↥W A w'' * h') * v ^ M * a by ring,
      show v ^ (L.map (fun t => t.2.2)).sum * σ + u * 0 + algebraMap ↥W A w'' * 0
        = v ^ (L.map (fun t => t.2.2)).sum * σ by ring]
    simp only [map_mul, map_pow]
    rw [hgK]
    linear_combination
      (algebraMap A K v ^ (L.map (fun t => t.2.2)).sum * algebraMap A K u ^ M *
        algebraMap A K v ^ M) * hfac +
      (algebraMap A K (algebraMap ↥W A α) * algebraMap A K v ^ M * algebraMap A K a *
        (L.map (fun t => algebraMap A K (u - algebraMap ↥W A t.1) ^ t.2.2)).prod *
        algebraMap A K v ^ (L.map (fun t => t.2.2)).sum) * key +
      (algebraMap A K (algebraMap ↥W A α) * algebraMap A K v ^ M * algebraMap A K a) * hV

theorem wcpa_dj_llsm_kpwmgc_cell_product : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ (b : ↥W → Bool) (L : List (↥W × ↥W × ℕ)) (c₁ c₂ : ↥W), c₁ ≠ 0 →
      (∀ t ∈ L, (b t.1 = true → t.1 ∣ c₁) ∧ (b t.1 = false → c₂ ∣ t.1)) →
      ∃ (E : ↥(wcLlsInnerCR W A K u c₁ c₂)) (e : A), e ∉ 𝔭 ∧
        E - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) e ∈ wcLlsInnerCN W A K u c₁ c₂ ∧
        (L.map (fun t => algebraMap A K (u - algebraMap ↥W A t.1) ^ t.2.2)).prod =
          algebraMap A K (algebraMap ↥W A
              (L.map (fun t => if b t.1 then t.1 ^ t.2.2 else 1)).prod) *
            algebraMap A K u ^ (L.map (fun t => if b t.1 then 0 else t.2.2)).sum * (E : K) :=
by
  classical
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 u v g hPD b L c₁ c₂ hc₁0
  have hPD' := hPD
  obtain ⟨-, htf, -, h𝔭max, -, hg, hg0, huv, -⟩ := hPD'
  have h𝔭 : 𝔭.IsPrime := h𝔭max.isPrime
  have hinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hWinj : ∀ x : ↥W, x ≠ 0 → algebraMap ↥W A x ≠ 0 := by
    intro x hx h
    rw [Algebra.algebraMap_eq_smul_one] at h
    rcases smul_eq_zero.mp h with h | h
    · exact hx h
    · exact one_ne_zero h
  have hjW : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 :=
    fun x hx => (map_ne_zero_iff _ hinj).mpr (hWinj x hx)
  have hu0 : u ≠ 0 := by
    rintro rfl
    rw [zero_mul] at huv
    exact hWinj g hg0 huv.symm
  have huK : algebraMap A K u ≠ 0 := (map_ne_zero_iff _ hinj).mpr hu0
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h => h𝔭.ne_top ((Ideal.eq_top_iff_one 𝔭).mpr h)

  have Gmul : ∀ (r r' : ↥(wcLlsInnerCR W A K u c₁ c₂)) (e e' : A), e ∉ 𝔭 →
      r - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) e ∈ wcLlsInnerCN W A K u c₁ c₂ →
      e' ∉ 𝔭 →
      r' - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) e' ∈ wcLlsInnerCN W A K u c₁ c₂ →
      e * e' ∉ 𝔭 ∧ r * r' - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (e * e') ∈
        wcLlsInnerCN W A K u c₁ c₂ := by
    intro r r' e e' he hr he' hr'
    refine ⟨fun h => (h𝔭.mem_or_mem h).elim he he', ?_⟩
    have hh : r * r' - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (e * e') =
        (r - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) e) * r' +
          algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) e *
            (r' - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) e') := by
      rw [map_mul]; ring
    rw [hh]
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hr) (Ideal.mul_mem_left _ _ hr')
  have Gpow : ∀ (r : ↥(wcLlsInnerCR W A K u c₁ c₂)) (e : A), e ∉ 𝔭 →
      r - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) e ∈ wcLlsInnerCN W A K u c₁ c₂ →
      ∀ n : ℕ, e ^ n ∉ 𝔭 ∧ r ^ n - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (e ^ n) ∈
        wcLlsInnerCN W A K u c₁ c₂ := by
    intro r e he hr n
    induction n with
    | zero =>
      refine ⟨by rw [pow_zero]; exact h1𝔭, ?_⟩
      rw [pow_zero, pow_zero, map_one, sub_self]
      exact Ideal.zero_mem _
    | succ n ih =>
      rw [pow_succ, pow_succ]
      exact Gmul _ _ _ _ ih.1 ih.2 he hr

  have B1 : ∀ c r : ↥W, c₁ = c * r → ∃ F : ↥(wcLlsInnerCR W A K u c₁ c₂),
      F - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (-1) ∈ wcLlsInnerCN W A K u c₁ c₂ ∧
      algebraMap A K (u - algebraMap ↥W A c) =
        algebraMap A K (algebraMap ↥W A c) * (F : K) := by
    intro c r hr
    obtain ⟨S1, hS1v, hS1⟩ : ∃ S1 : ↥(wcLlsInnerCR W A K u c₁ c₂),
        (S1 : K) = wcLlsInnerS₁ W A K u c₁ ∧ S1 ∈ wcLlsInnerCN W A K u c₁ c₂ :=
      ⟨⟨wcLlsInnerS₁ W A K u c₁, Algebra.subset_adjoin (Set.mem_insert _ _)⟩, rfl, by
        unfold wcLlsInnerCN
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))⟩
    refine ⟨algebraMap A _ (algebraMap ↥W A r) * S1 - 1, ?_, ?_⟩
    · have hh : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A r) * S1 - 1 -
          algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (-1) =
            algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A r) * S1 := by
        rw [map_neg, map_one]; ring
      rw [hh]
      exact Ideal.mul_mem_left _ _ hS1
    · have hinv : algebraMap A K (algebraMap ↥W A c₁) * (algebraMap A K (algebraMap ↥W A c₁))⁻¹
          = 1 := mul_inv_cancel₀ (hjW c₁ hc₁0)
      have hr' : algebraMap A K (algebraMap ↥W A c₁) =
          algebraMap A K (algebraMap ↥W A c) * algebraMap A K (algebraMap ↥W A r) := by
        rw [hr, map_mul, map_mul]
      simp only [Subalgebra.coe_one, Subalgebra.coe_sub, Subalgebra.coe_mul,
        Subalgebra.coe_algebraMap, hS1v, map_sub, wcLlsInnerS₁, div_eq_mul_inv]
      linear_combination (-(algebraMap A K u)) * hinv +
        (algebraMap A K u * (algebraMap A K (algebraMap ↥W A c₁))⁻¹) * hr'

  have B2 : ∀ c r : ↥W, c = c₂ * r → ∃ F : ↥(wcLlsInnerCR W A K u c₁ c₂),
      F - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) 1 ∈ wcLlsInnerCN W A K u c₁ c₂ ∧
      algebraMap A K (u - algebraMap ↥W A c) = algebraMap A K u * (F : K) := by
    intro c r hr
    obtain ⟨S2, hS2v, hS2⟩ : ∃ S2 : ↥(wcLlsInnerCR W A K u c₁ c₂),
        (S2 : K) = wcLlsInnerS₂ W A K u c₂ ∧ S2 ∈ wcLlsInnerCN W A K u c₁ c₂ :=
      ⟨⟨wcLlsInnerS₂ W A K u c₂,
          Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩, rfl, by
        unfold wcLlsInnerCN
        exact Ideal.mem_sup_left
          (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))⟩
    refine ⟨1 - algebraMap A _ (algebraMap ↥W A r) * S2, ?_, ?_⟩
    · have hh : 1 - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A r) * S2 -
          algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) 1 =
            -(algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A r) * S2) := by
        rw [map_one]; ring
      rw [hh]
      exact neg_mem (Ideal.mul_mem_left _ _ hS2)
    · have hinvu : algebraMap A K u * (algebraMap A K u)⁻¹ = 1 := mul_inv_cancel₀ huK
      have hc' : algebraMap A K (algebraMap ↥W A c) =
          algebraMap A K (algebraMap ↥W A c₂) * algebraMap A K (algebraMap ↥W A r) := by
        rw [hr, map_mul, map_mul]
      simp only [Subalgebra.coe_one, Subalgebra.coe_sub, Subalgebra.coe_mul,
        Subalgebra.coe_algebraMap, hS2v, map_sub, wcLlsInnerS₂, div_eq_mul_inv]
      linear_combination (algebraMap A K (algebraMap ↥W A c₂) *
        algebraMap A K (algebraMap ↥W A r)) * hinvu - hc'

  induction L with
  | nil =>
    intro _
    refine ⟨1, 1, h1𝔭, ?_, ?_⟩
    · rw [map_one, sub_self]; exact Ideal.zero_mem _
    · simp
  | cons t L' ih =>
    intro hside
    rw [List.forall_mem_cons] at hside
    obtain ⟨⟨htt, htf'⟩, hL'⟩ := hside
    obtain ⟨E₀, e₀, he₀, hE₀, hP₀⟩ := ih hL'
    simp only [List.map_cons, List.prod_cons, List.sum_cons]
    rcases Bool.eq_false_or_eq_true (b t.1) with hb | hb
    · obtain ⟨r, hr⟩ := htt hb
      obtain ⟨F, hF, hFK⟩ := B1 t.1 r hr
      have hm1 : (-1 : A) ∉ 𝔭 := fun h => h1𝔭 (neg_mem_iff.mp h)
      obtain ⟨hpn, hFn⟩ := Gpow F (-1) hm1 hF t.2.2
      obtain ⟨hprod, hEprod⟩ := Gmul _ _ _ _ hpn hFn he₀ hE₀
      refine ⟨F ^ t.2.2 * E₀, (-1) ^ t.2.2 * e₀, hprod, hEprod, ?_⟩
      rw [if_pos hb, if_pos hb, hP₀, hFK]
      simp only [map_mul, map_pow, Subalgebra.coe_mul, Subalgebra.coe_pow, zero_add]
      ring
    · obtain ⟨r, hr⟩ := htf' hb
      obtain ⟨F, hF, hFK⟩ := B2 t.1 r hr
      obtain ⟨hpn, hFn⟩ := Gpow F 1 h1𝔭 hF t.2.2
      obtain ⟨hprod, hEprod⟩ := Gmul _ _ _ _ hpn hFn he₀ hE₀
      refine ⟨F ^ t.2.2 * E₀, 1 ^ t.2.2 * e₀, hprod, hEprod, ?_⟩
      have hnt : ¬ (b t.1 = true) := by simp [hb]
      rw [if_neg hnt, if_neg hnt, hP₀, hFK]
      simp only [map_mul, map_pow, map_one, Subalgebra.coe_mul, Subalgebra.coe_pow, pow_add]
      ring

theorem wcpa_dj_llsm_kpwmg_cut_monomial : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ (t₁ τ : ↥W) (P : ↥W → Prop), t₁ ∈ IsLocalRing.maximalIdeal ↥W → t₁ ≠ 0 → τ ∣ g →
      ¬ g ∣ τ → P t₁ → ¬ P τ → (∀ x y : ↥W, P x → y ∣ x → P y) →
      (∀ x : ↥W, P x → ∃ x' : ↥W, P x' ∧ x ∣ x' ∧ ¬ x' ∣ x) →
      (∀ y : ↥W, ¬ P y → ∃ y' : ↥W, ¬ P y' ∧ y' ∣ y ∧ ¬ y ∣ y') →
    ∀ z : A, z ≠ 0 → ∃ (σ : A) (lam : ↥W) (j : ℤ) (x₀ y₀ : ↥W), σ ∉ 𝔭 ∧ lam ≠ 0 ∧
      (j < 0 → g ^ (-j).toNat ∣ lam) ∧ P x₀ ∧ ¬ P y₀ ∧
      ∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
        c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
        x₀ ∣ c₁ → c₂ ∣ y₀ →
        ∃ E : ↥(wcLlsInnerCR W A K u c₁ c₂), E ∉ wcLlsInnerCN W A K u c₁ c₂ ∧
          algebraMap A K σ * algebraMap A K z =
            algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j * (E : K) :=
by
  classical
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 u v g hPD t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁ hPτ hdown
    hnomax hnomin z hz
  have hPD' := hPD
  obtain ⟨-, htf, -, h𝔭max, -, hg, hg0, huv, -⟩ := hPD'
  have h𝔭 : 𝔭.IsPrime := h𝔭max.isPrime
  have hinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hWinj : ∀ x : ↥W, x ≠ 0 → algebraMap ↥W A x ≠ 0 := by
    intro x hx h
    rw [Algebra.algebraMap_eq_smul_one] at h
    rcases smul_eq_zero.mp h with h | h
    · exact hx h
    · exact one_ne_zero h
  have hjW : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 :=
    fun x hx => (map_ne_zero_iff _ hinj).mpr (hWinj x hx)
  have hu0 : u ≠ 0 := by
    rintro rfl
    rw [zero_mul] at huv
    exact hWinj g hg0 huv.symm
  have huK : algebraMap A K u ≠ 0 := (map_ne_zero_iff _ hinj).mpr hu0

  obtain ⟨L, w, α, N, s, a, hw0, hα0, hs, ha, hL, hfac⟩ :=
    wcpa_dj_llsm_kpwmgc_tube_monomial Ω W hW hWt A K 𝔭 u v g hPD z hz

  obtain ⟨hwα, hneg⟩ := wcpa_dj_llsm_kpwmgc_bdry_integral Ω W hW hWt A K 𝔭 u v g hPD z s a L
    w α N hz hs ha hw0 hα0 hL hfac
  obtain ⟨β, rfl⟩ := hwα
  have hβ0 : β ≠ 0 := fun h => hα0 (by rw [h, mul_zero])
  have hL' : ∀ t ∈ L, t.1 * t.2.1 = g := fun t ht => (hL t ht).2.2

  obtain ⟨b, hbt⟩ : ∃ b : ↥W → Bool, ∀ x, b x = true ↔ P x :=
    ⟨fun x => decide (P x), fun x => decide_eq_true_iff⟩
  have hbf : ∀ x, b x = false ↔ ¬ P x := fun x => by rw [← hbt, Bool.not_eq_true]
  have LF1 : ∀ L' : List (↥W × ↥W × ℕ),
      (L'.map (fun t => if b t.1 then t.1 ^ t.2.2 else 1)).prod *
        (L'.map (fun t => if b t.1 then 1 else t.1 ^ t.2.2)).prod =
        (L'.map (fun t => t.1 ^ t.2.2)).prod := by
    intro L'
    induction L' with
    | nil => simp
    | cons t L' ih =>
      simp only [List.map_cons, List.prod_cons]
      rw [← ih]
      split_ifs <;> ring
  have LF2 : ∀ L' : List (↥W × ↥W × ℕ), (∀ t ∈ L', t.1 * t.2.1 = g) →
      (L'.map (fun t => if b t.1 then 1 else t.1 ^ t.2.2)).prod ∣
        g ^ (L'.map (fun t => if b t.1 then 0 else t.2.2)).sum := by
    intro L'
    induction L' with
    | nil => intro _; simp
    | cons t L' ih =>
      intro h
      rw [List.forall_mem_cons] at h
      obtain ⟨h1, h2⟩ := h
      have ih' := ih h2
      simp only [List.map_cons, List.prod_cons, List.sum_cons]
      split_ifs
      · rw [zero_add, one_mul]; exact ih'
      · rw [pow_add]; exact mul_dvd_mul (pow_dvd_pow_of_dvd (Dvd.intro _ h1) _) ih'
  have LF3 : ∀ L' : List (↥W × ↥W × ℕ), (∀ t ∈ L', t.1 * t.2.1 = g) →
      (L'.map (fun t => if b t.1 then t.1 ^ t.2.2 else 1)).prod ≠ 0 := by
    intro L'
    induction L' with
    | nil => intro _; simp
    | cons t L' ih =>
      intro h
      rw [List.forall_mem_cons] at h
      obtain ⟨h1, h2⟩ := h
      have hc0 : t.1 ≠ 0 := fun h0 => hg0 (by rw [← h1, h0, zero_mul])
      simp only [List.map_cons, List.prod_cons]
      split_ifs
      · exact mul_ne_zero (pow_ne_zero _ hc0) (ih h2)
      · rw [one_mul]; exact ih h2

  have GX : ∀ L' : List (↥W × ↥W × ℕ), ∃ x₀ : ↥W, P x₀ ∧ ∀ t ∈ L', P t.1 → t.1 ∣ x₀ := by
    intro L'
    induction L' with
    | nil => exact ⟨t₁, hPt₁, fun t ht => by simp at ht⟩
    | cons t L' ih =>
      obtain ⟨x, hx, hxL⟩ := ih
      by_cases hPt : P t.1
      · rcases ValuationRing.dvd_total x t.1 with h | h
        · refine ⟨t.1, hPt, ?_⟩
          intro t' ht' hPt'
          rcases List.mem_cons.mp ht' with h' | h'
          · rw [h']
          · exact dvd_trans (hxL t' h' hPt') h
        · refine ⟨x, hx, ?_⟩
          intro t' ht' hPt'
          rcases List.mem_cons.mp ht' with h' | h'
          · rw [h']; exact h
          · exact hxL t' h' hPt'
      · refine ⟨x, hx, ?_⟩
        intro t' ht' hPt'
        rcases List.mem_cons.mp ht' with h' | h'
        · rw [h'] at hPt'; exact absurd hPt' hPt
        · exact hxL t' h' hPt'
  have GY : ∀ L' : List (↥W × ↥W × ℕ), ∃ y₀ : ↥W, ¬ P y₀ ∧ ∀ t ∈ L', ¬ P t.1 → y₀ ∣ t.1 := by
    intro L'
    induction L' with
    | nil => exact ⟨τ, hPτ, fun t ht => by simp at ht⟩
    | cons t L' ih =>
      obtain ⟨y, hy, hyL⟩ := ih
      by_cases hPt : P t.1
      · refine ⟨y, hy, ?_⟩
        intro t' ht' hPt'
        rcases List.mem_cons.mp ht' with h' | h'
        · rw [h'] at hPt'; exact absurd hPt hPt'
        · exact hyL t' h' hPt'
      · rcases ValuationRing.dvd_total t.1 y with h | h
        · refine ⟨t.1, hPt, ?_⟩
          intro t' ht' hPt'
          rcases List.mem_cons.mp ht' with h' | h'
          · rw [h']
          · exact dvd_trans h (hyL t' h' hPt')
        · refine ⟨y, hy, ?_⟩
          intro t' ht' hPt'
          rcases List.mem_cons.mp ht' with h' | h'
          · rw [h']; exact h
          · exact hyL t' h' hPt'
  obtain ⟨x₀, hPx₀, hxL⟩ := GX L
  obtain ⟨y₀, hPy₀, hyL⟩ := GY L
  obtain ⟨m, hm⟩ : ∃ m : ℕ, (L.map (fun t => if b t.1 then 0 else t.2.2)).sum = m := ⟨_, rfl⟩
  obtain ⟨κ, hκ⟩ : ∃ κ : ↥W, (L.map (fun t => if b t.1 then t.1 ^ t.2.2 else 1)).prod = κ :=
    ⟨_, rfl⟩
  have LF1' := LF1 L
  have LF2' := LF2 L hL'
  have LF3' := LF3 L hL'
  rw [hκ] at LF1' LF3'
  rw [hm] at LF2'

  refine ⟨s, β * κ, N + (m : ℤ), x₀, y₀, hs, mul_ne_zero hβ0 LF3', ?_, hPx₀, hPy₀, ?_⟩
  · intro hj
    have hN : N < 0 := by omega
    have hM := hneg hN
    rw [← LF1', mul_assoc] at hM
    have h1 := (mul_dvd_mul_iff_left hw0).mp hM
    have h2 : β * (κ * (L.map (fun t => if b t.1 then 1 else t.1 ^ t.2.2)).prod) ∣
        β * κ * g ^ m := by
      rw [mul_assoc]
      exact mul_dvd_mul_left _ (mul_dvd_mul_left _ LF2')
    have hMeq : (-N).toNat = (-(N + (m : ℤ))).toNat + m := by omega
    have h3 : g ^ (-(N + (m : ℤ))).toNat * g ^ m ∣ β * κ * g ^ m := by
      rw [← pow_add, ← hMeq]
      exact dvd_trans h1 h2
    exact (mul_dvd_mul_iff_right (pow_ne_zero _ hg0)).mp h3

  · intro c₁ c₂ hc₁m hc₁0 hc₂m hc₂0 h12 h21 h2g hx₀ hy₀
    have side : ∀ t ∈ L, (b t.1 = true → t.1 ∣ c₁) ∧ (b t.1 = false → c₂ ∣ t.1) :=
      fun t ht => ⟨fun h => dvd_trans (hxL t ht ((hbt _).mp h)) hx₀,
        fun h => dvd_trans hy₀ (hyL t ht ((hbf _).mp h))⟩
    obtain ⟨E₀, e₀, he₀, hE₀, hPi⟩ := wcpa_dj_llsm_kpwmgc_cell_product Ω W hW hWt A K 𝔭 u v g
      hPD b L c₁ c₂ hc₁0 side
    rw [hκ, hm] at hPi
    refine ⟨E₀ * algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a, ?_, ?_⟩
    · have hea : e₀ * a ∉ 𝔭 := fun h => (h𝔭.mem_or_mem h).elim he₀ ha
      have hmem : E₀ * algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a -
          algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (e₀ * a) ∈
          wcLlsInnerCN W A K u c₁ c₂ := by
        have e : E₀ * algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a -
            algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (e₀ * a) =
            (E₀ - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) e₀) *
              algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a := by
          rw [map_mul]; ring
        rw [e]
        exact Ideal.mul_mem_right _ _ hE₀
      have h := wcpa_dj_llsm_kpwul_inner_unit Ω W hW hWt A K 𝔭 u v g hPD c₁ c₂ hc₁m hc₁0
        hc₂m hc₂0 h12 h21 h2g (e₀ * a) hea _ hmem
      have e : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (e₀ * a) +
          (E₀ * algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a -
            algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (e₀ * a)) =
          E₀ * algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a := by ring
      rwa [e] at h
    · rw [hPi] at hfac
      simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, map_mul] at hfac ⊢
      rw [zpow_add₀ huK, zpow_natCast]
      apply mul_left_cancel₀ (hjW w hw0)
      linear_combination hfac

theorem wcpa_dj_llsm_kpwmgb_start : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ (f' : K) (a s : A), a ∉ 𝔭 → s ∉ 𝔭 → f' * algebraMap A K s = algebraMap A K a →
    ∀ (t₁ τ : ↥W) (P : ↥W → Prop), t₁ ∈ IsLocalRing.maximalIdeal ↥W → t₁ ≠ 0 → τ ∣ g →
      ¬ g ∣ τ → P t₁ → ¬ P τ → (∀ x y : ↥W, P x → y ∣ x → P y) →
      (∀ x : ↥W, P x → ∃ x' : ↥W, P x' ∧ x ∣ x' ∧ ¬ x' ∣ x) →
      (∀ y : ↥W, ¬ P y → ∃ y' : ↥W, ¬ P y' ∧ y' ∣ y ∧ ¬ y ∣ y') →
