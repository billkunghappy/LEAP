    exact h
  have t_s9 : ∀ (E B C : Type u) [CommRing E] [CommRing B] [CommRing C] [Algebra E B] [Algebra B C] (h : E) [IsLocalization.Away h B] (P : Ideal E) [P.IsPrime] (b : B) [IsLocalization.Away b C] (g₀ : E) (hh : h ∉ P) (hb : b ∉ P.map (algebraMap E B)) (hg₀ : g₀ ∉ P), ∃ g : E, g ∉ P ∧ g₀ ∣ g ∧ ∃ ψ : C →+* Localization.Away g, ψ.comp ((algebraMap B C).comp (algebraMap E B)) = algebraMap E (Localization.Away g) ∧ RingHom.Etale ψ := by
    intro E B C _ _ _ _ _ h _ P _ b _ g₀ hh hb hg₀
    obtain ⟨n, s₀, hs₀⟩ := IsLocalization.Away.surj h b
    obtain ⟨v, hv⟩ : IsUnit (algebraMap E B h ^ n) :=
      (IsLocalization.Away.algebraMap_isUnit h).pow n
