    (ρ₁ * algebraMap A _ (algebraMap ↥W A t₁) ^ A₂ *
      (algebraMap A _ (algebraMap ↥W A a₁) * s₁) ^ (A₁ + A₂)) (by
      simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap, hs₁c]
      rw [hU]
      linear_combination (algebraMap A K (algebraMap ↥W A t₁) ^ A₂ *
        (algebraMap A K (algebraMap ↥W A a₁) * wcLlsInnerS₁ W A K u c₁) ^ (A₁ + A₂)) * hρ₁)

  have hUV : algebraMap A K u * algebraMap A K v = algebraMap A K (algebraMap ↥W A g) := by
    rw [← map_mul, huv]
  have hgq : algebraMap A K (algebraMap ↥W A g) =
      algebraMap A K (algebraMap ↥W A τ) * algebraMap A K (algebraMap ↥W A q) := by
    rw [hq, map_mul, map_mul]
  have hV : algebraMap A K v = wcLlsInnerS₂ W A K u c₂ * algebraMap A K (algebraMap ↥W A e) *
      algebraMap A K (algebraMap ↥W A q) := by
    apply mul_left_cancel₀ hu0
    linear_combination hUV + hgq + algebraMap A K (algebraMap ↥W A q) * hτe +
      algebraMap A K (algebraMap ↥W A e) * algebraMap A K (algebraMap ↥W A q) * hS₂eq c₂
  obtain ⟨r₂, e₂⟩ := hred (algebraMap A K v ^ (A₁ + A₂))
    (ρ₂ * algebraMap A _ (algebraMap ↥W A q) ^ A₁ *
      (s₂ * algebraMap A _ (algebraMap ↥W A e)) ^ (A₁ + A₂)) (by
      simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap, hs₂c]
      rw [hV]
      linear_combination (algebraMap A K (algebraMap ↥W A q) ^ A₁ *
        (wcLlsInnerS₂ W A K u c₂ * algebraMap A K (algebraMap ↥W A e)) ^ (A₁ + A₂)) * hρ₂)

  obtain ⟨r₃, e₃⟩ := hred (algebraMap A K (algebraMap ↥W A (μ * τ ^ k.toNat * t₁)))
    (algebraMap A _ (algebraMap ↥W A t₁)) (by
      simp only [Subalgebra.coe_algebraMap, map_mul, map_pow])
  exact ⟨r₁, r₂, r₃, e₁, e₂, e₃⟩

theorem wcpa_dj_llsm_kpwmgb_trunc_alg : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) → ∀ (F : K) (a₀ s₀ : A), s₀ ∉ 𝔭 → F * algebraMap A K s₀ = algebraMap A K a₀ → ∀ (N : ℕ) (π : ↥W), 1 ≤ N → π ∈ IsLocalRing.maximalIdeal ↥W → π ≠ 0 → ∃ (B : List (↥W × ℤ)) (σ p₁ p₂ p₃ : A), σ ∉ 𝔭 ∧ (∀ b ∈ B, b.2 < 0 → g ^ (-b.2).toNat ∣ b.1) ∧ algebraMap A K σ * (F - wcKpwmgbLaur W A K u B) = algebraMap A K (u ^ N * p₁ + v ^ N * p₂ + algebraMap ↥W A π * p₃) :=
by
  intro Ω _ _ W hdim hWt A _ _ _ K _ _ _ 𝔭 u v g hPD F a₀ s₀ hs₀ hF N π hN hπm hπ0
  classical
  have hPD' := hPD
  simp only [wcLlsPD] at hPD'
  obtain ⟨hFT, hNZ, _, h𝔭max, h𝔪le, _, hg0, huv, h𝔭eq, _⟩ := hPD'
  haveI := hNZ
  have hφinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hu0 : algebraMap A K u ≠ 0 := by
    intro hc
    have h1 : algebraMap A K (u * v) = 0 := by rw [map_mul, hc, zero_mul]
    rw [huv] at h1
    have h2 : algebraMap ↥W A g = 0 := hφinj (h1.trans (map_zero _).symm)
    rw [Algebra.algebraMap_eq_smul_one] at h2
    exact (smul_ne_zero hg0 one_ne_zero) h2

  obtain ⟨Q, _, φ, hHens, -⟩ := wcpa_dj_llsm_kptf_hens_descent A 𝔭 h𝔭max.isPrime
  have hres := wcpa_dj_llsm_kptf_residue_trivial Ω W A 𝔭 hFT h𝔭max h𝔪le
  obtain ⟨fN, hPres, hX0, hX1⟩ :=
    wcpa_dj_llsm_kptf_hens_chart Ω W A 𝔭 u v g hPD hres Q φ hHens
  obtain ⟨_, hUnits, hUP⟩ := hHens
  have hPres' := hPres
  unfold wcEbntPres at hPres'
  obtain ⟨-, -, hcompC, -⟩ := hPres'

  have hs₀u : IsUnit (φ s₀) := (hUnits s₀).mpr hs₀
  obtain ⟨p, hp⟩ := wcpa_dj_lr1k_ebnt_dms_approx Ω W hdim hWt Q (φ.comp (algebraMap ↥W A)) g fN
    hPres (φ a₀ * ↑(hs₀u.unit⁻¹)) N π hN hπm hπ0
  rw [hX0, hX1, RingHom.comp_apply, ← map_pow φ u N, ← map_pow φ v N] at hp
  obtain ⟨d, a, a', -, hpeq⟩ := wcpa_dj_lr1k_ebnt_dms_reduced_form Ω W g p
  obtain ⟨pA, hpA⟩ : ∃ pA : A, pA = ∑ i ∈ Finset.range (d + 1), algebraMap ↥W A (a i) * u ^ i +
      ∑ j ∈ Finset.range (d + 1), algebraMap ↥W A (a' j) * v ^ (j + 1) := ⟨_, rfl⟩
  have hfp : fN p = φ pA := by
    have hC : ∀ c : ↥W, fN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C g} : Ideal (MvPolynomial (Fin 2) ↥W)) (MvPolynomial.C c)) =
        φ (algebraMap ↥W A c) := by
      intro c
      have := RingHom.congr_fun hcompC c
      simpa only [RingHom.comp_apply] using this
    have hx0 : fN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C g} : Ideal (MvPolynomial (Fin 2) ↥W))
        (MvPolynomial.X (0 : Fin 2))) = φ u := hX0
    have hx1 : fN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C g} : Ideal (MvPolynomial (Fin 2) ↥W))
        (MvPolynomial.X (1 : Fin 2))) = φ v := hX1
    rw [hpA, hpeq]
    simp only [map_add, map_sum, map_mul, map_pow, hC, hx0, hx1]

  have hmemQ : φ (a₀ - s₀ * pA) ∈
      Ideal.span {φ (u ^ N), φ (v ^ N), φ (algebraMap ↥W A π)} := by
    have e : φ (a₀ - s₀ * pA) = φ s₀ * (φ a₀ * ↑(hs₀u.unit⁻¹) - fN p) := by
      rw [hfp, map_sub, map_mul, mul_sub, ← mul_assoc, mul_comm (φ s₀) (φ a₀), mul_assoc,
        IsUnit.mul_val_inv, mul_one]
    rw [e]
    exact Ideal.mul_mem_left _ _ hp

  obtain ⟨I, hIdef⟩ : ∃ I : Ideal A, I = Ideal.span {u ^ N, v ^ N, algebraMap ↥W A π} :=
    ⟨_, rfl⟩
  have hI𝔭 : I ≤ 𝔭 := by
    rw [hIdef, Ideal.span_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rw [SetLike.mem_coe, h𝔭eq]
    rcases hx with rfl | rfl | rfl
    · exact Ideal.pow_mem_of_mem _ (Ideal.mem_sup_left (Ideal.subset_span (by simp))) N
        (by omega)
    · exact Ideal.pow_mem_of_mem _ (Ideal.mem_sup_left (Ideal.subset_span (by simp))) N
        (by omega)
    · exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hπm)
  have h𝔭rad : 𝔭 ≤ I.radical := by
    rw [h𝔭eq]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rw [SetLike.mem_coe]
      rcases hx with hx | hx
      · refine ⟨N, ?_⟩
        rw [hx, hIdef]; exact Ideal.subset_span (by simp)
      · refine ⟨N, ?_⟩
        rw [hx, hIdef]; exact Ideal.subset_span (by simp)
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap]
      by_cases hw0 : w = 0
      · rw [hw0, map_zero]; exact Ideal.zero_mem _
      · obtain ⟨M, c, hc⟩ := wcpa_dj_lr1k_ebnt_dms_rank_one_power Ω W hdim π w hπ0 hw hw0
        refine ⟨M, ?_⟩
        rw [← map_pow, hc, map_mul, hIdef]
        exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
  have hItop : I ≠ ⊤ := fun h => h𝔭max.ne_top (top_le_iff.mp (h ▸ hI𝔭))
  haveI : Nontrivial (A ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hItop
  have hnil : ∀ a ∈ 𝔭, IsNilpotent (Ideal.Quotient.mk I a) := by
    intro a ha
    obtain ⟨n, hn⟩ := h𝔭rad ha
    exact ⟨n, by rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]; exact hn⟩
  have hunit : ∀ a, a ∉ 𝔭 → IsUnit (Ideal.Quotient.mk I a) := by
    intro a ha
    obtain ⟨y, i, hi, hyi⟩ := h𝔭max.exists_inv ha
    have h1 : Ideal.Quotient.mk I y * Ideal.Quotient.mk I a = 1 - Ideal.Quotient.mk I i := by
      rw [eq_sub_iff_add_eq, ← map_mul, ← map_add, hyi, map_one]
    have h2 : IsUnit (Ideal.Quotient.mk I y * Ideal.Quotient.mk I a) := by
      rw [h1]; exact (hnil i hi).isUnit_one_sub
    exact isUnit_of_mul_isUnit_right h2
  have hU : ∀ a : A, IsUnit (Ideal.Quotient.mk I a) ↔ a ∉ 𝔭 :=
    fun a => ⟨fun h ha => (hnil a ha).not_isUnit h, hunit a⟩
  haveI hloc : IsLocalRing (A ⧸ I) := by
    apply IsLocalRing.of_isUnit_or_isUnit_one_sub_self
    intro x
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    by_cases ha : a ∈ 𝔭
    · exact Or.inr (hnil a ha).isUnit_one_sub
    · exact Or.inl (hunit a ha)
  have hmnil : ∀ y ∈ IsLocalRing.maximalIdeal (A ⧸ I), IsNilpotent y := by
    intro y hy
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
    by_cases ha : a ∈ 𝔭
    · exact hnil a ha
    · exact absurd (hunit a ha) (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hy))
  have hH : HenselianLocalRing (A ⧸ I) := by
    refine HenselianLocalRing.mk ?_
    intro f _ x hfx hdf
    obtain ⟨r, ⟨hr1, hr2⟩, -⟩ := Polynomial.existsUnique_nilpotent_sub_and_aeval_eq_zero
      (R := A ⧸ I) (S := A ⧸ I) (P := f) (x := x)
      (by rw [Polynomial.coe_aeval_eq_eval]; exact hmnil _ hfx)
      (by rw [Polynomial.coe_aeval_eq_eval]; exact hdf)
    refine ⟨r, ?_, ?_⟩
    · rw [Polynomial.coe_aeval_eq_eval] at hr2
      exact hr2
    · have h3 : IsNilpotent (r - x) := by rw [← neg_sub]; exact hr1.neg
      exact (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr h3.not_isUnit)

  obtain ⟨h, ⟨hcomp, -⟩, -⟩ := hUP (A ⧸ I) hH (Ideal.Quotient.mk I) hU
  have hker : Ideal.span {φ (u ^ N), φ (v ^ N), φ (algebraMap ↥W A π)} ≤ RingHom.ker h := by
    rw [Ideal.span_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rw [SetLike.mem_coe, RingHom.mem_ker]
    rcases hx with rfl | rfl | rfl <;>
    · rw [← RingHom.comp_apply, hcomp, Ideal.Quotient.eq_zero_iff_mem, hIdef]
      exact Ideal.subset_span (by simp)
  have hmemA : a₀ - s₀ * pA ∈ I := by
    have h1 := hker hmemQ
    rw [RingHom.mem_ker, ← RingHom.comp_apply, hcomp, Ideal.Quotient.eq_zero_iff_mem] at h1
    exact h1
  rw [hIdef, Ideal.mem_span_insert] at hmemA
  obtain ⟨c₁, z₁, hz₁, hc1⟩ := hmemA
  rw [Ideal.mem_span_insert] at hz₁
  obtain ⟨c₂, z₂, hz₂, hc2⟩ := hz₁
  rw [Ideal.mem_span_singleton'] at hz₂
  obtain ⟨c₃, hc3⟩ := hz₂

  have hl : ∀ (f : ℕ → K) (n : ℕ), ((List.range n).map f).sum = ∑ i ∈ Finset.range n, f i := by
    intro f n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [List.range_succ, List.map_append, List.sum_append, ih, Finset.sum_range_succ]
      simp
  have hUV : algebraMap A K (algebraMap ↥W A g) = algebraMap A K u * algebraMap A K v := by
    rw [← huv, map_mul]
  refine ⟨(List.range (d + 1)).map (fun i => (a i, (i : ℤ))) ++
      (List.range (d + 1)).map (fun j => (a' j * g ^ (j + 1), -((j : ℤ) + 1))),
    s₀, c₁, c₂, c₃, hs₀, ?_, ?_⟩
  · intro b hb hneg
    rw [List.mem_append, List.mem_map, List.mem_map] at hb
    rcases hb with ⟨i, -, rfl⟩ | ⟨j, -, rfl⟩
    · exact absurd hneg (not_lt.mpr (Int.natCast_nonneg i))
    · show g ^ (-(-((j : ℤ) + 1))).toNat ∣ a' j * g ^ (j + 1)
      have e : (-(-((j : ℤ) + 1))).toNat = j + 1 := by omega
      rw [e]
      exact dvd_mul_left _ _
  · have hLaur : wcKpwmgbLaur W A K u ((List.range (d + 1)).map (fun i => (a i, (i : ℤ))) ++
        (List.range (d + 1)).map (fun j => (a' j * g ^ (j + 1), -((j : ℤ) + 1)))) =
        algebraMap A K pA := by
      unfold wcKpwmgbLaur
      rw [List.map_append, List.sum_append, List.map_map, List.map_map, hl, hl, hpA, map_add,
        map_sum, map_sum]
      congr 1
      · refine Finset.sum_congr rfl (fun i _ => ?_)
        simp only [Function.comp_apply, zpow_natCast, map_mul, map_pow]
      · refine Finset.sum_congr rfl (fun j _ => ?_)
        have e : -((j : ℤ) + 1) = -(((j + 1 : ℕ)) : ℤ) := by push_cast; ring
        simp only [Function.comp_apply, map_mul, map_pow]
        rw [hUV, e, zpow_neg, zpow_natCast]
        field_simp
        ring
    rw [hLaur]
    have key : a₀ - s₀ * pA = u ^ N * c₁ + v ^ N * c₂ + algebraMap ↥W A π * c₃ := by
      rw [hc1, hc2, ← hc3]; ring
    rw [← key, map_sub, map_mul, ← hF]
    ring

theorem wcpa_dj_llsm_kpwmgb_normalize : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (u : A) (B : List (↥W × ℤ)), ∃ B' : List (↥W × ℤ), wcKpwmgbLaur W A K u B' = wcKpwmgbLaur W A K u B ∧ (∀ b ∈ B', b.1 ≠ 0) ∧ B'.Pairwise (fun b b' => b.2 ≠ b'.2) ∧ ∀ b ∈ B', b.2 ∈ B.map Prod.snd ∧ b.1 = ((B.filter (fun c => c.2 = b.2)).map Prod.fst).sum :=
by
  intro Ω _ W A _ _ K _ _ u B
  classical
  set L := (B.map Prod.snd).dedup with hL
  let c : ℤ → ↥W := fun e => ((B.filter (fun c => c.2 = e)).map Prod.fst).sum
  let g : ℤ → ↥W × ℤ := fun e => (c e, e)
  refine ⟨(L.map g).filter (fun b => b.1 ≠ 0), ?_, ?_, ?_, ?_⟩
  · have regroup : ∀ (l : List (↥W × ℤ)) (f : ↥W × ℤ → K) (S : Finset ℤ), (∀ a ∈ l, a.2 ∈ S) →
        (l.map f).sum = ∑ e ∈ S, ((l.filter (fun a => a.2 = e)).map f).sum := by
      intro l f S
      induction l with
      | nil => intro _; simp
      | cons a l ih =>
        intro h
        have ha : a.2 ∈ S := h a (List.mem_cons_self ..)
        have hl : ∀ a' ∈ l, a'.2 ∈ S := fun a' ha' => h a' (List.mem_cons_of_mem _ ha')
        rw [List.map_cons, List.sum_cons, ih hl]
        have hc : ∀ e ∈ S, ((List.filter (fun x => decide (x.2 = e)) (a :: l)).map f).sum =
            (if a.2 = e then f a else 0) + ((l.filter (fun x => decide (x.2 = e))).map f).sum := by
          intro e _
          rw [List.filter_cons]
          by_cases h1 : a.2 = e
          · simp [h1]
          · simp [h1]
        rw [Finset.sum_congr rfl hc, Finset.sum_add_distrib, Finset.sum_ite_eq, if_pos ha]
    have hgroup : ∀ e : ℤ, ((B.filter (fun c => c.2 = e)).map
        (fun b => algebraMap A K (algebraMap ↥W A b.1) * algebraMap A K u ^ b.2)).sum =
        algebraMap A K (algebraMap ↥W A (c e)) * algebraMap A K u ^ e := by
      intro e
      have h1 : ((B.filter (fun c => c.2 = e)).map
          (fun b => algebraMap A K (algebraMap ↥W A b.1) * algebraMap A K u ^ b.2)) =
          ((B.filter (fun c => c.2 = e)).map
          (fun b => ((algebraMap A K).comp (algebraMap ↥W A)) b.1 * algebraMap A K u ^ e)) := by
        apply List.map_congr_left
        intro x hx
        rw [List.mem_filter] at hx
        have hx2 : x.2 = e := by simpa using hx.2
        rw [hx2]
        rfl
      rw [h1, List.sum_map_mul_right]
      congr 1
      show _ = ((algebraMap A K).comp (algebraMap ↥W A)) (c e)
      rw [map_list_sum, List.map_map]
      rfl
    have hdrop : ∀ l : List (↥W × ℤ),
        wcKpwmgbLaur W A K u (l.filter (fun b => b.1 ≠ 0)) = wcKpwmgbLaur W A K u l := by
      intro l
      unfold wcKpwmgbLaur
      induction l with
      | nil => simp
      | cons a l ih =>
        by_cases ha : a.1 = 0
        · simp only [List.filter_cons, ha, ne_eq, not_true_eq_false, decide_false,
            Bool.false_eq_true, if_false, List.map_cons, List.sum_cons, map_zero, zero_mul,
            zero_add]
          exact ih
        · simp only [List.filter_cons, ha, ne_eq, not_false_eq_true, decide_true, if_true,
            List.map_cons, List.sum_cons]
          rw [ih]
    rw [hdrop]
    unfold wcKpwmgbLaur
    have hS : ∀ a ∈ B, a.2 ∈ L.toFinset := fun a ha =>
      List.mem_toFinset.mpr (List.mem_dedup.mpr (List.mem_map_of_mem ha))
    rw [regroup B _ L.toFinset hS, List.sum_toFinset _ (List.nodup_dedup _), List.map_map]
    congr 1
    apply List.map_congr_left
    intro e _
    exact (hgroup e).symm
  · intro b hb
    rw [List.mem_filter] at hb
    simpa using hb.2
  · apply List.Pairwise.filter
    rw [List.pairwise_map]
    exact List.nodup_dedup _
  · intro b hb
    rw [List.mem_filter] at hb
    obtain ⟨e, he, rfl⟩ := List.mem_map.mp hb.1
    exact ⟨List.mem_dedup.mp he, rfl⟩

theorem wcpa_dj_llsm_kpwmgb_window_init : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ (f' : K) (a s : A), a ∉ 𝔭 → s ∉ 𝔭 → f' * algebraMap A K s = algebraMap A K a →
    ∀ (t₁ τ : ↥W) (P : ↥W → Prop), t₁ ∈ IsLocalRing.maximalIdeal ↥W → t₁ ≠ 0 → τ ∣ g →
      ¬ g ∣ τ → P t₁ → ¬ P τ → (∀ x y : ↥W, P x → y ∣ x → P y) →
      (∀ x : ↥W, P x → ∃ x' : ↥W, P x' ∧ x ∣ x' ∧ ¬ x' ∣ x) →
      (∀ y : ↥W, ¬ P y → ∃ y' : ↥W, ¬ P y' ∧ y' ∣ y ∧ ¬ y ∣ y') →
    ∀ (c' lam μT xT yT : ↥W) (j kT : ℤ), wcKpwmgbCtx W A K u g ℓ P c' lam j μT kT xT yT →
    ∀ (h : K) (z s' σ : A) (x₀ y₀ : ↥W), h ≠ 0 → s' ∉ 𝔭 →
      algebraMap A K s' * (f' / h ^ ℓ - 1) = algebraMap A K z → σ ∉ 𝔭 → P x₀ → ¬ P y₀ →
      wcKpwmgbDeep W A K u g σ z lam j x₀ y₀ →
      ∃ (σ₁ : A) (B : List (↥W × ℤ)) (x₁ y₁ : ↥W),
        wcKpwmgbWin W A K 𝔭 u g f' ℓ P lam j μT kT h z s' σ₁ B x₁ y₁ :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ 𝔭 u v g hPD f' a s ha hs hf
    t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁ hPτ hdown hnomax hnomin
    c' lam μT xT yT j kT hCtx h z s' σ x₀ y₀ hh hs' hz hσ hPx₀ hPy₀ hD
  classical
  have hPD' := hPD
  simp only [wcLlsPD] at hPD'
  obtain ⟨_, hNZ, _, h𝔭max, _, _, hg0, huv, h𝔭eq, _⟩ := hPD'
  haveI := hNZ
  have hφinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hψ0 : ∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0 := by
    intro w hw hc
    have h1 : algebraMap ↥W A w = 0 := hφinj (hc.trans (map_zero _).symm)
    rw [Algebra.algebraMap_eq_smul_one] at h1
    exact (smul_ne_zero hw one_ne_zero) h1
  have hu0 : algebraMap A K u ≠ 0 := by
    intro hc
    have h1 : algebraMap A K (u * v) = 0 := by rw [map_mul, hc, zero_mul]
    rw [huv] at h1
    exact hψ0 g hg0 h1

  have hS₁eq : ∀ c₁ : ↥W, c₁ ≠ 0 →
      algebraMap A K u = algebraMap A K (algebraMap ↥W A c₁) * wcLlsInnerS₁ W A K u c₁ := by
    intro c₁ hc₁
    unfold wcLlsInnerS₁
    rw [mul_div_assoc', eq_div_iff (hψ0 c₁ hc₁), mul_comm]
  have hS₂eq : ∀ c₂ : ↥W,
      algebraMap A K (algebraMap ↥W A c₂) = algebraMap A K u * wcLlsInnerS₂ W A K u c₂ := by
    intro c₂
    unfold wcLlsInnerS₂
    rw [mul_div_assoc', eq_div_iff hu0, mul_comm]
  have hS₁N : ∀ (c₁ c₂ : ↥W) (hs : wcLlsInnerS₁ W A K u c₁ ∈ wcLlsInnerCR W A K u c₁ c₂),
      (⟨_, hs⟩ : ↥(wcLlsInnerCR W A K u c₁ c₂)) ∈ wcLlsInnerCN W A K u c₁ c₂ := by
    intro c₁ c₂ hs
    unfold wcLlsInnerCN
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_iff.mpr (Or.inl rfl)))
  have hS₂N : ∀ (c₁ c₂ : ↥W) (hs : wcLlsInnerS₂ W A K u c₂ ∈ wcLlsInnerCR W A K u c₁ c₂),
      (⟨_, hs⟩ : ↥(wcLlsInnerCR W A K u c₁ c₂)) ∈ wcLlsInnerCN W A K u c₁ c₂ := by
    intro c₁ c₂ hs
    unfold wcLlsInnerCN
    exact Ideal.mem_sup_left (Ideal.subset_span
      (Set.mem_insert_iff.mpr (Or.inr (Set.mem_singleton_iff.mpr rfl))))
  have hmN : ∀ (c₁ c₂ : ↥W), ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A w) ∈
        wcLlsInnerCN W A K u c₁ c₂ := by
    intro c₁ c₂ w hw
    unfold wcLlsInnerCN
    have := Ideal.mem_map_of_mem
      ((algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂)).comp (algebraMap ↥W A)) hw
    exact Ideal.mem_sup_right this

  have hcomap : ∀ c₁ c₂ : ↥W, c₁ ≠ 0 → c₂ ∣ g → ∀ a ∈ 𝔭,
      algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a ∈ wcLlsInnerCN W A K u c₁ c₂ := by
    intro c₁ c₂ hc₁ hc₂g a ha
    rw [h𝔭eq] at ha
    have hle : Ideal.span {u, v} ⊔ Ideal.map (algebraMap ↥W A) (IsLocalRing.maximalIdeal ↥W) ≤
        (wcLlsInnerCN W A K u c₁ c₂).comap (algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂)) := by
      refine sup_le ?_ ?_
      · rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
        refine ⟨?_, ?_⟩
        · have hs₁ : wcLlsInnerS₁ W A K u c₁ ∈ wcLlsInnerCR W A K u c₁ c₂ :=
            Algebra.subset_adjoin (Set.mem_insert _ _)
          have e : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) u =
              algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A c₁) * ⟨_, hs₁⟩ := by
            apply Subtype.ext
            simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
            exact hS₁eq c₁ hc₁
          rw [SetLike.mem_coe, Ideal.mem_comap, e]
          exact Ideal.mul_mem_left _ _ (hS₁N c₁ c₂ hs₁)
        · obtain ⟨g₂, hg₂⟩ := hc₂g
          have hs₂ : wcLlsInnerS₂ W A K u c₂ ∈ wcLlsInnerCR W A K u c₁ c₂ :=
            Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
          have h1 : algebraMap A K u * algebraMap A K v =
              algebraMap A K (algebraMap ↥W A c₂) * algebraMap A K (algebraMap ↥W A g₂) := by
            rw [← map_mul, huv, hg₂]
            simp only [map_mul]
          have e : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) v =
              algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A g₂) * ⟨_, hs₂⟩ := by
            apply Subtype.ext
            simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
            apply mul_left_cancel₀ hu0
            linear_combination h1 + (algebraMap A K (algebraMap ↥W A g₂)) * hS₂eq c₂
          rw [SetLike.mem_coe, Ideal.mem_comap, e]
          exact Ideal.mul_mem_left _ _ (hS₂N c₁ c₂ hs₂)
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [Ideal.mem_comap]
        exact hmN c₁ c₂ w hw
    exact hle ha

  have habs : ∀ c₁ c₂ : ↥W, c₁ ≠ 0 → c₂ ∣ g → ∀ (a₀ : A) (E₂ : ↥(wcLlsInnerCR W A K u c₁ c₂)),
      a₀ ∉ 𝔭 → algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a₀ * E₂ ∈ wcLlsInnerCN W A K u c₁ c₂ →
      E₂ ∈ wcLlsInnerCN W A K u c₁ c₂ := by
    intro c₁ c₂ hc₁ hc₂ a₀ E₂ ha₀ hE
    obtain ⟨y, i, hi, hyi⟩ := Ideal.IsMaximal.exists_inv h𝔭max ha₀
    have h1 : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) y *
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a₀ +
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) i = 1 := by
      rw [← map_mul, ← map_add, hyi, map_one]
    have e : E₂ = algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) y *
        (algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a₀ * E₂) +
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) i * E₂ := by
      linear_combination (-E₂) * h1
    rw [e]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hE)
      (Ideal.mul_mem_right _ _ (hcomap c₁ c₂ hc₁ hc₂ i hi))

  have hCtx' := hCtx
  unfold wcKpwmgbCtx at hCtx'
  obtain ⟨_hc', _hlm, hl0, _hconej, hμT0, hPxT, hPyT, hCP⟩ := hCtx'
  have hmunit : ∀ z : ↥W, z ∈ IsLocalRing.maximalIdeal ↥W ↔ ¬ IsUnit z := fun z =>
    (IsLocalRing.mem_maximalIdeal z).trans mem_nonunits_iff
  have hτ0 : τ ≠ 0 := by
    rintro rfl
    exact hgτ (dvd_zero g)
  have hbasic : ∀ x y : ↥W, P x → ¬ P y → t₁ ∣ x → y ∣ τ →
      x ∈ IsLocalRing.maximalIdeal ↥W ∧ x ≠ 0 ∧ y ∈ IsLocalRing.maximalIdeal ↥W ∧ y ≠ 0 ∧
      x ∣ y ∧ ¬ y ∣ x ∧ y ∣ g := by
    intro x y hx hy htx hyτ
    have hyx : ¬ y ∣ x := fun h => hy (hdown x y hx h)
    have hxy : x ∣ y := (ValuationRing.dvd_total x y).resolve_right hyx
    have hxm : x ∈ IsLocalRing.maximalIdeal ↥W := by
      obtain ⟨k, hk⟩ := htx
      rw [hk]
      exact Ideal.mul_mem_right k _ ht₁m
    have hx0 : x ≠ 0 := by
      intro hx0
      rw [hx0] at hx
      exact hPτ (hdown 0 τ hx (dvd_zero τ))
    have hy0 : y ≠ 0 := by
      intro hy0
      rw [hy0] at hyτ
      exact hτ0 (zero_dvd_iff.mp hyτ)
    obtain ⟨k, hk⟩ := hxy
    have hkm : k ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [hmunit]
      intro hku
      exact hyx ⟨↑hku.unit⁻¹, by rw [hk, mul_assoc, IsUnit.mul_val_inv, mul_one]⟩
    have hym : y ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [hk]
      exact Ideal.mul_mem_left _ x hkm
    exact ⟨hxm, hx0, hym, hy0, ⟨k, hk⟩, hyx, dvd_trans hyτ hτg⟩
  have hCI : ∀ x₁ y₁ x₂ y₂ : ↥W, P x₁ → ¬ P y₁ → P x₂ → ¬ P y₂ →
      ∃ x y : ↥W, P x ∧ ¬ P y ∧ x₁ ∣ x ∧ x₂ ∣ x ∧ y ∣ y₁ ∧ y ∣ y₂ := by
    intro x₁ y₁ x₂ y₂ h1 h2 h3 h4
    obtain ⟨x, hx, hx1, hx2⟩ : ∃ x : ↥W, P x ∧ x₁ ∣ x ∧ x₂ ∣ x :=
      (ValuationRing.dvd_total x₁ x₂).elim (fun hd => ⟨x₂, h3, hd, dvd_rfl⟩)
        (fun hd => ⟨x₁, h1, dvd_rfl, hd⟩)
    obtain ⟨y, hy, hy1, hy2⟩ : ∃ y : ↥W, ¬ P y ∧ y ∣ y₁ ∧ y ∣ y₂ :=
      (ValuationRing.dvd_total y₁ y₂).elim (fun hd => ⟨y₁, h2, dvd_rfl, hd⟩)
        (fun hd => ⟨y₂, h4, hd, dvd_rfl⟩)
    exact ⟨x, y, hx, hy, hx1, hx2, hy1, hy2⟩

  obtain ⟨N, π, hN, hπm, hπ0, hBd⟩ := wcpa_dj_llsm_kpwmgb_trunc_bounds Ω W hW hWt A K 𝔭 u v g
    hPD t₁ τ ht₁m ht₁0 hτg hgτ μT kT hμT0
  have hzF : (f' / h ^ ℓ - 1) * algebraMap A K s' = algebraMap A K z := by
    rw [mul_comm]; exact hz
  obtain ⟨B₀, σ₀, p₁, p₂, p₃, hσ₀, hcone₀, heq⟩ := wcpa_dj_llsm_kpwmgb_trunc_alg Ω W hW hWt
    A K 𝔭 u v g hPD (f' / h ^ ℓ - 1) z s' hs' hzF N π hN hπm hπ0
  obtain ⟨B, hL, hNZB, hDIST, hco⟩ := wcpa_dj_llsm_kpwmgb_normalize Ω W A K u B₀
  have hcone : ∀ b ∈ B, b.2 < 0 → g ^ (-b.2).toNat ∣ b.1 := by
    intro b hb hb0
    obtain ⟨-, hb1⟩ := hco b hb
    rw [hb1]
    apply List.dvd_sum
    intro x hx
    obtain ⟨c, hc, rfl⟩ := List.mem_map.mp hx
    obtain ⟨hcB, hc2⟩ := List.mem_filter.mp hc
    have hc2' : c.2 = b.2 := by simpa using hc2
    rw [← hc2']
    exact hcone₀ c hcB (by rw [hc2']; exact hb0)
  have hREM : ∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
      c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
      t₁ ∣ c₁ → c₂ ∣ τ →
      ∃ E : ↥(wcLlsInnerCR W A K u c₁ c₂),
        algebraMap A K σ₀ * ((f' / h ^ ℓ - 1) - wcKpwmgbLaur W A K u B) =
          algebraMap A K (algebraMap ↥W A μT) * algebraMap A K u ^ kT * (E : K) := by
    intro c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx hy
    obtain ⟨r₁, r₂, r₃, e₁, e₂, e₃⟩ := hBd c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx hy
    refine ⟨r₁ * algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) p₁ +
      r₂ * algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) p₂ +
      r₃ * algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) p₃, ?_⟩
    simp only [Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
    rw [hL, heq]
    simp only [map_add, map_mul, map_pow]
    linear_combination (algebraMap A K p₁) * e₁ + (algebraMap A K p₂) * e₂ +
      (algebraMap A K p₃) * e₃

  have hgood : ∃ x₁ y₁ : ↥W, P x₁ ∧ ¬ P y₁ ∧ t₁ ∣ x₁ ∧ y₁ ∣ τ ∧
      ∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
        c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
        x₁ ∣ c₁ → c₂ ∣ y₁ →
        ∀ b ∈ B, ∃ r : ↥(wcLlsInnerCR W A K u c₁ c₂),
          algebraMap A K (algebraMap ↥W A b.1) * algebraMap A K u ^ b.2 =
            algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j * (r : K) := by
    by_cases hB : B = []
    · refine ⟨t₁, τ, hPt₁, hPτ, dvd_rfl, dvd_rfl, ?_⟩
      intro c₁ c₂ _ _ _ _ _ _ _ _ _ b hb
      rw [hB] at hb
      simp at hb
    obtain ⟨b, hbB, xL, yL, hPxL, hPyL, hLead⟩ := wcpa_dj_llsm_kpwmgb_lead Ω W hW hWt A K 𝔭 u v g
      hPD t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁ hPτ hdown hnomax hnomin B hB hNZB hDIST
    have hLB : ∃ x₂ y₂ : ↥W, P x₂ ∧ ¬ P y₂ ∧
        ∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
          c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
          x₂ ∣ c₁ → c₂ ∣ y₂ →
          ∃ r : ↥(wcLlsInnerCR W A K u c₁ c₂),
            algebraMap A K (algebraMap ↥W A b.1) * algebraMap A K u ^ b.2 =
              algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j * (r : K) := by
      rcases wcpa_dj_llsm_kpwmgb_cmp Ω W hW hWt A K 𝔭 u v g hPD t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁
          hPτ hdown hnomax hnomin b.1 μT b.2 kT (hNZB b hbB) hμT0 with
        ⟨x1, y1, hPx1, hPy1, hR1⟩ | ⟨x1, y1, hPx1, hPy1, hR1⟩
      ·
        obtain ⟨x, y, hPx, hPy, a1, a2, b1, b2⟩ := hCI x1 y1 xT yT hPx1 hPy1 hPxT hPyT
        refine ⟨x, y, hPx, hPy, ?_⟩
        intro c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx hy
        obtain ⟨r, hr, -⟩ := hR1 c₁ c₂ h1 h2 h3 h4 h5 h6 h7 (dvd_trans a1 hx) (dvd_trans hy b1)
        obtain ⟨-, ⟨rT, hrT⟩, -, -⟩ := hCP c₁ c₂ h1 h2 h3 h4 h5 h6 h7 (dvd_trans a2 hx)
          (dvd_trans hy b2)
        refine ⟨rT * r, ?_⟩
        rw [hr, hrT, MulMemClass.coe_mul]
        ring
      · rcases wcpa_dj_llsm_kpwmgb_cmp Ω W hW hWt A K 𝔭 u v g hPD t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁
            hPτ hdown hnomax hnomin b.1 lam b.2 j (hNZB b hbB) hl0 with
          ⟨x2, y2, hPx2, hPy2, hR2⟩ | ⟨x2, y2, hPx2, hPy2, hR2⟩
        · refine ⟨x2, y2, hPx2, hPy2, ?_⟩
          intro c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx hy
          obtain ⟨r, hr, -⟩ := hR2 c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx hy
          exact ⟨r, hr⟩
        ·
          exfalso
          obtain ⟨xa, ya, hPxa, hPya, a1, a2, b1, b2⟩ := hCI x₀ y₀ t₁ τ hPx₀ hPy₀ hPt₁ hPτ
          obtain ⟨xb, yb, hPxb, hPyb, a3, a4, b3, b4⟩ := hCI xa ya xL yL hPxa hPya hPxL hPyL
          obtain ⟨xc, yc, hPxc, hPyc, a5, a6, b5, b6⟩ := hCI xb yb x1 y1 hPxb hPyb hPx1 hPy1
          obtain ⟨x, y, hPx, hPy, a7, a8, b7, b8⟩ := hCI xc yc x2 y2 hPxc hPyc hPx2 hPy2
          have htx : t₁ ∣ x := dvd_trans a2 (dvd_trans a3 (dvd_trans a5 a7))
          have hyτ : y ∣ τ := dvd_trans b7 (dvd_trans b5 (dvd_trans b3 b2))
          obtain ⟨h1, h2, h3, h4, h5, h6, h7⟩ := hbasic x y hPx hPy htx hyτ
          obtain ⟨EM, hEM⟩ := hD x y h1 h2 h3 h4 h5 h6 h7
            (dvd_trans a1 (dvd_trans a3 (dvd_trans a5 a7)))
            (dvd_trans b7 (dvd_trans b5 (dvd_trans b3 b1)))
          obtain ⟨ET, hET⟩ := hREM x y h1 h2 h3 h4 h5 h6 h7 htx hyτ
          obtain ⟨⟨Es, hEsN, hEs⟩, -⟩ := hLead x y h1 h2 h3 h4 h5 h6 h7
            (dvd_trans a4 (dvd_trans a5 a7)) (dvd_trans b7 (dvd_trans b5 b4))
          obtain ⟨nT, hnT, hnTeq⟩ := hR1 x y h1 h2 h3 h4 h5 h6 h7 (dvd_trans a6 a7)
            (dvd_trans b7 b6)
          obtain ⟨nM, hnM, hnMeq⟩ := hR2 x y h1 h2 h3 h4 h5 h6 h7 a8 b8
          have hb0 : algebraMap A K (algebraMap ↥W A b.1) * algebraMap A K u ^ b.2 ≠ 0 :=
            mul_ne_zero (hψ0 _ (hNZB b hbB)) (zpow_ne_zero _ hu0)
          have hkey : algebraMap A ↥(wcLlsInnerCR W A K u x y) (σ * s' * σ₀) * Es +
              algebraMap A ↥(wcLlsInnerCR W A K u x y) (σ * s') * nT * ET =
              algebraMap A ↥(wcLlsInnerCR W A K u x y) σ₀ * nM * EM := by
            apply Subtype.ext
            apply mul_left_cancel₀ hb0
            simp only [Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_algebraMap,
              map_mul]
            linear_combination
              (-(algebraMap A K σ * algebraMap A K s' * algebraMap A K σ₀)) * hEs +
              (-(algebraMap A K σ * algebraMap A K s' * (ET : K))) * hnTeq +
              (algebraMap A K σ₀ * (EM : K)) * hnMeq + (algebraMap A K σ₀) * hEM +
              (algebraMap A K σ₀ * algebraMap A K σ) * hz +
              (-(algebraMap A K σ * algebraMap A K s')) * hET
          have hmem : algebraMap A ↥(wcLlsInnerCR W A K u x y) (σ * s' * σ₀) * Es ∈
              wcLlsInnerCN W A K u x y := by
            rw [eq_sub_of_add_eq hkey]
            exact Ideal.sub_mem _ (Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ hnM))
              (Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ hnT))
          have hσs : σ * s' * σ₀ ∉ 𝔭 := by
            intro hm
            rcases h𝔭max.isPrime.mem_or_mem hm with hm | hm
            · rcases h𝔭max.isPrime.mem_or_mem hm with hm | hm
              · exact hσ hm
              · exact hs' hm
            · exact hσ₀ hm
          exact hEsN (habs x y h2 h7 _ Es hσs hmem)
    obtain ⟨x₂, y₂, hPx₂, hPy₂, hLB'⟩ := hLB
    obtain ⟨xa, ya, hPxa, hPya, a1, a2, b1, b2⟩ := hCI t₁ τ xL yL hPt₁ hPτ hPxL hPyL
    obtain ⟨x, y, hPx, hPy, a3, a4, b3, b4⟩ := hCI xa ya x₂ y₂ hPxa hPya hPx₂ hPy₂
    refine ⟨x, y, hPx, hPy, dvd_trans a1 a3, dvd_trans b3 b1, ?_⟩
    intro c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx hy b' hb'
    obtain ⟨r, hr⟩ := hLB' c₁ c₂ h1 h2 h3 h4 h5 h6 h7 (dvd_trans a4 hx) (dvd_trans hy b4)
    by_cases hbb : b' = b
    · rw [hbb]
      exact ⟨r, hr⟩
    · obtain ⟨-, hrest⟩ := hLead c₁ c₂ h1 h2 h3 h4 h5 h6 h7 (dvd_trans a2 (dvd_trans a3 hx))
        (dvd_trans hy (dvd_trans b3 b2))
      obtain ⟨r', -, hr'⟩ := hrest b' hb' hbb
      refine ⟨r * r', ?_⟩
      rw [hr', hr, MulMemClass.coe_mul]
      ring
  obtain ⟨x₁, y₁, hPx₁, hPy₁, htx₁, hy₁τ, hWB⟩ := hgood
  refine ⟨σ₀, B, x₁, y₁, ?_⟩
  unfold wcKpwmgbWin
  refine ⟨hh, hs', hz, hσ₀, hPx₁, hPy₁, hcone, hNZB, hDIST, ?_⟩
  intro c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx hy
  exact ⟨hREM c₁ c₂ h1 h2 h3 h4 h5 h6 h7 (dvd_trans htx₁ hx) (dvd_trans hy hy₁τ),
    hWB c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx hy⟩

theorem wcpa_dj_llsm_kpwmgb_move_zero : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ (f' : K) (a s : A), a ∉ 𝔭 → s ∉ 𝔭 → f' * algebraMap A K s = algebraMap A K a →
    ∀ (t₁ τ : ↥W) (P : ↥W → Prop), t₁ ∈ IsLocalRing.maximalIdeal ↥W → t₁ ≠ 0 → τ ∣ g →
      ¬ g ∣ τ → P t₁ → ¬ P τ → (∀ x y : ↥W, P x → y ∣ x → P y) →
      (∀ x : ↥W, P x → ∃ x' : ↥W, P x' ∧ x ∣ x' ∧ ¬ x' ∣ x) →
      (∀ y : ↥W, ¬ P y → ∃ y' : ↥W, ¬ P y' ∧ y' ∣ y ∧ ¬ y ∣ y') →
    ∀ (c' lam μT xT yT : ↥W) (j kT : ℤ), wcKpwmgbCtx W A K u g ℓ P c' lam j μT kT xT yT →
    ∀ (h : K) (z s' σ : A) (B : List (↥W × ℤ)) (x₀ y₀ b : ↥W),
      wcKpwmgbWin W A K 𝔭 u g f' ℓ P lam j μT kT h z s' σ B x₀ y₀ → (b, (0 : ℤ)) ∈ B →
      ∃ (h₁ : K) (z₁ s₁ σ₁ : A) (B₁ : List (↥W × ℤ)) (x₁ y₁ : ↥W),
        wcKpwmgbWin W A K 𝔭 u g f' ℓ P lam j μT kT h₁ z₁ s₁ σ₁ B₁ x₁ y₁ ∧
        wcKpwmgbPhi ℓ B₁ < wcKpwmgbPhi ℓ B :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ 𝔭 u v g hPD f' a s ha hs hf
    t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁ hPτ hdown hnomax hnomin c' lam μT xT yT j kT hCtx
    h z s' σ B x₀ y₀ b hWin hbB
  classical
  have hPD' := hPD
  simp only [wcLlsPD] at hPD'
  obtain ⟨_, hNZ, _, h𝔭max, _, _, hg0, huv, _⟩ := hPD'
  haveI := hNZ
  have h𝔭prime : 𝔭.IsPrime := h𝔭max.isPrime
  have hroot : ∀ (w : ↥W) (n : ℕ), 0 < n → ∃ r : ↥W, r ^ n = w := by
    intro w n hn
    obtain ⟨r, hr⟩ := IsAlgClosed.exists_pow_nat_eq (w : Ω) hn
    have hrW : r ∈ W := by
      rcases W.mem_or_inv_mem r with h | h
      · exact h
      · by_cases hr0 : r = 0
        · rw [hr0]; exact W.zero_mem
        · have e : r = r ^ n * r⁻¹ ^ (n - 1) := by
            obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
            rw [Nat.add_sub_cancel, pow_succ, mul_comm (r ^ k) r, mul_assoc, ← mul_pow,
              mul_inv_cancel₀ hr0, one_pow, mul_one]
          rw [e, hr]
          exact mul_mem w.2 (pow_mem h _)
    exact ⟨⟨r, hrW⟩, Subtype.ext (by simpa using hr)⟩
  have hφinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hψ0 : ∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0 := by
    intro w hw hc
    have h1 : algebraMap ↥W A w = 0 := hφinj (hc.trans (map_zero _).symm)
    rw [Algebra.algebraMap_eq_smul_one] at h1
    exact (smul_ne_zero hw one_ne_zero) h1
  have hmunit : ∀ z : ↥W, z ∈ IsLocalRing.maximalIdeal ↥W ↔ ¬ IsUnit z := fun z =>
    (IsLocalRing.mem_maximalIdeal z).trans mem_nonunits_iff
  have hτ0 : τ ≠ 0 := by
    rintro rfl
    exact hgτ (dvd_zero g)
  have hbasic : ∀ x y : ↥W, P x → ¬ P y → t₁ ∣ x → y ∣ τ →
      x ∈ IsLocalRing.maximalIdeal ↥W ∧ x ≠ 0 ∧ y ∈ IsLocalRing.maximalIdeal ↥W ∧ y ≠ 0 ∧
      x ∣ y ∧ ¬ y ∣ x ∧ y ∣ g := by
    intro x y hx hy htx hyτ
    have hyx : ¬ y ∣ x := fun h => hy (hdown x y hx h)
    have hxy : x ∣ y := (ValuationRing.dvd_total x y).resolve_right hyx
    have hxm : x ∈ IsLocalRing.maximalIdeal ↥W := by
      obtain ⟨k, hk⟩ := htx
      rw [hk]
      exact Ideal.mul_mem_right k _ ht₁m
    have hx0 : x ≠ 0 := by
      intro hx0
      rw [hx0] at hx
      exact hPτ (hdown 0 τ hx (dvd_zero τ))
    have hy0 : y ≠ 0 := by
      intro hy0
      rw [hy0] at hyτ
      exact hτ0 (zero_dvd_iff.mp hyτ)
    obtain ⟨k, hk⟩ := hxy
    have hkm : k ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [hmunit]
      intro hku
      exact hyx ⟨↑hku.unit⁻¹, by rw [hk, mul_assoc, IsUnit.mul_val_inv, mul_one]⟩
    have hym : y ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [hk]
      exact Ideal.mul_mem_left _ x hkm
    exact ⟨hxm, hx0, hym, hy0, ⟨k, hk⟩, hyx, dvd_trans hyτ hτg⟩
  obtain ⟨hc', hlm, hl0, hcone, hμT0, hPxT, hPyT, hCtxP⟩ := hCtx
  obtain ⟨hh, hs', hz, hσ, hPx₀, hPy₀, hCONE, hNZB, hDIST, hWP⟩ := hWin

  have hmono : ∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
      c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
      ∃ n ∈ wcLlsInnerCN W A K u c₁ c₂,
        algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j = (n : K) := by
    intro c₁ c₂ h1 h2 h3 h4 h5 h6 h7
    have hc₁K := hψ0 c₁ h2
    have hmapN : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W →
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A w) ∈
          wcLlsInnerCN W A K u c₁ c₂ := by
      intro w hw
      unfold wcLlsInnerCN
      exact Ideal.mem_sup_right
        (Ideal.mem_map_of_mem ((algebraMap A _).comp (algebraMap ↥W A)) hw)
    have hs₁ : wcLlsInnerS₁ W A K u c₁ ∈ wcLlsInnerCR W A K u c₁ c₂ :=
      Algebra.subset_adjoin (by simp)
    have hs₂ : wcLlsInnerS₂ W A K u c₂ ∈ wcLlsInnerCR W A K u c₁ c₂ :=
      Algebra.subset_adjoin (by simp)
    have hs₂N : (⟨_, hs₂⟩ : ↥(wcLlsInnerCR W A K u c₁ c₂)) ∈ wcLlsInnerCN W A K u c₁ c₂ := by
      unfold wcLlsInnerCN
      exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
    rcases le_or_gt 0 j with hj | hj
    · obtain ⟨J, hJ⟩ := Int.eq_ofNat_of_zero_le hj
      subst hJ
      refine ⟨algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A (lam * c₁ ^ J)) *
        (⟨_, hs₁⟩ : ↥(wcLlsInnerCR W A K u c₁ c₂)) ^ J,
        Ideal.mul_mem_right _ _ (hmapN _ (Ideal.mul_mem_right _ _ hlm)), ?_⟩
      show _ = algebraMap A K (algebraMap ↥W A (lam * c₁ ^ J)) *
        (algebraMap A K u / algebraMap A K (algebraMap ↥W A c₁)) ^ J
      rw [zpow_natCast, map_mul, map_mul, map_pow, map_pow, mul_assoc, ← mul_pow,
        mul_div_cancel₀ _ hc₁K]
    · obtain ⟨J, hJe⟩ : ∃ J : ℕ, j = -(J : ℤ) := ⟨(-j).toNat, by omega⟩
      subst hJe
      have hJt : (-(-(J : ℤ))).toNat = J := by omega
      have hJ : 0 < J := by omega
      obtain ⟨lam', hlam'⟩ := hcone hj
      rw [hJt] at hlam'
      obtain ⟨q, hq⟩ := h7
      refine ⟨algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A (lam' * q ^ J)) *
        (⟨_, hs₂⟩ : ↥(wcLlsInnerCR W A K u c₁ c₂)) ^ J,
        Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hs₂N J hJ), ?_⟩
      show _ = algebraMap A K (algebraMap ↥W A (lam' * q ^ J)) *
        (algebraMap A K (algebraMap ↥W A c₂) / algebraMap A K u) ^ J
      rw [hlam', hq, zpow_neg, zpow_natCast, div_pow]
      simp only [map_mul, map_pow]
      ring

  have hsplit : ∀ (l : List (↥W × ℤ)), l.Pairwise (fun b b' => b.2 ≠ b'.2) → (b, (0 : ℤ)) ∈ l →
      wcKpwmgbLaur W A K u l = algebraMap A K (algebraMap ↥W A b) +
        wcKpwmgbLaur W A K u (l.filter (fun x => x.2 ≠ 0)) := by
    intro l
    induction l with
    | nil => intro _ hm; simp at hm
    | cons x t ih =>
      intro hpw hm
      rw [List.pairwise_cons] at hpw
      obtain ⟨hx, ht⟩ := hpw
      simp only [wcKpwmgbLaur] at ih ⊢
      rcases List.mem_cons.mp hm with hxe | hmt
      · subst hxe
        have hft : t.filter (fun x => x.2 ≠ 0) = t := by
          apply List.filter_eq_self.mpr
          intro y hy
          have := hx y hy
          simp only [ne_eq, decide_eq_true_eq]
          exact fun h0 => this h0.symm
        rw [List.filter_cons_of_neg (by simp), hft]
        simp
      · have hx0 : x.2 ≠ 0 := hx _ hmt
        rw [List.filter_cons_of_pos (by simpa using hx0)]
        simp only [List.map_cons, List.sum_cons]
        rw [ih ht hmt]
        ring

  have hlaurM : ∀ (R : Subalgebra A K) (M : K) (l : List (↥W × ℤ)),
      (∀ b ∈ l, ∃ r : ↥R, algebraMap A K (algebraMap ↥W A b.1) * algebraMap A K u ^ b.2 =
        M * (r : K)) → ∃ ρ : ↥R, wcKpwmgbLaur W A K u l = M * (ρ : K) := by
    intro R M l
    induction l with
    | nil =>
      intro _
      refine ⟨0, ?_⟩
      simp [wcKpwmgbLaur]
    | cons x t ih =>
      intro hl
      obtain ⟨rx, hrx⟩ := hl x (by simp)
      obtain ⟨ρt, hρt⟩ := ih (fun b hb => hl b (List.mem_cons_of_mem _ hb))
      refine ⟨rx + ρt, ?_⟩
      simp only [wcKpwmgbLaur, List.map_cons, List.sum_cons] at hρt ⊢
      rw [hrx, hρt, AddMemClass.coe_add]
      ring

  have hPhi : wcKpwmgbPhi ℓ (B.filter (fun x => x.2 ≠ 0)) < wcKpwmgbPhi ℓ B := by
    unfold wcKpwmgbPhi
    have hS : ((B.filter (fun x => x.2 ≠ 0)).map Prod.snd).toFinset =
        (B.map Prod.snd).toFinset.erase 0 := by
      ext e
      simp only [List.mem_toFinset, List.mem_map, List.mem_filter, Finset.mem_erase, ne_eq,
        decide_eq_true_eq]
      constructor
      · rintro ⟨x, ⟨hxB, hx0⟩, rfl⟩
        exact ⟨hx0, x, hxB, rfl⟩
      · rintro ⟨he, x, hxB, rfl⟩
        exact ⟨x, ⟨hxB, he⟩, rfl⟩
    rw [hS, Finset.filter_erase]
    have h0 : (0 : ℤ) ∈ (B.map Prod.snd).toFinset.filter (fun e => (ℓ : ℤ) ∣ e) := by
      rw [Finset.mem_filter, List.mem_toFinset, List.mem_map]
      exact ⟨⟨(b, 0), hbB, rfl⟩, dvd_zero _⟩
    have := Finset.sum_erase_add _ (fun e : ℤ => ℓ ^ e.natAbs) h0
    simp only [Int.natAbs_zero, pow_zero] at this
    omega

  have hbm : b ∈ IsLocalRing.maximalIdeal ↥W := by
    obtain ⟨c₁, hPc₁, hx₀c₁, ht₁c₁⟩ : ∃ c, P c ∧ x₀ ∣ c ∧ t₁ ∣ c :=
      (ValuationRing.dvd_total x₀ t₁).elim (fun hd => ⟨t₁, hPt₁, hd, dvd_rfl⟩)
        (fun hd => ⟨x₀, hPx₀, dvd_rfl, hd⟩)
    obtain ⟨c₂, hPc₂, hc₂y₀, hc₂τ⟩ : ∃ c, ¬ P c ∧ c ∣ y₀ ∧ c ∣ τ :=
      (ValuationRing.dvd_total y₀ τ).elim (fun hd => ⟨y₀, hPy₀, dvd_rfl, hd⟩)
        (fun hd => ⟨τ, hPτ, hd, dvd_rfl⟩)
    obtain ⟨h1, h2, h3, h4, h5, h6, h7⟩ := hbasic c₁ c₂ hPc₁ hPc₂ ht₁c₁ hc₂τ
    obtain ⟨-, hterm⟩ := hWP c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx₀c₁ hc₂y₀
    obtain ⟨r, hr⟩ := hterm (b, 0) hbB
    obtain ⟨n, hn, hnK⟩ := hmono c₁ c₂ h1 h2 h3 h4 h5 h6 h7
    have hmem : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A b) ∈
        wcLlsInnerCN W A K u c₁ c₂ := by
      have e : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A b) = n * r := by
        apply Subtype.ext
        rw [MulMemClass.coe_mul, ← hnK]
        show algebraMap A K (algebraMap ↥W A b) = _
        simpa only [zpow_zero, mul_one] using hr
      rw [e]
      exact Ideal.mul_mem_right _ _ hn
    rw [hmunit]
    intro hbu
    have hbA : IsUnit (algebraMap ↥W A b) := hbu.map (algebraMap ↥W A)
    have hb𝔭 : algebraMap ↥W A b ∉ 𝔭 := fun hm =>
      h𝔭max.ne_top (Ideal.eq_top_of_isUnit_mem _ hm hbA)
    have := wcpa_dj_llsm_kpwul_inner_unit Ω W hW hWt A K 𝔭 u v g hPD c₁ c₂ h1 h2 h3 h4 h5 h6 h7
      _ hb𝔭 0 (zero_mem _)
    rw [add_zero] at this
    exact this hmem

  have hu : IsUnit (1 + b) := by
    by_contra hnu
    have h1 : (1 + b) ∈ IsLocalRing.maximalIdeal ↥W := (hmunit _).mpr hnu
    have h2 : (1 : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
      have := Ideal.sub_mem _ h1 hbm
      rwa [add_sub_cancel_right] at this
    exact (hmunit 1).mp h2 isUnit_one
  obtain ⟨ε, hε⟩ : ∃ ε : ↥W, ε * (1 + b) = 1 := ⟨↑hu.unit⁻¹, hu.val_inv_mul⟩
  have heK : algebraMap A K (algebraMap ↥W A ε) * (1 + algebraMap A K (algebraMap ↥W A b)) = 1 := by
    have := congrArg (fun w : ↥W => algebraMap A K (algebraMap ↥W A w)) hε
    simp only [map_mul, map_add, map_one] at this
    exact this
  obtain ⟨γ, hγ⟩ := hroot (1 + b) ℓ hℓ.pos
  have hγ0 : γ ≠ 0 := by
    rintro rfl
    rw [zero_pow hℓ.ne_zero] at hγ
    rw [← hγ] at hu
    exact not_isUnit_zero hu
  have hγK : algebraMap A K (algebraMap ↥W A γ) ^ ℓ = 1 + algebraMap A K (algebraMap ↥W A b) := by
    rw [← map_pow, ← map_pow, hγ]
    simp only [map_add, map_one]
  have hQ : f' / (h * algebraMap A K (algebraMap ↥W A γ)) ^ ℓ =
      f' / h ^ ℓ * algebraMap A K (algebraMap ↥W A ε) := by
    rw [mul_pow, hγK, eq_inv_of_mul_eq_one_left heK, div_eq_mul_inv, div_eq_mul_inv, mul_inv,
      mul_assoc]

  obtain ⟨x₁, hPx₁, hx₀x₁, hxTx₁⟩ : ∃ x, P x ∧ x₀ ∣ x ∧ xT ∣ x :=
    (ValuationRing.dvd_total x₀ xT).elim (fun hd => ⟨xT, hPxT, hd, dvd_rfl⟩)
      (fun hd => ⟨x₀, hPx₀, dvd_rfl, hd⟩)
  obtain ⟨y₁, hPy₁, hy₁y₀, hy₁yT⟩ : ∃ y, ¬ P y ∧ y ∣ y₀ ∧ y ∣ yT :=
    (ValuationRing.dvd_total y₀ yT).elim (fun hd => ⟨y₀, hPy₀, dvd_rfl, hd⟩)
      (fun hd => ⟨yT, hPyT, hd, dvd_rfl⟩)
  have hs₁ : s' * algebraMap ↥W A (1 + b) ∉ 𝔭 := by
    intro hm
    rcases h𝔭prime.mem_or_mem hm with h1 | h1
    · exact hs' h1
    · exact h𝔭max.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 (hu.map (algebraMap ↥W A)))
  refine ⟨h * algebraMap A K (algebraMap ↥W A γ), z - s' * algebraMap ↥W A b,
    s' * algebraMap ↥W A (1 + b), σ, B.filter (fun x => x.2 ≠ 0), x₁, y₁, ?_, hPhi⟩
  unfold wcKpwmgbWin
  refine ⟨mul_ne_zero hh (hψ0 γ hγ0), hs₁, ?_, hσ, hPx₁, hPy₁,
      fun b' hb' => hCONE b' (List.mem_filter.mp hb').1,
      fun b' hb' => hNZB b' (List.mem_filter.mp hb').1, hDIST.filter _, ?_⟩
  · rw [hQ]
    simp only [map_mul, map_add, map_one, map_sub]
    linear_combination hz + algebraMap A K s' * (f' / h ^ ℓ) * heK
  · intro c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hxc hcy
    obtain ⟨⟨ET, hET⟩, hterm⟩ := hWP c₁ c₂ h1 h2 h3 h4 h5 h6 h7 (dvd_trans hx₀x₁ hxc)
      (dvd_trans hcy hy₁y₀)
    obtain ⟨-, -, ⟨r₃, hr₃⟩, -⟩ := hCtxP c₁ c₂ h1 h2 h3 h4 h5 h6 h7 (dvd_trans hxTx₁ hxc)
      (dvd_trans hcy hy₁yT)
    have htermB : ∀ b' ∈ B.filter (fun x => x.2 ≠ 0), ∃ r : ↥(wcLlsInnerCR W A K u c₁ c₂),
        algebraMap A K (algebraMap ↥W A b'.1) * algebraMap A K u ^ b'.2 =
          algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j * (r : K) :=
      fun b' hb' => hterm b' (List.mem_filter.mp hb').1
    refine ⟨?_, htermB⟩
    obtain ⟨rb, hrb⟩ := hterm (b, 0) hbB
    have hb : algebraMap A K (algebraMap ↥W A b) =
        algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j * (rb : K) := by
      simpa only [zpow_zero, mul_one] using hrb
    obtain ⟨ρ, hρ⟩ := hlaurM (wcLlsInnerCR W A K u c₁ c₂)
      (algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j) _ htermB
    have e2 : algebraMap A K u ^ (2 * j) = (algebraMap A K u ^ j) ^ 2 := by
      rw [mul_comm, zpow_mul]
      norm_cast
    have h3' : (algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j) ^ 2 =
        algebraMap A K (algebraMap ↥W A μT) * algebraMap A K u ^ kT * (r₃ : K) := by
      rw [← hr₃, map_pow, map_pow, e2]
      ring
    rw [hsplit B hDIST hbB] at hET
    refine ⟨algebraMap A _ (algebraMap ↥W A ε) * ET -
      algebraMap A _ (algebraMap ↥W A ε) * algebraMap A _ σ * rb * ρ * r₃, ?_⟩
    simp only [AddSubgroupClass.coe_sub, MulMemClass.coe_mul]
    show _ = _ * (algebraMap A K (algebraMap ↥W A ε) * (ET : K) -
      algebraMap A K (algebraMap ↥W A ε) * algebraMap A K σ * (rb : K) * (ρ : K) * (r₃ : K))
    rw [hQ]
    linear_combination algebraMap A K (algebraMap ↥W A ε) * hET +
      algebraMap A K σ * (1 + wcKpwmgbLaur W A K u (B.filter (fun x => x.2 ≠ 0))) * heK -
      algebraMap A K (algebraMap ↥W A ε) * algebraMap A K σ * (rb : K) * (ρ : K) * h3' -
      algebraMap A K (algebraMap ↥W A ε) * algebraMap A K σ *
        (algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j * (ρ : K)) * hb -
      algebraMap A K (algebraMap ↥W A ε) * algebraMap A K σ *
        algebraMap A K (algebraMap ↥W A b) * hρ

theorem wcpa_dj_llsm_kpwmgb_move_nz : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
