theorem wcLlsASr_cdpd_kernel_dies : ∀ (A : Type u) [CommRing A] [IsDomain A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] (ℓ a b k M N : ℕ), ℓ.Prime → Module.finrank K L = ℓ → b * ℓ = a * M + 1 → k + b = a * M → N = M * (ℓ - 1) → ∀ (t u U e : A) (w : L), w ∉ Set.range (algebraMap K L) → t ≠ 0 → u ≠ 0 → algebraMap A L u * algebraMap A L t ^ M * (w ^ ℓ - algebraMap A L e * w) = algebraMap A L U → ∀ (E : Type u) [CommRing E] (π : MvPolynomial (Fin 2) A →+* E) (P : Ideal E) [P.IsPrime], Function.Surjective π → IsDomain (Localization.AtPrime P) → Function.Injective ((algebraMap E (Localization.AtPrime P)).comp (π.comp MvPolynomial.C)) → IsUnit (algebraMap E (Localization.AtPrime P) (π (MvPolynomial.X 0))) → algebraMap E (Localization.AtPrime P) (π (MvPolynomial.X 1)) ≠ 0 → π (MvPolynomial.X 1 ^ ℓ - MvPolynomial.C (u ^ (a * (ℓ - 1)) * t) * MvPolynomial.X 0 ^ a) = 0 → π (MvPolynomial.C (u ^ (a * M * (ℓ - 1))) * MvPolynomial.X 0 ^ k * (MvPolynomial.X 0 - MvPolynomial.C U) - MvPolynomial.C (e * u ^ (k + 1)) * MvPolynomial.X 1 ^ N) = 0 → ∀ ρ : E →+* L, (∀ x : A, ρ (π (MvPolynomial.C x)) = algebraMap A L x) → ρ (π (MvPolynomial.X 0)) = algebraMap A L u * algebraMap A L t ^ M * w ^ ℓ → ρ (π (MvPolynomial.X 1)) = algebraMap A L u ^ a * w ^ a * algebraMap A L t ^ b → ∀ z : E, ρ z = 0 → algebraMap E (Localization.AtPrime P) z = 0 :=
by
  intro A _ _ K _ _ _ L _ _ _ _ _ ℓ a b k M N hℓ hfr hb hk hN t u U e w hw ht hu heq E _ π P _ hπ hdom hinj hX0 hX1 hF1 hF2 ρ hρC hρ0 hρ1 z hz
  classical

  have s2 : ∀ (F : Type u) [Field F] (u t U e x0 x1 w' : F), u ≠ 0 → x0 ≠ 0 → x1 ≠ 0 →
      w' * x1 ^ M = u ^ k * x0 ^ b → x1 ^ ℓ = u ^ (a * (ℓ - 1)) * t * x0 ^ a →
      u ^ (a * M * (ℓ - 1)) * x0 ^ k * (x0 - U) = e * u ^ (k + 1) * x1 ^ N →
      u * t ^ M * w' ^ ℓ = x0 ∧ u ^ a * w' ^ a * t ^ b = x1 ∧ u * t ^ M * (w' ^ ℓ - e * w') = U := by
    intro F _ u t U e x0 x1 w' hu hx0 hx1 hw h1 h2
    obtain ⟨m, rfl⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, by have := hℓ.one_lt; omega⟩
    simp only [Nat.add_sub_cancel] at h1 h2 hN
    subst hN
    have n1 : 1 + k * (m + 1) = a * M * m := by
      have : ((1 + k * (m + 1) : ℕ) : ℤ) = ((a * M * m : ℕ) : ℤ) := by
        have hk' : ((k + b : ℕ) : ℤ) = ((a * M : ℕ) : ℤ) := by rw [hk]
        have hb' : ((b * (m + 1) : ℕ) : ℤ) = ((a * M + 1 : ℕ) : ℤ) := by rw [hb]
        push_cast at hk' hb' ⊢
        linear_combination ((m : ℤ) + 1) * hk' - hb'
      exact_mod_cast this
    have n2 : k + 1 = b * m := by
      have : ((k + 1 : ℕ) : ℤ) = ((b * m : ℕ) : ℤ) := by
        have hk' : ((k + b : ℕ) : ℤ) = ((a * M : ℕ) : ℤ) := by rw [hk]
        have hb' : ((b * (m + 1) : ℕ) : ℤ) = ((a * M + 1 : ℕ) : ℤ) := by rw [hb]
        push_cast at hk' hb' ⊢
        linear_combination hk' - hb'
      exact_mod_cast this
    have hα : u * t ^ M * w' ^ (m + 1) = x0 := by
      have key : u * t ^ M * w' ^ (m + 1) * (x1 ^ M) ^ (m + 1) = x0 * (x1 ^ M) ^ (m + 1) := by
        calc u * t ^ M * w' ^ (m + 1) * (x1 ^ M) ^ (m + 1)
            = u * t ^ M * (w' * x1 ^ M) ^ (m + 1) := by ring
          _ = u * t ^ M * (u ^ k * x0 ^ b) ^ (m + 1) := by rw [hw]
          _ = t ^ M * u ^ (1 + k * (m + 1)) * x0 ^ (b * (m + 1)) := by ring
          _ = t ^ M * u ^ (a * M * m) * x0 ^ (a * M + 1) := by rw [n1, hb]
          _ = x0 * (u ^ (a * m) * t * x0 ^ a) ^ M := by ring
          _ = x0 * (x1 ^ (m + 1)) ^ M := by rw [h1]
          _ = x0 * (x1 ^ M) ^ (m + 1) := by ring
      exact mul_right_cancel₀ (pow_ne_zero _ (pow_ne_zero _ hx1)) key
    have hβ : u ^ a * w' ^ a * t ^ b = x1 := by
      have key : u ^ a * w' ^ a * t ^ b * (x1 ^ M) ^ a = x1 * (x1 ^ M) ^ a := by
        calc u ^ a * w' ^ a * t ^ b * (x1 ^ M) ^ a
            = u ^ a * (w' * x1 ^ M) ^ a * t ^ b := by ring
          _ = u ^ a * (u ^ k * x0 ^ b) ^ a * t ^ b := by rw [hw]
          _ = u ^ (a * (k + 1)) * x0 ^ (a * b) * t ^ b := by ring
          _ = u ^ (a * (b * m)) * x0 ^ (a * b) * t ^ b := by rw [n2]
          _ = (u ^ (a * m) * t * x0 ^ a) ^ b := by ring
          _ = (x1 ^ (m + 1)) ^ b := by rw [h1]
          _ = x1 ^ (b * (m + 1)) := by ring
          _ = x1 ^ (a * M + 1) := by rw [hb]
          _ = x1 * (x1 ^ M) ^ a := by ring
      exact mul_right_cancel₀ (pow_ne_zero _ (pow_ne_zero _ hx1)) key
    have hC : u ^ (a * M * m) * x0 ^ k * (u * t ^ M * w') = u ^ (k + 1) * x1 ^ (M * m) := by
      have key : u ^ (a * M * m) * x0 ^ k * (u * t ^ M * w') * x1 ^ M
          = u ^ (k + 1) * x1 ^ (M * m) * x1 ^ M := by
        calc u ^ (a * M * m) * x0 ^ k * (u * t ^ M * w') * x1 ^ M
            = u ^ (a * M * m) * x0 ^ k * u * t ^ M * (w' * x1 ^ M) := by ring
          _ = u ^ (a * M * m) * x0 ^ k * u * t ^ M * (u ^ k * x0 ^ b) := by rw [hw]
          _ = u ^ (k + 1) * t ^ M * u ^ (a * M * m) * x0 ^ (k + b) := by ring
          _ = u ^ (k + 1) * (u ^ (a * m) * t * x0 ^ a) ^ M := by rw [hk]; ring
          _ = u ^ (k + 1) * (x1 ^ (m + 1)) ^ M := by rw [h1]
          _ = u ^ (k + 1) * x1 ^ (M * m) * x1 ^ M := by ring
      exact mul_right_cancel₀ (pow_ne_zero _ hx1) key
    have hc : u ^ (a * M * m) * x0 ^ k ≠ 0 := mul_ne_zero (pow_ne_zero _ hu) (pow_ne_zero _ hx0)
    have hE' : u ^ (a * M * m) * x0 ^ k * (e * (u * t ^ M * w')) = u ^ (a * M * m) * x0 ^ k * (x0 - U) := by
      linear_combination e * hC - h2
    have hE := mul_left_cancel₀ hc hE'
    refine ⟨hα, hβ, ?_⟩
    linear_combination hα - hE

  have s3 : ∀ (F : Type u) [Field F] (j : K →+* F) (w' : F) (d e c : K), d ≠ 0 →
      algebraMap K L d * (w ^ ℓ - algebraMap K L e * w) = algebraMap K L c →
      j d * (w' ^ ℓ - j e * w') = j c → ∃ ε : L →+* F, ε.comp (algebraMap K L) = j ∧ ε w = w' := by
    intro F _ j w' d e c hd hwd hw'
    have hint : IsIntegral K w := IsIntegral.of_finite K w
    have hdeg : (minpoly K w).natDegree = ℓ := by
      have hdvd : (minpoly K w).natDegree ∣ ℓ := by
        rw [← hfr]
        exact minpoly.degree_dvd hint
      rcases hℓ.eq_one_or_self_of_dvd _ hdvd with h1 | h1
      · exfalso
        exact hw ((minpoly.natDegree_eq_one_iff).mp h1)
      · exact h1
    have hlinN : (Polynomial.C e * Polynomial.X + Polynomial.C (c / d)).natDegree < ℓ :=
      lt_of_le_of_lt Polynomial.natDegree_linear_le hℓ.one_lt
    have hpX : (Polynomial.X ^ ℓ : Polynomial K).natDegree = ℓ := Polynomial.natDegree_X_pow ℓ
    have hpm : (Polynomial.X ^ ℓ - (Polynomial.C e * Polynomial.X + Polynomial.C (c / d))).Monic :=
      (Polynomial.monic_X_pow ℓ).sub_of_left (by
        rw [Polynomial.degree_X_pow]
        exact lt_of_le_of_lt Polynomial.degree_linear_le (by exact_mod_cast hℓ.one_lt))
    have hpdeg : (Polynomial.X ^ ℓ - (Polynomial.C e * Polynomial.X + Polynomial.C (c / d))).natDegree = ℓ := by
      rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt (by rw [hpX]; exact hlinN), hpX]
    have hdL : algebraMap K L d ≠ 0 := (map_ne_zero _).mpr hd
    have hcd : algebraMap K L (c / d) = w ^ ℓ - algebraMap K L e * w := by
      rw [map_div₀, div_eq_iff hdL, ← hwd]; ring
    have hpw : Polynomial.aeval w (Polynomial.X ^ ℓ - (Polynomial.C e * Polynomial.X + Polynomial.C (c / d))) = 0 := by
      simp only [map_sub, map_add, map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
      rw [hcd]; ring
    have hmin : (Polynomial.X ^ ℓ - (Polynomial.C e * Polynomial.X + Polynomial.C (c / d))) = minpoly K w :=
      Polynomial.eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hint) hpm (minpoly.dvd K w hpw)
        (by rw [hpdeg, hdeg])
    have htop : IntermediateField.adjoin K {w} = ⊤ := by
      apply IntermediateField.eq_of_le_of_finrank_eq le_top
      rw [IntermediateField.adjoin.finrank hint, hdeg, IntermediateField.finrank_top', hfr]
    have htop' : Algebra.adjoin K {w} = ⊤ := by
      rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hint.isAlgebraic, htop,
        IntermediateField.top_toSubalgebra]
    letI : Algebra K F := j.toAlgebra
    have hjd : j d ≠ 0 := (map_ne_zero _).mpr hd
    have hcd' : j (c / d) = w' ^ ℓ - j e * w' := by
      rw [map_div₀, div_eq_iff hjd, ← hw']; ring
    have hy : Polynomial.aeval w' (minpoly K (PowerBasis.ofAdjoinEqTop hint htop').gen) = 0 := by
      rw [PowerBasis.ofAdjoinEqTop_gen, ← hmin]
      simp only [map_sub, map_add, map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C,
        RingHom.algebraMap_toAlgebra]
      rw [hcd']; ring
    refine ⟨((PowerBasis.ofAdjoinEqTop hint htop').lift w' hy).toRingHom, ?_, ?_⟩
    · ext x
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, AlgHom.commutes,
        RingHom.algebraMap_toAlgebra]
    · simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      have hl := PowerBasis.lift_gen (PowerBasis.ofAdjoinEqTop hint htop') w' hy
      rwa [PowerBasis.ofAdjoinEqTop_gen] at hl

  haveI := hdom
  have hRF : Function.Injective (algebraMap (Localization.AtPrime P) (FractionRing (Localization.AtPrime P))) :=
    IsFractionRing.injective _ _
  set ι : E →+* FractionRing (Localization.AtPrime P) :=
    (algebraMap (Localization.AtPrime P) (FractionRing (Localization.AtPrime P))).comp
      (algebraMap E (Localization.AtPrime P)) with hι
  have hg : Function.Injective (ι.comp (π.comp MvPolynomial.C)) := fun x y h => hinj (hRF h)
  set j : K →+* FractionRing (Localization.AtPrime P) := IsFractionRing.lift hg with hjdef
  have hJ : ∀ x : A, j (algebraMap A K x) = ι (π (MvPolynomial.C x)) := fun x =>
    IsFractionRing.lift_algebraMap hg x
  have hx0 : ι (π (MvPolynomial.X 0)) ≠ 0 :=
    (hX0.map (algebraMap (Localization.AtPrime P) (FractionRing (Localization.AtPrime P)))).ne_zero
  have hx1 : ι (π (MvPolynomial.X 1)) ≠ 0 := fun h => hX1 (hRF (h.trans (map_zero _).symm))
  have huh : ι (π (MvPolynomial.C u)) ≠ 0 := fun h => hu (hg (h.trans (map_zero _).symm))
  have hF1' : ι (π (MvPolynomial.X 1)) ^ ℓ = ι (π (MvPolynomial.C u)) ^ (a * (ℓ - 1)) *
      ι (π (MvPolynomial.C t)) * ι (π (MvPolynomial.X 0)) ^ a := by
    have h := congrArg ι hF1
    simp only [map_sub, map_mul, map_pow, map_zero] at h
    linear_combination h
  have hF2' : ι (π (MvPolynomial.C u)) ^ (a * M * (ℓ - 1)) * ι (π (MvPolynomial.X 0)) ^ k *
      (ι (π (MvPolynomial.X 0)) - ι (π (MvPolynomial.C U))) =
      ι (π (MvPolynomial.C e)) * ι (π (MvPolynomial.C u)) ^ (k + 1) * ι (π (MvPolynomial.X 1)) ^ N := by
    have h := congrArg ι hF2
    simp only [map_sub, map_mul, map_pow, map_zero] at h
    linear_combination h
  obtain ⟨ŵ, hŵ⟩ : ∃ y : FractionRing (Localization.AtPrime P),
      y * ι (π (MvPolynomial.X 1)) ^ M = ι (π (MvPolynomial.C u)) ^ k * ι (π (MvPolynomial.X 0)) ^ b :=
    ⟨_, div_mul_cancel₀ _ (pow_ne_zero _ hx1)⟩
  obtain ⟨hα, hβ, hγ⟩ := s2 _ _ _ _ _ _ _ ŵ huh hx0 hx1 hŵ hF1' hF2'
  have hAK : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hd : algebraMap A K u * algebraMap A K t ^ M ≠ 0 :=
    mul_ne_zero ((map_ne_zero_iff _ hAK).mpr hu) (pow_ne_zero _ ((map_ne_zero_iff _ hAK).mpr ht))
  have heqK : algebraMap K L (algebraMap A K u * algebraMap A K t ^ M) *
      (w ^ ℓ - algebraMap K L (algebraMap A K e) * w) = algebraMap K L (algebraMap A K U) := by
    simp only [IsScalarTower.algebraMap_apply A K L] at heq
    simp only [map_mul, map_pow]
    linear_combination heq
  have hγ' : j (algebraMap A K u * algebraMap A K t ^ M) *
      (ŵ ^ ℓ - j (algebraMap A K e) * ŵ) = j (algebraMap A K U) := by
    simp only [map_mul, map_pow, hJ]
    linear_combination hγ
  obtain ⟨ε, hεK, hεw⟩ := s3 _ j ŵ _ _ _ hd heqK hγ'
  have hεA : ∀ x : A, ε (algebraMap A L x) = ι (π (MvPolynomial.C x)) := by
    intro x
    rw [IsScalarTower.algebraMap_apply A K L, ← RingHom.comp_apply, hεK, hJ]
  have hcomp : (ε.comp ρ).comp π = ι.comp π := by
    apply MvPolynomial.ringHom_ext
    · intro x
      simp only [RingHom.comp_apply]
      rw [hρC, hεA]
    · intro i
      fin_cases i
      · show ε (ρ (π (MvPolynomial.X 0))) = ι (π (MvPolynomial.X 0))
        rw [hρ0]
        simp only [map_mul, map_pow, hεA, hεw]
        exact hα
      · show ε (ρ (π (MvPolynomial.X 1))) = ι (π (MvPolynomial.X 1))
        rw [hρ1]
        simp only [map_mul, map_pow, hεA, hεw]
        exact hβ
  obtain ⟨p, rfl⟩ := hπ z
  have h := RingHom.congr_fun hcomp p
  simp only [RingHom.comp_apply] at h
  rw [hz, map_zero] at h
  exact hRF (h.symm.trans (map_zero _).symm)

theorem wcLlsASr_cdpd_quot_loc : ∀ (E : Type u) [CommRing E] (P : Ideal E) [P.IsPrime] (I : Ideal E), (∀ z ∈ I, algebraMap E (Localization.AtPrime P) z = 0) → ∃ (_ : (P.map (Ideal.Quotient.mk I)).IsPrime), ∃ Θ : Localization.AtPrime (P.map (Ideal.Quotient.mk I)) ≃+* Localization.AtPrime P, ∀ z : E, Θ (algebraMap (E ⧸ I) (Localization.AtPrime (P.map (Ideal.Quotient.mk I))) (Ideal.Quotient.mk I z)) = algebraMap E (Localization.AtPrime P) z :=
by
  intro E _ P _ I hI
  have hIP : I ≤ P := by
    intro z hz
    obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff P.primeCompl (Localization.AtPrime P) z).mp (hI z hz)
    have h0 : (m : E) * z ∈ P := by rw [hm]; exact P.zero_mem
    exact ((‹P.IsPrime›).mem_or_mem h0).resolve_left m.2
  have hP' : (P.map (Ideal.Quotient.mk I)).IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [Ideal.mk_ker]; exact hIP)
  refine ⟨hP', ?_⟩
  have hmem : ∀ x : E, Ideal.Quotient.mk I x ∈ P.map (Ideal.Quotient.mk I) ↔ x ∈ P :=
    fun x => Ideal.mem_quotient_iff_mem hIP
  set P' := P.map (Ideal.Quotient.mk I) with hP'def
  let g : E →+* Localization.AtPrime P' :=
    (algebraMap (E ⧸ I) (Localization.AtPrime P')).comp (Ideal.Quotient.mk I)
  have hg : ∀ y : P.primeCompl, IsUnit (g y) := by
    intro y
    have hy : Ideal.Quotient.mk I (y : E) ∈ P'.primeCompl := fun h => y.2 ((hmem y).mp h)
    exact IsLocalization.map_units (Localization.AtPrime P') (⟨_, hy⟩ : P'.primeCompl)
  let Φ : Localization.AtPrime P →+* Localization.AtPrime P' :=
    IsLocalization.lift (M := P.primeCompl) hg
  let ψ : E ⧸ I →+* Localization.AtPrime P := Ideal.Quotient.lift I (algebraMap E _) hI
  have hψ : ∀ y : P'.primeCompl, IsUnit (ψ y) := by
    intro y
    obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective (y : E ⧸ I)
    have hxP : x ∈ P.primeCompl := fun h => y.2 (by rw [← hx]; exact (hmem x).mpr h)
    have : ψ y = algebraMap E (Localization.AtPrime P) x := by
      rw [← hx]; exact Ideal.Quotient.lift_mk I _ hI
    rw [this]
    exact IsLocalization.map_units (Localization.AtPrime P) (⟨x, hxP⟩ : P.primeCompl)
  let Θ : Localization.AtPrime P' →+* Localization.AtPrime P :=
    IsLocalization.lift (M := P'.primeCompl) hψ
  have hΦ : ∀ x : E, Φ (algebraMap E _ x) = algebraMap (E ⧸ I) _ (Ideal.Quotient.mk I x) :=
    fun x => IsLocalization.lift_eq hg x
  have hΘ : ∀ x : E, Θ (algebraMap (E ⧸ I) _ (Ideal.Quotient.mk I x)) = algebraMap E _ x := by
    intro x
    show IsLocalization.lift hψ _ = _
    rw [IsLocalization.lift_eq]
    exact Ideal.Quotient.lift_mk I _ hI
  have h1 : Θ.comp Φ = RingHom.id _ := by
    apply IsLocalization.ringHom_ext P.primeCompl
    ext x
    simp only [RingHom.comp_apply, RingHom.id_apply]
    rw [hΦ, hΘ]
  have h2 : Φ.comp Θ = RingHom.id _ := by
    apply IsLocalization.ringHom_ext P'.primeCompl
    apply Ideal.Quotient.ringHom_ext
    ext x
    simp only [RingHom.comp_apply, RingHom.id_apply]
    rw [hΘ, hΦ]
  exact ⟨RingEquiv.ofRingHom Θ Φ h1 h2, fun z => hΘ z⟩

theorem wcLlsASr_cdpd_order_frac : ∀ (A : Type u) [CommRing A] [IsDomain A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] (ℓ : ℕ), ℓ.Prime → Module.finrank K L = ℓ → ∀ (w : L), w ∉ Set.range (algebraMap K L) → ∀ (R : Type u) [CommRing R] (κ : R →+* L), (∀ x : A, ∃ r : R, κ r = algebraMap A L x) → ∀ r₁ r₂ : R, κ r₂ ≠ 0 → κ r₂ * w = κ r₁ → ∀ l : L, ∃ r r' : R, κ r' ≠ 0 ∧ κ r' * l = κ r :=
by
  intro A _ _ K _ _ _ L _ _ _ _ _ ℓ hℓ hrank w hw R _ κ hA r₁ r₂ hr₂ hr₁₂ l
  classical
  have hAKinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hALinj : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp hAKinj
  have hAS : ∀ x : A, algebraMap A L x ∈ κ.range := by
    intro x
    obtain ⟨r, hr⟩ := hA x
    exact ⟨r, hr⟩
  have hs : κ r₂ ∈ κ.range := ⟨r₂, rfl⟩
  have hsw : κ r₂ * w ∈ κ.range := ⟨r₁, hr₁₂.symm⟩
  have hint : IsIntegral K w := IsIntegral.of_finite K w
  have hdeg : (minpoly K w).natDegree = ℓ := by
    have hdvd : (minpoly K w).natDegree ∣ ℓ := by
      rw [← hrank]
      exact minpoly.degree_dvd hint
    rcases hℓ.eq_one_or_self_of_dvd _ hdvd with h1 | h1
    · exfalso
      exact hw ((minpoly.natDegree_eq_one_iff).mp h1)
    · exact h1
  have htop : IntermediateField.adjoin K {w} = ⊤ := by
    apply IntermediateField.eq_of_le_of_finrank_eq le_top
    rw [IntermediateField.adjoin.finrank hint, hdeg, IntermediateField.finrank_top', hrank]
  have hl : l ∈ (IntermediateField.adjoin K {w}).toSubalgebra := by
    rw [htop]; exact IntermediateField.mem_top
  rw [IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hint.isAlgebraic,
    Algebra.adjoin_singleton_eq_range_aeval] at hl
  obtain ⟨p, hp⟩ := hl
  have hp' : Polynomial.aeval w p = l := hp
  obtain ⟨b, hb, hbq⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors A) p
  have hq : Polynomial.aeval w (IsLocalization.integerNormalization (nonZeroDivisors A) p) =
      algebraMap A L b * l := by
    rw [← Polynomial.aeval_map_algebraMap K, hbq]
    rw [← algebraMap_smul K b p, map_smul, hp', Algebra.smul_def,
      ← IsScalarTower.algebraMap_apply]
  have hb0 : algebraMap A L b ≠ 0 := by
    intro h0
    apply nonZeroDivisors.ne_zero hb
    exact hALinj (h0.trans (map_zero _).symm)
  generalize IsLocalization.integerNormalization (nonZeroDivisors A) p = q at hq
  have hmem : κ r₂ ^ q.natDegree * Polynomial.aeval w q ∈ κ.range := by
    rw [Polynomial.aeval_eq_sum_range, Finset.mul_sum]
    refine Subring.sum_mem _ (fun i hi => ?_)
    have hin : i ≤ q.natDegree := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
    have e : κ r₂ ^ q.natDegree * (q.coeff i • w ^ i) =
        algebraMap A L (q.coeff i) * (κ r₂ ^ (q.natDegree - i) * (κ r₂ * w) ^ i) := by
      rw [Algebra.smul_def, mul_pow, ← pow_mul_pow_sub (κ r₂) hin]
      ring
    rw [e]
    exact Subring.mul_mem _ (hAS _) (Subring.mul_mem _ (Subring.pow_mem _ hs _)
      (Subring.pow_mem _ hsw _))
  obtain ⟨r, hr⟩ := hmem
  obtain ⟨rb, hrb⟩ := hA b
  refine ⟨r, rb * r₂ ^ q.natDegree, ?_, ?_⟩
  · rw [map_mul, map_pow, hrb]
    exact mul_ne_zero hb0 (pow_ne_zero _ hr₂)
  · rw [hr, map_mul, map_pow, hrb, hq]
    ring

theorem wcLlsASr_cd_pd_delta : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → Module.finrank K L = ℓ → ∀ μ : ↥W, μ ∈ IsLocalRing.maximalIdeal ↥W → ∀ M : ℕ, 0 < M → ¬ ℓ ∣ M → ∀ (w : L) (U₁ U₂ : A), w ∉ Set.range (algebraMap K L) → U₁ ∉ 𝔭 → U₂ ∉ 𝔭 → algebraMap A L U₂ * algebraMap A L t ^ M * (w ^ ℓ - algebraMap A L (algebraMap ↥W A μ) ^ (ℓ - 1) * w) = algebraMap A L U₁ → ∀ (y : Ideal ↥(integralClosure A L)) (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → wcpaDjLkDelta (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) = 0 :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD hfr μ hμ M hM hℓM w U₁ U₂
    hw hU₁ hU₂ heq y hy hyc
  classical
  have hPD' := hPD
  obtain ⟨-, -, hic, hmax, hm𝔭, ht, h𝔭eq, h, hh, f₀, hfC, hfX, hfet⟩ := hPD
  haveI h𝔭p : 𝔭.IsPrime := hmax.isPrime
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  have hℓ2 := hℓ.two_le

  have s11 : ∀ (B : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B],
      wcpaDjLkDelta B = 0 := by
    intro B _ _ _
    unfold wcpaDjLkDelta
    rw [Module.length_eq_zero_iff]
    have htop : LinearMap.range
        (Algebra.linearMap B ↥(integralClosure B (FractionRing B))) = ⊤ := by
      rw [eq_top_iff]
      rintro ⟨x, hx⟩ -
      obtain ⟨b, hb⟩ := IsIntegrallyClosed.isIntegral_iff.mp (show IsIntegral B x from hx)
      exact LinearMap.mem_range.mpr ⟨b, Subtype.ext hb⟩
    constructor
    intro a b
    induction a using Submodule.Quotient.induction_on with
    | _ a =>
    induction b using Submodule.Quotient.induction_on with
    | _ b =>
    rw [Submodule.Quotient.eq, htop]
    exact Submodule.mem_top

  have hMz : (M : ZMod ℓ) ≠ 0 := fun h0 => hℓM ((ZMod.natCast_eq_zero_iff M ℓ).mp h0)
  obtain ⟨a, ha⟩ : ∃ a : ℕ, ((a * M + 1 : ℕ) : ZMod ℓ) = 0 := by
    refine ⟨(-(M : ZMod ℓ)⁻¹).val, ?_⟩
    rw [Nat.cast_add, Nat.cast_mul, ZMod.natCast_zmod_val, Nat.cast_one, neg_mul,
      inv_mul_cancel₀ hMz, neg_add_cancel]
  obtain ⟨b, hb⟩ := (ZMod.natCast_eq_zero_iff _ _).mp ha
  have hb0 : b ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hb
    exact Nat.succ_ne_zero _ hb
  have hbl : 2 * b ≤ ℓ * b := Nat.mul_le_mul_right b hℓ2
  have hbM : b ≤ a * M := by omega
  obtain ⟨k, hk⟩ : ∃ k : ℕ, k + b = a * M := ⟨a * M - b, by omega⟩
  have hbℓ : b * ℓ = a * M + 1 := by rw [hb, mul_comm]
  obtain ⟨N, hNdef⟩ : ∃ N : ℕ, N = M * (ℓ - 1) := ⟨_, rfl⟩
  have hN : 0 < N := by rw [hNdef]; exact Nat.mul_pos hM (by omega)

  have hinjAL : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)
  have ht0 : t ≠ 0 := by
    intro ht0
    apply hU₁
    have h1 : algebraMap A L U₁ = 0 := by
      rw [← heq, ht0, map_zero, zero_pow hM.ne', mul_zero, zero_mul]
    rw [hinjAL (h1.trans (map_zero _).symm)]
    exact 𝔭.zero_mem
  have hu0 : U₂ ≠ 0 := by
    intro h0; apply hU₂; rw [h0]; exact 𝔭.zero_mem
  have hw0 : w ≠ 0 := fun h0 => hw ⟨0, by rw [map_zero, h0]⟩
  have huL : algebraMap A L U₂ ≠ 0 := (map_ne_zero_iff _ hinjAL).mpr hu0
  have htL : algebraMap A L t ≠ 0 := (map_ne_zero_iff _ hinjAL).mpr ht0
  obtain ⟨eA, heA⟩ : ∃ e : A, e = algebraMap ↥W A μ ^ (ℓ - 1) := ⟨_, rfl⟩
  have heq' : algebraMap A L U₂ * algebraMap A L t ^ M * (w ^ ℓ - algebraMap A L eA * w) =
      algebraMap A L U₁ := by rw [heA, map_pow]; exact heq
  have he𝔭 : eA ∈ 𝔭 := by
    rw [heA]; exact Ideal.pow_mem_of_mem 𝔭 (hm𝔭 (Ideal.mem_map_of_mem _ hμ)) _ (by omega)
  have hc1 : U₂ ^ (a * (ℓ - 1)) ∉ 𝔭 := fun h0 => hU₂ (h𝔭p.mem_of_pow_mem _ h0)
  have hc2 : U₂ ^ (a * M * (ℓ - 1)) ∉ 𝔭 := fun h0 => hU₂ (h𝔭p.mem_of_pow_mem _ h0)
  have hc12 : U₂ ^ (a * (ℓ - 1)) * U₂ ^ (a * M * (ℓ - 1)) ∉ 𝔭 := fun h0 =>
    (h𝔭p.mem_or_mem h0).elim hc1 hc2

  obtain ⟨hz, hx, hF1L, hF2L, hwL⟩ := wcLlsASr_cdpd_as_identities L ℓ a b k M N
    (algebraMap A L U₂) (algebraMap A L t) w (algebraMap A L U₁) (algebraMap A L eA)
    hbℓ hk hNdef heq'

  have hzint : IsIntegral A (algebraMap A L U₂ * algebraMap A L t ^ M * w) := by
    refine ⟨Polynomial.X ^ ℓ - (Polynomial.C (eA * (U₂ * t ^ M) ^ (ℓ - 1)) * Polynomial.X +
      Polynomial.C ((U₂ * t ^ M) ^ (ℓ - 1) * U₁)), ?_, ?_⟩
    · apply Polynomial.monic_X_pow_sub
      exact lt_of_le_of_lt Polynomial.degree_linear_le (by exact_mod_cast hℓ.one_lt)
    · simp only [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_add,
        Polynomial.eval₂_mul, Polynomial.eval₂_pow, Polynomial.eval₂_C, Polynomial.eval₂_X, map_mul, map_pow]
      linear_combination hz
  have hxint : IsIntegral A (algebraMap A L U₂ * algebraMap A L t ^ M * w ^ ℓ) := by
    rw [hx]; exact isIntegral_algebraMap.add (isIntegral_algebraMap.mul hzint)
  have hPiint : IsIntegral A (algebraMap A L U₂ ^ a * w ^ a * algebraMap A L t ^ b) := by
    refine IsIntegral.of_pow hℓ.pos ?_
    rw [hF1L]
    exact ((isIntegral_algebraMap.pow _).mul isIntegral_algebraMap).mul (hxint.pow _)

  obtain ⟨J, hJ⟩ : ∃ J : Ideal (MvPolynomial (Fin 2) A), J = Ideal.span
      {MvPolynomial.X 1 ^ ℓ - MvPolynomial.C (U₂ ^ (a * (ℓ - 1)) * t) * MvPolynomial.X 0 ^ a,
        MvPolynomial.C (U₂ ^ (a * M * (ℓ - 1))) * MvPolynomial.X 0 ^ k *
          (MvPolynomial.X 0 - MvPolynomial.C U₁) -
          MvPolynomial.C (eA * U₂ ^ (k + 1)) * MvPolynomial.X 1 ^ N} := ⟨_, rfl⟩
  have hJρ : J ≤ RingHom.ker (MvPolynomial.eval₂Hom (algebraMap A L)
      ![algebraMap A L U₂ * algebraMap A L t ^ M * w ^ ℓ,
        algebraMap A L U₂ ^ a * w ^ a * algebraMap A L t ^ b]) := by
    rw [hJ, Ideal.span_le]
    intro p hp
    rcases hp with rfl | hp
    · rw [SetLike.mem_coe, RingHom.mem_ker]
      simp only [map_sub, map_mul, map_pow, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
        Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
      linear_combination hF1L
    · rw [Set.mem_singleton_iff] at hp
      subst hp
      rw [SetLike.mem_coe, RingHom.mem_ker]
      simp only [map_sub, map_mul, map_pow, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
        Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
      linear_combination hF2L
  obtain ⟨E, iE, iWE, iAE, iT, π, ρ, hπs, hπker, hπW, hπA, hρC, hρ0, hρ1⟩ :
      ∃ (E : Type u) (_ : CommRing E) (_ : Algebra ↥W E) (_ : Algebra A E)
        (_ : IsScalarTower ↥W A E) (π : MvPolynomial (Fin 2) A →+* E) (ρ : E →+* L),
        Function.Surjective π ∧ RingHom.ker π = J ∧
        (∀ w : ↥W, algebraMap ↥W E w = π (MvPolynomial.C (algebraMap ↥W A w))) ∧
        (∀ x : A, algebraMap A E x = π (MvPolynomial.C x)) ∧
        (∀ x : A, ρ (π (MvPolynomial.C x)) = algebraMap A L x) ∧
        ρ (π (MvPolynomial.X 0)) = algebraMap A L U₂ * algebraMap A L t ^ M * w ^ ℓ ∧
        ρ (π (MvPolynomial.X 1)) = algebraMap A L U₂ ^ a * w ^ a * algebraMap A L t ^ b :=
    ⟨MvPolynomial (Fin 2) A ⧸ J, inferInstance, inferInstance, inferInstance, inferInstance,
      Ideal.Quotient.mk J, Ideal.Quotient.lift J _ (fun p hp => RingHom.mem_ker.mp (hJρ hp)),
      Ideal.Quotient.mk_surjective, Ideal.mk_ker, fun _ => rfl, fun _ => rfl,
      fun x => by rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C],
      by rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']; rfl,
      by rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']; rfl⟩
  have hF1 : π (MvPolynomial.X 1 ^ ℓ -
      MvPolynomial.C (U₂ ^ (a * (ℓ - 1)) * t) * MvPolynomial.X 0 ^ a) = 0 := by
    rw [← RingHom.mem_ker, hπker, hJ]; exact Ideal.subset_span (Set.mem_insert _ _)
  have hF2 : π (MvPolynomial.C (U₂ ^ (a * M * (ℓ - 1))) *
      MvPolynomial.X 0 ^ k * (MvPolynomial.X 0 - MvPolynomial.C U₁) -
      MvPolynomial.C (eA * U₂ ^ (k + 1)) * MvPolynomial.X 1 ^ N) = 0 := by
    rw [← RingHom.mem_ker, hπker, hJ]
    exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  have hF1E : π (MvPolynomial.X 1) ^ ℓ =
      π (MvPolynomial.C (U₂ ^ (a * (ℓ - 1)) * t)) * π (MvPolynomial.X 0) ^ a := by
    have h1 := hF1
    rw [map_sub, map_mul π, map_pow π, map_pow π] at h1
    exact sub_eq_zero.mp h1

  obtain ⟨P, hPdef⟩ : ∃ P : Ideal E, P = Ideal.span
      {π (MvPolynomial.X 0 - MvPolynomial.C U₁),
        π (MvPolynomial.X 1)} ⊔
      𝔭.map ((π).comp MvPolynomial.C) := ⟨_, rfl⟩
  obtain ⟨hPmax, hPA, hX0P, hmP, hPeq⟩ := wcLlsASr_cdpd_model_point Ω W A 𝔭 t
    (U₂ ^ (a * (ℓ - 1))) (U₂ ^ (a * M * (ℓ - 1))) (eA * U₂ ^ (k + 1)) U₁ ℓ a k N
    E (π) hmax h𝔭eq hU₁ hℓ.pos hN
    hπs (hπker.trans hJ) hπW P hPdef
  haveI hPprime : P.IsPrime := hPmax.isPrime
  have hPcomap : P.comap (algebraMap A E) = 𝔭 := by
    ext x
    rw [Ideal.mem_comap]
    constructor
    · intro hx
      by_contra hx'
      exact hPA x hx' (by rw [← hπA]; exact hx)
    · intro hx
      rw [hPdef, hπA]
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem ((π).comp MvPolynomial.C) hx)

  have hg₀P : π (MvPolynomial.X 0 *
      MvPolynomial.C (U₂ ^ (a * (ℓ - 1)) * U₂ ^ (a * M * (ℓ - 1)))) ∉ P := by
    rw [map_mul]
    intro hmem
    rcases hPprime.mem_or_mem hmem with h1 | h1
    · exact hX0P h1
    · exact hPA _ hc12 h1
  obtain ⟨g, hgP, hg₀g, f, hfC', hfX', hfet'⟩ := wcLlsASr_cdpd_model_etale Ω W A 𝔭 t h
    (U₂ ^ (a * (ℓ - 1))) (U₂ ^ (a * M * (ℓ - 1))) (eA * U₂ ^ (k + 1)) U₁ ℓ a k N f₀
    E (π) hm𝔭 ht hh hc1 hc2 hU₁ hN hfC hfX hfet
    hπs (hπker.trans hJ) hπW P hPdef hPA _ hg₀P
  have hunit : IsUnit (algebraMap _ (Localization.Away g) (π
      (MvPolynomial.X 0 * MvPolynomial.C (U₂ ^ (a * (ℓ - 1)) * U₂ ^ (a * M * (ℓ - 1)))))) :=
    isUnit_of_dvd_unit (map_dvd _ hg₀g) (IsLocalization.Away.algebraMap_isUnit g)

  obtain ⟨hDdom, hDVR, hτ⟩ := wcLlsKP_ed_chart_special_dvr Ω W _ P
    (π (MvPolynomial.X 1)) g f hmP hgP (hPeq g hunit) hfC' hfX' hfet'
  obtain ⟨hdom, hnorm⟩ := wcLlsKP_ed_etale_point_normal Ω W _ g P f hgP hfet'
  haveI := hdom
  haveI := hnorm
  have htf := wcLlsASr_cdpd_torsion_free Ω W _ g P f hgP hfC' hfet'

  have hτ0 : Ideal.Quotient.mk (((IsLocalRing.maximalIdeal ↥W).map
      (algebraMap ↥W E)).map
        (algebraMap _ (Localization.AtPrime P)))
      (algebraMap _ (Localization.AtPrime P) (algebraMap A E t)) ≠ 0 := by
    intro h0
    let qE : E →+* (Localization.AtPrime P ⧸
        ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W E)).map
          (algebraMap _ (Localization.AtPrime P))) :=
      (Ideal.Quotient.mk _).comp (algebraMap _ (Localization.AtPrime P))
    have h2 : qE (π (MvPolynomial.X 1)) ^ ℓ =
        qE (π (MvPolynomial.C (U₂ ^ (a * (ℓ - 1))))) *
          qE (π (MvPolynomial.C t)) *
          qE (π (MvPolynomial.X 0)) ^ a := by
      rw [← map_pow, hF1E]
      simp only [map_mul, map_pow]
    have h3 : qE (π (MvPolynomial.C t)) = 0 := by
      simp only [qE, RingHom.comp_apply, ← hπA]; exact h0
    rw [h3, mul_zero, zero_mul] at h2
    exact hτ.ne_zero ((pow_eq_zero_iff hℓ.ne_zero).mp h2)

  have hAinj0 := wcLlsASr_cdpd_base_injective Ω W hW hWt A 𝔭 t hPD'
    E P hPcomap htf hDdom hτ0
  have hAinjE : Function.Injective ((algebraMap _ (Localization.AtPrime P)).comp
      ((π).comp MvPolynomial.C)) := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    by_contra hx0
    exact hAinj0 x hx0 (by rw [hπA]; exact hx)
  have hX0u : IsUnit (algebraMap _ (Localization.AtPrime P)
      (π (MvPolynomial.X 0))) :=
    (IsLocalization.AtPrime.isUnit_to_map_iff _ P _).mpr hX0P
  have hX1 : algebraMap _ (Localization.AtPrime P)
      (π (MvPolynomial.X 1)) ≠ 0 := by
    intro h0; apply hτ.ne_zero; rw [h0, map_zero]

  have hkd := wcLlsASr_cdpd_kernel_dies A K L ℓ a b k M N hℓ hfr hbℓ hk hNdef t U₂ U₁ eA w hw
    ht0 hu0 heq' _ (π) P hπs hdom hAinjE hX0u hX1
    hF1 hF2 ρ hρC hρ0 hρ1

  obtain ⟨hPRp, Θ, hΘ⟩ := wcLlsASr_cdpd_quot_loc _ P (RingHom.ker ρ)
    (fun z hz => hkd z (RingHom.mem_ker.mp hz))
  have hRdom : IsDomain (Localization.AtPrime (P.map (Ideal.Quotient.mk (RingHom.ker ρ)))) :=
    MulEquiv.isDomain _ Θ.toMulEquiv
  have hRnorm : IsIntegrallyClosed (Localization.AtPrime
      (P.map (Ideal.Quotient.mk (RingHom.ker ρ)))) := IsIntegrallyClosed.of_equiv Θ.symm

  have hEint : ∀ z : E, IsIntegral A (ρ z) := by
    intro z
    obtain ⟨p, rfl⟩ := hπs z
    induction p using MvPolynomial.induction_on with
    | C a' => rw [hρC]; exact isIntegral_algebraMap
    | add p q hp hq => rw [map_add, map_add]; exact hp.add hq
    | mul_X p n hp =>
      rw [map_mul, map_mul]
      refine hp.mul ?_
      have hn : n = 0 ∨ n = 1 := by fin_cases n <;> simp
      rcases hn with rfl | rfl
      · rw [hρ0]; exact hxint
      · rw [hρ1]; exact hPiint
  have hint : ∀ r, ρ.kerLift r ∈ integralClosure A L := by
    intro r
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective r
    rw [RingHom.kerLift_mk]
    exact hEint z
  let κ : E ⧸ RingHom.ker ρ →+* ↥(integralClosure A L) :=
    ρ.kerLift.codRestrict (integralClosure A L) hint
  have hκv : ∀ r, ((κ r : ↥(integralClosure A L)) : L) = ρ.kerLift r := fun r => rfl
  have hκinj : Function.Injective κ := fun r r' hrr =>
    RingHom.kerLift_injective ρ (by rw [← hκv, ← hκv, hrr])
  have hκC : ∀ x : A, κ (Ideal.Quotient.mk (RingHom.ker ρ)
      (π (MvPolynomial.C x))) = algebraMap A ↥(integralClosure A L) x :=
    fun x => Subtype.ext ((RingHom.kerLift_mk ρ _).trans (hρC x))

  have hr₂ : ρ.kerLift (Ideal.Quotient.mk (RingHom.ker ρ)
      (π (MvPolynomial.X 1 ^ M))) ≠ 0 := by
    rw [RingHom.kerLift_mk]
    simp only [map_pow, hρ1]
    exact pow_ne_zero _ (mul_ne_zero (mul_ne_zero (pow_ne_zero _ huL) (pow_ne_zero _ hw0))
      (pow_ne_zero _ htL))
  have hr₁₂ : ρ.kerLift (Ideal.Quotient.mk (RingHom.ker ρ)
      (π (MvPolynomial.X 1 ^ M))) * w =
      ρ.kerLift (Ideal.Quotient.mk (RingHom.ker ρ)
        (π (MvPolynomial.C (U₂ ^ k) * MvPolynomial.X 0 ^ b))) := by
    rw [RingHom.kerLift_mk, RingHom.kerLift_mk]
    simp only [map_pow, map_mul, hρ0, hρ1, hρC]
    linear_combination -hwL
  have hof := wcLlsASr_cdpd_order_frac A K L ℓ hℓ hfr w hw _ ρ.kerLift
    (fun x => ⟨Ideal.Quotient.mk (RingHom.ker ρ) (π (MvPolynomial.C x)),
      by rw [RingHom.kerLift_mk, hρC]⟩) _ _ hr₂ hr₁₂

  have hPRmax : (P.map (Ideal.Quotient.mk (RingHom.ker ρ))).IsMaximal :=
    (Ideal.map_eq_top_or_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective hPmax).resolve_left
      hPRp.ne_top
  have h𝔭Y : ∀ x ∈ 𝔭, algebraMap A ↥(integralClosure A L) x ∈ y := by
    intro x hx
    have h1 : x ∈ y.comap (algebraMap A ↥(integralClosure A L)) := by rw [hyc]; exact hx
    exact h1
  have hyR : y.comap κ = P.map (Ideal.Quotient.mk (RingHom.ker ρ)) := by
    symm
    apply hPRmax.eq_of_le (Ideal.comap_ne_top κ hy.ne_top)
    rw [Ideal.map_le_iff_le_comap, hPdef]
    apply sup_le
    · rw [Ideal.span_le]
      intro z hz
      rcases hz with rfl | hz
      · show κ (Ideal.Quotient.mk _ (π
          (MvPolynomial.X 0 - MvPolynomial.C U₁))) ∈ y
        have e1 : κ (Ideal.Quotient.mk (RingHom.ker ρ) (π
            (MvPolynomial.X 0 - MvPolynomial.C U₁))) =
            algebraMap A ↥(integralClosure A L) eA * ⟨_, hzint⟩ := by
          apply Subtype.ext
          show ρ.kerLift _ = algebraMap A L eA * (algebraMap A L U₂ * algebraMap A L t ^ M * w)
          rw [RingHom.kerLift_mk, map_sub, map_sub, hρ0, hρC, hx]
          ring
        rw [e1]
        exact y.mul_mem_right _ (h𝔭Y _ he𝔭)
      · rw [Set.mem_singleton_iff] at hz
        subst hz
        show κ (Ideal.Quotient.mk _ (π (MvPolynomial.X 1))) ∈ y
        apply hy.mem_of_pow_mem ℓ
        have e1 : κ (Ideal.Quotient.mk (RingHom.ker ρ) (π
            (MvPolynomial.X 1))) ^ ℓ =
            κ (Ideal.Quotient.mk (RingHom.ker ρ) (π
              (MvPolynomial.C (U₂ ^ (a * (ℓ - 1)))))) *
            algebraMap A ↥(integralClosure A L) t *
            κ (Ideal.Quotient.mk (RingHom.ker ρ) (π (MvPolynomial.X 0))) ^ a := by
          have h1 := congrArg (fun z => κ (Ideal.Quotient.mk (RingHom.ker ρ) z)) hF1E
          rw [← hκC t]
          simp only [map_pow, map_mul] at h1 ⊢
          linear_combination h1
        rw [e1]
        exact y.mul_mem_right _ (y.mul_mem_left _ (h𝔭Y t ht))
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      show κ (Ideal.Quotient.mk _ (π (MvPolynomial.C x))) ∈ y
      rw [hκC]
      exact h𝔭Y x hx

  obtain ⟨e₁⟩ := wcLlsKP_ed_fs_transport Ω W A L _ κ
    (P.map (Ideal.Quotient.mk (RingHom.ker ρ))) y hκinj (fun x => ⟨_, hκC x⟩)
    (fun w' => by
      rw [IsScalarTower.algebraMap_apply ↥W E (E ⧸ RingHom.ker ρ), Ideal.Quotient.algebraMap_eq,
        hπW]
      exact hκC _) hof hRdom hRnorm hyR
  have hmeq : ((IsLocalRing.maximalIdeal ↥W).map
      (algebraMap ↥W E)).map (algebraMap _ (Localization.AtPrime P)) =
      (((IsLocalRing.maximalIdeal ↥W).map
        (algebraMap ↥W (E ⧸ RingHom.ker ρ))).map
        (algebraMap _ (Localization.AtPrime (P.map (Ideal.Quotient.mk (RingHom.ker ρ)))))).map
        (Θ : Localization.AtPrime (P.map (Ideal.Quotient.mk (RingHom.ker ρ))) →+*
          Localization.AtPrime P) := by
    simp only [Ideal.map_map]
    congr 1
    ext w'
    exact (hΘ (algebraMap ↥W _ w')).symm
  have eFS := e₁.trans (Ideal.quotientEquiv _ _ Θ hmeq)
  haveI := hDVR
  haveI : IsDomain (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) :=
    MulEquiv.isDomain _ eFS.toMulEquiv
  haveI : IsIntegrallyClosed (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) :=
    IsIntegrallyClosed.of_equiv eFS.symm
  exact s11 _

theorem wcLlsASr_chart_delta : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → Module.finrank K L = ℓ → ∀ c r₀ μ : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → r₀ ∈ IsLocalRing.maximalIdeal ↥W → r₀ ≠ 0 → μ ∈ IsLocalRing.maximalIdeal ↥W → ∀ M : ℕ, 0 < M → ¬ ℓ ∣ M → ∀ (w : L) (V₁ V₂ V₁' V₂' : ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀})), w ∉ Set.range (algebraMap K L) → V₁ * V₁' - 1 ∈ wcLlsScN W A K t c r₀ → V₂ * V₂' - 1 ∈ wcLlsScN W A K t c r₀ → algebraMap K L ((V₂ : K) * wcLlsScS W A K t c r₀ ^ M) * (w ^ ℓ - algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) ^ (ℓ - 1) * w) = algebraMap K L (V₁ : K) → ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) L)) [Q.IsPrime], Q.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) L)) = wcLlsScN W A K t c r₀ → wcpaDjLkDelta (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) Q) = 0 :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD hdeg c r₀ μ hc hr₀m hr₀0
    hμm M hM hℓM w V₁ V₂ V₁' V₂' hw hV₁ hV₂ heq Q _ hQc
  classical

  obtain ⟨A'', _, _, _, _, _, _, _, t', 𝔭'', hBr, ht', hPD'', -⟩ :=
    wcpa_dj_llsm_br_residue_chart Ω W hW hWt A K L 𝔭 t c r₀ hPD hc hr₀m hr₀0

  have s2 : ∀ (R : Subalgebra A K) (P : Ideal ↥R) [P.IsPrime],
      (∀ a : A'', ∃ p q : ↥R, q ∉ P ∧ algebraMap A'' K a * (q : K) = (p : K)) →
      ∀ x : L, _root_.IsIntegral A'' x →
        ∃ q : ↥R, q ∉ P ∧ _root_.IsIntegral ↥R (algebraMap K L (q : K) * x) := by
    intro R P _ hden x hx
    obtain ⟨f, hfm, hfx⟩ := hx
    have hcommon : ∀ s : Finset ℕ, ∃ q : ↥R, q ∉ P ∧ ∀ i ∈ s, ∃ p : ↥R,
        algebraMap A'' K (f.coeff i) * (q : K) = (p : K) := by
      intro s
      induction s using Finset.induction_on with
      | empty =>
        exact ⟨1, fun h => (‹P.IsPrime›).ne_top ((Ideal.eq_top_iff_one P).mpr h),
          fun i hi => absurd hi (Finset.notMem_empty i)⟩
      | insert j s hj ih =>
        obtain ⟨q, hq, hqs⟩ := ih
        obtain ⟨pj, qj, hqj, hpj⟩ := hden (f.coeff j)
        refine ⟨q * qj, fun h => ?_, ?_⟩
        · rcases (‹P.IsPrime›).mem_or_mem h with h1 | h1
          · exact hq h1
          · exact hqj h1
        · intro i hi
          rcases Finset.mem_insert.mp hi with rfl | hi
          · refine ⟨pj * q, ?_⟩
            rw [Subalgebra.coe_mul, Subalgebra.coe_mul, ← hpj]; ring
          · obtain ⟨p, hp⟩ := hqs i hi
            refine ⟨p * qj, ?_⟩
            rw [Subalgebra.coe_mul, Subalgebra.coe_mul, ← hp]; ring
    obtain ⟨q, hq, hqc⟩ := hcommon (Finset.range (f.natDegree + 1))
    set F : Polynomial K := f.map (algebraMap A'' K) with hF
    have hFm : F.Monic := hfm.map _
    have hFdeg : F.natDegree = f.natDegree := hfm.natDegree_map _
    have hFx : Polynomial.eval₂ (algebraMap K L) x F = 0 := by
      rw [hF, Polynomial.eval₂_map, ← IsScalarTower.algebraMap_eq]; exact hfx
    set G := F.scaleRoots (q : K) with hG
    have hGm : G.Monic := by rw [hG, Polynomial.monic_scaleRoots_iff]; exact hFm
    have hGx : Polynomial.eval₂ (algebraMap K L) (algebraMap K L (q : K) * x) G = 0 :=
      Polynomial.scaleRoots_eval₂_eq_zero (algebraMap K L) hFx
    have hGl : G ∈ Polynomial.lifts (algebraMap ↥R K) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [hG, Polynomial.coeff_scaleRoots, hFdeg, hF, Polynomial.coeff_map]
      by_cases hi : i < f.natDegree
      · obtain ⟨p, hp⟩ := hqc i (Finset.mem_range.mpr (by omega))
        refine ⟨p * q ^ (f.natDegree - i - 1), ?_⟩
        have he : f.natDegree - i = (f.natDegree - i - 1) + 1 := by omega
        rw [he, pow_succ]
        show ((p * q ^ (f.natDegree - i - 1) : ↥R) : K) = _
        rw [Subalgebra.coe_mul, SubmonoidClass.coe_pow, ← hp]; ring
      · have he : f.natDegree - i = 0 := by omega
        rw [he, pow_zero, mul_one]
        rcases Nat.lt_or_ge f.natDegree i with h | h
        · refine ⟨0, ?_⟩
          rw [Polynomial.coeff_eq_zero_of_natDegree_lt h, map_zero, map_zero]
        · have hi' : i = f.natDegree := by omega
          refine ⟨1, ?_⟩
          rw [hi', ← Polynomial.leadingCoeff, hfm.leadingCoeff, map_one, map_one]
    obtain ⟨G', hG'map, -, hG'm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hGl hGm
    refine ⟨q, hq, G', hG'm, ?_⟩
    have halg : algebraMap ↥R L = (algebraMap K L).comp (algebraMap ↥R K) :=
      RingHom.ext fun r => rfl
    rw [halg, ← Polynomial.eval₂_map, hG'map]
    exact hGx

  have s45 : ∀ (B B'' : Type u) [CommRing B] [CommRing B''] (i : B →+* B'') (Q : Ideal B)
      [Q.IsPrime], Function.Injective i → (∀ x : B'', ∃ u b : B, u ∉ Q ∧ i u * x = i b) →
      ∃ y'' : Ideal B'', y''.IsPrime ∧ y''.comap i = Q ∧
        (∀ y3 : Ideal B'', y3.IsPrime → y3.comap i = Q → y3 = y'') ∧
        ∀ (_ : y''.IsPrime), ∃ Θ : Localization.AtPrime y'' ≃+* Localization.AtPrime Q,
          ∀ b : B, Θ (algebraMap B'' (Localization.AtPrime y'') (i b)) =
            algebraMap B (Localization.AtPrime Q) b := by
    intro B B'' _ _ i Q _ hi hden
    choose u b hu hub using hden
    have spec : ∀ (x : B'') (b' : B) (s : Q.primeCompl), i s * x = i b' →
        IsLocalization.mk' (Localization.AtPrime Q) (b x) (⟨u x, hu x⟩ : Q.primeCompl) =
          IsLocalization.mk' (Localization.AtPrime Q) b' s := by
      intro x b' s h
      rw [IsLocalization.mk'_eq_iff_eq]
      congr 1
      apply hi
      show i ((s : B) * b x) = i (u x * b')
      rw [map_mul, map_mul, ← hub x, ← h]; ring
    obtain ⟨θ, hθdef⟩ : ∃ θ : B'' →+* Localization.AtPrime Q, ∀ x, θ x =
        IsLocalization.mk' (Localization.AtPrime Q) (b x) (⟨u x, hu x⟩ : Q.primeCompl) :=
      ⟨{ toFun := fun x =>
            IsLocalization.mk' (Localization.AtPrime Q) (b x) (⟨u x, hu x⟩ : Q.primeCompl)
         map_one' := (spec 1 1 1 (by simp)).trans (by rw [IsLocalization.mk'_one, map_one])
         map_mul' := fun x y => (spec (x * y) (b x * b y) (⟨u x, hu x⟩ * ⟨u y, hu y⟩) (by
            show i (u x * u y) * (x * y) = i (b x * b y)
            rw [map_mul, map_mul, ← hub x, ← hub y]; ring)).trans
            (IsLocalization.mk'_mul _ _ _ _ _)
         map_zero' := (spec 0 0 1 (by simp)).trans (IsLocalization.mk'_zero _)
         map_add' := fun x y => (spec (x + y) (b x * u y + b y * u x)
            (⟨u x, hu x⟩ * ⟨u y, hu y⟩) (by
            show i (u x * u y) * (x + y) = i (b x * u y + b y * u x)
            rw [map_mul, map_add, map_mul, map_mul, ← hub x, ← hub y]; ring)).trans
            (IsLocalization.mk'_add (S := Localization.AtPrime Q) (b x) (b y)
              ⟨u x, hu x⟩ ⟨u y, hu y⟩) }, fun _ => rfl⟩
    have hθi : ∀ b0 : B, θ (i b0) = algebraMap B _ b0 := fun b0 => by
      rw [hθdef]; exact (spec (i b0) b0 1 (by simp)).trans (IsLocalization.mk'_one _ _)
    have hθx : ∀ (x : B'') (u' b' : B), i u' * x = i b' →
        algebraMap B (Localization.AtPrime Q) u' * θ x = algebraMap B _ b' := by
      intro x u' b' h
      rw [← hθi, ← hθi, ← map_mul, h]
    have hmax : ∀ c : B, algebraMap B (Localization.AtPrime Q) c ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime Q) ↔ c ∈ Q := fun c =>
      IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q) Q c
    have KF : ∀ x : B'', ∀ u' b' : B, u' ∉ Q → i u' * x = i b' →
        (θ x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime Q) ↔ b' ∈ Q) := by
      intro x u' b' hu' h
      rw [← hmax b', ← hθx x u' b' h]
      constructor
      · intro hx; exact Ideal.mul_mem_left _ _ hx
      · intro hx
        rcases (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime Q)).isPrime.mem_or_mem
          hx with h1 | h1
        · exact absurd ((hmax u').mp h1) hu'
        · exact h1
    have hyc : ((IsLocalRing.maximalIdeal (Localization.AtPrime Q)).comap θ).comap i = Q := by
      ext c; rw [Ideal.mem_comap, Ideal.mem_comap, hθi, hmax]
    refine ⟨(IsLocalRing.maximalIdeal (Localization.AtPrime Q)).comap θ, Ideal.comap_isPrime _ _,
      hyc, ?_, ?_⟩
    · intro y3 hy3 hy3c
      ext x
      rw [Ideal.mem_comap, KF x (u x) (b x) (hu x) (hub x)]
      have hiu : i (u x) ∉ y3 := fun h' => hu x (by rw [← hy3c]; exact h')
      constructor
      · intro hx
        have : i (b x) ∈ y3 := by rw [← hub x]; exact Ideal.mul_mem_left _ _ hx
        rw [← hy3c]; exact this
      · intro hb
        have : i (u x) * x ∈ y3 := by rw [hub x]; rw [← hy3c] at hb; exact hb
        exact (hy3.mem_or_mem this).resolve_left hiu
    · intro hp
      generalize hY : (IsLocalRing.maximalIdeal (Localization.AtPrime Q)).comap θ = Y at hp hyc
      have hunit : ∀ z : Y.primeCompl, IsUnit (θ z) := by
        intro z
        apply (IsLocalRing.notMem_maximalIdeal).mp
        intro h
        apply z.2
        have h' : (z : B'') ∈ (IsLocalRing.maximalIdeal (Localization.AtPrime Q)).comap θ := h
        rw [hY] at h'
        exact h'
      have hunit2 : ∀ s : Q.primeCompl,
          IsUnit (((algebraMap B'' (Localization.AtPrime Y)).comp i) s) := by
        intro s
        have : i s ∈ Y.primeCompl := by
          show i s ∉ Y
          intro h
          apply s.2
          have h' : (s : B) ∈ Y.comap i := h
          rw [hyc] at h'
          exact h'
        exact IsLocalization.map_units (Localization.AtPrime Y) (⟨i s, this⟩ : Y.primeCompl)
      obtain ⟨Θ, hΘ⟩ : ∃ Θ : Localization.AtPrime Y →+* Localization.AtPrime Q,
          ∀ x : B'', Θ (algebraMap B'' _ x) = θ x :=
        ⟨IsLocalization.lift hunit, fun x => IsLocalization.lift_eq hunit x⟩
      obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : Localization.AtPrime Q →+* Localization.AtPrime Y,
          ∀ c : B, Ψ (algebraMap B _ c) = algebraMap B'' _ (i c) :=
        ⟨IsLocalization.lift hunit2, fun c => IsLocalization.lift_eq hunit2 c⟩
      have h1 : Θ.comp Ψ = RingHom.id _ := by
        apply IsLocalization.ringHom_ext Q.primeCompl
        ext c
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hΨ, hΘ, hθi]
      have h2 : Ψ.comp Θ = RingHom.id _ := by
        apply IsLocalization.ringHom_ext Y.primeCompl
        ext x
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hΘ]
        have hU : IsUnit (algebraMap B'' (Localization.AtPrime Y) (i (u x))) :=
          hunit2 ⟨u x, hu x⟩
        apply hU.mul_left_cancel
        calc algebraMap B'' _ (i (u x)) * Ψ (θ x)
            = Ψ (algebraMap B _ (u x)) * Ψ (θ x) := by rw [hΨ]
          _ = Ψ (algebraMap B _ (b x)) := by rw [← map_mul, hθx x (u x) (b x) (hub x)]
          _ = algebraMap B'' _ (i (b x)) := hΨ (b x)
          _ = algebraMap B'' _ (i (u x)) * algebraMap B'' _ x := by rw [← hub x, map_mul]
      refine ⟨RingEquiv.ofRingHom Θ Ψ h1 h2, fun c => ?_⟩
      show Θ _ = _
      rw [hΘ, hθi]

  have s9 : ∀ (B B'' : Type u) [CommRing B] [CommRing B''] (i : B →+* B'') (Q : Ideal B)
      [Q.IsPrime] (y'' : Ideal B'') [y''.IsPrime]
      (Θ : Localization.AtPrime y'' ≃+* Localization.AtPrime Q),
      (∀ b : B, Θ (algebraMap B'' (Localization.AtPrime y'') (i b)) =
        algebraMap B (Localization.AtPrime Q) b) →
      ∀ (S : Set B) (S'' : Set B''), S'' = i '' S →
      Nonempty ((Localization.AtPrime y'' ⧸
          (Ideal.span S'').map (algebraMap B'' (Localization.AtPrime y''))) ≃+*
        (Localization.AtPrime Q ⧸ (Ideal.span S).map (algebraMap B (Localization.AtPrime Q)))) := by
    intro B B'' _ _ i Q _ y'' _ Θ hΘ S S'' hS
    refine ⟨Ideal.quotientEquiv _ _ Θ ?_⟩
    simp only [Ideal.map_span, hS, Set.image_image]
    congr 1
    apply Set.image_congr
    intro c _
    exact (hΘ c).symm

  have hδ : ∀ (R0 S0 : Type u) [CommRing R0] [CommRing S0], (R0 ≃+* S0) →
      wcpaDjLkDelta R0 = wcpaDjLkDelta S0 := by
    intro R0 S0 _ _ e
    let eF : FractionRing R0 ≃+* FractionRing S0 := IsFractionRing.ringEquivOfRingEquiv e
    have H1 : ∀ r : R0, eF (algebraMap R0 (FractionRing R0) r) =
        algebraMap S0 (FractionRing S0) (e r) :=
      fun r => IsFractionRing.ringEquivOfRingEquiv_algebraMap e r
    have H2 : ∀ s : S0, eF.symm (algebraMap S0 (FractionRing S0) s) =
        algebraMap R0 (FractionRing R0) (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, H1, RingEquiv.apply_symm_apply]
    have C1 : (algebraMap S0 (FractionRing S0)).comp (e : R0 →+* S0) =
        (eF : FractionRing R0 →+* FractionRing S0).comp (algebraMap R0 (FractionRing R0)) := by
      ext r
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H1 r).symm
    have C2 : (algebraMap R0 (FractionRing R0)).comp (e.symm : S0 →+* R0) =
        (eF.symm : FractionRing S0 →+* FractionRing R0).comp (algebraMap S0 (FractionRing S0)) := by
      ext s
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H2 s).symm
    have I1 : ∀ x : FractionRing R0, _root_.IsIntegral R0 x → _root_.IsIntegral S0 (eF x) :=
      fun x hx => hx.map_of_comp_eq (e : R0 →+* S0) (eF : FractionRing R0 →+* FractionRing S0) C1
    have I2 : ∀ y : FractionRing S0, _root_.IsIntegral S0 y → _root_.IsIntegral R0 (eF.symm y) :=
      fun y hy => hy.map_of_comp_eq (e.symm : S0 →+* R0)
        (eF.symm : FractionRing S0 →+* FractionRing R0) C2
    let eI : ↥(integralClosure R0 (FractionRing R0)) ≃+* ↥(integralClosure S0 (FractionRing S0)) :=
      { toFun := fun x => ⟨eF x, I1 x x.2⟩
        invFun := fun y => ⟨eF.symm y, I2 y y.2⟩
        left_inv := fun x => Subtype.ext (eF.symm_apply_apply x)
        right_inv := fun y => Subtype.ext (eF.apply_symm_apply y)
        map_mul' := fun x y => Subtype.ext (map_mul eF (x : FractionRing R0) y)
        map_add' := fun x y => Subtype.ext (map_add eF (x : FractionRing R0) y) }
    have heI : ∀ r : R0, eI (algebraMap R0 _ r) = algebraMap S0 _ (e r) :=
      fun r => Subtype.ext (H1 r)
    have heI' : ∀ s : S0, eI.symm (algebraMap S0 _ s) = algebraMap R0 _ (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, heI, RingEquiv.apply_symm_apply]
    letI : RingHomInvPair (e : R0 →+* S0) (e.symm : S0 →+* R0) := RingHomInvPair.of_ringEquiv e
    letI : RingHomInvPair (e.symm : S0 →+* R0) (e : R0 →+* S0) := RingHomInvPair.symm _ _
    let LeI : ↥(integralClosure R0 (FractionRing R0)) →ₛₗ[(e : R0 →+* S0)]
        ↥(integralClosure S0 (FractionRing S0)) :=
      { toFun := eI
        map_add' := map_add eI
        map_smul' := fun r a => by
          rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI]
          rfl }
    let LeI' : ↥(integralClosure S0 (FractionRing S0)) →ₛₗ[(e.symm : S0 →+* R0)]
        ↥(integralClosure R0 (FractionRing R0)) :=
      { toFun := eI.symm
        map_add' := map_add eI.symm
        map_smul' := fun s b => by
          rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI']
          rfl }
    let p := LinearMap.range (Algebra.linearMap R0 ↥(integralClosure R0 (FractionRing R0)))
    let q := LinearMap.range (Algebra.linearMap S0 ↥(integralClosure S0 (FractionRing S0)))
    have h1 : p ≤ q.comap LeI := by
      rintro _ ⟨r, rfl⟩
      exact ⟨e r, (heI r).symm⟩
    have h2 : q ≤ p.comap LeI' := by
      rintro _ ⟨s, rfl⟩
      exact ⟨e.symm s, (heI' s).symm⟩
    let Φ := p.mapQ q LeI h1
    let Φ' := q.mapQ p LeI' h2
    let Φe : (↥(integralClosure R0 (FractionRing R0)) ⧸ p) ≃ₛₗ[(e : R0 →+* S0)]
        (↥(integralClosure S0 (FractionRing S0)) ⧸ q) :=
      { Φ with
        invFun := Φ'
        left_inv := fun x => by
          induction x using Submodule.Quotient.induction_on with
          | H a =>
            show Φ' (Φ (Submodule.Quotient.mk a)) = Submodule.Quotient.mk a
            rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
            exact congrArg _ (eI.symm_apply_apply a)
        right_inv := fun x => by
          induction x using Submodule.Quotient.induction_on with
          | H b =>
            show Φ (Φ' (Submodule.Quotient.mk b)) = Submodule.Quotient.mk b
            rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
            exact congrArg _ (eI.apply_symm_apply b) }
    let O := Submodule.orderIsoMapComap Φe
    unfold wcpaDjLkDelta
    rw [Module.length_eq_height, Module.length_eq_height, ← Order.height_orderIso O ⊤,
      OrderIso.map_top]

  have hSub : wcLlsBrSub W A K A'' (wcLlsScS W A K t c r₀) {wcLlsScS W A K t c r₀} := hBr
  have ht'' : algebraMap A'' K t' = wcLlsScS W A K t c r₀ := ht'
  clear hBr ht'
  revert V₁ V₂ V₁' V₂' Q
  set s := wcLlsScS W A K t c r₀ with hs
  intro V₁ V₂ V₁' V₂' hV₁ hV₂ heq Q _ hQc
  obtain ⟨hB1, hB2, hB3⟩ := hSub
  have hPD2 := hPD''
  obtain ⟨-, -, -, hmax'', -, -, h𝔭eq, -⟩ := hPD2
  have hinj'' : Function.Injective (algebraMap A'' K) := IsFractionRing.injective A'' K

  have hκex : ∀ r : ↥(Algebra.adjoin A {s}), ∃ a : A'', algebraMap A'' K a = (r : K) :=
    fun r => hB2 r.2
  choose κf hκf using hκex
  let κ : ↥(Algebra.adjoin A {s}) →+* A'' :=
    { toFun := κf
      map_one' := hinj'' (by rw [hκf, map_one, OneMemClass.coe_one])
      map_mul' := fun x y => hinj'' (by rw [hκf, map_mul, hκf, hκf, Subalgebra.coe_mul])
      map_zero' := hinj'' (by rw [hκf, map_zero, ZeroMemClass.coe_zero])
      map_add' := fun x y => hinj'' (by rw [hκf, map_add, hκf, hκf, Subalgebra.coe_add]) }
  have hκ : ∀ r, algebraMap A'' K (κ r) = (r : K) := hκf

  have hcomp : (algebraMap A'' L).comp κ =
      (RingHom.id L).comp (algebraMap ↥(Algebra.adjoin A {s}) L) := by
    ext r
    simp only [RingHom.comp_apply, RingHom.id_apply]
    rw [IsScalarTower.algebraMap_apply A'' K L, hκ]
    rfl
  have hBB : ∀ x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L),
      (x : L) ∈ integralClosure A'' L := fun x =>
    (mem_integralClosure_iff _ _).mpr
      (((mem_integralClosure_iff _ _).mp x.2).map_of_comp_eq κ (RingHom.id L) hcomp)
  let i : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) →+* ↥(integralClosure A'' L) :=
    ((integralClosure ↥(Algebra.adjoin A {s}) L).val.toRingHom).codRestrict
      (integralClosure A'' L) hBB
  have hi_inj : Function.Injective i := fun x y h =>
    Subtype.ext (show (x : L) = (y : L) from
      congrArg (fun z : ↥(integralClosure A'' L) => (z : L)) h)

  have hNN : wcLlsScN W A K t c r₀ ≤ Ideal.span (Subtype.val ⁻¹'
      ({s} ∪ (fun w => algebraMap A K (algebraMap ↥W A w)) ''
        ↑(IsLocalRing.maximalIdeal ↥W))) := by
    apply sup_le
    · rw [Ideal.span_le]
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact Ideal.subset_span (Or.inl rfl)
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap]
      apply Ideal.subset_span
      exact Or.inr ⟨w, hw, rfl⟩
  have hden : ∀ a : A'', ∃ p q : ↥(Algebra.adjoin A {s}), q ∉ wcLlsScN W A K t c r₀ ∧
      algebraMap A'' K a * (q : K) = (p : K) := by
    intro a
    obtain ⟨p, q, hq, hpq⟩ := hB3 (algebraMap A'' K a) ⟨a, rfl⟩
    exact ⟨p, q, fun h => hq (hNN h), hpq⟩
  haveI hNprime : (wcLlsScN W A K t c r₀).IsPrime := by
    rw [← hQc]; exact Ideal.comap_isPrime _ _
  have hdenB : ∀ x : ↥(integralClosure A'' L), ∃ u b : ↥(integralClosure ↥(Algebra.adjoin A {s}) L),
      u ∉ Q ∧ i u * x = i b := by
    intro x
    obtain ⟨q, hqN, hqI⟩ := s2 (Algebra.adjoin A {s}) (wcLlsScN W A K t c r₀) hden (x : L)
      ((mem_integralClosure_iff _ _).mp x.2)
    refine ⟨algebraMap ↥(Algebra.adjoin A {s}) _ q,
      ⟨algebraMap K L (q : K) * x, (mem_integralClosure_iff _ _).mpr hqI⟩, ?_, ?_⟩
    · intro h; apply hqN; rw [← hQc]; exact h
    · apply Subtype.ext; rfl

  obtain ⟨y'', hy''p, hy''c, -, hΘ⟩ := s45 _ _ i Q hi_inj hdenB

  have hkey : ∀ (a : A'') (r : ↥(Algebra.adjoin A {s})), algebraMap A'' K a = (r : K) →
      algebraMap A'' ↥(integralClosure A'' L) a =
        i (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L) r) := by
    intro a r h
    apply Subtype.ext
    show algebraMap A'' L a = algebraMap K L (r : K)
    rw [IsScalarTower.algebraMap_apply A'' K L, h]
  have hmemQ : ∀ (y3 : Ideal ↥(integralClosure A'' L)), y3.comap i = Q →
      ∀ r : ↥(Algebra.adjoin A {s}),
        i (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L) r) ∈ y3 ↔
          r ∈ wcLlsScN W A K t c r₀ := by
    intro y3 h r
    rw [← hQc, Ideal.mem_comap, ← h, Ideal.mem_comap]
  have hsN : (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s}))
      ∈ wcLlsScN W A K t c r₀ :=
    Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton _))
  have hwN : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w) ∈ wcLlsScN W A K t c r₀ :=
    fun w hw => Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)

  have hle : ∀ y3 : Ideal ↥(integralClosure A'' L), y3.comap i = Q →
      𝔭'' ≤ y3.comap (algebraMap A'' _) := by
    intro y3 h3
    rw [h𝔭eq]
    apply sup_le
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      show algebraMap A'' _ t' ∈ y3
      rw [hkey t' ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ ht'']
      exact (hmemQ y3 h3 _).mpr hsN
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap]
      rw [hkey _ (algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w)) (hB1 w)]
      exact (hmemQ y3 h3 _).mpr (hwN w hw)
  have hcon : y''.comap (algebraMap A'' _) = 𝔭'' := by
    haveI := hy''p
    exact (hmax''.eq_of_le (Ideal.IsPrime.ne_top (Ideal.comap_isPrime _ _)) (hle y'' hy''c)).symm

  have hκN : ∀ r ∈ wcLlsScN W A K t c r₀, κ r ∈ 𝔭'' := by
    intro r hr
    rw [← hcon, Ideal.mem_comap, hkey (κ r) r (hκ r)]
    exact (hmemQ y'' hy''c r).mpr hr
  have hunitκ : ∀ V V' : ↥(Algebra.adjoin A {s}), V * V' - 1 ∈ wcLlsScN W A K t c r₀ →
      κ V ∉ 𝔭'' := by
    intro V V' hVV hV
    apply hmax''.ne_top
    rw [Ideal.eq_top_iff_one]
    have h1 := hκN _ hVV
    rw [map_sub, map_mul, map_one] at h1
    have h2 : κ V * κ V' ∈ 𝔭'' := Ideal.mul_mem_right _ _ hV
    have h3 := Ideal.sub_mem _ h2 h1
    rwa [sub_sub_cancel] at h3
  have heq'' : algebraMap A'' L (κ V₂) * algebraMap A'' L t' ^ M *
      (w ^ ℓ - algebraMap A'' L (algebraMap ↥W A'' μ) ^ (ℓ - 1) * w) =
      algebraMap A'' L (κ V₁) := by
    have e1 : ∀ x : A'', algebraMap A'' L x = algebraMap K L (algebraMap A'' K x) :=
      fun x => IsScalarTower.algebraMap_apply A'' K L x
    rw [e1 (κ V₂), e1 t', e1 (algebraMap ↥W A'' μ), e1 (κ V₁), hκ, hκ, ht'', hB1, ← heq,
      map_mul, map_pow]

  have hcrux := wcLlsASr_cd_pd_delta Ω W hW hWt ℓ hℓ hchar A'' K L 𝔭'' t' hPD'' hdeg μ hμm M hM
    hℓM w (κ V₁) (κ V₂) hw (hunitκ V₁ V₁' hV₁) (hunitκ V₂ V₂' hV₂) heq'' y'' hy''p hcon

  have hwL : ∀ w : ↥W, ((algebraMap A'' L).comp (algebraMap ↥W A'')) w =
      ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w := by
    intro w
    simp only [RingHom.comp_apply]
    rw [IsScalarTower.algebraMap_apply A'' K L, hB1 w]
  have hS : {b : ↥(integralClosure A'' L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap A'' L).comp (algebraMap ↥W A'')) w} =
      i '' {b : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} := by
    ext g
    constructor
    · rintro ⟨w, hw, hg⟩
      refine ⟨algebraMap ↥(Algebra.adjoin A {s}) _
        (algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w)), ⟨w, hw, rfl⟩, ?_⟩
      apply Subtype.ext
      show _ = (g : L)
      rw [hg, hwL]
      rfl
    · rintro ⟨b, ⟨w, hw, hb⟩, rfl⟩
      exact ⟨w, hw, by rw [hwL]; exact hb⟩
  obtain ⟨Θ, hΘc⟩ := hΘ hy''p
  obtain ⟨e⟩ := s9 _ _ i Q y'' Θ hΘc _ _ hS
  exact (hδ _ _ e).symm.trans hcrux

theorem wcLlsAS_dsb_small_disc_ram : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y →
    wcLlsBR W A K L 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ α : L, α ∉ Set.range (algebraMap K L) → α ^ ℓ - α ∈ Set.range (algebraMap K L) →
    ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W →
    (∃ Q, wcLlsGenPt W A L 𝔭 Q ∧
      t - algebraMap ↥W A c ∈ Q.comap (algebraMap A ↥(integralClosure A L)) ∧
      wcLlsRam A K L Q) →
    ∃ r₀ : ↥W, r₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ r₀ ≠ 0 ∧
      ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) L)) [Q.IsPrime],
        Q.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) L)) =
          wcLlsScN W A K t c r₀ →
        wcpaDjLkDelta (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
          ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) Q) = 0 :=
by
  classical
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hSolv hUniq hBR
    hdeg α hα1 hα2 c hc hram
  obtain ⟨f₀, hf₀⟩ := hα2
  have hPD' := hPD
  obtain ⟨_, hNZ, _, hmax, _, _, h𝔭eq, _⟩ := hPD'
  haveI := hNZ

  obtain ⟨η, M, G₁, G₂, hM, hℓM, hG₁, hG₂, hrel⟩ :=
    wcLlsASr_pole_normal_form Ω W hW hWt ℓ hℓ hchar A K L 𝔭 t hPD hdeg α f₀ hα1 hf₀ c hc hram
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h1 => hmax.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  have hG₁0 : G₁ ≠ 0 := fun h0 => hG₁ 0 1 h1𝔭 (by rw [h0]; ring)
  have hG₂0 : G₂ ≠ 0 := fun h0 => hG₂ 0 1 h1𝔭 (by rw [h0]; ring)

  have key : ∀ (G : A), (∀ x d : A, d ∉ 𝔭 → d * G ≠ (t - algebraMap ↥W A c) * x) →
      ∀ (r : ℕ) (cc : Fin r → ↥W) (n : Fin r → ℕ) (d : ↥W) (a s : A), s ∉ 𝔭 →
      s * G = algebraMap ↥W A d * a * ∏ i, (t - algebraMap ↥W A (cc i)) ^ (n i) →
      ∀ i, n i ≠ 0 → cc i ≠ c := by
    intro G hG r cc n d a s hs hfac i hn heq
    have hdvd : (t - algebraMap ↥W A c) ∣ ∏ j, (t - algebraMap ↥W A (cc j)) ^ (n j) := by
      rw [← heq]
      exact dvd_trans (dvd_pow_self _ hn)
        (Finset.dvd_prod_of_mem (fun j => (t - algebraMap ↥W A (cc j)) ^ (n j)) (Finset.mem_univ i))
    obtain ⟨x, hx⟩ := hdvd
    exact hG (algebraMap ↥W A d * a * x) s hs (by rw [hfac, hx]; ring)

  obtain ⟨r₁, c₁, n₁, d₁, a₁, s₁, -, -, hd₁, ha₁, hs₁, hfac₁⟩ :=
    wcpa_dj_llsm_kpd_disc_factorization Ω W hW hWt A 𝔭 t hPD G₁ hG₁0
  obtain ⟨r₂, c₂, n₂, d₂, a₂, s₂, -, -, hd₂, ha₂, hs₂, hfac₂⟩ :=
    wcpa_dj_llsm_kpd_disc_factorization Ω W hW hWt A 𝔭 t hPD G₂ hG₂0
  have hcc₁ := key G₁ hG₁ r₁ c₁ n₁ d₁ a₁ s₁ hs₁ hfac₁
  have hcc₂ := key G₂ hG₂ r₂ c₂ n₂ d₂ a₂ s₂ hs₂ hfac₂
  have hFne : ∀ (r : ℕ) (cc : Fin r → ↥W) (n : Fin r → ℕ), (∀ i, n i ≠ 0 → cc i ≠ c) →
      ∏ i, (c - cc i) ^ (n i) ≠ 0 := by
    intro r cc n hcc
    refine Finset.prod_ne_zero_iff.mpr (fun i _ => ?_)
    by_cases hn : n i = 0
    · rw [hn, pow_zero]; exact one_ne_zero
    · exact pow_ne_zero _ (sub_ne_zero.mpr (hcc i hn).symm)
  obtain ⟨F₁, hF₁⟩ : ∃ F : ↥W, F = ∏ i, (c - c₁ i) ^ (n₁ i) := ⟨_, rfl⟩
  obtain ⟨F₂, hF₂⟩ : ∃ F : ↥W, F = ∏ i, (c - c₂ i) ^ (n₂ i) := ⟨_, rfl⟩
  have hF₁0 : F₁ ≠ 0 := by rw [hF₁]; exact hFne r₁ c₁ n₁ hcc₁
  have hF₂0 : F₂ ≠ 0 := by rw [hF₂]; exact hFne r₂ c₂ n₂ hcc₂

  have hex : ∃ x : Ω, x ∉ W := by
    by_contra hne
    push_neg at hne
    exact hWt (top_unique fun x _ => hne x)
  obtain ⟨x, hx⟩ := hex
  have hx0 : x ≠ 0 := fun h0 => hx (h0 ▸ W.zero_mem)
  have hxi : x⁻¹ ∈ W := (W.mem_or_inv_mem x).resolve_left hx
  obtain ⟨ϖ, hϖ⟩ : ∃ ϖ : ↥W, (ϖ : Ω) = x⁻¹ := ⟨⟨x⁻¹, hxi⟩, rfl⟩
  have hϖ0 : ϖ ≠ 0 := by
    intro h0
    rw [h0] at hϖ
    exact inv_ne_zero hx0 hϖ.symm
  have hϖm : ϖ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    obtain ⟨v, hv⟩ := hu.exists_right_inv
    have h1 : (ϖ : Ω) * (v : Ω) = 1 := congrArg Subtype.val hv
    rw [hϖ, inv_mul_eq_one₀ hx0] at h1
    exact hx (by rw [h1]; exact v.2)

  obtain ⟨r₀, hr₀⟩ : ∃ r : ↥W, r = ϖ * (F₁ * F₂) * (d₁ * F₁) := ⟨_, rfl⟩
  have hr₀m : r₀ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [hr₀]; exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _ hϖm)
  have hr₀0 : r₀ ≠ 0 := by
    rw [hr₀]
    exact mul_ne_zero (mul_ne_zero hϖ0 (mul_ne_zero hF₁0 hF₂0)) (mul_ne_zero hd₁ hF₁0)
  have hF₁r : F₁ ∣ r₀ := ⟨ϖ * F₂ * (d₁ * F₁), by rw [hr₀]; ring⟩
  have hF₂r : F₂ ∣ r₀ := ⟨ϖ * F₁ * (d₁ * F₁), by rw [hr₀]; ring⟩
  obtain ⟨k, hk⟩ : ∃ k, M = k + 1 := ⟨M - 1, by omega⟩
  obtain ⟨ρ, hρ⟩ : ∃ ρ : ↥W,
      ρ = ϖ ^ (k + 1) * (F₁ * F₂) ^ (k + 1) * (d₁ * F₁) ^ k * (d₂ * F₂) := ⟨_, rfl⟩
  have hρm : ρ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [hρ]
    exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _
      (Ideal.pow_mem_of_mem _ hϖm _ (Nat.succ_pos k))))
  have hρ0 : ρ ≠ 0 := by
    rw [hρ]
    exact mul_ne_zero (mul_ne_zero (mul_ne_zero (pow_ne_zero _ hϖ0)
      (pow_ne_zero _ (mul_ne_zero hF₁0 hF₂0))) (pow_ne_zero _ (mul_ne_zero hd₁ hF₁0)))
      (mul_ne_zero hd₂ hF₂0)
  have hρΩ : (ρ : Ω) ≠ 0 := fun h0 => hρ0 (Subtype.ext h0)
  obtain ⟨μ₀, hμ₀⟩ := IsAlgClosed.exists_pow_nat_eq (ρ : Ω) hℓ.pos
  have hμ₀0 : μ₀ ≠ 0 := fun h0 => hρΩ (by rw [← hμ₀, h0, zero_pow hℓ.ne_zero])
  have hμW : μ₀ ∈ W := by
    rcases W.mem_or_inv_mem μ₀ with h0 | h0
    · exact h0
    · obtain ⟨j, hj⟩ : ∃ j, ℓ = j + 1 := ⟨ℓ - 1, by have := hℓ.pos; omega⟩
      have e : μ₀ = (ρ : Ω) * (μ₀⁻¹) ^ j := by
        rw [← hμ₀, hj, pow_succ, inv_pow, mul_comm (μ₀ ^ j) μ₀, mul_assoc,
          mul_inv_cancel₀ (pow_ne_zero _ hμ₀0), mul_one]
      rw [e]
      exact mul_mem ρ.2 (pow_mem h0 j)
  obtain ⟨μ, hμ⟩ : ∃ μ : ↥W, (μ : Ω) = μ₀ := ⟨⟨μ₀, hμW⟩, rfl⟩
  have hμℓ : μ ^ ℓ = ρ := Subtype.ext (by rw [SubmonoidClass.coe_pow, hμ]; exact hμ₀)
  have hμ0 : μ ≠ 0 := by
    intro h0
    rw [h0] at hμ
    exact hμ₀0 hμ.symm
  have hμm : μ ∈ IsLocalRing.maximalIdeal ↥W :=
    (IsLocalRing.maximalIdeal.isMaximal ↥W).isPrime.mem_of_pow_mem ℓ (by rw [hμℓ]; exact hρm)
  have hμid : μ ^ ℓ * (d₁ * F₁) = r₀ ^ M * (d₂ * F₂) := by
    rw [hμℓ, hk, hρ, hr₀]; ring

  have hWA : ∀ x : ↥W, x ≠ 0 → algebraMap ↥W A x ≠ 0 := by
    intro x hx h0
    rw [Algebra.algebraMap_eq_smul_one] at h0
    rcases smul_eq_zero.mp h0 with h' | h'
    · exact hx h'
    · exact one_ne_zero h'
  have hκ0 : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := fun x hx =>
    (map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr (hWA x hx)
  have hκr₀ := hκ0 r₀ hr₀0
  have hST : algebraMap A K (t - algebraMap ↥W A c) =
      algebraMap A K (algebraMap ↥W A r₀) * wcLlsScS W A K t c r₀ := by
    unfold wcLlsScS
    rw [mul_div_assoc', mul_div_cancel_left₀ _ hκr₀]
  have hST2 : algebraMap A K t - algebraMap A K (algebraMap ↥W A c) =
      algebraMap A K (algebraMap ↥W A r₀) * wcLlsScS W A K t c r₀ := by
    rw [← map_sub]; exact hST
  obtain ⟨Sb, hSb⟩ : ∃ Sb : ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}),
      (Sb : K) = wcLlsScS W A K t c r₀ :=
    ⟨⟨_, Algebra.subset_adjoin (Set.mem_singleton _)⟩, rfl⟩
  have hSN : Sb ∈ wcLlsScN W A K t c r₀ := by
    have e : Sb = ⟨wcLlsScS W A K t c r₀, Algebra.subset_adjoin (Set.mem_singleton _)⟩ :=
      Subtype.ext hSb
    rw [e]
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton _))
  have hmN : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) (algebraMap ↥W A w) ∈
        wcLlsScN W A K t c r₀ := fun w hw =>
    Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)
  have htB : algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) t =
      algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) (algebraMap ↥W A c) +
        algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) (algebraMap ↥W A r₀) * Sb := by
    apply Subtype.ext
    rw [AddMemClass.coe_add, MulMemClass.coe_mul, hSb]
    show algebraMap A K t = algebraMap A K (algebraMap ↥W A c) +
      algebraMap A K (algebraMap ↥W A r₀) * wcLlsScS W A K t c r₀
    linear_combination hST2
  have h𝔭N : ∀ a ∈ 𝔭, algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) a ∈
      wcLlsScN W A K t c r₀ := by
    have hle : 𝔭 ≤ (wcLlsScN W A K t c r₀).comap
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀})) := by
      rw [h𝔭eq]
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro z hz
        rw [Set.mem_singleton_iff.mp hz]
        show algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) t ∈ wcLlsScN W A K t c r₀
        rw [htB]
        exact Ideal.add_mem _ (hmN c hc) (Ideal.mul_mem_left _ _ hSN)
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        exact hmN w hw
    exact fun a ha => hle ha
  have unitA : ∀ a : A, a ∉ 𝔭 → IsUnit (Ideal.Quotient.mk (wcLlsScN W A K t c r₀)
      (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) a)) := by
    intro a ha
    obtain ⟨b, i, hi, hbi⟩ := hmax.exists_inv ha
    refine isUnit_iff_exists_inv.mpr ⟨Ideal.Quotient.mk (wcLlsScN W A K t c r₀)
      (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) b), ?_⟩
    have h0 : Ideal.Quotient.mk (wcLlsScN W A K t c r₀)
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) i) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (h𝔭N i hi)
    have e := congrArg (fun z => Ideal.Quotient.mk (wcLlsScN W A K t c r₀)
      (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) z)) hbi
    simp only [map_add, map_mul, map_one, h0, add_zero] at e
    rw [mul_comm]; exact e
  have invmod : ∀ V : ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}),
      IsUnit (Ideal.Quotient.mk (wcLlsScN W A K t c r₀) V) →
      ∃ V', V * V' - 1 ∈ wcLlsScN W A K t c r₀ := by
    intro V hV
    obtain ⟨u, hu⟩ := hV.exists_right_inv
    obtain ⟨V', rfl⟩ := Ideal.Quotient.mk_surjective u
    exact ⟨V', Ideal.Quotient.eq.mp (by rw [map_mul, map_one]; exact hu)⟩

  have plem : ∀ (r : ℕ) (cc : Fin r → ↥W) (n : Fin r → ℕ), (∀ i, n i ≠ 0 → cc i ≠ c) →
      (∏ i, (c - cc i) ^ (n i)) ∣ r₀ →
      ∃ Y : ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}),
        algebraMap A K (∏ i, (t - algebraMap ↥W A (cc i)) ^ (n i)) =
          algebraMap A K (algebraMap ↥W A (∏ i, (c - cc i) ^ (n i))) * (Y : K) ∧
        Ideal.Quotient.mk (wcLlsScN W A K t c r₀) Y = 1 := by
    intro r cc n hcc hdvd
    have hy : ∀ i, ∃ yv : ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}),
        algebraMap A K ((t - algebraMap ↥W A (cc i)) ^ (n i)) =
          algebraMap A K (algebraMap ↥W A ((c - cc i) ^ (n i))) * (yv : K) ∧
        Ideal.Quotient.mk (wcLlsScN W A K t c r₀) yv = 1 := by
      intro i
      by_cases hn : n i = 0
      · refine ⟨1, ?_, map_one _⟩
        simp [hn]
      · obtain ⟨e, he⟩ : (c - cc i) ∣ r₀ := dvd_trans (dvd_trans (dvd_pow_self _ hn)
          (Finset.dvd_prod_of_mem (fun j => (c - cc j) ^ (n j)) (Finset.mem_univ i))) hdvd
        refine ⟨(1 + algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀})
          (algebraMap ↥W A e) * Sb) ^ (n i), ?_, ?_⟩
        · have hcoe : (((1 + algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀})
              (algebraMap ↥W A e) * Sb) ^ (n i) : ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀})) :
              K) = (1 + algebraMap A K (algebraMap ↥W A e) * wcLlsScS W A K t c r₀) ^ (n i) := by
            rw [SubmonoidClass.coe_pow, AddMemClass.coe_add, MulMemClass.coe_mul, hSb]; rfl
          have hlin : algebraMap A K (t - algebraMap ↥W A (cc i)) =
              algebraMap A K (algebraMap ↥W A (c - cc i)) *
                (1 + algebraMap A K (algebraMap ↥W A e) * wcLlsScS W A K t c r₀) := by
            have he' := congrArg (fun z => algebraMap A K (algebraMap ↥W A z)) he
            simp only [map_mul, map_sub] at he' ⊢
            linear_combination hST2 + wcLlsScS W A K t c r₀ * he'
          rw [hcoe]
          simp only [map_pow]
          rw [hlin, mul_pow]
        · rw [map_pow, map_add, map_mul, Ideal.Quotient.eq_zero_iff_mem.mpr hSN, mul_zero,
            add_zero, map_one, one_pow]
    choose yv hyv1 hyv2 using hy
    refine ⟨∏ i, yv i, ?_, ?_⟩
    · simp only [map_prod]
      rw [SubmonoidClass.coe_finset_prod, ← Finset.prod_mul_distrib]
      exact Finset.prod_congr rfl (fun i _ => hyv1 i)
    · rw [map_prod]
      exact Finset.prod_eq_one (fun i _ => hyv2 i)
  obtain ⟨Y₁, hY₁, hY₁N⟩ := plem r₁ c₁ n₁ hcc₁ (by rw [← hF₁]; exact hF₁r)
  obtain ⟨Y₂, hY₂, hY₂N⟩ := plem r₂ c₂ n₂ hcc₂ (by rw [← hF₂]; exact hF₂r)
  rw [← hF₁] at hY₁
  rw [← hF₂] at hY₂
  have h2a : algebraMap A K s₁ * algebraMap A K G₁ = algebraMap A K (algebraMap ↥W A d₁) *
      algebraMap A K a₁ * (algebraMap A K (algebraMap ↥W A F₁) * (Y₁ : K)) := by
    have e := congrArg (algebraMap A K) hfac₁
    rw [map_mul, map_mul, map_mul, hY₁] at e
    exact e
  have h2b : algebraMap A K s₂ * algebraMap A K G₂ = algebraMap A K (algebraMap ↥W A d₂) *
      algebraMap A K a₂ * (algebraMap A K (algebraMap ↥W A F₂) * (Y₂ : K)) := by
    have e := congrArg (algebraMap A K) hfac₂
    rw [map_mul, map_mul, map_mul, hY₂] at e
    exact e
  have h5 : algebraMap A K (algebraMap ↥W A μ) ^ ℓ * (algebraMap A K (algebraMap ↥W A d₁) *
      algebraMap A K (algebraMap ↥W A F₁)) = algebraMap A K (algebraMap ↥W A r₀) ^ M *
      (algebraMap A K (algebraMap ↥W A d₂) * algebraMap A K (algebraMap ↥W A F₂)) := by
    have e := congrArg (fun z => algebraMap A K (algebraMap ↥W A z)) hμid
    simp only [map_mul, map_pow] at e
    exact e
  have h1 : algebraMap A K G₂ * (algebraMap A K (algebraMap ↥W A r₀) *
      wcLlsScS W A K t c r₀) ^ M * (f₀ - (η ^ ℓ - η)) = algebraMap A K G₁ := by
    rw [← hST]; exact hrel
  have hD : algebraMap A K (algebraMap ↥W A d₁) * algebraMap A K (algebraMap ↥W A F₁) ≠ 0 :=
    mul_ne_zero (hκ0 _ hd₁) (hκ0 _ hF₁0)
  have hKid : (algebraMap A K s₁ * algebraMap A K a₂ * (Y₂ : K)) * wcLlsScS W A K t c r₀ ^ M *
      (algebraMap A K (algebraMap ↥W A μ) ^ ℓ * (f₀ - (η ^ ℓ - η))) =
      algebraMap A K s₂ * algebraMap A K a₁ * (Y₁ : K) := by
    apply mul_left_cancel₀ hD
    linear_combination (algebraMap A K s₁ * algebraMap A K a₂ * (Y₂ : K) *
        wcLlsScS W A K t c r₀ ^ M * (f₀ - (η ^ ℓ - η))) * h5 +
      (algebraMap A K s₁ * algebraMap A K s₂) * h1 -
      (algebraMap A K s₁ * wcLlsScS W A K t c r₀ ^ M * algebraMap A K (algebraMap ↥W A r₀) ^ M *
        (f₀ - (η ^ ℓ - η))) * h2b +
      algebraMap A K s₂ * h2a

  have hLℓ : ((ℓ : ℕ) : L) = 0 := by
    have e1 : ((ℓ : ℕ) : Ω) = 0 := by rw [← hchar]; exact ringChar.Nat.cast_ringChar
    have e2 : ((ℓ : ℕ) : ↥W) = 0 := Subtype.ext (by simpa using e1)
    have e3 := congrArg (fun z => algebraMap K L (algebraMap A K (algebraMap ↥W A z))) e2
    simpa using e3
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : CharP L ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hLℓ
  have hμK0 : algebraMap A K (algebraMap ↥W A μ) ≠ 0 := hκ0 μ hμ0
  have hmL0 : algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) ≠ 0 :=
    (map_ne_zero _).mpr hμK0
  obtain ⟨V₁', hV₁'⟩ := invmod (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) s₂ *
      algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) a₁ * Y₁)
    (by rw [map_mul, map_mul, hY₁N, mul_one]; exact (unitA s₂ hs₂).mul (unitA a₁ ha₁))
  obtain ⟨V₂', hV₂'⟩ := invmod (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) s₁ *
      algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) a₂ * Y₂)
    (by rw [map_mul, map_mul, hY₂N, mul_one]; exact (unitA s₁ hs₁).mul (unitA a₂ ha₂))
  have hw : algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L η) ∉
      Set.range (algebraMap K L) := by
    rintro ⟨z, hz⟩
    apply hα1
    refine ⟨z / algebraMap A K (algebraMap ↥W A μ) + η, ?_⟩
    rw [map_add, map_div₀, hz, mul_div_cancel_left₀ _ hmL0]
    ring
  obtain ⟨j, hj⟩ : ∃ j, ℓ = j + 1 := ⟨ℓ - 1, by have := hℓ.pos; omega⟩
  have hid : algebraMap K L (((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) s₁ *
        algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) a₂ * Y₂ :
        ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀})) : K) * wcLlsScS W A K t c r₀ ^ M) *
      ((algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L η)) ^ ℓ -
        algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) ^ (ℓ - 1) *
        (algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L η))) =
      algebraMap K L (((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) s₂ *
        algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) a₁ * Y₁ :
        ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}))) : K) := by
    have hw' : (algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L η)) ^ ℓ -
        algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) ^ (ℓ - 1) *
        (algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L η)) =
        algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) ^ ℓ *
          algebraMap K L (f₀ - (η ^ ℓ - η)) := by
      rw [mul_pow, sub_pow_char, map_sub, map_sub, map_pow, hf₀]
      rw [hj, Nat.add_sub_cancel]
      ring
    rw [hw']
    show algebraMap K L ((algebraMap A K s₁ * algebraMap A K a₂ * (Y₂ : K)) *
      wcLlsScS W A K t c r₀ ^ M) * _ =
      algebraMap K L (algebraMap A K s₂ * algebraMap A K a₁ * (Y₁ : K))
    rw [← hKid]
    simp only [map_mul, map_pow]

  refine ⟨r₀, hr₀m, hr₀0, ?_⟩
  intro Q _ hQ
  exact wcLlsASr_chart_delta Ω W hW hWt ℓ hℓ hchar A K L 𝔭 t hPD hdeg c r₀ μ hc hr₀m hr₀0 hμm
    M hM hℓM _ _ _ V₁' V₂' hw hV₁' hV₂' hid Q hQ

theorem wcLlsAS_disc_sep_bounded : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y →
    wcLlsBR W A K L 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ α : L, α ∉ Set.range (algebraMap K L) → α ^ ℓ - α ∈ Set.range (algebraMap K L) →
    ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W →
    ∃ b₀ : ↥W, b₀ ≠ 0 ∧ ∀ b' : ↥W, b' ∈ IsLocalRing.maximalIdeal ↥W → b' ≠ 0 →
      wcLlsDiscSep W A K L t c b' → b' ∣ b₀ :=
by
  classical
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hSolv hUniq hBR hdeg
    α hα1 hα2 c hc
  have hy : y.IsPrime := hSolv.1
  have hcomap : y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 := hSolv.2.1
  have hδ : wcpaDjLkDelta (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) ≠ 0 :=
    hSolv.2.2.2 hSolv.1 t rfl
  have hsmall : ∃ r₀ : ↥W, r₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ r₀ ≠ 0 ∧
      ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) L)) [Q.IsPrime],
        Q.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) L)) =
          wcLlsScN W A K t c r₀ →
        wcpaDjLkDelta (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
          ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) Q) = 0 := by
    by_cases hram : ∃ Q, wcLlsGenPt W A L 𝔭 Q ∧
        t - algebraMap ↥W A c ∈ Q.comap (algebraMap A ↥(integralClosure A L)) ∧
        wcLlsRam A K L Q
    · exact wcLlsAS_dsb_small_disc_ram Ω W hW hWt ℓ hℓ hchar A K L 𝔭 t y hPD hSolv hUniq hBR
        hdeg α hα1 hα2 c hc hram
    · exact wcLlsAS_dsb_small_disc_unram Ω W hW hWt ℓ hℓ hchar A K L 𝔭 t y hPD hSolv hUniq hBR
        hdeg α hα1 hα2 c hc hram
  obtain ⟨r₀, hr₀m, hr₀0, hr₀⟩ := hsmall
  refine ⟨r₀, hr₀0, ?_⟩
  intro b' hb' hb'0 hsep
  rcases ValuationRing.dvd_total b' r₀ with h | h
  · exact h
  · obtain ⟨q', hq'⟩ := h
    by_cases hq'm : q' ∈ IsLocalRing.maximalIdeal ↥W
    · exfalso
      obtain ⟨Q, hQ, hQc, hQu⟩ := wcpa_dj_llsm_sc_residue_uniq Ω W hW hWt A K L 𝔭 t y hPD hy
        hcomap hUniq c r₀ b' q' hc hr₀m hr₀0 hq'm hq' hb'0 hsep
      haveI := hQ
      have h0 := hr₀ Q hQc
      exact hδ (wcpa_dj_llsm_sc_disc_criterion Ω W hW hWt A K L 𝔭 t y hPD hy hcomap hUniq c r₀
        b' q' hc hr₀m hr₀0 hq'm hq' hb'0 hsep Q hQc hQu h0)
    · have hu : IsUnit q' := by
        by_contra hnu
        exact hq'm ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu))
      obtain ⟨u, hu⟩ := hu
      refine ⟨↑u⁻¹, ?_⟩
      rw [hq', ← hu, mul_assoc, Units.mul_inv, mul_one]

theorem wcLlsASdmc_cell_assembly : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (f₀ : K) (c β b : ↥W), c ∈ IsLocalRing.maximalIdeal ↥W →
    β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    β ∣ b → ¬ b ∣ β →
    ∀ (h : K) (κ₁ κ₂ : ↥W) (Z Y : List ↥W) (d ε : A), κ₁ ≠ 0 → κ₂ ≠ 0 → d ∉ 𝔭 → ε ∉ 𝔭 →
    (∀ z ∈ Z ++ Y, z ∈ IsLocalRing.maximalIdeal ↥W ∧
      ¬ ((β ∣ z - c ∧ ¬ (z - c) ∣ β) ∧ ((z - c) ∣ b ∧ ¬ b ∣ (z - c)))) →
    algebraMap A K d * algebraMap A K (algebraMap ↥W A κ₂) *
        (Y.map (fun y => algebraMap A K (t - algebraMap ↥W A y))).prod * (f₀ - (h ^ ℓ - h)) =
      algebraMap A K (algebraMap ↥W A κ₁) *
        (Z.map (fun z => algebraMap A K (t - algebraMap ↥W A z))).prod * algebraMap A K ε →
    (let PB : List ↥W → ↥W := fun X =>
        ((X.filter (fun x => @decide (¬ b ∣ x - c) (Classical.propDecidable _))).map (fun x => x - c)).prod *
          β ^ (X.filter (fun x => @decide (b ∣ x - c) (Classical.propDecidable _))).length
      let PR : List ↥W → ↥W := fun X =>
        ((X.filter (fun x => @decide (¬ b ∣ x - c) (Classical.propDecidable _))).map (fun x => x - c)).prod *
          b ^ (X.filter (fun x => @decide (b ∣ x - c) (Classical.propDecidable _))).length
      let m : ℤ := ((Z.filter (fun x => @decide (b ∣ x - c) (Classical.propDecidable _))).length : ℤ) -
        ((Y.filter (fun x => @decide (b ∣ x - c) (Classical.propDecidable _))).length : ℤ)
      (κ₂ * PB Y ∣ κ₁ * PB Z ∧ κ₂ * PR Y ∣ κ₁ * PR Z) ∨
        (¬ (ℓ : ℤ) ∣ m ∧ ((0 < m ∧ κ₁ * PR Z ∣ κ₂ * PR Y) ∨ (m < 0 ∧ κ₁ * PB Z ∣ κ₂ * PB Y)))) →
    ∃ h' : K,
      (∃ d e : ↥(wcLlsASdmS W A K t c β b), d ∉ wcLlsASdmN W A K t c β b ∧
        (d : K) * (f₀ - (h' ^ ℓ - h')) = (e : K)) ∨
      (∃ (a γ : ↥W) (m : ℤ) (d e : ↥(wcLlsASdmS W A K t c β b)),
        a ≠ 0 ∧ γ ≠ 0 ∧ ¬ (ℓ : ℤ) ∣ m ∧ d ∉ wcLlsASdmN W A K t c β b ∧
        e ∈ wcLlsASdmN W A K t c β b ∧
        (0 < m → γ * b ^ m.toNat ∣ a ^ ℓ) ∧ (m < 0 → γ ∣ a ^ ℓ * β ^ (-m).toNat) ∧
        (d : K) * (algebraMap A K (algebraMap ↥W A a) ^ ℓ * (f₀ - (h' ^ ℓ - h'))) =
          algebraMap A K (algebraMap ↥W A γ) * algebraMap A K (t - algebraMap ↥W A c) ^ m *
            ((d : K) + (e : K))) :=
by
  classical
  intro Ω _ _ W hW hWt ℓ hℓ A _ _ _ K _ _ _ 𝔭 t hPD f₀ c β b hc hβm hβ0 hbm hb0 hβb hbβ
    h κ₁ κ₂ Z Y d ε hκ₁ hκ₂ hd hε hZY heq hcase
  obtain ⟨_, hNZS, _, hmax, hm𝔭, ht𝔭, h𝔭, -⟩ := id hPD
  have := hNZS
  have hWK : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
    intro x hx h0
    have h1 : algebraMap ↥W A x = 0 :=
      (IsFractionRing.injective A K) (h0.trans (map_zero _).symm)
    rw [Algebra.algebraMap_eq_smul_one] at h1
    rcases smul_eq_zero.mp h1 with h2 | h2
    · exact hx h2
    · exact one_ne_zero h2
  have hβK := hWK β hβ0

  obtain ⟨q₀, hq₀⟩ := hβb
  have hq₀0 : q₀ ≠ 0 := by
    rintro rfl
    exact hb0 (by rw [hq₀, mul_zero])
  have hq₀m : q₀ ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hcon
    have hu : IsUnit q₀ := (IsLocalRing.notMem_maximalIdeal).mp hcon
    obtain ⟨q', hq'⟩ := hu.exists_right_inv
    exact hbβ ⟨q', by rw [hq₀, mul_assoc, hq', mul_one]⟩
  obtain ⟨x₀, hx₀⟩ := IsAlgClosed.exists_pow_nat_eq ((q₀ : ↥W) : Ω) two_pos
  have hq₀Ω : ((q₀ : ↥W) : Ω) ≠ 0 := fun hh => hq₀0 (Subtype.ext hh)
  have hx₀0 : x₀ ≠ 0 := by
    intro hh
    apply hq₀Ω
    rw [← hx₀, hh]
    ring
  have hx₀W : x₀ ∈ W := by
    rcases W.mem_or_inv_mem x₀ with hh | hh
    · exact hh
    · have e : x₀ = ((q₀ : ↥W) : Ω) * x₀⁻¹ := by
        rw [← hx₀, pow_two, mul_assoc, mul_inv_cancel₀ hx₀0, mul_one]
      rw [e]
      exact W.mul_mem _ _ q₀.2 hh
  obtain ⟨y₀, hy₀⟩ : ∃ y₀ : ↥W, (y₀ : Ω) = x₀ := ⟨⟨x₀, hx₀W⟩, rfl⟩
  have hyy : y₀ * y₀ = q₀ := Subtype.ext (by
    show (y₀ : Ω) * (y₀ : Ω) = ((q₀ : ↥W) : Ω)
    rw [hy₀, ← hx₀]
    ring)
  have hy₀0 : y₀ ≠ 0 := fun hh => hx₀0 (by rw [← hy₀, hh]; rfl)
  have hone : (1 : ↥W) ∉ IsLocalRing.maximalIdeal ↥W := fun h1 =>
    mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h1) isUnit_one
  have hy₀m : y₀ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have hq : IsUnit q₀ := by rw [← hyy]; exact hu.mul hu
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hq₀m) hq
  have hz : c + β * y₀ ∈ IsLocalRing.maximalIdeal ↥W :=
    Ideal.add_mem _ hc (Ideal.mul_mem_left _ β hy₀m)

  obtain ⟨ev, hev1, hev2, hev3⟩ := wcLlsAS_dsbu_section Ω W hW hWt A 𝔭 t (c + β * y₀) hPD hz
  have hcong : ∀ a : A, a - algebraMap ↥W A (ev a) ∈ 𝔭 := by
    intro a
    obtain ⟨s, e, hs, hse⟩ := hev3 a
    have htz : t - algebraMap ↥W A (c + β * y₀) ∈ 𝔭 :=
      Ideal.sub_mem _ ht𝔭 (hm𝔭 (Ideal.mem_map_of_mem _ hz))
    have hm : s * (a - algebraMap ↥W A (ev a)) ∈ 𝔭 := by
      rw [hse]; exact Ideal.mul_mem_right _ _ htz
    exact (hmax.isPrime.mem_or_mem hm).resolve_left hs
  have hevu : ev (t - algebraMap ↥W A c) = β * y₀ := by
    rw [map_sub, hev2, hev1]; ring
  have hβy0 : β * y₀ ≠ 0 := mul_ne_zero hβ0 hy₀0
  have huK : algebraMap A K (t - algebraMap ↥W A c) ≠ 0 := by
    intro h0
    have h1 : t - algebraMap ↥W A c = 0 :=
      (IsFractionRing.injective A K) (h0.trans (map_zero _).symm)
    apply hβy0
    rw [← hevu, h1, map_zero]

  have hgw : ∀ w : ↥W, (W.subtype.comp ev) (algebraMap ↥W A w) = (w : Ω) := by
    intro w
    show ((ev (algebraMap ↥W A w) : ↥W) : Ω) = w
    rw [hev1]
  have hgne : ∀ a : A, ev a ≠ 0 → (W.subtype.comp ev) a ≠ 0 := fun a ha hh => ha (Subtype.ext hh)
  haveI hPk : (RingHom.ker (W.subtype.comp ev)).IsPrime := RingHom.ker_isPrime _
  have hM : (RingHom.ker (W.subtype.comp ev)).primeCompl ≤ nonZeroDivisors A := by
    intro x hx
    apply mem_nonZeroDivisors_of_ne_zero
    rintro rfl
    exact hx (Ideal.zero_mem _)
  haveI hloc := Localization.subalgebra.isLocalization_subalgebra K _ hM
  have hunit : ∀ y : (RingHom.ker (W.subtype.comp ev)).primeCompl,
      IsUnit ((W.subtype.comp ev) (y : A)) := fun y =>
    IsUnit.mk0 _ (fun h0 => y.2 (RingHom.mem_ker.mpr h0))
  have hmemR : ∀ a s : A, (W.subtype.comp ev) s ≠ 0 →
      algebraMap A K a / algebraMap A K s ∈ Localization.subalgebra K _ hM := by
    intro a s hs
    have hsM : s ∈ (RingHom.ker (W.subtype.comp ev)).primeCompl :=
      fun hh => hs (RingHom.mem_ker.mp hh)
    obtain ⟨v, hv⟩ := (IsLocalization.map_units (Localization.subalgebra K _ hM)
      (⟨s, hsM⟩ : (RingHom.ker (W.subtype.comp ev)).primeCompl)).exists_right_inv
    have hv' : algebraMap A K s * (v : K) = 1 := by
      have := congrArg Subtype.val hv
      simpa only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, Subalgebra.coe_one] using this
    have hvK : (v : K) = (algebraMap A K s)⁻¹ := eq_inv_of_mul_eq_one_right hv'
    have e : algebraMap A K a / algebraMap A K s =
        ((algebraMap A (Localization.subalgebra K _ hM) a * v : Localization.subalgebra K _ hM) : K) := by
      rw [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, hvK, div_eq_mul_inv]
    rw [e]
    exact Subtype.property _
  have hgβ : (W.subtype.comp ev) (algebraMap ↥W A β) ≠ 0 := by
    rw [hgw]; exact fun hh => hβ0 (Subtype.ext hh)
  have hgu : (W.subtype.comp ev) (t - algebraMap ↥W A c) ≠ 0 :=
    hgne _ (by rw [hevu]; exact hβy0)
  have hSR : wcLlsASdmS W A K t c β b ≤ Localization.subalgebra K _ hM := by
    apply Algebra.adjoin_le
    intro x hx
    rcases hx with rfl | hx
    · exact hmemR _ _ hgβ
    · rw [Set.mem_singleton_iff] at hx
      rw [hx]
      exact hmemR _ _ hgu
  let φ₀ : ↥(wcLlsASdmS W A K t c β b) →+* Ω :=
    (IsLocalization.lift hunit).comp (Subalgebra.inclusion hSR).toRingHom
  have hkey : ∀ (x : ↥(wcLlsASdmS W A K t c β b)) (a s : A),
      (x : K) * algebraMap A K s = algebraMap A K a →
      φ₀ x * (W.subtype.comp ev) s = (W.subtype.comp ev) a := by
    intro x a s hx
    have e1 : Subalgebra.inclusion hSR x * algebraMap A (Localization.subalgebra K _ hM) s =
        algebraMap A (Localization.subalgebra K _ hM) a := by
      apply Subtype.ext
      rw [Subalgebra.coe_mul, Subalgebra.coe_inclusion, Subalgebra.coe_algebraMap,
        Subalgebra.coe_algebraMap]
      exact hx
    have e2 := congrArg (IsLocalization.lift hunit) e1
    rw [map_mul, IsLocalization.lift_eq, IsLocalization.lift_eq] at e2
    exact e2
  clear_value φ₀
  have hφρ : ∀ a : A, φ₀ (algebraMap A ↥(wcLlsASdmS W A K t c β b) a) = (W.subtype.comp ev) a := by
    intro a
    have := hkey (algebraMap A ↥(wcLlsASdmS W A K t c β b) a) a 1
      (by rw [Subalgebra.coe_algebraMap, map_one, mul_one])
    rwa [map_one, mul_one] at this
  have hs1mem : algebraMap A K (t - algebraMap ↥W A c) / algebraMap A K (algebraMap ↥W A β) ∈
      wcLlsASdmS W A K t c β b := Algebra.subset_adjoin (Set.mem_insert _ _)
  have hs2mem : algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c) ∈
      wcLlsASdmS W A K t c β b :=
    Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  have hcoeβy : ((β * y₀ : ↥W) : Ω) = (β : Ω) * (y₀ : Ω) := rfl
  have hβΩ : (β : Ω) ≠ 0 := fun hh => hβ0 (Subtype.ext hh)
  have hy₀Ω : (y₀ : Ω) ≠ 0 := fun hh => hy₀0 (Subtype.ext hh)
  have hφs1 : φ₀ ⟨_, hs1mem⟩ = (y₀ : Ω) := by
    have := hkey ⟨_, hs1mem⟩ (t - algebraMap ↥W A c) (algebraMap ↥W A β)
      (div_mul_cancel₀ _ hβK)
    rw [hgw] at this
    have e : (W.subtype.comp ev) (t - algebraMap ↥W A c) = (β : Ω) * (y₀ : Ω) := by
      show ((ev (t - algebraMap ↥W A c) : ↥W) : Ω) = _
      rw [hevu]; rfl
    rw [e, mul_comm (β : Ω)] at this
    exact mul_right_cancel₀ hβΩ this
  have hφs2 : φ₀ ⟨_, hs2mem⟩ = (y₀ : Ω) := by
    have := hkey ⟨_, hs2mem⟩ (algebraMap ↥W A b) (t - algebraMap ↥W A c)
      (div_mul_cancel₀ _ huK)
    rw [hgw] at this
    have e : (W.subtype.comp ev) (t - algebraMap ↥W A c) = (β : Ω) * (y₀ : Ω) := by
      show ((ev (t - algebraMap ↥W A c) : ↥W) : Ω) = _
      rw [hevu]; rfl
    have eb : (b : Ω) = (y₀ : Ω) * ((β : Ω) * (y₀ : Ω)) := by
      rw [hq₀, ← hyy]
      show (β : Ω) * ((y₀ : Ω) * (y₀ : Ω)) = _
      ring
    rw [e, eb] at this
    exact mul_right_cancel₀ (mul_ne_zero hβΩ hy₀Ω) this
  have hφW : ∀ x : ↥(wcLlsASdmS W A K t c β b), φ₀ x ∈ W := by
    rintro ⟨x, hx⟩
    induction hx using Algebra.adjoin_induction with
    | mem z hz =>
      rcases hz with rfl | hz
      · show φ₀ ⟨_, hs1mem⟩ ∈ W
        rw [hφs1]; exact y₀.2
      · rw [Set.mem_singleton_iff] at hz
        subst hz
        show φ₀ ⟨_, hs2mem⟩ ∈ W
        rw [hφs2]; exact y₀.2
    | algebraMap a =>
      show φ₀ (algebraMap A ↥(wcLlsASdmS W A K t c β b) a) ∈ W
      rw [hφρ]; exact (ev a).2
    | add x y hx hy ihx ihy =>
      show φ₀ (⟨x, hx⟩ + ⟨y, hy⟩) ∈ W
      rw [map_add]; exact W.add_mem _ _ ihx ihy
    | mul x y hx hy ihx ihy =>
      have e2 : (⟨x * y, mul_mem hx hy⟩ : ↥(wcLlsASdmS W A K t c β b)) =
          (⟨x, hx⟩ : ↥(wcLlsASdmS W A K t c β b)) * ⟨y, hy⟩ := rfl
      rw [e2, map_mul]; exact W.mul_mem _ _ ihx ihy
  let φ : ↥(wcLlsASdmS W A K t c β b) →+* ↥W := φ₀.codRestrict W hφW
  have hφcoe : ∀ x, ((φ x : ↥W) : Ω) = φ₀ x := fun x => rfl
  have hφw : ∀ w : ↥W, φ (algebraMap A ↥(wcLlsASdmS W A K t c β b) (algebraMap ↥W A w)) = w := by
    intro w
    apply Subtype.ext
    rw [hφcoe, hφρ, hgw]
  have hφev : ∀ a : A, φ (algebraMap A ↥(wcLlsASdmS W A K t c β b) a) = ev a := by
    intro a
    apply Subtype.ext
    rw [hφcoe, hφρ]
    rfl
  have hφ1 : φ ⟨_, hs1mem⟩ = y₀ := Subtype.ext (by rw [hφcoe, hφs1])
  have hφ2 : φ ⟨_, hs2mem⟩ = y₀ := Subtype.ext (by rw [hφcoe, hφs2])
  have hφu : ∀ a : A, a ∉ 𝔭 → IsUnit (φ (algebraMap A ↥(wcLlsASdmS W A K t c β b) a)) := by
    intro a ha
    rw [hφev]
    apply (IsLocalRing.notMem_maximalIdeal).mp
    intro hm
    apply ha
    have h1 := Ideal.add_mem _ (hcong a) (hm𝔭 (Ideal.mem_map_of_mem _ hm))
    rwa [sub_add_cancel] at h1

  have hN1 : (⟨_, hs1mem⟩ : ↥(wcLlsASdmS W A K t c β b)) ∈ wcLlsASdmN W A K t c β b :=
    Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hN2 : (⟨_, hs2mem⟩ : ↥(wcLlsASdmS W A K t c β b)) ∈ wcLlsASdmN W A K t c β b :=
    Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
  have hNm : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(wcLlsASdmS W A K t c β b) (algebraMap ↥W A w) ∈
        wcLlsASdmN W A K t c β b := fun w hw =>
    Ideal.mem_sup_right (Ideal.mem_map_of_mem
      ((algebraMap A ↥(wcLlsASdmS W A K t c β b)).comp (algebraMap ↥W A)) hw)
  have hover : 𝔭.map (algebraMap A ↥(wcLlsASdmS W A K t c β b)) ≤ wcLlsASdmN W A K t c β b := by
    have hρt : algebraMap A ↥(wcLlsASdmS W A K t c β b) t ∈ wcLlsASdmN W A K t c β b := by
      have e1 : algebraMap A ↥(wcLlsASdmS W A K t c β b) t =
          algebraMap A ↥(wcLlsASdmS W A K t c β b) (algebraMap ↥W A β) * ⟨_, hs1mem⟩ +
          algebraMap A ↥(wcLlsASdmS W A K t c β b) (algebraMap ↥W A c) := by
        apply Subtype.ext
        show algebraMap A K t = algebraMap A K (algebraMap ↥W A β) *
          (algebraMap A K (t - algebraMap ↥W A c) / algebraMap A K (algebraMap ↥W A β)) +
          algebraMap A K (algebraMap ↥W A c)
        rw [mul_div_cancel₀ _ hβK, map_sub, sub_add_cancel]
      rw [e1]
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hN1) (hNm c hc)
    rw [h𝔭, Ideal.map_sup, Ideal.map_span, Ideal.map_map]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      rintro x ⟨y, hy, rfl⟩
      rw [Set.mem_singleton_iff] at hy
      rw [hy]
      exact hρt
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      exact hNm w hw
  have hres : ∀ x : ↥(wcLlsASdmS W A K t c β b), ∃ w : ↥W,
      x - algebraMap A ↥(wcLlsASdmS W A K t c β b) (algebraMap ↥W A w) ∈
        wcLlsASdmN W A K t c β b := by
    rintro ⟨x, hx⟩
    induction hx using Algebra.adjoin_induction with
    | mem z hz =>
      refine ⟨0, ?_⟩
      rw [map_zero, map_zero, sub_zero]
      rcases hz with rfl | hz
      · exact hN1
      · rw [Set.mem_singleton_iff] at hz
        subst hz
        exact hN2
    | algebraMap a =>
      refine ⟨ev a, ?_⟩
      have e1 : (⟨algebraMap A K a, Subalgebra.algebraMap_mem _ a⟩ : ↥(wcLlsASdmS W A K t c β b)) -
          algebraMap A ↥(wcLlsASdmS W A K t c β b) (algebraMap ↥W A (ev a)) =
          algebraMap A ↥(wcLlsASdmS W A K t c β b) (a - algebraMap ↥W A (ev a)) := by
        rw [map_sub]; rfl
      rw [e1]
      exact hover (Ideal.mem_map_of_mem _ (hcong a))
    | add x y hx hy ihx ihy =>
      obtain ⟨a, ha⟩ := ihx
      obtain ⟨a', ha'⟩ := ihy
      refine ⟨a + a', ?_⟩
      have e1 : (⟨x + y, add_mem hx hy⟩ : ↥(wcLlsASdmS W A K t c β b)) -
          algebraMap A ↥(wcLlsASdmS W A K t c β b) (algebraMap ↥W A (a + a')) =
          ((⟨x, hx⟩ : ↥(wcLlsASdmS W A K t c β b)) -
            algebraMap A ↥(wcLlsASdmS W A K t c β b) (algebraMap ↥W A a)) +
          ((⟨y, hy⟩ : ↥(wcLlsASdmS W A K t c β b)) -
            algebraMap A ↥(wcLlsASdmS W A K t c β b) (algebraMap ↥W A a')) := by
        rw [map_add, map_add]
        apply Subtype.ext
        show x + y - _ = (x - _) + (y - _)
        rw [Subalgebra.coe_add]
        ring
      rw [e1]
      exact Ideal.add_mem _ ha ha'
    | mul x y hx hy ihx ihy =>
      obtain ⟨a, ha⟩ := ihx
      obtain ⟨a', ha'⟩ := ihy
      refine ⟨a * a', ?_⟩
      have e1 : (⟨x * y, mul_mem hx hy⟩ : ↥(wcLlsASdmS W A K t c β b)) -
          algebraMap A ↥(wcLlsASdmS W A K t c β b) (algebraMap ↥W A (a * a')) =
          ((⟨x, hx⟩ : ↥(wcLlsASdmS W A K t c β b)) -
            algebraMap A ↥(wcLlsASdmS W A K t c β b) (algebraMap ↥W A a)) * ⟨y, hy⟩ +
          algebraMap A ↥(wcLlsASdmS W A K t c β b) (algebraMap ↥W A a) *
            ((⟨y, hy⟩ : ↥(wcLlsASdmS W A K t c β b)) -
              algebraMap A ↥(wcLlsASdmS W A K t c β b) (algebraMap ↥W A a')) := by
        rw [map_mul, map_mul]
        have e2 : (⟨x * y, mul_mem hx hy⟩ : ↥(wcLlsASdmS W A K t c β b)) =
            (⟨x, hx⟩ : ↥(wcLlsASdmS W A K t c β b)) * ⟨y, hy⟩ := rfl
        rw [e2]
        ring
      rw [e1]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_left _ _ ha')
  have hNle : ∀ x, x ∈ wcLlsASdmN W A K t c β b → φ x ∈ IsLocalRing.maximalIdeal ↥W := by
    intro x hx
    have hle : wcLlsASdmN W A K t c β b ≤ (IsLocalRing.maximalIdeal ↥W).comap φ := by
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro z hz
        rw [SetLike.mem_coe, Ideal.mem_comap]
        rcases hz with rfl | hz
        · rw [hφ1]; exact hy₀m
        · rw [Set.mem_singleton_iff] at hz
          rw [hz, hφ2]; exact hy₀m
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [Ideal.mem_comap, Ideal.mem_comap, RingHom.comp_apply, hφw]
        exact hw
    exact hle hx
  have hφN : ∀ x, x ∈ wcLlsASdmN W A K t c β b ↔ φ x ∈ IsLocalRing.maximalIdeal ↥W := by
    intro x
    refine ⟨hNle x, fun hx => ?_⟩
    obtain ⟨w, hw⟩ := hres x
    have h1 := hNle _ hw
    rw [map_sub, hφw] at h1
    have hwm : w ∈ IsLocalRing.maximalIdeal ↥W := by
      have := Ideal.sub_mem _ hx h1
      rwa [sub_sub_cancel] at this
    have h2 := Ideal.add_mem _ hw (hNm w hwm)
    rwa [sub_add_cancel] at h2

  have hNX : ∀ X : List ↥W, ((X.filter (fun x => @decide (¬ b ∣ x - c) (Classical.propDecidable _))).map
      (fun x => x - c)).prod ≠ 0 := by
    intro X
    apply List.prod_ne_zero
    intro h0
    obtain ⟨x, hx, hx0⟩ := List.mem_map.mp h0
    have h1 := @of_decide_eq_true _ (Classical.propDecidable _) (List.mem_filter.mp hx).2
    rw [hx0] at h1
    exact h1 (dvd_zero b)
  have hiU : algebraMap A K (t - algebraMap ↥W A c) * (algebraMap A K (t - algebraMap ↥W A c))⁻¹ = 1 :=
    mul_inv_cancel₀ huK
  have hfac : ∀ X : List ↥W, (∀ x ∈ X, ¬ ((β ∣ x - c ∧ ¬ (x - c) ∣ β) ∧ ((x - c) ∣ b ∧ ¬ b ∣ (x - c)))) →
      ∃ P : ↥(wcLlsASdmS W A K t c β b), IsUnit (φ P) ∧
        (X.map (fun x => algebraMap A K (t - algebraMap ↥W A x))).prod =
          algebraMap A K (algebraMap ↥W A ((X.filter (fun x => @decide (¬ b ∣ x - c)
            (Classical.propDecidable _))).map (fun x => x - c)).prod) *
          algebraMap A K (t - algebraMap ↥W A c) ^ (X.filter (fun x => @decide (b ∣ x - c)
            (Classical.propDecidable _))).length * (P : K) := by
    intro X
    induction X with
    | nil =>
      intro _
      refine ⟨1, by rw [map_one]; exact isUnit_one, ?_⟩
      simp
    | cons x X ih =>
      intro hX
      obtain ⟨P, hPu, hP⟩ := ih (fun y hy => hX y (List.mem_cons.mpr (Or.inr hy)))
      have hx := hX x (List.mem_cons.mpr (Or.inl rfl))
      by_cases hbx : b ∣ x - c
      · have h1 : @decide (b ∣ x - c) (Classical.propDecidable _) = true :=
          @decide_eq_true _ (Classical.propDecidable _) hbx
        have h2 : @decide (¬ b ∣ x - c) (Classical.propDecidable _) = false :=
          @decide_eq_false _ (Classical.propDecidable _) (not_not.mpr hbx)
        obtain ⟨q', hq'⟩ := hbx
        refine ⟨(1 - algebraMap A ↥(wcLlsASdmS W A K t c β b) (algebraMap ↥W A q') * ⟨_, hs2mem⟩) * P,
