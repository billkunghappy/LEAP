    have h12 : s1 * s2 = b1 * b2 := sub_eq_zero.mp ((mul_eq_zero.mp hkey).resolve_left ha0)
    refine ⟨b1, s1, fun hb => ?_, hs1, e1⟩
    have : s1 * s2 ∈ 𝔭 := by rw [h12]; exact 𝔭.mul_mem_right b2 hb
