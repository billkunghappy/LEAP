      pow_ne_zero _ hν0, hbm 0, ?_⟩
  intro i hi
  obtain ⟨hbb', hcc'⟩ := chain i₁ i hi
  rw [hgn]
  exact wcLlsASvmpa_disc_small Ω W A K 𝔭 t hp hφ (c i) (b i) (c i₁) (b i₁) (b 0) ν ϖ q₁ q₂
    N P H (a * g₀) y' d' k M J (hb0 i) (hb0 i₁) hν0 hϖm hcc' hbb' hd' hq₁ hq₂ hcomp hNTne htay2

theorem wcLlsASvm_poly_reduce : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ → ∀ (c b : ℕ → ↥W), (∀ i, c i ∈ IsLocalRing.maximalIdeal ↥W) → (∀ i, b i ∈ IsLocalRing.maximalIdeal ↥W) → (∀ i, b i ≠ 0) → (∀ i, b i ∣ c (i + 1) - c i) → (∀ i, b i ∣ b (i + 1)) → (∀ i, ¬ b (i + 1) ∣ b i) → (∀ z : ↥W, ∃ i, ¬ b i ∣ z - c i) → ∀ Q : Polynomial Ω, ∃ (H : Polynomial Ω) (β : Ω) (i₁ : ℕ), ∀ i, i₁ ≤ i → ∃ δ : Ω, ∀ k : ℕ, W.valuation (((Q - (H + Polynomial.C δ) ^ ℓ + (H + Polynomial.C δ)).comp (Polynomial.C ((c i : ↥W) : Ω) + Polynomial.C ((b i : ↥W) : Ω) * Polynomial.X) - Polynomial.C (β * ((b i : ↥W) : Ω)) * Polynomial.X).coeff k) < max 1 (W.valuation (β * ((b i : ↥W) : Ω))) :=
by
  intro Ω _ _ W hdim hWt ℓ hℓ hchar c b hcm hbm hb0 hstep hbb hnb hfree
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : CharP Ω ℓ := hchar ▸ ringChar.charP Ω

  have hpr_affpow : ∀ (q s : Ω) (u w : ↥W) (m k : ℕ), W.valuation ((Polynomial.C q * (Polynomial.C (s * (u : Ω)) + Polynomial.C (s * (w : Ω)) * Polynomial.X) ^ m).coeff k) ≤ W.valuation (q * s ^ m) := by
    intro q s u w m k
    have e1 : Polynomial.C q * (Polynomial.C (s * (u : Ω)) + Polynomial.C (s * (w : Ω)) * Polynomial.X) ^ m
        = Polynomial.C (q * s ^ m) * Polynomial.map W.subtype ((Polynomial.C u + Polynomial.C w * Polynomial.X) ^ m) := by
      have e2 : Polynomial.map W.subtype ((Polynomial.C u + Polynomial.C w * Polynomial.X) ^ m) =
          (Polynomial.C (u : Ω) + Polynomial.C (w : Ω) * Polynomial.X) ^ m := by
        rw [Polynomial.map_pow]
        simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_X]
        rfl
      rw [e2]
      simp only [map_mul, map_pow]
      rw [mul_assoc (Polynomial.C s), ← mul_add, mul_pow, mul_assoc]
    rw [e1, Polynomial.coeff_C_mul, Polynomial.coeff_map, map_mul]
    calc W.valuation (q * s ^ m) * W.valuation (W.subtype (((Polynomial.C u + Polynomial.C w * Polynomial.X) ^ m).coeff k))
        ≤ W.valuation (q * s ^ m) * 1 := by
          gcongr
          exact W.valuation_le_one _
      _ = W.valuation (q * s ^ m) := mul_one _

  have hpr_inv : ∀ (N : ℕ) (G : Polynomial Ω) (y z : Ω), 1 ≤ W.valuation z → W.valuation (G.coeff 1 - y) ≤ W.valuation z → (∀ k, 2 ≤ k → W.valuation (G.coeff k) ≤ W.valuation z) → W.valuation (∑ n ∈ Finset.range (N + 1), (G.coeff (ℓ ^ n)) ^ (ℓ ^ (N - n))) ≤ (max (W.valuation y) (W.valuation z)) ^ (ℓ ^ N) := by
    intro N G y z hz h1 hk
    have hp2 := hℓ.two_le
    have hzB : W.valuation z ^ (ℓ ^ N) ≤ (max (W.valuation y) (W.valuation z)) ^ (ℓ ^ N) :=
      pow_le_pow_left₀ zero_le' (le_max_right _ _) _
    have hyB : W.valuation y ^ (ℓ ^ N) ≤ (max (W.valuation y) (W.valuation z)) ^ (ℓ ^ N) :=
      pow_le_pow_left₀ zero_le' (le_max_left _ _) _
    rw [Finset.sum_range_succ']
    apply (Valuation.map_add _ _ _).trans
    apply max_le
    · apply Valuation.map_sum_le
      intro n _
      have hpn : 2 ≤ ℓ ^ (n + 1) := by
        calc 2 ≤ ℓ := hp2
          _ = ℓ ^ 1 := (pow_one ℓ).symm
          _ ≤ ℓ ^ (n + 1) := Nat.pow_le_pow_right (by omega) (by omega)
      rw [Valuation.map_pow]
      calc W.valuation (G.coeff (ℓ ^ (n + 1))) ^ (ℓ ^ (N - (n + 1)))
          ≤ W.valuation z ^ (ℓ ^ (N - (n + 1))) := pow_le_pow_left₀ zero_le' (hk _ hpn) _
        _ ≤ W.valuation z ^ (ℓ ^ N) :=
            pow_le_pow_right₀ hz (Nat.pow_le_pow_right (by omega) (by omega))
        _ ≤ _ := hzB
    · simp only [pow_zero, Nat.sub_zero]
      have e : G.coeff 1 ^ (ℓ ^ N) = (G.coeff 1 - y) ^ (ℓ ^ N) + y ^ (ℓ ^ N) := by
        rw [← add_pow_char_pow, sub_add_cancel]
      rw [e]
      apply (Valuation.map_add _ _ _).trans
      apply max_le
      · rw [Valuation.map_pow]
        exact (pow_le_pow_left₀ zero_le' h1 _).trans hzB
      · rw [Valuation.map_pow]; exact hyB
  obtain ⟨φ, hφ⟩ : ∃ φ : ℕ → Polynomial Ω, ∀ i, φ i = Polynomial.C ((c i : ↥W) : Ω) +
      Polynomial.C ((b i : ↥W) : Ω) * Polynomial.X := ⟨_, fun i => rfl⟩
  have hbne : ∀ i, ((b i : ↥W) : Ω) ≠ 0 := fun i h => hb0 i (Subtype.ext h)

  have hCH0 : ∀ i n, b i ∣ b (i + n) ∧ b i ∣ c (i + n) - c i := by
    intro i n
    induction n with
    | zero => simp
    | succ n ih =>
      obtain ⟨h1, h2⟩ := ih
      refine ⟨h1.trans (hbb _), ?_⟩
      show b i ∣ c (i + n + 1) - c i
      have e : c (i + n + 1) - c i = (c (i + n + 1) - c (i + n)) + (c (i + n) - c i) := by ring
      rw [e]
      exact dvd_add (h1.trans (hstep _)) h2
  have hCH : ∀ i j, i ≤ j → b i ∣ b j ∧ b i ∣ c j - c i := by
    intro i j hij
    obtain ⟨n, rfl⟩ := Nat.exists_eq_add_of_le hij
    exact hCH0 i n
  have hdvle : ∀ x y : ↥W, x ∣ y → W.valuation (y : Ω) ≤ W.valuation (x : Ω) := by
    rintro x y ⟨z, rfl⟩
    have : ((x * z : ↥W) : Ω) = (x : Ω) * (z : Ω) := rfl
    rw [this, map_mul]
    exact mul_le_of_le_one_right zero_le' (W.valuation_le_one z)
  have hndvd : ∀ x y : ↥W, ¬ x ∣ y → W.valuation (x : Ω) < W.valuation (y : Ω) := by
    intro x y h
    by_contra h2
    push_neg at h2
    apply h
    by_cases hx : x = 0
    · subst hx
      have h3 : W.valuation (y : Ω) = 0 := le_antisymm (by simpa using h2) zero_le'
      have hy : (y : Ω) = 0 := (Valuation.zero_iff _).mp h3
      have : y = 0 := Subtype.ext hy
      rw [this]
    · have hx' : (x : Ω) ≠ 0 := fun h => hx (Subtype.ext h)
      have hvx : 0 < W.valuation (x : Ω) := zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr hx')
      have hmem : (y : Ω) / (x : Ω) ∈ W := by
        apply (W.valuation_le_one_iff _).mp
        by_contra h4
        push_neg at h4
        have h5 : W.valuation ((y : Ω) / (x : Ω)) * W.valuation (x : Ω) = W.valuation (y : Ω) := by
          rw [← map_mul, div_mul_cancel₀ _ hx']
        have h6 : 1 * W.valuation (x : Ω) < W.valuation ((y : Ω) / (x : Ω)) * W.valuation (x : Ω) :=
          mul_lt_mul_of_pos_right h4 hvx
        rw [one_mul, h5] at h6
        exact absurd h2 (not_le.mpr h6)
      refine ⟨⟨_, hmem⟩, Subtype.ext ?_⟩
      show (y : Ω) = (x : Ω) * ((y : Ω) / (x : Ω))
      field_simp

  have hrad : ∀ x y : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → y ≠ 0 → ∃ n : ℕ, y ∣ x ^ n := by
    intro x y hx hy
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hdim
    have hrad' : x ∈ (Ideal.span {y}).radical := by
      rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
      rintro J ⟨hJ, hJp⟩
      have hJ0 : J ≠ ⊥ := by
        intro h
        apply hy
        have : y ∈ J := hJ (Ideal.mem_span_singleton_self y)
        rw [h] at this
        exact (Submodule.mem_bot _).mp this
      have hmax := (Ring.krullDimLE_one_iff_of_isPrime_bot.mp inferInstance) J hJ0 hJp
      rw [IsLocalRing.eq_maximalIdeal hmax]
      exact hx
    obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp hrad'
    exact ⟨n, Ideal.mem_span_singleton.mp hn⟩

  have hfar : ∀ ζ : Ω, ∃ iζ : ℕ, ∀ i, iζ ≤ i →
      W.valuation (((c i : ↥W) : Ω) - ζ) = W.valuation (((c iζ : ↥W) : Ω) - ζ) ∧
      W.valuation ((b i : ↥W) : Ω) < W.valuation (((c i : ↥W) : Ω) - ζ) := by
    intro ζ
    by_cases hζ : ζ ∈ W
    · obtain ⟨iζ, hiζ⟩ := hfree ⟨ζ, hζ⟩
      have h1 := hndvd _ _ hiζ
      have e1 : (((⟨ζ, hζ⟩ : ↥W) - c iζ : ↥W) : Ω) = ζ - ((c iζ : ↥W) : Ω) := rfl
      rw [e1, Valuation.map_sub_swap] at h1
      refine ⟨iζ, fun i hi => ?_⟩
      obtain ⟨hb', hc'⟩ := hCH iζ i hi
      have h2 := hdvle _ _ hc'
      have e2 : ((c i - c iζ : ↥W) : Ω) = ((c i : ↥W) : Ω) - ((c iζ : ↥W) : Ω) := rfl
      rw [e2] at h2
      have h3 : W.valuation (((c i : ↥W) : Ω) - ζ) = W.valuation (((c iζ : ↥W) : Ω) - ζ) := by
        have e3 : ((c i : ↥W) : Ω) - ζ =
            (((c i : ↥W) : Ω) - ((c iζ : ↥W) : Ω)) + (((c iζ : ↥W) : Ω) - ζ) := by ring
        rw [e3]
        exact Valuation.map_add_eq_of_lt_right _ (lt_of_le_of_lt h2 h1)
      refine ⟨h3, ?_⟩
      rw [h3]
      exact lt_of_le_of_lt (hdvle _ _ hb') h1
    · have hvζ : 1 < W.valuation ζ := by
        by_contra h
        push_neg at h
        exact hζ ((W.valuation_le_one_iff _).mp h)
      have key : ∀ i, W.valuation (((c i : ↥W) : Ω) - ζ) = W.valuation ζ := by
        intro i
        rw [sub_eq_add_neg, Valuation.map_add_eq_of_lt_right _
          (by rw [Valuation.map_neg]; exact lt_of_le_of_lt (W.valuation_le_one _) hvζ),
          Valuation.map_neg]
      refine ⟨0, fun i _ => ⟨by rw [key, key], ?_⟩⟩
      rw [key]
      exact lt_of_le_of_lt (W.valuation_le_one _) hvζ
  have hb3 : ∀ G H : Polynomial Ω,
      (∀ k, 1 ≤ k → W.valuation (G.coeff k) < W.valuation (G.coeff 0)) →
      (∀ k, 1 ≤ k → W.valuation (H.coeff k) < W.valuation (H.coeff 0)) →
      ∀ k, 1 ≤ k → W.valuation ((G * H).coeff k) < W.valuation ((G * H).coeff 0) := by
    intro G H hG hH k hk
    have hG0 : 0 < W.valuation (G.coeff 0) := lt_of_le_of_lt zero_le' (hG 1 le_rfl)
    have hH0 : 0 < W.valuation (H.coeff 0) := lt_of_le_of_lt zero_le' (hH 1 le_rfl)
    have hHle : ∀ a, W.valuation (H.coeff a) ≤ W.valuation (H.coeff 0) := fun a => by
      rcases Nat.eq_zero_or_pos a with rfl | ha
      · exact le_rfl
      · exact (hH a ha).le
    rw [Polynomial.mul_coeff_zero, map_mul, Polynomial.coeff_mul]
    apply Valuation.map_sum_lt _ (mul_ne_zero hG0.ne' hH0.ne')
    intro x hx
    rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
    rw [map_mul]
    rcases Nat.eq_zero_or_pos x.1 with h1 | h1
    · have h2 : 1 ≤ x.2 := by omega
      rw [h1]
      exact mul_lt_mul_of_pos_left (hH _ h2) hG0
    · calc W.valuation (G.coeff x.1) * W.valuation (H.coeff x.2)
          ≤ W.valuation (G.coeff x.1) * W.valuation (H.coeff 0) := by gcongr; exact hHle _
        _ < W.valuation (G.coeff 0) * W.valuation (H.coeff 0) :=
            mul_lt_mul_of_pos_right (hG _ h1) hH0
  have hprod : ∀ s : Multiset Ω, ∃ i₀ : ℕ, ∀ i, i₀ ≤ i →
      W.valuation (((s.map fun a => Polynomial.X - Polynomial.C a).prod).eval ((c i : ↥W) : Ω)) =
        W.valuation (((s.map fun a => Polynomial.X - Polynomial.C a).prod).eval
          ((c i₀ : ↥W) : Ω)) ∧
      ∀ k, 1 ≤ k → W.valuation ((((s.map fun a => Polynomial.X - Polynomial.C a).prod).comp
          (φ i)).coeff k) <
        W.valuation ((((s.map fun a => Polynomial.X - Polynomial.C a).prod).comp (φ i)).coeff 0) := by
    intro s
    induction s using Multiset.induction_on with
    | empty =>
      refine ⟨0, fun i _ => ⟨by simp, fun k hk => ?_⟩⟩
      simp only [Multiset.map_zero, Multiset.prod_zero, Polynomial.one_comp]
      rw [Polynomial.coeff_one, if_neg (by omega), Polynomial.coeff_one_zero, map_zero, map_one]
      exact zero_lt_one
    | cons a s ih =>
      obtain ⟨i₁, hi₁⟩ := ih
      obtain ⟨i₂, hi₂⟩ := hfar a
      refine ⟨max i₁ i₂, fun i hi => ?_⟩
      simp only [Multiset.map_cons, Multiset.prod_cons]
      have hlin : ∀ k, 1 ≤ k → W.valuation (((Polynomial.X - Polynomial.C a).comp (φ i)).coeff k) <
          W.valuation (((Polynomial.X - Polynomial.C a).comp (φ i)).coeff 0) := by
        have e : (Polynomial.X - Polynomial.C a).comp (φ i) =
            Polynomial.C (((c i : ↥W) : Ω) - a) + Polynomial.C ((b i : ↥W) : Ω) * Polynomial.X := by
          rw [Polynomial.sub_comp, Polynomial.X_comp, Polynomial.C_comp, hφ, Polynomial.C_sub]; ring
        obtain ⟨_, hlt⟩ := hi₂ i (le_of_max_le_right hi)
        intro k hk
        rw [e]
        have h0 : (Polynomial.C (((c i : ↥W) : Ω) - a) +
            Polynomial.C ((b i : ↥W) : Ω) * Polynomial.X).coeff 0 = ((c i : ↥W) : Ω) - a := by
          simp
        rw [h0]
        rcases (show k = 1 ∨ 2 ≤ k by omega) with rfl | hk2
        · have h1 : (Polynomial.C (((c i : ↥W) : Ω) - a) +
              Polynomial.C ((b i : ↥W) : Ω) * Polynomial.X).coeff 1 = ((b i : ↥W) : Ω) := by
            simp
          rw [h1]; exact hlt
        · have h1 : (Polynomial.C (((c i : ↥W) : Ω) - a) +
              Polynomial.C ((b i : ↥W) : Ω) * Polynomial.X).coeff k = 0 := by
            rw [Polynomial.coeff_add, Polynomial.coeff_C, Polynomial.coeff_C_mul_X, if_neg (by omega),
              if_neg (by omega), add_zero]
          rw [h1, map_zero]; exact lt_of_le_of_lt zero_le' hlt
      refine ⟨?_, ?_⟩
      · rw [Polynomial.eval_mul, Polynomial.eval_mul, map_mul, map_mul,
          (hi₁ i (le_of_max_le_left hi)).1, (hi₁ (max i₁ i₂) (le_max_left _ _)).1]
        simp only [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
        rw [(hi₂ i (le_of_max_le_right hi)).1, (hi₂ (max i₁ i₂) (le_max_right _ _)).1]
      · rw [Polynomial.mul_comp]
        exact hb3 _ _ hlin (hi₁ i (le_of_max_le_left hi)).2
  have hpr_dom : ∀ F : Polynomial Ω, F ≠ 0 → ∃ i₀ : ℕ, ∀ i, i₀ ≤ i →
      W.valuation (F.eval ((c i : ↥W) : Ω)) = W.valuation (F.eval ((c i₀ : ↥W) : Ω)) ∧
      ∀ k : ℕ, 1 ≤ k → W.valuation ((F.comp (φ i)).coeff k) <
        W.valuation (F.eval ((c i : ↥W) : Ω)) := by
    intro F hF
    obtain ⟨P, hP⟩ : ∃ P : Polynomial Ω,
        P = (F.roots.map fun a => Polynomial.X - Polynomial.C a).prod := ⟨_, rfl⟩
    have hFeq : Polynomial.C F.leadingCoeff * P = F := by
      rw [hP]
      exact Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C IsAlgClosed.card_roots_eq_natDegree
    obtain ⟨i₀, hi₀⟩ := hprod F.roots
    rw [← hP] at hi₀
    have hlc : F.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hF
    have hcoef0 : ∀ i, (F.comp (φ i)).coeff 0 = F.eval ((c i : ↥W) : Ω) := by
      intro i
      rw [Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_comp, hφ]
      simp
    refine ⟨i₀, fun i hi => ⟨?_, ?_⟩⟩
    · rw [← hFeq, Polynomial.eval_mul, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_C,
        map_mul, map_mul, (hi₀ i hi).1]
    · intro k hk
      rw [← hcoef0 i, ← hFeq, Polynomial.mul_comp, Polynomial.C_comp]
      apply hb3 _ _ _ (hi₀ i hi).2 k hk
      intro k' hk'
      rw [Polynomial.coeff_C, Polynomial.coeff_C, if_neg (by omega), if_pos rfl, map_zero]
      exact zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr hlc)
  have hpr_sigma : ∀ (N : ℕ) (Q H : Polynomial Ω) (c b : Ω), H.natDegree < ℓ ^ N → ∑ n ∈ Finset.range (N + 1), (((Q - (H ^ ℓ - H)).comp (Polynomial.C c + Polynomial.C b * Polynomial.X)).coeff (ℓ ^ n)) ^ (ℓ ^ (N - n)) = b ^ (ℓ ^ N) * ∑ n ∈ Finset.range (N + 1), ((Polynomial.hasseDeriv (ℓ ^ n) Q).eval c) ^ (ℓ ^ (N - n)) := by
    intro N Q H c b hH
    have hp := hℓ
    set φ0 := Polynomial.C c + Polynomial.C b * Polynomial.X with hφ0
    set H' := H.comp φ0 with hH'
    have hφ0deg : φ0.natDegree ≤ 1 := by
      rw [hφ0]
      refine (Polynomial.natDegree_add_le _ _).trans (max_le ?_ ?_)
      · rw [Polynomial.natDegree_C]; omega
      · exact (Polynomial.natDegree_C_mul_le b Polynomial.X).trans Polynomial.natDegree_X_le
    have hH'deg : H'.natDegree < ℓ ^ N := by
      calc H'.natDegree ≤ H.natDegree * φ0.natDegree := Polynomial.natDegree_comp_le
        _ ≤ H.natDegree * 1 := Nat.mul_le_mul_left _ hφ0deg
        _ = H.natDegree := mul_one _
        _ < ℓ ^ N := hH
    have hsplit : (Q - (H ^ ℓ - H)).comp φ0 = Q.comp φ0 - (H' ^ ℓ - H') := by
      simp only [Polynomial.sub_comp, Polynomial.pow_comp, hH']
    have hpow : ∀ k, (H' ^ ℓ).coeff k = if ℓ ∣ k then (H'.coeff (k / ℓ)) ^ ℓ else 0 := by
      intro k
      rw [← Polynomial.map_frobenius_expand, Polynomial.coeff_map, Polynomial.coeff_expand hp.pos]
      split_ifs <;> simp [frobenius_def, hp.ne_zero]
    have hQc : ∀ k, (Q.comp φ0).coeff k = (Polynomial.hasseDeriv k Q).eval c * b ^ k := by
      intro k
      have e : Q.comp φ0 = (Polynomial.taylor c Q).comp (Polynomial.C b * Polynomial.X) := by
        rw [Polynomial.taylor_apply, Polynomial.comp_assoc, hφ0]
        simp only [Polynomial.add_comp, Polynomial.X_comp, Polynomial.C_comp]
        rw [add_comm]
      rw [e, Polynomial.comp_C_mul_X_coeff, Polynomial.taylor_coeff]
    have hterm : ∀ n ∈ Finset.range (N + 1),
        (((Q - (H ^ ℓ - H)).comp φ0).coeff (ℓ ^ n)) ^ (ℓ ^ (N - n)) =
          b ^ (ℓ ^ N) * ((Polynomial.hasseDeriv (ℓ ^ n) Q).eval c) ^ (ℓ ^ (N - n)) -
            (((H' ^ ℓ).coeff (ℓ ^ n)) ^ (ℓ ^ (N - n)) - (H'.coeff (ℓ ^ n)) ^ (ℓ ^ (N - n))) := by
      intro n hn
      have hnN : n ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hn)
      rw [hsplit, Polynomial.coeff_sub, Polynomial.coeff_sub, sub_pow_char_pow, sub_pow_char_pow,
        hQc, mul_pow, ← pow_mul, ← pow_add, Nat.add_sub_cancel' hnN, mul_comm]
    rw [Finset.sum_congr rfl hterm, Finset.sum_sub_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum]
    have hB : ∑ n ∈ Finset.range (N + 1), ((H' ^ ℓ).coeff (ℓ ^ n)) ^ (ℓ ^ (N - n)) =
        ∑ n ∈ Finset.range (N + 1), (H'.coeff (ℓ ^ n)) ^ (ℓ ^ (N - n)) := by
      rw [Finset.sum_range_succ', Finset.sum_range_succ]
      have h0 : ((H' ^ ℓ).coeff (ℓ ^ 0)) ^ (ℓ ^ (N - 0)) = 0 := by
        rw [hpow, pow_zero, if_neg (Nat.Prime.not_dvd_one hp)]
        exact zero_pow (pow_ne_zero _ hp.ne_zero)
      have hN : (H'.coeff (ℓ ^ N)) ^ (ℓ ^ (N - N)) = 0 := by
        rw [Polynomial.coeff_eq_zero_of_natDegree_lt hH'deg]
        exact zero_pow (pow_ne_zero _ hp.ne_zero)
      rw [h0, hN, add_zero, add_zero]
      apply Finset.sum_congr rfl
      intro k hk
      have hkN : k < N := Finset.mem_range.mp hk
      rw [hpow, if_pos (dvd_pow_self ℓ (Nat.succ_ne_zero k)), pow_succ', Nat.mul_div_cancel_left _ hp.pos,
        ← pow_mul, ← pow_succ']
      congr 2
      omega
    rw [hB, sub_self, sub_zero]
  have hpr_psi_lead : ∀ (N : ℕ) (Q : Polynomial Ω), 2 ≤ Q.natDegree → ¬ ℓ ∣ Q.natDegree → (∑ n ∈ Finset.range (N + 1), (Polynomial.hasseDeriv (ℓ ^ n) Q) ^ (ℓ ^ (N - n))).natDegree = (Q.natDegree - 1) * ℓ ^ N ∧ (∑ n ∈ Finset.range (N + 1), (Polynomial.hasseDeriv (ℓ ^ n) Q) ^ (ℓ ^ (N - n))).leadingCoeff = ((Q.natDegree : Ω) * Q.leadingCoeff) ^ (ℓ ^ N) := by
    intro N Q hm2 hdvd
    have hp := hℓ
    set m := Q.natDegree with hmdef
    have hQ0 : Q ≠ 0 := by
      rintro rfl
      rw [Polynomial.natDegree_zero] at hmdef
      omega
    have hm0 : (m : Ω) ≠ 0 := fun h => hdvd ((CharP.cast_eq_zero_iff Ω ℓ m).mp h)
    have hqm0 : Q.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hQ0
    have hcd : (Polynomial.derivative Q).coeff (m - 1) = (m : Ω) * Q.leadingCoeff := by
      rw [Polynomial.coeff_derivative, Nat.sub_add_cancel (by omega : 1 ≤ m)]
      have : ((m - 1 : ℕ) : Ω) + 1 = (m : Ω) := by
        rw [← Nat.cast_succ, Nat.succ_eq_add_one, Nat.sub_add_cancel (by omega : 1 ≤ m)]
      rw [this, mul_comm]; rfl
    have hdd : (Polynomial.derivative Q).natDegree = m - 1 :=
      Polynomial.natDegree_eq_of_le_of_coeff_ne_zero (Polynomial.natDegree_derivative_le Q)
        (by rw [hcd]; exact mul_ne_zero hm0 hqm0)
    have hdlc : (Polynomial.derivative Q).leadingCoeff = (m : Ω) * Q.leadingCoeff := by
      rw [Polynomial.leadingCoeff, hdd, hcd]
    have hhead : (Polynomial.hasseDeriv (ℓ ^ 0) Q) ^ (ℓ ^ (N - 0)) = (Polynomial.derivative Q) ^ (ℓ ^ N) := by
      rw [pow_zero, Polynomial.hasseDeriv_one, Nat.sub_zero]
    have hheaddeg : ((Polynomial.derivative Q) ^ (ℓ ^ N)).natDegree = (m - 1) * ℓ ^ N := by
      rw [Polynomial.natDegree_pow, hdd, mul_comm]
    have hpN : 0 < ℓ ^ N := pow_pos hp.pos N
    have htail : (∑ n ∈ Finset.range N, (Polynomial.hasseDeriv (ℓ ^ (n + 1)) Q) ^ (ℓ ^ (N - (n + 1)))).natDegree ≤ (m - 2) * ℓ ^ N := by
      apply Polynomial.natDegree_sum_le_of_forall_le
      intro n hn
      have hnN : n < N := Finset.mem_range.mp hn
      have h2 : 2 ≤ ℓ ^ (n + 1) := by
        calc 2 ≤ ℓ := hp.two_le
          _ = ℓ ^ 1 := (pow_one ℓ).symm
          _ ≤ ℓ ^ (n + 1) := Nat.pow_le_pow_right hp.pos (by omega)
      calc ((Polynomial.hasseDeriv (ℓ ^ (n + 1)) Q) ^ (ℓ ^ (N - (n + 1)))).natDegree
          ≤ ℓ ^ (N - (n + 1)) * (Polynomial.hasseDeriv (ℓ ^ (n + 1)) Q).natDegree :=
            Polynomial.natDegree_pow_le
        _ ≤ ℓ ^ N * (m - 2) := by
            apply Nat.mul_le_mul
            · exact Nat.pow_le_pow_right hp.pos (by omega)
            · exact (Polynomial.natDegree_hasseDeriv_le _ _).trans (by omega)
        _ = (m - 2) * ℓ ^ N := mul_comm _ _
    have hlt : (∑ n ∈ Finset.range N, (Polynomial.hasseDeriv (ℓ ^ (n + 1)) Q) ^ (ℓ ^ (N - (n + 1)))).natDegree < ((Polynomial.derivative Q) ^ (ℓ ^ N)).natDegree := by
      rw [hheaddeg]
      refine lt_of_le_of_lt htail ?_
      exact Nat.mul_lt_mul_of_pos_right (by omega) hpN
    rw [Finset.sum_range_succ', hhead]
    refine ⟨?_, ?_⟩
    · rw [Polynomial.natDegree_add_eq_right_of_natDegree_lt hlt, hheaddeg]
    · rw [Polynomial.leadingCoeff_add_of_degree_lt (Polynomial.degree_lt_degree hlt),
        Polynomial.leadingCoeff_pow, hdlc]
  have hpr_select : ∀ (i₀ m e : ℕ) (q Λ : Ω), 1 ≤ m → 1 ≤ e → q ≠ 0 → W.valuation (q ^ e * ((b i₀ : ↥W) : Ω) ^ ((m - 1) * e)) < W.valuation Λ → ∃ j, i₀ ≤ j ∧ (W.valuation (q * ((b j : ↥W) : Ω) ^ m) < 1 ∨ ∀ i, j ≤ i → W.valuation ((q * ((b j : ↥W) : Ω) ^ m) ^ e) < W.valuation (Λ * ((b i : ↥W) : Ω) ^ e)) := by
    intro i₀ m e q Λ hm he hq hgap
    have hmono : ∀ i j, i ≤ j → W.valuation ((b j : ↥W) : Ω) ≤ W.valuation ((b i : ↥W) : Ω) := by
      intro i j hij
      induction j, hij using Nat.le_induction with
      | base => exact le_rfl
      | succ k _ ih => exact (hdvle _ _ (hbb k)).trans ih
    have hr1 : ∀ i, W.valuation ((b i : ↥W) : Ω) ≤ 1 := fun i => W.valuation_le_one _
    have hΛpos : 0 < W.valuation Λ := lt_of_le_of_lt zero_le' hgap
    have hΛ0 : Λ ≠ 0 := (Valuation.ne_zero_iff _).mp hΛpos.ne'
    obtain ⟨x, hxdef⟩ : ∃ x : Ω, x = q ^ e * ((b i₀ : ↥W) : Ω) ^ ((m - 1) * e) / Λ := ⟨_, rfl⟩
    have hxΛ : W.valuation x * W.valuation Λ =
        W.valuation (q ^ e * ((b i₀ : ↥W) : Ω) ^ ((m - 1) * e)) := by
      rw [← map_mul, hxdef, div_mul_cancel₀ _ hΛ0]
    have hX1 : W.valuation x < 1 := by
      by_contra h
      push_neg at h
      have : W.valuation Λ ≤ W.valuation x * W.valuation Λ := le_mul_of_one_le_left zero_le' h
      rw [hxΛ] at this
      exact absurd hgap (not_lt.mpr this)
    by_cases hgood : ∃ j, i₀ ≤ j ∧ ∀ i, j ≤ i →
        W.valuation x * W.valuation ((b j : ↥W) : Ω) ^ e < W.valuation ((b i : ↥W) : Ω) ^ e
    · obtain ⟨j, hj, hg⟩ := hgood
      refine ⟨j, hj, Or.inr fun i hi => ?_⟩
      have hme : m * e = (m - 1) * e + e := by
        have : m = (m - 1) + 1 := by omega
        conv_lhs => rw [this]
        ring
      calc W.valuation ((q * ((b j : ↥W) : Ω) ^ m) ^ e)
          = W.valuation q ^ e * W.valuation ((b j : ↥W) : Ω) ^ ((m - 1) * e) *
              W.valuation ((b j : ↥W) : Ω) ^ e := by
            rw [map_pow, map_mul, map_pow, mul_pow, ← pow_mul, hme, pow_add, mul_assoc]
        _ ≤ W.valuation q ^ e * W.valuation ((b i₀ : ↥W) : Ω) ^ ((m - 1) * e) *
              W.valuation ((b j : ↥W) : Ω) ^ e :=
            by gcongr; exact hmono _ _ hj
        _ = W.valuation x * W.valuation Λ * W.valuation ((b j : ↥W) : Ω) ^ e := by
            rw [hxΛ, map_mul, map_pow, map_pow]
        _ = W.valuation Λ * (W.valuation x * W.valuation ((b j : ↥W) : Ω) ^ e) := by
            rw [mul_comm (W.valuation x), mul_assoc]
        _ < W.valuation Λ * W.valuation ((b i : ↥W) : Ω) ^ e := mul_lt_mul_of_pos_left (hg i hi) hΛpos
        _ = W.valuation (Λ * ((b i : ↥W) : Ω) ^ e) := by rw [map_mul, map_pow]
    · push_neg at hgood
      have hiter : ∀ n : ℕ, ∃ j, i₀ ≤ j ∧
          W.valuation ((b j : ↥W) : Ω) ^ e ≤ W.valuation x ^ n * W.valuation ((b i₀ : ↥W) : Ω) ^ e := by
        intro n
        induction n with
        | zero => exact ⟨i₀, le_rfl, by rw [pow_zero, one_mul]⟩
        | succ n ih =>
          obtain ⟨j, hj, hjb⟩ := ih
          obtain ⟨i, hji, hib⟩ := hgood j hj
          refine ⟨i, hj.trans hji, hib.trans ?_⟩
          calc W.valuation x * W.valuation ((b j : ↥W) : Ω) ^ e
              ≤ W.valuation x * (W.valuation x ^ n * W.valuation ((b i₀ : ↥W) : Ω) ^ e) :=
                by gcongr
            _ = W.valuation x ^ (n + 1) * W.valuation ((b i₀ : ↥W) : Ω) ^ e := by
                rw [pow_succ', mul_assoc]
      have hn : ∃ n : ℕ, W.valuation q ^ e * W.valuation x ^ n < 1 := by
        by_cases hq1 : W.valuation q ≤ 1
        · refine ⟨1, ?_⟩
          rw [pow_one]
          calc W.valuation q ^ e * W.valuation x ≤ 1 * W.valuation x :=
                by gcongr; exact pow_le_one₀ zero_le' hq1
            _ = W.valuation x := one_mul _
            _ < 1 := hX1
        · push_neg at hq1
          have hqe0 : W.valuation q ^ e ≠ 0 :=
            pow_ne_zero _ ((Valuation.ne_zero_iff _).mpr hq)
          have hqe1 : 1 < W.valuation q ^ e := one_lt_pow₀ hq1 (by omega)
          have hyv : W.valuation (q ^ e)⁻¹ < 1 := by
            rw [map_inv₀, map_pow]
            exact inv_lt_one_of_one_lt₀ hqe1
          obtain ⟨yW, hyW⟩ : ∃ yW : ↥W, (yW : Ω) = (q ^ e)⁻¹ :=
            ⟨⟨_, (W.valuation_le_one_iff _).mp hyv.le⟩, rfl⟩
          obtain ⟨xW, hxW⟩ : ∃ xW : ↥W, (xW : Ω) = x :=
            ⟨⟨_, (W.valuation_le_one_iff _).mp hX1.le⟩, rfl⟩
          have hxm : xW ∈ IsLocalRing.maximalIdeal ↥W :=
            (W.valuation_lt_one_iff xW).mpr (by rw [hxW]; exact hX1)
          have hy0 : yW ≠ 0 := by
            rintro rfl
            have : ((0 : ↥W) : Ω) = 0 := rfl
            rw [this] at hyW
            exact inv_ne_zero (pow_ne_zero e hq) hyW.symm
          obtain ⟨J, hJ⟩ := hrad xW yW hxm hy0
          have hJ' := hdvle yW (xW ^ J) hJ
          rw [SubmonoidClass.coe_pow, hxW, hyW, map_pow, map_inv₀, map_pow] at hJ'
          refine ⟨J + 1, ?_⟩
          calc W.valuation q ^ e * W.valuation x ^ (J + 1)
              = (W.valuation q ^ e * W.valuation x ^ J) * W.valuation x := by rw [pow_succ, mul_assoc]
            _ ≤ (W.valuation q ^ e * (W.valuation q ^ e)⁻¹) * W.valuation x :=
                by gcongr
            _ = W.valuation x := by rw [mul_inv_cancel₀ hqe0, one_mul]
            _ < 1 := hX1
      obtain ⟨n, hn⟩ := hn
      obtain ⟨j, hj, hjb⟩ := hiter n
      refine ⟨j, hj, Or.inl ?_⟩
      have hpow : W.valuation (q * ((b j : ↥W) : Ω) ^ m) ^ e < 1 := by
        calc W.valuation (q * ((b j : ↥W) : Ω) ^ m) ^ e
            = W.valuation q ^ e * W.valuation ((b j : ↥W) : Ω) ^ (m * e) := by
              rw [map_mul, map_pow, mul_pow, ← pow_mul]
          _ ≤ W.valuation q ^ e * W.valuation ((b j : ↥W) : Ω) ^ e :=
              mul_le_mul' le_rfl (pow_le_pow_right_of_le_one' (hr1 j)
                (Nat.le_mul_of_pos_left e (by omega)))
          _ ≤ W.valuation q ^ e * (W.valuation x ^ n * W.valuation ((b i₀ : ↥W) : Ω) ^ e) :=
              by gcongr
          _ ≤ W.valuation q ^ e * (W.valuation x ^ n * 1) :=
              by gcongr; exact pow_le_one₀ zero_le' (hr1 i₀)
          _ = W.valuation q ^ e * W.valuation x ^ n := by rw [mul_one]
          _ < 1 := hn
      by_contra h
      push_neg at h
      exact absurd hpow (not_lt.mpr (one_le_pow₀ h))

  have hdrop : ∀ (R S : Polynomial Ω) (m : ℕ), 1 ≤ m → R.natDegree ≤ m → S.natDegree ≤ m →
      R.coeff m = S.coeff m → (R - S).natDegree < m := by
    intro R S m hm hR hS hc
    have h1 : (R - S).natDegree ≤ m := by
      have := Polynomial.natDegree_sub_le_of_le hR hS
      rwa [max_self] at this
    rcases h1.lt_or_eq with h | h
    · exact h
    · exfalso
      have h0 : (R - S).coeff m = 0 := by rw [Polynomial.coeff_sub, hc, sub_self]
      rw [← h] at h0
      have hz : R - S = 0 := Polynomial.leadingCoeff_eq_zero.mp h0
      rw [hz, Polynomial.natDegree_zero] at h
      omega

  have hP : ∀ (m : ℕ) (Q : Polynomial Ω), Q.natDegree = m → ∃ (H : Polynomial Ω) (β : Ω) (i₁ : ℕ),
      ℓ * H.natDegree ≤ m ∧ ∀ i, i₁ ≤ i →
        W.valuation (((Q - (H ^ ℓ - H)).comp (φ i)).coeff 1 - β * ((b i : ↥W) : Ω)) <
          max 1 (W.valuation (β * ((b i : ↥W) : Ω))) ∧
        ∀ k, 2 ≤ k → W.valuation (((Q - (H ^ ℓ - H)).comp (φ i)).coeff k) <
          max 1 (W.valuation (β * ((b i : ↥W) : Ω))) := by
    intro m
    induction m using Nat.strong_induction_on with
    | _ m ih =>
    intro Q hQm
    by_cases hm1 : m ≤ 1
    ·
      obtain ⟨a1, a0, hQ⟩ : ∃ a1 a0 : Ω, Q = Polynomial.C a1 * Polynomial.X + Polynomial.C a0 :=
        ⟨_, _, Polynomial.eq_X_add_C_of_natDegree_le_one (by rw [hQm]; exact hm1)⟩
      refine ⟨0, a1, 0, by simp, fun i _ => ?_⟩
      have hT : (Q - ((0 : Polynomial Ω) ^ ℓ - 0)).comp (φ i) =
          Polynomial.C (a1 * ((b i : ↥W) : Ω)) * Polynomial.X +
            Polynomial.C (a1 * ((c i : ↥W) : Ω) + a0) := by
        rw [hQ, hφ i, zero_pow hℓ.ne_zero, sub_zero, sub_zero]
        simp only [Polynomial.add_comp, Polynomial.mul_comp, Polynomial.C_comp, Polynomial.X_comp,
          Polynomial.C_mul, Polynomial.C_add]
        ring
      have hpos : W.valuation (0 : Ω) < max 1 (W.valuation (a1 * ((b i : ↥W) : Ω))) := by
        rw [map_zero]; exact lt_of_lt_of_le zero_lt_one (le_max_left _ _)
      rw [hT]
      refine ⟨?_, fun k hk => ?_⟩
      · convert hpos using 2
        simp [Polynomial.coeff_C_mul_X, Polynomial.coeff_C]
      · convert hpos using 2
        rw [Polynomial.coeff_add, Polynomial.coeff_C_mul_X, Polynomial.coeff_C, if_neg (by omega),
          if_neg (by omega), add_zero]
    have hm2 : 2 ≤ m := by omega
    have hQ0 : Q ≠ 0 := by
      rintro rfl
      rw [Polynomial.natDegree_zero] at hQm
      omega
    have hQlc : Q.coeff m = Q.leadingCoeff := by rw [← hQm]; rfl
    by_cases hdvd : ℓ ∣ m
    ·
      obtain ⟨m', hm'⟩ := hdvd
      have hm'1 : m' ≠ 0 := by
        rintro rfl
        rw [mul_zero] at hm'
        omega
      have hm'lt : m' < m := by
        rw [hm']
        have := hℓ.two_le
        have := Nat.pos_of_ne_zero hm'1
        nlinarith
      obtain ⟨a, ha⟩ := IsAlgClosed.exists_pow_nat_eq Q.leadingCoeff hℓ.pos
      obtain ⟨A, hA⟩ : ∃ A : Polynomial Ω, A = Polynomial.C a * Polynomial.X ^ m' := ⟨_, rfl⟩
      have hAp : A ^ ℓ = Polynomial.C Q.leadingCoeff * Polynomial.X ^ m := by
        rw [hA, mul_pow, ← Polynomial.C_pow, ha, ← pow_mul, hm', mul_comm m' ℓ]
      have hAdeg : A.natDegree ≤ m' := hA ▸ Polynomial.natDegree_C_mul_X_pow_le a m'
      have hlt : (Q - (A ^ ℓ - A)).natDegree < m := by
        apply hdrop Q (A ^ ℓ - A) m (by omega) hQm.le
        · have h1 : (A ^ ℓ).natDegree ≤ m := by
            rw [hAp]; exact Polynomial.natDegree_C_mul_X_pow_le _ _
          have h2 : A.natDegree ≤ m := by omega
          have := Polynomial.natDegree_sub_le_of_le h1 h2
          rwa [max_self] at this
        · rw [Polynomial.coeff_sub, hAp, Polynomial.coeff_C_mul_X_pow, if_pos rfl, hQlc,
            Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt hAdeg hm'lt), sub_zero]
      obtain ⟨H', β, i₁, hdeg', hH'⟩ := ih _ hlt _ rfl
      refine ⟨H' + A, β, i₁, ?_, ?_⟩
      · have h1 := Polynomial.natDegree_add_le H' A
        have h2 : ℓ * (H' + A).natDegree ≤ ℓ * max H'.natDegree A.natDegree :=
          Nat.mul_le_mul_left _ h1
        have h3 : ℓ * A.natDegree ≤ m := by rw [hm']; exact Nat.mul_le_mul_left _ hAdeg
        rcases le_total H'.natDegree A.natDegree with h | h
        · rw [max_eq_right h] at h2; exact h2.trans h3
        · rw [max_eq_left h] at h2; exact h2.trans (hdeg'.trans hlt.le)
      · have e : Q - ((H' + A) ^ ℓ - (H' + A)) = Q - (A ^ ℓ - A) - (H' ^ ℓ - H') := by
          rw [add_pow_char]; ring
        rw [e]; exact hH'
    ·
      have hqm0 : Q.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hQ0
      have hm0 : (m : Ω) ≠ 0 := fun h => hdvd ((CharP.cast_eq_zero_iff Ω ℓ m).mp h)
      obtain ⟨N, hN1, hN2⟩ : ∃ N : ℕ, ℓ ^ N ≤ m ∧ m < ℓ * ℓ ^ N := by
        refine ⟨Nat.log ℓ m, Nat.pow_log_le_self ℓ (by omega), ?_⟩
        calc m < ℓ ^ (Nat.log ℓ m + 1) := Nat.lt_pow_succ_log_self hℓ.one_lt m
          _ = ℓ * ℓ ^ Nat.log ℓ m := by rw [pow_succ']
      have he1 : 1 ≤ ℓ ^ N := Nat.one_le_pow _ _ hℓ.pos
      obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : Polynomial Ω, Ψ = ∑ n ∈ Finset.range (N + 1),
          (Polynomial.hasseDeriv (ℓ ^ n) Q) ^ (ℓ ^ (N - n)) := ⟨_, rfl⟩
      obtain ⟨hΨdeg, hΨlc⟩ := hpr_psi_lead N Q (by rw [hQm]; exact hm2)
        (by rw [hQm]; exact hdvd)
      rw [← hΨ, hQm] at hΨdeg hΨlc
      have hΨ0 : Ψ ≠ 0 := by
        intro h
        rw [h, Polynomial.leadingCoeff_zero] at hΨlc
        exact pow_ne_zero _ (mul_ne_zero hm0 hqm0) hΨlc.symm
      obtain ⟨i₀, hi₀⟩ := hpr_dom Ψ hΨ0
      have hφdeg : (φ i₀).natDegree = 1 := by
        rw [hφ, add_comm]; exact Polynomial.natDegree_linear (hbne i₀)
      have hφlc : (φ i₀).leadingCoeff = ((b i₀ : ↥W) : Ω) := by
        rw [hφ, add_comm]; exact Polynomial.leadingCoeff_linear (hbne i₀)
      have hcoef := Polynomial.coeff_comp_degree_mul_degree (p := Ψ) (q := φ i₀)
        (by rw [hφdeg]; exact one_ne_zero)
      rw [hφdeg, mul_one, hφlc, hΨlc, hΨdeg] at hcoef
      have hgap0 := (hi₀ i₀ le_rfl).2 ((m - 1) * ℓ ^ N) (Nat.mul_pos (by omega) he1)
      rw [hcoef] at hgap0
      have hmfrob : (m : Ω) ^ ℓ = m := by
        have := map_natCast (frobenius Ω ℓ) m
        rwa [frobenius_def] at this
      have hmpow : (m : Ω) ^ (ℓ - 1) = 1 := by
        apply mul_right_cancel₀ hm0
        rw [one_mul, ← pow_succ, Nat.sub_add_cancel hℓ.one_lt.le, hmfrob]
      have hvmle : W.valuation (m : Ω) ≤ 1 := by
        have h := W.valuation_le_one (m : ↥W)
        simpa using h
      have hvm : W.valuation (m : Ω) = 1 := by
        rcases hvmle.lt_or_eq with h | h
        · exfalso
          have h2 := pow_lt_one₀ zero_le' h (show ℓ - 1 ≠ 0 by have := hℓ.two_le; omega)
          rw [← Valuation.map_pow, hmpow, map_one] at h2
          exact lt_irrefl _ h2
        · exact h
      have hgap : W.valuation (Q.leadingCoeff ^ (ℓ ^ N) * ((b i₀ : ↥W) : Ω) ^ ((m - 1) * ℓ ^ N)) <
          W.valuation (Ψ.eval ((c i₀ : ↥W) : Ω)) := by
        have e : W.valuation (((m : Ω) * Q.leadingCoeff) ^ (ℓ ^ N) *
            ((b i₀ : ↥W) : Ω) ^ ((m - 1) * ℓ ^ N)) =
            W.valuation (Q.leadingCoeff ^ (ℓ ^ N) * ((b i₀ : ↥W) : Ω) ^ ((m - 1) * ℓ ^ N)) := by
          simp only [map_mul, map_pow, hvm, one_pow, one_mul]
        rw [← e]; exact hgap0
      obtain ⟨j, hij, hsel⟩ := hpr_select i₀ m (ℓ ^ N) Q.leadingCoeff
        (Ψ.eval ((c i₀ : ↥W) : Ω)) (by omega) he1 hqm0 hgap
      obtain ⟨Qj, hQj⟩ : ∃ Qj : Polynomial Ω, Qj = Q - Polynomial.C Q.leadingCoeff *
          (Polynomial.X - Polynomial.C ((c j : ↥W) : Ω)) ^ m := ⟨_, rfl⟩
      have hmon : ((Polynomial.X - Polynomial.C ((c j : ↥W) : Ω)) ^ m).Monic :=
        (Polynomial.monic_X_sub_C _).pow m
      have hmdeg : ((Polynomial.X - Polynomial.C ((c j : ↥W) : Ω)) ^ m).natDegree = m := by
        rw [Polynomial.natDegree_pow, Polynomial.natDegree_X_sub_C, mul_one]
      have hcm1 : ((Polynomial.X - Polynomial.C ((c j : ↥W) : Ω)) ^ m).coeff m = 1 := by
        have := hmon.coeff_natDegree
        rwa [hmdeg] at this
      have hlt : Qj.natDegree < m := by
        rw [hQj]
        apply hdrop _ _ m (by omega) hQm.le
        · exact (Polynomial.natDegree_C_mul_le _ _).trans hmdeg.le
        · rw [Polynomial.coeff_C_mul, hcm1, mul_one, hQlc]
      obtain ⟨Hj, βj, ij, hdegj, hHj⟩ := ih _ hlt Qj rfl
      have hHjdeg : Hj.natDegree < ℓ ^ N :=
        Nat.lt_of_mul_lt_mul_left (lt_of_le_of_lt hdegj (hlt.trans hN2))
      refine ⟨Hj, βj, max ij j, hdegj.trans hlt.le, fun i hi => ?_⟩
      have hiij : ij ≤ i := le_of_max_le_left hi
      have hji : j ≤ i := le_of_max_le_right hi
      obtain ⟨hT'1, hT'k⟩ := hHj i hiij
      obtain ⟨⟨w, hw⟩, ⟨u, hu⟩⟩ := hCH j i hji
      have hbi : ((b i : ↥W) : Ω) = ((b j : ↥W) : Ω) * (w : Ω) := by rw [hw]; rfl
      have hci : ((c i : ↥W) : Ω) = ((c j : ↥W) : Ω) + ((b j : ↥W) : Ω) * (u : Ω) := by
        have := congrArg (fun x : ↥W => (x : Ω)) hu
        push_cast at this
        rw [← this]; ring
      have hX : (Polynomial.X - Polynomial.C ((c j : ↥W) : Ω)).comp (φ i) =
          Polynomial.C (((b j : ↥W) : Ω) * (u : Ω)) +
            Polynomial.C (((b j : ↥W) : Ω) * (w : Ω)) * Polynomial.X := by
        rw [hφ i, Polynomial.sub_comp, Polynomial.X_comp, Polynomial.C_comp, hci, hbi,
          Polynomial.C_add]
        ring
      have hdec : (Q - (Hj ^ ℓ - Hj)).comp (φ i) = (Qj - (Hj ^ ℓ - Hj)).comp (φ i) +
          Polynomial.C Q.leadingCoeff * (Polynomial.C (((b j : ↥W) : Ω) * (u : Ω)) +
            Polynomial.C (((b j : ↥W) : Ω) * (w : Ω)) * Polynomial.X) ^ m := by
        rw [← hX, hQj]
        simp only [Polynomial.sub_comp, Polynomial.mul_comp, Polynomial.pow_comp,
          Polynomial.C_comp]
        ring
      have hXk : ∀ k, W.valuation ((Polynomial.C Q.leadingCoeff *
          (Polynomial.C (((b j : ↥W) : Ω) * (u : Ω)) +
            Polynomial.C (((b j : ↥W) : Ω) * (w : Ω)) * Polynomial.X) ^ m).coeff k) ≤
          W.valuation (Q.leadingCoeff * ((b j : ↥W) : Ω) ^ m) :=
        fun k => hpr_affpow Q.leadingCoeff ((b j : ↥W) : Ω) u w m k
      have hεM : W.valuation (Q.leadingCoeff * ((b j : ↥W) : Ω) ^ m) <
          max 1 (W.valuation (βj * ((b i : ↥W) : Ω))) := by
        rcases hsel with ha | hb
        · exact lt_of_lt_of_le ha (le_max_left _ _)
        · by_contra hcon
          push_neg at hcon
          have h1z : 1 ≤ W.valuation (Q.leadingCoeff * ((b j : ↥W) : Ω) ^ m) :=
            le_trans (le_max_left _ _) hcon
          have hyz : W.valuation (βj * ((b i : ↥W) : Ω)) ≤
              W.valuation (Q.leadingCoeff * ((b j : ↥W) : Ω) ^ m) :=
            le_trans (le_max_right _ _) hcon
          have hT1 : W.valuation (((Q - (Hj ^ ℓ - Hj)).comp (φ i)).coeff 1 -
              βj * ((b i : ↥W) : Ω)) ≤ W.valuation (Q.leadingCoeff * ((b j : ↥W) : Ω) ^ m) := by
            rw [hdec, Polynomial.coeff_add, add_sub_right_comm]
            exact (Valuation.map_add _ _ _).trans (max_le (hT'1.le.trans hcon) (hXk 1))
          have hTk : ∀ k, 2 ≤ k → W.valuation (((Q - (Hj ^ ℓ - Hj)).comp (φ i)).coeff k) ≤
              W.valuation (Q.leadingCoeff * ((b j : ↥W) : Ω) ^ m) := by
            intro k hk
            rw [hdec, Polynomial.coeff_add]
            exact (Valuation.map_add _ _ _).trans (max_le ((hT'k k hk).le.trans hcon) (hXk k))
          have hinv := hpr_inv N _ _ _ h1z hT1 hTk
          rw [max_eq_right hyz, hφ i, hpr_sigma N Q Hj _ _ hHjdeg] at hinv
          have hΨev : Ψ.eval ((c i : ↥W) : Ω) = ∑ n ∈ Finset.range (N + 1),
              ((Polynomial.hasseDeriv (ℓ ^ n) Q).eval ((c i : ↥W) : Ω)) ^ (ℓ ^ (N - n)) := by
            rw [hΨ, Polynomial.eval_finset_sum]
            simp only [Polynomial.eval_pow]
          rw [← hΨev, map_mul, (hi₀ i (hij.trans hji)).1, ← Valuation.map_pow] at hinv
          have hb' := hb i hji
          have key : W.valuation (Ψ.eval ((c i₀ : ↥W) : Ω) * ((b i : ↥W) : Ω) ^ (ℓ ^ N)) =
