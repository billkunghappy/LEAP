      (Ideal.Quotient.mk K).comp (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 2))
    have hσ : ∀ f, σ f = Ideal.Quotient.mk K (Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 2) f) :=
      fun _ => rfl
    let ev : MvPolynomial (Fin 3) R →+* Polynomial R :=
      MvPolynomial.eval₂Hom (Polynomial.C : R →+* Polynomial R) ![0, 0, Polynomial.X]
    have hK : ∀ x ∈ K, ev x = 0 := by
      intro x hx
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
      · intro y hy
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
        rcases hy with rfl | rfl
        · simp [ev]
        · simp [ev]
      · exact map_zero ev
      · intro y z _ _ hy hz; rw [map_add, hy, hz, add_zero]
      · intro c y _ hy; rw [smul_eq_mul, map_mul, hy, mul_zero]
    let ρ : MvPolynomial (Fin 3) R ⧸ K →+* Polynomial R := Ideal.Quotient.lift K ev hK
    have hρ : ∀ p, ρ (Ideal.Quotient.mk K p) = ev p := fun p => Ideal.Quotient.lift_mk K ev hK
    have hρσ : ρ.comp σ = RingHom.id _ := by
      apply Polynomial.ringHom_ext
      · intro r
        rw [RingHom.comp_apply, hσ, Polynomial.eval₂_C, hρ, RingHom.id_apply]
        simp [ev]
      · rw [RingHom.comp_apply, hσ, Polynomial.eval₂_X, hρ, RingHom.id_apply]
        simp [ev]
    have hσρ : σ.comp ρ = RingHom.id _ := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, hρ, RingHom.comp_apply,
          RingHom.id_apply]
        simp only [ev, MvPolynomial.eval₂Hom_C, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      · intro i
        rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, hρ, RingHom.comp_apply,
          RingHom.id_apply]
        simp only [ev, MvPolynomial.eval₂Hom_X']
        fin_cases i
        · show σ (0 : Polynomial R) = _
          rw [map_zero]
          exact (Ideal.Quotient.eq_zero_iff_mem.mpr hX0K).symm
        · show σ (0 : Polynomial R) = _
          rw [map_zero]
          exact (Ideal.Quotient.eq_zero_iff_mem.mpr hX1K).symm
        · show σ Polynomial.X = _
          rw [hσ, Polynomial.eval₂_X]
          rfl
    have hσbij : Function.Bijective σ :=
      Function.bijective_iff_has_inverse.mpr ⟨ρ, fun x => RingHom.congr_fun hρσ x,
        fun y => RingHom.congr_fun hσρ y⟩
    have hσet : RingHom.Etale σ := RingHom.Etale.of_bijective hσbij
    set Iθ : Ideal B := Ideal.span {θ (MvPolynomial.X 0), θ (MvPolynomial.X 1)} with hIθ
    have hKmap : K.map θ = Iθ := by
      rw [Ideal.map_span, Set.image_pair]
    have hle : K ≤ Iθ.comap θ := by rw [← hKmap]; exact Ideal.le_comap_map
    let φ := Ideal.quotientMap Iθ θ hle
    have hφ : ∀ p, φ (Ideal.Quotient.mk K p) = Ideal.Quotient.mk Iθ (θ p) :=
      fun p => Ideal.quotientMap_mk
    have hφet : RingHom.Etale φ := by
      letI := θ.toAlgebra
      haveI : Algebra.Etale (MvPolynomial (Fin 3) R) B := hθ.toAlgebra
      let e : TensorProduct (MvPolynomial (Fin 3) R) (MvPolynomial (Fin 3) R ⧸ K) B ≃+* B ⧸ Iθ :=
        ((Algebra.TensorProduct.comm (MvPolynomial (Fin 3) R) (MvPolynomial (Fin 3) R ⧸ K) B).toRingEquiv.trans
          (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B K).symm.toRingEquiv).trans
          (Ideal.quotEquivOfEq hKmap)
      letI : Algebra (MvPolynomial (Fin 3) R ⧸ K) (B ⧸ Iθ) := φ.toAlgebra
      have he : ∀ p : MvPolynomial (Fin 3) R,
          e ((Ideal.Quotient.mk K p) ⊗ₜ[MvPolynomial (Fin 3) R] (1 : B)) = φ (Ideal.Quotient.mk K p) := by
