      intro _
      rcases S'.eq_empty_or_nonempty with h | h
      · refine ⟨a, Finset.mem_insert_self a S', ?_⟩
        intro x hx
        rcases Finset.mem_insert.mp hx with hx | hx
        · rw [hx]
        · rw [h] at hx; exact absurd hx (Finset.notMem_empty x)
      · obtain ⟨s, hs, hsmax⟩ := ih h
        rcases ValuationRing.dvd_total a s with has | hsa
        · refine ⟨s, Finset.mem_insert_of_mem hs, ?_⟩
          intro x hx
          rcases Finset.mem_insert.mp hx with hx | hx
          · rw [hx]; exact has
          · exact hsmax x hx
        · refine ⟨a, Finset.mem_insert_self a S', ?_⟩
          intro x hx
          rcases Finset.mem_insert.mp hx with hx | hx
          · rw [hx]
          · exact dvd_trans (hsmax x hx) hsa

  have hmin : ∀ S : Finset ↥W, S.Nonempty → ∃ s ∈ S, ∀ x ∈ S, s ∣ x := by
    intro S
    induction S using Finset.induction_on with
    | empty => intro h; exact absurd h Finset.not_nonempty_empty
    | insert a S' haS ih =>
      intro _
      rcases S'.eq_empty_or_nonempty with h | h
      · refine ⟨a, Finset.mem_insert_self a S', ?_⟩
        intro x hx
        rcases Finset.mem_insert.mp hx with hx | hx
        · rw [hx]
        · rw [h] at hx; exact absurd hx (Finset.notMem_empty x)
      · obtain ⟨s, hs, hsmin⟩ := ih h
        rcases ValuationRing.dvd_total a s with has | hsa
        · refine ⟨a, Finset.mem_insert_self a S', ?_⟩
          intro x hx
          rcases Finset.mem_insert.mp hx with hx | hx
          · rw [hx]
          · exact dvd_trans has (hsmin x hx)
        · refine ⟨s, Finset.mem_insert_of_mem hs, ?_⟩
          intro x hx
          rcases Finset.mem_insert.mp hx with hx | hx
          · rw [hx]; exact hsa
          · exact hsmin x hx

  have hCP : ∀ x ∈ insert e (T.filter (fun τ => τ ∈ IsLocalRing.maximalIdeal ↥W ∧ τ ≠ 0 ∧
      wcLlsDiscSep W A K L t c τ)),
      x ∈ IsLocalRing.maximalIdeal ↥W ∧ x ≠ 0 ∧ wcLlsDiscSep W A K L t c x := by
    intro x hx
    rcases Finset.mem_insert.mp hx with hx | hx
    · rw [hx]; exact ⟨he, he0, hesep⟩
    · exact (Finset.mem_filter.mp hx).2
  obtain ⟨bs, hbsC, hbsmax⟩ := hmax (insert e (T.filter (fun τ =>
    τ ∈ IsLocalRing.maximalIdeal ↥W ∧ τ ≠ 0 ∧ wcLlsDiscSep W A K L t c τ)))
    ⟨e, Finset.mem_insert_self e _⟩
  obtain ⟨hbsm, hbs0, hbssep⟩ := hCP bs hbsC
  refine ⟨bs, hbsm, hbs0, hbssep, ?_⟩
  intro b' hb' hb'0 hsep'
  by_contra hndvd
  have hnu : ¬ IsUnit b' := mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hb')
  rcases (T.filter (fun σ => b' ∣ σ ∧ σ ≠ 0)).eq_empty_or_nonempty with hUe | hUne
  ·
    have hb''m : b' * b₀ ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right b₀ _ hb'
    have hb''0 : b' * b₀ ≠ 0 := mul_ne_zero hb'0 hb₀
    have hside : ∀ τ ∈ T, b' ∣ τ → b' * b₀ ∣ τ := by
      intro τ hτ hdτ
      by_cases hτ0 : τ = 0
      · rw [hτ0]; exact dvd_zero _
      · exfalso
        have hmem : τ ∈ T.filter (fun σ => b' ∣ σ ∧ σ ≠ 0) :=
          Finset.mem_filter.mpr ⟨hτ, hdτ, hτ0⟩
        rw [hUe] at hmem
        exact Finset.notMem_empty τ hmem
    have hsep'' := hT (b' * b₀) b' hb''m hb''0 hb' hb'0 (dvd_mul_right b' b₀) hside hsep'
    obtain ⟨k, hk⟩ := hbound (b' * b₀) hb''m hb''0 hsep''
    have h1 : b₀ * (b' * k) = b₀ * 1 := by
      calc b₀ * (b' * k) = b' * b₀ * k := by ring
        _ = b₀ := hk.symm
        _ = b₀ * 1 := (mul_one _).symm
    have h2 : b' * k = 1 := mul_left_cancel₀ hb₀ h1
    exact hnu ⟨⟨b', k, h2, by rw [mul_comm]; exact h2⟩, rfl⟩
  ·
    obtain ⟨τn, hτnU, hτnmin⟩ := hmin _ hUne
    obtain ⟨hτnT, hb'τn, hτn0⟩ := Finset.mem_filter.mp hτnU
    have hτnm : τn ∈ IsLocalRing.maximalIdeal ↥W := by
      obtain ⟨k, hk⟩ := hb'τn
      rw [hk]; exact Ideal.mul_mem_right k _ hb'
    have hside : ∀ τ ∈ T, b' ∣ τ → τn ∣ τ := by
      intro τ hτ hdτ
      by_cases hτ0 : τ = 0
      · rw [hτ0]; exact dvd_zero _
      · exact hτnmin τ (Finset.mem_filter.mpr ⟨hτ, hdτ, hτ0⟩)
    have hsepn := hT τn b' hτnm hτn0 hb' hb'0 hb'τn hside hsep'
    have hτnC : τn ∈ insert e (T.filter (fun τ => τ ∈ IsLocalRing.maximalIdeal ↥W ∧ τ ≠ 0 ∧
        wcLlsDiscSep W A K L t c τ)) :=
      Finset.mem_insert_of_mem (Finset.mem_filter.mpr ⟨hτnT, hτnm, hτn0, hsepn⟩)
    exact hndvd (dvd_trans hb'τn (hbsmax τn hτnC))

theorem wcpa_dj_llsm_sep_chain : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → wcLlsUniq A L 𝔭 y →
    wcpaDjLkDelta (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) ≠ 0 →
    ∀ c b c' b' : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W →
      b ≠ 0 → c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W → b' ≠ 0 →
      wcLlsDiscSep W A K L t c b → wcLlsDiscSep W A K L t c' b' →
      (b ∣ b' ∧ b ∣ c' - c) ∨ (b' ∣ b ∧ b' ∣ c - c') :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy hyc hU hδ c b c' b' hc _hbm hb0
    hc' _hb'm hb'0 hs hs'
  by_contra hne
  push_neg at hne

  have key : ∃ q q' : ↥W, q ∈ IsLocalRing.maximalIdeal ↥W ∧ q' ∈ IsLocalRing.maximalIdeal ↥W ∧
      b = (c' - c) * q ∧ b' = (c' - c) * q' := by
    by_cases h1 : b ∣ b'
    · obtain ⟨w, hw⟩ := h1
      have hnb : ¬ b ∣ c' - c := hne.1 ⟨w, hw⟩
      rcases ValuationRing.dvd_total (c' - c) b with ⟨q, hq⟩ | hbr
      · have hqm : q ∈ IsLocalRing.maximalIdeal ↥W := by
          by_contra hq'
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hq'
          exact hnb ⟨↑hq'.unit⁻¹, by rw [hq, mul_assoc, IsUnit.mul_val_inv, mul_one]⟩
        exact ⟨q, q * w, hqm, Ideal.mul_mem_right _ _ hqm, hq, by rw [hw, hq, mul_assoc]⟩
      · exact absurd hbr hnb
    · obtain ⟨w', hw'⟩ := (ValuationRing.dvd_total b b').resolve_left h1
      have hw'm : w' ∈ IsLocalRing.maximalIdeal ↥W := by
        by_contra hu
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hu
        exact h1 ⟨↑hu.unit⁻¹, by rw [hw', mul_assoc, IsUnit.mul_val_inv, mul_one]⟩
      have hnb' : ¬ b' ∣ c' - c := by
        intro h
        apply hne.2 ⟨w', hw'⟩
        have h2 := (dvd_neg).mpr h
        rwa [neg_sub] at h2
      rcases ValuationRing.dvd_total (c' - c) b' with ⟨q', hq'⟩ | hbr
      · have hq'm : q' ∈ IsLocalRing.maximalIdeal ↥W := by
          by_contra hq''
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hq''
          exact hnb' ⟨↑hq''.unit⁻¹, by rw [hq', mul_assoc, IsUnit.mul_val_inv, mul_one]⟩
        exact ⟨q' * w', q', Ideal.mul_mem_right _ _ hq'm, hq'm, by rw [hw', hq', mul_assoc], hq'⟩
      · exact absurd hbr hnb'
  obtain ⟨q, q', hqm, hq'm, hbq, hb'q⟩ := key
  have hr0 : c' - c ≠ 0 := by
    intro h
    apply hb0
    rw [hbq, h, zero_mul]
  have hrm : c' - c ∈ IsLocalRing.maximalIdeal ↥W := Ideal.sub_mem _ hc' hc

  obtain ⟨Q, hQ, hQc, hQU⟩ := wcpa_dj_llsm_sc_residue_uniq Ω W hW hWt A K L 𝔭 t y hPD hy hyc hU
    c' (c' - c) b' q' hc' hrm hr0 hq'm hb'q hb'0 hs'
  haveI := hQ

  have h1 := wcpa_dj_llsm_sc_residue_smooth Ω W hW hWt A K L 𝔭 t hPD c c' b (c' - c) q hc hc'
    hr0 rfl hqm hbq hb0 hs Q hQc

  exact hδ (wcpa_dj_llsm_sc_disc_criterion Ω W hW hWt A K L 𝔭 t y hPD hy hyc hU
    c' (c' - c) b' q' hc' hrm hr0 hq'm hb'q hb'0 hs' Q hQc hQU h1)

theorem wcLlsAS_dcc_nesting : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y →
    wcLlsBR W A K L 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ α : L, α ∉ Set.range (algebraMap K L) → α ^ ℓ - α ∈ Set.range (algebraMap K L) →
    ∀ c₁ b₁ c₂ b₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → b₁ ∈ IsLocalRing.maximalIdeal ↥W →
      c₂ ∈ IsLocalRing.maximalIdeal ↥W → b₂ ∈ IsLocalRing.maximalIdeal ↥W →
      b₁ ≠ 0 → b₂ ≠ 0 → wcLlsDiscSep W A K L t c₁ b₁ → wcLlsDiscSep W A K L t c₂ b₂ →
      b₁ ∣ c₁ - c₂ ∨ b₂ ∣ c₁ - c₂ :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hSolv hUniq hBR hdeg
    α hα1 hα2 c₁ b₁ c₂ b₂ hc₁ hb₁ hc₂ hb₂ hb₁0 hb₂0 hs₁ hs₂
  obtain ⟨hy, hcomap, -, hδ'⟩ := hSolv
  have hδ := hδ' hy t rfl
  rcases wcpa_dj_llsm_sep_chain Ω W hW hWt A K L 𝔭 t y hPD hy hcomap hUniq hδ c₁ b₁ c₂ b₂
      hc₁ hb₁ hb₁0 hc₂ hb₂ hb₂0 hs₁ hs₂ with ⟨_, h1⟩ | ⟨_, h2⟩
  · left
    rw [← dvd_neg, neg_sub]
    exact h1
  · exact Or.inr h2

theorem wcLlsAS_gnerr_root_lift : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (B : Type u) [CommRing B] [IsLocalRing B] (σ : ↥W →+* B), (∀ w ∈ IsLocalRing.maximalIdeal ↥W, σ w ∈ IsLocalRing.maximalIdeal B) → ∀ (z : B) (p : Polynomial ↥W), (∃ i, p.coeff i ∉ IsLocalRing.maximalIdeal ↥W) → Polynomial.eval₂ σ z p ∈ IsLocalRing.maximalIdeal B → ∃ e : ↥W, z - σ e ∈ IsLocalRing.maximalIdeal B :=
by
  intro Ω _ _ W B _ _ σ hσ z p hp hev
  classical
  haveI hκ : IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
    apply IsAlgClosed.of_exists_root
    intro f hfm hfirr
    have hlift : f ∈ Polynomial.lifts (IsLocalRing.residue ↥W) :=
      Polynomial.map_surjective _ IsLocalRing.residue_surjective f
    obtain ⟨q, hqf, hqdeg, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hfm
    have hfdeg : 0 < f.natDegree := Polynomial.natDegree_pos_iff_degree_pos.mpr
      (Polynomial.degree_pos_of_irreducible hfirr)
    have hqΩdeg : (q.map (algebraMap ↥W Ω)).degree ≠ 0 := by
      rw [Polynomial.degree_map_eq_of_injective (IsFractionRing.injective ↥W Ω),
        Polynomial.degree_eq_natDegree hqm.ne_zero, hqdeg]
      exact_mod_cast hfdeg.ne'
    obtain ⟨α, hα⟩ := IsAlgClosed.exists_root _ hqΩdeg
    have hαint : IsIntegral ↥W α := by
      refine ⟨q, hqm, ?_⟩
      rw [Polynomial.IsRoot, Polynomial.eval_map] at hα
      exact hα
    obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (K := Ω)).mp hαint
    have hqy : q.eval y = 0 := by
      apply (IsFractionRing.injective ↥W Ω)
      rw [map_zero, ← Polynomial.eval₂_at_apply, hy, ← Polynomial.eval_map]
      exact hα
    refine ⟨IsLocalRing.residue ↥W y, ?_⟩
    rw [← hqf, Polynomial.eval_map, Polynomial.eval₂_at_apply, hqy, map_zero]
  haveI : IsLocalHom σ := by
    refine ⟨fun a ha => ?_⟩
    by_contra hna
    have h1 : a ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal a).mpr hna
    have h2 := hσ a h1
    exact ((IsLocalRing.mem_maximalIdeal _).mp h2) ha
  set τ := IsLocalRing.ResidueField.map σ with hτ
  have hτres : ∀ w : ↥W, τ (IsLocalRing.residue ↥W w) = IsLocalRing.residue B (σ w) :=
    fun w => IsLocalRing.ResidueField.map_residue σ w
  have hτcomp : τ.comp (IsLocalRing.residue ↥W) = (IsLocalRing.residue B).comp σ :=
    RingHom.ext hτres
  have hτinj : Function.Injective τ := τ.injective
  set pb := p.map (IsLocalRing.residue ↥W) with hpb
  have hpb0 : pb ≠ 0 := by
    obtain ⟨i, hi⟩ := hp
    intro h0
    apply hi
    rw [← IsLocalRing.residue_eq_zero_iff]
    have : pb.coeff i = 0 := by rw [h0, Polynomial.coeff_zero]
    rwa [hpb, Polynomial.coeff_map] at this
  set ζ := IsLocalRing.residue B z with hζ
  have hζroot : Polynomial.eval₂ τ ζ pb = 0 := by
    rw [hpb, Polynomial.eval₂_map, hτcomp, hζ, ← Polynomial.hom_eval₂,
      IsLocalRing.residue_eq_zero_iff]
    exact hev
  have hfac := Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C
    (IsAlgClosed.card_roots_eq_natDegree (k := IsLocalRing.ResidueField ↥W) (p := pb))
  have hlc : pb.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hpb0
  rw [← hfac, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_multiset_prod,
    Multiset.map_map] at hζroot
  have hτlc : τ pb.leadingCoeff ≠ 0 := by
    intro h
    exact hlc (hτinj (h.trans (map_zero τ).symm))
  have hprod := (mul_eq_zero.mp hζroot).resolve_left hτlc
  rw [Multiset.prod_eq_zero_iff, Multiset.mem_map] at hprod
  obtain ⟨a, _, ha⟩ := hprod
  simp only [Function.comp_apply, Polynomial.eval₂_sub, Polynomial.eval₂_X,
    Polynomial.eval₂_C] at ha
  obtain ⟨e, he⟩ := IsLocalRing.residue_surjective a
  refine ⟨e, ?_⟩
  rw [← IsLocalRing.residue_eq_zero_iff, map_sub, ← hτres, he, ← hζ]
  exact ha

theorem wcLlsAS_gnerr_prime_eq : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ c₀ b₀ : ↥W, c₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 → ∀ 𝔓 : Ideal ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}), 𝔓.IsPrime → (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})).comp (algebraMap ↥W A)) ≤ 𝔓 → 𝔓 < Ideal.span {⟨wcLlsScS W A K t c₀ b₀, Algebra.subset_adjoin (Set.mem_singleton _)⟩ - algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) (algebraMap ↥W A 0)} ⊔ (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})).comp (algebraMap ↥W A)) → 𝔓 = (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})).comp (algebraMap ↥W A)) :=
by
  intro Ω _ _ W A _ _ _ K _ _ _ 𝔭 t hPD c₀ b₀ hc₀ hb₀ hb₀ne 𝔓 hP hle hlt
  classical
  obtain ⟨hi, -, hiii⟩ := wcLlsKPms_chart_fibre Ω W A K 𝔭 t hPD c₀ b₀ hc₀ hb₀ hb₀ne
  set ι := (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})).comp (algebraMap ↥W A)
    with hι
  set S : ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) :=
    ⟨wcLlsScS W A K t c₀ b₀, Algebra.subset_adjoin (Set.mem_singleton _)⟩ with hS
  set mR := (IsLocalRing.maximalIdeal ↥W).map ι with hmR
  by_contra hne
  have hlt' : mR < 𝔓 := lt_of_le_of_ne hle (Ne.symm hne)
  obtain ⟨r, hr𝔓, hrm⟩ := SetLike.exists_of_lt hlt'
  obtain ⟨f, hf⟩ := hi r
  have hf𝔓 : Polynomial.eval₂ ι S f ∈ 𝔓 := by
    have h1 := 𝔓.sub_mem hr𝔓 (hle hf)
    rwa [sub_sub_cancel] at h1
  have hcoeff : ∃ i, f.coeff i ∉ IsLocalRing.maximalIdeal ↥W := by
    by_contra hall
    push_neg at hall
    have hmem : Polynomial.eval₂ ι S f ∈ mR := by
      rw [Polynomial.eval₂_eq_sum_range]
      refine Ideal.sum_mem _ (fun i _ => ?_)
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem ι (hall i))
    apply hrm
    have h2 := mR.add_mem hf hmem
    rwa [sub_add_cancel] at h2
  haveI := hP
  have KF : ∀ x : ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}),
      algebraMap _ (Localization.AtPrime 𝔓) x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔓)
        ↔ x ∈ 𝔓 := fun x =>
    IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔓) 𝔓 x
  have hσ : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      ((algebraMap _ (Localization.AtPrime 𝔓)).comp ι) w ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔓) := by
    intro w hw
    rw [RingHom.comp_apply, KF]
    exact hle (Ideal.mem_map_of_mem ι hw)
  have hev : Polynomial.eval₂ ((algebraMap _ (Localization.AtPrime 𝔓)).comp ι)
      (algebraMap _ (Localization.AtPrime 𝔓) S) f ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔓) := by
    rw [← Polynomial.hom_eval₂, KF]
    exact hf𝔓
  obtain ⟨e, he⟩ := wcLlsAS_gnerr_root_lift Ω W (Localization.AtPrime 𝔓)
    ((algebraMap _ (Localization.AtPrime 𝔓)).comp ι) hσ
    (algebraMap _ (Localization.AtPrime 𝔓) S) f hcoeff hev
  have hSe : S - ι e ∈ 𝔓 := by
    rw [← KF, map_sub]
    exact he
  have hJe : Ideal.span {S - ι e} ⊔ mR ≤ 𝔓 :=
    sup_le ((Ideal.span_singleton_le_iff_mem _).mpr hSe) hle
  have hJmax : (Ideal.span {S - ι e} ⊔ mR).IsMaximal := (hiii e).1
  have heq : Ideal.span {S - ι e} ⊔ mR = 𝔓 := hJmax.eq_of_le hP.ne_top hJe
  have hPmax : 𝔓.IsMaximal := heq ▸ hJmax
  have hJ0 := (hiii 0).1
  exact hJ0.ne_top ((IsCoatom.lt_iff hPmax.out).mp hlt)

theorem wcLlsAS_gnerr_node_contract : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ c₀ b₀ c' b' q₀ e' : ↥W, c₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 → q₀ ∈ IsLocalRing.maximalIdeal ↥W → c' - c₀ = b₀ * e' → b' = b₀ * q₀ → ∀ (s : K), s = algebraMap A K (algebraMap ↥W A b') / algebraMap A K (t - algebraMap ↥W A c') → ∀ (𝔔 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L)) [𝔔.IsPrime], 𝔔.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L)) = (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})).comp (algebraMap ↥W A)) → ∃ Q' : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L), Q'.IsPrime ∧ Q'.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) = Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c'), ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔ (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) ∧ ∀ x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L), ∃ y d : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L), d ∉ 𝔔 ∧ (x : L) * (d : L) = (y : L) ∧ (x ∈ Q' ↔ y ∈ 𝔔) :=
by
  intro Ω _ _ W A _ _ _ K _ _ _ L _ _ _ 𝔭 t hPD c₀ b₀ c' b' q₀ e' hc₀ hb₀ hb₀0 hq₀ he' hb' s hs
    𝔔 h𝔔 hco
  classical

  have n1 : ∀ (R : Subalgebra A K) (σ s₁ : K), σ ∈ R → σ * s₁ ∈ R →
      ∀ b ∈ Algebra.adjoin A {s₁}, ∃ k : ℕ, σ ^ k * b ∈ R := by
    intro R σ s₁ hσ hσs b hb
    induction hb using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      exact ⟨1, by rw [pow_one, hx]; exact hσs⟩
    | algebraMap a => exact ⟨0, by rw [pow_zero, one_mul]; exact R.algebraMap_mem a⟩
    | add x y _ _ hx hy =>
      obtain ⟨k₁, h₁⟩ := hx
      obtain ⟨k₂, h₂⟩ := hy
      refine ⟨k₁ + k₂, ?_⟩
      have e : σ ^ (k₁ + k₂) * (x + y) = σ ^ k₂ * (σ ^ k₁ * x) + σ ^ k₁ * (σ ^ k₂ * y) := by ring
      rw [e]
      exact R.add_mem (R.mul_mem (R.pow_mem hσ _) h₁) (R.mul_mem (R.pow_mem hσ _) h₂)
    | mul x y _ _ hx hy =>
      obtain ⟨k₁, h₁⟩ := hx
      obtain ⟨k₂, h₂⟩ := hy
      refine ⟨k₁ + k₂, ?_⟩
      have e : σ ^ (k₁ + k₂) * (x * y) = (σ ^ k₁ * x) * (σ ^ k₂ * y) := by ring
      rw [e]
      exact R.mul_mem h₁ h₂

  have n2 : ∀ (R B : Subalgebra A K) (σ : K), σ ∈ R → (∀ b ∈ B, ∃ k : ℕ, σ ^ k * b ∈ R) →
      ∀ x : L, IsIntegral (↥B) x → ∃ k : ℕ, IsIntegral (↥R) (algebraMap K L (σ ^ k) * x) := by
    intro R B σ hσ hB x hx
    obtain ⟨p, hpm, hpx⟩ := hx
    obtain ⟨pK, hpK⟩ : ∃ pK : Polynomial K, pK = p.map (algebraMap (↥B) K) := ⟨_, rfl⟩
    have hpKm : pK.Monic := by rw [hpK]; exact hpm.map _
    have hco' : ∀ i, ∃ k, σ ^ k * pK.coeff i ∈ R := by
      intro i
      rw [hpK, Polynomial.coeff_map]
      exact hB _ (p.coeff i).2
    choose kf hkf using hco'
    obtain ⟨n, hn⟩ : ∃ n, n = pK.natDegree := ⟨_, rfl⟩
    obtain ⟨k, hk⟩ : ∃ k, k = ∑ i ∈ Finset.range (n + 1), kf i := ⟨_, rfl⟩
    have hkc : ∀ i ≤ n, σ ^ k * pK.coeff i ∈ R := by
      intro i hi
      have hle : kf i ≤ k := by
        rw [hk]
        exact Finset.single_le_sum (f := kf) (fun _ _ => Nat.zero_le _)
          (Finset.mem_range.mpr (by omega))
      have e : σ ^ k * pK.coeff i = σ ^ (k - kf i) * (σ ^ kf i * pK.coeff i) := by
        rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hle]
      rw [e]
      exact R.mul_mem (R.pow_mem hσ _) (hkf i)
    have hqc : ∀ i, (pK.scaleRoots (σ ^ k)).coeff i ∈ R := by
      intro i
      rw [Polynomial.coeff_scaleRoots, ← hn]
      rcases lt_trichotomy i n with h | h | h
      · obtain ⟨j, hj⟩ : ∃ j, n - i = j + 1 := ⟨n - i - 1, by omega⟩
        have e : pK.coeff i * (σ ^ k) ^ (n - i) = (σ ^ k * pK.coeff i) * (σ ^ k) ^ j := by
          rw [hj]; ring
        rw [e]
        exact R.mul_mem (hkc i h.le) (R.pow_mem (R.pow_mem hσ _) _)
      · rw [h, Nat.sub_self, pow_zero, mul_one, hn, hpKm.coeff_natDegree]
        exact R.one_mem
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), zero_mul]
        exact R.zero_mem
    have hqm : (pK.scaleRoots (σ ^ k)).Monic := (Polynomial.monic_scaleRoots_iff _).mpr hpKm
    have hql : pK.scaleRoots (σ ^ k) ∈ Polynomial.lifts (R.val : ↥R →+* K) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      exact ⟨⟨_, hqc i⟩, rfl⟩
    obtain ⟨qR, hqRmap, -, hqRm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hql hqm
    refine ⟨k, qR, hqRm, ?_⟩
    have e1 : Polynomial.eval₂ (algebraMap (↥R) L) (algebraMap K L (σ ^ k) * x) qR =
        Polynomial.eval₂ (algebraMap K L) (algebraMap K L (σ ^ k) * x)
          (pK.scaleRoots (σ ^ k)) := by
      rw [← hqRmap, Polynomial.eval₂_map]
      rfl
    have e2 : Polynomial.eval₂ (algebraMap K L) x pK = 0 := by
      rw [hpK, Polynomial.eval₂_map]
      exact hpx
    rw [e1, Polynomial.scaleRoots_eval₂_mul, e2, mul_zero]

  have n3 : ∀ (C C' : Type u) [CommRing C] [CommRing C'] (ι : C →+* L) (ι' : C' →+* L),
      Function.Injective ι → ∀ (Q : Ideal C), Q.IsPrime → ∀ δ : C, δ ∉ Q →
      (∀ x : C', ∃ (k : ℕ) (y : C), ι' x * ι δ ^ k = ι y) →
      ∃ Q' : Ideal C', Q'.IsPrime ∧
        ∀ (x : C') (k : ℕ) (y : C), ι' x * ι δ ^ k = ι y → (x ∈ Q' ↔ y ∈ Q) := by
    intro C C' _ _ ι ι' hι Q hQ δ hδ H
    have hδp : ∀ j : ℕ, δ ^ j ∉ Q := fun j h => hδ (hQ.mem_of_pow_mem j h)
    have WD : ∀ (x : C') (k₁ : ℕ) (y₁ : C) (k₂ : ℕ) (y₂ : C), ι' x * ι δ ^ k₁ = ι y₁ →
        ι' x * ι δ ^ k₂ = ι y₂ → y₁ ∈ Q → y₂ ∈ Q := by
      intro x k₁ y₁ k₂ y₂ h₁ h₂ hy
      have e : y₁ * δ ^ k₂ = y₂ * δ ^ k₁ := by
        apply hι
        simp only [map_mul, map_pow]
        rw [← h₁, ← h₂]
        ring
      have h3 : y₂ * δ ^ k₁ ∈ Q := e ▸ Q.mul_mem_right _ hy
      exact (hQ.mem_or_mem h3).resolve_right (hδp k₁)
    let Q' : Ideal C' :=
      { carrier := {x | ∃ (k : ℕ) (y : C), ι' x * ι δ ^ k = ι y ∧ y ∈ Q}
        add_mem' := by
          rintro a b ⟨k₁, y₁, h₁, hy₁⟩ ⟨k₂, y₂, h₂, hy₂⟩
          refine ⟨k₁ + k₂, y₁ * δ ^ k₂ + y₂ * δ ^ k₁, ?_,
            Q.add_mem (Q.mul_mem_right _ hy₁) (Q.mul_mem_right _ hy₂)⟩
          simp only [map_add, map_mul, map_pow]
          rw [← h₁, ← h₂]
          ring
        zero_mem' := ⟨0, 0, by simp, Q.zero_mem⟩
        smul_mem' := by
          rintro c x ⟨k, y, h, hy⟩
          obtain ⟨j, z, hz⟩ := H c
          refine ⟨j + k, z * y, ?_, Q.mul_mem_left _ hy⟩
          rw [smul_eq_mul, map_mul, map_mul, ← hz, ← h]
          ring }
    refine ⟨Q', ⟨?_, ?_⟩, ?_⟩
    · rw [Ideal.ne_top_iff_one]
      rintro ⟨k, y, h, hy⟩
      rw [map_one, one_mul, ← map_pow] at h
      exact hδp k (by rw [hι h]; exact hy)
    · rintro a b ⟨k, y, h, hy⟩
      obtain ⟨k₁, y₁, h₁⟩ := H a
      obtain ⟨k₂, y₂, h₂⟩ := H b
      have h12 : ι' (a * b) * ι δ ^ (k₁ + k₂) = ι (y₁ * y₂) := by
        rw [map_mul, map_mul, ← h₁, ← h₂]
        ring
      have h3 := WD _ k y _ _ h h12 hy
      rcases hQ.mem_or_mem h3 with h' | h'
      · exact Or.inl ⟨k₁, y₁, h₁, h'⟩
      · exact Or.inr ⟨k₂, y₂, h₂, h'⟩
    · intro x k y h
      constructor
      · rintro ⟨k', y', h', hy'⟩
        exact WD x k' y' k y h' h hy'
      · intro hy
        exact ⟨k, y, h, hy⟩

  have hcf := wcLlsKPms_chart_fibre Ω W A K 𝔭 t hPD c₀ b₀ hc₀ hb₀ hb₀0
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h => hPD.2.2.2.1.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have hNZ := hPD.2.1
  haveI := hNZ
  have hWA : Function.Injective (algebraMap ↥W A) := by
    intro x y hxy
    have h1 : (x - y) • (1 : A) = 0 := by
      rw [sub_smul, Algebra.smul_def, Algebra.smul_def, mul_one, mul_one, hxy, sub_self]
    rcases smul_eq_zero.mp h1 with h2 | h2
    · exact sub_eq_zero.mp h2
    · exact absurd h2 one_ne_zero
  have hAK : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hb₀K : algebraMap A K (algebraMap ↥W A b₀) ≠ 0 := by
    intro h0; apply hb₀0; apply hWA; apply hAK; rw [h0, map_zero, map_zero]
  have e1 : algebraMap A K (algebraMap ↥W A b₀) * wcLlsScS W A K t c₀ b₀ =
      algebraMap A K (t - algebraMap ↥W A c₀) := by
    unfold wcLlsScS; field_simp
  have he'K := congrArg (fun w => algebraMap A K (algebraMap ↥W A w)) he'
  simp only [map_sub, map_mul] at he'K e1
  have e2 : algebraMap A K (algebraMap ↥W A b₀) *
      (wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e')) =
      algebraMap A K (t - algebraMap ↥W A c') := by
    rw [map_sub]; linear_combination e1 + he'K
  obtain ⟨S'R, hS'R⟩ : ∃ x : ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}),
      x = ⟨wcLlsScS W A K t c₀ b₀, Algebra.subset_adjoin (Set.mem_singleton _)⟩ -
        algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) (algebraMap ↥W A e') :=
    ⟨_, rfl⟩
  have hS'mR : S'R ∉ (IsLocalRing.maximalIdeal ↥W).map
      ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})).comp (algebraMap ↥W A)) := by
    intro h0
    have h2 := hcf.2.1 1 0 (Polynomial.X - Polynomial.C e') h1𝔭 (by
      rw [pow_zero, one_mul, Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C]
      rw [hS'R] at h0
      exact h0) 1
    have h3 : (Polynomial.X - Polynomial.C e' : Polynomial ↥W).coeff 1 = 1 := by simp
    rw [h3, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h2
    exact h2 isUnit_one
  have hS'Q : algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L) S'R ∉ 𝔔 := by
    intro h0
    rw [← Ideal.mem_comap, hco] at h0
    exact hS'mR h0
  obtain ⟨σK, hσKd⟩ : ∃ σ : K, σ = wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e') :=
    ⟨_, rfl⟩
  have hσK : (S'R : K) = σK := by rw [hS'R, hσKd]; rfl
  have hS'0 : σK ≠ 0 := by
    intro h0
    apply hS'Q
    have h2 : S'R = 0 := Subtype.ext (by rw [hσK, h0]; rfl)
    rw [h2, map_zero]; exact 𝔔.zero_mem
  have hsS : s * σK = algebraMap A K (algebraMap ↥W A q₀) := by
    rw [hσKd, hs, ← e2, hb', map_mul, map_mul]
    rw [hσKd] at hS'0
    field_simp

  have hB := n1 (Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) σK s (hσK ▸ S'R.2)
    (by rw [mul_comm, hsS]; exact Subalgebra.algebraMap_mem _ _)
  have hint : ∀ x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L), ∃ k : ℕ,
      IsIntegral ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) (algebraMap K L (σK ^ k) * (x : L)) :=
    fun x => n2 _ (Algebra.adjoin A {s}) σK (hσK ▸ S'R.2) hB x x.2
  have hιδ : ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L) S'R :
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L)) : L) =
      algebraMap K L σK := by
    rw [← hσK]; rfl
  have hW : ∀ x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L), ∃ (k : ℕ)
      (y : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L)),
      (x : L) * ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L) S'R :
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L)) : L) ^ k =
        (y : L) := by
    intro x
    obtain ⟨k, hk⟩ := hint x
    refine ⟨k, ⟨_, hk⟩, ?_⟩
    show (x : L) * _ = algebraMap K L (σK ^ k) * (x : L)
    rw [hιδ, map_pow, mul_comm]

  obtain ⟨Q', hQ'p, hCh⟩ := n3 ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L)
    ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
    (integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L).val.toRingHom
    (integralClosure ↥(Algebra.adjoin A {s}) L).val.toRingHom
    (fun x y hxy => Subtype.ext hxy) 𝔔 h𝔔 _ hS'Q (fun x => hW x)
  have hCh' : ∀ (x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) (k : ℕ)
      (y : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L)),
      (x : L) * algebraMap K L σK ^ k = (y : L) → (x ∈ Q' ↔ y ∈ 𝔔) := by
    intro x k y h
    apply hCh x k y
    rw [← hιδ] at h
    exact h
  have hRQ : ∀ a : A, algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) a ∈
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})).comp (algebraMap ↥W A)) →
      algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L)
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) a) ∈ 𝔔 := by
    intro a ha
    rw [← Ideal.mem_comap, hco]
    exact ha

  have hc' : c' ∈ IsLocalRing.maximalIdeal ↥W := by
    have e : c' = c₀ + b₀ * e' := by rw [← he']; ring
    rw [e]
    exact Ideal.add_mem _ hc₀ (Ideal.mul_mem_right _ _ hb₀)
  have hNle : Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c'),
      ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {s})).comp
        (algebraMap ↥W A)) ≤
      Q'.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) := by
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      intro z hz
      rcases hz with rfl | hz
      · rw [SetLike.mem_coe, Ideal.mem_comap]
        refine (hCh' _ 0 (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L)
          (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) (t - algebraMap ↥W A c')))
          (by rw [pow_zero, mul_one]; rfl)).mpr ?_
        apply hRQ
        have e3 : algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})
            (t - algebraMap ↥W A c') =
            algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) (algebraMap ↥W A b₀) *
              S'R := by
          apply Subtype.ext
          rw [Subalgebra.coe_mul, hσK, hσKd]
          exact e2.symm
        rw [e3]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hb₀)
      · rw [Set.mem_singleton_iff] at hz
        subst hz
        rw [SetLike.mem_coe, Ideal.mem_comap]
        refine (hCh' _ 1 (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L)
          (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) (algebraMap ↥W A q₀)))
          ?_).mpr ?_
        · rw [pow_one]
          show algebraMap K L s * algebraMap K L σK = algebraMap K L (algebraMap A K (algebraMap ↥W A q₀))
          rw [← map_mul, hsS]
        · apply hRQ
          exact Ideal.mem_map_of_mem _ hq₀
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap]
      refine (hCh' _ 0 (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L)
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) (algebraMap ↥W A w)))
        (by rw [pow_zero, mul_one]; rfl)).mpr ?_
      apply hRQ
      exact Ideal.mem_map_of_mem _ hw

  have n4 : ∀ J : Ideal ↥(Algebra.adjoin A {s}), J ≠ ⊤ →
      Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c'),
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {s})).comp
          (algebraMap ↥W A)) ≤ J →
      J = Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c'),
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {s})).comp
          (algebraMap ↥W A)) := by
    intro J hJ hNJ
    have hmax : 𝔭.IsMaximal := hPD.2.2.2.1
    have h𝔭 : 𝔭 = Ideal.span {t} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) :=
      hPD.2.2.2.2.2.2.1
    have hI : ∀ I : Ideal ↥(Algebra.adjoin A {s}),
        Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c'),
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
          (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {s})).comp
            (algebraMap ↥W A)) ≤ I →
        𝔭 ≤ I.comap (algebraMap A ↥(Algebra.adjoin A {s})) := by
      intro I hI
      rw [h𝔭]
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro x hx
        rw [Set.mem_singleton_iff] at hx
        subst hx
        rw [SetLike.mem_coe, Ideal.mem_comap]
        have e : algebraMap A ↥(Algebra.adjoin A {s}) x =
            algebraMap A ↥(Algebra.adjoin A {s}) (x - algebraMap ↥W A c') +
              ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) c' := by
          rw [RingHom.comp_apply, ← map_add, sub_add_cancel]
        rw [e]
        apply I.add_mem
        · apply hI
          apply Ideal.mem_sup_left
          apply Ideal.subset_span
          exact Set.mem_insert _ _
        · apply hI
          apply Ideal.mem_sup_right
          exact Ideal.mem_map_of_mem _ hc'
      · rw [← Ideal.map_le_iff_le_comap, Ideal.map_map]
        exact le_trans le_sup_right hI
    have hJc : 𝔭 = J.comap (algebraMap A ↥(Algebra.adjoin A {s})) :=
      hmax.eq_of_le (Ideal.comap_ne_top _ hJ) (hI J hNJ)
    have hcong : ∀ z : ↥(Algebra.adjoin A {s}), ∃ a : A,
        z - algebraMap A ↥(Algebra.adjoin A {s}) a ∈
        Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c'),
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
          (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {s})).comp
            (algebraMap ↥W A)) := by
      rintro ⟨z, hz⟩
      induction hz using Algebra.adjoin_induction with
      | mem x hx =>
        rw [Set.mem_singleton_iff] at hx
        subst hx
        refine ⟨0, ?_⟩
        rw [map_zero, sub_zero]
        apply Ideal.mem_sup_left
        apply Ideal.subset_span
        exact Set.mem_insert_of_mem _ (Set.mem_singleton _)
      | algebraMap a =>
        refine ⟨a, ?_⟩
        have e : (⟨algebraMap A K a, Subalgebra.algebraMap_mem _ a⟩ : ↥(Algebra.adjoin A {s})) -
            algebraMap A ↥(Algebra.adjoin A {s}) a = 0 := sub_eq_zero.mpr rfl
        rw [e]
        exact Ideal.zero_mem _
      | add x y hx hy ihx ihy =>
        obtain ⟨a₁, h₁⟩ := ihx
        obtain ⟨a₂, h₂⟩ := ihy
        refine ⟨a₁ + a₂, ?_⟩
        have e : (⟨x + y, add_mem hx hy⟩ : ↥(Algebra.adjoin A {s})) = ⟨x, hx⟩ + ⟨y, hy⟩ := rfl
        rw [e, map_add, add_sub_add_comm]
        exact Ideal.add_mem _ h₁ h₂
      | mul x y hx hy ihx ihy =>
        obtain ⟨a₁, h₁⟩ := ihx
        obtain ⟨a₂, h₂⟩ := ihy
        refine ⟨a₁ * a₂, ?_⟩
        have e : (⟨x * y, mul_mem hx hy⟩ : ↥(Algebra.adjoin A {s})) = ⟨x, hx⟩ * ⟨y, hy⟩ := rfl
        have e' : (⟨x, hx⟩ : ↥(Algebra.adjoin A {s})) * ⟨y, hy⟩ -
            algebraMap A ↥(Algebra.adjoin A {s}) (a₁ * a₂) =
            (⟨x, hx⟩ - algebraMap A ↥(Algebra.adjoin A {s}) a₁) * ⟨y, hy⟩ +
              algebraMap A ↥(Algebra.adjoin A {s}) a₁ *
                (⟨y, hy⟩ - algebraMap A ↥(Algebra.adjoin A {s}) a₂) := by
          rw [map_mul]; ring
        rw [e, e']
        exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ h₁) (Ideal.mul_mem_left _ _ h₂)
    refine le_antisymm ?_ hNJ
    intro z hz
    obtain ⟨a, ha⟩ := hcong z
    have haJ : algebraMap A ↥(Algebra.adjoin A {s}) a ∈ J := by
      have e : algebraMap A ↥(Algebra.adjoin A {s}) a =
          z - (z - algebraMap A ↥(Algebra.adjoin A {s}) a) := by ring
      rw [e]
      exact J.sub_mem hz (hNJ ha)
    have ha𝔭 : a ∈ 𝔭 := by rw [hJc]; exact haJ
    have haN := hI _ le_rfl ha𝔭
    rw [Ideal.mem_comap] at haN
    have e : z = (z - algebraMap A ↥(Algebra.adjoin A {s}) a) +
        algebraMap A ↥(Algebra.adjoin A {s}) a := by ring
    rw [e]
    exact Ideal.add_mem _ ha haN
  refine ⟨Q', hQ'p, n4 _ (Ideal.comap_ne_top _ hQ'p.ne_top) hNle, ?_⟩

  intro x
  obtain ⟨k, hk⟩ := hint x
  refine ⟨⟨_, hk⟩, algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L) S'R ^ k,
    fun h => hS'Q (h𝔔.mem_of_pow_mem k h), ?_, ?_⟩
  · show (x : L) * ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L) S'R ^ k :
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L)) : L) =
      algebraMap K L (σK ^ k) * (x : L)
    rw [SubmonoidClass.coe_pow, hιδ, map_pow, mul_comm]
  · apply hCh'
    show (x : L) * algebraMap K L σK ^ k = algebraMap K L (σK ^ k) * (x : L)
    rw [map_pow, mul_comm]

theorem wcLlsAS_gnerr_circle_unit : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (P₂ : Type u) [CommRing P₂] [IsDomain P₂] [IsIntegrallyClosed P₂] (σ₂ : ↥W →+* P₂), Function.Injective σ₂ → ∀ (n : ℕ) (μ g' : ↥W) (X Y E S : P₂), 1 ≤ n → μ ≠ 0 → IsUnit E → IsUnit S → E * X ^ n * S = σ₂ μ ^ n → X * Y = σ₂ μ * σ₂ g' → ∃ Z Zi : P₂, Z * Zi = 1 ∧ X = σ₂ μ * Z ∧ Y = σ₂ g' * Zi ∧ Z ^ n * E * S = 1 :=
by
  intro Ω _ W P₂ _ _ _ σ₂ hinj n μ g' X Y E S hn hμ hE hS H1 H2
  have hm : σ₂ μ ≠ 0 := (map_ne_zero_iff σ₂ hinj).mpr hμ
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  obtain ⟨u, hu⟩ := hE.exists_right_inv
  obtain ⟨v, hv⟩ := hS.exists_right_inv
  have key : X ^ (k + 1) = σ₂ μ ^ (k + 1) * (u * v) := by
    linear_combination (u * v) * H1 - X ^ (k + 1) * S * v * hu - X ^ (k + 1) * hv
  have hdvd : σ₂ μ ∣ X :=
    (IsIntegrallyClosed.pow_dvd_pow_iff (Nat.succ_ne_zero k)).mp (Dvd.intro _ key.symm)
  obtain ⟨Z, hZ⟩ := hdvd
  rw [hZ] at H1 H2
  have h4 : Z ^ (k + 1) * E * S = 1 := by
    have h : σ₂ μ ^ (k + 1) * (Z ^ (k + 1) * E * S) = σ₂ μ ^ (k + 1) * 1 := by
      linear_combination H1
    exact mul_left_cancel₀ (pow_ne_zero _ hm) h
  have h5 : Z * Y = σ₂ g' := by
    apply mul_left_cancel₀ hm
    linear_combination H2
  refine ⟨Z, Z ^ k * E * S, ?_, hZ, ?_, h4⟩
  · linear_combination h4
  · linear_combination (-Y) * h4 + (Z ^ k * E * S) * h5

theorem wcLlsAS_gnerr_gauss_hens : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (P₂ : Type u) [CommRing P₂] [IsDomain P₂] [HenselianLocalRing P₂] (σ₂ : ↥W →+* P₂), Function.Injective σ₂ → (∀ w ∈ IsLocalRing.maximalIdeal ↥W, σ₂ w ∈ IsLocalRing.maximalIdeal P₂) → ∀ Z : P₂, (∀ p : Polynomial ↥W, (∃ i, p.coeff i ∉ IsLocalRing.maximalIdeal ↥W) → IsUnit (Polynomial.eval₂ σ₂ Z p)) → ∃ (H : Type u) (_ : CommRing H) (j : Polynomial ↥W →+* H) (ρ : H →+* P₂), wcNdIsHens (Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) H j ∧ IsLocalHom ρ ∧ Function.Injective ρ ∧ ρ.comp j = Polynomial.eval₂RingHom σ₂ Z ∧ ∀ η : H, ∃ p q : Polynomial ↥W, (∃ i, q.coeff i ∉ IsLocalRing.maximalIdeal ↥W) ∧ ¬ IsUnit (η * j q - j p) :=
by
  intro Ω _ W P₂ _ _ _ σ₂ hσinj hσmax Z hT
  classical
  set M : Ideal (Polynomial ↥W) := Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) with hM
  haveI hMprime : M.IsPrime := Ideal.isPrime_map_C_of_isPrime
  have hnotM : ∀ a : Polynomial ↥W, a ∉ M ↔ ∃ i, a.coeff i ∉ IsLocalRing.maximalIdeal ↥W := by
    intro a
    rw [hM, Ideal.mem_map_C_iff]
    push_neg
    rfl

  have hprim : ∀ p : Polynomial ↥W, p ≠ 0 → ∃ (δ : ↥W) (p₀ : Polynomial ↥W), δ ≠ 0 ∧
      p = Polynomial.C δ * p₀ ∧ ∃ i, p₀.coeff i ∉ IsLocalRing.maximalIdeal ↥W := by
    intro p hp
    have key : ∀ s : Finset ℕ, s.Nonempty → ∃ i₀ ∈ s, ∀ i ∈ s, p.coeff i₀ ∣ p.coeff i := by
      intro s hs
      induction hs using Finset.Nonempty.cons_induction with
      | singleton a => exact ⟨a, Finset.mem_singleton_self a, fun i hi => by
          rw [Finset.mem_singleton.mp hi]⟩
      | cons a s ha hs ih =>
        obtain ⟨b, hb, hbd⟩ := ih
        rcases ValuationRing.dvd_total (p.coeff a) (p.coeff b) with h | h
        · refine ⟨a, Finset.mem_cons_self a s, fun i hi => ?_⟩
          rcases Finset.mem_cons.mp hi with h' | h'
          · rw [h']
          · exact dvd_trans h (hbd i h')
        · refine ⟨b, Finset.mem_cons_of_mem hb, fun i hi => ?_⟩
          rcases Finset.mem_cons.mp hi with h' | h'
          · rw [h']; exact h
          · exact hbd i h'
    obtain ⟨i₀, hi₀, hdiv⟩ := key p.support (Polynomial.nonempty_support_iff.mpr hp)
    have hδ : p.coeff i₀ ≠ 0 := Polynomial.mem_support_iff.mp hi₀
    have hall : ∀ i, p.coeff i₀ ∣ p.coeff i := by
      intro i
      by_cases hi : i ∈ p.support
      · exact hdiv i hi
      · rw [Polynomial.notMem_support_iff.mp hi]; exact dvd_zero _
    obtain ⟨p₀, hp₀⟩ := (Polynomial.C_dvd_iff_dvd_coeff _ _).mpr hall
    refine ⟨p.coeff i₀, p₀, hδ, hp₀, i₀, ?_⟩
    have h1 : p.coeff i₀ * 1 = p.coeff i₀ * p₀.coeff i₀ := by
      rw [mul_one]
      conv_lhs => rw [hp₀]
      rw [Polynomial.coeff_C_mul]
    have h2 : p₀.coeff i₀ = 1 := (mul_left_cancel₀ hδ h1).symm
    rw [h2]
    exact IsLocalRing.notMem_maximalIdeal.mpr isUnit_one
  obtain ⟨H, instH, j, hj⟩ := wcNd_hens_exists (Polynomial ↥W) M hMprime
  set g : Polynomial ↥W →+* P₂ := Polynomial.eval₂RingHom σ₂ Z with hg
  have hunit : ∀ a : Polynomial ↥W, IsUnit (g a) ↔ a ∉ M := by
    intro a
    constructor
    · intro hu haM
      have hc : ∀ n, a.coeff n ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mem_map_C_iff.mp haM
      have hmem : g a ∈ IsLocalRing.maximalIdeal P₂ := by
        rw [hg, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_eq_sum_range]
        apply Ideal.sum_mem
        intro i _
        exact Ideal.mul_mem_right _ _ (hσmax _ (hc i))
      exact (IsLocalRing.mem_maximalIdeal _).mp hmem hu
    · intro haM
      exact hT a ((hnotM a).mp haM)
  obtain ⟨ρ, ⟨hρj, hρloc⟩, -⟩ := hj.2.2 P₂ inferInstance g hunit
  have hginj : Function.Injective g := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    by_contra hne
    obtain ⟨δ, p₀, hδ, hap, hp₀⟩ := hprim a hne
    have h1 : g a = σ₂ δ * g p₀ := by
      rw [hap, map_mul, hg, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
    have h2 : σ₂ δ ≠ 0 := fun h => hδ ((injective_iff_map_eq_zero σ₂).mp hσinj δ h)
    have h3 : g p₀ ≠ 0 := (hT p₀ hp₀).ne_zero
    exact mul_ne_zero h2 h3 (h1 ▸ ha)
  have hρinj : Function.Injective ρ :=
    (wcpa_dj_lr1k_ebnb_hens_inj (Polynomial ↥W) M hMprime H j hj).2 P₂ ρ (hρj ▸ hginj)
  refine ⟨H, instH, j, ρ, hj, hρloc, hρinj, hρj, fun η => ?_⟩
  obtain ⟨a, s, hs, hns⟩ := wcpa_dj_lr1k_ebc_dia_hens_residue (Polynomial ↥W) H M j hj η
  exact ⟨a, s, (hnotM s).mp hs, hns⟩

theorem wcLlsAS_gnerr_node_through_gauss : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (P : Type u) [CommRing P] (σ : ↥W →+* P) (g : ↥W) (f : wcEbntN W g →+* P), wcEbntPres W σ g f → ∀ (μ g' : ↥W), μ ∈ IsLocalRing.maximalIdeal ↥W → g' ∈ IsLocalRing.maximalIdeal ↥W → g = μ * g' → ∀ (H : Type u) [CommRing H] (j : Polynomial ↥W →+* H), wcNdIsHens (Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) H j → ∀ (P₂ : Type u) [CommRing P₂] [HenselianLocalRing P₂] (h : P →+* P₂) (ρ : H →+* P₂) (σ₂ : ↥W →+* P₂) (Z Zi : P₂), IsLocalHom h → IsLocalHom ρ → h.comp σ = σ₂ → ρ.comp j = Polynomial.eval₂RingHom σ₂ Z → Z * Zi = 1 → h (f (wcEbntX W g 0)) = σ₂ μ * Z → h (f (wcEbntX W g 1)) = σ₂ g' * Zi → ∀ F : P, h F ∈ ρ.range :=
by
  intro Ω _ W P _ σ g f hpres μ g' hμ hg' hgμ H _ j hH P₂ _ _ h ρ σ₂ Z Zi hh hρ hσ hρj hZ hx0 hx1 F
  haveI : HenselianLocalRing H := hH.1
  haveI := hh
  haveI := hρ
  have hρjX : ρ (j Polynomial.X) = Z := by
    have e := congrArg (fun k => k Polynomial.X) hρj
    simpa using e
  have hρjC : ∀ r : ↥W, ρ (j (Polynomial.C r)) = σ₂ r := by
    intro r
    have e := congrArg (fun k => k (Polynomial.C r)) hρj
    simpa using e
  have hu : IsUnit (j Polynomial.X) := by
    rw [← isUnit_map_iff ρ, hρjX]
    exact ⟨⟨Z, Zi, hZ, by rw [mul_comm]; exact hZ⟩, rfl⟩
  obtain ⟨τ, hXτ⟩ : ∃ τ : H, j Polynomial.X * τ = 1 := ⟨_, hu.mul_val_inv⟩
  have hρτ : ρ τ = Zi := by
    have h1 : Z * ρ τ = 1 := by rw [← hρjX, ← map_mul, hXτ, map_one]
    calc ρ τ = (Zi * Z) * ρ τ := by rw [mul_comm Zi Z, hZ, one_mul]
      _ = Zi * (Z * ρ τ) := by ring
      _ = Zi := by rw [h1, mul_one]
  let φ₀ : MvPolynomial (Fin 2) ↥W →+* H :=
    MvPolynomial.eval₂Hom (j.comp Polynomial.C)
      ![j (Polynomial.C μ * Polynomial.X), j (Polynomial.C g') * τ]
  have hφ₀C : ∀ r : ↥W, φ₀ (MvPolynomial.C r) = j (Polynomial.C r) := by
    intro r
    simp [φ₀]
  have hφ₀X0 : φ₀ (MvPolynomial.X 0) = j (Polynomial.C μ * Polynomial.X) := by
    simp [φ₀]
  have hφ₀X1 : φ₀ (MvPolynomial.X 1) = j (Polynomial.C g') * τ := by
    simp [φ₀]
  have hrel : φ₀ (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g) = 0 := by
    rw [map_sub, map_mul, hφ₀X0, hφ₀X1, hφ₀C, hgμ, Polynomial.C_mul]
    try simp only [map_mul]
    linear_combination (j (Polynomial.C μ) * j (Polynomial.C g')) * hXτ
  have hφ₀ : ∀ a ∈ Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g :
      MvPolynomial (Fin 2) ↥W)}, φ₀ a = 0 := by
    intro a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, hrel, mul_zero]
  let φ : wcEbntN W g →+* H := Ideal.Quotient.lift _ φ₀ hφ₀
  have hφmk : ∀ a, φ (Ideal.Quotient.mk _ a) = φ₀ a := fun a => Ideal.Quotient.lift_mk _ _ _
  have hcomp : h.comp f = ρ.comp φ := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro r
      show h (f (Ideal.Quotient.mk _ (MvPolynomial.C r))) =
        ρ (φ (Ideal.Quotient.mk _ (MvPolynomial.C r)))
      have e1 : f (Ideal.Quotient.mk _ (MvPolynomial.C r)) = σ r :=
        congrArg (fun k => k r) hpres.2.2.1
      rw [e1, hφmk, hφ₀C, hρjC, ← hσ, RingHom.comp_apply]
    · intro i
      fin_cases i
      · show h (f (wcEbntX W g 0)) = ρ (φ (Ideal.Quotient.mk _ (MvPolynomial.X 0)))
        rw [hx0, hφmk, hφ₀X0, map_mul, map_mul, hρjC, hρjX]
      · show h (f (wcEbntX W g 1)) = ρ (φ (Ideal.Quotient.mk _ (MvPolynomial.X 1)))
        rw [hx1, hφmk, hφ₀X1, map_mul, hρjC, hρτ]
  have hUf := hpres.2.2.2.2.1
  have hUρφ : ∀ a, IsUnit ((ρ.comp φ) a) ↔ IsUnit (f a) := by
    intro a
    rw [← hcomp, RingHom.comp_apply, isUnit_map_iff h]
  have hUφ : ∀ a, IsUnit (φ a) ↔ IsUnit (f a) := by
    intro a
    rw [← isUnit_map_iff ρ, ← RingHom.comp_apply ρ φ]
    exact hUρφ a
  obtain ⟨ψ, ⟨hψf, hψloc⟩, -⟩ :=
    hpres.2.2.2.2.2 H hH.1 φ (fun a => (hUφ a).trans (hUf a))
  have huniq := hpres.2.2.2.2.2 P₂ inferInstance (ρ.comp φ) (fun a => (hUρφ a).trans (hUf a))
  have heq : h = ρ.comp ψ := by
    haveI := hψloc
    exact huniq.unique ⟨hcomp, hh⟩
      ⟨by rw [RingHom.comp_assoc, hψf], RingHom.isLocalHom_comp ρ ψ⟩
  rw [heq]
  exact ⟨ψ F, rfl⟩

theorem wcLlsAS_gne_residue_radical : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y →
    Module.finrank K L = ℓ →
    ∀ c₀ b₀ c' b' e' : ↥W, c₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ∈ IsLocalRing.maximalIdeal ↥W →
      c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 → b' ≠ 0 →
      c' - c₀ = b₀ * e' → ¬ b' ∣ b₀ → wcLlsDiscSep W A K L t c' b' →
    ∀ (𝔓 : Ideal ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})) (𝔔 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L)),
      𝔓.IsPrime →
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})).comp (algebraMap ↥W A)) ≤ 𝔓 →
      𝔓 < Ideal.span {⟨wcLlsScS W A K t c₀ b₀, Algebra.subset_adjoin (Set.mem_singleton _)⟩ -
          algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) (algebraMap ↥W A 0)} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})).comp (algebraMap ↥W A)) →
      𝔔.IsPrime →
      𝔔.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L)) = 𝔓 →
