theorem wcLlsAS_dcc_gauss_not_etale : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y →
    Module.finrank K L = ℓ →
    ∀ c₀ b₀ c' b' e' : ↥W, c₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ∈ IsLocalRing.maximalIdeal ↥W →
      c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 → b' ≠ 0 →
      c' - c₀ = b₀ * e' → ¬ b' ∣ b₀ → wcLlsDiscSep W A K L t c' b' →
      ¬ wcLlsGaussEtale W A K L t c₀ b₀ :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hSolv hUniq hdeg
    c₀ b₀ c' b' e' hc₀ hb₀ hc' hb' hb₀0 hb'0 he' hnd hsep hG
  have hAlg : ∀ (R : Type u) [CommRing R] [Algebra R K] [Algebra R L] [IsScalarTower R K L]
        (𝔓 : Ideal R) (𝔔 : Ideal ↥(integralClosure R L)) (ψ₀ : ↥W →+* R),
        𝔔.IsPrime → 𝔔.comap (algebraMap R ↥(integralClosure R L)) = 𝔓 → wcLlsUniq R L 𝔓 𝔔 →
        ∀ (θ₁ θ₂ : ↥(integralClosure R L)) (n : ℕ) (r₁ r₂ : R),
          1 ≤ n → θ₁ ∉ 𝔔 → θ₂ ∉ 𝔔 → r₂ ∉ 𝔓 →
          algebraMap R ↥(integralClosure R L) r₂ * θ₁ ^ n -
            algebraMap R ↥(integralClosure R L) r₁ * θ₂ ^ n ∈ 𝔔 →
          (∀ x : ↥(integralClosure R L), ∃ (N : ℕ) (p d : ℕ → R),
            (∑ i ∈ Finset.range (N + 1),
              algebraMap R ↥(integralClosure R L) (d i) * θ₁ ^ i * θ₂ ^ (N - i)) ∉ 𝔔 ∧
