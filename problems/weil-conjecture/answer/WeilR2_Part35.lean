        _ = _ := by rw [hNj']; ring
    have hmain : c' ^ (k + 2) * Polynomial.aeval x (Polynomial.X ^ (k + 2) + P) = 0 := by
      have hev : Polynomial.aeval x (Polynomial.X ^ (k + 2) + P) = x ^ (k + 2) +
          (∑ j ∈ Finset.range (k + 1), algebraMap R L (a j) * x ^ (j + 1)
            - d' ^ (k + 1) * algebraMap R L e) := by
        rw [← hd']
        simp only [hP, map_add, map_sub, map_sum, map_mul, Polynomial.aeval_C,
          map_pow, Polynomial.aeval_X]
      rw [hev, mul_add, mul_sub, Finset.mul_sum, Finset.sum_congr rfl hterm]
      have hcxk : c' ^ (k + 2) * x ^ (k + 2) = d' ^ (k + 2) * y ^ (k + 2) := by
        rw [← mul_pow, hcx, mul_pow]
      have he : c' ^ (k + 2) * (d' ^ (k + 1) * algebraMap R L e) = d' ^ (k + 2) * (f - 1) := by
        calc _ = d' ^ (k + 1) * (c' ^ (k + 2) * algebraMap R L e) := by ring
          _ = d' ^ (k + 1) * (d' * (f - 1)) := by rw [h4]
          _ = _ := by ring
      rw [hcxk, he, hbin, mul_add, Finset.mul_sum]
      have hsw : ∀ j ∈ Finset.range (k + 1), ((k + 2).choose (j + 1) : L) * (d' ^ (k + 2) * y ^ (j + 1))
          = d' ^ (k + 2) * (((k + 2).choose (j + 1) : L) * y ^ (j + 1)) := fun j _ => by ring
      rw [Finset.sum_congr rfl hsw]
      ring
    have hcpow : c' ^ (k + 2) ≠ 0 := pow_ne_zero _ hc
    exact (mul_eq_zero.mp hmain).resolve_left hcpow
  · intro n
    rw [Polynomial.coeff_sub, Polynomial.coeff_derivative, Polynomial.coeff_C,
      Polynomial.coeff_add, Polynomial.coeff_X_pow, hP, Polynomial.coeff_sub,
      Polynomial.finset_sum_coeff, Polynomial.coeff_C, if_neg (Nat.succ_ne_zero n), sub_zero]
    simp only [Polynomial.coeff_C_mul_X_pow, Nat.add_right_cancel_iff]
    rw [Finset.sum_ite_eq]
    rcases Nat.lt_trichotomy n (k + 1) with hlt | heq | hgt
    · rw [if_neg (by omega), if_pos (Finset.mem_range.mpr hlt), zero_add]
      rcases n with _ | m
      · rw [if_pos rfl]
        simp only [ha, hN0]
        simp
      · rw [if_neg (Nat.succ_ne_zero m), sub_zero]
        refine Ideal.mem_span_pair.mpr ⟨(((k + 2).choose (m + 1 + 1) / (k + 2) : ℕ) : R) * η * c ^ m
          * d ^ (k + 1 - (m + 1)) * ((↑(m + 1) : R) + 1), 0, ?_⟩
        simp only [ha]
        ring
    · subst heq
      rw [if_pos rfl, if_neg (by simp), add_zero, if_neg (by omega), sub_zero, one_mul]
      have e1 : ((k + 1 : ℕ) : R) + 1 = ((k + 2 : ℕ) : R) := by push_cast; ring
      rw [e1]
      exact Ideal.subset_span (by simp)
    · rw [if_neg (by omega), if_neg (by simp; omega), if_neg (by omega)]
      simp

theorem wcpa_dj_llsm_kpwbe_minpoly_prime : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] (ℓ : ℕ), ℓ.Prime → Module.finrank K L = ℓ → ∀ (θ : L) (P : Polynomial A), θ ∉ Set.range (algebraMap K L) → P.Monic → P.natDegree = ℓ → Polynomial.aeval θ P = 0 → minpoly A θ = P ∧ Algebra.adjoin K {θ} = ⊤ :=
by
  intro A _ _ _ K _ _ _ L _ _ _ _ _ ℓ hℓ hfr θ P hθ hPm hPd hP
  have hint : IsIntegral A θ := ⟨P, hPm, by rwa [← Polynomial.aeval_def]⟩
  have hKA : minpoly K θ = Polynomial.map (algebraMap A K) (minpoly A θ) :=
    minpoly.isIntegrallyClosed_eq_field_fractions' K hint
  have hintK : IsIntegral K θ := IsIntegral.of_finite K θ
  have hdegK : (minpoly K θ).natDegree = ℓ := by
    have hd : (minpoly K θ).natDegree ∣ ℓ := hfr ▸ minpoly.degree_dvd hintK
    rcases hℓ.eq_one_or_self_of_dvd _ hd with h1 | h1
    · exfalso
      obtain ⟨k, hk⟩ := (minpoly.natDegree_eq_one_iff).mp h1
      exact hθ ⟨k, hk⟩
    · exact h1
  have hdvd : minpoly K θ ∣ P.map (algebraMap A K) := by
    apply minpoly.dvd
    rw [Polynomial.aeval_map_algebraMap]
    exact hP
  have hPK : P.map (algebraMap A K) = minpoly K θ := by
    apply Polynomial.eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hintK)
      (hPm.map (algebraMap A K)) hdvd
    rw [hPm.natDegree_map, hPd, hdegK]
  refine ⟨?_, ?_⟩
  · apply Polynomial.map_injective (algebraMap A K) (IsFractionRing.injective A K)
    rw [← hKA, hPK]
  · have htop : IntermediateField.adjoin K {θ} = ⊤ :=
      (Field.primitive_element_iff_minpoly_natDegree_eq K θ).mpr (by rw [hdegK, hfr])
    exact (IntermediateField.adjoin_simple_eq_top_iff_of_isAlgebraic hintK.isAlgebraic).mp htop

theorem wcpa_dj_llsm_kpwbe_residue_const : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω), IsAlgClosed (IsLocalRing.ResidueField ↥W) → ∀ (A : Type u) [CommRing A] [Algebra ↥W A] (B : Type u) [CommRing B] [Algebra A B] [Algebra.IsIntegral A B] (𝔭 : Ideal A) (y : Ideal B), Algebra.FiniteType ↥W A → 𝔭.IsMaximal → (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 → y.IsPrime → y.comap (algebraMap A B) = 𝔭 → ∀ x : B, ∃ r : ↥W, x - algebraMap A B (algebraMap ↥W A r) ∈ y :=
by
  intro Ω _ W hk A _ _ B _ _ _ 𝔭 y hft hmax hm𝔭 hy hyc x
  classical
  subst hyc

  have hφ : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      ((Ideal.Quotient.mk (y.comap (algebraMap A B))).comp (algebraMap ↥W A)) w = 0 := by
    intro w hw
    rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
    exact hm𝔭 (Ideal.mem_map_of_mem _ hw)
  obtain ⟨ψ, hψφ⟩ : ∃ ψ : IsLocalRing.ResidueField ↥W →+* A ⧸ y.comap (algebraMap A B),
      ψ.comp (IsLocalRing.residue ↥W) =
        (Ideal.Quotient.mk (y.comap (algebraMap A B))).comp (algebraMap ↥W A) :=
    ⟨Ideal.Quotient.lift (IsLocalRing.maximalIdeal ↥W) _ hφ,
      RingHom.ext fun w => Ideal.Quotient.lift_mk (IsLocalRing.maximalIdeal ↥W) (a := w)
        ((Ideal.Quotient.mk (y.comap (algebraMap A B))).comp (algebraMap ↥W A)) hφ⟩

  have hψft : ψ.FiniteType := by
    have h1 : (algebraMap ↥W A).FiniteType := RingHom.finiteType_algebraMap.mpr hft
    have h2 : (Ideal.Quotient.mk (y.comap (algebraMap A B))).FiniteType :=
      RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective
    have h3 := h2.comp h1
    rw [← hψφ] at h3
    exact RingHom.FiniteType.of_comp_finiteType h3

  have hψint : ψ.IsIntegral := by
    letI : Field (A ⧸ y.comap (algebraMap A B)) := Ideal.Quotient.field _
    letI : Algebra (IsLocalRing.ResidueField ↥W) (A ⧸ y.comap (algebraMap A B)) := ψ.toAlgebra
    haveI : Algebra.FiniteType (IsLocalRing.ResidueField ↥W) (A ⧸ y.comap (algebraMap A B)) :=
      hψft
    haveI : Module.Finite (IsLocalRing.ResidueField ↥W) (A ⧸ y.comap (algebraMap A B)) :=
      finite_of_finite_type_of_isJacobsonRing _ _
    haveI : Algebra.IsIntegral (IsLocalRing.ResidueField ↥W) (A ⧸ y.comap (algebraMap A B)) :=
      Algebra.IsIntegral.of_finite _ _
    exact fun z => Algebra.IsIntegral.isIntegral z

  have H : y.comap (algebraMap A B) ≤ y.comap (algebraMap A B) := le_rfl
  have hχint : (Ideal.quotientMap y (algebraMap A B) H).IsIntegral :=
    RingHom.IsIntegral.quotient (algebraMap A B) (fun b => Algebra.IsIntegral.isIntegral b)

  have hτint : ((Ideal.quotientMap y (algebraMap A B) H).comp ψ).IsIntegral :=
    RingHom.IsIntegral.trans _ _ hψint hχint
  have hτsurj : Function.Surjective ((Ideal.quotientMap y (algebraMap A B) H).comp ψ) := by
    letI : Algebra (IsLocalRing.ResidueField ↥W) (B ⧸ y) :=
      ((Ideal.quotientMap y (algebraMap A B) H).comp ψ).toAlgebra
    haveI : Algebra.IsIntegral (IsLocalRing.ResidueField ↥W) (B ⧸ y) := ⟨hτint⟩
    exact (IsAlgClosed.algebraMap_bijective_of_isIntegral).2

  obtain ⟨ρ, hρ⟩ := hτsurj (Ideal.Quotient.mk y x)
  obtain ⟨r, hr⟩ := IsLocalRing.residue_surjective ρ
  have key : ((Ideal.quotientMap y (algebraMap A B) H).comp ψ) (IsLocalRing.residue ↥W r) =
      Ideal.Quotient.mk y (algebraMap A B (algebraMap ↥W A r)) := by
    rw [RingHom.comp_apply, ← RingHom.comp_apply ψ, hψφ, RingHom.comp_apply,
      Ideal.quotientMap_mk]
  refine ⟨r, ?_⟩
  rw [← Ideal.Quotient.eq, ← key, hr, hρ]

theorem wcpa_dj_llsm_kpwbe_local_node : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g : ↥W) (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.ann u v g) → y.IsPrime → y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → ∀ θ : ↥(integralClosure A L), θ ∈ y → Algebra.adjoin K {(θ : L)} = ⊤ → (∀ z : ↥(integralClosure A L), (z : L) = Polynomial.aeval (θ : L) (Polynomial.derivative (minpoly A (θ : L))) → z ∉ y) → ∀ (_ : y.IsPrime), ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) :=
by
  intro Ω _ W A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g y hPD hyp hyc θ' hθy hKθ hz hyp'
  classical
  obtain ⟨-, -, hic, hmax, hm𝔭, hg, hg0, huv, h𝔭eq, h₀, hh₀, f₀, hfC, hfu, hfv, hfet⟩ := hPD
  haveI := hic
  haveI := hyp
  have hθint : IsIntegral A (θ' : L) := θ'.2

  have hle : Algebra.adjoin A {(θ' : L)} ≤ integralClosure A L :=
    Algebra.adjoin_le (Set.singleton_subset_iff.mpr θ'.2)
  letI : Algebra ↥W ↥(Algebra.adjoin A {(θ' : L)}) :=
    ((algebraMap A ↥(Algebra.adjoin A {(θ' : L)})).comp (algebraMap ↥W A)).toAlgebra
  have hθC : Subalgebra.inclusion hle
      (⟨(θ' : L), Algebra.self_mem_adjoin_singleton A _⟩ : ↥(Algebra.adjoin A {(θ' : L)})) = θ' :=
    Subtype.ext rfl
  have hθCY : (⟨(θ' : L), Algebra.self_mem_adjoin_singleton A _⟩ : ↥(Algebra.adjoin A {(θ' : L)}))
      ∈ y.comap (Subalgebra.inclusion hle) := by
    rw [Ideal.mem_comap, hθC]; exact hθy
  set d : ↥(Algebra.adjoin A {(θ' : L)}) :=
    Polynomial.aeval (⟨(θ' : L), Algebra.self_mem_adjoin_singleton A _⟩ :
      ↥(Algebra.adjoin A {(θ' : L)})) (Polynomial.derivative (minpoly A (θ' : L))) with hd
  set e : ↥(Algebra.adjoin A {(θ' : L)}) :=
    Polynomial.aeval (⟨(θ' : L), Algebra.self_mem_adjoin_singleton A _⟩ :
      ↥(Algebra.adjoin A {(θ' : L)})) (Polynomial.divX (minpoly A (θ' : L))) with he
  have hdL : (d : L) = Polynomial.aeval (θ' : L) (Polynomial.derivative (minpoly A (θ' : L))) :=
    Polynomial.aeval_subalgebra_coe _ _ _

  have hdy : Subalgebra.inclusion hle d ∉ y := by
    apply hz
    rw [Subalgebra.coe_inclusion, hdL]
  have hdY : d ∉ y.comap (Subalgebra.inclusion hle) := by
    rw [Ideal.mem_comap]; exact hdy

  have hcond : ∀ x : ↥(integralClosure A L), (d : L) * (x : L) ∈ Algebra.adjoin A {(θ' : L)} := by
    intro x
    rw [hdL]
    exact wcpa_dj_llsm_brsp_conductor A K L (θ' : L) hθint hKθ x x.2
  obtain ⟨eFS⟩ := wcpa_dj_llsm_brsp_fs_transport W A L (Algebra.adjoin A {(θ' : L)}) hle rfl d
    hcond y hdy

  have h0 : Polynomial.aeval (⟨(θ' : L), Algebra.self_mem_adjoin_singleton A _⟩ :
      ↥(Algebra.adjoin A {(θ' : L)})) (minpoly A (θ' : L)) = 0 := by
    apply Subtype.ext
    rw [Polynomial.aeval_subalgebra_coe]
    simp [minpoly.aeval]
  have hsplit := Polynomial.divX_mul_X_add (minpoly A (θ' : L))
  have h1 : (⟨(θ' : L), Algebra.self_mem_adjoin_singleton A _⟩ : ↥(Algebra.adjoin A {(θ' : L)})) * e
      = algebraMap A ↥(Algebra.adjoin A {(θ' : L)}) (-(minpoly A (θ' : L)).coeff 0) := by
    have h2 : Polynomial.aeval (⟨(θ' : L), Algebra.self_mem_adjoin_singleton A _⟩ :
        ↥(Algebra.adjoin A {(θ' : L)})) ((minpoly A (θ' : L)).divX * Polynomial.X +
          Polynomial.C ((minpoly A (θ' : L)).coeff 0)) = 0 := by
      rw [hsplit]; exact h0
    rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, ← he] at h2
    rw [map_neg, eq_neg_iff_add_eq_zero, mul_comm]
    exact h2
  have h3 : d = Polynomial.aeval (⟨(θ' : L), Algebra.self_mem_adjoin_singleton A _⟩ :
      ↥(Algebra.adjoin A {(θ' : L)})) (Polynomial.derivative (minpoly A (θ' : L)).divX) *
        (⟨(θ' : L), Algebra.self_mem_adjoin_singleton A _⟩ : ↥(Algebra.adjoin A {(θ' : L)})) + e := by
    have h4 : Polynomial.derivative (minpoly A (θ' : L)) =
        Polynomial.derivative ((minpoly A (θ' : L)).divX * Polynomial.X +
          Polynomial.C ((minpoly A (θ' : L)).coeff 0)) := by rw [hsplit]
    rw [hd, he, h4, Polynomial.derivative_add, Polynomial.derivative_mul, Polynomial.derivative_X,
      Polynomial.derivative_C, mul_one, add_zero, map_add, map_mul, Polynomial.aeval_X]
  have heY : e ∉ y.comap (Subalgebra.inclusion hle) := by
    intro heY
    apply hdY
    rw [h3]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hθCY) heY

  have hYc : (y.comap (Subalgebra.inclusion hle)).comap
      (algebraMap A ↥(Algebra.adjoin A {(θ' : L)})) = 𝔭 := by
    ext a
    rw [Ideal.mem_comap, Ideal.mem_comap, AlgHom.commutes, ← hyc, Ideal.mem_comap]
  have hhY : algebraMap A ↥(Algebra.adjoin A {(θ' : L)}) h₀ ∉ y.comap (Subalgebra.inclusion hle) := by
    intro hh
    apply hh₀
    rw [← hYc, Ideal.mem_comap]
    exact hh

  have hzY : algebraMap A ↥(Algebra.adjoin A {(θ' : L)}) h₀ * (d * e) ∉
      y.comap (Subalgebra.inclusion hle) := by
    intro hz
    rcases Ideal.IsPrime.mem_or_mem inferInstance hz with h | h
    · exact hhY h
    · rcases Ideal.IsPrime.mem_or_mem inferInstance h with h' | h'
      · exact hdY h'
      · exact heY h'

  have hinj : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)
  have hEt := wcpa_dj_llsm_brsp_standard_etale A L hinj (θ' : L) hθint
    (algebraMap A ↥(Algebra.adjoin A {(θ' : L)}) h₀ * (d * e))
    ⟨algebraMap A ↥(Algebra.adjoin A {(θ' : L)}) h₀ * e, by rw [← hd]; ring⟩
  obtain ⟨φ, hφ, hφet⟩ := wcpa_dj_llsm_brsp_chart_compose A ↥(Algebra.adjoin A {(θ' : L)})
    (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
    (algebraMap A ↥(Algebra.adjoin A {(θ' : L)})) h₀ (d * e) f₀ hfet hEt

  have hnode := wcpa_dj_llsm_brsp_node_ideal W A L (θ' : L) rfl
    (y.comap (Subalgebra.inclusion hle)) 𝔭 u v (-(minpoly A (θ' : L)).coeff 0) e
    (algebraMap A ↥(Algebra.adjoin A {(θ' : L)}) h₀ * (d * e)) hθCY hYc h𝔭eq h1
    ⟨algebraMap A ↥(Algebra.adjoin A {(θ' : L)}) h₀ * d, by ring⟩

  have hmC : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W ↥(Algebra.adjoin A {(θ' : L)})) ≤
      y.comap (Subalgebra.inclusion hle) := by
    rw [Ideal.map_le_iff_le_comap]
    intro w hw
    rw [Ideal.mem_comap]
    show algebraMap A ↥(Algebra.adjoin A {(θ' : L)}) (algebraMap ↥W A w) ∈
      y.comap (Subalgebra.inclusion hle)
    rw [← Ideal.mem_comap, hYc]
    exact hm𝔭 (Ideal.mem_map_of_mem _ hw)
  have hnb := wcpa_dj_llsm_brsp_node_not_bad W ↥(Algebra.adjoin A {(θ' : L)})
    (y.comap (Subalgebra.inclusion hle)) g (algebraMap A _ u) (algebraMap A _ v)
    (algebraMap A ↥(Algebra.adjoin A {(θ' : L)}) h₀ * (d * e)) hg hzY hmC (φ.comp f₀)
    (by rw [RingHom.comp_assoc, hfC, ← RingHom.comp_assoc, hφ, RingHom.comp_assoc]; rfl)
    (by show φ (f₀ _) = _; rw [hfu]; exact RingHom.congr_fun hφ u)
    (by show φ (f₀ _) = _; rw [hfv]; exact RingHom.congr_fun hφ v)
    hφet hnode

  obtain ⟨hδ, hbr⟩ := wcpa_dj_lr1k_llfi_ringequiv
    (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y)
    (Localization.AtPrime (y.comap (Subalgebra.inclusion hle)) ⧸
      ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W ↥(Algebra.adjoin A {(θ' : L)}))).map
        (algebraMap ↥(Algebra.adjoin A {(θ' : L)})
          (Localization.AtPrime (y.comap (Subalgebra.inclusion hle))))) eFS
  intro hbad
  apply hnb
  unfold wcpaDjLkBad at hbad ⊢
  rw [← hδ, ← hbr]
  exact hbad

theorem wcpa_dj_llsm_kpwb_etale_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
      [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    ∀ b₀ : ↥W, wcLlsPD W A 𝔭 (.ann u v g) → b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 →
    b₀ ∣ g → Module.finrank K L = ℓ →
    ∀ (θ' : L) (f' : K), θ' ∉ Set.range (algebraMap K L) → θ' ^ ℓ = algebraMap K L f' →
    ∀ (c η : ↥W), c ≠ 0 → IsUnit η → c ^ (ℓ - 1) * η = ((ℓ : ℕ) : ↥W) →
    ∀ d e : ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u}),
    d ∉ (Ideal.span {algebraMap A ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u}) u,
        ⟨algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u,
          Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A
        {algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u})).comp (algebraMap ↥W A))) →
    (d : K) * (f' - 1) = algebraMap A K (algebraMap ↥W A c) ^ ℓ * (e : K) →
    wcLlsAnnSep W A K L u b₀ :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g b₀ hPD hb₀m hb₀0
    hb₀g hfr θ' f' hθ' hθ'f c η hc0 hη hcη d e hd hde
  classical

  obtain ⟨hft, hnzd, hic, hmax, hm𝔭, hgm, hg0, huv, h𝔭eq, -⟩ := id hPD
  haveI := hnzd
  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    have h1 : w • (1 : A) = 0 := by rw [Algebra.smul_def, hw, zero_mul]
    rcases smul_eq_zero.mp h1 with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hinjAK := IsFractionRing.injective A K
  have hû : algebraMap A K u ≠ 0 := by
    intro h
    have hu0 : u = 0 := hinjAK (by rw [h, map_zero])
    apply hg0
    apply hWA
    rw [map_zero, ← huv, hu0, zero_mul]
  have hℓm : ((ℓ : ℕ) : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [← IsLocalRing.residue_eq_zero_iff, map_natCast, ← hκ]
    exact ringChar.Nat.cast_ringChar
  have hcm : c ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hc
    have hcu : IsUnit c := by
      by_contra h'
      exact hc ((IsLocalRing.mem_maximalIdeal c).mpr (mem_nonunits_iff.mpr h'))
    have hℓu : IsUnit ((ℓ : ℕ) : ↥W) := hcη ▸ (hcu.pow _).mul hη
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hℓm) hℓu

  obtain ⟨A', iCR, iDom, iWA, iAK, iFr, iAL, iTow, u', v', 𝔭', hBr, hu', hv', hPD', hSep, -, -⟩ :=
    wcpa_dj_llsm_br_boundary_chart Ω W hW hWt A K L 𝔭 (.ann u v g) u b₀ hPD
      (Or.inr ⟨v, g, rfl, hb₀g⟩) hb₀m hb₀0
  obtain ⟨hft', hnzd', hic', hmax', hm𝔭', -, -, -, h𝔭'eq, -⟩ := id hPD'

  show wcLlsSepAt W A K L u (algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u)
  rw [hSep b₀ hb₀m hb₀0 (dvd_refl b₀)]
  apply wcpa_dj_llsm_br_ann_node_sep Ω W hW hWt A' K L 𝔭' u' v' b₀ hPD'
  intro y hy hyc hy'

  obtain ⟨hBrW, hBrS, -⟩ := id hBr
  obtain ⟨d', hd'⟩ := hBrS d.2
  obtain ⟨e', he'⟩ := hBrS e.2
  have hd'𝔭 : d' ∉ 𝔭' := wcpa_dj_llsm_kpwbe_node_transfer W A K A' 𝔭 u v g b₀ u' v' 𝔭' hPD
    hb₀g hû (IsFractionRing.injective A' K) hBr hu' hv' h𝔭'eq hmax'.ne_top d d' hd hd'
  have hd'0 : d' ≠ 0 := fun h => hd'𝔭 (h ▸ 𝔭'.zero_mem)

  have hcηA : (algebraMap ↥W A' c) ^ (ℓ - 1) * algebraMap ↥W A' η = ((ℓ : ℕ) : A') := by
    rw [← map_pow, ← map_mul, hcη, map_natCast]
  have hAKL : ∀ x : A', algebraMap A' L x = algebraMap K L (algebraMap A' K x) :=
    fun x => IsScalarTower.algebraMap_apply A' K L x
  have hĉ : algebraMap A' K (algebraMap ↥W A' c) = algebraMap A K (algebraMap ↥W A c) := hBrW c
  have hcK0 : algebraMap A K (algebraMap ↥W A c) ≠ 0 := by
    intro h
    apply hc0
    apply hWA
    rw [map_zero]
    exact hinjAK (by rw [h, map_zero])
  have hcL0 : algebraMap A' L (algebraMap ↥W A' c) ≠ 0 := by
    rw [hAKL, hĉ]; exact (map_ne_zero _).mpr hcK0
  have hdeL : algebraMap A' L d' * (algebraMap K L f' - 1) =
      algebraMap A' L (algebraMap ↥W A' c) ^ ℓ * algebraMap A' L e' := by
    have h1 := congrArg (algebraMap K L) hde
    simp only [map_mul, map_sub, map_one, map_pow] at h1
    rw [hAKL, hAKL, hAKL, hd', he', hĉ]
    exact h1

  obtain ⟨Q, hQm, hQd, hQx, hQ'⟩ := wcpa_dj_llsm_kpwbe_kummer_poly A' L ℓ hℓ
    (algebraMap ↥W A' c) (algebraMap ↥W A' η) d' e' θ' (algebraMap K L f') hcL0 hcηA hθ'f hdeL
  obtain ⟨x, hxdef⟩ : ∃ x : L,
      x = algebraMap A' L d' * (θ' - 1) / algebraMap A' L (algebraMap ↥W A' c) := ⟨_, rfl⟩
  rw [← hxdef] at hQx
  have hxint : IsIntegral A' x := ⟨Q, hQm, by rw [← Polynomial.aeval_def]; exact hQx⟩
  obtain ⟨xB, hxB⟩ : ∃ xB : ↥(integralClosure A' L), (xB : L) = x :=
    ⟨⟨x, (mem_integralClosure_iff A' L).mpr hxint⟩, rfl⟩

  have hdL0 : algebraMap A' L d' ≠ 0 := by
    rw [hAKL]
    exact (map_ne_zero _).mpr
      (fun h => hd'0 ((IsFractionRing.injective A' K) (by rw [h, map_zero])))
  have hxK : x ∉ Set.range (algebraMap K L) := by
    rintro ⟨k, hk⟩
    apply hθ'
    refine ⟨1 + algebraMap A' K (algebraMap ↥W A' c) * k / algebraMap A' K d', ?_⟩
    rw [map_add, map_one, map_div₀, map_mul, hk, ← hAKL, ← hAKL, hxdef]
    field_simp
    ring

  obtain ⟨r, hr⟩ := wcpa_dj_llsm_kpwbe_residue_const Ω W (wcpa_dj_nc_residue_algclosed Ω W) A'
    ↥(integralClosure A' L) 𝔭' y hft' hmax' hm𝔭' hy hyc xB
  obtain ⟨ϑB, hϑBdef⟩ : ∃ z : ↥(integralClosure A' L),
      z = xB - algebraMap A' ↥(integralClosure A' L) (algebraMap ↥W A' r) := ⟨_, rfl⟩
  have hϑy : ϑB ∈ y := hϑBdef ▸ hr
  have hϑval : (ϑB : L) = x - algebraMap A' L (algebraMap ↥W A' r) := by
    rw [hϑBdef, ← hxB]; rfl

  have hPm : (Q.comp (Polynomial.X + Polynomial.C (algebraMap ↥W A' r))).Monic :=
    hQm.comp_X_add_C _
  have hPd : (Q.comp (Polynomial.X + Polynomial.C (algebraMap ↥W A' r))).natDegree = ℓ := by
    rw [Polynomial.natDegree_comp, Polynomial.natDegree_X_add_C, mul_one, hQd]
  have hPϑ : Polynomial.aeval (ϑB : L)
      (Q.comp (Polynomial.X + Polynomial.C (algebraMap ↥W A' r))) = 0 := by
    rw [Polynomial.aeval_comp, map_add, Polynomial.aeval_X, Polynomial.aeval_C, hϑval,
      sub_add_cancel]
    exact hQx
  have hϑK : (ϑB : L) ∉ Set.range (algebraMap K L) := by
    rintro ⟨k, hk⟩
    apply hxK
    refine ⟨k + algebraMap A' K (algebraMap ↥W A' r), ?_⟩
    rw [map_add, hk, hϑval, ← hAKL, sub_add_cancel]
  haveI := hic'
  obtain ⟨hmin, hKϑ⟩ := wcpa_dj_llsm_kpwbe_minpoly_prime A' K L ℓ hℓ hfr (ϑB : L) _ hϑK hPm hPd hPϑ

  have hIle : Ideal.span {algebraMap ↥W A' c, ((ℓ : ℕ) : A')} ≤
      y.comap (algebraMap A' ↥(integralClosure A' L)) := by
    rw [hyc, Ideal.span_le]
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl
    · exact hm𝔭' (Ideal.mem_map_of_mem _ hcm)
    · have h1 : ((ℓ : ℕ) : A') = algebraMap ↥W A' ((ℓ : ℕ) : ↥W) := (map_natCast _ _).symm
      rw [h1]
      exact hm𝔭' (Ideal.mem_map_of_mem _ hℓm)
  have ha : algebraMap A' ↥(integralClosure A' L) (algebraMap ↥W A' η * d' ^ (ℓ - 1)) ∉ y := by
    intro h
    have h' : algebraMap ↥W A' η * d' ^ (ℓ - 1) ∈ 𝔭' := by rw [← hyc]; exact h
    rcases hmax'.isPrime.mem_or_mem h' with h1 | h1
    · exact hmax'.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 (hη.map _))
    · exact hd'𝔭 (hmax'.isPrime.mem_of_pow_mem _ h1)
  have hQ'y : Polynomial.aeval xB (Polynomial.derivative Q) ∉ y := by
    have hD : Polynomial.aeval xB (Polynomial.derivative Q -
        Polynomial.C (algebraMap ↥W A' η * d' ^ (ℓ - 1))) ∈ y := by
      rw [Polynomial.aeval_eq_sum_range]
      apply Ideal.sum_mem
      intro n _
      rw [Algebra.smul_def]
      exact Ideal.mul_mem_right _ _ (hIle (hQ' n))
    intro hmem
    apply ha
    have h2 := y.sub_mem hmem hD
    rwa [map_sub, Polynomial.aeval_C, sub_sub_cancel] at h2

  have hz : ∀ z : ↥(integralClosure A' L), (z : L) =
      Polynomial.aeval (ϑB : L) (Polynomial.derivative (minpoly A' (ϑB : L))) → z ∉ y := by
    intro z hzv hzy
    apply hQ'y
    have h1 : (z : L) =
        ((Polynomial.aeval xB (Polynomial.derivative Q) : ↥(integralClosure A' L)) : L) := by
      rw [hzv, hmin, Polynomial.derivative_comp, Polynomial.derivative_X_add_C, one_mul,
        Polynomial.aeval_comp, map_add, Polynomial.aeval_X, Polynomial.aeval_C, hϑval,
        sub_add_cancel, Polynomial.aeval_subalgebra_coe, hxB]
    rw [← Subtype.ext h1]
    exact hzy

  exact wcpa_dj_llsm_kpwbe_local_node Ω W A' K L 𝔭' u' v' b₀ y hPD' hy hyc ϑB hϑy hKϑ hz hy'

theorem wcpa_dj_llsm_kpwicn_constants : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (p : ℕ) (c ρ : ↥W), p.Prime → c ≠ 0 →
    c ^ (p * (p - 1)) * ρ = ((p : ℕ) : ↥W) ^ p → ∀ i : ℕ, 0 < i → i < p →
    ∃ γ : ↥W, ((p.choose i : ℕ) : ↥W) = γ * c ^ (p - i) :=
by
  intro Ω _ W p c ρ hp _hc h i hi0 hip
  have hdvd : ((p : ℕ) : ↥W) ∣ ((p.choose i : ℕ) : ↥W) :=
    Nat.cast_dvd_cast (hp.dvd_choose_self hi0.ne' hip)
  have key : c ^ (p - 1) ∣ ((p : ℕ) : ↥W) := by
    rcases ValuationRing.dvd_total (c ^ (p - 1)) ((p : ℕ) : ↥W) with h1 | ⟨t, ht⟩
    · exact h1
    · by_cases hp0 : ((p : ℕ) : ↥W) = 0
      · rw [hp0]; exact dvd_zero _
      · have hc' : c ^ (p * (p - 1)) = ((p : ℕ) : ↥W) ^ p * t ^ p := by
          rw [pow_mul', ht, mul_pow]
        have e : ((p : ℕ) : ↥W) ^ p * (t ^ p * ρ) = ((p : ℕ) : ↥W) ^ p * 1 := by
          calc ((p : ℕ) : ↥W) ^ p * (t ^ p * ρ) = c ^ (p * (p - 1)) * ρ := by rw [hc']; ring
            _ = ((p : ℕ) : ↥W) ^ p * 1 := by rw [h, mul_one]
        have h2 := mul_left_cancel₀ (pow_ne_zero p hp0) e
        have htu : IsUnit t := IsUnit.of_mul_eq_one (t ^ (p - 1) * ρ) (by
          rw [← mul_assoc, ← pow_succ', Nat.sub_add_cancel hp.one_le]; exact h2)
        have h3 : c ^ (p - 1) ∣ ((p : ℕ) : ↥W) * t := ⟨1, by rw [mul_one, ht]⟩
        exact htu.dvd_mul_right.mp h3
  obtain ⟨γ, hγ⟩ : c ^ (p - i) ∣ ((p.choose i : ℕ) : ↥W) :=
    (pow_dvd_pow c (by omega : p - i ≤ p - 1)).trans (key.trans hdvd)
  exact ⟨γ, by rw [hγ, mul_comm]⟩

theorem wcpa_dj_llsm_kpwicn_coords : ∀ (A : Type u) [CommRing A] [IsDomain A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K]
    (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] (p n a k : ℕ) (θ : L) (F : K)
    (c d e U V β : A) (γ : ℕ → A), p.Prime → θ ∉ Set.range (algebraMap K L) → θ ^ p = algebraMap K L F →
    c ≠ 0 → U ≠ 0 → k * p = 1 + a * n → a < p → U * V = β ^ p →
    (∀ i, 0 < i → i < p → ((p.choose i : ℕ) : A) = γ i * c ^ (p - i)) →
    algebraMap A K d * (F - 1) * algebraMap A K U ^ n = algebraMap A K c ^ p * algebraMap A K e →
    ∃ (s x z ρ ρ' T t₁ : L), s ≠ 0 ∧ s * (θ - 1) = algebraMap A L c ∧ ρ * ρ' = 1 ∧
      x ^ p * ρ ^ a = algebraMap A L U ∧ x ^ n * ρ ^ k = s ∧ x * z = algebraMap A L β ∧
      z ^ p = algebraMap A L V * ρ ^ a ∧
      algebraMap A L e * ρ = algebraMap A L d *
        (1 + ∑ i ∈ Finset.Ioo 0 p, algebraMap A L (γ i) * s ^ (p - i)) ∧
      T = algebraMap A L e * s ∧
      T ^ p = algebraMap A L (U ^ n * d) * (algebraMap A L e ^ (p - 1) +
        ∑ i ∈ Finset.Ioo 0 p, algebraMap A L (γ i) * algebraMap A L e ^ (i - 1) * T ^ (p - i)) ∧
      t₁ = algebraMap A L d * (algebraMap A L e ^ (p - 1) +
        ∑ i ∈ Finset.Ioo 0 p, algebraMap A L (γ i) * algebraMap A L e ^ (i - 1) * T ^ (p - i)) ∧
      t₁ = algebraMap A L e ^ p * ρ ∧
      (t₁ * x) ^ p = algebraMap A L U * t₁ ^ (p - a) * algebraMap A L e ^ (p * a) ∧
      (algebraMap A L e ^ p * z) ^ p = algebraMap A L V * algebraMap A L e ^ (p * (p - a)) * t₁ ^ a :=
by
  intro A _ _ K _ _ _ L _ _ _ _ p n a k θ F c d e U V β γ hp hθ hθp hc hU hkp hap hUV hγ hK
  have hp0 : 0 < p := hp.pos
  have core : ∀ (c' d' e' U' V' β' F' : L) (γ' : ℕ → L), c' ≠ 0 → U' ≠ 0 → U' * V' = β' ^ p →
      θ ^ p = F' →
      (∀ i, 0 < i → i < p → ((p.choose i : ℕ) : L) = γ' i * c' ^ (p - i)) →
      d' * (F' - 1) * U' ^ n = c' ^ p * e' →
      ∃ (s x z ρ ρ' T t₁ : L), s ≠ 0 ∧ s * (θ - 1) = c' ∧ ρ * ρ' = 1 ∧
        x ^ p * ρ ^ a = U' ∧ x ^ n * ρ ^ k = s ∧ x * z = β' ∧
        z ^ p = V' * ρ ^ a ∧
        e' * ρ = d' * (1 + ∑ i ∈ Finset.Ioo 0 p, γ' i * s ^ (p - i)) ∧
        T = e' * s ∧
        T ^ p = U' ^ n * d' * (e' ^ (p - 1) +
          ∑ i ∈ Finset.Ioo 0 p, γ' i * e' ^ (i - 1) * T ^ (p - i)) ∧
        t₁ = d' * (e' ^ (p - 1) + ∑ i ∈ Finset.Ioo 0 p, γ' i * e' ^ (i - 1) * T ^ (p - i)) ∧
        t₁ = e' ^ p * ρ ∧
        (t₁ * x) ^ p = U' * t₁ ^ (p - a) * e' ^ (p * a) ∧
        (e' ^ p * z) ^ p = V' * e' ^ (p * (p - a)) * t₁ ^ a := by
    intro c' d' e' U' V' β' F' γ' hc hU hUV hθF hγ hK
    have hθ1 : θ - 1 ≠ 0 := by
      intro h
      apply hθ
      refine ⟨1, ?_⟩
      rw [map_one]
      exact (sub_eq_zero.mp h).symm
    obtain ⟨s, hsdef⟩ : ∃ s : L, s = c' / (θ - 1) := ⟨_, rfl⟩
    have hs : s * (θ - 1) = c' := by rw [hsdef]; exact div_mul_cancel₀ c' hθ1
    have hs0 : s ≠ 0 := by rw [hsdef]; exact div_ne_zero hc hθ1

    have hbin : (s + c') ^ p = s ^ p + c' ^ p * (1 + ∑ i ∈ Finset.Ioo 0 p, γ' i * s ^ (p - i)) := by
      have hmid : ∑ m ∈ Finset.Ico (0 + 1) p, c' ^ m * s ^ (p - m) * (p.choose m : L) =
          c' ^ p * ∑ i ∈ Finset.Ioo 0 p, γ' i * s ^ (p - i) := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr (by ext i; simp only [Finset.mem_Ico, Finset.mem_Ioo]; omega)
        intro i hi
        rw [Finset.mem_Ioo] at hi
        rw [hγ i hi.1 hi.2, ← pow_mul_pow_sub c' hi.2.le]
        ring
      rw [add_comm, add_pow, Finset.sum_range_succ, Finset.range_eq_Ico,
        Finset.sum_eq_sum_Ico_succ_bot hp0, hmid, Nat.choose_self, Nat.choose_zero_right,
        Nat.sub_self, Nat.sub_zero]
      simp only [pow_zero, Nat.cast_one]
      ring
    have hsθ : (s + c') ^ p = s ^ p * F' := by
      rw [← hs]
      have : s + s * (θ - 1) = s * θ := by ring
      rw [this, mul_pow, hθF]
    have hF : s ^ p * (F' - 1) = c' ^ p * (1 + ∑ i ∈ Finset.Ioo 0 p, γ' i * s ^ (p - i)) := by
      linear_combination hbin - hsθ
    have hes : e' * s ^ p = d' * U' ^ n * (1 + ∑ i ∈ Finset.Ioo 0 p, γ' i * s ^ (p - i)) := by
      apply mul_left_cancel₀ (pow_ne_zero p hc)
      linear_combination (-s ^ p) * hK + d' * U' ^ n * hF
    obtain ⟨ρ, hρdef⟩ : ∃ ρ : L, ρ = s ^ p / U' ^ n := ⟨_, rfl⟩
    have hρ0 : ρ ≠ 0 := by rw [hρdef]; exact div_ne_zero (pow_ne_zero _ hs0) (pow_ne_zero _ hU)
    have hρ : s ^ p = U' ^ n * ρ := by
      rw [hρdef]; field_simp
    have heρ : e' * ρ = d' * (1 + ∑ i ∈ Finset.Ioo 0 p, γ' i * s ^ (p - i)) := by
      apply mul_left_cancel₀ (pow_ne_zero n hU)
      linear_combination hes - e' * hρ
    obtain ⟨x, hxdef⟩ : ∃ x : L, x = U' ^ k / s ^ a := ⟨_, rfl⟩
    have hx0 : x ≠ 0 := by rw [hxdef]; exact div_ne_zero (pow_ne_zero _ hU) (pow_ne_zero _ hs0)
    have hxρ : x ^ p * ρ ^ a = U' := by
      rw [hxdef, hρdef, div_pow, div_pow, ← pow_mul, ← pow_mul, ← pow_mul, ← pow_mul, hkp,
        mul_comm a p, mul_comm n a, pow_add, pow_one]
      field_simp
    have hxρ2 : x ^ n * ρ ^ k = s := by
      rw [hxdef, hρdef, div_pow, div_pow, ← pow_mul, ← pow_mul, ← pow_mul, ← pow_mul,
        mul_comm p k, hkp, mul_comm n k, pow_add, pow_one]
      field_simp
    obtain ⟨z, hzdef⟩ : ∃ z : L, z = β' / x := ⟨_, rfl⟩
    have hxz : x * z = β' := by rw [hzdef]; field_simp
    have hzp : z ^ p = V' * ρ ^ a := by
      apply mul_left_cancel₀ (pow_ne_zero p hx0)
      rw [← mul_pow, hxz, ← hUV]
      linear_combination (-V') * hxρ
    have hS : e' ^ (p - 1) + ∑ i ∈ Finset.Ioo 0 p, γ' i * e' ^ (i - 1) * (e' * s) ^ (p - i) =
        e' ^ (p - 1) * (1 + ∑ i ∈ Finset.Ioo 0 p, γ' i * s ^ (p - i)) := by
      rw [mul_add, mul_one, Finset.mul_sum]
      congr 1
      apply Finset.sum_congr rfl
      intro i hi
      rw [Finset.mem_Ioo] at hi
      have : e' ^ (p - 1) = e' ^ (i - 1) * e' ^ (p - i) := by
        rw [← pow_add]; congr 1; omega
      rw [mul_pow, this]
      ring
    have ht1 : d' * (e' ^ (p - 1) + ∑ i ∈ Finset.Ioo 0 p, γ' i * e' ^ (i - 1) * (e' * s) ^ (p - i)) =
        e' ^ p * ρ := by
      rw [hS]
      have : e' ^ p = e' ^ (p - 1) * e' := by
        rw [← pow_succ]; congr 1; omega
      rw [this]
      linear_combination (-e' ^ (p - 1)) * heρ
    refine ⟨s, x, z, ρ, ρ⁻¹, e' * s, d' * (e' ^ (p - 1) +
      ∑ i ∈ Finset.Ioo 0 p, γ' i * e' ^ (i - 1) * (e' * s) ^ (p - i)), hs0, hs,
      mul_inv_cancel₀ hρ0, hxρ, hxρ2, hxz, hzp, heρ, rfl, ?_, rfl, ht1, ?_, ?_⟩
    · rw [mul_assoc, ht1, mul_pow, hρ]
      ring
    · rw [ht1, pow_mul, ← hxρ]
      have key : ∀ (E r y : L) (m j : ℕ),
          (E * r * y) ^ (m + j) = (y ^ (m + j) * r ^ j) * (E * r) ^ m * E ^ j := by
        intros; ring
      have := key (e' ^ p) ρ x (p - a) a
      rw [Nat.sub_add_cancel hap.le] at this
      exact this
    · rw [ht1, mul_pow, hzp, pow_mul e' p (p - a)]
      have key2 : ∀ (E W r : L) (m j : ℕ),
          E ^ (m + j) * (W * r ^ j) = W * E ^ m * (E * r) ^ j := by
        intros; ring
      have := key2 (e' ^ p) V' ρ (p - a) a
      rw [Nat.sub_add_cancel hap.le] at this
      exact this
  have hinj : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)
  have hc' : algebraMap A L c ≠ 0 := fun h => hc (hinj (by rw [h, map_zero]))
  have hU' : algebraMap A L U ≠ 0 := fun h => hU (hinj (by rw [h, map_zero]))
  have hUV' : algebraMap A L U * algebraMap A L V = algebraMap A L β ^ p := by
    rw [← map_mul, ← map_pow, hUV]
  have hγ' : ∀ i, 0 < i → i < p →
      ((p.choose i : ℕ) : L) = algebraMap A L (γ i) * algebraMap A L c ^ (p - i) := by
    intro i h1 h2
    rw [← map_pow, ← map_mul, ← hγ i h1 h2, map_natCast]
  have hK' : algebraMap A L d * (algebraMap K L F - 1) * algebraMap A L U ^ n =
      algebraMap A L c ^ p * algebraMap A L e := by
    have := congrArg (algebraMap K L) hK
    simp only [map_mul, map_sub, map_one, map_pow, ← IsScalarTower.algebraMap_apply] at this
    exact this
  obtain ⟨s, x, z, ρ, ρ', T, t₁, h⟩ := core (algebraMap A L c) (algebraMap A L d)
    (algebraMap A L e) (algebraMap A L U) (algebraMap A L V) (algebraMap A L β) (algebraMap K L F)
    (fun i => algebraMap A L (γ i)) hc' hU' hUV' hθp hγ' hK'
  refine ⟨s, x, z, ρ, ρ', T, t₁, ?_⟩
  simpa only [map_mul, map_pow] using h

theorem wcpa_dj_llsm_kpwicn_transcendental : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (K : Type u) [Field K] (L : Type u) [Field L]
    [Algebra K L] [FiniteDimensional K L] (j : Ω →+* K) (p a k n : ℕ), p.Prime → Module.finrank K L = p →
    0 < a → a < p → 0 < n → ∀ (θ s x ρ : L) (c U : K), θ ∉ Set.range (algebraMap K L) → c ≠ 0 → ρ ≠ 0 →
    s * (θ - 1) = algebraMap K L c → x ^ p * ρ ^ a = algebraMap K L U → x ^ n * ρ ^ k = s →
    ∀ P : Polynomial Ω, P.eval₂ ((algebraMap K L).comp j) x = 0 → P = 0 :=
by
  intro Ω _ _ K _ L _ _ _ j p a k n hp hfin ha hap hn θ s x ρ c U hθ hc _hρ hs hU hx P hP
  by_contra hP0

  obtain ⟨r, hr⟩ : ∃ r : Ω, algebraMap K L (j r) = x := by
    have hfac := Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C
      (IsAlgClosed.card_roots_eq_natDegree (k := Ω) (p := P))
    rw [← hfac, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_multiset_prod,
      Multiset.map_map] at hP
    have hlc : ((algebraMap K L).comp j) P.leadingCoeff ≠ 0 := by
      rw [map_ne_zero]
      exact Polynomial.leadingCoeff_ne_zero.mpr hP0
    have hprod := (mul_eq_zero.mp hP).resolve_left hlc
    rw [Multiset.prod_eq_zero_iff, Multiset.mem_map] at hprod
    obtain ⟨r, _, hr⟩ := hprod
    refine ⟨r, ?_⟩
    simp only [Function.comp_apply, Polynomial.eval₂_sub, Polynomial.eval₂_X,
      Polynomial.eval₂_C, RingHom.coe_comp] at hr
    exact (sub_eq_zero.mp hr).symm

  have hs0 : s ≠ 0 := by
    rintro rfl
    rw [zero_mul, eq_comm, map_eq_zero] at hs
    exact hc hs
  have hx0 : x ≠ 0 := by
    rintro rfl
    rw [zero_pow hn.ne', zero_mul] at hx
    exact hs0 hx.symm

  have hρa : ρ ^ a = algebraMap K L (U / (j r) ^ p) := by
    rw [map_div₀, map_pow, hr, ← hU]
    exact (mul_div_cancel_left₀ _ (pow_ne_zero _ hx0)).symm
  obtain ⟨ρ₀, hρ₀⟩ : ∃ ρ₀ : K, algebraMap K L ρ₀ = ρ := by
    have hint : IsIntegral K ρ := IsIntegral.of_finite K ρ
    have hQ0 : (Polynomial.X ^ a - Polynomial.C (U / (j r) ^ p) : Polynomial K) ≠ 0 :=
      Polynomial.X_pow_sub_C_ne_zero ha _
    have hQdeg : (Polynomial.X ^ a - Polynomial.C (U / (j r) ^ p) : Polynomial K).natDegree = a :=
      Polynomial.natDegree_X_pow_sub_C
    have hQρ : Polynomial.aeval ρ (Polynomial.X ^ a - Polynomial.C (U / (j r) ^ p) :
        Polynomial K) = 0 := by
      rw [map_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C, hρa, sub_self]
    have hdvd := minpoly.dvd K ρ hQρ
    have hle : (minpoly K ρ).natDegree ≤ a := hQdeg ▸ Polynomial.natDegree_le_of_dvd hdvd hQ0
    have hdp : (minpoly K ρ).natDegree ∣ p := hfin ▸ minpoly.degree_dvd hint
    rcases hp.eq_one_or_self_of_dvd _ hdp with h1 | h1
    · exact RingHom.mem_range.mp (minpoly.natDegree_eq_one_iff.mp h1)
    · omega

  apply hθ
  refine ⟨1 + c / ((j r) ^ n * ρ₀ ^ k), ?_⟩
  have hs' : algebraMap K L ((j r) ^ n * ρ₀ ^ k) = s := by
    rw [map_mul, map_pow, map_pow, hr, hρ₀, hx]
  rw [map_add, map_one, map_div₀, hs', ← hs, mul_div_cancel_left₀ _ hs0]
  ring

theorem wcpa_dj_llsm_kpwicnec_present : ∀ (S₀ S B : Type u) [CommRing S₀] [CommRing S] [CommRing B] [Algebra S B] (q : S₀ →+* S), Function.Surjective q → ∀ (r₀ : ℕ) (f : Fin r₀ → MvPolynomial (Fin r₀) S) (val : Fin r₀ → B), Function.Surjective (MvPolynomial.aeval (R := S) val) → RingHom.ker (MvPolynomial.aeval (R := S) val) = Ideal.span (Set.range f) → (∃ g : MvPolynomial (Fin r₀) S, g * (Matrix.of fun a b => MvPolynomial.pderiv a (f b)).det - 1 ∈ Ideal.span (Set.range f)) → ∀ b₁ b₂ : B, ∃ (F : Fin r₀ → MvPolynomial (Fin r₀) S₀) (e₁ e₂ : MvPolynomial (Fin r₀) S₀), (∀ (P : Type u) [CommRing P] (χ : B →+* P), (∀ j, MvPolynomial.eval₂ ((χ.comp (algebraMap S B)).comp q) (fun i => χ (val i)) (F j) = 0) ∧ IsUnit (MvPolynomial.eval₂ ((χ.comp (algebraMap S B)).comp q) (fun i => χ (val i)) (Matrix.of fun i j => MvPolynomial.pderiv i (F j)).det) ∧ MvPolynomial.eval₂ ((χ.comp (algebraMap S B)).comp q) (fun i => χ (val i)) e₁ = χ b₁ ∧ MvPolynomial.eval₂ ((χ.comp (algebraMap S B)).comp q) (fun i => χ (val i)) e₂ = χ b₂) ∧ (∀ (P : Type u) [CommRing P] (μ : S →+* P) (t : Fin r₀ → P), (∀ j, MvPolynomial.eval₂ (μ.comp q) t (F j) = 0) → ∃ χ : B →+* P, χ.comp (algebraMap S B) = μ ∧ ∀ i, χ (val i) = t i) ∧ (∀ (P : Type u) [CommRing P] (χ₁ χ₂ : B →+* P), χ₁.comp (algebraMap S B) = χ₂.comp (algebraMap S B) → (∀ i, χ₁ (val i) = χ₂ (val i)) → χ₁ = χ₂) :=
by
  intro S₀ S B _ _ _ _ q hq r₀ f val hsurj hker hg b₁ b₂
  obtain ⟨g, hg⟩ := hg
  have hmapS : Function.Surjective (MvPolynomial.map (σ := Fin r₀) q) :=
    MvPolynomial.map_surjective q hq
  choose F hF using fun j => hmapS (f j)
  obtain ⟨E₁, hE₁⟩ := hsurj b₁
  obtain ⟨E₂, hE₂⟩ := hsurj b₂
  obtain ⟨e₁, he₁⟩ := hmapS E₁
  obtain ⟨e₂, he₂⟩ := hmapS E₂
  have htr : ∀ (P : Type u) [CommRing P] (χ : B →+* P) (H : MvPolynomial (Fin r₀) S₀),
      MvPolynomial.eval₂ ((χ.comp (algebraMap S B)).comp q) (fun i => χ (val i)) H
        = χ (MvPolynomial.aeval (R := S) val (MvPolynomial.map q H)) := by
    intro P _ χ H
    rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_comp_left, MvPolynomial.eval₂_map]
    rfl
  have hfker : ∀ j, MvPolynomial.aeval (R := S) val (f j) = 0 := by
    intro j
    have h : f j ∈ RingHom.ker (MvPolynomial.aeval (R := S) val) := by
      rw [hker]; exact Ideal.subset_span ⟨j, rfl⟩
    exact h
  have hjac : MvPolynomial.map q (Matrix.of fun i j => MvPolynomial.pderiv i (F j)).det
      = (Matrix.of fun a b => MvPolynomial.pderiv a (f b)).det := by
    rw [RingHom.map_det, RingHom.mapMatrix_apply]
    congr 1
    refine Matrix.ext fun i j => ?_
    rw [Matrix.map_apply, Matrix.of_apply, Matrix.of_apply, ← MvPolynomial.pderiv_map, hF]
  have hunit : IsUnit (MvPolynomial.aeval (R := S) val
      (Matrix.of fun a b => MvPolynomial.pderiv a (f b)).det) := by
    have h0 : g * (Matrix.of fun a b => MvPolynomial.pderiv a (f b)).det - 1 ∈
        RingHom.ker (MvPolynomial.aeval (R := S) val) := by
      rw [hker]; exact hg
    rw [RingHom.mem_ker, map_sub, map_mul, map_one, sub_eq_zero] at h0
    exact IsUnit.of_mul_eq_one _ (by rw [mul_comm]; exact h0)
  refine ⟨F, e₁, e₂, ?_, ?_, ?_⟩
  · intro P _ χ
    refine ⟨fun j => ?_, ?_, ?_, ?_⟩
    · rw [htr, hF, hfker, map_zero]
    · rw [htr, hjac]; exact hunit.map χ
    · rw [htr, he₁, hE₁]
    · rw [htr, he₂, hE₂]
  · intro P _ μ t ht
    let ψ : MvPolynomial (Fin r₀) S →+* B := (MvPolynomial.aeval (R := S) val).toRingHom
    have hψ : Function.Surjective ψ := hsurj
    let Φ : MvPolynomial (Fin r₀) S →+* P := MvPolynomial.eval₂Hom μ t
    have hk : RingHom.ker ψ ≤ RingHom.ker Φ := by
      have h : RingHom.ker ψ = Ideal.span (Set.range f) := hker
      rw [h, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker, ← hF j]
      show MvPolynomial.eval₂ μ t (MvPolynomial.map q (F j)) = 0
      rw [MvPolynomial.eval₂_map]; exact ht j
    refine ⟨ψ.liftOfSurjective hψ ⟨Φ, hk⟩, ?_, ?_⟩
    · ext s
      have h : algebraMap S B s = ψ (MvPolynomial.C s) := (MvPolynomial.aeval_C val s).symm
      rw [RingHom.comp_apply, h, RingHom.liftOfSurjective_comp_apply]
      exact MvPolynomial.eval₂Hom_C μ t s
    · intro i
      have h : val i = ψ (MvPolynomial.X i) := (MvPolynomial.aeval_X val i).symm
      rw [h, RingHom.liftOfSurjective_comp_apply]
      exact MvPolynomial.eval₂Hom_X' μ t i
  · intro P _ χ₁ χ₂ h₁ h₂
    ext b
    obtain ⟨x, rfl⟩ := hsurj b
    induction x using MvPolynomial.induction_on with
    | C s => simpa [MvPolynomial.aeval_C] using RingHom.congr_fun h₁ s
    | add p p' hp hp' => simp only [map_add, hp, hp']
    | mul_X p i hp => simp only [map_mul, MvPolynomial.aeval_X, hp, h₂ i]

theorem wcpa_dj_llsm_kpwicnec_ext_etale : ∀ (N : Type u) [CommRing N] {κ : Type} [Fintype κ] [DecidableEq κ] (f : κ → MvPolynomial κ N), Algebra.Etale N (MvPolynomial (κ ⊕ Unit) N ⧸ Ideal.span (Set.range (Sum.elim (fun j => MvPolynomial.rename Sum.inl (f j)) (fun _ : Unit => MvPolynomial.X (Sum.inr ()) * MvPolynomial.rename Sum.inl (Matrix.of fun i j => MvPolynomial.pderiv i (f j)).det - 1)))) :=
by

  have s0 : ∀ (A : Type u) [CommRing A] {ι σ : Type} [Fintype ι] [Fintype σ] [DecidableEq σ]
      (mp : σ → ι), Function.Bijective mp → ∀ (f : σ → MvPolynomial ι A) (g : MvPolynomial ι A),
      g * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j)).det - 1 ∈ Ideal.span (Set.range f) →
      Algebra.Etale A (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) := by
    intro A _ ι σ _ _ _ mp hbij f g hg
    let P : Algebra.PreSubmersivePresentation A (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) ι σ :=
      { Algebra.Presentation.naive (v := f) with map := mp, map_inj := hbij.1 }
    have hJ : P.jacobiMatrix = Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j) := by
      ext i j
      rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      rfl
    have halg : ∀ x : MvPolynomial ι A,
        algebraMap P.Ring (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) x =
          Ideal.Quotient.mk (Ideal.span (Set.range f)) x := fun x => rfl
    have hunit : IsUnit P.jacobian := by
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, hJ, halg]
      have h1 : Ideal.Quotient.mk (Ideal.span (Set.range f))
          (g * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j)).det) = 1 := by
        rw [← map_one (Ideal.Quotient.mk (Ideal.span (Set.range f))), Ideal.Quotient.eq]
        exact hg
      rw [map_mul, mul_comm] at h1
      exact IsUnit.of_mul_eq_one _ h1
    let Q : Algebra.SubmersivePresentation A (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) ι σ :=
      { P with jacobian_isUnit := hunit }
    have hdim : Q.dimension = 0 := by
      show Nat.card ι - Nat.card σ = 0
      rw [Nat.card_eq_of_bijective mp hbij, Nat.sub_self]
    have := Q.isStandardSmoothOfRelativeDimension hdim
    infer_instance
  intro N _ κ _ _ f

  have s1 : ∀ p : MvPolynomial κ N,
      MvPolynomial.pderiv (Sum.inr () : κ ⊕ Unit) (MvPolynomial.rename Sum.inl p) = 0 := by
    intro p
    apply MvPolynomial.pderiv_eq_zero_of_notMem_vars
    intro h
    obtain ⟨i, -, hi⟩ := MvPolynomial.mem_vars_rename _ _ h
    exact Sum.inl_ne_inr hi
  set D : MvPolynomial κ N := (Matrix.of fun i j => MvPolynomial.pderiv i (f j)).det with hD
  set fe : κ ⊕ Unit → MvPolynomial (κ ⊕ Unit) N := Sum.elim (fun j => MvPolynomial.rename Sum.inl (f j))
    (fun _ : Unit => MvPolynomial.X (Sum.inr ()) * MvPolynomial.rename Sum.inl D - 1) with hfe

  have s2 : (Matrix.of fun i j => MvPolynomial.pderiv (id i) (fe j)).det =
      MvPolynomial.rename Sum.inl D * MvPolynomial.rename Sum.inl D := by
    set Je : Matrix (κ ⊕ Unit) (κ ⊕ Unit) (MvPolynomial (κ ⊕ Unit) N) :=
      Matrix.of fun i j => MvPolynomial.pderiv (id i) (fe j) with hJe
    have h21 : Je.toBlocks₂₁ = 0 := by
      refine Matrix.ext fun a j => ?_
      simp only [Matrix.toBlocks₂₁, Matrix.of_apply, hJe, id, hfe, Sum.elim_inl, Matrix.zero_apply]
      exact s1 (f j)
    have h11 : Je.toBlocks₁₁ = (Matrix.of fun i j => MvPolynomial.pderiv i (f j)).map
        (MvPolynomial.rename Sum.inl) := by
      refine Matrix.ext fun i j => ?_
      simp only [Matrix.toBlocks₁₁, Matrix.of_apply, hJe, id, hfe, Sum.elim_inl, Matrix.map_apply]
      exact MvPolynomial.pderiv_rename Sum.inl_injective _ _
    have h22 : Je.toBlocks₂₂ () () = MvPolynomial.rename Sum.inl D := by
      simp only [Matrix.toBlocks₂₂, Matrix.of_apply, hJe, id, hfe, Sum.elim_inr]
      rw [map_sub, Derivation.leibniz, MvPolynomial.pderiv_X_self, s1, Derivation.map_one_eq_zero]
      simp
    rw [← Matrix.fromBlocks_toBlocks Je, h21, Matrix.det_fromBlocks_zero₂₁, h11, Matrix.det_unique Je.toBlocks₂₂]
    show _ * Je.toBlocks₂₂ () () = _
    rw [h22]
    congr 1
    rw [hD]
    exact (AlgHom.map_det (MvPolynomial.rename Sum.inl) _).symm
  refine s0 N (id : κ ⊕ Unit → κ ⊕ Unit) Function.bijective_id fe (MvPolynomial.X (Sum.inr ()) ^ 2) ?_
  rw [s2]
  have hmem : fe (Sum.inr ()) ∈ Ideal.span (Set.range fe) := Ideal.subset_span ⟨Sum.inr (), rfl⟩
  have heq : MvPolynomial.X (Sum.inr ()) ^ 2 * (MvPolynomial.rename Sum.inl D * MvPolynomial.rename Sum.inl D) - 1
      = fe (Sum.inr ()) * (MvPolynomial.X (Sum.inr ()) * MvPolynomial.rename Sum.inl D + 1) := by
    simp only [hfe, Sum.elim_inr]
    ring
  rw [heq]
  exact Ideal.mul_mem_right _ _ hmem

theorem wcpa_dj_llsm_kpwicnec_ext_lift : ∀ (N : Type u) [CommRing N] {κ : Type} [Fintype κ] [DecidableEq κ] (f : κ → MvPolynomial κ N) (P : Type u) [CommRing P] (ν : N →+* P) (t : κ → P), (∀ j, MvPolynomial.eval₂ ν t (f j) = 0) → IsUnit (MvPolynomial.eval₂ ν t (Matrix.of fun i j => MvPolynomial.pderiv i (f j)).det) → ∃ Φ : (MvPolynomial (κ ⊕ Unit) N ⧸ Ideal.span (Set.range (Sum.elim (fun j => MvPolynomial.rename Sum.inl (f j)) (fun _ : Unit => MvPolynomial.X (Sum.inr ()) * MvPolynomial.rename Sum.inl (Matrix.of fun i j => MvPolynomial.pderiv i (f j)).det - 1)))) →+* P, (∀ n : N, Φ (Ideal.Quotient.mk _ (MvPolynomial.C n)) = ν n) ∧ ∀ i : κ, Φ (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl i))) = t i :=
by
  intro N _ κ _ _ f P _ ν t hf hD
  obtain ⟨s, hs⟩ := hD.exists_left_inv
  refine ⟨Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom ν (Sum.elim t fun _ => s)) ?_, ?_, ?_⟩
  · intro a ha
    refine (RingHom.mem_ker).mp (Ideal.span_le.mpr ?_ ha)
    rintro _ ⟨x, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    rcases x with j | ⟨⟩
    · simp only [Sum.elim_inl, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_rename,
        Sum.elim_comp_inl]
      exact hf j
    · simp only [Sum.elim_inr, map_sub, map_mul, map_one, MvPolynomial.eval₂Hom_X',
        MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_rename, Sum.elim_comp_inl]
      rw [hs, sub_self]
  · intro n
    rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
  · intro i
    rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X', Sum.elim_inl]

theorem wcpa_dj_llsm_kpwicnec_jacobian : ∀ (R₁ N : Type u) [CommRing R₁] [CommRing N] {τ : Type} [Fintype τ] [DecidableEq τ] (c₀ : R₁ →+* N) (x₀ z₀ : N) (p a n k : ℕ) (γ : ℕ → N) (F : τ → MvPolynomial τ (MvPolynomial (Fin 2) R₁)) (e₁ e₂ : MvPolynomial τ (MvPolynomial (Fin 2) R₁)) (lam : MvPolynomial (Fin 2) R₁ →+* MvPolynomial (τ ⊕ Fin 2) N) (tw : MvPolynomial τ (MvPolynomial (Fin 2) R₁) →+* MvPolynomial (τ ⊕ Fin 2) N) (fam : τ ⊕ Fin 2 → MvPolynomial (τ ⊕ Fin 2) N), 0 < p → 0 < n → lam = MvPolynomial.eval₂Hom ((MvPolynomial.C : N →+* MvPolynomial (τ ⊕ Fin 2) N).comp c₀) ![MvPolynomial.C z₀ ^ p * MvPolynomial.X (Sum.inr 1) ^ a, MvPolynomial.C x₀ ^ p * MvPolynomial.X (Sum.inr 0) ^ a] → tw = MvPolynomial.eval₂Hom lam (fun i => MvPolynomial.X (Sum.inl i)) → fam = Sum.elim (fun j => tw (F j)) ![MvPolynomial.X (Sum.inr 0) * MvPolynomial.X (Sum.inr 1) - 1, tw e₁ * MvPolynomial.X (Sum.inr 0) - tw e₂ * (1 + ∑ i ∈ Finset.Ioo 0 p, MvPolynomial.C (γ i) * (MvPolynomial.C x₀ ^ n * (MvPolynomial.X (Sum.inr 0) : MvPolynomial (τ ⊕ Fin 2) N) ^ k) ^ (p - i))] → (Matrix.of fun i j => MvPolynomial.pderiv i (fam j)).det - tw (Matrix.of fun i j => MvPolynomial.pderiv i (F j)).det * (-(MvPolynomial.X (Sum.inr 0) * tw e₁)) ∈ Ideal.span {(MvPolynomial.C x₀ : MvPolynomial (τ ⊕ Fin 2) N), MvPolynomial.C z₀} :=
by
  intro R₁ N _ _ τ _ _ c₀ x₀ z₀ p a n k γ F e₁ e₂ lam tw fam hp hn hlam htw hfam
  set J : Ideal (MvPolynomial (τ ⊕ Fin 2) N) :=
    Ideal.span {(MvPolynomial.C x₀ : MvPolynomial (τ ⊕ Fin 2) N), MvPolynomial.C z₀} with hJ
  have hx : (MvPolynomial.C x₀ : MvPolynomial (τ ⊕ Fin 2) N) ∈ J :=
    Ideal.subset_span (by simp)
  have hz : (MvPolynomial.C z₀ : MvPolynomial (τ ⊕ Fin 2) N) ∈ J :=
    Ideal.subset_span (by simp)
  have hCX : ∀ (y : N) (q m : ℕ) (w v : τ ⊕ Fin 2),
      MvPolynomial.pderiv v ((MvPolynomial.C y : MvPolynomial (τ ⊕ Fin 2) N) ^ q *
        MvPolynomial.X w ^ m) = MvPolynomial.C y ^ q * MvPolynomial.pderiv v (MvPolynomial.X w ^ m) := by
    intro y q m w v
    rw [← map_pow, MvPolynomial.pderiv_C_mul]
  have hXpow : ∀ (m : ℕ) (w v : τ ⊕ Fin 2), w ≠ v →
      MvPolynomial.pderiv v ((MvPolynomial.X w : MvPolynomial (τ ⊕ Fin 2) N) ^ m) = 0 := by
    intro m w v hwv
    rw [Derivation.leibniz_pow, MvPolynomial.pderiv_X_of_ne hwv, smul_zero, smul_zero]

  have hlamC : ∀ w, lam (MvPolynomial.C w) = MvPolynomial.C (c₀ w) := by
    intro w; rw [hlam, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
  have hlam0 : lam (MvPolynomial.X 0) =
      MvPolynomial.C z₀ ^ p * MvPolynomial.X (Sum.inr 1) ^ a := by
    rw [hlam, MvPolynomial.eval₂Hom_X']; rfl
  have hlam1 : lam (MvPolynomial.X 1) =
      MvPolynomial.C x₀ ^ p * MvPolynomial.X (Sum.inr 0) ^ a := by
    rw [hlam, MvPolynomial.eval₂Hom_X']; rfl
  have hLX : ∀ (s : Fin 2) (i : τ), MvPolynomial.pderiv (Sum.inl i) (lam (MvPolynomial.X s)) = 0 := by
    refine Fin.forall_fin_two.mpr ⟨fun i => ?_, fun i => ?_⟩
    · rw [hlam0, hCX, hXpow _ _ _ Sum.inr_ne_inl, mul_zero]
    · rw [hlam1, hCX, hXpow _ _ _ Sum.inr_ne_inl, mul_zero]
  have hRX : ∀ (s b : Fin 2), MvPolynomial.pderiv (Sum.inr b) (lam (MvPolynomial.X s)) ∈ J := by
    refine Fin.forall_fin_two.mpr ⟨fun b => ?_, fun b => ?_⟩
    · rw [hlam0, hCX]; exact J.mul_mem_right _ (J.pow_mem_of_mem hz p hp)
    · rw [hlam1, hCX]; exact J.mul_mem_right _ (J.pow_mem_of_mem hx p hp)
  have hL : ∀ (c : MvPolynomial (Fin 2) R₁) (i : τ),
      MvPolynomial.pderiv (Sum.inl i) (lam c) = 0 := by
    intro c i
    induction c using MvPolynomial.induction_on
    · rename_i w; rw [hlamC, MvPolynomial.pderiv_C]
    · rename_i f g hf hg; rw [map_add, map_add, hf, hg, add_zero]
    · rename_i f s hf
      rw [map_mul, Derivation.leibniz, hf, hLX, smul_zero, smul_zero, add_zero]
  have hR : ∀ (c : MvPolynomial (Fin 2) R₁) (b : Fin 2),
      MvPolynomial.pderiv (Sum.inr b) (lam c) ∈ J := by
    intro c b
    induction c using MvPolynomial.induction_on
    · rename_i w; rw [hlamC, MvPolynomial.pderiv_C]; exact J.zero_mem
    · rename_i f g hf hg; rw [map_add, map_add]; exact J.add_mem hf hg
    · rename_i f s hf
      rw [map_mul, Derivation.leibniz, smul_eq_mul, smul_eq_mul]
      exact J.add_mem (J.mul_mem_left _ (hRX s b)) (J.mul_mem_left _ hf)

  have htwC : ∀ c, tw (MvPolynomial.C c) = lam c := by
    intro c; rw [htw, MvPolynomial.eval₂Hom_C]
  have htwX : ∀ i, tw (MvPolynomial.X i) = MvPolynomial.X (Sum.inl i) := by
    intro i; rw [htw, MvPolynomial.eval₂Hom_X']
  have h1 : ∀ (H : MvPolynomial τ (MvPolynomial (Fin 2) R₁)) (i : τ),
      MvPolynomial.pderiv (Sum.inl i) (tw H) = tw (MvPolynomial.pderiv i H) := by
    intro H i
    induction H using MvPolynomial.induction_on
    · rename_i c; rw [htwC, hL, MvPolynomial.pderiv_C, map_zero]
    · rename_i f g hf hg; rw [map_add, map_add, map_add, map_add, hf, hg]
    · rename_i f j hf
      rw [map_mul, Derivation.leibniz, Derivation.leibniz, smul_eq_mul, smul_eq_mul, smul_eq_mul,
        smul_eq_mul, map_add, map_mul, map_mul, htwX, hf]
      by_cases hij : j = i
      · subst hij
        rw [MvPolynomial.pderiv_X_self, MvPolynomial.pderiv_X_self, map_one]
      · have hij' : (Sum.inl j : τ ⊕ Fin 2) ≠ Sum.inl i := fun h => hij (Sum.inl_injective h)
        rw [MvPolynomial.pderiv_X_of_ne hij, MvPolynomial.pderiv_X_of_ne hij', map_zero]
  have h2 : ∀ (H : MvPolynomial τ (MvPolynomial (Fin 2) R₁)) (b : Fin 2),
      MvPolynomial.pderiv (Sum.inr b) (tw H) ∈ J := by
    intro H b
    induction H using MvPolynomial.induction_on
    · rename_i c; rw [htwC]; exact hR c b
    · rename_i f g hf hg; rw [map_add, map_add]; exact J.add_mem hf hg
    · rename_i f j hf
      rw [map_mul, Derivation.leibniz, htwX, MvPolynomial.pderiv_X_of_ne Sum.inl_ne_inr,
        smul_zero, zero_add, smul_eq_mul]
      exact J.mul_mem_left _ hf
  have h5 : ∀ v : τ ⊕ Fin 2, MvPolynomial.pderiv v (1 + ∑ i ∈ Finset.Ioo 0 p,
      MvPolynomial.C (γ i) * (MvPolynomial.C x₀ ^ n *
        (MvPolynomial.X (Sum.inr 0) : MvPolynomial (τ ⊕ Fin 2) N) ^ k) ^ (p - i)) ∈ J := by
    intro v
    have hY : MvPolynomial.pderiv v (MvPolynomial.C x₀ ^ n *
        (MvPolynomial.X (Sum.inr 0) : MvPolynomial (τ ⊕ Fin 2) N) ^ k) ∈ J := by
      rw [hCX]; exact J.mul_mem_right _ (J.pow_mem_of_mem hx n hn)
    rw [map_add, Derivation.map_one_eq_zero, zero_add, map_sum]
    refine J.sum_mem (fun i _ => ?_)
    rw [MvPolynomial.pderiv_C_mul, Derivation.leibniz_pow, smul_eq_mul]
    exact J.mul_mem_left _ (nsmul_mem (J.mul_mem_left _ hY) _)
  have hdet : ∀ (M M' : Matrix (τ ⊕ Fin 2) (τ ⊕ Fin 2) (MvPolynomial (τ ⊕ Fin 2) N)),
      (∀ i j, M i j - M' i j ∈ J) → M.det - M'.det ∈ J := by
    intro M M' h
    rw [← Ideal.Quotient.eq, RingHom.map_det, RingHom.map_det]
    congr 1
    ext i j
    simp only [RingHom.mapMatrix_apply, Matrix.map_apply]
    exact Ideal.Quotient.eq.mpr (h i j)

  have hfl : ∀ j, fam (Sum.inl j) = tw (F j) := by intro j; rw [hfam]; rfl
  have hf0 : fam (Sum.inr 0) = MvPolynomial.X (Sum.inr 0) * MvPolynomial.X (Sum.inr 1) - 1 := by
    rw [hfam]; rfl
  have hf1 : fam (Sum.inr 1) = tw e₁ * MvPolynomial.X (Sum.inr 0) - tw e₂ * (1 + ∑ i ∈ Finset.Ioo 0 p,
      MvPolynomial.C (γ i) * (MvPolynomial.C x₀ ^ n *
        (MvPolynomial.X (Sum.inr 0) : MvPolynomial (τ ⊕ Fin 2) N) ^ k) ^ (p - i)) := by
    rw [hfam]; rfl
  have hne01 : (Sum.inr 0 : τ ⊕ Fin 2) ≠ Sum.inr 1 := by simp
  have hne10 : (Sum.inr 1 : τ ⊕ Fin 2) ≠ Sum.inr 0 := by simp

  let A : Matrix τ τ (MvPolynomial (τ ⊕ Fin 2) N) :=
    (Matrix.of fun i j => MvPolynomial.pderiv i (F j)).map tw
  let B : Matrix τ (Fin 2) (MvPolynomial (τ ⊕ Fin 2) N) :=
    Matrix.of fun i b => MvPolynomial.pderiv (Sum.inl i) (fam (Sum.inr b))
  let D' : Matrix (Fin 2) (Fin 2) (MvPolynomial (τ ⊕ Fin 2) N) :=
    !![MvPolynomial.X (Sum.inr 1), tw e₁; MvPolynomial.X (Sum.inr 0), 0]
  have hM : (Matrix.of fun i j => MvPolynomial.pderiv i (fam j)).det -
      (Matrix.fromBlocks A B 0 D').det ∈ J := by
    apply hdet
    intro v w
    rcases v with i | b <;> rcases w with j | c
    · rw [Matrix.of_apply, Matrix.fromBlocks_apply₁₁, hfl, h1]
      simp only [A, Matrix.map_apply, Matrix.of_apply, sub_self]
      exact J.zero_mem
    · rw [Matrix.of_apply, Matrix.fromBlocks_apply₁₂]
      simp only [B, Matrix.of_apply, sub_self]
      exact J.zero_mem
    · rw [Matrix.of_apply, Matrix.fromBlocks_apply₂₁, Matrix.zero_apply, sub_zero, hfl]
      exact h2 _ _
    · rw [Matrix.of_apply, Matrix.fromBlocks_apply₂₂]
      revert b c
      refine Fin.forall_fin_two.mpr ⟨Fin.forall_fin_two.mpr ⟨?_, ?_⟩,
        Fin.forall_fin_two.mpr ⟨?_, ?_⟩⟩
      · have e : MvPolynomial.pderiv (Sum.inr 0) (fam (Sum.inr 0)) - D' 0 0 = 0 := by
          rw [hf0, map_sub, Derivation.leibniz, Derivation.map_one_eq_zero,
            MvPolynomial.pderiv_X_self, MvPolynomial.pderiv_X_of_ne hne10]
          simp [D']
        rw [e]; exact J.zero_mem
      · have e : MvPolynomial.pderiv (Sum.inr 0) (fam (Sum.inr 1)) - D' 0 1 =
            MvPolynomial.pderiv (Sum.inr 0) (tw e₁) * MvPolynomial.X (Sum.inr 0) -
              (MvPolynomial.pderiv (Sum.inr 0) (tw e₂) * (1 + ∑ i ∈ Finset.Ioo 0 p,
                MvPolynomial.C (γ i) * (MvPolynomial.C x₀ ^ n *
                  (MvPolynomial.X (Sum.inr 0) : MvPolynomial (τ ⊕ Fin 2) N) ^ k) ^ (p - i)) +
               tw e₂ * MvPolynomial.pderiv (Sum.inr 0) (1 + ∑ i ∈ Finset.Ioo 0 p,
                MvPolynomial.C (γ i) * (MvPolynomial.C x₀ ^ n *
                  (MvPolynomial.X (Sum.inr 0) : MvPolynomial (τ ⊕ Fin 2) N) ^ k) ^ (p - i))) := by
          rw [hf1, map_sub, Derivation.leibniz, Derivation.leibniz, MvPolynomial.pderiv_X_self]
          simp only [D', smul_eq_mul]
          simp
          ring
        rw [e]
        exact J.sub_mem (J.mul_mem_right _ (h2 _ _))
          (J.add_mem (J.mul_mem_right _ (h2 _ _)) (J.mul_mem_left _ (h5 _)))
      · have e : MvPolynomial.pderiv (Sum.inr 1) (fam (Sum.inr 0)) - D' 1 0 = 0 := by
          rw [hf0, map_sub, Derivation.leibniz, Derivation.map_one_eq_zero,
            MvPolynomial.pderiv_X_self, MvPolynomial.pderiv_X_of_ne hne01]
          simp [D']
        rw [e]; exact J.zero_mem
      · have e : MvPolynomial.pderiv (Sum.inr 1) (fam (Sum.inr 1)) - D' 1 1 =
            MvPolynomial.pderiv (Sum.inr 1) (tw e₁) * MvPolynomial.X (Sum.inr 0) -
              (MvPolynomial.pderiv (Sum.inr 1) (tw e₂) * (1 + ∑ i ∈ Finset.Ioo 0 p,
                MvPolynomial.C (γ i) * (MvPolynomial.C x₀ ^ n *
                  (MvPolynomial.X (Sum.inr 0) : MvPolynomial (τ ⊕ Fin 2) N) ^ k) ^ (p - i)) +
               tw e₂ * MvPolynomial.pderiv (Sum.inr 1) (1 + ∑ i ∈ Finset.Ioo 0 p,
                MvPolynomial.C (γ i) * (MvPolynomial.C x₀ ^ n *
                  (MvPolynomial.X (Sum.inr 0) : MvPolynomial (τ ⊕ Fin 2) N) ^ k) ^ (p - i))) := by
          rw [hf1, map_sub, Derivation.leibniz, Derivation.leibniz,
            MvPolynomial.pderiv_X_of_ne hne01]
          simp only [D', smul_eq_mul]
          simp
          ring
        rw [e]
        exact J.sub_mem (J.mul_mem_right _ (h2 _ _))
          (J.add_mem (J.mul_mem_right _ (h2 _ _)) (J.mul_mem_left _ (h5 _)))
  have hM' : (Matrix.fromBlocks A B 0 D').det =
      tw (Matrix.of fun i j => MvPolynomial.pderiv i (F j)).det *
        (-(MvPolynomial.X (Sum.inr 0) * tw e₁)) := by
    rw [Matrix.det_fromBlocks_zero₂₁, RingHom.map_det, RingHom.mapMatrix_apply]
    simp only [D', Matrix.det_fin_two_of]
    ring
  rw [← hM']
  exact hM

theorem wcpa_dj_llsm_kpwicnec_residue_subring : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (E : Type u) [CommRing E] (j : ↥W →+* E) (I : Ideal E), (IsLocalRing.maximalIdeal ↥W).map j ≤ I → ∃ S₀ : Subring E, (∀ q : E, q ∈ S₀ ↔ ∃ w : ↥W, q - j w ∈ I) ∧ (∀ y y' : E, y ∈ S₀ → y * y' = 1 → y' ∈ S₀) ∧ (∀ (y q c : E) (w : ↥W), w ∉ IsLocalRing.maximalIdeal ↥W → y - j w ∈ I → c ∈ S₀ → y * q - c ∈ I → q ∈ S₀) :=
by
  intro Ω _ W E _ j I hI
  let S₀ : Subring E :=
    { carrier := {q | ∃ w : ↥W, q - j w ∈ I}
      mul_mem' := by
        rintro a b ⟨wa, ha⟩ ⟨wb, hb⟩
        refine ⟨wa * wb, ?_⟩
        have e : a * b - j (wa * wb) = a * (b - j wb) + j wb * (a - j wa) := by
          rw [map_mul]; ring
        rw [e]
        exact I.add_mem (I.mul_mem_left _ hb) (I.mul_mem_left _ ha)
      one_mem' := ⟨1, by simp⟩
      add_mem' := by
        rintro a b ⟨wa, ha⟩ ⟨wb, hb⟩
        refine ⟨wa + wb, ?_⟩
        have e : a + b - j (wa + wb) = (a - j wa) + (b - j wb) := by
          rw [map_add]; ring
        rw [e]
        exact I.add_mem ha hb
      zero_mem' := ⟨0, by simp⟩
      neg_mem' := by
        rintro a ⟨wa, ha⟩
        refine ⟨-wa, ?_⟩
        have e : -a - j (-wa) = -(a - j wa) := by
          rw [map_neg]; ring
        rw [e]
        exact I.neg_mem ha }
  have P1 : ∀ q : E, q ∈ S₀ ↔ ∃ w : ↥W, q - j w ∈ I := fun q => Iff.rfl
  have P3 : ∀ (y q c : E) (w : ↥W), w ∉ IsLocalRing.maximalIdeal ↥W → y - j w ∈ I →
      c ∈ S₀ → y * q - c ∈ I → q ∈ S₀ := by
    intro y q c w hw hy hc hq
    obtain ⟨wc, hwc⟩ := (P1 c).1 hc
    have hu : IsUnit w := IsLocalRing.notMem_maximalIdeal.1 hw
    obtain ⟨w', hw'⟩ : ∃ w' : ↥W, w * w' = 1 := ⟨_, hu.mul_val_inv⟩
    have h1 : j w * j w' = 1 := by rw [← map_mul, hw', map_one]
    refine (P1 q).2 ⟨w' * wc, ?_⟩
    have key : q - j (w' * wc) = j w' * (q * -(y - j w) + (y * q - c) + (c - j wc)) := by
      rw [map_mul]; linear_combination (-q) * h1
    rw [key]
    exact I.mul_mem_left _ (I.add_mem (I.add_mem (I.mul_mem_left _ (I.neg_mem hy)) hq) hwc)
  have P2 : ∀ y y' : E, y ∈ S₀ → y * y' = 1 → y' ∈ S₀ := by
    intro y y' hy hyy
    obtain ⟨w, hw⟩ := (P1 y).1 hy
    by_cases hwm : w ∈ IsLocalRing.maximalIdeal ↥W
    · have hjw : j w ∈ I := hI (Ideal.mem_map_of_mem j hwm)
      have hyI : y ∈ I := by
        have h2 := I.add_mem hw hjw
        rwa [sub_add_cancel] at h2
      refine (P1 y').2 ⟨0, ?_⟩
      have e : y' - j 0 = y * (y' * y') := by
        rw [map_zero]; linear_combination (-y') * hyy
      rw [e]
      exact I.mul_mem_right _ hyI
    · exact P3 y y' 1 w hwm hw S₀.one_mem (by rw [hyy, sub_self]; exact I.zero_mem)
  exact ⟨S₀, P1, P2, P3⟩

theorem wcpa_dj_llsm_kpwicnec_residue_loc : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A E : Type u) [CommRing A] [CommRing E] [Algebra ↥W A] (𝔭 : Ideal A) (h : A) (ψ : A →+* E) (χ : Localization.Away h →+* E) (I : Ideal E), h ∉ 𝔭 → (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 → (∀ x : A, ∃ w : ↥W, x - algebraMap ↥W A w ∈ 𝔭) → 𝔭.map ψ ≤ I → χ.comp (algebraMap A (Localization.Away h)) = ψ → ∀ b : Localization.Away h, ∃ w : ↥W, χ b - ψ (algebraMap ↥W A w) ∈ I :=
by
  intro Ω _ W A E _ _ _ 𝔭 h ψ χ I hh hm hres hI hχ b
  set J : ↥W →+* E ⧸ I := (Ideal.Quotient.mk I).comp (ψ.comp (algebraMap ↥W A)) with hJ
  have s1 : ∀ (x : A) (w : ↥W), x - algebraMap ↥W A w ∈ 𝔭 →
      Ideal.Quotient.mk I (ψ x) = J w := by
    intro x w hx
    show Ideal.Quotient.mk I (ψ x) = Ideal.Quotient.mk I (ψ (algebraMap ↥W A w))
    rw [Ideal.Quotient.eq, ← map_sub]
    exact hI (Ideal.mem_map_of_mem ψ hx)
  obtain ⟨wh, hwh⟩ := hres h
  have hu : IsUnit wh := by
    by_contra hnu
    have hmem : wh ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal _).mpr hnu
    apply hh
    have h2 : algebraMap ↥W A wh ∈ 𝔭 := hm (Ideal.mem_map_of_mem _ hmem)
    have h3 := 𝔭.add_mem hwh h2
    rwa [sub_add_cancel] at h3
  obtain ⟨⟨a, ⟨_, n, rfl⟩⟩, hb⟩ := IsLocalization.surj (Submonoid.powers h) b
  obtain ⟨wa, hwa⟩ := hres a
  have hwv : wh * ((hu.unit⁻¹ : (↥W)ˣ) : ↥W) = 1 := hu.mul_val_inv
  refine ⟨wa * ((hu.unit⁻¹ : (↥W)ˣ) : ↥W) ^ n, ?_⟩
  rw [← Ideal.Quotient.eq]
  have hχι : ∀ y : A, χ (algebraMap A (Localization.Away h) y) = ψ y := fun y => by
    rw [← RingHom.comp_apply, hχ]
  have e1 := congrArg (fun z => Ideal.Quotient.mk I (χ z)) hb
  simp only [map_mul, hχι, map_pow] at e1
  rw [s1 h wh hwh, s1 a wa hwa] at e1
  show Ideal.Quotient.mk I (χ b) = J (wa * ((hu.unit⁻¹ : (↥W)ˣ) : ↥W) ^ n)
  rw [map_mul, ← e1, map_pow, mul_assoc, ← mul_pow, ← map_mul, hwv, map_one, one_pow, mul_one]

theorem wcpa_dj_llsm_kpwicn_etale_cover : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A]
    (𝔭 : Ideal A) [𝔭.IsMaximal] (g β : ↥W) (u v h d e : A) (p a k n : ℕ) (γ : ℕ → ↥W)
    (f₀ : wcEbntN W g →+* Localization.Away h),
    β ^ p = g → 0 < n → 0 < k → h ∉ 𝔭 → d ∉ 𝔭 → e ∉ 𝔭 →
    𝔭 = Ideal.span {u, v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
    (∀ x : A, ∃ w : ↥W, x - algebraMap ↥W A w ∈ 𝔭) →
    f₀.comp ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})).comp
      MvPolynomial.C) = (algebraMap A (Localization.Away h)).comp (algebraMap ↥W A) →
    f₀ (wcEbntX W g 0) = algebraMap A (Localization.Away h) u →
    f₀ (wcEbntX W g 1) = algebraMap A (Localization.Away h) v →
    RingHom.Etale (R := wcEbntN W g) (S := Localization.Away h) f₀ →
    ∃ (E : Type u) (_ : CommRing E) (ι : wcEbntN W β →+* E) (ψ : A →+* E) (r r' : E),
      RingHom.Etale (R := wcEbntN W β) (S := E) ι ∧
      ψ.comp (algebraMap ↥W A) = ι.comp ((Ideal.Quotient.mk (Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β})).comp MvPolynomial.C) ∧
      r * r' = 1 ∧
      ψ v = ι (wcEbntX W β 0) ^ p * r ^ a ∧
      ψ u = ι (wcEbntX W β 1) ^ p * r' ^ a ∧
      ψ e * r = ψ d * (1 + ∑ i ∈ Finset.Ioo 0 p, ψ (algebraMap ↥W A (γ i)) *
        (ι (wcEbntX W β 0) ^ n * r ^ k) ^ (p - i)) ∧
      (∀ q : E, ∃ w : ↥W, q - ψ (algebraMap ↥W A w) ∈
        Ideal.span {ι (wcEbntX W β 0), ι (wcEbntX W β 1)} ⊔
          (IsLocalRing.maximalIdeal ↥W).map (ψ.comp (algebraMap ↥W A))) ∧
      (∀ (P : Type u) [CommRing P] [IsLocalRing P] (φ : A →+* P) (x z ρ ρ' : P),
        (IsLocalRing.maximalIdeal P).comap φ = 𝔭 → x ∈ IsLocalRing.maximalIdeal P →
        z ∈ IsLocalRing.maximalIdeal P → x * z = φ (algebraMap ↥W A β) → ρ * ρ' = 1 →
        φ v = x ^ p * ρ ^ a → φ u = z ^ p * ρ' ^ a →
        φ e * ρ = φ d * (1 + ∑ i ∈ Finset.Ioo 0 p, φ (algebraMap ↥W A (γ i)) * (x ^ n * ρ ^ k) ^ (p - i)) →
        ∃ Φ : E →+* P, Φ.comp ψ = φ ∧ Φ (ι (wcEbntX W β 0)) = x ∧ Φ (ι (wcEbntX W β 1)) = z ∧ Φ r = ρ) :=
by
  intro Ω _ W A _ _ 𝔭 _ g β u v h d e p a k n γ f₀ hβg hn hk hh hd he h𝔭 hres hfC hfu hfv hfet
  have h𝔭prime : 𝔭.IsPrime := Ideal.IsMaximal.isPrime ‹_›
  have hu𝔭 : u ∈ 𝔭 := by
    rw [h𝔭]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hm𝔭 : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 := by
    rw [h𝔭]; exact le_sup_right
  have hfCw : ∀ w : ↥W, f₀ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C g}) (MvPolynomial.C w)) = algebraMap A (Localization.Away h) (algebraMap ↥W A w) :=
    fun w => RingHom.congr_fun hfC w

  have nodeHom : ∀ (b : ↥W) (P : Type u) [CommRing P] (κ : ↥W →+* P) (x z : P), x * z = κ b →
      ∃ ν : wcEbntN W b →+* P,
        (∀ w, ν (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C b}) (MvPolynomial.C w)) = κ w) ∧
        ν (wcEbntX W b 0) = x ∧ ν (wcEbntX W b 1) = z := by
    intro b P _ κ x z hxz
    refine ⟨Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom κ ![x, z]) ?_, ?_, ?_, ?_⟩
    · intro y hy
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp hy
