  have hNne : N ≠ 0 := by
    rintro rfl
    exact hN0 (by simp)
  have hg0 : g₀ ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hNg
    exact hN0 hNg.symm
  have hg0K : algebraMap A K g₀ ≠ 0 := by
    intro h0
    apply hg0
    apply IsFractionRing.injective A K
    rw [h0, map_zero]
  have hNT : algebraMap A K (Polynomial.aeval t N) =
      Polynomial.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K t) N := by
    rw [Polynomial.aeval_def, Polynomial.hom_eval₂]
  have hNTne : Polynomial.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K t) N
      ≠ 0 := by
    rw [← hNT]
    intro h0
    apply hN0
