theorem wcLlsASr_cdpd_torsion_free : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (R : Type u) [CommRing R] [Algebra ↥W R] (g : R) (P : Ideal R) [P.IsPrime] (f : Polynomial ↥W →+* Localization.Away g), g ∉ P → f.comp Polynomial.C = (algebraMap R (Localization.Away g)).comp (algebraMap ↥W R) → RingHom.Etale f → ∀ d : ↥W, d ≠ 0 → ∀ z : Localization.AtPrime P, algebraMap R (Localization.AtPrime P) (algebraMap ↥W R d) * z = 0 → z = 0 :=
by
  intro Ω _ W R _ _ g P _ f hg hfC hf d hd z hz
  have s1 : ∀ (A S : Type u) [CommRing A] [CommRing S] (φ : A →+* S), φ.Flat →
      ∀ a : A, a ∈ nonZeroDivisors A → ∀ x : S, φ a * x = 0 → x = 0 := by
    intro A S _ _ φ hφ a ha x hx
    letI := φ.toAlgebra
    have hfl : Module.Flat A S := hφ
    have hreg : IsSMulRegular S a := Module.Flat.isSMulRegular_of_nonZeroDivisors ha
    apply hreg
    show a • x = a • (0 : S)
    rw [smul_zero, Algebra.smul_def, RingHom.algebraMap_toAlgebra]
    exact hx
  have hCflat : (Polynomial.C : ↥W →+* Polynomial ↥W).Flat := by
    rw [← Polynomial.algebraMap_eq]
    exact RingHom.flat_algebraMap_iff.mpr inferInstance
  have hfflat : f.Flat :=
    RingHom.Smooth.flat ((RingHom.etale_iff_formallyUnramified_and_smooth f).mp hf).2
  have hψ : (f.comp Polynomial.C).Flat := RingHom.Flat.comp hCflat hfflat
  have hdnz : d ∈ nonZeroDivisors ↥W := mem_nonZeroDivisors_of_ne_zero hd
  have s5 : ∀ x : Localization.Away g,
      algebraMap R (Localization.Away g) (algebraMap ↥W R d) * x = 0 → x = 0 := by
    intro x hx
    apply s1 _ _ (f.comp Polynomial.C) hψ d hdnz x
    rw [hfC]
    exact hx
  set δ := algebraMap ↥W R d with hδ
  obtain ⟨⟨r, s⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl z
  rw [IsLocalization.mul_mk'_eq_mk'_of_mul, IsLocalization.mk'_eq_zero_iff] at hz
  obtain ⟨m, hm⟩ := hz
  have hx0 := s5 (algebraMap R (Localization.Away g) (m * r)) (by
    rw [← map_mul]
    have : δ * (↑m * r) = ↑m * (δ * r) := by ring
    rw [this, hm, map_zero])
  rw [IsLocalization.map_eq_zero_iff (Submonoid.powers g)] at hx0
  obtain ⟨⟨k, hk⟩, hk0⟩ := hx0
  obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hk
  rw [IsLocalization.mk'_eq_zero_iff]
  have hgn : g ^ n ∈ P.primeCompl := Submonoid.pow_mem _ hg n
  refine ⟨⟨g ^ n * m, Submonoid.mul_mem _ hgn m.2⟩, ?_⟩
  simp only at hk0 ⊢
  rw [mul_assoc]
  exact hk0

