    ((φ₁.comp f₀) (Ideal.Quotient.mk (Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.X 1)))
    e (Ideal.Quotient.mk (Ideal.span {G}) T) (Ideal.Quotient.mk (Ideal.span {G}) Ti) Q₀
