    ∀ α : L, α ∉ Set.range (algebraMap K L) → α ^ ℓ - α ∈ Set.range (algebraMap K L) →
    ∃ c₀ b₀ : ↥W, c₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ b₀ ∈ IsLocalRing.maximalIdeal ↥W ∧
      b₀ ≠ 0 ∧ wcLlsDiscSep W A K L t c₀ b₀ ∧
      (wcLlsGaussEtale W A K L t c₀ b₀ ∨
        ∀ e' : ↥W, wcLlsInnerSmooth W A K L t c₀ b₀ e' ∨
          ∃ e : ↥W, e - e' ∉ IsLocalRing.maximalIdeal ↥W ∧
            ¬ wcLlsInnerSmooth W A K L t c₀ b₀ e) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hSolv hUniq hBR hdeg
    α hα1 hα2
  classical
  obtain ⟨c₀, b₀, hc₀, hb₀, hb₀0, hSep, hMin⟩ := wcLlsAS_vtx_min_disc Ω W hW hWt ℓ hℓ hchar
    A K L 𝔭 t y hPD hSolv hUniq hBR hdeg α hα1 hα2
  refine ⟨c₀, b₀, hc₀, hb₀, hb₀0, hSep, ?_⟩
  by_cases hG : wcLlsGaussEtale W A K L t c₀ b₀
  · exact Or.inl hG
  right
  intro e'
  by_contra hcon
  have h₂ : ∀ e : ↥W, e - e' ∉ IsLocalRing.maximalIdeal ↥W →
      wcLlsInnerSmooth W A K L t c₀ b₀ e := by
    intro e he
    by_contra hns
    exact hcon (Or.inr ⟨e, he, hns⟩)
  have hc' : c₀ + b₀ * e' ∈ IsLocalRing.maximalIdeal ↥W :=
    Ideal.add_mem _ hc₀ (Ideal.mul_mem_right _ _ hb₀)
  obtain ⟨T, hT⟩ := wcLlsAS_disc_mid_sep Ω W hW hWt ℓ hℓ hchar A K L 𝔭 t y hPD hSolv hUniq hBR
    hdeg α hα1 hα2 (c₀ + b₀ * e') hc'

  have hsel : ∃ b'' : ↥W, b'' ∈ IsLocalRing.maximalIdeal ↥W ∧ b'' ≠ 0 ∧ b₀ ∣ b'' ∧
      ¬ b'' ∣ b₀ ∧ ∀ τ ∈ T, ¬ ((b₀ ∣ τ ∧ ¬ τ ∣ b₀) ∧ (τ ∣ b'' ∧ ¬ b'' ∣ τ)) := by
    have hnotunit : ¬ IsUnit b₀ := by
      intro hu
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hb₀
      exact hb₀ hu
    set C := T.filter (fun τ => b₀ ∣ τ ∧ ¬ τ ∣ b₀ ∧ τ ≠ 0) with hC
    rcases C.eq_empty_or_nonempty with hCe | hCne
    · refine ⟨b₀ * b₀, Ideal.mul_mem_left _ _ hb₀, mul_ne_zero hb₀0 hb₀0, dvd_mul_right _ _,
        ?_, ?_⟩
      · rintro ⟨r, hr⟩
        apply hnotunit
        have h1 : b₀ * 1 = b₀ * (b₀ * r) := by rw [mul_one, ← mul_assoc]; exact hr
        have h2 : 1 = b₀ * r := mul_left_cancel₀ hb₀0 h1
        exact isUnit_of_dvd_one ⟨r, h2⟩
      · rintro τ hτ ⟨⟨h1, h2⟩, h3, _⟩
        have hτ0 : τ ≠ 0 := by
          rintro rfl
          exact mul_ne_zero hb₀0 hb₀0 (zero_dvd_iff.mp h3)
        have hmem : τ ∈ C := Finset.mem_filter.mpr ⟨hτ, h1, h2, hτ0⟩
        rw [hCe] at hmem
        exact absurd hmem (Finset.notMem_empty τ)
    · have key : ∀ s : Finset ↥W, s.Nonempty → ∃ x ∈ s, ∀ z ∈ s, x ∣ z := by
        intro s
        induction s using Finset.induction_on with
        | empty => intro h; exact absurd h Finset.not_nonempty_empty
        | insert a s ha ih =>
          intro _
          rcases s.eq_empty_or_nonempty with hs | hs
          · refine ⟨a, Finset.mem_insert_self a s, ?_⟩
            intro z hz
            rcases Finset.mem_insert.mp hz with h | h
            · rw [h]
            · rw [hs] at h
              exact absurd h (Finset.notMem_empty z)
          · obtain ⟨x, hx, hxmin⟩ := ih hs
            rcases ValuationRing.dvd_total a x with h | h
            · refine ⟨a, Finset.mem_insert_self a s, ?_⟩
              intro z hz
              rcases Finset.mem_insert.mp hz with hz' | hz'
              · rw [hz']
              · exact h.trans (hxmin z hz')
            · refine ⟨x, Finset.mem_insert_of_mem hx, ?_⟩
              intro z hz
              rcases Finset.mem_insert.mp hz with hz' | hz'
              · rw [hz']; exact h
              · exact hxmin z hz'
      obtain ⟨x, hxC, hxmin⟩ := key C hCne
      obtain ⟨-, hbx, hxb, hx0⟩ := Finset.mem_filter.mp hxC
      obtain ⟨q, hq⟩ := hbx
      have hxm : x ∈ IsLocalRing.maximalIdeal ↥W := by
        rw [hq]; exact Ideal.mul_mem_right _ _ hb₀
      refine ⟨x, hxm, hx0, ⟨q, hq⟩, hxb, ?_⟩
      rintro τ hτ ⟨⟨h1, h2⟩, h3, h4⟩
      by_cases hτ0 : τ = 0
      · subst hτ0
        exact hx0 (zero_dvd_iff.mp h3)
      · exact h4 (hxmin τ (Finset.mem_filter.mpr ⟨hτ, h1, h2, hτ0⟩))
  obtain ⟨b'', hb''m, hb''0, hb₀b'', hnb, hTb⟩ := hsel
  have hMid := hT b₀ b'' hb₀ hb₀0 hb''m hb''0 hb₀b'' hnb hTb
  have hD := wcLlsAS_vtx_descent Ω W hW hWt ℓ hℓ hchar A K L 𝔭 t y hPD hSolv hUniq hBR hdeg
    α hα1 hα2 c₀ b₀ e' b'' hc₀ hb₀ hb₀0 hb''m hb''0 hb₀b'' hnb hSep hG h₂ hMid
  exact hnb (hMin (c₀ + b₀ * e') b'' hc' hb''m hb''0 ⟨e', by ring⟩ hD)

theorem wcLlsAS_dcc_finite_centres : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y →
    wcLlsBR W A K L 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ α : L, α ∉ Set.range (algebraMap K L) → α ^ ℓ - α ∈ Set.range (algebraMap K L) →
    ∃ C : Finset ↥W, (∀ c ∈ C, c ∈ IsLocalRing.maximalIdeal ↥W) ∧
      ∀ c b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
        wcLlsDiscSep W A K L t c b →
        (∀ b' : ↥W, b' ∈ IsLocalRing.maximalIdeal ↥W → b' ≠ 0 →
          wcLlsDiscSep W A K L t c b' → b' ∣ b) →
        ∃ c'' ∈ C, b ∣ c - c'' :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hSolv hUniq hBR hdeg
    α hα1 hα2
  obtain ⟨c₀, b₀, hc₀, hb₀, hb₀0, hsep₀, hV⟩ := wcLlsAS_dcc_vertex_disc Ω W hW hWt ℓ hℓ hchar
    A K L 𝔭 t y hPD hSolv hUniq hBR hdeg α hα1 hα2
  refine ⟨{c₀}, ?_, ?_⟩
  · intro c hc
    rw [Finset.mem_singleton.mp hc]
    exact hc₀
  · intro c b hc hb hb0 hsep _hmax
    refine ⟨c₀, Finset.mem_singleton_self c₀, ?_⟩
    by_contra hnd
    by_cases hb' : b₀ ∣ c - c₀
    · obtain ⟨e', he'⟩ := hb'
      have hnb : ¬ b ∣ b₀ := fun h => hnd (h.trans ⟨e', he'⟩)
      have H2 := wcLls_inner_offclass_smooth Ω W hW hWt A K L 𝔭 t y hPD hSolv hUniq
        c₀ b₀ c b e' hc₀ hb₀ hc hb hb₀0 hb0 he' hnb hsep
      have H3 := wcLls_inner_class_singular Ω W hW hWt A K L 𝔭 t y hPD hSolv hUniq
        c₀ b₀ c b e' hc₀ hb₀ hc hb hb₀0 hb0 he' hnb hsep
      have H5 := wcLlsAS_dcc_gauss_not_etale Ω W hW hWt ℓ hℓ hchar A K L 𝔭 t y hPD hSolv hUniq
        hdeg c₀ b₀ c b e' hc₀ hb₀ hc hb hb₀0 hb0 he' hnb hsep
      rcases hV with hG | hV
      · exact H5 hG
      · rcases hV e' with h | ⟨e, he, hns⟩
        · exact H3 h
        · exact hns (H2 e he)
    · have hb₃m : c - c₀ ∈ IsLocalRing.maximalIdeal ↥W := Ideal.sub_mem _ hc hc₀
      have hb₃0 : c - c₀ ≠ 0 := by
        intro h0
        apply hnd
        rw [h0]
        exact dvd_zero b
      have hunit : (0 : ↥W) - 1 ∉ IsLocalRing.maximalIdeal ↥W := by
        rw [zero_sub, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not]
        exact isUnit_one.neg
      have H2 := wcLls_inner_offclass_smooth Ω W hW hWt A K L 𝔭 t y hPD hSolv hUniq
        c₀ (c - c₀) c b 1 hc₀ hb₃m hc hb hb₃0 hb0 (mul_one _).symm hnd hsep 0 hunit
      have H3 := wcLls_inner_class_singular Ω W hW hWt A K L 𝔭 t y hPD hSolv hUniq
        c₀ (c - c₀) c₀ b₀ 0 hc₀ hb₃m hc₀ hb₀ hb₃0 hb₀0 (by rw [sub_self, mul_zero]) hb' hsep₀
      exact H3 H2

theorem wcLlsAS_disc_common_centre : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y →
    wcLlsBR W A K L 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ α : L, α ∉ Set.range (algebraMap K L) → α ^ ℓ - α ∈ Set.range (algebraMap K L) →
    ∃ c₀ : ↥W, c₀ ∈ IsLocalRing.maximalIdeal ↥W ∧
      ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
        b' ≠ 0 → wcLlsDiscSep W A K L t c' b' → b' ∣ c' - c₀ :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hSolv hUniq hBR hdeg
    α hα1 hα2
  classical
  have hRM := wcLlsAS_disc_radial_max Ω W hW hWt ℓ hℓ hchar A K L 𝔭 t y hPD hSolv hUniq hBR
    hdeg α hα1 hα2
  obtain ⟨C, hCm, hC⟩ := wcLlsAS_dcc_finite_centres Ω W hW hWt ℓ hℓ hchar A K L 𝔭 t y hPD hSolv
    hUniq hBR hdeg α hα1 hα2
  have hNest := wcLlsAS_dcc_nesting Ω W hW hWt ℓ hℓ hchar A K L 𝔭 t y hPD hSolv hUniq hBR
    hdeg α hα1 hα2
  choose! bf hbfm hbf0 hbfS hbfMax using hRM
  rcases C.eq_empty_or_nonempty with hCe | hCne
  ·
    refine ⟨0, Ideal.zero_mem _, ?_⟩
    intro c' b' hc' hb' hb'0 hs
    obtain ⟨c'', hc''C, _⟩ := hC c' (bf c') hc' (hbfm c' hc') (hbf0 c' hc') (hbfS c' hc')
      (hbfMax c' hc')
    rw [hCe] at hc''C
    exact absurd hc''C (Finset.notMem_empty c'')
  ·
    have key : ∀ s : Finset ↥W, s.Nonempty → ∃ x ∈ s, ∀ z ∈ s, bf z ∣ bf x := by
      intro s
      induction s using Finset.induction_on with
      | empty => intro h; exact absurd h Finset.not_nonempty_empty
      | insert a s ha ih =>
        intro _
        rcases s.eq_empty_or_nonempty with hs | hs
        · refine ⟨a, Finset.mem_insert_self a s, ?_⟩
          intro z hz
          rcases Finset.mem_insert.mp hz with h | h
          · rw [h]
          · rw [hs] at h
            exact absurd h (Finset.notMem_empty z)
        · obtain ⟨x, hx, hxmax⟩ := ih hs
          rcases ValuationRing.dvd_total (bf a) (bf x) with h | h
          · refine ⟨x, Finset.mem_insert_of_mem hx, ?_⟩
            intro z hz
            rcases Finset.mem_insert.mp hz with hz' | hz'
            · rw [hz']; exact h
            · exact hxmax z hz'
          · refine ⟨a, Finset.mem_insert_self a s, ?_⟩
            intro z hz
            rcases Finset.mem_insert.mp hz with hz' | hz'
            · rw [hz']
            · exact (hxmax z hz').trans h
    obtain ⟨c₀, hc₀C, hc₀max⟩ := key C hCne
    have hc₀ : c₀ ∈ IsLocalRing.maximalIdeal ↥W := hCm c₀ hc₀C
    refine ⟨c₀, hc₀, ?_⟩
    intro c' b' hc' hb' hb'0 hs
    have h1 : b' ∣ bf c' := hbfMax c' hc' b' hb' hb'0 hs
    obtain ⟨c'', hc''C, h2⟩ := hC c' (bf c') hc' (hbfm c' hc') (hbf0 c' hc') (hbfS c' hc')
      (hbfMax c' hc')
    have hc'' : c'' ∈ IsLocalRing.maximalIdeal ↥W := hCm c'' hc''C
    have h3 : bf c' ∣ c'' - c' := by
      rw [← dvd_neg, neg_sub]
      exact h2
    have h4 : wcLlsDiscSep W A K L t c'' (bf c') :=
      wcLlsAS_disc_recentre Ω W A K L 𝔭 t hPD c' c'' (bf c') hc' hc'' (hbfm c' hc')
        (hbf0 c' hc') h3 (hbfS c' hc')
    have h5 : bf c' ∣ bf c'' := hbfMax c'' hc'' (bf c') (hbfm c' hc') (hbf0 c' hc') h4
    have h6 : b' ∣ bf c₀ := h1.trans (h5.trans (hc₀max c'' hc''C))
    rcases hNest c' b' c₀ (bf c₀) hc' hb' hc₀ (hbfm c₀ hc₀) hb'0 (hbf0 c₀ hc₀) hs
      (hbfS c₀ hc₀) with h | h
    · exact h
    · exact h6.trans h

theorem wcLlsASb_node_unit : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g b₀ : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) → b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 → b₀ ∣ g →
    ∀ a : A, a ∉ 𝔭 → ∀ x : ↥(wcLlsASbS W A K u b₀), x ∈ wcLlsASbN W A K u b₀ →
      algebraMap A ↥(wcLlsASbS W A K u b₀) a + x ∉ wcLlsASbN W A K u b₀ :=
by
  intro Ω _ W A _ _ _ K _ _ _ 𝔭 u v g b₀ hPD hb₀ _ _ a ha x hx hN
  classical
  obtain ⟨_, _, _, hpmax, hmp, hgm, _, _, hpeq, h, hh, f, hfC, hfu, hfv, hfet⟩ := hPD
  haveI hprime : 𝔭.IsPrime := hpmax.isPrime
  have hu𝔭 : u ∈ 𝔭 := by
    rw [hpeq]; exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
  have hv𝔭 : v ∈ 𝔭 := by
    rw [hpeq]; exact Ideal.mem_sup_left (Ideal.subset_span (by simp))

  have hdisj : Disjoint (↑(Submonoid.powers h) : Set A) ↑𝔭 :=
    (Ideal.disjoint_powers_iff_notMem h hprime.isRadical).mpr hh
  obtain ⟨𝔓, h𝔓d⟩ : ∃ 𝔓 : Ideal (Localization.Away h),
      𝔓 = 𝔭.map (algebraMap A (Localization.Away h)) := ⟨_, rfl⟩
  haveI h𝔓p : 𝔓.IsPrime := by
    rw [h𝔓d]
    exact IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) _ 𝔭 hprime hdisj
  have h𝔓u : 𝔓.comap (algebraMap A (Localization.Away h)) = 𝔭 := by
    rw [h𝔓d]
    exact IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers h) _ hprime hdisj
  have h𝔓mem : ∀ z ∈ 𝔭, algebraMap A (Localization.Away h) z ∈ 𝔓 := by
    intro z hz; rw [h𝔓d]; exact Ideal.mem_map_of_mem _ hz
  have hCμ : ∀ μ : ↥W, f (Ideal.Quotient.mk _ (MvPolynomial.C μ)) =
      algebraMap A (Localization.Away h) (algebraMap ↥W A μ) :=
    fun μ => RingHom.congr_fun hfC μ

  obtain ⟨ψt, hψtd⟩ : ∃ ψt : MvPolynomial (Fin 2) ↥W →+* Polynomial (IsLocalRing.ResidueField ↥W),
      ψt = MvPolynomial.eval₂Hom (Polynomial.C.comp (IsLocalRing.residue ↥W))
        ![Polynomial.X, 0] := ⟨_, rfl⟩
  have hψC : ∀ μ, ψt (MvPolynomial.C μ) = Polynomial.C (IsLocalRing.residue ↥W μ) := by
    intro μ; rw [hψtd]; simp
  have hψX0 : ψt (MvPolynomial.X 0) = Polynomial.X := by rw [hψtd]; simp
  have hψX1 : ψt (MvPolynomial.X 1) = 0 := by rw [hψtd]; simp
  have hresg : IsLocalRing.residue ↥W g = 0 := (IsLocalRing.residue_eq_zero_iff g).mpr hgm
  have hψI : ∀ r ∈ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g},
      ψt r = 0 := by
    intro r hr
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hr
    rw [map_mul, map_sub, map_mul, hψX0, hψX1, hψC, hresg]; simp
  have hXe : ∀ n : Fin 2, Polynomial.eval 0 (ψt (MvPolynomial.X n)) = 0 :=
    Fin.forall_fin_two.mpr ⟨by rw [hψX0]; simp, by rw [hψX1]; simp⟩
  have hev : ∀ F : MvPolynomial (Fin 2) ↥W, Polynomial.eval 0 (ψt F) =
      IsLocalRing.residue ↥W (MvPolynomial.constantCoeff F) := by
    intro F
    induction F using MvPolynomial.induction_on
    · rw [hψC]; simp
    · rename_i p q hp hq
      rw [map_add, Polynomial.eval_add, hp, hq, map_add, map_add]
    · rename_i p n hp
      rw [map_mul, Polynomial.eval_mul, hp, hXe, map_mul, MvPolynomial.constantCoeff_X]; simp
  obtain ⟨p₀, hp₀⟩ : ∃ p₀ : Ideal (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}),
      p₀ = RingHom.ker (Ideal.Quotient.lift _ ψt hψI) := ⟨_, rfl⟩
  haveI hp₀p : p₀.IsPrime := by rw [hp₀]; exact RingHom.ker_isPrime _
  have hmem₀ : ∀ F : MvPolynomial (Fin 2) ↥W, Ideal.Quotient.mk _ F ∈ p₀ ↔ ψt F = 0 := by
    intro F; rw [hp₀, RingHom.mem_ker, Ideal.Quotient.lift_mk]

  have hmkX : ∀ i : Fin 2, f (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ 𝔓 :=
    Fin.forall_fin_two.mpr ⟨by rw [hfu]; exact h𝔓mem _ hu𝔭, by rw [hfv]; exact h𝔓mem _ hv𝔭⟩
  have hdec : ∀ F : MvPolynomial (Fin 2) ↥W, f (Ideal.Quotient.mk _ F) -
      f (Ideal.Quotient.mk _ (MvPolynomial.C (MvPolynomial.constantCoeff F))) ∈ 𝔓 := by
    intro F
    induction F using MvPolynomial.induction_on
    · simp
    · rename_i p q hp hq
      have e : f (Ideal.Quotient.mk _ (p + q)) -
          f (Ideal.Quotient.mk _ (MvPolynomial.C (MvPolynomial.constantCoeff (p + q)))) =
          (f (Ideal.Quotient.mk _ p) -
            f (Ideal.Quotient.mk _ (MvPolynomial.C (MvPolynomial.constantCoeff p)))) +
          (f (Ideal.Quotient.mk _ q) -
            f (Ideal.Quotient.mk _ (MvPolynomial.C (MvPolynomial.constantCoeff q)))) := by
        simp only [map_add]; ring
      rw [e]; exact 𝔓.add_mem hp hq
    · rename_i p n _
      have e : f (Ideal.Quotient.mk _ (p * MvPolynomial.X n)) -
          f (Ideal.Quotient.mk _ (MvPolynomial.C (MvPolynomial.constantCoeff
            (p * MvPolynomial.X n)))) =
          f (Ideal.Quotient.mk _ p) * f (Ideal.Quotient.mk _ (MvPolynomial.X n)) := by
        simp only [map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero, sub_zero]
      rw [e]; exact 𝔓.mul_mem_left _ (hmkX n)
  have hle : p₀ ≤ 𝔓.comap f := by
    intro r hr
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective r
    have h0 : ψt F = 0 := (hmem₀ F).mp hr
    have hc : IsLocalRing.residue ↥W (MvPolynomial.constantCoeff F) = 0 := by
      rw [← hev F, h0, Polynomial.eval_zero]
    have hcm := (IsLocalRing.residue_eq_zero_iff _).mp hc
    rw [Ideal.mem_comap]
    have hC' : f (Ideal.Quotient.mk _ (MvPolynomial.C (MvPolynomial.constantCoeff F))) ∈ 𝔓 := by
      rw [hCμ]; exact h𝔓mem _ (hmp (Ideal.mem_map_of_mem _ hcm))
    have := 𝔓.add_mem (hdec F) hC'
    rwa [sub_add_cancel] at this

  haveI : (𝔓.comap f).IsPrime := Ideal.IsPrime.comap f
  letI : Algebra (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
      (Localization.Away h) := f.toAlgebra
  haveI : Algebra.Etale (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
      (Localization.Away h) := hfet.toAlgebra
  obtain ⟨P', hP'le, hP'p, hP'lo⟩ :=
    Ideal.exists_ideal_le_liesOver_of_le (p := p₀)
      (q := Ideal.under (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) 𝔓) 𝔓 hle
  have hp₀P : ∀ r, r ∈ p₀ ↔ f r ∈ P' := by
    intro r; rw [hP'lo.over]; exact Iff.rfl

  obtain ⟨Q, hQd⟩ : ∃ Q : Ideal A, Q = P'.comap (algebraMap A (Localization.Away h)) :=
    ⟨_, rfl⟩
  haveI hQp : Q.IsPrime := by rw [hQd]; exact Ideal.IsPrime.comap _
  have hQle : Q ≤ 𝔭 := by
    intro z hz
    rw [hQd, Ideal.mem_comap] at hz
    rw [← h𝔓u, Ideal.mem_comap]
    exact hP'le hz
  have huQ : u ∉ Q := by
    intro hz
    rw [hQd, Ideal.mem_comap, ← hfu, ← hp₀P, hmem₀, hψX0] at hz
    exact Polynomial.X_ne_zero hz
  have hQm : ∀ μ ∈ IsLocalRing.maximalIdeal ↥W, algebraMap ↥W A μ ∈ Q := by
    intro μ hμ
    rw [hQd, Ideal.mem_comap, ← hCμ, ← hp₀P, hmem₀, hψC,
      (IsLocalRing.residue_eq_zero_iff μ).mpr hμ, map_zero]

  have hu0 : u ≠ 0 := fun h0 => huQ (h0 ▸ Q.zero_mem)
  have hφu : algebraMap A K u ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr hu0
  have hs : algebraMap A K u * (algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u) =
      algebraMap A K (algebraMap ↥W A b₀) := mul_div_cancel₀ _ hφu
  have hbQ : algebraMap ↥W A b₀ ∈ Q := hQm b₀ hb₀
  have hstar : ∀ z ∈ Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u},
      ∃ k : ℕ, ∃ c : A, ∃ q ∈ Q, algebraMap A K u ^ k * z = algebraMap A K (u ^ k * c + q) := by
    intro z hz
    induction hz using Algebra.adjoin_induction with
    | mem z hz =>
      rw [Set.mem_singleton_iff] at hz
      subst hz
      refine ⟨1, 0, algebraMap ↥W A b₀, hbQ, ?_⟩
      simp only [pow_one, mul_zero, zero_add]
      exact hs
    | algebraMap r => exact ⟨0, r, 0, Q.zero_mem, by simp⟩
    | add z₁ z₂ _ _ ih₁ ih₂ =>
      obtain ⟨k₁, c₁, q₁, hq₁, e₁⟩ := ih₁
      obtain ⟨k₂, c₂, q₂, hq₂, e₂⟩ := ih₂
      refine ⟨k₁ + k₂, c₁ + c₂, u ^ k₂ * q₁ + u ^ k₁ * q₂,
        Q.add_mem (Q.mul_mem_left _ hq₁) (Q.mul_mem_left _ hq₂), ?_⟩
      simp only [map_add, map_mul, map_pow] at e₁ e₂ ⊢
      linear_combination algebraMap A K u ^ k₂ * e₁ + algebraMap A K u ^ k₁ * e₂
    | mul z₁ z₂ _ _ ih₁ ih₂ =>
      obtain ⟨k₁, c₁, q₁, hq₁, e₁⟩ := ih₁
      obtain ⟨k₂, c₂, q₂, hq₂, e₂⟩ := ih₂
      refine ⟨k₁ + k₂, c₁ * c₂, u ^ k₁ * c₁ * q₂ + u ^ k₂ * c₂ * q₁ + q₁ * q₂,
        Q.add_mem (Q.add_mem (Q.mul_mem_left _ hq₂) (Q.mul_mem_left _ hq₁))
          (Q.mul_mem_left _ hq₂), ?_⟩
      simp only [map_add, map_mul, map_pow] at e₁ e₂ ⊢
      linear_combination (algebraMap A K u ^ k₂ * z₂) * e₁ +
        (algebraMap A K u ^ k₁ * algebraMap A K c₁ + algebraMap A K q₁) * e₂
  let J : Ideal ↥(wcLlsASbS W A K u b₀) :=
    { carrier := {z | ∃ k : ℕ, ∃ y ∈ 𝔭, ∃ q ∈ Q,
        algebraMap A K u ^ k * (z : K) = algebraMap A K (u ^ k * y + q)}
      add_mem' := by
        rintro z₁ z₂ ⟨k₁, y₁, hy₁, q₁, hq₁, e₁⟩ ⟨k₂, y₂, hy₂, q₂, hq₂, e₂⟩
        refine ⟨k₁ + k₂, y₁ + y₂, 𝔭.add_mem hy₁ hy₂, u ^ k₂ * q₁ + u ^ k₁ * q₂,
          Q.add_mem (Q.mul_mem_left _ hq₁) (Q.mul_mem_left _ hq₂), ?_⟩
        simp only [Subalgebra.coe_add, map_add, map_mul, map_pow] at e₁ e₂ ⊢
        linear_combination algebraMap A K u ^ k₂ * e₁ + algebraMap A K u ^ k₁ * e₂
      zero_mem' := ⟨0, 0, 𝔭.zero_mem, 0, Q.zero_mem, by simp⟩
      smul_mem' := by
        rintro c z ⟨k₂, y₂, hy₂, q₂, hq₂, e₂⟩
        obtain ⟨k₁, c₁, q₁, hq₁, e₁⟩ := hstar (c : K) c.2
        refine ⟨k₁ + k₂, c₁ * y₂, 𝔭.mul_mem_left _ hy₂,
          u ^ k₁ * c₁ * q₂ + u ^ k₂ * y₂ * q₁ + q₁ * q₂,
          Q.add_mem (Q.add_mem (Q.mul_mem_left _ hq₂) (Q.mul_mem_left _ hq₁))
            (Q.mul_mem_left _ hq₂), ?_⟩
        simp only [smul_eq_mul, Subalgebra.coe_mul, map_add, map_mul, map_pow] at e₁ e₂ ⊢
        linear_combination (algebraMap A K u ^ k₂ * (z : K)) * e₁ +
          (algebraMap A K u ^ k₁ * algebraMap A K c₁ + algebraMap A K q₁) * e₂ }
  have hJ : ∀ z, z ∈ J ↔ ∃ k : ℕ, ∃ y ∈ 𝔭, ∃ q ∈ Q,
      algebraMap A K u ^ k * (z : K) = algebraMap A K (u ^ k * y + q) := fun z => Iff.rfl
  have hNJ : wcLlsASbN W A K u b₀ ≤ J := by
    unfold wcLlsASbN
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl
      · exact (hJ _).mpr ⟨0, u, hu𝔭, 0, Q.zero_mem, by simp⟩
      · refine (hJ _).mpr ⟨1, 0, 𝔭.zero_mem, algebraMap ↥W A b₀, hbQ, ?_⟩
        simp only [pow_one, mul_zero, zero_add]
        exact hs
    · rw [Ideal.map_le_iff_le_comap]
      intro μ hμ
      rw [Ideal.mem_comap]
      exact (hJ _).mpr ⟨0, 0, 𝔭.zero_mem, algebraMap ↥W A μ, hQm μ hμ, by simp⟩
  have haN : algebraMap A ↥(wcLlsASbS W A K u b₀) a ∈ wcLlsASbN W A K u b₀ := by
    have := Ideal.sub_mem _ hN hx
    rwa [add_sub_cancel_right] at this
  obtain ⟨k, y, hy, q, hq, e⟩ := (hJ _).mp (hNJ haN)
  have e' : u ^ k * a = u ^ k * y + q := by
    apply IsFractionRing.injective A K
    rw [map_mul, map_pow]
    simpa using e
  have hkq : u ^ k * (a - y) ∈ Q := by
    have : u ^ k * (a - y) = q := by rw [mul_sub, e']; ring
    rw [this]; exact hq
  rcases hQp.mem_or_mem hkq with h1 | h1
  · exact huQ (hQp.mem_of_pow_mem k h1)
  · apply ha
    have := 𝔭.add_mem (hQle h1) hy
    rwa [sub_add_cancel] at this

theorem wcLlsASb_collar_form : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g : ↥W)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.ann u v g) → wcLlsSolvPt W A K L 𝔭 (.ann u v g) y → wcLlsUniq A L 𝔭 y →
    wcLlsBR W A K L 𝔭 (.ann u v g) → Module.finrank K L = ℓ →
    ∀ (α : L) (f₀ : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α →
    ∃ b₀ : ↥W, b₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ b₀ ≠ 0 ∧ b₀ ∣ g ∧ ∃ h : K,
      ((∃ d e : ↥(wcLlsASbS W A K u b₀), d ∉ wcLlsASbN W A K u b₀ ∧
          (d : K) * (f₀ - (h ^ ℓ - h)) = (e : K)) ∨
       (∃ (c : ↥W) (m : ℤ) (d e : ↥(wcLlsASbS W A K u b₀)), c ≠ 0 ∧ ¬ (ℓ : ℤ) ∣ m ∧
          d ∉ wcLlsASbN W A K u b₀ ∧ e ∈ wcLlsASbN W A K u b₀ ∧
          (0 < m → ∃ q ∈ IsLocalRing.maximalIdeal ↥W, c ^ ℓ = b₀ ^ m.toNat * q) ∧
          (d : K) * (algebraMap A K (algebraMap ↥W A c) ^ ℓ * (f₀ - (h ^ ℓ - h))) =
            algebraMap A K u ^ m * ((d : K) + (e : K)))) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g y hPD _ _ _ hfin α f₀
    hα hf₀
  classical

  have hK : ((ℓ : ℕ) : K) = 0 := by
    have h1 : ((ℓ : ℕ) : Ω) = 0 := by rw [← hchar]; exact ringChar.Nat.cast_ringChar
    have h2 : ((ℓ : ℕ) : ↥W) = 0 := by
      apply Subtype.ext
      first
        | simpa using h1
        | exact h1
        | exact (map_natCast W.subtype ℓ).trans h1
    rw [← map_natCast (algebraMap A K), ← map_natCast (algebraMap ↥W A), h2, map_zero, map_zero]
  have hg0 : g ≠ 0 := hPD.2.2.2.2.2.2.1
  have hgm : g ∈ IsLocalRing.maximalIdeal ↥W := hPD.2.2.2.2.2.1
  have huv : u * v = algebraMap ↥W A g := hPD.2.2.2.2.2.2.2.1
  have hpeq : 𝔭 = Ideal.span {u, v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) :=
    hPD.2.2.2.2.2.2.2.2.1
  have hpmax : 𝔭.IsMaximal := hPD.2.2.2.1
  have hmp : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 := hPD.2.2.2.2.1

  have hinj : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
    intro x hx h0
    have h1 : algebraMap ↥W A x = 0 :=
      (IsFractionRing.injective A K) (h0.trans (map_zero _).symm)
    have h2 : x • (1 : A) = 0 := by rw [Algebra.smul_def, mul_one]; exact h1
    haveI := hPD.2.1
    exact hx ((smul_eq_zero.mp h2).resolve_right one_ne_zero)
  have huvK : algebraMap A K u * algebraMap A K v = algebraMap A K (algebraMap ↥W A g) := by
    rw [← map_mul, huv]
  have hu : algebraMap A K u ≠ 0 := by
    intro h0
    apply hinj g hg0
    rw [← huvK, h0, zero_mul]

  obtain ⟨h, lam₁, lam₂, w, n, k, ε₀, ε₁, r₀, r₁, g₀, g₁, hlam₁, hlam₂, hw, hε₀, hε₁, hEQ, hD⟩ :=
    wcLlsASb_boundary_form Ω W hW hWt ℓ hℓ A K L 𝔭 u v g hPD hK α f₀ hα hf₀

  obtain ⟨x, hx⟩ : ∃ x : Ω, x ∉ W := by
    by_contra hcon
    push_neg at hcon
    apply hWt
    first
      | exact top_unique fun y _ => hcon y
      | (ext y; simp [hcon y])
  have hx0 : x ≠ 0 := fun h0 => hx (h0 ▸ W.zero_mem)
  have hxinv : x⁻¹ ∈ W := (W.mem_or_inv_mem x).resolve_left hx
  obtain ⟨z₀, hz₀⟩ : ∃ z₀ : ↥W, (z₀ : Ω) = x⁻¹ := ⟨⟨x⁻¹, hxinv⟩, rfl⟩
  have hz₀0 : z₀ ≠ 0 := by
    rintro rfl
    apply hx0
    have : (x⁻¹ : Ω) = 0 := by rw [← hz₀]; rfl
    exact inv_eq_zero.mp this
  have hz₀m : z₀ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hunit
    obtain ⟨v', hv'⟩ := hunit.exists_right_inv
    apply hx
    have h1 : (z₀ : Ω) * (v' : Ω) = 1 := by
      have := congrArg Subtype.val hv'
      first
        | exact this
        | simpa using this
    rw [hz₀] at h1
    have h2 : x = (v' : Ω) := by
      calc x = x * (x⁻¹ * (v' : Ω)) := by rw [h1, mul_one]
        _ = (v' : Ω) := by rw [← mul_assoc, mul_inv_cancel₀ hx0, one_mul]
    rw [h2]
    exact v'.2

  have rootW : ∀ N : ℕ, 0 < N → ∀ z : ↥W, ∃ r : ↥W, r ^ N = z := by
    intro N hN z
    obtain ⟨r, hr⟩ := IsAlgClosed.exists_pow_nat_eq (z : Ω) hN
    by_cases hrW : r ∈ W
    · refine ⟨⟨r, hrW⟩, Subtype.ext ?_⟩
      first
        | simpa using hr
        | exact hr
    · exfalso
      have hr0 : r ≠ 0 := fun h0 => hrW (h0 ▸ W.zero_mem)
      have hrinv : r⁻¹ ∈ W := (W.mem_or_inv_mem r).resolve_left hrW
      obtain ⟨N', rfl⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by omega⟩
      have h1 : r = (z : Ω) * r⁻¹ ^ N' := by
        rw [← hr, inv_pow, pow_succ, mul_assoc, mul_comm r, ← mul_assoc,
          mul_inv_cancel₀ (pow_ne_zero _ hr0), one_mul]
      apply hrW
      rw [h1]
      exact mul_mem z.2 (pow_mem hrinv N')

  have hdivm : ∀ x' : ↥W, x' ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ z ∈ IsLocalRing.maximalIdeal ↥W, z ≠ 0 ∧ z ∣ x' := by
    intro x' hx'
    by_cases h0 : x' = 0
    · refine ⟨z₀, hz₀m, hz₀0, ?_⟩
      rw [h0]; exact dvd_zero z₀
    · exact ⟨x', hx', h0, dvd_rfl⟩
  have hmin2 : ∀ x₁ x₂ : ↥W, x₁ ∈ IsLocalRing.maximalIdeal ↥W →
      x₂ ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ z ∈ IsLocalRing.maximalIdeal ↥W, z ≠ 0 ∧ z ∣ x₁ ∧ z ∣ x₂ := by
    intro x₁ x₂ h₁ h₂
    obtain ⟨z₁, hz₁m, hz₁0, hz₁⟩ := hdivm x₁ h₁
    obtain ⟨z₂, hz₂m, hz₂0, hz₂⟩ := hdivm x₂ h₂
    rcases ValuationRing.dvd_total z₁ z₂ with hd | hd
    · exact ⟨z₁, hz₁m, hz₁0, hz₁, hd.trans hz₂⟩
    · exact ⟨z₂, hz₂m, hz₂0, hd.trans hz₁, hz₂⟩
  have hpick : ∀ N : ℕ, 0 < N → ∀ x₁ x₂ x₃ : ↥W, x₁ ∈ IsLocalRing.maximalIdeal ↥W →
      x₂ ∈ IsLocalRing.maximalIdeal ↥W → x₃ ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ e : ↥W, e ∈ IsLocalRing.maximalIdeal ↥W ∧ e ≠ 0 ∧ e ^ N ∣ x₁ ∧ e ^ N ∣ x₂ ∧
        e ^ N ∣ x₃ := by
    intro N hN x₁ x₂ x₃ h₁ h₂ h₃
    obtain ⟨z₁, hz₁m, -, hz₁x₁, hz₁x₂⟩ := hmin2 x₁ x₂ h₁ h₂
    obtain ⟨z, hzm, hz0, hzz₁, hzx₃⟩ := hmin2 z₁ x₃ hz₁m h₃
    obtain ⟨e, he⟩ := rootW N hN z
    refine ⟨e, ?_, ?_, ?_, ?_, ?_⟩
    · apply (IsLocalRing.maximalIdeal.isMaximal ↥W).isPrime.mem_of_pow_mem N
      rw [he]; exact hzm
    · rintro rfl
      apply hz0
      rw [← he, zero_pow hN.ne']
    · rw [he]; exact hzz₁.trans hz₁x₁
    · rw [he]; exact hzz₁.trans hz₁x₂
    · rw [he]; exact hzx₃

  have hS : ∀ b : ↥W, ∃ sS : ↥(wcLlsASbS W A K u b),
      (sS : K) = algebraMap A K (algebraMap ↥W A b) / algebraMap A K u ∧
      sS ∈ wcLlsASbN W A K u b ∧
      algebraMap A K u * (sS : K) = algebraMap A K (algebraMap ↥W A b) := by
    intro b
    refine ⟨⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K u,
      Algebra.subset_adjoin (Set.mem_singleton _)⟩, rfl, ?_, ?_⟩
    · unfold wcLlsASbN
      exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    · show algebraMap A K u * (algebraMap A K (algebraMap ↥W A b) / algebraMap A K u) = _
      field_simp
  have huN : ∀ b : ↥W, algebraMap A ↥(wcLlsASbS W A K u b) u ∈ wcLlsASbN W A K u b := by
    intro b
    unfold wcLlsASbN
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hmN : ∀ b z : ↥W, z ∈ IsLocalRing.maximalIdeal ↥W →
      algebraMap A ↥(wcLlsASbS W A K u b) (algebraMap ↥W A z) ∈ wcLlsASbN W A K u b := by
    intro b z hz
    unfold wcLlsASbN
    exact Ideal.mem_sup_right
      (Ideal.mem_map_of_mem ((algebraMap A ↥(wcLlsASbS W A K u b)).comp (algebraMap ↥W A)) hz)
  have hpN : ∀ b : ↥W, b ∣ g → ∀ a ∈ 𝔭,
      algebraMap A ↥(wcLlsASbS W A K u b) a ∈ wcLlsASbN W A K u b := by
    intro b hbg
    obtain ⟨g', hg'⟩ := hbg
    obtain ⟨sS, hsS, hsSN, hUs⟩ := hS b
    have hle : 𝔭 ≤ (wcLlsASbN W A K u b).comap (algebraMap A ↥(wcLlsASbS W A K u b)) := by
      rw [hpeq, sup_le_iff, Ideal.span_le, Ideal.map_le_iff_le_comap]
      constructor
      · intro z hz
        rcases hz with rfl | hz
        · exact huN b
        · rw [Set.mem_singleton_iff] at hz
          rw [hz]
          show algebraMap A ↥(wcLlsASbS W A K u b) v ∈ wcLlsASbN W A K u b
          have hv : algebraMap A ↥(wcLlsASbS W A K u b) v =
              algebraMap A _ (algebraMap ↥W A g') * sS := by
            apply Subtype.ext
            simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
            apply mul_left_cancel₀ hu
            rw [huvK, hg', map_mul, map_mul, ← hUs]
            ring
          rw [hv]
          exact Ideal.mul_mem_left _ _ hsSN
      · intro z hz
        exact hmN b z hz
    intro a ha
    exact hle ha
  have hunit : ∀ b : ↥W, b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → b ∣ g →
      ∀ a : A, a ∉ 𝔭 → ∀ P : ↥(wcLlsASbS W A K u b),
      P - algebraMap A _ a ∈ wcLlsASbN W A K u b → P ∉ wcLlsASbN W A K u b := by
    intro b hb hb0 hbg a ha P hP
    have h1 := wcLlsASb_node_unit Ω W A K 𝔭 u v g b hPD hb hb0 hbg a ha _ hP
    have e1 : algebraMap A ↥(wcLlsASbS W A K u b) a + (P - algebraMap A _ a) = P := by abel
    rw [e1] at h1
    exact h1

  have hchart : ∀ b : ↥W, ∀ j : ℕ, b ^ (j + 1) ∣ g → b ^ j ∣ w → ∀ ε r g' : A,
      ∃ P : ↥(wcLlsASbS W A K u b), P - algebraMap A _ ε ∈ wcLlsASbN W A K u b ∧
        algebraMap A K (u ^ j * ε + v * r + algebraMap ↥W A w * g') =
          algebraMap A K u ^ j * (P : K) := by
    intro b j hgj hwj ε r g'
    obtain ⟨g'', hg''⟩ := hgj
    obtain ⟨w', hw'⟩ := hwj
    obtain ⟨sS, hsS, hsSN, hUs⟩ := hS b
    refine ⟨algebraMap A _ ε + algebraMap A _ (algebraMap ↥W A g'' * r) * sS ^ (j + 1) +
      algebraMap A _ (algebraMap ↥W A w' * g') * sS ^ j, ?_, ?_⟩
    · rw [add_assoc, add_sub_cancel_left]
      apply Ideal.add_mem
      · apply Ideal.mul_mem_left
        rw [pow_succ]
        exact Ideal.mul_mem_left _ _ hsSN
      · rcases j with _ | j
        · rw [pow_zero, mul_one, map_mul]
          apply Ideal.mul_mem_right
          apply hmN b w'
          rw [pow_zero, one_mul] at hw'
          rw [← hw']
          exact hw
        · apply Ideal.mul_mem_left
          rw [pow_succ]
          exact Ideal.mul_mem_left _ _ hsSN
    · have hE1 : algebraMap A K (algebraMap ↥W A b) ^ j =
          algebraMap A K u ^ j * (sS : K) ^ j := by
        rw [← hUs, mul_pow]
      have hv' : algebraMap A K v =
          algebraMap A K u ^ j * (sS : K) ^ (j + 1) * algebraMap A K (algebraMap ↥W A g'') := by
        apply mul_left_cancel₀ hu
        rw [huvK, hg'', map_mul, map_mul, map_pow, map_pow, ← hUs]
        ring
      rw [hw']
      simp only [map_add, map_mul, map_pow, Subalgebra.coe_add, Subalgebra.coe_mul,
        Subalgebra.coe_pow, Subalgebra.coe_algebraMap]
      linear_combination algebraMap A K r * hv' +
        algebraMap A K (algebraMap ↥W A w') * algebraMap A K g' * hE1

  by_cases hE : lam₂ ∣ lam₁ ∧ (n ≤ k ∨ ∃ lam' : ↥W, lam₁ = lam₂ * lam' ∧
      lam' ∈ IsLocalRing.maximalIdeal ↥W)
  · obtain ⟨⟨lam', hlam'⟩, hnk⟩ := hE
    rcases le_or_gt n k with hnk' | hnk'
    ·
      obtain ⟨d, rfl⟩ : ∃ d, k = n + d := ⟨k - n, by omega⟩
      obtain ⟨e, he, he0, heg, hew, -⟩ := hpick (n + (n + d) + 2) (by omega) g w 0 hgm hw
        (IsLocalRing.maximalIdeal ↥W).zero_mem
      have heg1 : e ∣ g := (dvd_pow_self e (by omega)).trans heg
      refine ⟨e, he, he0, heg1, h, Or.inl ?_⟩
      obtain ⟨P₀, -, hP₀⟩ := hchart e (n + d) ((pow_dvd_pow e (by omega)).trans heg)
        ((pow_dvd_pow e (by omega)).trans hew) ε₀ r₀ g₀
      obtain ⟨P₁, hP₁N, hP₁⟩ := hchart e n ((pow_dvd_pow e (by omega)).trans heg)
        ((pow_dvd_pow e (by omega)).trans hew) ε₁ r₁ g₁
      rw [hP₀, hP₁, hlam'] at hEQ
      simp only [map_mul] at hEQ
      refine ⟨P₁, algebraMap A _ (algebraMap ↥W A lam') * algebraMap A _ u ^ d * P₀,
        hunit e he he0 heg1 ε₁ hε₁ P₁ hP₁N, ?_⟩
      apply mul_right_cancel₀ (mul_ne_zero (pow_ne_zero n hu) (hinj lam₂ hlam₂))
      simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap]
      linear_combination hEQ
    ·
      obtain ⟨d, rfl⟩ : ∃ d, n = k + d := ⟨n - k, by omega⟩
      have hd : 0 < d := by omega
      obtain ⟨lam'', hlam'', hlam''m⟩ : ∃ lam'' : ↥W, lam₁ = lam₂ * lam'' ∧
          lam'' ∈ IsLocalRing.maximalIdeal ↥W := by
        rcases hnk with h' | h'
        · exact absurd h' (by omega)
        · exact h'
      obtain ⟨e, he, he0, heg, hew, hel⟩ := hpick (k + d + k + 2) (by omega) g w lam'' hgm hw
        hlam''m
      have heg1 : e ∣ g := (dvd_pow_self e (by omega)).trans heg
      refine ⟨e, he, he0, heg1, h, Or.inl ?_⟩
      obtain ⟨lam3, hlam3⟩ : e ^ d ∣ lam'' := (pow_dvd_pow e (by omega)).trans hel
      obtain ⟨sS, hsS, hsSN, hUs⟩ := hS e
      obtain ⟨P₀, -, hP₀⟩ := hchart e k ((pow_dvd_pow e (by omega)).trans heg)
        ((pow_dvd_pow e (by omega)).trans hew) ε₀ r₀ g₀
      obtain ⟨P₁, hP₁N, hP₁⟩ := hchart e (k + d) ((pow_dvd_pow e (by omega)).trans heg)
        ((pow_dvd_pow e (by omega)).trans hew) ε₁ r₁ g₁
      rw [hP₀, hP₁, hlam'', hlam3] at hEQ
      simp only [map_mul, map_pow] at hEQ
      have hEd : algebraMap A K (algebraMap ↥W A e) ^ d = algebraMap A K u ^ d * (sS : K) ^ d := by
        rw [← hUs, mul_pow]
      refine ⟨P₁, algebraMap A _ (algebraMap ↥W A lam3) * sS ^ d * P₀,
        hunit e he he0 heg1 ε₁ hε₁ P₁ hP₁N, ?_⟩
      apply mul_right_cancel₀ (mul_ne_zero (pow_ne_zero (k + d) hu) (hinj lam₂ hlam₂))
      simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap]
      linear_combination hEQ + algebraMap A K (algebraMap ↥W A lam₂) *
        algebraMap A K (algebraMap ↥W A lam3) * algebraMap A K u ^ k * (P₀ : K) * hEd
  ·
    have hI : ¬ (ℓ : ℤ) ∣ ((k : ℤ) - n) := hD.resolve_left hE
    obtain ⟨q₁, hq₁, hq₁m⟩ : ∃ q₁ : ↥W, lam₂ = lam₁ * q₁ ∧
        (n < k → q₁ ∈ IsLocalRing.maximalIdeal ↥W) := by
      by_cases h21 : lam₂ ∣ lam₁
      · obtain ⟨lam', hlam'⟩ := h21
        have hnk : k < n := by
          by_contra hcon
          exact hE ⟨⟨lam', hlam'⟩, Or.inl (by omega)⟩
        have hlam'u : IsUnit lam' := by
          by_contra hnu
          exact hE ⟨⟨lam', hlam'⟩, Or.inr ⟨lam', hlam', (IsLocalRing.mem_maximalIdeal _).mpr hnu⟩⟩
        obtain ⟨v', hv'⟩ := hlam'u
        refine ⟨↑v'⁻¹, ?_, fun h' => absurd h' (by omega)⟩
        rw [hlam', ← hv', mul_assoc, Units.mul_inv, mul_one]
      · rcases ValuationRing.dvd_total lam₁ lam₂ with ⟨q₁, hq⟩ | h12
        · refine ⟨q₁, hq, fun _ => ?_⟩
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          rintro ⟨v', hv'⟩
          apply h21
          exact ⟨↑v'⁻¹, by rw [hq, ← hv', mul_assoc, Units.mul_inv, mul_one]⟩
        · exact absurd h12 h21
    have hq₁0 : q₁ ≠ 0 := by
      rintro rfl
      exact hlam₂ (by rw [hq₁, mul_zero])

    obtain ⟨y₁, i₁, hi₁, hyx⟩ := hpmax.exists_inv hε₁
    obtain ⟨γ, hγ'⟩ := wcLlsASb_residue_lift Ω W A 𝔭 hPD.1 hpmax hmp (ε₀ * y₁)
    have hγ : ε₀ - algebraMap ↥W A γ * ε₁ ∈ 𝔭 := by
      have e1 : ε₀ - algebraMap ↥W A γ * ε₁ =
          (ε₀ * y₁ - algebraMap ↥W A γ) * ε₁ + ε₀ * i₁ := by
        linear_combination (-ε₀) * hyx
      rw [e1]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hγ') (Ideal.mul_mem_left _ _ hi₁)
    have hγu : IsUnit γ := by
      by_contra hnu
      have hγm : γ ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal _).mpr hnu
      apply hε₀
      have h1 : algebraMap ↥W A γ ∈ 𝔭 := hmp (Ideal.mem_map_of_mem _ hγm)
      have e1 : ε₀ = (ε₀ - algebraMap ↥W A γ * ε₁) + algebraMap ↥W A γ * ε₁ := by ring
      rw [e1]
      exact Ideal.add_mem _ hγ (Ideal.mul_mem_right _ _ h1)
    obtain ⟨γu, rfl⟩ := hγu
    have hγp : algebraMap ↥W A (γu : ↥W) ∉ 𝔭 := by
      intro hm
      apply hpmax.ne_top
      exact Ideal.eq_top_of_isUnit_mem _ hm ((γu.isUnit).map (algebraMap ↥W A))
    obtain ⟨c, hc⟩ := rootW ℓ hℓ.pos (q₁ * ↑γu⁻¹)
    have hc0 : c ≠ 0 := by
      rintro rfl
      apply hq₁0
      have h1 : q₁ * ↑γu⁻¹ = 0 := by rw [← hc, zero_pow hℓ.ne_zero]
      have h2 : q₁ = q₁ * ↑γu⁻¹ * ↑γu := by rw [mul_assoc, Units.inv_mul, mul_one]
      rw [h2, h1, zero_mul]
    have hcm : n < k → c ^ ℓ ∈ IsLocalRing.maximalIdeal ↥W := by
      intro hnk
      rw [hc]
      exact Ideal.mul_mem_right _ _ (hq₁m hnk)
    obtain ⟨e, he, he0, heg, hew, heq⟩ := hpick (n + k + 2) (by omega) g w
      (if n < k then c ^ ℓ else 0) hgm hw
      (by
        split_ifs with hnk
        · exact hcm hnk
        · exact (IsLocalRing.maximalIdeal ↥W).zero_mem)
    have heg1 : e ∣ g := (dvd_pow_self e (by omega)).trans heg
    refine ⟨e, he, he0, heg1, h, Or.inr ?_⟩
    obtain ⟨P₀, hP₀N, hP₀⟩ := hchart e k ((pow_dvd_pow e (by omega)).trans heg)
      ((pow_dvd_pow e (by omega)).trans hew) ε₀ r₀ g₀
    obtain ⟨P₁, hP₁N, hP₁⟩ := hchart e n ((pow_dvd_pow e (by omega)).trans heg)
      ((pow_dvd_pow e (by omega)).trans hew) ε₁ r₁ g₁
    rw [hP₀, hP₁, hq₁] at hEQ
    simp only [map_mul] at hEQ
    have h1 : algebraMap A K (algebraMap ↥W A lam₁) *
        ((f₀ - (h ^ ℓ - h)) * algebraMap A K u ^ n * (P₁ : K) * algebraMap A K (algebraMap ↥W A q₁) -
          algebraMap A K u ^ k * (P₀ : K)) = 0 := by
      linear_combination hEQ
    have h2 := (mul_eq_zero.mp h1).resolve_left (hinj lam₁ hlam₁)
    have hγc : algebraMap A K (algebraMap ↥W A (γu : ↥W)) * algebraMap A K (algebraMap ↥W A c) ^ ℓ =
        algebraMap A K (algebraMap ↥W A q₁) := by
      rw [← map_pow, ← map_pow, ← map_mul, ← map_mul, hc, mul_left_comm, Units.mul_inv, mul_one]
    refine ⟨c, (k : ℤ) - n, algebraMap A _ (algebraMap ↥W A (γu : ↥W)) * P₁,
      P₀ - algebraMap A _ (algebraMap ↥W A (γu : ↥W)) * P₁, hc0, hI, ?_, ?_, ?_, ?_⟩
    · apply hunit e he he0 heg1 (algebraMap ↥W A (γu : ↥W) * ε₁)
        (fun hm => (hpmax.isPrime.mem_or_mem hm).elim hγp hε₁)
      rw [map_mul, ← mul_sub]
      exact Ideal.mul_mem_left _ _ hP₁N
    · have e1 : P₀ - algebraMap A ↥(wcLlsASbS W A K u e) (algebraMap ↥W A (γu : ↥W)) * P₁ =
          (P₀ - algebraMap A _ ε₀) -
            algebraMap A _ (algebraMap ↥W A (γu : ↥W)) * (P₁ - algebraMap A _ ε₁) +
            algebraMap A _ (ε₀ - algebraMap ↥W A (γu : ↥W) * ε₁) := by
        rw [map_sub, map_mul]; ring
      rw [e1]
      exact Ideal.add_mem _ (Ideal.sub_mem _ hP₀N (Ideal.mul_mem_left _ _ hP₁N))
        (hpN e heg1 _ hγ)
    · intro hm
      have hnk : n < k := by omega
      rw [if_pos hnk] at heq
      have htn : ((k : ℤ) - n).toNat = k - n := by omega
      obtain ⟨t, ht⟩ : e ^ (k - n + 1) ∣ c ^ ℓ := (pow_dvd_pow e (by omega)).trans heq
      refine ⟨e * t, Ideal.mul_mem_right _ _ he, ?_⟩
      rw [htn, ht, pow_succ, mul_assoc]
    · simp only [Subalgebra.coe_sub, Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
      rw [zpow_sub₀ hu, zpow_natCast, zpow_natCast, div_mul_eq_mul_div,
        eq_div_iff (pow_ne_zero _ hu)]
      linear_combination h2 + (f₀ - (h ^ ℓ - h)) * (P₁ : K) * algebraMap A K u ^ n * hγc

theorem wcLlsASb_integral_node : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g b₀ : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) → b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 → b₀ ∣ g →
    ((ℓ : ℕ) : K) = 0 → Module.finrank K L = ℓ →
    ∀ (α : L) (f₀ h : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α →
    (∃ d e : ↥(wcLlsASbS W A K u b₀), d ∉ wcLlsASbN W A K u b₀ ∧
      (d : K) * (f₀ - (h ^ ℓ - h)) = (e : K)) →
    wcLlsAnnSep W A K L u b₀ :=
by
  intro Ω _ _ W hW hWt ℓ hℓ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g b₀ hPD hb₀m hb₀0 hb₀g hK hfr
    α f₀ h hα hf₀ hde_ex
  obtain ⟨d, e, hd, hde⟩ := hde_ex
  classical

  obtain ⟨hft, hnzd, hic, hmax, hm𝔭, hgm, hg0, huv, h𝔭eq, -⟩ := id hPD
  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    have h1 : w • (1 : A) = 0 := by rw [Algebra.smul_def, hw, zero_mul]
    rcases smul_eq_zero.mp h1 with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hinjAK := IsFractionRing.injective A K
  have hû : algebraMap A K u ≠ 0 := by
    intro h
    have hu0 : u = 0 := hinjAK (by rw [h, map_zero])
    apply hg0
    apply hWA
    rw [map_zero, ← huv, hu0, zero_mul]

  obtain ⟨A', iCR, iDom, iWA, iAK, iFr, iAL, iTow, u', v', 𝔭', hBr, hu', hv', hPD', hSep, -, -⟩ :=
    wcpa_dj_llsm_br_boundary_chart Ω W hW hWt A K L 𝔭 (.ann u v g) u b₀ hPD
      (Or.inr ⟨v, g, rfl, hb₀g⟩) hb₀m hb₀0
  obtain ⟨hft', hnzd', hic', hmax', hm𝔭', -, -, -, h𝔭'eq, -⟩ := id hPD'

  show wcLlsSepAt W A K L u (algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u)
  rw [hSep b₀ hb₀m hb₀0 (dvd_refl b₀)]
  apply wcpa_dj_llsm_br_ann_node_sep Ω W hW hWt A' K L 𝔭' u' v' b₀ hPD'
  intro y hy hyc hy'

  obtain ⟨hBrW, hBrS, -⟩ := id hBr
  obtain ⟨d', hd'⟩ := hBrS d.2
  obtain ⟨e', he'⟩ := hBrS e.2
  have hd'𝔭 : d' ∉ 𝔭' := wcpa_dj_llsm_kpwbe_node_transfer W A K A' 𝔭 u v g b₀ u' v' 𝔭' hPD
    hb₀g hû (IsFractionRing.injective A' K) hBr hu' hv' h𝔭'eq hmax'.ne_top d d' hd hd'
  have hd'0 : d' ≠ 0 := fun h => hd'𝔭 (h ▸ 𝔭'.zero_mem)

  have hℓA' : ((ℓ : ℕ) : A') = 0 :=
    IsFractionRing.injective A' K (by rw [map_natCast, map_zero, hK])
  have hℓL : ((ℓ : ℕ) : L) = 0 := by
    rw [← map_natCast (algebraMap K L), hK, map_zero]
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : CharP L ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hℓL
  have hℓP : ((ℓ : ℕ) : Polynomial A') = 0 := by
    have h1 : ((ℓ : ℕ) : Polynomial A') = Polynomial.C ((ℓ : ℕ) : A') :=
      (map_natCast Polynomial.C ℓ).symm
    rw [h1, hℓA', map_zero]

  have hAKL : ∀ x : A', algebraMap A' L x = algebraMap K L (algebraMap A' K x) :=
    fun x => IsScalarTower.algebraMap_apply A' K L x
  have hdeL : algebraMap A' L d' * (α ^ ℓ - α - (algebraMap K L h ^ ℓ - algebraMap K L h)) =
      algebraMap A' L e' := by
    have h1 := congrArg (algebraMap K L) hde
    simp only [map_mul, map_sub, map_pow] at h1
    rw [hAKL, hAKL, hd', he', ← hf₀]
    exact h1

  obtain ⟨x, hxdef⟩ : ∃ x : L, x = algebraMap A' L d' * (α - algebraMap K L h) := ⟨_, rfl⟩
  obtain ⟨Q, hQdef⟩ : ∃ Q : Polynomial A', Q = Polynomial.X ^ ℓ -
      (Polynomial.C (d' ^ (ℓ - 1)) * Polynomial.X + Polynomial.C (d' ^ (ℓ - 1) * e')) := ⟨_, rfl⟩
  have hQm : Q.Monic := by
    rw [hQdef]
    exact Polynomial.monic_X_pow_sub
      (lt_of_le_of_lt Polynomial.degree_linear_le (by exact_mod_cast hℓ.one_lt))
  have hQd : Q.natDegree = ℓ := by
    rw [hQdef, Polynomial.natDegree_sub_eq_left_of_natDegree_lt] <;>
      rw [Polynomial.natDegree_X_pow]
    exact lt_of_le_of_lt Polynomial.natDegree_linear_le hℓ.one_lt
  have hfrob : (α - algebraMap K L h) ^ ℓ = α ^ ℓ - algebraMap K L h ^ ℓ := sub_pow_char _ _
  have hDℓ : algebraMap A' L d' ^ ℓ = algebraMap A' L d' ^ (ℓ - 1) * algebraMap A' L d' := by
    rw [← pow_succ]
    congr 1
    have := hℓ.one_lt
    omega
  have hQx : Polynomial.aeval x Q = 0 := by
    rw [hQdef]
    simp only [map_sub, map_add, map_mul, Polynomial.aeval_X_pow, Polynomial.aeval_X,
      Polynomial.aeval_C, map_pow]
    rw [hxdef, mul_pow, hfrob, hDℓ]
    linear_combination (algebraMap A' L d' ^ (ℓ - 1)) * hdeL
  have hQ' : Polynomial.derivative Q = Polynomial.C (-(d' ^ (ℓ - 1))) := by
    rw [hQdef, Polynomial.derivative_sub, Polynomial.derivative_add, Polynomial.derivative_X_pow,
      Polynomial.derivative_C_mul_X, Polynomial.derivative_C]
    simp only [hℓA', hℓP, map_zero, zero_mul, add_zero, zero_sub, Polynomial.C_neg]
  have hxint : IsIntegral A' x := ⟨Q, hQm, by rw [← Polynomial.aeval_def]; exact hQx⟩
  obtain ⟨xB, hxB⟩ : ∃ xB : ↥(integralClosure A' L), (xB : L) = x :=
    ⟨⟨x, (mem_integralClosure_iff A' L).mpr hxint⟩, rfl⟩

  have hdL0 : algebraMap A' L d' ≠ 0 := by
    rw [hAKL]
    exact (map_ne_zero _).mpr
      (fun h => hd'0 ((IsFractionRing.injective A' K) (by rw [h, map_zero])))
  have hxK : x ∉ Set.range (algebraMap K L) := by
    rintro ⟨k, hk⟩
    apply hα
    refine ⟨h + k / algebraMap A' K d', ?_⟩
    rw [map_add, map_div₀, hk, ← hAKL, hxdef, mul_div_cancel_left₀ _ hdL0]
    ring

  obtain ⟨r, hr⟩ := wcpa_dj_llsm_kpwbe_residue_const Ω W (wcpa_dj_nc_residue_algclosed Ω W) A'
    ↥(integralClosure A' L) 𝔭' y hft' hmax' hm𝔭' hy hyc xB
  obtain ⟨ϑB, hϑBdef⟩ : ∃ z : ↥(integralClosure A' L),
      z = xB - algebraMap A' ↥(integralClosure A' L) (algebraMap ↥W A' r) := ⟨_, rfl⟩
  have hϑy : ϑB ∈ y := hϑBdef ▸ hr
  have hϑval : (ϑB : L) = x - algebraMap A' L (algebraMap ↥W A' r) := by
    rw [hϑBdef, ← hxB]; rfl

  have hPm : (Q.comp (Polynomial.X + Polynomial.C (algebraMap ↥W A' r))).Monic :=
    hQm.comp_X_add_C _
  have hPd : (Q.comp (Polynomial.X + Polynomial.C (algebraMap ↥W A' r))).natDegree = ℓ := by
    rw [Polynomial.natDegree_comp, Polynomial.natDegree_X_add_C, mul_one, hQd]
  have hPϑ : Polynomial.aeval (ϑB : L)
