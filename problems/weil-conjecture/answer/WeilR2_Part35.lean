by
  classical
  intro Ω _ _ W hdim hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hSolv hUniq hBR hdeg
    α hα1 hα2
  obtain ⟨f, hf⟩ := hα2
  obtain ⟨_, hNZ, _, hmax𝔭, _⟩ := id hPD
  have hp : 𝔭.IsPrime := hmax𝔭.isPrime
  have hWA : Function.Injective (algebraMap ↥W A) := by
    haveI := hNZ
    intro x y' hxy
    rw [← sub_eq_zero]
    have h0 : algebraMap ↥W A (x - y') = 0 := by rw [map_sub, hxy, sub_self]
    rw [Algebra.algebraMap_eq_smul_one] at h0
    exact (smul_eq_zero.mp h0).resolve_right one_ne_zero
  have hinj : Function.Injective ((algebraMap A K).comp (algebraMap ↥W A)) :=
    fun x y' h => hWA (IsFractionRing.injective A K
      (by rw [RingHom.comp_apply, RingHom.comp_apply] at h; exact h))
  obtain ⟨ι, hι⟩ : ∃ ι : Ω →+* K, ∀ x : ↥W,
      ι (x : Ω) = algebraMap A K (algebraMap ↥W A x) :=
    ⟨IsFractionRing.lift hinj, fun x => IsFractionRing.lift_algebraMap hinj x⟩
  have hK : ((ℓ : ℕ) : K) = 0 := by
    have h1 : ((ℓ : ℕ) : Ω) = 0 := by rw [← hchar]; exact ringChar.Nat.cast_ringChar
    rw [← map_natCast ι, h1, map_zero]
  have hf' : α ^ ℓ - α = algebraMap K L f := hf.symm
  by_contra hneg
  have hstep : ∀ c₀ b₀ : ↥W, c₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ∈ IsLocalRing.maximalIdeal ↥W →
      b₀ ≠ 0 → wcLlsDiscSep W A K L t c₀ b₀ → ∃ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W ∧
        b' ∈ IsLocalRing.maximalIdeal ↥W ∧ b' ≠ 0 ∧ b₀ ∣ c' - c₀ ∧ wcLlsDiscSep W A K L t c' b' ∧
        ¬ b' ∣ b₀ := by
    intro c₀ b₀ hc hb hb0 hS
    by_contra hno
    apply hneg
    refine ⟨c₀, b₀, hc, hb, hb0, hS, ?_⟩
    intro c' b' hc' hb' hb0' hd hS'
    by_contra hnd
    exact hno ⟨c', b', hc', hb', hb0', hd, hS', hnd⟩
  obtain ⟨c, b, hH, hcb, hbb, hnbb, hnc⟩ := wcLlsASvm_hchain Ω W hdim hWt ℓ hℓ hchar A K L 𝔭 t y
    hPD hSolv hUniq hBR hdeg α hα1 ⟨f, hf⟩ hstep
  have hcm : ∀ i, c i ∈ IsLocalRing.maximalIdeal ↥W := fun i => (hH i).1
  have hbm : ∀ i, b i ∈ IsLocalRing.maximalIdeal ↥W := fun i => (hH i).2.1
  have hb0 : ∀ i, b i ≠ 0 := fun i => (hH i).2.2.1
  obtain ⟨P, w, μ, i₀, hw0, hμm, hsmall⟩ := wcLlsASvm_poly_approx Ω W hdim hWt A K 𝔭 t hPD c b
    hcm hbm hb0 hcb hbb hnbb hnc f
  obtain ⟨Q, hQ⟩ : ∃ Q : Polynomial Ω,
      Q = Polynomial.C ((w : Ω)⁻¹) * P.map (algebraMap ↥W Ω) := ⟨_, rfl⟩
  have hjc : ι.comp (algebraMap ↥W Ω) = (algebraMap A K).comp (algebraMap ↥W A) := by
    ext x; exact hι x
  have hQev : Q.eval₂ ι (algebraMap A K t) =
      Polynomial.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K t) P /
        algebraMap A K (algebraMap ↥W A w) := by
    rw [hQ, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_map, hjc, map_inv₀, hι w,
      div_eq_inv_mul]
  obtain ⟨H, β, i₁, hred⟩ := wcLlsASvm_poly_reduce Ω W hdim hWt ℓ hℓ hchar c b hcm hbm hb0 hcb
    hbb hnbb hnc Q
  obtain ⟨δ, hδ⟩ := hred (max i₀ i₁) (le_max_right _ _)
  have hsm := hsmall (max i₀ i₁) (le_max_left _ _)
  generalize max i₀ i₁ = i at hδ hsm
  generalize hG : H + Polynomial.C δ = G at hδ
  obtain ⟨_, _, _, _, hnGE, e', hnIS, _⟩ := hH i
  rw [← hQev] at hsm
  set S := wcLlsScS W A K t (c i) (b i) with hS
  have hjb : algebraMap A K (algebraMap ↥W A (b i)) ≠ 0 := by
    intro h0
    apply hb0 i
    apply hinj
    rw [map_zero]
    exact h0
  have hTS : algebraMap A K t = algebraMap A K (algebraMap ↥W A (c i)) +
      algebraMap A K (algebraMap ↥W A (b i)) * S := by
    rw [hS, wcLlsScS, map_sub, mul_div_cancel₀ _ hjb]; ring
  have hpt : ι ((c i : ↥W) : Ω) + ι ((b i : ↥W) : Ω) * S = algebraMap A K t := by
    rw [hι, hι]; exact hTS.symm
  set E' : Polynomial Ω := (Q - G ^ ℓ + G).comp (Polynomial.C ((c i : ↥W) : Ω) +
      Polynomial.C ((b i : ↥W) : Ω) * Polynomial.X) -
      Polynomial.C (β * ((b i : ↥W) : Ω)) * Polynomial.X with hE'
  have hE'c : ∀ k, W.valuation (E'.coeff k) < max 1 (W.valuation (β * ((b i : ↥W) : Ω))) := hδ
  have hkey : E'.eval₂ ι S = Q.eval₂ ι (algebraMap A K t) - (G.eval₂ ι (algebraMap A K t)) ^ ℓ +
      G.eval₂ ι (algebraMap A K t) - ι (β * ((b i : ↥W) : Ω)) * S := by
    rw [hE']
    simp only [Polynomial.eval₂_sub, Polynomial.eval₂_add, Polynomial.eval₂_pow,
      Polynomial.eval₂_comp, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X, hpt]

  have hz : ∀ ν : ↥W, wcLlsVmSmall W A K 𝔭 t (c i) (b i) ν 0 := by
    intro ν
    refine ⟨0, 1, 1, ?_, ?_, ?_⟩
    · exact fun h1 => hp.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
    · rw [map_one, sub_self]; exact Ideal.zero_mem _
    · simp
  have hadd : ∀ (μ₁ μ₂ q : ↥W) (E₁ E₂ : K), μ₁ = μ₂ * q →
      wcLlsVmSmall W A K 𝔭 t (c i) (b i) μ₁ E₁ → wcLlsVmSmall W A K 𝔭 t (c i) (b i) μ₂ E₂ →
      wcLlsVmSmall W A K 𝔭 t (c i) (b i) μ₂ (E₁ + E₂) := by
    rintro μ₁ μ₂ q E₁ E₂ rfl ⟨x₁, d₁, a₁, ha₁, hd₁, he₁⟩ ⟨x₂, d₂, a₂, ha₂, hd₂, he₂⟩
    refine ⟨algebraMap A _ (algebraMap ↥W A q) * x₁ * d₂ + x₂ * d₁, d₁ * d₂, a₁ * a₂, ?_, ?_, ?_⟩
    · exact fun hm => (hp.mem_or_mem hm).elim ha₁ ha₂
    · have e : d₁ * d₂ - algebraMap A _ (a₁ * a₂) = (d₁ - algebraMap A _ a₁) * d₂ +
          algebraMap A _ a₁ * (d₂ - algebraMap A _ a₂) := by rw [map_mul]; ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hd₁) (Ideal.mul_mem_left _ _ hd₂)
    · simp only [Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
      rw [map_mul, map_mul] at he₁
      linear_combination (d₂ : K) * he₁ + (d₁ : K) * he₂
  have hscale : ∀ (ν μ₀ : ↥W) (E : K), wcLlsVmSmall W A K 𝔭 t (c i) (b i) μ₀ E →
      wcLlsVmSmall W A K 𝔭 t (c i) (b i) (ν * μ₀) (algebraMap A K (algebraMap ↥W A ν) * E) := by
    rintro ν μ₀ E ⟨x, d, a, ha, hd, he⟩
    exact ⟨x, d, a, ha, hd, by rw [map_mul, map_mul, mul_assoc, he]; ring⟩
  have hmono : ∀ (e : ↥W) (k : ℕ), wcLlsVmSmall W A K 𝔭 t (c i) (b i) e
      (algebraMap A K (algebraMap ↥W A e) * S ^ k) := by
    intro e k
    refine ⟨⟨S, Algebra.subset_adjoin (Set.mem_singleton S)⟩ ^ k, 1, 1, ?_, ?_, ?_⟩
    · exact fun h1 => hp.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
    · rw [map_one, sub_self]; exact Ideal.zero_mem _
    · rw [OneMemClass.coe_one, mul_one, SubmonoidClass.coe_pow]
  have hmax : ∀ (μ₁ μ₂ : ↥W) (E₁ E₂ : K), μ₁ ∈ IsLocalRing.maximalIdeal ↥W →
      μ₂ ∈ IsLocalRing.maximalIdeal ↥W →
      wcLlsVmSmall W A K 𝔭 t (c i) (b i) μ₁ E₁ → wcLlsVmSmall W A K 𝔭 t (c i) (b i) μ₂ E₂ →
      ∃ μ' ∈ IsLocalRing.maximalIdeal ↥W, wcLlsVmSmall W A K 𝔭 t (c i) (b i) μ' (E₁ + E₂) := by
    intro μ₁ μ₂ E₁ E₂ h1 h2 s1 s2
    rcases ValuationRing.dvd_total μ₁ μ₂ with ⟨q, hq⟩ | ⟨q, hq⟩
    · exact ⟨μ₁, h1, by rw [add_comm]; exact hadd μ₂ μ₁ q E₂ E₁ hq s2 s1⟩
    · exact ⟨μ₂, h2, hadd μ₁ μ₂ q E₁ E₂ hq s1 s2⟩
  have hpoly : ∀ F : Polynomial Ω, (∀ k, W.valuation (F.coeff k) < 1) →
      ∃ μ' ∈ IsLocalRing.maximalIdeal ↥W,
        wcLlsVmSmall W A K 𝔭 t (c i) (b i) μ' (F.eval₂ ι S) := by
    intro F hF
    rw [Polynomial.eval₂_eq_sum_range]
    generalize F.natDegree + 1 = N
    induction N with
    | zero => exact ⟨0, Ideal.zero_mem _, by rw [Finset.sum_range_zero]; exact hz 0⟩
    | succ N ih =>
      obtain ⟨μ₁, hμ₁, s1⟩ := ih
      have hmem : F.coeff N ∈ W := (W.valuation_le_one_iff _).mp (le_of_lt (hF N))
      have hem : (⟨F.coeff N, hmem⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W :=
        (W.valuation_lt_one_iff _).mpr (hF N)
      have s2 := hmono ⟨F.coeff N, hmem⟩ N
      rw [← hι] at s2
      rw [Finset.sum_range_succ]
      exact hmax μ₁ _ _ _ hμ₁ hem s1 s2

  rcases lt_trichotomy (W.valuation (β * ((b i : ↥W) : Ω))) 1 with hlt | heq | hgt
  · obtain ⟨uW, huW⟩ : ∃ uW : ↥W, (uW : Ω) = β * ((b i : ↥W) : Ω) :=
      ⟨⟨_, (W.valuation_le_one_iff _).mp hlt.le⟩, rfl⟩
    have huWm : uW ∈ IsLocalRing.maximalIdeal ↥W :=
      (W.valuation_lt_one_iff uW).mpr (by rw [huW]; exact hlt)
    have hc1 : ∀ k, W.valuation (E'.coeff k) < 1 := fun k => by
      have := hE'c k; rwa [max_eq_left hlt.le] at this
    obtain ⟨μ₁, hμ₁, s1⟩ := hpoly E' hc1
    obtain ⟨μ₂, hμ₂, s2⟩ := hmax _ _ _ _ hμm hμ₁ hsm s1
    obtain ⟨μ₃, hμ₃, s3⟩ := hmax _ _ _ _ hμ₂ huWm s2 (hmono uW 1)
    have heqE : f - Q.eval₂ ι (algebraMap A K t) + E'.eval₂ ι S +
        algebraMap A K (algebraMap ↥W A uW) * S ^ 1 =
        algebraMap A K (algebraMap ↥W A 1) ^ ℓ * (f - (G.eval₂ ι (algebraMap A K t)) ^ ℓ +
          G.eval₂ ι (algebraMap A K t)) - algebraMap A K (algebraMap ↥W A 0) * S := by
      rw [hkey, ← huW, hι uW]
      simp only [map_one, map_zero, one_pow, one_mul, zero_mul, sub_zero, pow_one]
      ring
    rw [heqE] at s3
    exact hnIS (wcLlsASvm_read_small Ω W hdim hWt ℓ hℓ A K L 𝔭 t hPD hK hdeg α f hα1 hf' (c i)
      (b i) 1 μ₃ (hcm i) (hbm i) (hb0 i) one_ne_zero hμ₃ (G.eval₂ ι (algebraMap A K t)) 0
      (Or.inl ⟨rfl, rfl⟩) s3 e')
  · obtain ⟨uW, huW⟩ : ∃ uW : ↥W, (uW : Ω) = β * ((b i : ↥W) : Ω) :=
      ⟨⟨_, (W.valuation_le_one_iff _).mp heq.le⟩, rfl⟩
    have hunit : IsUnit uW := (W.valuation_eq_one_iff uW).mpr (by rw [huW]; exact heq)
    have hc1 : ∀ k, W.valuation (E'.coeff k) < 1 := fun k => by
      have := hE'c k; rwa [heq, max_self] at this
    obtain ⟨μ₁, hμ₁, s1⟩ := hpoly E' hc1
    obtain ⟨μ₂, hμ₂, s2⟩ := hmax _ _ _ _ hμm hμ₁ hsm s1
    have heqE : f - Q.eval₂ ι (algebraMap A K t) + E'.eval₂ ι S =
        f - (G.eval₂ ι (algebraMap A K t)) ^ ℓ + G.eval₂ ι (algebraMap A K t) -
          algebraMap A K (algebraMap ↥W A uW) * S := by
      rw [hkey, ← huW, hι uW]; ring
    rw [heqE] at s2
    exact hnGE (wcLlsASvm_read_etale Ω W hdim hWt ℓ hℓ A K L 𝔭 t hPD hK hdeg α f hα1 hf' (c i)
      (b i) uW μ₂ (hcm i) (hbm i) (hb0 i) hunit hμ₂ _ s2)
  · have hvB0 : W.valuation (β * ((b i : ↥W) : Ω)) ≠ 0 := (lt_trans zero_lt_one hgt).ne'
    have hu0 : β * ((b i : ↥W) : Ω) ≠ 0 := (Valuation.ne_zero_iff _).mp hvB0
    obtain ⟨lam, hlam⟩ := IsAlgClosed.exists_pow_nat_eq (β * ((b i : ↥W) : Ω)) hℓ.pos
    have hlam0 : lam ≠ 0 := by
      rintro rfl
      rw [zero_pow hℓ.ne_zero] at hlam
      exact hu0 hlam.symm
    have hvlam : 1 < W.valuation lam := by
      by_contra hle
      push_neg at hle
      have h2 : W.valuation (β * ((b i : ↥W) : Ω)) ≤ 1 := by
        rw [← hlam, map_pow]; exact pow_le_one₀ zero_le' hle
      exact absurd hgt (not_lt.mpr h2)
    have hκmem : lam⁻¹ ∈ W := (W.valuation_le_one_iff _).mp
      (by rw [map_inv₀]; exact (inv_lt_one_of_one_lt₀ hvlam).le)
    obtain ⟨κW, hκW⟩ : ∃ κW : ↥W, (κW : Ω) = lam⁻¹ := ⟨⟨_, hκmem⟩, rfl⟩
    have hκm : κW ∈ IsLocalRing.maximalIdeal ↥W := (W.valuation_lt_one_iff κW).mpr
      (by rw [hκW, map_inv₀]; exact inv_lt_one_of_one_lt₀ hvlam)
    have hκ0 : κW ≠ 0 := by
      rintro rfl
      exact hlam0 (inv_eq_zero.mp hκW.symm)
    have hκu : ((κW : Ω)) ^ ℓ * (β * ((b i : ↥W) : Ω)) = 1 := by
      rw [hκW, ← hlam, inv_pow, inv_mul_cancel₀ (pow_ne_zero _ hlam0)]
    have hcF : ∀ k, W.valuation ((Polynomial.C ((κW : Ω) ^ ℓ) * E').coeff k) < 1 := by
      intro k
      rw [Polynomial.coeff_C_mul, map_mul]
      have h1 := hE'c k
      rw [max_eq_right hgt.le] at h1
      have hvκ : W.valuation ((κW : Ω) ^ ℓ) * W.valuation (β * ((b i : ↥W) : Ω)) = 1 := by
        rw [← map_mul, hκu, map_one]
      have hpos : 0 < W.valuation ((κW : Ω) ^ ℓ) := by
        apply zero_lt_iff.mpr
        rw [map_pow]
        exact pow_ne_zero _ ((Valuation.ne_zero_iff _).mpr (by rw [hκW]; exact inv_ne_zero hlam0))
      calc W.valuation ((κW : Ω) ^ ℓ) * W.valuation (E'.coeff k)
          < W.valuation ((κW : Ω) ^ ℓ) * W.valuation (β * ((b i : ↥W) : Ω)) :=
            mul_lt_mul_of_pos_left h1 hpos
        _ = 1 := hvκ
    obtain ⟨μ₁, hμ₁, s1⟩ := hpoly _ hcF
    have s0 := hscale (κW ^ ℓ) μ _ hsm
    have hμ0 : κW ^ ℓ * μ ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_left _ _ hμm
    obtain ⟨μ₂, hμ₂, s2⟩ := hmax _ _ _ _ hμ0 hμ₁ s0 s1
    have hκu' : algebraMap A K (algebraMap ↥W A κW) ^ ℓ * ι (β * ((b i : ↥W) : Ω)) = 1 := by
      rw [← hι κW, ← map_pow, ← map_mul, hκu, map_one]
    have heqE : algebraMap A K (algebraMap ↥W A (κW ^ ℓ)) * (f - Q.eval₂ ι (algebraMap A K t)) +
        (Polynomial.C ((κW : Ω) ^ ℓ) * E').eval₂ ι S =
        algebraMap A K (algebraMap ↥W A κW) ^ ℓ * (f - (G.eval₂ ι (algebraMap A K t)) ^ ℓ +
          G.eval₂ ι (algebraMap A K t)) - algebraMap A K (algebraMap ↥W A 1) * S := by
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, hkey]
      simp only [map_pow, map_one, one_mul, hι κW]
      linear_combination (-S) * hκu'
    rw [heqE] at s2
    exact hnIS (wcLlsASvm_read_small Ω W hdim hWt ℓ hℓ A K L 𝔭 t hPD hK hdeg α f hα1 hf' (c i)
      (b i) κW μ₂ (hcm i) (hbm i) (hb0 i) hκ0 hμ₂ (G.eval₂ ι (algebraMap A K t)) 1
      (Or.inr ⟨rfl, hκm⟩) s2 e')

theorem wcLlsVd_gi_ram_norm : ∀ (R : Type u) [CommRing R] (K : Type u) [Field K] [Algebra R K] (L : Type u) [Field L] [Algebra K L] [Algebra R L] [IsScalarTower R K L] [FiniteDimensional K L] [IsGalois K L] (ℓ : ℕ), ℓ.Prime → Module.finrank K L = ℓ → ∀ (𝔔 : Ideal ↥(integralClosure R L)), 𝔔.IsPrime → wcLlsRam R K L 𝔔 → ∀ x : ↥(integralClosure R L), ∃ r : ↥(integralClosure R L), (r : L) ∈ Set.range (algebraMap K L) ∧ x ^ ℓ - r ∈ 𝔔 :=
by
  intro R _ K _ _ L _ _ _ _ _ _ ℓ hℓ hdeg 𝔔 _ hRam x
  classical
  obtain ⟨g, hg1, hg⟩ := hRam
  have F1 : ∀ (σ : L ≃ₐ[K] L) (z : ↥(integralClosure R L)),
      σ (z : L) ∈ integralClosure R L := by
    intro σ z
    exact IsIntegral.map σ z.2
  let act : (L ≃ₐ[K] L) → ↥(integralClosure R L) → ↥(integralClosure R L) :=
    fun σ z => ⟨σ z, F1 σ z⟩
  have hact : ∀ (σ : L ≃ₐ[K] L) (z : ↥(integralClosure R L)), ((act σ z : _) : L) = σ (z : L) :=
    fun _ _ => rfl
  have P : ∀ (k : ℕ) (z : ↥(integralClosure R L)), ∃ q ∈ 𝔔, (q : L) = (g ^ k) (z : L) - z := by
    intro k
    induction k with
    | zero => intro z; exact ⟨0, 𝔔.zero_mem, by simp⟩
    | succ k ih =>
      intro z
      obtain ⟨q₁, hq₁, e₁⟩ := ih (act g z)
      obtain ⟨q₂, hq₂, e₂⟩ := hg z
      refine ⟨q₁ + q₂, 𝔔.add_mem hq₁ hq₂, ?_⟩
      rw [pow_succ, AlgEquiv.mul_apply, AddMemClass.coe_add, e₁, e₂, hact]
      ring
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  have hcard : Nat.card (L ≃ₐ[K] L) = ℓ := (IsGalois.card_aut_eq_finrank K L).trans hdeg
  have hz : Subgroup.zpowers g = ⊤ := zpowers_eq_top_of_prime_card hcard hg1
  have F3 : ∀ τ : L ≃ₐ[K] L, ∃ n : ℕ, g ^ n = τ := by
    intro τ
    have h1 : τ ∈ Subgroup.zpowers g := by rw [hz]; exact Subgroup.mem_top τ
    exact (Submonoid.mem_powers_iff τ g).mp (mem_powers_iff_mem_zpowers.mpr h1)
  have F5 : ∀ (σ : L ≃ₐ[K] L) (z : ↥(integralClosure R L)),
      Ideal.Quotient.mk 𝔔 (act σ z) = Ideal.Quotient.mk 𝔔 z := by
    intro σ z
    obtain ⟨n, rfl⟩ := F3 σ
    obtain ⟨q, hq, e⟩ := P n z
    apply Ideal.Quotient.eq.mpr
    have h2 : act (g ^ n) z - z = q := by
      apply Subtype.ext
      rw [e, AddSubgroupClass.coe_sub, hact]
    rw [h2]
    exact hq
  refine ⟨∏ σ : L ≃ₐ[K] L, act σ x, ?_, ?_⟩
  · refine ⟨Algebra.norm K (x : L), ?_⟩
    have h3 : ((∏ σ : L ≃ₐ[K] L, act σ x : ↥(integralClosure R L)) : L)
        = ∏ σ : L ≃ₐ[K] L, ((act σ x : ↥(integralClosure R L)) : L) :=
      map_prod (integralClosure R L).val _ _
    exact (Algebra.norm_eq_prod_automorphisms K (x : L)).trans h3.symm
  · apply Ideal.Quotient.eq.mp
    rw [map_prod, Finset.prod_congr rfl (fun σ _ => F5 σ x), Finset.prod_const, Finset.card_univ,
      ← Nat.card_eq_fintype_card, hcard, map_pow]

theorem wcLlsVd_gauss_insep : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
