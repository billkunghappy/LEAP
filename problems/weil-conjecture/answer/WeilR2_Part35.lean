    haveI : IsScalarTower E B C := IsScalarTower.of_algebraMap_eq' rfl
    have hassoc : Associated b (algebraMap E B s₀) := ⟨v, by rw [hv, hs₀]⟩
    haveI : IsLocalization.Away (algebraMap E B s₀) C := IsLocalization.Away.of_associated hassoc
    haveI : IsLocalization.Away (h * s₀) C := IsLocalization.Away.mul' B C h s₀
    haveI : IsLocalization.Away (h * s₀ * g₀) (Localization.Away (algebraMap E C g₀)) :=
      IsLocalization.Away.instHMulAwayCoeRingHomAlgebraMap_1 C (h * s₀) g₀
