  have hIeq' := hIeq
  let E := Ideal.quotientEquiv
    ((IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap T (Localization.AtPrime Q')).comp (ψ.comp Polynomial.C)))
    ((Ideal.span {z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (z : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}).map
        (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) L)
          (Localization.AtPrime Q))) Φ hIeq'
  haveI := hFd
  haveI := hFn
  haveI : IsDomain (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) Q) :=
    MulEquiv.isDomain _ E.symm.toMulEquiv
  haveI : IsIntegrallyClosed (wcLlsFS W
      ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) Q) :=
    IsIntegrallyClosed.of_equiv E
  exact s11 _

theorem wcLlsAS_dsb_small_disc_unram : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y →
    wcLlsBR W A K L 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ α : L, α ∉ Set.range (algebraMap K L) → α ^ ℓ - α ∈ Set.range (algebraMap K L) →
    ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W →
    (¬ ∃ Q, wcLlsGenPt W A L 𝔭 Q ∧
      t - algebraMap ↥W A c ∈ Q.comap (algebraMap A ↥(integralClosure A L)) ∧
      wcLlsRam A K L Q) →
    ∃ r₀ : ↥W, r₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ r₀ ≠ 0 ∧
      ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) L)) [Q.IsPrime],
        Q.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) L)) =
          wcLlsScN W A K t c r₀ →
        wcpaDjLkDelta (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
          ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) Q) = 0 :=
by
  classical
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hSolv hUniq hBR hdeg
    α hα1 hα2 c hc hram

  have hK : ((ℓ : ℕ) : K) = 0 := by
    have h1 : ((ℓ : ℕ) : Ω) = 0 := by rw [← hchar]; exact ringChar.Nat.cast_ringChar
    have h2 : ((ℓ : ℕ) : ↥W) = 0 := Subtype.ext (by simpa using h1)
    have h3 := congrArg (fun x => algebraMap A K (algebraMap ↥W A x)) h2
    simpa using h3

  have hPD' := hPD
  unfold wcLlsPD at hPD'
  obtain ⟨_, _, hIC, hmax, hm𝔭, ht, _, _⟩ := hPD'
  haveI : IsIntegrallyClosed A := hIC
  have h𝔭prime : 𝔭.IsPrime := hmax.isPrime
  have htc : t - algebraMap ↥W A c ∈ 𝔭 :=
    𝔭.sub_mem ht (hm𝔭 (Ideal.mem_map_of_mem _ hc))

  obtain ⟨ev, hevW, hevt, hloc⟩ := wcLlsAS_dsbu_section Ω W hW hWt A 𝔭 t c hPD hc

  have hker : RingHom.ker ev ≤ 𝔭 := by
    intro x hx
    obtain ⟨s, e, hs, hse⟩ := hloc x
    rw [RingHom.mem_ker] at hx
    rw [hx, map_zero, sub_zero] at hse
    have hmem : s * x ∈ 𝔭 := by rw [hse]; exact Ideal.mul_mem_right e 𝔭 htc
    exact (h𝔭prime.mem_or_mem hmem).resolve_left hs

  have hnostab : ∀ Q : Ideal ↥(integralClosure A L), Q.IsPrime →
      Q.comap (algebraMap A ↥(integralClosure A L)) = RingHom.ker ev →
      ∀ g : L ≃ₐ[K] L, g ≠ 1 →
        ¬ ∀ x : ↥(integralClosure A L), x ∈ Q → ∃ z ∈ Q, (z : L) = g x := by
    intro Q hQ hQc g hg hst
    have hR := wcLlsAS_dsbu_fixed_prime_ram Ω W A K L ev hevW Q hQ hQc g hst
    apply hram
    refine ⟨Q, ⟨hQ, ?_, ?_⟩, ?_, g, hg, hR⟩
    · rw [hQc]; exact hker
    · intro w hw
      rw [hQc, RingHom.mem_ker, hevW]
      exact hw
    · rw [hQc, RingHom.mem_ker, map_sub, hevt, hevW, sub_self]

  obtain ⟨β, a, d, hβ, hea, hed, hβeq⟩ :=
    wcLlsAS_dsbu_integral_generator Ω W ℓ hℓ A K L hK hdeg ev hevW hnostab

  obtain ⟨z, hz⟩ : ∃ z : Ω, z ∉ W := by
    by_contra h
    push_neg at h
    apply hWt
    ext x
    simp [h x]
  have hz0 : z ≠ 0 := fun h => hz (h ▸ W.zero_mem)
  have hzinv : z⁻¹ ∈ W := (W.mem_or_inv_mem z).resolve_left hz
  obtain ⟨μ, hμ⟩ : ∃ μ : ↥W, (μ : Ω) = z⁻¹ := ⟨⟨z⁻¹, hzinv⟩, rfl⟩
  have hμ0 : μ ≠ 0 := by
    intro h
    have h' : (μ : Ω) = 0 := by rw [h]; rfl
    rw [hμ, inv_eq_zero] at h'
    exact hz0 h'
  have hμm : μ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    rintro ⟨u, hu⟩
    apply hz
    have h1 : ((u⁻¹ : (↥W)ˣ) : ↥W) * μ = 1 := by rw [← hu]; exact Units.inv_mul u
    have h2 : (((u⁻¹ : (↥W)ˣ) : ↥W) : Ω) * (μ : Ω) = 1 := by
      have := congrArg (fun x : ↥W => (x : Ω)) h1
      simpa using this
    rw [hμ] at h2
    have h3 := (mul_inv_eq_one₀ hz0).mp h2
    rw [← h3]
    exact ((u⁻¹ : (↥W)ˣ) : ↥W).2
  obtain ⟨r₀, hr₀⟩ : ∃ r₀ : ↥W, r₀ = ev d * μ := ⟨_, rfl⟩
  have hr₀m : r₀ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [hr₀]; exact Ideal.mul_mem_left _ (ev d) hμm
  have hr₀0 : r₀ ≠ 0 := by rw [hr₀]; exact mul_ne_zero hed hμ0

  obtain ⟨s₁, e₁, hs₁, h1⟩ := hloc d
  obtain ⟨s₂, e₂, hs₂, h2⟩ := hloc a
  rw [hea, map_zero, sub_zero] at h2
  have hs₀ : s₂ * s₁ ∉ 𝔭 := by
    intro hmem
    rcases h𝔭prime.mem_or_mem hmem with h | h
    · exact hs₂ h
    · exact hs₁ h
  have hinjK : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hd0 : algebraMap A K d ≠ 0 := by
    intro h
    have : d = 0 := hinjK (by rw [h, map_zero])
    exact hed (by rw [this, map_zero])
  have hιne : ∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0 := by
    intro w hw h
    have : algebraMap ↥W A w = 0 := hinjK (by rw [h, map_zero])
    apply hw
    rw [← hevW w, this, map_zero]
  have hD : algebraMap A K (algebraMap ↥W A (ev d)) ≠ 0 := hιne _ hed
  set Sel : ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) :=
    ⟨wcLlsScS W A K t c r₀, Algebra.subset_adjoin (Set.mem_singleton _)⟩ with hSel
  set q : ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) :=
    algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) (s₂ * s₁) +
      algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) (algebraMap ↥W A μ * s₂ * e₁) * Sel
    with hq
  set p : ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) :=
    algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) (algebraMap ↥W A μ * e₂ * s₁) * Sel
    with hp
  have hqN : q - algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) (s₂ * s₁) ∈
      wcLlsScN W A K t c r₀ := by
    have e : q - algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) (s₂ * s₁) =
        algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) (algebraMap ↥W A μ * s₂ * e₁) *
          Sel := by
      rw [hq]; ring
    rw [e]
    unfold wcLlsScN
    exact Ideal.mem_sup_left (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton _)))

  have hSK : (Sel : K) * (algebraMap A K (algebraMap ↥W A (ev d)) *
      algebraMap A K (algebraMap ↥W A μ)) = algebraMap A K (t - algebraMap ↥W A c) := by
    have hr : algebraMap A K (algebraMap ↥W A r₀) = algebraMap A K (algebraMap ↥W A (ev d)) *
        algebraMap A K (algebraMap ↥W A μ) := by rw [hr₀, map_mul, map_mul]
    rw [← hr]
    show wcLlsScS W A K t c r₀ * _ = _
    unfold wcLlsScS
    exact div_mul_cancel₀ _ (hιne r₀ hr₀0)
  have h1K := congrArg (algebraMap A K) h1
  have h2K := congrArg (algebraMap A K) h2
  simp only [map_mul, map_sub] at h1K h2K
  have hqK : (q : K) = algebraMap A K s₂ * algebraMap A K s₁ +
      algebraMap A K (algebraMap ↥W A μ) * algebraMap A K s₂ * algebraMap A K e₁ * (Sel : K) := by
    rw [hq]
    simp only [Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_algebraMap, map_mul]
  have hpK : (p : K) = algebraMap A K (algebraMap ↥W A μ) * algebraMap A K e₂ *
      algebraMap A K s₁ * (Sel : K) := by
    rw [hp]
    simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, map_mul]
  have key : algebraMap A K a * (q : K) = (p : K) * algebraMap A K d := by
    apply mul_left_cancel₀ hD
    rw [hqK, hpK]
    rw [map_sub] at hSK
    linear_combination
      (algebraMap A K s₂ * algebraMap A K e₁ * algebraMap A K a -
        algebraMap A K e₂ * algebraMap A K s₁ * algebraMap A K d) * hSK +
      (-(algebraMap A K a * algebraMap A K s₂)) * h1K +
      (algebraMap A K s₁ * algebraMap A K d) * h2K
  have hFq : (algebraMap A K a / algebraMap A K d) * (q : K) = (p : K) := by
    rw [div_mul_eq_mul_div, div_eq_iff hd0, key]

  have hdL : algebraMap K L (algebraMap A K d) ≠ 0 :=
    (map_ne_zero (algebraMap K L)).mpr hd0
  have hFL : algebraMap K L (algebraMap A K a / algebraMap A K d) = β ^ ℓ - β := by
    rw [map_div₀, div_eq_iff hdL]
    rw [← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply, ← hβeq]
    ring
  have hFL' : (β ^ ℓ - β) * algebraMap K L (q : K) = algebraMap K L (p : K) := by
    rw [← hFL, ← map_mul, hFq]

  refine ⟨r₀, hr₀m, hr₀0, ?_⟩
  intro Q hQi hQ
  exact wcLlsAS_dsbu_etale_chart_delta Ω W hW hWt ℓ hℓ A K L 𝔭 t c r₀ hPD hc hr₀m hr₀0 hK hdeg
    β hβ p q (s₂ * s₁) hs₀ hqN hFL' Q hQ

theorem wcLlsASr_pnf_residue_root : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ (P : Ideal A), P.IsPrime → P ≤ 𝔭 → (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) → ∀ c : ↥W, t - algebraMap ↥W A c ∈ P → t - algebraMap ↥W A c ≠ 0 → ∀ (n : ℕ), 0 < n → ∀ X Y : A, Y ∉ P → ∃ a b : ↥W, b ≠ 0 ∧ algebraMap ↥W A (b ^ n) * X - algebraMap ↥W A (a ^ n) * Y ∈ P :=
by
  intro Ω _ _ W A _ _ _ 𝔭 t hPD P hPprime hP𝔭 hPc c hTP hT0 n hn X Y hY
  classical


  have etaleAlg : ∀ (R S : Type u) [CommRing R] [CommRing S] [IsDomain S]
      (f : R →+* S), f.Etale → ∀ s : S, ∃ F : Polynomial R, F.map f ≠ 0 ∧ F.eval₂ f s = 0 := by
    intro R S _ _ _ f hf s
    letI := f.toAlgebra
    haveI : Algebra.Etale R S := hf
    haveI hJp : (RingHom.ker f).IsPrime := RingHom.ker_isPrime f
    let Rb := R ⧸ RingHom.ker f
    let fb : Rb →+* S := RingHom.kerLift f
    have hfb : Function.Injective fb := RingHom.kerLift_injective f
    have hfbmk : ∀ r : R, fb (Ideal.Quotient.mk _ r) = f r := fun r => RingHom.kerLift_mk f r
    letI : Algebra Rb S := fb.toAlgebra
    haveI : IsScalarTower R Rb S := IsScalarTower.of_algebraMap_eq (fun r => (hfbmk r).symm)
    haveI : Algebra.FormallyUnramified Rb S :=
      Algebra.FormallyUnramified.of_restrictScalars R Rb S
    haveI : Algebra.EssFiniteType Rb S := Algebra.EssFiniteType.of_comp R Rb S
    let M := Algebra.algebraMapSubmonoid S (nonZeroDivisors Rb)
    have hM : M ≤ nonZeroDivisors S := by
      rintro _ ⟨r, hr, rfl⟩
      apply mem_nonZeroDivisors_of_ne_zero
      intro h0
      exact nonZeroDivisors.ne_zero hr (hfb (by rw [map_zero]; exact h0))
    letI : Algebra (FractionRing Rb) (Localization M) :=
      localizationAlgebra (nonZeroDivisors Rb) S
    haveI : IsScalarTower Rb (FractionRing Rb) (Localization M) := by
      apply IsScalarTower.of_algebraMap_eq'
      rw [IsScalarTower.algebraMap_eq Rb S (Localization M)]
      exact (IsLocalization.map_comp _).symm
    haveI : Algebra.FormallyUnramified S (Localization M) :=
      Algebra.FormallyUnramified.of_isLocalization M
    haveI : Algebra.FormallyUnramified Rb (Localization M) :=
      Algebra.FormallyUnramified.comp Rb S (Localization M)
    haveI : Algebra.FormallyUnramified (FractionRing Rb) (Localization M) :=
      Algebra.FormallyUnramified.localization_base (nonZeroDivisors Rb)
    haveI : Algebra.EssFiniteType S (Localization M) :=
      Algebra.EssFiniteType.of_isLocalization (Localization M) M
    haveI : Algebra.EssFiniteType Rb (Localization M) :=
      Algebra.EssFiniteType.comp Rb S (Localization M)
    haveI : Algebra.EssFiniteType (FractionRing Rb) (Localization M) :=
      Algebra.EssFiniteType.of_comp Rb (FractionRing Rb) (Localization M)
    haveI : Module.Finite (FractionRing Rb) (Localization M) :=
      Algebra.FormallyUnramified.finite_of_free _ _
    have hint : IsIntegral (FractionRing Rb) (algebraMap S (Localization M) s) :=
      Algebra.IsIntegral.isIntegral _
    obtain ⟨p, hpm, hp⟩ := hint
    set Fb := IsLocalization.integerNormalization (nonZeroDivisors Rb) p with hFb
    have hFb0 : Fb ≠ 0 := by
      rw [Ne, hFb, IsLocalization.integerNormalization_eq_zero_iff le_rfl]
      exact hpm.ne_zero
    have hFbs : Fb.eval₂ fb s = 0 := by
      have h := IsLocalization.integerNormalization_aeval_eq_zero (nonZeroDivisors Rb) p
        (x := algebraMap S (Localization M) s) (by rwa [Polynomial.aeval_def])
      rw [Polynomial.aeval_algebraMap_apply] at h
      have hinjS : Function.Injective (algebraMap S (Localization M)) :=
        IsLocalization.injective (Localization M) hM
      have h2 : Polynomial.aeval s Fb = 0 := hinjS (by rw [h, map_zero])
      rw [Polynomial.aeval_def] at h2
      exact h2
    obtain ⟨F, hF⟩ := Polynomial.map_surjective (Ideal.Quotient.mk (RingHom.ker f))
      Ideal.Quotient.mk_surjective Fb
    have hcomp : fb.comp (Ideal.Quotient.mk (RingHom.ker f)) = f := RingHom.ext hfbmk
    refine ⟨F, ?_, ?_⟩
    · rw [← hcomp, ← Polynomial.map_map, hF]
      exact (Polynomial.map_ne_zero_iff hfb).mpr hFb0
    · rw [← hcomp, ← Polynomial.eval₂_map, hF]
      exact hFbs


  have strip : ∀ (R S : Type u) [CommRing R] [IsDomain R] [CommRing S] [IsDomain S]
      (φ : Polynomial R →+* S) (c₀ : R), φ (Polynomial.X - Polynomial.C c₀) ≠ 0 →
      ∀ (s : S) (F : Polynomial (Polynomial R)), F ≠ 0 → F.eval₂ φ s = 0 →
      ∃ G : Polynomial (Polynomial R), G.eval₂ φ s = 0 ∧
        G.map (Polynomial.evalRingHom c₀) ≠ 0 := by
    intro R S _ _ _ _ φ c₀ hφ s
    have key : ∀ N : ℕ, ∀ F : Polynomial (Polynomial R), F.leadingCoeff.natDegree = N →
        F ≠ 0 → F.eval₂ φ s = 0 → ∃ G : Polynomial (Polynomial R), G.eval₂ φ s = 0 ∧
          G.map (Polynomial.evalRingHom c₀) ≠ 0 := by
      intro N
      induction N using Nat.strong_induction_on with
      | _ N ih =>
        intro F hN hF hFs
        by_cases hm : F.map (Polynomial.evalRingHom c₀) = 0
        · have hdvd : Polynomial.C (Polynomial.X - Polynomial.C c₀) ∣ F := by
            rw [Polynomial.C_dvd_iff_dvd_coeff]
            intro i
            rw [Polynomial.dvd_iff_isRoot]
            have hci := congrArg (fun q => q.coeff i) hm
            show Polynomial.eval c₀ (F.coeff i) = 0
            simpa [Polynomial.coeff_map] using hci
          obtain ⟨F', hF'⟩ := hdvd
          have hF'0 : F' ≠ 0 := by
            rintro rfl
            exact hF (by rw [hF', mul_zero])
          have hF's : F'.eval₂ φ s = 0 := by
            rw [hF', Polynomial.eval₂_mul, Polynomial.eval₂_C] at hFs
            exact (mul_eq_zero.mp hFs).resolve_left hφ
          have hlc : F.leadingCoeff = (Polynomial.X - Polynomial.C c₀) * F'.leadingCoeff := by
            rw [hF', Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C]
          have hdeg : F.leadingCoeff.natDegree = 1 + F'.leadingCoeff.natDegree := by
            rw [hlc, Polynomial.natDegree_mul (Polynomial.X_sub_C_ne_zero c₀)
              (Polynomial.leadingCoeff_ne_zero.mpr hF'0), Polynomial.natDegree_X_sub_C]
          exact ih _ (by omega) F' rfl hF'0 hF's
        · exact ⟨F, hFs, hm⟩
    intro F hF hFs
    exact key _ F rfl hF hFs


  obtain ⟨-, -, -, -, -, -, -, h, hh, f, hfC, hfX, het⟩ := hPD
  have hh0 : h ≠ 0 := by rintro rfl; exact hh 𝔭.zero_mem
  have hle := powers_le_nonZeroDivisors_of_noZeroDivisors hh0
  haveI : IsDomain (Localization.Away h) := IsLocalization.isDomain_localization hle
  have hinj : Function.Injective (algebraMap A (Localization.Away h)) :=
    IsLocalization.injective (Localization.Away h) hle
  haveI : IsDomain (A ⧸ P) := Ideal.Quotient.isDomain P
  let β : A →+* FractionRing (A ⧸ P) :=
    (algebraMap (A ⧸ P) (FractionRing (A ⧸ P))).comp (Ideal.Quotient.mk P)
  have hβ : ∀ a : A, β a = 0 ↔ a ∈ P := by
    intro a
    constructor
    · intro h0
      have : Ideal.Quotient.mk P a = 0 :=
        IsFractionRing.injective (A ⧸ P) (FractionRing (A ⧸ P)) (by rw [map_zero]; exact h0)
      exact Ideal.Quotient.eq_zero_iff_mem.mp this
    · intro h0
      show algebraMap (A ⧸ P) _ (Ideal.Quotient.mk P a) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr h0, map_zero]
  have hhP : h ∉ P := fun H => hh (hP𝔭 H)
  have hu : IsUnit (β h) := Ne.isUnit (fun H => hhP ((hβ h).mp H))
  let βh : Localization.Away h →+* FractionRing (A ⧸ P) :=
    IsLocalization.Away.lift (S := Localization.Away h) h hu
  have hβh : ∀ a : A, βh (algebraMap A (Localization.Away h) a) = β a :=
    fun a => IsLocalization.Away.lift_eq h hu a
  let θ : ↥W →+* FractionRing (A ⧸ P) := β.comp (algebraMap ↥W A)
  have hθ : Function.Injective θ := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    by_contra hne
    exact hPc w hne ((hβ _).mp hw)
  have hfCw : ∀ w : ↥W, f (Polynomial.C w) =
      algebraMap A (Localization.Away h) (algebraMap ↥W A w) := by
    intro w
    have e := congrArg (fun φ => φ w) hfC
    simpa only [RingHom.comp_apply] using e
  have hcomp : βh.comp f = θ.comp (Polynomial.evalRingHom c) := by
    apply Polynomial.ringHom_ext
    · intro w
      show βh (f (Polynomial.C w)) = θ (Polynomial.eval c (Polynomial.C w))
      rw [hfCw, hβh, Polynomial.eval_C]
      rfl
    · show βh (f Polynomial.X) = θ (Polynomial.eval c Polynomial.X)
      rw [hfX, hβh, Polynomial.eval_X]
      have e : β (t - algebraMap ↥W A c) = 0 := (hβ _).mpr hTP
      rw [map_sub, sub_eq_zero] at e
      exact e
  have hfT : f (Polynomial.X - Polynomial.C c) ≠ 0 := by
    rw [map_sub, hfX, hfCw, ← map_sub]
    intro H
    exact hT0 (hinj (by rw [H, map_zero]))


  let ι : Ω →+* FractionRing (A ⧸ P) := IsFractionRing.lift hθ
  have hι : ∀ w : ↥W, ι (w : Ω) = θ w := fun w => IsFractionRing.lift_algebraMap hθ w
  have hθβ : ∀ w : ↥W, β (algebraMap ↥W A w) = ι (w : Ω) := fun w => (hι w).symm
  have R1 : ∀ y : A, ∃ w₁ w₂ : ↥W, w₂ ≠ 0 ∧
      algebraMap ↥W A w₂ * y - algebraMap ↥W A w₁ ∈ P := by
    intro y
    obtain ⟨F, hF, hFy⟩ := etaleAlg _ _ f het (algebraMap A (Localization.Away h) y)
    have hF0 : F ≠ 0 := fun h0 => hF (by rw [h0, Polynomial.map_zero])
    obtain ⟨G, hGy, hGc⟩ := strip ↥W (Localization.Away h) f c hfT _ F hF0 hFy
    have hev : (G.map (Polynomial.evalRingHom c)).eval₂ θ (β y) = 0 := by
      rw [Polynomial.eval₂_map, ← hcomp, ← hβh, ← Polynomial.hom_eval₂, hGy, map_zero]
    letI : Algebra Ω (FractionRing (A ⧸ P)) := ι.toAlgebra
    have hx : IsAlgebraic Ω (β y) := by
      refine ⟨(G.map (Polynomial.evalRingHom c)).map (algebraMap ↥W Ω),
        (Polynomial.map_ne_zero_iff (IsFractionRing.injective ↥W Ω)).mpr hGc, ?_⟩
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      have e1 : (algebraMap Ω (FractionRing (A ⧸ P))).comp (algebraMap ↥W Ω) = θ := by
        ext w; exact hι w
      rw [e1]
      exact hev
    have hint := hx.isIntegral
    have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hint)
    obtain ⟨l, hl⟩ := minpoly.mem_range_of_degree_eq_one Ω (β y) hdeg
    change ι l = β y at hl
    by_cases hlW : l ∈ W
    · refine ⟨⟨l, hlW⟩, 1, one_ne_zero, ?_⟩
      rw [← hβ]
      simp only [map_sub, map_mul, map_one, one_mul, hθβ, ← hl]
      simp
    · have hlW' : l⁻¹ ∈ W := (W.mem_or_inv_mem l).resolve_left hlW
      have hl0 : l ≠ 0 := by rintro rfl; exact hlW W.zero_mem
      refine ⟨1, ⟨l⁻¹, hlW'⟩, ?_, ?_⟩
      · intro h0
        apply hl0
        simpa using congrArg (fun w : ↥W => (w : Ω)) h0
      · rw [← hβ]
        simp only [map_sub, map_mul, map_one, hθβ, ← hl]
        rw [← map_mul]
        simp [hl0]


  obtain ⟨w₁, w₂, hw₂, hXr⟩ := R1 X
  obtain ⟨v₁, v₂, hv₂, hYr⟩ := R1 Y
  have hv₁ : v₁ ≠ 0 := by
    rintro rfl
    rw [map_zero, sub_zero] at hYr
    rcases hPprime.mem_or_mem hYr with h1 | h1
    · exact hPc v₂ hv₂ h1
    · exact hY h1
  have hcoe : ∀ w : ↥W, w ≠ 0 → (w : Ω) ≠ 0 := by
    intro w hw h0
    apply hw
    ext
    simpa using h0
  have hw₂' := hcoe w₂ hw₂
  have hv₁' := hcoe v₁ hv₁
  obtain ⟨ρ, hρ⟩ := IsAlgClosed.exists_pow_nat_eq (((w₁ : Ω) * v₂) / ((w₂ : Ω) * v₁)) hn
  have hab : ∃ a b : ↥W, b ≠ 0 ∧ (a : Ω) = ρ * b := by
    by_cases hρW : ρ ∈ W
    · exact ⟨⟨ρ, hρW⟩, 1, one_ne_zero, by simp⟩
    · have hρW' : ρ⁻¹ ∈ W := (W.mem_or_inv_mem ρ).resolve_left hρW
      have hρ0 : ρ ≠ 0 := by rintro rfl; exact hρW W.zero_mem
      refine ⟨1, ⟨ρ⁻¹, hρW'⟩, ?_, ?_⟩
      · intro h0
        apply hρ0
        simpa using congrArg (fun w : ↥W => (w : Ω)) h0
      · simp [hρ0]
  obtain ⟨a, b, hb, habρ⟩ := hab
  have hkey : a ^ n * (w₂ * v₁) = b ^ n * (w₁ * v₂) := by
    apply Subtype.ext
    simp only [MulMemClass.coe_mul, SubmonoidClass.coe_pow]
    rw [habρ, mul_pow, hρ]
    field_simp
  refine ⟨a, b, hb, ?_⟩
  have hmem : algebraMap ↥W A (w₂ * v₂) *
      (algebraMap ↥W A (b ^ n) * X - algebraMap ↥W A (a ^ n) * Y) ∈ P := by
    have e : algebraMap ↥W A (w₂ * v₂) *
        (algebraMap ↥W A (b ^ n) * X - algebraMap ↥W A (a ^ n) * Y) =
        algebraMap ↥W A (b ^ n * v₂) * (algebraMap ↥W A w₂ * X - algebraMap ↥W A w₁) -
        algebraMap ↥W A (a ^ n * w₂) * (algebraMap ↥W A v₂ * Y - algebraMap ↥W A v₁) := by
      have hk := congrArg (algebraMap ↥W A) hkey
      simp only [map_mul, map_pow] at hk ⊢
      linear_combination -hk
    rw [e]
    exact P.sub_mem (P.mul_mem_left _ hXr) (P.mul_mem_left _ hYr)
  exact (hPprime.mem_or_mem hmem).resolve_left (hPc _ (mul_ne_zero hw₂ hv₂))

theorem wcLlsASr_pnf_ram_no_integral : ∀ ℓ : ℕ, ℓ.Prime → ∀ (A : Type u) [CommRing A] [IsDomain A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L], ((ℓ : ℕ) : K) = 0 → Module.finrank K L = ℓ → ∀ (α : L) (f₀ : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α → ∀ (Q : Ideal ↥(integralClosure A L)), wcLlsRam A K L Q → ∀ (h : K) (d x : A), algebraMap A ↥(integralClosure A L) d ∉ Q → algebraMap A K d * (f₀ - (h ^ ℓ - h)) ≠ algebraMap A K x :=
by
  intro ℓ hℓ A _ _ K _ _ _ L _ _ _ _ _ hKℓ hdeg α f₀ hα hf₀ Q hRam h d x hd heq
  have : Fact ℓ.Prime := ⟨hℓ⟩
  have hℓ2 : 2 ≤ ℓ := hℓ.two_le
  have hLℓ : ((ℓ : ℕ) : L) = 0 := by
    rw [← map_natCast (algebraMap K L), hKℓ, map_zero]
  have : CharP L ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hLℓ
  obtain ⟨g, hg1, hgQ⟩ := hRam

  have s2 : ∀ (c e : A) (y : L), y ^ ℓ = algebraMap A L c * y + algebraMap A L e →
      IsIntegral A y := by
    intro c e y hy
    refine ⟨Polynomial.X ^ ℓ - (Polynomial.C c * Polynomial.X + Polynomial.C e), ?_, ?_⟩
    · apply Polynomial.monic_X_pow_sub
      calc (Polynomial.C c * Polynomial.X + Polynomial.C e).degree ≤ 1 :=
            Polynomial.degree_linear_le
        _ < (ℓ : WithBot ℕ) := by exact_mod_cast (by omega : 1 < ℓ)
    · simp only [Polynomial.eval₂_sub, Polynomial.eval₂_add, Polynomial.eval₂_mul,
        Polynomial.eval₂_X_pow, Polynomial.eval₂_C, Polynomial.eval₂_X]
      rw [hy, sub_self]

  have s1 : g α = α → g = 1 := by
    intro hgα
    have hE : IntermediateField.adjoin K {α} = ⊤ := by
      have hne : IntermediateField.adjoin K {α} ≠ ⊥ := by
        intro hb
        rw [IntermediateField.adjoin_simple_eq_bot_iff, IntermediateField.mem_bot] at hb
        exact hα hb
      have hmul := Module.finrank_mul_finrank K (IntermediateField.adjoin K {α}) L
      rw [hdeg] at hmul
      have hdvd : Module.finrank K (IntermediateField.adjoin K {α}) ∣ ℓ := Dvd.intro _ hmul
      rcases hℓ.eq_one_or_self_of_dvd _ hdvd with h1 | h1
      · exact absurd (IntermediateField.finrank_eq_one_iff.mp h1) hne
      · apply IntermediateField.eq_of_le_of_finrank_eq le_top
        rw [h1, IntermediateField.finrank_top', hdeg]
    have hadj : Algebra.adjoin K {α} = ⊤ := by
      rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
        (Algebra.IsAlgebraic.isAlgebraic α), hE, IntermediateField.top_toSubalgebra]
    have hext := AlgHom.ext_of_adjoin_eq_top hadj (φ₁ := (g : L →ₐ[K] L))
      (φ₂ := AlgHom.id K L) (by
        intro y hy
        rw [Set.mem_singleton_iff.mp hy]
        simpa using hgα)
    ext y
    have := congrArg (fun φ : L →ₐ[K] L => φ y) hext
    simpa using this

  have hi : (α - algebraMap K L h) ^ ℓ - (α - algebraMap K L h) =
      algebraMap K L (f₀ - (h ^ ℓ - h)) := by
    rw [sub_pow_char, map_sub, map_sub, map_pow, hf₀]; ring
  have hii : algebraMap A L d * algebraMap K L (f₀ - (h ^ ℓ - h)) = algebraMap A L x := by
    have := congrArg (algebraMap K L) heq
    rw [map_mul, ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply] at this
    exact this
  obtain ⟨m, hm⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, by omega⟩
  have hDl : algebraMap A L d ^ ℓ = algebraMap A L d ^ m * algebraMap A L d := by
    rw [hm, pow_succ]
  have hiii : (algebraMap A L d * (α - algebraMap K L h)) ^ ℓ =
      algebraMap A L d ^ m * (algebraMap A L d * (α - algebraMap K L h)) +
        algebraMap A L d ^ m * algebraMap A L x := by
    rw [mul_pow]
    linear_combination algebraMap A L d ^ ℓ * hi +
      ((α - algebraMap K L h) + algebraMap K L (f₀ - (h ^ ℓ - h))) * hDl +
      algebraMap A L d ^ m * hii
  have hβint : IsIntegral A (algebraMap A L d * (α - algebraMap K L h)) := by
    apply s2 (d ^ m) (d ^ m * x)
    rw [map_mul, map_pow]
    exact hiii

  have hgα : (g α) ^ ℓ - g α = α ^ ℓ - α := by
    have := congrArg g hf₀
    rw [g.commutes, map_sub, map_pow] at this
    rw [← this, hf₀]
  have hj : (g α - α) ^ ℓ = g α - α := by
    rw [sub_pow_char]; linear_combination hgα
  have hj0 : g α - α ≠ 0 := fun h0 => hg1 (s1 (sub_eq_zero.mp h0))
  have hj1 : (g α - α) ^ (ℓ - 1) = 1 := by
    have : (g α - α) ^ (ℓ - 1) * (g α - α) = 1 * (g α - α) := by
      rw [← pow_succ, Nat.sub_add_cancel (by omega : 1 ≤ ℓ), hj, one_mul]
    exact mul_right_cancel₀ hj0 this
  have hjint : IsIntegral A (g α - α) := by
    apply s2 1 0
    rw [map_one, map_zero, one_mul, add_zero, hj]
  have hjI : IsIntegral A ((g α - α) ^ (ℓ - 2)) := hjint.pow _

  have hgD : g (algebraMap A L d) = algebraMap A L d := by
    rw [IsScalarTower.algebraMap_apply A K L, g.commutes]
  have hgβ : g (algebraMap A L d * (α - algebraMap K L h)) -
      algebraMap A L d * (α - algebraMap K L h) = algebraMap A L d * (g α - α) := by
    rw [map_mul, map_sub, hgD, g.commutes]; ring

  obtain ⟨q, hqQ, hq⟩ := hgQ ⟨_, (mem_integralClosure_iff A L).mpr hβint⟩
  have hmem := Q.mul_mem_right ⟨_, (mem_integralClosure_iff A L).mpr hjI⟩ hqQ
  apply hd
  convert hmem using 1
  apply Subtype.ext
  have hjj : (g α - α) * (g α - α) ^ (ℓ - 2) = 1 := by
    rw [← pow_succ', show ℓ - 2 + 1 = ℓ - 1 by omega, hj1]
  show algebraMap A L d = (q : L) * (g α - α) ^ (ℓ - 2)
  rw [hq]
  show algebraMap A L d = (g (algebraMap A L d * (α - algebraMap K L h)) -
      algebraMap A L d * (α - algebraMap K L h)) * (g α - α) ^ (ℓ - 2)
  rw [hgβ, mul_assoc, hjj, mul_one]

theorem wcLlsASr_pnf_as_reduction : ∀ (ℓ : ℕ), ℓ.Prime → ∀ (A : Type u) [CommRing A] [IsDomain A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K], ((ℓ : ℕ) : K) = 0 → ∀ (P : Ideal A), P.IsPrime → ∀ (T : A), T ≠ 0 → T ∈ P → ∀ f₀ : K, (∀ a : A, a ≠ 0 → ∃ (n : ℕ) (s v : A), s ∉ P ∧ v ∉ P ∧ s * a = T ^ n * v) → (∀ X Y : A, Y ∉ P → ∃ a b : A, b ∉ P ∧ b ^ ℓ * X - a ^ ℓ * Y ∈ P) → (∀ (h : K) (d x : A), d ∉ P → algebraMap A K d * (f₀ - (h ^ ℓ - h)) ≠ algebraMap A K x) → ∃ (h : K) (M : ℕ) (X Y : A), 0 < M ∧ ¬ ℓ ∣ M ∧ X ∉ P ∧ Y ∉ P ∧ algebraMap A K Y * algebraMap A K T ^ M * (f₀ - (h ^ ℓ - h)) = algebraMap A K X :=
by
  intro ℓ hℓ A _ _ K _ _ _ hKℓ P hP T hT0 _hTP f₀ hval hroot hram
  classical
  have hinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hιne : ∀ a : A, a ≠ 0 → algebraMap A K a ≠ 0 := fun a ha h =>
    ha (hinj (h.trans (map_zero (algebraMap A K)).symm))
  have hne0 : ∀ a : A, a ∉ P → a ≠ 0 := fun a ha h => ha (h ▸ P.zero_mem)
  have hTne : algebraMap A K T ≠ 0 := hιne T hT0
  have h1P : (1 : A) ∉ P := fun h => hP.ne_top ((Ideal.eq_top_iff_one P).mpr h)
  have hmul : ∀ a b : A, a ∉ P → b ∉ P → a * b ∉ P := fun a b ha hb h =>
    (hP.mem_or_mem h).elim ha hb
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : CharP K ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hKℓ
  have hℓ2 := hℓ.two_le

  have norm : ∀ (h : K) (M : ℕ) (X Y : A), Y ∉ P →
      algebraMap A K Y * algebraMap A K T ^ M * (f₀ - (h ^ ℓ - h)) = algebraMap A K X →
      ∃ (M' : ℕ) (X' Y' : A), 0 < M' ∧ M' ≤ M ∧ X' ∉ P ∧ Y' ∉ P ∧
        algebraMap A K Y' * algebraMap A K T ^ M' * (f₀ - (h ^ ℓ - h)) = algebraMap A K X' := by
    intro h M X Y hY heq
    by_cases hX : X = 0
    · exfalso
      have hY' := hιne Y (hne0 Y hY)
      rw [hX, map_zero] at heq
      have hg : f₀ - (h ^ ℓ - h) = 0 :=
        (mul_eq_zero.mp heq).resolve_left (mul_ne_zero hY' (pow_ne_zero _ hTne))
      exact hram h 1 0 h1P (by rw [hg, mul_zero, map_zero])
    · obtain ⟨n, s, v, hs, hv, hsX⟩ := hval X hX
      have hsXK : algebraMap A K s * algebraMap A K X = algebraMap A K T ^ n * algebraMap A K v := by
        have := congrArg (algebraMap A K) hsX
        rwa [map_mul, map_mul, map_pow] at this
      have heq2 : algebraMap A K T ^ M * (algebraMap A K (s * Y) * (f₀ - (h ^ ℓ - h))) =
          algebraMap A K T ^ n * algebraMap A K v := by
        rw [map_mul]
        linear_combination (algebraMap A K s) * heq + hsXK
      rcases le_or_gt M n with hMn | hnM
      · exfalso
        obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hMn
        apply hram h (s * Y) (T ^ j * v) (hmul s Y hs hY)
        have : algebraMap A K T ^ M * (algebraMap A K (s * Y) * (f₀ - (h ^ ℓ - h))) =
            algebraMap A K T ^ M * algebraMap A K (T ^ j * v) := by
          rw [heq2, pow_add, map_mul, map_pow]; ring
        exact mul_left_cancel₀ (pow_ne_zero _ hTne) this
      · obtain ⟨j, hj⟩ := Nat.exists_eq_add_of_lt hnM
        refine ⟨j + 1, v, s * Y, by omega, by omega, hv, hmul s Y hs hY, ?_⟩
        have : algebraMap A K T ^ n * (algebraMap A K (s * Y) * algebraMap A K T ^ (j + 1) *
            (f₀ - (h ^ ℓ - h))) = algebraMap A K T ^ n * algebraMap A K v := by
          rw [← heq2, hj]; ring
        exact mul_left_cancel₀ (pow_ne_zero _ hTne) this

  have divT : ∀ z ∈ P, ∃ s₂ z₁ : A, s₂ ∉ P ∧ s₂ * z = T * z₁ := by
    intro z hz
    by_cases hz0 : z = 0
    · exact ⟨1, 0, h1P, by simp [hz0]⟩
    · obtain ⟨n, s, v, hs, hv, hsz⟩ := hval z hz0
      cases n with
      | zero =>
        exfalso
        apply hv
        rw [pow_zero, one_mul] at hsz
        rw [← hsz]
        exact P.mul_mem_left s hz
      | succ m => exact ⟨s, T ^ m * v, hs, by rw [hsz, pow_succ]; ring⟩

  have step : ∀ (h t y x a b s z₁ : K) (k e : ℕ), t ≠ 0 → b ≠ 0 → ℓ * k = e + k + 1 →
      y * t ^ (ℓ * k) * (f₀ - (h ^ ℓ - h)) = x → s * (b ^ ℓ * x - a ^ ℓ * y) = t * z₁ →
      s * b ^ ℓ * y * t ^ (e + k) * (f₀ - ((h + a / (b * t ^ k)) ^ ℓ - (h + a / (b * t ^ k)))) =
        z₁ + s * a * b ^ (ℓ - 1) * y * t ^ e := by
    intro h t y x a b s z₁ k e ht hb hk hx hz
    rw [add_pow_char, div_pow, mul_pow, ← pow_mul, mul_comm k ℓ, hk]
    rw [hk] at hx
    obtain ⟨m, hm⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, by omega⟩
    rw [hm] at hz hx ⊢
    rw [Nat.add_sub_cancel]
    apply mul_left_cancel₀ ht
    have e1 : a ^ (m + 1) / (b ^ (m + 1) * t ^ (e + k + 1)) * (b ^ (m + 1) * t ^ (e + k + 1)) =
        a ^ (m + 1) :=
      div_mul_cancel₀ _ (mul_ne_zero (pow_ne_zero _ hb) (pow_ne_zero _ ht))
    have e2 : a / (b * t ^ k) * (b * t ^ k) = a :=
      div_mul_cancel₀ _ (mul_ne_zero hb (pow_ne_zero _ ht))
    linear_combination (s * b ^ m * b) * hx + hz - (s * y) * e1 + (t * s * y * b ^ m * t ^ e) * e2

  have claim : ∀ M : ℕ, ∀ (h : K) (X Y : A), 0 < M → X ∉ P → Y ∉ P →
      algebraMap A K Y * algebraMap A K T ^ M * (f₀ - (h ^ ℓ - h)) = algebraMap A K X →
      ∃ (h : K) (M : ℕ) (X Y : A), 0 < M ∧ ¬ ℓ ∣ M ∧ X ∉ P ∧ Y ∉ P ∧
        algebraMap A K Y * algebraMap A K T ^ M * (f₀ - (h ^ ℓ - h)) = algebraMap A K X := by
    intro M
    induction M using Nat.strong_induction_on with
    | _ M ih =>
      intro h X Y hM hX hY heq
      by_cases hdiv : ℓ ∣ M
      · obtain ⟨k, rfl⟩ := hdiv
        have hk1 : 1 ≤ k := by
          rcases Nat.eq_zero_or_pos k with h0 | h0
          · rw [h0, mul_zero] at hM; exact absurd hM (lt_irrefl 0)
          · exact h0
        have h2k : 2 * k ≤ ℓ * k := Nat.mul_le_mul_right k hℓ2
        obtain ⟨a, b, hb, hz⟩ := hroot X Y hY
        obtain ⟨s₂, z₁, hs₂, hsz⟩ := divT _ hz
        have hszK : algebraMap A K s₂ * (algebraMap A K b ^ ℓ * algebraMap A K X -
            algebraMap A K a ^ ℓ * algebraMap A K Y) = algebraMap A K T * algebraMap A K z₁ := by
          have := congrArg (algebraMap A K) hsz
          simp only [map_mul, map_sub, map_pow] at this
          exact this
        have hst := step h (algebraMap A K T) (algebraMap A K Y) (algebraMap A K X)
          (algebraMap A K a) (algebraMap A K b) (algebraMap A K s₂) (algebraMap A K z₁) k
          (ℓ * k - k - 1) hTne (hιne b (hne0 b hb)) (by omega) heq hszK
        have heq' : algebraMap A K (s₂ * b ^ ℓ * Y) * algebraMap A K T ^ (ℓ * k - k - 1 + k) *
            (f₀ - ((h + algebraMap A K a / (algebraMap A K b * algebraMap A K T ^ k)) ^ ℓ -
              (h + algebraMap A K a / (algebraMap A K b * algebraMap A K T ^ k)))) =
            algebraMap A K (z₁ + s₂ * a * b ^ (ℓ - 1) * Y * T ^ (ℓ * k - k - 1)) := by
          simp only [map_mul, map_add, map_pow]
          exact hst
        have hY' : s₂ * b ^ ℓ * Y ∉ P :=
          hmul _ _ (hmul _ _ hs₂ (fun h => hb (hP.mem_of_pow_mem _ h))) hY
        obtain ⟨M'', X'', Y'', hM'', hM''le, hX'', hY'', heq''⟩ := norm _ _ _ _ hY' heq'
        exact ih M'' (by omega) _ X'' Y'' hM'' hX'' hY'' heq''
      · exact ⟨h, M, X, Y, hM, hdiv, hX, hY, heq⟩

  obtain ⟨a₀, b₀, hb₀, hf⟩ := IsFractionRing.div_surjective (A := A) f₀
  have hb₀0 : b₀ ≠ 0 := nonZeroDivisors.ne_zero hb₀
  obtain ⟨n, s, v, hs, hv, hsb⟩ := hval b₀ hb₀0
  have h0 : f₀ - ((0 : K) ^ ℓ - 0) = f₀ := by rw [zero_pow hℓ.ne_zero]; ring
  have heq0 : algebraMap A K v * algebraMap A K T ^ n * (f₀ - ((0 : K) ^ ℓ - 0)) =
      algebraMap A K (s * a₀) := by
    have hb := hιne b₀ hb₀0
    have hsbK : algebraMap A K s * algebraMap A K b₀ = algebraMap A K T ^ n * algebraMap A K v := by
      have := congrArg (algebraMap A K) hsb
      rwa [map_mul, map_mul, map_pow] at this
    rw [h0, ← hf, map_mul, mul_div_assoc', div_eq_iff hb]
    linear_combination (-(algebraMap A K a₀)) * hsbK
  obtain ⟨M', X', Y', hM', -, hX', hY', heq'⟩ := norm 0 n (s * a₀) v hv heq0
  exact claim M' 0 X' Y' hM' hX' hY' heq'

theorem wcLlsASr_pole_normal_form : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → Module.finrank K L = ℓ → ∀ (α : L) (f₀ : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α → ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → (∃ Q, wcLlsGenPt W A L 𝔭 Q ∧ t - algebraMap ↥W A c ∈ Q.comap (algebraMap A ↥(integralClosure A L)) ∧ wcLlsRam A K L Q) → ∃ (h : K) (M : ℕ) (G₁ G₂ : A), 0 < M ∧ ¬ ℓ ∣ M ∧ (∀ x d : A, d ∉ 𝔭 → d * G₁ ≠ (t - algebraMap ↥W A c) * x) ∧ (∀ x d : A, d ∉ 𝔭 → d * G₂ ≠ (t - algebraMap ↥W A c) * x) ∧ algebraMap A K G₂ * algebraMap A K (t - algebraMap ↥W A c) ^ M * (f₀ - (h ^ ℓ - h)) = algebraMap A K G₁ :=
by
  classical
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD hdeg α f₀ hα hf₀ c hc hram

  have hPD' := hPD
  obtain ⟨_, _, _, hmax, _, _, _, _⟩ := hPD'
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h1 => hmax.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  obtain ⟨Q₀, ⟨hQ, hQle, hQc⟩, hTQ, hRam⟩ := hram
  haveI := hQ
  obtain ⟨P, hPdef⟩ : ∃ P : Ideal A, P = Q₀.comap (algebraMap A ↥(integralClosure A L)) :=
    ⟨_, rfl⟩
  have hPprime : P.IsPrime := by rw [hPdef]; infer_instance
  have hP𝔭 : P ≤ 𝔭 := by rw [hPdef]; exact hQle
  have hPc : ∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P := by rw [hPdef]; exact hQc
  have hTP : t - algebraMap ↥W A c ∈ P := by rw [hPdef]; exact hTQ
  have hKℓ : ((ℓ : ℕ) : K) = 0 := by
    have e1 : ((ℓ : ℕ) : Ω) = 0 := by rw [← hchar]; exact ringChar.Nat.cast_ringChar
    have e2 : ((ℓ : ℕ) : ↥W) = 0 := Subtype.ext (by simpa using e1)
    have e3 := congrArg (fun z => algebraMap A K (algebraMap ↥W A z)) e2
    simpa using e3

  obtain ⟨-, hsf2, -⟩ := wcpa_dj_llsm_kpdf_special_fibre_dvr Ω W hW hWt A 𝔭 t hPD
  have hT0 : t - algebraMap ↥W A c ≠ 0 := by
    intro h0
    apply hsf2 1 h1𝔭
    rw [one_mul, sub_eq_zero.mp h0]
    exact Ideal.mem_map_of_mem _ hc

  have hval : ∀ a : A, a ≠ 0 → ∃ (n : ℕ) (s v : A), s ∉ P ∧ v ∉ P ∧
      s * a = (t - algebraMap ↥W A c) ^ n * v := by
    intro a ha
    obtain ⟨r, cc, n, d, a', s, -, -, hd, ha', hs, hfac⟩ :=
      wcpa_dj_llsm_kpd_disc_factorization Ω W hW hWt A 𝔭 t hPD a ha
    have hsplit := Finset.prod_filter_mul_prod_filter_not (Finset.univ : Finset (Fin r))
      (fun i => cc i = c) (fun i => (t - algebraMap ↥W A (cc i)) ^ (n i))
    have hpart : ∏ i ∈ Finset.univ.filter (fun i => cc i = c),
        (t - algebraMap ↥W A (cc i)) ^ (n i) =
        (t - algebraMap ↥W A c) ^ (∑ i ∈ Finset.univ.filter (fun i => cc i = c), n i) := by
      rw [← Finset.prod_pow_eq_pow_sum]
      refine Finset.prod_congr rfl (fun i hi => ?_)
      rw [(Finset.mem_filter.mp hi).2]
    refine ⟨∑ i ∈ Finset.univ.filter (fun i => cc i = c), n i, s,
      algebraMap ↥W A d * a' * ∏ i ∈ Finset.univ.filter (fun i => ¬ cc i = c),
        (t - algebraMap ↥W A (cc i)) ^ (n i), fun h => hs (hP𝔭 h), ?_, ?_⟩
    · intro hv
      rcases hPprime.mem_or_mem hv with h1 | h1
      · rcases hPprime.mem_or_mem h1 with h2 | h2
        · exact hPc d hd h2
        · exact ha' (hP𝔭 h2)
      · obtain ⟨i, hi, hi2⟩ := (Ideal.IsPrime.prod_mem_iff (hp := hPprime)).mp h1
        have hi3 := hPprime.mem_of_pow_mem _ hi2
        have hci := (Finset.mem_filter.mp hi).2
        apply hci
        by_contra hne
        apply hPc (c - cc i) (sub_ne_zero.mpr (Ne.symm hne))
        have e : algebraMap ↥W A (c - cc i) =
            (t - algebraMap ↥W A (cc i)) - (t - algebraMap ↥W A c) := by
          rw [map_sub]; ring
        rw [e]
        exact P.sub_mem hi3 hTP
    · rw [hfac, ← hsplit, hpart]; ring

  have hroot : ∀ X Y : A, Y ∉ P → ∃ a b : A, b ∉ P ∧ b ^ ℓ * X - a ^ ℓ * Y ∈ P := by
    intro X Y hY
    obtain ⟨a, b, hb, hab⟩ := wcLlsASr_pnf_residue_root Ω W A 𝔭 t hPD P hPprime hP𝔭 hPc c hTP
      hT0 ℓ hℓ.pos X Y hY
    refine ⟨algebraMap ↥W A a, algebraMap ↥W A b, hPc b hb, ?_⟩
    rwa [map_pow, map_pow] at hab

  have hramP : ∀ (h : K) (d x : A), d ∉ P →
      algebraMap A K d * (f₀ - (h ^ ℓ - h)) ≠ algebraMap A K x := by
    intro h d x hd
    rw [hPdef] at hd
    exact wcLlsASr_pnf_ram_no_integral ℓ hℓ A K L hKℓ hdeg α f₀ hα hf₀ Q₀ hRam h d x hd

  obtain ⟨h, M, X, Y, hM, hℓM, hX, hY, heq⟩ := wcLlsASr_pnf_as_reduction ℓ hℓ A K hKℓ P hPprime
    (t - algebraMap ↥W A c) hT0 hTP f₀ hval hroot hramP
  have nd : ∀ G : A, G ∉ P → ∀ x d : A, d ∉ 𝔭 → d * G ≠ (t - algebraMap ↥W A c) * x := by
    intro G hG x d hd heq'
    have hmem : d * G ∈ P := by rw [heq']; exact Ideal.mul_mem_right x P hTP
    rcases hPprime.mem_or_mem hmem with h1 | h1
    · exact hd (hP𝔭 h1)
    · exact hG h1
  exact ⟨h, M, X, Y, hM, hℓM, nd X hX, nd Y hY, heq⟩

theorem wcLlsASr_cdpd_as_identities : ∀ (L : Type u) [CommRing L] (ℓ a b k M N : ℕ) (u T w U e : L), b * ℓ = a * M + 1 → k + b = a * M → N = M * (ℓ - 1) → u * T ^ M * (w ^ ℓ - e * w) = U → (u * T ^ M * w) ^ ℓ = (u * T ^ M) ^ (ℓ - 1) * (U + e * (u * T ^ M * w)) ∧ u * T ^ M * w ^ ℓ = U + e * (u * T ^ M * w) ∧ (u ^ a * w ^ a * T ^ b) ^ ℓ = u ^ (a * (ℓ - 1)) * T * (u * T ^ M * w ^ ℓ) ^ a ∧ u ^ (a * M * (ℓ - 1)) * (u * T ^ M * w ^ ℓ) ^ k * (u * T ^ M * w ^ ℓ - U) = e * u ^ (k + 1) * (u ^ a * w ^ a * T ^ b) ^ N ∧ u ^ k * (u * T ^ M * w ^ ℓ) ^ b = w * (u ^ a * w ^ a * T ^ b) ^ M :=
by
  intro L _ ℓ a b k M N u T w U e h1 h2 h3 h4
  cases ℓ with
  | zero => simp at h1
  | succ m =>
    simp only [Nat.add_sub_cancel] at h3 ⊢
    subst h3
    subst h4
    have E1 : k + 1 = b * m := by
      have h1' : b * m + b = a * M + 1 := by rw [← h1]; ring
      omega
    have E2 : (m + 1) * k + 1 = a * M * m := by
      calc (m + 1) * k + 1 = m * k + (k + 1) := by ring
        _ = m * k + b * m := by rw [E1]
        _ = m * (k + b) := by ring
        _ = a * M * m := by rw [h2]; ring
    refine ⟨by ring, by ring, ?_, ?_, ?_⟩
    · have eT : T ^ (b * (m + 1)) = T ^ (a * M + 1) := by rw [h1]
      calc (u ^ a * w ^ a * T ^ b) ^ (m + 1)
          = u ^ (a * (m + 1)) * w ^ (a * (m + 1)) * T ^ (b * (m + 1)) := by ring
        _ = u ^ (a * (m + 1)) * w ^ (a * (m + 1)) * T ^ (a * M + 1) := by rw [eT]
        _ = u ^ (a * m) * T * (u * T ^ M * w ^ (m + 1)) ^ a := by ring
    · have eT : T ^ (M * (k + 1)) = T ^ (M * (b * m)) := by rw [E1]
      have ew : w ^ ((m + 1) * k + 1) = w ^ (a * M * m) := by rw [E2]
      calc u ^ (a * M * m) * (u * T ^ M * w ^ (m + 1)) ^ k
            * (u * T ^ M * w ^ (m + 1) - u * T ^ M * (w ^ (m + 1) - e * w))
          = e * u ^ (a * M * m) * u ^ (k + 1) * T ^ (M * (k + 1)) * w ^ ((m + 1) * k + 1) := by
            ring
        _ = e * u ^ (a * M * m) * u ^ (k + 1) * T ^ (M * (b * m)) * w ^ (a * M * m) := by
            rw [eT, ew]
        _ = e * u ^ (k + 1) * (u ^ a * w ^ a * T ^ b) ^ (M * m) := by ring
    · have ew : w ^ (b * (m + 1)) = w ^ (a * M + 1) := by rw [h1]
      have eu : u ^ (k + b) = u ^ (a * M) := by rw [h2]
      calc u ^ k * (u * T ^ M * w ^ (m + 1)) ^ b
          = u ^ (k + b) * T ^ (M * b) * w ^ (b * (m + 1)) := by ring
        _ = u ^ (a * M) * T ^ (M * b) * w ^ (a * M + 1) := by rw [eu, ew]
        _ = w * (u ^ a * w ^ a * T ^ b) ^ M := by ring

theorem wcLlsASr_cdpd_model_point : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A] (𝔭 : Ideal A) (t c1 c2 c3 U : A) (ℓ a k N : ℕ) (E : Type u) [CommRing E] [Algebra ↥W E] (π : MvPolynomial (Fin 2) A →+* E), 𝔭.IsMaximal → 𝔭 = Ideal.span {t} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) → U ∉ 𝔭 → 0 < ℓ → 0 < N → Function.Surjective π → RingHom.ker π = Ideal.span {MvPolynomial.X 1 ^ ℓ - MvPolynomial.C (c1 * t) * MvPolynomial.X 0 ^ a, MvPolynomial.C c2 * MvPolynomial.X 0 ^ k * (MvPolynomial.X 0 - MvPolynomial.C U) - MvPolynomial.C c3 * MvPolynomial.X 1 ^ N} → (∀ w : ↥W, algebraMap ↥W E w = π (MvPolynomial.C (algebraMap ↥W A w))) → ∀ P : Ideal E, P = Ideal.span {π (MvPolynomial.X 0 - MvPolynomial.C U), π (MvPolynomial.X 1)} ⊔ 𝔭.map (π.comp MvPolynomial.C) → P.IsMaximal ∧ (∀ x : A, x ∉ 𝔭 → π (MvPolynomial.C x) ∉ P) ∧ π (MvPolynomial.X 0) ∉ P ∧ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W E) ≤ P ∧ ∀ g : E, IsUnit (algebraMap E (Localization.Away g) (π (MvPolynomial.X 0 * MvPolynomial.C (c1 * c2)))) → P.map (algebraMap E (Localization.Away g)) = (Ideal.span {π (MvPolynomial.X 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W E)).map (algebraMap E (Localization.Away g)) :=
by
  intro Ω _ W A _ _ 𝔭 t c1 c2 c3 U ℓ a k N E _ _ π hmax h𝔭eq hU hℓ hN hsurj hker hW P hP
  subst hP
  have ht : t ∈ 𝔭 := by
    rw [h𝔭eq]; exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self t)
  have hmA : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 := by
    rw [h𝔭eq]; exact le_sup_right
  have hF1 : π (MvPolynomial.X 1 ^ ℓ - MvPolynomial.C (c1 * t) * MvPolynomial.X 0 ^ a) = 0 := by
    rw [← RingHom.mem_ker, hker]; exact Ideal.subset_span (Set.mem_insert _ _)
  have hF2 : π (MvPolynomial.C c2 * MvPolynomial.X 0 ^ k * (MvPolynomial.X 0 - MvPolynomial.C U) -
      MvPolynomial.C c3 * MvPolynomial.X 1 ^ N) = 0 := by
    rw [← RingHom.mem_ker, hker]
    exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  let _ : Field (A ⧸ 𝔭) := Ideal.Quotient.field 𝔭
  set ev : MvPolynomial (Fin 2) A →+* A ⧸ 𝔭 :=
    MvPolynomial.eval₂Hom (Ideal.Quotient.mk 𝔭) ![Ideal.Quotient.mk 𝔭 U, 0] with hev
  have evC : ∀ r : A, ev (MvPolynomial.C r) = Ideal.Quotient.mk 𝔭 r := fun r =>
    MvPolynomial.eval₂Hom_C _ _ _
  have evX0 : ev (MvPolynomial.X 0) = Ideal.Quotient.mk 𝔭 U := MvPolynomial.eval₂Hom_X' _ _ _
  have evX1 : ev (MvPolynomial.X 1) = 0 := MvPolynomial.eval₂Hom_X' _ _ _
  set I : Ideal (MvPolynomial (Fin 2) A) :=
    Ideal.span {MvPolynomial.X 0 - MvPolynomial.C U, MvPolynomial.X 1} with hI
  have hXI : ∀ n : Fin 2, ∃ s : A, MvPolynomial.X n - MvPolynomial.C s ∈ I ∧
      ev (MvPolynomial.X n) = Ideal.Quotient.mk 𝔭 s := by
    refine Fin.forall_fin_two.mpr ⟨⟨U, Ideal.subset_span (Set.mem_insert _ _), evX0⟩, ⟨0, ?_, ?_⟩⟩
    · rw [map_zero, sub_zero]; exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
    · rw [map_zero]; exact evX1
  have htay : ∀ p : MvPolynomial (Fin 2) A, ∃ r : A, p - MvPolynomial.C r ∈ I ∧
      ev p = Ideal.Quotient.mk 𝔭 r := by
    intro p
    induction p using MvPolynomial.induction_on
    next r =>
      exact ⟨r, by rw [sub_self]; exact I.zero_mem, evC r⟩
    next p q hp hq =>
      obtain ⟨r, hr1, hr2⟩ := hp
      obtain ⟨s, hs1, hs2⟩ := hq
      refine ⟨r + s, ?_, ?_⟩
      · have e : p + q - MvPolynomial.C (r + s) =
            (p - MvPolynomial.C r) + (q - MvPolynomial.C s) := by rw [map_add]; ring
        rw [e]; exact I.add_mem hr1 hs1
      · rw [map_add, hr2, hs2, map_add]
    next p n hp =>
      obtain ⟨r, hr1, hr2⟩ := hp
      obtain ⟨s, hs1, hs2⟩ := hXI n
      refine ⟨r * s, ?_, ?_⟩
      · have e : p * MvPolynomial.X n - MvPolynomial.C (r * s) =
            (p - MvPolynomial.C r) * MvPolynomial.X n +
              MvPolynomial.C r * (MvPolynomial.X n - MvPolynomial.C s) := by rw [map_mul]; ring
        rw [e]; exact I.add_mem (I.mul_mem_right _ hr1) (I.mul_mem_left _ hs1)
      · rw [map_mul, hr2, hs2, map_mul]
  have hkerev : RingHom.ker ev = I ⊔ 𝔭.map (MvPolynomial.C : A →+* MvPolynomial (Fin 2) A) := by
    apply le_antisymm
    · intro p hp
      rw [RingHom.mem_ker] at hp
      obtain ⟨r, hr1, hr2⟩ := htay p
      rw [hr2, Ideal.Quotient.eq_zero_iff_mem] at hp
      rw [← sub_add_cancel p (MvPolynomial.C r)]
      exact Ideal.add_mem _ (Ideal.mem_sup_left hr1)
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hp))
    · apply sup_le
      · rw [hI, Ideal.span_le, Set.pair_subset_iff]
        refine ⟨?_, ?_⟩
        · rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, evX0, evC, sub_self]
        · rw [SetLike.mem_coe, RingHom.mem_ker, evX1]
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap, RingHom.mem_ker, evC, Ideal.Quotient.eq_zero_iff_mem]
        exact hx
  have hmt : Ideal.Quotient.mk 𝔭 t = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr ht
  have hle : RingHom.ker π ≤ RingHom.ker ev := by
    rw [hker, Ideal.span_le, Set.pair_subset_iff]
    refine ⟨?_, ?_⟩
    · rw [SetLike.mem_coe, RingHom.mem_ker]
      simp only [map_sub, map_mul, map_pow, evX0, evX1, evC, hmt, zero_pow hℓ.ne', mul_zero,
        zero_mul, sub_zero]
    · rw [SetLike.mem_coe, RingHom.mem_ker]
      simp only [map_sub, map_mul, map_pow, evX0, evX1, evC, sub_self, zero_pow hN.ne', mul_zero]
  have hPeq : Ideal.span {π (MvPolynomial.X 0 - MvPolynomial.C U), π (MvPolynomial.X 1)} ⊔
      𝔭.map (π.comp MvPolynomial.C) = (RingHom.ker ev).map π := by
    rw [hkerev, hI, Ideal.map_sup, Ideal.map_span, Set.image_pair, Ideal.map_map]
  have hcomap : ((RingHom.ker ev).map π).comap π = RingHom.ker ev := by
    rw [Ideal.comap_map_of_surjective' π hsurj, sup_eq_left.mpr hle]
  have hKmax : (RingHom.ker ev).IsMaximal := by
    refine RingHom.ker_isMaximal_of_surjective ev ?_
    intro z
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
    exact ⟨_, evC x⟩
  have hPmax : ((RingHom.ker ev).map π).IsMaximal := by
    rcases Ideal.map_eq_top_or_isMaximal_of_surjective π hsurj hKmax with h | h
    · exfalso
      apply hKmax.ne_top
      rw [← hcomap, h, Ideal.comap_top]
    · exact h
  have hnot : ∀ q, π q ∈ (RingHom.ker ev).map π → ev q = 0 := by
    intro q hq
    rw [← RingHom.mem_ker, ← hcomap]
    exact hq
  have hWc : (π.comp MvPolynomial.C).comp (algebraMap ↥W A) = algebraMap ↥W E :=
    RingHom.ext fun w => (hW w).symm
  have hpmap : 𝔭.map (π.comp MvPolynomial.C) = Ideal.span {π (MvPolynomial.C t)} ⊔
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W E) := by
    conv_lhs => rw [h𝔭eq]
    rw [Ideal.map_sup, Ideal.map_span, Set.image_singleton, RingHom.comp_apply, Ideal.map_map, hWc]
  have hC4 : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W E) ≤
      Ideal.span {π (MvPolynomial.X 0 - MvPolynomial.C U), π (MvPolynomial.X 1)} ⊔
        𝔭.map (π.comp MvPolynomial.C) := by
    refine le_trans ?_ le_sup_right
    rw [hpmap]
    exact le_sup_right
  refine ⟨by rw [hPeq]; exact hPmax, ?_, ?_, hC4, ?_⟩
  · intro x hx h
    rw [hPeq] at h
    have h' := hnot _ h
    rw [evC, Ideal.Quotient.eq_zero_iff_mem] at h'
    exact hx h'
  · intro h
    rw [hPeq] at h
    have h' := hnot _ h
    rw [evX0, Ideal.Quotient.eq_zero_iff_mem] at h'
    exact hU h'
  · intro g hg
    obtain ⟨ℓ', rfl⟩ : ∃ ℓ', ℓ = ℓ' + 1 := ⟨ℓ - 1, by omega⟩
    obtain ⟨N', rfl⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by omega⟩
    set ι := algebraMap E (Localization.Away g) with hι
    simp only [map_mul] at hg
    have hx0 : IsUnit (ι (π (MvPolynomial.X 0))) := isUnit_of_mul_isUnit_left hg
    have hc12 := isUnit_of_mul_isUnit_right hg
    have hc1 : IsUnit (ι (π (MvPolynomial.C c1))) := isUnit_of_mul_isUnit_left hc12
    have hc2 : IsUnit (ι (π (MvPolynomial.C c2))) := isUnit_of_mul_isUnit_right hc12
    obtain ⟨v1, hv1⟩ := (hc1.mul (hx0.pow a)).exists_left_inv
    obtain ⟨v2, hv2⟩ := (hc2.mul (hx0.pow k)).exists_left_inv
    have R1 := congrArg ι hF1
    have R2 := congrArg ι hF2
    simp only [map_sub, map_mul, map_pow, map_zero] at R1 R2
    have eT : ι (π (MvPolynomial.C t)) =
        (v1 * ι (π (MvPolynomial.X 1)) ^ ℓ') * ι (π (MvPolynomial.X 1)) := by
      linear_combination (-ι (π (MvPolynomial.C t))) * hv1 - v1 * R1
    have eD : ι (π (MvPolynomial.X 0)) - ι (π (MvPolynomial.C U)) =
        (v2 * ι (π (MvPolynomial.C c3)) * ι (π (MvPolynomial.X 1)) ^ N') *
          ι (π (MvPolynomial.X 1)) := by
      linear_combination (-(ι (π (MvPolynomial.X 0)) - ι (π (MvPolynomial.C U)))) * hv2 + v2 * R2
    have hx1mem : ι (π (MvPolynomial.X 1)) ∈ (Ideal.span {π (MvPolynomial.X 1)} ⊔
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W E)).map ι :=
      Ideal.mem_map_of_mem _ (Ideal.mem_sup_left (Ideal.mem_span_singleton_self _))
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      apply sup_le
      · rw [Ideal.span_le, Set.pair_subset_iff]
        refine ⟨?_, ?_⟩
        · rw [SetLike.mem_coe, Ideal.mem_comap, map_sub, map_sub, eD]
          exact Ideal.mul_mem_left _ _ hx1mem
        · rw [SetLike.mem_coe, Ideal.mem_comap]
          exact hx1mem
      · rw [hpmap]
        apply sup_le
        · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap, eT]
          exact Ideal.mul_mem_left _ _ hx1mem
        · exact Ideal.map_le_iff_le_comap.mp (Ideal.map_mono le_sup_right)
    · apply Ideal.map_mono
      apply sup_le_sup
      · exact Ideal.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert_of_mem _ rfl))
      · rw [hpmap]
        exact le_sup_right

theorem wcLlsASr_cdpd_model_etale : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A] (𝔭 : Ideal A) [𝔭.IsPrime] (t h c1 c2 c3 U : A) (ℓ a k N : ℕ) (f₀ : Polynomial ↥W →+* Localization.Away h) (E : Type u) [CommRing E] [Algebra ↥W E] (π : MvPolynomial (Fin 2) A →+* E), (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 → t ∈ 𝔭 → h ∉ 𝔭 → c1 ∉ 𝔭 → c2 ∉ 𝔭 → U ∉ 𝔭 → 0 < N → f₀.comp Polynomial.C = (algebraMap A (Localization.Away h)).comp (algebraMap ↥W A) → f₀ Polynomial.X = algebraMap A (Localization.Away h) t → RingHom.Etale f₀ → Function.Surjective π → RingHom.ker π = Ideal.span {MvPolynomial.X 1 ^ ℓ - MvPolynomial.C (c1 * t) * MvPolynomial.X 0 ^ a, MvPolynomial.C c2 * MvPolynomial.X 0 ^ k * (MvPolynomial.X 0 - MvPolynomial.C U) - MvPolynomial.C c3 * MvPolynomial.X 1 ^ N} → (∀ w : ↥W, algebraMap ↥W E w = π (MvPolynomial.C (algebraMap ↥W A w))) → ∀ (P : Ideal E) [P.IsPrime], P = Ideal.span {π (MvPolynomial.X 0 - MvPolynomial.C U), π (MvPolynomial.X 1)} ⊔ 𝔭.map (π.comp MvPolynomial.C) → (∀ x : A, x ∉ 𝔭 → π (MvPolynomial.C x) ∉ P) → ∀ g₀ : E, g₀ ∉ P → ∃ g : E, g ∉ P ∧ g₀ ∣ g ∧ ∃ f : Polynomial ↥W →+* Localization.Away g, f.comp Polynomial.C = (algebraMap E (Localization.Away g)).comp (algebraMap ↥W E) ∧ f Polynomial.X = algebraMap E (Localization.Away g) (π (MvPolynomial.X 1)) ∧ RingHom.Etale f :=
by
  have t_s2 : ∀ (R T : Type u) [CommRing R] [CommRing T] [Algebra R T] (f : Polynomial R →+* T) (hfC : f.comp Polynomial.C = algebraMap R T) (hf : RingHom.Etale f), Submodule.span T {KaehlerDifferential.D R T (f Polynomial.X)} = ⊤ := by
    intro R T _ _ _ f hfC hf
    letI := f.toAlgebra
    haveI : IsScalarTower R (Polynomial R) T := IsScalarTower.of_algebraMap_eq' (by
      rw [← hfC, Polynomial.algebraMap_eq]; rfl)
    haveI : Algebra.Etale (Polynomial R) T := hf.toAlgebra
    rw [eq_top_iff]
    rintro ω -
    obtain ⟨z, rfl⟩ :=
      (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale R (Polynomial R) T).surjective ω
    rw [KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply]
    induction z using TensorProduct.induction_on with
    | zero => rw [map_zero]; exact zero_mem _
    | tmul y w =>
      rw [KaehlerDifferential.mapBaseChange_tmul]
      have hw : w = (KaehlerDifferential.polynomialEquiv R w) •
          KaehlerDifferential.D R (Polynomial R) Polynomial.X := by
        rw [← KaehlerDifferential.polynomialEquiv_symm, LinearEquiv.symm_apply_apply]
      rw [hw, LinearMap.map_smul, KaehlerDifferential.map_D]
      apply Submodule.smul_mem
      rw [← algebraMap_smul T (KaehlerDifferential.polynomialEquiv R w)]
      apply Submodule.smul_mem
      exact Submodule.mem_span_singleton_self _
    | add z w hz hw => rw [map_add]; exact add_mem hz hw
  have t_s3 : ∀ (R T : Type u) [CommRing R] [CommRing T] [Algebra R T] (x : T) (hspan : Submodule.span T {KaehlerDifferential.D R T x} = ⊤), Submodule.span (MvPolynomial (Fin 2) T) {KaehlerDifferential.D R (MvPolynomial (Fin 2) T) (MvPolynomial.C x), KaehlerDifferential.D R (MvPolynomial (Fin 2) T) (MvPolynomial.X 0), KaehlerDifferential.D R (MvPolynomial (Fin 2) T) (MvPolynomial.X 1)} = ⊤ ∧ ∀ v : T, KaehlerDifferential.D R (MvPolynomial (Fin 2) T) (MvPolynomial.C v) ∈ Submodule.span (MvPolynomial (Fin 2) T) {KaehlerDifferential.D R (MvPolynomial (Fin 2) T) (MvPolynomial.C x)} := by
    intro R T _ _ _ x hspan
    have hb : ∀ v : T, KaehlerDifferential.D R (MvPolynomial (Fin 2) T) (MvPolynomial.C v) ∈ Submodule.span (MvPolynomial (Fin 2) T) {KaehlerDifferential.D R (MvPolynomial (Fin 2) T) (MvPolynomial.C x)} := by
      intro v
      have hv : KaehlerDifferential.D R T v ∈ Submodule.span T {KaehlerDifferential.D R T x} := by
        rw [hspan]; trivial
      obtain ⟨y, hy⟩ := Submodule.mem_span_singleton.mp hv
      have e := KaehlerDifferential.map_D R R T (MvPolynomial (Fin 2) T) v
      rw [← hy, LinearMap.map_smul, KaehlerDifferential.map_D] at e
      simp only [MvPolynomial.algebraMap_eq] at e
      rw [← e, ← algebraMap_smul (MvPolynomial (Fin 2) T) y]
      exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)
    refine ⟨?_, hb⟩
    rw [eq_top_iff, ← KaehlerDifferential.span_range_derivation, Submodule.span_le]
    rintro _ ⟨p, rfl⟩
    induction p using MvPolynomial.induction_on with
    | C v =>
      exact Submodule.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _)) (hb v)
    | add p q hp hq => rw [map_add]; exact add_mem hp hq
    | mul_X p n hp =>
      rw [Derivation.leibniz]
      refine add_mem (Submodule.smul_mem _ _ ?_) (Submodule.smul_mem _ _ hp)
      fin_cases n
      · exact Submodule.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert _ _))
      · exact Submodule.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
  have t_s4 : ∀ (R T : Type u) [CommRing R] [CommRing T] [Algebra R T] (f : Polynomial R →+* T) (hfC : f.comp Polynomial.C = algebraMap R T) (hf : RingHom.Etale f), RingHom.IsStandardSmoothOfRelativeDimension 3 (algebraMap R (MvPolynomial (Fin 2) T)) := by
    intro R T _ _ _ f hfC hf
    have hT : RingHom.IsStandardSmoothOfRelativeDimension 1 (algebraMap R T) := by
      let e : MvPolynomial (Fin 1) R →+* Polynomial R :=
        (MvPolynomial.uniqueAlgEquiv R (Fin 1)).toRingEquiv.toRingHom
      have h1 : RingHom.IsStandardSmoothOfRelativeDimension 1 (algebraMap R (MvPolynomial (Fin 1) R)) :=
        (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr inferInstance
      have h2 : RingHom.IsStandardSmoothOfRelativeDimension 0 e :=
        RingHom.etale_iff_isStandardSmoothOfRelativeDimension_zero.mp
          (RingHom.Etale.of_bijective (MvPolynomial.uniqueAlgEquiv R (Fin 1)).bijective)
      have h3 := RingHom.etale_iff_isStandardSmoothOfRelativeDimension_zero.mp hf
      have h4 := h3.comp (h2.comp h1)
      have heq : f.comp (e.comp (algebraMap R (MvPolynomial (Fin 1) R))) = algebraMap R T := by
        rw [← hfC]
        congr 1
        apply RingHom.ext
        intro r
        have := (MvPolynomial.uniqueAlgEquiv R (Fin 1)).commutes r
        rw [Polynomial.algebraMap_eq] at this
        exact this
      rw [heq] at h4
      simpa using h4
    have h2 : RingHom.IsStandardSmoothOfRelativeDimension 2 (algebraMap T (MvPolynomial (Fin 2) T)) :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 2).mpr inferInstance
    have h3 := h2.comp hT
    rw [← IsScalarTower.algebraMap_eq] at h3
    simpa using h3
  have t_s5 : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (q : Ideal S) [q.IsPrime] (τ ξ₀ ξ₁ c₁ c₂ c₃ U : S) (ℓ a k N : ℕ) (hspan : Submodule.span S {KaehlerDifferential.D R S τ, KaehlerDifferential.D R S ξ₀, KaehlerDifferential.D R S ξ₁} = ⊤) (hU : KaehlerDifferential.D R S U ∈ Submodule.span S {KaehlerDifferential.D R S τ}) (hτ : τ ∈ q) (hξ₀ : ξ₀ - U ∈ q) (hξ₁ : ξ₁ ∈ q) (hc₁ : c₁ ∉ q) (hc₂ : c₂ ∉ q) (hUq : U ∉ q) (hN : 0 < N), Submodule.span q.ResidueField (Set.range (fun j => (1 : q.ResidueField) ⊗ₜ[S] KaehlerDifferential.D R S (![ξ₁ ^ ℓ - c₁ * τ * ξ₀ ^ a, c₂ * ξ₀ ^ k * (ξ₀ - U) - c₃ * ξ₁ ^ N, ξ₁] j))) = ⊤ := by
    intro R S _ _ _ q _ τ ξ₀ ξ₁ c₁ c₂ c₃ U ℓ a k N hspan hU hτ hξ₀ hξ₁ hc₁ hc₂ hUq hN
    set V := Submodule.span q.ResidueField (Set.range (fun j => (1 : q.ResidueField) ⊗ₜ[S] KaehlerDifferential.D R S (![ξ₁ ^ ℓ - c₁ * τ * ξ₀ ^ a, c₂ * ξ₀ ^ k * (ξ₀ - U) - c₃ * ξ₁ ^ N, ξ₁] j))) with hV
    let Φ : Ω[S⁄R] →ₗ[S] TensorProduct S q.ResidueField Ω[S⁄R] := TensorProduct.mk S q.ResidueField Ω[S⁄R] 1
    let W' : Submodule S Ω[S⁄R] := (V.restrictScalars S).comap Φ
    have hW : ∀ m, m ∈ W' ↔ (1 : q.ResidueField) ⊗ₜ[S] m ∈ V := fun m => Iff.rfl
    have hmem : ∀ j : Fin 3, KaehlerDifferential.D R S (![ξ₁ ^ ℓ - c₁ * τ * ξ₀ ^ a, c₂ * ξ₀ ^ k * (ξ₀ - U) - c₃ * ξ₁ ^ N, ξ₁] j) ∈ W' :=
      fun j => (hW _).mpr (Submodule.subset_span ⟨j, rfl⟩)
    have hG1 : KaehlerDifferential.D R S (ξ₁ ^ ℓ - c₁ * τ * ξ₀ ^ a) ∈ W' := hmem 0
    have hG2 : KaehlerDifferential.D R S (c₂ * ξ₀ ^ k * (ξ₀ - U) - c₃ * ξ₁ ^ N) ∈ W' := hmem 1
    have hX1 : KaehlerDifferential.D R S ξ₁ ∈ W' := hmem 2
    have key : ∀ (r : S) (m : Ω[S⁄R]), (1 : q.ResidueField) ⊗ₜ[S] (r • m) =
        (algebraMap S q.ResidueField r) • ((1 : q.ResidueField) ⊗ₜ[S] m) := by
      intro r m
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one, ← TensorProduct.smul_tmul,
        Algebra.smul_def, mul_one]
    have P2 : ∀ s ∈ q, ∀ m, s • m ∈ W' := by
      intro s hs m
      rw [hW, key, Ideal.algebraMap_residueField_eq_zero.mpr hs, zero_smul]
      exact zero_mem _
    have P3 : ∀ s, s ∉ q → ∀ m, s • m ∈ W' → m ∈ W' := by
      intro s hs m hm
      rw [hW, key] at hm
      rw [hW]
      have hs0 : algebraMap S q.ResidueField s ≠ 0 :=
        fun h0 => hs (Ideal.algebraMap_residueField_eq_zero.mp h0)
      have e : (1 : q.ResidueField) ⊗ₜ[S] m = (algebraMap S q.ResidueField s)⁻¹ •
