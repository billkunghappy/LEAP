  obtain ⟨x, d, a, ha, hda, hE⟩ := hsmall
  obtain ⟨hMprime, hMlt, hMd⟩ := wcLlsASre_gauss_prime Ω W A K 𝔭 t hPD c b hc hb hb0
  have hd := hMd a d ha hda
  haveI := hMprime
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  have hRL : ∀ z : ↥(Algebra.adjoin A {wcLlsScS W A K t c b}),
      algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L z = algebraMap K L (z : K) :=
    fun z => IsScalarTower.algebraMap_apply _ K L z
  have hcoeB : ∀ z : ↥(Algebra.adjoin A {wcLlsScS W A K t c b}),
      ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L) z :
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)) : L) =
        algebraMap K L (z : K) :=
    fun z => hRL z
  have hinjRB : Function.Injective (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)) := by
    intro r s hrs
    have h2 : algebraMap K L (r : K) = algebraMap K L (s : K) := by
      rw [← hcoeB, ← hcoeB, hrs]
    exact Subtype.ext ((algebraMap K L).injective h2)
  obtain ⟨Q, -, hQprime, hQcomap⟩ := Ideal.exists_ideal_over_prime_of_isIntegral
    (S := ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L))
    ((IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp
      (algebraMap ↥W A))) ⊥ (by
        intro r hr
        rw [Ideal.mem_comap, Ideal.mem_bot] at hr
        have hr0 : r = 0 := hinjRB (by rw [hr, map_zero])
        rw [hr0]
        exact Ideal.zero_mem _)
  have hPd : algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L) d ∉ Q := by
    intro hQd
    apply hd
    rw [← hQcomap]
    exact Ideal.mem_comap.mpr hQd
  have hL : ((ℓ : ℕ) : L) = 0 := by rw [← map_natCast (algebraMap K L), hK, map_zero]
  haveI : CharP L ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hL
  have key : ∀ (D α' F H U Sx M X : L), (α' - H) ^ ℓ = α' ^ ℓ - H ^ ℓ → α' ^ ℓ - α' = F →
      (F - H ^ ℓ + H - U * Sx) * D = M * X →
      (D * (α' - H)) ^ ℓ - D ^ (ℓ - 1) * (D * (α' - H)) = D ^ ℓ * U * Sx + D ^ (ℓ - 1) * M * X := by
    intro D α' F H U Sx M X hw hf' hE'
