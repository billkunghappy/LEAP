    rw [Ideal.eq_top_iff_one]
    have e1 : (1 : ↥(Algebra.adjoin A {algebraMap A K (t - algebraMap ↥W A c) /
        algebraMap A K (algebraMap ↥W A β)})) =
        algebraMap A _ y * algebraMap A _ x + algebraMap A _ i := by
      rw [← map_mul, ← map_add, hyi, map_one]
    rw [e1]
