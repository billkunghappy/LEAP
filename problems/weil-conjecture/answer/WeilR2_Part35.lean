        rw [smul_smul, inv_mul_cancel₀ hs0, one_smul]
      rw [e]
      exact Submodule.smul_mem _ _ hm
    have hpow : ∀ (x : S) (n : ℕ), KaehlerDifferential.D R S x ∈ W' →
        KaehlerDifferential.D R S (x ^ n) ∈ W' := by
      intro x n hx
      rw [Derivation.leibniz_pow]
      exact nsmul_mem (Submodule.smul_mem _ _ hx) n
    have hξ₀q : ξ₀ ∉ q := by
      intro h0
      apply hUq
      have := q.sub_mem h0 hξ₀
      rwa [sub_sub_cancel] at this

    have hτW : KaehlerDifferential.D R S τ ∈ W' := by
      apply P3 (ξ₀ ^ a * c₁) (fun h0 => by
        rcases (Ideal.IsPrime.mem_or_mem ‹_› h0) with h0 | h0
        · exact hξ₀q (Ideal.IsPrime.mem_of_pow_mem ‹_› a h0)
        · exact hc₁ h0)
      have e : KaehlerDifferential.D R S (ξ₁ ^ ℓ - c₁ * τ * ξ₀ ^ a) =
          KaehlerDifferential.D R S (ξ₁ ^ ℓ) - ((c₁ * τ) • KaehlerDifferential.D R S (ξ₀ ^ a) +
            (ξ₀ ^ a * τ) • KaehlerDifferential.D R S c₁ + (ξ₀ ^ a * c₁) • KaehlerDifferential.D R S τ) := by
        rw [Derivation.map_sub, Derivation.leibniz, Derivation.leibniz, smul_add, smul_smul, smul_smul]
        abel
      have h1 := sub_mem (hpow ξ₁ ℓ hX1) hG1
      rw [e, sub_sub_cancel] at h1
      have h2 := sub_mem h1 (add_mem (P2 (c₁ * τ) (q.mul_mem_left _ hτ) (KaehlerDifferential.D R S (ξ₀ ^ a)))
        (P2 (ξ₀ ^ a * τ) (q.mul_mem_left _ hτ) (KaehlerDifferential.D R S c₁)))
      rwa [add_sub_cancel_left] at h2

    have hξ₀W : KaehlerDifferential.D R S ξ₀ ∈ W' := by
      obtain ⟨lam, hlam⟩ := Submodule.mem_span_singleton.mp hU
      apply P3 (c₂ * ξ₀ ^ k) (fun h0 => by
        rcases (Ideal.IsPrime.mem_or_mem ‹_› h0) with h0 | h0
        · exact hc₂ h0
        · exact hξ₀q (Ideal.IsPrime.mem_of_pow_mem ‹_› k h0))
      have e : KaehlerDifferential.D R S (c₂ * ξ₀ ^ k * (ξ₀ - U) - c₃ * ξ₁ ^ N) =
          (c₂ * ξ₀ ^ k) • KaehlerDifferential.D R S ξ₀ - (c₂ * ξ₀ ^ k) • KaehlerDifferential.D R S U +
            (ξ₀ - U) • KaehlerDifferential.D R S (c₂ * ξ₀ ^ k) -
            (c₃ • KaehlerDifferential.D R S (ξ₁ ^ N) + ξ₁ ^ N • KaehlerDifferential.D R S c₃) := by
        rw [Derivation.map_sub, Derivation.leibniz, Derivation.leibniz, Derivation.map_sub, smul_sub,
          Derivation.leibniz]
      have hξ₁N : ξ₁ ^ N ∈ q := q.pow_mem_of_mem hξ₁ N hN
      have hA : (c₂ * ξ₀ ^ k) • KaehlerDifferential.D R S U ∈ W' := by
        rw [← hlam]
        exact Submodule.smul_mem _ _ (Submodule.smul_mem _ _ hτW)
      have hB : (ξ₀ - U) • KaehlerDifferential.D R S (c₂ * ξ₀ ^ k) ∈ W' := P2 _ hξ₀ _
      have hC : c₃ • KaehlerDifferential.D R S (ξ₁ ^ N) + ξ₁ ^ N • KaehlerDifferential.D R S c₃ ∈ W' :=
        add_mem (Submodule.smul_mem _ _ (hpow ξ₁ N hX1)) (P2 _ hξ₁N _)
      rw [e] at hG2
      have h1 := add_mem (sub_mem (add_mem hG2 hC) hB) hA
      convert h1 using 1
      abel
    have htop : W' = ⊤ := by
      rw [eq_top_iff, ← hspan, Submodule.span_le]
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl | rfl
      · exact hτW
      · exact hξ₀W
      · exact hX1
    rw [eq_top_iff]
    rintro z -
    induction z using TensorProduct.induction_on with
    | zero => exact zero_mem _
    | tmul x m =>
      have hm : m ∈ W' := by rw [htop]; trivial
      have e : x ⊗ₜ[S] m = x • ((1 : q.ResidueField) ⊗ₜ[S] m) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [e]
      exact Submodule.smul_mem _ _ ((hW m).mp hm)
    | add z w hz hw => exact add_mem hz hw
  have t_s8 : ∀ (R S E : Type u) [CommRing R] [CommRing S] [CommRing E] [Algebra R S] (r : R) [IsLocalization.Away r S] (π : R →+* E) (I : Ideal S) (hπ : Function.Surjective π) (hI : I = (RingHom.ker π).map (algebraMap R S)), ∃ ι : E →+* (S ⧸ I), ι.comp π = (Ideal.Quotient.mk I).comp (algebraMap R S) ∧ @IsLocalization.Away E _ (π r) (S ⧸ I) _ ι.toAlgebra := by
    intro R S E _ _ _ _ r _ π I hπ hI
