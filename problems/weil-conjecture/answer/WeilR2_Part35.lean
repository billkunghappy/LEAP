      ∃ w' ∈ IsLocalRing.maximalIdeal ↥W, ∀ t ∈ L', w' ∣ f t := by
    intro f L'
    induction L' with
    | nil => intro _; exact ⟨g, hg, fun t ht => by simp at ht⟩
