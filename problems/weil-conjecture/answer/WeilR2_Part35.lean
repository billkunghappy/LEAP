            algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀) := by
        rw [map_one, map_one, mul_one]; exact hEq
      have hl0 : lam' ≠ 0 := hu.ne_zero
      by_cases hnk : n ≤ k
      · exact ⟨h, lam', 1, w, n, k, ε₀, ε₁, r₀, r₁, g₀, g₁, hl0, one_ne_zero, hw, hε₀, hε₁,
          hEq1, Or.inl ⟨one_dvd _, Or.inl hnk⟩⟩
      by_cases hdiv : (ℓ : ℤ) ∣ ((k : ℤ) - n)
      · obtain ⟨h', lam'', w', n', k', ε₀', ε₁', r₀', r₁', g₀', g₁', hl'', hw', hε₀', hε₁', hEq',
          hcase⟩ := wcLlsASbb_pole_step Ω W hW hWt ℓ hℓ A K L 𝔭 u v g hPD hK α f₀ hα hf₀ h lam' w
            n k ε₀ ε₁ r₀ r₁ g₀ g₁ hu hw hε₀ hε₁ (by omega) hdiv hEq
        rcases hcase with hm | ⟨hu'', hlt⟩
        · refine ⟨h', lam'', 1, w', n', k', ε₀', ε₁', r₀', r₁', g₀', g₁', hl'', one_ne_zero, hw',
            hε₀', hε₁', ?_, Or.inl ⟨one_dvd _, Or.inr ⟨lam'', (one_mul _).symm, hm⟩⟩⟩
          rw [map_one, map_one, mul_one]; exact hEq'
        · exact ih (n' - k') (by omega) h' lam'' w' n' k' ε₀' ε₁' r₀' r₁' g₀' g₁' hu'' hw' hε₀'
            hε₁' le_rfl hEq'
      · exact ⟨h, lam', 1, w, n, k, ε₀, ε₁, r₀, r₁, g₀, g₁, hl0, one_ne_zero, hw, hε₀, hε₁,
          hEq1, Or.inr hdiv⟩

  obtain ⟨h₀, lam₁, lam₂, w, n, k, ε₀, ε₁, r₀, r₁, g₀, g₁, hl₁, hl₂, hw, hε₀, hε₁, hEQ, hD⟩ :=
    wcLlsASbb_best_approx Ω W hW hWt ℓ hℓ A K L 𝔭 u v g hPD hK α f₀ hα hf₀
  have hdivcase : lam₂ ∣ lam₁ →
      ∃ (h : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A),
        lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀ ∉ 𝔭 ∧ ε₁ ∉ 𝔭 ∧
        (f₀ - (h ^ ℓ - h)) * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) *
            algebraMap A K (algebraMap ↥W A lam₂) =
          algebraMap A K (algebraMap ↥W A lam₁) *
            algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀) ∧
        ((lam₂ ∣ lam₁ ∧ (n ≤ k ∨ ∃ lam' : ↥W, lam₁ = lam₂ * lam' ∧
            lam' ∈ IsLocalRing.maximalIdeal ↥W)) ∨ ¬ (ℓ : ℤ) ∣ ((k : ℤ) - n)) := by
    rintro ⟨lam', rfl⟩
    by_cases hm : lam' ∈ IsLocalRing.maximalIdeal ↥W
    · exact ⟨h₀, lam₂ * lam', lam₂, w, n, k, ε₀, ε₁, r₀, r₁, g₀, g₁, hl₁, hl₂, hw, hε₀, hε₁,
        hEQ, Or.inl ⟨dvd_mul_right _ _, Or.inr ⟨lam', rfl, hm⟩⟩⟩
    · have hu : IsUnit lam' := by
        by_contra hnu
        exact hm ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu))
      have hEq : (f₀ - (h₀ ^ ℓ - h₀)) *
          algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) =
          algebraMap A K (algebraMap ↥W A lam') *
            algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀) := by
        apply mul_right_cancel₀ (hinj lam₂ hl₂)
        rw [map_mul, map_mul] at hEQ
        linear_combination hEQ
      exact hP (n - k) h₀ lam' w n k ε₀ ε₁ r₀ r₁ g₀ g₁ hu hw hε₀ hε₁ le_rfl hEq
  rcases hD with hd | hmax
  · exact hdivcase hd
  · by_cases hd : lam₂ ∣ lam₁
    · exact hdivcase hd
    · obtain ⟨h, lam₁', lam₂', w', n', k', ε₀', ε₁', r₀', r₁', g₀', g₁', a1, a2, a3, a4, a5, a6,
        a7⟩ := wcLlsASbb_neg_step Ω W hW hWt ℓ hℓ A K L 𝔭 u v g hPD hK α f₀ hα hf₀ h₀ lam₁ lam₂
