        rw [Function.iterate_succ_apply', hσ, ih, pow_succ', AlgEquiv.mul_apply]
    have hσℓ : ∀ x, (⇑σ)^[ℓ] x = x := fun x => Subtype.ext (by rw [hσit, hgℓ]; rfl)
    have hstab : 𝔔.comap σ = 𝔔 := by
      apply hU
      · infer_instance
      · ext r
        rw [Ideal.mem_comap, Ideal.mem_comap, AlgEquiv.commutes, ← Ideal.mem_comap, hco]
    have hσmem : ∀ x, σ x ∈ 𝔔 ↔ x ∈ 𝔔 := fun x => by
      rw [← Ideal.mem_comap, hstab]
    have hle : 𝔔 ≤ 𝔔.comap (σ : ↥(integralClosure R L) →+* ↥(integralClosure R L)) := by
      intro x hx
      rw [Ideal.mem_comap]
      exact (hσmem x).mpr hx
    obtain ⟨φ, hφmk⟩ : ∃ φ : (↥(integralClosure R L) ⧸ 𝔔) →+* (↥(integralClosure R L) ⧸ 𝔔),
        ∀ x, φ (Ideal.Quotient.mk 𝔔 x) = Ideal.Quotient.mk 𝔔 (σ x) :=
      ⟨Ideal.quotientMap 𝔔 (σ : ↥(integralClosure R L) →+* ↥(integralClosure R L)) hle,
        fun x => Ideal.quotientMap_mk⟩
    have hφit : ∀ (j : ℕ) x, (⇑φ)^[j] (Ideal.Quotient.mk 𝔔 x) =
        Ideal.Quotient.mk 𝔔 ((⇑σ)^[j] x) := by
