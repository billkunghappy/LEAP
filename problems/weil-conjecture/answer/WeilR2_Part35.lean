          algebraMap ↥W A t.1 * (v * (-1) + algebraMap ↥W A w' * algebraMap ↥W A d'') := by
        linear_combination (-1 : A) * hcd'
      obtain ⟨e', r', h', he', hp⟩ :=
        hpow v u (algebraMap ↥W A w') (-1) (algebraMap ↥W A d'') hneg1 t.2.2
      have keyA : (u - algebraMap ↥W A t.1) ^ t.2.2 * v ^ t.2.2 =
          (algebraMap ↥W A t.1) ^ t.2.2 *
            (v ^ t.2.2 * e' + u * r' + algebraMap ↥W A w' * h') := by
        rw [← mul_pow, hsw, mul_pow, hp]
      obtain ⟨E, R, H, hE, hEq⟩ :=
        hprod v u (algebraMap ↥W A w') t.2.2 k e' r' h' ε r h he' hε
      refine ⟨t.2.2 + k, E, R, H, hE, ?_⟩
      have keyK := congrArg (algebraMap A K) keyA
      simp only [List.map_cons, List.prod_cons, List.sum_cons]
      rw [← hEq]
      simp only [map_mul, map_pow] at keyK ⊢
      linear_combination
        ((L'.map (fun t => algebraMap A K (u - algebraMap ↥W A t.1) ^ t.2.2)).prod *
          algebraMap A K v ^ (L'.map (fun t => t.2.2)).sum) * keyK +
        (algebraMap A K (algebraMap ↥W A t.1) ^ t.2.2 *
          algebraMap A K (v ^ t.2.2 * e' + u * r' + algebraMap ↥W A w' * h')) * hq
  have hκ : ∀ L' : List (↥W × ↥W × ℕ), (∀ t ∈ L', t.1 * t.2.1 = g) →
      (L'.map (fun t => t.1 ^ t.2.2)).prod ≠ 0 := by
    intro L'
    induction L' with
    | nil => intro _; simp
    | cons t L' ih =>
      intro h
      rw [List.forall_mem_cons] at h
      have hc0 : t.1 ≠ 0 := fun h0 => hg0 (by rw [← h.1, h0, zero_mul])
      simp only [List.map_cons, List.prod_cons]
      exact mul_ne_zero (pow_ne_zero _ hc0) (ih h.2)
  refine ⟨?_, ?_⟩
  ·
    obtain ⟨w', hw'm, hw'⟩ := hcd (fun t => t.1) L (fun t ht => (hL t ht).1)
    obtain ⟨k, ε, r, h, hε, hB⟩ := hU w' L hw'
    rw [hB] at hfac
    rcases le_or_gt 0 N with hN | hN
