  obtain ⟨h, hh𝔭, ψ₀, hψ₀C, -, hψ₀et⟩ :=
    wcLlsKPas_chart_etale Ω W A K 𝔭 t hPD c r₀ hc hr₀ hr₀0

  obtain ⟨P, iP1, iP2, iP3, iP4, iP5, ψP, ι, hψPet, hψPeq, hPinj, hPR, hPfrac, hPloc⟩ :=
    wcLlsKPas_chart_localize Ω W ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) K L
      (algebraMap A _ h) q hinjRK (hRne h hh𝔭) hq0 ψ₀ hψ₀et

  have hψPK : ∀ π : ↥W, algebraMap P K (ψP (Polynomial.C π)) =
      algebraMap A K (algebraMap ↥W A π) := by
    intro π
    have e1 : ψ₀ (Polynomial.C π) =
        algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀})
          (Localization.Away (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) h))
          (algebraMap A _ (algebraMap ↥W A π)) := RingHom.congr_fun hψ₀C π
    rw [hψPeq, RingHom.comp_apply, e1, hPR, hRK]
  have hψPL : ∀ π : ↥W, algebraMap P L (ψP (Polynomial.C π)) =
      algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) L
        (((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀})).comp
          (algebraMap ↥W A)) π) := by
    intro π
    rw [IsScalarTower.algebraMap_apply P K L, hψPK, hRL, RingHom.comp_apply, hRK]
  have hPLinj : Function.Injective (algebraMap P L) := by
    rw [IsScalarTower.algebraMap_eq P K L]
    exact (algebraMap K L).injective.comp hPinj

  have hpqK : algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) K q ^ 1 *
      ((p : K) / (q : K)) ∈
      Set.range (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) K) := by
    refine ⟨p, ?_⟩
    rw [pow_one]
    show (p : K) = (q : K) * ((p : K) / (q : K))
    rw [mul_div_cancel₀ _ hqK]
  obtain ⟨f, hf⟩ := hPloc ((p : K) / (q : K)) 1 hpqK

  obtain ⟨FP, hFPdef⟩ : ∃ FP : Polynomial P,
      FP = Polynomial.X ^ ℓ - (Polynomial.X + Polynomial.C f) := ⟨_, rfl⟩
  have hℓ2 := hℓ.two_le
  have hdeg1 : (Polynomial.X + Polynomial.C f : Polynomial P).degree <
      (Polynomial.X ^ ℓ : Polynomial P).degree := by
    rw [Polynomial.degree_X_add_C, Polynomial.degree_X_pow]
    exact_mod_cast (show 1 < ℓ by omega)
  have hFmon : FP.Monic := by
    rw [hFPdef]
    exact (Polynomial.monic_X_pow ℓ).sub_of_left hdeg1
  have hFdeg : FP.natDegree = ℓ := by
    rw [hFPdef, Polynomial.natDegree_sub_eq_left_of_natDegree_lt, Polynomial.natDegree_X_pow]
    rw [Polynomial.natDegree_X_add_C, Polynomial.natDegree_X_pow]
