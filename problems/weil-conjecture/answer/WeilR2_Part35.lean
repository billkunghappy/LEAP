  have hset : {z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (z : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} =
