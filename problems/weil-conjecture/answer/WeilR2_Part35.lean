        ((p.coeff i : ↥(wcLlsIsiCR W A' K u' b₀)) : K) ∈ wcVdR0 W A K t c₀ b₀ e' := by
      intro i hi
      rw [← Finset.mul_prod_erase _ _ (Finset.mem_range.mpr hi)]
      have e : kf i * (∏ j ∈ (Finset.range p.natDegree).erase i, kf j) *
          ((p.coeff i : ↥(wcLlsIsiCR W A' K u' b₀)) : K) =
          (kf i * ((p.coeff i : ↥(wcLlsIsiCR W A' K u' b₀)) : K)) *
            ∏ j ∈ (Finset.range p.natDegree).erase i, kf j := by ring
      rw [e]
      exact mul_mem (hkf i).2 (Subalgebra.prod_mem _ (fun j _ => hkR j))
    set k := ∏ i ∈ Finset.range p.natDegree, kf i with hkdef
    have hPkm : (p.map (algebraMap ↥(wcLlsIsiCR W A' K u' b₀) K)).Monic := hpm.map _
    have hPkdeg : (p.map (algebraMap ↥(wcLlsIsiCR W A' K u' b₀) K)).natDegree = p.natDegree :=
      hpm.natDegree_map _
    have hcoef : ∀ i, ((p.coeff i : ↥(wcLlsIsiCR W A' K u' b₀)) : K) * k ^ (p.natDegree - i) ∈
        wcVdR0 W A K t c₀ b₀ e' := by
      intro i
      rcases lt_trichotomy i p.natDegree with hi | hi | hi
      · obtain ⟨m, hm⟩ : ∃ m, p.natDegree - i = m + 1 := ⟨p.natDegree - i - 1, by omega⟩
        rw [hm, pow_succ]
        have e : ((p.coeff i : ↥(wcLlsIsiCR W A' K u' b₀)) : K) * (k ^ m * k) =
            (k * ((p.coeff i : ↥(wcLlsIsiCR W A' K u' b₀)) : K)) * k ^ m := by ring
        rw [e]
        exact mul_mem (hkc i hi) (pow_mem hkmem m)
      · have hc1 : p.coeff i = 1 := by rw [hi]; exact hpm.coeff_natDegree
        rw [hc1, hi, Nat.sub_self, pow_zero, mul_one, OneMemClass.coe_one]
        exact one_mem _
      · have hc0 : p.coeff i = 0 := Polynomial.coeff_eq_zero_of_natDegree_lt hi
        rw [hc0, ZeroMemClass.coe_zero, zero_mul]
        exact zero_mem _
    have hlift : (p.map (algebraMap ↥(wcLlsIsiCR W A' K u' b₀) K)).scaleRoots k ∈
        Polynomial.lifts (algebraMap ↥(wcVdR0 W A K t c₀ b₀ e') K) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [Polynomial.coeff_scaleRoots, hPkdeg, Polynomial.coeff_map]
      exact ⟨⟨_, hcoef i⟩, rfl⟩
    obtain ⟨Q, hQmap, -, hQm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift
      ((Polynomial.monic_scaleRoots_iff k).mpr hPkm)
    refine ⟨Q, hQm, ?_⟩
    have hRL : algebraMap ↥(wcVdR0 W A K t c₀ b₀ e') L =
        (algebraMap K L).comp (algebraMap ↥(wcVdR0 W A K t c₀ b₀ e') K) :=
      RingHom.ext fun _ => rfl
    have hCL : algebraMap ↥(wcLlsIsiCR W A' K u' b₀) L =
        (algebraMap K L).comp (algebraMap ↥(wcLlsIsiCR W A' K u' b₀) K) :=
      RingHom.ext fun _ => rfl
    rw [hRL, ← Polynomial.eval₂_map, hQmap, Polynomial.scaleRoots_eval₂_mul,
      Polynomial.eval₂_map, ← hCL, hpz, mul_zero]

  have hadj : Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b'') /
      algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e'))} ≤ wcVdR0 W A K t c₀ b₀ e' := by
    rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff]
    have hV : wcLlsScV W A K t (c₀ + b₀ * e') b₀ ∈ wcVdR0 W A K t c₀ b₀ e' :=
      Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
    have heq : algebraMap A K (algebraMap ↥W A b'') /
        algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e')) =
        algebraMap A K (algebraMap ↥W A q'') * wcLlsScV W A K t (c₀ + b₀ * e') b₀ := by
      simp only [wcLlsScV, hq'', map_mul]
      ring
    rw [SetLike.mem_coe, heq]
    exact mul_mem (Subalgebra.algebraMap_mem _ _) hV

  have hS : ({wcLlsIsiS1 W A' K u' b₀, wcLlsIsiS2 W A' K u' b₀} : Set K) ⊆
      (wcVdR0 W A K t c₀ b₀ e' : Set K) := by
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · have hSm : wcLlsScS W A K t c₀ b₀ ∈ wcVdR0 W A K t c₀ b₀ e' :=
        Algebra.subset_adjoin (Set.mem_insert _ _)
      have hE : algebraMap A K (algebraMap ↥W A e') ∈ wcVdR0 W A K t c₀ b₀ e' :=
        Subalgebra.algebraMap_mem _ _
      have heq : wcLlsIsiS1 W A' K u' b₀ =
          wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e') := by
        simp only [wcLlsScS, wcLlsIsiS1, hu', hBr1]
        rw [eq_sub_iff_add_eq, div_add' _ _ _ hb0K]
        congr 1
        simp only [map_sub, map_add, map_mul]
        ring
      rw [SetLike.mem_coe, heq]
      exact sub_mem hSm hE
    · have heq : wcLlsIsiS2 W A' K u' b₀ = wcLlsScV W A K t (c₀ + b₀ * e') b₀ := by
        simp only [wcLlsScV, wcLlsIsiS2, hu', hBr1]
      rw [SetLike.mem_coe, heq]
      exact Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))

  obtain ⟨P, hPdef⟩ : ∃ P : K → Prop, P = fun k => k ∈ wcVdR0 W A K t c₀ b₀ e' ∧
      ∃ qq g : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L),
        (qq : L) = algebraMap K L k ∧ qq * g - 1 ∈ wcVdJ0 W A K L t c₀ b₀ e' := ⟨_, rfl⟩
  have hP1 : P 1 := by
    rw [hPdef]
    refine ⟨one_mem _, 1, 1, ?_, ?_⟩
    · rw [map_one]; rfl
    · rw [mul_one, sub_self]; exact zero_mem _
  have hPmul : ∀ a b, P a → P b → P (a * b) := by
    intro a b ha hb
    rw [hPdef] at ha hb ⊢
    obtain ⟨ha, qa, ga, hqa, hga⟩ := ha
    obtain ⟨hb, qb, gb, hqb, hgb⟩ := hb
    refine ⟨mul_mem ha hb, qa * qb, ga * gb, ?_, ?_⟩
    · rw [map_mul, ← hqa, ← hqb]; rfl
    · have h : qa * qb * (ga * gb) - 1 = (qa * ga - 1) * (qb * gb) + (qb * gb - 1) := by ring
      rw [h]
      exact add_mem (Ideal.mul_mem_right _ _ hga) hgb
  have hPR : ∀ a, P a → a ∈ wcVdR0 W A K t c₀ b₀ e' := by
    intro a ha
    rw [hPdef] at ha
    exact ha.1

  have hA' : ∀ a' : A', ∃ k, P k ∧ k * algebraMap A' K a' ∈ wcVdR0 W A K t c₀ b₀ e' := by
    intro a'
    obtain ⟨p, q, hq, hpq⟩ := hBr3 (algebraMap A' K a') ⟨a', rfl⟩
    have hqR : (q : K) ∈ wcVdR0 W A K t c₀ b₀ e' := hadj q.2
    have hint : IsIntegral ↥(wcVdR0 W A K t c₀ b₀ e') (algebraMap K L (q : K)) :=
      (isIntegral_algebraMap :
        IsIntegral _ (algebraMap ↥(wcVdR0 W A K t c₀ b₀ e') L ⟨(q : K), hqR⟩))
    obtain ⟨g, hg⟩ := hU q hq ⟨algebraMap K L (q : K), hint⟩ rfl
    refine ⟨q, ?_, ?_⟩
    · rw [hPdef]
      exact ⟨hqR, ⟨_, hint⟩, g, rfl, hg⟩
    · rw [mul_comm, hpq]
      exact hadj p.2

  have hden := gd1 P hP1 hPmul hPR hS hA'
  obtain ⟨k, hk, hint⟩ := gd2 P hP1 hPmul hPR hden (y : L) y.2
  rw [hPdef] at hk
  obtain ⟨-, qq, g, hqq, hg⟩ := hk
  exact ⟨qq, g, ⟨_, hint⟩, by rw [hqq], hg⟩

theorem wcLlsVd_chart_transfer : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A) (c₀ b₀ e' b'' : ↥W),
    wcLlsPD W A 𝔭 (.disc t) →
    c₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 →
    b'' ∈ IsLocalRing.maximalIdeal ↥W → b'' ≠ 0 → b₀ ∣ b'' → ¬ b'' ∣ b₀ →
    ∀ (A' : Type u) [CommRing A'] [IsDomain A'] [Algebra ↥W A'] [Algebra A' K]
      [IsFractionRing A' K] [Algebra A' L] [IsScalarTower A' K L] (u' v' : A') (𝔭' : Ideal A'),
    wcLlsBrSub W A K A'
      (algebraMap A K (algebraMap ↥W A b'') / algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e')))
      {algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e')),
        algebraMap A K (algebraMap ↥W A b'') /
          algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e'))} →
    algebraMap A' K u' = algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e')) →
    algebraMap A' K v' =
      algebraMap A K (algebraMap ↥W A b'') / algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e')) →
    wcLlsPD W A' 𝔭' (.ann u' v' b'') →
    (letI : CommRing (wcVdD W A K L t c₀ b₀ e') := wcVdD.commRing W A K L t c₀ b₀ e'; ∃ (n : ℕ) (φ₀ : wcVdD W A K L t c₀ b₀ e' ≃+*
        (Fin n → LaurentPolynomial (IsLocalRing.ResidueField ↥W))),
      ∀ (w : ↥W) (c : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L)),
        (c : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w)) →
        ∀ i, φ₀ (wcVdD.mk W A K L t c₀ b₀ e' c) i =
          LaurentPolynomial.C (IsLocalRing.residue ↥W w)) →
    wcLlsIsiCirc W A' K L u' b₀ :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t c₀ b₀ e' b'' hPD hc₀ hb₀ hb₀0 hb''m
    hb''0 hdiv hnd A' _ _ _ _ _ _ _ u' v' 𝔭' hBr hu' hv' hPD' hφ
  classical

  have s1 : ∀ (P Q : Type u) [CommRing P] [CommRing Q] (ι : P →+* Q), Function.Injective ι →
      ∀ (I₀ : Ideal P), (∀ y : Q, ∃ q g x : P, ι q * y = ι x ∧ q * g - 1 ∈ I₀.radical) →
      ∃ θ : (P ⧸ I₀.radical) ≃+* (Q ⧸ (I₀.map ι).radical),
        ∀ x : P, θ (Ideal.Quotient.mk I₀.radical x) = Ideal.Quotient.mk (I₀.map ι).radical (ι x) := by
    intro P Q _ _ ι hι I₀ hgood
    have hle : I₀.radical ≤ (I₀.map ι).radical.comap ι := by
      intro x hx
      rw [Ideal.mem_comap]
      obtain ⟨N, hN⟩ := Ideal.mem_radical_iff.mp hx
      exact Ideal.mem_radical_iff.mpr ⟨N, by rw [← map_pow]; exact Ideal.mem_map_of_mem ι hN⟩
    have hsurj : Function.Surjective (Ideal.quotientMap (I₀.map ι).radical ι hle) := by
      intro z
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨q, g, x, hqx, hqg⟩ := hgood y
      refine ⟨Ideal.Quotient.mk _ (g * x), ?_⟩
      rw [Ideal.quotientMap_mk, Ideal.Quotient.eq]
      have h1 : ι (g * x) - y = ι (q * g - 1) * y := by
        rw [map_mul, ← hqx, map_sub, map_mul, map_one]; ring
      rw [h1]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_comap.mp (hle hqg))
    have hC : ∀ z ∈ I₀.map ι, ∃ q g x' : P, ι q * z = ι x' ∧ x' ∈ I₀ ∧ q * g - 1 ∈ I₀.radical := by
      intro z hz
      have hz' : z ∈ Submodule.span Q (⇑ι '' (I₀ : Set P)) := hz
      clear hz
      induction hz' using Submodule.span_induction with
      | mem z hzz =>
        obtain ⟨a, ha, rfl⟩ := hzz
        exact ⟨1, 1, a, by rw [map_one, one_mul], ha,
          by rw [mul_one, sub_self]; exact zero_mem _⟩
      | zero =>
        exact ⟨1, 1, 0, by rw [mul_zero, map_zero], zero_mem _,
          by rw [mul_one, sub_self]; exact zero_mem _⟩
      | add z₁ z₂ _ _ h₁ h₂ =>
        obtain ⟨q₁, g₁, x₁, e₁, m₁, u₁⟩ := h₁
        obtain ⟨q₂, g₂, x₂, e₂, m₂, u₂⟩ := h₂
        refine ⟨q₁ * q₂, g₁ * g₂, q₂ * x₁ + q₁ * x₂, ?_,
          add_mem (Ideal.mul_mem_left _ _ m₁) (Ideal.mul_mem_left _ _ m₂), ?_⟩
        · rw [map_add, map_mul, map_mul, map_mul, ← e₁, ← e₂]; ring
        · have h : q₁ * q₂ * (g₁ * g₂) - 1 = (q₁ * g₁ - 1) * (q₂ * g₂) + (q₂ * g₂ - 1) := by ring
          rw [h]; exact add_mem (Ideal.mul_mem_right _ _ u₁) u₂
      | smul a z _ h =>
        obtain ⟨q₂, g₂, x₂, e₂, m₂, u₂⟩ := h
        obtain ⟨q₁, g₁, x₁, e₁, u₁⟩ := hgood a
        refine ⟨q₁ * q₂, g₁ * g₂, x₁ * x₂, ?_, Ideal.mul_mem_left _ _ m₂, ?_⟩
        · rw [smul_eq_mul, map_mul, map_mul, ← e₁, ← e₂]; ring
        · have h : q₁ * q₂ * (g₁ * g₂) - 1 = (q₁ * g₁ - 1) * (q₂ * g₂) + (q₂ * g₂ - 1) := by ring
          rw [h]; exact add_mem (Ideal.mul_mem_right _ _ u₁) u₂
    have hinj : Function.Injective (Ideal.quotientMap (I₀.map ι).radical ι hle) := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
      rw [Ideal.quotientMap_mk, Ideal.Quotient.eq_zero_iff_mem] at hz
      rw [Ideal.Quotient.eq_zero_iff_mem]
      obtain ⟨N, hN⟩ := Ideal.mem_radical_iff.mp hz
      rw [← map_pow] at hN
      obtain ⟨q, g, x', e, hx', u⟩ := hC _ hN
      have h1 : q * x ^ N = x' := hι (by rw [map_mul]; exact e)
      have h2 : x ^ N = g * (q * x ^ N) - (q * g - 1) * x ^ N := by ring
      apply Ideal.mem_radical_of_pow_mem (m := N)
      rw [h2, h1]
      exact sub_mem (Ideal.mul_mem_left _ _ (Ideal.le_radical hx')) (Ideal.mul_mem_right _ _ u)
    have hbij : Function.Bijective (Ideal.quotientMap (I₀.map ι).radical ι hle) := ⟨hinj, hsurj⟩
    refine ⟨RingEquiv.ofBijective _ hbij, fun x => ?_⟩
    show Ideal.quotientMap (I₀.map ι).radical ι hle (Ideal.Quotient.mk I₀.radical x) = _
    rw [Ideal.quotientMap_mk]

  have hb0A : algebraMap ↥W A b₀ ≠ 0 := by
    haveI : NoZeroSMulDivisors ↥W A := hPD.2.1
    intro h
    rw [Algebra.algebraMap_eq_smul_one] at h
    rcases smul_eq_zero.mp h with h | h
    · exact hb₀0 h
    · exact one_ne_zero h
  have hb0K : algebraMap A K (algebraMap ↥W A b₀) ≠ 0 := by
    intro h
    exact hb0A ((IsFractionRing.injective A K) (h.trans (map_zero _).symm))
  have hBr1 := hBr.1

  have hR0CR : ∀ k : K, k ∈ wcVdR0 W A K t c₀ b₀ e' → k ∈ wcLlsIsiCR W A' K u' b₀ := by
    intro k hk
    induction hk using Algebra.adjoin_induction with
    | mem x hx =>
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl
      · have h1 : wcLlsIsiS1 W A' K u' b₀ ∈ wcLlsIsiCR W A' K u' b₀ :=
          Algebra.subset_adjoin (Set.mem_insert _ _)
        have h2 : algebraMap A' K (algebraMap ↥W A' e') ∈ wcLlsIsiCR W A' K u' b₀ :=
          Subalgebra.algebraMap_mem _ _
        have heq : wcLlsScS W A K t c₀ b₀ =
            wcLlsIsiS1 W A' K u' b₀ + algebraMap A' K (algebraMap ↥W A' e') := by
          simp only [wcLlsScS, wcLlsIsiS1, hu', hBr1]
          rw [div_add' _ _ _ hb0K]
          congr 1
          simp only [map_sub, map_add, map_mul]
          ring
        rw [heq]; exact add_mem h1 h2
      · have heq : wcLlsScV W A K t (c₀ + b₀ * e') b₀ = wcLlsIsiS2 W A' K u' b₀ := by
          simp only [wcLlsScV, wcLlsIsiS2, hu', hBr1]
        rw [heq]
        exact Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
    | algebraMap a =>
      obtain ⟨a', ha'⟩ := hBr.2.1 (Subalgebra.algebraMap_mem (Algebra.adjoin A
        {algebraMap A K (algebraMap ↥W A b'') /
          algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e'))}) a)
      rw [← ha']
      exact Subalgebra.algebraMap_mem _ _
    | add x y _ _ hx hy => exact add_mem hx hy
    | mul x y _ _ hx hy => exact mul_mem hx hy

  let φR : ↥(wcVdR0 W A K t c₀ b₀ e') →+* ↥(wcLlsIsiCR W A' K u' b₀) :=
    { toFun := fun x => ⟨x.1, hR0CR x.1 x.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hcomp : (algebraMap ↥(wcLlsIsiCR W A' K u' b₀) L).comp φR =
      (RingHom.id L).comp (algebraMap ↥(wcVdR0 W A K t c₀ b₀ e') L) := by
    ext x; rfl
  let ι : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) →+*
      ↥(integralClosure ↥(wcLlsIsiCR W A' K u' b₀) L) :=
    { toFun := fun x => ⟨x.1,
        IsIntegral.map_of_comp_eq φR (RingHom.id L) hcomp (show IsIntegral _ x.1 from x.2)⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hιinj : Function.Injective ι := by
    intro x y h
    apply Subtype.ext
    have h' := congrArg Subtype.val h
    exact h'
  have hcst0 : ∀ w : ↥W, IsIntegral ↥(wcVdR0 W A K t c₀ b₀ e')
      (algebraMap K L (algebraMap A K (algebraMap ↥W A w))) := by
    intro w
    have hmem : algebraMap A K (algebraMap ↥W A w) ∈ wcVdR0 W A K t c₀ b₀ e' :=
      Subalgebra.algebraMap_mem _ _
    exact (isIntegral_algebraMap :
      IsIntegral _ (algebraMap ↥(wcVdR0 W A K t c₀ b₀ e') L ⟨_, hmem⟩))
  have hcst : ∀ w : ↥W, algebraMap K L (algebraMap A K (algebraMap ↥W A w)) ∈
      integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L := hcst0

  have hmap : Ideal.map ι (Ideal.span {c : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (c : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w))}) =
      Ideal.span {c : ↥(integralClosure ↥(wcLlsIsiCR W A' K u' b₀) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (c : L) = algebraMap K L (algebraMap A' K (algebraMap ↥W A' w))} := by
    rw [Ideal.map_span]
    congr 1
    ext c
    simp only [Set.mem_image, Set.mem_setOf_eq]
    constructor
    · rintro ⟨d, ⟨w, hw, hd⟩, rfl⟩
      exact ⟨w, hw, by rw [hBr1]; exact hd⟩
    · rintro ⟨w, hw, hc⟩
      refine ⟨⟨algebraMap K L (algebraMap A K (algebraMap ↥W A w)), hcst w⟩, ⟨w, hw, rfl⟩, ?_⟩
      apply Subtype.ext
      show algebraMap K L (algebraMap A K (algebraMap ↥W A w)) = (c : L)
      rw [hc, hBr1]

  have hU := wcLlsVd_ct_unit_mod Ω W A K L 𝔭 t c₀ b₀ e' b'' hPD hc₀ hb₀ hb0K hdiv hnd
  have hgood : ∀ y : ↥(integralClosure ↥(wcLlsIsiCR W A' K u' b₀) L),
      ∃ q g x : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L),
        ι q * y = ι x ∧ q * g - 1 ∈ wcVdJ0 W A K L t c₀ b₀ e' := by
    intro y
    obtain ⟨q, g, x, hqx, hqg⟩ :=
      wcLlsVd_ct_good_denom Ω W A K L t c₀ b₀ e' b'' hb0K hdiv A' u' hBr hu' hU y
    exact ⟨q, g, x, Subtype.ext hqx, hqg⟩
  obtain ⟨θ, hθ⟩ := s1 _ _ ι hιinj
    (Ideal.span {c : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (c : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w))}) hgood
  let Θ := θ.trans (Ideal.quotEquivOfEq (congrArg Ideal.radical hmap))
  have hΘ : ∀ x, Θ (Ideal.Quotient.mk (wcVdJ0 W A K L t c₀ b₀ e') x) =
      Ideal.Quotient.mk (Ideal.span {c : ↥(integralClosure ↥(wcLlsIsiCR W A' K u' b₀) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (c : L) = algebraMap K L (algebraMap A' K (algebraMap ↥W A' w))}).radical (ι x) := by
    intro x
    show (Ideal.quotEquivOfEq (congrArg Ideal.radical hmap)) (θ _) = _
    rw [hθ, Ideal.quotEquivOfEq_mk]
  obtain ⟨n, φ₀, hφ₀⟩ := hφ
  unfold wcLlsIsiCirc
  refine ⟨n, Θ.symm.trans φ₀, ?_⟩
  intro w c hc i
  have hc' : ι ⟨algebraMap K L (algebraMap A K (algebraMap ↥W A w)), hcst w⟩ = c := by
    apply Subtype.ext
    show algebraMap K L (algebraMap A K (algebraMap ↥W A w)) = (c : L)
    rw [hc, hBr1]
  have key : Θ.symm (Ideal.Quotient.mk (Ideal.span {c : ↥(integralClosure ↥(wcLlsIsiCR W A' K u' b₀) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (c : L) = algebraMap K L (algebraMap A' K (algebraMap ↥W A' w))}).radical c) =
      Ideal.Quotient.mk (wcVdJ0 W A K L t c₀ b₀ e')
        ⟨algebraMap K L (algebraMap A K (algebraMap ↥W A w)), hcst w⟩ := by
    rw [RingEquiv.symm_apply_eq, hΘ, hc']
  have hfin := hφ₀ w ⟨algebraMap K L (algebraMap A K (algebraMap ↥W A w)), hcst w⟩ rfl i
  exact (congrArg (fun z => φ₀ z i) key).trans hfin

theorem wcLlsVd_reduced_split : ∀ (D : Type u) [CommRing D] [IsReduced D] [IsNoetherianRing D],
    (∀ (𝔐 : Ideal D) [𝔐.IsMaximal],
      IsDomain (Localization.AtPrime 𝔐) ∧ IsIntegrallyClosed (Localization.AtPrime 𝔐)) →
    ∃ (n : ℕ) (P : Fin n → Ideal D), (∀ i, P i ∈ minimalPrimes D) ∧
      (∃ e : D ≃+* (∀ i, D ⧸ P i), ∀ x i, e x i = Ideal.Quotient.mk (P i) x) ∧
      ∀ i, IsDomain (D ⧸ P i) ∧ IsIntegrallyClosed (D ⧸ P i) :=
by
  intro D _ _ _ h
  classical
  have hmin : ∀ P ∈ minimalPrimes D, Minimal (fun q : Ideal D => q.IsPrime ∧ ⊥ ≤ q) P :=
    fun P hP => hP

  have hker : ∀ (𝔐 : Ideal D) [𝔐.IsMaximal], ∀ P ∈ minimalPrimes D, P ≤ 𝔐 →
      RingHom.ker (algebraMap D (Localization.AtPrime 𝔐)) = P := by
    intro 𝔐 _ P hP hPM
    haveI := (h 𝔐).1
    have hP' := hmin P hP
    have hPp : P.IsPrime := hP'.1.1
    have hKP : RingHom.ker (algebraMap D (Localization.AtPrime 𝔐)) ≤ P := by
      intro x hx
      rw [RingHom.mem_ker] at hx
      obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff 𝔐.primeCompl _ x).mp hx
      have hmP : (m : D) ∉ P := fun h' => m.2 (hPM h')
      have : (m : D) * x ∈ P := by rw [hm]; exact P.zero_mem
      exact (hPp.mem_or_mem this).resolve_left hmP
    exact hP'.eq_of_le ⟨RingHom.ker_isPrime _, bot_le⟩ hKP

  have hcomax : ∀ P ∈ minimalPrimes D, ∀ Q ∈ minimalPrimes D, P ≠ Q → P ⊔ Q = ⊤ := by
    intro P hP Q hQ hne
    by_contra hPQ
    obtain ⟨𝔐, h𝔐, hle⟩ := Ideal.exists_le_maximal (P ⊔ Q) hPQ
    exact hne ((hker 𝔐 P hP (le_sup_left.trans hle)).symm.trans
      (hker 𝔐 Q hQ (le_sup_right.trans hle)))

  have hnorm : ∀ P ∈ minimalPrimes D, IsIntegrallyClosed (D ⧸ P) := by
    intro P hP
    haveI : P.IsPrime := (hmin P hP).1.1
    apply IsIntegrallyClosed.of_localization_maximal
    intro 𝔭 _ h𝔭
    haveI h𝔐 : (𝔭.comap (Ideal.Quotient.mk P)).IsMaximal :=
      Ideal.comap_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective
    have hPM : P ≤ 𝔭.comap (Ideal.Quotient.mk P) := by
      intro a ha
      rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr ha]
      exact 𝔭.zero_mem
    haveI := (h (𝔭.comap (Ideal.Quotient.mk P))).1
    haveI := (h (𝔭.comap (Ideal.Quotient.mk P))).2
    have hk := hker (𝔭.comap (Ideal.Quotient.mk P)) P hP hPM
    have hinjT : Function.Injective (algebraMap (D ⧸ P) (Localization.AtPrime 𝔭)) :=
      IsLocalization.injective (Localization.AtPrime 𝔭) (Ideal.primeCompl_le_nonZeroDivisors 𝔭)
    have hloc : IsLocalization (𝔭.comap (Ideal.Quotient.mk P)).primeCompl
        (Localization.AtPrime 𝔭) := by
      rw [isLocalization_iff]
      refine ⟨?_, ?_, ?_⟩
      · rintro ⟨y, hy⟩
        rw [IsScalarTower.algebraMap_apply D (D ⧸ P) (Localization.AtPrime 𝔭),
          Ideal.Quotient.algebraMap_eq]
        exact IsLocalization.map_units (Localization.AtPrime 𝔭)
          (⟨Ideal.Quotient.mk P y, hy⟩ : 𝔭.primeCompl)
      · intro z
        obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.surj 𝔭.primeCompl z
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective r
        obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (s : D ⧸ P)
        have hbM : b ∈ (𝔭.comap (Ideal.Quotient.mk P)).primeCompl := by
          show Ideal.Quotient.mk P b ∉ 𝔭
          rw [hb]; exact s.2
        refine ⟨(a, ⟨b, hbM⟩), ?_⟩
        simp only
        rw [IsScalarTower.algebraMap_apply D (D ⧸ P) (Localization.AtPrime 𝔭),
          IsScalarTower.algebraMap_apply D (D ⧸ P) (Localization.AtPrime 𝔭),
          Ideal.Quotient.algebraMap_eq, hb]
        exact hrs
      · intro x y hxy
        rw [IsScalarTower.algebraMap_apply D (D ⧸ P) (Localization.AtPrime 𝔭),
          IsScalarTower.algebraMap_apply D (D ⧸ P) (Localization.AtPrime 𝔭)] at hxy
        have h1 := hinjT hxy
        rw [Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq, ← hk, RingHom.mem_ker,
          map_sub, sub_eq_zero] at h1
        exact (IsLocalization.eq_iff_exists _ _).mp h1
    haveI := hloc
    exact IsIntegrallyClosed.of_equiv
      (IsLocalization.algEquiv (𝔭.comap (Ideal.Quotient.mk P)).primeCompl
        (Localization.AtPrime (𝔭.comap (Ideal.Quotient.mk P)))
        (Localization.AtPrime 𝔭)).toRingEquiv

  obtain ⟨n, P, hPinj, hPrange⟩ := (minimalPrimes.finite_of_isNoetherianRing D).fin_param
  have hPmem : ∀ i, P i ∈ minimalPrimes D := fun i => hPrange ▸ ⟨i, rfl⟩
  have hinf : (⨅ i, P i) = ⊥ := by
    rw [← sInf_range, hPrange]
    show sInf (⊥ : Ideal D).minimalPrimes = ⊥
    rw [Ideal.sInf_minimalPrimes, Ideal.radical_bot_of_isReduced]
  have hcop : Pairwise (fun i j => IsCoprime (P i) (P j)) := by
    intro i j hij
    rw [Ideal.isCoprime_iff_sup_eq]
    exact hcomax _ (hPmem i) _ (hPmem j) (fun h => hij (hPinj h))

  let φ : D →+* (∀ i, D ⧸ P i) := RingHom.pi (fun i => Ideal.Quotient.mk (P i))
  have hinj : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    have hx' : x ∈ ⨅ i, P i := by
      rw [Ideal.mem_iInf]
      intro i
      exact Ideal.Quotient.eq_zero_iff_mem.mp (congrFun hx i)
    rw [hinf] at hx'
    exact hx'
  have hsurj : Function.Surjective φ := by
    intro y
    obtain ⟨r, hr⟩ := Ideal.pi_quotient_surjective hcop y
    exact ⟨r, funext hr⟩
  refine ⟨n, P, hPmem, ⟨RingEquiv.ofBijective φ ⟨hinj, hsurj⟩, fun x i => rfl⟩, fun i => ?_⟩
  haveI : (P i).IsPrime := (hmin _ (hPmem i)).1.1
  exact ⟨inferInstance, hnorm _ (hPmem i)⟩

theorem wcLlsVd_insep_laurent : ∀ (k : Type u) [Field k] [IsAlgClosed k] (ℓ : ℕ), ℓ.Prime →
    ((ℓ : ℕ) : k) = 0 →
    ∀ (E : Type u) [CommRing E] [IsDomain E] [IsIntegrallyClosed E]
      (χ : LaurentPolynomial k →+* E), Function.Injective χ →
    (letI := χ.toAlgebra; Module.Finite (LaurentPolynomial k) E) →
    (∀ x : E, ∃ (n : ℕ) (p q : LaurentPolynomial k), q ≠ 0 ∧ χ q * x ^ (ℓ ^ n) = χ p) →
    ∃ ψ : E ≃+* LaurentPolynomial k, ∀ a : k, ψ (χ (LaurentPolynomial.C a)) = LaurentPolynomial.C a :=
by

  have wcIL_integral_descent : ∀ (A B : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [CommRing B] [IsDomain B] (f : A →+* B), Function.Injective f → ∀ (y : B) (P : Polynomial A), P.Monic → P.eval₂ f y = 0 → ∀ (a c : A), c ≠ 0 → f c * y = f a → ∃ z : A, f z = y := by
    intro A B _ _ _ _ _ f hf y P hP hPy a c hc hac
    have h1 : Polynomial.eval a (P.scaleRoots c) = 0 := by
      apply hf
      rw [← Polynomial.eval₂_at_apply, ← hac, Polynomial.scaleRoots_eval₂_mul, hPy, mul_zero, map_zero]
    have hcK : algebraMap A (FractionRing A) c ≠ 0 := by
      intro h
      exact hc (IsFractionRing.injective A (FractionRing A) (h.trans (map_zero _).symm))
    have e : algebraMap A (FractionRing A) c * (algebraMap A (FractionRing A) a / algebraMap A (FractionRing A) c) = algebraMap A (FractionRing A) a := by
      field_simp
    have h2 : Polynomial.eval₂ (algebraMap A (FractionRing A)) (algebraMap A (FractionRing A) a / algebraMap A (FractionRing A) c) P = 0 := by
      have := Polynomial.scaleRoots_eval₂_mul (p := P) (algebraMap A (FractionRing A)) (algebraMap A (FractionRing A) a / algebraMap A (FractionRing A) c) c
      rw [e, Polynomial.eval₂_at_apply, h1, map_zero] at this
      exact (mul_eq_zero.mp this.symm).resolve_left (pow_ne_zero _ hcK)
    have hint : IsIntegral A (algebraMap A (FractionRing A) a / algebraMap A (FractionRing A) c) := ⟨P, hP, h2⟩
    obtain ⟨z, hz⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    refine ⟨z, ?_⟩
    have h3 : c * z = a := IsFractionRing.injective A (FractionRing A) (by rw [map_mul, hz, e])
    have hfc : f c ≠ 0 := fun h => hc (hf (h.trans (map_zero f).symm))
    apply mul_left_cancel₀ hfc
    rw [← map_mul, h3, hac]

  have wcIL_range_relclosed : ∀ (B E : Type u) [CommRing B] [IsDomain B] [CommRing E] [IsDomain E] [IsIntegrallyClosed E] (φ : E →+* B), Function.Injective φ → ∀ n : ℕ, 0 < n → (∀ z : B, z ^ n ∈ φ.range) → ∀ z c : B, c ∈ φ.range → c ≠ 0 → c * z ∈ φ.range → z ∈ φ.range := by
    intro B E _ _ _ _ _ φ hφ n hn hpow z c hc hc0 hcz
    obtain ⟨e1, rfl⟩ := hc
    obtain ⟨e2, he2⟩ := hcz
    obtain ⟨e3, he3⟩ := hpow z
    have h1 : e2 ^ n = e1 ^ n * e3 := hφ (by rw [map_pow, map_mul, map_pow, he2, he3, mul_pow])
    have h2 : e1 ∣ e2 := (IsIntegrallyClosed.pow_dvd_pow_iff hn.ne').mp ⟨e3, h1⟩
    obtain ⟨e, rfl⟩ := h2
    refine ⟨e, ?_⟩
    rw [map_mul] at he2
    exact mul_left_cancel₀ hc0 he2

  have wcIL_dilate_basics : ∀ (k : Type u) [Field k], (∀ a b : ℕ, ((AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((a : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k).comp (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((b : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k)) = (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((a * b : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k)) ∧ (∀ f : LaurentPolynomial k, (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((1 : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k) f = f) ∧ (∀ d : ℕ, d ≠ 0 → Function.Injective (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((d : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k)) ∧ (∀ (d : ℕ) (c : k), (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((d : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k) (LaurentPolynomial.C c) = LaurentPolynomial.C c) ∧ (∀ (d : ℕ) (m : ℤ), (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((d : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k) (LaurentPolynomial.T m) = LaurentPolynomial.T (((d : ℕ) : ℤ) * m)) ∧ (∀ (d : ℕ) (f : LaurentPolynomial k), d ≠ 0 → (f ∈ (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((d : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k).range ↔ ∀ n : ℤ, f.coeff n ≠ 0 → ((d : ℕ) : ℤ) ∣ n)) ∧ (∀ (g : k →+* k), Function.Injective g → ∀ (d : ℕ) (f : LaurentPolynomial k), d ≠ 0 → ((AddMonoidAlgebra.mapRingHom ℤ g f : LaurentPolynomial k) ∈ (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((d : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k).range ↔ f ∈ (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((d : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k).range)) := by
    intro k _
    have hsingle : ∀ (d : ℕ) (m : ℤ) (r : k), (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((d : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k) (AddMonoidAlgebra.single m r) = AddMonoidAlgebra.single ((d : ℤ) * m) r := by
      intro d m r
      rw [AddMonoidAlgebra.mapDomainRingHom_apply, AddMonoidAlgebra.mapDomain_single]
      rfl
    have hrange : ∀ (d : ℕ) (f : LaurentPolynomial k), d ≠ 0 → (f ∈ (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((d : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k).range ↔ ∀ n : ℤ, f.coeff n ≠ 0 → ((d : ℕ) : ℤ) ∣ n) := by
      intro d f hd
      have hinj : Function.Injective (fun m : ℤ => (d : ℤ) * m) :=
        mul_right_injective₀ (by exact_mod_cast hd)
      constructor
      · rintro ⟨g, rfl⟩ n hn
        by_contra hnd
        apply hn
        rw [AddMonoidAlgebra.mapDomainRingHom_apply, AddMonoidAlgebra.coeff_mapDomain]
        apply Finsupp.mapDomain_notin_range
        rintro ⟨m, hm⟩
        exact hnd ⟨m, hm.symm⟩
      · intro h
        have hmem : f.coeff ∈ Set.range (Finsupp.mapDomain (fun m : ℤ => (d : ℤ) * m) : (ℤ →₀ k) → (ℤ →₀ k)) := by
          rw [Finsupp.mem_range_mapDomain_iff _ hinj]
          intro b hb
          by_contra hne
          obtain ⟨m, hm⟩ := h b hne
          exact hb ⟨m, hm.symm⟩
        obtain ⟨g', hg'⟩ := hmem
        refine ⟨AddMonoidAlgebra.ofCoeff g', ?_⟩
        apply AddMonoidAlgebra.ext
        rw [AddMonoidAlgebra.mapDomainRingHom_apply, AddMonoidAlgebra.coeff_mapDomain,
          AddMonoidAlgebra.coeff_ofCoeff]
        exact hg'
    refine ⟨?_, ?_, ?_, ?_, ?_, hrange, ?_⟩
    · intro a b
      rw [← AddMonoidAlgebra.mapDomainRingHom_comp]
      congr 1
      ext
      simp
    · intro f
      have : AddMonoidHom.mulLeft ((1 : ℕ) : ℤ) = AddMonoidHom.id ℤ := by
        ext; simp
      rw [this, AddMonoidAlgebra.mapDomainRingHom_id]
      rfl
    · intro d hd x y h
      rw [AddMonoidAlgebra.mapDomainRingHom_apply, AddMonoidAlgebra.mapDomainRingHom_apply] at h
      exact AddMonoidAlgebra.mapDomain_injective (mul_right_injective₀ (by exact_mod_cast hd : ((d : ℕ) : ℤ) ≠ 0)) h
    · intro d c
      have hC : LaurentPolynomial.C c = AddMonoidAlgebra.single (0 : ℤ) c := by
        rw [LaurentPolynomial.single_eq_C_mul_T, LaurentPolynomial.T_zero, mul_one]
      rw [hC, hsingle, mul_zero]
    · intro d m
      exact hsingle d m 1
    · intro g hg d f hd
      rw [hrange d _ hd, hrange d _ hd]
      refine forall_congr' (fun n => ?_)
      rw [AddMonoidAlgebra.coeff_mapRingHom, map_ne_zero_iff g hg]

  have wcIL_frob_pow : ∀ (k : Type u) [Field k] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] [CharP k ℓ] (n : ℕ) (f : LaurentPolynomial k), f ^ (ℓ ^ n) = (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ n : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k) (AddMonoidAlgebra.mapRingHom ℤ (iterateFrobenius k ℓ n) f) := by
    intro k _ ℓ _ _ n f
    haveI : CharP (LaurentPolynomial k) ℓ :=
      charP_of_injective_algebraMap (R := k) (A := LaurentPolynomial k) (fun a b h => by
        have := congrArg (fun f : LaurentPolynomial k => f.coeff 0) h
        simpa using this) ℓ
    have key : iterateFrobenius (LaurentPolynomial k) ℓ n = (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ n : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k).comp (AddMonoidAlgebra.mapRingHom ℤ (iterateFrobenius k ℓ n)) := by
      apply AddMonoidAlgebra.ringHom_ext
      · intro r
        rw [RingHom.comp_apply, AddMonoidAlgebra.mapRingHom_single, AddMonoidAlgebra.mapDomainRingHom_apply,
          AddMonoidAlgebra.mapDomain_single, iterateFrobenius_def, iterateFrobenius_def,
          AddMonoidAlgebra.single_pow]
        simp
      · intro m
        rw [RingHom.comp_apply, AddMonoidAlgebra.mapRingHom_single, AddMonoidAlgebra.mapDomainRingHom_apply,
          AddMonoidAlgebra.mapDomain_single, iterateFrobenius_def, iterateFrobenius_def,
          AddMonoidAlgebra.single_pow]
        simp
    rw [← iterateFrobenius_def, key]
    rfl

  have wcIL_frob_section : ∀ (k : Type u) [Field k] [IsAlgClosed k] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] [CharP k ℓ] (E : Type u) [CommRing E] [IsDomain E] (χ : LaurentPolynomial k →+* E), Function.Injective χ → ∀ N : ℕ, (∀ f : LaurentPolynomial k, f ^ (ℓ ^ N) = (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ N : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k) (AddMonoidAlgebra.mapRingHom ℤ (iterateFrobenius k ℓ N) f)) → (∀ x : E, ∃ c : LaurentPolynomial k, χ c = x ^ (ℓ ^ N)) → ∃ φ : E →+* LaurentPolynomial k, Function.Injective φ ∧ ∀ f : LaurentPolynomial k, φ (χ f) = (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ N : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k) f := by
    intro k _ _ ℓ _ _ E _ _ χ hχ N hFr hdesc
    have hCE : CharP E ℓ := by
      have h : ((ℓ : ℕ) : E) = 0 := by
        rw [← map_natCast χ, ← map_natCast (LaurentPolynomial.C : k →+* LaurentPolynomial k),
          CharP.cast_eq_zero, map_zero, map_zero]
      exact (CharP.charP_iff_prime_eq_zero (Fact.out)).mpr h
    haveI := hCE
    haveI : PerfectRing k ℓ := IsAlgClosed.perfectRing k ℓ
    have hrange : ∀ x, iterateFrobenius E ℓ N x ∈ χ.range := fun x => by
      obtain ⟨c, hc⟩ := hdesc x
      exact ⟨c, by rw [hc, iterateFrobenius_def]⟩
    let ρ : LaurentPolynomial k ≃+* χ.range := RingEquiv.ofBijective χ.rangeRestrict
      ⟨fun x y h => hχ (congrArg Subtype.val h), χ.rangeRestrict_surjective⟩
    let φ₀ : E →+* LaurentPolynomial k :=
      (ρ.symm : χ.range →+* LaurentPolynomial k).comp ((iterateFrobenius E ℓ N).codRestrict χ.range hrange)
    have hφ₀ : ∀ x, χ (φ₀ x) = x ^ ℓ ^ N := by
      intro x
      have h1 : ρ (φ₀ x) = (iterateFrobenius E ℓ N).codRestrict χ.range hrange x :=
        RingEquiv.apply_symm_apply ρ _
      have h2 : χ (φ₀ x) = iterateFrobenius E ℓ N x := congrArg Subtype.val h1
      rw [h2, iterateFrobenius_def]
    let σ := iterateFrobeniusEquiv k ℓ N
    let μ : LaurentPolynomial k →+* LaurentPolynomial k := AddMonoidAlgebra.mapRingHom ℤ (σ.symm : k →+* k)
    have hμ : Function.Injective μ := by
      intro f g h
      apply LaurentPolynomial.ext
      intro n
      have h3 := congrArg (fun p : LaurentPolynomial k => p.coeff n) h
      simp only [μ, AddMonoidAlgebra.coeff_mapRingHom] at h3
      exact σ.symm.injective h3
    have hcomm : ∀ g : LaurentPolynomial k, μ ((AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ N : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k) g) = (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ N : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k) (μ g) := by
      intro g
      have : μ.comp (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ N : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k) = (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ N : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k).comp μ := by
        apply AddMonoidAlgebra.ringHom_ext
        · intro r
          simp only [μ, RingHom.comp_apply, AddMonoidAlgebra.mapDomainRingHom_apply,
            AddMonoidAlgebra.mapDomain_single, AddMonoidAlgebra.mapRingHom_single]
        · intro m
          simp only [μ, RingHom.comp_apply, AddMonoidAlgebra.mapDomainRingHom_apply,
            AddMonoidAlgebra.mapDomain_single, AddMonoidAlgebra.mapRingHom_single]
      exact congrArg (fun F => F g) this
    have hinv : ∀ g : LaurentPolynomial k, μ (AddMonoidAlgebra.mapRingHom ℤ (iterateFrobenius k ℓ N) g) = g := by
      intro g
      apply LaurentPolynomial.ext
      intro n
      rw [AddMonoidAlgebra.coeff_mapRingHom, AddMonoidAlgebra.coeff_mapRingHom]
      show σ.symm (iterateFrobenius k ℓ N (g.coeff n)) = g.coeff n
      rw [← iterateFrobeniusEquiv_apply k ℓ N]
      exact σ.symm_apply_apply _
    refine ⟨μ.comp φ₀, ?_, ?_⟩
    · rw [injective_iff_map_eq_zero]
      intro x hx
      have h4 : φ₀ x = 0 := hμ (hx.trans (map_zero μ).symm)
      have h5 : x ^ ℓ ^ N = 0 := by rw [← hφ₀, h4, map_zero]
      exact pow_eq_zero_iff (pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero) |>.mp h5
    · intro f
      have h6 : φ₀ (χ f) = f ^ ℓ ^ N := hχ (by rw [hφ₀, map_pow])
      rw [RingHom.comp_apply, h6, hFr f, hcomm, hinv]

  have wcIL_residue_decomp : ∀ (k : Type u) [Field k] (ℓ : ℕ), 0 < ℓ → ∀ f : LaurentPolynomial k, ∃ g : Fin ℓ → LaurentPolynomial k, f = ∑ r : Fin ℓ, (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((ℓ : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k) (g r) * LaurentPolynomial.T ((r : ℕ) : ℤ) := by
    intro k _ ℓ hℓ f
    have hsingle : ∀ (m : ℤ) (r : k), (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((ℓ : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k) (AddMonoidAlgebra.single m r) = AddMonoidAlgebra.single ((ℓ : ℤ) * m) r := by
      intro m r
      rw [AddMonoidAlgebra.mapDomainRingHom_apply, AddMonoidAlgebra.mapDomain_single]
      rfl
    refine LaurentPolynomial.induction_on' f ?_ ?_
    · intro p q hp hq
      obtain ⟨g1, hg1⟩ := hp
      obtain ⟨g2, hg2⟩ := hq
      refine ⟨g1 + g2, ?_⟩
      rw [hg1, hg2]
      simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
    · intro n a
      have hℓz : (0 : ℤ) < (ℓ : ℤ) := by exact_mod_cast hℓ
      have h0 : 0 ≤ n % (ℓ : ℤ) := Int.emod_nonneg _ hℓz.ne'
      have h1 : n % (ℓ : ℤ) < ℓ := Int.emod_lt_of_pos _ hℓz
      have hn : (ℓ : ℤ) * (n / (ℓ : ℤ)) + n % (ℓ : ℤ) = n := Int.mul_ediv_add_emod n ℓ
      let i : Fin ℓ := ⟨(n % (ℓ : ℤ)).toNat, by omega⟩
      refine ⟨fun r => if r = i then LaurentPolynomial.C a * LaurentPolynomial.T (n / (ℓ : ℤ)) else 0, ?_⟩
      rw [Finset.sum_eq_single i]
      · dsimp only
        have e : (ℓ : ℤ) * (n / (ℓ : ℤ)) + (((i : Fin ℓ) : ℕ) : ℤ) = n := by
          show (ℓ : ℤ) * (n / (ℓ : ℤ)) + (((n % (ℓ : ℤ)).toNat : ℕ) : ℤ) = n
          rw [Int.toNat_of_nonneg h0]
          exact hn
        rw [if_pos rfl, show LaurentPolynomial.C a * LaurentPolynomial.T (n / (ℓ : ℤ)) =
            AddMonoidAlgebra.single (n / (ℓ : ℤ)) a from (LaurentPolynomial.single_eq_C_mul_T _ _).symm,
          hsingle, LaurentPolynomial.single_eq_C_mul_T, mul_assoc, ← LaurentPolynomial.T_add, e]
      · intro b _ hb
        dsimp only
        rw [if_neg hb, map_zero, zero_mul]
      · intro h
        exact absurd (Finset.mem_univ i) h

  have wcIL_theta_derivation : ∀ (k : Type u) [Field k], ∃ D : LaurentPolynomial k →+ LaurentPolynomial k, (∀ f g : LaurentPolynomial k, D (f * g) = f * D g + g * D f) ∧ ∀ (f : LaurentPolynomial k) (n : ℤ), (D f).coeff n = (n : k) * f.coeff n := by
    intro k _
    let D0 : LaurentPolynomial k → LaurentPolynomial k := fun f =>
      AddMonoidAlgebra.ofCoeff (Finsupp.onFinset f.coeff.support (fun n => (n : k) * f.coeff n)
        (by intro n hn; rw [Finsupp.mem_support_iff]; exact right_ne_zero_of_mul hn))
    have hD0 : ∀ f n, (D0 f).coeff n = (n : k) * f.coeff n := by
      intro f n
      simp only [D0, Finsupp.onFinset_apply]
    let D : LaurentPolynomial k →+ LaurentPolynomial k :=
      { toFun := D0
        map_zero' := by
          apply LaurentPolynomial.ext
          intro n
          rw [hD0]
          simp
        map_add' := by
          intro f g
          apply LaurentPolynomial.ext
          intro n
          rw [hD0]
          simp [hD0, mul_add] }
    have hDc : ∀ f n, (D f).coeff n = (n : k) * f.coeff n := hD0
    have hmono : ∀ (n : ℤ) (a : k), D (AddMonoidAlgebra.single n a) = AddMonoidAlgebra.single n ((n : k) * a) := by
      intro n a
      apply LaurentPolynomial.ext
      intro m
      rw [hDc, AddMonoidAlgebra.coeff_single, AddMonoidAlgebra.coeff_single, Finsupp.single_apply,
        Finsupp.single_apply]
      split_ifs with h
      · rw [h]
      · rw [mul_zero]
    refine ⟨D, fun f g => ?_, hDc⟩
    refine LaurentPolynomial.induction_on' f ?_ ?_
    · intro p q hp hq
      rw [add_mul, map_add, hp, hq, map_add]
      ring
    · intro n a
      refine LaurentPolynomial.induction_on' g ?_ ?_
      · intro p q hp hq
        rw [mul_add, map_add, hp, hq, map_add]
        ring
      · intro m b
        rw [← LaurentPolynomial.single_eq_C_mul_T, ← LaurentPolynomial.single_eq_C_mul_T,
          AddMonoidAlgebra.single_mul_single, hmono, hmono, hmono, AddMonoidAlgebra.single_mul_single,
          AddMonoidAlgebra.single_mul_single, add_comm m n, ← AddMonoidAlgebra.single_add]
        congr 1
        push_cast
        ring

  have wcIL_full_of_not_dvd : ∀ (k : Type u) [Field k] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] [CharP k ℓ],
      ((∀ a b : ℕ, ((AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((a : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k).comp (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((b : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k)) = (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((a * b : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k)) ∧ (∀ f : LaurentPolynomial k, (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((1 : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k) f = f) ∧ (∀ d : ℕ, d ≠ 0 → Function.Injective (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((d : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k)) ∧ (∀ (d : ℕ) (c : k), (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((d : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k) (LaurentPolynomial.C c) = LaurentPolynomial.C c) ∧ (∀ (d : ℕ) (m : ℤ), (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((d : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k) (LaurentPolynomial.T m) = LaurentPolynomial.T (((d : ℕ) : ℤ) * m)) ∧ (∀ (d : ℕ) (f : LaurentPolynomial k), d ≠ 0 → (f ∈ (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((d : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k).range ↔ ∀ n : ℤ, f.coeff n ≠ 0 → ((d : ℕ) : ℤ) ∣ n)) ∧ (∀ (g : k →+* k), Function.Injective g → ∀ (d : ℕ) (f : LaurentPolynomial k), d ≠ 0 → ((AddMonoidAlgebra.mapRingHom ℤ g f : LaurentPolynomial k) ∈ (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((d : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k).range ↔ f ∈ (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((d : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k).range))) →
      (∀ (n : ℕ) (f : LaurentPolynomial k), f ^ (ℓ ^ n) = (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ n : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k) (AddMonoidAlgebra.mapRingHom ℤ (iterateFrobenius k ℓ n) f)) →
      (∀ S' : Subring (LaurentPolynomial k), (∀ f : LaurentPolynomial k, (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((ℓ : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k) f ∈ S') → (∀ z c : LaurentPolynomial k, c ∈ S' → c ≠ 0 → c * z ∈ S' → z ∈ S') → ∀ s ∈ S', s ∉ (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((ℓ : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k).range → ∀ z : LaurentPolynomial k, z ∈ S') →
      ∀ (M : ℕ) (S : Subring (LaurentPolynomial k)), (∀ f : LaurentPolynomial k, (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ M : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k) f ∈ S) → (∀ z c : LaurentPolynomial k, c ∈ S → c ≠ 0 → c * z ∈ S → z ∈ S) → ∀ s ∈ S, s ∉ (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((ℓ : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k).range → ∀ z : LaurentPolynomial k, z ∈ S := by
    intro k _ ℓ _ _ hD hFr h1 M
    obtain ⟨hD1, hD2, hD3, -, -, -, hD7⟩ := hD
    have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
    induction M with
    | zero =>
      intro S hS _ _ _ _ z
      have := hS z
      rwa [pow_zero, hD2] at this
    | succ M ih =>
      intro S hS hrel s hs hsA z
      let S₁ := S.comap (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((ℓ : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k)
      have hS₁A : ∀ f : LaurentPolynomial k, (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ M : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k) f ∈ S₁ := by
        intro f
        show (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((ℓ : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k) ((AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ M : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k) f) ∈ S
        have e := congrArg (fun φ => φ f) (hD1 ℓ (ℓ ^ M))
        simp only [RingHom.comp_apply] at e
        rw [e, ← pow_succ']
        exact hS f
      have hS₁rel : ∀ z c : LaurentPolynomial k, c ∈ S₁ → c ≠ 0 → c * z ∈ S₁ → z ∈ S₁ := by
        intro z c hc hc0 hcz
        exact hrel _ _ hc (fun h => hc0 (hD3 ℓ hℓ0 (h.trans (map_zero _).symm)))
          (by rw [← map_mul]; exact hcz)
      have hs₁ : AddMonoidAlgebra.mapRingHom ℤ (iterateFrobenius k ℓ 1) s ∈ S₁ := by
        have e := hFr 1 s
        rw [pow_one] at e
        show (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((ℓ : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k) (AddMonoidAlgebra.mapRingHom ℤ (iterateFrobenius k ℓ 1) s) ∈ S
        rw [← e]
        exact pow_mem hs ℓ
      have hs₁A : AddMonoidAlgebra.mapRingHom ℤ (iterateFrobenius k ℓ 1) s ∉ (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((ℓ : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k).range :=
        fun h => hsA ((hD7 _ (iterateFrobenius k ℓ 1).injective ℓ s hℓ0).mp h)
      exact h1 S (fun f => ih S₁ hS₁A hS₁rel _ hs₁ hs₁A f) hrel s hs hsA z

  have wcIL_subring_classify : ∀ (k : Type u) [Field k] (ℓ : ℕ) [Fact (Nat.Prime ℓ)],
      ((∀ a b : ℕ, ((AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((a : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k).comp (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((b : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k)) = (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((a * b : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k)) ∧ (∀ f : LaurentPolynomial k, (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((1 : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k) f = f) ∧ (∀ d : ℕ, d ≠ 0 → Function.Injective (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((d : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k))) →
      (∀ (M : ℕ) (S' : Subring (LaurentPolynomial k)), (∀ f : LaurentPolynomial k, (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ M : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k) f ∈ S') → (∀ z c : LaurentPolynomial k, c ∈ S' → c ≠ 0 → c * z ∈ S' → z ∈ S') → ∀ s ∈ S', s ∉ (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((ℓ : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k).range → ∀ z : LaurentPolynomial k, z ∈ S') →
      ∀ (N : ℕ) (S : Subring (LaurentPolynomial k)), (∀ f : LaurentPolynomial k, (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ N : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k) f ∈ S) → (∀ z c : LaurentPolynomial k, c ∈ S → c ≠ 0 → c * z ∈ S → z ∈ S) → ∃ j ≤ N, ∀ z : LaurentPolynomial k, z ∈ S ↔ z ∈ (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ j : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k).range := by
    classical
    intro k _ ℓ _ hD hM N S hS hrel
    obtain ⟨hD1, hD2, hD3⟩ := hD
    have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
    let F : ℕ → (LaurentPolynomial k →+* LaurentPolynomial k) := fun d =>
      (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((d : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k)
    let P : ℕ → Prop := fun j => ∀ z ∈ S, z ∈ (F (ℓ ^ j)).range
    have hP0 : P 0 := fun z _ => ⟨z, by
      show (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ 0 : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k) z = z
      rw [pow_zero]; exact hD2 z⟩
    have hPj : P (Nat.findGreatest P N) := Nat.findGreatest_spec (Nat.zero_le N) hP0
    have hjN : Nat.findGreatest P N ≤ N := Nat.findGreatest_le N
    refine ⟨Nat.findGreatest P N, hjN, fun z => ⟨fun hz => hPj z hz, ?_⟩⟩
    rintro ⟨w, rfl⟩
    rcases lt_or_eq_of_le hjN with hlt | heq
    · have hnP : ¬ P (Nat.findGreatest P N + 1) := Nat.findGreatest_is_greatest (Nat.lt_succ_self _) hlt
      obtain ⟨s, hs, hsA⟩ : ∃ s ∈ S, s ∉ (F (ℓ ^ (Nat.findGreatest P N + 1))).range := by
        by_contra hcon
        push_neg at hcon
        exact hnP hcon
      obtain ⟨s', rfl⟩ := hPj s hs
      have hs'A : s' ∉ (F ℓ).range := by
        rintro ⟨t, rfl⟩
        apply hsA
        refine ⟨t, ?_⟩
        have e := congrArg (fun φ => φ t) (hD1 (ℓ ^ Nat.findGreatest P N) ℓ)
        simp only [RingHom.comp_apply] at e
        show F (ℓ ^ (Nat.findGreatest P N + 1)) t = F (ℓ ^ Nat.findGreatest P N) (F ℓ t)
        rw [pow_succ]
        exact e.symm
      have hS'A : ∀ f : LaurentPolynomial k, F (ℓ ^ (N - Nat.findGreatest P N)) f ∈ S.comap (F (ℓ ^ Nat.findGreatest P N)) := by
        intro f
        show F (ℓ ^ Nat.findGreatest P N) (F (ℓ ^ (N - Nat.findGreatest P N)) f) ∈ S
        have e := congrArg (fun φ => φ f) (hD1 (ℓ ^ Nat.findGreatest P N) (ℓ ^ (N - Nat.findGreatest P N)))
        simp only [RingHom.comp_apply] at e
        show (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ Nat.findGreatest P N : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k) ((AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ (N - Nat.findGreatest P N) : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k) f) ∈ S
        rw [e, ← pow_add, Nat.add_sub_cancel' hjN]
        exact hS f
      have hS'rel : ∀ z c : LaurentPolynomial k, c ∈ S.comap (F (ℓ ^ Nat.findGreatest P N)) → c ≠ 0 → c * z ∈ S.comap (F (ℓ ^ Nat.findGreatest P N)) → z ∈ S.comap (F (ℓ ^ Nat.findGreatest P N)) := by
        intro z c hc hc0 hcz
        exact hrel _ _ hc (fun h => hc0 (hD3 _ (pow_ne_zero _ hℓ0) (h.trans (map_zero _).symm)))
          (by rw [← map_mul]; exact hcz)
      exact hM (N - Nat.findGreatest P N) (S.comap (F (ℓ ^ Nat.findGreatest P N))) hS'A hS'rel s' hs hs'A w
    · show (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ Nat.findGreatest P N : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k) w ∈ S
      rw [heq]
