    apply mul_right_cancel₀ (pow_ne_zero (k + d) hU)
    linear_combination F * hX + heq - B ^ d * C₀ * hY - C₀ * P₀ * U ^ k * hBU

  obtain ⟨h, c, w, n, k, ε₀, ε₁, r₀, r₁, g₀, g₁, hh0, hc0, hwm, hε₀, hε₁, hcase⟩ :=
    wcpa_dj_llsm_kpwul_boundary_form Ω W hW hWt ℓ hℓ hΩ hκ A K 𝔭 u v g hPD f' a s ha hs hfac'
  have hhL : algebraMap K L h ≠ 0 := (map_ne_zero _).mpr hh0
