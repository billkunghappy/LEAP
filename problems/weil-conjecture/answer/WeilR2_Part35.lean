theorem wcpa_dj_llsm_kpwbb_node_unit : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g b₀ : ↥W), wcLlsPD W A 𝔭 (.ann u v g) → b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 → b₀ ∣ g → ∀ a : A, a ∉ 𝔭 → ∀ x : ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u}), x ∈ Ideal.span {algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u}) u, ⟨algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u, Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔ (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u})).comp (algebraMap ↥W A)) → algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u}) a + x ∉ Ideal.span {algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u}) u, ⟨algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u, Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔ (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K u})).comp (algebraMap ↥W A)) :=
