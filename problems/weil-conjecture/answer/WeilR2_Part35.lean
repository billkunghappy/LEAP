      intro hm
      apply hb
      have h1 : algebraMap E B s₀ ∈ P.map (algebraMap E B) := Ideal.mem_map_of_mem _ hm
      rw [← hs₀, ← hv] at h1
      have h2 := Ideal.mul_mem_right (↑v⁻¹ : B) _ h1
