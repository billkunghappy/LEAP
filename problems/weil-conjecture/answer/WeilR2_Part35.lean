theorem wcFrf_rep_exists : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ F : K, F ≠ 0 →
    ∃ (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A), wcFrfREP W A K 𝔭 t F k1 k2 Z Y d e :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 t hPD F hF
  classical

  have hlist : ∀ (g : ↥W → K) (r : ℕ) (c : Fin r → ↥W) (n : Fin r → ℕ),
      (∀ i, c i ∈ IsLocalRing.maximalIdeal ↥W) →
      ∃ Z : List ↥W, (∀ z ∈ Z, z ∈ IsLocalRing.maximalIdeal ↥W) ∧
        (Z.map g).prod = ∏ i, g (c i) ^ (n i) := by
    intro g r
    induction r with
    | zero =>
      intro c n _
      exact ⟨[], by simp, by simp⟩
    | succ r ih =>
      intro c n hc
      obtain ⟨Z', hZ'm, hZ'p⟩ := ih (fun i => c i.succ) (fun i => n i.succ) (fun i => hc i.succ)
      refine ⟨List.replicate (n 0) (c 0) ++ Z', ?_, ?_⟩
      · intro z hz
        rcases List.mem_append.mp hz with h | h
        · rw [(List.mem_replicate.mp h).2]; exact hc 0
        · exact hZ'm z h
      · rw [List.map_append, List.prod_append, List.map_replicate, List.prod_replicate, hZ'p,
          Fin.prod_univ_succ]
  have h𝔭 : 𝔭.IsPrime := hPD.2.2.2.1.isPrime
  obtain ⟨x, y, hy, hxy⟩ := IsFractionRing.div_surjective (A := A) F
  have hy0 : y ≠ 0 := nonZeroDivisors.ne_zero hy
  have hφy : algebraMap A K y ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hy
  have hx0 : x ≠ 0 := by
    rintro rfl
    apply hF
    rw [← hxy, map_zero, zero_div]
  have hE0 : F * algebraMap A K y = algebraMap A K x := by
    rw [← hxy, div_mul_cancel₀ _ hφy]
  obtain ⟨r, c, n, dx, ax, sx, -, hcm, hdx, hax, hsx, hEx⟩ :=
    wcpa_dj_llsm_kpd_disc_factorization Ω W hW hWt A 𝔭 t hPD x hx0
  obtain ⟨r', c', n', dy, ay, sy, -, hcm', hdy, hay, hsy, hEy⟩ :=
    wcpa_dj_llsm_kpd_disc_factorization Ω W hW hWt A 𝔭 t hPD y hy0
  set g : ↥W → K := fun z => algebraMap A K (t - algebraMap ↥W A z) with hg
  obtain ⟨Z, hZm, hZp⟩ := hlist g r c n hcm
  obtain ⟨Y, hYm, hYp⟩ := hlist g r' c' n' hcm'
  have hEx' : algebraMap A K sx * algebraMap A K x =
      algebraMap A K (algebraMap ↥W A dx) * algebraMap A K ax * (Z.map g).prod := by
    rw [← map_mul, hEx, map_mul, map_mul, map_prod, hZp]
    simp only [map_pow, hg]
  have hEy' : algebraMap A K sy * algebraMap A K y =
      algebraMap A K (algebraMap ↥W A dy) * algebraMap A K ay * (Y.map g).prod := by
    rw [← map_mul, hEy, map_mul, map_mul, map_prod, hYp]
    simp only [map_pow, hg]
  refine ⟨dx, dy, Z, Y, sx * ay, sy * ax, hdx, hdy, ?_, ?_, ?_, ?_⟩
  · intro h
    rcases h𝔭.mem_or_mem h with h | h
    · exact hsx h
    · exact hay h
  · intro h
    rcases h𝔭.mem_or_mem h with h | h
    · exact hsy h
    · exact hax h
  · intro z hz
    rcases List.mem_append.mp hz with h | h
    · exact hZm z h
    · exact hYm z h
  · show algebraMap A K (sx * ay) * algebraMap A K (algebraMap ↥W A dy) * (Y.map g).prod * F =
      algebraMap A K (algebraMap ↥W A dx) * (Z.map g).prod * algebraMap A K (sy * ax)
    rw [map_mul, map_mul]
    linear_combination (-(algebraMap A K sx * F)) * hEy' +
      (algebraMap A K sx * algebraMap A K sy) * hE0 + (algebraMap A K sy) * hEx'

theorem wcFrf_gauss_val : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A) (c : ↥W), wcLlsPD W A 𝔭 (.disc t) →
    c ∈ IsLocalRing.maximalIdeal ↥W →
    ∃ O : ↥W → ValuationSubring K, wcFrfVAL W A K 𝔭 t c O :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 t c hPD hc
  classical

  have fp : ∀ (B : Type u) [CommRing B] [Algebra ↥W B] (𝔮 : Ideal B) (t : B),
      𝔮.IsMaximal → (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) ≤ 𝔮 → t ∈ 𝔮 →
      (∀ a b : B, a * b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) →
        ∃ s : B, s ∉ 𝔮 ∧ (s * a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) ∨
          s * b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B))) →
      (∀ s : B, s ∉ 𝔮 → s * t ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B)) →
      (∀ x : B, x ≠ 0 → ∃ (d : ↥W) (u b : B), d ≠ 0 ∧
        (∀ s : B, s ∉ 𝔮 → s * u ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B)) ∧
        (∀ s : B, s ∉ 𝔮 → s * b ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B)) ∧
        b * x = algebraMap ↥W B d * u) →
      ∃ P : Ideal B, P.IsPrime ∧ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) ≤ P ∧
        (∀ x : B, x ≠ 0 → ∃ (d : ↥W) (u b : B), d ≠ 0 ∧ u ∉ P ∧ b ∉ P ∧
          b * x = algebraMap ↥W B d * u) ∧
        (∀ e : ↥W, t - algebraMap ↥W B e ∉ P) ∧
        (∀ π : ↥W, π ∈ IsLocalRing.maximalIdeal ↥W → algebraMap ↥W B π * t - 1 ∉ P) := by
    intro B _ _ 𝔮 t hmax hM ht SF1 SF2 GV
    set M := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) with hMdef
    have hq : 𝔮.IsPrime := hmax.isPrime
    have h1q : (1 : B) ∉ 𝔮 := fun h => hq.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    let P : Ideal B :=
      { carrier := {x | ∃ σ, σ ∉ 𝔮 ∧ σ * x ∈ M}
        add_mem' := by
          rintro x y ⟨σ₁, h1, hx⟩ ⟨σ₂, h2, hy⟩
          refine ⟨σ₁ * σ₂, hq.mul_notMem h1 h2, ?_⟩
          have : σ₁ * σ₂ * (x + y) = σ₂ * (σ₁ * x) + σ₁ * (σ₂ * y) := by ring
          rw [this]
          exact M.add_mem (M.mul_mem_left _ hx) (M.mul_mem_left _ hy)
        zero_mem' := ⟨1, h1q, by rw [mul_zero]; exact M.zero_mem⟩
        smul_mem' := by
          rintro r x ⟨σ, h1, hx⟩
          refine ⟨σ, h1, ?_⟩
          have : σ * (r • x) = r * (σ * x) := by rw [smul_eq_mul]; ring
          rw [this]
          exact M.mul_mem_left _ hx }
    have hmemP : ∀ x, x ∈ P ↔ ∃ σ, σ ∉ 𝔮 ∧ σ * x ∈ M := fun x => Iff.rfl
    have hPprime : P.IsPrime := by
      refine ⟨?_, ?_⟩
      · intro htop
        have : (1 : B) ∈ P := htop ▸ Submodule.mem_top
        obtain ⟨σ, hσ, h⟩ := (hmemP 1).mp this
        rw [mul_one] at h
        exact hσ (hM h)
      · intro a b hab
        obtain ⟨σ, hσ, h⟩ := (hmemP _).mp hab
        rw [← mul_assoc] at h
        obtain ⟨s, hs, h'⟩ := SF1 (σ * a) b h
        rcases h' with h' | h'
        · left; exact ⟨s * σ, hq.mul_notMem hs hσ, by rw [mul_assoc]; exact h'⟩
        · right; exact ⟨s, hs, h'⟩
    have hMP : M ≤ P := fun x hx => ⟨1, h1q, by rw [one_mul]; exact hx⟩
    refine ⟨P, hPprime, hMP, ?_, ?_, ?_⟩
    · intro x hx
      obtain ⟨d, u, b, hd, hu, hb, h⟩ := GV x hx
      refine ⟨d, u, b, hd, ?_, ?_, h⟩
      · rintro ⟨σ, hσ, h'⟩; exact hu σ hσ h'
      · rintro ⟨σ, hσ, h'⟩; exact hb σ hσ h'
    · rintro e ⟨σ, hσ, h⟩
      by_cases he : e ∈ IsLocalRing.maximalIdeal ↥W
      · apply SF2 σ hσ
        have : σ * t = σ * (t - algebraMap ↥W B e) + σ * algebraMap ↥W B e := by ring
        rw [this]
        exact M.add_mem h (M.mul_mem_left _ (Ideal.mem_map_of_mem _ he))
      · have hu : IsUnit e := by
          by_contra hne; exact he ((IsLocalRing.mem_maximalIdeal _).mpr hne)
        have h2 : t - algebraMap ↥W B e ∈ 𝔮 := (hq.mem_or_mem (hM h)).resolve_left hσ
        have h3 : algebraMap ↥W B e ∈ 𝔮 := by
          have := 𝔮.sub_mem ht h2
          simpa using this
        exact hmax.ne_top (Ideal.eq_top_of_isUnit_mem _ h3 (hu.map _))
    · rintro π hπ ⟨σ, hσ, h⟩
      apply hσ
      apply hM
      have hπM : algebraMap ↥W B π ∈ M := Ideal.mem_map_of_mem _ hπ
      have : σ = σ * algebraMap ↥W B π * t - σ * (algebraMap ↥W B π * t - 1) := by ring
      rw [this]
      exact M.sub_mem (M.mul_mem_right _ (M.mul_mem_left _ hπM)) h

  have lvs : ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] (K : Type u) [Field K]
      [Algebra B K] [IsFractionRing B K] (P : Ideal B), P.IsPrime →
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) ≤ P →
      (∀ w : ↥W, w ≠ 0 → algebraMap ↥W B w ≠ 0) →
      (∀ x : B, x ≠ 0 → ∃ (d : ↥W) (u b : B), d ≠ 0 ∧ u ∉ P ∧ b ∉ P ∧
        b * x = algebraMap ↥W B d * u) →
      ∃ V : ValuationSubring K, (∀ x : B, algebraMap B K x ∈ V) ∧
        (∀ y : B, y ∉ P → (algebraMap B K y)⁻¹ ∈ V) ∧
        (∀ w₁ w₂ : ↥W, w₁ ≠ 0 → w₂ ≠ 0 →
          algebraMap B K (algebraMap ↥W B w₁) / algebraMap B K (algebraMap ↥W B w₂) ∈ V →
          w₂ ∣ w₁) := by
    intro B _ _ _ K _ _ _ P hP hMP hinj GV
    have hψinj : Function.Injective (algebraMap B K) := IsFractionRing.injective B K
    have hψne : ∀ y : B, y ≠ 0 → algebraMap B K y ≠ 0 := fun y hy h =>
      hy (hψinj (by rw [h, map_zero]))
    have hne : ∀ y : B, y ∉ P → algebraMap B K y ≠ 0 := by
      intro y hy
      apply hψne
      rintro rfl
      exact hy P.zero_mem
    have h1P : (1 : B) ∉ P := fun h => hP.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    let S : Subring K :=
      { carrier := {z | ∃ x y : B, y ∉ P ∧ z * algebraMap B K y = algebraMap B K x}
        mul_mem' := by
          rintro z₁ z₂ ⟨x₁, y₁, h1, e1⟩ ⟨x₂, y₂, h2, e2⟩
          refine ⟨x₁ * x₂, y₁ * y₂, hP.mul_notMem h1 h2, ?_⟩
          rw [map_mul, map_mul, ← e1, ← e2]; ring
        one_mem' := ⟨1, 1, h1P, by rw [one_mul]⟩
        add_mem' := by
          rintro z₁ z₂ ⟨x₁, y₁, h1, e1⟩ ⟨x₂, y₂, h2, e2⟩
          refine ⟨x₁ * y₂ + x₂ * y₁, y₁ * y₂, hP.mul_notMem h1 h2, ?_⟩
          rw [map_add, map_mul, map_mul, map_mul, ← e1, ← e2]; ring
        zero_mem' := ⟨0, 1, h1P, by rw [zero_mul, map_zero]⟩
        neg_mem' := by
          rintro z ⟨x, y, h, e⟩
          exact ⟨-x, y, h, by rw [map_neg, ← e]; ring⟩ }
    have hval : ∀ z : K, z ∈ S.carrier ∨ z⁻¹ ∈ S.carrier := by
      intro z
      by_cases hz : z = 0
      · left; rw [hz]; exact S.zero_mem
      obtain ⟨x, y, hy, rfl⟩ := IsFractionRing.div_surjective (A := B) z
      have hy0 : y ≠ 0 := nonZeroDivisors.ne_zero hy
      have hx0 : x ≠ 0 := by rintro rfl; simp at hz
      obtain ⟨d₁, u₁, b₁, hd₁, hu₁, hb₁, e₁⟩ := GV x hx0
      obtain ⟨d₂, u₂, b₂, hd₂, hu₂, hb₂, e₂⟩ := GV y hy0
      have hψy := hψne y hy0
      have hψx := hψne x hx0
      have e₁' : algebraMap B K b₁ * algebraMap B K x =
          algebraMap B K (algebraMap ↥W B d₁) * algebraMap B K u₁ := by
        rw [← map_mul, ← map_mul, e₁]
      have e₂' : algebraMap B K b₂ * algebraMap B K y =
          algebraMap B K (algebraMap ↥W B d₂) * algebraMap B K u₂ := by
        rw [← map_mul, ← map_mul, e₂]
      rcases ValuationRing.dvd_total d₁ d₂ with ⟨q, hq⟩ | ⟨q, hq⟩
      · right
        refine ⟨algebraMap ↥W B q * u₂ * b₁, b₂ * u₁, hP.mul_notMem hb₂ hu₁, ?_⟩
        rw [hq, map_mul, map_mul] at e₂'
        rw [inv_div, div_mul_eq_mul_div, div_eq_iff hψx]
        simp only [map_mul]
        linear_combination (algebraMap B K u₁) * e₂' -
          (algebraMap B K (algebraMap ↥W B q)) * (algebraMap B K u₂) * e₁'
      · left
        refine ⟨algebraMap ↥W B q * u₁ * b₂, b₁ * u₂, hP.mul_notMem hb₁ hu₂, ?_⟩
        rw [hq, map_mul, map_mul] at e₁'
        rw [div_mul_eq_mul_div, div_eq_iff hψy]
        simp only [map_mul]
        linear_combination (algebraMap B K u₂) * e₁' -
          (algebraMap B K (algebraMap ↥W B q)) * (algebraMap B K u₁) * e₂'
    let V : ValuationSubring K := { S with mem_or_inv_mem' := hval }
    have hmemV : ∀ z, z ∈ V ↔ ∃ x y : B, y ∉ P ∧ z * algebraMap B K y = algebraMap B K x :=
      fun z => Iff.rfl
    refine ⟨V, ?_, ?_, ?_⟩
    · intro x
      exact (hmemV _).mpr ⟨x, 1, h1P, by rw [map_one, mul_one]⟩
    · intro y hy
      exact (hmemV _).mpr ⟨1, y, hy, by rw [inv_mul_cancel₀ (hne y hy), map_one]⟩
    · intro w₁ w₂ hw₁ hw₂ hmem
      rcases ValuationRing.dvd_total w₂ w₁ with h | ⟨π, hπ⟩
      · exact h
      by_cases hu : IsUnit π
      · exact ⟨↑hu.unit⁻¹, by rw [hπ, mul_assoc, hu.mul_val_inv, mul_one]⟩
      exfalso
      have hπm : π ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal _).mpr hu
      have hπ0 : π ≠ 0 := by rintro rfl; rw [mul_zero] at hπ; exact hw₂ hπ
      have h1 : algebraMap B K (algebraMap ↥W B w₁) ≠ 0 := hψne _ (hinj _ hw₁)
      have h2 : algebraMap B K (algebraMap ↥W B π) ≠ 0 := hψne _ (hinj _ hπ0)
      have hratio : algebraMap B K (algebraMap ↥W B w₁) / algebraMap B K (algebraMap ↥W B w₂) =
          (algebraMap B K (algebraMap ↥W B π))⁻¹ := by
        rw [hπ, map_mul, map_mul, div_mul_eq_div_div, div_self h1, one_div]
      rw [hratio] at hmem
      obtain ⟨x, y, hy, h⟩ := (hmemV _).mp hmem
      rw [inv_mul_eq_iff_eq_mul₀ h2, ← map_mul] at h
      have hyx : y = algebraMap ↥W B π * x := hψinj h
      apply hy
      rw [hyx]
      exact P.mul_mem_right x (hMP (Ideal.mem_map_of_mem _ hπm))

  have ru : ∀ (ρ : ↥W) (V : ValuationSubring K) (s : K), ρ ≠ 0 →
      (∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0) →
      algebraMap A K (t - algebraMap ↥W A c) = algebraMap A K (algebraMap ↥W A ρ) * s →
      (∀ e : ↥W, s - algebraMap A K (algebraMap ↥W A e) ≠ 0 ∧
        s - algebraMap A K (algebraMap ↥W A e) ∈ V ∧
        (s - algebraMap A K (algebraMap ↥W A e))⁻¹ ∈ V) →
      (∀ π : ↥W, π ∈ IsLocalRing.maximalIdeal ↥W →
        algebraMap A K (algebraMap ↥W A π) * s - 1 ≠ 0 ∧
        algebraMap A K (algebraMap ↥W A π) * s - 1 ∈ V ∧
        (algebraMap A K (algebraMap ↥W A π) * s - 1)⁻¹ ∈ V) →
      (∀ a : A, a ∉ 𝔭 → algebraMap A K a ≠ 0 ∧ algebraMap A K a ∈ V ∧
        (algebraMap A K a)⁻¹ ∈ V) →
      ∀ (F : K) (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A), F ≠ 0 →
        wcFrfREP W A K 𝔭 t F k1 k2 Z Y d e →
        algebraMap A K (algebraMap ↥W A (k2 * wcFrfP W c ρ Y)) * F /
            algebraMap A K (algebraMap ↥W A (k1 * wcFrfP W c ρ Z)) ∈ V ∧
          algebraMap A K (algebraMap ↥W A (k1 * wcFrfP W c ρ Z)) /
            (algebraMap A K (algebraMap ↥W A (k2 * wcFrfP W c ρ Y)) * F) ∈ V := by
    intro ρ V s hρ hinj hrel U1 U2 U3 F k1 k2 Z Y d e hF hrep
    let U : K → Prop := fun z => z ≠ 0 ∧ z ∈ V ∧ z⁻¹ ∈ V
    have Umul : ∀ a b : K, U a → U b → U (a * b) := by
      rintro a b ⟨ha0, ha, ha'⟩ ⟨hb0, hb, hb'⟩
      exact ⟨mul_ne_zero ha0 hb0, V.mul_mem _ _ ha hb,
        by rw [mul_inv]; exact V.mul_mem _ _ ha' hb'⟩
    have Uinv : ∀ a : K, U a → U a⁻¹ := by
      rintro a ⟨ha0, ha, ha'⟩
      exact ⟨inv_ne_zero ha0, ha', by rw [inv_inv]; exact ha⟩
    have Uone : U 1 := ⟨one_ne_zero, V.one_mem, by rw [inv_one]; exact V.one_mem⟩
    have factor : ∀ x : ↥W, ∃ G : K, U G ∧
        (if ρ ∣ x - c then ρ else x - c) ≠ 0 ∧
        algebraMap A K (t - algebraMap ↥W A x) =
          algebraMap A K (algebraMap ↥W A (if ρ ∣ x - c then ρ else x - c)) * G := by
      intro x
      by_cases h : ρ ∣ x - c
      · rw [if_pos h]
        obtain ⟨e', he'⟩ := h
        refine ⟨s - algebraMap A K (algebraMap ↥W A e'), U1 e', hρ, ?_⟩
        have hx : x = c + ρ * e' := by rw [← he']; ring
        have e1 : algebraMap A K (t - algebraMap ↥W A x) =
            algebraMap A K (t - algebraMap ↥W A c) -
              algebraMap A K (algebraMap ↥W A ρ) * algebraMap A K (algebraMap ↥W A e') := by
          rw [hx]; simp only [map_sub, map_add, map_mul]; ring
        rw [e1, hrel]; ring
      · rw [if_neg h]
        rcases ValuationRing.dvd_total (x - c) ρ with ⟨π, hπ⟩ | h'
        · have hπu : ¬ IsUnit π := by
            intro hu
            apply h
            exact ⟨↑hu.unit⁻¹, by rw [hπ, mul_assoc, hu.mul_val_inv, mul_one]⟩
          have hπm : π ∈ IsLocalRing.maximalIdeal ↥W :=
            (IsLocalRing.mem_maximalIdeal _).mpr hπu
          have hxc : x - c ≠ 0 := by
            intro h0; apply h; rw [h0]; exact dvd_zero ρ
          refine ⟨algebraMap A K (algebraMap ↥W A π) * s - 1, U2 π hπm, hxc, ?_⟩
          have e1 : algebraMap A K (t - algebraMap ↥W A x) =
              algebraMap A K (t - algebraMap ↥W A c) -
                algebraMap A K (algebraMap ↥W A (x - c)) := by
            simp only [map_sub]; ring
          rw [e1, hrel, hπ, map_mul, map_mul]; ring
        · exact absurd h' h
    have prodL : ∀ X : List ↥W, ∃ G : K, U G ∧ wcFrfP W c ρ X ≠ 0 ∧
        (X.map (fun y => algebraMap A K (t - algebraMap ↥W A y))).prod =
          algebraMap A K (algebraMap ↥W A (wcFrfP W c ρ X)) * G := by
      intro X
      induction X with
      | nil => exact ⟨1, Uone, by simp [wcFrfP], by simp [wcFrfP]⟩
      | cons x X ih =>
        obtain ⟨G, hG, hP0, hX⟩ := ih
        obtain ⟨Gx, hGx, hp0, hx⟩ := factor x
        have hPc : wcFrfP W c ρ (x :: X) =
            (if ρ ∣ x - c then ρ else x - c) * wcFrfP W c ρ X := by
          unfold wcFrfP
          by_cases h : ρ ∣ x - c
          · simp [h, pow_succ]; ring
          · simp [h]; ring
        refine ⟨Gx * G, Umul _ _ hGx hG, by rw [hPc]; exact mul_ne_zero hp0 hP0, ?_⟩
        rw [List.map_cons, List.prod_cons, hX, hx, hPc, map_mul, map_mul]; ring
    obtain ⟨hk1, hk2, hd, he, -, hR⟩ := hrep
    obtain ⟨GY, hGY, hPY, hY⟩ := prodL Y
    obtain ⟨GZ, hGZ, hPZ, hZ⟩ := prodL Z
    obtain ⟨hd0, hdV, hdV'⟩ := U3 d hd
    obtain ⟨he0, heV, heV'⟩ := U3 e he
    rw [hY, hZ] at hR
    have hden1 : algebraMap A K (algebraMap ↥W A (k1 * wcFrfP W c ρ Z)) ≠ 0 :=
      hinj _ (mul_ne_zero hk1 hPZ)
    have hden2 : algebraMap A K d * GY ≠ 0 := mul_ne_zero hd0 hGY.1
    have hX : algebraMap A K (algebraMap ↥W A (k2 * wcFrfP W c ρ Y)) * F /
        algebraMap A K (algebraMap ↥W A (k1 * wcFrfP W c ρ Z)) =
        GZ * algebraMap A K e / (algebraMap A K d * GY) := by
      rw [div_eq_div_iff hden1 hden2]
      simp only [map_mul]
      linear_combination hR
    have hUX : U (GZ * algebraMap A K e / (algebraMap A K d * GY)) := by
      rw [div_eq_mul_inv]
      exact Umul _ _ (Umul _ _ hGZ ⟨he0, heV, heV'⟩) (Uinv _ (Umul _ _ ⟨hd0, hdV, hdV'⟩ hGY))
    refine ⟨by rw [hX]; exact hUX.2.1, ?_⟩
    rw [← inv_div, hX]
    exact hUX.2.2

  have hPD0 := hPD
  unfold wcLlsPD at hPD0
  obtain ⟨_, hnz, _, hmax, _, _, hpeq, -⟩ := hPD0
  have hφinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have haWinj : Function.Injective (algebraMap ↥W A) := by
    haveI := hnz; exact FaithfulSMul.algebraMap_injective ↥W A
  have hinj : ∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0 := by
    intro w hw h
    apply hw
    apply haWinj
    apply hφinj
    rw [h, map_zero, map_zero]

  have H : ∀ ρ : ↥W, ∃ V : ValuationSubring K, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 →
      (∀ (F : K) (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A), F ≠ 0 →
        wcFrfREP W A K 𝔭 t F k1 k2 Z Y d e →
        algebraMap A K (algebraMap ↥W A (k2 * wcFrfP W c ρ Y)) * F /
            algebraMap A K (algebraMap ↥W A (k1 * wcFrfP W c ρ Z)) ∈ V ∧
          algebraMap A K (algebraMap ↥W A (k1 * wcFrfP W c ρ Z)) /
            (algebraMap A K (algebraMap ↥W A (k2 * wcFrfP W c ρ Y)) * F) ∈ V) ∧
      (∀ w₁ w₂ : ↥W, w₁ ≠ 0 → w₂ ≠ 0 →
        algebraMap A K (algebraMap ↥W A w₁) / algebraMap A K (algebraMap ↥W A w₂) ∈ V →
        w₂ ∣ w₁) ∧
      (∀ a : A, algebraMap A K a ∈ V) := by
    intro ρ
    by_cases hρ : ρ ∈ IsLocalRing.maximalIdeal ↥W ∧ ρ ≠ 0
    swap
    · exact ⟨⊤, fun h1 h2 => absurd ⟨h1, h2⟩ hρ⟩
    obtain ⟨hρm, hρ0⟩ := hρ

    obtain ⟨A'', i1, i2, i3, i4, i5, i6, i7, t', 𝔭'', hBr, ht', hPD'', -⟩ :=
      wcpa_dj_llsm_br_residue_chart Ω W hW hWt A K K 𝔭 t c ρ hPD hc hρm hρ0
    clear i7 i6
    have hBr0 := hBr
    unfold wcLlsBrSub at hBr0
    obtain ⟨Br1, Br2, -⟩ := hBr0
    have lift : ∀ a : A, ∃ a'' : A'', algebraMap A'' K a'' = algebraMap A K a := by
      intro a
      exact Br2 (Subalgebra.algebraMap_mem _ a)
    have hρK := hinj ρ hρ0
    have rel : algebraMap A K (t - algebraMap ↥W A c) =
        algebraMap A K (algebraMap ↥W A ρ) * algebraMap A'' K t' := by
      rw [ht']; field_simp
    have hinj'' : Function.Injective (algebraMap A'' K) := IsFractionRing.injective A'' K
    have hinjW'' : ∀ w : ↥W, w ≠ 0 → algebraMap ↥W A'' w ≠ 0 := by
      intro w hw h
      apply hinj w hw
      rw [← Br1, h, map_zero]

    obtain ⟨SF1, SF2, -⟩ :=
      wcpa_dj_llsm_kpdf_special_fibre_dvr Ω W hW hWt A'' 𝔭'' t' hPD''
    have GV := wcpa_dj_llsm_kpdf_generic_valuation Ω W hW hWt A'' 𝔭'' t' hPD'' SF1 SF2
    have hPD''0 := hPD''
    unfold wcLlsPD at hPD''0
    obtain ⟨_, _, _, hmax'', hmA'', ht'', -⟩ := hPD''0

    obtain ⟨P, hP, hMP, GVP, P4, P5⟩ := fp A'' 𝔭'' t' hmax'' hmA'' ht'' SF1 SF2 GV
    obtain ⟨V, V1, V2, V3⟩ := lvs A'' K P hP hMP hinjW'' GVP
    have Punit : ∀ y : A'', y ∉ P → algebraMap A'' K y ≠ 0 ∧ algebraMap A'' K y ∈ V ∧
        (algebraMap A'' K y)⁻¹ ∈ V := by
      intro y hy
      refine ⟨?_, V1 y, V2 y hy⟩
      intro h0
      apply hy
      have : y = 0 := hinj'' (by rw [h0, map_zero])
      rw [this]; exact P.zero_mem

    let J : Ideal A :=
      { carrier := {a | ∃ a'' ∈ P, algebraMap A'' K a'' = algebraMap A K a}
        add_mem' := by
          rintro a b ⟨a'', ha, ea⟩ ⟨b'', hb, eb⟩
          exact ⟨a'' + b'', P.add_mem ha hb, by rw [map_add, map_add, ea, eb]⟩
        zero_mem' := ⟨0, P.zero_mem, by rw [map_zero, map_zero]⟩
        smul_mem' := by
          rintro r a ⟨a'', ha, ea⟩
          obtain ⟨r'', er⟩ := lift r
          exact ⟨r'' * a'', P.mul_mem_left _ ha, by rw [smul_eq_mul, map_mul, map_mul, er, ea]⟩ }
    have hmemJ : ∀ a, a ∈ J ↔ ∃ a'' ∈ P, algebraMap A'' K a'' = algebraMap A K a :=
      fun a => Iff.rfl
    have hcP : algebraMap ↥W A'' c ∈ P := hMP (Ideal.mem_map_of_mem _ hc)
    have hρP : algebraMap ↥W A'' ρ ∈ P := hMP (Ideal.mem_map_of_mem _ hρm)
    have hle : 𝔭 ≤ J := by
      rw [hpeq]
      refine sup_le ?_ ?_
      · rw [Ideal.span_singleton_le_iff_mem]
        refine (hmemJ t).mpr ⟨algebraMap ↥W A'' ρ * t' + algebraMap ↥W A'' c,
          P.add_mem (P.mul_mem_right _ hρP) hcP, ?_⟩
        rw [map_add, map_mul, Br1, Br1, ← rel, map_sub]; ring
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        exact Ideal.mem_comap.mpr ((hmemJ _).mpr
          ⟨algebraMap ↥W A'' w, hMP (Ideal.mem_map_of_mem _ hw), Br1 w⟩)
    have hJne : J ≠ ⊤ := by
      intro hJ
      have h1 : (1 : A) ∈ J := hJ ▸ Submodule.mem_top
      obtain ⟨a'', ha, ea⟩ := (hmemJ 1).mp h1
      rw [map_one, ← map_one (algebraMap A'' K)] at ea
      have : a'' = 1 := hinj'' ea
      rw [this] at ha
      exact hP.ne_top ((Ideal.eq_top_iff_one _).mpr ha)
    have hJ : 𝔭 = J := hmax.eq_of_le hJne hle

    have U1 : ∀ e : ↥W, algebraMap A'' K t' - algebraMap A K (algebraMap ↥W A e) ≠ 0 ∧
        algebraMap A'' K t' - algebraMap A K (algebraMap ↥W A e) ∈ V ∧
        (algebraMap A'' K t' - algebraMap A K (algebraMap ↥W A e))⁻¹ ∈ V := by
      intro e
      have : algebraMap A'' K t' - algebraMap A K (algebraMap ↥W A e) =
          algebraMap A'' K (t' - algebraMap ↥W A'' e) := by rw [map_sub, Br1]
      rw [this]; exact Punit _ (P4 e)
    have U2 : ∀ π : ↥W, π ∈ IsLocalRing.maximalIdeal ↥W →
        algebraMap A K (algebraMap ↥W A π) * algebraMap A'' K t' - 1 ≠ 0 ∧
        algebraMap A K (algebraMap ↥W A π) * algebraMap A'' K t' - 1 ∈ V ∧
        (algebraMap A K (algebraMap ↥W A π) * algebraMap A'' K t' - 1)⁻¹ ∈ V := by
      intro π hπ
      have : algebraMap A K (algebraMap ↥W A π) * algebraMap A'' K t' - 1 =
          algebraMap A'' K (algebraMap ↥W A'' π * t' - 1) := by
        rw [map_sub, map_mul, Br1, map_one]
      rw [this]; exact Punit _ (P5 π hπ)
    have U3 : ∀ a : A, a ∉ 𝔭 → algebraMap A K a ≠ 0 ∧ algebraMap A K a ∈ V ∧
        (algebraMap A K a)⁻¹ ∈ V := by
      intro a ha
      obtain ⟨a'', ea⟩ := lift a
      have ha'' : a'' ∉ P := by
        intro h
        apply ha
        rw [hJ]
        exact (hmemJ a).mpr ⟨a'', h, ea⟩
      rw [← ea]; exact Punit _ ha''
    refine ⟨V, fun _ _ => ⟨?_, ?_, ?_⟩⟩
    · exact ru ρ V (algebraMap A'' K t') hρ0 hinj rel U1 U2 U3
    · intro w₁ w₂ h1 h2 hmem
      rw [← Br1, ← Br1] at hmem
      exact V3 w₁ w₂ h1 h2 hmem
    · intro a
      obtain ⟨a'', ea⟩ := lift a
      rw [← ea]; exact V1 a''
  choose O hO using H
  refine ⟨O, ?_⟩
  intro ρ hρ hρ0
  exact hO ρ hρ hρ0

theorem wcFrf_end_zero : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ (α : L) (f₀ : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α →
    ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ O : ↥W → ValuationSubring K, wcFrfVAL W A K 𝔭 t c O →
    ∃ ρ₀ : ↥W, ρ₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ ρ₀ ≠ 0 ∧
      wcFrfMem W A K 𝔭 t ℓ f₀ c (fun ρ => ρ ∣ ρ₀ ∧ ¬ ρ₀ ∣ ρ) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD hdeg α f₀ hα1 hf₀
    c hc O hO
  classical

  have hΩ : ((ℓ : ℕ) : Ω) = 0 := by
    rw [← hchar]
    exact ringChar.Nat.cast_ringChar
  have hWl : ((ℓ : ℕ) : ↥W) = 0 := by
    apply Subtype.ext
    simpa using hΩ
  have hK : ((ℓ : ℕ) : K) = 0 := by
    have e : ((ℓ : ℕ) : K) = algebraMap A K (algebraMap ↥W A ((ℓ : ℕ) : ↥W)) := by
      rw [map_natCast, map_natCast]
    rw [e, hWl, map_zero, map_zero]
  have hL : ((ℓ : ℕ) : L) = 0 := by
    rw [← map_natCast (algebraMap K L), hK, map_zero]
  have : Fact ℓ.Prime := ⟨hℓ⟩
  have : CharP L ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hL

  have hroot : ∀ g : ↥W, g ∈ IsLocalRing.maximalIdeal ↥W → g ≠ 0 → ∀ N : ℕ,
      ∃ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W ∧ x ≠ 0 ∧ x ^ (N + 1) = g := by
    intro g hgm hg0 N
    obtain ⟨y, hy⟩ := IsAlgClosed.exists_pow_nat_eq (g : Ω) (Nat.succ_pos N)
    have hy0 : y ≠ 0 := by
      rintro rfl
      apply hg0
      apply Subtype.ext
      rw [← hy]
      simp
    have hyW : y ∈ W := by
      rcases W.mem_or_inv_mem y with h | h
      · exact h
      · have e : y = (g : Ω) * (y⁻¹) ^ N := by
          rw [← hy, inv_pow, pow_succ]
          field_simp
        rw [e]
        exact mul_mem g.2 (pow_mem h N)
    have hxg : (⟨y, hyW⟩ : ↥W) ^ (N + 1) = g := by
      apply Subtype.ext
      simp [hy]
    refine ⟨⟨y, hyW⟩, ?_, ?_, hxg⟩
    · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have := (IsLocalRing.mem_maximalIdeal _).mp hgm
      rw [mem_nonunits_iff] at this
      apply this
      rw [← hxg]
      exact hu.pow _
    · intro h0
      apply hy0
      have := congrArg Subtype.val h0
      simpa using this

  have hcommon : ∀ S : List ↥W, (∀ s ∈ S, s ∈ IsLocalRing.maximalIdeal ↥W) →
      ∃ g : ↥W, g ∈ IsLocalRing.maximalIdeal ↥W ∧ g ≠ 0 ∧ ∀ s ∈ S, g ∣ s := by
    obtain ⟨π, hπm, hπ0⟩ : ∃ π : ↥W, π ∈ IsLocalRing.maximalIdeal ↥W ∧ π ≠ 0 := by
      obtain ⟨x, hx⟩ : ∃ x : Ω, x ∉ W := by
        by_contra hcon
        push Not at hcon
        apply hWt
        ext x
        simp only [ValuationSubring.mem_top, iff_true]
        exact hcon x
      have hx0 : x ≠ 0 := by
        rintro rfl
        exact hx W.zero_mem
      have hxi : x⁻¹ ∈ W := (W.mem_or_inv_mem x).resolve_left hx
      refine ⟨⟨x⁻¹, hxi⟩, ?_, ?_⟩
      · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        obtain ⟨b, hb⟩ := hu.exists_right_inv
        have hb' : x⁻¹ * (b : Ω) = 1 := by
          have := congrArg Subtype.val hb
          simpa using this
        have : x = b := (inv_mul_eq_one₀ hx0).mp hb'
        exact hx (this ▸ b.2)
      · intro h0
        apply inv_ne_zero hx0
        have := congrArg Subtype.val h0
        simpa using this
    intro S
    induction S with
    | nil => intro _; exact ⟨π, hπm, hπ0, by simp⟩
    | cons s S ih =>
      intro hS
      obtain ⟨g, hgm, hg0, hgS⟩ := ih (fun x hx => hS x (List.mem_cons_of_mem _ hx))
      by_cases hs0 : s = 0
      · refine ⟨g, hgm, hg0, ?_⟩
        intro x hx
        rcases List.mem_cons.mp hx with h | hx
        · rw [h, hs0]; exact dvd_zero _
        · exact hgS x hx
      · rcases ValuationRing.dvd_total g s with hgs | hsg
        · refine ⟨g, hgm, hg0, ?_⟩
          intro x hx
          rcases List.mem_cons.mp hx with h | hx
          · rw [h]; exact hgs
          · exact hgS x hx
        · refine ⟨s, hS s (by simp), hs0, ?_⟩
          intro x hx
          rcases List.mem_cons.mp hx with h | hx
          · rw [h]
          · exact hsg.trans (hgS x hx)

  have hexp : ∀ (a b σ : ↥W) (p q : ℕ), a ≠ 0 → σ ≠ 0 → ¬ IsUnit σ →
      a * σ ^ p ∣ b * σ ^ q → b * σ ^ q ∣ a * σ ^ p →
      a * σ ^ (2 * p) ∣ b * σ ^ (2 * q) → b * σ ^ (2 * q) ∣ a * σ ^ (2 * p) →
      p = q ∧ a ∣ b := by
    intro a b σ p q ha hσ hnu h1a h1b h2a h2b
    have h1 := associated_of_dvd_dvd h1a h1b
    have h2 := associated_of_dvd_dvd h2a h2b
    rw [two_mul, two_mul, pow_add, pow_add, ← mul_assoc, ← mul_assoc] at h2
    have h3 : Associated (σ ^ p) (σ ^ q) :=
      h2.of_mul_left h1 (mul_ne_zero ha (pow_ne_zero _ hσ))
    have hpq : p = q := le_antisymm ((pow_dvd_pow_iff hσ hnu).mp h3.dvd)
      ((pow_dvd_pow_iff hσ hnu).mp h3.symm.dvd)
    subst hpq
    exact ⟨rfl, (h1.of_mul_right (Associated.refl _) (pow_ne_zero _ hσ)).dvd⟩

  have hfilt1 : ∀ (σ : ↥W) (X : List ↥W), (∀ x ∈ X, σ ∣ x - c) →
      X.filter (fun x => @decide (σ ∣ x - c) (Classical.propDecidable _)) = X :=
    fun σ X h => List.filter_eq_self.mpr (fun a ha => decide_eq_true (h a ha))
  have hfilt2 : ∀ (σ : ↥W) (X : List ↥W), (∀ x ∈ X, σ ∣ x - c) →
      X.filter (fun x => @decide (¬ σ ∣ x - c) (Classical.propDecidable _)) = [] :=
    fun σ X h => List.filter_eq_nil_iff.mpr (fun a ha hd => (by simpa using hd : ¬ σ ∣ a - c) (h a ha))
  have hPnear : ∀ (σ : ↥W) (X : List ↥W), (∀ x ∈ X, σ ∣ x - c) →
      wcFrfP W c σ X = σ ^ X.length := by
    intro σ X h
    unfold wcFrfP
    rw [hfilt2 σ X h, hfilt1 σ X h]
    simp

  obtain ⟨hU, h, lam₁, lam₂, w, n, k, ε₀, ε₁, g₀, g₁, hl1, hl2, hw, hε₀, hε₁, hI, hD⟩ :=
    wcLlsAS_dse_boundary_form Ω W hW hWt ℓ hℓ A K L 𝔭 t hPD hK α f₀ hα1 hf₀.symm c hc
  have hI' : (f₀ - (h ^ ℓ - h)) *
      algebraMap A K ((t - algebraMap ↥W A c) ^ n * ε₁ + algebraMap ↥W A w * g₁) *
        algebraMap A K (algebraMap ↥W A lam₂) =
      algebraMap A K (algebraMap ↥W A lam₁) *
        algebraMap A K ((t - algebraMap ↥W A c) ^ k * ε₀ + algebraMap ↥W A w * g₀) := by
    rw [← hI]; ring

  have hF0 : f₀ - (h ^ ℓ - h) ≠ 0 := by
    intro h0
    have e1 : f₀ = h ^ ℓ - h := sub_eq_zero.mp h0
    have e2 : (α - algebraMap K L h) ^ ℓ = α - algebraMap K L h := by
      rw [sub_pow_char]
      have := hf₀
      rw [e1, map_sub, map_pow] at this
      linear_combination (-1 : L) * this
    have hbot := (Subfield.mem_bot_iff_pow_eq_self L ℓ).mpr e2
    obtain ⟨x, hx⟩ := RingHom.mem_fieldRange.mp
      ((bot_le : (⊥ : Subfield L) ≤ (algebraMap K L).fieldRange) hbot)
    exact hα1 ⟨x + h, by rw [map_add, hx]; ring⟩
  obtain ⟨k1, k2, Z, Y, d, e, hR⟩ :=
    wcFrf_rep_exists Ω W hW hWt A K 𝔭 t hPD (f₀ - (h ^ ℓ - h)) hF0
  have hZYm : ∀ z ∈ Z ++ Y, z ∈ IsLocalRing.maximalIdeal ↥W := hR.2.2.2.2.1
  have hk1 : k1 ≠ 0 := hR.1
  have hk2 : k2 ≠ 0 := hR.2.1

  obtain ⟨lamS, hlamSm, hD'⟩ : ∃ lamS : ↥W, lamS ∈ IsLocalRing.maximalIdeal ↥W ∧
      ((lam₂ ∣ lam₁ ∧ (n ≤ k ∨ ∃ lam' : ↥W, lam₁ = lam₂ * lam' ∧ lamS ∣ lam')) ∨
        ¬ (ℓ : ℤ) ∣ ((k : ℤ) - n)) := by
    rcases hD with ⟨hdv, hnk | ⟨lam', hl', hl'm⟩⟩ | hnd
    · exact ⟨0, Ideal.zero_mem _, Or.inl ⟨hdv, Or.inl hnk⟩⟩
    · exact ⟨lam', hl'm, Or.inl ⟨hdv, Or.inr ⟨lam', hl', dvd_rfl⟩⟩⟩
    · exact ⟨0, Ideal.zero_mem _, Or.inr hnd⟩

  have hSm : ∀ s ∈ w :: lamS :: (Z ++ Y).map (fun z => z - c),
      s ∈ IsLocalRing.maximalIdeal ↥W := by
    intro s hs
    rcases List.mem_cons.mp hs with h1 | hs
    · rw [h1]; exact hw
    rcases List.mem_cons.mp hs with h1 | hs
    · rw [h1]; exact hlamSm
    obtain ⟨z, hz, rfl⟩ := List.mem_map.mp hs
    exact Ideal.sub_mem _ (hZYm z hz) hc
  obtain ⟨g, hgm, hg0, hgS⟩ := hcommon _ hSm
  obtain ⟨ρ₀, hρ₀m, hρ₀0, hρ₀g⟩ := hroot g hgm hg0 (n + k)
  have hdivs : ∀ σ : ↥W, σ ∣ ρ₀ → σ ^ (n + k + 1) ∣ w ∧ σ ^ (n + k + 1) ∣ lamS ∧
      ∀ z ∈ Z ++ Y, σ ∣ z - c := by
    intro σ hσ
    have h1 : σ ^ (n + k + 1) ∣ g := hρ₀g ▸ pow_dvd_pow_of_dvd hσ _
    refine ⟨h1.trans (hgS w (by simp)), h1.trans (hgS lamS (by simp)), ?_⟩
    intro z hz
    exact (dvd_pow_self σ (by omega : n + k + 1 ≠ 0)).trans
      (h1.trans (hgS (z - c) (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
        (List.mem_map.mpr ⟨z, hz, rfl⟩)))))

  have hgauss : ∀ σ : ↥W, σ ∈ IsLocalRing.maximalIdeal ↥W → σ ≠ 0 → σ ^ (n + k + 1) ∣ w →
      (∀ z ∈ Z ++ Y, σ ∣ z - c) →
      k2 * lam₁ * σ ^ (Y.length + k) ∣ k1 * lam₂ * σ ^ (Z.length + n) ∧
        k1 * lam₂ * σ ^ (Z.length + n) ∣ k2 * lam₁ * σ ^ (Y.length + k) := by
    intro σ hσm hσ0 hσw hnear
    obtain ⟨hVI, hVII, hVIV⟩ := hO σ hσm hσ0
    have hmemle : ∀ x : K, (O σ).valuation x ≤ 1 ↔ x ∈ O σ :=
      fun x => (O σ).valuation_le_one_iff x

    have hF0' : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
      intro x hx h0
      have hd := hVII 1 x one_ne_zero hx (by rw [h0, div_zero]; exact (O σ).zero_mem)
      have hu : IsUnit x := isUnit_of_dvd_one hd
      exact ((hu.map (algebraMap ↥W A)).map (algebraMap A K)).ne_zero h0
    have hvne : ∀ x : ↥W, x ≠ 0 → (O σ).valuation (algebraMap A K (algebraMap ↥W A x)) ≠ 0 :=
      fun x hx => ((O σ).valuation.ne_zero_iff).mpr (hF0' x hx)

    have hF1 : ∀ a : A, (O σ).valuation (algebraMap A K a) ≤ 1 :=
      fun a => (hmemle _).mpr (hVIV a)

    have hF2 : ∀ w₁ w₂ : ↥W, w₁ ≠ 0 → w₂ ≠ 0 →
        (O σ).valuation (algebraMap A K (algebraMap ↥W A w₁)) ≤
          (O σ).valuation (algebraMap A K (algebraMap ↥W A w₂)) → w₂ ∣ w₁ := by
      intro w₁ w₂ h1 h2 hle
      apply hVII w₁ w₂ h1 h2
      rw [← hmemle, Valuation.map_div]
      exact (div_le_one₀ (zero_lt_iff.mpr (hvne w₂ h2))).mpr hle

    have hveq : ∀ x y : K, x ≠ 0 → y ≠ 0 → x / y ∈ O σ → y / x ∈ O σ →
        (O σ).valuation x = (O σ).valuation y := by
      intro x y hx hy h1 h2
      rw [← hmemle, Valuation.map_div] at h1 h2
      have hx' : 0 < (O σ).valuation x := zero_lt_iff.mpr (((O σ).valuation.ne_zero_iff).mpr hx)
      have hy' : 0 < (O σ).valuation y := zero_lt_iff.mpr (((O σ).valuation.ne_zero_iff).mpr hy)
      exact le_antisymm ((div_le_one₀ hy').mp h1) ((div_le_one₀ hx').mp h2)
    set r := (O σ).valuation (algebraMap A K (algebraMap ↥W A σ)) with hr

    have hr0 : 0 < r := zero_lt_iff.mpr (hvne σ hσ0)
    have hr1 : r < 1 := by
      by_contra hcon
      push Not at hcon
      have hd : σ ∣ 1 := hF2 1 σ one_ne_zero hσ0 (by simpa using hcon)
      have := (IsLocalRing.mem_maximalIdeal _).mp hσm
      rw [mem_nonunits_iff] at this
      exact this (isUnit_of_dvd_one hd)

    have hF4 : ∀ (x : ↥W) (j : ℕ), σ ^ j ∣ x →
        (O σ).valuation (algebraMap A K (algebraMap ↥W A x)) ≤ r ^ j := by
      intro x j hx
      obtain ⟨y, rfl⟩ := hx
      rw [map_mul, map_mul, map_mul, map_pow, map_pow, map_pow]
      exact mul_le_of_le_one_right (zero_le) (hF1 _)

    have hrepv : ∀ (G : K) (a1 a2 : ↥W) (Z' Y' : List ↥W) (d' e' : A), G ≠ 0 →
        wcFrfREP W A K 𝔭 t G a1 a2 Z' Y' d' e' → (∀ z ∈ Z' ++ Y', σ ∣ z - c) →
        (O σ).valuation (algebraMap A K (algebraMap ↥W A a2)) * r ^ Y'.length *
            (O σ).valuation G =
          (O σ).valuation (algebraMap A K (algebraMap ↥W A a1)) * r ^ Z'.length := by
      intro G a1 a2 Z' Y' d' e' hG hrep hnr
      obtain ⟨h1, h2⟩ := hVI G a1 a2 Z' Y' d' e' hG hrep
      have hZn : ∀ x ∈ Z', σ ∣ x - c := fun x hx => hnr x (List.mem_append_left _ hx)
      have hYn : ∀ x ∈ Y', σ ∣ x - c := fun x hx => hnr x (List.mem_append_right _ hx)
      rw [hPnear σ Z' hZn, hPnear σ Y' hYn] at h1 h2
      have hne1 : algebraMap A K (algebraMap ↥W A (a2 * σ ^ Y'.length)) * G ≠ 0 :=
        mul_ne_zero (hF0' _ (mul_ne_zero hrep.2.1 (pow_ne_zero _ hσ0))) hG
      have hne2 : algebraMap A K (algebraMap ↥W A (a1 * σ ^ Z'.length)) ≠ 0 :=
        hF0' _ (mul_ne_zero hrep.1 (pow_ne_zero _ hσ0))
      have := hveq _ _ hne1 hne2 h1 h2
      simp only [map_mul, map_pow, ← hr] at this
      exact this

    have h1p : (1 : A) ∉ 𝔭 := (Ideal.ne_top_iff_one 𝔭).mp hPD.2.2.2.1.ne_top
    have hvU : (O σ).valuation (algebraMap A K (t - algebraMap ↥W A c)) = r := by
      have hrep : wcFrfREP W A K 𝔭 t (algebraMap A K (t - algebraMap ↥W A c)) 1 1 [c] [] 1 1 := by
        refine ⟨one_ne_zero, one_ne_zero, h1p, h1p, ?_, ?_⟩
        · intro z hz
          simp only [List.cons_append, List.nil_append, List.mem_singleton] at hz
          rw [hz]; exact hc
        · simp
      have := hrepv _ 1 1 [c] [] 1 1 hU hrep (by simp)
      simpa using this

    have hvε : ∀ ε : A, ε ∉ 𝔭 → (O σ).valuation (algebraMap A K ε) = 1 := by
      intro ε hε
      have hε0 : algebraMap A K ε ≠ 0 := by
        intro h0
        apply hε
        rw [(map_eq_zero_iff _ (IsFractionRing.injective A K)).mp h0]
        exact Ideal.zero_mem _
      have hrep : wcFrfREP W A K 𝔭 t (algebraMap A K ε) 1 1 [] [] 1 ε := by
        refine ⟨one_ne_zero, one_ne_zero, h1p, hε, ?_, ?_⟩
        · intro z hz; simp at hz
        · simp
      have := hrepv _ 1 1 [] [] 1 ε hε0 hrep (by simp)
      simpa using this

    have hbr : ∀ (j : ℕ) (ε g' : A), j ≤ n + k → ε ∉ 𝔭 →
        (O σ).valuation (algebraMap A K ((t - algebraMap ↥W A c) ^ j * ε +
          algebraMap ↥W A w * g')) = r ^ j := by
      intro j ε g' hj hε
      rw [map_add]
      have hfirst : (O σ).valuation (algebraMap A K ((t - algebraMap ↥W A c) ^ j * ε)) = r ^ j := by
        rw [map_mul, map_pow, Valuation.map_mul, Valuation.map_pow, hvU, hvε ε hε, mul_one]
      have hsecond : (O σ).valuation (algebraMap A K (algebraMap ↥W A w * g')) < r ^ j := by
        rw [map_mul, Valuation.map_mul]
        calc (O σ).valuation (algebraMap A K (algebraMap ↥W A w)) *
              (O σ).valuation (algebraMap A K g')
            ≤ r ^ (n + k + 1) * 1 := mul_le_mul' (hF4 w _ hσw) (hF1 g')
          _ = r ^ (n + k + 1) := mul_one _
          _ < r ^ j := pow_lt_pow_right_of_lt_one₀ hr0 hr1 (by omega)
      rw [Valuation.map_add_eq_of_lt_left _ (hfirst ▸ hsecond), hfirst]
    have hB1 := hbr n ε₁ g₁ (by omega) hε₁
    have hB0 := hbr k ε₀ g₀ (by omega) hε₀

    have hF8 := congrArg (O σ).valuation hI'
    rw [Valuation.map_mul, Valuation.map_mul, Valuation.map_mul, hB1, hB0] at hF8

    have hRF := hrepv _ k1 k2 Z Y d e hF0 hR hnear
    have hkey : (O σ).valuation (algebraMap A K (algebraMap ↥W A (k2 * lam₁ * σ ^ (Y.length + k)))) =
        (O σ).valuation (algebraMap A K (algebraMap ↥W A (k1 * lam₂ * σ ^ (Z.length + n)))) := by
      simp only [map_mul, map_pow, Valuation.map_mul, Valuation.map_pow]
      rw [← hr]
      calc (O σ).valuation (algebraMap A K (algebraMap ↥W A k2)) *
            (O σ).valuation (algebraMap A K (algebraMap ↥W A lam₁)) * r ^ (Y.length + k)
          = (O σ).valuation (algebraMap A K (algebraMap ↥W A k2)) * r ^ Y.length *
            ((O σ).valuation (algebraMap A K (algebraMap ↥W A lam₁)) * r ^ k) := by
            rw [pow_add]; ac_rfl
        _ = (O σ).valuation (algebraMap A K (algebraMap ↥W A k2)) * r ^ Y.length *
            ((O σ).valuation (f₀ - (h ^ ℓ - h)) * r ^ n *
              (O σ).valuation (algebraMap A K (algebraMap ↥W A lam₂))) := by rw [hF8]
        _ = ((O σ).valuation (algebraMap A K (algebraMap ↥W A k2)) * r ^ Y.length *
            (O σ).valuation (f₀ - (h ^ ℓ - h))) * r ^ n *
              (O σ).valuation (algebraMap A K (algebraMap ↥W A lam₂)) := by ac_rfl
        _ = (O σ).valuation (algebraMap A K (algebraMap ↥W A k1)) * r ^ Z.length * r ^ n *
              (O σ).valuation (algebraMap A K (algebraMap ↥W A lam₂)) := by rw [hRF]
        _ = (O σ).valuation (algebraMap A K (algebraMap ↥W A k1)) *
            (O σ).valuation (algebraMap A K (algebraMap ↥W A lam₂)) * r ^ (Z.length + n) := by
            rw [pow_add]; ac_rfl
    have hne1 : k2 * lam₁ * σ ^ (Y.length + k) ≠ 0 :=
      mul_ne_zero (mul_ne_zero hk2 hl1) (pow_ne_zero _ hσ0)
    have hne2 : k1 * lam₂ * σ ^ (Z.length + n) ≠ 0 :=
      mul_ne_zero (mul_ne_zero hk1 hl2) (pow_ne_zero _ hσ0)
    exact ⟨hF2 _ _ hne2 hne1 hkey.symm.le, hF2 _ _ hne1 hne2 hkey.le⟩

  refine ⟨ρ₀, hρ₀m, hρ₀0, h, k1, k2, Z, Y, d, e, hR, ?_⟩
  intro ρ hρm hρ0 hI0 _
  obtain ⟨hρρ₀, _⟩ := hI0
  obtain ⟨ρ', hρ'm, hρ'0, hρ'sq⟩ := hroot ρ hρm hρ0 1
  have hρ'ρ : ρ' ∣ ρ := by
    rw [← hρ'sq]
    exact dvd_pow_self _ (by norm_num)
  have hρ'nu : ¬ IsUnit ρ' := by
    have := (IsLocalRing.mem_maximalIdeal _).mp hρ'm
    rwa [mem_nonunits_iff] at this
  obtain ⟨hw1, _, hn1⟩ := hdivs ρ hρρ₀
  obtain ⟨hw2, _, hn2⟩ := hdivs ρ' (hρ'ρ.trans hρρ₀)
  have G1 := hgauss ρ hρm hρ0 hw1 hn1
  have G2 := hgauss ρ' hρ'm hρ'0 hw2 hn2
  rw [← hρ'sq, ← pow_mul, ← pow_mul] at G1
  obtain ⟨hpq, hab⟩ := hexp (k2 * lam₁) (k1 * lam₂) ρ' (Y.length + k) (Z.length + n)
    (mul_ne_zero hk2 hl1) hρ'0 hρ'nu G2.1 G2.2 G1.1 G1.2

  have hZn : ∀ x ∈ Z, ρ ∣ x - c := fun x hx => hn1 x (List.mem_append_left _ hx)
  have hYn : ∀ x ∈ Y, ρ ∣ x - c := fun x hx => hn1 x (List.mem_append_right _ hx)
  have hM : wcFrfM W c ρ Z Y = (k : ℤ) - n := by
    unfold wcFrfM
    rw [hfilt1 ρ Z hZn, hfilt1 ρ Y hYn]
    omega
  unfold wcFrfGood
  rw [hPnear ρ Z hZn, hPnear ρ Y hYn, hM]
  rcases hD' with ⟨⟨μ, hμ⟩, hnk | ⟨lam', hl', hlS⟩⟩ | hnd
  · left
    have hk : k2 * μ ∣ k1 := by
      rw [hμ] at hab
      have : k2 * μ * lam₂ ∣ k1 * lam₂ := by
        have e : k2 * (lam₂ * μ) = k2 * μ * lam₂ := by ring
        rw [← e]; exact hab
      exact (mul_dvd_mul_iff_right hl2).mp this
    exact mul_dvd_mul (dvd_of_mul_right_dvd hk) (pow_dvd_pow ρ (by omega))
  · left
    have hμ' : μ = lam' := mul_left_cancel₀ hl2 (hμ.symm.trans hl')
    have hk : k2 * lam' ∣ k1 := by
      rw [hμ, hμ'] at hab
      have : k2 * lam' * lam₂ ∣ k1 * lam₂ := by
        have e : k2 * (lam₂ * lam') = k2 * lam' * lam₂ := by ring
        rw [← e]; exact hab
      exact (mul_dvd_mul_iff_right hl2).mp this
    have hρn : ρ ^ n ∣ lam' := by
      obtain ⟨_, hS1, _⟩ := hdivs ρ hρρ₀
      exact ((pow_dvd_pow ρ (by omega : n ≤ n + k + 1)).trans hS1).trans hlS
    calc k2 * ρ ^ Y.length ∣ k2 * (ρ ^ n * ρ ^ Z.length) :=
          mul_dvd_mul_left _ (by rw [← pow_add]; exact pow_dvd_pow ρ (by omega))
      _ ∣ k2 * (lam' * ρ ^ Z.length) := mul_dvd_mul_left _ (mul_dvd_mul_right hρn _)
      _ = k2 * lam' * ρ ^ Z.length := by ring
      _ ∣ k1 * ρ ^ Z.length := mul_dvd_mul_right hk _
  · right
    exact hnd

theorem wcFrf_end_right : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ (α : L) (f₀ : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α →
    ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ O : ↥W → ValuationSubring K, wcFrfVAL W A K 𝔭 t c O →
    ∀ a : ↥W, a ∈ IsLocalRing.maximalIdeal ↥W → a ≠ 0 →
    ∃ ρ' : ↥W, ρ' ∈ IsLocalRing.maximalIdeal ↥W ∧ ρ' ≠ 0 ∧
      wcFrfMem W A K 𝔭 t ℓ f₀ c (fun ρ => a ∣ ρ ∧ ¬ ρ ∣ a ∧ ρ ∣ a * ρ' ∧ ¬ a * ρ' ∣ ρ) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD hdeg α f₀ hα1 hf₀
    c hc O hO a ha ha0
  classical
  have hΩ : ((ℓ : ℕ) : Ω) = 0 := by
    rw [← hchar]
    exact ringChar.Nat.cast_ringChar
  have hWl : ((ℓ : ℕ) : ↥W) = 0 := by
    apply Subtype.ext
    simpa using hΩ
  have hK : ((ℓ : ℕ) : K) = 0 := by
    have e : ((ℓ : ℕ) : K) = algebraMap A K (algebraMap ↥W A ((ℓ : ℕ) : ↥W)) := by
      rw [map_natCast, map_natCast]
    rw [e, hWl, map_zero, map_zero]
  have hL : ((ℓ : ℕ) : L) = 0 := by
    rw [← map_natCast (algebraMap K L), hK, map_zero]
  have : Fact ℓ.Prime := ⟨hℓ⟩
  have : CharP L ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hL

  have hroot : ∀ g : ↥W, g ∈ IsLocalRing.maximalIdeal ↥W → g ≠ 0 → ∀ N : ℕ,
      ∃ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W ∧ x ≠ 0 ∧ x ^ (N + 1) = g := by
    intro g hgm hg0 N
    obtain ⟨y, hy⟩ := IsAlgClosed.exists_pow_nat_eq (g : Ω) (Nat.succ_pos N)
    have hy0 : y ≠ 0 := by
      rintro rfl
      apply hg0
      apply Subtype.ext
      rw [← hy]
      simp
    have hyW : y ∈ W := by
      rcases W.mem_or_inv_mem y with h | h
      · exact h
      · have e : y = (g : Ω) * (y⁻¹) ^ N := by
          rw [← hy, inv_pow, pow_succ]
          field_simp
        rw [e]
        exact mul_mem g.2 (pow_mem h N)
    have hxg : (⟨y, hyW⟩ : ↥W) ^ (N + 1) = g := by
      apply Subtype.ext
      simp [hy]
    refine ⟨⟨y, hyW⟩, ?_, ?_, hxg⟩
    · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have := (IsLocalRing.mem_maximalIdeal _).mp hgm
      rw [mem_nonunits_iff] at this
      apply this
      rw [← hxg]
      exact hu.pow _
    · intro h0
      apply hy0
      have := congrArg Subtype.val h0
      simpa using this

  have hcommon : ∀ S : List ↥W, (∀ s ∈ S, s ∈ IsLocalRing.maximalIdeal ↥W) →
      ∃ g : ↥W, g ∈ IsLocalRing.maximalIdeal ↥W ∧ g ≠ 0 ∧ ∀ s ∈ S, g ∣ s := by
    intro S
    induction S with
    | nil => intro _; exact ⟨a, ha, ha0, by simp⟩
    | cons s S ih =>
      intro hS
      obtain ⟨g, hgm, hg0, hgS⟩ := ih (fun x hx => hS x (List.mem_cons_of_mem _ hx))
      by_cases hs0 : s = 0
      · refine ⟨g, hgm, hg0, ?_⟩
        intro x hx
        rcases List.mem_cons.mp hx with h | hx
        · rw [h, hs0]; exact dvd_zero _
        · exact hgS x hx
      · rcases ValuationRing.dvd_total g s with hgs | hsg
        · refine ⟨g, hgm, hg0, ?_⟩
          intro x hx
          rcases List.mem_cons.mp hx with h | hx
          · rw [h]; exact hgs
          · exact hgS x hx
        · refine ⟨s, hS s (by simp), hs0, ?_⟩
          intro x hx
          rcases List.mem_cons.mp hx with h | hx
          · rw [h]
          · exact hsg.trans (hgS x hx)

  have hexp : ∀ (a b σ : ↥W) (p q : ℕ), a ≠ 0 → σ ≠ 0 → ¬ IsUnit σ →
      a * σ ^ p ∣ b * σ ^ q → b * σ ^ q ∣ a * σ ^ p →
      a * σ ^ (2 * p) ∣ b * σ ^ (2 * q) → b * σ ^ (2 * q) ∣ a * σ ^ (2 * p) →
      p = q ∧ a ∣ b := by
    intro a b σ p q ha hσ hnu h1a h1b h2a h2b
    have h1 := associated_of_dvd_dvd h1a h1b
    have h2 := associated_of_dvd_dvd h2a h2b
    rw [two_mul, two_mul, pow_add, pow_add, ← mul_assoc, ← mul_assoc] at h2
    have h3 : Associated (σ ^ p) (σ ^ q) :=
      h2.of_mul_left h1 (mul_ne_zero ha (pow_ne_zero _ hσ))
    have hpq : p = q := le_antisymm ((pow_dvd_pow_iff hσ hnu).mp h3.dvd)
      ((pow_dvd_pow_iff hσ hnu).mp h3.symm.dvd)
    subst hpq
    exact ⟨rfl, (h1.of_mul_right (Associated.refl _) (pow_ne_zero _ hσ)).dvd⟩

  have hne : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
    intro x hx h0
    obtain ⟨_, hVII, _⟩ := hO a ha ha0
    have hd := hVII 1 x one_ne_zero hx (by rw [h0, div_zero]; exact (O a).zero_mem)
    have hu : IsUnit x := isUnit_of_dvd_one hd
    exact ((hu.map (algebraMap ↥W A)).map (algebraMap A K)).ne_zero h0
  have h1p : (1 : A) ∉ 𝔭 := (Ideal.ne_top_iff_one 𝔭).mp hPD.2.2.2.1.ne_top

  obtain ⟨A'', _, _, _, _, _, _, _, t', 𝔭'', hBr, ht', hPD'', -⟩ :=
    wcpa_dj_llsm_br_residue_chart Ω W hW hWt A K L 𝔭 t c a hPD hc ha ha0
  obtain ⟨hs0, h, lam₁, lam₂, w, n, k, ε₀, ε₁, g₀, g₁, hl1, hl2, hw, hε₀, hε₁, hI, hD⟩ :=
    wcLlsAS_dse_boundary_form Ω W hW hWt ℓ hℓ A'' K L 𝔭'' t' hPD'' hK α f₀ hα1 hf₀.symm 0
      (Ideal.zero_mem _)
  simp only [map_zero, sub_zero] at hs0 hI
  set s : K := algebraMap A K (t - algebraMap ↥W A c) / algebraMap A K (algebraMap ↥W A a)
    with hs_def
  unfold wcLlsBrSub at hBr
  obtain ⟨hBr1, hBr2, hBr3⟩ := hBr
  have h1p'' : (1 : A'') ∉ 𝔭'' := (Ideal.ne_top_iff_one 𝔭'').mp hPD''.2.2.2.1.ne_top
  have ht'p : t' ∈ 𝔭'' := hPD''.2.2.2.2.2.1
  have hmapp : ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → algebraMap ↥W A'' x ∈ 𝔭'' :=
    fun x hx => hPD''.2.2.2.2.1 (Ideal.mem_map_of_mem _ hx)
  have hφt : algebraMap A K t = algebraMap A K (algebraMap ↥W A a) * s +
      algebraMap A K (algebraMap ↥W A c) := by
    rw [hs_def, mul_div_cancel₀ _ (hne a ha0), map_sub]
    ring
  have hU0 : algebraMap A K (t - algebraMap ↥W A c) ≠ 0 := by
    intro h0; apply hs0; rw [ht', hs_def, h0, zero_div]
  have hsR : s ∈ Algebra.adjoin A {s} := Algebra.subset_adjoin (Set.mem_singleton s)
  set I : Ideal ↥(Algebra.adjoin A {s}) := Ideal.span (Subtype.val ⁻¹' ({s} ∪
    (fun w : ↥W => algebraMap A K (algebraMap ↥W A w)) '' ↑(IsLocalRing.maximalIdeal ↥W)))
    with hIdef
  have hsI : (⟨s, hsR⟩ : ↥(Algebra.adjoin A {s})) ∈ I := Ideal.subset_span (Or.inl rfl)
  have hwI : ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W →
      algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A x) ∈ I :=
    fun x hx => Ideal.subset_span (Or.inr ⟨x, hx, rfl⟩)
  have hpI : ∀ b ∈ 𝔭, algebraMap A ↥(Algebra.adjoin A {s}) b ∈ I := by
    have hP := hPD.2.2.2.2.2.2.1
    have hle : 𝔭 ≤ I.comap (algebraMap A ↥(Algebra.adjoin A {s})) := by
      rw [hP]
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro x hx
        rw [Set.mem_singleton_iff] at hx
        rw [hx]
        show algebraMap A ↥(Algebra.adjoin A {s}) t ∈ I
        have het : algebraMap A ↥(Algebra.adjoin A {s}) t =
            algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A a) * ⟨s, hsR⟩ +
              algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A c) :=
          Subtype.ext hφt
        rw [het]
        exact add_mem (Ideal.mul_mem_left _ _ hsI) (hwI c hc)
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        exact hwI x hx
    exact fun b hb => hle hb
  have hdec : ∀ y ∈ Algebra.adjoin A {s}, ∃ y₁ ∈ Algebra.adjoin A {s}, ∃ a₀ : A,
      y = s * y₁ + algebraMap A K a₀ := by
    intro y hy
    induction hy using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      exact ⟨1, one_mem _, 0, by rw [hx, map_zero]; ring⟩
    | algebraMap r => exact ⟨0, zero_mem _, r, by ring⟩
    | add x y _ _ ihx ihy =>
      obtain ⟨x1, hx1, a1, rfl⟩ := ihx
      obtain ⟨y1, hy1, b1, rfl⟩ := ihy
      exact ⟨x1 + y1, add_mem hx1 hy1, a1 + b1, by rw [map_add]; ring⟩
    | mul x y _ _ ihx ihy =>
      obtain ⟨x1, hx1, a1, rfl⟩ := ihx
      obtain ⟨y1, hy1, b1, rfl⟩ := ihy
      refine ⟨s * x1 * y1 + x1 * algebraMap A K b1 + algebraMap A K a1 * y1, ?_, a1 * b1,
        by rw [map_mul]; ring⟩
      exact add_mem (add_mem (mul_mem (mul_mem hsR hx1) hy1)
        (mul_mem hx1 (Subalgebra.algebraMap_mem _ _))) (mul_mem (Subalgebra.algebraMap_mem _ _) hy1)
  have hdecI : ∀ y : ↥(Algebra.adjoin A {s}), y ∉ I → ∃ y₁ ∈ Algebra.adjoin A {s}, ∃ a₀ : A,
      a₀ ∉ 𝔭 ∧ (y : K) = s * y₁ + algebraMap A K a₀ := by
    intro y hyI
    obtain ⟨y1, hy1, a0, hya⟩ := hdec y y.2
    refine ⟨y1, hy1, a0, ?_, hya⟩
    intro ha0'
    apply hyI
    have : y = ⟨s, hsR⟩ * ⟨y1, hy1⟩ + algebraMap A ↥(Algebra.adjoin A {s}) a0 := Subtype.ext hya
    rw [this]
    exact add_mem (Ideal.mul_mem_right _ _ hsI) (hpI a0 ha0')
  have hIJ : ∀ y ∈ I, ∃ b ∈ 𝔭'', algebraMap A'' K b = (y : K) := by
    intro y hy
    induction hy using Submodule.span_induction with
    | mem x hx =>
      rcases hx with hx | ⟨w', hw', hx⟩
      · exact ⟨t', ht'p, by rw [ht']; exact hx.symm⟩
      · exact ⟨algebraMap ↥W A'' w', hmapp w' hw', by rw [hBr1]; exact hx⟩
    | zero => exact ⟨0, zero_mem _, by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨b, hb, hbx⟩ := hx
      obtain ⟨b', hb', hby⟩ := hy
      exact ⟨b + b', add_mem hb hb', by rw [map_add, hbx, hby]; rfl⟩
    | smul r x _ hx =>
      obtain ⟨b, hb, hbx⟩ := hx
      obtain ⟨r'', hr''⟩ := hBr2 r.2
      exact ⟨r'' * b, Ideal.mul_mem_left _ _ hb, by rw [map_mul, hr'', hbx]; rfl⟩
  have hnotJ : ∀ y : ↥(Algebra.adjoin A {s}), y ∉ I → ∀ b ∈ 𝔭'',
      algebraMap A'' K b ≠ (y : K) := by
    intro y hyI b hb hby
    obtain ⟨y1, hy1, a0, ha0', hya⟩ := hdecI y hyI
    obtain ⟨r, i, hi, hri⟩ := hPD.2.2.2.1.exists_inv ha0'
    obtain ⟨bi, hbi, hbi'⟩ := hIJ _ (hpI i hi)
    have hbi2 : algebraMap A'' K bi = algebraMap A K i := hbi'
    obtain ⟨y1'', hy1''⟩ := hBr2 hy1
    obtain ⟨r'', hr''⟩ := hBr2 (Subalgebra.algebraMap_mem (Algebra.adjoin A {s}) r)
    have hr2 : algebraMap A'' K r'' = algebraMap A K r := hr''
    have h1 : algebraMap A K (r * a0 + i) = 1 := by rw [hri, map_one]
    rw [map_add, map_mul] at h1
    have key : algebraMap A'' K (r'' * (b - t' * y1'') + bi) = algebraMap A'' K 1 := by
      rw [map_add, map_mul, map_sub, map_mul, hr2, hby, ht', hy1'', hbi2, hya, map_one]
      linear_combination h1
    have h2 : r'' * (b - t' * y1'') + bi = 1 := IsFractionRing.injective A'' K key
    apply h1p''
    rw [← h2]
    exact add_mem (Ideal.mul_mem_left _ _ (sub_mem hb (Ideal.mul_mem_right _ _ ht'p))) hbi

  have hI' : (f₀ - (h ^ ℓ - h)) * algebraMap A'' K (t' ^ n * ε₁ + algebraMap ↥W A'' w * g₁) *
        algebraMap A'' K (algebraMap ↥W A'' lam₂) =
      algebraMap A'' K (algebraMap ↥W A'' lam₁) *
        algebraMap A'' K (t' ^ k * ε₀ + algebraMap ↥W A'' w * g₀) := by
    rw [← hI]; ring
  have hF0 : f₀ - (h ^ ℓ - h) ≠ 0 := by
    intro h0
    have e1 : f₀ = h ^ ℓ - h := sub_eq_zero.mp h0
    have e2 : (α - algebraMap K L h) ^ ℓ = α - algebraMap K L h := by
      rw [sub_pow_char]
      have := hf₀
      rw [e1, map_sub, map_pow] at this
      linear_combination (-1 : L) * this
    have hbot := (Subfield.mem_bot_iff_pow_eq_self L ℓ).mpr e2
    obtain ⟨x, hx⟩ := RingHom.mem_fieldRange.mp
      ((bot_le : (⊥ : Subfield L) ≤ (algebraMap K L).fieldRange) hbot)
    exact hα1 ⟨x + h, by rw [map_add, hx]; ring⟩
  obtain ⟨k1, k2, Z, Y, d, e, hR⟩ :=
    wcFrf_rep_exists Ω W hW hWt A K 𝔭 t hPD (f₀ - (h ^ ℓ - h)) hF0
  have hk1 : k1 ≠ 0 := hR.1
  have hk2 : k2 ≠ 0 := hR.2.1

  have hgauss : ∀ τ : ↥W, τ ∈ IsLocalRing.maximalIdeal ↥W → τ ≠ 0 → τ ^ (n + k + 1) ∣ w →
      wcFrfP W c (a * τ) Y ≠ 0 → wcFrfP W c (a * τ) Z ≠ 0 →
      k2 * wcFrfP W c (a * τ) Y * lam₁ * τ ^ k ∣ k1 * wcFrfP W c (a * τ) Z * lam₂ * τ ^ n ∧
        k1 * wcFrfP W c (a * τ) Z * lam₂ * τ ^ n ∣ k2 * wcFrfP W c (a * τ) Y * lam₁ * τ ^ k := by
    intro τ hτm hτ0 hτw hPY hPZ
    have hρm : a * τ ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right τ _ ha
    have hρ0 : a * τ ≠ 0 := mul_ne_zero ha0 hτ0
    obtain ⟨hVI, hVII, hVIV⟩ := hO (a * τ) hρm hρ0
    set V := O (a * τ) with hV
    have hmemle : ∀ x : K, V.valuation x ≤ 1 ↔ x ∈ V := fun x => V.valuation_le_one_iff x
    have hvne : ∀ x : ↥W, x ≠ 0 → V.valuation (algebraMap A K (algebraMap ↥W A x)) ≠ 0 :=
      fun x hx => (V.valuation.ne_zero_iff).mpr (hne x hx)
    have hF1 : ∀ b : A, V.valuation (algebraMap A K b) ≤ 1 := fun b => (hmemle _).mpr (hVIV b)
    have hF2 : ∀ w₁ w₂ : ↥W, w₁ ≠ 0 → w₂ ≠ 0 →
        V.valuation (algebraMap A K (algebraMap ↥W A w₁)) ≤
          V.valuation (algebraMap A K (algebraMap ↥W A w₂)) → w₂ ∣ w₁ := by
      intro w₁ w₂ h1 h2 hle
      apply hVII w₁ w₂ h1 h2
      rw [← hmemle, Valuation.map_div]
      exact (div_le_one₀ (zero_lt_iff.mpr (hvne w₂ h2))).mpr hle
    have hveq : ∀ x y : K, x ≠ 0 → y ≠ 0 → x / y ∈ V → y / x ∈ V →
        V.valuation x = V.valuation y := by
      intro x y hx hy h1 h2
      rw [← hmemle, Valuation.map_div] at h1 h2
      have hx' : 0 < V.valuation x := zero_lt_iff.mpr ((V.valuation.ne_zero_iff).mpr hx)
      have hy' : 0 < V.valuation y := zero_lt_iff.mpr ((V.valuation.ne_zero_iff).mpr hy)
      exact le_antisymm ((div_le_one₀ hy').mp h1) ((div_le_one₀ hx').mp h2)
    set r := V.valuation (algebraMap A K (algebraMap ↥W A τ)) with hr
    have hr0 : 0 < r := zero_lt_iff.mpr (hvne τ hτ0)
    have hr1 : r < 1 := by
      by_contra hcon
      push_neg at hcon
      have hd : τ ∣ 1 := hF2 1 τ one_ne_zero hτ0 (by simpa using hcon)
      have := (IsLocalRing.mem_maximalIdeal _).mp hτm
      rw [mem_nonunits_iff] at this
      exact this (isUnit_of_dvd_one hd)
    have hF4 : ∀ (x : ↥W) (j : ℕ), τ ^ j ∣ x →
        V.valuation (algebraMap A K (algebraMap ↥W A x)) ≤ r ^ j := by
      intro x j hx
      obtain ⟨y, rfl⟩ := hx
      rw [map_mul, map_mul, map_mul, map_pow, map_pow, map_pow]
      exact mul_le_of_le_one_right (zero_le) (hF1 _)
    have hvA : ∀ b : A, b ∉ 𝔭 → V.valuation (algebraMap A K b) = 1 := by
      intro b hb
      have hb0 : algebraMap A K b ≠ 0 := by
        intro h0
        apply hb
        rw [(map_eq_zero_iff _ (IsFractionRing.injective A K)).mp h0]
        exact Ideal.zero_mem _
      have hrep : wcFrfREP W A K 𝔭 t (algebraMap A K b) 1 1 [] [] 1 b := by
        refine ⟨one_ne_zero, one_ne_zero, h1p, hb, ?_, ?_⟩
        · intro z hz; simp at hz
        · simp
      obtain ⟨h1, h2⟩ := hVI _ 1 1 [] [] 1 b hb0 hrep
      have hP0 : wcFrfP W c (a * τ) [] = 1 := by simp [wcFrfP]
      rw [hP0] at h1 h2
      have := hveq _ _ (by simpa using hb0) (by simp) h1 h2
      simpa using this
    have hvU : V.valuation (algebraMap A K (t - algebraMap ↥W A c)) =
        V.valuation (algebraMap A K (algebraMap ↥W A a)) * r := by
      have hrep : wcFrfREP W A K 𝔭 t (algebraMap A K (t - algebraMap ↥W A c)) 1 1 [c] [] 1 1 := by
        refine ⟨one_ne_zero, one_ne_zero, h1p, h1p, ?_, ?_⟩
        · intro z hz
          simp only [List.cons_append, List.nil_append, List.mem_singleton] at hz
          rw [hz]; exact hc
        · simp
      obtain ⟨h1, h2⟩ := hVI _ 1 1 [c] [] 1 1 hU0 hrep
      have hPc : wcFrfP W c (a * τ) [c] = a * τ := by simp [wcFrfP]
      have hP0 : wcFrfP W c (a * τ) [] = 1 := by simp [wcFrfP]
      rw [hPc, hP0] at h1 h2
      have := hveq _ _ (by simpa using hU0) (by simpa using hne _ hρ0) h1 h2
      simp only [one_mul, map_one, map_mul, Valuation.map_mul] at this
      exact this
    have hvs : V.valuation s = r := by
      rw [hs_def, Valuation.map_div, hvU, mul_div_cancel_left₀ _ (hvne a ha0)]
    have hsV : s ∈ V := (hmemle s).mp (hvs ▸ hr1.le)
    have hRV : ∀ y ∈ Algebra.adjoin A {s}, y ∈ V := by
      intro y hy
      induction hy using Algebra.adjoin_induction with
      | mem x hx => rw [Set.mem_singleton_iff] at hx; rw [hx]; exact hsV
      | algebraMap r => exact hVIV r
      | add x y _ _ hx hy => exact add_mem hx hy
      | mul x y _ _ hx hy => exact mul_mem hx hy
    have hT4 : ∀ y : ↥(Algebra.adjoin A {s}), y ∉ I → V.valuation (y : K) = 1 := by
      intro y hyI
      obtain ⟨y1, hy1, a0, ha0', hya⟩ := hdecI y hyI
      have hlt : V.valuation (s * y1) < V.valuation (algebraMap A K a0) := by
        rw [hvA a0 ha0', Valuation.map_mul, hvs]
        calc r * V.valuation y1 ≤ r * 1 := mul_le_mul_right ((hmemle _).mpr (hRV y1 hy1)) r
          _ < 1 := by rw [mul_one]; exact hr1
      rw [hya, add_comm, Valuation.map_add_eq_of_lt_left _ hlt, hvA a0 ha0']
    have hT5 : ∀ x : A'', V.valuation (algebraMap A'' K x) ≤ 1 := by
      intro x
      obtain ⟨p, q, hq, hpq⟩ := hBr3 (algebraMap A'' K x) ⟨x, rfl⟩
      have h1 := congrArg V.valuation hpq
      rw [Valuation.map_mul, hT4 q hq, mul_one] at h1
      rw [h1]
      exact (hmemle _).mpr (hRV p p.2)
    have hT6 : ∀ ε : A'', ε ∉ 𝔭'' → V.valuation (algebraMap A'' K ε) = 1 := by
      intro ε hε
      obtain ⟨p, q, hq, hpq⟩ := hBr3 (algebraMap A'' K ε) ⟨ε, rfl⟩
      have hpI' : p ∉ I := by
        intro hp
        obtain ⟨b, hb, hbp⟩ := hIJ p hp
        obtain ⟨q'', hq''⟩ := hBr2 q.2
        have h3 : ε * q'' = b := IsFractionRing.injective A'' K (by rw [map_mul, hq'', hbp, hpq])
        have hb' : ε * q'' ∈ 𝔭'' := by rw [h3]; exact hb
        rcases hPD''.2.2.2.1.isPrime.mem_or_mem hb' with h4 | h4
        · exact hε h4
        · exact hnotJ q hq q'' h4 hq''
      have h1 := congrArg V.valuation hpq
      rw [Valuation.map_mul, hT4 q hq, hT4 p hpI', mul_one] at h1
      exact h1
    have hbr : ∀ (j : ℕ) (ε g' : A''), j ≤ n + k → ε ∉ 𝔭'' →
        V.valuation (algebraMap A'' K (t' ^ j * ε + algebraMap ↥W A'' w * g')) = r ^ j := by
      intro j ε g' hj hε
      rw [map_add]
      have hfirst : V.valuation (algebraMap A'' K (t' ^ j * ε)) = r ^ j := by
        rw [map_mul, map_pow, Valuation.map_mul, Valuation.map_pow, ht', hvs, hT6 ε hε, mul_one]
      have hsecond : V.valuation (algebraMap A'' K (algebraMap ↥W A'' w * g')) < r ^ j := by
        rw [map_mul, Valuation.map_mul, hBr1]
        calc V.valuation (algebraMap A K (algebraMap ↥W A w)) *
              V.valuation (algebraMap A'' K g')
            ≤ r ^ (n + k + 1) * 1 := mul_le_mul' (hF4 w _ hτw) (hT5 g')
          _ = r ^ (n + k + 1) := mul_one _
          _ < r ^ j := pow_lt_pow_right_of_lt_one₀ hr0 hr1 (by omega)
      rw [Valuation.map_add_eq_of_lt_left _ (hfirst ▸ hsecond), hfirst]
    have hB1 := hbr n ε₁ g₁ (by omega) hε₁
    have hB0 := hbr k ε₀ g₀ (by omega) hε₀
    have hI2 := congrArg V.valuation hI'
    simp only [Valuation.map_mul] at hI2
    rw [hB1, hB0, hBr1, hBr1] at hI2
    obtain ⟨h1, h2⟩ := hVI _ k1 k2 Z Y d e hF0 hR
    have hRF := hveq _ _ (mul_ne_zero (hne _ (mul_ne_zero hk2 hPY)) hF0)
      (hne _ (mul_ne_zero hk1 hPZ)) h1 h2
    simp only [map_mul, Valuation.map_mul] at hRF
    have hkey : V.valuation (algebraMap A K (algebraMap ↥W A
          (k2 * wcFrfP W c (a * τ) Y * lam₁ * τ ^ k))) =
        V.valuation (algebraMap A K (algebraMap ↥W A
          (k1 * wcFrfP W c (a * τ) Z * lam₂ * τ ^ n))) := by
      simp only [map_mul, map_pow, Valuation.map_mul, Valuation.map_pow]
      rw [← hr, mul_assoc _ _ (r ^ k), ← hI2, ← hRF]
      ac_rfl
    have hne1 : k2 * wcFrfP W c (a * τ) Y * lam₁ * τ ^ k ≠ 0 :=
      mul_ne_zero (mul_ne_zero (mul_ne_zero hk2 hPY) hl1) (pow_ne_zero _ hτ0)
    have hne2 : k1 * wcFrfP W c (a * τ) Z * lam₂ * τ ^ n ≠ 0 :=
      mul_ne_zero (mul_ne_zero (mul_ne_zero hk1 hPZ) hl2) (pow_ne_zero _ hτ0)
    exact ⟨hF2 _ _ hne2 hne1 hkey.symm.le, hF2 _ _ hne1 hne2 hkey.le⟩

  obtain ⟨lamS, hlamSm, hD'⟩ : ∃ lamS : ↥W, lamS ∈ IsLocalRing.maximalIdeal ↥W ∧
      ((lam₂ ∣ lam₁ ∧ (n ≤ k ∨ ∃ lam' : ↥W, lam₁ = lam₂ * lam' ∧ lamS ∣ lam')) ∨
        ¬ (ℓ : ℤ) ∣ ((k : ℤ) - n)) := by
    rcases hD with ⟨hdv, hnk | ⟨lam', hl', hl'm⟩⟩ | hnd
    · exact ⟨0, Ideal.zero_mem _, Or.inl ⟨hdv, Or.inl hnk⟩⟩
    · exact ⟨lam', hl'm, Or.inl ⟨hdv, Or.inr ⟨lam', hl', dvd_rfl⟩⟩⟩
    · exact ⟨0, Ideal.zero_mem _, Or.inr hnd⟩

  have hμ : ∀ z : ↥W, ∃ μ : ↥W, μ ∈ IsLocalRing.maximalIdeal ↥W ∧
      (¬ (z - c ∣ a) → z - c = a * μ) := by
    intro z
    by_cases hz : z - c ∣ a
    · exact ⟨0, Ideal.zero_mem _, fun h' => absurd hz h'⟩
    · obtain ⟨μ, hμ⟩ := (ValuationRing.dvd_total a (z - c)).resolve_right hz
      refine ⟨μ, ?_, fun _ => hμ⟩
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      apply hz
      rw [hμ]
      exact hu.mul_right_dvd.mpr dvd_rfl
  choose μ hμm hμe using hμ
  have hSm : ∀ x ∈ w :: lamS :: (Z ++ Y).map μ, x ∈ IsLocalRing.maximalIdeal ↥W := by
    intro x hx
    rcases List.mem_cons.mp hx with h1 | hx
    · rw [h1]; exact hw
    rcases List.mem_cons.mp hx with h1 | hx
    · rw [h1]; exact hlamSm
    obtain ⟨z, _, rfl⟩ := List.mem_map.mp hx
    exact hμm z
  obtain ⟨g, hgm, hg0, hgS⟩ := hcommon _ hSm
  obtain ⟨ρ', hρ'm, hρ'0, hρ'g⟩ := hroot g hgm hg0 (n + k)
  have hwin : ∀ z ∈ Z ++ Y, z - c ∣ a ∨ a * ρ' ∣ z - c := by
    intro z hz
    by_cases h1 : z - c ∣ a
    · exact Or.inl h1
    right
    rw [hμe z h1]
    apply mul_dvd_mul_left
    have hg : ρ' ^ (n + k + 1) ∣ μ z := by
      rw [hρ'g]
      exact hgS (μ z) (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
        (List.mem_map.mpr ⟨z, hz, rfl⟩)))
    exact (dvd_pow_self ρ' (by omega : n + k + 1 ≠ 0)).trans hg
  have hdivs : ∀ τ : ↥W, τ ∣ ρ' → τ ^ (n + k + 1) ∣ w ∧ τ ^ (n + k + 1) ∣ lamS := by
    intro τ hτ
    have h1 : τ ^ (n + k + 1) ∣ g := by rw [← hρ'g]; exact pow_dvd_pow_of_dvd hτ _
    exact ⟨h1.trans (hgS w (by simp)), h1.trans (hgS lamS (by simp))⟩

  have hkeyw : ∀ τ : ↥W, ¬ IsUnit τ → τ ∣ ρ' → ∀ x ∈ Z ++ Y,
      (a * τ ∣ x - c ↔ ¬ (x - c ∣ a)) := by
    intro τ hτu hτρ x hx
    constructor
    · rintro h1 h2
      obtain ⟨r0, hr0⟩ := h1.trans h2
      apply hτu
      have h1' : τ * r0 = 1 := mul_left_cancel₀ ha0 (by rw [mul_one, ← mul_assoc, ← hr0])
      exact ⟨⟨τ, r0, h1', by rw [mul_comm]; exact h1'⟩, rfl⟩
    · intro h'
      exact (mul_dvd_mul_left a hτρ).trans ((hwin x hx).resolve_left h')
  have hshape : ∀ τ : ↥W, ¬ IsUnit τ → τ ∣ ρ' → ∀ X : List ↥W, (∀ x ∈ X, x ∈ Z ++ Y) →
      wcFrfP W c (a * τ) X = ((X.filter (fun x => decide (x - c ∣ a))).map
          (fun x => x - c)).prod * (a * τ) ^ (X.filter (fun x => decide (¬ (x - c ∣ a)))).length ∧
        X.filter (fun x => @decide (a * τ ∣ x - c) (Classical.propDecidable _)) =
          X.filter (fun x => decide (¬ (x - c ∣ a))) := by
    intro τ hτu hτρ X hX
    have e1 : X.filter (fun x => @decide (¬ a * τ ∣ x - c) (Classical.propDecidable _)) =
        X.filter (fun x => decide (x - c ∣ a)) := by
      apply List.filter_congr
      intro x hx
      have hk := hkeyw τ hτu hτρ x (hX x hx)
      by_cases h1 : x - c ∣ a
      · have h2 : ¬ a * τ ∣ x - c := fun h3 => (hk.mp h3) h1
        simp [h1, h2]
      · have h2 : a * τ ∣ x - c := hk.mpr h1
        simp [h1, h2]
    have e2 : X.filter (fun x => @decide (a * τ ∣ x - c) (Classical.propDecidable _)) =
        X.filter (fun x => decide (¬ (x - c ∣ a))) := by
      apply List.filter_congr
      intro x hx
      have hk := hkeyw τ hτu hτρ x (hX x hx)
      by_cases h1 : x - c ∣ a
      · have h2 : ¬ a * τ ∣ x - c := fun h3 => (hk.mp h3) h1
        simp [h1, h2]
      · have h2 : a * τ ∣ x - c := hk.mpr h1
        simp [h1, h2]
    refine ⟨?_, e2⟩
    unfold wcFrfP
    rw [e1, e2]
  have hCne : ∀ X : List ↥W,
      ((X.filter (fun x => decide (x - c ∣ a))).map (fun x => x - c)).prod ≠ 0 := by
    intro X
    apply List.prod_ne_zero
    intro h0
    obtain ⟨x, hx, hx0⟩ := List.mem_map.mp h0
    have hd : x - c ∣ a := by simpa using (List.mem_filter.mp hx).2
    rw [hx0] at hd
    exact ha0 (zero_dvd_iff.mp hd)
  have hsubZ : ∀ x ∈ Z, x ∈ Z ++ Y := fun x hx => List.mem_append_left _ hx
  have hsubY : ∀ x ∈ Y, x ∈ Z ++ Y := fun x hx => List.mem_append_right _ hx

  refine ⟨ρ', hρ'm, hρ'0, h, k1, k2, Z, Y, d, e, hR, ?_⟩
  intro ρ _ hρ0 hIρ _
  obtain ⟨⟨σ, rfl⟩, hnρa, hρaρ', -⟩ := hIρ
  have hσρ' : σ ∣ ρ' := (mul_dvd_mul_iff_left ha0).mp hρaρ'
  have hσ0 : σ ≠ 0 := right_ne_zero_of_mul hρ0
  have hσu : ¬ IsUnit σ := fun hu => hnρa (hu.mul_right_dvd.mpr dvd_rfl)
  have hσm : σ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact hσu
  obtain ⟨σ', hσ'm, hσ'0, hσ'sq⟩ := hroot σ hσm hσ0 1
  have hσ'sq2 : σ' ^ 2 = σ := hσ'sq
  have hσ'σ : σ' ∣ σ := by rw [← hσ'sq2]; exact dvd_pow_self _ (by norm_num)
  have hσ'u : ¬ IsUnit σ' := by
    have := (IsLocalRing.mem_maximalIdeal _).mp hσ'm
    rwa [mem_nonunits_iff] at this
  have hσ'ρ' : σ' ∣ ρ' := hσ'σ.trans hσρ'
  obtain ⟨hσw, hσS⟩ := hdivs σ hσρ'
  obtain ⟨hσ'w, -⟩ := hdivs σ' hσ'ρ'
  obtain ⟨hZσ, hZσf⟩ := hshape σ hσu hσρ' Z hsubZ
  obtain ⟨hYσ, hYσf⟩ := hshape σ hσu hσρ' Y hsubY
  obtain ⟨hZσ', -⟩ := hshape σ' hσ'u hσ'ρ' Z hsubZ
  obtain ⟨hYσ', -⟩ := hshape σ' hσ'u hσ'ρ' Y hsubY
  have G1 := hgauss σ hσm hσ0 hσw
    (by rw [hYσ]; exact mul_ne_zero (hCne Y) (pow_ne_zero _ (mul_ne_zero ha0 hσ0)))
    (by rw [hZσ]; exact mul_ne_zero (hCne Z) (pow_ne_zero _ (mul_ne_zero ha0 hσ0)))
  have G2 := hgauss σ' hσ'm hσ'0 hσ'w
    (by rw [hYσ']; exact mul_ne_zero (hCne Y) (pow_ne_zero _ (mul_ne_zero ha0 hσ'0)))
    (by rw [hZσ']; exact mul_ne_zero (hCne Z) (pow_ne_zero _ (mul_ne_zero ha0 hσ'0)))
  rw [hYσ, hZσ] at G1
  rw [hYσ', hZσ'] at G2
  have hfinal : ∀ (CZ CY : ↥W) (NZ NY : ℕ), CY ≠ 0 →
      k2 * (CY * (a * σ) ^ NY) * lam₁ * σ ^ k ∣ k1 * (CZ * (a * σ) ^ NZ) * lam₂ * σ ^ n →
      k1 * (CZ * (a * σ) ^ NZ) * lam₂ * σ ^ n ∣ k2 * (CY * (a * σ) ^ NY) * lam₁ * σ ^ k →
      k2 * (CY * (a * σ') ^ NY) * lam₁ * σ' ^ k ∣ k1 * (CZ * (a * σ') ^ NZ) * lam₂ * σ' ^ n →
      k1 * (CZ * (a * σ') ^ NZ) * lam₂ * σ' ^ n ∣ k2 * (CY * (a * σ') ^ NY) * lam₁ * σ' ^ k →
      (k2 * (CY * (a * σ) ^ NY) ∣ k1 * (CZ * (a * σ) ^ NZ) ∨
        ¬ (ℓ : ℤ) ∣ ((NZ : ℤ) - (NY : ℤ))) := by
    intro CZ CY NZ NY hCY G1a G1b G2a G2b
    have he1 : ∀ τ : ↥W, k2 * (CY * (a * τ) ^ NY) * lam₁ * τ ^ k =
        (k2 * CY * lam₁ * a ^ NY) * τ ^ (NY + k) := by
      intro τ; rw [mul_pow, pow_add]; ring
    have he2 : ∀ τ : ↥W, k1 * (CZ * (a * τ) ^ NZ) * lam₂ * τ ^ n =
        (k1 * CZ * lam₂ * a ^ NZ) * τ ^ (NZ + n) := by
      intro τ; rw [mul_pow, pow_add]; ring
    rw [he1, he2] at G1a G1b G2a G2b
    rw [← hσ'sq2, ← pow_mul, ← pow_mul] at G1a G1b
    have hA0 : k2 * CY * lam₁ * a ^ NY ≠ 0 :=
      mul_ne_zero (mul_ne_zero (mul_ne_zero hk2 hCY) hl1) (pow_ne_zero _ ha0)
    obtain ⟨hpq, hab⟩ := hexp _ _ σ' (NY + k) (NZ + n) hA0 hσ'0 hσ'u G2a G2b G1a G1b
    rcases hD' with ⟨⟨μ', hμ'⟩, hsub⟩ | hnd
    · left
      have hstar : k2 * CY * μ' * a ^ NY ∣ k1 * CZ * a ^ NZ := by
        rw [hμ'] at hab
        have h3 : lam₂ * (k2 * CY * μ' * a ^ NY) ∣ lam₂ * (k1 * CZ * a ^ NZ) := by
          have h4 : k2 * CY * (lam₂ * μ') * a ^ NY = lam₂ * (k2 * CY * μ' * a ^ NY) := by ring
          have h5 : k1 * CZ * lam₂ * a ^ NZ = lam₂ * (k1 * CZ * a ^ NZ) := by ring
          rw [← h4, ← h5]; exact hab
        exact (mul_dvd_mul_iff_left hl2).mp h3
      have hpow : σ ^ NY ∣ μ' * σ ^ NZ := by
        rcases hsub with hnk | ⟨lam', hl', hlS⟩
        · exact (pow_dvd_pow σ (by omega)).trans (dvd_mul_left _ _)
        · have hμ'' : μ' = lam' := mul_left_cancel₀ hl2 (hμ'.symm.trans hl')
          have hσn : σ ^ n ∣ lam' :=
            ((pow_dvd_pow σ (by omega : n ≤ n + k + 1)).trans hσS).trans hlS
          rw [hμ'']
          calc σ ^ NY ∣ σ ^ (NZ + n) := pow_dvd_pow σ (by omega)
            _ = σ ^ n * σ ^ NZ := by rw [pow_add, mul_comm]
            _ ∣ lam' * σ ^ NZ := mul_dvd_mul_right hσn _
      calc k2 * (CY * (a * σ) ^ NY) = (k2 * CY * a ^ NY) * σ ^ NY := by rw [mul_pow]; ring
        _ ∣ (k2 * CY * a ^ NY) * (μ' * σ ^ NZ) := mul_dvd_mul_left _ hpow
        _ = (k2 * CY * μ' * a ^ NY) * σ ^ NZ := by ring
        _ ∣ (k1 * CZ * a ^ NZ) * σ ^ NZ := mul_dvd_mul_right hstar _
        _ = k1 * (CZ * (a * σ) ^ NZ) := by rw [mul_pow]; ring
    · right
      have h6 : (NZ : ℤ) - (NY : ℤ) = (k : ℤ) - n := by omega
      rw [h6]; exact hnd
  unfold wcFrfGood
  rw [hYσ, hZσ]
  unfold wcFrfM
  rw [hZσf, hYσf]
  exact hfinal _ _ _ _ (hCne Y) G1.1 G1.2 G2.1 G2.2

theorem wcLlsASbb_best_approx : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] (𝔭 : Ideal A) (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) → ((ℓ : ℕ) : K) = 0 → ∀ (α : L) (f₀ : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α → ∃ (h₀ : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A), lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀ ∉ 𝔭 ∧ ε₁ ∉ 𝔭 ∧ (f₀ - (h₀ ^ ℓ - h₀)) * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) * algebraMap A K (algebraMap ↥W A lam₂) = algebraMap A K (algebraMap ↥W A lam₁) * algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀) ∧ (lam₂ ∣ lam₁ ∨ ∀ (h' : K) (lam₁' lam₂' w' : ↥W) (n' k' : ℕ) (ε₀' ε₁' r₀' r₁' g₀' g₁' : A), lam₁' ≠ 0 → lam₂' ≠ 0 → w' ∈ IsLocalRing.maximalIdeal ↥W → ε₀' ∉ 𝔭 → ε₁' ∉ 𝔭 → (f₀ - (h₀ ^ ℓ - h₀) - (h' ^ ℓ - h')) * algebraMap A K (u ^ n' * ε₁' + v * r₁' + algebraMap ↥W A w' * g₁') * algebraMap A K (algebraMap ↥W A lam₂') = algebraMap A K (algebraMap ↥W A lam₁') * algebraMap A K (u ^ k' * ε₀' + v * r₀' + algebraMap ↥W A w' * g₀') → lam₁' * lam₂ ∣ lam₁ * lam₂') :=
by
  intro Ω _ _ W hdim hWtop ℓ hℓ A _ _ _ K _ _ _ L _ _ 𝔭 u v g hPD hK α f₀ hα hf₀
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI hcK : CharP K ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hK
  haveI hcL : CharP L ℓ := charP_of_injective_algebraMap (algebraMap K L).injective ℓ

  have hnwp : ∀ h : K, f₀ - (h ^ ℓ - h) ≠ 0 := by
    intro h h0
    apply hα
    have hβ : (α - algebraMap K L h) ^ ℓ = α - algebraMap K L h := by
      rw [sub_pow_char]
      have e : algebraMap K L f₀ = algebraMap K L (h ^ ℓ - h) := by
        congr 1; linear_combination h0
      rw [map_sub, map_pow] at e
      linear_combination e - hf₀
    have hmem : α - algebraMap K L h ∈ (⊥ : Subfield L) :=
      (Subfield.mem_bot_iff_pow_eq_self L ℓ).mpr hβ
    have hmem' : α - algebraMap K L h ∈ (algebraMap K L).fieldRange :=
      (bot_le : (⊥ : Subfield L) ≤ (algebraMap K L).fieldRange) hmem
    obtain ⟨h₁, hh₁⟩ := RingHom.mem_fieldRange.mp hmem'
    exact ⟨h₁ + h, by rw [map_add, hh₁]; ring⟩

  obtain ⟨O, hOmem, hroot⟩ := wcLlsASbba_branch_valring Ω W hdim hWtop A K 𝔭 u v g hPD

  obtain ⟨ψ, hψW, hψX, hfs⟩ := wcLlsASbba_ratfunc_chart Ω W hdim hWtop A K 𝔭 u v g hPD
  letI : Algebra (RatFunc Ω) K := ψ.toAlgebra
  obtain ⟨hfd, hsep⟩ := hfs
  haveI := hfd
  haveI := hsep

  have hc := wcLlsASbba_gauss_contract Ω W hdim hWtop A K 𝔭 u v g hPD ψ hψW hψX O hOmem

  obtain ⟨V, hV1, -, -, -⟩ := wcpa_dj_lr1k_gd_gauss_valuation Ω W
  have hR₀ : ∀ f ∈ wcEbGauss W, algebraMap (RatFunc Ω) K f ∈ O := fun f hf => (hc f).mpr hf
  have hV₀ : ∀ f ∈ V, algebraMap (RatFunc Ω) K f ∈ O := by
    intro f hf
    apply hR₀
    rw [← hV1]
    exact hf
  have hV₀' : ∀ f ∈ V, f ≠ 0 → (algebraMap (RatFunc Ω) K f)⁻¹ ∈ O → f⁻¹ ∈ V := by
    intro f _ _ hinv
    have h1 : algebraMap (RatFunc Ω) K f⁻¹ ∈ O := by rw [map_inv₀]; exact hinv
    have h2 : f⁻¹ ∈ wcEbGauss W := (hc f⁻¹).mp h1
    rw [← hV1] at h2
    exact h2
  have hfin : ∀ (L' : Type u) [Field L'] [Algebra K L'] [FiniteDimensional K L']
      [Algebra.IsSeparable K L'], letI : Algebra ↥O L' := ((algebraMap K L').comp O.subtype).toAlgebra;
      Module.Finite ↥O ↥(integralClosure ↥O L') := by
    intro L' _ _ _ _
    letI : Algebra (RatFunc Ω) L' :=
      ((algebraMap K L').comp (algebraMap (RatFunc Ω) K)).toAlgebra
    haveI : IsScalarTower (RatFunc Ω) K L' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : FiniteDimensional (RatFunc Ω) L' := Module.Finite.trans K L'
    haveI : Algebra.IsSeparable (RatFunc Ω) L' := Algebra.IsSeparable.trans (RatFunc Ω) K L'
    have hD := wcpa_dj_lr1k_eb_gauss_defectless_r1 Ω W hdim hWtop L'
    haveI : Algebra.IsAlgebraic (RatFunc Ω) K := Algebra.IsAlgebraic.of_finite _ _
    letI : Algebra ↥(wcEbGauss W) K :=
      ((algebraMap (RatFunc Ω) K).comp (wcEbGauss W).subtype).toAlgebra
    have hU := wcLlsASbfd_unit_fraction (RatFunc Ω) K V (wcEbGauss W) hV1 O hV₀ hV₀'
      (fun n b x h k => wcLlsASbfd_bourbaki_integral ↥(wcEbGauss W) K n b x h k)
    exact wcLlsASbfd_finite_transfer (RatFunc Ω) K L' (wcEbGauss W) O hR₀ hU hD

  obtain ⟨h₀, hdisj⟩ :=
    wcLlsASbf_lattice_max K O ℓ hℓ hK (hroot ℓ hℓ.pos) hfin L α f₀ hα hf₀.symm
  have e0 : f₀ - h₀ ^ ℓ + h₀ = f₀ - (h₀ ^ ℓ - h₀) := by ring

  obtain ⟨lam₁, lam₂, w, n, k, ε₀, ε₁, r₀, r₁, g₀, g₁, h1, h2, h3, h4, h5, hEQ⟩ :=
    wcLlsASbb_fraction_form Ω W hdim hWtop A K 𝔭 u v g hPD _ (hnwp h₀)
  refine ⟨h₀, lam₁, lam₂, w, n, k, ε₀, ε₁, r₀, r₁, g₀, g₁, h1, h2, h3, h4, h5, hEQ, ?_⟩
  have hmax : 𝔭.IsMaximal := by
    obtain ⟨-, -, -, hm, -⟩ := hPD
    exact hm
  have h𝔭 : (1 : A) ∉ 𝔭 := fun h => hmax.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  rcases hdisj with hO | hO
  · left
    rw [e0] at hO
    obtain ⟨a, b, hb, hab⟩ := (hOmem _).mp hO
    have hcmp := wcLlsASbba_nf_compare Ω W hdim hWtop A K 𝔭 u v g hPD (f₀ - (h₀ ^ ℓ - h₀)) 1
      lam₁ lam₂ w n k ε₀ ε₁ r₀ r₁ g₀ g₁ 1 1 0 0 0 1 1 0 0 0 0 a b h1 h2 h3 h4 h5 hEQ one_ne_zero
      one_ne_zero (IsLocalRing.maximalIdeal ↥W).zero_mem h𝔭 h𝔭 (by simp) hb
      (by rw [hab, one_mul])
    simpa using hcmp
  · right
    intro h' lam₁' lam₂' w' n' k' ε₀' ε₁' r₀' r₁' g₀' g₁' h1' h2' h3' h4' h5' hEQ'
    have e1 : f₀ - h₀ ^ ℓ + h₀ - h' ^ ℓ + h' = f₀ - (h₀ ^ ℓ - h₀) - (h' ^ ℓ - h') := by ring
    have hF' : f₀ - (h₀ ^ ℓ - h₀) - (h' ^ ℓ - h') ≠ 0 := by
      have e : f₀ - (h₀ ^ ℓ - h₀) - (h' ^ ℓ - h') = f₀ - ((h₀ + h') ^ ℓ - (h₀ + h')) := by
        rw [add_pow_char]; ring
      rw [e]; exact hnwp _
    have hq := hO h' (by rw [e1]; exact hF')
    rw [e1, e0] at hq
    obtain ⟨a, b, hb, hab⟩ := (hOmem _).mp hq
    refine wcLlsASbba_nf_compare Ω W hdim hWtop A K 𝔭 u v g hPD _ _ lam₁ lam₂ w n k ε₀ ε₁ r₀ r₁
      g₀ g₁ lam₁' lam₂' w' n' k' ε₀' ε₁' r₀' r₁' g₀' g₁' a b h1 h2 h3 h4 h5 hEQ h1' h2' h3' h4'
      h5' hEQ' hb ?_
    rw [← hab]
    field_simp

theorem wcLlsASbb_pole_step : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] (𝔭 : Ideal A) (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) → ((ℓ : ℕ) : K) = 0 → ∀ (α : L) (f₀ : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α → ∀ (h : K) (lam' w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A), IsUnit lam' → w ∈ IsLocalRing.maximalIdeal ↥W → ε₀ ∉ 𝔭 → ε₁ ∉ 𝔭 → k < n → (ℓ : ℤ) ∣ ((k : ℤ) - n) → (f₀ - (h ^ ℓ - h)) * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) = algebraMap A K (algebraMap ↥W A lam') * algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀) → ∃ (h' : K) (lam'' w' : ↥W) (n' k' : ℕ) (ε₀' ε₁' r₀' r₁' g₀' g₁' : A), lam'' ≠ 0 ∧ w' ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀' ∉ 𝔭 ∧ ε₁' ∉ 𝔭 ∧ (f₀ - (h' ^ ℓ - h')) * algebraMap A K (u ^ n' * ε₁' + v * r₁' + algebraMap ↥W A w' * g₁') = algebraMap A K (algebraMap ↥W A lam'') * algebraMap A K (u ^ k' * ε₀' + v * r₀' + algebraMap ↥W A w' * g₀') ∧ (lam'' ∈ IsLocalRing.maximalIdeal ↥W ∨ (IsUnit lam'' ∧ n' - k' < n - k)) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ A _ _ _ K _ _ _ L _ _ 𝔭 u v g hPD hK α f₀ hα hf₀ h lam' w n k
    ε₀ ε₁ r₀ r₁ g₀ g₁ hlu hw hε₀ hε₁ hkn hdiv hEQ
  classical
  obtain ⟨j, rfl⟩ : ∃ j, n = k + j := ⟨n - k, by omega⟩

  have hg0 : g ≠ 0 := hPD.2.2.2.2.2.2.1
  have huv : u * v = algebraMap ↥W A g := hPD.2.2.2.2.2.2.2.1
  have hpeq : 𝔭 = Ideal.span {u, v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) :=
    hPD.2.2.2.2.2.2.2.2.1
  have hpmax : 𝔭.IsMaximal := hPD.2.2.2.1
  have hmp : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 := hPD.2.2.2.2.1
  haveI hprime : 𝔭.IsPrime := hpmax.isPrime
  have hnot : ∀ a b : A, a ∉ 𝔭 → b ∉ 𝔭 → a * b ∉ 𝔭 := fun a b ha hb hm =>
    (hprime.mem_or_mem hm).elim ha hb
  have hinj : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
    intro x hx h0
    have h1 : algebraMap ↥W A x = 0 :=
      (IsFractionRing.injective A K) (h0.trans (map_zero _).symm)
    have h2 : x • (1 : A) = 0 := by rw [Algebra.smul_def, mul_one]; exact h1
    haveI := hPD.2.1
    exact hx ((smul_eq_zero.mp h2).resolve_right one_ne_zero)
  have huvK : algebraMap A K u * algebraMap A K v = algebraMap A K (algebraMap ↥W A g) := by
    rw [← map_mul, huv]
  have hu : algebraMap A K u ≠ 0 := by
    intro h0
    apply hinj g hg0
    rw [← huvK, h0, zero_mul]

  have hdivj : ℓ ∣ j := by
    have e : ((k : ℤ) - ((k + j : ℕ) : ℤ)) = -((j : ℕ) : ℤ) := by push_cast; ring
    rw [e, dvd_neg] at hdiv
    exact Int.natCast_dvd_natCast.mp hdiv
  obtain ⟨m', hm'⟩ := hdivj
  have hj0 : 0 < j := by omega
  have hm0 : 0 < m' := Nat.pos_of_ne_zero (by rintro rfl; rw [mul_zero] at hm'; omega)
  have hmj : m' < j := by
    have := Nat.mul_le_mul hℓ.two_le (le_refl m')
    omega
  obtain ⟨p, hp⟩ : ∃ p, j = m' + (p + 1) := ⟨j - m' - 1, by omega⟩
  have hjl : j = m' * ℓ := by rw [hm', mul_comm]

  have rootW : ∀ N : ℕ, 0 < N → ∀ z : ↥W, ∃ r : ↥W, r ^ N = z := by
    intro N hN z
    obtain ⟨r, hr⟩ := IsAlgClosed.exists_pow_nat_eq (z : Ω) hN
    by_cases hrW : r ∈ W
    · refine ⟨⟨r, hrW⟩, Subtype.ext ?_⟩
      first
        | simpa using hr
        | exact hr
    · exfalso
      have hr0 : r ≠ 0 := fun h0 => hrW (h0 ▸ W.zero_mem)
      have hrinv : r⁻¹ ∈ W := (W.mem_or_inv_mem r).resolve_left hrW
      obtain ⟨N', rfl⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by omega⟩
      have h1 : r = (z : Ω) * r⁻¹ ^ N' := by
        rw [← hr, inv_pow, pow_succ, mul_assoc, mul_comm r, ← mul_assoc,
          mul_inv_cancel₀ (pow_ne_zero _ hr0), one_mul]
      apply hrW
      rw [h1]
      exact mul_mem z.2 (pow_mem hrinv N')

  obtain ⟨J, hJ⟩ : ∃ J : Ideal A,
      J = Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := ⟨_, rfl⟩
  have hvJ : ∀ r : A, v * r ∈ J := fun r => by
    rw [hJ]
    exact Ideal.mem_sup_left (Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_singleton v)))
  have hmJ : ∀ z ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A), z ∈ J := fun z hz => by
    rw [hJ]; exact Ideal.mem_sup_right hz
  have hvp : v ∈ 𝔭 := by
    rw [hpeq]
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
  have hJp : J ≤ 𝔭 := by
    rw [hJ]
    refine sup_le ?_ hmp
    rw [Ideal.span_le, Set.singleton_subset_iff]
    exact hvp

  have hQ : ∀ z ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A),
      ∃ μ ∈ IsLocalRing.maximalIdeal ↥W, ∃ r' : A, z = algebraMap ↥W A μ * r' := by
    intro z hz
    have hz' : z ∈ Submodule.span A
        ((algebraMap ↥W A) '' (IsLocalRing.maximalIdeal ↥W : Set ↥W)) := hz
    clear hz
    induction hz' using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨μ, hμ, rfl⟩ := hx
      exact ⟨μ, hμ, 1, (mul_one _).symm⟩
    | zero => exact ⟨0, Ideal.zero_mem _, 0, by rw [mul_zero]⟩
    | add x y _ _ hx hy =>
      obtain ⟨μ₁, hμ₁, r₁', rfl⟩ := hx
      obtain ⟨μ₂, hμ₂, r₂', rfl⟩ := hy
      rcases ValuationRing.dvd_total μ₁ μ₂ with ⟨q, rfl⟩ | ⟨q, rfl⟩
      · exact ⟨μ₁, hμ₁, r₁' + algebraMap ↥W A q * r₂', by rw [map_mul]; ring⟩
      · exact ⟨μ₂, hμ₂, algebraMap ↥W A q * r₁' + r₂', by rw [map_mul]; ring⟩
    | smul a x _ hx =>
      obtain ⟨μ, hμ, r', rfl⟩ := hx
      exact ⟨μ, hμ, a * r', by rw [smul_eq_mul]; ring⟩
  have hcollapse : ∀ y ∈ J, ∃ (r g' : A) (w₂ : ↥W), w₂ ∈ IsLocalRing.maximalIdeal ↥W ∧
      y = v * r + algebraMap ↥W A w₂ * g' := by
    intro y hy
    rw [hJ] at hy
    obtain ⟨y₁, hy₁, y₂, hy₂, rfl⟩ := Submodule.mem_sup.mp hy
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hy₁
    obtain ⟨μ, hμ, r', rfl⟩ := hQ y₂ hy₂
    exact ⟨r, r', μ, hμ, by ring⟩

  have hcommon : ∀ w₂ : ↥W, w₂ ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ ws q₁ q₂ : ↥W, ws ∈ IsLocalRing.maximalIdeal ↥W ∧ w = ws * q₁ ∧ w₂ = ws * q₂ := by
    intro w₂ hw₂
    rcases ValuationRing.dvd_total w w₂ with ⟨q, hq⟩ | ⟨q, hq⟩
    · exact ⟨w, 1, q, hw, (mul_one w).symm, hq⟩
    · exact ⟨w₂, q, 1, hw₂, hq, (mul_one w₂).symm⟩

  obtain ⟨⟨hdom, hdvr, hirr⟩, -⟩ := wcpa_dj_llsm_kpkn_branch_dvrs Ω W A 𝔭 u v g hPD
  haveI := hdom
  haveI := hdvr
  have hBr : wcKpknBrI W A 𝔭 v = J.map (algebraMap A (Localization.AtPrime 𝔭)) := by
    show ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
        (algebraMap A (Localization.AtPrime 𝔭)) ⊔
      Ideal.span {algebraMap A (Localization.AtPrime 𝔭) v} = _
    rw [hJ, Ideal.map_sup, Ideal.map_span, Set.image_singleton, sup_comm]
  have hTr : ∀ y : A, algebraMap A (Localization.AtPrime 𝔭) y ∈ wcKpknBrI W A 𝔭 v →
      ∃ t : A, t ∉ 𝔭 ∧ t * y ∈ J := by
    intro y hy
    rw [hBr] at hy
    obtain ⟨⟨⟨x₁, hx₁⟩, ⟨x₂, hx₂⟩⟩, hx⟩ :=
      (IsLocalization.mem_map_algebraMap_iff 𝔭.primeCompl (Localization.AtPrime 𝔭)).mp hy
    have hx' : algebraMap A (Localization.AtPrime 𝔭) (y * x₂) =
        algebraMap A (Localization.AtPrime 𝔭) x₁ := by rw [map_mul]; exact hx
    obtain ⟨⟨c, hc⟩, hc'⟩ :=
      (IsLocalization.eq_iff_exists 𝔭.primeCompl (Localization.AtPrime 𝔭)).mp hx'
    refine ⟨c * x₂, hnot c x₂ (Ideal.mem_primeCompl_iff.mp hc)
      (Ideal.mem_primeCompl_iff.mp hx₂), ?_⟩
    have e : c * x₂ * y = c * (y * x₂) := by ring
    have hc'' : c * (y * x₂) = c * x₁ := hc'
    rw [e, hc'']
    exact Ideal.mul_mem_left _ _ hx₁
  have hBrle : wcKpknBrI W A 𝔭 v ≤ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) := by
    rw [hBr, Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap]
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔭) 𝔭 x).mpr
      (hJp hx)
  have hdich : ∀ X : A, (∃ t : A, t ∉ 𝔭 ∧ t * X ∈ J) ∨
      ∃ (e : ℕ) (σ ε : A), σ ∉ 𝔭 ∧ ε ∉ 𝔭 ∧ σ * X - u ^ e * ε ∈ J := by
    intro X
    by_cases hX : Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v)
        (algebraMap A (Localization.AtPrime 𝔭) X) = 0
    · exact Or.inl (hTr X (Ideal.Quotient.eq_zero_iff_mem.mp hX))
    · right
      obtain ⟨e, U, hU⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hX hirr
      obtain ⟨z, hz⟩ :=
        Ideal.Quotient.mk_surjective (U : Localization.AtPrime 𝔭 ⧸ wcKpknBrI W A 𝔭 v)
      obtain ⟨z', hz'⟩ :=
        Ideal.Quotient.mk_surjective (↑U⁻¹ : Localization.AtPrime 𝔭 ⧸ wcKpknBrI W A 𝔭 v)
      obtain ⟨⟨a, s⟩, has⟩ := IsLocalization.surj 𝔭.primeCompl z
      have has' : z * algebraMap A (Localization.AtPrime 𝔭) (s : A) =
          algebraMap A (Localization.AtPrime 𝔭) a := has
      have hs' : (s : A) ∉ 𝔭 := Ideal.mem_primeCompl_iff.mp s.2
      have ha : a ∉ 𝔭 := by
        intro ha
        have h1 : Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v)
            (algebraMap A (Localization.AtPrime 𝔭) a * z' -
              algebraMap A (Localization.AtPrime 𝔭) (s : A)) = 0 := by
          rw [← has']
          simp only [map_sub, map_mul, hz, hz']
          linear_combination (Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v)
            (algebraMap A (Localization.AtPrime 𝔭) (s : A))) * (Units.mul_inv U)
        have h2 := hBrle (Ideal.Quotient.eq_zero_iff_mem.mp h1)
        have h3 : algebraMap A (Localization.AtPrime 𝔭) a ∈
            IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) :=
          (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔭) 𝔭 a).mpr ha
        have h4 := Ideal.mul_mem_right z' _ h3
        have h5 := Ideal.sub_mem _ h4 h2
        rw [sub_sub_cancel] at h5
        exact hs' ((IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔭) 𝔭
          (s : A)).mp h5)
      have hzero : Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v)
          (algebraMap A (Localization.AtPrime 𝔭) ((s : A) * X - u ^ e * a)) = 0 := by
        simp only [map_sub, map_mul, map_pow]
        rw [hU, ← has', map_mul, hz]
        ring
      obtain ⟨t, ht, htJ⟩ := hTr _ (Ideal.Quotient.eq_zero_iff_mem.mp hzero)
      refine ⟨e, t * s, t * a, hnot _ _ ht hs', hnot _ _ ht ha, ?_⟩
      have e1 : t * (s : A) * X - u ^ e * (t * a) = t * ((s : A) * X - u ^ e * a) := by ring
      rw [e1]
      exact htJ

  have hτ : ∃ τ : ↥W, τ ^ ℓ - τ = 1 := by
    have hℓ2 := hℓ.two_le
    have hdeg : (Polynomial.X ^ ℓ - Polynomial.X - Polynomial.C (1 : Ω)).degree ≠ 0 := by
      intro h0
      have h1 : (Polynomial.X ^ ℓ - Polynomial.X - Polynomial.C (1 : Ω)).natDegree = 0 :=
        Polynomial.natDegree_eq_zero_iff_degree_le_zero.mpr h0.le
      rw [Polynomial.natDegree_sub_C, FiniteField.X_pow_card_sub_X_natDegree_eq Ω (by omega)] at h1
      omega
    obtain ⟨τ₀, hτ₀⟩ := IsAlgClosed.exists_root _ hdeg
    have hτ₀' : τ₀ ^ ℓ - τ₀ - 1 = 0 := by
      have h1 : Polynomial.eval τ₀ (Polynomial.X ^ ℓ - Polynomial.X - Polynomial.C (1 : Ω)) = 0 :=
        hτ₀
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_C] at h1
      exact h1
    have hτ0 : τ₀ ≠ 0 := by
      rintro rfl
      rw [zero_pow hℓ.ne_zero] at hτ₀'
      norm_num at hτ₀'
    have hmem : τ₀ ∈ W := by
      rcases W.mem_or_inv_mem τ₀ with h1 | h1
      · exact h1
      · obtain ⟨ℓ₂, hℓ₂⟩ : ∃ ℓ₂, ℓ = ℓ₂ + 2 := ⟨ℓ - 2, by omega⟩
        have hinv : τ₀ * τ₀⁻¹ = 1 := mul_inv_cancel₀ hτ0
        have h2 : τ₀ ^ (ℓ₂ + 2) = τ₀ + 1 := by rw [← hℓ₂]; linear_combination hτ₀'
        have e : τ₀⁻¹ ^ ℓ₂ + τ₀⁻¹ ^ (ℓ₂ + 1) = τ₀ := by
          calc τ₀⁻¹ ^ ℓ₂ + τ₀⁻¹ ^ (ℓ₂ + 1) = τ₀⁻¹ ^ (ℓ₂ + 1) * (τ₀ + 1) := by
                linear_combination (-(τ₀⁻¹ ^ ℓ₂)) * hinv
            _ = τ₀⁻¹ ^ (ℓ₂ + 1) * τ₀ ^ (ℓ₂ + 2) := by rw [h2]
            _ = (τ₀⁻¹ * τ₀) ^ (ℓ₂ + 1) * τ₀ := by ring
            _ = τ₀ := by rw [inv_mul_cancel₀ hτ0, one_pow, one_mul]
        rw [← e]
        exact add_mem (pow_mem h1 _) (pow_mem h1 _)
    refine ⟨⟨τ₀, hmem⟩, Subtype.ext ?_⟩
    first
      | (show τ₀ ^ ℓ - τ₀ = 1; linear_combination hτ₀')
      | (push_cast; linear_combination hτ₀')
      | (simp only [SubringClass.coe_pow, AddSubgroupClass.coe_sub, OneMemClass.coe_one];
         linear_combination hτ₀')

  obtain ⟨y₁, i₁, hi₁, hyx⟩ := hpmax.exists_inv hε₁
  obtain ⟨γ, hγ'⟩ := wcLlsASb_residue_lift Ω W A 𝔭 hPD.1 hpmax hmp
    (algebraMap ↥W A lam' * ε₀ * y₁)
  have hδ : algebraMap ↥W A lam' * ε₀ - algebraMap ↥W A γ * ε₁ ∈ 𝔭 := by
    have e1 : algebraMap ↥W A lam' * ε₀ - algebraMap ↥W A γ * ε₁ =
        (algebraMap ↥W A lam' * ε₀ * y₁ - algebraMap ↥W A γ) * ε₁ +
          algebraMap ↥W A lam' * ε₀ * i₁ := by
      linear_combination (-(algebraMap ↥W A lam' * ε₀)) * hyx
    rw [e1]
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hγ') (Ideal.mul_mem_left _ _ hi₁)
  obtain ⟨c, hc⟩ := rootW ℓ hℓ.pos γ
  rw [hpeq] at hδ
  obtain ⟨z₁, hz₁, y, hy, hzy⟩ := Submodule.mem_sup.mp hδ
  obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp hz₁
  have hδ' : algebraMap ↥W A lam' * ε₀ - algebraMap ↥W A γ * ε₁ = a * u + b * v + y := by
    rw [← hzy, ← hab]

  obtain ⟨B₁, hB₁⟩ : ∃ B : A, B = u ^ (k + j) * ε₁ + v * r₁ + algebraMap ↥W A w * g₁ :=
    ⟨_, rfl⟩
  obtain ⟨B₀, hB₀⟩ : ∃ B : A, B = u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀ := ⟨_, rfl⟩
  rw [← hB₁, ← hB₀] at hEQ

  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : CharP K ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hK
  obtain ⟨T, hTdef⟩ : ∃ T : K,
      T = algebraMap A K (algebraMap ↥W A c) / algebraMap A K u ^ m' := ⟨_, rfl⟩
  have e1 : T * algebraMap A K u ^ m' = algebraMap A K (algebraMap ↥W A c) := by
    rw [hTdef]; exact div_mul_cancel₀ _ (pow_ne_zero _ hu)
  have e2 : T ^ ℓ * algebraMap A K u ^ j = algebraMap A K (algebraMap ↥W A γ) := by
    rw [hjl, pow_mul, ← mul_pow, e1, ← hc, map_pow, map_pow]
  have e3 : T * algebraMap A K u ^ j =
      algebraMap A K (algebraMap ↥W A c) * algebraMap A K u ^ (p + 1) := by
    rw [hp, pow_add, ← mul_assoc, e1]
  obtain ⟨x, hx⟩ : ∃ x : A, x = algebraMap ↥W A lam' * u ^ j * B₀ - algebraMap ↥W A γ * B₁ +
      algebraMap ↥W A c * u ^ (p + 1) * B₁ := ⟨_, rfl⟩
  have hF' : (f₀ - ((h + T) ^ ℓ - (h + T))) * algebraMap A K (u ^ j * B₁) =
      algebraMap A K x := by
    rw [hx, add_pow_char h T ℓ]
    simp only [map_mul, map_sub, map_add, map_pow]
    linear_combination algebraMap A K u ^ j * hEQ - algebraMap A K B₁ * e2 +
      algebraMap A K B₁ * e3

  obtain ⟨X, hX⟩ : ∃ X : A, X = a + algebraMap ↥W A c * u ^ p * ε₁ := ⟨_, rfl⟩
  obtain ⟨P, hP⟩ : ∃ P : A, P = v * (u ^ (k + j) * b + algebraMap ↥W A lam' * u ^ j * r₀ -
      algebraMap ↥W A γ * r₁ + algebraMap ↥W A c * u ^ (p + 1) * r₁) +
      algebraMap ↥W A w * (algebraMap ↥W A lam' * u ^ j * g₀ - algebraMap ↥W A γ * g₁ +
        algebraMap ↥W A c * u ^ (p + 1) * g₁) + u ^ (k + j) * y := ⟨_, rfl⟩
  have hxd : x = u ^ (k + j + 1) * X + P := by
    rw [hx, hX, hP, hB₁, hB₀]
    linear_combination u ^ (k + j) * hδ'
  have hPJ : P ∈ J := by
    rw [hP]
    refine Ideal.add_mem _ (Ideal.add_mem _ (hvJ _) ?_) ?_
    · exact hmJ _ (Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hw))
    · exact hmJ _ (Ideal.mul_mem_left _ _ hy)

  rcases hdich X with ⟨t, ht, htX⟩ | ⟨e, σ, ε, hσ, hε, hXJ⟩
  ·
    have htxJ : t * x ∈ J := by
      have e0 : t * x = u ^ (k + j + 1) * (t * X) + t * P := by rw [hxd]; ring
      rw [e0]
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ htX) (Ideal.mul_mem_left _ _ hPJ)
    obtain ⟨rr, gg, w₂, hw₂, hYeq⟩ := hcollapse _ htxJ
    obtain ⟨ws, q₁, q₂, hws, hq₁, hq₂⟩ := hcommon w₂ hw₂
    have hwq : algebraMap ↥W A w = algebraMap ↥W A ws * algebraMap ↥W A q₁ := by
      rw [hq₁, map_mul]
    have hwq₂ : algebraMap ↥W A w₂ = algebraMap ↥W A ws * algebraMap ↥W A q₂ := by
      rw [hq₂, map_mul]
    obtain ⟨τ, hτ1⟩ := hτ
    have hT₂ : algebraMap A K (algebraMap ↥W A τ) ^ ℓ - algebraMap A K (algebraMap ↥W A τ) = 1 := by
      rw [← map_pow, ← map_pow, ← map_sub, ← map_sub, hτ1, map_one, map_one]
    refine ⟨h + T + algebraMap A K (algebraMap ↥W A τ), 1, ws, k + j + j, k + j + j, -(t * ε₁),
      t * ε₁, rr - t * u ^ j * r₁, t * u ^ j * r₁,
      algebraMap ↥W A q₂ * gg - algebraMap ↥W A q₁ * (t * u ^ j * g₁),
      algebraMap ↥W A q₁ * (t * u ^ j * g₁), one_ne_zero, hws, ?_, hnot _ _ ht hε₁, ?_,
      Or.inr ⟨isUnit_one, by omega⟩⟩
    · intro hm
      exact hnot _ _ ht hε₁ (neg_mem_iff.mp hm)
    · have e4 : algebraMap A K (u ^ (k + j + j) * (t * ε₁) + v * (t * u ^ j * r₁) +
          algebraMap ↥W A ws * (algebraMap ↥W A q₁ * (t * u ^ j * g₁))) =
          algebraMap A K t * algebraMap A K (u ^ j * B₁) := by
        rw [← map_mul]; congr 1; rw [hB₁, hwq]; ring
      have e5 : algebraMap A K (u ^ (k + j + j) * -(t * ε₁) + v * (rr - t * u ^ j * r₁) +
          algebraMap ↥W A ws * (algebraMap ↥W A q₂ * gg - algebraMap ↥W A q₁ * (t * u ^ j * g₁))) =
          algebraMap A K t * algebraMap A K x -
            algebraMap A K t * algebraMap A K (u ^ j * B₁) := by
        rw [← map_mul, ← map_mul, ← map_sub]; congr 1; rw [hYeq, hB₁, hwq, hwq₂]; ring
      rw [e4, e5, map_one, map_one, one_mul, add_pow_char (h + T) _ ℓ, ← hF']
      linear_combination (-(algebraMap A K t * algebraMap A K (u ^ j * B₁))) * hT₂
  ·
    obtain ⟨Y, hYdef⟩ : ∃ Y : A, Y = u ^ (k + j + 1) * (σ * X - u ^ e * ε) + σ * P := ⟨_, rfl⟩
    have hYJ : Y ∈ J := by
      rw [hYdef]
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hXJ) (Ideal.mul_mem_left _ _ hPJ)
    have hσx : σ * x = u ^ (k + j + 1 + e) * ε + Y := by rw [hYdef, hxd]; ring
    obtain ⟨rr, gg, w₂, hw₂, hYeq⟩ := hcollapse _ hYJ
    obtain ⟨ws, q₁, q₂, hws, hq₁, hq₂⟩ := hcommon w₂ hw₂
    have hwq : algebraMap ↥W A w = algebraMap ↥W A ws * algebraMap ↥W A q₁ := by
      rw [hq₁, map_mul]
    have hwq₂ : algebraMap ↥W A w₂ = algebraMap ↥W A ws * algebraMap ↥W A q₂ := by
      rw [hq₂, map_mul]
    refine ⟨h + T, 1, ws, k + j + j, k + j + 1 + e, ε, σ * ε₁, rr, σ * u ^ j * r₁,
      algebraMap ↥W A q₂ * gg, algebraMap ↥W A q₁ * (σ * u ^ j * g₁), one_ne_zero, hws, hε,
      hnot _ _ hσ hε₁, ?_, Or.inr ⟨isUnit_one, by omega⟩⟩
    have e4 : algebraMap A K (u ^ (k + j + j) * (σ * ε₁) + v * (σ * u ^ j * r₁) +
        algebraMap ↥W A ws * (algebraMap ↥W A q₁ * (σ * u ^ j * g₁))) =
        algebraMap A K σ * algebraMap A K (u ^ j * B₁) := by
      rw [← map_mul]; congr 1; rw [hB₁, hwq]; ring
    have e5 : algebraMap A K (u ^ (k + j + 1 + e) * ε + v * rr +
        algebraMap ↥W A ws * (algebraMap ↥W A q₂ * gg)) =
        algebraMap A K σ * algebraMap A K x := by
      rw [← map_mul]; congr 1; rw [hσx, hYeq, hwq₂]; ring
    rw [e4, e5, map_one, map_one, one_mul, ← hF']
    ring

theorem wcLlsASbb_neg_step : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] (𝔭 : Ideal A) (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) → ((ℓ : ℕ) : K) = 0 → ∀ (α : L) (f₀ : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α → ∀ (h₀ : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A), lam₁ ≠ 0 → lam₂ ≠ 0 → w ∈ IsLocalRing.maximalIdeal ↥W → ε₀ ∉ 𝔭 → ε₁ ∉ 𝔭 → (f₀ - (h₀ ^ ℓ - h₀)) * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) * algebraMap A K (algebraMap ↥W A lam₂) = algebraMap A K (algebraMap ↥W A lam₁) * algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀) → ¬ lam₂ ∣ lam₁ → (∀ (h' : K) (lam₁' lam₂' w' : ↥W) (n' k' : ℕ) (ε₀' ε₁' r₀' r₁' g₀' g₁' : A), lam₁' ≠ 0 → lam₂' ≠ 0 → w' ∈ IsLocalRing.maximalIdeal ↥W → ε₀' ∉ 𝔭 → ε₁' ∉ 𝔭 → (f₀ - (h₀ ^ ℓ - h₀) - (h' ^ ℓ - h')) * algebraMap A K (u ^ n' * ε₁' + v * r₁' + algebraMap ↥W A w' * g₁') * algebraMap A K (algebraMap ↥W A lam₂') = algebraMap A K (algebraMap ↥W A lam₁') * algebraMap A K (u ^ k' * ε₀' + v * r₀' + algebraMap ↥W A w' * g₀') → lam₁' * lam₂ ∣ lam₁ * lam₂') → ∃ (h : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A), lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀ ∉ 𝔭 ∧ ε₁ ∉ 𝔭 ∧ (f₀ - (h ^ ℓ - h)) * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) * algebraMap A K (algebraMap ↥W A lam₂) = algebraMap A K (algebraMap ↥W A lam₁) * algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀) ∧ ¬ (ℓ : ℤ) ∣ ((k : ℤ) - n) :=
by
  classical
  intro Ω _ _ W hW hWt ℓ hℓ A _ _ _ K _ _ _ L _ _ 𝔭 u v g hPD hK α f₀ hα hf₀ h₀ lam₁ lam₂ w n k
    ε₀ ε₁ r₀ r₁ g₀ g₁ hl1 hl2 hw hε₀ hε₁ hE hndvd hmax
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI hcK : CharP K ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hK
  haveI hcA : CharP A ℓ := by
    apply (CharP.charP_iff_prime_eq_zero hℓ).mpr
    apply IsFractionRing.injective A K
    rw [map_natCast, hK, map_zero]
  obtain ⟨N, rfl⟩ : ∃ N, ℓ = N + 1 := ⟨ℓ - 1, (Nat.succ_pred_eq_of_pos hℓ.pos).symm⟩
  have hN : 1 ≤ N := by have := hℓ.two_le; omega
  have hPD' := hPD
  obtain ⟨hFT, hNZ, -, h𝔭max, hmA, hgm, hg0, huv, hpeq, -⟩ := hPD'
  haveI := hNZ
  haveI h𝔭 : 𝔭.IsPrime := h𝔭max.isPrime
  obtain ⟨⟨hdom, hdvr, hirr⟩, -⟩ := wcpa_dj_llsm_kpkn_branch_dvrs Ω W A 𝔭 u v g hPD
  haveI := hdom
  haveI := hdvr
  have RL := wcLlsASb_residue_lift Ω W A 𝔭 hFT h𝔭max hmA
  set mA := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) with hmAdef
  set J := Ideal.span {v} ⊔ mA with hJdef

  have hne0 : ∀ a : A, a ∉ 𝔭 → a ≠ 0 := fun a ha h => ha (h ▸ 𝔭.zero_mem)
  have hpow : ∀ (a : A) (j : ℕ), a ∉ 𝔭 → a ^ j ∉ 𝔭 := fun a j ha h => ha (h𝔭.mem_of_pow_mem j h)
  have haW : ∀ x : ↥W, x ≠ 0 → algebraMap ↥W A x ≠ 0 := by
    intro x hx h
    rw [Algebra.algebraMap_eq_smul_one] at h
    rcases smul_eq_zero.mp h with h | h
    · exact hx h
    · exact one_ne_zero h
  have hφ : ∀ a : A, a ≠ 0 → algebraMap A K a ≠ 0 := fun a ha =>
    (map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr ha
  have hwA : ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → algebraMap ↥W A x ∈ mA :=
    fun x hx => Ideal.mem_map_of_mem _ hx
  have hmAJ : ∀ x, x ∈ mA → x ∈ J := fun x hx => Ideal.mem_sup_right hx
  have hvJ : v ∈ J := Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton _))
  have hu𝔭 : u ∈ 𝔭 := by
    rw [hpeq]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have huJ : ∀ x, x ∈ J → u * x ∈ mA := by
    intro x hx
    obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp hx
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hy
    have e : u * (a * v + z) = a * algebraMap ↥W A g + u * z := by rw [← huv]; ring
    rw [e]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (hwA g hgm)) (Ideal.mul_mem_left _ _ hz)

  have hroot : ∀ (m : ℕ), 0 < m → ∀ x : ↥W, ∃ c : ↥W, c ^ m = x := by
    intro m hm x
    by_cases hx : x = 0
    · exact ⟨0, by rw [hx, zero_pow hm.ne']⟩
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (x : Ω) hm
    have hz0 : z ≠ 0 := by
      rintro rfl
      apply hx
      apply Subtype.ext
      rw [← hz, zero_pow hm.ne']
      rfl
    have hzW : z ∈ W := by
      rcases W.mem_or_inv_mem z with h | h
      · exact h
      · have e : z = (x : Ω) * (z⁻¹) ^ (m - 1) := by
          rw [← hz]
          obtain ⟨j, hj⟩ : ∃ j, m = j + 1 := ⟨m - 1, by omega⟩
          rw [hj, Nat.add_sub_cancel, inv_pow, pow_succ', mul_assoc,
            mul_inv_cancel₀ (pow_ne_zero _ hz0), mul_one]
        rw [e]
        exact mul_mem x.2 (pow_mem h _)
    refine ⟨⟨z, hzW⟩, Subtype.ext ?_⟩
    rw [SubmonoidClass.coe_pow]
    exact hz

  have hle : J ≤ (wcKpknBrI W A 𝔭 v).comap (algebraMap A (Localization.AtPrime 𝔭)) := by
    apply sup_le
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      show algebraMap A (Localization.AtPrime 𝔭) v ∈ wcKpknBrI W A 𝔭 v
      exact Ideal.mem_sup_right (Ideal.subset_span (Set.mem_singleton _))
    · exact Ideal.map_le_iff_le_comap.mp le_sup_left
  have upow : ∀ (e : ℕ) (t : A), t ∉ 𝔭 → t * u ^ e ∉ J := by
    intro e t ht hmem
    have hι : algebraMap A (Localization.AtPrime 𝔭) (t * u ^ e) ∈ wcKpknBrI W A 𝔭 v := hle hmem
    have h0 := Ideal.Quotient.eq_zero_iff_mem.mpr hι
    rw [map_mul, map_pow, map_mul, map_pow] at h0
    have h4 : Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v) (algebraMap A (Localization.AtPrime 𝔭) t) ≠ 0 :=
      ((IsLocalization.map_units (Localization.AtPrime 𝔭)
        (⟨t, ht⟩ : 𝔭.primeCompl)).map _).ne_zero
    exact mul_ne_zero h4 (pow_ne_zero e hirr.ne_zero) h0
  have hIle : wcKpknBrI W A 𝔭 v ≤ J.map (algebraMap A (Localization.AtPrime 𝔭)) := by
    apply sup_le
    · exact Ideal.map_mono le_sup_right
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact Ideal.mem_map_of_mem _ (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton _)))
  have hinj : Function.Injective (algebraMap A (Localization.AtPrime 𝔭)) :=
    IsLocalization.injective (Localization.AtPrime 𝔭) (Ideal.primeCompl_le_nonZeroDivisors 𝔭)
  have pull : ∀ z : A, algebraMap A (Localization.AtPrime 𝔭) z ∈ wcKpknBrI W A 𝔭 v →
      ∃ s : A, s ∉ 𝔭 ∧ s * z ∈ J := by
    intro z hz
    obtain ⟨⟨⟨a, ha⟩, ⟨s, hs⟩⟩, h⟩ :=
      (IsLocalization.mem_map_algebraMap_iff 𝔭.primeCompl (Localization.AtPrime 𝔭)).mp (hIle hz)
    refine ⟨s, hs, ?_⟩
    have hzs : z * s = a := hinj (by rw [map_mul]; exact h)
    rw [mul_comm, hzs]
    exact ha
  have DICH : ∀ X : A, (∃ t : A, t ∉ 𝔭 ∧ t * X ∈ J) ∨
      ∃ (e : ℕ) (σ ε : A), σ ∉ 𝔭 ∧ ε ∉ 𝔭 ∧ σ * X - u ^ e * ε ∈ J := by
    intro X
    by_cases hX0 : Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v) (algebraMap A (Localization.AtPrime 𝔭) X) = 0
    · left
      exact pull X (Ideal.Quotient.eq_zero_iff_mem.mp hX0)
    · right
      obtain ⟨e, U, hU⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hX0 hirr
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (U : Localization.AtPrime 𝔭 ⧸ wcKpknBrI W A 𝔭 v)
      obtain ⟨⟨a, ⟨s, hs⟩⟩, hya⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl y
      have hspec : y * algebraMap A (Localization.AtPrime 𝔭) s =
          algebraMap A (Localization.AtPrime 𝔭) a := by
        rw [← hya]; exact IsLocalization.mk'_spec _ a ⟨s, hs⟩
      have hmka : Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v) (algebraMap A (Localization.AtPrime 𝔭) a) =
          (U : Localization.AtPrime 𝔭 ⧸ wcKpknBrI W A 𝔭 v) *
            Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v) (algebraMap A (Localization.AtPrime 𝔭) s) := by
        rw [← hspec, map_mul, hy]
      have hkey : Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v)
          (algebraMap A (Localization.AtPrime 𝔭) (s * X - u ^ e * a)) = 0 := by
        simp only [map_sub, map_mul, map_pow]
        rw [hU, hmka]
        ring
      obtain ⟨s', hs', hJ'⟩ := pull _ (Ideal.Quotient.eq_zero_iff_mem.mp hkey)
      have ha : a ∉ 𝔭 := by
        intro ha
        have hunit : IsUnit (Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v)
            (algebraMap A (Localization.AtPrime 𝔭) a)) := by
          rw [hmka]
          exact U.isUnit.mul ((IsLocalization.map_units (Localization.AtPrime 𝔭)
            (⟨s, hs⟩ : 𝔭.primeCompl)).map _)
        rw [hpeq] at ha
        obtain ⟨y1, hy1, y2, hy2, hsum⟩ := Submodule.mem_sup.mp ha
        obtain ⟨α', β, hαβ⟩ := Ideal.mem_span_pair.mp hy1
        have hv0 : Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v)
            (algebraMap A (Localization.AtPrime 𝔭) v) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr
            (Ideal.mem_sup_right (Ideal.subset_span (Set.mem_singleton _)))
        have hy20 : Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v)
            (algebraMap A (Localization.AtPrime 𝔭) y2) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_left (Ideal.mem_map_of_mem _ hy2))
        have hdiv : Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v) (algebraMap A (Localization.AtPrime 𝔭) u) ∣
            Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v) (algebraMap A (Localization.AtPrime 𝔭) a) := by
          refine ⟨Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v)
            (algebraMap A (Localization.AtPrime 𝔭) α'), ?_⟩
          rw [← hsum, ← hαβ]
          simp only [map_add, map_mul, hv0, hy20]
          ring
        exact hirr.not_isUnit (isUnit_of_dvd_unit hdiv hunit)
      refine ⟨e, s' * s, s' * a, h𝔭.mul_notMem hs' hs, h𝔭.mul_notMem hs' ha, ?_⟩
      have hre : s' * s * X - u ^ e * (s' * a) = s' * (s * X - u ^ e * a) := by ring
      rw [hre]
      exact hJ'

  have single : ∀ x : A, x ∈ mA → ∃ (c : ↥W) (y : A), c ∈ IsLocalRing.maximalIdeal ↥W ∧
      x = algebraMap ↥W A c * y := by
    intro x hx
    have hx' : x ∈ Submodule.span A
        (algebraMap ↥W A '' (IsLocalRing.maximalIdeal ↥W : Set ↥W)) := hx
    clear hx
    induction hx' using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨c, hc, rfl⟩ := hy
      exact ⟨c, 1, hc, (mul_one _).symm⟩
    | zero => exact ⟨0, 0, Ideal.zero_mem _, (mul_zero _).symm⟩
    | add y₁ y₂ _ _ ih₁ ih₂ =>
      obtain ⟨c₁, a₁, hc₁, rfl⟩ := ih₁
      obtain ⟨c₂, a₂, hc₂, rfl⟩ := ih₂
      rcases ValuationRing.dvd_total c₁ c₂ with ⟨q, rfl⟩ | ⟨q, rfl⟩
      · exact ⟨c₁, a₁ + algebraMap ↥W A q * a₂, hc₁, by rw [map_mul]; ring⟩
      · exact ⟨c₂, algebraMap ↥W A q * a₁ + a₂, hc₂, by rw [map_mul]; ring⟩
    | smul a y _ ih =>
      obtain ⟨c, y', hc, rfl⟩ := ih
      exact ⟨c, a * y', hc, by rw [smul_eq_mul]; ring⟩
  have CF : ∀ x y : A, x ∈ mA → y ∈ mA → ∃ (c : ↥W) (a b : A),
      c ∈ IsLocalRing.maximalIdeal ↥W ∧ x = algebraMap ↥W A c * a ∧ y = algebraMap ↥W A c * b := by
    intro x y hx hy
    obtain ⟨c₁, a₁, hc₁, rfl⟩ := single x hx
    obtain ⟨c₂, a₂, hc₂, rfl⟩ := single y hy
    rcases ValuationRing.dvd_total c₁ c₂ with ⟨q, rfl⟩ | ⟨q, rfl⟩
    · exact ⟨c₁, a₁, algebraMap ↥W A q * a₂, hc₁, rfl, by rw [map_mul]; ring⟩
    · exact ⟨c₂, algebraMap ↥W A q * a₁, a₂, hc₂, by rw [map_mul]; ring, rfl⟩

  have FROB : ∀ y : A, ∃ (s : A) (z : ℕ → A), s ∉ 𝔭 ∧
      s ^ (N + 1) * y - ∑ i ∈ Finset.range (N + 1), z i ^ (N + 1) * u ^ i ∈ J := by
    let S : Subring A := (frobenius A (N + 1)).range
    have hint : Algebra.IsIntegral S A := by
      constructor
      intro x
      refine ⟨Polynomial.X ^ (N + 1) - Polynomial.C ⟨x ^ (N + 1),
        RingHom.mem_range.mpr ⟨x, frobenius_def (N + 1) x⟩⟩,
        Polynomial.monic_X_pow_sub_C _ (Nat.succ_ne_zero N), ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
      exact sub_self _
    have hft : Algebra.FiniteType S A := by
      obtain ⟨G, hG⟩ := hFT.out
      refine ⟨⟨G, ?_⟩⟩
      rw [eq_top_iff]
      intro x hxtop
      clear hxtop
      have hx : x ∈ Algebra.adjoin ↥W (G : Set A) := by rw [hG]; exact Algebra.mem_top
      induction hx using Algebra.adjoin_induction with
      | mem x hx => exact Algebra.subset_adjoin hx
      | algebraMap r =>
        obtain ⟨c, hc⟩ := hroot (N + 1) (Nat.succ_pos N) r
        have e : algebraMap ↥W A r = algebraMap S A ⟨(algebraMap ↥W A c) ^ (N + 1),
            RingHom.mem_range.mpr ⟨_, frobenius_def (N + 1) _⟩⟩ := by
          show _ = (algebraMap ↥W A c) ^ (N + 1)
          rw [← map_pow, hc]
        rw [e]
        exact Subalgebra.algebraMap_mem _ _
      | add x y _ _ hx hy => exact add_mem hx hy
      | mul x y _ _ hx hy => exact mul_mem hx hy
    haveI := hint
    haveI := hft
    haveI hfin : Module.Finite S A := Algebra.IsIntegral.finite

    have htay : ∀ (kk : ℕ) (y : A), ∃ (γ : ℕ → ↥W) (q : A),
        y - ∑ i ∈ Finset.range kk, algebraMap ↥W A (γ i) * u ^ i - u ^ kk * q ∈ J := by
      intro kk
      induction kk with
      | zero => intro y; exact ⟨0, y, by simp⟩
      | succ kk ih =>
        intro y
        obtain ⟨γ₀, hγ₀⟩ := RL y
        rw [hpeq, Submodule.mem_sup] at hγ₀
        obtain ⟨a, ha, m, hm, hsum⟩ := hγ₀
        obtain ⟨a', b', hab⟩ := Ideal.mem_span_pair.mp ha
        obtain ⟨γ', q', hq'⟩ := ih a'
        refine ⟨fun i => if i = 0 then γ₀ else γ' (i - 1), q', ?_⟩
        rw [Finset.sum_range_succ']
        have h1 : ∑ i ∈ Finset.range kk,
            algebraMap ↥W A ((fun i => if i = 0 then γ₀ else γ' (i - 1)) (i + 1)) * u ^ (i + 1) =
            u * ∑ i ∈ Finset.range kk, algebraMap ↥W A (γ' i) * u ^ i := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          simp only [Nat.add_one_ne_zero, ite_false, Nat.add_sub_cancel]
          ring
        have h0 : algebraMap ↥W A ((fun i => if i = 0 then γ₀ else γ' (i - 1)) 0) * u ^ 0 =
            algebraMap ↥W A γ₀ := by
          simp
        rw [h1, h0]
        have key : y - (u * ∑ i ∈ Finset.range kk, algebraMap ↥W A (γ' i) * u ^ i +
            algebraMap ↥W A γ₀) - u ^ (kk + 1) * q' =
            (b' * v + m) + u * (a' - ∑ i ∈ Finset.range kk, algebraMap ↥W A (γ' i) * u ^ i -
              u ^ kk * q') := by
          linear_combination (-1 : A) * hsum - hab
        rw [key]
        exact Ideal.add_mem _ (Ideal.add_mem _ (Ideal.mul_mem_left _ _ hvJ) (hmAJ _ hm))
          (Ideal.mul_mem_left _ u hq')

    let Nm : Submodule S A :=
      { carrier := {x | ∃ z : ℕ → A, x - ∑ i ∈ Finset.range (N + 1), z i ^ (N + 1) * u ^ i ∈ J}
        add_mem' := by
          rintro a b ⟨z, hz⟩ ⟨z', hz'⟩
          refine ⟨z + z', ?_⟩
          have e : a + b - ∑ i ∈ Finset.range (N + 1), (z + z') i ^ (N + 1) * u ^ i =
              (a - ∑ i ∈ Finset.range (N + 1), z i ^ (N + 1) * u ^ i) +
                (b - ∑ i ∈ Finset.range (N + 1), z' i ^ (N + 1) * u ^ i) := by
            simp only [Pi.add_apply, add_pow_char, add_mul, Finset.sum_add_distrib]
            ring
          rw [e]
          exact Ideal.add_mem _ hz hz'
        zero_mem' := ⟨0, by simp [zero_pow (Nat.succ_ne_zero N)]⟩
        smul_mem' := by
          rintro ⟨r, hr⟩ x ⟨z, hz⟩
          obtain ⟨a, rfl⟩ := RingHom.mem_range.mp hr
          refine ⟨fun i => a * z i, ?_⟩
          have e : (⟨frobenius A (N + 1) a, hr⟩ : S) • x -
              ∑ i ∈ Finset.range (N + 1), (a * z i) ^ (N + 1) * u ^ i =
              a ^ (N + 1) * (x - ∑ i ∈ Finset.range (N + 1), z i ^ (N + 1) * u ^ i) := by
            rw [Subring.smul_def, smul_eq_mul]
            simp only [frobenius_def, mul_pow, mul_sub, Finset.mul_sum, mul_assoc]
          rw [e]
          exact Ideal.mul_mem_left _ _ hz }
    let 𝔮 : Ideal S := 𝔭.comap S.subtype
    have hfg : (⊤ : Submodule S (A ⧸ Nm)).FG := Module.Finite.fg_top
    have hle2 : (⊤ : Submodule S (A ⧸ Nm)) ≤ 𝔮 • ⊤ := by
      rintro x -
      obtain ⟨y', rfl⟩ := Submodule.Quotient.mk_surjective Nm x
      obtain ⟨γ, q, hq⟩ := htay (N + 1) y'
      choose c hc using fun i => hroot (N + 1) (Nat.succ_pos N) (γ i)
      have hmem : y' - u ^ (N + 1) * q ∈ Nm := by
        refine ⟨fun i => algebraMap ↥W A (c i), ?_⟩
        have e : y' - u ^ (N + 1) * q -
            ∑ i ∈ Finset.range (N + 1), (algebraMap ↥W A (c i)) ^ (N + 1) * u ^ i =
            y' - ∑ i ∈ Finset.range (N + 1), algebraMap ↥W A (γ i) * u ^ i - u ^ (N + 1) * q := by
          simp only [← map_pow, hc]
          ring
        rw [e]
        exact hq
      let T : S := ⟨u ^ (N + 1), RingHom.mem_range.mpr ⟨u, frobenius_def (N + 1) u⟩⟩
      have hT : T ∈ 𝔮 := Ideal.mem_comap.mpr (Ideal.pow_mem_of_mem 𝔭 hu𝔭 (N + 1) (Nat.succ_pos N))
      have e : (Submodule.Quotient.mk y' : A ⧸ Nm) = T • Submodule.Quotient.mk q := by
        rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.eq]
        exact hmem
      rw [e]
      exact Submodule.smul_mem_smul hT Submodule.mem_top
    obtain ⟨r, hr1, hr⟩ :=
      Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul 𝔮 ⊤ hfg hle2
    obtain ⟨s, hs⟩ := RingHom.mem_range.mp r.2
    intro y
    have hy := hr (Submodule.Quotient.mk y) Submodule.mem_top
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hy
    obtain ⟨z, hz⟩ := hy
    refine ⟨s, z, ?_, ?_⟩
    · intro hs𝔭
      apply h𝔭max.ne_top
      rw [Ideal.eq_top_iff_one]
      have h1 : (r : A) ∈ 𝔭 := by
        rw [← hs, frobenius_def]
        exact Ideal.pow_mem_of_mem 𝔭 hs𝔭 (N + 1) (Nat.succ_pos N)
      have h2 : ((r - 1 : S) : A) ∈ 𝔭 := Ideal.mem_comap.mp hr1
      have e : (1 : A) = (r : A) - ((r - 1 : S) : A) := by push_cast; ring
      rw [e]
      exact Ideal.sub_mem _ h1 h2
    · have e : s ^ (N + 1) * y = r • y := by
        rw [Subring.smul_def, smul_eq_mul, ← hs, frobenius_def]
      rw [e]
      exact hz

  have hmod : ∀ j kk : ℕ, j < N → ((j + 1) + (N + 1) * kk) % (N + 1) = j + 1 := by
    intro j kk hj
    rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (by omega)]
  have ORD : ∀ z : ℕ → A, (∀ s : A, s ∉ 𝔭 →
      s * ∑ j ∈ Finset.range N, z (j + 1) ^ (N + 1) * u ^ (j + 1) ∉ J) →
      ∃ (m : ℕ) (s ε : A), ¬ (N + 1) ∣ m ∧ s ∉ 𝔭 ∧ ε ∉ 𝔭 ∧
        s * ∑ j ∈ Finset.range N, z (j + 1) ^ (N + 1) * u ^ (j + 1) - u ^ m * ε ∈ J := by
    intro z hz
    have hex : ∀ j : ℕ, ∃ (σ η : A) (kk : ℕ), σ ∉ 𝔭 ∧ σ * z (j + 1) - η * u ^ kk ∈ J ∧
        (η ∉ 𝔭 ∨ η = 0) := by
      intro j
      rcases DICH (z (j + 1)) with ⟨s, hs, hsz⟩ | ⟨kk, σ, ε, hσ, hε, hσz⟩
      · exact ⟨s, 0, 0, hs, by rw [zero_mul, sub_zero]; exact hsz, Or.inr rfl⟩
      · refine ⟨σ, ε, kk, hσ, ?_, Or.inl hε⟩
        have e : σ * z (j + 1) - ε * u ^ kk = σ * z (j + 1) - u ^ kk * ε := by ring
        rw [e]; exact hσz
    choose σ η kk hσ hσz hη using hex
    obtain ⟨e, he⟩ : ∃ e : ℕ → ℕ, ∀ j, e j = (j + 1) + (N + 1) * kk j := ⟨_, fun _ => rfl⟩
    obtain ⟨cc, hcc⟩ : ∃ cc : ℕ → A, ∀ j, cc j = ∏ j' ∈ (Finset.range N).erase j, σ j' ^ (N + 1) :=
      ⟨_, fun _ => rfl⟩
    obtain ⟨S, hSdef⟩ : ∃ S : A, S = ∏ j ∈ Finset.range N, σ j ^ (N + 1) := ⟨_, rfl⟩
    have hprod : ∀ T : Finset ℕ, ∏ j ∈ T, σ j ^ (N + 1) ∉ 𝔭 := by
      intro T h
      obtain ⟨i, _, hi⟩ := (Ideal.IsPrime.prod_mem_iff (hp := h𝔭)).mp h
      exact hσ i (h𝔭.mem_of_pow_mem _ hi)
    have hS : ∀ j ∈ Finset.range N, S = σ j ^ (N + 1) * cc j := fun j hj => by
      rw [hSdef, hcc]; exact (Finset.mul_prod_erase _ _ hj).symm
    have hterm : ∀ j ∈ Finset.range N, S * (z (j + 1) ^ (N + 1) * u ^ (j + 1)) -
        cc j * η j ^ (N + 1) * u ^ (e j) ∈ J := by
      intro j hj
      have h1 := Ideal.mem_of_dvd _
        (sub_dvd_pow_sub_pow (σ j * z (j + 1)) (η j * u ^ (kk j)) (N + 1)) (hσz j)
      have e1 : S * (z (j + 1) ^ (N + 1) * u ^ (j + 1)) - cc j * η j ^ (N + 1) * u ^ (e j) =
          (cc j * u ^ (j + 1)) * ((σ j * z (j + 1)) ^ (N + 1) - (η j * u ^ (kk j)) ^ (N + 1)) := by
        rw [hS j hj, he j]; ring
      rw [e1]; exact Ideal.mul_mem_left _ _ h1
    have hsum : S * ∑ j ∈ Finset.range N, z (j + 1) ^ (N + 1) * u ^ (j + 1) -
        ∑ j ∈ Finset.range N, cc j * η j ^ (N + 1) * u ^ (e j) ∈ J := by
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]; exact Ideal.sum_mem _ hterm
    have hsumI : ∑ j ∈ (Finset.range N).filter (fun j => η j ∉ 𝔭), cc j * η j ^ (N + 1) * u ^ (e j) =
        ∑ j ∈ Finset.range N, cc j * η j ^ (N + 1) * u ^ (e j) := by
      apply Finset.sum_filter_of_ne
      intro j _ hne
      rcases hη j with h | h
      · exact h
      · exfalso; apply hne; rw [h, zero_pow (Nat.succ_ne_zero N), mul_zero, zero_mul]
    have hIne : ((Finset.range N).filter (fun j => η j ∉ 𝔭)).Nonempty := by
      rw [Finset.nonempty_iff_ne_empty]
      intro hI
      apply hz S (by rw [hSdef]; exact hprod _)
      rw [← hsumI, hI, Finset.sum_empty, sub_zero] at hsum
      exact hsum
    obtain ⟨js, hjsI, hjsmin⟩ := Finset.exists_min_image _ e hIne
    have hjsR : js ∈ Finset.range N := (Finset.mem_filter.mp hjsI).1
    have hηjs : η js ∉ 𝔭 := (Finset.mem_filter.mp hjsI).2
    have hlt : ∀ j ∈ ((Finset.range N).filter (fun j => η j ∉ 𝔭)).erase js, e js < e j := by
      intro j hj
      obtain ⟨hne, hjI⟩ := Finset.mem_erase.mp hj
      have hjR := (Finset.mem_filter.mp hjI).1
      refine lt_of_le_of_ne (hjsmin j hjI) ?_
      intro heq
      apply hne
      have h1 : e js % (N + 1) = e j % (N + 1) := by rw [heq]
      rw [he js, he j, hmod _ _ (Finset.mem_range.mp hjsR), hmod _ _ (Finset.mem_range.mp hjR)] at h1
      omega
    refine ⟨e js, S, cc js * η js ^ (N + 1) + u * ∑ j ∈ ((Finset.range N).filter
      (fun j => η j ∉ 𝔭)).erase js, cc j * η j ^ (N + 1) * u ^ (e j - e js - 1), ?_,
      by rw [hSdef]; exact hprod _, ?_, ?_⟩
    · intro h
      rw [he js] at h
      have h2 := Nat.mod_eq_zero_of_dvd h
      rw [hmod _ _ (Finset.mem_range.mp hjsR)] at h2
      omega
    · intro h
      have h1 : cc js * η js ^ (N + 1) ∈ 𝔭 := by
        have e1 : cc js * η js ^ (N + 1) = (cc js * η js ^ (N + 1) + u * ∑ j ∈ ((Finset.range N).filter
            (fun j => η j ∉ 𝔭)).erase js, cc j * η j ^ (N + 1) * u ^ (e j - e js - 1)) -
            u * ∑ j ∈ ((Finset.range N).filter
            (fun j => η j ∉ 𝔭)).erase js, cc j * η j ^ (N + 1) * u ^ (e j - e js - 1) := by ring
        rw [e1]; exact Ideal.sub_mem _ h (Ideal.mul_mem_right _ _ hu𝔭)
      rcases h𝔭.mem_or_mem h1 with h2 | h2
      · rw [hcc] at h2; exact hprod _ h2
      · exact hηjs (h𝔭.mem_of_pow_mem _ h2)
    · have hfac : ∑ j ∈ Finset.range N, cc j * η j ^ (N + 1) * u ^ (e j) =
          u ^ (e js) * (cc js * η js ^ (N + 1) + u * ∑ j ∈ ((Finset.range N).filter
            (fun j => η j ∉ 𝔭)).erase js, cc j * η j ^ (N + 1) * u ^ (e j - e js - 1)) := by
        rw [← hsumI, ← Finset.add_sum_erase _ _ hjsI, mul_add, Finset.mul_sum, Finset.mul_sum]
        congr 1
        · ring
        · apply Finset.sum_congr rfl
          intro j hj
          have := hlt j hj
          have hexp : e j = e js + 1 + (e j - e js - 1) := by omega
          rw [hexp, pow_add, pow_add, pow_one]
          have hexp2 : e js + 1 + (e j - e js - 1) - e js - 1 = e j - e js - 1 := by omega
          rw [hexp2]; ring
      rw [← hfac]; exact hsum

  generalize hF : f₀ - (h₀ ^ (N + 1) - h₀) = F at hE hmax
  rcases ValuationRing.dvd_total lam₁ lam₂ with ⟨q₁, hq₁⟩ | h
  swap
  · exact absurd h hndvd
  have hq₁0 : q₁ ≠ 0 := by rintro rfl; rw [mul_zero] at hq₁; exact hl2 hq₁
  have hq₁m : q₁ ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hm
    have hu : IsUnit q₁ := IsLocalRing.notMem_maximalIdeal.mp hm
    exact hndvd ⟨↑hu.unit⁻¹, by rw [hq₁, mul_assoc, hu.mul_val_inv, mul_one]⟩

  obtain ⟨μ, hμq⟩ := hroot (N + 1) (Nat.succ_pos N) q₁
  have hμ0 : μ ≠ 0 := by
    rintro rfl; apply hq₁0; rw [← hμq, zero_pow (Nat.succ_ne_zero N)]
  have hμm : μ ∈ IsLocalRing.maximalIdeal ↥W :=
    (IsLocalRing.maximalIdeal.isMaximal ↥W).isPrime.mem_of_pow_mem (N + 1)
      (by rw [hμq]; exact hq₁m)
  have hlam : lam₂ = lam₁ * μ ^ (N + 1) := by rw [hμq]; exact hq₁

  obtain ⟨B₁, hB₁⟩ : ∃ B, B = u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁ := ⟨_, rfl⟩
  obtain ⟨B₀, hB₀⟩ : ∃ B, B = u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀ := ⟨_, rfl⟩
  rw [← hB₁, ← hB₀] at hE
  have E : F * algebraMap A K B₁ * algebraMap A K (algebraMap ↥W A μ) ^ (N + 1) =
      algebraMap A K B₀ := by
    apply mul_left_cancel₀ (hφ _ (haW _ hl1))
    rw [hlam] at hE
    simp only [map_mul, map_pow] at hE
    linear_combination hE
  have hB₁m : B₁ - u ^ n * ε₁ ∈ J := by
    rw [hB₁, add_assoc, add_sub_cancel_left]
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hvJ)
      (hmAJ _ (Ideal.mul_mem_right _ _ (hwA w hw)))
  have hB₁0 : B₁ ≠ 0 := by
    intro h0
    apply upow n ε₁ hε₁
    have e : ε₁ * u ^ n = -(B₁ - u ^ n * ε₁) := by rw [h0]; ring
    rw [e]; exact neg_mem hB₁m

  obtain ⟨s, z, hs, hPz⟩ := FROB (B₀ * B₁ ^ N)
  obtain ⟨D, hD⟩ : ∃ D, D = algebraMap ↥W A μ * s * B₁ := ⟨_, rfl⟩
  have hDm : D ∈ mA := by
    rw [hD]; exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _ (hwA μ hμm))
  have hφD : algebraMap A K D ≠ 0 :=
    hφ _ (by rw [hD]; exact mul_ne_zero (mul_ne_zero (haW μ hμ0) (hne0 s hs)) hB₁0)
  obtain ⟨h', hh'⟩ : ∃ h' : K, h' = algebraMap A K (z 0) / algebraMap A K D := ⟨_, rfl⟩
  obtain ⟨Y, hY⟩ : ∃ Y : A, Y = s ^ (N + 1) * (B₀ * B₁ ^ N) - z 0 ^ (N + 1) + z 0 * D ^ N :=
    ⟨_, rfl⟩
  obtain ⟨Y', hY'⟩ : ∃ Y' : A, Y' = ∑ j ∈ Finset.range N, z (j + 1) ^ (N + 1) * u ^ (j + 1) :=
    ⟨_, rfl⟩
  have hR : (F - (h' ^ (N + 1) - h')) * algebraMap A K (s ^ (N + 1) * B₁ ^ (N + 1)) *
      algebraMap A K (algebraMap ↥W A (μ ^ (N + 1))) = algebraMap A K Y := by
    have e1 : algebraMap A K (s ^ (N + 1) * B₁ ^ (N + 1)) *
        algebraMap A K (algebraMap ↥W A (μ ^ (N + 1))) = algebraMap A K D ^ (N + 1) := by
      rw [hD]; simp only [map_mul, map_pow]; ring
    have e2 : h' * algebraMap A K D = algebraMap A K (z 0) := by
      rw [hh']; exact div_mul_cancel₀ _ hφD
    calc (F - (h' ^ (N + 1) - h')) * algebraMap A K (s ^ (N + 1) * B₁ ^ (N + 1)) *
          algebraMap A K (algebraMap ↥W A (μ ^ (N + 1)))
        = (F - (h' ^ (N + 1) - h')) * algebraMap A K D ^ (N + 1) := by rw [mul_assoc, e1]
      _ = F * algebraMap A K D ^ (N + 1) - (h' * algebraMap A K D) ^ (N + 1) +
            (h' * algebraMap A K D) * algebraMap A K D ^ N := by ring
      _ = F * algebraMap A K D ^ (N + 1) - algebraMap A K (z 0) ^ (N + 1) +
            algebraMap A K (z 0) * algebraMap A K D ^ N := by rw [e2]
      _ = algebraMap A K Y := by
        rw [hY]; simp only [map_add, map_sub, map_mul, map_pow]
        rw [hD]; simp only [map_mul]
        linear_combination (algebraMap A K s ^ (N + 1) * algebraMap A K B₁ ^ N) * E
  have hC : Y - Y' ∈ J := by
    have hsplit : ∑ i ∈ Finset.range (N + 1), z i ^ (N + 1) * u ^ i =
        ∑ j ∈ Finset.range N, z (j + 1) ^ (N + 1) * u ^ (j + 1) + z 0 ^ (N + 1) := by
      rw [Finset.sum_range_succ', pow_zero, mul_one]
    have e : Y - Y' = (s ^ (N + 1) * (B₀ * B₁ ^ N) -
        ∑ i ∈ Finset.range (N + 1), z i ^ (N + 1) * u ^ i) + z 0 * D ^ N := by
      rw [hY, hY', hsplit]; ring
    rw [e]
    exact Ideal.add_mem _ hPz
      (hmAJ _ (Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hDm N (by omega))))
  have hρ : B₁ ^ (N + 1) - u ^ (n * (N + 1)) * ε₁ ^ (N + 1) ∈ J := by
    have h2 := Ideal.mem_of_dvd _ (sub_dvd_pow_sub_pow B₁ (u ^ n * ε₁) (N + 1)) hB₁m
    rwa [mul_pow, ← pow_mul] at h2

  by_cases hYP : ∃ s₃ : A, s₃ ∉ 𝔭 ∧ s₃ * Y ∈ J
  · exfalso
    obtain ⟨s₃, hs₃, hs₃Y⟩ := hYP
    have hum : u * s₃ * Y ∈ mA := by rw [mul_assoc]; exact huJ _ hs₃Y
    obtain ⟨wc, G, hwc, hG⟩ := single _ hum
    obtain ⟨δ, qq, hδ0, hδm, hqm, hwcδ⟩ : ∃ δ qq : ↥W, δ ≠ 0 ∧ δ ∈ IsLocalRing.maximalIdeal ↥W ∧
        qq ∈ IsLocalRing.maximalIdeal ↥W ∧ wc = δ * qq := by
      by_cases hwc0 : wc = 0
      · exact ⟨g, 0, hg0, hgm, Ideal.zero_mem _, by rw [hwc0, mul_zero]⟩
      · obtain ⟨c, hc⟩ := hroot 2 (by norm_num) wc
        have hcm : c ∈ IsLocalRing.maximalIdeal ↥W :=
          (IsLocalRing.maximalIdeal.isMaximal ↥W).isPrime.mem_of_pow_mem 2 (by rw [hc]; exact hwc)
        refine ⟨c, c, ?_, hcm, hcm, by rw [← hc, sq]⟩
        rintro rfl; apply hwc0; rw [← hc, zero_pow (by norm_num)]

    obtain ⟨θ, hθ⟩ : ∃ θ : ↥W, θ ^ (N + 1) - μ ^ N * θ + δ = 0 := by
      obtain ⟨M, hM⟩ : ∃ M, N = M + 1 := ⟨N - 1, by omega⟩
      subst hM
      have hdeg : (Polynomial.X ^ (M + 1 + 1) - Polynomial.C ((μ : Ω) ^ (M + 1)) * Polynomial.X +
          Polynomial.C (δ : Ω) : Polynomial Ω).natDegree = M + 1 + 1 := by
        compute_degree!
      obtain ⟨θ₀, hθ₀⟩ := IsAlgClosed.exists_root
        (Polynomial.X ^ (M + 1 + 1) - Polynomial.C ((μ : Ω) ^ (M + 1)) * Polynomial.X +
          Polynomial.C (δ : Ω) : Polynomial Ω)
        (Polynomial.natDegree_pos_iff_degree_pos.mp (by rw [hdeg]; omega)).ne'
      have hθ₀' : θ₀ ^ (M + 1 + 1) - (μ : Ω) ^ (M + 1) * θ₀ + (δ : Ω) = 0 := by
        simpa [Polynomial.IsRoot] using hθ₀
      have hθW : θ₀ ∈ W := by
        rcases W.mem_or_inv_mem θ₀ with h | h
        · exact h
        · have hθ0 : θ₀ ≠ 0 := by
            rintro rfl
            apply hδ0
            apply Subtype.ext
            show (δ : Ω) = 0
            have h2 : (0 : Ω) ^ (M + 1 + 1) = 0 := zero_pow (by omega)
            linear_combination hθ₀' - h2
          have e : θ₀ = (μ : Ω) ^ (M + 1) * θ₀⁻¹ ^ M - (δ : Ω) * θ₀⁻¹ ^ (M + 1) := by
            have h1 : θ₀⁻¹ * θ₀ = 1 := inv_mul_cancel₀ hθ0
            have h2 : θ₀⁻¹ ^ (M + 1) * θ₀ ^ (M + 1) = 1 := by rw [← mul_pow, h1, one_pow]
            linear_combination θ₀⁻¹ ^ (M + 1) * hθ₀' - θ₀ * h2 + (μ : Ω) ^ (M + 1) * θ₀⁻¹ ^ M * h1
          rw [e]
          exact sub_mem (mul_mem (pow_mem μ.2 _) (pow_mem h _)) (mul_mem δ.2 (pow_mem h _))
      obtain ⟨θW, hθWdef⟩ : ∃ θW : ↥W, (θW : Ω) = θ₀ := ⟨⟨θ₀, hθW⟩, rfl⟩
      refine ⟨θW, ?_⟩
      apply Subtype.ext
      push_cast
      rw [hθWdef]; exact hθ₀'
    have hφμ : algebraMap A K (algebraMap ↥W A μ) ≠ 0 := hφ _ (haW μ hμ0)
    obtain ⟨h'', hh''⟩ : ∃ h'' : K, h'' = algebraMap A K (algebraMap ↥W A θ) /
        algebraMap A K (algebraMap ↥W A μ) := ⟨_, rfl⟩
    have e2 : h'' * algebraMap A K (algebraMap ↥W A μ) = algebraMap A K (algebraMap ↥W A θ) := by
      rw [hh'']; exact div_mul_cancel₀ _ hφμ
    have hθK : algebraMap A K (algebraMap ↥W A θ) ^ (N + 1) -
        algebraMap A K (algebraMap ↥W A μ) ^ N * algebraMap A K (algebraMap ↥W A θ) +
        algebraMap A K (algebraMap ↥W A δ) = 0 := by
      have h1 := congrArg (algebraMap A K) (congrArg (algebraMap ↥W A) hθ)
      simp only [map_add, map_sub, map_mul, map_pow, map_zero] at h1
      exact h1
    have hP2 : (h'' ^ (N + 1) - h'') * algebraMap A K (algebraMap ↥W A μ) ^ (N + 1) =
        -algebraMap A K (algebraMap ↥W A δ) := by
      have e3 : (h'' ^ (N + 1) - h'') * algebraMap A K (algebraMap ↥W A μ) ^ (N + 1) =
          (h'' * algebraMap A K (algebraMap ↥W A μ)) ^ (N + 1) -
            (h'' * algebraMap A K (algebraMap ↥W A μ)) * algebraMap A K (algebraMap ↥W A μ) ^ N := by
        ring
      rw [e3, e2]; linear_combination hθK
    have hx₁ : u * (s₃ * s ^ (N + 1) * (B₁ ^ (N + 1) - u ^ (n * (N + 1)) * ε₁ ^ (N + 1))) ∈ mA :=
      huJ _ (Ideal.mul_mem_left _ _ hρ)
    have hx₀ : u * (s₃ * s ^ (N + 1) * (B₁ ^ (N + 1) - u ^ (n * (N + 1)) * ε₁ ^ (N + 1))) +
        algebraMap ↥W A qq * G ∈ mA :=
      Ideal.add_mem _ hx₁ (Ideal.mul_mem_right _ _ (hwA qq hqm))
    obtain ⟨w', g₁', g₀', hw', hg₁', hg₀'⟩ := CF _ _ hx₁ hx₀
    have hε' : s₃ * s ^ (N + 1) * ε₁ ^ (N + 1) ∉ 𝔭 :=
      h𝔭.mul_notMem (h𝔭.mul_notMem hs₃ (hpow s _ hs)) (hpow ε₁ _ hε₁)
    have hId1 : u ^ (n * (N + 1) + 1) * (s₃ * s ^ (N + 1) * ε₁ ^ (N + 1)) + v * 0 +
        u * (s₃ * s ^ (N + 1) * (B₁ ^ (N + 1) - u ^ (n * (N + 1)) * ε₁ ^ (N + 1))) =
        u * s₃ * (s ^ (N + 1) * B₁ ^ (N + 1)) := by ring
    have hId0 : u ^ (n * (N + 1) + 1) * (s₃ * s ^ (N + 1) * ε₁ ^ (N + 1)) + v * 0 +
        (u * (s₃ * s ^ (N + 1) * (B₁ ^ (N + 1) - u ^ (n * (N + 1)) * ε₁ ^ (N + 1))) +
          algebraMap ↥W A qq * G) =
        u * s₃ * (s ^ (N + 1) * B₁ ^ (N + 1)) + algebraMap ↥W A qq * G := by ring
    have hR' := hR
    simp only [map_mul, map_pow] at hR'
    rw [hwcδ, map_mul] at hG
    have hGK := congrArg (algebraMap A K) hG
    simp only [map_mul] at hGK
    have EQ : (F - ((h' + h'') ^ (N + 1) - (h' + h''))) *
        algebraMap A K (u ^ (n * (N + 1) + 1) * (s₃ * s ^ (N + 1) * ε₁ ^ (N + 1)) + v * 0 +
          algebraMap ↥W A w' * g₁') * algebraMap A K (algebraMap ↥W A (μ ^ (N + 1))) =
        algebraMap A K (algebraMap ↥W A δ) *
          algebraMap A K (u ^ (n * (N + 1) + 1) * (s₃ * s ^ (N + 1) * ε₁ ^ (N + 1)) + v * 0 +
            algebraMap ↥W A w' * g₀') := by
      rw [← hg₁', ← hg₀', hId1, hId0, add_pow_char h' h'' (N + 1)]
      simp only [map_mul, map_add, map_pow]
      linear_combination (algebraMap A K u * algebraMap A K s₃) * hR' -
        (algebraMap A K u * algebraMap A K s₃ *
          (algebraMap A K s ^ (N + 1) * algebraMap A K B₁ ^ (N + 1))) * hP2 + hGK
    have hdv := hmax (h' + h'') δ (μ ^ (N + 1)) w' (n * (N + 1) + 1) (n * (N + 1) + 1)
      (s₃ * s ^ (N + 1) * ε₁ ^ (N + 1)) (s₃ * s ^ (N + 1) * ε₁ ^ (N + 1)) 0 0 g₀' g₁'
      hδ0 (pow_ne_zero _ hμ0) hw' hε' hε' EQ
    rw [hlam] at hdv
    have h1 : δ * (lam₁ * μ ^ (N + 1)) ∣ 1 * (lam₁ * μ ^ (N + 1)) := by rw [one_mul]; exact hdv
    have h2 : δ ∣ 1 := (mul_dvd_mul_iff_right (mul_ne_zero hl1 (pow_ne_zero _ hμ0))).mp h1
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal δ).mp hδm)) (isUnit_of_dvd_one h2)
  · push_neg at hYP
    have hY'P : ∀ s' : A, s' ∉ 𝔭 → s' * Y' ∉ J := by
      intro s' hs' h
      apply hYP s' hs'
      have e : s' * Y = s' * Y' + s' * (Y - Y') := by ring
      rw [e]; exact Ideal.add_mem _ h (Ideal.mul_mem_left _ _ hC)
    rw [hY'] at hY'P
    obtain ⟨m, s₂, ε, hm, hs₂, hε, hr⟩ := ORD z hY'P
    rw [← hY'] at hr
    have hr₀ : s₂ * Y - u ^ m * ε ∈ J := by
      have e : s₂ * Y - u ^ m * ε = (s₂ * Y' - u ^ m * ε) + s₂ * (Y - Y') := by ring
      rw [e]; exact Ideal.add_mem _ hr (Ideal.mul_mem_left _ _ hC)
    have hr₀u : u * (s₂ * Y - u ^ m * ε) ∈ mA := huJ _ hr₀
    have hρu : u * (s₂ * s ^ (N + 1) * (B₁ ^ (N + 1) - u ^ (n * (N + 1)) * ε₁ ^ (N + 1))) ∈ mA :=
      huJ _ (Ideal.mul_mem_left _ _ hρ)
    obtain ⟨w', g₁', g₀', hw', hg₁', hg₀'⟩ := CF _ _ hρu hr₀u
    have hε' : s₂ * s ^ (N + 1) * ε₁ ^ (N + 1) ∉ 𝔭 :=
      h𝔭.mul_notMem (h𝔭.mul_notMem hs₂ (hpow s _ hs)) (hpow ε₁ _ hε₁)
    refine ⟨h₀ + h', 1, μ ^ (N + 1), w', n * (N + 1) + 1, m + 1, ε,
      s₂ * s ^ (N + 1) * ε₁ ^ (N + 1), 0, 0, g₀', g₁',
      one_ne_zero, pow_ne_zero _ hμ0, hw', hε, hε', ?_, ?_⟩
    · have hFid : f₀ - ((h₀ + h') ^ (N + 1) - (h₀ + h')) = F - (h' ^ (N + 1) - h') := by
        rw [← hF, add_pow_char h₀ h' (N + 1)]; ring
      rw [hFid, ← hg₁', ← hg₀']
      have e1 : u ^ (n * (N + 1) + 1) * (s₂ * s ^ (N + 1) * ε₁ ^ (N + 1)) + v * 0 +
          u * (s₂ * s ^ (N + 1) * (B₁ ^ (N + 1) - u ^ (n * (N + 1)) * ε₁ ^ (N + 1))) =
          u * s₂ * (s ^ (N + 1) * B₁ ^ (N + 1)) := by ring
      have e2 : u ^ (m + 1) * ε + v * 0 + u * (s₂ * Y - u ^ m * ε) = u * s₂ * Y := by ring
      rw [e1, e2, map_one, map_one, one_mul, map_mul (algebraMap A K) (u * s₂),
        map_mul (algebraMap A K) (u * s₂), ← hR]
      ring
    · intro h
      apply hm
      have h2 : ((N + 1 : ℕ) : ℤ) ∣ ((m : ℕ) : ℤ) := by
        have h3 := dvd_add h (dvd_mul_left ((N + 1 : ℕ) : ℤ) (n : ℤ))
        have e : ((m + 1 : ℕ) : ℤ) - ((n * (N + 1) + 1 : ℕ) : ℤ) + (n : ℤ) * ((N + 1 : ℕ) : ℤ) =
            (m : ℤ) := by
          push_cast; ring
        rwa [e] at h3
      exact Int.natCast_dvd_natCast.mp h2

theorem wcLlsASb_boundary_form : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) → ((ℓ : ℕ) : K) = 0 →
    ∀ (α : L) (f₀ : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α →
    ∃ (h : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A),
      lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀ ∉ 𝔭 ∧ ε₁ ∉ 𝔭 ∧
      (f₀ - (h ^ ℓ - h)) * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) *
          algebraMap A K (algebraMap ↥W A lam₂) =
        algebraMap A K (algebraMap ↥W A lam₁) *
          algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀) ∧
      ((lam₂ ∣ lam₁ ∧ (n ≤ k ∨ ∃ lam' : ↥W, lam₁ = lam₂ * lam' ∧
          lam' ∈ IsLocalRing.maximalIdeal ↥W)) ∨ ¬ (ℓ : ℤ) ∣ ((k : ℤ) - n)) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ A _ _ _ K _ _ _ L _ _ 𝔭 u v g hPD hK α f₀ hα hf₀
  classical
  have hinj : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
    intro x hx h0
    have h1 : algebraMap ↥W A x = 0 :=
      (IsFractionRing.injective A K) (h0.trans (map_zero _).symm)
    have h2 : x • (1 : A) = 0 := by rw [Algebra.smul_def, mul_one]; exact h1
    haveI := hPD.2.1
    exact hx ((smul_eq_zero.mp h2).resolve_right one_ne_zero)

  have hP : ∀ N : ℕ, ∀ (h : K) (lam' w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A),
      IsUnit lam' → w ∈ IsLocalRing.maximalIdeal ↥W → ε₀ ∉ 𝔭 → ε₁ ∉ 𝔭 → n - k ≤ N →
