    have hs : algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) s₀ ∈
        wcLlsScN W A K t c r₀ := by
      have h3 := Ideal.sub_mem _ hqmem hqN
      rwa [sub_sub_cancel] at h3
    apply hA s₀ hs₀
    have h4 : algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) s₀ ∈
        Q.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) L)) := by
