  obtain ⟨k1₀, k2₀, Z₀, Y₀, d₀, e₀, hR₀⟩ := wcFrf_rep_exists Ω W hW hWt A K 𝔭 t hPD f₀ hf0
  have hZ₀m : ∀ z ∈ Z₀ ++ Y₀, z ∈ IsLocalRing.maximalIdeal ↥W := by
