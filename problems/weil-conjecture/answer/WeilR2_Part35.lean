theorem wcFrm_rep_exists : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ F : K, F ≠ 0 →
    ∃ (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A), wcFrmREP W A K 𝔭 u F k1 k2 Z Y d e :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 u v g hPD F hF
  classical
  have h𝔭 : 𝔭.IsPrime := hPD.2.2.2.1.isPrime
  haveI : NoZeroSMulDivisors ↥W A := hPD.2.1
  have hg0 : g ≠ 0 := hPD.2.2.2.2.2.2.1
  have huv : u * v = algebraMap ↥W A g := hPD.2.2.2.2.2.2.2.1
  have hu0 : u ≠ 0 := by
    rintro rfl
    rw [zero_mul, eq_comm, Algebra.algebraMap_eq_smul_one, smul_eq_zero] at huv
    rcases huv with h | h
    · exact hg0 h
    · exact one_ne_zero h
  have hφu : algebraMap A K u ≠ 0 := by
    intro h
    apply hu0
    exact IsFractionRing.injective A K (h.trans (map_zero _).symm)
  have hlist : ∀ (G : ↥W → K) (L : List (↥W × ↥W × ℕ)), ∃ Z : List ↥W,
      (Z.map G).prod = (L.map (fun t => G t.1 ^ t.2.2)).prod := by
    intro G L
    induction L with
    | nil => exact ⟨[], by simp⟩
    | cons t L ih =>
      obtain ⟨Z', hZ'⟩ := ih
      refine ⟨List.replicate t.2.2 t.1 ++ Z', ?_⟩
      rw [List.map_append, List.prod_append, List.map_replicate, List.prod_replicate, hZ',
        List.map_cons, List.prod_cons]
  have hnot : ∀ a b : A, a ∉ 𝔭 → b ∉ 𝔭 → a * b ∉ 𝔭 := by
    intro a b ha hb h
    rcases h𝔭.mem_or_mem h with h | h
    · exact ha h
    · exact hb h
  have hrepA : ∀ p : A, p ≠ 0 → ∃ (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A),
      k1 ≠ 0 ∧ k2 ≠ 0 ∧ d ∉ 𝔭 ∧ e ∉ 𝔭 ∧
      algebraMap A K d * algebraMap A K (algebraMap ↥W A k2) *
          (Y.map (fun y => algebraMap A K (u - algebraMap ↥W A y))).prod * algebraMap A K p =
        algebraMap A K (algebraMap ↥W A k1) *
          (Z.map (fun z => algebraMap A K (u - algebraMap ↥W A z))).prod * algebraMap A K e := by
    intro p hp
    obtain ⟨L, w, α, N, s, a, hw, hα, hs, ha, -, hTM⟩ :=
      wcpa_dj_llsm_kpwmgc_tube_monomial Ω W hW hWt A K 𝔭 u v g hPD p hp
    obtain ⟨Z₀, hZ₀⟩ := hlist (fun z => algebraMap A K (u - algebraMap ↥W A z)) L
    have hTM' : algebraMap A K p * algebraMap A K s * algebraMap A K (algebraMap ↥W A w) =
        (Z₀.map (fun z => algebraMap A K (u - algebraMap ↥W A z))).prod *
          algebraMap A K (algebraMap ↥W A α) * algebraMap A K u ^ N * algebraMap A K a := by
      rw [hTM, hZ₀]
    have hZP : algebraMap A K u ^ N * algebraMap A K u ^ (-N).toNat =
        algebraMap A K u ^ N.toNat := by
      rw [← zpow_natCast, ← zpow_add₀ hφu, ← zpow_natCast]
      congr 1
      omega
    refine ⟨α, w, Z₀ ++ List.replicate N.toNat 0, List.replicate (-N).toNat 0, s, a,
      hα, hw, hs, ha, ?_⟩
    simp only [List.map_append, List.prod_append, List.map_replicate, List.prod_replicate,
      map_zero, sub_zero]
    linear_combination (algebraMap A K u ^ (-N).toNat) * hTM' +
      ((Z₀.map (fun z => algebraMap A K (u - algebraMap ↥W A z))).prod *
        algebraMap A K (algebraMap ↥W A α) * algebraMap A K a) * hZP
  obtain ⟨x, y, hy, hxy⟩ := IsFractionRing.div_surjective (A := A) F
  have hy0 : y ≠ 0 := nonZeroDivisors.ne_zero hy
  have hφy : algebraMap A K y ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hy
  have hx0 : x ≠ 0 := by
    rintro rfl
    apply hF
    rw [← hxy, map_zero, zero_div]
  have hE0 : F * algebraMap A K y = algebraMap A K x := by
    rw [← hxy, div_mul_cancel₀ _ hφy]
  obtain ⟨k1x, k2x, Zx, Yx, dx, ex, hk1x, hk2x, hdx, hex, hX⟩ := hrepA x hx0
  obtain ⟨k1y, k2y, Zy, Yy, dy, ey, hk1y, hk2y, hdy, hey, hY⟩ := hrepA y hy0
  refine ⟨k1x * k2y, k2x * k1y, Zx ++ Yy, Yx ++ Zy, dx * ey, ex * dy,
    mul_ne_zero hk1x hk2y, mul_ne_zero hk2x hk1y, hnot _ _ hdx hey, hnot _ _ hex hdy, ?_⟩
  rw [List.map_append, List.prod_append, List.map_append, List.prod_append]
  simp only [map_mul]
  linear_combination
    (-(algebraMap A K dx * algebraMap A K (algebraMap ↥W A k2x) *
        (Yx.map (fun y => algebraMap A K (u - algebraMap ↥W A y))).prod * F)) * hY +
    ((algebraMap A K dy * algebraMap A K (algebraMap ↥W A k2y) *
        (Yy.map (fun y => algebraMap A K (u - algebraMap ↥W A y))).prod) *
      (algebraMap A K dx * algebraMap A K (algebraMap ↥W A k2x) *
        (Yx.map (fun y => algebraMap A K (u - algebraMap ↥W A y))).prod)) * hE0 +
    (algebraMap A K dy * algebraMap A K (algebraMap ↥W A k2y) *
        (Yy.map (fun y => algebraMap A K (u - algebraMap ↥W A y))).prod) * hX

theorem wcFrm_gauss_val : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) →
    ∃ O : ↥W → ValuationSubring K, wcFrmVAL W A K 𝔭 u g O :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 u v g hPD
  classical

  have ru : ∀ (ρ : ↥W) (V : ValuationSubring K) (s : K), ρ ≠ 0 →
      (∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0) →
      algebraMap A K u = algebraMap A K (algebraMap ↥W A ρ) * s →
      (∀ e : ↥W, s - algebraMap A K (algebraMap ↥W A e) ≠ 0 ∧
        s - algebraMap A K (algebraMap ↥W A e) ∈ V ∧
        (s - algebraMap A K (algebraMap ↥W A e))⁻¹ ∈ V) →
      (∀ π : ↥W, π ∈ IsLocalRing.maximalIdeal ↥W →
        algebraMap A K (algebraMap ↥W A π) * s - 1 ≠ 0 ∧
        algebraMap A K (algebraMap ↥W A π) * s - 1 ∈ V ∧
        (algebraMap A K (algebraMap ↥W A π) * s - 1)⁻¹ ∈ V) →
      (∀ a : A, a ∉ 𝔭 → algebraMap A K a ≠ 0 ∧ algebraMap A K a ∈ V ∧
        (algebraMap A K a)⁻¹ ∈ V) →
      ∀ (F : K) (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A), F ≠ 0 →
        wcFrmREP W A K 𝔭 u F k1 k2 Z Y d e →
        algebraMap A K (algebraMap ↥W A (k2 * wcFrmP W ρ Y)) * F /
            algebraMap A K (algebraMap ↥W A (k1 * wcFrmP W ρ Z)) ∈ V ∧
          algebraMap A K (algebraMap ↥W A (k1 * wcFrmP W ρ Z)) /
            (algebraMap A K (algebraMap ↥W A (k2 * wcFrmP W ρ Y)) * F) ∈ V := by
    intro ρ V s hρ hinj hrel U1 U2 U3 F k1 k2 Z Y d e hF hrep
    let U : K → Prop := fun z => z ≠ 0 ∧ z ∈ V ∧ z⁻¹ ∈ V
    have Umul : ∀ a b : K, U a → U b → U (a * b) := by
      rintro a b ⟨ha0, ha, ha'⟩ ⟨hb0, hb, hb'⟩
      exact ⟨mul_ne_zero ha0 hb0, V.mul_mem _ _ ha hb,
        by rw [mul_inv]; exact V.mul_mem _ _ ha' hb'⟩
    have Uinv : ∀ a : K, U a → U a⁻¹ := by
      rintro a ⟨ha0, ha, ha'⟩
      exact ⟨inv_ne_zero ha0, ha', by rw [inv_inv]; exact ha⟩
    have Uone : U 1 := ⟨one_ne_zero, V.one_mem, by rw [inv_one]; exact V.one_mem⟩
    have factor : ∀ x : ↥W, ∃ G : K, U G ∧
        (if ρ ∣ x then ρ else x) ≠ 0 ∧
        algebraMap A K (u - algebraMap ↥W A x) =
          algebraMap A K (algebraMap ↥W A (if ρ ∣ x then ρ else x)) * G := by
      intro x
      by_cases h : ρ ∣ x
      · rw [if_pos h]
        obtain ⟨e', he'⟩ := h
        refine ⟨s - algebraMap A K (algebraMap ↥W A e'), U1 e', hρ, ?_⟩
        rw [he']
        simp only [map_sub, map_mul]
        rw [hrel]; ring
      · rw [if_neg h]
        rcases ValuationRing.dvd_total x ρ with ⟨π, hπ⟩ | h'
        · have hπu : ¬ IsUnit π := by
            intro hu
            apply h
            exact ⟨↑hu.unit⁻¹, by rw [hπ, mul_assoc, hu.mul_val_inv, mul_one]⟩
          have hπm : π ∈ IsLocalRing.maximalIdeal ↥W :=
            (IsLocalRing.mem_maximalIdeal _).mpr hπu
          have hx0 : x ≠ 0 := by
            intro h0; apply h; rw [h0]; exact dvd_zero ρ
          refine ⟨algebraMap A K (algebraMap ↥W A π) * s - 1, U2 π hπm, hx0, ?_⟩
          simp only [map_sub]
          rw [hrel, hπ, map_mul, map_mul]; ring
        · exact absurd h' h
    have prodL : ∀ X : List ↥W, ∃ G : K, U G ∧ wcFrmP W ρ X ≠ 0 ∧
        (X.map (fun y => algebraMap A K (u - algebraMap ↥W A y))).prod =
          algebraMap A K (algebraMap ↥W A (wcFrmP W ρ X)) * G := by
      intro X
      induction X with
      | nil => exact ⟨1, Uone, by simp [wcFrmP], by simp [wcFrmP]⟩
      | cons x X ih =>
        obtain ⟨G, hG, hP0, hX⟩ := ih
        obtain ⟨Gx, hGx, hp0, hx⟩ := factor x
        have hPc : wcFrmP W ρ (x :: X) =
            (if ρ ∣ x then ρ else x) * wcFrmP W ρ X := by
          unfold wcFrmP
          by_cases h : ρ ∣ x
          · simp [h, pow_succ]; ring
          · simp [h]; ring
        refine ⟨Gx * G, Umul _ _ hGx hG, by rw [hPc]; exact mul_ne_zero hp0 hP0, ?_⟩
        rw [List.map_cons, List.prod_cons, hX, hx, hPc, map_mul, map_mul]; ring
    obtain ⟨hk1, hk2, hd, he, hR⟩ := hrep
    obtain ⟨GY, hGY, hPY, hY⟩ := prodL Y
    obtain ⟨GZ, hGZ, hPZ, hZ⟩ := prodL Z
    obtain ⟨hd0, hdV, hdV'⟩ := U3 d hd
    obtain ⟨he0, heV, heV'⟩ := U3 e he
    rw [hY, hZ] at hR
    have hden1 : algebraMap A K (algebraMap ↥W A (k1 * wcFrmP W ρ Z)) ≠ 0 :=
      hinj _ (mul_ne_zero hk1 hPZ)
    have hden2 : algebraMap A K d * GY ≠ 0 := mul_ne_zero hd0 hGY.1
    have hX : algebraMap A K (algebraMap ↥W A (k2 * wcFrmP W ρ Y)) * F /
        algebraMap A K (algebraMap ↥W A (k1 * wcFrmP W ρ Z)) =
        GZ * algebraMap A K e / (algebraMap A K d * GY) := by
      rw [div_eq_div_iff hden1 hden2]
      simp only [map_mul]
      linear_combination hR
    have hUX : U (GZ * algebraMap A K e / (algebraMap A K d * GY)) := by
      rw [div_eq_mul_inv]
      exact Umul _ _ (Umul _ _ hGZ ⟨he0, heV, heV'⟩) (Uinv _ (Umul _ _ ⟨hd0, hdV, hdV'⟩ hGY))
    refine ⟨by rw [hX]; exact hUX.2.1, ?_⟩
    rw [← inv_div, hX]
    exact hUX.2.2

  have hPD0 := hPD
  unfold wcLlsPD at hPD0
  obtain ⟨_, hnz, _, hmax, _, _, _, _, hpeq, -⟩ := hPD0
  have hφinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have haWinj : Function.Injective (algebraMap ↥W A) := by
    haveI := hnz; exact FaithfulSMul.algebraMap_injective ↥W A
  have hinj : ∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0 := by
    intro w hw h
    apply hw
    apply haWinj
    apply hφinj
    rw [h, map_zero, map_zero]

  have H : ∀ ρ : ↥W, ∃ V : ValuationSubring K, wcFrmInt W g ρ →
      (∀ (F : K) (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A), F ≠ 0 →
        wcFrmREP W A K 𝔭 u F k1 k2 Z Y d e →
        algebraMap A K (algebraMap ↥W A (k2 * wcFrmP W ρ Y)) * F /
            algebraMap A K (algebraMap ↥W A (k1 * wcFrmP W ρ Z)) ∈ V ∧
          algebraMap A K (algebraMap ↥W A (k1 * wcFrmP W ρ Z)) /
            (algebraMap A K (algebraMap ↥W A (k2 * wcFrmP W ρ Y)) * F) ∈ V) ∧
      (∀ w₁ w₂ : ↥W, w₁ ≠ 0 → w₂ ≠ 0 →
        algebraMap A K (algebraMap ↥W A w₁) / algebraMap A K (algebraMap ↥W A w₂) ∈ V →
        w₂ ∣ w₁) ∧
      (∀ a : A, algebraMap A K a ∈ V) := by
    intro ρ
    by_cases hρ : wcFrmInt W g ρ
    swap
    · exact ⟨⊤, fun h => absurd h hρ⟩
    obtain ⟨hρm, hρ0, hρg, hgρ⟩ := hρ
    obtain ⟨q, hq⟩ := hρg
    have hqm : q ∈ IsLocalRing.maximalIdeal ↥W := by
      by_contra hqn
      have hqu : IsUnit q := by
        by_contra h; exact hqn ((IsLocalRing.mem_maximalIdeal _).mpr h)
      apply hgρ
      exact ⟨↑hqu.unit⁻¹, by rw [hq, mul_assoc, hqu.mul_val_inv, mul_one]⟩

    obtain ⟨A₃, i1, i2, i3, i4, i5, i6, i7, u₃, v₃, 𝔭₃, hBr, hu₃, hv₃, hPD₃, -⟩ :=
      wcpa_dj_llsm_br_inner_chart Ω W hW hWt A K K 𝔭 u v g ρ q hPD hρm hρ0 hqm hq
    clear i7 i6
    have hBr0 := hBr
    unfold wcLlsBrSub at hBr0
    obtain ⟨Br1, Br2, -⟩ := hBr0
    have lift : ∀ a : A, ∃ a₃ : A₃, algebraMap A₃ K a₃ = algebraMap A K a := by
      intro a
      exact Br2 (Subalgebra.algebraMap_mem _ a)
    have hρK := hinj ρ hρ0
    have rel : algebraMap A K u =
        algebraMap A K (algebraMap ↥W A ρ) * algebraMap A₃ K u₃ := by
      rw [hu₃]; field_simp
    have hinj₃ : Function.Injective (algebraMap A₃ K) := IsFractionRing.injective A₃ K
    have hPD₃0 := hPD₃
    unfold wcLlsPD at hPD₃0
    obtain ⟨_, _, _, hmax₃, hmA₃, _, _, _, hpeq₃, -⟩ := hPD₃0
    have hp₃ : 𝔭₃.IsPrime := hmax₃.isPrime
    have h1p₃ : (1 : A₃) ∉ 𝔭₃ := fun h => hp₃.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    have hv₃p : v₃ ∈ 𝔭₃ := by
      rw [hpeq₃]; exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
    have hu₃p : u₃ ∈ 𝔭₃ := by
      rw [hpeq₃]; exact Ideal.mem_sup_left (Ideal.subset_span (by simp))

    obtain ⟨V, hV, -⟩ := wcLlsASbba_branch_valring Ω W hW hWt A₃ K 𝔭₃ u₃ v₃ q hPD₃
    have UP := wcpa_dj_llsm_kpwulbc_branch_upow Ω W A₃ 𝔭₃ u₃ v₃ q hPD₃ 1

    have N0 : Ideal.span {v₃} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A₃) ≤ 𝔭₃ :=
      sup_le ((Ideal.span_singleton_le_iff_mem _).mpr hv₃p) hmA₃
    have N1 : ∀ y : A₃, y ∉ 𝔭₃ → ∀ t : A₃, t ∉ 𝔭₃ →
        t * y ∉ Ideal.span {v₃} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A₃) :=
      fun y hy t ht h => hp₃.mul_notMem ht hy (N0 h)
    have N4 : ∀ y : A₃, (∀ t : A₃, t ∉ 𝔭₃ →
        t * y ∉ Ideal.span {v₃} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A₃)) →
        algebraMap A₃ K y ≠ 0 ∧ algebraMap A₃ K y ∈ V ∧ (algebraMap A₃ K y)⁻¹ ∈ V := by
      intro y hy
      have hy0 : y ≠ 0 := by
        rintro rfl
        exact hy 1 h1p₃ (by rw [mul_zero]; exact Submodule.zero_mem _)
      have hφy : algebraMap A₃ K y ≠ 0 := fun h => hy0 (hinj₃ (by rw [h, map_zero]))
      refine ⟨hφy, (hV _).mpr ⟨y, 1, N1 1 h1p₃, by rw [map_one, mul_one]⟩,
        (hV _).mpr ⟨1, y, hy, by rw [inv_mul_cancel₀ hφy, map_one]⟩⟩
    have N2 : ∀ e : ↥W, ∀ t : A₃, t ∉ 𝔭₃ → t * (u₃ - algebraMap ↥W A₃ e) ∉
        Ideal.span {v₃} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A₃) := by
      intro e
      by_cases he : e ∈ IsLocalRing.maximalIdeal ↥W
      · intro t ht h
        apply UP t ht
        have heM : algebraMap ↥W A₃ e ∈
            Ideal.span {v₃} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A₃) :=
          Ideal.mem_sup_right (Ideal.mem_map_of_mem _ he)
        have : t * u₃ ^ 1 = t * (u₃ - algebraMap ↥W A₃ e) + t * algebraMap ↥W A₃ e := by ring
        rw [this]
        exact Submodule.add_mem _ h (Ideal.mul_mem_left _ _ heM)
      · apply N1
        intro h
        have hu : IsUnit e := by
          by_contra hne; exact he ((IsLocalRing.mem_maximalIdeal _).mpr hne)
        have h3 : algebraMap ↥W A₃ e ∈ 𝔭₃ := by
          have := 𝔭₃.sub_mem hu₃p h
          simpa using this
        exact hmax₃.ne_top (Ideal.eq_top_of_isUnit_mem _ h3 (hu.map _))
    have N3 : ∀ π : ↥W, π ∈ IsLocalRing.maximalIdeal ↥W → ∀ t : A₃, t ∉ 𝔭₃ →
        t * (algebraMap ↥W A₃ π * u₃ - 1) ∉
          Ideal.span {v₃} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A₃) := by
      intro π hπ
      apply N1
      intro h
      apply h1p₃
      have hπp : algebraMap ↥W A₃ π * u₃ ∈ 𝔭₃ :=
        𝔭₃.mul_mem_right _ (hmA₃ (Ideal.mem_map_of_mem _ hπ))
      have := 𝔭₃.sub_mem hπp h
      simpa using this

    let J : Ideal A :=
      { carrier := {a | ∃ a₃ ∈ 𝔭₃, algebraMap A₃ K a₃ = algebraMap A K a}
        add_mem' := by
          rintro a b ⟨a₃, ha, ea⟩ ⟨b₃, hb, eb⟩
          exact ⟨a₃ + b₃, 𝔭₃.add_mem ha hb, by rw [map_add, map_add, ea, eb]⟩
        zero_mem' := ⟨0, 𝔭₃.zero_mem, by rw [map_zero, map_zero]⟩
        smul_mem' := by
          rintro r a ⟨a₃, ha, ea⟩
          obtain ⟨r₃, er⟩ := lift r
          exact ⟨r₃ * a₃, 𝔭₃.mul_mem_left _ ha, by rw [smul_eq_mul, map_mul, map_mul, er, ea]⟩ }
    have hmemJ : ∀ a, a ∈ J ↔ ∃ a₃ ∈ 𝔭₃, algebraMap A₃ K a₃ = algebraMap A K a :=
      fun a => Iff.rfl
    have hρ₃ : algebraMap ↥W A₃ ρ ∈ 𝔭₃ := hmA₃ (Ideal.mem_map_of_mem _ hρm)
    have hle : 𝔭 ≤ J := by
      rw [hpeq]
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro x hx
        rcases hx with hx | hx
        · rw [hx]
          refine (hmemJ u).mpr ⟨algebraMap ↥W A₃ ρ * u₃, 𝔭₃.mul_mem_right _ hρ₃, ?_⟩
          rw [map_mul, Br1, ← rel]
        · rw [Set.mem_singleton_iff.mp hx]
          exact (hmemJ v).mpr ⟨v₃, hv₃p, hv₃⟩
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        exact Ideal.mem_comap.mpr ((hmemJ _).mpr
          ⟨algebraMap ↥W A₃ w, hmA₃ (Ideal.mem_map_of_mem _ hw), Br1 w⟩)
    have hJne : J ≠ ⊤ := by
      intro hJ
      have h1 : (1 : A) ∈ J := hJ ▸ Submodule.mem_top
      obtain ⟨a₃, ha, ea⟩ := (hmemJ 1).mp h1
      rw [map_one, ← map_one (algebraMap A₃ K)] at ea
      have : a₃ = 1 := hinj₃ ea
      rw [this] at ha
      exact h1p₃ ha
    have hJ : 𝔭 = J := hmax.eq_of_le hJne hle

    have U1 : ∀ e : ↥W, algebraMap A₃ K u₃ - algebraMap A K (algebraMap ↥W A e) ≠ 0 ∧
        algebraMap A₃ K u₃ - algebraMap A K (algebraMap ↥W A e) ∈ V ∧
        (algebraMap A₃ K u₃ - algebraMap A K (algebraMap ↥W A e))⁻¹ ∈ V := by
      intro e
      have : algebraMap A₃ K u₃ - algebraMap A K (algebraMap ↥W A e) =
          algebraMap A₃ K (u₃ - algebraMap ↥W A₃ e) := by rw [map_sub, Br1]
      rw [this]; exact N4 _ (N2 e)
    have U2 : ∀ π : ↥W, π ∈ IsLocalRing.maximalIdeal ↥W →
        algebraMap A K (algebraMap ↥W A π) * algebraMap A₃ K u₃ - 1 ≠ 0 ∧
        algebraMap A K (algebraMap ↥W A π) * algebraMap A₃ K u₃ - 1 ∈ V ∧
        (algebraMap A K (algebraMap ↥W A π) * algebraMap A₃ K u₃ - 1)⁻¹ ∈ V := by
      intro π hπ
      have : algebraMap A K (algebraMap ↥W A π) * algebraMap A₃ K u₃ - 1 =
          algebraMap A₃ K (algebraMap ↥W A₃ π * u₃ - 1) := by
        rw [map_sub, map_mul, Br1, map_one]
      rw [this]; exact N4 _ (N3 π hπ)
    have U3 : ∀ a : A, a ∉ 𝔭 → algebraMap A K a ≠ 0 ∧ algebraMap A K a ∈ V ∧
        (algebraMap A K a)⁻¹ ∈ V := by
      intro a ha
      obtain ⟨a₃, ea⟩ := lift a
      have ha₃ : a₃ ∉ 𝔭₃ := by
        intro h
        apply ha
        rw [hJ]
        exact (hmemJ a).mpr ⟨a₃, h, ea⟩
      rw [← ea]; exact N4 _ (N1 _ ha₃)

    refine ⟨V, fun _ => ⟨?_, ?_, ?_⟩⟩
    · exact ru ρ V (algebraMap A₃ K u₃) hρ0 hinj rel U1 U2 U3
    · intro w₁ w₂ hw₁ hw₂ hmem
      rcases ValuationRing.dvd_total w₂ w₁ with h | ⟨π, hπ⟩
      · exact h
      by_cases hu : IsUnit π
      · exact ⟨↑hu.unit⁻¹, by rw [hπ, mul_assoc, hu.mul_val_inv, mul_one]⟩
      exfalso
      have hπm : π ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal _).mpr hu
      have hπ0 : π ≠ 0 := by rintro rfl; rw [mul_zero] at hπ; exact hw₂ hπ
      have h1 := hinj w₁ hw₁
      have h2 := hinj π hπ0
      have hratio : algebraMap A K (algebraMap ↥W A w₁) / algebraMap A K (algebraMap ↥W A w₂) =
          (algebraMap A K (algebraMap ↥W A π))⁻¹ := by
        rw [hπ, map_mul, map_mul, div_mul_eq_div_div, div_self h1, one_div]
      rw [hratio] at hmem
      obtain ⟨a, b, hb, h⟩ := (hV _).mp hmem
      rw [inv_mul_eq_iff_eq_mul₀ h2, ← Br1, ← map_mul] at h
      have hba : b = algebraMap ↥W A₃ π * a := hinj₃ h
      apply hb 1 h1p₃
      rw [one_mul, hba]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hπm))
    · intro a
      obtain ⟨a₃, ea⟩ := lift a
      rw [← ea]
      exact (hV _).mpr ⟨a₃, 1, N1 1 h1p₃, by rw [map_one, mul_one]⟩
  choose O hO using H
  refine ⟨O, ?_⟩
  intro ρ hρ
  exact hO ρ hρ

theorem wcFrm_end_u : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) → Module.finrank K L = ℓ →
    ∀ (α : L) (f₀ : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α →
    ∀ O : ↥W → ValuationSubring K, wcFrmVAL W A K 𝔭 u g O →
    ∃ ρ₀ : ↥W, wcFrmInt W g ρ₀ ∧
      wcFrmMem W A K 𝔭 u g ℓ f₀ (fun ρ => ρ ∣ ρ₀ ∧ ¬ ρ₀ ∣ ρ) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g hPD hdeg α f₀ hα1 hf₀
    O hO
  classical

  have hΩ : ((ℓ : ℕ) : Ω) = 0 := by
    rw [← hchar]
    exact ringChar.Nat.cast_ringChar
  have hWl : ((ℓ : ℕ) : ↥W) = 0 := by
    apply Subtype.ext
    simpa using hΩ
  have hK : ((ℓ : ℕ) : K) = 0 := by
    have e : ((ℓ : ℕ) : K) = algebraMap A K (algebraMap ↥W A ((ℓ : ℕ) : ↥W)) := by
      rw [map_natCast, map_natCast]
    rw [e, hWl, map_zero, map_zero]
  have hL : ((ℓ : ℕ) : L) = 0 := by
    rw [← map_natCast (algebraMap K L), hK, map_zero]
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : CharP L ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hL
  have hgm : g ∈ IsLocalRing.maximalIdeal ↥W := hPD.2.2.2.2.2.1
  have hg0 : g ≠ 0 := hPD.2.2.2.2.2.2.1
  have huv : u * v = algebraMap ↥W A g := hPD.2.2.2.2.2.2.2.1
  have h1p : (1 : A) ∉ 𝔭 := (Ideal.ne_top_iff_one 𝔭).mp hPD.2.2.2.1.ne_top

  have hroot : ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → x ≠ 0 → ∀ N : ℕ,
      ∃ y : ↥W, y ∈ IsLocalRing.maximalIdeal ↥W ∧ y ≠ 0 ∧ y ^ (N + 1) = x := by
    intro x hxm hx0 N
    obtain ⟨y, hy⟩ := IsAlgClosed.exists_pow_nat_eq (x : Ω) (Nat.succ_pos N)
    have hy0 : y ≠ 0 := by
      rintro rfl
      apply hx0
      apply Subtype.ext
      rw [← hy]
      simp
    have hyW : y ∈ W := by
      rcases W.mem_or_inv_mem y with h' | h'
      · exact h'
      · have e : y = (x : Ω) * (y⁻¹) ^ N := by
          rw [← hy, inv_pow, pow_succ]
          field_simp
        rw [e]
        exact mul_mem x.2 (pow_mem h' N)
    have hxg : (⟨y, hyW⟩ : ↥W) ^ (N + 1) = x := by
      apply Subtype.ext
      simp [hy]
    refine ⟨⟨y, hyW⟩, ?_, ?_, hxg⟩
    · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have := (IsLocalRing.mem_maximalIdeal _).mp hxm
      rw [mem_nonunits_iff] at this
      apply this
      rw [← hxg]
      exact hu.pow _
    · intro h0
      apply hy0
      have := congrArg Subtype.val h0
      simpa using this

  have hcommon : ∀ S : List ↥W, (∀ s ∈ S, s ∈ IsLocalRing.maximalIdeal ↥W) →
      ∃ G : ↥W, G ∈ IsLocalRing.maximalIdeal ↥W ∧ G ≠ 0 ∧ ∀ s ∈ S, G ∣ s := by
    intro S
    induction S with
    | nil => intro _; exact ⟨g, hgm, hg0, by simp⟩
    | cons s S ih =>
      intro hS
      obtain ⟨G, hGm, hG0, hGS⟩ := ih (fun x hx => hS x (List.mem_cons_of_mem _ hx))
      by_cases hs0 : s = 0
      · refine ⟨G, hGm, hG0, ?_⟩
        intro x hx
        rcases List.mem_cons.mp hx with h' | hx
        · rw [h', hs0]; exact dvd_zero _
        · exact hGS x hx
      · rcases ValuationRing.dvd_total G s with hgs | hsg
        · refine ⟨G, hGm, hG0, ?_⟩
          intro x hx
          rcases List.mem_cons.mp hx with h' | hx
          · rw [h']; exact hgs
          · exact hGS x hx
        · refine ⟨s, hS s (by simp), hs0, ?_⟩
          intro x hx
          rcases List.mem_cons.mp hx with h' | hx
          · rw [h']
          · exact hsg.trans (hGS x hx)

  have hexp : ∀ (a b σ : ↥W) (p q : ℕ), a ≠ 0 → σ ≠ 0 → ¬ IsUnit σ →
      a * σ ^ p ∣ b * σ ^ q → b * σ ^ q ∣ a * σ ^ p →
      a * σ ^ (2 * p) ∣ b * σ ^ (2 * q) → b * σ ^ (2 * q) ∣ a * σ ^ (2 * p) →
      p = q ∧ a ∣ b := by
    intro a b σ p q ha hσ hnu h1a h1b h2a h2b
    have h1 := associated_of_dvd_dvd h1a h1b
    have h2 := associated_of_dvd_dvd h2a h2b
    rw [two_mul, two_mul, pow_add, pow_add, ← mul_assoc, ← mul_assoc] at h2
    have h3 : Associated (σ ^ p) (σ ^ q) :=
      h2.of_mul_left h1 (mul_ne_zero ha (pow_ne_zero _ hσ))
    have hpq : p = q := le_antisymm ((pow_dvd_pow_iff hσ hnu).mp h3.dvd)
      ((pow_dvd_pow_iff hσ hnu).mp h3.symm.dvd)
    subst hpq
    exact ⟨rfl, (h1.of_mul_right (Associated.refl _) (pow_ne_zero _ hσ)).dvd⟩

  obtain ⟨qf, hqf⟩ : ∃ qf : List ↥W → ↥W, ∀ X, qf X =
      (X.filter (fun x => @decide (x ∉ IsLocalRing.maximalIdeal ↥W)
        (Classical.propDecidable _))).prod := ⟨_, fun _ => rfl⟩
  obtain ⟨cf, hcf⟩ : ∃ cf : List ↥W → ℕ, ∀ X, cf X =
      (X.filter (fun x => @decide (x ∈ IsLocalRing.maximalIdeal ↥W)
        (Classical.propDecidable _))).length := ⟨_, fun _ => rfl⟩
  have hqne : ∀ X, qf X ≠ 0 := by
    intro X
    rw [hqf]
    apply IsUnit.ne_zero
    apply List.prod_isUnit
    intro x hx
    have hx' := (List.mem_filter.mp hx).2
    have hxm : x ∉ IsLocalRing.maximalIdeal ↥W := by simpa using hx'
    exact IsLocalRing.notMem_maximalIdeal.mp hxm
  have hPform : ∀ (σ : ↥W) (X : List ↥W), σ ∈ IsLocalRing.maximalIdeal ↥W →
      (∀ x ∈ X, x ∈ IsLocalRing.maximalIdeal ↥W → σ ∣ x) →
      wcFrmP W σ X = qf X * σ ^ cf X ∧
        (X.filter (fun x => @decide (σ ∣ x) (Classical.propDecidable _))).length = cf X := by
    intro σ X hσ hX
    have hiff : ∀ x ∈ X, σ ∣ x ↔ x ∈ IsLocalRing.maximalIdeal ↥W := by
      intro x hx
      refine ⟨fun hd => ?_, hX x hx⟩
      obtain ⟨c, hc⟩ := hd
      rw [hc]
      exact Ideal.mul_mem_right c _ hσ
    have h1 : X.filter (fun x => @decide (σ ∣ x) (Classical.propDecidable _)) =
        X.filter (fun x => @decide (x ∈ IsLocalRing.maximalIdeal ↥W)
          (Classical.propDecidable _)) :=
      List.filter_congr (fun x hx => decide_eq_decide.mpr (hiff x hx))
    have h2 : X.filter (fun x => @decide (¬ σ ∣ x) (Classical.propDecidable _)) =
        X.filter (fun x => @decide (x ∉ IsLocalRing.maximalIdeal ↥W)
          (Classical.propDecidable _)) :=
      List.filter_congr (fun x hx => decide_eq_decide.mpr (not_congr (hiff x hx)))
    refine ⟨?_, by rw [h1, hcf]⟩
    unfold wcFrmP
    rw [h1, h2, hqf, hcf]

  obtain ⟨h, lam₁, lam₂, w, n, k, ε₀, ε₁, r₀, r₁, g₀, g₁, hl1, hl2, hw, hε₀, hε₁, hI, hD⟩ :=
    wcLlsASb_boundary_form Ω W hW hWt ℓ hℓ A K L 𝔭 u v g hPD hK α f₀ hα1 hf₀

  have hF0 : f₀ - (h ^ ℓ - h) ≠ 0 := by
    intro h0
    have e1 : f₀ = h ^ ℓ - h := sub_eq_zero.mp h0
    have e2 : (α - algebraMap K L h) ^ ℓ = α - algebraMap K L h := by
      rw [sub_pow_char]
      have := hf₀
      rw [e1, map_sub, map_pow] at this
      linear_combination (-1 : L) * this
    have hbot := (Subfield.mem_bot_iff_pow_eq_self L ℓ).mpr e2
    obtain ⟨x, hx⟩ := RingHom.mem_fieldRange.mp
      ((bot_le : (⊥ : Subfield L) ≤ (algebraMap K L).fieldRange) hbot)
    exact hα1 ⟨x + h, by rw [map_add, hx]; ring⟩

  obtain ⟨k1, k2, Z, Y, d, e, hR⟩ :=
    wcFrm_rep_exists Ω W hW hWt A K 𝔭 u v g hPD (f₀ - (h ^ ℓ - h)) hF0
  have hk1 : k1 ≠ 0 := hR.1
  have hk2 : k2 ≠ 0 := hR.2.1

  obtain ⟨lamS, hlamSm, hD'⟩ : ∃ lamS : ↥W, lamS ∈ IsLocalRing.maximalIdeal ↥W ∧
      ((lam₂ ∣ lam₁ ∧ (n ≤ k ∨ ∃ lam' : ↥W, lam₁ = lam₂ * lam' ∧ lamS ∣ lam')) ∨
        ¬ (ℓ : ℤ) ∣ ((k : ℤ) - n)) := by
    rcases hD with ⟨hdv, hnk | ⟨lam', hl', hl'm⟩⟩ | hnd
    · exact ⟨0, Ideal.zero_mem _, Or.inl ⟨hdv, Or.inl hnk⟩⟩
    · exact ⟨lam', hl'm, Or.inl ⟨hdv, Or.inr ⟨lam', hl', dvd_rfl⟩⟩⟩
    · exact ⟨0, Ideal.zero_mem _, Or.inr hnd⟩

  have hSm : ∀ s ∈ g :: w :: lamS :: (Z ++ Y).filter (fun x =>
      @decide (x ∈ IsLocalRing.maximalIdeal ↥W) (Classical.propDecidable _)),
      s ∈ IsLocalRing.maximalIdeal ↥W := by
    intro s hs
    rcases List.mem_cons.mp hs with h1 | hs
    · rw [h1]; exact hgm
    rcases List.mem_cons.mp hs with h1 | hs
    · rw [h1]; exact hw
    rcases List.mem_cons.mp hs with h1 | hs
    · rw [h1]; exact hlamSm
    have := (List.mem_filter.mp hs).2
    simpa using this
  obtain ⟨G, hGm, hG0, hGS⟩ := hcommon _ hSm
  obtain ⟨ρ₀, hρ₀m, hρ₀0, hρ₀G⟩ := hroot G hGm hG0 (n + k + 1)
  have hGg : G ∣ g := hGS g (by simp)
  have hρ₀nu : ¬ IsUnit ρ₀ := by
    have := (IsLocalRing.mem_maximalIdeal _).mp hρ₀m
    rwa [mem_nonunits_iff] at this
  have hρ₀g : ρ₀ ∣ g := by
    refine dvd_trans ?_ hGg
    rw [← hρ₀G]
    exact dvd_pow_self _ (by omega)
  have hgρ₀ : ¬ g ∣ ρ₀ := by
    intro hd
    have h1 : ρ₀ ^ (n + k + 1 + 1) ∣ ρ₀ ^ 1 := by
      rw [pow_one, hρ₀G]; exact hGg.trans hd
    have := (pow_dvd_pow_iff hρ₀0 hρ₀nu).mp h1
    omega
  have hdivs : ∀ σ : ↥W, σ ∣ ρ₀ → σ ^ (n + k + 1 + 1) ∣ g ∧ σ ^ (n + k + 1 + 1) ∣ w ∧
      σ ^ (n + k + 1 + 1) ∣ lamS ∧
      ∀ x ∈ Z ++ Y, x ∈ IsLocalRing.maximalIdeal ↥W → σ ∣ x := by
    intro σ hσ
    have h1 : σ ^ (n + k + 1 + 1) ∣ G := hρ₀G ▸ pow_dvd_pow_of_dvd hσ _
    refine ⟨h1.trans hGg, h1.trans (hGS w (by simp)), h1.trans (hGS lamS (by simp)), ?_⟩
    intro x hx hxm
    exact (dvd_pow_self σ (by omega : n + k + 1 + 1 ≠ 0)).trans (h1.trans (hGS x
      (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
        (List.mem_filter.mpr ⟨hx, by simpa using hxm⟩))))))

  have hgauss : ∀ σ : ↥W, wcFrmInt W g σ → σ ^ (n + k + 1 + 1) ∣ g →
      σ ^ (n + k + 1 + 1) ∣ w →
      (∀ x ∈ Z ++ Y, x ∈ IsLocalRing.maximalIdeal ↥W → σ ∣ x) →
      k2 * qf Y * lam₁ * σ ^ (cf Y + k) ∣ k1 * qf Z * lam₂ * σ ^ (cf Z + n) ∧
        k1 * qf Z * lam₂ * σ ^ (cf Z + n) ∣ k2 * qf Y * lam₁ * σ ^ (cf Y + k) := by
    intro σ hσI hσg hσw hnear
    have hσm : σ ∈ IsLocalRing.maximalIdeal ↥W := hσI.1
    have hσ0 : σ ≠ 0 := hσI.2.1
    have hZn : ∀ x ∈ Z, x ∈ IsLocalRing.maximalIdeal ↥W → σ ∣ x :=
      fun x hx => hnear x (List.mem_append_left _ hx)
    have hYn : ∀ x ∈ Y, x ∈ IsLocalRing.maximalIdeal ↥W → σ ∣ x :=
      fun x hx => hnear x (List.mem_append_right _ hx)
    obtain ⟨hVI, hVII, hVIV⟩ := hO σ hσI
    obtain ⟨ν, hν⟩ : ∃ ν : Valuation K (O σ).ValueGroup, ν = (O σ).valuation := ⟨_, rfl⟩
    have hmemle : ∀ x : K, ν x ≤ 1 ↔ x ∈ O σ := fun x => by
      rw [hν]; exact (O σ).valuation_le_one_iff x

    have hF0' : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
      intro x hx h0
      have hd := hVII 1 x one_ne_zero hx (by rw [h0, div_zero]; exact (O σ).zero_mem)
      have hu : IsUnit x := isUnit_of_dvd_one hd
      exact ((hu.map (algebraMap ↥W A)).map (algebraMap A K)).ne_zero h0
    have hvne : ∀ x : ↥W, x ≠ 0 → ν (algebraMap A K (algebraMap ↥W A x)) ≠ 0 :=
      fun x hx => (ν.ne_zero_iff).mpr (hF0' x hx)

    have hF1 : ∀ a : A, ν (algebraMap A K a) ≤ 1 := fun a => (hmemle _).mpr (hVIV a)

    have hF2 : ∀ w₁ w₂ : ↥W, w₁ ≠ 0 → w₂ ≠ 0 →
        ν (algebraMap A K (algebraMap ↥W A w₁)) ≤ ν (algebraMap A K (algebraMap ↥W A w₂)) →
        w₂ ∣ w₁ := by
      intro w₁ w₂ h1 h2 hle
      apply hVII w₁ w₂ h1 h2
      rw [← hmemle, Valuation.map_div]
      exact (div_le_one₀ (zero_lt_iff.mpr (hvne w₂ h2))).mpr hle
    have hveq : ∀ x y : K, x ≠ 0 → y ≠ 0 → x / y ∈ O σ → y / x ∈ O σ → ν x = ν y := by
      intro x y hx hy h1 h2
      rw [← hmemle, Valuation.map_div] at h1 h2
      have hx' : 0 < ν x := zero_lt_iff.mpr ((ν.ne_zero_iff).mpr hx)
      have hy' : 0 < ν y := zero_lt_iff.mpr ((ν.ne_zero_iff).mpr hy)
      exact le_antisymm ((div_le_one₀ hy').mp h1) ((div_le_one₀ hx').mp h2)
    obtain ⟨r, hr⟩ : ∃ r, ν (algebraMap A K (algebraMap ↥W A σ)) = r := ⟨_, rfl⟩

    have hr0 : 0 < r := by rw [← hr]; exact zero_lt_iff.mpr (hvne σ hσ0)
    have hr1 : r < 1 := by
      rw [← hr]
      by_contra hcon
      push_neg at hcon
      have hd : σ ∣ 1 := hF2 1 σ one_ne_zero hσ0 (by simpa using hcon)
      have := (IsLocalRing.mem_maximalIdeal _).mp hσm
      rw [mem_nonunits_iff] at this
      exact this (isUnit_of_dvd_one hd)

    have hF4 : ∀ (x : ↥W) (j : ℕ), σ ^ j ∣ x →
        ν (algebraMap A K (algebraMap ↥W A x)) ≤ r ^ j := by
      intro x j hx
      obtain ⟨y, rfl⟩ := hx
      rw [map_mul, map_mul, map_mul, map_pow, map_pow, Valuation.map_pow, hr]
      exact mul_le_of_le_one_right zero_le (hF1 _)

    have hPne : ∀ X : List ↥W, wcFrmP W σ X ≠ 0 := by
      intro X
      unfold wcFrmP
      refine mul_ne_zero (List.prod_ne_zero ?_) (pow_ne_zero _ hσ0)
      intro h0
      have := (List.mem_filter.mp h0).2
      simp at this
    have hP1 : wcFrmP W σ [] = 1 := by unfold wcFrmP; simp
    have hP0 : wcFrmP W σ [0] = σ := by unfold wcFrmP; simp [List.filter_cons]

    have hrepv : ∀ (G' : K) (a1 a2 : ↥W) (Z' Y' : List ↥W) (d' e' : A), G' ≠ 0 →
        wcFrmREP W A K 𝔭 u G' a1 a2 Z' Y' d' e' →
        ν (algebraMap A K (algebraMap ↥W A (a2 * wcFrmP W σ Y'))) * ν G' =
          ν (algebraMap A K (algebraMap ↥W A (a1 * wcFrmP W σ Z'))) := by
      intro G' a1 a2 Z' Y' d' e' hG hrep
      obtain ⟨h1, h2⟩ := hVI G' a1 a2 Z' Y' d' e' hG hrep
      have hne1 : algebraMap A K (algebraMap ↥W A (a2 * wcFrmP W σ Y')) * G' ≠ 0 :=
        mul_ne_zero (hF0' _ (mul_ne_zero hrep.2.1 (hPne Y'))) hG
      have hne2 : algebraMap A K (algebraMap ↥W A (a1 * wcFrmP W σ Z')) ≠ 0 :=
        hF0' _ (mul_ne_zero hrep.1 (hPne Z'))
      have := hveq _ _ hne1 hne2 h1 h2
      rw [Valuation.map_mul] at this
      exact this

    have hu0 : algebraMap A K u ≠ 0 := by
      have huv' : algebraMap A K u * algebraMap A K v = algebraMap A K (algebraMap ↥W A g) := by
        rw [← map_mul, huv]
      exact left_ne_zero_of_mul (by rw [huv']; exact hF0' g hg0)
    have hvU : ν (algebraMap A K u) = r := by
      have hrep : wcFrmREP W A K 𝔭 u (algebraMap A K u) 1 1 [0] [] 1 1 :=
        ⟨one_ne_zero, one_ne_zero, h1p, h1p, by simp⟩
      have := hrepv _ 1 1 [0] [] 1 1 hu0 hrep
      rw [hP1, hP0] at this
      rw [← hr]
      simpa using this

    have hvε : ∀ ε : A, ε ∉ 𝔭 → ν (algebraMap A K ε) = 1 := by
      intro ε hε
      have hε0 : algebraMap A K ε ≠ 0 := by
        intro h0
        apply hε
        rw [(map_eq_zero_iff _ (IsFractionRing.injective A K)).mp h0]
        exact Ideal.zero_mem _
      have hrep : wcFrmREP W A K 𝔭 u (algebraMap A K ε) 1 1 [] [] 1 ε :=
        ⟨one_ne_zero, one_ne_zero, h1p, hε, by simp⟩
      have := hrepv _ 1 1 [] [] 1 ε hε0 hrep
      rw [hP1] at this
      simpa using this

    have hvv : ν (algebraMap A K v) ≤ r ^ (n + k + 1) := by
      have hge : r * ν (algebraMap A K v) = ν (algebraMap A K (algebraMap ↥W A g)) := by
        rw [← hvU, ← Valuation.map_mul, ← map_mul, huv]
      have h2 : r * ν (algebraMap A K v) ≤ r * r ^ (n + k + 1) := by
        rw [hge, ← pow_succ']
        exact hF4 g _ hσg
      exact le_of_mul_le_mul_left h2 hr0

    have hbr : ∀ (j : ℕ) (ε r' g' : A), j ≤ n + k → ε ∉ 𝔭 →
        ν (algebraMap A K (u ^ j * ε + v * r' + algebraMap ↥W A w * g')) = r ^ j := by
      intro j ε r' g' hj hε
      have hfirst : ν (algebraMap A K (u ^ j * ε)) = r ^ j := by
        rw [map_mul, map_pow, Valuation.map_mul, Valuation.map_pow, hvU, hvε ε hε, mul_one]
      have hlt1 : ν (algebraMap A K (v * r')) < r ^ j := by
        rw [map_mul, Valuation.map_mul]
        calc ν (algebraMap A K v) * ν (algebraMap A K r')
            ≤ r ^ (n + k + 1) * 1 := mul_le_mul' hvv (hF1 r')
          _ = r ^ (n + k + 1) := mul_one _
          _ < r ^ j := pow_lt_pow_right_of_lt_one₀ hr0 hr1 (by omega)
      have hlt2 : ν (algebraMap A K (algebraMap ↥W A w * g')) < r ^ j := by
        rw [map_mul, Valuation.map_mul]
        calc ν (algebraMap A K (algebraMap ↥W A w)) * ν (algebraMap A K g')
            ≤ r ^ (n + k + 1 + 1) * 1 := mul_le_mul' (hF4 w _ hσw) (hF1 g')
          _ = r ^ (n + k + 1 + 1) := mul_one _
          _ < r ^ j := pow_lt_pow_right_of_lt_one₀ hr0 hr1 (by omega)
      have htail : ν (algebraMap A K (v * r') + algebraMap A K (algebraMap ↥W A w * g')) <
          ν (algebraMap A K (u ^ j * ε)) := by
        rw [hfirst]
        exact lt_of_le_of_lt (Valuation.map_add _ _ _) (max_lt hlt1 hlt2)
      have hsplit : algebraMap A K (u ^ j * ε + v * r' + algebraMap ↥W A w * g') =
          algebraMap A K (u ^ j * ε) +
            (algebraMap A K (v * r') + algebraMap A K (algebraMap ↥W A w * g')) := by
        rw [RingHom.map_add, RingHom.map_add, add_assoc]
      rw [hsplit, Valuation.map_add_eq_of_lt_left _ htail, hfirst]
    have hB1 := hbr n ε₁ r₁ g₁ (by omega) hε₁
    have hB0 := hbr k ε₀ r₀ g₀ (by omega) hε₀

    have hF8 := congrArg ν hI
    rw [Valuation.map_mul, Valuation.map_mul, Valuation.map_mul, hB1, hB0] at hF8

    have hRF := hrepv _ k1 k2 Z Y d e hF0 hR
    rw [(hPform σ Y hσm hYn).1, (hPform σ Z hσm hZn).1] at hRF
    simp only [map_mul, map_pow, Valuation.map_mul, Valuation.map_pow, hr] at hRF

    have key : ∀ (x1 x2 x3 y1 y2 y3 f a b c d' : (O σ).ValueGroup),
        f * c * y3 = x3 * d' → x1 * (x2 * a) * f = y1 * (y2 * b) →
        x1 * x2 * x3 * (a * d') = y1 * y2 * y3 * (b * c) := by
      intro x1 x2 x3 y1 y2 y3 f a b c d' h1 h2
      calc x1 * x2 * x3 * (a * d') = x1 * (x2 * a) * (x3 * d') := by ac_rfl
        _ = x1 * (x2 * a) * (f * c * y3) := by rw [h1]
        _ = (x1 * (x2 * a) * f) * (c * y3) := by ac_rfl
        _ = y1 * (y2 * b) * (c * y3) := by rw [h2]
        _ = y1 * y2 * y3 * (b * c) := by ac_rfl
    have hkey : ν (algebraMap A K (algebraMap ↥W A (k2 * qf Y * lam₁ * σ ^ (cf Y + k)))) =
        ν (algebraMap A K (algebraMap ↥W A (k1 * qf Z * lam₂ * σ ^ (cf Z + n)))) := by
      simp only [map_mul, map_pow, Valuation.map_mul, Valuation.map_pow, pow_add, hr]
      exact key _ _ _ _ _ _ _ _ _ _ _ hF8 hRF
    have hne1 : k2 * qf Y * lam₁ * σ ^ (cf Y + k) ≠ 0 :=
      mul_ne_zero (mul_ne_zero (mul_ne_zero hk2 (hqne Y)) hl1) (pow_ne_zero _ hσ0)
    have hne2 : k1 * qf Z * lam₂ * σ ^ (cf Z + n) ≠ 0 :=
      mul_ne_zero (mul_ne_zero (mul_ne_zero hk1 (hqne Z)) hl2) (pow_ne_zero _ hσ0)
    exact ⟨hF2 _ _ hne2 hne1 hkey.symm.le, hF2 _ _ hne1 hne2 hkey.le⟩

  refine ⟨ρ₀, ⟨hρ₀m, hρ₀0, hρ₀g, hgρ₀⟩, h, k1, k2, Z, Y, d, e, hR, ?_⟩
  intro ρ hρI hI0 _
  obtain ⟨hρm, hρ0, hρg, hgρ⟩ := hρI
  obtain ⟨hρρ₀, _⟩ := hI0
  obtain ⟨ρ', hρ'm, hρ'0, hρ'sq⟩ := hroot ρ hρm hρ0 1
  have hρ'ρ : ρ' ∣ ρ := by
    rw [← hρ'sq]
    exact dvd_pow_self _ (by norm_num)
  have hρ'nu : ¬ IsUnit ρ' := by
    have := (IsLocalRing.mem_maximalIdeal _).mp hρ'm
    rwa [mem_nonunits_iff] at this
  obtain ⟨hg1, hw1, hS1, hn1⟩ := hdivs ρ hρρ₀
  obtain ⟨hg2, hw2, _, hn2⟩ := hdivs ρ' (hρ'ρ.trans hρρ₀)
  have G1 := hgauss ρ ⟨hρm, hρ0, hρg, hgρ⟩ hg1 hw1 hn1
  have G2 := hgauss ρ' ⟨hρ'm, hρ'0, hρ'ρ.trans hρg, fun hd => hgρ (hd.trans hρ'ρ)⟩ hg2 hw2 hn2
  rw [← hρ'sq, ← pow_mul, ← pow_mul] at G1
  obtain ⟨hpq, hab⟩ := hexp (k2 * qf Y * lam₁) (k1 * qf Z * lam₂) ρ' (cf Y + k) (cf Z + n)
    (mul_ne_zero (mul_ne_zero hk2 (hqne Y)) hl1) hρ'0 hρ'nu G2.1 G2.2 G1.1 G1.2

  have hZn : ∀ x ∈ Z, x ∈ IsLocalRing.maximalIdeal ↥W → ρ ∣ x :=
    fun x hx => hn1 x (List.mem_append_left _ hx)
  have hYn : ∀ x ∈ Y, x ∈ IsLocalRing.maximalIdeal ↥W → ρ ∣ x :=
    fun x hx => hn1 x (List.mem_append_right _ hx)
  have hM : wcFrmM W ρ Z Y = (k : ℤ) - n := by
    unfold wcFrmM
    rw [(hPform ρ Z hρm hZn).2, (hPform ρ Y hρm hYn).2]
    omega
  unfold wcFrmGood
  rw [(hPform ρ Y hρm hYn).1, (hPform ρ Z hρm hZn).1, hM]
  rcases hD' with ⟨⟨μ, hμ⟩, hnk | ⟨lam', hl', hlS⟩⟩ | hnd
  · left
    have hk : k2 * qf Y * μ ∣ k1 * qf Z := by
      rw [hμ] at hab
      have : k2 * qf Y * μ * lam₂ ∣ k1 * qf Z * lam₂ := by
        have e' : k2 * qf Y * (lam₂ * μ) = k2 * qf Y * μ * lam₂ := by ring
        rw [← e']; exact hab
      exact (mul_dvd_mul_iff_right hl2).mp this
    calc k2 * (qf Y * ρ ^ cf Y) = k2 * qf Y * ρ ^ cf Y := by ring
      _ ∣ k2 * qf Y * μ * ρ ^ cf Z := mul_dvd_mul (dvd_mul_right _ _) (pow_dvd_pow ρ (by omega))
      _ ∣ k1 * qf Z * ρ ^ cf Z := mul_dvd_mul_right hk _
      _ = k1 * (qf Z * ρ ^ cf Z) := by ring
  · left
    have hμ' : μ = lam' := mul_left_cancel₀ hl2 (hμ.symm.trans hl')
    have hk : k2 * qf Y * lam' ∣ k1 * qf Z := by
      rw [hμ, hμ'] at hab
      have : k2 * qf Y * lam' * lam₂ ∣ k1 * qf Z * lam₂ := by
        have e' : k2 * qf Y * (lam₂ * lam') = k2 * qf Y * lam' * lam₂ := by ring
        rw [← e']; exact hab
      exact (mul_dvd_mul_iff_right hl2).mp this
    have hρn : ρ ^ n ∣ lam' :=
      ((pow_dvd_pow ρ (by omega : n ≤ n + k + 1 + 1)).trans hS1).trans hlS
    calc k2 * (qf Y * ρ ^ cf Y) = k2 * qf Y * ρ ^ cf Y := by ring
      _ ∣ k2 * qf Y * (ρ ^ n * ρ ^ cf Z) :=
          mul_dvd_mul_left _ (by rw [← pow_add]; exact pow_dvd_pow ρ (by omega))
      _ ∣ k2 * qf Y * (lam' * ρ ^ cf Z) := mul_dvd_mul_left _ (mul_dvd_mul_right hρn _)
      _ = k2 * qf Y * lam' * ρ ^ cf Z := by ring
      _ ∣ k1 * qf Z * ρ ^ cf Z := mul_dvd_mul_right hk _
      _ = k1 * (qf Z * ρ ^ cf Z) := by ring
  · right
    exact hnd

theorem wcFrm_end_v : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) → Module.finrank K L = ℓ →
    ∀ (α : L) (f₀ : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α →
    ∀ O : ↥W → ValuationSubring K, wcFrmVAL W A K 𝔭 u g O →
    ∃ ρ' : ↥W, ρ' ∈ IsLocalRing.maximalIdeal ↥W ∧ ρ' ≠ 0 ∧
      wcFrmMem W A K 𝔭 u g ℓ f₀ (fun ρ => ¬ ρ * ρ' ∣ g) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g hPD hdeg α f₀ hα1 hf₀ O hO
  classical


  have hroot : ∀ (x : ↥W), x ∈ IsLocalRing.maximalIdeal ↥W → x ≠ 0 → ∀ N : ℕ,
      ∃ y : ↥W, y ∈ IsLocalRing.maximalIdeal ↥W ∧ y ≠ 0 ∧ y ^ (N + 1) = x := by
    intro x hx hx0 N
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (x : Ω) (Nat.succ_pos N)
    have hxΩ : (x : Ω) ≠ 0 := fun h => hx0 (Subtype.ext h)
    have hz0 : z ≠ 0 := by
      rintro rfl
      rw [zero_pow (Nat.succ_ne_zero N)] at hz
      exact hxΩ hz.symm
    have hzW : z ∈ W := by
      rcases W.mem_or_inv_mem z with h | h
      · exact h
      · have e : z = (x : Ω) * z⁻¹ ^ N := by
          rw [← hz, inv_pow, pow_succ, mul_comm (z ^ N) z, mul_assoc,
            mul_inv_cancel₀ (pow_ne_zero _ hz0), mul_one]
        rw [e]
        exact mul_mem x.2 (pow_mem h N)
    have hyx : (⟨z, hzW⟩ : ↥W) ^ (N + 1) = x := Subtype.ext (by simp [hz])
    refine ⟨⟨z, hzW⟩, ?_, ?_, hyx⟩
    · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have h2 := hu.pow (N + 1)
      rw [hyx] at h2
      exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hx)) h2
    · intro h
      apply hz0
      have := congrArg Subtype.val h
      simpa using this

  have hcd : ∀ (g' w' ls : ↥W) (X : List ↥W), g' ∈ IsLocalRing.maximalIdeal ↥W → g' ≠ 0 →
      w' ∈ IsLocalRing.maximalIdeal ↥W → ls ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ G : ↥W, G ∈ IsLocalRing.maximalIdeal ↥W ∧ G ≠ 0 ∧ G ∣ g' ∧ G ∣ w' ∧ G ∣ ls ∧
        ∀ x ∈ X, ¬ g' ∣ x → ∃ q : ↥W, g' = x * q ∧ G ∣ q := by
    intro g' w' ls X hg hg0 hw hls
    have hmin : ∀ G s : ↥W, G ∈ IsLocalRing.maximalIdeal ↥W → G ≠ 0 →
        s ∈ IsLocalRing.maximalIdeal ↥W →
        ∃ G' : ↥W, G' ∈ IsLocalRing.maximalIdeal ↥W ∧ G' ≠ 0 ∧ G' ∣ G ∧ G' ∣ s := by
      intro G s hG hG0 hs
      rcases ValuationRing.dvd_total G s with h | h
      · exact ⟨G, hG, hG0, dvd_rfl, h⟩
      · by_cases hs0 : s = 0
        · exact ⟨G, hG, hG0, dvd_rfl, hs0 ▸ dvd_zero _⟩
        · exact ⟨s, hs, hs0, h, dvd_rfl⟩
    induction X with
    | nil =>
      obtain ⟨G1, h1, h10, h1g, h1w⟩ := hmin g' w' hg hg0 hw
      obtain ⟨G2, h2, h20, h21, h2l⟩ := hmin G1 ls h1 h10 hls
      exact ⟨G2, h2, h20, h21.trans h1g, h21.trans h1w, h2l, fun x hx => by simp at hx⟩
    | cons x X ih =>
      obtain ⟨G, hG, hG0, hGg, hGw, hGl, hGX⟩ := ih
      by_cases hgx : g' ∣ x
      · refine ⟨G, hG, hG0, hGg, hGw, hGl, ?_⟩
        intro y hy hgy
        rcases List.mem_cons.mp hy with hyx | hy
        · exact absurd (hyx ▸ hgx) hgy
        · exact hGX y hy hgy
      · obtain ⟨q, hq⟩ := (ValuationRing.dvd_total x g').resolve_right hgx
        have hqm : q ∈ IsLocalRing.maximalIdeal ↥W := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          intro hu
          apply hgx
          obtain ⟨q', hq'⟩ := hu.exists_right_inv
          exact ⟨q', by rw [hq, mul_assoc, hq', mul_one]⟩
        obtain ⟨G', h', h'0, h'G, h'q⟩ := hmin G q hG hG0 hqm
        refine ⟨G', h', h'0, h'G.trans hGg, h'G.trans hGw, h'G.trans hGl, ?_⟩
        intro y hy hgy
        rcases List.mem_cons.mp hy with hyx | hy
        · exact ⟨q, hyx ▸ hq, h'q⟩
        · obtain ⟨q2, hq2, hGq2⟩ := hGX y hy hgy
          exact ⟨q2, hq2, h'G.trans hGq2⟩

  have hexp : ∀ (a b σ : ↥W) (p q : ℕ), a ≠ 0 → σ ≠ 0 →
      ¬ IsUnit σ → a * σ ^ p ∣ b * σ ^ q → b * σ ^ q ∣ a * σ ^ p →
      a * σ ^ (2 * p) ∣ b * σ ^ (2 * q) → b * σ ^ (2 * q) ∣ a * σ ^ (2 * p) →
      (p = q ∧ a ∣ b) := by
    intro a b σ p q ha hσ hσu h1 h1' h2 h2'
    have A1 : Associated (a * σ ^ p) (b * σ ^ q) := associated_of_dvd_dvd h1 h1'
    have A2 : Associated (a * σ ^ p * σ ^ p) (b * σ ^ q * σ ^ q) := by
      have := associated_of_dvd_dvd h2 h2'
      rwa [two_mul, two_mul, pow_add, pow_add, ← mul_assoc, ← mul_assoc] at this
    have hne : a * σ ^ p ≠ 0 := mul_ne_zero ha (pow_ne_zero _ hσ)
    have A3 : Associated (σ ^ p) (σ ^ q) := Associated.of_mul_left A2 A1 hne
    have hpq : p = q := le_antisymm ((pow_dvd_pow_iff hσ hσu).mp A3.dvd)
      ((pow_dvd_pow_iff hσ hσu).mp A3.symm.dvd)
    subst hpq
    exact ⟨rfl, (Associated.of_mul_right A1 (Associated.refl _) (pow_ne_zero _ hσ)).dvd⟩

  have hgood : ∀ (ρ τ g' k1 k2 lam₁ lam₂ qZ qY : ↥W) (cZ cY n k : ℕ), ρ ≠ 0 → τ ≠ 0 →
      lam₂ ≠ 0 → g' = ρ * τ → cZ + k = cY + n →
      k2 * qY * g' ^ cY * lam₁ ∣ k1 * qZ * g' ^ cZ * lam₂ →
      ((lam₂ ∣ lam₁ ∧ (n ≤ k ∨ ∃ lam' : ↥W, lam₁ = lam₂ * lam' ∧ τ ^ n ∣ lam')) ∨
        ¬ (ℓ : ℤ) ∣ ((k : ℤ) - n)) →
      (k2 * (qY * ρ ^ cY) ∣ k1 * (qZ * ρ ^ cZ) ∨ ¬ (ℓ : ℤ) ∣ ((cZ : ℤ) - (cY : ℤ))) := by
    intro ρ τ g k1 k2 lam₁ lam₂ qZ qY cZ cY n k hρ hτ hl2 hg hc hab hD
    have hg0 : g ≠ 0 := hg ▸ mul_ne_zero hρ hτ
    have hcz : (cZ : ℤ) - cY = -((k : ℤ) - n) := by omega
    rcases hD with ⟨⟨μ, hμ⟩, hB⟩ | hD
    · left
      have H : k2 * qY * g ^ cY * μ ∣ k1 * qZ * g ^ cZ := by
        have h' : k2 * qY * g ^ cY * μ * lam₂ ∣ k1 * qZ * g ^ cZ * lam₂ := by
          rw [hμ] at hab
          calc k2 * qY * g ^ cY * μ * lam₂ = k2 * qY * g ^ cY * (lam₂ * μ) := by ring
            _ ∣ _ := hab
        exact (mul_dvd_mul_iff_right hl2).mp h'
      rcases le_or_gt n k with hnk | hnk
      · obtain ⟨j, hj⟩ := Nat.exists_eq_add_of_le hnk
        have hcY : cY = cZ + j := by omega
        subst hcY
        have H2 : k2 * qY * g ^ j * μ ∣ k1 * qZ := by
          have h' : k2 * qY * g ^ j * μ * g ^ cZ ∣ k1 * qZ * g ^ cZ := by
            calc k2 * qY * g ^ j * μ * g ^ cZ = k2 * qY * g ^ (cZ + j) * μ := by ring
              _ ∣ _ := H
          exact (mul_dvd_mul_iff_right (pow_ne_zero _ hg0)).mp h'
        have hρg : ρ ^ j ∣ g ^ j := pow_dvd_pow_of_dvd (hg ▸ dvd_mul_right ρ τ) j
        have H3 : k2 * qY * ρ ^ j ∣ k1 * qZ :=
          (mul_dvd_mul_left (k2 * qY) hρg).trans ((dvd_mul_right _ μ).trans H2)
        calc k2 * (qY * ρ ^ (cZ + j)) = k2 * qY * ρ ^ j * ρ ^ cZ := by ring
          _ ∣ k1 * qZ * ρ ^ cZ := mul_dvd_mul_right H3 _
          _ = k1 * (qZ * ρ ^ cZ) := by ring
      · rcases hB with hB | ⟨lam', hl, hτl⟩
        · omega
        · have hμl : μ = lam' := by
            rw [hμ] at hl
            exact mul_left_cancel₀ hl2 hl
          subst hμl
          obtain ⟨j, hj⟩ := Nat.exists_eq_add_of_le hnk.le
          have hcZ : cZ = cY + j := by omega
          subst hcZ
          have hτj : τ ^ j ∣ μ := (pow_dvd_pow τ (by omega)).trans hτl
          have H2 : k2 * qY * μ ∣ k1 * qZ * g ^ j := by
            have h' : k2 * qY * μ * g ^ cY ∣ k1 * qZ * g ^ j * g ^ cY := by
              calc k2 * qY * μ * g ^ cY = k2 * qY * g ^ cY * μ := by ring
                _ ∣ k1 * qZ * g ^ (cY + j) := H
                _ = k1 * qZ * g ^ j * g ^ cY := by ring
            exact (mul_dvd_mul_iff_right (pow_ne_zero _ hg0)).mp h'
          have H3 : k2 * qY * τ ^ j ∣ k1 * qZ * ρ ^ j * τ ^ j := by
            calc k2 * qY * τ ^ j ∣ k2 * qY * μ := mul_dvd_mul_left _ hτj
              _ ∣ k1 * qZ * g ^ j := H2
              _ = k1 * qZ * ρ ^ j * τ ^ j := by rw [hg, mul_pow]; ring
          have H4 : k2 * qY ∣ k1 * qZ * ρ ^ j :=
            (mul_dvd_mul_iff_right (pow_ne_zero _ hτ)).mp H3
          calc k2 * (qY * ρ ^ cY) = k2 * qY * ρ ^ cY := by ring
            _ ∣ k1 * qZ * ρ ^ j * ρ ^ cY := mul_dvd_mul_right H4 _
            _ = k1 * (qZ * ρ ^ (cY + j)) := by ring
    · right
      rw [hcz, dvd_neg]
      exact hD

  have hsplit : ∀ (g' ρ τ ρ' : ↥W) (X : List ↥W), ρ ≠ 0 → ρ * τ = g' → ¬ ρ' ∣ τ →
      (∀ x ∈ X, ¬ g' ∣ x → ∃ q : ↥W, g' = x * q ∧ ρ' ∣ q) →
      (wcFrmP W ρ X = (X.filter (fun x => @decide (¬ g' ∣ x) (Classical.propDecidable _))).prod *
          ρ ^ (X.filter (fun x => @decide (g' ∣ x) (Classical.propDecidable _))).length ∧
        (X.filter (fun x => @decide (ρ ∣ x) (Classical.propDecidable _))).length =
          (X.filter (fun x => @decide (g' ∣ x) (Classical.propDecidable _))).length) := by
    intro g ρ τ ρ' X hρ hg hτ hX
    have key : ∀ x ∈ X, (ρ ∣ x ↔ g ∣ x) := by
      intro x hx
      constructor
      · intro hρx
        by_contra hgx
        obtain ⟨q, hq, hq'⟩ := hX x hx hgx
        obtain ⟨c, hc⟩ := hρx
        apply hτ
        have e : τ = c * q := by
          apply mul_left_cancel₀ hρ
          rw [hg, hq, hc, mul_assoc]
        rw [e]
        exact dvd_mul_of_dvd_right hq' c
      · intro hgx
        exact (Dvd.intro τ hg).trans hgx
    have e1 : X.filter (fun x => @decide (ρ ∣ x) (Classical.propDecidable _)) =
        X.filter (fun x => @decide (g ∣ x) (Classical.propDecidable _)) :=
      List.filter_congr (fun x hx => decide_eq_decide.mpr (key x hx))
    have e2 : X.filter (fun x => @decide (¬ ρ ∣ x) (Classical.propDecidable _)) =
        X.filter (fun x => @decide (¬ g ∣ x) (Classical.propDecidable _)) :=
      List.filter_congr (fun x hx => decide_eq_decide.mpr (not_congr (key x hx)))
    refine ⟨?_, by rw [e1]⟩
    unfold wcFrmP
    rw [e1, e2]

  have hΩ : ((ℓ : ℕ) : Ω) = 0 := by
    rw [← hchar]
    exact ringChar.Nat.cast_ringChar
  have hWl : ((ℓ : ℕ) : ↥W) = 0 := by
    apply Subtype.ext
    simpa using hΩ
  have hK : ((ℓ : ℕ) : K) = 0 := by
    have e : ((ℓ : ℕ) : K) = algebraMap A K (algebraMap ↥W A ((ℓ : ℕ) : ↥W)) := by
      rw [map_natCast, map_natCast]
    rw [e, hWl, map_zero, map_zero]
  have hL : ((ℓ : ℕ) : L) = 0 := by
    rw [← map_natCast (algebraMap K L), hK, map_zero]
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : CharP L ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hL
  have h𝔭 : 𝔭.IsMaximal := hPD.2.2.2.1
  have hgm : g ∈ IsLocalRing.maximalIdeal ↥W := hPD.2.2.2.2.2.1
  have hg0 : g ≠ 0 := hPD.2.2.2.2.2.2.1
  have huv : u * v = algebraMap ↥W A g := hPD.2.2.2.2.2.2.2.1

  have hPD' := wcpa_dj_llsm_kpwic_pd_swap W A 𝔭 u v g hPD
  obtain ⟨H0, lam₁, lam₂, w, n, k, ε₀, ε₁, r₀, r₁, g₀, g₁, hl1, hl2, hw, he0, he1, hI, hD⟩ :=
    wcLlsASb_boundary_form Ω W hW hWt ℓ hℓ A K L 𝔭 v u g hPD' hK α f₀ hα1 hf₀

  have hF0 : f₀ - (H0 ^ ℓ - H0) ≠ 0 := by
    intro h0
    have e1 : algebraMap K L f₀ = (algebraMap K L H0) ^ ℓ - algebraMap K L H0 := by
      rw [sub_eq_zero.mp h0, map_sub, map_pow]
    have e2 : (α - algebraMap K L H0) ^ ℓ = α - algebraMap K L H0 := by
      rw [sub_pow_char, ← sub_eq_zero,
        show α ^ ℓ - algebraMap K L H0 ^ ℓ - (α - algebraMap K L H0) =
          (α ^ ℓ - α) - (algebraMap K L H0 ^ ℓ - algebraMap K L H0) by ring, ← hf₀, e1, sub_self]
    have hbot : α - algebraMap K L H0 ∈ (⊥ : Subfield L) :=
      (Subfield.mem_bot_iff_pow_eq_self L ℓ).mpr e2
    have hr := (bot_le : (⊥ : Subfield L) ≤ (algebraMap K L).fieldRange) hbot
    obtain ⟨x, hx⟩ := RingHom.mem_fieldRange.mp hr
    exact hα1 ⟨x + H0, by rw [map_add, hx, sub_add_cancel]⟩

  obtain ⟨k1, k2, Z, Y, d, e, hR⟩ := wcFrm_rep_exists Ω W hW hWt A K 𝔭 u v g hPD _ hF0

  have hgauss : ∀ ρ τ : ↥W, wcFrmInt W g ρ → ρ * τ = g → τ ∈ IsLocalRing.maximalIdeal ↥W →
      τ ^ (n + k + 1) ∣ ρ → τ ^ (n + k + 1) ∣ w →
      (k2 * wcFrmP W ρ Y * lam₁ * τ ^ k ∣ k1 * wcFrmP W ρ Z * lam₂ * τ ^ n ∧
        k1 * wcFrmP W ρ Z * lam₂ * τ ^ n ∣ k2 * wcFrmP W ρ Y * lam₁ * τ ^ k) := by
    intro ρ τ hInt hρτ hτm hτρ hτw
    obtain ⟨hVi, hVii, hViv⟩ := hO ρ hInt
    have hρ0 : ρ ≠ 0 := hInt.2.1
    have hτ0 : τ ≠ 0 := fun h => hg0 (by rw [← hρτ, h, mul_zero])
    have hle1 : ∀ a : A, (O ρ).valuation (algebraMap A K a) ≤ 1 :=
      fun a => ((O ρ).valuation_le_one_iff _).mpr (hViv a)
    have hmemle : ∀ x y : K, y ≠ 0 → x / y ∈ O ρ → (O ρ).valuation x ≤ (O ρ).valuation y := by
      intro x y hy hxy
      have h := ((O ρ).valuation_le_one_iff _).mpr hxy
      calc (O ρ).valuation x = (O ρ).valuation (x / y) * (O ρ).valuation y := by
            rw [← Valuation.map_mul, div_mul_cancel₀ x hy]
        _ ≤ 1 * (O ρ).valuation y := by gcongr
        _ = (O ρ).valuation y := one_mul _
    have hbr0 : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
      intro x hx h0
      have h1 : algebraMap A K (algebraMap ↥W A 1) / algebraMap A K (algebraMap ↥W A x) ∈ O ρ := by
        rw [h0, div_zero]; exact (O ρ).zero_mem
      obtain ⟨c, hc⟩ := hVii 1 x one_ne_zero hx h1
      have hu : IsUnit x := isUnit_of_dvd_one ⟨c, hc⟩
      have hu2 := hu.map ((algebraMap A K).comp (algebraMap ↥W A))
      exact hu2.ne_zero h0
    have hνne : ∀ x : ↥W, x ≠ 0 → (O ρ).valuation (algebraMap A K (algebraMap ↥W A x)) ≠ 0 :=
      fun x hx => (Valuation.ne_zero_iff _).mpr (hbr0 x hx)
    have hF2 : ∀ w₁ w₂ : ↥W, w₁ ≠ 0 → w₂ ≠ 0 →
        (O ρ).valuation (algebraMap A K (algebraMap ↥W A w₁)) ≤
          (O ρ).valuation (algebraMap A K (algebraMap ↥W A w₂)) → w₂ ∣ w₁ := by
      intro w₁ w₂ h1 h2 hle
      apply hVii w₁ w₂ h1 h2
      rw [← (O ρ).valuation_le_one_iff, map_div₀]
      calc (O ρ).valuation (algebraMap A K (algebraMap ↥W A w₁)) /
            (O ρ).valuation (algebraMap A K (algebraMap ↥W A w₂))
          = (O ρ).valuation (algebraMap A K (algebraMap ↥W A w₁)) *
            ((O ρ).valuation (algebraMap A K (algebraMap ↥W A w₂)))⁻¹ := div_eq_mul_inv _ _
        _ ≤ (O ρ).valuation (algebraMap A K (algebraMap ↥W A w₂)) *
            ((O ρ).valuation (algebraMap A K (algebraMap ↥W A w₂)))⁻¹ := by gcongr
        _ = 1 := mul_inv_cancel₀ (hνne w₂ h2)
    have hF3 : ∀ σ : ↥W, σ ∈ IsLocalRing.maximalIdeal ↥W → σ ≠ 0 →
        (O ρ).valuation (algebraMap A K (algebraMap ↥W A σ)) < 1 := by
      intro σ hσ hσ0
      by_contra hlt
      have hlt' : 1 ≤ (O ρ).valuation (algebraMap A K (algebraMap ↥W A σ)) := not_lt.mp hlt
      have h1 : (O ρ).valuation (algebraMap A K (algebraMap ↥W A 1)) ≤
          (O ρ).valuation (algebraMap A K (algebraMap ↥W A σ)) := by
        rw [map_one, map_one, Valuation.map_one]; exact hlt'
      have hd := hF2 1 σ one_ne_zero hσ0 h1
      exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hσ)) (isUnit_of_dvd_one hd)
    have hF4 : ∀ (σ x : ↥W) (j : ℕ), σ ^ j ∣ x →
        (O ρ).valuation (algebraMap A K (algebraMap ↥W A x)) ≤
          (O ρ).valuation (algebraMap A K (algebraMap ↥W A σ)) ^ j := by
      rintro σ x j ⟨y, rfl⟩
      rw [map_mul, map_mul, Valuation.map_mul, map_pow, map_pow, Valuation.map_pow]
      exact mul_le_of_le_one_right' (hle1 _)
    have hPne : ∀ X : List ↥W, wcFrmP W ρ X ≠ 0 := by
      intro X
      unfold wcFrmP
      refine mul_ne_zero ?_ (pow_ne_zero _ hρ0)
      apply List.prod_ne_zero
      intro h0
      have := (List.mem_filter.mp h0).2
      simp at this
    have hVeq : ∀ (F : K) (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A), F ≠ 0 →
        wcFrmREP W A K 𝔭 u F k1 k2 Z Y d e → k1 ≠ 0 → k2 ≠ 0 →
        (O ρ).valuation (algebraMap A K (algebraMap ↥W A (k2 * wcFrmP W ρ Y))) *
            (O ρ).valuation F =
          (O ρ).valuation (algebraMap A K (algebraMap ↥W A (k1 * wcFrmP W ρ Z))) := by
      intro F k1 k2 Z Y d e hF hR h1 h2
      obtain ⟨i1, i2⟩ := hVi F k1 k2 Z Y d e hF hR
      rw [← Valuation.map_mul]
      exact le_antisymm (hmemle _ _ (hbr0 _ (mul_ne_zero h1 (hPne Z))) i1)
        (hmemle _ _ (mul_ne_zero (hbr0 _ (mul_ne_zero h2 (hPne Y))) hF) i2)
    have h1n : (1 : A) ∉ 𝔭 := fun h => h𝔭.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    have hPnil : wcFrmP W ρ [] = 1 := by simp [wcFrmP]
    have hP0 : wcFrmP W ρ [0] = ρ := by simp [wcFrmP]
    have hu0 : algebraMap A K u ≠ 0 := by
      intro h
      apply hbr0 g hg0
      rw [← huv, map_mul, h, zero_mul]
    have hF5 : (O ρ).valuation (algebraMap A K u) =
        (O ρ).valuation (algebraMap A K (algebraMap ↥W A ρ)) := by
      have hRu : wcFrmREP W A K 𝔭 u (algebraMap A K u) 1 1 [0] [] 1 1 :=
        ⟨one_ne_zero, one_ne_zero, h1n, h1n, by simp⟩
      have := hVeq _ 1 1 [0] [] 1 1 hu0 hRu one_ne_zero one_ne_zero
      simpa only [hP0, hPnil, one_mul, map_one, Valuation.map_one] using this
    have hF5v : (O ρ).valuation (algebraMap A K v) =
        (O ρ).valuation (algebraMap A K (algebraMap ↥W A τ)) := by
      have h : (O ρ).valuation (algebraMap A K u) * (O ρ).valuation (algebraMap A K v) =
          (O ρ).valuation (algebraMap A K (algebraMap ↥W A ρ)) *
            (O ρ).valuation (algebraMap A K (algebraMap ↥W A τ)) := by
        rw [← Valuation.map_mul, ← map_mul, huv, ← hρτ, map_mul, map_mul, Valuation.map_mul]
      rw [hF5] at h
      exact mul_left_cancel₀ (hνne ρ hρ0) h
    have hF6 : ∀ ε : A, ε ∉ 𝔭 → (O ρ).valuation (algebraMap A K ε) = 1 := by
      intro ε hε
      have hε0 : algebraMap A K ε ≠ 0 := by
        intro h
        apply hε
        have : ε = 0 := (IsFractionRing.injective A K) (by rw [h, map_zero])
        rw [this]; exact 𝔭.zero_mem
      have hRe : wcFrmREP W A K 𝔭 u (algebraMap A K ε) 1 1 [] [] 1 ε :=
        ⟨one_ne_zero, one_ne_zero, h1n, hε, by simp⟩
      have := hVeq _ 1 1 [] [] 1 ε hε0 hRe one_ne_zero one_ne_zero
      simpa only [hPnil, one_mul, map_one, Valuation.map_one] using this
    have ht0 : (O ρ).valuation (algebraMap A K (algebraMap ↥W A τ)) ≠ 0 := hνne τ hτ0
    have ht1 : (O ρ).valuation (algebraMap A K (algebraMap ↥W A τ)) < 1 := hF3 τ hτm hτ0
    have hνu : (O ρ).valuation (algebraMap A K u) ≤
        (O ρ).valuation (algebraMap A K (algebraMap ↥W A τ)) ^ (n + k + 1) := by
      rw [hF5]; exact hF4 τ ρ _ hτρ
    have hνw : (O ρ).valuation (algebraMap A K (algebraMap ↥W A w)) ≤
        (O ρ).valuation (algebraMap A K (algebraMap ↥W A τ)) ^ (n + k + 1) := hF4 τ w _ hτw
    have hbr : ∀ (m j : ℕ) (ε r gg : A), ε ∉ 𝔭 → m + j + 1 = n + k + 1 →
        (O ρ).valuation (algebraMap A K (v ^ m * ε + u * r + algebraMap ↥W A w * gg)) =
          (O ρ).valuation (algebraMap A K (algebraMap ↥W A τ)) ^ m := by
      intro m j ε r gg hε hmj
      have hhead : (O ρ).valuation (algebraMap A K (v ^ m * ε)) =
          (O ρ).valuation (algebraMap A K (algebraMap ↥W A τ)) ^ m := by
        rw [map_mul, Valuation.map_mul, map_pow, Valuation.map_pow, hF5v, hF6 ε hε, mul_one]
      have hlt : (O ρ).valuation (algebraMap A K (algebraMap ↥W A τ)) ^ (n + k + 1) <
          (O ρ).valuation (algebraMap A K (algebraMap ↥W A τ)) ^ m := by
        rw [← hmj, add_assoc, pow_add]
        apply mul_lt_of_lt_one_right (pow_pos (zero_lt_iff.mpr ht0) m)
        exact pow_lt_one₀ zero_le' ht1 (Nat.succ_ne_zero j)
      have htail : (O ρ).valuation (algebraMap A K (u * r + algebraMap ↥W A w * gg)) <
          (O ρ).valuation (algebraMap A K (v ^ m * ε)) := by
        rw [hhead]
        refine lt_of_le_of_lt ?_ hlt
        rw [map_add]
        refine ((O ρ).valuation.map_add _ _).trans (max_le ?_ ?_)
        · rw [map_mul, Valuation.map_mul]
          exact (mul_le_of_le_one_right' (hle1 r)).trans hνu
        · rw [map_mul, Valuation.map_mul]
          exact (mul_le_of_le_one_right' (hle1 gg)).trans hνw
      rw [add_assoc, map_add, Valuation.map_add_eq_of_lt_left _ htail]
      exact hhead
    have hF8 := congrArg (O ρ).valuation hI
    simp only [Valuation.map_mul] at hF8
    rw [hbr n k ε₁ r₁ g₁ he1 rfl, hbr k n ε₀ r₀ g₀ he0 (by omega)] at hF8
    have hF9 := hVeq _ k1 k2 Z Y d e hF0 hR hR.1 hR.2.1
    have key : ∀ (a f c l1 l2 x y : (O ρ).ValueGroup), a * f = c → f * y * l2 = l1 * x →
        a * l1 * x = c * l2 * y := by
      intro a f c l1 l2 x y h1 h2
      rw [← h1, mul_assoc a l1 x, ← h2]
      ac_rfl
    have hval : (O ρ).valuation
          (algebraMap A K (algebraMap ↥W A (k2 * wcFrmP W ρ Y * lam₁ * τ ^ k))) =
        (O ρ).valuation
          (algebraMap A K (algebraMap ↥W A (k1 * wcFrmP W ρ Z * lam₂ * τ ^ n))) := by
      have e1 : ∀ (a l : ↥W) (j : ℕ),
          (O ρ).valuation (algebraMap A K (algebraMap ↥W A (a * l * τ ^ j))) =
            (O ρ).valuation (algebraMap A K (algebraMap ↥W A a)) *
              (O ρ).valuation (algebraMap A K (algebraMap ↥W A l)) *
              (O ρ).valuation (algebraMap A K (algebraMap ↥W A τ)) ^ j := by
        intro a l j
        rw [map_mul (algebraMap ↥W A) (a * l), map_mul (algebraMap ↥W A) a,
          map_pow (algebraMap ↥W A), map_mul (algebraMap A K), map_mul (algebraMap A K),
          map_pow (algebraMap A K), Valuation.map_mul, Valuation.map_mul, Valuation.map_pow]
      rw [e1, e1]
      exact key _ _ _ _ _ _ _ hF9 hF8
    have hane : k2 * wcFrmP W ρ Y * lam₁ * τ ^ k ≠ 0 :=
      mul_ne_zero (mul_ne_zero (mul_ne_zero hR.2.1 (hPne Y)) hl1) (pow_ne_zero _ hτ0)
    have hbne : k1 * wcFrmP W ρ Z * lam₂ * τ ^ n ≠ 0 :=
      mul_ne_zero (mul_ne_zero (mul_ne_zero hR.1 (hPne Z)) hl2) (pow_ne_zero _ hτ0)
    exact ⟨hF2 _ _ hbne hane hval.symm.le, hF2 _ _ hane hbne hval.le⟩

  obtain ⟨ls, hlsm, hD'⟩ : ∃ ls : ↥W, ls ∈ IsLocalRing.maximalIdeal ↥W ∧
      ((lam₂ ∣ lam₁ ∧ (n ≤ k ∨ ∃ lam' : ↥W, lam₁ = lam₂ * lam' ∧ ls ∣ lam')) ∨
        ¬ (ℓ : ℤ) ∣ ((k : ℤ) - n)) := by
    rcases hD with ⟨hd, hnk | ⟨lam', hl', hlm⟩⟩ | hD
    · exact ⟨0, Ideal.zero_mem _, Or.inl ⟨hd, Or.inl hnk⟩⟩
    · exact ⟨lam', hlm, Or.inl ⟨hd, Or.inr ⟨lam', hl', dvd_rfl⟩⟩⟩
    · exact ⟨0, Ideal.zero_mem _, Or.inr hD⟩

  obtain ⟨G, hGm, hG0, hGg, hGw, hGl, hGX⟩ := hcd g w ls (Z ++ Y) hgm hg0 hw hlsm
  obtain ⟨ρ', hρ'm, hρ'0, hρ'G⟩ := hroot G hGm hG0 (n + k + 1)
  have hρ'dG : ρ' ∣ G := hρ'G ▸ dvd_pow_self ρ' (Nat.succ_ne_zero _)
  have hXZ : ∀ x ∈ Z, ¬ g ∣ x → ∃ q : ↥W, g = x * q ∧ ρ' ∣ q := by
    intro x hx hgx
    obtain ⟨q, hq, hGq⟩ := hGX x (List.mem_append_left _ hx) hgx
    exact ⟨q, hq, hρ'dG.trans hGq⟩
  have hXY : ∀ x ∈ Y, ¬ g ∣ x → ∃ q : ↥W, g = x * q ∧ ρ' ∣ q := by
    intro x hx hgx
    obtain ⟨q, hq, hGq⟩ := hGX x (List.mem_append_right _ hx) hgx
    exact ⟨q, hq, hρ'dG.trans hGq⟩

  have hqne : ∀ X : List ↥W,
      (X.filter (fun x => @decide (¬ g ∣ x) (Classical.propDecidable _))).prod ≠ 0 := by
    intro X
    apply List.prod_ne_zero
    intro h0
    have := (List.mem_filter.mp h0).2
    simp at this
  obtain ⟨qZ, hqZdef⟩ : ∃ q, q = (Z.filter (fun x => @decide (¬ g ∣ x) (Classical.propDecidable _))).prod :=
    ⟨_, rfl⟩
  obtain ⟨qY, hqYdef⟩ : ∃ q, q = (Y.filter (fun x => @decide (¬ g ∣ x) (Classical.propDecidable _))).prod :=
    ⟨_, rfl⟩
  obtain ⟨cZ, hcZdef⟩ : ∃ c, c = (Z.filter (fun x => @decide (g ∣ x) (Classical.propDecidable _))).length :=
    ⟨_, rfl⟩
  obtain ⟨cY, hcYdef⟩ : ∃ c, c = (Y.filter (fun x => @decide (g ∣ x) (Classical.propDecidable _))).length :=
    ⟨_, rfl⟩
  have hqZ0 : qZ ≠ 0 := hqZdef ▸ hqne Z
  have hqY0 : qY ≠ 0 := hqYdef ▸ hqne Y

  have hpair : ∀ R T : ↥W, R * T = g → T ≠ 0 → T ∣ ρ' →
      T ^ (n + k + 1) ∣ R ∧ T ^ (n + k + 1) ∣ w ∧ T ^ (n + k + 1 + 1) ∣ G := by
    intro R T hRT hT0 hTρ'
    have hTG : T ^ (n + k + 1 + 1) ∣ G := hρ'G ▸ pow_dvd_pow_of_dvd hTρ' _
    refine ⟨?_, (pow_dvd_pow T (Nat.le_succ _)).trans (hTG.trans hGw), hTG⟩
    have h1 : T ^ (n + k + 1) * T ∣ R * T := by
      rw [← pow_succ, hRT]; exact hTG.trans hGg
    exact (mul_dvd_mul_iff_right hT0).mp h1

  have hresc : ∀ R T : ↥W, wcFrmInt W g R → R * T = g → T ∈ IsLocalRing.maximalIdeal ↥W →
      T ≠ 0 → T ∣ ρ' → ¬ ρ' ∣ T →
      (k2 * qY * g ^ cY * lam₁ * T ^ (cZ + k) ∣ k1 * qZ * g ^ cZ * lam₂ * T ^ (cY + n) ∧
        k1 * qZ * g ^ cZ * lam₂ * T ^ (cY + n) ∣ k2 * qY * g ^ cY * lam₁ * T ^ (cZ + k)) := by
    intro R T hRint hRT hTm hT0 hTρ' hnT
    obtain ⟨hTR, hTw, -⟩ := hpair R T hRT hT0 hTρ'
    obtain ⟨d1, d2⟩ := hgauss R T hRint hRT hTm hTR hTw
    obtain ⟨hPZ, -⟩ := hsplit g R T ρ' Z hRint.2.1 hRT hnT hXZ
    obtain ⟨hPY, -⟩ := hsplit g R T ρ' Y hRint.2.1 hRT hnT hXY
    rw [hPZ, hPY, ← hqZdef, ← hqYdef, ← hcZdef, ← hcYdef] at d1 d2
    rw [← hRT]
    constructor
    · have := mul_dvd_mul_right d1 (T ^ (cY + cZ))
      convert this using 1 <;> ring
    · have := mul_dvd_mul_right d2 (T ^ (cY + cZ))
      convert this using 1 <;> ring

  refine ⟨ρ', hρ'm, hρ'0, H0, k1, k2, Z, Y, d, e, hR, ?_⟩
  intro ρ hInt hreg _hgen
  have hreg' : ¬ ρ * ρ' ∣ g := hreg
  have hρ0 : ρ ≠ 0 := hInt.2.1

  obtain ⟨τ, hτ⟩ := hInt.2.2.1
  have hτ0 : τ ≠ 0 := by
    rintro rfl
    exact hg0 (by rw [hτ, mul_zero])
  have hτm : τ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    apply hInt.2.2.2
    obtain ⟨τ', hτ'⟩ := hu.exists_right_inv
    exact ⟨τ', by rw [hτ, mul_assoc, hτ', mul_one]⟩
  have hnτ : ¬ ρ' ∣ τ := by
    intro h
    apply hreg'
    rw [hτ]
    exact mul_dvd_mul_left ρ h
  have hτρ' : τ ∣ ρ' := (ValuationRing.dvd_total τ ρ').resolve_right hnτ

  obtain ⟨τ₂, hτ₂m, hτ₂0, hτ₂sq⟩ := hroot τ hτm hτ0 1
  have hτ₂sq' : τ₂ ^ 2 = τ := hτ₂sq
  have hg2 : ρ * τ₂ * τ₂ = g := by rw [hτ, ← hτ₂sq']; ring
  have hτ₂nu : ¬ IsUnit τ₂ := mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hτ₂m)
  have hInt2 : wcFrmInt W g (ρ * τ₂) := by
    refine ⟨Ideal.mul_mem_right τ₂ _ hInt.1, mul_ne_zero hρ0 hτ₂0, ⟨τ₂, hg2.symm⟩, ?_⟩
    intro hdv
    rw [← hg2] at hdv
    have h1 : ρ * τ₂ * τ₂ ∣ ρ * τ₂ * 1 := by rw [mul_one]; exact hdv
    exact hτ₂nu (isUnit_of_dvd_one ((mul_dvd_mul_iff_left (mul_ne_zero hρ0 hτ₂0)).mp h1))
  have hτ₂τ : τ₂ ∣ τ := ⟨τ₂, by rw [← hτ₂sq', pow_two]⟩
  have hnτ₂ : ¬ ρ' ∣ τ₂ := fun h => hnτ (h.trans hτ₂τ)

  obtain ⟨a1, a1'⟩ := hresc ρ τ hInt hτ.symm hτm hτ0 hτρ' hnτ
  obtain ⟨b1, b1'⟩ := hresc (ρ * τ₂) τ₂ hInt2 hg2 hτ₂m hτ₂0 (hτ₂τ.trans hτρ') hnτ₂
  rw [← hτ₂sq', ← pow_mul, ← pow_mul] at a1 a1'

  have hane : k2 * qY * g ^ cY * lam₁ ≠ 0 :=
    mul_ne_zero (mul_ne_zero (mul_ne_zero hR.2.1 hqY0) (pow_ne_zero _ hg0)) hl1
  obtain ⟨hpq, hab⟩ := hexp _ _ τ₂ (cZ + k) (cY + n) hane hτ₂0 hτ₂nu b1 b1' a1 a1'

  have hτn : τ ^ n ∣ ls :=
    (pow_dvd_pow τ (by omega)).trans ((hpair ρ τ hτ.symm hτ0 hτρ').2.2.trans hGl)
  have hD'' : (lam₂ ∣ lam₁ ∧ (n ≤ k ∨ ∃ lam' : ↥W, lam₁ = lam₂ * lam' ∧ τ ^ n ∣ lam')) ∨
      ¬ (ℓ : ℤ) ∣ ((k : ℤ) - n) := by
    rcases hD' with ⟨hd, hnk | ⟨lam', hl', hll⟩⟩ | hD'
    · exact Or.inl ⟨hd, Or.inl hnk⟩
    · exact Or.inl ⟨hd, Or.inr ⟨lam', hl', hτn.trans hll⟩⟩
    · exact Or.inr hD'
  have hfin := hgood ρ τ g k1 k2 lam₁ lam₂ qZ qY cZ cY n k hρ0 hτ0 hl2 hτ hpq hab hD''
  obtain ⟨hPZ, hcZ⟩ := hsplit g ρ τ ρ' Z hρ0 hτ.symm hnτ hXZ
  obtain ⟨hPY, hcY⟩ := hsplit g ρ τ ρ' Y hρ0 hτ.symm hnτ hXY
  unfold wcFrmGood wcFrmM
  rw [hPZ, hPY, hcZ, hcY, ← hqZdef, ← hqYdef, ← hcZdef, ← hcYdef]
  exact hfin

theorem wcFrm_end_right : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) → Module.finrank K L = ℓ →
    ∀ (α : L) (f₀ : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α →
    ∀ O : ↥W → ValuationSubring K, wcFrmVAL W A K 𝔭 u g O →
    ∀ a : ↥W, wcFrmInt W g a →
    ∃ ρ' : ↥W, ρ' ∈ IsLocalRing.maximalIdeal ↥W ∧ ρ' ≠ 0 ∧
      wcFrmMem W A K 𝔭 u g ℓ f₀ (fun ρ => a ∣ ρ ∧ ¬ ρ ∣ a ∧ ρ ∣ a * ρ' ∧ ¬ a * ρ' ∣ ρ) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g hPD hdeg α f₀ hα1 hf₀
    O hO a hIa
  classical
  have hΩ : ((ℓ : ℕ) : Ω) = 0 := by
    rw [← hchar]
    exact ringChar.Nat.cast_ringChar
  have hWl : ((ℓ : ℕ) : ↥W) = 0 := by
    apply Subtype.ext
    simpa using hΩ
  have hK : ((ℓ : ℕ) : K) = 0 := by
    have e : ((ℓ : ℕ) : K) = algebraMap A K (algebraMap ↥W A ((ℓ : ℕ) : ↥W)) := by
      rw [map_natCast, map_natCast]
    rw [e, hWl, map_zero, map_zero]
  have hL : ((ℓ : ℕ) : L) = 0 := by
    rw [← map_natCast (algebraMap K L), hK, map_zero]
  have : Fact ℓ.Prime := ⟨hℓ⟩
  have : CharP L ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hL

  have hroot : ∀ g : ↥W, g ∈ IsLocalRing.maximalIdeal ↥W → g ≠ 0 → ∀ N : ℕ,
      ∃ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W ∧ x ≠ 0 ∧ x ^ (N + 1) = g := by
    intro g hgm hg0 N
    obtain ⟨y, hy⟩ := IsAlgClosed.exists_pow_nat_eq (g : Ω) (Nat.succ_pos N)
    have hy0 : y ≠ 0 := by
      rintro rfl
      apply hg0
      apply Subtype.ext
      rw [← hy]
      simp
    have hyW : y ∈ W := by
      rcases W.mem_or_inv_mem y with hh | hh
      · exact hh
      · have e : y = (g : Ω) * (y⁻¹) ^ N := by
          rw [← hy, inv_pow, pow_succ]
          field_simp
        rw [e]
        exact mul_mem g.2 (pow_mem hh N)
    have hxg : (⟨y, hyW⟩ : ↥W) ^ (N + 1) = g := by
      apply Subtype.ext
      simp [hy]
    refine ⟨⟨y, hyW⟩, ?_, ?_, hxg⟩
    · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have := (IsLocalRing.mem_maximalIdeal _).mp hgm
      rw [mem_nonunits_iff] at this
      apply this
      rw [← hxg]
      exact hu.pow _
    · intro h0
      apply hy0
      have := congrArg Subtype.val h0
      simpa using this

  have hexp : ∀ (x y σ : ↥W) (p p' : ℕ), x ≠ 0 → σ ≠ 0 → ¬ IsUnit σ →
      x * σ ^ p ∣ y * σ ^ p' → y * σ ^ p' ∣ x * σ ^ p →
      x * (σ ^ (1 + 1)) ^ p ∣ y * (σ ^ (1 + 1)) ^ p' →
      y * (σ ^ (1 + 1)) ^ p' ∣ x * (σ ^ (1 + 1)) ^ p →
      p = p' ∧ x ∣ y := by
    intro x y σ p p' hx hσ hnu h1a h1b h2a h2b
    have e : ∀ m : ℕ, (σ ^ (1 + 1)) ^ m = σ ^ m * σ ^ m := fun m => by ring
    rw [e, e] at h2a h2b
    have h1 := associated_of_dvd_dvd h1a h1b
    have h2 := associated_of_dvd_dvd h2a h2b
    rw [← mul_assoc, ← mul_assoc] at h2
    have h3 : Associated (σ ^ p) (σ ^ p') :=
      h2.of_mul_left h1 (mul_ne_zero hx (pow_ne_zero _ hσ))
    have hpq : p = p' := le_antisymm ((pow_dvd_pow_iff hσ hnu).mp h3.dvd)
      ((pow_dvd_pow_iff hσ hnu).mp h3.symm.dvd)
    subst hpq
    exact ⟨rfl, (h1.of_mul_right (Associated.refl _) (pow_ne_zero _ hσ)).dvd⟩

  have hgm : g ∈ IsLocalRing.maximalIdeal ↥W := hPD.2.2.2.2.2.1
  have hg0 : g ≠ 0 := hPD.2.2.2.2.2.2.1
  obtain ⟨ham, ha0, ⟨q, hgq⟩, hga⟩ := hIa
  have hq0 : q ≠ 0 := by
    rintro rfl
    exact hg0 (by rw [hgq, mul_zero])
  have hqm : q ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hcon
    have hu : IsUnit q := (IsLocalRing.notMem_maximalIdeal).mp hcon
    exact hga ⟨↑hu.unit⁻¹, by rw [hgq, mul_assoc, hu.mul_val_inv, mul_one]⟩

  obtain ⟨A₃, _, _, _, _, _, _, _, u₃, v₃, 𝔭₃, hBr, hu₃, hv₃, hPD₃, -⟩ :=
    wcpa_dj_llsm_br_inner_chart Ω W hW hWt A K L 𝔭 u v g a q hPD ham ha0 hqm hgq
  obtain ⟨s, hs⟩ : ∃ s : K, s = algebraMap A K u / algebraMap A K (algebraMap ↥W A a) :=
    ⟨_, rfl⟩
  rw [← hs] at hBr hu₃
  obtain ⟨hBr1, hBr2, hBr3⟩ := hBr

  obtain ⟨h, lam₁, lam₂, w, n, k, ε₀, ε₁, r₀, r₁, g₀, g₁, hl1, hl2, hw, hε₀, hε₁, hI, hD⟩ :=
    wcLlsASb_boundary_form Ω W hW hWt ℓ hℓ A₃ K L 𝔭₃ u₃ v₃ q hPD₃ hK α f₀ hα1 hf₀
  have hF0 : f₀ - (h ^ ℓ - h) ≠ 0 := by
    intro h0
    have e1 : f₀ = h ^ ℓ - h := sub_eq_zero.mp h0
    have e2 : (α - algebraMap K L h) ^ ℓ = α - algebraMap K L h := by
      rw [sub_pow_char]
      have := hf₀
      rw [e1, map_sub, map_pow] at this
      linear_combination (-1 : L) * this
    have hbot := (Subfield.mem_bot_iff_pow_eq_self L ℓ).mpr e2
    obtain ⟨x, hx⟩ := RingHom.mem_fieldRange.mp
      ((bot_le : (⊥ : Subfield L) ≤ (algebraMap K L).fieldRange) hbot)
    exact hα1 ⟨x + h, by rw [map_add, hx]; ring⟩
  obtain ⟨k1, k2, Z, Y, d, e, hR⟩ :=
    wcFrm_rep_exists Ω W hW hWt A K 𝔭 u v g hPD (f₀ - (h ^ ℓ - h)) hF0
  have hk1 : k1 ≠ 0 := hR.1
  have hk2 : k2 ≠ 0 := hR.2.1
  obtain ⟨lamS, hlamSm, hD'⟩ : ∃ lamS : ↥W, lamS ∈ IsLocalRing.maximalIdeal ↥W ∧
      ((lam₂ ∣ lam₁ ∧ (n ≤ k ∨ ∃ lam' : ↥W, lam₁ = lam₂ * lam' ∧ lamS ∣ lam')) ∨
        ¬ (ℓ : ℤ) ∣ ((k : ℤ) - n)) := by
    rcases hD with ⟨hdv, hnk | ⟨lam', hl', hl'm⟩⟩ | hnd
    · exact ⟨0, Ideal.zero_mem _, Or.inl ⟨hdv, Or.inl hnk⟩⟩
    · exact ⟨lam', hl'm, Or.inl ⟨hdv, Or.inr ⟨lam', hl', dvd_rfl⟩⟩⟩
    · exact ⟨0, Ideal.zero_mem _, Or.inr hnd⟩

  have hassoc : ∀ τ : ↥W, τ ∈ IsLocalRing.maximalIdeal ↥W → τ ≠ 0 → wcFrmInt W g (a * τ) →
      τ ^ (n + k + 2) ∣ q → τ ^ (n + k + 2) ∣ w →
      k2 * wcFrmP W (a * τ) Y * lam₁ * τ ^ k ∣ k1 * wcFrmP W (a * τ) Z * lam₂ * τ ^ n ∧
        k1 * wcFrmP W (a * τ) Z * lam₂ * τ ^ n ∣ k2 * wcFrmP W (a * τ) Y * lam₁ * τ ^ k := by
    intro τ hτm hτ0 hInt hτq hτw
    obtain ⟨hVI, hVII, hVIV⟩ := hO (a * τ) hInt
    set O' := O (a * τ) with hO'
    have hmemle : ∀ x : K, O'.valuation x ≤ 1 ↔ x ∈ O' :=
      fun x => O'.valuation_le_one_iff x
    have hF0' : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
      intro x hx h0
      have hd := hVII 1 x one_ne_zero hx (by rw [h0, div_zero]; exact O'.zero_mem)
      have hu : IsUnit x := isUnit_of_dvd_one hd
      exact ((hu.map (algebraMap ↥W A)).map (algebraMap A K)).ne_zero h0
    have hvne : ∀ x : ↥W, x ≠ 0 → O'.valuation (algebraMap A K (algebraMap ↥W A x)) ≠ 0 :=
      fun x hx => (O'.valuation.ne_zero_iff).mpr (hF0' x hx)
    have hF1 : ∀ y : A, O'.valuation (algebraMap A K y) ≤ 1 :=
      fun y => (hmemle _).mpr (hVIV y)
    have hF2 : ∀ w₁ w₂ : ↥W, w₁ ≠ 0 → w₂ ≠ 0 →
        O'.valuation (algebraMap A K (algebraMap ↥W A w₁)) ≤
          O'.valuation (algebraMap A K (algebraMap ↥W A w₂)) → w₂ ∣ w₁ := by
      intro w₁ w₂ h1 h2 hle
      apply hVII w₁ w₂ h1 h2
      rw [← hmemle, Valuation.map_div]
      exact (div_le_one₀ (zero_lt_iff.mpr (hvne w₂ h2))).mpr hle
    have hveq : ∀ x y : K, x ≠ 0 → y ≠ 0 → x / y ∈ O' → y / x ∈ O' →
        O'.valuation x = O'.valuation y := by
      intro x y hx hy h1 h2
      rw [← hmemle, Valuation.map_div] at h1 h2
      have hx' : 0 < O'.valuation x := zero_lt_iff.mpr ((O'.valuation.ne_zero_iff).mpr hx)
      have hy' : 0 < O'.valuation y := zero_lt_iff.mpr ((O'.valuation.ne_zero_iff).mpr hy)
      exact le_antisymm ((div_le_one₀ hy').mp h1) ((div_le_one₀ hx').mp h2)
    obtain ⟨r, hr⟩ : ∃ r, O'.valuation (algebraMap A K (algebraMap ↥W A τ)) = r := ⟨_, rfl⟩
    have hr0 : 0 < r := by rw [← hr]; exact zero_lt_iff.mpr (hvne τ hτ0)
    have hr1 : r < 1 := by
      by_contra hcon
      push Not at hcon
      have hd : τ ∣ 1 := hF2 1 τ one_ne_zero hτ0 (by rw [hr]; simpa using hcon)
      have := (IsLocalRing.mem_maximalIdeal _).mp hτm
      rw [mem_nonunits_iff] at this
      exact this (isUnit_of_dvd_one hd)
    have hF4 : ∀ (x : ↥W) (j : ℕ), τ ^ j ∣ x →
        O'.valuation (algebraMap A K (algebraMap ↥W A x)) ≤ r ^ j := by
      intro x j hx
      obtain ⟨y, rfl⟩ := hx
      rw [map_mul, map_mul, map_mul, map_pow, map_pow, map_pow, hr]
      exact mul_le_of_le_one_right (zero_le) (hF1 _)
    have hvm : ∀ x ∈ IsLocalRing.maximalIdeal ↥W,
        O'.valuation (algebraMap A K (algebraMap ↥W A x)) < 1 := by
      intro x hx
      by_cases hx0 : x = 0
      · rw [hx0]; simp
      · by_contra hcon
        push Not at hcon
        have hd : x ∣ 1 := hF2 1 x one_ne_zero hx0 (by simpa using hcon)
        exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hx)) (isUnit_of_dvd_one hd)
    have hPne : ∀ X : List ↥W, wcFrmP W (a * τ) X ≠ 0 := by
      intro X
      unfold wcFrmP
      apply mul_ne_zero
      · apply List.prod_ne_zero
        intro h0
        have := (List.mem_filter.mp h0).2
        exact (by simpa using this : ¬ a * τ ∣ 0) (dvd_zero _)
      · exact pow_ne_zero _ hInt.2.1
    have hrepv : ∀ (G : K) (a1 a2 : ↥W) (Z' Y' : List ↥W) (d' e' : A), G ≠ 0 →
        wcFrmREP W A K 𝔭 u G a1 a2 Z' Y' d' e' →
        O'.valuation (algebraMap A K (algebraMap ↥W A (a2 * wcFrmP W (a * τ) Y'))) *
            O'.valuation G =
          O'.valuation (algebraMap A K (algebraMap ↥W A (a1 * wcFrmP W (a * τ) Z'))) := by
      intro G a1 a2 Z' Y' d' e' hG hrep
      obtain ⟨h1, h2⟩ := hVI G a1 a2 Z' Y' d' e' hG hrep
      have hne1 : algebraMap A K (algebraMap ↥W A (a2 * wcFrmP W (a * τ) Y')) * G ≠ 0 :=
        mul_ne_zero (hF0' _ (mul_ne_zero hrep.2.1 (hPne _))) hG
      have hne2 : algebraMap A K (algebraMap ↥W A (a1 * wcFrmP W (a * τ) Z')) ≠ 0 :=
        hF0' _ (mul_ne_zero hrep.1 (hPne _))
      have := hveq _ _ hne1 hne2 h1 h2
      rwa [Valuation.map_mul] at this
    have h1p : (1 : A) ∉ 𝔭 := (Ideal.ne_top_iff_one 𝔭).mp hPD.2.2.2.1.ne_top
    have hvε : ∀ ε : A, ε ∉ 𝔭 → O'.valuation (algebraMap A K ε) = 1 := by
      intro ε hε
      have hε0 : algebraMap A K ε ≠ 0 := by
        intro h0
        apply hε
        rw [(map_eq_zero_iff _ (IsFractionRing.injective A K)).mp h0]
        exact Ideal.zero_mem _
      have hrep : wcFrmREP W A K 𝔭 u (algebraMap A K ε) 1 1 [] [] 1 ε :=
        ⟨one_ne_zero, one_ne_zero, h1p, hε, by simp⟩
      have := hrepv _ 1 1 [] [] 1 ε hε0 hrep
      simpa [wcFrmP] using this
    have huv' : algebraMap A K u * algebraMap A K v =
        algebraMap A K (algebraMap ↥W A a) * algebraMap A K (algebraMap ↥W A q) := by
      rw [← map_mul, hPD.2.2.2.2.2.2.2.1, hgq, map_mul, map_mul]
    have hu0 : algebraMap A K u ≠ 0 := by
      intro h0
      rw [h0, zero_mul] at huv'
      exact mul_ne_zero (hF0' a ha0) (hF0' q hq0) huv'.symm
    have hvu : O'.valuation (algebraMap A K u) =
        O'.valuation (algebraMap A K (algebraMap ↥W A a)) * r := by
      have hrep : wcFrmREP W A K 𝔭 u (algebraMap A K u) 1 1 [0] [] 1 1 :=
        ⟨one_ne_zero, one_ne_zero, h1p, h1p, by simp⟩
      have := hrepv _ 1 1 [0] [] 1 1 hu0 hrep
      rw [← hr]
      simpa [wcFrmP] using this
    have hsu : algebraMap A K (algebraMap ↥W A a) * s = algebraMap A K u := by
      rw [hs]; exact mul_div_cancel₀ _ (hF0' a ha0)
    have hvs : O'.valuation s = r := by
      have e := congrArg O'.valuation hsu
      rw [Valuation.map_mul, hvu] at e
      exact mul_left_cancel₀ (hvne a ha0) e
    have hvv : O'.valuation (algebraMap A K v) ≤ r ^ (n + k + 1) := by
      have e := congrArg O'.valuation huv'
      rw [Valuation.map_mul, Valuation.map_mul, hvu] at e
      have hle : O'.valuation (algebraMap A K (algebraMap ↥W A a)) * r *
          O'.valuation (algebraMap A K v) ≤
          O'.valuation (algebraMap A K (algebraMap ↥W A a)) * r * r ^ (n + k + 1) := by
        rw [e, mul_assoc, ← pow_succ']
        exact mul_le_mul' le_rfl (hF4 q _ hτq)
      exact le_of_mul_le_mul_left hle (zero_lt_iff.mpr (mul_ne_zero (hvne a ha0) hr0.ne'))

    have hsA : s ∈ Algebra.adjoin A {s} := Algebra.subset_adjoin (Set.mem_singleton s)
    have hsO : s ∈ O' := (hmemle s).mp (by rw [hvs]; exact hr1.le)
    have hadj : ∀ y ∈ Algebra.adjoin A {s}, O'.valuation y ≤ 1 := by
      intro y hy
      rw [hmemle]
      induction hy using Algebra.adjoin_induction with
      | mem x hx => rw [Set.mem_singleton_iff.mp hx]; exact hsO
      | algebraMap x => exact hVIV x
      | add x y _ _ hx hy => exact add_mem hx hy
      | mul x y _ _ hx hy => exact mul_mem hx hy
    have hdec : ∀ y ∈ Algebra.adjoin A {s}, ∃ a₀ : A, ∃ t ∈ Algebra.adjoin A {s},
        y = algebraMap A K a₀ + s * t := by
      intro y hy
      induction hy using Algebra.adjoin_induction with
      | mem x hx => exact ⟨0, 1, one_mem _, by rw [Set.mem_singleton_iff.mp hx]; simp⟩
      | algebraMap x => exact ⟨x, 0, zero_mem _, by simp⟩
      | add x y _ _ ihx ihy =>
        obtain ⟨a₁, t₁, ht₁, e₁⟩ := ihx
        obtain ⟨a₂, t₂, ht₂, e₂⟩ := ihy
        exact ⟨a₁ + a₂, t₁ + t₂, add_mem ht₁ ht₂, by rw [e₁, e₂, map_add]; ring⟩
      | mul x y _ _ ihx ihy =>
        obtain ⟨a₁, t₁, ht₁, e₁⟩ := ihx
        obtain ⟨a₂, t₂, ht₂, e₂⟩ := ihy
        refine ⟨a₁ * a₂, t₁ * algebraMap A K a₂ + algebraMap A K a₁ * t₂ + s * t₁ * t₂,
          add_mem (add_mem (mul_mem ht₁ (Subalgebra.algebraMap_mem _ a₂))
            (mul_mem (Subalgebra.algebraMap_mem _ a₁) ht₂)) (mul_mem (mul_mem hsA ht₁) ht₂), ?_⟩
        rw [e₁, e₂, map_mul]; ring
    have hle : Ideal.span {u, v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤
        (Ideal.span (((↑) : ↥(Algebra.adjoin A {s}) → K) ⁻¹'
          ({s, algebraMap A K v} ∪ (fun w : ↥W => algebraMap A K (algebraMap ↥W A w)) ''
            (IsLocalRing.maximalIdeal ↥W : Set ↥W)))).comap
          (algebraMap A ↥(Algebra.adjoin A {s})) := by
      apply sup_le
      · rw [Ideal.span_le]
        intro x hx
        rw [SetLike.mem_coe, Ideal.mem_comap]
        rcases hx with hx | hx
        · rw [hx]
          have e : algebraMap A ↥(Algebra.adjoin A {s}) u =
              algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A a) * ⟨s, hsA⟩ :=
            Subtype.ext (by
              show algebraMap A K u = algebraMap A K (algebraMap ↥W A a) * s
              rw [hsu])
          rw [e]
          exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Or.inl (Set.mem_insert s _)))
        · rw [Set.mem_singleton_iff.mp hx]
          exact Ideal.subset_span (Or.inl (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap, Ideal.mem_comap]
        exact Ideal.subset_span (Or.inr ⟨x, hx, rfl⟩)
    rw [← hPD.2.2.2.2.2.2.2.2.1] at hle
    have hT4 : ∀ q' : ↥(Algebra.adjoin A {s}), q' ∉ Ideal.span (((↑) : ↥(Algebra.adjoin A {s}) → K) ⁻¹'
          ({s, algebraMap A K v} ∪ (fun w : ↥W => algebraMap A K (algebraMap ↥W A w)) ''
            (IsLocalRing.maximalIdeal ↥W : Set ↥W))) → O'.valuation (q' : K) = 1 := by
      intro q' hq'
      obtain ⟨a₀, t, ht, e⟩ := hdec q' q'.2
      by_cases ha₀ : a₀ ∈ 𝔭
      · exfalso
        apply hq'
        have e' : q' = algebraMap A ↥(Algebra.adjoin A {s}) a₀ + ⟨s, hsA⟩ * ⟨t, ht⟩ :=
          Subtype.ext e
        rw [e']
        exact Ideal.add_mem _ (hle ha₀)
          (Ideal.mul_mem_right _ _ (Ideal.subset_span (Or.inl (Set.mem_insert s _))))
      · rw [e, Valuation.map_add_eq_of_lt_left]
        · exact hvε a₀ ha₀
        · rw [hvε a₀ ha₀, Valuation.map_mul, hvs]
          calc r * O'.valuation t ≤ r * 1 := mul_le_mul' le_rfl (hadj t ht)
            _ = r := mul_one r
            _ < 1 := hr1
    have hT5 : ∀ x : A₃, O'.valuation (algebraMap A₃ K x) ≤ 1 := by
      intro x
      obtain ⟨p, q', hq', hxq⟩ := hBr3 (algebraMap A₃ K x) ⟨x, rfl⟩
      have e := congrArg O'.valuation hxq
      rw [Valuation.map_mul, hT4 q' hq', mul_one] at e
      rw [e]
      exact hadj p p.2
    have hT5m : ∀ x : A₃, algebraMap A₃ K x ∈ O' := fun x => (hmemle _).mp (hT5 x)
    have hmemc : ∀ x : A₃, x ∈ (IsLocalRing.maximalIdeal ↥O').comap
        ((algebraMap A₃ K).codRestrict O' hT5m) ↔ O'.valuation (algebraMap A₃ K x) < 1 := by
      intro x
      rw [Ideal.mem_comap, ValuationSubring.valuation_lt_one_iff]
      rfl
    have hp3le : 𝔭₃ ≤ (IsLocalRing.maximalIdeal ↥O').comap
        ((algebraMap A₃ K).codRestrict O' hT5m) := by
      rw [hPD₃.2.2.2.2.2.2.2.2.1]
      apply sup_le
      · rw [Ideal.span_le]
        intro x hx
        rcases hx with hx | hx
        · rw [hx]; exact (hmemc _).mpr (by rw [hu₃, hvs]; exact hr1)
        · rw [Set.mem_singleton_iff.mp hx]; exact (hmemc _).mpr (by
            rw [hv₃]; exact lt_of_le_of_lt hvv (pow_lt_one₀ zero_le hr1 (by omega)))
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap]
        apply (hmemc _).mpr
        rw [hBr1]
        exact hvm x hx
    have heq3 := Ideal.IsMaximal.eq_of_le hPD₃.2.2.2.1
      (Ideal.comap_ne_top _ (IsLocalRing.maximalIdeal.isMaximal _).ne_top) hp3le
    have hvε₃ : ∀ ε : A₃, ε ∉ 𝔭₃ → O'.valuation (algebraMap A₃ K ε) = 1 := by
      intro ε hε
      rw [heq3, hmemc] at hε
      exact le_antisymm (hT5 ε) (not_lt.mp hε)

    have hbr : ∀ (j : ℕ) (ε r' g' : A₃), j ≤ n + k → ε ∉ 𝔭₃ →
        O'.valuation (algebraMap A₃ K (u₃ ^ j * ε + v₃ * r' + algebraMap ↥W A₃ w * g')) =
          r ^ j := by
      intro j ε r' g' hj hε
      rw [add_assoc, map_add]
      have hfirst : O'.valuation (algebraMap A₃ K (u₃ ^ j * ε)) = r ^ j := by
        rw [map_mul, map_pow, hu₃, Valuation.map_mul, Valuation.map_pow, hvs, hvε₃ ε hε, mul_one]
      have hsecond : O'.valuation (algebraMap A₃ K (v₃ * r' + algebraMap ↥W A₃ w * g')) <
          r ^ j := by
        rw [map_add, map_mul, map_mul, hv₃, hBr1]
        apply Valuation.map_add_lt
        · rw [Valuation.map_mul]
          calc O'.valuation (algebraMap A K v) * O'.valuation (algebraMap A₃ K r')
              ≤ r ^ (n + k + 1) * 1 := mul_le_mul' hvv (hT5 r')
            _ = r ^ (n + k + 1) := mul_one _
            _ < r ^ j := pow_lt_pow_right_of_lt_one₀ hr0 hr1 (by omega)
        · rw [Valuation.map_mul]
          calc O'.valuation (algebraMap A K (algebraMap ↥W A w)) *
                O'.valuation (algebraMap A₃ K g')
              ≤ r ^ (n + k + 2) * 1 := mul_le_mul' (hF4 w _ hτw) (hT5 g')
            _ = r ^ (n + k + 2) := mul_one _
            _ < r ^ j := pow_lt_pow_right_of_lt_one₀ hr0 hr1 (by omega)
      rw [Valuation.map_add_eq_of_lt_left _ (hfirst ▸ hsecond), hfirst]
    have hB1 := hbr n ε₁ r₁ g₁ (by omega) hε₁
    have hB0 := hbr k ε₀ r₀ g₀ (by omega) hε₀
    have hF8 := congrArg O'.valuation hI
    rw [Valuation.map_mul, Valuation.map_mul, Valuation.map_mul, hB1, hB0, hBr1, hBr1] at hF8
    have hRF := hrepv _ k1 k2 Z Y d e hF0 hR
    have hkey : O'.valuation (algebraMap A K (algebraMap ↥W A
          (k2 * wcFrmP W (a * τ) Y * lam₁ * τ ^ k))) =
        O'.valuation (algebraMap A K (algebraMap ↥W A
          (k1 * wcFrmP W (a * τ) Z * lam₂ * τ ^ n))) := by
      simp only [map_mul, map_pow, Valuation.map_mul, Valuation.map_pow, hr] at hRF hF8 ⊢
      generalize O'.valuation (algebraMap A K (algebraMap ↥W A k2)) = X1 at hRF hF8 ⊢
      generalize O'.valuation (algebraMap A K (algebraMap ↥W A (wcFrmP W (a * τ) Y))) = X2
        at hRF hF8 ⊢
      generalize O'.valuation (algebraMap A K (algebraMap ↥W A k1)) = X3 at hRF hF8 ⊢
      generalize O'.valuation (algebraMap A K (algebraMap ↥W A (wcFrmP W (a * τ) Z))) = X4
        at hRF hF8 ⊢
      generalize O'.valuation (algebraMap A K (algebraMap ↥W A lam₁)) = L1 at hRF hF8 ⊢
      generalize O'.valuation (algebraMap A K (algebraMap ↥W A lam₂)) = L2 at hRF hF8 ⊢
      generalize O'.valuation (f₀ - (h ^ ℓ - h)) = VF at hRF hF8 ⊢
      calc X1 * X2 * L1 * r ^ k = X1 * X2 * (L1 * r ^ k) := by rw [mul_assoc]
        _ = X1 * X2 * (VF * r ^ n * L2) := by rw [← hF8]
        _ = (X1 * X2 * VF) * (r ^ n * L2) := by ac_rfl
        _ = X3 * X4 * (r ^ n * L2) := by rw [hRF]
        _ = X3 * X4 * L2 * r ^ n := by ac_rfl
    have hne1 : k2 * wcFrmP W (a * τ) Y * lam₁ * τ ^ k ≠ 0 :=
      mul_ne_zero (mul_ne_zero (mul_ne_zero hk2 (hPne Y)) hl1) (pow_ne_zero _ hτ0)
    have hne2 : k1 * wcFrmP W (a * τ) Z * lam₂ * τ ^ n ≠ 0 :=
      mul_ne_zero (mul_ne_zero (mul_ne_zero hk1 (hPne Z)) hl2) (pow_ne_zero _ hτ0)
    exact ⟨hF2 _ _ hne2 hne1 hkey.symm.le, hF2 _ _ hne1 hne2 hkey.le⟩

  have habs : ∀ G s' : ↥W, G ∈ IsLocalRing.maximalIdeal ↥W → G ≠ 0 →
      s' ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ G' : ↥W, G' ∈ IsLocalRing.maximalIdeal ↥W ∧ G' ≠ 0 ∧ G' ∣ G ∧ G' ∣ s' := by
    intro G s' hG hG0 hs'
    by_cases hs0 : s' = 0
    · exact ⟨G, hG, hG0, dvd_rfl, by rw [hs0]; exact dvd_zero G⟩
    rcases ValuationRing.dvd_total G s' with h1 | h1
    · exact ⟨G, hG, hG0, dvd_rfl, h1⟩
    · exact ⟨s', hs', hs0, h1, dvd_rfl⟩
  obtain ⟨G₁, hG₁m, hG₁0, hG₁q, hG₁w⟩ := habs q w hqm hq0 hw
  obtain ⟨G₂, hG₂m, hG₂0, hG₂1, hG₂l⟩ := habs G₁ lamS hG₁m hG₁0 hlamSm
  have hwinX : ∀ X : List ↥W, ∃ G : ↥W, G ∈ IsLocalRing.maximalIdeal ↥W ∧ G ≠ 0 ∧ G ∣ G₂ ∧
      ∀ z ∈ X, z ∣ a ∨ a * G ∣ z := by
    intro X
    induction X with
    | nil => exact ⟨G₂, hG₂m, hG₂0, dvd_rfl, by simp⟩
    | cons z X ih =>
      obtain ⟨G, hGm, hG0, hGG, hGX⟩ := ih
      by_cases hza : z ∣ a
      · refine ⟨G, hGm, hG0, hGG, fun z' hz' => ?_⟩
        rcases List.mem_cons.mp hz' with hh | hh
        · left; rw [hh]; exact hza
        · exact hGX z' hh
      · obtain ⟨μ, hμ⟩ := (ValuationRing.dvd_total a z).resolve_right hza
        have hμm : μ ∈ IsLocalRing.maximalIdeal ↥W := by
          by_contra hcon
          have hu : IsUnit μ := (IsLocalRing.notMem_maximalIdeal).mp hcon
          exact hza ⟨↑hu.unit⁻¹, by rw [hμ, mul_assoc, hu.mul_val_inv, mul_one]⟩
        obtain ⟨G', hG'm, hG'0, hG'G, hG'μ⟩ := habs G μ hGm hG0 hμm
        refine ⟨G', hG'm, hG'0, hG'G.trans hGG, fun z' hz' => ?_⟩
        rcases List.mem_cons.mp hz' with hh | hh
        · right; rw [hh, hμ]; exact mul_dvd_mul_left a hG'μ
        · rcases hGX z' hh with h1 | h1
          · left; exact h1
          · right; exact (mul_dvd_mul_left a hG'G).trans h1
  obtain ⟨G, hGm, hG0, hGG₂, hGX⟩ := hwinX (Z ++ Y)
  obtain ⟨ρ', hρ'm, hρ'0, hρ'G⟩ := hroot G hGm hG0 (n + k + 1)
  rw [show n + k + 1 + 1 = n + k + 2 from rfl] at hρ'G
  have hwin : ∀ z ∈ Z ++ Y, z ∣ a ∨ a * ρ' ∣ z := fun z hz =>
    (hGX z hz).imp id (fun hh => (mul_dvd_mul_left a
      (by rw [← hρ'G]; exact dvd_pow_self ρ' (by omega))).trans hh)
  have hdivτ : ∀ τ : ↥W, τ ∣ ρ' →
      τ ^ (n + k + 2) ∣ q ∧ τ ^ (n + k + 2) ∣ w ∧ τ ^ (n + k + 2) ∣ lamS := by
    intro τ hτ
    have h1 : τ ^ (n + k + 2) ∣ G := hρ'G ▸ pow_dvd_pow_of_dvd hτ _
    have h2 := h1.trans hGG₂
    exact ⟨h2.trans (hG₂1.trans hG₁q), h2.trans (hG₂1.trans hG₁w), h2.trans hG₂l⟩

  have hshape : ∀ τ : ↥W, ¬ IsUnit τ → τ ∣ ρ' → ∀ X : List ↥W, (∀ x ∈ X, x ∈ Z ++ Y) →
      wcFrmP W (a * τ) X =
        (X.filter (fun x => @decide (x ∣ a) (Classical.propDecidable _))).prod *
          (a * τ) ^ (X.filter (fun x => @decide (¬ x ∣ a) (Classical.propDecidable _))).length ∧
      (X.filter (fun x => @decide (a * τ ∣ x) (Classical.propDecidable _))).length =
        (X.filter (fun x => @decide (¬ x ∣ a) (Classical.propDecidable _))).length := by
    intro τ hτ hτρ X hX
    have key : ∀ x ∈ X, (a * τ ∣ x ↔ ¬ x ∣ a) := by
      intro x hx
      constructor
      · rintro ⟨c, hc⟩ ⟨d', hd'⟩
        apply hτ
        have e3 : a * (τ * (c * d')) = a * 1 := by
          rw [mul_one]
          calc a * (τ * (c * d')) = (a * τ * c) * d' := by ring
            _ = a := by rw [← hc, ← hd']
        exact IsUnit.of_mul_eq_one (b := c * d') (mul_left_cancel₀ ha0 e3)
      · intro hxa
        rcases hwin x (hX x hx) with h1 | h1
        · exact absurd h1 hxa
        · exact (mul_dvd_mul_left a hτρ).trans h1
    have f1 : X.filter (fun x => @decide (¬ a * τ ∣ x) (Classical.propDecidable _)) =
        X.filter (fun x => @decide (x ∣ a) (Classical.propDecidable _)) :=
      List.filter_congr (fun x hx => decide_eq_decide.mpr (by rw [key x hx, not_not]))
    have f2 : X.filter (fun x => @decide (a * τ ∣ x) (Classical.propDecidable _)) =
        X.filter (fun x => @decide (¬ x ∣ a) (Classical.propDecidable _)) :=
      List.filter_congr (fun x hx => decide_eq_decide.mpr (key x hx))
    refine ⟨?_, by rw [f2]⟩
    unfold wcFrmP
    rw [f1, f2]
  have hprod : ∀ X : List ↥W,
      (X.filter (fun x => @decide (x ∣ a) (Classical.propDecidable _))).prod ≠ 0 := by
    intro X
    apply List.prod_ne_zero
    intro h0
    have := (List.mem_filter.mp h0).2
    exact ha0 (by simpa using this)

  refine ⟨ρ', hρ'm, hρ'0, h, k1, k2, Z, Y, d, e, hR, ?_⟩
  intro ρ hIρ hIρ' _
  obtain ⟨⟨σ, rfl⟩, hρa, hρρ', _⟩ := hIρ'
  have hσρ' : σ ∣ ρ' := (mul_dvd_mul_iff_left ha0).mp hρρ'
  have hσ0 : σ ≠ 0 := by
    rintro rfl
    exact hIρ.2.1 (mul_zero a)
  have hσnu : ¬ IsUnit σ := fun hu =>
    hρa ⟨↑hu.unit⁻¹, by rw [mul_assoc, hu.mul_val_inv, mul_one]⟩
  have hσm : σ ∈ IsLocalRing.maximalIdeal ↥W :=
    (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hσnu)
  obtain ⟨σ', hσ'm, hσ'0, hsq⟩ := hroot σ hσm hσ0 1
  have hσ'nu : ¬ IsUnit σ' := mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hσ'm)
  have hIσ' : wcFrmInt W g (a * σ') := ⟨Ideal.mul_mem_left _ a hσ'm, mul_ne_zero ha0 hσ'0,
      (mul_dvd_mul_left a ⟨σ', by rw [← hsq]; ring⟩).trans hIρ.2.2.1,
      fun hgd => hIρ.2.2.2 (hgd.trans ⟨σ', by rw [← hsq]; ring⟩)⟩
  subst hsq
  have hσ'ρ' : σ' ∣ ρ' := (dvd_pow_self σ' (by norm_num)).trans hσρ'
  obtain ⟨hq1, hw1, hlS1⟩ := hdivτ _ hσρ'
  obtain ⟨hq2, hw2, -⟩ := hdivτ σ' hσ'ρ'
  have A1 := hassoc _ hσm hσ0 hIρ hq1 hw1
  have A2 := hassoc σ' hσ'm hσ'0 hIσ' hq2 hw2
  obtain ⟨hPZ1, hLZ1⟩ := hshape _ hσnu hσρ' Z (fun x hx => List.mem_append_left _ hx)
  obtain ⟨hPY1, hLY1⟩ := hshape _ hσnu hσρ' Y (fun x hx => List.mem_append_right _ hx)
  obtain ⟨hPZ2, -⟩ := hshape σ' hσ'nu hσ'ρ' Z (fun x hx => List.mem_append_left _ hx)
  obtain ⟨hPY2, -⟩ := hshape σ' hσ'nu hσ'ρ' Y (fun x hx => List.mem_append_right _ hx)
  rw [hPZ1, hPY1] at A1
  rw [hPZ2, hPY2] at A2
  have hCY := hprod Y
  unfold wcFrmGood wcFrmM
  rw [hPZ1, hPY1, hLZ1, hLY1]
  generalize (Z.filter (fun x => @decide (x ∣ a) (Classical.propDecidable _))).prod = CZ
    at A1 A2 ⊢
  generalize (Y.filter (fun x => @decide (x ∣ a) (Classical.propDecidable _))).prod = CY
    at A1 A2 hCY ⊢
  generalize (Z.filter (fun x => @decide (¬ x ∣ a) (Classical.propDecidable _))).length = nZ
    at A1 A2 ⊢
  generalize (Y.filter (fun x => @decide (¬ x ∣ a) (Classical.propDecidable _))).length = nY
    at A1 A2 ⊢
  have e1 : ∀ τ : ↥W, k2 * (CY * (a * τ) ^ nY) * lam₁ * τ ^ k =
      (k2 * CY * lam₁ * a ^ nY) * τ ^ (nY + k) := fun τ => by ring
  have e2 : ∀ τ : ↥W, k1 * (CZ * (a * τ) ^ nZ) * lam₂ * τ ^ n =
      (k1 * CZ * lam₂ * a ^ nZ) * τ ^ (nZ + n) := fun τ => by ring
  rw [e1, e2] at A1 A2
  have hx0 : k2 * CY * lam₁ * a ^ nY ≠ 0 :=
    mul_ne_zero (mul_ne_zero (mul_ne_zero hk2 hCY) hl1) (pow_ne_zero _ ha0)
  obtain ⟨hpq, hab⟩ := hexp _ _ σ' (nY + k) (nZ + n) hx0 hσ'0 hσ'nu A2.1 A2.2 A1.1 A1.2
  generalize σ' ^ (1 + 1) = σ at hlS1 ⊢
  have hcast : ((nZ : ℕ) : ℤ) - ((nY : ℕ) : ℤ) = (k : ℤ) - n := by omega
  rw [hcast]
  rcases hD' with ⟨⟨μ, hμ⟩, hnk | ⟨lam', hl', hlS⟩⟩ | hnd
  · left
    rw [hμ] at hab
    have hstar : k2 * CY * μ * a ^ nY ∣ k1 * CZ * a ^ nZ := by
      have : lam₂ * (k2 * CY * μ * a ^ nY) ∣ lam₂ * (k1 * CZ * a ^ nZ) := by
        have e3 : lam₂ * (k2 * CY * μ * a ^ nY) = k2 * CY * (lam₂ * μ) * a ^ nY := by ring
        have e4 : lam₂ * (k1 * CZ * a ^ nZ) = k1 * CZ * lam₂ * a ^ nZ := by ring
        rw [e3, e4]; exact hab
      exact (mul_dvd_mul_iff_left hl2).mp this
    calc k2 * (CY * (a * σ) ^ nY) = (k2 * CY * a ^ nY) * σ ^ nY := by ring
      _ ∣ (k2 * CY * μ * a ^ nY) * σ ^ nY := mul_dvd_mul_right ⟨μ, by ring⟩ _
      _ ∣ (k1 * CZ * a ^ nZ) * σ ^ nY := mul_dvd_mul_right hstar _
      _ ∣ (k1 * CZ * a ^ nZ) * σ ^ nZ := mul_dvd_mul_left _ (pow_dvd_pow σ (by omega))
      _ = k1 * (CZ * (a * σ) ^ nZ) := by ring
  · left
    have hμ' : μ = lam' := mul_left_cancel₀ hl2 (hμ.symm.trans hl')
    rw [hμ, hμ'] at hab
    have hstar : k2 * CY * lam' * a ^ nY ∣ k1 * CZ * a ^ nZ := by
      have : lam₂ * (k2 * CY * lam' * a ^ nY) ∣ lam₂ * (k1 * CZ * a ^ nZ) := by
        have e3 : lam₂ * (k2 * CY * lam' * a ^ nY) = k2 * CY * (lam₂ * lam') * a ^ nY := by ring
        have e4 : lam₂ * (k1 * CZ * a ^ nZ) = k1 * CZ * lam₂ * a ^ nZ := by ring
        rw [e3, e4]; exact hab
      exact (mul_dvd_mul_iff_left hl2).mp this
    have hσn : σ ^ n ∣ lam' :=
      (pow_dvd_pow σ (by omega : n ≤ n + k + 2)).trans (hlS1.trans hlS)
    calc k2 * (CY * (a * σ) ^ nY) = (k2 * CY * a ^ nY) * σ ^ nY := by ring
      _ ∣ (k2 * CY * a ^ nY) * (σ ^ n * σ ^ nZ) :=
          mul_dvd_mul_left _ (by rw [← pow_add]; exact pow_dvd_pow σ (by omega))
      _ ∣ (k2 * CY * a ^ nY) * (lam' * σ ^ nZ) := mul_dvd_mul_left _ (mul_dvd_mul_right hσn _)
      _ = (k2 * CY * lam' * a ^ nY) * σ ^ nZ := by ring
      _ ∣ (k1 * CZ * a ^ nZ) * σ ^ nZ := mul_dvd_mul_right hstar _
      _ = k1 * (CZ * (a * σ) ^ nZ) := by ring
  · right
    exact hnd

theorem wcFrm_end_left : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) → Module.finrank K L = ℓ →
    ∀ (α : L) (f₀ : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α →
    ∀ O : ↥W → ValuationSubring K, wcFrmVAL W A K 𝔭 u g O →
    ∀ a : ↥W, wcFrmInt W g a →
    ∃ ρ' : ↥W, ρ' ∈ IsLocalRing.maximalIdeal ↥W ∧ ρ' ≠ 0 ∧
      wcFrmMem W A K 𝔭 u g ℓ f₀ (fun ρ => ρ ∣ a ∧ ¬ a ∣ ρ ∧ a ∣ ρ * ρ' ∧ ¬ ρ * ρ' ∣ a) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g hPD hdeg α f₀ hα1 hf₀
    O hO a haI
  classical

  have hΩ : ((ℓ : ℕ) : Ω) = 0 := by
    rw [← hchar]
    exact ringChar.Nat.cast_ringChar
  have hWl : ((ℓ : ℕ) : ↥W) = 0 := by
    apply Subtype.ext
    simpa using hΩ
  have hK : ((ℓ : ℕ) : K) = 0 := by
    have e : ((ℓ : ℕ) : K) = algebraMap A K (algebraMap ↥W A ((ℓ : ℕ) : ↥W)) := by
      rw [map_natCast, map_natCast]
    rw [e, hWl, map_zero, map_zero]
  have hL : ((ℓ : ℕ) : L) = 0 := by
    rw [← map_natCast (algebraMap K L), hK, map_zero]
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : CharP L ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hL
  have hgm : g ∈ IsLocalRing.maximalIdeal ↥W := hPD.2.2.2.2.2.1
  have hg0 : g ≠ 0 := hPD.2.2.2.2.2.2.1
  have huv : u * v = algebraMap ↥W A g := hPD.2.2.2.2.2.2.2.1
  have h1p : (1 : A) ∉ 𝔭 := (Ideal.ne_top_iff_one 𝔭).mp hPD.2.2.2.1.ne_top
  have ⟨ham, ha0, hag, hga⟩ := haI

  have hroot : ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → x ≠ 0 → ∀ N : ℕ,
      ∃ y : ↥W, y ∈ IsLocalRing.maximalIdeal ↥W ∧ y ≠ 0 ∧ y ^ (N + 1) = x := by
    intro x hxm hx0 N
    obtain ⟨y, hy⟩ := IsAlgClosed.exists_pow_nat_eq (x : Ω) (Nat.succ_pos N)
    have hy0 : y ≠ 0 := by
      rintro rfl
      apply hx0
      apply Subtype.ext
      rw [← hy]
      simp
    have hyW : y ∈ W := by
      rcases W.mem_or_inv_mem y with h' | h'
      · exact h'
      · have e : y = (x : Ω) * (y⁻¹) ^ N := by
          rw [← hy, inv_pow, pow_succ]
          field_simp
        rw [e]
        exact mul_mem x.2 (pow_mem h' N)
    have hxg : (⟨y, hyW⟩ : ↥W) ^ (N + 1) = x := by
      apply Subtype.ext
      simp [hy]
    refine ⟨⟨y, hyW⟩, ?_, ?_, hxg⟩
    · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have := (IsLocalRing.mem_maximalIdeal _).mp hxm
      rw [mem_nonunits_iff] at this
      apply this
      rw [← hxg]
      exact hu.pow _
    · intro h0
      apply hy0
      have := congrArg Subtype.val h0
      simpa using this

  have hcommon : ∀ S : List ↥W, (∀ s ∈ S, s ∈ IsLocalRing.maximalIdeal ↥W) →
      ∃ G : ↥W, G ∈ IsLocalRing.maximalIdeal ↥W ∧ G ≠ 0 ∧ ∀ s ∈ S, G ∣ s := by
    intro S
    induction S with
    | nil => intro _; exact ⟨g, hgm, hg0, by simp⟩
    | cons s S ih =>
      intro hS
      obtain ⟨G, hGm, hG0, hGS⟩ := ih (fun x hx => hS x (List.mem_cons_of_mem _ hx))
      by_cases hs0 : s = 0
      · refine ⟨G, hGm, hG0, ?_⟩
        intro x hx
        rcases List.mem_cons.mp hx with h' | hx
        · rw [h', hs0]; exact dvd_zero _
        · exact hGS x hx
      · rcases ValuationRing.dvd_total G s with hgs | hsg
        · refine ⟨G, hGm, hG0, ?_⟩
          intro x hx
          rcases List.mem_cons.mp hx with h' | hx
          · rw [h']; exact hgs
          · exact hGS x hx
        · refine ⟨s, hS s (by simp), hs0, ?_⟩
          intro x hx
          rcases List.mem_cons.mp hx with h' | hx
          · rw [h']
          · exact hsg.trans (hGS x hx)

  have hexp2 : ∀ (A0 B0 σ : ↥W) (p q p' q' : ℕ), A0 ≠ 0 → σ ≠ 0 → ¬ IsUnit σ →
      Associated (A0 * σ ^ p) (B0 * σ ^ q) → Associated (A0 * σ ^ p') (B0 * σ ^ q') →
      p + q' = p' + q := by
    intro A0 B0 σ p q p' q' hA hσ hnu h1 h2
    have h3 : Associated (A0 * σ ^ p * σ ^ q') (A0 * σ ^ p' * σ ^ q) := by
      have e1 : B0 * σ ^ q' * σ ^ q = B0 * σ ^ q * σ ^ q' := by ring
      have h4 := h2.mul_right (σ ^ q)
      rw [e1] at h4
      exact (h1.mul_right (σ ^ q')).trans h4.symm
    rw [mul_assoc, mul_assoc, ← pow_add, ← pow_add] at h3
    have h5 := h3.of_mul_left (Associated.refl A0) hA
    exact le_antisymm ((pow_dvd_pow_iff hσ hnu).mp h5.dvd)
      ((pow_dvd_pow_iff hσ hnu).mp h5.symm.dvd)

  have hne : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
    intro x hx h0
    obtain ⟨_, hVII, _⟩ := hO a haI
    have hd := hVII 1 x one_ne_zero hx (by rw [h0, div_zero]; exact (O a).zero_mem)
    have hu : IsUnit x := isUnit_of_dvd_one hd
    exact ((hu.map (algebraMap ↥W A)).map (algebraMap A K)).ne_zero h0
  have hu0 : algebraMap A K u ≠ 0 := by
    have huv' : algebraMap A K u * algebraMap A K v = algebraMap A K (algebraMap ↥W A g) := by
      rw [← map_mul, huv]
    exact left_ne_zero_of_mul (by rw [huv']; exact hne g hg0)

  obtain ⟨b, hb⟩ := hag
  have hb0 : b ≠ 0 := by
    rintro rfl
    exact hg0 (by rw [hb, mul_zero])
  have hbm : b ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    apply hga
    rw [hb]
    exact hu.mul_right_dvd.mpr dvd_rfl
  have hg' : g = b * a := by rw [hb, mul_comm]

  have hPD' := wcpa_dj_llsm_kpwic_pd_swap W A 𝔭 u v g hPD
  obtain ⟨A₃, _, _, _, _, _, _, _, u₃, v₃, 𝔭₃, hBr, hu3, hv3, hPD3, -⟩ :=
    wcpa_dj_llsm_br_inner_chart Ω W hW hWt A K L 𝔭 v u g b a hPD' hbm hb0 ham hg'

  obtain ⟨h, lam₁, lam₂, w, n, k, ε₀, ε₁, r₀, r₁, g₀, g₁, hl1, hl2, hw, hε₀, hε₁, hI, hD⟩ :=
    wcLlsASb_boundary_form Ω W hW hWt ℓ hℓ A₃ K L 𝔭₃ u₃ v₃ a hPD3 hK α f₀ hα1 hf₀
  set s : K := algebraMap A K v / algebraMap A K (algebraMap ↥W A b) with hs_def
  unfold wcLlsBrSub at hBr
  obtain ⟨hBr1, hBr2, hBr3⟩ := hBr
  have h1p₃ : (1 : A₃) ∉ 𝔭₃ := (Ideal.ne_top_iff_one 𝔭₃).mp hPD3.2.2.2.1.ne_top
  have hP3 := hPD3.2.2.2.2.2.2.2.2.1
  have hu3m : u₃ ∈ 𝔭₃ := by
    rw [hP3]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hv3m : v₃ ∈ 𝔭₃ := by
    rw [hP3]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
  have hmapp : ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → algebraMap ↥W A₃ x ∈ 𝔭₃ :=
    fun x hx => hPD3.2.2.2.2.1 (Ideal.mem_map_of_mem _ hx)
  have hφv : algebraMap A K v = s * algebraMap A K (algebraMap ↥W A b) := by
    rw [hs_def, div_mul_cancel₀ _ (hne b hb0)]
  have hsu : s * algebraMap A K u = algebraMap A K (algebraMap ↥W A a) := by
    apply mul_right_cancel₀ (hne b hb0)
    rw [mul_right_comm, ← hφv, ← map_mul, mul_comm v u, huv, hg']
    simp only [map_mul]
    ring
  have hsR : s ∈ Algebra.adjoin A {s} := Algebra.subset_adjoin (Set.mem_singleton s)
  set I : Ideal ↥(Algebra.adjoin A {s}) := Ideal.span (Subtype.val ⁻¹' ({s, algebraMap A K u} ∪
    (fun x' : ↥W => algebraMap A K (algebraMap ↥W A x')) '' ↑(IsLocalRing.maximalIdeal ↥W)))
    with hIdef
  have hsI : (⟨s, hsR⟩ : ↥(Algebra.adjoin A {s})) ∈ I :=
    Ideal.subset_span (Or.inl (Or.inl rfl))
  have huI : algebraMap A ↥(Algebra.adjoin A {s}) u ∈ I :=
    Ideal.subset_span (Or.inl (Or.inr rfl))
  have hwI : ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W →
      algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A x) ∈ I :=
    fun x hx => Ideal.subset_span (Or.inr ⟨x, hx, rfl⟩)
  have hpI : ∀ c ∈ 𝔭, algebraMap A ↥(Algebra.adjoin A {s}) c ∈ I := by
    have hP := hPD.2.2.2.2.2.2.2.2.1
    have hle : 𝔭 ≤ I.comap (algebraMap A ↥(Algebra.adjoin A {s})) := by
      rw [hP]
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro x hx
        rcases hx with hx | hx
        · rw [hx]
          show algebraMap A ↥(Algebra.adjoin A {s}) u ∈ I
          exact huI
        · rw [Set.mem_singleton_iff] at hx
          rw [hx]
          show algebraMap A ↥(Algebra.adjoin A {s}) v ∈ I
          have hev : algebraMap A ↥(Algebra.adjoin A {s}) v =
              ⟨s, hsR⟩ * algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A b) :=
            Subtype.ext hφv
          rw [hev]
          exact Ideal.mul_mem_right _ _ hsI
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        exact hwI x hx
    exact fun c hc => hle hc
  have hdec : ∀ y ∈ Algebra.adjoin A {s}, ∃ y₁ ∈ Algebra.adjoin A {s}, ∃ a₀ : A,
      y = s * y₁ + algebraMap A K a₀ := by
    intro y hy
    induction hy using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      exact ⟨1, one_mem _, 0, by rw [hx, map_zero]; ring⟩
    | algebraMap r => exact ⟨0, zero_mem _, r, by ring⟩
    | add x y _ _ ihx ihy =>
      obtain ⟨x1, hx1, a1, rfl⟩ := ihx
      obtain ⟨y1, hy1, b1, rfl⟩ := ihy
      exact ⟨x1 + y1, add_mem hx1 hy1, a1 + b1, by rw [map_add]; ring⟩
    | mul x y _ _ ihx ihy =>
      obtain ⟨x1, hx1, a1, rfl⟩ := ihx
      obtain ⟨y1, hy1, b1, rfl⟩ := ihy
      refine ⟨s * x1 * y1 + x1 * algebraMap A K b1 + algebraMap A K a1 * y1, ?_, a1 * b1,
        by rw [map_mul]; ring⟩
      exact add_mem (add_mem (mul_mem (mul_mem hsR hx1) hy1)
        (mul_mem hx1 (Subalgebra.algebraMap_mem _ _))) (mul_mem (Subalgebra.algebraMap_mem _ _) hy1)
  have hdecI : ∀ y : ↥(Algebra.adjoin A {s}), y ∉ I → ∃ y₁ ∈ Algebra.adjoin A {s}, ∃ a₀ : A,
      a₀ ∉ 𝔭 ∧ (y : K) = s * y₁ + algebraMap A K a₀ := by
    intro y hyI
    obtain ⟨y1, hy1, a0, hya⟩ := hdec y y.2
    refine ⟨y1, hy1, a0, ?_, hya⟩
    intro ha0'
    apply hyI
    have : y = ⟨s, hsR⟩ * ⟨y1, hy1⟩ + algebraMap A ↥(Algebra.adjoin A {s}) a0 := Subtype.ext hya
    rw [this]
    exact add_mem (Ideal.mul_mem_right _ _ hsI) (hpI a0 ha0')
  have hIJ : ∀ y ∈ I, ∃ c ∈ 𝔭₃, algebraMap A₃ K c = (y : K) := by
    intro y hy
    induction hy using Submodule.span_induction with
    | mem x hx =>
      rcases hx with (hx | hx) | ⟨w', hw', hx⟩
      · exact ⟨u₃, hu3m, by rw [hu3]; exact hx.symm⟩
      · exact ⟨v₃, hv3m, by rw [hv3]; exact (Set.mem_singleton_iff.mp hx).symm⟩
      · exact ⟨algebraMap ↥W A₃ w', hmapp w' hw', by rw [hBr1]; exact hx⟩
    | zero => exact ⟨0, zero_mem _, by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨c, hc, hcx⟩ := hx
      obtain ⟨c', hc', hcy⟩ := hy
      exact ⟨c + c', add_mem hc hc', by rw [map_add, hcx, hcy]; rfl⟩
    | smul r x _ hx =>
      obtain ⟨c, hc, hcx⟩ := hx
      obtain ⟨r'', hr''⟩ := hBr2 r.2
      exact ⟨r'' * c, Ideal.mul_mem_left _ _ hc, by rw [map_mul, hr'', hcx]; rfl⟩
  have hnotJ : ∀ y : ↥(Algebra.adjoin A {s}), y ∉ I → ∀ c ∈ 𝔭₃,
      algebraMap A₃ K c ≠ (y : K) := by
    intro y hyI c hc hcy
    obtain ⟨y1, hy1, a0, ha0', hya⟩ := hdecI y hyI
    obtain ⟨r, i, hi, hri⟩ := hPD.2.2.2.1.exists_inv ha0'
    obtain ⟨bi, hbi, hbi'⟩ := hIJ _ (hpI i hi)
    have hbi2 : algebraMap A₃ K bi = algebraMap A K i := hbi'
    obtain ⟨y1'', hy1''⟩ := hBr2 hy1
    obtain ⟨r'', hr''⟩ := hBr2 (Subalgebra.algebraMap_mem (Algebra.adjoin A {s}) r)
    have hr2 : algebraMap A₃ K r'' = algebraMap A K r := hr''
    have h1 : algebraMap A K (r * a0 + i) = 1 := by rw [hri, map_one]
    rw [map_add, map_mul] at h1
    have key : algebraMap A₃ K (r'' * (c - u₃ * y1'') + bi) = algebraMap A₃ K 1 := by
      rw [map_add, map_mul, map_sub, map_mul, hr2, hcy, hu3, hy1'', hbi2, hya, map_one]
      linear_combination h1
    have h2 : r'' * (c - u₃ * y1'') + bi = 1 := IsFractionRing.injective A₃ K key
    apply h1p₃
    rw [← h2]
    exact add_mem (Ideal.mul_mem_left _ _ (sub_mem hc (Ideal.mul_mem_right _ _ hu3m))) hbi

  have hF0 : f₀ - (h ^ ℓ - h) ≠ 0 := by
    intro h0
    have e1 : f₀ = h ^ ℓ - h := sub_eq_zero.mp h0
    have e2 : (α - algebraMap K L h) ^ ℓ = α - algebraMap K L h := by
      rw [sub_pow_char]
      have := hf₀
      rw [e1, map_sub, map_pow] at this
      linear_combination (-1 : L) * this
    have hbot := (Subfield.mem_bot_iff_pow_eq_self L ℓ).mpr e2
    obtain ⟨x, hx⟩ := RingHom.mem_fieldRange.mp
      ((bot_le : (⊥ : Subfield L) ≤ (algebraMap K L).fieldRange) hbot)
    exact hα1 ⟨x + h, by rw [map_add, hx]; ring⟩
  obtain ⟨k1, k2, Z, Y, d, e, hR⟩ :=
    wcFrm_rep_exists Ω W hW hWt A K 𝔭 u v g hPD (f₀ - (h ^ ℓ - h)) hF0
  have hk1 : k1 ≠ 0 := hR.1
  have hk2 : k2 ≠ 0 := hR.2.1

  obtain ⟨lamS, hlamSm, hD'⟩ : ∃ lamS : ↥W, lamS ∈ IsLocalRing.maximalIdeal ↥W ∧
      ((lam₂ ∣ lam₁ ∧ (n ≤ k ∨ ∃ lam' : ↥W, lam₁ = lam₂ * lam' ∧ lamS ∣ lam')) ∨
        ¬ (ℓ : ℤ) ∣ ((k : ℤ) - n)) := by
    rcases hD with ⟨hdv, hnk | ⟨lam', hl', hl'm⟩⟩ | hnd
    · exact ⟨0, Ideal.zero_mem _, Or.inl ⟨hdv, Or.inl hnk⟩⟩
    · exact ⟨lam', hl'm, Or.inl ⟨hdv, Or.inr ⟨lam', hl', dvd_rfl⟩⟩⟩
    · exact ⟨0, Ideal.zero_mem _, Or.inr hnd⟩

  have hμ : ∀ z : ↥W, ∃ μ : ↥W, μ ∈ IsLocalRing.maximalIdeal ↥W ∧ (¬ a ∣ z → a = z * μ) := by
    intro z
    by_cases hz : a ∣ z
    · exact ⟨0, Ideal.zero_mem _, fun h' => absurd hz h'⟩
    · obtain ⟨μ, hμ⟩ := (ValuationRing.dvd_total z a).resolve_right hz
      refine ⟨μ, ?_, fun _ => hμ⟩
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      apply hz
      rw [hμ]
      exact hu.mul_right_dvd.mpr dvd_rfl
  choose μ hμm hμe using hμ

  have hSm : ∀ x ∈ a :: w :: lamS :: (Z ++ Y).map μ, x ∈ IsLocalRing.maximalIdeal ↥W := by
    intro x hx
    rcases List.mem_cons.mp hx with h1 | hx
    · rw [h1]; exact ham
    rcases List.mem_cons.mp hx with h1 | hx
    · rw [h1]; exact hw
    rcases List.mem_cons.mp hx with h1 | hx
    · rw [h1]; exact hlamSm
    obtain ⟨z, _, rfl⟩ := List.mem_map.mp hx
    exact hμm z
  obtain ⟨G, hGm, hG0, hGS⟩ := hcommon _ hSm
  obtain ⟨ρ', hρ'm, hρ'0, hρ'G⟩ := hroot G hGm hG0 (n + k + 1)
  have hdivs : ∀ θ : ↥W, θ ∣ ρ' → θ ^ (n + k + 1 + 1) ∣ a ∧ θ ^ (n + k + 1 + 1) ∣ w ∧
      θ ^ (n + k + 1 + 1) ∣ lamS ∧ ∀ x ∈ Z ++ Y, θ ^ (n + k + 1 + 1) ∣ μ x := by
    intro θ hθ
    have h1 : θ ^ (n + k + 1 + 1) ∣ G := hρ'G ▸ pow_dvd_pow_of_dvd hθ _
    refine ⟨h1.trans (hGS a (by simp)), h1.trans (hGS w (by simp)),
      h1.trans (hGS lamS (by simp)), fun x hx => h1.trans (hGS (μ x) ?_)⟩
    exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
      (List.mem_map.mpr ⟨x, hx, rfl⟩)))

  obtain ⟨qf, hqf⟩ : ∃ qf : List ↥W → ↥W, ∀ X, qf X =
      (X.filter (fun x => @decide (¬ a ∣ x) (Classical.propDecidable _))).prod :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨cf, hcf⟩ : ∃ cf : List ↥W → ℕ, ∀ X, cf X =
      (X.filter (fun x => @decide (a ∣ x) (Classical.propDecidable _))).length :=
    ⟨_, fun _ => rfl⟩
  have hqne : ∀ X, qf X ≠ 0 := by
    intro X
    rw [hqf]
    apply List.prod_ne_zero
    intro h0
    have := (List.mem_filter.mp h0).2
    simp at this
  have hPform : ∀ (σ' : ↥W) (X : List ↥W), (∀ x ∈ X, σ' ∣ x ↔ a ∣ x) →
      wcFrmP W σ' X = qf X * σ' ^ cf X ∧
        (X.filter (fun x => @decide (σ' ∣ x) (Classical.propDecidable _))).length = cf X := by
    intro σ' X hiff
    have h1 : X.filter (fun x => @decide (σ' ∣ x) (Classical.propDecidable _)) =
        X.filter (fun x => @decide (a ∣ x) (Classical.propDecidable _)) :=
      List.filter_congr (fun x hx => decide_eq_decide.mpr (hiff x hx))
    have h2 : X.filter (fun x => @decide (¬ σ' ∣ x) (Classical.propDecidable _)) =
        X.filter (fun x => @decide (¬ a ∣ x) (Classical.propDecidable _)) :=
      List.filter_congr (fun x hx => decide_eq_decide.mpr (not_congr (hiff x hx)))
    refine ⟨?_, by rw [h1, hcf]⟩
    unfold wcFrmP
    rw [h1, h2, hqf, hcf]
  have hclass : ∀ σ' θ : ↥W, σ' ≠ 0 → θ ≠ 0 → ¬ IsUnit θ → a = σ' * θ →
      (∀ x ∈ Z ++ Y, θ ^ 2 ∣ μ x) → ∀ x ∈ Z ++ Y, (σ' ∣ x ↔ a ∣ x) := by
    intro σ' θ hσ0 hθ0 hθu haσθ hθμ x hx
    constructor
    · rintro ⟨c, hc⟩
      by_contra hna
      have hμx := hμe x hna
      obtain ⟨e', he'⟩ := hθμ x hx
      have h1 : σ' * θ = σ' * (c * θ * e' * θ) := by
        rw [← haσθ, hμx, he', hc]; ring
      have h2 : θ * 1 = θ * (c * e' * θ) := by
        linear_combination mul_left_cancel₀ hσ0 h1
      have h3 : 1 = c * e' * θ := mul_left_cancel₀ hθ0 h2
      exact hθu (isUnit_of_dvd_one ⟨c * e', by linear_combination h3⟩)
    · intro hax
      exact (Dvd.intro θ haσθ.symm).trans hax

  have hgauss : ∀ σ' θ : ↥W, wcFrmInt W g σ' → θ ∈ IsLocalRing.maximalIdeal ↥W → θ ≠ 0 →
      a = σ' * θ → θ ^ (n + k + 1 + 1) ∣ a → θ ^ (n + k + 1 + 1) ∣ w →
      k2 * wcFrmP W σ' Y * lam₁ * θ ^ k ∣ k1 * wcFrmP W σ' Z * lam₂ * θ ^ n ∧
        k1 * wcFrmP W σ' Z * lam₂ * θ ^ n ∣ k2 * wcFrmP W σ' Y * lam₁ * θ ^ k := by
    intro σ' θ hσI hθm hθ0 haσθ hθa hθw
    have hσ0 : σ' ≠ 0 := hσI.2.1
    obtain ⟨hVI, hVII, hVIV⟩ := hO σ' hσI
    obtain ⟨ν, hν⟩ : ∃ ν : Valuation K (O σ').ValueGroup, ν = (O σ').valuation := ⟨_, rfl⟩
    have hmemle : ∀ x : K, ν x ≤ 1 ↔ x ∈ O σ' := fun x => by
      rw [hν]; exact (O σ').valuation_le_one_iff x
    have hvne : ∀ x : ↥W, x ≠ 0 → ν (algebraMap A K (algebraMap ↥W A x)) ≠ 0 :=
      fun x hx => (ν.ne_zero_iff).mpr (hne x hx)
    have hF1 : ∀ c : A, ν (algebraMap A K c) ≤ 1 := fun c => (hmemle _).mpr (hVIV c)
    have hF2 : ∀ w₁ w₂ : ↥W, w₁ ≠ 0 → w₂ ≠ 0 →
        ν (algebraMap A K (algebraMap ↥W A w₁)) ≤ ν (algebraMap A K (algebraMap ↥W A w₂)) →
        w₂ ∣ w₁ := by
      intro w₁ w₂ h1 h2 hle
      apply hVII w₁ w₂ h1 h2
      rw [← hmemle, Valuation.map_div]
      exact (div_le_one₀ (zero_lt_iff.mpr (hvne w₂ h2))).mpr hle
    have hveq : ∀ x y : K, x ≠ 0 → y ≠ 0 → x / y ∈ O σ' → y / x ∈ O σ' → ν x = ν y := by
      intro x y hx hy h1 h2
      rw [← hmemle, Valuation.map_div] at h1 h2
      have hx' : 0 < ν x := zero_lt_iff.mpr ((ν.ne_zero_iff).mpr hx)
      have hy' : 0 < ν y := zero_lt_iff.mpr ((ν.ne_zero_iff).mpr hy)
      exact le_antisymm ((div_le_one₀ hy').mp h1) ((div_le_one₀ hx').mp h2)
    obtain ⟨r, hr⟩ : ∃ r, ν (algebraMap A K (algebraMap ↥W A θ)) = r := ⟨_, rfl⟩
    have hr0 : 0 < r := by rw [← hr]; exact zero_lt_iff.mpr (hvne θ hθ0)
    have hr1 : r < 1 := by
      rw [← hr]
      by_contra hcon
      push_neg at hcon
      have hd : θ ∣ 1 := hF2 1 θ one_ne_zero hθ0 (by simpa using hcon)
      have := (IsLocalRing.mem_maximalIdeal _).mp hθm
      rw [mem_nonunits_iff] at this
      exact this (isUnit_of_dvd_one hd)
    have hF4 : ∀ (x : ↥W) (j : ℕ), θ ^ j ∣ x →
        ν (algebraMap A K (algebraMap ↥W A x)) ≤ r ^ j := by
      intro x j hx
      obtain ⟨y, rfl⟩ := hx
      rw [map_mul, map_mul, map_mul, map_pow, map_pow, Valuation.map_pow, hr]
      exact mul_le_of_le_one_right zero_le (hF1 _)
    have hPne : ∀ X : List ↥W, wcFrmP W σ' X ≠ 0 := by
      intro X
      unfold wcFrmP
      refine mul_ne_zero (List.prod_ne_zero ?_) (pow_ne_zero _ hσ0)
      intro h0
      have := (List.mem_filter.mp h0).2
      simp at this
    have hP1 : wcFrmP W σ' [] = 1 := by unfold wcFrmP; simp
    have hP0 : wcFrmP W σ' [0] = σ' := by unfold wcFrmP; simp [List.filter_cons]
    have hrepv : ∀ (G' : K) (a1 a2 : ↥W) (Z' Y' : List ↥W) (d' e' : A), G' ≠ 0 →
        wcFrmREP W A K 𝔭 u G' a1 a2 Z' Y' d' e' →
        ν (algebraMap A K (algebraMap ↥W A (a2 * wcFrmP W σ' Y'))) * ν G' =
          ν (algebraMap A K (algebraMap ↥W A (a1 * wcFrmP W σ' Z'))) := by
      intro G' a1 a2 Z' Y' d' e' hG hrep
      obtain ⟨h1, h2⟩ := hVI G' a1 a2 Z' Y' d' e' hG hrep
      have hne1 : algebraMap A K (algebraMap ↥W A (a2 * wcFrmP W σ' Y')) * G' ≠ 0 :=
        mul_ne_zero (hne _ (mul_ne_zero hrep.2.1 (hPne Y'))) hG
      have hne2 : algebraMap A K (algebraMap ↥W A (a1 * wcFrmP W σ' Z')) ≠ 0 :=
        hne _ (mul_ne_zero hrep.1 (hPne Z'))
      have := hveq _ _ hne1 hne2 h1 h2
      rw [Valuation.map_mul] at this
      exact this
    have hvU : ν (algebraMap A K u) = ν (algebraMap A K (algebraMap ↥W A σ')) := by
      have hrep : wcFrmREP W A K 𝔭 u (algebraMap A K u) 1 1 [0] [] 1 1 :=
        ⟨one_ne_zero, one_ne_zero, h1p, h1p, by simp⟩
      have := hrepv _ 1 1 [0] [] 1 1 hu0 hrep
      rw [hP1, hP0] at this
      simpa using this
    have hvε : ∀ ε : A, ε ∉ 𝔭 → ν (algebraMap A K ε) = 1 := by
      intro ε hε
      have hε0 : algebraMap A K ε ≠ 0 := by
        intro h0
        apply hε
        rw [(map_eq_zero_iff _ (IsFractionRing.injective A K)).mp h0]
        exact Ideal.zero_mem _
      have hrep : wcFrmREP W A K 𝔭 u (algebraMap A K ε) 1 1 [] [] 1 ε :=
        ⟨one_ne_zero, one_ne_zero, h1p, hε, by simp⟩
      have := hrepv _ 1 1 [] [] 1 ε hε0 hrep
      rw [hP1] at this
      simpa using this
    have hσθ : θ ^ (n + k + 1) ∣ σ' := by
      rw [haσθ, pow_succ] at hθa
      exact (mul_dvd_mul_iff_right hθ0).mp hθa
    have hvσ : ν (algebraMap A K (algebraMap ↥W A σ')) ≤ r ^ (n + k + 1) := hF4 σ' _ hσθ
    have hvs : ν s = r := by
      have h0 := congrArg ν hsu
      rw [Valuation.map_mul, hvU, haσθ, map_mul, map_mul, Valuation.map_mul, hr] at h0
      exact mul_right_cancel₀ (hvne σ' hσ0) (by rw [h0, mul_comm])
    have hsV : s ∈ O σ' := (hmemle s).mp (by rw [hvs]; exact hr1.le)
    have hRV : ∀ y ∈ Algebra.adjoin A {s}, y ∈ O σ' := by
      intro y hy
      induction hy using Algebra.adjoin_induction with
      | mem x hx => rw [Set.mem_singleton_iff] at hx; rw [hx]; exact hsV
      | algebraMap c => exact hVIV c
      | add x y _ _ hx hy => exact add_mem hx hy
      | mul x y _ _ hx hy => exact mul_mem hx hy
    have hT4 : ∀ y : ↥(Algebra.adjoin A {s}), y ∉ I → ν (y : K) = 1 := by
      intro y hyI
      obtain ⟨y1, hy1, a0, ha0', hya⟩ := hdecI y hyI
      have hlt : ν (s * y1) < ν (algebraMap A K a0) := by
        rw [hvε a0 ha0', Valuation.map_mul, hvs]
        calc r * ν y1 ≤ r * 1 := mul_le_mul_right ((hmemle _).mpr (hRV y1 hy1)) r
          _ < 1 := by rw [mul_one]; exact hr1
      rw [hya, add_comm, Valuation.map_add_eq_of_lt_left _ hlt, hvε a0 ha0']
    have hT5 : ∀ x : A₃, ν (algebraMap A₃ K x) ≤ 1 := by
      intro x
      obtain ⟨p, q, hq, hpq⟩ := hBr3 (algebraMap A₃ K x) ⟨x, rfl⟩
      have h1 := congrArg ν hpq
      rw [Valuation.map_mul, hT4 q hq, mul_one] at h1
      rw [h1]
      exact (hmemle _).mpr (hRV p p.2)
    have hT6 : ∀ ε : A₃, ε ∉ 𝔭₃ → ν (algebraMap A₃ K ε) = 1 := by
      intro ε hε
      obtain ⟨p, q, hq, hpq⟩ := hBr3 (algebraMap A₃ K ε) ⟨ε, rfl⟩
      have hpI' : p ∉ I := by
        intro hp
        obtain ⟨c, hc, hcp⟩ := hIJ p hp
        obtain ⟨q'', hq''⟩ := hBr2 q.2
        have h3 : ε * q'' = c :=
          IsFractionRing.injective A₃ K (by rw [map_mul, hq'', hcp, hpq])
        have hc' : ε * q'' ∈ 𝔭₃ := by rw [h3]; exact hc
        rcases hPD3.2.2.2.1.isPrime.mem_or_mem hc' with h4 | h4
        · exact hε h4
        · exact hnotJ q hq q'' h4 hq''
      have h1 := congrArg ν hpq
      rw [Valuation.map_mul, hT4 q hq, hT4 p hpI', mul_one] at h1
      exact h1
    have hbr : ∀ (j : ℕ) (ε r' g' : A₃), j ≤ n + k → ε ∉ 𝔭₃ →
        ν (algebraMap A₃ K (u₃ ^ j * ε + v₃ * r' + algebraMap ↥W A₃ w * g')) = r ^ j := by
      intro j ε r' g' hj hε
      have hfirst : ν (algebraMap A₃ K (u₃ ^ j * ε)) = r ^ j := by
        rw [map_mul, map_pow, Valuation.map_mul, Valuation.map_pow, hu3, hvs, hT6 ε hε, mul_one]
      have hlt1 : ν (algebraMap A₃ K (v₃ * r')) < r ^ j := by
        rw [map_mul, Valuation.map_mul, hv3, hvU]
        calc ν (algebraMap A K (algebraMap ↥W A σ')) * ν (algebraMap A₃ K r')
            ≤ r ^ (n + k + 1) * 1 := mul_le_mul' hvσ (hT5 r')
          _ = r ^ (n + k + 1) := mul_one _
          _ < r ^ j := pow_lt_pow_right_of_lt_one₀ hr0 hr1 (by omega)
      have hlt2 : ν (algebraMap A₃ K (algebraMap ↥W A₃ w * g')) < r ^ j := by
        rw [map_mul, Valuation.map_mul, hBr1]
        calc ν (algebraMap A K (algebraMap ↥W A w)) * ν (algebraMap A₃ K g')
            ≤ r ^ (n + k + 1 + 1) * 1 := mul_le_mul' (hF4 w _ hθw) (hT5 g')
          _ = r ^ (n + k + 1 + 1) := mul_one _
          _ < r ^ j := pow_lt_pow_right_of_lt_one₀ hr0 hr1 (by omega)
      have htail : ν (algebraMap A₃ K (v₃ * r') + algebraMap A₃ K (algebraMap ↥W A₃ w * g')) <
          ν (algebraMap A₃ K (u₃ ^ j * ε)) := by
        rw [hfirst]
        exact lt_of_le_of_lt (Valuation.map_add _ _ _) (max_lt hlt1 hlt2)
      have hsplit : algebraMap A₃ K (u₃ ^ j * ε + v₃ * r' + algebraMap ↥W A₃ w * g') =
          algebraMap A₃ K (u₃ ^ j * ε) +
            (algebraMap A₃ K (v₃ * r') + algebraMap A₃ K (algebraMap ↥W A₃ w * g')) := by
        rw [RingHom.map_add, RingHom.map_add, add_assoc]
      rw [hsplit, Valuation.map_add_eq_of_lt_left _ htail, hfirst]
    have hB1 := hbr n ε₁ r₁ g₁ (by omega) hε₁
    have hB0 := hbr k ε₀ r₀ g₀ (by omega) hε₀
    have hI2 := congrArg ν hI
    simp only [Valuation.map_mul] at hI2
    rw [hB1, hB0, hBr1, hBr1] at hI2
    have hRF := hrepv _ k1 k2 Z Y d e hF0 hR
    simp only [map_mul, Valuation.map_mul] at hRF
    have key : ∀ (x1 x2 x3 y1 y2 y3 f c d' : (O σ').ValueGroup),
        f * c * y3 = x3 * d' → x1 * x2 * f = y1 * y2 →
        x1 * x2 * x3 * d' = y1 * y2 * y3 * c := by
      intro x1 x2 x3 y1 y2 y3 f c d' h1 h2
      calc x1 * x2 * x3 * d' = x1 * x2 * (x3 * d') := by ac_rfl
        _ = x1 * x2 * (f * c * y3) := by rw [h1]
        _ = (x1 * x2 * f) * (c * y3) := by ac_rfl
        _ = y1 * y2 * (c * y3) := by rw [h2]
        _ = y1 * y2 * y3 * c := by ac_rfl
    have hkey : ν (algebraMap A K (algebraMap ↥W A (k2 * wcFrmP W σ' Y * lam₁ * θ ^ k))) =
        ν (algebraMap A K (algebraMap ↥W A (k1 * wcFrmP W σ' Z * lam₂ * θ ^ n))) := by
      simp only [map_mul, map_pow, Valuation.map_mul, Valuation.map_pow, hr]
      exact key _ _ _ _ _ _ _ _ _ hI2 hRF
    have hne1 : k2 * wcFrmP W σ' Y * lam₁ * θ ^ k ≠ 0 :=
      mul_ne_zero (mul_ne_zero (mul_ne_zero hk2 (hPne Y)) hl1) (pow_ne_zero _ hθ0)
    have hne2 : k1 * wcFrmP W σ' Z * lam₂ * θ ^ n ≠ 0 :=
      mul_ne_zero (mul_ne_zero (mul_ne_zero hk1 (hPne Z)) hl2) (pow_ne_zero _ hθ0)
    exact ⟨hF2 _ _ hne2 hne1 hkey.symm.le, hF2 _ _ hne1 hne2 hkey.le⟩

  refine ⟨ρ', hρ'm, hρ'0, h, k1, k2, Z, Y, d, e, hR, ?_⟩
  intro ρ hρI hreg _
  obtain ⟨hρm, hρ0, hρg, hgρ⟩ := hρI
  obtain ⟨⟨τ, hτ⟩, hnaρ, haρρ', -⟩ := hreg
  have hτ0 : τ ≠ 0 := by
    rintro rfl
    exact ha0 (by rw [hτ, mul_zero])
  have hτu : ¬ IsUnit τ := fun hu => hnaρ (by rw [hτ]; exact hu.mul_right_dvd.mpr dvd_rfl)
  have hτm : τ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact hτu
  have hτρ' : τ ∣ ρ' := by
    rw [hτ] at haρρ'
    exact (mul_dvd_mul_iff_left hρ0).mp haρρ'
  obtain ⟨σ, hσm, hσ0, hστ⟩ := hroot τ hτm hτ0 1
  have hστ2 : σ ^ 2 = τ := hστ
  have hσu : ¬ IsUnit σ := by
    have := (IsLocalRing.mem_maximalIdeal _).mp hσm
    rwa [mem_nonunits_iff] at this
  have hστd : σ ∣ τ := by rw [← hστ2]; exact dvd_pow_self _ (by norm_num)
  have hσρ' : σ ∣ ρ' := hστd.trans hτρ'
  have haρσ : a = ρ * σ * σ := by rw [hτ, ← hστ2]; ring
  have hρσI : wcFrmInt W g (ρ * σ) := by
    refine ⟨Ideal.mul_mem_right σ _ hρm, mul_ne_zero hρ0 hσ0, ?_, ?_⟩
    · exact (Dvd.intro σ haρσ.symm).trans haI.2.2.1
    · intro hd
      exact hga (hd.trans (Dvd.intro σ haρσ.symm))
  obtain ⟨hda1, hdw1, hdS1, hdμ1⟩ := hdivs τ hτρ'
  obtain ⟨hda2, hdw2, -, hdμ2⟩ := hdivs σ hσρ'
  have hcl1 := hclass ρ τ hρ0 hτ0 hτu hτ
    (fun x hx => (pow_dvd_pow τ (by omega)).trans (hdμ1 x hx))
  have hcl2 := hclass (ρ * σ) σ (mul_ne_zero hρ0 hσ0) hσ0 hσu haρσ
    (fun x hx => (pow_dvd_pow σ (by omega)).trans (hdμ2 x hx))
  obtain ⟨hPρY, hcρY⟩ := hPform ρ Y (fun x hx => hcl1 x (List.mem_append_right _ hx))
  obtain ⟨hPρZ, hcρZ⟩ := hPform ρ Z (fun x hx => hcl1 x (List.mem_append_left _ hx))
  obtain ⟨hP2Y, -⟩ := hPform (ρ * σ) Y (fun x hx => hcl2 x (List.mem_append_right _ hx))
  obtain ⟨hP2Z, -⟩ := hPform (ρ * σ) Z (fun x hx => hcl2 x (List.mem_append_left _ hx))
  have G1 := hgauss ρ τ ⟨hρm, hρ0, hρg, hgρ⟩ hτm hτ0 hτ hda1 hdw1
  have G2 := hgauss (ρ * σ) σ hρσI hσm hσ0 haρσ hda2 hdw2
  rw [hPρY, hPρZ] at G1
  rw [hP2Y, hP2Z] at G2

  have eA1 : k2 * (qf Y * ρ ^ cf Y) * lam₁ * τ ^ k =
      (k2 * qf Y * lam₁ * ρ ^ cf Y) * σ ^ (2 * k) := by
    rw [← hστ2, ← pow_mul]; ring
  have eB1 : k1 * (qf Z * ρ ^ cf Z) * lam₂ * τ ^ n =
      (k1 * qf Z * lam₂ * ρ ^ cf Z) * σ ^ (2 * n) := by
    rw [← hστ2, ← pow_mul]; ring
  have eA2 : k2 * (qf Y * (ρ * σ) ^ cf Y) * lam₁ * σ ^ k =
      (k2 * qf Y * lam₁ * ρ ^ cf Y) * σ ^ (cf Y + k) := by ring
  have eB2 : k1 * (qf Z * (ρ * σ) ^ cf Z) * lam₂ * σ ^ n =
      (k1 * qf Z * lam₂ * ρ ^ cf Z) * σ ^ (cf Z + n) := by ring
  have hA0ne : k2 * qf Y * lam₁ * ρ ^ cf Y ≠ 0 :=
    mul_ne_zero (mul_ne_zero (mul_ne_zero hk2 (hqne Y)) hl1) (pow_ne_zero _ hρ0)
  have hAs1 : Associated ((k2 * qf Y * lam₁ * ρ ^ cf Y) * σ ^ (2 * k))
      ((k1 * qf Z * lam₂ * ρ ^ cf Z) * σ ^ (2 * n)) := by
    rw [← eA1, ← eB1]; exact associated_of_dvd_dvd G1.1 G1.2
  have hAs2 : Associated ((k2 * qf Y * lam₁ * ρ ^ cf Y) * σ ^ (cf Y + k))
      ((k1 * qf Z * lam₂ * ρ ^ cf Z) * σ ^ (cf Z + n)) := by
    rw [← eA2, ← eB2]; exact associated_of_dvd_dvd G2.1 G2.2
  have hexpEq := hexp2 _ _ σ _ _ _ _ hA0ne hσ0 hσu hAs1 hAs2
  have hM : wcFrmM W ρ Z Y = -((k : ℤ) - n) := by
    unfold wcFrmM
    rw [hcρZ, hcρY]
    omega

  unfold wcFrmGood
  rw [hPρY, hPρZ, hM]
  rcases hD' with ⟨⟨μ', hμ'⟩, hsub⟩ | hnd
  · left
    have hτn : τ ^ n ∣ μ' * τ ^ k := by
      rcases hsub with hnk | ⟨lam', hl', hlS⟩
      · exact (pow_dvd_pow τ hnk).trans (dvd_mul_left _ _)
      · have hμ'' : μ' = lam' := mul_left_cancel₀ hl2 (hμ'.symm.trans hl')
        rw [hμ'']
        exact (((pow_dvd_pow τ (by omega : n ≤ n + k + 1 + 1)).trans hdS1).trans hlS).trans
          (dvd_mul_right _ _)
    have h1 := G1.1
    rw [hμ'] at h1
    have h2 : (k2 * (qf Y * ρ ^ cf Y)) * (μ' * τ ^ k) ∣ (k1 * (qf Z * ρ ^ cf Z)) * τ ^ n := by
      have h3 : lam₂ * ((k2 * (qf Y * ρ ^ cf Y)) * (μ' * τ ^ k)) ∣
          lam₂ * ((k1 * (qf Z * ρ ^ cf Z)) * τ ^ n) := by
        have e1 : k2 * (qf Y * ρ ^ cf Y) * (lam₂ * μ') * τ ^ k =
            lam₂ * ((k2 * (qf Y * ρ ^ cf Y)) * (μ' * τ ^ k)) := by ring
        have e2 : k1 * (qf Z * ρ ^ cf Z) * lam₂ * τ ^ n =
            lam₂ * ((k1 * (qf Z * ρ ^ cf Z)) * τ ^ n) := by ring
        rw [← e1, ← e2]; exact h1
      exact (mul_dvd_mul_iff_left hl2).mp h3
    have h4 : (k2 * (qf Y * ρ ^ cf Y)) * τ ^ n ∣ (k1 * (qf Z * ρ ^ cf Z)) * τ ^ n :=
      (mul_dvd_mul_left _ hτn).trans h2
    exact (mul_dvd_mul_iff_right (pow_ne_zero _ hτ0)).mp h4
  · right
    rw [dvd_neg]
    exact hnd

theorem wcFrmCpE_closure_list : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (K : Type u) [Field K] (j : ↥W →+* K) (U : K), U ≠ 0 → ∀ y ∈ Subring.closure ({z : K | ∃ p q : ↥W, q ≠ 0 ∧ z = j p / j q} ∪ {U, U⁻¹}), ∃ Λ : List (ℤ × ↥W × ↥W), (∀ t ∈ Λ, t.2.2 ≠ 0) ∧ y = (Λ.map (fun t => j t.2.1 / j t.2.2 * U ^ t.1)).sum :=
by
  intro Ω _ W K _ j U hU y hy
  set T : ℤ × ↥W × ↥W → K := fun t => j t.2.1 / j t.2.2 * U ^ t.1 with hT
  have hTmul : ∀ t s : ℤ × ↥W × ↥W,
      T (t.1 + s.1, t.2.1 * s.2.1, t.2.2 * s.2.2) = T t * T s := by
    intro t s
    simp only [hT, map_mul, zpow_add₀ hU, div_eq_mul_inv, mul_inv]
    ring
  have hTneg : ∀ t : ℤ × ↥W × ↥W, T (t.1, -t.2.1, t.2.2) = -T t := by
    intro t
    simp only [hT, map_neg, neg_div, neg_mul]
  induction hy using Subring.closure_induction with
  | mem x hx =>
    rcases hx with ⟨p, q, hq, rfl⟩ | hx
    · exact ⟨[(0, p, q)], by simpa using hq, by simp [hT]⟩
    · rcases hx with rfl | hx
      · exact ⟨[(1, 1, 1)], by simp, by simp [hT]⟩
      · rw [Set.mem_singleton_iff] at hx
        subst hx
        exact ⟨[(-1, 1, 1)], by simp, by simp [hT]⟩
  | zero => exact ⟨[], by simp, by simp⟩
  | one => exact ⟨[(0, 1, 1)], by simp, by simp [hT]⟩
  | add x y _ _ hx hy =>
    obtain ⟨Λ₁, h₁, e₁⟩ := hx
    obtain ⟨Λ₂, h₂, e₂⟩ := hy
    refine ⟨Λ₁ ++ Λ₂, ?_, ?_⟩
    · intro t ht
      rcases List.mem_append.mp ht with ht | ht
      · exact h₁ t ht
      · exact h₂ t ht
    · rw [List.map_append, List.sum_append, ← e₁, ← e₂]
  | neg x _ hx =>
    obtain ⟨Λ, h, e⟩ := hx
    refine ⟨Λ.map (fun t => (t.1, -t.2.1, t.2.2)), ?_, ?_⟩
    · intro t ht
      obtain ⟨t', ht', rfl⟩ := List.mem_map.mp ht
      exact h t' ht'
    · rw [e]
      clear e h
      show -(Λ.map T).sum = ((Λ.map (fun t => (t.1, -t.2.1, t.2.2))).map T).sum
      induction Λ with
      | nil => simp
      | cons t Λ ih =>
        simp only [List.map_cons, List.sum_cons, neg_add, ih]
        rw [hTneg]
  | mul x y _ _ hx hy =>
    obtain ⟨Λ₁, h₁, e₁⟩ := hx
    obtain ⟨Λ₂, h₂, e₂⟩ := hy
    refine ⟨Λ₁.flatMap (fun t => Λ₂.map (fun s => (t.1 + s.1, t.2.1 * s.2.1, t.2.2 * s.2.2))),
      ?_, ?_⟩
    · intro r hr
      obtain ⟨t, ht, hr⟩ := List.mem_flatMap.mp hr
      obtain ⟨s, hs, rfl⟩ := List.mem_map.mp hr
      exact mul_ne_zero (h₁ t ht) (h₂ s hs)
    · rw [e₁, e₂]
      clear e₁ e₂ h₁ h₂
      show (Λ₁.map T).sum * (Λ₂.map T).sum =
        ((Λ₁.flatMap (fun t => Λ₂.map (fun s => (t.1 + s.1, t.2.1 * s.2.1, t.2.2 * s.2.2)))).map T).sum
      induction Λ₁ with
      | nil => simp
      | cons t Λ₁ ih =>
        rw [List.flatMap_cons, List.map_append, List.sum_append, ← ih, List.map_cons,
          List.sum_cons, add_mul, List.map_map]
        congr 1
        rw [← List.sum_map_mul_left]
        congr 1
        apply List.map_congr_left
        intro s _
        exact (hTmul t s).symm

theorem wcFrmCpE_val : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W) (O : ↥W → ValuationSubring K), wcLlsPD W A 𝔭 (.ann u v g) → wcFrmVAL W A K 𝔭 u g O → (∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0) ∧ algebraMap A K u ≠ 0 ∧ (∀ s : A, s ∉ 𝔭 → algebraMap A K s ≠ 0) ∧ ∀ σ : ↥W, wcFrmInt W g σ → (∀ a : A, algebraMap A K a ∈ O σ) ∧ (∀ s : A, s ∉ 𝔭 → (algebraMap A K s)⁻¹ ∈ O σ) ∧ (algebraMap A K u / algebraMap A K (algebraMap ↥W A σ) ∈ O σ ∧ algebraMap A K (algebraMap ↥W A σ) / algebraMap A K u ∈ O σ) ∧ (∀ y : ↥W, algebraMap A K u = algebraMap A K (algebraMap ↥W A y) → σ ∣ y ∧ y ∣ σ) ∧ ∀ y : ↥W, algebraMap A K (u - algebraMap ↥W A y) ≠ 0 → (¬ σ ∣ y → algebraMap A K (algebraMap ↥W A y) / algebraMap A K (u - algebraMap ↥W A y) ∈ O σ) ∧ (σ ∣ y → algebraMap A K (algebraMap ↥W A σ) / algebraMap A K (u - algebraMap ↥W A y) ∈ O σ) :=
by
  intro Ω _ W A _ _ _ K _ _ _ 𝔭 u v g O hPD hO
  classical
  obtain ⟨_, hNZ, _, hmax, _, _, hg0, huv, _⟩ := hPD
  haveI := hNZ
  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    have h1 : w • (1 : A) = 0 := by rw [Algebra.smul_def, mul_one]; exact hw
    rcases smul_eq_zero.mp h1 with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hφ : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have z1 : ∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0 := by
    intro w hw h
    apply hw
    apply hWA
    apply hφ
    rw [h, map_zero, map_zero]
  have hg : algebraMap A K (algebraMap ↥W A g) ≠ 0 := z1 g hg0
  have z2 : algebraMap A K u ≠ 0 := by
    intro h
    apply hg
    rw [← huv, map_mul, h, zero_mul]
  have z3 : ∀ s : A, s ∉ 𝔭 → algebraMap A K s ≠ 0 := by
    intro s hs h
    apply hs
    have : s = 0 := hφ (by rw [h, map_zero])
    rw [this]; exact 𝔭.zero_mem
  have h1𝔭 : (1 : A) ∉ 𝔭 := (Ideal.ne_top_iff_one _).mp hmax.ne_top
  refine ⟨z1, z2, z3, fun σ hσ => ?_⟩
  obtain ⟨V₁, V₂, V₃⟩ := hO σ hσ
  have hσ0 : σ ≠ 0 := hσ.2.1
  have P0 : wcFrmP W σ [] = 1 := by simp [wcFrmP]
  have P1 : ∀ y : ↥W, σ ∣ y → wcFrmP W σ [y] = σ := by
    intro y hy; simp [wcFrmP, List.filter_cons, hy]
  have P2 : ∀ y : ↥W, ¬ σ ∣ y → wcFrmP W σ [y] = y := by
    intro y hy; simp [wcFrmP, List.filter_cons, hy]
  have S : ∀ y : ↥W, algebraMap A K (u - algebraMap ↥W A y) ≠ 0 →
      algebraMap A K (algebraMap ↥W A (wcFrmP W σ [y])) /
          algebraMap A K (u - algebraMap ↥W A y) ∈ O σ ∧
        algebraMap A K (u - algebraMap ↥W A y) /
          algebraMap A K (algebraMap ↥W A (wcFrmP W σ [y])) ∈ O σ := by
    intro y hy
    have hrep : wcFrmREP W A K 𝔭 u (algebraMap A K (u - algebraMap ↥W A y)) 1 1 [y] [] 1 1 :=
      ⟨one_ne_zero, one_ne_zero, h1𝔭, h1𝔭, by simp⟩
    have h := V₁ _ 1 1 [y] [] 1 1 hy hrep
    rw [P0] at h
    simp only [one_mul, mul_one, map_one] at h
    exact ⟨h.2, h.1⟩
  have hb : ∀ s : A, s ∉ 𝔭 → (algebraMap A K s)⁻¹ ∈ O σ := by
    intro s hs
    have hrep : wcFrmREP W A K 𝔭 u (algebraMap A K s) 1 1 [] [] 1 s :=
      ⟨one_ne_zero, one_ne_zero, h1𝔭, hs, by simp⟩
    have h := (V₁ _ 1 1 [] [] 1 s (z3 s hs) hrep).2
    rw [P0] at h
    simpa [one_div] using h
  have hu0 : algebraMap A K (u - algebraMap ↥W A 0) = algebraMap A K u := by simp
  have hc : algebraMap A K u / algebraMap A K (algebraMap ↥W A σ) ∈ O σ ∧
      algebraMap A K (algebraMap ↥W A σ) / algebraMap A K u ∈ O σ := by
    have h := S 0 (by rw [hu0]; exact z2)
    rw [P1 0 (dvd_zero σ), hu0] at h
    exact ⟨h.2, h.1⟩
  have hd : ∀ y : ↥W, algebraMap A K u = algebraMap A K (algebraMap ↥W A y) →
      σ ∣ y ∧ y ∣ σ := by
    intro y hy
    have hy0 : y ≠ 0 := by
      rintro rfl
      apply z2
      rw [hy, map_zero, map_zero]
    rw [hy] at hc
    exact ⟨V₂ y σ hy0 hσ0 hc.1, V₂ σ y hσ0 hy0 hc.2⟩
  refine ⟨V₃, hb, hc, hd, fun y hy => ⟨fun h => ?_, fun h => ?_⟩⟩
  · have := (S y hy).1
    rwa [P2 y h] at this
  · have := (S y hy).1
    rwa [P1 y h] at this

theorem wcFrmCpE_prod : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (K : Type u) [Field K] (j : ↥W →+* K) (T : Subring K) (O : ↥W → ValuationSubring K) (I : ↥W → Prop), (∀ σ, I σ → ∀ w : ↥W, j w ∈ O σ) → (∀ w : ↥W, w ≠ 0 → j w ≠ 0) → ∀ Xs : List K, (∀ X ∈ Xs, ∃ b : ↥W, b ≠ 0 ∧ ∀ δ : ↥W, δ ≠ 0 → ∃ P ∈ T, ∀ σ, I σ → j b * X ∈ O σ ∧ j b * (X - P) / j δ ∈ O σ) → ∃ b : ↥W, b ≠ 0 ∧ ∀ δ : ↥W, δ ≠ 0 → ∃ P ∈ T, ∀ σ, I σ → j b * Xs.prod ∈ O σ ∧ j b * (Xs.prod - P) / j δ ∈ O σ :=
by
  intro Ω _ W K _ j T O I hjO hj0 Xs
  induction Xs with
  | nil =>
    intro _
    refine ⟨1, one_ne_zero, fun δ _ => ⟨1, T.one_mem, fun σ _ => ⟨?_, ?_⟩⟩⟩
    · rw [List.prod_nil, map_one, mul_one]; exact (O σ).one_mem
    · rw [List.prod_nil, sub_self, mul_zero, zero_div]; exact (O σ).zero_mem
  | cons X Xs ih =>
    intro h
    obtain ⟨b₁, hb₁, hX⟩ := h X (by simp)
    obtain ⟨b₂, hb₂, hY⟩ := ih (fun Z hZ => h Z (by simp [hZ]))
    refine ⟨b₁ * b₂, mul_ne_zero hb₁ hb₂, fun δ hδ => ?_⟩
    obtain ⟨P₁, hP₁T, hP₁⟩ := hX δ hδ
    obtain ⟨P₂, hP₂T, hP₂⟩ := hY δ hδ
    refine ⟨P₁ * P₂, T.mul_mem hP₁T hP₂T, fun σ hσ => ?_⟩
    obtain ⟨A₁, B₁⟩ := hP₁ σ hσ
    obtain ⟨A₂, B₂⟩ := hP₂ σ hσ
    have D : j δ ∈ O σ := hjO σ hσ δ
    have hjδ : j δ ≠ 0 := hj0 δ hδ
    rw [List.prod_cons, map_mul]
    constructor
    · have e : j b₁ * j b₂ * (X * Xs.prod) = (j b₁ * X) * (j b₂ * Xs.prod) := by ring
      rw [e]; exact mul_mem A₁ A₂
    · have e : j b₁ * j b₂ * (X * Xs.prod - P₁ * P₂) / j δ =
          (j b₁ * X) * (j b₂ * (Xs.prod - P₂) / j δ) +
            (j b₁ * (X - P₁) / j δ) * (j b₂ * Xs.prod) -
            (j b₁ * (X - P₁) / j δ) * (j b₂ * (Xs.prod - P₂) / j δ) * j δ := by
        field_simp
        ring
      rw [e]
      exact sub_mem (add_mem (mul_mem A₁ B₂) (mul_mem B₁ A₂)) (mul_mem (mul_mem B₁ B₂) D)

theorem wcFrmCpE_pole : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (K : Type u) [Field K] (j : ↥W →+* K) (U : K) (O : ↥W → ValuationSubring K) (I : ↥W → Prop) (ρ₁ ρ₂ y : ↥W), (∀ x z : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → z ≠ 0 → ∃ J : ℕ, z ∣ x ^ J) → (∀ w : ↥W, w ≠ 0 → j w ≠ 0) → U ≠ 0 → (∀ σ, I σ → σ ≠ 0 ∧ ρ₁ ∣ σ ∧ σ ∣ ρ₂) → (∀ σ, I σ → ∀ w : ↥W, j w ∈ O σ) → (∀ σ, I σ → U / j σ ∈ O σ ∧ j σ / U ∈ O σ) → U - j y ≠ 0 → (∀ σ, I σ → (¬ σ ∣ y → j y / (U - j y) ∈ O σ) ∧ (σ ∣ y → j σ / (U - j y) ∈ O σ)) → ¬ (ρ₁ ∣ y ∧ y ∣ ρ₂) → ∃ b : ↥W, b ≠ 0 ∧ ∀ δ : ↥W, δ ≠ 0 → ∃ P ∈ Subring.closure ({z : K | ∃ p q : ↥W, q ≠ 0 ∧ z = j p / j q} ∪ {U, U⁻¹}), ∀ σ, I σ → j b * (U - j y)⁻¹ ∈ O σ ∧ j b * ((U - j y)⁻¹ - P) / j δ ∈ O σ :=
by
  intro Ω _ W K _ j U O I ρ₁ ρ₂ y harch hj0 hU hI hjO hUσ hD hpole hoff
  have hLU' : U ∈ Subring.closure ({z : K | ∃ p q : ↥W, q ≠ 0 ∧ z = j p / j q} ∪ {U, U⁻¹}) :=
    Subring.subset_closure (Set.mem_union_right _ (Set.mem_insert U _))
  have hLU : U⁻¹ ∈ Subring.closure ({z : K | ∃ p q : ↥W, q ≠ 0 ∧ z = j p / j q} ∪ {U, U⁻¹}) :=
    Subring.subset_closure (Set.mem_union_right _ (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
  have hLj : ∀ w : ↥W,
      j w ∈ Subring.closure ({z : K | ∃ p q : ↥W, q ≠ 0 ∧ z = j p / j q} ∪ {U, U⁻¹}) :=
    fun w => Subring.subset_closure
      (Set.mem_union_left _ ⟨w, 1, one_ne_zero, by rw [map_one, div_one]⟩)
  have hLinv : ∀ w : ↥W, w ≠ 0 →
      (j w)⁻¹ ∈ Subring.closure ({z : K | ∃ p q : ↥W, q ≠ 0 ∧ z = j p / j q} ∪ {U, U⁻¹}) :=
    fun w hw => Subring.subset_closure
      (Set.mem_union_left _ ⟨1, w, hw, by rw [map_one, one_div]⟩)
  have hG : ∀ (κ r : K) (J : ℕ), κ ≠ 0 → κ * (1 - r) = U - j y →
      (U - j y)⁻¹ - κ⁻¹ * ∑ i ∈ Finset.range J, r ^ i = r ^ J * (U - j y)⁻¹ := by
    intro κ r J hκ hκD
    have h1 : κ * κ⁻¹ = 1 := mul_inv_cancel₀ hκ
    have h2 : (1 - r) * ∑ i ∈ Finset.range J, r ^ i = 1 - r ^ J := mul_neg_geom_sum r J
    have h3 : (U - j y) * (U - j y)⁻¹ = 1 := mul_inv_cancel₀ hD
    linear_combination (-(U - j y)⁻¹ * (1 - r ^ J)) * h1 + (-κ⁻¹ * (U - j y)⁻¹ * κ) * h2 +
      (κ⁻¹ * (U - j y)⁻¹ * ∑ i ∈ Finset.range J, r ^ i) * hκD +
      (κ⁻¹ * ∑ i ∈ Finset.range J, r ^ i) * h3
  by_cases h : ρ₁ ∣ y
  ·
    have hny : ¬ y ∣ ρ₂ := fun h' => hoff ⟨h, h'⟩
    obtain ⟨q, hq⟩ : ρ₂ ∣ y := (ValuationRing.dvd_total y ρ₂).resolve_left hny
    have hρ₂ : ρ₂ ≠ 0 := by rintro rfl; exact hny (dvd_zero y)
    have hqm : q ∈ IsLocalRing.maximalIdeal ↥W := by
      by_contra hqm
      have hu : IsUnit q := IsLocalRing.notMem_maximalIdeal.mp hqm
      exact hny (by rw [hq]; exact (IsUnit.mul_right_dvd hu).mpr dvd_rfl)
    refine ⟨ρ₂, hρ₂, fun δ hδ => ?_⟩
    obtain ⟨J, s, hs⟩ := harch q δ hqm hδ
    have hδ0 : j δ ≠ 0 := hj0 δ hδ
    refine ⟨U⁻¹ * ∑ i ∈ Finset.range J, (j y * U⁻¹) ^ i, ?_, fun σ hσ => ?_⟩
    · exact mul_mem hLU (sum_mem (fun i _ => pow_mem (mul_mem (hLj y) hLU) i))
    · obtain ⟨hσ0, -, t, ht⟩ := hI σ hσ
      have hσy : σ ∣ y := ⟨t * q, by rw [hq, ht, mul_assoc]⟩
      have hp := (hpole σ hσ).2 hσy
      have hjO' := hjO σ hσ
      have hfirst : j ρ₂ * (U - j y)⁻¹ = j t * (j σ / (U - j y)) := by
        rw [ht, map_mul, div_eq_mul_inv]; ring
      refine ⟨by rw [hfirst]; exact mul_mem (hjO' t) hp, ?_⟩
      have hGe := hG U (j y * U⁻¹) J hU
        (by linear_combination (-j y) * mul_inv_cancel₀ hU)
      have hr : j y * U⁻¹ = (j t * (j σ / U)) * j q := by
        rw [hq, ht, map_mul, map_mul, div_eq_mul_inv]; ring
      have hrJ : (j y * U⁻¹) ^ J = (j t * (j σ / U)) ^ J * (j δ * j s) := by
        rw [hr, mul_pow (j t * (j σ / U)) (j q) J, ← map_pow j q J, hs, map_mul]
      have herr : j ρ₂ * ((U - j y)⁻¹ - U⁻¹ * ∑ i ∈ Finset.range J, (j y * U⁻¹) ^ i) / j δ
          = j s * (j t * (j σ / U)) ^ J * (j t * (j σ / (U - j y))) := by
        rw [hGe, hrJ, ht, map_mul]
        linear_combination (j σ * j t * (j t * (j σ / U)) ^ J * j s * (U - j y)⁻¹) *
          mul_inv_cancel₀ hδ0
      rw [herr]
      exact mul_mem (mul_mem (hjO' s) (pow_mem (mul_mem (hjO' t) (hUσ σ hσ).2) J))
        (mul_mem (hjO' t) hp)
  ·
    obtain ⟨q, hq⟩ : y ∣ ρ₁ := (ValuationRing.dvd_total ρ₁ y).resolve_left h
    have hy : y ≠ 0 := by rintro rfl; exact h (dvd_zero ρ₁)
    have hqm : q ∈ IsLocalRing.maximalIdeal ↥W := by
      by_contra hqm
      have hu : IsUnit q := IsLocalRing.notMem_maximalIdeal.mp hqm
      exact h (by rw [hq]; exact (IsUnit.mul_right_dvd hu).mpr dvd_rfl)
    have hjy : j y ≠ 0 := hj0 y hy
    refine ⟨y, hy, fun δ hδ => ?_⟩
    obtain ⟨J, s, hs⟩ := harch q δ hqm hδ
    have hδ0 : j δ ≠ 0 := hj0 δ hδ
    refine ⟨(-j y)⁻¹ * ∑ i ∈ Finset.range J, (U * (j y)⁻¹) ^ i, ?_, fun σ hσ => ?_⟩
    · rw [inv_neg]
      exact mul_mem (neg_mem (hLinv y hy))
        (sum_mem (fun i _ => pow_mem (mul_mem hLU' (hLinv y hy)) i))
    · obtain ⟨hσ0, ⟨t, ht⟩, -⟩ := hI σ hσ
      have hnσy : ¬ σ ∣ y := fun h' => h (dvd_trans ⟨t, ht⟩ h')
      have hp := (hpole σ hσ).1 hnσy
      have hjO' := hjO σ hσ
      refine ⟨by rw [← div_eq_mul_inv]; exact hp, ?_⟩
      have hjσ : j σ ≠ 0 := hj0 σ hσ0
      have hGe := hG (-j y) (U * (j y)⁻¹) J (neg_ne_zero.mpr hjy)
        (by linear_combination U * mul_inv_cancel₀ hjy)
      have hjσ' : j σ = j y * j q * j t := by rw [ht, hq, map_mul, map_mul]
      have hr : U * (j y)⁻¹ = (U / j σ * j t) * j q := by
        linear_combination (U * (j σ)⁻¹ * (j y)⁻¹) * hjσ' + (-U * (j y)⁻¹) * mul_inv_cancel₀ hjσ +
          (U * (j σ)⁻¹ * j t * j q) * mul_inv_cancel₀ hjy
      have hrJ : (U * (j y)⁻¹) ^ J = (U / j σ * j t) ^ J * (j δ * j s) := by
        rw [hr, mul_pow (U / j σ * j t) (j q) J, ← map_pow j q J, hs, map_mul]
      have herr : j y * ((U - j y)⁻¹ - (-j y)⁻¹ * ∑ i ∈ Finset.range J, (U * (j y)⁻¹) ^ i) / j δ
          = (U / j σ * j t) ^ J * j s * (j y / (U - j y)) := by
        rw [hGe, hrJ]
        linear_combination (j y * (U / j σ * j t) ^ J * j s * (U - j y)⁻¹) * mul_inv_cancel₀ hδ0
      rw [herr]
      exact mul_mem (mul_mem (pow_mem (mul_mem (hUσ σ hσ).1 (hjO' t)) J) (hjO' s)) hp

theorem wcFrmCpE_unit : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (j : ↥W →+* K) (𝔭 : Ideal A) [𝔭.IsPrime] (u v : A) (g c : ↥W) (O : ↥W → ValuationSubring K) (I : ↥W → Prop), (∀ w : ↥W, j w = algebraMap A K (algebraMap ↥W A w)) → u * v = algebraMap ↥W A g → (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 → u ∈ 𝔭 → v ∈ 𝔭 → (∀ a : A, ∃ (γ : ↥W) (s a₁ b₁ : A), s ∉ 𝔭 ∧ s * (a - algebraMap ↥W A γ) = u * a₁ + v * b₁) → algebraMap A K u ≠ 0 → (∀ s : A, s ∉ 𝔭 → algebraMap A K s ≠ 0) → (∀ w : ↥W, w ≠ 0 → j w ≠ 0) → c ≠ 0 → (∀ σ, I σ → ∀ a : A, algebraMap A K a ∈ O σ) → (∀ σ, I σ → ∀ s : A, s ∉ 𝔭 → (algebraMap A K s)⁻¹ ∈ O σ) → (∀ σ, I σ → algebraMap A K u / j c ∈ O σ ∧ algebraMap A K v / j c ∈ O σ) → ∀ N : ℕ, ∀ a s : A, s ∉ 𝔭 → ∃ P ∈ Subring.closure ({z : K | ∃ p q : ↥W, q ≠ 0 ∧ z = j p / j q} ∪ {algebraMap A K u, (algebraMap A K u)⁻¹}), ∀ σ, I σ → (algebraMap A K a / algebraMap A K s - P) / j c ^ N ∈ O σ :=
by
  intro Ω _ W A _ _ K _ _ j 𝔭 h𝔭 u v g c O I hj huv hm𝔭 hu𝔭 hv𝔭 hsec hU hs0 hj0 hc0 hA hinv hUc
  set L := Subring.closure ({z : K | ∃ p q : ↥W, q ≠ 0 ∧ z = j p / j q} ∪
    {algebraMap A K u, (algebraMap A K u)⁻¹}) with hL

  have alg : ∀ (x y1 y2 y3 y4 Px P1 P2 P3 P4 ex e1 e2 e3 e4 U V u' v' C E G G' Wi : K),
      G' * Wi = 1 → U = u' * C → V = v' * C →
      G' * x = G + U * y1 + V * y2 - U * x * y3 - V * x * y4 →
      x = Px + E * ex → y1 = P1 + E * e1 → y2 = P2 + E * e2 → y3 = P3 + E * e3 →
      y4 = P4 + E * e4 →
      x - Wi * (G + U * P1 + V * P2 - U * Px * P3 - V * Px * P4) =
        (Wi * (u' * e1 + v' * e2 - u' * (ex * y3 + Px * e3) - v' * (ex * y4 + Px * e4))) *
          (E * C) := by
    intro x y1 y2 y3 y4 Px P1 P2 P3 P4 ex e1 e2 e3 e4 U V u' v' C E G G' Wi hGW hU' hV' hst
      hx hy1 hy2 hy3 hy4
    subst hU' hV' hx hy1 hy2 hy3 hy4
    linear_combination Wi * hst - (Px + E * ex) * hGW
  have hjL : ∀ w : ↥W, j w ∈ L := by
    intro w
    apply Subring.subset_closure
    exact Set.mem_union_left _ ⟨w, 1, one_ne_zero, by rw [map_one, div_one]⟩
  have hUL : algebraMap A K u ∈ L :=
    Subring.subset_closure (Set.mem_union_right _ (Set.mem_insert _ _))
  have hUiL : (algebraMap A K u)⁻¹ ∈ L :=
    Subring.subset_closure (Set.mem_union_right _ (Set.mem_insert_of_mem _
      (Set.mem_singleton _)))
  have hVL : algebraMap A K v ∈ L := by
    have h1 : algebraMap A K u * algebraMap A K v = j g := by
      rw [hj, ← map_mul, huv]
    have h2 : algebraMap A K v = j g * (algebraMap A K u)⁻¹ := by
      rw [← h1, mul_comm (algebraMap A K u), mul_assoc, mul_inv_cancel₀ hU, mul_one]
    rw [h2]; exact L.mul_mem (hjL g) hUiL
  have hjcne : j c ≠ 0 := hj0 c hc0
  have hjO : ∀ σ, I σ → ∀ w : ↥W, j w ∈ O σ := fun σ hσ w => by rw [hj]; exact hA σ hσ _
  have hq : ∀ σ, I σ → ∀ a s : A, s ∉ 𝔭 → algebraMap A K a / algebraMap A K s ∈ O σ := by
    intro σ hσ a s hs
    rw [div_eq_mul_inv]; exact mul_mem (hA σ hσ a) (hinv σ hσ s hs)
  have hdiv : ∀ a s : A, s ∉ 𝔭 →
      algebraMap A K a / algebraMap A K s * algebraMap A K s = algebraMap A K a :=
    fun a s hs => div_mul_cancel₀ _ (hs0 s hs)

  have hform : ∀ (E x P : K), E ≠ 0 → (∀ σ, I σ → (x - P) / E ∈ O σ) →
      ∃ ex : K, x = P + E * ex ∧ ∀ σ, I σ → ex ∈ O σ := by
    intro E x P hE h
    refine ⟨(x - P) / E, ?_, h⟩
    rw [mul_comm, div_mul_cancel₀ _ hE]; ring
  intro N
  induction N with
  | zero =>
    intro a s hs
    refine ⟨0, L.zero_mem, fun σ hσ => ?_⟩
    rw [sub_zero, pow_zero, div_one]; exact hq σ hσ a s hs
  | succ N ih =>
    intro a s hs
    obtain ⟨γ, s₁, a₁, b₁, hs₁, he₁⟩ := hsec a
    obtain ⟨γ', s₂, a₂, b₂, hs₂, he₂⟩ := hsec s
    have hγ' : IsUnit γ' := by
      by_contra hn
      have hm : γ' ∈ IsLocalRing.maximalIdeal ↥W := by
        by_contra h; exact hn (IsLocalRing.notMem_maximalIdeal.mp h)
      have h1 : algebraMap ↥W A γ' ∈ 𝔭 := hm𝔭 (Ideal.mem_map_of_mem _ hm)
      have h2 : s₂ * s ∈ 𝔭 := by
        have e : s₂ * s = (u * a₂ + v * b₂) + s₂ * algebraMap ↥W A γ' := by
          rw [← he₂]; ring
        rw [e]
        exact 𝔭.add_mem (𝔭.add_mem (𝔭.mul_mem_right _ hu𝔭) (𝔭.mul_mem_right _ hv𝔭))
          (𝔭.mul_mem_left _ h1)
      rcases h𝔭.mem_or_mem h2 with h | h
      · exact hs₂ h
      · exact hs h
    obtain ⟨w, hγw⟩ : ∃ w : ↥W, j γ' * j w = 1 :=
      ⟨↑(hγ'.unit⁻¹), by rw [← map_mul, IsUnit.mul_val_inv, map_one]⟩
    have he₁' : algebraMap A K s₁ * (algebraMap A K a - j γ) =
        algebraMap A K u * algebraMap A K a₁ + algebraMap A K v * algebraMap A K b₁ := by
      rw [hj]; simpa only [map_mul, map_sub, map_add] using congrArg (algebraMap A K) he₁
    have he₂' : algebraMap A K s₂ * (algebraMap A K s - j γ') =
        algebraMap A K u * algebraMap A K a₂ + algebraMap A K v * algebraMap A K b₂ := by
      rw [hj]; simpa only [map_mul, map_sub, map_add] using congrArg (algebraMap A K) he₂
    have E1 : algebraMap A K a = j γ + algebraMap A K u * (algebraMap A K a₁ / algebraMap A K s₁)
        + algebraMap A K v * (algebraMap A K b₁ / algebraMap A K s₁) := by
      apply mul_left_cancel₀ (hs0 s₁ hs₁)
      linear_combination he₁' - algebraMap A K u * hdiv a₁ s₁ hs₁
        - algebraMap A K v * hdiv b₁ s₁ hs₁
    have E2 : algebraMap A K s = j γ' + algebraMap A K u * (algebraMap A K a₂ / algebraMap A K s₂)
        + algebraMap A K v * (algebraMap A K b₂ / algebraMap A K s₂) := by
      apply mul_left_cancel₀ (hs0 s₂ hs₂)
      linear_combination he₂' - algebraMap A K u * hdiv a₂ s₂ hs₂
        - algebraMap A K v * hdiv b₂ s₂ hs₂
    have hstar : j γ' * (algebraMap A K a / algebraMap A K s) =
        j γ + algebraMap A K u * (algebraMap A K a₁ / algebraMap A K s₁)
          + algebraMap A K v * (algebraMap A K b₁ / algebraMap A K s₁)
          - algebraMap A K u * (algebraMap A K a / algebraMap A K s) *
              (algebraMap A K a₂ / algebraMap A K s₂)
          - algebraMap A K v * (algebraMap A K a / algebraMap A K s) *
              (algebraMap A K b₂ / algebraMap A K s₂) := by
      linear_combination hdiv a s hs - (algebraMap A K a / algebraMap A K s) * E2 + E1
    have hE : j c ^ N ≠ 0 := pow_ne_zero _ hjcne
    obtain ⟨Px, hPxL, hPx⟩ := ih a s hs
    obtain ⟨P1, hP1L, hP1⟩ := ih a₁ s₁ hs₁
    obtain ⟨P2, hP2L, hP2⟩ := ih b₁ s₁ hs₁
    obtain ⟨P3, hP3L, hP3⟩ := ih a₂ s₂ hs₂
    obtain ⟨P4, hP4L, hP4⟩ := ih b₂ s₂ hs₂
    obtain ⟨ex, hex, hexO⟩ := hform _ _ _ hE hPx
    obtain ⟨e1, he1, he1O⟩ := hform _ _ _ hE hP1
    obtain ⟨e2, he2, he2O⟩ := hform _ _ _ hE hP2
    obtain ⟨e3, he3, he3O⟩ := hform _ _ _ hE hP3
    obtain ⟨e4, he4, he4O⟩ := hform _ _ _ hE hP4
    refine ⟨j w * (j γ + algebraMap A K u * P1 + algebraMap A K v * P2
      - algebraMap A K u * Px * P3 - algebraMap A K v * Px * P4), ?_, ?_⟩
    · exact L.mul_mem (hjL w) (L.sub_mem (L.sub_mem (L.add_mem (L.add_mem (hjL γ)
        (L.mul_mem hUL hP1L)) (L.mul_mem hVL hP2L)) (L.mul_mem (L.mul_mem hUL hPxL) hP3L))
        (L.mul_mem (L.mul_mem hVL hPxL) hP4L))
    · intro σ hσ
      have key := alg _ _ _ _ _ Px P1 P2 P3 P4 ex e1 e2 e3 e4 _ _
        (algebraMap A K u / j c) (algebraMap A K v / j c) (j c) (j c ^ N) (j γ) (j γ') (j w)
        hγw (div_mul_cancel₀ _ hjcne).symm (div_mul_cancel₀ _ hjcne).symm hstar hex he1 he2
        he3 he4
      rw [pow_succ, key, mul_div_cancel_right₀ _ (mul_ne_zero hE hjcne)]
      have hPxO : Px ∈ O σ := by
        have : Px = algebraMap A K a / algebraMap A K s - j c ^ N * ex := by
          rw [hex]; ring
        rw [this]
        exact sub_mem (hq σ hσ a s hs) (mul_mem (pow_mem (hjO σ hσ c) N) (hexO σ hσ))
      have hu' := (hUc σ hσ).1
      have hv' := (hUc σ hσ).2
      exact mul_mem (hjO σ hσ w) (sub_mem (sub_mem (add_mem (mul_mem hu' (he1O σ hσ))
        (mul_mem hv' (he2O σ hσ))) (mul_mem hu' (add_mem (mul_mem (hexO σ hσ)
          (hq σ hσ a₂ s₂ hs₂)) (mul_mem hPxO (he3O σ hσ)))))
        (mul_mem hv' (add_mem (mul_mem (hexO σ hσ) (hq σ hσ b₂ s₂ hs₂))
          (mul_mem hPxO (he4O σ hσ)))))

theorem wcFrmCp_ann_section : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) → ∀ a : A, ∃ (γ : ↥W) (s a₁ b₁ : A), s ∉ 𝔭 ∧ s * (a - algebraMap ↥W A γ) = u * a₁ + v * b₁ :=
by
  classical

  have KF : ∀ (H : Type u) [CommRing H] [IsLocalRing H] (I : Ideal H) [IsLocalRing (H ⧸ I)],
      I ≠ ⊤ → ∀ x ∈ IsLocalRing.maximalIdeal H,
        Ideal.Quotient.mk I x ∈ IsLocalRing.maximalIdeal (H ⧸ I) := by
    intro H _ _ I _ hI x hx
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    obtain ⟨b, hb⟩ := hu.exists_right_inv
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective b
    rw [← map_mul, ← map_one (Ideal.Quotient.mk I), Ideal.Quotient.eq] at hb
    have h1 : (1 : H) ∈ IsLocalRing.maximalIdeal H := by
      have e : (1 : H) = x * z - (x * z - 1) := by ring
      rw [e]
      exact Ideal.sub_mem _ (Ideal.mul_mem_right _ _ hx) (IsLocalRing.le_maximalIdeal hI hb)
    exact (IsLocalRing.maximalIdeal.isMaximal H).ne_top ((Ideal.eq_top_iff_one _).mpr h1)

  have c1 : ∀ (H : Type u) [CommRing H] [HenselianLocalRing H] (I : Ideal H), I ≠ ⊤ →
      HenselianLocalRing (H ⧸ I) := by
    intro H _ _ I hI
    haveI : Nontrivial (H ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
    haveI : IsLocalRing (H ⧸ I) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    have KF' : ∀ x : H, Ideal.Quotient.mk I x ∈ IsLocalRing.maximalIdeal (H ⧸ I) →
        x ∈ IsLocalRing.maximalIdeal H := by
      intro x hx
      by_contra hx'
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hx'
      exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hx) (hx'.map _)
    refine HenselianLocalRing.mk ?_
    intro p hp a₀ h₁ h₂
    obtain ⟨F, hFmap, -, hFmon⟩ := Polynomial.lifts_and_degree_eq_and_monic
      ((Polynomial.mem_lifts p).mpr
        (Polynomial.map_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective p)) hp
    obtain ⟨b₀, rfl⟩ := Ideal.Quotient.mk_surjective a₀
    have hev : ∀ (P : Polynomial H) (x : H), (P.map (Ideal.Quotient.mk I)).eval
        (Ideal.Quotient.mk I x) = Ideal.Quotient.mk I (P.eval x) := fun P x => by
      rw [Polynomial.eval_map, Polynomial.eval₂_hom]
    subst hFmap
    rw [hev] at h₁
    rw [Polynomial.derivative_map, hev] at h₂
    have h₁' := KF' _ h₁
    have h₂' : IsUnit (F.derivative.eval b₀) := by
      by_contra hn
      have hm : F.derivative.eval b₀ ∈ IsLocalRing.maximalIdeal H := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact hn
      exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp (KF H I hI _ hm)) h₂
    obtain ⟨c, hc, hcm⟩ := HenselianLocalRing.is_henselian F hFmon b₀ h₁' h₂'
    refine ⟨Ideal.Quotient.mk I c, ?_, ?_⟩
    · rw [Polynomial.IsRoot.def, hev, Polynomial.IsRoot.def.mp hc, map_zero]
    · rw [← map_sub]; exact KF H I hI _ hcm

  have c3a : ∀ (S : Type u) [CommRing S] (B : Type u) [CommRing B] (f : S →+* B), f.Etale →
      ∀ K : Ideal S, RingHom.Etale (Ideal.quotientMap (K.map f) f Ideal.le_comap_map) := by
    intro S _ B _ f hf K
    letI := f.toAlgebra
    haveI : Algebra.Etale S B := hf
    have h1 := RingHom.etale_algebraMap.mpr
      (inferInstance : Algebra.Etale (S ⧸ K) (TensorProduct S (S ⧸ K) B))
    let e₁ : TensorProduct S (S ⧸ K) B ≃+* B ⧸ K.map (algebraMap S B) :=
      (Algebra.TensorProduct.comm S (S ⧸ K) B).toRingEquiv.trans
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B K).symm.toRingEquiv
    have hg := RingHom.Etale.respectsIso.1 _ e₁ h1
    convert hg using 1
    apply RingHom.ext
    intro x
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [Ideal.quotientMap_mk]
    show _ = e₁ (algebraMap (S ⧸ K) (TensorProduct S (S ⧸ K) B) (Ideal.Quotient.mk K s))
    rw [Algebra.TensorProduct.algebraMap_apply]
    show _ = (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B K).symm
      ((Algebra.TensorProduct.comm S (S ⧸ K) B) (_ ⊗ₜ[S] (1 : B)))
    rw [Algebra.TensorProduct.comm_tmul, Algebra.algebraMap_self, RingHom.id_apply,
      Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul]
    rw [Algebra.smul_def, mul_one]
    rfl

  have c3 : ∀ (R : Type u) [CommRing R] (g : R) (B : Type u) [CommRing B]
      (f : (MvPolynomial (Fin 2) R ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+* B),
      RingHom.Etale (R := MvPolynomial (Fin 2) R ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (S := B) f →
      ∃ φ : (R ⧸ Ideal.span {g}) →+* (B ⧸ Ideal.span {f (Ideal.Quotient.mk _ (MvPolynomial.X 0)),
          f (Ideal.Quotient.mk _ (MvPolynomial.X 1))}),
        RingHom.Etale φ ∧ ∀ w : R, φ (Ideal.Quotient.mk _ w) =
          Ideal.Quotient.mk _ (f (Ideal.Quotient.mk _ (MvPolynomial.C w))) := by
    intro R _ g B _ f hf
    let J0 : Ideal (MvPolynomial (Fin 2) R) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}
    let K : Ideal (MvPolynomial (Fin 2) R ⧸ J0) := Ideal.span
      {Ideal.Quotient.mk J0 (MvPolynomial.X 0), Ideal.Quotient.mk J0 (MvPolynomial.X 1)}
    have hK : K = Ideal.span
      {Ideal.Quotient.mk J0 (MvPolynomial.X 0), Ideal.Quotient.mk J0 (MvPolynomial.X 1)} := rfl
    have hX0 : Ideal.Quotient.mk J0 (MvPolynomial.X 0) ∈ K := Ideal.subset_span (by simp)
    have hX1 : Ideal.Quotient.mk J0 (MvPolynomial.X 1) ∈ K := Ideal.subset_span (by simp)
    have hXi : ∀ i : Fin 2,
        Ideal.Quotient.mk K (Ideal.Quotient.mk J0 (MvPolynomial.X i)) = 0 := by
      intro i
      rw [Ideal.Quotient.eq_zero_iff_mem]
      fin_cases i
      · exact hX0
      · exact hX1
    have hCg : Ideal.Quotient.mk K (Ideal.Quotient.mk J0 (MvPolynomial.C g)) = 0 := by
      have e : Ideal.Quotient.mk J0 (MvPolynomial.C g) =
          Ideal.Quotient.mk J0 (MvPolynomial.X 0) * Ideal.Quotient.mk J0 (MvPolynomial.X 1) := by
        rw [← map_mul, Ideal.Quotient.eq]
        exact Ideal.mem_span_singleton'.mpr ⟨-1, by ring⟩
      rw [e, Ideal.Quotient.eq_zero_iff_mem]
      exact K.mul_mem_right _ hX0
    have hψ : ∀ a ∈ Ideal.span {g},
        ((Ideal.Quotient.mk K).comp ((Ideal.Quotient.mk J0).comp MvPolynomial.C)) a = 0 := by
      intro a ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      simp only [RingHom.comp_apply]
      rw [Ideal.Quotient.eq_zero_iff_mem, map_mul, map_mul]
      exact K.mul_mem_left _ (Ideal.Quotient.eq_zero_iff_mem.mp hCg)
    let ψ : R ⧸ Ideal.span {g} →+* (MvPolynomial (Fin 2) R ⧸ J0) ⧸ K :=
      Ideal.Quotient.lift _ _ hψ
    let π₀ : MvPolynomial (Fin 2) R →+* R ⧸ Ideal.span {g} :=
      MvPolynomial.eval₂Hom (Ideal.Quotient.mk (Ideal.span {g})) (fun _ => 0)
    have hπ₀X : ∀ i, π₀ (MvPolynomial.X i) = 0 := fun i => MvPolynomial.eval₂Hom_X' _ _ i
    have hπ₀C : ∀ r, π₀ (MvPolynomial.C r) = Ideal.Quotient.mk (Ideal.span {g}) r :=
      fun r => MvPolynomial.eval₂Hom_C _ _ r
    have hπ₀ : ∀ a ∈ J0, π₀ a = 0 := by
      intro a ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, map_sub, map_mul, hπ₀X, hπ₀X, hπ₀C,
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self g)]
      simp
    let π : MvPolynomial (Fin 2) R ⧸ J0 →+* R ⧸ Ideal.span {g} := Ideal.Quotient.lift J0 π₀ hπ₀
    have hπmk : ∀ p, π (Ideal.Quotient.mk J0 p) = π₀ p := fun p => Ideal.Quotient.lift_mk _ _ _
    have hπK : ∀ a ∈ K, π a = 0 := by
      intro a ha
      rw [hK] at ha
      obtain ⟨c₁, c₂, rfl⟩ := Ideal.mem_span_pair.mp ha
      rw [map_add, map_mul, map_mul, hπmk, hπmk, hπ₀X, hπ₀X]
      simp
    let θ' : (MvPolynomial (Fin 2) R ⧸ J0) ⧸ K →+* R ⧸ Ideal.span {g} :=
      Ideal.Quotient.lift K π hπK
    have hψmk : ∀ w, ψ (Ideal.Quotient.mk _ w) =
        Ideal.Quotient.mk K (Ideal.Quotient.mk J0 (MvPolynomial.C w)) :=
      fun w => Ideal.Quotient.lift_mk _ _ _
    have hθ'mk : ∀ y, θ' (Ideal.Quotient.mk K y) = π y := fun y => Ideal.Quotient.lift_mk _ _ _
    have hθψ : ∀ x, θ' (ψ x) = x := by
      intro x
      obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [hψmk, hθ'mk, hπmk, hπ₀C]
    have hψθ : ∀ y, ψ (θ' y) = y := by
      intro y
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [hθ'mk, hπmk]
      induction p using MvPolynomial.induction_on with
      | C a => rw [hπ₀C, hψmk]
      | add p q hp hq => rw [map_add, map_add, hp, hq, map_add, map_add]
      | mul_X p i hp =>
        rw [map_mul, map_mul, hp, hπ₀X, map_zero, map_mul, map_mul, hXi i]
    let e₀ : R ⧸ Ideal.span {g} ≃+* (MvPolynomial (Fin 2) R ⧸ J0) ⧸ K :=
      RingEquiv.ofRingHom ψ θ' (RingHom.ext hψθ) (RingHom.ext hθψ)
    have hKmap : K.map f = Ideal.span {f (Ideal.Quotient.mk J0 (MvPolynomial.X 0)),
        f (Ideal.Quotient.mk J0 (MvPolynomial.X 1))} := by
      rw [hK, Ideal.map_span, Set.image_pair]
    have hq := c3a _ B f hf K
    refine ⟨(Ideal.quotEquivOfEq hKmap).toRingHom.comp
      ((Ideal.quotientMap (K.map f) f Ideal.le_comap_map).comp e₀.toRingHom), ?_, ?_⟩
    · exact RingHom.Etale.respectsIso.1 _ _ (RingHom.Etale.respectsIso.2 _ e₀ hq)
    · intro w
      show Ideal.quotEquivOfEq hKmap
        (Ideal.quotientMap (K.map f) f Ideal.le_comap_map (ψ (Ideal.Quotient.mk _ w))) = _
      rw [hψmk, Ideal.quotientMap_mk, Ideal.quotEquivOfEq_mk]

  have c4 : ∀ (R : Type u) [CommRing R] [IsLocalRing R], IsAlgClosed (IsLocalRing.ResidueField R) →
      ∀ (A : Type u) [CommRing A] [Algebra R A] (𝔭 : Ideal A), Algebra.FiniteType R A →
      𝔭.IsMaximal → (IsLocalRing.maximalIdeal R).map (algebraMap R A) ≤ 𝔭 →
      ∃ ρ : A →+* IsLocalRing.ResidueField R,
        (∀ r : R, ρ (algebraMap R A r) = IsLocalRing.residue R r) ∧ ∀ a : A, ρ a = 0 ↔ a ∈ 𝔭 := by
    intro R _ _ hac A _ _ 𝔭 hFT hmax hm
    haveI := hac
    letI : Field (A ⧸ 𝔭) := Ideal.Quotient.field 𝔭
    have H : ∀ x ∈ IsLocalRing.maximalIdeal R, (Ideal.Quotient.mk 𝔭).comp (algebraMap R A) x = 0 := by
      intro x hx
      rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
      exact hm (Ideal.mem_map_of_mem _ hx)
    let φ : IsLocalRing.ResidueField R →+* A ⧸ 𝔭 := Ideal.Quotient.lift _ _ H
    have hφ : ∀ r : R, φ (IsLocalRing.residue R r) = Ideal.Quotient.mk 𝔭 (algebraMap R A r) :=
      fun r => Ideal.Quotient.lift_mk _ _ H
    letI : Algebra (IsLocalRing.ResidueField R) (A ⧸ 𝔭) := φ.toAlgebra
    haveI : IsScalarTower R (IsLocalRing.ResidueField R) (A ⧸ 𝔭) :=
      IsScalarTower.of_algebraMap_eq (fun r => by
        show Ideal.Quotient.mk 𝔭 (algebraMap R A r) = φ (algebraMap R (IsLocalRing.ResidueField R) r)
        rw [IsLocalRing.ResidueField.algebraMap_eq, hφ])
    haveI : Algebra.FiniteType R (A ⧸ 𝔭) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ R 𝔭) (Ideal.Quotient.mkₐ_surjective R 𝔭)
    haveI : Algebra.FiniteType (IsLocalRing.ResidueField R) (A ⧸ 𝔭) :=
      Algebra.FiniteType.of_restrictScalars_finiteType R _ _
    haveI : Module.Finite (IsLocalRing.ResidueField R) (A ⧸ 𝔭) :=
      finite_of_finite_type_of_isJacobsonRing _ _
    haveI : Algebra.IsIntegral (IsLocalRing.ResidueField R) (A ⧸ 𝔭) := Algebra.IsIntegral.of_finite _ _
    have hbij : Function.Bijective (algebraMap (IsLocalRing.ResidueField R) (A ⧸ 𝔭)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let e := RingEquiv.ofBijective φ hbij
    refine ⟨e.symm.toRingHom.comp (Ideal.Quotient.mk 𝔭), fun r => ?_, fun a => ?_⟩
    · show e.symm (Ideal.Quotient.mk 𝔭 (algebraMap R A r)) = _
      rw [RingEquiv.symm_apply_eq]
      show _ = φ (IsLocalRing.residue R r)
      rw [hφ]
    · show e.symm (Ideal.Quotient.mk 𝔭 a) = 0 ↔ a ∈ 𝔭
      rw [map_eq_zero_iff _ e.symm.injective, Ideal.Quotient.eq_zero_iff_mem]

  have c5 : ∀ (R : Type u) [CommRing R] (E : Type u) [CommRing E] [Algebra R E] [Algebra.Etale R E]
      (τ : E →ₐ[R] R), ∃ r : E, τ r = 1 ∧ ∀ x : E, r * (x - algebraMap R E (τ x)) = 0 := by
    intro R _ E _ _ _ τ
    set J : Ideal E := RingHom.ker τ.toRingHom with hJ
    have ha : ∀ x : E, x - algebraMap R E (τ x) ∈ J := by
      intro x
      rw [hJ, RingHom.mem_ker]
      show τ (x - algebraMap R E (τ x)) = 0
      rw [map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self]
    have hle : J ≤ J ^ 2 := by
      have hI2 : (J.map (Ideal.Quotient.mk (J ^ 2))) ^ 2 = ⊥ := by
        rw [← Ideal.map_pow, Ideal.map_quotient_self]
      have hnil : IsNilpotent (J.map (Ideal.Quotient.mk (J ^ 2))) := ⟨2, by rw [hI2]; rfl⟩
      let g₁ : E →ₐ[R] E ⧸ J ^ 2 := Ideal.Quotient.mkₐ R (J ^ 2)
      let g₂ : E →ₐ[R] E ⧸ J ^ 2 := (Algebra.ofId R (E ⧸ J ^ 2)).comp τ
      have e₂ : ∀ x, g₂ x = Ideal.Quotient.mk (J ^ 2) (algebraMap R E (τ x)) := by
        intro x
        show algebraMap R (E ⧸ J ^ 2) (τ x) = _
        rw [IsScalarTower.algebraMap_apply R E (E ⧸ J ^ 2), Ideal.Quotient.algebraMap_eq]
      have hg : g₁ = g₂ := by
        apply Algebra.FormallyUnramified.ext _ hnil
        intro x
        rw [Ideal.Quotient.eq, e₂]
        show Ideal.Quotient.mk (J ^ 2) x - Ideal.Quotient.mk (J ^ 2) (algebraMap R E (τ x)) ∈ _
        rw [← map_sub]
        exact Ideal.mem_map_of_mem _ (ha x)
      intro x hx
      have h2 : τ x = 0 := hx
      have h1 : g₁ x = g₂ x := by rw [hg]
      rw [e₂, h2, map_zero, map_zero] at h1
      exact Ideal.Quotient.eq_zero_iff_mem.mp h1
    have hsurj : Function.Surjective τ := fun r => ⟨algebraMap R E r, by
      rw [AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]⟩
    have hfg : J.FG := Algebra.FinitePresentation.ker_fG_of_surjective τ hsurj
    have hle' : J ≤ J • J := by
      rw [Ideal.smul_eq_mul, ← pow_two]
      exact hle
    obtain ⟨r, hr1, hr⟩ :=
      Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul J J hfg hle'
    refine ⟨r, ?_, fun x => ?_⟩
    · have h0 : τ (r - 1) = 0 := hr1
      rw [map_sub, map_one, sub_eq_zero] at h0
      exact h0
    · exact hr _ (ha x)

  have c6 : ∀ (A : Type u) [CommRing A] [IsDomain A] (𝔭 : Ideal A) [𝔭.IsPrime] (h : A), h ∉ 𝔭 →
      ∀ (r y₁ y₂ : Localization.Away h) (a u v : A),
      r ∉ 𝔭.map (algebraMap A (Localization.Away h)) →
      r * algebraMap A (Localization.Away h) a = algebraMap A (Localization.Away h) u * y₁ +
        algebraMap A (Localization.Away h) v * y₂ →
      ∃ s a₁ b₁ : A, s ∉ 𝔭 ∧ s * a = u * a₁ + v * b₁ := by
    intro A _ _ 𝔭 _ h hh r y₁ y₂ a u v hr hEq
    have hh0 : h ≠ 0 := fun h0 => hh (h0 ▸ 𝔭.zero_mem)
    have hinj : Function.Injective (algebraMap A (Localization.Away h)) :=
      IsLocalization.injective (Localization.Away h) (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
    obtain ⟨i, r₀, hr₀⟩ := IsLocalization.Away.surj h r
    obtain ⟨j, p, hp⟩ := IsLocalization.Away.surj h y₁
    obtain ⟨k, q, hq⟩ := IsLocalization.Away.surj h y₂
    have key : algebraMap A (Localization.Away h) (r₀ * h ^ (j + k) * a) =
        algebraMap A (Localization.Away h) (u * (p * h ^ (i + k)) + v * (q * h ^ (i + j))) := by
      simp only [map_mul, map_pow, map_add, pow_add]
      rw [← hr₀, ← hp, ← hq]
      linear_combination (algebraMap A (Localization.Away h) h ^ i *
        algebraMap A (Localization.Away h) h ^ j * algebraMap A (Localization.Away h) h ^ k) * hEq
    have hdisj : Disjoint (Submonoid.powers h : Set A) 𝔭 := by
      rw [Set.disjoint_left]
      rintro x ⟨n, rfl⟩ hx
      exact hh (Ideal.IsPrime.mem_of_pow_mem ‹_› n hx)
    have hhn : ∀ n : ℕ, h ^ n ∉ 𝔭 := fun n hn => hh (Ideal.IsPrime.mem_of_pow_mem ‹_› n hn)
    have hQp : (𝔭.map (algebraMap A (Localization.Away h))).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) _ 𝔭 ‹_› hdisj
    have hQc : (𝔭.map (algebraMap A (Localization.Away h))).comap
        (algebraMap A (Localization.Away h)) = 𝔭 :=
      IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers h) _ ‹_› hdisj
    refine ⟨r₀ * h ^ (j + k), p * h ^ (i + k), q * h ^ (i + j), ?_, hinj key⟩
    intro hm
    rcases Ideal.IsPrime.mem_or_mem ‹_› hm with h1 | h1
    · have h2 : algebraMap A (Localization.Away h) r₀ ∈ 𝔭.map (algebraMap A (Localization.Away h)) :=
        Ideal.mem_map_of_mem _ h1
      rw [← hr₀] at h2
      rcases hQp.mem_or_mem h2 with h3 | h3
      · exact hr h3
      · rw [← map_pow, ← Ideal.mem_comap, hQc] at h3
        exact hhn i h3
    · exact hhn (j + k) h1

  intro Ω _ _ W A _ _ _ 𝔭 u v g hPD a
  unfold wcLlsPD at hPD
  obtain ⟨hFT, _, _, hmax, hm𝔭, hgm, _, _, h𝔭eq, h, hh, f, hfC, hfX0, hfX1, hfet⟩ := hPD
  haveI hpr : 𝔭.IsPrime := hmax.isPrime
  have hu : u ∈ 𝔭 := by
    rw [h𝔭eq]; exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
  have hv : v ∈ 𝔭 := by
    rw [h𝔭eq]; exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
  have hIg : Ideal.span {g} ≠ ⊤ := by
    rw [Ne, Ideal.span_singleton_eq_top]
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal g).mp hgm)
  haveI hWH : HenselianLocalRing ↥W := wcpa_dj_lmga_valuation_henselian Ω W
  haveI hR : HenselianLocalRing (↥W ⧸ Ideal.span {g}) := c1 ↥W _ hIg
  set J : Ideal (Localization.Away h) := Ideal.span {f (Ideal.Quotient.mk _ (MvPolynomial.X 0)),
    f (Ideal.Quotient.mk _ (MvPolynomial.X 1))} with hJdef
  obtain ⟨φ, hφet, hφ⟩ := c3 ↥W g (Localization.Away h) f hfet
  letI : Algebra (↥W ⧸ Ideal.span {g}) (Localization.Away h ⧸ J) := φ.toAlgebra
  haveI : Algebra.Etale (↥W ⧸ Ideal.span {g}) (Localization.Away h ⧸ J) := hφet
  have hEw : ∀ w : ↥W, algebraMap (↥W ⧸ Ideal.span {g}) (Localization.Away h ⧸ J)
      (Ideal.Quotient.mk _ w) =
      Ideal.Quotient.mk J (algebraMap A (Localization.Away h) (algebraMap ↥W A w)) := by
    intro w
    rw [RingHom.algebraMap_toAlgebra, hφ]
    have := RingHom.congr_fun hfC w
    simp only [RingHom.comp_apply] at this
    rw [this]

  haveI hκ : IsAlgClosed (IsLocalRing.ResidueField ↥W) := wcpa_dj_nc_residue_algclosed Ω W
  obtain ⟨ρ, hρW, hρ0⟩ := c4 ↥W hκ A 𝔭 hFT hmax hm𝔭
  have hθk : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      ((IsLocalRing.residue (↥W ⧸ Ideal.span {g})).comp
        (Ideal.Quotient.mk (Ideal.span {g}))) w = 0 := by
    intro w hw
    rw [RingHom.comp_apply, IsLocalRing.residue_eq_zero_iff]
    exact KF ↥W (Ideal.span {g}) hIg w hw
  let θ : IsLocalRing.ResidueField ↥W →+* IsLocalRing.ResidueField (↥W ⧸ Ideal.span {g}) :=
    Ideal.Quotient.lift _ _ hθk
  have hθ : ∀ w : ↥W, θ (IsLocalRing.residue ↥W w) =
      IsLocalRing.residue _ (Ideal.Quotient.mk (Ideal.span {g}) w) :=
    fun w => Ideal.Quotient.lift_mk _ _ hθk
  have hρh : IsUnit (ρ h) := isUnit_iff_ne_zero.mpr (fun h0 => hh ((hρ0 h).mp h0))
  let ρh : Localization.Away h →+* IsLocalRing.ResidueField ↥W := IsLocalization.Away.lift h hρh
  have hρhA : ∀ a, ρh (algebraMap A (Localization.Away h) a) = ρ a :=
    fun a => IsLocalization.Away.lift_eq h hρh a
  have hJ0 : ∀ z ∈ J, ρh z = 0 := by
    intro z hz
    rw [hJdef, hfX0, hfX1] at hz
    obtain ⟨c₁, c₂, rfl⟩ := Ideal.mem_span_pair.mp hz
    rw [map_add, map_mul, map_mul, hρhA, hρhA, (hρ0 u).mpr hu, (hρ0 v).mpr hv, mul_zero, mul_zero,
      add_zero]
  let σ₀ : (Localization.Away h ⧸ J) →ₐ[↥W ⧸ Ideal.span {g}]
      IsLocalRing.ResidueField (↥W ⧸ Ideal.span {g}) :=
    { θ.comp (Ideal.Quotient.lift J ρh hJ0) with
      commutes' := fun x => by
        obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective x
        show θ (Ideal.Quotient.lift J ρh hJ0 (algebraMap (↥W ⧸ Ideal.span {g})
            (Localization.Away h ⧸ J) (Ideal.Quotient.mk _ w))) =
          algebraMap (↥W ⧸ Ideal.span {g}) (IsLocalRing.ResidueField (↥W ⧸ Ideal.span {g}))
            (Ideal.Quotient.mk _ w)
        rw [hEw, Ideal.Quotient.lift_mk, hρhA, hρW, hθ, IsLocalRing.ResidueField.algebraMap_eq] }

  obtain ⟨τ, hτ⟩ := wc_hnas_smooth_section_henselian (↥W ⧸ Ideal.span {g})
    (Localization.Away h ⧸ J) σ₀

  obtain ⟨r, hr1, hr⟩ := c5 (↥W ⧸ Ideal.span {g}) (Localization.Away h ⧸ J) τ
  obtain ⟨r', rfl⟩ := Ideal.Quotient.mk_surjective r
  have hker : 𝔭.map (algebraMap A (Localization.Away h)) ≤ RingHom.ker ρh := by
    rw [Ideal.map_le_iff_le_comap]
    intro p hp
    rw [Ideal.mem_comap, RingHom.mem_ker, hρhA]
    exact (hρ0 p).mpr hp
  have hr'𝔭 : r' ∉ 𝔭.map (algebraMap A (Localization.Away h)) := by
    intro hm
    have h1 : ρh r' = 0 := hker hm
    have h2 : σ₀ (Ideal.Quotient.mk J r') = θ (ρh r') := rfl
    rw [← hτ, hr1, map_one, h1, map_zero] at h2
    exact one_ne_zero h2

  obtain ⟨γ, hγ⟩ := Ideal.Quotient.mk_surjective
    (τ (Ideal.Quotient.mk J (algebraMap A (Localization.Away h) a)))
  have h1 := hr (Ideal.Quotient.mk J (algebraMap A (Localization.Away h) a))
  rw [← hγ, hEw γ, ← map_sub, ← map_mul, Ideal.Quotient.eq_zero_iff_mem, ← map_sub, hJdef, hfX0,
    hfX1] at h1
  obtain ⟨c₁, c₂, hc⟩ := Ideal.mem_span_pair.mp h1
  obtain ⟨s, a₁, b₁, hs, heq⟩ := c6 A 𝔭 h hh r' c₁ c₂ (a - algebraMap ↥W A γ) u v hr'𝔭
    (by rw [← hc]; ring)
  exact ⟨γ, s, a₁, b₁, hs, heq⟩

