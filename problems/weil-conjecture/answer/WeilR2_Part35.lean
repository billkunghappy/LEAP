    have hmem : wcLlsInnerS₂ W A K u c₂ ∈ wcLlsInnerCR W A K u c₁ c₂ := by
      unfold wcLlsInnerCR
      exact Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
    exact ⟨⟨_, hmem⟩, rfl⟩

  have hroot : ∀ x : ↥W, ∀ M : ℕ, 0 < M → ∃ y : ↥W, y ^ M = x ∧
      (x ∈ IsLocalRing.maximalIdeal ↥W → y ∈ IsLocalRing.maximalIdeal ↥W) ∧ (x ≠ 0 → y ≠ 0) := by
    intro x M hM
    obtain ⟨y₀, hy₀⟩ := IsAlgClosed.exists_pow_nat_eq (x : Ω) hM
    have hy₀W : y₀ ∈ W := by
      rcases W.mem_or_inv_mem y₀ with h1 | h1
      · exact h1
      · by_cases hy0 : y₀ = 0
        · rw [hy0]; exact W.toSubring.zero_mem
        · obtain ⟨M', rfl⟩ : ∃ M', M = M' + 1 := ⟨M - 1, by omega⟩
          have e : y₀ = (x : Ω) * (y₀⁻¹) ^ M' := by
            rw [← hy₀, pow_succ, mul_comm (y₀ ^ M') y₀, mul_assoc, ← mul_pow,
              mul_inv_cancel₀ hy0, one_pow, mul_one]
          rw [e]
          exact W.toSubring.mul_mem x.2 (W.toSubring.pow_mem h1 _)
    refine ⟨⟨y₀, hy₀W⟩, ?_, ?_, ?_⟩
    · apply Subtype.ext
      rw [SubmonoidClass.coe_pow]
      exact hy₀
    · intro hx
      have hyx : (⟨y₀, hy₀W⟩ : ↥W) ^ M = x := Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hy₀)
      rw [← hyx] at hx
      exact Ideal.IsPrime.mem_of_pow_mem inferInstance M hx
    · intro hx hy
      apply hx
      have hyx : (⟨y₀, hy₀W⟩ : ↥W) ^ M = x := Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hy₀)
      rw [← hyx, hy, zero_pow hM.ne']

  have hmin2 : ∀ a b : ↥W, a ∈ IsLocalRing.maximalIdeal ↥W → a ≠ 0 →
      b ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ z : ↥W, z ∈ IsLocalRing.maximalIdeal ↥W ∧ z ≠ 0 ∧ z ∣ a ∧ z ∣ b := by
    intro a b ha ha0 hb
    by_cases hb0 : b = 0
    · exact ⟨a, ha, ha0, dvd_rfl, by rw [hb0]; exact dvd_zero a⟩
    · rcases ValuationRing.dvd_total a b with h1 | h1
      · exact ⟨a, ha, ha0, dvd_rfl, h1⟩
      · exact ⟨b, hb, hb0, h1, dvd_rfl⟩
  have hpick : ∀ w ρ : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → ρ ∈ IsLocalRing.maximalIdeal ↥W →
      ∀ M : ℕ, 0 < M → ∃ t : ↥W, t ∈ IsLocalRing.maximalIdeal ↥W ∧ t ≠ 0 ∧ t ^ M ∣ g ∧
        t ^ M ∣ w ∧ t ∣ ρ := by
    intro w ρ hw hρ M hM
    obtain ⟨z₁, hz₁m, hz₁0, hz₁g, hz₁w⟩ := hmin2 g w hgm hg0 hw
    obtain ⟨z, hzm, hz0, hzz₁, hzρ⟩ := hmin2 z₁ ρ hz₁m hz₁0 hρ
    obtain ⟨t, htM, htm, ht0⟩ := hroot z M hM
    refine ⟨t, htm hzm, ht0 hz0, ?_, ?_, ?_⟩
    · rw [htM]; exact dvd_trans hzz₁ hz₁g
    · rw [htM]; exact dvd_trans hzz₁ hz₁w
    · exact dvd_trans (dvd_pow_self t hM.ne') (by rw [htM]; exact hzρ)

  have hbr : ∀ c₁ c₂ : ↥W, c₁ ≠ 0 →
      c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
      ∀ (j : ℕ) (ε r g' : A) (w : ↥W), ε ∉ 𝔭 → c₂ ^ (j + 1) ∣ g → c₂ ^ (j + 1) ∣ w →
      ∃ P : ↥(wcLlsInnerCR W A K u c₁ c₂), P ∉ wcLlsInnerCN W A K u c₁ c₂ ∧
        algebraMap A K (u ^ j * ε + v * r + algebraMap ↥W A w * g') =
          algebraMap A K u ^ j * (P : K) := by
    intro c₁ c₂ hc₁0 hc₂m hc₂0 h12 h21 h2g j ε r g' w hε hjg hjw
    obtain ⟨g'', hg''⟩ := hjg
    obtain ⟨w'', hw''⟩ := hjw
    obtain ⟨S2, hS2⟩ := hS2ex c₁ c₂
    have hS2N : S2 ∈ wcLlsInnerCN W A K u c₁ c₂ := by
      unfold wcLlsInnerCN
      exact Ideal.mem_sup_left (Ideal.subset_span
        (Set.mem_insert_of_mem _ (Set.mem_singleton_iff.mpr (Subtype.ext hS2))))
    have h𝔪N : ∀ x ∈ IsLocalRing.maximalIdeal ↥W,
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A x) ∈
          wcLlsInnerCN W A K u c₁ c₂ := by
      intro x hx
      unfold wcLlsInnerCN
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hx)
    have hXN : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A g'' * r) * S2 ^ (j + 1) +
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A (c₂ * w'')) *
          algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) g' * S2 ^ j ∈ wcLlsInnerCN W A K u c₁ c₂ :=
      Ideal.add_mem _ (Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hS2N _ (Nat.succ_pos j)))
        (Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _
          (h𝔪N _ (Ideal.mul_mem_right _ _ hc₂m))))
    refine ⟨_, hIU c₁ c₂ hc₁0 hc₂m hc₂0 h12 h21 h2g ε hε _ hXN, ?_⟩
    have hco : ((algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) ε +
        (algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A g'' * r) * S2 ^ (j + 1) +
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A (c₂ * w'')) *
          algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) g' * S2 ^ j) :
          ↥(wcLlsInnerCR W A K u c₁ c₂)) : K) =
        algebraMap A K ε + (algebraMap A K (algebraMap ↥W A g'' * r) * (S2 : K) ^ (j + 1) +
          algebraMap A K (algebraMap ↥W A (c₂ * w'')) * algebraMap A K g' * (S2 : K) ^ j) := rfl
    rw [hco, hS2]
    have hv : algebraMap A K v = wcLlsInnerS₂ W A K u c₂ ^ (j + 1) * algebraMap A K u ^ j *
        algebraMap A K (algebraMap ↥W A g'') := by
      apply mul_left_cancel₀ hU0
      have e1 : algebraMap A K u * algebraMap A K v =
          algebraMap A K (algebraMap ↥W A c₂) ^ (j + 1) * algebraMap A K (algebraMap ↥W A g'') := by
        rw [← map_mul, huv, hg'']
        simp only [map_mul, map_pow]
      rw [e1, ← hσ c₂]
      ring
    simp only [map_add, map_mul, map_pow]
    rw [hv, hw'']
    simp only [map_mul, map_pow]
    rw [← hσ c₂]
    ring

  obtain ⟨h, c, w, n, k, ε₀, ε₁, r₀, r₁, g₀, g₁, hh0, hc0, hwm, hε₀, hε₁, hcase⟩ :=
    wcpa_dj_llsm_kpwul_boundary_form Ω W hW hWt ℓ hℓ hΩ hκ A K 𝔭 u v g hPD f' a s ha hs hf
  have hPP : ∀ t : ↥W, t ^ (n + k + 1) ∣ g → t ^ (n + k + 1) ∣ w →
      ∀ c₁ c₂ : ↥W, c₁ ≠ 0 →
      c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ t →
      ∃ Pn Pk : ↥(wcLlsInnerCR W A K u c₁ c₂), Pn ∉ wcLlsInnerCN W A K u c₁ c₂ ∧
        Pk ∉ wcLlsInnerCN W A K u c₁ c₂ ∧
        algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) =
          algebraMap A K u ^ n * (Pn : K) ∧
        algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀) =
          algebraMap A K u ^ k * (Pk : K) := by
    intro t htg htw c₁ c₂ hc₁0 hc₂m hc₂0 h12 h21 h2t
    have hdj : ∀ j, j ≤ n + k → c₂ ^ (j + 1) ∣ t ^ (n + k + 1) := fun j hj =>
      dvd_trans (pow_dvd_pow_of_dvd h2t _) (pow_dvd_pow t (by omega))
    have h2g : c₂ ∣ g := dvd_trans (dvd_trans h2t (dvd_pow_self t (by omega))) htg
    obtain ⟨Pn, hPn, hBn⟩ := hbr c₁ c₂ hc₁0 hc₂m hc₂0 h12 h21 h2g n ε₁ r₁ g₁ w hε₁
      (dvd_trans (hdj n (by omega)) htg) (dvd_trans (hdj n (by omega)) htw)
    obtain ⟨Pk, hPk, hBk⟩ := hbr c₁ c₂ hc₁0 hc₂m hc₂0 h12 h21 h2g k ε₀ r₀ g₀ w hε₀
      (dvd_trans (hdj k (by omega)) htg) (dvd_trans (hdj k (by omega)) htw)
    exact ⟨Pn, Pk, hPn, hPk, hBn, hBk⟩
  rcases hcase with ⟨τ, hcℓ, hτ, hEq⟩ | ⟨κ, hκℓ, hndvd, hκm, hcm, hEq⟩
  ·
    have hD1le : n ≤ k → ∃ t : ↥W, t ∈ IsLocalRing.maximalIdeal ↥W ∧ t ≠ 0 ∧ t ∣ g ∧
      ∀ c₁ c₂ : ↥W, c₁ ≠ 0 →
      c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ t →
      ∃ (h : K) (c : ↥W), h ≠ 0 ∧ c ≠ 0 ∧
        ((∃ η : ↥W, IsUnit η ∧ c ^ (ℓ - 1) * η = ((ℓ : ℕ) : ↥W) ∧
            ∃ d e : ↥(wcLlsInnerCR W A K u c₁ c₂), d ∉ wcLlsInnerCN W A K u c₁ c₂ ∧
              (d : K) * (f' / h ^ ℓ - 1) = algebraMap A K (algebraMap ↥W A c) ^ ℓ * (e : K)) ∨
          (∃ (m : ℤ) (d e : ↥(wcLlsInnerCR W A K u c₁ c₂)), ¬ (ℓ : ℤ) ∣ m ∧
            d ∉ wcLlsInnerCN W A K u c₁ c₂ ∧ e ∉ wcLlsInnerCN W A K u c₁ c₂ ∧
            (0 < m → ∃ q ∈ IsLocalRing.maximalIdeal ↥W,
              ((ℓ : ℕ) : ↥W) ^ ℓ = c ^ (ℓ * (ℓ - 1)) * c₁ ^ ((ℓ - 1) * m.toNat) * q) ∧
            (0 < m → ∃ ρ : ↥W,
              c ^ (ℓ * (ℓ - 1)) * c₂ ^ ((ℓ - 1) * m.toNat) * ρ = ((ℓ : ℕ) : ↥W) ^ ℓ) ∧
            (m < 0 → ∃ q ∈ IsLocalRing.maximalIdeal ↥W, ∃ r : ↥W,
              ((ℓ : ℕ) : ↥W) ^ ℓ * c₂ ^ ((ℓ - 1) * (-m).toNat) = c ^ (ℓ * (ℓ - 1)) * q ∧
              c ^ ℓ = c₂ ^ ((-m).toNat) * r) ∧
            (m < 0 → ∃ ρ : ↥W,
              c ^ (ℓ * (ℓ - 1)) * ρ = ((ℓ : ℕ) : ↥W) ^ ℓ * c₁ ^ ((ℓ - 1) * (-m).toNat)) ∧
            (d : K) * (f' / h ^ ℓ - 1) =
              algebraMap A K (algebraMap ↥W A c) ^ ℓ * algebraMap A K u ^ m * (e : K))) := by
      intro hnk
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hnk
      obtain ⟨t, htm, ht0, htg, htw, -⟩ :=
        hpick w 0 hwm (Ideal.zero_mem _) (n + (n + d) + 1) (by omega)
      refine ⟨t, htm, ht0, dvd_trans (dvd_pow_self t (by omega)) htg, ?_⟩
      intro c₁ c₂ hc₁0 hc₂m hc₂0 h12 h21 h2t
      obtain ⟨Pn, Pk, hPn, hPk, hBn, hBk⟩ :=
        hPP t htg htw c₁ c₂ hc₁0 hc₂m hc₂0 h12 h21 h2t
      have e := hEq
      rw [hBn, hBk] at e
      refine ⟨h, c, hh0, hc0, Or.inl ⟨1, isUnit_one, by rw [mul_one]; exact hcℓ, Pn,
        algebraMap A _ (algebraMap ↥W A τ * u ^ d) * Pk, hPn, ?_⟩⟩
      have hco : ((algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A τ * u ^ d) * Pk :
          ↥(wcLlsInnerCR W A K u c₁ c₂)) : K) =
          algebraMap A K (algebraMap ↥W A τ * u ^ d) * (Pk : K) := rfl
      rw [hco]
      apply mul_left_cancel₀ (pow_ne_zero n hU0)
      simp only [map_mul, map_pow]
      linear_combination e
    rcases hτ with hnk | hτm
    · exact hD1le hnk
    by_cases hnk : n ≤ k
    · exact hD1le hnk
    push_neg at hnk
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_lt hnk
    obtain ⟨ρ, hρd, hρm, -⟩ := hroot τ (d + 1) (by omega)
    obtain ⟨t, htm, ht0, htg, htw, htρ⟩ :=
      hpick w ρ hwm (hρm hτm) (k + d + 1 + k + 1) (by omega)
    refine ⟨t, htm, ht0, dvd_trans (dvd_pow_self t (by omega)) htg, ?_⟩
    intro c₁ c₂ hc₁0 hc₂m hc₂0 h12 h21 h2t
    obtain ⟨Pn, Pk, hPn, hPk, hBn, hBk⟩ :=
      hPP t htg htw c₁ c₂ hc₁0 hc₂m hc₂0 h12 h21 h2t
    obtain ⟨x, hx⟩ := dvd_trans h2t htρ
    obtain ⟨S2, hS2⟩ := hS2ex c₁ c₂
    have e := hEq
    rw [hBn, hBk] at e
    have hτ' : algebraMap A K (algebraMap ↥W A τ) =
        algebraMap A K (algebraMap ↥W A c₂) ^ (d + 1) * algebraMap A K (algebraMap ↥W A x) ^ (d + 1) := by
      rw [← hρd, hx]
      simp only [map_mul, map_pow, mul_pow]
    rw [hτ', ← hσ c₂] at e
    refine ⟨h, c, hh0, hc0, Or.inl ⟨1, isUnit_one, by rw [mul_one]; exact hcℓ, Pn,
      algebraMap A _ (algebraMap ↥W A (x ^ (d + 1))) * S2 ^ (d + 1) * Pk, hPn, ?_⟩⟩
    have hco : ((algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A (x ^ (d + 1))) *
        S2 ^ (d + 1) * Pk : ↥(wcLlsInnerCR W A K u c₁ c₂)) : K) =
        algebraMap A K (algebraMap ↥W A (x ^ (d + 1))) * (S2 : K) ^ (d + 1) * (Pk : K) := rfl
    rw [hco, hS2]
    apply mul_left_cancel₀ (pow_ne_zero (k + d + 1) hU0)
    simp only [map_pow]
    linear_combination e
  ·
    rcases lt_trichotomy n k with hlt | heq | hgt
    · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_lt hlt
      have hκm' := hκm hlt
      obtain ⟨ρ, hρe, hρm, -⟩ := hroot κ ((ℓ - 1) * (d + 1) + 1) (by omega)
      obtain ⟨t, htm, ht0, htg, htw, htρ⟩ :=
        hpick w ρ hwm (hρm hκm') (n + (n + d + 1) + 1) (by omega)
      refine ⟨t, htm, ht0, dvd_trans (dvd_pow_self t (by omega)) htg, ?_⟩
      intro c₁ c₂ hc₁0 hc₂m hc₂0 h12 h21 h2t
      obtain ⟨Pn, Pk, hPn, hPk, hBn, hBk⟩ :=
        hPP t htg htw c₁ c₂ hc₁0 hc₂m hc₂0 h12 h21 h2t
      obtain ⟨x, hx⟩ := dvd_trans h2t htρ
      obtain ⟨y, hy⟩ := h12
      have e := hEq
      rw [hBn, hBk] at e
      have htn : (((n + d + 1 : ℕ) : ℤ) - (n : ℤ)).toNat = d + 1 := by omega
      refine ⟨h, c, hh0, hc0, Or.inr ⟨((n + d + 1 : ℕ) : ℤ) - (n : ℤ), Pn, Pk, hndvd, hPn, hPk,
        ?_, ?_, ?_, ?_, ?_⟩⟩
      · intro _
        refine ⟨(y * x) ^ ((ℓ - 1) * (d + 1)) * ρ, Ideal.mul_mem_left _ _ (hρm hκm'), ?_⟩
        rw [htn, hκℓ, ← hρe, hx, hy]
        ring
      · intro _
        refine ⟨x ^ ((ℓ - 1) * (d + 1)) * ρ, ?_⟩
        rw [htn, hκℓ, ← hρe, hx]
        ring
      · intro hm
        exfalso
        omega
      · intro hm
        exfalso
        omega
      · rw [show ((n + d + 1 : ℕ) : ℤ) - (n : ℤ) = ((d + 1 : ℕ) : ℤ) by push_cast; ring,
          zpow_natCast]
        apply mul_left_cancel₀ (pow_ne_zero n hU0)
        linear_combination e
    · exfalso
      apply hndvd
      rw [heq, sub_self]
      exact dvd_zero _
    · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_lt hgt
      have hcm' := hcm hgt
      have hcℓm : c ^ ℓ ∈ IsLocalRing.maximalIdeal ↥W := Ideal.pow_mem_of_mem _ hcm' ℓ hℓ.pos
      obtain ⟨ρ, hρd, hρm, -⟩ := hroot (c ^ ℓ) (d + 1) (by omega)
      obtain ⟨t, htm, ht0, htg, htw, htρ⟩ :=
        hpick w ρ hwm (hρm hcℓm) (k + d + 1 + k + 1) (by omega)
      refine ⟨t, htm, ht0, dvd_trans (dvd_pow_self t (by omega)) htg, ?_⟩
      intro c₁ c₂ hc₁0 hc₂m hc₂0 h12 h21 h2t
      obtain ⟨Pn, Pk, hPn, hPk, hBn, hBk⟩ :=
        hPP t htg htw c₁ c₂ hc₁0 hc₂m hc₂0 h12 h21 h2t
      obtain ⟨x, hx⟩ := dvd_trans h2t htρ
      have e := hEq
      rw [hBn, hBk] at e
      have htn : (-((k : ℤ) - ((k + d + 1 : ℕ) : ℤ))).toNat = d + 1 := by omega
      have hE1 : 0 < (ℓ - 1) * (d + 1) := Nat.mul_pos (by omega) (by omega)
      refine ⟨h, c, hh0, hc0, Or.inr ⟨(k : ℤ) - ((k + d + 1 : ℕ) : ℤ), Pn, Pk, hndvd, hPn, hPk,
        ?_, ?_, ?_, ?_, ?_⟩⟩
      · intro hm
        exfalso
        omega
      · intro hm
        exfalso
        omega
      · intro _
        rw [htn]
        refine ⟨κ * c₂ ^ ((ℓ - 1) * (d + 1)),
          Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hc₂m _ hE1), x ^ (d + 1), ?_, ?_⟩
        · rw [hκℓ]
          ring
        · rw [← hρd, hx, mul_pow]
      · intro _
        rw [htn]
        exact ⟨κ * c₁ ^ ((ℓ - 1) * (d + 1)), by rw [hκℓ]; ring⟩
      · rw [show (k : ℤ) - ((k + d + 1 : ℕ) : ℤ) = -((d + 1 : ℕ) : ℤ) by push_cast; ring,
          zpow_neg, zpow_natCast]
        apply mul_left_cancel₀ (pow_ne_zero (k + d + 1) hU0)
        have hinv : algebraMap A K u ^ (d + 1) * (algebraMap A K u ^ (d + 1))⁻¹ = 1 :=
          mul_inv_cancel₀ (pow_ne_zero _ hU0)
        linear_combination e - (algebraMap A K (algebraMap ↥W A c) ^ ℓ * algebraMap A K u ^ k *
          (Pk : K)) * hinv

theorem wcpa_dj_llsm_kpwug_swap_gam : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (ℓ : ℕ), ℓ.Prime →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ (f' : K) (c₁ c₂ c₁' c₂' : ↥W), c₁ ≠ 0 → c₂ ≠ 0 → g = c₂ * c₁' → g = c₁ * c₂' →
    (∃ (h : K) (c : ↥W), h ≠ 0 ∧ c ≠ 0 ∧
  ((∃ η : ↥W, IsUnit η ∧ c ^ (ℓ - 1) * η = ((ℓ : ℕ) : ↥W) ∧
      ∃ d e : ↥(wcLlsInnerCR W A K v c₁' c₂'), d ∉ wcLlsInnerCN W A K v c₁' c₂' ∧
        (d : K) * (f' / h ^ ℓ - 1) = algebraMap A K (algebraMap ↥W A c) ^ ℓ * (e : K)) ∨
    (∃ (m : ℤ) (d e : ↥(wcLlsInnerCR W A K v c₁' c₂')), ¬ (ℓ : ℤ) ∣ m ∧
      d ∉ wcLlsInnerCN W A K v c₁' c₂' ∧ e ∉ wcLlsInnerCN W A K v c₁' c₂' ∧
      (0 < m → ∃ q ∈ IsLocalRing.maximalIdeal ↥W,
        ((ℓ : ℕ) : ↥W) ^ ℓ = c ^ (ℓ * (ℓ - 1)) * q) ∧
      (0 < m → ∃ ρ : ↥W,
        c ^ (ℓ * (ℓ - 1)) * c₂' ^ ((ℓ - 1) * m.toNat) * ρ =
