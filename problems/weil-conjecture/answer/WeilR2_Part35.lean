    have hHGen : ∀ (D : Type u) [CommRing D] (φ : D →+* D) (t₁ t₂ : D) (c : ℕ → D),
        (∀ i, φ (c i) = c i) → φ t₁ * t₂ = t₁ * φ t₂ → ∀ N : ℕ,
        φ (∑ i ∈ Finset.range (N + 1), c i * t₁ ^ i * t₂ ^ (N - i)) * t₂ ^ N =
          (∑ i ∈ Finset.range (N + 1), c i * t₁ ^ i * t₂ ^ (N - i)) * φ t₂ ^ N := by
      intro D _ φ t₁ t₂ c hc hstar N
      rw [map_sum, Finset.sum_mul, Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro i hi
      have hiN : i ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hiN
      rw [Nat.add_sub_cancel_left, map_mul, map_mul, map_pow, map_pow, hc, pow_add, pow_add]
      have h9 : (φ t₁ * t₂) ^ i = (t₁ * φ t₂) ^ i := by rw [hstar]
      rw [mul_pow, mul_pow] at h9
      linear_combination (c i * φ t₂ ^ k * t₂ ^ k) * h9

    have hfixGen : ∀ (D : Type u) [CommRing D] [IsDomain D] (φ : D →+* D) (X Dd Pp t₂ : D) (N : ℕ),
        Dd ≠ 0 → φ t₂ ≠ 0 → X * Dd = Pp → φ Dd * t₂ ^ N = Dd * φ t₂ ^ N →
        φ Pp * t₂ ^ N = Pp * φ t₂ ^ N → φ X = X := by
      intro D _ _ φ X Dd Pp t₂ N hDd hφt₂ hx hd hp
      have hφx : φ X * φ Dd = φ Pp := by rw [← map_mul, hx]
      have h10 : (φ X - X) * (Dd * φ t₂ ^ N) = 0 := by
        linear_combination t₂ ^ N * hφx - φ X * hd + hp - φ t₂ ^ N * hx
      exact sub_eq_zero.mp ((mul_eq_zero.mp h10).resolve_right (mul_ne_zero hDd (pow_ne_zero _ hφt₂)))

    have ht₁ : Ideal.Quotient.mk 𝔔 θ₁ ≠ 0 := fun h => hθ₁ (Ideal.Quotient.eq_zero_iff_mem.mp h)
    have ht₂ : Ideal.Quotient.mk 𝔔 θ₂ ≠ 0 := fun h => hθ₂ (Ideal.Quotient.eq_zero_iff_mem.mp h)
    have hφleft : ∀ z, (⇑φ)^[ℓ - 1] (φ z) = z := fun z => by
      rw [← Function.iterate_succ_apply, Nat.succ_eq_add_one, Nat.sub_add_cancel hℓ.one_lt.le, hφℓ]
    have hφt₂ : φ (Ideal.Quotient.mk 𝔔 θ₂) ≠ 0 :=
      (map_ne_zero_iff φ (Function.LeftInverse.injective hφleft)).mpr ht₂
    have hρ₂ : Ideal.Quotient.mk 𝔔 (algebraMap R ↥(integralClosure R L) r₂) ≠ 0 := by
      intro h
      apply hr₂
      rw [← hco, Ideal.mem_comap]
      exact Ideal.Quotient.eq_zero_iff_mem.mp h
    have h1 : Ideal.Quotient.mk 𝔔 (algebraMap R ↥(integralClosure R L) r₂) *
        Ideal.Quotient.mk 𝔔 θ₁ ^ n =
        Ideal.Quotient.mk 𝔔 (algebraMap R ↥(integralClosure R L) r₁) *
        Ideal.Quotient.mk 𝔔 θ₂ ^ n := by
      have := Ideal.Quotient.eq.mpr hrel
      simpa only [map_mul, map_pow] using this
    have hstar := hcoreGen _ φ ψ hφℓ hφψ n hn hroot _ _ _ _ ht₁ ht₂ hρ₂ (hφR r₁) (hφR r₂) h1
    have hfix : ∀ x, φ (Ideal.Quotient.mk 𝔔 x) = Ideal.Quotient.mk 𝔔 x := by
      intro x
      obtain ⟨N, p, d, hd, hx⟩ := hforms x
      have hxD := Ideal.Quotient.eq.mpr hx
      simp only [map_mul, map_sum, map_pow] at hxD
      have hdD : (∑ i ∈ Finset.range (N + 1),
          Ideal.Quotient.mk 𝔔 (algebraMap R ↥(integralClosure R L) (d i)) *
          Ideal.Quotient.mk 𝔔 θ₁ ^ i * Ideal.Quotient.mk 𝔔 θ₂ ^ (N - i)) ≠ 0 := by
        intro h
        apply hd
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        simpa only [map_mul, map_sum, map_pow] using h
      exact hfixGen _ φ _ _ _ _ N hdD hφt₂ hxD
        (hHGen _ φ _ _ (fun i => Ideal.Quotient.mk 𝔔 (algebraMap R ↥(integralClosure R L) (d i)))
          (fun i => hφR (d i)) hstar N)
        (hHGen _ φ _ _ (fun i => Ideal.Quotient.mk 𝔔 (algebraMap R ↥(integralClosure R L) (p i)))
          (fun i => hφR (p i)) hstar N)
    refine ⟨g, hg, fun x => ⟨σ x - x, ?_, ?_⟩⟩
    · rw [← Ideal.Quotient.eq, ← hφmk]
      exact hfix x
    · rw [Subalgebra.coe_sub, hσ]
  obtain ⟨𝔓, 𝔔, h𝔓, hm, hlt, h𝔔, hco, hU, hnR⟩ := hG
  obtain ⟨θ₁, θ₂, n, r₁, r₂, hn, hθ₁, hθ₂, hr₂, hrel, hforms⟩ :=
    wcLlsAS_gne_residue_radical Ω W hW hWt ℓ hℓ hchar A K L 𝔭 t y hPD hSolv hUniq hdeg
      c₀ b₀ c' b' e' hc₀ hb₀ hc' hb' hb₀0 hb'0 he' hnd hsep 𝔓 𝔔 h𝔓 hm hlt h𝔔 hco
  exact hnR (hAlg _ 𝔓 𝔔 ((algebraMap A _).comp (algebraMap ↥W A)) h𝔔 hco hU θ₁ θ₂ n r₁ r₂
    hn hθ₁ hθ₂ hr₂ hrel hforms)

theorem wcLlsASvm_hchain : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A) (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y → wcLlsBR W A K L 𝔭 (.disc t) → Module.finrank K L = ℓ → ∀ α : L, α ∉ Set.range (algebraMap K L) → α ^ ℓ - α ∈ Set.range (algebraMap K L) → (∀ c₀ b₀ : ↥W, c₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 → wcLlsDiscSep W A K L t c₀ b₀ → ∃ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W ∧ b' ∈ IsLocalRing.maximalIdeal ↥W ∧ b' ≠ 0 ∧ b₀ ∣ c' - c₀ ∧ wcLlsDiscSep W A K L t c' b' ∧ ¬ b' ∣ b₀) → ∃ c b : ℕ → ↥W, (∀ i, c i ∈ IsLocalRing.maximalIdeal ↥W ∧ b i ∈ IsLocalRing.maximalIdeal ↥W ∧ b i ≠ 0 ∧ wcLlsDiscSep W A K L t (c i) (b i) ∧ ¬ wcLlsGaussEtale W A K L t (c i) (b i) ∧ ∃ e' : ↥W, ¬ wcLlsInnerSmooth W A K L t (c i) (b i) e' ∧ ∀ e : ↥W, e - e' ∉ IsLocalRing.maximalIdeal ↥W → wcLlsInnerSmooth W A K L t (c i) (b i) e) ∧ (∀ i, b i ∣ c (i + 1) - c i) ∧ (∀ i, b i ∣ b (i + 1)) ∧ (∀ i, ¬ b (i + 1) ∣ b i) ∧ ∀ z : ↥W, ∃ i, ¬ b i ∣ z - c i :=
by
  intro Ω _ _ W hdim hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hSolv hUniq hBR hdeg
    α hα1 hα2 hneg
  classical

  have s2 : ∀ x y : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → y ≠ 0 → ∃ n : ℕ, y ∣ x ^ n := by
    intro x y hx hy
    have : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hdim
    have hrad : x ∈ (Ideal.span {y}).radical := by
      rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
      rintro J ⟨hJ, hJp⟩
      have hJ0 : J ≠ ⊥ := by
        intro h
        apply hy
        have : y ∈ J := hJ (Ideal.mem_span_singleton_self y)
        rw [h] at this
        exact (Submodule.mem_bot _).mp this
      have hmax := (Ring.krullDimLE_one_iff_of_isPrime_bot.mp inferInstance) J hJ0 hJp
      rw [IsLocalRing.eq_maximalIdeal hmax]
      exact hx
    obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp hrad
    exact ⟨n, Ideal.mem_span_singleton.mp hn⟩

  have s3 : ∃ τ : ℕ → ↥W, ∀ b q : ↥W, b ≠ 0 → q ∈ IsLocalRing.maximalIdeal ↥W → q ≠ 0 →
      ∃ j : ℕ, b ∣ τ j ∧ τ j ∣ b * q := by
    have hrad := s2
    by_cases hπ : ∃ π : ↥W, π ∈ IsLocalRing.maximalIdeal ↥W ∧ π ≠ 0
    swap
    · refine ⟨fun _ => 0, ?_⟩
      intro b q _ hq hq0
      exact absurd ⟨q, hq, hq0⟩ hπ
    obtain ⟨π, hπm, hπ0⟩ := hπ
    have hπu : ¬ IsUnit π := (IsLocalRing.mem_maximalIdeal _).mp hπm
    have hroot : ∀ N : ℕ, ∃ r : ↥W, r ^ (N + 1) = π := by
      intro N
      obtain ⟨ρ, hρ⟩ := IsAlgClosed.exists_pow_nat_eq (π : Ω) (Nat.succ_pos N)
      have hρ0 : ρ ≠ 0 := by
        rintro rfl
        apply hπ0
        apply Subtype.ext
        rw [← hρ, zero_pow (Nat.succ_ne_zero N)]
        rfl
      have hρW : ρ ∈ W := by
        rcases W.mem_or_inv_mem ρ with h | h
        · exact h
        · exfalso
          apply hπu
          refine isUnit_iff_exists_inv.mpr ⟨⟨(ρ⁻¹) ^ (N + 1), pow_mem h _⟩, ?_⟩
          apply Subtype.ext
          show (π : Ω) * (ρ⁻¹) ^ (N + 1) = 1
          rw [← hρ, inv_pow, mul_inv_cancel₀ (pow_ne_zero _ hρ0)]
      refine ⟨⟨ρ, hρW⟩, Subtype.ext ?_⟩
      show ρ ^ (N + 1) = (π : Ω)
      exact hρ
    choose r hr using hroot
    have hrm : ∀ N, r N ∈ IsLocalRing.maximalIdeal ↥W := by
      intro N
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      apply hπu
      rw [← hr N]
      exact hu.pow _
    have hru : ∀ N, ¬ IsUnit (r N) := fun N => (IsLocalRing.mem_maximalIdeal _).mp (hrm N)
    refine ⟨fun j => r (Nat.unpair j).1 ^ (Nat.unpair j).2, ?_⟩
    intro b q hb hq hq0
    obtain ⟨M, hM⟩ := hrad q π hq hπ0
    have hM0 : M ≠ 0 := by
      rintro rfl
      apply hπu
      exact isUnit_of_dvd_one (by simpa using hM)
    obtain ⟨N, hNM⟩ : ∃ N, M = N + 1 := Nat.exists_eq_succ_of_ne_zero hM0
    set ρ := r N with hρdef
    have hρM : ρ ^ M = π := by rw [hNM]; exact hr N
    have hρq : ρ ∣ q := by
      rcases ValuationRing.dvd_total ρ q with h | ⟨u, hu⟩
      · exact h
      · by_cases hu' : IsUnit u
        · exact (IsUnit.dvd_mul_right hu').mp (by rw [← hu])
        · exfalso
          apply hu'
          obtain ⟨w, hw⟩ := hM
          rw [← hρM, hu, mul_pow, mul_assoc] at hw
          have h1 : q ^ M * 1 = q ^ M * (u ^ M * w) := by rw [mul_one]; exact hw
          have h2 := mul_left_cancel₀ (pow_ne_zero M hq0) h1
          have h3 : IsUnit (u ^ M) := isUnit_of_dvd_one ⟨w, h2⟩
          exact (isUnit_pow_iff hM0).mp h3
    have hex : ∃ k, ¬ ρ ^ k ∣ b := by
      obtain ⟨n, hn⟩ := hrad ρ b (hrm N) hb
      refine ⟨n + 1, fun h => ?_⟩
      obtain ⟨w, hw⟩ := h.trans hn
      have hρn0 : ρ ^ n ≠ 0 := pow_ne_zero n (fun h0 => hπ0 (by rw [← hρM, h0, zero_pow hM0]))
      have h1 : ρ ^ n * 1 = ρ ^ n * (ρ * w) := by rw [mul_one, ← mul_assoc, ← pow_succ]; exact hw
      have h2 := mul_left_cancel₀ hρn0 h1
      exact hru N (isUnit_of_dvd_one ⟨w, h2⟩)
    set k₁ := Nat.find hex with hk₁
    have hk1 : ¬ ρ ^ k₁ ∣ b := Nat.find_spec hex
    have hk10 : k₁ ≠ 0 := by
      intro h
      apply hk1
      rw [h, pow_zero]
      exact one_dvd _
    obtain ⟨k₀, hk⟩ : ∃ k₀, k₁ = k₀ + 1 := Nat.exists_eq_succ_of_ne_zero hk10
    have hk0 : ρ ^ k₀ ∣ b := by
      have := Nat.find_min hex (show k₀ < Nat.find hex by omega)
      exact not_not.mp this
    refine ⟨Nat.pair N k₁, ?_, ?_⟩
    · simp only [Nat.unpair_pair]
      exact (ValuationRing.dvd_total (ρ ^ k₁) b).resolve_left hk1
    · simp only [Nat.unpair_pair]
      rw [hk, pow_succ]
      exact mul_dvd_mul hk0 hρq

  have s4 : ∀ (G : ↥W → ↥W → Prop) (τ : ℕ → ↥W),
      (∀ c b, G c b → b ≠ 0) → (∃ c b, G c b) →
      (∀ c₁ b₁ c₂ b₂, G c₁ b₁ → G c₂ b₂ → b₁ ∣ c₁ - c₂ ∨ b₂ ∣ c₁ - c₂) →
      (∀ c b, G c b → ∃ c' b', G c' b' ∧ b ∣ c' - c ∧ ¬ b' ∣ b) →
      (∀ b q : ↥W, b ≠ 0 → q ∈ IsLocalRing.maximalIdeal ↥W → q ≠ 0 →
        ∃ j : ℕ, b ∣ τ j ∧ τ j ∣ b * q) →
      ∃ c b : ℕ → ↥W, (∀ i, G (c i) (b i)) ∧ (∀ i, b i ∣ c (i + 1) - c i) ∧
        (∀ i, b i ∣ b (i + 1)) ∧ (∀ i, ¬ b (i + 1) ∣ b i) ∧
        ∀ c' b', G c' b' → ∃ i, b' ∣ b i ∧ b' ∣ c i - c' := by
    intro G τ hG0 hne hnest hnext hτ
    have NF : ∀ c₁ b₁ c₂ b₂, G c₁ b₁ → G c₂ b₂ → b₁ ∣ b₂ → b₁ ∣ c₂ - c₁ := by
      intro c₁ b₁ c₂ b₂ h1 h2 hb
      rw [dvd_sub_comm]
      rcases hnest c₁ b₁ c₂ b₂ h1 h2 with h | h
      · exact h
      · exact hb.trans h
    have hdvd_of_not : ∀ x y : ↥W, ¬ y ∣ x → x ∣ y :=
      fun x y h => (ValuationRing.dvd_total y x).resolve_left h
    have hnextP : ∀ p : {p : ↥W × ↥W // G p.1 p.2}, ∃ p' : {p : ↥W × ↥W // G p.1 p.2},
        p.1.2 ∣ p'.1.1 - p.1.1 ∧ ¬ p'.1.2 ∣ p.1.2 := by
      intro p
      obtain ⟨c', b', hG, hd, hnd⟩ := hnext p.1.1 p.1.2 p.2
      exact ⟨⟨(c', b'), hG⟩, hd, hnd⟩
    choose nx hnx1 hnx2 using hnextP
    have hXex : ∀ (D : {p : ↥W × ↥W // G p.1 p.2}) (j : ℕ), ∃ X : {p : ↥W × ↥W // G p.1 p.2},
        D.1.2 ∣ X.1.2 ∧ ((∃ p : {p : ↥W × ↥W // G p.1 p.2}, D.1.2 ∣ p.1.2 ∧ τ j ∣ p.1.2) →
          τ j ∣ X.1.2) := by
      intro D j
      by_cases h : ∃ p : {p : ↥W × ↥W // G p.1 p.2}, D.1.2 ∣ p.1.2 ∧ τ j ∣ p.1.2
      · obtain ⟨p, hp1, hp2⟩ := h
        exact ⟨p, hp1, fun _ => hp2⟩
      · exact ⟨D, dvd_refl _, fun h' => absurd h' h⟩
    choose X hX1 hX2 using hXex
    obtain ⟨c0, b0, h0⟩ := hne
    let D : ℕ → {p : ↥W × ↥W // G p.1 p.2} :=
      fun n => Nat.rec ⟨(c0, b0), h0⟩ (fun j Dj => nx (X Dj j)) n
    have hDsucc : ∀ j, D (j + 1) = nx (X (D j) j) := fun j => rfl
    have step : ∀ j, (D j).1.2 ∣ (X (D j) j).1.2 ∧
        (D j).1.2 ∣ (X (D j) j).1.1 - (D j).1.1 ∧
        (X (D j) j).1.2 ∣ (D (j + 1)).1.1 - (X (D j) j).1.1 ∧
        (X (D j) j).1.2 ∣ (D (j + 1)).1.2 ∧
        ¬ (D (j + 1)).1.2 ∣ (X (D j) j).1.2 := by
      intro j
      have h1 := hX1 (D j) j
      refine ⟨h1, NF _ _ _ _ (D j).2 (X (D j) j).2 h1, ?_, ?_, ?_⟩
      · rw [hDsucc]; exact hnx1 _
      · rw [hDsucc]; exact hdvd_of_not _ _ (hnx2 _)
      · rw [hDsucc]; exact hnx2 _
    refine ⟨fun i => (D i).1.1, fun i => (D i).1.2, fun i => (D i).2, ?_, ?_, ?_, ?_⟩
    · intro j
      obtain ⟨h1, h2, h3, _, _⟩ := step j
      have e : (D (j + 1)).1.1 - (D j).1.1 =
          ((D (j + 1)).1.1 - (X (D j) j).1.1) + ((X (D j) j).1.1 - (D j).1.1) := by ring
      show (D j).1.2 ∣ (D (j + 1)).1.1 - (D j).1.1
      rw [e]
      exact dvd_add (h1.trans h3) h2
    · intro j
      obtain ⟨h1, _, _, h4, _⟩ := step j
      exact h1.trans h4
    · intro j h
      obtain ⟨h1, _, _, _, h5⟩ := step j
      exact h5 (h.trans h1)
    · intro c' b' hG'
      obtain ⟨c'', b'', hG'', _, hnd⟩ := hnext c' b' hG'
      have hb'b'' : b' ∣ b'' := hdvd_of_not _ _ hnd
      obtain ⟨q, hq⟩ := hb'b''
      have hqm : q ∈ IsLocalRing.maximalIdeal ↥W := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        apply hnd
        rw [hq]
        exact (IsUnit.mul_right_dvd hu).mpr dvd_rfl
      have hq0 : q ≠ 0 := by
        rintro rfl
        apply hG0 _ _ hG''
        rw [hq, mul_zero]
      obtain ⟨j, hj1, hj2⟩ := hτ b' q (hG0 _ _ hG') hqm hq0
      rw [← hq] at hj2
      rcases ValuationRing.dvd_total b' (D j).1.2 with h | h
      · exact ⟨j, h, NF _ _ _ _ hG' (D j).2 h⟩
      · have hex : ∃ p : {p : ↥W × ↥W // G p.1 p.2}, (D j).1.2 ∣ p.1.2 ∧ τ j ∣ p.1.2 :=
          ⟨⟨(c'', b''), hG''⟩, h.trans ⟨q, hq⟩, hj2⟩
        have hτX := hX2 (D j) j hex
        have hb' : b' ∣ (D (j + 1)).1.2 := hj1.trans (hτX.trans (step j).2.2.2.1)
        exact ⟨j + 1, hb', NF _ _ _ _ hG' (D (j + 1)).2 hb'⟩

  obtain ⟨τ, hτ⟩ := s3
  obtain ⟨c, b, hG, hN1, hN2, hS, hcof⟩ := s4
    (fun c b => c ∈ IsLocalRing.maximalIdeal ↥W ∧ b ∈ IsLocalRing.maximalIdeal ↥W ∧ b ≠ 0 ∧
      wcLlsDiscSep W A K L t c b) τ
    (fun c b h => h.2.2.1)
    (by
      obtain ⟨b, hb, hb0, hsep, _⟩ := wcLlsAS_disc_radial_max Ω W hdim hWt ℓ hℓ hchar A K L 𝔭 t y
        hPD hSolv hUniq hBR hdeg α hα1 hα2 0 (Ideal.zero_mem _)
      exact ⟨0, b, Ideal.zero_mem _, hb, hb0, hsep⟩)
    (fun c₁ b₁ c₂ b₂ h1 h2 => wcLlsAS_dcc_nesting Ω W hdim hWt ℓ hℓ hchar A K L 𝔭 t y hPD hSolv
      hUniq hBR hdeg α hα1 hα2 c₁ b₁ c₂ b₂ h1.1 h1.2.1 h2.1 h2.2.1 h1.2.2.1 h2.2.2.1
      h1.2.2.2 h2.2.2.2)
    (by
      intro c b h
      obtain ⟨c', b', hc', hb', hb'0, hd, hS', hnd⟩ := hneg c b h.1 h.2.1 h.2.2.1 h.2.2.2
      exact ⟨c', b', ⟨hc', hb', hb'0, hS'⟩, hd, hnd⟩)
    hτ
  refine ⟨c, b, ?_, hN1, hN2, hS, ?_⟩

  · intro i
    obtain ⟨hc, hb, hb0, hsep⟩ := hG i
    obtain ⟨c', b', hc', hb', hb'0, hd, hS', hnd⟩ := hneg (c i) (b i) hc hb hb0 hsep
    obtain ⟨e', he'⟩ := hd
    refine ⟨hc, hb, hb0, hsep, ?_, e', ?_, ?_⟩
    · exact wcLlsAS_dcc_gauss_not_etale Ω W hdim hWt ℓ hℓ hchar A K L 𝔭 t y hPD hSolv hUniq hdeg
        (c i) (b i) c' b' e' hc hb hc' hb' hb0 hb'0 he' hnd hS'
    · exact wcLls_inner_class_singular Ω W hdim hWt A K L 𝔭 t y hPD hSolv hUniq
        (c i) (b i) c' b' e' hc hb hc' hb' hb0 hb'0 he' hnd hS'
    · exact wcLls_inner_offclass_smooth Ω W hdim hWt A K L 𝔭 t y hPD hSolv hUniq
        (c i) (b i) c' b' e' hc hb hc' hb' hb0 hb'0 he' hnd hS'

  · intro z
    by_cases hz : z ∈ IsLocalRing.maximalIdeal ↥W
    · by_contra hcon
      push_neg at hcon
      obtain ⟨bz, hbz, hbz0, hsepz, hmax⟩ := wcLlsAS_disc_radial_max Ω W hdim hWt ℓ hℓ hchar A K
        L 𝔭 t y hPD hSolv hUniq hBR hdeg α hα1 hα2 z hz
      obtain ⟨c', b', hc', hb', hb'0, _, hS', hnd⟩ := hneg z bz hz hbz hbz0 hsepz
      obtain ⟨i, hi1, hi2⟩ := hcof c' b' ⟨hc', hb', hb'0, hS'⟩
      have hdz : b' ∣ z - c' := by
        have e : z - c' = (z - c i) + (c i - c') := by ring
        rw [e]
        exact dvd_add (hi1.trans (hcon i)) hi2
      have hsz := wcLlsAS_disc_recentre Ω W A K L 𝔭 t hPD c' z b' hc' hz hb' hb'0 hdz hS'
      exact hnd (hmax b' hb' hb'0 hsz)
    · refine ⟨0, fun h => hz ?_⟩
      have h1 : z - c 0 ∈ IsLocalRing.maximalIdeal ↥W := by
        obtain ⟨w, hw⟩ := h
        rw [hw]
        exact Ideal.mul_mem_right _ _ (hG 0).2.1
      have e : z = (z - c 0) + c 0 := by ring
      rw [e]
      exact Ideal.add_mem _ h1 (hG 0).1

theorem wcFrmCp_arch : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ x y : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → y ≠ 0 → ∃ J : ℕ, y ∣ x ^ J :=
by
  intro Ω _ W h x y hx hy
  have hdim : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr h
  haveI : (⊥ : Ideal ↥W).IsPrime := Ideal.isPrime_bot
  have hmax : ∀ I : Ideal ↥W, I ≠ ⊥ → I.IsPrime → I.IsMaximal :=
    Ring.krullDimLE_one_iff_of_isPrime_bot.mp hdim
  have hrad : x ∈ (Ideal.span {y}).radical := by
    rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
    rintro J ⟨hIJ, hJ⟩
    have hne : J ≠ ⊥ := by
      rintro rfl
      have hy0 : y ∈ (⊥ : Ideal ↥W) := hIJ (Ideal.mem_span_singleton_self y)
      exact hy ((Ideal.mem_bot).mp hy0)
    have hJm : J = IsLocalRing.maximalIdeal ↥W :=
      IsLocalRing.eq_maximalIdeal (hmax J hne hJ)
    rw [hJm]
    exact hx
  obtain ⟨n, hn⟩ := (Ideal.mem_radical_iff).mp hrad
  exact ⟨n, Ideal.mem_span_singleton.mp hn⟩

theorem wcLlsASvmpa_root_free : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (c b : ℕ → ↥W), (∀ i, c i ∈ IsLocalRing.maximalIdeal ↥W) → (∀ i, b i ∈ IsLocalRing.maximalIdeal ↥W) → (∀ i, b i ≠ 0) → (∀ i, b i ∣ c (i + 1) - c i) → (∀ i, b i ∣ b (i + 1)) → (∀ z : ↥W, ∃ i, ¬ b i ∣ z - c i) → ∀ N : Polynomial ↥W, N ≠ 0 → ∃ (i₁ : ℕ) (ν ϖ : ↥W) (H : Polynomial ↥W), ν ≠ 0 ∧ ϖ ∈ IsLocalRing.maximalIdeal ↥W ∧ ϖ ≠ 0 ∧ N.comp (Polynomial.C (c i₁) + Polynomial.C (b i₁) * Polynomial.X) = Polynomial.C ν * (1 + Polynomial.C ϖ * H) :=
by
  intro Ω _ _ W c b _hcm hbm hb0 hstep hbb hnc N hN
  classical
  set ι := algebraMap ↥W Ω with hι
  have hιv : ∀ x : W, ι x = (x : Ω) := fun x => rfl
  have hιinj : Function.Injective ι := by
    intro x y hxy
    exact Subtype.ext (by simpa [hιv] using hxy)

  have chain : ∀ i j, i ≤ j → b i ∣ b j ∧ b i ∣ c j - c i := by
    intro i j hij
    induction j, hij using Nat.le_induction with
    | base => exact ⟨dvd_rfl, by simp⟩
    | succ j hij ih =>
      refine ⟨dvd_trans ih.1 (hbb j), ?_⟩
      have : c (j+1) - c i = (c (j+1) - c j) + (c j - c i) := by ring
      rw [this]
      exact dvd_add (dvd_trans ih.1 (hstep j)) ih.2

  have s1 : ∀ ζ : Ω, ∃ i₀ : ℕ, ∀ i, i₀ ≤ i → ∃ κ : ↥W,
      κ ∈ IsLocalRing.maximalIdeal ↥W ∧ (ι (c i) - ζ) * ι κ = ι (b i) := by
    intro ζ
    by_cases hζ : ζ ∈ W
    · obtain ⟨j, hj⟩ := hnc ⟨ζ, hζ⟩
      refine ⟨j, fun i hi => ?_⟩
      have hnd : ¬ b i ∣ ⟨ζ, hζ⟩ - c i := by
        intro h
        apply hj
        obtain ⟨h1, h2⟩ := chain j i hi
        have : (⟨ζ, hζ⟩ : W) - c j = (⟨ζ, hζ⟩ - c i) + (c i - c j) := by ring
        rw [this]
        exact dvd_add (dvd_trans h1 h) h2
      rcases ValuationRing.dvd_total (⟨ζ, hζ⟩ - c i) (b i) with h | h
      · obtain ⟨κ₀, hκ₀⟩ := h
        have hκm : κ₀ ∈ IsLocalRing.maximalIdeal W := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          intro hu
          apply hnd
          obtain ⟨v, hv⟩ := hu
          refine ⟨↑v⁻¹, ?_⟩
          rw [hκ₀, ← hv, mul_assoc, Units.mul_inv, mul_one]
        refine ⟨-κ₀, neg_mem hκm, ?_⟩
        rw [hκ₀]
        have e1 : ι (c i) - ζ = - ι (⟨ζ, hζ⟩ - c i) := by
          rw [map_sub, hιv ⟨ζ, hζ⟩]; ring
        rw [e1, map_neg, map_mul]; ring
      · exact absurd h hnd
    · refine ⟨0, fun i _ => ?_⟩
      set δ := ι (c i) - ζ with hδ
      have hδW : δ ∉ W := by
        intro h
        apply hζ
        have : ζ = ι (c i) - δ := by rw [hδ]; ring
        rw [this, hιv]
        exact sub_mem (c i).2 h
      have hδ0 : δ ≠ 0 := fun h => hδW (h ▸ W.zero_mem)
      have hδinv : δ⁻¹ ∈ W := (W.mem_or_inv_mem δ).resolve_left hδW
      have hem : (⟨δ⁻¹, hδinv⟩ : W) ∈ IsLocalRing.maximalIdeal W := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        obtain ⟨v, hv⟩ := hu
        apply hδW
        have h1 : δ⁻¹ * (((v⁻¹ : Wˣ) : W) : Ω) = 1 := by
          have := congrArg Subtype.val (Units.mul_inv v)
          rw [hv] at this
          simpa using this
        have h2 : (((v⁻¹ : Wˣ) : W) : Ω) = δ := by
          calc (((v⁻¹ : Wˣ) : W) : Ω) = δ * (δ⁻¹ * (((v⁻¹ : Wˣ) : W) : Ω)) := by
                rw [← mul_assoc, mul_inv_cancel₀ hδ0, one_mul]
            _ = δ := by rw [h1, mul_one]
        rw [← h2]
        exact ((v⁻¹ : Wˣ) : W).2
      refine ⟨b i * ⟨δ⁻¹, hδinv⟩, Ideal.mul_mem_left _ _ hem, ?_⟩
      rw [map_mul, hιv ⟨δ⁻¹, hδinv⟩]
      field_simp

  have s2 : ∀ (ϖ κ : ↥W) (H : Polynomial ↥W), ϖ ∈ IsLocalRing.maximalIdeal ↥W → ϖ ≠ 0 →
      κ ∈ IsLocalRing.maximalIdeal ↥W → H.coeff 0 = 0 →
      ∃ (ϖ' : ↥W) (H' : Polynomial ↥W), ϖ' ∈ IsLocalRing.maximalIdeal ↥W ∧ ϖ' ≠ 0 ∧
        H'.coeff 0 = 0 ∧ (1 + Polynomial.C ϖ * H) * (1 + Polynomial.C κ * Polynomial.X) =
          1 + Polynomial.C ϖ' * H' := by
    intro ϖ κ H hϖm hϖ0 hκm hH0
    rcases ValuationRing.dvd_total ϖ κ with ⟨κ', hκ'⟩ | ⟨ϖ₁, hϖ₁⟩
    · refine ⟨ϖ, H + Polynomial.C κ' * Polynomial.X + Polynomial.C (ϖ * κ') * Polynomial.X * H,
        hϖm, hϖ0, ?_, ?_⟩
      · simp [Polynomial.coeff_add, Polynomial.mul_coeff_zero, hH0]
      · rw [hκ']; simp only [map_mul]; ring
    · have hκ0 : κ ≠ 0 := by
        rintro rfl; apply hϖ0; rw [hϖ₁, zero_mul]
      refine ⟨κ, Polynomial.C ϖ₁ * H + Polynomial.X + Polynomial.C (κ * ϖ₁) * H * Polynomial.X,
        hκm, hκ0, ?_, ?_⟩
      · simp [Polynomial.coeff_add, Polynomial.mul_coeff_zero, hH0]
      · rw [hϖ₁]; simp only [map_mul]; ring

  have s3 : ∀ s : Multiset Ω, ∃ i₀ : ℕ, ∀ i, i₀ ≤ i → ∃ (u : Ω) (ϖ : ↥W) (H : Polynomial ↥W),
      u ≠ 0 ∧ ϖ ∈ IsLocalRing.maximalIdeal ↥W ∧ ϖ ≠ 0 ∧ H.coeff 0 = 0 ∧
      (s.map (fun a => Polynomial.X - Polynomial.C a)).prod.comp
          (Polynomial.C (ι (c i)) + Polynomial.C (ι (b i)) * Polynomial.X) =
        Polynomial.C u * (1 + Polynomial.C (ι ϖ) * H.map ι) := by
    intro s
    induction s using Multiset.induction_on with
    | empty =>
      exact ⟨0, fun i _ => ⟨1, b 0, 0, one_ne_zero, hbm 0, hb0 0, by simp, by simp⟩⟩
    | cons ζ s ih =>
      obtain ⟨i_s, his⟩ := ih
      obtain ⟨i_ζ, hiζ⟩ := s1 ζ
      refine ⟨max i_s i_ζ, fun i hi => ?_⟩
      obtain ⟨u, ϖ, H, hu, hϖm, hϖ0, hH0, heq⟩ := his i (le_of_max_le_left hi)
      obtain ⟨κ, hκm, hκ⟩ := hiζ i (le_of_max_le_right hi)
      have hδ0 : ι (c i) - ζ ≠ 0 := by
        intro h
        rw [h, zero_mul] at hκ
        exact hb0 i (hιinj (by rw [← hκ, map_zero]))
      obtain ⟨ϖ', H', hϖ'm, hϖ'0, hH'0, hm⟩ := s2 ϖ κ H hϖm hϖ0 hκm hH0
      have hmap := congrArg (Polynomial.map ι) hm
      simp only [Polynomial.map_mul, Polynomial.map_add, Polynomial.map_one, Polynomial.map_C,
        Polynomial.map_X] at hmap
      refine ⟨u * (ι (c i) - ζ), ϖ', H', mul_ne_zero hu hδ0, hϖ'm, hϖ'0, hH'0, ?_⟩
      rw [Multiset.map_cons, Multiset.prod_cons, Polynomial.mul_comp, heq]
      have hlin : (Polynomial.X - Polynomial.C ζ).comp
          (Polynomial.C (ι (c i)) + Polynomial.C (ι (b i)) * Polynomial.X) =
          Polynomial.C (ι (c i) - ζ) * (1 + Polynomial.C (ι κ) * Polynomial.X) := by
        rw [Polynomial.sub_comp, Polynomial.X_comp, Polynomial.C_comp, ← hκ]
        simp only [map_mul, map_sub]; ring
      rw [hlin, Polynomial.C_mul]
      linear_combination (Polynomial.C u * Polynomial.C (ι (c i) - ζ)) * hmap

  have hNΩ : N.map ι ≠ 0 := by
    intro h
    apply hN
    apply Polynomial.map_injective ι hιinj
    rw [h, Polynomial.map_zero]
  obtain ⟨i₀, hi₀⟩ := s3 (N.map ι).roots
  obtain ⟨u, ϖ, H, hu, hϖm, hϖ0, hH0, heq⟩ := hi₀ i₀ le_rfl
  have hQmap : (Polynomial.C (c i₀) + Polynomial.C (b i₀) * Polynomial.X).map ι =
      Polynomial.C (ι (c i₀)) + Polynomial.C (ι (b i₀)) * Polynomial.X := by
    simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_X]
  have hsplit := Polynomial.Splits.eq_prod_roots (IsAlgClosed.splits (N.map ι))
  have hlc : (N.map ι).leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hNΩ
  have hstar : (N.comp (Polynomial.C (c i₀) + Polynomial.C (b i₀) * Polynomial.X)).map ι =
      Polynomial.C ((N.map ι).leadingCoeff * u) * (1 + Polynomial.C (ι ϖ) * H.map ι) := by
    rw [Polynomial.map_comp, hQmap]
    conv_lhs => rw [hsplit]
    rw [Polynomial.mul_comp, Polynomial.C_comp, heq, Polynomial.C_mul, mul_assoc]
  have hcoeff : ι ((N.comp (Polynomial.C (c i₀) + Polynomial.C (b i₀) * Polynomial.X)).coeff 0)
      = (N.map ι).leadingCoeff * u := by
    have := congrArg (fun p => Polynomial.coeff p 0) hstar
    simp only [Polynomial.coeff_map] at this
    rw [this]
    simp [Polynomial.mul_coeff_zero, hH0]
  refine ⟨i₀, (N.comp (Polynomial.C (c i₀) + Polynomial.C (b i₀) * Polynomial.X)).coeff 0,
    ϖ, H, ?_, hϖm, hϖ0, ?_⟩
  · intro h
    rw [h, map_zero] at hcoeff
    exact mul_ne_zero hlc hu hcoeff.symm
  · apply Polynomial.map_injective ι hιinj
    rw [hstar]
    simp only [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_add, Polynomial.map_one,
      hcoeff]

theorem wcLlsASvmpa_disc_small : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (𝔭 : Ideal A) (t : A), 𝔭.IsPrime → (∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0) → ∀ (c b c₀ b₀ μ ν ϖ q₁ q₂ : ↥W) (N P H : Polynomial ↥W) (n y' d' : A) (k M J : ℕ), b ≠ 0 → b₀ ≠ 0 → ν ≠ 0 → ϖ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ∣ c - c₀ → b₀ ∣ b → d' ∉ 𝔭 → b₀ ^ M = ν * μ * q₁ → ϖ ^ J = ν * μ * q₂ → N.comp (Polynomial.C c₀ + Polynomial.C b₀ * Polynomial.X) = Polynomial.C ν * (1 + Polynomial.C ϖ * H) → Polynomial.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K t) N ≠ 0 → algebraMap A K d' ^ k * (algebraMap A K n - Polynomial.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K (t - algebraMap ↥W A c₀)) P) = algebraMap A K (t - algebraMap ↥W A c₀) ^ M * algebraMap A K y' → wcLlsVmSmall W A K 𝔭 t c b μ (algebraMap A K n / Polynomial.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K t) N - Polynomial.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K t) (P.comp (Polynomial.X - Polynomial.C c₀) * ∑ j ∈ Finset.range J, Polynomial.C (ν ^ j) * (Polynomial.C ν - N) ^ (J - 1 - j)) / algebraMap A K (algebraMap ↥W A (ν ^ J))) :=
by
  intro Ω _ W A _ _ _ K _ _ 𝔭 t hp hφ c b c₀ b₀ μ ν ϖ q₁ q₂ N P H n y' d' k M J hb hb₀ hν hϖ hcc hbb hd' hq₁ hq₂ hcomp hNT htay
  unfold wcLlsVmSmall wcLlsScS
  obtain ⟨e, he⟩ := hcc
  obtain ⟨q, hq⟩ := hbb
  generalize hS : algebraMap A K (t - algebraMap ↥W A c) / algebraMap A K (algebraMap ↥W A b) = S
  obtain ⟨φ, hφdef⟩ : ∃ φ : ↥W →+* K, φ = (algebraMap A K).comp (algebraMap ↥W A) := ⟨_, rfl⟩
  have hφw : ∀ w, algebraMap A K (algebraMap ↥W A w) = φ w := fun w => by rw [hφdef]; rfl
  rw [← hφdef] at hNT htay ⊢
  simp only [hφw] at hφ hS ⊢
  have htc : ∀ w, algebraMap A K (t - algebraMap ↥W A w) = algebraMap A K t - φ w := by
    intro w; rw [map_sub, hφw]
  rw [htc] at hS
  rw [htc] at htay
  have hφb : φ b ≠ 0 := hφ b hb
  have hφν : φ ν ≠ 0 := hφ ν hν
  have hφνJ : φ ν ^ J ≠ 0 := pow_ne_zero _ hφν
  have hφc : φ c = φ c₀ + φ b₀ * φ e := by
    have h1 := congrArg φ he
    rw [map_sub, map_mul] at h1
    linear_combination h1
  have hφq : φ b = φ b₀ * φ q := by rw [hq, map_mul]
  have hφq₁ : φ b₀ ^ M = φ ν * φ μ * φ q₁ := by rw [← map_pow, hq₁, map_mul, map_mul]
  have hφq₂ : φ ϖ ^ J = φ ν * φ μ * φ q₂ := by rw [← map_pow, hq₂, map_mul, map_mul]
  have hSb : φ b * S = algebraMap A K t - φ c := by
    rw [← hS]; field_simp
  have hιR : ∀ w, (((algebraMap A (Algebra.adjoin A ({S} : Set K))).comp (algebraMap ↥W A) w :
      Algebra.adjoin A ({S} : Set K)) : K) = φ w := fun w => by rw [← hφw]; rfl
  have hcompR : ((Algebra.adjoin A ({S} : Set K)).val.toRingHom).comp
      ((algebraMap A (Algebra.adjoin A ({S} : Set K))).comp (algebraMap ↥W A)) = φ :=
    RingHom.ext fun w => hιR w
  have hevR : ∀ (F : Polynomial ↥W) (z : Algebra.adjoin A ({S} : Set K)),
      ((Polynomial.eval₂ ((algebraMap A (Algebra.adjoin A ({S} : Set K))).comp (algebraMap ↥W A)) z F :
        Algebra.adjoin A ({S} : Set K)) : K) = Polynomial.eval₂ φ (z : K) F := by
    intro F z
    have h1 := Polynomial.hom_eval₂ F
      ((algebraMap A (Algebra.adjoin A ({S} : Set K))).comp (algebraMap ↥W A))
      (Algebra.adjoin A ({S} : Set K)).val.toRingHom z
    rw [hcompR] at h1
    exact h1
  obtain ⟨s₀, hs₀⟩ : ∃ s₀ : Algebra.adjoin A ({S} : Set K), (s₀ : K) = φ e + φ q * S :=
    ⟨(algebraMap A _).comp (algebraMap ↥W A) e + (algebraMap A _).comp (algebraMap ↥W A) q *
      ⟨S, Algebra.subset_adjoin (Set.mem_singleton S)⟩, by
        rw [Subalgebra.coe_add, Subalgebra.coe_mul, hιR, hιR]⟩
  have K1 : algebraMap A K t - φ c₀ = φ b₀ * (s₀ : K) := by
    rw [hs₀]; linear_combination (-1 : K) * hSb + hφc + S * hφq
  obtain ⟨η, hη⟩ : ∃ η : Algebra.adjoin A ({S} : Set K),
      (η : K) = Polynomial.eval₂ φ (s₀ : K) H := ⟨_, hevR H s₀⟩
  obtain ⟨pR, hpR⟩ : ∃ pR : Algebra.adjoin A ({S} : Set K),
      (pR : K) = Polynomial.eval₂ φ (algebraMap A K t - φ c₀) P := by
    refine ⟨Polynomial.eval₂ ((algebraMap A _).comp (algebraMap ↥W A))
      ((algebraMap A _).comp (algebraMap ↥W A) b₀ * s₀) P, ?_⟩
    rw [hevR, Subalgebra.coe_mul, hιR, K1]
  have hND : Polynomial.eval₂ φ (algebraMap A K t) N = φ ν * (1 + φ ϖ * (η : K)) := by
    have hT : algebraMap A K t =
        Polynomial.eval₂ φ (s₀ : K) (Polynomial.C c₀ + Polynomial.C b₀ * Polynomial.X) := by
      simp only [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X]
      linear_combination K1
    rw [hT, ← Polynomial.eval₂_comp, hcomp, hη]
    simp only [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_one]
  have hnum : Polynomial.eval₂ φ (algebraMap A K t) (P.comp (Polynomial.X - Polynomial.C c₀) *
      ∑ j ∈ Finset.range J, Polynomial.C (ν ^ j) * (Polynomial.C ν - N) ^ (J - 1 - j)) =
      Polynomial.eval₂ φ (algebraMap A K t - φ c₀) P *
        ∑ j ∈ Finset.range J, φ ν ^ j *
          (φ ν - Polynomial.eval₂ φ (algebraMap A K t) N) ^ (J - 1 - j) := by
    simp only [Polynomial.eval₂_mul, Polynomial.eval₂_comp, Polynomial.eval₂_sub, Polynomial.eval₂_X,
      Polynomial.eval₂_C, Polynomial.eval₂_finsetSum, Polynomial.eval₂_pow, map_pow]
  rw [hnum, map_pow]
  rw [← hpR] at htay ⊢
  generalize hNT' : Polynomial.eval₂ φ (algebraMap A K t) N = NT at hNT hND ⊢
  have hG : (∑ j ∈ Finset.range J, φ ν ^ j * (φ ν - NT) ^ (J - 1 - j)) * NT =
      φ ν ^ J - (φ ν - NT) ^ J := by
    have h1 := geom_sum₂_mul (φ ν) (φ ν - NT) J
    rw [sub_sub_cancel] at h1
    exact h1
  generalize hG' : ∑ j ∈ Finset.range J, φ ν ^ j * (φ ν - NT) ^ (J - 1 - j) = G at hG ⊢
  have hZJ : (φ ν - NT) ^ J = (-1) ^ J * φ ν ^ J * φ ϖ ^ J * (η : K) ^ J := by
    have hZ : φ ν - NT = (-1) * φ ν * φ ϖ * (η : K) := by rw [hND]; ring
    rw [hZ, mul_pow, mul_pow, mul_pow]
  have hE : (algebraMap A K n / NT - (pR : K) * G / φ ν ^ J) * NT =
      algebraMap A K n - (pR : K) + (-1) ^ J * (pR : K) * φ ϖ ^ J * (η : K) ^ J := by
    have h1 : (pR : K) * G / φ ν ^ J * NT = (pR : K) - (-1) ^ J * (pR : K) * φ ϖ ^ J * (η : K) ^ J := by
      rw [div_mul_eq_mul_div, div_eq_iff hφνJ, mul_assoc, hG, hZJ]; ring
    rw [sub_mul, div_mul_cancel₀ _ hNT, h1]; ring
  have hK1M : (algebraMap A K t - φ c₀) ^ M = φ b₀ ^ M * (s₀ : K) ^ M := by rw [K1, mul_pow]
  refine ⟨(algebraMap A _).comp (algebraMap ↥W A) q₁ * s₀ ^ M * algebraMap A _ y' +
      (-1) ^ J * (algebraMap A _).comp (algebraMap ↥W A) q₂ * algebraMap A _ d' ^ k * pR * η ^ J,
    (1 + (algebraMap A _).comp (algebraMap ↥W A) ϖ * η) * algebraMap A _ d' ^ k, d' ^ k,
    fun h' => hd' (hp.mem_of_pow_mem k h'), ?_, ?_⟩
  · have h1 : (1 + (algebraMap A (Algebra.adjoin A ({S} : Set K))).comp (algebraMap ↥W A) ϖ * η) *
        algebraMap A _ d' ^ k - algebraMap A _ (d' ^ k) =
        (algebraMap A (Algebra.adjoin A ({S} : Set K))).comp (algebraMap ↥W A) ϖ *
          (η * algebraMap A _ d' ^ k) := by
      rw [map_pow]; ring
    rw [h1]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hϖ)
  · simp only [Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_neg,
      Subalgebra.coe_one, Subalgebra.coe_algebraMap, hιR]
    apply mul_left_cancel₀ hφν
    linear_combination (-((algebraMap A K n / NT - (pR : K) * G / φ ν ^ J) * algebraMap A K d' ^ k)) * hND +
      algebraMap A K d' ^ k * hE + htay + algebraMap A K y' * hK1M +
      (s₀ : K) ^ M * algebraMap A K y' * hφq₁ +
      algebraMap A K d' ^ k * (-1) ^ J * (pR : K) * (η : K) ^ J * hφq₂

theorem wcLlsASvm_poly_approx : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ (c b : ℕ → ↥W), (∀ i, c i ∈ IsLocalRing.maximalIdeal ↥W) → (∀ i, b i ∈ IsLocalRing.maximalIdeal ↥W) → (∀ i, b i ≠ 0) → (∀ i, b i ∣ c (i + 1) - c i) → (∀ i, b i ∣ b (i + 1)) → (∀ i, ¬ b (i + 1) ∣ b i) → (∀ z : ↥W, ∃ i, ¬ b i ∣ z - c i) → ∀ g : K, ∃ (P : Polynomial ↥W) (w μ : ↥W) (i₀ : ℕ), w ≠ 0 ∧ μ ∈ IsLocalRing.maximalIdeal ↥W ∧ ∀ i, i₀ ≤ i → wcLlsVmSmall W A K 𝔭 t (c i) (b i) μ (g - Polynomial.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K t) P / algebraMap A K (algebraMap ↥W A w)) :=
by
  intro Ω _ _ W hdim hWt A _ _ _ K _ _ _ 𝔭 t hPD c b hcm hbm hb0 hcb hbb _ hnc g
  classical
  obtain ⟨_, hNZ, _, hmax, _⟩ := id hPD
  have hp : 𝔭.IsPrime := hmax.isPrime
  have hWA : Function.Injective (algebraMap ↥W A) := by
    haveI := hNZ
    intro x y' hxy
    rw [← sub_eq_zero]
    have h0 : algebraMap ↥W A (x - y') = 0 := by rw [map_sub, hxy, sub_self]
    rw [Algebra.algebraMap_eq_smul_one] at h0
    exact (smul_eq_zero.mp h0).resolve_right one_ne_zero
  have hφ : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
    intro x hx h0
    apply hx
    apply hWA
    apply IsFractionRing.injective A K
