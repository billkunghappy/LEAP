  have hmin : ∀ (S : Finset ↥W) (a : ↥W), ∃ M ∈ insert a S, ∀ x ∈ insert a S, M ∣ x := by
    intro S
    induction S using Finset.induction_on with
    | empty =>
      intro a
      refine ⟨a, Finset.mem_insert_self _ _, fun x hx => ?_⟩
      rcases Finset.mem_insert.mp hx with h | h
      · rw [h]
      · simp at h
    | insert c S hc ih =>
      intro a
      obtain ⟨M, hM, hMx⟩ := ih c
      rcases ValuationRing.dvd_total a M with h | h
      · refine ⟨a, Finset.mem_insert_self _ _, fun x hx => ?_⟩
        rcases Finset.mem_insert.mp hx with h' | h'
        · rw [h']
        · exact dvd_trans h (hMx x h')
      · refine ⟨M, Finset.mem_insert_of_mem hM, fun x hx => ?_⟩
        rcases Finset.mem_insert.mp hx with h' | h'
        · rw [h']; exact h
        · exact hMx x h'

  have hT2 : ∀ b₁ b₂ : ↥W, b₁ ∈ IsLocalRing.maximalIdeal ↥W → b₁ ≠ 0 →
      b₂ ∈ IsLocalRing.maximalIdeal ↥W → b₂ ≠ 0 → b₁ ∣ b₂ → b₂ ∣ g →
      wcLlsAnnSep W A K L u b₁ → (∀ t ∈ insert g T, b₁ ∣ t → b₂ ∣ t) →
      wcLlsAnnSep W A K L u b₂ :=
    fun b₁ b₂ h1 h2 h3 h4 h5 h6 h7 h8 =>
      hT b₁ b₂ h1 h2 h3 h4 h5 h6 h7 (fun t ht => h8 t (Finset.mem_insert_of_mem ht))

  obtain ⟨bs, hbsF, hbsmax⟩ := hmax ((insert g T).filter (fun t => t ∈ IsLocalRing.maximalIdeal ↥W ∧
    t ≠ 0 ∧ t ∣ g ∧ wcLlsAnnSep W A K L u t)) b₀
  have hPbs : bs ∈ IsLocalRing.maximalIdeal ↥W ∧ bs ≠ 0 ∧ bs ∣ g ∧ wcLlsAnnSep W A K L u bs := by
    rcases Finset.mem_insert.mp hbsF with h | h
    · rw [h]; exact ⟨hb₀m, hb₀0, hb₀g, hb₀S⟩
    · exact (Finset.mem_filter.mp h).2
  obtain ⟨hbsm, hbs0, hbsg, hbsS⟩ := hPbs

  have key : ∀ b' : ↥W, b' ∈ IsLocalRing.maximalIdeal ↥W → b' ≠ 0 → b' ∣ g →
      wcLlsAnnSep W A K L u b' → b' ∣ bs := by
    intro b' hb'm hb'0 hb'g hb'S
    obtain ⟨t₂, ht₂S, ht₂min⟩ := hmin ((insert g T).filter (fun t => b' ∣ t)) g
    have hgS : g ∈ insert g ((insert g T).filter (fun t => b' ∣ t)) := Finset.mem_insert_self _ _
    have hb't₂ : b' ∣ t₂ := by
      rcases Finset.mem_insert.mp ht₂S with h | h
      · rw [h]; exact hb'g
      · exact (Finset.mem_filter.mp h).2
    have ht₂T' : t₂ ∈ insert g T := by
      rcases Finset.mem_insert.mp ht₂S with h | h
      · rw [h]; exact Finset.mem_insert_self _ _
      · exact (Finset.mem_filter.mp h).1
    have ht₂g : t₂ ∣ g := ht₂min g hgS
    have ht₂m : t₂ ∈ IsLocalRing.maximalIdeal ↥W := by
      obtain ⟨c, hc⟩ := hb't₂
      rw [hc]; exact Ideal.mul_mem_right c _ hb'm
    have ht₂0 : t₂ ≠ 0 := by
      intro h0
      rw [h0] at ht₂g
      exact hg0 (zero_dvd_iff.mp ht₂g)
    have ht₂S' : wcLlsAnnSep W A K L u t₂ :=
      hT2 b' t₂ hb'm hb'0 ht₂m ht₂0 hb't₂ ht₂g hb'S (fun t ht hb't =>
        ht₂min t (Finset.mem_insert_of_mem (Finset.mem_filter.mpr ⟨ht, hb't⟩)))
    have hmem : t₂ ∈ insert b₀ ((insert g T).filter (fun t => t ∈ IsLocalRing.maximalIdeal ↥W ∧
        t ≠ 0 ∧ t ∣ g ∧ wcLlsAnnSep W A K L u t)) :=
      Finset.mem_insert_of_mem (Finset.mem_filter.mpr ⟨ht₂T', ht₂m, ht₂0, ht₂g, ht₂S'⟩)
    exact dvd_trans hb't₂ (hbsmax t₂ hmem)
  refine ⟨bs, hbsm, hbs0, hbsg, ?_, ?_⟩
  · intro b' hb'm hb'0 hb'b _
    exact wcpa_dj_llsm_br_radial_mono Ω W hW hWt A K L 𝔭 (.ann u v g) u bs b' hPD
      (Or.inr ⟨v, g, rfl, hbsg⟩) hbsm hbs0 hb'm hb'0 hb'b hbsS
  · intro b' hb'm hb'0 hb'g _ hnot hS'
    exact hnot (key b' hb'm hb'0 hb'g hS')

theorem wcpa_dj_llsm_kpw_ann_sep_limit : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
      [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g : ↥W)
      (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.ann u v g) → wcLlsSolvPt W A K L 𝔭 (.ann u v g) y → wcLlsUniq A L 𝔭 y →
    wcLlsBR W A K L 𝔭 (.ann u v g) → Nat.card ↥(wcLlsDec A K L y) = ℓ →
    ∀ b : ↥W, b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → b ∣ g →
      (∀ b' : ↥W, b' ∈ IsLocalRing.maximalIdeal ↥W → b' ≠ 0 → b' ∣ b → ¬ b ∣ b' →
        wcLlsAnnSep W A K L u b') →
      wcLlsAnnSep W A K L u b :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g y hPD hSolv hU hBR hD
    b hbm hb0 hbg hbelow
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  obtain ⟨hy, hcomap, -, -⟩ := id hSolv
  obtain ⟨-, hnzd, -, -, -, -⟩ := id hPD

  have hgen : Module.finrank K L = ℓ ∧ ∃ (θ : L) (f : A), θ ∉ Set.range (algebraMap K L) ∧
      θ ^ ℓ = algebraMap A L f := by
    have hmapint : ∀ (τ : L ≃ₐ[K] L) (x : L), x ∈ integralClosure A L →
        τ x ∈ integralClosure A L := by
      intro τ x hx
      rw [mem_integralClosure_iff] at hx ⊢
      exact hx.map τ
    let fτ : (L ≃ₐ[K] L) → (integralClosure A L →+* integralClosure A L) := fun τ =>
      { toFun := fun x => ⟨τ x, hmapint τ x x.2⟩
        map_one' := Subtype.ext (map_one τ)
        map_mul' := fun a b => Subtype.ext (map_mul τ (a : L) (b : L))
        map_zero' := Subtype.ext (map_zero τ)
        map_add' := fun a b => Subtype.ext (map_add τ (a : L) (b : L)) }
    have hf : ∀ τ (x : integralClosure A L), ((fτ τ x : integralClosure A L) : L) = τ x :=
      fun _ _ => rfl
    have hfA : ∀ τ, (fτ τ).comp (algebraMap A (integralClosure A L)) =
        algebraMap A (integralClosure A L) := by
      intro τ
      refine RingHom.ext fun a => Subtype.ext ?_
      rw [RingHom.comp_apply, hf]
      have e : ((algebraMap A (integralClosure A L) a : integralClosure A L) : L) =
          algebraMap K L (algebraMap A K a) := by
        rw [← IsScalarTower.algebraMap_apply]; rfl
      rw [e]
      exact τ.commutes _
    have hstab : ∀ τ (x : integralClosure A L), x ∈ y → fτ τ x ∈ y := by
      intro τ x hx
      have h1 : y.comap (fτ τ) = y := by
        apply hU
        · exact Ideal.comap_isPrime _ _
        · rw [Ideal.comap_comap, hfA, hcomap]
      have h2 : x ∈ y.comap (fτ τ) := by rw [h1]; exact hx
      exact h2
    have hDec : wcLlsDec A K L y = ⊤ := by
      rw [eq_top_iff]
      intro σ _
      open Pointwise in
      (rw [wcLlsDec, MulAction.mem_stabilizer_iff]
       ext z
       rw [Set.mem_smul_set]
       constructor
       · rintro ⟨w, ⟨x, hx, rfl⟩, rfl⟩
         exact ⟨fτ σ x, hstab σ x hx, rfl⟩
       · rintro ⟨x, hx, rfl⟩
         refine ⟨_, ⟨fτ σ⁻¹ x, hstab σ⁻¹ x hx, rfl⟩, ?_⟩
         rw [AlgEquiv.smul_def, hf, ← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply])
    have hcardG : Nat.card (L ≃ₐ[K] L) = ℓ := by rw [← hD, hDec, Subgroup.card_top]
    have hfr : Module.finrank K L = ℓ := by rw [← IsGalois.card_aut_eq_finrank, hcardG]
    refine ⟨hfr, ?_⟩
    have hℓΩ : (ℓ : Ω) ≠ 0 := by
      intro h
      rcases (Nat.dvd_prime hℓ).mp (ringChar.dvd h) with h1 | h1
      · exact CharP.ringChar_ne_one h1
      · exact hΩ h1
    haveI : NeZero (ℓ : Ω) := ⟨hℓΩ⟩
    obtain ⟨ζ, hζ⟩ : ∃ ζ : Ω, IsPrimitiveRoot ζ ℓ := HasEnoughRootsOfUnity.prim
    have hζW : ζ ∈ W := by
      rcases W.mem_or_inv_mem ζ with h | h
      · exact h
      · have h1 : ζ * ζ ^ (ℓ - 1) = 1 := by
          rw [← pow_succ', Nat.sub_add_cancel hℓ.one_le]; exact hζ.pow_eq_one
        have h2 : ζ = (ζ⁻¹) ^ (ℓ - 1) := by rw [inv_pow]; exact eq_inv_of_mul_eq_one_left h1
        rw [h2]; exact pow_mem h _
    have hζW' : IsPrimitiveRoot (⟨ζ, hζW⟩ : ↥W) ℓ :=
      IsPrimitiveRoot.of_map_of_injective (f := W.subtype) (by exact hζ) Subtype.val_injective
    have hWA : Function.Injective (algebraMap ↥W A) := by
      rw [injective_iff_map_eq_zero]
      intro a ha
      have : a • (1 : A) = 0 := by rw [Algebra.smul_def, ha, zero_mul]
      rcases smul_eq_zero.mp this with h | h
      · exact h
      · exact absurd h one_ne_zero
    have hζK : IsPrimitiveRoot (algebraMap A K (algebraMap ↥W A ⟨ζ, hζW⟩)) ℓ :=
      (hζW'.map_of_injective hWA).map_of_injective (IsFractionRing.injective A K)
    have hprim : (primitiveRoots (Module.finrank K L) K).Nonempty :=
      ⟨_, (mem_primitiveRoots (by rw [hfr]; exact hℓ.pos)).mpr (by rw [hfr]; exact hζK)⟩
    haveI : IsCyclic (L ≃ₐ[K] L) := isCyclic_of_prime_card hcardG
    have key := exists_root_adjoin_eq_top_of_isCyclic K L hprim
    rw [hfr] at key
    obtain ⟨α, hαpow, hαtop⟩ := key
    have hαK : α ∉ Set.range (algebraMap K L) := by
      rintro ⟨k, hk⟩
      have h1 : IntermediateField.adjoin K {α} = ⊥ := by
        rw [IntermediateField.adjoin_simple_eq_bot_iff, IntermediateField.mem_bot]; exact ⟨k, hk⟩
      have h2 : Module.finrank K L = 1 := by
        rw [← IntermediateField.finrank_top', ← hαtop, h1, IntermediateField.finrank_bot]
      rw [hfr] at h2
      exact hℓ.one_lt.ne' h2
    obtain ⟨c, hc⟩ := hαpow
    obtain ⟨a, s, hs, hcs⟩ := IsFractionRing.div_surjective A c
    have hs0 : algebraMap A K s ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hs
    refine ⟨algebraMap A L s * α, a * s ^ (ℓ - 1), ?_, ?_⟩
    · rintro ⟨k, hk⟩
      apply hαK
      refine ⟨k / algebraMap A K s, ?_⟩
      have hsL : algebraMap A L s = algebraMap K L (algebraMap A K s) :=
        IsScalarTower.algebraMap_apply A K L s
      have hsL0 : algebraMap A L s ≠ 0 := by
        rw [hsL]; exact (map_ne_zero _).mpr hs0
      rw [map_div₀, hk, ← hsL]
      field_simp
    · have hsL : ∀ x : A, algebraMap A L x = algebraMap K L (algebraMap A K x) :=
        fun x => IsScalarTower.algebraMap_apply A K L x
      rw [mul_pow, ← hc, ← hcs, hsL, hsL, ← map_pow (algebraMap K L),
        ← map_mul (algebraMap K L)]
      congr 1
      simp only [map_mul, map_pow]
      obtain ⟨n, hn⟩ : ∃ n, ℓ = n + 1 := ⟨ℓ - 1, (Nat.sub_add_cancel hℓ.one_le).symm⟩
      rw [hn, Nat.add_sub_cancel, pow_succ]
      have hinv := mul_inv_cancel₀ hs0
      linear_combination (algebraMap A K a * algebraMap A K s ^ n) * hinv
  obtain ⟨hfr, θ, f, hθ, hθf⟩ := hgen

  obtain ⟨T, hT⟩ := wcpa_dj_llsm_kpw_ann_cells Ω W hW hWt ℓ hℓ hΩ hκ A K L 𝔭 u v g y hPD hSolv
    hU hBR hD hfr θ f hθ hθf

  have hmax : ∀ S : Finset ↥W, S.Nonempty → ∃ x ∈ S, ∀ t ∈ S, t ∣ x := by
    intro S
    induction S using Finset.induction_on with
    | empty => intro hS; exact absurd hS Finset.not_nonempty_empty
    | insert a s has ih =>
      intro _
      rcases s.eq_empty_or_nonempty with hs | hs
      · refine ⟨a, Finset.mem_insert_self _ _, fun t ht => ?_⟩
        rcases Finset.mem_insert.mp ht with h | h
        · rw [h]
        · rw [hs] at h; exact absurd h (Finset.notMem_empty t)
      · obtain ⟨x, hx, hxs⟩ := ih hs
        rcases ValuationRing.dvd_total a x with h | h
        · refine ⟨x, Finset.mem_insert_of_mem hx, fun t ht => ?_⟩
          rcases Finset.mem_insert.mp ht with h' | h'
          · rw [h']; exact h
          · exact hxs t h'
        · refine ⟨a, Finset.mem_insert_self _ _, fun t ht => ?_⟩
          rcases Finset.mem_insert.mp ht with h' | h'
          · rw [h']
          · exact dvd_trans (hxs t h') h
  have hbnu : ¬ IsUnit b := mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal b).mp hbm)
  obtain ⟨x, hxT', hxmax⟩ :=
    hmax (insert 1 (T.filter (fun t => t ∣ b ∧ ¬ b ∣ t))) (Finset.insert_nonempty _ _)
  have hxprop : x ∣ b ∧ ¬ b ∣ x := by
    rcases Finset.mem_insert.mp hxT' with h | h
    · rw [h]; exact ⟨one_dvd b, fun h' => hbnu (isUnit_of_dvd_one h')⟩
    · exact (Finset.mem_filter.mp h).2
  obtain ⟨⟨d, hd⟩, hbx⟩ := hxprop
  have hx0 : x ≠ 0 := by
    intro h; apply hb0; rw [hd, h, zero_mul]
  have hd0 : d ≠ 0 := by
    intro h; apply hb0; rw [hd, h, mul_zero]
  have hdnu : ¬ IsUnit d := by
    intro hu
    apply hbx
    rw [hd]
    exact hu.mul_right_dvd.mpr (dvd_refl x)
  obtain ⟨e₀, he₀⟩ := IsAlgClosed.exists_pow_nat_eq ((d : ↥W) : Ω) (by norm_num : 0 < 2)
  have he₀W : e₀ ∈ W := by
    rcases W.mem_or_inv_mem e₀ with h | h
    · exact h
    · exfalso
      apply hdnu
      have he0 : e₀ ≠ 0 := by
        intro h0
        apply hd0
        have h1 : ((d : ↥W) : Ω) = 0 := by rw [← he₀, h0]; ring
        exact_mod_cast h1
      apply isUnit_of_dvd_one
      refine ⟨⟨e₀⁻¹ ^ 2, pow_mem h 2⟩, ?_⟩
      apply Subtype.ext
      show (1 : Ω) = (d : Ω) * (e₀⁻¹ ^ 2)
      rw [← he₀, ← mul_pow, mul_inv_cancel₀ he0, one_pow]
  obtain ⟨e, hee⟩ : ∃ e : ↥W, e * e = d :=
    ⟨⟨e₀, he₀W⟩, Subtype.ext (show e₀ * e₀ = (d : Ω) by rw [← he₀]; ring)⟩
  have he0 : e ≠ 0 := by
    intro h; apply hd0; rw [← hee, h, zero_mul]
  have henu : ¬ IsUnit e := fun hu => hdnu (hee ▸ hu.mul hu)
  have hem : e ∈ IsLocalRing.maximalIdeal ↥W :=
    (IsLocalRing.mem_maximalIdeal e).mpr (mem_nonunits_iff.mpr henu)
  have hcm : x * e ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_left _ x hem
  have hc0 : x * e ≠ 0 := mul_ne_zero hx0 he0
  have hbce : b = x * e * e := by rw [hd, ← hee, mul_assoc]
  have hcb : x * e ∣ b := ⟨e, hbce⟩
  have hbc : ¬ b ∣ x * e := by
    rintro ⟨k, hk⟩
    apply henu
    apply isUnit_of_dvd_one
    refine ⟨k, ?_⟩
    rw [hbce] at hk
    have h1 : x * e * 1 = x * e * (e * k) := by rw [mul_one, ← mul_assoc]; exact hk
    exact mul_left_cancel₀ hc0 h1
  have hcx : ¬ x * e ∣ x := by
    rintro ⟨k, hk⟩
    apply henu
    apply isUnit_of_dvd_one
    refine ⟨k, ?_⟩
    have h1 : x * 1 = x * (e * k) := by rw [mul_one, ← mul_assoc]; exact hk
    exact mul_left_cancel₀ hx0 h1
  have hgap : ∀ t ∈ T, x * e ∣ t → b ∣ t := by
    intro t ht hct
    by_contra hbt
    rcases ValuationRing.dvd_total b t with h | h
    · exact hbt h
    · have htT' : t ∈ insert 1 (T.filter (fun t => t ∣ b ∧ ¬ b ∣ t)) :=
        Finset.mem_insert_of_mem (Finset.mem_filter.mpr ⟨ht, h, hbt⟩)
      exact hcx (dvd_trans hct (hxmax t htT'))

  have hPc := hbelow (x * e) hcm hc0 hcb hbc
  exact hT (x * e) b hcm hc0 hbm hb0 hcb hbg hPc hgap

theorem wcpa_dj_llsm_kp_wild_ann : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
      [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g : ↥W)
      (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.ann u v g) → wcLlsSolvPt W A K L 𝔭 (.ann u v g) y → wcLlsUniq A L 𝔭 y →
    wcLlsBR W A K L 𝔭 (.ann u v g) → Nat.card ↥(wcLlsDec A K L y) = ℓ →
    wcLlsLocMax W A K L (.ann u v g) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g y hPD hSolv hU hBR hD
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  obtain ⟨hy, hcomap, -, -⟩ := id hSolv
  obtain ⟨-, hnzd, -, -, -, -⟩ := id hPD

  have hgen : Module.finrank K L = ℓ ∧ ∃ (θ : L) (f : A), θ ∉ Set.range (algebraMap K L) ∧
      θ ^ ℓ = algebraMap A L f := by
    have hmapint : ∀ (τ : L ≃ₐ[K] L) (x : L), x ∈ integralClosure A L →
        τ x ∈ integralClosure A L := by
      intro τ x hx
      rw [mem_integralClosure_iff] at hx ⊢
      exact hx.map τ
    let fτ : (L ≃ₐ[K] L) → (integralClosure A L →+* integralClosure A L) := fun τ =>
      { toFun := fun x => ⟨τ x, hmapint τ x x.2⟩
        map_one' := Subtype.ext (map_one τ)
        map_mul' := fun a b => Subtype.ext (map_mul τ (a : L) (b : L))
        map_zero' := Subtype.ext (map_zero τ)
        map_add' := fun a b => Subtype.ext (map_add τ (a : L) (b : L)) }
    have hf : ∀ τ (x : integralClosure A L), ((fτ τ x : integralClosure A L) : L) = τ x :=
      fun _ _ => rfl
    have hfA : ∀ τ, (fτ τ).comp (algebraMap A (integralClosure A L)) =
        algebraMap A (integralClosure A L) := by
      intro τ
      refine RingHom.ext fun a => Subtype.ext ?_
      rw [RingHom.comp_apply, hf]
      have e : ((algebraMap A (integralClosure A L) a : integralClosure A L) : L) =
          algebraMap K L (algebraMap A K a) := by
        rw [← IsScalarTower.algebraMap_apply]; rfl
      rw [e]
      exact τ.commutes _
    have hstab : ∀ τ (x : integralClosure A L), x ∈ y → fτ τ x ∈ y := by
      intro τ x hx
      have h1 : y.comap (fτ τ) = y := by
        apply hU
        · exact Ideal.comap_isPrime _ _
        · rw [Ideal.comap_comap, hfA, hcomap]
      have h2 : x ∈ y.comap (fτ τ) := by rw [h1]; exact hx
      exact h2
    have hDec : wcLlsDec A K L y = ⊤ := by
      rw [eq_top_iff]
      intro σ _
      open Pointwise in
      (rw [wcLlsDec, MulAction.mem_stabilizer_iff]
       ext z
       rw [Set.mem_smul_set]
       constructor
       · rintro ⟨w, ⟨x, hx, rfl⟩, rfl⟩
         exact ⟨fτ σ x, hstab σ x hx, rfl⟩
       · rintro ⟨x, hx, rfl⟩
         refine ⟨_, ⟨fτ σ⁻¹ x, hstab σ⁻¹ x hx, rfl⟩, ?_⟩
         rw [AlgEquiv.smul_def, hf, ← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply])
    have hcardG : Nat.card (L ≃ₐ[K] L) = ℓ := by rw [← hD, hDec, Subgroup.card_top]
    have hfr : Module.finrank K L = ℓ := by rw [← IsGalois.card_aut_eq_finrank, hcardG]
    refine ⟨hfr, ?_⟩
    have hℓΩ : (ℓ : Ω) ≠ 0 := by
      intro h
      rcases (Nat.dvd_prime hℓ).mp (ringChar.dvd h) with h1 | h1
      · exact CharP.ringChar_ne_one h1
      · exact hΩ h1
    haveI : NeZero (ℓ : Ω) := ⟨hℓΩ⟩
    obtain ⟨ζ, hζ⟩ : ∃ ζ : Ω, IsPrimitiveRoot ζ ℓ := HasEnoughRootsOfUnity.prim
    have hζW : ζ ∈ W := by
      rcases W.mem_or_inv_mem ζ with h | h
      · exact h
      · have h1 : ζ * ζ ^ (ℓ - 1) = 1 := by
          rw [← pow_succ', Nat.sub_add_cancel hℓ.one_le]; exact hζ.pow_eq_one
        have h2 : ζ = (ζ⁻¹) ^ (ℓ - 1) := by rw [inv_pow]; exact eq_inv_of_mul_eq_one_left h1
        rw [h2]; exact pow_mem h _
    have hζW' : IsPrimitiveRoot (⟨ζ, hζW⟩ : ↥W) ℓ :=
      IsPrimitiveRoot.of_map_of_injective (f := W.subtype) (by exact hζ) Subtype.val_injective
    have hWA : Function.Injective (algebraMap ↥W A) := by
      rw [injective_iff_map_eq_zero]
      intro a ha
      have : a • (1 : A) = 0 := by rw [Algebra.smul_def, ha, zero_mul]
      rcases smul_eq_zero.mp this with h | h
      · exact h
      · exact absurd h one_ne_zero
    have hζK : IsPrimitiveRoot (algebraMap A K (algebraMap ↥W A ⟨ζ, hζW⟩)) ℓ :=
      (hζW'.map_of_injective hWA).map_of_injective (IsFractionRing.injective A K)
    have hprim : (primitiveRoots (Module.finrank K L) K).Nonempty :=
      ⟨_, (mem_primitiveRoots (by rw [hfr]; exact hℓ.pos)).mpr (by rw [hfr]; exact hζK)⟩
    haveI : IsCyclic (L ≃ₐ[K] L) := isCyclic_of_prime_card hcardG
    have key := exists_root_adjoin_eq_top_of_isCyclic K L hprim
    rw [hfr] at key
    obtain ⟨α, hαpow, hαtop⟩ := key
    have hαK : α ∉ Set.range (algebraMap K L) := by
      rintro ⟨k, hk⟩
      have h1 : IntermediateField.adjoin K {α} = ⊥ := by
        rw [IntermediateField.adjoin_simple_eq_bot_iff, IntermediateField.mem_bot]; exact ⟨k, hk⟩
      have h2 : Module.finrank K L = 1 := by
        rw [← IntermediateField.finrank_top', ← hαtop, h1, IntermediateField.finrank_bot]
      rw [hfr] at h2
      exact hℓ.one_lt.ne' h2
    obtain ⟨c, hc⟩ := hαpow
    obtain ⟨a, s, hs, hcs⟩ := IsFractionRing.div_surjective A c
    have hs0 : algebraMap A K s ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hs
    refine ⟨algebraMap A L s * α, a * s ^ (ℓ - 1), ?_, ?_⟩
    · rintro ⟨k, hk⟩
      apply hαK
      refine ⟨k / algebraMap A K s, ?_⟩
      have hsL : algebraMap A L s = algebraMap K L (algebraMap A K s) :=
        IsScalarTower.algebraMap_apply A K L s
      have hsL0 : algebraMap A L s ≠ 0 := by
        rw [hsL]; exact (map_ne_zero _).mpr hs0
      rw [map_div₀, hk, ← hsL]
      field_simp
    · have hsL : ∀ x : A, algebraMap A L x = algebraMap K L (algebraMap A K x) :=
        fun x => IsScalarTower.algebraMap_apply A K L x
      rw [mul_pow, ← hc, ← hcs, hsL, hsL, ← map_pow (algebraMap K L),
        ← map_mul (algebraMap K L)]
      congr 1
      simp only [map_mul, map_pow]
      obtain ⟨n, hn⟩ : ∃ n, ℓ = n + 1 := ⟨ℓ - 1, (Nat.sub_add_cancel hℓ.one_le).symm⟩
      rw [hn, Nat.add_sub_cancel, pow_succ]
      have hinv := mul_inv_cancel₀ hs0
      linear_combination (algebraMap A K a * algebraMap A K s ^ n) * hinv

  obtain ⟨hfr, θ, f, hθ, hθf⟩ := hgen
  obtain ⟨b, hbm, hb0, hbg, hbelow, habove⟩ :=
    wcpa_dj_llsm_kpw_ann_cut Ω W hW hWt ℓ hℓ hΩ hκ A K L 𝔭 u v g y hPD hSolv hU hBR hD hfr
      θ f hθ hθf
  have hPb : wcLlsAnnSep W A K L u b :=
    wcpa_dj_llsm_kpw_ann_sep_limit Ω W hW hWt ℓ hℓ hΩ hκ A K L 𝔭 u v g y hPD hSolv hU hBR hD
      b hbm hb0 hbg hbelow
  show ∃ b ∈ IsLocalRing.maximalIdeal ↥W, b ≠ 0 ∧ b ∣ g ∧ wcLlsAnnSep W A K L u b ∧
    ∀ b' ∈ IsLocalRing.maximalIdeal ↥W, b' ≠ 0 → b' ∣ g → b ∣ b' → wcLlsAnnSep W A K L u b' →
      b' ∣ b
  refine ⟨b, hbm, hb0, hbg, hPb, ?_⟩
  intro b' hb'm hb'0 hb'g hbb' hPb'
  by_contra h
  exact habove b' hb'm hb'0 hb'g hbb' h hPb'

theorem wcpa_dj_llsm_kummer_prime : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → wcLlsLocThmBR W (· = ℓ) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 k y hPD hSolv hUniq hBR hcard
  have hcard' : Nat.card ↥(wcLlsDec A K L y) = ℓ := hcard

  have hsplit : ringChar (IsLocalRing.ResidueField ↥W) ≠ ℓ →
      (∃ (θ : L) (f : A), θ ∉ Set.range (algebraMap K L) ∧ θ ^ ℓ = algebraMap A L f ∧ f ∉ 𝔭) →
      False := by
    intro hκ ⟨θ, f, hθ, hθf, hf⟩
    obtain ⟨y₁, y₂, h1, h2, h1c, h2c, hne⟩ :=
      wcpa_dj_llsm_kp_unit_split Ω W ℓ hℓ hκ A K L 𝔭 k hPD θ f hθ hθf hf
    exact hne ((hUniq y₁ h1 h1c).trans (hUniq y₂ h2 h2c).symm)
  by_cases hκ : ringChar (IsLocalRing.ResidueField ↥W) = ℓ
  ·
    cases k with
    | disc t =>
      exact wcpa_dj_llsm_kp_wild_disc Ω W hW hWt ℓ hℓ hΩ hκ A K L 𝔭 t y hPD hSolv hUniq hBR hcard'
    | ann u v g =>
      exact wcpa_dj_llsm_kp_wild_ann Ω W hW hWt ℓ hℓ hΩ hκ A K L 𝔭 u v g y hPD hSolv hUniq hBR
        hcard'
  ·
    obtain ⟨hy, hyc, -, hδ⟩ := hSolv
    cases k with
    | disc t =>
      rcases wcpa_dj_llsm_kp_tame_disc Ω W hW hWt ℓ hℓ hκ A K L 𝔭 t y hPD hy hyc hUniq hBR
          hcard' with hgen | hδ0
      · exact (hsplit hκ hgen).elim
      · exact (hδ hy t rfl (hδ0 hy)).elim
    | ann u v g =>
      rcases wcpa_dj_llsm_kp_tame_ann Ω W hW hWt ℓ hℓ hκ A K L 𝔭 u v g y hPD hy hyc hUniq hBR
          hcard' with hgen | hgood
      · exact (hsplit hκ hgen).elim
      · have hsep : wcLlsAnnSep W A K L u g :=
          wcpa_dj_llsm_kp_ann_full_sep Ω W A K L 𝔭 u v g y hPD hy hyc hUniq hgood
        obtain ⟨-, -, -, -, -, hg, hg0, -⟩ := hPD
        show ∃ b : ↥W, b ∈ IsLocalRing.maximalIdeal ↥W ∧ b ≠ 0 ∧ b ∣ g ∧
          wcLlsAnnSep W A K L u b ∧
          ∀ b' : ↥W, b' ∈ IsLocalRing.maximalIdeal ↥W → b' ≠ 0 → b' ∣ g → b ∣ b' →
            wcLlsAnnSep W A K L u b' → b' ∣ b
        exact ⟨g, hg, hg0, dvd_refl g, hsep, fun b' _ _ hb'g _ _ => hb'g⟩

theorem wcLlsAS_generator : ∀ (ℓ : ℕ), ℓ.Prime →
    ∀ (A : Type u) [CommRing A] [IsDomain A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (y : Ideal ↥(integralClosure A L)),
    ((ℓ : ℕ) : K) = 0 → y.IsPrime → y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
    wcLlsUniq A L 𝔭 y → Nat.card ↥(wcLlsDec A K L y) = ℓ →
    Module.finrank K L = ℓ ∧ ∃ α : L, α ∉ Set.range (algebraMap K L) ∧
      α ^ ℓ - α ∈ Set.range (algebraMap K L) :=
by
  intro ℓ hℓ A _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 y hK hy hcomap hU hD
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩

  have hmapint : ∀ (τ : L ≃ₐ[K] L) (x : L), x ∈ integralClosure A L →
      τ x ∈ integralClosure A L := by
    intro τ x hx
    rw [mem_integralClosure_iff] at hx ⊢
    exact hx.map τ
  let f : (L ≃ₐ[K] L) → (integralClosure A L →+* integralClosure A L) := fun τ =>
    { toFun := fun x => ⟨τ x, hmapint τ x x.2⟩
      map_one' := Subtype.ext (map_one τ)
      map_mul' := fun a b => Subtype.ext (map_mul τ (a : L) (b : L))
      map_zero' := Subtype.ext (map_zero τ)
      map_add' := fun a b => Subtype.ext (map_add τ (a : L) (b : L)) }
  have hf : ∀ τ (x : integralClosure A L), ((f τ x : integralClosure A L) : L) = τ x :=
    fun _ _ => rfl
  have hfA : ∀ τ, (f τ).comp (algebraMap A (integralClosure A L)) =
      algebraMap A (integralClosure A L) := by
    intro τ
    refine RingHom.ext fun a => Subtype.ext ?_
    rw [RingHom.comp_apply, hf]
    have e : ((algebraMap A (integralClosure A L) a : integralClosure A L) : L) =
        algebraMap K L (algebraMap A K a) := by
      rw [← IsScalarTower.algebraMap_apply]; rfl
    rw [e]
    exact τ.commutes _
  have hstab : ∀ τ (x : integralClosure A L), x ∈ y → f τ x ∈ y := by
    intro τ x hx
    have h1 : y.comap (f τ) = y := by
      apply hU
      · exact Ideal.comap_isPrime _ _
      · rw [Ideal.comap_comap, hfA, hcomap]
    have h2 : x ∈ y.comap (f τ) := by rw [h1]; exact hx
    exact h2
  have hDec : wcLlsDec A K L y = ⊤ := by
    rw [eq_top_iff]
    intro σ _
    open Pointwise in
    (rw [wcLlsDec, MulAction.mem_stabilizer_iff]
     ext z
     rw [Set.mem_smul_set]
     constructor
     · rintro ⟨w, ⟨x, hx, rfl⟩, rfl⟩
       exact ⟨f σ x, hstab σ x hx, rfl⟩
     · rintro ⟨x, hx, rfl⟩
       refine ⟨_, ⟨f σ⁻¹ x, hstab σ⁻¹ x hx, rfl⟩, ?_⟩
       rw [AlgEquiv.smul_def, hf, ← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply])

  have hcardG : Nat.card (L ≃ₐ[K] L) = ℓ := by rw [← hD, hDec, Subgroup.card_top]
  have hfr : Module.finrank K L = ℓ := by rw [← IsGalois.card_aut_eq_finrank, hcardG]
  refine ⟨hfr, ?_⟩

  haveI : Nontrivial (L ≃ₐ[K] L) := by
    rw [← Finite.one_lt_card_iff_nontrivial, hcardG]; exact hℓ.one_lt
  obtain ⟨σ, hσ1⟩ := exists_ne (1 : L ≃ₐ[K] L)
  have hσℓ : σ ^ ℓ = 1 := by rw [← hcardG]; exact pow_card_eq_one'
  have hord : orderOf σ = ℓ := orderOf_eq_prime hσℓ hσ1
  have hinj : ∀ a ∈ Finset.range ℓ, ∀ b ∈ Finset.range ℓ, σ ^ a = σ ^ b → a = b := by
    intro a ha b hb hab
    exact pow_injOn_Iio_orderOf (x := σ) (by rw [hord]; simpa using ha)
      (by rw [hord]; simpa using hb) hab
  have himg : (Finset.range ℓ).image (fun i => σ ^ i) = Finset.univ := by
    apply Finset.eq_univ_of_card
    rw [Finset.card_image_of_injOn (fun a ha b hb hab => hinj a ha b hb hab), Finset.card_range,
      ← Nat.card_eq_fintype_card, hcardG]
  have gen : ∀ τ : L ≃ₐ[K] L, ∃ i < ℓ, τ = σ ^ i := by
    intro τ
    have : τ ∈ (Finset.range ℓ).image (fun i => σ ^ i) := by
      rw [himg]; exact Finset.mem_univ _
    obtain ⟨i, hi, h⟩ := Finset.mem_image.mp this
    exact ⟨i, Finset.mem_range.mp hi, h.symm⟩

  have hLℓ : ((ℓ : ℕ) : L) = 0 := by rw [← map_natCast (algebraMap K L), hK, map_zero]
  haveI : CharP L ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hLℓ
  obtain ⟨β, hβ⟩ := Algebra.trace_surjective K L 1
  have hsum1 : ∑ i ∈ Finset.range ℓ, (σ ^ i) β = 1 := by
    have h := trace_eq_sum_automorphisms (K := K) (L := L) β
    rw [hβ, map_one] at h
    rw [h, ← himg, Finset.sum_image hinj]
  obtain ⟨s, hs⟩ : ∃ s : ℕ → L, ∀ i, s i = (σ ^ i) β := ⟨_, fun _ => rfl⟩
  have hsum1' : ∑ i ∈ Finset.range ℓ, s i = 1 := by simp only [hs]; exact hsum1
  have hσs : ∀ i, σ (s i) = s (i + 1) := by
    intro i; rw [hs, hs, pow_succ', AlgEquiv.mul_apply]
  have hsℓ : s ℓ = s 0 := by rw [hs, hs, hσℓ, pow_zero]
  obtain ⟨α, hα⟩ : ∃ α : L, α = -∑ i ∈ Finset.range ℓ, (i : L) * s i := ⟨_, rfl⟩
  have hσα : σ α = α + 1 := by
    have e1 : σ α = -∑ i ∈ Finset.range ℓ, (i : L) * s (i + 1) := by
      rw [hα, map_neg, map_sum]
      congr 1
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, map_natCast, hσs]
    have e2 : ∑ i ∈ Finset.range ℓ, (i : L) * s (i + 1) =
        ∑ i ∈ Finset.range ℓ, ((i + 1 : ℕ) : L) * s (i + 1) -
          ∑ i ∈ Finset.range ℓ, s (i + 1) := by
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      push_cast; ring
    have e3 : ∑ i ∈ Finset.range ℓ, ((i + 1 : ℕ) : L) * s (i + 1) =
        ∑ i ∈ Finset.range ℓ, (i : L) * s i := by
      have h1 := Finset.sum_range_succ' (fun i => (i : L) * s i) ℓ
      rw [Finset.sum_range_succ] at h1
      simp only [Nat.cast_zero, zero_mul, add_zero, hLℓ] at h1
      exact h1.symm
    have e4 : ∑ i ∈ Finset.range ℓ, s (i + 1) = ∑ i ∈ Finset.range ℓ, s i := by
      have h1 := Finset.sum_range_succ' s ℓ
      rw [Finset.sum_range_succ, hsℓ] at h1
      exact (add_right_cancel h1).symm
    rw [e1, e2, e3, e4, hsum1', hα]; ring

  have hpow : ∀ i : ℕ, (σ ^ i) α = α + i := by
    intro i
    induction i with
    | zero => simp
    | succ n ih =>
      rw [pow_succ', AlgEquiv.mul_apply, ih, map_add, map_natCast, hσα]; push_cast; ring
  have hfrob : ∀ n : ℕ, (n : L) ^ ℓ = n := by
    intro n; rw [← frobenius_def, map_natCast]
  refine ⟨α, ?_, ?_⟩
  · rintro ⟨k, hk⟩
    have h1 : σ α = α := by rw [← hk]; exact σ.commutes k
    rw [hσα] at h1
    exact one_ne_zero (by linear_combination h1)
  · rw [IsGalois.mem_range_algebraMap_iff_fixed]
    intro τ
    obtain ⟨i, -, rfl⟩ := gen τ
    rw [map_sub, map_pow, hpow, add_pow_char, hfrob]; ring

theorem wcLlsAS_dse_etale_sep : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ((ℓ : ℕ) : K) = 0 → Module.finrank K L = ℓ →
    ∀ (α : L) (f : K), α ∉ Set.range (algebraMap K L) → α ^ ℓ - α = algebraMap K L f →
    ∀ c b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    algebraMap A K (t - algebraMap ↥W A c) ≠ 0 → ∀ (h s : K),
    s = algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c) →
    ∀ p q : ↥(Algebra.adjoin A {s}),
    (∃ a₀ : A, a₀ ∉ 𝔭 ∧ q - algebraMap A ↥(Algebra.adjoin A {s}) a₀ ∈
      Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c),
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) →
    (f - h ^ ℓ + h) * (q : K) = (p : K) → wcLlsDiscSep W A K L t c b :=
by
  intro Ω _ _ W hW hWt ℓ hℓ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD hK hfin α f hα hf c b hc hb hb0
    hu h s hs p q hqN hFq
  classical
  obtain ⟨a₀, ha₀, hqN⟩ := hqN

  obtain ⟨A', iCR, iDom, iWA, iAK, iFr, iAL, iTow, u', v', 𝔭', hBr, hu', hv', hPD', hSep, -, -⟩ :=
    wcpa_dj_llsm_br_boundary_chart Ω W hW hWt A K L 𝔭 (.disc t) (t - algebraMap ↥W A c) b hPD
      (Or.inl ⟨t, c, rfl, hc, rfl⟩) hb hb0
  rw [← hs] at hBr hv'
  have hPDc := hPD
  obtain ⟨-, -, -, hmax, -, -, h𝔭eq, -⟩ := hPDc
  have hPDc' := hPD'
  obtain ⟨hft', -, hic', hmax', hm𝔭', -, -, -, h𝔭'eq, -⟩ := hPDc'

  show wcLlsSepAt W A K L (t - algebraMap ↥W A c)
    (algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c))
  rw [hSep b hb hb0 (dvd_refl b)]
  apply wcpa_dj_llsm_br_ann_node_sep Ω W hW hWt A' K L 𝔭' u' v' b hPD'
  intro y hy hyc hy'
  haveI := hic'
  have hψinj : Function.Injective (algebraMap A' K) := IsFractionRing.injective A' K
  have hsc : ∀ z : A', algebraMap A' L z = algebraMap K L (algebraMap A' K z) :=
    IsScalarTower.algebraMap_apply A' K L

  have hlift : ∀ x : ↥(Algebra.adjoin A {s}), ∃ x' : A', algebraMap A' K x' = (x : K) :=
    fun x => hBr.2.1 x.2
  choose ιf hιf using hlift
  let ι : ↥(Algebra.adjoin A {s}) →+* A' :=
    { toFun := ιf
      map_one' := hψinj (by simp [hιf])
      map_mul' := fun x y => hψinj (by simp [hιf])
      map_zero' := hψinj (by simp [hιf])
      map_add' := fun x y => hψinj (by simp [hιf]) }
  have hval : ∀ (x : ↥(Algebra.adjoin A {s})) (a' : A'), algebraMap A' K a' = (x : K) →
      ι x = a' := fun x a' ha => hψinj ((hιf x).trans ha.symm)
  have hW' : ∀ w : ↥W, ι (algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w)) =
      algebraMap ↥W A' w := fun w => hval _ _ (by rw [hBr.1 w, Subalgebra.coe_algebraMap])
  have hu'm : u' ∈ 𝔭' := by
    rw [h𝔭'eq]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hv'm : v' ∈ 𝔭' := by
    rw [h𝔭'eq]
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
  have hmW : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, algebraMap ↥W A' w ∈ 𝔭' :=
    fun w hw => hm𝔭' (Ideal.mem_map_of_mem _ hw)
  have hN : Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c),
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) ≤ 𝔭'.comap ι := by
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      intro x hx
      rcases Set.mem_insert_iff.mp hx with hx | hx
      · rw [hx]
        refine Ideal.mem_comap.mpr ?_
        rw [hval _ u' (by rw [hu', Subalgebra.coe_algebraMap])]
        exact hu'm
      · rw [Set.mem_singleton_iff.mp hx]
        refine Ideal.mem_comap.mpr ?_
        rw [hval _ v' hv']
        exact hv'm
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      refine Ideal.mem_comap.mpr (Ideal.mem_comap.mpr ?_)
      show ι (algebraMap A _ (algebraMap ↥W A w)) ∈ 𝔭'
      rw [hW' w]
      exact hmW w hw
  have hκt : ι (algebraMap A ↥(Algebra.adjoin A {s}) t) = u' + algebraMap ↥W A' c :=
    hval _ _ (by rw [map_add, hu', hBr.1 c, Subalgebra.coe_algebraMap, map_sub, sub_add_cancel])
  have h𝔭le : 𝔭 ≤ 𝔭'.comap (ι.comp (algebraMap A ↥(Algebra.adjoin A {s}))) := by
    rw [h𝔭eq]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      show ι (algebraMap A _ t) ∈ 𝔭'
      rw [hκt]
      exact 𝔭'.add_mem hu'm (hmW c hc)
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      show ι (algebraMap A _ (algebraMap ↥W A w)) ∈ 𝔭'
      rw [hW' w]
      exact hmW w hw
  have h𝔭eq' := hmax.eq_of_le (Ideal.comap_ne_top _ hmax'.ne_top) h𝔭le
  have hq'n : ι q ∉ 𝔭' := by
    intro hq'
    have h1 : ι (q - algebraMap A _ a₀) ∈ 𝔭' := hN hqN
    rw [map_sub] at h1
    have h2 : ι (algebraMap A _ a₀) ∈ 𝔭' := by
      have := 𝔭'.sub_mem hq' h1
      rwa [sub_sub_cancel] at this
    apply ha₀
    rw [h𝔭eq']
    exact h2
  have hq'K : algebraMap A' K (ι q) = (q : K) := hιf q
  have hp'K : algebraMap A' K (ι p) = (p : K) := hιf p

  have hA'ℓ : ((ℓ : ℕ) : A') = 0 := hψinj (by rw [map_natCast, hK, map_zero])
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : CharP L ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr
    (by rw [← map_natCast (algebraMap K L), hK, map_zero])

  have e1 := congrArg (algebraMap K L) hFq
  simp only [map_mul, map_add, map_sub, map_pow] at e1
  have e2 : algebraMap A' L (ι q) * (α ^ ℓ - α - (algebraMap K L h ^ ℓ - algebraMap K L h)) =
      algebraMap A' L (ι p) := by
    rw [hsc (ι q), hsc (ι p), hq'K, hp'K]
    linear_combination e1 + algebraMap K L (q : K) * hf
  generalize ι q = q' at hq'n hq'K e2
  generalize ι p = p' at hp'K e2
  have hq'0 : q' ≠ 0 := fun h0 => hq'n (h0 ▸ 𝔭'.zero_mem)
  have hqL0 : algebraMap A' L q' ≠ 0 := by
    rw [hsc]; exact (map_ne_zero _).mpr ((map_ne_zero_iff _ hψinj).mpr hq'0)

  have hpow : algebraMap A' L q' ^ ℓ = algebraMap A' L q' ^ (ℓ - 1) * algebraMap A' L q' := by
    rw [← pow_succ, Nat.sub_add_cancel hℓ.one_lt.le]
  have hQmon : ∀ k : A', (Polynomial.X ^ ℓ -
      (Polynomial.C (q' ^ (ℓ - 1)) * Polynomial.X + Polynomial.C k)).Monic :=
    fun k => Polynomial.monic_X_pow_sub
      (lt_of_le_of_lt Polynomial.degree_linear_le (by exact_mod_cast hℓ.one_lt))
  have hQdeg : ∀ k : A', (Polynomial.X ^ ℓ -
      (Polynomial.C (q' ^ (ℓ - 1)) * Polynomial.X + Polynomial.C k)).natDegree = ℓ := by
    intro k
    rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt, Polynomial.natDegree_X_pow]
    rw [Polynomial.natDegree_X_pow]
    exact lt_of_le_of_lt Polynomial.natDegree_linear_le hℓ.one_lt
  have hQder : ∀ k : A', Polynomial.derivative (Polynomial.X ^ ℓ -
      (Polynomial.C (q' ^ (ℓ - 1)) * Polynomial.X + Polynomial.C k)) =
      Polynomial.C (-(q' ^ (ℓ - 1))) := by
    intro k
    rw [Polynomial.derivative_sub, Polynomial.derivative_add, Polynomial.derivative_X_pow,
      Polynomial.derivative_C_mul_X, Polynomial.derivative_C, hA'ℓ, Polynomial.C_0, zero_mul,
      add_zero, zero_sub, Polynomial.C_neg]
  have hQev : ∀ (k : A') (z : L), Polynomial.aeval z (Polynomial.X ^ ℓ -
      (Polynomial.C (q' ^ (ℓ - 1)) * Polynomial.X + Polynomial.C k)) =
      z ^ ℓ - (algebraMap A' L (q' ^ (ℓ - 1)) * z + algebraMap A' L k) := by
    intro k z
    simp only [map_sub, map_add, map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
  have hx0 : Polynomial.aeval (algebraMap A' L q' * (α - algebraMap K L h)) (Polynomial.X ^ ℓ -
      (Polynomial.C (q' ^ (ℓ - 1)) * Polynomial.X + Polynomial.C (q' ^ (ℓ - 1) * p'))) = 0 := by
    rw [hQev]
    simp only [map_mul, map_pow, mul_pow, sub_pow_char]
    linear_combination (α ^ ℓ - algebraMap K L h ^ ℓ) * hpow + algebraMap A' L q' ^ (ℓ - 1) * e2
  have hxint : IsIntegral A' (algebraMap A' L q' * (α - algebraMap K L h)) :=
    ⟨_, hQmon (q' ^ (ℓ - 1) * p'), by rw [← Polynomial.aeval_def]; exact hx0⟩
  let xB : ↥(integralClosure A' L) := ⟨_, (mem_integralClosure_iff A' L).mpr hxint⟩

  obtain ⟨r, hr⟩ := wcpa_dj_llsm_kpwbe_residue_const Ω W (wcpa_dj_nc_residue_algclosed Ω W) A'
    ↥(integralClosure A' L) 𝔭' y hft' hmax' hm𝔭' hy hyc xB
  obtain ⟨θB, hθBdef⟩ : ∃ θB : ↥(integralClosure A' L),
      θB = xB - algebraMap A' ↥(integralClosure A' L) (algebraMap ↥W A' r) := ⟨_, rfl⟩
  have hθy : θB ∈ y := hθBdef ▸ hr
  have hθL : (θB : L) = algebraMap A' L q' * (α - algebraMap K L h) -
      algebraMap A' L (algebraMap ↥W A' r) := by
    rw [hθBdef]; rfl

  have hθK : (θB : L) ∉ Set.range (algebraMap K L) := by
    rintro ⟨k, hk⟩
    apply hα
    refine ⟨h + (k + algebraMap A' K (algebraMap ↥W A' r)) / (q : K), ?_⟩
    rw [hθL, hsc q', hsc (algebraMap ↥W A' r), hq'K] at hk
    have hq0 : algebraMap K L (q : K) ≠ 0 := by rw [← hq'K, ← hsc]; exact hqL0
    rw [map_add, map_div₀, map_add, hk, sub_add_cancel, mul_div_cancel_left₀ _ hq0]
    ring

  have hθroot : Polynomial.aeval (θB : L) (Polynomial.X ^ ℓ -
      (Polynomial.C (q' ^ (ℓ - 1)) * Polynomial.X + Polynomial.C (q' ^ (ℓ - 1) * p' +
        q' ^ (ℓ - 1) * algebraMap ↥W A' r - algebraMap ↥W A' r ^ ℓ))) = 0 := by
    rw [hQev, hθL]
    simp only [map_sub, map_add, map_mul, map_pow, mul_pow, sub_pow_char]
    linear_combination (α ^ ℓ - algebraMap K L h ^ ℓ) * hpow + algebraMap A' L q' ^ (ℓ - 1) * e2
  obtain ⟨hmin, hadj⟩ := wcpa_dj_llsm_kpwbe_minpoly_prime A' K L ℓ hℓ hfin (θB : L) _ hθK
    (hQmon _) (hQdeg _) hθroot

  refine wcpa_dj_llsm_kpwbe_local_node Ω W A' K L 𝔭' u' v' b y hPD' hy hyc θB hθy hadj ?_ hy'
  intro z hz hzy
  rw [hmin, hQder, Polynomial.aeval_C] at hz
  have hz' : z = algebraMap A' ↥(integralClosure A' L) (-(q' ^ (ℓ - 1))) := Subtype.ext hz
  have hmem : -(q' ^ (ℓ - 1)) ∈ 𝔭' := by
    rw [← hyc, Ideal.mem_comap, ← hz']; exact hzy
  exact hq'n (hmax'.isPrime.mem_of_pow_mem _ (neg_mem_iff.mp hmem))

theorem wcLlsASi_annsep_swap : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u)
    [Field L] [Algebra K L] (u v : A) (g : ↥W), u * v = algebraMap ↥W A g →
    algebraMap A K u ≠ 0 → algebraMap A K v ≠ 0 → wcLlsAnnSep W A K L v g →
    wcLlsAnnSep W A K L u g :=
by
  intro Ω _ W A _ _ _ K _ _ L _ _ u v g huv hu hv hV
  have hg : algebraMap A K (algebraMap ↥W A g) = algebraMap A K u * algebraMap A K v := by
    rw [← huv, map_mul]
  have e1 : algebraMap A K (algebraMap ↥W A g) / algebraMap A K v = algebraMap A K u := by
    rw [hg, mul_div_cancel_right₀ _ hv]
  have e2 : algebraMap A K (algebraMap ↥W A g) / algebraMap A K u = algebraMap A K v := by
    rw [hg, mul_div_cancel_left₀ _ hu]
  have hbot : ∀ a : A, Algebra.adjoin A {algebraMap A K a} = ⊥ := fun a =>
    eq_bot_iff.mpr (Algebra.adjoin_le (Set.singleton_subset_iff.mpr
      (Algebra.mem_bot.mpr ⟨a, rfl⟩)))
  unfold wcLlsAnnSep at hV ⊢
  rw [e1] at hV
  rw [e2]
  unfold wcLlsSepAt at hV ⊢
  have key : ∀ (S T : Subalgebra A K), S = T → ∀ (x y : S) (x' y' : T),
      (x : K) = (y' : K) → (y : K) = (x' : K) →
      (∀ (𝔮 : Ideal (integralClosure S L)) [𝔮.IsPrime],
        𝔮.comap (algebraMap S (integralClosure S L)) =
          Ideal.span {x, y} ⊔ (IsLocalRing.maximalIdeal ↥W).map
            ((algebraMap A S).comp (algebraMap ↥W A)) →
        ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
          (algebraMap ↥W A))) S 𝔮)) →
      (∀ (𝔮 : Ideal (integralClosure T L)) [𝔮.IsPrime],
        𝔮.comap (algebraMap T (integralClosure T L)) =
          Ideal.span {x', y'} ⊔ (IsLocalRing.maximalIdeal ↥W).map
            ((algebraMap A T).comp (algebraMap ↥W A)) →
        ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
          (algebraMap ↥W A))) T 𝔮)) := by
    intro S T hST x y x' y' h1 h2 H
    subst hST
    have hx : x = y' := Subtype.ext h1
    have hy : y = x' := Subtype.ext h2
    subst hx hy
    intro 𝔮 _ h𝔮
    exact H 𝔮 (by rw [h𝔮, Set.pair_comm])
  exact key _ _ ((hbot u).trans (hbot v).symm) _ _ _ _ rfl rfl hV

theorem wcLlsASin_points : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A]
    [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u)
    [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] (𝔭 : Ideal A) (u v d d' : A)
    (g β lam : ↥W) (ℓ n a m : ℕ) (x ρ : L) (y : Ideal ↥(integralClosure A L)) [y.IsPrime],
    ℓ.Prime → 0 < n → 1 ≤ a → a * n = 1 + m * ℓ → u ∈ 𝔭 → v ∈ 𝔭 → d ∉ 𝔭 → d' ∉ 𝔭 →
    u * v = algebraMap ↥W A g → β ^ ℓ = g → algebraMap A L u ≠ 0 → ρ ≠ 0 →
    x ^ ℓ = algebraMap A L u * ρ ^ a →
    algebraMap A L d' * ρ ^ (m * (ℓ - 1) + 1) - algebraMap A L d * ρ ^ (m * (ℓ - 1)) +
      algebraMap A L d * algebraMap A L (algebraMap ↥W A lam) * x ^ (n * (ℓ - 1)) = 0 →
    y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
    ∃ (xh eh rh : Localization.AtPrime y) (Xt : ↥(integralClosure A L)) (St : A), St ∉ 𝔭 ∧
      algebraMap ↥(integralClosure A L) (Localization.AtPrime y) Xt =
        xh * algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
          (algebraMap A ↥(integralClosure A L) St) ∧
      (Xt : L) = x * algebraMap A L St ∧
      xh ∈ IsLocalRing.maximalIdeal (Localization.AtPrime y) ∧
      eh ∈ IsLocalRing.maximalIdeal (Localization.AtPrime y) ∧ IsUnit rh ∧
      xh * eh = algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
        (algebraMap A ↥(integralClosure A L) (algebraMap ↥W A β)) ∧
      xh ^ ℓ = algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
        (algebraMap A ↥(integralClosure A L) u) * rh ^ a ∧
      eh ^ ℓ * rh ^ a = algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
        (algebraMap A ↥(integralClosure A L) v) ∧
      algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
          (algebraMap A ↥(integralClosure A L) d') * rh ^ (m * (ℓ - 1) + 1) -
        algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
          (algebraMap A ↥(integralClosure A L) d) * rh ^ (m * (ℓ - 1)) +
        algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
          (algebraMap A ↥(integralClosure A L) d) *
        algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
          (algebraMap A ↥(integralClosure A L) (algebraMap ↥W A lam)) * xh ^ (n * (ℓ - 1)) = 0 ∧
      algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
          (algebraMap A ↥(integralClosure A L) d') * rh -
        algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
          (algebraMap A ↥(integralClosure A L) d) ∈ IsLocalRing.maximalIdeal (Localization.AtPrime y) :=
by
  intro Ω _ W A _ _ _ K _ _ _ L _ _ _ _ 𝔭 u v d d' g β lam ℓ n a m x ρ y _ hℓ hn ha han hu hv hd hd'
    huv hβ hu0 hρ hH1 hH2 hy
  classical
  subst hy
  obtain ⟨k, rfl⟩ : ∃ k, ℓ = k + 1 := ⟨ℓ - 1, by have := hℓ.two_le; omega⟩
  have hk : 0 < k := by have := hℓ.two_le; omega
  obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by omega⟩
  simp only [Nat.add_sub_cancel] at hH2 ⊢
  have hyP : y.IsPrime := inferInstance
  have hcoe : ∀ c : A, ((algebraMap A (integralClosure A L) c : integralClosure A L) : L) =
      algebraMap A L c := fun _ => rfl

  have root_mem : ∀ (e : ℕ) (w : L) (c : A) (P : integralClosure A L), 0 < e →
      algebraMap A (integralClosure A L) c ∈ y → w ^ e = algebraMap A L c * (P : L) →
      ∃ Wt : integralClosure A L, (Wt : L) = w ∧ Wt ∈ y := by
    intro e w c P he hc hw
    have hQ : _root_.IsIntegral A (w ^ e) := by
      rw [hw]
      exact (algebraMap A (integralClosure A L) c * P).2
    have hwi : _root_.IsIntegral A w := IsIntegral.of_pow he hQ
    refine ⟨⟨w, hwi⟩, rfl, ?_⟩
    have h1 : (⟨w, hwi⟩ : integralClosure A L) ^ e = algebraMap A (integralClosure A L) c * P := by
      apply Subtype.ext
      simp only [SubmonoidClass.coe_pow, MulMemClass.coe_mul, hcoe]
      exact hw
    have h2 : (⟨w, hwi⟩ : integralClosure A L) ^ e ∈ y := by
      rw [h1]; exact y.mul_mem_right _ hc
    exact hyP.mem_of_pow_mem e h2

  have hunit : ∀ s : y.primeCompl,
      IsUnit (algebraMap (integralClosure A L) L (s : integralClosure A L)) := by
    intro s
    apply Ne.isUnit
    intro h0
    apply s.2
    have : (s : integralClosure A L) = 0 := Subtype.ext h0
    rw [this]; exact y.zero_mem
  obtain ⟨ι, hι, hιinj⟩ : ∃ ι : Localization.AtPrime y →+* L,
      (∀ z : integralClosure A L, ι (algebraMap _ (Localization.AtPrime y) z) = (z : L)) ∧
      Function.Injective ι := by
    refine ⟨IsLocalization.lift (M := y.primeCompl) (S := Localization.AtPrime y) hunit,
      fun z => IsLocalization.lift_eq hunit z, ?_⟩
    rw [IsLocalization.lift_injective_iff]
    intro p q
    constructor
    · intro h
      have := congrArg (IsLocalization.lift (M := y.primeCompl) (S := Localization.AtPrime y)
        hunit) h
      rwa [IsLocalization.lift_eq, IsLocalization.lift_eq] at this
    · intro h
      rw [Subtype.ext h]
  have hκ : ∀ c : A, ι (algebraMap _ (Localization.AtPrime y) (algebraMap A _ c)) =
      algebraMap A L c := fun c => hι _

  have hnot : ∀ c : A, c ∉ Ideal.comap (algebraMap A (integralClosure A L)) y →
      algebraMap A (integralClosure A L) c ∉ y := fun c h h' => h (Ideal.mem_comap.mpr h')
  have hne0 : ∀ z : integralClosure A L, z ∉ y → (z : L) ≠ 0 := by
    intro z hz h0
    apply hz
    have : z = 0 := Subtype.ext h0
    rw [this]; exact y.zero_mem
  have hd'y : algebraMap A (integralClosure A L) d' ∉ y := hnot d' hd'
  have hdy : algebraMap A (integralClosure A L) d ∉ y := hnot d hd
  have hd'pow : ∀ j : ℕ, algebraMap A (integralClosure A L) (d' ^ j) ∉ y := by
    intro j h
    rw [map_pow] at h
    exact hd'y (hyP.mem_of_pow_mem j h)
  have hd'L0 : algebraMap A L d' ≠ 0 := hne0 _ hd'y
  have huy : algebraMap A (integralClosure A L) u ∈ y := hu
  have hvy : algebraMap A (integralClosure A L) v ∈ y := hv

  obtain ⟨r, hρr⟩ : ∃ r : L, ρ * r = 1 := ⟨ρ⁻¹, mul_inv_cancel₀ hρ⟩
  obtain ⟨z, hzdef⟩ : ∃ z : L, z = x ^ (n' + 1) * r ^ m := ⟨_, rfl⟩
  have hz : z ^ (k + 1) = algebraMap A L u ^ (n' + 1) * ρ := by
    rw [hzdef]
    calc (x ^ (n' + 1) * r ^ m) ^ (k + 1) = (x ^ (k + 1)) ^ (n' + 1) * r ^ (m * (k + 1)) := by ring
    _ = algebraMap A L u ^ (n' + 1) * ρ ^ (a * (n' + 1)) * r ^ (m * (k + 1)) := by rw [hH1]; ring
    _ = algebraMap A L u ^ (n' + 1) * ρ * (ρ * r) ^ (m * (k + 1)) := by rw [han]; ring
    _ = _ := by rw [hρr, one_pow, mul_one]
  have hzk : z ^ k = x ^ ((n' + 1) * k) * r ^ (m * k) := by rw [hzdef]; ring
  have hpr : ρ ^ (m * k) * r ^ (m * k) = 1 := by rw [← mul_pow, hρr, one_pow]
  have hZ : algebraMap A L d' * ρ - algebraMap A L d +
      algebraMap A L d * algebraMap A L (algebraMap W A lam) * z ^ k = 0 := by
    linear_combination r ^ (m * k) * hH2 - (algebraMap A L d' * ρ - algebraMap A L d) * hpr +
      algebraMap A L d * algebraMap A L (algebraMap W A lam) * hzk
  obtain ⟨t, htdef⟩ : ∃ t : L, t = algebraMap A L d' * z := ⟨_, rfl⟩
  have ht : t ^ (k + 1) + algebraMap A L d * algebraMap A L (algebraMap W A lam) *
      algebraMap A L u ^ (n' + 1) * t ^ k -
      algebraMap A L d * algebraMap A L u ^ (n' + 1) * algebraMap A L d' ^ k = 0 := by
    rw [htdef]
    linear_combination algebraMap A L d' ^ (k + 1) * hz +
      algebraMap A L d' ^ k * algebraMap A L u ^ (n' + 1) * hZ
  have htint : _root_.IsIntegral A t := by
    refine ⟨Polynomial.X ^ (k + 1) + (Polynomial.C (d * algebraMap W A lam * u ^ (n' + 1)) *
      Polynomial.X ^ k - Polynomial.C (d * u ^ (n' + 1) * d' ^ k)), ?_, ?_⟩
    · apply Polynomial.Monic.add_of_left (Polynomial.monic_X_pow _)
      rw [Polynomial.degree_X_pow]
      refine lt_of_le_of_lt (Polynomial.degree_sub_le _ _) (max_lt ?_ ?_)
      · exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_pow_le _ _)
          (by exact_mod_cast (by omega : k < k + 1))
      · exact lt_of_le_of_lt Polynomial.degree_C_le (by exact_mod_cast (by omega : 0 < k + 1))
    · rw [← Polynomial.aeval_def]
      simp only [map_add, map_sub, map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
      linear_combination ht
  let tt : integralClosure A L := ⟨t, htint⟩
  obtain ⟨T, hTL, hTy⟩ := root_mem (k + 1) t u
    (algebraMap A _ (u ^ n' * d * d' ^ k) - algebraMap A _ (u ^ n' * d * algebraMap W A lam) * tt ^ k)
    (by omega) huy (by
      simp only [AddSubgroupClass.coe_sub, MulMemClass.coe_mul, SubmonoidClass.coe_pow, hcoe,
        map_mul, map_pow]
      show t ^ (k + 1) = algebraMap A L u * (algebraMap A L u ^ n' * algebraMap A L d *
        algebraMap A L d' ^ k - algebraMap A L u ^ n' * algebraMap A L d *
        algebraMap A L (algebraMap W A lam) * t ^ k)
      linear_combination ht)
  set S₀ : integralClosure A L := algebraMap A _ d *
    (algebraMap A _ (d' ^ k) - algebraMap A _ (algebraMap W A lam) * T ^ k) with hS₀def
  have hS0L : (S₀ : L) = algebraMap A L d' ^ (k + 1) * ρ := by
    rw [hS₀def]
    simp only [AddSubgroupClass.coe_sub, MulMemClass.coe_mul, SubmonoidClass.coe_pow, hcoe,
      map_pow, hTL]
    rw [htdef]
    linear_combination (-(algebraMap A L d' ^ k)) * hZ
  have hS0y : S₀ ∉ y := by
    intro h
    rw [hS₀def] at h
    rcases hyP.mem_or_mem h with h1 | h1
    · exact hdy h1
    · apply hd'pow k
      have := y.add_mem h1 (y.mul_mem_left (algebraMap A _ (algebraMap W A lam))
        (Ideal.pow_mem_of_mem y hTy k hk))
      rwa [sub_add_cancel] at this
  have hS0L0 : (S₀ : L) ≠ 0 := hne0 _ hS0y

  have hx0 : x ≠ 0 := by
    intro h
    rw [h, zero_pow (Nat.succ_ne_zero k)] at hH1
    exact mul_ne_zero hu0 (pow_ne_zero a hρ) hH1.symm
  obtain ⟨Xt, hXtL, hXty⟩ := root_mem (k + 1) (algebraMap A L d' ^ a * x) u (S₀ ^ a) (by omega) huy
    (by
      rw [SubmonoidClass.coe_pow, hS0L]
      linear_combination algebraMap A L d' ^ (a * (k + 1)) * hH1)
  obtain ⟨η, hηdef⟩ : ∃ η : L, η = algebraMap A L (algebraMap W A β) / x := ⟨_, rfl⟩
  have hηx : η * x = algebraMap A L (algebraMap W A β) := by rw [hηdef]; exact div_mul_cancel₀ _ hx0
  have hβL : algebraMap A L (algebraMap W A β) ^ (k + 1) = algebraMap A L u * algebraMap A L v := by
    have := congrArg (fun w => algebraMap A L (algebraMap W A w)) hβ
    simp only [map_pow] at this
    rw [this, ← map_mul, huv]
  have hη : η ^ (k + 1) * ρ ^ a = algebraMap A L v := by
    apply mul_left_cancel₀ hu0
    have : (η * x) ^ (k + 1) = algebraMap A L (algebraMap W A β) ^ (k + 1) := by rw [hηx]
    rw [mul_pow, hH1, hβL] at this
    linear_combination this
  obtain ⟨Yt, hYtL, hYty⟩ := root_mem (k + 1) ((S₀ : L) ^ a * η) v
    (S₀ ^ (a * k) * algebraMap A _ (d' ^ ((k + 1) * a))) (by omega) hvy
    (by
      simp only [MulMemClass.coe_mul, SubmonoidClass.coe_pow, hcoe, map_pow]
      rw [hS0L]
      linear_combination (algebraMap A L d' ^ (k + 1) * ρ) ^ (a * k) *
        algebraMap A L d' ^ ((k + 1) * a) * hη)

  let sa : y.primeCompl := ⟨algebraMap A _ (d' ^ a), hd'pow a⟩
  let sl : y.primeCompl := ⟨algebraMap A _ (d' ^ (k + 1)), hd'pow (k + 1)⟩
  let sS : y.primeCompl := ⟨S₀ ^ a, fun h => hS0y (hyP.mem_of_pow_mem a h)⟩
  let xh : Localization.AtPrime y := IsLocalization.mk' (Localization.AtPrime y) Xt sa
  let rh : Localization.AtPrime y := IsLocalization.mk' (Localization.AtPrime y) S₀ sl
  let eh : Localization.AtPrime y := IsLocalization.mk' (Localization.AtPrime y) Yt sS
  have hxhm : xh ∈ IsLocalRing.maximalIdeal (Localization.AtPrime y) :=
    (IsLocalization.AtPrime.mk'_mem_maximal_iff (Localization.AtPrime y) y Xt sa).mpr hXty
  have hehm : eh ∈ IsLocalRing.maximalIdeal (Localization.AtPrime y) :=
    (IsLocalization.AtPrime.mk'_mem_maximal_iff (Localization.AtPrime y) y Yt sS).mpr hYty
  have hrhu : IsUnit rh :=
    (IsLocalization.AtPrime.isUnit_mk'_iff (Localization.AtPrime y) y S₀ sl).mpr hS0y

  have hιxh : ι xh = x := by
    have h := congrArg ι (IsLocalization.mk'_spec (Localization.AtPrime y) Xt sa)
    rw [map_mul, hι, hι, hXtL] at h
    change ι xh * ((algebraMap A (integralClosure A L) (d' ^ a) : integralClosure A L) : L) = _ at h
    rw [hcoe, map_pow] at h
    apply mul_right_cancel₀ (pow_ne_zero a hd'L0)
    linear_combination h
  have hιrh : ι rh = ρ := by
    have h := congrArg ι (IsLocalization.mk'_spec (Localization.AtPrime y) S₀ sl)
    rw [map_mul, hι, hι, hS0L] at h
    change ι rh * ((algebraMap A (integralClosure A L) (d' ^ (k + 1)) : integralClosure A L) : L)
      = _ at h
    rw [hcoe, map_pow] at h
    apply mul_right_cancel₀ (pow_ne_zero (k + 1) hd'L0)
    linear_combination h
  have hιeh : ι eh = η := by
    have h := congrArg ι (IsLocalization.mk'_spec (Localization.AtPrime y) Yt sS)
    rw [map_mul, hι, hι, hYtL] at h
    simp only [sS, SubmonoidClass.coe_pow] at h
    apply mul_right_cancel₀ (pow_ne_zero a hS0L0)
    linear_combination h
  have hrel : (algebraMap _ (Localization.AtPrime y) (algebraMap A (integralClosure A L) d') * rh -
      algebraMap _ (Localization.AtPrime y) (algebraMap A (integralClosure A L) d)) *
      rh ^ (m * k) =
      -(algebraMap _ (Localization.AtPrime y) (algebraMap A (integralClosure A L) d) *
        algebraMap _ (Localization.AtPrime y)
          (algebraMap A (integralClosure A L) (algebraMap W A lam)) * xh ^ ((n' + 1) * k)) := by
    apply hιinj
    simp only [map_sub, map_mul, map_pow, map_neg, hκ, hιxh, hιrh]
    linear_combination hH2
  refine ⟨xh, eh, rh, Xt, d' ^ a, fun h => hd'pow a (Ideal.mem_comap.mp h),
    (IsLocalization.mk'_spec (Localization.AtPrime y) Xt sa).symm, ?_, hxhm, hehm, hrhu,
    ?_, ?_, ?_, ?_, ?_⟩
  · rw [hXtL, map_pow, mul_comm]
  · apply hιinj
    rw [map_mul, hιxh, hιeh, hκ, mul_comm]
    exact hηx
  · apply hιinj
    simp only [map_mul, map_pow, hιxh, hιrh, hκ]
    exact hH1
  · apply hιinj
    simp only [map_mul, map_pow, hιeh, hιrh, hκ]
    exact hη
  · apply hιinj
    simp only [map_sub, map_add, map_mul, map_pow, map_zero, hιxh, hιrh, hκ]
    exact hH2
  · have hR : -(algebraMap _ (Localization.AtPrime y) (algebraMap A (integralClosure A L) d) *
        algebraMap _ (Localization.AtPrime y)
          (algebraMap A (integralClosure A L) (algebraMap W A lam)) * xh ^ ((n' + 1) * k)) ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime y) :=
      neg_mem (Ideal.mul_mem_left _ _
        (Ideal.pow_mem_of_mem _ hxhm _ (Nat.mul_pos (Nat.succ_pos n') hk)))
    rw [← hrel] at hR
    exact (Ideal.mul_unit_mem_iff_mem _ (hrhu.pow _)).mp hR

theorem wcLlsASin_unram_deriv : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (g : ↥W)
    (B C M : Type u) [CommRing B] [CommRing C] [AddCommGroup M] [Module C M]
    [Algebra (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} : Set (MvPolynomial (Fin 2) ↥W))) B]
    [Algebra.FormallyUnramified (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} : Set (MvPolynomial (Fin 2) ↥W))) B]
    (κ : B →+* C) (δ : Derivation ℤ C M),
    (∀ w : ↥W, δ (κ ((algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) B : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+* B) (Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} : Set (MvPolynomial (Fin 2) ↥W))) (MvPolynomial.C w)))) = 0) →
    ∀ b : B, ∃ eU eV : C, δ (κ b) =
      eU • δ (κ ((algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) B : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+* B) (Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} : Set (MvPolynomial (Fin 2) ↥W))) (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W)))) +
      eV • δ (κ ((algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) B : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+* B) (Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} : Set (MvPolynomial (Fin 2) ↥W))) (MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W)))) :=
by
  intro Ω _ W g B C M _ _ _ _ _ _ κ δ hW b
  classical


  have key : ∀ (R : Type u) [CommRing R] [Algebra R B] [Algebra.FormallyUnramified R B]
      (S : Submodule C M), (∀ r : R, δ (κ (algebraMap R B r)) ∈ S) → ∀ b : B, δ (κ b) ∈ S := by
    intro R _ _ _ S hS b
    letI iB : Module B (M ⧸ S) := Module.compHom (M ⧸ S) κ
    letI iR : Module R (M ⧸ S) := Module.compHom (M ⧸ S) (κ.comp (algebraMap R B))
    haveI : IsScalarTower R B (M ⧸ S) := ⟨fun n b q => by
      show κ (n • b) • q = κ (algebraMap R B n) • κ b • q
      rw [Algebra.smul_def, map_mul, mul_smul]⟩
    let D : Derivation R B (M ⧸ S) :=
      { toFun := fun b => S.mkQ (δ (κ b))
        map_add' := fun a b => by simp only [map_add]
        map_smul' := fun n b => by
          show S.mkQ (δ (κ (n • b))) = κ (algebraMap R B n) • S.mkQ (δ (κ b))
          have hz : S.mkQ (δ (κ (algebraMap R B n))) = 0 :=
            (Submodule.Quotient.mk_eq_zero S).mpr (hS n)
          rw [Algebra.smul_def, map_mul, Derivation.leibniz, map_add, LinearMap.map_smul,
            LinearMap.map_smul, hz, smul_zero, add_zero]
        map_one_eq_zero' := by
          show S.mkQ (δ (κ 1)) = 0
          rw [map_one, Derivation.map_one_eq_zero, map_zero]
        leibniz' := fun a b => by
          show S.mkQ (δ (κ (a * b))) = κ a • S.mkQ (δ (κ b)) + κ b • S.mkQ (δ (κ a))
          rw [map_mul, Derivation.leibniz, map_add, LinearMap.map_smul, LinearMap.map_smul] }
    have hD : D b = 0 := by
      rw [← Derivation.liftKaehlerDifferential_comp_D D b,
        Subsingleton.elim (KaehlerDifferential.D R B b) 0, map_zero]
    exact (Submodule.Quotient.mk_eq_zero S).mp hD
  refine (fun hmem => ?_) (key (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} : Set (MvPolynomial (Fin 2) ↥W))) (Submodule.span C
    {δ (κ ((algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) B : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+* B) (Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} : Set (MvPolynomial (Fin 2) ↥W))) (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W)))),
     δ (κ ((algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) B : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+* B) (Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} : Set (MvPolynomial (Fin 2) ↥W))) (MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W))))}) ?_ b)
  · obtain ⟨a, a', h⟩ := Submodule.mem_span_pair.mp hmem
    exact ⟨a, a', h.symm⟩
  · intro r
    obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective r
    induction P using MvPolynomial.induction_on with
    | C a =>
      rw [hW a]; exact Submodule.zero_mem _
    | add p q hp hq =>
      rw [map_add, map_add, map_add, map_add]; exact Submodule.add_mem _ hp hq
    | mul_X p n hp =>
      rw [map_mul, map_mul, map_mul, Derivation.leibniz]
      refine Submodule.add_mem _ (Submodule.smul_mem _ _ ?_) (Submodule.smul_mem _ _ hp)
      fin_cases n
      · exact Submodule.subset_span (Set.mem_insert _ _)
      · exact Submodule.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))

theorem wcLlsASin_cut_derivative : ∀ (k C : Type u) [CommRing k] [CommRing C] [Algebra k C]
    (ℓ a K₀ N : ℕ) (X0 X1 T Ti e lam eU eV : C), T * Ti = 1 →
    KaehlerDifferential.D k C X0 = 0 → KaehlerDifferential.D k C X1 = 0 →
    KaehlerDifferential.D k C lam = 0 →
    KaehlerDifferential.D k C e = eU • KaehlerDifferential.D k C (X0 ^ ℓ * Ti ^ a) +
      eV • KaehlerDifferential.D k C (X1 ^ ℓ * T ^ a) →
    ∃ c p q : C, KaehlerDifferential.D k C (e * T ^ (K₀ + 1) - T ^ K₀ + lam * X0 ^ N) =
        c • KaehlerDifferential.D k C T ∧
      T * c = T ^ K₀ * (((K₀ + 1 : ℕ) : C) * e * T - ((K₀ : ℕ) : C)) + X0 ^ ℓ * p + X1 ^ ℓ * q :=
by
  intro k C _ _ _ ℓ a K₀ N X0 X1 T Ti e lam eU eV hT h0 h1 hl he
  have hpow : ∀ (x : C) (n : ℕ), KaehlerDifferential.D k C (x ^ n) =
      (((n : ℕ) : C) * x ^ (n - 1)) • KaehlerDifferential.D k C x := by
    intro x n
    rw [Derivation.leibniz_pow, ← Nat.cast_smul_eq_nsmul C, smul_smul]
  have hz : ∀ (x : C) (n : ℕ), KaehlerDifferential.D k C x = 0 →
      KaehlerDifferential.D k C (x ^ n) = 0 := by
    intro x n hx
    rw [hpow, hx, smul_zero]
  have dTi : KaehlerDifferential.D k C Ti = (-(Ti ^ 2)) • KaehlerDifferential.D k C T := by
    have h := (KaehlerDifferential.D k C).leibniz T Ti
    rw [hT, Derivation.map_one_eq_zero] at h
    have h2 : KaehlerDifferential.D k C Ti = (Ti * T) • KaehlerDifferential.D k C Ti := by
      rw [mul_comm Ti T, hT, one_smul]
    have h3 : T • KaehlerDifferential.D k C Ti = -(Ti • KaehlerDifferential.D k C T) :=
      eq_neg_of_add_eq_zero_left h.symm
    rw [h2, mul_smul, h3, smul_neg, smul_smul, neg_smul, sq]
  have dTia : KaehlerDifferential.D k C (Ti ^ a) =
      (((a : ℕ) : C) * Ti ^ (a - 1) * (-(Ti ^ 2))) • KaehlerDifferential.D k C T := by
    rw [hpow, dTi, smul_smul]
  have dA : KaehlerDifferential.D k C (X0 ^ ℓ * Ti ^ a) =
      (X0 ^ ℓ * (((a : ℕ) : C) * Ti ^ (a - 1) * (-(Ti ^ 2)))) • KaehlerDifferential.D k C T := by
    rw [Derivation.leibniz, dTia, hz X0 ℓ h0, smul_zero, add_zero, smul_smul]
  have dB : KaehlerDifferential.D k C (X1 ^ ℓ * T ^ a) =
      (X1 ^ ℓ * (((a : ℕ) : C) * T ^ (a - 1))) • KaehlerDifferential.D k C T := by
    rw [Derivation.leibniz, hpow T a, hz X1 ℓ h1, smul_zero, add_zero, smul_smul]
  have dE : KaehlerDifferential.D k C e =
      (eU * (X0 ^ ℓ * (((a : ℕ) : C) * Ti ^ (a - 1) * (-(Ti ^ 2)))) +
        eV * (X1 ^ ℓ * (((a : ℕ) : C) * T ^ (a - 1)))) • KaehlerDifferential.D k C T := by
    rw [he, dA, dB, smul_smul, smul_smul, add_smul]
  have h7 : ((K₀ : ℕ) : C) * (T * T ^ (K₀ - 1)) = ((K₀ : ℕ) : C) * T ^ K₀ := by
    rcases K₀ with _ | m
    · simp
    · rw [Nat.add_sub_cancel, ← pow_succ']
  refine ⟨((K₀ + 1 : ℕ) : C) * T ^ K₀ * e +
      T ^ (K₀ + 1) * (eU * (X0 ^ ℓ * (((a : ℕ) : C) * Ti ^ (a - 1) * (-(Ti ^ 2)))) +
        eV * (X1 ^ ℓ * (((a : ℕ) : C) * T ^ (a - 1)))) - ((K₀ : ℕ) : C) * T ^ (K₀ - 1),
    T ^ (K₀ + 2) * eU * (((a : ℕ) : C) * Ti ^ (a - 1) * (-(Ti ^ 2))),
    T ^ (K₀ + 2) * eV * (((a : ℕ) : C) * T ^ (a - 1)), ?_, ?_⟩
  · rw [map_add, map_sub, Derivation.leibniz, Derivation.leibniz, hz X0 N h0, hl, hpow T (K₀ + 1),
      hpow T K₀, dE, Nat.add_sub_cancel, smul_zero, smul_zero, add_zero, add_zero, smul_smul,
      smul_smul, ← add_smul, ← sub_smul]
    congr 1
    ring
  · linear_combination -h7

theorem wcLlsASin_kaehler_cut : ∀ (R B : Type u) [CommRing R] [CommRing B] [Algebra R B]
    (φ : Polynomial R →ₐ[R] B), RingHom.Etale (R := Polynomial R) (S := B) φ.toRingHom → ∀ (G c : B),
    KaehlerDifferential.D R B G = c • KaehlerDifferential.D R B (φ Polynomial.X) →
    Algebra.Etale R (Localization.Away (Ideal.Quotient.mk (Ideal.span {G}) c)) :=
by
  intro R B _ _ _ φ hφ G c hG

  obtain ⟨hfp, hfs, θ, hθ1, hθ⟩ : Algebra.FinitePresentation R B ∧ Algebra.FormallySmooth R B ∧
      ∃ θ : KaehlerDifferential R B →ₗ[B] B, θ (KaehlerDifferential.D R B (φ Polynomial.X)) = 1 ∧
        ∀ ω : KaehlerDifferential R B, ω = θ ω • KaehlerDifferential.D R B (φ Polynomial.X) := by
    letI : Algebra (Polynomial R) B := φ.toRingHom.toAlgebra
    haveI hE : Algebra.Etale (Polynomial R) B := hφ
    haveI : IsScalarTower R (Polynomial R) B :=
      IsScalarTower.of_algebraMap_eq (fun r => (φ.commutes r).symm)
    haveI : Algebra.FormallyEtale (Polynomial R) B := Algebra.Etale.formallyEtale
    haveI : Algebra.FinitePresentation (Polynomial R) B := Algebra.Etale.finitePresentation
    haveI : Algebra.FormallySmooth (Polynomial R) B :=
      (Algebra.FormallyEtale.iff_formallyUnramified_and_formallySmooth.mp inferInstance).2
    refine ⟨Algebra.FinitePresentation.trans R (Polynomial R) B,
      Algebra.FormallySmooth.comp R (Polynomial R) B, ?_⟩
    let Ψ : KaehlerDifferential R B ≃ₗ[B] B :=
      (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale R (Polynomial R) B).symm ≪≫ₗ
        LinearEquiv.baseChange (Polynomial R) B _ _ (KaehlerDifferential.polynomialEquiv R) ≪≫ₗ
        TensorProduct.AlgebraTensorModule.rid (Polynomial R) B B
    have hX : φ Polynomial.X = algebraMap (Polynomial R) B Polynomial.X := rfl
    have hΨ1 : Ψ (KaehlerDifferential.D R B (φ Polynomial.X)) = 1 := by
      rw [hX]
      simp only [Ψ, LinearEquiv.trans_apply,
        KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_symm_D_algebraMap,
        LinearEquiv.baseChange_tmul, KaehlerDifferential.polynomialEquiv_D,
        Polynomial.derivative_X, TensorProduct.AlgebraTensorModule.rid_tmul, one_smul]
    refine ⟨Ψ.toLinearMap, hΨ1, fun ω => ?_⟩
    apply Ψ.injective
    rw [LinearEquiv.map_smul, hΨ1, smul_eq_mul, mul_one]
    rfl

  let δ : Derivation R B B := θ.compDer (KaehlerDifferential.D R B)
  have hδ : ∀ b, δ b = θ (KaehlerDifferential.D R B b) := fun b => rfl
  have hδG : δ G = c := by
    rw [hδ, hG, LinearMap.map_smul, hθ1, smul_eq_mul, mul_one]

  have hcE : IsUnit (algebraMap B (Localization.Away (Ideal.Quotient.mk (Ideal.span {G}) c)) c) := by
    rw [IsScalarTower.algebraMap_apply B (B ⧸ Ideal.span {G})
      (Localization.Away (Ideal.Quotient.mk (Ideal.span {G}) c))]
    exact IsLocalization.Away.algebraMap_isUnit _
  have hGE : algebraMap B (Localization.Away (Ideal.Quotient.mk (Ideal.span {G}) c)) G = 0 := by
    rw [IsScalarTower.algebraMap_apply B (B ⧸ Ideal.span {G})
      (Localization.Away (Ideal.Quotient.mk (Ideal.span {G}) c)), Ideal.Quotient.algebraMap_eq,
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self G), map_zero]

  have hU : Algebra.FormallyUnramified R (Localization.Away (Ideal.Quotient.mk (Ideal.span {G}) c)) := by
    haveI : Algebra.FormallyUnramified B (Localization.Away (Ideal.Quotient.mk (Ideal.span {G}) c)) :=
      Algebra.FormallyUnramified.comp B (B ⧸ Ideal.span {G}) _
    have hDt : KaehlerDifferential.D R (Localization.Away (Ideal.Quotient.mk (Ideal.span {G}) c))
        (algebraMap B _ (φ Polynomial.X)) = 0 := by
      have h2 := congrArg (KaehlerDifferential.map R R B
        (Localization.Away (Ideal.Quotient.mk (Ideal.span {G}) c))) hG
      rw [KaehlerDifferential.map_D, hGE, map_zero, LinearMap.map_smul, KaehlerDifferential.map_D,
        ← algebraMap_smul (Localization.Away (Ideal.Quotient.mk (Ideal.span {G}) c)) c] at h2
      exact hcE.smul_eq_zero.mp h2.symm
    have hall : ∀ x : KaehlerDifferential R (Localization.Away (Ideal.Quotient.mk (Ideal.span {G}) c)),
        x = 0 := by
      intro x
      obtain ⟨y, rfl⟩ := (KaehlerDifferential.exact_mapBaseChange_map R B _ x).mp (Subsingleton.elim _ _)
      induction y using TensorProduct.induction_on with
      | zero => simp
      | tmul e ω =>
        rw [KaehlerDifferential.mapBaseChange_tmul, hθ ω, LinearMap.map_smul, KaehlerDifferential.map_D,
          hDt, smul_zero, smul_zero]
      | add y z hy hz => rw [map_add, hy, hz, add_zero]
    exact ⟨⟨fun x y => by rw [hall x, hall y]⟩⟩

  have hF : Algebra.FinitePresentation R (Localization.Away (Ideal.Quotient.mk (Ideal.span {G}) c)) := by
    haveI := hfp
    haveI : Algebra.FinitePresentation R (B ⧸ Ideal.span {G}) :=
      Algebra.FinitePresentation.quotient ⟨{G}, by simp⟩
    exact Algebra.FinitePresentation.of_isLocalizationAway (Ideal.Quotient.mk (Ideal.span {G}) c)

  have hS : Algebra.FormallySmooth R (Localization.Away (Ideal.Quotient.mk (Ideal.span {G}) c)) := by
    haveI := hfs
    haveI : Algebra.FormallySmooth R (Localization.Away c) :=
      Algebra.FormallySmooth.comp R B (Localization.Away c)
    have hunit : ∀ y : Submonoid.powers c,
        IsUnit (IsScalarTower.toAlgHom R B (Localization.Away (Ideal.Quotient.mk (Ideal.span {G}) c)) y) := by
      rintro ⟨_, n, rfl⟩
      rw [map_pow]
      exact hcE.pow n
    let f : Localization.Away c →ₐ[R] Localization.Away (Ideal.Quotient.mk (Ideal.span {G}) c) :=
      IsLocalization.liftAlgHom (M := Submonoid.powers c)
        (f := IsScalarTower.toAlgHom R B (Localization.Away (Ideal.Quotient.mk (Ideal.span {G}) c))) hunit
    have hf : ∀ b : B, f (algebraMap B (Localization.Away c) b) =
        algebraMap B (Localization.Away (Ideal.Quotient.mk (Ideal.span {G}) c)) b := by
      intro b
      rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
      rfl
    let J : Ideal (Localization.Away c) := RingHom.ker f.toRingHom
    let ci : Localization.Away c := IsLocalization.Away.invSelf c
    have hci : algebraMap B (Localization.Away c) c * ci = 1 := IsLocalization.Away.mul_invSelf c
    let GP : Localization.Away c := algebraMap B (Localization.Away c) G
    have hGP : GP ∈ J := by
      show f.toRingHom GP = 0
      exact (hf G).trans hGE
    have hGP2 : ∀ z : Localization.Away c, z * GP ^ 2 ∈ J ^ 2 :=
      fun z => Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow hGP 2)
    let σ : B →ₐ[R] Localization.Away c ⧸ J ^ 2 :=
      { toFun := fun b => Ideal.Quotient.mk (J ^ 2)
          (algebraMap B _ b - algebraMap B _ (δ b) * ci * GP)
        map_one' := by
          simp only [Derivation.map_one_eq_zero, map_one, map_zero, zero_mul, sub_zero]
        map_mul' := by
          intro x y
          rw [← map_mul, Ideal.Quotient.eq]
          have e : algebraMap B (Localization.Away c) (x * y) -
              algebraMap B (Localization.Away c) (δ (x * y)) * ci * GP -
              (algebraMap B (Localization.Away c) x - algebraMap B (Localization.Away c) (δ x) * ci * GP) *
              (algebraMap B (Localization.Away c) y - algebraMap B (Localization.Away c) (δ y) * ci * GP) =
              -(algebraMap B (Localization.Away c) (δ x) * algebraMap B (Localization.Away c) (δ y) *
                ci ^ 2) * GP ^ 2 := by
            rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
            simp only [map_mul, map_add]
            ring
          rw [e]
          exact hGP2 _
        map_zero' := by
          simp only [map_zero, zero_mul, sub_zero]
        map_add' := by
          intro x y
          rw [← map_add]
          congr 1
          simp only [map_add]
          ring
        commutes' := by
          intro r
          simp only [Derivation.map_algebraMap, map_zero, zero_mul, sub_zero]
          exact Ideal.Quotient.mk_algebraMap R _ r }
    have hσ : ∀ b, σ b = Ideal.Quotient.mk (J ^ 2)
        (algebraMap B _ b - algebraMap B _ (δ b) * ci * GP) := fun b => rfl
    have hσG : σ G = 0 := by
      rw [hσ, hδG, hci, one_mul, sub_self, map_zero]
    let σb : B ⧸ Ideal.span {G} →ₐ[R] Localization.Away c ⧸ J ^ 2 :=
      Ideal.Quotient.liftₐ (Ideal.span {G}) σ (fun a ha => by
        obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp ha
        rw [map_mul, hσG, mul_zero])
    have hσb : ∀ b, σb (Ideal.Quotient.mk (Ideal.span {G}) b) = σ b := fun b => rfl
    have hσc : IsUnit (σb (Ideal.Quotient.mk (Ideal.span {G}) c)) := by
      rw [hσb, hσ, map_sub, sub_eq_add_neg]
      have hu : IsUnit (Ideal.Quotient.mk (J ^ 2) (algebraMap B (Localization.Away c) c)) :=
        (IsLocalization.Away.algebraMap_isUnit c).map _
      have hn : IsNilpotent (-Ideal.Quotient.mk (J ^ 2)
          (algebraMap B (Localization.Away c) (δ c) * ci * GP)) := by
        refine IsNilpotent.neg ⟨2, ?_⟩
        rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem, mul_pow]
        exact hGP2 _
      exact IsNilpotent.isUnit_add_left_of_commute hn hu (Commute.all _ _)
    have hunit' : ∀ y : Submonoid.powers (Ideal.Quotient.mk (Ideal.span {G}) c), IsUnit (σb y) := by
      rintro ⟨_, n, rfl⟩
      rw [map_pow]
      exact hσc.pow n
    let g : Localization.Away (Ideal.Quotient.mk (Ideal.span {G}) c) →ₐ[R] Localization.Away c ⧸ J ^ 2 :=
      IsLocalization.liftAlgHom (M := Submonoid.powers (Ideal.Quotient.mk (Ideal.span {G}) c))
        (f := σb) hunit'
    refine Algebra.FormallySmooth.of_split f g ?_
    apply AlgHom.coe_ringHom_injective
    apply IsLocalization.ringHom_ext (Submonoid.powers (Ideal.Quotient.mk (Ideal.span {G}) c))
    apply Ideal.Quotient.ringHom_ext
    refine RingHom.ext fun b => ?_
    simp only [RingHom.comp_apply, AlgHom.coe_toRingHom, AlgHom.coe_comp, Function.comp_apply,
      AlgHom.id_apply]
    have hg : g (algebraMap (B ⧸ Ideal.span {G}) _ (Ideal.Quotient.mk (Ideal.span {G}) b)) = σ b := by
      rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
      rfl
    rw [hg, hσ, AlgHom.kerSquareLift_mk, map_sub, map_mul, map_mul]
    have hfG : f GP = 0 := hGP
    rw [hfG, mul_zero, sub_zero, hf, IsScalarTower.algebraMap_apply B (B ⧸ Ideal.span {G}),
      Ideal.Quotient.algebraMap_eq]
  exact Algebra.Etale.mk
    (Algebra.FormallyEtale.of_formallyUnramified_and_formallySmooth) hF

theorem wcLlsASin_pushout : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (g β : ↥W) (ℓ a : ℕ)
    (B P : Type u) [CommRing B] [CommRing P]
    (f₀ : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+* B)
    (φB : B →+* P) (x0 x1 τ : P), β ^ ℓ = g →
    RingHom.Etale (R := (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})) (S := B) f₀ →
    IsUnit τ →
    x0 * x1 = φB (f₀ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.C β))) →
    x0 ^ ℓ = φB (f₀ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.X 0))) * τ ^ a →
    x1 ^ ℓ * τ ^ a = φB (f₀ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.X 1))) →
    ∃ (R₁ : Type u) (_ : CommRing R₁)
      (_ : Algebra (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β} : Set (MvPolynomial (Fin 2) ↥W))) R₁)
      (φ : Polynomial (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) →ₐ[MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}] R₁)
      (iB : B →+* R₁) (Ti : R₁) (γ₁ : R₁ →+* P),
      RingHom.Etale (R := Polynomial (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β})) (S := R₁) φ.toRingHom ∧
      φ Polynomial.X * Ti = 1 ∧ γ₁.comp iB = φB ∧
      γ₁ ((algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) R₁ : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) →+* R₁) (Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β} : Set (MvPolynomial (Fin 2) ↥W))) (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W))) = x0 ∧
      γ₁ ((algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) R₁ : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) →+* R₁) (Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β} : Set (MvPolynomial (Fin 2) ↥W))) (MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W))) = x1 ∧
      γ₁ (φ Polynomial.X) = τ ∧
      (∀ w : ↥W, (algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) R₁ : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) →+* R₁) (Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β} : Set (MvPolynomial (Fin 2) ↥W))) (MvPolynomial.C w)) =
        iB (f₀ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.C w)))) ∧
      iB (f₀ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.X 0))) =
        (algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) R₁ : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) →+* R₁) (Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β} : Set (MvPolynomial (Fin 2) ↥W))) (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W)) ^ ℓ * Ti ^ a ∧
      iB (f₀ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.X 1))) =
        (algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) R₁ : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) →+* R₁) (Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β} : Set (MvPolynomial (Fin 2) ↥W))) (MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W)) ^ ℓ * φ Polynomial.X ^ a ∧
      ∀ z : R₁, ∃ (k : ℕ) (mm : Fin k → (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β})) (b : Fin k → B) (e₁ e₂ : Fin k → ℕ),
        z = ∑ i, (algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) R₁ : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) →+* R₁) (mm i) * iB (b i) * φ Polynomial.X ^ e₁ i * Ti ^ e₂ i :=
by
  intro Ω _ W g β ℓ a B P _ _ f₀ φB x0 x1 τ hβg hfet hτ hx01 hx0 hx1
  classical

  have lift : ∀ (c : ↥W) (S : Type u) [CommRing S] (σ : ↥W →+* S) (a b : S), a * b = σ c →
      ∃ φ : (MvPolynomial (Fin 2) ↥W ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}) →+* S,
        (∀ w, φ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C c}) (MvPolynomial.C w)) = σ w) ∧
        φ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C c}) (MvPolynomial.X 0)) = a ∧
        φ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C c}) (MvPolynomial.X 1)) = b := by
    intro c S _ σ a b hab
    have hE : ∀ p ∈ Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c :
        MvPolynomial (Fin 2) ↥W)}, MvPolynomial.eval₂Hom σ ![a, b] p = 0 := by
      intro p hp
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp hp
      simp [hab]
    refine ⟨Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom σ ![a, b]) hE, ?_, ?_, ?_⟩
    · intro w; simp
    · simp
    · simp

  have ext : ∀ (c : ↥W) (S : Type u) [CommRing S] (φ ψ : (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}) →+* S),
      (∀ w, φ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C c}) (MvPolynomial.C w)) = ψ (Ideal.Quotient.mk (Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}) (MvPolynomial.C w))) →
      φ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C c}) (MvPolynomial.X 0)) = ψ (Ideal.Quotient.mk (Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}) (MvPolynomial.X 0)) →
      φ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C c}) (MvPolynomial.X 1)) = ψ (Ideal.Quotient.mk (Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}) (MvPolynomial.X 1)) →
      φ = ψ := by
    intro c S _ φ ψ hC h0 h1
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro w; exact hC w
    · intro i
      fin_cases i
      · exact h0
      · exact h1

  have hXβ : (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C β}) (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W)) *
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β})
        (MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W) =
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β})
        (MvPolynomial.C β) := by
    rw [← map_mul, Ideal.Quotient.eq]
    exact Ideal.subset_span rfl

  have gen : ∀ (Ng Nr B' P' : Type u) [CommRing Ng] [CommRing Nr] [CommRing B'] [CommRing P']
      (ι' : Ng →+* Nr) (f : Ng →+* B') (ψN : Nr →+* P') (ψB : B' →+* P'), f.Etale →
      ψN.comp ι' = ψB.comp f →
      ∃ (R : Type u) (_ : CommRing R) (_ : Algebra Nr R) (iB : B' →+* R) (γ : R →+* P'),
        Algebra.Etale Nr R ∧ γ.comp iB = ψB ∧ (∀ a, γ (algebraMap Nr R a) = ψN a) ∧
        (∀ c, algebraMap Nr R (ι' c) = iB (f c)) ∧
        ∀ z : R, ∃ (n : ℕ) (mm : Fin n → Nr) (b : Fin n → B'),
          z = ∑ i, algebraMap Nr R (mm i) * iB (b i) := by
    intro Ng Nr B' P' _ _ _ _ ι' f ψN ψB hf hc
    letI : Algebra Ng Nr := ι'.toAlgebra
    letI : Algebra Ng B' := f.toAlgebra
    letI : Algebra Ng P' := (ψB.comp f).toAlgebra
    haveI : Algebra.Etale Ng B' := hf
    let ψN' : Nr →ₐ[Ng] P' := { ψN with commutes' := fun c => RingHom.congr_fun hc c }
    let ψB' : B' →ₐ[Ng] P' := { ψB with commutes' := fun c => rfl }
    have hal : ∀ a : Nr, algebraMap Nr (TensorProduct Ng Nr B') a = a ⊗ₜ (1 : B') := by
      intro a
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
    refine ⟨TensorProduct Ng Nr B', inferInstance, inferInstance,
      (Algebra.TensorProduct.includeRight).toRingHom,
      (Algebra.TensorProduct.productMap ψN' ψB').toRingHom,
      Algebra.Etale.baseChange _ _ _, ?_, ?_, ?_, ?_⟩
    · refine RingHom.ext fun b => ?_
      change Algebra.TensorProduct.productMap ψN' ψB' (1 ⊗ₜ b) = ψB b
      rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
      rfl
    · intro a
      change Algebra.TensorProduct.productMap ψN' ψB' (algebraMap _ _ _) = ψN a
      rw [hal, Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
      rfl
    · intro c
      change algebraMap _ _ _ = Algebra.TensorProduct.includeRight _
      rw [hal, Algebra.TensorProduct.includeRight_apply]
      exact Algebra.TensorProduct.tmul_one_eq_one_tmul c
    · intro z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨0, Fin.elim0, Fin.elim0, by simp⟩
      | tmul a b =>
        refine ⟨1, ![a], ![b], ?_⟩
        rw [Fin.sum_univ_one]
        change _ = algebraMap _ _ a * Algebra.TensorProduct.includeRight b
        rw [hal, Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.tmul_mul_tmul,
          mul_one, one_mul]
      | add x y hx hy =>
        obtain ⟨n1, a1, b1, h1⟩ := hx
        obtain ⟨n2, a2, b2, h2⟩ := hy
        refine ⟨n1 + n2, Fin.append a1 a2, Fin.append b1 b2, ?_⟩
        rw [Fin.sum_univ_add]
        simp only [Fin.append_left, Fin.append_right]
        rw [← h1, ← h2]

  have core : ∀ (N S Ng B' P' : Type u) [CommRing N] [CommRing S] [Algebra (Polynomial N) S]
      [IsLocalization.Away (Polynomial.X : Polynomial N) S] [CommRing Ng] [CommRing B']
      [CommRing P'] (ι : Ng →+* S) (f : Ng →+* B') (γS : S →+* P') (ψB : B' →+* P'),
      f.Etale → γS.comp ι = ψB.comp f →
      ∃ (R : Type u) (_ : CommRing R) (_ : Algebra N R) (φ : Polynomial N →ₐ[N] R)
        (iB : B' →+* R) (Ti : R) (γ : R →+* P') (ρ : S →+* R),
        RingHom.Etale φ.toRingHom ∧ φ Polynomial.X * Ti = 1 ∧ γ.comp iB = ψB ∧
        (∀ p, ρ (algebraMap (Polynomial N) S p) = φ p) ∧
        ρ (IsLocalization.Away.invSelf (S := S) (Polynomial.X : Polynomial N)) = Ti ∧
        (∀ x, γ (ρ x) = γS x) ∧ (∀ c, iB (f c) = ρ (ι c)) ∧
        (∀ c, φ (Polynomial.C c) = algebraMap N R c) ∧
        ∀ z : R, ∃ (k : ℕ) (mm : Fin k → N) (b : Fin k → B') (e₁ e₂ : Fin k → ℕ),
          z = ∑ i, algebraMap N R (mm i) * iB (b i) * φ Polynomial.X ^ e₁ i * Ti ^ e₂ i := by
    intro N S Ng B' P' _ _ _ _ _ _ _ ι f γS ψB hf hc
    obtain ⟨R, hR, hA, iB, γ, het, hγ, hγa, hι, hspan⟩ := gen _ _ B' P' ι f γS ψB hf hc
    letI iN : Algebra N R := ((algebraMap S R).comp
      ((algebraMap (Polynomial N) S).comp Polynomial.C)).toAlgebra
    let φ : Polynomial N →ₐ[N] R :=
      { toRingHom := (algebraMap S R).comp (algebraMap (Polynomial N) S)
        commutes' := fun c => rfl }
    have hφ : ∀ p, φ p = algebraMap S R (algebraMap (Polynomial N) S p) := fun _ => rfl
    obtain ⟨Ti, hTi⟩ : ∃ Ti : R,
        Ti = algebraMap S R (IsLocalization.Away.invSelf (S := S) (Polynomial.X : Polynomial N)) :=
      ⟨_, rfl⟩
    have hssi : algebraMap (Polynomial N) S Polynomial.X *
        IsLocalization.Away.invSelf (S := S) (Polynomial.X : Polynomial N) = 1 :=
      IsLocalization.Away.mul_invSelf _
    have h₁ : (algebraMap (Polynomial N) S).Etale :=
      RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway (Polynomial.X : Polynomial N))
    have h₂ : (algebraMap S R).Etale := RingHom.etale_algebraMap.mpr het
    have laurent : ∀ m : S, ∃ (k : ℕ) (c : Fin k → N) (n : ℕ),
        m = ∑ i : Fin k, algebraMap (Polynomial N) S (Polynomial.C (c i)) *
          algebraMap (Polynomial N) S Polynomial.X ^ (i : ℕ) *
          IsLocalization.Away.invSelf (S := S) (Polynomial.X : Polynomial N) ^ n := by
      intro m
      obtain ⟨n, p, hp⟩ := IsLocalization.Away.surj (Polynomial.X : Polynomial N) m
      refine ⟨p.natDegree + 1, fun i => p.coeff i, n, ?_⟩
      have e1 : m = m * (algebraMap (Polynomial N) S Polynomial.X *
          IsLocalization.Away.invSelf (S := S) (Polynomial.X : Polynomial N)) ^ n := by
        rw [hssi, one_pow, mul_one]
      rw [e1, mul_pow, ← mul_assoc, hp]
      conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow p]
      rw [map_sum, Finset.sum_range, Finset.sum_mul]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_mul, map_pow]
    let Sp : R → Prop := fun z => ∃ (k : ℕ) (mm : Fin k → N) (b : Fin k → B') (e₁ e₂ : Fin k → ℕ),
      z = ∑ i, algebraMap N R (mm i) * iB (b i) * φ Polynomial.X ^ e₁ i * Ti ^ e₂ i
    have Sp0 : Sp 0 := ⟨0, Fin.elim0, Fin.elim0, Fin.elim0, Fin.elim0, by simp⟩
    have Spadd : ∀ x y, Sp x → Sp y → Sp (x + y) := by
      rintro x y ⟨k1, m1, b1, e1, f1, h1⟩ ⟨k2, m2, b2, e2, f2, h2⟩
      refine ⟨k1 + k2, Fin.append m1 m2, Fin.append b1 b2, Fin.append e1 e2, Fin.append f1 f2, ?_⟩
      rw [Fin.sum_univ_add]
      simp only [Fin.append_left, Fin.append_right]
      rw [← h1, ← h2]
    have Spsum : ∀ {J : Type} (t : Finset J) (F : J → R), (∀ i ∈ t, Sp (F i)) →
        Sp (∑ i ∈ t, F i) :=
      fun t F h => Finset.sum_induction F Sp Spadd Sp0 h
    have Sp1 : ∀ c b e n, Sp (algebraMap N R c * iB b * φ Polynomial.X ^ e * Ti ^ n) :=
      fun c b e n => ⟨1, ![c], ![b], ![e], ![n], by
        simp only [Fin.sum_univ_one, Matrix.cons_val_zero]⟩
    refine ⟨R, hR, iN, φ, iB, Ti, γ, algebraMap S R,
      RingHom.Etale.stableUnderComposition (algebraMap (Polynomial N) S) (algebraMap S R) h₁ h₂,
      ?_, hγ, fun p => rfl, hTi.symm, hγa, fun c => (hι c).symm, fun c => rfl, ?_⟩
    · rw [hTi, hφ, ← map_mul, hssi, map_one]
    · intro z
      obtain ⟨n, mm, b, rfl⟩ := hspan z
      show Sp (∑ i, algebraMap S R (mm i) * iB (b i))
      refine Spsum _ _ fun i _ => ?_
      obtain ⟨k, c, n', hm⟩ := laurent (mm i)
      rw [hm, map_sum, Finset.sum_mul]
      refine Spsum _ _ fun j _ => ?_
      have e : algebraMap S R (algebraMap (Polynomial N) S (Polynomial.C (c j)) *
          algebraMap (Polynomial N) S Polynomial.X ^ (j : ℕ) *
          IsLocalization.Away.invSelf (S := S) (Polynomial.X : Polynomial N) ^ n') * iB (b i) =
          algebraMap N R (c j) * iB (b i) * φ Polynomial.X ^ (j : ℕ) * Ti ^ n' := by
        rw [hTi, map_mul, map_mul, map_pow, map_pow]
        change _ = φ (Polynomial.C (c j)) * iB (b i) * φ Polynomial.X ^ (j : ℕ) * _
        rw [hφ, hφ]
        ring
      rw [e]
      exact Sp1 _ _ _ _
  have key : ∀ {T : Type u} [CommRing T] (A B s si : T), s * si = 1 →
      A ^ ℓ * si ^ a * (B ^ ℓ * s ^ a) = (A * B) ^ ℓ := by
    intro T _ A B s si h
    rw [show A ^ ℓ * si ^ a * (B ^ ℓ * s ^ a) = (A * B) ^ ℓ * (s * si) ^ a by ring, h, one_pow,
      mul_one]

  have core2 : ∀ (N : Type u) [CommRing N] (cN : ↥W →+* N) (y0 y1 : N), y0 * y1 = cN β →
      ∀ (γN : N →+* P), γN y0 = x0 → γN y1 = x1 →
      (∀ w, γN (cN w) = φB (f₀ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 *
        MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.C w)))) →
      ∃ (R₁ : Type u) (_ : CommRing R₁) (_ : Algebra N R₁) (φ : Polynomial N →ₐ[N] R₁)
        (iB : B →+* R₁) (Ti : R₁) (γ₁ : R₁ →+* P),
        RingHom.Etale φ.toRingHom ∧ φ Polynomial.X * Ti = 1 ∧ γ₁.comp iB = φB ∧
        γ₁ (algebraMap N R₁ y0) = x0 ∧ γ₁ (algebraMap N R₁ y1) = x1 ∧
        γ₁ (φ Polynomial.X) = τ ∧
        (∀ w : ↥W, algebraMap N R₁ (cN w) = iB (f₀ (Ideal.Quotient.mk (Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.C w)))) ∧
        iB (f₀ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g}) (MvPolynomial.X 0))) = algebraMap N R₁ y0 ^ ℓ * Ti ^ a ∧
        iB (f₀ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g}) (MvPolynomial.X 1))) = algebraMap N R₁ y1 ^ ℓ *
          φ Polynomial.X ^ a ∧
        ∀ z : R₁, ∃ (k : ℕ) (mm : Fin k → N) (b : Fin k → B) (e₁ e₂ : Fin k → ℕ),
          z = ∑ i, algebraMap N R₁ (mm i) * iB (b i) * φ Polynomial.X ^ e₁ i * Ti ^ e₂ i := by
    intro N _ cN y0 y1 hy γN hγ0 hγ1 hγC
    let S := Localization.Away (Polynomial.X : Polynomial N)
    have hssi : algebraMap (Polynomial N) S Polynomial.X *
        IsLocalization.Away.invSelf (S := S) (Polynomial.X : Polynomial N) = 1 :=
      IsLocalization.Away.mul_invSelf _

    obtain ⟨ι, hιC, hι0, hι1⟩ := lift g S
      (((algebraMap (Polynomial N) S).comp Polynomial.C).comp cN)
      (algebraMap (Polynomial N) S (Polynomial.C y0) ^ ℓ *
        IsLocalization.Away.invSelf (S := S) (Polynomial.X : Polynomial N) ^ a)
      (algebraMap (Polynomial N) S (Polynomial.C y1) ^ ℓ *
        algebraMap (Polynomial N) S Polynomial.X ^ a)
      (by
        simp only [RingHom.comp_apply]
        rw [← hβg]
        simp only [map_pow]
        rw [← hy]
        simp only [map_mul]
        exact key _ _ _ _ hssi)
    simp only [RingHom.comp_apply] at hιC

    have hU : IsUnit (Polynomial.eval₂RingHom γN τ Polynomial.X) := by
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]; exact hτ
    obtain ⟨γS, hγS⟩ : ∃ γS : S →+* P, ∀ p, γS (algebraMap (Polynomial N) S p) =
        Polynomial.eval₂ γN τ p :=
      ⟨IsLocalization.Away.lift (S := S) (Polynomial.X : Polynomial N) hU, fun p => by
        rw [IsLocalization.Away.lift_eq, Polynomial.coe_eval₂RingHom]⟩
    have hγSc : ∀ c, γS (algebraMap (Polynomial N) S (Polynomial.C c)) = γN c := fun c => by
      rw [hγS, Polynomial.eval₂_C]
    have hγSs : γS (algebraMap (Polynomial N) S Polynomial.X) = τ := by
      rw [hγS, Polynomial.eval₂_X]
    have hτsi : τ * γS (IsLocalization.Away.invSelf (S := S) (Polynomial.X : Polynomial N)) = 1 := by
      rw [← hγSs, ← map_mul, hssi, map_one]
    have hcomp : γS.comp ι = φB.comp f₀ := by
      apply ext g P
      · intro w
        rw [RingHom.comp_apply, RingHom.comp_apply, hιC, hγSc, hγC]
      · rw [RingHom.comp_apply, RingHom.comp_apply, hι0, map_mul, map_pow, map_pow, hγSc, hγ0,
          hx0, mul_assoc, ← mul_pow, hτsi, one_pow, mul_one]
      · rw [RingHom.comp_apply, RingHom.comp_apply, hι1, map_mul, map_pow, map_pow, hγSc, hγ1,
          hγSs, hx1]
    obtain ⟨R, hR, hA, φ, iB, Ti, γ, ρ, het, hXT, hγ, hρalg, hρsi, hγρ, hιρ, hφC, hspan⟩ :=
      core N S _ B P ι f₀ γS φB hfet hcomp
    refine ⟨R, hR, hA, φ, iB, Ti, γ, het, hXT, hγ, ?_, ?_, ?_, ?_, ?_, ?_, hspan⟩
    · rw [← hφC, ← hρalg, hγρ, hγSc, hγ0]
    · rw [← hφC, ← hρalg, hγρ, hγSc, hγ1]
    · rw [← hρalg, hγρ, hγSs]
    · intro w
      rw [← hφC, ← hρalg, hιρ, hιC]
    · rw [hιρ, hι0, map_mul, map_pow, map_pow, hρalg, hφC, hρsi]
    · rw [hιρ, hι1, map_mul, map_pow, map_pow, hρalg, hρalg, hφC]

  obtain ⟨γN, hγC, hγ0, hγ1⟩ := lift β P
    ((φB.comp f₀).comp ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C g})).comp MvPolynomial.C)) x0 x1 (by rw [hx01]; rfl)
  simp only [RingHom.comp_apply] at hγC
  exact core2 (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β})
    ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C β})).comp MvPolynomial.C)
    (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β})
      (MvPolynomial.X 0))
    (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β})
      (MvPolynomial.X 1)) hXβ γN hγ0 hγ1 (fun w => hγC w)

theorem wcLlsASin_integral : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (β : ↥W) (ℓ a n m : ℕ)
    (R B : Type u) [CommRing R] [CommRing B]
    (iN : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) →+* R)
    (iB : B →+* R) (wB : ↥W →+* B) (bu bv e lam : B) (T Ti : R),
    2 ≤ ℓ → a * n = 1 + m * ℓ → IsUnit e →
    (∀ w : ↥W, iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.C w)) = iB (wB w)) →
    T * Ti = 1 →
    iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.X 0)) ^ ℓ = iB bu * T ^ a →
    iB bv = iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.X 1)) ^ ℓ * T ^ a →
    iB e * T ^ (m * (ℓ - 1) + 1) - T ^ (m * (ℓ - 1)) +
      iB lam * iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.X 0)) ^ (n * (ℓ - 1)) = 0 →
    (∀ z : R, ∃ (k : ℕ) (mm : Fin k → (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β})) (b : Fin k → B) (e₁ e₂ : Fin k → ℕ),
      z = ∑ i, iN (mm i) * iB (b i) * T ^ e₁ i * Ti ^ e₂ i) →
    ∀ z : R, ∃ p : Polynomial B, p.Monic ∧ p.eval₂ iB z = 0 :=
by
  intro Ω _ W β ℓ a n m R B _ _ iN iB wB bu bv e lam T Ti hℓ han he hC hTT hx hy hE hgen
  letI : Algebra B R := iB.toAlgebra
  obtain ⟨k, rfl⟩ : ∃ k, ℓ = k + 2 := ⟨ℓ - 2, by omega⟩
  have hl1 : k + 2 - 1 = k + 1 := by omega
  rw [hl1] at hE

  have core : ∀ X : R, X ^ (k + 2) = iB bu * T ^ a →
      iB e * T ^ (m * (k + 1) + 1) - T ^ (m * (k + 1)) + iB lam * X ^ (n * (k + 1)) = 0 →
      (∃ p : Polynomial B, p.Monic ∧ p.eval₂ iB T = 0) ∧
        (∃ p : Polynomial B, p.Monic ∧ p.eval₂ iB Ti = 0) := by
    intro X hX hEX
    have ha : iB lam * X ^ (n * (k + 1)) = T ^ (m * (k + 1)) * (1 - iB e * T) := by
      rw [pow_succ] at hEX
      linear_combination hEX
    have hxp : X ^ (n * (k + 1) * (k + 2)) = iB bu ^ (n * (k + 1)) * T ^ (a * (n * (k + 1))) := by
      rw [mul_comm (n * (k + 1)) (k + 2), pow_mul, hX, mul_pow, ← pow_mul]
    have hexp : a * (n * (k + 1)) = (k + 1) + (k + 2) * (m * (k + 1)) := by
      have h1 : a * (n * (k + 1)) = (a * n) * (k + 1) := by ring
      rw [h1, han]; ring
    have e1 : iB (lam ^ (k + 2) * bu ^ (n * (k + 1))) * T ^ (k + 1) * T ^ ((k + 2) * (m * (k + 1)))
        = (1 - iB e * T) ^ (k + 2) * T ^ ((k + 2) * (m * (k + 1))) := by
      have e2 : (iB lam * X ^ (n * (k + 1))) ^ (k + 2) = (T ^ (m * (k + 1)) * (1 - iB e * T)) ^ (k + 2) := by
        rw [ha]
      rw [mul_pow, ← pow_mul, hxp, hexp, mul_pow, ← pow_mul] at e2
      rw [map_mul, map_pow, map_pow]
      calc iB lam ^ (k + 2) * iB bu ^ (n * (k + 1)) * T ^ (k + 1) * T ^ ((k + 2) * (m * (k + 1)))
          = iB lam ^ (k + 2) * (iB bu ^ (n * (k + 1)) * T ^ (k + 1 + (k + 2) * (m * (k + 1)))) := by
            rw [pow_add]; ring
        _ = T ^ (m * (k + 1) * (k + 2)) * (1 - iB e * T) ^ (k + 2) := e2
        _ = (1 - iB e * T) ^ (k + 2) * T ^ ((k + 2) * (m * (k + 1))) := by
            rw [mul_comm (m * (k + 1)) (k + 2)]; ring
    have star : iB (lam ^ (k + 2) * bu ^ (n * (k + 1))) * T ^ (k + 1) = (1 - iB e * T) ^ (k + 2) := by
      have hTTp : (T * Ti) ^ ((k + 2) * (m * (k + 1))) = 1 := by rw [hTT, one_pow]
      calc iB (lam ^ (k + 2) * bu ^ (n * (k + 1))) * T ^ (k + 1)
          = iB (lam ^ (k + 2) * bu ^ (n * (k + 1))) * T ^ (k + 1) * (T * Ti) ^ ((k + 2) * (m * (k + 1))) := by
            rw [hTTp, mul_one]
        _ = (iB (lam ^ (k + 2) * bu ^ (n * (k + 1))) * T ^ (k + 1) * T ^ ((k + 2) * (m * (k + 1)))) *
              Ti ^ ((k + 2) * (m * (k + 1))) := by rw [mul_pow]; ring
        _ = ((1 - iB e * T) ^ (k + 2) * T ^ ((k + 2) * (m * (k + 1)))) *
              Ti ^ ((k + 2) * (m * (k + 1))) := by rw [e1]
        _ = (1 - iB e * T) ^ (k + 2) * (T * Ti) ^ ((k + 2) * (m * (k + 1))) := by rw [mul_pow]; ring
        _ = (1 - iB e * T) ^ (k + 2) := by rw [hTTp, mul_one]
    set K := lam ^ (k + 2) * bu ^ (n * (k + 1)) with hK
    clear_value K
    obtain ⟨v, hv⟩ := he.exists_right_inv
    have hVE : iB v * iB e = 1 := by rw [← map_mul, mul_comm, hv, map_one]

    have eqTi : (Ti - iB e) ^ (k + 2) - iB K * Ti = 0 := by
      have h2 : Ti - iB e = (1 - iB e * T) * Ti := by linear_combination (iB e) * hTT
      rw [h2, mul_pow, ← star]
      calc iB K * T ^ (k + 1) * Ti ^ (k + 2) - iB K * Ti = iB K * Ti * ((T * Ti) ^ (k + 1) - 1) := by ring
        _ = 0 := by rw [hTT, one_pow, sub_self, mul_zero]
    have eqT : (T - iB v) ^ (k + 2) - iB ((-v) ^ (k + 2) * K) * T ^ (k + 1) = 0 := by
      have h2 : T - iB v = (-iB v) * (1 - iB e * T) := by linear_combination (-T) * hVE
      rw [h2, mul_pow, ← star, map_mul iB ((-v) ^ (k + 2)) K, map_pow, map_neg]
      ring
    have hdeg : ∀ (c : B) (q : Polynomial B), q.degree < ((k + 2 : ℕ) : WithBot ℕ) →
        ((Polynomial.X - Polynomial.C c) ^ (k + 2) - q).Monic := by
      intro c q hq
      rcases subsingleton_or_nontrivial B with hB | hB
      · unfold Polynomial.Monic; exact Subsingleton.elim _ _
      · have hmon := (Polynomial.monic_X_sub_C c).pow (k + 2)
        apply Polynomial.Monic.sub_of_left hmon
        rw [Polynomial.degree_eq_natDegree hmon.ne_zero, (Polynomial.monic_X_sub_C c).natDegree_pow,
          Polynomial.natDegree_X_sub_C, mul_one]
        exact hq
    constructor
    · refine ⟨(Polynomial.X - Polynomial.C v) ^ (k + 2) -
          Polynomial.C ((-v) ^ (k + 2) * K) * Polynomial.X ^ (k + 1), hdeg v _ ?_, ?_⟩
      · refine lt_of_le_of_lt (Polynomial.degree_C_mul_X_pow_le _ _) ?_
        exact_mod_cast (by omega : k + 1 < k + 2)
      · simp only [Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X, Polynomial.eval₂_C,
          Polynomial.eval₂_mul]
        exact eqT
    · refine ⟨(Polynomial.X - Polynomial.C e) ^ (k + 2) - Polynomial.C K * Polynomial.X, hdeg e _ ?_, ?_⟩
      · refine lt_of_le_of_lt (Polynomial.degree_C_mul_X_le _) ?_
        exact_mod_cast (by omega : 1 < k + 2)
      · simp only [Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X, Polynomial.eval₂_C,
          Polynomial.eval₂_mul]
        exact eqTi
  obtain ⟨hT', hTi'⟩ := core _ hx hE
  have hT : IsIntegral B T := hT'
  have hTi : IsIntegral B Ti := hTi'
  have hxI : IsIntegral B (iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.X 0))) := by
    refine IsIntegral.of_pow (n := k + 2) (by omega) ?_
    rw [hx]
    exact (isIntegral_algebraMap (x := bu)).mul (hT.pow a)
  have hyI : IsIntegral B (iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.X 1))) := by
    refine IsIntegral.of_pow (n := k + 2) (by omega) ?_
    have h1 : iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.X 1)) ^ (k + 2) = iB bv * Ti ^ a := by
      rw [hy]
      calc iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.X 1)) ^ (k + 2)
          = iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.X 1)) ^ (k + 2) * (T * Ti) ^ a := by
            rw [hTT, one_pow, mul_one]
        _ = _ := by rw [mul_pow]; ring
    rw [h1]
    exact (isIntegral_algebraMap (x := bv)).mul (hTi.pow a)
  have hN : ∀ q : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}),
      IsIntegral B (iN q) := by
    intro q
    obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective q
    induction P using MvPolynomial.induction_on with
    | C w =>
      rw [hC]
      exact isIntegral_algebraMap (x := wB w)
    | add p q hp hq =>
      rw [map_add, map_add]
      exact hp.add hq
    | mul_X p i hp =>
      rw [map_mul, map_mul]
      fin_cases i
      · exact hp.mul hxI
      · exact hp.mul hyI
  intro z
  obtain ⟨k', mm, b, e₁, e₂, rfl⟩ := hgen z
  have hz : IsIntegral B (∑ i, iN (mm i) * iB (b i) * T ^ e₁ i * Ti ^ e₂ i) := by
    refine IsIntegral.sum _ (fun i _ => ?_)
    exact (((hN (mm i)).mul (isIntegral_algebraMap (x := b i))).mul (hT.pow _)).mul (hTi.pow _)
  exact hz

theorem wcLlsASin_node_ideal : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (β : ↥W)
    (R B : Type u) [CommRing R] [CommRing B] [Algebra ↥W R]
    (iN : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) →+* R)
    (iB : B →+* R) (wB : ↥W →+* B) (bu bv e : B) (T Ti : R) (Q : Ideal R),
    (∀ w : ↥W, iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.C w)) = algebraMap ↥W R w) →
    (∀ w : ↥W, iB (wB w) = algebraMap ↥W R w) →
    (∀ z : R, ∃ (k : ℕ) (mm : Fin k → (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β})) (b : Fin k → B) (e₁ e₂ : Fin k → ℕ),
      z = ∑ i, iN (mm i) * iB (b i) * T ^ e₁ i * Ti ^ e₂ i) →
    IsUnit e → T * Ti = 1 →
    iB e * T - 1 ∈ Ideal.span {iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.X 0))} →
    iB bu ∈ Ideal.span {iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.X 0))} →
    iB bv ∈ Ideal.span {iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.X 1))} →
    iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.X 0)) ∈ Q →
    iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.X 1)) ∈ Q →
    (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R) ≤ Q →
    Q.comap iB ≤ Ideal.span {bu, bv} ⊔ (IsLocalRing.maximalIdeal ↥W).map wB →
    Q = Ideal.span {iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.X 0)),
        iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.X 1))} ⊔
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R) :=
by
  intro Ω _ W β R B _ _ _ iN iB wB bu bv e T Ti Q hN hB hspan he hT hET hbu hbv hx0 hx1 hmQ hcomap
  set x0 := iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β})
    (MvPolynomial.X 0)) with hx0def
  set x1 := iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β})
    (MvPolynomial.X 1)) with hx1def
  set S : Ideal R := Ideal.span {x0, x1} with hSdef
  set mR := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R) with hmR
  have hxS0 : x0 ∈ S := Ideal.subset_span (Set.mem_insert _ _)
  have hxS1 : x1 ∈ S := Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  have hS0 : Ideal.span {x0} ≤ S := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hxS0)
  have hS1 : Ideal.span {x1} ≤ S := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hxS1)

  have hIQ : S ⊔ mR ≤ Q := by
    refine sup_le (Ideal.span_le.mpr ?_) hmQ
    rintro x (rfl | rfl)
    · exact hx0
    · exact hx1

  have hXS : ∀ n : Fin 2, iN (Ideal.Quotient.mk (Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.X n)) ∈ S :=
    Fin.forall_fin_two.mpr ⟨hxS0, hxS1⟩
  have key : ∀ P : MvPolynomial (Fin 2) ↥W,
      iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) P) -
        algebraMap ↥W R (MvPolynomial.constantCoeff P) ∈ S := by
    intro P
    induction P using MvPolynomial.induction_on with
    | C a =>
      rw [MvPolynomial.constantCoeff_C, hN a, sub_self]
      exact S.zero_mem
    | add p q hp hq =>
      have h : iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β})
            (p + q)) - algebraMap ↥W R (MvPolynomial.constantCoeff (p + q)) =
          (iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) p) -
            algebraMap ↥W R (MvPolynomial.constantCoeff p)) +
          (iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) q) -
            algebraMap ↥W R (MvPolynomial.constantCoeff q)) := by
        simp only [map_add]; ring
      rw [h]
      exact S.add_mem hp hq
    | mul_X p n _ =>
      have hc0 : MvPolynomial.constantCoeff (p * MvPolynomial.X n) = 0 := by
        rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero]
      rw [hc0, map_zero, sub_zero, map_mul (Ideal.Quotient.mk _), map_mul iN]
      exact S.mul_mem_left _ (hXS n)
  have hsplit : ∀ m : MvPolynomial (Fin 2) ↥W ⧸ Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}, ∃ c : ↥W,
      iN m - algebraMap ↥W R c ∈ S := by
    intro m
    obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective m
    exact ⟨_, key P⟩

  obtain ⟨ei, hei⟩ := he.exists_right_inv
  have hiBe : iB e * iB ei = 1 := by rw [← map_mul, hei, map_one]

  have hTS : T - iB ei ∈ S := by
    have h1 : T - iB ei = iB ei * (iB e * T - 1) := by linear_combination (-T) * hiBe
    rw [h1]
    exact S.mul_mem_left _ (hS0 hET)
  have hTiS : Ti - iB e ∈ S := by
    have h1 : Ti - iB e = -(Ti * iB e) * (T - iB ei) := by
      linear_combination (iB e) * hT - Ti * hiBe
    rw [h1]
    exact S.mul_mem_left _ hTS

  have hTn : ∀ n : ℕ, T ^ n - iB (ei ^ n) ∈ S := by
    intro n
    obtain ⟨c, hc⟩ := sub_dvd_pow_sub_pow T (iB ei) n
    rw [map_pow, hc]
    exact S.mul_mem_right _ hTS
  have hTin : ∀ n : ℕ, Ti ^ n - iB (e ^ n) ∈ S := by
    intro n
    obtain ⟨c, hc⟩ := sub_dvd_pow_sub_pow Ti (iB e) n
    rw [map_pow, hc]
    exact S.mul_mem_right _ hTiS

  have hmul : ∀ a a' c c' : R, a - a' ∈ S → c - c' ∈ S → a * c - a' * c' ∈ S := by
    intro a a' c c' h1 h2
    have h : a * c - a' * c' = (a - a') * c + a' * (c - c') := by ring
    rw [h]
    exact S.add_mem (S.mul_mem_right _ h1) (S.mul_mem_left _ h2)

  refine le_antisymm (fun z hz => ?_) hIQ
  obtain ⟨k, mm, b, e₁, e₂, hzeq⟩ := hspan z
  choose c hc using fun i => hsplit (mm i)
  set b₀ : B := ∑ i, wB (c i) * b i * ei ^ e₁ i * e ^ e₂ i with hb₀
  have hdiff : z - iB b₀ ∈ S := by
    rw [hzeq, hb₀, map_sum, ← Finset.sum_sub_distrib]
    refine Ideal.sum_mem _ (fun i _ => ?_)
    rw [map_mul, map_mul, map_mul]
    refine hmul _ _ _ _ (hmul _ _ _ _ (hmul _ _ _ _ ?_ ?_) (hTn _)) (hTin _)
    · rw [hB]; exact hc i
    · rw [sub_self]; exact S.zero_mem
  have hdQ : z - iB b₀ ∈ Q := hIQ (Ideal.mem_sup_left hdiff)
  have hb0Q : iB b₀ ∈ Q := by
    have h := Q.sub_mem hz hdQ
    rwa [sub_sub_cancel] at h
  have hb0' : b₀ ∈ Ideal.span {bu, bv} ⊔ (IsLocalRing.maximalIdeal ↥W).map wB :=
    hcomap (Ideal.mem_comap.mpr hb0Q)
  have hBc : iB.comp wB = algebraMap ↥W R := RingHom.ext hB
  have hle : (Ideal.span {bu, bv} ⊔ (IsLocalRing.maximalIdeal ↥W).map wB).map iB ≤ S ⊔ mR := by
    rw [Ideal.map_sup, Ideal.map_span, Ideal.map_map, hBc]
    refine sup_le_sup_right (Ideal.span_le.mpr ?_) _
    rintro x ⟨y, hy, rfl⟩
    rcases hy with rfl | rfl
    · exact hS0 hbu
    · exact hS1 hbv
  have hmap : iB b₀ ∈ S ⊔ mR := hle (Ideal.mem_map_of_mem _ hb0')
  have h := (S ⊔ mR).add_mem (Ideal.mem_sup_left hdiff) hmap
  rwa [sub_add_cancel] at h

theorem wcLlsASi_node_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) → Module.finrank K L = ℓ →
    ∀ (n a m : ℕ) (lam : ↥W) (d d' : A) (x ρ : L), 0 < n → 1 ≤ a → a < ℓ →
    a * n = 1 + m * ℓ → d ∉ 𝔭 → d' ∉ 𝔭 → ρ ≠ 0 →
    x ^ ℓ = algebraMap A L u * ρ ^ a →
    algebraMap A L d' * ρ ^ (m * (ℓ - 1) + 1) - algebraMap A L d * ρ ^ (m * (ℓ - 1)) +
      algebraMap A L d * algebraMap A L (algebraMap ↥W A lam) * x ^ (n * (ℓ - 1)) = 0 →
    x ∉ Set.range (algebraMap K L) →
    (∀ p : Polynomial ↥W, p ≠ 0 →
      Polynomial.eval₂ ((algebraMap A L).comp (algebraMap ↥W A)) x p ≠ 0) →
    ∀ y : Ideal ↥(integralClosure A L), y.IsPrime →
      y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → ∀ (_ : y.IsPrime),
      ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) :=
by
  intro Ω _ _ W hdim hWt ℓ hℓ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g hPD hfin n a m lam d d' x ρ
    hn ha1 haℓ hBez hd hd' hρ0 hxl hrel hxK htr y hyP hy hyP'
  classical
  haveI := hyP

  obtain ⟨-, hNZ, -, hmax, hm𝔭, hgm, hg0, huv, h𝔭eq, h₀, hh₀, f₀, hf₀C, hf₀0, hf₀1, hf₀et⟩ :=
    id hPD
  haveI := hNZ
  haveI h𝔭P : 𝔭.IsPrime := hmax.isPrime
  have hu𝔭 : u ∈ 𝔭 := by
    rw [h𝔭eq]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hv𝔭 : v ∈ 𝔭 := by
    rw [h𝔭eq]
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
  have hinj : ∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0 := by
    intro w hw h0
    have h1 : algebraMap ↥W A w = 0 := (IsFractionRing.injective A K) (by rw [h0, map_zero])
    rw [Algebra.algebraMap_eq_smul_one, smul_eq_zero] at h1
    rcases h1 with h1 | h1
    · exact hw h1
    · exact one_ne_zero h1
  have htow : ∀ a : A, algebraMap A L a = algebraMap K L (algebraMap A K a) :=
    IsScalarTower.algebraMap_apply A K L
  have hu0L : algebraMap A L u ≠ 0 := by
    rw [htow]; intro h0
    apply hinj g hg0
    apply (algebraMap K L).injective
    rw [← htow, ← huv, map_mul, htow, h0, zero_mul, map_zero]
  have rootW : ∀ N : ℕ, 0 < N → ∀ z : ↥W, ∃ r : ↥W, r ^ N = z := by
    intro N hN z
    obtain ⟨r, hr⟩ := IsAlgClosed.exists_pow_nat_eq (z : Ω) hN
    by_cases hrW : r ∈ W
    · refine ⟨⟨r, hrW⟩, Subtype.ext ?_⟩
      first
        | simpa using hr
        | exact hr
    · exfalso
      have hr0 : r ≠ 0 := fun h0 => hrW (h0 ▸ W.zero_mem)
      have hrinv : r⁻¹ ∈ W := (W.mem_or_inv_mem r).resolve_left hrW
      obtain ⟨N', rfl⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by omega⟩
      have h1 : r = (z : Ω) * r⁻¹ ^ N' := by
        rw [← hr, inv_pow, pow_succ, mul_assoc, mul_comm r, ← mul_assoc,
          mul_inv_cancel₀ (pow_ne_zero _ hr0), one_mul]
      apply hrW
      rw [h1]
      exact mul_mem z.2 (pow_mem hrinv N')
  obtain ⟨β, hβ⟩ := rootW ℓ hℓ.pos g
  have hβ0 : β ≠ 0 := by
    rintro rfl; apply hg0; rw [← hβ, zero_pow hℓ.pos.ne']
  have hβm : β ∈ IsLocalRing.maximalIdeal ↥W :=
    (IsLocalRing.maximalIdeal.isMaximal ↥W).isPrime.mem_of_pow_mem ℓ (by rw [hβ]; exact hgm)

  obtain ⟨κ, hκ⟩ : ∃ κ : A →+* Localization.AtPrime y,
      κ = (algebraMap ↥(integralClosure A L) (Localization.AtPrime y)).comp
        (algebraMap A ↥(integralClosure A L)) := ⟨_, rfl⟩
  have hκapp : ∀ a : A, algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
      (algebraMap A ↥(integralClosure A L) a) = κ a := fun a => by rw [hκ]; rfl
  have hF1 : ∀ a : A, κ a ∈ IsLocalRing.maximalIdeal (Localization.AtPrime y) ↔ a ∈ 𝔭 := by
    intro a
    rw [← hκapp, IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime y) y,
      ← Ideal.mem_comap, hy]
  have hιinj : Function.Injective (algebraMap A ↥(integralClosure A L)) := by
    intro a b hab
    have h1 : algebraMap A L a = algebraMap A L b := congrArg Subtype.val hab
    rw [htow a, htow b] at h1
    exact IsFractionRing.injective A K ((algebraMap K L).injective h1)
  have hlocinj : Function.Injective
      (algebraMap ↥(integralClosure A L) (Localization.AtPrime y)) :=
    IsLocalization.injective (Localization.AtPrime y) (Ideal.primeCompl_le_nonZeroDivisors y)
  have hκinj : Function.Injective κ := by
    intro a b hab
    rw [← hκapp, ← hκapp] at hab
    exact hιinj (hlocinj hab)
  have hunit : ∀ a : A, a ∉ 𝔭 → IsUnit (κ a) := fun a ha =>
    IsLocalRing.notMem_maximalIdeal.mp (fun h => ha ((hF1 a).mp h))

  obtain ⟨xh, eh, rh, Xt, St, hSt, hXtS, hXtL, hxhm, hehm, hrhu, hprod, hxl', hel', hrel',
      hlast⟩ :=
    wcLlsASin_points Ω W A K L 𝔭 u v d d' g β lam ℓ n a m x ρ y hℓ hn ha1 hBez hu𝔭 hv𝔭 hd hd'
      huv hβ hu0L hρ0 hxl hrel hy
  simp only [hκapp] at hXtS hprod hxl' hel' hrel' hlast
  have hℓ2 : 2 ≤ ℓ := hℓ.two_le
  have hd0 : d ≠ 0 := fun h => hd (h ▸ 𝔭.zero_mem)

  have hx𝔭 : (RingHom.id A) h₀ * (d * d') ∉ 𝔭 := by
    rw [RingHom.id_apply]
    intro hm
    rcases h𝔭P.mem_or_mem hm with h | h
    · exact hh₀ h
    · rcases h𝔭P.mem_or_mem h with h' | h'
      · exact hd h'
      · exact hd' h'
  have hx0 : (RingHom.id A) h₀ * (d * d') ≠ 0 := fun h => hx𝔭 (h ▸ 𝔭.zero_mem)
  obtain ⟨φ₁, hφ₁, hf₁et⟩ := wcpa_dj_llsm_brsp_chart_compose A A
    (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
    (RingHom.id A) h₀ (d * d') f₀ hf₀et (by
      rw [RingHom.comp_id]
      exact RingHom.etale_algebraMap.mpr
        (Algebra.Etale.of_isLocalizationAway ((RingHom.id A) h₀ * (d * d'))))
  haveI hBdom : IsDomain (Localization.Away ((RingHom.id A) h₀ * (d * d'))) :=
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hx0)
  have hφ₁a : ∀ a : A, φ₁ (algebraMap A (Localization.Away h₀) a) =
      algebraMap A (Localization.Away ((RingHom.id A) h₀ * (d * d'))) a := fun a => by
    have := RingHom.congr_fun hφ₁ a
    simpa using this
  have hf₁C : ∀ w : ↥W, (φ₁.comp f₀) (Ideal.Quotient.mk (Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.C w)) =
      algebraMap A (Localization.Away ((RingHom.id A) h₀ * (d * d'))) (algebraMap ↥W A w) := by
    intro w
    have h1 := RingHom.congr_fun hf₀C w
    simp only [RingHom.comp_apply] at h1
    rw [RingHom.comp_apply, h1, hφ₁a]
  have hf₁0 : (φ₁.comp f₀) (Ideal.Quotient.mk (Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.X 0)) =
      algebraMap A (Localization.Away ((RingHom.id A) h₀ * (d * d'))) u := by
    rw [RingHom.comp_apply, hf₀0, hφ₁a]
  have hf₁1 : (φ₁.comp f₀) (Ideal.Quotient.mk (Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.X 1)) =
      algebraMap A (Localization.Away ((RingHom.id A) h₀ * (d * d'))) v := by
    rw [RingHom.comp_apply, hf₀1, hφ₁a]
  obtain ⟨φB, hφBdef⟩ : ∃ φ : Localization.Away ((RingHom.id A) h₀ * (d * d')) →+*
      Localization.AtPrime y, φ = IsLocalization.Away.lift
        (S := Localization.Away ((RingHom.id A) h₀ * (d * d'))) ((RingHom.id A) h₀ * (d * d'))
        (hunit _ hx𝔭) := ⟨_, rfl⟩
  have hφB : ∀ a : A, φB (algebraMap A (Localization.Away ((RingHom.id A) h₀ * (d * d'))) a) =
      κ a := by
    intro a; rw [hφBdef]; exact IsLocalization.Away.lift_eq _ _ a
  have hφBinj : Function.Injective φB := by
    rw [injective_iff_map_eq_zero]
    intro b hb
    obtain ⟨xx, hs⟩ := IsLocalization.surj (Submonoid.powers ((RingHom.id A) h₀ * (d * d'))) b
    have h1 : κ xx.1 = 0 := by rw [← hφB, ← hs, map_mul, hb, zero_mul]
    have h2 : xx.1 = 0 := hκinj (h1.trans (map_zero κ).symm)
    have hsu : IsUnit (algebraMap A (Localization.Away ((RingHom.id A) h₀ * (d * d')))
        (xx.2 : A)) := IsLocalization.map_units _ xx.2
    rw [h2, map_zero] at hs
    exact hsu.mul_left_eq_zero.mp hs
  have hU : IsUnit (algebraMap A (Localization.Away ((RingHom.id A) h₀ * (d * d'))) h₀ *
      (algebraMap A (Localization.Away ((RingHom.id A) h₀ * (d * d'))) d *
        algebraMap A (Localization.Away ((RingHom.id A) h₀ * (d * d'))) d')) := by
    rw [← map_mul, ← map_mul]
    exact IsLocalization.Away.algebraMap_isUnit ((RingHom.id A) h₀ * (d * d'))
  have hdB := isUnit_of_mul_isUnit_left (isUnit_of_mul_isUnit_right hU)
  have hd'B := isUnit_of_mul_isUnit_right (isUnit_of_mul_isUnit_right hU)
  obtain ⟨e, he⟩ : ∃ e : Localization.Away ((RingHom.id A) h₀ * (d * d')),
      e = algebraMap A (Localization.Away ((RingHom.id A) h₀ * (d * d'))) d' *
        ↑hdB.unit⁻¹ := ⟨_, rfl⟩
  have heu : IsUnit e := by rw [he]; exact hd'B.mul (Units.isUnit _)
  have hde : algebraMap A (Localization.Away ((RingHom.id A) h₀ * (d * d'))) d * e =
      algebraMap A (Localization.Away ((RingHom.id A) h₀ * (d * d'))) d' := by
    rw [he]; linear_combination
      (algebraMap A (Localization.Away ((RingHom.id A) h₀ * (d * d'))) d') * hdB.mul_val_inv
  have hφBe : κ d * φB e = κ d' := by rw [← hφB, ← hφB, ← map_mul, hde]

  obtain ⟨R₁, iR, iRA, φ, iB, Ti, γ₁, hφet, hTTi, hγB, hγX0, hγX1, hγT, hCw, hiBX0, hiBX1,
      hspan⟩ := wcLlsASin_pushout W g β ℓ a (Localization.Away ((RingHom.id A) h₀ * (d * d')))
    (Localization.AtPrime y) (φ₁.comp f₀) φB xh eh rh hβ hf₁et hrhu
    (by rw [hf₁C, hφB]; exact hprod) (by rw [hf₁0, hφB]; exact hxl')
    (by rw [hf₁1, hφB]; exact hel')
