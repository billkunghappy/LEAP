theorem wcFrf_end_left : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ (α : L) (f₀ : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α →
    ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ O : ↥W → ValuationSubring K, wcFrfVAL W A K 𝔭 t c O →
    ∀ a : ↥W, a ∈ IsLocalRing.maximalIdeal ↥W → a ≠ 0 →
    ∃ ρ' : ↥W, ρ' ∈ IsLocalRing.maximalIdeal ↥W ∧ ρ' ≠ 0 ∧
      wcFrfMem W A K 𝔭 t ℓ f₀ c (fun ρ => ρ ∣ a ∧ ¬ a ∣ ρ ∧ a ∣ ρ * ρ' ∧ ¬ ρ * ρ' ∣ a) :=
by
  have hCT : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u)
      [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (t : A) (c a : ↥W) (O : ↥W → ValuationSubring K)
      (A' : Type u) [CommRing A'] [IsDomain A'] [Algebra ↥W A'] [Algebra A' K] [IsFractionRing A' K]
      (u' v' : A') (𝔭' : Ideal A'), wcLlsPD W A 𝔭 (.disc t) → c ∈ IsLocalRing.maximalIdeal ↥W →
      wcFrfVAL W A K 𝔭 t c O → algebraMap A K (t - algebraMap ↥W A c) ≠ 0 →
      wcLlsBrSub W A K A' (algebraMap A K (algebraMap ↥W A a) / algebraMap A K (t - algebraMap ↥W A c))
        {algebraMap A K (t - algebraMap ↥W A c),
          algebraMap A K (algebraMap ↥W A a) / algebraMap A K (t - algebraMap ↥W A c)} →
      algebraMap A' K u' = algebraMap A K (t - algebraMap ↥W A c) →
      algebraMap A' K v' = algebraMap A K (algebraMap ↥W A a) / algebraMap A K (t - algebraMap ↥W A c) →
      wcLlsPD W A' 𝔭' (.ann u' v' a) →
      ∀ ρ σ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 → σ ∈ IsLocalRing.maximalIdeal ↥W →
        σ ≠ 0 → ρ * σ = a →
        (∀ x : A', algebraMap A' K x ∈ O ρ) ∧
          (∀ ε : A', ε ∉ 𝔭' → (algebraMap A' K ε)⁻¹ ∈ O ρ) := by
    intro Ω _ W A _ _ _ K _ _ _ 𝔭 t c a O A' _ _ _ _ _ u' v' 𝔭' hPD hc hO hz hBr hu' hv' hPD'
      ρ σ hρm hρ0 hσm hσ0 hρσ
    classical
    obtain ⟨s, hs⟩ : ∃ s : K, s = algebraMap A K (algebraMap ↥W A a) /
        algebraMap A K (t - algebraMap ↥W A c) := ⟨_, rfl⟩
    rw [← hs] at hBr hv'
    obtain ⟨hVI, hVII, hVIV⟩ := hO ρ hρm hρ0
    have hmemle : ∀ x : K, (O ρ).valuation x ≤ 1 ↔ x ∈ O ρ :=
      fun x => (O ρ).valuation_le_one_iff x
    have hF0' : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
      intro x hx h0
      have hd := hVII 1 x one_ne_zero hx (by rw [h0, div_zero]; exact (O ρ).zero_mem)
      have hu : IsUnit x := isUnit_of_dvd_one hd
      exact ((hu.map (algebraMap ↥W A)).map (algebraMap A K)).ne_zero h0
    have hvne : ∀ x : ↥W, x ≠ 0 → (O ρ).valuation (algebraMap A K (algebraMap ↥W A x)) ≠ 0 :=
      fun x hx => ((O ρ).valuation.ne_zero_iff).mpr (hF0' x hx)
    have hF1 : ∀ a : A, (O ρ).valuation (algebraMap A K a) ≤ 1 :=
      fun a => (hmemle _).mpr (hVIV a)
    have hF2 : ∀ w₁ w₂ : ↥W, w₁ ≠ 0 → w₂ ≠ 0 →
        (O ρ).valuation (algebraMap A K (algebraMap ↥W A w₁)) ≤
          (O ρ).valuation (algebraMap A K (algebraMap ↥W A w₂)) → w₂ ∣ w₁ := by
      intro w₁ w₂ h1 h2 hle
      apply hVII w₁ w₂ h1 h2
      rw [← hmemle, Valuation.map_div]
      exact (div_le_one₀ (zero_lt_iff.mpr (hvne w₂ h2))).mpr hle
    have hveq : ∀ x y : K, x ≠ 0 → y ≠ 0 → x / y ∈ O ρ → y / x ∈ O ρ →
