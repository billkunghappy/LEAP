  have hfL : algebraMap P L f = algebraMap K L (p : K) / algebraMap K L (q : K) := by
    rw [IsScalarTower.algebraMap_apply P K L, hf, map_div₀]
  have hFβ : Polynomial.aeval β FP = 0 := by
    rw [hFPdef]
    simp only [map_sub, map_add, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
    rw [hfL]
    have e2 : β ^ ℓ - β = algebraMap K L (p : K) / algebraMap K L (q : K) := by
