  have hD3b : ∀ (F P₁ P₀ X Y U B C₀ : K) (k d : ℕ), U ≠ 0 → P₁ * U ^ (k + d) = X →
      P₀ * U ^ k = Y → F * X = B ^ d * C₀ * Y → P₁ * F = C₀ * (B / U) ^ d * P₀ := by
    intro F P₁ P₀ X Y U B C₀ k d hU hX hY heq
