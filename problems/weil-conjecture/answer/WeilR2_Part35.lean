  obtain ⟨T, iT, ψ, j₀, hψet, hj₀inj, hj₀W, hj₀gen, hj₀R, hj₀B⟩ :=
    wcLlsKPas_model_ring Ω W ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) L Q
      ((algebraMap A _).comp (algebraMap ↥W A)) P ψP (algebraMap A _ h * q)
