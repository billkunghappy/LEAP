theorem wcLlsASi_ann_pole_sep : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) → ((ℓ : ℕ) : K) = 0 → Module.finrank K L = ℓ →
    ∀ (α : L) (f : K), α ∉ Set.range (algebraMap K L) → α ^ ℓ - α = algebraMap K L f →
    ∀ (h : K) (μ : ↥W) (n : ℕ) (d d' : A), μ ≠ 0 → 0 < n → ¬ ℓ ∣ n → d ∉ 𝔭 → d' ∉ 𝔭 →
    algebraMap A K u ^ n * algebraMap A K (algebraMap ↥W A μ) ^ ℓ * (f - h ^ ℓ + h) *
      algebraMap A K d = algebraMap A K d' →
    wcLlsAnnSep W A K L u g :=
by
  intro Ω _ _ W hdim hWt ℓ hℓ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g hPD hK hfin α f hα hf h μ n
    d d' hμ hn hℓn hd hd' hEQ
  classical
  obtain ⟨k, rfl⟩ : ∃ k, ℓ = k + 1 := ⟨ℓ - 1, by have := hℓ.pos; omega⟩
  have hPDc := hPD
  obtain ⟨-, hNZ, -, -, -, hg𝔪, hg0, huv, -⟩ := hPDc
  haveI := hNZ
  haveI hfact : Fact (k + 1).Prime := ⟨hℓ⟩

  have hinj : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
    intro x hx h0
    have h1 : algebraMap ↥W A x = 0 := (IsFractionRing.injective A K) (by rw [h0, map_zero])
    rw [Algebra.algebraMap_eq_smul_one, smul_eq_zero] at h1
    rcases h1 with h1 | h1
    · exact hx h1
    · exact one_ne_zero h1
  have htow : ∀ a : A, algebraMap A L a = algebraMap K L (algebraMap A K a) :=
    IsScalarTower.algebraMap_apply A K L
  have hu0 : algebraMap A K u ≠ 0 := by
    intro h0; apply hinj g hg0; rw [← huv, map_mul, h0, zero_mul]
  haveI hchar : CharP L (k + 1) := (CharP.charP_iff_prime_eq_zero hℓ).mpr (by
    rw [← map_natCast (algebraMap K L) (k + 1), hK, map_zero])

  have hc0 : algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) ≠ 0 :=
    (map_ne_zero _).mpr (hinj μ hμ)
  have hαH : α - algebraMap K L h ≠ 0 := fun h0 => hα ⟨h, (sub_eq_zero.mp h0).symm⟩
  have hw0 : algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h) ≠ 0 :=
    mul_ne_zero hc0 hαH
  have hsub : (α - algebraMap K L h) ^ (k + 1) = α ^ (k + 1) - algebraMap K L h ^ (k + 1) :=
    sub_pow_char α (algebraMap K L h)
  have hU0 : algebraMap K L (algebraMap A K u) ≠ 0 := (map_ne_zero _).mpr hu0
  have hEL : algebraMap K L (algebraMap A K u) ^ n * algebraMap K L (algebraMap A K d) *
      ((algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h)) ^ (k + 1) -
        algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) ^ k *
          (algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h))) =
      algebraMap K L (algebraMap A K d') := by
    have h1 := congrArg (algebraMap K L) hEQ
    simp only [map_mul, map_pow, map_sub, map_add] at h1
    rw [← hf] at h1
    rw [mul_pow, hsub]
    linear_combination h1

  have pole : ∀ (w U lam D D' : L), w ≠ 0 → U ≠ 0 →
      U ^ n * D * (w ^ (k + 1) - lam * w) = D' →
      ∃ (a m : ℕ) (x ρ : L), 1 ≤ a ∧ a < k + 1 ∧ a * n = 1 + m * (k + 1) ∧ ρ ≠ 0 ∧
        x ^ (k + 1) = U * ρ ^ a ∧
        D' * ρ ^ (m * k + 1) - D * ρ ^ (m * k) + D * lam * x ^ (n * k) = 0 ∧
        x * U ^ m * w ^ a = 1 := by
    intro w U lam D D' hw hU hE
    have hn0 : (n : ZMod (k + 1)) ≠ 0 := by
      intro h0
      apply hℓn
      have h1 : ((n : ℕ) : ZMod (k + 1)) = ((0 : ℕ) : ZMod (k + 1)) := by rw [h0, Nat.cast_zero]
      rw [ZMod.natCast_eq_natCast_iff'] at h1
      exact Nat.dvd_of_mod_eq_zero (by simpa using h1)
    set a : ℕ := ((n : ZMod (k + 1))⁻¹).val with ha
    have haℓ : a < k + 1 := ZMod.val_lt _
    have hmod : (a * n) % (k + 1) = 1 := by
      have h1 : ((a * n : ℕ) : ZMod (k + 1)) = ((1 : ℕ) : ZMod (k + 1)) := by
        rw [Nat.cast_mul, ha, ZMod.natCast_zmod_val, inv_mul_cancel₀ hn0, Nat.cast_one]
      rw [ZMod.natCast_eq_natCast_iff'] at h1
      rw [h1]
      exact Nat.mod_eq_of_lt (by have := hℓ.two_le; omega)
    have ha1 : 1 ≤ a := by
      rcases Nat.eq_zero_or_pos a with h | h
      · rw [h, zero_mul, Nat.zero_mod] at hmod; exact absurd hmod (by norm_num)
      · exact h
    set m : ℕ := (a * n) / (k + 1) with hm
    have hBez : a * n = 1 + m * (k + 1) := by
      have := Nat.div_add_mod (a * n) (k + 1)
      rw [hmod] at this
      rw [hm]; linarith [this, mul_comm ((a * n) / (k + 1)) (k + 1)]
    set z : L := w⁻¹ with hz
    have hz0 : z ≠ 0 := inv_ne_zero hw
    have hwz : w * z = 1 := mul_inv_cancel₀ hw
    set ρ : L := z ^ (k + 1) / U ^ n with hρ
    have hρ0 : ρ ≠ 0 := div_ne_zero (pow_ne_zero _ hz0) (pow_ne_zero _ hU)
    have hzρ : z ^ (k + 1) = U ^ n * ρ := by
      rw [hρ, mul_div_cancel₀ _ (pow_ne_zero _ hU)]
    set x : L := z ^ a / U ^ m with hx
    have hxl : x ^ (k + 1) = U * ρ ^ a := by
      calc x ^ (k + 1) = (z ^ (k + 1)) ^ a / U ^ (m * (k + 1)) := by
              rw [hx, div_pow, ← pow_mul, ← pow_mul, ← pow_mul, mul_comm a (k + 1)]
        _ = (U ^ n * ρ) ^ a / U ^ (m * (k + 1)) := by rw [hzρ]
        _ = U ^ (a * n) * ρ ^ a / U ^ (m * (k + 1)) := by ring
        _ = U * ρ ^ a := by
              rw [hBez, pow_add, pow_one]
              field_simp
    have hxn : x ^ n = z * ρ ^ m := by
      calc x ^ n = z ^ (a * n) / U ^ (m * n) := by
              rw [hx, div_pow, ← pow_mul, ← pow_mul]
        _ = z * (z ^ (k + 1)) ^ m / U ^ (m * n) := by
              rw [hBez, pow_add, pow_one, ← pow_mul, mul_comm m (k + 1)]
        _ = z * (U ^ n * ρ) ^ m / U ^ (m * n) := by rw [hzρ]
        _ = z * ρ ^ m := by
              rw [mul_pow, ← pow_mul, mul_comm n m]
              field_simp
    have hw1 : w ^ (k + 1) * z ^ (k + 1) = 1 := by rw [← mul_pow, hwz, one_pow]
    have hw2 : w * z ^ (k + 1) = z ^ k := by rw [pow_succ', ← mul_assoc, hwz, one_mul]
    have key : D' * ρ = D * (1 - lam * z ^ k) := by
      apply mul_left_cancel₀ (pow_ne_zero n hU)
      linear_combination (-D') * hzρ - z ^ (k + 1) * hE + U ^ n * D * hw1 -
        U ^ n * D * lam * hw2
    refine ⟨a, m, x, ρ, ha1, haℓ, hBez, hρ0, hxl, ?_, ?_⟩
    · have hxnk : x ^ (n * k) = z ^ k * ρ ^ (m * k) := by
        rw [pow_mul, hxn, mul_pow, ← pow_mul]
      rw [hxnk, pow_succ]
      linear_combination ρ ^ (m * k) * key
    · rw [hx, div_mul_cancel₀ _ (pow_ne_zero m hU), hz, ← mul_pow, inv_mul_cancel₀ hw, one_pow]

  obtain ⟨a, m, x, ρ, ha1, haℓ, hBez, hρ0, hxl, hrel, hxuw⟩ := pole _ _ _ _ _ hw0 hU0 hEL

  have hwK : algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h) ∉
      Set.range (algebraMap K L) := by
    rintro ⟨k0, hk0⟩
    apply hα
    refine ⟨h + k0 / algebraMap A K (algebraMap ↥W A μ), ?_⟩
    rw [map_add, map_div₀, hk0]
    field_simp
    ring
  have hxK : x ∉ Set.range (algebraMap K L) := by
    rintro ⟨k0, hk0⟩
    have h1 : x * algebraMap K L (algebraMap A K u ^ m) *
        (algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h)) ^ a = 1 := by
      rw [map_pow]; exact hxuw
    rw [← hk0] at h1
    have hwa : (algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h)) ^ a =
        algebraMap K L ((k0 * algebraMap A K u ^ m)⁻¹) := by
      rw [map_inv₀, map_mul]; exact eq_inv_of_mul_eq_one_right h1
    have haev : Polynomial.aeval
        (algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h))
        (Polynomial.X ^ a - Polynomial.C ((k0 * algebraMap A K u ^ m)⁻¹)) = 0 := by
      rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, hwa, sub_self]
    have hint : IsIntegral K
        (algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h)) :=
      Algebra.IsIntegral.isIntegral _
    have hdeg : (minpoly K
        (algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h))).natDegree
          ≤ a :=
      (Polynomial.natDegree_le_of_dvd (minpoly.dvd K _ haev)
        (Polynomial.X_pow_sub_C_ne_zero (by omega) _)).trans Polynomial.natDegree_X_pow_sub_C.le
    have hfr := IntermediateField.adjoin.finrank hint
    have hdvd : Module.finrank K (IntermediateField.adjoin K
        {algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h)}) ∣ k + 1 :=
      ⟨_, ((Module.finrank_mul_finrank K (IntermediateField.adjoin K
        {algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h)}) L).trans
          hfin).symm⟩
    rcases hℓ.eq_one_or_self_of_dvd _ hdvd with h2 | h2
    · apply hwK
      have hb := IntermediateField.finrank_eq_one_iff.mp h2
      have hmem := IntermediateField.mem_adjoin_simple_self K
        (algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h))
      rw [hb] at hmem
      exact IntermediateField.mem_bot.mp hmem
    · omega

  have hjinj : Function.Injective ((algebraMap A K).comp (algebraMap ↥W A)) := by
    intro x₁ x₂ hx12
    by_contra hne
    apply hinj (x₁ - x₂) (sub_ne_zero.mpr hne)
    simp only [RingHom.comp_apply] at hx12
    rw [map_sub, map_sub, hx12, sub_self]
  have htr : ∀ p : Polynomial ↥W, p ≠ 0 →
      Polynomial.eval₂ ((algebraMap A L).comp (algebraMap ↥W A)) x p ≠ 0 := by
    intro p hp
    set G : Ω →+* L := (algebraMap K L).comp (IsFractionRing.lift (K := Ω) hjinj) with hG
    have hGW : (algebraMap A L).comp (algebraMap ↥W A) = G.comp (algebraMap ↥W Ω) := by
      ext r
      rw [RingHom.comp_apply, RingHom.comp_apply, hG, RingHom.comp_apply,
        IsFractionRing.lift_algebraMap, RingHom.comp_apply, htow]
    rw [hGW, ← Polynomial.eval₂_map]
    have hq0 : p.map (algebraMap ↥W Ω) ≠ 0 :=
      (Polynomial.map_ne_zero_iff (IsFractionRing.injective ↥W Ω)).mpr hp
    have hqs := Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C
      (IsAlgClosed.card_roots_eq_natDegree (p := p.map (algebraMap ↥W Ω)))
    rw [← hqs, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_multiset_prod,
      Multiset.map_map]
    refine mul_ne_zero ?_ ?_
    · exact (map_ne_zero_iff G G.injective).mpr (Polynomial.leadingCoeff_ne_zero.mpr hq0)
    · intro h0
      rw [Multiset.prod_eq_zero_iff, Multiset.mem_map] at h0
      obtain ⟨r, -, hr⟩ := h0
      simp only [Function.comp_apply, Polynomial.eval₂_sub, Polynomial.eval₂_X,
        Polynomial.eval₂_C] at hr
      apply hxK
      exact ⟨IsFractionRing.lift (K := Ω) hjinj r, (sub_eq_zero.mp hr).symm⟩

  have hxl' : x ^ (k + 1) = algebraMap A L u * ρ ^ a := by rw [htow]; exact hxl
  have hG' : algebraMap A L d' * ρ ^ (m * (k + 1 - 1) + 1) -
      algebraMap A L d * ρ ^ (m * (k + 1 - 1)) +
      algebraMap A L d * algebraMap A L (algebraMap ↥W A (μ ^ k)) * x ^ (n * (k + 1 - 1)) = 0 := by
    rw [Nat.add_sub_cancel]
    simp only [htow, map_pow]
    linear_combination hrel
  apply wcpa_dj_llsm_br_ann_node_sep Ω W hdim hWt A K L 𝔭 u v g hPD
  intro y hy hyc hy'
  exact wcLlsASi_node_chart Ω W hdim hWt (k + 1) hℓ A K L 𝔭 u v g hPD hfin n a m (μ ^ k) d d'
    x ρ hn ha1 haℓ hBez hd hd' hρ0 hxl' hG' hxK htr y hy hyc hy'

theorem wcLlsAS_dse_insep_sep : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ((ℓ : ℕ) : K) = 0 → Module.finrank K L = ℓ →
    ∀ (α : L) (f : K), α ∉ Set.range (algebraMap K L) → α ^ ℓ - α = algebraMap K L f →
    ∀ c b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    algebraMap A K (t - algebraMap ↥W A c) ≠ 0 → ∀ (h s : K),
    s = algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c) →
    ∀ (μ : ↥W) (m : ℤ), μ ≠ 0 → ¬ (ℓ : ℤ) ∣ m → (0 < m → b ^ m.toNat ∣ μ ^ ℓ) →
    ∀ p q : ↥(Algebra.adjoin A {s}),
    (∃ a₀ : A, a₀ ∉ 𝔭 ∧ p - algebraMap A ↥(Algebra.adjoin A {s}) a₀ ∈
      Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c),
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) →
    (∃ a₁ : A, a₁ ∉ 𝔭 ∧ q - algebraMap A ↥(Algebra.adjoin A {s}) a₁ ∈
      Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c),
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) →
    algebraMap A K (algebraMap ↥W A μ) ^ ℓ * (f - h ^ ℓ + h) * (q : K) =
      algebraMap A K (t - algebraMap ↥W A c) ^ m * (p : K) →
    wcLlsDiscSep W A K L t c b :=
by
  intro Ω _ _ W hdim hWtop ℓ hℓ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD hK hfin α f hα hf c b hc hb
    hb0 hu h s hs μ m hμ0 hI hdom p q hp hq hEQ
  classical

  have hinj : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
    intro x hx h0
    have h1 : algebraMap ↥W A x = 0 :=
      (IsFractionRing.injective A K) (h0.trans (map_zero _).symm)
    have h2 : x • (1 : A) = 0 := by rw [Algebra.smul_def, mul_one]; exact h1
    haveI := hPD.2.1
    exact hx ((smul_eq_zero.mp h2).resolve_right one_ne_zero)
  have rootW : ∀ N : ℕ, 0 < N → ∀ z : ↥W, ∃ r : ↥W, r ^ N = z := by
    intro N hN z
    obtain ⟨r, hr⟩ := IsAlgClosed.exists_pow_nat_eq (z : Ω) hN
    by_cases hrW : r ∈ W
    · refine ⟨⟨r, hrW⟩, Subtype.ext ?_⟩
      first
        | simpa using hr
        | exact hr
    · exfalso
      have hr0 : r ≠ 0 := fun h0 => hrW (h0 ▸ W.zero_mem)
      have hrinv : r⁻¹ ∈ W := (W.mem_or_inv_mem r).resolve_left hrW
      obtain ⟨N', rfl⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by omega⟩
      have h1 : r = (z : Ω) * r⁻¹ ^ N' := by
        rw [← hr, inv_pow, pow_succ, mul_assoc, mul_comm r, ← mul_assoc,
          mul_inv_cancel₀ (pow_ne_zero _ hr0), one_mul]
      apply hrW
      rw [h1]
      exact mul_mem z.2 (pow_mem hrinv N')
  have hUs : algebraMap A K (t - algebraMap ↥W A c) * s = algebraMap A K (algebraMap ↥W A b) := by
    rw [hs]; field_simp
  have hs0 : s ≠ 0 := by
    rw [hs]; exact div_ne_zero (hinj b hb0) hu

  obtain ⟨A', _, _, _, _, _, _, _, u', v', 𝔭', hsub, hu', hv', hPD', hiff, -, -⟩ :=
    wcpa_dj_llsm_br_boundary_chart Ω W hdim hWtop A K L 𝔭 (.disc t) (t - algebraMap ↥W A c) b hPD
      (Or.inl ⟨t, c, rfl, hc, rfl⟩) hb hb0
  rw [← hs] at hsub hv'
  have hW' : ∀ w : ↥W, algebraMap A' K (algebraMap ↥W A' w) = algebraMap A K (algebraMap ↥W A w) :=
    hsub.1
  have hιinj : Function.Injective (algebraMap A' K) := IsFractionRing.injective A' K
  have hPD'c := hPD'
  obtain ⟨hFT', hNZ', hIC', hmax', hle', hb𝔪', hb0', huv', h𝔭eq', h₀, hh₀, F0, hF0C, hF0X0, hF0X1,
    hF0et⟩ := hPD'c
  have hu'𝔭 : u' ∈ 𝔭' := by
    rw [h𝔭eq']; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hv'𝔭 : v' ∈ 𝔭' := by
    rw [h𝔭eq']
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
  have hw𝔭 : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → algebraMap ↥W A' w ∈ 𝔭' := by
    intro w hw
    rw [h𝔭eq']; exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)

  have hrng : ∀ r : ↥(Algebra.adjoin A {s}), ∃ y : A', algebraMap A' K y = (r : K) :=
    fun r => hsub.2.1 r.2
  choose g hg using hrng
  obtain ⟨ιR, hιR⟩ : ∃ ιR : ↥(Algebra.adjoin A {s}) →+* A',
      ∀ r, algebraMap A' K (ιR r) = (r : K) :=
    ⟨{ toFun := g
       map_one' := hιinj (by simp [hg])
       map_mul' := fun x y => hιinj (by simp [hg])
       map_zero' := hιinj (by simp [hg])
       map_add' := fun x y => hιinj (by simp [hg]) }, hg⟩

  have hN : ∀ x ∈ (Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c),
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))), ιR x ∈ 𝔭' := by
    intro x hx
    have hle : (Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c),
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) ≤ 𝔭'.comap ιR := by
      apply sup_le
      · rw [Ideal.span_le]
        rintro y (rfl | rfl)
        · rw [SetLike.mem_coe, Ideal.mem_comap]
          have e : ιR (algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c)) = u' :=
            hιinj (by rw [hιR, hu']; try rfl)
          rw [e]; exact hu'𝔭
        · rw [SetLike.mem_coe, Ideal.mem_comap]
          have e : ιR ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ = v' :=
            hιinj (by rw [hιR, hv']; try rfl)
          rw [e]; exact hv'𝔭
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [Ideal.mem_comap, Ideal.mem_comap]
        have e : ιR (((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) w) =
            algebraMap ↥W A' w := hιinj (by rw [hιR, hW' w]; try rfl)
        rw [e]; exact hw𝔭 w hw
    exact hle hx

  have hPDc := hPD
  obtain ⟨_, _, _, hmax, _, _, h𝔭eq0, _⟩ := hPDc
  have hA𝔭 : ∀ a : A, a ∉ 𝔭 → ιR (algebraMap A ↥(Algebra.adjoin A {s}) a) ∉ 𝔭' := by
    have hJ : 𝔭 ≤ 𝔭'.comap (ιR.comp (algebraMap A ↥(Algebra.adjoin A {s}))) := by
      rw [h𝔭eq0]
      apply sup_le
      · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap,
          RingHom.comp_apply]
        apply hN
        have e : algebraMap A ↥(Algebra.adjoin A {s}) t =
            algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c) +
              ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) c := by
          rw [RingHom.comp_apply, ← map_add, sub_add_cancel]
        rw [e]
        exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
