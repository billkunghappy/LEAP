    rw [hS, add_sub_cancel_right]
  have hmem2 : wcLlsScS W A K t (c + e * b) b ∈ Algebra.adjoin A {wcLlsScS W A K t c b} := by
    rw [hS']
    exact Subalgebra.sub_mem _ (Algebra.subset_adjoin (Set.mem_singleton _))
      (Subalgebra.algebraMap_mem _ _)
  have hmem1 : wcLlsScS W A K t c b ∈ Algebra.adjoin A {wcLlsScS W A K t (c + e * b) b} := by
    rw [hS]
    exact Subalgebra.add_mem _ (Algebra.subset_adjoin (Set.mem_singleton _))
