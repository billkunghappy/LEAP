    ∀ y : Ideal ↥(integralClosure A L), y.IsPrime →
      y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → ∀ (_ : y.IsPrime),
      ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) :=
by
  intro Ω _ _ W hdim hWt ℓ hℓ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g hPD hK hfin α f₀ h hα hf₀
    c m d e hc hm hd he hdom hkey y hy hyc hy'
  classical
  obtain ⟨k, rfl⟩ : ∃ k, ℓ = k + 1 := ⟨ℓ - 1, by have := hℓ.pos; omega⟩
  have hPDc := hPD
  obtain ⟨-, hNZ, -, -, -, hg𝔪, hg0, huv, -⟩ := hPDc
  haveI := hNZ
  haveI hfact : Fact (k + 1).Prime := ⟨hℓ⟩
  have hinj : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
    intro x hx h0
    have h1 : algebraMap ↥W A x = 0 := (IsFractionRing.injective A K) (by rw [h0, map_zero])
    rw [Algebra.algebraMap_eq_smul_one, smul_eq_zero] at h1
    rcases h1 with h1 | h1
    · exact hx h1
    · exact one_ne_zero h1
  have htow : ∀ a : A, algebraMap A L a = algebraMap K L (algebraMap A K a) :=
    IsScalarTower.algebraMap_apply A K L
  have hu0 : algebraMap A K u ≠ 0 := by
    intro h0; apply hinj g hg0; rw [← huv, map_mul, h0, zero_mul]
  have hv0 : algebraMap A K v ≠ 0 := by
    intro h0; apply hinj g hg0; rw [← huv, map_mul, h0, mul_zero]
