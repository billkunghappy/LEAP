theorem wcLlsVd_ct_good_denom : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L] (t : A) (c₀ b₀ e' b'' : ↥W), algebraMap A K (algebraMap ↥W A b₀) ≠ 0 → b₀ ∣ b'' → ∀ (A' : Type u) [CommRing A'] [Algebra ↥W A'] [Algebra A' K] (u' : A'), wcLlsBrSub W A K A' (algebraMap A K (algebraMap ↥W A b'') / algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e'))) {algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e')), algebraMap A K (algebraMap ↥W A b'') / algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e'))} → algebraMap A' K u' = algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e')) → (∀ q : ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b'') / algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e'))}), q ∉ Ideal.span (((↑) : ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b'') / algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e'))}) → K) ⁻¹' ({algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e')), algebraMap A K (algebraMap ↥W A b'') / algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e'))} ∪ (fun w : ↥W => algebraMap A K (algebraMap ↥W A w)) '' (IsLocalRing.maximalIdeal ↥W : Set ↥W))) → ∀ qq : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L), (qq : L) = algebraMap K L (q : K) → ∃ g : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L), qq * g - 1 ∈ wcVdJ0 W A K L t c₀ b₀ e') → ∀ y : ↥(integralClosure ↥(wcLlsIsiCR W A' K u' b₀) L), ∃ q g x : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L), (q : L) * (y : L) = (x : L) ∧ q * g - 1 ∈ wcVdJ0 W A K L t c₀ b₀ e' :=
by
  intro Ω _ W A _ _ K _ _ L _ _ t c₀ b₀ e' b'' hb0K hdiv A' _ _ _ u' hBr hu' hU y
  classical
  obtain ⟨hBr1, -, hBr3⟩ := hBr
