  have hdbl : ∀ (x : ↥W) (n : ℕ), μ ∣ x ^ n → μ ∣ x ^ 2 ^ n := fun x n h =>
    dvd_trans h (pow_dvd_pow x Nat.lt_two_pow_self.le)
  rcases le_or_gt 0 j with hj | hj
  · obtain ⟨m, rfl⟩ := Int.eq_ofNat_of_zero_le hj
    obtain ⟨n, hn⟩ := arch lam μ hlm hμ
    obtain ⟨w, hw⟩ := hdbl lam n hn
    refine ⟨n, fun c₁ c₂ _ _ _ _ _ _ _ _ _ => ?_⟩
    obtain ⟨N, hN⟩ : ∃ N : ℕ, 2 ^ n = N := ⟨_, rfl⟩
    rw [hN] at hw
    rw [hN]
    refine ⟨algebraMap A (wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A w * u ^ (N * m)), ?_⟩
    rw [Subalgebra.coe_algebraMap, hw]
    have e : ((N : ℕ) : ℤ) * (m : ℤ) = ((N * m : ℕ) : ℤ) := by push_cast; ring
    rw [e, zpow_natCast]
    simp only [map_mul, map_pow]
    ring
  · obtain ⟨J, hJ⟩ : ∃ J : ℕ, j = -((J + 1 : ℕ) : ℤ) := ⟨(-j).toNat - 1, by omega⟩
    have hJt : (-j).toNat = J + 1 := by omega
    obtain ⟨lam', hlam'⟩ : g ^ (J + 1) ∣ lam := by
      have := hcone hj
      rwa [hJt] at this
    obtain ⟨q₀, hq₀⟩ := hτg
    have hq₀m : q₀ ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [hmunit]
      intro hqu
      exact hgτ ⟨↑hqu.unit⁻¹, by rw [hq₀, mul_assoc, IsUnit.mul_val_inv, mul_one]⟩
    obtain ⟨n, hn⟩ := arch (lam' * q₀) μ (Ideal.mul_mem_left _ _ hq₀m) hμ
    obtain ⟨w₀, hw₀⟩ := hdbl _ n hn
    refine ⟨n, fun c₁ c₂ _ _ _ _ _ _ _ _ hc₂τ => ?_⟩
    obtain ⟨κ, hκ⟩ := hc₂τ
    obtain ⟨N, hN⟩ : ∃ N : ℕ, 2 ^ n = N := ⟨_, rfl⟩
    rw [hN] at hw₀
    rw [hN]
    have hW' : lam ^ N = μ * (w₀ * q₀ ^ (N * J) * κ ^ (N * (J + 1))) * c₂ ^ (N * (J + 1)) := by
      rw [hlam', hq₀, hκ]
      linear_combination (q₀ ^ (N * J) * κ ^ (N * (J + 1)) * c₂ ^ (N * (J + 1))) * hw₀
    have hs₂ : wcLlsInnerS₂ W A K u c₂ ∈ wcLlsInnerCR W A K u c₁ c₂ :=
      Algebra.subset_adjoin (by simp)
    refine ⟨algebraMap A (wcLlsInnerCR W A K u c₁ c₂)
        (algebraMap ↥W A (w₀ * q₀ ^ (N * J) * κ ^ (N * (J + 1)))) *
      (⟨_, hs₂⟩ : ↥(wcLlsInnerCR W A K u c₁ c₂)) ^ (N * (J + 1)), ?_⟩
    show _ = _ * (algebraMap A K (algebraMap ↥W A (w₀ * q₀ ^ (N * J) * κ ^ (N * (J + 1)))) *
      (algebraMap A K (algebraMap ↥W A c₂) / algebraMap A K u) ^ (N * (J + 1)))
    have e : ((N : ℕ) : ℤ) * j = -((N * (J + 1) : ℕ) : ℤ) := by rw [hJ]; push_cast; ring
    rw [e, zpow_neg, zpow_natCast, hW', div_pow]
