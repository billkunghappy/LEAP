    fun a => rfl
  have hRL : ∀ r : ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}),
      algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) L r =
        algebraMap K L (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) K r) :=
    fun r => rfl
  have hRne : ∀ a : A, a ∉ 𝔭 → algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) a ≠ 0 := by
    intro a ha h0
    apply ha
    have h1 : algebraMap A K a = 0 := by rw [← hRK, h0, map_zero]
    have h2 := (map_eq_zero_iff (algebraMap A K) (IsFractionRing.injective A K)).mp h1
    rw [h2]
