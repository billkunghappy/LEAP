    intro S B _ _ _ hSB q hq b₁ b₂
    obtain ⟨r₀, f, val, hsurj, hker, hJ⟩ := wc_sh_standard_presentation_fin S B hSB
    obtain ⟨F, e₁, e₂, H⟩ := wcpa_dj_llsm_kpwicnec_present (MvPolynomial (Fin 2) ↥W) S B q hq
