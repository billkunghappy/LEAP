        (wcVdR0 W A K t c₀ b₀ e' : Set K) →
      (∀ a' : A', ∃ k, P k ∧ k * algebraMap A' K a' ∈ wcVdR0 W A K t c₀ b₀ e') →
      ∀ r ∈ wcLlsIsiCR W A' K u' b₀, ∃ k, P k ∧ k * r ∈ wcVdR0 W A K t c₀ b₀ e' := by
    intro P h1 hmul hmem hs hA r hr
