  obtain ⟨Φ, hΦψ, hΦX, hΦZ, hΦr⟩ := hUP (Localization.AtPrime y) φ xL zL ρL ρL' hcomap hxm hzm
    (hκinj (by rw [map_mul, hκx, hκz, hκφ]; exact hxz))
    (hκinj (by rw [map_mul, hκρ, hκρ', map_one]; exact hρρ'))
