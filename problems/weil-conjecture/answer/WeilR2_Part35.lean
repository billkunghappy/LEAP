    have hT4 : ∀ y : ↥(Algebra.adjoin A {s}), y ∉ I → ∃ (y₁ : ↥(Algebra.adjoin A {s})) (a₀ : A),
        a₀ ∉ 𝔭 ∧ (y : K) = s * (y₁ : K) + algebraMap A K a₀ ∧
          y = ⟨s, hsR⟩ * y₁ + algebraMap A ↥(Algebra.adjoin A {s}) a₀ := by
      intro y hy
      obtain ⟨y₁, a₀, e1, e2⟩ := hdec y
      refine ⟨y₁, a₀, fun ha => hy ?_, e1, e2⟩
      rw [e2]; exact I.add_mem (I.mul_mem_right _ hsI) (hφ𝔭 a₀ ha)
    have hν1 : ∀ y : ↥(Algebra.adjoin A {s}), y ∉ I → (O ρ).valuation (y : K) = 1 := by
      intro y hy
      obtain ⟨y₁, a₀, ha₀, e1, -⟩ := hT4 y hy
      rw [e1, Valuation.map_add_eq_of_lt_right, hvA a₀ ha₀]
      rw [Valuation.map_mul, hvA a₀ ha₀, hvs]
      exact lt_of_le_of_lt (mul_le_of_le_one_right (zero_le) (hT3 _ y₁.2)) hr1
    have hpart1 : ∀ x : A', algebraMap A' K x ∈ O ρ := by
      intro x
      obtain ⟨p, q, hq, hx⟩ := hBr3 _ ⟨x, rfl⟩
      rw [← hmemle]
      have h := congrArg (O ρ).valuation hx
      rw [Valuation.map_mul, hν1 q hq, mul_one] at h
      rw [h]; exact hT3 _ p.2

    let J : Ideal ↥(Algebra.adjoin A {s}) :=
      { carrier := {y | ∃ b ∈ 𝔭', algebraMap A' K b = (y : K)}
        add_mem' := by
          rintro x y ⟨b1, hb1, e1⟩ ⟨b2, hb2, e2⟩
          exact ⟨b1 + b2, 𝔭'.add_mem hb1 hb2, by rw [map_add, e1, e2]; rfl⟩
        zero_mem' := ⟨0, 𝔭'.zero_mem, by rw [map_zero]; rfl⟩
        smul_mem' := by
          rintro r y ⟨b, hb, e⟩
          obtain ⟨r', hr'⟩ := hBr.2.1 r.2
          exact ⟨r' * b, 𝔭'.mul_mem_left _ hb, by rw [map_mul, hr', e]; rfl⟩ }
    have h𝔭'eq := hPD'.2.2.2.2.2.2.2.2.1
    have hu'𝔭 : u' ∈ 𝔭' := by
      rw [h𝔭'eq]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
    have hv'𝔭 : v' ∈ 𝔭' := by
      rw [h𝔭'eq]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    have hw𝔭 : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, algebraMap ↥W A' w ∈ 𝔭' :=
      fun w hw => hPD'.2.2.2.2.1 (Ideal.mem_map_of_mem _ hw)
    have hIJ : I ≤ J := by
      refine Ideal.span_le.mpr ?_
      rintro y ((h | h) | ⟨w, hw, h⟩)
      · exact ⟨u', hu'𝔭, hu'.trans h.symm⟩
      · exact ⟨v', hv'𝔭, hv'.trans (Set.mem_singleton_iff.mp h).symm⟩
      · exact ⟨algebraMap ↥W A' w, hw𝔭 w hw, (hBr.1 w).trans h⟩
    have h1p' : (1 : A') ∉ 𝔭' := (Ideal.ne_top_iff_one 𝔭').mp hPD'.2.2.2.1.ne_top
    have h1J : (1 : ↥(Algebra.adjoin A {s})) ∉ J := by
      rintro ⟨b, hb, e⟩
      apply h1p'
      have : b = 1 := IsFractionRing.injective A' K (by rw [e, map_one]; rfl)
      rwa [this] at hb
    have hnJ : ∀ y : ↥(Algebra.adjoin A {s}), y ∉ I → y ∉ J := by
      intro y hy hyJ
      obtain ⟨y₁, a₀, ha₀, -, e2⟩ := hT4 y hy
      have hJa : algebraMap A ↥(Algebra.adjoin A {s}) a₀ ∈ J := by
        have : algebraMap A ↥(Algebra.adjoin A {s}) a₀ = y - ⟨s, hsR⟩ * y₁ := by rw [e2]; ring
        rw [this]; exact Ideal.sub_mem J hyJ (hIJ (I.mul_mem_right _ hsI))
      obtain ⟨r', i, hi, hri⟩ := hPD.2.2.2.1.exists_inv ha₀
      apply h1J
      have : (1 : ↥(Algebra.adjoin A {s})) =
          algebraMap A _ r' * algebraMap A _ a₀ + algebraMap A _ i := by
        rw [← map_mul, ← map_add, hri, map_one]
      rw [this]; exact J.add_mem (Ideal.mul_mem_left J _ hJa) (hIJ (hφ𝔭 i hi))
    have hpart2 : ∀ ε : A', ε ∉ 𝔭' → (algebraMap A' K ε)⁻¹ ∈ O ρ := by
      intro ε hε
      obtain ⟨p, q, hq, hx⟩ := hBr3 _ ⟨ε, rfl⟩
      have hpI : p ∉ I := by
        intro hpI
        obtain ⟨b, hb, e⟩ := hIJ hpI
        obtain ⟨q', hq'⟩ := hBr.2.1 q.2
        have : ε * q' = b := IsFractionRing.injective A' K (by rw [map_mul, hq', hx, ← e])
        rw [← this] at hb
        rcases hPD'.2.2.2.1.isPrime.mem_or_mem hb with h | h
        · exact hε h
        · exact hnJ q hq ⟨q', h, hq'⟩
      have h := congrArg (O ρ).valuation hx
      rw [Valuation.map_mul, hν1 q hq, hν1 p hpI, mul_one] at h
      rw [← hmemle, Valuation.map_inv, h, inv_one]
    exact ⟨hpart1, hpart2⟩
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD hdeg α f₀ hα1 hf₀
    c hc O hO a ha ha0
  classical

  have hΩ : ((ℓ : ℕ) : Ω) = 0 := by
    rw [← hchar]
    exact ringChar.Nat.cast_ringChar
  have hWl : ((ℓ : ℕ) : ↥W) = 0 := by
    apply Subtype.ext
    simpa using hΩ
  have hK : ((ℓ : ℕ) : K) = 0 := by
    have e : ((ℓ : ℕ) : K) = algebraMap A K (algebraMap ↥W A ((ℓ : ℕ) : ↥W)) := by
      rw [map_natCast, map_natCast]
    rw [e, hWl, map_zero, map_zero]
  have hL : ((ℓ : ℕ) : L) = 0 := by
    rw [← map_natCast (algebraMap K L), hK, map_zero]
  have : Fact ℓ.Prime := ⟨hℓ⟩
  have : CharP L ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hL

  have hroot : ∀ g : ↥W, g ∈ IsLocalRing.maximalIdeal ↥W → g ≠ 0 → ∀ N : ℕ,
      ∃ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W ∧ x ≠ 0 ∧ x ^ (N + 1) = g := by
    intro g hgm hg0 N
    obtain ⟨y, hy⟩ := IsAlgClosed.exists_pow_nat_eq (g : Ω) (Nat.succ_pos N)
    have hy0 : y ≠ 0 := by
      rintro rfl
      apply hg0
      apply Subtype.ext
      rw [← hy]
      simp
    have hyW : y ∈ W := by
      rcases W.mem_or_inv_mem y with h | h
      · exact h
      · have e : y = (g : Ω) * (y⁻¹) ^ N := by
          rw [← hy, inv_pow, pow_succ]
          field_simp
        rw [e]
        exact mul_mem g.2 (pow_mem h N)
    have hxg : (⟨y, hyW⟩ : ↥W) ^ (N + 1) = g := by
      apply Subtype.ext
      simp [hy]
    refine ⟨⟨y, hyW⟩, ?_, ?_, hxg⟩
    · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have := (IsLocalRing.mem_maximalIdeal _).mp hgm
      rw [mem_nonunits_iff] at this
      apply this
      rw [← hxg]
      exact hu.pow _
    · intro h0
      apply hy0
      have := congrArg Subtype.val h0
      simpa using this

  have hcommon : ∀ S : List ↥W, (∀ s ∈ S, s ∈ IsLocalRing.maximalIdeal ↥W) →
      ∃ g : ↥W, g ∈ IsLocalRing.maximalIdeal ↥W ∧ g ≠ 0 ∧ ∀ s ∈ S, g ∣ s := by
    intro S
    induction S with
    | nil => intro _; exact ⟨a, ha, ha0, by simp⟩
    | cons s S ih =>
      intro hS
      obtain ⟨g, hgm, hg0, hgS⟩ := ih (fun x hx => hS x (List.mem_cons_of_mem _ hx))
      by_cases hs0 : s = 0
      · refine ⟨g, hgm, hg0, ?_⟩
        intro x hx
        rcases List.mem_cons.mp hx with h | hx
        · rw [h, hs0]; exact dvd_zero _
        · exact hgS x hx
      · rcases ValuationRing.dvd_total g s with hgs | hsg
        · refine ⟨g, hgm, hg0, ?_⟩
          intro x hx
          rcases List.mem_cons.mp hx with h | hx
          · rw [h]; exact hgs
          · exact hgS x hx
        · refine ⟨s, hS s (by simp), hs0, ?_⟩
          intro x hx
          rcases List.mem_cons.mp hx with h | hx
          · rw [h]
          · exact hsg.trans (hgS x hx)

  have hexp : ∀ (a b σ : ↥W) (p q : ℕ), a ≠ 0 → σ ≠ 0 → ¬ IsUnit σ →
      a * σ ^ p ∣ b * σ ^ q → b * σ ^ q ∣ a * σ ^ p →
      a * σ ^ (2 * p) ∣ b * σ ^ (2 * q) → b * σ ^ (2 * q) ∣ a * σ ^ (2 * p) →
      p = q ∧ a ∣ b := by
    intro a b σ p q ha hσ hnu h1a h1b h2a h2b
    have h1 := associated_of_dvd_dvd h1a h1b
    have h2 := associated_of_dvd_dvd h2a h2b
    rw [two_mul, two_mul, pow_add, pow_add, ← mul_assoc, ← mul_assoc] at h2
    have h3 : Associated (σ ^ p) (σ ^ q) :=
      h2.of_mul_left h1 (mul_ne_zero ha (pow_ne_zero _ hσ))
    have hpq : p = q := le_antisymm ((pow_dvd_pow_iff hσ hnu).mp h3.dvd)
      ((pow_dvd_pow_iff hσ hnu).mp h3.symm.dvd)
    subst hpq
    exact ⟨rfl, (h1.of_mul_right (Associated.refl _) (pow_ne_zero _ hσ)).dvd⟩

  have hfilt1 : ∀ (σ : ↥W) (X : List ↥W), (∀ x ∈ X, σ ∣ x - c) →
      X.filter (fun x => @decide (σ ∣ x - c) (Classical.propDecidable _)) = X :=
    fun σ X h => List.filter_eq_self.mpr (fun a ha => decide_eq_true (h a ha))
  have hfilt2 : ∀ (σ : ↥W) (X : List ↥W), (∀ x ∈ X, σ ∣ x - c) →
      X.filter (fun x => @decide (¬ σ ∣ x - c) (Classical.propDecidable _)) = [] :=
    fun σ X h => List.filter_eq_nil_iff.mpr (fun a ha hd => (by simpa using hd : ¬ σ ∣ a - c) (h a ha))
  have hPnear : ∀ (σ : ↥W) (X : List ↥W), (∀ x ∈ X, σ ∣ x - c) →
      wcFrfP W c σ X = σ ^ X.length := by
    intro σ X h
    unfold wcFrfP
    rw [hfilt2 σ X h, hfilt1 σ X h]
    simp
  have hP0 : ∀ (σ : ↥W) (X : List ↥W), σ ≠ 0 → wcFrfP W c σ X ≠ 0 := by
    intro σ X hσ0
    unfold wcFrfP
    refine mul_ne_zero ?_ (pow_ne_zero _ hσ0)
    intro h0
    simp only [List.prod_eq_zero_iff, List.mem_map, List.mem_filter] at h0
    obtain ⟨x, ⟨_, hd⟩, hx0⟩ := h0
    have hna : ¬ σ ∣ x - c := by simpa using hd
    exact hna (by rw [hx0]; exact dvd_zero σ)
  have hcomb : ∀ {M : Type u} [CommMonoid M] (a2 p2 l1 rk f rn l2 a1 p1 : M),
      f * rn * l2 = l1 * rk → a2 * p2 * f = a1 * p1 → a2 * p2 * l1 * rk = a1 * p1 * l2 * rn := by
    intro M _ a2 p2 l1 rk f rn l2 a1 p1 h1 h2
    rw [mul_assoc (a2 * p2), ← h1, ← h2]; ac_rfl
  have hF0a : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
    intro x hx h0
    have hd := (hO a ha ha0).2.1 1 x one_ne_zero hx (by rw [h0, div_zero]; exact (O a).zero_mem)
    have hu : IsUnit x := isUnit_of_dvd_one hd
    exact ((hu.map (algebraMap ↥W A)).map (algebraMap A K)).ne_zero h0
  have h1p : (1 : A) ∉ 𝔭 := (Ideal.ne_top_iff_one 𝔭).mp hPD.2.2.2.1.ne_top

  obtain ⟨A', _, _, _, _, _, _, _, u', v', 𝔭', hBr, hu', hv', hPD', -, -, -⟩ :=
    wcpa_dj_llsm_br_boundary_chart Ω W hW hWt A K L 𝔭 (.disc t) (t - algebraMap ↥W A c) a hPD
      (Or.inl ⟨t, c, rfl, hc, rfl⟩) ha ha0
  have hBr1 : ∀ x : ↥W, algebraMap A' K (algebraMap ↥W A' x) = algebraMap A K (algebraMap ↥W A x) :=
    hBr.1
  have hz : algebraMap A K (t - algebraMap ↥W A c) ≠ 0 := by
    intro h0
    have huv : u' * v' = algebraMap ↥W A' a := hPD'.2.2.2.2.2.2.2.1
    have e := congrArg (algebraMap A' K) huv
    rw [map_mul, hu', h0, zero_mul, hBr1 a] at e
    exact hF0a a ha0 e.symm

  have hswap : wcLlsPD W A' 𝔭' (.ann v' u' a) := by
    unfold wcLlsPD at hPD' ⊢
    obtain ⟨h1, h2, h3, h4, h5, hg, hg0, huv, h𝔭, hh, hhp, f, hfC, hfX0, hfX1, hfet⟩ := hPD'
    refine ⟨h1, h2, h3, h4, h5, hg, hg0, by rw [mul_comm]; exact huv,
      by rw [Set.pair_comm]; exact h𝔭, hh, hhp, ?_⟩
    let e : MvPolynomial (Fin 2) ↥W ≃+* MvPolynomial (Fin 2) ↥W :=
      (MvPolynomial.renameEquiv ↥W (Equiv.swap (0 : Fin 2) 1)).toRingEquiv
    have he : ∀ p, e p = MvPolynomial.rename (Equiv.swap (0 : Fin 2) 1) p := fun p => rfl
    have hep : e (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) =
        MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a := by
      rw [he, map_sub, map_mul, MvPolynomial.rename_X, MvPolynomial.rename_X,
        MvPolynomial.rename_C, Equiv.swap_apply_left, Equiv.swap_apply_right, mul_comm]
    have hI : Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a} =
        Ideal.map e (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          (MvPolynomial.C a : MvPolynomial (Fin 2) ↥W)}) := by
      rw [Ideal.map_span, Set.image_singleton, hep]
    let τ : (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) ≃+*
        (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) :=
      Ideal.quotientEquiv _ _ e hI
    have hτ : ∀ p, τ (Ideal.Quotient.mk _ p) = Ideal.Quotient.mk _ (e p) :=
      fun p => Ideal.quotientEquiv_mk _ _ e hI p
    have hτet : RingHom.Etale (R := MvPolynomial (Fin 2) ↥W ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})
        (S := Localization.Away hh) (f.comp τ.toRingHom) := by
      have hRI := RingHom.Etale.respectsIso
      have key := hRI.2 (R := MvPolynomial (Fin 2) ↥W ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})
        (S := MvPolynomial (Fin 2) ↥W ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})
        (T := Localization.Away hh) f τ
      first
        | exact key hfet
        | exact key (by convert hfet using 0)
        | (apply key; convert hfet using 2)
    refine ⟨f.comp τ.toRingHom, ?_, ?_, ?_, hτet⟩
    · rw [← hfC]
      ext r
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]
      rw [hτ, he, MvPolynomial.rename_C]
    · simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]
      rw [hτ, he, MvPolynomial.rename_X, Equiv.swap_apply_left, hfX1]
    · simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]
      rw [hτ, he, MvPolynomial.rename_X, Equiv.swap_apply_right, hfX0]

  obtain ⟨h, lam₁, lam₂, w, n, k, ε₀, ε₁, r₀, r₁, g₀, g₁, hl1, hl2, hw, hε₀, hε₁, hI, hD⟩ :=
    wcLlsASb_boundary_form Ω W hW hWt ℓ hℓ A' K L 𝔭' v' u' a
      hswap hK α f₀ hα1 hf₀

  have hF0 : f₀ - (h ^ ℓ - h) ≠ 0 := by
    intro h0
    have e1 : f₀ = h ^ ℓ - h := sub_eq_zero.mp h0
    have e2 : (α - algebraMap K L h) ^ ℓ = α - algebraMap K L h := by
      rw [sub_pow_char]
      have := hf₀
      rw [e1, map_sub, map_pow] at this
      linear_combination (-1 : L) * this
    have hbot := (Subfield.mem_bot_iff_pow_eq_self L ℓ).mpr e2
    obtain ⟨x, hx⟩ := RingHom.mem_fieldRange.mp
