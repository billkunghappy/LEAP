      rw [hP0, hPc] at h1 h2
      have := hveq _ _ (mul_ne_zero (hF0' _ (mul_ne_zero one_ne_zero one_ne_zero)) hz)
        (hF0' _ (mul_ne_zero one_ne_zero hρ0)) h1 h2
      simpa using this
    have hvA : ∀ a₀ : A, a₀ ∉ 𝔭 → (O ρ).valuation (algebraMap A K a₀) = 1 := by
      intro a₀ ha₀
      have h0 : algebraMap A K a₀ ≠ 0 := by
        intro h0
        apply ha₀
        rw [(map_eq_zero_iff _ (IsFractionRing.injective A K)).mp h0]
        exact Ideal.zero_mem _
      have hrep : wcFrfREP W A K 𝔭 t (algebraMap A K a₀) 1 1 [] [] 1 a₀ := by
