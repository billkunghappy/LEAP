      (d + e) x ρ hn ha1 haℓ hBez hd hd' hρ0 hxl' hG' hxK htr y hy hyc hy'

  have hm0 : m ≠ 0 := by rintro rfl; exact hm (dvd_zero _)
  rcases lt_or_gt_of_ne hm0 with hneg | hpos
  ·
    obtain ⟨n, hn⟩ : ∃ n : ℕ, m = -(n : ℤ) :=
      ⟨(-m).toNat, by rw [Int.toNat_of_nonneg (by omega), neg_neg]⟩
    subst hn
    have hn0 : 0 < n := by omega
    have hℓn : ¬ (k + 1) ∣ n := fun hdv => hm (dvd_neg.mpr (Int.natCast_dvd_natCast.mpr hdv))
    rw [zpow_neg, zpow_natCast] at hkey
    apply common u v n c hPD hn0 hℓn hc hu0
    have hun : algebraMap A K u ^ n * (algebraMap A K u ^ n)⁻¹ = 1 :=
      mul_inv_cancel₀ (pow_ne_zero n hu0)
    rw [map_add]
    linear_combination (algebraMap A K u ^ n) * hkey +
      (algebraMap A K d + algebraMap A K e) * hun
  ·
    obtain ⟨n, hn⟩ : ∃ n : ℕ, m = (n : ℤ) := ⟨m.toNat, (Int.toNat_of_nonneg hpos.le).symm⟩
    subst hn
    have hn0 : 0 < n := by omega
    have hℓn : ¬ (k + 1) ∣ n := fun hdv => hm (Int.natCast_dvd_natCast.mpr hdv)
    obtain ⟨q, -, hcq⟩ := hdom hpos
    have htn : (n : ℤ).toNat = n := by simp
    rw [htn] at hcq
    have hq0 : q ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hcq
      exact hc (pow_eq_zero_iff (Nat.succ_ne_zero k) |>.mp hcq)
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (q : Ω) (Nat.succ_pos k)
    have hzW : z ∈ W := by
      rcases W.mem_or_inv_mem z with hz1 | hz1
      · exact hz1
      · by_cases hz0 : z = 0
        · rw [hz0]; exact zero_mem W
        · have hzz : z = (q : Ω) * (z⁻¹) ^ k := by
            rw [← hz, inv_pow, pow_succ, mul_comm (z ^ k) z, mul_assoc,
              mul_inv_cancel₀ (pow_ne_zero k hz0), mul_one]
          rw [hzz]; exact mul_mem q.2 (pow_mem hz1 k)
    obtain ⟨μ, hμq⟩ : ∃ μ : ↥W, μ ^ (k + 1) = q := ⟨⟨z, hzW⟩, Subtype.ext (by simpa using hz)⟩
    have hμ0 : μ ≠ 0 := by
      rintro rfl; apply hq0; rw [← hμq, zero_pow (Nat.succ_ne_zero k)]
    rw [← hμq] at hcq
    have hg : algebraMap A K (algebraMap ↥W A g) = algebraMap A K u * algebraMap A K v := by
      rw [← huv, map_mul]
    have hcK : algebraMap A K (algebraMap ↥W A c) ^ (k + 1) =
        (algebraMap A K u * algebraMap A K v) ^ n * algebraMap A K (algebraMap ↥W A μ) ^ (k + 1) := by
      have h1 := congrArg (fun w => algebraMap A K (algebraMap ↥W A w)) hcq
      simp only [map_mul, map_pow] at h1
      rw [h1, hg]
    rw [zpow_natCast] at hkey
    apply common v u n μ (wcpa_dj_llsm_kpwic_pd_swap W A 𝔭 u v g hPD) hn0 hℓn hμ0 hv0
    rw [map_add]
    apply mul_left_cancel₀ (pow_ne_zero n hu0)
    linear_combination hkey - (algebraMap A K d * (f₀ - (h ^ (k + 1) - h))) * hcK

theorem wcLlsASb_insep_node : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g b₀ : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) → b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 → b₀ ∣ g →
    ((ℓ : ℕ) : K) = 0 → Module.finrank K L = ℓ →
    ∀ (α : L) (f₀ h : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α →
    ∀ (c : ↥W) (m : ℤ) (d e : ↥(wcLlsASbS W A K u b₀)), c ≠ 0 → ¬ (ℓ : ℤ) ∣ m →
      d ∉ wcLlsASbN W A K u b₀ → e ∈ wcLlsASbN W A K u b₀ →
      (0 < m → ∃ q ∈ IsLocalRing.maximalIdeal ↥W, c ^ ℓ = b₀ ^ m.toNat * q) →
      (d : K) * (algebraMap A K (algebraMap ↥W A c) ^ ℓ * (f₀ - (h ^ ℓ - h))) =
        algebraMap A K u ^ m * ((d : K) + (e : K)) →
    wcLlsAnnSep W A K L u b₀ :=
by
  intro Ω _ _ W hW hWt ℓ hℓ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g b₀ hPD hb₀m hb₀0 hb₀g hK hfin
