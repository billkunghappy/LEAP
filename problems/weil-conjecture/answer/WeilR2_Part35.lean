        (ρ₁ ∣ ρ ∧ ρ ∣ ρ₂) → gen x ρ → good x ρ) →
    ∃ (N : ℕ) (xs : Fin N → D), ∀ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 →
