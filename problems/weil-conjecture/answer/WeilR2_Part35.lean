    rw [e]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hE)
      (Ideal.mul_mem_right _ _ (hcomap c₁ c₂ hc₁ hc₂ i hi))

  have hcl : ∀ (σ : A) (lam : ↥W) (j : ℤ) (c₁ c₂ : ↥W), lam ≠ 0 → c₁ ≠ 0 → c₂ ∣ g →
      ∀ (E E₂ r : ↥(wcLlsInnerCR W A K u c₁ c₂)), E₂ ∉ wcLlsInnerCN W A K u c₁ c₂ →
      r ∈ wcLlsInnerCN W A K u c₁ c₂ →
      algebraMap A K σ' * algebraMap A K z = algebraMap A K (algebraMap ↥W A c') ^ ℓ * (E : K) →
      algebraMap A K σ * algebraMap A K z =
        algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j * (E₂ : K) →
      algebraMap A K (algebraMap ↥W A c') ^ ℓ =
        algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j * (r : K) → False := by
    intro σ lam j c₁ c₂ hlam hc₁ hc₂ E E₂ r hE₂ hr h1 h2 h3
    have hD : algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j ≠ 0 :=
      mul_ne_zero (hψ0 lam hlam) (zpow_ne_zero _ hu0)
    have key : (algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j) *
          (algebraMap A K σ' * (E₂ : K)) =
        (algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j) *
          (algebraMap A K σ * (r : K) * (E : K)) := by
      linear_combination (-(algebraMap A K σ')) * h2 + (algebraMap A K σ) * h1 +
        (algebraMap A K σ * (E : K)) * h3
    have key2 := mul_left_cancel₀ hD key
    have hR : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) σ' * E₂ =
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) σ * r * E := by
      apply Subtype.ext
      simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
      exact key2
    apply hE₂
    apply hclash c₁ c₂ hc₁ hc₂ E₂
    rw [hR]
    exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ hr)

  unfold wcKpwmgbGood
  intro σ lam j x₂ y₂ hσ hlam _hcone hPx₂ hPy₂ HE₂
  refine Or.inl ?_
  intro c hc
  have hc0 : c ≠ 0 := by
    rintro rfl
    rw [zero_pow (by omega)] at hc
    exact hℓW hc.symm
  obtain ⟨n, hn⟩ : c ∣ c' := by
    rcases ValuationRing.dvd_total c c' with h | ⟨k, hk⟩
    · exact h
    · have hk1 : k ^ (ℓ - 1) = 1 := by
        have h0 : ((ℓ : ℕ) : ↥W) * (k ^ (ℓ - 1) - 1) = 0 := by
          have e := hc
          rw [hk, mul_pow, hc'] at e
          linear_combination e
        rcases mul_eq_zero.mp h0 with h | h
        · exact absurd h hℓW
        · exact sub_eq_zero.mp h
      refine ⟨k ^ (ℓ - 2), ?_⟩
      have e2 : ℓ - 1 = (ℓ - 2) + 1 := by omega
      rw [e2, pow_succ] at hk1
      rw [hk]
      linear_combination (-c') * hk1
  have hcn : algebraMap A K (algebraMap ↥W A c') ^ ℓ =
      algebraMap A K (algebraMap ↥W A (c ^ ℓ)) * algebraMap A K (algebraMap ↥W A (n ^ ℓ)) := by
    rw [hn]
    simp only [map_mul, map_pow, mul_pow]
  have hfin : ∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
      c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
      x₀ ∣ c₁ → c₂ ∣ y₀ → x₂ ∣ c₁ → c₂ ∣ y₂ → ∀ r : ↥(wcLlsInnerCR W A K u c₁ c₂),
      r ∈ wcLlsInnerCN W A K u c₁ c₂ →
      algebraMap A K (algebraMap ↥W A (c ^ ℓ)) =
        algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j * (r : K) → False := by
    intro c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx0 hy0 hx2 hy2 r hr hreq
    obtain ⟨E, hE⟩ := HD c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx0 hy0
    obtain ⟨E₂, hE₂, hE₂eq⟩ := HE₂ c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx2 hy2
    refine hcl σ lam j c₁ c₂ hlam h2 h7 E E₂
      (r * algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A (n ^ ℓ))) hE₂
      (Ideal.mul_mem_right _ _ hr) hE hE₂eq ?_
    rw [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, hcn, hreq]
    ring
  refine ⟨fun hj => ?_, fun hj => ?_⟩
  · obtain ⟨M, rfl⟩ := Int.eq_ofNat_of_zero_le hj
    have hMt : (M : ℤ).toNat = M := by omega
    rw [hMt]
    by_contra hno
    push_neg at hno
    have hnd : ¬ c ^ ℓ ∣ lam := fun h => hno t₁ hPt₁ (dvd_mul_of_dvd_left h _)
    obtain ⟨q, hq⟩ := (ValuationRing.dvd_total (c ^ ℓ) lam).resolve_left hnd
    rcases Nat.eq_zero_or_pos M with hM | hM
    · subst hM
      have hqm : q ∈ IsLocalRing.maximalIdeal ↥W := by
        rw [hmunit]
        intro hqu
        exact hnd ⟨↑hqu.unit⁻¹, by rw [hq, mul_assoc, IsUnit.mul_val_inv, mul_one]⟩
      obtain ⟨c₁, c₂, h1, h2, h3, h4, h5, h6, h7, hx0, hy0, hx2, hy2, -, -⟩ :=
        hpair x₂ y₂ t₁ τ hPx₂ hPy₂ hPt₁ hPτ
      have hqK : algebraMap A K (algebraMap ↥W A c) ^ ℓ =
          algebraMap A K (algebraMap ↥W A lam) * algebraMap A K (algebraMap ↥W A q) := by
        have := congrArg (fun t => algebraMap A K (algebraMap ↥W A t)) hq
        simpa only [map_mul, map_pow] using this
      refine hfin c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx0 hy0 hx2 hy2
        (algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A q)) (hmN c₁ c₂ q hqm) ?_
      simp only [Subalgebra.coe_algebraMap, Nat.cast_zero, zpow_zero, mul_one, map_mul, map_pow]
      linear_combination hqK
    · obtain ⟨ρ₀, hρ₀⟩ := hroot q M hM
      have hnP : ¬ P ρ₀ := fun h => hno ρ₀ h ⟨1, by rw [hq, hρ₀, mul_one]⟩
      obtain ⟨c₁, c₂, h1, h2, h3, h4, h5, h6, h7, hx0, hy0, hx2, hy2, -, hc₂ρ⟩ :=
        hpair x₂ y₂ t₁ ρ₀ hPx₂ hPy₂ hPt₁ hnP
      obtain ⟨k', hk'⟩ := hc₂ρ
      have hs₂ : wcLlsInnerS₂ W A K u c₂ ∈ wcLlsInnerCR W A K u c₁ c₂ :=
        Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
      have hcK : algebraMap A K (algebraMap ↥W A c) ^ ℓ =
          algebraMap A K (algebraMap ↥W A lam) * algebraMap A K (algebraMap ↥W A ρ₀) ^ M := by
        have e : c ^ ℓ = lam * ρ₀ ^ M := by rw [hρ₀]; exact hq
        have := congrArg (fun t => algebraMap A K (algebraMap ↥W A t)) e
        simpa only [map_mul, map_pow] using this
      have hρK : algebraMap A K (algebraMap ↥W A ρ₀) =
          algebraMap A K (algebraMap ↥W A c₂) * algebraMap A K (algebraMap ↥W A k') := by
        rw [hk', map_mul, map_mul]
      refine hfin c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx0 hy0 hx2 hy2
        (algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A (k' ^ M)) * ⟨_, hs₂⟩ ^ M)
        (Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ (hS₂N c₁ c₂ hs₂) M hM)) ?_
      simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap,
        zpow_natCast, map_mul, map_pow]
      rw [hcK, hρK, hS₂eq c₂]
      ring
  · obtain ⟨J, hJ⟩ : ∃ J : ℕ, j = -(J : ℤ) := ⟨(-j).toNat, by omega⟩
    subst hJ
    have hJt : (-(-(J : ℤ))).toNat = J := by omega
    have hJ0 : 0 < J := by omega
    rw [hJt]
    by_contra hno
    push_neg at hno
    obtain ⟨ρ, hPρ, q', hq'⟩ : ∃ ρ, P ρ ∧ lam ∣ c ^ ℓ * ρ ^ J := by
      rcases ValuationRing.dvd_total lam (c ^ ℓ) with h | ⟨q, hq⟩
      · exact ⟨t₁, hPt₁, dvd_mul_of_dvd_left h _⟩
      · obtain ⟨ρ₀, hρ₀⟩ := hroot q J hJ0
        by_cases hP : P ρ₀
        · exact ⟨ρ₀, hP, ⟨1, by rw [hρ₀, ← hq, mul_one]⟩⟩
        · exact (hno ρ₀ hP ⟨1, by rw [hρ₀, ← hq, mul_one]⟩).elim
    obtain ⟨c₁, c₂, h1, h2, h3, h4, h5, h6, h7, hx0, hy0, hx2, hy2, hρc₁, -⟩ :=
      hpair x₂ y₂ ρ τ hPx₂ hPy₂ hPρ hPτ
    obtain ⟨k', hk'⟩ := hρc₁
    have hs₁ : wcLlsInnerS₁ W A K u c₁ ∈ wcLlsInnerCR W A K u c₁ c₂ :=
      Algebra.subset_adjoin (Set.mem_insert _ _)
    have hUJ : algebraMap A K u ^ J ≠ 0 := pow_ne_zero _ hu0
    have hUJ' : (algebraMap A K u ^ J)⁻¹ * algebraMap A K u ^ J = 1 := inv_mul_cancel₀ hUJ
    have hq'K : algebraMap A K (algebraMap ↥W A c) ^ ℓ * algebraMap A K (algebraMap ↥W A ρ) ^ J =
        algebraMap A K (algebraMap ↥W A lam) * algebraMap A K (algebraMap ↥W A q') := by
      have := congrArg (fun t => algebraMap A K (algebraMap ↥W A t)) hq'
      simpa only [map_mul, map_pow] using this
    have hc₁K : algebraMap A K (algebraMap ↥W A c₁) =
        algebraMap A K (algebraMap ↥W A ρ) * algebraMap A K (algebraMap ↥W A k') := by
      rw [hk', map_mul, map_mul]
    have hUeq : algebraMap A K u ^ J = algebraMap A K (algebraMap ↥W A ρ) ^ J *
        algebraMap A K (algebraMap ↥W A k') ^ J * wcLlsInnerS₁ W A K u c₁ ^ J := by
      rw [hS₁eq c₁ h2, hc₁K]
      ring
    refine hfin c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx0 hy0 hx2 hy2
      (algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A (q' * k' ^ J)) * ⟨_, hs₁⟩ ^ J)
      (Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ (hS₁N c₁ c₂ hs₁) J hJ0)) ?_
    simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap,
      zpow_neg, zpow_natCast, map_mul, map_pow]
    linear_combination (-(algebraMap A K (algebraMap ↥W A c) ^ ℓ)) * hUJ' +
      (algebraMap A K (algebraMap ↥W A c) ^ ℓ * (algebraMap A K u ^ J)⁻¹) * hUeq +
      ((algebraMap A K u ^ J)⁻¹ * algebraMap A K (algebraMap ↥W A k') ^ J *
        wcLlsInnerS₁ W A K u c₁ ^ J) * hq'K

theorem wcpa_dj_llsm_kpwmgb_cmp : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ (t₁ τ : ↥W) (P : ↥W → Prop), t₁ ∈ IsLocalRing.maximalIdeal ↥W → t₁ ≠ 0 → τ ∣ g →
      ¬ g ∣ τ → P t₁ → ¬ P τ → (∀ x y : ↥W, P x → y ∣ x → P y) →
      (∀ x : ↥W, P x → ∃ x' : ↥W, P x' ∧ x ∣ x' ∧ ¬ x' ∣ x) →
      (∀ y : ↥W, ¬ P y → ∃ y' : ↥W, ¬ P y' ∧ y' ∣ y ∧ ¬ y ∣ y') →
    ∀ (μ lam : ↥W) (k j : ℤ), μ ≠ 0 → lam ≠ 0 →
      (∃ x₀ y₀ : ↥W, P x₀ ∧ ¬ P y₀ ∧
        ∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
          c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
          x₀ ∣ c₁ → c₂ ∣ y₀ →
          ∃ r : ↥(wcLlsInnerCR W A K u c₁ c₂),
            algebraMap A K (algebraMap ↥W A μ) * algebraMap A K u ^ k =
              algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j * (r : K) ∧
            (k ≠ j → r ∈ wcLlsInnerCN W A K u c₁ c₂)) ∨
      (∃ x₀ y₀ : ↥W, P x₀ ∧ ¬ P y₀ ∧
        ∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
          c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
          x₀ ∣ c₁ → c₂ ∣ y₀ →
          ∃ n ∈ wcLlsInnerCN W A K u c₁ c₂,
            algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j =
              algebraMap A K (algebraMap ↥W A μ) * algebraMap A K u ^ k * (n : K)) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 u v g hPD t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁ hPτ hdown
    hnomax hnomin μ lam k j hμ0 hlam0
  classical
  have hPD' := hPD
  simp only [wcLlsPD] at hPD'
  obtain ⟨_, hNZ, _, h𝔭max, _, _, hg0, huv, _⟩ := hPD'
  haveI := hNZ
  have hφinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hψ0 : ∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0 := by
    intro w hw hc
    have h1 : algebraMap ↥W A w = 0 := hφinj (hc.trans (map_zero _).symm)
    rw [Algebra.algebraMap_eq_smul_one] at h1
    exact (smul_ne_zero hw one_ne_zero) h1
  have hu0 : algebraMap A K u ≠ 0 := by
    intro hc
    have h1 : algebraMap A K (u * v) = 0 := by rw [map_mul, hc, zero_mul]
    rw [huv] at h1
    exact hψ0 g hg0 h1
  have hroot : ∀ (w : ↥W) (n : ℕ), 0 < n → ∃ r : ↥W, r ^ n = w := by
    intro w n hn
    obtain ⟨r, hr⟩ := IsAlgClosed.exists_pow_nat_eq (w : Ω) hn
    have hrW : r ∈ W := by
      rcases W.mem_or_inv_mem r with h | h
      · exact h
      · by_cases hr0 : r = 0
        · rw [hr0]; exact W.zero_mem
        · have e : r = r ^ n * r⁻¹ ^ (n - 1) := by
            obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
            rw [Nat.add_sub_cancel, pow_succ, mul_comm (r ^ k) r, mul_assoc, ← mul_pow,
              mul_inv_cancel₀ hr0, one_pow, mul_one]
          rw [e, hr]
          exact mul_mem w.2 (pow_mem h _)
    exact ⟨⟨r, hrW⟩, Subtype.ext (by simpa using hr)⟩
  have hmunit : ∀ z : ↥W, z ∈ IsLocalRing.maximalIdeal ↥W ↔ ¬ IsUnit z := fun z =>
    (IsLocalRing.mem_maximalIdeal z).trans mem_nonunits_iff

  have wit : ∀ (a b : ↥W) (m : ℕ), (∃ ρ : ↥W, P ρ ∧ b ∣ a * ρ ^ m) ∨
      (∃ ρ : ↥W, ¬ P ρ ∧ a * ρ ^ m ∣ b ∧ (m = 0 → ¬ b ∣ a)) := by
    intro a b m
    by_cases hba : b ∣ a
    · exact Or.inl ⟨t₁, hPt₁, dvd_mul_of_dvd_left hba _⟩
    · obtain ⟨q, hq⟩ := (ValuationRing.dvd_total a b).resolve_right hba
      rcases Nat.eq_zero_or_pos m with hm | hm
      · subst hm
        refine Or.inr ⟨τ, hPτ, ?_, fun _ => hba⟩
        rw [pow_zero, mul_one, hq]
        exact dvd_mul_right a q
      · obtain ⟨ρ, hρ⟩ := hroot q m hm
        by_cases hPρ : P ρ
        · refine Or.inl ⟨ρ, hPρ, ?_⟩
          rw [hρ, hq]
        · refine Or.inr ⟨ρ, hPρ, ?_, fun h => absurd h (by omega)⟩
          rw [hρ, hq]

  have hS₁R : ∀ c₁ c₂ : ↥W, wcLlsInnerS₁ W A K u c₁ ∈ wcLlsInnerCR W A K u c₁ c₂ :=
    fun c₁ c₂ => Algebra.subset_adjoin (by simp)
  have hS₂R : ∀ c₁ c₂ : ↥W, wcLlsInnerS₂ W A K u c₂ ∈ wcLlsInnerCR W A K u c₁ c₂ :=
    fun c₁ c₂ => Algebra.subset_adjoin (by simp)
  have hS₁N : ∀ c₁ c₂ : ↥W, (⟨_, hS₁R c₁ c₂⟩ : ↥(wcLlsInnerCR W A K u c₁ c₂)) ∈
      wcLlsInnerCN W A K u c₁ c₂ := by
    intro c₁ c₂
    unfold wcLlsInnerCN
    exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
  have hS₂N : ∀ c₁ c₂ : ↥W, (⟨_, hS₂R c₁ c₂⟩ : ↥(wcLlsInnerCR W A K u c₁ c₂)) ∈
      wcLlsInnerCN W A K u c₁ c₂ := by
    intro c₁ c₂
    unfold wcLlsInnerCN
    exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
  have hmN : ∀ (c₁ c₂ w : ↥W), w ∈ IsLocalRing.maximalIdeal ↥W →
      algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A w) ∈
        wcLlsInnerCN W A K u c₁ c₂ := by
    intro c₁ c₂ w hw
    unfold wcLlsInnerCN
    exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)

  have hL : ∀ (c₁ c₂ a b : ↥W) (m : ℕ) (e : ℤ), c₁ ≠ 0 → b ∣ a * c₁ ^ m →
      ∃ r : ↥(wcLlsInnerCR W A K u c₁ c₂),
        algebraMap A K (algebraMap ↥W A a) * algebraMap A K u ^ (e + (m : ℤ)) =
          algebraMap A K (algebraMap ↥W A b) * algebraMap A K u ^ e * (r : K) ∧
        (1 ≤ m → r ∈ wcLlsInnerCN W A K u c₁ c₂) := by
    intro c₁ c₂ a b m e hc₁ hdv
    obtain ⟨q, hq⟩ := hdv
    have hq' : algebraMap A K (algebraMap ↥W A a) * algebraMap A K (algebraMap ↥W A c₁) ^ m =
        algebraMap A K (algebraMap ↥W A b) * algebraMap A K (algebraMap ↥W A q) := by
      have := congrArg (fun t => algebraMap A K (algebraMap ↥W A t)) hq
      simpa only [map_mul, map_pow] using this
    have hcne := hψ0 c₁ hc₁
    have key : algebraMap A K (algebraMap ↥W A c₁) ^ m *
        (algebraMap A K u / algebraMap A K (algebraMap ↥W A c₁)) ^ m =
        algebraMap A K u ^ m := by
      rw [← mul_pow]
      congr 1
      field_simp
    refine ⟨algebraMap A _ (algebraMap ↥W A q) *
      (⟨_, hS₁R c₁ c₂⟩ : ↥(wcLlsInnerCR W A K u c₁ c₂)) ^ m, ?_, ?_⟩
    · show _ = _ * (algebraMap A K (algebraMap ↥W A q) *
          (algebraMap A K u / algebraMap A K (algebraMap ↥W A c₁)) ^ m)
      rw [zpow_add₀ hu0, zpow_natCast]
      linear_combination (-(algebraMap A K (algebraMap ↥W A a) * algebraMap A K u ^ e)) * key +
        (algebraMap A K u ^ e *
          (algebraMap A K u / algebraMap A K (algebraMap ↥W A c₁)) ^ m) * hq'
    · intro hm
      exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ (hS₁N c₁ c₂) _ (by omega))

  have hR : ∀ (c₁ c₂ a b : ↥W) (m : ℕ) (e : ℤ), a * c₂ ^ m ∣ b → (m = 0 → ¬ b ∣ a) →
      ∃ r ∈ wcLlsInnerCN W A K u c₁ c₂,
        algebraMap A K (algebraMap ↥W A b) * algebraMap A K u ^ e =
          algebraMap A K (algebraMap ↥W A a) * algebraMap A K u ^ (e + (m : ℤ)) * (r : K) := by
    intro c₁ c₂ a b m e hdv hflag
    obtain ⟨q, hq⟩ := hdv
    have hq' : algebraMap A K (algebraMap ↥W A b) = algebraMap A K (algebraMap ↥W A a) *
        algebraMap A K (algebraMap ↥W A c₂) ^ m * algebraMap A K (algebraMap ↥W A q) := by
      rw [hq]
      simp only [map_mul, map_pow]
    have key2 : algebraMap A K u ^ m *
        (algebraMap A K (algebraMap ↥W A c₂) / algebraMap A K u) ^ m =
        algebraMap A K (algebraMap ↥W A c₂) ^ m := by
      rw [← mul_pow]
      congr 1
      field_simp
    refine ⟨algebraMap A _ (algebraMap ↥W A q) *
      (⟨_, hS₂R c₁ c₂⟩ : ↥(wcLlsInnerCR W A K u c₁ c₂)) ^ m, ?_, ?_⟩
    · rcases Nat.eq_zero_or_pos m with hm | hm
      · subst hm
        rw [pow_zero, mul_one]
        apply hmN
        rw [hmunit]
        intro hqu
        apply hflag rfl
        refine ⟨↑hqu.unit⁻¹, ?_⟩
        rw [hq, pow_zero, mul_one, mul_assoc, IsUnit.mul_val_inv, mul_one]
      · exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ (hS₂N c₁ c₂) _ hm)
    · show _ = _ * (algebraMap A K (algebraMap ↥W A q) *
          (algebraMap A K (algebraMap ↥W A c₂) / algebraMap A K u) ^ m)
      rw [hq', zpow_add₀ hu0, zpow_natCast]
      linear_combination (-(algebraMap A K (algebraMap ↥W A a) *
        algebraMap A K (algebraMap ↥W A q) * algebraMap A K u ^ e)) * key2

  rcases le_or_gt j k with hjk | hjk
  · obtain ⟨D, hD⟩ : ∃ D : ℕ, k = j + (D : ℤ) := ⟨(k - j).toNat, by omega⟩
    subst hD
    rcases wit μ lam D with ⟨ρ, hPρ, hdv⟩ | ⟨ρ, hPρ, hdv, hfl⟩
    · left
      refine ⟨ρ, τ, hPρ, hPτ, ?_⟩
      intro c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hxc hcy
      obtain ⟨r, hr, hrN⟩ := hL c₁ c₂ μ lam D j h2
        (dvd_trans hdv (mul_dvd_mul_left μ (pow_dvd_pow_of_dvd hxc D)))
      exact ⟨r, hr, fun hne => hrN (by omega)⟩
    · right
      refine ⟨t₁, ρ, hPt₁, hPρ, ?_⟩
      intro c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hxc hcy
      exact hR c₁ c₂ μ lam D j
        (dvd_trans (mul_dvd_mul_left μ (pow_dvd_pow_of_dvd hcy D)) hdv) hfl
  · obtain ⟨D, hD, hD1⟩ : ∃ D : ℕ, j = k + (D : ℤ) ∧ 1 ≤ D :=
      ⟨(j - k).toNat, by omega, by omega⟩
    subst hD
    rcases wit lam μ D with ⟨ρ, hPρ, hdv⟩ | ⟨ρ, hPρ, hdv, hfl⟩
    · right
      refine ⟨ρ, τ, hPρ, hPτ, ?_⟩
      intro c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hxc hcy
      obtain ⟨r, hr, hrN⟩ := hL c₁ c₂ lam μ D k h2
        (dvd_trans hdv (mul_dvd_mul_left lam (pow_dvd_pow_of_dvd hxc D)))
      exact ⟨r, hrN hD1, hr⟩
    · left
      refine ⟨t₁, ρ, hPt₁, hPρ, ?_⟩
      intro c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hxc hcy
      obtain ⟨n, hn, hneq⟩ := hR c₁ c₂ lam μ D k
        (dvd_trans (mul_dvd_mul_left lam (pow_dvd_pow_of_dvd hcy D)) hdv)
        (fun h => absurd h (by omega))
      exact ⟨n, hneq, fun _ => hn⟩

theorem wcpa_dj_llsm_kpwmgb_mono : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ (lam : ↥W) (j : ℤ), lam ∈ IsLocalRing.maximalIdeal ↥W → (j < 0 → g ^ (-j).toNat ∣ lam) →
    ∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
      c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
      ∃ n ∈ wcLlsInnerCN W A K u c₁ c₂,
        algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j = (n : K) :=
by
