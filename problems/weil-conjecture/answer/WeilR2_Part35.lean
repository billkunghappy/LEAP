      Ideal.span {⟨wcLlsScS W A K t c r₀, Algebra.subset_adjoin (Set.mem_singleton _)⟩ -
        algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) (algebraMap ↥W A 0)} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀})).comp (algebraMap ↥W A)) := by
    rw [hQ]
    unfold wcLlsScN
    simp only [map_zero, sub_zero]
  obtain ⟨hA, hm⟩ := wcLlsKPas_prime_contract Ω W A K L 𝔭 t hPD c r₀ 0 hc hr₀ hr₀0 Q hQ0

  have hinjRK : Function.Injective
      (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) K) := Subtype.val_injective
  have hRK : ∀ a : A, algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) K
