        exact Subalgebra.algebraMap_mem _ t'
      · rw [Set.mem_singleton_iff] at hz
        rw [hz, hs₂]
        exact Algebra.subset_adjoin (Set.mem_singleton _)
    | algebraMap a =>
      obtain ⟨a₃, ha₃⟩ := hBrR (Subalgebra.algebraMap_mem
        (Algebra.adjoin A {algebraMap A K (t - algebraMap ↥W A c) /
          algebraMap A K (algebraMap ↥W A β)}) a)
      rw [← ha₃]
      exact Subalgebra.algebraMap_mem _ a₃
    | add x y _ _ hx hy => exact add_mem hx hy
    | mul x y _ _ hx hy => exact mul_mem hx hy
  let ι : ↥(wcLlsASdmS W A K t c β (β * q₀)) →+* ↥(Algebra.adjoin A''
      {algebraMap A'' K (algebraMap ↥W A'' q₀) / algebraMap A'' K (t' - algebraMap ↥W A'' 0)}) :=
    { toFun := fun x => ⟨x.1, hsub x.1 x.2⟩
      map_one' := Subtype.ext rfl
      map_mul' := fun _ _ => Subtype.ext rfl
      map_zero' := Subtype.ext rfl
      map_add' := fun _ _ => Subtype.ext rfl }
  have hιN : wcLlsASdmN W A K t c β (β * q₀) ≤ (Ideal.span
      {algebraMap A'' ↥(Algebra.adjoin A''
        {algebraMap A'' K (algebraMap ↥W A'' q₀) / algebraMap A'' K (t' - algebraMap ↥W A'' 0)})
        (t' - algebraMap ↥W A'' 0),
      ⟨algebraMap A'' K (algebraMap ↥W A'' q₀) / algebraMap A'' K (t' - algebraMap ↥W A'' 0),
        Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A'' ↥(Algebra.adjoin A''
          {algebraMap A'' K (algebraMap ↥W A'' q₀) / algebraMap A'' K (t' - algebraMap ↥W A'' 0)})).comp
          (algebraMap ↥W A''))).comap ι := by
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      intro x hx
      rw [SetLike.mem_coe, Ideal.mem_comap]
      rcases hx with rfl | hx
      · have e1 : ι ⟨algebraMap A K (t - algebraMap ↥W A c) / algebraMap A K (algebraMap ↥W A β),
            Algebra.subset_adjoin (Set.mem_insert _ _)⟩ =
            algebraMap A'' ↥(Algebra.adjoin A''
              {algebraMap A'' K (algebraMap ↥W A'' q₀) /
                algebraMap A'' K (t' - algebraMap ↥W A'' 0)}) (t' - algebraMap ↥W A'' 0) := by
          apply Subtype.ext
          show algebraMap A K (t - algebraMap ↥W A c) / algebraMap A K (algebraMap ↥W A β) =
            algebraMap A'' K (t' - algebraMap ↥W A'' 0)
          rw [map_zero, sub_zero, ht']
        rw [e1]
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
      · rw [Set.mem_singleton_iff] at hx
        rw [hx]
        have e1 : ι ⟨algebraMap A K (algebraMap ↥W A (β * q₀)) /
              algebraMap A K (t - algebraMap ↥W A c),
            Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ =
            ⟨algebraMap A'' K (algebraMap ↥W A'' q₀) / algebraMap A'' K (t' - algebraMap ↥W A'' 0),
              Algebra.subset_adjoin (Set.mem_singleton _)⟩ := Subtype.ext hs₂
        rw [e1]
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap, RingHom.comp_apply]
      have e1 : ι (algebraMap A ↥(wcLlsASdmS W A K t c β (β * q₀)) (algebraMap ↥W A w)) =
          algebraMap A'' ↥(Algebra.adjoin A''
            {algebraMap A'' K (algebraMap ↥W A'' q₀) / algebraMap A'' K (t' - algebraMap ↥W A'' 0)})
            (algebraMap ↥W A'' w) :=
        Subtype.ext (hBrW w).symm
      rw [e1]
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem
        ((algebraMap A'' ↥(Algebra.adjoin A''
          {algebraMap A'' K (algebraMap ↥W A'' q₀) /
            algebraMap A'' K (t' - algebraMap ↥W A'' 0)})).comp (algebraMap ↥W A'')) hw)

  have hιa : ι (algebraMap A ↥(wcLlsASdmS W A K t c β (β * q₀)) a) =
      algebraMap A'' ↥(Algebra.adjoin A''
        {algebraMap A'' K (algebraMap ↥W A'' q₀) / algebraMap A'' K (t' - algebraMap ↥W A'' 0)})
        a'' := Subtype.ext ha''.symm
  have hqN : ι d - algebraMap A'' ↥(Algebra.adjoin A''
        {algebraMap A'' K (algebraMap ↥W A'' q₀) / algebraMap A'' K (t' - algebraMap ↥W A'' 0)})
        a'' ∈ Ideal.span
      {algebraMap A'' ↥(Algebra.adjoin A''
        {algebraMap A'' K (algebraMap ↥W A'' q₀) / algebraMap A'' K (t' - algebraMap ↥W A'' 0)})
        (t' - algebraMap ↥W A'' 0),
      ⟨algebraMap A'' K (algebraMap ↥W A'' q₀) / algebraMap A'' K (t' - algebraMap ↥W A'' 0),
        Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A'' ↥(Algebra.adjoin A''
          {algebraMap A'' K (algebraMap ↥W A'' q₀) / algebraMap A'' K (t' - algebraMap ↥W A'' 0)})).comp
          (algebraMap ↥W A'')) := by
    rw [← hιa, ← map_sub]
    exact hιN ha

  have hu'K : algebraMap A'' K (t' - algebraMap ↥W A'' 0) ≠ 0 := by
    rw [map_zero, sub_zero, ht']
    exact div_ne_zero huK (hWK β hβ0)

  have heq : (f₀ - h ^ ℓ + h) * ((ι d : ↥(Algebra.adjoin A''
      {algebraMap A'' K (algebraMap ↥W A'' q₀) / algebraMap A'' K (t' - algebraMap ↥W A'' 0)})) : K) =
      ((ι e : ↥(Algebra.adjoin A''
      {algebraMap A'' K (algebraMap ↥W A'' q₀) / algebraMap A'' K (t' - algebraMap ↥W A'' 0)})) : K) := by
    show (f₀ - h ^ ℓ + h) * (d : K) = (e : K)
    linear_combination hde

  exact wcLlsAS_dse_etale_sep Ω W hW hWt ℓ hℓ A'' K L 𝔭'' t' hPD'' hK hdeg α f₀ hα1 hf₀.symm
    0 q₀ (Ideal.zero_mem _) hq₀m hq₀0 hu'K h _ rfl (ι e) (ι d) ⟨a'', ha''𝔭, hqN⟩ heq

theorem wcLlsASdm_insep_node : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A) (c β b : ↥W),
    wcLlsPD W A 𝔭 (.disc t) → c ∈ IsLocalRing.maximalIdeal ↥W →
    β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    β ∣ b → ¬ b ∣ β → ((ℓ : ℕ) : K) = 0 → Module.finrank K L = ℓ →
    ∀ (α : L) (f₀ h : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α →
    ∀ (a γ : ↥W) (m : ℤ) (d e : ↥(wcLlsASdmS W A K t c β b)),
      a ≠ 0 → γ ≠ 0 → ¬ (ℓ : ℤ) ∣ m → d ∉ wcLlsASdmN W A K t c β b →
      e ∈ wcLlsASdmN W A K t c β b →
      (0 < m → γ * b ^ m.toNat ∣ a ^ ℓ) → (m < 0 → γ ∣ a ^ ℓ * β ^ (-m).toNat) →
      (d : K) * (algebraMap A K (algebraMap ↥W A a) ^ ℓ * (f₀ - (h ^ ℓ - h))) =
        algebraMap A K (algebraMap ↥W A γ) * algebraMap A K (t - algebraMap ↥W A c) ^ m *
          ((d : K) + (e : K)) →
      wcLlsAsMidAnnSep W A K L t c β b :=
by
  classical
  intro Ω _ _ W hW hWt ℓ hℓ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t c β b hPD hc hβm hβ0 hbm hb0
    hβb hbβ hK hdeg α f₀ h hα1 hf₀ a γ m d e ha hγ hm hd he hpos hneg heq
  obtain ⟨q₀, rfl⟩ := hβb

  have hq₀0 : q₀ ≠ 0 := by
    rintro rfl
    exact hb0 (mul_zero β)
  have hq₀m : q₀ ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hcon
    have hu : IsUnit q₀ := (IsLocalRing.notMem_maximalIdeal).mp hcon
    obtain ⟨q', hq'⟩ := hu.exists_right_inv
    exact hbβ ⟨q', by rw [mul_assoc, hq', mul_one]⟩
  obtain ⟨_, hNZ, _, hmax, hm𝔭, _, h𝔭, -⟩ := id hPD
  have := hNZ
  have hWK : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
    intro x hx h0
    have h1 : algebraMap ↥W A x = 0 :=
      (IsFractionRing.injective A K) (h0.trans (map_zero _).symm)
    rw [Algebra.algebraMap_eq_smul_one] at h1
    rcases smul_eq_zero.mp h1 with h2 | h2
    · exact hx h2
    · exact one_ne_zero h2
  have hm0 : m ≠ 0 := by
    rintro rfl
    exact hm (dvd_zero _)

  have hF : f₀ - (h ^ ℓ - h) ≠ 0 := by
    haveI : Fact ℓ.Prime := ⟨hℓ⟩
    have hL : ((ℓ:ℕ):L) = 0 := by rw [← map_natCast (algebraMap K L), hK, map_zero]
    haveI : CharP L ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hL
    intro hF
    have hf : f₀ = h ^ ℓ - h := sub_eq_zero.mp hF
    have hzz : (α - algebraMap K L h) ^ ℓ = α - algebraMap K L h := by
      rw [sub_pow_char]
      have : α ^ ℓ - α = algebraMap K L h ^ ℓ - algebraMap K L h := by
        rw [← hf₀, hf, map_sub, map_pow]
      linear_combination this
    have hzbot : (α - algebraMap K L h) ∈ (⊥ : Subfield L) := by
      rw [Subfield.mem_bot_iff_pow_eq_self L ℓ]
      exact hzz
    obtain ⟨k, hk⟩ : (α - algebraMap K L h) ∈ (algebraMap K L).fieldRange :=
      (bot_le : (⊥ : Subfield L) ≤ _) hzbot
    exact hα1 ⟨k + h, by rw [map_add, hk, sub_add_cancel]⟩

  have hdK : (d : K) ≠ 0 := by
    intro h0
    apply hd
    have : d = 0 := Subtype.ext h0
    rw [this]
    exact Ideal.zero_mem _
  have huK : algebraMap A K (t - algebraMap ↥W A c) ≠ 0 := by
    intro h0
    rw [h0, zero_zpow m hm0, mul_zero, zero_mul] at heq
    exact mul_ne_zero hdK (mul_ne_zero (pow_ne_zero _ (hWK a ha)) hF) heq

  have hlamgen : ∀ (ψ : ↥W →+* K) (U F D E : K), (∀ w, w ≠ 0 → ψ w ≠ 0) →
      (0 < m → γ * (β * q₀) ^ m.toNat ∣ a ^ ℓ) → (m < 0 → γ ∣ a ^ ℓ * β ^ (-m).toNat) →
      D * (ψ a ^ ℓ * F) = ψ γ * U ^ m * (D + E) →
      ∃ lam : ↥W, lam ≠ 0 ∧ (0 < m → q₀ ^ m.toNat ∣ lam) ∧
        ψ lam * F * D = (U / ψ β) ^ m * (D + E) := by
    intro ψ U F D E hinj hpos hneg heq
    have hB := hinj β hβ0
    have hG := hinj γ hγ
    clear hm hd he hdK huK hF
    rcases lt_or_gt_of_ne hm0 with hlt | hgt
    · obtain ⟨κ, hκ⟩ := hneg hlt
      have hmn : m = -(((-m).toNat : ℕ) : ℤ) := by rw [Int.toNat_of_nonneg (by omega), neg_neg]
      generalize (-m).toNat = n at hκ hmn
      subst hmn
      refine ⟨κ, ?_, fun h => (lt_asymm h hlt).elim, ?_⟩
      · rintro rfl
        rw [mul_zero] at hκ
        exact mul_ne_zero (pow_ne_zero _ ha) (pow_ne_zero _ hβ0) hκ
      · have hκ' : ψ a ^ ℓ * ψ β ^ n = ψ γ * ψ κ := by
          rw [← map_pow, ← map_pow, ← map_mul, hκ, map_mul]
        rw [zpow_neg, zpow_natCast] at heq ⊢
        apply mul_left_cancel₀ hG
        rw [div_pow, inv_div]
        calc ψ γ * (ψ κ * F * D) = (ψ γ * ψ κ) * F * D := by ring
          _ = ψ β ^ n * (D * (ψ a ^ ℓ * F)) := by rw [← hκ']; ring
          _ = ψ β ^ n * (ψ γ * (U ^ n)⁻¹ * (D + E)) := by rw [heq]
          _ = ψ γ * (ψ β ^ n / U ^ n * (D + E)) := by rw [div_eq_mul_inv]; ring
    · obtain ⟨κ, hκ⟩ := hpos hgt
      have hmn : m = ((m.toNat : ℕ) : ℤ) := by rw [Int.toNat_of_nonneg (by omega)]
      generalize m.toNat = n at hκ hmn
      subst hmn
      refine ⟨q₀ ^ n * κ, ?_, fun _ => by simpa using dvd_mul_right (q₀ ^ n) κ, ?_⟩
      · intro h0
        rcases mul_eq_zero.mp h0 with h | h
        · exact pow_ne_zero _ hq₀0 h
        · rw [h, mul_zero] at hκ; exact pow_ne_zero _ ha hκ
      · have hκ' : ψ a ^ ℓ = ψ γ * (ψ β * ψ q₀) ^ n * ψ κ := by
          rw [← map_pow, hκ, map_mul, map_mul, map_pow, map_mul]
        rw [zpow_natCast] at heq ⊢
        have hBn : ψ β ^ n ≠ 0 := pow_ne_zero _ hB
        apply mul_left_cancel₀ (mul_ne_zero hG hBn)
        rw [div_pow, map_mul, map_pow]
        calc ψ γ * ψ β ^ n * (ψ q₀ ^ n * ψ κ * F * D)
              = D * ((ψ γ * (ψ β * ψ q₀) ^ n * ψ κ) * F) := by ring
          _ = ψ γ * U ^ n * (D + E) := by rw [← hκ', heq]
          _ = ψ γ * ψ β ^ n * (U ^ n / ψ β ^ n * (D + E)) := by field_simp
  obtain ⟨lam, hlam0, hlamdiv, hlameq⟩ := hlamgen ((algebraMap A K).comp (algebraMap ↥W A))
    (algebraMap A K (t - algebraMap ↥W A c)) (f₀ - (h ^ ℓ - h)) (d : K) (e : K) hWK hpos hneg heq

  have hroot : ∀ (n : ℕ), 0 < n → ∀ x : ↥W, ∃ y : ↥W, y ^ n = x := by
    intro n hn x
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (x : Ω) hn
    have hzW : z ∈ W := by
      rcases W.mem_or_inv_mem z with h | h
      · exact h
      · by_cases hz0 : z = 0
        · rw [hz0]; exact W.zero_mem
        · have e : z = (x : Ω) * z⁻¹ ^ (n - 1) := by
            rw [← hz]
            obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
            rw [Nat.add_sub_cancel, pow_succ, inv_pow, mul_comm (z ^ k) z, mul_assoc,
              mul_inv_cancel₀ (pow_ne_zero _ hz0), mul_one]
          rw [e]
          exact W.mul_mem _ _ x.2 (W.pow_mem h _)
    exact ⟨⟨z, hzW⟩, Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hz)⟩
  obtain ⟨μ, hμ⟩ := hroot ℓ hℓ.pos lam
  have hμ0 : μ ≠ 0 := by
    rintro rfl
    exact hlam0 (by rw [← hμ, zero_pow hℓ.ne_zero])
  have hdiv : 0 < m → q₀ ^ m.toNat ∣ μ ^ ℓ := fun hm' => by rw [hμ]; exact hlamdiv hm'

  obtain ⟨A'', _, _, _, _, _, _, _, t', 𝔭'', hBr, ht', hPD'', -⟩ :=
    wcpa_dj_llsm_br_residue_chart Ω W hW hWt A K L 𝔭 t c β hPD hc hβm hβ0

  have hiff := wcpa_dj_llsm_rsi_chart_transport Ω W hW hWt A K L 𝔭 t c β 0 q₀ A'' t' 𝔭''
    hPD hc hβm hβ0 hBr ht' hPD'' (Ideal.zero_mem _) hq₀m hq₀0
  have e0 : c + β * 0 = c := by rw [mul_zero, add_zero]
  rw [e0] at hiff

  refine hiff.mp ?_
  obtain ⟨hBrW, hBrR, hBrF⟩ := id hBr
  obtain ⟨_, _, _, _, _, _, h𝔭'', -⟩ := id hPD''

  have hadj : ∀ (G : Set K) (N : Ideal ↥(Algebra.adjoin A G)),
      (∀ (g : K) (hg : g ∈ G), (⟨g, Algebra.subset_adjoin hg⟩ : ↥(Algebra.adjoin A G)) ∈ N) →
      ∀ x : ↥(Algebra.adjoin A G), ∃ a : A, x - algebraMap A ↥(Algebra.adjoin A G) a ∈ N := by
    intro G N hG
    rintro ⟨x, hx⟩
    induction hx using Algebra.adjoin_induction with
    | mem z hz =>
      refine ⟨0, ?_⟩
      rw [map_zero, sub_zero]
      exact hG z hz
    | algebraMap a =>
      refine ⟨a, ?_⟩
      have e1 : (⟨algebraMap A K a, Subalgebra.algebraMap_mem _ a⟩ : ↥(Algebra.adjoin A G)) =
          algebraMap A ↥(Algebra.adjoin A G) a := Subtype.ext rfl
      rw [e1, sub_self]
      exact Ideal.zero_mem _
    | add x y hx hy ihx ihy =>
      obtain ⟨a, ha⟩ := ihx
      obtain ⟨a', ha'⟩ := ihy
      refine ⟨a + a', ?_⟩
      have e1 : (⟨x + y, add_mem hx hy⟩ : ↥(Algebra.adjoin A G)) -
          algebraMap A ↥(Algebra.adjoin A G) (a + a') =
          ((⟨x, hx⟩ : ↥(Algebra.adjoin A G)) - algebraMap A ↥(Algebra.adjoin A G) a) +
          ((⟨y, hy⟩ : ↥(Algebra.adjoin A G)) - algebraMap A ↥(Algebra.adjoin A G) a') := by
        apply Subtype.ext
        show x + y - algebraMap A K (a + a') = (x - algebraMap A K a) + (y - algebraMap A K a')
        rw [map_add]
        ring
      rw [e1]
      exact Ideal.add_mem _ ha ha'
    | mul x y hx hy ihx ihy =>
      obtain ⟨a, ha⟩ := ihx
      obtain ⟨a', ha'⟩ := ihy
      refine ⟨a * a', ?_⟩
      have e1 : (⟨x * y, mul_mem hx hy⟩ : ↥(Algebra.adjoin A G)) -
          algebraMap A ↥(Algebra.adjoin A G) (a * a') =
          ((⟨x, hx⟩ : ↥(Algebra.adjoin A G)) - algebraMap A ↥(Algebra.adjoin A G) a) * ⟨y, hy⟩ +
          algebraMap A ↥(Algebra.adjoin A G) a *
            ((⟨y, hy⟩ : ↥(Algebra.adjoin A G)) - algebraMap A ↥(Algebra.adjoin A G) a') := by
        apply Subtype.ext
        show x * y - algebraMap A K (a * a') =
          (x - algebraMap A K a) * y + algebraMap A K a * (y - algebraMap A K a')
        rw [map_mul]
        ring
      rw [e1]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_left _ _ ha')

  have hover : ∀ (S : Subalgebra A K) (N : Ideal ↥S)
      (hs : algebraMap A K (t - algebraMap ↥W A c) / algebraMap A K (algebraMap ↥W A β) ∈ S),
      (⟨_, hs⟩ : ↥S) ∈ N →
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W, algebraMap A ↥S (algebraMap ↥W A w) ∈ N) →
      𝔭.map (algebraMap A ↥S) ≤ N := by
    intro S N hs hsN hmN
    have hρt : algebraMap A ↥S t ∈ N := by
      have e1 : algebraMap A ↥S t = algebraMap A ↥S (algebraMap ↥W A β) * ⟨_, hs⟩ +
          algebraMap A ↥S (algebraMap ↥W A c) := by
        apply Subtype.ext
        show algebraMap A K t = algebraMap A K (algebraMap ↥W A β) *
          (algebraMap A K (t - algebraMap ↥W A c) / algebraMap A K (algebraMap ↥W A β)) +
          algebraMap A K (algebraMap ↥W A c)
        rw [mul_div_cancel₀ _ (hWK β hβ0), map_sub, sub_add_cancel]
      rw [e1]
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hsN) (hmN c hc)
    rw [h𝔭, Ideal.map_sup, Ideal.map_span, Ideal.map_map]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      rintro x ⟨y, hy, rfl⟩
      rw [Set.mem_singleton_iff] at hy
      rw [hy]
      exact hρt
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      exact hmN w hw

  have hN1 : (⟨algebraMap A K (t - algebraMap ↥W A c) / algebraMap A K (algebraMap ↥W A β),
      Algebra.subset_adjoin (Set.mem_insert _ _)⟩ : ↥(wcLlsASdmS W A K t c β (β * q₀))) ∈
      wcLlsASdmN W A K t c β (β * q₀) :=
    Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hN2 : (⟨algebraMap A K (algebraMap ↥W A (β * q₀)) / algebraMap A K (t - algebraMap ↥W A c),
      Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ :
        ↥(wcLlsASdmS W A K t c β (β * q₀))) ∈ wcLlsASdmN W A K t c β (β * q₀) :=
    Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
  have hNm : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(wcLlsASdmS W A K t c β (β * q₀)) (algebraMap ↥W A w) ∈
        wcLlsASdmN W A K t c β (β * q₀) := fun w hw =>
    Ideal.mem_sup_right (Ideal.mem_map_of_mem
      ((algebraMap A ↥(wcLlsASdmS W A K t c β (β * q₀))).comp (algebraMap ↥W A)) hw)
  have hoverM : 𝔭.map (algebraMap A ↥(wcLlsASdmS W A K t c β (β * q₀))) ≤
      wcLlsASdmN W A K t c β (β * q₀) :=
    hover (wcLlsASdmS W A K t c β (β * q₀)) (wcLlsASdmN W A K t c β (β * q₀))
      (Algebra.subset_adjoin (Set.mem_insert _ _)) hN1 hNm
  have hGM : ∀ (g : K) (hg : g ∈ ({algebraMap A K (t - algebraMap ↥W A c) /
      algebraMap A K (algebraMap ↥W A β), algebraMap A K (algebraMap ↥W A (β * q₀)) /
      algebraMap A K (t - algebraMap ↥W A c)} : Set K)),
      (⟨g, Algebra.subset_adjoin hg⟩ : ↥(wcLlsASdmS W A K t c β (β * q₀))) ∈
        wcLlsASdmN W A K t c β (β * q₀) := by
    intro g hg
    rcases hg with rfl | hg
    · exact hN1
    · rw [Set.mem_singleton_iff] at hg
      subst hg
      exact hN2
  have hcongM : ∀ x : ↥(wcLlsASdmS W A K t c β (β * q₀)), ∃ a : A,
      x - algebraMap A ↥(wcLlsASdmS W A K t c β (β * q₀)) a ∈
        wcLlsASdmN W A K t c β (β * q₀) :=
    hadj _ (wcLlsASdmN W A K t c β (β * q₀)) hGM
  obtain ⟨a₀, ha₀⟩ := hcongM d
  have ha₀𝔭 : a₀ ∉ 𝔭 := by
    intro ha𝔭
    apply hd
    have h1 := Ideal.add_mem _ ha₀ (hoverM (Ideal.mem_map_of_mem _ ha𝔭))
    rwa [sub_add_cancel] at h1

  obtain ⟨a'', ha''⟩ := hBrR (Subalgebra.algebraMap_mem
    (Algebra.adjoin A {algebraMap A K (t - algebraMap ↥W A c) /
      algebraMap A K (algebraMap ↥W A β)}) a₀)

  obtain ⟨J, hJ⟩ : ∃ J : Ideal ↥(Algebra.adjoin A {algebraMap A K (t - algebraMap ↥W A c) /
      algebraMap A K (algebraMap ↥W A β)}), J = Ideal.span (Subtype.val ⁻¹'
        ({algebraMap A K (t - algebraMap ↥W A c) / algebraMap A K (algebraMap ↥W A β)} ∪
          (fun w : ↥W => algebraMap A K (algebraMap ↥W A w)) ''
            (IsLocalRing.maximalIdeal ↥W : Set ↥W))) := ⟨_, rfl⟩
  have hBrF' : ∀ x : A'', ∃ p q : ↥(Algebra.adjoin A {algebraMap A K (t - algebraMap ↥W A c) /
      algebraMap A K (algebraMap ↥W A β)}), q ∉ J ∧ algebraMap A'' K x * (q : K) = (p : K) := by
    intro x
    obtain ⟨p, q, hq, e1⟩ := hBrF _ ⟨x, rfl⟩
    refine ⟨p, q, ?_, e1⟩
    rw [hJ]
    exact hq
  have hJ1 : (⟨algebraMap A K (t - algebraMap ↥W A c) / algebraMap A K (algebraMap ↥W A β),
      Algebra.subset_adjoin (Set.mem_singleton _)⟩ : ↥(Algebra.adjoin A
        {algebraMap A K (t - algebraMap ↥W A c) / algebraMap A K (algebraMap ↥W A β)})) ∈ J := by
    rw [hJ]
    apply Ideal.subset_span
    rw [Set.mem_preimage]
    exact Set.mem_union_left _ (Set.mem_singleton _)
  have hJm : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(Algebra.adjoin A {algebraMap A K (t - algebraMap ↥W A c) /
        algebraMap A K (algebraMap ↥W A β)}) (algebraMap ↥W A w) ∈ J := by
    intro w hw
    rw [hJ]
    apply Ideal.subset_span
    rw [Set.mem_preimage]
    exact Set.mem_union_right _ ⟨w, hw, rfl⟩
  have hJne : J ≠ ⊤ := by
    intro hJt
    obtain ⟨p, q, hq, -⟩ := hBrF' 1
    rw [hJt] at hq
    exact hq Submodule.mem_top
  have hJ1ne : (1 : ↥(Algebra.adjoin A {algebraMap A K (t - algebraMap ↥W A c) /
      algebraMap A K (algebraMap ↥W A β)})) ∉ J := fun h1 =>
    hJne ((Ideal.eq_top_iff_one J).mpr h1)
  have hJover := hover (Algebra.adjoin A {algebraMap A K (t - algebraMap ↥W A c) /
      algebraMap A K (algebraMap ↥W A β)}) J (Algebra.subset_adjoin (Set.mem_singleton _)) hJ1 hJm
  have hJcong := hadj {algebraMap A K (t - algebraMap ↥W A c) /
      algebraMap A K (algebraMap ↥W A β)} J (by
        intro g hg
        rw [Set.mem_singleton_iff] at hg
        subst hg
        exact hJ1)
  have hJunit : ∀ x : A, x ∉ 𝔭 → algebraMap A ↥(Algebra.adjoin A
      {algebraMap A K (t - algebraMap ↥W A c) / algebraMap A K (algebraMap ↥W A β)}) x ∉ J := by
    intro x hx hxJ
    obtain ⟨y, i, hi, hyi⟩ := hmax.exists_inv hx
    apply hJne
    rw [Ideal.eq_top_iff_one]
    have e1 : (1 : ↥(Algebra.adjoin A {algebraMap A K (t - algebraMap ↥W A c) /
        algebraMap A K (algebraMap ↥W A β)})) =
        algebraMap A _ y * algebraMap A _ x + algebraMap A _ i := by
      rw [← map_mul, ← map_add, hyi, map_one]
    rw [e1]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hxJ) (hJover (Ideal.mem_map_of_mem _ hi))
  have hJprime : J.IsPrime := by
    refine ⟨hJne, ?_⟩
    intro x y hxy
    obtain ⟨a₁, ha₁⟩ := hJcong x
    obtain ⟨a₂, ha₂⟩ := hJcong y
    by_cases h₁ : a₁ ∈ 𝔭
    · left
      have h2 := Ideal.add_mem _ ha₁ (hJover (Ideal.mem_map_of_mem _ h₁))
      rwa [sub_add_cancel] at h2
    by_cases h₂ : a₂ ∈ 𝔭
    · right
      have h2 := Ideal.add_mem _ ha₂ (hJover (Ideal.mem_map_of_mem _ h₂))
      rwa [sub_add_cancel] at h2
    exfalso
    apply hJunit (a₁ * a₂) (fun hm => (hmax.isPrime.mem_or_mem hm).elim h₁ h₂)
    have e1 : algebraMap A ↥(Algebra.adjoin A {algebraMap A K (t - algebraMap ↥W A c) /
        algebraMap A K (algebraMap ↥W A β)}) (a₁ * a₂) =
        x * y - ((x - algebraMap A _ a₁) * y + algebraMap A _ a₁ * (y - algebraMap A _ a₂)) := by
      rw [map_mul]
      ring
    rw [e1]
    exact Ideal.sub_mem _ hxy
      (Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha₁) (Ideal.mul_mem_left _ _ ha₂))
  let I'' : Ideal A'' :=
    { carrier := {y | ∃ p q : ↥(Algebra.adjoin A {algebraMap A K (t - algebraMap ↥W A c) /
          algebraMap A K (algebraMap ↥W A β)}), q ∉ J ∧ p ∈ J ∧
          algebraMap A'' K y * (q : K) = (p : K)}
      add_mem' := by
        intro x y hx hy
        obtain ⟨p, q, hq, hp, hx⟩ := hx
        obtain ⟨p', q', hq', hp', hy⟩ := hy
        refine ⟨p * q' + p' * q, q * q', fun hqq => ?_,
          Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_right _ _ hp'), ?_⟩
        · rcases hJprime.mem_or_mem hqq with h1 | h1
          · exact hq h1
          · exact hq' h1
        · show algebraMap A'' K (x + y) * ((q : K) * (q' : K)) =
            (p : K) * (q' : K) + (p' : K) * (q : K)
          rw [map_add, ← hx, ← hy]
          ring
      zero_mem' := ⟨0, 1, hJ1ne, Ideal.zero_mem _, by simp⟩
      smul_mem' := by
        intro z y hy
        obtain ⟨p, q, hq, hp, hy⟩ := hy
        obtain ⟨pz, qz, hqz, hz⟩ := hBrF' z
        refine ⟨pz * p, qz * q, fun hqq => ?_, Ideal.mul_mem_left _ _ hp, ?_⟩
        · rcases hJprime.mem_or_mem hqq with h1 | h1
          · exact hqz h1
          · exact hq h1
        · show algebraMap A'' K (z * y) * ((qz : K) * (q : K)) = (pz : K) * (p : K)
          rw [map_mul, ← hz, ← hy]
          ring }
  have hmemI : ∀ y : A'', y ∈ I'' ↔ ∃ p q : ↥(Algebra.adjoin A
      {algebraMap A K (t - algebraMap ↥W A c) / algebraMap A K (algebraMap ↥W A β)}),
      q ∉ J ∧ p ∈ J ∧ algebraMap A'' K y * (q : K) = (p : K) := fun y => Iff.rfl
  have h𝔭I : 𝔭'' ≤ I'' := by
    rw [h𝔭'']
    refine sup_le ?_ ?_
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact (hmemI t').mpr ⟨⟨algebraMap A K (t - algebraMap ↥W A c) /
        algebraMap A K (algebraMap ↥W A β), Algebra.subset_adjoin (Set.mem_singleton _)⟩, 1,
        hJ1ne, hJ1, by
          show algebraMap A'' K t' * (1 : K) = algebraMap A K (t - algebraMap ↥W A c) /
            algebraMap A K (algebraMap ↥W A β)
          rw [mul_one, ht']⟩
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      exact (hmemI _).mpr ⟨algebraMap A _ (algebraMap ↥W A w), 1, hJ1ne, hJm w hw, by
        show algebraMap A'' K (algebraMap ↥W A'' w) * (1 : K) = algebraMap A K (algebraMap ↥W A w)
        rw [mul_one, hBrW]⟩
  have ha''𝔭 : a'' ∉ 𝔭'' := by
    intro hmem
    obtain ⟨p, q, hq, hp, he⟩ := (hmemI a'').mp (h𝔭I hmem)
    have e1 : algebraMap A ↥(Algebra.adjoin A {algebraMap A K (t - algebraMap ↥W A c) /
        algebraMap A K (algebraMap ↥W A β)}) a₀ * q = p := by
      apply Subtype.ext
      show algebraMap A K a₀ * (q : K) = (p : K)
      rw [← ha'']
      exact he
    rw [← e1] at hp
    rcases hJprime.mem_or_mem hp with h1 | h1
    · exact hJunit a₀ ha₀𝔭 h1
    · exact hq h1

  have hs₂ : algebraMap A K (algebraMap ↥W A (β * q₀)) / algebraMap A K (t - algebraMap ↥W A c) =
      algebraMap A'' K (algebraMap ↥W A'' q₀) / algebraMap A'' K (t' - algebraMap ↥W A'' 0) := by
    rw [map_zero, sub_zero, ht', hBrW q₀, map_mul, map_mul, div_div_eq_mul_div]
    ring
  have hsub : ∀ z ∈ wcLlsASdmS W A K t c β (β * q₀), z ∈ Algebra.adjoin A''
      {algebraMap A'' K (algebraMap ↥W A'' q₀) / algebraMap A'' K (t' - algebraMap ↥W A'' 0)} := by
    intro z hz
    induction hz using Algebra.adjoin_induction with
    | mem z hz =>
      rcases hz with rfl | hz
      · rw [← ht']
        exact Subalgebra.algebraMap_mem _ t'
      · rw [Set.mem_singleton_iff] at hz
        rw [hz, hs₂]
        exact Algebra.subset_adjoin (Set.mem_singleton _)
    | algebraMap a =>
      obtain ⟨a₃, ha₃⟩ := hBrR (Subalgebra.algebraMap_mem
        (Algebra.adjoin A {algebraMap A K (t - algebraMap ↥W A c) /
          algebraMap A K (algebraMap ↥W A β)}) a)
      rw [← ha₃]
      exact Subalgebra.algebraMap_mem _ a₃
    | add x y _ _ hx hy => exact add_mem hx hy
    | mul x y _ _ hx hy => exact mul_mem hx hy
  let ι : ↥(wcLlsASdmS W A K t c β (β * q₀)) →+* ↥(Algebra.adjoin A''
      {algebraMap A'' K (algebraMap ↥W A'' q₀) / algebraMap A'' K (t' - algebraMap ↥W A'' 0)}) :=
    { toFun := fun x => ⟨x.1, hsub x.1 x.2⟩
      map_one' := Subtype.ext rfl
      map_mul' := fun _ _ => Subtype.ext rfl
      map_zero' := Subtype.ext rfl
