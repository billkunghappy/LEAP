        linear_combination b₀ ^ ((ℓ - 1) * (-m).toNat) * hρ
      · show (pd : K) * (qe : K) * (f' / h ^ ℓ - 1) * algebraMap A K (algebraMap ↥W A b₀) ^ m.toNat =
          algebraMap A K (algebraMap ↥W A (c * γ₀)) ^ ℓ * algebraMap A K u ^ m *
            ((pe : K) * (qd : K))
        rw [← hdq, ← heq]
        linear_combination ((qd : K) * (qe : K)) * hEq
    · exact (hm (by rw [hzero]; exact dvd_zero _)).elim
    ·
      have hz : ∀ x : K, x ^ m = x ^ m.toNat := fun x => by
        rw [← zpow_natCast, Int.toNat_of_nonneg hpos.le]
      have hpowmul : sB ^ m.toNat * algebraMap A K (algebraMap ↥W A b₀) ^ m.toNat =
          algebraMap A K u ^ m.toNat := by rw [← mul_pow, hsBmul]
      have hEq : (d : K) * (f' / h ^ ℓ - 1) * algebraMap A K (algebraMap ↥W A b₀) ^ m.toNat =
          algebraMap A K (algebraMap ↥W A c) ^ ℓ * algebraMap A K u ^ m * (e : K) := by
        rw [hz sB] at hde
        rw [hz (algebraMap A K u)]
        linear_combination (algebraMap A K (algebraMap ↥W A b₀) ^ m.toNat) * hde +
          (algebraMap A K (algebraMap ↥W A c) ^ ℓ * (e : K)) * hpowmul
      refine ⟨b, hbm, hb0, hb₀b, hbb₀, hbg, h, c, hh0, hc0,
        Or.inr ⟨m, pd * qe, pe * qd, hm,
          fun hmem => (hNprime.mem_or_mem hmem).elim hpd hqe,
          fun hmem => (hNprime.mem_or_mem hmem).elim hpe hqd,
          ?_, ?_,
          fun h' => absurd h' (not_lt.mpr hpos.le), fun h' => absurd h' (not_lt.mpr hpos.le),
          ?_⟩⟩
      · intro _
        obtain ⟨q, hqm, hq⟩ := hq1 hpos
        refine ⟨q, hqm, ?_⟩
        rw [one_pow, mul_one] at hq
        exact hq
      · intro _
        obtain ⟨ρ, hρ⟩ := hρ1 hpos
        refine ⟨ρ, ?_⟩
        rw [hbdef, mul_pow]
        linear_combination b₀ ^ ((ℓ - 1) * m.toNat) * hρ
      · show (pd : K) * (qe : K) * (f' / h ^ ℓ - 1) * algebraMap A K (algebraMap ↥W A b₀) ^ m.toNat =
          algebraMap A K (algebraMap ↥W A c) ^ ℓ * algebraMap A K u ^ m *
            ((pe : K) * (qd : K))
        rw [← hdq, ← heq]
        linear_combination ((qd : K) * (qe : K)) * hEq

theorem wcpa_dj_llsm_kpwi_unit_normal_form_gam : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ (f' : K) (a s : A), a ∉ 𝔭 → s ∉ 𝔭 → f' * algebraMap A K s = algebraMap A K a →
    ∃ T : Finset ↥W, ∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
      c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
      (∀ t ∈ T, c₁ ∣ t → ¬ t ∣ c₁ → c₂ ∣ t) →
      ∃ (h : K) (c : ↥W), h ≠ 0 ∧ c ≠ 0 ∧
        ((∃ η : ↥W, IsUnit η ∧ c ^ (ℓ - 1) * η = ((ℓ : ℕ) : ↥W) ∧
            ∃ d e : ↥(wcLlsInnerCR W A K u c₁ c₂), d ∉ wcLlsInnerCN W A K u c₁ c₂ ∧
              (d : K) * (f' / h ^ ℓ - 1) = algebraMap A K (algebraMap ↥W A c) ^ ℓ * (e : K)) ∨
          (∃ (m : ℤ) (d e : ↥(wcLlsInnerCR W A K u c₁ c₂)), ¬ (ℓ : ℤ) ∣ m ∧
            d ∉ wcLlsInnerCN W A K u c₁ c₂ ∧ e ∉ wcLlsInnerCN W A K u c₁ c₂ ∧
            (0 < m → ∃ q ∈ IsLocalRing.maximalIdeal ↥W,
              ((ℓ : ℕ) : ↥W) ^ ℓ = c ^ (ℓ * (ℓ - 1)) * q) ∧
            (0 < m → ∃ ρ : ↥W,
              c ^ (ℓ * (ℓ - 1)) * c₂ ^ ((ℓ - 1) * m.toNat) * ρ =
                ((ℓ : ℕ) : ↥W) ^ ℓ * c₁ ^ ((ℓ - 1) * m.toNat)) ∧
            (m < 0 → ∃ q ∈ IsLocalRing.maximalIdeal ↥W, ∃ r : ↥W,
              ((ℓ : ℕ) : ↥W) ^ ℓ * c₂ ^ ((ℓ - 1) * (-m).toNat) = c ^ (ℓ * (ℓ - 1)) * q ∧
              c ^ ℓ = c₂ ^ ((-m).toNat) * r) ∧
            (m < 0 → ∃ ρ : ↥W,
              c ^ (ℓ * (ℓ - 1)) * ρ = ((ℓ : ℕ) : ↥W) ^ ℓ * c₁ ^ ((ℓ - 1) * (-m).toNat)) ∧
            (d : K) * (f' / h ^ ℓ - 1) * algebraMap A K (algebraMap ↥W A c₁) ^ m.toNat =
              algebraMap A K (algebraMap ↥W A c) ^ ℓ * algebraMap A K u ^ m * (e : K))) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκr A _ _ _ K _ _ _ 𝔭 u v g hPD f' a s ha hs hf
  classical
  have hPD' := hPD
  obtain ⟨-, -, -, -, -, hgm, hg0, -, -⟩ := hPD'
  have hmunit : ∀ z : ↥W, z ∈ IsLocalRing.maximalIdeal ↥W ↔ ¬ IsUnit z := fun z =>
    (IsLocalRing.mem_maximalIdeal z).trans mem_nonunits_iff
  have hunitdvd : ∀ x y : ↥W, IsUnit y → x * y ∣ x := by
    intro x y hy
    obtain ⟨w, rfl⟩ := hy
    exact ⟨↑w⁻¹, by rw [mul_assoc, Units.mul_inv, mul_one]⟩

  have hroot : ∀ x : ↥W, ∀ M : ℕ, 0 < M → ∃ y : ↥W, y ^ M = x ∧
      (x ∈ IsLocalRing.maximalIdeal ↥W → y ∈ IsLocalRing.maximalIdeal ↥W) ∧ (x ≠ 0 → y ≠ 0) := by
    intro x M hM
    obtain ⟨y₀, hy₀⟩ := IsAlgClosed.exists_pow_nat_eq (x : Ω) hM
    have hy₀W : y₀ ∈ W := by
      rcases W.mem_or_inv_mem y₀ with h1 | h1
      · exact h1
      · by_cases hy0 : y₀ = 0
        · rw [hy0]; exact W.toSubring.zero_mem
        · obtain ⟨M', rfl⟩ : ∃ M', M = M' + 1 := ⟨M - 1, by omega⟩
          have e : y₀ = (x : Ω) * (y₀⁻¹) ^ M' := by
            rw [← hy₀, pow_succ, mul_comm (y₀ ^ M') y₀, mul_assoc, ← mul_pow,
              mul_inv_cancel₀ hy0, one_pow, mul_one]
          rw [e]
          exact W.toSubring.mul_mem x.2 (W.toSubring.pow_mem h1 _)
    refine ⟨⟨y₀, hy₀W⟩, ?_, ?_, ?_⟩
    · apply Subtype.ext
      rw [SubmonoidClass.coe_pow]
      exact hy₀
    · intro hx
      have hyx : (⟨y₀, hy₀W⟩ : ↥W) ^ M = x := Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hy₀)
      rw [← hyx] at hx
      exact Ideal.IsPrime.mem_of_pow_mem inferInstance M hx
    · intro hx hy
      apply hx
      have hyx : (⟨y₀, hy₀W⟩ : ↥W) ^ M = x := Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hy₀)
      rw [← hyx, hy, zero_pow hM.ne']

  obtain ⟨GAM, hGAM⟩ : ∃ GAM : A → ↥W → ↥W → Prop, ∀ (u' : A) (c₁ c₂ : ↥W), GAM u' c₁ c₂ ↔
      ∃ (h : K) (c : ↥W), h ≠ 0 ∧ c ≠ 0 ∧
        ((∃ η : ↥W, IsUnit η ∧ c ^ (ℓ - 1) * η = ((ℓ : ℕ) : ↥W) ∧
            ∃ d e : ↥(wcLlsInnerCR W A K u' c₁ c₂), d ∉ wcLlsInnerCN W A K u' c₁ c₂ ∧
              (d : K) * (f' / h ^ ℓ - 1) = algebraMap A K (algebraMap ↥W A c) ^ ℓ * (e : K)) ∨
          (∃ (m : ℤ) (d e : ↥(wcLlsInnerCR W A K u' c₁ c₂)), ¬ (ℓ : ℤ) ∣ m ∧
            d ∉ wcLlsInnerCN W A K u' c₁ c₂ ∧ e ∉ wcLlsInnerCN W A K u' c₁ c₂ ∧
            (0 < m → ∃ q ∈ IsLocalRing.maximalIdeal ↥W,
              ((ℓ : ℕ) : ↥W) ^ ℓ = c ^ (ℓ * (ℓ - 1)) * q) ∧
            (0 < m → ∃ ρ : ↥W,
              c ^ (ℓ * (ℓ - 1)) * c₂ ^ ((ℓ - 1) * m.toNat) * ρ =
                ((ℓ : ℕ) : ↥W) ^ ℓ * c₁ ^ ((ℓ - 1) * m.toNat)) ∧
            (m < 0 → ∃ q ∈ IsLocalRing.maximalIdeal ↥W, ∃ r : ↥W,
              ((ℓ : ℕ) : ↥W) ^ ℓ * c₂ ^ ((ℓ - 1) * (-m).toNat) = c ^ (ℓ * (ℓ - 1)) * q ∧
              c ^ ℓ = c₂ ^ ((-m).toNat) * r) ∧
            (m < 0 → ∃ ρ : ↥W,
              c ^ (ℓ * (ℓ - 1)) * ρ = ((ℓ : ℕ) : ↥W) ^ ℓ * c₁ ^ ((ℓ - 1) * (-m).toNat)) ∧
            (d : K) * (f' / h ^ ℓ - 1) * algebraMap A K (algebraMap ↥W A c₁) ^ m.toNat =
              algebraMap A K (algebraMap ↥W A c) ^ ℓ * algebraMap A K u' ^ m * (e : K))) :=
    ⟨_, fun _ _ _ => Iff.rfl⟩
  obtain ⟨CAP, hCAP⟩ : ∃ CAP : A → ↥W → ↥W → Prop, ∀ (u' : A) (c₁ c₂ : ↥W), CAP u' c₁ c₂ ↔
      ∃ (h : K) (c : ↥W), h ≠ 0 ∧ c ≠ 0 ∧
        ((∃ η : ↥W, IsUnit η ∧ c ^ (ℓ - 1) * η = ((ℓ : ℕ) : ↥W) ∧
            ∃ d e : ↥(wcLlsInnerCR W A K u' c₁ c₂), d ∉ wcLlsInnerCN W A K u' c₁ c₂ ∧
              (d : K) * (f' / h ^ ℓ - 1) = algebraMap A K (algebraMap ↥W A c) ^ ℓ * (e : K)) ∨
          (∃ (m : ℤ) (d e : ↥(wcLlsInnerCR W A K u' c₁ c₂)), ¬ (ℓ : ℤ) ∣ m ∧
            d ∉ wcLlsInnerCN W A K u' c₁ c₂ ∧ e ∉ wcLlsInnerCN W A K u' c₁ c₂ ∧
            (0 < m → ∃ q ∈ IsLocalRing.maximalIdeal ↥W,
              ((ℓ : ℕ) : ↥W) ^ ℓ = c ^ (ℓ * (ℓ - 1)) * c₁ ^ ((ℓ - 1) * m.toNat) * q) ∧
            (0 < m → ∃ ρ : ↥W,
              c ^ (ℓ * (ℓ - 1)) * c₂ ^ ((ℓ - 1) * m.toNat) * ρ = ((ℓ : ℕ) : ↥W) ^ ℓ) ∧
            (m < 0 → ∃ q ∈ IsLocalRing.maximalIdeal ↥W, ∃ r : ↥W,
              ((ℓ : ℕ) : ↥W) ^ ℓ * c₂ ^ ((ℓ - 1) * (-m).toNat) = c ^ (ℓ * (ℓ - 1)) * q ∧
              c ^ ℓ = c₂ ^ ((-m).toNat) * r) ∧
            (m < 0 → ∃ ρ : ↥W,
              c ^ (ℓ * (ℓ - 1)) * ρ = ((ℓ : ℕ) : ↥W) ^ ℓ * c₁ ^ ((ℓ - 1) * (-m).toNat)) ∧
            (d : K) * (f' / h ^ ℓ - 1) =
              algebraMap A K (algebraMap ↥W A c) ^ ℓ * algebraMap A K u' ^ m * (e : K))) :=
    ⟨_, fun _ _ _ => Iff.rfl⟩

  have s3 : ∀ (u' : A) (c₁ c₂ : ↥W), c₁ ≠ 0 → CAP u' c₁ c₂ → GAM u' c₁ c₂ := by
    intro u' c₁ c₂ hc₁0 H
    rw [hCAP] at H
    rw [hGAM]
    obtain ⟨h, c, hh0, hc0, H⟩ := H
    rcases H with ⟨η, hη, hcη, d, e, hd, hde⟩ |
        ⟨m, d, e, hm, hd, he, hq1, hρ1, hq2, hρ2, hde⟩
    · exact ⟨h, c, hh0, hc0, Or.inl ⟨η, hη, hcη, d, e, hd, hde⟩⟩
    · by_cases hm0 : m ≤ 0
      · have hmt : m.toNat = 0 := Int.toNat_eq_zero.mpr hm0
        refine ⟨h, c, hh0, hc0, Or.inr ⟨m, d, e, hm, hd, he,
          fun h' => absurd h' (not_lt.mpr hm0), fun h' => absurd h' (not_lt.mpr hm0),
          hq2, hρ2, ?_⟩⟩
        rw [hmt, pow_zero, mul_one]
        exact hde
      · push_neg at hm0
        obtain ⟨q, hqm, hq⟩ := hq1 hm0
        obtain ⟨ρ, hρ⟩ := hρ1 hm0
        obtain ⟨δ, hδ, -, hδ0⟩ := hroot (c₁ ^ m.toNat) ℓ hℓ.pos
        have hδ0' : δ ≠ 0 := hδ0 (pow_ne_zero _ hc₁0)
        have hkey : (c * δ) ^ (ℓ * (ℓ - 1)) = c ^ (ℓ * (ℓ - 1)) * c₁ ^ ((ℓ - 1) * m.toNat) := by
          rw [mul_pow, pow_mul δ ℓ (ℓ - 1), hδ, ← pow_mul, Nat.mul_comm m.toNat (ℓ - 1)]
        have hδK : (algebraMap A K (algebraMap ↥W A δ)) ^ ℓ =
            algebraMap A K (algebraMap ↥W A c₁) ^ m.toNat := by
          have e1 : algebraMap A K (algebraMap ↥W A (c₁ ^ m.toNat)) =
              algebraMap A K (algebraMap ↥W A (δ ^ ℓ)) := by rw [hδ]
          simpa only [map_pow] using e1.symm
        refine ⟨h, c * δ, hh0, mul_ne_zero hc0 hδ0', Or.inr ⟨m, d, e, hm, hd, he,
          fun _ => ⟨q, hqm, ?_⟩, fun _ => ⟨ρ, ?_⟩,
          fun h' => absurd h' (not_lt.mpr hm0.le), fun h' => absurd h' (not_lt.mpr hm0.le), ?_⟩⟩
        · rw [hkey]; exact hq
        · rw [hkey, ← hρ]; ring
        · rw [map_mul, map_mul, mul_pow, hδK]
          linear_combination (algebraMap A K (algebraMap ↥W A c₁) ^ m.toNat) * hde

  have hPDv := wcpa_dj_llsm_kpwic_pd_swap W A 𝔭 u v g hPD

  obtain ⟨tlo, hlom, hlo0, hlog, Hlo⟩ := wcpa_dj_llsm_kpwug_low_collar_closed Ω W hW hWt ℓ hℓ
    hΩ hκr A K 𝔭 u v g hPD f' a s ha hs hf

  obtain ⟨thi, hhim, hhi0, hhig, Hv⟩ := wcpa_dj_llsm_kpwug_low_collar_closed Ω W hW hWt ℓ hℓ
    hΩ hκr A K 𝔭 v u g hPDv f' a s ha hs hf
  have Hhi : ∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
      c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
      g ∣ thi * c₁ → GAM u c₁ c₂ := by
    intro c₁ c₂ _ hc₁0 _ hc₂0 h12 h21 h2g hgt
    obtain ⟨c₁', hc₁'⟩ := h2g
    obtain ⟨β, hβ⟩ := h12
    have hβm : β ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [hmunit]
      intro hu
      apply h21
      rw [hβ]
      exact hunitdvd c₁ β hu
    have hg1 : g = c₁ * (β * c₁') := by rw [hc₁', hβ]; ring
    have hc₁'0 : c₁' ≠ 0 := by
      rintro rfl
      apply hg0
      rw [hc₁', mul_zero]
    have hc₂'0 : β * c₁' ≠ 0 := by
      intro h0
      apply hg0
      rw [hg1, h0, mul_zero]
    have hc₂'m : β * c₁' ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right _ _ hβm
    have h12' : c₁' ∣ β * c₁' := dvd_mul_left _ _
    have h21' : ¬ β * c₁' ∣ c₁' := by
      rintro ⟨x, hx⟩
      apply (hmunit β).mp hβm
      apply isUnit_of_dvd_one
      exact ⟨x, by
        apply mul_left_cancel₀ hc₁'0
        rw [mul_one]
        linear_combination hx⟩
    have h2t : β * c₁' ∣ thi := by
      have h1 : c₁ * (β * c₁') ∣ c₁ * thi := by
        rw [← hg1, mul_comm c₁]
        exact hgt
      exact (mul_dvd_mul_iff_left hc₁0).mp h1
    have HC := Hv c₁' (β * c₁') hc₁'0 hc₂'m hc₂'0 h12' h21' h2t
    have HG := s3 v c₁' (β * c₁') hc₁'0 ((hCAP v c₁' (β * c₁')).mpr HC)
    exact (hGAM u c₁ c₂).mpr (wcpa_dj_llsm_kpwug_swap_gam Ω W ℓ hℓ A K 𝔭 u v g hPD f'
      c₁ c₂ c₁' (β * c₁') hc₁0 hc₂0 hc₁' hg1 ((hGAM v c₁' (β * c₁')).mp HG))

  have LG : ∀ b₀ : ↥W, b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 → b₀ ∣ g → ¬ g ∣ b₀ →
      ∃ a₀ : ↥W, a₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ a₀ ≠ 0 ∧ a₀ ∣ b₀ ∧ ¬ b₀ ∣ a₀ ∧
        GAM u a₀ b₀ := by
    intro b₀ hb₀m hb₀0 hb₀g hgb₀
    obtain ⟨b₀', hb₀'⟩ := hb₀g
    have hb₀'0 : b₀' ≠ 0 := by
      rintro rfl
      exact hg0 (by rw [hb₀', mul_zero])
    have hb₀'m : b₀' ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [hmunit]
      intro hu
      apply hgb₀
      rw [hb₀']
      exact hunitdvd b₀ b₀' hu
    have hb₀'g : b₀' ∣ g := ⟨b₀, by rw [hb₀', mul_comm]⟩
    have hgb₀' : ¬ g ∣ b₀' := by
      rintro ⟨x, hx⟩
      apply (hmunit b₀).mp hb₀m
      apply isUnit_of_dvd_one
      exact ⟨x, by
        apply mul_left_cancel₀ hb₀'0
        rw [mul_one]
        linear_combination hx + x * hb₀'⟩
    obtain ⟨b', hb'm, hb'0, h0b', hb'0', hb'g, HR⟩ :=
      wcpa_dj_llsm_kpwug_right_germ_gam Ω W hW hWt ℓ hℓ hΩ hκr A K 𝔭 v u g hPDv f' a s ha hs hf
        b₀' hb₀'m hb₀'0 hb₀'g hgb₀'
    obtain ⟨κ, hκ⟩ := h0b'
    have hκm : κ ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [hmunit]
      intro hu
      apply hb'0'
      rw [hκ]
      exact hunitdvd b₀' κ hu
    have hκ0 : κ ≠ 0 := by
      rintro rfl
      exact hb'0 (by rw [hκ, mul_zero])
    obtain ⟨ρ, hρ, hρm, hρ0⟩ := hroot κ 2 (by norm_num)
    have hρm' := hρm hκm
    have hρ0' := hρ0 hκ0
    have hb''m : b₀' * ρ ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right _ _ hb₀'m
    have hb''0 : b₀' * ρ ≠ 0 := mul_ne_zero hb₀'0 hρ0'
    have h0b'' : b₀' ∣ b₀' * ρ := dvd_mul_right _ _
    have hb''0' : ¬ b₀' * ρ ∣ b₀' := by
      rintro ⟨x, hx⟩
      apply (hmunit ρ).mp hρm'
      apply isUnit_of_dvd_one
      exact ⟨x, by
        apply mul_left_cancel₀ hb₀'0
        rw [mul_one]
        linear_combination hx⟩
    have hb''b' : b₀' * ρ ∣ b' := ⟨ρ, by rw [hκ, ← hρ]; ring⟩
    have HR' := wcpa_dj_llsm_kpwug_shrink_gam Ω W hW hWt ℓ hℓ hΩ hκr A K 𝔭 v u g hPDv f' a s ha
      hs hf b₀' b' b₀' (b₀' * ρ) hb₀'m hb₀'0 hb'm hb'0 ⟨κ, hκ⟩ hb'0' hb'g hb₀'m hb₀'0 hb''m
      hb''0 h0b'' hb''0' dvd_rfl hb''b' HR
    obtain ⟨g₁, hg₁⟩ := hb'g
    have hga : g = ρ * g₁ * (b₀' * ρ) := by
      rw [hg₁, hκ, ← hρ]
      ring
    have ha₀m : ρ * g₁ ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right _ _ hρm'
    have ha₀0 : ρ * g₁ ≠ 0 := by
      intro h0
      apply hg0
      rw [hga, h0, zero_mul]
    have hb₀eq : b₀ = ρ * g₁ * ρ := by
      apply mul_left_cancel₀ hb₀'0
      linear_combination hga - hb₀'
    have ha₀b₀ : ρ * g₁ ∣ b₀ := ⟨ρ, hb₀eq⟩
    have hb₀a₀ : ¬ b₀ ∣ ρ * g₁ := by
      rintro ⟨x, hx⟩
      apply (hmunit ρ).mp hρm'
      apply isUnit_of_dvd_one
      exact ⟨x, by
        apply mul_left_cancel₀ ha₀0
        rw [mul_one]
        linear_combination hx + x * hb₀eq⟩
    refine ⟨ρ * g₁, ha₀m, ha₀0, ha₀b₀, hb₀a₀, ?_⟩
    exact (hGAM u (ρ * g₁) b₀).mpr (wcpa_dj_llsm_kpwug_swap_gam Ω W ℓ hℓ A K 𝔭 u v g hPD f'
      (ρ * g₁) b₀ b₀' (b₀' * ρ) ha₀0 hb₀0 hb₀' hga HR')

  obtain ⟨τ, hτ⟩ := hhig
  have hτ0 : τ ≠ 0 := by
    rintro rfl
    apply hg0
    rw [hτ, mul_zero]
  have hτg : τ ∣ g := ⟨thi, by rw [hτ, mul_comm]⟩
  have hgτ : ¬ g ∣ τ := by
    rintro ⟨k, hk⟩
    apply (hmunit thi).mp hhim
    have e : τ * (thi * k) = τ * 1 := by
      rw [mul_one]
      calc τ * (thi * k) = thi * τ * k := by ring
        _ = g * k := by rw [hτ]
        _ = τ := hk.symm
    exact isUnit_of_dvd_one ⟨k, (mul_left_cancel₀ hτ0 e).symm⟩
  have key : ∀ SH : ↥W → ↥W → Prop,
      (∀ c₁ c₂ c₁' c₂' : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
        c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
        c₁' ∈ IsLocalRing.maximalIdeal ↥W → c₁' ≠ 0 →
        c₂' ∈ IsLocalRing.maximalIdeal ↥W → c₂' ≠ 0 → c₁' ∣ c₂' → ¬ c₂' ∣ c₁' →
        c₁ ∣ c₁' → c₂' ∣ c₂ → SH c₁ c₂ → SH c₁' c₂') →
      (∀ b₀ : ↥W, b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 → b₀ ∣ g → ¬ g ∣ b₀ →
        ∃ b : ↥W, b ∈ IsLocalRing.maximalIdeal ↥W ∧ b ≠ 0 ∧ b₀ ∣ b ∧ ¬ b ∣ b₀ ∧ b ∣ g ∧
          SH b₀ b) →
      (∀ b₀ : ↥W, b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 → b₀ ∣ g → ¬ g ∣ b₀ →
        ∃ a₀ : ↥W, a₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ a₀ ≠ 0 ∧ a₀ ∣ b₀ ∧ ¬ b₀ ∣ a₀ ∧
          SH a₀ b₀) →
      (∀ P : ↥W → Prop, P tlo → ¬ P τ → (∀ x y : ↥W, P x → y ∣ x → P y) →
        (∀ x : ↥W, P x → ∃ x' : ↥W, P x' ∧ x ∣ x' ∧ ¬ x' ∣ x) →
        (∀ y : ↥W, ¬ P y → ∃ y' : ↥W, ¬ P y' ∧ y' ∣ y ∧ ¬ y ∣ y') →
        ∃ x y : ↥W, P x ∧ ¬ P y ∧ x ∈ IsLocalRing.maximalIdeal ↥W ∧ x ≠ 0 ∧
          y ∈ IsLocalRing.maximalIdeal ↥W ∧ y ≠ 0 ∧ x ∣ y ∧ ¬ y ∣ x ∧ y ∣ g ∧ SH x y) →
      ∃ T : Finset ↥W, ∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
        c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
        tlo ∣ c₁ → c₂ * thi ∣ g →
        (∀ t ∈ T, c₁ ∣ t → ¬ t ∣ c₁ → c₂ ∣ t) → SH c₁ c₂ := by
    intro SH hshr hR hL hG
    obtain ⟨Good, hGood⟩ : ∃ Good : ↥W → Prop, ∀ x, Good x ↔
        ∃ T : Finset ↥W, ∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
          c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
          tlo ∣ c₁ → c₂ ∣ x → (∀ t ∈ T, c₁ ∣ t → ¬ t ∣ c₁ → c₂ ∣ t) → SH c₁ c₂ :=
      ⟨_, fun _ => Iff.rfl⟩
    have hdown : ∀ x y : ↥W, Good x → y ∣ x → Good y := by
      intro x y hx hyx
      obtain ⟨T, hT⟩ := (hGood x).mp hx
      exact (hGood y).mpr ⟨T, fun c₁ c₂ h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 =>
        hT c₁ c₂ h1 h2 h3 h4 h5 h6 h7 h8 (dvd_trans h9 hyx) h10⟩
    have hGt₁ : Good tlo := (hGood tlo).mpr ⟨∅, fun c₁ c₂ _ _ _ _ _ h21 _ ht1 h2t _ =>
      absurd (dvd_trans h2t ht1) h21⟩
    have bridge : ∀ x y : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → x ≠ 0 →
        y ∈ IsLocalRing.maximalIdeal ↥W → y ≠ 0 → x ∣ y → ¬ y ∣ x → y ∣ g → SH x y →
        Good x → Good y := by
      intro x y hxm hx0 hym hy0 hxy hyx hyg hSH hGx
      obtain ⟨T, hT⟩ := (hGood x).mp hGx
      refine (hGood y).mpr ⟨insert x T, ?_⟩
      intro c₁ c₂ hc₁m hc₁0 hc₂m hc₂0 h12 h21 h2g ht1 h2y hav
      by_cases h2x : c₂ ∣ x
      · exact hT c₁ c₂ hc₁m hc₁0 hc₂m hc₂0 h12 h21 h2g ht1 h2x
          (fun t ht => hav t (Finset.mem_insert_of_mem ht))
      · have hx1 : x ∣ c₁ := by
          by_contra hn
          have h1 : c₁ ∣ x := (ValuationRing.dvd_total x c₁).resolve_left hn
          exact h2x (hav x (Finset.mem_insert_self _ _) h1 hn)
        exact hshr x y c₁ c₂ hxm hx0 hym hy0 hxy hyx hyg hc₁m hc₁0 hc₂m hc₂0 h12 h21 hx1 h2y hSH
    have hmemt : ∀ z : ↥W, tlo ∣ z → z ∈ IsLocalRing.maximalIdeal ↥W := by
      intro z hz
      obtain ⟨k, hk⟩ := hz
      rw [hk]
      exact Ideal.mul_mem_right k _ hlom
    suffices hGτ : Good τ by
      obtain ⟨T, hT⟩ := (hGood τ).mp hGτ
      refine ⟨T, fun c₁ c₂ h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 =>
        hT c₁ c₂ h1 h2 h3 h4 h5 h6 h7 h8 ?_ h10⟩
      rw [hτ, mul_comm thi τ] at h9
      exact (mul_dvd_mul_iff_right hhi0).mp h9
    by_contra hnG
    have hnτ : ∀ z : ↥W, Good z → ¬ τ ∣ z := fun z hz hτz => hnG (hdown z τ hz hτz)
    by_cases hA : ∃ x : ↥W, Good x ∧ ∀ x' : ↥W, x ∣ x' → ¬ x' ∣ x → ¬ Good x'
    · obtain ⟨x, hGx, hmax⟩ := hA
      have ht₁x : tlo ∣ x := by
        by_contra hn
        have h1 : x ∣ tlo := (ValuationRing.dvd_total tlo x).resolve_left hn
        exact hmax tlo h1 hn hGt₁
      have hxm : x ∈ IsLocalRing.maximalIdeal ↥W := hmemt x ht₁x
      have hx0 : x ≠ 0 := by
        rintro rfl
        exact hnτ 0 hGx (dvd_zero τ)
      have hτx : ¬ τ ∣ x := hnτ x hGx
      have hxτ : x ∣ τ := (ValuationRing.dvd_total x τ).resolve_right hτx
      have hxg : x ∣ g := dvd_trans hxτ hτg
      have hgx : ¬ g ∣ x := fun h => hτx (dvd_trans hτg h)
      obtain ⟨b, hbm, hb0, hxb, hbx, hbg, hSH⟩ := hR x hxm hx0 hxg hgx
      exact hmax b hxb hbx (bridge x b hxm hx0 hbm hb0 hxb hbx hbg hSH hGx)
    by_cases hB : ∃ y : ↥W, ¬ Good y ∧ ∀ y' : ↥W, y' ∣ y → ¬ y ∣ y' → Good y'
    · obtain ⟨y, hnGy, hmin⟩ := hB
      have hyt₁ : ¬ y ∣ tlo := fun h => hnGy (hdown tlo y hGt₁ h)
      have ht₁y : tlo ∣ y := (ValuationRing.dvd_total tlo y).resolve_right hyt₁
      have hym : y ∈ IsLocalRing.maximalIdeal ↥W := hmemt y ht₁y
      have hyτ : y ∣ τ := by
        by_contra hn
        have h1 : τ ∣ y := (ValuationRing.dvd_total y τ).resolve_left hn
        exact hnG (hmin τ h1 hn)
      have hy0 : y ≠ 0 := by
        rintro rfl
        exact hτ0 (zero_dvd_iff.mp hyτ)
      have hyg : y ∣ g := dvd_trans hyτ hτg
      have hgy : ¬ g ∣ y := fun h => hgτ (dvd_trans h hyτ)
      obtain ⟨x, hxm, hx0, hxy, hyx, hSH⟩ := hL y hym hy0 hyg hgy
      exact hnGy (bridge x y hxm hx0 hym hy0 hxy hyx hyg hSH (hmin x hxy hyx))
    · have hnomax : ∀ x : ↥W, Good x → ∃ x' : ↥W, Good x' ∧ x ∣ x' ∧ ¬ x' ∣ x := by
        intro x hx
        by_contra hn
        exact hA ⟨x, hx, fun x' h1 h2 hG' => hn ⟨x', hG', h1, h2⟩⟩
      have hnomin : ∀ y : ↥W, ¬ Good y → ∃ y' : ↥W, ¬ Good y' ∧ y' ∣ y ∧ ¬ y ∣ y' := by
        intro y hy
        by_contra hn
        exact hB ⟨y, hy, fun y' h1 h2 => not_not.mp (fun hG' => hn ⟨y', hG', h1, h2⟩)⟩
      obtain ⟨x, y, hGx, hnGy, hxm, hx0, hym, hy0, hxy, hyx, hyg, hSH⟩ :=
        hG Good hGt₁ hnG hdown hnomax hnomin
      exact hnGy (bridge x y hxm hx0 hym hy0 hxy hyx hyg hSH hGx)
  obtain ⟨T', Hmid⟩ := key (GAM u)
    (fun c₁ c₂ c₁' c₂' h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12 h13 h14 h15 hSH =>
      (hGAM u c₁' c₂').mpr (wcpa_dj_llsm_kpwug_shrink_gam Ω W hW hWt ℓ hℓ hΩ hκr A K 𝔭 u v g
        hPD f' a s ha hs hf c₁ c₂ c₁' c₂' h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12 h13 h14 h15
        ((hGAM u c₁ c₂).mp hSH)))
    (fun b₀ h1 h2 h3 h4 => by
      obtain ⟨b, hb1, hb2, hb3, hb4, hb5, H⟩ := wcpa_dj_llsm_kpwug_right_germ_gam Ω W hW hWt ℓ
        hℓ hΩ hκr A K 𝔭 u v g hPD f' a s ha hs hf b₀ h1 h2 h3 h4
      exact ⟨b, hb1, hb2, hb3, hb4, hb5, (hGAM u b₀ b).mpr H⟩)
    LG
    (fun P h1 h2 h3 h4 h5 => by
      obtain ⟨x, y, hPx, hPy, hxm, hx0, hym, hy0, hxy, hyx, hyg, H⟩ :=
        wcpa_dj_llsm_kpwm_gap_germ Ω W hW hWt ℓ hℓ hΩ hκr A K 𝔭 u v g hPD f' a s ha hs hf
          tlo τ P hlom hlo0 hτg hgτ h1 h2 h3 h4 h5
      exact ⟨x, y, hPx, hPy, hxm, hx0, hym, hy0, hxy, hyx, hyg,
        s3 u x y hx0 ((hCAP u x y).mpr H)⟩)

  refine ⟨insert tlo (insert τ T'), ?_⟩
  intro c₁ c₂ hc₁m hc₁0 hc₂m hc₂0 h12 h21 h2g hav
  apply (hGAM u c₁ c₂).mp
  by_cases hc2lo : c₂ ∣ tlo
  · exact s3 u c₁ c₂ hc₁0 ((hCAP u c₁ c₂).mpr (Hlo c₁ c₂ hc₁0 hc₂m hc₂0 h12 h21 hc2lo))
  have hloc1 : tlo ∣ c₁ := by
    by_contra h'
    have h : c₁ ∣ tlo := (ValuationRing.dvd_total tlo c₁).resolve_left h'
    exact hc2lo (hav tlo (Finset.mem_insert_self _ _) h h')
  by_cases hghi : g ∣ thi * c₁
  · exact Hhi c₁ c₂ hc₁m hc₁0 hc₂m hc₂0 h12 h21 h2g hghi
  have h1 : thi * c₁ ∣ thi * τ := by
    rw [← hτ]
    exact (ValuationRing.dvd_total (thi * c₁) g).resolve_right hghi
  have hc1τ : c₁ ∣ τ := (mul_dvd_mul_iff_left hhi0).mp h1
  have hτc1 : ¬ τ ∣ c₁ := by
    intro h
    apply hghi
    rw [hτ]
    exact mul_dvd_mul_left thi h
  have hc2τ : c₂ ∣ τ :=
    hav τ (Finset.mem_insert_of_mem (Finset.mem_insert_self _ _)) hc1τ hτc1
  have hc2g : c₂ * thi ∣ g := by
    rw [hτ, mul_comm thi τ]
    exact mul_dvd_mul_right hc2τ thi
  exact Hmid c₁ c₂ hc₁m hc₁0 hc₂m hc₂0 h12 h21 h2g hloc1 hc2g
    (fun t ht ht1 ht2 => hav t (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem ht)) ht1 ht2)

theorem wcpa_dj_llsm_kpwic_inner_transfer : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (A' : Type u) [CommRing A'] [Algebra ↥W A'] [Algebra A' K]
    (𝔭 : Ideal A) (u v : A) (g c₁ c₂ : ↥W) (u' v' : A') (𝔭' : Ideal A'),
    wcLlsPD W A 𝔭 (.ann u v g) → c₁ ≠ 0 → c₂ ∣ g → Function.Injective (algebraMap A' K) →
    (∀ w : ↥W, algebraMap A' K (algebraMap ↥W A' w) = algebraMap A K (algebraMap ↥W A w)) →
    (∀ a : A, ∃ a' : A', algebraMap A' K a' = algebraMap A K a) →
    algebraMap A' K u' = wcLlsInnerS₁ W A K u c₁ →
    algebraMap A' K v' = wcLlsInnerS₂ W A K u c₂ →
    𝔭' = Ideal.span {u', v'} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A') →
    𝔭' ≠ ⊤ →
    ∀ d : ↥(wcLlsInnerCR W A K u c₁ c₂), d ∉ wcLlsInnerCN W A K u c₁ c₂ →
    ∃ d' : A', algebraMap A' K d' = (d : K) ∧ d' ∉ 𝔭' :=
by
  intro Ω _ W A _ _ _ K _ _ _ A' _ _ _ 𝔭 u v g c₁ c₂ u' v' 𝔭' hPD hc₁0 hc₂g hinj hWcomp hlift
    hu' hv' h𝔭' hne d hd
  classical
  obtain ⟨-, hnzd, -, hmax, -, -, hg0, huv, h𝔭eq, -⟩ := id hPD
  haveI := hnzd
  have hWA : ∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ≠ 0 := by
    intro w hw h0
    rw [Algebra.algebraMap_eq_smul_one] at h0
    rcases smul_eq_zero.mp h0 with h | h
    · exact hw h
    · exact one_ne_zero h
  have hinjA := IsFractionRing.injective A K
  have hWK : ∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0 := fun w hw h0 =>
    hWA w hw (hinjA (by rw [h0, map_zero]))
  have hC₁ := hWK c₁ hc₁0
  have hû : algebraMap A K u ≠ 0 := by
    intro h0
    apply hWK g hg0
    rw [← huv, map_mul, h0, zero_mul]
  obtain ⟨t, rfl⟩ := hc₂g
  have hus : algebraMap A K u =
      algebraMap A K (algebraMap ↥W A c₁) * wcLlsInnerS₁ W A K u c₁ := by
    unfold wcLlsInnerS₁
    rw [mul_div_cancel₀ _ hC₁]
  have hvs : algebraMap A K v =
      algebraMap A K (algebraMap ↥W A t) * wcLlsInnerS₂ W A K u c₂ := by
    unfold wcLlsInnerS₂
    have e := congrArg (algebraMap A K) huv
    simp only [map_mul] at e
    rw [eq_comm, mul_div_assoc', div_eq_iff hû]
    linear_combination -e

  have hex : ∀ z : K, z ∈ Algebra.adjoin A {wcLlsInnerS₁ W A K u c₁, wcLlsInnerS₂ W A K u c₂} →
      ∃ y : A', algebraMap A' K y = z := by
    intro z hz
    induction hz using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with rfl | rfl
      · exact ⟨u', hu'⟩
      · exact ⟨v', hv'⟩
    | algebraMap r => exact hlift r
    | add x₁ x₂ _ _ ih₁ ih₂ =>
      obtain ⟨y₁, h₁⟩ := ih₁
      obtain ⟨y₂, h₂⟩ := ih₂
      exact ⟨y₁ + y₂, by rw [map_add, h₁, h₂]⟩
    | mul x₁ x₂ _ _ ih₁ ih₂ =>
      obtain ⟨y₁, h₁⟩ := ih₁
      obtain ⟨y₂, h₂⟩ := ih₂
      exact ⟨y₁ * y₂, by rw [map_mul, h₁, h₂]⟩
  have hex' : ∀ x : ↥(wcLlsInnerCR W A K u c₁ c₂), ∃ y : A', algebraMap A' K y = (x : K) :=
    fun x => hex x.1 x.2
  choose f hf using hex'
  obtain ⟨ψ, hψ⟩ : ∃ ψ : ↥(wcLlsInnerCR W A K u c₁ c₂) →+* A',
      ∀ x, algebraMap A' K (ψ x) = (x : K) :=
    ⟨{ toFun := f
       map_one' := hinj (by rw [hf, map_one]; rfl)
       map_mul' := fun x y => hinj (by rw [hf, map_mul, hf, hf]; rfl)
       map_zero' := hinj (by rw [hf, map_zero]; rfl)
       map_add' := fun x y => hinj (by rw [hf, map_add, hf, hf]; rfl) }, hf⟩
  refine ⟨ψ d, hψ d, ?_⟩
  set j := algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) with hj
  set σ₁ : ↥(wcLlsInnerCR W A K u c₁ c₂) :=
    ⟨wcLlsInnerS₁ W A K u c₁, Algebra.subset_adjoin (Set.mem_insert _ _)⟩ with hσ₁
  set σ₂ : ↥(wcLlsInnerCR W A K u c₁ c₂) :=
    ⟨wcLlsInnerS₂ W A K u c₂,
      Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ with hσ₂
  have hσ₁v : (σ₁ : K) = wcLlsInnerS₁ W A K u c₁ := rfl
  have hσ₂v : (σ₂ : K) = wcLlsInnerS₂ W A K u c₂ := rfl
  set N : Ideal ↥(wcLlsInnerCR W A K u c₁ c₂) := Ideal.span {σ₁, σ₂} ⊔
    (IsLocalRing.maximalIdeal ↥W).map (j.comp (algebraMap ↥W A)) with hN
  have hdN : d ∉ N := hd
  have hσ₁N : σ₁ ∈ N := Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hσ₂N : σ₂ ∈ N := Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))

  have hdec : ∀ x : ↥(wcLlsInnerCR W A K u c₁ c₂), ∃ (a : A)
      (y z : ↥(wcLlsInnerCR W A K u c₁ c₂)), x = j a + σ₁ * y + σ₂ * z := by
    rintro ⟨z, hz⟩
    induction hz using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with rfl | rfl
      · exact ⟨0, 1, 0, Subtype.ext (by simp [hj, hσ₁v])⟩
      · exact ⟨0, 0, 1, Subtype.ext (by simp [hj, hσ₂v])⟩
    | algebraMap r =>
      exact ⟨r, 0, 0, Subtype.ext (by simp [hj])⟩
    | add x₁ x₂ hx₁ hx₂ ih₁ ih₂ =>
      obtain ⟨a₁, y₁, z₁, h₁⟩ := ih₁
      obtain ⟨a₂, y₂, z₂, h₂⟩ := ih₂
      refine ⟨a₁ + a₂, y₁ + y₂, z₁ + z₂, Subtype.ext ?_⟩
      have e₁ := congrArg Subtype.val h₁
      have e₂ := congrArg Subtype.val h₂
      simp only [hj, Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_algebraMap,
        map_add] at e₁ e₂ ⊢
      linear_combination e₁ + e₂
    | mul x₁ x₂ hx₁ hx₂ ih₁ ih₂ =>
      obtain ⟨a₁, y₁, z₁, h₁⟩ := ih₁
      obtain ⟨a₂, y₂, z₂, h₂⟩ := ih₂
      refine ⟨a₁ * a₂, y₁ * ⟨x₂, hx₂⟩ + j a₁ * y₂, z₁ * ⟨x₂, hx₂⟩ + j a₁ * z₂,
        Subtype.ext ?_⟩
      have e₁ := congrArg Subtype.val h₁
      have e₂ := congrArg Subtype.val h₂
      simp only [hj, Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_algebraMap,
        map_mul] at e₁ e₂ ⊢
      linear_combination x₂ * e₁ + (algebraMap A K a₁) * e₂

  have hpN : ∀ x ∈ 𝔭, j x ∈ N := by
    have hle : 𝔭 ≤ N.comap j := by
      rw [h𝔭eq]
      apply sup_le
      · rw [Ideal.span_le]
        intro x hx
        rcases hx with rfl | rfl
        · have e : j x = j (algebraMap ↥W A c₁) * σ₁ := by
            apply Subtype.ext
            simp only [hj, Subalgebra.coe_mul, Subalgebra.coe_algebraMap, hσ₁v]
            exact hus
          show j x ∈ N
          rw [e]
          exact Ideal.mul_mem_left _ _ hσ₁N
        · have e : j x = j (algebraMap ↥W A t) * σ₂ := by
            apply Subtype.ext
            simp only [hj, Subalgebra.coe_mul, Subalgebra.coe_algebraMap, hσ₂v]
            exact hvs
          show j x ∈ N
          rw [e]
          exact Ideal.mul_mem_left _ _ hσ₂N
      · rw [Ideal.map_le_iff_le_comap]
