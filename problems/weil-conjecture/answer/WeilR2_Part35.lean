  have presKey : ∀ (S B : Type u) [CommRing S] [CommRing B] [Algebra S B], Algebra.Etale S B →
      ∀ q : MvPolynomial (Fin 2) ↥W →+* S, Function.Surjective q → ∀ b₁ b₂ : B,
      ∃ (r₀ : ℕ) (val : Fin r₀ → B) (F : Fin r₀ → MvPolynomial (Fin r₀) (MvPolynomial (Fin 2) ↥W))
