    have hT3 : ∀ y ∈ Algebra.adjoin A {s}, (O ρ).valuation y ≤ 1 := by
      intro y hy
      induction hy using Algebra.adjoin_induction with
      | mem x hx => rw [Set.mem_singleton_iff.mp hx, hvs]; exact hr1.le
      | algebraMap r => exact hF1 r
      | add x y _ _ hx hy => exact (Valuation.map_add _ _ _).trans (max_le hx hy)
