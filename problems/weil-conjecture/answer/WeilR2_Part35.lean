              algebraMap R ↥(integralClosure R L) (d i) * θ₁ ^ i * θ₂ ^ (N - i)) -
              (∑ i ∈ Finset.range (N + 1),
                algebraMap R ↥(integralClosure R L) (p i) * θ₁ ^ i * θ₂ ^ (N - i)) ∈ 𝔔) →
          wcLlsRam R K L 𝔔 := by
    intro R _ _ _ _ 𝔓 𝔔 ψ₀ h𝔔 hco hU θ₁ θ₂ n r₁ r₂ hn hθ₁ hθ₂ hr₂ hrel hforms
    classical
    have hrootGen : ∀ (D : Type u) [CommRing D] [IsDomain D] (ψ : ↥W →+* D) (n : ℕ), 1 ≤ n →
        ∀ a b : D, b ≠ 0 → a ^ n = b ^ n → ∃ w : ↥W, a = ψ w * b := by
      intro D _ _ ψ n hn a b hb hab
      have hn0 : n ≠ 0 := by omega
      set p : Polynomial Ω := Polynomial.X ^ n - Polynomial.C 1 with hp
      have hpm : p.Monic := Polynomial.monic_X_pow_sub_C 1 hn0
      have hmemW : ∀ z ∈ p.roots, z ∈ W := by
        intro z hz
        have hz1 : z ^ n = 1 := by
          have := (Polynomial.mem_roots hpm.ne_zero).mp hz
          simpa [hp, sub_eq_zero] using this
        rcases W.mem_or_inv_mem z with h | h
        · exact h
        · have h1 : z * z ^ (n - 1) = 1 := by
            rw [← pow_succ', Nat.sub_add_cancel (by omega)]; exact hz1
          have : z = (z⁻¹) ^ (n - 1) := by
            rw [inv_pow]; exact eq_inv_of_mul_eq_one_left h1
          rw [this]; exact pow_mem h _
      have hfac : p = (p.roots.map (fun z => Polynomial.X - Polynomial.C z)).prod :=
        (IsAlgClosed.splits p).eq_prod_roots_of_monic hpm
      let lift : Ω → ↥W := fun z => if h : z ∈ W then ⟨z, h⟩ else 0
      have hlift : ∀ z ∈ p.roots, algebraMap ↥W Ω (lift z) = z := fun z hz => by
        show ((lift z : ↥W) : Ω) = z
        simp [lift, hmemW z hz]
      set s : Multiset ↥W := p.roots.map lift with hs
      have hfacW : (Polynomial.X ^ n - Polynomial.C 1 : Polynomial ↥W) =
          (s.map (fun w => Polynomial.X - Polynomial.C w)).prod := by
        apply Polynomial.map_injective (algebraMap ↥W Ω) Subtype.val_injective
        rw [Polynomial.map_multiset_prod]
        simp only [hs, Multiset.map_map, Function.comp_def, Polynomial.map_sub, Polynomial.map_X,
          Polynomial.map_C, Polynomial.map_pow]
        have hcongr : Multiset.map (fun x => Polynomial.X - Polynomial.C (algebraMap ↥W Ω (lift x)))
