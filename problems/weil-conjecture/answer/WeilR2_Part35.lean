        Q₀ ?_ ?_ ?_
      · intro m; rw [MvPolynomial.eval₂Hom_C]; exact hιS m
      · intro p1 p2 h1 h2; rw [map_add]; exact S₀.add_mem h1 h2
      · intro p1 i h1; rw [map_mul, MvPolynomial.eval₂Hom_X']; exact S₀.mul_mem h1 (htES i)
    have hsS : Ideal.Quotient.mk Irel (MvPolynomial.X (Sum.inr ())) ∈ S₀ :=
      hS₀inv _ _ (hevS _)
        ((mul_comm (Ideal.Quotient.mk Irel (MvPolynomial.X (Sum.inr ()))) _).symm.trans hevD)
    intro y
    obtain ⟨P0, rfl⟩ := Ideal.Quotient.mk_surjective y
    have hP0 : Ideal.Quotient.mk Irel P0 ∈ S₀ := by
      refine MvPolynomial.induction_on (motive := fun Q => Ideal.Quotient.mk Irel Q ∈ S₀)
        P0 ?_ ?_ ?_
      · intro m; rw [← hιC]; exact hιS m
      · intro p1 p2 h1 h2; rw [map_add]; exact S₀.add_mem h1 h2
      · intro p1 i h1
        rw [map_mul]
        refine S₀.mul_mem h1 ?_
        rcases i with w | ⟨⟩
        · have h2 := htES w; rw [htE] at h2; exact h2
        · exact hsS
    exact (hS₀mem _).mp hP0
  ·
    intro P _ _ φ x z ρ ρ' hcomap hxm hzm hxz hρ hφv hφu hlamP
    obtain ⟨ν, hνC, hν0, hν1⟩ := nodeHom β P (φ.comp (algebraMap ↥W A)) x z hxz
    have hνc₀ : ∀ w, ν (c₀ w) = φ (algebraMap ↥W A w) := by intro w; rw [hc₀]; exact hνC w
    have hφh : IsUnit (φ h) :=
      IsLocalRing.notMem_maximalIdeal.mp (fun hm => hh (by rw [← hcomap]; exact hm))
    have hφe : IsUnit (φ e) :=
      IsLocalRing.notMem_maximalIdeal.mp (fun hm => he (by rw [← hcomap]; exact hm))
    have hρu : IsUnit ρ := ⟨⟨ρ, ρ', hρ, (mul_comm _ _).trans hρ⟩, rfl⟩
    obtain ⟨φB, hφBdef⟩ : ∃ φB : Localization.Away h →+* P,
        φB = IsLocalization.Away.lift h hφh := ⟨_, rfl⟩
    have hφB : ∀ y, φB (algebraMap A (Localization.Away h) y) = φ y := by
      intro y; rw [hφBdef]; exact IsLocalization.Away.lift_eq h hφh y
    obtain ⟨t', ht'⟩ : ∃ t' : Fin r₀ ⊕ Fin 2 → P,
        t' = Sum.elim (fun i => φB (val i)) ![ρ, ρ'] := ⟨_, rfl⟩
    have ht'l : ∀ i, t' (Sum.inl i) = φB (val i) := by intro i; rw [ht']; rfl
    have ht'0 : t' (Sum.inr 0) = ρ := by rw [ht']; rfl
    have ht'1 : t' (Sum.inr 1) = ρ' := by rw [ht']; rfl
    have htw' := twEval P ν t' ((φB.comp f₀).comp q)
      (by intro w; rw [RingHom.comp_apply, RingHom.comp_apply, hqdef, hfCw, hφB, hνc₀])
      (by rw [RingHom.comp_apply, RingHom.comp_apply, hqdef]
          rw [show Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
            MvPolynomial.C g}) (MvPolynomial.X 0) = wcEbntX W g 0 from rfl, hfu, hφB, hφu, hν1, ht'1])
      (by rw [RingHom.comp_apply, RingHom.comp_apply, hqdef]
          rw [show Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
            MvPolynomial.C g}) (MvPolynomial.X 1) = wcEbntX W g 1 from rfl, hfv, hφB, hφv, hν0, ht'0])
    have htv : ∀ H, MvPolynomial.eval₂Hom ν t' (tw H) =
        MvPolynomial.eval₂Hom ((φB.comp f₀).comp q) (fun i => φB (val i)) H := by
      intro H; rw [htw' H]; simp only [ht'l]
    obtain ⟨hF0P, hdetP, he1P, he2P⟩ := hP1 P φB
    rw [← MvPolynomial.coe_eval₂Hom] at he1P he2P hdetP
    have hvan : ∀ j, MvPolynomial.eval₂Hom ν t' (fam j) = 0 := by
      refine Sum.forall.mpr ⟨fun j => ?_, Fin.forall_fin_two.mpr ⟨?_, ?_⟩⟩
      · rw [hfam_inl, htv]; exact hF0P j
      · rw [hfam0]
        simp only [map_sub, map_mul, map_one, MvPolynomial.eval₂Hom_X', ht'0, ht'1, hρ, sub_self]
      · rw [hfam1]
        simp only [map_sub, map_mul, map_add, map_one, map_sum, map_pow, MvPolynomial.eval₂Hom_C,
          MvPolynomial.eval₂Hom_X']
        rw [htv, htv, he1P, he2P, hφB, hφB, ht'0, hν0]
        simp only [hνc₀]
        exact sub_eq_zero.mpr hlamP
    have hjac := wcpa_dj_llsm_kpwicnec_jacobian ↥W (wcEbntN W β) c₀ (wcEbntX W β 0) (wcEbntX W β 1)
      p a n k (fun i => c₀ (γ i)) F e₁ e₂ lam tw fam hp hn hlam htw hfam
    have hmapI : Ideal.span {(MvPolynomial.C (wcEbntX W β 0) :
        MvPolynomial (Fin r₀ ⊕ Fin 2) (wcEbntN W β)), MvPolynomial.C (wcEbntX W β 1)} ≤
        (IsLocalRing.maximalIdeal P).comap (MvPolynomial.eval₂Hom ν t') := by
      rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
      refine ⟨?_, ?_⟩
      · exact Ideal.mem_comap.mpr (by rw [MvPolynomial.eval₂Hom_C, hν0]; exact hxm)
      · exact Ideal.mem_comap.mpr (by rw [MvPolynomial.eval₂Hom_C, hν1]; exact hzm)
    have hdiff := Ideal.mem_comap.mp (hmapI hjac)
    rw [map_sub, map_mul, map_neg, map_mul, MvPolynomial.eval₂Hom_X', htv, htv, he1P, hφB,
      ht'0] at hdiff
    have hU := hdetP.mul ((hρu.mul hφe).neg)
    have hDunit : IsUnit (MvPolynomial.eval₂Hom ν t'
        (Matrix.of fun i j => MvPolynomial.pderiv i (fam j)).det) := by
      by_contra hcon
      have hDm := (IsLocalRing.mem_maximalIdeal _).mpr hcon
      have h3 := (IsLocalRing.maximalIdeal P).sub_mem hDm hdiff
      rw [sub_sub_cancel] at h3
      exact (IsLocalRing.mem_maximalIdeal _).mp h3 hU
    have hlift : ∃ Φ : (MvPolynomial ((Fin r₀ ⊕ Fin 2) ⊕ Unit) (wcEbntN W β) ⧸ Irel) →+* P,
        (∀ m, Φ (Ideal.Quotient.mk Irel (MvPolynomial.C m)) = ν m) ∧
        ∀ i, Φ (Ideal.Quotient.mk Irel (MvPolynomial.X (Sum.inl i))) = t' i := by
      subst hIrel
      exact wcpa_dj_llsm_kpwicnec_ext_lift (wcEbntN W β) fam P ν t' hvan hDunit
    obtain ⟨Φ, hΦC, hΦX⟩ := hlift
    have hΦι : ∀ m, Φ (ι m) = ν m := by intro m; rw [hιC]; exact hΦC m
    have hΦt : ∀ v, Φ (tE v) = t' v := by intro v; rw [htE]; exact hΦX v
    refine ⟨Φ, ?_, ?_, ?_, ?_⟩
    · have hΦχ : Φ.comp χ = φB := by
        apply hP3 P (Φ.comp χ) φB
        · rw [RingHom.comp_assoc, hχf]
          apply Ideal.Quotient.ringHom_ext
          apply MvPolynomial.ringHom_ext
          · intro w
            simp only [RingHom.comp_apply]
            rw [hμC, RingHom.comp_apply, hΦι, hνc₀, hfCw, hφB]
          · refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
            · simp only [RingHom.comp_apply]
              rw [show Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
                MvPolynomial.C g}) (MvPolynomial.X 0) = wcEbntX W g 0 from rfl, hμ0, hfu, hφB, hφu,
                map_mul, map_pow, map_pow, hΦι, hΦt, hν1, ht'1]
            · simp only [RingHom.comp_apply]
              rw [show Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
                MvPolynomial.C g}) (MvPolynomial.X 1) = wcEbntX W g 1 from rfl, hμ1, hfv, hφB, hφv,
                map_mul, map_pow, map_pow, hΦι, hΦt, hν0, ht'0]
        · intro i; rw [RingHom.comp_apply, hχval, hΦt, ht'l]
      rw [hψdef, ← RingHom.comp_assoc, hΦχ, hφBdef]
      exact IsLocalization.Away.lift_comp h hφh
    · rw [hΦι, hν0]
    · rw [hΦι, hν1]
    · rw [hΦt, ht'0]

theorem wcpa_dj_llsm_kpwicn_local_identify : ∀ (A D : Type u) [CommRing A] [CommRing D] [IsDomain D] [Algebra A D] [Algebra.IsIntegral A D]
    (y : Ideal D) [y.IsPrime] (R : Type u) [CommRing R] (γ : R →+* Localization.AtPrime y) (N : Type u)
    [CommRing N] (ι : N →+* R) (jA : A →+* R), Function.Injective (γ.comp ι) →
    (∀ r : R, ∃ c : Polynomial N, c ≠ 0 ∧ c.eval₂ ι r = 0) →
    γ.comp jA = (algebraMap D (Localization.AtPrime y)).comp (algebraMap A D) →
    IsDomain (Localization.AtPrime ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)) →
    IsIntegrallyClosed (Localization.AtPrime ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)) →
    (∀ x : D, ∃ r s : R, γ s ≠ 0 ∧ γ s * algebraMap D (Localization.AtPrime y) x = γ r) →
    ∃ e : Localization.AtPrime ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ) ≃+*
      Localization.AtPrime y, ∀ r : R, e (algebraMap R _ r) = γ r :=
by
  intro A D _ _ _ _ _ y _ R _ γ N _ ι jA hinj halg hA hdom hnorm hbir
  haveI := hdom
  haveI := hnorm
  have hunit : ∀ t : ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ).primeCompl,
      IsUnit (γ t) := by
    intro t
    exact IsLocalRing.notMem_maximalIdeal.mp (fun h => t.2 (Ideal.mem_comap.mpr h))
  let γ' : Localization.AtPrime ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ) →+*
      Localization.AtPrime y := IsLocalization.lift hunit
  have h1 : ∀ r : R, γ' (algebraMap R _ r) = γ r := fun r => IsLocalization.lift_eq hunit r

  have h2 : ∀ w, IsUnit (γ' w) → IsUnit w := by
    intro w hw
    obtain ⟨⟨r, t⟩, rfl⟩ := IsLocalization.mk'_surjective
      ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ).primeCompl w
    dsimp only at hw ⊢
    have e : γ r = γ t * γ' (IsLocalization.mk' _ r t) :=
      (IsLocalization.lift_mk'_spec hunit r _ t).mp rfl
    have hr : IsUnit (γ r) := e ▸ (hunit t).mul hw
    rw [IsLocalization.AtPrime.isUnit_mk'_iff]
    intro hrQ
    exact (IsLocalRing.notMem_maximalIdeal.mpr hr) (Ideal.mem_comap.mp hrQ)

  have hinj' : Function.Injective γ' := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    by_contra hw0
    obtain ⟨⟨r, t⟩, hrt⟩ := IsLocalization.surj
      ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ).primeCompl w
    simp only at hrt
    have hρ0 : algebraMap R (Localization.AtPrime
        ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)) r ≠ 0 := by
      rw [← hrt]
      exact mul_ne_zero hw0 (IsLocalization.map_units _ t).ne_zero
    have hγρ : γ r = 0 := by rw [← h1, ← hrt, map_mul, hw, zero_mul]
    obtain ⟨c, hc0, hc⟩ := halg r
    obtain ⟨q, hcq, hndvd⟩ := Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd c hc0 0
    rw [map_zero, sub_zero] at hcq hndvd
    have hq0 : q.coeff 0 ≠ 0 := fun h => hndvd (Polynomial.X_dvd_iff.mpr h)
    have hev : Polynomial.eval₂ ((algebraMap R (Localization.AtPrime
        ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ))).comp ι)
        (algebraMap R _ r) q = 0 := by
      have e1 : Polynomial.eval₂ ((algebraMap R (Localization.AtPrime
          ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ))).comp ι)
          (algebraMap R _ r) c = 0 := by
        rw [← Polynomial.hom_eval₂, hc, map_zero]
      rw [hcq, Polynomial.eval₂_mul, Polynomial.eval₂_X_pow] at e1
      exact (mul_eq_zero.mp e1).resolve_left (pow_ne_zero _ hρ0)
    have e2 : γ' (Polynomial.eval₂ ((algebraMap R (Localization.AtPrime
        ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ))).comp ι)
        (algebraMap R _ r) q) = 0 := by rw [hev, map_zero]
    rw [Polynomial.hom_eval₂, h1, hγρ, Polynomial.eval₂_at_zero, RingHom.comp_apply,
      RingHom.comp_apply, h1] at e2
    exact hq0 (hinj (show (γ.comp ι) (q.coeff 0) = (γ.comp ι) 0 by rw [RingHom.map_zero]; exact e2))

  have hD : ∀ x : D, ∃ w, γ' w = algebraMap D (Localization.AtPrime y) x := by
    intro x
    obtain ⟨p, hpm, hpx⟩ := Algebra.IsIntegral.isIntegral (R := A) x
    obtain ⟨r, s, hs0, hrs⟩ := hbir x
    let jS : A →+* Localization.AtPrime
        ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ) :=
      (algebraMap R _).comp jA
    have hqm : (p.map jS).Monic := hpm.map jS
    have hcomp : γ'.comp jS = (algebraMap D (Localization.AtPrime y)).comp (algebraMap A D) := by
      ext a
      show γ' (algebraMap R _ (jA a)) = _
      rw [h1]
      exact RingHom.congr_fun hA a
    have ha : Polynomial.eval₂ γ' (algebraMap D _ x) (p.map jS) = 0 := by
      rw [Polynomial.eval₂_map, hcomp, ← Polynomial.hom_eval₂, hpx, map_zero]
    have hz : Polynomial.eval (algebraMap R (Localization.AtPrime ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)) r) ((p.map jS).scaleRoots (algebraMap R (Localization.AtPrime ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)) s)) = 0 := by
      apply hinj'
      rw [map_zero, ← Polynomial.eval₂_at_apply, h1 r, ← hrs, ← h1 s,
        Polynomial.scaleRoots_eval₂_mul, ha, mul_zero]
    have hs0' : algebraMap R (Localization.AtPrime
        ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)) s ≠ 0 :=
      fun h => hs0 (by rw [← h1, h, map_zero])
    have hsK : algebraMap (Localization.AtPrime ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)) (FractionRing (Localization.AtPrime
        ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)))
        (algebraMap R (Localization.AtPrime ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)) s) ≠ 0 := by
      intro h
      exact hs0' ((IsFractionRing.injective _ _) (h.trans (map_zero _).symm))
    obtain ⟨ξ, hξ⟩ : ∃ ξ : FractionRing (Localization.AtPrime
        ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)),
        algebraMap (Localization.AtPrime ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)) (FractionRing (Localization.AtPrime ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ))) (algebraMap R (Localization.AtPrime ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)) s) * ξ = algebraMap (Localization.AtPrime ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)) (FractionRing (Localization.AtPrime ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ))) (algebraMap R (Localization.AtPrime ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)) r) :=
      ⟨_, mul_div_cancel₀ _ hsK⟩
    have hc : Polynomial.eval₂ (algebraMap (Localization.AtPrime ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)) (FractionRing (Localization.AtPrime
        ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)))) ξ (p.map jS) = 0 := by
      have := Polynomial.scaleRoots_eval₂_mul (p := p.map jS) (algebraMap (Localization.AtPrime ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)) (FractionRing
        (Localization.AtPrime ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ))))
        ξ (algebraMap R (Localization.AtPrime ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)) s)
      rw [hξ, Polynomial.eval₂_at_apply, hz, map_zero] at this
      exact (mul_eq_zero.mp this.symm).resolve_left (pow_ne_zero _ hsK)
    have hint : IsIntegral (Localization.AtPrime
        ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)) ξ := ⟨p.map jS, hqm, hc⟩
    obtain ⟨w, hw⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    have hws : w * algebraMap R (Localization.AtPrime ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)) s = algebraMap R (Localization.AtPrime ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)) r := by
      apply IsFractionRing.injective _ (FractionRing (Localization.AtPrime
        ((IsLocalRing.maximalIdeal (Localization.AtPrime y)).comap γ)))
      rw [map_mul, hw, mul_comm, hξ]
    refine ⟨w, ?_⟩
    have := congrArg γ' hws
    rw [map_mul, h1, h1, ← hrs, mul_comm] at this
    exact mul_left_cancel₀ hs0 this

  have hsurj : Function.Surjective γ' := by
    intro z
    obtain ⟨⟨x, t⟩, rfl⟩ := IsLocalization.mk'_surjective y.primeCompl z
    dsimp only
    obtain ⟨wx, hwx⟩ := hD x
    obtain ⟨wt, hwt⟩ := hD t
    have hut : IsUnit wt := h2 wt (by rw [hwt]; exact IsLocalization.map_units _ t)
    refine ⟨wx * ↑hut.unit⁻¹, ?_⟩
    rw [map_mul, hwx, IsLocalization.mk'_eq_mul_mk'_one]
    congr 1
    have e1 : γ' (↑hut.unit⁻¹) * algebraMap D (Localization.AtPrime y) t = 1 := by
      rw [← hwt, ← map_mul, IsUnit.val_inv_mul, map_one]
    have e2 : IsLocalization.mk' (Localization.AtPrime y) (1 : D) t *
        algebraMap D (Localization.AtPrime y) t = 1 := by
      rw [IsLocalization.mk'_spec, map_one]
    exact (IsLocalization.map_units (Localization.AtPrime y) t).mul_left_inj.mp (e1.trans e2.symm)
  refine ⟨RingEquiv.ofBijective γ' ⟨hinj', hsurj⟩, fun r => ?_⟩
  exact h1 r

theorem wcpa_dj_llsm_kpwicn_fs_equiv : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A]
    (L : Type u) [Field L] [Algebra A L] (y : Ideal ↥(integralClosure A L)) [y.IsPrime],
    Nonempty (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y ≃+*
      (Localization.AtPrime y ⧸ (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap ↥(integralClosure A L) (Localization.AtPrime y)).comp
          ((algebraMap A ↥(integralClosure A L)).comp (algebraMap ↥W A))))) :=
by
  intro Ω _ W A _ _ L _ _ y _
  unfold wcLlsFS
  refine ⟨Ideal.quotEquivOfEq ?_⟩
  rw [← Ideal.map_map]
  congr 1
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro b ⟨w, hw, hb⟩
    have hbw : b = ((algebraMap A ↥(integralClosure A L)).comp (algebraMap ↥W A)) w :=
      Subtype.ext hb
    rw [hbw]
    exact Ideal.mem_map_of_mem _ hw
  · rw [Ideal.map_le_iff_le_comap]
    intro w hw
    exact Ideal.subset_span ⟨w, hw, rfl⟩

theorem wcpa_dj_llsm_kpwicn_kummer_denominators : ∀ (A : Type u) [CommRing A] [IsDomain A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K]
    (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] (ℓ : ℕ),
    ℓ.Prime → Module.finrank K L = ℓ → ∀ θ : L, θ ∉ Set.range (algebraMap K L) → ∀ x : L,
    ∃ (b : A) (a : ℕ → A), b ≠ 0 ∧ algebraMap A L b * x = ∑ i ∈ Finset.range ℓ, algebraMap A L (a i) * θ ^ i :=
by
  intro A _ _ K _ _ _ L _ _ _ _ _ ℓ hℓ hfr θ hθ x
  classical
  have hθint : IsIntegral K θ := IsIntegral.of_finite K θ
  have hdvd : (minpoly K θ).natDegree ∣ ℓ := hfr ▸ minpoly.degree_dvd hθint
  have hdeg : (minpoly K θ).natDegree = ℓ := by
    rcases hℓ.eq_one_or_self_of_dvd _ hdvd with h | h
    · exfalso
      apply hθ
      obtain ⟨y, hy⟩ := RingHom.mem_range.mp (minpoly.natDegree_eq_one_iff.mp h)
      exact ⟨y, hy⟩
    · exact h
  have htop : IntermediateField.adjoin K {θ} = ⊤ :=
    (Field.primitive_element_iff_minpoly_natDegree_eq K θ).mpr (hdeg.trans hfr.symm)
  have htop' : Algebra.adjoin K {θ} = ⊤ :=
    (IntermediateField.adjoin_simple_eq_top_iff_of_isAlgebraic hθint.isAlgebraic).mp htop
  have hx : x ∈ Algebra.adjoin K {θ} := by rw [htop']; exact Algebra.mem_top
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hx
  obtain ⟨p, hp⟩ := hx
  set q := p %ₘ minpoly K θ with hq
  have hqx : Polynomial.aeval θ q = x := by
    rw [hq, Polynomial.aeval_modByMonic_eq_self_of_root (minpoly.aeval K θ)]
    exact hp
  have hqdeg : q.natDegree < ℓ := by
    rw [← hdeg]
    exact Polynomial.natDegree_modByMonic_lt p (minpoly.monic hθint) (minpoly.ne_one K θ)
  have hxsum : x = ∑ i ∈ Finset.range ℓ, algebraMap K L (q.coeff i) * θ ^ i := by
    rw [← hqx, Polynomial.aeval_eq_sum_range' hqdeg]
    simp only [Algebra.smul_def]
  obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors A)
    (Finset.range ℓ) (fun i => q.coeff i)
