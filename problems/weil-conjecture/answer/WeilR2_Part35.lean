  have wcIL_uniform_exponent : ∀ (k : Type u) [Field k] (ℓ : ℕ), ℓ.Prime → ((ℓ : ℕ) : k) = 0 → ∀ (E : Type u) [CommRing E] [IsDomain E] (χ : LaurentPolynomial k →+* E), (letI := χ.toAlgebra; Module.Finite (LaurentPolynomial k) E) → (∀ x : E, ∃ (n : ℕ) (p q : LaurentPolynomial k), q ≠ 0 ∧ χ q * x ^ (ℓ ^ n) = χ p) → ∃ N : ℕ, ∀ x : E, ∃ (p q : LaurentPolynomial k), q ≠ 0 ∧ χ q * x ^ (ℓ ^ N) = χ p := by
    classical
    intro k _ ℓ hℓ hℓk E _ _ χ hfin hins
    haveI : Fact ℓ.Prime := ⟨hℓ⟩
    have hCE : CharP E ℓ := by
      have h : ((ℓ : ℕ) : E) = 0 := by
        rw [← map_natCast χ, ← map_natCast (LaurentPolynomial.C : k →+* LaurentPolynomial k), hℓk,
          map_zero, map_zero]
      exact (CharP.charP_iff_prime_eq_zero hℓ).mpr h
    haveI := hCE
    letI := χ.toAlgebra
    haveI : Module.Finite (LaurentPolynomial k) E := hfin
    obtain ⟨m, sgen, hspan⟩ := Module.Finite.exists_fin (R := LaurentPolynomial k) (M := E)
    choose n p q hq hpq using fun i => hins (sgen i)
    obtain ⟨N, hnN⟩ : ∃ N, ∀ i, n i ≤ N := ⟨Finset.univ.sup n, fun i => Finset.le_sup (Finset.mem_univ i)⟩
    have hgen : ∀ i, χ (q i ^ ℓ ^ (N - n i)) * sgen i ^ ℓ ^ N = χ (p i ^ ℓ ^ (N - n i)) := by
      intro i
      have e : ℓ ^ N = ℓ ^ n i * ℓ ^ (N - n i) := by rw [← pow_add, Nat.add_sub_cancel' (hnN i)]
      rw [e, pow_mul, map_pow, map_pow, ← mul_pow, hpq i]
    refine ⟨N, fun x => ?_⟩
    have hx : x ∈ Submodule.span (LaurentPolynomial k) (Set.range sgen) := by
      rw [hspan]; exact Submodule.mem_top
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun (LaurentPolynomial k)).mp hx
    refine ⟨∑ i, c i ^ ℓ ^ N * (∏ j ∈ Finset.univ.erase i, q j ^ ℓ ^ (N - n j)) * p i ^ ℓ ^ (N - n i),
      ∏ j, q j ^ ℓ ^ (N - n j), ?_, ?_⟩
    · exact Finset.prod_ne_zero_iff.mpr (fun j _ => pow_ne_zero _ (hq j))
    · rw [← hc]
      have hsmul : ∀ i, c i • sgen i = χ (c i) * sgen i := fun i => by rw [Algebra.smul_def]; rfl
      simp_rw [hsmul]
      rw [sum_pow_char_pow, Finset.mul_sum, map_sum]
      apply Finset.sum_congr rfl
      intro i _
      rw [← Finset.mul_prod_erase Finset.univ (fun j => q j ^ ℓ ^ (N - n j)) (Finset.mem_univ i)]
      calc χ ((fun j => q j ^ ℓ ^ (N - n j)) i * ∏ j ∈ Finset.univ.erase i, q j ^ ℓ ^ (N - n j)) *
            (χ (c i) * sgen i) ^ ℓ ^ N
          = χ (c i ^ ℓ ^ N * ∏ j ∈ Finset.univ.erase i, q j ^ ℓ ^ (N - n j)) *
            (χ (q i ^ ℓ ^ (N - n i)) * sgen i ^ ℓ ^ N) := by
            simp only [map_mul, map_pow, mul_pow]; ring
        _ = _ := by rw [hgen i, ← map_mul]

  have wcIL_derivation_linindep : ∀ (B : Type u) [CommRing B] [IsDomain B] (ℓ : ℕ), (∀ n : ℕ, 0 < n → n < ℓ → (n : B) ≠ 0) → ∀ (A : Subring B) (D : B →+ B), (∀ f g : B, D (f * g) = f * D g + g * D f) → (∀ a ∈ A, D a = 0) → ∀ s : B, D s ≠ 0 → ∀ a : Fin ℓ → B, (∀ i, a i ∈ A) → ∑ i : Fin ℓ, a i * s ^ (i : ℕ) = 0 → ∀ i, a i = 0 := by
    intro B _ _ ℓ hℓ A D hDl hDA s hDs a ha hsum
    have hD1 : ∀ i : ℕ, D (s ^ (i + 1)) = ((i : B) + 1) * s ^ i * D s := by
      intro i
      induction i with
      | zero => simp
      | succ i ih =>
        rw [pow_succ, hDl, ih]
        push_cast
        ring
    have hDas : ∀ (c : B), c ∈ A → ∀ i : ℕ, D (c * s ^ i) = c * D (s ^ i) := by
      intro c hc i
      rw [hDl, hDA c hc, mul_zero, add_zero]
    have key : ∀ m : ℕ, m ≤ ℓ → ∀ b : ℕ → B, (∀ i, b i ∈ A) →
        ∑ i ∈ Finset.range m, b i * s ^ i = 0 → ∀ i < m, b i = 0 := by
      intro m
      induction m with
      | zero => intro _ b _ _ i hi; exact absurd hi (Nat.not_lt_zero _)
      | succ m ih =>
        intro hm b hb hrel
        have h1 := congrArg D hrel
        rw [map_sum, map_zero, Finset.sum_range_succ'] at h1
        have h2 : D (b 0 * s ^ 0) = 0 := by rw [pow_zero, mul_one]; exact hDA _ (hb 0)
        rw [h2, add_zero] at h1
        have h3 : ∑ j ∈ Finset.range m, D (b (j + 1) * s ^ (j + 1)) =
            (∑ j ∈ Finset.range m, (((j : B) + 1) * b (j + 1)) * s ^ j) * D s := by
          rw [Finset.sum_mul]
          apply Finset.sum_congr rfl
          intro j _
          rw [hDas _ (hb _), hD1]
          ring
        rw [h3] at h1
        have h4 := (mul_eq_zero.mp h1).resolve_right hDs
        have h5 := ih (by omega) (fun j => ((j : B) + 1) * b (j + 1))
          (fun j => Subring.mul_mem _ (Subring.add_mem _ (natCast_mem A j) (Subring.one_mem A)) (hb _)) h4
        have h6 : ∀ j < m, b (j + 1) = 0 := by
          intro j hj
          have h7 := h5 j hj
          have hne : ((j : B) + 1) ≠ 0 := by
            have := hℓ (j + 1) (Nat.succ_pos j) (by omega)
            push_cast at this
            exact this
          exact (mul_eq_zero.mp h7).resolve_left hne
        have h7 : b 0 = 0 := by
          rw [Finset.sum_range_succ'] at hrel
          rw [Finset.sum_eq_zero (fun j hj => by rw [h6 j (Finset.mem_range.mp hj), zero_mul]),
            zero_add, pow_zero, mul_one] at hrel
          exact hrel
        intro i hi
        cases i with
        | zero => exact h7
        | succ j => exact h6 j (by omega)
    let b : ℕ → B := fun i => if h : i < ℓ then a ⟨i, h⟩ else 0
    have hb : ∀ i, b i ∈ A := by
      intro i
      simp only [b]
      split_ifs
      · exact ha _
      · exact Subring.zero_mem A
    have hrel : ∑ i ∈ Finset.range ℓ, b i * s ^ i = 0 := by
      rw [← hsum, ← Fin.sum_univ_eq_sum_range]
      apply Finset.sum_congr rfl
      intro i _
      simp only [b, dif_pos i.isLt]
    intro i
    have := key ℓ le_rfl b hb hrel i i.isLt
    simpa [b, dif_pos i.isLt] using this

  have wcIL_adjugate_step : ∀ (k : Type u) [Field k] (ℓ : ℕ), 0 < ℓ → (∀ f : LaurentPolynomial k, ∃ g : Fin ℓ → LaurentPolynomial k, f = ∑ r : Fin ℓ, (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((ℓ : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k) (g r) * LaurentPolynomial.T ((r : ℕ) : ℤ)) → ∀ (S : Subring (LaurentPolynomial k)), (∀ f : LaurentPolynomial k, (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((ℓ : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k) f ∈ S) → (∀ z c : LaurentPolynomial k, c ∈ S → c ≠ 0 → c * z ∈ S → z ∈ S) → ∀ s ∈ S, (∀ a : Fin ℓ → LaurentPolynomial k, ∑ i : Fin ℓ, (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((ℓ : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k) (a i) * s ^ (i : ℕ) = 0 → ∀ i, a i = 0) → ∀ z : LaurentPolynomial k, z ∈ S := by
    classical
    intro k _ ℓ hℓ hdec S hA hrel s hs hind
    set F := (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((ℓ : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k) with hF
    choose G hG using fun i : Fin ℓ => hdec (s ^ (i : ℕ))
    have hexp : ∀ w : Fin ℓ → LaurentPolynomial k, ∑ i, F (w i) * s ^ (i : ℕ) =
        ∑ r, F (∑ i, w i * G i r) * LaurentPolynomial.T ((r : ℕ) : ℤ) := by
      intro w
      calc ∑ i, F (w i) * s ^ (i : ℕ)
          = ∑ i, ∑ r, F (w i) * (F (G i r) * LaurentPolynomial.T ((r : ℕ) : ℤ)) := by
            apply Finset.sum_congr rfl; intro i _; rw [← Finset.mul_sum, ← hG i]
        _ = ∑ r, ∑ i, F (w i) * (F (G i r) * LaurentPolynomial.T ((r : ℕ) : ℤ)) := Finset.sum_comm
        _ = _ := by
            apply Finset.sum_congr rfl; intro r _
            rw [map_sum, Finset.sum_mul]
            apply Finset.sum_congr rfl; intro i _
            rw [map_mul, mul_assoc]
    let i0 : Fin ℓ := ⟨0, hℓ⟩
    have hFinj : ∀ x, F x = 0 → x = 0 := by
      intro x hx
      have h := hind (fun i => if i = i0 then x else 0) (by
        rw [Finset.sum_eq_single i0]
        · simp [hx]
        · intro b _ hb; simp [hb]
        · intro h; exact absurd (Finset.mem_univ _) h)
      simpa using h i0
    have hdet : (Matrix.of G).det ≠ 0 := by
      intro h0
      obtain ⟨v, hv0, hv⟩ := Matrix.exists_vecMul_eq_zero_iff.mpr h0
      apply hv0
      funext i
      refine hind v ?_ i
      rw [hexp]
      apply Finset.sum_eq_zero
      intro r _
      have h1 : ∑ i, v i * G i r = 0 := by
        have := congrFun hv r
        simpa [Matrix.vecMul, dotProduct] using this
      rw [h1, map_zero, zero_mul]
    have hc0 : F (Matrix.of G).det ≠ 0 := fun h => hdet (hFinj _ h)
    have hcS : F (Matrix.of G).det ∈ S := hA _
    have hT : ∀ r : Fin ℓ, LaurentPolynomial.T ((r : ℕ) : ℤ) ∈ S := by
      intro r
      have hadj := Matrix.adjugate_mul (Matrix.of G)
      have h2 : ∀ r', ∑ i, (Matrix.of G).adjugate r i * G i r' = if r = r' then (Matrix.of G).det else 0 := by
        intro r'
        have := congrFun (congrFun hadj r) r'
        rw [Matrix.mul_apply, Matrix.smul_apply, Matrix.one_apply] at this
        simp only [Matrix.of_apply] at this
        rw [this]
        split_ifs <;> simp
      have h1 : F (Matrix.of G).det * LaurentPolynomial.T ((r : ℕ) : ℤ) =
          ∑ i, F ((Matrix.of G).adjugate r i) * s ^ (i : ℕ) := by
        rw [hexp]
        simp_rw [h2]
        rw [Finset.sum_eq_single r]
        · rw [if_pos rfl]
        · intro b _ hb; rw [if_neg (Ne.symm hb), map_zero, zero_mul]
        · intro h; exact absurd (Finset.mem_univ r) h
      have hmem : F (Matrix.of G).det * LaurentPolynomial.T ((r : ℕ) : ℤ) ∈ S := by
        rw [h1]
        exact Subring.sum_mem _ (fun i _ => Subring.mul_mem _ (hA _) (Subring.pow_mem _ hs _))
      exact hrel _ _ hcS hc0 hmem
    intro z
    obtain ⟨g, hg⟩ := hdec z
    rw [hg]
    exact Subring.sum_mem _ (fun r _ => Subring.mul_mem _ (hA _) (hT r))

  intro k _ _ ℓ hℓ hℓk E _ _ _ χ hinj hfin hins
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : CharP k ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hℓk
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero
  obtain ⟨N, hN⟩ := wcIL_uniform_exponent k ℓ hℓ hℓk E χ hfin hins

  haveI : IsIntegrallyClosed (LaurentPolynomial k) :=
    isIntegrallyClosed_of_isLocalization (LaurentPolynomial k)
      (Submonoid.powers (Polynomial.X : Polynomial k))
      (powers_le_nonZeroDivisors_of_noZeroDivisors Polynomial.X_ne_zero)
  have hdesc : ∀ x : E, ∃ c : LaurentPolynomial k, χ c = x ^ (ℓ ^ N) := by
    intro x
    obtain ⟨p, q, hq, hpq⟩ := hN x
    letI := χ.toAlgebra
    haveI : Module.Finite (LaurentPolynomial k) E := hfin
    obtain ⟨P, hPm, hP⟩ := IsIntegral.of_finite (LaurentPolynomial k) (x ^ ℓ ^ N)
    exact wcIL_integral_descent _ _ χ hinj _ P hPm hP p q hq hpq
  have hFr := wcIL_frob_pow k ℓ
  obtain ⟨φ, hφinj, hφ⟩ := wcIL_frob_section k ℓ E χ hinj N (hFr N) hdesc
  obtain ⟨hD1, hD2, hD3, hD4, hD5, hD6, hD7⟩ := wcIL_dilate_basics k
  have hSA : ∀ f : LaurentPolynomial k, (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ N : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k) f ∈ φ.range :=
    fun f => ⟨χ f, hφ f⟩
  have hSrel : ∀ z c : LaurentPolynomial k, c ∈ φ.range → c ≠ 0 → c * z ∈ φ.range → z ∈ φ.range := by
    have hpow : ∀ z : LaurentPolynomial k, z ^ (ℓ ^ N) ∈ φ.range := by
      intro z
      rw [hFr N z]
      exact ⟨χ _, hφ _⟩
    intro z c hc hc0 hcz
    exact wcIL_range_relclosed _ _ φ hφinj (ℓ ^ N) (pow_pos hℓ.pos N) hpow z c hc hc0 hcz

  have hone : ∀ S' : Subring (LaurentPolynomial k), (∀ f : LaurentPolynomial k, (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((ℓ : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k) f ∈ S') → (∀ z c : LaurentPolynomial k, c ∈ S' → c ≠ 0 → c * z ∈ S' → z ∈ S') → ∀ s ∈ S', s ∉ (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((ℓ : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k).range → ∀ z : LaurentPolynomial k, z ∈ S' := by
    intro S' hS'A hS'rel s hs hsA
    obtain ⟨D, hDl, hDc⟩ := wcIL_theta_derivation k
    have hDA : ∀ a ∈ (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((ℓ : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k).range, D a = 0 := by
      intro a ha
      apply LaurentPolynomial.ext
      intro n
      rw [hDc]
      by_cases h : a.coeff n = 0
      · rw [h, mul_zero]; rfl
      · have h2 := (hD6 ℓ a hℓ0).mp ha n h
        rw [(CharP.intCast_eq_zero_iff k ℓ n).mpr h2, zero_mul]; rfl
    have hDs : D s ≠ 0 := by
      intro h0
      apply hsA
      rw [hD6 ℓ s hℓ0]
      intro n hn
      by_contra hnd
      have h1 : (D s).coeff n = 0 := by rw [h0]; rfl
      rw [hDc] at h1
      rcases mul_eq_zero.mp h1 with h | h
      · exact hnd ((CharP.intCast_eq_zero_iff k ℓ n).mp h)
      · exact hn h
    have hnz : ∀ n : ℕ, 0 < n → n < ℓ → (n : LaurentPolynomial k) ≠ 0 := by
      intro n hn0 hnl h
      have h1 : LaurentPolynomial.C (n : k) = LaurentPolynomial.C 0 := by
        rw [map_natCast, map_zero]; exact h
      have h2 : (n : k) = 0 := (LaurentPolynomial.C : k →+* LaurentPolynomial k).injective h1
      rw [CharP.cast_eq_zero_iff k ℓ] at h2
      exact absurd (Nat.le_of_dvd hn0 h2) (not_le.mpr hnl)
    have hindep : ∀ a : Fin ℓ → LaurentPolynomial k, ∑ i : Fin ℓ, (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((ℓ : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k) (a i) * s ^ (i : ℕ) = 0 → ∀ i, a i = 0 := by
      intro a ha i
      have h := wcIL_derivation_linindep (LaurentPolynomial k) ℓ hnz _ D hDl hDA s hDs
        (fun i => (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft ((ℓ : ℕ) : ℤ)) : LaurentPolynomial k →+* LaurentPolynomial k) (a i))
        (fun i => ⟨a i, rfl⟩) ha i
      exact hD3 ℓ hℓ0 (h.trans (map_zero _).symm)
    exact wcIL_adjugate_step k ℓ hℓ.pos (wcIL_residue_decomp k ℓ hℓ.pos) S' hS'A hS'rel s hs hindep
  have hM := wcIL_full_of_not_dvd k ℓ ⟨hD1, hD2, hD3, hD4, hD5, hD6, hD7⟩ hFr hone
  obtain ⟨j, -, hj⟩ := wcIL_subring_classify k ℓ ⟨hD1, hD2, hD3⟩ hM N φ.range hSA hSrel
  have hj0 : ℓ ^ j ≠ 0 := pow_ne_zero _ hℓ0
  set Fj := (AddMonoidAlgebra.mapDomainRingHom k (AddMonoidHom.mulLeft (((ℓ ^ j : ℕ) : ℤ))) : LaurentPolynomial k →+* LaurentPolynomial k) with hFj
  have hFjinj : Function.Injective Fj := hD3 _ hj0
  let ρ : E ≃+* φ.range := RingEquiv.ofBijective φ.rangeRestrict
    ⟨fun x y h => hφinj (congrArg Subtype.val h), φ.rangeRestrict_surjective⟩
  let τ : LaurentPolynomial k ≃+* Fj.range := RingEquiv.ofBijective Fj.rangeRestrict
    ⟨fun x y h => hFjinj (congrArg Subtype.val h), Fj.rangeRestrict_surjective⟩
  have hSeq : φ.range = Fj.range := Subring.ext hj
  refine ⟨ρ.trans ((RingEquiv.subringCongr hSeq).trans τ.symm), fun a => ?_⟩
  rw [RingEquiv.trans_apply, RingEquiv.trans_apply, RingEquiv.symm_apply_eq]
  apply Subtype.ext
  change φ (χ (LaurentPolynomial.C a)) = Fj (LaurentPolynomial.C a)
  rw [hφ, hD4, hFj, hD4]

theorem wcLlsVd_delta_zero_normal : ∀ (F : Type u) [CommRing F] [IsLocalRing F] [_root_.IsReduced F]
    [IsNoetherianRing F], wcpaDjLkDelta F = 0 → IsDomain F ∧ IsIntegrallyClosed F :=
by
  intro F _ _ _ _ hδ
  classical

  have H : ∀ x : FractionRing F, IsIntegral F x →
      ∃ y : F, algebraMap F (FractionRing F) y = x := by
    intro x hx
    have h1 := (Module.length_eq_zero_iff).mp hδ
    have h2 := Submodule.Quotient.subsingleton_iff.mp h1
    have h3 := LinearMap.range_eq_top.mp h2
    obtain ⟨y, hy⟩ := h3 ⟨x, (mem_integralClosure_iff F _).mpr hx⟩
    refine ⟨y, ?_⟩
    have := congrArg Subtype.val hy
    simpa using this
  have hinj : Function.Injective (algebraMap F (FractionRing F)) :=
    IsLocalization.injective (FractionRing F) le_rfl

  have hidem : ∀ e : FractionRing F, e * e = e → e = 0 ∨ e = 1 := by
    intro e he
    have hint : IsIntegral F e := by
      refine ⟨Polynomial.X ^ 2 - Polynomial.X, ?_, ?_⟩
      · exact Polynomial.monic_X_pow_sub (by rw [Polynomial.degree_X]; norm_num)
      · simp [Polynomial.eval₂_sub, sq, he]
    obtain ⟨f, hf⟩ := H e hint
    have hff : f * f = f := hinj (by rw [map_mul, hf, he])
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self f with hu | hu
    · right
      have : f = 1 := hu.mul_left_cancel (by rw [hff, mul_one])
      rw [← hf, this, map_one]
    · left
      have h0 : (1 - f) * f = (1 - f) * 0 := by rw [sub_mul, one_mul, hff, sub_self, mul_zero]
      have : f = 0 := hu.mul_left_cancel h0
      rw [← hf, this, map_zero]

  have hprime : ∀ q ∈ minimalPrimes F, q.IsPrime := fun q hq => Ideal.minimalPrimes_isPrime hq
  have hmin : ∀ q ∈ minimalPrimes F, ∀ q' ∈ minimalPrimes F, q ≤ q' → q = q' := by
    intro q hq q' hq' hle
    exact le_antisymm hle (hq'.2 ⟨hprime q hq, bot_le⟩ hle)
  have F3 : ∀ x : F, (∀ q ∈ minimalPrimes F, x ∈ q) → x = 0 := by
    intro x hx
    have hr : x ∈ (⊥ : Ideal F).radical := by
      rw [← Ideal.sInf_minimalPrimes]
      exact Submodule.mem_sInf.mpr hx
    obtain ⟨n, hn⟩ := hr
    exact _root_.IsReduced.eq_zero x ⟨n, Ideal.mem_bot.mp hn⟩
  have F4 : ∀ x : F, (∀ q ∈ minimalPrimes F, x ∉ q) → x ∈ nonZeroDivisors F := by
    intro x hx
    rw [mem_nonZeroDivisors_iff_right]
    intro y hy
    apply F3
    intro q hq
    have : y * x ∈ q := by rw [hy]; exact q.zero_mem
    exact ((hprime q hq).mem_or_mem this).resolve_right (hx q hq)

  have huniq : ∀ p₁ ∈ minimalPrimes F, ∀ p₂ ∈ minimalPrimes F, p₁ = p₂ := by
    intro p₁ hp₁ p₂ hp₂
    by_contra hne
    have hfin := minimalPrimes.finite_of_isNoetherianRing F
    set S := hfin.toFinset.erase p₁ with hS
    have hSmem : ∀ q ∈ S, q ∈ minimalPrimes F ∧ q ≠ p₁ := by
      intro q hq
      rw [hS, Finset.mem_erase, Set.Finite.mem_toFinset] at hq
      exact ⟨hq.2, hq.1⟩
    have hp₂S : p₂ ∈ S := by
      rw [hS, Finset.mem_erase, Set.Finite.mem_toFinset]
      exact ⟨Ne.symm hne, hp₂⟩
    have hall : ∀ q ∈ minimalPrimes F, q = p₁ ∨ q ∈ S := by
      intro q hq
      by_cases h : q = p₁
      · exact Or.inl h
      · right
        rw [hS, Finset.mem_erase, Set.Finite.mem_toFinset]
        exact ⟨h, hq⟩
    have hJ : ¬ (S.inf id ≤ p₁) := by
      rw [(hprime p₁ hp₁).inf_le']
      rintro ⟨q, hq, hle⟩
      exact (hSmem q hq).2 (hmin q (hSmem q hq).1 p₁ hp₁ hle)
    obtain ⟨a, haJ, hap⟩ := Set.not_subset.mp hJ
    have haq : ∀ q ∈ S, a ∈ q := fun q hq => (Finset.inf_le hq : S.inf id ≤ id q) haJ
    have hB : ¬ ((p₁ : Set F) ⊆ ⋃ i ∈ (S : Set (Ideal F)), ((id i : Ideal F) : Set F)) := by
      intro hsub
      obtain ⟨q, hq, hle⟩ := (Ideal.subset_union_prime (f := id) p₂ p₂
        (fun i hi _ _ => hprime i (hSmem i hi).1)).mp hsub
      exact (hSmem q hq).2 (hmin p₁ hp₁ q (hSmem q hq).1 hle).symm
    obtain ⟨b, hbp, hbS⟩ := Set.not_subset.mp hB
    have hbq : ∀ q ∈ S, b ∉ q := by
      intro q hq hbq
      apply hbS
      exact Set.mem_biUnion (Finset.mem_coe.mpr hq) hbq
    have hab : a * b = 0 := by
      apply F3
      intro q hq
      rcases hall q hq with rfl | h
      · exact q.mul_mem_left a hbp
      · exact q.mul_mem_right b (haq q h)
    have hs : a + b ∈ nonZeroDivisors F := by
      apply F4
      intro q hq hmem
      rcases hall q hq with rfl | h
      · exact hap ((Submodule.add_mem_iff_left _ hbp).mp hmem)
      · exact hbq q h ((Submodule.add_mem_iff_right _ (haq q h)).mp hmem)
    have ha0 : a ≠ 0 := fun h => hap (h ▸ p₁.zero_mem)
    have hb0 : b ≠ 0 := fun h => hbq p₂ hp₂S (h ▸ p₂.zero_mem)
    set e : FractionRing F := IsLocalization.mk' (FractionRing F) a
      (⟨a + b, hs⟩ : nonZeroDivisors F) with he
    have hee : e * e = e := by
      rw [he, ← IsLocalization.mk'_mul, IsLocalization.mk'_eq_iff_eq]
      congr 1
      show (a + b) * (a * a) = (a + b) * (a + b) * a
      linear_combination (-(a + b)) * hab
    rcases hidem e hee with h | h
    · rw [he, IsLocalization.mk'_eq_iff_eq_mul, zero_mul] at h
      exact ha0 (hinj (h.trans (map_zero _).symm))
    · rw [he, IsLocalization.mk'_eq_iff_eq_mul, one_mul] at h
      have h' : a = a + b := hinj h
      exact hb0 (by linear_combination -h')

  have hbot : (⊥ : Ideal F).IsPrime := by
    obtain ⟨p, hp, -⟩ := Ideal.exists_minimalPrimes_le (I := (⊥ : Ideal F))
      (J := IsLocalRing.maximalIdeal F) bot_le
    have hp' : p = ⊥ := by
      rw [eq_bot_iff]
      intro x hx
      rw [Ideal.mem_bot]
      exact F3 x (fun q hq => (huniq p hp q hq) ▸ hx)
    rw [← hp']
    exact hprime p hp
  haveI : IsDomain F := IsDomain.of_bot_isPrime F
  refine ⟨inferInstance, ?_⟩
  exact (isIntegrallyClosed_iff (FractionRing F)).mpr (fun hx => H _ hx)

theorem wcVdCf_laurent_inj : ∀ (k : Type u) [Field k] [IsAlgClosed k] (E : Type u) [CommRing E]
    [IsDomain E] (χ : LaurentPolynomial k →+* E),
    (∀ a : k, a ≠ 0 → χ (LaurentPolynomial.T 1 - LaurentPolynomial.C a) ≠ 0) →
    Function.Injective χ :=
by
  intro k _ _ E _ _ χ hχ
  rw [injective_iff_map_eq_zero]
  intro q hq
  by_contra hq0
  obtain ⟨n, f, hf⟩ := LaurentPolynomial.exists_T_pow q
  have hTu : IsUnit (LaurentPolynomial.T (n : ℤ) : LaurentPolynomial k) :=
    LaurentPolynomial.isUnit_T _
  have hf0 : f ≠ 0 := by
    rintro rfl
    rw [map_zero] at hf
    exact hq0 ((hTu.mul_left_eq_zero).mp hf.symm)
  have hψf : χ (Polynomial.toLaurent f) = 0 := by
    rw [hf, map_mul, hq, zero_mul]
  have hfac := Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C
    (IsAlgClosed.card_roots_eq_natDegree (k := k) (p := f))
  have hc : f.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hf0
  have hlin : ∀ a : k, χ (Polynomial.toLaurent (Polynomial.X - Polynomial.C a)) ≠ 0 := by
    intro a
    rw [map_sub, Polynomial.toLaurent_X, Polynomial.toLaurent_C]
    by_cases ha : a = 0
    · rw [ha, map_zero, sub_zero]
      exact ((LaurentPolynomial.isUnit_T 1).map χ).ne_zero
    · exact hχ a ha
  apply (show χ (Polynomial.toLaurent f) ≠ 0 from ?_) hψf
  rw [← hfac, map_mul, map_mul, map_multiset_prod, map_multiset_prod, Multiset.map_map,
    Multiset.map_map]
  refine mul_ne_zero ?_ ?_
  · rw [Polynomial.toLaurent_C]
    exact (((isUnit_iff_ne_zero.mpr hc).map LaurentPolynomial.C).map χ).ne_zero
  · apply Multiset.prod_ne_zero
    intro h0
    obtain ⟨a, _, ha⟩ := Multiset.mem_map.mp h0
    exact hlin a ha

theorem wcVdCf_B0_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A) (c₀ b₀ e' : ↥W),
    wcLlsPD W A 𝔭 (.disc t) →
    c₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 →
    (∀ x : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L), ∃ (N : ℕ)
      (y : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L)),
      (y : L) = algebraMap K L ((wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e')) ^ N) *
        (x : L)) ∧
    Module.Finite ↥(wcVdR0 W A K t c₀ b₀ e') ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t c₀ b₀ e' hPD hc₀ hb₀ hb₀0
  classical

  have s2 : ∀ (s v d : K), d ∈ Algebra.adjoin A {s} → d * v ∈ Algebra.adjoin A {s} →
      ∀ ρ ∈ Algebra.adjoin A {s, v}, ∃ M : ℕ, d ^ M * ρ ∈ Algebra.adjoin A {s} := by
    intro s v d hd hdv ρ hρ
    induction hρ using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with hx | hx
      · subst hx
        exact ⟨0, by rw [pow_zero, one_mul]; exact Algebra.subset_adjoin (Set.mem_singleton _)⟩
      · rw [Set.mem_singleton_iff] at hx
        subst hx
        exact ⟨1, by rw [pow_one]; exact hdv⟩
    | algebraMap r =>
      exact ⟨0, by rw [pow_zero, one_mul]; exact Subalgebra.algebraMap_mem _ r⟩
    | add x y _ _ hx hy =>
      obtain ⟨M, hM⟩ := hx
      obtain ⟨M', hM'⟩ := hy
      refine ⟨M + M', ?_⟩
      have e : d ^ (M + M') * (x + y) = d ^ M' * (d ^ M * x) + d ^ M * (d ^ M' * y) := by ring
      rw [e]
      exact add_mem (mul_mem (pow_mem hd _) hM) (mul_mem (pow_mem hd _) hM')
    | mul x y _ _ hx hy =>
      obtain ⟨M, hM⟩ := hx
      obtain ⟨M', hM'⟩ := hy
      refine ⟨M + M', ?_⟩
      have e : d ^ (M + M') * (x * y) = (d ^ M * x) * (d ^ M' * y) := by ring
      rw [e]
      exact mul_mem hM hM'

  have s3 : ∀ (R R₀ : Subalgebra A K) (d : K), R ≤ R₀ → d ∈ R →
      (∀ ρ ∈ R₀, ∃ M : ℕ, d ^ M * ρ ∈ R) →
      ∀ x : L, IsIntegral ↥R₀ x → ∃ N : ℕ, IsIntegral ↥R (algebraMap K L (d ^ N) * x) := by
    intro R R₀ d hle hd hcl x hx
    obtain ⟨p, hpm, hpx⟩ := hx
    choose Mf hMf using
      (fun i => hcl _ (p.coeff i).2 : ∀ i : ℕ, ∃ M : ℕ, d ^ M * ((p.coeff i : ↥R₀) : K) ∈ R)
    have mono : ∀ (ρ : K) (k k' : ℕ), k ≤ k' → d ^ k * ρ ∈ R → d ^ k' * ρ ∈ R := by
      intro ρ k k' hk h
      have e : d ^ k' * ρ = d ^ (k' - k) * (d ^ k * ρ) := by
        rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hk]
      rw [e]
      exact mul_mem (pow_mem hd _) h
    obtain ⟨M, hM⟩ : ∃ M : ℕ, M = ∑ i ∈ Finset.range p.natDegree, Mf i := ⟨_, rfl⟩
    obtain ⟨σ, hσ⟩ : ∃ σ : ↥R₀, (σ : K) = d ^ M := ⟨⟨d ^ M, pow_mem (hle hd) M⟩, rfl⟩
    have hcoe : ∀ i, (((p.scaleRoots σ).coeff i : ↥R₀) : K) =
        ((p.coeff i : ↥R₀) : K) * d ^ (M * (p.natDegree - i)) := by
      intro i
      rw [Polynomial.coeff_scaleRoots, MulMemClass.coe_mul, SubmonoidClass.coe_pow, hσ, pow_mul]
    have hmem : ∀ i, (((p.scaleRoots σ).coeff i : ↥R₀) : K) ∈ R := by
      intro i
      rw [hcoe i]
      rcases lt_trichotomy i p.natDegree with hi | hi | hi
      · rw [mul_comm]
        refine mono _ (Mf i) _ ?_ (hMf i)
        have hMi : Mf i ≤ M := by
          rw [hM]
          exact Finset.single_le_sum (fun j _ => Nat.zero_le (Mf j)) (Finset.mem_range.mpr hi)
        have h1 : 1 ≤ p.natDegree - i := by omega
        calc Mf i ≤ M := hMi
          _ = M * 1 := (mul_one M).symm
          _ ≤ M * (p.natDegree - i) := Nat.mul_le_mul_left M h1
      · subst hi
        rw [hpm.coeff_natDegree, Nat.sub_self, mul_zero, pow_zero, mul_one, OneMemClass.coe_one]
        exact one_mem R
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hi, ZeroMemClass.coe_zero, zero_mul]
        exact zero_mem R
    let f : ↥R →+* ↥R₀ := (Subalgebra.inclusion hle).toRingHom
    have hlift : p.scaleRoots σ ∈ Polynomial.lifts f := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      exact ⟨⟨_, hmem n⟩, Subtype.ext rfl⟩
    obtain ⟨q', hq'map, -, hq'm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift
      ((Polynomial.monic_scaleRoots_iff σ).mpr hpm)
    refine ⟨M, q', hq'm, ?_⟩
    have hcomp : algebraMap ↥R L = (algebraMap ↥R₀ L).comp f := RingHom.ext fun _ => rfl
    have hσL : algebraMap K L (d ^ M) = algebraMap ↥R₀ L σ := by
      rw [← hσ]; rfl
    rw [hcomp, ← Polynomial.eval₂_map, hq'map, hσL, Polynomial.scaleRoots_eval₂_mul, hpx, mul_zero]

  have finGen : ∀ (R R₀ : Subalgebra A K) (d v : K), R ≤ R₀ → v ∈ R₀ → v * d = 1 →
      (∀ x : ↥(integralClosure ↥R₀ L), ∃ (N : ℕ) (y : ↥(integralClosure ↥R L)),
        (y : L) = algebraMap K L (d ^ N) * (x : L)) →
      Module.Finite ↥R ↥(integralClosure ↥R L) →
      Module.Finite ↥R₀ ↥(integralClosure ↥R₀ L) := by
    intro R R₀ d v hle hv hvd hG hfin
    obtain ⟨T, hT⟩ := hfin.fg_top
    let ι0 : ↥R →+* ↥R₀ := (Subalgebra.inclusion hle).toRingHom
    have hι0 : (algebraMap ↥R₀ L).comp ι0 = (RingHom.id L).comp (algebraMap ↥R L) :=
      RingHom.ext fun _ => rfl
    let incl : ↥(integralClosure ↥R L) → ↥(integralClosure ↥R₀ L) := fun c =>
      ⟨(c : L), IsIntegral.map_of_comp_eq ι0 (RingHom.id L) hι0 c.2⟩
    refine ⟨⟨T.image incl, ?_⟩⟩
    rw [Submodule.eq_top_iff']
    intro x
    obtain ⟨N, y, hy⟩ := hG x
    have hyT : y ∈ Submodule.span ↥R (T : Set ↥(integralClosure ↥R L)) := by
      rw [hT]; exact Submodule.mem_top
    obtain ⟨g, -, hg⟩ := Submodule.mem_span_finset.mp hyT
    have hρ : ∀ c : ↥(integralClosure ↥R L), v ^ N * ((g c : ↥R) : K) ∈ R₀ :=
      fun c => mul_mem (pow_mem hv N) (hle (g c).2)
    have hg' : ∑ c ∈ T, algebraMap K L ((g c : ↥R) : K) * (c : L) = (y : L) := by
      rw [← hg, AddSubmonoidClass.coe_finset_sum]
      refine Finset.sum_congr rfl (fun c _ => ?_)
      rw [SetLike.val_smul, Algebra.smul_def] <;> rfl
    have e1 : ∀ c ∈ T, (((⟨_, hρ c⟩ : ↥R₀) • incl c : ↥(integralClosure ↥R₀ L)) : L) =
        algebraMap K L (v ^ N) * (algebraMap K L ((g c : ↥R) : K) * (c : L)) := by
      intro c _
      rw [SetLike.val_smul, Algebra.smul_def]
      show algebraMap K L (v ^ N * ((g c : ↥R) : K)) * (c : L) = _
      rw [map_mul, mul_assoc]
    have hz : x = ∑ c ∈ T, (⟨_, hρ c⟩ : ↥R₀) • incl c := by
      apply Subtype.ext
      rw [AddSubmonoidClass.coe_finset_sum, Finset.sum_congr rfl e1, ← Finset.mul_sum, hg', hy,
        ← mul_assoc, ← map_mul, ← mul_pow, hvd, one_pow, map_one, one_mul]
    rw [hz]
    exact Submodule.sum_mem _ (fun c hc => Submodule.smul_mem _ _
      (Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem incl hc))))

  have hb : algebraMap A K (algebraMap ↥W A b₀) ≠ 0 := by
    have h1 : algebraMap ↥W A b₀ ≠ 0 := by
      haveI := hPD.2.1
      rw [Algebra.algebraMap_eq_smul_one]
      intro h
      rcases smul_eq_zero.mp h with h | h
      · exact hb₀0 h
      · exact one_ne_zero h
    intro h
    apply h1
    exact (IsFractionRing.injective A K) (by rw [h, map_zero])
  have hδb : (wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e')) *
      algebraMap A K (algebraMap ↥W A b₀) = algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e')) := by
    unfold wcLlsScS
    rw [sub_mul, div_mul_cancel₀ _ hb]
    simp only [map_sub, map_add, map_mul]
    ring
  have hu : algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e')) ≠ 0 := by
    intro hu0
    have hδ0 : wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e') = 0 := by
      rw [hu0] at hδb
      exact (mul_eq_zero.mp hδb).resolve_right hb
    obtain ⟨-, h2, -⟩ := wcLlsKPms_chart_fibre Ω W A K 𝔭 t hPD c₀ b₀ hc₀ hb₀ hb₀0
    have h1 : (1 : A) ∉ 𝔭 := fun h => hPD.2.2.2.1.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    have key := h2 1 0 (Polynomial.X - Polynomial.C e') h1 (by
      rw [pow_zero, one_mul, Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C]
      convert Ideal.zero_mem _ using 1
      apply Subtype.ext
      first
        | exact hδ0
        | simpa using hδ0) 1
    rw [Polynomial.coeff_sub, Polynomial.coeff_X_one, Polynomial.coeff_C, if_neg one_ne_zero,
      sub_zero] at key
    exact (IsLocalRing.maximalIdeal.isMaximal ↥W).ne_top ((Ideal.eq_top_iff_one _).mpr key)
  have hVδ : wcLlsScV W A K t (c₀ + b₀ * e') b₀ *
      (wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e')) = 1 := by
    unfold wcLlsScV
    rw [div_mul_eq_mul_div, mul_comm (algebraMap A K (algebraMap ↥W A b₀)), hδb, div_self hu]

  have hle : Algebra.adjoin A {wcLlsScS W A K t c₀ b₀} ≤ wcVdR0 W A K t c₀ b₀ e' :=
    Algebra.adjoin_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _))
  have hV : wcLlsScV W A K t (c₀ + b₀ * e') b₀ ∈ wcVdR0 W A K t c₀ b₀ e' :=
    Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  have hδR : (wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e')) ∈
      Algebra.adjoin A {wcLlsScS W A K t c₀ b₀} :=
    sub_mem (Algebra.subset_adjoin (Set.mem_singleton _)) (Subalgebra.algebraMap_mem _ _)
  have hδV : (wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e')) *
      wcLlsScV W A K t (c₀ + b₀ * e') b₀ ∈ Algebra.adjoin A {wcLlsScS W A K t c₀ b₀} := by
    rw [mul_comm, hVδ]; exact one_mem _
  have hclear := s2 _ _ _ hδR hδV
  have hG : ∀ x : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L), ∃ (N : ℕ)
      (y : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L)),
      (y : L) = algebraMap K L ((wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e')) ^ N) *
        (x : L) := by
    intro x
    obtain ⟨N, hN⟩ := s3 _ _ _ hle hδR hclear (x : L) x.2
    exact ⟨N, ⟨_, hN⟩, rfl⟩
  exact ⟨hG, finGen _ _ _ _ hle hV hVδ hG
    (wcpa_dj_llsm_sd_normalization_finite Ω W hW hWt A K L 𝔭 (.disc t) hPD _)⟩

theorem wcVdCf_chi : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A) (c₀ b₀ e' : ↥W),
    wcLlsPD W A 𝔭 (.disc t) →
    c₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 →
    letI : CommRing (wcVdD W A K L t c₀ b₀ e') := wcVdD.commRing W A K L t c₀ b₀ e';
    ∃ χ : LaurentPolynomial (IsLocalRing.ResidueField ↥W) →+* wcVdD W A K L t c₀ b₀ e',
      (∀ (w : ↥W) (c : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L)),
        (c : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w)) →
        wcVdD.mk W A K L t c₀ b₀ e' c = χ (LaurentPolynomial.C (IsLocalRing.residue ↥W w))) ∧
      (∀ c : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L),
        (c : L) = algebraMap K L (wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e')) →
        wcVdD.mk W A K L t c₀ b₀ e' c = χ (LaurentPolynomial.T 1)) ∧
      (∀ (r : ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}))
          (c : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L)),
        (c : L) = algebraMap K L (r : K) →
        ∃ q : LaurentPolynomial (IsLocalRing.ResidueField ↥W),
          wcVdD.mk W A K L t c₀ b₀ e' c = χ q ∧
          (r ∉ (IsLocalRing.maximalIdeal ↥W).map
            ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})).comp (algebraMap ↥W A)) →
            q ≠ 0)) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t c₀ b₀ e' hPD hc₀ hb₀ hb₀0
  letI : CommRing (wcVdD W A K L t c₀ b₀ e') := wcVdD.commRing W A K L t c₀ b₀ e'
  classical
  obtain ⟨hFi, hFii, -⟩ := wcLlsKPms_chart_fibre Ω W A K 𝔭 t hPD c₀ b₀ hc₀ hb₀ hb₀0
  have hPD' := hPD
  unfold wcLlsPD at hPD'
  obtain ⟨-, hNZ, -, h𝔭max, -⟩ := hPD'
  haveI := hNZ
  set g₀ : ↥W →+* ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) :=
    (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})).comp (algebraMap ↥W A) with hg₀
  set sR : ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) :=
    ⟨wcLlsScS W A K t c₀ b₀, Algebra.subset_adjoin (Set.mem_singleton _)⟩ with hsR

  have hβ : algebraMap A K (algebraMap ↥W A b₀) ≠ 0 := by
    have h1 : algebraMap ↥W A b₀ ≠ 0 := by
      intro h
      rw [Algebra.algebraMap_eq_smul_one, smul_eq_zero] at h
      rcases h with h | h
      · exact hb₀0 h
      · exact one_ne_zero h
    exact (map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr h1
  have hδeq : algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e')) =
      algebraMap A K (t - algebraMap ↥W A c₀) -
        algebraMap A K (algebraMap ↥W A b₀) * algebraMap A K (algebraMap ↥W A e') := by
    simp only [map_sub, map_add, map_mul]
    ring
  have hSε : wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e') =
      algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e')) /
        algebraMap A K (algebraMap ↥W A b₀) := by
    rw [hδeq, eq_div_iff hβ]
    unfold wcLlsScS
    rw [sub_mul, div_mul_cancel₀ _ hβ]
    ring

  have hδ : algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e')) ≠ 0 := by
    intro h0
    have hz : sR - g₀ e' = 0 := by
      apply Subtype.ext
      show wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e') = 0
      rw [hSε, h0, zero_div]
    have hne : (1 : A) ∉ 𝔭 := fun h1 => h𝔭max.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
    have hmem : algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) 1 ^ 0 *
        Polynomial.eval₂ g₀ sR (Polynomial.X - Polynomial.C e') ∈
        (IsLocalRing.maximalIdeal ↥W).map g₀ := by
      rw [pow_zero, one_mul, Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C, hz]
      exact Ideal.zero_mem _
    have hc := hFii 1 0 (Polynomial.X - Polynomial.C e') hne hmem 1
    rw [Polynomial.coeff_sub, Polynomial.coeff_X_one, Polynomial.coeff_C, if_neg one_ne_zero,
      sub_zero] at hc
    exact (IsLocalRing.maximalIdeal.isMaximal ↥W).ne_top ((Ideal.eq_top_iff_one _).mpr hc)
  have hSV : (wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e')) *
      wcLlsScV W A K t (c₀ + b₀ * e') b₀ = 1 := by
    rw [hSε]
    unfold wcLlsScV
    field_simp

  let ι₀ : ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) →+*
      ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) :=
    (wcVdCfIota W A K L t c₀ b₀ e').comp
      (algebraMap _ ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L))
  have hι₀ : ∀ r : ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}),
      ((ι₀ r : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L)) : L) =
        algebraMap K L (r : K) := fun r => rfl
  let Ψ : ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) →+* wcVdD W A K L t c₀ b₀ e' :=
    (wcVdD.mk W A K L t c₀ b₀ e').comp ι₀
  let φW : ↥W →+* wcVdD W A K L t c₀ b₀ e' := Ψ.comp g₀
  have hK1 : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, φW w = 0 := by
    intro w hw
    show Ideal.Quotient.mk (wcVdJ0 W A K L t c₀ b₀ e') (ι₀ (g₀ w)) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem]
    apply Ideal.le_radical
    apply Ideal.subset_span
    exact ⟨w, hw, rfl⟩
  have hker : ∀ x ∈ (IsLocalRing.maximalIdeal ↥W).map g₀, Ψ x = 0 := by
    intro x hx
    have hle : (IsLocalRing.maximalIdeal ↥W).map g₀ ≤ RingHom.ker Ψ := by
      rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, RingHom.mem_ker]
      exact hK1 w hw
    exact hle hx

  let vB : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) :=
    algebraMap ↥(wcVdR0 W A K t c₀ b₀ e') _
      ⟨wcLlsScV W A K t (c₀ + b₀ * e') b₀,
        Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩
  have hvB : (vB : L) = algebraMap K L (wcLlsScV W A K t (c₀ + b₀ * e') b₀) := rfl
  have hunitB : ι₀ (sR - g₀ e') * vB = 1 := by
    apply Subtype.ext
    rw [MulMemClass.coe_mul, hι₀, hvB, OneMemClass.coe_one, ← map_mul]
    rw [show ((sR - g₀ e' : ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})) : K) =
      wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e') from rfl, hSV, map_one]
  have hτσ : Ψ (sR - g₀ e') * wcVdD.mk W A K L t c₀ b₀ e' vB = 1 := by
    show wcVdD.mk W A K L t c₀ b₀ e' (ι₀ (sR - g₀ e')) * wcVdD.mk W A K L t c₀ b₀ e' vB = 1
    rw [← map_mul, hunitB, map_one]
  let u : (wcVdD W A K L t c₀ b₀ e')ˣ :=
    ⟨Ψ (sR - g₀ e'), wcVdD.mk W A K L t c₀ b₀ e' vB, hτσ, by rw [mul_comm]; exact hτσ⟩

  let ι : IsLocalRing.ResidueField ↥W →+* wcVdD W A K L t c₀ b₀ e' :=
    Ideal.Quotient.lift (IsLocalRing.maximalIdeal ↥W) φW hK1
  have hι : ∀ w : ↥W, ι (IsLocalRing.residue ↥W w) = φW w := fun w => rfl
  have h4 : ι.comp (IsLocalRing.residue ↥W) = φW := RingHom.ext hι
  refine ⟨LaurentPolynomial.eval₂ ι u, ?_, ?_, ?_⟩
  ·
    intro w c hc
    have hcw : c = ι₀ (g₀ w) := Subtype.ext hc
    rw [hcw, LaurentPolynomial.eval₂_C, hι]
    rfl
  ·
    intro c hc
    have hcs : c = ι₀ (sR - g₀ e') := Subtype.ext hc
    rw [hcs, LaurentPolynomial.eval₂_T, zpow_one]
    rfl
  ·
    intro r c hc
    have hcr : c = ι₀ r := Subtype.ext hc
    obtain ⟨f, hf⟩ := hFi r
    refine ⟨Polynomial.toLaurent ((f.map (IsLocalRing.residue ↥W)).comp
      (Polynomial.X + Polynomial.C (IsLocalRing.residue ↥W e'))), ?_, ?_⟩
    · have h1 : Ψ r = Ψ (Polynomial.eval₂ g₀ sR f) := by
        rw [← sub_eq_zero, ← map_sub]
        exact hker _ hf
      have h2 : Ψ (Polynomial.eval₂ g₀ sR f) = Polynomial.eval₂ φW (Ψ sR) f :=
        Polynomial.hom_eval₂ f g₀ Ψ sR
      have h3 : (u : wcVdD W A K L t c₀ b₀ e') + φW e' = Ψ sR := by
        show Ψ (sR - g₀ e') + Ψ (g₀ e') = Ψ sR
        rw [← map_add, sub_add_cancel]
      rw [hcr]
      show Ψ r = _
      rw [h1, h2, LaurentPolynomial.eval₂_toLaurent, Polynomial.eval₂_comp, Polynomial.eval₂_add,
        Polynomial.eval₂_X, Polynomial.eval₂_C, Polynomial.eval₂_map, h4, hι e', h3]
    · intro hr hq
      rw [Polynomial.toLaurent_eq_zero, Polynomial.comp_X_add_C_eq_zero_iff] at hq
      have hcoef : ∀ i, f.coeff i ∈ IsLocalRing.maximalIdeal ↥W := by
        intro i
        have h := congrArg (fun p => Polynomial.coeff p i) hq
        simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h
        exact (IsLocalRing.residue_eq_zero_iff _).mp h
      apply hr
      have hev : Polynomial.eval₂ g₀ sR f ∈ (IsLocalRing.maximalIdeal ↥W).map g₀ := by
        rw [Polynomial.eval₂_eq_sum_range]
        apply Ideal.sum_mem
        intro i _
        exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem g₀ (hcoef i))
      have hsum := Ideal.add_mem _ hf hev
      rwa [sub_add_cancel] at hsum

theorem wcVdCf_finite_noeth : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A) (c₀ b₀ e' : ↥W),
    wcLlsPD W A 𝔭 (.disc t) →
    c₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 →
    Module.Finite ↥(wcVdR0 W A K t c₀ b₀ e') ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) →
    letI : CommRing (wcVdD W A K L t c₀ b₀ e') := wcVdD.commRing W A K L t c₀ b₀ e';
    ∀ χ : LaurentPolynomial (IsLocalRing.ResidueField ↥W) →+* wcVdD W A K L t c₀ b₀ e',
      (∀ (w : ↥W) (c : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L)),
        (c : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w)) →
        wcVdD.mk W A K L t c₀ b₀ e' c = χ (LaurentPolynomial.C (IsLocalRing.residue ↥W w))) →
      (∀ c : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L),
        (c : L) = algebraMap K L (wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e')) →
        wcVdD.mk W A K L t c₀ b₀ e' c = χ (LaurentPolynomial.T 1)) →
      (∀ (r : ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}))
          (c : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L)),
        (c : L) = algebraMap K L (r : K) →
        ∃ q : LaurentPolynomial (IsLocalRing.ResidueField ↥W),
          wcVdD.mk W A K L t c₀ b₀ e' c = χ q ∧
          (r ∉ (IsLocalRing.maximalIdeal ↥W).map
            ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})).comp (algebraMap ↥W A)) →
            q ≠ 0)) →
      χ.Finite ∧ IsNoetherianRing (wcVdD W A K L t c₀ b₀ e') :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t c₀ b₀ e' hPD hc₀ hb₀ hb₀0 hfin
  letI : CommRing (wcVdD W A K L t c₀ b₀ e') := wcVdD.commRing W A K L t c₀ b₀ e'
  intro χ hC1 hC2 hC3
  classical

  have hφ : ((wcVdD.mk W A K L t c₀ b₀ e').comp (algebraMap ↥(wcVdR0 W A K t c₀ b₀ e')
      ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L))).Finite :=
    RingHom.Finite.comp (RingHom.Finite.of_surjective _ Ideal.Quotient.mk_surjective)
      (RingHom.finite_algebraMap.mpr hfin)

  have hrange : ∀ (x : K) (hx : x ∈ wcVdR0 W A K t c₀ b₀ e'),
      ∃ q : LaurentPolynomial (IsLocalRing.ResidueField ↥W),
        χ q = wcVdD.mk W A K L t c₀ b₀ e' (algebraMap ↥(wcVdR0 W A K t c₀ b₀ e')
          ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) ⟨x, hx⟩) := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hxs =>
      rcases hxs with h | h
      · subst h
        refine (hC3 ⟨wcLlsScS W A K t c₀ b₀,
          Algebra.subset_adjoin (Set.mem_singleton _)⟩ _ ?_).imp fun q hq => hq.1.symm
        rfl
      · rw [Set.mem_singleton_iff] at h
        subst h
        by_cases hV : wcLlsScV W A K t (c₀ + b₀ * e') b₀ = 0
        · refine ⟨0, ?_⟩
          have h0 : (⟨wcLlsScV W A K t (c₀ + b₀ * e') b₀, Algebra.subset_adjoin
              (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ : ↥(wcVdR0 W A K t c₀ b₀ e')) = 0 :=
            Subtype.ext hV
          rw [h0, map_zero, map_zero, map_zero]
        · have hF : wcLlsScV W A K t (c₀ + b₀ * e') b₀ *
              (wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e')) = 1 := by
            have hV' := hV
            unfold wcLlsScV at hV' ⊢
            unfold wcLlsScS
            rw [div_eq_zero_iff, not_or] at hV'
            obtain ⟨hb, hτ⟩ := hV'
            simp only [map_sub, map_add, map_mul] at hτ ⊢
            field_simp
            ring
          have hS : wcLlsScS W A K t c₀ b₀ ∈ wcVdR0 W A K t c₀ b₀ e' :=
            Algebra.subset_adjoin (Set.mem_insert _ _)
          have hT := hC2 (algebraMap ↥(wcVdR0 W A K t c₀ b₀ e')
              ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L)
              (⟨wcLlsScS W A K t c₀ b₀, hS⟩ - algebraMap A ↥(wcVdR0 W A K t c₀ b₀ e')
                (algebraMap ↥W A e'))) rfl
          have hprod : algebraMap ↥(wcVdR0 W A K t c₀ b₀ e')
              ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L)
              ⟨wcLlsScV W A K t (c₀ + b₀ * e') b₀, Algebra.subset_adjoin
                (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ *
              algebraMap ↥(wcVdR0 W A K t c₀ b₀ e')
              ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L)
              (⟨wcLlsScS W A K t c₀ b₀, hS⟩ - algebraMap A ↥(wcVdR0 W A K t c₀ b₀ e')
                (algebraMap ↥W A e')) = 1 := by
            rw [← map_mul, ← map_one (algebraMap ↥(wcVdR0 W A K t c₀ b₀ e')
              ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L))]
            congr 1
            exact Subtype.ext hF
          have h1 := congrArg (wcVdD.mk W A K L t c₀ b₀ e') hprod
          rw [map_mul, map_one, hT] at h1
          have hTT : χ (LaurentPolynomial.T 1) * χ (LaurentPolynomial.T (-1)) = 1 := by
            rw [← map_mul, ← LaurentPolynomial.T_add]
            norm_num [LaurentPolynomial.T_zero]
          refine ⟨LaurentPolynomial.T (-1), ?_⟩
          calc χ (LaurentPolynomial.T (-1))
              = (wcVdD.mk W A K L t c₀ b₀ e' (algebraMap ↥(wcVdR0 W A K t c₀ b₀ e')
                  ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L)
                  ⟨wcLlsScV W A K t (c₀ + b₀ * e') b₀, Algebra.subset_adjoin
                    (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩) *
                  χ (LaurentPolynomial.T 1)) * χ (LaurentPolynomial.T (-1)) := by
                rw [h1, one_mul]
            _ = _ := by rw [mul_assoc, hTT, mul_one]
    | algebraMap r =>
      refine (hC3 (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) r) _ ?_).imp
        fun q hq => hq.1.symm
      rfl
    | add x y hx hy ihx ihy =>
      obtain ⟨q₁, h₁⟩ := ihx
      obtain ⟨q₂, h₂⟩ := ihy
      refine ⟨q₁ + q₂, ?_⟩
      show _ = wcVdD.mk W A K L t c₀ b₀ e' (algebraMap ↥(wcVdR0 W A K t c₀ b₀ e')
          ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) (⟨x, hx⟩ + ⟨y, hy⟩))
      rw [map_add, map_add, map_add, h₁, h₂]
    | mul x y hx hy ihx ihy =>
      obtain ⟨q₁, h₁⟩ := ihx
      obtain ⟨q₂, h₂⟩ := ihy
      refine ⟨q₁ * q₂, ?_⟩
      show _ = wcVdD.mk W A K L t c₀ b₀ e' (algebraMap ↥(wcVdR0 W A K t c₀ b₀ e')
          ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) (⟨x, hx⟩ * ⟨y, hy⟩))
      rw [map_mul, map_mul, map_mul, h₁, h₂]

  have hmem : ∀ ρ : ↥(wcVdR0 W A K t c₀ b₀ e'),
      ((wcVdD.mk W A K L t c₀ b₀ e').comp (algebraMap ↥(wcVdR0 W A K t c₀ b₀ e')
        ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L))) ρ ∈ χ.range := by
    intro ρ
    obtain ⟨q, hq⟩ := hrange ρ.1 ρ.2
    exact ⟨q, hq⟩
  have hsub : χ.range.subtype.Finite := by
    have e1 : (wcVdD.mk W A K L t c₀ b₀ e').comp (algebraMap ↥(wcVdR0 W A K t c₀ b₀ e')
        ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L)) =
        χ.range.subtype.comp (RingHom.codRestrict _ χ.range hmem) := RingHom.ext fun _ => rfl
    rw [e1] at hφ
    exact RingHom.Finite.of_comp_finite hφ
  have hχ : χ.Finite := by
    have e2 : χ = χ.range.subtype.comp χ.rangeRestrict := RingHom.ext fun _ => rfl
    rw [e2]
    exact hsub.comp (RingHom.Finite.of_surjective _ χ.rangeRestrict_surjective)
  refine ⟨hχ, ?_⟩
  letI := χ.toAlgebra
  haveI : Module.Finite (LaurentPolynomial (IsLocalRing.ResidueField ↥W))
      (wcVdD W A K L t c₀ b₀ e') := hχ
  haveI : IsNoetherianRing (LaurentPolynomial (IsLocalRing.ResidueField ↥W)) :=
    IsLocalization.isNoetherianRing
      (Submonoid.powers (Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W)))
      (LaurentPolynomial (IsLocalRing.ResidueField ↥W)) inferInstance
  exact IsNoetherianRing.of_finite (LaurentPolynomial (IsLocalRing.ResidueField ↥W)) _

theorem wcpa_dj_llsm_nrt_residue_surj : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (B : Type u) [CommRing B] [Algebra ↥W B], Algebra.FiniteType ↥W B →
    ∀ (D : Type u) [CommRing D] [Algebra B D], Algebra.FiniteType B D →
    ∀ (N : Ideal D), N.IsMaximal →
    (IsLocalRing.maximalIdeal ↥W).map ((algebraMap B D).comp (algebraMap ↥W B)) ≤ N →
    ∀ (S : Type u) [CommRing S] [Algebra D S] [Algebra.IsIntegral D S] (Q : Ideal S), Q.IsPrime →
    Q.comap (algebraMap D S) = N →
    ∀ x : S, ∃ w : ↥W, x - algebraMap D S (algebraMap B D (algebraMap ↥W B w)) ∈ Q :=
by
  intro Ω _ _ W B _ _ hB D _ _ hD N hN hmN S _ _ _ Q hQ hQN x
  classical
  let f₁ : ↥W →+* D := (algebraMap B D).comp (algebraMap ↥W B)
  letI : Algebra ↥W D := f₁.toAlgebra
  have hFT : Algebra.FiniteType ↥W D := by
    have h1 : (algebraMap ↥W B).FiniteType := RingHom.finiteType_algebraMap.mpr hB
    have h2 : (algebraMap B D).FiniteType := RingHom.finiteType_algebraMap.mpr hD
    exact RingHom.finiteType_algebraMap.mp (h2.comp h1)
  have hsurjD : ∀ a : D, ∃ w : ↥W, a - algebraMap ↥W D w ∈ N :=
    wcpa_dj_llsm_kptf_residue_trivial Ω W D N hFT hN hmN
  have hH : ∀ a ∈ IsLocalRing.maximalIdeal ↥W, (Ideal.Quotient.mk N).comp f₁ a = 0 := by
    intro a ha
    rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
    exact hmN (Ideal.mem_map_of_mem _ ha)
  let ψ : IsLocalRing.ResidueField ↥W →+* D ⧸ N :=
    Ideal.Quotient.lift (IsLocalRing.maximalIdeal ↥W) ((Ideal.Quotient.mk N).comp f₁) hH
  have hψ : ∀ w : ↥W, ψ (IsLocalRing.residue ↥W w) = Ideal.Quotient.mk N (f₁ w) := by
    intro w
    exact Ideal.Quotient.lift_mk _ _ _
  have hψsurj : Function.Surjective ψ := by
    intro y
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨w, hw⟩ := hsurjD a
    refine ⟨IsLocalRing.residue ↥W w, ?_⟩
    rw [hψ, Ideal.Quotient.eq]
    have h := N.neg_mem hw
    rw [neg_sub] at h
    exact h
  have hg : (algebraMap D S).IsIntegral := algebraMap_isIntegral_iff.mpr inferInstance
  have hβ : ∀ (I : Ideal D) (h : I = Q.comap (algebraMap D S)),
      (Ideal.quotientMap Q (algebraMap D S) (le_of_eq h) : D ⧸ I →+* S ⧸ Q).IsIntegral := by
    rintro I rfl
    exact RingHom.IsIntegral.quotient (algebraMap D S) hg
  let β : D ⧸ N →+* S ⧸ Q := Ideal.quotientMap Q (algebraMap D S) (le_of_eq hQN.symm)
  have hβi : β.IsIntegral := hβ N hQN.symm
  haveI := hQ
  haveI : IsAlgClosed (IsLocalRing.ResidueField ↥W) := wcpa_dj_nc_residue_algclosed Ω W
  have hbij := IsAlgClosed.ringHom_bijective_of_isIntegral (β.comp ψ)
    (RingHom.IsIntegral.trans ψ β (RingHom.isIntegral_of_surjective ψ hψsurj) hβi)
  obtain ⟨r, hr⟩ := hbij.2 (Ideal.Quotient.mk Q x)
  obtain ⟨w, rfl⟩ := IsLocalRing.residue_surjective r
  refine ⟨w, ?_⟩
  rw [← Ideal.Quotient.eq, ← hr, RingHom.comp_apply, hψ]
  exact Ideal.quotientMap_mk

theorem wcVdCf_max_over : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A) (c₀ b₀ e' : ↥W),
    wcLlsPD W A 𝔭 (.disc t) →
    c₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 →
    letI : CommRing (wcVdD W A K L t c₀ b₀ e') := wcVdD.commRing W A K L t c₀ b₀ e';
    ∀ (𝔐 : Ideal (wcVdD W A K L t c₀ b₀ e')), 𝔐.IsMaximal →
      ∃ e : ↥W, e - e' ∉ IsLocalRing.maximalIdeal ↥W ∧
        (𝔐.comap ((wcVdD.mk W A K L t c₀ b₀ e').comp (wcVdCfIota W A K L t c₀ b₀ e'))).comap
          (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L)) =
        Ideal.span {⟨wcLlsScS W A K t c₀ b₀, Algebra.subset_adjoin (Set.mem_singleton _)⟩ -
          algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) (algebraMap ↥W A e)} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})).comp (algebraMap ↥W A)) :=
by
  intro Ω _ _ W hdim hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t c₀ b₀ e' hPD hc₀ hb₀ hb₀0
  letI : CommRing (wcVdD W A K L t c₀ b₀ e') := wcVdD.commRing W A K L t c₀ b₀ e'
  intro 𝔐 h𝔐
  classical

  let cst : ↥W →+* ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) :=
    (algebraMap ↥(wcVdR0 W A K t c₀ b₀ e') ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L)).comp
      ((algebraMap A ↥(wcVdR0 W A K t c₀ b₀ e')).comp (algebraMap ↥W A))

  let xS : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) :=
    wcVdCfIota W A K L t c₀ b₀ e'
      (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L)
        ⟨wcLlsScS W A K t c₀ b₀, Algebra.subset_adjoin (Set.mem_singleton _)⟩)
  let v : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) :=
    algebraMap ↥(wcVdR0 W A K t c₀ b₀ e') ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L)
      ⟨wcLlsScV W A K t (c₀ + b₀ * e') b₀,
        Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩

  have hmk_surj : Function.Surjective (wcVdD.mk W A K L t c₀ b₀ e') :=
    Ideal.Quotient.mk_surjective
  haveI := h𝔐
  have h𝔐' : (𝔐.comap (wcVdD.mk W A K L t c₀ b₀ e')).IsMaximal :=
    Ideal.comap_isMaximal_of_surjective _ hmk_surj
  have hconst : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      ∀ c : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L),
      (c : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w)) →
      wcVdD.mk W A K L t c₀ b₀ e' c ∈ 𝔐 := by
    intro w hw c hc
    have h1 : c ∈ wcVdJ0 W A K L t c₀ b₀ e' := Ideal.le_radical (Ideal.subset_span ⟨w, hw, hc⟩)
    have h2 : wcVdD.mk W A K L t c₀ b₀ e' c = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr h1
    rw [h2]
    exact 𝔐.zero_mem

  have hint : (algebraMap ↥(wcVdR0 W A K t c₀ b₀ e')
      ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L)).IsIntegral :=
    fun x => Algebra.IsIntegral.isIntegral x
  haveI := h𝔐'
  have h𝔫₀ : ((𝔐.comap (wcVdD.mk W A K L t c₀ b₀ e')).comap (algebraMap ↥(wcVdR0 W A K t c₀ b₀ e')
      ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L))).IsMaximal :=
    Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _ hint _
  have hmR0 : (IsLocalRing.maximalIdeal ↥W).map
      ((algebraMap A ↥(wcVdR0 W A K t c₀ b₀ e')).comp (algebraMap ↥W A)) ≤
      (𝔐.comap (wcVdD.mk W A K L t c₀ b₀ e')).comap (algebraMap ↥(wcVdR0 W A K t c₀ b₀ e')
        ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L)) := by
    rw [Ideal.map_le_iff_le_comap]
    intro w hw
    exact hconst w hw (cst w) rfl
  have hFT : Algebra.FiniteType A ↥(wcVdR0 W A K t c₀ b₀ e') := by
    refine (Subalgebra.fg_iff_finiteType _).mp ?_
    exact ⟨{wcLlsScS W A K t c₀ b₀, wcLlsScV W A K t (c₀ + b₀ * e') b₀}, by
      rw [Finset.coe_insert, Finset.coe_singleton]⟩

  obtain ⟨e, he1⟩ := wcpa_dj_llsm_nrt_residue_surj Ω W A hPD.1 ↥(wcVdR0 W A K t c₀ b₀ e') hFT
    _ h𝔫₀ hmR0 ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L)
    (𝔐.comap (wcVdD.mk W A K L t c₀ b₀ e')) h𝔐'.isPrime rfl xS
  have he1' : xS - cst e ∈ 𝔐.comap (wcVdD.mk W A K L t c₀ b₀ e') := he1

  have hK : (wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e')) *
      wcLlsScV W A K t (c₀ + b₀ * e') b₀ = 1 := by
    obtain ⟨hτ, hB⟩ := wcpa_dj_llsm_obnu_tau_ne_zero Ω W A K 𝔭 t hPD (c₀ + b₀ * e') b₀ hb₀0
    simp only [wcLlsScS, wcLlsScV, map_sub, map_add, map_mul] at hτ hB ⊢
    field_simp
    try ring
  have huv : (xS - cst e') * v = 1 := by
    apply Subtype.ext
    show (algebraMap K L (wcLlsScS W A K t c₀ b₀) -
        algebraMap K L (algebraMap A K (algebraMap ↥W A e'))) *
        algebraMap K L (wcLlsScV W A K t (c₀ + b₀ * e') b₀) = 1
    rw [← map_sub, ← map_mul, hK, map_one]

  have hne : e - e' ∉ IsLocalRing.maximalIdeal ↥W := by
    intro h
    have h2 : cst (e - e') ∈ 𝔐.comap (wcVdD.mk W A K L t c₀ b₀ e') := hconst _ h _ rfl
    rw [map_sub] at h2
    have h3 := Ideal.add_mem _ he1' h2
    rw [sub_add_sub_cancel] at h3
    exact h𝔐'.ne_top (Ideal.eq_top_of_isUnit_mem _ h3 (IsUnit.of_mul_eq_one v huv))
  have hmax := ((wcLlsKPms_chart_fibre Ω W A K 𝔭 t hPD c₀ b₀ hc₀ hb₀ hb₀0).2.2 e).1
  refine ⟨e, hne, (Ideal.IsMaximal.eq_of_le hmax ?_ ?_).symm⟩
  · exact Ideal.comap_ne_top _ (Ideal.comap_ne_top _ h𝔐.ne_top)
  · apply sup_le
    · rw [Ideal.span_singleton_le_iff_mem]
      simp only [Ideal.mem_comap, RingHom.comp_apply, map_sub]
      have heq : wcVdCfIota W A K L t c₀ b₀ e'
          (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L)
            (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) (algebraMap ↥W A e))) =
          cst e := Subtype.ext rfl
      rw [heq]
      exact he1'
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      simp only [Ideal.mem_comap, RingHom.comp_apply]
      exact hconst w hw _ rfl

theorem wcVdCf_local_iso : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A) (c₀ b₀ e' : ↥W),
    wcLlsPD W A 𝔭 (.disc t) →
    c₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 →
    letI : CommRing (wcVdD W A K L t c₀ b₀ e') := wcVdD.commRing W A K L t c₀ b₀ e';
    ∀ (𝔐 : Ideal (wcVdD W A K L t c₀ b₀ e')) [𝔐.IsMaximal],
      Nonempty (Localization.AtPrime 𝔐 ≃+*
        wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
          ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})
          (𝔐.comap ((wcVdD.mk W A K L t c₀ b₀ e').comp (wcVdCfIota W A K L t c₀ b₀ e')))) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t c₀ b₀ e' hPD hc₀ hb₀ hb₀0
  letI : CommRing (wcVdD W A K L t c₀ b₀ e') := wcVdD.commRing W A K L t c₀ b₀ e'
  intro 𝔐 h𝔐max
  haveI : 𝔐.IsPrime := h𝔐max.isPrime
  classical


  have G : ∀ {C B D : Type u} [CommRing C] [CommRing B] [IsDomain B] [CommRing D]
      (ι : C →+* B) (mk : B →+* D), Function.Surjective mk → Function.Injective ι →
      ∀ d : C, IsUnit (ι d) → (∀ b : B, ∃ (N : ℕ) (c : C), ι c = ι d ^ N * b) →
      ∀ (I_C : Ideal C) (I_B : Ideal B), I_C.map ι = I_B → RingHom.ker mk = I_B.radical →
      ∀ (𝔐 : Ideal D) [𝔐.IsPrime],
      IsReduced (Localization.AtPrime (𝔐.comap (mk.comp ι)) ⧸
        I_C.map (algebraMap C (Localization.AtPrime (𝔐.comap (mk.comp ι))))) →
      Nonempty (Localization.AtPrime 𝔐 ≃+* (Localization.AtPrime (𝔐.comap (mk.comp ι)) ⧸
        I_C.map (algebraMap C (Localization.AtPrime (𝔐.comap (mk.comp ι)))))) := by
    intro C B D _ _ _ _ ι mk hmk hι d hd hcl I_C I_B hIB hker 𝔐 _ hred
    have hP : (𝔐.comap mk).IsPrime := inferInstance
    let P := 𝔐.comap mk
    let JP := (RingHom.ker mk).map (algebraMap B (Localization.AtPrime P))
    let g : Localization.AtPrime P →+* Localization.AtPrime P ⧸ JP := Ideal.Quotient.mk JP
    have hker' : RingHom.ker mk ≤ RingHom.ker (g.comp (algebraMap B (Localization.AtPrime P))) := by
      intro x hx
      rw [RingHom.mem_ker, RingHom.comp_apply]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hx)
    let φ : D →+* Localization.AtPrime P ⧸ JP :=
      (mk.liftOfSurjective hmk) ⟨g.comp (algebraMap B (Localization.AtPrime P)), hker'⟩
    have hφ : ∀ b, φ (mk b) = g (algebraMap B (Localization.AtPrime P) b) := fun b =>
      RingHom.liftOfSurjective_comp_apply mk hmk _ b
    obtain ⟨E₁⟩ : Nonempty (Localization.AtPrime 𝔐 ≃+* (Localization.AtPrime P ⧸ JP)) := by
      let _ : Algebra D (Localization.AtPrime P ⧸ JP) := φ.toAlgebra
      have hloc : IsLocalization (Submonoid.map mk P.primeCompl) (Localization.AtPrime P ⧸ JP) := by
        refine IsLocalization.of_surjective P.primeCompl (Localization.AtPrime P) mk hmk g
          Ideal.Quotient.mk_surjective ?_ ?_
        · ext b
          simp only [RingHom.comp_apply, RingHom.algebraMap_toAlgebra]
          exact (hφ b).symm
        · intro x hx
          rw [RingHom.mem_ker] at hx
          exact Ideal.Quotient.eq_zero_iff_mem.mp hx
      have hM : Submonoid.map mk P.primeCompl = 𝔐.primeCompl := by
        ext y
        rw [Submonoid.mem_map]
        constructor
        · rintro ⟨x, hx, rfl⟩
          exact hx
        · intro hy
          obtain ⟨x, rfl⟩ := hmk y
          exact ⟨x, hy, rfl⟩
      rw [hM] at hloc
      exact ⟨(IsLocalization.algEquiv 𝔐.primeCompl (Localization.AtPrime 𝔐)
        (Localization.AtPrime P ⧸ JP)).toRingEquiv⟩
    have hQ : 𝔐.comap (mk.comp ι) = P.comap ι := (Ideal.comap_comap ι mk).symm
    have hdP : ι d ∉ P := fun h => hP.ne_top (Ideal.eq_top_of_isUnit_mem _ h hd)
    have hpowP : ∀ n : ℕ, ι d ^ n ∉ P := fun n h => hdP (hP.mem_of_pow_mem n h)
    obtain ⟨Φ, hΦ⟩ : ∃ Φ : Localization.AtPrime (𝔐.comap (mk.comp ι)) ≃+* Localization.AtPrime P,
        ∀ c : C, Φ (algebraMap C _ c) = algebraMap B _ (ι c) := by
      let g2 : C →+* Localization.AtPrime P := (algebraMap B (Localization.AtPrime P)).comp ι
      let _ : Algebra C (Localization.AtPrime P) := g2.toAlgebra
      have hloc : IsLocalization (𝔐.comap (mk.comp ι)).primeCompl (Localization.AtPrime P) := by
        rw [isLocalization_iff]
        refine ⟨?_, ?_, ?_⟩
        · rintro ⟨s, hs⟩
          rw [RingHom.algebraMap_toAlgebra]
          have hs' : ι s ∈ P.primeCompl := by
            show ι s ∉ P
            intro h; apply hs; rw [hQ]; exact h
          exact IsLocalization.map_units (Localization.AtPrime P) (⟨ι s, hs'⟩ : P.primeCompl)
        · intro z
          obtain ⟨⟨b, u⟩, hz⟩ := IsLocalization.surj P.primeCompl z
          obtain ⟨N, c₁, h₁⟩ := hcl b
          obtain ⟨M, c₂, h₂⟩ := hcl (u : B)
          have hy : c₂ * d ^ N ∈ (𝔐.comap (mk.comp ι)).primeCompl := by
            show c₂ * d ^ N ∉ 𝔐.comap (mk.comp ι)
            rw [hQ, Ideal.mem_comap, map_mul, map_pow, h₂]
            intro hm
            rcases hP.mem_or_mem hm with h | h
            · rcases hP.mem_or_mem h with h' | h'
              · exact hpowP M h'
              · exact u.2 h'
            · exact hpowP N h
          refine ⟨⟨c₁ * d ^ M, ⟨c₂ * d ^ N, hy⟩⟩, ?_⟩
          simp only [RingHom.algebraMap_toAlgebra, g2, RingHom.comp_apply, map_mul, map_pow, h₁, h₂]
          simp only at hz
          calc z * ((algebraMap B (Localization.AtPrime P)) (ι d) ^ M *
                (algebraMap B (Localization.AtPrime P)) ↑u *
                (algebraMap B (Localization.AtPrime P)) (ι d) ^ N)
              = (z * (algebraMap B (Localization.AtPrime P)) ↑u) *
                ((algebraMap B (Localization.AtPrime P)) (ι d) ^ M *
                (algebraMap B (Localization.AtPrime P)) (ι d) ^ N) := by ring
            _ = _ := by rw [hz]; ring
        · intro x y hxy
          rw [RingHom.algebraMap_toAlgebra] at hxy
          have h1 : ι x = ι y := IsLocalization.injective (Localization.AtPrime P)
            (Ideal.primeCompl_le_nonZeroDivisors P) hxy
          exact ⟨1, by rw [hι h1]⟩
      refine ⟨(IsLocalization.algEquiv (𝔐.comap (mk.comp ι)).primeCompl
        (Localization.AtPrime (𝔐.comap (mk.comp ι))) (Localization.AtPrime P)).toRingEquiv,
        fun c => ?_⟩
      have := (IsLocalization.algEquiv (𝔐.comap (mk.comp ι)).primeCompl
        (Localization.AtPrime (𝔐.comap (mk.comp ι))) (Localization.AtPrime P)).commutes c
      rw [RingHom.algebraMap_toAlgebra] at this
      exact this
    have hcomp : (Φ : Localization.AtPrime (𝔐.comap (mk.comp ι)) →+* Localization.AtPrime P).comp
        (algebraMap C _) = (algebraMap B (Localization.AtPrime P)).comp ι := RingHom.ext hΦ
    have hst : I_B.map (algebraMap B (Localization.AtPrime P)) =
        (I_C.map (algebraMap C (Localization.AtPrime (𝔐.comap (mk.comp ι))))).map
          (Φ : Localization.AtPrime (𝔐.comap (mk.comp ι)) →+* Localization.AtPrime P) := by
      rw [Ideal.map_map, hcomp, ← Ideal.map_map, hIB]
    let E₂ : (Localization.AtPrime (𝔐.comap (mk.comp ι)) ⧸
        I_C.map (algebraMap C (Localization.AtPrime (𝔐.comap (mk.comp ι))))) ≃+*
        (Localization.AtPrime P ⧸ I_B.map (algebraMap B (Localization.AtPrime P))) :=
      Ideal.quotientEquiv _ _ Φ hst
    have hredB : IsReduced (Localization.AtPrime P ⧸ I_B.map (algebraMap B (Localization.AtPrime P))) :=
      isReduced_of_injective E₂.symm E₂.symm.injective
    have hrad : JP = I_B.map (algebraMap B (Localization.AtPrime P)) := by
      show (RingHom.ker mk).map (algebraMap B (Localization.AtPrime P)) = _
      rw [hker]
      apply le_antisymm
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        obtain ⟨n, hn⟩ := (Ideal.mem_radical_iff).mp hx
        rw [Ideal.mem_comap]
        have h1 : IsNilpotent (Ideal.Quotient.mk (I_B.map (algebraMap B (Localization.AtPrime P)))
            (algebraMap B (Localization.AtPrime P) x)) := by
          refine ⟨n, ?_⟩
          rw [← map_pow, ← map_pow]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hn)
        exact Ideal.Quotient.eq_zero_iff_mem.mp h1.eq_zero
      · exact Ideal.map_mono Ideal.le_radical
    exact ⟨E₁.trans ((Ideal.quotEquivOfEq hrad).trans E₂.symm)⟩

  set S := wcLlsScS W A K t c₀ b₀ with hSdef
  set V := wcLlsScV W A K t (c₀ + b₀ * e') b₀ with hVdef
  set δ := S - algebraMap A K (algebraMap ↥W A e') with hδdef
  set ι := wcVdCfIota W A K L t c₀ b₀ e' with hιdef
  set mk := wcVdD.mk W A K L t c₀ b₀ e' with hmkdef

  obtain ⟨hu, hb⟩ := wcpa_dj_llsm_obnu_tau_ne_zero Ω W A K 𝔭 t hPD (c₀ + b₀ * e') b₀ hb₀0
  have hδb : δ * algebraMap A K (algebraMap ↥W A b₀) =
      algebraMap A K (t - algebraMap ↥W A (c₀ + b₀ * e')) := by
    rw [hδdef, hSdef]
    unfold wcLlsScS
    rw [sub_mul, div_mul_cancel₀ _ hb]
    simp only [map_sub, map_add, map_mul]
    ring
  have hVδ : V * δ = 1 := by
    rw [hVdef]
    unfold wcLlsScV
    rw [div_mul_eq_mul_div, mul_comm (algebraMap A K (algebraMap ↥W A b₀)), hδb, div_self hu]

  have hδR : δ ∈ Algebra.adjoin A {S} :=
    sub_mem (Algebra.subset_adjoin (Set.mem_singleton _)) (Subalgebra.algebraMap_mem _ _)
  let d : ↥(integralClosure ↥(Algebra.adjoin A {S}) L) :=
    algebraMap ↥(Algebra.adjoin A {S}) ↥(integralClosure ↥(Algebra.adjoin A {S}) L) ⟨δ, hδR⟩
  have hd : (d : L) = algebraMap K L δ := rfl
  have hV : V ∈ wcVdR0 W A K t c₀ b₀ e' :=
    Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  let v : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) :=
    algebraMap ↥(wcVdR0 W A K t c₀ b₀ e') ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) ⟨V, hV⟩
  have hv : (v : L) = algebraMap K L V := rfl
  have hιval : ∀ c, ((ι c : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L)) : L) = (c : L) :=
    fun c => rfl
  have hunit : IsUnit (ι d) := by
    refine IsUnit.of_mul_eq_one v (Subtype.ext ?_)
    rw [MulMemClass.coe_mul, hιval, hd, hv, ← map_mul, mul_comm, hVδ, map_one]
    rfl
  have hιinj : Function.Injective ι := by
    intro x y h
    apply Subtype.ext
    have := congrArg Subtype.val h
    rwa [hιval, hιval] at this
  have hclear : ∀ b : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L),
      ∃ (N : ℕ) (c : ↥(integralClosure ↥(Algebra.adjoin A {S}) L)), ι c = ι d ^ N * b := by
    intro b
    obtain ⟨N, y, hy⟩ := (wcVdCf_B0_finite Ω W hW hWt A K L 𝔭 t c₀ b₀ e' hPD hc₀ hb₀ hb₀0).1 b
    refine ⟨N, y, Subtype.ext ?_⟩
    rw [hιval, MulMemClass.coe_mul, SubmonoidClass.coe_pow, hιval, hd, hy, map_pow]

  have hmk_surj : Function.Surjective mk := Ideal.Quotient.mk_surjective
  have hkerJ : RingHom.ker mk = (Ideal.span {c : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (c : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w))}).radical := Ideal.mk_ker
  have s5 : (Ideal.span {c : ↥(integralClosure ↥(Algebra.adjoin A {S}) L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}).map ι =
      Ideal.span {c : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (c : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w))} := by
    rw [Ideal.map_span]
    congr 1
    ext x
    constructor
    · rintro ⟨c, ⟨w, hw, hc⟩, rfl⟩
      exact ⟨w, hw, by rw [hιval, hc]; rfl⟩
    · rintro ⟨w, hw, hx⟩
      refine ⟨algebraMap ↥(Algebra.adjoin A {S}) ↥(integralClosure ↥(Algebra.adjoin A {S}) L)
        (algebraMap A ↥(Algebra.adjoin A {S}) (algebraMap ↥W A w)), ⟨w, hw, rfl⟩, ?_⟩
      apply Subtype.ext
      rw [hιval, hx]
      rfl
  have hredFS := (wcpa_dj_llsm_isice_fs_reduced_noetherian Ω W hW hWt A K L 𝔭 (.disc t) hPD
    (Algebra.adjoin A {S}) ⟨{S}, by simp⟩ (𝔐.comap (mk.comp ι))).1
  exact G ι mk hmk_surj hιinj d hunit hclear _ _ s5 hkerJ 𝔐 hredFS

theorem wcVdCf_min_over : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A) (c₀ b₀ e' : ↥W),
    wcLlsPD W A 𝔭 (.disc t) →
    c₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 →
    letI : CommRing (wcVdD W A K L t c₀ b₀ e') := wcVdD.commRing W A K L t c₀ b₀ e';
    ∀ P ∈ minimalPrimes (wcVdD W A K L t c₀ b₀ e'),
      (P.comap ((wcVdD.mk W A K L t c₀ b₀ e').comp (wcVdCfIota W A K L t c₀ b₀ e'))).comap
          (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) L)) =
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})).comp (algebraMap ↥W A)) ∧
      ∀ e : ↥W, e - e' ∉ IsLocalRing.maximalIdeal ↥W →
        ∀ c : ↥(integralClosure ↥(wcVdR0 W A K t c₀ b₀ e') L),
          (c : L) = algebraMap K L (wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e)) →
          Ideal.Quotient.mk P (wcVdD.mk W A K L t c₀ b₀ e' c) ≠ 0 :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t c₀ b₀ e' hPD hc₀ hb₀ hb₀0
  haveI := wcpa_dj_nc_residue_algclosed Ω W

  have hqm : ∀ (B : Type u) [CommRing B] (I : Ideal B) (P : Ideal (B ⧸ I)),
      P ∈ minimalPrimes (B ⧸ I) → ∀ 𝔮' : Ideal B, 𝔮'.IsPrime → I ≤ 𝔮' →
      𝔮' ≤ P.comap (Ideal.Quotient.mk I) → 𝔮' = P.comap (Ideal.Quotient.mk I) := by
    intro B _ I P hP 𝔮' h𝔮' hI hle
    haveI := h𝔮'
    have hker : RingHom.ker (Ideal.Quotient.mk I) ≤ 𝔮' := by rw [Ideal.mk_ker]; exact hI
    have hprime : (𝔮'.map (Ideal.Quotient.mk I)).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker
    have hmle : 𝔮'.map (Ideal.Quotient.mk I) ≤ P := Ideal.map_le_iff_le_comap.mpr hle
    have hPle : P ≤ 𝔮'.map (Ideal.Quotient.mk I) := hP.2 ⟨hprime, bot_le⟩ hmle
    apply le_antisymm hle
    calc P.comap (Ideal.Quotient.mk I)
        ≤ (𝔮'.map (Ideal.Quotient.mk I)).comap (Ideal.Quotient.mk I) := Ideal.comap_mono hPle
      _ = 𝔮' := by
        rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot,
          Ideal.mk_ker]
        exact sup_eq_left.mpr hI

  have fib : ∀ (R : Type u) [CommRing R] (φ : ↥W →+* R) (s : R),
      (∀ r : R, ∃ f : Polynomial ↥W,
        r - Polynomial.eval₂ φ s f ∈ (IsLocalRing.maximalIdeal ↥W).map φ) →
      (∀ f : Polynomial ↥W, Polynomial.eval₂ φ s f ∈ (IsLocalRing.maximalIdeal ↥W).map φ →
        ∀ i, f.coeff i ∈ IsLocalRing.maximalIdeal ↥W) →
      ((IsLocalRing.maximalIdeal ↥W).map φ).IsPrime ∧
      (∀ e : ↥W, s - φ e ∉ (IsLocalRing.maximalIdeal ↥W).map φ) ∧
      ∀ 𝔫 : Ideal R, 𝔫.IsPrime → (IsLocalRing.maximalIdeal ↥W).map φ ≤ 𝔫 →
        𝔫 ≠ (IsLocalRing.maximalIdeal ↥W).map φ → ∃ e : ↥W, s - φ e ∈ 𝔫 := by
    intro R _ φ s hi hii
    set mR := (IsLocalRing.maximalIdeal ↥W).map φ with hmR
    have hcoef : ∀ f : Polynomial ↥W, (∀ i, f.coeff i ∈ IsLocalRing.maximalIdeal ↥W) →
        Polynomial.eval₂ φ s f ∈ mR := by
      intro f hf
      rw [Polynomial.eval₂_eq_sum_range]
      exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (hf i)))
    have hmap0 : ∀ f : Polynomial ↥W, f.map (IsLocalRing.residue ↥W) = 0 ↔
        ∀ i, f.coeff i ∈ IsLocalRing.maximalIdeal ↥W := by
      intro f
      rw [Polynomial.ext_iff]
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero, IsLocalRing.residue_eq_zero_iff]
    have hK : ∀ f : Polynomial ↥W, Polynomial.eval₂ φ s f ∈ mR ↔
        f.map (IsLocalRing.residue ↥W) = 0 := by
      intro f
      rw [hmap0]
      exact ⟨hii f, hcoef f⟩
    have hprime : mR.IsPrime := by
      refine ⟨(Ideal.ne_top_iff_one _).mpr ?_, ?_⟩
      · intro h1
        have h2 := hii 1 (by rw [Polynomial.eval₂_one]; exact h1) 0
        rw [Polynomial.coeff_one_zero] at h2
        exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top ((Ideal.eq_top_iff_one _).mpr h2)
      · intro x y hxy
        obtain ⟨fx, hfx⟩ := hi x
        obtain ⟨fy, hfy⟩ := hi y
        have hprod : Polynomial.eval₂ φ s (fx * fy) ∈ mR := by
          rw [Polynomial.eval₂_mul]
          have e : Polynomial.eval₂ φ s fx * Polynomial.eval₂ φ s fy = x * y -
              ((x - Polynomial.eval₂ φ s fx) * y +
                Polynomial.eval₂ φ s fx * (y - Polynomial.eval₂ φ s fy)) := by ring
          rw [e]
          exact mR.sub_mem hxy (mR.add_mem (mR.mul_mem_right _ hfx) (mR.mul_mem_left _ hfy))
        rw [hK, Polynomial.map_mul] at hprod
        rcases mul_eq_zero.mp hprod with h | h
        · left
          have h' := (hK fx).mpr h
          have e : x = (x - Polynomial.eval₂ φ s fx) + Polynomial.eval₂ φ s fx := by ring
          rw [e]; exact mR.add_mem hfx h'
        · right
          have h' := (hK fy).mpr h
          have e : y = (y - Polynomial.eval₂ φ s fy) + Polynomial.eval₂ φ s fy := by ring
          rw [e]; exact mR.add_mem hfy h'
    have hF2 : ∀ e : ↥W, s - φ e ∉ mR := by
      intro e h
      have h' : Polynomial.eval₂ φ s (Polynomial.X - Polynomial.C e) ∈ mR := by
        rw [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C]; exact h
      rw [hK, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C] at h'
      exact Polynomial.X_sub_C_ne_zero _ h'
    refine ⟨hprime, hF2, ?_⟩
    intro 𝔫 h𝔫 hle hne
    obtain ⟨r, hr𝔫, hrm⟩ : ∃ r ∈ 𝔫, r ∉ mR := by
      by_contra hcon
      push_neg at hcon
      exact hne (le_antisymm hcon hle)
    obtain ⟨f, hf⟩ := hi r
    have hg0 : f.map (IsLocalRing.residue ↥W) ≠ 0 := by
      intro h0
      apply hrm
      have e1 := (hK f).mpr h0
      have e : r = (r - Polynomial.eval₂ φ s f) + Polynomial.eval₂ φ s f := by ring
      rw [e]; exact mR.add_mem hf e1
    have hf𝔫 : Polynomial.eval₂ φ s f ∈ 𝔫 := by
      have e : Polynomial.eval₂ φ s f = r - (r - Polynomial.eval₂ φ s f) := by ring
      rw [e]; exact 𝔫.sub_mem hr𝔫 (hle hf)
    have hsurj : Function.Surjective (IsLocalRing.residue ↥W) := IsLocalRing.residue_surjective
    have hσ : ∀ a, IsLocalRing.residue ↥W (Function.surjInv hsurj a) = a :=
      Function.surjInv_eq hsurj
    obtain ⟨g, hg⟩ : ∃ g, g = f.map (IsLocalRing.residue ↥W) := ⟨_, rfl⟩
    rw [← hg] at hg0
    have hGmap : (Polynomial.C (Function.surjInv hsurj g.leadingCoeff) *
        (g.roots.map (fun a => Polynomial.X - Polynomial.C (Function.surjInv hsurj a))).prod).map
          (IsLocalRing.residue ↥W) = g := by
      rw [Polynomial.map_mul, Polynomial.map_C, hσ, Polynomial.map_multiset_prod, Multiset.map_map]
      have e : Multiset.map ((Polynomial.map (IsLocalRing.residue ↥W)) ∘
          fun a => Polynomial.X - Polynomial.C (Function.surjInv hsurj a)) g.roots =
          Multiset.map (fun a => Polynomial.X - Polynomial.C a) g.roots :=
        Multiset.map_congr rfl (fun a _ => by simp [hσ])
      rw [e]
      exact Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C IsAlgClosed.card_roots_eq_natDegree
    have hdiff : Polynomial.eval₂ φ s (f - Polynomial.C (Function.surjInv hsurj g.leadingCoeff) *
        (g.roots.map (fun a => Polynomial.X - Polynomial.C (Function.surjInv hsurj a))).prod) ∈ mR := by
      rw [hK, Polynomial.map_sub, hGmap, hg, sub_self]
    have hG𝔫 : Polynomial.eval₂ φ s (Polynomial.C (Function.surjInv hsurj g.leadingCoeff) *
        (g.roots.map (fun a => Polynomial.X - Polynomial.C (Function.surjInv hsurj a))).prod) ∈ 𝔫 := by
      rw [Polynomial.eval₂_sub] at hdiff
      have h2 := 𝔫.sub_mem hf𝔫 (hle hdiff)
      rwa [sub_sub_cancel] at h2
    rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_multiset_prod,
      Multiset.map_map] at hG𝔫
    have hu : IsUnit (φ (Function.surjInv hsurj g.leadingCoeff)) := by
      apply IsUnit.map
      apply IsLocalRing.notMem_maximalIdeal.mp
      intro hm
      rw [← IsLocalRing.residue_eq_zero_iff, hσ] at hm
      exact hg0 (Polynomial.leadingCoeff_eq_zero.mp hm)
    rcases h𝔫.mem_or_mem hG𝔫 with h | h
    · exact absurd (Ideal.eq_top_of_isUnit_mem _ h hu) h𝔫.ne_top
    · obtain ⟨p, hp, hp𝔫⟩ := (h𝔫.multiset_prod_mem_iff_exists_mem _).mp h
      obtain ⟨a, _, rfl⟩ := Multiset.mem_map.mp hp
      refine ⟨Function.surjInv hsurj a, ?_⟩
      simpa [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C] using hp𝔫

  have core : ∀ (R C B : Type u) [CommRing R] [IsDomain R] [CommRing C] [IsDomain C] [Algebra R C]
      [Algebra.IsIntegral R C] [CommRing B], Function.Injective (algebraMap R C) →
      ∀ (ι : C →+* B), Function.Injective ι → ∀ τR : R, IsUnit (ι (algebraMap R C τR)) →
      (∀ x : B, ∃ (N : ℕ) (y : C), ι y = ι (algebraMap R C τR) ^ N * x) →
      ∀ (J : Ideal B) (P : Ideal (B ⧸ J)), P ∈ minimalPrimes (B ⧸ J) →
      ∀ (mR : Ideal R), mR.IsPrime → τR ∉ mR →
      (∀ 𝔮' : Ideal B, 𝔮'.IsPrime → (∀ r ∈ mR, ι (algebraMap R C r) ∈ 𝔮') → J ≤ 𝔮') →
      ∀ (n : Ideal R) [n.IsPrime], IsIntegrallyClosed (Localization.AtPrime n) →
      (P.comap ((Ideal.Quotient.mk J).comp ι)).comap (algebraMap R C) = n → mR ≤ n → n = mR := by
    intro R C B _ _ _ _ _ _ _ hinj ι hι τR hunit hclr J P hP mR hmR hτ hJ n _ hnorm hn hle
    haveI hPprime : P.IsPrime := hP.1.1
    have hQprime : (P.comap ((Ideal.Quotient.mk J).comp ι)).IsPrime := Ideal.comap_isPrime _ _
    obtain ⟨𝔮, h𝔮, h𝔮Q, h𝔮c⟩ := wcpa_dj_llsm_scbc_normal_going_down R C hinj n hnorm
      (P.comap ((Ideal.Quotient.mk J).comp ι)) hQprime hn mR hmR hle
    have hτ𝔮 : algebraMap R C τR ∉ 𝔮 := fun h => hτ (by rw [← h𝔮c]; exact h)
    have hτN : ∀ N : ℕ, algebraMap R C τR ^ N ∉ 𝔮 := fun N h => hτ𝔮 (h𝔮.mem_of_pow_mem N h)

    have hW : ∀ (x : B) (N₁ N₂ : ℕ) (y₁ y₂ : C), y₁ ∈ 𝔮 → ι y₁ = ι (algebraMap R C τR) ^ N₁ * x →
        ι y₂ = ι (algebraMap R C τR) ^ N₂ * x → y₂ ∈ 𝔮 := by
      intro x N₁ N₂ y₁ y₂ hy₁ e₁ e₂
      have h1 : algebraMap R C τR ^ N₁ * y₂ = algebraMap R C τR ^ N₂ * y₁ := by
        apply hι
        rw [map_mul, map_mul, map_pow, map_pow, e₁, e₂]; ring
      have h2 : algebraMap R C τR ^ N₁ * y₂ ∈ 𝔮 := by rw [h1]; exact 𝔮.mul_mem_left _ hy₁
      rcases h𝔮.mem_or_mem h2 with h | h
      · exact absurd h (hτN N₁)
      · exact h
    let 𝔮' : Ideal B :=
      { carrier := {x | ∃ (N : ℕ) (y : C), y ∈ 𝔮 ∧ ι y = ι (algebraMap R C τR) ^ N * x}
        add_mem' := by
          rintro a b ⟨N₁, y₁, hy₁, e₁⟩ ⟨N₂, y₂, hy₂, e₂⟩
          refine ⟨N₁ + N₂, algebraMap R C τR ^ N₂ * y₁ + algebraMap R C τR ^ N₁ * y₂,
            𝔮.add_mem (𝔮.mul_mem_left _ hy₁) (𝔮.mul_mem_left _ hy₂), ?_⟩
          rw [map_add, map_mul, map_mul, map_pow, map_pow, e₁, e₂]; ring
        zero_mem' := ⟨0, 0, 𝔮.zero_mem, by simp⟩
        smul_mem' := by
          rintro b x ⟨N, y, hy, e⟩
          obtain ⟨M, z, hz⟩ := hclr b
          refine ⟨M + N, z * y, 𝔮.mul_mem_left _ hy, ?_⟩
          rw [map_mul, hz, e, smul_eq_mul, pow_add]; ring }
    have hmem : ∀ x : B, x ∈ 𝔮' ↔ ∃ (N : ℕ) (y : C), y ∈ 𝔮 ∧
        ι y = ι (algebraMap R C τR) ^ N * x := fun x => Iff.rfl
    have h𝔮'p : 𝔮'.IsPrime := by
      refine ⟨(Ideal.ne_top_iff_one _).mpr ?_, ?_⟩
      · intro h1
        obtain ⟨N, y, hy, e⟩ := (hmem 1).mp h1
        have : y = algebraMap R C τR ^ N := hι (by rw [e, mul_one, map_pow])
        exact hτN N (this ▸ hy)
      · intro x x' hxx'
        obtain ⟨N, y, hy, e⟩ := (hmem _).mp hxx'
        obtain ⟨M, z, hz⟩ := hclr x
        obtain ⟨M', z', hz'⟩ := hclr x'
        have h1 : z * z' * algebraMap R C τR ^ N = algebraMap R C τR ^ (M + M') * y := by
          apply hι
          rw [map_mul, map_mul, map_mul, map_pow, map_pow, hz, hz', e, pow_add]; ring
        have h2 : z * z' * algebraMap R C τR ^ N ∈ 𝔮 := by rw [h1]; exact 𝔮.mul_mem_left _ hy
        rcases h𝔮.mem_or_mem h2 with h | h
        · rcases h𝔮.mem_or_mem h with h' | h'
          · exact Or.inl ((hmem x).mpr ⟨M, z, h', hz⟩)
          · exact Or.inr ((hmem x').mpr ⟨M', z', h', hz'⟩)
        · exact absurd h (hτN N)
    have h𝔮'c : 𝔮'.comap ι = 𝔮 := by
      ext c
      rw [Ideal.mem_comap, hmem]
      constructor
      · rintro ⟨N, y, hy, e⟩
        exact hW (ι c) N 0 y c hy e (by rw [pow_zero, one_mul])
      · intro hc
        exact ⟨0, c, hc, by rw [pow_zero, one_mul]⟩
    have hJ𝔮' : J ≤ 𝔮' := hJ 𝔮' h𝔮'p (fun r hr => (hmem _).mpr
      ⟨0, algebraMap R C r, by rw [← h𝔮c] at hr; exact hr, by rw [pow_zero, one_mul]⟩)
    have hP'p : (P.comap (Ideal.Quotient.mk J)).IsPrime := Ideal.comap_isPrime _ _
    have h𝔮'P' : 𝔮' ≤ P.comap (Ideal.Quotient.mk J) := by
      intro x hx
      obtain ⟨N, y, hy, e⟩ := (hmem x).mp hx
      have h1 : ι y ∈ P.comap (Ideal.Quotient.mk J) := h𝔮Q hy
      rw [e] at h1
      rcases hP'p.mem_or_mem h1 with h | h
      · exact absurd (Ideal.eq_top_of_isUnit_mem _ h (hunit.pow N)) hP'p.ne_top
      · exact h
    have heq := hqm B J P hP 𝔮' h𝔮'p hJ𝔮' h𝔮'P'
    have h𝔮eq : 𝔮 = P.comap ((Ideal.Quotient.mk J).comp ι) := by
      rw [← h𝔮'c, heq, Ideal.comap_comap]
    rw [← hn, ← h𝔮eq, h𝔮c]

  have final : ∀ (R C B : Type u) [CommRing R] [IsDomain R] [CommRing C] [IsDomain C] [Algebra R C]
      [Algebra.IsIntegral R C] [CommRing B], Function.Injective (algebraMap R C) →
      ∀ (ι : C →+* B), Function.Injective ι → ∀ τR : R, IsUnit (ι (algebraMap R C τR)) →
      (∀ x : B, ∃ (N : ℕ) (y : C), ι y = ι (algebraMap R C τR) ^ N * x) →
      ∀ (J : Ideal B) (P : Ideal (B ⧸ J)), P ∈ minimalPrimes (B ⧸ J) →
      ∀ (mR : Ideal R), mR.IsPrime → τR ∉ mR →
      (∀ r ∈ mR, ι (algebraMap R C r) ∈ J) →
      (∀ 𝔮' : Ideal B, 𝔮'.IsPrime → (∀ r ∈ mR, ι (algebraMap R C r) ∈ 𝔮') → J ≤ 𝔮') →
      ∀ (T : Set R), (∀ x ∈ T, x ∉ mR) →
      (∀ 𝔫 : Ideal R, 𝔫.IsPrime → mR ≤ 𝔫 → 𝔫 ≠ mR → ∃ x ∈ T, x ∈ 𝔫) →
      (∀ x ∈ T, ∀ (𝔫 : Ideal R) [𝔫.IsPrime], x ∈ 𝔫 → mR ≤ 𝔫 →
        IsIntegrallyClosed (Localization.AtPrime 𝔫)) →
      (P.comap ((Ideal.Quotient.mk J).comp ι)).comap (algebraMap R C) = mR ∧
      ∀ x ∈ T, Ideal.Quotient.mk P (Ideal.Quotient.mk J (ι (algebraMap R C x))) ≠ 0 := by
    intro R C B _ _ _ _ _ _ _ hinj ι hι τR hunit hclr J P hP mR hmR hτ hgen hJ T hT hT3 hTn
    have hPp : P.IsPrime := hP.1.1
    have hQp : (P.comap ((Ideal.Quotient.mk J).comp ι)).IsPrime := Ideal.comap_isPrime _ _
    have hnp : ((P.comap ((Ideal.Quotient.mk J).comp ι)).comap (algebraMap R C)).IsPrime :=
      Ideal.comap_isPrime _ _
    have hle : mR ≤ (P.comap ((Ideal.Quotient.mk J).comp ι)).comap (algebraMap R C) := by
      intro r hr
      rw [Ideal.mem_comap, Ideal.mem_comap, RingHom.comp_apply,
        Ideal.Quotient.eq_zero_iff_mem.mpr (hgen r hr)]
      exact P.zero_mem
    have hs5 : ∀ x ∈ T, x ∉ (P.comap ((Ideal.Quotient.mk J).comp ι)).comap (algebraMap R C) := by
      intro x hx hx𝔫
      have hnorm := hTn x hx _ hx𝔫 hle
      have heq := core R C B hinj ι hι τR hunit hclr J P hP mR hmR hτ hJ _ hnorm rfl hle
      rw [heq] at hx𝔫
      exact hT x hx hx𝔫
    refine ⟨?_, ?_⟩
    · by_contra hne
      obtain ⟨x, hx, hx𝔫⟩ := hT3 _ hnp hle hne
      exact hs5 x hx hx𝔫
    · intro x hx h0
      apply hs5 x hx
      rw [Ideal.mem_comap, Ideal.mem_comap, RingHom.comp_apply]
      exact Ideal.Quotient.eq_zero_iff_mem.mp h0

  intro P hP
  obtain ⟨hi, hii, hmax⟩ := wcLlsKPms_chart_fibre Ω W A K 𝔭 t hPD c₀ b₀ hc₀ hb₀ hb₀0
  have h1p : (1 : A) ∉ 𝔭 := by
    intro h
    rw [← (hmax 0).2, Ideal.mem_comap, map_one] at h
    exact (hmax 0).1.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  obtain ⟨hmRp, hF2, hF3⟩ := fib ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})).comp (algebraMap ↥W A)) (⟨wcLlsScS W A K t c₀ b₀, Algebra.subset_adjoin (Set.mem_singleton _)⟩ : ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})) hi
    (fun f hf => hii 1 0 f h1p (by rw [pow_zero, one_mul]; exact hf))
  have hβ : algebraMap A K (algebraMap ↥W A b₀) ≠ 0 := by
