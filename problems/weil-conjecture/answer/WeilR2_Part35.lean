  obtain ⟨_, hNZ, _, h𝔭max, _, _, hg0, huv, h𝔭eq, _⟩ := hPD'
  haveI := hNZ
  have hφinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hψ0 : ∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0 := by
    intro w hw hc
    have h1 : algebraMap ↥W A w = 0 := hφinj (hc.trans (map_zero _).symm)
    rw [Algebra.algebraMap_eq_smul_one] at h1
    exact (smul_ne_zero hw one_ne_zero) h1
  have hu0 : algebraMap A K u ≠ 0 := by
    intro hc
    have h1 : algebraMap A K (u * v) = 0 := by rw [map_mul, hc, zero_mul]
    rw [huv] at h1
    exact hψ0 g hg0 h1
  have hroot : ∀ (w : ↥W) (n : ℕ), 0 < n → ∃ r : ↥W, r ^ n = w := by
    intro w n hn
    obtain ⟨r, hr⟩ := IsAlgClosed.exists_pow_nat_eq (w : Ω) hn
    have hrW : r ∈ W := by
      rcases W.mem_or_inv_mem r with h | h
      · exact h
      · by_cases hr0 : r = 0
        · rw [hr0]; exact W.zero_mem
        · have e : r = r ^ n * r⁻¹ ^ (n - 1) := by
            obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
            rw [Nat.add_sub_cancel, pow_succ, mul_comm (r ^ k) r, mul_assoc, ← mul_pow,
              mul_inv_cancel₀ hr0, one_pow, mul_one]
          rw [e, hr]
          exact mul_mem w.2 (pow_mem h _)
    exact ⟨⟨r, hrW⟩, Subtype.ext (by simpa using hr)⟩
  have hmunit : ∀ z : ↥W, z ∈ IsLocalRing.maximalIdeal ↥W ↔ ¬ IsUnit z := fun z =>
    (IsLocalRing.mem_maximalIdeal z).trans mem_nonunits_iff
  have hτ0 : τ ≠ 0 := by
    rintro rfl
    exact hgτ (dvd_zero g)
  have hbasic : ∀ x y : ↥W, P x → ¬ P y → t₁ ∣ x → y ∣ τ →
      x ∈ IsLocalRing.maximalIdeal ↥W ∧ x ≠ 0 ∧ y ∈ IsLocalRing.maximalIdeal ↥W ∧ y ≠ 0 ∧
      x ∣ y ∧ ¬ y ∣ x ∧ y ∣ g := by
    intro x y hx hy htx hyτ
    have hyx : ¬ y ∣ x := fun h => hy (hdown x y hx h)
    have hxy : x ∣ y := (ValuationRing.dvd_total x y).resolve_right hyx
    have hxm : x ∈ IsLocalRing.maximalIdeal ↥W := by
      obtain ⟨k, hk⟩ := htx
      rw [hk]
      exact Ideal.mul_mem_right k _ ht₁m
    have hx0 : x ≠ 0 := by
      intro hx0
      rw [hx0] at hx
      exact hPτ (hdown 0 τ hx (dvd_zero τ))
    have hy0 : y ≠ 0 := by
      intro hy0
      rw [hy0] at hyτ
      exact hτ0 (zero_dvd_iff.mp hyτ)
    obtain ⟨k, hk⟩ := hxy
    have hkm : k ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [hmunit]
      intro hku
      exact hyx ⟨↑hku.unit⁻¹, by rw [hk, mul_assoc, IsUnit.mul_val_inv, mul_one]⟩
    have hym : y ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [hk]
      exact Ideal.mul_mem_left _ x hkm
    exact ⟨hxm, hx0, hym, hy0, ⟨k, hk⟩, hyx, dvd_trans hyτ hτg⟩
  have hmaxP : ∀ a b : ↥W, P a → P b → ∃ m, P m ∧ a ∣ m ∧ b ∣ m := fun a b ha hb =>
    (ValuationRing.dvd_total a b).elim (fun h => ⟨b, hb, h, dvd_rfl⟩)
      (fun h => ⟨a, ha, dvd_rfl, h⟩)
  have hminN : ∀ a b : ↥W, ¬ P a → ¬ P b → ∃ m, ¬ P m ∧ m ∣ a ∧ m ∣ b := fun a b ha hb =>
    (ValuationRing.dvd_total a b).elim (fun h => ⟨a, ha, dvd_rfl, h⟩)
      (fun h => ⟨b, hb, h, dvd_rfl⟩)

  have hpair : ∀ x₂ y₂ a b : ↥W, P x₂ → ¬ P y₂ → P a → ¬ P b → ∃ c₁ c₂ : ↥W,
      c₁ ∈ IsLocalRing.maximalIdeal ↥W ∧ c₁ ≠ 0 ∧ c₂ ∈ IsLocalRing.maximalIdeal ↥W ∧ c₂ ≠ 0 ∧
      c₁ ∣ c₂ ∧ ¬ c₂ ∣ c₁ ∧ c₂ ∣ g ∧
      x₀ ∣ c₁ ∧ c₂ ∣ y₀ ∧ x₂ ∣ c₁ ∧ c₂ ∣ y₂ ∧ a ∣ c₁ ∧ c₂ ∣ b := by
    intro x₂ y₂ a b hx₂ hy₂ ha hb
    obtain ⟨m1, hm1, h1a, h1b⟩ := hmaxP t₁ x₀ hPt₁ hPx₀
    obtain ⟨m2, hm2, h2a, h2b⟩ := hmaxP m1 x₂ hm1 hx₂
    obtain ⟨m3, hm3, h3a, h3b⟩ := hmaxP m2 a hm2 ha
    obtain ⟨n1, hn1, k1a, k1b⟩ := hminN τ y₀ hPτ hPy₀
    obtain ⟨n2, hn2, k2a, k2b⟩ := hminN n1 y₂ hn1 hy₂
    obtain ⟨n3, hn3, k3a, k3b⟩ := hminN n2 b hn2 hb
    obtain ⟨hxm, hx0, hym, hy0, hxy, hyx, hyg⟩ := hbasic m3 n3 hm3 hn3
      (dvd_trans h1a (dvd_trans h2a h3a)) (dvd_trans k3a (dvd_trans k2a k1a))
    exact ⟨m3, n3, hxm, hx0, hym, hy0, hxy, hyx, hyg, dvd_trans h1b (dvd_trans h2a h3a),
      dvd_trans k3a (dvd_trans k2a k1b), dvd_trans h2b h3a, dvd_trans k3a k2b, h3b, k3b⟩

  have hS₁eq : ∀ c₁ : ↥W, c₁ ≠ 0 →
      algebraMap A K u = algebraMap A K (algebraMap ↥W A c₁) * wcLlsInnerS₁ W A K u c₁ := by
    intro c₁ hc₁
    unfold wcLlsInnerS₁
    rw [mul_div_assoc', eq_div_iff (hψ0 c₁ hc₁), mul_comm]
  have hS₂eq : ∀ c₂ : ↥W,
      algebraMap A K (algebraMap ↥W A c₂) = algebraMap A K u * wcLlsInnerS₂ W A K u c₂ := by
    intro c₂
    unfold wcLlsInnerS₂
    rw [mul_div_assoc', eq_div_iff hu0, mul_comm]
  have hS₁N : ∀ (c₁ c₂ : ↥W) (hs : wcLlsInnerS₁ W A K u c₁ ∈ wcLlsInnerCR W A K u c₁ c₂),
      (⟨_, hs⟩ : ↥(wcLlsInnerCR W A K u c₁ c₂)) ∈ wcLlsInnerCN W A K u c₁ c₂ := by
    intro c₁ c₂ hs
    unfold wcLlsInnerCN
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_iff.mpr (Or.inl rfl)))
  have hS₂N : ∀ (c₁ c₂ : ↥W) (hs : wcLlsInnerS₂ W A K u c₂ ∈ wcLlsInnerCR W A K u c₁ c₂),
      (⟨_, hs⟩ : ↥(wcLlsInnerCR W A K u c₁ c₂)) ∈ wcLlsInnerCN W A K u c₁ c₂ := by
    intro c₁ c₂ hs
    unfold wcLlsInnerCN
    exact Ideal.mem_sup_left (Ideal.subset_span
      (Set.mem_insert_iff.mpr (Or.inr (Set.mem_singleton_iff.mpr rfl))))
  have hmN : ∀ (c₁ c₂ : ↥W), ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A w) ∈
        wcLlsInnerCN W A K u c₁ c₂ := by
    intro c₁ c₂ w hw
    unfold wcLlsInnerCN
    have := Ideal.mem_map_of_mem
      ((algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂)).comp (algebraMap ↥W A)) hw
    exact Ideal.mem_sup_right this

  have hcomap : ∀ c₁ c₂ : ↥W, c₁ ≠ 0 → c₂ ∣ g → ∀ a ∈ 𝔭,
      algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a ∈ wcLlsInnerCN W A K u c₁ c₂ := by
    intro c₁ c₂ hc₁ hc₂g a ha
    rw [h𝔭eq] at ha
    have hle : Ideal.span {u, v} ⊔ Ideal.map (algebraMap ↥W A) (IsLocalRing.maximalIdeal ↥W) ≤
        (wcLlsInnerCN W A K u c₁ c₂).comap (algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂)) := by
      refine sup_le ?_ ?_
      · rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
        refine ⟨?_, ?_⟩
        · have hs₁ : wcLlsInnerS₁ W A K u c₁ ∈ wcLlsInnerCR W A K u c₁ c₂ :=
            Algebra.subset_adjoin (Set.mem_insert _ _)
          have e : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) u =
              algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A c₁) * ⟨_, hs₁⟩ := by
            apply Subtype.ext
            simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
            exact hS₁eq c₁ hc₁
          rw [SetLike.mem_coe, Ideal.mem_comap, e]
          exact Ideal.mul_mem_left _ _ (hS₁N c₁ c₂ hs₁)
        · obtain ⟨g₂, hg₂⟩ := hc₂g
          have hs₂ : wcLlsInnerS₂ W A K u c₂ ∈ wcLlsInnerCR W A K u c₁ c₂ :=
            Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
          have h1 : algebraMap A K u * algebraMap A K v =
              algebraMap A K (algebraMap ↥W A c₂) * algebraMap A K (algebraMap ↥W A g₂) := by
            rw [← map_mul, huv, hg₂]
            simp only [map_mul]
          have e : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) v =
              algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A g₂) * ⟨_, hs₂⟩ := by
            apply Subtype.ext
            simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
            apply mul_left_cancel₀ hu0
            linear_combination h1 + (algebraMap A K (algebraMap ↥W A g₂)) * hS₂eq c₂
          rw [SetLike.mem_coe, Ideal.mem_comap, e]
          exact Ideal.mul_mem_left _ _ (hS₂N c₁ c₂ hs₂)
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [Ideal.mem_comap]
        exact hmN c₁ c₂ w hw
    exact hle ha

  have habs : ∀ c₁ c₂ : ↥W, c₁ ≠ 0 → c₂ ∣ g → ∀ (a₀ : A) (E₂ : ↥(wcLlsInnerCR W A K u c₁ c₂)),
      a₀ ∉ 𝔭 → algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a₀ * E₂ ∈ wcLlsInnerCN W A K u c₁ c₂ →
      E₂ ∈ wcLlsInnerCN W A K u c₁ c₂ := by
    intro c₁ c₂ hc₁ hc₂ a₀ E₂ ha₀ hE
    obtain ⟨y, i, hi, hyi⟩ := Ideal.IsMaximal.exists_inv h𝔭max ha₀
    have h1 : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) y *
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a₀ +
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) i = 1 := by
      rw [← map_mul, ← map_add, hyi, map_one]
    have e : E₂ = algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) y *
        (algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a₀ * E₂) +
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) i * E₂ := by
      linear_combination (-E₂) * h1
    rw [e]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hE)
      (Ideal.mul_mem_right _ _ (hcomap c₁ c₂ hc₁ hc₂ i hi))

  have hcl : ∀ c₁ c₂ : ↥W, c₁ ≠ 0 → c₂ ∣ g → ∀ (σa σb : A) (la lb : ↥W) (ja jb : ℤ)
      (Ea Eb r : ↥(wcLlsInnerCR W A K u c₁ c₂)), σa ∉ 𝔭 → lb ≠ 0 →
      r ∈ wcLlsInnerCN W A K u c₁ c₂ →
      algebraMap A K σa * algebraMap A K z =
        algebraMap A K (algebraMap ↥W A la) * algebraMap A K u ^ ja * (Ea : K) →
      algebraMap A K σb * algebraMap A K z =
        algebraMap A K (algebraMap ↥W A lb) * algebraMap A K u ^ jb * (Eb : K) →
      algebraMap A K (algebraMap ↥W A la) * algebraMap A K u ^ ja =
        algebraMap A K (algebraMap ↥W A lb) * algebraMap A K u ^ jb * (r : K) →
      Eb ∈ wcLlsInnerCN W A K u c₁ c₂ := by
    intro c₁ c₂ hc₁ hc₂ σa σb la lb ja jb Ea Eb r hσa hlb hr ha hb hr'
    have hD : algebraMap A K (algebraMap ↥W A lb) * algebraMap A K u ^ jb ≠ 0 :=
      mul_ne_zero (hψ0 lb hlb) (zpow_ne_zero _ hu0)
    have key : (algebraMap A K (algebraMap ↥W A lb) * algebraMap A K u ^ jb) *
          (algebraMap A K σa * (Eb : K)) =
        (algebraMap A K (algebraMap ↥W A lb) * algebraMap A K u ^ jb) *
          (algebraMap A K σb * (r : K) * (Ea : K)) := by
      linear_combination (-(algebraMap A K σa)) * hb + (algebraMap A K σb) * ha +
        (algebraMap A K σb * (Ea : K)) * hr'
    have key2 := mul_left_cancel₀ hD key
    have hR : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) σa * Eb =
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) σb * r * Ea := by
      apply Subtype.ext
      simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
      exact key2
    apply habs c₁ c₂ hc₁ hc₂ σa Eb hσa
    rw [hR]
    exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ hr)
  have hcK : algebraMap A K (algebraMap ↥W A (c' ^ ℓ)) =
      algebraMap A K (algebraMap ↥W A c') ^ ℓ := by
    rw [map_pow, map_pow]
  have hpow : (c' ^ ℓ) ^ (ℓ - 1) = ((ℓ : ℕ) : ↥W) ^ ℓ := by
    rw [← pow_mul, mul_comm ℓ (ℓ - 1), pow_mul, hc']
  have hpw : ∀ (a ρ : ↥W) (m : ℕ),
      (a * ρ ^ m) ^ (ℓ - 1) = a ^ (ℓ - 1) * ρ ^ ((ℓ - 1) * m) := by
    intro a ρ m
    rw [mul_pow, ← pow_mul, mul_comm m]

  unfold wcKpwmgbGood
  intro σ₂ lam₂ j₂ x₂ y₂ hσ₂ hlam₂ _hcone hPx₂ hPy₂ HE₂
  refine Or.inr ?_

  have hKC3 : ∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
      c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
      x₀ ∣ c₁ → c₂ ∣ y₀ → x₂ ∣ c₁ → c₂ ∣ y₂ → ∀ n : ↥(wcLlsInnerCR W A K u c₁ c₂),
      algebraMap A K (algebraMap ↥W A lam₂) * algebraMap A K u ^ j₂ =
        algebraMap A K (algebraMap ↥W A (c' ^ ℓ)) * (n : K) → False := by
    intro c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx0 hy0 hx2 hy2 n hn
    obtain ⟨⟨E', hE'N, hE'⟩, r, hrN, hr⟩ := HYP c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx0 hy0
    obtain ⟨E₂, -, hE₂⟩ := HE₂ c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx2 hy2
    apply hE'N
    refine hcl c₁ c₂ h2 h7 σ₂ σ' lam₂ lam' j₂ j' E₂ E' (r * n) hσ₂ hlam'
      (Ideal.mul_mem_right _ _ hrN) hE₂ hE' ?_
    rw [hn, hcK, hr, Subalgebra.coe_mul]
    ring

  have hj : j₂ = j' := by
    rcases wcpa_dj_llsm_kpwmgb_cmp Ω W hW hWt A K 𝔭 u v g hPD t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁
        hPτ hdown hnomax hnomin lam₂ lam' j₂ j' hlam₂ hlam' with
      ⟨xa, ya, hPxa, hPya, H⟩ | ⟨xa, ya, hPxa, hPya, H⟩
    · by_contra hne
      obtain ⟨c₁, c₂, h1, h2, h3, h4, h5, h6, h7, hx0, hy0, hx2, hy2, hxa, hya⟩ :=
        hpair x₂ y₂ xa ya hPx₂ hPy₂ hPxa hPya
      obtain ⟨r, hr, hrN⟩ := H c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hxa hya
      obtain ⟨⟨E', hE'N, hE'⟩, -⟩ := HYP c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx0 hy0
      obtain ⟨E₂, -, hE₂⟩ := HE₂ c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx2 hy2
      exact hE'N (hcl c₁ c₂ h2 h7 σ₂ σ' lam₂ lam' j₂ j' E₂ E' r hσ₂ hlam' (hrN hne) hE₂ hE' hr)
    · exfalso
      obtain ⟨c₁, c₂, h1, h2, h3, h4, h5, h6, h7, hx0, hy0, hx2, hy2, hxa, hya⟩ :=
        hpair x₂ y₂ xa ya hPx₂ hPy₂ hPxa hPya
      obtain ⟨n, hnN, hn⟩ := H c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hxa hya
      obtain ⟨⟨E', -, hE'⟩, -⟩ := HYP c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx0 hy0
      obtain ⟨E₂, hE₂N, hE₂⟩ := HE₂ c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx2 hy2
      exact hE₂N (hcl c₁ c₂ h2 h7 σ' σ₂ lam' lam₂ j' j₂ E' E₂ n hσ' hlam₂ hnN hE' hE₂ hn)
  refine ⟨by rw [hj]; exact hℓj', fun hpos => ?_, fun hneg => ?_⟩
  ·
    obtain ⟨M, rfl⟩ := Int.eq_ofNat_of_zero_le hpos.le
    have hM : 0 < M := by omega
    have hMt : (M : ℤ).toNat = M := by omega
    rw [hMt]
    rcases ValuationRing.dvd_total (c' ^ ℓ) lam₂ with ⟨q, hq⟩ | ⟨q, hq⟩
    · exfalso
      obtain ⟨c₁, c₂, h1, h2, h3, h4, h5, h6, h7, hx0, hy0, hx2, hy2, -, -⟩ :=
        hpair x₂ y₂ t₁ τ hPx₂ hPy₂ hPt₁ hPτ
      refine hKC3 c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx0 hy0 hx2 hy2
        (algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A q) *
          (algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) u) ^ M) ?_
      rw [hq]
      simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap,
        zpow_natCast, map_mul, map_pow]
      ring
    · obtain ⟨ρ₀, hρ₀⟩ := hroot q M hM
      by_cases hP : P ρ₀
      · exfalso
        obtain ⟨c₁, c₂, h1, h2, h3, h4, h5, h6, h7, hx0, hy0, hx2, hy2, hρc₁, -⟩ :=
          hpair x₂ y₂ ρ₀ τ hPx₂ hPy₂ hP hPτ
        obtain ⟨k', hk'⟩ := hρc₁
        have hs₁ : wcLlsInnerS₁ W A K u c₁ ∈ wcLlsInnerCR W A K u c₁ c₂ :=
          Algebra.subset_adjoin (Set.mem_insert _ _)
        have hcK' : algebraMap A K (algebraMap ↥W A c') ^ ℓ =
            algebraMap A K (algebraMap ↥W A lam₂) * algebraMap A K (algebraMap ↥W A ρ₀) ^ M := by
          have e : c' ^ ℓ = lam₂ * ρ₀ ^ M := by rw [hρ₀]; exact hq
          have := congrArg (fun t => algebraMap A K (algebraMap ↥W A t)) e
          simpa only [map_mul, map_pow] using this
        have hc₁K : algebraMap A K (algebraMap ↥W A c₁) =
            algebraMap A K (algebraMap ↥W A ρ₀) * algebraMap A K (algebraMap ↥W A k') := by
          rw [hk', map_mul, map_mul]
        have hUeq : algebraMap A K u ^ M = algebraMap A K (algebraMap ↥W A ρ₀) ^ M *
            algebraMap A K (algebraMap ↥W A k') ^ M * wcLlsInnerS₁ W A K u c₁ ^ M := by
          rw [hS₁eq c₁ h2, hc₁K]
          ring
        refine hKC3 c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx0 hy0 hx2 hy2
          (algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A (k' ^ M)) *
            ⟨_, hs₁⟩ ^ M) ?_
        simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap,
          zpow_natCast, map_mul, map_pow]
        rw [hcK', hUeq]
        ring
      · refine ⟨ρ₀, hP, dvd_of_eq ?_⟩
        rw [← hpw lam₂ ρ₀ M, hρ₀, ← hq, hpow]
  ·
    obtain ⟨J, hJ⟩ : ∃ J : ℕ, j₂ = -(J : ℤ) := ⟨(-j₂).toNat, by omega⟩
    subst hJ
    have hJt : (-(-(J : ℤ))).toNat = J := by omega
    have hJ0 : 0 < J := by omega
    rw [hJt]
    rcases ValuationRing.dvd_total lam₂ (c' ^ ℓ) with hd | ⟨q, hq⟩
    · refine ⟨t₁, hPt₁, ?_⟩
      rw [← hpow, ← hpw (c' ^ ℓ) t₁ J]
      exact pow_dvd_pow_of_dvd (dvd_mul_of_dvd_left hd _) _
    · obtain ⟨ρ₀, hρ₀⟩ := hroot q J hJ0
      by_cases hP : P ρ₀
      · refine ⟨ρ₀, hP, dvd_of_eq ?_⟩
        rw [← hpow, ← hpw (c' ^ ℓ) ρ₀ J, hρ₀, hq]
      · exfalso
        obtain ⟨c₁, c₂, h1, h2, h3, h4, h5, h6, h7, hx0, hy0, hx2, hy2, -, hc₂ρ⟩ :=
          hpair x₂ y₂ t₁ ρ₀ hPx₂ hPy₂ hPt₁ hP
        obtain ⟨k', hk'⟩ := hc₂ρ
        have hs₂ : wcLlsInnerS₂ W A K u c₂ ∈ wcLlsInnerCR W A K u c₁ c₂ :=
          Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
        have hlamK : algebraMap A K (algebraMap ↥W A lam₂) =
            algebraMap A K (algebraMap ↥W A c') ^ ℓ * algebraMap A K (algebraMap ↥W A ρ₀) ^ J := by
          have e : lam₂ = c' ^ ℓ * ρ₀ ^ J := by rw [hρ₀]; exact hq
          have := congrArg (fun t => algebraMap A K (algebraMap ↥W A t)) e
          simpa only [map_mul, map_pow] using this
        have hρK : algebraMap A K (algebraMap ↥W A ρ₀) =
            algebraMap A K (algebraMap ↥W A c₂) * algebraMap A K (algebraMap ↥W A k') := by
          rw [hk', map_mul, map_mul]
        have hUJ : algebraMap A K u ^ J ≠ 0 := pow_ne_zero _ hu0
        have hUJ' : (algebraMap A K u ^ J)⁻¹ * algebraMap A K u ^ J = 1 := inv_mul_cancel₀ hUJ
        refine hKC3 c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx0 hy0 hx2 hy2
          (algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A (k' ^ J)) *
            ⟨_, hs₂⟩ ^ J) ?_
        simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap,
          zpow_neg, zpow_natCast, map_mul, map_pow]
        rw [hlamK, hρK, hS₂eq c₂]
        linear_combination (algebraMap A K (algebraMap ↥W A c') ^ ℓ *
          algebraMap A K (algebraMap ↥W A k') ^ J * wcLlsInnerS₂ W A K u c₂ ^ J) * hUJ'

theorem wcpa_dj_llsm_kpwmgb_window_end : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ (f' : K) (a s : A), a ∉ 𝔭 → s ∉ 𝔭 → f' * algebraMap A K s = algebraMap A K a →
    ∀ (t₁ τ : ↥W) (P : ↥W → Prop), t₁ ∈ IsLocalRing.maximalIdeal ↥W → t₁ ≠ 0 → τ ∣ g →
      ¬ g ∣ τ → P t₁ → ¬ P τ → (∀ x y : ↥W, P x → y ∣ x → P y) →
      (∀ x : ↥W, P x → ∃ x' : ↥W, P x' ∧ x ∣ x' ∧ ¬ x' ∣ x) →
      (∀ y : ↥W, ¬ P y → ∃ y' : ↥W, ¬ P y' ∧ y' ∣ y ∧ ¬ y ∣ y') →
    ∀ (c' lam μT xT yT : ↥W) (j kT : ℤ), wcKpwmgbCtx W A K u g ℓ P c' lam j μT kT xT yT →
    ∀ (h : K) (z s' σ : A) (B : List (↥W × ℤ)) (x₀ y₀ : ↥W),
      ((μT = c' ^ ℓ ∧ kT = 0) ∨ (μT = lam ^ 2 ∧ kT = 2 * j)) →
      wcKpwmgbWin W A K 𝔭 u g f' ℓ P lam j μT kT h z s' σ B x₀ y₀ →
      (∀ b ∈ B, ¬ (ℓ : ℤ) ∣ b.2) →
      wcKpwmgbGood W A K 𝔭 u g ℓ P z ∨
        ∃ (σ₁ : A) (x₁ y₁ : ↥W), σ₁ ∉ 𝔭 ∧ P x₁ ∧ ¬ P y₁ ∧
          wcKpwmgbDeep W A K u g σ₁ z (lam ^ 2) (2 * j) x₁ y₁ :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ 𝔭 u v g hPD f' a s ha hs hf
    t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁ hPτ hdown hnomax hnomin
    c' lam μT xT yT j kT hCtx h z s' σ B x₀ y₀ hchoice hWin hnd
  classical
  have hPD' := hPD
  simp only [wcLlsPD] at hPD'
  obtain ⟨_, hNZ, _, h𝔭max, _, _, hg0, huv, h𝔭eq, _⟩ := hPD'
  haveI := hNZ
  have hφinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hψ0 : ∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0 := by
    intro w hw hc
    have h1 : algebraMap ↥W A w = 0 := hφinj (hc.trans (map_zero _).symm)
    rw [Algebra.algebraMap_eq_smul_one] at h1
    exact (smul_ne_zero hw one_ne_zero) h1
  have hu0 : algebraMap A K u ≠ 0 := by
    intro hc
    have h1 : algebraMap A K (u * v) = 0 := by rw [map_mul, hc, zero_mul]
    rw [huv] at h1
    exact hψ0 g hg0 h1

  have hS₁eq : ∀ c₁ : ↥W, c₁ ≠ 0 →
      algebraMap A K u = algebraMap A K (algebraMap ↥W A c₁) * wcLlsInnerS₁ W A K u c₁ := by
    intro c₁ hc₁
    unfold wcLlsInnerS₁
    rw [mul_div_assoc', eq_div_iff (hψ0 c₁ hc₁), mul_comm]
  have hS₂eq : ∀ c₂ : ↥W,
      algebraMap A K (algebraMap ↥W A c₂) = algebraMap A K u * wcLlsInnerS₂ W A K u c₂ := by
    intro c₂
    unfold wcLlsInnerS₂
    rw [mul_div_assoc', eq_div_iff hu0, mul_comm]
  have hS₁N : ∀ (c₁ c₂ : ↥W) (hs : wcLlsInnerS₁ W A K u c₁ ∈ wcLlsInnerCR W A K u c₁ c₂),
      (⟨_, hs⟩ : ↥(wcLlsInnerCR W A K u c₁ c₂)) ∈ wcLlsInnerCN W A K u c₁ c₂ := by
    intro c₁ c₂ hs
    unfold wcLlsInnerCN
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_iff.mpr (Or.inl rfl)))
  have hS₂N : ∀ (c₁ c₂ : ↥W) (hs : wcLlsInnerS₂ W A K u c₂ ∈ wcLlsInnerCR W A K u c₁ c₂),
      (⟨_, hs⟩ : ↥(wcLlsInnerCR W A K u c₁ c₂)) ∈ wcLlsInnerCN W A K u c₁ c₂ := by
    intro c₁ c₂ hs
    unfold wcLlsInnerCN
    exact Ideal.mem_sup_left (Ideal.subset_span
      (Set.mem_insert_iff.mpr (Or.inr (Set.mem_singleton_iff.mpr rfl))))
  have hmN : ∀ (c₁ c₂ : ↥W), ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A w) ∈
        wcLlsInnerCN W A K u c₁ c₂ := by
    intro c₁ c₂ w hw
    unfold wcLlsInnerCN
    have := Ideal.mem_map_of_mem
      ((algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂)).comp (algebraMap ↥W A)) hw
    exact Ideal.mem_sup_right this

  have hcomap : ∀ c₁ c₂ : ↥W, c₁ ≠ 0 → c₂ ∣ g → ∀ a ∈ 𝔭,
      algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a ∈ wcLlsInnerCN W A K u c₁ c₂ := by
    intro c₁ c₂ hc₁ hc₂g a ha
    rw [h𝔭eq] at ha
    have hle : Ideal.span {u, v} ⊔ Ideal.map (algebraMap ↥W A) (IsLocalRing.maximalIdeal ↥W) ≤
        (wcLlsInnerCN W A K u c₁ c₂).comap (algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂)) := by
      refine sup_le ?_ ?_
      · rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
        refine ⟨?_, ?_⟩
        · have hs₁ : wcLlsInnerS₁ W A K u c₁ ∈ wcLlsInnerCR W A K u c₁ c₂ :=
            Algebra.subset_adjoin (Set.mem_insert _ _)
          have e : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) u =
              algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A c₁) * ⟨_, hs₁⟩ := by
            apply Subtype.ext
            simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
            exact hS₁eq c₁ hc₁
          rw [SetLike.mem_coe, Ideal.mem_comap, e]
          exact Ideal.mul_mem_left _ _ (hS₁N c₁ c₂ hs₁)
        · obtain ⟨g₂, hg₂⟩ := hc₂g
          have hs₂ : wcLlsInnerS₂ W A K u c₂ ∈ wcLlsInnerCR W A K u c₁ c₂ :=
            Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
          have h1 : algebraMap A K u * algebraMap A K v =
              algebraMap A K (algebraMap ↥W A c₂) * algebraMap A K (algebraMap ↥W A g₂) := by
            rw [← map_mul, huv, hg₂]
            simp only [map_mul]
          have e : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) v =
              algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A g₂) * ⟨_, hs₂⟩ := by
            apply Subtype.ext
            simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
            apply mul_left_cancel₀ hu0
            linear_combination h1 + (algebraMap A K (algebraMap ↥W A g₂)) * hS₂eq c₂
          rw [SetLike.mem_coe, Ideal.mem_comap, e]
          exact Ideal.mul_mem_left _ _ (hS₂N c₁ c₂ hs₂)
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [Ideal.mem_comap]
        exact hmN c₁ c₂ w hw
    exact hle ha

  have habs : ∀ c₁ c₂ : ↥W, c₁ ≠ 0 → c₂ ∣ g → ∀ (a₀ : A) (E₂ : ↥(wcLlsInnerCR W A K u c₁ c₂)),
      a₀ ∉ 𝔭 → algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a₀ * E₂ ∈ wcLlsInnerCN W A K u c₁ c₂ →
      E₂ ∈ wcLlsInnerCN W A K u c₁ c₂ := by
    intro c₁ c₂ hc₁ hc₂ a₀ E₂ ha₀ hE
    obtain ⟨y, i, hi, hyi⟩ := Ideal.IsMaximal.exists_inv h𝔭max ha₀
    have h1 : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) y *
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a₀ +
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) i = 1 := by
      rw [← map_mul, ← map_add, hyi, map_one]
    have e : E₂ = algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) y *
        (algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a₀ * E₂) +
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) i * E₂ := by
      linear_combination (-E₂) * h1
    rw [e]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hE)
      (Ideal.mul_mem_right _ _ (hcomap c₁ c₂ hc₁ hc₂ i hi))

  have hWin' := hWin
  unfold wcKpwmgbWin at hWin'
  obtain ⟨_hh, hs', hz, hσ, hPx₀, hPy₀, _hcone, hNZB, hDIST, hWW⟩ := hWin'
  unfold wcKpwmgbCtx at hCtx
  obtain ⟨hc', _hlm, _hl0, _hconej, hμT0, hPxT, hPyT, hCP⟩ := hCtx
  have hs'σ : s' * σ ∉ 𝔭 := fun hm => (h𝔭max.isPrime.mem_or_mem hm).elim hs' hσ
  have hCI : ∀ x₁ y₁ x₂ y₂ : ↥W, P x₁ → ¬ P y₁ → P x₂ → ¬ P y₂ →
      ∃ x y : ↥W, P x ∧ ¬ P y ∧ x₁ ∣ x ∧ x₂ ∣ x ∧ y ∣ y₁ ∧ y ∣ y₂ := by
    intro x₁ y₁ x₂ y₂ h1 h2 h3 h4
    obtain ⟨x, hx, hx1, hx2⟩ : ∃ x : ↥W, P x ∧ x₁ ∣ x ∧ x₂ ∣ x :=
      (ValuationRing.dvd_total x₁ x₂).elim (fun hd => ⟨x₂, h3, hd, dvd_rfl⟩)
        (fun hd => ⟨x₁, h1, dvd_rfl, hd⟩)
    obtain ⟨y, hy, hy1, hy2⟩ : ∃ y : ↥W, ¬ P y ∧ y ∣ y₁ ∧ y ∣ y₂ :=
      (ValuationRing.dvd_total y₁ y₂).elim (fun hd => ⟨y₁, h2, dvd_rfl, hd⟩)
        (fun hd => ⟨y₂, h4, hd, dvd_rfl⟩)
    exact ⟨x, y, hx, hy, hx1, hx2, hy1, hy2⟩

  have hA : ∀ x y : ↥W, P x → ¬ P y →
      (∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
        c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
        x ∣ c₁ → c₂ ∣ y →
        ∃ E' : ↥(wcLlsInnerCR W A K u c₁ c₂),
          algebraMap A K σ * (f' / h ^ ℓ - 1) =
            algebraMap A K (algebraMap ↥W A μT) * algebraMap A K u ^ kT * (E' : K)) →
      wcKpwmgbGood W A K 𝔭 u g ℓ P z ∨
        ∃ (σ₁ : A) (x₁ y₁ : ↥W), σ₁ ∉ 𝔭 ∧ P x₁ ∧ ¬ P y₁ ∧
          wcKpwmgbDeep W A K u g σ₁ z (lam ^ 2) (2 * j) x₁ y₁ := by
    intro x y hPx hPy HF
    have HZ : ∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
        c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
        x ∣ c₁ → c₂ ∣ y →
        ∃ E : ↥(wcLlsInnerCR W A K u c₁ c₂),
          algebraMap A K σ * algebraMap A K z =
            algebraMap A K (algebraMap ↥W A μT) * algebraMap A K u ^ kT * (E : K) := by
      intro c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx hy
      obtain ⟨E', hE'⟩ := HF c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx hy
      refine ⟨algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) s' * E', ?_⟩
      simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
      rw [← hz]
      linear_combination (algebraMap A K s') * hE'
    rcases hchoice with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · left
      exact wcpa_dj_llsm_kpwmgb_encode_as Ω W hW hWt ℓ hℓ hΩ hκ A K 𝔭 u v g hPD t₁ τ P
        ht₁m ht₁0 hτg hgτ hPt₁ hPτ hdown hnomax hnomin z σ c' x y hσ hc' hPx hPy
        (fun c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx hy => by
          obtain ⟨E, hE⟩ := HZ c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx hy
          refine ⟨E, ?_⟩
          rw [hE, map_pow, map_pow, zpow_zero, mul_one])
    · right
      refine ⟨σ, x, y, hσ, hPx, hPy, ?_⟩
      unfold wcKpwmgbDeep
      exact HZ

  by_cases hB : B = []
  · subst hB
    apply hA x₀ y₀ hPx₀ hPy₀
    intro c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx hy
    obtain ⟨⟨E, hE⟩, -⟩ := hWW c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx hy
    refine ⟨E, ?_⟩
    have hL : wcKpwmgbLaur W A K u ([] : List (↥W × ℤ)) = 0 := by
      simp only [wcKpwmgbLaur, List.map_nil, List.sum_nil]
    rw [hL, sub_zero] at hE
    exact hE

  obtain ⟨b, hbB, xL, yL, hPxL, hPyL, hLead⟩ := wcpa_dj_llsm_kpwmgb_lead Ω W hW hWt A K 𝔭 u v g
    hPD t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁ hPτ hdown hnomax hnomin B hB hNZB hDIST
  rcases wcpa_dj_llsm_kpwmgb_cmp Ω W hW hWt A K 𝔭 u v g hPD t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁
      hPτ hdown hnomax hnomin b.1 μT b.2 kT (hNZB b hbB) hμT0 with
    ⟨xc, yc, hPxc, hPyc, hRc⟩ | ⟨xc, yc, hPxc, hPyc, hRc⟩
  ·
    obtain ⟨x1, y1, hPx1, hPy1, a1, a2, b1, b2⟩ := hCI x₀ y₀ xL yL hPx₀ hPy₀ hPxL hPyL
    obtain ⟨x, y, hPx, hPy, a3, a4, b3, b4⟩ := hCI x1 y1 xc yc hPx1 hPy1 hPxc hPyc
    apply hA x y hPx hPy
    intro c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx hy
    obtain ⟨⟨ET, hET⟩, -⟩ := hWW c₁ c₂ h1 h2 h3 h4 h5 h6 h7 (dvd_trans a1 (dvd_trans a3 hx))
      (dvd_trans hy (dvd_trans b3 b1))
    obtain ⟨⟨Es, -, hEs⟩, -⟩ := hLead c₁ c₂ h1 h2 h3 h4 h5 h6 h7
      (dvd_trans a2 (dvd_trans a3 hx)) (dvd_trans hy (dvd_trans b3 b2))
    obtain ⟨r, hr, -⟩ := hRc c₁ c₂ h1 h2 h3 h4 h5 h6 h7 (dvd_trans a4 hx) (dvd_trans hy b4)
    refine ⟨algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) σ * r * Es + ET, ?_⟩
    simp only [Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
    linear_combination hET + (algebraMap A K σ) * hEs + (algebraMap A K σ * (Es : K)) * hr
  ·
    obtain ⟨x1, y1, hPx1, hPy1, a1, a2, b1, b2⟩ := hCI x₀ y₀ xL yL hPx₀ hPy₀ hPxL hPyL
    obtain ⟨x2, y2, hPx2, hPy2, a3, a4, b3, b4⟩ := hCI xc yc xT yT hPxc hPyc hPxT hPyT
    obtain ⟨x, y, hPx, hPy, a5, a6, b5, b6⟩ := hCI x1 y1 x2 y2 hPx1 hPy1 hPx2 hPy2
    left
    refine wcpa_dj_llsm_kpwmgb_encode_ins Ω W hW hWt ℓ hℓ hΩ hκ A K 𝔭 u v g hPD t₁ τ P
      ht₁m ht₁0 hτg hgτ hPt₁ hPτ hdown hnomax hnomin z σ c' b.1 x y b.2 hσ (hNZB b hbB)
      (hnd b hbB) hc' hPx hPy ?_
    intro c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hx hy
    obtain ⟨⟨ET, hET⟩, -⟩ := hWW c₁ c₂ h1 h2 h3 h4 h5 h6 h7 (dvd_trans a1 (dvd_trans a5 hx))
      (dvd_trans hy (dvd_trans b5 b1))
    obtain ⟨⟨Es, hEsN, hEs⟩, -⟩ := hLead c₁ c₂ h1 h2 h3 h4 h5 h6 h7
      (dvd_trans a2 (dvd_trans a5 hx)) (dvd_trans hy (dvd_trans b5 b2))
    obtain ⟨n, hn, hneq⟩ := hRc c₁ c₂ h1 h2 h3 h4 h5 h6 h7 (dvd_trans a3 (dvd_trans a6 hx))
      (dvd_trans hy (dvd_trans b6 b3))
    obtain ⟨-, -, -, rc, hrc⟩ := hCP c₁ c₂ h1 h2 h3 h4 h5 h6 h7
      (dvd_trans a4 (dvd_trans a6 hx)) (dvd_trans hy (dvd_trans b6 b4))
    refine ⟨⟨algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (s' * σ) * Es +
        algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) s' * n * ET, ?_, ?_⟩,
      n * rc, Ideal.mul_mem_right _ _ hn, ?_⟩
    · intro hEN
      apply hEsN
      apply habs c₁ c₂ h2 h7 (s' * σ) Es hs'σ
      have e : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (s' * σ) * Es =
          (algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (s' * σ) * Es +
            algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) s' * n * ET) -
          algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) s' * n * ET := by ring
      rw [e]
      exact Ideal.sub_mem _ hEN (Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ hn))
    · simp only [Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_algebraMap, map_mul]
      rw [← hz]
      linear_combination (algebraMap A K s') * hET +
        (algebraMap A K s' * algebraMap A K σ) * hEs + (algebraMap A K s' * (ET : K)) * hneq
    · simp only [Subalgebra.coe_mul, MulMemClass.coe_mul]
      linear_combination hrc + (rc : K) * hneq

theorem wcpa_dj_llsm_kpwmgb_round : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ (f' : K) (a s : A), a ∉ 𝔭 → s ∉ 𝔭 → f' * algebraMap A K s = algebraMap A K a →
    ∀ (t₁ τ : ↥W) (P : ↥W → Prop), t₁ ∈ IsLocalRing.maximalIdeal ↥W → t₁ ≠ 0 → τ ∣ g →
      ¬ g ∣ τ → P t₁ → ¬ P τ → (∀ x y : ↥W, P x → y ∣ x → P y) →
      (∀ x : ↥W, P x → ∃ x' : ↥W, P x' ∧ x ∣ x' ∧ ¬ x' ∣ x) →
      (∀ y : ↥W, ¬ P y → ∃ y' : ↥W, ¬ P y' ∧ y' ∣ y ∧ ¬ y ∣ y') →
    ∀ (h : K) (z s' σ : A) (c' lam x₀ y₀ : ↥W) (j : ℤ), h ≠ 0 → s' ∉ 𝔭 →
      algebraMap A K s' * (f' / h ^ ℓ - 1) = algebraMap A K z → σ ∉ 𝔭 →
      c' ^ (ℓ - 1) = ((ℓ : ℕ) : ↥W) → lam ∈ IsLocalRing.maximalIdeal ↥W → lam ≠ 0 →
      (j < 0 → g ^ (-j).toNat ∣ lam) → P x₀ → ¬ P y₀ →
      wcKpwmgbDeep W A K u g σ z lam j x₀ y₀ →
    ∃ (h₁ : K) (z₁ s₁ : A), h₁ ≠ 0 ∧ s₁ ∉ 𝔭 ∧
      algebraMap A K s₁ * (f' / h₁ ^ ℓ - 1) = algebraMap A K z₁ ∧
      (wcKpwmgbGood W A K 𝔭 u g ℓ P z₁ ∨
        ∃ (σ₁ : A) (x₁ y₁ : ↥W), σ₁ ∉ 𝔭 ∧ P x₁ ∧ ¬ P y₁ ∧
          wcKpwmgbDeep W A K u g σ₁ z₁ (lam ^ 2) (2 * j) x₁ y₁) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ 𝔭 u v g hPD f' a s ha hs hf
    t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁ hPτ hdown hnomax hnomin
    h z s' σ c' lam x₀ y₀ j hh hs' hz hσ hc' hlm hl0 hcone hPx₀ hPy₀ hD
  classical
  have hℓ2 := hℓ.two_le
  have hℓW : ((ℓ : ℕ) : ↥W) ≠ 0 := by
    intro hc
    have h1 : ((ℓ : ℕ) : Ω) = 0 := by
      have := congrArg (fun w : ↥W => (w : Ω)) hc
      simpa using this
    have h2 : ringChar Ω ∣ ℓ := (ringChar.spec Ω ℓ).mp h1
    rcases (Nat.dvd_prime hℓ).mp h2 with h3 | h3
    · have h4 : ((1 : ℕ) : Ω) = 0 := (ringChar.spec Ω 1).mpr (by rw [h3])
      simp at h4
    · exact hΩ h3
  have hc'0 : c' ≠ 0 := by
    rintro rfl
    rw [zero_pow (by omega)] at hc'
    exact hℓW hc'.symm
  have hcl0 : c' ^ ℓ ≠ 0 := pow_ne_zero _ hc'0
  have hl20 : lam ^ 2 ≠ 0 := pow_ne_zero _ hl0
  have hM : algebraMap A K (algebraMap ↥W A (c' ^ ℓ)) =
      algebraMap A K (algebraMap ↥W A c') ^ ℓ := by
    rw [map_pow, map_pow]

  have hCI : ∀ x₁ y₁ x₂ y₂ : ↥W, P x₁ → ¬ P y₁ → P x₂ → ¬ P y₂ →
      ∃ x y : ↥W, P x ∧ ¬ P y ∧ x₁ ∣ x ∧ x₂ ∣ x ∧ y ∣ y₁ ∧ y ∣ y₂ := by
    intro x₁ y₁ x₂ y₂ h1 h2 h3 h4
    obtain ⟨x, hx, hx1, hx2⟩ : ∃ x : ↥W, P x ∧ x₁ ∣ x ∧ x₂ ∣ x :=
      (ValuationRing.dvd_total x₁ x₂).elim (fun hd => ⟨x₂, h3, hd, dvd_rfl⟩)
        (fun hd => ⟨x₁, h1, dvd_rfl, hd⟩)
    obtain ⟨y, hy, hy1, hy2⟩ : ∃ y : ↥W, ¬ P y ∧ y ∣ y₁ ∧ y ∣ y₂ :=
      (ValuationRing.dvd_total y₁ y₂).elim (fun hd => ⟨y₁, h2, dvd_rfl, hd⟩)
        (fun hd => ⟨y₂, h4, hd, dvd_rfl⟩)
    exact ⟨x, y, hx, hy, hx1, hx2, hy1, hy2⟩

  rcases wcpa_dj_llsm_kpwmgb_cmp Ω W hW hWt A K 𝔭 u v g hPD t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁
      hPτ hdown hnomax hnomin (c' ^ ℓ) lam 0 j hcl0 hl0 with
    ⟨xa, ya, hPxa, hPya, hRa⟩ | ⟨xa, ya, hPxa, hPya, hRa⟩
  swap
  · obtain ⟨x, y, hPx, hPy, hx1, hx2, hy1, hy2⟩ := hCI x₀ y₀ xa ya hPx₀ hPy₀ hPxa hPya
    have hGood := wcpa_dj_llsm_kpwmgb_encode_as Ω W hW hWt ℓ hℓ hΩ hκ A K 𝔭 u v g hPD t₁ τ P
      ht₁m ht₁0 hτg hgτ hPt₁ hPτ hdown hnomax hnomin z σ c' x y hσ hc' hPx hPy
      (fun c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hxc hcy => by
        obtain ⟨E, hE⟩ := hD c₁ c₂ h1 h2 h3 h4 h5 h6 h7 (dvd_trans hx1 hxc) (dvd_trans hcy hy1)
        obtain ⟨n, _, hn⟩ := hRa c₁ c₂ h1 h2 h3 h4 h5 h6 h7 (dvd_trans hx2 hxc)
          (dvd_trans hcy hy2)
        refine ⟨n * E, ?_⟩
        rw [hE, hn, hM, zpow_zero, MulMemClass.coe_mul]
        ring)
    exact ⟨h, z, s', hh, hs', hz, Or.inl hGood⟩

  obtain ⟨μT, kT, xT, yT, hchoice, hCtx⟩ : ∃ (μT : ↥W) (kT : ℤ) (xT yT : ↥W),
      ((μT = c' ^ ℓ ∧ kT = 0) ∨ (μT = lam ^ 2 ∧ kT = 2 * j)) ∧
        wcKpwmgbCtx W A K u g ℓ P c' lam j μT kT xT yT := by
    rcases wcpa_dj_llsm_kpwmgb_cmp Ω W hW hWt A K 𝔭 u v g hPD t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁
        hPτ hdown hnomax hnomin (c' ^ ℓ) (lam ^ 2) 0 (2 * j) hcl0 hl20 with
      ⟨xb, yb, hPxb, hPyb, hRb⟩ | ⟨xb, yb, hPxb, hPyb, hRb⟩
    · obtain ⟨x, y, hPx, hPy, hx1, hx2, hy1, hy2⟩ := hCI xa ya xb yb hPxa hPya hPxb hPyb
      refine ⟨lam ^ 2, 2 * j, x, y, Or.inr ⟨rfl, rfl⟩, ?_⟩
      unfold wcKpwmgbCtx
      refine ⟨hc', hlm, hl0, hcone, hl20, hPx, hPy, ?_⟩
      intro c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hxc hcy
      obtain ⟨ra, hra, -⟩ := hRa c₁ c₂ h1 h2 h3 h4 h5 h6 h7 (dvd_trans hx1 hxc)
        (dvd_trans hcy hy1)
      obtain ⟨rb, hrb, -⟩ := hRb c₁ c₂ h1 h2 h3 h4 h5 h6 h7 (dvd_trans hx2 hxc)
        (dvd_trans hcy hy2)
      obtain ⟨n, -, hn⟩ := wcpa_dj_llsm_kpwmgb_mono Ω W hW hWt A K 𝔭 u v g hPD lam j hlm hcone
        c₁ c₂ h1 h2 h3 h4 h5 h6 h7
      have e2 : algebraMap A K u ^ (2 * j) = (algebraMap A K u ^ j) ^ 2 := by
        rw [mul_comm, zpow_mul]
        norm_cast
      refine ⟨⟨ra, ?_⟩, ⟨n, ?_⟩, ⟨1, ?_⟩, ⟨rb, ?_⟩⟩
      · rw [← hra, hM, zpow_zero, mul_one]
      · rw [← hn, map_pow, map_pow, e2]
        ring
      · rw [OneMemClass.coe_one, mul_one]
      · rw [← hrb, hM, zpow_zero, mul_one]
    · obtain ⟨x, y, hPx, hPy, hx1, hx2, hy1, hy2⟩ := hCI xa ya xb yb hPxa hPya hPxb hPyb
      refine ⟨c' ^ ℓ, 0, x, y, Or.inl ⟨rfl, rfl⟩, ?_⟩
      unfold wcKpwmgbCtx
      refine ⟨hc', hlm, hl0, hcone, hcl0, hPx, hPy, ?_⟩
      intro c₁ c₂ h1 h2 h3 h4 h5 h6 h7 hxc hcy
      obtain ⟨ra, hra, -⟩ := hRa c₁ c₂ h1 h2 h3 h4 h5 h6 h7 (dvd_trans hx1 hxc)
        (dvd_trans hcy hy1)
      obtain ⟨n, -, hn⟩ := hRb c₁ c₂ h1 h2 h3 h4 h5 h6 h7 (dvd_trans hx2 hxc)
        (dvd_trans hcy hy2)
      refine ⟨⟨ra, ?_⟩, ⟨ra, hra⟩, ⟨n, hn⟩, ⟨1, ?_⟩⟩
      · rw [← hra, hM, zpow_zero, mul_one]
      · rw [hM, zpow_zero, mul_one, OneMemClass.coe_one, mul_one]

  obtain ⟨σ₁, B, x₁, y₁, hWin⟩ := wcpa_dj_llsm_kpwmgb_window_init Ω W hW hWt ℓ hℓ hΩ hκ A K 𝔭
    u v g hPD f' a s ha hs hf t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁ hPτ hdown hnomax hnomin
    c' lam μT xT yT j kT hCtx h z s' σ x₀ y₀ hh hs' hz hσ hPx₀ hPy₀ hD

  have key : ∀ n : ℕ, ∀ (h : K) (z s' σ : A) (B : List (↥W × ℤ)) (x₀ y₀ : ↥W),
      wcKpwmgbPhi ℓ B = n → wcKpwmgbWin W A K 𝔭 u g f' ℓ P lam j μT kT h z s' σ B x₀ y₀ →
      ∃ (h₁ : K) (z₁ s₁ : A), h₁ ≠ 0 ∧ s₁ ∉ 𝔭 ∧
        algebraMap A K s₁ * (f' / h₁ ^ ℓ - 1) = algebraMap A K z₁ ∧
        (wcKpwmgbGood W A K 𝔭 u g ℓ P z₁ ∨
          ∃ (σ₁ : A) (x₁ y₁ : ↥W), σ₁ ∉ 𝔭 ∧ P x₁ ∧ ¬ P y₁ ∧
            wcKpwmgbDeep W A K u g σ₁ z₁ (lam ^ 2) (2 * j) x₁ y₁) := by
    intro n
    refine Nat.strong_induction_on n ?_
    intro n ih h z s' σ B x₀ y₀ hn hWn
    by_cases hex : ∃ b ∈ B, (ℓ : ℤ) ∣ b.2
    · obtain ⟨b, hbB, m, hm⟩ := hex
      have hbB' : (b.1, (ℓ : ℤ) * m) ∈ B := by
        rw [← hm]
        exact hbB
      by_cases hm0 : m = 0
      · rw [hm0, mul_zero] at hbB'
        obtain ⟨h₁, z₁, s₁, σ₂, B₁, x₂, y₂, hW₁, hlt⟩ := wcpa_dj_llsm_kpwmgb_move_zero Ω W hW hWt
          ℓ hℓ hΩ hκ A K 𝔭 u v g hPD f' a s ha hs hf t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁ hPτ hdown
          hnomax hnomin c' lam μT xT yT j kT hCtx h z s' σ B x₀ y₀ b.1 hWn hbB'
        exact ih _ (by rw [← hn]; exact hlt) h₁ z₁ s₁ σ₂ B₁ x₂ y₂ rfl hW₁
      · obtain ⟨h₁, z₁, s₁, σ₂, B₁, x₂, y₂, hW₁, hlt⟩ := wcpa_dj_llsm_kpwmgb_move_nz Ω W hW hWt
          ℓ hℓ hΩ hκ A K 𝔭 u v g hPD f' a s ha hs hf t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁ hPτ hdown
          hnomax hnomin c' lam μT xT yT j kT hCtx h z s' σ B x₀ y₀ b.1 m hWn hbB' hm0
        exact ih _ (by rw [← hn]; exact hlt) h₁ z₁ s₁ σ₂ B₁ x₂ y₂ rfl hW₁
    · push_neg at hex
      have hend := wcpa_dj_llsm_kpwmgb_window_end Ω W hW hWt ℓ hℓ hΩ hκ A K 𝔭 u v g hPD f' a s
        ha hs hf t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁ hPτ hdown hnomax hnomin c' lam μT xT yT j kT hCtx
        h z s' σ B x₀ y₀ hchoice hWn hex
      obtain ⟨hh1, hs1, hz1, -⟩ := hWn
      exact ⟨h, z, s', hh1, hs1, hz1, hend⟩
  exact key _ h z s' σ₁ B x₁ y₁ rfl hWin

theorem wcpa_dj_llsm_kpwmg_cut_best_approx : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ (f' : K) (a s : A), a ∉ 𝔭 → s ∉ 𝔭 → f' * algebraMap A K s = algebraMap A K a →
    ∀ (t₁ τ : ↥W) (P : ↥W → Prop), t₁ ∈ IsLocalRing.maximalIdeal ↥W → t₁ ≠ 0 → τ ∣ g →
      ¬ g ∣ τ → P t₁ → ¬ P τ → (∀ x y : ↥W, P x → y ∣ x → P y) →
      (∀ x : ↥W, P x → ∃ x' : ↥W, P x' ∧ x ∣ x' ∧ ¬ x' ∣ x) →
      (∀ y : ↥W, ¬ P y → ∃ y' : ↥W, ¬ P y' ∧ y' ∣ y ∧ ¬ y ∣ y') →
    ∃ (h : K) (z s' : A), h ≠ 0 ∧ s' ∉ 𝔭 ∧ algebraMap A K s' * (f' / h ^ ℓ - 1) = algebraMap A K z ∧
      ∀ (σ : A) (lam : ↥W) (j : ℤ) (x₀ y₀ : ↥W), σ ∉ 𝔭 → lam ≠ 0 →
        (j < 0 → g ^ (-j).toNat ∣ lam) → P x₀ → ¬ P y₀ →
        (∀ c₁ c₂ : ↥W, c₁ ∈ IsLocalRing.maximalIdeal ↥W → c₁ ≠ 0 →
          c₂ ∈ IsLocalRing.maximalIdeal ↥W → c₂ ≠ 0 → c₁ ∣ c₂ → ¬ c₂ ∣ c₁ → c₂ ∣ g →
          x₀ ∣ c₁ → c₂ ∣ y₀ →
          ∃ E : ↥(wcLlsInnerCR W A K u c₁ c₂), E ∉ wcLlsInnerCN W A K u c₁ c₂ ∧
            algebraMap A K σ * algebraMap A K z =
              algebraMap A K (algebraMap ↥W A lam) * algebraMap A K u ^ j * (E : K)) →
        ((∀ c : ↥W, c ^ (ℓ - 1) = ((ℓ : ℕ) : ↥W) →
            (0 ≤ j → ∃ ρ : ↥W, P ρ ∧ c ^ ℓ ∣ lam * ρ ^ j.toNat) ∧
            (j < 0 → ∃ ρ : ↥W, ¬ P ρ ∧ c ^ ℓ * ρ ^ (-j).toNat ∣ lam)) ∨
          (¬ (ℓ : ℤ) ∣ j ∧
            (0 < j → ∃ ρ : ↥W, ¬ P ρ ∧
              lam ^ (ℓ - 1) * ρ ^ ((ℓ - 1) * j.toNat) ∣ ((ℓ : ℕ) : ↥W) ^ ℓ) ∧
            (j < 0 → ∃ ρ : ↥W, P ρ ∧
              lam ^ (ℓ - 1) ∣ ((ℓ : ℕ) : ↥W) ^ ℓ * ρ ^ ((ℓ - 1) * (-j).toNat)))) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ 𝔭 u v g hPD f' a s ha hs hf
    t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁ hPτ hdown hnomax hnomin
  classical
  have hroot : ∀ (w : ↥W) (n : ℕ), 0 < n → ∃ r : ↥W, r ^ n = w := by
    intro w n hn
    obtain ⟨r, hr⟩ := IsAlgClosed.exists_pow_nat_eq (w : Ω) hn
    have hrW : r ∈ W := by
      rcases W.mem_or_inv_mem r with h | h
      · exact h
      · by_cases hr0 : r = 0
        · rw [hr0]; exact W.zero_mem
        · have e : r = r ^ n * r⁻¹ ^ (n - 1) := by
            obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
            rw [Nat.add_sub_cancel, pow_succ, mul_comm (r ^ k) r, mul_assoc, ← mul_pow,
              mul_inv_cancel₀ hr0, one_pow, mul_one]
          rw [e, hr]
          exact mul_mem w.2 (pow_mem h _)
    exact ⟨⟨r, hrW⟩, Subtype.ext (by simpa using hr)⟩
  have hℓ2 := hℓ.two_le
  have hℓW : ((ℓ : ℕ) : ↥W) ≠ 0 := by
    intro hc
    have h1 : ((ℓ : ℕ) : Ω) = 0 := by
      have := congrArg (fun w : ↥W => (w : Ω)) hc
      simpa using this
    have h2 : ringChar Ω ∣ ℓ := (ringChar.spec Ω ℓ).mp h1
    rcases (Nat.dvd_prime hℓ).mp h2 with h3 | h3
    · have h4 : ((1 : ℕ) : Ω) = 0 := (ringChar.spec Ω 1).mpr (by rw [h3])
      simp at h4
    · exact hΩ h3
  obtain ⟨c', hc'⟩ := hroot ((ℓ : ℕ) : ↥W) (ℓ - 1) (by omega)
  have hc'0 : c' ≠ 0 := by
    rintro rfl
    rw [zero_pow (by omega)] at hc'
    exact hℓW hc'.symm
  obtain ⟨h0, z0, s0, σ0, lam0, j0, x0, y0, hh0, hs0, hz0, hσ0, hlm, hl0, hcone, hPx0, hPy0,
    hdeep⟩ := wcpa_dj_llsm_kpwmgb_start Ω W hW hWt ℓ hℓ hΩ hκ A K 𝔭 u v g hPD f' a s ha hs hf
      t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁ hPτ hdown hnomax hnomin
  by_contra hGoal
  have hiter : ∀ k : ℕ, ∃ (h : K) (z s' σ : A) (x y : ↥W), h ≠ 0 ∧ s' ∉ 𝔭 ∧
      algebraMap A K s' * (f' / h ^ ℓ - 1) = algebraMap A K z ∧ σ ∉ 𝔭 ∧ P x ∧ ¬ P y ∧
      wcKpwmgbDeep W A K u g σ z (lam0 ^ 2 ^ k) (((2 ^ k : ℕ) : ℤ) * j0) x y := by
    intro k
    induction k with
    | zero =>
      have e1 : lam0 ^ 2 ^ 0 = lam0 := by simp
      have e2 : ((2 ^ 0 : ℕ) : ℤ) * j0 = j0 := by simp
      rw [e1, e2]
      exact ⟨h0, z0, s0, σ0, x0, y0, hh0, hs0, hz0, hσ0, hPx0, hPy0, hdeep⟩
    | succ k ih =>
      obtain ⟨h, z, s', σ, x, y, hh, hs', hz, hσ, hPx, hPy, hD⟩ := ih
      have hlm' : lam0 ^ 2 ^ k ∈ IsLocalRing.maximalIdeal ↥W :=
        Ideal.pow_mem_of_mem _ hlm _ (by positivity)
      have hl0' : lam0 ^ 2 ^ k ≠ 0 := pow_ne_zero _ hl0
      have hcone' : ((2 ^ k : ℕ) : ℤ) * j0 < 0 →
          g ^ (-(((2 ^ k : ℕ) : ℤ) * j0)).toNat ∣ lam0 ^ 2 ^ k := by
        intro hneg
        have hj0 : j0 < 0 := by
          by_contra hc
          push_neg at hc
          have : (0 : ℤ) ≤ ((2 ^ k : ℕ) : ℤ) * j0 := mul_nonneg (by positivity) hc
          linarith
        have hJ : ((-j0).toNat : ℤ) = -j0 := Int.toNat_of_nonneg (by omega)
        have e : -(((2 ^ k : ℕ) : ℤ) * j0) = (((-j0).toNat * 2 ^ k : ℕ) : ℤ) := by
          rw [Nat.cast_mul, hJ]
          ring
        rw [e, Int.toNat_natCast, pow_mul]
        exact pow_dvd_pow_of_dvd (hcone hj0) _
      obtain ⟨h₁, z₁, s₁, hh₁, hs₁, hz₁, hor⟩ := wcpa_dj_llsm_kpwmgb_round Ω W hW hWt ℓ hℓ hΩ hκ
        A K 𝔭 u v g hPD f' a s ha hs hf t₁ τ P ht₁m ht₁0 hτg hgτ hPt₁ hPτ hdown hnomax hnomin
        h z s' σ c' (lam0 ^ 2 ^ k) x y (((2 ^ k : ℕ) : ℤ) * j0) hh hs' hz hσ hc' hlm' hl0'
        hcone' hPx hPy hD
      rcases hor with hG | ⟨σ₁, x₁, y₁, hσ₁, hPx₁, hPy₁, hD₁⟩
      · exact absurd ⟨h₁, z₁, s₁, hh₁, hs₁, hz₁, hG⟩ hGoal
      · have e1 : (lam0 ^ 2 ^ k) ^ 2 = lam0 ^ 2 ^ (k + 1) := by
          rw [← pow_mul, pow_succ]
        have e2 : 2 * (((2 ^ k : ℕ) : ℤ) * j0) = ((2 ^ (k + 1) : ℕ) : ℤ) * j0 := by
          push_cast
          ring
        rw [e1, e2] at hD₁
