    exact hα1 ⟨x + h, by rw [map_add, hx]; ring⟩
  obtain ⟨k1, k2, Z, Y, d, e, hR⟩ :=
    wcFrf_rep_exists Ω W hW hWt A K 𝔭 t hPD (f₀ - (h ^ ℓ - h)) hF0
  have hk1 : k1 ≠ 0 := hR.1
  have hk2 : k2 ≠ 0 := hR.2.1
  have hε₀0 : algebraMap A' K ε₀ ≠ 0 := by
    intro h0
    apply hε₀
    rw [(map_eq_zero_iff _ (IsFractionRing.injective A' K)).mp h0]
    exact Ideal.zero_mem _
  have hε₁0 : algebraMap A' K ε₁ ≠ 0 := by
    intro h0
    apply hε₁
    rw [(map_eq_zero_iff _ (IsFractionRing.injective A' K)).mp h0]
    exact Ideal.zero_mem _

  obtain ⟨lamS, hlamSm, hD'⟩ : ∃ lamS : ↥W, lamS ∈ IsLocalRing.maximalIdeal ↥W ∧
      ((lam₂ ∣ lam₁ ∧ (n ≤ k ∨ ∃ lam' : ↥W, lam₁ = lam₂ * lam' ∧ lamS ∣ lam')) ∨
        ¬ (ℓ : ℤ) ∣ ((k : ℤ) - n)) := by
    rcases hD with ⟨hdv, hnk | ⟨lam', hl', hl'm⟩⟩ | hnd
    · exact ⟨0, Ideal.zero_mem _, Or.inl ⟨hdv, Or.inl hnk⟩⟩
    · exact ⟨lam', hl'm, Or.inl ⟨hdv, Or.inr ⟨lam', hl', dvd_rfl⟩⟩⟩
    · exact ⟨0, Ideal.zero_mem _, Or.inr hnd⟩

  have hμex : ∀ z : ↥W, ∃ μ : ↥W, μ ∈ IsLocalRing.maximalIdeal ↥W ∧
      (a ∣ z - c ∨ a = (z - c) * μ) := by
    intro z
    by_cases hd : a ∣ z - c
    · exact ⟨0, Ideal.zero_mem _, Or.inl hd⟩
    · rcases ValuationRing.dvd_total a (z - c) with h' | ⟨μ, hμ⟩
      · exact absurd h' hd
      · refine ⟨μ, ?_, Or.inr hμ⟩
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        apply hd
        rw [hμ]
        exact hu.mul_right_dvd.mpr dvd_rfl
  choose μf hμfm hμf using hμex
  have hSm : ∀ s ∈ w :: lamS :: a :: (Z ++ Y).map μf, s ∈ IsLocalRing.maximalIdeal ↥W := by
    intro s hs
    rcases List.mem_cons.mp hs with h1 | hs
    · rw [h1]; exact hw
    rcases List.mem_cons.mp hs with h1 | hs
    · rw [h1]; exact hlamSm
    rcases List.mem_cons.mp hs with h1 | hs
    · rw [h1]; exact ha
    obtain ⟨z, _, rfl⟩ := List.mem_map.mp hs
    exact hμfm z
  obtain ⟨g, hgm, hg0, hgS⟩ := hcommon _ hSm
  obtain ⟨ρ', hρ'm, hρ'0, hρ'g⟩ := hroot g hgm hg0 (n + k + 1)
  have hdivτ : ∀ τ : ↥W, τ ∣ ρ' → τ ^ (n + k + 1 + 1) ∣ w ∧ τ ^ (n + k + 1 + 1) ∣ lamS ∧
      τ ^ (n + k + 1 + 1) ∣ a := by
    intro τ hτ
    have h1 : τ ^ (n + k + 1 + 1) ∣ g := hρ'g ▸ pow_dvd_pow_of_dvd hτ _
    exact ⟨h1.trans (hgS w (by simp)), h1.trans (hgS lamS (by simp)), h1.trans (hgS a (by simp))⟩
  have hwin : ∀ z ∈ Z ++ Y, a ∣ z - c ∨ (z - c) * ρ' ∣ a := by
    intro z hz
    rcases hμf z with h1 | h1
    · exact Or.inl h1
    · right
      have h2 : ρ' ∣ μf z := (dvd_pow_self ρ' (by omega : n + k + 1 + 1 ≠ 0)).trans
        (by rw [hρ'g]; exact hgS (μf z) (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
          (List.mem_cons_of_mem _ (List.mem_map.mpr ⟨z, hz, rfl⟩)))))
      rw [h1]
      exact mul_dvd_mul_left _ h2

  obtain ⟨C, N, hCN⟩ : ∃ (C : List ↥W → ↥W) (N : List ↥W → ℕ), ∀ X,
      C X = ((X.filter (fun x => @decide (¬ a ∣ x - c) (Classical.propDecidable _))).map
        (fun x => x - c)).prod ∧
      N X = (X.filter (fun x => @decide (a ∣ x - c) (Classical.propDecidable _))).length :=
    ⟨_, _, fun X => ⟨rfl, rfl⟩⟩
  have hequiv : ∀ ρ τ : ↥W, ρ ≠ 0 → ρ * τ = a → ¬ ρ' ∣ τ → ∀ x ∈ Z ++ Y,
      (ρ ∣ x - c ↔ a ∣ x - c) := by
    intro ρ τ hρ0 hρτ hnτ x hx
    constructor
    · intro hρx
      by_contra hax
      rcases hwin x hx with h1 | h1
      · exact hax h1
      · obtain ⟨e', he'⟩ := hρx
        apply hnτ
        rw [he', ← hρτ, mul_assoc] at h1
        exact (dvd_mul_left ρ' e').trans ((mul_dvd_mul_iff_left hρ0).mp h1)
    · intro hax
      exact (Dvd.intro τ hρτ).trans hax
  have hshape : ∀ ρ τ : ↥W, ρ ≠ 0 → ρ * τ = a → ¬ ρ' ∣ τ → ∀ X : List ↥W,
      (∀ x ∈ X, x ∈ Z ++ Y) →
      wcFrfP W c ρ X = C X * ρ ^ N X ∧
      (X.filter (fun x => @decide (ρ ∣ x - c) (Classical.propDecidable _))).length = N X := by
    intro ρ τ hρ0 hρτ hnτ X hX
    have h1 : X.filter (fun x => @decide (ρ ∣ x - c) (Classical.propDecidable _)) =
        X.filter (fun x => @decide (a ∣ x - c) (Classical.propDecidable _)) :=
      List.filter_congr (fun x hx => decide_eq_decide.mpr (hequiv ρ τ hρ0 hρτ hnτ x (hX x hx)))
    have h2 : X.filter (fun x => @decide (¬ ρ ∣ x - c) (Classical.propDecidable _)) =
        X.filter (fun x => @decide (¬ a ∣ x - c) (Classical.propDecidable _)) :=
      List.filter_congr (fun x hx =>
        decide_eq_decide.mpr (not_congr (hequiv ρ τ hρ0 hρτ hnτ x (hX x hx))))
    refine ⟨?_, by rw [h1, (hCN X).2]⟩
    unfold wcFrfP
    rw [h1, h2, (hCN X).1, (hCN X).2]
  have hC0 : ∀ X : List ↥W, C X ≠ 0 := by
    intro X h0
    rw [(hCN X).1] at h0
    simp only [List.prod_eq_zero_iff, List.mem_map, List.mem_filter] at h0
    obtain ⟨x, ⟨_, hd⟩, hx0⟩ := h0
    have hna : ¬ a ∣ x - c := by simpa using hd
    exact hna (by rw [hx0]; exact dvd_zero a)

  have hgauss : ∀ ρ τ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 →
      τ ∈ IsLocalRing.maximalIdeal ↥W → τ ≠ 0 → ρ * τ = a → τ ^ (n + k + 1) ∣ ρ →
      τ ^ (n + k + 1) ∣ w →
      k2 * wcFrfP W c ρ Y * lam₁ * τ ^ k ∣ k1 * wcFrfP W c ρ Z * lam₂ * τ ^ n ∧
        k1 * wcFrfP W c ρ Z * lam₂ * τ ^ n ∣ k2 * wcFrfP W c ρ Y * lam₁ * τ ^ k := by
    intro ρ τ hρm hρ0 hτm hτ0 hρτ hτρ hτw
    obtain ⟨hA'O, hunit⟩ := hCT Ω W A K 𝔭 t c a O A' u' v' 𝔭' hPD hc hO hz
      hBr hu' hv' hPD' ρ τ hρm hρ0 hτm hτ0 hρτ
    obtain ⟨hVI, hVII, hVIV⟩ := hO ρ hρm hρ0
    have hmemle : ∀ x : K, (O ρ).valuation x ≤ 1 ↔ x ∈ O ρ :=
      fun x => (O ρ).valuation_le_one_iff x
    have hvne : ∀ x : ↥W, x ≠ 0 → (O ρ).valuation (algebraMap A K (algebraMap ↥W A x)) ≠ 0 :=
      fun x hx => ((O ρ).valuation.ne_zero_iff).mpr (hF0a x hx)
    have hF1 : ∀ a : A, (O ρ).valuation (algebraMap A K a) ≤ 1 :=
      fun a => (hmemle _).mpr (hVIV a)
    have hF2 : ∀ w₁ w₂ : ↥W, w₁ ≠ 0 → w₂ ≠ 0 →
        (O ρ).valuation (algebraMap A K (algebraMap ↥W A w₁)) ≤
          (O ρ).valuation (algebraMap A K (algebraMap ↥W A w₂)) → w₂ ∣ w₁ := by
      intro w₁ w₂ h1 h2 hle
      apply hVII w₁ w₂ h1 h2
      rw [← hmemle, Valuation.map_div]
      exact (div_le_one₀ (zero_lt_iff.mpr (hvne w₂ h2))).mpr hle
    have hveq : ∀ x y : K, x ≠ 0 → y ≠ 0 → x / y ∈ O ρ → y / x ∈ O ρ →
        (O ρ).valuation x = (O ρ).valuation y := by
      intro x y hx hy h1 h2
      rw [← hmemle, Valuation.map_div] at h1 h2
      have hx' : 0 < (O ρ).valuation x := zero_lt_iff.mpr (((O ρ).valuation.ne_zero_iff).mpr hx)
      have hy' : 0 < (O ρ).valuation y := zero_lt_iff.mpr (((O ρ).valuation.ne_zero_iff).mpr hy)
      exact le_antisymm ((div_le_one₀ hy').mp h1) ((div_le_one₀ hx').mp h2)
    set r := (O ρ).valuation (algebraMap A K (algebraMap ↥W A τ)) with hr
    have hr0 : 0 < r := zero_lt_iff.mpr (hvne τ hτ0)
    have hr1 : r < 1 := by
      by_contra hcon
      push_neg at hcon
      have hd : τ ∣ 1 := hF2 1 τ one_ne_zero hτ0 (by simpa using hcon)
      have := (IsLocalRing.mem_maximalIdeal _).mp hτm
      rw [mem_nonunits_iff] at this
      exact this (isUnit_of_dvd_one hd)
    have hF4 : ∀ (x : ↥W) (j : ℕ), τ ^ j ∣ x →
        (O ρ).valuation (algebraMap A K (algebraMap ↥W A x)) ≤ r ^ j := by
      intro x j hx
      obtain ⟨y, rfl⟩ := hx
      rw [map_mul, map_mul, map_mul, map_pow, map_pow, map_pow]
      exact mul_le_of_le_one_right (zero_le) (hF1 _)
    have hrep' : ∀ (G : K) (a1 a2 : ↥W) (Z' Y' : List ↥W) (d' e' : A), G ≠ 0 →
        wcFrfREP W A K 𝔭 t G a1 a2 Z' Y' d' e' →
        (O ρ).valuation (algebraMap A K (algebraMap ↥W A a2)) *
            (O ρ).valuation (algebraMap A K (algebraMap ↥W A (wcFrfP W c ρ Y'))) *
            (O ρ).valuation G =
          (O ρ).valuation (algebraMap A K (algebraMap ↥W A a1)) *
            (O ρ).valuation (algebraMap A K (algebraMap ↥W A (wcFrfP W c ρ Z'))) := by
      intro G a1 a2 Z' Y' d' e' hG hrep
      obtain ⟨h1, h2⟩ := hVI G a1 a2 Z' Y' d' e' hG hrep
      have hne1 : algebraMap A K (algebraMap ↥W A (a2 * wcFrfP W c ρ Y')) * G ≠ 0 :=
        mul_ne_zero (hF0a _ (mul_ne_zero hrep.2.1 (hP0 ρ Y' hρ0))) hG
      have hne2 : algebraMap A K (algebraMap ↥W A (a1 * wcFrfP W c ρ Z')) ≠ 0 :=
        hF0a _ (mul_ne_zero hrep.1 (hP0 ρ Z' hρ0))
      have := hveq _ _ hne1 hne2 h1 h2
      simp only [map_mul, Valuation.map_mul] at this
      exact this
    have hvU : (O ρ).valuation (algebraMap A K (t - algebraMap ↥W A c)) =
        (O ρ).valuation (algebraMap A K (algebraMap ↥W A ρ)) := by
      have hrep : wcFrfREP W A K 𝔭 t (algebraMap A K (t - algebraMap ↥W A c)) 1 1 [c] [] 1 1 := by
        refine ⟨one_ne_zero, one_ne_zero, h1p, h1p, ?_, ?_⟩
        · intro z hz
          simp only [List.cons_append, List.nil_append, List.mem_singleton] at hz
          rw [hz]; exact hc
        · simp
      have := hrep' _ 1 1 [c] [] 1 1 hz hrep
      rw [hPnear ρ [c] (by simp), hPnear ρ [] (by simp)] at this
      simpa using this
    have hvs : (O ρ).valuation (algebraMap A' K v') = r := by
      rw [hv', Valuation.map_div, hvU, ← hρτ, map_mul, map_mul, Valuation.map_mul]
      exact mul_div_cancel_left₀ _ (hvne ρ hρ0)
    have hvA' : ∀ x : A', (O ρ).valuation (algebraMap A' K x) ≤ 1 :=
      fun x => (hmemle _).mpr (hA'O x)
    have hvε : ∀ ε : A', ε ∉ 𝔭' → algebraMap A' K ε ≠ 0 →
        (O ρ).valuation (algebraMap A' K ε) = 1 := by
      intro ε hε hε0
      refine le_antisymm (hvA' ε) ?_
      have h1 := (hmemle _).mpr (hunit ε hε)
      rw [Valuation.map_inv] at h1
      exact (inv_le_one₀ (zero_lt_iff.mpr (((O ρ).valuation.ne_zero_iff).mpr hε0))).mp h1
    have hρr : (O ρ).valuation (algebraMap A K (algebraMap ↥W A ρ)) ≤ r ^ (n + k + 1) :=
      hF4 ρ _ hτρ
    have hbr : ∀ (j : ℕ) (ε rr gg : A'), j ≤ n + k → ε ∉ 𝔭' → algebraMap A' K ε ≠ 0 →
        (O ρ).valuation (algebraMap A' K (v' ^ j * ε + u' * rr + algebraMap ↥W A' w * gg)) =
          r ^ j := by
      intro j ε rr gg hj hε hε0
      have hlt : r ^ (n + k + 1) < r ^ j := pow_lt_pow_right_of_lt_one₀ hr0 hr1 (by omega)
      rw [add_assoc, map_add (algebraMap A' K), map_add (algebraMap A' K)]
      have hfirst : (O ρ).valuation (algebraMap A' K (v' ^ j * ε)) = r ^ j := by
        rw [map_mul, map_pow, Valuation.map_mul, Valuation.map_pow, hvs, hvε ε hε hε0, mul_one]
      have hsec : (O ρ).valuation (algebraMap A' K (u' * rr)) < r ^ j := by
        rw [map_mul, Valuation.map_mul, hu', hvU]
        exact (mul_le_of_le_one_right (zero_le) (hvA' rr)).trans_lt (hρr.trans_lt hlt)
      have hthird : (O ρ).valuation (algebraMap A' K (algebraMap ↥W A' w * gg)) < r ^ j := by
        rw [map_mul, Valuation.map_mul, hBr1 w]
        exact (mul_le_of_le_one_right (zero_le) (hvA' gg)).trans_lt ((hF4 w _ hτw).trans_lt hlt)
      rw [Valuation.map_add_eq_of_lt_left _ (hfirst ▸ Valuation.map_add_lt _ hsec hthird), hfirst]
    have hB1 := hbr n ε₁ r₁ g₁ (by omega) hε₁ hε₁0
    have hB0 := hbr k ε₀ r₀ g₀ (by omega) hε₀ hε₀0
    have hF8 := congrArg (O ρ).valuation hI
    rw [Valuation.map_mul, Valuation.map_mul, Valuation.map_mul, hB1, hB0, hBr1, hBr1] at hF8
    have hRF := hrep' _ k1 k2 Z Y d e hF0 hR
    have hkey : (O ρ).valuation (algebraMap A K (algebraMap ↥W A
          (k2 * wcFrfP W c ρ Y * lam₁ * τ ^ k))) =
        (O ρ).valuation (algebraMap A K (algebraMap ↥W A
          (k1 * wcFrfP W c ρ Z * lam₂ * τ ^ n))) := by
      simp only [map_mul, map_pow, Valuation.map_mul, Valuation.map_pow]
      rw [← hr]
      exact hcomb _ _ _ _ _ _ _ _ _ hF8 hRF
    have hne1 : k2 * wcFrfP W c ρ Y * lam₁ * τ ^ k ≠ 0 :=
      mul_ne_zero (mul_ne_zero (mul_ne_zero hk2 (hP0 ρ Y hρ0)) hl1) (pow_ne_zero _ hτ0)
    have hne2 : k1 * wcFrfP W c ρ Z * lam₂ * τ ^ n ≠ 0 :=
      mul_ne_zero (mul_ne_zero (mul_ne_zero hk1 (hP0 ρ Z hρ0)) hl2) (pow_ne_zero _ hτ0)
    exact ⟨hF2 _ _ hne2 hne1 hkey.symm.le, hF2 _ _ hne1 hne2 hkey.le⟩

  have hτfacts : ∀ ρτ τ : ↥W, τ ≠ 0 → ρτ * τ = a → τ ∣ ρ' →
      τ ^ (n + k + 1) ∣ ρτ ∧ τ ^ (n + k + 1) ∣ w ∧ τ ^ n ∣ lamS := by
    intro ρτ τ hτ0 hρτ hτρ'
    obtain ⟨h1, h2, h3⟩ := hdivτ τ hτρ'
    refine ⟨?_, (pow_dvd_pow τ (by omega)).trans h1, (pow_dvd_pow τ (by omega)).trans h2⟩
    rw [← hρτ, pow_succ] at h3
    exact (mul_dvd_mul_iff_right hτ0).mp h3

  refine ⟨ρ', hρ'm, hρ'0, h, k1, k2, Z, Y, d, e, hR, ?_⟩
  rintro ρ hρm hρ0 ⟨⟨σ, hσ⟩, hnaρ, haρρ', hnρρ'a⟩ -
  have hσ0 : σ ≠ 0 := by
    rintro rfl
    exact ha0 (by rw [hσ, mul_zero])
  have hσnu : ¬ IsUnit σ := by
    intro hu
    apply hnaρ
    rw [hσ]
    exact hu.mul_right_dvd.mpr dvd_rfl
  have hσm : σ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact hσnu
  have hσρ' : σ ∣ ρ' := by
    rw [hσ] at haρρ'
    exact (mul_dvd_mul_iff_left hρ0).mp haρρ'
  have hnρ'σ : ¬ ρ' ∣ σ := by
    intro hd
    apply hnρρ'a
    rw [hσ]
    exact mul_dvd_mul_left ρ hd
  obtain ⟨σ₂, hσ₂m, hσ₂0, hσ₂sq⟩ := hroot σ hσm hσ0 1
  have hσ2 : σ = σ₂ * σ₂ := by rw [← hσ₂sq, pow_two]
  have hσ₂nu : ¬ IsUnit σ₂ := by
    have := (IsLocalRing.mem_maximalIdeal _).mp hσ₂m
    rwa [mem_nonunits_iff] at this
  have hρ₂m : ρ * σ₂ ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right _ _ hρm
  have hρ₂0 : ρ * σ₂ ≠ 0 := mul_ne_zero hρ0 hσ₂0
  have hρ₂τ : ρ * σ₂ * σ₂ = a := by rw [mul_assoc, ← hσ2, hσ]
  have hσ₂ρ' : σ₂ ∣ ρ' := (Dvd.intro σ₂ hσ2.symm).trans hσρ'
  have hnρ'σ₂ : ¬ ρ' ∣ σ₂ := fun hd => hnρ'σ (hd.trans (Dvd.intro σ₂ hσ2.symm))
  obtain ⟨T1a, T1b, T1c⟩ := hτfacts ρ σ hσ0 hσ.symm hσρ'
  obtain ⟨T2a, T2b, -⟩ := hτfacts (ρ * σ₂) σ₂ hσ₂0 hρ₂τ hσ₂ρ'
  have G1 := hgauss ρ σ hρm hρ0 hσm hσ0 hσ.symm T1a T1b
  have G2 := hgauss (ρ * σ₂) σ₂ hρ₂m hρ₂0 hσ₂m hσ₂0 hρ₂τ T2a T2b
  have hZsub : ∀ x ∈ Z, x ∈ Z ++ Y := fun x hx => List.mem_append_left _ hx
  have hYsub : ∀ x ∈ Y, x ∈ Z ++ Y := fun x hx => List.mem_append_right _ hx
  obtain ⟨S1Z, S1Z'⟩ := hshape ρ σ hρ0 hσ.symm hnρ'σ Z hZsub
  obtain ⟨S1Y, S1Y'⟩ := hshape ρ σ hρ0 hσ.symm hnρ'σ Y hYsub
  obtain ⟨S2Z, -⟩ := hshape (ρ * σ₂) σ₂ hρ₂0 hρ₂τ hnρ'σ₂ Z hZsub
  obtain ⟨S2Y, -⟩ := hshape (ρ * σ₂) σ₂ hρ₂0 hρ₂τ hnρ'σ₂ Y hYsub
  rw [S1Z, S1Y] at G1
  rw [S2Z, S2Y] at G2

  have e1 : k2 * C Y * lam₁ * a ^ N Y * σ₂ ^ (k + N Z) =
      k2 * (C Y * (ρ * σ₂) ^ N Y) * lam₁ * σ₂ ^ k * σ₂ ^ (N Y + N Z) := by
    rw [← hρ₂τ]; ring
  have e2 : k1 * C Z * lam₂ * a ^ N Z * σ₂ ^ (n + N Y) =
      k1 * (C Z * (ρ * σ₂) ^ N Z) * lam₂ * σ₂ ^ n * σ₂ ^ (N Y + N Z) := by
    rw [← hρ₂τ]; ring
  have e3 : k2 * C Y * lam₁ * a ^ N Y * σ₂ ^ (2 * (k + N Z)) =
      k2 * (C Y * ρ ^ N Y) * lam₁ * σ ^ k * σ ^ (N Y + N Z) := by
    rw [hσ, hσ2]; ring
  have e4 : k1 * C Z * lam₂ * a ^ N Z * σ₂ ^ (2 * (n + N Y)) =
      k1 * (C Z * ρ ^ N Z) * lam₂ * σ ^ n * σ ^ (N Y + N Z) := by
    rw [hσ, hσ2]; ring
  obtain ⟨hpq, hXY⟩ := hexp (k2 * C Y * lam₁ * a ^ N Y) (k1 * C Z * lam₂ * a ^ N Z) σ₂
    (k + N Z) (n + N Y)
    (mul_ne_zero (mul_ne_zero (mul_ne_zero hk2 (hC0 Y)) hl1) (pow_ne_zero _ ha0)) hσ₂0 hσ₂nu
    (by rw [e1, e2]; exact mul_dvd_mul_right G2.1 _)
    (by rw [e1, e2]; exact mul_dvd_mul_right G2.2 _)
    (by rw [e3, e4]; exact mul_dvd_mul_right G1.1 _)
    (by rw [e3, e4]; exact mul_dvd_mul_right G1.2 _)

  have hM : wcFrfM W c ρ Z Y = (N Z : ℤ) - N Y := by
    unfold wcFrfM
    rw [S1Z', S1Y']
  unfold wcFrfGood
  rw [S1Z, S1Y, hM]
  rcases hD' with ⟨⟨μ, hμ⟩, hnk'⟩ | hnd
  · left
    by_cases hnk : n ≤ k
    · obtain ⟨dd, hdd⟩ : ∃ dd, N Y = N Z + dd := ⟨k - n, by omega⟩
      have hc1 : (lam₂ * a ^ N Z) * (k2 * C Y * μ * a ^ dd) ∣ (lam₂ * a ^ N Z) * (k1 * C Z) := by
        have ex : k2 * C Y * lam₁ * a ^ N Y = (lam₂ * a ^ N Z) * (k2 * C Y * μ * a ^ dd) := by
          rw [hμ, hdd]; ring
        have ey : k1 * C Z * lam₂ * a ^ N Z = (lam₂ * a ^ N Z) * (k1 * C Z) := by ring
        rw [← ex, ← ey]; exact hXY
      have hc2 := (mul_dvd_mul_iff_left (mul_ne_zero hl2 (pow_ne_zero _ ha0))).mp hc1
      have hc3 : k2 * C Y * ρ ^ dd ∣ k1 * C Z :=
        (Dvd.intro (μ * σ ^ dd) (by rw [hσ]; ring)).trans hc2
      have hc4 := mul_dvd_mul_right hc3 (ρ ^ N Z)
      have ex2 : k2 * (C Y * ρ ^ N Y) = k2 * C Y * ρ ^ dd * ρ ^ N Z := by rw [hdd]; ring
      have ey2 : k1 * (C Z * ρ ^ N Z) = k1 * C Z * ρ ^ N Z := by ring
      rw [ex2, ey2]; exact hc4
    · rcases hnk' with hnk'' | ⟨lam', hl', hlS⟩
      · exact absurd hnk'' hnk
      obtain ⟨dd, hdd⟩ : ∃ dd, N Z = N Y + dd := ⟨n - k, by omega⟩
      have hμ' : μ = lam' := mul_left_cancel₀ hl2 (hμ.symm.trans hl')
      have hσdd : σ ^ dd ∣ lam' :=
        ((pow_dvd_pow σ (by omega : dd ≤ n)).trans T1c).trans hlS
      obtain ⟨κ, hκ⟩ := hσdd
      have hc1 : (lam₂ * a ^ N Y * σ ^ dd) * (k2 * C Y * κ) ∣
          (lam₂ * a ^ N Y * σ ^ dd) * (k1 * C Z * ρ ^ dd) := by
        have ex : k2 * C Y * lam₁ * a ^ N Y = (lam₂ * a ^ N Y * σ ^ dd) * (k2 * C Y * κ) := by
          rw [hμ, hμ', hκ]; ring
        have ey : k1 * C Z * lam₂ * a ^ N Z = (lam₂ * a ^ N Y * σ ^ dd) * (k1 * C Z * ρ ^ dd) := by
          rw [hdd, hσ]; ring
        rw [← ex, ← ey]; exact hXY
      have hc2 := (mul_dvd_mul_iff_left
        (mul_ne_zero (mul_ne_zero hl2 (pow_ne_zero _ ha0)) (pow_ne_zero _ hσ0))).mp hc1
      have hc3 : k2 * C Y ∣ k1 * C Z * ρ ^ dd := dvd_of_mul_right_dvd hc2
      have hc4 := mul_dvd_mul_right hc3 (ρ ^ N Y)
      have ex2 : k2 * (C Y * ρ ^ N Y) = k2 * C Y * ρ ^ N Y := by ring
      have ey2 : k1 * (C Z * ρ ^ N Z) = k1 * C Z * ρ ^ dd * ρ ^ N Y := by rw [hdd]; ring
      rw [ex2, ey2]; exact hc4
  · right
    have e : (N Z : ℤ) - N Y = -((k : ℤ) - n) := by
      have : ((k + N Z : ℕ) : ℤ) = ((n + N Y : ℕ) : ℤ) := by rw [hpq]
      push_cast at this
      omega
    rw [e, dvd_neg]
    exact hnd

theorem wcFrfCp_iota : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A) (c : ↥W) (O : ↥W → ValuationSubring K), wcLlsPD W A 𝔭 (.disc t) → c ∈ IsLocalRing.maximalIdeal ↥W → wcFrfVAL W A K 𝔭 t c O → ∃ ι : Ω →+* K, (∀ w : ↥W, ι (w : Ω) = algebraMap A K (algebraMap ↥W A w)) ∧ (∀ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 → (∀ x y : Ω, ((O ρ).valuation (ι x) ≤ (O ρ).valuation (ι y) ↔ W.valuation x ≤ W.valuation y)) ∧ (O ρ).valuation (algebraMap A K (t - algebraMap ↥W A c)) = (O ρ).valuation (ι (ρ : Ω))) ∧ ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → algebraMap A K (t - algebraMap ↥W A c) - ι (x : Ω) ≠ 0 :=
by
  intro Ω _ _ W hWt A _ _ _ K _ _ _ 𝔭 t c O hPD hc hO
  classical
  unfold wcFrfVAL wcFrfREP at hO

  have hgen : ∀ c' : ↥W, t - algebraMap ↥W A c' ≠ 0 := by
    intro c'
    obtain ⟨-, -, -, h𝔭max, -, -, -, h, hh, φ, hφC, hφX, hφet⟩ := hPD
    have h𝔭 : 𝔭.IsPrime := h𝔭max.isPrime
    set B := Localization.Away h
    set ιB := algebraMap A B with hιBdef
    have hdisj : Disjoint ((Submonoid.powers h : Submonoid A) : Set A) (𝔭 : Set A) := by
      rw [Set.disjoint_left]
      intro x hx hx𝔭
      obtain ⟨n, rfl⟩ := Submonoid.mem_powers_iff _ _ |>.mp hx
      exact hh (h𝔭.mem_of_pow_mem n hx𝔭)
    set 𝔭' := 𝔭.map ιB with h𝔭'def
    haveI h𝔭' : 𝔭'.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) B 𝔭 h𝔭 hdisj
    letI : Algebra (Polynomial ↥W) B := φ.toAlgebra
    haveI : Algebra.Etale (Polynomial ↥W) B := hφet
    haveI : Algebra.HasGoingDown (Polynomial ↥W) B := Algebra.HasGoingDown.of_flat
    set q₁ := Ideal.under (Polynomial ↥W) 𝔭' with hq₁
    haveI : q₁.IsPrime := Ideal.IsPrime.under _ _
    haveI : 𝔭'.LiesOver q₁ := ⟨rfl⟩
    haveI : (⊥ : Ideal (Polynomial ↥W)).IsPrime := Ideal.isPrime_bot
    obtain ⟨P', -, hP'prime, hP'over⟩ :=
      Ideal.exists_ideal_le_liesOver_of_le (p := (⊥ : Ideal (Polynomial ↥W))) (q := q₁) 𝔭' bot_le
    have hP'eq : (⊥ : Ideal (Polynomial ↥W)) = P'.comap φ := hP'over.over
    have hφCw : ∀ w : ↥W, φ (Polynomial.C w) = ιB (algebraMap ↥W A w) := by
      intro w
      exact RingHom.congr_fun hφC w
    have hφτ : φ (Polynomial.X - Polynomial.C c') = ιB (t - algebraMap ↥W A c') := by
      rw [map_sub, hφX, hφCw, map_sub]
    intro hτ0
    have hmem : Polynomial.X - Polynomial.C c' ∈ P'.comap φ := by
      rw [Ideal.mem_comap, hφτ, hτ0, map_zero]
      exact P'.zero_mem
    rw [← hP'eq, Ideal.mem_bot] at hmem
    exact Polynomial.X_sub_C_ne_zero c' hmem
  have h1𝔭 : (1 : A) ∉ 𝔭 := by
    obtain ⟨-, -, -, h𝔭max, -⟩ := hPD
    exact (Ideal.ne_top_iff_one 𝔭).mp h𝔭max.ne_top

  have hunit : ∀ (y : Ω) (hy0 : y ≠ 0) (hy : y⁻¹ ∈ W), IsUnit (⟨y⁻¹, hy⟩ : ↥W) → y ∈ W := by
    intro y hy0 hy hu
    obtain ⟨v, hv⟩ := hu.exists_right_inv
    have h1 : y⁻¹ * (v : Ω) = 1 := by
      have := congrArg Subtype.val hv
      simpa using this
    have h2 : y = (v : Ω) := (inv_mul_eq_one₀ hy0).mp h1
    rw [h2]
    exact v.2

  obtain ⟨x₀, hx₀⟩ : ∃ x₀ : Ω, x₀ ∉ W := by
    by_contra hcon
    push_neg at hcon
    exact hWt (eq_top_iff.mpr fun x _ => hcon x)
  have hx₀0 : x₀ ≠ 0 := fun h => hx₀ (h ▸ W.zero_mem)
  have hx₀i : x₀⁻¹ ∈ W := (W.mem_or_inv_mem x₀).resolve_left hx₀
  have hπ0 : (⟨x₀⁻¹, hx₀i⟩ : ↥W) ≠ 0 := by
    intro h
    apply inv_ne_zero hx₀0
    simpa using congrArg Subtype.val h
  have hπm : (⟨x₀⁻¹, hx₀i⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact fun hu => hx₀ (hunit x₀ hx₀0 hx₀i hu)

  have hgi : Function.Injective ((algebraMap A K).comp (algebraMap ↥W A)) := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    by_contra hx0
    have hx' : algebraMap A K (algebraMap ↥W A x) = 0 := hx
    have hmem : algebraMap A K (algebraMap ↥W A 1) / algebraMap A K (algebraMap ↥W A x) ∈
        O ⟨x₀⁻¹, hx₀i⟩ := by
      rw [hx', div_zero]
      exact (O _).zero_mem
    have hd := (hO _ hπm hπ0).2.1 1 x one_ne_zero hx0 hmem
    have hxu : IsUnit (((algebraMap A K).comp (algebraMap ↥W A)) x) :=
      (isUnit_of_dvd_one hd).map _
    rw [hx] at hxu
    exact not_isUnit_zero hxu
  set ι : Ω →+* K := IsFractionRing.lift (A := ↥W) (K := Ω) hgi with hιdef
  have hι1 : ∀ w : ↥W, ι (w : Ω) = algebraMap A K (algebraMap ↥W A w) := by
    intro w
    exact IsFractionRing.lift_algebraMap (K := Ω) hgi w

  have hmemO : ∀ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 → ∀ x : Ω,
      (ι x ∈ O ρ ↔ x ∈ W) := by
    intro ρ hρ hρ0 x
    constructor
    · intro hx
      by_contra hxW
      have hx0 : x ≠ 0 := fun h => hxW (h ▸ W.zero_mem)
      have hxi : x⁻¹ ∈ W := (W.mem_or_inv_mem x).resolve_left hxW
      have hy0 : (⟨x⁻¹, hxi⟩ : ↥W) ≠ 0 := by
        intro h
        apply inv_ne_zero hx0
        simpa using congrArg Subtype.val h
      have hιx : ι x = algebraMap A K (algebraMap ↥W A 1) /
          algebraMap A K (algebraMap ↥W A ⟨x⁻¹, hxi⟩) := by
        rw [map_one, map_one, ← hι1]
        show ι x = 1 / ι x⁻¹
        rw [map_inv₀, one_div, inv_inv]
      rw [hιx] at hx
      have hd := (hO ρ hρ hρ0).2.1 1 _ one_ne_zero hy0 hx
      exact hxW (hunit x hx0 hxi (isUnit_of_dvd_one hd))
    · intro hx
      have h1 := (hO ρ hρ hρ0).2.2 (algebraMap ↥W A ⟨x, hx⟩)
      rw [← hι1] at h1
      exact h1

  have htrans : ∀ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 → ∀ x y : Ω,
      ((O ρ).valuation (ι x) ≤ (O ρ).valuation (ι y) ↔ W.valuation x ≤ W.valuation y) := by
    intro ρ hρ hρ0 x y
    by_cases hy : y = 0
    · subst hy
      simp only [map_zero]
      constructor
      · intro h
        have h0 : x = 0 :=
          (map_eq_zero ι).mp (((O ρ).valuation.zero_iff).mp (le_antisymm h zero_le'))
        rw [h0]
        simp
      · intro h
        have h0 : x = 0 := (W.valuation.zero_iff).mp (le_antisymm h zero_le')
        rw [h0]
        simp
    · have hιy : ι y ≠ 0 := (map_ne_zero ι).mpr hy
      have h1 : (O ρ).valuation (ι x) ≤ (O ρ).valuation (ι y) ↔ ι (x / y) ∈ O ρ := by
        rw [map_div₀, ← ValuationSubring.valuation_le_one_iff, Valuation.map_div,
          div_le_one₀ ((Valuation.pos_iff _).mpr hιy)]
      have h2 : W.valuation x ≤ W.valuation y ↔ x / y ∈ W := by
        rw [← ValuationSubring.valuation_le_one_iff, Valuation.map_div,
          div_le_one₀ ((Valuation.pos_iff _).mpr hy)]
      rw [h1, h2]
      exact hmemO ρ hρ hρ0 _

  have hP4 : ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W →
      algebraMap A K (t - algebraMap ↥W A c) - ι (x : Ω) ≠ 0 := by
    intro x _
    rw [hι1, ← map_sub, sub_sub, ← map_add]
    exact (map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr (hgen (c + x))

  have hU0 : algebraMap A K (t - algebraMap ↥W A c) ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr (hgen c)
  have hPc : ∀ ρ : ↥W, wcFrfP W c ρ [c] = ρ := by
    intro ρ
    unfold wcFrfP
    simp
  have hPn : ∀ ρ : ↥W, wcFrfP W c ρ [] = 1 := by
    intro ρ
    unfold wcFrfP
    simp
  have hP3 : ∀ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 →
      (O ρ).valuation (algebraMap A K (t - algebraMap ↥W A c)) = (O ρ).valuation (ι (ρ : Ω)) := by
    intro ρ hρ hρ0
    have hrep := (hO ρ hρ hρ0).1 (algebraMap A K (t - algebraMap ↥W A c)) 1 1 [c] [] 1 1 hU0
      ⟨one_ne_zero, one_ne_zero, h1𝔭, h1𝔭, by simpa using hc, by simp⟩
    rw [hPc, hPn] at hrep
    simp only [mul_one, one_mul, map_one] at hrep
    obtain ⟨h1, h2⟩ := hrep
    have hρΩ : (ρ : Ω) ≠ 0 := fun h => hρ0 (Subtype.ext (by simpa using h))
    have hρK : algebraMap A K (algebraMap ↥W A ρ) ≠ 0 := by
      rw [← hι1]
      exact (map_ne_zero ι).mpr hρΩ
    rw [← ValuationSubring.valuation_le_one_iff, Valuation.map_div,
      div_le_one₀ ((Valuation.pos_iff _).mpr hρK)] at h1
    rw [← ValuationSubring.valuation_le_one_iff, Valuation.map_div,
      div_le_one₀ ((Valuation.pos_iff _).mpr hU0)] at h2
    rw [hι1]
    exact le_antisymm h1 h2
  exact ⟨ι, hι1, fun ρ hρ hρ0 => ⟨htrans ρ hρ hρ0, hP3 ρ hρ hρ0⟩, hP4⟩

theorem wcFrfCp_laurent_reduce : ∀ (F' : Type u) [Field F'] [IsAlgClosed F'] (E : Type u) [Field E] (ι : F' →+* E) (ℓ : ℕ), ℓ.Prime → ((ℓ : ℕ) : E) = 0 → ∀ u : E, u ≠ 0 → ∀ C : List (F' × ℤ), ∃ H D : List (F' × ℤ), (∀ p ∈ D, p.1 ≠ 0 ∧ ¬ (ℓ : ℤ) ∣ p.2) ∧ (D.map Prod.snd).Nodup ∧ (C.map (fun p => ι p.1 * u ^ p.2)).sum - (((H.map (fun p => ι p.1 * u ^ p.2)).sum) ^ ℓ - (H.map (fun p => ι p.1 * u ^ p.2)).sum) = (D.map (fun p => ι p.1 * u ^ p.2)).sum :=
by
  intro F' _ _ E _ ι ℓ hℓ h0 u _hu C
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : CharP E ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr h0
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero
  obtain ⟨f, hf⟩ : ∃ f : F' × ℤ → E, f = fun p => ι p.1 * u ^ p.2 := ⟨_, rfl⟩
  have hfv : ∀ (a : F') (n : ℤ), f (a, n) = ι a * u ^ n := by intro a n; rw [hf]
  have hadd : ∀ x y : E, (x + y) ^ ℓ - (x + y) = (x ^ ℓ - x) + (y ^ ℓ - y) := by
    intro x y; rw [add_pow_char]; ring

  have s1 : ∀ N : ℕ, ∀ (a : F') (n : ℤ), n.natAbs = N → ∃ H D : List (F' × ℤ),
      (∀ p ∈ D, ¬ (ℓ : ℤ) ∣ p.2) ∧
      f (a, n) - ((H.map f).sum ^ ℓ - (H.map f).sum) = (D.map f).sum := by
    intro N
    induction N using Nat.strong_induction_on with
    | _ N ih =>
    intro a n hn
    by_cases hdiv : (ℓ : ℤ) ∣ n
    · by_cases hn0 : n = 0
      · subst hn0
        obtain ⟨lam, hlam⟩ : ∃ lam : F', lam ^ ℓ - lam = a := by
          have h1 : (Polynomial.X + Polynomial.C a : Polynomial F').degree <
              (Polynomial.X ^ ℓ : Polynomial F').degree := by
            rw [Polynomial.degree_X_add_C, Polynomial.degree_X_pow]
            exact_mod_cast hℓ.one_lt
          have hdeg : (Polynomial.X ^ ℓ - (Polynomial.X + Polynomial.C a) :
              Polynomial F').degree ≠ 0 := by
            rw [Polynomial.degree_sub_eq_left_of_degree_lt h1, Polynomial.degree_X_pow]
            exact_mod_cast hℓ0
          obtain ⟨lam, hlam⟩ := IsAlgClosed.exists_root _ hdeg
          refine ⟨lam, ?_⟩
          simp only [Polynomial.IsRoot, Polynomial.eval_sub, Polynomial.eval_pow,
            Polynomial.eval_X, Polynomial.eval_add, Polynomial.eval_C] at hlam
          linear_combination hlam
        subst hlam
        refine ⟨[(lam, 0)], [], by simp, ?_⟩
        simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, add_zero, hfv,
          zpow_zero, mul_one, map_sub, map_pow]
        ring
      · obtain ⟨j, rfl⟩ := hdiv
        have hj0 : j ≠ 0 := by rintro rfl; simp at hn0
        have hlt : j.natAbs < N := by
          rw [← hn, Int.natAbs_mul, Int.natAbs_natCast]
          have := Int.natAbs_pos.mpr hj0
          have := hℓ.two_le
          nlinarith
        obtain ⟨γ, hγ⟩ := IsAlgClosed.exists_pow_nat_eq a hℓ.pos
        obtain ⟨H', D', hD', heq⟩ := ih _ hlt γ j rfl
        refine ⟨(γ, j) :: H', D', hD', ?_⟩
        have hx : (f (γ, j)) ^ ℓ = ι a * u ^ ((ℓ : ℤ) * j) := by
          rw [hfv, mul_pow, ← map_pow, hγ, ← zpow_natCast, ← zpow_mul, mul_comm j]
        rw [List.map_cons, List.sum_cons, hadd, hx, ← heq, hfv]
        ring
    · refine ⟨[], [(a, n)], ?_, ?_⟩
      · intro p hp
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
        subst hp
        exact hdiv
      · simp [zero_pow hℓ0]

  have s3 : ∀ C : List (F' × ℤ), ∃ H D : List (F' × ℤ), (∀ p ∈ D, ¬ (ℓ : ℤ) ∣ p.2) ∧
      (C.map f).sum - ((H.map f).sum ^ ℓ - (H.map f).sum) = (D.map f).sum := by
    intro C
    induction C with
    | nil => exact ⟨[], [], by simp, by simp [zero_pow hℓ0]⟩
    | cons p C ih =>
      obtain ⟨a, n⟩ := p
      obtain ⟨H₁, D₁, hD₁, e₁⟩ := s1 _ a n rfl
      obtain ⟨H₂, D₂, hD₂, e₂⟩ := ih
      refine ⟨H₁ ++ H₂, D₁ ++ D₂, ?_, ?_⟩
      · intro q hq
        rcases List.mem_append.mp hq with h | h
        · exact hD₁ q h
        · exact hD₂ q h
      · rw [List.map_cons, List.sum_cons, List.map_append, List.sum_append, hadd,
          List.map_append, List.sum_append, ← e₁, ← e₂]
        ring

  have s2 : ∀ D₀ : List (F' × ℤ), (∀ p ∈ D₀, ¬ (ℓ : ℤ) ∣ p.2) → ∃ D : List (F' × ℤ),
      (∀ p ∈ D, p.1 ≠ 0 ∧ ¬ (ℓ : ℤ) ∣ p.2) ∧ (D.map Prod.snd).Nodup ∧
      (D₀.map f).sum = (D.map f).sum := by
    intro D₀
    induction D₀ with
    | nil => intro _; exact ⟨[], by simp, by simp, rfl⟩
    | cons p T ih =>
      intro hP
      obtain ⟨a, n⟩ := p
      obtain ⟨D, hD, hnd, heq⟩ := ih (fun q hq => hP q (List.mem_cons_of_mem _ hq))
      have hPn : ¬ (ℓ : ℤ) ∣ n := hP (a, n) List.mem_cons_self
      have hsplit : ∀ L : List (F' × ℤ), (L.map f).sum =
          ι ((L.filter (fun q => q.2 = n)).map Prod.fst).sum * u ^ n +
            ((L.filter (fun q => ¬ q.2 = n)).map f).sum := by
        intro L
        induction L with
        | nil => simp
        | cons q L ihL =>
          obtain ⟨b, m⟩ := q
          by_cases hm : m = n
          · subst hm
            simp only [List.filter_cons, decide_true, decide_not, Bool.not_true,
              List.map_cons, List.sum_cons, ihL, hfv]
            simp only [Bool.false_eq_true, ite_false, ite_true, List.map_cons, List.sum_cons,
              map_add]
            ring
          · simp only [List.filter_cons, hm, decide_false, decide_not, Bool.not_false,
              List.map_cons, List.sum_cons, ihL]
            simp only [Bool.false_eq_true, ite_false, ite_true, List.map_cons, List.sum_cons,
              hfv]
            ring
      have hsub : ((D.filter (fun q => ¬ q.2 = n)).map Prod.snd).Sublist (D.map Prod.snd) :=
        (List.filter_sublist).map _
      by_cases has : a + ((D.filter (fun q => q.2 = n)).map Prod.fst).sum = 0
      · refine ⟨D.filter (fun q => ¬ q.2 = n), ?_, hnd.sublist hsub, ?_⟩
        · intro q hq; exact hD q (List.mem_of_mem_filter hq)
        · rw [List.map_cons, List.sum_cons, heq, hsplit D, hfv, ← add_assoc, ← add_mul,
            ← map_add, has, map_zero, zero_mul, zero_add]
      · refine ⟨(a + ((D.filter (fun q => q.2 = n)).map Prod.fst).sum, n) ::
          D.filter (fun q => ¬ q.2 = n), ?_, ?_, ?_⟩
        · intro q hq
          rcases List.mem_cons.mp hq with rfl | hq
          · exact ⟨has, hPn⟩
          · exact hD q (List.mem_of_mem_filter hq)
        · rw [List.map_cons, List.nodup_cons]
          refine ⟨?_, hnd.sublist hsub⟩
          intro hmem
          obtain ⟨q, hq, hqn⟩ := List.mem_map.mp hmem
          have := (List.mem_filter.mp hq).2
          simp only [decide_not, Bool.not_eq_eq_eq_not, Bool.not_true,
            decide_eq_false_iff_not] at this
          exact this hqn
        · rw [List.map_cons, List.sum_cons, heq, hsplit D, hfv, List.map_cons, List.sum_cons,
            hfv, map_add]
          ring
  obtain ⟨H, D₀, hD₀, e⟩ := s3 C
  obtain ⟨D, hD, hnd, e'⟩ := s2 D₀ hD₀
  subst hf
  exact ⟨H, D, hD, hnd, e.trans e'⟩

theorem wcFrfCp_taylor : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A) (c : ↥W), wcLlsPD W A 𝔭 (.disc t) → c ∈ IsLocalRing.maximalIdeal ↥W → ∀ e d : A, d ∉ 𝔭 → ∀ J : ℕ, ∃ (w : ℕ → ↥W) (a s : A), s ∉ 𝔭 ∧ algebraMap A K e / algebraMap A K d = ∑ j ∈ Finset.range J, algebraMap A K (algebraMap ↥W A (w j)) * algebraMap A K (t - algebraMap ↥W A c) ^ j + algebraMap A K (t - algebraMap ↥W A c) ^ J * algebraMap A K a / algebraMap A K s :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 t c hPD hc e d hd J
  classical
  obtain ⟨ev, hev, -, hsec⟩ := wcLlsAS_dsbu_section Ω W hW hWt A 𝔭 t c hPD hc
  have hPD' := hPD
  simp only [wcLlsPD] at hPD'
  obtain ⟨_, _, _, hmax, hle, ht, _⟩ := hPD'
  have hP : 𝔭.IsPrime := hmax.isPrime
  have hT : t - algebraMap ↥W A c ∈ 𝔭 :=
    Ideal.sub_mem _ ht (hle (Ideal.mem_map_of_mem _ hc))
  have hinj := IsFractionRing.injective A K
  have hne : ∀ x : A, x ∉ 𝔭 → algebraMap A K x ≠ 0 := by
    intro x hx h0
    apply hx
    have : x = 0 := hinj (by rw [h0, map_zero])
    rw [this]; exact 𝔭.zero_mem
  have step : ∀ a s : A, s ∉ 𝔭 → ∃ (x : ↥W) (a' s' : A), s' ∉ 𝔭 ∧
      algebraMap A K a / algebraMap A K s = algebraMap A K (algebraMap ↥W A x) +
        algebraMap A K (t - algebraMap ↥W A c) * (algebraMap A K a' / algebraMap A K s') := by
    intro a s hs
    obtain ⟨σ₀, e₀, hσ₀, he₀⟩ := hsec s
    have h1 : s - algebraMap ↥W A (ev s) ∈ 𝔭 := by
      have : σ₀ * (s - algebraMap ↥W A (ev s)) ∈ 𝔭 := by
        rw [he₀]; exact Ideal.mul_mem_right _ _ hT
      exact (hP.mem_or_mem this).resolve_left hσ₀
    have hunit : IsUnit (ev s) := by
      rw [← IsLocalRing.notMem_maximalIdeal]
      intro hm
      apply hs
      have h2 : algebraMap ↥W A (ev s) ∈ 𝔭 := hle (Ideal.mem_map_of_mem _ hm)
      have := Ideal.add_mem _ h1 h2
      simpa using this
    obtain ⟨u, hu⟩ := hunit.exists_right_inv
    obtain ⟨σ, ε, hσ, hε⟩ := hsec (a - s * algebraMap ↥W A (ev a * u))
    have hevN : ev (a - s * algebraMap ↥W A (ev a * u)) = 0 := by
      rw [map_sub, map_mul, hev]
      linear_combination (-(ev a)) * hu
    rw [hevN, map_zero, sub_zero] at hε
    refine ⟨ev a * u, ε, σ * s, hP.mul_notMem hσ hs, ?_⟩
    have hφ := congrArg (algebraMap A K) hε
    generalize algebraMap ↥W A (ev a * u) = X at hφ ⊢
    generalize t - algebraMap ↥W A c = T at hφ ⊢
    simp only [map_mul, map_sub] at hφ
    have hs0 := hne s hs
    have hσ0 := hne σ hσ
    rw [map_mul]
    field_simp
    linear_combination hφ
  induction J with
  | zero => exact ⟨fun _ => 0, e, d, hd, by simp⟩
  | succ J ih =>
    obtain ⟨w, a, s, hs, heq⟩ := ih
    obtain ⟨x, a', s', hs', hstep⟩ := step a s hs
    refine ⟨Function.update w J x, a', s', hs', ?_⟩
    rw [Finset.sum_range_succ, Function.update_self]
    have hsum : ∑ j ∈ Finset.range J, algebraMap A K (algebraMap ↥W A (Function.update w J x j)) *
        algebraMap A K (t - algebraMap ↥W A c) ^ j = ∑ j ∈ Finset.range J,
        algebraMap A K (algebraMap ↥W A (w j)) * algebraMap A K (t - algebraMap ↥W A c) ^ j := by
      refine Finset.sum_congr rfl (fun j hj => ?_)
      rw [Function.update_of_ne (Nat.ne_of_lt (Finset.mem_range.mp hj))]
    rw [hsum, heq, mul_div_assoc (algebraMap A K (t - algebraMap ↥W A c) ^ J), hstep]
    ring

theorem wcFrfCp_expansion : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A) (c : ↥W) (O : ↥W → ValuationSubring K) (ι : Ω →+* K), wcLlsPD W A 𝔭 (.disc t) → c ∈ IsLocalRing.maximalIdeal ↥W → wcFrfVAL W A K 𝔭 t c O → (∀ w : ↥W, ι (w : Ω) = algebraMap A K (algebraMap ↥W A w)) → (∀ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 → (∀ x y : Ω, ((O ρ).valuation (ι x) ≤ (O ρ).valuation (ι y) ↔ W.valuation x ≤ W.valuation y)) ∧ (O ρ).valuation (algebraMap A K (t - algebraMap ↥W A c)) = (O ρ).valuation (ι (ρ : Ω))) → (∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → algebraMap A K (t - algebraMap ↥W A c) - ι (x : Ω) ≠ 0) → ∀ (F : K) (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A), wcFrfREP W A K 𝔭 t F k1 k2 Z Y d e → (∀ J : ℕ, ∃ (w : ℕ → ↥W) (a s : A), s ∉ 𝔭 ∧ algebraMap A K e / algebraMap A K d = ∑ j ∈ Finset.range J, algebraMap A K (algebraMap ↥W A (w j)) * algebraMap A K (t - algebraMap ↥W A c) ^ j + algebraMap A K (t - algebraMap ↥W A c) ^ J * algebraMap A K a / algebraMap A K s) → ∀ ρ₁ ρ₂ : ↥W, ρ₁ ∈ IsLocalRing.maximalIdeal ↥W → ρ₁ ≠ 0 → ρ₁ ∣ ρ₂ → (∀ z ∈ Z ++ Y, z ≠ c → ¬ (ρ₁ ∣ z - c ∧ z - c ∣ ρ₂)) → ∃ Λ : List (Ω × ℤ), ∀ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 → ρ₁ ∣ ρ → ρ ∣ ρ₂ → F - (Λ.map (fun p => ι p.1 * algebraMap A K (t - algebraMap ↥W A c) ^ p.2)).sum ∈ O ρ :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 t c O ι hPD hc hVAL hι1 hι2 hι4 F k1 k2 Z Y d e hR hTay ρ₁ ρ₂ hρ₁m hρ₁0 h12 hno
  classical
  set U : K := algebraMap A K (t - algebraMap ↥W A c) with hUdef

  have hrank : ∀ s t' : ↥W, s ≠ 0 → t' ∈ IsLocalRing.maximalIdeal ↥W → t' ≠ 0 →
      ∃ N : ℕ, s ∣ t' ^ N := by
    intro s t' hs ht _
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
    haveI : (⊥ : Ideal ↥W).IsPrime := Ideal.isPrime_bot
    have hmax := (Ring.krullDimLE_one_iff_of_isPrime_bot (R := ↥W)).mp inferInstance
    have hrad : t' ∈ (Ideal.span {s}).radical := by
      rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
      rintro J ⟨hJ, hJp⟩
      have hJ0 : J ≠ ⊥ := fun h => hs (by
        have : s ∈ J := hJ (Ideal.mem_span_singleton_self s)
        rw [h] at this; exact (Ideal.mem_bot.mp this))
      rw [IsLocalRing.eq_maximalIdeal (hmax J hJ0 hJp)]; exact ht
    obtain ⟨N, hN⟩ := Ideal.mem_radical_iff.mp hrad
    exact ⟨N, Ideal.mem_span_singleton.mp hN⟩

  have hq : ∀ Zs : List ↥W, (∀ ζ ∈ Zs, ζ ≠ 0 → ¬ (ρ₁ ∣ ζ ∧ ζ ∣ ρ₂)) →
      ∃ q : ↥W, q ∈ IsLocalRing.maximalIdeal ↥W ∧ q ≠ 0 ∧ q ∣ ρ₁ ∧
        ∀ ζ ∈ Zs, (¬ ρ₁ ∣ ζ → q * ζ ∣ ρ₁) ∧ (ρ₁ ∣ ζ → ζ ≠ 0 → ρ₂ ≠ 0 ∧ q * ρ₂ ∣ ζ) := by
    intro Zs
    induction Zs with
    | nil => intro _; exact ⟨ρ₁, hρ₁m, hρ₁0, dvd_rfl, by simp⟩
    | cons ζ rest ih =>
      intro hZ
      obtain ⟨q₀, hq₀m, hq₀0, hq₀1, hq₀⟩ := ih (fun z hz => hZ z (List.mem_cons_of_mem _ hz))
      have comb : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → w ≠ 0 →
          ∃ q, q ∈ IsLocalRing.maximalIdeal ↥W ∧ q ≠ 0 ∧ q ∣ q₀ ∧ q ∣ w := by
        intro w hwm hw0
        rcases ValuationRing.dvd_total q₀ w with h | h
        · exact ⟨q₀, hq₀m, hq₀0, dvd_rfl, h⟩
        · exact ⟨w, hwm, hw0, h, dvd_rfl⟩
      have inherit : ∀ q, q ∣ q₀ → ∀ z ∈ rest, (¬ ρ₁ ∣ z → q * z ∣ ρ₁) ∧
          (ρ₁ ∣ z → z ≠ 0 → ρ₂ ≠ 0 ∧ q * ρ₂ ∣ z) := by
        intro q hq' z hz
        obtain ⟨h1, h2⟩ := hq₀ z hz
        exact ⟨fun h => dvd_trans (mul_dvd_mul_right hq' z) (h1 h),
          fun h h' => ⟨(h2 h h').1, dvd_trans (mul_dvd_mul_right hq' ρ₂) (h2 h h').2⟩⟩
      by_cases hout : ρ₁ ∣ ζ
      · by_cases hz0 : ζ = 0
        · refine ⟨q₀, hq₀m, hq₀0, hq₀1, ?_⟩
          intro z hz
          rcases List.mem_cons.mp hz with hz | hz
          · subst hz
            exact ⟨fun h => absurd hout h, fun _ h => absurd hz0 h⟩
          · exact inherit q₀ dvd_rfl z hz
        · have hnd : ¬ ζ ∣ ρ₂ := fun h => hZ ζ List.mem_cons_self hz0 ⟨hout, h⟩
          have hρ₂0 : ρ₂ ≠ 0 := by rintro rfl; exact hnd (dvd_zero _)
          obtain ⟨w, hw⟩ : ρ₂ ∣ ζ := (ValuationRing.dvd_total ζ ρ₂).resolve_left hnd
          have hw0 : w ≠ 0 := by rintro rfl; rw [mul_zero] at hw; exact hz0 hw
          have hwm : w ∈ IsLocalRing.maximalIdeal ↥W := by
            by_contra hwu
            have hu : IsUnit w := IsLocalRing.notMem_maximalIdeal.mp hwu
            exact hnd ((IsUnit.dvd_mul_right hu).mp ⟨1, by rw [mul_one, ← hw]⟩)
          obtain ⟨q, hqm, hq0, hqq₀, hqw⟩ := comb w hwm hw0
          refine ⟨q, hqm, hq0, dvd_trans hqq₀ hq₀1, ?_⟩
          intro z hz
          rcases List.mem_cons.mp hz with hz | hz
          · subst hz
            refine ⟨fun h => absurd hout h, fun _ _ => ⟨hρ₂0, ?_⟩⟩
            rw [hw, mul_comm q]; exact mul_dvd_mul_left _ hqw
          · exact inherit q hqq₀ z hz
      · obtain ⟨w, hw⟩ : ζ ∣ ρ₁ := (ValuationRing.dvd_total ρ₁ ζ).resolve_left hout
        have hw0 : w ≠ 0 := by rintro rfl; rw [mul_zero] at hw; exact hρ₁0 hw
        have hwm : w ∈ IsLocalRing.maximalIdeal ↥W := by
          by_contra hwu
          have hu : IsUnit w := IsLocalRing.notMem_maximalIdeal.mp hwu
          exact hout ((IsUnit.dvd_mul_right hu).mp ⟨1, by rw [mul_one, ← hw]⟩)
        obtain ⟨q, hqm, hq0, hqq₀, hqw⟩ := comb w hwm hw0
        refine ⟨q, hqm, hq0, dvd_trans hqq₀ hq₀1, ?_⟩
        intro z hz
        rcases List.mem_cons.mp hz with hz | hz
        · subst hz
          refine ⟨fun _ => ?_, fun h => absurd h hout⟩
          rw [hw, mul_comm q]; exact mul_dvd_mul_left _ hqw
        · exact inherit q hqq₀ z hz

  set m := Y.length with hm
  obtain ⟨q, hqm, hq0, hq1, hqZ⟩ := hq (Y.map (fun y => y - c)) (by
    intro ζ hζ hζ0
    obtain ⟨y, hy, rfl⟩ := List.mem_map.mp hζ
    exact hno y (List.mem_append_right Z hy) (fun h => hζ0 (by rw [h, sub_self])))
  have hk2 : k2 ≠ 0 := hR.2.1
  have hB0 : k2 * (if ρ₂ = 0 then ρ₁ else ρ₂) ^ m ≠ 0 := by
    refine mul_ne_zero hk2 (pow_ne_zero _ ?_)
    split_ifs with h
    · exact hρ₁0
    · exact h
  obtain ⟨N, hN⟩ := hrank _ q hB0 hqm hq0
  set J := N + m + 1 with hJ
  have hJpos : J ≠ 0 := by omega

  have hη : ∀ ρ : ↥W, ρ ≠ 0 → ρ₁ ∣ ρ → ρ ∣ ρ₂ → ∃ η : ↥W, η ∣ ρ ^ J ∧ k2 * ρ ^ m ∣ η ∧
      ∀ y ∈ Y, (¬ ρ₁ ∣ y - c → ¬ ρ ∣ y - c ∧ η * (y - c) ^ J ∣ ρ ^ J) ∧
        (ρ₁ ∣ y - c → ¬ (y - c) ∣ ρ ∧ η * ρ ^ J ∣ (y - c) ^ J) := by
    intro ρ hρ0 h1ρ hρ2
    have side1 : ∀ y ∈ Y, ¬ ρ₁ ∣ y - c → ¬ ρ ∣ y - c := fun y _ h h' => h (dvd_trans h1ρ h')
    have side2 : ∀ y ∈ Y, ρ₁ ∣ y - c → ¬ (y - c) ∣ ρ := by
      intro y hy h h'
      by_cases h0 : y - c = 0
      · rw [h0] at h'; exact hρ0 (zero_dvd_iff.mp h')
      · exact hno y (List.mem_append_right Z hy) (fun h'' => h0 (by rw [h'', sub_self]))
          ⟨h, dvd_trans h' hρ2⟩
    have hqJ : k2 * (if ρ₂ = 0 then ρ₁ else ρ₂) ^ m ∣ q ^ J :=
      dvd_trans hN (pow_dvd_pow q (by omega))
    by_cases h20 : ρ₂ = 0
    · rw [if_pos h20] at hqJ
      obtain ⟨x, hx⟩ := h1ρ
      refine ⟨(x * q) ^ J, ?_, ?_, ?_⟩
      · exact pow_dvd_pow_of_dvd (by rw [hx, mul_comm ρ₁]; exact mul_dvd_mul_left x hq1) J
      · have e1 : k2 * (ρ₁ * x) ^ m = (k2 * ρ₁ ^ m) * x ^ m := by ring
        have e2 : (x * q) ^ J = q ^ J * x ^ J := by ring
        rw [hx, e1, e2]; exact mul_dvd_mul hqJ (pow_dvd_pow x (by omega))
      · intro y hy
        have hyZ := hqZ (y - c) (List.mem_map.mpr ⟨y, hy, rfl⟩)
        refine ⟨fun h => ⟨side1 y hy h, ?_⟩, fun h => ⟨side2 y hy h, ?_⟩⟩
        · rw [← mul_pow]
          apply pow_dvd_pow_of_dvd
          rw [hx, mul_assoc, mul_comm ρ₁]
          exact mul_dvd_mul_left x (hyZ.1 h)
        · have h0 : y - c = 0 := by
            by_contra h0; exact (hyZ.2 h h0).1 h20
          rw [h0, zero_pow hJpos]; exact dvd_zero _
    · rw [if_neg h20] at hqJ
      refine ⟨q ^ J, pow_dvd_pow_of_dvd (dvd_trans hq1 h1ρ) J,
        dvd_trans (mul_dvd_mul_left k2 (pow_dvd_pow_of_dvd hρ2 m)) hqJ, ?_⟩
      intro y hy
      have hyZ := hqZ (y - c) (List.mem_map.mpr ⟨y, hy, rfl⟩)
      refine ⟨fun h => ⟨side1 y hy h, ?_⟩, fun h => ⟨side2 y hy h, ?_⟩⟩
      · rw [← mul_pow]; exact pow_dvd_pow_of_dvd (dvd_trans (hyZ.1 h) h1ρ) J
      · by_cases h0 : y - c = 0
        · rw [h0, zero_pow hJpos]; exact dvd_zero _
        · rw [← mul_pow]
          exact pow_dvd_pow_of_dvd (dvd_trans (mul_dvd_mul_left q hρ2) (hyZ.2 h h0).2) J

  have pmul : ∀ (V : ValuationSubring K) (ee X1 M1 G1 X2 M2 G2 : K), V.valuation ee ≤ 1 →
      V.valuation M1 ≤ V.valuation G1 → V.valuation (X1 - M1) ≤ V.valuation G1 * V.valuation ee →
      V.valuation M2 ≤ V.valuation G2 → V.valuation (X2 - M2) ≤ V.valuation G2 * V.valuation ee →
      V.valuation (M1 * M2) ≤ V.valuation (G1 * G2) ∧
      V.valuation (X1 * X2 - M1 * M2) ≤ V.valuation (G1 * G2) * V.valuation ee := by
    intro V ee X1 M1 G1 X2 M2 G2 he hM1 hX1 hM2 hX2
    have hX1' : V.valuation X1 ≤ V.valuation G1 := by
      have : X1 = M1 + (X1 - M1) := by ring
      rw [this]
      exact Valuation.map_add_le _ hM1 (le_trans hX1 (mul_le_of_le_one_right' he))
    refine ⟨by rw [map_mul, map_mul]; exact mul_le_mul' hM1 hM2, ?_⟩
    have : X1 * X2 - M1 * M2 = X1 * (X2 - M2) + (X1 - M1) * M2 := by ring
    rw [this, map_mul]
    apply Valuation.map_add_le
    · rw [map_mul, mul_assoc]; exact mul_le_mul' hX1' hX2
    · rw [map_mul, mul_right_comm]; exact mul_le_mul' hX1 hM2
  have plist : ∀ (V : ValuationSubring K) (ee : K), V.valuation ee ≤ 1 →
      ∀ (l : List ↥W) (X M G : ↥W → K), (∀ b ∈ l, V.valuation (M b) ≤ V.valuation (G b) ∧
        V.valuation (X b - M b) ≤ V.valuation (G b) * V.valuation ee) →
      V.valuation (l.map M).prod ≤ V.valuation (l.map G).prod ∧
      V.valuation ((l.map X).prod - (l.map M).prod) ≤ V.valuation (l.map G).prod * V.valuation ee := by
    intro V ee he l X M G h
    induction l with
    | nil => simp
    | cons b l ih =>
      obtain ⟨h1, h2⟩ := ih (fun b' hb' => h b' (List.mem_cons_of_mem _ hb'))
      obtain ⟨h3, h4⟩ := h b List.mem_cons_self
      simp only [List.map_cons, List.prod_cons]
      exact pmul V ee _ _ _ _ _ _ he h3 h4 h1 h2
  have geo : ∀ (V : ValuationSubring K) (ee x a r G : K) (n : ℕ), x = a + r * x →
      V.valuation r ≤ 1 → V.valuation a ≤ V.valuation G → V.valuation x ≤ V.valuation G →
      V.valuation (r ^ n) ≤ V.valuation ee →
      V.valuation (∑ j ∈ Finset.range n, a * r ^ j) ≤ V.valuation G ∧
      V.valuation (x - ∑ j ∈ Finset.range n, a * r ^ j) ≤ V.valuation G * V.valuation ee := by
    intro V ee x a r G n hx hr ha hxG hrn
    have hid : ∀ k : ℕ, x - ∑ j ∈ Finset.range k, a * r ^ j = r ^ k * x := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        rw [Finset.sum_range_succ, ← sub_sub, ih]
        calc r ^ k * x - a * r ^ k = r ^ k * (x - a) := by ring
          _ = r ^ k * (r * x) := by rw [show x - a = r * x by linear_combination hx]
          _ = r ^ (k + 1) * x := by ring
    refine ⟨Valuation.map_sum_le _ (fun j _ => ?_), ?_⟩
    · rw [map_mul, map_pow]
      exact (mul_le_of_le_one_right' (pow_le_one' hr j)).trans ha
    · rw [hid, map_mul, mul_comm (V.valuation G)]
      exact mul_le_mul' hrn hxG

  have hU0 : U ≠ 0 := by
    have h := hι4 0 (Ideal.zero_mem _)
    simpa using h
  have h1p : (1 : A) ∉ 𝔭 := (Ideal.ne_top_iff_one 𝔭).mp hPD.2.2.2.1.ne_top
  have hcoe_pow : ∀ (x : ↥W) (n : ℕ), ι ((x ^ n : ↥W) : Ω) = ι (x : Ω) ^ n := by intro x n; simp
  have hcoe_mul : ∀ x y : ↥W, ι ((x * y : ↥W) : Ω) = ι (x : Ω) * ι (y : Ω) := by intro x y; simp

  have Lsingle : ∀ (a : Ω) (n : ℤ), ∃ Λ : List (Ω × ℤ),
      (Λ.map (fun p => ι p.1 * U ^ p.2)).sum = ι a * U ^ n :=
    fun a n => ⟨[(a, n)], by simp⟩
  have Ladd : ∀ x y : K, (∃ Λ : List (Ω × ℤ), (Λ.map (fun p => ι p.1 * U ^ p.2)).sum = x) →
      (∃ Λ : List (Ω × ℤ), (Λ.map (fun p => ι p.1 * U ^ p.2)).sum = y) →
      ∃ Λ : List (Ω × ℤ), (Λ.map (fun p => ι p.1 * U ^ p.2)).sum = x + y := by
    rintro x y ⟨Λ₁, rfl⟩ ⟨Λ₂, rfl⟩
    exact ⟨Λ₁ ++ Λ₂, by rw [List.map_append, List.sum_append]⟩
  have Lmul : ∀ x y : K, (∃ Λ : List (Ω × ℤ), (Λ.map (fun p => ι p.1 * U ^ p.2)).sum = x) →
      (∃ Λ : List (Ω × ℤ), (Λ.map (fun p => ι p.1 * U ^ p.2)).sum = y) →
      ∃ Λ : List (Ω × ℤ), (Λ.map (fun p => ι p.1 * U ^ p.2)).sum = x * y := by
    rintro x y ⟨Λ₁, rfl⟩ ⟨Λ₂, rfl⟩
    refine ⟨Λ₁.flatMap (fun p => Λ₂.map (fun q => (p.1 * q.1, p.2 + q.2))), ?_⟩
    induction Λ₁ with
    | nil => simp
    | cons p l ih =>
      rw [List.flatMap_cons, List.map_append, List.sum_append, ih, List.map_cons, List.sum_cons,
        add_mul, List.map_map]
      congr 1
      rw [← List.sum_map_mul_left]
      congr 1
      apply List.map_congr_left
      intro q _
      simp only [Function.comp_apply, map_mul, zpow_add₀ hU0]
      ring
  have Lι : ∀ a : Ω, ∃ Λ : List (Ω × ℤ), (Λ.map (fun p => ι p.1 * U ^ p.2)).sum = ι a := by
    intro a; obtain ⟨Λ, h⟩ := Lsingle a 0; exact ⟨Λ, by rw [h, zpow_zero, mul_one]⟩
  have LU : ∀ n : ℤ, ∃ Λ : List (Ω × ℤ), (Λ.map (fun p => ι p.1 * U ^ p.2)).sum = U ^ n := by
    intro n; obtain ⟨Λ, h⟩ := Lsingle 1 n; exact ⟨Λ, by rw [h, map_one, one_mul]⟩
  have Lpow : ∀ (x : K) (n : ℕ), (∃ Λ : List (Ω × ℤ), (Λ.map (fun p => ι p.1 * U ^ p.2)).sum = x) →
      ∃ Λ : List (Ω × ℤ), (Λ.map (fun p => ι p.1 * U ^ p.2)).sum = x ^ n := by
    intro x n hx
    induction n with
    | zero => obtain ⟨Λ, h⟩ := Lι 1; exact ⟨Λ, by rw [h, map_one, pow_zero]⟩
    | succ n ih => rw [pow_succ]; exact Lmul _ _ ih hx
  have Lsum : ∀ (n : ℕ) (f : ℕ → K),
      (∀ j, ∃ Λ : List (Ω × ℤ), (Λ.map (fun p => ι p.1 * U ^ p.2)).sum = f j) →
      ∃ Λ : List (Ω × ℤ), (Λ.map (fun p => ι p.1 * U ^ p.2)).sum = ∑ j ∈ Finset.range n, f j := by
    intro n f hf
    induction n with
    | zero => exact ⟨[], by simp⟩
    | succ n ih => rw [Finset.sum_range_succ]; exact Ladd _ _ ih (hf n)
  have Lprod : ∀ (l : List ↥W) (f : ↥W → K),
      (∀ b ∈ l, ∃ Λ : List (Ω × ℤ), (Λ.map (fun p => ι p.1 * U ^ p.2)).sum = f b) →
      ∃ Λ : List (Ω × ℤ), (Λ.map (fun p => ι p.1 * U ^ p.2)).sum = (l.map f).prod := by
    intro l f hf
    induction l with
    | nil => obtain ⟨Λ, h⟩ := Lι 1; exact ⟨Λ, by rw [h, map_one, List.map_nil, List.prod_nil]⟩
    | cons b l ih =>
      rw [List.map_cons, List.prod_cons]
      exact Lmul _ _ (hf b List.mem_cons_self) (ih (fun b' hb' => hf b' (List.mem_cons_of_mem _ hb')))

  obtain ⟨wT, aT, sT, hsT, hTJ⟩ := hTay J
  set MT : K := ∑ j ∈ Finset.range J, algebraMap A K (algebraMap ↥W A (wT j)) * U ^ j with hMT
  set My : ↥W → K := fun y => if ρ₁ ∣ y - c then
      ∑ j ∈ Finset.range J, U⁻¹ * (ι ((y - c : ↥W) : Ω) * U⁻¹) ^ j
    else ∑ j ∈ Finset.range J, -(ι ((y - c : ↥W) : Ω))⁻¹ * (U * (ι ((y - c : ↥W) : Ω))⁻¹) ^ j
    with hMy
  set MZf : ↥W → K := fun z => U - ι ((z - c : ↥W) : Ω) with hMZf
  set Main : K := ι (k1 : Ω) * (ι (k2 : Ω))⁻¹ * (Z.map MZf).prod * (Y.map My).prod * MT with hMain
  have LUinv : ∃ Λ : List (Ω × ℤ), (Λ.map (fun p => ι p.1 * U ^ p.2)).sum = U⁻¹ := by
    obtain ⟨Λ, h⟩ := LU (-1); exact ⟨Λ, by rw [h, zpow_neg_one]⟩
  have hLMain : ∃ Λ : List (Ω × ℤ), (Λ.map (fun p => ι p.1 * U ^ p.2)).sum = Main := by
    have L1 : ∀ x : Ω, ∃ Λ : List (Ω × ℤ), (Λ.map (fun p => ι p.1 * U ^ p.2)).sum = (ι x)⁻¹ := by
      intro x; obtain ⟨Λ, h⟩ := Lι x⁻¹; exact ⟨Λ, by rw [h, map_inv₀]⟩
    have LU1 : ∃ Λ : List (Ω × ℤ), (Λ.map (fun p => ι p.1 * U ^ p.2)).sum = U := by
      obtain ⟨Λ, h⟩ := LU 1; exact ⟨Λ, by rw [h, zpow_one]⟩
    refine Lmul _ _ (Lmul _ _ (Lmul _ _ (Lmul _ _ (Lι _) (L1 _)) ?_) ?_) ?_
    · refine Lprod _ _ (fun z _ => ?_)
      have h := Ladd _ _ LU1 (Lι (-((z - c : ↥W) : Ω)))
      rw [map_neg, ← sub_eq_add_neg] at h
      exact h
    · refine Lprod _ _ (fun y _ => ?_)
      simp only [hMy]
      split_ifs
      · exact Lsum _ _ (fun j => Lmul _ _ LUinv (Lpow _ _ (Lmul _ _ (Lι _) LUinv)))
      · refine Lsum _ _ (fun j => Lmul _ _ ?_ (Lpow _ _ (Lmul _ _ LU1 (L1 _))))
        obtain ⟨Λ, h⟩ := Lι (-((y - c : ↥W) : Ω))⁻¹
        exact ⟨Λ, by rw [h, map_inv₀, map_neg, inv_neg]⟩
    · exact Lsum _ _ (fun j => by
        obtain ⟨Λ, h⟩ := Lmul _ _ (Lι ((wT j : ↥W) : Ω)) (LU (j : ℤ))
        exact ⟨Λ, by rw [h, hι1, zpow_natCast]⟩)

  have hkey : ∀ x : ↥W, U - ι ((x - c : ↥W) : Ω) = algebraMap A K (t - algebraMap ↥W A x) := by
    intro x
    rw [show ((x - c : ↥W) : Ω) = (x : Ω) - (c : Ω) from rfl, map_sub, hι1, hι1, hUdef]
    simp only [map_sub]; ring
  have hk20 : ι (k2 : Ω) ≠ 0 := (map_ne_zero ι).mpr (fun h => hk2 (Subtype.ext h))
  have hd0 : algebraMap A K d ≠ 0 := by
    intro h; apply hR.2.2.1
    have := (IsFractionRing.injective A K) (h.trans (map_zero _).symm)
    rw [this]; exact Ideal.zero_mem _
  have hPYne : ∀ l : List ↥W, (∀ y ∈ l, y ∈ IsLocalRing.maximalIdeal ↥W) → (l.map MZf).prod ≠ 0 := by
    intro l hl
    induction l with
    | nil => simp
    | cons b l ih =>
      rw [List.map_cons, List.prod_cons]
      exact mul_ne_zero (hι4 (b - c) (Ideal.sub_mem _ (hl b List.mem_cons_self) hc))
        (ih (fun y hy => hl y (List.mem_cons_of_mem _ hy)))
  have hYinv : ∀ l : List ↥W, (l.map (fun y => (MZf y)⁻¹)).prod = ((l.map MZf).prod)⁻¹ := by
    intro l
    induction l with
    | nil => simp
    | cons b l ih => simp only [List.map_cons, List.prod_cons, ih, mul_inv]
  have hYm : ∀ y ∈ Y, y ∈ IsLocalRing.maximalIdeal ↥W :=
    fun y hy => hR.2.2.2.2.1 y (List.mem_append_right Z hy)
  have hPY0 := hPYne Y hYm
  have hF : F = ι (k1 : Ω) * (ι (k2 : Ω))⁻¹ * (Z.map MZf).prod * (Y.map (fun y => (MZf y)⁻¹)).prod *
      (algebraMap A K e / algebraMap A K d) := by
    have hEq := hR.2.2.2.2.2
    rw [← hι1 k1, ← hι1 k2,
      show (Y.map (fun y => algebraMap A K (t - algebraMap ↥W A y))) = Y.map MZf from
        List.map_congr_left (fun y _ => (hkey y).symm),
      show (Z.map (fun z => algebraMap A K (t - algebraMap ↥W A z))) = Z.map MZf from
        List.map_congr_left (fun z _ => (hkey z).symm)] at hEq
    have h2 : F = (ι (k1 : Ω) * (Z.map MZf).prod * algebraMap A K e) /
        (algebraMap A K d * ι (k2 : Ω) * (Y.map MZf).prod) := by
      rw [eq_div_iff (mul_ne_zero (mul_ne_zero hd0 hk20) hPY0)]
      linear_combination hEq
    rw [h2, hYinv]; ring
  obtain ⟨Λ, hΛ⟩ := hLMain
  refine ⟨Λ, ?_⟩
  intro ρ hρm hρ0 h1ρ hρ2
  rw [hΛ]
  obtain ⟨hP2, hP3⟩ := hι2 ρ hρm hρ0
  have T1 : ∀ x y : ↥W, x ∣ y → (O ρ).valuation (ι (y : Ω)) ≤ (O ρ).valuation (ι (x : Ω)) := by
    rintro x y ⟨k, rfl⟩
    apply (hP2 _ _).mpr
    rw [show ((x * k : ↥W) : Ω) = (x : Ω) * (k : Ω) from rfl, map_mul]
    exact mul_le_of_le_one_right' (ValuationSubring.valuation_le_one W k)
  have T2 : ∀ x y : ↥W, ¬ x ∣ y → (O ρ).valuation (ι (x : Ω)) < (O ρ).valuation (ι (y : Ω)) := by
    intro x y hxy
    by_contra hlt
    rw [not_lt] at hlt
    obtain ⟨a, ha⟩ := (ValuationSubring.valuation_le_iff W _ _).mp ((hP2 _ _).mp hlt)
    exact hxy ⟨a, Subtype.ext (by
      show (y : Ω) = (x : Ω) * (a : Ω)
      rw [← ha, mul_comm])⟩
  have hle1 : ∀ x : ↥W, (O ρ).valuation (ι (x : Ω)) ≤ 1 := by
    intro x
    have h := T1 1 x (one_dvd x)
    rwa [show ((1 : ↥W) : Ω) = 1 from rfl, map_one, map_one] at h
  have hU1 : (O ρ).valuation U ≤ 1 := by rw [hP3]; exact hle1 ρ
  have hUpos : 0 < (O ρ).valuation U := zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr hU0)
  obtain ⟨η, hE1, hE2, hE3⟩ := hη ρ hρ0 h1ρ hρ2
  have hee1 : (O ρ).valuation (ι (η : Ω)) ≤ 1 := hle1 η
  have hk2e : (O ρ).valuation (ι (η : Ω)) ≤ (O ρ).valuation (ι (k2 : Ω) * U ^ m) := by
    have h := T1 _ _ hE2
    rw [hcoe_mul, hcoe_pow, map_mul, map_pow] at h
    rw [map_mul, map_pow, hP3]; exact h

  have hYb : ∀ y ∈ Y, (O ρ).valuation (My y) ≤ (O ρ).valuation U⁻¹ ∧
      (O ρ).valuation ((MZf y)⁻¹ - My y) ≤ (O ρ).valuation U⁻¹ * (O ρ).valuation (ι (η : Ω)) := by
    intro y hy
    have hUw : U - ι ((y - c : ↥W) : Ω) ≠ 0 := hι4 (y - c) (Ideal.sub_mem _ (hYm y hy) hc)
    by_cases h : ρ₁ ∣ y - c
    · obtain ⟨hnd, h2⟩ := (hE3 y hy).2 h
      simp only [hMy, hMZf, if_pos h]
      have hlt : (O ρ).valuation (ι ((y - c : ↥W) : Ω)) < (O ρ).valuation U := by
        rw [hP3]; exact T2 _ _ hnd
      refine geo (O ρ) _ _ _ _ _ J ?_ ?_ le_rfl ?_ ?_
      · field_simp; ring
      · rw [map_mul, map_inv₀, mul_inv_le_iff₀ hUpos, one_mul]; exact hlt.le
      · rw [map_inv₀, map_inv₀, Valuation.map_sub_eq_of_lt_left _ hlt]
      · have h3 := T1 _ _ h2
        rw [hcoe_pow, hcoe_mul, hcoe_pow, map_pow, map_mul, map_pow, ← hP3] at h3
        rw [map_pow, map_mul, map_inv₀, mul_pow, inv_pow, mul_inv_le_iff₀ (pow_pos hUpos J)]
        exact h3
    · obtain ⟨hnd, h2⟩ := (hE3 y hy).1 h
      simp only [hMy, hMZf, if_neg h]
      have hlt : (O ρ).valuation U < (O ρ).valuation (ι ((y - c : ↥W) : Ω)) := by
        rw [hP3]; exact T2 _ _ hnd
      have hwpos : 0 < (O ρ).valuation (ι ((y - c : ↥W) : Ω)) := lt_of_le_of_lt zero_le' hlt
      have hw0 : ι ((y - c : ↥W) : Ω) ≠ 0 := (Valuation.ne_zero_iff _).mp hwpos.ne'
      refine geo (O ρ) _ _ _ _ _ J ?_ ?_ ?_ ?_ ?_
      · field_simp; ring
      · rw [map_mul, map_inv₀, mul_inv_le_iff₀ hwpos, one_mul]; exact hlt.le
      · rw [Valuation.map_neg, map_inv₀, map_inv₀]; exact inv_anti₀ hUpos hlt.le
      · rw [map_inv₀, map_inv₀, Valuation.map_sub_eq_of_lt_right _ hlt]; exact inv_anti₀ hUpos hlt.le
      · have h3 := T1 _ _ h2
        rw [hcoe_pow, hcoe_mul, hcoe_pow, map_pow, map_mul, map_pow, ← hP3] at h3
        rw [map_pow, map_mul, map_inv₀, mul_pow, inv_pow, mul_inv_le_iff₀ (pow_pos hwpos J)]
        exact h3
  have cY := plist (O ρ) _ hee1 Y (fun y => (MZf y)⁻¹) My (fun _ => U⁻¹) hYb

  have cZ := plist (O ρ) _ hee1 Z MZf MZf (fun _ => 1) (by
    intro z _
    refine ⟨?_, by rw [sub_self, map_zero]; exact zero_le'⟩
    rw [map_one]
    exact (Valuation.map_sub _ _ _).trans (max_le hU1 (hle1 _)))
  rw [List.map_const', List.prod_replicate, one_pow] at cZ

  have hsT0 : algebraMap A K sT ≠ 0 := by
    intro h; apply hsT
    have := (IsFractionRing.injective A K) (h.trans (map_zero _).symm)
    rw [this]; exact Ideal.zero_mem _
  have hsinv : (algebraMap A K sT)⁻¹ ∈ O ρ := by
    have hrep : wcFrfREP W A K 𝔭 t (algebraMap A K sT) 1 1 [] [] 1 sT :=
      ⟨one_ne_zero, one_ne_zero, h1p, hsT, by simp, by simp⟩
    have hP0 : wcFrfP W c ρ [] = 1 := by simp [wcFrfP]
    have h := ((hVAL ρ hρm hρ0).1 _ 1 1 [] [] 1 sT hsT0 hrep).2
    simpa [hP0] using h
  have hA1 : ∀ a : A, (O ρ).valuation (algebraMap A K a) ≤ 1 :=
    fun a => ((O ρ).valuation_le_one_iff _).mpr ((hVAL ρ hρm hρ0).2.2 a)
  have hT1 : (O ρ).valuation MT ≤ (O ρ).valuation 1 := by
    rw [map_one]
    refine Valuation.map_sum_le _ (fun j _ => ?_)
    rw [map_mul, map_pow]
    exact mul_le_one' (hA1 _) (pow_le_one' hU1 j)
  have hT2 : (O ρ).valuation (algebraMap A K e / algebraMap A K d - MT) ≤
      (O ρ).valuation 1 * (O ρ).valuation (ι (η : Ω)) := by
    rw [hTJ, add_sub_cancel_left, map_one, one_mul, div_eq_mul_inv, map_mul, map_mul]
    have hUJ : (O ρ).valuation (U ^ J) ≤ (O ρ).valuation (ι (η : Ω)) := by
      have h := T1 _ _ hE1
      rw [hcoe_pow, map_pow] at h
      rw [map_pow, hP3]; exact h
    calc (O ρ).valuation (U ^ J) * (O ρ).valuation (algebraMap A K aT) *
          (O ρ).valuation (algebraMap A K sT)⁻¹
        ≤ (O ρ).valuation (ι (η : Ω)) * 1 * 1 :=
          mul_le_mul' (mul_le_mul' hUJ (hA1 _)) (((O ρ).valuation_le_one_iff _).mpr hsinv)
      _ = _ := by rw [mul_one, mul_one]

  have c1 := pmul (O ρ) _ (ι (k1 : Ω)) (ι (k1 : Ω)) 1 (ι (k2 : Ω))⁻¹ (ι (k2 : Ω))⁻¹ (ι (k2 : Ω))⁻¹
    hee1 (by rw [map_one]; exact hle1 k1) (by rw [sub_self, map_zero]; exact zero_le')
    le_rfl (by rw [sub_self, map_zero]; exact zero_le')
  have c2 := pmul (O ρ) _ _ _ _ (Z.map MZf).prod (Z.map MZf).prod 1 hee1 c1.1 c1.2 cZ.1
    (by rw [sub_self, map_zero]; exact zero_le')
  have c3 := pmul (O ρ) _ _ _ _ _ _ _ hee1 c2.1 c2.2 cY.1 cY.2
  have c4 := pmul (O ρ) _ _ _ _ _ _ _ hee1 c3.1 c3.2 hT1 hT2
  have hG : 1 * (ι (k2 : Ω))⁻¹ * 1 * (Y.map (fun _ => U⁻¹)).prod * 1 = (ι (k2 : Ω) * U ^ m)⁻¹ := by
    rw [List.map_const', List.prod_replicate, ← hm]; ring
  have hfin := c4.2
  rw [hG, ← hF] at hfin
  apply ((O ρ).valuation_le_one_iff _).mp
  refine hfin.trans ?_
  rw [map_inv₀, inv_mul_le_iff₀ (zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr
    (mul_ne_zero hk20 (pow_ne_zero _ hU0)))), mul_one]
  exact hk2e

theorem wcFrfCp_cell : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (B : List ↥W) (ρ : ↥W), ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 → (∀ b ∈ B, ¬ (ρ ∣ b ∧ b ∣ ρ)) → ∃ σo σi : ↥W, σo ∈ IsLocalRing.maximalIdeal ↥W ∧ σo ≠ 0 ∧ σo ∣ ρ ∧ ¬ ρ ∣ σo ∧ σi ∈ IsLocalRing.maximalIdeal ↥W ∧ σi ≠ 0 ∧ ρ ∣ σi ∧ ¬ σi ∣ ρ ∧ ∀ b ∈ B, ((b ∣ ρ ↔ b ∣ σo) ∧ (ρ ∣ b ↔ σo ∣ b)) ∧ ((b ∣ ρ ↔ b ∣ σi) ∧ (ρ ∣ b ↔ σi ∣ b)) :=
by
  intro Ω _ _ W B ρ hρm hρ0 hB
  classical
  have hC : ∀ x s : ↥W, x ≠ 0 → s ∈ IsLocalRing.maximalIdeal ↥W → ¬ (x * s ∣ x) := by
    intro x s hx hs hdvd
    obtain ⟨c, hc⟩ := hdvd
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hs
    apply hs
    have h1 : x * 1 = x * (s * c) := by rw [mul_one, ← mul_assoc]; exact hc
    have h2 : 1 = s * c := mul_left_cancel₀ hx h1
    exact isUnit_iff_exists_inv.mpr ⟨c, h2.symm⟩
  have hsqrt : ∀ v : ↥W, v ∈ IsLocalRing.maximalIdeal ↥W → v ≠ 0 →
      ∃ s : ↥W, s ∈ IsLocalRing.maximalIdeal ↥W ∧ s ≠ 0 ∧ v = s * s := by
    intro v hv hv0
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_eq_mul_self (v : Ω)
    have hv0' : (v : Ω) ≠ 0 := fun h => hv0 (Subtype.ext h)
    have hzW : z ∈ W := by
      rcases W.mem_or_inv_mem z with h | h
      · exact h
      · have hz0 : z ≠ 0 := by
          rintro rfl
          apply hv0'
          rw [hz, mul_zero]
        have hzeq : z = (v : Ω) * z⁻¹ := by rw [hz, mul_inv_cancel_right₀ hz0]
        rw [hzeq]
        exact W.mul_mem _ _ v.2 h
    have hveq : v = (⟨z, hzW⟩ : ↥W) * ⟨z, hzW⟩ := Subtype.ext hz
    refine ⟨⟨z, hzW⟩, ?_, ?_, hveq⟩
    · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hv ⊢
      intro h
      apply hv
      rw [hveq]
      exact h.mul h
    · intro h
      apply hv0
      rw [hveq, h, mul_zero]
  have hmax : ∀ (P : ↥W → Prop) (e : ↥W) (L : List ↥W), ∃ g : ↥W,
      (g = e ∨ (g ∈ L ∧ P g)) ∧ e ∣ g ∧ ∀ x ∈ L, P x → x ∣ g := by
    intro P e L
    induction L with
    | nil => exact ⟨e, Or.inl rfl, dvd_rfl, fun x hx => by simp at hx⟩
    | cons a L ih =>
      obtain ⟨g, hg1, hg2, hg3⟩ := ih
      have hg1' : g = e ∨ (g ∈ a :: L ∧ P g) := by
        rcases hg1 with h1 | h1
        · exact Or.inl h1
        · exact Or.inr ⟨List.mem_cons_of_mem _ h1.1, h1.2⟩
      by_cases hPa : P a
      · rcases ValuationRing.dvd_total a g with h | h
        · refine ⟨g, hg1', hg2, ?_⟩
          intro x hx hPx
          rcases List.mem_cons.mp hx with rfl | hx
          · exact h
          · exact hg3 x hx hPx
        · refine ⟨a, Or.inr ⟨List.mem_cons_self, hPa⟩, hg2.trans h, ?_⟩
          intro x hx hPx
          rcases List.mem_cons.mp hx with rfl | hx
          · exact dvd_rfl
          · exact (hg3 x hx hPx).trans h
      · refine ⟨g, hg1', hg2, ?_⟩
        intro x hx hPx
        rcases List.mem_cons.mp hx with rfl | hx
        · exact absurd hPx hPa
        · exact hg3 x hx hPx
  have hmin : ∀ (P : ↥W → Prop) (e : ↥W) (L : List ↥W), ∃ g : ↥W,
      (g = e ∨ (g ∈ L ∧ P g)) ∧ g ∣ e ∧ ∀ x ∈ L, P x → g ∣ x := by
    intro P e L
    induction L with
    | nil => exact ⟨e, Or.inl rfl, dvd_rfl, fun x hx => by simp at hx⟩
    | cons a L ih =>
      obtain ⟨g, hg1, hg2, hg3⟩ := ih
      have hg1' : g = e ∨ (g ∈ a :: L ∧ P g) := by
        rcases hg1 with h1 | h1
        · exact Or.inl h1
        · exact Or.inr ⟨List.mem_cons_of_mem _ h1.1, h1.2⟩
      by_cases hPa : P a
      · rcases ValuationRing.dvd_total g a with h | h
        · refine ⟨g, hg1', hg2, ?_⟩
          intro x hx hPx
          rcases List.mem_cons.mp hx with rfl | hx
          · exact h
          · exact hg3 x hx hPx
        · refine ⟨a, Or.inr ⟨List.mem_cons_self, hPa⟩, h.trans hg2, ?_⟩
          intro x hx hPx
          rcases List.mem_cons.mp hx with rfl | hx
          · exact dvd_rfl
          · exact h.trans (hg3 x hx hPx)
      · refine ⟨g, hg1', hg2, ?_⟩
        intro x hx hPx
        rcases List.mem_cons.mp hx with rfl | hx
        · exact absurd hPx hPa
        · exact hg3 x hx hPx
  have hρnu : ¬ IsUnit ρ := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hρm
    exact hρm

  obtain ⟨β, hβ1, -, hβ3⟩ := hmax (fun b => b ∣ ρ) 1 B
  have hβρ : β ∣ ρ := by
    rcases hβ1 with h | h
    · rw [h]; exact one_dvd _
    · exact h.2
  have hρβ : ¬ ρ ∣ β := by
    rcases hβ1 with h | h
    · rw [h]; intro h1; exact hρnu (isUnit_of_dvd_one h1)
    · intro h1; exact hB β h.1 ⟨h1, h.2⟩
  obtain ⟨u, hu⟩ := hβρ
  have hβ0 : β ≠ 0 := by
    intro h; apply hρ0; rw [hu, h, zero_mul]
  have hu0 : u ≠ 0 := by
    intro h; apply hρ0; rw [hu, h, mul_zero]
  have hum : u ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hunit
    apply hρβ
    rw [hu]
    exact hunit.mul_right_dvd.mpr dvd_rfl
  obtain ⟨s, hsm, hs0, hus⟩ := hsqrt u hum hu0
  have hρeq : ρ = β * s * s := by rw [hu, hus, mul_assoc]
  have hσo_dvd : β * s ∣ ρ := ⟨s, hρeq⟩
  have hρσo : ¬ ρ ∣ β * s := by
    rw [hρeq]; exact hC (β * s) s (mul_ne_zero hβ0 hs0) hsm

  obtain ⟨γ, hγ1, hγ2, hγ3⟩ := hmin (fun b => ρ ∣ b) (ρ * ρ) B
  have hργ : ρ ∣ γ := by
    rcases hγ1 with h | h
    · rw [h]; exact dvd_mul_right _ _
    · exact h.2
  have hγρ : ¬ γ ∣ ρ := by
    rcases hγ1 with h | h
    · rw [h]; exact hC ρ ρ hρ0 hρm
    · intro h1; exact hB γ h.1 ⟨h.2, h1⟩
  obtain ⟨v, hv⟩ := hργ
  have hv0 : v ≠ 0 := by
    intro h
    rw [h, mul_zero] at hv
    rw [hv] at hγ2
    exact hρ0 (mul_self_eq_zero.mp (zero_dvd_iff.mp hγ2))
  have hvm : v ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hunit
    apply hγρ
    rw [hv]
    exact hunit.mul_right_dvd.mpr dvd_rfl
  obtain ⟨s', hs'm, hs'0, hvs⟩ := hsqrt v hvm hv0
  have hγeq : γ = ρ * s' * s' := by rw [hv, hvs, mul_assoc]
  refine ⟨β * s, ρ * s', Ideal.mul_mem_left _ β hsm, mul_ne_zero hβ0 hs0, hσo_dvd, hρσo,
    Ideal.mul_mem_right s' _ hρm, mul_ne_zero hρ0 hs'0, dvd_mul_right ρ s', hC ρ s' hρ0 hs'm, ?_⟩
  intro b hb
  refine ⟨⟨⟨fun h => (hβ3 b hb h).trans (dvd_mul_right β s), fun h => h.trans hσo_dvd⟩,
    ⟨fun h => hσo_dvd.trans h, fun h => ?_⟩⟩,
    ⟨⟨fun h => h.trans (dvd_mul_right ρ s'), fun h => ?_⟩,
      ⟨fun h => ?_, fun h => (dvd_mul_right ρ s').trans h⟩⟩⟩
  · rcases ValuationRing.dvd_total b ρ with h' | h'
    · exact absurd (h.trans (hβ3 b hb h')) (hC β s hβ0 hsm)
    · exact h'
  · rcases ValuationRing.dvd_total b ρ with h' | h'
    · exact h'
    · have h3 := hγ3 b hb h'
      rw [hγeq] at h3
      exact absurd (h3.trans h) (hC (ρ * s') s' (mul_ne_zero hρ0 hs'0) hs'm)
  · have h3 := hγ3 b hb h
    rw [hγeq] at h3
    exact (dvd_mul_right (ρ * s') s').trans h3

theorem wcFrfCp_ties : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (L : List (Ω × ℤ)), (∀ p ∈ L, p.1 ≠ 0) → ∃ Ex : List ↥W, (∀ x ∈ Ex, x ∈ IsLocalRing.maximalIdeal ↥W) ∧ (∀ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 → (∀ x ∈ Ex, ¬ (ρ ∣ x ∧ x ∣ ρ)) → ∀ p ∈ L, ∀ q ∈ L, p.2 ≠ q.2 → W.valuation (p.1 * (ρ : Ω) ^ p.2) ≠ W.valuation (q.1 * (ρ : Ω) ^ q.2)) ∧ (∀ ρ σ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 → σ ∈ IsLocalRing.maximalIdeal ↥W → σ ≠ 0 → (∀ x ∈ Ex, ¬ (ρ ∣ x ∧ x ∣ ρ)) → (∀ x ∈ Ex, (x ∣ ρ ↔ x ∣ σ) ∧ (ρ ∣ x ↔ σ ∣ x)) → ∀ p ∈ L, ∀ q ∈ L, (W.valuation (p.1 * (ρ : Ω) ^ p.2) < W.valuation (q.1 * (ρ : Ω) ^ q.2) ↔ W.valuation (p.1 * (σ : Ω) ^ p.2) < W.valuation (q.1 * (σ : Ω) ^ q.2))) :=
by
  intro Ω _ _ W L hL
  classical

  have hdvd : ∀ x y : W, x ∣ y ↔ W.valuation (y : Ω) ≤ W.valuation (x : Ω) := by
    intro x y
    rw [W.valuation_le_iff]
    constructor
    · rintro ⟨c, rfl⟩
      exact ⟨c, by simp [mul_comm]⟩
    · rintro ⟨c, hc⟩
      exact ⟨c, Subtype.ext (by simp [← hc, mul_comm])⟩
  have hm : ∀ ρ : W, ρ ∈ IsLocalRing.maximalIdeal W → W.valuation (ρ : Ω) < 1 :=
    fun ρ h => (W.valuation_lt_one_iff ρ).mp h
  have hcoe : ∀ ρ : W, ρ ≠ 0 → (ρ : Ω) ≠ 0 := by
    intro ρ hρ h
    apply hρ
    exact Subtype.ext h

  have key : ∀ (a b x s : Ω) (n k : ℤ), a ≠ 0 → b ≠ 0 → s ≠ 0 → k < n →
      x ^ (n - k).toNat = b / a →
      (W.valuation (a * s ^ n) < W.valuation (b * s ^ k) ↔ W.valuation s < W.valuation x) ∧
      (W.valuation (b * s ^ k) < W.valuation (a * s ^ n) ↔ W.valuation x < W.valuation s) ∧
      (W.valuation (a * s ^ n) = W.valuation (b * s ^ k) ↔ W.valuation s = W.valuation x) := by
    intro a b x s n k ha hb hs hkn hx
    have hN : (((n - k).toNat : ℕ) : ℤ) = n - k := Int.toNat_of_nonneg (by omega)
    generalize hNg : (n - k).toNat = N at hx hN
    have hN0 : N ≠ 0 := by omega
    have e1 : a * s ^ n = s ^ N * (a * s ^ k) := by
      rw [show n = k + (N : ℤ) by omega, zpow_add₀ hs, zpow_natCast]
      ring
    have e2 : b * s ^ k = x ^ N * (a * s ^ k) := by
      rw [hx]
      field_simp
    have hc : 0 < W.valuation (a * s ^ k) :=
      zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr (mul_ne_zero ha (zpow_ne_zero _ hs)))
    rw [e1, e2, map_mul W.valuation (s ^ N), map_mul W.valuation (x ^ N), map_pow, map_pow]
    refine ⟨?_, ?_, ?_⟩
    · rw [mul_lt_mul_iff_of_pos_right hc, pow_lt_pow_iff_left₀ zero_le' zero_le' hN0]
    · rw [mul_lt_mul_iff_of_pos_right hc, pow_lt_pow_iff_left₀ zero_le' zero_le' hN0]
    · rw [mul_left_inj' hc.ne', pow_left_inj₀ zero_le' zero_le' hN0]

  have hroot : ∀ p q : Ω × ℤ, ∃ ξ : Ω, q.2 < p.2 → ξ ^ (p.2 - q.2).toNat = q.1 / p.1 := by
    intro p q
    by_cases h : q.2 < p.2
    · obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (q.1 / p.1)
        (show 0 < (p.2 - q.2).toNat by omega)
      exact ⟨z, fun _ => hz⟩
    · exact ⟨0, fun h' => absurd h' h⟩
  choose ξ hξ using hroot
  let f : Ω × ℤ → Ω × ℤ → W := fun p q =>
    if h : W.valuation (ξ p q) < 1 then ⟨ξ p q, W.mem_of_valuation_le_one _ h.le⟩ else 0
  have hf_coe : ∀ p q, W.valuation (ξ p q) < 1 → ((f p q : W) : Ω) = ξ p q := by
    intro p q h
    simp only [f, dif_pos h]
  refine ⟨L.flatMap (fun p => L.map (f p)), ?_, ?_, ?_⟩
  · intro x hx
    obtain ⟨p, _, hx⟩ := List.mem_flatMap.mp hx
    obtain ⟨q, _, rfl⟩ := List.mem_map.mp hx
    by_cases h : W.valuation (ξ p q) < 1
    · rw [W.valuation_lt_one_iff, hf_coe p q h]
      exact h
    · simp only [f, dif_neg h]
      exact Ideal.zero_mem _
  · have hf_mem : ∀ p ∈ L, ∀ q ∈ L, f p q ∈ L.flatMap (fun p => L.map (f p)) :=
      fun p hp q hq => List.mem_flatMap.mpr ⟨p, hp, List.mem_map.mpr ⟨q, hq, rfl⟩⟩
    intro ρ hρm hρ0 hgen p hp q hq hne heq
    have tie : ∀ p ∈ L, ∀ q ∈ L, W.valuation (ρ : Ω) = W.valuation (ξ p q) → False := by
      intro p hp q hq hv
      have hlt : W.valuation (ξ p q) < 1 := hv ▸ hm ρ hρm
      have hx := hf_coe p q hlt
      exact hgen (f p q) (hf_mem p hp q hq)
        ⟨(hdvd ρ (f p q)).mpr (by rw [hx, hv]), (hdvd (f p q) ρ).mpr (by rw [hx, hv])⟩
    rcases lt_or_gt_of_ne hne with h | h
    · exact tie q hq p hp ((key q.1 p.1 (ξ q p) (ρ : Ω) q.2 p.2 (hL q hq) (hL p hp) (hcoe ρ hρ0) h
        (hξ q p h)).2.2.mp heq.symm)
    · exact tie p hp q hq ((key p.1 q.1 (ξ p q) (ρ : Ω) p.2 q.2 (hL p hp) (hL q hq) (hcoe ρ hρ0) h
        (hξ p q h)).2.2.mp heq)
  · have hf_mem : ∀ p ∈ L, ∀ q ∈ L, f p q ∈ L.flatMap (fun p => L.map (f p)) :=
      fun p hp q hq => List.mem_flatMap.mpr ⟨p, hp, List.mem_map.mpr ⟨q, hq, rfl⟩⟩
    intro ρ σ hρm hρ0 hσm hσ0 _ hpos p hp q hq
    have transfer : ∀ p ∈ L, ∀ q ∈ L,
        (W.valuation (ρ : Ω) < W.valuation (ξ p q) ↔ W.valuation (σ : Ω) < W.valuation (ξ p q)) ∧
        (W.valuation (ξ p q) < W.valuation (ρ : Ω) ↔ W.valuation (ξ p q) < W.valuation (σ : Ω)) := by
      intro p hp q hq
      by_cases h : W.valuation (ξ p q) < 1
      · have hx := hf_coe p q h
        obtain ⟨h1, h2⟩ := hpos (f p q) (hf_mem p hp q hq)
        rw [hdvd, hdvd, hx] at h1 h2
        constructor
        · rw [← not_le, ← not_le, h2]
        · rw [← not_le, ← not_le, h1]
      · push_neg at h
        have hρ1 := hm ρ hρm
        have hσ1 := hm σ hσm
        exact ⟨iff_of_true (lt_of_lt_of_le hρ1 h) (lt_of_lt_of_le hσ1 h),
          iff_of_false (not_lt.mpr (le_trans hρ1.le h)) (not_lt.mpr (le_trans hσ1.le h))⟩
    rcases lt_trichotomy p.2 q.2 with h | h | h
    · rw [(key q.1 p.1 (ξ q p) (ρ : Ω) q.2 p.2 (hL q hq) (hL p hp) (hcoe ρ hρ0) h (hξ q p h)).2.1,
        (key q.1 p.1 (ξ q p) (σ : Ω) q.2 p.2 (hL q hq) (hL p hp) (hcoe σ hσ0) h (hξ q p h)).2.1]
      exact (transfer q hq p hp).2
    · have hρk : 0 < W.valuation ((ρ : Ω) ^ q.2) :=
        zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr (zpow_ne_zero _ (hcoe ρ hρ0)))
      have hσk : 0 < W.valuation ((σ : Ω) ^ q.2) :=
        zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr (zpow_ne_zero _ (hcoe σ hσ0)))
      rw [h, map_mul, map_mul, map_mul, map_mul, mul_lt_mul_iff_of_pos_right hρk,
        mul_lt_mul_iff_of_pos_right hσk]
    · rw [(key p.1 q.1 (ξ p q) (ρ : Ω) p.2 q.2 (hL p hp) (hL q hq) (hcoe ρ hρ0) h (hξ p q h)).1,
        (key p.1 q.1 (ξ p q) (σ : Ω) p.2 q.2 (hL p hp) (hL q hq) (hcoe σ hσ0) h (hξ p q h)).1]
      exact (transfer p hp q hq).1

theorem wcFrfCp_dominant : ∀ {K : Type u} [Field K] (O : ValuationSubring K) {β : Type u} (D : List β) (g : β → K) (E : K), E ∈ O → ((∀ q ∈ D, O.valuation (g q) ≤ 1) → (D.map g).sum + E ∈ O) ∧ (D.Nodup → ∀ p ∈ D, 1 < O.valuation (g p) → (∀ q ∈ D, q ≠ p → O.valuation (g q) < O.valuation (g p)) → O.valuation ((D.map g).sum + E) = O.valuation (g p)) :=
by
  classical
  intro K _ O β D g E hE
  refine ⟨?_, ?_⟩
  · intro h
    refine O.add_mem _ _ ?_ hE
    refine list_sum_mem ?_
    intro x hx
    obtain ⟨q, hq, rfl⟩ := List.mem_map.mp hx
    exact (O.valuation_le_one_iff _).mp (h q hq)
  · intro hnd p hp h1 hdom
    have hEv : O.valuation E < O.valuation (g p) :=
      lt_of_le_of_lt ((O.valuation_le_one_iff E).mpr hE) h1
    have aux : ∀ L : List β, (∀ q ∈ L, O.valuation (g q) < O.valuation (g p)) →
        O.valuation ((L.map g).sum + E) < O.valuation (g p) := by
      intro L
      induction L with
      | nil => intro _; simpa using hEv
      | cons q L' ih =>
        intro hL
        rw [List.map_cons, List.sum_cons, add_assoc]
        exact Valuation.map_add_lt _ (hL q (by simp))
          (ih (fun r hr => hL r (List.mem_cons_of_mem _ hr)))
    have hR := aux (D.erase p) (fun q hq => by
      rw [hnd.mem_erase_iff] at hq
      exact hdom q hq.2 hq.1)
    rw [← List.sum_map_erase g hp, add_assoc]
    exact Valuation.map_add_eq_of_lt_left _ hR

theorem wcFrfCp_slope : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (c ρ σ k1 k2 : ↥W) (Z Y : List ↥W) (a : Ω) (n : ℤ), ρ ≠ 0 → σ ≠ 0 → ¬ (ρ ∣ σ ∧ σ ∣ ρ) → k1 ≠ 0 → k2 ≠ 0 → a ≠ 0 → (∀ z ∈ Z ++ Y, (ρ ∣ z - c ↔ σ ∣ z - c)) → W.valuation ((k1 * wcFrfP W c ρ Z : ↥W) : Ω) = W.valuation (((k2 * wcFrfP W c ρ Y : ↥W) : Ω) * a * (ρ : Ω) ^ n) → W.valuation ((k1 * wcFrfP W c σ Z : ↥W) : Ω) = W.valuation (((k2 * wcFrfP W c σ Y : ↥W) : Ω) * a * (σ : Ω) ^ n) → wcFrfM W c ρ Z Y = n :=
by
  intro Ω _ W c ρ σ k1 k2 Z Y a n hρ hσ hnassoc hk1 hk2 ha hside hEρ hEσ

  have hfilt : ∀ X : List ↥W, (∀ x ∈ X, (ρ ∣ x - c ↔ σ ∣ x - c)) →
      X.filter (fun x => @decide (σ ∣ x - c) (Classical.propDecidable _)) =
        X.filter (fun x => @decide (ρ ∣ x - c) (Classical.propDecidable _)) ∧
      X.filter (fun x => @decide (¬ σ ∣ x - c) (Classical.propDecidable _)) =
        X.filter (fun x => @decide (¬ ρ ∣ x - c) (Classical.propDecidable _)) := by
    intro X hX
    constructor
    · apply List.filter_congr
      intro x hx
      exact decide_eq_decide.mpr (hX x hx).symm
    · apply List.filter_congr
      intro x hx
      exact decide_eq_decide.mpr (not_congr (hX x hx).symm)
  obtain ⟨hZ1, hZ2⟩ := hfilt Z (fun x hx => hside x (List.mem_append.mpr (Or.inl hx)))
  obtain ⟨hY1, hY2⟩ := hfilt Y (fun x hx => hside x (List.mem_append.mpr (Or.inr hx)))

  have hF : ∀ X : List ↥W,
      ((X.filter (fun x => @decide (¬ ρ ∣ x - c) (Classical.propDecidable _))).map
        (fun x => x - c)).prod ≠ 0 := by
    intro X
    apply List.prod_ne_zero
    intro h0
    obtain ⟨x, hx, hx0⟩ := List.mem_map.mp h0
    have hx' := @of_decide_eq_true _ (Classical.propDecidable _) (List.mem_filter.mp hx).2
    exact hx' (by rw [hx0]; exact dvd_zero ρ)
  have hFZ := hF Z
  have hFY := hF Y
  unfold wcFrfP at hEρ hEσ
  rw [hZ1, hZ2, hY1, hY2] at hEσ
  unfold wcFrfM
  generalize ((Z.filter (fun x => @decide (¬ ρ ∣ x - c) (Classical.propDecidable _))).map
        (fun x => x - c)).prod = FZ at hEρ hEσ hFZ
  generalize ((Y.filter (fun x => @decide (¬ ρ ∣ x - c) (Classical.propDecidable _))).map
        (fun x => x - c)).prod = FY at hEρ hEσ hFY
  generalize (Z.filter (fun x => @decide (ρ ∣ x - c) (Classical.propDecidable _))).length = NZ
    at hEρ hEσ ⊢
  generalize (Y.filter (fun x => @decide (ρ ∣ x - c) (Classical.propDecidable _))).length = NY
    at hEρ hEσ ⊢
  set v := W.valuation with hv
  have hcoe : ∀ w : ↥W, w ≠ 0 → v (w : Ω) ≠ 0 := by
    intro w hw
    rw [Ne, Valuation.zero_iff]
    exact fun h => hw (by exact_mod_cast h)
  have hα : v (k1 : Ω) * v (FZ : Ω) ≠ 0 := mul_ne_zero (hcoe k1 hk1) (hcoe FZ hFZ)

  have key : ∀ s : ↥W, s ≠ 0 →
      v ((k1 * (FZ * s ^ NZ) : ↥W) : Ω) = v (((k2 * (FY * s ^ NY) : ↥W) : Ω) * a * (s : Ω) ^ n) →
      v (s : Ω) ^ ((NZ : ℤ) - NY - n) * (v (k1 : Ω) * v (FZ : Ω)) =
        v (k2 : Ω) * v (FY : Ω) * v a := by
    intro s hs h
    push_cast at h
    simp only [map_mul, map_pow, map_zpow₀] at h
    have hx := hcoe s hs
    generalize v (s : Ω) = x at h hx ⊢
    have hNZ : x ^ NZ = x ^ ((NZ : ℤ) - NY - n) * (x ^ NY * x ^ n) := by
      rw [← zpow_natCast, ← zpow_natCast x NY, ← zpow_add₀ hx, ← zpow_add₀ hx]
      congr 1
      ring
    have hne : x ^ NY * x ^ n ≠ 0 := mul_ne_zero (pow_ne_zero _ hx) (zpow_ne_zero _ hx)
    apply mul_right_cancel₀ hne
    calc x ^ ((NZ : ℤ) - NY - n) * (v (k1 : Ω) * v (FZ : Ω)) * (x ^ NY * x ^ n)
        = v (k1 : Ω) * (v (FZ : Ω) * (x ^ ((NZ : ℤ) - NY - n) * (x ^ NY * x ^ n))) := by
          simp only [mul_comm, mul_assoc, mul_left_comm]
      _ = v (k1 : Ω) * (v (FZ : Ω) * x ^ NZ) := by rw [← hNZ]
      _ = v (k2 : Ω) * (v (FY : Ω) * x ^ NY) * v a * x ^ n := h
      _ = v (k2 : Ω) * v (FY : Ω) * v a * (x ^ NY * x ^ n) := by
          simp only [mul_comm, mul_assoc, mul_left_comm]
  have e1 := key ρ hρ hEρ
  have e2 := key σ hσ hEσ

  have e3 : v (ρ : Ω) ^ ((NZ : ℤ) - NY - n) = v (σ : Ω) ^ ((NZ : ℤ) - NY - n) :=
    mul_right_cancel₀ hα (e1.trans e2.symm)

  have hne : v (ρ : Ω) ≠ v (σ : Ω) := by
    intro heq
    apply hnassoc
    constructor
    · obtain ⟨u, hu⟩ := (ValuationSubring.valuation_le_iff W (σ : Ω) (ρ : Ω)).mp heq.ge
      exact ⟨u, by apply Subtype.ext; push_cast; rw [← hu, mul_comm]⟩
    · obtain ⟨u, hu⟩ := (ValuationSubring.valuation_le_iff W (ρ : Ω) (σ : Ω)).mp heq.le
      exact ⟨u, by apply Subtype.ext; push_cast; rw [← hu, mul_comm]⟩

  have hm : (NZ : ℤ) - NY - n = 0 := by
    by_contra hm
    exact hne ((zpow_left_inj₀ zero_le zero_le hm).mp e3)
  omega

theorem wcFrfCp_gauss : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A) (c : ↥W) (O : ↥W → ValuationSubring K), wcFrfVAL W A K 𝔭 t c O → ∀ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 → ∀ (F : K) (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A), F ≠ 0 → wcFrfREP W A K 𝔭 t F k1 k2 Z Y d e → (O ρ).valuation F * (O ρ).valuation (algebraMap A K (algebraMap ↥W A (k2 * wcFrfP W c ρ Y))) = (O ρ).valuation (algebraMap A K (algebraMap ↥W A (k1 * wcFrfP W c ρ Z))) ∧ (F ∈ O ρ → k2 * wcFrfP W c ρ Y ∣ k1 * wcFrfP W c ρ Z) :=
by
  intro Ω _ W A _ _ _ K _ _ _ 𝔭 t c O hVAL ρ hρm hρ0 F k1 k2 Z Y d e hF hREP
  obtain ⟨hI, hII, -⟩ := hVAL ρ hρm hρ0
  have hk1 : k1 ≠ 0 := hREP.1
  have hk2 : k2 ≠ 0 := hREP.2.1

  have hP : ∀ X : List ↥W, wcFrfP W c ρ X ≠ 0 := by
    intro X
    unfold wcFrfP
    refine mul_ne_zero ?_ (pow_ne_zero _ hρ0)
    refine List.prod_ne_zero ?_
    intro h0
    classical
    rw [List.mem_map] at h0
    obtain ⟨x, hx, hx0⟩ := h0
    simp only [List.mem_filter, decide_eq_true_eq] at hx
    exact hx.2 (by rw [hx0]; exact dvd_zero ρ)

  have hinj : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
    intro x hx h0
    have h1 : algebraMap A K (algebraMap ↥W A 1) / algebraMap A K (algebraMap ↥W A x) ∈ O ρ := by
      rw [h0, div_zero]; exact (O ρ).zero_mem
    have hdvd : x ∣ 1 := hII 1 x one_ne_zero hx h1
    have hu : IsUnit (algebraMap A K (algebraMap ↥W A x)) :=
      ((isUnit_of_dvd_one hdvd).map (algebraMap ↥W A)).map (algebraMap A K)
    exact hu.ne_zero h0
  set w₁ : ↥W := k1 * wcFrfP W c ρ Z with hw₁
  set w₂ : ↥W := k2 * wcFrfP W c ρ Y with hw₂
  have hw1 : w₁ ≠ 0 := mul_ne_zero hk1 (hP Z)
  have hw2 : w₂ ≠ 0 := mul_ne_zero hk2 (hP Y)
  have hW1 := hinj w₁ hw1
  have hW2 := hinj w₂ hw2
  obtain ⟨ha, ha'⟩ := hI F k1 k2 Z Y d e hF hREP
  set x1 := algebraMap A K (algebraMap ↥W A w₁) with hx1
  set x2 := algebraMap A K (algebraMap ↥W A w₂) with hx2
  set a : K := x2 * F / x1 with ha_def
  have hainv : x1 / (x2 * F) = a⁻¹ := by rw [ha_def, inv_div]
  rw [hainv] at ha'
  have ha0 : a ≠ 0 := div_ne_zero (mul_ne_zero hW2 hF) hW1
  have hpos : 0 < (O ρ).valuation a := (Valuation.pos_iff _).mpr ha0
  have hle : (O ρ).valuation a ≤ 1 := (ValuationSubring.valuation_le_one_iff _ _).mpr ha
  have hle' : (O ρ).valuation a⁻¹ ≤ 1 := (ValuationSubring.valuation_le_one_iff _ _).mpr ha'
  rw [map_inv₀, inv_le_one₀ hpos] at hle'
  have hν : (O ρ).valuation a = 1 := le_antisymm hle hle'
  have hmul : x2 * F = a * x1 := by rw [ha_def, div_mul_cancel₀ _ hW1]
  refine ⟨?_, ?_⟩
  · have := congrArg (O ρ).valuation hmul
    rw [map_mul, map_mul, hν, one_mul] at this
    rw [mul_comm]; exact this
  · intro hFO
    have hid : x1 / x2 = F * a⁻¹ := by
      rw [← hainv]; field_simp
    have hmem : x1 / x2 ∈ O ρ := by rw [hid]; exact mul_mem hFO ha'
    exact hII w₁ w₂ hw1 hw2 hmem

theorem wcFrfCp_pad : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (𝔭 : Ideal A) (t : A) (F : K) (k1 k2 : ↥W) (Z Y E : List ↥W) (d e : A), wcFrfREP W A K 𝔭 t F k1 k2 Z Y d e → (∀ x ∈ E, x ∈ IsLocalRing.maximalIdeal ↥W) → wcFrfREP W A K 𝔭 t F k1 k2 (Z ++ E) (Y ++ E) d e :=
by
  intro Ω _ W A _ _ K _ _ 𝔭 t F k1 k2 Z Y E d e hR hE
  unfold wcFrfREP at hR ⊢
  obtain ⟨hk1, hk2, hd, he, hmem, heq⟩ := hR
  refine ⟨hk1, hk2, hd, he, ?_, ?_⟩
  · intro z hz
    simp only [List.mem_append] at hz
    rcases hz with (h | h) | (h | h)
    · exact hmem z (List.mem_append.mpr (Or.inl h))
    · exact hE z h
    · exact hmem z (List.mem_append.mpr (Or.inr h))
    · exact hE z h
  · simp only [List.map_append, List.prod_append]
    linear_combination
      (List.map (fun x => algebraMap A K (t - algebraMap (↥W) A x)) E).prod * heq

theorem wcFrf_compact_piece : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ (α : L) (f₀ : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α →
    ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ O : ↥W → ValuationSubring K, wcFrfVAL W A K 𝔭 t c O →
    ∀ (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A), wcFrfREP W A K 𝔭 t f₀ k1 k2 Z Y d e →
    ∀ ρ₁ ρ₂ : ↥W, ρ₁ ∈ IsLocalRing.maximalIdeal ↥W → ρ₁ ≠ 0 → ρ₁ ∣ ρ₂ →
    (∀ z ∈ Z ++ Y, z ≠ c → ¬ (ρ₁ ∣ z - c ∧ z - c ∣ ρ₂)) →
    wcFrfMem W A K 𝔭 t ℓ f₀ c (fun ρ => ρ₁ ∣ ρ ∧ ρ ∣ ρ₂) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD hdeg α f₀ hα1 hf₀ c hc
    O hO k1 k2 Z Y d e hR ρ₁ ρ₂ hρ₁m hρ₁0 h12 hno
  classical

  have hΩ : ((ℓ : ℕ) : Ω) = 0 := by
    rw [← hchar]
    exact ringChar.Nat.cast_ringChar
  have hWl : ((ℓ : ℕ) : ↥W) = 0 := by
    apply Subtype.ext
    simpa using hΩ
  have hK : ((ℓ : ℕ) : K) = 0 := by
    have e' : ((ℓ : ℕ) : K) = algebraMap A K (algebraMap ↥W A ((ℓ : ℕ) : ↥W)) := by
      rw [map_natCast, map_natCast]
    rw [e', hWl, map_zero, map_zero]
  have hL : ((ℓ : ℕ) : L) = 0 := by
    rw [← map_natCast (algebraMap K L), hK, map_zero]
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : CharP L ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hL

  obtain ⟨ι, hι1, hι2, hι4⟩ := wcFrfCp_iota Ω W hWt A K 𝔭 t c O hPD hc hO
  have hU0 : algebraMap A K (t - algebraMap ↥W A c) ≠ 0 := by
    have h0 := hι4 0 (Ideal.zero_mem _)
    simpa using h0
  have hle1 : ∀ s : ↥W, s ∈ IsLocalRing.maximalIdeal ↥W → s ≠ 0 → ∀ x : Ω,
      ((O s).valuation (ι x) ≤ 1 ↔ W.valuation x ≤ 1) := by
    intro s hs hs0 x
    have h0 := (hι2 s hs hs0).1 x 1
    simp only [map_one] at h0
    exact h0
  have hlt1 : ∀ s : ↥W, s ∈ IsLocalRing.maximalIdeal ↥W → s ≠ 0 → ∀ x : Ω,
      (1 < (O s).valuation (ι x) ↔ 1 < W.valuation x) := by
    intro s hs hs0 x
    rw [← not_le, ← not_le, hle1 s hs hs0 x]
  have hlt : ∀ s : ↥W, s ∈ IsLocalRing.maximalIdeal ↥W → s ≠ 0 → ∀ x y : Ω,
      ((O s).valuation (ι x) < (O s).valuation (ι y) ↔ W.valuation x < W.valuation y) := by
    intro s hs hs0 x y
    rw [← not_le, ← not_le, (hι2 s hs hs0).1 y x]
  have heqv : ∀ s : ↥W, s ∈ IsLocalRing.maximalIdeal ↥W → s ≠ 0 → ∀ x y : Ω,
      (O s).valuation (ι x) = (O s).valuation (ι y) → W.valuation x = W.valuation y := by
    intro s hs hs0 x y hxy
    exact le_antisymm (((hι2 s hs hs0).1 x y).mp hxy.le) (((hι2 s hs hs0).1 y x).mp hxy.ge)
  have hgv : ∀ s : ↥W, s ∈ IsLocalRing.maximalIdeal ↥W → s ≠ 0 → ∀ p : Ω × ℤ,
      (O s).valuation (ι p.1 * algebraMap A K (t - algebraMap ↥W A c) ^ p.2) =
        (O s).valuation (ι (p.1 * (s : Ω) ^ p.2)) := by
    intro s hs hs0 p
    simp only [map_mul, map_zpow₀]
    rw [(hι2 s hs hs0).2]

  have hnaR1 : ∀ b ∈ (Z ++ Y).map (fun z => z - c), ¬ (ρ₁ ∣ b ∧ b ∣ ρ₁) := by
    intro b hb hb2
    obtain ⟨z, hz, rfl⟩ := List.mem_map.mp hb
    by_cases hzc : z = c
    · have h2 := hb2.2
      rw [hzc, sub_self] at h2
      exact hρ₁0 (zero_dvd_iff.mp h2)
    · exact hno z hz hzc ⟨hb2.1, dvd_trans hb2.2 h12⟩
  obtain ⟨ρ₁', _, hρ₁'m, hρ₁'0, hρ₁'1, hn1ρ₁', _, _, _, _, hside1⟩ :=
    wcFrfCp_cell Ω W ((Z ++ Y).map (fun z => z - c)) ρ₁ hρ₁m hρ₁0 hnaR1
  have hρ₂' : ∃ ρ₂' : ↥W, ρ₁ ∣ ρ₂' ∧ (∀ z ∈ Z ++ Y, z ≠ c → (z - c) ∣ ρ₂' → (z - c) ∣ ρ₂) ∧
      ∀ ρ : ↥W, ρ ≠ 0 → ρ ∣ ρ₂ → ρ ∣ ρ₂' ∧ ¬ ρ₂' ∣ ρ := by
    by_cases h20 : ρ₂ = 0
    · refine ⟨0, dvd_zero _, ?_, ?_⟩
      · intro z _ _ _
        rw [h20]
        exact dvd_zero _
      · intro ρ hρ0 _
        exact ⟨dvd_zero _, fun h => hρ0 (zero_dvd_iff.mp h)⟩
    · have hρ₂m : ρ₂ ∈ IsLocalRing.maximalIdeal ↥W := by
        obtain ⟨k, hk⟩ := h12
        rw [hk]
        exact Ideal.mul_mem_right k _ hρ₁m
      have hnaR2 : ∀ b ∈ (Z ++ Y).map (fun z => z - c), ¬ (ρ₂ ∣ b ∧ b ∣ ρ₂) := by
        intro b hb hb2
        obtain ⟨z, hz, rfl⟩ := List.mem_map.mp hb
        by_cases hzc : z = c
        · have h2 := hb2.2
          rw [hzc, sub_self] at h2
          exact h20 (zero_dvd_iff.mp h2)
        · exact hno z hz hzc ⟨dvd_trans h12 hb2.1, hb2.2⟩
      obtain ⟨_, σi, _, _, _, _, _, _, hρ₂σi, hnσiρ₂, hside2⟩ :=
        wcFrfCp_cell Ω W ((Z ++ Y).map (fun z => z - c)) ρ₂ hρ₂m h20 hnaR2
      refine ⟨σi, dvd_trans h12 hρ₂σi, ?_, ?_⟩
      · intro z hz _ hdz
        exact ((hside2 (z - c) (List.mem_map.mpr ⟨z, hz, rfl⟩)).2.1).mpr hdz
      · intro ρ _ hρρ₂
        exact ⟨dvd_trans hρρ₂ hρ₂σi, fun h => hnσiρ₂ (dvd_trans h hρρ₂)⟩
  obtain ⟨ρ₂', h1ρ₂', hzρ₂', hρρ₂'⟩ := hρ₂'
  have hW2 : ∀ z ∈ Z ++ Y, z ≠ c → ¬ (ρ₁' ∣ z - c ∧ z - c ∣ ρ₂') := by
    intro z hz hzc hh
    have hs := (hside1 (z - c) (List.mem_map.mpr ⟨z, hz, rfl⟩)).1.2
    exact hno z hz hzc ⟨hs.mpr hh.1, hzρ₂' z hz hzc hh.2⟩

  have hd𝔭 : d ∉ 𝔭 := hR.2.2.1
  have hTay := wcFrfCp_taylor Ω W hW hWt A K 𝔭 t c hPD hc e d hd𝔭
  obtain ⟨Λ, hΛ⟩ := wcFrfCp_expansion Ω W hW hWt A K 𝔭 t c O ι hPD hc hO hι1 hι2 hι4 f₀ k1 k2 Z Y
    d e hR hTay ρ₁' ρ₂' hρ₁'m hρ₁'0 (dvd_trans hρ₁'1 h1ρ₂') hW2

  obtain ⟨Hl, D, hDprop, hDnd, hred⟩ :=
    wcFrfCp_laurent_reduce Ω K ι ℓ hℓ hK (algebraMap A K (t - algebraMap ↥W A c)) hU0 Λ
  obtain ⟨h, hh⟩ : ∃ h : K,
      h = (Hl.map (fun p => ι p.1 * algebraMap A K (t - algebraMap ↥W A c) ^ p.2)).sum :=
    ⟨_, rfl⟩
  have hFeq : f₀ - (h ^ ℓ - h) =
      (D.map (fun p => ι p.1 * algebraMap A K (t - algebraMap ↥W A c) ^ p.2)).sum +
        (f₀ - (Λ.map (fun p => ι p.1 * algebraMap A K (t - algebraMap ↥W A c) ^ p.2)).sum) := by
    rw [hh]
    linear_combination hred
  have hF0 : f₀ - (h ^ ℓ - h) ≠ 0 := by
    intro h0
    have h1 : algebraMap K L f₀ = algebraMap K L (h ^ ℓ - h) := by rw [sub_eq_zero.mp h0]
    rw [hf₀, map_sub, map_pow] at h1
    have hαα : (α - algebraMap K L h) ^ ℓ = α - algebraMap K L h := by
      rw [sub_pow_char]
      linear_combination h1
    have hbot := (Subfield.mem_bot_iff_pow_eq_self L ℓ).mpr hαα
    have hr : α - algebraMap K L h ∈ (algebraMap K L).fieldRange :=
      (bot_le : (⊥ : Subfield L) ≤ (algebraMap K L).fieldRange) hbot
    obtain ⟨x, hx⟩ := RingHom.mem_fieldRange.mp hr
    exact hα1 ⟨x + h, by rw [map_add, hx]; ring⟩

  have hLne : ∀ p ∈ ((1 : Ω), (0 : ℤ)) :: D, p.1 ≠ 0 := by
    intro p hp
    rcases List.mem_cons.mp hp with hp' | hp'
    · rw [hp']
      exact one_ne_zero
    · exact (hDprop p hp').1
  obtain ⟨Ex, hExm, hExa, hExb⟩ := wcFrfCp_ties Ω W (((1 : Ω), (0 : ℤ)) :: D) hLne
  have hone : ∀ s : ↥W, W.valuation (((1 : Ω), (0 : ℤ)).1 * (s : Ω) ^ ((1 : Ω), (0 : ℤ)).2) = 1 := by
    intro s
    show W.valuation ((1 : Ω) * (s : Ω) ^ (0 : ℤ)) = 1
    rw [zpow_zero, one_mul, map_one]

  obtain ⟨k1', k2', Z₀, Y₀, d', e', hR'⟩ := wcFrf_rep_exists Ω W hW hWt A K 𝔭 t hPD _ hF0
  set Pd : List ↥W := Ex.map (fun x => c + x) with hPd
  have hPdm : ∀ x ∈ Pd, x ∈ IsLocalRing.maximalIdeal ↥W := by
    intro x hx
    obtain ⟨y, hy, rfl⟩ := List.mem_map.mp hx
    exact Ideal.add_mem _ hc (hExm y hy)
  have hR'' := wcFrfCp_pad W A K 𝔭 t _ k1' k2' Z₀ Y₀ Pd d' e' hR' hPdm
  have hk1' : k1' ≠ 0 := hR''.1
  have hk2' : k2' ≠ 0 := hR''.2.1
  have hDnd' : D.Nodup := List.Nodup.of_map Prod.snd hDnd
  refine ⟨h, k1', k2', Z₀ ++ Pd, Y₀ ++ Pd, d', e', hR'', ?_⟩
  intro ρ hρm hρ0 hρI hgen
  obtain ⟨h1ρ, hρ2⟩ := hρI
  unfold wcFrfGen at hgen
  unfold wcFrfGood
  have hρ₁'ρ : ρ₁' ∣ ρ := dvd_trans hρ₁'1 h1ρ
  have hρρ₂'' := hρρ₂' ρ hρ0 hρ2
  have hE'ρ := hΛ ρ hρm hρ0 hρ₁'ρ hρρ₂''.1
  have hgenEx : ∀ x ∈ Ex, ¬ (ρ ∣ x ∧ x ∣ ρ) := by
    intro x hx
    have h0 := hgen (c + x) (List.mem_append.mpr (Or.inl (List.mem_append.mpr
      (Or.inr (List.mem_map.mpr ⟨x, hx, rfl⟩)))))
    rwa [add_sub_cancel_left] at h0

  have hslope_hyp : ∀ s : ↥W, s ∈ IsLocalRing.maximalIdeal ↥W → s ≠ 0 → ∀ p : Ω × ℤ,
      (O s).valuation (f₀ - (h ^ ℓ - h)) =
        (O s).valuation (ι p.1 * algebraMap A K (t - algebraMap ↥W A c) ^ p.2) →
      W.valuation ((k1' * wcFrfP W c s (Z₀ ++ Pd) : ↥W) : Ω) =
        W.valuation (((k2' * wcFrfP W c s (Y₀ ++ Pd) : ↥W) : Ω) * p.1 * (s : Ω) ^ p.2) := by
    intro s hs hs0 p hνs
    have hg := (wcFrfCp_gauss W A K 𝔭 t c O hO s hs hs0 _ k1' k2' _ _ d' e' hF0 hR'').1
    rw [hνs, hgv s hs hs0 p, ← hι1, ← hι1, ← map_mul (O s).valuation, ← map_mul ι] at hg
    apply heqv s hs hs0
    rw [← hg]
    congr 2
    ring
  by_cases hA : ∀ q ∈ D, W.valuation (q.1 * (ρ : Ω) ^ q.2) ≤ 1
  ·
    have hle : ∀ q ∈ D,
        (O ρ).valuation (ι q.1 * algebraMap A K (t - algebraMap ↥W A c) ^ q.2) ≤ 1 := by
      intro q hq
      rw [hgv ρ hρm hρ0 q]
      exact (hle1 ρ hρm hρ0 _).mpr (hA q hq)
    have hFin : f₀ - (h ^ ℓ - h) ∈ O ρ := by
      rw [hFeq]
      exact (wcFrfCp_dominant (O ρ) D
        (fun p => ι p.1 * algebraMap A K (t - algebraMap ↥W A c) ^ p.2) _ hE'ρ).1 hle
    exact Or.inl ((wcFrfCp_gauss W A K 𝔭 t c O hO ρ hρm hρ0 _ k1' k2' _ _ d' e' hF0 hR'').2 hFin)
  ·
    push_neg at hA
    obtain ⟨q₀, hq₀D, hq₀⟩ := hA
    obtain ⟨p, hpD', hpmax⟩ := Finset.exists_max_image D.toFinset
      (fun q : Ω × ℤ => W.valuation (q.1 * (ρ : Ω) ^ q.2)) ⟨q₀, List.mem_toFinset.mpr hq₀D⟩
    have hpD : p ∈ D := List.mem_toFinset.mp hpD'
    have hp1 : 1 < W.valuation (p.1 * (ρ : Ω) ^ p.2) :=
      lt_of_lt_of_le hq₀ (hpmax q₀ (List.mem_toFinset.mpr hq₀D))
    have hstrict : ∀ q ∈ D, q ≠ p →
        W.valuation (q.1 * (ρ : Ω) ^ q.2) < W.valuation (p.1 * (ρ : Ω) ^ p.2) := by
      intro q hq hqp
      have h2 : q.2 ≠ p.2 := fun h2 => hqp (List.inj_on_of_nodup_map hDnd hq hpD h2)
      have hne := hExa ρ hρm hρ0 hgenEx q (List.mem_cons_of_mem _ hq) p
        (List.mem_cons_of_mem _ hpD) h2
      exact lt_of_le_of_ne (hpmax q (List.mem_toFinset.mpr hq)) hne

    have hνgen : ∀ s : ↥W, s ∈ IsLocalRing.maximalIdeal ↥W → s ≠ 0 →
        f₀ - (Λ.map (fun p => ι p.1 * algebraMap A K (t - algebraMap ↥W A c) ^ p.2)).sum ∈ O s →
        1 < W.valuation (p.1 * (s : Ω) ^ p.2) →
        (∀ q ∈ D, q ≠ p → W.valuation (q.1 * (s : Ω) ^ q.2) < W.valuation (p.1 * (s : Ω) ^ p.2)) →
        (O s).valuation (f₀ - (h ^ ℓ - h)) =
          (O s).valuation (ι p.1 * algebraMap A K (t - algebraMap ↥W A c) ^ p.2) := by
      intro s hs hs0 hEs hps hqs
      rw [hFeq]
      refine (wcFrfCp_dominant (O s) D
        (fun p => ι p.1 * algebraMap A K (t - algebraMap ↥W A c) ^ p.2) _ hEs).2 hDnd' p hpD ?_ ?_
      · beta_reduce
        rw [hgv s hs hs0 p]
        exact (hlt1 s hs hs0 _).mpr hps
      · intro q hq hqp
        beta_reduce
        rw [hgv s hs hs0 p, hgv s hs hs0 q]
        exact (hlt s hs hs0 _ _).mpr (hqs q hq hqp)
    have hνρ := hνgen ρ hρm hρ0 hE'ρ hp1 hstrict

    have hnaB : ∀ b ∈ Ex ++ (((Z₀ ++ Pd) ++ (Y₀ ++ Pd)).map (fun z => z - c) ++ [ρ₁', ρ₂']),
        ¬ (ρ ∣ b ∧ b ∣ ρ) := by
      intro b hb
      rcases List.mem_append.mp hb with hb | hb
      · exact hgenEx b hb
      rcases List.mem_append.mp hb with hb | hb
      · obtain ⟨z, hz, rfl⟩ := List.mem_map.mp hb
        exact hgen z hz
      rcases List.mem_cons.mp hb with hb | hb
      · rw [hb]
        intro hh'
        exact hn1ρ₁' (dvd_trans h1ρ hh'.1)
      · rw [List.mem_singleton.mp hb]
        intro hh'
        exact hρρ₂''.2 hh'.2
    obtain ⟨σ, _, hσm, hσ0, _, hnρσ, _, _, _, _, hsideσ⟩ :=
      wcFrfCp_cell Ω W _ ρ hρm hρ0 hnaB
    have hσ1 : ρ₁' ∣ σ := ((hsideσ ρ₁' (List.mem_append.mpr (Or.inr (List.mem_append.mpr
      (Or.inr List.mem_cons_self))))).1.1).mp hρ₁'ρ
    have hσ2 : σ ∣ ρ₂' := ((hsideσ ρ₂' (List.mem_append.mpr (Or.inr (List.mem_append.mpr
      (Or.inr (List.mem_cons_of_mem _ List.mem_cons_self)))))).1.2).mp hρρ₂''.1
    have hE'σ := hΛ σ hσm hσ0 hσ1 hσ2
    have hExsame : ∀ x ∈ Ex, (x ∣ ρ ↔ x ∣ σ) ∧ (ρ ∣ x ↔ σ ∣ x) := fun x hx =>
      (hsideσ x (List.mem_append.mpr (Or.inl hx))).1
    have hzside : ∀ z ∈ (Z₀ ++ Pd) ++ (Y₀ ++ Pd), (ρ ∣ z - c ↔ σ ∣ z - c) := fun z hz =>
      (hsideσ (z - c) (List.mem_append.mpr (Or.inr (List.mem_append.mpr
        (Or.inl (List.mem_map.mpr ⟨z, hz, rfl⟩)))))).1.2
    have hp1σ : 1 < W.valuation (p.1 * (σ : Ω) ^ p.2) := by
      have h10 := (hExb ρ σ hρm hρ0 hσm hσ0 hgenEx hExsame ((1 : Ω), (0 : ℤ)) List.mem_cons_self
        p (List.mem_cons_of_mem _ hpD)).mp (by rw [hone]; exact hp1)
      rw [hone] at h10
      exact h10
    have hstrictσ : ∀ q ∈ D, q ≠ p →
        W.valuation (q.1 * (σ : Ω) ^ q.2) < W.valuation (p.1 * (σ : Ω) ^ p.2) := by
      intro q hq hqp
      exact (hExb ρ σ hρm hρ0 hσm hσ0 hgenEx hExsame q (List.mem_cons_of_mem _ hq) p
        (List.mem_cons_of_mem _ hpD)).mp (hstrict q hq hqp)
    have hνσ := hνgen σ hσm hσ0 hE'σ hp1σ hstrictσ
    have hM := wcFrfCp_slope W c ρ σ k1' k2' (Z₀ ++ Pd) (Y₀ ++ Pd) p.1 p.2 hρ0 hσ0
      (fun hh' => hnρσ hh'.1) hk1' hk2' (hDprop p hpD).1 hzside
      (hslope_hyp ρ hρm hρ0 p hνρ) (hslope_hyp σ hσm hσ0 p hνσ)
    right
    rw [hM]
    exact (hDprop p hpD).2

theorem wcFrf_cover : ∀ {Ω : Type u} [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ {D : Type u} (gen good : D → ↥W → Prop) (Cr : List ↥W),
    (∀ a ∈ Cr, a ∈ IsLocalRing.maximalIdeal ↥W) →
    (∃ ρ₀ : ↥W, ρ₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ ρ₀ ≠ 0 ∧ ∃ x : D, ∀ ρ : ↥W,
      ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 → (ρ ∣ ρ₀ ∧ ¬ ρ₀ ∣ ρ) → gen x ρ → good x ρ) →
    (∀ a ∈ Cr, a ≠ 0 → ∃ ρ' : ↥W, ρ' ∈ IsLocalRing.maximalIdeal ↥W ∧ ρ' ≠ 0 ∧ ∃ x : D,
      ∀ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 →
