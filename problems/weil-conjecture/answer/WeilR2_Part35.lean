theorem wcLlsVd_gi_split_decomp : ∀ (R : Type u) [CommRing R] (K : Type u) [Field K] [Algebra R K] (L : Type u) [Field L] [Algebra K L] [Algebra R L] [IsScalarTower R K L] [FiniteDimensional K L] [IsGalois K L] (ℓ : ℕ), ℓ.Prime → Module.finrank K L = ℓ → ∀ (𝔓 : Ideal R) (𝔔 : Ideal ↥(integralClosure R L)), 𝔔.IsPrime → 𝔔.comap (algebraMap R ↥(integralClosure R L)) = 𝔓 → ¬ wcLlsUniq R L 𝔓 𝔔 → (∀ k : K, IsIntegral R k → ∃ u a : R, u ∉ 𝔓 ∧ algebraMap R K a = algebraMap R K u * k) → ∀ σ : L ≃ₐ[K] L, σ ≠ 1 → ∃ y : ↥(integralClosure R L), y ∉ 𝔔 ∧ ∃ q ∈ 𝔔, (q : L) = σ y :=
