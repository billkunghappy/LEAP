            algebraMap A K (v ^ k * ε + u * r + algebraMap ↥W A w' * h) := by
    intro w' L'
    induction L' with
    | nil => intro _ _; exact ⟨0, 1, 0, 0, h1, by simp⟩
    | cons t L' ih =>
      intro hd hct
      rw [List.forall_mem_cons] at hd hct
      obtain ⟨k, ε, r, h, hε, hq⟩ := ih hd.2 hct.2
      obtain ⟨d'', hd''⟩ := hd.1
      have hcd' : algebraMap ↥W A t.1 * algebraMap ↥W A t.2.1 = u * v := by
        rw [huv, ← map_mul, hct.1]
      rw [hd'', map_mul] at hcd'
