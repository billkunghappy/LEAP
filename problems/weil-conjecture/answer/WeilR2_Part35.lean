        mul_inv_cancel₀ (pow_ne_zero _ huK)
      refine (wcpa_dj_llsm_kpwulb_nf_bound Ω W hW hWt A K 𝔭 u v g hPD (algebraMap A K z) z 1
        h1 hF α w w' M k (ε * a) σ (r * a) 0 (h * a) 0
        ⟨hα0, hw0, hw'm, hmul _ _ hε ha, hσ, ?_⟩).1
      rw [show u ^ k * (ε * a) + v * (r * a) + algebraMap ↥W A w' * (h * a)
          = (u ^ k * ε + v * r + algebraMap ↥W A w' * h) * a by ring,
        show u ^ M * σ + v * 0 + algebraMap ↥W A w' * 0 = u ^ M * σ by ring]
      simp only [map_mul, map_pow]
