      rw [ha, Algebra.smul_def]
    · exact ⟨0, fun h => absurd h hi⟩
  choose a ha using hex
  refine ⟨(b : A), a, nonZeroDivisors.ne_zero b.2, ?_⟩
  rw [hxsum, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun i hi => ?_)
  rw [IsScalarTower.algebraMap_apply A K L (a i), ha i hi, map_mul,
    ← IsScalarTower.algebraMap_apply A K L, mul_assoc]

theorem wcpa_dj_llsm_kpwic_node_cap : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
