      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [Ideal.mem_comap, Ideal.mem_comap, RingHom.comp_apply]
        apply hN
        exact Ideal.mem_sup_right
          (Ideal.mem_map_of_mem ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) hw)
    have hJeq := hmax.eq_of_le (Ideal.comap_ne_top _ hmax'.ne_top) hJ
    intro a ha hmem
    apply ha
    rw [hJeq, Ideal.mem_comap, RingHom.comp_apply]
    exact hmem

  have hq' : ιR q ∉ 𝔭' := by
    obtain ⟨a₁, ha₁, hq1⟩ := hq
    intro hmem
    apply hA𝔭 a₁ ha₁
    have h1 := hN _ hq1
    rw [map_sub] at h1
    have h2 := Ideal.sub_mem _ hmem h1
    rwa [sub_sub_cancel] at h2
  have hp' : ιR p ∉ 𝔭' := by
    obtain ⟨a₀, ha₀, hp1⟩ := hp
    intro hmem
    apply hA𝔭 a₀ ha₀
    have h1 := hN _ hp1
    rw [map_sub] at h1
    have h2 := Ideal.sub_mem _ hmem h1
    rwa [sub_sub_cancel] at h2

  rcases lt_trichotomy m 0 with hm | rfl | hm
  ·
    obtain ⟨n, rfl⟩ : ∃ n : ℕ, m = -(n : ℤ) := ⟨(-m).toNat, by omega⟩
    have hn : 0 < n := by omega
    have hℓn : ¬ ℓ ∣ n := fun hd => hI ((dvd_neg).mpr (Int.natCast_dvd_natCast.mpr hd))
    rw [zpow_neg, zpow_natCast] at hEQ
    have hUinv := mul_inv_cancel₀ (pow_ne_zero n hu)
    have hAnn := wcLlsASi_ann_pole_sep Ω W hdim hWtop ℓ hℓ A' K L 𝔭' u' v' b hPD' hK hfin α f hα hf
      h μ n (ιR q) (ιR p) hμ0 hn hℓn hq' hp' (by
        rw [hu', hW' μ, hιR, hιR]
        linear_combination (algebraMap A K (t - algebraMap ↥W A c)) ^ n * hEQ + (p : K) * hUinv)
    exact (hiff b hb hb0 dvd_rfl).mpr hAnn
  · exact absurd (dvd_zero _) hI
  ·
    obtain ⟨n, rfl⟩ : ∃ n : ℕ, m = (n : ℤ) := ⟨m.toNat, by omega⟩
    have hn : 0 < n := by omega
    have hℓn : ¬ ℓ ∣ n := fun hd => hI (Int.natCast_dvd_natCast.mpr hd)
    rw [zpow_natCast] at hEQ
    obtain ⟨κ, hκ⟩ := hdom (by omega)
    rw [Int.toNat_natCast] at hκ
    obtain ⟨κ₁, hκ₁⟩ := rootW ℓ hℓ.pos κ
    have hκ₁0 : κ₁ ≠ 0 := by
      rintro rfl
      apply hμ0
      have h0 : μ ^ ℓ = 0 := by rw [hκ, ← hκ₁, zero_pow hℓ.ne_zero, mul_zero]
      exact (pow_eq_zero_iff hℓ.ne_zero).mp h0
    have hM : algebraMap A K (algebraMap ↥W A μ) ^ ℓ =
        (algebraMap A K (t - algebraMap ↥W A c) * s) ^ n *
          algebraMap A K (algebraMap ↥W A κ₁) ^ ℓ := by
      have h1 := congrArg (fun w => algebraMap A K (algebraMap ↥W A w)) hκ
      simp only [map_mul, map_pow] at h1
      rw [h1, ← hUs, ← hκ₁, map_pow, map_pow]

    have hIJ : Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b} =
        Ideal.map ((MvPolynomial.renameEquiv ↥W (Equiv.swap (0 : Fin 2) 1)) :
            MvPolynomial (Fin 2) ↥W →+* MvPolynomial (Fin 2) ↥W)
          (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b}) := by
      rw [Ideal.map_span, Set.image_singleton]
      congr 1
      rw [Set.singleton_eq_singleton_iff]
      show _ = (MvPolynomial.renameEquiv ↥W (Equiv.swap (0 : Fin 2) 1)) _
      rw [MvPolynomial.renameEquiv_apply]
      simp only [map_sub, map_mul, MvPolynomial.rename_X, MvPolynomial.rename_C,
        Equiv.swap_apply_left, Equiv.swap_apply_right]
