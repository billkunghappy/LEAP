      rw [hgj, map_mul, map_mul, map_pow, map_pow]
    have hwK : algebraMap A K (algebraMap ↥W A w) =
        algebraMap A K (algebraMap ↥W A b₀) ^ j * algebraMap A K (algebraMap ↥W A wj) := by
      rw [hwj, map_mul, map_mul, map_pow, map_pow]
    rw [Subalgebra.coe_add, Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_mul,
      Subalgebra.coe_mul, Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_pow,
      hιW, hιW, hιA, hιA, hιA, hsK, map_add, map_add, map_mul, map_mul, map_mul, map_pow,
