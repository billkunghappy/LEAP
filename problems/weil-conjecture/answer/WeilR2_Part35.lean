    intro h
    rw [hZdef] at h
    obtain ⟨σ, hσ, hσ𝔔⟩ := (Ideal.IsPrime.prod_mem_iff).mp h
    exact hyf σ (Finset.mem_erase.mp hσ).1 hσ𝔔
  have hZτ : ∀ τ : L ≃ₐ[K] L, τ ≠ 1 → act τ Z ∈ 𝔔 := by
    intro τ hτ
    have hτE : τ ∈ Finset.univ.erase (1 : L ≃ₐ[K] L) :=
      Finset.mem_erase.mpr ⟨hτ, Finset.mem_univ τ⟩
    have heq : act τ Z = qf τ * ∏ σ ∈ (Finset.univ.erase (1 : L ≃ₐ[K] L)).erase τ,
        act τ (yf σ) := by
      apply Subtype.ext
      rw [hact, Subalgebra.coe_mul, SubmonoidClass.coe_finsetProd, hZdef,
        SubmonoidClass.coe_finsetProd, map_prod, hqv τ hτ,
        ← Finset.mul_prod_erase _ (fun σ => τ ((yf σ : L))) hτE]
    rw [heq]
    exact Ideal.mul_mem_right _ 𝔔 (hqf τ hτ)
  refine ⟨∑ τ, act τ Z * act τ x, ∑ τ, act τ Z, ?_, ?_, ?_, ?_⟩
  · refine ⟨Algebra.trace K L ((Z : L) * (x : L)), ?_⟩
    rw [trace_eq_sum_automorphisms, AddSubmonoidClass.coe_finsetSum]
    refine Finset.sum_congr rfl fun τ _ => ?_
    rw [Subalgebra.coe_mul, hact, hact, map_mul]
  · refine ⟨Algebra.trace K L (Z : L), ?_⟩
    rw [trace_eq_sum_automorphisms, AddSubmonoidClass.coe_finsetSum]
  · intro hs
    rw [← Finset.add_sum_erase _ _ (Finset.mem_univ (1 : L ≃ₐ[K] L)), hact1] at hs
    have hT : ∑ τ ∈ Finset.univ.erase (1 : L ≃ₐ[K] L), act τ Z ∈ 𝔔 :=
      Ideal.sum_mem 𝔔 fun τ hτ => hZτ τ (Finset.mem_erase.mp hτ).1
    exact hZ (by simpa using 𝔔.sub_mem hs hT)
  · have key : (∑ τ, act τ Z) * x - ∑ τ, act τ Z * act τ x
        = ∑ τ, act τ Z * (x - act τ x) := by
      rw [Finset.sum_mul, ← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl fun τ _ => by ring
    rw [key]
    refine Ideal.sum_mem 𝔔 fun τ _ => ?_
    by_cases hτ : τ = 1
    · rw [hτ, hact1, hact1, sub_self, mul_zero]
      exact 𝔔.zero_mem
    · exact Ideal.mul_mem_right _ 𝔔 (hZτ τ hτ)

theorem wcLlsASre_uniq_of_irrational : ∀ (R : Type u) [CommRing R] (K : Type u) [Field K] [Algebra R K] (L : Type u) [Field L] [Algebra K L] [Algebra R L] [IsScalarTower R K L] [FiniteDimensional K L] [IsGalois K L] (ℓ : ℕ), ℓ.Prime → Module.finrank K L = ℓ → ∀ (𝔓 : Ideal R) (𝔔 : Ideal ↥(integralClosure R L)), 𝔔.IsPrime → 𝔔.comap (algebraMap R ↥(integralClosure R L)) = 𝔓 → (∀ k : K, IsIntegral R k → ∃ u a : R, u ∉ 𝔓 ∧ algebraMap R K a = algebraMap R K u * k) → ∀ y : ↥(integralClosure R L), (∀ ρ s₁ : R, s₁ ∉ 𝔓 → algebraMap R ↥(integralClosure R L) s₁ * y - algebraMap R ↥(integralClosure R L) ρ ∉ 𝔔) → wcLlsUniq R L 𝔓 𝔔 :=
by
  intro R _ K _ _ L _ _ _ _ _ _ ℓ hℓ hdeg 𝔓 𝔔 h𝔔 hcomap hloc y hirr
  by_contra hU
  have hdec := wcLlsVd_gi_split_decomp R K L ℓ hℓ hdeg 𝔓 𝔔 h𝔔 hcomap hU hloc
  obtain ⟨r, s, ⟨r₀, hr₀⟩, ⟨s₀, hs₀⟩, hs𝔔, hsy⟩ := wcLlsVd_gi_split_trace R K L 𝔔 h𝔔 hdec y
  have h𝔓 : 𝔓.IsPrime := by
    rw [← hcomap]; exact Ideal.IsPrime.comap _
  have hir : IsIntegral R r₀ := by
    have h1 : IsIntegral R (r : L) := (mem_integralClosure_iff R L).mp r.2
    rw [← hr₀] at h1
    exact isIntegral_algebraMap_iff.mp h1
  have his : IsIntegral R s₀ := by
    have h1 : IsIntegral R (s : L) := (mem_integralClosure_iff R L).mp s.2
    rw [← hs₀] at h1
    exact isIntegral_algebraMap_iff.mp h1
  obtain ⟨ur, ar, hur, har⟩ := hloc r₀ hir
  obtain ⟨us, bs, hus, has⟩ := hloc s₀ his
  have hP : ∀ z : R, ((algebraMap R ↥(integralClosure R L) z : ↥(integralClosure R L)) : L)
      = algebraMap K L (algebraMap R K z) := by
    intro z
    rw [Subalgebra.coe_algebraMap, IsScalarTower.algebraMap_apply R K L]
  have har' : algebraMap K L (algebraMap R K ar)
      = algebraMap K L (algebraMap R K ur) * algebraMap K L r₀ := by
    rw [har, map_mul]
  have has' : algebraMap K L (algebraMap R K bs)
      = algebraMap K L (algebraMap R K us) * algebraMap K L s₀ := by
    rw [has, map_mul]
  have hid : algebraMap R ↥(integralClosure R L) (ur * us) * (s * y - r)
      = algebraMap R ↥(integralClosure R L) (bs * ur) * y
        - algebraMap R ↥(integralClosure R L) (ar * us) := by
    apply Subtype.ext
    simp only [Subalgebra.coe_mul, Subalgebra.coe_sub, hP, map_mul]
    rw [har', has', ← hr₀, ← hs₀]
    ring
  have hmem : algebraMap R ↥(integralClosure R L) (bs * ur) * y
      - algebraMap R ↥(integralClosure R L) (ar * us) ∈ 𝔔 := by
    rw [← hid]; exact Ideal.mul_mem_left 𝔔 _ hsy
  have has𝔓 : bs ∉ 𝔓 := by
    intro ha
    rw [← hcomap, Ideal.mem_comap] at ha
    have he : algebraMap R ↥(integralClosure R L) bs
        = algebraMap R ↥(integralClosure R L) us * s := by
      apply Subtype.ext
      simp only [Subalgebra.coe_mul, hP]
      rw [has', hs₀]
    rw [he] at ha
    rcases h𝔔.mem_or_mem ha with h | h
    · exact hus (by rw [← hcomap, Ideal.mem_comap]; exact h)
    · exact hs𝔔 h
  have hs₁ : bs * ur ∉ 𝔓 := by
    intro h
    rcases h𝔓.mem_or_mem h with h | h
    · exact has𝔓 h
    · exact hur h
  exact hirr (ar * us) (bs * ur) hs₁ hmem

theorem wcLlsVd_gi_local_normal : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ c b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → ∀ 𝔓 : Ideal ↥(Algebra.adjoin A {wcLlsScS W A K t c b}), 𝔓.IsPrime → 𝔓 ≤ Ideal.span {⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ - algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (algebraMap ↥W A 0)} ⊔ (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A)) → ∀ k : K, IsIntegral ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) k → ∃ u a : ↥(Algebra.adjoin A {wcLlsScS W A K t c b}), u ∉ 𝔓 ∧ algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) K a = algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) K u * k :=
by
  intro Ω _ _ W A _ _ _ K _ _ _ 𝔭 t hPD c b hc hb hb0 𝔓 h𝔓 h𝔓J k hk
  obtain ⟨h, hh𝔭, ψ, -, -, hψ⟩ := wcLlsKPas_chart_etale Ω W A K 𝔭 t hPD c b hc hb hb0
  obtain ⟨-, hJ⟩ := (wcLlsKPms_chart_fibre Ω W A K 𝔭 t hPD c b hc hb hb0).2.2 0
  have hh𝔓 : algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) h ∉ 𝔓 := by
    intro hmem
    apply hh𝔭
    rw [← hJ]
    exact Ideal.mem_comap.mpr (h𝔓J hmem)
  haveI := h𝔓
  obtain ⟨-, hIC⟩ := wcLlsKP_ed_etale_point_normal Ω W ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
    (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) h) 𝔓 ψ hh𝔓 hψ
  haveI hFR : IsFractionRing ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) K := by
    apply IsFractionRing.of_field
    intro z
    obtain ⟨x, y, hy, hxy⟩ := IsFractionRing.div_surjective (A := A) z
    refine ⟨algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) x,
      algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) y, ?_⟩
    rw [← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply, hxy]

  have generic : ∀ (R : Type u) [CommRing R] [IsDomain R] [Algebra R K] [IsFractionRing R K]
      (P : Ideal R) [P.IsPrime], IsIntegrallyClosed (Localization.AtPrime P) →
      ∀ k : K, IsIntegral R k → ∃ u a : R, u ∉ P ∧ algebraMap R K a = algebraMap R K u * k := by
    intro R _ _ _ _ P _ hIC k hk
    have hunit : ∀ y : P.primeCompl, IsUnit (algebraMap R K y) := by
      intro y
      apply isUnit_iff_ne_zero.mpr
      intro h0
      have : (y : R) = 0 := IsFractionRing.injective R K (by rw [h0, map_zero])
      exact y.2 (by rw [this]; exact P.zero_mem)
    let φ : Localization.AtPrime P →+* K := IsLocalization.lift (M := P.primeCompl) hunit
    letI : Algebra (Localization.AtPrime P) K := φ.toAlgebra
    haveI : IsScalarTower R (Localization.AtPrime P) K := by
      apply IsScalarTower.of_algebraMap_eq'
      apply RingHom.ext
      intro x
      rw [RingHom.algebraMap_toAlgebra, RingHom.comp_apply]
      exact (IsLocalization.lift_eq hunit x).symm
    haveI : IsFractionRing (Localization.AtPrime P) K :=
      IsFractionRing.isFractionRing_of_isDomain_of_isLocalization P.primeCompl
        (Localization.AtPrime P) K
    have hk' : IsIntegral (Localization.AtPrime P) k := hk.tower_top
    obtain ⟨y, hy⟩ :=
      (IsIntegrallyClosed.isIntegral_iff (R := Localization.AtPrime P) (K := K)).mp hk'
    obtain ⟨⟨a, ⟨u, hu⟩⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl y
    have hspec := IsLocalization.mk'_spec (Localization.AtPrime P) a ⟨u, hu⟩
    refine ⟨u, a, hu, ?_⟩
    have h2 := congrArg φ hspec
    rw [map_mul] at h2
    have e1 : φ (algebraMap R (Localization.AtPrime P) u) = algebraMap R K u :=
      IsLocalization.lift_eq hunit u
    have e2 : φ (algebraMap R (Localization.AtPrime P) a) = algebraMap R K a :=
      IsLocalization.lift_eq hunit a
    have e3 : φ (IsLocalization.mk' (Localization.AtPrime P) a ⟨u, hu⟩) = k := hy
    rw [e1, e2, e3] at h2
    rw [← h2, mul_comm]
  exact generic _ 𝔓 hIC k hk

theorem wcLlsASvm_read_etale : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ ℓ : ℕ, ℓ.Prime → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ((ℓ : ℕ) : K) = 0 → Module.finrank K L = ℓ → ∀ (α : L) (f : K), α ∉ Set.range (algebraMap K L) → α ^ ℓ - α = algebraMap K L f → ∀ c b υ μ : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → IsUnit υ → μ ∈ IsLocalRing.maximalIdeal ↥W → ∀ h : K, wcLlsVmSmall W A K 𝔭 t c b μ (f - h ^ ℓ + h - algebraMap A K (algebraMap ↥W A υ) * wcLlsScS W A K t c b) → wcLlsGaussEtale W A K L t c b :=
