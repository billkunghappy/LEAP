            rw [← map_mul, huv, hg₂]
            simp only [map_mul]
          have e : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) v =
              algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A g₂) * ⟨_, hs₂⟩ := by
            apply Subtype.ext
            simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
