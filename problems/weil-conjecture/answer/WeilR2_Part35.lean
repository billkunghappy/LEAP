      have h0' := Multiset.prod_eq_zero_iff.mp h0
      obtain ⟨q, hq, hq0⟩ := Multiset.mem_map.mp h0'
      obtain ⟨w, _, rfl⟩ := Multiset.mem_map.mp hq
      simp only [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C, sub_eq_zero] at hq0
      refine ⟨w, ?_⟩
      apply hιinj
      rw [hx, div_eq_iff hιb] at hq0
      rw [map_mul, hq0, RingHom.comp_apply]
    have hfact : Fact ℓ.Prime := ⟨hℓ⟩
    have hdom : IsDomain (↥(integralClosure R L) ⧸ 𝔔) := Ideal.Quotient.isDomain 𝔔

    have hcard : Nat.card (L ≃ₐ[K] L) = ℓ := (IsGalois.card_aut_eq_finrank K L).trans hdeg
    have hnt : Nontrivial (L ≃ₐ[K] L) :=
      Finite.one_lt_card_iff_nontrivial.mp (by rw [hcard]; exact hℓ.one_lt)
    obtain ⟨g, hg⟩ := exists_ne (1 : L ≃ₐ[K] L)
    have hgℓ : g ^ ℓ = 1 := by rw [← hcard]; exact pow_card_eq_one'

    obtain ⟨σ, hσ⟩ : ∃ σ : ↥(integralClosure R L) ≃ₐ[R] ↥(integralClosure R L),
