      obtain ⟨h1, h2⟩ := hVI _ 1 1 [] [] 1 a₀ h0 hrep
      rw [hP0] at h1 h2
      have := hveq _ _ (mul_ne_zero (hF0' _ (mul_ne_zero one_ne_zero one_ne_zero)) h0)
