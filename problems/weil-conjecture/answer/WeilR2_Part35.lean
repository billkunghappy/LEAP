  obtain ⟨q'', hq''⟩ := hdiv
  have hq''m : q'' ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra h
    obtain ⟨u, hu⟩ := IsLocalRing.notMem_maximalIdeal.mp h
    apply hnd
    exact ⟨↑u⁻¹, by rw [hq'', ← hu, Units.mul_inv_cancel_right]⟩
  have hz : ζ = algebraMap A K (algebraMap ↥W A b₀) *
