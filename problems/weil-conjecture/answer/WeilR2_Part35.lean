    · exact Ideal.IsPrime.mul_notMem ‹_› (Ideal.IsPrime.mul_notMem ‹_› hh hs₀P) hg₀
    · apply RingHom.ext
      intro x
      simp only [RingHom.comp_apply]
      show e.symm (algebraMap C _ (algebraMap E C x)) = _
      rw [← IsScalarTower.algebraMap_apply E C]
      exact e.symm.commutes x
    · refine RingHom.Etale.stableUnderComposition
        (algebraMap C (Localization.Away (algebraMap E C g₀)))
        e.symm.toRingEquiv.toRingHom ?_ ?_
      · exact RingHom.etale_algebraMap.mpr
          (Algebra.Etale.of_isLocalizationAway (algebraMap E C g₀))
      · exact RingHom.Etale.of_bijective e.symm.bijective
  have t_s7 : ∀ (R B : Type u) [CommRing R] [CommRing B] (θ : MvPolynomial (Fin 3) R →+* B) (hθ : RingHom.Etale θ), ∃ f : Polynomial R →+* (B ⧸ Ideal.span {θ (MvPolynomial.X 0), θ (MvPolynomial.X 1)}), f.comp Polynomial.C = (Ideal.Quotient.mk (Ideal.span {θ (MvPolynomial.X 0), θ (MvPolynomial.X 1)})).comp (θ.comp MvPolynomial.C) ∧ f Polynomial.X = Ideal.Quotient.mk (Ideal.span {θ (MvPolynomial.X 0), θ (MvPolynomial.X 1)}) (θ (MvPolynomial.X 2)) ∧ RingHom.Etale f := by
    intro R B _ _ θ hθ
    classical
    let K : Ideal (MvPolynomial (Fin 3) R) := Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1}
    have hX0K : (MvPolynomial.X 0 : MvPolynomial (Fin 3) R) ∈ K := Ideal.subset_span (Set.mem_insert _ _)
    have hX1K : (MvPolynomial.X 1 : MvPolynomial (Fin 3) R) ∈ K :=
      Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
