by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 u v g hPD z σ a L w α N hz hσ ha hw0 hα0 hL hfac
  classical
  have hPD' := hPD
  obtain ⟨-, htf, -, h𝔭max, -, hg, hg0, huv, -⟩ := hPD'
  haveI := htf
  have h𝔭 : 𝔭.IsPrime := h𝔭max.isPrime
  have h1 : (1 : A) ∉ 𝔭 := fun h => h𝔭.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have hneg1 : (-1 : A) ∉ 𝔭 := fun h => h1 (by simpa using 𝔭.neg_mem h)
  have hmul : ∀ x y : A, x ∉ 𝔭 → y ∉ 𝔭 → x * y ∉ 𝔭 :=
