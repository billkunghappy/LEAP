  have hJprime : J.IsPrime := by
    refine ⟨hJne, ?_⟩
    intro x y hxy
    obtain ⟨a₁, ha₁⟩ := hJcong x
    obtain ⟨a₂, ha₂⟩ := hJcong y
    by_cases h₁ : a₁ ∈ 𝔭
    · left
      have h2 := Ideal.add_mem _ ha₁ (hJover (Ideal.mem_map_of_mem _ h₁))
      rwa [sub_add_cancel] at h2
    by_cases h₂ : a₂ ∈ 𝔭
    · right
      have h2 := Ideal.add_mem _ ha₂ (hJover (Ideal.mem_map_of_mem _ h₂))
