    exact hd h1

  have common : ∀ (U V : A) (n : ℕ) (μ : ↥W), wcLlsPD W A 𝔭 (.ann U V g) → 0 < n →
      ¬ (k + 1) ∣ n → μ ≠ 0 → algebraMap A K U ≠ 0 →
      algebraMap A K U ^ n * algebraMap A K (algebraMap ↥W A μ) ^ (k + 1) *
        (f₀ - (h ^ (k + 1) - h)) * algebraMap A K d = algebraMap A K (d + e) →
      ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) := by
    intro U V n μ hPDUV hn hℓn hμ hUK hEQ
    have hc0 : algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) ≠ 0 :=
      (map_ne_zero _).mpr (hinj μ hμ)
    have hαH : α - algebraMap K L h ≠ 0 := fun h0 => hα ⟨h, (sub_eq_zero.mp h0).symm⟩
    have hw0 : algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * (α - algebraMap K L h) ≠ 0 :=
