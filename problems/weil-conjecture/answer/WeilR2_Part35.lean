  have hqQ : algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c r₀}) L) q ∉ Q := by
    intro hq
    have hqmem : q ∈ wcLlsScN W A K t c r₀ := by
