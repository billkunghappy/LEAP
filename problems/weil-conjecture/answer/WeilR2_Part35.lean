import WeilR2_Part34
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wcpa_dj_llsm_kpwulbc_cap_bound : ∀ (K : Type u) [Field K] (O O₁ : ValuationSubring K) (ℓ : ℕ), ℓ.Prime → O₁ ≤ O → (∀ x : K, O.valuation x < 1 → x ∈ O₁) → ∀ (ϖ c π₀ f : K), ϖ ≠ 0 → ϖ ∈ O₁ → c ≠ 0 → O.valuation c < 1 → O.valuation π₀ < 1 → ((ℓ : ℕ) : K) = c ^ (ℓ - 1) * π₀ → (∀ x ∈ O₁, (∀ M : ℕ, ∃ σ ∈ O₁, ∃ r ∈ O₁, O.valuation (x - σ ^ ℓ - ϖ ^ M * r) < 1) → ∃ σ ∈ O₁, O.valuation (x - σ ^ ℓ) < 1) → (∀ h : K, h ≠ 0 → f / h ^ ℓ - 1 ≠ 0 ∧ c ^ ℓ / (f / h ^ ℓ - 1) ∈ O) → ∃ J : ℕ, ∀ h : K, h ≠ 0 → (f / h ^ ℓ - 1) / c ^ ℓ / ϖ ^ (J + 1) ∉ O₁ :=
by
  intro K _ O O₁ ℓ hℓ hO₁O hm ϖ c π₀ f hϖ0 hϖO₁ hc0 hvc hvπ hℓc HENS G
  have hℓ2 : 2 ≤ ℓ := hℓ.two_le
  obtain ⟨μ, hμdef⟩ : ∃ μ : K → K, ∀ s, μ s = π₀ * ∑ m ∈ Finset.range (ℓ - 1),
      ((ℓ.choose (m + 1) / ℓ : ℕ) : K) * c ^ m * s ^ (m + 1) := ⟨_, fun _ => rfl⟩

  have hexp : ∀ s : K, (1 + c * s) ^ ℓ = 1 + c ^ ℓ * (s ^ ℓ + μ s) := by
    intro s
    rw [hμdef]
    obtain ⟨k, hk⟩ : ∃ k, ℓ = k + 2 := ⟨ℓ - 2, by omega⟩
    subst hk
    have hk1 : k + 2 - 1 = k + 1 := by omega
    rw [hk1] at hℓc ⊢
    have hq : ∀ m ∈ Finset.range (k + 1), (((k + 2).choose (m + 1) : ℕ) : K) =
        ((((k + 2).choose (m + 1) / (k + 2) : ℕ) : K)) * (c ^ (k + 1) * π₀) := by
      intro m hm
      rw [Finset.mem_range] at hm
      rw [← hℓc, ← Nat.cast_mul, Nat.div_mul_cancel (hℓ.dvd_choose_self (by omega) (by omega))]
    have hmid : ∑ m ∈ Finset.range (k + 1), (c * s) ^ (m + 1) * (((k + 2).choose (m + 1) : ℕ) : K) =
        c ^ (k + 2) * (π₀ * ∑ m ∈ Finset.range (k + 1),
          ((((k + 2).choose (m + 1) / (k + 2) : ℕ) : K)) * c ^ m * s ^ (m + 1)) := by
      rw [Finset.mul_sum, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro m hm
      rw [hq m hm]
      ring
    rw [add_comm 1 (c * s), add_pow, Finset.sum_range_succ, Finset.sum_range_succ']
    simp only [one_pow, mul_one, pow_zero, Nat.choose_zero_right, Nat.choose_self,
      Nat.cast_one]
    rw [hmid]
    ring

  have hcO : c ∈ O := (O.valuation_le_one_iff c).mp hvc.le
  have hsumO : ∀ s ∈ O, ∑ m ∈ Finset.range (ℓ - 1),
      ((ℓ.choose (m + 1) / ℓ : ℕ) : K) * c ^ m * s ^ (m + 1) ∈ O := fun s hs =>
    sum_mem (fun m _ => mul_mem (mul_mem (natCast_mem O _) (pow_mem hcO _)) (pow_mem hs _))
  have hsmall : ∀ s ∈ O, O.valuation (μ s) < 1 := by
    intro s hs
    rw [hμdef, map_mul]
    exact lt_of_le_of_lt (mul_le_of_le_one_right' ((O.valuation_le_one_iff _).mpr (hsumO s hs))) hvπ

  have hgrow : ∀ s : K, 1 < O.valuation s → O.valuation (μ s) < O.valuation s ^ ℓ := by
    intro s hs
    have hS : O.valuation (∑ m ∈ Finset.range (ℓ - 1),
        ((ℓ.choose (m + 1) / ℓ : ℕ) : K) * c ^ m * s ^ (m + 1)) ≤ O.valuation s ^ (ℓ - 1) := by
      apply Valuation.map_sum_le
      intro m hm
      rw [Finset.mem_range] at hm
      rw [map_mul, map_mul, map_pow, map_pow]
      have h1 : O.valuation ((ℓ.choose (m + 1) / ℓ : ℕ) : K) ≤ 1 :=
        (O.valuation_le_one_iff _).mpr (natCast_mem O _)
      have h2 : O.valuation c ^ m ≤ 1 := pow_le_one' hvc.le m
      calc _ ≤ 1 * 1 * O.valuation s ^ (m + 1) := mul_le_mul' (mul_le_mul' h1 h2) le_rfl
        _ = O.valuation s ^ (m + 1) := by rw [one_mul, one_mul]
        _ ≤ O.valuation s ^ (ℓ - 1) := pow_le_pow_right₀ hs.le (by omega)
    rw [hμdef, map_mul]
    calc _ ≤ 1 * O.valuation s ^ (ℓ - 1) := mul_le_mul' hvπ.le hS
      _ = O.valuation s ^ (ℓ - 1) := one_mul _
      _ < O.valuation s ^ ℓ := pow_lt_pow_right₀ hs (by omega)

  have hcl0 : c ^ ℓ ≠ 0 := pow_ne_zero _ hc0
  have hcs : ∀ g : K, 1 + c * ((g - 1) / c) = g := by
    intro g
    rw [mul_div_assoc', mul_div_cancel_left₀ _ hc0]
    ring
  have hroot : ∀ g z : K, z ∈ O → g ^ ℓ = 1 + c ^ ℓ * z → (g - 1) / c ∈ O := by
    intro g z hz hg
    obtain ⟨s, hsdef⟩ : ∃ s, s = (g - 1) / c := ⟨_, rfl⟩
    rw [← hsdef]
    have hgs : 1 + c * s = g := by rw [hsdef]; exact hcs g
    have hz' : z = s ^ ℓ + μ s := by
      have := hexp s
      rw [hgs, hg] at this
      exact mul_left_cancel₀ hcl0 (add_left_cancel this)
    by_contra hsO
    have h1 : 1 < O.valuation s := by
      rw [← not_le]
      exact fun h => hsO ((O.valuation_le_one_iff s).mp h)
    have h3 : O.valuation (μ s) < O.valuation (s ^ ℓ) := by
      rw [map_pow]; exact hgrow s h1
    have h2 : O.valuation z = O.valuation s ^ ℓ := by
      rw [hz', Valuation.map_add_eq_of_lt_left _ h3, map_pow]
    have h4 : 1 < O.valuation z := h2 ▸ one_lt_pow₀ h1 (by omega)
    exact absurd ((O.valuation_le_one_iff z).mpr hz) (not_le.mpr h4)

  obtain ⟨Y, hY⟩ : ∃ Y : K → K, ∀ h, Y h = (f / h ^ ℓ - 1) / c ^ ℓ := ⟨_, fun _ => rfl⟩
  have hFY : ∀ h, f / h ^ ℓ = 1 + c ^ ℓ * Y h := by
    intro h
    rw [hY, mul_div_assoc', mul_div_cancel_left₀ _ hcl0]
    ring
  have hvcl : O.valuation (c ^ ℓ) < 1 := by
    rw [map_pow]; exact pow_lt_one₀ zero_le' hvc (by omega)
  have hsmallmul : ∀ y ∈ O, O.valuation (c ^ ℓ * y) < 1 := by
    intro y hy
    rw [map_mul]
    exact lt_of_le_of_lt (mul_le_of_le_one_right' ((O.valuation_le_one_iff y).mpr hy)) hvcl
  have hunit : ∀ y ∈ O, O.valuation (1 + c ^ ℓ * y) = 1 := fun y hy =>
    Valuation.map_one_add_of_lt _ (hsmallmul y hy)

  have hcong : ∀ h₀ h : K, h₀ ≠ 0 → h ≠ 0 → Y h₀ ∈ O₁ → Y h ∈ O₁ →
      ∃ s ∈ O₁, O.valuation (Y h₀ - s ^ ℓ - Y h) < 1 := by
    intro h₀ h hh₀ hh hy₀ hy
    have hy₀O := hO₁O hy₀
    have hyO := hO₁O hy
    have hD := hunit _ hyO
    have hD0 : 1 + c ^ ℓ * Y h ≠ 0 := by
      intro h0; rw [h0, map_zero] at hD; exact zero_ne_one hD
    obtain ⟨z, hzdef⟩ : ∃ z, z = (Y h₀ - Y h) / (1 + c ^ ℓ * Y h) := ⟨_, rfl⟩
    have hzD : z * (1 + c ^ ℓ * Y h) = Y h₀ - Y h := by rw [hzdef, div_mul_cancel₀ _ hD0]
    have hzO : z ∈ O := by
      rw [← O.valuation_le_one_iff, hzdef, map_div₀, hD, div_one, O.valuation_le_one_iff]
      exact sub_mem hy₀O hyO
    have ef : f = (1 + c ^ ℓ * Y h) * h ^ ℓ := by
      rw [← hFY h, div_mul_cancel₀ _ (pow_ne_zero _ hh)]
    have ef₀ : f = (1 + c ^ ℓ * Y h₀) * h₀ ^ ℓ := by
      rw [← hFY h₀, div_mul_cancel₀ _ (pow_ne_zero _ hh₀)]
    have hg : (h / h₀) ^ ℓ = 1 + c ^ ℓ * z := by
      rw [div_pow, div_eq_iff (pow_ne_zero _ hh₀)]
      have e2 : (1 + c ^ ℓ * z) * (1 + c ^ ℓ * Y h) = 1 + c ^ ℓ * Y h₀ := by
        linear_combination c ^ ℓ * hzD
      apply mul_right_cancel₀ hD0
      linear_combination ef₀ - ef - h₀ ^ ℓ * e2
    have hsO := hroot (h / h₀) z hzO hg
    obtain ⟨s, hsdef⟩ : ∃ s, s = (h / h₀ - 1) / c := ⟨_, rfl⟩
    rw [← hsdef] at hsO
    have hgs : 1 + c * s = h / h₀ := by rw [hsdef]; exact hcs _
    have hz' : z = s ^ ℓ + μ s := by
      have := hexp s
      rw [hgs, hg] at this
      exact mul_left_cancel₀ hcl0 (add_left_cancel this)
    have key : Y h₀ - s ^ ℓ - Y h = z * (c ^ ℓ * Y h) + μ s := by
      linear_combination (-1 : K) * hzD + hz'
    have hz1 : O.valuation z ≤ 1 := (O.valuation_le_one_iff z).mpr hzO
    have he1 : O.valuation (Y h₀ - s ^ ℓ - Y h) < 1 := by
      rw [key]
      refine Valuation.map_add_lt _ ?_ (hsmall s hsO)
      rw [map_mul]
      exact lt_of_le_of_lt (mul_le_of_le_one_left' hz1) (hsmallmul _ hyO)
    refine ⟨s, ?_, he1⟩
    have heO₁ := hm _ he1
    have hslO₁ : s ^ ℓ ∈ O₁ := by
      have : s ^ ℓ = (Y h₀ - Y h) - (Y h₀ - s ^ ℓ - Y h) := by ring
      rw [this]; exact sub_mem (sub_mem hy₀ hy) heO₁
    rcases O₁.mem_or_inv_mem s with h1 | h1
    · exact h1
    · by_cases hs0 : s = 0
      · rw [hs0]; exact zero_mem _
      · have hss : s ^ ℓ * s⁻¹ ^ (ℓ - 1) = s := by
          obtain ⟨k, hk⟩ : ∃ k, ℓ = k + 1 := ⟨ℓ - 1, by omega⟩
          rw [hk, Nat.add_sub_cancel, pow_succ, mul_right_comm, ← mul_pow, mul_inv_cancel₀ hs0,
            one_pow, one_mul]
        rw [← hss]
        exact mul_mem hslO₁ (pow_mem h1 _)

  have hnores : ∀ h₀ σ : K, h₀ ≠ 0 → σ ∈ O → ¬ O.valuation (Y h₀ - σ ^ ℓ) < 1 := by
    intro h₀ σ hh₀ hσ hlt
    have hcσ : O.valuation (c * σ) < 1 := by
      rw [map_mul]
      exact lt_of_le_of_lt (mul_le_of_le_one_right' ((O.valuation_le_one_iff σ).mpr hσ)) hvc
    have hu : O.valuation (1 + c * σ) = 1 := Valuation.map_one_add_of_lt _ hcσ
    have hu0 : 1 + c * σ ≠ 0 := by
      intro h0; rw [h0, map_zero] at hu; exact zero_ne_one hu
    have hT : O.valuation ((1 + c * σ) ^ ℓ) = 1 := by rw [map_pow, hu, one_pow]
    have hT0 : (1 + c * σ) ^ ℓ ≠ 0 := pow_ne_zero _ hu0
    have hh' : h₀ * (1 + c * σ) ≠ 0 := mul_ne_zero hh₀ hu0
    obtain ⟨hF0, hFO⟩ := G _ hh'
    obtain ⟨e, he⟩ : ∃ e, e = Y h₀ - σ ^ ℓ - μ σ := ⟨_, rfl⟩
    have hve : O.valuation e < 1 := by
      rw [he, sub_eq_add_neg (Y h₀ - σ ^ ℓ)]
      exact Valuation.map_add_lt _ hlt (by rw [Valuation.map_neg]; exact hsmall σ hσ)
    have hF' : (f / (h₀ * (1 + c * σ)) ^ ℓ - 1) * (1 + c * σ) ^ ℓ = c ^ ℓ * e := by
      have e1 := hFY h₀
      have e2 := hexp σ
      rw [mul_pow, ← div_div, sub_mul, div_mul_cancel₀ _ hT0, e1, e2, he]
      ring
    have hkey : e * (c ^ ℓ / (f / (h₀ * (1 + c * σ)) ^ ℓ - 1)) = (1 + c * σ) ^ ℓ := by
      rw [mul_div_assoc', div_eq_iff hF0]
      linear_combination (-1 : K) * hF'
    have h1 := congrArg O.valuation hkey
    rw [map_mul, hT] at h1
    have h2 : O.valuation e * O.valuation (c ^ ℓ / (f / (h₀ * (1 + c * σ)) ^ ℓ - 1)) ≤
        O.valuation e := mul_le_of_le_one_right' ((O.valuation_le_one_iff _).mpr hFO)
    rw [h1] at h2
    exact absurd (lt_of_le_of_lt h2 hve) (lt_irrefl 1)

  by_contra hcon
  push_neg at hcon
  choose H hH0 hHmem using hcon
  have hHmem' : ∀ J, Y (H J) / ϖ ^ (J + 1) ∈ O₁ := fun J => by rw [hY]; exact hHmem J
  have hyO₁ : ∀ J, Y (H J) ∈ O₁ := by
    intro J
    have : Y (H J) = ϖ ^ (J + 1) * (Y (H J) / ϖ ^ (J + 1)) := by
      rw [mul_div_assoc', mul_div_cancel_left₀ _ (pow_ne_zero _ hϖ0)]
    rw [this]
    exact mul_mem (pow_mem hϖO₁ _) (hHmem' J)
  obtain ⟨σ, hσO₁, hσ⟩ := HENS (Y (H 0)) (hyO₁ 0) (fun M => by
    obtain ⟨s, hsO₁, hs⟩ := hcong (H 0) (H M) (hH0 0) (hH0 M) (hyO₁ 0) (hyO₁ M)
    refine ⟨s, hsO₁, ϖ * (Y (H M) / ϖ ^ (M + 1)), mul_mem hϖO₁ (hHmem' M), ?_⟩
    have : ϖ ^ M * (ϖ * (Y (H M) / ϖ ^ (M + 1))) = Y (H M) := by
      rw [← mul_assoc, ← pow_succ, mul_div_assoc', mul_div_cancel_left₀ _ (pow_ne_zero _ hϖ0)]
    rw [this]
    exact hs)
  exact hnores (H 0) σ (hH0 0) (hO₁O hσO₁) hσ

theorem wcpa_dj_llsm_kpwulbc_unit_bound : ∀ (K : Type u) [Field K] (O O₁ : ValuationSubring K) (ℓ : ℕ), ℓ.Prime → O₁ ≤ O → ∀ (ϖ f : K), ϖ ∈ O₁ → ϖ⁻¹ ∉ O₁ → (∀ x ∈ O₁, (∀ M : ℕ, ∃ σ ∈ O₁, ∃ r ∈ O₁, O.valuation (x - σ ^ ℓ - ϖ ^ M * r) < 1) → ∃ σ ∈ O₁, O.valuation (x - σ ^ ℓ) < 1) → (∀ h : K, h ≠ 0 → f / h ^ ℓ - 1 ≠ 0 ∧ (f / h ^ ℓ - 1)⁻¹ ∈ O) → ∃ J : ℕ, ∀ h : K, h ≠ 0 → (f / h ^ ℓ - 1) / ϖ ^ (J + 1) ∉ O₁ :=
by
  intro K _ O O₁ ℓ hℓ hO ϖ f hϖ hϖi KR MAX0
  classical
  have hℓ1 : 1 ≤ ℓ := hℓ.one_lt.le

  have hϖ0 : ϖ ≠ 0 := by
    rintro rfl
    exact hϖi (by rw [inv_zero]; exact zero_mem O₁)
  have hv1 : O₁.valuation ϖ < 1 := by
    refine lt_of_le_of_ne ((O₁.valuation_le_one_iff ϖ).mpr hϖ) ?_
    intro h
    apply hϖi
    rw [← O₁.valuation_le_one_iff, map_inv₀, h, inv_one]

  by_contra hcon
  push_neg at hcon
  choose hh hh0 hq using hcon

  have hF : ∀ J, f / hh J ^ ℓ - 1 = ϖ * (ϖ ^ J * ((f / hh J ^ ℓ - 1) / ϖ ^ (J + 1))) := by
    intro J
    rw [← mul_assoc, ← pow_succ']
    field_simp
  have hsmall : ∀ J, O₁.valuation (f / hh J ^ ℓ - 1) < 1 := by
    intro J
    rw [hF J, map_mul]
    have h1 : O₁.valuation (ϖ ^ J * ((f / hh J ^ ℓ - 1) / ϖ ^ (J + 1))) ≤ 1 :=
      (O₁.valuation_le_one_iff _).mpr (mul_mem (pow_mem hϖ J) (hq J))
    calc O₁.valuation ϖ * O₁.valuation (ϖ ^ J * ((f / hh J ^ ℓ - 1) / ϖ ^ (J + 1)))
        ≤ O₁.valuation ϖ * 1 := by gcongr
      _ = O₁.valuation ϖ := mul_one _
      _ < 1 := hv1

  have hA1 : ∀ J, O₁.valuation (f / hh J ^ ℓ) = 1 := by
    intro J
    have h1 := Valuation.map_one_add_of_lt O₁.valuation (hsmall J)
    have e : 1 + (f / hh J ^ ℓ - 1) = f / hh J ^ ℓ := by ring
    rwa [e] at h1
  have hAmem : ∀ J, f / hh J ^ ℓ ∈ O₁ := fun J => (O₁.valuation_le_one_iff _).mp (hA1 J).le
  have hA0 : ∀ J, f / hh J ^ ℓ ≠ 0 := by
    intro J h
    have h1 := hA1 J
    rw [h, map_zero] at h1
    exact zero_ne_one h1
  have hAinv : ∀ J, (f / hh J ^ ℓ)⁻¹ ∈ O₁ := by
    intro J
    rw [← O₁.valuation_le_one_iff, map_inv₀, hA1 J, inv_one]
  have hf0 : f ≠ 0 := by
    intro h
    apply hA0 0
    rw [h, zero_div]

  have hprem : ∀ M : ℕ, ∃ σ ∈ O₁, ∃ r ∈ O₁,
      O.valuation ((f / hh 0 ^ ℓ)⁻¹ - σ ^ ℓ - ϖ ^ M * r) < 1 := by
    intro M
    have hy0 : hh 0 / hh M ≠ 0 := div_ne_zero (hh0 0) (hh0 M)
    have hyl : (hh 0 / hh M) ^ ℓ = (f / hh M ^ ℓ) * (f / hh 0 ^ ℓ)⁻¹ := by
      have h0l : hh 0 ^ ℓ ≠ 0 := pow_ne_zero _ (hh0 0)
      have hMl : hh M ^ ℓ ≠ 0 := pow_ne_zero _ (hh0 M)
      rw [div_pow, inv_div]
      field_simp
    have hylmem : (hh 0 / hh M) ^ ℓ ∈ O₁ := by
      rw [hyl]; exact mul_mem (hAmem M) (hAinv 0)
    have hymem : hh 0 / hh M ∈ O₁ := by
      rcases O₁.mem_or_inv_mem (hh 0 / hh M) with h | h
      · exact h
      · obtain ⟨k, hk⟩ : ∃ k, ℓ = k + 1 := ⟨ℓ - 1, by omega⟩
        have e : hh 0 / hh M = (hh 0 / hh M)⁻¹ ^ k * (hh 0 / hh M) ^ ℓ := by
          rw [hk, pow_succ, inv_pow, ← mul_assoc, inv_mul_cancel₀ (pow_ne_zero _ hy0), one_mul]
        rw [e]; exact mul_mem (pow_mem h _) hylmem
    refine ⟨hh 0 / hh M, hymem,
      -(ϖ * ((f / hh M ^ ℓ - 1) / ϖ ^ (M + 1)) * (hh 0 / hh M) ^ ℓ * (f / hh M ^ ℓ)⁻¹), ?_, ?_⟩
    · exact neg_mem (mul_mem (mul_mem (mul_mem hϖ (hq M)) hylmem) (hAinv M))
    · have hAA : (f / hh M ^ ℓ) * (f / hh M ^ ℓ)⁻¹ = 1 := mul_inv_cancel₀ (hA0 M)
      have e : (f / hh 0 ^ ℓ)⁻¹ - (hh 0 / hh M) ^ ℓ - ϖ ^ M *
          -(ϖ * ((f / hh M ^ ℓ - 1) / ϖ ^ (M + 1)) * (hh 0 / hh M) ^ ℓ * (f / hh M ^ ℓ)⁻¹)
          = 0 := by
        rw [hyl]
        linear_combination (-(f / hh 0 ^ ℓ)⁻¹) * (hF M) +
          (ϖ * ϖ ^ M * ((f / hh M ^ ℓ - 1) / ϖ ^ (M + 1)) * (f / hh 0 ^ ℓ)⁻¹) * hAA
      rw [e, map_zero]; exact zero_lt_one

  obtain ⟨σ, hσ, hσv⟩ := KR _ (hAinv 0) hprem
  have hvA : O.valuation (f / hh 0 ^ ℓ) ≤ 1 := (O.valuation_le_one_iff _).mpr (hO (hAmem 0))
  have hσ0 : σ ≠ 0 := by
    rintro rfl
    rw [zero_pow (by omega : ℓ ≠ 0), sub_zero] at hσv
    have h1 : O.valuation (f / hh 0 ^ ℓ) * O.valuation (f / hh 0 ^ ℓ)⁻¹ = 1 := by
      rw [← map_mul, mul_inv_cancel₀ (hA0 0), map_one]
    have h2 : O.valuation (f / hh 0 ^ ℓ) * O.valuation (f / hh 0 ^ ℓ)⁻¹ < 1 :=
      calc O.valuation (f / hh 0 ^ ℓ) * O.valuation (f / hh 0 ^ ℓ)⁻¹
          ≤ 1 * O.valuation (f / hh 0 ^ ℓ)⁻¹ := by gcongr
        _ = O.valuation (f / hh 0 ^ ℓ)⁻¹ := one_mul _
        _ < 1 := hσv
    rw [h1] at h2; exact lt_irrefl _ h2

  obtain ⟨hne, hinv⟩ := MAX0 (hh 0 / σ) (div_ne_zero (hh0 0) hσ0)
  have e : f / (hh 0 / σ) ^ ℓ - 1 = -(f / hh 0 ^ ℓ) * ((f / hh 0 ^ ℓ)⁻¹ - σ ^ ℓ) := by
    have h0l : hh 0 ^ ℓ ≠ 0 := pow_ne_zero _ (hh0 0)
    have hσl : σ ^ ℓ ≠ 0 := pow_ne_zero _ hσ0
    rw [div_pow]
    field_simp
    ring
  have hvF : O.valuation (f / (hh 0 / σ) ^ ℓ - 1) < 1 := by
    rw [e, map_mul, Valuation.map_neg]
    calc O.valuation (f / hh 0 ^ ℓ) * O.valuation ((f / hh 0 ^ ℓ)⁻¹ - σ ^ ℓ)
        ≤ 1 * O.valuation ((f / hh 0 ^ ℓ)⁻¹ - σ ^ ℓ) := by gcongr
      _ = O.valuation ((f / hh 0 ^ ℓ)⁻¹ - σ ^ ℓ) := one_mul _
      _ < 1 := hσv
