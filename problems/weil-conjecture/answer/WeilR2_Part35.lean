  obtain ⟨i, rfl⟩ := List.mem_iff_get.mp hx
  exact ⟨i, hgood⟩

theorem wcLlsASdmc_frf_radial_family : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y →
    wcLlsBR W A K L 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ (α : L) (f₀ : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α →
    ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W →
    ∃ (N : ℕ) (Hf : Fin N → K) (k1 k2 : Fin N → ↥W) (Zf Yf : Fin N → List ↥W) (df ef : Fin N → A),
      (∀ i, k1 i ≠ 0 ∧ k2 i ≠ 0 ∧ df i ∉ 𝔭 ∧ ef i ∉ 𝔭 ∧
        (∀ z ∈ Zf i ++ Yf i, z ∈ IsLocalRing.maximalIdeal ↥W) ∧
        algebraMap A K (df i) * algebraMap A K (algebraMap ↥W A (k2 i)) *
            ((Yf i).map (fun y => algebraMap A K (t - algebraMap ↥W A y))).prod *
            (f₀ - (Hf i ^ ℓ - Hf i)) =
          algebraMap A K (algebraMap ↥W A (k1 i)) *
            ((Zf i).map (fun z => algebraMap A K (t - algebraMap ↥W A z))).prod *
            algebraMap A K (ef i)) ∧
      ∀ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 →
        (∀ i, ∀ z ∈ Zf i ++ Yf i, ¬ (ρ ∣ z - c ∧ z - c ∣ ρ)) →
        ∃ i, (let P : List ↥W → ↥W := fun X =>
            ((X.filter (fun x => @decide (¬ ρ ∣ x - c) (Classical.propDecidable _))).map
              (fun x => x - c)).prod *
              ρ ^ (X.filter (fun x => @decide (ρ ∣ x - c) (Classical.propDecidable _))).length
          let m : ℤ := (((Zf i).filter (fun x => @decide (ρ ∣ x - c) (Classical.propDecidable _))).length : ℤ) -
            (((Yf i).filter (fun x => @decide (ρ ∣ x - c) (Classical.propDecidable _))).length : ℤ)
          k2 i * P (Yf i) ∣ k1 i * P (Zf i) ∨ ¬ (ℓ : ℤ) ∣ m) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hSolv hUniq hBR hdeg
    α f₀ hα1 hf₀ c hc
  classical

  have hΩ : ((ℓ : ℕ) : Ω) = 0 := by
