      hxLcl hNo hxLN hNsub hNint

  haveI : HenselianLocalRing ↥R := wcpa_dj_lmga_valuation_henselian K R
  have hpb0 : IsPullback f0 (Limits.pullback.snd v c) v
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥R))) :=
    IsPullback.of_hasPullback v c
  obtain ⟨P, p, j0, hpfin, hpet, hpb⟩ :=
    wc_proper_henselian_fet_ext ↥R Y (Limits.pullback v c) v f0 (Limits.pullback.snd v c) hpb0
      P₀ p₀ hp₀fin hp₀et
  haveI := hpet
  haveI := hp₀surj
  have hpj : ∀ w, p (j0 w) = f0 (p₀ w) := by
    intro w
    rw [← Scheme.Hom.comp_apply, hpb.w, Scheme.Hom.comp_apply]

  have hpsurj : Surjective p := by
    refine ⟨fun y => ?_⟩
    have hcl : IsClosed (v '' closure {y}) := v.isClosedMap _ isClosed_closure
    have h1 : v y ⤳ IsLocalRing.closedPoint ↥R := IsLocalRing.specializes_closedPoint (v y)
    obtain ⟨y₀, hy₀cl, hy₀v⟩ := h1.mem_closed hcl ⟨y, subset_closure rfl, rfl⟩
    obtain ⟨c₀, rfl⟩ : y₀ ∈ Set.range f0 := by rw [h0range]; exact hy₀v
    obtain ⟨w, rfl⟩ := p₀.surjective c₀
    have hsp : y ⤳ p (j0 w) := by
