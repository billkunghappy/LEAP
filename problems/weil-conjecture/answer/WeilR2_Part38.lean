    haveI := hfin
    have hU' : IsAffineOpen (U₁.ι ⁻¹ᵁ U) :=
      hU.preimage_of_isOpenImmersion U₁.ι (by rw [Scheme.Opens.opensRange_ι]; exact hle)
    have hUeq : U₁.ι ''ᵁ (U₁.ι ⁻¹ᵁ U) = U := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr hle
    have hpre : IsAffineOpen ((f ∣_ U₁) ⁻¹ᵁ (U₁.ι ⁻¹ᵁ U)) := hU'.preimage _
    have himg := hpre.image_of_isOpenImmersion (f ⁻¹ᵁ U₁).ι
    rw [image_morphismRestrict_preimage, hUeq] at himg
    refine ⟨himg, ?_⟩
    have hfa := IsFinite.finite_app (f ∣_ U₁) _ hU'
    rw [morphismRestrict_app] at hfa
    have abs : ∀ {R : CommRingCat.{u}} {V W : Y.Opens} (e : V = W) (φ : R ⟶ Γ(Y, W)),
        (φ ≫ Y.presheaf.map (eqToHom e).op).hom.Finite → φ.hom.Finite := by
      intro R V W e φ h
      subst e
      simpa using h
    rw [← hUeq]
    exact abs _ _ hfa

  have t_L5 : ∀ (A : Type u) [CommRing A] (Y P : Scheme.{u}) (v : Y ⟶ Spec (.of A)) (sP : P ⟶ Spec (.of A)) (f : Y ⟶ P) (hF : Flat v) (hL : LocallyOfFinitePresentation v) (hT : LocallyOfFiniteType sP) (hf : f ≫ sP = v) (U : P.Opens) (hU : IsAffineOpen U) (hfU : IsAffineOpen (f ⁻¹ᵁ U)), (f.app U).hom.FinitePresentation ∧ ((Y.presheaf.map (homOfLE (le_top : f ⁻¹ᵁ U ≤ ⊤)).op).hom.comp (v.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)).Flat ∧ (f.app U).hom.comp ((P.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp (sP.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) = (Y.presheaf.map (homOfLE (le_top : f ⁻¹ᵁ U ≤ ⊤)).op).hom.comp (v.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom) := by
    intro A _ Y P v sP f hF hL hT hf U hU hfU
    have nat : P.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op ≫ f.app U =
        f.appTop ≫ Y.presheaf.map (homOfLE (le_top : f ⁻¹ᵁ U ≤ ⊤)).op := by
      rw [Scheme.Hom.naturality]; rfl
    have comp' : sP.appTop ≫ P.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op ≫ f.app U =
        v.appTop ≫ Y.presheaf.map (homOfLE (le_top : f ⁻¹ᵁ U ≤ ⊤)).op := by
      rw [nat, ← hf, Scheme.Hom.comp_appTop, Category.assoc]
    have hβflat : RingHom.Flat (v.appLE ⊤ (f ⁻¹ᵁ U) le_top).hom :=
      HasRingHomProperty.appLE @Flat v hF ⟨⊤, isAffineOpen_top _⟩ ⟨f ⁻¹ᵁ U, hfU⟩ le_top
    have hβfp : RingHom.FinitePresentation (v.appLE ⊤ (f ⁻¹ᵁ U) le_top).hom :=
      HasRingHomProperty.appLE @LocallyOfFinitePresentation v hL ⟨⊤, isAffineOpen_top _⟩ ⟨f ⁻¹ᵁ U, hfU⟩ le_top
    have hαft : RingHom.FiniteType (sP.appLE ⊤ U le_top).hom :=
      HasRingHomProperty.appLE @LocallyOfFiniteType sP hT ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ le_top
    have hΓ : RingHom.Flat (Scheme.ΓSpecIso (.of A)).inv.hom :=
      RingHom.Flat.of_bijective (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of A)).inv)
    refine ⟨?_, ?_, ?_⟩
    · refine RingHom.FinitePresentation.of_comp_finiteType (sP.appLE ⊤ U le_top).hom ?_ hαft
      have e : (f.app U).hom.comp (sP.appLE ⊤ U le_top).hom = (v.appLE ⊤ (f ⁻¹ᵁ U) le_top).hom :=
        congrArg CommRingCat.Hom.hom comp'
      rw [e]; exact hβfp
    · have h := RingHom.Flat.comp hΓ hβflat
      exact h
    · exact congrArg CommRingCat.Hom.hom (congrArg (fun φ => (Scheme.ΓSpecIso (.of A)).inv ≫ φ) comp')

  have t_L6b : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Y P : Scheme.{u}) (v : Y ⟶ Spec (.of A))     (sP : P ⟶ Spec (.of A)) (f : Y ⟶ P)     (fκ : Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) ⟶ Limits.pullback sP (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))))     (e₁ : fκ ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ ≫ f) (hκ : IsIso fκ)     (U : P.Opens) (hsurj : Function.Surjective ((Limits.pullback.fst sP (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).app U).hom), (∀ c : Γ(Y, f ⁻¹ᵁ U), ∃ b, c - (f.app U).hom b ∈ RingHom.ker ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).app (f ⁻¹ᵁ U)).hom) ∧ ∀ b, (f.app U).hom b ∈ RingHom.ker ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).app (f ⁻¹ᵁ U)).hom → b ∈ RingHom.ker ((Limits.pullback.fst sP (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).app U).hom := by
    intro A _ _ Y P v sP f fκ e₁ hκ U hsurj
    haveI := hκ
    have h := Scheme.Hom.congr_app e₁ U
    rw [Scheme.Hom.comp_app, Scheme.Hom.comp_app] at h
    have abs : ∀ {V : (Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).Opens}
        (e : V = Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) ⁻¹ᵁ (f ⁻¹ᵁ U))
        (κ : Γ(Limits.pullback sP (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))), Limits.pullback.fst sP (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) ⁻¹ᵁ U) ⟶ Γ(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))), V)) [IsIso κ],
        (Limits.pullback.fst sP (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).app U ≫ κ = (f.app U ≫ (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).app (f ⁻¹ᵁ U)) ≫ (Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).presheaf.map (eqToHom e).op →
        (∀ c : Γ(Y, f ⁻¹ᵁ U), ∃ b, c - (f.app U).hom b ∈ RingHom.ker ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).app (f ⁻¹ᵁ U)).hom) ∧ ∀ b, (f.app U).hom b ∈ RingHom.ker ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).app (f ⁻¹ᵁ U)).hom → b ∈ RingHom.ker ((Limits.pullback.fst sP (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).app U).hom := by
      intro V e κ _ hh
      subst e
      simp only [eqToHom_refl, op_id, CategoryTheory.Functor.map_id, Category.comp_id] at hh
      have hb := ConcreteCategory.bijective_of_isIso κ
      have hsq : ∀ b, κ.hom (((Limits.pullback.fst sP (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).app U).hom b) = ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).app (f ⁻¹ᵁ U)).hom ((f.app U).hom b) := by
        intro b
        have := congrArg (fun φ => CommRingCat.Hom.hom φ b) hh
        simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using this
      constructor
      · intro c
        obtain ⟨d, hd⟩ := hb.2 (((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).app (f ⁻¹ᵁ U)).hom c)
        obtain ⟨b, rfl⟩ := hsurj d
        refine ⟨b, ?_⟩
        rw [RingHom.mem_ker, map_sub, ← hsq]
        exact sub_eq_zero.mpr hd.symm
      · intro b hb'
        rw [RingHom.mem_ker] at hb' ⊢
        apply hb.1
        change κ.hom _ = κ.hom 0
        rw [hsq, hb', map_zero]
    exact abs _ (fκ.app _) h

  have t_L7 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (X : Scheme.{u}) (g : X ⟶ Spec (.of A)) (U : X.Opens) (x : X), x ∈ U → g x = IsLocalRing.closedPoint A → ∀ z : Γ(X, U), z - 1 ∈ Ideal.map ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (IsLocalRing.maximalIdeal A) → x ∈ X.basicOpen z := by
    intro A _ _ X g U x hx hgx z hz
    rw [Scheme.mem_basicOpen X z x hx]
    have key : ∀ a ∈ IsLocalRing.maximalIdeal A,
        (X.presheaf.germ U x hx).hom ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
          (g.appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a))) ∈
          IsLocalRing.maximalIdeal (X.presheaf.stalk x) := by
      intro a ha
      rw [TopCat.Presheaf.germ_res_apply]
      have h1 : (X.presheaf.germ ⊤ x trivial).hom (g.appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a)) =
          (g.stalkMap x).hom (((Spec (.of A)).presheaf.germ ⊤ (g x) trivial).hom
            ((Scheme.ΓSpecIso (.of A)).inv.hom a)) :=
        (Scheme.Hom.germ_stalkMap_apply g ⊤ x trivial _).symm
      rw [h1, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have hu2 := isUnit_of_map_unit (g.stalkMap x).hom _ hu
      have hmem : g x ∈ (Spec (.of A)).basicOpen ((Scheme.ΓSpecIso (.of A)).inv.hom a) := by
        rw [Scheme.mem_basicOpen (Spec (.of A)) ((Scheme.ΓSpecIso (.of A)).inv.hom a) (g x) trivial]
        exact hu2
      rw [basicOpen_eq_of_affine, hgx] at hmem
      exact (PrimeSpectrum.mem_basicOpen _ _).mp hmem ha
    have hle : Ideal.map (X.presheaf.germ U x hx).hom (Ideal.map ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (IsLocalRing.maximalIdeal A)) ≤ IsLocalRing.maximalIdeal (X.presheaf.stalk x) := by
      rw [Ideal.map_map, Ideal.map_le_iff_le_comap]
      intro a ha
      exact key a ha
    have hm : (X.presheaf.germ U x hx).hom (z - 1) ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) :=
      hle (Ideal.mem_map_of_mem _ hz)
    have hu := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _
      ((IsLocalRing.mem_maximalIdeal _).mp (neg_mem hm))
    have e : (X.presheaf.germ U x hx).hom z = 1 - -((X.presheaf.germ U x hx).hom (z - 1)) := by
      rw [map_sub, map_one]; ring
    rw [e]; exact hu

  have t_L8a : ∀ (B C : Type u) [CommRing B] [CommRing C] (φ : B →+* C), φ.Finite → ∀ J : Ideal B, (∀ c : C, ∃ b : B, c - φ b ∈ J.map φ) → ∃ g : B, g - 1 ∈ J ∧ ∀ c : C, ∃ b : B, φ g * c = φ b := by
    intro B C _ _ φ hφ J hJ
    letI : Algebra B C := φ.toAlgebra
    haveI : Module.Finite B C := hφ
    let R := LinearMap.range (Algebra.linearMap B C)
    have key : ∀ z ∈ J.map φ, R.mkQ z ∈ J • (⊤ : Submodule B (C ⧸ R)) := by
      intro z hz
      have hz' : z ∈ J • (⊤ : Submodule B C) := by
        rw [Ideal.smul_top_eq_map]; exact hz
      have h2 : R.mkQ z ∈ Submodule.map R.mkQ (J • (⊤ : Submodule B C)) :=
        Submodule.mem_map_of_mem hz'
      rw [Submodule.map_smul''] at h2
      exact Submodule.smul_mono (le_refl J) le_top h2
    have hfg : (⊤ : Submodule B (C ⧸ R)).FG := Module.Finite.fg_top
    have hle : (⊤ : Submodule B (C ⧸ R)) ≤ J • ⊤ := by
      rintro x -
      obtain ⟨c, rfl⟩ := R.mkQ_surjective x
      obtain ⟨b, hb⟩ := hJ c
      have h1 : R.mkQ c = R.mkQ (c - φ b) := by
        rw [map_sub]
        have h3 : R.mkQ (φ b) = 0 := by
          rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]; exact ⟨b, rfl⟩
        rw [h3, sub_zero]
      rw [h1]; exact key _ hb
    obtain ⟨r, hr1, hr⟩ :=
      Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul J _ hfg hle
    refine ⟨r, hr1, fun c => ?_⟩
    have h := hr (R.mkQ c) trivial
    rw [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h
    obtain ⟨b, hb⟩ := h
    exact ⟨b, (hb.trans (Algebra.smul_def r c)).symm⟩

  have t_L8b : ∀ (A B C : Type u) [CommRing A] [CommRing B] [CommRing C] (α : A →+* B) (ψ : B →+* C), Function.Surjective ψ → ψ.FinitePresentation → (ψ.comp α).Flat → ∀ I : Ideal A, (∀ b : B, ψ b = 0 → b ∈ I.map α) → ∃ h : B, h - 1 ∈ I.map α ∧ ∀ b : B, ψ b = 0 → h * b = 0 := by
    intro A B C _ _ _ α ψ hsurj hfp hflat I hker

    have hKfg : (RingHom.ker ψ).FG := by
      letI : Algebra B C := ψ.toAlgebra
      haveI : Algebra.FinitePresentation B C := hfp
      exact Algebra.FinitePresentation.ker_fG_of_surjective (R := B) (A := B) (B := C)
        (Algebra.ofId B C) hsurj

    have hle : RingHom.ker ψ ≤ (I.map α) • RingHom.ker ψ := by
      intro k hk
      have hk0 : ψ k = 0 := RingHom.mem_ker.mp hk
      have hkI : k ∈ Ideal.span (⇑α '' (I : Set A)) := hker k hk0
      obtain ⟨n, b, g, hkg⟩ := Submodule.mem_span_set'.mp hkI
      choose a ha hga using fun i => (g i).2
      letI : Algebra A C := (ψ.comp α).toAlgebra
      haveI : Module.Flat A C := hflat
      have h0 : ∑ i, a i • ψ (b i) = 0 := by
        have h1 : ψ k = 0 := hk0
        rw [← hkg, map_sum] at h1
        rw [← h1]
        apply Finset.sum_congr rfl
        intro i _
        rw [Algebra.smul_def, smul_eq_mul, map_mul, ← hga i, mul_comm]
        rfl
      obtain ⟨m, c, y, hc1, hc2⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
        (R := A) (M := C) (ι := Fin n) (f := a) (x := fun i => ψ (b i)) h0
      choose z hz using fun j => hsurj (y j)
      let kk : Fin n → B := fun i => b i - ∑ j, α (c i j) * z j
      have hkk : ∀ i, ψ (kk i) = 0 := by
        intro i
        have hc1' : ψ (b i) = ∑ j, c i j • y j := hc1 i
        simp only [kk, map_sub, map_sum, map_mul]
        rw [hc1', sub_eq_zero]
        apply Finset.sum_congr rfl
        intro j _
        rw [Algebra.smul_def, hz j]
        rfl
      have hsum2 : ∑ i, ∑ j, α (a i) * (α (c i j) * z j) = 0 := by
        rw [Finset.sum_comm]
        apply Finset.sum_eq_zero
        intro j _
        have h3 : ∑ i, α (a i) * (α (c i j) * z j) = α (∑ i, a i * c i j) * z j := by
          rw [map_sum, Finset.sum_mul]
          apply Finset.sum_congr rfl
          intro i _
          rw [map_mul]
          ring
        rw [h3, hc2 j, map_zero, zero_mul]
      have hkeq : k = ∑ i, α (a i) * kk i := by
        have h4 : ∑ i, α (a i) * kk i =
            ∑ i, α (a i) * b i - ∑ i, ∑ j, α (a i) * (α (c i j) * z j) := by
          rw [← Finset.sum_sub_distrib]
          apply Finset.sum_congr rfl
          intro i _
          simp only [kk, mul_sub, Finset.mul_sum]
        rw [h4, hsum2, sub_zero, ← hkg]
        apply Finset.sum_congr rfl
        intro i _
        rw [smul_eq_mul, ← hga i, mul_comm]
      rw [hkeq]
      refine Submodule.sum_mem _ (fun i _ => ?_)
      have h5 : α (a i) * kk i = α (a i) • kk i := (smul_eq_mul _ _).symm
      rw [h5]
      exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem α (ha i)) (RingHom.mem_ker.mpr (hkk i))

    obtain ⟨r, hr1, hr⟩ :=
      Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul (I.map α) _ hKfg hle
    exact ⟨r, hr1, fun b hb => hr b (RingHom.mem_ker.mpr hb)⟩

  have t_L9 : ∀ {Y P : Scheme.{u}} (f : Y ⟶ P) (U : P.Opens), IsAffineOpen U → IsAffineOpen (f ⁻¹ᵁ U) → ∀ g : Γ(P, U), (∀ c : Γ(Y, f ⁻¹ᵁ U), ∃ (b : Γ(P, U)) (n : ℕ), (f.app U).hom g ^ n * c = (f.app U).hom b) → (∀ b : Γ(P, U), (f.app U).hom b = 0 → ∃ n : ℕ, g ^ n * b = 0) → IsIso (f ∣_ P.basicOpen g) := by
    intro Y P f U hU hfU g hg hk
    have hpre : f ⁻¹ᵁ P.basicOpen g = Y.basicOpen ((f.app U).hom g) := Scheme.preimage_basicOpen f g
    have hle : f ⁻¹ᵁ P.basicOpen g ≤ f ⁻¹ᵁ U := f.preimage_mono (P.basicOpen_le g)
    have hfD : IsAffineOpen (f ⁻¹ᵁ P.basicOpen g) := by rw [hpre]; exact hfU.basicOpen _
    letI : Algebra Γ(Y, f ⁻¹ᵁ U) Γ(Y, f ⁻¹ᵁ P.basicOpen g) :=
      (Y.presheaf.map (homOfLE hle).op).hom.toAlgebra
    haveI : IsLocalization.Away ((f.app U).hom g) Γ(Y, f ⁻¹ᵁ P.basicOpen g) :=
      hfU.isLocalization_of_eq_basicOpen _ (homOfLE hle) hpre
    letI : Algebra Γ(P, U) Γ(P, P.basicOpen g) :=
      (P.presheaf.map (homOfLE (P.basicOpen_le g)).op).hom.toAlgebra
    haveI : IsLocalization.Away g Γ(P, P.basicOpen g) :=
      hU.isLocalization_of_eq_basicOpen _ (homOfLE (P.basicOpen_le g)) rfl
    have nat : ∀ b : Γ(P, U), (f.app (P.basicOpen g)).hom
        ((P.presheaf.map (homOfLE (P.basicOpen_le g)).op).hom b) =
        (Y.presheaf.map (homOfLE hle).op).hom ((f.app U).hom b) := by
      intro b
      have := congrArg (fun φ => CommRingCat.Hom.hom φ b)
        (Scheme.Hom.naturality f (homOfLE (P.basicOpen_le g)).op)
      exact this
    have hGu : IsUnit ((P.presheaf.map (homOfLE (P.basicOpen_le g)).op).hom g) :=
      IsLocalization.Away.algebraMap_isUnit g
    have hu : (P.presheaf.map (homOfLE (P.basicOpen_le g)).op).hom g * ↑(hGu.unit⁻¹) = 1 :=
      hGu.mul_val_inv
    have e1 : (Y.presheaf.map (homOfLE hle).op).hom ((f.app U).hom g) *
        (f.app (P.basicOpen g)).hom ↑(hGu.unit⁻¹) = 1 := by
      rw [← nat, ← map_mul, hu, map_one]
    have hsurj : Function.Surjective (f.app (P.basicOpen g)).hom := by
      intro c
      obtain ⟨⟨x, m⟩, hxm⟩ := IsLocalization.surj (Submonoid.powers ((f.app U).hom g)) c
      obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp m.2
      obtain ⟨b, k, hb⟩ := hg x
      have hxm' : c * (Y.presheaf.map (homOfLE hle).op).hom ((f.app U).hom g) ^ n =
          (Y.presheaf.map (homOfLE hle).op).hom x := by
        have h1 : algebraMap Γ(Y, f ⁻¹ᵁ U) Γ(Y, f ⁻¹ᵁ P.basicOpen g) (m : Γ(Y, f ⁻¹ᵁ U)) =
            (Y.presheaf.map (homOfLE hle).op).hom ((f.app U).hom g) ^ n := by
          rw [← hn, map_pow]; rfl
        rw [← h1]; exact hxm
      refine ⟨(P.presheaf.map (homOfLE (P.basicOpen_le g)).op).hom b *
        ↑(hGu.unit⁻¹) ^ (k + n), ?_⟩
      rw [map_mul, map_pow, nat, ← hb, map_mul, map_pow, ← hxm']
      calc (Y.presheaf.map (homOfLE hle).op).hom ((f.app U).hom g) ^ k *
            (c * (Y.presheaf.map (homOfLE hle).op).hom ((f.app U).hom g) ^ n) *
            (f.app (P.basicOpen g)).hom ↑(hGu.unit⁻¹) ^ (k + n)
          = c * ((Y.presheaf.map (homOfLE hle).op).hom ((f.app U).hom g) *
            (f.app (P.basicOpen g)).hom ↑(hGu.unit⁻¹)) ^ (k + n) := by ring
        _ = c := by rw [e1, one_pow, mul_one]
    have hinj : Function.Injective (f.app (P.basicOpen g)).hom := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨x, m⟩, hxm⟩ := IsLocalization.surj (Submonoid.powers g) z
      obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp m.2
      have hxm' : z * (P.presheaf.map (homOfLE (P.basicOpen_le g)).op).hom g ^ n =
          (P.presheaf.map (homOfLE (P.basicOpen_le g)).op).hom x := by
        have h1 : algebraMap Γ(P, U) Γ(P, P.basicOpen g) (m : Γ(P, U)) =
            (P.presheaf.map (homOfLE (P.basicOpen_le g)).op).hom g ^ n := by
