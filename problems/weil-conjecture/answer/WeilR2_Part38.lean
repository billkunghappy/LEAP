theorem wcpa_dj_lus_cvs_ct_ns_qg_ring_torsor : ∀ (R : Type u) [CommRing R] (c : R), IsUnit (1 - 4 * c) → ∀ (σ : ZMod 2 → (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.X + Polynomial.C c) →ₐ[R] AdjoinRoot (Polynomial.X ^ 2 - Polynomial.X + Polynomial.C c))), σ 0 = AlgHom.id R _ → σ 1 (AdjoinRoot.root _) = 1 - AdjoinRoot.root _ → wcFetTorsor (Spec.map (CommRingCat.ofHom (AdjoinRoot.of (Polynomial.X ^ 2 - Polynomial.X + Polynomial.C c)))) 2 (fun e => Spec.map (CommRingCat.ofHom (σ e).toRingHom)) :=
by
  intro R _ c hunit
  classical

  have hfet : ∀ (R B : Type u) [CommRing R] [CommRing B] [Algebra R B] (m : ℕ)
      [NeZero m] (σ : ZMod m → (B →ₐ[R] B)), Algebra.Etale R B → Module.Finite R B →
      Function.Surjective (PrimeSpectrum.comap (algebraMap R B)) → σ 0 = AlgHom.id R B →
      (∀ c c', σ (c + c') = (σ c).comp (σ c')) → Function.Bijective (wcTorDescMu R B m σ) →
      wcFetTorsor (Spec.map (CommRingCat.ofHom (algebraMap R B))) m
        (fun c => Spec.map (CommRingCat.ofHom (σ c).toRingHom)) := by
    intro R B _ _ _ m _ σ het hfin hsurj h0 hadd hmu
    have hact : ∀ c, Spec.map (CommRingCat.ofHom (σ c).toRingHom) ≫
        Spec.map (CommRingCat.ofHom (algebraMap R B)) =
        Spec.map (CommRingCat.ofHom (algebraMap R B)) := by
      intro c
      rw [← Spec.map_comp]
      congr 1
      ext x
      exact (σ c).commutes x
    let e : TensorProduct R B B ≃+* (ZMod m → B) := RingEquiv.ofBijective (wcTorDescMu R B m σ) hmu
    haveI hMiso : IsIso (CommRingCat.ofHom (wcTorDescMu R B m σ).toRingHom) :=
      ⟨⟨CommRingCat.ofHom e.symm.toRingHom,
        by apply CommRingCat.hom_ext; apply RingHom.ext; intro x; exact e.symm_apply_apply x,
        by apply CommRingCat.hom_ext; apply RingHom.ext; intro y; exact e.apply_symm_apply y⟩⟩
    let ρ : (ZMod m → B) ≃+* (ULift.{u} (ZMod m) → B) :=
      { toFun := fun f i => f i.down
        invFun := fun g c => g ⟨c⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl }
    haveI hρiso : IsIso (CommRingCat.ofHom ρ.toRingHom) :=
      ⟨⟨CommRingCat.ofHom ρ.symm.toRingHom,
        by apply CommRingCat.hom_ext; apply RingHom.ext; intro x; exact ρ.symm_apply_apply x,
        by apply CommRingCat.hom_ext; apply RingHom.ext; intro y; exact ρ.apply_symm_apply y⟩⟩
    have hjfac : ∀ c : ZMod m,
        Spec.map (CommRingCat.ofHom (Pi.evalRingHom (fun _ : ZMod m => B) c)) =
        Limits.Sigma.ι (fun _ : ULift.{u} (ZMod m) => Spec (CommRingCat.of B)) (ULift.up c) ≫
          sigmaSpec (fun _ : ULift.{u} (ZMod m) => CommRingCat.of B) ≫
          Spec.map (CommRingCat.ofHom ρ.toRingHom) := by
      intro c
      rw [← Category.assoc, ι_sigmaSpec, ← Spec.map_comp]
      rfl
    have hgraph0 : ∀ c (h : Spec.map (CommRingCat.ofHom (σ c).toRingHom) ≫
        Spec.map (CommRingCat.ofHom (algebraMap R B)) =
        𝟙 (Spec (CommRingCat.of B)) ≫ Spec.map (CommRingCat.ofHom (algebraMap R B))),
        Limits.pullback.lift (Spec.map (CommRingCat.ofHom (σ c).toRingHom))
          (𝟙 (Spec (CommRingCat.of B))) h =
        Spec.map (CommRingCat.ofHom (Pi.evalRingHom (fun _ : ZMod m => B) c)) ≫
          (Spec.map (CommRingCat.ofHom (wcTorDescMu R B m σ).toRingHom) ≫
            (pullbackSpecIso R B B).inv) := by
      intro c h
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Category.assoc, Category.assoc, pullbackSpecIso_inv_fst,
          ← Spec.map_comp, ← Spec.map_comp]
        congr 1
        ext x
        simp [wcTorDescMu]
      · rw [Limits.pullback.lift_snd, Category.assoc, Category.assoc, pullbackSpecIso_inv_snd,
          ← Spec.map_comp, ← Spec.map_comp, ← Spec.map_id (CommRingCat.of B)]
        congr 1
        ext x
        simp [wcTorDescMu]
    obtain ⟨j, hjdef⟩ : ∃ j : ZMod m → (Spec (CommRingCat.of B) ⟶
        Spec (CommRingCat.of (ZMod m → B))),
        ∀ c, j c = Spec.map (CommRingCat.ofHom (Pi.evalRingHom (fun _ : ZMod m => B) c)) :=
      ⟨_, fun _ => rfl⟩
    obtain ⟨Φ, hΦdef⟩ : ∃ Φ : Spec (CommRingCat.of (ZMod m → B)) ⟶
        Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap R B)))
          (Spec.map (CommRingCat.ofHom (algebraMap R B))),
        Φ = Spec.map (CommRingCat.ofHom (wcTorDescMu R B m σ).toRingHom) ≫
          (pullbackSpecIso R B B).inv := ⟨_, rfl⟩
    have hgraph : ∀ c (h : Spec.map (CommRingCat.ofHom (σ c).toRingHom) ≫
        Spec.map (CommRingCat.ofHom (algebraMap R B)) =
        𝟙 (Spec (CommRingCat.of B)) ≫ Spec.map (CommRingCat.ofHom (algebraMap R B))),
        Limits.pullback.lift (Spec.map (CommRingCat.ofHom (σ c).toRingHom))
          (𝟙 (Spec (CommRingCat.of B))) h = j c ≫ Φ := by
      intro c h
      rw [hjdef, hΦdef]
      exact hgraph0 c h
    haveI hΦiso : IsIso Φ := by rw [hΦdef]; infer_instance
    have hjopen : ∀ c, IsOpenImmersion (j c) := by
      intro c
      rw [hjdef, hjfac c]
      infer_instance
    have hjpt : ∀ c x, j c x = PrimeSpectrum.sigmaToPi (fun _ : ZMod m => B) ⟨c, x⟩ := by
      intro c x
      rw [hjdef]
      rfl
    have hΦinj : Function.Injective Φ := by
      intro a b hab
      apply (Scheme.Hom.homeomorph Φ).injective
      rw [Scheme.Hom.homeomorph_apply, Scheme.Hom.homeomorph_apply]
      exact hab
    have hΦsurj : Function.Surjective Φ := by
      intro z
      obtain ⟨w, hw⟩ := (Scheme.Hom.homeomorph Φ).surjective z
      exact ⟨w, by rw [← Scheme.Hom.homeomorph_apply]; exact hw⟩
    have hbij := PrimeSpectrum.sigmaToPi_bijective (fun _ : ZMod m => B)
    refine ⟨?_, ?_, ?_, hact, ?_, ?_, ?_, ?_, ?_⟩
    · rw [IsFinite.SpecMap_iff]
      exact RingHom.finite_algebraMap.mpr hfin
    · rw [HasRingHomProperty.Spec_iff (P := @Etale)]
      exact RingHom.etale_algebraMap.mpr het
    · exact Set.range_eq_univ.mpr fun x => hsurj x
    · show Spec.map (CommRingCat.ofHom (σ 0).toRingHom) = 𝟙 _
      rw [h0]
      exact Spec.map_id _
    · intro c c'
      show Spec.map (CommRingCat.ofHom (σ (c + c')).toRingHom) =
        Spec.map (CommRingCat.ofHom (σ c').toRingHom) ≫ Spec.map (CommRingCat.ofHom (σ c).toRingHom)
      rw [← Spec.map_comp, add_comm, hadd]
      rfl
    · intro c
      rw [hgraph]
      haveI := hjopen c
      infer_instance
    · intro c c' hcc'
      show Disjoint _ _
      rw [hgraph, hgraph, Set.disjoint_left]
      rintro _ ⟨x, rfl⟩ ⟨y, hy⟩
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hy
      have h1 := hΦinj hy
      rw [hjpt, hjpt] at h1
      have h2 := congrArg Sigma.fst (hbij.1 h1)
      exact hcc' h2.symm
    · rw [Set.eq_univ_iff_forall]
      intro z
      obtain ⟨w, rfl⟩ := hΦsurj z
      obtain ⟨⟨c, x⟩, hx⟩ := hbij.2 w
      refine Set.mem_iUnion.mpr ⟨c, x, ?_⟩
      rw [hgraph]
      show Φ (j c x) = Φ w
      exact congrArg Φ ((hjpt c x).trans hx)
  generalize hf : Polynomial.X ^ 2 - Polynomial.X + Polynomial.C c = f
  intro σ hσ0 hσ1
  have hZ2 : ∀ e : ZMod 2, e = 0 ∨ e = 1 := by decide
  obtain ⟨v, hv⟩ := hunit.exists_left_inv

  have hfm : f.Monic := by
    rw [← hf]
    rcases subsingleton_or_nontrivial R with hR | hR
    · exact Polynomial.monic_of_subsingleton _
    · have e : (Polynomial.X ^ 2 - Polynomial.X + Polynomial.C c : Polynomial R) =
          Polynomial.X ^ 2 + (Polynomial.C c - Polynomial.X) := by ring
      rw [e]
      apply (Polynomial.monic_X_pow 2).add_of_left
      rw [Polynomial.degree_X_pow]
      refine lt_of_le_of_lt (Polynomial.degree_sub_le _ _) (max_lt ?_ ?_)
      · exact lt_of_le_of_lt Polynomial.degree_C_le (by exact_mod_cast (by norm_num : (0 : ℕ) < 2))
      · rw [Polynomial.degree_X]; exact_mod_cast (by norm_num : (1 : ℕ) < 2)

  have het : Algebra.Etale R (AdjoinRoot f) := by
    have hcert : ∃ (p₁ p₂ : Polynomial R) (n : ℕ),
        Polynomial.derivative f * p₁ + f * p₂ = (1 : Polynomial R) ^ n := by
      refine ⟨Polynomial.C v * (2 * Polynomial.X - 1), -(4 * Polynomial.C v), 1, ?_⟩
      have hv' : Polynomial.C v * (1 - 4 * Polynomial.C c) = 1 := by
        have h1 := congrArg Polynomial.C hv
        rw [map_mul, map_sub, map_mul, map_one, map_ofNat] at h1
        exact h1
      have hd : Polynomial.derivative f = 2 * Polynomial.X - 1 := by
        rw [← hf, Polynomial.derivative_add, Polynomial.derivative_sub, Polynomial.derivative_X_pow,
          Polynomial.derivative_X, Polynomial.derivative_C]
        simp only [Nat.cast_ofNat, map_ofNat]
        ring
      rw [hd, ← hf, pow_one]
      linear_combination hv'
    let P : StandardEtalePair R := ⟨f, hfm, 1, hcert⟩
    have e₂ : AdjoinRoot f ≃ₐ[R] Localization.Away ((AdjoinRoot.mk f) 1) :=
      (IsLocalization.atUnit (AdjoinRoot f) (Localization.Away ((AdjoinRoot.mk f) 1))
        ((AdjoinRoot.mk f) 1) (by simp)).restrictScalars R
    have e : P.Ring ≃ₐ[R] AdjoinRoot f := P.equivAwayAdjoinRoot.trans e₂.symm
    exact Algebra.Etale.of_equiv e
  have hfin : Module.Finite R (AdjoinRoot f) := (AdjoinRoot.powerBasis' hfm).finite
  have hsurj : Function.Surjective (PrimeSpectrum.comap (algebraMap R (AdjoinRoot f))) := by
    rcases subsingleton_or_nontrivial R with hR | hR
    · have : IsEmpty (PrimeSpectrum R) := PrimeSpectrum.isEmpty_iff_subsingleton.mpr hR
      intro x
      exact isEmptyElim x
    · have : Module.Free R (AdjoinRoot f) := hfm.free_adjoinRoot
      have hdim : 0 < (AdjoinRoot.powerBasis' hfm).dim := by
        rw [AdjoinRoot.powerBasis'_dim, ← hf]
        have h2 : (Polynomial.X ^ 2 - Polynomial.X + Polynomial.C c : Polynomial R).natDegree = 2 := by
          rw [Polynomial.natDegree_add_C, Polynomial.natDegree_sub_eq_left_of_natDegree_lt]
          · exact Polynomial.natDegree_X_pow 2
          · rw [Polynomial.natDegree_X, Polynomial.natDegree_X_pow]; norm_num
        rw [h2]; norm_num
      have : Nontrivial (AdjoinRoot f) :=
        nontrivial_of_ne _ _ ((AdjoinRoot.powerBasis' hfm).basis.ne_zero ⟨0, hdim⟩)
      exact PrimeSpectrum.comap_surjective_of_faithfullyFlat

  have hadd : ∀ a b, σ (a + b) = (σ a).comp (σ b) := by
    intro a b
    rcases hZ2 a with rfl | rfl <;> rcases hZ2 b with rfl | rfl
    · rw [add_zero, hσ0]
      all_goals exact (AlgHom.id_comp _).symm
    · rw [zero_add, hσ0]
      all_goals exact (AlgHom.id_comp _).symm
    · rw [add_zero, hσ0]
      all_goals exact (AlgHom.comp_id _).symm
    · have h11 : (1 : ZMod 2) + 1 = 0 := by decide
      rw [h11, hσ0]
      apply AdjoinRoot.algHom_ext
      rw [AlgHom.id_apply, AlgHom.comp_apply, hσ1, map_sub, map_one, hσ1]
      ring

  have hrepr : ∀ x : AdjoinRoot f, ∃ b : ℕ → R,
      x = ∑ k ∈ Finset.range 2, b k • (AdjoinRoot.root f) ^ k := by
    intro x
    have hd : (AdjoinRoot.powerBasis' hfm).dim ≤ 2 := by
      rw [AdjoinRoot.powerBasis'_dim, ← hf]
      exact (Polynomial.natDegree_add_le _ _).trans (max_le ((Polynomial.natDegree_sub_le _ _).trans
        (max_le (Polynomial.natDegree_X_pow_le _) (Polynomial.natDegree_X_le.trans (by norm_num))))
        (by rw [Polynomial.natDegree_C]; exact Nat.zero_le _))
    refine ⟨fun k => if h : k < (AdjoinRoot.powerBasis' hfm).dim then
      (AdjoinRoot.powerBasis' hfm).basis.repr x ⟨k, h⟩ else 0, ?_⟩
    calc x = ∑ i : Fin (AdjoinRoot.powerBasis' hfm).dim,
          (AdjoinRoot.powerBasis' hfm).basis.repr x i • (AdjoinRoot.root f) ^ (i : ℕ) := by
          conv_lhs => rw [← (AdjoinRoot.powerBasis' hfm).basis.sum_repr x]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [PowerBasis.coe_basis, AdjoinRoot.powerBasis'_gen]
      _ = ∑ k ∈ Finset.range (AdjoinRoot.powerBasis' hfm).dim,
          (if h : k < (AdjoinRoot.powerBasis' hfm).dim then
            (AdjoinRoot.powerBasis' hfm).basis.repr x ⟨k, h⟩ else 0) • (AdjoinRoot.root f) ^ k := by
          rw [← Fin.sum_univ_eq_sum_range]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          simp only [dif_pos i.isLt, Fin.eta]
      _ = _ := by
          apply Finset.sum_subset
          · intro k hk
            exact Finset.mem_range.mpr (lt_of_lt_of_le (Finset.mem_range.mp hk) hd)
          · intro k _ hk
            rw [dif_neg (fun h => hk (Finset.mem_range.mpr h)), zero_smul]
  have hroot0 : Polynomial.aeval (AdjoinRoot.root f) f = 0 := by
    rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
  have hroot1 : Polynomial.aeval (AdjoinRoot.root f)
      (Polynomial.X ^ 2 - Polynomial.X + Polynomial.C c : Polynomial R) = 0 := by
    rw [hf]; exact hroot0
  rw [map_add, map_sub, Polynomial.aeval_X_pow, Polynomial.aeval_X, Polynomial.aeval_C] at hroot1
  obtain ⟨r, hr⟩ : ∃ r, r = AdjoinRoot.root f := ⟨_, rfl⟩
  rw [← hr] at hroot1 hσ1 hrepr
  have hvB : algebraMap R (AdjoinRoot f) v * (1 - 4 * algebraMap R (AdjoinRoot f) c) = 1 := by
    have h1 := congrArg (algebraMap R (AdjoinRoot f)) hv
    rw [map_mul, map_sub, map_mul, map_one, map_ofNat] at h1
    exact h1
  obtain ⟨w, hw⟩ : ∃ w : AdjoinRoot f, w * (2 * r - 1) = 1 :=
    ⟨algebraMap R (AdjoinRoot f) v * (2 * r - 1), by
      linear_combination (algebraMap R (AdjoinRoot f) v) * 4 * hroot1 + hvB⟩
  have hσ0' : ∀ x, σ 0 x = x := by intro x; rw [hσ0]; rfl
  have hμt : ∀ (e : ZMod 2) (x y : AdjoinRoot f),
      wcTorDescMu R (AdjoinRoot f) 2 σ (x ⊗ₜ[R] y) e = σ e x * y := by
    intro e x y
    simp only [wcTorDescMu, AlgHom.pi_apply, Algebra.TensorProduct.lift_tmul, AlgHom.id_apply]
  have hspan : ∀ z : TensorProduct R (AdjoinRoot f) (AdjoinRoot f), ∃ y0 y1 : AdjoinRoot f,
      z = (1 : AdjoinRoot f) ⊗ₜ[R] y0 + r ⊗ₜ[R] y1 := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, 0, by simp⟩
    | tmul x y =>
      obtain ⟨b, hb⟩ := hrepr x
      refine ⟨b 0 • y, b 1 • y, ?_⟩
      rw [hb, Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_zero, zero_add,
        pow_zero, pow_one, TensorProduct.add_tmul, TensorProduct.smul_tmul, TensorProduct.smul_tmul]
    | add z1 z2 h1 h2 =>
      obtain ⟨a0, a1, rfl⟩ := h1
      obtain ⟨b0, b1, rfl⟩ := h2
      refine ⟨a0 + b0, a1 + b1, ?_⟩
      rw [TensorProduct.tmul_add, TensorProduct.tmul_add]
      abel
  obtain ⟨ν, hν⟩ : ∃ ν : (ZMod 2 → AdjoinRoot f) → TensorProduct R (AdjoinRoot f) (AdjoinRoot f),
      ∀ F, ν F = (1 : AdjoinRoot f) ⊗ₜ[R] (F 0 - r * w * (F 0 - F 1)) + r ⊗ₜ[R] (w * (F 0 - F 1)) :=
    ⟨_, fun _ => rfl⟩
  have hright : ∀ F, wcTorDescMu R (AdjoinRoot f) 2 σ (ν F) = F := by
    intro F
    funext e
    rw [hν]
    rcases hZ2 e with rfl | rfl
    · rw [map_add, Pi.add_apply, hμt, hμt, hσ0', hσ0']
      ring
    · rw [map_add, Pi.add_apply, hμt, hμt, map_one, hσ1]
      linear_combination (-(F 0 - F 1)) * hw
  have hleft : ∀ z, ν (wcTorDescMu R (AdjoinRoot f) 2 σ z) = z := by
    intro z
    obtain ⟨y0, y1, rfl⟩ := hspan z
    have h0 : wcTorDescMu R (AdjoinRoot f) 2 σ ((1 : AdjoinRoot f) ⊗ₜ[R] y0 + r ⊗ₜ[R] y1) 0 =
        y0 + r * y1 := by
      rw [map_add, Pi.add_apply, hμt, hμt, hσ0', hσ0', one_mul]
    have h1 : wcTorDescMu R (AdjoinRoot f) 2 σ ((1 : AdjoinRoot f) ⊗ₜ[R] y0 + r ⊗ₜ[R] y1) 1 =
        y0 + (1 - r) * y1 := by
      rw [map_add, Pi.add_apply, hμt, hμt, map_one, hσ1, one_mul]
    rw [hν, h0, h1]
    have e1 : w * (y0 + r * y1 - (y0 + (1 - r) * y1)) = y1 := by
      linear_combination y1 * hw
    have e2 : y0 + r * y1 - r * w * (y0 + r * y1 - (y0 + (1 - r) * y1)) = y0 := by
      linear_combination (-(r * y1)) * hw
    rw [e1, e2]
  have hbij : Function.Bijective (wcTorDescMu R (AdjoinRoot f) 2 σ) :=
    Function.bijective_iff_has_inverse.mpr ⟨ν, hleft, hright⟩
  have h := hfet R (AdjoinRoot f) 2 σ het hfin hsurj hσ0 hadd hbij
  rw [AdjoinRoot.algebraMap_eq] at h
  exact h

theorem wcpa_dj_lus_cvs_ct_ns_qg_basechange_explicit : ∀ {Y Y' P : Scheme.{u}} (p : P ⟶ Y) (h : Y' ⟶ Y) (m : ℕ) (a : ZMod m → (P ⟶ P)), wcFetTorsor p m a → ∀ (a' : ZMod m → (Limits.pullback p h ⟶ Limits.pullback p h)), (∀ c, a' c ≫ Limits.pullback.fst p h = Limits.pullback.fst p h ≫ a c) → (∀ c, a' c ≫ Limits.pullback.snd p h = Limits.pullback.snd p h) → wcFetTorsor (Limits.pullback.snd p h) m a' :=
by
  intro Y Y' P p h m a tor a' A1 A2
  classical
  haveI := tor.finite
  haveI := tor.etale
  let f := Limits.pullback.fst p h
  let q := Limits.pullback.snd p h
  haveI hqe : Etale q := inferInstanceAs (Etale (Limits.pullback.snd p h))
  have hC : f ≫ p = q ≫ h := Limits.pullback.condition
  have A1 : ∀ c, a' c ≫ f = f ≫ a c := A1
  have A2 : ∀ c, a' c ≫ q = q := A2

  have act_zero : a' 0 = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [A1, tor.act_zero, Category.comp_id, Category.id_comp]
    · rw [A2, Category.id_comp]
  have act_add : ∀ c c', a' (c + c') = a' c' ≫ a' c := by
    intro c c'
    apply Limits.pullback.hom_ext
    · have A1' : ∀ (d : ZMod m) {Z : Scheme.{u}} (g : P ⟶ Z), a' d ≫ f ≫ g = f ≫ a d ≫ g := by
        intro d Z g
        rw [← Category.assoc, A1, Category.assoc]
      change a' (c + c') ≫ f = a' c' ≫ a' c ≫ f
      rw [A1, tor.act_add]
      simp only [Category.assoc, A1, A1']
    · change a' (c + c') ≫ q = a' c' ≫ a' c ≫ q
      rw [A2, A2, A2]

  have hsurj : Set.range (Limits.pullback.snd p h) = Set.univ := by
    rw [Scheme.Pullback.range_snd, tor.surj, Set.preimage_univ]

  let G' : ZMod m → (Limits.pullback p h ⟶ Limits.pullback q q) := fun c =>
    Limits.pullback.lift (a' c) (𝟙 _) ((A2 c).trans (Category.id_comp _).symm)
  have G'1 : ∀ c, G' c ≫ Limits.pullback.fst q q = a' c := fun c => Limits.pullback.lift_fst _ _ _
  have G'2 : ∀ c, G' c ≫ Limits.pullback.snd q q = 𝟙 _ := fun c => Limits.pullback.lift_snd _ _ _
  let G : ZMod m → (P ⟶ Limits.pullback p p) := fun c =>
    Limits.pullback.lift (a c) (𝟙 P) ((tor.act_p c).trans (Category.id_comp p).symm)
  have G1 : ∀ c, G c ≫ Limits.pullback.fst p p = a c := fun c => Limits.pullback.lift_fst _ _ _
  have G2 : ∀ c, G c ≫ Limits.pullback.snd p p = 𝟙 P := fun c => Limits.pullback.lift_snd _ _ _

  have hopen : ∀ c, IsOpenImmersion (G' c) := by
    intro c
    haveI : Mono (G' c) := mono_of_mono_fac (G'2 c)
    haveI : Etale (G' c) := by
      apply MorphismProperty.of_postcomp (W := @Etale) (W' := @Etale) _
        (Limits.pullback.snd q q) inferInstance
      rw [G'2 c]; infer_instance
    exact IsOpenImmersion.of_flat_of_mono _

  let κ := Limits.pullback.map q q p p f f h hC.symm hC.symm
  have κ1 : κ ≫ Limits.pullback.fst p p = Limits.pullback.fst q q ≫ f :=
    Limits.pullback.lift_fst _ _ _
  have κ2 : κ ≫ Limits.pullback.snd p p = Limits.pullback.snd q q ≫ f :=
    Limits.pullback.lift_snd _ _ _
  have K : ∀ c, G' c ≫ κ = f ≫ G c := by
    intro c
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [κ1, ← Category.assoc, G'1, A1, G1]
    · simp only [Category.assoc]
      rw [κ2, ← Category.assoc, G'2, Category.id_comp, G2, Category.comp_id]

  have L : ∀ c {T : Scheme.{u}} (t₁ : T ⟶ P) (t₂ : T ⟶ Limits.pullback q q),
      t₁ ≫ G c = t₂ ≫ κ → (t₂ ≫ Limits.pullback.snd q q) ≫ G' c = t₂ := by
    intro c T t₁ t₂ ht
    have e1 : t₂ ≫ Limits.pullback.fst q q ≫ f = t₁ ≫ a c := by
      rw [← κ1, ← Category.assoc, ← ht, Category.assoc, G1]
    have e2 : t₂ ≫ Limits.pullback.snd q q ≫ f = t₁ := by
      rw [← κ2, ← Category.assoc, ← ht, Category.assoc, G2, Category.comp_id]
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, G'1]
      apply Limits.pullback.hom_ext
      · change t₂ ≫ Limits.pullback.snd q q ≫ a' c ≫ f = t₂ ≫ Limits.pullback.fst q q ≫ f
        rw [A1 c, reassoc_of% e2, e1]
      · change t₂ ≫ Limits.pullback.snd q q ≫ a' c ≫ q = t₂ ≫ Limits.pullback.fst q q ≫ q
        rw [A2, Limits.pullback.condition]
    · simp only [Category.assoc, G'2, Category.comp_id]

  have hR : ∀ c, Set.range (G' c) ⊆ κ ⁻¹' Set.range (G c) := by
    rintro c _ ⟨v, rfl⟩
    refine ⟨f v, ?_⟩
    have := Scheme.Hom.comp_apply (G' c) κ v
    rw [K c, Scheme.Hom.comp_apply] at this
    exact this
  have hdisj : Pairwise fun c c' => Disjoint (Set.range (G' c)) (Set.range (G' c')) := by
    intro c c' hcc'
    have hd : Disjoint (Set.range (G c)) (Set.range (G c')) := tor.graph_disj hcc'
    exact Disjoint.mono (hR c) (hR c') (hd.preimage (⇑κ))

  have hcov : ⋃ c, Set.range (G c) = Set.univ := tor.graph_cover
  have hcover : ⋃ c, Set.range (G' c) = Set.univ := by
    apply Set.eq_univ_of_forall
    intro z
    have hz : κ z ∈ ⋃ c, Set.range (G c) := by
