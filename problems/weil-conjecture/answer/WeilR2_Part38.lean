  obtain ⟨ζ, hζ⟩ : Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) z ∈
      Set.range ιb := by rw [hrangeb]; exact hgCl
  have hζuniv : closure ({ζ} : Set Zb) = Set.univ := by
    apply Set.image_injective.mpr ιb.isClosedEmbedding.injective
    rw [← ιb.isClosedEmbedding.closure_image_eq, Set.image_singleton, hζ, hClz, Set.image_univ,
      hrangeb]
  have hirrZ : IsIrreducible (Set.univ : Set Zb) := by
    rw [← hζuniv]; exact isIrreducible_singleton.closure
  haveI : IrreducibleSpace Zb := (irreducibleSpace_def Zb).mpr hirrZ
  haveI : AlgebraicGeometry.IsIntegral Zb := isIntegral_of_irreducibleSpace_of_isReduced Zb

  have hfin' : IsFinite (Limits.pullback.snd p (θ.inv ≫ ι ≫
      Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))))) := inferInstance
  have het' : Etale (Limits.pullback.snd p (θ.inv ≫ ι ≫
      Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))))) :=
    MorphismProperty.of_isPullback (P := @Etale) (IsPullback.of_hasPullback _ _) hpet
  have hsurj' : Surjective (Limits.pullback.snd p (θ.inv ≫ ι ≫
      Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))))) :=
    MorphismProperty.of_isPullback (P := @Surjective) (IsPullback.of_hasPullback _ _) hpsurj
  obtain ⟨σ, hσ⟩ := wc_P1_fet_section_of_alg K
    (wc_P1_alg_section K (fun B _ _ _ _ => wc_poly_etale_free_discr_const K B)
      (wc_laurent_lattice_dim_ge K)) _ _ hfin' het' hsurj'
  have hsp : (θ.hom ≫ σ ≫ Limits.pullback.fst p (θ.inv ≫ ι ≫
      Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))))) ≫ p =
      ι ≫ Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) := by
    rw [Category.assoc, Category.assoc, Limits.pullback.condition, ← Category.assoc σ, hσ,
      Category.id_comp, Iso.hom_inv_id_assoc]

  haveI := IsPreimmersion.of_isLocalization (S := K) (nonZeroDivisors ↥R)
  have hSOS : SurjectiveOnStalks
      (ι ≫ Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) := inferInstance

  obtain ⟨x, hx1, hx2⟩ := wcpa_dj_fcs_section_residue_trivial _ p _ ιb hSOS hcib hsp e ζ
    (by rw [hζ, Scheme.Hom.comp_apply, he])

  obtain ⟨S', hS'cl, hS'⟩ := wcpa_dj_fcs_finite_normal_closure_section Zb (Limits.pullback p ιb)
    (wcpa_dj_fcs_sections_integrally_closed Zb (fun w => (hN w).2))
    wcpa_dj_fcs_normal_trivial_residue_unique_prime (Limits.pullback.snd p ιb) inferInstance x
    (by rw [hx1]; exact hζuniv) hx2

  have hct : ∀ t, p (Limits.pullback.fst p ιb t) = ιb (Limits.pullback.snd p ιb t) := fun t => by
    rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
  have hfstinj : Function.Injective (Limits.pullback.fst p ιb) :=
    (Limits.pullback.fst p ιb).isClosedEmbedding.injective
  refine ⟨Limits.pullback.fst p ιb '' S',
    (Limits.pullback.fst p ιb).isClosedEmbedding.isClosedMap _ hS'cl, ?_⟩
  intro y hy
  obtain ⟨w, rfl⟩ : y ∈ Set.range ιb := by rw [hrangeb]; exact hy
  have hset : p ⁻¹' {ιb w} ∩ Limits.pullback.fst p ιb '' S' =
