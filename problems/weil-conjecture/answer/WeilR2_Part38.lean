import WeilR2_Part37
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wcpa_dj_lus_cvs_ct_ns_nf_node_branches : ∀ (k : Type u) [Field k] [IsAlgClosed k] (C : Scheme.{u}) (q : C ⟶ Spec (.of k)), wcpaDjSemistable q → ∀ x : C, (¬ ∃ W : C.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q)) → ∃ (U : C.Opens) (Ct : Scheme.{u}) (ν : Ct ⟶ C) (y₀ y₁ : Spec (.of k) ⟶ Ct), IsFinite ν ∧ IsIso (ν ∣_ U) ∧ (∀ z : Ct, ∃ z' : Ct, z' ⤳ z ∧ ν z' ∈ U) ∧ ((U : Set C)ᶜ).Finite ∧ (∀ w : C, w ∉ U → IsClosed ({w} : Set C)) ∧ x ∉ U ∧ y₀ ≫ ν ≫ q = 𝟙 _ ∧ y₁ ≫ ν ≫ q = 𝟙 _ ∧ (∀ pt : ↥(Spec (.of k)), y₀ pt ≠ y₁ pt) ∧ (∀ pt : ↥(Spec (.of k)), ν (y₀ pt) = x) ∧ (∀ pt : ↥(Spec (.of k)), ν (y₁ pt) = x) ∧ ∀ V : C.Opens, IsAffineOpen V → (∀ w : C, w ∈ V → w ∉ U → w = x) → ∀ s : Γ(Ct, ν ⁻¹ᵁ V), (∀ (h₀ : ⊤ ≤ y₀ ⁻¹ᵁ (ν ⁻¹ᵁ V)) (h₁ : ⊤ ≤ y₁ ⁻¹ᵁ (ν ⁻¹ᵁ V)), (y₀.appLE (ν ⁻¹ᵁ V) ⊤ h₀).hom s = (y₁.appLE (ν ⁻¹ᵁ V) ⊤ h₁).hom s) → ∃ c : Γ(C, V), (ν.app V).hom c = s :=
by
  intro k _ _ C q hss x hns
  classical
  haveI hprop : IsProper q := hss.2.1
  let U : C.Opens := sSup {W : C.Opens | SmoothOfRelativeDimension 1 (W.ι ≫ q)}
  have hiff : ∀ w : C, w ∈ U ↔
      ∃ W : C.Opens, w ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q) := by
    intro w
    rw [TopologicalSpace.Opens.mem_sSup]
    constructor
    · rintro ⟨W, hW, hwW⟩; exact ⟨W, hwW, hW⟩
    · rintro ⟨W, hwW, hW⟩; exact ⟨W, hW, hwW⟩
  have hΦ : (asIso (Limits.pullback.fst q (𝟙 (Spec (.of k))))).symm.hom ≫
      Limits.pullback.snd q (𝟙 (Spec (.of k))) = q := by
    simp only [Iso.symm_hom, asIso_inv]
    rw [IsIso.inv_comp_eq, Limits.pullback.condition, Category.comp_id]
  have hnode : ∀ w : C, w ∉ U → ∃ e : AdicCompletion (IsLocalRing.maximalIdeal (C.presheaf.stalk w))
      (C.presheaf.stalk w) ≃+*
      (MvPowerSeries (Fin 2) k ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
      e.toRingHom.comp ((algebraMap (C.presheaf.stalk w) (AdicCompletion
        (IsLocalRing.maximalIdeal (C.presheaf.stalk w)) (C.presheaf.stalk w))).comp
        ((Scheme.ΓSpecIso (.of k)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ w trivial).hom) =
        (Ideal.Quotient.mk _).comp MvPowerSeries.C := by
    intro w hw
    rcases wcpa_dj_ssp_bw_ns_transport k
        (asIso (Limits.pullback.fst q (𝟙 (Spec (.of k))))).symm
        q (Limits.pullback.snd q (𝟙 (Spec (.of k)))) hΦ w (hss.2.2 k (𝟙 _) _) with hsm' | hn
    · exact absurd ((hiff w).mpr hsm') hw
    · exact hn
  have hres : ∀ w : C, w ∉ U → ∀ a : C.presheaf.stalk w, ∃ z : k,
      a - ((Scheme.ΓSpecIso (.of k)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ w trivial).hom z ∈
        IsLocalRing.maximalIdeal (C.presheaf.stalk w) :=
    fun w hw => wcpa_dj_nf_node_residue k (C.presheaf.stalk w) _ (hnode w hw)
  obtain ⟨hcl, hUfin⟩ := wcpa_dj_nf_nodes_closed_finite k C q U hprop hres
  have hxU : x ∉ U := fun h => hns ((hiff x).mp h)
  obtain ⟨Ct, ν, hfin, hsurj, hiso, hnorm, hgen⟩ :=
    wcpa_dj_nn_normalization k C q U hprop hiff hnode
  obtain ⟨m, y, hFa, hFb, hFc, hFd, hFe, hFf⟩ := wcpa_dj_nn_node_fibres wcpa_dj_nn_node_ring
    k C q U Ct ν hprop hiff hnode hfin hsurj hiso hnorm hgen
  obtain ⟨z₀, hz₀⟩ := ν.surjective x
  have hz₀U : ν z₀ ∉ U := by rw [hz₀]; exact hxU
  obtain ⟨⟨e, i⟩, p₀, hzy⟩ := (hFd z₀).mp hz₀U
  have hx : ν (y (e, i) p₀) = x := by rw [← hzy]; exact hz₀
  have hc : ∀ pt : ↥(Spec (.of k)), ν (y (e, 0) pt) = ν (y (e, 1) pt) := by
    intro pt
    rw [← Scheme.Hom.comp_apply, hFc e, Scheme.Hom.comp_apply]
  have hν₀ : ∀ pt : ↥(Spec (.of k)), ν (y (e, 0) pt) = x := by
    intro pt
    rw [Subsingleton.elim pt p₀]
    fin_cases i
    · exact hx
    · rw [hc]; exact hx
  have hν₁ : ∀ pt : ↥(Spec (.of k)), ν (y (e, 1) pt) = x := fun pt => by
    rw [← hc]; exact hν₀ pt
  have h01 : (0 : Fin 2) ≠ 1 := by decide
  have hdist : ∀ pt : ↥(Spec (.of k)), y (e, 0) pt ≠ y (e, 1) pt := fun pt =>
    hFb (e, 0) (e, 1) pt pt (fun h => h01 (congrArg Prod.snd h))
  have hdesc : ∀ V : C.Opens, IsAffineOpen V → (∀ w : C, w ∈ V → w ∉ U → w = x) →
      ∀ s : Γ(Ct, ν ⁻¹ᵁ V), (∀ (h₀ : ⊤ ≤ (y (e, 0)) ⁻¹ᵁ (ν ⁻¹ᵁ V))
        (h₁ : ⊤ ≤ (y (e, 1)) ⁻¹ᵁ (ν ⁻¹ᵁ V)),
        ((y (e, 0)).appLE (ν ⁻¹ᵁ V) ⊤ h₀).hom s = ((y (e, 1)).appLE (ν ⁻¹ᵁ V) ⊤ h₁).hom s) →
      ∃ c : Γ(C, V), (ν.app V).hom c = s := by
    intro V hV hP s hs
    refine (hFf ⟨V, hV⟩).2 s ?_
    intro e' h₀ h₁
    by_cases he : e' = e
    · subst he
      exact hs h₀ h₁
    · exfalso
      have hmem : p₀ ∈ (y (e', 0)) ⁻¹ᵁ (ν ⁻¹ᵁ V) :=
        h₀ (show p₀ ∈ (⊤ : (Spec (.of k)).Opens) from trivial)
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage] at hmem
      have hnU : ν (y (e', 0) p₀) ∉ U := (hFd _).mpr ⟨(e', 0), p₀, rfl⟩
      have hxx : ν (y (e', 0) p₀) = ν (y (e, 0) p₀) := (hP _ hmem hnU).trans (hν₀ p₀).symm
      rcases hFe _ _ hxx with h | ⟨e'', p, q', ⟨_, h2⟩ | ⟨h1, _⟩⟩
      · exact hFb (e', 0) (e, 0) p₀ p₀ (fun h' => he (congrArg Prod.fst h')) h
      · exact hFb (e, 0) (e'', 1) p₀ q' (fun h' => h01 (congrArg Prod.snd h')) h2
      · exact hFb (e', 0) (e'', 1) p₀ p (fun h' => h01 (congrArg Prod.snd h')) h1
  exact ⟨U, Ct, ν, y (e, 0), y (e, 1), hfin, hiso, hgen, hUfin, hcl, hxU, hFa (e, 0), hFa (e, 1),
    hdist, hν₀, hν₁, hdesc⟩

theorem wcpa_dj_lus_cvs_ct_ns_nf_separate_sections : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (f : X ⟶ Spec (.of K)) (W : X.Opens), IsAffineOpen W → ∀ (y₀ y₁ : Spec (.of K) ⟶ X), y₀ ≫ f = 𝟙 _ → y₁ ≫ f = 𝟙 _ → (∀ pt : ↥(Spec (.of K)), y₀ pt ∈ W) → (∀ pt : ↥(Spec (.of K)), y₁ pt ∈ W) → (∀ pt : ↥(Spec (.of K)), y₀ pt ≠ y₁ pt) → ∃ g : Γ(X, W), (∀ h : ⊤ ≤ y₀ ⁻¹ᵁ W, (y₀.appLE W ⊤ h).hom g = 0) ∧ (∀ h : ⊤ ≤ y₁ ⁻¹ᵁ W, (y₁.appLE W ⊤ h).hom g = 1) :=
by
  intro K _ X f W hW y₀ y₁ hs₀ hs₁ hW₀ hW₁ hne
  have h₀ : ⊤ ≤ y₀ ⁻¹ᵁ W := fun pt _ => hW₀ pt
  have h₁ : ⊤ ≤ y₁ ⁻¹ᵁ W := fun pt _ => hW₁ pt

  have hdiff : ∃ a : Γ(X, W), (y₀.appLE W ⊤ h₀).hom a ≠ (y₁.appLE W ⊤ h₁).hom a := by
    by_contra H
    push_neg at H
    have e1 : y₀.appLE W ⊤ h₀ = y₁.appLE W ⊤ h₁ := CommRingCat.hom_ext (RingHom.ext H)
    have hV := isAffineOpen_top (Spec (.of K))
    have e2 := IsAffineOpen.SpecMap_appLE_fromSpec y₀ hW hV h₀
    have e3 := IsAffineOpen.SpecMap_appLE_fromSpec y₁ hW hV h₁
    rw [e1, e3, IsAffineOpen.fromSpec_top] at e2
    have e4 : y₁ = y₀ := (cancel_epi _).mp e2
    obtain ⟨pt⟩ : Nonempty ↥(Spec (.of K)) := inferInstance
    exact hne pt (by rw [e4])

  have key : ∀ (φ : Spec (.of K) ⟶ Spec (.of K)) (e : ⊤ ≤ φ ⁻¹ᵁ ⊤), φ = 𝟙 _ →
      ∀ r, (φ.appLE ⊤ ⊤ e).hom r = r := by
    rintro φ e rfl r
    simp only [Scheme.Hom.appLE, Scheme.Hom.id_app]
    change ((Spec (.of K)).presheaf.map (𝟙 (Opposite.op (⊤ : (Spec (.of K)).Opens)))).hom r = r
    rw [CategoryTheory.Functor.map_id]
    rfl
  have hret : ∀ (y : Spec (.of K) ⟶ X) (h : ⊤ ≤ y ⁻¹ᵁ W) (e : W ≤ f ⁻¹ᵁ ⊤), y ≫ f = 𝟙 _ →
      ∀ r, (y.appLE W ⊤ h).hom ((f.appLE ⊤ W e).hom r) = r := by
    intro y h e hy r
    rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE]
    exact key _ _ hy r

  have hunit : ∀ r : Γ(Spec (.of K), ⊤), r ≠ 0 → IsUnit r := by
    intro r hr
    let E := (Scheme.ΓSpecIso (.of K)).commRingCatIsoToRingEquiv
    have hE : (E r : K) ≠ 0 := by
      intro h
      apply hr
      exact E.injective (h.trans (map_zero E).symm)
    exact (isUnit_map_iff E r).mp (Ne.isUnit hE)

  obtain ⟨a, ha⟩ := hdiff
  obtain ⟨v, hv⟩ := (hunit _ (sub_ne_zero.mpr (Ne.symm ha))).exists_right_inv
  have eW : W ≤ f ⁻¹ᵁ ⊤ := fun _ _ => trivial
  refine ⟨(f.appLE ⊤ W eW).hom v * (a - (f.appLE ⊤ W eW).hom ((y₀.appLE W ⊤ h₀).hom a)), ?_, ?_⟩
  · intro h
    rw [map_mul, map_sub, hret y₀ h eW hs₀, hret y₀ h eW hs₀, sub_self, mul_zero]
  · intro h
    rw [map_mul, map_sub, hret y₁ h eW hs₁, hret y₁ h eW hs₁, mul_comm]
    exact hv

theorem wcpa_dj_lus_cvs_ct_ns_nf_germ_eval_zero : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (y : Spec (.of K) ⟶ X) (W : X.Opens) (h : ⊤ ≤ y ⁻¹ᵁ W) (pt : ↥(Spec (.of K))) (hx : y pt ∈ W) (s : Γ(X, W)), (X.presheaf.germ W (y pt) hx).hom s ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk (y pt)) ↔ (y.appLE W ⊤ h).hom s = 0 :=
by
  intro K _ X y W h pt hx s
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← Scheme.mem_basicOpen X s (y pt) hx,
    ← basicOpen_eq_bot_iff, Scheme.basicOpen_appLE]
  have key : y pt ∈ X.basicOpen s ↔ pt ∈ (⊤ ⊓ y ⁻¹ᵁ X.basicOpen s) :=
    ⟨fun h1 => ⟨trivial, h1⟩, fun h1 => h1.2⟩
  rw [key]
  constructor
  · intro hn
    rw [eq_bot_iff]
    intro u hu
    exact absurd (Subsingleton.elim u pt ▸ hu) hn
  · intro he hp
    rw [he] at hp
    exact hp

theorem wcpa_dj_lus_cvs_ct_ns_nf_restrict_app_bij : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U W : Y.Opens), IsIso (f ∣_ U) → W ≤ U → Function.Bijective (f.app W).hom :=
by
  intro X Y f U W hiso hW
  have h1 : U.ι ''ᵁ (U.ι ⁻¹ᵁ W) = W := by
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
    exact inf_eq_right.mpr hW
  have h2 : IsIso ((f ∣_ U).app (U.ι ⁻¹ᵁ W)) := inferInstance
  rw [morphismRestrict_app] at h2
  have key : ∀ {A B : X.Opens} (e : A = B), IsIso (X.presheaf.map (eqToHom e).op) := by
    rintro A B rfl
    rw [eqToHom_refl, op_id, X.presheaf.map_id]
    infer_instance
  have h3 : IsIso (f.app (U.ι ''ᵁ (U.ι ⁻¹ᵁ W))) :=
    @IsIso.of_isIso_comp_right _ _ _ _ _ _ _ (key _) h2
  have h4 : ∀ O : Y.Opens, O = W → IsIso (f.app O) → IsIso (f.app W) := by
    rintro O rfl h; exact h
  have := h4 _ h1 h3
  exact ConcreteCategory.bijective_of_isIso (f.app W)

theorem wcpa_dj_lus_cvs_ct_ns_nf_common_generization : ∀ (C Ct : Scheme.{u}) (ν : Ct ⟶ C) (U : C.Opens), IsIso (ν ∣_ U) → (∀ z : Ct, ∃ z' : Ct, z' ⤳ z ∧ ν z' ∈ U) → ∀ D ∈ irreducibleComponents ↥C, ∀ x ∈ D, (∀ D' ∈ irreducibleComponents ↥C, x ∈ D' → D' = D) → ∀ τ₀ τ₁ : Ct, ν τ₀ = x → ν τ₁ = x → ∃ θ : Ct, θ ⤳ τ₀ ∧ θ ⤳ τ₁ ∧ closure {ν θ} = D :=
by
  intro C Ct ν U hiso hgen D hD x hxD H τ₀ τ₁ h₀ h₁
  have := hiso
  have hDirr : IsIrreducible D := hD.prop
  have hDcl : IsClosed D := isClosed_of_mem_irreducibleComponents D hD
  have s1 : ∀ τ : Ct, ν τ = x → ∃ z : Ct, z ⤳ τ ∧ ν z ∈ U ∧ ν z ∈ D := by
    intro τ hτ
    obtain ⟨z, hz, hzU⟩ := hgen τ
    have hsp : ν z ⤳ x := hτ ▸ hz.map ν.continuous
    obtain ⟨D', hD', hsub⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible _
      (isIrreducible_singleton (x := ν z)).closure
    have hx' : x ∈ D' := hsub (specializes_iff_mem_closure.mp hsp)
    have hDD : D' = D := H D' hD' hx'
    rw [hDD] at hsub
    exact ⟨z, hz, hzU, hsub (subset_closure (Set.mem_singleton _))⟩
  have hη : closure {hDirr.genericPoint} = D := by
    have := hDirr.isGenericPoint_genericPoint_closure
    rw [hDcl.closure_eq] at this
    exact this
  have hηsp : ∀ y ∈ D, hDirr.genericPoint ⤳ y := fun y hy =>
    specializes_iff_mem_closure.mpr (hη.symm ▸ hy)
  obtain ⟨z₀, hz₀, hz₀U, hz₀D⟩ := s1 τ₀ h₀
  obtain ⟨z₁, hz₁, hz₁U, hz₁D⟩ := s1 τ₁ h₁
  have hηU : hDirr.genericPoint ∈ U := (hηsp _ hz₀D).mem_open U.isOpen hz₀U
  set η := hDirr.genericPoint with hηdef
  have K : ∀ a : (ν ⁻¹ᵁ U).toScheme, U.ι ((ν ∣_ U) a) = ν ((ν ⁻¹ᵁ U).ι a) := by
    intro a
    rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
  let e := Scheme.Hom.homeomorph (ν ∣_ U)
  have he : ∀ a, e a = (ν ∣_ U) a := fun a => Scheme.Hom.homeomorph_apply _ a
  let ηU : U.toScheme := ⟨η, hηU⟩
  have hηU' : U.ι ηU = η := rfl
  let θU : (ν ⁻¹ᵁ U).toScheme := e.symm ηU
  have hθ : ν ((ν ⁻¹ᵁ U).ι θU) = η := by
    rw [← K θU, ← he, Homeomorph.apply_symm_apply, hηU']
  have hind := (Scheme.Hom.isOpenEmbedding U.ι).isInducing
  have s4 : ∀ z τ : Ct, z ⤳ τ → ν z ∈ U → ν z ∈ D → (ν ⁻¹ᵁ U).ι θU ⤳ τ := by
    intro z τ hz hzU hzD
    let zU : (ν ⁻¹ᵁ U).toScheme := ⟨z, hzU⟩
    have hzU' : (ν ⁻¹ᵁ U).ι zU = z := rfl
    have hez : U.ι (e zU) = ν z := by
      rw [he, K, hzU']
    have h1 : ηU ⤳ e zU := by
      apply hind.specializes_iff.mp
      rw [hez, hηU']
      exact hηsp _ hzD
    have h2 : θU ⤳ zU := by
      have := h1.map e.symm.continuous
      simpa using this
    have h3 : (ν ⁻¹ᵁ U).ι θU ⤳ z := by
      have := h2.map (ν ⁻¹ᵁ U).ι.continuous
      rwa [hzU'] at this
    exact h3.trans hz
  refine ⟨(ν ⁻¹ᵁ U).ι θU, s4 z₀ τ₀ hz₀ hz₀U hz₀D, s4 z₁ τ₁ hz₁ hz₁U hz₁D, ?_⟩
  rw [hθ]
  exact hη

theorem wcpa_dj_lus_cvs_ct_ns_nf_unit_shrink : ∀ (C Ct : Scheme.{u}) (ν : Ct ⟶ C) (U V₁ O : C.Opens) (x : C) (hxV₁ : x ∈ V₁), IsAffineOpen V₁ → (O : Set C) = {x}ᶜ → (∀ w : C, w ∈ V₁ → w ∉ U → w = x) → (∀ W : C.Opens, W ≤ U → Function.Bijective (ν.app W).hom) → ∀ (g₁ : Γ(Ct, ν ⁻¹ᵁ V₁)) (c₁ : Γ(C, V₁)), (ν.app V₁).hom c₁ = g₁ - g₁ ^ 2 → IsUnit ((C.presheaf.germ V₁ x hxV₁).hom (1 - 4 * c₁)) → ∃ (V : C.Opens) (c : Γ(C, V)) (g : Γ(C, V ⊓ O)) (hVV₁ : V ≤ V₁), IsAffineOpen V ∧ x ∈ V ∧ IsUnit (1 - 4 * c) ∧ (C.presheaf.map (homOfLE (inf_le_left : V ⊓ O ≤ V)).op).hom c = g - g ^ 2 ∧ (ν.app V).hom c = (Ct.presheaf.map (homOfLE (ν.preimage_mono hVV₁)).op).hom (g₁ - g₁ ^ 2) :=
by
  intro C Ct ν U V₁ O x hxV₁ hV₁ hO hP hβ g₁ c₁ hc₁ hunit
  have hVV₁ : C.basicOpen (1 - 4 * c₁) ≤ V₁ := C.basicOpen_le (1 - 4 * c₁)
  have hVaff : IsAffineOpen (C.basicOpen (1 - 4 * c₁)) := hV₁.basicOpen (1 - 4 * c₁)
  have hxV : x ∈ C.basicOpen (1 - 4 * c₁) := (C.mem_basicOpen (1 - 4 * c₁) x hxV₁).mpr hunit
  have hU : C.basicOpen (1 - 4 * c₁) ⊓ O ≤ U := by
    intro w hw
    by_contra hwU
    have h1 : w ∈ V₁ := hVV₁ hw.1
    have h2 : (w : C) ∈ (O : Set C) := hw.2
    rw [hO] at h2
    exact h2 (hP w h1 hwU)
  have hVO₁ : C.basicOpen (1 - 4 * c₁) ⊓ O ≤ V₁ := inf_le_left.trans hVV₁
  obtain ⟨g, hg⟩ := (hβ _ hU).2 ((Ct.presheaf.map (homOfLE (ν.preimage_mono hVO₁)).op).hom g₁)
  refine ⟨C.basicOpen (1 - 4 * c₁), (C.presheaf.map (homOfLE hVV₁).op).hom c₁, g, hVV₁,
    hVaff, hxV, ?_, ?_, ?_⟩
  · have h := RingedSpace.isUnit_res_basicOpen C.toRingedSpace (1 - 4 * c₁)
    have e : (1 : Γ(C, C.basicOpen (1 - 4 * c₁))) - 4 * (C.presheaf.map (homOfLE hVV₁).op).hom c₁
        = (C.presheaf.map (homOfLE hVV₁).op).hom (1 - 4 * c₁) := by
      rw [map_sub, map_one, map_mul, map_ofNat]
    rw [e]
    exact h
  · apply (hβ _ hU).1
    have hres : (C.presheaf.map (homOfLE (inf_le_left : C.basicOpen (1 - 4 * c₁) ⊓ O ≤
        C.basicOpen (1 - 4 * c₁))).op).hom ((C.presheaf.map (homOfLE hVV₁).op).hom c₁)
        = (C.presheaf.map (homOfLE hVO₁).op).hom c₁ := by
      rw [← CommRingCat.comp_apply, ← Functor.map_comp]
      rfl
    rw [map_sub, map_pow, hg, ← map_pow, ← map_sub, ← hc₁, hres]
    rw [← CommRingCat.comp_apply, Scheme.Hom.naturality, CommRingCat.comp_apply]
    rfl
  · rw [← hc₁, ← CommRingCat.comp_apply, Scheme.Hom.naturality, CommRingCat.comp_apply]
    rfl

theorem wcpa_dj_lus_cvs_ct_ns_nf_chart_scheme : ∀ (K : Type u) [Field K] (C Ct : Scheme.{u}) (ν : Ct ⟶ C) (V V₁ : C.Opens) (hVV₁ : V ≤ V₁), IsFinite ν → IsAffineOpen V → ∀ (g₁ : Γ(Ct, ν ⁻¹ᵁ V₁)) (c : Γ(C, V)), (ν.app V).hom c = (Ct.presheaf.map (homOfLE (ν.preimage_mono hVV₁)).op).hom (g₁ - g₁ ^ 2) → ∀ (y₀ y₁ : Spec (.of K) ⟶ Ct), (∀ pt : ↥(Spec (.of K)), ν (y₀ pt) ∈ V) → (∀ pt : ↥(Spec (.of K)), ν (y₁ pt) ∈ V) → (∀ h : ⊤ ≤ y₀ ⁻¹ᵁ (ν ⁻¹ᵁ V₁), (y₀.appLE (ν ⁻¹ᵁ V₁) ⊤ h).hom g₁ = 0) → (∀ h : ⊤ ≤ y₁ ⁻¹ᵁ (ν ⁻¹ᵁ V₁), (y₁.appLE (ν ⁻¹ᵁ V₁) ⊤ h).hom g₁ = 1) → ∀ θ' : Ct, (∀ pt : ↥(Spec (.of K)), θ' ⤳ y₀ pt) → (∀ pt : ↥(Spec (.of K)), θ' ⤳ y₁ pt) → ∃ (T : Scheme.{u}) (t : T ⟶ C) (hT : t ⁻¹ᵁ V = ⊤) (γ : Γ(T, ⊤)) (θ : T) (z₀ z₁ : Spec (.of K) ⟶ T), IsAffine T ∧ γ ^ 2 - γ + (t.appLE V ⊤ hT.ge).hom c = 0 ∧ (∀ pt : ↥(Spec (.of K)), θ ⤳ z₀ pt) ∧ (∀ pt : ↥(Spec (.of K)), θ ⤳ z₁ pt) ∧ (∀ pt : ↥(Spec (.of K)), t (z₀ pt) = ν (y₀ pt)) ∧ (∀ pt : ↥(Spec (.of K)), t (z₁ pt) = ν (y₁ pt)) ∧ t θ = ν θ' ∧ (∀ h : ⊤ ≤ z₀ ⁻¹ᵁ ⊤, (z₀.appLE ⊤ ⊤ h).hom γ = 0) ∧ (∀ h : ⊤ ≤ z₁ ⁻¹ᵁ ⊤, (z₁.appLE ⊤ ⊤ h).hom (γ - 1) = 0) :=
by
  intro K _ C Ct ν V V₁ hVV₁ hfin hV g₁ c hrel y₀ y₁ hy₀V hy₁V hg₀ hg₁ θ' hθ₀ hθ₁
  classical
  have hN : ν ⁻¹ᵁ V ≤ ν ⁻¹ᵁ V₁ := ν.preimage_mono hVV₁
  have hNaff : IsAffineOpen (ν ⁻¹ᵁ V) := hV.preimage ν
  obtain ⟨pt₀⟩ : Nonempty ↥(Spec (.of K)) := inferInstance
  have hT : ((ν ⁻¹ᵁ V).ι ≫ ν) ⁻¹ᵁ V = ⊤ := by
    rw [Scheme.Hom.comp_preimage, Scheme.Opens.ι_preimage_self]
  have e : (⊤ : (ν ⁻¹ᵁ V).toScheme.Opens) ≤ (ν ⁻¹ᵁ V).ι ⁻¹ᵁ (ν ⁻¹ᵁ V₁) := by
    intro x _
    exact hN x.2
  have hθN : θ' ∈ ν ⁻¹ᵁ V :=
    (hθ₀ pt₀).mem_open (ν ⁻¹ᵁ V).isOpen (hy₀V pt₀)
  have H₀ : Set.range y₀ ⊆ Set.range (ν ⁻¹ᵁ V).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨pt, rfl⟩
    exact hy₀V pt
  have H₁ : Set.range y₁ ⊆ Set.range (ν ⁻¹ᵁ V).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨pt, rfl⟩
    exact hy₁V pt
  have hfac₀ : IsOpenImmersion.lift (ν ⁻¹ᵁ V).ι y₀ H₀ ≫ (ν ⁻¹ᵁ V).ι = y₀ :=
    IsOpenImmersion.lift_fac _ _ _
  have hfac₁ : IsOpenImmersion.lift (ν ⁻¹ᵁ V).ι y₁ H₁ ≫ (ν ⁻¹ᵁ V).ι = y₁ :=
    IsOpenImmersion.lift_fac _ _ _
  have hpt₀ : ∀ pt, (ν ⁻¹ᵁ V).ι (IsOpenImmersion.lift (ν ⁻¹ᵁ V).ι y₀ H₀ pt) = y₀ pt := by
    intro pt
    rw [← Scheme.Hom.comp_apply, hfac₀]
  have hpt₁ : ∀ pt, (ν ⁻¹ᵁ V).ι (IsOpenImmersion.lift (ν ⁻¹ᵁ V).ι y₁ H₁ pt) = y₁ pt := by
    intro pt
    rw [← Scheme.Hom.comp_apply, hfac₁]
  have hind := (ν ⁻¹ᵁ V).ι.isOpenEmbedding.isInducing
  have key₀ : ∀ (φ : Spec (.of K) ⟶ Ct) (h' : ⊤ ≤ φ ⁻¹ᵁ (ν ⁻¹ᵁ V₁)), φ = y₀ →
      (φ.appLE (ν ⁻¹ᵁ V₁) ⊤ h').hom g₁ = 0 := by
    rintro φ h' rfl
    exact hg₀ h'
  have key₁ : ∀ (φ : Spec (.of K) ⟶ Ct) (h' : ⊤ ≤ φ ⁻¹ᵁ (ν ⁻¹ᵁ V₁)), φ = y₁ →
      (φ.appLE (ν ⁻¹ᵁ V₁) ⊤ h').hom g₁ = 1 := by
    rintro φ h' rfl
    exact hg₁ h'
  refine ⟨(ν ⁻¹ᵁ V).toScheme, (ν ⁻¹ᵁ V).ι ≫ ν, hT,
    ((ν ⁻¹ᵁ V).ι.appLE (ν ⁻¹ᵁ V₁) ⊤ e).hom g₁, ⟨θ', hθN⟩,
    IsOpenImmersion.lift (ν ⁻¹ᵁ V).ι y₀ H₀, IsOpenImmersion.lift (ν ⁻¹ᵁ V).ι y₁ H₁,
    hNaff, ?_, ?_, ?_, ?_, ?_, rfl, ?_, ?_⟩
  · have e0 : (⊤ : (ν ⁻¹ᵁ V).toScheme.Opens) ≤ (ν ⁻¹ᵁ V).ι ⁻¹ᵁ (ν ⁻¹ᵁ V) := by
      intro x _
      exact x.2
    have h1 : ((ν ⁻¹ᵁ V).ι ≫ ν).appLE V ⊤ hT.ge =
        ν.app V ≫ (ν ⁻¹ᵁ V).ι.appLE (ν ⁻¹ᵁ V) ⊤ e0 :=
      Scheme.Hom.comp_appLE _ _ _ _ _
    have h2 : Ct.presheaf.map (homOfLE (ν.preimage_mono hVV₁)).op ≫
        (ν ⁻¹ᵁ V).ι.appLE (ν ⁻¹ᵁ V) ⊤ e0 = (ν ⁻¹ᵁ V).ι.appLE (ν ⁻¹ᵁ V₁) ⊤ e := by
      rw [Scheme.Hom.map_appLE]
    rw [h1, CommRingCat.hom_comp, RingHom.comp_apply, hrel,
      ← RingHom.comp_apply, ← CommRingCat.hom_comp, h2, map_sub, map_pow]
    ring
  · intro pt
    refine hind.specializes_iff.mp ?_
    rw [hpt₀]
    exact hθ₀ pt
  · intro pt
    refine hind.specializes_iff.mp ?_
    rw [hpt₁]
    exact hθ₁ pt
  · intro pt
    rw [Scheme.Hom.comp_apply, hpt₀]
  · intro pt
    rw [Scheme.Hom.comp_apply, hpt₁]
  · intro h
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, Scheme.Hom.appLE_comp_appLE]
    exact key₀ _ _ hfac₀
  · intro h
    rw [map_sub, map_one, ← RingHom.comp_apply, ← CommRingCat.hom_comp,
      Scheme.Hom.appLE_comp_appLE, key₁ _ _ hfac₁, sub_self]

theorem wcpa_dj_lus_cvs_ct_ns_nf_unit_germ : ∀ {Z Y : Scheme.{u}} (φ : Z ⟶ Y) (V : Y.Opens) (W : Z.Opens) (e : W ≤ φ ⁻¹ᵁ V) (z : Z), z ∈ W → ∀ (x : Y) (hxV : x ∈ V), φ z = x → ∀ s : Γ(Y, V), IsUnit ((φ.appLE V W e).hom s) → IsUnit ((Y.presheaf.germ V x hxV).hom s) :=
by
  intro Z Y φ V W e z hzW x hxV hzx s hu
  subst hzx
  have h2 := hu.map (Z.presheaf.germ W z hzW).hom
  have key : (Z.presheaf.germ W z hzW).hom ((φ.appLE V W e).hom s)
      = (φ.stalkMap z).hom ((Y.presheaf.germ V (φ z) hxV).hom s) := by
    rw [Scheme.Hom.germ_stalkMap_apply]
    show (Z.presheaf.germ W z hzW).hom ((Z.presheaf.map (homOfLE e).op).hom ((φ.app V).hom s)) = _
    exact TopCat.Presheaf.germ_res_apply _ _ _ _ _
  rw [key] at h2
  exact isUnit_of_map_unit (φ.stalkMap z).hom _ h2

theorem wcpa_dj_lus_cvs_ct_ns_node_function : ∀ (k : Type u) [Field k] [IsAlgClosed k] (C : Scheme.{u}) (q : C ⟶ Spec (.of k)), wcpaDjSemistable q → ∀ D ∈ irreducibleComponents ↥C, ∀ x ∈ D, IsClosed ({x} : Set C) → (¬ ∃ W : C.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q)) → (∀ D' ∈ irreducibleComponents ↥C, x ∈ D' → D' = D) → ∀ (O : C.Opens), (O : Set C) = {x}ᶜ → ∃ (V : C.Opens) (c : Γ(C, V)) (g : Γ(C, V ⊓ O)) (T : Scheme.{u}) (t : T ⟶ C) (hT : t ⁻¹ᵁ V = ⊤) (γ : Γ(T, ⊤)) (θ τ₀ τ₁ : T), IsAffineOpen V ∧ x ∈ V ∧ IsAffine T ∧ IsUnit (1 - 4 * c) ∧ (C.presheaf.map (homOfLE (inf_le_left : V ⊓ O ≤ V)).op).hom c = g - g ^ 2 ∧ γ ^ 2 - γ + (t.appLE V ⊤ hT.ge).hom c = 0 ∧ θ ⤳ τ₀ ∧ θ ⤳ τ₁ ∧ t τ₀ = t τ₁ ∧ closure {t θ} = D ∧ (T.presheaf.germ ⊤ τ₀ trivial).hom γ ∈ IsLocalRing.maximalIdeal (T.presheaf.stalk τ₀) ∧ (T.presheaf.germ ⊤ τ₁ trivial).hom (γ - 1) ∈ IsLocalRing.maximalIdeal (T.presheaf.stalk τ₁) :=
