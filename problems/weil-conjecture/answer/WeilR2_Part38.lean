  ·
    rcases hdich x with hsm | ⟨e, he⟩
    · exact absurd ((hiff x).mpr hsm) hxU
    obtain ⟨θ₀, θ₁, r₀, r₁, hθ₀C, hθ₁C, hθm, hr₀m, hr₁m, hc₀₀, hd₁₀, hd₀₁, hc₁₁, hspan⟩ :=
      wcpa_dj_fva_tg_node_arcs K (C.presheaf.stalk x) _ e he
    haveI : Ring.KrullDimLE 1 (C.presheaf.stalk x) := ⟨by exact_mod_cast hdim x hxU⟩
    have hX2 : ∀ P : PowerSeries K, PowerSeries.X ^ 2 ∣ P ↔
        PowerSeries.constantCoeff P = 0 ∧ PowerSeries.coeff 1 P = 0 := by
      intro P
      rw [PowerSeries.X_pow_dvd_iff]
      constructor
      · intro h
        exact ⟨by rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply]; exact h 0 (by norm_num),
          h 1 (by norm_num)⟩
      · rintro ⟨h0, h1⟩ m hm
        interval_cases m
        · rw [PowerSeries.coeff_zero_eq_constantCoeff_apply]; exact h0
        · exact h1
    have hc1 : ∀ P : PowerSeries K, PowerSeries.X ^ 2 ∣ P → PowerSeries.coeff 1 P = 0 :=
      fun P h => ((hX2 P).mp h).2

    have arc : ∀ (θ : C.presheaf.stalk x →+* PowerSeries K) (r : C.presheaf.stalk x),
        (∀ c : K, θ (((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫
          C.presheaf.germ ⊤ x trivial).hom c) = PowerSeries.C c) →
        (∀ y ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x),
