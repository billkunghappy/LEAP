        rw [hw]
        ring
      rw [hyw]
      refine Submodule.add_mem_sup ?_ ?_
      · exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (Ideal.subset_span hg₀S))
          (Ideal.mul_mem_left _ _ (Ideal.subset_span hg₁S))
      · rw [Ideal.smul_eq_mul, ← pow_two]
        exact hwsq

    have hfg : (IsLocalRing.maximalIdeal (C.presheaf.stalk x)).FG := IsNoetherian.noetherian _
    have hjac : IsLocalRing.maximalIdeal (C.presheaf.stalk x) ≤
        (⊥ : Ideal (C.presheaf.stalk x)).jacobson := by
      rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
    apply le_antisymm (Ideal.span_le.mpr hS)
    exact Submodule.le_of_le_smul_of_le_jacobson_bot hfg hjac hle

theorem wcpa_dj_fva_ss_pointwise_separation : ∀ (K : Type u) [Field K] [IsAlgClosed K]
    (C : Scheme.{u}) (q : C ⟶ Spec (.of K)) (L : wcpaDjCoc C),
    wcpaDjSemistable q → wcpaDjCocOK L →
    (∀ ξ : C, closure {ξ} ∈ irreducibleComponents C → ∀ a : Fin L.m, ξ ∈ L.V a →
      1 ≤ wcpaDjCompDeg L ξ a) →
    ∃ e : ℕ, 0 < e ∧
      (∀ x : C, IsClosed ({x} : Set C) →
        ∃ s : ∀ a : Fin L.m, Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤), wcpaDjCocSec q L e s ∧
          ∀ (a : Fin L.m) (hx : x ∈ L.V a ⊓ q ⁻¹ᵁ ⊤),
            (C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) x hx).hom (s a) ∉
              IsLocalRing.maximalIdeal (C.presheaf.stalk x)) ∧
      (∀ x y : C, IsClosed ({x} : Set C) → IsClosed ({y} : Set C) → x ≠ y →
        ∃ s : ∀ a : Fin L.m, Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤), wcpaDjCocSec q L e s ∧
          (∀ (a : Fin L.m) (hx : x ∈ L.V a ⊓ q ⁻¹ᵁ ⊤),
            (C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) x hx).hom (s a) ∈
              IsLocalRing.maximalIdeal (C.presheaf.stalk x)) ∧
          (∀ (b : Fin L.m) (hy : y ∈ L.V b ⊓ q ⁻¹ᵁ ⊤),
            (C.presheaf.germ (L.V b ⊓ q ⁻¹ᵁ ⊤) y hy).hom (s b) ∉
              IsLocalRing.maximalIdeal (C.presheaf.stalk y))) ∧
      (∀ x : C, IsClosed ({x} : Set C) → ∀ (a : Fin L.m) (hx : x ∈ L.V a ⊓ q ⁻¹ᵁ ⊤),
        Ideal.span {g | ∃ s : ∀ a : Fin L.m, Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤), wcpaDjCocSec q L e s ∧
            (C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) x hx).hom (s a) = g ∧
            g ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x)} =
          IsLocalRing.maximalIdeal (C.presheaf.stalk x)) :=
by
  intro K _ _ C q L hss hOK hpos
  classical

  have ip_mem : ∀ {F : Type u} [Field F] (V : ValuationSubring F) (f : F) (n : ℕ),
      wcpaDjPsInPow V f n → f ∈ V := by
    intro F _ V f n h
    unfold wcpaDjPsInPow at h
    obtain ⟨h, -⟩ := h
    exact h
  have ip_mono : ∀ {F : Type u} [Field F] (V : ValuationSubring F) (f : F) (m n : ℕ),
      m ≤ n → wcpaDjPsInPow V f n → wcpaDjPsInPow V f m := by
    intro F _ V f m n hmn h
    unfold wcpaDjPsInPow at h ⊢
    obtain ⟨h, h'⟩ := h
    exact ⟨h, Ideal.pow_le_pow_right hmn h'⟩
  have ip_zero : ∀ {F : Type u} [Field F] (V : ValuationSubring F) (n : ℕ),
