  have hEa : ∀ {p : ℕ} (a : Fin (p + 1) ↪o Fin (m + 1)) (x y : (Fin (m + 1) → ℤ) →₀ A),
      E a (x + y) = E a x + E a y := fun a x y => hEadd _ _ x y
  have hEs : ∀ {p : ℕ} (a : Fin (p + 1) ↪o Fin (m + 1)) (c : A) (x : (Fin (m + 1) → ℤ) →₀ A),
      E a (c • x) = (Y.presheaf.map (homOfLE (inf_le_right : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k)
        O a ≤ O)).op).hom (ψ c) * E a x := fun a c x => hEsmul _ _ c x
  have hEsum : ∀ {p : ℕ} (a : Fin (p + 1) ↪o Fin (m + 1)) {ι : Type} (s : Finset ι)
      (f : ι → (Fin (m + 1) → ℤ) →₀ A), E a (∑ i ∈ s, f i) = ∑ i ∈ s, E a (f i) := by
    intro p a ι s f
