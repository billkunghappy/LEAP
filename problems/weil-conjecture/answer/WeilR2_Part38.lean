theorem wcpa_dj_lr1u_vtd_mob_reduction : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) [AlgebraicGeometry.IsIntegral (wcProjK Ω 1)] (V : ValuationSubring (wcProjK Ω 1).functionField), (∀ ω : Ω, wcLr1uConst (wcProjKStr Ω 1) ω ∈ V ↔ ω ∈ W) → ∀ (c1 c2 c3 : ↥(wcProjK Ω 1)) (h : (wcProjK Ω 1).functionField), wcLr1uMob (wcProjKStr Ω 1) c1 c2 c3 h → wcLr1uVtdRT W (wcProjKStr Ω 1) (V : Set (wcProjK Ω 1).functionField) h → ∀ (d1 d2 d3 : ↥(wcProjK Ω 1)) (l1 l2 l3 : Option (IsLocalRing.ResidueField ↥W)), l1 ≠ l2 → l1 ≠ l3 → l2 ≠ l3 → wcLr1uVtdCls W (wcProjKStr Ω 1) h d1 l1 → wcLr1uVtdCls W (wcProjKStr Ω 1) h d2 l2 → wcLr1uVtdCls W (wcProjKStr Ω 1) h d3 l3 → ∀ g : (wcProjK Ω 1).functionField, wcLr1uMob (wcProjKStr Ω 1) d1 d2 d3 g → wcLr1uVtdRT W (wcProjKStr Ω 1) (V : Set (wcProjK Ω 1).functionField) g :=
by
  intro Ω _ _ W _ V hVW c1 c2 c3 h hMh hRT d1 d2 d3 l1 l2 l3 h12 h13 h23 hC1 hC2 hC3 g hMg
  haveI : IsAlgClosed (IsLocalRing.ResidueField ↥W) := wcpa_dj_nc_residue_algclosed Ω W
  haveI : Infinite (IsLocalRing.ResidueField ↥W) := IsAlgClosed.instInfinite

  have t_enc_unit : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (l l' : Option (IsLocalRing.ResidueField ↥W)) (x y x' y' : ↥W), l ≠ l' → (∀ ℓ, l = some ℓ → IsLocalRing.residue ↥W x = ℓ ∧ y = 1) → (l = none → x = 1 ∧ y ∈ IsLocalRing.maximalIdeal ↥W) → (∀ ℓ, l' = some ℓ → IsLocalRing.residue ↥W x' = ℓ ∧ y' = 1) → (l' = none → x' = 1 ∧ y' ∈ IsLocalRing.maximalIdeal ↥W) → IsUnit (x' * y - x * y') := by
    intro Ω _ W l l' x y x' y'
    intro hne h1 h2 h3 h4
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
    cases l with
    | none =>
      cases l' with
      | none => exact absurd rfl hne
      | some ℓ' =>
        obtain ⟨hx, hy⟩ := h2 rfl
        obtain ⟨hx', hy'⟩ := h3 ℓ' rfl
        rw [← IsLocalRing.residue_eq_zero_iff] at hy
        simp [hx, hy, hx', hy']
    | some ℓ =>
      obtain ⟨hx, hy⟩ := h1 ℓ rfl
      cases l' with
      | none =>
        obtain ⟨hx', hy'⟩ := h4 rfl
        rw [← IsLocalRing.residue_eq_zero_iff] at hy'
        simp [hx, hy, hx', hy']
      | some ℓ' =>
        obtain ⟨hx', hy'⟩ := h3 ℓ' rfl
        simp only [map_sub, map_mul, hx, hx', hy, hy', map_one, mul_one, ne_eq, sub_eq_zero]
        intro h; exact hne (by rw [h])
  have t_cross_ratio : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (K : Type u) [Field K] (φ : Ω →+* K) (g h : K) (α β γ δ : Ω) (x1 y1 x2 y2 x3 y3 : ↥W), α * δ - β * γ ≠ 0 → g * (φ γ * h + φ δ) = φ α * h + φ β → α * (x1 : Ω) + β * (y1 : Ω) = 0 → α * (x2 : Ω) + β * (y2 : Ω) = γ * (x2 : Ω) + δ * (y2 : Ω) → γ * (x3 : Ω) + δ * (y3 : Ω) = 0 → IsUnit (x2 * y1 - x1 * y2) → IsUnit (x2 * y3 - x3 * y2) → IsUnit (x3 * y1 - x1 * y3) → ∃ lam : ↥W, IsUnit lam ∧ g * (φ (y3 : Ω) * h - φ (x3 : Ω)) = φ (lam : Ω) * (φ (y1 : Ω) * h - φ (x1 : Ω)) := by
    intro Ω _ W K _ φ g h α β γ δ x1 y1 x2 y2 x3 y3
    intro hdet hrel E1 E2 E3 u12 u32 u13
    have hD12 : ((x2 : Ω) * y1 - x1 * y2) ≠ 0 := by
      have : ((x2 * y1 - x1 * y2 : ↥W) : Ω) ≠ 0 := fun h0 => u12.ne_zero (Subtype.ext h0)
      push_cast at this; exact this
    have hD13 : ((x3 : Ω) * y1 - x1 * y3) ≠ 0 := by
      have : ((x3 * y1 - x1 * y3 : ↥W) : Ω) ≠ 0 := fun h0 => u13.ne_zero (Subtype.ext h0)
      push_cast at this; exact this
    refine ⟨(x2 * y3 - x3 * y2) * ↑(u12.unit⁻¹), u32.mul (u12.unit⁻¹).isUnit, ?_⟩
    set lam : ↥W := (x2 * y3 - x3 * y2) * ↑(u12.unit⁻¹) with hlamdef
    have hlamW : lam * (x2 * y1 - x1 * y2) = x2 * y3 - x3 * y2 := by
      rw [hlamdef, mul_assoc, IsUnit.val_inv_mul, mul_one]
    have hlam : (lam : Ω) * ((x2 : Ω) * y1 - x1 * y2) = (x2 : Ω) * y3 - x3 * y2 := by
      have := congrArg Subtype.val hlamW
      push_cast at this; exact this
    obtain ⟨D, hDdef⟩ : ∃ D : Ω, D = (x3 : Ω) * y1 - x1 * y3 := ⟨_, rfl⟩
    obtain ⟨A, hAdef⟩ : ∃ A : Ω, A = α * x3 + β * y3 := ⟨_, rfl⟩
    obtain ⟨B, hBdef⟩ : ∃ B : Ω, B = -(γ * x1 + δ * y1) := ⟨_, rfl⟩
    have hα : α * D = A * y1 := by rw [hDdef, hAdef]; linear_combination (-(y3 : Ω)) * E1
    have hβ : β * D = -(A * x1) := by rw [hDdef, hAdef]; linear_combination (x3 : Ω) * E1
    have hγ : γ * D = B * y3 := by rw [hDdef, hBdef]; linear_combination (y1 : Ω) * E3
    have hδ : δ * D = -(B * x3) := by rw [hDdef, hBdef]; linear_combination (-(x1 : Ω)) * E3
    have hAB : A * ((x2 : Ω) * y1 - x1 * y2) = B * ((x2 : Ω) * y3 - x3 * y2) := by
      linear_combination (-(x2 : Ω)) * hα - (y2 : Ω) * hβ + (x2 : Ω) * hγ + (y2 : Ω) * hδ + D * E2
    have hA : A = B * lam := by
      have h0 : (A - B * lam) * ((x2 : Ω) * y1 - x1 * y2) = 0 := by
        linear_combination hAB - B * hlam
      exact sub_eq_zero.mp ((mul_eq_zero.mp h0).resolve_right hD12)
    have hB : B ≠ 0 := by
      intro hB0
      have h0 : (α * δ - β * γ) * (D * D) = -(A * B * D) := by
        linear_combination (δ * D) * hα + (A * y1) * hδ - (γ * D) * hβ + (A * x1) * hγ + (A * B) * hDdef
      rw [hB0, mul_zero, zero_mul, neg_zero] at h0
      have hD0 : D ≠ 0 := hDdef ▸ hD13
      exact hdet ((mul_eq_zero.mp h0).resolve_right (mul_ne_zero hD0 hD0))
    have hα' := congrArg φ hα
    have hβ' := congrArg φ hβ
    have hγ' := congrArg φ hγ
    have hδ' := congrArg φ hδ
    have hA' := congrArg φ hA
    simp only [map_mul, map_neg] at hα' hβ' hγ' hδ' hA'
    have key : φ B * (g * (φ (y3 : Ω) * h - φ (x3 : Ω)) - φ (lam : Ω) * (φ (y1 : Ω) * h - φ (x1 : Ω))) = 0 := by
      linear_combination φ D * hrel - g * h * hγ' - g * hδ' + h * hα' + hβ' + (φ (y1 : Ω) * h - φ (x1 : Ω)) * hA'
    exact sub_eq_zero.mp ((mul_eq_zero.mp key).resolve_left ((map_ne_zero φ).mpr hB))
  have t_transform_primitive : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [Infinite (IsLocalRing.ResidueField A)] (q : Polynomial A) (lam x1 y1 x3 y3 : A), (∃ i, IsUnit (q.coeff i)) → IsUnit lam → IsUnit (x3 * y1 - x1 * y3) → ∃ i, IsUnit ((∑ k ∈ Finset.range (q.natDegree + 1), Polynomial.C (q.coeff k * lam ^ k) * (Polynomial.C y1 * Polynomial.X - Polynomial.C x1) ^ k * (Polynomial.C y3 * Polynomial.X - Polynomial.C x3) ^ (q.natDegree - k)).coeff i) := by
    intro A _ _ _ q lam x1 y1 x3 y3
    classical
    intro hq hlam hD
    by_contra hcon
    push Not at hcon
    have hres : ∀ a : A, IsUnit a ↔ IsLocalRing.residue A a ≠ 0 := fun a =>
      (IsLocalRing.residue_ne_zero_iff_isUnit a).symm
    have hQ0 : ∀ t : IsLocalRing.ResidueField A, (∑ k ∈ Finset.range (q.natDegree + 1), Polynomial.C (q.coeff k * lam ^ k) * (Polynomial.C y1 * Polynomial.X - Polynomial.C x1) ^ k * (Polynomial.C y3 * Polynomial.X - Polynomial.C x3) ^ (q.natDegree - k)).eval₂ (IsLocalRing.residue A) t = 0 := by
      intro t
      have hm : (∑ k ∈ Finset.range (q.natDegree + 1), Polynomial.C (q.coeff k * lam ^ k) * (Polynomial.C y1 * Polynomial.X - Polynomial.C x1) ^ k * (Polynomial.C y3 * Polynomial.X - Polynomial.C x3) ^ (q.natDegree - k)).map (IsLocalRing.residue A) = 0 := by
        ext i
        rw [Polynomial.coeff_map, Polynomial.coeff_zero]
        by_contra hne
        exact hcon i ((hres _).mpr hne)
      rw [← Polynomial.eval_map, hm, Polynomial.eval_zero]
    obtain ⟨i0, hi0⟩ := hq
    have hr : q.map (IsLocalRing.residue A) ≠ 0 := by
      intro h0
      have := congrArg (fun p => p.coeff i0) h0
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at this
      exact (hres _).mp hi0 this
    have hl : IsLocalRing.residue A lam ≠ 0 := (hres _).mp hlam
    have hDb : IsLocalRing.residue A x3 * IsLocalRing.residue A y1 - IsLocalRing.residue A x1 * IsLocalRing.residue A y3 ≠ 0 := by
      rw [← map_mul, ← map_mul, ← map_sub]; exact (hres _).mp hD
    set ρ := IsLocalRing.residue A with hρ
    have hF : (Polynomial.C (ρ lam * ρ y1) - Polynomial.C (ρ y3) * Polynomial.X) ≠ 0 := by
      intro h0
      have h1 := congrArg (fun p => p.coeff 1) h0
      have h0' := congrArg (fun p => p.coeff 0) h0
      simp at h1 h0'
      rcases h0' with h0' | h0'
      · exact hl h0'
      · apply hDb; rw [h0', h1]; ring
    obtain ⟨s, hs⟩ : ∃ s, ((q.map ρ) * (Polynomial.C (ρ lam * ρ y1) - Polynomial.C (ρ y3) * Polynomial.X)).eval s ≠ 0 := by
      by_contra h0
      push Not at h0
      exact mul_ne_zero hr hF (Polynomial.funext (fun r => by rw [h0 r, Polynomial.eval_zero]))
    rw [Polynomial.eval_mul] at hs
    have hrs : (q.map ρ).eval s ≠ 0 := left_ne_zero_of_mul hs
    have hc : ρ lam * ρ y1 - s * ρ y3 ≠ 0 := by
      have h2 := right_ne_zero_of_mul hs
      intro h0; apply h2
      simp only [Polynomial.eval_sub, Polynomial.eval_C, Polynomial.eval_mul, Polynomial.eval_X]
      linear_combination h0
    set t := (ρ lam * ρ x1 - s * ρ x3) / (ρ lam * ρ y1 - s * ρ y3) with htdef
    have ht : t * (ρ lam * ρ y1 - s * ρ y3) = ρ lam * ρ x1 - s * ρ x3 := by
      rw [htdef]; exact div_mul_cancel₀ _ hc
    have hℓ : ρ lam * (ρ y1 * t - ρ x1) = s * (ρ y3 * t - ρ x3) := by
      linear_combination ht
    have hℓ3 : ρ y3 * t - ρ x3 ≠ 0 := by
      intro h0
      apply mul_ne_zero hl hDb
      linear_combination (ρ y3) * ht - (ρ lam * ρ y1 - s * ρ y3) * h0
    have hev := hQ0 t
    simp only [Polynomial.eval₂_finsetSum, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_pow, Polynomial.eval₂_sub, Polynomial.eval₂_X, map_mul, map_pow] at hev
    have hsum : ∑ k ∈ Finset.range (q.natDegree + 1), ρ (q.coeff k) * ρ lam ^ k * (ρ y1 * t - ρ x1) ^ k * (ρ y3 * t - ρ x3) ^ (q.natDegree - k) = (ρ y3 * t - ρ x3) ^ q.natDegree * (q.map ρ).eval s := by
      rw [Polynomial.eval_eq_sum_range' (n := q.natDegree + 1) (lt_of_le_of_lt Polynomial.natDegree_map_le (Nat.lt_succ_self _)), Finset.mul_sum]
      refine Finset.sum_congr rfl (fun k hk => ?_)
      have hkn : k ≤ q.natDegree := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
      rw [Polynomial.coeff_map]
      have hpow : ρ lam ^ k * (ρ y1 * t - ρ x1) ^ k = s ^ k * (ρ y3 * t - ρ x3) ^ k := by
        rw [← mul_pow, ← mul_pow, hℓ]
      rw [← pow_mul_pow_sub (ρ y3 * t - ρ x3) hkn]
      linear_combination (ρ (q.coeff k) * (ρ y3 * t - ρ x3) ^ (q.natDegree - k)) * hpow
    rw [hsum] at hev
    exact mul_ne_zero (pow_ne_zero _ hℓ3) hrs hev
