    rwa [Set.biUnion_of_singleton] at h1
  let Fc : C.Opens := ⟨((U : Set C)ᶜ \ {x})ᶜ, hFcl.isOpen_compl⟩
  have hxFc : x ∈ Fc := by
    show x ∈ ((U : Set C)ᶜ \ {x})ᶜ
