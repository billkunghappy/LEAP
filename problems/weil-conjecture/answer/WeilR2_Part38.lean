      (∀ i, wcLr1uValAt (wcProjKStr Ω 1) pt (g i) (v i : Ω)) →
      ∀ q : MvPolynomial (Fin 2) ↥W, wcLr1uValAt (wcProjKStr Ω 1) pt
        (MvPolynomial.eval₂ ((wcLr1uConst (wcProjKStr Ω 1)).comp W.subtype) g q)
        ((MvPolynomial.eval v q : ↥W) : Ω) := by
    intro pt g v hg q
    induction q using MvPolynomial.induction_on with
    | C w =>
      rw [MvPolynomial.eval₂_C, MvPolynomial.eval_C]
      exact V3 pt (w : Ω)
    | add p q hp hq =>
      rw [MvPolynomial.eval₂_add, map_add]
      exact Vadd _ _ _ _ _ hp hq
    | mul_X p n hp =>
      rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, map_mul, MvPolynomial.eval_X]
      exact Vmul _ _ _ _ _ hp (hg n)
  have Vres : ∀ (v : Fin 2 → ↥W), (∀ i, v i ∈ IsLocalRing.maximalIdeal ↥W) →
      ∀ q : MvPolynomial (Fin 2) ↥W,
        MvPolynomial.eval v q - MvPolynomial.constantCoeff q ∈ IsLocalRing.maximalIdeal ↥W := by
    intro v hv q
    induction q using MvPolynomial.induction_on with
    | C w =>
      rw [MvPolynomial.eval_C, MvPolynomial.constantCoeff_C, sub_self]
      exact zero_mem _
    | add p q hp hq =>
      rw [map_add, map_add, add_sub_add_comm]
      exact add_mem hp hq
    | mul_X p n hp =>
      rw [map_mul, map_mul, MvPolynomial.eval_X, MvPolynomial.constantCoeff_X, mul_zero, sub_zero]
      exact Ideal.mul_mem_left _ _ (hv n)

  constructor
  ·
    intro hall
    obtain ⟨l, hl, hlm⟩ := hall a
    obtain ⟨l', hl', hl'm⟩ := hall a'
    rw [hga] at hl
    rw [hga'] at hl'
    have hh0 : h ≠ 0 := by
      obtain ⟨-, -, ⟨s3, -, hs3⟩, -⟩ := hmob
      intro h0
      rw [h0, mul_zero] at hs3
      exact zero_ne_one hs3
    have hprod := Vmul _ _ _ _ _ hl hl'
    have e : h * (wcLr1uConst (wcProjKStr Ω 1) (ϖ : Ω) * h⁻¹) =
        wcLr1uConst (wcProjKStr Ω 1) (ϖ : Ω) := by
      rw [mul_left_comm, mul_inv_cancel₀ hh0, mul_one]
    rw [e] at hprod
    have hll : (l : Ω) * (l' : Ω) = (ϖ : Ω) := Vuniq _ _ _ _ hprod (V3 _ _)
    exact ⟨l, l', hlm ha, hl'm ha', Subtype.ext hll, hl⟩
  ·
    intro hann
    obtain ⟨l, l', hlm, hl'm, hll', hl⟩ := hann
    have hl0 : (l : Ω) ≠ 0 := by
      intro h0
      apply hϖ0
      rw [← hll']
      exact Subtype.ext (by show (l : Ω) * l' = 0; rw [h0, zero_mul])
    have hl'v : wcLr1uValAt (wcProjKStr Ω 1) (P (IsLocalRing.closedPoint Ω))
        (wcLr1uConst (wcProjKStr Ω 1) (ϖ : Ω) * h⁻¹) (l' : Ω) := by
      have e : (ϖ : Ω) * (l : Ω)⁻¹ = l' := by
        rw [← hll']
        show (l : Ω) * l' * (l : Ω)⁻¹ = l'
        rw [mul_comm (l : Ω), mul_assoc, mul_inv_cancel₀ hl0, mul_one]
      rw [← e]
      exact Vmul _ _ _ _ _ (V3 _ _) (Vinv _ _ _ hl0 hl)
    have hg : ∀ i : Fin 2, wcLr1uValAt (wcProjKStr Ω 1) (P (IsLocalRing.closedPoint Ω))
        ((![h, wcLr1uConst (wcProjKStr Ω 1) (ϖ : Ω) * h⁻¹] : Fin 2 → (wcProjK Ω 1).functionField) i)
        (((![l, l'] : Fin 2 → ↥W) i : ↥W) : Ω) :=
      Fin.forall_fin_two.mpr ⟨hl, hl'v⟩
    have hv : ∀ i : Fin 2, (![l, l'] : Fin 2 → ↥W) i ∈ IsLocalRing.maximalIdeal ↥W :=
      Fin.forall_fin_two.mpr ⟨hlm, hl'm⟩
    intro c
    obtain ⟨p, q, hqu, hpm, hrel⟩ := hrep c
    have hQ := Vpoly _ _ _ hg q
    have hPv := Vpoly _ _ _ hg p
    have hQres := Vres _ hv q
    have hPres := Vres _ hv p
    have hQu : IsUnit (MvPolynomial.eval (![l, l'] : Fin 2 → ↥W) q) := by
      by_contra hn
      have hm : MvPolynomial.eval (![l, l'] : Fin 2 → ↥W) q ∈ IsLocalRing.maximalIdeal ↥W :=
        (IsLocalRing.mem_maximalIdeal _).mpr hn
      have hcc : MvPolynomial.constantCoeff q ∈ IsLocalRing.maximalIdeal ↥W := by
        have := sub_mem hm hQres
        rwa [sub_sub_cancel] at this
      exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hcc) hqu
    have hQ0 : ((MvPolynomial.eval (![l, l'] : Fin 2 → ↥W) q : ↥W) : Ω) ≠ 0 := by
      intro h0
      have h1 : MvPolynomial.eval (![l, l'] : Fin 2 → ↥W) q = 0 := Subtype.ext h0
      rw [h1] at hQu
      exact not_isUnit_zero hQu
    have hE0 : MvPolynomial.eval₂ ((wcLr1uConst (wcProjKStr Ω 1)).comp W.subtype)
        ![h, wcLr1uConst (wcProjKStr Ω 1) (ϖ : Ω) * h⁻¹] q ≠ 0 := by
      intro h0
      rw [h0] at hQ
      have h00 := V3 (P (IsLocalRing.closedPoint Ω)) 0
      rw [map_zero] at h00
      exact hQ0 (Vuniq _ _ _ _ hQ h00)
    have hgerm := (eq_mul_inv_iff_mul_eq₀ hE0).mpr hrel
    have hinvQ : ((↑hQu.unit⁻¹ : ↥W) : Ω) =
        ((MvPolynomial.eval (![l, l'] : Fin 2 → ↥W) q : ↥W) : Ω)⁻¹ := by
      apply eq_inv_of_mul_eq_one_left
      exact congrArg Subtype.val hQu.val_inv_mul
    refine ⟨MvPolynomial.eval (![l, l'] : Fin 2 → ↥W) p * ↑hQu.unit⁻¹, ?_, ?_⟩
    · rw [hgerm]
      have e : ((MvPolynomial.eval (![l, l'] : Fin 2 → ↥W) p * ↑hQu.unit⁻¹ : ↥W) : Ω) =
          ((MvPolynomial.eval (![l, l'] : Fin 2 → ↥W) p : ↥W) : Ω) *
            ((MvPolynomial.eval (![l, l'] : Fin 2 → ↥W) q : ↥W) : Ω)⁻¹ := by
        rw [← hinvQ]; rfl
      rw [e]
      exact Vmul _ _ _ _ _ hPv (Vinv _ _ _ hQ0 hQ)
    · intro hc
      have hp0 := hpm hc
      have hpm' : MvPolynomial.eval (![l, l'] : Fin 2 → ↥W) p ∈ IsLocalRing.maximalIdeal ↥W := by
        have := add_mem hPres hp0
        rwa [sub_add_cancel] at this
      exact Ideal.mul_mem_right _ _ hpm'

theorem wcpa_dj_lr1u_dd_class_count : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) [Infinite (IsLocalRing.ResidueField ↥W)] (α β γ δ : Ω), α * δ - β * γ ≠ 0 → ∀ (Z : Finset (IsLocalRing.ResidueField ↥W)), ((∀ u : ↥W, IsLocalRing.residue ↥W u ∉ Z → γ * (u : Ω) + δ ≠ 0 ∧ ∃ l : ↥W, l ∈ IsLocalRing.maximalIdeal ↥W ∧ (l : Ω) = (α * (u : Ω) + β) / (γ * (u : Ω) + δ)) → ((δ ≠ 0 ∧ ∃ l : ↥W, l ∈ IsLocalRing.maximalIdeal ↥W ∧ (l : Ω) = β / δ) ∧ (γ + δ ≠ 0 ∧ ∃ l : ↥W, l ∈ IsLocalRing.maximalIdeal ↥W ∧ (l : Ω) = (α + β) / (γ + δ))) ∨ ((δ ≠ 0 ∧ ∃ l : ↥W, l ∈ IsLocalRing.maximalIdeal ↥W ∧ (l : Ω) = β / δ) ∧ (γ ≠ 0 ∧ ∃ l : ↥W, l ∈ IsLocalRing.maximalIdeal ↥W ∧ (l : Ω) = α / γ)) ∨ ((γ + δ ≠ 0 ∧ ∃ l : ↥W, l ∈ IsLocalRing.maximalIdeal ↥W ∧ (l : Ω) = (α + β) / (γ + δ)) ∧ (γ ≠ 0 ∧ ∃ l : ↥W, l ∈ IsLocalRing.maximalIdeal ↥W ∧ (l : Ω) = α / γ))) ∧ (∀ ϖ : ↥W, (∀ u : ↥W, IsLocalRing.residue ↥W u ∉ Z → γ * (u : Ω) + δ ≠ 0 ∧ ∃ l l' : ↥W, l ∈ IsLocalRing.maximalIdeal ↥W ∧ l' ∈ IsLocalRing.maximalIdeal ↥W ∧ l * l' = ϖ ∧ (l : Ω) = (α * (u : Ω) + β) / (γ * (u : Ω) + δ)) → (δ ≠ 0 ∧ ∃ l l' : ↥W, l ∈ IsLocalRing.maximalIdeal ↥W ∧ l' ∈ IsLocalRing.maximalIdeal ↥W ∧ l * l' = ϖ ∧ (l : Ω) = β / δ) ∨ (γ + δ ≠ 0 ∧ ∃ l l' : ↥W, l ∈ IsLocalRing.maximalIdeal ↥W ∧ l' ∈ IsLocalRing.maximalIdeal ↥W ∧ l * l' = ϖ ∧ (l : Ω) = (α + β) / (γ + δ)) ∨ (γ ≠ 0 ∧ ∃ l l' : ↥W, l ∈ IsLocalRing.maximalIdeal ↥W ∧ l' ∈ IsLocalRing.maximalIdeal ↥W ∧ l * l' = ϖ ∧ (l : Ω) = α / γ)) :=
by
  intro Ω _ W _ α β γ δ _ Z
  classical

  have pd_iff : ∀ x : Ω, (∃ l : ↥W, l ∈ IsLocalRing.maximalIdeal ↥W ∧ (l : Ω) = x) ↔
      W.valuation x < 1 := by
    intro x
    constructor
    · rintro ⟨l, hl, rfl⟩
      exact (W.valuation_lt_one_iff l).mp hl
    · intro hx
      have hxW : x ∈ W := (W.valuation_le_one_iff x).mp hx.le
      exact ⟨⟨x, hxW⟩, (W.valuation_lt_one_iff _).mpr hx, rfl⟩

  have pa_iff : ∀ (ϖ : ↥W) (x : Ω), (∃ l l' : ↥W, l ∈ IsLocalRing.maximalIdeal ↥W ∧
      l' ∈ IsLocalRing.maximalIdeal ↥W ∧ l * l' = ϖ ∧ (l : Ω) = x) ↔
      (W.valuation x < 1 ∧ (ϖ = 0 ∨ W.valuation (ϖ : Ω) < W.valuation x)) := by
    intro ϖ x
    constructor
    · rintro ⟨l, l', hl, hl', hll', rfl⟩
      refine ⟨(W.valuation_lt_one_iff l).mp hl, ?_⟩
      by_cases h0 : ϖ = 0
      · exact Or.inl h0
      · right
        have hc : (l : Ω) * (l' : Ω) = (ϖ : Ω) := by rw [← hll']; rfl
        have hl0 : (l : Ω) ≠ 0 := by
          intro h
          apply h0
          apply Subtype.ext
          rw [← hc, h, zero_mul]
          rfl
        have hpos : 0 < W.valuation (l : Ω) :=
          zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr hl0)
        rw [← hc, Valuation.map_mul]
        exact mul_lt_of_lt_one_right hpos ((W.valuation_lt_one_iff l').mp hl')
    · rintro ⟨hx, hϖ⟩
      have hxW : x ∈ W := (W.valuation_le_one_iff x).mp hx.le
      have hlm : (⟨x, hxW⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W :=
        (W.valuation_lt_one_iff _).mpr hx
      rcases hϖ with h0 | hlt
      · exact ⟨⟨x, hxW⟩, 0, hlm, Ideal.zero_mem _, by rw [mul_zero, h0], rfl⟩
      · have hx0 : x ≠ 0 := by
          intro h
          rw [h, Valuation.map_zero] at hlt
          exact not_lt_zero' hlt
        have hvx : 0 < W.valuation x := zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr hx0)
        have hy : W.valuation ((ϖ : Ω) / x) < 1 := by
          rw [map_div₀]
          exact (div_lt_one₀ hvx).mpr hlt
        have hyW : (ϖ : Ω) / x ∈ W := (W.valuation_le_one_iff _).mp hy.le
        refine ⟨⟨x, hxW⟩, ⟨(ϖ : Ω) / x, hyW⟩, hlm, (W.valuation_lt_one_iff _).mpr hy, ?_, rfl⟩
        apply Subtype.ext
        show x * ((ϖ : Ω) / x) = (ϖ : Ω)
        field_simp

  have upper : ∀ (a b : Ω) (u : ↥W),
      W.valuation (a * (u : Ω) + b) ≤ max (W.valuation a) (W.valuation b) := by
    intro a b u
    refine (Valuation.map_add _ _ _).trans (max_le_max ?_ le_rfl)
    rw [Valuation.map_mul]
    exact mul_le_of_le_one_right' (W.valuation_le_one u)
  have two_classes : ∀ (a b : Ω) (u₁ u₂ : ↥W),
      IsLocalRing.residue ↥W u₁ ≠ IsLocalRing.residue ↥W u₂ →
      W.valuation (a * (u₁ : Ω) + b) = max (W.valuation a) (W.valuation b) ∨
      W.valuation (a * (u₂ : Ω) + b) = max (W.valuation a) (W.valuation b) := by
    intro a b u₁ u₂ hne
    by_contra hcon
    push_neg at hcon
    obtain ⟨h1, h2⟩ := hcon
    have l1 := lt_of_le_of_ne (upper a b u₁) h1
    have l2 := lt_of_le_of_ne (upper a b u₂) h2
    have hw : IsUnit (u₁ - u₂) := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit, map_sub]
      exact sub_ne_zero.mpr hne
    have hw1 : W.valuation ((u₁ - u₂ : ↥W) : Ω) = 1 := (W.valuation_eq_one_iff _).mp hw
    have hwc : ((u₁ - u₂ : ↥W) : Ω) = (u₁ : Ω) - (u₂ : Ω) := rfl
    have hA : W.valuation a < max (W.valuation a) (W.valuation b) := by
      have e : W.valuation a = W.valuation ((a * (u₁ : Ω) + b) - (a * (u₂ : Ω) + b)) := by
        rw [show (a * (u₁ : Ω) + b) - (a * (u₂ : Ω) + b) = a * ((u₁ - u₂ : ↥W) : Ω) by
          rw [hwc]; ring, Valuation.map_mul, hw1, mul_one]
      calc W.valuation a = _ := e
        _ < _ := lt_of_le_of_lt (Valuation.map_sub _ _ _) (max_lt l1 l2)
    have hB : W.valuation b < max (W.valuation a) (W.valuation b) := by
      have e : W.valuation b =
          W.valuation ((u₁ : Ω) * (a * (u₂ : Ω) + b) - (u₂ : Ω) * (a * (u₁ : Ω) + b)) := by
        rw [show (u₁ : Ω) * (a * (u₂ : Ω) + b) - (u₂ : Ω) * (a * (u₁ : Ω) + b) =
          b * ((u₁ - u₂ : ↥W) : Ω) by rw [hwc]; ring, Valuation.map_mul, hw1, mul_one]
      refine e.trans_lt (lt_of_le_of_lt (Valuation.map_sub _ _ _) (max_lt ?_ ?_))
      · rw [Valuation.map_mul]
        exact lt_of_le_of_lt (mul_le_of_le_one_left' (W.valuation_le_one u₁)) l2
      · rw [Valuation.map_mul]
        exact lt_of_le_of_lt (mul_le_of_le_one_left' (W.valuation_le_one u₂)) l1
    exact lt_irrefl _ (max_lt hA hB)

  have C : ∀ a b : Ω, ∃ T : Finset (IsLocalRing.ResidueField ↥W), ∀ u : ↥W,
      IsLocalRing.residue ↥W u ∉ T →
      W.valuation (a * (u : Ω) + b) = max (W.valuation a) (W.valuation b) := by
    intro a b
    by_cases h : ∃ u₀ : ↥W, W.valuation (a * (u₀ : Ω) + b) ≠ max (W.valuation a) (W.valuation b)
    · obtain ⟨u₀, hu₀⟩ := h
      refine ⟨{IsLocalRing.residue ↥W u₀}, fun u hu => ?_⟩
      rw [Finset.mem_singleton] at hu
      exact (two_classes a b u u₀ hu).resolve_right hu₀
    · push_neg at h
      exact ⟨∅, fun u _ => h u⟩
  obtain ⟨T₁, hT₁⟩ := C α β
  obtain ⟨T₂, hT₂⟩ := C γ δ
  obtain ⟨c, hc⟩ := Infinite.exists_notMem_finset (Z ∪ T₁ ∪ T₂)
  obtain ⟨u₀, rfl⟩ := IsLocalRing.residue_surjective c
  simp only [Finset.mem_union, not_or] at hc
  obtain ⟨⟨hcZ, hc1⟩, hc2⟩ := hc
  have hN := hT₁ u₀ hc1
  have hD := hT₂ u₀ hc2

  have t3 : ∀ g d : Ω,
      (W.valuation d = max (W.valuation g) (W.valuation d) ∧
        W.valuation (g + d) = max (W.valuation g) (W.valuation d)) ∨
      (W.valuation d = max (W.valuation g) (W.valuation d) ∧
        W.valuation g = max (W.valuation g) (W.valuation d)) ∨
      (W.valuation (g + d) = max (W.valuation g) (W.valuation d) ∧
        W.valuation g = max (W.valuation g) (W.valuation d)) := by
    intro g d
    rcases lt_trichotomy (W.valuation g) (W.valuation d) with h | h | h
    · left
      rw [max_eq_right h.le]
      exact ⟨rfl, Valuation.map_add_eq_of_lt_right _ h⟩
    · right; left
      rw [h, max_self]
      exact ⟨rfl, rfl⟩
    · right; right
      rw [max_eq_left h.le]
      exact ⟨Valuation.map_add_eq_of_lt_left _ h, rfl⟩

  refine ⟨fun H => ?_, fun ϖ HA => ?_⟩
  · obtain ⟨hD0, hpd⟩ := H u₀ hcZ
    rw [pd_iff, map_div₀, hN, hD] at hpd
    have hMD : 0 < max (W.valuation γ) (W.valuation δ) := by
      rw [← hD]
      exact zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr hD0)
    have KEY : max (W.valuation α) (W.valuation β) < max (W.valuation γ) (W.valuation δ) :=
      (div_lt_one₀ hMD).mp hpd
    have Kd : ∀ N' D' : Ω, W.valuation N' ≤ max (W.valuation α) (W.valuation β) →
        W.valuation D' = max (W.valuation γ) (W.valuation δ) →
        D' ≠ 0 ∧ ∃ l : ↥W, l ∈ IsLocalRing.maximalIdeal ↥W ∧ (l : Ω) = N' / D' := by
      intro N' D' hN' hD'
      have hD'pos : 0 < W.valuation D' := by rw [hD']; exact hMD
      refine ⟨(Valuation.ne_zero_iff _).mp hD'pos.ne', ?_⟩
      rw [pd_iff, map_div₀]
      exact (div_lt_one₀ hD'pos).mpr (lt_of_le_of_lt hN' (by rw [hD']; exact KEY))
    have nb : W.valuation β ≤ max (W.valuation α) (W.valuation β) := le_max_right _ _
    have na : W.valuation α ≤ max (W.valuation α) (W.valuation β) := le_max_left _ _
    have nab : W.valuation (α + β) ≤ max (W.valuation α) (W.valuation β) :=
      Valuation.map_add _ _ _
    rcases t3 γ δ with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact Or.inl ⟨Kd β δ nb h1, Kd (α + β) (γ + δ) nab h2⟩
    · exact Or.inr (Or.inl ⟨Kd β δ nb h1, Kd α γ na h2⟩)
    · exact Or.inr (Or.inr ⟨Kd (α + β) (γ + δ) nab h1, Kd α γ na h2⟩)
  · obtain ⟨hD0, hpa⟩ := HA u₀ hcZ
    rw [pa_iff, map_div₀, hN, hD] at hpa
    have hMD : 0 < max (W.valuation γ) (W.valuation δ) := by
      rw [← hD]
      exact zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr hD0)
    have Ka : ∀ N' D' : Ω, W.valuation N' = max (W.valuation α) (W.valuation β) →
        W.valuation D' = max (W.valuation γ) (W.valuation δ) →
        D' ≠ 0 ∧ ∃ l l' : ↥W, l ∈ IsLocalRing.maximalIdeal ↥W ∧
          l' ∈ IsLocalRing.maximalIdeal ↥W ∧ l * l' = ϖ ∧ (l : Ω) = N' / D' := by
      intro N' D' hN' hD'
      have hD'pos : 0 < W.valuation D' := by rw [hD']; exact hMD
      refine ⟨(Valuation.ne_zero_iff _).mp hD'pos.ne', ?_⟩
      rw [pa_iff, map_div₀, hN', hD']
      exact hpa
    rcases t3 γ δ with ⟨d1, d2⟩ | ⟨d1, d2⟩ | ⟨d1, d2⟩
    · rcases t3 α β with ⟨n1, n2⟩ | ⟨n1, n2⟩ | ⟨n1, n2⟩
      · exact Or.inl (Ka β δ n1 d1)
      · exact Or.inl (Ka β δ n1 d1)
      · exact Or.inr (Or.inl (Ka (α + β) (γ + δ) n1 d2))
    · rcases t3 α β with ⟨n1, n2⟩ | ⟨n1, n2⟩ | ⟨n1, n2⟩
      · exact Or.inl (Ka β δ n1 d1)
      · exact Or.inl (Ka β δ n1 d1)
      · exact Or.inr (Or.inr (Ka α γ n2 d2))
    · rcases t3 α β with ⟨n1, n2⟩ | ⟨n1, n2⟩ | ⟨n1, n2⟩
      · exact Or.inr (Or.inl (Ka (α + β) (γ + δ) n2 d1))
