      refine (hS _).2 ⟨d, ?_⟩
      rw [e, Valuation.map_mul, Valuation.map_mul, map_inv₀, hvx, hU d hdU, inv_one, one_mul,
        one_mul, Valuation.map_sub_swap]
      exact h
    refine ⟨hxS, isUnit_iff_exists_inv.mpr ⟨⟨x⁻¹, hinvS⟩, Subtype.ext ?_⟩⟩
    show x * x⁻¹ = 1
    exact mul_inv_cancel₀ hx0
