  have hid : Spec.map (CommRingCat.ofHom (Ee.symm : IsLocalRing.ResidueField ↥R →+*
      AlgebraicClosure (T.residueField t))) ≫
      Spec.map (CommRingCat.ofHom ((IsLocalRing.residue ↥R).comp j)) = 𝟙 _ := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have h1 : (Ee.symm : IsLocalRing.ResidueField ↥R →+* AlgebraicClosure (T.residueField t)).comp
        ((IsLocalRing.residue ↥R).comp j) = RingHom.id _ := by
      ext a
      exact Ee.symm_apply_apply a
    rw [h1, CommRingCat.ofHom_id, Spec.map_id]

  have hcR : wcpaDjSolStab u n τ (IsLocalRing.ResidueField ↥R)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))) ≫ g) := by
    rw [hcl]
    exact wcpa_dj_sso_stab_descend T Z u n τ hpr hfp hτ (IsLocalRing.ResidueField ↥R)
      (AlgebraicClosure (T.residueField t)) (Ee.symm : IsLocalRing.ResidueField ↥R →+*
        AlgebraicClosure (T.residueField t)) _
      (by rw [← Category.assoc, hid, Category.id_comp]; exact hk)
  have hrange : Set.range ⇑g ⊆ (W₀ : Set T) := by
    rintro _ ⟨p, rfl⟩
    rw [hg, hsbar, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply,
      Scheme.fromSpecResidueField_apply, ← ht]
    exact hW

  have hpb : IsPullback (Limits.pullback.fst u g) (Limits.pullback.snd u g) u g :=
    IsPullback.of_hasPullback u g
  let σ : Fin n → (Spec (.of ↥R) ⟶ Limits.pullback u g) := fun i =>
    Limits.pullback.lift (g ≫ τ i) (𝟙 _)
      (by rw [Category.assoc, hτ i, Category.comp_id, Category.id_comp])
  have hσv : ∀ i, σ i ≫ Limits.pullback.snd u g = 𝟙 _ := fun i => Limits.pullback.lift_snd _ _ _
  have hσφ : ∀ i, σ i ≫ Limits.pullback.fst u g = g ≫ τ i := fun i =>
    Limits.pullback.lift_fst _ _ _
  have hFT : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ Spec (.of ↥R)),
      (wcpaDjSolSS (Limits.pullback.snd u g) K s ↔ wcpaDjSolSS u K (s ≫ g)) ∧
      (wcpaDjSolStab (Limits.pullback.snd u g) n σ K s ↔ wcpaDjSolStab u n τ K (s ≫ g)) :=
    fun K _ s => wcpa_dj_sol_fibre_transfer T (Spec (.of ↥R)) Z (Limits.pullback u g) u τ g
      (Limits.pullback.snd u g) (Limits.pullback.fst u g) σ hpb hτ hσv hσφ K s
  have hrs : ∀ {K : Type u} [Field K] (s : Spec (.of K) ⟶ Spec (.of ↥R)),
      Set.range ⇑(s ≫ g) ⊆ (W₀ : Set T) := by
    intro K _ s
    rintro _ ⟨p, rfl⟩
    rw [Scheme.Hom.comp_apply]
    exact hrange ⟨_, rfl⟩
  have huτ : ∀ i x, u (τ i x) = x := fun i x => by
    rw [← Scheme.Hom.comp_apply, hτ i]; rfl
  have hss : wcpaDjSemistable (Limits.pullback.snd u g) :=
    ⟨MorphismProperty.of_isPullback (P := @Flat) hpb hfl,
      MorphismProperty.of_isPullback (P := @IsProper) hpb hpr,
      fun K _ _ s => (hFT K s).1.mpr (hSS K (s ≫ g) (hrs s))⟩
  have hsec : wcpaDjSections (Limits.pullback.snd u g) n σ := by
    refine ⟨hσv, ?_, ?_⟩
    · intro i j p q hij heq
      have h1 := congrArg (⇑(Limits.pullback.fst u g)) heq
      rw [pt (hσφ i) p, pt (hσφ j) q, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
      have h2 : g p = g q := by
        have h3 := congrArg (⇑u) h1
        rwa [huτ, huτ] at h3
      rw [← h2] at h1
      exact hdis i j (g p) (hrange ⟨p, rfl⟩) hij h1
    · intro j p
      obtain ⟨W, hW, hWsm⟩ := hsm j (g p) (hrange ⟨p, rfl⟩)
      refine ⟨Limits.pullback.fst u g ⁻¹ᵁ W, ?_, ?_⟩
      · rw [Scheme.Hom.mem_preimage, pt (hσφ j) p, Scheme.Hom.comp_apply]
        exact hW
      · exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1)
          ((isPullback_morphismRestrict (Limits.pullback.fst u g) W).paste_vert hpb) hWsm
  have hstabv := (hFT _ _).2.mpr hcR

  have hgen := wcpa_dj_lus_cfs_valuation_specialize K R hκ (Limits.pullback u g)
    (Limits.pullback.snd u g) n σ hss hsec hstabv
  have hfin := (hFT K _).2.mp hgen
  have hcomp : (algebraMap ↥R K).comp j = ψ := by
    ext a
    rw [RingHom.comp_apply, ValuationSubring.algebraMap_apply, hj]
  have hgs : Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) ≫ g = s := by
    rw [hψ, hg, ← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp]
  rwa [hgs] at hfin

theorem wcpa_dj_lfc_closed_exc_datum : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (k : ℕ)
    (σ : Fin (k + 1) → (Spec (.of ↥W) ⟶ Z₁))
    (τκ : Fin (k + 1) → (Spec (.of (IsLocalRing.ResidueField ↥W)) ⟶ Limits.pullback u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))),
    wcpaDjStablePtd u₁ (k + 1) σ →
    (∀ i, τκ i ≫ Limits.pullback.snd u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) = 𝟙 _) →
    (∀ i, τκ i ≫ Limits.pullback.fst u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) =
      Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) ≫ σ i) →
    wcpaDjStablePtd (Limits.pullback.snd u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) (k + 1) τκ →
    ¬ wcpaDjStablePtd (Limits.pullback.snd u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) k
      (fun i => τκ (Fin.castSucc i)) →
    ∃ E₀ : Set ↥(Limits.pullback u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
      E₀ ∈ irreducibleComponents ↥(Limits.pullback u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ∧
      (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
        (θ : Er ≅ @Proj _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W))
          MvPolynomial.gradedAlgebra),
        IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E₀ ∧
        θ.hom ≫ @Proj.toSpecZero _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W))
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap (IsLocalRing.ResidueField ↥W)
              ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W) 0))) =
        ι ≫ Limits.pullback.snd u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ∧
      (∃ x ∈ E₀, ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
        Limits.pullback.fst u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x =
        σ (Fin.last k)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q)) ∧
      (E₀ ∩ closure E₀ᶜ).ncard + Nat.card {i : Fin k // ∃ x ∈ E₀,
        ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
        Limits.pullback.fst u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x =
        σ (Fin.castSucc i)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q)} ≤ 2 :=
by
  intro Ω _ _ W Z₁ u₁ k σ τκ hst hτs hτf hstκ hcl
  classical
  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]

  have spu : ∀ (X P V C : Scheme.{u}) (f : X ⟶ P) (b : V ⟶ P)
      (ψ : C ⟶ X) (g : C ⟶ V) (σ : P ⟶ X) (τ : V ⟶ C), IsPullback ψ g f b → σ ≫ f = 𝟙 P →
      τ ≫ g = 𝟙 V → τ ≫ ψ = b ≫ σ → ∀ c : C, ψ c = σ (b (g c)) ↔ c = τ (g c) := by
    intro X P V C f b ψ g σ τ H1 H2 H3 H4 c
    have hcomp : ∀ x : V, ψ (τ x) = σ (b x) := by
      intro x
      rw [← Scheme.Hom.comp_apply, H4, Scheme.Hom.comp_apply]
    have hgτ : ∀ x : V, g (τ x) = x := by
      intro x
      rw [← Scheme.Hom.comp_apply, H3]
      rfl
    constructor
    · intro h
      have hout : IsPullback (τ ≫ g) b b (σ ≫ f) := by
        rw [H3, H2]
        exact IsPullback.id_horiz b
      have hsq : IsPullback τ b ψ σ := IsPullback.of_right hout H4 H1.flip
      obtain ⟨p, hp, _⟩ := Scheme.exists_preimage_of_isPullback hsq c (b (g c)) h
      have hg : g c = p := by rw [← hp, hgτ]
      rw [hg, hp]
    · intro h
      calc ψ c = ψ (τ (g c)) := congrArg ψ h
        _ = σ (b (g c)) := hcomp (g c)

  have comp_homeo : ∀ {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y] (h : X ≃ₜ Y)
      (E : Set X), E ∈ irreducibleComponents X → h '' E ∈ irreducibleComponents Y := by
    intro X Y _ _ h E hE
    refine image_mem_irreducibleComponents_of_isPreirreducible_fiber h h.continuous h.isOpenMap
      ?_ h.surjective hE
    intro y
    apply Set.Subsingleton.isPreirreducible
    intro a ha a' ha'
    exact h.injective (ha.trans ha'.symm)

  have transfer : ∀ {Z T T' : Scheme.{u}} (uu : Z ⟶ T) (b : T' ⟶ T) (n : ℕ)
      (τ : Fin n → (T ⟶ Z)) (τ' : Fin n → (T' ⟶ Limits.pullback uu b)),
      (∀ i, τ i ≫ uu = 𝟙 T) → (∀ i, τ' i ≫ Limits.pullback.snd uu b = 𝟙 T') →
      (∀ i, τ' i ≫ Limits.pullback.fst uu b = b ≫ τ i) →
      ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ T'),
      (wcpaDjSolStab (Limits.pullback.snd uu b) n τ' K s ↔ wcpaDjSolStab uu n τ K (s ≫ b)) := by
    intro Z T T' uu b n τ τ' hS1 E1 E2 K _ s
    have hpb : IsPullback (Limits.pullback.fst uu b) (Limits.pullback.snd uu b) uu b :=
      IsPullback.of_hasPullback uu b
    obtain ⟨e, I1, I2⟩ : ∃ e : Limits.pullback (Limits.pullback.snd uu b) s ≅
        Limits.pullback uu (s ≫ b),
        e.hom ≫ Limits.pullback.fst uu (s ≫ b) =
          Limits.pullback.fst (Limits.pullback.snd uu b) s ≫ Limits.pullback.fst uu b ∧
        e.hom ≫ Limits.pullback.snd uu (s ≫ b) = Limits.pullback.snd (Limits.pullback.snd uu b) s :=
      ⟨_, Limits.pullbackLeftPullbackSndIso_hom_fst uu b s,
        Limits.pullbackLeftPullbackSndIso_hom_snd uu b s⟩
    have I3 : e.inv ≫ Limits.pullback.snd (Limits.pullback.snd uu b) s =
        Limits.pullback.snd uu (s ≫ b) := by
      rw [← I2, ← Category.assoc, e.inv_hom_id, Category.id_comp]
    obtain ⟨h, hh⟩ : ∃ h : ↥(Limits.pullback (Limits.pullback.snd uu b) s) ≃ₜ
        ↥(Limits.pullback uu (s ≫ b)), ∀ x, h x = e.hom x :=
      ⟨Scheme.homeoOfIso e, Scheme.homeoOfIso_apply e⟩
    have hinv : ∀ y, e.inv y = h.symm y := by
      intro y
      apply h.injective
      rw [Homeomorph.apply_symm_apply, hh, ← Scheme.Hom.comp_apply, e.inv_hom_id]
      rfl
    have hsi : ∀ A : Set ↥(Limits.pullback (Limits.pullback.snd uu b) s),
        h.symm '' (h '' A) = A := by
      intro A
      rw [Set.image_image]
      simp
    have hcnt : ∀ E : Set ↥(Limits.pullback (Limits.pullback.snd uu b) s),
        (h '' E ∩ closure (h '' E)ᶜ).ncard = (E ∩ closure Eᶜ).ncard := by
      intro E
      rw [← h.image_compl, ← h.image_closure, ← Set.image_inter h.injective]
      exact Set.ncard_image_of_injective _ h.injective
    have hcard : ∀ E : Set ↥(Limits.pullback (Limits.pullback.snd uu b) s),
        Nat.card {i : Fin n // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
            Limits.pullback.fst (Limits.pullback.snd uu b) s x = τ' i (s p)} =
          Nat.card {i : Fin n // ∃ y ∈ h '' E, ∃ p : ↥(Spec (.of K)),
            Limits.pullback.fst uu (s ≫ b) y = τ i ((s ≫ b) p)} := by
      intro E
      refine Nat.card_congr (Equiv.subtypeEquivRight ?_)
      intro i
      constructor
      · rintro ⟨x, hx, p, hp⟩
        refine ⟨h x, ⟨x, hx, rfl⟩, p, ?_⟩
        rw [hh, pt I1 x, Scheme.Hom.comp_apply, hp, pt (E2 i) (s p), Scheme.Hom.comp_apply,
          Scheme.Hom.comp_apply]
      · rintro ⟨y, ⟨x, hx, rfl⟩, p, hp⟩
        refine ⟨x, hx, p, ?_⟩
        set c := Limits.pullback.fst (Limits.pullback.snd uu b) s x with hc
        have e1 : Limits.pullback.fst uu b c = τ i (b (s p)) := by
          have h1 := pt I1 x
          rw [Scheme.Hom.comp_apply, ← hh, hp, Scheme.Hom.comp_apply] at h1
          exact h1.symm
        have e2 : Limits.pullback.snd uu b c = s p := by
          rw [hc, pt (Limits.pullback.condition (f := Limits.pullback.snd uu b) (g := s)) x,
            Scheme.Hom.comp_apply,
            Subsingleton.elim (Limits.pullback.snd (Limits.pullback.snd uu b) s x) p]
        have hc1 : Limits.pullback.fst uu b c = τ i (b (Limits.pullback.snd uu b c)) := by
          rw [e2]; exact e1
        have key2 := (spu Z T T' (Limits.pullback uu b) uu b
          (Limits.pullback.fst uu b) (Limits.pullback.snd uu b) (τ i) (τ' i) hpb (hS1 i) (E1 i)
          (E2 i) c).mp hc1
        rw [key2, e2]
    have hdatF : ∀ E : Set ↥(Limits.pullback (Limits.pullback.snd uu b) s),
        (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback (Limits.pullback.snd uu b) s)
          (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra ≫
            Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
            ι ≫ Limits.pullback.snd (Limits.pullback.snd uu b) s) →
        (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback uu (s ≫ b))
          (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = h '' E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra ≫
            Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
            ι ≫ Limits.pullback.snd uu (s ≫ b)) := by
      intro E hdat
      obtain ⟨Er, ι, θ, hci, hred, hrange, hθ⟩ := hdat
      refine ⟨Er, ι ≫ e.hom, θ, inferInstance, hred, ?_, ?_⟩
      · ext y
        constructor
        · rintro ⟨x, rfl⟩
          refine ⟨ι x, ?_, ?_⟩
          · rw [← hrange]; exact ⟨x, rfl⟩
          · rw [hh, Scheme.Hom.comp_apply]
        · rintro ⟨z, hz, rfl⟩
          rw [← hrange] at hz
          obtain ⟨x, rfl⟩ := hz
          exact ⟨x, by rw [hh, Scheme.Hom.comp_apply]⟩
      · rw [hθ, Category.assoc, I2]
    have hdatB : ∀ E : Set ↥(Limits.pullback (Limits.pullback.snd uu b) s),
        (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback uu (s ≫ b))
          (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = h '' E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra ≫
            Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
            ι ≫ Limits.pullback.snd uu (s ≫ b)) →
        (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback (Limits.pullback.snd uu b) s)
          (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra ≫
            Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
            ι ≫ Limits.pullback.snd (Limits.pullback.snd uu b) s) := by
      intro E hdat
      obtain ⟨Er, ι, θ, hci, hred, hrange, hθ⟩ := hdat
      refine ⟨Er, ι ≫ e.inv, θ, inferInstance, hred, ?_, ?_⟩
      · ext x
        constructor
        · rintro ⟨z, rfl⟩
          have hz : ι z ∈ h '' E := by rw [← hrange]; exact ⟨z, rfl⟩
          obtain ⟨x', hx', hxe⟩ := hz
          rw [Scheme.Hom.comp_apply, hinv, ← hxe, Homeomorph.symm_apply_apply]
          exact hx'
        · intro hx
          have hx2 : h x ∈ Set.range ι := by rw [hrange]; exact ⟨x, hx, rfl⟩
          obtain ⟨z, hz⟩ := hx2
          exact ⟨z, by rw [Scheme.Hom.comp_apply, hz, hinv, Homeomorph.symm_apply_apply]⟩
      · rw [hθ, Category.assoc, I3]
    unfold wcpaDjSolStab
    constructor
    · intro hL E' hE' hdat'
      obtain ⟨E, rfl⟩ : ∃ E, E' = h '' E := ⟨h.symm '' E', by rw [Set.image_image]; simp⟩
      have hE : E ∈ irreducibleComponents ↥(Limits.pullback (Limits.pullback.snd uu b) s) := by
        have := comp_homeo h.symm (h '' E) hE'
        rwa [hsi] at this
      have key := hL E hE (hdatB E hdat')
      rw [← hcard E, hcnt E]
      exact key
    · intro hR E hE hdat
      have key := hR (h '' E) (comp_homeo h E hE) (hdatF E hdat)
      rw [← hcard E, hcnt E] at key
      exact key

  have hκR : IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
    apply IsAlgClosed.of_exists_root
    intro p hmon hirr
    obtain ⟨q, hqmap, hqdeg, hqmon⟩ := Polynomial.lifts_and_degree_eq_and_monic
      ((Polynomial.mem_lifts p).mpr
        (Polynomial.map_surjective (IsLocalRing.residue ↥W) IsLocalRing.residue_surjective p)) hmon
    have hdeg : (q.map (algebraMap ↥W Ω)).degree ≠ 0 := by
      rw [Polynomial.degree_map_eq_of_injective (IsFractionRing.injective ↥W Ω), hqdeg]
      exact (Polynomial.degree_pos_of_irreducible hirr).ne'
    obtain ⟨θ, hθ⟩ := IsAlgClosed.exists_root _ hdeg
    have hint : IsIntegral ↥W θ := ⟨q, hqmon, by rw [← Polynomial.eval_map]; exact hθ⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    refine ⟨IsLocalRing.residue ↥W y, ?_⟩
    have hq0 : Polynomial.eval y q = 0 := by
      apply IsFractionRing.injective ↥W Ω
      rw [map_zero, ← Polynomial.eval₂_at_apply, hy, ← Polynomial.eval_map]
      exact hθ
    rw [← hqmap, Polynomial.eval_map, Polynomial.eval₂_at_apply, hq0, map_zero]
  haveI := hκR

  by_contra H
  have hA : wcpaDjSolStab u₁ k (fun i => σ (Fin.castSucc i)) (IsLocalRing.ResidueField ↥W)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) := by
    unfold wcpaDjSolStab
    intro E hE hP1
    by_cases hlast : ∃ x ∈ E, ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
        Limits.pullback.fst u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x =
        σ (Fin.last k)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q)
    · by_contra hlt
      exact H ⟨E, hE, hP1, hlast, Nat.le_of_lt_succ (Nat.lt_of_not_le hlt)⟩
    · have h1 := hst.2.2 (IsLocalRing.ResidueField ↥W)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) E hE hP1
      let f : {j : Fin (k + 1) // ∃ z ∈ E, ∃ p : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
            Limits.pullback.fst u₁
              (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) z =
            σ j (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) p)} →
          {i : Fin k // ∃ z ∈ E, ∃ p : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
            Limits.pullback.fst u₁
              (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) z =
            σ (Fin.castSucc i)
              (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) p)} :=
        fun j => ⟨j.1.castPred (fun h => hlast (by rw [← h]; exact j.2)),
          by rw [Fin.castSucc_castPred]; exact j.2⟩
      have hf : Function.Injective f := by
        intro a b hab
        apply Subtype.ext
        have h := congrArg (fun t => Fin.castSucc t.1) hab
        simpa [f, Fin.castSucc_castPred] using h
      exact h1.trans (Nat.add_le_add_left (Nat.card_le_card_of_injective f hf) _)

  have hA' : wcpaDjSolStab (Limits.pullback.snd u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) k
      (fun i => τκ (Fin.castSucc i)) (IsLocalRing.ResidueField ↥W)
      (𝟙 (Spec (.of (IsLocalRing.ResidueField ↥W)))) :=
    (transfer u₁ (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) k
      (fun i => σ (Fin.castSucc i)) (fun i => τκ (Fin.castSucc i))
      (fun i => hst.2.1.1 _) (fun i => hτs _) (fun i => hτf _) (IsLocalRing.ResidueField ↥W)
      (𝟙 _)).mpr (by rw [Category.id_comp]; exact hA)

  haveI : IsProper (Limits.pullback.snd u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    hstκ.1.2.1
  have hfp : LocallyOfFinitePresentation (Limits.pullback.snd u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    inferInstance

  apply hcl
  refine ⟨hstκ.1, ⟨fun j => hτs _, fun i j p q hij => hstκ.2.1.2.1 _ _ p q
    (fun h => hij (Fin.castSucc_injective _ h)), fun j p => hstκ.2.1.2.2 _ p⟩, ?_⟩
  intro K' _ _ s'
  exact wcpa_dj_sso_field_invariance (Spec (.of (IsLocalRing.ResidueField ↥W))) _
    (Limits.pullback.snd u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
    k (fun i => τκ (Fin.castSucc i)) hstκ.1.1 hstκ.1.2.1 hfp (fun i => hτs _) ⊤
    (fun K _ _ s _ => hstκ.1.2.2 K s)
    (fun i j t _ hij => hstκ.2.1.2.1 _ _ t t (fun h => hij (Fin.castSucc_injective _ h)))
    (fun j t _ => hstκ.2.1.2.2 _ t) (IsLocalRing.ResidueField ↥W) (𝟙 _) K' s' trivial
    (Subsingleton.elim _ _) hA'

theorem wcpa_dj_lfc_ni_open_p1_fibre : ∀ (S : Scheme.{u}) (K : Type u) [Field K] (b : Spec (.of K) ⟶ S) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ S) (C : Z₁.Opens) (E₀ : Set ↥(Limits.pullback u₁ b)), IsReduced (Limits.pullback u₁ b) → (∀ x : ↥(Limits.pullback u₁ b), Limits.pullback.fst u₁ b x ∈ C ↔ x ∈ E₀) → (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback u₁ b) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra), IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E₀ ∧ θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = ι ≫ Limits.pullback.snd u₁ b) → ∃ θκ : Limits.pullback (C.ι ≫ u₁) b ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra, θκ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = Limits.pullback.snd (C.ι ≫ u₁) b :=
by
  intro S K _ b Z₁ u₁ C E₀ hred hχ ⟨Er, ι, θ, hι, hEr, hrange, hθ⟩
  haveI := hred
  haveI := hι
  let e := Limits.pullbackRightPullbackFstIso u₁ b C.ι
  let j : Limits.pullback (C.ι ≫ u₁) b ⟶ Limits.pullback u₁ b :=
    e.inv ≫ Limits.pullback.snd C.ι (Limits.pullback.fst u₁ b)
  haveI hj : IsOpenImmersion j := inferInstance
  have hjsnd : j ≫ Limits.pullback.snd u₁ b = Limits.pullback.snd (C.ι ≫ u₁) b := by
    simp only [j, e, Category.assoc]
    exact Limits.pullbackRightPullbackFstIso_inv_snd_snd u₁ b C.ι
  have hsrange : Set.range (Limits.pullback.snd C.ι (Limits.pullback.fst u₁ b)) = E₀ := by
    rw [Scheme.Pullback.range_snd, Scheme.Opens.range_ι]
    ext x
    exact hχ x
  have hjrange : Set.range j = E₀ := by
    rw [← hsrange]
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      exact ⟨e.inv y, rfl⟩
    · rintro ⟨p, rfl⟩
      refine ⟨e.hom p, ?_⟩
      show (e.inv ≫ Limits.pullback.snd C.ι (Limits.pullback.fst u₁ b)) (e.hom p) = _
      rw [Scheme.Hom.comp_apply, Scheme.hom_inv_apply]
  have hsub : Set.range ι ⊆ Set.range j := by rw [hrange, hjrange]
  let φ := IsOpenImmersion.lift j ι hsub
  have hφ : φ ≫ j = ι := IsOpenImmersion.lift_fac j ι hsub
  haveI : IsClosedImmersion (φ ≫ j) := by rw [hφ]; exact hι
  haveI : IsClosedImmersion φ := IsClosedImmersion.of_comp φ j
  haveI : Surjective φ := by
    constructor
    intro y
    have hy : j y ∈ Set.range ι := by rw [hrange, ← hjrange]; exact ⟨y, rfl⟩
    obtain ⟨r, hr⟩ := hy
    refine ⟨r, ?_⟩
    apply j.isOpenEmbedding.injective
    rw [← Scheme.Hom.comp_apply, hφ, hr]
  haveI : IsReduced (Limits.pullback (C.ι ≫ u₁) b) := isReduced_of_isOpenImmersion j
  haveI : IsIso φ := isIso_of_isClosedImmersion_of_surjective φ
  refine ⟨(asIso φ).symm ≪≫ θ, ?_⟩
  rw [Iso.trans_hom, Iso.symm_hom, asIso_inv, Category.assoc, hθ, ← hφ, Category.assoc,
    IsIso.inv_hom_id_assoc, hjsnd]

theorem wcpa_dj_p1r_smooth : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥W)), IsProper v → Flat v → LocallyOfFinitePresentation v → (∃ θκ : Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W)) MvPolynomial.gradedAlgebra, θκ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W)) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField ↥W) ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W) 0))) = Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) → ∀ y : Y, ∃ U : Y.Opens, y ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ v) :=
by
  intro Ω _ _ W Y v hP hF hL hθ y
  obtain ⟨θκ, hθκ⟩ := hθ
  haveI := hP
  haveI : IsZariskiLocalAtSource (@SmoothOfRelativeDimension 1) :=
    HasRingHomProperty.instIsZariskiLocalAtSource
  have h0 : SmoothOfRelativeDimension 1
      (@Proj.toSpecZero _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W))
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap (IsLocalRing.ResidueField ↥W)
            ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W) 0)))) :=
    wc_p1_smooth_reldim_one (IsLocalRing.ResidueField ↥W)
  have hsnd : SmoothOfRelativeDimension 1 (Limits.pullback.snd v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) := by
    rw [← hθκ]
    exact IsZariskiLocalAtSource.comp h0 θκ.hom
  have hO : ∀ w : ↥(Limits.pullback v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
      ∃ O : Y.Opens, Limits.pullback.fst v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w ∈ O ∧
        SmoothOfRelativeDimension 1 (O.ι ≫ v) := fun w =>
    wcpa_dj_bsc_smooth_descend _ Y v _ _ w hF hL
      ⟨⊤, trivial, IsZariskiLocalAtSource.comp hsnd _⟩
  choose O hOmem hOsm using hO
  have hρpt : ∀ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
      Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q =
      IsLocalRing.closedPoint ↥W := by
    intro q
    have hq : q = IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W) := Subsingleton.elim _ _
    subst hq
    exact IsLocalRing.comap_closedPoint (IsLocalRing.residue ↥W)
  have hfib : ∀ y' : Y, v y' = IsLocalRing.closedPoint ↥W → ∃ w, Limits.pullback.fst v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w = y' := by
    intro y' hy'
    have hmem : y' ∈ Set.range (Limits.pullback.fst v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) := by
      rw [Scheme.Pullback.range_fst]
      exact ⟨IsLocalRing.closedPoint _, (hρpt _).trans hy'.symm⟩
    exact hmem
  have hcover : ∃ w, y ∈ O w := by
    by_contra hne
    push_neg at hne
    have hZ : IsClosed (((⨆ w, O w : Y.Opens) : Set Y)ᶜ) :=
      (⨆ w, O w : Y.Opens).isOpen.isClosed_compl
    have hyZ : y ∈ (((⨆ w, O w : Y.Opens) : Set Y)ᶜ) := by
      intro hy
      obtain ⟨w, hw⟩ := TopologicalSpace.Opens.mem_iSup.mp hy
      exact hne w hw
    have hcl : IsClosed (v '' (((⨆ w, O w : Y.Opens) : Set Y)ᶜ)) := v.isClosedMap _ hZ
    have hm : IsLocalRing.closedPoint ↥W ∈ v '' (((⨆ w, O w : Y.Opens) : Set Y)ᶜ) :=
      (IsLocalRing.specializes_closedPoint (v y)).mem_closed hcl ⟨y, hyZ, rfl⟩
    obtain ⟨y', hy'Z, hy'⟩ := hm
    obtain ⟨w, rfl⟩ := hfib y' hy'
    exact hy'Z (TopologicalSpace.Opens.mem_iSup.mpr ⟨w, hOmem w⟩)
  obtain ⟨w, hw⟩ := hcover
  exact ⟨O w, hw, hOsm w⟩

theorem wcpa_dj_lsp_les_section_algebra : ∀ (R A B : Type u) [CommRing R] [CommRing A] [CommRing B]
    (φ : R →+* A) (ψ : A →+* B), RingHom.IsStandardSmoothOfRelativeDimension 1 φ →
    Function.Bijective (ψ.comp φ) →
    ∃ θ r : A, ψ θ = 0 ∧ θ ∈ nonZeroDivisors A ∧ ψ r = 1 ∧
      ∀ a : A, ψ a = 0 → ∃ c : A, r * a = c * θ :=
by
  intro R A B _ _ _ φ ψ hsm hbij
  classical

  let e : R ≃+* B := RingEquiv.ofBijective (ψ.comp φ) hbij
  let ψ₀ : A →+* R := (e.symm : B →+* R).comp ψ
  have hψ₀φ : ∀ s : R, ψ₀ (φ s) = s := by
    intro s
    show e.symm (ψ (φ s)) = s
    have h : ψ (φ s) = e s := rfl
    rw [h, RingEquiv.symm_apply_apply]
  have heψ₀ : ∀ a : A, e (ψ₀ a) = ψ a := fun a => RingEquiv.apply_symm_apply e (ψ a)
  have hker_iff : ∀ a : A, ψ a = 0 ↔ ψ₀ a = 0 := by
    intro a
    rw [← heψ₀ a]
    constructor
    · intro h; exact e.injective (h.trans (map_zero e).symm)
    · intro h; rw [h, map_zero]

  obtain ⟨g, hgC, hg⟩ := hsm.exists_etale_mvPolynomial
  have hgCs : ∀ s : R, g (MvPolynomial.C s) = φ s := fun s => by rw [← hgC]; rfl
  let θ : A := g (MvPolynomial.X 0) - g (MvPolynomial.C (ψ₀ (g (MvPolynomial.X 0))))
  have hθdef : θ = g (MvPolynomial.X 0) - g (MvPolynomial.C (ψ₀ (g (MvPolynomial.X 0)))) := rfl
  have hψ₀θ : ψ₀ θ = 0 := by
    rw [hθdef, map_sub, hgCs, hψ₀φ, sub_self]
  let J : Ideal A := RingHom.ker ψ₀
  letI : Algebra (MvPolynomial (Fin 1) R) A := g.toAlgebra
  haveI : Algebra.Etale (MvPolynomial (Fin 1) R) A := RingHom.Etale.toAlgebra hg

  have hQ : (MvPolynomial.X 0 - MvPolynomial.C (ψ₀ (g (MvPolynomial.X 0))) :
      MvPolynomial (Fin 1) R) ∈ nonZeroDivisors (MvPolynomial (Fin 1) R) := by
    apply mem_nonZeroDivisors_of_injective
      (f := (MvPolynomial.finSuccEquiv R 0 : MvPolynomial (Fin 1) R ≃ₐ[R] _))
      (MvPolynomial.finSuccEquiv R 0).injective
    rw [map_sub, MvPolynomial.finSuccEquiv_X_zero]
    have hc : (MvPolynomial.finSuccEquiv R 0 : MvPolynomial (Fin 1) R ≃ₐ[R] _)
        (MvPolynomial.C (ψ₀ (g (MvPolynomial.X 0)))) =
        Polynomial.C (MvPolynomial.C (ψ₀ (g (MvPolynomial.X 0)))) := by
      simp [MvPolynomial.finSuccEquiv_apply]
    rw [hc]
    exact (Polynomial.monic_X_sub_C _).mem_nonZeroDivisors
  have hθnzd : θ ∈ nonZeroDivisors A := by
    have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := A) hQ
    rw [mem_nonZeroDivisors_iff_right]
    intro y hy
    apply hreg
    show (MvPolynomial.X 0 - MvPolynomial.C (ψ₀ (g (MvPolynomial.X 0))) :
      MvPolynomial (Fin 1) R) • y = (MvPolynomial.X 0 - MvPolynomial.C (ψ₀ (g (MvPolynomial.X 0))) :
      MvPolynomial (Fin 1) R) • (0 : A)
    rw [smul_zero, Algebra.smul_def, RingHom.algebraMap_toAlgebra, map_sub, mul_comm]
    exact hy

  let K : Ideal A := Ideal.span {θ} ⊔ J ^ 2
  have hJle : J ≤ K := by
    let I : Ideal (A ⧸ K) := J.map (Ideal.Quotient.mk K)
    have hI2 : I ^ 2 = ⊥ := by
      show (J.map (Ideal.Quotient.mk K)) ^ 2 = ⊥
      rw [← Ideal.map_pow]
      exact Ideal.map_mk_eq_bot_of_le le_sup_right
    have hcommR : (Ideal.Quotient.mk K).comp ((φ.comp ψ₀).comp g) =
        (Ideal.Quotient.mk K).comp g := by
      apply MvPolynomial.ringHom_ext
      · intro s
        simp only [RingHom.comp_apply, hgCs, hψ₀φ]
      · intro i
        have hi : i = 0 := Subsingleton.elim _ _
        subst hi
        simp only [RingHom.comp_apply]
        rw [Ideal.Quotient.eq, ← hgCs]
        have h : g (MvPolynomial.C (ψ₀ (g (MvPolynomial.X 0)))) - g (MvPolynomial.X 0) = -θ := by
          rw [hθdef]; ring
        rw [h]
        exact K.neg_mem (Ideal.mem_sup_left (Ideal.mem_span_singleton_self θ))
    have hcomm : ∀ p : MvPolynomial (Fin 1) R,
        Ideal.Quotient.mk K (φ (ψ₀ (g p))) = Ideal.Quotient.mk K (g p) :=
      fun p => RingHom.congr_fun hcommR p
    let α₁ : A →ₐ[MvPolynomial (Fin 1) R] A ⧸ K := Ideal.Quotient.mkₐ _ K
    let α₂ : A →ₐ[MvPolynomial (Fin 1) R] A ⧸ K :=
      { toRingHom := (Ideal.Quotient.mk K).comp (φ.comp ψ₀)
        commutes' := fun p => by
          show Ideal.Quotient.mk K (φ (ψ₀ (algebraMap (MvPolynomial (Fin 1) R) A p))) =
            algebraMap (MvPolynomial (Fin 1) R) (A ⧸ K) p
          rw [← Ideal.Quotient.mk_algebraMap]
          exact hcomm p }
    have h1 : ∀ b : A, α₁ b = Ideal.Quotient.mk K b := fun b => rfl
    have h2 : ∀ b : A, α₂ b = Ideal.Quotient.mk K (φ (ψ₀ b)) := fun b => rfl
    have hagree : (Ideal.Quotient.mkₐ (MvPolynomial (Fin 1) R) I).comp α₁ =
        (Ideal.Quotient.mkₐ (MvPolynomial (Fin 1) R) I).comp α₂ := by
      apply AlgHom.ext
      intro b
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
      rw [Ideal.Quotient.eq, h1, h2, ← map_sub]
      apply Ideal.mem_map_of_mem
      show ψ₀ (b - φ (ψ₀ b)) = 0
      rw [map_sub, hψ₀φ, sub_self]
    have heq := Algebra.FormallyUnramified.comp_injective I hI2 hagree
    intro b hb
    rw [← Ideal.Quotient.eq_zero_iff_mem, ← h1, heq, h2]
    have hb0 : ψ₀ b = 0 := RingHom.mem_ker.mp hb
    rw [hb0, map_zero, map_zero]

  have hJfg : J.FG := by
    letI : Algebra R A := φ.toAlgebra
    haveI hA : Algebra.IsStandardSmoothOfRelativeDimension 1 R A := hsm
    haveI : Algebra.IsStandardSmooth R A := hA.isStandardSmooth
    haveI : Algebra.FinitePresentation R A := Algebra.IsStandardSmooth.finitePresentation
    let f : A →ₐ[R] R := { toRingHom := ψ₀, commutes' := fun s => hψ₀φ s }
    exact Algebra.FinitePresentation.ker_fG_of_surjective f (fun s => ⟨φ s, hψ₀φ s⟩)

  let S : Submodule A A := Ideal.span {θ}
  let q := S.mkQ
  let N : Submodule A (A ⧸ S) := Submodule.map q J
  have hNfg : N.FG := Submodule.FG.map q hJfg
  have hNle : N ≤ J • N := by
    rintro _ ⟨y, hy, rfl⟩
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp (hJle hy)
    have hqa : q a = 0 := (Submodule.Quotient.mk_eq_zero S).mpr ha
    have hqy : q y = q b := by rw [← hab, map_add, hqa, zero_add]
    rw [hqy, ← Submodule.map_smul'']
    apply Submodule.mem_map_of_mem
    rw [pow_two, ← Ideal.smul_eq_mul] at hb
    exact hb
  obtain ⟨r, hr1, hr⟩ :=
    Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul J N hNfg hNle
  have hψ₀r : ψ₀ r = 1 := by
    have h : ψ₀ (r - 1) = 0 := RingHom.mem_ker.mp hr1
    rw [map_sub, map_one, sub_eq_zero] at h
    exact h
  refine ⟨θ, r, (hker_iff θ).mpr hψ₀θ, hθnzd, ?_, ?_⟩
  · rw [← heψ₀, hψ₀r, map_one]
  · intro a ha
    have haJ : a ∈ J := RingHom.mem_ker.mpr ((hker_iff a).mp ha)
    have h0 := hr (q a) (Submodule.mem_map_of_mem haJ)
    have hq0 : q (r * a) = 0 := by rw [← smul_eq_mul, map_smul]; exact h0
    have hm : r * a ∈ S := (Submodule.Quotient.mk_eq_zero S).mp hq0
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hm
    exact ⟨c, hc.symm⟩

theorem wcpa_dj_lsp_dc_section_chart : ∀ {Z T : Scheme.{u}} (uu : Z ⟶ T) (m : ℕ)
    (ε : Fin m → (T ⟶ Z)), IsSeparated uu → wcpaDjSections uu m ε → ∀ (j : Fin m) (p : T),
    ∃ (U : T.Opens) (V : Z.Opens) (e : V ≤ uu ⁻¹ᵁ U), IsAffineOpen U ∧ IsAffineOpen V ∧
      ε j p ∈ V ∧ U ≤ ε j ⁻¹ᵁ V ∧ (∀ i, i ≠ j → ∀ q : T, ε i q ∉ V) ∧
      RingHom.IsStandardSmoothOfRelativeDimension 1 (uu.appLE U V e).hom :=
by
  intro Z T uu m ε hsep hsec j p

  have s1 : ∀ (W₀ : Z.Opens) (z : Z), z ∈ W₀ → SmoothOfRelativeDimension 1 (W₀.ι ≫ uu) →
      ∃ (U₀ : T.Opens) (V₁ : Z.Opens) (e₁ : V₁ ≤ uu ⁻¹ᵁ U₀), IsAffineOpen U₀ ∧
        IsAffineOpen V₁ ∧ z ∈ V₁ ∧
        RingHom.IsStandardSmoothOfRelativeDimension 1 (uu.appLE U₀ V₁ e₁).hom := by
    intro W₀ z hz hsm
    haveI := hsm
    obtain ⟨U₀, hU₀, V₀, hV₀, hx, e₀, hP₀⟩ :=
      SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := 1)
        (f := W₀.ι ≫ uu) (⟨z, hz⟩ : W₀.toScheme)
    have e₁ : W₀.ι ''ᵁ V₀ ≤ uu ⁻¹ᵁ U₀ := by
      intro x hx'
      rw [← SetLike.mem_coe, Scheme.Hom.coe_image] at hx'
      obtain ⟨y, hy, rfl⟩ := hx'
      have h1 : y ∈ (W₀.ι ≫ uu) ⁻¹ᵁ U₀ := e₀ hy
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply] at h1
      rw [Scheme.Hom.mem_preimage]
      exact h1
    have e₂ : V₀ ≤ W₀.ι ⁻¹ᵁ (W₀.ι ''ᵁ V₀) := by rw [Scheme.Hom.preimage_image_eq]
    refine ⟨U₀, W₀.ι ''ᵁ V₀, e₁, hU₀, hV₀.image_of_isOpenImmersion W₀.ι, ?_, ?_⟩
    · rw [← SetLike.mem_coe, Scheme.Hom.coe_image]
      exact ⟨⟨z, hz⟩, hx, rfl⟩
    · have hcomp := Scheme.Hom.appLE_comp_appLE W₀.ι uu U₀ (W₀.ι ''ᵁ V₀) V₀ e₁ e₂
      haveI hiso : IsIso (W₀.ι.appLE (W₀.ι ''ᵁ V₀) V₀ e₂) := by
        rw [← Scheme.Hom.appIso_hom']; infer_instance
      rw [← hcomp, CommRingCat.hom_comp] at hP₀
      exact ((RingHom.isStandardSmoothOfRelativeDimension_respectsIso :
          RingHom.RespectsIso (RingHom.IsStandardSmoothOfRelativeDimension 1)).cancel_right_isIso
        (uu.appLE U₀ (W₀.ι ''ᵁ V₀) e₁) (W₀.ι.appLE (W₀.ι ''ᵁ V₀) V₀ e₂)).mp hP₀

  have s2 : ∀ (U₀ : T.Opens) (V₁ : Z.Opens) (e₁ : V₁ ≤ uu ⁻¹ᵁ U₀), IsAffineOpen V₁ →
      RingHom.IsStandardSmoothOfRelativeDimension 1 (uu.appLE U₀ V₁ e₁).hom →
      ∀ s : Γ(Z, V₁), RingHom.IsStandardSmoothOfRelativeDimension 1
        (uu.appLE U₀ (Z.basicOpen s) ((Z.basicOpen_le s).trans e₁)).hom := by
    intro U₀ V₁ e₁ hV₁ hP s
    have h1 := Scheme.Hom.appLE_map uu e₁ (homOfLE (Z.basicOpen_le s)).op
    rw [← h1, CommRingCat.hom_comp]
    haveI := hV₁.isLocalization_basicOpen s
    have h0 : RingHom.IsStandardSmoothOfRelativeDimension 0
        (algebraMap Γ(Z, V₁) Γ(Z, Z.basicOpen s)) :=
      RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway s
    have h2 := h0.comp hP
    rw [zero_add] at h2
    exact h2

  have s3 : ∀ (U₀ : T.Opens) (V₂ : Z.Opens) (e₂ : V₂ ≤ uu ⁻¹ᵁ U₀), IsAffineOpen U₀ →
      IsAffineOpen V₂ → RingHom.IsStandardSmoothOfRelativeDimension 1 (uu.appLE U₀ V₂ e₂).hom →
      ∀ t : Γ(T, U₀), ∃ e : Z.basicOpen ((uu.appLE U₀ V₂ e₂).hom t) ≤ uu ⁻¹ᵁ T.basicOpen t,
        RingHom.IsStandardSmoothOfRelativeDimension 1
          (uu.appLE (T.basicOpen t) (Z.basicOpen ((uu.appLE U₀ V₂ e₂).hom t)) e).hom := by
    intro U₀ V₂ e₂ hU₀ hV₂ hP t
    have hb := Scheme.basicOpen_appLE uu V₂ U₀ e₂ t
    have e : Z.basicOpen ((uu.appLE U₀ V₂ e₂).hom t) ≤ uu ⁻¹ᵁ T.basicOpen t := by
      rw [hb]; exact inf_le_right
    refine ⟨e, ?_⟩
    haveI := hU₀.isLocalization_basicOpen t
    haveI := hV₂.isLocalization_basicOpen ((uu.appLE U₀ V₂ e₂).hom t)
    haveI : IsLocalization (Submonoid.map (uu.appLE U₀ V₂ e₂).hom (Submonoid.powers t))
        Γ(Z, Z.basicOpen ((uu.appLE U₀ V₂ e₂).hom t)) := by
      rw [Submonoid.map_powers]; assumption
    have hloc := RingHom.isStandardSmoothOfRelativeDimension_localizationPreserves 1
      (uu.appLE U₀ V₂ e₂).hom (Submonoid.powers t) Γ(T, T.basicOpen t)
      Γ(Z, Z.basicOpen ((uu.appLE U₀ V₂ e₂).hom t)) hP
    convert hloc using 1
    apply IsLocalization.ringHom_ext (Submonoid.powers t)
    rw [IsLocalization.map_comp]
    show (uu.appLE (T.basicOpen t) _ e).hom.comp
        (T.presheaf.map (homOfLE (T.basicOpen_le t)).op).hom =
      (Z.presheaf.map (homOfLE (Z.basicOpen_le ((uu.appLE U₀ V₂ e₂).hom t))).op).hom.comp
        (uu.appLE U₀ V₂ e₂).hom
    rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp, Scheme.Hom.map_appLE,
      Scheme.Hom.appLE_map]

  obtain ⟨hs1, hs2, hs3⟩ := hsec
  haveI := hsep
  have hcl : ∀ i, IsClosed (Set.range ⇑(ε i)) := by
    intro i
    haveI : IsClosedImmersion (ε i ≫ uu) := by rw [hs1 i]; infer_instance
    haveI : IsClosedImmersion (ε i) := IsClosedImmersion.of_comp (ε i) uu
    exact (ε i).isClosedEmbedding.isClosed_range
  have hE : IsClosed (⋃ (i : {i : Fin m // i ≠ j}), Set.range ⇑(ε i.1)) :=
    isClosed_iUnion_of_finite (fun i => hcl i.1)
  have hzE : ε j p ∉ ⋃ (i : {i : Fin m // i ≠ j}), Set.range ⇑(ε i.1) := by
    intro h
    obtain ⟨⟨i, hij⟩, q, hq⟩ := Set.mem_iUnion.mp h
    exact hs2 i j q p hij hq
  have hpt : ∀ q : T, uu (ε j q) = q := by
    intro q
    rw [← Scheme.Hom.comp_apply, hs1 j]
    rfl
  obtain ⟨W₀, hzW₀, hsm⟩ := hs3 j p
  obtain ⟨U₀, V₁, e₁, hU₀, hV₁, hzV₁, hP₁⟩ := s1 W₀ (ε j p) hzW₀ hsm
  let O₁ : Z.Opens := V₁ ⊓ ⟨(⋃ (i : {i : Fin m // i ≠ j}), Set.range ⇑(ε i.1))ᶜ, hE.isOpen_compl⟩
  have hzO₁ : ε j p ∈ O₁ := TopologicalSpace.Opens.mem_inf.mpr ⟨hzV₁, hzE⟩
  obtain ⟨s, hsO, hzs⟩ := hV₁.exists_basicOpen_le (V := O₁) ⟨ε j p, hzO₁⟩ hzV₁
  have hP₂ := s2 U₀ V₁ e₁ hV₁ hP₁ s
  have hV₂ : IsAffineOpen (Z.basicOpen s) := hV₁.basicOpen s
  have e₂ : Z.basicOpen s ≤ uu ⁻¹ᵁ U₀ := (Z.basicOpen_le s).trans e₁
  have hpU₀ : p ∈ U₀ := by
    have h1 := e₂ hzs
    rw [Scheme.Hom.mem_preimage, hpt] at h1
    exact h1
  let O : T.Opens := U₀ ⊓ ε j ⁻¹ᵁ (Z.basicOpen s)
  have hpO : p ∈ O := TopologicalSpace.Opens.mem_inf.mpr ⟨hpU₀, hzs⟩
  obtain ⟨t, htO, hpt'⟩ := hU₀.exists_basicOpen_le (V := O) ⟨p, hpO⟩ hpU₀
  obtain ⟨e, hP⟩ := s3 U₀ (Z.basicOpen s) e₂ hU₀ hV₂ hP₂ t
  have hVeq := Scheme.basicOpen_appLE uu (Z.basicOpen s) U₀ e₂ t
  refine ⟨T.basicOpen t, Z.basicOpen ((uu.appLE U₀ (Z.basicOpen s) e₂).hom t), e,
    hU₀.basicOpen t, hV₂.basicOpen _, ?_, ?_, ?_, hP⟩
  · rw [hVeq, TopologicalSpace.Opens.mem_inf, Scheme.Hom.mem_preimage, hpt]
    exact ⟨hzs, hpt'⟩
  · intro q hq
    rw [Scheme.Hom.mem_preimage, hVeq, TopologicalSpace.Opens.mem_inf, Scheme.Hom.mem_preimage,
      hpt]
    have h1 := TopologicalSpace.Opens.mem_inf.mp (htO hq)
    exact ⟨h1.2, hq⟩
  · intro i hij q hq
    rw [hVeq, TopologicalSpace.Opens.mem_inf] at hq
    have h1 := TopologicalSpace.Opens.mem_inf.mp (hsO hq.1)
    exact h1.2 (Set.mem_iUnion.mpr ⟨⟨i, hij⟩, q, rfl⟩)

theorem wcpa_dj_lsp_les_transfer : ∀ {Z T : Scheme.{u}} (m : ℕ) (ε : Fin m → (T ⟶ Z)) (j : Fin m)
    (V : Z.Opens), QuasiCompact (ε j) → IsAffineOpen V → (∀ i, i ≠ j → ∀ q : T, ε i q ∉ V) →
    ∀ θ r : Γ(Z, V), ((ε j).app V).hom θ = 0 → θ ∈ nonZeroDivisors Γ(Z, V) →
    ((ε j).app V).hom r = 1 →
    (∀ a : Γ(Z, V), ((ε j).app V).hom a = 0 → ∃ c : Γ(Z, V), r * a = c * θ) →
    (∀ q : T, ε j q ∈ V → ε j q ∈ Z.basicOpen r) ∧
    ∀ (W : Z.Opens), IsAffineOpen W → ∀ hW : W ≤ Z.basicOpen r,
      (Z.presheaf.map (homOfLE hW).op).hom
          ((Z.presheaf.map (homOfLE (Z.basicOpen_le r)).op).hom θ) ∈ nonZeroDivisors Γ(Z, W) ∧
      ∀ s : Γ(Z, W), (∀ i, ((ε i).app W).hom s = 0) ↔
        s ∈ Ideal.span {(Z.presheaf.map (homOfLE hW).op).hom
          ((Z.presheaf.map (homOfLE (Z.basicOpen_le r)).op).hom θ)} :=
by
  intro Z T m ε j V hqc hV hav θ r hψθ hθ hψr hker
  haveI := hqc

  have hres : ∀ (W : Z.Opens) (hW : W ≤ Z.basicOpen r) (x : Γ(Z, V)),
      (Z.presheaf.map (homOfLE hW).op).hom
          ((Z.presheaf.map (homOfLE (Z.basicOpen_le r)).op).hom x)
        = (Z.presheaf.map (homOfLE (hW.trans (Z.basicOpen_le r))).op).hom x := by
    intro W hW x
    have e : (homOfLE (hW.trans (Z.basicOpen_le r))).op =
        (homOfLE (Z.basicOpen_le r)).op ≫ (homOfLE hW).op := rfl
    rw [e, Functor.map_comp, CommRingCat.hom_comp, RingHom.comp_apply]

  have hnzd : ∀ (O : Z.Opens) (hOW : O ≤ V),
      Z.presheaf.map (homOfLE hOW).op θ ∈ nonZeroDivisors Γ(Z, O) := by
    intro O hOW
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    refine TopCat.Presheaf.section_ext Z.sheaf _ _ _ (fun t ht => ?_)
    have hst := congrArg (Z.presheaf.germ O t ht) hx
    rw [map_mul, map_zero, TopCat.Presheaf.germ_res_apply] at hst
    have hnz' : Z.presheaf.germ V t (hOW ht) θ ∈ nonZeroDivisors (Z.presheaf.stalk t) := by
      letI := TopCat.Presheaf.algebra_section_stalk Z.presheaf (⟨t, hOW ht⟩ : V)
      haveI := hV.isLocalization_stalk ⟨t, hOW ht⟩
      have hnz := IsLocalization.map_nonZeroDivisors_le
          (hV.primeIdealOf ⟨t, hOW ht⟩).asIdeal.primeCompl
          (Z.presheaf.stalk ((⟨t, hOW ht⟩ : V) : Z))
          (Submonoid.mem_map_of_mem
            (algebraMap Γ(Z, V) (Z.presheaf.stalk ((⟨t, hOW ht⟩ : V) : Z))) hθ)
      exact hnz
    show Z.presheaf.germ O t ht x = Z.presheaf.germ O t ht 0
    rw [map_zero]
    exact mem_nonZeroDivisors_iff_right.mp hnz' _ hst
  refine ⟨?_, ?_⟩
  · intro q hq
    have h1 : q ∈ (ε j) ⁻¹ᵁ (Z.basicOpen r) := by
      rw [Scheme.preimage_basicOpen]
      have h2 : ((ε j).app V) r = 1 := hψr
      rw [h2, Scheme.basicOpen_one]
      exact hq
    exact h1
  · intro W hWaff hW
    have hWV : W ≤ V := hW.trans (Z.basicOpen_le r)
    rw [hres W hW θ]
    refine ⟨hnzd W hWV, ?_⟩
    intro s

    have hvan : ∀ i, i ≠ j → ((ε i).app W).hom s = 0 := by
      intro i hij
      have hbot : ε i ⁻¹ᵁ W = ⊥ := eq_bot_iff.mpr (fun q hq => (hav i hij q (hWV hq)).elim)
      haveI : Subsingleton Γ(T, ε i ⁻¹ᵁ W) :=
        CommRingCat.subsingleton_of_isTerminal (T.sheaf.isTerminalOfEqEmpty hbot)
      exact Subsingleton.elim _ _

    have hK : RingHom.ker ((ε j).app W).hom =
        Ideal.map (Z.presheaf.map (homOfLE hWV).op).hom (RingHom.ker ((ε j).app V).hom) := by
      have h1 := Scheme.Hom.ker_apply (ε j) ⟨W, hWaff⟩
      have h2 := Scheme.Hom.ker_apply (ε j) ⟨V, hV⟩
      have h3 := Scheme.IdealSheafData.map_ideal (ε j).ker (U := ⟨W, hWaff⟩) (V := ⟨V, hV⟩) hWV
      rw [← h1, ← h2, ← h3]
      rfl

    have hunit : IsUnit ((Z.presheaf.map (homOfLE hWV).op).hom r) := by
      have h0 : IsUnit ((Z.presheaf.map (homOfLE (Z.basicOpen_le r)).op).hom r) :=
        RingedSpace.isUnit_res_basicOpen Z.toRingedSpace r
      have h1 := h0.map (Z.presheaf.map (homOfLE hW).op).hom
      rwa [hres W hW r] at h1
    have hspan : Ideal.map (Z.presheaf.map (homOfLE hWV).op).hom (RingHom.ker ((ε j).app V).hom)
        = Ideal.span {(Z.presheaf.map (homOfLE hWV).op).hom θ} := by
      apply le_antisymm
      · rw [Ideal.map_le_iff_le_comap]
        intro a ha
        rw [RingHom.mem_ker] at ha
        obtain ⟨c, hc⟩ := hker a ha
        rw [Ideal.mem_comap]
        have hm : (Z.presheaf.map (homOfLE hWV).op).hom r * (Z.presheaf.map (homOfLE hWV).op).hom a
            ∈ Ideal.span {(Z.presheaf.map (homOfLE hWV).op).hom θ} := by
          rw [← map_mul, hc, map_mul]
          exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
        exact (Ideal.unit_mul_mem_iff_mem _ hunit).mp hm
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        exact Ideal.mem_map_of_mem _ (RingHom.mem_ker.mpr hψθ)
    rw [← hspan, ← hK, RingHom.mem_ker]
    constructor
    · intro h; exact h j
    · intro h i
      by_cases hij : i = j
      · subst hij; exact h
      · exact hvan i hij

theorem wcpa_dj_lsp_dc_local_eq_section : ∀ {Z T : Scheme.{u}} (uu : Z ⟶ T) (m : ℕ)
    (ε : Fin m → (T ⟶ Z)), IsSeparated uu → wcpaDjSections uu m ε → ∀ (j : Fin m) (p : T),
    ∃ (V : Z.Opens) (f : Γ(Z, V)), IsAffineOpen V ∧ ε j p ∈ V ∧
      (∀ (W : Z.Opens), IsAffineOpen W → ∀ hW : W ≤ V,
        (Z.presheaf.map (homOfLE hW).op).hom f ∈ nonZeroDivisors Γ(Z, W) ∧
        ∀ s : Γ(Z, W), (∀ i, ((ε i).app W).hom s = 0) ↔
          s ∈ Ideal.span {(Z.presheaf.map (homOfLE hW).op).hom f}) :=
by
  intro Z T uu m ε hsep hsec j p
  obtain ⟨hs1, hs2, hs3⟩ := hsec
  obtain ⟨U, V, e, hU, hV, hzV, h, havoid, hsm⟩ :=
    wcpa_dj_lsp_dc_section_chart uu m ε hsep ⟨hs1, hs2, hs3⟩ j p
  haveI := hsep
  haveI : IsClosedImmersion (ε j ≫ uu) := by rw [hs1 j]; infer_instance
  haveI : IsClosedImmersion (ε j) := IsClosedImmersion.of_comp (ε j) uu
  have hpt : ∀ q : T, uu (ε j q) = q := by
    intro q
    rw [← Scheme.Hom.comp_apply, hs1 j]
    rfl
  have hpre : ε j ⁻¹ᵁ V = U := by
    apply le_antisymm
    · intro q hq
      have h1 : uu (ε j q) ∈ U := e hq
      rwa [hpt q] at h1
    · exact h
  have key : ∀ (U' O : T.Opens) (g : T ⟶ T) (he : O ≤ g ⁻¹ᵁ U'), g = 𝟙 T → O = U' →
      Function.Bijective (g.appLE U' O he).hom := by
    intro U' O g he hg hO
    subst hg
    subst hO
    have hle : (𝟙 T) ⁻¹ᵁ O ≤ O := fun x hx => hx
    haveI : IsIso (homOfLE he) := ⟨⟨homOfLE hle, Subsingleton.elim _ _, Subsingleton.elim _ _⟩⟩
    haveI : IsIso (Scheme.Hom.appLE (𝟙 T) O O he) := by
      have e1 : Scheme.Hom.appLE (𝟙 T) O O he =
          Scheme.Hom.app (𝟙 T) O ≫ T.presheaf.map (homOfLE he).op := rfl
      rw [e1]
      first
        | infer_instance
        | (rw [Scheme.Hom.id_app]; infer_instance)
        | (simp only [Scheme.Hom.id_app]; infer_instance)
    exact ConcreteCategory.bijective_of_isIso (Scheme.Hom.appLE (𝟙 T) O O he)
  have hbij : Function.Bijective (((ε j).app V).hom.comp (uu.appLE U V e).hom) := by
    rw [← CommRingCat.hom_comp, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
    exact key _ _ _ _ (hs1 j) hpre
  obtain ⟨θ, r, hψθ, hθ, hψr, hker⟩ :=
    wcpa_dj_lsp_les_section_algebra _ _ _ (uu.appLE U V e).hom ((ε j).app V).hom hsm hbij
  obtain ⟨hmem, hLE⟩ :=
    wcpa_dj_lsp_les_transfer m ε j V inferInstance hV havoid θ r hψθ hθ hψr hker
  exact ⟨Z.basicOpen r, (Z.presheaf.map (homOfLE (Z.basicOpen_le r)).op).hom θ,
    hV.basicOpen r, hmem p hzV, hLE⟩

theorem wcpa_dj_p1r_divisor_eq : ∀ {Y T : Scheme.{u}} (v : Y ⟶ T) (sY : T ⟶ Y), IsSeparated v → QuasiCompact v → IsAffine T → sY ≫ v = 𝟙 T → (∀ q : T, ∃ U : Y.Opens, sY q ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ v)) → ∃ (L : wcpaDjCoc Y) (t : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ v ⁻¹ᵁ ⊤)), wcpaDjCocOK L ∧ wcpaDjCompat L (v ⁻¹ᵁ ⊤) 1 t ∧ ∀ (a : Fin L.m) (O : Y.Opens), IsAffineOpen O → ∀ hO : O ≤ L.V a ⊓ v ⁻¹ᵁ ⊤, (Y.presheaf.map (homOfLE hO).op).hom (t a) ∈ nonZeroDivisors Γ(Y, O) ∧ ∀ s : Γ(Y, O), ((sY.app O).hom s = 0 ↔ s ∈ Ideal.span {(Y.presheaf.map (homOfLE hO).op).hom (t a)}) :=
by
  intro Y T v sY hsep hqc haff hs hsm
  classical
  haveI := hsep
  haveI := hqc

  have hD : IsClosed (Set.range ⇑sY) := by
    haveI : IsClosedImmersion (sY ≫ v) := by rw [hs]; infer_instance
    haveI : IsClosedImmersion sY := IsClosedImmersion.of_comp sY v
    exact sY.isClosedEmbedding.isClosed_range

  have hP0 : ∀ (W : Y.Opens), (∀ q, sY q ∉ W) → ∀ (s : Γ(Y, W)), (sY.app W).hom s = 0 := by
    intro W hW s
    have hbot : sY ⁻¹ᵁ W = ⊥ := eq_bot_iff.mpr (fun q hq => (hW q hq).elim)
    haveI : Subsingleton Γ(T, sY ⁻¹ᵁ W) :=
      CommRingCat.subsingleton_of_isTerminal (T.sheaf.isTerminalOfEqEmpty hbot)
    exact Subsingleton.elim _ _
  have hnbhd : ∀ (U : Y.Opens) (x : Y), x ∈ U → ∃ W : Y.Opens, IsAffineOpen W ∧ x ∈ W ∧ W ≤ U := by
    intro U x hx
    obtain ⟨W, hW, hxW, hWU⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp Y.isBasis_affineOpens hx
    exact ⟨W, hW, hxW, hWU⟩
  let Dc : Y.Opens := ⟨(Set.range ⇑sY)ᶜ, hD.isOpen_compl⟩
  have hmiss : ∀ W : Y.Opens, W ≤ Dc → ∀ q, sY q ∉ W := by
    intro W hW q hq
    exact hW hq ⟨q, rfl⟩

  have hloc : ∀ z : Y, ∃ (V : Y.Opens) (f : Γ(Y, V)), IsAffineOpen V ∧ z ∈ V ∧
      (∀ (W : Y.Opens), IsAffineOpen W → ∀ hW : W ≤ V,
        (Y.presheaf.map (homOfLE hW).op).hom f ∈ nonZeroDivisors Γ(Y, W) ∧
        ∀ s : Γ(Y, W), ((sY.app W).hom s = 0 ↔
          s ∈ Ideal.span {(Y.presheaf.map (homOfLE hW).op).hom f})) := by
    intro z
    by_cases hz : z ∈ Set.range ⇑sY
    · obtain ⟨p, rfl⟩ := hz
      have hsec : wcpaDjSections v 1 (fun _ => sY) :=
        ⟨fun _ => hs, fun i j _ _ hij => (hij (Subsingleton.elim i j)).elim,
          fun _ q => hsm q⟩
      obtain ⟨V, f, hV, hpV, hLE⟩ := wcpa_dj_lsp_dc_local_eq_section v 1 (fun _ => sY) hsep hsec 0 p
      refine ⟨V, f, hV, hpV, fun W hW hWV => ⟨(hLE W hW hWV).1, fun s => ?_⟩⟩
      have h := (hLE W hW hWV).2 s
      exact ⟨fun h0 => h.mp (fun _ => h0), fun h1 => h.mpr h1 0⟩
    · obtain ⟨V, hVaff, hzV, hVle⟩ := hnbhd Dc z hz
      refine ⟨V, 1, hVaff, hzV, fun W _ hW => ?_⟩
      rw [map_one, Ideal.span_singleton_one]
      exact ⟨one_mem _, fun s => iff_of_true (hP0 W (hmiss W (hW.trans hVle)) s)
        Submodule.mem_top⟩
  choose V0 f0 hVaff0 hzV0 hLE0 using hloc
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace v
  obtain ⟨S, hS⟩ := isCompact_univ.elim_finite_subcover (fun z => (V0 z : Set Y))
    (fun z => (V0 z).isOpen) (fun z _ => Set.mem_iUnion.mpr ⟨z, hzV0 z⟩)
  let V : Fin S.card → Y.Opens := fun a => V0 (S.equivFin.symm a)
  let f : ∀ a, Γ(Y, V a) := fun a => f0 (S.equivFin.symm a)
  have hV : ∀ a, IsAffineOpen (V a) := fun a => hVaff0 _
  have hLE : ∀ a (W : Y.Opens), IsAffineOpen W → ∀ hW : W ≤ V a,
      (Y.presheaf.map (homOfLE hW).op).hom (f a) ∈ nonZeroDivisors Γ(Y, W) ∧
      ∀ s : Γ(Y, W), ((sY.app W).hom s = 0 ↔
        s ∈ Ideal.span {(Y.presheaf.map (homOfLE hW).op).hom (f a)}) :=
    fun a => hLE0 _
  have hcov : (⨆ a, V a) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hx := hS (Set.mem_univ x)
    rw [Set.mem_iUnion₂] at hx
    obtain ⟨z, hzS, hxz⟩ := hx
    rw [TopologicalSpace.Opens.mem_iSup]
    refine ⟨S.equivFin ⟨z, hzS⟩, ?_⟩
    simp only [V, Equiv.symm_apply_apply]
    exact hxz
  clear_value V f

  haveI hYsep : Y.IsSeparated := by
    rw [Scheme.isSeparated_iff]
    have e : Limits.terminal.from Y = v ≫ Limits.terminal.from T := Limits.terminal.hom_ext _ _
    rw [e]
    infer_instance
  have hab : ∀ a b, IsAffineOpen (V a ⊓ V b) := fun a b => (hV a).inf (hV b)
  have habc : ∀ a b c, IsAffineOpen (V a ⊓ V b ⊓ V c) := fun a b c => (hab a b).inf (hV c)
  have hR : ∀ (U U' U'' : Y.Opens) (h1 : U' ≤ U) (h2 : U'' ≤ U') (h3 : U'' ≤ U) (x : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
      (Y.presheaf.map (homOfLE h3).op).hom x := by
    intro U U' U'' h1 h2 h3 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have hR2 : ∀ {U U' U'' : Y.Opens} (h1 : U' ≤ U) (h2 : U'' ≤ U') (x : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
      (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom x :=
    fun h1 h2 x => hR _ _ _ h1 h2 _ x
  have unit_of : ∀ (A : Type u) [CommRing A] (x y : A), x ∈ nonZeroDivisors A →
      y ∈ Ideal.span {x} → x ∈ Ideal.span {y} → ∃ g : Aˣ, y = (g : A) * x := by
    intro A _ x y hx hy hx'
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hy
    obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp hx'
    have h1 : (d * c) * x = 1 * x := by rw [mul_assoc, hc, hd, one_mul]
    have h2 : d * c = 1 := (mul_cancel_right_mem_nonZeroDivisors hx).mp h1
    exact ⟨⟨c, d, by rw [mul_comm]; exact h2, h2⟩, hc.symm⟩
  have hex : ∀ a b, ∃ g : (Γ(Y, V a ⊓ V b))ˣ,
      (Y.presheaf.map (homOfLE (inf_le_right : V a ⊓ V b ≤ V b)).op).hom (f b) =
      (g : Γ(Y, V a ⊓ V b)) *
        (Y.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ≤ V a)).op).hom (f a) := by
    intro a b
    have hA := hLE a (V a ⊓ V b) (hab a b) inf_le_left
    have hB := hLE b (V a ⊓ V b) (hab a b) inf_le_right
    exact unit_of _ _ _ hA.1 ((hA.2 _).mp ((hB.2 _).mpr (Ideal.mem_span_singleton_self _)))
      ((hB.2 _).mp ((hA.2 _).mpr (Ideal.mem_span_singleton_self _)))
  choose g hg using hex
  have key : ∀ a b c (W : Y.Opens), IsAffineOpen W → ∀ (h1 : W ≤ V a ⊓ V b)
      (h2 : W ≤ V b ⊓ V c) (h3 : W ≤ V a ⊓ V c),
      (Y.presheaf.map (homOfLE h1).op).hom (g a b : Γ(Y, V a ⊓ V b)) *
        (Y.presheaf.map (homOfLE h2).op).hom (g b c : Γ(Y, V b ⊓ V c)) =
      (Y.presheaf.map (homOfLE h3).op).hom (g a c : Γ(Y, V a ⊓ V c)) := by
    intro a b c W hW h1 h2 h3
    have ha : W ≤ V a := h1.trans inf_le_left
    have hb : W ≤ V b := h1.trans inf_le_right
    have hc : W ≤ V c := h2.trans inf_le_right
    have e1 := congrArg (Y.presheaf.map (homOfLE h1).op).hom (hg a b)
    rw [map_mul, hR _ _ _ _ _ hb, hR _ _ _ _ _ ha] at e1
    have e2 := congrArg (Y.presheaf.map (homOfLE h2).op).hom (hg b c)
    rw [map_mul, hR _ _ _ _ _ hc, hR _ _ _ _ _ hb] at e2
    have e3 := congrArg (Y.presheaf.map (homOfLE h3).op).hom (hg a c)
    rw [map_mul, hR _ _ _ _ _ hc, hR _ _ _ _ _ ha] at e3
    have hnz := (hLE a W hW ha).1
    apply (mul_cancel_right_mem_nonZeroDivisors hnz).mp
    linear_combination
      (-(Y.presheaf.map (homOfLE h2).op).hom (g b c : Γ(Y, V b ⊓ V c))) * e1 - e2 + e3
  refine ⟨⟨S.card, V, g⟩, fun a =>
    (Y.presheaf.map (homOfLE (inf_le_left : V a ⊓ v ⁻¹ᵁ ⊤ ≤ V a)).op).hom (f a), ?_, ?_, ?_⟩
  · unfold wcpaDjCocOK
    refine ⟨hV, hcov, ?_, ?_⟩
    · intro a
      have e := hg a a
      have hnz := (hLE a (V a ⊓ V a) (hab a a) inf_le_left).1
      apply Units.ext
      rw [Units.val_one]
      apply (mul_cancel_right_mem_nonZeroDivisors hnz).mp
      rw [one_mul]
      exact e.symm
    · intro a b c
      exact key a b c _ (habc a b c) _ _ _
  · unfold wcpaDjCompat
    intro a b
    try dsimp only
    rw [pow_one, hR2, hR2]
    have e := congrArg
      (Y.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ⊓ v ⁻¹ᵁ ⊤ ≤ V a ⊓ V b)).op).hom (hg a b)
    rw [map_mul, hR2, hR2] at e
    exact e
  · intro a O hOaff hO
    have hO' : O ≤ V a := hO.trans inf_le_left
    have e : (Y.presheaf.map (homOfLE hO).op).hom
        ((Y.presheaf.map (homOfLE (inf_le_left : V a ⊓ v ⁻¹ᵁ ⊤ ≤ V a)).op).hom (f a)) =
        (Y.presheaf.map (homOfLE hO').op).hom (f a) := hR _ _ _ _ _ hO' _
    show (Y.presheaf.map (homOfLE hO).op).hom
        ((Y.presheaf.map (homOfLE (inf_le_left : V a ⊓ v ⁻¹ᵁ ⊤ ≤ V a)).op).hom (f a)) ∈
        nonZeroDivisors Γ(Y, O) ∧ ∀ s : Γ(Y, O), ((sY.app O).hom s = 0 ↔ s ∈ Ideal.span
          {(Y.presheaf.map (homOfLE hO).op).hom
            ((Y.presheaf.map (homOfLE (inf_le_left : V a ⊓ v ⁻¹ᵁ ⊤ ≤ V a)).op).hom (f a))})
    rw [e]
    exact hLE a O hOaff hO'

theorem wcpa_dj_p1r_fm_cover_change : ∀ (X : Scheme.{u}) {m n : ℕ} (U : Fin m → X.Opens) (D : Fin n → X.Opens), (⨆ a, U a) = (⨆ k, D k) → wcpaP1rRawH1 D → (∀ k, wcpaP1rRawH1 (fun a => U a ⊓ D k)) → wcpaP1rRawH1 U :=
by
  intro X m n U D hUD hD hloc c hc

  have hres : ∀ {A B C : X.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(X, A)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
      (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro A B C h1 h2 x
    change (X.presheaf.map (homOfLE h1).op ≫ X.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl

  have glue : ∀ {N : ℕ} (W : Fin N → X.Opens) (V : X.Opens) (hWV : ∀ k, W k ≤ V),
      (∀ x ∈ V, ∃ k, x ∈ W k) → ∀ t : ∀ k, Γ(X, W k),
      (∀ k l, (X.presheaf.map (homOfLE (inf_le_left : W k ⊓ W l ≤ W k)).op).hom (t k) =
        (X.presheaf.map (homOfLE (inf_le_right : W k ⊓ W l ≤ W l)).op).hom (t l)) →
      ∃ s : Γ(X, V), ∀ k, (X.presheaf.map (homOfLE (hWV k)).op).hom s = t k := by
    intro N W V hWV hV t ht
    obtain ⟨s, hs, -⟩ := X.sheaf.existsUnique_gluing' (fun i : ULift.{u} (Fin N) => W i.down) V
      (fun i => homOfLE (hWV i.down)) (by
        intro x hx
        obtain ⟨k, hk⟩ := hV x hx
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨k⟩, hk⟩) (fun i => t i.down) (by
        intro i j
        exact ht i.down j.down)
    exact ⟨s, fun k => hs ⟨k⟩⟩

  have sep : ∀ {N : ℕ} (W : Fin N → X.Opens) (V : X.Opens) (hWV : ∀ k, W k ≤ V),
      (∀ x ∈ V, ∃ k, x ∈ W k) → ∀ s t : Γ(X, V),
      (∀ k, (X.presheaf.map (homOfLE (hWV k)).op).hom s =
        (X.presheaf.map (homOfLE (hWV k)).op).hom t) → s = t := by
    intro N W V hWV hV s t hst
    exact X.sheaf.eq_of_locally_eq' (fun i : ULift.{u} (Fin N) => W i.down) V
      (fun i => homOfLE (hWV i.down)) (by
        intro x hx
        obtain ⟨k, hk⟩ := hV x hx
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨k⟩, hk⟩) s t (fun i => hst i.down)

  have memU : ∀ x, x ∈ (⨆ a, U a) → ∃ k, x ∈ D k := by
    intro x hx
    rw [hUD] at hx
    exact TopologicalSpace.Opens.mem_iSup.mp hx
  have memD : ∀ x k, x ∈ D k → ∃ a, x ∈ U a := by
    intro x k hx
    have hx' : x ∈ (⨆ k, D k) := TopologicalSpace.Opens.mem_iSup.mpr ⟨k, hx⟩
    rw [← hUD] at hx'
    exact TopologicalSpace.Opens.mem_iSup.mp hx'

  have hk : ∀ k, ∃ h : ∀ a, Γ(X, U a ⊓ D k), ∀ a b,
      (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left)
        (inf_le_right.trans inf_le_left) : (U a ⊓ D k) ⊓ (U b ⊓ D k) ≤ U a ⊓ U b)).op).hom (c a b) =
      (X.presheaf.map (homOfLE (inf_le_right : (U a ⊓ D k) ⊓ (U b ⊓ D k) ≤ U b ⊓ D k)).op).hom
        (h b) -
      (X.presheaf.map (homOfLE (inf_le_left : (U a ⊓ D k) ⊓ (U b ⊓ D k) ≤ U a ⊓ D k)).op).hom
        (h a) := by
    intro k
    refine hloc k (fun a b => (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left)
      (inf_le_right.trans inf_le_left) : (U a ⊓ D k) ⊓ (U b ⊓ D k) ≤ U a ⊓ U b)).op).hom
        (c a b)) ?_
    intro a b d
    try dsimp only
    rw [hres, hres, hres]
    have e := congrArg (X.presheaf.map (homOfLE (show (U a ⊓ D k) ⊓ (U b ⊓ D k) ⊓ (U d ⊓ D k) ≤
      U a ⊓ U b ⊓ U d from fun x hx => ⟨⟨hx.1.1.1, hx.1.2.1⟩, hx.2.1⟩)).op).hom (hc a b d)
    rw [map_add, hres, hres, hres] at e
    exact e
  choose h hh using hk

  have hg : ∀ k l, ∃ g : Γ(X, D k ⊓ D l), ∀ a,
      (X.presheaf.map (homOfLE (inf_le_right : U a ⊓ (D k ⊓ D l) ≤ D k ⊓ D l)).op).hom g =
      (X.presheaf.map (homOfLE (le_inf inf_le_left (inf_le_right.trans inf_le_left) :
        U a ⊓ (D k ⊓ D l) ≤ U a ⊓ D k)).op).hom (h k a) -
      (X.presheaf.map (homOfLE (le_inf inf_le_left (inf_le_right.trans inf_le_right) :
        U a ⊓ (D k ⊓ D l) ≤ U a ⊓ D l)).op).hom (h l a) := by
    intro k l
    refine glue (fun a => U a ⊓ (D k ⊓ D l)) (D k ⊓ D l) (fun a => inf_le_right) ?_
      (fun a => (X.presheaf.map (homOfLE (le_inf inf_le_left (inf_le_right.trans inf_le_left) :
        U a ⊓ (D k ⊓ D l) ≤ U a ⊓ D k)).op).hom (h k a) -
      (X.presheaf.map (homOfLE (le_inf inf_le_left (inf_le_right.trans inf_le_right) :
        U a ⊓ (D k ⊓ D l) ≤ U a ⊓ D l)).op).hom (h l a)) ?_
    · intro x hx
      obtain ⟨a, ha⟩ := memD x k hx.1
      exact ⟨a, ha, hx⟩
    · intro a b
      try dsimp only
      rw [map_sub, map_sub, hres, hres, hres, hres]
      have e1 := congrArg (X.presheaf.map (homOfLE (show (U a ⊓ (D k ⊓ D l)) ⊓ (U b ⊓ (D k ⊓ D l)) ≤
        (U a ⊓ D k) ⊓ (U b ⊓ D k) from
          fun x hx => ⟨⟨hx.1.1, hx.1.2.1⟩, ⟨hx.2.1, hx.2.2.1⟩⟩)).op).hom (hh k a b)
      have e2 := congrArg (X.presheaf.map (homOfLE (show (U a ⊓ (D k ⊓ D l)) ⊓ (U b ⊓ (D k ⊓ D l)) ≤
        (U a ⊓ D l) ⊓ (U b ⊓ D l) from
          fun x hx => ⟨⟨hx.1.1, hx.1.2.2⟩, ⟨hx.2.1, hx.2.2.2⟩⟩)).op).hom (hh l a b)
      rw [map_sub, hres, hres, hres] at e1 e2
      have e3 := e1.symm.trans e2
      linear_combination (-1 : _) * e3
  choose g hgG using hg
  have hG' : ∀ k l a (O : X.Opens) (hO : O ≤ U a ⊓ (D k ⊓ D l)),
      (X.presheaf.map (homOfLE (hO.trans (inf_le_right : U a ⊓ (D k ⊓ D l) ≤ D k ⊓ D l))).op).hom
        (g k l) =
      (X.presheaf.map (homOfLE (hO.trans (le_inf inf_le_left (inf_le_right.trans inf_le_left) :
        U a ⊓ (D k ⊓ D l) ≤ U a ⊓ D k))).op).hom (h k a) -
      (X.presheaf.map (homOfLE (hO.trans (le_inf inf_le_left (inf_le_right.trans inf_le_right) :
        U a ⊓ (D k ⊓ D l) ≤ U a ⊓ D l))).op).hom (h l a) := by
    intro k l a O hO
    have e := congrArg (X.presheaf.map (homOfLE hO).op).hom (hgG k l a)
    rw [map_sub, hres, hres, hres] at e
    exact e

  obtain ⟨e, he⟩ := hD g (by
    intro k l j
    refine sep (fun a => U a ⊓ (D k ⊓ D l ⊓ D j)) (D k ⊓ D l ⊓ D j) (fun a => inf_le_right) ?_
      _ _ ?_
    · intro x hx
      obtain ⟨a, ha⟩ := memD x k hx.1.1
      exact ⟨a, ha, hx⟩
    · intro a
      try dsimp only
      rw [map_add, hres, hres, hres]
      rw [hG' k j a (U a ⊓ (D k ⊓ D l ⊓ D j)) (fun x hx => ⟨hx.1, hx.2.1.1, hx.2.2⟩),
        hG' l j a (U a ⊓ (D k ⊓ D l ⊓ D j)) (fun x hx => ⟨hx.1, hx.2.1.2, hx.2.2⟩),
        hG' k l a (U a ⊓ (D k ⊓ D l ⊓ D j)) (fun x hx => ⟨hx.1, hx.2.1.1, hx.2.1.2⟩)]
      ring)

  have h2 : ∀ k l a,
      (X.presheaf.map (homOfLE (le_inf inf_le_left (inf_le_right.trans inf_le_left) :
        U a ⊓ (D k ⊓ D l) ≤ U a ⊓ D k)).op).hom (h k a) +
      (X.presheaf.map (homOfLE (inf_le_right.trans inf_le_left :
        U a ⊓ (D k ⊓ D l) ≤ D k)).op).hom (e k) =
      (X.presheaf.map (homOfLE (le_inf inf_le_left (inf_le_right.trans inf_le_right) :
        U a ⊓ (D k ⊓ D l) ≤ U a ⊓ D l)).op).hom (h l a) +
      (X.presheaf.map (homOfLE (inf_le_right.trans inf_le_right :
        U a ⊓ (D k ⊓ D l) ≤ D l)).op).hom (e l) := by
    intro k l a
    have e1 := hgG k l a
    have e2 := congrArg (X.presheaf.map (homOfLE (inf_le_right :
      U a ⊓ (D k ⊓ D l) ≤ D k ⊓ D l)).op).hom (he k l)
    rw [map_sub, hres, hres] at e2
    have e3 := e1.symm.trans e2
    linear_combination e3

  have hβ : ∀ a, ∃ β : Γ(X, U a), ∀ k,
      (X.presheaf.map (homOfLE (inf_le_left : U a ⊓ D k ≤ U a)).op).hom β =
      h k a + (X.presheaf.map (homOfLE (inf_le_right : U a ⊓ D k ≤ D k)).op).hom (e k) := by
    intro a
    refine glue (fun k => U a ⊓ D k) (U a) (fun k => inf_le_left) ?_
      (fun k => h k a + (X.presheaf.map (homOfLE (inf_le_right : U a ⊓ D k ≤ D k)).op).hom (e k))
      ?_
    · intro x hx
      obtain ⟨k, hk⟩ := memU x (TopologicalSpace.Opens.mem_iSup.mpr ⟨a, hx⟩)
      exact ⟨k, hx, hk⟩
    · intro k l
      try dsimp only
      rw [map_add, map_add, hres, hres]
      have e := congrArg (X.presheaf.map (homOfLE (show (U a ⊓ D k) ⊓ (U a ⊓ D l) ≤
        U a ⊓ (D k ⊓ D l) from fun x hx => ⟨hx.1.1, hx.1.2, hx.2.2⟩)).op).hom (h2 k l a)
      rw [map_add, map_add, hres, hres, hres, hres] at e
      exact e
  choose β hβ using hβ
  have hβ' : ∀ a k (O : X.Opens) (hO : O ≤ U a ⊓ D k),
      (X.presheaf.map (homOfLE (hO.trans (inf_le_left : U a ⊓ D k ≤ U a))).op).hom (β a) =
      (X.presheaf.map (homOfLE hO).op).hom (h k a) +
      (X.presheaf.map (homOfLE (hO.trans (inf_le_right : U a ⊓ D k ≤ D k))).op).hom (e k) := by
    intro a k O hO
    have e := congrArg (X.presheaf.map (homOfLE hO).op).hom (hβ a k)
    rw [map_add, hres, hres] at e
    exact e

  refine ⟨β, fun a b => ?_⟩
  refine sep (fun k => U a ⊓ U b ⊓ D k) (U a ⊓ U b) (fun k => inf_le_left) ?_ _ _ ?_
  · intro x hx
    obtain ⟨k, hk⟩ := memU x (TopologicalSpace.Opens.mem_iSup.mpr ⟨a, hx.1⟩)
    exact ⟨k, hx, hk⟩
  · intro k
    try dsimp only
    rw [map_sub, hres, hres]
    rw [hβ' b k (U a ⊓ U b ⊓ D k) (fun x hx => ⟨hx.1.2, hx.2⟩),
      hβ' a k (U a ⊓ U b ⊓ D k) (fun x hx => ⟨hx.1.1, hx.2⟩)]
    have e := congrArg (X.presheaf.map (homOfLE (show U a ⊓ U b ⊓ D k ≤
      (U a ⊓ D k) ⊓ (U b ⊓ D k) from
        fun x hx => ⟨⟨hx.1.1, hx.2⟩, ⟨hx.1.2, hx.2⟩⟩)).op).hom (hh k a b)
    rw [map_sub, hres, hres, hres] at e
    linear_combination e

theorem wcpa_dj_p1r_fm_affine_cover : ∀ (X : Scheme.{u}) (O : X.Opens), IsAffineOpen O → ∀ {m : ℕ} (U : Fin m → X.Opens), (∀ a, U a ≤ O) → (⨆ a, U a) = O → wcpaP1rRawH1 U :=
by
  intro X O hO m U _hUO hcov
  classical
  have hres : ∀ {A B C : X.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(X, A)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
        (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro A B C h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have hid : ∀ {A : X.Opens} (h : A ≤ A) (x : Γ(X, A)),
      (X.presheaf.map (homOfLE h).op).hom x = x := by
    intro A h x
    have e0 : X.presheaf.map (homOfLE h).op = 𝟙 _ := by
      rw [show (homOfLE h).op = 𝟙 (Opposite.op A) from rfl, X.presheaf.map_id]
    rw [e0]
    rfl

  have hdom : ∀ {n : ℕ} (W : Fin n → X.Opens) (a₀ : Fin n), (∀ a, W a ≤ W a₀) →
      wcpaP1rRawH1 W := by
    intro n W a₀ hW c hc
    refine ⟨fun a => (X.presheaf.map (homOfLE (le_inf (hW a) le_rfl : W a ≤ W a₀ ⊓ W a)).op).hom
      (c a₀ a), fun a b => ?_⟩
    have hT : W a ⊓ W b ≤ W a₀ ⊓ W a ⊓ W b :=
      le_inf (le_inf (inf_le_left.trans (hW a)) inf_le_left) inf_le_right
    have h := congrArg (X.presheaf.map (homOfLE hT).op).hom (hc a₀ a b)
    rw [map_add] at h
    simp only [hres, hid] at h
    simp only [hres]
    linear_combination -h

  have hQ : ∀ (V : X.Opens) (hVU : V ≤ O), IsAffineOpen V → ∀ k : Γ(X, O),
      (∀ e : Γ(wcStructMod X, V ⊓ X.basicOpen k), ∃ (n : ℕ) (w : Γ(wcStructMod X, V)),
        (X.presheaf.map (homOfLE (le_trans inf_le_left hVU : V ⊓ X.basicOpen k ≤ O)).op k) ^ n • e
          = (wcStructMod X).presheaf.map (homOfLE (inf_le_left : V ⊓ X.basicOpen k ≤ V)).op w) ∧
      (∀ z : Γ(wcStructMod X, V),
        (wcStructMod X).presheaf.map (homOfLE (inf_le_left : V ⊓ X.basicOpen k ≤ V)).op z = 0 →
        ∃ n : ℕ, (X.presheaf.map (homOfLE hVU).op k) ^ n • z = 0) := by
    intro V hVU hV k
    obtain ⟨hq1, hq2⟩ := (wc_struct_mod_coh X).1 V hV (X.presheaf.map (homOfLE hVU).op k)
    have hres' : X.presheaf.map (homOfLE (X.basicOpen_le (X.presheaf.map (homOfLE hVU).op k))).op
        (X.presheaf.map (homOfLE hVU).op k) =
        X.presheaf.map (homOfLE (le_trans (X.basicOpen_le _) hVU)).op k := by
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
      rfl
    have aux : ∀ (W' : X.Opens) (hWV : W' ≤ V) (hWU : W' ≤ O),
        W' = X.basicOpen (X.presheaf.map (homOfLE hVU).op k) →
        (∀ e : Γ(wcStructMod X, W'), ∃ (n : ℕ) (w : Γ(wcStructMod X, V)),
          (X.presheaf.map (homOfLE hWU).op k) ^ n • e =
            (wcStructMod X).presheaf.map (homOfLE hWV).op w) ∧
        (∀ z : Γ(wcStructMod X, V), (wcStructMod X).presheaf.map (homOfLE hWV).op z = 0 →
          ∃ n : ℕ, (X.presheaf.map (homOfLE hVU).op k) ^ n • z = 0) := by
      rintro W' hWV hWU rfl
      refine ⟨fun e => ?_, fun z hz => hq2 z hz⟩
      obtain ⟨n, w, hw⟩ := hq1 e
      refine ⟨n, w, ?_⟩
      rw [← hres']
      exact hw
    exact aux (V ⊓ X.basicOpen k) inf_le_left (le_trans inf_le_left hVU)
      (Scheme.basicOpen_res X k (homOfLE hVU).op).symm

  have hbasic : ∀ {n : ℕ} (f : Fin n → Γ(X, O)), (∀ x : X, x ∈ O → ∃ k, x ∈ X.basicOpen (f k)) →
      wcpaP1rRawH1 (fun k => X.basicOpen (f k)) := by
    intro n f hcovD c hc
    have H : ∀ e' : (∀ p : Fin n × Fin n, Γ(X, X.basicOpen (f p.1) ⊓ X.basicOpen (f p.2))),
        (∀ i j k : Fin n, (X.presheaf.map (homOfLE (inf_le_left : X.basicOpen (f i) ⊓
            X.basicOpen (f j) ⊓ X.basicOpen (f k) ≤ X.basicOpen (f i) ⊓ X.basicOpen (f j))).op).hom
            (e' (i, j)) +
          (X.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right) inf_le_right :
            X.basicOpen (f i) ⊓ X.basicOpen (f j) ⊓ X.basicOpen (f k) ≤
              X.basicOpen (f j) ⊓ X.basicOpen (f k))).op).hom (e' (j, k)) =
          (X.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right :
            X.basicOpen (f i) ⊓ X.basicOpen (f j) ⊓ X.basicOpen (f k) ≤
              X.basicOpen (f i) ⊓ X.basicOpen (f k))).op).hom (e' (i, k))) →
        ∃ w : (∀ i : Fin n, Γ(X, X.basicOpen (f i))), ∀ i j : Fin n,
          e' (i, j) = (X.presheaf.map (homOfLE (inf_le_left : X.basicOpen (f i) ⊓
              X.basicOpen (f j) ≤ X.basicOpen (f i))).op).hom (w i) -
            (X.presheaf.map (homOfLE (inf_le_right : X.basicOpen (f i) ⊓
              X.basicOpen (f j) ≤ X.basicOpen (f j))).op).hom (w j) :=
      fun e' he' => wc_qcoh_standard_cover_cech_h1 X (wcStructMod X) O hO hQ n f hcovD e' he'
    obtain ⟨w, hw⟩ := H (fun p => -(c p.1 p.2)) (by
      intro i j k
      have h := hc i j k
      simp only [map_neg]
      linear_combination h)
    refine ⟨w, fun i j => ?_⟩
    have h := hw i j
    linear_combination -h

  have hsub : (O : Set X) ⊆ ⋃ i : {p : Γ(X, O) × Fin m // X.basicOpen p.1 ≤ U p.2},
      (X.basicOpen i.1.1 : Set X) := by
    intro x hxO
    have hx : x ∈ ⨆ a, U a := by rw [hcov]; exact hxO
    obtain ⟨a, hxa⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    obtain ⟨g, hg, hxg⟩ := hO.exists_basicOpen_le (V := U a) ⟨x, hxa⟩ hxO
    exact Set.mem_iUnion.mpr ⟨⟨(g, a), hg⟩, hxg⟩
  obtain ⟨t, ht⟩ := hO.isCompact.elim_finite_subcover
    (fun i : {p : Γ(X, O) × Fin m // X.basicOpen p.1 ≤ U p.2} => (X.basicOpen i.1.1 : Set X))
    (fun i => (X.basicOpen i.1.1).isOpen) hsub
  obtain ⟨n, f, α, hα, hfcov⟩ : ∃ (n : ℕ) (f : Fin n → Γ(X, O)) (α : Fin n → Fin m),
      (∀ k, X.basicOpen (f k) ≤ U (α k)) ∧ ∀ x : X, x ∈ O → ∃ k, x ∈ X.basicOpen (f k) := by
    refine ⟨t.card, fun k => (t.equivFin.symm k).1.1.1, fun k => (t.equivFin.symm k).1.1.2,
      fun k => (t.equivFin.symm k).1.2, ?_⟩
    intro x hx
    obtain ⟨i, hi, hxi⟩ := Set.mem_iUnion₂.mp (ht hx)
    refine ⟨t.equivFin ⟨i, hi⟩, ?_⟩
    simp only [Equiv.symm_apply_apply]
    exact hxi
  have hD : (⨆ a, U a) = ⨆ k, X.basicOpen (f k) := by
    rw [hcov]
    apply le_antisymm
    · intro x hx
      obtain ⟨k, hk⟩ := hfcov x hx
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨k, hk⟩
    · exact iSup_le fun k => X.basicOpen_le (f k)
  exact wcpa_dj_p1r_fm_cover_change X U (fun k => X.basicOpen (f k)) hD (hbasic f hfcov)
    (fun k => hdom (fun a => U a ⊓ X.basicOpen (f k)) (α k)
      (fun a => le_inf (inf_le_right.trans (hα k)) inf_le_right))

theorem wcpa_dj_p1r_fm_two_chart : ∀ (A : Type u) [CommRing A] (P : Scheme.{u}) (j c : Spec (.of (Polynomial A)) ⟶ P) [IsOpenImmersion j] [IsOpenImmersion c], IsPullback (Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A)) (LaurentPolynomial.T (-1))))) (Spec.map (CommRingCat.ofHom (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A))) j c → wcpaP1rRawH1 ![j.opensRange, c.opensRange] :=
by

  have s1 : ∀ (A : Type u) [CommRing A] (g : LaurentPolynomial A), ∃ p q : Polynomial A,
      g = Polynomial.toLaurent q - Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
        (LaurentPolynomial.T (-1)) p := by
    intro A _ g
    refine LaurentPolynomial.induction_on' g ?_ ?_
    · rintro p q ⟨p1, q1, h1⟩ ⟨p2, q2, h2⟩
      refine ⟨p1 + p2, q1 + q2, ?_⟩
      rw [h1, h2, map_add, map_add]
      abel
    · intro n a
      rcases Int.eq_nat_or_neg n with ⟨k, rfl | rfl⟩
      · refine ⟨0, Polynomial.C a * Polynomial.X ^ k, ?_⟩
        rw [Polynomial.toLaurent_C_mul_X_pow, map_zero, sub_zero]
      · refine ⟨-(Polynomial.C a * Polynomial.X ^ k), 0, ?_⟩
        simp [LaurentPolynomial.T_pow, LaurentPolynomial.algebraMap_apply,
          Algebra.algebraMap_self, RingHom.id_apply]

  have hres : ∀ (X : Scheme.{u}) {U V W' : X.Opens} (h1 : V ≤ U) (h2 : W' ≤ V) (x : Γ(X, U)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
      (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro X U V W' h1 h2 x
    change (X.presheaf.map (homOfLE h1).op ≫ X.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have hid : ∀ (X : Scheme.{u}) {U : X.Opens} (h : U ≤ U) (x : Γ(X, U)),
      (X.presheaf.map (homOfLE h).op).hom x = x := by
    intro X U h x
    rw [show homOfLE h = 𝟙 U from rfl, op_id, CategoryTheory.Functor.map_id]
    rfl

  have hs2 : ∀ (X : Scheme.{u}) (V : Fin 2 → X.Opens),
      (∀ s : Γ(X, V 0 ⊓ V 1), ∃ (b₀ : Γ(X, V 0)) (b₁ : Γ(X, V 1)),
        s = (X.presheaf.map (homOfLE (inf_le_right : V 0 ⊓ V 1 ≤ V 1)).op).hom b₁ -
          (X.presheaf.map (homOfLE (inf_le_left : V 0 ⊓ V 1 ≤ V 0)).op).hom b₀) →
      wcpaP1rRawH1 V := by
    intro X V H c hc
    have hinj : ∀ (W W' : X.Opens) (h1 : W ≤ W') (h2 : W' ≤ W),
        Function.Injective (X.presheaf.map (homOfLE h1).op).hom := by
      intro W W' h1 h2 x y hxy
      have := congrArg (X.presheaf.map (homOfLE h2).op).hom hxy
      rwa [hres X, hres X, hid X, hid X] at this
    have h00 : c 0 0 = 0 := by
      have e := hc 0 0 0
      apply hinj _ _ (inf_le_left : V 0 ⊓ V 0 ⊓ V 0 ≤ V 0 ⊓ V 0) (le_inf le_rfl inf_le_left)
      rw [map_zero]
      linear_combination -e
    have h11 : c 1 1 = 0 := by
      have e := hc 1 1 1
      apply hinj _ _ (inf_le_left : V 1 ⊓ V 1 ⊓ V 1 ≤ V 1 ⊓ V 1) (le_inf le_rfl inf_le_left)
      rw [map_zero]
      linear_combination -e
    obtain ⟨b₀, b₁, hb⟩ := H (c 0 1)
    have k00 : c 0 0 = (X.presheaf.map (homOfLE (inf_le_right : V 0 ⊓ V 0 ≤ V 0)).op).hom b₀ -
        (X.presheaf.map (homOfLE (inf_le_left : V 0 ⊓ V 0 ≤ V 0)).op).hom b₀ := by
      rw [h00]; exact (sub_self _).symm
    have k11 : c 1 1 = (X.presheaf.map (homOfLE (inf_le_right : V 1 ⊓ V 1 ≤ V 1)).op).hom b₁ -
        (X.presheaf.map (homOfLE (inf_le_left : V 1 ⊓ V 1 ≤ V 1)).op).hom b₁ := by
      rw [h11]; exact (sub_self _).symm
    have k10 : c 1 0 = (X.presheaf.map (homOfLE (inf_le_right : V 1 ⊓ V 0 ≤ V 0)).op).hom b₀ -
        (X.presheaf.map (homOfLE (inf_le_left : V 1 ⊓ V 0 ≤ V 1)).op).hom b₁ := by
      have e := hc 1 0 1
      rw [h11, map_zero, hb, map_sub, hres X, hres X] at e
      apply hinj _ _ (inf_le_left : V 1 ⊓ V 0 ⊓ V 1 ≤ V 1 ⊓ V 0) (le_inf le_rfl inf_le_left)
      rw [map_sub, hres X, hres X]
      linear_combination -e
    refine ⟨(Fin.cons b₀ (Fin.cons b₁ finZeroElim : ∀ i : Fin 1, Γ(X, V i.succ)) :
      ∀ a : Fin 2, Γ(X, V a)), fun a b => ?_⟩
    fin_cases a <;> fin_cases b
    · exact k00
    · exact hb
    · exact k10
    · exact k11

  have hbij : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [IsOpenImmersion f] (U : Y.Opens)
      (e : (⊤ : X.Opens) ≤ f ⁻¹ᵁ U), f ''ᵁ ⊤ = U → Function.Bijective (f.appLE U ⊤ e).hom := by
    intro X Y f _ U e hU
    subst hU
    rw [← Scheme.Hom.appIso_hom' f ⊤]
    have h1 : ∀ x, (f.appIso ⊤).inv.hom ((f.appIso ⊤).hom.hom x) = x := fun x => by
      change ((f.appIso ⊤).hom ≫ (f.appIso ⊤).inv).hom x = x
      rw [Iso.hom_inv_id]; rfl
    have h2 : ∀ x, (f.appIso ⊤).hom.hom ((f.appIso ⊤).inv.hom x) = x := fun x => by
      change ((f.appIso ⊤).inv ≫ (f.appIso ⊤).hom).hom x = x
      rw [Iso.inv_hom_id]; rfl
    exact ⟨fun a b h => by rw [← h1 a, ← h1 b, h], fun y => ⟨_, h2 y⟩⟩
  have hisoinj : ∀ {B C : CommRingCat.{u}} (e : B ≅ C), Function.Injective e.hom.hom := by
    intro B C e a b h
    have h' := congrArg e.inv.hom h
    change (e.hom ≫ e.inv).hom a = (e.hom ≫ e.inv).hom b at h'
    rwa [Iso.hom_inv_id] at h'
  have hisoinv : ∀ {B C : CommRingCat.{u}} (e : B ≅ C) (x : C), e.hom.hom (e.inv.hom x) = x := by
    intro B C e x
    change (e.inv ≫ e.hom).hom x = x
    rw [Iso.inv_hom_id]; rfl

  have hnat : ∀ {R S : CommRingCat.{u}} (φ : R ⟶ S) {P : Scheme.{u}} (g : Spec R ⟶ P)
      (ι : Spec S ⟶ P), Spec.map φ ≫ g = ι → ∀ (U U' : P.Opens) (hUU' : U' ≤ U)
      (e : (⊤ : (Spec R).Opens) ≤ g ⁻¹ᵁ U) (e' : (⊤ : (Spec S).Opens) ≤ ι ⁻¹ᵁ U') (b : Γ(P, U)),
      (Scheme.ΓSpecIso S).hom.hom ((ι.appLE U' ⊤ e').hom ((P.presheaf.map (homOfLE hUU').op).hom b)) =
        φ.hom ((Scheme.ΓSpecIso R).hom.hom ((g.appLE U ⊤ e).hom b)) := by
    intro R S φ P g ι hι U U' hUU' e e' b
    subst hι
    have e2 : (⊤ : (Spec S).Opens) ≤ Spec.map φ ⁻¹ᵁ ⊤ := fun x _ => trivial
    have k1 : P.presheaf.map (homOfLE hUU').op ≫ (Spec.map φ ≫ g).appLE U' ⊤ e' =
        g.appLE U ⊤ e ≫ (Spec.map φ).appLE ⊤ ⊤ e2 := by
      rw [Scheme.Hom.map_appLE, Scheme.Hom.appLE_comp_appLE]
    have k2 : (Spec.map φ).appLE ⊤ ⊤ e2 = (Spec.map φ).appTop := by
      rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
      rfl
    have k3 := Scheme.ΓSpecIso_naturality φ
    change ((P.presheaf.map (homOfLE hUU').op ≫ (Spec.map φ ≫ g).appLE U' ⊤ e') ≫
      (Scheme.ΓSpecIso S).hom).hom b = ((g.appLE U ⊤ e ≫ (Scheme.ΓSpecIso R).hom) ≫ φ).hom b
    rw [k1, k2, Category.assoc, k3, Category.assoc]

  have main : ∀ (R L : CommRingCat.{u}) (φ₁ φ₂ : R ⟶ L) (P : Scheme.{u}) (j c : Spec R ⟶ P)
      [IsOpenImmersion j] [IsOpenImmersion c], IsPullback (Spec.map φ₁) (Spec.map φ₂) j c →
      (∀ g : L, ∃ p q : R, g = φ₂.hom q - φ₁.hom p) →
      wcpaP1rRawH1 ![j.opensRange, c.opensRange] := by
    intro R L φ₁ φ₂ P j c _ _ hpb hsplit
    have hw : Spec.map φ₁ ≫ j = Spec.map φ₂ ≫ c := hpb.toCommSq.w
    haveI : IsOpenImmersion (Spec.map φ₁) := MorphismProperty.of_isPullback hpb.flip inferInstance
    have hrange : Set.range (Spec.map φ₁ ≫ j) = Set.range j ∩ Set.range c := by
      ext x
      constructor
      · rintro ⟨p, rfl⟩
        refine ⟨⟨Spec.map φ₁ p, ?_⟩, ⟨Spec.map φ₂ p, ?_⟩⟩
        · rw [Scheme.Hom.comp_apply]
        · rw [hw, Scheme.Hom.comp_apply]
      · rintro ⟨⟨y, rfl⟩, ⟨z, hz⟩⟩
        obtain ⟨p, hp1, -⟩ := Scheme.exists_preimage_of_isPullback hpb y z hz.symm
        exact ⟨p, by rw [Scheme.Hom.comp_apply, hp1]⟩
    have hU01 : (Spec.map φ₁ ≫ j) ''ᵁ ⊤ = j.opensRange ⊓ c.opensRange := by
      rw [Scheme.Hom.image_top_eq_opensRange]
      apply TopologicalSpace.Opens.ext
      rw [TopologicalSpace.Opens.coe_inf, Scheme.Hom.coe_opensRange, Scheme.Hom.coe_opensRange,
        Scheme.Hom.coe_opensRange, hrange]
    have e0 : (⊤ : (Spec R).Opens) ≤ j ⁻¹ᵁ j.opensRange := fun x _ => ⟨x, rfl⟩
    have e1 : (⊤ : (Spec R).Opens) ≤ c ⁻¹ᵁ c.opensRange := fun x _ => ⟨x, rfl⟩
    have e01 : (⊤ : (Spec L).Opens) ≤ (Spec.map φ₁ ≫ j) ⁻¹ᵁ (j.opensRange ⊓ c.opensRange) := by
      rw [← hU01, Scheme.Hom.image_top_eq_opensRange]
      exact fun x _ => ⟨x, rfl⟩
    have b0 := hbij j j.opensRange e0 (Scheme.Hom.image_top_eq_opensRange j)
    have b1 := hbij c c.opensRange e1 (Scheme.Hom.image_top_eq_opensRange c)
    have b01 := hbij (Spec.map φ₁ ≫ j) _ e01 hU01
    apply hs2
    show ∀ s : Γ(P, j.opensRange ⊓ c.opensRange), ∃ (b₀ : Γ(P, j.opensRange))
      (b₁ : Γ(P, c.opensRange)),
      s = (P.presheaf.map (homOfLE (inf_le_right : j.opensRange ⊓ c.opensRange ≤ c.opensRange)).op).hom b₁ -
        (P.presheaf.map (homOfLE (inf_le_left : j.opensRange ⊓ c.opensRange ≤ j.opensRange)).op).hom b₀
    intro s
    obtain ⟨p, q, hpq⟩ := hsplit ((Scheme.ΓSpecIso L).hom.hom
      (((Spec.map φ₁ ≫ j).appLE _ ⊤ e01).hom s))
    obtain ⟨b₀, hb₀⟩ := b0.2 ((Scheme.ΓSpecIso R).inv.hom p)
    obtain ⟨b₁, hb₁⟩ := b1.2 ((Scheme.ΓSpecIso R).inv.hom q)
    refine ⟨b₀, b₁, ?_⟩
    apply b01.1
    apply hisoinj (Scheme.ΓSpecIso L)
    rw [map_sub, map_sub, hnat φ₁ j _ rfl _ _ inf_le_left e0 e01 b₀,
      hnat φ₂ c _ hw.symm _ _ inf_le_right e1 e01 b₁, hb₀, hb₁, hisoinv, hisoinv]
    exact hpq
  intro A _ P j c _ _ hpb
  exact main (.of (Polynomial A)) (.of (LaurentPolynomial A)) _ _ P j c hpb (fun g => by
    obtain ⟨p, q, h⟩ := s1 A g
    exact ⟨p, q, h⟩)

theorem wcpa_dj_p1r_fm_fibre_lift : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Y : Scheme.{u}) (v : Y ⟶ Spec (.of A)) {m : ℕ} (V : Fin m → Y.Opens), (∀ a, IsAffineOpen (V a)) → (∀ a b, IsAffineOpen (V a ⊓ V b)) → wcpaP1rRawH1 (fun a => Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) ⁻¹ᵁ V a) → wcpaP1rModH1 v (IsLocalRing.maximalIdeal A) V :=
by
  intro A _ _ Y v m V hV hV2 hRaw
  classical

  have s2 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (X X₀ : Scheme.{u})
      (h : X ⟶ Spec (.of B)) (i : X₀ ⟶ X) (h₀ : X₀ ⟶ Spec (.of (IsLocalRing.ResidueField B))),
      i ≫ h = h₀ ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) →
      ∀ W : X.Opens, Ideal.map (wcCnSigma h W) (IsLocalRing.maximalIdeal B) ≤
        RingHom.ker (i.app W).hom := by
    intro B _ _ X X₀ h i h₀ hw W
    rw [Ideal.map_le_iff_le_comap]
    intro b hb
    rw [Ideal.mem_comap, RingHom.mem_ker]
    have e1 : X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op ≫ i.app W =
        i.appTop ≫ X₀.presheaf.map (homOfLE (le_top : i ⁻¹ᵁ W ≤ ⊤)).op :=
      Scheme.Hom.naturality _ _
    have e2 : h.appTop ≫ i.appTop =
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))).appTop ≫ h₀.appTop := by
      rw [← Scheme.Hom.comp_appTop, hw, Scheme.Hom.comp_appTop]
    have e3 : (Scheme.ΓSpecIso (.of B)).inv ≫
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))).appTop =
        CommRingCat.ofHom (IsLocalRing.residue B) ≫ (Scheme.ΓSpecIso _).inv :=
      (Scheme.ΓSpecIso_inv_naturality _).symm
    have e4 : (Scheme.ΓSpecIso (.of B)).inv ≫ h.appTop ≫
        X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op ≫ i.app W =
        CommRingCat.ofHom (IsLocalRing.residue B) ≫ (Scheme.ΓSpecIso _).inv ≫ h₀.appTop ≫
          X₀.presheaf.map (homOfLE (le_top : i ⁻¹ᵁ W ≤ ⊤)).op := by
      rw [e1, ← Category.assoc h.appTop, e2, ← Category.assoc, ← Category.assoc, e3]
      simp only [Category.assoc]
    have key := congrArg (fun φ => φ.hom b) e4
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at key
    show (i.app W).hom ((X.presheaf.map (homOfLE le_top).op).hom
      (h.appTop.hom ((Scheme.ΓSpecIso (.of B)).inv.hom b))) = 0
    rw [key]
    have hres : IsLocalRing.residue B b = 0 := (IsLocalRing.residue_eq_zero_iff b).mpr hb
    rw [CommRingCat.hom_ofHom, hres, map_zero, map_zero, map_zero]

  have s1 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (X X₀ : Scheme.{u})
      (h : X ⟶ Spec (.of B)) (i : X₀ ⟶ X) (h₀ : X₀ ⟶ Spec (.of (IsLocalRing.ResidueField B))),
      IsPullback i h₀ h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) →
      ∀ W : X.Opens, IsAffineOpen W → Function.Surjective (i.app W).hom ∧
        RingHom.ker (i.app W).hom = Ideal.map (wcCnSigma h W) (IsLocalRing.maximalIdeal B) := by
    intro B _ _ X X₀ h i h₀ hpb W hW
    haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) :=
      IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
    haveI : IsClosedImmersion i :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hpb.flip ‹_›
    refine ⟨Scheme.Hom.app_surjective i W hW, le_antisymm ?_ (s2 B X X₀ h i h₀ hpb.w W)⟩
    intro r hr
    set I := Ideal.map (wcCnSigma h W) (IsLocalRing.maximalIdeal B) with hI
    let q : Γ(X, W) →+* Γ(X, W) ⧸ I := Ideal.Quotient.mk I
    let qκ : IsLocalRing.ResidueField B →+* Γ(X, W) ⧸ I :=
      Ideal.quotientMap I (wcCnSigma h W) Ideal.le_comap_map
    set t : Spec (.of (Γ(X, W) ⧸ I)) ⟶ X := Spec.map (CommRingCat.ofHom q) ≫ hW.fromSpec
      with ht_def
    have ht : t ≫ h = Spec.map (CommRingCat.ofHom qκ) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) := by
      rw [ht_def, Category.assoc, ← IsAffineOpen.SpecMap_appLE_fromSpec h (isAffineOpen_top _) hW
        le_top, IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Spec.map_comp,
        ← Spec.map_comp, ← Spec.map_comp]
      congr 1
    let t' := hpb.lift t (Spec.map (CommRingCat.ofHom qκ)) ht
    have ht' : t' ≫ i = t := hpb.lift_fst _ _ _
    have e : ⊤ ≤ t ⁻¹ᵁ W := by
      intro x _
      have : Spec.map (CommRingCat.ofHom q) x ∈ hW.fromSpec ⁻¹ᵁ W := by
        rw [hW.fromSpec_preimage_self]; trivial
      exact this
    have hzero : ∀ (φ : Spec (.of (Γ(X, W) ⧸ I)) ⟶ X) (_ : t' ≫ i = φ) (e' : ⊤ ≤ φ ⁻¹ᵁ W),
        (φ.appLE W ⊤ e').hom r = 0 := by
      rintro φ rfl e'
      rw [← Scheme.Hom.appLE_comp_appLE t' i W (i ⁻¹ᵁ W) ⊤ le_rfl e', CommRingCat.comp_apply,
        ← Scheme.Hom.app_eq_appLE]
      rw [RingHom.mem_ker.mp hr, map_zero]
    have hcomp : t.appLE W ⊤ e =
        CommRingCat.ofHom q ≫ (Scheme.ΓSpecIso (.of (Γ(X, W) ⧸ I))).inv := by
      rw [Scheme.ΓSpecIso_inv_naturality, Scheme.Hom.comp_appLE, hW.fromSpec_app_self,
        Category.assoc]
      congr 1
    have h1 := hzero t ht' e
    rw [hcomp, CommRingCat.comp_apply] at h1
    have h2 : q r = 0 := by
      have := congrArg (Scheme.ΓSpecIso (.of (Γ(X, W) ⧸ I))).hom.hom h1
      rwa [Iso.inv_hom_id_apply, map_zero] at this
    exact Ideal.Quotient.eq_zero_iff_mem.mp h2

  have main : ∀ (F : Scheme.{u}) (ι : F ⟶ Y) (h₀ : F ⟶ Spec (.of (IsLocalRing.ResidueField A))),
      IsPullback ι h₀ v (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) →
      wcpaP1rRawH1 (fun a => ι ⁻¹ᵁ V a) → wcpaP1rModH1 v (IsLocalRing.maximalIdeal A) V := by
    intro F ι h₀ hpb hR z hz
    have hρ : ∀ (W : Y.Opens), IsAffineOpen W → ∀ (U : F.Opens) (_ : U = ι ⁻¹ᵁ W)
        (e : U ≤ ι ⁻¹ᵁ W), Function.Surjective (ι.appLE W U e).hom ∧
          RingHom.ker (ι.appLE W U e).hom =
            Ideal.map (wcCnSigma v W) (IsLocalRing.maximalIdeal A) := by
      intro W hW U hUe e
      subst hUe
      have := s1 A Y F v ι h₀ hpb W hW
      rwa [Scheme.Hom.app_eq_appLE] at this
    have hρ' : ∀ (W : Y.Opens) (U : F.Opens) (_ : U = ι ⁻¹ᵁ W) (e : U ≤ ι ⁻¹ᵁ W),
        Ideal.map (wcCnSigma v W) (IsLocalRing.maximalIdeal A) ≤
          RingHom.ker (ι.appLE W U e).hom := by
      intro W U hUe e
      subst hUe
      have := s2 A Y F v ι h₀ hpb.w W
      rwa [Scheme.Hom.app_eq_appLE] at this
    have hres : ∀ (W W' : Y.Opens) (iW : W' ≤ W) (U U' : F.Opens) (iU : U' ≤ U)
        (e : U ≤ ι ⁻¹ᵁ W) (e' : U' ≤ ι ⁻¹ᵁ W') (s : Γ(Y, W)),
        (ι.appLE W' U' e').hom ((Y.presheaf.map (homOfLE iW).op).hom s) =
          (F.presheaf.map (homOfLE iU).op).hom ((ι.appLE W U e).hom s) := by
      intro W W' iW U U' iU e e' s
      have : Y.presheaf.map (homOfLE iW).op ≫ ι.appLE W' U' e' =
          ι.appLE W U e ≫ F.presheaf.map (homOfLE iU).op := by
        rw [Scheme.Hom.map_appLE, Scheme.Hom.appLE_map]
      simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using congrArg (fun φ => φ.hom s) this
    have eq2 : ∀ a b, ι ⁻¹ᵁ V a ⊓ ι ⁻¹ᵁ V b = ι ⁻¹ᵁ (V a ⊓ V b) := by
      intro a b
      first | rfl | simp [Scheme.Hom.preimage_inf]
    have eq3 : ∀ a b d, ι ⁻¹ᵁ V a ⊓ ι ⁻¹ᵁ V b ⊓ ι ⁻¹ᵁ V d = ι ⁻¹ᵁ (V a ⊓ V b ⊓ V d) := by
      intro a b d
      first | rfl | simp [Scheme.Hom.preimage_inf]

    obtain ⟨β, hβ⟩ := hR (fun a b => (ι.appLE (V a ⊓ V b) (ι ⁻¹ᵁ V a ⊓ ι ⁻¹ᵁ V b)
      (eq2 a b).le).hom (z a b)) (by
        intro a b d
        have e_ad := hres (V a ⊓ V d) (V a ⊓ V b ⊓ V d)
          (le_inf (inf_le_left.trans inf_le_left) inf_le_right)
          (ι ⁻¹ᵁ V a ⊓ ι ⁻¹ᵁ V d) (ι ⁻¹ᵁ V a ⊓ ι ⁻¹ᵁ V b ⊓ ι ⁻¹ᵁ V d)
          (le_inf (inf_le_left.trans inf_le_left) inf_le_right) (eq2 a d).le (eq3 a b d).le
          (z a d)
        have e_bd := hres (V b ⊓ V d) (V a ⊓ V b ⊓ V d)
          (le_inf (inf_le_left.trans inf_le_right) inf_le_right)
          (ι ⁻¹ᵁ V b ⊓ ι ⁻¹ᵁ V d) (ι ⁻¹ᵁ V a ⊓ ι ⁻¹ᵁ V b ⊓ ι ⁻¹ᵁ V d)
          (le_inf (inf_le_left.trans inf_le_right) inf_le_right) (eq2 b d).le (eq3 a b d).le
          (z b d)
        have e_ab := hres (V a ⊓ V b) (V a ⊓ V b ⊓ V d) inf_le_left
          (ι ⁻¹ᵁ V a ⊓ ι ⁻¹ᵁ V b) (ι ⁻¹ᵁ V a ⊓ ι ⁻¹ᵁ V b ⊓ ι ⁻¹ᵁ V d)
          inf_le_left (eq2 a b).le (eq3 a b d).le (z a b)
        have hk := hρ' (V a ⊓ V b ⊓ V d) _ (eq3 a b d) (eq3 a b d).le (hz a b d)
        rw [RingHom.mem_ker, map_sub, map_sub, e_ad, e_bd, e_ab] at hk
        rw [← sub_eq_zero, ← sub_sub]
        exact hk)

    have hsurj : ∀ a, ∃ x : Γ(Y, V a), (ι.appLE (V a) (ι ⁻¹ᵁ V a) le_rfl).hom x = β a :=
      fun a => (hρ (V a) (hV a) _ rfl le_rfl).1 (β a)
    choose x hx using hsurj
    refine ⟨x, fun a b => ?_⟩
    obtain ⟨_, hker⟩ := hρ (V a ⊓ V b) (hV2 a b) _ (eq2 a b) (eq2 a b).le
    rw [← hker, RingHom.mem_ker, map_sub, map_sub]
    have e_b := hres (V b) (V a ⊓ V b) inf_le_right (ι ⁻¹ᵁ V b) (ι ⁻¹ᵁ V a ⊓ ι ⁻¹ᵁ V b)
      inf_le_right le_rfl (eq2 a b).le (x b)
    have e_a := hres (V a) (V a ⊓ V b) inf_le_left (ι ⁻¹ᵁ V a) (ι ⁻¹ᵁ V a ⊓ ι ⁻¹ᵁ V b)
      inf_le_left le_rfl (eq2 a b).le (x a)
    rw [e_b, e_a, hx a, hx b]
    exact sub_eq_zero.mpr (hβ a b)
  exact main _ _ _ (IsPullback.of_hasPullback _ _) hRaw

theorem wcpa_dj_p1r_hv_fibre_mod : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥W)), (∃ θκ : Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W)) MvPolynomial.gradedAlgebra, θκ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W)) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField ↥W) ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W) 0))) = Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) → ∀ {m : ℕ} (V : Fin m → Y.Opens), (∀ a, IsAffineOpen (V a)) → (∀ a b, IsAffineOpen (V a ⊓ V b)) → (∀ a b d, IsAffineOpen (V a ⊓ V b ⊓ V d)) → (⨆ a, V a) = ⊤ → wcpaP1rModH1 v (IsLocalRing.maximalIdeal ↥W) V :=
by
  intro Ω _ _ W Y v hθ m V hV hV2 _hV3 hcov
  obtain ⟨θκ, -⟩ := hθ
  obtain ⟨j, c, hj, hc, -, hjc, hpb⟩ := wc_P1_ring_charts (IsLocalRing.ResidueField ↥W)
  haveI := hj
  haveI := hc

  haveI hj' : IsOpenImmersion (j ≫ θκ.inv) := inferInstance
  haveI hc' : IsOpenImmersion (c ≫ θκ.inv) := inferInstance
  have hpb' : IsPullback
      (Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom
        (algebraMap (IsLocalRing.ResidueField ↥W) (LaurentPolynomial (IsLocalRing.ResidueField ↥W)))
        (LaurentPolynomial.T (-1)))))
      (Spec.map (CommRingCat.ofHom (Polynomial.toLaurent : Polynomial (IsLocalRing.ResidueField ↥W)
        →+* LaurentPolynomial (IsLocalRing.ResidueField ↥W))))
      (j ≫ θκ.inv) (c ≫ θκ.inv) :=
    IsPullback.of_iso hpb (Iso.refl _) (Iso.refl _) (Iso.refl _) θκ.symm
      (by simp) (by simp) (by simp <;> rfl) (by simp <;> rfl)

  have hDtop : (⨆ k, (![(j ≫ θκ.inv).opensRange, (c ≫ θκ.inv).opensRange] :
      Fin 2 → (Limits.pullback v (Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).Opens) k) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    rw [TopologicalSpace.Opens.mem_iSup]
    rcases hjc (θκ.hom x) with ⟨y, hy⟩ | ⟨y, hy⟩
    · refine ⟨0, ?_⟩
      refine ⟨y, ?_⟩
      show θκ.inv (j y) = x
      rw [hy, ← Scheme.Hom.comp_apply, Iso.hom_inv_id]
      rfl
    · refine ⟨1, ?_⟩
      refine ⟨y, ?_⟩
      show θκ.inv (c y) = x
      rw [hy, ← Scheme.Hom.comp_apply, Iso.hom_inv_id]
      rfl
  have hV'top : (⨆ a, Limits.pullback.fst v (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ⁻¹ᵁ V a) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hx : Limits.pullback.fst v (Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x ∈ (⨆ a, V a) := by
      rw [hcov]; trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hx ⊢
    obtain ⟨a, ha⟩ := hx
    exact ⟨a, ha⟩
  have hRawD := wcpa_dj_p1r_fm_two_chart (IsLocalRing.ResidueField ↥W) _ (j ≫ θκ.inv)
    (c ≫ θκ.inv) hpb'
  have hk : ∀ k : Fin 2, wcpaP1rRawH1 (fun a => Limits.pullback.fst v (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ⁻¹ᵁ V a ⊓
      (![(j ≫ θκ.inv).opensRange, (c ≫ θκ.inv).opensRange] :
        Fin 2 → (Limits.pullback v (Spec.map (CommRingCat.ofHom
          (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).Opens) k) := by
    intro k
    have hDaff : IsAffineOpen ((![(j ≫ θκ.inv).opensRange, (c ≫ θκ.inv).opensRange] :
        Fin 2 → (Limits.pullback v (Spec.map (CommRingCat.ofHom
          (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).Opens) k) := by
      fin_cases k
      · exact isAffineOpen_opensRange (j ≫ θκ.inv)
      · exact isAffineOpen_opensRange (c ≫ θκ.inv)
    refine wcpa_dj_p1r_fm_affine_cover _ _ hDaff _ (fun a => inf_le_right) ?_
    rw [← iSup_inf_eq, hV'top, top_inf_eq]
  have hRawV' := wcpa_dj_p1r_fm_cover_change _ _ _ (hV'top.trans hDtop.symm) hRawD hk

  exact wcpa_dj_p1r_fm_fibre_lift ↥W Y v V hV hV2 hRawV'

theorem wcpa_dj_lsl_flat_level_scheme : (∀ (A : Type u) [CommRing A] (S₀ : Finset A) (B : Type u) [CommRing B] [Algebra ↥(Subring.closure (S₀ : Set A)) B] [Algebra.FiniteType ↥(Subring.closure (S₀ : Set A)) B], Module.Flat A (TensorProduct ↥(Subring.closure (S₀ : Set A)) A B) → ∃ (S : Finset A) (hS : Subring.closure (S₀ : Set A) ≤ Subring.closure (S : Set A)), ∀ (T : Finset A) (hT : Subring.closure (S : Set A) ≤ Subring.closure (T : Set A)), letI := (Subring.inclusion (hS.trans hT)).toAlgebra; Module.Flat ↥(Subring.closure (T : Set A)) (TensorProduct ↥(Subring.closure (S₀ : Set A)) ↥(Subring.closure (T : Set A)) B)) → ∀ (A : Type u) [CommRing A] (S₀ : Finset A) (Y₀ : Scheme.{u}) (h₀ : Y₀ ⟶ Spec (.of ↥(Subring.closure (S₀ : Set A)))) [QuasiCompact h₀] [LocallyOfFiniteType h₀] (X : Scheme.{u}) (u : X ⟶ Spec (.of A)) (ψ : X ⟶ Y₀), IsPullback ψ u h₀ (Spec.map (CommRingCat.ofHom (Subring.closure (S₀ : Set A)).subtype)) → Flat u → ∃ (S : Finset A) (hS : Subring.closure (S₀ : Set A) ≤ Subring.closure (S : Set A)), ∀ (T : Finset A) (hT : Subring.closure (S : Set A) ≤ Subring.closure (T : Set A)), Flat (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion (hS.trans hT))))) :=
by
  intro H A _ S₀ Y₀ h₀ _ _ X u ψ hpb hu
  classical

  have s1 : ∀ (Z : Scheme.{u}) [CompactSpace Z], ∃ (m : ℕ) (W : Fin m → Z.Opens),
      (∀ j, IsAffineOpen (W j)) ∧ (⨆ j, W j) = ⊤ := by
    intro Z _
    have hx : ∀ x : Z, ∃ W : Z.Opens, IsAffineOpen W ∧ x ∈ W := by
      intro x
      obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := x) trivial
      exact ⟨W, hW, hxW⟩
    choose Wx hWx hxW using hx
    obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover (fun x => (Wx x : Set Z))
      (fun x => (Wx x).isOpen.mem_nhds (hxW x))
    refine ⟨t.card, fun j => Wx (t.equivFin.symm j), fun j => hWx _, ?_⟩
    apply TopologicalSpace.Opens.ext
    rw [TopologicalSpace.Opens.coe_iSup, TopologicalSpace.Opens.coe_top]
    apply Set.eq_univ_of_forall
    intro y
    have hy : y ∈ ⋃ x ∈ t, (Wx x : Set Z) := by rw [ht]; trivial
    rw [Set.mem_iUnion₂] at hy
    obtain ⟨x, hxt, hyx⟩ := hy
    rw [Set.mem_iUnion]
    refine ⟨t.equivFin ⟨x, hxt⟩, ?_⟩
    simpa using hyx

  have s2 : ∀ (R : Type u) [CommRing R] (Y : Scheme.{u}) (h : Y ⟶ Spec (.of R))
      [LocallyOfFiniteType h] (W : Y.Opens) (hW : IsAffineOpen W),
      (Spec.preimage (hW.fromSpec ≫ h)).hom.FiniteType := by
    intro R _ Y h _ W hW
    haveI := hW.isOpenImmersion_fromSpec
    have h1 : LocallyOfFiniteType (hW.fromSpec ≫ h) := inferInstance
    rw [← Spec.map_preimage (hW.fromSpec ≫ h)] at h1
    exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp h1

  have s3 : ∀ {Y Z T R : Scheme.{u}} (h : Y ⟶ R) (g : T ⟶ R) (ψ' : Z ⟶ Y) (u' : Z ⟶ T)
      (W : Y.Opens) (hW : IsAffineOpen W), IsPullback ψ' u' h g →
      IsPullback ((ψ' ∣_ W) ≫ hW.isoSpec.hom) ((ψ' ⁻¹ᵁ W).ι ≫ u') (hW.fromSpec ≫ h) g := by
    intro Y Z T R h g ψ' u' W hW hp
    have h1 := (isPullback_morphismRestrict ψ' W).paste_vert hp
    have h2 : IsPullback hW.isoSpec.hom (W.ι ≫ h) (hW.fromSpec ≫ h) (𝟙 R) := by
      refine IsPullback.of_horiz_isIso ⟨?_⟩
      rw [Category.comp_id, ← hW.isoSpec_inv_ι, Category.assoc, Iso.hom_inv_id_assoc]
    have h3 := h1.paste_horiz h2
    rw [Category.comp_id] at h3
    exact h3

  have s4 : ∀ (R T B : Type u) [CommRing R] [CommRing T] [CommRing B] [Algebra R T] [Algebra R B]
      (P : Scheme.{u}) (p : P ⟶ Spec (.of B)) (q : P ⟶ Spec (.of T)),
      IsPullback p q (Spec.map (CommRingCat.ofHom (algebraMap R B)))
        (Spec.map (CommRingCat.ofHom (algebraMap R T))) →
      (Flat q ↔ Module.Flat T (TensorProduct R T B)) := by
    intro R T B _ _ _ _ _ P p q hp
    have e1 := hp.flip.isoPullback_hom_fst
    have e2 := pullbackSpecIso_hom_fst R T B
    have hq : q = (hp.flip.isoPullback.hom ≫ (pullbackSpecIso R T B).hom) ≫
        Spec.map (CommRingCat.ofHom (algebraMap T (TensorProduct R T B))) := by
      conv_lhs => rw [← e1, ← e2]
      rw [Category.assoc]
    have hflat : Flat (Spec.map (CommRingCat.ofHom (algebraMap T (TensorProduct R T B)))) ↔
        Module.Flat T (TensorProduct R T B) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
        RingHom.flat_algebraMap_iff]
    rw [← hflat]
    have hEiso : IsIso (hp.flip.isoPullback.hom ≫ (pullbackSpecIso R T B).hom) := inferInstance
    generalize hp.flip.isoPullback.hom ≫ (pullbackSpecIso R T B).hom = E at hq hEiso
    rw [hq]
    constructor
    · intro hq'
      have h5 : Flat (inv E ≫ E ≫
          Spec.map (CommRingCat.ofHom (algebraMap T (TensorProduct R T B)))) := by
        infer_instance
      rwa [IsIso.inv_hom_id_assoc] at h5
    · intro h
      infer_instance

  haveI : CompactSpace Y₀ := QuasiCompact.compactSpace_of_compactSpace h₀
  obtain ⟨m, W, hW, hcov⟩ := s1 Y₀

  have s6 : ∀ (T : Type u) [CommRing T] [Algebra (Subring.closure (S₀ : Set A)) T]
      (X' : Scheme.{u}) (u' : X' ⟶ Spec (.of T)) (ψ' : X' ⟶ Y₀),
      IsPullback ψ' u' h₀ (Spec.map (CommRingCat.ofHom
        (algebraMap (Subring.closure (S₀ : Set A)) T))) →
      ∀ j, letI := (Spec.preimage ((hW j).fromSpec ≫ h₀)).hom.toAlgebra;
        (Flat ((ψ' ⁻¹ᵁ W j).ι ≫ u') ↔
          Module.Flat T (TensorProduct (Subring.closure (S₀ : Set A)) T Γ(Y₀, W j))) := by
    intro T _ _ X' u' ψ' hp j
    letI := (Spec.preimage ((hW j).fromSpec ≫ h₀)).hom.toAlgebra
    have h1 := s3 h₀ _ ψ' u' (W j) (hW j) hp
    have hD3 : (hW j).fromSpec ≫ h₀ = Spec.map (CommRingCat.ofHom
        (algebraMap (Subring.closure (S₀ : Set A)) Γ(Y₀, W j))) := by
      rw [RingHom.algebraMap_toAlgebra, CommRingCat.ofHom_hom, Spec.map_preimage]
    rw [hD3] at h1
    exact s4 (Subring.closure (S₀ : Set A)) T Γ(Y₀, W j) _ _ _ h1

  have hAflat : ∀ j, letI := (Spec.preimage ((hW j).fromSpec ≫ h₀)).hom.toAlgebra;
      Module.Flat A (TensorProduct (Subring.closure (S₀ : Set A)) A Γ(Y₀, W j)) := by
    intro j
    exact (s6 A X u ψ hpb j).mp inferInstance

  have hH : ∀ j, ∃ (S : Finset A) (hS : Subring.closure (S₀ : Set A) ≤ Subring.closure (S : Set A)),
      ∀ (T : Finset A) (hT : Subring.closure (S : Set A) ≤ Subring.closure (T : Set A)),
      letI := (Spec.preimage ((hW j).fromSpec ≫ h₀)).hom.toAlgebra;
      letI := (Subring.inclusion (hS.trans hT)).toAlgebra;
      Module.Flat (Subring.closure (T : Set A))
        (TensorProduct (Subring.closure (S₀ : Set A)) (Subring.closure (T : Set A)) Γ(Y₀, W j)) := by
    intro j
    letI := (Spec.preimage ((hW j).fromSpec ≫ h₀)).hom.toAlgebra
    haveI : Algebra.FiniteType (Subring.closure (S₀ : Set A)) Γ(Y₀, W j) :=
      s2 (Subring.closure (S₀ : Set A)) Y₀ h₀ (W j) (hW j)
    exact H A S₀ Γ(Y₀, W j) (hAflat j)
  choose Sj hSj hHj using hH
  have hS : Subring.closure (S₀ : Set A) ≤
      Subring.closure ((S₀ ∪ Finset.univ.biUnion Sj : Finset A) : Set A) :=
    Subring.closure_mono (Finset.coe_subset.mpr Finset.subset_union_left)
  have hjS : ∀ j, Subring.closure (Sj j : Set A) ≤
      Subring.closure ((S₀ ∪ Finset.univ.biUnion Sj : Finset A) : Set A) := fun j =>
    Subring.closure_mono (Finset.coe_subset.mpr
      ((Finset.subset_biUnion_of_mem Sj (Finset.mem_univ j)).trans Finset.subset_union_right))
  refine ⟨S₀ ∪ Finset.univ.biUnion Sj, hS, ?_⟩

  intro T hT
  have hcovQ : (⨆ j, Limits.pullback.fst h₀
      (Spec.map (CommRingCat.ofHom (Subring.inclusion (hS.trans hT)))) ⁻¹ᵁ W j) = ⊤ := by
    rw [← Scheme.Hom.preimage_iSup, hcov, Scheme.Hom.preimage_top]
  rw [@IsZariskiLocalAtSource.iff_of_iSup_eq_top @Flat HasRingHomProperty.instIsZariskiLocalAtSource
    _ _ _ _ _ hcovQ]
  intro j
  letI := (Subring.inclusion (hS.trans hT)).toAlgebra
  exact (s6 (Subring.closure (T : Set A)) _ _ _ (IsPullback.of_hasPullback _ _) j).mpr
    (hHj j T ((hjS j).trans hT))

theorem wcpa_dj_lsl_flat_level_ring : ∀ (A : Type u) [CommRing A] (S₀ : Finset A) (B : Type u) [CommRing B] [Algebra ↥(Subring.closure (S₀ : Set A)) B] [Algebra.FiniteType ↥(Subring.closure (S₀ : Set A)) B], Module.Flat A (TensorProduct ↥(Subring.closure (S₀ : Set A)) A B) → ∃ (S : Finset A) (hS : Subring.closure (S₀ : Set A) ≤ Subring.closure (S : Set A)), ∀ (T : Finset A) (hT : Subring.closure (S : Set A) ≤ Subring.closure (T : Set A)), letI := (Subring.inclusion (hS.trans hT)).toAlgebra; Module.Flat ↥(Subring.closure (T : Set A)) (TensorProduct ↥(Subring.closure (S₀ : Set A)) ↥(Subring.closure (T : Set A)) B) :=
by
  intro A _ S₀ B _ _ _ hflatA
  classical

  haveI hR₀ : IsNoetherianRing (Subring.closure (S₀ : Set A)) :=
    is_noetherian_subring_closure _ S₀.finite_toSet
  haveI : Algebra.FinitePresentation (Subring.closure (S₀ : Set A)) B :=
    (Algebra.FinitePresentation.of_finiteType).mp inferInstance
  obtain ⟨n, π, hπ, hker⟩ :=
    (inferInstance : Algebra.FinitePresentation (Subring.closure (S₀ : Set A)) B).out
  obtain ⟨s₀, hs₀⟩ := hker
  obtain ⟨e₀⟩ : Nonempty ((MvPolynomial (Fin n) (Subring.closure (S₀ : Set A)) ⧸
      Ideal.span (↑s₀ : Set (MvPolynomial (Fin n) (Subring.closure (S₀ : Set A)))))
      ≃ₐ[Subring.closure (S₀ : Set A)] B) :=
    ⟨(Ideal.quotientEquivAlgOfEq _ hs₀).trans (Ideal.quotientKerAlgEquivOfSurjective hπ)⟩

  have TF : ∀ (R₁ R' M' : Type u) [CommRing R₁] [CommRing R'] [CommRing M'] [Algebra R₁ R']
      [Algebra R₁ M'] (t₀ : Set (MvPolynomial (Fin n) R₁)),
      ((MvPolynomial (Fin n) R₁ ⧸ Ideal.span t₀) ≃ₐ[R₁] M') →
      (Module.Flat R' (TensorProduct R₁ R' M') ↔
        Module.Flat R' (MvPolynomial (Fin n) R' ⧸
          Ideal.span (MvPolynomial.map (algebraMap R₁ R') '' t₀))) := by
    intro R₁ R' M' _ _ _ _ _ t₀ e
    obtain ⟨e₂⟩ := wcpa_lfg_fa_tensor_quot R₁ R' n t₀
    let e₁ : TensorProduct R₁ R' (MvPolynomial (Fin n) R₁ ⧸ Ideal.span t₀) ≃ₐ[R']
        TensorProduct R₁ R' M' := Algebra.TensorProduct.congr AlgEquiv.refl e
    let M := (e₁.symm.trans e₂).toLinearEquiv
    exact ⟨fun h => by haveI := h; exact Module.Flat.of_linearEquiv M.symm,
      fun h => by haveI := h; exact Module.Flat.of_linearEquiv M⟩

  have BC : ∀ (R₁ R₂ : Type u) [CommRing R₁] [CommRing R₂] (ρ : R₁ →+* R₂)
      (t : Set (MvPolynomial (Fin n) R₁)),
      Module.Flat R₁ (MvPolynomial (Fin n) R₁ ⧸ Ideal.span t) →
      Module.Flat R₂ (MvPolynomial (Fin n) R₂ ⧸ Ideal.span (MvPolynomial.map ρ '' t)) := by
    intro R₁ R₂ _ _ ρ t ht
    letI : Algebra R₁ R₂ := ρ.toAlgebra
    haveI := ht
    haveI : Module.Flat R₂ (TensorProduct R₁ R₂ (MvPolynomial (Fin n) R₁ ⧸ Ideal.span t)) :=
      Module.Flat.baseChange R₁ R₂ _
    exact (TF R₁ R₂ _ t AlgEquiv.refl).mp this

  have hA : Module.Flat A (MvPolynomial (Fin n) A ⧸ Ideal.span
      (MvPolynomial.map (algebraMap (Subring.closure (S₀ : Set A)) A) ''
        (↑s₀ : Set (MvPolynomial (Fin n) (Subring.closure (S₀ : Set A)))))) :=
    (TF _ A B _ e₀).mp hflatA
  set s : Finset (MvPolynomial (Fin n) A) :=
    s₀.image (MvPolynomial.map (algebraMap (Subring.closure (S₀ : Set A)) A)) with hsdef
  have hs : (↑s : Set (MvPolynomial (Fin n) A)) =
      MvPolynomial.map (algebraMap (Subring.closure (S₀ : Set A)) A) ''
        (↑s₀ : Set (MvPolynomial (Fin n) (Subring.closure (S₀ : Set A)))) := Finset.coe_image
  have hflatC : Module.Flat A (MvPolynomial (Fin n) A ⧸
      Ideal.span (↑s : Set (MvPolynomial (Fin n) A))) := by
    rw [hs]; exact hA

  have key : ∀ P : PrimeSpectrum (MvPolynomial (Fin n) A), ∃ (F : Finset A)
      (s₁ : Finset (MvPolynomial (Fin n) (Subring.closure (F : Set A))))
      (g₁ : MvPolynomial (Fin n) (Subring.closure (F : Set A))),
      Ideal.span ((MvPolynomial.map (algebraMap (Subring.closure (F : Set A)) A)) ''
        (↑s₁ : Set (MvPolynomial (Fin n) (Subring.closure (F : Set A))))) =
        Ideal.span (↑s : Set (MvPolynomial (Fin n) A)) ∧
      MvPolynomial.map (algebraMap (Subring.closure (F : Set A)) A) g₁ ∉ P.asIdeal ∧
      Module.Flat (Subring.closure (F : Set A)) (Localization.Away g₁ ⧸
        (Ideal.span (↑s₁ : Set (MvPolynomial (Fin n) (Subring.closure (F : Set A))))).map
          (algebraMap (MvPolynomial (Fin n) (Subring.closure (F : Set A))) (Localization.Away g₁))) := by
    intro P
    haveI := P.isPrime
    have hq := wcpa_lfg_fa_flat_localize A (MvPolynomial (Fin n) A) _ hflatC P.asIdeal
    obtain ⟨R₀', _, hft, _, s₀'', hsp, hfl⟩ := wcpa_lfg_fa_descend_ft A n s P.asIdeal hq
    haveI := Algebra.FiniteType.isNoetherianRing ℤ R₀'
    obtain ⟨F, hF⟩ := wcpa_lfg_fa_ft_image_closure R₀' A (algebraMap R₀' A)
    obtain ⟨s₁, g₁, e1, e2, e3⟩ := wcpa_lfg_fa_local_model A n P.asIdeal _ R₀' s₀'' F hF hsp hfl
    exact ⟨F, s₁, g₁, e1, e2, e3⟩
  choose F₀ s₀' g₀ k1 k2 k3 using key
  have htop0 : Ideal.span (Set.range fun P =>
      MvPolynomial.map (algebraMap (Subring.closure (F₀ P : Set A)) A) (g₀ P)) = ⊤ := by
    by_contra hne
    obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ hne
    exact k2 ⟨M, hM.isPrime⟩ (hle (Ideal.subset_span ⟨⟨M, hM.isPrime⟩, rfl⟩))
  obtain ⟨Fm, Tc, hFc, s₂, hspan₂, hJi, htop⟩ :=
    wcpa_lfg_fa_common_level A n s (PrimeSpectrum (MvPolynomial (Fin n) A)) F₀ s₀' g₀ k1 htop0
  have gen : ∀ (R₁ R₂ : Type u) [CommRing R₁] [CommRing R₂] (ρ : R₁ →+* R₂)
      (t₀ : Set (MvPolynomial (Fin n) R₁)) (t : Set (MvPolynomial (Fin n) R₂))
      (g : MvPolynomial (Fin n) R₁),
      Ideal.span (MvPolynomial.map ρ '' t₀) = Ideal.span t →
      Module.Flat R₁ (Localization.Away g ⧸
        (Ideal.span t₀).map (algebraMap (MvPolynomial (Fin n) R₁) (Localization.Away g))) →
      Module.Flat R₂ (Localization.Away (MvPolynomial.map ρ g) ⧸
        (Ideal.span t).map (algebraMap (MvPolynomial (Fin n) R₂)
          (Localization.Away (MvPolynomial.map ρ g)))) := by
    intro R₁ R₂ _ _ ρ t₀ t g h hfl
    letI : Algebra R₁ R₂ := ρ.toAlgebra
    have hb := wcpa_ffp_flat_base_change R₁ R₂ n (Ideal.span t₀) g hfl
    rw [Ideal.map_span] at hb
    have e : (MvPolynomial.map (algebraMap R₁ R₂) :
        MvPolynomial (Fin n) R₁ →+* MvPolynomial (Fin n) R₂) = MvPolynomial.map ρ := rfl
    rw [e, h] at hb
    exact hb
  have hpiece : ∀ h ∈ Set.range (fun i : Tc => MvPolynomial.map (Subring.inclusion
      (Subring.closure_mono (Finset.coe_subset.mpr (hFc i.1 i.2)))) (g₀ i.1)),
      Module.Flat (Subring.closure (Fm : Set A)) (Localization.Away h ⧸
        (Ideal.span (↑s₂ : Set (MvPolynomial (Fin n) (Subring.closure (Fm : Set A))))).map
          (algebraMap (MvPolynomial (Fin n) (Subring.closure (Fm : Set A)))
            (Localization.Away h))) := by
    rintro _ ⟨⟨i, hi⟩, rfl⟩
    exact gen _ _ (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr (hFc i hi))))
      _ _ (g₀ i) (hJi i hi) (k3 i)
  have hflat₀ := wcpa_lfg_fa_flat_of_away_cover (Subring.closure (Fm : Set A))
    (MvPolynomial (Fin n) (Subring.closure (Fm : Set A)))
    (Ideal.span (↑s₂ : Set (MvPolynomial (Fin n) (Subring.closure (Fm : Set A))))) _ htop hpiece

  have Hinj : ∀ F : Finset A, Function.Injective
      (MvPolynomial.map (algebraMap (Subring.closure (F : Set A)) A) :
        MvPolynomial (Fin n) (Subring.closure (F : Set A)) → MvPolynomial (Fin n) A) := by
    intro F
    exact MvPolynomial.map_injective _ (fun a b hab => Subtype.ext hab)
  have Hcomp : ∀ (G F : Finset A) (h : G ⊆ F)
      (p : MvPolynomial (Fin n) (Subring.closure (G : Set A))),
      MvPolynomial.map (algebraMap (Subring.closure (F : Set A)) A)
        (MvPolynomial.map (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h))) p) =
      MvPolynomial.map (algebraMap (Subring.closure (G : Set A)) A) p := by
    intro G F h p
    rw [MvPolynomial.map_map]
    rfl
  have Hlift : ∀ (F : Finset A) (p : MvPolynomial (Fin n) A), (p.coeffs : Set A) ⊆ (F : Set A) →
      ∃ p' : MvPolynomial (Fin n) (Subring.closure (F : Set A)),
        MvPolynomial.map (algebraMap (Subring.closure (F : Set A)) A) p' = p := by
    intro F p hp
    have hmem : p ∈ Set.range (MvPolynomial.map (algebraMap (Subring.closure (F : Set A)) A) :
        MvPolynomial (Fin n) (Subring.closure (F : Set A)) → MvPolynomial (Fin n) A) := by
      rw [MvPolynomial.mem_range_map_iff_coeffs_subset]
      intro r hr
      exact ⟨⟨r, Subring.subset_closure (hp hr)⟩, rfl⟩
    exact hmem
  have Hdesc : ∀ (G₁ G₂ : Finset A) (x : MvPolynomial (Fin n) (Subring.closure (G₁ : Set A)))
      (t : Set (MvPolynomial (Fin n) (Subring.closure (G₂ : Set A)))),
      MvPolynomial.map (algebraMap (Subring.closure (G₁ : Set A)) A) x ∈
        Ideal.span (MvPolynomial.map (algebraMap (Subring.closure (G₂ : Set A)) A) '' t) →
      ∃ E : Finset A, ∀ (F : Finset A) (h₁ : G₁ ⊆ F) (h₂ : G₂ ⊆ F), E ⊆ F →
        MvPolynomial.map (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₁))) x ∈
          Ideal.span (MvPolynomial.map (Subring.inclusion
            (Subring.closure_mono (Finset.coe_subset.mpr h₂))) '' t) := by
    intro G₁ G₂ x t hx
    obtain ⟨t', ht', c, hc⟩ := (Submodule.mem_span_image_iff_exists_fun _).mp hx
    refine ⟨Finset.univ.biUnion (fun σ : t' => (c σ).coeffs), ?_⟩
    intro F h₁ h₂ hE
    have hc' : ∀ σ : t', ∃ p' : MvPolynomial (Fin n) (Subring.closure (F : Set A)),
        MvPolynomial.map (algebraMap (Subring.closure (F : Set A)) A) p' = c σ := by
      intro σ
      apply Hlift
      intro r hr
      exact Finset.mem_coe.mpr (hE (Finset.mem_biUnion.mpr ⟨σ, Finset.mem_univ _, Finset.mem_coe.mp hr⟩))
    choose c' hc'' using hc'
    have hy : ∑ σ : t', c' σ * MvPolynomial.map (Subring.inclusion
        (Subring.closure_mono (Finset.coe_subset.mpr h₂))) σ.1 ∈
        Ideal.span (MvPolynomial.map (Subring.inclusion
          (Subring.closure_mono (Finset.coe_subset.mpr h₂))) '' t) := by
      apply Ideal.sum_mem
      intro σ _
      apply Ideal.mul_mem_left
      apply Ideal.subset_span
      exact Set.mem_image_of_mem _ (ht' σ.2)
    have heq : ∑ σ : t', c' σ * MvPolynomial.map (Subring.inclusion
        (Subring.closure_mono (Finset.coe_subset.mpr h₂))) σ.1 =
        MvPolynomial.map (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₁))) x := by
      apply Hinj F
      rw [map_sum, Hcomp G₁ F h₁ x, ← hc]
      refine Finset.sum_congr rfl (fun σ _ => ?_)
      rw [map_mul, hc'' σ, Hcomp G₂ F h₂, smul_eq_mul]
    rw [← heq]
    exact hy
  have Ha : ∀ x ∈ s₀, MvPolynomial.map (algebraMap (Subring.closure (S₀ : Set A)) A) x ∈
      Ideal.span (MvPolynomial.map (algebraMap (Subring.closure (Fm : Set A)) A) ''
        (↑s₂ : Set (MvPolynomial (Fin n) (Subring.closure (Fm : Set A))))) := by
    intro x hx
    rw [hspan₂, hs]
    exact Ideal.subset_span (Set.mem_image_of_mem _ hx)
  have Hb : ∀ y ∈ s₂, MvPolynomial.map (algebraMap (Subring.closure (Fm : Set A)) A) y ∈
      Ideal.span (MvPolynomial.map (algebraMap (Subring.closure (S₀ : Set A)) A) ''
        (↑s₀ : Set (MvPolynomial (Fin n) (Subring.closure (S₀ : Set A))))) := by
    intro y hy
    rw [← hs, ← hspan₂]
    exact Ideal.subset_span (Set.mem_image_of_mem _ hy)
  choose Ea hEa using fun (x : s₀) => Hdesc S₀ Fm x.1 _ (Ha x.1 x.2)
  choose Eb hEb using fun (y : s₂) => Hdesc Fm S₀ y.1 _ (Hb y.1 y.2)
  obtain ⟨F', h₁, h₂, hFa, hFb⟩ : ∃ F' : Finset A, S₀ ⊆ F' ∧ Fm ⊆ F' ∧
      (∀ x, Ea x ⊆ F') ∧ (∀ y, Eb y ⊆ F') := by
    refine ⟨S₀ ∪ Fm ∪ Finset.univ.biUnion Ea ∪ Finset.univ.biUnion Eb, ?_, ?_, ?_, ?_⟩
    · intro r hr
      exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _ hr))
    · intro r hr
      exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_right _ hr))
    · intro x r hr
      exact Finset.mem_union_left _ (Finset.mem_union_right _
        (Finset.mem_biUnion.mpr ⟨x, Finset.mem_univ _, hr⟩))
    · intro y r hr
      exact Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨y, Finset.mem_univ _, hr⟩)
  have hmatch : Ideal.span (MvPolynomial.map (Subring.inclusion
      (Subring.closure_mono (Finset.coe_subset.mpr h₁))) ''
        (↑s₀ : Set (MvPolynomial (Fin n) (Subring.closure (S₀ : Set A))))) =
      Ideal.span (MvPolynomial.map (Subring.inclusion
      (Subring.closure_mono (Finset.coe_subset.mpr h₂))) ''
        (↑s₂ : Set (MvPolynomial (Fin n) (Subring.closure (Fm : Set A))))) := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨x, hx, rfl⟩
      exact hEa ⟨x, hx⟩ F' h₁ h₂ (hFa _)
    · rw [Ideal.span_le]
      rintro _ ⟨y, hy, rfl⟩
      exact hEb ⟨y, hy⟩ F' h₂ h₁ (hFb _)

  have Hcomp2 : ∀ (G H K : Finset A) (hGH : Subring.closure (G : Set A) ≤ Subring.closure (H : Set A))
      (hHK : Subring.closure (H : Set A) ≤ Subring.closure (K : Set A))
      (p : MvPolynomial (Fin n) (Subring.closure (G : Set A))),
      MvPolynomial.map (Subring.inclusion hHK) (MvPolynomial.map (Subring.inclusion hGH) p) =
        MvPolynomial.map (Subring.inclusion (hGH.trans hHK)) p := by
    intro G H K hGH hHK p
    rw [MvPolynomial.map_map]
    rfl
  refine ⟨F', Subring.closure_mono (Finset.coe_subset.mpr h₁), ?_⟩
  intro T hT
  letI : Algebra (Subring.closure (S₀ : Set A)) (Subring.closure (T : Set A)) :=
    (Subring.inclusion ((Subring.closure_mono (Finset.coe_subset.mpr h₁)).trans hT)).toAlgebra
  have hT1 : Ideal.span (MvPolynomial.map (Subring.inclusion
      ((Subring.closure_mono (Finset.coe_subset.mpr h₁)).trans hT)) ''
        (↑s₀ : Set (MvPolynomial (Fin n) (Subring.closure (S₀ : Set A))))) =
      Ideal.span (MvPolynomial.map (Subring.inclusion
      ((Subring.closure_mono (Finset.coe_subset.mpr h₂)).trans hT)) ''
        (↑s₂ : Set (MvPolynomial (Fin n) (Subring.closure (Fm : Set A))))) := by
    have := congrArg (Ideal.map (MvPolynomial.map (Subring.inclusion hT))) hmatch
    rw [Ideal.map_span, Ideal.map_span, Set.image_image, Set.image_image] at this
    rw [Set.image_congr (fun x _ => (Hcomp2 S₀ F' T _ hT x).symm),
      Set.image_congr (fun x _ => (Hcomp2 Fm F' T _ hT x).symm)]
    exact this
  have hfT := BC _ _ (Subring.inclusion ((Subring.closure_mono (Finset.coe_subset.mpr h₂)).trans hT))
    _ hflat₀
  rw [← hT1] at hfT
  exact (TF _ _ B _ e₀).mpr hfT

theorem wcpa_dj_p1r_hvd_flat_presentation : ∀ (A : Type u) [CommRing A] [DecidableEq A] (Y : Scheme.{u}) (v : Y ⟶ Spec (.of A)), IsProper v → Flat v → LocallyOfFinitePresentation v → ∃ (S₀ S₁ : Finset A) (E : (Finset A)ᵒᵖ ⥤ Scheme.{u}) (ρ : (Functor.const (Finset A)ᵒᵖ).obj Y ⟶ E) (hE : ∀ T : Finset A, E.obj (Opposite.op T) ⟶ Spec (.of ↥(Subring.closure ((S₀ ∪ T : Finset A) : Set A)))), Nonempty (Limits.IsLimit (Limits.Cone.mk Y ρ)) ∧ (∀ {i j : (Finset A)ᵒᵖ} (g : i ⟶ j), IsAffineHom (E.map g)) ∧ (∀ i, CompactSpace (E.obj i)) ∧ (∀ i, QuasiSeparatedSpace (E.obj i)) ∧ (∀ T : Finset A, IsPullback (ρ.app (Opposite.op T)) v (hE T) (Spec.map (CommRingCat.ofHom (Subring.closure ((S₀ ∪ T : Finset A) : Set A)).subtype))) ∧ (∀ T : Finset A, IsProper (hE T)) ∧ ∀ T : Finset A, S₁ ⊆ T → Flat (hE T) :=
by
  intro A _ _ Y v hP hF hL
  haveI := hP
  haveI := hL
  obtain ⟨S₀, Y₀, h₀, π₀, hP₀, hpb₀⟩ := wc_fet_lfp_model_over_subring A
    (fun S => Subring.closure (S : Set A)) (fun S a ha => Subring.subset_closure (Finset.mem_coe.mpr ha))
    Y v
  haveI : IsProper h₀ := hP₀
  haveI : IsNoetherianRing ↥(Subring.closure (S₀ : Set A)) :=
    is_noetherian_subring_closure _ (Finset.finite_toSet S₀)
  have hqc : QuasiCompact h₀ := inferInstance
  have hqs : QuasiSeparated h₀ := inferInstance
  have hlfp : LocallyOfFinitePresentation h₀ := inferInstance
  obtain ⟨E, ρ, hE, sE, hlim, haff, hcpt, hqsE, -, -, -, hpbA, hsq, -, -, -⟩ :=
    wc_ap_fp_model_limit_presentation A Y v S₀ Y₀ h₀ π₀ hqc hqs hlfp hpb₀
  obtain ⟨S₁, hS₁, hfl⟩ := wcpa_dj_lsl_flat_level_scheme wcpa_dj_lsl_flat_level_ring A S₀ Y₀ h₀
    Y v π₀ hpb₀ hF
  refine ⟨S₀, S₁, E, ρ, hE, hlim, haff, hcpt, hqsE, hpbA, ?_, ?_⟩
  · intro T
    exact MorphismProperty.of_isPullback (P := @IsProper) (hsq T) hP₀
  · intro T hT
    have hT' : Subring.closure (S₁ : Set A) ≤ Subring.closure ((S₀ ∪ T : Finset A) : Set A) :=
      Subring.closure_mono (Finset.coe_subset.mpr (hT.trans Finset.subset_union_right))
    haveI : Flat (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion
        (Subring.closure_mono (Finset.coe_subset.mpr
          (Finset.subset_union_left : S₀ ⊆ S₀ ∪ T))))))) := hfl (S₀ ∪ T) hT'
    rw [← (hsq T).isoPullback_hom_snd]
    infer_instance

theorem wcpa_dj_p1r_hvd_opens_stage : ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (D : I ⥤ Scheme.{u}) (c : Limits.Cone D), Limits.IsLimit c → (∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f)) → (∀ i, CompactSpace (D.obj i)) → (∀ i, QuasiSeparatedSpace (D.obj i)) → ∀ (i₀ : I) {m : ℕ} (V : Fin m → c.pt.Opens), (∀ a, IsAffineOpen (V a)) → (⨆ a, V a) = ⊤ → ∃ (j : I) (_ : j ⟶ i₀) (W : Fin m → (D.obj j).Opens), (∀ a, IsAffineOpen (W a)) ∧ (⨆ a, W a) = ⊤ ∧ ∀ a, c.π.app j ⁻¹ᵁ W a = V a :=
by
  intro I _ _ D c hc haff hcpt hqs i₀ m V hVaff hVcov
  classical
  haveI : ∀ i, CompactSpace (D.obj i) := hcpt
  haveI : ∀ i, QuasiSeparatedSpace (D.obj i) := hqs
  choose i U hUaff hUeq using fun a => exists_isAffineOpen_preimage_eq D c hc (V a) (hVaff a)
  obtain ⟨j₁, hj₁⟩ := IsCofiltered.inf_objs_exists (insert i₀ (Finset.univ.image i))
  let f₀ : j₁ ⟶ i₀ := (hj₁ (Finset.mem_insert_self i₀ _)).some
  let f : ∀ a, j₁ ⟶ i a := fun a =>
    (hj₁ (Finset.mem_insert_of_mem (Finset.mem_image_of_mem i (Finset.mem_univ a)))).some
  let W₁ : Fin m → (D.obj j₁).Opens := fun a => D.map (f a) ⁻¹ᵁ U a
  have hW₁aff : ∀ a, IsAffineOpen (W₁ a) := fun a => (hUaff a).preimage (D.map (f a))
  have hW₁ : ∀ a, c.π.app j₁ ⁻¹ᵁ W₁ a = V a := by
    intro a
    show c.π.app j₁ ⁻¹ᵁ (D.map (f a) ⁻¹ᵁ U a) = V a
    rw [← Scheme.Hom.comp_preimage, c.w (f a), hUeq a]
  have hcov : c.π.app j₁ ⁻¹ᵁ ⊤ ≤ c.π.app j₁ ⁻¹ᵁ (⨆ a, W₁ a) := by
    rw [Scheme.Hom.preimage_iSup]
    have e : (⨆ a, c.π.app j₁ ⁻¹ᵁ W₁ a) = ⨆ a, V a := iSup_congr hW₁
    rw [e, hVcov]
    exact le_top
  have hcomp : IsCompact ((⊤ : (D.obj j₁).Opens) : Set (D.obj j₁)) := by
    rw [TopologicalSpace.Opens.coe_top]
    exact isCompact_univ
  obtain ⟨j, g, hg⟩ := exists_map_preimage_le_map_preimage D c hc (U := ⊤) (V := ⨆ a, W₁ a)
    hcomp hcov
  refine ⟨j, g ≫ f₀, fun a => D.map g ⁻¹ᵁ W₁ a, fun a => (hW₁aff a).preimage (D.map g), ?_, ?_⟩
  · rw [← Scheme.Hom.preimage_iSup]
    exact le_antisymm le_top ((Scheme.Hom.preimage_top _).symm.le.trans hg)
  · intro a
    show c.π.app j ⁻¹ᵁ (D.map g ⁻¹ᵁ W₁ a) = V a
    rw [← Scheme.Hom.comp_preimage, c.w g, hW₁ a]

theorem wcpa_dj_p1r_hvd_cocycle_stage : ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (D : I ⥤ Scheme.{u}) (c : Limits.Cone D), Limits.IsLimit c → (∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f)) → (∀ i, QuasiSeparatedSpace (D.obj i)) → ∀ (j₀ : I) {m : ℕ} (W : Fin m → (D.obj j₀).Opens), (∀ a, IsAffineOpen (W a)) → ∀ (V : Fin m → c.pt.Opens), (∀ a, c.π.app j₀ ⁻¹ᵁ W a = V a) → ∀ z : ∀ a b : Fin m, Γ(c.pt, V a ⊓ V b), (∀ a b d : Fin m, (c.pt.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right : V a ⊓ V b ⊓ V d ≤ V a ⊓ V d)).op).hom (z a d) = (c.pt.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right : V a ⊓ V b ⊓ V d ≤ V b ⊓ V d)).op).hom (z b d) + (c.pt.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ⊓ V d ≤ V a ⊓ V b)).op).hom (z a b)) → ∃ (j : I) (g : j ⟶ j₀) (W' : Fin m → (D.obj j).Opens) (t : ∀ a b : Fin m, Γ(D.obj j, W' a ⊓ W' b)), (∀ a, W' a = D.map g ⁻¹ᵁ W a) ∧ (∀ a b d : Fin m, ((D.obj j).presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right : W' a ⊓ W' b ⊓ W' d ≤ W' a ⊓ W' d)).op).hom (t a d) = ((D.obj j).presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right : W' a ⊓ W' b ⊓ W' d ≤ W' b ⊓ W' d)).op).hom (t b d) + ((D.obj j).presheaf.map (homOfLE (inf_le_left : W' a ⊓ W' b ⊓ W' d ≤ W' a ⊓ W' b)).op).hom (t a b)) ∧ ∀ (a b : Fin m) (hle : V a ⊓ V b ≤ c.π.app j ⁻¹ᵁ (W' a ⊓ W' b)), ((c.π.app j).appLE (W' a ⊓ W' b) (V a ⊓ V b) hle).hom (t a b) = z a b :=
by
  intro I _ _ D c hc haff hqs j₀ m W hW V hV z hz
  classical
  haveI : ∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f) := haff

  have appLE_congr : ∀ {X Y : Scheme.{u}} (f f' : X ⟶ Y) (hf : f = f') (U : Y.Opens)
      (O : X.Opens) (e : O ≤ f ⁻¹ᵁ U), f.appLE U O e = f'.appLE U O (hf ▸ e) := by
    intro X Y f f' hf U O e
    subst hf
    rfl
  have hres : ∀ (X : Scheme.{u}) {U V W' : X.Opens} (h1 : V ≤ U) (h2 : W' ≤ V) (x : Γ(X, U)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
      (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro X U V W' h1 h2 x
    change (X.presheaf.map (homOfLE h1).op ≫ X.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have hid : ∀ (X : Scheme.{u}) {U : X.Opens} (h : U ≤ U) (x : Γ(X, U)),
      (X.presheaf.map (homOfLE h).op).hom x = x := by
    intro X U h x
    rw [show homOfLE h = 𝟙 U from rfl, op_id, CategoryTheory.Functor.map_id]
    rfl
  have appLE_res : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (O O' : X.Opens)
      (e : O ≤ f ⁻¹ᵁ U) (e' : O' ≤ f ⁻¹ᵁ U) (hOO : O' ≤ O) (x : Γ(Y, U)),
      (X.presheaf.map (homOfLE hOO).op).hom ((f.appLE U O e).hom x) = (f.appLE U O' e').hom x := by
    intro X Y f U O O' e e' hOO x
    rw [← Scheme.Hom.appLE_map f e (homOfLE hOO).op]
    rfl
  have res_appLE : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U U' : Y.Opens) (O : X.Opens)
      (e : O ≤ f ⁻¹ᵁ U) (e' : O ≤ f ⁻¹ᵁ U') (hUU : U ≤ U') (x : Γ(Y, U')),
      (f.appLE U O e).hom ((Y.presheaf.map (homOfLE hUU).op).hom x) = (f.appLE U' O e').hom x := by
    intro X Y f U U' O e e' hUU x
    rw [← Scheme.Hom.map_appLE f e (homOfLE hUU).op]
    rfl
  have appLE_appLE : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (U : Z.Opens) (O : Y.Opens)
      (O' : X.Opens) (e1 : O ≤ g ⁻¹ᵁ U) (e2 : O' ≤ f ⁻¹ᵁ O) (e3 : O' ≤ (f ≫ g) ⁻¹ᵁ U)
      (x : Γ(Z, U)), (f.appLE O O' e2).hom ((g.appLE U O e1).hom x) = ((f ≫ g).appLE U O' e3).hom x := by
    intro X Y Z f g U O O' e1 e2 e3 x
    rw [← Scheme.Hom.appLE_comp_appLE f g U O O' e1 e2]
    rfl
  have cone_appLE : ∀ {j j' : I} (h : j' ⟶ j) (U : (D.obj j).Opens) (O : (D.obj j').Opens)
      (O' : c.pt.Opens) (e1 : O ≤ D.map h ⁻¹ᵁ U) (e2 : O' ≤ c.π.app j' ⁻¹ᵁ O)
      (e3 : O' ≤ c.π.app j ⁻¹ᵁ U) (x : Γ(D.obj j, U)),
      ((c.π.app j').appLE O O' e2).hom (((D.map h).appLE U O e1).hom x) =
        ((c.π.app j).appLE U O' e3).hom x := by
    intro j j' h U O O' e1 e2 e3 x
    rw [appLE_appLE (c.π.app j') (D.map h) U O O' e1 e2 (by rw [c.w h]; exact e3),
      appLE_congr _ _ (c.w h)]

  have L1 : ∀ (i : I) (κ : Type) [Finite κ] (P : κ → ∀ j : I, (j ⟶ i) → Prop),
      (∀ (k : κ) (j : I) (f : j ⟶ i) (j' : I) (h : j' ⟶ j), P k j f → P k j' (h ≫ f)) →
      (∀ k : κ, ∃ (j : I) (f : j ⟶ i), P k j f) → ∃ (j : I) (f : j ⟶ i), ∀ k : κ, P k j f := by
    intro i κ _ P hst hex
    haveI := Fintype.ofFinite κ
    have key : ∀ S : Finset κ, ∃ (j : I) (f : j ⟶ i), ∀ k ∈ S, P k j f := by
      intro S
      induction S using Finset.induction_on with
      | empty => exact ⟨i, 𝟙 i, fun k hk => absurd hk (Finset.notMem_empty k)⟩
      | insert a S _ ih =>
        obtain ⟨j₁, f₁, h₁⟩ := ih
        obtain ⟨j₂, f₂, h₂⟩ := hex a
        obtain ⟨l, g, g', hgg⟩ := IsCofiltered.cospan f₁ f₂
        refine ⟨l, g ≫ f₁, fun k' hk' => ?_⟩
        rcases Finset.mem_insert.mp hk' with rfl | hk'
        · rw [hgg]; exact hst _ _ _ _ g' h₂
        · exact hst _ _ _ _ g (h₁ k' hk')
    obtain ⟨j, f, h⟩ := key Finset.univ
    exact ⟨j, f, fun k => h k (Finset.mem_univ k)⟩

  have L2 : ∀ (i : I) (U : (D.obj i).Opens), IsCompact (U : Set (D.obj i)) →
      ∀ s : Γ(c.pt, c.π.app i ⁻¹ᵁ U), ∃ (j : I) (f : j ⟶ i) (t : Γ(D.obj j, D.map f ⁻¹ᵁ U)),
        ∀ hle : c.π.app i ⁻¹ᵁ U ≤ c.π.app j ⁻¹ᵁ (D.map f ⁻¹ᵁ U),
          ((c.π.app j).appLE (D.map f ⁻¹ᵁ U) (c.π.app i ⁻¹ᵁ U) hle).hom t = s := by
    intro i U hU s
    haveI hC : ∀ k : Over i, CompactSpace ((opensDiagram D i U).obj k) := fun k =>
      isCompact_iff_compactSpace.mp (Scheme.Hom.isCompact_preimage (D.map k.hom) hU)
    haveI hQ : ∀ k : Over i, QuasiSeparatedSpace ((opensDiagram D i U).obj k) := fun k => by
      haveI := hqs k.left
      exact (D.map k.hom ⁻¹ᵁ U).isOpen.isOpenEmbedding_subtypeVal.quasiSeparatedSpace
    obtain ⟨k, t', hs'⟩ := exists_appTop_π_eq_of_isLimit (opensDiagram D i U)
      (opensCone D c i U) (isLimitOpensCone D c hc i U) ((c.π.app i ⁻¹ᵁ U).topIso.inv s)
    refine ⟨k.left, k.hom, (D.map k.hom ⁻¹ᵁ U).topIso.hom t', fun hle => ?_⟩
    have sq : (D.map k.hom ⁻¹ᵁ U).topIso.hom ≫
        (c.π.app k.left).appLE (D.map k.hom ⁻¹ᵁ U) (c.π.app i ⁻¹ᵁ U) hle =
        ((c.π.app k.left).resLE (D.map k.hom ⁻¹ᵁ U) (c.π.app i ⁻¹ᵁ U) hle).appTop ≫
          (c.π.app i ⁻¹ᵁ U).topIso.hom :=
      (arrowResLEAppIso (c.π.app k.left) (D.map k.hom ⁻¹ᵁ U) (c.π.app i ⁻¹ᵁ U) hle).hom.w
    have hs'' : (c.π.app i ⁻¹ᵁ U).topIso.inv.hom s =
        ((c.π.app k.left).resLE (D.map k.hom ⁻¹ᵁ U) (c.π.app i ⁻¹ᵁ U) hle).appTop.hom t' := by
      rw [hs', opensCone_π_app]
      rfl
    have e1 : ((c.π.app k.left).appLE (D.map k.hom ⁻¹ᵁ U) (c.π.app i ⁻¹ᵁ U) hle).hom
        ((D.map k.hom ⁻¹ᵁ U).topIso.hom.hom t') =
        ((D.map k.hom ⁻¹ᵁ U).topIso.hom ≫
          (c.π.app k.left).appLE (D.map k.hom ⁻¹ᵁ U) (c.π.app i ⁻¹ᵁ U) hle).hom t' := rfl
    have e2 : (((c.π.app k.left).resLE (D.map k.hom ⁻¹ᵁ U) (c.π.app i ⁻¹ᵁ U) hle).appTop ≫
          (c.π.app i ⁻¹ᵁ U).topIso.hom).hom t' =
        (c.π.app i ⁻¹ᵁ U).topIso.hom.hom
          (((c.π.app k.left).resLE (D.map k.hom ⁻¹ᵁ U) (c.π.app i ⁻¹ᵁ U) hle).appTop.hom t') := rfl
    rw [e1, sq, e2, ← hs'']
    exact Iso.inv_hom_id_apply (c.π.app i ⁻¹ᵁ U).topIso s

  have L2' : ∀ (i : I) (U : (D.obj i).Opens), IsCompact (U : Set (D.obj i)) →
      ∀ (O : c.pt.Opens) (e1 : O ≤ c.π.app i ⁻¹ᵁ U) (e2 : c.π.app i ⁻¹ᵁ U ≤ O) (s : Γ(c.pt, O)),
        ∃ (j : I) (f : j ⟶ i) (t : Γ(D.obj j, D.map f ⁻¹ᵁ U)),
        ∀ hle : O ≤ c.π.app j ⁻¹ᵁ (D.map f ⁻¹ᵁ U),
          ((c.π.app j).appLE (D.map f ⁻¹ᵁ U) O hle).hom t = s := by
    intro i U hU O e1 e2 s
    obtain ⟨j, f, t, ht⟩ := L2 i U hU ((c.pt.presheaf.map (homOfLE e2).op).hom s)
    refine ⟨j, f, t, fun hle => ?_⟩
    rw [← appLE_res (c.π.app j) (D.map f ⁻¹ᵁ U) (c.π.app i ⁻¹ᵁ U) O (e2.trans hle) hle e1 t,
      ht (e2.trans hle)]
    exact (hres c.pt e2 e1 s).trans (hid c.pt _ s)

  have hVf : ∀ {j : I} (f : j ⟶ j₀) (a : Fin m), c.π.app j ⁻¹ᵁ (D.map f ⁻¹ᵁ W a) = V a := by
    intro j f a; rw [← Scheme.Hom.comp_preimage, c.w f, hV a]
  have hpairf : ∀ {j : I} (f : j ⟶ j₀) (a b : Fin m),
      V a ⊓ V b ≤ c.π.app j ⁻¹ᵁ (D.map f ⁻¹ᵁ W a ⊓ D.map f ⁻¹ᵁ W b) := by
    intro j f a b; rw [Scheme.Hom.preimage_inf, hVf, hVf]
  have hVab : ∀ a b, c.π.app j₀ ⁻¹ᵁ (W a ⊓ W b) = V a ⊓ V b := by
    intro a b; rw [Scheme.Hom.preimage_inf, hV, hV]
  have hWc : ∀ a b, IsCompact ((W a ⊓ W b : (D.obj j₀).Opens) : Set (D.obj j₀)) := by
    intro a b
    haveI := hqs j₀
    rw [TopologicalSpace.Opens.coe_inf]
    exact QuasiSeparatedSpace.inter_isCompact _ _ (W a).isOpen (hW a).isCompact (W b).isOpen
      (hW b).isCompact
  obtain ⟨j₁, g₁, hall⟩ := L1 j₀ (Fin m × Fin m)
    (fun k j f => ∃ t : Γ(D.obj j, D.map f ⁻¹ᵁ W k.1 ⊓ D.map f ⁻¹ᵁ W k.2),
      ∀ hle : V k.1 ⊓ V k.2 ≤ c.π.app j ⁻¹ᵁ (D.map f ⁻¹ᵁ W k.1 ⊓ D.map f ⁻¹ᵁ W k.2),
        ((c.π.app j).appLE (D.map f ⁻¹ᵁ W k.1 ⊓ D.map f ⁻¹ᵁ W k.2) (V k.1 ⊓ V k.2) hle).hom t =
          z k.1 k.2)
    (by
      rintro ⟨a, b⟩ j f j' h ⟨t, ht⟩
      have e : D.map (h ≫ f) ⁻¹ᵁ W a ⊓ D.map (h ≫ f) ⁻¹ᵁ W b ≤
          D.map h ⁻¹ᵁ (D.map f ⁻¹ᵁ W a ⊓ D.map f ⁻¹ᵁ W b) := by
        rw [Functor.map_comp]; exact le_rfl
      refine ⟨((D.map h).appLE _ _ e).hom t, fun hle => ?_⟩
      exact (cone_appLE h _ _ _ e hle (hpairf f a b) t).trans (ht _))
    (by
      rintro ⟨a, b⟩
      obtain ⟨j, f, t, ht⟩ := L2' j₀ (W a ⊓ W b) (hWc a b) (V a ⊓ V b) (hVab a b).ge
        (hVab a b).le (z a b)
      exact ⟨j, f, t, fun hle => ht hle⟩)
  have hall' : ∀ a b : Fin m, ∃ t : Γ(D.obj j₁, D.map g₁ ⁻¹ᵁ W a ⊓ D.map g₁ ⁻¹ᵁ W b),
      ∀ hle : V a ⊓ V b ≤ c.π.app j₁ ⁻¹ᵁ (D.map g₁ ⁻¹ᵁ W a ⊓ D.map g₁ ⁻¹ᵁ W b),
        ((c.π.app j₁).appLE (D.map g₁ ⁻¹ᵁ W a ⊓ D.map g₁ ⁻¹ᵁ W b) (V a ⊓ V b) hle).hom t =
          z a b := fun a b => hall (a, b)
  choose t₁ ht₁ using hall'

  have htriple : ∀ a b d, c.π.app j₁ ⁻¹ᵁ (D.map g₁ ⁻¹ᵁ W a ⊓ D.map g₁ ⁻¹ᵁ W b ⊓
      D.map g₁ ⁻¹ᵁ W d) = V a ⊓ V b ⊓ V d := by
    intro a b d; rw [Scheme.Hom.preimage_inf, Scheme.Hom.preimage_inf, hVf, hVf, hVf]
  have hU3c : ∀ a b d, IsCompact ((D.map g₁ ⁻¹ᵁ W a ⊓ D.map g₁ ⁻¹ᵁ W b ⊓ D.map g₁ ⁻¹ᵁ W d :
      (D.obj j₁).Opens) : Set (D.obj j₁)) := by
    intro a b d
    haveI := hqs j₁
    have hW1 : ∀ x, IsCompact ((D.map g₁ ⁻¹ᵁ W x : (D.obj j₁).Opens) : Set (D.obj j₁)) :=
      fun x => ((hW x).preimage (D.map g₁)).isCompact
    rw [TopologicalSpace.Opens.coe_inf, TopologicalSpace.Opens.coe_inf]
    exact QuasiSeparatedSpace.inter_isCompact _ _
      ((D.map g₁ ⁻¹ᵁ W a).isOpen.inter (D.map g₁ ⁻¹ᵁ W b).isOpen)
      (QuasiSeparatedSpace.inter_isCompact _ _ (D.map g₁ ⁻¹ᵁ W a).isOpen (hW1 a)
        (D.map g₁ ⁻¹ᵁ W b).isOpen (hW1 b))
      (D.map g₁ ⁻¹ᵁ W d).isOpen (hW1 d)
  obtain ⟨δ, hδ⟩ : ∃ δ : ∀ a b d : Fin m,
      Γ(D.obj j₁, D.map g₁ ⁻¹ᵁ W a ⊓ D.map g₁ ⁻¹ᵁ W b ⊓ D.map g₁ ⁻¹ᵁ W d),
      ∀ a b d, δ a b d =
        ((D.obj j₁).presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
          D.map g₁ ⁻¹ᵁ W a ⊓ D.map g₁ ⁻¹ᵁ W b ⊓ D.map g₁ ⁻¹ᵁ W d ≤
            D.map g₁ ⁻¹ᵁ W a ⊓ D.map g₁ ⁻¹ᵁ W d)).op).hom (t₁ a d) -
        ((D.obj j₁).presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
          D.map g₁ ⁻¹ᵁ W a ⊓ D.map g₁ ⁻¹ᵁ W b ⊓ D.map g₁ ⁻¹ᵁ W d ≤
            D.map g₁ ⁻¹ᵁ W b ⊓ D.map g₁ ⁻¹ᵁ W d)).op).hom (t₁ b d) -
        ((D.obj j₁).presheaf.map (homOfLE (inf_le_left :
          D.map g₁ ⁻¹ᵁ W a ⊓ D.map g₁ ⁻¹ᵁ W b ⊓ D.map g₁ ⁻¹ᵁ W d ≤
            D.map g₁ ⁻¹ᵁ W a ⊓ D.map g₁ ⁻¹ᵁ W b)).op).hom (t₁ a b) :=
    ⟨_, fun _ _ _ => rfl⟩
  have key1 : ∀ (U : (D.obj j₁).Opens) (O : c.pt.Opens) (e : O ≤ c.π.app j₁ ⁻¹ᵁ U) (x y : Fin m)
