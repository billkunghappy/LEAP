    have := congrArg (fun t => t.hom a) hfac
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    rw [← this]
    exact (IsLocalRing.ResidueField.lift_residue_apply φ.hom a).symm

  have L4 : ∀ {A B K : Type u} [CommRing A] [CommRing B] [Field K] (φ : A →+* B) [IsLocalHom φ]
      (g : B →+* K), Function.Injective g → ∀ V : ValuationSubring K,
      (V : Set K) = Set.range (g.comp φ) → Set.range g = (V : Set K) := by
    intro A B K _ _ _ φ _ g hg V hV
    apply Set.Subset.antisymm
    · rintro _ ⟨s, rfl⟩
