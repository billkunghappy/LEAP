      obtain ⟨-, hD1, -⟩ := hdom V hV
      obtain ⟨a, s, hs0, hfs⟩ := hfrac f
      rcases htot s a with ⟨c, hc⟩ | ⟨c, hc⟩
      · refine ⟨c, ?_⟩
        rw [hc, map_mul] at hfs
        exact mul_left_cancel₀ hs0 (by rw [← hfs, mul_comm])
      · rw [hc, map_mul] at hs0 hfs
        have ha0 : ψ a ≠ 0 := left_ne_zero_of_mul hs0
