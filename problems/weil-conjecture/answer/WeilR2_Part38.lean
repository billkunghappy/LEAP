theorem wcpa_dj_p1r_hvd_bc_model : ∀ (R B A : Type u) [CommRing R] [CommRing B] [CommRing A] (ψ : R →+* B) (φ : B →+* A) (Y X : Scheme.{u}) (v : Y ⟶ Spec (.of A)) (hX : X ⟶ Spec (.of R)) (ρ : Y ⟶ X), IsProper hX → Flat hX → IsPullback ρ v hX (Spec.map (CommRingCat.ofHom (φ.comp ψ))) → ∀ {m : ℕ} (W : Fin m → X.Opens) (t : ∀ a b : Fin m, Γ(X, W a ⊓ W b)), (∀ a, IsAffineOpen (W a)) → (⨆ a, W a) = ⊤ → (∀ a b d : Fin m, (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right : W a ⊓ W b ⊓ W d ≤ W a ⊓ W d)).op).hom (t a d) = (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right : W a ⊓ W b ⊓ W d ≤ W b ⊓ W d)).op).hom (t b d) + (X.presheaf.map (homOfLE (inf_le_left : W a ⊓ W b ⊓ W d ≤ W a ⊓ W b)).op).hom (t a b)) → ∀ (V : Fin m → Y.Opens), (∀ a, ρ ⁻¹ᵁ W a = V a) → ∀ z : ∀ a b : Fin m, Γ(Y, V a ⊓ V b), (∀ (a b : Fin m) (hle : V a ⊓ V b ≤ ρ ⁻¹ᵁ (W a ⊓ W b)), (ρ.appLE (W a ⊓ W b) (V a ⊓ V b) hle).hom (t a b) = z a b) → ∃ (Y' : Scheme.{u}) (h : Y' ⟶ Spec (.of B)) (π : Y ⟶ Y') (V' : Fin m → Y'.Opens) (z' : ∀ a b : Fin m, Γ(Y', V' a ⊓ V' b)), IsProper h ∧ Flat h ∧ IsPullback π v h (Spec.map (CommRingCat.ofHom φ)) ∧ (∀ a, IsAffineOpen (V' a)) ∧ (⨆ a, V' a) = ⊤ ∧ (∀ a, π ⁻¹ᵁ V' a = V a) ∧ (∀ a b d : Fin m, (Y'.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right : V' a ⊓ V' b ⊓ V' d ≤ V' a ⊓ V' d)).op).hom (z' a d) = (Y'.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right : V' a ⊓ V' b ⊓ V' d ≤ V' b ⊓ V' d)).op).hom (z' b d) + (Y'.presheaf.map (homOfLE (inf_le_left : V' a ⊓ V' b ⊓ V' d ≤ V' a ⊓ V' b)).op).hom (z' a b)) ∧ ∀ (a b : Fin m) (hle : V a ⊓ V b ≤ π ⁻¹ᵁ (V' a ⊓ V' b)), (π.appLE (V' a ⊓ V' b) (V a ⊓ V b) hle).hom (z' a b) = z a b :=
