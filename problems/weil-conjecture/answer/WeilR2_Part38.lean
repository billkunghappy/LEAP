      have h1 : PowerSeries.coeff 1 (θ₁ y) = c₁ := by linear_combination e1
      rw [h0, h1]
      exact hc
    have ha : PowerSeries.coeff 1 (θ₀ g₀) ≠ 0 := by
      intro h
      exact h00 ((hX2 _).mpr ⟨(hθm g₀ (hS hg₀S)).1, h⟩)
    have hd : PowerSeries.coeff 1 (θ₁ g₁) ≠ 0 := by
      intro h
      exact h11 ((hX2 _).mpr ⟨(hθm g₁ (hS hg₁S)).2, h⟩)
    have hle : IsLocalRing.maximalIdeal (C.presheaf.stalk x) ≤
        Ideal.span S ⊔ IsLocalRing.maximalIdeal (C.presheaf.stalk x) •
          IsLocalRing.maximalIdeal (C.presheaf.stalk x) := by
      intro y hy
      obtain ⟨w, hw⟩ : ∃ w, w = y -
          ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ x trivial).hom
            (PowerSeries.coeff 1 (θ₀ y) / PowerSeries.coeff 1 (θ₀ g₀)) * g₀ -
