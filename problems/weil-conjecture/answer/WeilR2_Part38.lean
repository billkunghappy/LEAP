      have e : ψ' g = ⟨wcpaDjPsSp x ξ g, h1⟩ := Subtype.ext (hsp ξ hξx g).symm
      rw [← e]
      exact h2

    have hgen : IsLocalRing.maximalIdeal (C.presheaf.stalk x) ≤ Ideal.span {g} := by
      intro m hm
      rcases hdvd g m with ⟨c, rfl⟩ | ⟨a, ha⟩
      · exact Ideal.mul_mem_right c _ (Ideal.mem_span_singleton_self g)
      · by_cases haM : a ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x)
        · exfalso
          apply hfw
          rw [ha, pow_two]
          exact Ideal.mul_mem_mul hm haM
        · have hau : IsUnit a := by
            rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at haM
            exact haM
