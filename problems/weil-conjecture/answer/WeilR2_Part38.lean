      wcpa_dj_cgs_lm_local_surj Y m g e he O A ψ hAff hGen w q a (Ψ a (y a))
    choose X hXC hXE using hX
    refine ⟨fun s => if h : s.card = q + 1 then X (s.orderEmbOfFin h) else 0,
      fun s => ⟨fun h => ?_, fun h => ?_⟩, ?_⟩
    · dsimp only
      rw [dif_pos h]
      have := hXC (s.orderEmbOfFin h)
      rwa [hrange q s h] at this
    · dsimp only
      rw [dif_neg h]
    · funext a
      have h' := hcard q a
      change (Ψ a).symm (E a ((if h : (Finset.univ.map a.toEmbedding).card = q + 1 then
        X ((Finset.univ.map a.toEmbedding).orderEmbOfFin h) else 0) 0)) = y a
      rw [dif_pos h', horder q a h', hXE a, AddEquiv.symm_apply_apply]
