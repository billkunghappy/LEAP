  have hsm₀ : SmoothOfRelativeDimension 1 ((⊤ : (Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).Opens).ι ≫ Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) := by
    rw [← hθκ]
    exact @AlgebraicGeometry.smoothOfRelativeDimension_comp 0 1 _ _ ((⊤ : (Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).Opens).ι ≫ θκ.hom) _ (wcP1Over (IsLocalRing.ResidueField ↥W)).hom inferInstance (wc_p1_smooth_reldim_one (IsLocalRing.ResidueField ↥W))
  obtain ⟨W', hW'mem, hW'sm⟩ := wcpa_dj_bsc_smooth_descend (Spec (.of ↥W)) Y v
    (IsLocalRing.ResidueField ↥W) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
    (x₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)))
    hflat hlfp ⟨⊤, trivial, hsm₀⟩
  obtain ⟨σ, hσ, -⟩ := wcpa_dj_lus_sm_hensel_section Ω W Y v W' hW'sm
