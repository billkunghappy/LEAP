theorem wcpa_dj_lr1u_tc_cls_unique : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) [AlgebraicGeometry.IsIntegral (wcProjK Ω 1)] (h : (wcProjK Ω 1).functionField) (d : ↥(wcProjK Ω 1)) (l l' : Option (IsLocalRing.ResidueField ↥W)), h ≠ 0 → wcLr1uVtdCls W (wcProjKStr Ω 1) h d l → wcLr1uVtdCls W (wcProjKStr Ω 1) h d l' → l = l' :=
