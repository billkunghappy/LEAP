theorem wcpa_dj_p1r_closed_fibre_iso : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥W)) (sY : Spec (.of ↥W) ⟶ Y), (∃ θκ : Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W)) MvPolynomial.gradedAlgebra, θκ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W)) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField ↥W) ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W) 0))) = Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) → ∀ (f : Y ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) ↥W) MvPolynomial.gradedAlgebra) (z : Spec (.of ↥W) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) ↥W) MvPolynomial.gradedAlgebra), f ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin 2) ↥W 0))) = v → z ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin 2) ↥W 0))) = 𝟙 _ → IsPullback sY (𝟙 _) f z → ∀ fκ : Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ⟶ Limits.pullback (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin 2) ↥W 0)))) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))), fκ ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ ≫ f → fκ ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ → IsIso fκ :=
by
  classical

  have s1 : ∀ {Y P S S' : Scheme.{u}} (v : Y ⟶ S) (π : P ⟶ S) (b : S' ⟶ S) (f : Y ⟶ P)
