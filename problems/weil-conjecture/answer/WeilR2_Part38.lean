  have hle : 𝒟.card ≤ {x | ∃ D ∈ 𝒟, ∃ D' ∈ 𝒟, D ≠ D' ∧ x ∈ D ∧ x ∈ D'}.ncard := by omega
  have hcpos : 0 < 𝒟.card := Finset.card_pos.mpr h𝒟ne
  have hIfin : {x | ∃ D ∈ 𝒟, ∃ D' ∈ 𝒟, D ≠ D' ∧ x ∈ D ∧ x ∈ D'}.Finite := by
    by_contra hinf
    rw [Set.Infinite.ncard hinf] at hle
    omega
  have hcompfin : ∀ x : ↥(Limits.pullback v c),
      {D | D ∈ irreducibleComponents ↥(Limits.pullback v c) ∧ x ∈ D}.Finite :=
    fun x => hfin0.subset (fun D hD => hD.1)
  have hm2 : ∀ x : ↥(Limits.pullback v c), {D | D ∈ 𝒟 ∧ x ∈ D}.ncard ≤ 2 := fun x =>
    (Set.ncard_le_ncard (fun D (hD : D ∈ {D | D ∈ 𝒟 ∧ x ∈ D}) =>
      (⟨(h𝒟 D hD.1).1, hD.2⟩ : D ∈ {D | D ∈ irreducibleComponents ↥(Limits.pullback v c) ∧ x ∈ D}))
      (hcompfin x)).trans (hmult x).1

  obtain ⟨n, C, x, hCinj, hxinj, hCmem, hxC⟩ :=
    wcpa_dj_lus_cvs_ct_fc_cycle_extract 𝒟 h𝒟ne hIfin hm2 hle
  have hcomp : ∀ i, C i ∈ irreducibleComponents ↥(Limits.pullback v c) := fun i => (h𝒟 (C i) (hCmem i)).1

  have boundary : ∀ D ∈ irreducibleComponents ↥(Limits.pullback v c),
      ∀ D' ∈ irreducibleComponents ↥(Limits.pullback v c), D ≠ D' →
      ∀ x ∈ D, x ∈ D' → x ∈ closure Dᶜ := by
    intro D hD D' hD' hne x _ hxD'
    by_contra hx
    have hO : IsOpen (closure Dᶜ)ᶜ := isClosed_closure.isOpen_compl
    have hOD : (closure Dᶜ)ᶜ ⊆ D := by
      intro w hw
      by_contra hwD
      exact hw (subset_closure hwD)
    have hD'D : ¬ D' ⊆ D := by
      intro hsub
      exact hne (Set.Subset.antisymm (hD'.2 hD.1 hsub) hsub)
    obtain ⟨w, hwD', hwD⟩ := Set.inter_compl_nonempty_iff.mpr hD'D
    have hDc : IsOpen Dᶜ := (isClosed_of_mem_irreducibleComponents D hD).isOpen_compl
    obtain ⟨t, _, htO, htD⟩ :=
      hD'.1.isPreirreducible _ _ hO hDc ⟨x, hxD', hx⟩ ⟨w, hwD', hwD⟩
    exact htD (hOD htO)

  set L : Fin (n + 2) := Fin.last (n + 1) with hL
  have hrot : finRotate (n + 2) L = 0 := finRotate_last
  have hL0 : L ≠ 0 := Fin.last_pos.ne'
  have hCL0 : C L ≠ C 0 := fun h => hL0 (hCinj h)
  have hxL : x L ∈ C L ∧ x L ∈ C 0 := by
    have h1 := hxC L
    rw [hrot] at h1
    exact h1
  have hxLcl : IsClosed ({x L} : Set ↥(Limits.pullback v c)) :=
    (hnodes (C L) (hcomp L)).2 (x L) ⟨hxL.1, boundary _ (hcomp L) _ (hcomp 0) hCL0 _ hxL.1 hxL.2⟩
  set Oth := {D' | D' ∈ irreducibleComponents ↥(Limits.pullback v c) ∧ D' ≠ C L ∧ D' ≠ C 0}
    with hOth
  set N : Set ↥(Limits.pullback v c) := (⋃ D' ∈ Oth, D')ᶜ ∩ ((C L ∩ C 0) \ {x L})ᶜ with hN
  have hOthcl : IsClosed (⋃ D' ∈ Oth, D') :=
    (hfin0.subset (fun D hD => hD.1)).isClosed_biUnion
      (fun D hD => isClosed_of_mem_irreducibleComponents D hD.1)
  have hSsub : (C L ∩ C 0) \ {x L} ⊆ C L ∩ closure (C L)ᶜ := fun y hy =>
    ⟨hy.1.1, boundary _ (hcomp L) _ (hcomp 0) hCL0 y hy.1.1 hy.1.2⟩
  have hScl : IsClosed ((C L ∩ C 0) \ {x L}) := by
    have h1 := (((hnodes (C L) (hcomp L)).1).subset hSsub).isClosed_biUnion
      (f := fun y => ({y} : Set ↥(Limits.pullback v c)))
      (fun y hy => (hnodes (C L) (hcomp L)).2 y (hSsub hy))
    rwa [Set.biUnion_of_singleton] at h1
  have hNo : IsOpen N := hOthcl.isOpen_compl.inter hScl.isOpen_compl
  have hxLN : x L ∈ N := by
    refine ⟨?_, fun h => h.2 rfl⟩
    intro hU
    obtain ⟨D', hD', hxD'⟩ := Set.mem_iUnion₂.mp hU
    have h3 : ({C L, C 0, D'} : Set (Set ↥(Limits.pullback v c))).ncard = 3 :=
      Set.ncard_eq_three.mpr ⟨C L, C 0, D', hCL0, fun h => hD'.2.1 h.symm,
        fun h => hD'.2.2 h.symm, rfl⟩
    have hsub : ({C L, C 0, D'} : Set (Set ↥(Limits.pullback v c))) ⊆
        {D | D ∈ irreducibleComponents ↥(Limits.pullback v c) ∧ x L ∈ D} := by
      intro D hD
      rcases hD with h | h | h
      · rw [h]; exact ⟨hcomp L, hxL.1⟩
      · rw [h]; exact ⟨hcomp 0, hxL.2⟩
      · rw [Set.mem_singleton_iff] at h
        rw [h]; exact ⟨hD'.1, hxD'⟩
    have h4 := Set.ncard_le_ncard hsub (hcompfin (x L))
    have h5 := (hmult (x L)).1
    omega
  have hNsub : N ⊆ C L ∪ C 0 := by
    intro y hy
    obtain ⟨D'', hD'', hyD''⟩ :=
      exists_mem_irreducibleComponents_subset_of_isIrreducible {y} isIrreducible_singleton
    by_cases h1 : D'' = C L
    · left; rw [← h1]; exact hyD'' (Set.mem_singleton y)
    by_cases h2 : D'' = C 0
    · right; rw [← h2]; exact hyD'' (Set.mem_singleton y)
    exact absurd (Set.mem_iUnion₂.mpr ⟨D'', ⟨hD'', h1, h2⟩, hyD'' (Set.mem_singleton y)⟩) hy.1
  have hNint : N ∩ C L ∩ C 0 ⊆ {x L} := by
    rintro y ⟨⟨hyN, hyL⟩, hy0⟩
    by_contra hyx
    exact hyN.2 ⟨⟨hyL, hy0⟩, hyx⟩
  haveI : CompactSpace ↥(Limits.pullback v c) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd v c)
  haveI : QuasiSeparatedSpace ↥(Limits.pullback v c) :=
    quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.snd v c)
  obtain ⟨P₀, p₀, hp₀fin, hp₀et, hp₀surj, hno⟩ :=
    wcpa_dj_lus_cvs_ct_fc_twisted_cover (Limits.pullback v c) n C x N
