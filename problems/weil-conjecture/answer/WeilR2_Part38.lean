            _ = (j s₀) ^ l * (j s₀) ^ d * j ta := hfab
            _ = (j s₀) ^ l * ((j s₀) ^ d * j ta) := by ring
        left
        refine ⟨s₀ ^ d * ta * ↑htb.unit⁻¹, ?_⟩
        rw [map_mul, map_mul, map_pow, ← e1]
        calc f * j tb * j (↑htb.unit⁻¹) = f * (j tb * j (↑htb.unit⁻¹)) := by ring
          _ = f := by rw [hB, mul_one]
      · obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le hkl.le
        rw [hd, pow_add] at hfab hSl
        have hSk : (j s₀) ^ k ≠ 0 := left_ne_zero_of_mul hSl
        have e1 : f * ((j s₀) ^ d * j tb) = j ta := by
          apply mul_left_cancel₀ hSk
          calc (j s₀) ^ k * (f * ((j s₀) ^ d * j tb)) = f * ((j s₀) ^ k * (j s₀) ^ d * j tb) := by
                ring
            _ = (j s₀) ^ k * j ta := hfab
        right
        refine ⟨s₀ ^ d * tb * ↑hta.unit⁻¹, ?_⟩
        rw [map_mul, map_mul, map_pow]
        have e2 : f⁻¹ * j ta = (j s₀) ^ d * j tb := by
          rw [← e1, ← mul_assoc, inv_mul_cancel₀ hf, one_mul]
        calc (j s₀) ^ d * j tb * j (↑hta.unit⁻¹) = f⁻¹ * (j ta * j (↑hta.unit⁻¹)) := by
              rw [← e2]; ring
          _ = f⁻¹ := by rw [hA, mul_one]
    refine ⟨?_, ⟨{ toSubring := j.range, mem_or_inv_mem' := hdich }, ?_⟩, hE⟩
    · show Function.Injective (algebraMap (X.presheaf.stalk p) X.functionField)
      exact IsFractionRing.injective _ _
    · ext f
      exact RingHom.mem_range
  exact key (wcProjK Ω 1) (wcProjKStr Ω 1) c1 c2 c3 g hmob P hP u hval

