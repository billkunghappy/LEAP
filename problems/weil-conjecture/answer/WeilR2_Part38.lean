    · rintro ⟨e', rfl⟩
      show h ((ι ≫ Φ.inv) e') ∈ E
      rw [hh, Scheme.Hom.comp_apply, Scheme.inv_hom_apply, ← hιE]
      exact Set.mem_range_self e'
    · intro hx
      have hx' : Φ.hom x ∈ Set.range ι := by
