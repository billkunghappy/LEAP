    rw [hvv _ (hcard q a)]
  ·
    intro q c v
    funext a
    change (Ψ a).symm (E a (c • v (Finset.univ.map a.toEmbedding) 0)) =
      (Y.presheaf.map (homOfLE (inf_le_right : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k)
        O a ≤ O)).op).hom (ψ c) • (Ψ a).symm (E a (v (Finset.univ.map a.toEmbedding) 0))
    rw [hEs, hΦsmul]
  ·
    intro q y
    have hX : ∀ a : Fin (q + 1) ↪o Fin (m + 1), ∃ x : Fin 1 → (Fin (m + 1) → ℤ) →₀ A,
