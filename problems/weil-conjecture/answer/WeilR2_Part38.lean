  have s4 : ∀ (Q : Scheme.{u}) (ℓ : Q ⟶ Y) (U V : Y.Opens) (hU : ⊤ ≤ ℓ ⁻¹ᵁ U)
      (hV : ⊤ ≤ ℓ ⁻¹ᵁ V) (tU sU : Γ(Y, U)) (tV sV : Γ(Y, V)),
      (Y.presheaf.map (homOfLE (inf_le_right : U ⊓ V ≤ V)).op).hom tV *
          (Y.presheaf.map (homOfLE (inf_le_left : U ⊓ V ≤ U)).op).hom sU =
        (Y.presheaf.map (homOfLE (inf_le_left : U ⊓ V ≤ U)).op).hom tU *
          (Y.presheaf.map (homOfLE (inf_le_right : U ⊓ V ≤ V)).op).hom sV →
      (ℓ.appLE V ⊤ hV).hom tV * (ℓ.appLE U ⊤ hU).hom sU =
        (ℓ.appLE U ⊤ hU).hom tU * (ℓ.appLE V ⊤ hV).hom sV := by
    intro Q ℓ U V hU hV tU sU tV sV h
    have hUV : ⊤ ≤ ℓ ⁻¹ᵁ (U ⊓ V) := by
      rw [Scheme.Hom.preimage_inf]; exact le_inf hU hV
    have eU : ∀ x : Γ(Y, U), (ℓ.appLE U ⊤ hU).hom x = (ℓ.appLE (U ⊓ V) ⊤ hUV).hom
        ((Y.presheaf.map (homOfLE (inf_le_left : U ⊓ V ≤ U)).op).hom x) := by
      intro x
      rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, Scheme.Hom.map_appLE]
    have eV : ∀ x : Γ(Y, V), (ℓ.appLE V ⊤ hV).hom x = (ℓ.appLE (U ⊓ V) ⊤ hUV).hom
        ((Y.presheaf.map (homOfLE (inf_le_right : U ⊓ V ≤ V)).op).hom x) := by
      intro x
      rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, Scheme.Hom.map_appLE]
    rw [eU, eU, eV, eV, ← map_mul, ← map_mul, h]

  have s5 : ∀ (Z : Scheme.{u}) (ψ : Spec (.of (Polynomial A)) ⟶ Z) (Q : Scheme.{u})
      (κ : A →+* Γ(Q, ⊤)) (n₁ d₁ n₂ d₂ : Γ(Q, ⊤)) (h₁ h₂ : Q ⟶ Z), IsUnit d₁ →
      n₂ * d₁ = n₁ * d₂ →
      (∀ e : Γ(Q, ⊤), e * d₁ = n₁ → h₁ = Q.toSpecΓ ≫
        Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom κ e)) ≫ ψ) →
      (∀ e : Γ(Q, ⊤), e * d₂ = n₂ → h₂ = Q.toSpecΓ ≫
        Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom κ e)) ≫ ψ) → h₁ = h₂ := by
    intro Z ψ Q κ n₁ d₁ n₂ d₂ h₁ h₂ hu hx H1 H2
    obtain ⟨u, rfl⟩ := hu
    have e1 : n₁ * ↑u⁻¹ * ↑u = n₁ := by rw [mul_assoc, Units.inv_mul, mul_one]
    have e2 : n₁ * ↑u⁻¹ * d₂ = n₂ := by
      calc n₁ * ↑u⁻¹ * d₂ = (n₁ * d₂) * ↑u⁻¹ := by ring
        _ = (n₂ * ↑u) * ↑u⁻¹ := by rw [hx]
        _ = n₂ := by rw [mul_assoc, Units.mul_inv, mul_one]
    rw [H1 _ e1, H2 _ e2]

  have s6 : ∀ (Q : Scheme.{u}) (κ : A →+* Γ(Q, ⊤)) (n₁ d₁ n₂ d₂ : Γ(Q, ⊤))
      (h₁ h₂ : Q ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A)
        MvPolynomial.gradedAlgebra), IsUnit d₁ → IsUnit d₂ → n₁ * n₂ = d₁ * d₂ →
      (∀ e : Γ(Q, ⊤), e * d₁ = n₁ → h₁ = Q.toSpecΓ ≫
        Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom κ e)) ≫ c) →
      (∀ e : Γ(Q, ⊤), e * d₂ = n₂ → h₂ = Q.toSpecΓ ≫
        Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom κ e)) ≫ j) → h₁ = h₂ := by
    intro Q κ n₁ d₁ n₂ d₂ h₁ h₂ hu hw hx H1 H2
    obtain ⟨u, rfl⟩ := hu
    obtain ⟨w, rfl⟩ := hw
    have e1 : n₁ * ↑u⁻¹ * ↑u = n₁ := by rw [mul_assoc, Units.inv_mul, mul_one]
    have e2 : n₂ * ↑w⁻¹ * ↑w = n₂ := by rw [mul_assoc, Units.inv_mul, mul_one]
    have e3 : (n₁ * ↑u⁻¹) * (n₂ * ↑w⁻¹) = 1 := by
      calc (n₁ * ↑u⁻¹) * (n₂ * ↑w⁻¹) = (n₁ * n₂) * (↑u⁻¹ * ↑w⁻¹) := by ring
        _ = (↑u * ↑w) * (↑u⁻¹ * ↑w⁻¹) := by rw [hx]
        _ = (↑u * ↑u⁻¹) * (↑w * ↑w⁻¹) := by ring
        _ = 1 := by rw [Units.mul_inv, Units.mul_inv, mul_one]
    rw [H1 _ e1, H2 _ e2]
    exact hjc Q κ _ _ e3

  have s7 : ∀ (ψ : Spec (.of (Polynomial A)) ⟶ @Proj _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra),
      ψ ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A)
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0))) =
        Spec.map (CommRingCat.ofHom (Polynomial.C : A →+* Polynomial A)) →
      ∀ (T : Scheme.{u}) (g : T ⟶ Spec (.of A)) (e : Γ(T, ⊤)),
      (T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom
        ((Scheme.ΓSpecIso (.of A)).inv ≫ g.appTop).hom e)) ≫ ψ) ≫
        @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0))) = g := by
    intro ψ hψ T g e
    simp only [Category.assoc]
    rw [hψ, ← Spec.map_comp, ← CommRingCat.ofHom_comp, Polynomial.eval₂RingHom_comp_C,
      CommRingCat.ofHom_hom, Spec.map_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality,
      Category.assoc, toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]

  let O : Fin m ⊕ Fin m → Y.Opens :=
    Sum.elim (fun i => Y.basicOpen (s i)) (fun i => Y.basicOpen (t i))
  let G : ∀ a, (O a).toScheme ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A)
      MvPolynomial.gradedAlgebra :=
    fun a => Sum.rec (motive := fun a => (O a).toScheme ⟶ @Proj _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra) gs gt a
  have hO : (⨆ a, O a) = ⊤ := by
    rw [iSup_sum]
    show (⨆ i, Y.basicOpen (s i)) ⊔ (⨆ i, Y.basicOpen (t i)) = ⊤
    rw [sup_comm, ← iSup_sup_eq]
    simp only [hcov]
    exact hW
  have hG : ∀ a b, Y.homOfLE (inf_le_left : O a ⊓ O b ≤ O a) ≫ G a =
      Y.homOfLE (inf_le_right : O a ⊓ O b ≤ O b) ≫ G b := by
    intro a b
    rcases a with i | i <;> rcases b with k | k
    · have hVi := hle (O (Sum.inl i) ⊓ O (Sum.inl k)) (W i)
        (inf_le_left.trans (Y.basicOpen_le (s i)))
      have hVk := hle (O (Sum.inl i) ⊓ O (Sum.inl k)) (W k)
        (inf_le_right.trans (Y.basicOpen_le (s k)))
      have X := s4 _ (O (Sum.inl i) ⊓ O (Sum.inl k)).ι (W i) (W k) hVi hVk (t i) (s i) (t k)
        (s k) (hcross i k)
      have A1 := s3 _ c (W i) (t i) (s i) (gs i) (hgs i) _ (O (Sum.inl i) ⊓ O (Sum.inl k)).ι
        (Y.homOfLE (inf_le_left : O (Sum.inl i) ⊓ O (Sum.inl k) ≤ O (Sum.inl i)))
        (Y.homOfLE_ι _) hVi
      have B1 := s3 _ c (W k) (t k) (s k) (gs k) (hgs k) _ (O (Sum.inl i) ⊓ O (Sum.inl k)).ι
        (Y.homOfLE (inf_le_right : O (Sum.inl i) ⊓ O (Sum.inl k) ≤ O (Sum.inl k)))
        (Y.homOfLE_ι _) hVk
      exact s5 _ c _ _ _ _ _ _ _ _ A1.1 X A1.2 B1.2
    · have hVi := hle (O (Sum.inl i) ⊓ O (Sum.inr k)) (W i)
        (inf_le_left.trans (Y.basicOpen_le (s i)))
      have hVk := hle (O (Sum.inl i) ⊓ O (Sum.inr k)) (W k)
        (inf_le_right.trans (Y.basicOpen_le (t k)))
      have X := s4 _ (O (Sum.inl i) ⊓ O (Sum.inr k)).ι (W i) (W k) hVi hVk (t i) (s i) (t k)
        (s k) (hcross i k)
      have A1 := s3 _ c (W i) (t i) (s i) (gs i) (hgs i) _ (O (Sum.inl i) ⊓ O (Sum.inr k)).ι
        (Y.homOfLE (inf_le_left : O (Sum.inl i) ⊓ O (Sum.inr k) ≤ O (Sum.inl i)))
        (Y.homOfLE_ι _) hVi
      have B1 := s3 _ j (W k) (s k) (t k) (gt k) (hgt k) _ (O (Sum.inl i) ⊓ O (Sum.inr k)).ι
        (Y.homOfLE (inf_le_right : O (Sum.inl i) ⊓ O (Sum.inr k) ≤ O (Sum.inr k)))
        (Y.homOfLE_ι _) hVk
      exact s6 _ _ _ _ _ _ _ _ A1.1 B1.1 (by linear_combination -X) A1.2 B1.2
    · have hVi := hle (O (Sum.inr i) ⊓ O (Sum.inl k)) (W i)
        (inf_le_left.trans (Y.basicOpen_le (t i)))
      have hVk := hle (O (Sum.inr i) ⊓ O (Sum.inl k)) (W k)
        (inf_le_right.trans (Y.basicOpen_le (s k)))
      have X := s4 _ (O (Sum.inr i) ⊓ O (Sum.inl k)).ι (W i) (W k) hVi hVk (t i) (s i) (t k)
        (s k) (hcross i k)
      have A1 := s3 _ j (W i) (s i) (t i) (gt i) (hgt i) _ (O (Sum.inr i) ⊓ O (Sum.inl k)).ι
        (Y.homOfLE (inf_le_left : O (Sum.inr i) ⊓ O (Sum.inl k) ≤ O (Sum.inr i)))
        (Y.homOfLE_ι _) hVi
      have B1 := s3 _ c (W k) (t k) (s k) (gs k) (hgs k) _ (O (Sum.inr i) ⊓ O (Sum.inl k)).ι
        (Y.homOfLE (inf_le_right : O (Sum.inr i) ⊓ O (Sum.inl k) ≤ O (Sum.inl k)))
        (Y.homOfLE_ι _) hVk
      exact (s6 _ _ _ _ _ _ _ _ B1.1 A1.1 (by linear_combination X) B1.2 A1.2).symm
    · have hVi := hle (O (Sum.inr i) ⊓ O (Sum.inr k)) (W i)
        (inf_le_left.trans (Y.basicOpen_le (t i)))
      have hVk := hle (O (Sum.inr i) ⊓ O (Sum.inr k)) (W k)
        (inf_le_right.trans (Y.basicOpen_le (t k)))
      have X := s4 _ (O (Sum.inr i) ⊓ O (Sum.inr k)).ι (W i) (W k) hVi hVk (t i) (s i) (t k)
        (s k) (hcross i k)
      have A1 := s3 _ j (W i) (s i) (t i) (gt i) (hgt i) _ (O (Sum.inr i) ⊓ O (Sum.inr k)).ι
        (Y.homOfLE (inf_le_left : O (Sum.inr i) ⊓ O (Sum.inr k) ≤ O (Sum.inr i)))
        (Y.homOfLE_ι _) hVi
      have B1 := s3 _ j (W k) (s k) (t k) (gt k) (hgt k) _ (O (Sum.inr i) ⊓ O (Sum.inr k)).ι
        (Y.homOfLE (inf_le_right : O (Sum.inr i) ⊓ O (Sum.inr k) ≤ O (Sum.inr k)))
        (Y.homOfLE_ι _) hVk
      exact s5 _ j _ _ _ _ _ _ _ _ A1.1 (by linear_combination -X) A1.2 B1.2
  obtain ⟨f, hf⟩ := s2 _ _ O hO G hG
  have hstr : f ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A)
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0))) = v := by
    apply s1 _ _ O hO
    intro a
    rw [← Category.assoc, hf a]
    rcases a with i | i
    · obtain ⟨hu, hF⟩ := s3 _ c (W i) (t i) (s i) (gs i) (hgs i) _ (Y.basicOpen (s i)).ι
        (𝟙 _) (Category.id_comp _) (hle _ _ (Y.basicOpen_le (s i)))
      obtain ⟨u, hu⟩ := hu
      have he : (((Y.basicOpen (s i)).ι.appLE (W i) ⊤ (hle _ _ (Y.basicOpen_le (s i)))).hom
          (t i) * ↑u⁻¹) * ((Y.basicOpen (s i)).ι.appLE (W i) ⊤
            (hle _ _ (Y.basicOpen_le (s i)))).hom (s i) =
          ((Y.basicOpen (s i)).ι.appLE (W i) ⊤ (hle _ _ (Y.basicOpen_le (s i)))).hom (t i) := by
        rw [← hu, mul_assoc, Units.inv_mul, mul_one]
      have h1 := hF _ he
      rw [Category.id_comp] at h1
      show gs i ≫ _ = _
      rw [h1]
      exact s7 c hcs _ _ _
    · obtain ⟨hu, hF⟩ := s3 _ j (W i) (s i) (t i) (gt i) (hgt i) _ (Y.basicOpen (t i)).ι
        (𝟙 _) (Category.id_comp _) (hle _ _ (Y.basicOpen_le (t i)))
      obtain ⟨u, hu⟩ := hu
      have he : (((Y.basicOpen (t i)).ι.appLE (W i) ⊤ (hle _ _ (Y.basicOpen_le (t i)))).hom
          (s i) * ↑u⁻¹) * ((Y.basicOpen (t i)).ι.appLE (W i) ⊤
            (hle _ _ (Y.basicOpen_le (t i)))).hom (t i) =
          ((Y.basicOpen (t i)).ι.appLE (W i) ⊤ (hle _ _ (Y.basicOpen_le (t i)))).hom (s i) := by
        rw [← hu, mul_assoc, Units.inv_mul, mul_one]
      have h1 := hF _ he
      rw [Category.id_comp] at h1
      show gt i ≫ _ = _
      rw [h1]
      exact s7 j hjs _ _ _
  exact ⟨f, hstr, fun i => hf (Sum.inl i), fun i => hf (Sum.inr i)⟩

theorem wcpa_dj_p1rm_section_hits_zero : ∀ (A : Type u) [CommRing A] (Y : Scheme.{u}) (v : Y ⟶ Spec (.of A)) (sY : Spec (.of A) ⟶ Y), sY ≫ v = 𝟙 _ → ∀ (c : Spec (.of (Polynomial A)) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra) (f : Y ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra) (m : ℕ) (W : Fin m → Y.Opens) (t s : ∀ i, Γ(Y, W i)), (⨆ i, W i) = ⊤ → (∀ i, (sY.app (W i)).hom (t i) = 0) → (∀ (i : Fin m) (q : Spec (.of A)), sY q ∈ W i → sY q ∈ Y.basicOpen (s i)) → (∀ (i : Fin m) (T : Scheme.{u}) (k : T ⟶ Y) (hW : ⊤ ≤ k ⁻¹ᵁ W i), (∀ x, k x ∈ Y.basicOpen (s i)) → ∀ e : Γ(T, ⊤), e * (k.appLE (W i) ⊤ hW).hom (s i) = (k.appLE (W i) ⊤ hW).hom (t i) → k ≫ f = T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom ((Scheme.ΓSpecIso (.of A)).inv ≫ (k ≫ v).appTop).hom e)) ≫ c) → sY ≫ f = Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : A))) ≫ c :=
by
  intro A _ Y v sY hs c f m W t s hW H0 HN HΦ
  have s2 : ∀ (T : Scheme.{u}) (g : T ⟶ Spec (.of A)),
      T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom
        ((Scheme.ΓSpecIso (.of A)).inv ≫ g.appTop).hom 0)) =
      g ≫ Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : A))) := by
    intro T g
    have e0 : Polynomial.eval₂RingHom ((Scheme.ΓSpecIso (.of A)).inv ≫ g.appTop).hom 0 =
        ((Scheme.ΓSpecIso (.of A)).inv ≫ g.appTop).hom.comp (Polynomial.evalRingHom (0 : A)) := by
      apply Polynomial.ringHom_ext
      · intro a
        simp
      · simp
    have e : CommRingCat.ofHom (Polynomial.eval₂RingHom
        ((Scheme.ΓSpecIso (.of A)).inv ≫ g.appTop).hom 0) =
        CommRingCat.ofHom (Polynomial.evalRingHom (0 : A)) ≫ (Scheme.ΓSpecIso (.of A)).inv ≫
          g.appTop := by
      rw [e0, CommRingCat.ofHom_comp, CommRingCat.ofHom_hom]
    rw [e, Spec.map_comp, Spec.map_comp]
    simp only [Category.assoc]
    rw [← Category.assoc T.toSpecΓ, ← Scheme.toSpecΓ_naturality, Category.assoc,
      toSpecΓ_SpecMap_ΓSpecIso_inv_assoc]
  apply Scheme.hom_ext_of_forall
  intro x
  have hx : sY x ∈ (⨆ i, W i) := by rw [hW]; trivial
  obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  refine ⟨sY ⁻¹ᵁ W i, hi, ?_⟩
  have hk : ∀ y : (sY ⁻¹ᵁ W i).toScheme, ((sY ⁻¹ᵁ W i).ι ≫ sY) y ∈ W i := by
    intro y
    rw [Scheme.Hom.comp_apply]
    exact y.2
  have hWk : ⊤ ≤ ((sY ⁻¹ᵁ W i).ι ≫ sY) ⁻¹ᵁ W i := fun y _ => hk y
  have hb : ∀ y, ((sY ⁻¹ᵁ W i).ι ≫ sY) y ∈ Y.basicOpen (s i) := by
    intro y
    have h1 := hk y
    rw [Scheme.Hom.comp_apply] at h1 ⊢
    exact HN i _ h1
  have he : (0 : Γ((sY ⁻¹ᵁ W i).toScheme, ⊤)) *
      (((sY ⁻¹ᵁ W i).ι ≫ sY).appLE (W i) ⊤ hWk).hom (s i) =
      (((sY ⁻¹ᵁ W i).ι ≫ sY).appLE (W i) ⊤ hWk).hom (t i) := by
    rw [zero_mul, Scheme.Hom.comp_appLE, CommRingCat.comp_apply, H0 i, map_zero]
  have h := HΦ i (sY ⁻¹ᵁ W i).toScheme ((sY ⁻¹ᵁ W i).ι ≫ sY) hWk hb 0 he
  rw [← Category.assoc _ _ c, s2, Category.assoc (sY ⁻¹ᵁ W i).ι sY v, hs,
    Category.comp_id] at h
  simp only [Category.assoc] at h
  exact h

theorem wcpa_dj_p1rm_fibre_vanish : ∀ (A : Type u) [CommRing A] (Y : Scheme.{u}) (v : Y ⟶ Spec (.of A)) (j c : Spec (.of (Polynomial A)) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra), IsOpenImmersion c → (∀ w : Spec (.of (Polynomial A)), (Polynomial.X : Polynomial A) ∈ w.asIdeal → c w ∉ Set.range j) → ∀ (f : Y ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra) (m : ℕ) (W : Fin m → Y.Opens) (t s : ∀ i, Γ(Y, W i)), (∀ i, Y.basicOpen (t i) ⊔ Y.basicOpen (s i) = W i) → (∀ (i : Fin m) (T : Scheme.{u}) (k : T ⟶ Y) (hW : ⊤ ≤ k ⁻¹ᵁ W i), (∀ x, k x ∈ Y.basicOpen (s i)) → ∀ e : Γ(T, ⊤), e * (k.appLE (W i) ⊤ hW).hom (s i) = (k.appLE (W i) ⊤ hW).hom (t i) → k ≫ f = T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom ((Scheme.ΓSpecIso (.of A)).inv ≫ (k ≫ v).appTop).hom e)) ≫ c) → (∀ (i : Fin m) (T : Scheme.{u}) (k : T ⟶ Y), (∀ x, k x ∈ Y.basicOpen (t i)) → ∀ x, (k ≫ f) x ∈ Set.range j) → ∀ (T : Scheme.{u}) (a : T ⟶ Y) (b : T ⟶ Spec (.of A)), a ≫ f = b ≫ Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : A))) ≫ c → ∀ i, (a.app (W i)).hom (t i) = 0 :=
by
  have L1 : ∀ (Y T : Scheme.{u}) (k : T ⟶ Y) (U : Y.Opens) (σ : Γ(Y, U)) (hW : ⊤ ≤ k ⁻¹ᵁ U) (hk : ∀ x, k x ∈ Y.basicOpen σ), IsUnit ((k.appLE U ⊤ hW).hom σ) := by
    intro Y T k U σ hW hk
    have hb : T.basicOpen ((k.appLE U ⊤ hW).hom σ) = ⊤ := by
      rw [Scheme.basicOpen_appLE]
      ext x
      simp only [TopologicalSpace.Opens.coe_inf, TopologicalSpace.Opens.coe_top, Set.mem_inter_iff,
        Set.mem_univ, true_and, SetLike.mem_coe, Scheme.Hom.mem_preimage]
      simp [hk x]
    apply RingedSpace.isUnit_of_isUnit_germ T.toRingedSpace ⊤
    intro x hx
    have hx' : x ∈ T.basicOpen ((k.appLE U ⊤ hW).hom σ) := by rw [hb]; trivial
    exact (Scheme.mem_basicOpen_top _ _ _).mp hx'
  have L2 : ∀ (A : Type u) [CommRing A] (T : Scheme.{u}) (κ : A →+* Γ(T, ⊤)) (e : Γ(T, ⊤)) (g : T ⟶ Spec (.of A)) (H : T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom κ e)) = g ≫ Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : A)))), e = 0 := by
    intro A _ T κ e g H
    have h1 := congrArg Scheme.Hom.appTop H
    rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, Scheme.toSpecΓ_appTop] at h1
    have h2 : (Scheme.ΓSpecIso (.of (Polynomial A))).inv ≫
        (Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom κ e))).appTop ≫
          (Scheme.ΓSpecIso Γ(T, ⊤)).hom =
        (Scheme.ΓSpecIso (.of (Polynomial A))).inv ≫
        (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : A)))).appTop ≫ g.appTop := by
      rw [h1]
    rw [Scheme.ΓSpecIso_naturality, Iso.inv_hom_id_assoc] at h2
    have h3 := congrArg (fun φ => φ.hom Polynomial.X) h2
    have hn := congrArg (fun φ => φ.hom Polynomial.X)
      (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (Polynomial.evalRingHom (0 : A))))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
      Polynomial.coe_evalRingHom, Polynomial.eval_X, map_zero] at hn
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
      Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X] at h3
    rw [h3, ← hn, map_zero]
  have L4 : ∀ (T Y : Scheme.{u}) (a : T ⟶ Y) (U : Y.Opens) (x : Γ(Y, U)) (hW : ⊤ ≤ ((a ⁻¹ᵁ U).ι ≫ a) ⁻¹ᵁ U) (h0 : (((a ⁻¹ᵁ U).ι ≫ a).appLE U ⊤ hW).hom x = 0), (a.app U).hom x = 0 := by
    intro T Y a U x hW h0
    have hW' : (⊤ : (a ⁻¹ᵁ U).toScheme.Opens) ≤ (a ⁻¹ᵁ U).ι ⁻¹ᵁ (a ⁻¹ᵁ U) := hW
    have h : (a.app U ≫ (a ⁻¹ᵁ U).ι.appLE (a ⁻¹ᵁ U) ⊤ hW').hom x = 0 := by
      rw [Scheme.Hom.comp_appLE] at h0; exact h0
    rw [Scheme.Opens.ι_appLE] at h
    have hle : a ⁻¹ᵁ U ≤ (a ⁻¹ᵁ U).ι ''ᵁ ⊤ := by rw [Scheme.Opens.ι_image_top]
    have hle2 : (a ⁻¹ᵁ U).ι ''ᵁ ⊤ ≤ a ⁻¹ᵁ U := by rw [Scheme.Opens.ι_image_top]
    have h' : (a.app U ≫ T.presheaf.map (homOfLE hle2).op).hom x = 0 := h
    have h3 : a.app U ≫ T.presheaf.map (homOfLE hle2).op ≫ T.presheaf.map (homOfLE hle).op =
        a.app U := by
      rw [← Functor.map_comp, ← op_comp]
      have : homOfLE hle ≫ homOfLE hle2 = 𝟙 _ := Subsingleton.elim _ _
      rw [this, op_id, CategoryTheory.Functor.map_id, Category.comp_id]
    calc (a.app U).hom x
        = (T.presheaf.map (homOfLE hle).op).hom ((a.app U ≫ T.presheaf.map (homOfLE hle2).op).hom x) := by
          conv_lhs => rw [← h3]
          rfl
      _ = 0 := by rw [h', map_zero]
  intro A _ Y v j c hc h01 f m W t s hcov hΦ hR T a b hab i
  have hX : ∀ p : Spec (.of A), (Polynomial.X : Polynomial A) ∈
      (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : A))) p).asIdeal := by
    intro p
    show Polynomial.X ∈ Ideal.comap (Polynomial.evalRingHom (0 : A)) p.asIdeal
    rw [Ideal.mem_comap, Polynomial.coe_evalRingHom, Polynomial.eval_X]
    exact p.asIdeal.zero_mem
  have hs1 : ∀ y : T, a y ∈ W i → a y ∈ Y.basicOpen (s i) := by
    intro y hy
    rw [← hcov i] at hy
    rcases TopologicalSpace.Opens.mem_sup.mp hy with h | h
    · exfalso
      have hBr : a y ∈ Set.range (Y.basicOpen (t i)).ι := by
        rw [Scheme.Opens.range_ι]; exact h
      obtain ⟨z, hz⟩ := hBr
      have h1 := hR i (Y.basicOpen (t i)).toScheme (Y.basicOpen (t i)).ι (fun z' => by
        have : (Y.basicOpen (t i)).ι z' ∈ Set.range (Y.basicOpen (t i)).ι := ⟨z', rfl⟩
        rwa [Scheme.Opens.range_ι] at this) z
      rw [Scheme.Hom.comp_apply, hz] at h1
      have e : (a ≫ f) y = (b ≫ Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : A))) ≫ c) y := by
        rw [hab]
      simp only [Scheme.Hom.comp_apply] at e
      rw [e] at h1
      exact h01 _ (hX (b y)) h1
    · exact h
  have hmemO : ∀ z : (a ⁻¹ᵁ W i).toScheme, a ((a ⁻¹ᵁ W i).ι z) ∈ W i := by
    intro z
    have : (a ⁻¹ᵁ W i).ι z ∈ Set.range (a ⁻¹ᵁ W i).ι := ⟨z, rfl⟩
    rw [Scheme.Opens.range_ι] at this
    exact this
  have hWk : ⊤ ≤ ((a ⁻¹ᵁ W i).ι ≫ a) ⁻¹ᵁ W i := by
    intro z _
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply]
    exact hmemO z
  have hks : ∀ z, ((a ⁻¹ᵁ W i).ι ≫ a) z ∈ Y.basicOpen (s i) := by
    intro z
    rw [Scheme.Hom.comp_apply]
    exact hs1 _ (hmemO z)
  have hu := L1 Y _ ((a ⁻¹ᵁ W i).ι ≫ a) (W i) (s i) hWk hks
  have he : ((((a ⁻¹ᵁ W i).ι ≫ a).appLE (W i) ⊤ hWk).hom (t i) * ↑(hu.unit⁻¹)) *
      (((a ⁻¹ᵁ W i).ι ≫ a).appLE (W i) ⊤ hWk).hom (s i) =
      (((a ⁻¹ᵁ W i).ι ≫ a).appLE (W i) ⊤ hWk).hom (t i) := by
    rw [mul_assoc, IsUnit.val_inv_mul, mul_one]
  have E1 := hΦ i _ ((a ⁻¹ᵁ W i).ι ≫ a) hWk hks _ he
  have E2 : ((a ⁻¹ᵁ W i).ι ≫ a) ≫ f = (((a ⁻¹ᵁ W i).ι ≫ b) ≫
      Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : A)))) ≫ c := by
    rw [Category.assoc, hab]; simp only [Category.assoc]
  rw [E2, ← Category.assoc _ _ c, cancel_mono] at E1
  have he0 := L2 A _ _ _ _ E1.symm
  have hkt : (((a ⁻¹ᵁ W i).ι ≫ a).appLE (W i) ⊤ hWk).hom (t i) = 0 := by
    rw [← he, he0, zero_mul]
  exact L4 T Y a (W i) (t i) hWk hkt

theorem wcpa_dj_p1rm_ideal_vanish : ∀ (A : Type u) [CommRing A] (Y T : Scheme.{u}) (sY : Spec (.of A) ⟶ Y) (a : T ⟶ Y) (m : ℕ) (W : Fin m → Y.Opens) (t : ∀ i, Γ(Y, W i)), (⨆ i, W i) = ⊤ → (∀ (i : Fin m) (O : Y.Opens), IsAffineOpen O → ∀ hO : O ≤ W i, ∀ x : Γ(Y, O), ((sY.app O).hom x = 0 ↔ x ∈ Ideal.span {(Y.presheaf.map (homOfLE hO).op).hom (t i)})) → (∀ i, (a.app (W i)).hom (t i) = 0) → ∀ (U : Y.Opens) (x : Γ(Y, U)), (sY.app U).hom x = 0 → (a.app U).hom x = 0 :=
by
  intro A _ Y T sY a m W t hW hG hV U x hx
  apply TopCat.Presheaf.section_ext T.sheaf (a ⁻¹ᵁ U)
  intro p hp
  have hy : a p ∈ U := hp
  change T.presheaf.germ (a ⁻¹ᵁ U) p hp ((a.app U).hom x) = T.presheaf.germ (a ⁻¹ᵁ U) p hp 0
  rw [map_zero, ← Scheme.Hom.germ_stalkMap_apply a U p hp x]
  obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp
    (show a p ∈ ⨆ i, W i by rw [hW]; trivial)
  obtain ⟨O, hOaff, hyO, hOle⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Y.isBasis_affineOpens)
      (show a p ∈ U ⊓ W i from ⟨hy, hi⟩)
  have hOU : O ≤ U := hOle.trans inf_le_left
  have hOW : O ≤ W i := hOle.trans inf_le_right
  have hxO : (sY.app O).hom ((Y.presheaf.map (homOfLE hOU).op).hom x) = 0 := by
    have e2 := congrArg (fun f => f.hom x) (sY.naturality (homOfLE hOU).op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e2
    rw [e2, hx, map_zero]
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp ((hG i O hOaff hOW _).mp hxO)
  have hgerm : Y.presheaf.germ U (a p) hy x =
      Y.presheaf.germ O (a p) hyO r * Y.presheaf.germ (W i) (a p) hi (t i) := by
    rw [← Y.presheaf.germ_res_apply (homOfLE hOU) (a p) hyO x, ← hr, map_mul,
      Y.presheaf.germ_res_apply]
  rw [hgerm, map_mul, Scheme.Hom.germ_stalkMap_apply a (W i) p hi, hV i, map_zero, mul_zero]

theorem wcpa_dj_p1r_map_to_P1 : ∀ (A : Type u) [CommRing A] (Y : Scheme.{u}) (v : Y ⟶ Spec (.of A)) (sY : Spec (.of A) ⟶ Y), IsSeparated v → sY ≫ v = 𝟙 _ → ∀ (L : wcpaDjCoc Y) (t s : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ v ⁻¹ᵁ ⊤)), wcpaDjCocOK L → wcpaDjCompat L (v ⁻¹ᵁ ⊤) 1 t → wcpaDjCompat L (v ⁻¹ᵁ ⊤) 1 s → (∀ (a : Fin L.m) (O : Y.Opens), IsAffineOpen O → ∀ hO : O ≤ L.V a ⊓ v ⁻¹ᵁ ⊤, (Y.presheaf.map (homOfLE hO).op).hom (t a) ∈ nonZeroDivisors Γ(Y, O) ∧ ∀ x : Γ(Y, O), ((sY.app O).hom x = 0 ↔ x ∈ Ideal.span {(Y.presheaf.map (homOfLE hO).op).hom (t a)})) → (∀ (a : Fin L.m) (q : Spec (.of A)), sY q ∈ L.V a → sY q ∈ Y.basicOpen (s a)) → ∃ (f : Y ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra) (z : Spec (.of A) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra), f ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0))) = v ∧ z ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0))) = 𝟙 _ ∧ IsPullback sY (𝟙 _) f z :=
by
  intro A _ Y v sY hsep hs L t s hOK hCt hCs hG hN

  have hWeq : ∀ a, L.V a ⊓ v ⁻¹ᵁ ⊤ = L.V a := fun a => by
    rw [Scheme.Hom.preimage_top, inf_top_eq]
  have hW : (⨆ a, L.V a ⊓ v ⁻¹ᵁ ⊤) = ⊤ := by
    simp only [hWeq]; exact hOK.2.1
  have haff : ∀ a, IsAffineOpen (L.V a ⊓ v ⁻¹ᵁ ⊤) := fun a => by
    rw [hWeq]; exact hOK.1 a

  obtain ⟨j, c, _hj, hc, hpb, hjs, hcs⟩ := wcpa_dj_p1rm_charts A
  have h01 := wcpa_dj_p1rm_zero_not_in_j A j c hpb
  have hjc := wcpa_dj_p1rm_chart_compat A j c hpb

  have hcov : ∀ a, Y.basicOpen (t a) ⊔ Y.basicOpen (s a) = L.V a ⊓ v ⁻¹ᵁ ⊤ := fun a =>
    wcpa_dj_p1rm_no_common_zero A Y v sY hsep hs (L.V a ⊓ v ⁻¹ᵁ ⊤) (t a) (s a)
      (fun O hO hle x => (hG a O hO hle).2 x) (fun q hq => hN a q hq.1)

  have res : ∀ {U V W : Y.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
        (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro U V W h1 h2 x
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Functor.map_comp]; rfl
  have hcross : ∀ i k : Fin L.m,
      (Y.presheaf.map (homOfLE (inf_le_right : (L.V i ⊓ v ⁻¹ᵁ ⊤) ⊓ (L.V k ⊓ v ⁻¹ᵁ ⊤) ≤
        L.V k ⊓ v ⁻¹ᵁ ⊤)).op).hom (t k) *
      (Y.presheaf.map (homOfLE (inf_le_left : (L.V i ⊓ v ⁻¹ᵁ ⊤) ⊓ (L.V k ⊓ v ⁻¹ᵁ ⊤) ≤
        L.V i ⊓ v ⁻¹ᵁ ⊤)).op).hom (s i) =
      (Y.presheaf.map (homOfLE (inf_le_left : (L.V i ⊓ v ⁻¹ᵁ ⊤) ⊓ (L.V k ⊓ v ⁻¹ᵁ ⊤) ≤
        L.V i ⊓ v ⁻¹ᵁ ⊤)).op).hom (t i) *
      (Y.presheaf.map (homOfLE (inf_le_right : (L.V i ⊓ v ⁻¹ᵁ ⊤) ⊓ (L.V k ⊓ v ⁻¹ᵁ ⊤) ≤
        L.V k ⊓ v ⁻¹ᵁ ⊤)).op).hom (s k) := by
    intro i k
    have hQR : (L.V i ⊓ v ⁻¹ᵁ ⊤) ⊓ (L.V k ⊓ v ⁻¹ᵁ ⊤) ≤ L.V i ⊓ L.V k ⊓ v ⁻¹ᵁ ⊤ :=
      le_inf (le_inf (inf_le_left.trans inf_le_left) (inf_le_right.trans inf_le_left))
        (inf_le_left.trans inf_le_right)
    have e1 := congrArg (Y.presheaf.map (homOfLE hQR).op).hom (hCt i k)
    have e2 := congrArg (Y.presheaf.map (homOfLE hQR).op).hom (hCs i k)
    rw [map_mul, res, res, res] at e1 e2
    linear_combination
      (Y.presheaf.map (homOfLE (inf_le_left : (L.V i ⊓ v ⁻¹ᵁ ⊤) ⊓ (L.V k ⊓ v ⁻¹ᵁ ⊤) ≤
        L.V i ⊓ v ⁻¹ᵁ ⊤)).op).hom (s i) * e1 -
      (Y.presheaf.map (homOfLE (inf_le_left : (L.V i ⊓ v ⁻¹ᵁ ⊤) ⊓ (L.V k ⊓ v ⁻¹ᵁ ⊤) ≤
        L.V i ⊓ v ⁻¹ᵁ ⊤)).op).hom (t i) * e2

  choose gs hgsR hgs using fun a =>
    wcpa_dj_p1rm_local_map A Y v _ c (L.V a ⊓ v ⁻¹ᵁ ⊤) (t a) (s a)
  choose gt hgtR hgt using fun a =>
    wcpa_dj_p1rm_local_map A Y v _ j (L.V a ⊓ v ⁻¹ᵁ ⊤) (s a) (t a)

  obtain ⟨f, hf, hfs, hft⟩ := wcpa_dj_p1rm_glue A Y v j c hjc hjs hcs L.m
    (fun a => L.V a ⊓ v ⁻¹ᵁ ⊤) t s hW hcov hcross gs gt hgs hgt

  have hΦ : ∀ (i : Fin L.m) (T : Scheme.{u}) (k : T ⟶ Y) (hWk : ⊤ ≤ k ⁻¹ᵁ (L.V i ⊓ v ⁻¹ᵁ ⊤)),
      (∀ x, k x ∈ Y.basicOpen (s i)) → ∀ e : Γ(T, ⊤),
      e * (k.appLE (L.V i ⊓ v ⁻¹ᵁ ⊤) ⊤ hWk).hom (s i) =
        (k.appLE (L.V i ⊓ v ⁻¹ᵁ ⊤) ⊤ hWk).hom (t i) →
      k ≫ f = T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom
        ((Scheme.ΓSpecIso (.of A)).inv ≫ (k ≫ v).appTop).hom e)) ≫ c := by
    intro i T k hWk hk e he
    have hrange : Set.range k ⊆ Set.range (Y.basicOpen (s i)).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩; exact hk x
    obtain ⟨k', hk'⟩ : ∃ k' : T ⟶ (Y.basicOpen (s i)).toScheme,
        k' ≫ (Y.basicOpen (s i)).ι = k :=
      ⟨IsOpenImmersion.lift (Y.basicOpen (s i)).ι k hrange, IsOpenImmersion.lift_fac _ _ _⟩
    subst hk'
    have h := hgs i T k' hWk e he
    rw [Category.assoc, hfs i, h, Category.assoc]

  have hR : ∀ (i : Fin L.m) (T : Scheme.{u}) (k : T ⟶ Y), (∀ x, k x ∈ Y.basicOpen (t i)) →
      ∀ x, (k ≫ f) x ∈ Set.range j := by
    intro i T k hk x
    have hrange : Set.range k ⊆ Set.range (Y.basicOpen (t i)).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩; exact hk x
    obtain ⟨k', hk'⟩ : ∃ k' : T ⟶ (Y.basicOpen (t i)).toScheme,
        k' ≫ (Y.basicOpen (t i)).ι = k :=
      ⟨IsOpenImmersion.lift (Y.basicOpen (t i)).ι k hrange, IsOpenImmersion.lift_fac _ _ _⟩
    subst hk'
    rw [Category.assoc, hft i, Scheme.Hom.comp_apply]
    exact hgtR i _

  obtain ⟨z, hzdef⟩ : ∃ z, Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : A))) ≫ c = z :=
    ⟨_, rfl⟩
  have hz : z ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A)
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0))) = 𝟙 _ := by
    rw [← hzdef, Category.assoc, hcs, ← Spec.map_comp]
    have e : (CommRingCat.ofHom (Polynomial.C : A →+* Polynomial A) ≫
        CommRingCat.ofHom (Polynomial.evalRingHom (0 : A))) = 𝟙 _ := by
      ext x; simp
    rw [e, Spec.map_id]

  have h0 : ∀ i, (sY.app (L.V i ⊓ v ⁻¹ᵁ ⊤)).hom (t i) = 0 := by
    intro i
    refine ((hG i _ (haff i) le_rfl).2 (t i)).mpr (Ideal.subset_span ?_)
    rw [Set.mem_singleton_iff]
    change t i = (Y.presheaf.map (𝟙 (Opposite.op (L.V i ⊓ v ⁻¹ᵁ ⊤)))).hom (t i)
    rw [CategoryTheory.Functor.map_id]; rfl
  have hsYf : sY ≫ f = z := by
    rw [← hzdef]
    exact wcpa_dj_p1rm_section_hits_zero A Y v sY hs c f L.m (fun a => L.V a ⊓ v ⁻¹ᵁ ⊤) t s hW h0
      (fun i q hq => hN i q hq.1) hΦ
  refine ⟨f, z, hf, hz, ?_⟩
  have hw : sY ≫ f = 𝟙 _ ≫ z := by rw [Category.id_comp]; exact hsYf
  refine IsPullback.of_isLimit' ⟨hw⟩ ?_
  refine Limits.PullbackCone.IsLimit.mk hw (fun S => S.snd) (fun S => ?_)
    (fun S => Category.comp_id _) (fun S m _ hm2 => by simpa using hm2)
  have hab : S.fst ≫ f = S.snd ≫ z := S.condition
  have hvan := wcpa_dj_p1rm_fibre_vanish A Y v j c hc h01 f L.m (fun a => L.V a ⊓ v ⁻¹ᵁ ⊤) t s
    hcov hΦ hR S.pt S.fst S.snd (by rw [hzdef]; exact hab)
  have hker := wcpa_dj_p1rm_ideal_vanish A Y S.pt sY S.fst L.m (fun a => L.V a ⊓ v ⁻¹ᵁ ⊤) t hW
    (fun i O hO hle x => (hG i O hO hle).2 x) hvan

  obtain ⟨h, hh⟩ : ∃ h : S.pt ⟶ Spec (.of A), h ≫ sY = S.fst := by
    haveI : IsClosedImmersion (sY ≫ v) := by rw [hs]; infer_instance
    haveI : IsClosedImmersion sY := IsClosedImmersion.of_comp sY v
    refine ⟨IsClosedImmersion.lift sY S.fst ?_, IsClosedImmersion.lift_fac _ _ _⟩
    unfold Scheme.Hom.ker
    rw [Scheme.IdealSheafData.le_ofIdeals_iff]
    intro U x hx
    have h1 := Scheme.Hom.ideal_ker_le sY U hx
    rw [RingHom.mem_ker] at h1 ⊢
    exact hker U x h1
  have e1 : h = S.fst ≫ v := by rw [← hh, Category.assoc, hs, Category.comp_id]
  have hb : h = S.snd := by
    rw [e1, ← hf, ← Category.assoc, hab, Category.assoc, hz, Category.comp_id]
  rw [← hb]
  exact hh

theorem wcpa_dj_p1r_fi_closed_fibre_ker : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (X : Scheme.{u}) (g : X ⟶ Spec (.of A)) (V : X.Opens), IsAffineOpen V → RingHom.ker ((Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).app V).hom = Ideal.map ((X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (IsLocalRing.maximalIdeal A) :=
by
  intro A _ _ X g V hV
  set α : A →+* Γ(X, V) := (X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom.comp
    (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom) with hα
  have hαdef : CommRingCat.ofHom α = (Scheme.ΓSpecIso (.of A)).inv ≫ g.appLE ⊤ V le_top := rfl

  have F1 : hV.fromSpec ≫ g = Spec.map (CommRingCat.ofHom α) := by
    rw [← IsAffineOpen.SpecMap_appLE_fromSpec g (isAffineOpen_top (Spec (.of A))) hV le_top,
      IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Spec.map_comp, hαdef]

  have F2 : ∀ (S : CommRingCat.{u}) (π : Γ(X, V) ⟶ S) (h : ⊤ ≤ (Spec.map π ≫ hV.fromSpec) ⁻¹ᵁ V),
      (Spec.map π ≫ hV.fromSpec).appLE V ⊤ h = π ≫ (Scheme.ΓSpecIso S).inv := by
    intro S π h
    rw [Scheme.Hom.comp_appLE, IsAffineOpen.fromSpec_app_self, Category.assoc]
    erw [Scheme.Hom.map_appLE]
    rw [Scheme.ΓSpecIso_inv_naturality]
    rfl
  apply le_antisymm
  ·
    intro c hc
    rw [RingHom.mem_ker] at hc
    set I : Ideal Γ(X, V) := Ideal.map α (IsLocalRing.maximalIdeal A) with hI
    let π₀ : Γ(X, V) →+* Γ(X, V) ⧸ I := Ideal.Quotient.mk I
    let θ : IsLocalRing.ResidueField A →+* Γ(X, V) ⧸ I :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal A) (π₀.comp α)
