    · exact Or.inl (hV₁ V ⟨hV, h'⟩)
    · exact Or.inr (hV₂ V ⟨hV, h'⟩)

theorem wcpa_dj_fva_cj_comp_deg_divisor (K : Type u) [Field K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (L : wcpaDjCoc C) (hq : IsProper q) (hOK : wcpaDjCocOK L)
    (ch : C → Fin L.m) (hch : ∀ x : C, x ∈ L.V (ch x)) (ξ : C)
    [Algebra K (C.residueField ξ)] (hA : algebraMap K (C.residueField ξ) = wcpaDjFK K q ξ)
    (hdeg : wcpaDjCompDeg L ξ (ch ξ) ≠ 0) :
    ∃ D : {V : ValuationSubring (C.residueField ξ) // wcpaDjNtV' K V} →₀ ℤ,
      D.sum (fun _ k => k) = wcpaDjCompDeg L ξ (ch ξ) ∧
      ∀ (x : C) (V : ValuationSubring (C.residueField ξ)), wcpaDjPsBr q x ⟨ξ, V⟩ →
        ∃ hV : wcpaDjNtV' K V, wcpaDjPsTw L (ch ξ) (ch x) ξ ≠ 0 ∧
          wcpaDjValOrd V (wcpaDjPsTw L (ch ξ) (ch x) ξ) = D ⟨V, hV⟩ :=
by
  classical
  haveI := hq
  haveI hsep : IsSeparated q := inferInstance

  have vo_eq : ∀ {F : Type u} [Field F] (V : ValuationSubring F) (x : F), wcpaDjValOrd V x =
      ((sSup {n : ℕ | ∃ h : x ∈ V, (⟨x, h⟩ : V) ∈ IsLocalRing.maximalIdeal V ^ n} : ℕ) : ℤ) -
      ((sSup {n : ℕ | ∃ h : x⁻¹ ∈ V, (⟨x⁻¹, h⟩ : V) ∈ IsLocalRing.maximalIdeal V ^ n} : ℕ) : ℤ) :=
    fun _ _ => rfl
  have vtop : ∀ {F : Type u} [Field F] (y : F), wcpaDjValOrd (⊤ : ValuationSubring F) y = 0 := by
    intro F _ y
    have key : ∀ z : F, z ≠ 0 → sSup {n : ℕ | ∃ h : z ∈ (⊤ : ValuationSubring F),
        (⟨z, h⟩ : (⊤ : ValuationSubring F)) ∈ IsLocalRing.maximalIdeal (⊤ : ValuationSubring F) ^ n}
          = 0 := by
      intro z hz
      have hset : {n : ℕ | ∃ h : z ∈ (⊤ : ValuationSubring F),
          (⟨z, h⟩ : (⊤ : ValuationSubring F)) ∈ IsLocalRing.maximalIdeal (⊤ : ValuationSubring F) ^ n}
            = {0} := by
        ext n
        simp only [Set.mem_setOf_eq, Set.mem_singleton_iff]
        constructor
        · rintro ⟨h, hn⟩
          by_contra hn0
          have hu : IsUnit (⟨z, h⟩ : (⊤ : ValuationSubring F)) :=
            ⟨⟨⟨z, h⟩, ⟨z⁻¹, ValuationSubring.mem_top _⟩, Subtype.ext (mul_inv_cancel₀ hz),
              Subtype.ext (inv_mul_cancel₀ hz)⟩, rfl⟩
          exact (IsLocalRing.notMem_maximalIdeal.mpr hu) (Ideal.pow_le_self hn0 hn)
        · rintro rfl
          exact ⟨ValuationSubring.mem_top _, by rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top⟩
      rw [hset, csSup_singleton]
    by_cases hy : y = 0
    · subst hy
      rw [vo_eq, inv_zero]
      exact sub_self _
    · rw [vo_eq, key y hy, key y⁻¹ (inv_ne_zero hy)]
      simp
  have setEq : ∀ {F : Type u} [Field F] (V : ValuationSubring F) (y u : F), u ∈ V → u⁻¹ ∈ V →
      u ≠ 0 →
      {n : ℕ | ∃ h : y * u ∈ V, (⟨y * u, h⟩ : V) ∈ IsLocalRing.maximalIdeal V ^ n} =
      {n : ℕ | ∃ h : y ∈ V, (⟨y, h⟩ : V) ∈ IsLocalRing.maximalIdeal V ^ n} := by
    intro F _ V y u hu hu' hu0
    have hU : IsUnit (⟨u, hu⟩ : V) :=
      ⟨⟨⟨u, hu⟩, ⟨u⁻¹, hu'⟩, Subtype.ext (mul_inv_cancel₀ hu0), Subtype.ext (inv_mul_cancel₀ hu0)⟩,
        rfl⟩
    ext n
    simp only [Set.mem_setOf_eq]
    constructor
    · rintro ⟨h, hn⟩
      have hy : y ∈ V := by
        have := mul_mem h hu'
        rwa [mul_inv_cancel_right₀ hu0] at this
      refine ⟨hy, ?_⟩
      have e : (⟨y * u, h⟩ : V) = ⟨y, hy⟩ * ⟨u, hu⟩ := rfl
      rw [e] at hn
      exact (Ideal.mul_unit_mem_iff_mem _ hU).mp hn
    · rintro ⟨hy, hn⟩
      refine ⟨mul_mem hy hu, ?_⟩
      have e : (⟨y * u, mul_mem hy hu⟩ : V) = ⟨y, hy⟩ * ⟨u, hu⟩ := rfl
      rw [e]
      exact (Ideal.mul_unit_mem_iff_mem _ hU).mpr hn
  have vunit : ∀ {F : Type u} [Field F] (V : ValuationSubring F) (f w : F), w ∈ V → w⁻¹ ∈ V →
      w ≠ 0 → wcpaDjValOrd V (f * w) = wcpaDjValOrd V f := by
    intro F _ V f w hw hw' hw0
    rw [vo_eq, vo_eq, setEq V f w hw hw' hw0, mul_inv,
      setEq V f⁻¹ w⁻¹ hw' (by rwa [inv_inv]) (inv_ne_zero hw0)]

  have s5 : ∀ {α : Type u} (P : α → Prop) (T : α → ℤ), (∀ v, T v ≠ 0 → P v) → (∑ᶠ v, T v) ≠ 0 →
      ∃ D : {v // P v} →₀ ℤ, D.sum (fun _ k => k) = ∑ᶠ v, T v ∧
        ∀ i : {v // P v}, D i = T i.1 := by
    intro α P T hP hT
    have hfin : (Function.support T).Finite := by
      by_contra hinf
      exact hT (finsum_of_infinite_support hinf)
    have hf : (Function.support (fun i : {v // P v} => T i.1)).Finite := by
      have e : Function.support (fun i : {v // P v} => T i.1) = Subtype.val ⁻¹' Function.support T :=
        rfl
      rw [e]
      exact hfin.preimage Subtype.val_injective.injOn
    refine ⟨Finsupp.ofSupportFinite _ hf, ?_, fun i => rfl⟩
    rw [finsum_eq_sum_of_support_subset T
      (s := (Finsupp.ofSupportFinite _ hf).support.map (Function.Embedding.subtype P)) ?_]
    · rw [Finset.sum_map]
      rfl
    · intro v hv
      rw [Finset.mem_coe]
      exact Finset.mem_map.mpr ⟨⟨v, hP v hv⟩, Finsupp.mem_support_iff.mpr hv, rfl⟩

  have gres : ∀ (U W : C.Opens) (i : U ⟶ W) (hU : ξ ∈ U) (hW : ξ ∈ W) (s : Γ(C, W)),
      (C.presheaf.germ U ξ hU ≫ C.residue ξ).hom ((C.presheaf.map i.op).hom s) =
        (C.presheaf.germ W ξ hW ≫ C.residue ξ).hom s := by
    intro U W i hU hW s
    rw [← TopCat.Presheaf.germ_res C.presheaf i ξ hU]
    rfl
  have etw : ∀ (a y : Fin L.m) (h : ξ ∈ L.V a ⊓ L.V y), wcpaDjPsTw L a y ξ =
      (C.presheaf.germ (L.V a ⊓ L.V y) ξ h ≫ C.residue ξ).hom ↑(L.g a y) := by
    intro a y h
    unfold wcpaDjPsTw wcpaDjPsRes
    rw [dif_pos h]
  have unitr : ∀ (U : C.Opens) (hU : ξ ∈ U) (g : (Γ(C, U))ˣ),
      (C.presheaf.germ U ξ hU ≫ C.residue ξ).hom ↑g *
        (C.presheaf.germ U ξ hU ≫ C.residue ξ).hom ↑g⁻¹ = 1 := by
    intro U hU g
    rw [← map_mul, Units.mul_inv, map_one]

  have s6 : ∀ (V : ValuationSubring (C.residueField ξ)) (b : Fin L.m),
      wcpaDjChartGood L ξ V b → ∀ c : K, wcpaDjFK K q ξ c ∈ V := by
    intro V b hgb c
    obtain ⟨hb, hgood⟩ := hgb
    have e : C.presheaf.map (homOfLE (le_top : L.V b ≤ ⊤)).op ≫ C.presheaf.germ (L.V b) ξ hb =
        C.presheaf.germ ⊤ ξ trivial := TopCat.Presheaf.germ_res C.presheaf _ ξ hb
    have key : wcpaDjFK K q ξ c = (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom
        ((C.presheaf.map (homOfLE (le_top : L.V b ≤ ⊤)).op).hom
          (q.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c))) := by
      unfold wcpaDjFK
      rw [← e]
      rfl
    rw [key]
    exact hgood _

  have centre : ∀ (U : C.Opens), IsAffineOpen U → ∀ (ξ x : C) (h : ξ ⤳ x) (hξ : ξ ∈ U)
      (V : ValuationSubring (C.residueField ξ)),
      (∀ s : Γ(C, U), (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom s ∈ V) →
      (∀ s : C.presheaf.stalk x,
        ∃ hs : (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom s ∈ V,
          s ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x) →
            (⟨(C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom s, hs⟩ : V) ∈
              IsLocalRing.maximalIdeal V) →
      x ∈ U := by
    intro U hU ξ x h hξ V hA hB
    let φU : Γ(C, U) ⟶ CommRingCat.of V :=
      CommRingCat.ofHom ((C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom.codRestrict V hA)
    let φx : C.presheaf.stalk x ⟶ CommRingCat.of V :=
      CommRingCat.ofHom ((C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom.codRestrict V
        (fun s => (hB s).fst))
    let ι : CommRingCat.of V ⟶ CommRingCat.of (C.residueField ξ) :=
      CommRingCat.ofHom (algebraMap V (C.residueField ξ))
    have F1 : φU ≫ ι = C.presheaf.germ U ξ hξ ≫ C.residue ξ := by
      ext s; rfl
    have F2 : φx ≫ ι = C.presheaf.stalkSpecializes h ≫ C.residue ξ := by
      ext s; rfl
    let f₁ : Spec (CommRingCat.of V) ⟶ C := Spec.map φU ≫ hU.fromSpec
    let f₂ : Spec (CommRingCat.of V) ⟶ C := Spec.map φx ≫ C.fromSpecStalk x
    have e1 : Spec.map ι ≫ f₁ = C.fromSpecResidueField ξ := by
      show Spec.map ι ≫ Spec.map φU ≫ hU.fromSpec = _
      rw [← Spec.map_comp_assoc, F1, Spec.map_comp_assoc, ← IsAffineOpen.fromSpecStalk,
        IsAffineOpen.fromSpecStalk_eq_fromSpecStalk]
      rfl
    have e2 : Spec.map ι ≫ f₂ = C.fromSpecResidueField ξ := by
      show Spec.map ι ≫ Spec.map φx ≫ C.fromSpecStalk x = _
      rw [← Spec.map_comp_assoc, F2, Spec.map_comp_assoc,
        Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
      rfl
    have heq : f₁ = f₂ := by
      let g : C ⟶ ⊤_ Scheme := q ≫ Limits.terminal.from _
      haveI : IsSeparated g := inferInstance
      let S : ValuativeCommSq g :=
        { R := V, K := C.residueField ξ, i₁ := Spec.map ι ≫ f₁, i₂ := Limits.terminal.from _,
          commSq := ⟨Limits.terminal.hom_ext _ _⟩ }
      haveI hsub : Subsingleton S.commSq.LiftStruct := IsSeparated.valuativeCriterion g S
      let l₁ : S.commSq.LiftStruct := ⟨f₁, rfl, Limits.terminal.hom_ext _ _⟩
      let l₂ : S.commSq.LiftStruct := ⟨f₂, e2.trans e1.symm, Limits.terminal.hom_ext _ _⟩
      exact congrArg CommSq.LiftStruct.l (Subsingleton.elim l₁ l₂)
    haveI : IsLocalHom φx.hom := by
      constructor
      intro s hs
      by_contra hns
      have hm : s ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x) :=
        (IsLocalRing.mem_maximalIdeal _).mpr hns
      have h2 := (hB s).snd hm
      exact ((IsLocalRing.mem_maximalIdeal _).mp h2) hs
    let cp : Spec (CommRingCat.of V) := IsLocalRing.closedPoint V
    have hcp : f₂ cp = x := by
      show (Spec.map φx ≫ C.fromSpecStalk x) cp = x
      rw [Scheme.Hom.comp_apply]
      have hc : (Spec.map φx) cp = IsLocalRing.closedPoint (C.presheaf.stalk x) :=
        Spec_closedPoint
      rw [hc]
      exact Scheme.fromSpecStalk_closedPoint
    have hmem : x ∈ Set.range hU.fromSpec := by
      rw [← hcp, ← heq]
      exact ⟨(Spec.map φU) cp, (Scheme.Hom.comp_apply _ _ _).symm⟩
    rwa [hU.range_fromSpec] at hmem

  unfold wcpaDjCompDeg at hdeg ⊢
  refine Exists.elim (s5 (wcpaDjNtV' K) _ ?_ hdeg) ?_
  ·
    intro V hV
    beta_reduce at hV
    by_cases hc : ξ ∈ L.V (ch ξ) ∧ ∃ b, wcpaDjChartGood L ξ V b
    · rw [dif_pos hc] at hV
      refine ⟨fun c => ?_, fun htop => ?_⟩
      · rw [hA]
        exact s6 V hc.2.choose hc.2.choose_spec c
      · subst htop
        exact hV (vtop _)
    · rw [dif_neg hc] at hV
      exact absurd rfl hV
  · rintro D ⟨hDsum, hDval⟩
    refine ⟨D, hDsum, ?_⟩
    intro x V hBr
    have hsp : ξ ⤳ x := hBr.2.2.2.1
    have h0 : ∀ g : C.presheaf.stalk x, wcpaDjPsSp x ξ g ∈ V := fun g => by
      obtain ⟨h, -⟩ := hBr.2.2.2.2.1 g
      exact h
    have h1 : ∀ g ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x),
        ∃ h : wcpaDjPsSp x ξ g ∈ V, (⟨_, h⟩ : V) ∈ IsLocalRing.maximalIdeal V := fun g hg => by
      obtain ⟨h, h'⟩ := hBr.2.2.2.2.2 g hg
      rw [pow_one] at h'
      exact ⟨h, h'⟩
    have hV : wcpaDjNtV' K V := ⟨fun c => by rw [hA]; exact hBr.2.2.1 c, hBr.2.1⟩
    have esp : ∀ g, wcpaDjPsSp x ξ g = (C.presheaf.stalkSpecializes hsp ≫ C.residue ξ).hom g := by
      intro g
      unfold wcpaDjPsSp
      rw [dif_pos hsp]
    have resV : ∀ (U : C.Opens) (hx : x ∈ U) (hξU : ξ ∈ U) (s : Γ(C, U)),
        (C.presheaf.germ U ξ hξU ≫ C.residue ξ).hom s ∈ V := by
      intro U hx hξU s
      have e : (C.presheaf.germ U ξ hξU ≫ C.residue ξ).hom s =
          wcpaDjPsSp x ξ ((C.presheaf.germ U x hx).hom s) := by
        rw [esp, ← TopCat.Presheaf.germ_stalkSpecializes C.presheaf hx hsp]
        rfl
      rw [e]
      exact h0 _
    have hgood_c : wcpaDjChartGood L ξ V (ch x) :=
      ⟨hsp.mem_open (L.V (ch x)).isOpen (hch x), fun s => resV _ (hch x) _ s⟩
    have hc : ξ ∈ L.V (ch ξ) ∧ ∃ b, wcpaDjChartGood L ξ V b := ⟨hch ξ, ch x, hgood_c⟩
    obtain ⟨hξb, hgoodb⟩ := hc.2.choose_spec
    have hxb : x ∈ L.V hc.2.choose := centre (L.V hc.2.choose) (hOK.1 _) ξ x hsp hξb V hgoodb
      (fun s => by
        have hm := h0 s
        rw [esp] at hm
        refine ⟨hm, fun hs => ?_⟩
        obtain ⟨hm1, hm2⟩ := h1 s hs
        have e : (⟨(C.presheaf.stalkSpecializes hsp ≫ C.residue ξ).hom s, hm⟩ : V) =
            ⟨wcpaDjPsSp x ξ s, hm1⟩ := Subtype.ext (esp s).symm
        rw [e]
        exact hm2)
    have twist : ∀ b : Fin L.m, ξ ∈ L.V b → x ∈ L.V b →
        wcpaDjPsTw L (ch ξ) (ch x) ξ ≠ 0 ∧
          wcpaDjValOrd V (wcpaDjPsTw L (ch ξ) (ch x) ξ) = wcpaDjValOrd V (wcpaDjPsTw L (ch ξ) b ξ) := by
      intro b hξb' hxb'
      have hξa := hch ξ
      have hξc : ξ ∈ L.V (ch x) := hsp.mem_open (L.V (ch x)).isOpen (hch x)
      have hab : ξ ∈ L.V (ch ξ) ⊓ L.V b := TopologicalSpace.Opens.mem_inf.mpr ⟨hξa, hξb'⟩
      have hbc : ξ ∈ L.V b ⊓ L.V (ch x) := TopologicalSpace.Opens.mem_inf.mpr ⟨hξb', hξc⟩
      have hac : ξ ∈ L.V (ch ξ) ⊓ L.V (ch x) := TopologicalSpace.Opens.mem_inf.mpr ⟨hξa, hξc⟩
      have habc : ξ ∈ L.V (ch ξ) ⊓ L.V b ⊓ L.V (ch x) :=
        TopologicalSpace.Opens.mem_inf.mpr ⟨hab, hξc⟩
      have hxbc : x ∈ L.V b ⊓ L.V (ch x) := TopologicalSpace.Opens.mem_inf.mpr ⟨hxb', hch x⟩
      have hcoc := congrArg
        (C.presheaf.germ (L.V (ch ξ) ⊓ L.V b ⊓ L.V (ch x)) ξ habc ≫ C.residue ξ).hom
        (hOK.2.2.2 (ch ξ) b (ch x))
      rw [map_mul, gres _ (L.V (ch ξ) ⊓ L.V b) _ habc hab, gres _ (L.V b ⊓ L.V (ch x)) _ habc hbc,
        gres _ (L.V (ch ξ) ⊓ L.V (ch x)) _ habc hac] at hcoc
      rw [etw _ _ hac, etw _ _ hab, ← hcoc]
      have hu1 := unitr _ hab (L.g (ch ξ) b)
      have hu2 := unitr _ hbc (L.g b (ch x))
      refine ⟨mul_ne_zero (left_ne_zero_of_mul_eq_one hu1) (left_ne_zero_of_mul_eq_one hu2), ?_⟩
      refine vunit V _ _ (resV _ hxbc hbc _) ?_ (left_ne_zero_of_mul_eq_one hu2)
      rw [inv_eq_of_mul_eq_one_right hu2]
      exact resV _ hxbc hbc _
    obtain ⟨hne, hval⟩ := twist _ hξb hxb
    refine ⟨hV, hne, hval.trans ?_⟩
    rw [hDval ⟨V, hV⟩]
    try dsimp only
    rw [dif_pos hc, etw _ _ (TopologicalSpace.Opens.mem_inf.mpr ⟨hch ξ, hξb⟩)]

theorem wcpa_dj_fva_ss_component_jets : ∀ (K : Type u) [Field K] [IsAlgClosed K]
    (C : Scheme.{u}) (q : C ⟶ Spec (.of K)) (L : wcpaDjCoc C),
    wcpaDjSemistable q → wcpaDjCocOK L →
    ∀ (ch : C → Fin L.m), (∀ x : C, x ∈ L.V (ch x)) →
    ∀ ξ : C, ∃ c : ℕ, closure {ξ} ∈ irreducibleComponents C → 1 ≤ wcpaDjCompDeg L ξ (ch ξ) →
      ∀ (e : ℕ) (P : Finset C) (n : C → ℕ)
        (j : ValuationSubring (C.residueField ξ) → C.residueField ξ),
        c + ∑ p ∈ P, 2 * n p ≤ e → (∀ p ∈ P, IsClosed ({p} : Set C)) →
        ∃ u : C.residueField ξ,
          (∀ x : C, IsClosed ({x} : Set C) → ∀ V : ValuationSubring (C.residueField ξ),
            wcpaDjPsBr q x ⟨ξ, V⟩ → wcpaDjPsInPow V (wcpaDjPsTw L (ch ξ) (ch x) ξ ^ e * u) 0) ∧
          (∀ p ∈ P, ∀ V : ValuationSubring (C.residueField ξ), wcpaDjPsBr q p ⟨ξ, V⟩ →
            j V ∈ V → wcpaDjPsInPow V (wcpaDjPsTw L (ch ξ) (ch p) ξ ^ e * u - j V) (n p)) :=
by
  classical
  intro K _ _ C q L hss hOK ch hch ξ
  letI : Algebra K (C.residueField ξ) := (wcpaDjPsK q ξ).toAlgebra
  have hA : algebraMap K (C.residueField ξ) = wcpaDjFK K q ξ := rfl
  by_cases hξ : closure {ξ} ∈ irreducibleComponents C
  swap
  · exact ⟨0, fun h => absurd h hξ⟩
  have ipz : ∀ (V : ValuationSubring (C.residueField ξ)) (k : ℕ), wcpaDjPsInPow V 0 k := by
    intro V k
    unfold wcpaDjPsInPow
    exact ⟨V.zero_mem, Submodule.zero_mem _⟩
  have hFF := wcpa_dj_cdp_residue_ff1 K C q hss ξ hξ hA
  obtain ⟨w, hw, hinj, hwv⟩ := wcpa_dj_fva_cj_ff_family K (C.residueField ξ) hFF
  have hA6 := wcpa_dj_fva_cj_ff_finrank K (C.residueField ξ) hFF
  obtain ⟨c, hc⟩ := wcpa_dj_fva_cj_rr_jets K (C.residueField ξ) _ w hw hinj hA6
  refine ⟨c, fun _ hpos e P n j hle hPcl => ?_⟩

  obtain ⟨D, hDsum, hDbr⟩ :=
    wcpa_dj_fva_cj_comp_deg_divisor K C q L hss.2.1 hOK ch hch ξ hA (by omega)
  have hD'sum : ((e : ℤ) • D).sum (fun _ k => k) = (e : ℤ) * D.sum (fun _ k => k) := by
    rw [Finsupp.sum_smul_index' (fun _ => rfl)]
    simp only [Finsupp.sum, smul_eq_mul, Finset.mul_sum]

  have hsp0 : ∀ p : C, ∃ s : Finset (ValuationSubring (C.residueField ξ)),
      IsClosed ({p} : Set C) → s.card ≤ 2 ∧ ∀ V, wcpaDjPsBr q p ⟨ξ, V⟩ ↔ V ∈ s := by
    intro p
    by_cases hp : IsClosed ({p} : Set C)
    · obtain ⟨s, h1, h2⟩ := wcpa_dj_fva_cj_branch_count K C q hss p ξ hp
      exact ⟨s, fun _ => ⟨h1, h2⟩⟩
    · exact ⟨∅, fun h => absurd h hp⟩
  choose sp hsp using hsp0
  have hpick : ∀ V : ValuationSubring (C.residueField ξ), ∃ p : C,
      (∃ p ∈ P, V ∈ sp p) → p ∈ P ∧ V ∈ sp p := by
    intro V
    by_cases h : ∃ p ∈ P, V ∈ sp p
    · obtain ⟨p, hp, hV⟩ := h
      exact ⟨p, fun _ => ⟨hp, hV⟩⟩
    · exact ⟨ξ, fun h' => absurd h' h⟩
  choose pV hpVspec using hpick
  have hpV : ∀ p ∈ P, ∀ V, V ∈ sp p → pV V = p := by
    intro p hp V hV
    obtain ⟨h1, h2⟩ := hpVspec V ⟨p, hp, hV⟩
    exact wcpa_dj_fva_ss_center_unique K C q hss _ p (hPcl _ h1) (hPcl p hp) ⟨ξ, V⟩
      (((hsp _ (hPcl _ h1)).2 V).mpr h2) (((hsp p (hPcl p hp)).2 V).mpr hV)

  set S' := P.biUnion sp with hS'
  set S : Finset {V : ValuationSubring (C.residueField ξ) // wcpaDjNtV' K V} :=
    S'.subtype (wcpaDjNtV' K) with hS
  set m : {V : ValuationSubring (C.residueField ξ) // wcpaDjNtV' K V} → ℕ :=
    fun i => n (pV i.1) with hm
  set τ : {V : ValuationSubring (C.residueField ξ) // wcpaDjNtV' K V} → (C.residueField ξ)ˣ :=
    fun i => if h : wcpaDjPsTw L (ch ξ) (ch (pV i.1)) ξ ≠ 0 then (Units.mk0 _ h) ^ e else 1
    with hτ
  set j' : {V : ValuationSubring (C.residueField ξ) // wcpaDjNtV' K V} → C.residueField ξ :=
    fun i => if j i.1 ∈ i.1 then j i.1 else 0 with hj'
  have hτval : ∀ i : {V : ValuationSubring (C.residueField ξ) // wcpaDjNtV' K V},
      wcpaDjPsTw L (ch ξ) (ch (pV i.1)) ξ ≠ 0 →
      (τ i : C.residueField ξ) = wcpaDjPsTw L (ch ξ) (ch (pV i.1)) ξ ^ e := by
    intro i h
    simp only [hτ, dif_pos h, Units.val_pow_eq_pow_val, Units.val_mk0]
  have hSmem : ∀ i, i ∈ S → pV i.1 ∈ P ∧ i.1 ∈ sp (pV i.1) := by
    intro i hi
    rw [hS, Finset.mem_subtype, hS', Finset.mem_biUnion] at hi
    exact hpVspec i.1 hi

  have hdisj : Set.PairwiseDisjoint (↑P : Set C) sp := by
    intro p hp p' hp' hne
    exact Finset.disjoint_left.mpr (fun V h1 h2 =>
      hne ((hpV p (Finset.mem_coe.mp hp) V h1).symm.trans (hpV p' (Finset.mem_coe.mp hp') V h2)))
  have hsum : ∑ i ∈ S, m i ≤ ∑ p ∈ P, 2 * n p := by
    have h1 : ∑ i ∈ S, m i = ∑ V ∈ S'.filter (wcpaDjNtV' K), n (pV V) := by
      rw [hS, ← Finset.subtype_map, Finset.sum_map]
      rfl
    have h2 : ∑ V ∈ S'.filter (wcpaDjNtV' K), n (pV V) ≤ ∑ V ∈ S', n (pV V) :=
      Finset.sum_le_sum_of_subset (Finset.filter_subset _ _)
    have h3 : ∑ V ∈ S', n (pV V) = ∑ p ∈ P, ∑ V ∈ sp p, n (pV V) := by
      rw [hS']
      exact Finset.sum_biUnion hdisj
    have h4 : ∑ p ∈ P, ∑ V ∈ sp p, n (pV V) = ∑ p ∈ P, (sp p).card * n p := by
      refine Finset.sum_congr rfl (fun p hp => ?_)
      rw [Finset.sum_congr rfl (fun V hV => by rw [hpV p hp V hV]), Finset.sum_const, smul_eq_mul]
    have h5 : ∑ p ∈ P, (sp p).card * n p ≤ ∑ p ∈ P, 2 * n p :=
      Finset.sum_le_sum (fun p hp => Nat.mul_le_mul_right _ (hsp p (hPcl p hp)).1)
    omega
  have hdeg : (c : ℤ) + ∑ i ∈ S, (m i : ℤ) ≤ ((e : ℤ) • D).sum (fun _ k => k) := by
    rw [hD'sum, hDsum]
    have h1 : c + ∑ i ∈ S, m i ≤ e := by omega
    have h2 : ((c + ∑ i ∈ S, m i : ℕ) : ℤ) ≤ (e : ℤ) := by exact_mod_cast h1
    push_cast at h2
    have h3 : (e : ℤ) * 1 ≤ (e : ℤ) * wcpaDjCompDeg L ξ (ch ξ) :=
      mul_le_mul_of_nonneg_left hpos (Nat.cast_nonneg e)
    linarith

  have htw : ∀ i ∈ S, w i (Additive.ofMul (τ i)) = ((e : ℤ) • D) i := by
    intro i hi
    obtain ⟨hp, hVsp⟩ := hSmem i hi
    have hBr : wcpaDjPsBr q (pV i.1) ⟨ξ, i.1⟩ := ((hsp _ (hPcl _ hp)).2 i.1).mpr hVsp
    obtain ⟨hV, hTw, hval⟩ := hDbr (pV i.1) i.1 hBr
    have hτi : τ i = (Units.mk0 _ hTw) ^ e := by
      simp only [hτ, dif_pos hTw]
    rw [hτi, ofMul_pow, map_nsmul, hwv, Units.val_mk0, hval, Finsupp.smul_apply, smul_eq_mul,
      nsmul_eq_mul]

  have htg : ∀ i ∈ S, ∀ hj : j' i ≠ 0, 0 ≤ w i (Additive.ofMul (Units.mk0 (j' i) hj)) := by
    intro i _ hj
    have hmem : j i.1 ∈ i.1 := by
      by_contra hc'
      exact hj (by simp only [hj', if_neg hc'])
    have hj'i : j' i = j i.1 := by simp only [hj', if_pos hmem]
    rw [hwv, Units.val_mk0]
    have h0 : wcpaDjPsInPow i.1 (j' i) 0 := by
      rw [hj'i]
      exact ⟨hmem, by rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top⟩
    have := ((wcpa_dj_fva_cj_ff_dvr K _ hFF i.1 i.2).1 (j' i) hj 0).mp h0
    simpa using this
  obtain ⟨u, hu1, hu2⟩ := hc ((e : ℤ) • D) S m τ j' hdeg htw htg
  refine ⟨u, ?_, ?_⟩
  ·
    intro x _ V hBr
    obtain ⟨hV, hTw, hval⟩ := hDbr x V hBr
    by_cases hu : u = 0
    · rw [hu, mul_zero]
      exact ipz V 0
    have hne : wcpaDjPsTw L (ch ξ) (ch x) ξ ^ e * u ≠ 0 := mul_ne_zero (pow_ne_zero _ hTw) hu
    have key : wcpaDjValOrd V (wcpaDjPsTw L (ch ξ) (ch x) ξ ^ e * u) =
        w ⟨V, hV⟩ (Additive.ofMul (Units.mk0 _ hTw ^ e * Units.mk0 u hu)) := by
      rw [hwv]
      simp
    rw [ofMul_mul, map_add, ofMul_pow, map_nsmul] at key
    simp only [hwv, Units.val_mk0] at key
    rw [hval, nsmul_eq_mul] at key
    have h1 := hu1 hu ⟨V, hV⟩
    rw [Finsupp.smul_apply, smul_eq_mul, hwv, Units.val_mk0] at h1
    have h2 : ((0 : ℕ) : ℤ) ≤ wcpaDjValOrd V (wcpaDjPsTw L (ch ξ) (ch x) ξ ^ e * u) := by
      rw [key]
      push_cast
      linarith
    exact ((wcpa_dj_fva_cj_ff_dvr K _ hFF V hV).1 _ hne 0).mpr h2
  ·
    intro p hp V hBr hjV
    have hVsp : V ∈ sp p := ((hsp p (hPcl p hp)).2 V).mp hBr
    have hpVV : pV V = p := hpV p hp V hVsp
    obtain ⟨hV, hTw, hval⟩ := hDbr p V hBr
    have hiS : (⟨V, hV⟩ : {V : ValuationSubring (C.residueField ξ) // wcpaDjNtV' K V}) ∈ S := by
      rw [hS, Finset.mem_subtype, hS', Finset.mem_biUnion]
      exact ⟨p, hp, hVsp⟩
    have hτi : (τ ⟨V, hV⟩ : C.residueField ξ) = wcpaDjPsTw L (ch ξ) (ch p) ξ ^ e := by
      have h := hτval ⟨V, hV⟩ (by show wcpaDjPsTw L (ch ξ) (ch (pV V)) ξ ≠ 0; rw [hpVV]; exact hTw)
      rw [h]
      show wcpaDjPsTw L (ch ξ) (ch (pV V)) ξ ^ e = _
      rw [hpVV]
    have hj'i : j' ⟨V, hV⟩ = j V := by simp only [hj', if_pos hjV]
    have hmi : m ⟨V, hV⟩ = n p := by
      show n (pV V) = n p
      rw [hpVV]
    by_cases hz : wcpaDjPsTw L (ch ξ) (ch p) ξ ^ e * u - j V = 0
    · rw [hz]
      exact ipz V _
    have hsub : (τ ⟨V, hV⟩ : C.residueField ξ) * u - j' ⟨V, hV⟩ =
        wcpaDjPsTw L (ch ξ) (ch p) ξ ^ e * u - j V := by
      rw [hτi, hj'i]
    have h' : (τ ⟨V, hV⟩ : C.residueField ξ) * u - j' ⟨V, hV⟩ ≠ 0 := by
      rw [hsub]
      exact hz
    have h2 := hu2 ⟨V, hV⟩ hiS h'
    rw [hwv, Units.val_mk0, hsub, hmi] at h2
    exact ((wcpa_dj_fva_cj_ff_dvr K _ hFF V hV).1 _ hz (n p)).mpr h2

theorem wcpa_dj_fva_gg_glue_generic : ∀ (C : Scheme.{u}), JacobsonSpace C →
    {ξ : C | closure {ξ} ∈ irreducibleComponents C}.Finite →
    (∀ (O : C.Opens) (t : Γ(C, O)), (∀ (ξ : C) (hξ : ξ ∈ O),
        closure {ξ} ∈ irreducibleComponents C →
        (C.presheaf.germ O ξ hξ ≫ C.residue ξ).hom t = 0) → t = 0) →
    ∀ (W : C.Opens) (F : ∀ ξ : C, C.residueField ξ),
    (∀ x : C, IsClosed ({x} : Set C) → x ∈ W → ∃ h : C.presheaf.stalk x,
      ∀ ξ : C, closure {ξ} ∈ irreducibleComponents C → ξ ⤳ x → wcpaDjPsSp x ξ h = F ξ) →
    ∃ t : Γ(C, W), ∀ (ξ : C) (hξ : ξ ∈ W), closure {ξ} ∈ irreducibleComponents C →
      (C.presheaf.germ W ξ hξ ≫ C.residue ξ).hom t = F ξ :=
by
  intro C hJ hGfin huniq W F hloc
  classical
  haveI := hJ

  have germ_res : ∀ (O O' : C.Opens) (f : O' ⟶ O) (ξ : C) (hξ : ξ ∈ O') (t : Γ(C, O)),
      (C.presheaf.germ O' ξ hξ ≫ C.residue ξ).hom ((C.presheaf.map f.op).hom t) =
        (C.presheaf.germ O ξ (f.le hξ) ≫ C.residue ξ).hom t := by
    intro O O' f ξ hξ t
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Category.assoc, TopCat.Presheaf.germ_res]
  have sp_eq : ∀ (x ξ : C) (h : ξ ⤳ x) (g : C.presheaf.stalk x),
      wcpaDjPsSp x ξ g = (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom g := by
    intro x ξ h g
    unfold wcpaDjPsSp
    rw [dif_pos h]
  have sp_germ : ∀ (x ξ : C) (h : ξ ⤳ x) (O : C.Opens) (t : Γ(C, O)) (hx : x ∈ O),
      wcpaDjPsSp x ξ ((C.presheaf.germ O x hx).hom t) =
        (C.presheaf.germ O ξ (h.mem_open O.isOpen hx) ≫ C.residue ξ).hom t := by
    intro x ξ h O t hx
    rw [sp_eq x ξ h, ← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Category.assoc,
      TopCat.Presheaf.germ_stalkSpecializes]

  have closed_below : ∀ z : C, z ∈ W → ∃ y : C, IsClosed ({y} : Set C) ∧ y ∈ W ∧ z ⤳ y := by
    intro z hz
    have h1 : z ∈ closure (closure {z} ∩ closedPoints C) := by
      rw [closure_inter_closedPoints isClosed_closure]
      exact subset_closure rfl
    obtain ⟨y, hyW, hyZ, hyc⟩ := mem_closure_iff.mp h1 (W : Set C) W.isOpen hz
    exact ⟨y, mem_closedPoints_iff.mp hyc, hyW, specializes_iff_mem_closure.mpr hyZ⟩

  have local_piece : ∀ (x : C), x ∈ W → ∀ h : C.presheaf.stalk x,
      (∀ ξ : C, closure {ξ} ∈ irreducibleComponents C → ξ ⤳ x → wcpaDjPsSp x ξ h = F ξ) →
      ∃ (O : C.Opens) (t : Γ(C, O)), x ∈ O ∧ O ≤ W ∧
        ∀ (ξ : C) (hξ : ξ ∈ O), closure {ξ} ∈ irreducibleComponents C →
          (C.presheaf.germ O ξ hξ ≫ C.residue ξ).hom t = F ξ := by
    intro x hxW h hh
    obtain ⟨O₁, hxO₁, t₁, ht₁⟩ := TopCat.Presheaf.exists_germ_eq C.presheaf h
    have hSfin : {ξ : C | closure {ξ} ∈ irreducibleComponents C ∧ ¬ ξ ⤳ x}.Finite :=
      hGfin.subset (fun ξ hξ => hξ.1)
    have hEcl : IsClosed (⋃ ξ ∈ {ξ : C | closure {ξ} ∈ irreducibleComponents C ∧ ¬ ξ ⤳ x},
        closure {ξ}) :=
      hSfin.isClosed_biUnion (fun _ _ => isClosed_closure)
    let E : C.Opens := ⟨_, hEcl.isOpen_compl⟩
    have hxE : x ∈ E := by
      show x ∈ (⋃ ξ ∈ {ξ : C | closure {ξ} ∈ irreducibleComponents C ∧ ¬ ξ ⤳ x},
        closure {ξ})ᶜ
      intro hx
      obtain ⟨ξ, hξS, hxξ⟩ := Set.mem_iUnion₂.mp hx
      exact hξS.2 (specializes_iff_mem_closure.mpr hxξ)
    have hle1 : O₁ ⊓ W ⊓ E ≤ O₁ := fun y hy =>
      (TopologicalSpace.Opens.mem_inf.mp (TopologicalSpace.Opens.mem_inf.mp hy).1).1
    have hleW : O₁ ⊓ W ⊓ E ≤ W := fun y hy =>
      (TopologicalSpace.Opens.mem_inf.mp (TopologicalSpace.Opens.mem_inf.mp hy).1).2
    refine ⟨O₁ ⊓ W ⊓ E, (C.presheaf.map (homOfLE hle1).op).hom t₁,
      TopologicalSpace.Opens.mem_inf.mpr ⟨TopologicalSpace.Opens.mem_inf.mpr ⟨hxO₁, hxW⟩, hxE⟩,
      hleW, ?_⟩
    intro ξ hξ hξG
    have hξE : ξ ∈ E := (TopologicalSpace.Opens.mem_inf.mp hξ).2
    have hsp : ξ ⤳ x := by
      by_contra hn
      apply hξE
      exact Set.mem_iUnion₂.mpr ⟨ξ, ⟨hξG, hn⟩, subset_closure rfl⟩
    rw [germ_res, ← hh ξ hξG hsp, ← ht₁, sp_germ x ξ hsp]

  have hlp : ∀ i : {x : C // IsClosed ({x} : Set C) ∧ x ∈ W}, ∃ (O : C.Opens) (t : Γ(C, O)),
      i.1 ∈ O ∧ O ≤ W ∧ ∀ (ξ : C) (hξ : ξ ∈ O), closure {ξ} ∈ irreducibleComponents C →
        (C.presheaf.germ O ξ hξ ≫ C.residue ξ).hom t = F ξ := by
    intro i
    obtain ⟨h, hh⟩ := hloc i.1 i.2.1 i.2.2
    exact local_piece i.1 i.2.2 h hh
  choose O s hxO hOW hres using hlp
  have hcov : W ≤ iSup O := by
    intro z hz
    obtain ⟨y, hyc, hyW, hzy⟩ := closed_below z hz
    exact TopologicalSpace.Opens.mem_iSup.mpr
      ⟨⟨y, hyc, hyW⟩, hzy.mem_open (O ⟨y, hyc, hyW⟩).isOpen (hxO ⟨y, hyc, hyW⟩)⟩
  have hcompat : TopCat.Presheaf.IsCompatible C.sheaf.obj O s := by
    intro i j
    show (C.presheaf.map ((O i).infLELeft (O j)).op).hom (s i) =
      (C.presheaf.map ((O i).infLERight (O j)).op).hom (s j)
    rw [← sub_eq_zero]
    apply huniq
    intro ξ hξ hξG
    rw [map_sub, germ_res, germ_res, hres i _ _ hξG, hres j _ _ hξG, sub_self]
  obtain ⟨t, ht, -⟩ := TopCat.Sheaf.existsUnique_gluing' C.sheaf O W
    (fun i => homOfLE (hOW i)) hcov s hcompat
  refine ⟨t, fun ξ hξ hξG => ?_⟩
  obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp (hcov hξ)
  have hti : (C.presheaf.map (homOfLE (hOW i)).op).hom t = s i := ht i
  rw [← germ_res W (O i) (homOfLE (hOW i)) ξ hi t, hti, hres i ξ hi hξG]

theorem wcpa_dj_fva_gg_realize_smooth : ∀ (K : Type u) [Field K] [IsAlgClosed K]
    (C : Scheme.{u}) (q : C ⟶ Spec (.of K)), wcpaDjSemistable q →
    ∀ x : C, IsClosed ({x} : Set C) →
    (∃ W : C.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q)) →
    ∀ f : ∀ ξ : C, C.residueField ξ,
    (∀ β, wcpaDjPsBr q x β → wcpaDjPsInPow β.2 (f β.1) 0) →
    ∃ h : C.presheaf.stalk x, ∀ ξ : C, closure {ξ} ∈ irreducibleComponents C → ξ ⤳ x →
      wcpaDjPsSp x ξ h = f ξ :=
by
  intro K _ _ C q hss x hx hsm f hf
  classical
  obtain ⟨W, hxW, hW⟩ := hsm

  have hgen : ∀ ζ : C, closure {ζ} ∈ irreducibleComponents C → ∀ y : C, y ⤳ ζ → y = ζ := by
    intro ζ hζ y hy
    have h1 : closure {ζ} ⊆ closure ({y} : Set C) := specializes_iff_closure_subset.mp hy
    rw [irreducibleComponents_eq_maximals_closed] at hζ
    have hζ' : Maximal (fun x : Set C => IsClosed x ∧ IsIrreducible x) (closure {ζ}) := hζ
    have h2 : closure {ζ} = closure ({y} : Set C) :=
      Maximal.eq_of_le hζ' ⟨isClosed_closure, isIrreducible_singleton.closure⟩ h1
    exact (inseparable_iff_closure_eq.mpr h2.symm).eq

  have hsp : ∀ (x ξ : C) (h : ξ ⤳ x) (g : C.presheaf.stalk x),
      wcpaDjPsSp x ξ g = (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom g := by
    intro x ξ h g
    unfold wcpaDjPsSp
    rw [dif_pos h]

  have s3 : ∀ (ξ x : C) (h : ξ ⤳ x),
      (∀ f : C.residueField ξ, ∃ a s : C.presheaf.stalk x,
        (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom s ≠ 0 ∧
        f * (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom s =
          (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom a) := by
    intro ξ x h f
    letI := (C.presheaf.stalkSpecializes h).hom.toAlgebra
    haveI := wc_ldp_nc_stalkSpecializes_isLocalization C ξ x h
    obtain ⟨z, hz⟩ := C.residue_surjective ξ f
    obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj
      ((IsLocalRing.maximalIdeal (C.presheaf.stalk ξ)).comap
        (C.presheaf.stalkSpecializes h).hom).primeCompl z
    refine ⟨a, s, ?_, ?_⟩
    · have hs' : (s : C.presheaf.stalk x) ∉ (IsLocalRing.maximalIdeal (C.presheaf.stalk ξ)).comap
          (C.presheaf.stalkSpecializes h).hom := s.2
      rw [Ideal.mem_comap] at hs'
      intro h0
      exact hs' ((IsLocalRing.residue_eq_zero_iff _).mp h0)
    · rw [← hz]
      have e := congrArg (C.residue ξ).hom hs
      rw [map_mul] at e
      exact e

  have s2 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (F : Type u) [Field F] (ψ : A →+* F),
      (∀ a b : A, a ∣ b ∨ b ∣ a) →
      (∀ f : F, ∃ a s : A, ψ s ≠ 0 ∧ f * ψ s = ψ a) →
      ∀ V : ValuationSubring F, (∀ g ∈ IsLocalRing.maximalIdeal A, wcpaDjPsInPow V (ψ g) 1) →
      ∀ f : F, f ∈ V → ∃ a : A, ψ a = f := by
    intro A _ _ F _ ψ hdvd hfrac V h1 f hf
    obtain ⟨a, s, hs, hfs⟩ := hfrac f
    rcases hdvd s a with ⟨c, rfl⟩ | ⟨c, rfl⟩
    · refine ⟨c, ?_⟩
      rw [map_mul] at hfs
      exact mul_left_cancel₀ hs (hfs.symm.trans (mul_comm _ _))
    · rw [map_mul] at hs hfs
      have ha : ψ a ≠ 0 := left_ne_zero_of_mul hs
      have hfc : f * ψ c = 1 := by
        apply mul_left_cancel₀ ha
        calc ψ a * (f * ψ c) = f * (ψ a * ψ c) := by ring
          _ = ψ a := hfs
          _ = ψ a * 1 := (mul_one _).symm
      by_cases hc : c ∈ IsLocalRing.maximalIdeal A
      · exfalso
        obtain ⟨hcV, hcm⟩ := h1 c hc
        rw [pow_one] at hcm
        have hm : (⟨f, hf⟩ : V) * ⟨ψ c, hcV⟩ ∈ IsLocalRing.maximalIdeal V :=
          Ideal.mul_mem_left _ _ hcm
        have h1V : (⟨f, hf⟩ : V) * ⟨ψ c, hcV⟩ = 1 := Subtype.ext hfc
        rw [h1V] at hm
        exact (IsLocalRing.maximalIdeal V).ne_top_iff_one.mp
          (IsLocalRing.maximalIdeal.isMaximal V).ne_top hm
      · have hcu : IsUnit c := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hc
          exact hc
        obtain ⟨u, rfl⟩ := hcu
        refine ⟨↑u⁻¹, ?_⟩
        calc ψ ↑u⁻¹ = f * ψ ↑u * ψ ↑u⁻¹ := by rw [hfc, one_mul]
          _ = f := by rw [mul_assoc, ← map_mul, Units.mul_inv, map_one, mul_one]

  have s5 : IsDomain (C.presheaf.stalk x) ∧ (∀ a b : C.presheaf.stalk x, a ∣ b ∨ b ∣ a) := by
    haveI := hW
    let ε := (W.stalkIso ⟨x, hxW⟩).commRingCatIsoToRingEquiv
    haveI := wcpa_smooth_stalk_isDomain K W.toScheme (W.ι ≫ q) 1 ⟨x, hxW⟩
    haveI := wcpa_dj_sgt_smooth_curve_stalk_valuation K W.toScheme (W.ι ≫ q) ⟨x, hxW⟩
    refine ⟨MulEquiv.isDomain _ ε.symm.toMulEquiv, ?_⟩
    intro a b
    rcases ValuationRing.dvd_total (ε.symm a) (ε.symm b) with ⟨c, hc⟩ | ⟨c, hc⟩
    · left
      refine ⟨ε c, ?_⟩
      have := congrArg ε hc
      rwa [map_mul, RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply] at this
    · right
      refine ⟨ε c, ?_⟩
      have := congrArg ε hc
      rwa [map_mul, RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply] at this
  obtain ⟨hdom, hdvd⟩ := s5
  have hgpt : ∀ ζ : C, closure {ζ} ∈ irreducibleComponents C → ζ ⤳ x →
      ζ = C.fromSpecStalk x ⟨⊥, Ideal.isPrime_bot⟩ := by
    intro ζ hζ hζx
    have hr : ζ ∈ Set.range (C.fromSpecStalk x) := by
      rw [Scheme.range_fromSpecStalk]
      exact hζx
    obtain ⟨p, hp⟩ := hr
    have h1 : (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum (C.presheaf.stalk x)) ⤳ p :=
      (PrimeSpectrum.le_iff_specializes _ _).mp bot_le
    have h2 := h1.map (C.fromSpecStalk x).continuous
    rw [hp] at h2
    exact (hgen ζ hζ _ h2).symm

  obtain ⟨-, -, hBr, -⟩ := wcpa_dj_fva_ss_branch_basics K C q hss
  obtain ⟨⟨ξ₀, V₀⟩, hβ₀⟩ := hBr x hx
  have h₀ : ξ₀ ⤳ x := hβ₀.2.2.2.1
  have h1 : ∀ g ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x), wcpaDjPsInPow V₀
      ((C.presheaf.stalkSpecializes h₀ ≫ C.residue ξ₀).hom g) 1 := by
    intro g hg
    rw [← hsp x ξ₀ h₀]
    exact hβ₀.2.2.2.2.2 g hg
  have hfV : f ξ₀ ∈ V₀ := (hf ⟨ξ₀, V₀⟩ hβ₀).1
  obtain ⟨h, hh⟩ := s2 _ _ _ hdvd (s3 ξ₀ x h₀) V₀ h1 (f ξ₀) hfV
  refine ⟨h, fun ζ hζ hζx => ?_⟩
  have e1 := hgpt ζ hζ hζx
  have e2 := hgpt ξ₀ hβ₀.1 h₀
  have hζξ : ζ = ξ₀ := e1.trans e2.symm
  subst hζξ
  rw [hsp x ζ h₀]
  exact hh

theorem wcpa_dj_fva_rn_node_package : ∀ (K : Type u) [Field K] [IsAlgClosed K]
    (C : Scheme.{u}) (q : C ⟶ Spec (.of K)), wcpaDjSemistable q →
    ∀ x : C, IsClosed ({x} : Set C) →
    (¬ ∃ W : C.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q)) →
    ∃ (B : Type u) (_ : CommRing B) (j : C.presheaf.stalk x →+* B) (χ₀ χ₁ : B →+* K),
      IsNoetherianRing (C.presheaf.stalk x) ∧ ringKrullDim (C.presheaf.stalk x) ≤ 1 ∧
      Function.Injective j ∧ j.Finite ∧
      (∀ (Q : Ideal B) [Q.IsPrime], IsDomain (Localization.AtPrime Q) ∧
        IsIntegrallyClosed (Localization.AtPrime Q)) ∧
      (∀ Q ∈ minimalPrimes B, Ideal.comap j Q ≠ IsLocalRing.maximalIdeal (C.presheaf.stalk x)) ∧
      (∀ p : Ideal (C.presheaf.stalk x), p.IsPrime →
        p ≠ IsLocalRing.maximalIdeal (C.presheaf.stalk x) →
        ∀ b : B, ∃ g a : C.presheaf.stalk x, g ∉ p ∧ j a = j g * b) ∧
      χ₀.comp (j.comp ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫
        C.presheaf.germ ⊤ x trivial).hom) = RingHom.id K ∧
      χ₁.comp (j.comp ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫
        C.presheaf.germ ⊤ x trivial).hom) = RingHom.id K ∧
      RingHom.ker χ₀ ≠ RingHom.ker χ₁ ∧
      ∀ b : B, (∃ a : C.presheaf.stalk x, j a = b) ↔ χ₀ b = χ₁ b :=
by
  intro K _ _ C q hss x hx hsm
  classical
  haveI hprop : IsProper q := hss.2.1
  haveI hlft : LocallyOfFiniteType q := inferInstance
  haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian q
  let U : C.Opens := sSup {W : C.Opens | SmoothOfRelativeDimension 1 (W.ι ≫ q)}
  have hiff : ∀ w : C, w ∈ U ↔
      ∃ W : C.Opens, w ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q) := by
    intro w
    rw [TopologicalSpace.Opens.mem_sSup]
    constructor
    · rintro ⟨W, hW, hwW⟩; exact ⟨W, hwW, hW⟩
    · rintro ⟨W, hwW, hW⟩; exact ⟨W, hW, hwW⟩
  have hΦ : (asIso (Limits.pullback.fst q (𝟙 (Spec (.of K))))).symm.hom ≫
      Limits.pullback.snd q (𝟙 (Spec (.of K))) = q := by
    simp only [Iso.symm_hom, asIso_inv]
    rw [IsIso.inv_comp_eq, Limits.pullback.condition, Category.comp_id]
  have hnode : ∀ w : C, w ∉ U → ∃ e : AdicCompletion (IsLocalRing.maximalIdeal (C.presheaf.stalk w))
      (C.presheaf.stalk w) ≃+*
      (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
      e.toRingHom.comp ((algebraMap (C.presheaf.stalk w) (AdicCompletion
        (IsLocalRing.maximalIdeal (C.presheaf.stalk w)) (C.presheaf.stalk w))).comp
        ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ w trivial).hom) =
        (Ideal.Quotient.mk _).comp MvPowerSeries.C := by
    intro w hw
    rcases wcpa_dj_ssp_bw_ns_transport K
        (asIso (Limits.pullback.fst q (𝟙 (Spec (.of K))))).symm
        q (Limits.pullback.snd q (𝟙 (Spec (.of K)))) hΦ w (hss.2.2 K (𝟙 _) _) with hsm' | hn
    · exact absurd ((hiff w).mpr hsm') hw
    · exact hn
  have hres : ∀ w : C, w ∉ U → ∀ a : C.presheaf.stalk w, ∃ z : K,
      a - ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ w trivial).hom z ∈
        IsLocalRing.maximalIdeal (C.presheaf.stalk w) :=
    fun w hw => wcpa_dj_nf_node_residue K (C.presheaf.stalk w) _ (hnode w hw)
  obtain ⟨hcl, -⟩ := wcpa_dj_nf_nodes_closed_finite K C q U hprop hres
  have hxU : x ∉ U := fun h => hsm ((hiff x).mp h)
  obtain ⟨Ct, ν, hfin, hsurj, hiso, hnorm, hgen⟩ := wcpa_dj_nn_normalization K C q U hprop hiff hnode
  obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset (show x ∈ (⊤ : C.Opens) from trivial)
  obtain ⟨j, hj, hjfin⟩ := wcpa_dj_nf_loc_map C Ct ν V hV x hxV hfin
  have hnormB := wcpa_dj_nf_loc_normal C Ct ν V hV x hxV hfin hnorm
  have hgenB := wcpa_dj_nf_loc_generic C Ct ν U V hV x hxV j hfin hsurj hxU hgen hj
  have hisoB := wcpa_dj_nf_loc_iso C Ct ν U V hV x hxV j hfin hiso hcl hj
  haveI hred := wcpa_dj_nf_node_reduced K (C.presheaf.stalk x) _ (hnode x hxU)
  have hdim := wcpa_dj_nf_node_dim_le_one K C q U hlft hiff hcl x hxU
  obtain ⟨hjinj, d, hdm, hdA, hdB, hdcond⟩ := wcpa_dj_nf_conductor (C.presheaf.stalk x) _ j hjfin
    hdim hgenB.1 (fun Q _ => (hnormB Q).1) hgenB.2 hisoB.1 hisoB.2
  obtain ⟨χ₀, χ₁, h0, h1, hne, -, hsep⟩ := wcpa_dj_nn_node_ring K (C.presheaf.stalk x) _
    ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ x trivial).hom j d
    (hnode x hxU) hdim hjinj hjfin hdm hdA hdB hdcond hnormB
  refine ⟨Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨x, hxV⟩).asIdeal.primeCompl),
    inferInstance, j, χ₀, χ₁, inferInstance, hdim, hjinj, hjfin, hnormB, hgenB.2, ?_, h0, h1, hne,
    hsep⟩
  intro p hp hpm b
  obtain ⟨g, hg, a, ha⟩ := hisoB.1 p hp hpm b
  exact ⟨g, a, hg, ha⟩

theorem wcpa_dj_fva_rn_ext_lift : ∀ (A B κ : Type u) [CommRing A] [CommRing B] [Field κ]
    (j : A →+* B) (ψ : A →+* κ), Function.Injective j →
    (∀ b : B, ∃ g a : A, ψ g ≠ 0 ∧ j a = j g * b) →
    ∃ ψ' : B →+* κ, ψ'.comp j = ψ ∧
      ∀ Q : Ideal B, Q.IsPrime → Ideal.comap j Q = RingHom.ker ψ → Q = RingHom.ker ψ' :=
by
  intro A B κ _ _ _ j ψ hj H
  classical
  choose G Aw hG hGA using H
  have S : ∀ (b : B) (g a : A), ψ g ≠ 0 → j a = j g * b →
      ψ g * (ψ (Aw b) * (ψ (G b))⁻¹) = ψ a := by
    intro b g a _ ha
    have h1 : a * G b = Aw b * g := by
      apply hj
      rw [map_mul, map_mul, ha, hGA b]
      ring
    have h2 : ψ a * ψ (G b) = ψ (Aw b) * ψ g := by
      rw [← map_mul, ← map_mul, h1]
    calc ψ g * (ψ (Aw b) * (ψ (G b))⁻¹) = (ψ (Aw b) * ψ g) * (ψ (G b))⁻¹ := by ring
      _ = (ψ a * ψ (G b)) * (ψ (G b))⁻¹ := by rw [h2]
      _ = ψ a := by rw [mul_assoc, mul_inv_cancel₀ (hG b), mul_one]
  obtain ⟨f, hf⟩ : ∃ f : B → κ, ∀ (b : B) (g a : A), ψ g ≠ 0 → j a = j g * b →
      ψ g * f b = ψ a := ⟨_, S⟩
  have h1 : f 1 = 1 := by
    have := hf 1 1 1 (by simp) (by simp)
    simpa using this
  have h0 : f 0 = 0 := by
    have := hf 0 1 0 (by simp) (by simp)
    simpa using this
  have hmul : ∀ b₁ b₂ : B, f (b₁ * b₂) = f b₁ * f b₂ := by
    intro b₁ b₂
    have e1 := hf b₁ _ _ (hG b₁) (hGA b₁)
    have e2 := hf b₂ _ _ (hG b₂) (hGA b₂)
    have e12 := hf (b₁ * b₂) (G b₁ * G b₂) (Aw b₁ * Aw b₂)
      (by rw [map_mul]; exact mul_ne_zero (hG b₁) (hG b₂))
      (by rw [map_mul, map_mul, hGA b₁, hGA b₂]; ring)
    rw [map_mul, map_mul] at e12
    apply mul_left_cancel₀ (mul_ne_zero (hG b₁) (hG b₂))
    linear_combination e12 - ψ (Aw b₂) * e1 - ψ (G b₁) * f b₁ * e2
  have hadd : ∀ b₁ b₂ : B, f (b₁ + b₂) = f b₁ + f b₂ := by
    intro b₁ b₂
    have e1 := hf b₁ _ _ (hG b₁) (hGA b₁)
    have e2 := hf b₂ _ _ (hG b₂) (hGA b₂)
    have e12 := hf (b₁ + b₂) (G b₁ * G b₂) (Aw b₁ * G b₂ + Aw b₂ * G b₁)
      (by rw [map_mul]; exact mul_ne_zero (hG b₁) (hG b₂))
      (by simp only [map_add, map_mul, hGA]; ring)
    rw [map_add, map_mul, map_mul, map_mul] at e12
    apply mul_left_cancel₀ (mul_ne_zero (hG b₁) (hG b₂))
    linear_combination e12 - ψ (G b₂) * e1 - ψ (G b₁) * e2
  let ψ' : B →+* κ :=
    { toFun := f
      map_one' := h1
      map_mul' := hmul
      map_zero' := h0
      map_add' := hadd }
  refine ⟨ψ', ?_, ?_⟩
  · apply RingHom.ext
    intro a
    show f (j a) = ψ a
    have := hf (j a) 1 a (by simp) (by simp)
    simpa using this
  · intro Q hQ hcomap
    ext b
    have e := hf b _ _ (hG b) (hGA b)
    rw [RingHom.mem_ker]
    show b ∈ Q ↔ f b = 0
    constructor
    · intro hb
      have h1 : Aw b ∈ Ideal.comap j Q := by
        rw [Ideal.mem_comap, hGA b]
        exact Q.mul_mem_left _ hb
      rw [hcomap, RingHom.mem_ker] at h1
      rw [h1] at e
      exact (mul_eq_zero.mp e).resolve_left (hG b)
    · intro hb
      rw [hb, mul_zero] at e
      have h1 : Aw b ∈ Ideal.comap j Q := by
        rw [hcomap, RingHom.mem_ker]
        exact e.symm
      rw [Ideal.mem_comap, hGA b] at h1
      rcases hQ.mem_or_mem h1 with h | h
      · exfalso
        apply hG b
        have h2 : G b ∈ Ideal.comap j Q := h
        rw [hcomap, RingHom.mem_ker] at h2
        exact h2
      · exact h

theorem wcpa_dj_fva_rn_loc_valuation : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (B : Type u) [CommRing B] (j : A →+* B), j.Finite → ringKrullDim A ≤ 1 →
    (∀ (Q : Ideal B) [Q.IsPrime], IsDomain (Localization.AtPrime Q) ∧
      IsIntegrallyClosed (Localization.AtPrime Q)) →
    ∀ (Q M : Ideal B) [Q.IsPrime] [M.IsMaximal], Q ≤ M →
    Ideal.comap j Q ≠ IsLocalRing.maximalIdeal A →
    (∀ y z : Localization.AtPrime M, y ∣ z ∨ z ∣ y) ∧
    (∀ b : B, b ∈ Q ↔ algebraMap B (Localization.AtPrime M) b = 0) ∧
    Ideal.comap j M = IsLocalRing.maximalIdeal A ∧ ∃ b ∈ M, b ∉ Q :=
by
  intro A _ _ _ B _ j hfin hdim hloc Q M _ hM hle hQne
  have hint : j.IsIntegral := RingHom.Finite.to_isIntegral hfin
  letI := j.toAlgebra

  have s2 : ∀ (P P' : Ideal B), P.IsPrime → P'.IsPrime → P < P' →
      Ideal.comap j P' = IsLocalRing.maximalIdeal A := by
    intro P P' hP hP' hlt
    obtain ⟨x, hxP', hxP⟩ := SetLike.exists_of_lt hlt
    have hlt' : Ideal.comap j P < Ideal.comap j P' :=
      Ideal.under_lt_under_of_integral_mem_sdiff (R := A) (le_of_lt hlt) ⟨hxP', hxP⟩ (hint x)
    have hK : Ring.KrullDimLE 1 A := Ring.krullDimLE_iff.mpr (by exact_mod_cast hdim)
    rcases Ring.krullDimLE_one_iff.mp hK (Ideal.comap j P') inferInstance with h | h
    · exfalso
      have h' : Minimal (fun q : Ideal A => q.IsPrime ∧ ⊥ ≤ q) (Ideal.comap j P') := h
      have := h'.le_of_le (y := Ideal.comap j P) ⟨Ideal.comap_isPrime j P, bot_le⟩ hlt'.le
      exact absurd this (not_le_of_gt hlt')
    · exact IsLocalRing.eq_maximalIdeal h

  have hMA : Ideal.comap j M = IsLocalRing.maximalIdeal A := by
    haveI := Ideal.isMaximal_comap_of_isIntegral_of_isMaximal j hint M
    exact IsLocalRing.eq_maximalIdeal this
  have hQM : Q ≠ M := fun h => hQne (h ▸ hMA)
  have hQlt : Q < M := lt_of_le_of_ne hle hQM
  obtain ⟨hdom, hic⟩ := hloc M
  haveI := hdom
  have F1 : ∀ J : Ideal (Localization.AtPrime M),
      Ideal.map (algebraMap B (Localization.AtPrime M))
        (Ideal.comap (algebraMap B (Localization.AtPrime M)) J) = J :=
    fun J => IsLocalization.map_under M.primeCompl (Localization.AtPrime M) J
  have F2 : Ideal.comap (algebraMap B (Localization.AtPrime M))
      (IsLocalRing.maximalIdeal (Localization.AtPrime M)) = M :=
    IsLocalization.AtPrime.under_maximalIdeal (Localization.AtPrime M) M
  have F3 : ∀ P : Ideal B, P.IsPrime → P ≤ M →
      Ideal.comap (algebraMap B (Localization.AtPrime M))
        (Ideal.map (algebraMap B (Localization.AtPrime M)) P) = P := by
    intro P hP hPM
    have hdisj : Disjoint (M.primeCompl : Set B) P := by
      rw [Set.disjoint_left]; intro s hs hsP; exact hs (hPM hsP)
    exact IsLocalization.under_map_of_isPrime_disjoint M.primeCompl (Localization.AtPrime M) hP hdisj
  have hP0p : (Ideal.comap (algebraMap B (Localization.AtPrime M))
      (⊥ : Ideal (Localization.AtPrime M))).IsPrime := Ideal.comap_isPrime _ _
  have hP0Q : Ideal.comap (algebraMap B (Localization.AtPrime M))
      (⊥ : Ideal (Localization.AtPrime M)) ≤ Q := by
    rw [← F3 Q inferInstance hle]; exact Ideal.comap_mono bot_le
  have hQP0 : Q = Ideal.comap (algebraMap B (Localization.AtPrime M))
      (⊥ : Ideal (Localization.AtPrime M)) := by
    by_contra hne
    exact hQne (s2 _ Q hP0p inferInstance (lt_of_le_of_ne hP0Q (Ne.symm hne)))

  have c2 : ∀ b : B, b ∈ Q ↔ algebraMap B (Localization.AtPrime M) b = 0 := by
    intro b
    rw [hQP0, Ideal.mem_comap, Ideal.mem_bot]

  haveI : Module.Finite A B := hfin
  have hB : IsNoetherianRing B := IsNoetherianRing.of_finite A B
  haveI hS : IsNoetherianRing (Localization.AtPrime M) :=
    IsLocalization.isNoetherianRing M.primeCompl _ hB
  have hne : IsLocalRing.maximalIdeal (Localization.AtPrime M) ≠ ⊥ := by
    intro h
    apply hQM
    rw [hQP0, ← h]
    exact F2
  have huniq : ∀ P : Ideal (Localization.AtPrime M), P.IsPrime → P ≠ ⊥ →
      P = IsLocalRing.maximalIdeal (Localization.AtPrime M) := by
    intro P hP hP0
    have hP1p : (Ideal.comap (algebraMap B (Localization.AtPrime M)) P).IsPrime :=
      Ideal.comap_isPrime _ P
    have hlt : Ideal.comap (algebraMap B (Localization.AtPrime M))
        (⊥ : Ideal (Localization.AtPrime M)) <
        Ideal.comap (algebraMap B (Localization.AtPrime M)) P := by
      refine lt_of_le_of_ne (Ideal.comap_mono bot_le) ?_
      intro h
      apply hP0
      rw [← F1 P, ← h, F1]
    have h1 := s2 _ _ hP0p hP1p hlt
    have hmax : (Ideal.comap (algebraMap B (Localization.AtPrime M)) P).IsMaximal :=
      Ideal.isMaximal_of_isIntegral_of_isMaximal_comap' j hint _
        (by rw [h1]; exact IsLocalRing.maximalIdeal.isMaximal A)
    have hle' : Ideal.comap (algebraMap B (Localization.AtPrime M)) P ≤ M :=
      (Ideal.comap_mono (IsLocalRing.le_maximalIdeal hP.ne_top)).trans F2.le
    have heq := hmax.eq_of_le (Ideal.IsMaximal.ne_top inferInstance) hle'
    have hmS := F1 (IsLocalRing.maximalIdeal (Localization.AtPrime M))
    rw [F2] at hmS
    rw [← F1 P, heq]
    exact hmS
  have hnf : ¬ IsField (Localization.AtPrime M) :=
    fun h => hne (IsLocalRing.isField_iff_maximalIdeal_eq.mp h)
  have h4 : IsIntegrallyClosed (Localization.AtPrime M) ∧
      ∃! P : Ideal (Localization.AtPrime M), P ≠ ⊥ ∧ P.IsPrime :=
    ⟨hic, ⟨IsLocalRing.maximalIdeal _, ⟨hne, (IsLocalRing.maximalIdeal.isMaximal _).isPrime⟩,
      fun P ⟨hP0, hPp⟩ => huniq P hPp hP0⟩⟩
  haveI hV : ValuationRing (Localization.AtPrime M) :=
    ((IsDiscreteValuationRing.TFAE _ hnf).out 4 2).mp h4
  refine ⟨fun y z => ValuationRing.dvd_total y z, c2, hMA, ?_⟩
  obtain ⟨b, hbM, hbQ⟩ := SetLike.exists_of_lt hQlt
  exact ⟨b, hbM, hbQ⟩

theorem wcpa_dj_fva_rn_branch_ring : ∀ (B : Type u) [CommRing B] (κ : Type u) [Field κ]
    (ψ : B →+* κ) (M : Ideal B) [M.IsPrime],
    (∀ y z : Localization.AtPrime M, y ∣ z ∨ z ∣ y) →
    RingHom.ker ψ ≤ M →
    (∀ b : B, ψ b = 0 → algebraMap B (Localization.AtPrime M) b = 0) →
    (∀ y : κ, ∃ a s : B, ψ s ≠ 0 ∧ y * ψ s = ψ a) →
    (∃ b ∈ M, ψ b ≠ 0) →
    ∃ W : ValuationSubring κ, W ≠ ⊤ ∧ (∀ b : B, ψ b ∈ W) ∧
      (∀ (b : B) (hb : ψ b ∈ W), (⟨ψ b, hb⟩ : W) ∈ IsLocalRing.maximalIdeal W ↔ b ∈ M) ∧
      ∀ y ∈ W, ∃ b s : B, s ∉ M ∧ y * ψ s = ψ b :=
by
  intro B _ κ _ ψ M _ hdvd hker h0 hfrac hM
  classical
  have hunits : ∀ y : M.primeCompl, IsUnit (ψ y) := by
    intro y
    apply Ne.isUnit
    intro hy
    exact (Ideal.mem_primeCompl_iff.mp y.2) (hker (RingHom.mem_ker.mpr hy))
  obtain ⟨φ, hφι⟩ : ∃ φ : Localization.AtPrime M →+* κ,
      ∀ b : B, φ (algebraMap B (Localization.AtPrime M) b) = ψ b :=
    ⟨IsLocalization.lift (M := M.primeCompl) (S := Localization.AtPrime M) hunits,
      fun b => IsLocalization.lift_eq hunits b⟩
  have hmk : ∀ (b : B) (s : M.primeCompl),
      φ (IsLocalization.mk' (Localization.AtPrime M) b s) * ψ s = ψ b := by
    intro b s
    rw [← hφι, ← hφι, ← map_mul, IsLocalization.mk'_spec]
  have hφinj : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective M.primeCompl x
    have hb : ψ b = 0 := by rw [← hmk b s, hx, zero_mul]
    have hι := h0 b hb
    have e := IsLocalization.mk'_spec (Localization.AtPrime M) b s
    rw [hι] at e
    exact (IsLocalization.map_units (Localization.AtPrime M) s).mul_left_eq_zero.mp e
  have hval : ∀ x : κ, x ∈ φ.range ∨ x⁻¹ ∈ φ.range := by
    intro x
    obtain ⟨a, s, hs, hxs⟩ := hfrac x
    have hs' : φ (algebraMap B _ s) ≠ 0 := by rwa [hφι]
    have hxs' : x * φ (algebraMap B _ s) = φ (algebraMap B _ a) := by
      rw [hφι, hφι]; exact hxs
    rcases hdvd (algebraMap B (Localization.AtPrime M) s)
        (algebraMap B (Localization.AtPrime M) a) with ⟨c, hc⟩ | ⟨c, hc⟩
    · left
      refine ⟨c, ?_⟩
      rw [hc, map_mul] at hxs'
      exact mul_left_cancel₀ hs' (hxs'.symm.trans (mul_comm _ _))
    · right
      refine ⟨c, ?_⟩
      rw [hc, map_mul] at hs' hxs'
      have ha : φ (algebraMap B _ a) ≠ 0 := left_ne_zero_of_mul hs'
      have e1 : φ (algebraMap B _ a) * (x * φ c) = φ (algebraMap B _ a) * 1 :=
        calc φ (algebraMap B _ a) * (x * φ c) = x * (φ (algebraMap B _ a) * φ c) := by ring
          _ = φ (algebraMap B _ a) := hxs'
          _ = φ (algebraMap B _ a) * 1 := (mul_one _).symm
      have e2 : x * φ c = 1 := mul_left_cancel₀ ha e1
      exact (inv_eq_of_mul_eq_one_right e2).symm
  obtain ⟨W, hW⟩ : ∃ W : ValuationSubring κ, ∀ x : κ, x ∈ W ↔ ∃ r, φ r = x :=
    ⟨{ toSubring := φ.range, mem_or_inv_mem' := hval }, fun x => Iff.rfl⟩
  have hmem : ∀ b : B, ψ b ∈ W := fun b => (hW _).mpr ⟨_, hφι b⟩
  have hunit : ∀ (b : B) (hb : ψ b ∈ W), IsUnit (⟨ψ b, hb⟩ : W) ↔ b ∉ M := by
    intro b hb
    constructor
    · intro hu
      obtain ⟨w, hw⟩ := hu.exists_right_inv
      obtain ⟨c, hc⟩ := (hW w).mp w.2
      have e : ψ b * (w : κ) = 1 := congrArg Subtype.val hw
      have e2 : φ (algebraMap B (Localization.AtPrime M) b * c) = φ 1 := by
        rw [map_mul, hφι, hc, e, map_one]
      have e3 := hφinj e2
      have hu' : IsUnit (algebraMap B (Localization.AtPrime M) b) := IsUnit.of_mul_eq_one _ e3
      exact Ideal.mem_primeCompl_iff.mp
        ((IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime M) M b).mp hu')
    · intro hbM
      have hu' : IsUnit (algebraMap B (Localization.AtPrime M) b) :=
        (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime M) M b).mpr
          (Ideal.mem_primeCompl_iff.mpr hbM)
      obtain ⟨c, hc⟩ := hu'.exists_right_inv
      have hcW : φ c ∈ W := (hW _).mpr ⟨c, rfl⟩
      refine IsUnit.of_mul_eq_one (⟨φ c, hcW⟩ : W) ?_
      apply Subtype.ext
      show ψ b * φ c = 1
      rw [← hφι, ← map_mul, hc, map_one]
  have hmax : ∀ (b : B) (hb : ψ b ∈ W),
      (⟨ψ b, hb⟩ : W) ∈ IsLocalRing.maximalIdeal W ↔ b ∈ M := by
    intro b hb
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hunit, not_not]
  have hWtop : W ≠ ⊤ := by
    intro hT
    obtain ⟨b, hbM, hb0⟩ := hM
    have hb : ψ b ∈ W := hmem b
    have hinv : (ψ b)⁻¹ ∈ W := by rw [hT]; exact ValuationSubring.mem_top _
    have hu : IsUnit (⟨ψ b, hb⟩ : W) := by
      refine IsUnit.of_mul_eq_one (⟨(ψ b)⁻¹, hinv⟩ : W) ?_
      apply Subtype.ext
      show ψ b * (ψ b)⁻¹ = 1
      exact mul_inv_cancel₀ hb0
    exact (hunit b hb).mp hu hbM
  have hrep : ∀ y ∈ W, ∃ b s : B, s ∉ M ∧ y * ψ s = ψ b := by
    intro y hy
    obtain ⟨c, rfl⟩ := (hW y).mp hy
    obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective M.primeCompl c
    exact ⟨b, s, Ideal.mem_primeCompl_iff.mp s.2, hmk b s⟩
  exact ⟨W, hWtop, hmem, hmax, hrep⟩

theorem wcpa_dj_fva_rn_generic_prime : ∀ (X : Scheme.{u}) (x : X),
    (∀ (ξ : X) (h : ξ ⤳ x),
      RingHom.ker (X.presheaf.stalkSpecializes h ≫ X.residue ξ).hom ∈
        minimalPrimes (X.presheaf.stalk x) →
      closure {ξ} ∈ irreducibleComponents X) ∧
    (∀ p : Ideal (X.presheaf.stalk x), p.IsPrime → ∃ (ξ : X) (h : ξ ⤳ x),
      RingHom.ker (X.presheaf.stalkSpecializes h ≫ X.residue ξ).hom = p) ∧
    (∀ (ξ ξ' : X) (h : ξ ⤳ x) (h' : ξ' ⤳ x),
      RingHom.ker (X.presheaf.stalkSpecializes h ≫ X.residue ξ).hom =
        RingHom.ker (X.presheaf.stalkSpecializes h' ≫ X.residue ξ').hom → ξ = ξ') ∧
    (∀ (ξ : X) (h : ξ ⤳ x), ξ ≠ x →
      RingHom.ker (X.presheaf.stalkSpecializes h ≫ X.residue ξ).hom ≠
        IsLocalRing.maximalIdeal (X.presheaf.stalk x)) ∧
    (∀ (ξ : X) (h : ξ ⤳ x) (y : X.residueField ξ), ∃ a s : X.presheaf.stalk x,
      (X.presheaf.stalkSpecializes h ≫ X.residue ξ).hom s ≠ 0 ∧
      y * (X.presheaf.stalkSpecializes h ≫ X.residue ξ).hom s =
        (X.presheaf.stalkSpecializes h ≫ X.residue ξ).hom a) :=
by
  intro X x

  have hK : ∀ (ξ : X) (h : ξ ⤳ x) (a : X.presheaf.stalk x),
      a ∈ RingHom.ker (X.presheaf.stalkSpecializes h ≫ X.residue ξ).hom ↔
        (X.presheaf.stalkSpecializes h).hom a ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk ξ) := by
    intro ξ h a
    rw [RingHom.mem_ker, CommRingCat.hom_comp, RingHom.comp_apply]
    exact IsLocalRing.residue_eq_zero_iff _

  have hgen : ∀ (q : PrimeSpectrum (X.presheaf.stalk x)), ∃ hsp : X.fromSpecStalk x q ⤳ x,
      ∀ a : X.presheaf.stalk x, (X.presheaf.stalkSpecializes hsp).hom a ∈
        IsLocalRing.maximalIdeal (X.presheaf.stalk (X.fromSpecStalk x q)) ↔ a ∈ q.asIdeal := by
    intro q
    have hsp : X.fromSpecStalk x q ⤳ x := by
      have h : X.fromSpecStalk x q ∈ Set.range (X.fromSpecStalk x) := ⟨q, rfl⟩
      rwa [Scheme.range_fromSpecStalk] at h
    refine ⟨hsp, fun a => ?_⟩
    have key : (Spec.map (X.presheaf.stalkSpecializes hsp))
        (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x q))) = q := by
      apply (X.fromSpecStalk x).isEmbedding.injective
      first
      | (have e := congrArg (fun k : Spec (X.presheaf.stalk (X.fromSpecStalk x q)) ⟶ X =>
            k (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x q))))
            (Scheme.SpecMap_stalkSpecializes_fromSpecStalk hsp)
         simp only [Scheme.Hom.comp_apply] at e
         rw [e, Scheme.fromSpecStalk_closedPoint])
      | (show (Spec.map (X.presheaf.stalkSpecializes hsp) ≫ X.fromSpecStalk x)
            (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x q))) = _
         rw [Scheme.SpecMap_stalkSpecializes_fromSpecStalk, Scheme.fromSpecStalk_closedPoint])
    have h2 : a ∈ q.asIdeal ↔ a ∈ ((Spec.map (X.presheaf.stalkSpecializes hsp))
        (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x q)))).asIdeal := by
      rw [key]
    rw [h2]
    exact Iff.rfl

  have hc0 : ∀ (ξ : X) (h : ξ ⤳ x), ∃ p : PrimeSpectrum (X.presheaf.stalk x),
      X.fromSpecStalk x p = ξ ∧
        RingHom.ker (X.presheaf.stalkSpecializes h ≫ X.residue ξ).hom = p.asIdeal := by
    intro ξ h
    have hr : ξ ∈ Set.range (X.fromSpecStalk x) := by
      rw [Scheme.range_fromSpecStalk]; exact h
    obtain ⟨p, hp⟩ := hr
    subst hp
    obtain ⟨hsp, hiff⟩ := hgen p
    refine ⟨p, rfl, ?_⟩
    ext a
    rw [hK]
    exact hiff a

  have pb : ∀ p : Ideal (X.presheaf.stalk x), p.IsPrime → ∃ (ξ : X) (h : ξ ⤳ x),
      RingHom.ker (X.presheaf.stalkSpecializes h ≫ X.residue ξ).hom = p := by
    intro p hp
    obtain ⟨hsp, hiff⟩ := hgen ⟨p, hp⟩
    refine ⟨_, hsp, ?_⟩
    ext a
    rw [hK]
    exact hiff a

  have pc : ∀ (ξ ξ' : X) (h : ξ ⤳ x) (h' : ξ' ⤳ x),
      RingHom.ker (X.presheaf.stalkSpecializes h ≫ X.residue ξ).hom =
        RingHom.ker (X.presheaf.stalkSpecializes h' ≫ X.residue ξ').hom → ξ = ξ' := by
    intro ξ ξ' h h' e
    obtain ⟨p, hpξ, hk⟩ := hc0 ξ h
    obtain ⟨p', hpξ', hk'⟩ := hc0 ξ' h'
    have hpp : p = p' := PrimeSpectrum.ext (hk.symm.trans (e.trans hk'))
    rw [← hpξ, ← hpξ', hpp]

  have pd : ∀ (ξ : X) (h : ξ ⤳ x), ξ ≠ x →
      RingHom.ker (X.presheaf.stalkSpecializes h ≫ X.residue ξ).hom ≠
        IsLocalRing.maximalIdeal (X.presheaf.stalk x) := by
    intro ξ h hne e
    obtain ⟨p, hpξ, hk⟩ := hc0 ξ h
    have hp : p = IsLocalRing.closedPoint (X.presheaf.stalk x) :=
      PrimeSpectrum.ext (hk.symm.trans e)
    apply hne
    rw [← hpξ, hp, Scheme.fromSpecStalk_closedPoint]

  have pa : ∀ (ξ : X) (h : ξ ⤳ x),
      RingHom.ker (X.presheaf.stalkSpecializes h ≫ X.residue ξ).hom ∈
        minimalPrimes (X.presheaf.stalk x) →
      closure {ξ} ∈ irreducibleComponents X := by
    intro ξ h hm
    obtain ⟨Y, hY, hξY⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible (closure {ξ})
      isIrreducible_singleton.closure
    have hYcl : IsClosed Y := isClosed_of_mem_irreducibleComponents Y hY
    have hYirr : IsIrreducible Y := hY.prop
    obtain ⟨ζ, hζdef⟩ : ∃ ζ : X, ζ = hYirr.genericPoint := ⟨_, rfl⟩
    have hζY : closure {ζ} = Y := by
      have := hYirr.isGenericPoint_genericPoint_closure
      rw [hYcl.closure_eq] at this
      rw [hζdef]
      exact isGenericPoint_def.mp this
    have hζξ : ζ ⤳ ξ := specializes_iff_mem_closure.mpr
      (by rw [hζY]; exact hξY (subset_closure (Set.mem_singleton ξ)))
    have hζx : ζ ⤳ x := hζξ.trans h
    have hle : RingHom.ker (X.presheaf.stalkSpecializes hζx ≫ X.residue ζ).hom ≤
        RingHom.ker (X.presheaf.stalkSpecializes h ≫ X.residue ξ).hom := by
      intro a ha
      by_contra hna
      rw [hK] at hna ha
      have hu : IsUnit ((X.presheaf.stalkSpecializes h).hom a) := by
        by_contra hnu
        exact hna ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu))
      have hcomp : (X.presheaf.stalkSpecializes hζx).hom a =
          (X.presheaf.stalkSpecializes hζξ).hom ((X.presheaf.stalkSpecializes h).hom a) := by
        rw [← RingHom.comp_apply, ← CommRingCat.hom_comp,
          TopCat.Presheaf.stalkSpecializes_comp]
      have hu2 := hu.map (X.presheaf.stalkSpecializes hζξ).hom
      rw [← hcomp] at hu2
      exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp ha) hu2
    have heq : RingHom.ker (X.presheaf.stalkSpecializes hζx ≫ X.residue ζ).hom =
        RingHom.ker (X.presheaf.stalkSpecializes h ≫ X.residue ξ).hom :=
      le_antisymm hle (hm.2 ⟨RingHom.ker_isPrime _, bot_le⟩ hle)
    have hζeq : ζ = ξ := pc ζ ξ hζx h heq
    rw [← hζeq, hζY]
    exact hY

  have pe : ∀ (ξ : X) (h : ξ ⤳ x) (y : X.residueField ξ), ∃ a s : X.presheaf.stalk x,
      (X.presheaf.stalkSpecializes h ≫ X.residue ξ).hom s ≠ 0 ∧
      y * (X.presheaf.stalkSpecializes h ≫ X.residue ξ).hom s =
        (X.presheaf.stalkSpecializes h ≫ X.residue ξ).hom a := by
    intro ξ h y
    have hlocal : ∀ (x z : X) (h : x ⤳ z),
        letI := (X.presheaf.stalkSpecializes h).hom.toAlgebra
        IsLocalization.AtPrime (X.presheaf.stalk x)
          ((IsLocalRing.maximalIdeal (X.presheaf.stalk x)).comap
            (X.presheaf.stalkSpecializes h).hom) := by
      intro x z h
      have key : ∀ (A R S : Type u) [CommRing A] [CommRing R] [CommRing S] [IsLocalRing S]
          (gR : A →+* R) (gS : A →+* S) (φ : R →+* S), φ.comp gR = gS →
          ∀ (P Q : Ideal A) [P.IsPrime] [Q.IsPrime],
          @IsLocalization.AtPrime A _ R _ gR.toAlgebra P _ →
          @IsLocalization.AtPrime A _ S _ gS.toAlgebra Q _ →
          letI := φ.toAlgebra; IsLocalization.AtPrime S ((IsLocalRing.maximalIdeal S).comap φ) := by
        intro A R S _ _ _ _ gR gS φ hcomp P Q _ _ hR hS
        letI : Algebra A R := gR.toAlgebra
        letI : Algebra A S := gS.toAlgebra
        letI : Algebra R S := φ.toAlgebra
        have hc : ∀ a, φ (gR a) = gS a := fun a => by rw [← hcomp]; rfl
        haveI : IsScalarTower A R S := IsScalarTower.of_algebraMap_eq (fun a => (hc a).symm)
        have hle : P.primeCompl ≤ Q.primeCompl := by
          intro a ha haQ
          have hu : IsUnit (gR a) := IsLocalization.map_units R (⟨a, ha⟩ : P.primeCompl)
          have hu' : IsUnit (gS a) := hc a ▸ hu.map φ
          have hm : gS a ∈ IsLocalRing.maximalIdeal S := by
            rw [← IsLocalization.AtPrime.map_eq_maximalIdeal Q S]
            exact Ideal.mem_map_of_mem _ haQ
          exact (IsLocalRing.notMem_maximalIdeal.mpr hu') hm
        haveI := IsLocalization.isLocalization_of_submonoid_le R S P.primeCompl Q.primeCompl hle
        show IsLocalization _ S
        refine IsLocalization.of_le (Submonoid.map (algebraMap A R) Q.primeCompl) _ ?_ ?_
        · rintro _ ⟨a, ha, rfl⟩
          show φ (gR a) ∉ IsLocalRing.maximalIdeal S
          rw [hc a]
          exact IsLocalRing.notMem_maximalIdeal.mpr
            (IsLocalization.map_units S (⟨a, ha⟩ : Q.primeCompl))
        · intro r hr
          exact IsLocalRing.notMem_maximalIdeal.mp hr
      obtain ⟨W, hW, hzW, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z) (U := ⊤) trivial
      have hxW : x ∈ W := h.mem_open W.isOpen hzW
      have hLz := hW.isLocalization_stalk ⟨z, hzW⟩
      have hLx := hW.isLocalization_stalk ⟨x, hxW⟩
      have hcomp : (X.presheaf.stalkSpecializes h).hom.comp (X.presheaf.germ W z hzW).hom =
          (X.presheaf.germ W x hxW).hom := by
        rw [← CommRingCat.hom_comp, TopCat.Presheaf.germ_stalkSpecializes]
      exact key Γ(X, W) _ _ _ _ _ hcomp _ _ hLz hLx
    letI := (X.presheaf.stalkSpecializes h).hom.toAlgebra
    haveI := hlocal ξ x h
    obtain ⟨z, hz⟩ := X.residue_surjective ξ y
    obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj
      ((IsLocalRing.maximalIdeal (X.presheaf.stalk ξ)).comap
        (X.presheaf.stalkSpecializes h).hom).primeCompl z
    refine ⟨a, s, ?_, ?_⟩
    · intro h0
      rw [CommRingCat.hom_comp, RingHom.comp_apply] at h0
      exact s.2 ((IsLocalRing.residue_eq_zero_iff _).mp h0)
    · rw [← hz, CommRingCat.hom_comp, RingHom.comp_apply, RingHom.comp_apply, ← map_mul]
      exact congrArg (X.residue ξ).hom hs
  exact ⟨pa, pb, pc, pd, pe⟩

theorem wcpa_dj_fva_rn_patch : ∀ (B : Type u) [CommRing B] (ι : Type u) [Finite ι]
    (κ : ι → Type u) [∀ i, Field (κ i)] (ψ : ∀ i, B →+* κ i) (y : ∀ i, κ i),
    (∀ M : Ideal B, M.IsMaximal → ∀ i i', RingHom.ker (ψ i) ≤ M → RingHom.ker (ψ i') ≤ M → i = i') →
    (∀ M : Ideal B, M.IsMaximal → ∀ i, RingHom.ker (ψ i) ≤ M →
      ∃ s b : B, s ∉ M ∧ ψ i b = ψ i s * y i) →
    ∃ b : B, ∀ i, ψ i b = y i :=
by
  intro B _ ι _ κ _ ψ y H1 H2
  have hloc : ∀ i, ∃ c : B, ψ i c = y i := by
    intro i
    let J : Ideal B :=
      { carrier := {s | ∃ b, ψ i b = ψ i s * y i}
        zero_mem' := ⟨0, by simp⟩
        add_mem' := by
          rintro s s' ⟨b, hb⟩ ⟨b', hb'⟩
          exact ⟨b + b', by rw [map_add, map_add, hb, hb', add_mul]⟩
        smul_mem' := by
          rintro r s ⟨b, hb⟩
          exact ⟨r * b, by rw [smul_eq_mul, map_mul, map_mul, hb, mul_assoc]⟩ }
    have hker : RingHom.ker (ψ i) ≤ J := by
      intro s hs
      refine ⟨0, ?_⟩
      rw [RingHom.mem_ker] at hs
      rw [hs, map_zero, zero_mul]
    have htop : J = ⊤ := by
      by_contra hne
      obtain ⟨M, hM, hJM⟩ := Ideal.exists_le_maximal J hne
      obtain ⟨s, b, hsM, hb⟩ := H2 M hM i (hker.trans hJM)
      exact hsM (hJM ⟨b, hb⟩)
    have h1 : (1 : B) ∈ J := by rw [htop]; exact Submodule.mem_top
    obtain ⟨c, hc⟩ := h1
    exact ⟨c, by rw [hc, map_one, one_mul]⟩
  choose c hc using hloc
  have hcop : Pairwise (Function.onFun IsCoprime (fun i => RingHom.ker (ψ i))) := by
    intro i j hij
    show IsCoprime (RingHom.ker (ψ i)) (RingHom.ker (ψ j))
    rw [Ideal.isCoprime_iff_sup_eq]
    by_contra h
    obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ h
    exact hij (H1 M hM i j (le_sup_left.trans hle) (le_sup_right.trans hle))
  obtain ⟨r, hr⟩ := Ideal.exists_forall_sub_mem_ideal hcop c
  refine ⟨r, fun i => ?_⟩
  rw [← hc i]
  exact (RingHom.sub_mem_ker_iff (ψ i)).mp (hr i)

theorem wcpa_dj_fva_gg_realize_node : ∀ (K : Type u) [Field K] [IsAlgClosed K]
    (C : Scheme.{u}) (q : C ⟶ Spec (.of K)), wcpaDjSemistable q →
    ∀ x : C, IsClosed ({x} : Set C) →
    (¬ ∃ W : C.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q)) →
    ∀ f : ∀ ξ : C, C.residueField ξ,
    (∀ β, wcpaDjPsBr q x β → wcpaDjPsInPow β.2 (f β.1) 0) →
    ((∃ c : K, ∀ β, wcpaDjPsBr q x β →
        wcpaDjPsInPow β.2 (f β.1 - wcpaDjPsK q β.1 c) 1) ∨
      (∀ β β', wcpaDjPsBr q x β → wcpaDjPsBr q x β' → β = β')) →
    ∃ h : C.presheaf.stalk x, ∀ ξ : C, closure {ξ} ∈ irreducibleComponents C → ξ ⤳ x →
      wcpaDjPsSp x ξ h = f ξ :=
by
  intro K _ _ C q hss x hx hsm f hR1 hR2
  classical

  obtain ⟨B, _, j, χ₀, χ₁, hNoeth, hdim, hjinj, hjfin, hnorm, hmin, hloc, h0, h1, hne, hsep⟩ :=
    wcpa_dj_fva_rn_node_package K C q hss x hx hsm
  haveI := hNoeth
  obtain ⟨L4a, L4b, L4c, L4d, L4e⟩ := wcpa_dj_fva_rn_generic_prime C x
  obtain ⟨φx, hφx⟩ : ∃ φ : K →+* C.presheaf.stalk x,
      φ = ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ x trivial).hom :=
    ⟨_, rfl⟩
  have h0' : χ₀.comp (j.comp φx) = RingHom.id K := by rw [hφx]; exact h0
  have h1' : χ₁.comp (j.comp φx) = RingHom.id K := by rw [hφx]; exact h1
  obtain ⟨ψ, hψ⟩ : ∃ ψ : ∀ ξ : C, ξ ⤳ x → (C.presheaf.stalk x →+* C.residueField ξ),
      ∀ (ξ : C) (h : ξ ⤳ x), ψ ξ h = (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom :=
    ⟨fun ξ h => (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom, fun _ _ => rfl⟩
  have sp_eq : ∀ (ξ : C) (h : ξ ⤳ x) (g : C.presheaf.stalk x),
      wcpaDjPsSp x ξ g = ψ ξ h g := by
    intro ξ h g
    rw [hψ]
    unfold wcpaDjPsSp
    rw [dif_pos h]
  have K_eq : ∀ (ξ : C) (h : ξ ⤳ x) (c : K), wcpaDjPsK q ξ c = ψ ξ h (φx c) := by
    intro ξ h c
    rw [hψ, hφx]
    unfold wcpaDjPsK
    rw [← TopCat.Presheaf.germ_stalkSpecializes C.presheaf (U := ⊤) (y := x) trivial h]
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, Category.assoc]
  have L4a' : ∀ (ξ : C) (h : ξ ⤳ x), RingHom.ker (ψ ξ h) ∈ minimalPrimes (C.presheaf.stalk x) →
      closure {ξ} ∈ irreducibleComponents C := by
    intro ξ h hm
    rw [hψ] at hm
    exact L4a ξ h hm
  have L4b' : ∀ p : Ideal (C.presheaf.stalk x), p.IsPrime → ∃ (ξ : C) (h : ξ ⤳ x),
      RingHom.ker (ψ ξ h) = p := by
    intro p hp
    obtain ⟨ξ, h, e⟩ := L4b p hp
    exact ⟨ξ, h, by rw [hψ]; exact e⟩
  have L4c' : ∀ (ξ ξ' : C) (h : ξ ⤳ x) (h' : ξ' ⤳ x),
      RingHom.ker (ψ ξ h) = RingHom.ker (ψ ξ' h') → ξ = ξ' := by
    intro ξ ξ' h h' e
    rw [hψ, hψ] at e
    exact L4c ξ ξ' h h' e
  have L4d' : ∀ (ξ : C) (h : ξ ⤳ x), ξ ≠ x →
      RingHom.ker (ψ ξ h) ≠ IsLocalRing.maximalIdeal (C.presheaf.stalk x) := by
    intro ξ h hne'
    rw [hψ]
    exact L4d ξ h hne'
  have L4e' : ∀ (ξ : C) (h : ξ ⤳ x) (y : C.residueField ξ), ∃ a s : C.presheaf.stalk x,
      ψ ξ h s ≠ 0 ∧ y * ψ ξ h s = ψ ξ h a := by
    intro ξ h y
    obtain ⟨a, s, hs, e⟩ := L4e ξ h y
    exact ⟨a, s, by rw [hψ]; exact hs, by rw [hψ]; exact e⟩
  have gen_ne : ∀ ξ : C, closure {ξ} ∈ irreducibleComponents C → ξ ≠ x := by
    intro ξ hξ hξx
    exact (wcpa_dj_lsp_generic_smooth K C q hss ξ hξ).1 (by rw [hξx]; exact hx)

  obtain ⟨S, memS⟩ : ∃ S : Set C, ∀ ξ : C,
      ξ ∈ S ↔ (closure {ξ} ∈ irreducibleComponents C ∧ ξ ⤳ x) :=
    ⟨{ξ | closure {ξ} ∈ irreducibleComponents C ∧ ξ ⤳ x}, fun ξ => Iff.rfl⟩
  have iS1 : ∀ i : S, closure {i.1} ∈ irreducibleComponents C := fun i => ((memS i.1).mp i.2).1
  have iS2 : ∀ i : S, i.1 ⤳ x := fun i => ((memS i.1).mp i.2).2
  haveI hSfin : Finite S :=
    ((wcpa_dj_fva_ss_branch_basics K C q hss).1.subset (fun ξ hξ => ((memS ξ).mp hξ).1)).to_subtype

  have hlift : ∀ i : S, ∃ ψ' : B →+* C.residueField i.1, ψ'.comp j = ψ i.1 (iS2 i) ∧
      ∀ Q : Ideal B, Q.IsPrime → Ideal.comap j Q = RingHom.ker (ψ i.1 (iS2 i)) →
        Q = RingHom.ker ψ' := by
    intro i
    apply wcpa_dj_fva_rn_ext_lift (C.presheaf.stalk x) B (C.residueField i.1) j (ψ i.1 (iS2 i))
      hjinj
    intro b
    have hprime : (RingHom.ker (ψ i.1 (iS2 i))).IsPrime := RingHom.ker_isPrime _
    have hnm : RingHom.ker (ψ i.1 (iS2 i)) ≠ IsLocalRing.maximalIdeal (C.presheaf.stalk x) :=
      L4d' i.1 (iS2 i) (gen_ne i.1 (iS1 i))
    obtain ⟨g, a, hg, ha⟩ := hloc _ hprime hnm b
    exact ⟨g, a, fun h00 => hg (RingHom.mem_ker.mpr h00), ha⟩
  choose ψt hψtj hψtu using hlift
  have hψtj' : ∀ (i : S) (a : C.presheaf.stalk x), ψt i (j a) = ψ i.1 (iS2 i) a :=
    fun i a => RingHom.congr_fun (hψtj i) a
  have hKer : ∀ i : S, Ideal.comap j (RingHom.ker (ψt i)) = RingHom.ker (ψ i.1 (iS2 i)) := by
    intro i
    rw [RingHom.comap_ker, hψtj i]
  have hKerP : ∀ i : S, (RingHom.ker (ψt i)).IsPrime := fun i => RingHom.ker_isPrime _
  have hKerNe : ∀ i : S,
      Ideal.comap j (RingHom.ker (ψt i)) ≠ IsLocalRing.maximalIdeal (C.presheaf.stalk x) := by
    intro i
    rw [hKer i]
    exact L4d' i.1 (iS2 i) (gen_ne i.1 (iS1 i))

  have hloc3 : ∀ (i : S) (M : Ideal B) [M.IsMaximal], RingHom.ker (ψt i) ≤ M →
      ∃ W : ValuationSubring (C.residueField i.1),
        wcpaDjPsBr q x ⟨i.1, W⟩ ∧
        (∀ b : B, b ∈ RingHom.ker (ψt i) ↔ algebraMap B (Localization.AtPrime M) b = 0) ∧
        (∀ (b : B) (hb : ψt i b ∈ W),
          (⟨ψt i b, hb⟩ : W) ∈ IsLocalRing.maximalIdeal W ↔ b ∈ M) ∧
        (∀ b : B, ψt i b ∈ W) ∧
        (∀ y ∈ W, ∃ b s : B, s ∉ M ∧ y * ψt i s = ψt i b) := by
    intro i M _ hle
    haveI := hKerP i
    obtain ⟨hdvd, hQ0, hMA, b₁, hb₁M, hb₁Q⟩ :=
      wcpa_dj_fva_rn_loc_valuation (C.presheaf.stalk x) B j hjfin hdim hnorm
        (RingHom.ker (ψt i)) M hle (hKerNe i)
    have hfrac : ∀ y : C.residueField i.1, ∃ a s : B, ψt i s ≠ 0 ∧ y * ψt i s = ψt i a := by
      intro y
      obtain ⟨a, s, hs, hys⟩ := L4e' i.1 (iS2 i) y
      refine ⟨j a, j s, ?_, ?_⟩
      · rw [hψtj' i]; exact hs
      · rw [hψtj' i, hψtj' i]; exact hys
    obtain ⟨W, hWtop, hWmem, hWmax, hWrep⟩ :=
      wcpa_dj_fva_rn_branch_ring B (C.residueField i.1) (ψt i) M hdvd hle
        (fun b hb => (hQ0 b).mp (RingHom.mem_ker.mpr hb)) hfrac
        ⟨b₁, hb₁M, fun h00 => hb₁Q (RingHom.mem_ker.mpr h00)⟩
    have hbr : wcpaDjPsBr q x ⟨i.1, W⟩ := by
      unfold wcpaDjPsBr
      dsimp only
      refine ⟨iS1 i, hWtop, ?_, iS2 i, ?_, ?_⟩
      · intro c
        rw [K_eq i.1 (iS2 i) c, ← hψtj' i]
        exact hWmem _
      · intro g
        rw [sp_eq i.1 (iS2 i) g, ← hψtj' i]
        unfold wcpaDjPsInPow
        refine ⟨hWmem _, ?_⟩
        rw [pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
      · intro g hg
        rw [sp_eq i.1 (iS2 i) g, ← hψtj' i]
        unfold wcpaDjPsInPow
        refine ⟨hWmem _, ?_⟩
        rw [pow_one]
        refine (hWmax (j g) (hWmem _)).mpr ?_
        rw [← hMA] at hg
        exact hg
    exact ⟨W, hbr, hQ0, hWmax, hWmem, hWrep⟩

  have H1 : ∀ M : Ideal B, M.IsMaximal → ∀ i i' : S,
      RingHom.ker (ψt i) ≤ M → RingHom.ker (ψt i') ≤ M → i = i' := by
    intro M hM i i' hi hi'
    haveI := hM
    obtain ⟨_, _, hQ, -⟩ := hloc3 i M hi
    obtain ⟨_, _, hQ', -⟩ := hloc3 i' M hi'
    have hk : RingHom.ker (ψt i) = RingHom.ker (ψt i') := by
      ext b
      rw [hQ b, hQ' b]
    have hk' : RingHom.ker (ψ i.1 (iS2 i)) = RingHom.ker (ψ i'.1 (iS2 i')) := by
      rw [← hKer i, ← hKer i', hk]
    exact Subtype.ext (L4c' i.1 i'.1 (iS2 i) (iS2 i') hk')
  have H2 : ∀ M : Ideal B, M.IsMaximal → ∀ i : S, RingHom.ker (ψt i) ≤ M →
      ∃ s b : B, s ∉ M ∧ ψt i b = ψt i s * f i.1 := by
    intro M hM i hi
    haveI := hM
    obtain ⟨W, hbr, -, -, -, hWrep⟩ := hloc3 i M hi
    have h00 : wcpaDjPsInPow W (f i.1) 0 := hR1 ⟨i.1, W⟩ hbr
    unfold wcpaDjPsInPow at h00
    obtain ⟨hfW, -⟩ := h00
    obtain ⟨b, s, hs, hbs⟩ := hWrep (f i.1) hfW
    exact ⟨s, b, hs, by rw [← hbs]; ring⟩
  obtain ⟨b₀, hb₀⟩ := wcpa_dj_fva_rn_patch B S (fun i : S => (C.residueField i.1 : Type u)) ψt
    (fun i : S => f i.1) H1 H2
  have hb₀' : ∀ i : S, ψt i b₀ = f i.1 := fun i => hb₀ i

  have hcentre : ∀ χ : B →+* K, χ.comp (j.comp φx) = RingHom.id K →
      ∃ (i : S) (W : ValuationSubring (C.residueField i.1)), wcpaDjPsBr q x ⟨i.1, W⟩ ∧
        (∀ b : B, ψt i b ∈ W) ∧
        ∀ (b : B) (hb : ψt i b ∈ W),
          (⟨ψt i b, hb⟩ : W) ∈ IsLocalRing.maximalIdeal W ↔ b ∈ RingHom.ker χ := by
    intro χ hχ
    have hsurj : Function.Surjective χ := fun k => ⟨j (φx k), RingHom.congr_fun hχ k⟩
    haveI hMax : (RingHom.ker χ).IsMaximal := RingHom.ker_isMaximal_of_surjective χ hsurj
    obtain ⟨Q, hQmin, hQle⟩ :=
      Ideal.exists_minimalPrimes_le (I := (⊥ : Ideal B)) (J := RingHom.ker χ) bot_le
    have hQmin' : Q ∈ minimalPrimes B := hQmin
    haveI hQp : Q.IsPrime := Ideal.minimalPrimes_isPrime hQmin'
    have hpne := hmin Q hQmin'
    have hpp : (Ideal.comap j Q).IsPrime := inferInstance
    have hKD : Ring.KrullDimLE 1 (C.presheaf.stalk x) := Ring.krullDimLE_iff.mpr (by exact_mod_cast hdim)
    have hpmin : Ideal.comap j Q ∈ minimalPrimes (C.presheaf.stalk x) := by
      rcases Ring.krullDimLE_one_iff.mp hKD _ hpp with h | h
      · exact h
      · exact absurd (IsLocalRing.eq_maximalIdeal h) hpne
    obtain ⟨ξ, hξx, hker⟩ := L4b' _ hpp
    have hξ : closure {ξ} ∈ irreducibleComponents C := L4a' ξ hξx (by rw [hker]; exact hpmin)
    obtain ⟨i, hi⟩ : ∃ i : S, i.1 = ξ := ⟨⟨ξ, (memS ξ).mpr ⟨hξ, hξx⟩⟩, rfl⟩
    subst hi
    have hker' : Ideal.comap j Q = RingHom.ker (ψ i.1 (iS2 i)) := hker.symm
    have hQi : Q = RingHom.ker (ψt i) := hψtu i Q hQp hker'
    have hle : RingHom.ker (ψt i) ≤ RingHom.ker χ := by rw [← hQi]; exact hQle
    obtain ⟨W, hbr, -, hWmax, hWmem, -⟩ := hloc3 i (RingHom.ker χ) hle
    exact ⟨i, W, hbr, hWmem, hWmax⟩
  obtain ⟨i₀, W₀, hbr₀, hm₀, hW₀⟩ := hcentre χ₀ h0'
  obtain ⟨i₁, W₁, hbr₁, hm₁, hW₁⟩ := hcentre χ₁ h1'

  have hb₀eq : χ₀ b₀ = χ₁ b₀ := by
    rcases hR2 with ⟨c, hc⟩ | hle
    · have key : ∀ χ : B →+* K, χ.comp (j.comp φx) = RingHom.id K →
          ∀ (i : S) (W : ValuationSubring (C.residueField i.1)), wcpaDjPsBr q x ⟨i.1, W⟩ →
          (∀ (b : B) (hb : ψt i b ∈ W),
            (⟨ψt i b, hb⟩ : W) ∈ IsLocalRing.maximalIdeal W ↔ b ∈ RingHom.ker χ) →
          χ b₀ = c := by
        intro χ hχ i W hbr hW
        have h1c : wcpaDjPsInPow W (f i.1 - wcpaDjPsK q i.1 c) 1 := hc ⟨i.1, W⟩ hbr
        have e : f i.1 - wcpaDjPsK q i.1 c = ψt i (b₀ - j (φx c)) := by
          rw [map_sub, hb₀' i, hψtj' i, K_eq i.1 (iS2 i) c]
        rw [e] at h1c
        unfold wcpaDjPsInPow at h1c
        obtain ⟨hmW, hmax⟩ := h1c
        rw [pow_one] at hmax
        have hb := (hW _ hmW).mp hmax
        rw [RingHom.mem_ker, map_sub, sub_eq_zero] at hb
        rw [hb]
        exact RingHom.congr_fun hχ c
      rw [key χ₀ h0' i₀ W₀ hbr₀ hW₀, key χ₁ h1' i₁ W₁ hbr₁ hW₁]
    · exfalso
      have heq := hle ⟨i₀.1, W₀⟩ ⟨i₁.1, W₁⟩ hbr₀ hbr₁
      rw [Sigma.mk.inj_iff] at heq
      obtain ⟨h01, hW01⟩ := heq
      have hi : i₀ = i₁ := Subtype.ext h01
      subst hi
      have hW : W₀ = W₁ := eq_of_heq hW01
      subst hW
      apply hne
      ext b
      exact (hW₀ b (hm₀ b)).symm.trans (hW₁ b (hm₁ b))
  obtain ⟨a, ha⟩ := (hsep b₀).mpr hb₀eq

  refine ⟨a, fun ξ hξ hξx => ?_⟩
  have hiS : ξ ∈ S := (memS ξ).mpr ⟨hξ, hξx⟩
  have e1 := hψtj' ⟨ξ, hiS⟩ a
  rw [ha, hb₀'] at e1
  rw [sp_eq ξ hξx a]
  exact e1.symm

theorem wcpa_dj_fva_ss_glue_germs : ∀ (K : Type u) [Field K] [IsAlgClosed K]
    (C : Scheme.{u}) (q : C ⟶ Spec (.of K)) (L : wcpaDjCoc C),
    wcpaDjSemistable q → wcpaDjCocOK L →
    ∀ (ch : C → Fin L.m), (∀ x : C, x ∈ L.V (ch x)) →
    ∀ (e : ℕ) (u : ∀ ξ : C, C.residueField ξ),
    (∀ x : C, IsClosed ({x} : Set C) → ∀ β, wcpaDjPsBr q x β →
      wcpaDjPsInPow β.2 (wcpaDjPsTw L (ch β.1) (ch x) β.1 ^ e * u β.1) 0) →
    (∀ x : C, IsClosed ({x} : Set C) →
      (∃ c : K, ∀ β, wcpaDjPsBr q x β →
        wcpaDjPsInPow β.2 (wcpaDjPsTw L (ch β.1) (ch x) β.1 ^ e * u β.1 - wcpaDjPsK q β.1 c) 1) ∨
      (∀ β β', wcpaDjPsBr q x β → wcpaDjPsBr q x β' → β = β')) →
    ∃ s : ∀ a : Fin L.m, Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤), wcpaDjCocSec q L e s ∧
      ∀ (x : C), IsClosed ({x} : Set C) → ∀ (b : Fin L.m) (hx : x ∈ L.V b ⊓ q ⁻¹ᵁ ⊤),
        ((C.presheaf.germ (L.V b ⊓ q ⁻¹ᵁ ⊤) x hx).hom (s b) ∈
            IsLocalRing.maximalIdeal (C.presheaf.stalk x) ↔
          ∀ β, wcpaDjPsBr q x β →
            wcpaDjPsInPow β.2 (wcpaDjPsTw L (ch β.1) (ch x) β.1 ^ e * u β.1) 1) ∧
        ∀ β, wcpaDjPsBr q x β → ∀ k : ℕ,
          (wcpaDjPsInPow β.2
              (wcpaDjPsSp x β.1 ((C.presheaf.germ (L.V b ⊓ q ⁻¹ᵁ ⊤) x hx).hom (s b))) k ↔
            wcpaDjPsInPow β.2 (wcpaDjPsTw L (ch β.1) (ch x) β.1 ^ e * u β.1) k) :=
by
  intro K _ _ C q L hss hOK ch hch e u hreg hmatch
  classical
  haveI : IsProper q := hss.2.1
  haveI : LocallyOfFiniteType q := inferInstance
  haveI hJ : JacobsonSpace C := LocallyOfFiniteType.jacobsonSpace q
  haveI hred : AlgebraicGeometry.IsReduced C :=
    (wcpa_dj_lgs_reduced_dense K (Spec (.of K)) (𝟙 _) inferInstance C q hss).1
  obtain ⟨hGfin, -, hBrEx, -⟩ := wcpa_dj_fva_ss_branch_basics K C q hss

  have ip_mem : ∀ {F : Type u} [Field F] (V : ValuationSubring F) (f : F) (n : ℕ),
      wcpaDjPsInPow V f n → f ∈ V := by
    intro F _ V f n h
    unfold wcpaDjPsInPow at h
    obtain ⟨h, -⟩ := h
    exact h
  have ip_one : ∀ {F : Type u} [Field F] (V : ValuationSubring F), ¬ wcpaDjPsInPow V 1 1 := by
    intro F _ V h
    unfold wcpaDjPsInPow at h
    obtain ⟨h, h'⟩ := h
    rw [pow_one] at h'
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h') isUnit_one

  have inpow_mul : ∀ {F : Type u} [Field F] (V : ValuationSubring F) (ρ y : F), ρ ∈ V →
      ∀ k : ℕ, wcpaDjPsInPow V y k → wcpaDjPsInPow V (ρ * y) k := by
    intro F _ V ρ y hρ k h
    unfold wcpaDjPsInPow at h ⊢
    obtain ⟨hy, hm⟩ := h
    refine ⟨mul_mem hρ hy, ?_⟩
    have hprod : (⟨ρ * y, mul_mem hρ hy⟩ : V) = ⟨ρ, hρ⟩ * ⟨y, hy⟩ := rfl
    rw [hprod]
    exact Ideal.mul_mem_left _ _ hm
  have inpow_unit : ∀ {F : Type u} [Field F] (V : ValuationSubring F) (ρ ρ' y : F),
      ρ ∈ V → ρ' ∈ V → ρ * ρ' = 1 →
      ∀ k : ℕ, wcpaDjPsInPow V (ρ * y) k ↔ wcpaDjPsInPow V y k := by
    intro F _ V ρ ρ' y hρ hρ' h1 k
    constructor
    · intro h
      have h2 := inpow_mul V ρ' (ρ * y) hρ' k h
      rwa [← mul_assoc, mul_comm ρ' ρ, h1, one_mul] at h2
    · exact inpow_mul V ρ y hρ k

  have sp_eq : ∀ (x ξ : C) (h : ξ ⤳ x) (g : C.presheaf.stalk x),
      wcpaDjPsSp x ξ g = (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom g := by
    intro x ξ h g
    unfold wcpaDjPsSp
    rw [dif_pos h]
  have sp_germ : ∀ (x ξ : C) (h : ξ ⤳ x) (O : C.Opens) (t : Γ(C, O)) (hx : x ∈ O),
      wcpaDjPsSp x ξ ((C.presheaf.germ O x hx).hom t) =
        (C.presheaf.germ O ξ (h.mem_open O.isOpen hx) ≫ C.residue ξ).hom t := by
    intro x ξ h O t hx
    rw [sp_eq x ξ h, ← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Category.assoc,
      TopCat.Presheaf.germ_stalkSpecializes]
  have res_eq : ∀ (O : C.Opens) (ξ : C) (hξ : ξ ∈ O) (t : Γ(C, O)),
      wcpaDjPsRes O ξ t = (C.presheaf.germ O ξ hξ ≫ C.residue ξ).hom t := by
    intro O ξ hξ t
    unfold wcpaDjPsRes
    rw [dif_pos hξ]
  have germ_res : ∀ (O O' : C.Opens) (hle : O' ≤ O) (ξ : C) (hξ : ξ ∈ O') (t : Γ(C, O)),
      (C.presheaf.germ O' ξ hξ ≫ C.residue ξ).hom ((C.presheaf.map (homOfLE hle).op).hom t) =
        (C.presheaf.germ O ξ (hle hξ) ≫ C.residue ξ).hom t := by
    intro O O' hle ξ hξ t
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Category.assoc, TopCat.Presheaf.germ_res]

  have tw_coc : ∀ (a b c : Fin L.m) (ξ : C), ξ ∈ L.V a → ξ ∈ L.V b → ξ ∈ L.V c →
      wcpaDjPsTw L a b ξ * wcpaDjPsTw L b c ξ = wcpaDjPsTw L a c ξ := by
    intro a b c ξ ha hb hc
    have hm : ξ ∈ L.V a ⊓ L.V b ⊓ L.V c :=
      TopologicalSpace.Opens.mem_inf.mpr ⟨TopologicalSpace.Opens.mem_inf.mpr ⟨ha, hb⟩, hc⟩
    have h4 := congrArg (C.presheaf.germ (L.V a ⊓ L.V b ⊓ L.V c) ξ hm ≫ C.residue ξ).hom
      (hOK.2.2.2 a b c)
    rw [map_mul, germ_res, germ_res, germ_res] at h4
    unfold wcpaDjPsTw
    rw [res_eq _ ξ (TopologicalSpace.Opens.mem_inf.mpr ⟨ha, hb⟩),
      res_eq _ ξ (TopologicalSpace.Opens.mem_inf.mpr ⟨hb, hc⟩),
      res_eq _ ξ (TopologicalSpace.Opens.mem_inf.mpr ⟨ha, hc⟩)]
    exact h4

  have huniq : ∀ (O : C.Opens) (t : Γ(C, O)), (∀ (ξ : C) (hξ : ξ ∈ O),
        closure {ξ} ∈ irreducibleComponents C →
        (C.presheaf.germ O ξ hξ ≫ C.residue ξ).hom t = 0) → t = 0 := by
    intro O t ht
    apply eq_zero_of_basicOpen_eq_bot
    by_contra hne
    obtain ⟨z, hz⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hne
    obtain ⟨Y, hY, hzY⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible _
      (isIrreducible_singleton (x := z)).closure
    have hYirr : IsIrreducible Y := hY.prop
    have hYcl : IsClosed Y := isClosed_of_mem_irreducibleComponents Y hY
    have hgen := hYirr.isGenericPoint_genericPoint_closure
    rw [hYcl.closure_eq] at hgen
    have hξ : closure {hYirr.genericPoint} = Y := hgen
    have hξz : hYirr.genericPoint ⤳ z := by
      rw [specializes_iff_mem_closure, hξ]
      exact hzY (subset_closure rfl)
    have hξB : hYirr.genericPoint ∈ C.basicOpen t := hξz.mem_open (C.basicOpen t).isOpen hz
    have hξO : hYirr.genericPoint ∈ O := C.basicOpen_le t hξB
    have hunit := (C.mem_basicOpen t _ hξO).mp hξB
    have h0 := ht _ hξO (by rw [hξ]; exact hY)
    rw [CommRingCat.hom_comp, RingHom.comp_apply] at h0
    exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hunit h0

  have hA1 : ∀ x : C, IsClosed ({x} : Set C) → ∃ hx : C.presheaf.stalk x,
      ∀ ξ : C, closure {ξ} ∈ irreducibleComponents C → ξ ⤳ x →
        wcpaDjPsSp x ξ hx = wcpaDjPsTw L (ch ξ) (ch x) ξ ^ e * u ξ := by
    intro x hx
    by_cases hsm : ∃ W : C.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q)
    · exact wcpa_dj_fva_gg_realize_smooth K C q hss x hx hsm
        (fun ξ => wcpaDjPsTw L (ch ξ) (ch x) ξ ^ e * u ξ) (hreg x hx)
    · exact wcpa_dj_fva_gg_realize_node K C q hss x hx hsm
        (fun ξ => wcpaDjPsTw L (ch ξ) (ch x) ξ ^ e * u ξ) (hreg x hx) (hmatch x hx)
  choose hxg hxg_spec using hA1

  have hA2 : ∀ (a : Fin L.m) (x : C), IsClosed ({x} : Set C) → x ∈ L.V a ⊓ q ⁻¹ᵁ ⊤ →
      ∃ h : C.presheaf.stalk x, ∀ ξ : C, closure {ξ} ∈ irreducibleComponents C → ξ ⤳ x →
        wcpaDjPsSp x ξ h = wcpaDjPsTw L (ch ξ) a ξ ^ e * u ξ := by
    intro a x hx hxa
    have hxa' : x ∈ L.V a := (TopologicalSpace.Opens.mem_inf.mp hxa).1
    have hxca : x ∈ L.V (ch x) ⊓ L.V a := TopologicalSpace.Opens.mem_inf.mpr ⟨hch x, hxa'⟩
    refine ⟨(C.presheaf.germ _ x hxca).hom (L.g (ch x) a).val ^ e * hxg x hx, ?_⟩
    intro ξ hξ hξx
    have hξca := hξx.mem_open (L.V (ch x) ⊓ L.V a).isOpen hxca
    have e1 : wcpaDjPsSp x ξ ((C.presheaf.germ _ x hxca).hom (L.g (ch x) a).val ^ e * hxg x hx) =
        wcpaDjPsSp x ξ ((C.presheaf.germ _ x hxca).hom (L.g (ch x) a).val) ^ e *
          wcpaDjPsSp x ξ (hxg x hx) := by
      rw [sp_eq x ξ hξx, sp_eq x ξ hξx, sp_eq x ξ hξx, map_mul, map_pow]
    rw [e1, sp_germ x ξ hξx, hxg_spec x hx ξ hξ hξx, ← res_eq _ ξ hξca]
    change wcpaDjPsTw L (ch x) a ξ ^ e * (wcpaDjPsTw L (ch ξ) (ch x) ξ ^ e * u ξ) = _
    rw [← mul_assoc, ← mul_pow, mul_comm (wcpaDjPsTw L (ch x) a ξ),
      tw_coc (ch ξ) (ch x) a ξ (hch ξ) (TopologicalSpace.Opens.mem_inf.mp hξca).1
        (TopologicalSpace.Opens.mem_inf.mp hξca).2]

  have hA3 : ∀ a : Fin L.m, ∃ t : Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤), ∀ (ξ : C) (hξ : ξ ∈ L.V a ⊓ q ⁻¹ᵁ ⊤),
      closure {ξ} ∈ irreducibleComponents C →
      (C.presheaf.germ _ ξ hξ ≫ C.residue ξ).hom t = wcpaDjPsTw L (ch ξ) a ξ ^ e * u ξ :=
    fun a => wcpa_dj_fva_gg_glue_generic C hJ hGfin huniq (L.V a ⊓ q ⁻¹ᵁ ⊤)
      (fun ξ => wcpaDjPsTw L (ch ξ) a ξ ^ e * u ξ) (fun x hx hxa => hA2 a x hx hxa)
  choose s hs using hA3

  have hcoc : wcpaDjCocSec q L e s := by
    intro a b
    rw [← sub_eq_zero]
    apply huniq
    intro ξ hξ hξG
    have hξab : ξ ∈ L.V a ⊓ L.V b := (TopologicalSpace.Opens.mem_inf.mp hξ).1
    have hξa : ξ ∈ L.V a := (TopologicalSpace.Opens.mem_inf.mp hξab).1
    have hξb : ξ ∈ L.V b := (TopologicalSpace.Opens.mem_inf.mp hξab).2
    rw [map_sub, map_mul, germ_res, germ_res, germ_res, hs b ξ _ hξG, hs a ξ _ hξG, map_pow,
      ← res_eq _ ξ hξab]
    change wcpaDjPsTw L (ch ξ) b ξ ^ e * u ξ -
      wcpaDjPsTw L a b ξ ^ e * (wcpaDjPsTw L (ch ξ) a ξ ^ e * u ξ) = 0
    rw [← mul_assoc, ← mul_pow, mul_comm (wcpaDjPsTw L a b ξ),
      tw_coc (ch ξ) a b ξ (hch ξ) hξa hξb, sub_self]

  refine ⟨s, hcoc, ?_⟩
  intro x hx b hxb
  have hxb' : x ∈ L.V b := (TopologicalSpace.Opens.mem_inf.mp hxb).1
  have hxcb : x ∈ L.V (ch x) ⊓ L.V b := TopologicalSpace.Opens.mem_inf.mpr ⟨hch x, hxb'⟩
  have hG2 : ∀ β, wcpaDjPsBr q x β → ∀ k : ℕ,
      (wcpaDjPsInPow β.2
          (wcpaDjPsSp x β.1 ((C.presheaf.germ (L.V b ⊓ q ⁻¹ᵁ ⊤) x hxb).hom (s b))) k ↔
        wcpaDjPsInPow β.2 (wcpaDjPsTw L (ch β.1) (ch x) β.1 ^ e * u β.1) k) := by
    intro β hβ k
    have hβ' := hβ
    unfold wcpaDjPsBr at hβ'
    obtain ⟨hβG, -, -, hβx, hβ5, -⟩ := hβ'
    have h1 : wcpaDjPsSp x β.1 ((C.presheaf.germ (L.V b ⊓ q ⁻¹ᵁ ⊤) x hxb).hom (s b)) =
        wcpaDjPsTw L (ch β.1) b β.1 ^ e * u β.1 := by
      rw [sp_germ x β.1 hβx]
      exact hs b β.1 _ hβG
    have hξcb := hβx.mem_open (L.V (ch x) ⊓ L.V b).isOpen hxcb
    have hrr : (C.presheaf.germ _ x hxcb).hom (L.g (ch x) b).val *
        (C.presheaf.germ _ x hxcb).hom (L.g (ch x) b)⁻¹.val = 1 := by
      rw [← map_mul, Units.mul_inv, map_one]
    have hρ : wcpaDjPsSp x β.1 ((C.presheaf.germ _ x hxcb).hom (L.g (ch x) b).val) =
        wcpaDjPsTw L (ch x) b β.1 := by
      rw [sp_germ x β.1 hβx]
      exact (res_eq _ _ hξcb _).symm
    have hρρ : wcpaDjPsSp x β.1 ((C.presheaf.germ _ x hxcb).hom (L.g (ch x) b).val) *
        wcpaDjPsSp x β.1 ((C.presheaf.germ _ x hxcb).hom (L.g (ch x) b)⁻¹.val) = 1 := by
      rw [sp_eq x β.1 hβx, sp_eq x β.1 hβx, ← map_mul, hrr, map_one]
    have hρV := ip_mem _ _ _ (hβ5 ((C.presheaf.germ _ x hxcb).hom (L.g (ch x) b).val))
    have hρ'V := ip_mem _ _ _ (hβ5 ((C.presheaf.germ _ x hxcb).hom (L.g (ch x) b)⁻¹.val))
    have h2 : wcpaDjPsTw L (ch β.1) b β.1 ^ e * u β.1 =
        wcpaDjPsSp x β.1 ((C.presheaf.germ _ x hxcb).hom (L.g (ch x) b).val) ^ e *
          (wcpaDjPsTw L (ch β.1) (ch x) β.1 ^ e * u β.1) := by
      rw [hρ, ← mul_assoc, ← mul_pow, mul_comm (wcpaDjPsTw L (ch x) b β.1),
        tw_coc (ch β.1) (ch x) b β.1 (hch β.1) (TopologicalSpace.Opens.mem_inf.mp hξcb).1
          (TopologicalSpace.Opens.mem_inf.mp hξcb).2]
    rw [h1, h2]
    exact inpow_unit β.2 _ _ _ (pow_mem hρV e) (pow_mem hρ'V e)
      (by rw [← mul_pow, hρρ, one_pow]) k
  refine ⟨⟨fun hmem β hβ => ?_, fun hall => ?_⟩, hG2⟩
  · have hβ' := hβ
    unfold wcpaDjPsBr at hβ'
    exact (hG2 β hβ 1).mp (hβ'.2.2.2.2.2 _ hmem)
  · by_contra hnm
    obtain ⟨β, hβ⟩ := hBrEx x hx
    have hβ' := hβ
    unfold wcpaDjPsBr at hβ'
    have h1 := (hG2 β hβ 1).mpr (hall β hβ)
    have hu : IsUnit ((C.presheaf.germ (L.V b ⊓ q ⁻¹ᵁ ⊤) x hxb).hom (s b)) := by
      by_contra hnu
      exact hnm ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu))
    obtain ⟨γ', hγγ'⟩ := hu.exists_right_inv
    have h0 := hβ'.2.2.2.2.1 γ'
    have h3 := inpow_mul β.2 (wcpaDjPsSp x β.1 γ') _ (ip_mem _ _ _ h0) 1 h1
    rw [sp_eq x β.1 hβ'.2.2.2.1, sp_eq x β.1 hβ'.2.2.2.1, ← map_mul, mul_comm γ', hγγ',
      map_one] at h3
    exact ip_one β.2 h3

theorem wcpa_dj_fva_tg_branch_valuation : ∀ (K : Type u) [Field K] (R : Type u) [CommRing R] (F : Type u) [Field F] (ψ : R →+* F) (θ : R →+* PowerSeries K), RingHom.ker ψ = RingHom.ker θ → (∀ f : F, ∃ a b : R, ψ b ≠ 0 ∧ f * ψ b = ψ a) → (∃ r : R, PowerSeries.constantCoeff (θ r) = 0 ∧ PowerSeries.coeff 1 (θ r) ≠ 0) → ∃ V : ValuationSubring F, V ≠ ⊤ ∧ ∀ (g : R) (n : ℕ), (∃ h : ψ g ∈ V, (⟨ψ g, h⟩ : V) ∈ IsLocalRing.maximalIdeal V ^ n) ↔ PowerSeries.X ^ n ∣ θ g :=
by
  intro K _ R _ F _ ψ θ hker hfrac hr
  classical
  obtain ⟨r, hr0, hr1⟩ := hr
  have hι₀inj : Function.Injective (algebraMap (PowerSeries K) (FractionRing (PowerSeries K))) :=
    IsFractionRing.injective (PowerSeries K) (FractionRing (PowerSeries K))

  obtain ⟨ι, hιψ⟩ : ∃ ι : F →+* FractionRing (PowerSeries K), ∀ a : R,
      ι (ψ a) = algebraMap (PowerSeries K) (FractionRing (PowerSeries K)) (θ a) := by
    have hprime : (RingHom.ker ψ).IsPrime := RingHom.ker_isPrime ψ
    have hθ0 : ∀ a ∈ RingHom.ker ψ, θ a = 0 := by
      intro a ha
      rw [hker] at ha
      exact ha
    let θb : (R ⧸ RingHom.ker ψ) →+* PowerSeries K := Ideal.Quotient.lift (RingHom.ker ψ) θ hθ0
    have hθb : ∀ a, θb (Ideal.Quotient.mk _ a) = θ a := fun a => Ideal.Quotient.lift_mk _ _ _
    have hθbinj : Function.Injective θb := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [hθb] at hx
      rw [Ideal.Quotient.eq_zero_iff_mem, hker]
      exact hx
    letI : Algebra (R ⧸ RingHom.ker ψ) F := ψ.kerLift.toAlgebra
    have halg : ∀ a, algebraMap (R ⧸ RingHom.ker ψ) F (Ideal.Quotient.mk _ a) = ψ a :=
      fun a => RingHom.kerLift_mk ψ a
    haveI : FaithfulSMul (R ⧸ RingHom.ker ψ) F :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr (RingHom.kerLift_injective ψ)
    haveI : IsFractionRing (R ⧸ RingHom.ker ψ) F := by
      apply IsFractionRing.of_field
      intro z
      obtain ⟨a, b, hb, hz⟩ := hfrac z
      refine ⟨Ideal.Quotient.mk _ a, Ideal.Quotient.mk _ b, ?_⟩
      rw [halg, halg, eq_div_iff hb]
      exact hz
    have hg : Function.Injective
        ((algebraMap (PowerSeries K) (FractionRing (PowerSeries K))).comp θb) :=
      hι₀inj.comp hθbinj
    refine ⟨IsFractionRing.lift hg, fun a => ?_⟩
    rw [← halg, IsFractionRing.lift_algebraMap, RingHom.comp_apply, hθb]

  let V' : ValuationSubring (FractionRing (PowerSeries K)) :=
    { (algebraMap (PowerSeries K) (FractionRing (PowerSeries K))).range with
      mem_or_inv_mem' := fun x => by
        rcases ValuationRing.isInteger_or_isInteger (PowerSeries K) x with h | h
        · left
          exact RingHom.mem_range.mpr (RingHom.mem_rangeS.mp h)
        · right
          exact RingHom.mem_range.mpr (RingHom.mem_rangeS.mp h) }
  obtain ⟨V, hV⟩ : ∃ V : ValuationSubring F, ∀ f : F, f ∈ V ↔
      ∃ P : PowerSeries K, algebraMap (PowerSeries K) (FractionRing (PowerSeries K)) P = ι f :=
    ⟨V'.comap ι, fun f => Iff.rfl⟩

  obtain ⟨φ, hφ⟩ : ∃ φ : V →+* PowerSeries K, ∀ v : V,
      algebraMap (PowerSeries K) (FractionRing (PowerSeries K)) (φ v) = ι v := by
    let e := RingEquiv.ofBijective (algebraMap (PowerSeries K) (FractionRing (PowerSeries K))).rangeRestrict
      ⟨fun a b h => hι₀inj (congrArg Subtype.val h), RingHom.rangeRestrict_surjective _⟩
    let j : V →+* (algebraMap (PowerSeries K) (FractionRing (PowerSeries K))).range :=
      (ι.comp V.subtype).codRestrict _ (fun v => RingHom.mem_range.mpr ((hV v).mp v.2))
    refine ⟨e.symm.toRingHom.comp j, fun v => ?_⟩
    have h1 : ((e (e.symm (j v)) : (algebraMap (PowerSeries K) (FractionRing (PowerSeries K))).range) :
        FractionRing (PowerSeries K)) = ι v := by
      rw [RingEquiv.apply_symm_apply]
      rfl
    exact h1

  have hloc : ∀ v : V, IsUnit (φ v) → IsUnit v := by
    intro v hu
    obtain ⟨w, hw⟩ := hu.exists_right_inv
    have h1 : ι v * algebraMap (PowerSeries K) (FractionRing (PowerSeries K)) w = 1 := by
      rw [← hφ v, ← map_mul, hw, map_one]
    have hv0 : (v : F) ≠ 0 := by
      intro h
      rw [h, map_zero, zero_mul] at h1
      exact zero_ne_one h1
    have hinv : (v : F)⁻¹ ∈ V := (hV _).mpr ⟨w, by rw [map_inv₀]; exact eq_inv_of_mul_eq_one_right h1⟩
    exact isUnit_iff_exists_inv.mpr ⟨⟨_, hinv⟩, Subtype.ext (show (v : F) * (v : F)⁻¹ = 1 from mul_inv_cancel₀ hv0)⟩
  have hmax_to : ∀ v ∈ IsLocalRing.maximalIdeal V, PowerSeries.constantCoeff (φ v) = 0 := by
    intro v hv
    by_contra h
    exact ((IsLocalRing.mem_maximalIdeal _).mp hv)
      (hloc v (PowerSeries.isUnit_iff_constantCoeff.mpr (Ne.isUnit h)))

  obtain ⟨U, hU⟩ := PowerSeries.X_dvd_iff.mpr hr0
  have hUunit : IsUnit U := by
    apply PowerSeries.isUnit_iff_constantCoeff.mpr
    apply Ne.isUnit
    rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, ← PowerSeries.coeff_succ_X_mul, ← hU]
    exact hr1
  have hψV : ∀ a, ψ a ∈ V := fun a => (hV _).mpr ⟨θ a, (hιψ a).symm⟩
  have hφψ : ∀ a (h : ψ a ∈ V), φ ⟨ψ a, h⟩ = θ a := by
    intro a h
    apply hι₀inj
    rw [hφ]
    exact hιψ a
  have hφπ : φ ⟨ψ r, hψV r⟩ = PowerSeries.X * U := by rw [hφψ, hU]
  have hπm : (⟨ψ r, hψV r⟩ : V) ∈ IsLocalRing.maximalIdeal V := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have h1 := hu.map φ
    rw [hφπ] at h1
    have h2 := PowerSeries.isUnit_iff_constantCoeff.mp (isUnit_of_mul_isUnit_left h1)
    rw [PowerSeries.constantCoeff_X] at h2
    exact not_isUnit_zero h2

  have claim : ∀ (v : V) (n : ℕ), v ∈ IsLocalRing.maximalIdeal V ^ n ↔ PowerSeries.X ^ n ∣ φ v := by
    intro v n
    constructor
    · intro hv
      have h1 : IsLocalRing.maximalIdeal V ≤
          (Ideal.span {(PowerSeries.X : PowerSeries K)}).comap φ := by
        intro y hy
        rw [Ideal.mem_comap, Ideal.mem_span_singleton]
        exact PowerSeries.X_dvd_iff.mpr (hmax_to y hy)
      have h2 := ((Ideal.pow_right_mono h1 n).trans (Ideal.le_comap_pow φ n)) hv
      rw [Ideal.mem_comap, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at h2
      exact h2
    · rintro ⟨Q, hQ⟩
      have hπn := Ideal.pow_mem_pow hπm n
      rcases ValuationRing.dvd_total ((⟨ψ r, hψV r⟩ : V) ^ n) v with ⟨c, hc⟩ | ⟨c, hc⟩
      · rw [hc]
        exact Ideal.mul_mem_right c _ hπn
      · have e1 : PowerSeries.X ^ n * U ^ n = PowerSeries.X ^ n * (Q * φ c) := by
          have h := congrArg φ hc
          rw [map_pow, map_mul, hφπ, hQ, mul_pow] at h
          rw [h]
          ring
        have e2 : U ^ n = Q * φ c := mul_left_cancel₀ (pow_ne_zero n PowerSeries.X_ne_zero) e1
        have hcu : IsUnit (φ c) := isUnit_of_mul_isUnit_right (e2 ▸ hUunit.pow n)
        obtain ⟨cu, hcu'⟩ := hloc c hcu
        have hv : v = (⟨ψ r, hψV r⟩ : V) ^ n * ↑cu⁻¹ := by
          rw [hc, ← hcu', mul_assoc, Units.mul_inv, mul_one]
        rw [hv]
        exact Ideal.mul_mem_right _ _ hπn

  have hne : V ≠ ⊤ := by
    intro htop
    have hψr : ψ r ≠ 0 := by
      intro h
      have h1 : r ∈ RingHom.ker ψ := h
      rw [hker, RingHom.mem_ker] at h1
      rw [h1, map_zero] at hr1
      exact hr1 rfl
    have hmem : (ψ r)⁻¹ ∈ V := by
      rw [htop]
      exact ValuationSubring.mem_top _
    have hu : IsUnit (⟨ψ r, hψV r⟩ : V) :=
      isUnit_iff_exists_inv.mpr ⟨⟨_, hmem⟩, Subtype.ext (show ψ r * (ψ r)⁻¹ = 1 from mul_inv_cancel₀ hψr)⟩
    exact ((IsLocalRing.mem_maximalIdeal _).mp hπm) hu

  refine ⟨V, hne, fun g n => ⟨?_, ?_⟩⟩
  · rintro ⟨h, hm⟩
    have h1 := (claim _ n).mp hm
    rw [hφψ] at h1
    exact h1
  · intro hd
    refine ⟨hψV g, (claim _ n).mpr ?_⟩
    rw [hφψ]
    exact hd

theorem wcpa_dj_fva_ss_tangent_generation : ∀ (K : Type u) [Field K] [IsAlgClosed K]
    (C : Scheme.{u}) (q : C ⟶ Spec (.of K)), wcpaDjSemistable q →
    ∀ x : C, IsClosed ({x} : Set C) → ∀ S : Set (C.presheaf.stalk x),
      S ⊆ IsLocalRing.maximalIdeal (C.presheaf.stalk x) →
      (∀ β, wcpaDjPsBr q x β → ∃ g ∈ S, ¬ wcpaDjPsInPow β.2 (wcpaDjPsSp x β.1 g) 2 ∧
        ∀ β', wcpaDjPsBr q x β' → β' ≠ β → wcpaDjPsInPow β'.2 (wcpaDjPsSp x β'.1 g) 2) →
      Ideal.span S = IsLocalRing.maximalIdeal (C.presheaf.stalk x) :=
by
  intro K _ _ C q hss x hx S hS hhyp
  classical
  haveI : IsProper q := hss.2.1
  haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian q

  have hsp : ∀ (ξ : C) (h : ξ ⤳ x) (g : C.presheaf.stalk x),
      wcpaDjPsSp x ξ g = (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom g := by
    intro ξ h g
    unfold wcpaDjPsSp
    rw [dif_pos h]

  have hK : ∀ (ξ : C) (h : ξ ⤳ x) (c : K), wcpaDjPsK q ξ c =
      (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom
        (((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ x trivial).hom c) := by
    intro ξ h c
    have e : C.presheaf.germ ⊤ x trivial ≫ C.presheaf.stalkSpecializes h =
        C.presheaf.germ ⊤ ξ trivial := TopCat.Presheaf.germ_stalkSpecializes _ _ _
    unfold wcpaDjPsK
    rw [← e]
    simp only [CommRingCat.hom_comp, RingHom.comp_apply]

  have hΦ : (asIso (Limits.pullback.fst q (𝟙 (Spec (.of K))))).symm.hom ≫
      Limits.pullback.snd q (𝟙 (Spec (.of K))) = q := by
    simp only [Iso.symm_hom, asIso_inv]
    rw [IsIso.inv_comp_eq, Limits.pullback.condition, Category.comp_id]
  have hdich := fun w : C => wcpa_dj_ssp_bw_ns_transport K
    (asIso (Limits.pullback.fst q (𝟙 (Spec (.of K))))).symm
    q (Limits.pullback.snd q (𝟙 (Spec (.of K)))) hΦ w (hss.2.2 K (𝟙 _) _)

  let U : C.Opens := sSup {W : C.Opens | SmoothOfRelativeDimension 1 (W.ι ≫ q)}
  have hiff : ∀ w : C, w ∈ U ↔
      ∃ W : C.Opens, w ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q) := by
    intro w
    rw [TopologicalSpace.Opens.mem_sSup]
    constructor
    · rintro ⟨W, hW, hwW⟩
      exact ⟨W, hwW, hW⟩
    · rintro ⟨W, hwW, hW⟩
      exact ⟨W, hW, hwW⟩
  have hres : ∀ w : C, w ∉ U → ∀ a : C.presheaf.stalk w, ∃ z : K,
      a - ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ w trivial).hom z ∈
        IsLocalRing.maximalIdeal (C.presheaf.stalk w) := by
    intro w hw
    rcases hdich w with hsm | hnode
    · exact absurd ((hiff w).mpr hsm) hw
    · exact wcpa_dj_nf_node_residue K (C.presheaf.stalk w) _ hnode
  obtain ⟨hcl, -⟩ := wcpa_dj_nf_nodes_closed_finite K C q U inferInstance hres
  have hdim := wcpa_dj_nf_node_dim_le_one K C q U inferInstance hiff hcl
  by_cases hxU : x ∈ U
  ·
    obtain ⟨W, hxW, hW⟩ := (hiff x).mp hxU
    haveI := hW
    let ε := (W.stalkIso ⟨x, hxW⟩).commRingCatIsoToRingEquiv
    haveI := wcpa_smooth_stalk_isDomain K W.toScheme (W.ι ≫ q) 1 ⟨x, hxW⟩
    haveI := wcpa_dj_sgt_smooth_curve_stalk_valuation K W.toScheme (W.ι ≫ q) ⟨x, hxW⟩
    have hdvd : ∀ a b : C.presheaf.stalk x, a ∣ b ∨ b ∣ a := by
      intro a b
      rcases ValuationRing.dvd_total (ε.symm a) (ε.symm b) with ⟨c, hc⟩ | ⟨c, hc⟩
      · left
        refine ⟨ε c, ?_⟩
        have := congrArg ε hc
        rwa [map_mul, RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply] at this
      · right
        refine ⟨ε c, ?_⟩
        have := congrArg ε hc
        rwa [map_mul, RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply] at this
    obtain ⟨-, -, hBrEx, -⟩ := wcpa_dj_fva_ss_branch_basics K C q hss
    obtain ⟨⟨ξ, V⟩, hβ⟩ := hBrEx x hx
    have hξx : ξ ⤳ x := hβ.2.2.2.1
    obtain ⟨g, hgS, hg2, -⟩ := hhyp ⟨ξ, V⟩ hβ
