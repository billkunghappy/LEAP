  let x₀ : Spec (.of (IsLocalRing.ResidueField ↥W)) ⟶ Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) := pt ≫ θκ.inv
  have hx₀ : x₀ ≫ Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) = 𝟙 _ := by
    show (pt ≫ θκ.inv) ≫ Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) = 𝟙 _
