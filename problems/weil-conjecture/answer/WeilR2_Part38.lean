  have L3 : ∀ (R : Type u) [CommRing R] [IsLocalRing R], IsAlgClosed (IsLocalRing.ResidueField R) →
      ∀ (Y : Scheme.{u}) (v : Y ⟶ Spec (.of R)), LocallyOfFiniteType v → ∀ z : Y,
      IsClosed ({z} : Set Y) → v z = IsLocalRing.closedPoint R →
