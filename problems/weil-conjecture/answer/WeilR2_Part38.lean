theorem wcpa_dj_lus_cvs_ct_ns_etale_unibranch : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : ValuationSubring K), IsAlgClosed (IsLocalRing.ResidueField ↥R) → ∀ (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)), wcpaDjSemistable v → ∀ E ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))), (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra), IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧ θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = ι ≫ Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) → ∀ z, closure {z} = E → ∀ (V : Scheme.{u}) (p : V ⟶ Y), Etale p → ∀ w₁ w₂ s : ↥V, p w₁ = Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) z → p w₂ = Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) z → w₁ ⤳ s → w₂ ⤳ s → v (p s) = IsLocalRing.closedPoint ↥R → w₁ = w₂ :=
by
  intro K _ _ R hκ Y v hss E hE hP1E z hzE V p hp w₁ w₂ s hw₁ hw₂ hs₁ hs₂ _hvs
  classical
  haveI : Etale p := hp
  set fK := Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) with hfK
  have hzmem : z ∈ E := by rw [← hzE]; exact subset_closure rfl

  have hCl : closure (fK '' E) = closure {fK z} := by
    apply le_antisymm
    · apply closure_minimal _ isClosed_closure
      rintro _ ⟨e, he, rfl⟩
      rw [← hzE] at he
      have h1 : z ⤳ e := specializes_iff_mem_closure.mpr he
      exact specializes_iff_mem_closure.mp (h1.map fK.continuous)
    · exact closure_mono (Set.singleton_subset_iff.mpr ⟨z, hzmem, rfl⟩)

  have hgps : fK z ⤳ p s := by
    have := hs₁.map p.continuous
    rwa [hw₁] at this
  have hpsCl : p s ∈ closure (fK '' E) := by
    rw [hCl]; exact specializes_iff_mem_closure.mp hgps
  have hgCl : fK z ∈ closure (fK '' E) := subset_closure ⟨z, hzmem, rfl⟩

  let 𝒵 : TopologicalSpace.Closeds Y := ⟨closure (fK '' E), isClosed_closure⟩
  let I := Scheme.IdealSheafData.vanishingIdeal 𝒵
