theorem wcpa_dj_lfc_generic_noexc : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω)
    (C : Scheme.{u}) (c : C ⟶ Spec (.of Ω)) (k : ℕ) (y : Fin k → (Spec (.of Ω) ⟶ C)),
    wcpaDjStablePtd c k y →
    ∀ (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (σ : Fin (k + 1) → (Spec (.of ↥W) ⟶ Z₁))
      (ψ₁ : C ⟶ Z₁), IsPullback ψ₁ c u₁ (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) →
      (∀ i : Fin k, y i ≫ ψ₁ = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ σ (Fin.castSucc i)) →
      ∀ (K : Type u) [Field K] [IsAlgClosed K] (t : Spec (.of K) ⟶ Spec (.of Ω))
        (E : Set ↥(Limits.pullback u₁ (t ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))))),
        E ∈ irreducibleComponents
          ↥(Limits.pullback u₁ (t ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))) →
        (∃ (Er : Scheme.{u})
          (ι : Er ⟶ Limits.pullback u₁ (t ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))))
          (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
          ι ≫ Limits.pullback.snd u₁ (t ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))) →
        3 ≤ (E ∩ closure Eᶜ).ncard + Nat.card {i : Fin k // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
          Limits.pullback.fst u₁ (t ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) x =
            σ (Fin.castSucc i) ((t ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) p)} :=
by
  intro Ω _ _ W C c k y hy Z₁ u₁ σ ψ₁ hpb hcomp K _ _ t E hE hP1
  obtain ⟨Er, ι, θ, hιci, hEr, hιE, hθ⟩ := hP1
  haveI := hιci
  have pt : ∀ {A B D : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ D} {d : A ⟶ D}, a ≫ b = d →
      ∀ z, b (a z) = d z := by
    intro A B D a b d h z
    rw [← Scheme.Hom.comp_apply, h]
  have hP := (IsPullback.of_hasPullback c t).paste_horiz hpb
  set Φ := hP.isoPullback with hΦ
  have Φ1 : Φ.hom ≫ Limits.pullback.fst u₁ (t ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) =
      Limits.pullback.fst c t ≫ ψ₁ := hP.isoPullback_hom_fst
  have Φ3 : Φ.inv ≫ Limits.pullback.snd c t =
      Limits.pullback.snd u₁ (t ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) :=
    hP.isoPullback_inv_snd
  let h := Scheme.homeoOfIso Φ
  have hh : ∀ x, h x = Φ.hom x := fun x => rfl
  let E₀ : Set ↥(Limits.pullback c t) := ⇑h ⁻¹' E
  have hE₀ : E₀ ∈ irreducibleComponents ↥(Limits.pullback c t) := by
    refine preimage_mem_irreducibleComponents_of_isPreirreducible_fiber hE h.continuous
      h.isOpenMap ?_ ?_
    · intro x
      have hsub : (⇑h ⁻¹' {x}).Subsingleton := by
        intro a ha b hb
        exact h.injective ((ha : h a = x).trans (hb : h b = x).symm)
      exact hsub.isPreirreducible
    · obtain ⟨z, hz⟩ := hE.1.nonempty
      obtain ⟨w, rfl⟩ := h.surjective z
      exact ⟨h w, hz, w, rfl⟩
  have hncard : (E₀ ∩ closure E₀ᶜ).ncard = (E ∩ closure Eᶜ).ncard := by
    have e1 : E₀ ∩ closure E₀ᶜ = ⇑h ⁻¹' (E ∩ closure Eᶜ) := by
