      (wcProjK Ω 1).functionField φ g g' (fun p hp => by_contra fun hne => htr p hne hp) hgen hgen'
    have hgg := rigid (wcProjK Ω 1).functionField φ _ _ _ _ _ _ κ1 κ2 κ3 hinj1 hinj2 hinj3
