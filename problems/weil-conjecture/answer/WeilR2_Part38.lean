  have fbi : ∀ (X G Y : Scheme.{u}) (p : G ⟶ X) (j : Y ⟶ G) (a : Y ⟶ X)
      [AlgebraicGeometry.IsIntegral X] (hnorm : ∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x))
