  have hMob : wcLr1uMob (wcProjKStr Ω 1) c1 c2 c3 g := ⟨hg1, hg2, hg3, hgen⟩
  have htr := transc (wcProjK Ω 1).functionField φ _ _ κ3 hinj3 hκ3 g hg3
  obtain ⟨V, hV, hconst⟩ := wcpa_dj_lr1u_tv_gauss_ring Ω (wcProjK Ω 1).functionField W φ g htr hgen
  refine ⟨⟨g, hMob⟩, V, ?_, hconst⟩
  rw [hV]
