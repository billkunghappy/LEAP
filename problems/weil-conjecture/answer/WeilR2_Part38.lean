by
  intro K _ C q L e M t hsec J
  have resres : ∀ {U V W : C.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(C, U)),
      (C.presheaf.map (homOfLE h2).op).hom ((C.presheaf.map (homOfLE h1).op).hom x) =
