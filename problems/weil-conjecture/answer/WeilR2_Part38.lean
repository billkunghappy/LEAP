    wcpa_dj_p1r_hvd_bc_model _ B A ψ φ Y (E.obj (Opposite.op T)) v (hE T)
      (ρ.app (Opposite.op T)) (hprop T) (hflat T hS₁T) hpbT W' t hW'aff hW'cov ht V hpre z htz
  exact ⟨B, iB, hBl, hBn, φ, hφ, Y', h, π, V', z', hhP, hhF, hpbB, hV'aff, hV'cov, hpreV, hcoc,
    hz'⟩

theorem wcpa_dj_p1r_hv_mod_descend : ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B] (φ : B →+* A) [IsLocalHom φ] (Y Y' : Scheme.{u}) (v : Y ⟶ Spec (.of A)) (h : Y' ⟶ Spec (.of B)) (π : Y ⟶ Y'), IsPullback π v h (Spec.map (CommRingCat.ofHom φ)) → ∀ {m : ℕ} (V' : Fin m → Y'.Opens), (∀ a, IsAffineOpen (V' a)) → (∀ a b, IsAffineOpen (V' a ⊓ V' b)) → (∀ a b d, IsAffineOpen (V' a ⊓ V' b ⊓ V' d)) → wcpaP1rModH1 v (IsLocalRing.maximalIdeal A) (fun a => π ⁻¹ᵁ V' a) → wcpaP1rModH1 h (IsLocalRing.maximalIdeal B) V' :=
by
  intro A B _ _ _ _ φ _ Y Y' v h π hpb m V' haff haff2 haff3 hmod
  classical

  have S1 : ∃ μ : IsLocalRing.ResidueField A →+ IsLocalRing.ResidueField B, μ 1 = 1 ∧
      ∀ (c : IsLocalRing.ResidueField B) (y : IsLocalRing.ResidueField A),
        μ (IsLocalRing.ResidueField.map φ c * y) = c * μ y := by
    letI : Algebra (IsLocalRing.ResidueField B) (IsLocalRing.ResidueField A) :=
      (IsLocalRing.ResidueField.map φ).toAlgebra
    have hker : (Algebra.linearMap (IsLocalRing.ResidueField B)
        (IsLocalRing.ResidueField A)).ker = ⊥ := by
      rw [LinearMap.ker_eq_bot]
      exact (IsLocalRing.ResidueField.map φ).injective
    obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective _ hker
    have hg' : ∀ c, g (IsLocalRing.ResidueField.map φ c) = c := fun c => LinearMap.congr_fun hg c
    refine ⟨g.toAddMonoidHom, ?_, ?_⟩
    · show g 1 = 1
      have := hg' 1
      rwa [map_one] at this
    · intro c y
      show g (IsLocalRing.ResidueField.map φ c * y) = c * g y
      rw [← smul_eq_mul (a := c), ← g.map_smul, Algebra.smul_def]
      rfl
  obtain ⟨μ, hμ1, hμ⟩ := S1

  have S2 : ∀ (R S : CommRingCat.{u}) (σ : CommRingCat.of B ⟶ R) (p : R ⟶ S)
      (τ : CommRingCat.of A ⟶ S), IsPushout σ (CommRingCat.ofHom φ) p τ →
      ∃ E : S →+ (R ⧸ Ideal.map σ.hom (IsLocalRing.maximalIdeal B)),
        (∀ (r : R) (a : A) (b : B), IsLocalRing.residue B b = μ (IsLocalRing.residue A a) →
          E (p.hom r * τ.hom a) =
            Ideal.Quotient.mk (Ideal.map σ.hom (IsLocalRing.maximalIdeal B)) r *
            Ideal.Quotient.mk (Ideal.map σ.hom (IsLocalRing.maximalIdeal B)) (σ.hom b)) ∧
        (∀ r : R, E (p.hom r) = Ideal.Quotient.mk (Ideal.map σ.hom (IsLocalRing.maximalIdeal B)) r) ∧
        (∀ s ∈ Ideal.map τ.hom (IsLocalRing.maximalIdeal A), E s = 0) ∧
        (∀ s : S, s ∈ AddSubmonoid.closure {x : S | ∃ (r : R) (a : A), x = p.hom r * τ.hom a}) := by
    intro R S σ p τ hPO
    set I := Ideal.map σ.hom (IsLocalRing.maximalIdeal B) with hI
    letI : Algebra B R := σ.hom.toAlgebra
    letI : Algebra B A := φ.toAlgebra
    have hT : IsPushout σ (CommRingCat.ofHom φ)
        (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := B) (A := R) (B := A)))
        (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight (R := B) (A := R) (B := A)).toRingHom) :=
      CommRingCat.isPushout_tensorProduct B R A
    let e := IsPushout.isoIsPushout _ _ hT hPO
    have he1 : ∀ r : R, e.hom.hom (r ⊗ₜ[B] (1 : A)) = p.hom r := by
      intro r
      rw [← IsPushout.inl_isoIsPushout_hom _ _ hT hPO]
      rfl
    have he2 : ∀ a : A, e.hom.hom ((1 : R) ⊗ₜ[B] a) = τ.hom a := by
      intro a
      rw [← IsPushout.inr_isoIsPushout_hom _ _ hT hPO]
      rfl
    have hstar : ∀ (r : R) (a : A), e.hom.hom (r ⊗ₜ[B] a) = p.hom r * τ.hom a := by
      intro r a
      rw [← he1, ← he2, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    have hinv : ∀ t, e.inv.hom (e.hom.hom t) = t := by
      intro t
      have := congrArg (fun k => k.hom t) e.hom_inv_id
      simpa using this
    have hinv' : ∀ s, e.hom.hom (e.inv.hom s) = s := by
      intro s
      have := congrArg (fun k => k.hom s) e.inv_hom_id
      simpa using this
    let ℓ : IsLocalRing.ResidueField B →+* R ⧸ I := Ideal.quotientMap I σ.hom Ideal.le_comap_map
    have hℓ : ∀ b : B, ℓ (IsLocalRing.residue B b) = Ideal.Quotient.mk I (σ.hom b) := by
      intro b
      exact Ideal.quotientMap_mk
    let g : A →+ R ⧸ I := ℓ.toAddMonoidHom.comp (μ.comp (IsLocalRing.residue A).toAddMonoidHom)
    let f : R →+ A →+ R ⧸ I := AddMonoidHom.mk' (fun r => AddMonoidHom.mk'
        (fun a => Ideal.Quotient.mk I r * g a) (by intro a a'; rw [map_add, mul_add]))
      (by intro r r'; ext a; simp only [AddMonoidHom.mk'_apply, AddMonoidHom.add_apply, map_add,
        add_mul])
    have hf : ∀ r a, f r a = Ideal.Quotient.mk I r * ℓ (μ (IsLocalRing.residue A a)) :=
      fun r a => rfl
    have hbal : ∀ (b : B) (r : R) (a : A), f (b • r) a = f r (b • a) := by
      intro b r a
      rw [hf, hf, Algebra.smul_def, Algebra.smul_def, RingHom.algebraMap_toAlgebra,
        RingHom.algebraMap_toAlgebra, map_mul, map_mul, ← IsLocalRing.ResidueField.map_residue, hμ,
        map_mul, hℓ]
      ring
    let Λ := TensorProduct.liftAddHom f hbal
    have hΛ : ∀ r a, Λ (r ⊗ₜ[B] a) = Ideal.Quotient.mk I r * ℓ (μ (IsLocalRing.residue A a)) :=
      fun r a => by rw [TensorProduct.liftAddHom_tmul, hf]
    let E : S →+ R ⧸ I := Λ.comp e.inv.hom.toAddMonoidHom
    have hE : ∀ t, E (e.hom.hom t) = Λ t := fun t => by
      show Λ (e.inv.hom (e.hom.hom t)) = Λ t
      rw [hinv]
    refine ⟨E, ?_, ?_, ?_, ?_⟩
    · intro r a b hb
      rw [← hstar, hE, hΛ, ← hb, hℓ]
    · intro r
      have h1 : p.hom r = p.hom r * τ.hom 1 := by rw [map_one, mul_one]
      rw [h1, ← hstar, hE, hΛ, map_one, hμ1, map_one, mul_one]
    · have claim : ∀ a ∈ IsLocalRing.maximalIdeal A, ∀ s : S, E (s * τ.hom a) = 0 := by
        intro a ha s
        rw [← hinv' s, ← he2, ← map_mul, hE]
        induction (e.inv.hom s) using TensorProduct.induction_on with
        | zero => rw [zero_mul, map_zero]
        | tmul r a' =>
          rw [Algebra.TensorProduct.tmul_mul_tmul, hΛ]
          have : IsLocalRing.residue A (a' * a) = 0 :=
            (IsLocalRing.residue_eq_zero_iff _).mpr (Ideal.mul_mem_left _ _ ha)
          rw [this, map_zero, map_zero, mul_zero]
        | add x y hx hy => rw [add_mul, map_add, hx, hy, add_zero]
      intro s hs
      have key : ∀ x ∈ Ideal.map τ.hom (IsLocalRing.maximalIdeal A), ∀ s₀ : S,
          E (s₀ * x) = 0 := by
        intro x hx
        induction hx using Submodule.span_induction with
        | mem x hx =>
          obtain ⟨a, ha, rfl⟩ := hx
          exact claim a ha
        | zero => intro s₀; rw [mul_zero, map_zero]
        | add x y _ _ hx hy => intro s₀; rw [mul_add, map_add, hx, hy, add_zero]
        | smul c x _ hx => intro s₀; rw [smul_eq_mul, ← mul_assoc]; exact hx _
      have := key s hs 1
      rwa [one_mul] at this
    · intro s
      rw [← hinv' s]
      induction (e.inv.hom s) using TensorProduct.induction_on with
      | zero => rw [map_zero]; exact zero_mem _
      | tmul r a => rw [hstar]; exact AddSubmonoid.subset_closure ⟨r, a, rfl⟩
      | add x y hx hy => rw [map_add]; exact add_mem hx hy

  have S3 : ∀ (R S R' S' : Type u) [CommRing R] [CommRing S] [CommRing R'] [CommRing S']
      (σ : B →+* R) (p : R →+* S) (τ : A →+* S) (σ' : B →+* R') (p' : R' →+* S')
      (τ' : A →+* S') (f : R →+* R') (g : S →+* S'),
      (∀ s : S, s ∈ AddSubmonoid.closure {x : S | ∃ (r : R) (a : A), x = p r * τ a}) →
      (∀ x, f (σ x) = σ' x) → (∀ x, g (p x) = p' (f x)) → (∀ x, g (τ x) = τ' x) →
      ∀ (E : S →+ (R ⧸ Ideal.map σ (IsLocalRing.maximalIdeal B)))
        (E' : S' →+ (R' ⧸ Ideal.map σ' (IsLocalRing.maximalIdeal B))),
      (∀ (r : R) (a : A) (b : B), IsLocalRing.residue B b = μ (IsLocalRing.residue A a) →
        E (p r * τ a) = Ideal.Quotient.mk (Ideal.map σ (IsLocalRing.maximalIdeal B)) r *
          Ideal.Quotient.mk (Ideal.map σ (IsLocalRing.maximalIdeal B)) (σ b)) →
      (∀ (r : R') (a : A) (b : B), IsLocalRing.residue B b = μ (IsLocalRing.residue A a) →
        E' (p' r * τ' a) = Ideal.Quotient.mk (Ideal.map σ' (IsLocalRing.maximalIdeal B)) r *
          Ideal.Quotient.mk (Ideal.map σ' (IsLocalRing.maximalIdeal B)) (σ' b)) →
      ∀ (s : S) (r : R), E s = Ideal.Quotient.mk (Ideal.map σ (IsLocalRing.maximalIdeal B)) r →
        E' (g s) = Ideal.Quotient.mk (Ideal.map σ' (IsLocalRing.maximalIdeal B)) (f r) := by
    intro R S R' S' _ _ _ _ σ p τ σ' p' τ' f g hspan hσf' hpg' hτg' E E' hE hE' s r hs
    have claim : ∀ s ∈ AddSubmonoid.closure {x : S | ∃ (r : R) (a : A), x = p r * τ a},
        ∃ r₀ : R, E s = Ideal.Quotient.mk (Ideal.map σ (IsLocalRing.maximalIdeal B)) r₀ ∧
          E' (g s) = Ideal.Quotient.mk (Ideal.map σ' (IsLocalRing.maximalIdeal B)) (f r₀) := by
      intro s hs
      induction hs using AddSubmonoid.closure_induction with
      | mem x hx =>
        obtain ⟨r, a, rfl⟩ := hx
        obtain ⟨b, hb⟩ := IsLocalRing.residue_surjective (μ (IsLocalRing.residue A a))
        refine ⟨r * σ b, ?_, ?_⟩
        · rw [hE r a b hb, map_mul]
        · rw [map_mul, hpg', hτg', hE' (f r) a b hb, map_mul, map_mul, hσf']
      | zero => exact ⟨0, by simp, by simp⟩
      | add x y _ _ hx hy =>
        obtain ⟨r₁, h1, h1'⟩ := hx
        obtain ⟨r₂, h2, h2'⟩ := hy
        exact ⟨r₁ + r₂, by rw [map_add, h1, h2, map_add],
          by rw [map_add, map_add, h1', h2', map_add, map_add]⟩
    obtain ⟨r₀, h1, h2⟩ := claim s (hspan s)
    rw [h2]
    have h3 : r₀ - r ∈ Ideal.map σ (IsLocalRing.maximalIdeal B) :=
      Ideal.Quotient.eq.mp (h1.symm.trans hs)
    apply Ideal.Quotient.eq.mpr
    have h4 := Ideal.mem_map_of_mem f h3
    rw [Ideal.map_map] at h4
    have h5 : f.comp σ = σ' := by
      ext x; exact hσf' x
    rw [h5, map_sub] at h4
    exact h4

  have S4 : ∀ (R S : CommRingCat.{u}) (σ : CommRingCat.of B ⟶ R) (p : R ⟶ S)
      (τ : CommRingCat.of A ⟶ S), σ ≫ p = CommRingCat.ofHom φ ≫ τ →
      ∀ x ∈ Ideal.map σ.hom (IsLocalRing.maximalIdeal B),
        p.hom x ∈ Ideal.map τ.hom (IsLocalRing.maximalIdeal A) := by
    intro R S σ p τ hw x hx
    have h1 : p.hom x ∈ Ideal.map p.hom (Ideal.map σ.hom (IsLocalRing.maximalIdeal B)) :=
      Ideal.mem_map_of_mem _ hx
    rw [Ideal.map_map] at h1
    have h2 : p.hom.comp σ.hom = τ.hom.comp φ := by
      have := congrArg CommRingCat.Hom.hom hw
      simpa using this
    rw [h2, ← Ideal.map_map] at h1
    exact Ideal.map_mono (IsLocalRing.map_maximalIdeal_le φ) h1

  have FC0 : ∀ (A K : CommRingCat.{u}) (φ : A ⟶ K) (X F : Scheme.{u})
      (g : X ⟶ Spec A) (fst : F ⟶ X) (snd : F ⟶ Spec K), IsPullback fst snd g (Spec.map φ) →
      ∀ U : X.Opens, IsAffineOpen U → ∀ (V : F.Opens) (hV : fst ⁻¹ᵁ U = V),
        IsPushout ((Scheme.ΓSpecIso A).inv ≫ g.appLE ⊤ U (by simp)) φ (fst.appLE U V hV.ge)
          ((Scheme.ΓSpecIso K).inv ≫ snd.appLE ⊤ V (by simp)) := by
    intro A K φ X F g fst snd hpb U hU V hV
    subst hV
    have hUST : (⊤ : (Spec K).Opens) ≤ Spec.map φ ⁻¹ᵁ ⊤ := by simp
    have hUSX : U ≤ g ⁻¹ᵁ ⊤ := by simp
    have hUY : fst ⁻¹ᵁ U = fst ⁻¹ᵁ U ⊓ snd ⁻¹ᵁ ⊤ := by simp
    have hPB := Scheme.Hom.isPullback_resLE hpb hUST hUSX hUY
    haveI : IsAffine U := hU
    haveI : IsAffine ((⊤ : (Spec A).Opens) : Scheme) := isAffineOpen_top (Spec A)
    haveI : IsAffine ((⊤ : (Spec K).Opens) : Scheme) := isAffineOpen_top (Spec K)
    have hPO := isPushout_appTop_of_isPullback hPB
    have s1 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U),
        (f.resLE U V e).appTop ≫ V.topIso.hom = U.topIso.hom ≫ f.appLE U V e := by
      intro X Y f U V e
      simp only [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE, Scheme.Opens.topIso_hom]
      erw [Scheme.Hom.resLE_appLE, Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
    have hPO2 := IsPushout.of_iso hPO (⊤ : (Spec A).Opens).topIso U.topIso
      (⊤ : (Spec K).Opens).topIso (fst ⁻¹ᵁ U).topIso (s1 _ _ _ _) (s1 _ _ _ _)
      (s1 _ _ _ _) (s1 _ _ _ _)
    refine IsPushout.of_iso hPO2 (Scheme.ΓSpecIso A) (Iso.refl _) (Scheme.ΓSpecIso K)
      (Iso.refl _) ?_ ?_ ?_ ?_
    · rw [Iso.refl_hom, Category.comp_id, Iso.hom_inv_id_assoc]
    · have h4 : (Spec.map φ).appLE ⊤ ⊤ hUST = (Spec.map φ).appTop := Scheme.Hom.appLE_eq_app _
      rw [h4]
      exact Scheme.ΓSpecIso_naturality φ
    · rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]
    · rw [Iso.refl_hom, Category.comp_id, Iso.hom_inv_id_assoc]
  have FC : ∀ U : Y'.Opens, IsAffineOpen U →
      IsPushout ((Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ h.appLE ⊤ U (by simp))
        (CommRingCat.ofHom φ) (π.appLE U (π ⁻¹ᵁ U) le_rfl)
        ((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ v.appLE ⊤ (π ⁻¹ᵁ U) (by simp)) :=
    fun U hU => FC0 _ _ _ _ _ h π v hpb U hU _ rfl

  have GEN : ∀ U : Y'.Opens, IsAffineOpen U →
      ∃ E : Γ(Y, π ⁻¹ᵁ U) →+ (Γ(Y', U) ⧸ Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B)),
        (∀ (r : Γ(Y', U)) (a : A) (b : B), IsLocalRing.residue B b = μ (IsLocalRing.residue A a) →
          E ((π.appLE U (π ⁻¹ᵁ U) le_rfl).hom r * wcCnSigma v (π ⁻¹ᵁ U) a) =
            Ideal.Quotient.mk (Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B)) r *
            Ideal.Quotient.mk (Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B))
              (wcCnSigma h U b)) ∧
        (∀ r : Γ(Y', U), E ((π.appLE U (π ⁻¹ᵁ U) le_rfl).hom r) =
          Ideal.Quotient.mk (Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B)) r) ∧
        (∀ s ∈ Ideal.map (wcCnSigma v (π ⁻¹ᵁ U)) (IsLocalRing.maximalIdeal A), E s = 0) ∧
        (∀ s : Γ(Y, π ⁻¹ᵁ U), s ∈ AddSubmonoid.closure {x : Γ(Y, π ⁻¹ᵁ U) | ∃ (r : Γ(Y', U))
          (a : A), x = (π.appLE U (π ⁻¹ᵁ U) le_rfl).hom r * wcCnSigma v (π ⁻¹ᵁ U) a}) :=
    fun U hU => S2 _ _ _ _ _ (FC U hU)

  have hres : ∀ (X : Scheme.{u}) {U V W' : X.Opens} (h1 : V ≤ U) (h2 : W' ≤ V) (x : Γ(X, U)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
      (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro X U V W' h1 h2 x
    change (X.presheaf.map (homOfLE h1).op ≫ X.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have key : ∀ (U U' : Y'.Opens) (hU : U' ≤ U) (x : Γ(Y', U)),
      (π.appLE U' (π ⁻¹ᵁ U') le_rfl).hom ((Y'.presheaf.map (homOfLE hU).op).hom x) =
      (Y.presheaf.map (homOfLE (π.preimage_mono hU)).op).hom
        ((π.appLE U (π ⁻¹ᵁ U) le_rfl).hom x) := by
    intro U U' hU x
    change (Y'.presheaf.map (homOfLE hU).op ≫ π.appLE U' (π ⁻¹ᵁ U') le_rfl).hom x =
      (π.appLE U (π ⁻¹ᵁ U) le_rfl ≫ Y.presheaf.map (homOfLE (π.preimage_mono hU)).op).hom x
    rw [Scheme.Hom.map_appLE, Scheme.Hom.appLE_map]
  have hσres : ∀ (U U' : Y'.Opens) (hU : U' ≤ U) (x : B),
      (Y'.presheaf.map (homOfLE hU).op).hom (wcCnSigma h U x) = wcCnSigma h U' x := by
    intro U U' hU x
    simp only [wcCnSigma, RingHom.comp_apply]
    exact hres Y' _ _ _
  have hτres : ∀ (U U' : Y.Opens) (hU : U' ≤ U) (x : A),
      (Y.presheaf.map (homOfLE hU).op).hom (wcCnSigma v U x) = wcCnSigma v U' x := by
    intro U U' hU x
    simp only [wcCnSigma, RingHom.comp_apply]
    exact hres Y _ _ _
  choose Ea hEa using fun a => GEN (V' a) (haff a)
  choose Eab hEab using fun a b => GEN (V' a ⊓ V' b) (haff2 a b)

  unfold wcpaP1rModH1 at hmod ⊢
  intro z' hz'
  let z : ∀ a b : Fin m, Γ(Y, π ⁻¹ᵁ V' a ⊓ π ⁻¹ᵁ V' b) := fun a b =>
    (π.appLE (V' a ⊓ V' b) (π ⁻¹ᵁ (V' a ⊓ V' b)) le_rfl).hom (z' a b)
  obtain ⟨x, hx⟩ := hmod z (by
    intro a b d
    have e := S4 _ _ _ (π.appLE (V' a ⊓ V' b ⊓ V' d) (π ⁻¹ᵁ (V' a ⊓ V' b ⊓ V' d)) le_rfl) _
      (FC _ (haff3 a b d)).w _ (hz' a b d)
    rw [map_sub, map_sub, key, key, key] at e
    exact e)
  have hx'e : ∀ a, ∃ x'a : Γ(Y', V' a),
      Ideal.Quotient.mk (Ideal.map (wcCnSigma h (V' a)) (IsLocalRing.maximalIdeal B)) x'a =
        Ea a (x a) := fun a => Ideal.Quotient.mk_surjective _
  choose x' hx' using hx'e
  refine ⟨x', fun a b => ?_⟩
  rw [← Ideal.Quotient.eq]
  have h1 := (hEab a b).2.1 (z' a b)
  have h2 := (hEab a b).2.2.1 _ (hx a b)
  have h2' : Eab a b (z a b) -
      (Eab a b ((Y.presheaf.map (homOfLE
        (inf_le_right : π ⁻¹ᵁ V' a ⊓ π ⁻¹ᵁ V' b ≤ π ⁻¹ᵁ V' b)).op).hom (x b)) -
       Eab a b ((Y.presheaf.map (homOfLE
        (inf_le_left : π ⁻¹ᵁ V' a ⊓ π ⁻¹ᵁ V' b ≤ π ⁻¹ᵁ V' a)).op).hom (x a))) = 0 := by
    have h2c := h2
    erw [map_sub, map_sub] at h2c
    exact h2c
  have h3 := S3 _ _ _ _ (wcCnSigma h (V' b)) (π.appLE (V' b) (π ⁻¹ᵁ V' b) le_rfl).hom
    (wcCnSigma v (π ⁻¹ᵁ V' b)) (wcCnSigma h (V' a ⊓ V' b))
    (π.appLE (V' a ⊓ V' b) (π ⁻¹ᵁ (V' a ⊓ V' b)) le_rfl).hom
    (wcCnSigma v (π ⁻¹ᵁ (V' a ⊓ V' b)))
    (Y'.presheaf.map (homOfLE (inf_le_right : V' a ⊓ V' b ≤ V' b)).op).hom
    (Y.presheaf.map (homOfLE (inf_le_right : π ⁻¹ᵁ V' a ⊓ π ⁻¹ᵁ V' b ≤ π ⁻¹ᵁ V' b)).op).hom
    (hEa b).2.2.2 (hσres _ _ _) (fun y => (key (V' b) (V' a ⊓ V' b) inf_le_right y).symm)
    (hτres _ _ _)
    (Ea b) (Eab a b) (hEa b).1 (hEab a b).1 (x b) (x' b) (hx' b).symm
  have h4 := S3 _ _ _ _ (wcCnSigma h (V' a)) (π.appLE (V' a) (π ⁻¹ᵁ V' a) le_rfl).hom
    (wcCnSigma v (π ⁻¹ᵁ V' a)) (wcCnSigma h (V' a ⊓ V' b))
    (π.appLE (V' a ⊓ V' b) (π ⁻¹ᵁ (V' a ⊓ V' b)) le_rfl).hom
    (wcCnSigma v (π ⁻¹ᵁ (V' a ⊓ V' b)))
    (Y'.presheaf.map (homOfLE (inf_le_left : V' a ⊓ V' b ≤ V' a)).op).hom
    (Y.presheaf.map (homOfLE (inf_le_left : π ⁻¹ᵁ V' a ⊓ π ⁻¹ᵁ V' b ≤ π ⁻¹ᵁ V' a)).op).hom
    (hEa a).2.2.2 (hσres _ _ _) (fun y => (key (V' a) (V' a ⊓ V' b) inf_le_left y).symm)
    (hτres _ _ _)
    (Ea a) (Eab a b) (hEa a).1 (hEab a b).1 (x a) (x' a) (hx' a).symm
  rw [map_sub, ← h1, ← h3, ← h4]
  rw [sub_eq_zero] at h2'
  exact h2'

theorem wcpa_dj_p1r_hv_thicken : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (X : Scheme.{u}) (h : X ⟶ Spec (.of B)), Flat h → ∀ {m : ℕ} (V : Fin m → X.Opens), (∀ a b d, IsAffineOpen (V a ⊓ V b ⊓ V d)) → wcpaP1rModH1 h (IsLocalRing.maximalIdeal B) V → ∀ n : ℕ, wcpaP1rModH1 h (IsLocalRing.maximalIdeal B ^ n) V :=
by
  intro B _ _ _ X h hF m V hV3 hmod n
  classical

  have s0 : ∀ U : X.Opens, IsAffineOpen U → (wcCnSigma h U).Flat := by
    intro U hU
    have h1 := HasRingHomProperty.appLE (P := @Flat) h hF ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩
      (by simp)
    have hb : Function.Bijective (Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom := by
      refine Function.bijective_iff_has_inverse.mpr
        ⟨(Scheme.ΓSpecIso (CommRingCat.of B)).hom.hom, fun x => ?_, fun x => ?_⟩
      · change ((Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫
          (Scheme.ΓSpecIso (CommRingCat.of B)).hom).hom x = x
        rw [Iso.inv_hom_id]; rfl
      · change ((Scheme.ΓSpecIso (CommRingCat.of B)).hom ≫
          (Scheme.ΓSpecIso (CommRingCat.of B)).inv).hom x = x
        rw [Iso.hom_inv_id]; rfl
    have h2 := RingHom.Flat.comp (RingHom.Flat.of_bijective hb) h1
    exact h2

  have s1b : ∀ (S : Type u) [CommRing S] (I J : Ideal B) {r : ℕ} (t : Fin r → B),
      Ideal.span (Set.range t) = I → (∀ a : Fin r → B, ∑ i, a i * t i ∈ I * J → ∀ i, a i ∈ J) →
      ∀ σ : B →+* S, σ.Flat → ∀ y : Fin r → S, ∑ i, σ (t i) * y i ∈ Ideal.map σ (I * J) →
      ∀ i, y i ∈ Ideal.map σ J := by
    intro S _ I J r t hspan hmin σ hσ y hy
    have h1 : Ideal.map σ (I * J) =
        Ideal.map σ J • Submodule.span S (Set.range (fun i => σ (t i))) := by
      rw [Ideal.map_mul, ← hspan, Ideal.map_span, ← Set.range_comp, mul_comm, Ideal.smul_eq_mul]
      rfl
    rw [h1, Submodule.mem_ideal_smul_span_iff_exists_sum] at hy
    obtain ⟨c, hc, hcs⟩ := hy
    rw [Finsupp.sum_fintype c (fun i (e : S) => e • σ (t i)) (fun i => zero_smul S _)] at hcs
    beta_reduce at hcs
    have hrel0 : ∑ i, σ (t i) * (y i - c i) = 0 := by
      simp only [mul_sub, Finset.sum_sub_distrib, sub_eq_zero]
      rw [← hcs]
      exact Finset.sum_congr rfl (fun i _ => by rw [smul_eq_mul, mul_comm])
    letI := σ.toAlgebra
    haveI hflat : Module.Flat B S := by
      rw [← RingHom.flat_algebraMap_iff]; exact hσ
    have hrel : ∑ i, t i • (y i - c i) = 0 := by
      simpa only [Algebra.smul_def, RingHom.algebraMap_toAlgebra] using hrel0
    obtain ⟨κ, a, v, hw, ha⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (R := B)
      (M := S) (f := t) (x := fun i => y i - c i) hrel
    have haJ : ∀ i j, a i j ∈ J := by
      intro i j
      refine hmin (fun i => a i j) ?_ i
      rw [show ∑ i, a i j * t i = ∑ i, t i * a i j from
        Finset.sum_congr rfl (fun _ _ => mul_comm _ _), ha j]
      exact zero_mem _
    intro i
    have e : y i = c i + (y i - c i) := by ring
    have hwi : y i - c i = ∑ j, a i j • v j := hw i
    rw [e, hwi]
    refine add_mem (hc i) (Ideal.sum_mem _ (fun j _ => ?_))
    rw [Algebra.smul_def]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem σ (haJ i j))

  have s1a : ∀ k : ℕ, ∃ (r : ℕ) (t : Fin r → B),
      Ideal.span (Set.range t) = IsLocalRing.maximalIdeal B ^ k ∧
      ∀ a : Fin r → B, ∑ i, a i * t i ∈ IsLocalRing.maximalIdeal B ^ (k + 1) →
        ∀ i, a i ∈ IsLocalRing.maximalIdeal B := by
    intro k
    have hfg : (IsLocalRing.maximalIdeal B ^ k).FG := IsNoetherian.noetherian _
    have hex : ∃ r, ∃ t : Fin r → B, Ideal.span (Set.range t) = IsLocalRing.maximalIdeal B ^ k :=
      Submodule.fg_iff_exists_fin_generating_family.mp hfg
    have key : ∀ (r : ℕ) (t : Fin r → B),
        Ideal.span (Set.range t) = IsLocalRing.maximalIdeal B ^ k →
        (∀ (r' : ℕ) (t' : Fin r' → B),
          Ideal.span (Set.range t') = IsLocalRing.maximalIdeal B ^ k → r ≤ r') →
        ∀ a : Fin r → B, ∑ i, a i * t i ∈ IsLocalRing.maximalIdeal B ^ (k + 1) →
          ∀ i, a i ∈ IsLocalRing.maximalIdeal B := by
      intro r t hspan hmin a ha j
      by_contra hj
      have hunit : IsUnit (a j) := IsLocalRing.notMem_maximalIdeal.mp hj
      obtain ⟨u, hu⟩ := hunit.exists_left_inv
      obtain ⟨r', rfl⟩ : ∃ r', r = r' + 1 := ⟨r - 1, by have := j.pos; omega⟩
      have hle : IsLocalRing.maximalIdeal B ^ k ≤ Ideal.span (Set.range (t ∘ j.succAbove)) := by
        apply Submodule.le_of_le_smul_of_le_jacobson_bot hfg
          (IsLocalRing.maximalIdeal_le_jacobson ⊥)
        rw [← hspan, Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        by_cases hij : i = j
        · rw [hij]
          have hx : ∑ l, a l * t l ∈
              IsLocalRing.maximalIdeal B • Ideal.span (Set.range t) := by
            rw [hspan, Ideal.smul_eq_mul, ← pow_succ']; exact ha
          have e : t j = u * ∑ l, a l * t l -
              ∑ z, u * a (j.succAbove z) * t (j.succAbove z) := by
            rw [Fin.sum_univ_succAbove (fun l => a l * t l) j, mul_add, Finset.mul_sum]
            have h1 : u * (a j * t j) = t j := by rw [← mul_assoc, hu, one_mul]
            rw [h1]
            have h2 : ∑ z, u * (a (j.succAbove z) * t (j.succAbove z)) =
                ∑ z, u * a (j.succAbove z) * t (j.succAbove z) :=
              Finset.sum_congr rfl (fun _ _ => (mul_assoc _ _ _).symm)
            rw [h2]; ring
          rw [e]
          refine sub_mem ?_ ?_
          · exact Submodule.mem_sup_right (Ideal.mul_mem_left _ u hx)
          · refine Submodule.mem_sup_left (Ideal.sum_mem _ fun z _ => ?_)
            exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨z, rfl⟩)
        · obtain ⟨z, rfl⟩ := Fin.exists_succAbove_eq hij
          exact Submodule.mem_sup_left (Ideal.subset_span ⟨z, rfl⟩)
      have hNle : Ideal.span (Set.range (t ∘ j.succAbove)) ≤ IsLocalRing.maximalIdeal B ^ k := by
        rw [← hspan]
        apply Ideal.span_mono
        rintro _ ⟨z, rfl⟩
        exact ⟨_, rfl⟩
      have := hmin r' (t ∘ j.succAbove) (le_antisymm hNle hle)
      omega
    exact ⟨Nat.find hex, (Nat.find_spec hex).choose, (Nat.find_spec hex).choose_spec,
      key _ _ (Nat.find_spec hex).choose_spec
        (fun r' t' h' => Nat.find_min' hex ⟨t', h'⟩)⟩

  have hres : ∀ {U U' W' : X.Opens} (h1 : U' ≤ U) (h2 : W' ≤ U') (x : Γ(X, U)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
      (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro U U' W' h1 h2 x
    change (X.presheaf.map (homOfLE h1).op ≫ X.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have hR2 : ∀ {U U' : X.Opens} (hle : U' ≤ U) (b : B),
      (X.presheaf.map (homOfLE hle).op).hom (wcCnSigma h U b) = wcCnSigma h U' b := by
    intro U U' hle b
    simp only [wcCnSigma, RingHom.comp_apply]
    rw [hres]

  induction n with
  | zero =>
    intro z _
    refine ⟨0, fun a b => ?_⟩
    rw [pow_zero, Ideal.one_eq_top, Ideal.map_top]
    exact Submodule.mem_top
  | succ n ih =>
    intro z hz
    obtain ⟨x, hx⟩ := ih z (fun a b d =>
      Ideal.map_mono (Ideal.pow_le_pow_right (Nat.le_succ n)) (hz a b d))
    obtain ⟨z₁, hz₁⟩ : ∃ z₁ : ∀ a b : Fin m, Γ(X, V a ⊓ V b), ∀ a b, z₁ a b = z a b -
        ((X.presheaf.map (homOfLE (inf_le_right : V a ⊓ V b ≤ V b)).op).hom (x b) -
          (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ≤ V a)).op).hom (x a)) :=
      ⟨_, fun _ _ => rfl⟩
    have hx' : ∀ a b, z₁ a b ∈ Ideal.map (wcCnSigma h (V a ⊓ V b))
        (IsLocalRing.maximalIdeal B ^ n) := by
      intro a b
      rw [hz₁]
      exact hx a b
    obtain ⟨r, t, hspan, hmin⟩ := s1a n
    have hy : ∀ a b, ∃ c : Fin r → Γ(X, V a ⊓ V b),
        ∑ i, c i * wcCnSigma h (V a ⊓ V b) (t i) = z₁ a b := by
      intro a b
      have h1 := hx' a b
      rw [← hspan, Ideal.map_span, ← Set.range_comp] at h1
      exact Ideal.mem_span_range_iff_exists_fun.mp h1
    choose y hy using hy
    have hE3 : ∀ (i : Fin r) (a b d : Fin m),
        (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
            V a ⊓ V b ⊓ V d ≤ V a ⊓ V d)).op).hom (y a d i) -
          (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
            V a ⊓ V b ⊓ V d ≤ V b ⊓ V d)).op).hom (y b d i) -
          (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ⊓ V d ≤ V a ⊓ V b)).op).hom
            (y a b i) ∈
        Ideal.map (wcCnSigma h (V a ⊓ V b ⊓ V d)) (IsLocalRing.maximalIdeal B) := by
      intro i a b d
      have hδ : (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
            V a ⊓ V b ⊓ V d ≤ V a ⊓ V d)).op).hom (z₁ a d) -
          (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
            V a ⊓ V b ⊓ V d ≤ V b ⊓ V d)).op).hom (z₁ b d) -
          (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ⊓ V d ≤ V a ⊓ V b)).op).hom
            (z₁ a b) =
          (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
            V a ⊓ V b ⊓ V d ≤ V a ⊓ V d)).op).hom (z a d) -
          (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
            V a ⊓ V b ⊓ V d ≤ V b ⊓ V d)).op).hom (z b d) -
          (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ⊓ V d ≤ V a ⊓ V b)).op).hom
            (z a b) := by
        simp only [hz₁, map_sub, hres]
        ring
      have hE2 : (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
            V a ⊓ V b ⊓ V d ≤ V a ⊓ V d)).op).hom (z₁ a d) -
          (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
            V a ⊓ V b ⊓ V d ≤ V b ⊓ V d)).op).hom (z₁ b d) -
          (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ⊓ V d ≤ V a ⊓ V b)).op).hom
            (z₁ a b) =
          ∑ i, wcCnSigma h (V a ⊓ V b ⊓ V d) (t i) *
          ((X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
            V a ⊓ V b ⊓ V d ≤ V a ⊓ V d)).op).hom (y a d i) -
          (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
            V a ⊓ V b ⊓ V d ≤ V b ⊓ V d)).op).hom (y b d i) -
          (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ⊓ V d ≤ V a ⊓ V b)).op).hom
            (y a b i)) := by
        rw [← hy a d, ← hy b d, ← hy a b]
        simp only [map_sum, map_mul, hR2]
        rw [← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
        exact Finset.sum_congr rfl (fun i _ => by ring)
      have hmem := hz a b d
      rw [← hδ, hE2, pow_succ] at hmem
      exact s1b _ (IsLocalRing.maximalIdeal B ^ n) (IsLocalRing.maximalIdeal B) t hspan
        (fun a' ha' => hmin a' (by rw [pow_succ]; exact ha')) _ (s0 _ (hV3 a b d)) _ hmem i
    have hxs : ∀ i : Fin r, ∃ xi : ∀ a : Fin m, Γ(X, V a), ∀ a b : Fin m, y a b i -
        ((X.presheaf.map (homOfLE (inf_le_right : V a ⊓ V b ≤ V b)).op).hom (xi b) -
          (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ≤ V a)).op).hom (xi a)) ∈
        Ideal.map (wcCnSigma h (V a ⊓ V b)) (IsLocalRing.maximalIdeal B) :=
      fun i => hmod (fun a b => y a b i) (fun a b d => hE3 i a b d)
    choose xs hxs using hxs
    refine ⟨fun a => x a + ∑ i, wcCnSigma h (V a) (t i) * xs i a, fun a b => ?_⟩
    have e : z a b -
        ((X.presheaf.map (homOfLE (inf_le_right : V a ⊓ V b ≤ V b)).op).hom
            (x b + ∑ i, wcCnSigma h (V b) (t i) * xs i b) -
          (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ≤ V a)).op).hom
            (x a + ∑ i, wcCnSigma h (V a) (t i) * xs i a)) =
        ∑ i, wcCnSigma h (V a ⊓ V b) (t i) * (y a b i -
          ((X.presheaf.map (homOfLE (inf_le_right : V a ⊓ V b ≤ V b)).op).hom (xs i b) -
            (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ≤ V a)).op).hom (xs i a))) := by
      simp only [map_add, map_sum, map_mul, hR2, mul_sub, Finset.sum_sub_distrib]
      have h1 : ∑ i, wcCnSigma h (V a ⊓ V b) (t i) * y a b i = z a b -
          ((X.presheaf.map (homOfLE (inf_le_right : V a ⊓ V b ≤ V b)).op).hom (x b) -
            (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ≤ V a)).op).hom (x a)) := by
        rw [← hz₁ a b, ← hy a b]
        exact Finset.sum_congr rfl (fun i _ => mul_comm _ _)
      rw [h1]
      ring
    show z a b -
        ((X.presheaf.map (homOfLE (inf_le_right : V a ⊓ V b ≤ V b)).op).hom
            (x b + ∑ i, wcCnSigma h (V b) (t i) * xs i b) -
          (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ≤ V a)).op).hom
            (x a + ∑ i, wcCnSigma h (V a) (t i) * xs i a)) ∈ _
    rw [e]
    refine Ideal.sum_mem _ (fun i _ => ?_)
    rw [pow_succ, Ideal.map_mul]
    refine Ideal.mul_mem_mul (Ideal.mem_map_of_mem _ ?_) (hxs i a b)
    rw [← hspan]
    exact Ideal.subset_span ⟨i, rfl⟩

theorem wcpa_dj_p1r_hv_cocycle_ar : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (I : Ideal B) (X : Scheme.{u}) (h : X ⟶ Spec (.of B)), IsProper h → ∀ {m : ℕ} (V : Fin m → X.Opens), (∀ a, IsAffineOpen (V a)) → (∀ a b, IsAffineOpen (V a ⊓ V b)) → (⨆ a, V a) = ⊤ → ∃ (q : ℕ) (deg : Fin q → ℕ) (ζ : Fin q → ∀ a b : Fin m, Γ(X, V a ⊓ V b)), (∀ (l : Fin q) (a b d : Fin m), (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right : V a ⊓ V b ⊓ V d ≤ V a ⊓ V d)).op).hom (ζ l a d) = (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right : V a ⊓ V b ⊓ V d ≤ V b ⊓ V d)).op).hom (ζ l b d) + (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ⊓ V d ≤ V a ⊓ V b)).op).hom (ζ l a b)) ∧ ∀ (n : ℕ) (z : ∀ a b : Fin m, Γ(X, V a ⊓ V b)), (∀ a b d : Fin m, (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right : V a ⊓ V b ⊓ V d ≤ V a ⊓ V d)).op).hom (z a d) = (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right : V a ⊓ V b ⊓ V d ≤ V b ⊓ V d)).op).hom (z b d) + (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ⊓ V d ≤ V a ⊓ V b)).op).hom (z a b)) → (∀ a b : Fin m, z a b ∈ Ideal.map (wcCnSigma h (V a ⊓ V b)) (I ^ n)) → ∃ (c : Fin q → B) (w : ∀ a : Fin m, Γ(X, V a)), (∀ l, c l ∈ I ^ (n - deg l)) ∧ ∀ a b : Fin m, z a b = ∑ l, wcCnSigma h (V a ⊓ V b) (c l) * ζ l a b + ((X.presheaf.map (homOfLE (inf_le_right : V a ⊓ V b ≤ V b)).op).hom (w b) - (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ≤ V a)).op).hom (w a)) :=
by
  classical
  intro B _ _ I X h hP m V hV1 hV2 hcov
  haveI : IsProper h := hP

  have hcov' : ∀ x : X, ∃ a, x ∈ V a := by
    intro x
    have hx : x ∈ (⊤ : X.Opens) := by simp
    rw [← hcov] at hx
    exact TopologicalSpace.Opens.mem_iSup.mp hx

  haveI hBn : IsNoetherianRing (reesAlgebra I) :=
    @Algebra.FiniteType.isNoetherianRing B (reesAlgebra I) _ _ _
      ((Subalgebra.fg_iff_finiteType _).mp (reesAlgebra.fg (IsNoetherian.noetherian I))) _

  obtain ⟨Xr, hr, Vr, θ₁, θ₂, θ₃, hP1, hP2, hP3, hP2', hP4, hP5, hP6, hP7l, hP7r, hP8a, hP8b,
    hP8c, hP9⟩ := wc_rees_scheme_model B I X h m V hV1 hcov' hV2
  haveI := hP1

  obtain ⟨k, c, H2⟩ := wc_proper_cech_h1_fg (reesAlgebra I) Xr hr m Vr hP2 hP3 hP2'

  let φX : ∀ W : Xr.Opens, reesAlgebra I →+* Γ(Xr, W) := fun W =>
    (Xr.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom.comp
      (hr.appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom)
  let χ : reesAlgebra I →+* (∀ p : Fin m × Fin m, Γ(Xr, Vr p.1 ⊓ Vr p.2)) :=
    RingHom.pi (fun p => φX (Vr p.1 ⊓ Vr p.2))
  let χ₀ : reesAlgebra I →+* (∀ i : Fin m, Γ(Xr, Vr i)) := RingHom.pi (fun i => φX (Vr i))
  let dX : (∀ i : Fin m, Γ(Xr, Vr i)) → (∀ p : Fin m × Fin m, Γ(Xr, Vr p.1 ⊓ Vr p.2)) :=
    fun w p =>
      Xr.presheaf.map (homOfLE (inf_le_right : Vr p.1 ⊓ Vr p.2 ≤ Vr p.2)).op (w p.2) -
        Xr.presheaf.map (homOfLE (inf_le_left : Vr p.1 ⊓ Vr p.2 ≤ Vr p.1)).op (w p.1)
  have hres' : ∀ (W W' : Xr.Opens) (hle : W' ≤ W) (e : reesAlgebra I),
      Xr.presheaf.map (homOfLE hle).op (φX W e) = φX W' e := by
    intro W W' hle e
    show (Xr.presheaf.map (homOfLE hle).op) ((Xr.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op)
      ((hr.appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom) e)) =
      (Xr.presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op)
      ((hr.appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom) e)
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  let N₀ : AddSubgroup (∀ p : Fin m × Fin m, Γ(Xr, Vr p.1 ⊓ Vr p.2)) :=
    { carrier := {z | ∃ w, z = dX w}
      add_mem' := by
        rintro _ _ ⟨w, rfl⟩ ⟨w', rfl⟩
        refine ⟨w + w', ?_⟩
        funext p
        simp only [dX, Pi.add_apply, map_add]
        ring
      zero_mem' := ⟨0, by funext p; simp only [dX, Pi.zero_apply, map_zero, sub_self]⟩
      neg_mem' := by
        rintro _ ⟨w, rfl⟩
        refine ⟨-w, ?_⟩
        funext p
        simp only [dX, Pi.neg_apply, map_neg]
        ring }
  have hclos : ∀ (b : reesAlgebra I) (w : ∀ p : Fin m × Fin m, Γ(Xr, Vr p.1 ⊓ Vr p.2)),
      w ∈ N₀ → χ b * w ∈ N₀ := by
    rintro b _ ⟨w, rfl⟩
    refine ⟨χ₀ b * w, ?_⟩
    funext p
    simp only [dX, χ, χ₀, Pi.mul_apply, RingHom.pi_apply, map_mul]
    rw [hres' _ _ _ b, hres' _ _ _ b]
    ring

  let ι := Σ n : ℕ, {z : ∀ p : Fin m × Fin m, Γ(X, V p.1 ⊓ V p.2) //
    (∀ i j l : Fin m, X.presheaf.map (homOfLE (inf_le_left : V i ⊓ V j ⊓ V l ≤ V i ⊓ V j)).op
        (z (i, j)) + X.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right)
          inf_le_right : V i ⊓ V j ⊓ V l ≤ V j ⊓ V l)).op (z (j, l)) =
      X.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right :
        V i ⊓ V j ⊓ V l ≤ V i ⊓ V l)).op (z (i, l))) ∧
    ∀ p : Fin m × Fin m, z p ∈ Ideal.map (wcCnSigma h (V p.1 ⊓ V p.2)) (I ^ n)}

  have hlift : ∀ t : ι, ∃ Z : (∀ p : Fin m × Fin m, Γ(Xr, Vr p.1 ⊓ Vr p.2)),
      (∀ i j l : Fin m, Xr.presheaf.map (homOfLE (inf_le_left : Vr i ⊓ Vr j ⊓ Vr l ≤ Vr i ⊓ Vr j)).op
          (Z (i, j)) + Xr.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right)
            inf_le_right : Vr i ⊓ Vr j ⊓ Vr l ≤ Vr j ⊓ Vr l)).op (Z (j, l)) =
        Xr.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right :
          Vr i ⊓ Vr j ⊓ Vr l ≤ Vr i ⊓ Vr l)).op (Z (i, l))) ∧
      ∀ p : Fin m × Fin m, θ₂ p.1 p.2 (Z p) = Polynomial.C (t.2.1 p) * Polynomial.X ^ t.1 := by
    rintro ⟨n, z, hz, hzI⟩
    have s3 : ∀ p : Fin m × Fin m, ∀ e, (Polynomial.C (z p) * Polynomial.X ^ n).coeff e ∈
        Ideal.map ((X.presheaf.map (homOfLE (le_top : V p.1 ⊓ V p.2 ≤ ⊤)).op).hom.comp
          (h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) (I ^ e) := by
      intro p e
      rw [Polynomial.coeff_C_mul_X_pow]
      split_ifs with he
      · rw [he]; exact hzI p
      · exact Ideal.zero_mem _
    choose Z hZ using fun p : Fin m × Fin m => hP6 p.1 p.2 _ (s3 p)
    refine ⟨Z, ?_, hZ⟩
    have hZ' : ∀ a b : Fin m, θ₂ a b (Z (a, b)) = Polynomial.C (z (a, b)) * Polynomial.X ^ n :=
      fun a b => hZ (a, b)
    intro i j l
    apply hP4 i j l
    rw [map_add, hP8a, hP8b, hP8c, hZ' i j, hZ' j l, hZ' i l]
    simp only [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow, Polynomial.map_X]
    rw [← add_mul, ← Polynomial.C_add]
    exact congrArg (fun s => Polynomial.C s * Polynomial.X ^ n) (hz i j l)
  choose F hFcoc hFθ using hlift

  have hFspan : ∀ t : ι, ∃ (b : Fin k → reesAlgebra I)
      (w : ∀ p : Fin m × Fin m, Γ(Xr, Vr p.1 ⊓ Vr p.2)), w ∈ N₀ ∧ F t = ∑ l, χ (b l) * c l + w := by
    intro t
    obtain ⟨b, w, hw⟩ := H2 (F t) (hFcoc t)
    exact ⟨b, dX w, ⟨w, rfl⟩, hw⟩
  obtain ⟨q, s, hs⟩ := wc_noeth_span_finite_subfamily (reesAlgebra I) _ χ N₀ hclos F k c hFspan

  refine ⟨q, fun l => (s l).1, fun l a b => (s l).2.1 (a, b), ?_, ?_⟩
  ·
    intro l a b d
    have e := (s l).2.2.1 a b d
    rw [add_comm]
    exact e.symm
  · intro n z hz hzI
    let zp : ∀ p : Fin m × Fin m, Γ(X, V p.1 ⊓ V p.2) := fun p => z p.1 p.2
    have hzp : ∀ i j l : Fin m,
        X.presheaf.map (homOfLE (inf_le_left : V i ⊓ V j ⊓ V l ≤ V i ⊓ V j)).op (zp (i, j)) +
          X.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right) inf_le_right :
            V i ⊓ V j ⊓ V l ≤ V j ⊓ V l)).op (zp (j, l)) =
        X.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right :
          V i ⊓ V j ⊓ V l ≤ V i ⊓ V l)).op (zp (i, l)) := by
      intro i j l
      have e := hz i j l
      rw [add_comm]
      exact e.symm
    have hzpI : ∀ p : Fin m × Fin m, zp p ∈ Ideal.map (wcCnSigma h (V p.1 ⊓ V p.2)) (I ^ n) :=
      fun p => hzI p.1 p.2
    obtain ⟨i₀, hz0⟩ : ∃ i₀ : ι, ∀ p : Fin m × Fin m,
        θ₂ p.1 p.2 (F i₀ p) = Polynomial.C (zp p) * Polynomial.X ^ n :=
      ⟨⟨n, zp, hzp, hzpI⟩, fun p => hFθ _ p⟩
    obtain ⟨b, w₁, ⟨w₀, rfl⟩, hrel⟩ := hs i₀
    have hrel' : F i₀ = ∑ j, RingHom.pi (fun p : Fin m × Fin m =>
        (Xr.presheaf.map (homOfLE (le_top : Vr p.1 ⊓ Vr p.2 ≤ ⊤)).op).hom.comp
          (hr.appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom)) (b j) * F (s j) +
        (fun p : Fin m × Fin m =>
          Xr.presheaf.map (homOfLE (inf_le_right : Vr p.1 ⊓ Vr p.2 ≤ Vr p.2)).op (w₀ p.2) -
          Xr.presheaf.map (homOfLE (inf_le_left : Vr p.1 ⊓ Vr p.2 ≤ Vr p.1)).op (w₀ p.1)) := hrel

    obtain ⟨cc, hcc⟩ : ∃ cc : Fin q → B, ∀ l, cc l =
        if (s l).1 ≤ n then ((b l : reesAlgebra I) : Polynomial B).coeff (n - (s l).1) else 0 :=
      ⟨_, fun _ => rfl⟩
    obtain ⟨w', hw'⟩ : ∃ w' : ∀ a : Fin m, Γ(X, V a), ∀ a, w' a = (θ₁ a (w₀ a)).coeff n :=
      ⟨_, fun _ => rfl⟩
    have key : ∀ p : Fin m × Fin m, zp p = ∑ l, wcCnSigma h (V p.1 ⊓ V p.2) (cc l) * (s l).2.1 p +
        ((X.presheaf.map (homOfLE (inf_le_right : V p.1 ⊓ V p.2 ≤ V p.2)).op).hom (w' p.2) -
          (X.presheaf.map (homOfLE (inf_le_left : V p.1 ⊓ V p.2 ≤ V p.1)).op).hom (w' p.1)) := by
      intro p
      have e1 := congrArg (θ₂ p.1 p.2) (congrFun hrel' p)
      simp only [Finset.sum_apply, Pi.add_apply, Pi.mul_apply, RingHom.pi_apply, map_add,
        map_sum, map_mul, map_sub] at e1
      rw [hz0 p, hP7l, hP7r] at e1
      simp only [hP9, hFθ] at e1
      have e2 := congrArg (fun r => Polynomial.coeff r n) e1
      simp only [Polynomial.coeff_C_mul_X_pow, if_pos rfl, Polynomial.coeff_add, if_true,
        ↓reduceIte, Polynomial.coeff_sub, Polynomial.finset_sum_coeff, Polynomial.coeff_map] at e2
      rw [e2, hw', hw']
      refine congrArg₂ (· + ·) (Finset.sum_congr rfl (fun j _ => ?_)) rfl
      rw [hcc j, ← mul_assoc, Polynomial.coeff_mul_X_pow']
      by_cases hsj : (s j).1 ≤ n
      · rw [if_pos hsj, if_pos hsj, Polynomial.coeff_mul_C, Polynomial.coeff_map]
        rfl
      · rw [if_neg hsj, if_neg hsj, map_zero, zero_mul]
    refine ⟨cc, w', fun l => ?_, fun a₁ b₁ => key (a₁, b₁)⟩
    rw [hcc l]
    split_ifs with hsl
    · exact (mem_reesAlgebra_iff I _).mp (b l).2 (n - (s l).1)
    · exact Ideal.zero_mem _

theorem wcpa_dj_p1r_hv_nak_close : ∀ (B S : Type u) [CommRing B] [IsLocalRing B] [CommRing S] (χ : B →+* S) (N₀ : AddSubgroup S), (∀ (b : B) (w : S), w ∈ N₀ → χ b * w ∈ N₀) → ∀ {q : ℕ} (ζ : Fin q → S), (∀ k : Fin q, ∃ b : Fin q → B, (∀ l, b l ∈ IsLocalRing.maximalIdeal B) ∧ ζ k - ∑ l, χ (b l) * ζ l ∈ N₀) → ∀ k, ζ k ∈ N₀ :=
by
  intro B S _ _ _ χ N₀ hN q ζ hζ
  classical
  choose b hbm hbN using hζ
  set M : Matrix (Fin q) (Fin q) B := 1 - Matrix.of b with hM
  have hunit : IsUnit M.det := by
    by_contra hnu
    have hmem : M.det ∈ IsLocalRing.maximalIdeal B := by
      by_contra h
      exact hnu (IsLocalRing.notMem_maximalIdeal.mp h)
    have h1 : (IsLocalRing.residue B) M.det = 1 := by
      rw [RingHom.map_det]
      have hρ : (IsLocalRing.residue B).mapMatrix M = 1 := by
        ext i j
        simp only [hM, RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.sub_apply,
          Matrix.one_apply, Matrix.of_apply, map_sub]
        rw [(IsLocalRing.residue_eq_zero_iff _).mpr (hbm i j), sub_zero]
        split_ifs <;> simp
      rw [hρ, Matrix.det_one]
    rw [(IsLocalRing.residue_eq_zero_iff _).mpr hmem] at h1
    exact zero_ne_one h1
  have hrow : ∀ k, ∑ l, χ (M k l) * ζ l ∈ N₀ := by
    intro k
    have e : ∑ l, χ (M k l) * ζ l = ζ k - ∑ l, χ (b k l) * ζ l := by
      simp only [hM, Matrix.sub_apply, Matrix.one_apply, Matrix.of_apply, map_sub, sub_mul,
        Finset.sum_sub_distrib]
      congr 1
      simp [apply_ite χ, ite_mul]
    rw [e]
    exact hbN k
  have hdet : ∀ j, χ M.det * ζ j ∈ N₀ := by
    intro j
    have hx : ∑ k, χ (M.adjugate j k) * ∑ l, χ (M k l) * ζ l ∈ N₀ :=
      N₀.sum_mem (fun k _ => hN _ _ (hrow k))
    have h2 : ∀ l, ∑ k, χ (M.adjugate j k) * χ (M k l) = χ ((M.adjugate * M) j l) := by
      intro l
      rw [Matrix.mul_apply, map_sum]
      simp only [map_mul]
    have heq : ∑ k, χ (M.adjugate j k) * ∑ l, χ (M k l) * ζ l = χ M.det * ζ j := by
      calc ∑ k, χ (M.adjugate j k) * ∑ l, χ (M k l) * ζ l
          = ∑ l, (∑ k, χ (M.adjugate j k) * χ (M k l)) * ζ l := by
            simp only [Finset.mul_sum, Finset.sum_mul]
            rw [Finset.sum_comm]
            exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring
        _ = ∑ l, χ ((M.adjugate * M) j l) * ζ l := by simp only [h2]
        _ = χ M.det * ζ j := by
            rw [Matrix.adjugate_mul, Finset.sum_eq_single j]
            · simp [Matrix.smul_apply]
            · intro l _ hl
              simp [Matrix.smul_apply, Ne.symm hl]
            · intro h
              exact absurd (Finset.mem_univ j) h
    rw [← heq]
    exact hx
  intro j
  obtain ⟨u, hu⟩ := hunit.exists_left_inv
  have hj := hN u _ (hdet j)
  rwa [← mul_assoc, ← map_mul, hu, map_one, one_mul] at hj

theorem wcpa_dj_p1r_hv_noeth_vanish : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (X : Scheme.{u}) (h : X ⟶ Spec (.of B)), IsProper h → Flat h → ∀ {m : ℕ} (V : Fin m → X.Opens), (∀ a, IsAffineOpen (V a)) → (∀ a b, IsAffineOpen (V a ⊓ V b)) → (∀ a b d, IsAffineOpen (V a ⊓ V b ⊓ V d)) → (⨆ a, V a) = ⊤ → wcpaP1rModH1 h (IsLocalRing.maximalIdeal B) V → wcpaP1rRawH1 V :=
by
  intro B _ _ _ X h hP hF m V hV1 hV2 hV3 hcov hmod
  obtain ⟨q, deg, ζ, hζ, hAR⟩ :=
    wcpa_dj_p1r_hv_cocycle_ar B (IsLocalRing.maximalIdeal B) X h hP V hV1 hV2 hcov
  have hmodN := wcpa_dj_p1r_hv_thicken B X h hF V hV3 hmod
  have hres : ∀ {U U' W' : X.Opens} (h1 : U' ≤ U) (h2 : W' ≤ U') (x : Γ(X, U)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
      (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro U U' W' h1 h2 x
    change (X.presheaf.map (homOfLE h1).op ≫ X.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have hR2 : ∀ {U U' : X.Opens} (hle : U' ≤ U) (b : B),
      (X.presheaf.map (homOfLE hle).op).hom (wcCnSigma h U b) = wcCnSigma h U' b := by
    intro U U' hle b
    simp only [wcCnSigma, RingHom.comp_apply]
    rw [hres]
  obtain ⟨Nc, hNc⟩ : ∃ Nc : ℕ, Nc = (∑ l, deg l) + 1 := ⟨_, rfl⟩
  have hdeg : ∀ l, 1 ≤ Nc - deg l := by
    intro l
    have h1 : deg l ≤ ∑ l, deg l :=
      Finset.single_le_sum (fun i _ => Nat.zero_le (deg i)) (Finset.mem_univ l)
    omega
  obtain ⟨χ, hχ⟩ : ∃ χ : B →+* (∀ p : Fin m × Fin m, Γ(X, V p.1 ⊓ V p.2)),
      ∀ b p, χ b p = wcCnSigma h (V p.1 ⊓ V p.2) b :=
    ⟨Pi.ringHom (fun p => wcCnSigma h (V p.1 ⊓ V p.2)), fun _ _ => rfl⟩
  obtain ⟨δ, hδ⟩ : ∃ δ : (∀ a : Fin m, Γ(X, V a)) →+ (∀ p : Fin m × Fin m, Γ(X, V p.1 ⊓ V p.2)),
      ∀ w p, δ w p =
        (X.presheaf.map (homOfLE (inf_le_right : V p.1 ⊓ V p.2 ≤ V p.2)).op).hom (w p.2) -
        (X.presheaf.map (homOfLE (inf_le_left : V p.1 ⊓ V p.2 ≤ V p.1)).op).hom (w p.1) :=
    ⟨{ toFun := fun w p =>
          (X.presheaf.map (homOfLE (inf_le_right : V p.1 ⊓ V p.2 ≤ V p.2)).op).hom (w p.2) -
          (X.presheaf.map (homOfLE (inf_le_left : V p.1 ⊓ V p.2 ≤ V p.1)).op).hom (w p.1)
       map_zero' := by
         funext p
         simp
       map_add' := by
         intro w w'
         funext p
         simp only [Pi.add_apply, map_add]
         abel }, fun _ _ => rfl⟩
  have hclos : ∀ (b : B) (s : ∀ p : Fin m × Fin m, Γ(X, V p.1 ⊓ V p.2)),
      s ∈ δ.range → χ b * s ∈ δ.range := by
    intro b s hs
    obtain ⟨w, rfl⟩ := AddMonoidHom.mem_range.mp hs
    refine AddMonoidHom.mem_range.mpr ⟨fun a => wcCnSigma h (V a) b * w a, ?_⟩
    funext p
    simp only [hδ, Pi.mul_apply, hχ, map_mul, hR2]
    ring
  have hH : ∀ z : ∀ a b : Fin m, Γ(X, V a ⊓ V b),
      (∀ a b d : Fin m,
        (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
            V a ⊓ V b ⊓ V d ≤ V a ⊓ V d)).op).hom (z a d) =
          (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
            V a ⊓ V b ⊓ V d ≤ V b ⊓ V d)).op).hom (z b d) +
          (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ⊓ V d ≤ V a ⊓ V b)).op).hom
            (z a b)) →
      ∃ c : Fin q → B, (∀ l, c l ∈ IsLocalRing.maximalIdeal B) ∧
        (fun p : Fin m × Fin m => z p.1 p.2) -
          ∑ l, χ (c l) * (fun p : Fin m × Fin m => ζ l p.1 p.2) ∈ δ.range := by
    intro z hz
    obtain ⟨x, hx⟩ := hmodN Nc z (by
      intro a b d
      rw [hz a b d]
      simp)
    obtain ⟨z', hz'⟩ : ∃ z' : ∀ a b : Fin m, Γ(X, V a ⊓ V b), ∀ a b, z' a b = z a b -
        ((X.presheaf.map (homOfLE (inf_le_right : V a ⊓ V b ≤ V b)).op).hom (x b) -
          (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ≤ V a)).op).hom (x a)) :=
      ⟨_, fun _ _ => rfl⟩
    have hz'coc : ∀ a b d : Fin m,
        (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
            V a ⊓ V b ⊓ V d ≤ V a ⊓ V d)).op).hom (z' a d) =
          (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
            V a ⊓ V b ⊓ V d ≤ V b ⊓ V d)).op).hom (z' b d) +
          (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ⊓ V d ≤ V a ⊓ V b)).op).hom
            (z' a b) := by
      intro a b d
      simp only [hz', map_sub, hres]
      linear_combination hz a b d
    have hz'mem : ∀ a b : Fin m,
        z' a b ∈ Ideal.map (wcCnSigma h (V a ⊓ V b)) (IsLocalRing.maximalIdeal B ^ Nc) := by
      intro a b
      rw [hz']
      exact hx a b
    obtain ⟨c, w, hc, hw⟩ := hAR Nc z' hz'coc hz'mem
    refine ⟨c, fun l => ?_, AddMonoidHom.mem_range.mpr ⟨x + w, ?_⟩⟩
    · have h1 := Ideal.pow_le_pow_right (I := IsLocalRing.maximalIdeal B) (hdeg l)
      rw [pow_one] at h1
      exact h1 (hc l)
    · funext p
      have e := hw p.1 p.2
      rw [hz'] at e
      simp only [hδ, Pi.add_apply, map_add, Pi.sub_apply, Finset.sum_apply, Pi.mul_apply, hχ]
      linear_combination -e
  have hall := wcpa_dj_p1r_hv_nak_close B (∀ p : Fin m × Fin m, Γ(X, V p.1 ⊓ V p.2)) χ δ.range
    hclos (fun l p => ζ l p.1 p.2) (fun k => hH (ζ k) (hζ k))
  intro c₀ hc₀
  obtain ⟨cc, -, hmem⟩ := hH c₀ hc₀
  have hsum : ∑ l, χ (cc l) * (fun p : Fin m × Fin m => ζ l p.1 p.2) ∈ δ.range :=
    sum_mem (fun l _ => hclos (cc l) _ (hall l))
  have htot := add_mem hmem hsum
  rw [sub_add_cancel] at htot
  obtain ⟨β, hβ⟩ := AddMonoidHom.mem_range.mp htot
  refine ⟨β, fun a b => ?_⟩
  have e := congrFun hβ (a, b)
  rw [hδ] at e
  exact e.symm

theorem wcpa_dj_p1r_h1_vanish : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥W)), IsProper v → Flat v → LocallyOfFinitePresentation v → (∃ θκ : Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W)) MvPolynomial.gradedAlgebra, θκ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W)) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField ↥W) ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W) 0))) = Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) → ∀ L : wcpaDjCoc Y, wcpaDjCocOK L → wcpaDjTwH1 L ⊤ (wcStructMod Y) 0 :=
by
  intro Ω _ _ W Y v hP hF hL hθ L hOK
  obtain ⟨hVaff, hVcov, -, -⟩ := hOK
  haveI := hP

  have hres : ∀ (X : Scheme.{u}) {U V W' : X.Opens} (h1 : V ≤ U) (h2 : W' ≤ V) (x : Γ(X, U)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
      (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro X U V W' h1 h2 x
    change (X.presheaf.map (homOfLE h1).op ≫ X.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have hid : ∀ (X : Scheme.{u}) {U : X.Opens} (h : U ≤ U) (x : Γ(X, U)),
      (X.presheaf.map (homOfLE h).op).hom x = x := by
    intro X U h x
    rw [show homOfLE h = 𝟙 U from rfl, op_id, CategoryTheory.Functor.map_id]
    rfl
  have tr : ∀ (X : Scheme.{u}) {T P Q R : X.Opens} (hTP : T ≤ P) (hTQ : T ≤ Q) (hTR : T ≤ R)
      (S : X.Opens) (hS : S ≤ T) (x : Γ(X, P)) (y : Γ(X, Q)) (z : Γ(X, R)),
      (X.presheaf.map (homOfLE hTP).op).hom x =
        (X.presheaf.map (homOfLE hTQ).op).hom y + (X.presheaf.map (homOfLE hTR).op).hom z →
      (X.presheaf.map (homOfLE (hS.trans hTP)).op).hom x =
        (X.presheaf.map (homOfLE (hS.trans hTQ)).op).hom y +
          (X.presheaf.map (homOfLE (hS.trans hTR)).op).hom z := by
    intro X T P Q R hTP hTQ hTR S hS x y z e
    have e2 := congrArg (X.presheaf.map (homOfLE hS).op).hom e
    rw [map_add, hres X, hres X, hres X] at e2
    exact e2

  have hsepY : IsSeparated (Limits.terminal.from Y) := by
    rw [show Limits.terminal.from Y = v ≫ Limits.terminal.from _ from Limits.terminal.hom_ext _ _]
    infer_instance
  have h2 : ∀ a b, IsAffineOpen (L.V a ⊓ L.V b) := fun a b => (hVaff a).inf (hVaff b)
  have h3 : ∀ a b d, IsAffineOpen (L.V a ⊓ L.V b ⊓ L.V d) := fun a b d => (h2 a b).inf (hVaff d)

  suffices hraw : wcpaP1rRawH1 L.V by
    refine fun (c0 : ∀ a b, Γ(Y, L.V a ⊓ L.V b ⊓ ⊤)) hc => ?_
    have hT : ∀ (O : Y.Opens), O ≤ O ⊓ ⊤ := fun O => le_inf le_rfl le_top
    have hT' : ∀ (O : Y.Opens), O ⊓ ⊤ ≤ O := fun O => inf_le_left
    obtain ⟨β, hβ⟩ := hraw
      (fun a b => (Y.presheaf.map (homOfLE (hT (L.V a ⊓ L.V b))).op).hom (c0 a b)) (by
        intro a b d
        have e := hc a b d
        simp only [pow_zero, one_smul] at e
        rw [hres Y, hres Y, hres Y]
        exact tr Y _ _ _ (L.V a ⊓ L.V b ⊓ L.V d) (by simp) _ _ _ e)
    refine ⟨fun a => (Y.presheaf.map (homOfLE (hT' (L.V a))).op).hom (β a), fun a b => ?_⟩
    have e := congrArg (Y.presheaf.map (homOfLE (hT' (L.V a ⊓ L.V b))).op).hom (hβ a b)
    rw [map_sub, hres Y, hres Y, hres Y, hid Y] at e
    simp only [pow_zero, one_smul]
    show c0 a b = (Y.presheaf.map (homOfLE _).op).hom ((Y.presheaf.map (homOfLE _).op).hom (β b)) -
      (Y.presheaf.map (homOfLE _).op).hom ((Y.presheaf.map (homOfLE _).op).hom (β a))
    rw [hres Y, hres Y]
    exact e

  intro c hc
  obtain ⟨B, _, _, _, φ, _, Y', h, π, V', z', hhP, hhF, hpb, hV'aff, hV'cov, hpre, hz'coc, hz'⟩ :=
    wcpa_dj_p1r_hv_descend ↥W Y v hP hF hL L.V hVaff hVcov c hc
  haveI := hhP
  have hsepY' : IsSeparated (Limits.terminal.from Y') := by
    rw [show Limits.terminal.from Y' = h ≫ Limits.terminal.from _ from Limits.terminal.hom_ext _ _]
    infer_instance
  have h2' : ∀ a b, IsAffineOpen (V' a ⊓ V' b) := fun a b => (hV'aff a).inf (hV'aff b)
  have h3' : ∀ a b d, IsAffineOpen (V' a ⊓ V' b ⊓ V' d) :=
    fun a b d => (h2' a b).inf (hV'aff d)

  have hmodW := wcpa_dj_p1r_hv_fibre_mod Ω W Y v hθ L.V hVaff h2 h3 hVcov
  have hVeq : L.V = fun a => π ⁻¹ᵁ V' a := funext fun a => (hpre a).symm
  rw [hVeq] at hmodW

  have hmodB := wcpa_dj_p1r_hv_mod_descend ↥W B φ Y Y' v h π hpb V' hV'aff h2' h3' hmodW

  obtain ⟨β', hβ'⟩ :=
    wcpa_dj_p1r_hv_noeth_vanish B Y' h hhP hhF V' hV'aff h2' h3' hV'cov hmodB z' hz'coc

  have hle : ∀ a b, L.V a ⊓ L.V b ≤ π ⁻¹ᵁ (V' a ⊓ V' b) := by
    intro a b x hx
    have h1 : x ∈ π ⁻¹ᵁ V' a := (hpre a).symm ▸ hx.1
    have h2 : x ∈ π ⁻¹ᵁ V' b := (hpre b).symm ▸ hx.2
    exact ⟨h1, h2⟩
  have key : ∀ (U U' : Y'.Opens) (Vo Vo' : Y.Opens) (hU : U' ≤ U) (hV : Vo' ≤ Vo)
      (e : Vo ≤ π ⁻¹ᵁ U) (e' : Vo' ≤ π ⁻¹ᵁ U') (x : Γ(Y', U)),
      (π.appLE U' Vo' e').hom ((Y'.presheaf.map (homOfLE hU).op).hom x) =
      (Y.presheaf.map (homOfLE hV).op).hom ((π.appLE U Vo e).hom x) := by
    intro U U' Vo Vo' hU hV e e' x
    change (Y'.presheaf.map (homOfLE hU).op ≫ π.appLE U' Vo' e').hom x =
      (π.appLE U Vo e ≫ Y.presheaf.map (homOfLE hV).op).hom x
    rw [Scheme.Hom.map_appLE, Scheme.Hom.appLE_map]
  refine ⟨fun a => (π.appLE (V' a) (L.V a) (hpre a).ge).hom (β' a), fun a b => ?_⟩
  rw [← hz' a b (hle a b), hβ' a b, map_sub, key, key]

theorem wcpa_dj_p1r_section_lift : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Y : Scheme.{u}) (v : Y ⟶ Spec (.of A)) (sY : Spec (.of A) ⟶ Y), IsSeparated v → sY ≫ v = 𝟙 _ → ∀ (L : wcpaDjCoc Y) (t : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ v ⁻¹ᵁ ⊤)), wcpaDjCocOK L → wcpaDjCompat L (v ⁻¹ᵁ ⊤) 1 t → (∀ (a : Fin L.m) (O : Y.Opens), IsAffineOpen O → ∀ hO : O ≤ L.V a ⊓ v ⁻¹ᵁ ⊤, (Y.presheaf.map (homOfLE hO).op).hom (t a) ∈ nonZeroDivisors Γ(Y, O) ∧ ∀ s : Γ(Y, O), ((sY.app O).hom s = 0 ↔ s ∈ Ideal.span {(Y.presheaf.map (homOfLE hO).op).hom (t a)})) → wcpaDjTwH1 L ⊤ (wcStructMod Y) 0 → ∃ s : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ v ⁻¹ᵁ ⊤), wcpaDjCompat L (v ⁻¹ᵁ ⊤) 1 s ∧ ∀ (a : Fin L.m) (q : Spec (.of A)), sY q ∈ L.V a → sY q ∈ Y.basicOpen (s a) :=
by
  intro A _ _ Y v sY hsep hs
  generalize hU : v ⁻¹ᵁ ⊤ = U
  rw [Scheme.Hom.preimage_top] at hU
  subst hU
  intro L t hOK hCt hgen hH
  classical

  have rr : ∀ {P Q R : Y.Opens} (h1 : Q ≤ P) (h2 : R ≤ Q) (x : Γ(Y, P)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
      (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro P Q R h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]; rfl
  have rid : ∀ {P : Y.Opens} (h : P ≤ P) (x : Γ(Y, P)),
      (Y.presheaf.map (homOfLE h).op).hom x = x := by
    intro P h x
    rw [show (homOfLE h).op = 𝟙 (Opposite.op P) from Subsingleton.elim _ _,
      CategoryTheory.Functor.map_id]; rfl

  have AL1 : ∀ {P Q : Y.Opens} {V : (Spec (.of A)).Opens} (h : Q ≤ P) (e : V ≤ sY ⁻¹ᵁ Q)
      (x : Γ(Y, P)), (sY.appLE Q V e).hom ((Y.presheaf.map (homOfLE h).op).hom x) =
      (sY.appLE P V (e.trans (Scheme.Hom.preimage_mono sY h))).hom x := by
    intro P Q V h e x
    rw [← CommRingCat.comp_apply, Scheme.Hom.map_appLE]
  have AL2 : ∀ {P : Y.Opens} {V V' : (Spec (.of A)).Opens} (e : V ≤ sY ⁻¹ᵁ P) (h : V' ≤ V)
      (x : Γ(Y, P)), ((Spec (.of A)).presheaf.map (homOfLE h).op).hom ((sY.appLE P V e).hom x) =
      (sY.appLE P V' (h.trans e)).hom x := by
    intro P V V' e h x
    rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_map]
  have AL3 : ∀ {P : Y.Opens} (x : Γ(Y, P)),
      (sY.app P).hom x = (sY.appLE P (sY ⁻¹ᵁ P) le_rfl).hom x := by
    intro P x; rw [Scheme.Hom.app_eq_appLE]

  haveI : IsSeparated v := hsep
  haveI hYsep : Y.IsSeparated := by
    rw [Scheme.isSeparated_iff]
    have e : v ≫ Limits.terminal.from _ = Limits.terminal.from Y := Limits.terminal.hom_ext _ _
    rw [← e]; infer_instance
  have hAff : ∀ a, IsAffineOpen (L.V a ⊓ ⊤) := fun a => by rw [inf_top_eq]; exact hOK.1 a
  have hAff2 : ∀ a b, IsAffineOpen (L.V a ⊓ L.V b ⊓ ⊤) := fun a b => by
    rw [inf_top_eq]; exact (hOK.1 a).inf (hOK.1 b)
  have hAff3 : ∀ a b d, IsAffineOpen (L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤) := fun a b d => by
    rw [inf_top_eq]; exact ((hOK.1 a).inf (hOK.1 b)).inf (hOK.1 d)

  haveI : IsClosedImmersion (sY ≫ v) := by rw [hs]; infer_instance
  haveI : IsClosedImmersion sY := IsClosedImmersion.of_comp sY v
  have hsurj : ∀ O : Y.Opens, IsAffineOpen O → Function.Surjective (sY.app O).hom :=
    fun O hO => (isClosedImmersion_iff_isAffineHom.mp inferInstance).2 O hO

  obtain ⟨a₀, ha₀⟩ : ∃ a₀, sY (IsLocalRing.closedPoint A) ∈ L.V a₀ := by
    have h1 : sY (IsLocalRing.closedPoint A) ∈ (⨆ a, L.V a) := by rw [hOK.2.1]; trivial
    exact TopologicalSpace.Opens.mem_iSup.mp h1
  have H₀ : ∀ p, sY p ∈ L.V a₀ := fun p =>
    ((IsLocalRing.specializes_closedPoint p).map sY.continuous).mem_open (L.V a₀).isOpen ha₀
  have hle1 : ∀ a, sY ⁻¹ᵁ (L.V a ⊓ ⊤) ≤ sY ⁻¹ᵁ (L.V a₀ ⊓ L.V a) := by
    intro a x hx
    simp only [Scheme.Hom.mem_preimage, TopologicalSpace.Opens.mem_inf] at hx ⊢
    exact ⟨H₀ x, hx.1⟩

  choose s' hs' using fun a => hsurj _ (hAff a)
    ((sY.appLE (L.V a₀ ⊓ L.V a) (sY ⁻¹ᵁ (L.V a ⊓ ⊤)) (hle1 a)).hom (L.g a₀ a))
  have hS : ∀ (b : Fin L.m) {V : (Spec (.of A)).Opens} (e : V ≤ sY ⁻¹ᵁ (L.V b ⊓ ⊤)),
      (sY.appLE _ V e).hom (s' b) = (sY.appLE (L.V a₀ ⊓ L.V b) V (e.trans (hle1 b))).hom (L.g a₀ b) := by
    intro b V e
    rw [← AL2 le_rfl e, ← AL3, hs' b, AL2]

  have hWb : ∀ a b, L.V a ⊓ L.V b ⊓ (⊤ : Y.Opens) ≤ L.V b ⊓ ⊤ := fun a b =>
    le_inf (inf_le_left.trans inf_le_right) inf_le_right
  have hWa : ∀ a b, L.V a ⊓ L.V b ⊓ (⊤ : Y.Opens) ≤ L.V a ⊓ ⊤ := fun a b =>
    le_inf (inf_le_left.trans inf_le_left) inf_le_right

  obtain ⟨E, hE⟩ : ∃ E : ∀ a b, Γ(Y, L.V a ⊓ L.V b ⊓ ⊤), ∀ a b, E a b =
      (Y.presheaf.map (homOfLE (hWb a b)).op).hom (s' b) -
      (Y.presheaf.map (homOfLE (inf_le_left : L.V a ⊓ L.V b ⊓ (⊤ : Y.Opens) ≤ L.V a ⊓ L.V b)).op).hom
        (L.g a b : Γ(Y, L.V a ⊓ L.V b)) *
      (Y.presheaf.map (homOfLE (hWa a b)).op).hom (s' a) := ⟨_, fun _ _ => rfl⟩
  have hdef : ∀ a b, (sY.app (L.V a ⊓ L.V b ⊓ ⊤)).hom (E a b) = 0 := by
    intro a b
    have eT : sY ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ ⊤) ≤ sY ⁻¹ᵁ (L.V a₀ ⊓ L.V a ⊓ L.V b) := by
      intro x hx
      simp only [Scheme.Hom.mem_preimage, TopologicalSpace.Opens.mem_inf] at hx ⊢
      exact ⟨⟨H₀ x, hx.1.1⟩, hx.1.2⟩
    have hc := congrArg (sY.appLE _ _ eT).hom (hOK.2.2.2 a₀ a b)
    rw [map_mul, AL1, AL1, AL1] at hc
    rw [hE, AL3, map_sub, map_mul, AL1, AL1, AL1, hS, hS, ← hc]
    ring

  have hdiv : ∀ a b, ∃ c : Γ(Y, L.V a ⊓ L.V b ⊓ ⊤),
      c * (Y.presheaf.map (homOfLE (hWb a b)).op).hom (t b) = E a b := by
    intro a b
    exact Ideal.mem_span_singleton'.mp (((hgen b _ (hAff2 a b) (hWb a b)).2 (E a b)).mp (hdef a b))
  choose c hc using hdiv

  have hX1 : ∀ a b d, L.V a ⊓ L.V b ⊓ L.V d ⊓ (⊤ : Y.Opens) ≤ L.V a ⊓ L.V d ⊓ ⊤ := by
    intro a b d x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto
  have hX2 : ∀ a b d, L.V a ⊓ L.V b ⊓ L.V d ⊓ (⊤ : Y.Opens) ≤ L.V b ⊓ L.V d ⊓ ⊤ := by
    intro a b d x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto
  have hX4 : ∀ a b d, L.V a ⊓ L.V b ⊓ L.V d ⊓ (⊤ : Y.Opens) ≤ L.V a ⊓ L.V b ⊓ ⊤ := by
    intro a b d x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto
  have hX0 : ∀ a b d, L.V a ⊓ L.V b ⊓ L.V d ⊓ (⊤ : Y.Opens) ≤ L.V a ⊓ L.V b ⊓ L.V d := by
    intro a b d x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto
  have hXd : ∀ a b d, L.V a ⊓ L.V b ⊓ L.V d ⊓ (⊤ : Y.Opens) ≤ L.V d ⊓ ⊤ := by
    intro a b d x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto
  have hXa : ∀ a b d, L.V a ⊓ L.V b ⊓ L.V d ⊓ (⊤ : Y.Opens) ≤ L.V a ⊓ ⊤ := by
    intro a b d x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto
  have hXb : ∀ a b d, L.V a ⊓ L.V b ⊓ L.V d ⊓ (⊤ : Y.Opens) ≤ L.V b ⊓ ⊤ := by
    intro a b d x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto
  have hX3 : ∀ a b d, L.V a ⊓ L.V b ⊓ L.V d ⊓ (⊤ : Y.Opens) ≤ L.V b ⊓ L.V d := by
    intro a b d x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto
  have hcoc : ∀ a b d, (Y.presheaf.map (homOfLE (hX1 a b d)).op).hom (c a d) =
      (Y.presheaf.map (homOfLE (hX2 a b d)).op).hom (c b d) +
      (Y.presheaf.map (homOfLE (hX4 a b d)).op).hom (c a b) := by
    intro a b d
    have hnz := (hgen d _ (hAff3 a b d) (hXd a b d)).1
    have e1 := congrArg (Y.presheaf.map (homOfLE (hX1 a b d)).op).hom (hc a d)
    have e2 := congrArg (Y.presheaf.map (homOfLE (hX2 a b d)).op).hom (hc b d)
    have e3 := congrArg (Y.presheaf.map (homOfLE (hX4 a b d)).op).hom (hc a b)
    have e4 := congrArg (Y.presheaf.map (homOfLE (hX2 a b d)).op).hom (hCt b d)
    have e5 := congrArg (Y.presheaf.map (homOfLE (hX0 a b d)).op).hom (hOK.2.2.2 a b d)
    rw [hE] at e1 e2 e3
    simp only [map_mul, map_sub, map_pow, pow_one, rr] at e1 e2 e3 e4 e5
    have key : ((Y.presheaf.map (homOfLE (hX1 a b d)).op).hom (c a d) -
        (Y.presheaf.map (homOfLE (hX2 a b d)).op).hom (c b d) -
        (Y.presheaf.map (homOfLE (hX4 a b d)).op).hom (c a b)) *
        (Y.presheaf.map (homOfLE (hXd a b d)).op).hom (t d) = 0 := by
      linear_combination e1 - e2 - (Y.presheaf.map (homOfLE (hX4 a b d)).op).hom (c a b) * e4
        - (Y.presheaf.map (homOfLE (hX3 a b d)).op).hom (L.g b d : Γ(Y, L.V b ⊓ L.V d)) * e3
        + (Y.presheaf.map (homOfLE (hXa a b d)).op).hom (s' a) * e5
    have h0 := (mem_nonZeroDivisors_iff.mp hnz).2 _ key
    linear_combination h0

  obtain ⟨β, hβ⟩ := hH (fun a b => c a b) (by
    intro a b d
    simp only [pow_zero, one_smul]
    exact hcoc a b d)
  obtain ⟨β', hβ'⟩ : ∃ β' : ∀ a, Γ(Y, L.V a ⊓ ⊤), ∀ a b, c a b =
      (Y.presheaf.map (homOfLE (hWb a b)).op).hom (β' b) -
      (Y.presheaf.map (homOfLE (hWa a b)).op).hom (β' a) := by
    refine ⟨fun a => β a, fun a b => ?_⟩
    have h1 := hβ a b
    simp only [pow_zero, one_smul] at h1
    exact h1

  have ht0 : ∀ a, (sY.app (L.V a ⊓ ⊤)).hom (t a) = 0 := by
    intro a
    refine ((hgen a _ (hAff a) le_rfl).2 (t a)).mpr ?_
    rw [rid]
    exact Ideal.mem_span_singleton_self _
  refine ⟨fun a => s' a - β' a * t a, ?_, ?_⟩
  · intro a b
    have D := hc a b
    rw [hE] at D
    have Et := hCt a b
    simp only [map_pow, pow_one] at Et
    simp only [map_sub, map_mul, map_pow, pow_one]
    linear_combination -D + (Y.presheaf.map (homOfLE (hWb a b)).op).hom (t b) * hβ' a b
      - (Y.presheaf.map (homOfLE (hWa a b)).op).hom (β' a) * Et
  · intro a q hq
    have hq' : q ∈ sY ⁻¹ᵁ (L.V a ⊓ ⊤) := by
      simp only [Scheme.Hom.mem_preimage, TopologicalSpace.Opens.mem_inf]
      exact ⟨hq, trivial⟩
    have hunit : IsUnit ((sY.app (L.V a ⊓ ⊤)).hom (s' a - β' a * t a)) := by
      rw [map_sub, map_mul, ht0 a, mul_zero, sub_zero, hs' a]
      exact (L.g a₀ a).isUnit.map _
    show q ∈ sY ⁻¹ᵁ Y.basicOpen (s' a - β' a * t a)
    rw [Scheme.preimage_basicOpen, Scheme.basicOpen_of_isUnit _ hunit]
    exact hq'

theorem wcpa_dj_p1rm_charts : ∀ (A : Type u) [CommRing A], ∃ (j c : Spec (.of (Polynomial A)) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra), IsOpenImmersion j ∧ IsOpenImmersion c ∧ IsPullback (Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A)) (LaurentPolynomial.T (-1))))) (Spec.map (CommRingCat.ofHom (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A))) j c ∧ j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0))) = Spec.map (CommRingCat.ofHom (Polynomial.C : A →+* Polynomial A)) ∧ c ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0))) = Spec.map (CommRingCat.ofHom (Polynomial.C : A →+* Polynomial A)) :=
by
  intro A _
  let 𝒜 : ℕ → Submodule A (MvPolynomial (Fin 2) A) := MvPolynomial.homogeneousSubmodule (Fin 2) A
  let _inst𝒜 : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra

  have fin2 : ∀ a b c : Fin 2, a ≠ b → c ≠ a → c = b := by decide
  have hX : ∀ i : Fin 2, (MvPolynomial.X i : MvPolynomial (Fin 2) A) ∈ 𝒜 1 := fun i =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X A i)
  have h11 : ∀ k : Fin 2, (MvPolynomial.X k : MvPolynomial (Fin 2) A) ∈ 𝒜 (1 • 1) := fun k => by
    rw [smul_eq_mul, mul_one]; exact hX k

  have s1 : ∀ {T : Type u} [CommRing T] (f : A →+* T) (g : Fin 2 → T) (c : T)
      (φ : MvPolynomial (Fin 2) A) (n : ℕ), φ.IsHomogeneous n →
      MvPolynomial.eval₂ f (fun i => c * g i) φ = c ^ n * MvPolynomial.eval₂ f g φ := by
    intro T _ f g c φ n hφ
    conv_lhs => rw [φ.as_sum]
    conv_rhs => rw [φ.as_sum]
    rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun d hd => ?_)
    rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
    have hdeg : ∑ i ∈ d.support, d i = n := by
      have := hφ (MvPolynomial.mem_support_iff.mp hd)
      simpa [Finsupp.weight_apply, Finsupp.sum] using this
    simp only [Finsupp.prod, mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
    ring
  have hval0 : ∀ (f : MvPolynomial (Fin 2) A) (a : ↥(𝒜 0)),
      (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f) a).val =
        algebraMap (MvPolynomial (Fin 2) A) (Localization.Away f) (a : MvPolynomial (Fin 2) A) := by
    intro f a
    rfl
  have hcoe0 : ∀ r : A, ((algebraMap A (𝒜 0) r : ↥(𝒜 0)) : MvPolynomial (Fin 2) A) = MvPolynomial.C r := by
    intro r
    rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]

  have chart : ∀ i k : Fin 2, i ≠ k → ∃ e : Polynomial A ≃+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i),
      (∀ r : A, e (Polynomial.C r) = HomogeneousLocalization.fromZeroRingHom 𝒜
        (Submonoid.powers (MvPolynomial.X i)) (algebraMap A (𝒜 0) r)) ∧
      e Polynomial.X = HomogeneousLocalization.Away.mk 𝒜 (hX i) 1 (MvPolynomial.X k) (h11 k) := by
    intro i k hik
    obtain ⟨κ, hκ⟩ : ∃ κ : A →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i),
        κ = (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X i))).comp
          (algebraMap A (𝒜 0)) := ⟨_, rfl⟩
    obtain ⟨α, hα⟩ : ∃ α : Polynomial A →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i),
        α = Polynomial.eval₂RingHom κ
          (HomogeneousLocalization.Away.mk 𝒜 (hX i) 1 (MvPolynomial.X k) (h11 k)) := ⟨_, rfl⟩
    obtain ⟨ψ, hψ⟩ : ∃ ψ : MvPolynomial (Fin 2) A →+* Polynomial A,
        ψ = MvPolynomial.eval₂Hom Polynomial.C (fun j => if j = i then 1 else Polynomial.X) := ⟨_, rfl⟩
    have hψi : ψ (MvPolynomial.X i) = 1 := by rw [hψ, MvPolynomial.eval₂Hom_X', if_pos rfl]
    have hψk : ψ (MvPolynomial.X k) = Polynomial.X := by
      rw [hψ, MvPolynomial.eval₂Hom_X', if_neg (Ne.symm hik)]
    have hψC : ∀ r, ψ (MvPolynomial.C r) = Polynomial.C r := by
      intro r; rw [hψ, MvPolynomial.eval₂Hom_C]
    have hψv : ψ (MvPolynomial.X i) * 1 = 1 := by rw [hψi, mul_one]
    have hu : IsUnit (ψ (MvPolynomial.X i)) := by rw [hψi]; exact isUnit_one
    obtain ⟨χ, hχ⟩ : ∃ χ : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i) →+* Polynomial A,
        χ = (Localization.awayLift ψ (MvPolynomial.X i) hu).comp
          (algebraMap (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i))
            (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))) := ⟨_, rfl⟩
    have hχmk : ∀ (n : ℕ) (a : MvPolynomial (Fin 2) A) (ha : a ∈ 𝒜 (n • 1)),
        χ (HomogeneousLocalization.Away.mk 𝒜 (hX i) n a ha) = ψ a := by
      intro n a ha
      rw [hχ, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk, Localization.awayLift_mk ψ (MvPolynomial.X i) a 1 hψv n,
        one_pow, mul_one]
    have hκv : ∀ r, (κ r).val = algebraMap (MvPolynomial (Fin 2) A)
        (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.C r) := by
      intro r
      rw [hκ, RingHom.comp_apply, hval0, hcoe0]
    have h1 : χ.comp α = RingHom.id _ := by
      apply Polynomial.ringHom_ext
      · intro r
        rw [RingHom.comp_apply, hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hχ,
          RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply, hκv]
        first
          | rw [IsLocalization.lift_eq]
          | erw [IsLocalization.lift_eq]
        rw [hψC, RingHom.id_apply]
      · rw [RingHom.comp_apply, hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, hχmk, hψk,
          RingHom.id_apply]
    have h2 : α.comp χ = RingHom.id _ := by
      refine RingHom.ext fun w => ?_
      obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX i) w
      rw [RingHom.comp_apply, hχmk, RingHom.id_apply]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk]
      have ha' : a.IsHomogeneous n := by
        have := (MvPolynomial.mem_homogeneousSubmodule _ a).1 ha
        simpa using this
      obtain ⟨μ, hμdef⟩ : ∃ μ : Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A),
          μ = IsLocalization.mk' (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))
            (1 : MvPolynomial (Fin 2) A) ⟨MvPolynomial.X i, Submonoid.mem_powers _⟩ := ⟨_, rfl⟩
      have hμ : μ * algebraMap (MvPolynomial (Fin 2) A)
          (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X i) = 1 := by
        have := IsLocalization.mk'_spec (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))
          (1 : MvPolynomial (Fin 2) A) ⟨MvPolynomial.X i, Submonoid.mem_powers _⟩
        rw [map_one] at this
        rw [hμdef]; exact this
      have hρ : (algebraMap (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i))
            (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))).comp (α.comp ψ) =
          MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin 2) A)
            (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))).comp MvPolynomial.C)
            (fun j => μ * algebraMap (MvPolynomial (Fin 2) A)
              (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X j)) := by
        apply MvPolynomial.ringHom_ext
        · intro r
          simp only [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
          rw [hψC, hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C,
            HomogeneousLocalization.algebraMap_apply, hκv]
        · intro j
          simp only [MvPolynomial.eval₂Hom_X', RingHom.comp_apply]
          by_cases hj : j = i
          · subst hj
            rw [hψi, map_one, map_one, hμ]
          · have hjk : j = k := fin2 i k j hik hj
            subst hjk
            rw [hψk, hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
              HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
              Localization.mk_eq_mk'_apply, IsLocalization.mk'_eq_iff_eq_mul]
            show _ = μ * _ * algebraMap (MvPolynomial (Fin 2) A)
              (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X i ^ 1)
            rw [pow_one, mul_comm μ, mul_assoc, hμ, mul_one]
      have hσ : MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin 2) A)
            (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))).comp MvPolynomial.C)
            (fun j => algebraMap (MvPolynomial (Fin 2) A)
              (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X j)) =
          algebraMap (MvPolynomial (Fin 2) A)
            (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) := by
        apply MvPolynomial.ringHom_ext
        · intro r; simp only [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
        · intro j; simp only [MvPolynomial.eval₂Hom_X']
      have hval : (α (ψ a)).val = ((algebraMap (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i))
            (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))).comp (α.comp ψ)) a := by
        rw [RingHom.comp_apply, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
      rw [hval, hρ, MvPolynomial.coe_eval₂Hom, s1 _ (fun j => algebraMap (MvPolynomial (Fin 2) A)
          (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X j)) μ a n ha',
        ← MvPolynomial.coe_eval₂Hom, hσ, Localization.mk_eq_mk'_apply, eq_comm,
        IsLocalization.mk'_eq_iff_eq_mul]
      show _ = μ ^ n * _ * algebraMap (MvPolynomial (Fin 2) A)
        (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X i ^ n)
      rw [map_pow, mul_comm (μ ^ n), mul_assoc, ← mul_pow, hμ, one_pow, mul_one]
    refine ⟨RingEquiv.ofRingHom α χ h2 h1, ?_, ?_⟩
    · intro r
      show α (Polynomial.C r) = _
      rw [hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hκ, RingHom.comp_apply]
    · show α Polynomial.X = _
      rw [hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]

  have specIso : ∀ {R R' : Type u} [CommRing R] [CommRing R'] (e : R ≃+* R'),
      ∃ E : Spec (CommRingCat.of R') ≅ Spec (CommRingCat.of R),
        E.hom = Spec.map (CommRingCat.ofHom e.toRingHom) ∧
        E.inv = Spec.map (CommRingCat.ofHom e.symm.toRingHom) := by
    intro R R' _ _ e
    refine ⟨⟨Spec.map (CommRingCat.ofHom e.toRingHom), Spec.map (CommRingCat.ofHom e.symm.toRingHom),
      ?_, ?_⟩, rfl, rfl⟩
    · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, RingEquiv.toRingHom_comp_symm_toRingHom,
        CommRingCat.ofHom_id, Spec.map_id]
    · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, RingEquiv.symm_toRingHom_comp_toRingHom,
        CommRingCat.ofHom_id, Spec.map_id]
  obtain ⟨e0, he0C, he0X⟩ := chart 0 1 (by decide)
  obtain ⟨e1, he1C, he1X⟩ := chart 1 0 (by decide)

  have hstr : ∀ (i : Fin 2) (e : Polynomial A ≃+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i)),
      (∀ r : A, e (Polynomial.C r) = HomogeneousLocalization.fromZeroRingHom 𝒜
        (Submonoid.powers (MvPolynomial.X i)) (algebraMap A (𝒜 0) r)) →
      (Spec.map (CommRingCat.ofHom e.symm.toRingHom) ≫ Proj.awayι 𝒜 (MvPolynomial.X i) (hX i) one_pos) ≫
        Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom (algebraMap A ↥(𝒜 0))) =
        Spec.map (CommRingCat.ofHom (Polynomial.C : A →+* Polynomial A)) := by
    intro i e he
    rw [Category.assoc, ← Category.assoc (Proj.awayι 𝒜 (MvPolynomial.X i) (hX i) one_pos),
      Proj.awayι_toSpecZero, ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← CommRingCat.ofHom_comp]
    congr 2
    refine RingHom.ext fun r => ?_
    show e.symm (HomogeneousLocalization.fromZeroRingHom 𝒜
        (Submonoid.powers (MvPolynomial.X i)) (algebraMap A (𝒜 0) r)) = Polynomial.C r
    rw [← he r, RingEquiv.symm_apply_apply]

  have hx' : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
      MvPolynomial.X 1 * MvPolynomial.X 0 := mul_comm _ _
  letI alg : Algebra (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1))
      (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0 * MvPolynomial.X 1)) :=
    (HomogeneousLocalization.awayMap 𝒜 (hX 0) hx').toAlgebra
  haveI hloc : IsLocalization.Away (HomogeneousLocalization.Away.isLocalizationElem (hX 1) (hX 0))
      (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0 * MvPolynomial.X 1)) :=
    HomogeneousLocalization.Away.isLocalization_mul (hX 1) (hX 0) hx' one_ne_zero
  have helem : e1 Polynomial.X = HomogeneousLocalization.Away.isLocalizationElem (hX 1) (hX 0) := by
    rw [he1X]
    apply HomogeneousLocalization.val_injective
    simp only [HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.val_mk,
      pow_one]
  have H : Submonoid.map e1.toMonoidHom (Submonoid.powers (Polynomial.X : Polynomial A)) =
      Submonoid.powers (HomogeneousLocalization.Away.isLocalizationElem (hX 1) (hX 0)) := by
    rw [Submonoid.map_powers]
    exact congrArg Submonoid.powers helem
  obtain ⟨e01, he01⟩ : ∃ e01 : LaurentPolynomial A ≃+*
      HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0 * MvPolynomial.X 1),
      e01 = IsLocalization.ringEquivOfRingEquiv (LaurentPolynomial A)
        (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0 * MvPolynomial.X 1)) e1 H := ⟨_, rfl⟩
  have Sq2 : e01.toRingHom.comp (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A) =
      (HomogeneousLocalization.awayMap 𝒜 (hX 0) hx').comp e1.toRingHom := by
    refine RingHom.ext fun p => ?_
    show e01 (Polynomial.toLaurent p) = HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 p)
    rw [← LaurentPolynomial.algebraMap_eq_toLaurent, he01, IsLocalization.ringEquivOfRingEquiv_eq]
    rfl
  have hS2' : ∀ p : Polynomial A, e01 (Polynomial.toLaurent p) =
      HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 p) := fun p => by
    have := congrArg (fun φ => φ p) Sq2
    exact this
  have hCL : ∀ r : A, Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
      (LaurentPolynomial.T (-1)) (Polynomial.C r) = Polynomial.toLaurent (Polynomial.C r) := by
    intro r
    rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
    first
      | rfl
      | simp [Polynomial.toLaurent_C, LaurentPolynomial.algebraMap_apply]
  have Sq1 : e01.toRingHom.comp (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
        (LaurentPolynomial.T (-1))) =
      (HomogeneousLocalization.awayMap 𝒜 (hX 1)
        (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
          MvPolynomial.X 0 * MvPolynomial.X 1)).comp e0.toRingHom := by
    apply Polynomial.ringHom_ext
    · intro r
      show e01 (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
        (LaurentPolynomial.T (-1)) (Polynomial.C r)) = HomogeneousLocalization.awayMap 𝒜 (hX 1)
        (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
          MvPolynomial.X 0 * MvPolynomial.X 1) (e0 (Polynomial.C r))
      rw [hCL, hS2', he0C, he1C, HomogeneousLocalization.awayMap_fromZeroRingHom,
        HomogeneousLocalization.awayMap_fromZeroRingHom]
    · show e01 (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
        (LaurentPolynomial.T (-1)) Polynomial.X) = HomogeneousLocalization.awayMap 𝒜 (hX 1)
        (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
          MvPolynomial.X 0 * MvPolynomial.X 1) (e0 Polynomial.X)
      have hT1 : e01 (LaurentPolynomial.T 1) =
          HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 Polynomial.X) := by
        rw [← Polynomial.toLaurent_X]; exact hS2' _
      have hK : HomogeneousLocalization.awayMap 𝒜 (hX 1)
            (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
              MvPolynomial.X 0 * MvPolynomial.X 1) (e0 Polynomial.X) *
          HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 Polynomial.X) = 1 := by
        rw [he0X, he1X, HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk]
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_one,
          HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, Localization.mk_mul,
          ← Localization.mk_one, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
        refine ⟨1, ?_⟩
        simp only [Submonoid.coe_mul, OneMemClass.coe_one, one_mul, mul_one, pow_one]
        ring
      have hb : e01 (LaurentPolynomial.T (-1)) * e01 (LaurentPolynomial.T 1) = 1 := by
        rw [← map_mul, ← LaurentPolynomial.T_add, show (-1 : ℤ) + 1 = 0 by norm_num,
          LaurentPolynomial.T_zero, map_one]
      rw [hT1] at hb
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      calc e01 (LaurentPolynomial.T (-1))
          = e01 (LaurentPolynomial.T (-1)) * (HomogeneousLocalization.awayMap 𝒜 (hX 1)
            (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
              MvPolynomial.X 0 * MvPolynomial.X 1) (e0 Polynomial.X) *
            HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 Polynomial.X)) := by rw [hK, mul_one]
        _ = HomogeneousLocalization.awayMap 𝒜 (hX 1)
            (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
              MvPolynomial.X 0 * MvPolynomial.X 1) (e0 Polynomial.X) *
            (e01 (LaurentPolynomial.T (-1)) *
              HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 Polynomial.X)) := by ring
        _ = _ := by rw [hb, mul_one]

  obtain ⟨E0, hE0, hE0i⟩ := specIso e0
  obtain ⟨E1, hE1, hE1i⟩ := specIso e1
  obtain ⟨E01, hE01, _⟩ := specIso e01
  obtain ⟨j, hj⟩ : ∃ j : Spec (CommRingCat.of (Polynomial A)) ⟶ Proj 𝒜,
      j = E0.inv ≫ Proj.awayι 𝒜 (MvPolynomial.X 0) (hX 0) one_pos := ⟨_, rfl⟩
  obtain ⟨c, hc⟩ : ∃ c : Spec (CommRingCat.of (Polynomial A)) ⟶ Proj 𝒜,
      c = E1.inv ≫ Proj.awayι 𝒜 (MvPolynomial.X 1) (hX 1) one_pos := ⟨_, rfl⟩
  have hj0 : E0.hom ≫ j = Proj.awayι 𝒜 (MvPolynomial.X 0) (hX 0) one_pos := by
    rw [hj, Iso.hom_inv_id_assoc]
  have hc0 : E1.hom ≫ c = Proj.awayι 𝒜 (MvPolynomial.X 1) (hX 1) one_pos := by
    rw [hc, Iso.hom_inv_id_assoc]
  refine ⟨j, c, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hj]; infer_instance
  · rw [hc]; infer_instance
  · refine IsPullback.of_iso (IsPullback.of_hasPullback
      (Proj.awayι 𝒜 (MvPolynomial.X 0) (hX 0) one_pos) (Proj.awayι 𝒜 (MvPolynomial.X 1) (hX 1) one_pos))
      (Proj.pullbackAwayιIso 𝒜 (hX 0) one_pos (hX 1) one_pos rfl ≪≫ E01) E0 E1 (Iso.refl _)
      ?_ ?_ ?_ ?_
