      rw [sub_add_cancel, hU c hc] at h1
      exact h1
    have hx0 : x ≠ 0 := by
      rintro rfl
      rw [Valuation.map_zero] at hvx
      exact zero_ne_one hvx
    have hinv : x⁻¹ * x = 1 := inv_mul_cancel₀ hx0
