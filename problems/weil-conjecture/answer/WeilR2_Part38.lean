theorem wcpa_dj_cgs_column_vanish : ∀ (X Z : Scheme.{u}) [IsLocallyNoetherian X] (p : Z ⟶ X) (m : ℕ) (g : Z ⟶ wcPm.{u} m) (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)), wcGsCoords m e → IsClosedImmersion (Limits.prod.lift p g) → ∀ W : X.Opens, IsAffineOpen W → ∃ w₀ : ℕ, ∀ w : ℕ, w₀ ≤ w → ∀ (L : Z.Modules) (φ : ∀ (k : Fin (m + 1)) (O : Z.Opens), O ≤ g ⁻¹ᵁ wcPmChart m k → (Γ(L, O) →+ Γ(wcStructMod Z, O))), wcGsTw g e w L φ → ∀ (q : ℕ) (z : wcAcC L (fun k => g ⁻¹ᵁ wcPmChart m k) (p ⁻¹ᵁ W) (q + 1)), wcAcD L (fun k => g ⁻¹ᵁ wcPmChart m k) (p ⁻¹ᵁ W) (q + 1) z = 0 → ∃ x, z = wcAcD L (fun k => g ⁻¹ᵁ wcPmChart m k) (p ⁻¹ᵁ W) q x :=
by
  intro X Z _ p m g e he hΛ W hW
  haveI hA : IsNoetherianRing Γ(X, W) := IsLocallyNoetherian.component_noetherian ⟨W, hW⟩
  have hc8 := fun k => wcpa_dj_cgs_chart_affine_gen X Z p m g e he hΛ W k hW
  obtain ⟨K, hKgr, hmod⟩ := wcpa_dj_cgs_laurent_model Z m g e he (p ⁻¹ᵁ W) Γ(X, W)
    (p.app W).hom (fun k => (hc8 k).1) (fun k => (hc8 k).2)
  choose W₀ hW₀ using fun (j : ℕ) (hj : 1 ≤ j) =>
    wc_cn_laurent_serre_vanishing Γ(X, W) (m + 1) 1 (fun _ => 0) K hKgr j hj
  refine ⟨(Finset.range (m + 1)).sup (fun j => if hj : 1 ≤ j then (W₀ j hj).toNat else 0), ?_⟩
  intro w hw L φ hTw q z hz

  by_cases hqm : q + 1 ≤ m
  swap
  · refine ⟨0, ?_⟩
    funext a
    exfalso
    have := Fintype.card_le_of_embedding a.toEmbedding
    simp only [Fintype.card_fin] at this
    omega
  obtain ⟨Θ, hΘ⟩ := hmod w L φ hTw
  obtain ⟨M1, -, -, M4, M5, M6⟩ := hΘ

  have hsub : ∀ (t : Finset (Fin (m + 1))) (a b : Fin 1 → (Fin (m + 1) → ℤ) →₀ Γ(X, W)),
      a ∈ wcLaurC Γ(X, W) (m + 1) 1 (fun _ => 0) (w : ℤ) t →
      b ∈ wcLaurC Γ(X, W) (m + 1) 1 (fun _ => 0) (w : ℤ) t →
      a - b ∈ wcLaurC Γ(X, W) (m + 1) 1 (fun _ => 0) (w : ℤ) t := by
    intro t a b ha hb
    simp only [wcLaurC, Set.mem_setOf_eq] at ha hb ⊢
    intro r
    exact Submodule.sub_mem _ (ha r) (hb r)
  have hdelta : ∀ (c : ℕ) (y : Finset (Fin (m + 1)) → Fin 1 → (Fin (m + 1) → ℤ) →₀ Γ(X, W)),
      (∀ σ : Finset (Fin (m + 1)), σ.card = c →
        y σ ∈ wcLaurC Γ(X, W) (m + 1) 1 (fun _ => 0) (w : ℤ) σ) →
      ∀ t : Finset (Fin (m + 1)), t.card = c + 1 →
        wcAltD (A := Γ(X, W)) (m + 1) y t ∈ wcLaurC Γ(X, W) (m + 1) 1 (fun _ => 0) (w : ℤ) t := by
    intro c y hy t ht
    simp only [wcLaurC, Set.mem_setOf_eq] at hy ⊢
    intro r
    unfold wcAltD
    rw [Finset.sum_apply]
    refine Submodule.sum_mem _ (fun i hi => ?_)
    rw [Pi.smul_apply]
    have h1 := hy (t.erase i) (by rw [Finset.card_erase_of_mem hi]; omega) r
    have hsubset : {β : Fin (m + 1) → ℤ | ∑ l, β l = (w : ℤ) - ((fun _ : Fin 1 => (0 : ℕ)) r : ℤ) ∧
          ∀ l ∉ t.erase i, 0 ≤ β l} ⊆
        {β : Fin (m + 1) → ℤ | ∑ l, β l = (w : ℤ) - ((fun _ : Fin 1 => (0 : ℕ)) r : ℤ) ∧
          ∀ l ∉ t, 0 ≤ β l} := by
      intro β hβ
      exact ⟨hβ.1, fun j hj => hβ.2 j (fun h => hj (Finset.erase_subset i t h))⟩
    have h2 := Finsupp.supported_mono (R := Γ(X, W)) (M := Γ(X, W)) hsubset h1
    first
      | exact Submodule.smul_mem _ _ h2
      | exact Submodule.smul_of_tower_mem _ _ h2

  obtain ⟨v, hv, rfl⟩ := M4 (q + 1) z
  have hu : ∀ τ : Finset (Fin (m + 1)), τ.card = q + 1 + 1 + 1 →
      wcAltD (A := Γ(X, W)) (m + 1) v τ ∈ wcLaurC Γ(X, W) (m + 1) 1 (fun _ => 0) (w : ℤ) τ :=
    hdelta (q + 1 + 1) v (fun σ hσ => (hv σ).1 hσ)
  have hΘu : Θ (q + 1 + 1) (wcAltD (A := Γ(X, W)) (m + 1) v) = 0 := by
    rw [M6 (q + 1) v (fun s hs => (hv s).1 hs)]
    exact hz
  have hK := (M5 (q + 1 + 1) _ hu).mp hΘu
  have hj1 : 1 ≤ q + 1 := by omega
  have hthr : W₀ (q + 1) hj1 ≤ (w : ℤ) := by
    have h1 := Finset.le_sup (f := fun j => if hj : 1 ≤ j then (W₀ j hj).toNat else 0)
      (Finset.mem_range.mpr (show q + 1 < m + 1 by omega))
    simp only [dif_pos hj1] at h1
    have h2 := Int.self_le_toNat (W₀ (q + 1) hj1)
    have h3 : ((W₀ (q + 1) hj1).toNat : ℤ) ≤ (w : ℤ) := by exact_mod_cast h1.trans hw
    omega
  obtain ⟨y, hy, hyK⟩ := hW₀ (q + 1) hj1 (w : ℤ) hthr v (fun σ => hv σ)
    (fun τ hτ => hK τ (by omega))
  refine ⟨Θ q y, ?_⟩
  have hdy : ∀ σ : Finset (Fin (m + 1)), σ.card = q + 1 + 1 →
      wcAltD (A := Γ(X, W)) (m + 1) y σ ∈ wcLaurC Γ(X, W) (m + 1) 1 (fun _ => 0) (w : ℤ) σ :=
    hdelta (q + 1) y (fun σ hσ => (hy σ).1 hσ)
  have hdiff : Θ (q + 1) (v - wcAltD (A := Γ(X, W)) (m + 1) y) = 0 := by
    refine (M5 (q + 1) _ ?_).mpr ?_
    · intro s hs
      exact hsub s _ _ ((hv s).1 hs) (hdy s hs)
    · intro s hs
      exact hyK s hs
  calc Θ (q + 1) v
      = Θ (q + 1) ((v - wcAltD (A := Γ(X, W)) (m + 1) y) + wcAltD (A := Γ(X, W)) (m + 1) y) := by
        rw [sub_add_cancel]
    _ = Θ (q + 1) (v - wcAltD (A := Γ(X, W)) (m + 1) y) +
          Θ (q + 1) (wcAltD (A := Γ(X, W)) (m + 1) y) := M1 _ _ _
    _ = wcAcD L (fun k => g ⁻¹ᵁ wcPmChart m k) (p ⁻¹ᵁ W) q (Θ q y) := by
        rw [hdiff, zero_add, M6 q y (fun s hs => (hy s).1 hs)]

theorem wcpa_dj_cgs_gen_rank_one : ∀ (X Z : Scheme.{u}) (p : Z ⟶ X) [IsProper p] [IsReduced Z] (m : ℕ) (g : Z ⟶ wcPm.{u} m) (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)) (w : ℕ) (L : Z.Modules) (φ : ∀ (k : Fin (m + 1)) (O : Z.Opens), O ≤ g ⁻¹ᵁ wcPmChart m k → (Γ(L, O) →+ Γ(wcStructMod Z, O))) (T : TopologicalSpace.Closeds X), wcGsTw g e w L φ → (∀ z : Z, ∃ k, z ∈ g ⁻¹ᵁ wcPmChart m k) → Set.range p ⊆ (T : Set X) → ∀ U₀ : X.Opens, IsAffineOpen U₀ → ((U₀ : Set X) ∩ T).Nonempty → IsClosedImmersion (p ∣_ U₀) → (∀ x ∈ U₀, x ∈ T → x ∈ Set.range p) → wcGenRankOne ((Scheme.Modules.pushforward p).obj L) T :=
by
  intro X Z p _ _ m g e w L φ T hTw hDc hrange U₀ hU₀ hne hpU₀ hpts
  refine ⟨?_, ?_⟩
  ·
    intro U hU s
    have hbot : p ⁻¹ᵁ U = ⊥ := by
      apply eq_bot_iff.mpr
      intro z hz
      rw [Scheme.Hom.mem_preimage] at hz
      exact (Set.disjoint_left.mp hU hz (hrange ⟨z, rfl⟩)).elim
    have h0 : p ⁻¹ᵁ U ≤ g ⁻¹ᵁ wcPmChart m 0 := by rw [hbot]; exact bot_le
    have hinj := (hTw.1 0 _ h0).1
    haveI hss : Subsingleton Γ(Z, p ⁻¹ᵁ U) :=
      CommRingCat.subsingleton_of_isTerminal (TopCat.Sheaf.isTerminalOfEqEmpty Z.sheaf hbot)
    apply hinj
    exact @Subsingleton.elim Γ(Z, p ⁻¹ᵁ U) hss _ _
  · obtain ⟨x, hxU₀, hxT⟩ := hne
    obtain ⟨z, rfl⟩ := hpts x hxU₀ hxT
    obtain ⟨k, hk⟩ := hDc z

    have hC : IsClosed (p '' ((g ⁻¹ᵁ wcPmChart m k : Z.Opens) : Set Z)ᶜ) :=
      p.isClosedMap _ (g ⁻¹ᵁ wcPmChart m k).isOpen.isClosed_compl
    have hzC : p z ∉ p '' ((g ⁻¹ᵁ wcPmChart m k : Z.Opens) : Set Z)ᶜ := by
      rintro ⟨z', hz'D, hz'z⟩
      have hz'U : z' ∈ p ⁻¹ᵁ U₀ := by rw [Scheme.Hom.mem_preimage, hz'z]; exact hxU₀
      have hzU : z ∈ p ⁻¹ᵁ U₀ := by rw [Scheme.Hom.mem_preimage]; exact hxU₀
      have hEq : (⟨z', hz'U⟩ : p ⁻¹ᵁ U₀) = ⟨z, hzU⟩ := by
        apply (p ∣_ U₀).isClosedEmbedding.injective
        apply Subtype.ext
        have h1 := morphismRestrict_base_coe p U₀ ⟨z', hz'U⟩
        have h2 := morphismRestrict_base_coe p U₀ ⟨z, hzU⟩
        exact h1.trans (hz'z.trans h2.symm)
      have h' : z' = z := congrArg Subtype.val hEq
      apply hz'D
      rw [h']
      exact hk
    let V : X.Opens := ⟨(p '' ((g ⁻¹ᵁ wcPmChart m k : Z.Opens) : Set Z)ᶜ)ᶜ, hC.isOpen_compl⟩
    obtain ⟨f, hfV, hzf⟩ := hU₀.exists_basicOpen_le (V := V) ⟨p z, hzC⟩ hxU₀
    have hle : p ⁻¹ᵁ X.basicOpen f ≤ g ⁻¹ᵁ wcPmChart m k := by
      intro z'' hz''
      rw [Scheme.Hom.mem_preimage] at hz''
      by_contra hn
      exact hfV hz'' ⟨z'', hn, rfl⟩

    have hWaff : IsAffineOpen (X.basicOpen f) := hU₀.basicOpen f
    have hpW : IsClosedImmersion (p ∣_ X.basicOpen f) :=
      (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
        (morphismRestrictRestrictBasicOpen p U₀ f)).mp (IsZariskiLocalAtTarget.restrict hpU₀ _)
    have hsurj : Function.Surjective (p.app (X.basicOpen f)) := by
      haveI : IsAffine (X.basicOpen f : Scheme.{u}) := hWaff
      have h0 := (isClosedImmersion_iff_isAffineHom.mp hpW).2 ⊤ (isAffineOpen_top _)
      have hgenS : ∀ (V : X.Opens) (V' : Z.Opens) (e : V' = p ⁻¹ᵁ V),
          Function.Surjective (p.app V ≫ Z.presheaf.map (eqToHom e).op) →
          Function.Surjective (p.app V) := by
        intro V V' e hs
        subst e
        simpa using hs
      have h2 := hgenS _ _ _ (by rw [← morphismRestrict_app]; exact h0)
      have hsub : ∀ (V : X.Opens) (e : V = X.basicOpen f), Function.Surjective (p.app V) →
          Function.Surjective (p.app (X.basicOpen f)) := by
        intro V e hs
        subst e
        exact hs
      exact hsub _ (Scheme.Opens.ι_image_top _) h2

    have hker : ∀ a : Γ(X, X.basicOpen f), p.app (X.basicOpen f) a = 0 ↔
        ∀ y ∈ X.basicOpen f, y ∈ T → y ∉ X.basicOpen a := by
      intro a
      constructor
      · intro ha y hyU hyT hyb
        obtain ⟨z', rfl⟩ := hpts y (X.basicOpen_le f hyU) hyT
        have hz : z' ∈ p ⁻¹ᵁ X.basicOpen a := hyb
        rw [Scheme.preimage_basicOpen, ha, Scheme.basicOpen_zero] at hz
        exact hz
      · intro H
        apply eq_zero_of_basicOpen_eq_bot
        rw [← Scheme.preimage_basicOpen]
        apply eq_bot_iff.mpr
        intro z' hz'
        exact (H (p z') (X.basicOpen_le a hz') (hrange ⟨z', rfl⟩) hz').elim

    have hψb : Function.Bijective (φ k (p ⁻¹ᵁ X.basicOpen f) hle) := hTw.1 k _ hle
    have hψs : ∀ (s : Γ(Z, p ⁻¹ᵁ X.basicOpen f)) (x : Γ(L, p ⁻¹ᵁ X.basicOpen f)),
        φ k (p ⁻¹ᵁ X.basicOpen f) hle (s • x) = s • φ k (p ⁻¹ᵁ X.basicOpen f) hle x :=
      hTw.2.1 k _ hle
    let one' : Γ(wcStructMod Z, p ⁻¹ᵁ X.basicOpen f) :=
      show Γ(wcStructMod Z, p ⁻¹ᵁ X.basicOpen f) from (1 : Γ(Z, p ⁻¹ᵁ X.basicOpen f))
    let ε : Γ(L, p ⁻¹ᵁ X.basicOpen f) := (Equiv.ofBijective _ hψb).symm one'
    have hψε : φ k (p ⁻¹ᵁ X.basicOpen f) hle ε = one' :=
      Equiv.ofBijective_apply_symm_apply _ hψb _
    let E : Γ(X, X.basicOpen f) →ₗ[Γ(X, X.basicOpen f)]
        Γ((Scheme.Modules.pushforward p).obj L, X.basicOpen f) :=
      LinearMap.toSpanSingleton _ _
        (show Γ((Scheme.Modules.pushforward p).obj L, X.basicOpen f) from ε)
    let E' : Γ(X, X.basicOpen f) → Γ(L, p ⁻¹ᵁ X.basicOpen f) :=
      fun a => p.app (X.basicOpen f) a • ε
    have hEE : ∀ a, @Eq Γ(L, p ⁻¹ᵁ X.basicOpen f) (E a) (E' a) := fun a => rfl
    have hkey : ∀ a : Γ(X, X.basicOpen f),
        @Eq Γ(wcStructMod Z, p ⁻¹ᵁ X.basicOpen f) (φ k (p ⁻¹ᵁ X.basicOpen f) hle (E' a))
          (p.app (X.basicOpen f) a) := by
      intro a
      refine (hψs _ _).trans ?_
      rw [hψε]
      show p.app (X.basicOpen f) a * 1 = p.app (X.basicOpen f) a
      exact mul_one _
    refine ⟨X.basicOpen f, E, hWaff, ⟨p z, hzf, hxT⟩, ?_, ?_⟩
    · intro y
      obtain ⟨a, ha⟩ := hsurj (φ k (p ⁻¹ᵁ X.basicOpen f) hle y)
      refine ⟨a, ?_⟩
      change @Eq Γ(L, p ⁻¹ᵁ X.basicOpen f) (E' a) y
      apply hψb.1
      rw [hkey a]
      exact ha
    · intro a
      refine Iff.trans ⟨fun h => ?_, fun h => ?_⟩ (hker a)
      · have h' : @Eq Γ(L, p ⁻¹ᵁ X.basicOpen f) (E' a) 0 := h
        have h3 := congrArg (φ k (p ⁻¹ᵁ X.basicOpen f) hle) h'
        rw [hkey a, map_zero] at h3
        exact h3
      · change @Eq Γ(L, p ⁻¹ᵁ X.basicOpen f) (E' a) 0
        apply hψb.1
        rw [hkey a, map_zero]
        exact h

theorem wcpa_dj_cfg_good_sheaf : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (X : Scheme.{u}) (h : X ⟶ Spec (.of B)) [IsProper h] {m : ℕ} (V : Fin m → X.Opens), (∀ i, IsAffineOpen (V i)) → (∀ x : X, ∃ i, x ∈ V i) → (∀ (p : ℕ) (a : Fin (p + 1) ↪o Fin m), IsAffineOpen (wcAcV V ⊤ a)) → ∀ T : TopologicalSpace.Closeds X, IsIrreducible (T : Set X) → ∃ G : X.Modules, wcCoherentMod G ∧ wcGenRankOne G T ∧ wcAcFG B X h G V :=
by
  intro B _ _ X h _ r V _hV hcov hnerve T hT

  haveI : IsLocallyNoetherian (Spec (.of B)) :=
    (isLocallyNoetherian_Spec (R := CommRingCat.of B)).mpr ‹IsNoetherianRing B›
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian h

  obtain ⟨Z, p, m, g, hp, hZred, hrange, hΛ', hΛ, U₀, hU₀, hne, hpU₀, hpts⟩ :=
    wcpa_dj_cgs_chow_closed B X h T hT
  haveI := hp
  haveI := hZred

  obtain ⟨e, he1, he2, he3, he4⟩ := wc_pm_chart_coords.{u} m
  have he : wcGsCoords m e := ⟨he1, he2, he3, he4⟩
  obtain ⟨hDa, hDc⟩ := wc_pm_chart_cover B Z (p ≫ h) m g hΛ'

  haveI : IsSeparated (Limits.terminal.from Z) := by
    have h1 : Limits.terminal.from Z = (p ≫ h) ≫ Limits.terminal.from (Spec (.of B)) :=
      Limits.terminal.hom_ext _ _
    rw [h1]
    infer_instance
  haveI : IsAffineHom (Limits.pullback.diagonal (Limits.terminal.from Z)) := inferInstance
  have hinfaff : ∀ {n : ℕ} (U : Fin (n + 1) → Z.Opens), (∀ k, IsAffineOpen (U k)) →
      IsAffineOpen (⨅ k, U k) := by
    intro n U hU
    have h1 : (⨅ k, U k) = Finset.univ.inf' Finset.univ_nonempty U := by
      rw [Finset.inf'_eq_inf, Finset.inf_univ_eq_iInf]
    rw [h1]
    exact Finset.inf'_induction _ _ (fun a₁ h₁ a₂ h₂ => h₁.inf h₂) (fun k _ => hU k)

  have hpre : ∀ {n : ℕ} (U : Fin n → X.Opens), p ⁻¹ᵁ (⨅ k, U k) = ⨅ k, p ⁻¹ᵁ U k := by
    intro n U
    rw [← Finset.inf_univ_eq_iInf, ← Finset.inf_univ_eq_iInf]
    suffices H : ∀ s : Finset (Fin n), p ⁻¹ᵁ s.inf U = s.inf (fun k => p ⁻¹ᵁ U k) from H _
    intro s
    induction s using Finset.induction_on with
    | empty => simp
    | insert a s ha ih => rw [Finset.inf_insert, Finset.inf_insert, Scheme.Hom.preimage_inf, ih]
  have hEσ : ∀ (s : ℕ) (σ : Fin (s + 1) ↪o Fin r),
      wcAcV (fun i => p ⁻¹ᵁ V i) ⊤ σ = p ⁻¹ᵁ wcAcV V ⊤ σ := by
    intro s σ
    show (⨅ j, p ⁻¹ᵁ V (σ j)) ⊓ ⊤ = p ⁻¹ᵁ ((⨅ j, V (σ j)) ⊓ ⊤)
    simp only [inf_top_eq]
    exact (hpre _).symm

  choose w₀ hw₀ using fun (s : ℕ) (σ : Fin (s + 1) ↪o Fin r) =>
    wcpa_dj_cgs_column_vanish X Z p m g e he hΛ (wcAcV V ⊤ σ) (hnerve s σ)
  obtain ⟨w, hw⟩ : ∃ w : ℕ, ∀ (s : ℕ) (σ : Fin (s + 1) ↪o Fin r), w₀ s σ ≤ w := by
    haveI : ∀ n : ℕ, Finite (Fin n ↪o Fin r) := fun n =>
      Finite.of_injective (fun f : Fin n ↪o Fin r => (⇑f : Fin n → Fin r)) DFunLike.coe_injective
    obtain ⟨M, hM⟩ :=
      Finite.exists_le (fun x : (Σ s : Fin r, (Fin (s.1 + 1) ↪o Fin r)) => w₀ x.1.1 x.2)
    refine ⟨M, fun s σ => ?_⟩
    have hs : s < r := by
      have := Fintype.card_le_of_embedding σ.toEmbedding
      simp at this
      omega
    exact hM ⟨⟨s, hs⟩, σ⟩

  obtain ⟨L, φ, hLcoh, hTw⟩ := wcpa_dj_cgs_twist_sheaf Z m g e he hDa hDc w

  have hGcoh : wcCoherentMod ((Scheme.Modules.pushforward p).obj L) :=
    wc_cn_pushforward_coherent B X h Z p m g hp hΛ' L hLcoh
  have hGrank : wcGenRankOne ((Scheme.Modules.pushforward p).obj L) T :=
    wcpa_dj_cgs_gen_rank_one X Z p m g e w L φ T hTw hDc hrange U₀ hU₀ hne hpU₀ hpts

  obtain ⟨hc10a, hc10b⟩ := wcpa_dj_cgs_chart_gen_top B Z (p ≫ h) m g e he hΛ'
  obtain ⟨K, hKgr, hmod⟩ :=
    wcpa_dj_cgs_laurent_model Z m g e he ⊤ B (wcCnSigma (p ≫ h) ⊤) hc10a hc10b
  obtain ⟨Θ, hΘ⟩ := hmod w L φ hTw
  have hDedge : wcAcFG B Z (p ≫ h) L (fun k => g ⁻¹ᵁ wcPmChart m k) :=
    wcpa_dj_cgs_laur_fg_transfer B Z (p ≫ h) L (fun k => g ⁻¹ᵁ wcPmChart m k) K (w : ℤ) Θ hΘ
      (fun q => wc_graded_cech_fg B (m + 1) 1 (fun _ => 0) K hKgr q (w : ℤ))

  have hEcov : ∀ z : Z, ∃ i, z ∈ p ⁻¹ᵁ V i := by
    intro z
    obtain ⟨i, hi⟩ := hcov (p z)
    exact ⟨i, (Scheme.Hom.mem_preimage p).mpr hi⟩

  have hrowaff : ∀ (t : ℕ) (τ : Fin (t + 1) ↪o Fin (m + 1)) (s : ℕ) (a : Fin (s + 1) ↪o Fin r),
      IsAffineOpen (wcAcV (fun i => p ⁻¹ᵁ V i) (wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) ⊤ τ) a) := by
    intro t τ s a
    have h1 := (wcpa_dj_cgs_chart_affine_gen X Z p m g e he hΛ (wcAcV V ⊤ a) (τ 0)
      (hnerve s a)).1
    have h2 := h1.inf (hinfaff (fun k => g ⁻¹ᵁ wcPmChart m (τ k)) (fun k => hDa (τ k)))
    have heq : wcAcV (fun i => p ⁻¹ᵁ V i) (wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) ⊤ τ) a =
        (p ⁻¹ᵁ wcAcV V ⊤ a ⊓ g ⁻¹ᵁ wcPmChart m (τ 0)) ⊓ ⨅ k, g ⁻¹ᵁ wcPmChart m (τ k) := by
      show (⨅ j, p ⁻¹ᵁ V (a j)) ⊓ ((⨅ k, g ⁻¹ᵁ wcPmChart m (τ k)) ⊓ ⊤) =
        (p ⁻¹ᵁ ((⨅ j, V (a j)) ⊓ ⊤) ⊓ g ⁻¹ᵁ wcPmChart m (τ 0)) ⊓ ⨅ k, g ⁻¹ᵁ wcPmChart m (τ k)
      simp only [inf_top_eq]
      rw [hpre, inf_assoc,
        inf_eq_right.mpr (iInf_le (fun k => g ⁻¹ᵁ wcPmChart m (τ k)) 0)]
    rw [heq]
    exact h2
  have hrows : ∀ (t : ℕ) (τ : Fin (t + 1) ↪o Fin (m + 1)) (q : ℕ)
      (z : wcAcC L (fun i => p ⁻¹ᵁ V i) (wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) ⊤ τ) (q + 1)),
      wcAcD L (fun i => p ⁻¹ᵁ V i) (wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) ⊤ τ) (q + 1) z = 0 →
      ∃ x, z = wcAcD L (fun i => p ⁻¹ᵁ V i) (wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) ⊤ τ) q x := by
    intro t τ
    have hUτ : IsAffineOpen (wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) ⊤ τ) := by
      show IsAffineOpen ((⨅ k, g ⁻¹ᵁ wcPmChart m (τ k)) ⊓ ⊤)
      rw [inf_top_eq]
      exact hinfaff (fun k => g ⁻¹ᵁ wcPmChart m (τ k)) (fun k => hDa (τ k))
    exact wcpa_dj_cgs_affine_cech_acyclic Z L hLcoh.1 _ hUτ (fun i => p ⁻¹ᵁ V i)
      (fun y _ => hEcov y) (fun s a => hrowaff t τ s a)

  have hcols : ∀ (s : ℕ) (σ : Fin (s + 1) ↪o Fin r) (q : ℕ)
      (z : wcAcC L (fun k => g ⁻¹ᵁ wcPmChart m k) (wcAcV (fun i => p ⁻¹ᵁ V i) ⊤ σ) (q + 1)),
      wcAcD L (fun k => g ⁻¹ᵁ wcPmChart m k) (wcAcV (fun i => p ⁻¹ᵁ V i) ⊤ σ) (q + 1) z = 0 →
      ∃ x, z = wcAcD L (fun k => g ⁻¹ᵁ wcPmChart m k) (wcAcV (fun i => p ⁻¹ᵁ V i) ⊤ σ) q x := by
    intro s σ
    rw [hEσ s σ]
    exact hw₀ s σ w (hw s σ) L φ hTw
  have hLE : wcAcFG B Z (p ≫ h) L (fun i => p ⁻¹ᵁ V i) :=
    wcpa_dj_cgs_double_complex B Z (p ≫ h) L (fun i => p ⁻¹ᵁ V i)
      (fun k => g ⁻¹ᵁ wcPmChart m k) hEcov hDc hrows hcols hDedge
  exact ⟨(Scheme.Modules.pushforward p).obj L, hGcoh, hGrank,
    wcpa_dj_cgs_push_transport B X Z h p L V hLE⟩

theorem wcpa_dj_lge_cbcm_cech_fg : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (Y₀ : Scheme.{u}) (q₀ : Y₀ ⟶ Spec (.of B)) (L₀ : wcpaDjCoc Y₀), IsProper q₀ → wcpaDjCocOK L₀ → ∀ (e : ℕ), wcCbcmFG q₀ L₀ e :=
by
  intro B _ _ Y₀ q₀ L₀ hprop hOK e
  haveI := hprop

  haveI : IsLocallyNoetherian (Spec (.of B)) :=
    (isLocallyNoetherian_Spec (R := CommRingCat.of B)).mpr ‹IsNoetherianRing B›
  haveI : IsLocallyNoetherian Y₀ := LocallyOfFiniteType.isLocallyNoetherian q₀
  haveI : CompactSpace Y₀ := QuasiCompact.compactSpace_of_compactSpace q₀
  haveI : AlgebraicGeometry.IsNoetherian Y₀ := AlgebraicGeometry.IsNoetherian.mk

  haveI hsep : IsSeparated (Limits.terminal.from Y₀) := by
    have h1 : Limits.terminal.from Y₀ = q₀ ≫ Limits.terminal.from (Spec (.of B)) :=
      Limits.terminal.hom_ext _ _
    rw [h1]
    infer_instance
  haveI : IsAffineHom (Limits.pullback.diagonal (Limits.terminal.from Y₀)) := inferInstance
  have hnerve : ∀ (p : ℕ) (a : Fin (p + 1) ↪o Fin L₀.m), IsAffineOpen (wcAcV L₀.V ⊤ a) := by
    intro p a
    have h1 : (⨅ k, L₀.V (a k)) =
        Finset.univ.inf' Finset.univ_nonempty (fun k => L₀.V (a k)) := by
      rw [Finset.inf'_eq_inf, Finset.inf_univ_eq_iInf]
    show IsAffineOpen ((⨅ k, L₀.V (a k)) ⊓ ⊤)
    rw [inf_top_eq, h1]
    exact Finset.inf'_induction _ _ (fun a₁ h₁ a₂ h₂ => h₁.inf h₂) (fun k _ => hOK.1 (a k))

  have hcov' : ∀ x : Y₀, ∃ i, x ∈ L₀.V i := by
    intro x
    have hx : x ∈ (⊤ : Y₀.Opens) := trivial
    rw [← hOK.2.1] at hx
    exact TopologicalSpace.Opens.mem_iSup.mp hx

  obtain ⟨G, φ, hbij, hlin, hres, htr⟩ := wcpa_dj_twr_construct L₀ hOK e (wcStructMod Y₀)
  have hGcoh : wcCoherentMod G :=
    wcpa_dj_twr_coherent_transfer L₀.V hOK.1 hOK.2.1 (wcStructMod Y₀) G φ hbij hlin hres
      (wc_struct_mod_coh Y₀)

  have hzero : ∀ M : Y₀.Modules, Limits.IsZero M → wcAcFG B Y₀ q₀ M L₀.V := by
    intro M hM
    have hs : ∀ (U : Y₀.Opens) (s : Γ(M, U)), s = 0 := by
      intro U s
      have h1 : (𝟙 M : M ⟶ M) = 0 := hM.eq_of_src _ _
      have h2 : Scheme.Modules.Hom.app (𝟙 M) U s = Scheme.Modules.Hom.app (0 : M ⟶ M) U s := by
        rw [h1]
      simpa using h2
    refine ⟨⟨0, fun i => i.elim0, fun i => i.elim0, fun z _ => ⟨fun i => i.elim0, ?_⟩⟩,
      fun p => ⟨0, fun i => i.elim0, fun i => i.elim0, fun z _ => ⟨fun i => i.elim0, 0, ?_⟩⟩⟩
    · funext a
      exact (hs _ _).trans (hs _ _).symm
    · funext a
      exact (hs _ _).trans (hs _ _).symm
  have hdd : ∀ (N : Y₀.Modules) (p : ℕ) (z : wcAcC N L₀.V ⊤ p),
      wcAcD N L₀.V ⊤ (p + 1) (wcAcD N L₀.V ⊤ p z) = 0 :=
    fun N p z => wcpa_dj_cfg_acd_sq_zero Y₀ N L₀.V ⊤ p z
  have hA : ∀ S : ShortComplex Y₀.Modules, S.ShortExact → wcCoherentMod S.X₁ →
      wcCoherentMod S.X₂ → wcCoherentMod S.X₃ → wcAcFG B Y₀ q₀ S.X₁ L₀.V →
      wcAcFG B Y₀ q₀ S.X₃ L₀.V → wcAcFG B Y₀ q₀ S.X₂ L₀.V := by
    intro S hS h1 _ _
    obtain ⟨hinj, hex⟩ := wc_modules_ses_left_exact Y₀ S hS
    exact (wcpa_dj_cfg_two_of_three B Y₀ q₀ L₀.V S hdd hinj hex
      (fun p a => wc_modules_ses_affine_surj Y₀ S hS h1.1 _ (hnerve p a))).1
  have hB : ∀ S : ShortComplex Y₀.Modules, S.ShortExact → wcCoherentMod S.X₁ →
      wcCoherentMod S.X₂ → wcCoherentMod S.X₃ → wcAcFG B Y₀ q₀ S.X₂ L₀.V →
      wcAcFG B Y₀ q₀ S.X₃ L₀.V → wcAcFG B Y₀ q₀ S.X₁ L₀.V := by
    intro S hS h1 _ _
    obtain ⟨hinj, hex⟩ := wc_modules_ses_left_exact Y₀ S hS
    exact (wcpa_dj_cfg_two_of_three B Y₀ q₀ L₀.V S hdd hinj hex
      (fun p a => wc_modules_ses_affine_surj Y₀ S hS h1.1 _ (hnerve p a))).2
  have hP : wcAcFG B Y₀ q₀ G L₀.V :=
    wc_coherent_devissage Y₀ (fun M => wcAcFG B Y₀ q₀ M L₀.V) hzero hA hB
      (fun T hT => wcpa_dj_cfg_good_sheaf B Y₀ q₀ L₀.V hOK.1 hcov' hnerve T hT) G hGcoh
  exact wcpa_dj_cfg_twist_transport B Y₀ q₀ L₀ e G φ hbij hlin hres htr hP

theorem wcpa_dj_lge_cbcm_mumford : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (C : ℕ → Type u) [∀ p, AddCommGroup (C p)] [∀ p, Module B (C p)] (d : ∀ p, C p →ₗ[B] C (p+1)) (N : ℕ), (∀ p, (d (p+1)).comp (d p) = 0) → (∀ p, N ≤ p → Subsingleton (C p)) → (∀ p, Module.Flat B (C p)) → (LinearMap.ker (d 0)).FG → (∀ p, ∃ (k : ℕ) (c : Fin k → C (p+1)), (∀ i, d (p+1) (c i) = 0) ∧ ∀ z, d (p+1) z = 0 → ∃ (b : Fin k → B) (x : C p), z = ∑ i, b i • c i + d p x) → ∃ (n0 n1 n2 : ℕ) (D0 : Matrix (Fin n1) (Fin n0) B) (D1 : Matrix (Fin n2) (Fin n1) B) (β0 : Fin n0 → C 0) (β1 : Fin n1 → C 1) (β2 : Fin n2 → C 2), D1 * D0 = 0 ∧ (∀ j, d 0 (β0 j) = ∑ i, D0 i j • β1 i) ∧ (∀ j, d 1 (β1 j) = ∑ i, D1 i j • β2 i) ∧ ∀ (R : Type u) [CommRing R] (f : B →+* R), letI := f.toAlgebra; (∀ x : TensorProduct B (C 0) R, (d 0).rTensor R x = 0 → ∃! v : Fin n0 → R, (D0.map f).mulVec v = 0 ∧ x = ∑ j, β0 j ⊗ₜ[B] v j) ∧ (∀ w : Fin n1 → R, (D1.map f).mulVec w = 0 → (∃ y : TensorProduct B (C 0) R, (d 0).rTensor R y = ∑ i, β1 i ⊗ₜ[B] w i) → ∃ v : Fin n0 → R, w = (D0.map f).mulVec v) :=
by
  have S1 : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (C0 C1 : Type u) [AddCommGroup C0] [Module B C0] [AddCommGroup C1] [Module B C1] (d0 : C0 →ₗ[B] C1) (r1 r2 : ℕ) (M : Matrix (Fin r2) (Fin r1) B) (a1 : Fin r1 → C1), ∃ (s : ℕ) (X : Matrix (Fin r1) (Fin s) B) (c : Fin s → C0), M * X = 0 ∧ (∀ j, d0 (c j) = ∑ i, X i j • a1 i) ∧ ∀ (x : Fin r1 → B) (c' : C0), M.mulVec x = 0 → ∑ i, x i • a1 i = d0 c' → ∃ y : Fin s → B, x = X.mulVec y := by
    intro B _ _ C0 C1 _ _ _ _ d0 r1 r2 M a1
    classical
    let G : Submodule B (Fin r1 → B) :=
      { carrier := {x | M.mulVec x = 0 ∧ ∃ c, ∑ i, x i • a1 i = d0 c}
        add_mem' := by
          rintro x y ⟨hx, cx, hcx⟩ ⟨hy, cy, hcy⟩
          refine ⟨by rw [Matrix.mulVec_add, hx, hy, add_zero], cx + cy, ?_⟩
          simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib, hcx, hcy, map_add]
        zero_mem' := ⟨Matrix.mulVec_zero _, 0, by simp⟩
        smul_mem' := by
          rintro b x ⟨hx, cx, hcx⟩
          refine ⟨by rw [Matrix.mulVec_smul, hx, smul_zero], b • cx, ?_⟩
          simp only [Pi.smul_apply, smul_eq_mul, mul_smul, ← Finset.smul_sum, hcx, map_smul] }
    have hfg : G.FG := IsNoetherian.noetherian G
    obtain ⟨s, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
