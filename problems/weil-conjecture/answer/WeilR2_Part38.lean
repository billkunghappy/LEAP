      have hOneSub : ∀ v, ((1 - E0).map f).mulVec v = v - (E0.map f).mulVec v := by
        intro v
        rw [Matrix.map_sub _ (map_sub f), Matrix.map_one _ (map_zero f) (map_one f), Matrix.sub_mulVec,
          Matrix.one_mulVec]
      have hsumE : ∀ u : Fin r0 → R, ∑ j, a0 j ⊗ₜ[B] ((E0.map f).mulVec u) j = ∑ k, a0 k ⊗ₜ[B] u k := by
        intro u
        simp only [Matrix.mulVec, dotProduct, Matrix.map_apply, TensorProduct.tmul_sum, ← smul_tmul_eq]
        rw [Finset.sum_comm]
        simp only [← TensorProduct.sum_tmul, hEa]
      have hDE : ∀ u : Fin r0 → R, (M0.map f).mulVec u = 0 → (D0.map f).mulVec ((E0.map f).mulVec u) = 0 := by
        intro u hu
        funext i
        refine Fin.addCases (fun i₁ => ?_) (fun i₂ => ?_) i
        · rw [hmv0, hME', hu]; rfl
        · rw [hmv0', hOneSub, hEE', sub_self]; rfl
      refine ⟨?_, ?_⟩
      · intro x hx
        obtain ⟨u, hu0, hux⟩ := P1 0 x (Matrix.mulVec_zero _) (by rw [hx]; simp)
        refine ⟨(E0.map f).mulVec u, ⟨hDE u hu0.symm, ?_⟩, ?_⟩
        · rw [hsumE, hux]
        · rintro v ⟨hv0, hvx⟩
          have hw : (D0.map f).mulVec (v - (E0.map f).mulVec u) = 0 := by
            rw [Matrix.mulVec_sub, hv0, hDE u hu0.symm, sub_zero]
          have hMw : (M0.map f).mulVec (v - (E0.map f).mulVec u) = 0 := by
            funext i₁; exact (hmv0 _ _).symm.trans (congrFun hw _)
          have hEw : v - (E0.map f).mulVec u = (E0.map f).mulVec (v - (E0.map f).mulVec u) := by
            funext i₂
            have h := (hmv0' _ _).symm.trans (congrFun hw (Fin.natAdd r1 i₂))
            rw [hOneSub] at h
            exact sub_eq_zero.mp h
          have hsw : ∑ j, a0 j ⊗ₜ[B] (v - (E0.map f).mulVec u) j = 0 := by
            simp only [Pi.sub_apply, TensorProduct.tmul_sub, Finset.sum_sub_distrib, hsumE, ← hvx, ← hux,
              sub_self]
          have h0 := P2 _ hMw hsw
          rw [← hEw] at h0
          exact sub_eq_zero.mp h0
      · rintro w hw ⟨y, hy⟩
        have hz : (M1.map f).mulVec (fun k => w (Fin.castAdd r0 k)) = 0 := by
          funext i₁; exact (hmv1 w i₁).symm.trans (congrFun hw _)
        have ht : (E0.map f).mulVec (fun k => w (Fin.natAdd r1 k)) = 0 := by
          funext i₂; exact (hmv1' w i₂).symm.trans (congrFun hw _)
        have hy' : ∑ i, a1 i ⊗ₜ[B] w (Fin.castAdd r0 i) = (d 0).rTensor R y := by
          rw [hy, Fin.sum_univ_add]
          simp only [β1, Fin.append_left, Fin.append_right, TensorProduct.zero_tmul, Finset.sum_const_zero,
            add_zero]
        obtain ⟨x, hzx, -⟩ := P1 _ y hz hy'
        have hMt : (M0.map f).mulVec (fun k => w (Fin.natAdd r1 k)) = 0 := by
          rw [← hME', ht, Matrix.mulVec_zero]
        refine ⟨(E0.map f).mulVec x + (fun k => w (Fin.natAdd r1 k)), ?_⟩
        funext i
        refine Fin.addCases (fun i₁ => ?_) (fun i₂ => ?_) i
        · rw [hmv0, Matrix.mulVec_add, hME', hMt, add_zero, ← hzx]
        · rw [hmv0', hOneSub, Matrix.mulVec_add, hEE', ht, add_zero, add_sub_cancel_left]
  intro B _ _ C _ _ d N hdd hsub hflat hker hhi
  classical
  have hH0 : ∃ (k : ℕ) (g : Fin k → C 0), (∀ i, d 0 (g i) = 0) ∧ ∀ z, d 0 z = 0 →
      ∃ (b : Fin k → B) (x : C 0), z = ∑ i, b i • g i + (0 : C 0 →ₗ[B] C 0) x := by
    obtain ⟨k, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hker
    refine ⟨k, g, fun i => ?_, fun z hz => ?_⟩
    · have h : g i ∈ LinearMap.ker (d 0) := hg ▸ Submodule.subset_span ⟨i, rfl⟩
      exact h
    · have hz' : z ∈ Submodule.span B (Set.range g) := by rw [hg]; exact hz
      obtain ⟨b, hb⟩ := (Submodule.mem_span_range_iff_exists_fun B).mp hz'
      exact ⟨b, 0, by rw [LinearMap.zero_apply, add_zero, hb]⟩
  obtain ⟨r, M, a, hr0, hMM, hch, hinj, hH0', hhigh⟩ :=
    S2 B (S1 B) N C d (C 0) 0 hsub hH0 hhi
  have hH0'' : ∀ z : C 0, d 0 z = 0 → ∃ x : Fin (r 0) → B, (M 0).mulVec x = 0 ∧ z = ∑ i, x i • a 0 i := by
    intro z hz
    obtain ⟨x, x', h1, h2⟩ := hH0' z hz
    exact ⟨x, h1, by rw [h2, LinearMap.zero_apply, add_zero]⟩
  obtain ⟨hex0, hex⟩ := S3 B C d r M a hdd hMM hch hinj hH0'' hhigh
  have hEflat : ∀ p, Module.Flat B ((Fin (r (p+1)) → B) × C p) :=
    fun p => S4 B _ _ inferInstance (hflat p)
  have hEsub : ∀ p, N ≤ p → Subsingleton ((Fin (r (p+1)) → B) × C p) := by
    intro p hp
    haveI := hsub p hp
    have h0 : r (p+1) = 0 := hr0 (p+1) (by omega)
    haveI : Subsingleton (Fin (r (p+1)) → B) := by rw [h0]; infer_instance
    infer_instance
  obtain ⟨hflψ, huniv⟩ := S5 B (fun p => (Fin (r (p+1)) → B) × C p)
    (fun p => ((-(Matrix.toLin' (M (p+1)))).comp (LinearMap.fst B _ _)).prod
      ((Fintype.linearCombination B (a (p+1))).comp (LinearMap.fst B _ (C p)) + (d p).comp (LinearMap.snd B _ _)))
    (Fin (r 0) → B) ((-(Matrix.toLin' (M 0))).prod (Fintype.linearCombination B (a 0))) N
    hEflat hEsub hex0 hex
  obtain ⟨E0, hEE, hψE, hker6⟩ := S6 B (r 0) ((Fin (r 1) → B) × C 0)
    ((-(Matrix.toLin' (M 0))).prod (Fintype.linearCombination B (a 0))) hflψ
  obtain ⟨hME, hEa, hU7⟩ := S7 B (C 0) (C 1) (d 0) (r 0) (r 1) (r 2) (M 0) (M 1) (a 0) (a 1) E0 hψE
    (fun R _ f => by
      letI := f.toAlgebra
      exact ⟨(huniv R).1, fun ξ h => hker6 R ξ ((huniv R).2 ξ h)⟩)
  exact S8 B C d (r 0) (r 1) (r 2) (M 0) (M 1) E0 (a 0) (a 1) (a 2) (hMM 0) (hch 0) (hch 1) hEE hME hEa hU7

