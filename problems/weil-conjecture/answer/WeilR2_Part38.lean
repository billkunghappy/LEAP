  have L7 : ∀ {P G : Scheme.{u}} [IrreducibleSpace P] [AlgebraicGeometry.IsReduced G] (j : P ⟶ G)
      [IsOpenImmersion j], Dense (Set.range ⇑j) → (∀ δ : G, j (genericPoint P) ⤳ δ) ∧
      ∀ (δ : G) (h : j (genericPoint P) ⤳ δ), Function.Injective (wcLr1uGerm j δ h).hom := by
    intro P G _ _ j _ hd
