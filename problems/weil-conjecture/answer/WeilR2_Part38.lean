  have hy₁W : ∀ pt : ↥(Spec (.of k)), y₁ pt ∈ ν ⁻¹ᵁ V₁ := fun pt => by
    rw [Scheme.Hom.mem_preimage, hν₁ pt]; exact hxV₁
  obtain ⟨g₁, hg₁₀, hg₁₁⟩ := wcpa_dj_lus_cvs_ct_ns_nf_separate_sections k Ct (ν ≫ q) (ν ⁻¹ᵁ V₁)
    hW₁ y₀ y₁ hy₀s hy₁s hy₀W hy₁W hdist

  obtain ⟨c₁, hc₁⟩ := hdesc V₁ hV₁ hP (g₁ - g₁ ^ 2) (fun h₀ h₁ => by
    rw [map_sub, map_sub, map_pow, map_pow, hg₁₀ h₀, hg₁₁ h₁]; ring)

  have he : (⊤ : (Spec (.of k)).Opens) ≤ (y₀ ≫ ν) ⁻¹ᵁ V₁ := by
    intro pt _
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply, hν₀ pt]
    exact hxV₁
  have he' : (⊤ : (Spec (.of k)).Opens) ≤ y₀ ⁻¹ᵁ (ν ⁻¹ᵁ V₁) := he
  have hunit₁ : IsUnit ((C.presheaf.germ V₁ x hxV₁).hom (1 - 4 * c₁)) := by
