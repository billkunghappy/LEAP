    have hs2 : U.topIso.hom.hom.Finite :=
      RingHom.Finite.of_surjective _ (fun y => ⟨U.topIso.inv.hom y, by
        show (U.topIso.inv ≫ U.topIso.hom).hom y = y
        rw [Iso.inv_hom_id]; rfl⟩)
    rw [h3, CommRingCat.hom_comp, CommRingCat.hom_comp]
    exact RingHom.Finite.comp (RingHom.Finite.comp hs2 h1) hs1
  · intro K _ q
    have hX : X.toSpecΓ ≫ Spec.map (Scheme.Hom.appTop q) ≫
        Spec.map (Scheme.ΓSpecIso (.of K)).inv = q := by
      apply ext_of_isAffine
      rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, Scheme.toSpecΓ_appTop,
        Category.assoc, Scheme.ΓSpecIso_naturality, ← Category.assoc, Scheme.ΓSpecIso_naturality,
        Iso.hom_inv_id, Category.id_comp]
    unfold wcpaDjKConst
    simp only [CommRingCat.ofHom_hom, Spec.map_comp, Category.assoc]
    rw [Scheme.Opens.toSpecΓ_SpecMap_presheaf_map_top_assoc, hX]

theorem wcpa_dj_fva_cc_stalk_translate : ∀ (K : Type u) [Field K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (L : wcpaDjCoc C) (e M : ℕ)
    (t : Fin (M + 1) → ∀ a : Fin L.m, Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤)) (J : Fin (M + 1))
    (r : Fin (M + 1) → Γ(C, ⨆ a, C.basicOpen (t J a))),
    wcpaDjSepSec K q L e M t → wcpaDjAvRatio q L ⊤ t J r →
    (∀ (x : C) (hx : x ∈ ⨆ a, C.basicOpen (t J a)), IsClosed ({x} : Set C) →
      ∃ c : Fin (M + 1) → Γ(Spec (.of K), ⊤),
        Ideal.span (Set.range fun l => (C.presheaf.germ _ x hx).hom
          (wcpaDjAvChart q L ⊤ t J r (MvPolynomial.X l - MvPolynomial.C (c l)))) =
          IsLocalRing.maximalIdeal (C.presheaf.stalk x)) ∧
    (∀ (x y : C) (hx : x ∈ ⨆ a, C.basicOpen (t J a)) (hy : y ∈ ⨆ a, C.basicOpen (t J a)),
      IsClosed ({x} : Set C) → IsClosed ({y} : Set C) → x ≠ y →
      ∃ P, (C.presheaf.germ _ x hx).hom (wcpaDjAvChart q L ⊤ t J r P) ∈
          IsLocalRing.maximalIdeal (C.presheaf.stalk x) ∧
        (C.presheaf.germ _ y hy).hom (wcpaDjAvChart q L ⊤ t J r P) ∉
          IsLocalRing.maximalIdeal (C.presheaf.stalk y)) :=
by
  intro K _ C q L e M t J r hsep hr
  have gr : ∀ {U V : C.Opens} (i : U ⟶ V) (x : C) (hx : x ∈ U) (s : Γ(C, V)),
      (C.presheaf.germ U x hx).hom ((C.presheaf.map i.op).hom s) =
        (C.presheaf.germ V x (i.le hx)).hom s :=
    fun i x hx s => TopCat.Presheaf.germ_res_apply _ i x hx s
  have smu : ∀ {R : Type u} [CommRing R] (g : Fin (M + 1) → R) (u : R), IsUnit u →
      Ideal.span (Set.range fun i => g i * u) = Ideal.span (Set.range g) := by
    intro R _ g u hu
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨i, rfl⟩)
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      exact (Ideal.mul_unit_mem_iff_mem _ hu).mp (Ideal.subset_span ⟨i, rfl⟩)
  have bridge : ∀ (a : Fin L.m) (l : Fin (M + 1)) (k : K) (x : C)
      (hxa : x ∈ C.basicOpen (t J a)) (hx : x ∈ ⨆ a, C.basicOpen (t J a)),
      (C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) x (C.basicOpen_le (t J a) hxa)).hom
          (t l a - wcpaDjKConst K q _ k * t J a) =
        (C.presheaf.germ _ x hx).hom (wcpaDjAvChart q L ⊤ t J r
            (MvPolynomial.X l - MvPolynomial.C ((Scheme.ΓSpecIso (.of K)).inv.hom k))) *
          (C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) x (C.basicOpen_le (t J a) hxa)).hom (t J a) := by
    intro a l k x hxa hx
    have h1 := congrArg (C.presheaf.germ (C.basicOpen (t J a)) x hxa).hom (hr a l)
    simp only [map_mul, gr] at h1
    simp only [wcpaDjAvChart, wcpaDjKConst, map_sub, map_mul, MvPolynomial.eval₂Hom_X',
      MvPolynomial.eval₂Hom_C, RingHom.comp_apply, CommRingCat.hom_comp, gr]
    rw [← h1, sub_mul]
    rfl
  refine ⟨fun x hx hcl => ?_, fun x y hx hy hxc hyc hne => ?_⟩
  · obtain ⟨a, hxa⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    obtain ⟨c', hc'⟩ := hsep.2.2.2 J a x hxa hcl
    refine ⟨fun l => (Scheme.ΓSpecIso (.of K)).inv.hom (c' l), ?_⟩
    have hu : IsUnit ((C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) x
        (C.basicOpen_le (t J a) hxa)).hom (t J a)) :=
      (Scheme.mem_basicOpen C (t J a) x _).mp hxa
    rw [← hc']
    simp only [bridge a _ _ x hxa hx]
    exact (smu _ _ hu).symm
  · obtain ⟨a, hxa⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    obtain ⟨b, hyb⟩ := TopologicalSpace.Opens.mem_iSup.mp hy
    obtain ⟨l, c', h1, h2⟩ := hsep.2.2.1 J a b x y hxa hyb hxc hyc hne
    have hux : IsUnit ((C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) x
        (C.basicOpen_le (t J a) hxa)).hom (t J a)) :=
      (Scheme.mem_basicOpen C (t J a) x _).mp hxa
    have huy : IsUnit ((C.presheaf.germ (L.V b ⊓ q ⁻¹ᵁ ⊤) y
        (C.basicOpen_le (t J b) hyb)).hom (t J b)) :=
      (Scheme.mem_basicOpen C (t J b) y _).mp hyb
    refine ⟨MvPolynomial.X l - MvPolynomial.C ((Scheme.ΓSpecIso (.of K)).inv.hom c'), ?_, ?_⟩
    · rw [bridge a l c' x hxa hx] at h1
      exact (Ideal.mul_unit_mem_iff_mem _ hux).mp h1
    · rw [bridge b l c' y hyb hy] at h2
      exact fun h => h2 ((Ideal.mul_unit_mem_iff_mem _ huy).mpr h)

theorem wcpa_dj_fva_cc_valuative_existence : ∀ (K : Type u) [Field K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (L : wcpaDjCoc C) (e M : ℕ)
    (t : Fin (M + 1) → ∀ a : Fin L.m, Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤)) (J : Fin (M + 1))
    (r : Fin (M + 1) → Γ(C, ⨆ a, C.basicOpen (t J a))),
    IsProper q → (⨆ a, L.V a) = ⊤ → wcpaDjSepSec K q L e M t → wcpaDjAvRatio q L ⊤ t J r →
    (⨆ a, C.basicOpen (t J a)).toSpecΓ ≫ Spec.map (CommRingCat.ofHom
        (wcpaDjKConst K q (⨆ a, C.basicOpen (t J a)))) = (⨆ a, C.basicOpen (t J a)).ι ≫ q →
    ValuativeCriterion.Existence ((⨆ a, C.basicOpen (t J a)).toSpecΓ ≫
      Spec.map (CommRingCat.ofHom (wcpaDjAvChart q L ⊤ t J r))) :=
by
  intro K _ C q L e M t J r hq hcov hsep hr hcomp
  classical

  have bridgeA : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (h : ⊤ ≤ f ⁻¹ᵁ ⊤),
      f.appLE ⊤ ⊤ h = f.appTop := by
    intro X Y f h
    rw [Scheme.Hom.appLE]
    show f.app ⊤ ≫ X.presheaf.map (𝟙 _) = f.app ⊤
    rw [X.presheaf.map_id, Category.comp_id]
  have k1 : ∀ {X : Scheme.{u}} (U : X.Opens) (hle : ⊤ ≤ U.ι ⁻¹ᵁ U),
      U.ι.appLE U ⊤ hle = U.topIso.inv := by
    intro X U hle
    rw [Scheme.Opens.ι_appLE, Scheme.Opens.topIso_inv]
    congr 1
  have c1 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (X : Scheme.{u})
      (ℓ : Spec (.of R) ⟶ X) (U : X.Opens), ℓ (IsLocalRing.closedPoint R) ∈ U → ∀ x, ℓ x ∈ U :=
    fun R _ _ X ℓ U h x =>
      ((IsLocalRing.specializes_closedPoint x).map ℓ.continuous).mem_open U.isOpen h
  have c2 : ∀ {R F A : CommRingCat.{u}} (f : R ⟶ F), Function.Injective f.hom →
      ∀ (g h : Spec R ⟶ Spec A), Spec.map f ≫ g = Spec.map f ≫ h → g = h := by
    intro R F A f hf g h hgh
    have eg := Spec.map_preimage g
    have eh := Spec.map_preimage h
    rw [← eg, ← eh] at hgh ⊢
    rw [← Spec.map_comp, ← Spec.map_comp] at hgh
    have h1 := Spec.map_injective hgh
    congr 1
    ext a
    apply hf
    have := congrArg (fun φ => φ.hom a) h1
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using this
  have c3 : ∀ {S R : Type u} [CommRing S] [CommRing R] (φ : S →+* R) {N : ℕ}
      (tt : Fin (N + 1) → S) (α : Fin (N + 1) → R) (JJ : Fin (N + 1)),
      Ideal.span (Set.range tt) = ⊤ → (∀ l, α l * φ (tt JJ) = φ (tt l)) → IsUnit (φ (tt JJ)) := by
    intro S R _ _ φ N tt α JJ hspan hα
    have h1 : (1 : S) ∈ Ideal.span (Set.range tt) := by rw [hspan]; exact Submodule.mem_top
    obtain ⟨μ, hμ⟩ := (Ideal.mem_span_range_iff_exists_fun).mp h1
    have h2 : (∑ l, φ (μ l) * α l) * φ (tt JJ) = 1 := by
      rw [Finset.sum_mul]
      have : ∀ l, φ (μ l) * α l * φ (tt JJ) = φ (μ l * tt l) := fun l => by
        rw [mul_assoc, hα l, map_mul]
      simp only [this, ← map_sum, hμ, map_one]
    exact isUnit_of_mul_isUnit_right (by rw [h2]; exact isUnit_one)
  have c7 : ∀ {R F : CommRingCat.{u}} (f : R ⟶ F), Function.Injective f.hom →
      Function.Injective (Spec.map f).appTop.hom := by
    intro R F f hf x y hxy
    have nat := Scheme.ΓSpecIso_naturality f
    have e : ∀ z, (Scheme.ΓSpecIso F).hom.hom ((Spec.map f).appTop.hom z) =
        f.hom ((Scheme.ΓSpecIso R).hom.hom z) := by
      intro z
      have := congrArg (fun φ => φ.hom z) nat
      simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using this
    have h1 := congrArg (Scheme.ΓSpecIso F).hom.hom hxy
    rw [e, e] at h1
    have h2 := hf h1
    have hi : ∀ z, (Scheme.ΓSpecIso R).inv.hom ((Scheme.ΓSpecIso R).hom.hom z) = z := by
      intro z
      show ((Scheme.ΓSpecIso R).hom ≫ (Scheme.ΓSpecIso R).inv).hom z = z
      rw [Iso.hom_inv_id]; rfl
    calc x = (Scheme.ΓSpecIso R).inv.hom ((Scheme.ΓSpecIso R).hom.hom x) := (hi x).symm
      _ = (Scheme.ΓSpecIso R).inv.hom ((Scheme.ΓSpecIso R).hom.hom y) := by rw [h2]
      _ = y := hi y
  have c8 : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (k : X ⟶ Z), f ≫ g = k →
      ∀ (V : Z.Opens) (h : ⊤ ≤ g ⁻¹ᵁ V) (h' : ⊤ ≤ k ⁻¹ᵁ V) (x : Γ(Z, V)),
      f.appTop.hom ((g.appLE V ⊤ h).hom x) = (k.appLE V ⊤ h').hom x := by
    intro X Y Z f g k hk V h h' x
    subst hk
    rw [← bridgeA f (fun _ _ => trivial)]
    have := congrArg (fun φ => φ.hom x)
      (Scheme.Hom.appLE_comp_appLE f g V ⊤ ⊤ h (fun _ _ => trivial))
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using this
  have c9 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (h : ⊤ ≤ f ⁻¹ᵁ U) (s : Γ(Y, U)),
      IsUnit ((f.appLE U ⊤ h).hom s) → ∀ x : X, f x ∈ Y.basicOpen s := by
    intro X Y f U h s hs x
    have e2 : X.basicOpen ((f.appLE U ⊤ h).hom s) = ⊤ ⊓ X.basicOpen ((f.app U).hom s) :=
      Scheme.basicOpen_res X ((f.app U).hom s) (homOfLE h).op
    have e3 : X.basicOpen ((f.appLE U ⊤ h).hom s) = ⊤ := Scheme.basicOpen_of_isUnit X hs
    have h0 : x ∈ X.basicOpen ((f.app U).hom s) := by
      have : x ∈ ((⊤ : X.Opens) ⊓ X.basicOpen ((f.app U).hom s)) := by rw [← e2, e3]; trivial
      exact (inf_le_right : (⊤ : X.Opens) ⊓ _ ≤ _) this
    have h3 := Scheme.preimage_basicOpen f s
    have : x ∈ f ⁻¹ᵁ Y.basicOpen s := by rw [h3]; exact h0
    exact this
  have c5 : ∀ {X T : Scheme.{u}} (U : X.Opens) (R : CommRingCat.{u}) (ψ' : R ⟶ Γ(X, U))
      (g' : T ⟶ U.toScheme) (h : ⊤ ≤ (g' ≫ U.ι) ⁻¹ᵁ U) (P : R),
      (g' ≫ U.toSpecΓ ≫ Spec.map ψ').appTop.hom ((Scheme.ΓSpecIso R).inv.hom P) =
        ((g' ≫ U.ι).appLE U ⊤ h).hom (ψ'.hom P) := by
    intro X T U R ψ' g' h P
    have e : (Scheme.ΓSpecIso R).inv ≫ (Spec.map ψ').appTop =
        ψ' ≫ (Scheme.ΓSpecIso Γ(X, U)).inv := by
      rw [Iso.inv_comp_eq, ← Category.assoc, Iso.eq_comp_inv]
      exact Scheme.ΓSpecIso_naturality ψ'
    have key : U.topIso.inv ≫ g'.appTop = (g' ≫ U.ι).appLE U ⊤ h := by
      rw [← bridgeA g' (le_of_eq (Scheme.Hom.preimage_top g').symm), ← k1 U (by simp)]
      exact Scheme.Hom.appLE_comp_appLE g' U.ι U ⊤ ⊤ _ _
    have big : (Scheme.ΓSpecIso R).inv ≫ (g' ≫ U.toSpecΓ ≫ Spec.map ψ').appTop =
        ψ' ≫ (g' ≫ U.ι).appLE U ⊤ h := by
      rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, ← key, Scheme.Opens.toSpecΓ_appTop]
      simp only [← Category.assoc]
      rw [e]
      simp only [Category.assoc, Iso.inv_hom_id_assoc]
    have := congrArg (fun φ => φ.hom P) big
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using this
  have resApp : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) {U U' : Y.Opens} (hUU : U ≤ U')
      (e : ⊤ ≤ f ⁻¹ᵁ U) (x : Γ(Y, U')),
      (f.appLE U ⊤ e).hom ((Y.presheaf.map (homOfLE hUU).op).hom x) =
        (f.appLE U' ⊤ (fun z hz => hUU (e hz))).hom x := by
    intro X Y f U U' hUU e x
    have := congrArg (fun φ => φ.hom x) (Scheme.Hom.map_appLE f e (homOfLE hUU).op)
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using this

  set ψ := wcpaDjAvChart q L ⊤ t J r with hψ
  set jK : K →+* MvPolynomial (Fin (M + 1)) Γ(Spec (.of K), ⊤) :=
    MvPolynomial.C.comp (Scheme.ΓSpecIso (.of K)).inv.hom with hjK
  have hψj : ψ.comp jK = wcpaDjKConst K q (⨆ a, C.basicOpen (t J a)) := by
    apply RingHom.ext; intro k
    simp only [hψ, hjK, RingHom.comp_apply, wcpaDjAvChart, MvPolynomial.eval₂Hom_C,
      wcpaDjKConst, CommRingCat.hom_comp]
    rfl
  set s : Spec (CommRingCat.of (MvPolynomial (Fin (M + 1)) Γ(Spec (.of K), ⊤))) ⟶
    Spec (.of K) := Spec.map (CommRingCat.ofHom jK) with hs
  have hφs : ((⨆ a, C.basicOpen (t J a)).toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ)) ≫ s = (⨆ a, C.basicOpen (t J a)).ι ≫ q := by
    rw [hs, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hψj]
    exact hcomp
  haveI := hq
  have hEx : ValuativeCriterion.Existence q :=
    ((UniversallyClosed.eq_valuativeCriterion ▸ (inferInstance : UniversallyClosed q) :
      (ValuativeCriterion.Existence ⊓ @QuasiCompact) q).1)
  intro S

  obtain ⟨ℓ, hfl⟩ : ∃ ℓ : Spec (.of S.R) ⟶ C,
      Spec.map (CommRingCat.ofHom (algebraMap S.R S.K)) ≫ ℓ = S.i₁ ≫ (⨆ a, C.basicOpen (t J a)).ι := by
    obtain ⟨⟨ℓ, hfl, -⟩⟩ := (hEx ⟨S.R, S.K, S.i₁ ≫ (⨆ a, C.basicOpen (t J a)).ι, S.i₂ ≫ s,
      ⟨by rw [Category.assoc, ← hφs, S.commSq.w_assoc]⟩⟩).exists_lift
    exact ⟨ℓ, hfl⟩

  have hc : ℓ (IsLocalRing.closedPoint S.R) ∈ (⨆ a, L.V a) := by rw [hcov]; trivial
  obtain ⟨a, ha⟩ := (TopologicalSpace.Opens.mem_iSup).mp hc
  have hℓV : ∀ x, ℓ x ∈ L.V a ⊓ q ⁻¹ᵁ ⊤ := by
    intro x
    exact ⟨c1 S.R C ℓ _ ha x, by simp⟩
  have h2ℓ : ⊤ ≤ ℓ ⁻¹ᵁ (L.V a ⊓ q ⁻¹ᵁ ⊤) := fun x _ => hℓV x
  have hgz : ∀ z, (S.i₁ ≫ (⨆ a, C.basicOpen (t J a)).ι) z = ℓ (Spec.map (CommRingCat.ofHom (algebraMap S.R S.K)) z) := by
    intro z; rw [← hfl, Scheme.Hom.comp_apply]
  have h2 : ⊤ ≤ (S.i₁ ≫ (⨆ a, C.basicOpen (t J a)).ι) ⁻¹ᵁ (L.V a ⊓ q ⁻¹ᵁ ⊤) := fun z _ => by
    show (S.i₁ ≫ (⨆ a, C.basicOpen (t J a)).ι) z ∈ L.V a ⊓ q ⁻¹ᵁ ⊤
    rw [hgz]; exact hℓV _
  have hD' : ∀ z, (S.i₁ ≫ (⨆ a, C.basicOpen (t J a)).ι) z ∈ (⨆ a, C.basicOpen (t J a)) := by
    intro z
    rw [Scheme.Hom.comp_apply]
    exact (S.i₁ z).2
  have h1 : ⊤ ≤ (S.i₁ ≫ (⨆ a, C.basicOpen (t J a)).ι) ⁻¹ᵁ (⨆ a, C.basicOpen (t J a)) := fun z _ => hD' z

  have c10 : ∀ (b : Fin L.m) (x : C), x ∈ C.basicOpen (t J b) → x ∈ L.V a →
      x ∈ C.basicOpen (t J a) := by
    intro b x hb hxa
    have hxb : x ∈ L.V b ⊓ q ⁻¹ᵁ ⊤ := C.basicOpen_le _ hb
    have hWb : L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ ⊤ ≤ L.V b ⊓ q ⁻¹ᵁ ⊤ :=
      le_inf (inf_le_left.trans inf_le_right) inf_le_right
    have hWa : L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ ⊤ ≤ L.V a ⊓ q ⁻¹ᵁ ⊤ :=
      le_inf (inf_le_left.trans inf_le_left) inf_le_right
    have hWg : L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ ⊤ ≤ L.V a ⊓ L.V b := inf_le_left
    have hW : x ∈ L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ ⊤ := ⟨⟨hxa, hxb.1⟩, hxb.2⟩
    have heq := hsep.1 J a b
    have e1 := C.basicOpen_res (t J b) (homOfLE hWb).op
    have e2 := C.basicOpen_res (t J a) (homOfLE hWa).op
    have e3 := C.basicOpen_mul
      ((C.presheaf.map (homOfLE hWg).op).hom ((L.g a b : Γ(C, L.V a ⊓ L.V b)) ^ e))
      ((C.presheaf.map (homOfLE hWa).op).hom (t J a))
    have h4 : x ∈ C.basicOpen ((C.presheaf.map (homOfLE hWb).op).hom (t J b)) := by
      have h5 : x ∈ (L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ ⊤) ⊓ C.basicOpen (t J b) := ⟨hW, hb⟩
      rw [← e1] at h5; exact h5
    rw [heq, e3] at h4
    have h6 : x ∈ C.basicOpen ((C.presheaf.map (homOfLE hWa).op).hom (t J a)) := h4.2
    have h7 : x ∈ (L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ ⊤) ⊓ C.basicOpen (t J a) := by
      rw [← e2]; exact h6
    exact h7.2
  have hgen : ∀ z, (S.i₁ ≫ (⨆ a, C.basicOpen (t J a)).ι) z ∈ C.basicOpen (t J a) := by
    intro z
    obtain ⟨b, hb⟩ := (TopologicalSpace.Opens.mem_iSup).mp (hD' z)
    exact c10 b _ hb (h2 (Set.mem_univ z)).1
  have h3 : ⊤ ≤ (S.i₁ ≫ (⨆ a, C.basicOpen (t J a)).ι) ⁻¹ᵁ C.basicOpen (t J a) := fun z _ => hgen z

  have hc6 : ∀ l, ((S.i₁ ≫ (⨆ a, C.basicOpen (t J a)).ι).appLE (⨆ a, C.basicOpen (t J a)) ⊤ h1).hom (r l) *
      ((S.i₁ ≫ (⨆ a, C.basicOpen (t J a)).ι).appLE (L.V a ⊓ q ⁻¹ᵁ ⊤) ⊤ h2).hom (t J a) =
      ((S.i₁ ≫ (⨆ a, C.basicOpen (t J a)).ι).appLE (L.V a ⊓ q ⁻¹ᵁ ⊤) ⊤ h2).hom (t l a) := by
    intro l
    have hr' := congrArg (((S.i₁ ≫ (⨆ a, C.basicOpen (t J a)).ι).appLE (C.basicOpen (t J a)) ⊤ h3).hom) (hr a l)
    rw [map_mul, resApp, resApp, resApp] at hr'
    exact hr'

  have hid : ∀ l, S.i₂.appTop.hom ((Scheme.ΓSpecIso
        (CommRingCat.of (MvPolynomial (Fin (M + 1)) Γ(Spec (.of K), ⊤)))).inv.hom
          (MvPolynomial.X l)) * (ℓ.appLE (L.V a ⊓ q ⁻¹ᵁ ⊤) ⊤ h2ℓ).hom (t J a) =
      (ℓ.appLE (L.V a ⊓ q ⁻¹ᵁ ⊤) ⊤ h2ℓ).hom (t l a) := by
    intro l
    apply c7 (CommRingCat.ofHom (algebraMap S.R S.K)) (IsFractionRing.injective S.R S.K)
    rw [map_mul]
    have eα : (Spec.map (CommRingCat.ofHom (algebraMap S.R S.K))).appTop.hom
        (S.i₂.appTop.hom ((Scheme.ΓSpecIso
          (CommRingCat.of (MvPolynomial (Fin (M + 1)) Γ(Spec (.of K), ⊤)))).inv.hom
            (MvPolynomial.X l))) = ((S.i₁ ≫ (⨆ a, C.basicOpen (t J a)).ι).appLE (⨆ a, C.basicOpen (t J a)) ⊤ h1).hom (r l) := by
      have h0 := c5 (⨆ a, C.basicOpen (t J a)) _ (CommRingCat.ofHom ψ) S.i₁ h1 (MvPolynomial.X l)
      have hw : Spec.map (CommRingCat.ofHom (algebraMap S.R S.K)) ≫ S.i₂ =
          S.i₁ ≫ (⨆ a, C.basicOpen (t J a)).toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ) := S.commSq.w.symm
      have h3' : (Spec.map (CommRingCat.ofHom (algebraMap S.R S.K))).appTop.hom
          (S.i₂.appTop.hom ((Scheme.ΓSpecIso
            (CommRingCat.of (MvPolynomial (Fin (M + 1)) Γ(Spec (.of K), ⊤)))).inv.hom
              (MvPolynomial.X l))) =
          (Spec.map (CommRingCat.ofHom (algebraMap S.R S.K)) ≫ S.i₂).appTop.hom
            ((Scheme.ΓSpecIso
              (CommRingCat.of (MvPolynomial (Fin (M + 1)) Γ(Spec (.of K), ⊤)))).inv.hom
                (MvPolynomial.X l)) := by
        rw [Scheme.Hom.comp_appTop]; rfl
      rw [h3', hw, h0]
      have hX : (CommRingCat.ofHom ψ).hom (MvPolynomial.X l) = r l := by
        rw [hψ]; simp only [wcpaDjAvChart, CommRingCat.hom_ofHom, MvPolynomial.eval₂Hom_X']
      rw [hX]
    have eτ : ∀ l', (Spec.map (CommRingCat.ofHom (algebraMap S.R S.K))).appTop.hom
        ((ℓ.appLE (L.V a ⊓ q ⁻¹ᵁ ⊤) ⊤ h2ℓ).hom (t l' a)) =
        ((S.i₁ ≫ (⨆ a, C.basicOpen (t J a)).ι).appLE (L.V a ⊓ q ⁻¹ᵁ ⊤) ⊤ h2).hom (t l' a) := fun l' =>
      c8 _ ℓ (S.i₁ ≫ (⨆ a, C.basicOpen (t J a)).ι) hfl _ h2ℓ h2 (t l' a)
    rw [eα, eτ, eτ]
    exact hc6 l

  have hunit := c3 (ℓ.appLE (L.V a ⊓ q ⁻¹ᵁ ⊤) ⊤ h2ℓ).hom (fun l => t l a)
    (fun l => S.i₂.appTop.hom ((Scheme.ΓSpecIso
        (CommRingCat.of (MvPolynomial (Fin (M + 1)) Γ(Spec (.of K), ⊤)))).inv.hom
          (MvPolynomial.X l))) J (hsep.2.1 a) hid
  have hrange : Set.range ℓ ⊆ Set.range (⨆ a, C.basicOpen (t J a)).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨x, rfl⟩
    exact (le_iSup (fun a' => C.basicOpen (t J a')) a) (c9 ℓ _ h2ℓ _ hunit x)
  have hl : IsOpenImmersion.lift (⨆ a, C.basicOpen (t J a)).ι ℓ hrange ≫ (⨆ a, C.basicOpen (t J a)).ι = ℓ := IsOpenImmersion.lift_fac _ _ _

  have hfacl : Spec.map (CommRingCat.ofHom (algebraMap S.R S.K)) ≫
      IsOpenImmersion.lift (⨆ a, C.basicOpen (t J a)).ι ℓ hrange = S.i₁ := by
    rw [← cancel_mono (⨆ a, C.basicOpen (t J a)).ι, Category.assoc, hl]; exact hfl
  have hfacr : IsOpenImmersion.lift (⨆ a, C.basicOpen (t J a)).ι ℓ hrange ≫
      ((⨆ a, C.basicOpen (t J a)).toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ)) = S.i₂ := by
    apply c2 (CommRingCat.ofHom (algebraMap S.R S.K)) (IsFractionRing.injective S.R S.K)
    rw [← Category.assoc, hfacl]
    exact S.commSq.w
  exact ⟨⟨⟨IsOpenImmersion.lift (⨆ a, C.basicOpen (t J a)).ι ℓ hrange, hfacl, hfacr⟩⟩⟩

theorem wcpa_dj_fva_cc_locallyQuasiFinite : ∀ (K : Type u) [Field K] (X : Scheme.{u})
    (q : X ⟶ Spec (.of K)) [LocallyOfFiniteType q] (U : X.Opens) (Y : Scheme.{u})
    (φ : U.toScheme ⟶ Y) [LocallyOfFiniteType φ],
    (∀ x : U.toScheme, IsClosed ({x} : Set U.toScheme) → ⇑φ ⁻¹' {φ x} = {x}) →
    LocallyQuasiFinite φ :=
by
  intro K _ X q _ U Y φ _ hfib
  have : JacobsonSpace U.toScheme := LocallyOfFiniteType.jacobsonSpace (U.ι ≫ q)
  have hcl : ∀ x : U.toScheme, IsClosed ({x} : Set U.toScheme) → x ∈ φ.quasiFiniteLocus := by
    intro x hx
    rw [Scheme.Hom.mem_quasiFiniteLocus, Scheme.Hom.quasiFiniteAt_iff_isOpen_singleton_asFiber]
    have hsub : ∀ a b : φ.fiber (φ x), a = b := by
      intro a b
      apply (Scheme.Hom.fiberHomeo φ (φ x)).injective
      apply Subtype.ext
      have ha : ((Scheme.Hom.fiberHomeo φ (φ x) a) : U.toScheme) ∈ ({x} : Set U.toScheme) := by
        rw [← hfib x hx]; exact (Scheme.Hom.fiberHomeo φ (φ x) a).2
      have hb : ((Scheme.Hom.fiberHomeo φ (φ x) b) : U.toScheme) ∈ ({x} : Set U.toScheme) := by
        rw [← hfib x hx]; exact (Scheme.Hom.fiberHomeo φ (φ x) b).2
      exact (Set.mem_singleton_iff.mp ha).trans (Set.mem_singleton_iff.mp hb).symm
    have : ({φ.asFiber x} : Set (φ.fiber (φ x))) = Set.univ :=
      Set.eq_univ_of_forall (fun c => hsub c _)
    rw [this]
    exact isOpen_univ
  have htop : φ.quasiFiniteLocus = ⊤ := by
    rw [eq_top_iff]
    intro x _
    by_contra hx
    have hZ : IsClosed ((φ.quasiFiniteLocus : Set U.toScheme)ᶜ) :=
      φ.quasiFiniteLocus.isOpen.isClosed_compl
    obtain ⟨z, hzZ, hzc⟩ := nonempty_inter_closedPoints ⟨x, hx⟩ hZ.isLocallyClosed
    exact hzZ (hcl z (mem_closedPoints_iff.mp hzc))
  exact (Scheme.Hom.quasiFiniteLocus_eq_top_iff φ).mp htop

theorem wcpa_dj_fva_cc_residue_field : ∀ (K : Type u) [Field K] [IsAlgClosed K] (A B : Type u)
    [CommRing A] [CommRing B] (j : K →+* A) (ψ : A →+* B), ψ.Finite →
    ∀ 𝔫 : Ideal B, 𝔫.IsMaximal → (∀ a, ∃ k, ψ a - ψ (j k) ∈ 𝔫) →
    ∀ b, ∃ k, b - ψ (j k) ∈ 𝔫 :=
by
  intro K _ _ A B _ _ j ψ hψ 𝔫 h𝔫 hyp b
  haveI := h𝔫
  let π : B →+* B ⧸ 𝔫 := Ideal.Quotient.mk 𝔫
  let g : A →+* B ⧸ 𝔫 := π.comp ψ
  let f : K →+* B ⧸ 𝔫 := g.comp j
  have hπ : π.Finite := RingHom.Finite.of_surjective π Ideal.Quotient.mk_surjective
  have hg : g.IsIntegral := RingHom.IsIntegral.of_finite (RingHom.Finite.comp hπ hψ)
  have s2 : ∀ a, g a ∈ f.range := by
    intro a
    obtain ⟨k, hk⟩ := hyp a
    refine RingHom.mem_range.mpr ⟨k, ?_⟩
    exact (Ideal.Quotient.eq.mpr hk).symm
  let ι : f.range →+* B ⧸ 𝔫 := f.range.subtype
  let g' : A →+* f.range := g.codRestrict f.range s2
  let f' : K →+* f.range := f.rangeRestrict
  have e1 : ι.comp g' = g := RingHom.ext fun x => rfl
  have e2 : ι.comp f' = f := RingHom.ext fun x => rfl
  have hι : ι.IsIntegral := RingHom.IsIntegral.tower_top (f := g') (g := ι) (by rw [e1]; exact hg)
  have hf' : f'.IsIntegral := RingHom.isIntegral_of_surjective f' (RingHom.rangeRestrict_surjective f)
  have hf : f.IsIntegral := by
    rw [← e2]; exact RingHom.IsIntegral.trans f' ι hf' hι
  have hsurj : Function.Surjective f := by
    letI : Algebra K (B ⧸ 𝔫) := f.toAlgebra
    haveI : Algebra.IsIntegral K (B ⧸ 𝔫) := ⟨fun x => hf x⟩
    have := (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K) (K := B ⧸ 𝔫)).2
    rwa [RingHom.algebraMap_toAlgebra] at this
  obtain ⟨k, hk⟩ := hsurj (π b)
  exact ⟨k, Ideal.Quotient.eq.mp hk.symm⟩

theorem wcpa_dj_fva_cc_localization_span : ∀ (B S : Type u) [CommRing B] [CommRing S]
    [IsLocalRing S] (φ : B →+* S) (𝔫 : Ideal B), 𝔫.IsPrime →
    (∀ b, φ b ∈ IsLocalRing.maximalIdeal S ↔ b ∈ 𝔫) →
    (∀ z, ∃ b, ∃ s ∉ 𝔫, φ s * z = φ b) →
    (∀ b, φ b = 0 → ∃ s ∉ 𝔫, s * b = 0) →
    ∀ (n : ℕ) (g : Fin n → B),
    Ideal.span (Set.range (fun i => φ (g i))) = IsLocalRing.maximalIdeal S →
    ∀ b ∈ 𝔫, ∃ s ∉ 𝔫, s * b ∈ Ideal.span (Set.range g) :=
by
  intro B S _ _ _ φ 𝔫 h𝔫 hm hsurj hker n g hspan b hb
  have hmul : ∀ s t : B, s ∉ 𝔫 → t ∉ 𝔫 → s * t ∉ 𝔫 := fun s t hs ht hst =>
    (h𝔫.mem_or_mem hst).elim hs ht
  have h1 : (1 : B) ∉ 𝔫 := fun h => h𝔫.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  let T : Ideal S :=
    { carrier := { z | ∃ b' s, b' ∈ Ideal.span (Set.range g) ∧ s ∉ 𝔫 ∧ φ s * z = φ b' }
      add_mem' := by
        rintro z₁ z₂ ⟨b₁, s₁, hb₁, hs₁, e₁⟩ ⟨b₂, s₂, hb₂, hs₂, e₂⟩
        refine ⟨s₂ * b₁ + s₁ * b₂, s₁ * s₂,
          Ideal.add_mem _ (Ideal.mul_mem_left _ _ hb₁) (Ideal.mul_mem_left _ _ hb₂),
          hmul _ _ hs₁ hs₂, ?_⟩
        simp only [map_mul, map_add]
        linear_combination φ s₂ * e₁ + φ s₁ * e₂
      zero_mem' := ⟨0, 1, Ideal.zero_mem _, h1, by simp⟩
      smul_mem' := by
        rintro y z ⟨b', s, hb', hs, e⟩
        obtain ⟨c, s', hs', hy⟩ := hsurj y
        refine ⟨c * b', s' * s, Ideal.mul_mem_left _ _ hb', hmul _ _ hs' hs, ?_⟩
        simp only [smul_eq_mul, map_mul]
        linear_combination (φ s * z) * hy + φ c * e }
  have hle : IsLocalRing.maximalIdeal S ≤ T := by
    rw [← hspan, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact ⟨g i, 1, Ideal.subset_span ⟨i, rfl⟩, h1, by simp⟩
  obtain ⟨b', s, hb', hs, e⟩ := hle ((hm b).mpr hb)
  obtain ⟨u, hu, hu0⟩ := hker (s * b - b') (by rw [map_sub, map_mul, e, sub_self])
  refine ⟨u * s, hmul _ _ hu hs, ?_⟩
  have hid : u * s * b = u * (s * b - b') + u * b' := by ring
  rw [hid, hu0, zero_add]
  exact Ideal.mul_mem_left _ _ hb'

theorem wcpa_dj_fva_cc_affine_dictionary : ∀ (X : Scheme.{u}) (U : X.Opens), IsAffineOpen U →
    ∀ 𝔫 : Ideal Γ(X, U), 𝔫.IsMaximal →
    ∃ (x : X) (hx : x ∈ U), IsClosed ({(⟨x, hx⟩ : U)} : Set U.toScheme) ∧
      (∀ b, (X.presheaf.germ U x hx).hom b ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) ↔
        b ∈ 𝔫) ∧
      (∀ z : X.presheaf.stalk x, ∃ b, ∃ s ∉ 𝔫,
        (X.presheaf.germ U x hx).hom s * z = (X.presheaf.germ U x hx).hom b) ∧
      (∀ b, (X.presheaf.germ U x hx).hom b = 0 → ∃ s ∉ 𝔫, s * b = 0) :=
by

  intro X U hU 𝔫 h𝔫
  haveI hprime : 𝔫.IsPrime := h𝔫.isPrime
  set p : PrimeSpectrum Γ(X, U) := ⟨𝔫, hprime⟩ with hp
  set y : U.toScheme := hU.isoSpec.inv p with hy
  have s1 : hU.primeIdealOf y = p := by
    show hU.isoSpec.hom (hU.isoSpec.inv p) = p
    exact Scheme.inv_hom_apply _ _
  have s1' : (hU.primeIdealOf y).asIdeal = 𝔫 := by rw [s1]
  letI : Algebra Γ(X, U) (X.presheaf.stalk y.1) := X.presheaf.algebra_section_stalk y
  have hloc0 := hU.isLocalization_stalk y
  have halg : algebraMap Γ(X, U) (X.presheaf.stalk y.1) = (X.presheaf.germ U y.1 y.2).hom :=
    TopCat.Presheaf.stalk_open_algebraMap _ _
  refine ⟨y.1, y.2, ?_, ?_, ?_, ?_⟩
  · have hcl : IsClosed ({(show Spec Γ(X, U) from p)} : Set (Spec Γ(X, U))) :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal p).mpr h𝔫
    have heq : ({(⟨y.1, y.2⟩ : U)} : Set U.toScheme) =
        (fun z : U.toScheme => hU.isoSpec.hom z) ⁻¹' {(show Spec Γ(X, U) from p)} := by
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl; exact s1
      · intro hz
        have h2 := congrArg (fun w => hU.isoSpec.inv w) hz
        simp only [Scheme.hom_inv_apply] at h2
        exact h2
    rw [heq]
    exact hcl.preimage hU.isoSpec.hom.continuous
  · intro b
    rw [← halg, ← s1']
    exact IsLocalization.AtPrime.to_map_mem_maximal_iff _ (hU.primeIdealOf y).asIdeal b
  · intro z
    obtain ⟨⟨b, s⟩, h⟩ := IsLocalization.surj (hU.primeIdealOf y).asIdeal.primeCompl z
    refine ⟨b, s.1, ?_, ?_⟩
    · rw [← s1']; exact s.2
    rw [← halg, mul_comm]
    exact h
  · intro b hb
    rw [← halg] at hb
    obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff (hU.primeIdealOf y).asIdeal.primeCompl _ b).mp hb
    refine ⟨m.1, ?_, hm⟩
    rw [← s1']; exact m.2

theorem wcpa_dj_fva_cc_nakayama_surj : ∀ (A B : Type u) [CommRing A] [CommRing B] (ψ : A →+* B),
    ψ.Finite →
    (∀ 𝔫 𝔫' : Ideal B, 𝔫.IsMaximal → 𝔫'.IsMaximal → 𝔫.comap ψ = 𝔫'.comap ψ → 𝔫 = 𝔫') →
    (∀ 𝔫 : Ideal B, 𝔫.IsMaximal → ∀ b, ∃ a, b - ψ a ∈ 𝔫) →
    (∀ 𝔫 : Ideal B, 𝔫.IsMaximal → ∀ b ∈ 𝔫, ∃ s ∉ 𝔫, s * b ∈ (𝔫.comap ψ).map ψ) →
    Function.Surjective ψ :=
by
  intro A B _ _ ψ hfin H1 H2 H3

  have s1 : ∀ 𝔪 : Ideal A, 𝔪.IsMaximal → ∀ b : B, ∃ a : A, b - ψ a ∈ 𝔪.map ψ := by
    intro 𝔪 h𝔪 b
    by_cases htop : 𝔪.map ψ = ⊤
    · exact ⟨0, by rw [htop]; trivial⟩
    obtain ⟨𝔫, h𝔫, hle⟩ := Ideal.exists_le_maximal _ htop
    have hcomap : ∀ 𝔫' : Ideal B, 𝔫'.IsMaximal → 𝔪.map ψ ≤ 𝔫' → 𝔫'.comap ψ = 𝔪 := by
      intro 𝔫' h' hle'
      have h1 : 𝔪 ≤ 𝔫'.comap ψ := Ideal.map_le_iff_le_comap.mp hle'
      exact (h𝔪.eq_of_le (Ideal.comap_ne_top ψ h'.ne_top) h1).symm
    have hunit : ∀ s ∉ 𝔫, ∃ x ∈ 𝔪.map ψ, ∃ y : B, x + y * s = 1 := by
      intro s hs
      have hsup : 𝔪.map ψ ⊔ Ideal.span {s} = ⊤ := by
        by_contra hne
        obtain ⟨𝔫', h𝔫', hle'⟩ := Ideal.exists_le_maximal _ hne
        have e : 𝔫' = 𝔫 := H1 𝔫' 𝔫 h𝔫' h𝔫
          ((hcomap 𝔫' h𝔫' (le_trans le_sup_left hle')).trans (hcomap 𝔫 h𝔫 hle).symm)
        apply hs
        rw [← e]
        exact hle' (Ideal.mem_sup_right (Ideal.mem_span_singleton_self s))
      have h1 : (1 : B) ∈ 𝔪.map ψ ⊔ Ideal.span {s} := by rw [hsup]; trivial
      obtain ⟨x, hx, z, hz, hxz⟩ := Submodule.mem_sup.mp h1
      obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.mp hz
      exact ⟨x, hx, y, hxz⟩
    have hnle : 𝔫 ≤ 𝔪.map ψ := by
      intro c hc
      obtain ⟨s, hs, hsc⟩ := H3 𝔫 h𝔫 c hc
      rw [hcomap 𝔫 h𝔫 hle] at hsc
      obtain ⟨x, hx, y, hxy⟩ := hunit s hs
      have hc' : c = x * c + y * (s * c) := by
        calc c = (x + y * s) * c := by rw [hxy, one_mul]
          _ = x * c + y * (s * c) := by ring
      rw [hc']
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hx) (Ideal.mul_mem_left _ _ hsc)
    obtain ⟨a, ha⟩ := H2 𝔫 h𝔫 b
    exact ⟨a, hnle ha⟩

  letI := ψ.toAlgebra
  haveI : Module.Finite A B := hfin
  set N : Submodule A B := LinearMap.range (Algebra.linearMap A B) with hN
  have hfg : (⊤ : Submodule A (B ⧸ N)).FG := Module.Finite.fg_top
  have hψN : ∀ a : A, ψ a ∈ N := fun a => ⟨a, rfl⟩
  have key : ∀ 𝔪 : Ideal A, 𝔪.IsMaximal →
      ∃ r : A, r - 1 ∈ 𝔪 ∧ ∀ x ∈ (⊤ : Submodule A (B ⧸ N)), r • x = 0 := by
    intro 𝔪 h𝔪
    apply Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul 𝔪 ⊤ hfg
    rintro x -
    obtain ⟨b, rfl⟩ := N.mkQ_surjective x
    obtain ⟨a, ha⟩ := s1 𝔪 h𝔪 b
    have hc : b - ψ a ∈ 𝔪 • (⊤ : Submodule A B) := by
      rw [Ideal.smul_top_eq_map]; exact ha
    have e : N.mkQ b = N.mkQ (b - ψ a) := by
      have h0 : N.mkQ (ψ a) = 0 := by
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
        exact hψN a
      rw [map_sub, h0, sub_zero]
    rw [e]
    have hm := Submodule.mem_map_of_mem (f := N.mkQ) hc
    rw [Submodule.map_smul''] at hm
    exact Submodule.smul_mono le_rfl le_top hm
  have hall : ∀ x : B ⧸ N, x = 0 := by
    by_contra hne
    push_neg at hne
    obtain ⟨x0, hx0⟩ := hne
    have hI : Module.annihilator A (B ⧸ N) ≠ ⊤ := by
      intro h
      apply hx0
      have h1 : (1 : A) ∈ Module.annihilator A (B ⧸ N) := h ▸ Submodule.mem_top
      rw [Module.mem_annihilator] at h1
      simpa using h1 x0
    obtain ⟨𝔪, h𝔪, hle⟩ := Ideal.exists_le_maximal _ hI
    obtain ⟨r, hr1, hr⟩ := key 𝔪 h𝔪
    have hrI : r ∈ Module.annihilator A (B ⧸ N) :=
      Module.mem_annihilator.mpr (fun x => hr x Submodule.mem_top)
    apply h𝔪.ne_top
    rw [Ideal.eq_top_iff_one]
    have h2 := 𝔪.sub_mem (hle hrI) hr1
    simpa using h2
  intro b
  have hb : N.mkQ b = 0 := hall _
  rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hb
  obtain ⟨a, ha⟩ := hb
  exact ⟨a, ha⟩

theorem wcpa_dj_fva_chart_criterion : ∀ (K : Type u) [Field K] [IsAlgClosed K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (L : wcpaDjCoc C), wcpaDjSemistable q → wcpaDjCocOK L →
    ∀ (e M : ℕ) (t : Fin (M + 1) → ∀ a : Fin L.m, Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤)),
      wcpaDjSepSec K q L e M t → wcpaDjVA q L ⊤ e :=
by
  intro K _ _ C q L hss hOK e M t hsep
  haveI hq : IsProper q := hss.2.1
  haveI hJac : JacobsonSpace C := LocallyOfFiniteType.jacobsonSpace q

  have resres : ∀ {U V W : C.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (h3 : W ≤ U) (x : Γ(C, U)),
      (C.presheaf.map (homOfLE h2).op).hom ((C.presheaf.map (homOfLE h1).op).hom x) =
        (C.presheaf.map (homOfLE h3).op).hom x := by
    intro U V W h1 h2 h3 x
    have e : C.presheaf.map (homOfLE h1).op ≫ C.presheaf.map (homOfLE h2).op =
        C.presheaf.map (homOfLE h3).op := by rw [← Functor.map_comp]; rfl
    have := congrArg (fun φ => φ.hom x) e
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using this

  have closed_transfer : ∀ (U : C.Opens) (x : U.toScheme), IsClosed ({x} : Set U.toScheme) →
      IsClosed ({x.1} : Set C) := by
    intro U x hx
    apply isClosed_singleton_of_isLocallyClosed_singleton
    have h1 : IsLocallyClosed (⇑U.ι '' {x}) :=
      hx.isLocallyClosed.image U.ι.isOpenEmbedding.toIsEmbedding.toIsInducing
        (by rw [Scheme.Opens.range_ι]; exact U.isOpen.isLocallyClosed)
    rwa [Set.image_singleton] at h1

  have fibre_singleton : ∀ {U Y : Type u} [TopologicalSpace U] [TopologicalSpace Y]
      [JacobsonSpace U] (f : U → Y), Continuous f →
      (∀ x, IsClosed ({x} : Set U) → IsClosed ({f x} : Set Y)) →
      (∀ x y, IsClosed ({x} : Set U) → IsClosed ({y} : Set U) → f x = f y → x = y) →
      ∀ x, IsClosed ({x} : Set U) → f ⁻¹' {f x} = {x} := by
    intro U Y _ _ _ f hf P1 P2 x hx
    ext x'
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    constructor
    · intro hx'
      have hZ : closure ({x'} : Set U) ⊆ {x} := by
        rw [← closure_inter_closedPoints (isClosed_closure : IsClosed (closure ({x'} : Set U)))]
        apply closure_minimal _ hx
        rintro z ⟨hz, hzc⟩
        have hsp : x' ⤳ z := specializes_iff_mem_closure.mpr hz
        have h2 : f x' ⤳ f z := hsp.map hf
        rw [hx'] at h2
        have h3 : f z ∈ closure ({f x} : Set Y) := specializes_iff_mem_closure.mp h2
        rw [(P1 x hx).closure_eq] at h3
        exact P2 z x (mem_closedPoints_iff.mp hzc) hx h3
      exact hZ (subset_closure rfl)
    · rintro rfl; rfl

  have taylor : ∀ (R : Type u) [CommRing R] (n : ℕ) (c : Fin n → R) (p : MvPolynomial (Fin n) R),
      p - MvPolynomial.C (MvPolynomial.eval c p) ∈
        Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) := by
    intro R _ n c p
    induction p using MvPolynomial.induction_on with
    | C a => simp
    | add p₁ p₂ h₁ h₂ =>
      have : p₁ + p₂ - MvPolynomial.C (MvPolynomial.eval c (p₁ + p₂)) =
          (p₁ - MvPolynomial.C (MvPolynomial.eval c p₁)) +
            (p₂ - MvPolynomial.C (MvPolynomial.eval c p₂)) := by
        simp only [map_add]; ring
      rw [this]; exact add_mem h₁ h₂
    | mul_X p₁ i h₁ =>
      have : p₁ * MvPolynomial.X i - MvPolynomial.C (MvPolynomial.eval c (p₁ * MvPolynomial.X i)) =
          (p₁ - MvPolynomial.C (MvPolynomial.eval c p₁)) * MvPolynomial.X i +
            MvPolynomial.C (MvPolynomial.eval c p₁) * (MvPolynomial.X i - MvPolynomial.C (c i)) := by
        simp only [map_mul, MvPolynomial.eval_X]; ring
      rw [this]
      exact add_mem (Ideal.mul_mem_right _ _ h₁) (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩))
  have hiso : ∀ k : K, (Scheme.ΓSpecIso (.of K)).hom.hom ((Scheme.ΓSpecIso (.of K)).inv.hom k) = k := by
    intro k
    show ((Scheme.ΓSpecIso (.of K)).inv ≫ (Scheme.ΓSpecIso (.of K)).hom).hom k = k
    rw [Iso.inv_hom_id]; rfl
  have hiso' : ∀ z : Γ(Spec (.of K), ⊤),
      (Scheme.ΓSpecIso (.of K)).inv.hom ((Scheme.ΓSpecIso (.of K)).hom.hom z) = z := by
    intro z
    show ((Scheme.ΓSpecIso (.of K)).hom ≫ (Scheme.ΓSpecIso (.of K)).inv).hom z = z
    rw [Iso.hom_inv_id]; rfl

  have key : ∀ J : Fin (M + 1), ∃ r : Fin (M + 1) → Γ(C, ⨆ a, C.basicOpen (t J a)),
      wcpaDjAvRatio q L ⊤ t J r ∧ IsAffineOpen (⨆ a, C.basicOpen (t J a)) ∧
      Function.Surjective (wcpaDjAvChart q L ⊤ t J r) := by
    intro J
    set D : C.Opens := ⨆ a, C.basicOpen (t J a) with hD
    obtain ⟨r, hr⟩ := wcpa_dj_fva_cc_ratio_glue K C q L e M t (fun J' => hsep.1 J') J
    refine ⟨r, hr, ?_⟩
    have hT := wcpa_dj_fva_cc_stalk_translate K C q L e M t J r hsep hr
    have hEx := wcpa_dj_fva_cc_valuative_existence K C q L e M t J r hq hOK.2.1 hsep hr
      ((wcpa_dj_fva_cc_toSpecGamma_api C D).2.2 K q)
    obtain ⟨hpt0, hfinaff, hkc⟩ := wcpa_dj_fva_cc_toSpecGamma_api C D
    set ψ := wcpaDjAvChart q L ⊤ t J r with hψ
    set φ : D.toScheme ⟶ Spec (CommRingCat.of (MvPolynomial (Fin (M + 1)) Γ(Spec (.of K), ⊤))) :=
      D.toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ) with hφ
    set jK : K →+* MvPolynomial (Fin (M + 1)) Γ(Spec (.of K), ⊤) :=
      MvPolynomial.C.comp (Scheme.ΓSpecIso (.of K)).inv.hom with hjK
    have hkc' : D.toSpecΓ ≫ Spec.map (CommRingCat.ofHom (wcpaDjKConst K q D)) = D.ι ≫ q := hkc K q
    have hψj : ψ.comp jK = wcpaDjKConst K q D := by
      apply RingHom.ext; intro k
      simp only [hψ, hjK, RingHom.comp_apply, wcpaDjAvChart, MvPolynomial.eval₂Hom_C,
        wcpaDjKConst, CommRingCat.hom_comp]
      rfl
    set s : Spec (CommRingCat.of (MvPolynomial (Fin (M + 1)) Γ(Spec (.of K), ⊤))) ⟶
      Spec (.of K) := Spec.map (CommRingCat.ofHom jK) with hs
    have hφs : φ ≫ s = D.ι ≫ q := by
      rw [hφ, hs, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hψj]
      exact hkc'
    have hcpt : IsCompact (D : Set C) := by
      rw [hD, TopologicalSpace.Opens.coe_iSup]
      apply isCompact_iUnion
      intro a
      have hVa : IsAffineOpen (L.V a ⊓ q ⁻¹ᵁ ⊤) := by
        rw [Scheme.Hom.preimage_top, inf_top_eq]; exact hOK.1 a
      exact (hVa.basicOpen (t J a)).isCompact

    haveI : LocallyOfFiniteType (φ ≫ s) := by rw [hφs]; infer_instance
    haveI : LocallyOfFiniteType φ := locallyOfFiniteType_of_comp φ s
    haveI : IsSeparated (φ ≫ s) := by rw [hφs]; infer_instance
    haveI : IsSeparated φ := IsSeparated.of_comp φ s
    haveI : CompactSpace D.toScheme := isCompact_iff_compactSpace.mp hcpt
    haveI : QuasiCompact φ := quasiCompact_of_compactSpace φ
    have hprop : IsProper φ := IsProper.of_valuativeCriterion φ (by
      rw [ValuativeCriterion.eq]; exact ⟨hEx, IsSeparated.valuativeCriterion φ⟩)
    haveI : JacobsonSpace D.toScheme := LocallyOfFiniteType.jacobsonSpace (D.ι ≫ q)
    have hpt : ∀ (x : D.toScheme) (P : MvPolynomial (Fin (M + 1)) Γ(Spec (.of K), ⊤)),
        P ∈ (φ x).asIdeal ↔
          (C.presheaf.germ D x.1 x.2).hom (ψ P) ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x.1) := by
      intro x P
      rw [hφ, hpt0 _ (CommRingCat.ofHom ψ) x, Ideal.mem_comap, CommRingCat.hom_comp,
        RingHom.comp_apply, CommRingCat.hom_ofHom]

    have P1 : ∀ x : D.toScheme, IsClosed ({x} : Set D.toScheme) →
        IsClosed ({φ x} : Set (Spec (CommRingCat.of (MvPolynomial (Fin (M + 1)) Γ(Spec (.of K), ⊤))))) := by
      intro x hx
      obtain ⟨c, hc⟩ := hT.1 x.1 x.2 (closed_transfer D x hx)
      refine (PrimeSpectrum.isClosed_singleton_iff_isMaximal (φ x)).mpr ?_
      let ev : MvPolynomial (Fin (M + 1)) Γ(Spec (.of K), ⊤) →+* K :=
        (Scheme.ΓSpecIso (.of K)).hom.hom.comp (MvPolynomial.eval c)
      have hev : Function.Surjective ev := fun k =>
        ⟨MvPolynomial.C ((Scheme.ΓSpecIso (.of K)).inv.hom k), by
          show (Scheme.ΓSpecIso (.of K)).hom.hom (MvPolynomial.eval c (MvPolynomial.C _)) = k
          rw [MvPolynomial.eval_C]; exact hiso k⟩
      have hmax := RingHom.ker_isMaximal_of_surjective ev hev
      have hspan : Ideal.span (Set.range fun l =>
          (MvPolynomial.X l - MvPolynomial.C (c l) : MvPolynomial (Fin (M + 1)) Γ(Spec (.of K), ⊤))) ≤
          (φ x).asIdeal := by
        rw [Ideal.span_le]
        rintro _ ⟨l, rfl⟩
        exact (hpt x _).mpr (by rw [← hc]; exact Ideal.subset_span ⟨l, rfl⟩)
      have hle : RingHom.ker ev ≤ (φ x).asIdeal := by
        intro p hp
        have hp0 : MvPolynomial.eval c p = 0 := by
          have h0 : (Scheme.ΓSpecIso (.of K)).hom.hom (MvPolynomial.eval c p) = 0 := hp
          have := congrArg (Scheme.ΓSpecIso (.of K)).inv.hom h0
          rwa [hiso', map_zero] at this
        have h1 := taylor _ _ c p
        rw [hp0, map_zero, sub_zero] at h1
        exact hspan h1
      rw [← hmax.eq_of_le (φ x).isPrime.ne_top hle]
      exact hmax

    have P2 : ∀ x y : D.toScheme, IsClosed ({x} : Set D.toScheme) →
        IsClosed ({y} : Set D.toScheme) → φ x = φ y → x = y := by
      intro x y hx hy hxy
      by_contra hne
      have hne' : x.1 ≠ y.1 := fun h => hne (Subtype.ext h)
      obtain ⟨P, hPx, hPy⟩ := hT.2 x.1 y.1 x.2 y.2 (closed_transfer D x hx)
        (closed_transfer D y hy) hne'
      have h1 : P ∈ (φ x).asIdeal := (hpt x P).mpr hPx
      rw [hxy] at h1
      exact hPy ((hpt y P).mp h1)
    have hfib : ∀ x : D.toScheme, IsClosed ({x} : Set D.toScheme) → ⇑φ ⁻¹' {φ x} = {x} :=
      fun x hx => fibre_singleton (⇑φ) φ.continuous P1 P2 x hx
    have hlqf : LocallyQuasiFinite φ := wcpa_dj_fva_cc_locallyQuasiFinite K C q D _ φ hfib
    haveI hfin : IsFinite φ := (IsFinite.iff_isProper_and_locallyQuasiFinite φ).mpr ⟨hprop, hlqf⟩
    obtain ⟨hDaff, hψfin⟩ := hfinaff _ (CommRingCat.ofHom ψ) hfin
    rw [CommRingCat.hom_ofHom] at hψfin
    refine ⟨hDaff, wcpa_dj_fva_cc_nakayama_surj _ _ ψ hψfin ?_ ?_ ?_⟩
    ·
      intro 𝔫 𝔫' h𝔫 h𝔫' hcom
      obtain ⟨x, hx, hxcl, hxm, -, -⟩ := wcpa_dj_fva_cc_affine_dictionary C D hDaff 𝔫 h𝔫
      obtain ⟨x', hx', hx'cl, hx'm, -, -⟩ := wcpa_dj_fva_cc_affine_dictionary C D hDaff 𝔫' h𝔫'
      by_cases hxx : x = x'
      · subst hxx
        ext b
        exact (hxm b).symm.trans (hx'm b)
      · exfalso
        obtain ⟨P, hP1, hP2⟩ := hT.2 x x' hx hx' (closed_transfer D (⟨x, hx⟩ : D) hxcl)
          (closed_transfer D (⟨x', hx'⟩ : D) hx'cl) hxx
        have h1 : P ∈ 𝔫.comap ψ := (hxm _).mp hP1
        rw [hcom, Ideal.mem_comap] at h1
        exact hP2 ((hx'm _).mpr h1)
    ·
      intro 𝔫 h𝔫 b
      obtain ⟨x, hx, hxcl, hxm, -, -⟩ := wcpa_dj_fva_cc_affine_dictionary C D hDaff 𝔫 h𝔫
      obtain ⟨c, hc⟩ := hT.1 x hx (closed_transfer D (⟨x, hx⟩ : D) hxcl)
      have hgen : ∀ l, ψ (MvPolynomial.X l - MvPolynomial.C (c l)) ∈ 𝔫 := fun l =>
        (hxm _).mp (by rw [← hc]; exact Ideal.subset_span ⟨l, rfl⟩)
      have hspan : Ideal.span (Set.range fun l =>
          (MvPolynomial.X l - MvPolynomial.C (c l) : MvPolynomial (Fin (M + 1)) Γ(Spec (.of K), ⊤))) ≤
          𝔫.comap ψ := by
        rw [Ideal.span_le]
        rintro _ ⟨l, rfl⟩
        exact hgen l
      obtain ⟨k, hk⟩ := wcpa_dj_fva_cc_residue_field K _ _ jK ψ hψfin 𝔫 h𝔫 (fun a =>
        ⟨(Scheme.ΓSpecIso (.of K)).hom.hom (MvPolynomial.eval c a), by
          have h1 : ψ (a - MvPolynomial.C (MvPolynomial.eval c a)) ∈ 𝔫 :=
            hspan (taylor _ _ c a)
          rw [map_sub] at h1
          show ψ a - ψ (MvPolynomial.C ((Scheme.ΓSpecIso (.of K)).inv.hom
            ((Scheme.ΓSpecIso (.of K)).hom.hom (MvPolynomial.eval c a)))) ∈ 𝔫
          rw [hiso']
          exact h1⟩) b
      exact ⟨jK k, hk⟩
    ·
      intro 𝔫 h𝔫 b hb
      obtain ⟨x, hx, hxcl, hxm, hxs, hxk⟩ := wcpa_dj_fva_cc_affine_dictionary C D hDaff 𝔫 h𝔫
      obtain ⟨c, hc⟩ := hT.1 x hx (closed_transfer D (⟨x, hx⟩ : D) hxcl)
      have hgen : ∀ l, ψ (MvPolynomial.X l - MvPolynomial.C (c l)) ∈ 𝔫 := fun l =>
        (hxm _).mp (by rw [← hc]; exact Ideal.subset_span ⟨l, rfl⟩)
      obtain ⟨s', hs', hsb⟩ := wcpa_dj_fva_cc_localization_span _ _ (C.presheaf.germ D x hx).hom 𝔫
        h𝔫.isPrime hxm hxs hxk (M + 1) (fun l => ψ (MvPolynomial.X l - MvPolynomial.C (c l))) hc b hb
      refine ⟨s', hs', ?_⟩
      have hle : Ideal.span (Set.range fun l => ψ (MvPolynomial.X l - MvPolynomial.C (c l))) ≤
          (𝔫.comap ψ).map ψ := by
        rw [Ideal.span_le]
        rintro _ ⟨l, rfl⟩
        exact Ideal.mem_map_of_mem ψ (show _ ∈ 𝔫.comap ψ from hgen l)
      exact hle hsb
  unfold wcpaDjVA
  refine ⟨M, t, hsep.1, hsep.2.1, fun J => (key J).choose_spec.2.1, ?_⟩
  intro J f
  obtain ⟨r, hr, -, hsurj⟩ := key J
  obtain ⟨P, hP⟩ := hsurj f
  refine ⟨P, fun a => ?_⟩
  obtain ⟨inv, hinv⟩ : ∃ inv, inv * (C.presheaf.map (homOfLE (C.basicOpen_le (t J a))).op).hom
      (t J a) = 1 := (RingedSpace.isUnit_res_basicOpen C.toRingedSpace (t J a)).exists_left_inv
  refine ⟨inv, hinv, ?_⟩
  rw [← hP]
  simp only [wcpaDjAvChart, MvPolynomial.coe_eval₂Hom]
  rw [MvPolynomial.eval₂_comp_left]
  congr 1
  · apply RingHom.ext; intro c
    simp only [RingHom.comp_apply]
    exact resres _ _ _ _
  · funext l
    have h1 := hr a l
    simp only [Function.comp_apply]
    rw [← h1, mul_assoc, mul_comm _ inv, hinv, mul_one]

theorem wcpa_dj_sv_twist_reduce {Y : Scheme.{u}} (L : wcpaDjCoc Y) (hL : wcpaDjCocOK L) (r : ℕ)
    (F : Y.Modules) (hF : wcCoherentMod F) :
    ∃ G : Y.Modules, wcCoherentMod G ∧
      ∀ (U : Y.Opens) (m : ℕ), wcpaDjTwH1 L U G m → wcpaDjTwH1 L U F (m + r) :=
by
  obtain ⟨G, φ, hbij, hsmul, hnat, htr⟩ := wcpa_dj_twr_construct L hL r F
  refine ⟨G, wcpa_dj_twr_coherent_transfer L.V hL.1 hL.2.1 F G φ hbij hsmul hnat hF, ?_⟩
  intro U m hG c hc
  have hpre : ∀ a b, ∃ x : Γ(G, L.V a ⊓ L.V b ⊓ U),
      φ b (L.V a ⊓ L.V b ⊓ U) (inf_le_left.trans inf_le_right) x = c a b :=
    fun a b => (hbij b (L.V a ⊓ L.V b ⊓ U) (inf_le_left.trans inf_le_right)).2 (c a b)
  choose c' hc' using hpre
  refine (hG c' ?_).elim (fun β' hβ' => ?_)
  · intro a b d
    have hQd : L.V a ⊓ L.V b ⊓ L.V d ⊓ U ≤ L.V d := inf_le_left.trans inf_le_right
    have hQb : L.V a ⊓ L.V b ⊓ L.V d ⊓ U ≤ L.V b :=
      inf_le_left.trans (inf_le_left.trans inf_le_right)
    apply (hbij d _ hQd).1
    rw [map_add, hsmul,
      hnat d (L.V a ⊓ L.V d ⊓ U) _ (inf_le_left.trans inf_le_right) _ (c' a d),
      hnat d (L.V b ⊓ L.V d ⊓ U) _ (inf_le_left.trans inf_le_right) _ (c' b d),
      htr b d _ hQb hQd,
      hnat b (L.V a ⊓ L.V b ⊓ U) _ (inf_le_left.trans inf_le_right) _ (c' a b),
      hc' a d, hc' b d, hc' a b, hc a b d, smul_smul, ← pow_add]
  · refine ⟨fun a => φ a (L.V a ⊓ U) inf_le_left (β' a), fun a b => ?_⟩
    rw [← hc' a b, hβ' a b, map_sub, hsmul,
      hnat b (L.V b ⊓ U) (L.V a ⊓ L.V b ⊓ U) inf_le_left _ (β' b),
      htr a b (L.V a ⊓ L.V b ⊓ U) (inf_le_left.trans inf_le_left)
        (inf_le_left.trans inf_le_right),
      hnat a (L.V a ⊓ U) (L.V a ⊓ L.V b ⊓ U) inf_le_left _ (β' a),
      smul_smul, ← pow_add]

theorem wcpa_dj_sv_chart_data {Y T : Scheme.{u}} (q : Y ⟶ T) (W : T.Opens) (L : wcpaDjCoc Y)
    (hL : wcpaDjCocOK L) (e : ℕ) (hVA : wcpaDjVA q L W e) :
    ∃ (M : ℕ) (t : Fin (M + 1) → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W))
      (D : Fin (M + 1) → Y.Opens) (x : ∀ J K, Γ(Y, D K)) (hDU : ∀ J, D J ≤ q ⁻¹ᵁ W),
      (∀ J a b,
        (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V b ⊓ q ⁻¹ᵁ W from
            le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (t J b) =
          (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V a ⊓ L.V b from
            inf_le_left)).op).hom ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ e) *
          (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V a ⊓ q ⁻¹ᵁ W from
            le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (t J a)) ∧
      (∀ J, IsAffineOpen (D J)) ∧ (⨆ J, D J) = q ⁻¹ᵁ W ∧
      (∀ J a, D J ⊓ (L.V a ⊓ q ⁻¹ᵁ W) = Y.basicOpen (t J a)) ∧
      (∀ J, x J J = 1) ∧ (∀ J K, D J ⊓ D K = Y.basicOpen (x J K)) ∧
      (∀ J K K',
        (Y.presheaf.map (homOfLE (show D J ⊓ D K ⊓ D K' ≤ D K' from inf_le_right)).op).hom
            (x J K') =
          (Y.presheaf.map (homOfLE (show D J ⊓ D K ⊓ D K' ≤ D K from
            inf_le_left.trans inf_le_right)).op).hom (x J K) *
          (Y.presheaf.map (homOfLE (show D J ⊓ D K ⊓ D K' ≤ D K' from inf_le_right)).op).hom
            (x K K')) ∧
      (∀ J K a,
        (Y.presheaf.map (homOfLE (show D K ⊓ (L.V a ⊓ q ⁻¹ᵁ W) ≤ D K from inf_le_left)).op).hom
            (x J K) *
          (Y.presheaf.map (homOfLE (show D K ⊓ (L.V a ⊓ q ⁻¹ᵁ W) ≤ L.V a ⊓ q ⁻¹ᵁ W from
            inf_le_right)).op).hom (t K a) =
          (Y.presheaf.map (homOfLE (show D K ⊓ (L.V a ⊓ q ⁻¹ᵁ W) ≤ L.V a ⊓ q ⁻¹ᵁ W from
            inf_le_right)).op).hom (t J a)) ∧
      (∀ K (f : Γ(Y, D K)), ∃ P : MvPolynomial (Fin (M + 1)) Γ(T, W),
        f = MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (hDU K)).op).hom.comp (q.app W).hom)
          (fun l => x l K) P) :=
by
  classical

  have res_res : ∀ {A B C : Y.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(Y, A)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
        (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro A B C h1 h2 x
    show (Y.presheaf.map (homOfLE h1).op ≫ Y.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl

  have frac_glue : ∀ {m : ℕ} (O : Fin m → Y.Opens) (p r : ∀ a, Γ(Y, O a)),
      (∀ a b, (Y.presheaf.map (homOfLE (inf_le_left : O a ⊓ O b ≤ O a)).op).hom (p a) *
          (Y.presheaf.map (homOfLE (inf_le_right : O a ⊓ O b ≤ O b)).op).hom (r b) =
        (Y.presheaf.map (homOfLE (inf_le_right : O a ⊓ O b ≤ O b)).op).hom (p b) *
          (Y.presheaf.map (homOfLE (inf_le_left : O a ⊓ O b ≤ O a)).op).hom (r a)) →
      ∃ s : Γ(Y, ⨆ a, Y.basicOpen (r a)), ∀ a,
        (Y.presheaf.map (homOfLE (le_iSup (fun a' => Y.basicOpen (r a')) a)).op).hom s *
          (Y.presheaf.map (homOfLE (Y.basicOpen_le (r a))).op).hom (r a) =
        (Y.presheaf.map (homOfLE (Y.basicOpen_le (r a))).op).hom (p a) := by
    intro m O p r hpr
    have hu : ∀ a, IsUnit ((Y.presheaf.map (homOfLE (Y.basicOpen_le (r a))).op).hom (r a)) :=
      fun a => RingedSpace.isUnit_res_basicOpen Y.toRingedSpace (r a)
    choose i hi using fun a => (hu a).exists_left_inv
    let ξ : ∀ a, Γ(Y, Y.basicOpen (r a)) := fun a =>
      (Y.presheaf.map (homOfLE (Y.basicOpen_le (r a))).op).hom (p a) * i a
    have hcomp : TopCat.Presheaf.IsCompatible Y.sheaf.obj (fun a => Y.basicOpen (r a)) ξ := by
      intro a b
      change (Y.presheaf.map (homOfLE (inf_le_left : Y.basicOpen (r a) ⊓ Y.basicOpen (r b) ≤
          Y.basicOpen (r a))).op).hom (ξ a) =
        (Y.presheaf.map (homOfLE (inf_le_right : Y.basicOpen (r a) ⊓ Y.basicOpen (r b) ≤
          Y.basicOpen (r b))).op).hom (ξ b)
      have e1 := congrArg (Y.presheaf.map (homOfLE (show Y.basicOpen (r a) ⊓ Y.basicOpen (r b) ≤
        O a ⊓ O b from inf_le_inf (Y.basicOpen_le _) (Y.basicOpen_le _))).op).hom (hpr a b)
      have e2 := congrArg (Y.presheaf.map (homOfLE (inf_le_left : Y.basicOpen (r a) ⊓
        Y.basicOpen (r b) ≤ Y.basicOpen (r a))).op).hom (hi a)
      have e3 := congrArg (Y.presheaf.map (homOfLE (inf_le_right : Y.basicOpen (r a) ⊓
        Y.basicOpen (r b) ≤ Y.basicOpen (r b))).op).hom (hi b)
      simp only [map_mul, map_one, res_res] at e1 e2 e3
      simp only [ξ, map_mul, res_res]
      have key : ∀ {A : Type u} [CommRing A] (Pa Pb Ra Rb Ia Ib : A), Pa * Rb = Pb * Ra →
          Ia * Ra = 1 → Ib * Rb = 1 → Pa * Ia = Pb * Ib := by
        intro A _ Pa Pb Ra Rb Ia Ib h hIa hIb
        linear_combination (-(Pa * Ia)) * hIb + (Pb * Ib) * hIa + (Ia * Ib) * h
      exact key _ _ _ _ _ _ e1 e2 e3
    obtain ⟨s, hs, -⟩ := Y.sheaf.existsUnique_gluing' (fun a => Y.basicOpen (r a))
      (⨆ a, Y.basicOpen (r a)) (fun a => homOfLE (le_iSup (fun a' => Y.basicOpen (r a')) a))
      le_rfl ξ hcomp
    refine ⟨s, fun a => ?_⟩
    have h1 : (Y.presheaf.map (homOfLE (le_iSup (fun a' => Y.basicOpen (r a')) a)).op).hom s =
        ξ a := hs a
    rw [h1]
    simp only [ξ]
    rw [mul_assoc, hi a, mul_one]

  have unit_cancel : ∀ {m : ℕ} (O : Fin m → Y.Opens) (r : ∀ a, Γ(Y, O a)) (V : Y.Opens),
      V ≤ (⨆ a, Y.basicOpen (r a)) → ∀ s s' : Γ(Y, V),
      (∀ a, (Y.presheaf.map (homOfLE (inf_le_left : V ⊓ Y.basicOpen (r a) ≤ V)).op).hom s *
          (Y.presheaf.map (homOfLE ((inf_le_right : V ⊓ Y.basicOpen (r a) ≤ Y.basicOpen (r a)).trans
            (Y.basicOpen_le (r a)))).op).hom (r a) =
        (Y.presheaf.map (homOfLE (inf_le_left : V ⊓ Y.basicOpen (r a) ≤ V)).op).hom s' *
          (Y.presheaf.map (homOfLE ((inf_le_right : V ⊓ Y.basicOpen (r a) ≤ Y.basicOpen (r a)).trans
            (Y.basicOpen_le (r a)))).op).hom (r a)) → s = s' := by
    intro m O r V hV s s' h
    apply Y.sheaf.eq_of_locally_eq' (fun a => V ⊓ Y.basicOpen (r a)) V
      (fun a => homOfLE inf_le_left) ?_ s s'
    · intro a
      have hu : IsUnit ((Y.presheaf.map (homOfLE ((inf_le_right : V ⊓ Y.basicOpen (r a) ≤
          Y.basicOpen (r a)).trans (Y.basicOpen_le (r a)))).op).hom (r a)) := by
        have h0 : IsUnit ((Y.presheaf.map (homOfLE (Y.basicOpen_le (r a))).op).hom (r a)) :=
          RingedSpace.isUnit_res_basicOpen Y.toRingedSpace (r a)
        have := h0.map (Y.presheaf.map (homOfLE (inf_le_right : V ⊓ Y.basicOpen (r a) ≤
          Y.basicOpen (r a))).op).hom
        rwa [res_res] at this
      exact hu.mul_right_cancel (h a)
    · intro y hy
      obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp (hV hy)
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, ⟨hy, ha⟩⟩

  have chart_inter : ∀ {m : ℕ} (O : Fin m → Y.Opens) (τ : ∀ a, Γ(Y, O a)),
      (∀ a b, ∃ G : Γ(Y, O a ⊓ O b),
        (Y.presheaf.map (homOfLE (inf_le_right : O a ⊓ O b ≤ O b)).op).hom (τ b) =
          G * (Y.presheaf.map (homOfLE (inf_le_left : O a ⊓ O b ≤ O a)).op).hom (τ a)) →
      ∀ a, (⨆ b, Y.basicOpen (τ b)) ⊓ O a = Y.basicOpen (τ a) := by
    intro m O τ hG a
    apply le_antisymm
    · rintro y ⟨hy1, hy2⟩
      obtain ⟨b, hb⟩ := TopologicalSpace.Opens.mem_iSup.mp hy1
      obtain ⟨G, hGe⟩ := hG a b
      have h1 : y ∈ Y.basicOpen
          ((Y.presheaf.map (homOfLE (inf_le_right : O a ⊓ O b ≤ O b)).op).hom (τ b)) := by
        rw [Scheme.basicOpen_res]
        exact ⟨⟨hy2, Y.basicOpen_le (τ b) hb⟩, hb⟩
      rw [hGe, Scheme.basicOpen_mul, Scheme.basicOpen_res] at h1
      exact h1.2.2
    · exact le_inf (le_iSup (fun b => Y.basicOpen (τ b)) a) (Y.basicOpen_le _)

  have eval_glue : ∀ {R : Type u} [CommRing R] {m N : ℕ} (U : Y.Opens) (φ : R →+* Γ(Y, U))
      (O : Fin m → Y.Opens) (hO : ∀ a, O a ≤ U) (r : ∀ a, Γ(Y, O a))
      (p : Fin N → ∀ a, Γ(Y, O a)) (hle : (⨆ a, Y.basicOpen (r a)) ≤ U)
      (s : Fin N → Γ(Y, ⨆ a, Y.basicOpen (r a))),
      (∀ l a, (Y.presheaf.map (homOfLE (le_iSup (fun a' => Y.basicOpen (r a')) a)).op).hom (s l) *
          (Y.presheaf.map (homOfLE (Y.basicOpen_le (r a))).op).hom (r a) =
        (Y.presheaf.map (homOfLE (Y.basicOpen_le (r a))).op).hom (p l a)) →
      ∀ (f : Γ(Y, ⨆ a, Y.basicOpen (r a))) (P : MvPolynomial (Fin N) R),
      (∀ a, ∃ inv : Γ(Y, Y.basicOpen (r a)),
        inv * (Y.presheaf.map (homOfLE (Y.basicOpen_le (r a))).op).hom (r a) = 1 ∧
        (Y.presheaf.map (homOfLE (le_iSup (fun a' => Y.basicOpen (r a')) a)).op).hom f =
          MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE ((Y.basicOpen_le (r a)).trans
            (hO a))).op).hom.comp φ)
            (fun l => (Y.presheaf.map (homOfLE (Y.basicOpen_le (r a))).op).hom (p l a) * inv) P) →
      f = MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE hle).op).hom.comp φ) s P := by
    intro R _ m N U φ O hO r p hle s hs f P hf
    apply Y.sheaf.eq_of_locally_eq' (fun a => Y.basicOpen (r a)) _
      (fun a => homOfLE (le_iSup (fun a' => Y.basicOpen (r a')) a)) le_rfl
    intro a
    obtain ⟨inv, hinv, hfa⟩ := hf a
    change (Y.presheaf.map (homOfLE (le_iSup (fun a' => Y.basicOpen (r a')) a)).op).hom f =
      (Y.presheaf.map (homOfLE (le_iSup (fun a' => Y.basicOpen (r a')) a)).op).hom
        (MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE hle).op).hom.comp φ) s P)
    rw [hfa, MvPolynomial.eval₂_comp_left]
    congr 1
    · ext c
      simp only [RingHom.comp_apply, res_res]
    · funext l
      simp only [Function.comp_apply]
      have key : ∀ {A : Type u} [CommRing A] (z R0 P0 i0 : A), z * R0 = P0 → i0 * R0 = 1 →
          P0 * i0 = z := by
        intro A _ z R0 P0 i0 h1 h2
        linear_combination (-i0) * h1 + z * h2
      exact key _ _ _ _ (hs l a) hinv

  obtain ⟨M, t, hVAi, hVAii, hVAiii, hVAiv⟩ := hVA
  have hDU : ∀ J, (⨆ a, Y.basicOpen (t J a)) ≤ q ⁻¹ᵁ W :=
    fun J => iSup_le (fun a => (Y.basicOpen_le (t J a)).trans inf_le_right)

  have hG : ∀ J a b,
      (Y.presheaf.map (homOfLE (inf_le_right :
          L.V a ⊓ q ⁻¹ᵁ W ⊓ (L.V b ⊓ q ⁻¹ᵁ W) ≤ L.V b ⊓ q ⁻¹ᵁ W)).op).hom (t J b) =
        (Y.presheaf.map (homOfLE (show L.V a ⊓ q ⁻¹ᵁ W ⊓ (L.V b ⊓ q ⁻¹ᵁ W) ≤ L.V a ⊓ L.V b from
            le_inf (inf_le_left.trans inf_le_left) (inf_le_right.trans inf_le_left))).op).hom
          ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ e) *
        (Y.presheaf.map (homOfLE (inf_le_left :
          L.V a ⊓ q ⁻¹ᵁ W ⊓ (L.V b ⊓ q ⁻¹ᵁ W) ≤ L.V a ⊓ q ⁻¹ᵁ W)).op).hom (t J a) := by
    intro J a b
    have h := congrArg (Y.presheaf.map (homOfLE (show L.V a ⊓ q ⁻¹ᵁ W ⊓ (L.V b ⊓ q ⁻¹ᵁ W) ≤
      L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W from le_inf (le_inf (inf_le_left.trans inf_le_left)
        (inf_le_right.trans inf_le_left)) (inf_le_left.trans inf_le_right))).op).hom (hVAi J a b)
    simp only [map_mul, res_res] at h
    exact h

  have hc4 : ∀ J a, (⨆ b, Y.basicOpen (t J b)) ⊓ (L.V a ⊓ q ⁻¹ᵁ W) = Y.basicOpen (t J a) :=
    fun J a => chart_inter (fun a => L.V a ⊓ q ⁻¹ᵁ W) (t J) (fun a b => ⟨_, hG J a b⟩) a
  have hc3 : (⨆ J, ⨆ a, Y.basicOpen (t J a)) = q ⁻¹ᵁ W := by
    apply le_antisymm
    · exact iSup_le hDU
    · intro y hy
      have hy' : y ∈ ⨆ a, L.V a := by rw [hL.2.1]; exact Set.mem_univ y
      obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hy'
      have hya : y ∈ L.V a ⊓ q ⁻¹ᵁ W := ⟨ha, hy⟩
      have h2 := iSup_basicOpen_of_span_eq_top _ _ (hVAii a)
      rw [← h2] at hya
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hya
      obtain ⟨hmem, hi2⟩ := TopologicalSpace.Opens.mem_iSup.mp hi
      obtain ⟨J, rfl⟩ := hmem
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨J, TopologicalSpace.Opens.mem_iSup.mpr ⟨a, hi2⟩⟩

  have hx0 : ∀ J K, ∃ s : Γ(Y, ⨆ a, Y.basicOpen (t K a)), ∀ a,
      (Y.presheaf.map (homOfLE (le_iSup (fun a' => Y.basicOpen (t K a')) a)).op).hom s *
        (Y.presheaf.map (homOfLE (Y.basicOpen_le (t K a))).op).hom (t K a) =
      (Y.presheaf.map (homOfLE (Y.basicOpen_le (t K a))).op).hom (t J a) := by
    intro J K
    refine frac_glue (fun a => L.V a ⊓ q ⁻¹ᵁ W) (t J) (t K) ?_
    intro a b
    beta_reduce
    rw [hG J a b, hG K a b]
    ring
  choose x hx using hx0
  have hX' : ∀ J K a (Q : Y.Opens) (hQ : Q ≤ Y.basicOpen (t K a)),
      (Y.presheaf.map (homOfLE (hQ.trans (le_iSup (fun a' => Y.basicOpen (t K a')) a))).op).hom
          (x J K) *
        (Y.presheaf.map (homOfLE (hQ.trans (Y.basicOpen_le (t K a)))).op).hom (t K a) =
      (Y.presheaf.map (homOfLE (hQ.trans (Y.basicOpen_le (t K a)))).op).hom (t J a) := by
    intro J K a Q hQ
    have h := congrArg (Y.presheaf.map (homOfLE hQ).op).hom (hx J K a)
    simp only [map_mul, res_res] at h
    exact h

  have hc5 : ∀ J, x J J = 1 := by
    intro J
    refine unit_cancel (fun a => L.V a ⊓ q ⁻¹ᵁ W) (t J) (⨆ a, Y.basicOpen (t J a)) le_rfl _ _
      (fun a => ?_)
    rw [map_one, one_mul]
    exact hX' J J a _ inf_le_right

  have hE : ∀ J K a, Y.basicOpen (t K a) ⊓ Y.basicOpen (x J K) ⊓
      (Y.basicOpen (t K a) ⊓ Y.basicOpen (t K a)) = Y.basicOpen (t K a) ⊓ Y.basicOpen (t J a) := by
    intro J K a
    have h := congrArg Y.basicOpen (hx J K a)
    simp only [Scheme.basicOpen_mul, Scheme.basicOpen_res] at h
    exact h
  have hc6 : ∀ J K, (⨆ a, Y.basicOpen (t J a)) ⊓ (⨆ a, Y.basicOpen (t K a)) =
      Y.basicOpen (x J K) := by
    intro J K
    apply le_antisymm
    · rintro y ⟨hyJ, hyK⟩
      obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hyK
      have hJa : y ∈ Y.basicOpen (t J a) := by
        rw [← hc4 J a]
        exact ⟨hyJ, Y.basicOpen_le (t K a) ha⟩
      have h1 : y ∈ Y.basicOpen (t K a) ⊓ Y.basicOpen (t J a) := ⟨ha, hJa⟩
      rw [← hE J K a] at h1
      exact h1.1.2
    · intro y hy
      have hyK : y ∈ (⨆ a, Y.basicOpen (t K a)) := Y.basicOpen_le (x J K) hy
      obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hyK
      have h1 : y ∈ Y.basicOpen (t K a) ⊓ Y.basicOpen (x J K) ⊓
          (Y.basicOpen (t K a) ⊓ Y.basicOpen (t K a)) := ⟨⟨ha, hy⟩, ⟨ha, ha⟩⟩
      rw [hE J K a] at h1
      exact ⟨TopologicalSpace.Opens.mem_iSup.mpr ⟨a, h1.2⟩, hyK⟩

  have hc9 : ∀ K (f : Γ(Y, ⨆ a, Y.basicOpen (t K a))),
      ∃ P : MvPolynomial (Fin (M + 1)) Γ(T, W),
        f = MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (hDU K)).op).hom.comp (q.app W).hom)
          (fun l => x l K) P := by
    intro K f
    obtain ⟨P, hP⟩ := hVAiv K f
    exact ⟨P, eval_glue (q ⁻¹ᵁ W) (q.app W).hom (fun a => L.V a ⊓ q ⁻¹ᵁ W)
      (fun a => inf_le_right) (t K) (fun l a => t l a) (hDU K) (fun l => x l K)
      (fun l a => hx l K a) f P hP⟩

  refine ⟨M, t, fun J => ⨆ a, Y.basicOpen (t J a), x, hDU, hVAi, hVAiii, hc3, hc4, hc5, hc6,
    ?_, ?_, hc9⟩
  ·
    intro J K K'
    refine unit_cancel (fun a => L.V a ⊓ q ⁻¹ᵁ W) (t K')
      ((⨆ a, Y.basicOpen (t J a)) ⊓ (⨆ a, Y.basicOpen (t K a)) ⊓ (⨆ a, Y.basicOpen (t K' a)))
      inf_le_right _ _ (fun a => ?_)
    have hQ1 : (⨆ a, Y.basicOpen (t J a)) ⊓ (⨆ a, Y.basicOpen (t K a)) ⊓
        (⨆ a, Y.basicOpen (t K' a)) ⊓ Y.basicOpen (t K' a) ≤ Y.basicOpen (t K' a) := inf_le_right
    have hQ2 : (⨆ a, Y.basicOpen (t J a)) ⊓ (⨆ a, Y.basicOpen (t K a)) ⊓
        (⨆ a, Y.basicOpen (t K' a)) ⊓ Y.basicOpen (t K' a) ≤ Y.basicOpen (t K a) :=
      (le_inf (inf_le_left.trans (inf_le_left.trans inf_le_right))
        (inf_le_right.trans (Y.basicOpen_le (t K' a)))).trans (hc4 K a).le
    simp only [map_mul, res_res]
    rw [hX' J K' a _ hQ1, mul_assoc, hX' K K' a _ hQ1, hX' J K a _ hQ2]
  ·
    intro J K a
    exact hX' J K a _ (hc4 K a).le

theorem wcpa_dj_sv_refinement {Y : Scheme.{u}} {N₁ m : ℕ} (D : Fin N₁ → Y.Opens)
    (x : ∀ J K, Γ(Y, D K)) (hD : ∀ J, IsAffineOpen (D J))
    (hx : ∀ J K, D J ⊓ D K = Y.basicOpen (x J K))
    (V : Fin m → Y.Opens) (hV : (⨆ a, V a) = ⊤) :
    ∃ (N₂ : ℕ) (O : Fin N₂ → Y.Opens) (ι : Fin N₂ → Fin N₁) (α : Fin N₂ → Fin m),
      (∀ ν, O ν ≤ D (ι ν)) ∧ (∀ ν, O ν ≤ V (α ν)) ∧ (⨆ ν, O ν) = (⨆ J, D J) ∧
      ∀ J ν, ∃ f : Γ(Y, D J), D J ⊓ O ν = Y.basicOpen f :=
by
  classical
  have hgood : ∀ J, ∃ (k : ℕ) (g : Fin k → Γ(Y, D J)), Ideal.span (Set.range g) = ⊤ ∧
      ∀ i, ∃ a, Y.basicOpen (g i) ≤ V a := by
    intro J
    let s : Set Γ(Y, D J) := {f | ∃ a, Y.basicOpen f ≤ V a}
    have hs : Ideal.span s = ⊤ := by
      rw [← (hD J).iSup_basicOpen_eq_self_iff]
      apply le_antisymm
      · exact iSup_le fun f => Y.basicOpen_le _
      · intro y hy
        have hy' : y ∈ (⨆ a, V a) := by rw [hV]; trivial
        obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hy'
        obtain ⟨f, hf, hyf⟩ := (hD J).exists_basicOpen_le (V := V a) ⟨y, ha⟩ hy
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨f, ⟨a, hf⟩⟩, hyf⟩
    obtain ⟨t, hts, ht⟩ := (Ideal.span_eq_top_iff_finite s).mp hs
    refine ⟨t.card, fun i => (t.equivFin.symm i : Γ(Y, D J)), ?_, ?_⟩
    · have hr : Set.range (fun i => (t.equivFin.symm i : Γ(Y, D J))) = ↑t := by
        ext f
        constructor
        · rintro ⟨i, rfl⟩
          exact (t.equivFin.symm i).2
        · intro hf
          exact ⟨t.equivFin ⟨f, hf⟩, by simp⟩
      rw [hr]
      exact ht
    · intro i
      exact hts (t.equivFin.symm i).2
  choose k g hspan hB using hgood
  choose a₀ ha₀ using hB
  let e : (Σ J, Fin (k J)) ≃ Fin (∑ J, k J) := finSigmaFinEquiv
  refine ⟨∑ J, k J, fun ν => Y.basicOpen (g (e.symm ν).1 (e.symm ν).2), fun ν => (e.symm ν).1,
    fun ν => a₀ (e.symm ν).1 (e.symm ν).2, ?_, ?_, ?_, ?_⟩
  · intro ν
    exact Y.basicOpen_le _
  · intro ν
    exact ha₀ _ _
  · have h1 : ∀ J, (⨆ i, Y.basicOpen (g J i)) = D J := by
      intro J
      have h2 := ((hD J).iSup_basicOpen_eq_self_iff (s := Set.range (g J))).mpr (hspan J)
      exact (iSup_range' (fun f => Y.basicOpen f) (g J)).symm.trans h2
    show (⨆ ν, (fun p : (Σ J, Fin (k J)) => Y.basicOpen (g p.1 p.2)) (e.symm ν)) = _
    rw [Equiv.iSup_comp (g := fun p : (Σ J, Fin (k J)) => Y.basicOpen (g p.1 p.2)) e.symm,
      iSup_sigma]
    exact iSup_congr h1
  · intro J ν
    show ∃ f : Γ(Y, D J), D J ⊓ Y.basicOpen (g (e.symm ν).1 (e.symm ν).2) = Y.basicOpen f
    generalize e.symm ν = p
    obtain ⟨K, i⟩ := p
    have hBK : Y.basicOpen (x K J) ≤ D K := by rw [← hx K J]; exact inf_le_left
    obtain ⟨f', hf'⟩ := (hD J).basicOpen_basicOpen_is_basicOpen (x K J)
      ((Y.presheaf.map (homOfLE hBK).op).hom (g K i))
    refine ⟨f', ?_⟩
    rw [hf', Scheme.basicOpen_res, ← hx K J, inf_comm (D K), inf_assoc,
      inf_eq_right.mpr (Y.basicOpen_le (g K i))]

theorem wcpa_dj_sv_leray {Y : Scheme.{u}} (G : Y.Modules) (hG : wcQcoh G) {N₁ : ℕ}
    (D : Fin N₁ → Y.Opens) (hD : ∀ J, IsAffineOpen (D J)) (x : ∀ J K, Γ(Y, D K))
    (hxJJ : ∀ J, x J J = 1)
    (hxc : ∀ J K K',
