theorem wcpa_dj_lus_cvs_ct_fcn_nc_etale_loc_not_mem : ∀ (N T : Type u) [CommRing N] [CommRing T] [Algebra N T] [Algebra.Etale N T] (q : Ideal T) [q.IsPrime] (f h : N), (Ideal.span {f}).IsPrime → h ∉ Ideal.span {f} → algebraMap N T f ∈ q → algebraMap T (Localization.AtPrime q) (algebraMap N T h) ∉ Ideal.span {algebraMap T (Localization.AtPrime q) (algebraMap N T f)} :=
by
  intro N T _ _ _ _ q _ f h hf hh hfq hmem
  have hNB : Module.Flat N (Localization.AtPrime q) := Module.Flat.trans N T (Localization.AtPrime q)
  have hfB : algebraMap T (Localization.AtPrime q) (algebraMap N T f)
      = algebraMap N (Localization.AtPrime q) f :=
    (IsScalarTower.algebraMap_apply N T (Localization.AtPrime q) f).symm
  have hhB : algebraMap T (Localization.AtPrime q) (algebraMap N T h)
      = algebraMap N (Localization.AtPrime q) h :=
    (IsScalarTower.algebraMap_apply N T (Localization.AtPrime q) h).symm
  have hmax : algebraMap T (Localization.AtPrime q) (algebraMap N T f) ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime q) q _).mpr hfq
  rw [hfB, hhB] at hmem
  rw [hfB] at hmax
  obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hmem
  obtain ⟨k, a, y, hx, ha⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (R := N)
    (M := Localization.AtPrime q) (f := ![h, -f]) (x := ![1, b]) (by
      rw [Fin.sum_univ_two]
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
      rw [Algebra.smul_def, Algebra.smul_def, mul_one, map_neg, ← hb]
      ring)
  have ha0 : ∀ j, a 0 j ∈ Ideal.span {f} := by
    intro j
    have hj := ha j
    rw [Fin.sum_univ_two] at hj
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at hj
    have h1 : h * a 0 j ∈ Ideal.span {f} := by
      have : h * a 0 j = f * a 1 j := by linear_combination hj
      rw [this]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self f)
    exact (hf.mem_or_mem h1).resolve_left hh
  choose d hd using fun j => Ideal.mem_span_singleton'.mp (ha0 j)
  have h1 := hx 0
  simp only [Matrix.cons_val_zero] at h1
  have hunit : algebraMap N (Localization.AtPrime q) f *
      (∑ j, d j • y j) = 1 := by
    rw [h1, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [← hd j, Algebra.smul_def, Algebra.smul_def, map_mul]
    ring
  have hU : IsUnit (algebraMap N (Localization.AtPrime q) f) :=
    ⟨⟨_, _, hunit, by rw [mul_comm]; exact hunit⟩, rfl⟩
  exact (IsLocalRing.mem_maximalIdeal _).mp hmax hU

theorem wcpa_dj_lus_cvs_ct_fcn_nc_etale_quot_normal : ∀ (N T : Type u) [CommRing N] [CommRing T] [Algebra N T] [Algebra.Etale N T] (q : Ideal T) [q.IsPrime] (f : N) (D : Type u) [CommRing D] [IsDomain D] [IsIntegrallyClosed D] (π : N →+* D), Function.Surjective π → RingHom.ker π = Ideal.span {f} → algebraMap N T f ∈ q → IsDomain (Localization.AtPrime q ⧸ Ideal.span {algebraMap T (Localization.AtPrime q) (algebraMap N T f)}) ∧ IsIntegrallyClosed (Localization.AtPrime q ⧸ Ideal.span {algebraMap T (Localization.AtPrime q) (algebraMap N T f)}) :=
by
  intro N T _ _ _ _ q _ f D _ _ _ π hπ hker hf
  set I : Ideal N := RingHom.ker π with hI
  set J : Ideal T := I.map (algebraMap N T) with hJ
  have hJspan : J = Ideal.span {algebraMap N T f} := by
    rw [hJ, hker, Ideal.map_span, Set.image_singleton]
  have hJq : J ≤ q := by
    rw [hJspan, Ideal.span_singleton_le_iff_mem]; exact hf
  let e : N ⧸ I ≃+* D := RingHom.quotientKerEquivOfSurjective hπ
  haveI : IsDomain (N ⧸ I) := MulEquiv.isDomain D e.toMulEquiv
  haveI : IsIntegrallyClosed (N ⧸ I) := IsIntegrallyClosed.of_equiv e.symm
  haveI hEt : Algebra.Etale (N ⧸ I) (T ⧸ J) := by
    haveI : Algebra.Etale (N ⧸ I) (TensorProduct N (N ⧸ I) T) := inferInstance
    let e₁ := Algebra.TensorProduct.comm N (N ⧸ I) T
    let e₂ := Algebra.TensorProduct.quotIdealMapEquivTensorQuot T I
    let eR : TensorProduct N (N ⧸ I) T ≃+* T ⧸ J := e₁.toRingEquiv.trans e₂.symm.toRingEquiv
    let eA : TensorProduct N (N ⧸ I) T ≃ₐ[N ⧸ I] T ⧸ J := AlgEquiv.ofRingEquiv (f := eR) (by
      intro x
      obtain ⟨n, rfl⟩ := Ideal.Quotient.mk_surjective x
      show e₂.symm (e₁ (algebraMap (N ⧸ I) (TensorProduct N (N ⧸ I) T) (Ideal.Quotient.mk I n))) = _
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
        Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul,
        Ideal.Quotient.algebraMap_quotient_map_quotient, Algebra.smul_def, mul_one]
      rfl)
    exact Algebra.Etale.of_equiv eA
  set q' : Ideal (T ⧸ J) := q.map (Ideal.Quotient.mk J) with hq'
  haveI hq'p : q'.IsPrime := Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
    (by rw [Ideal.mk_ker]; exact hJq)
  have hcomap : q'.comap (Ideal.Quotient.mk J) = q := by
    rw [hq', Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
    exact sup_eq_left.mpr hJq
  obtain ⟨hBd', hBi'⟩ := wc_pks_etale_localization_normal (N ⧸ I) (T ⧸ J) q'
  have hT : Submonoid.map (Ideal.Quotient.mk J) q.primeCompl = q'.primeCompl := by
    ext y
    simp only [Submonoid.mem_map, Ideal.mem_primeCompl_iff]
    constructor
    · rintro ⟨x, hx, rfl⟩ hy
      apply hx
      rw [← hcomap]; exact hy
    · intro hy
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      refine ⟨x, ?_, rfl⟩
      intro hx
      apply hy
      rw [← hcomap] at hx
      exact hx
  have hy : q.primeCompl ≤ q'.primeCompl.comap (Ideal.Quotient.mk J) := by
    rw [← hT]; exact Submonoid.le_comap_map _
  set φ : Localization.AtPrime q →+* Localization.AtPrime q' :=
    IsLocalization.map (S := Localization.AtPrime q) (Localization.AtPrime q')
      (Ideal.Quotient.mk J) hy with hφ
  have hk : RingHom.ker φ = J.map (algebraMap T (Localization.AtPrime q)) := by
    have h0 := IsLocalization.ker_map (S := Localization.AtPrime q) (Localization.AtPrime q')
      (Ideal.Quotient.mk J) hT
    rw [Ideal.mk_ker] at h0
    exact h0
  have hmap : J.map (algebraMap T (Localization.AtPrime q)) =
      Ideal.span {algebraMap T (Localization.AtPrime q) (algebraMap N T f)} := by
    rw [hJspan, Ideal.map_span, Set.image_singleton]
  have hkerφ : Ideal.span {algebraMap T (Localization.AtPrime q) (algebraMap N T f)} =
      RingHom.ker φ := (hk.trans hmap).symm
  have hφsurj : Function.Surjective φ := by
    intro z
    obtain ⟨⟨y, s⟩, rfl⟩ := IsLocalization.mk'_surjective q'.primeCompl z
    obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨s0, hs0⟩ := Ideal.Quotient.mk_surjective (s : T ⧸ J)
    have hs0q : s0 ∈ q.primeCompl := by
      rw [Ideal.mem_primeCompl_iff]
      intro h
      have hs := s.2
      rw [Ideal.mem_primeCompl_iff] at hs
      apply hs
      rw [← hs0]
      exact Ideal.mem_map_of_mem _ h
    refine ⟨IsLocalization.mk' (Localization.AtPrime q) t ⟨s0, hs0q⟩, ?_⟩
    rw [hφ, IsLocalization.map_mk']
    congr 1
    exact Subtype.ext hs0
  let σ : (Localization.AtPrime q ⧸
      Ideal.span {algebraMap T (Localization.AtPrime q) (algebraMap N T f)}) ≃+*
      Localization.AtPrime q' :=
    (Ideal.quotEquivOfEq hkerφ).trans (RingHom.quotientKerEquivOfSurjective hφsurj)
  exact ⟨MulEquiv.isDomain _ σ.toMulEquiv, IsIntegrallyClosed.of_equiv σ.symm⟩

theorem wcpa_dj_lus_cvs_ct_fcn_nc_node_zero_not_mem : ∀ (K : Type u) [Field K] (R : ValuationSubring K) (a : ↥R), a = 0 → Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 1) ∉ Ideal.span {Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 0)} ∧ Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 0) ∉ Ideal.span {Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 1)} :=
by
  intro K _ R a ha
  subst ha
  have hI : ∀ p : Fin 2 → ↥R, p 0 * p 1 = 0 →
      ∀ z ∈ wcNcIdeal R 0, MvPolynomial.eval p z = 0 := by
    intro p hp z hz
    have hle : wcNcIdeal R 0 ≤ RingHom.ker (MvPolynomial.eval p) := by
      unfold wcNcIdeal
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      simp [hp]
    exact RingHom.mem_ker.mp (hle hz)
  have key : ∀ (p : Fin 2 → ↥R) (hp : p 0 * p 1 = 0) (i j : Fin 2), p i = 0 → p j = 1 →
      Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X j) ∉
        Ideal.span {Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X i)} := by
    intro p hp i j hi hj h
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp h
    have h2 := congrArg (Ideal.Quotient.lift (wcNcIdeal R 0) (MvPolynomial.eval p) (hI p hp)) hc
    rw [map_mul, Ideal.Quotient.lift_mk, Ideal.Quotient.lift_mk, MvPolynomial.eval_X,
      MvPolynomial.eval_X, hi, hj, mul_zero] at h2
    exact zero_ne_one h2
  refine ⟨key ![0, 1] (by simp) 0 1 (by simp) (by simp),
    key ![1, 0] (by simp) 1 0 (by simp) (by simp)⟩

theorem wcpa_dj_lus_cvs_ct_fcn_nc_flat_colon : ∀ (A B : Type u) [CommRing A] [CommRing B] (ψ : A →+* B), ψ.Flat → ∀ (P : Ideal A) [P.IsPrime] (s : A), s ∉ P → ∀ b : B, ψ s * b ∈ P.map ψ → b ∈ P.map ψ :=
by
  intro A B _ _ ψ hψ P _ s hs b hb
  letI : Algebra A B := ψ.toAlgebra
  haveI hflat : Module.Flat A B := hψ
  have regA : IsSMulRegular (A ⧸ P) s := by
    rw [isSMulRegular_iff_right_eq_zero_of_smul]
    intro x hx
    rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq] at hx
    have hne : Ideal.Quotient.mk P s ≠ 0 := by
      rw [Ne, Ideal.Quotient.eq_zero_iff_mem]; exact hs
    exact (mul_eq_zero.mp hx).resolve_left hne
  have regT : IsSMulRegular (TensorProduct A B (A ⧸ P)) s := regA.lTensor B
  have regQ : IsSMulRegular (B ⧸ (P • (⊤ : Submodule A B))) s :=
    (LinearEquiv.isSMulRegular_congr (TensorProduct.tensorQuotEquivQuotSMul B P) s).mp regT
  have hmem : ∀ y : B, y ∈ (P • (⊤ : Submodule A B)) ↔ y ∈ P.map ψ := by
    intro y
    rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem]
    rfl
  rw [← hmem]
  rw [← Submodule.Quotient.mk_eq_zero]
  apply regQ.right_eq_zero_of_smul
  rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, hmem, Algebra.smul_def]
  exact hb

theorem wcpa_dj_lus_cvs_ct_fcn_nc_minimal_prime_branch : ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B] (ψ : A →+* B), ψ.Flat → IsLocalHom ψ → ∀ (x y : B), x * y = 0 → (Ideal.span {x}).IsPrime → (Ideal.span {y}).IsPrime → ∀ P ∈ minimalPrimes A, P = (Ideal.span {x}).comap ψ ∨ P = (Ideal.span {y}).comap ψ :=
by
  intro A B _ _ _ _ ψ hflat hloc x y hxy hx hy P hPmin
  letI := ψ.toAlgebra
  haveI : Module.Flat A B := hflat
  haveI : IsLocalHom (algebraMap A B) := hloc
  haveI : Module.FaithfullyFlat A B := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hPp : P.IsPrime := hPmin.1.1
  obtain ⟨Q, hQ⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := A) (B := B) ⟨P, hPp⟩
  have hQP : Q.asIdeal.comap ψ = P := congrArg PrimeSpectrum.asIdeal hQ
  have key : ∀ z : B, (Ideal.span {z}).IsPrime → z ∈ Q.asIdeal →
      P = (Ideal.span {z}).comap ψ := by
    intro z hz hzQ
    haveI := hz
    have hIp : ((Ideal.span {z}).comap ψ).IsPrime := Ideal.IsPrime.comap ψ
    have hIP : (Ideal.span {z}).comap ψ ≤ P := by
      rw [← hQP]
      exact Ideal.comap_mono ((Ideal.span_singleton_le_iff_mem _).mpr hzQ)
    exact le_antisymm (hPmin.2 ⟨hIp, bot_le⟩ hIP) hIP
  have h0 : x * y ∈ Q.asIdeal := by rw [hxy]; exact Q.asIdeal.zero_mem
  rcases Q.isPrime.mem_or_mem h0 with h | h
  · exact Or.inl (key x hx h)
  · exact Or.inr (key y hy h)

theorem wcpa_dj_lus_cvs_ct_fcn_nc_branch_extension : ∀ (A B : Type u) [CommRing A] [CommRing B] (ψ : A →+* B), (∀ (P : Ideal A) [P.IsPrime] (s : A), s ∉ P → ∀ b : B, ψ s * b ∈ P.map ψ → b ∈ P.map ψ) → ∀ P ∈ minimalPrimes A, ∀ (w w' : B), w * w' = 0 → (Ideal.span {w'}).IsPrime → P = (Ideal.span {w}).comap ψ → (Ideal.span {w'}).comap ψ ≠ P → P.map ψ = Ideal.span {w} :=
by
  intro A B _ _ ψ H P hPmin w w' hww' hw'prime hPw hQ'ne
  haveI hPprime : P.IsPrime := hPmin.1.1
  haveI := hw'prime
  have hQ'prime : ((Ideal.span {w'}).comap ψ).IsPrime := Ideal.comap_isPrime ψ (Ideal.span {w'})
  have s2 : P.map ψ ≤ Ideal.span {w} := Ideal.map_le_iff_le_comap.mpr (le_of_eq hPw)
  have s4 : ¬ ((Ideal.span {w'}).comap ψ ≤ P) := by
    intro hle
    exact hQ'ne (le_antisymm hle (hPmin.2 ⟨hQ'prime, bot_le⟩ hle))
  obtain ⟨s, hsQ, hsP⟩ := SetLike.not_le_iff_exists.mp s4
  rw [Ideal.mem_comap, Ideal.mem_span_singleton'] at hsQ
  obtain ⟨c, hc⟩ := hsQ
  have s6 : ψ s * w = 0 := by
    rw [← hc, mul_assoc, mul_comm w' w, hww', mul_zero]
  have s7 : w ∈ P.map ψ := H P s hsP w (by rw [s6]; exact Ideal.zero_mem _)
  exact le_antisymm s2 ((Ideal.span_singleton_le_iff_mem _).mpr s7)

theorem wcpa_dj_lus_cvs_ct_fcn_nc_descent_normal : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsDomain B] [IsIntegrallyClosed B] (ψ : A →+* B), (∀ I : Ideal A, (I.map ψ).comap ψ = I) → IsDomain A ∧ IsIntegrallyClosed A :=
by
  intro A B _ _ _ _ ψ hcm
  have hinj : Function.Injective ψ := by
    rw [RingHom.injective_iff_ker_eq_bot, RingHom.ker_eq_comap_bot, ← Ideal.map_bot (f := ψ)]
    exact hcm ⊥
  haveI hA : IsDomain A := hinj.isDomain ψ
  refine ⟨hA, ?_⟩
  have hg : Function.Injective ((algebraMap B (FractionRing B)).comp ψ) :=
    (IsFractionRing.injective B (FractionRing B)).comp hinj
  let φ : FractionRing A →+* FractionRing B := IsFractionRing.lift hg
  have hφ : ∀ a : A, φ (algebraMap A (FractionRing A) a) = algebraMap B (FractionRing B) (ψ a) :=
    fun a => IsFractionRing.lift_algebraMap hg a
  have hcomp : (algebraMap B (FractionRing B)).comp ψ = φ.comp (algebraMap A (FractionRing A)) := by
    ext a
    simp only [RingHom.comp_apply, hφ]
  rw [isIntegrallyClosed_iff (FractionRing A)]
  intro x hx
  have hxB : IsIntegral B (φ x) := IsIntegral.map_of_comp_eq ψ φ hcomp hx
  obtain ⟨b, hb⟩ := IsIntegrallyClosed.isIntegral_iff.mp hxB
  obtain ⟨⟨a, s⟩, hxs⟩ := IsLocalization.surj (nonZeroDivisors A) x
  simp only at hxs
  have h1 : b * ψ s = ψ a := by
    apply IsFractionRing.injective B (FractionRing B)
    rw [map_mul, hb, ← hφ, ← hφ, ← map_mul, hxs]
  have h2 : a ∈ Ideal.span {(s : A)} := by
    rw [← hcm (Ideal.span {(s : A)}), Ideal.mem_comap, Ideal.map_span, Set.image_singleton]
    exact Ideal.mem_span_singleton'.mpr ⟨b, h1⟩
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp h2
  refine ⟨c, ?_⟩
  have hs0 : algebraMap A (FractionRing A) s ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors s.2
  apply mul_right_cancel₀ hs0
  rw [hxs, ← hc, map_mul]

theorem wcpa_dj_lus_cvs_ct_fcn_nc_quot_descent : ∀ (A B : Type u) [CommRing A] [CommRing B] (ψ : A →+* B), (∀ I : Ideal A, (I.map ψ).comap ψ = I) → ∀ (P : Ideal A) (w : B), P.map ψ = Ideal.span {w} → ∃ ψ' : A ⧸ P →+* B ⧸ Ideal.span {w}, ∀ I : Ideal (A ⧸ P), (I.map ψ').comap ψ' = I :=
by
  intro A B _ _ ψ hc P w hw
  have hle : P ≤ (Ideal.span {w}).comap ψ := by
    rw [← hw]; exact Ideal.le_comap_map
  refine ⟨Ideal.quotientMap (Ideal.span {w}) ψ hle, ?_⟩
  intro J
  have hcomm : (Ideal.quotientMap (Ideal.span {w}) ψ hle).comp (Ideal.Quotient.mk P) =
      (Ideal.Quotient.mk (Ideal.span {w})).comp ψ :=
    Ideal.quotientMap_comp_mk hle
  have hJ : J = (J.comap (Ideal.Quotient.mk P)).map (Ideal.Quotient.mk P) :=
    (Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective J).symm
  have hPI : P ≤ J.comap (Ideal.Quotient.mk P) := by
    intro p hp
    show Ideal.Quotient.mk P p ∈ J
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hp]
    exact J.zero_mem
  have s4 : J.map (Ideal.quotientMap (Ideal.span {w}) ψ hle) =
      ((J.comap (Ideal.Quotient.mk P)).map ψ).map (Ideal.Quotient.mk (Ideal.span {w})) := by
    conv_lhs => rw [hJ]
    rw [Ideal.map_map, hcomm, ← Ideal.map_map]
  have s5 : (((J.comap (Ideal.Quotient.mk P)).map ψ).map
      (Ideal.Quotient.mk (Ideal.span {w}))).comap (Ideal.Quotient.mk (Ideal.span {w})) =
      (J.comap (Ideal.Quotient.mk P)).map ψ := by
    rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot,
      Ideal.mk_ker, ← hw]
    exact sup_eq_left.mpr (Ideal.map_mono hPI)
  apply Ideal.comap_injective_of_surjective (Ideal.Quotient.mk P) Ideal.Quotient.mk_surjective
  rw [Ideal.comap_comap, hcomm, ← Ideal.comap_comap, s4, s5, hc]

theorem wcpa_dj_lus_cvs_ct_fcn_nc_non_domain_prime : ∀ (R B : Type u) [CommRing R] [IsDomain R] [CommRing B] (χ : R →+* B) (x y : B), x * y = 0 → (Ideal.span {x}).IsPrime → (Ideal.span {y}).IsPrime → x ∉ Ideal.span {y} → y ∉ Ideal.span {x} → (∀ r : R, r ≠ 0 → χ r ∉ Ideal.span {x, y}) → ∃ (Q : Ideal B) (_ : Q.IsPrime), Q.comap χ = ⊥ ∧ ¬ IsDomain (Localization.AtPrime Q) :=
by
  intro R B _ _ _ χ x y hxy hx hy hxny hynx h6
  classical
  let S : Submonoid B :=
    { carrier := {b | ∃ r : R, r ≠ 0 ∧ χ r = b}
      mul_mem' := by
        rintro a b ⟨r, hr, rfl⟩ ⟨s, hs, rfl⟩
        exact ⟨r * s, mul_ne_zero hr hs, map_mul χ r s⟩
      one_mem' := ⟨1, one_ne_zero, map_one χ⟩ }
  have hmemS : ∀ r : R, r ≠ 0 → χ r ∈ (S : Set B) := fun r hr => ⟨r, hr, rfl⟩
  have hdisj : Disjoint ((Ideal.span {x, y} : Ideal B) : Set B) (S : Set B) := by
    rw [Set.disjoint_left]
    rintro b hb ⟨r, hr, rfl⟩
    exact h6 r hr hb
  obtain ⟨Q, hQ, hIQ, hQS⟩ := Ideal.exists_le_prime_disjoint _ S hdisj
  have hxQ : x ∈ Q := hIQ (Ideal.subset_span (by simp))
  have hyQ : y ∈ Q := hIQ (Ideal.subset_span (by simp))
  refine ⟨Q, hQ, ?_, ?_⟩
  · rw [eq_bot_iff]
    intro r hr
    rw [Ideal.mem_comap] at hr
    rw [Ideal.mem_bot]
    by_contra hr0
    exact Set.disjoint_left.mp hQS hr (hmemS r hr0)
  · intro hD
    have hx0 : algebraMap B (Localization.AtPrime Q) x ≠ 0 := by
      intro h
      rw [IsLocalization.map_eq_zero_iff Q.primeCompl] at h
      obtain ⟨⟨m, hm⟩, hmx⟩ := h
      have hm' : m * x ∈ Ideal.span {y} := by
        have : m * x = 0 := hmx
        rw [this]; exact Ideal.zero_mem _
      rcases hy.mem_or_mem hm' with h1 | h1
      · obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp h1
        exact hm (Q.mul_mem_left a hyQ)
      · exact hxny h1
    have hy0 : algebraMap B (Localization.AtPrime Q) y ≠ 0 := by
      intro h
      rw [IsLocalization.map_eq_zero_iff Q.primeCompl] at h
      obtain ⟨⟨m, hm⟩, hmy⟩ := h
      have hm' : m * y ∈ Ideal.span {x} := by
        have : m * y = 0 := hmy
        rw [this]; exact Ideal.zero_mem _
      rcases hx.mem_or_mem hm' with h1 | h1
      · obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp h1
        exact hm (Q.mul_mem_left a hxQ)
      · exact hynx h1
    have hprod : algebraMap B (Localization.AtPrime Q) x *
        algebraMap B (Localization.AtPrime Q) y = 0 := by
      rw [← map_mul, hxy, map_zero]
    rcases mul_eq_zero.mp hprod with h | h
    · exact hx0 h
    · exact hy0 h

theorem wcpa_dj_lus_cvs_ct_fcn_nc_chart_prime_point : ∀ (U Y : Scheme.{u}) (e : U ⟶ Y) (x' : U) (B : Type u) [CommRing B] (j : U.presheaf.stalk x' ≃+* B) (Q : Ideal B) [Q.IsPrime], ∃ (u : U) (h : e u ⤳ e x'), Nonempty (U.presheaf.stalk u ≃+* Localization.AtPrime Q) ∧ (IsLocalRing.maximalIdeal (Y.presheaf.stalk (e u))).comap (Y.presheaf.stalkSpecializes h).hom = Q.comap (j.toRingHom.comp (e.stalkMap x').hom) :=
by
  intro U Y e x' B _ j Q _
  have hQ₀p : (Q.comap j.toRingHom).IsPrime := Ideal.comap_isPrime _ _

  have gen : ∀ (q : PrimeSpectrum (U.presheaf.stalk x')), ∃ hsp : U.fromSpecStalk x' q ⤳ x',
      ∀ a : U.presheaf.stalk x', (U.presheaf.stalkSpecializes hsp).hom a ∈
        IsLocalRing.maximalIdeal (U.presheaf.stalk (U.fromSpecStalk x' q)) ↔ a ∈ q.asIdeal := by
    intro q
    have hsp : U.fromSpecStalk x' q ⤳ x' := by
      first
      | exact (Scheme.range_fromSpecStalk (X := U) (x := x')).subset ⟨q, rfl⟩
      | (have h : U.fromSpecStalk x' q ∈ Set.range (U.fromSpecStalk x') := ⟨q, rfl⟩
         rwa [Scheme.range_fromSpecStalk] at h)
      | (have h1 : q ⤳ IsLocalRing.closedPoint (U.presheaf.stalk x') :=
           (PrimeSpectrum.le_iff_specializes _ _).mp (IsLocalRing.le_maximalIdeal q.isPrime.ne_top)
         have h2 := h1.map (U.fromSpecStalk x').continuous
         rwa [Scheme.fromSpecStalk_closedPoint] at h2)
    refine ⟨hsp, fun a => ?_⟩
    have key : (Spec.map (U.presheaf.stalkSpecializes hsp))
        (IsLocalRing.closedPoint (U.presheaf.stalk (U.fromSpecStalk x' q))) = q := by
      apply (U.fromSpecStalk x').isEmbedding.injective
      first
      | (rw [← Scheme.Hom.comp_apply, Scheme.SpecMap_stalkSpecializes_fromSpecStalk,
          Scheme.fromSpecStalk_closedPoint])
      | (show (Spec.map (U.presheaf.stalkSpecializes hsp) ≫ U.fromSpecStalk x')
            (IsLocalRing.closedPoint (U.presheaf.stalk (U.fromSpecStalk x' q))) = _
         rw [Scheme.SpecMap_stalkSpecializes_fromSpecStalk, Scheme.fromSpecStalk_closedPoint])
      | (have e := congrArg (fun k : Spec (U.presheaf.stalk (U.fromSpecStalk x' q)) ⟶ U =>
            k (IsLocalRing.closedPoint (U.presheaf.stalk (U.fromSpecStalk x' q))))
            (Scheme.SpecMap_stalkSpecializes_fromSpecStalk hsp)
         simp only [Scheme.Hom.comp_apply] at e
         rw [e, Scheme.fromSpecStalk_closedPoint])
    have h2 : a ∈ q.asIdeal ↔ a ∈ ((Spec.map (U.presheaf.stalkSpecializes hsp))
        (IsLocalRing.closedPoint (U.presheaf.stalk (U.fromSpecStalk x' q)))).asIdeal := by
      rw [key]
    rw [h2]
    first
    | exact Iff.rfl
    | (rw [Spec.map_base_apply]; exact Iff.rfl)
    | (rw [Scheme.Spec_map_base]; exact Iff.rfl)
    | simp [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, IsLocalRing.closedPoint]
  obtain ⟨hsp, hiff⟩ := gen ⟨Q.comap j.toRingHom, hQ₀p⟩
  have hEq : (IsLocalRing.maximalIdeal (U.presheaf.stalk (U.fromSpecStalk x' ⟨Q.comap j.toRingHom, hQ₀p⟩))).comap
      (U.presheaf.stalkSpecializes hsp).hom = Q.comap j.toRingHom :=
    Ideal.ext fun b => by rw [Ideal.mem_comap]; exact hiff b
  have locz : ∀ (x z : U) (h : x ⤳ z),
      letI := (U.presheaf.stalkSpecializes h).hom.toAlgebra
      IsLocalization.AtPrime (U.presheaf.stalk x)
        ((IsLocalRing.maximalIdeal (U.presheaf.stalk x)).comap
          (U.presheaf.stalkSpecializes h).hom) := by
    intro x z h
    have key : ∀ (A R S : Type u) [CommRing A] [CommRing R] [CommRing S] [IsLocalRing S]
        (gR : A →+* R) (gS : A →+* S) (φ : R →+* S), φ.comp gR = gS →
        ∀ (P Q : Ideal A) [P.IsPrime] [Q.IsPrime],
        @IsLocalization.AtPrime A _ R _ gR.toAlgebra P _ →
        @IsLocalization.AtPrime A _ S _ gS.toAlgebra Q _ →
        letI := φ.toAlgebra; IsLocalization.AtPrime S ((IsLocalRing.maximalIdeal S).comap φ) := by
      intro A R S _ _ _ _ gR gS φ hcomp P Q _ _ hR hS
      letI : Algebra A R := gR.toAlgebra
      letI : Algebra A S := gS.toAlgebra
      letI : Algebra R S := φ.toAlgebra
      have hc : ∀ a, φ (gR a) = gS a := fun a => by rw [← hcomp]; rfl
      haveI : IsScalarTower A R S := IsScalarTower.of_algebraMap_eq (fun a => (hc a).symm)
      have hle : P.primeCompl ≤ Q.primeCompl := by
        intro a ha haQ
        have hu : IsUnit (gR a) := IsLocalization.map_units R (⟨a, ha⟩ : P.primeCompl)
        have hu' : IsUnit (gS a) := hc a ▸ hu.map φ
        have hm : gS a ∈ IsLocalRing.maximalIdeal S := by
          rw [← IsLocalization.AtPrime.map_eq_maximalIdeal Q S]
          exact Ideal.mem_map_of_mem _ haQ
        exact (IsLocalRing.notMem_maximalIdeal.mpr hu') hm
      haveI := IsLocalization.isLocalization_of_submonoid_le R S P.primeCompl Q.primeCompl hle
      show IsLocalization _ S
      refine IsLocalization.of_le (Submonoid.map (algebraMap A R) Q.primeCompl) _ ?_ ?_
      · rintro _ ⟨a, ha, rfl⟩
        show φ (gR a) ∉ IsLocalRing.maximalIdeal S
        rw [hc a]
        exact IsLocalRing.notMem_maximalIdeal.mpr
          (IsLocalization.map_units S (⟨a, ha⟩ : Q.primeCompl))
      · intro r hr
        exact IsLocalRing.notMem_maximalIdeal.mp hr
    obtain ⟨W, hW, hzW, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z) (U := ⊤) trivial
    have hxW : x ∈ W := h.mem_open W.isOpen hzW
    have hLz := hW.isLocalization_stalk ⟨z, hzW⟩
    have hLx := hW.isLocalization_stalk ⟨x, hxW⟩
    have hcomp : (U.presheaf.stalkSpecializes h).hom.comp (U.presheaf.germ W z hzW).hom =
        (U.presheaf.germ W x hxW).hom := by
      rw [← CommRingCat.hom_comp, TopCat.Presheaf.germ_stalkSpecializes]
    exact key Γ(U, W) _ _ _ _ _ hcomp _ _ hLz hLx
  have hloc := locz _ x' hsp
  letI := (U.presheaf.stalkSpecializes hsp).hom.toAlgebra
  have keyL : ∀ (P : Ideal (U.presheaf.stalk x')) [P.IsPrime], P = Q.comap j.toRingHom →
      IsLocalization.AtPrime (U.presheaf.stalk (U.fromSpecStalk x' ⟨Q.comap j.toRingHom, hQ₀p⟩)) P →
      IsLocalization.AtPrime (U.presheaf.stalk (U.fromSpecStalk x' ⟨Q.comap j.toRingHom, hQ₀p⟩))
        (Q.comap j.toRingHom) := by
    intro P _ h hP
    subst h
    exact hP
  haveI hL : IsLocalization.AtPrime
      (U.presheaf.stalk (U.fromSpecStalk x' ⟨Q.comap j.toRingHom, hQ₀p⟩)) (Q.comap j.toRingHom) :=
    keyL _ hEq hloc
  have H : Submonoid.map j.toMonoidHom (Q.comap j.toRingHom).primeCompl = Q.primeCompl := by
    ext y
    rw [Submonoid.mem_map]
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact hx
    · intro hy
      refine ⟨j.symm y, ?_, ?_⟩
      · show j (j.symm y) ∉ Q
        rw [RingEquiv.apply_symm_apply]
        exact hy
      · show j (j.symm y) = y
        exact RingEquiv.apply_symm_apply j y
  refine ⟨U.fromSpecStalk x' ⟨Q.comap j.toRingHom, hQ₀p⟩, hsp.map e.continuous,
    ⟨IsLocalization.ringEquivOfRingEquiv
      (S := U.presheaf.stalk (U.fromSpecStalk x' ⟨Q.comap j.toRingHom, hQ₀p⟩))
      (Q := Localization.AtPrime Q) (M := (Q.comap j.toRingHom).primeCompl)
      (T := Q.primeCompl) j H⟩, ?_⟩
  have hloc2 : ∀ c, (e.stalkMap (U.fromSpecStalk x' ⟨Q.comap j.toRingHom, hQ₀p⟩)).hom c ∈
      IsLocalRing.maximalIdeal (U.presheaf.stalk (U.fromSpecStalk x' ⟨Q.comap j.toRingHom, hQ₀p⟩)) ↔
      c ∈ IsLocalRing.maximalIdeal
        (Y.presheaf.stalk (e (U.fromSpecStalk x' ⟨Q.comap j.toRingHom, hQ₀p⟩))) := fun c => by
    simp only [IsLocalRing.mem_maximalIdeal]
    exact map_mem_nonunits_iff _ c
  ext b
  rw [Ideal.mem_comap, Ideal.mem_comap, ← hloc2,
    Scheme.Hom.stalkSpecializes_stalkMap_apply e _ x' hsp b, hiff]
  exact Iff.rfl

theorem wcpa_dj_lus_cvs_ct_fcn_nc_etale_stalk_domain : ∀ (U Y : Scheme.{u}) (e : U ⟶ Y), Etale e → ∀ u : U, IsDomain (Y.presheaf.stalk (e u)) → IsIntegrallyClosed (Y.presheaf.stalk (e u)) → IsDomain (U.presheaf.stalk u) :=
by
  intro U Y e he u hd hi
  classical

  have alg : ∀ (A B : Type u) [CommRing A] [CommRing B] (φ : A →+* B), φ.Etale →
      ∀ (p : Ideal A) [p.IsPrime] (q : Ideal B) [q.IsPrime], q.comap φ = p →
      IsDomain (Localization.AtPrime p) → IsIntegrallyClosed (Localization.AtPrime p) →
      IsDomain (Localization.AtPrime q) := by
    intro A B _ _ φ hφ p _ q _ hc hAd hAi
    let M := p.primeCompl
    let M' := M.map φ
    let Bp := Localization M'
    have hψ : (IsLocalization.map (M := M) (T := M') Bp φ (Submonoid.le_comap_map M) :
        Localization.AtPrime p →+* Bp).Etale :=
      RingHom.Etale.isStableUnderBaseChange.isLocalization_map M φ hφ
    letI : Algebra (Localization.AtPrime p) Bp :=
      (IsLocalization.map (M := M) (T := M') Bp φ (Submonoid.le_comap_map M) :
        Localization.AtPrime p →+* Bp).toAlgebra
    haveI : Algebra.Etale (Localization.AtPrime p) Bp := RingHom.Etale.toAlgebra hψ
    have hdisj : Disjoint (M' : Set B) (q : Set B) := by
      rw [Set.disjoint_left]
      rintro _ ⟨s, hs, rfl⟩ hsq
      have : s ∈ q.comap φ := hsq
      rw [hc] at this
      exact hs this
    haveI hq' : (q.map (algebraMap B Bp)).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint M' Bp q inferInstance hdisj
    have hcq : (q.map (algebraMap B Bp)).comap (algebraMap B Bp) = q :=
      IsLocalization.under_map_of_isPrime_disjoint M' Bp (inferInstance : q.IsPrime) hdisj
    haveI := hAd
    haveI := hAi
    obtain ⟨hd', -⟩ := wc_pks_etale_localization_normal (Localization.AtPrime p) Bp
      (q.map (algebraMap B Bp))
    have h1 : IsLocalization.AtPrime (Localization.AtPrime (q.map (algebraMap B Bp)))
        ((q.map (algebraMap B Bp)).comap (algebraMap B Bp)) :=
      IsLocalization.isLocalization_isLocalization_atPrime_isLocalization M'
        (Localization.AtPrime (q.map (algebraMap B Bp))) (q.map (algebraMap B Bp))
    have hS : q.primeCompl = ((q.map (algebraMap B Bp)).comap (algebraMap B Bp)).primeCompl := by
      ext x
      rw [Ideal.mem_primeCompl_iff, Ideal.mem_primeCompl_iff, hcq]
    haveI h2 : IsLocalization.AtPrime (Localization.AtPrime (q.map (algebraMap B Bp))) q := by
      unfold IsLocalization.AtPrime
      rw [hS]
      exact h1
