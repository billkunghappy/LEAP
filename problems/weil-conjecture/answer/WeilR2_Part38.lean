  have stalk_facts : ∀ (P : Scheme.{u}) [AlgebraicGeometry.IsIntegral P] (str : P ⟶ Spec (.of Ω))
      (c : P), Function.Injective (P.presheaf.stalkSpecializes (genericPoint_specializes c)).hom ∧
