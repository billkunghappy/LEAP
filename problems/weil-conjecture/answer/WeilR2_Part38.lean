      rw [Spec.map_comp, ← h2, ← Category.assoc, Scheme.Spec_stalkClosedPointTo_fromSpecStalk, hP,
        Spec.map_id]
    have h4 : κ ≫ Scheme.stalkClosedPointTo P = 𝟙 (CommRingCat.of Ω) := Spec.map_injective h3
    have hev : ∀ ω : Ω, ev (κ.hom ω) = ω := fun ω => congrArg (fun φ => φ.hom ω) h4

    obtain ⟨s₀, hs₀m, hs₀⟩ := hval
    have hs₀' : j s₀ = g - c u := hs₀
    have hev0 : ev s₀ = 0 := by
      by_contra h
