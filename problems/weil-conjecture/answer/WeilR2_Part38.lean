        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hφ, hφ₁, hφ₀C, hψW, hBW]
      · intro j
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hφ, hφ₁, hφ₀X]
        by_cases hji : j = i
        · subst hji
          simp only [f, if_pos rfl]
          rw [hψτ]
        · simp only [f, if_neg hji]
          rw [map_mul, hψW]
          have h2 : ξ * algebraMap _ (Localization.Away s) (Ideal.Quotient.mk I (MvPolynomial.X j)) =
              algebraMap R (Localization.Away s) a := by
            rw [hξdef, ← map_mul, hprod' j hji,
              ← IsScalarTower.algebraMap_apply R (MvPolynomial (Fin 2) R ⧸ I) (Localization.Away s)]
          linear_combination (algebraMap _ (Localization.Away s)
              (Ideal.Quotient.mk I (MvPolynomial.X j))) * hψτi - (ψ τi) * h2
    have hφψ : φ.comp ψ = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (MvPolynomial.X 0 : MvPolynomial (Fin 1) R))
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hψ, hgC, hφW, hTW]
      · intro j
        have hj0 : j = 0 := Subsingleton.elim _ _
        subst hj0
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hψ, hgX, hξdef, hφ, hφ₁s]
    let e : T ≃ₐ[R] Localization.Away s :=
      AlgEquiv.ofRingEquiv (f := RingEquiv.ofRingHom ψ φ hψφ hφψ) hψW
    haveI : Algebra.IsStandardSmoothOfRelativeDimension 1 R (MvPolynomial (Fin 1) R) := by
      have := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial R (Fin 1)
      rwa [Nat.card_eq_fintype_card, Fintype.card_fin] at this
    haveI : Algebra.IsStandardSmoothOfRelativeDimension 0 (MvPolynomial (Fin 1) R) T :=
      Algebra.IsStandardSmoothOfRelativeDimension.localization_away (MvPolynomial.X 0)
    haveI : Algebra.IsStandardSmoothOfRelativeDimension 1 R T := by
      have := Algebra.IsStandardSmoothOfRelativeDimension.trans 1 0 R (MvPolynomial (Fin 1) R) T
      rwa [zero_add] at this
    exact Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv 1 e
  exact hopen ↥W (wcNcRing W a) _ 1 (halg ↥W a i) O hO

theorem wcpa_dj_lfc_afcaf_gnu_vertex_section : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω), ∃ Δ : Spec (.of ↥W) ⟶ Spec (.of (wcNcRing W 0)), IsClosedImmersion Δ ∧ Δ ≫ wcNcStr W 0 = 𝟙 _ ∧ ∀ P : Spec (.of (wcNcRing W 0)), Ideal.Quotient.mk (wcNcIdeal W 0) (MvPolynomial.X 0) ∈ P.asIdeal → Ideal.Quotient.mk (wcNcIdeal W 0) (MvPolynomial.X 1) ∈ P.asIdeal → P = Δ (wcNcStr W 0 P) :=
by
  intro Ω _ W
  classical
  have hker : ∀ g ∈ wcNcIdeal W 0, MvPolynomial.constantCoeff g = 0 := by
    intro g hg
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hg
    simp
  let s₀ : wcNcRing W 0 →+* ↥W :=
    Ideal.Quotient.lift (wcNcIdeal W 0) MvPolynomial.constantCoeff hker
  have hs₀mk : ∀ F, s₀ (Ideal.Quotient.mk (wcNcIdeal W 0) F) = MvPolynomial.constantCoeff F :=
    fun F => Ideal.Quotient.lift_mk _ _ _
  have halg : ∀ c : ↥W, algebraMap ↥W (wcNcRing W 0) c =
      Ideal.Quotient.mk (wcNcIdeal W 0) (MvPolynomial.C c) := by
    intro c
    rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
  have hK1 : ∀ c, s₀ (algebraMap ↥W (wcNcRing W 0) c) = c := by
    intro c
    rw [halg, hs₀mk, MvPolynomial.constantCoeff_C]
  have hcomp : s₀.comp (algebraMap ↥W (wcNcRing W 0)) = RingHom.id ↥W := RingHom.ext hK1
  have hsurj : Function.Surjective s₀ := fun c => ⟨_, hK1 c⟩
  have hdec : ∀ F : MvPolynomial (Fin 2) ↥W,
      F - MvPolynomial.C (MvPolynomial.constantCoeff F) ∈
        Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} := by
    intro F
    induction F using MvPolynomial.induction_on with
    | C a => simp
    | add p q hp hq =>
      have e : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
          (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
            (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
        simp only [map_add]; ring
      rw [e]
      exact add_mem hp hq
    | mul_X p n _ =>
      have e : p * MvPolynomial.X n - MvPolynomial.C (MvPolynomial.constantCoeff
          (p * MvPolynomial.X n)) = p * MvPolynomial.X n := by
        simp
      rw [e]
      apply Ideal.mul_mem_left
      fin_cases n
      · exact Ideal.subset_span (Set.mem_insert _ _)
      · exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  refine ⟨Spec.map (CommRingCat.ofHom s₀), ?_, ?_, ?_⟩
  · apply IsClosedImmersion.spec_of_surjective
    exact hsurj
  · show Spec.map _ ≫ Spec.map _ = _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp]
    exact Spec.map_id _
  · intro P h0 h1
    apply PrimeSpectrum.ext
    ext f
    show f ∈ P.asIdeal ↔ algebraMap ↥W (wcNcRing W 0) (s₀ f) ∈ P.asIdeal
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective f
    have hspan : Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ≤
        Ideal.comap (Ideal.Quotient.mk (wcNcIdeal W 0)) P.asIdeal := by
      rw [Ideal.span_le]
      intro x hx
      rcases hx with rfl | rfl
      · exact h0
      · exact h1
    have hh : Ideal.Quotient.mk (wcNcIdeal W 0) F -
        algebraMap ↥W (wcNcRing W 0) (s₀ (Ideal.Quotient.mk (wcNcIdeal W 0) F)) ∈ P.asIdeal := by
      rw [hs₀mk, halg, ← map_sub]
      exact hspan (hdec F)
    constructor
    · intro hf
      have := P.asIdeal.sub_mem hf hh
      rwa [sub_sub_cancel] at this
    · intro hf
      have := P.asIdeal.add_mem hh hf
      rwa [sub_add_cancel] at this

theorem wcpa_dj_lfc_afcaf_gnu_section_generization_unique : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : ValuationSubring K), IsAlgClosed (IsLocalRing.ResidueField ↥R) → ∀ (U X : Scheme.{u}) (m : U ⟶ X) (Δ : Spec (.of ↥R) ⟶ X), Etale m → IsClosedImmersion Δ → ∀ (u u₁ u₂ : U) (p : Spec (.of ↥R)), m u = Δ (IsLocalRing.closedPoint ↥R) → m u₁ = Δ p → m u₂ = Δ p → u₁ ⤳ u → u₂ ⤳ u → u₁ = u₂ :=
by
  intro K _ _ R hκ U X m Δ hm hΔ u u₁ u₂ p h h₁ h₂ hs₁ hs₂
  haveI := hm
  haveI := hΔ
  have hind : Topology.IsInducing (Limits.pullback.fst m Δ) :=
    (IsClosedImmersion.isClosedEmbedding (Limits.pullback.fst m Δ)).isInducing
  obtain ⟨z', hz'1, hz'2⟩ := Scheme.Pullback.exists_preimage_pullback u _ h
  obtain ⟨z₁, hz₁1, hz₁2⟩ := Scheme.Pullback.exists_preimage_pullback u₁ p h₁
  obtain ⟨z₂, hz₂1, hz₂2⟩ := Scheme.Pullback.exists_preimage_pullback u₂ p h₂
  have hsp₁ : z₁ ⤳ z' := by
    rw [← hz₁1, ← hz'1] at hs₁
    exact hind.specializes_iff.mp hs₁
  have hsp₂ : z₂ ⤳ z' := by
    rw [← hz₂1, ← hz'1] at hs₂
    exact hind.specializes_iff.mp hs₂
  obtain ⟨σ, hσ, hσ𝔪⟩ := wcpa_dj_nc_henselian_section_lift K R (Spec (.of ↥R))
    (Limits.pullback m Δ) (Limits.pullback.snd m Δ) (𝟙 _) z' hκ inferInstance
    (by rw [hz'2]; rfl)
  haveI hσo : IsOpenImmersion σ :=
    wc_etale_section_isOpenImmersion (Limits.pullback.snd m Δ) (𝟙 _) σ hσ
  have hopen : IsOpen (Set.range σ) := IsOpenImmersion.isOpen_range σ
  have hz'r : z' ∈ Set.range σ := ⟨_, hσ𝔪⟩
  have key : ∀ z, z ⤳ z' → Limits.pullback.snd m Δ z = p → z = σ p := by
    intro z hz hzp
    obtain ⟨q, hq⟩ := hz.mem_open hopen hz'r
    have : q = p := by
      have e1 : Limits.pullback.snd m Δ (σ q) = q := by
        rw [← Scheme.Hom.comp_apply, hσ]; rfl
      rw [← e1, hq, hzp]
    rw [← hq, this]
  rw [← hz₁1, ← hz₂1, key z₁ hsp₁ hz₁2, key z₂ hsp₂ hz₂2]

theorem wcpa_dj_lfc_afcaf_gnu_node_not_unibranch : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : ValuationSubring K) (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)), wcpaDjSemistable v → ∀ E ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))), ∀ n ∈ E ∩ closure Eᶜ, ∀ (W' : Scheme.{u}) (e' : W' ⟶ Y), Flat e' → ∀ w : W', e' w = Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) n → IsDomain (W'.presheaf.stalk w) → False :=
by
  intro K _ _ R Y v hss
  classical
  obtain ⟨_, ⟨hKemb, hKrange⟩, _, _⟩ := wcpa_dj_lus_cvs_fibre_topology K R Y v hss
  have hfinK := (wcpa_dj_lfc_afc_fibre_nodes_finite (Spec (.of ↥R)) Y v hss K
    (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).1
  set j := Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) with hj
  set fK := Limits.pullback.fst v j with hfK
  set η := genericPoint (Spec (.of ↥R)) with hη
  intro E hE n hn W' e' hflat w hw hdom
  obtain ⟨hnE, hncl⟩ := hn
  haveI := hflat
  haveI := hdom
  have hvK : ∀ z, v (fK z) = η := by
    intro z
    have h1 : fK z ∈ Set.range fK := ⟨z, rfl⟩
    rw [hKrange] at h1
    exact h1
  have hfKinj : Function.Injective fK := hKemb.injective
  have hηall : ∀ t : ↥(Spec (.of ↥R)), η ⤳ t := fun t => genericPoint_specializes t
  have hηmin : ∀ t : ↥(Spec (.of ↥R)), t ⤳ η → t = η := fun t h => (h.antisymm (hηall t)).eq

  obtain ⟨E', hE'c, hE'ne, hnE'⟩ : ∃ E' ∈ irreducibleComponents ↥(Limits.pullback v j),
      E' ≠ E ∧ n ∈ E' := by
    have hU : IsClosed (⋃ E' ∈ {E' | E' ∈ irreducibleComponents ↥(Limits.pullback v j) ∧ E' ≠ E},
        E') :=
      (hfinK.subset (fun E' hE' => hE'.1)).isClosed_biUnion
        (fun E' hE' => isClosed_of_mem_irreducibleComponents E' hE'.1)
    have hsubU : Eᶜ ⊆
        ⋃ E' ∈ {E' | E' ∈ irreducibleComponents ↥(Limits.pullback v j) ∧ E' ≠ E}, E' := by
      intro y hy
      obtain ⟨E'', hE'', hyE''⟩ :=
        exists_mem_irreducibleComponents_subset_of_isIrreducible {y} isIrreducible_singleton
      refine Set.mem_biUnion (x := E'') ⟨hE'', ?_⟩ (hyE'' (Set.mem_singleton y))
      intro h
      rw [h] at hyE''
      exact hy (hyE'' (Set.mem_singleton y))
    have hnU := closure_minimal hsubU hU hncl
    obtain ⟨E', ⟨hE'c, hE'ne⟩, hnE'⟩ := Set.mem_iUnion₂.mp hnU
    exact ⟨E', hE'c, hE'ne, hnE'⟩

  have genK : ∀ C ∈ irreducibleComponents ↥(Limits.pullback v j), ∃ z, closure {z} = C := by
    intro C hC
    refine ⟨hC.1.genericPoint, ?_⟩
    have h1 := hC.1.isGenericPoint_genericPoint_closure
    rw [(isClosed_of_mem_irreducibleComponents C hC).closure_eq] at h1
    exact h1

  have maxgen : ∀ C ∈ irreducibleComponents ↥(Limits.pullback v j),
      ∀ z : ↥(Limits.pullback v j), closure {z} = C → ∀ ξ : Y, ξ ⤳ fK z → ξ = fK z := by
    intro C hC z hz ξ hξ
    have hvξ : v ξ = η := hηmin _ (by have h1 := hξ.map v.continuous; rwa [hvK z] at h1)
    obtain ⟨z', hz'⟩ : ξ ∈ Set.range fK := by rw [hKrange]; exact hvξ
    have hz'z : z' ⤳ z := hKemb.toIsInducing.specializes_iff.mp (by rw [hz']; exact hξ)
    have hsub : C ⊆ closure {z'} := by
      rw [← hz]; exact specializes_iff_closure_subset.mp hz'z
    have hz'E : z' ∈ closure {z} := by
      rw [hz]
      exact hC.2 isIrreducible_singleton.closure hsub (subset_closure (Set.mem_singleton z'))
    have hzz' : z ⤳ z' := specializes_iff_mem_closure.mpr hz'E
    rw [← hz', (hz'z.antisymm hzz').eq]

  obtain ⟨ω, hω⟩ : ∃ ω : W', ∀ w'', w'' ⤳ w → ω ⤳ w'' := by
    refine ⟨W'.fromSpecStalk w (genericPoint _), ?_⟩
    intro w'' hw''
    have h1 : w'' ∈ Set.range (W'.fromSpecStalk w) := by
      rw [Scheme.range_fromSpecStalk]; exact hw''
    obtain ⟨q, rfl⟩ := h1
    exact (genericPoint_specializes q).map (W'.fromSpecStalk w).continuous

  have key : ∀ C ∈ irreducibleComponents ↥(Limits.pullback v j), n ∈ C →
      ∀ z, closure {z} = C → e' ω = fK z := by
    intro C hC hnC z hz
    have hzn : z ⤳ n := specializes_iff_mem_closure.mpr (by rw [hz]; exact hnC)
    have h1 : fK z ⤳ e' w := by rw [hw]; exact hzn.map fK.continuous
    obtain ⟨wC, hwC, hewC⟩ := Flat.generalizingMap e' h1
    have h2 : e' ω ⤳ fK z := by rw [← hewC]; exact (hω wC hwC).map e'.continuous
    exact maxgen C hC z hz _ h2

  obtain ⟨z1, hz1⟩ := genK E hE
  obtain ⟨z2, hz2⟩ := genK E' hE'c
  have e := hfKinj ((key E hE hnE z1 hz1).symm.trans (key E' hE'c hnE' z2 hz2))
  apply hE'ne
  rw [← hz1, ← hz2, e]

theorem wcpa_dj_lfc_afcaf_generic_node_unique : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : ValuationSubring K), IsAlgClosed (IsLocalRing.ResidueField ↥R) → ∀ (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)), wcpaDjSemistable v → ∀ E ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))), ∀ n₁ ∈ E ∩ closure Eᶜ, ∀ n₂ ∈ E ∩ closure Eᶜ, ∀ y : Y, v y = IsLocalRing.closedPoint ↥R → Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) n₁ ⤳ y → Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) n₂ ⤳ y → n₁ = n₂ :=
by
  intro K _ _ R hκ Y v hss E hE n₁ hn₁ n₂ hn₂ y hy h₁ h₂
  classical
  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]
  haveI : IsProper v := hss.2.1
  haveI : Flat v := hss.1
  have hLFP : LocallyOfFinitePresentation v :=
    wcpa_dj_mn_flat_fp (Spec (.of ↥R)) Y v hss.1 inferInstance
  have NU := wcpa_dj_lfc_afcaf_gnu_node_not_unibranch K R Y v hss E hE
  obtain ⟨_, ⟨hKemb, hKrange⟩, _, _⟩ := wcpa_dj_lus_cvs_fibre_topology K R Y v hss
  set fK := Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) with hfK
  set η := genericPoint (Spec (.of ↥R)) with hη
  have hvK : ∀ z, v (fK z) = η := by
    intro z
    have h1 : fK z ∈ Set.range fK := ⟨z, rfl⟩
    rw [hKrange] at h1
    exact h1
  have hfKinj : Function.Injective fK := hKemb.injective
  have hηbot : η.asIdeal = ⊥ :=
    congrArg PrimeSpectrum.asIdeal (genericPoint_eq_bot_of_affine (CommRingCat.of ↥R))

  have G1 : ¬ ∃ W : Y.Opens, y ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ v) := by
    rintro ⟨W, hyW, hWsm⟩
    haveI := hWsm
    have hmem : fK n₁ ∈ W := h₁.mem_open W.isOpen hyW
    haveI hdom := wcpa_dj_lus_cvs_smooth_valuation_stalk_domain K R W.toScheme (W.ι ≫ v)
      (⟨fK n₁, hmem⟩ : W)
    exact NU n₁ hn₁ W.toScheme W.ι inferInstance ⟨fK n₁, hmem⟩
      (Scheme.Opens.ι_apply W _) hdom

  have hND := wcpa_dj_nc_nonsmooth_fibre_node K R Y v y hκ hss hLFP hy G1
  obtain ⟨U, e, a, m, x', he, hm, hc, hx', hx0, hx1⟩ :=
    wcpa_dj_nc_chart_exists K R Y v y hκ hss.1 hLFP hy hND
  haveI := he
  haveI := hm

  have lift : ∀ n, fK n ⤳ y → ∃ u, u ⤳ x' ∧ e u = fK n := by
    intro n hn
    rw [← hx'] at hn
    exact Flat.generalizingMap e hn
  obtain ⟨u₁, hu₁, heu₁⟩ := lift n₁ h₁
  obtain ⟨u₂, hu₂, heu₂⟩ := lift n₂ h₂
  have hstr : ∀ w, wcNcStr R a (m w) = v (e w) := fun w => by
    rw [pt hc w, Scheme.Hom.comp_apply]

  have G4 : ∀ n ∈ E ∩ closure Eᶜ, ∀ u, e u = fK n → ∀ i : Fin 2,
      Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X i) ∈ (m u).asIdeal := by
    intro n hn u heu i
    by_contra hni
    let D : (Spec (.of (wcNcRing R a))).Opens :=
      PrimeSpectrum.basicOpen (Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X i))
    have hD : ∀ p : Spec (.of (wcNcRing R a)), p ∈ D ↔
        Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X i) ∉ p.asIdeal :=
      fun p => PrimeSpectrum.mem_basicOpen _ _
    haveI hDsm := wcpa_dj_lfc_afcaf_gnu_chart_off_vertex_smooth K R a i D hD
    haveI : SmoothOfRelativeDimension 0 (m ∣_ D) :=
      (Etale.iff_smoothOfRelativeDimension_zero _).mp inferInstance
    haveI hq : SmoothOfRelativeDimension (0 + 1) ((m ∣_ D) ≫ (D.ι ≫ wcNcStr R a)) :=
      smoothOfRelativeDimension_comp 0 1 (m ∣_ D) (D.ι ≫ wcNcStr R a)
    have huO : u ∈ m ⁻¹ᵁ D := by
      rw [Scheme.Hom.mem_preimage]
      exact (hD (m u)).mpr hni
    let w : (m ⁻¹ᵁ D).toScheme := ⟨u, huO⟩
    haveI hdom := wcpa_dj_lus_cvs_smooth_valuation_stalk_domain K R (m ⁻¹ᵁ D).toScheme
      ((m ∣_ D) ≫ (D.ι ≫ wcNcStr R a)) w
    have hew : ((m ⁻¹ᵁ D).ι ≫ e) w = fK n := by
      rw [← pt rfl w, Scheme.Opens.ι_apply]
      exact heu
    exact NU n hn (m ⁻¹ᵁ D).toScheme ((m ⁻¹ᵁ D).ι ≫ e) inferInstance w hew hdom

  have hprod : Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 0) *
      Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 1) =
      algebraMap (↥R) (wcNcRing R a) a := by
    have e1 : algebraMap (↥R) (wcNcRing R a) a =
        Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.C a) := by
      rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
    rw [e1, ← map_mul, Ideal.Quotient.eq]
    exact Ideal.mem_span_singleton_self _
  have ha0 : a = 0 := by
    have hmem : algebraMap (↥R) (wcNcRing R a) a ∈ (m u₁).asIdeal := by
      rw [← hprod]
      exact Ideal.mul_mem_right _ _ (G4 n₁ hn₁ u₁ heu₁ 0)
    have h2 : a ∈ (wcNcStr R a (m u₁)).asIdeal := hmem
    rw [hstr, heu₁, hvK, hηbot] at h2
    have h3 : a ∈ (⊥ : Ideal ↥R) := h2
    exact (Submodule.mem_bot _).mp h3
  subst ha0

  obtain ⟨Δ, hΔci, _, hΔv⟩ := wcpa_dj_lfc_afcaf_gnu_vertex_section K R
  have hu₁Δ : m u₁ = Δ η := by
    rw [hΔv (m u₁) (G4 n₁ hn₁ u₁ heu₁ 0) (G4 n₁ hn₁ u₁ heu₁ 1), hstr, heu₁, hvK]
  have hu₂Δ : m u₂ = Δ η := by
    rw [hΔv (m u₂) (G4 n₂ hn₂ u₂ heu₂ 0) (G4 n₂ hn₂ u₂ heu₂ 1), hstr, heu₂, hvK]
  have hx'Δ : m x' = Δ (IsLocalRing.closedPoint ↥R) := by
    rw [hΔv (m x') hx0 hx1, hstr, hx', hy]

  have hu : u₁ = u₂ := wcpa_dj_lfc_afcaf_gnu_section_generization_unique K R hκ U _ m Δ hm hΔci
    x' u₁ u₂ η hx'Δ hu₁Δ hu₂Δ hu₁ hu₂

  apply hfKinj
  rw [← heu₁, ← heu₂, hu]

theorem wcpa_dj_lfc_afc_core_af : ∀ (K : Type u) [Field K] [IsAlgClosed K]
    (R : ValuationSubring K), IsAlgClosed (IsLocalRing.ResidueField ↥R) →
    ∀ (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)) (k : ℕ) (σ : Fin (k + 1) → (Spec (.of ↥R) ⟶ Y))
      (r : ℕ) (ε : Fin r → (Spec (.of ↥R) ⟶ Y))
      (D₀ : Set ↥(Limits.pullback v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))))),
    wcpaDjStablePtd v (k + 1) σ → wcpaDjSections v (k + 1 + r) (Fin.append σ ε) →
    D₀ ∈ irreducibleComponents ↥(Limits.pullback v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) →
    (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))))
      (θ : Er ≅ @Proj _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥R))
        MvPolynomial.gradedAlgebra),
      IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = D₀ ∧
      θ.hom ≫ @Proj.toSpecZero _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥R))
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap (IsLocalRing.ResidueField ↥R)
            ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥R) 0))) =
      ι ≫ Limits.pullback.snd v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) →
    (∃ x ∈ D₀, ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥R))),
      Limits.pullback.fst v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) x =
      σ (Fin.last k)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))) q)) →
    (D₀ ∩ closure D₀ᶜ).ncard + Nat.card {i : Fin k // ∃ x ∈ D₀,
      ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥R))),
      Limits.pullback.fst v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) x =
      σ (Fin.castSucc i)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))) q)} ≤ 2 →
    1 ≤ (D₀ ∩ closure D₀ᶜ).ncard →
    (∀ b, ¬ ∃ x ∈ D₀, ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥R))),
      Limits.pullback.fst v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) x =
      ε b (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))) q)) →
    (∀ D ∈ irreducibleComponents ↥(Limits.pullback v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))),
      D ≠ D₀ → ∃ b, ∃ x ∈ D, ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥R))),
        Limits.pullback.fst v
          (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) x =
        ε b (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))) q)) →
    ∀ E : Set ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))),
      E ∈ irreducibleComponents
        ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) →
      (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)),
        Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) x =
        ε b (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) q)) →
      (∃ (Er : Scheme.{u})
          (ι : Er ⟶ Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))))
          (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
          ι ≫ Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) ∧
      (∃ x ∈ E, ∃ q : ↥(Spec (.of K)),
        Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) x =
        σ (Fin.last k) (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) q)) ∧
      (E ∩ closure Eᶜ).ncard + Nat.card {i : Fin k // ∃ x ∈ E, ∃ q : ↥(Spec (.of K)),
        Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) x =
        σ (Fin.castSucc i) (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) q)} = 2 ∧
      1 ≤ (E ∩ closure Eᶜ).ncard ∧
      (∀ E' : Set ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))),
        E' ∈ irreducibleComponents
          ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) →
        (∀ b, ¬ ∃ x ∈ E', ∃ q : ↥(Spec (.of K)),
          Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) x =
          ε b (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) q)) →
        E' = E) :=
by
  intro K _ _ R hκ Y v k σ r ε
  classical
  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]
  have FT := fun hss : wcpaDjSemistable v => wcpa_dj_lus_cvs_fibre_topology K R Y v hss
  have S1 := fun hss : wcpaDjSemistable v =>
    wcpa_dj_lfc_afcaf_generic_point_generization K R hκ Y v hss
  have S3 := fun hss : wcpaDjSemistable v => wcpa_dj_lfc_afcaf_closure_pure K R hκ Y v hss
  have S4 := fun hss : wcpaDjSemistable v => wcpa_dj_lfc_afcaf_p1_lift K R hκ Y v hss
  have S6 := fun hss : wcpaDjSemistable v => wcpa_dj_lfc_afcaf_generic_node_unique K R hκ Y v hss
  have FK := fun hss : wcpaDjSemistable v => (wcpa_dj_lfc_afc_fibre_nodes_finite _ _ v hss K
    (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).1
  have hcondK := Limits.pullback.condition (f := v)
    (g := Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))
  have hcond0 := Limits.pullback.condition (f := v)
    (g := Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))
  set j := Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) with hj
  set c := Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))) with hc
  set fK := Limits.pullback.fst v j with hfK
  set f0 := Limits.pullback.fst v c with hf0
  set η := genericPoint (Spec (.of ↥R)) with hη
  set 𝔪 := IsLocalRing.closedPoint ↥R with h𝔪
  intro D₀ hst hsec hD₀ hP1₀ hlast₀ hcnt₀ hnd₀ hAF₀ hother₀ E hE hAF
  have hss := hst.1
  haveI : IsProper v := hss.2.1
  obtain ⟨_, ⟨hKemb, hKrange⟩, ⟨h0emb, h0range⟩, _⟩ := FT hss
  have s1 := S1 hss
  have s3 := S3 hss
  have s4 := S4 hss
  have s6 := S6 hss
  have hfinK := FK hss
  have hηall : ∀ t : ↥(Spec (.of ↥R)), η ⤳ t := fun t => genericPoint_specializes t
  have hηmin : ∀ t : ↥(Spec (.of ↥R)), t ⤳ η → t = η := fun t h => (h.antisymm (hηall t)).eq
  have hv0 : ∀ y, v (f0 y) = 𝔪 := by
    intro y
    have h1 : f0 y ∈ Set.range f0 := ⟨y, rfl⟩
    rw [h0range] at h1
    exact h1
  have hvK : ∀ y, v (fK y) = η := by
    intro y
    have h1 : fK y ∈ Set.range fK := ⟨y, rfl⟩
    rw [hKrange] at h1
    exact h1
  have hf0inj : Function.Injective f0 := h0emb.toIsEmbedding.injective
  have hfKinj : Function.Injective fK := hKemb.injective
  obtain ⟨x0, _⟩ := hE.1.nonempty
  obtain ⟨d0, _⟩ := hD₀.1.nonempty
  have hjη : ∀ p, j p = η := by
    intro p
    have h1 := pt hcondK x0
    rw [Scheme.Hom.comp_apply, hvK x0, Subsingleton.elim (Limits.pullback.snd v j x0) p] at h1
    exact h1.symm
  have hc𝔪 : ∀ p, c p = 𝔪 := by
    intro p
    have h1 := pt hcond0 d0
    rw [Scheme.Hom.comp_apply, hv0 d0, Subsingleton.elim (Limits.pullback.snd v c d0) p] at h1
    exact h1.symm
  obtain ⟨hS1, _, hS3⟩ := hst.2.1
  have hvσ : ∀ i z, v (σ i z) = z := by
    intro i z
    rw [pt (hS1 i) z]
    rfl
  have hε1 : ∀ b, ε b ≫ v = 𝟙 _ := by
    intro b
    have h1 := hsec.1 (Fin.natAdd (k + 1) b)
    rwa [Fin.append_right] at h1
  have hε3 : ∀ b p, ∃ W : Y.Opens, ε b p ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ v) := by
    intro b p
    have h1 := hsec.2.2 (Fin.natAdd (k + 1) b) p
    rwa [Fin.append_right] at h1

  have MK : ∀ (τ : Spec (.of ↥R) ⟶ Y) (E' : Set ↥(Limits.pullback v j)),
      (∃ x ∈ E', ∃ q : ↥(Spec (.of K)), fK x = τ (j q)) ↔ τ η ∈ fK '' E' := by
    intro τ E'
    constructor
    · rintro ⟨x, hx, q, hq⟩
      exact ⟨x, hx, by rw [hq, hjη]⟩
    · rintro ⟨x, hx, hq⟩
      exact ⟨x, hx, Limits.pullback.snd v j x0, by rw [hq, hjη]⟩
  have M0 : ∀ (τ : Spec (.of ↥R) ⟶ Y) (D : Set ↥(Limits.pullback v c)),
      (∃ x ∈ D, ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥R))), f0 x = τ (c q)) ↔
        τ 𝔪 ∈ f0 '' D := by
    intro τ D
    constructor
    · rintro ⟨x, hx, q, hq⟩
      exact ⟨x, hx, by rw [hq, hc𝔪]⟩
    · rintro ⟨x, hx, hq⟩
      exact ⟨x, hx, Limits.pullback.snd v c d0, by rw [hq, hc𝔪]⟩

  have genK : ∀ E' ∈ irreducibleComponents ↥(Limits.pullback v j), ∃ z, closure {z} = E' := by
    intro E' hE'
    refine ⟨hE'.1.genericPoint, ?_⟩
    have h1 := hE'.1.isGenericPoint_genericPoint_closure
    rw [(isClosed_of_mem_irreducibleComponents E' hE').closure_eq] at h1
    exact h1
  have clK : ∀ (E' : Set ↥(Limits.pullback v j)) (z : ↥(Limits.pullback v j)), closure {z} = E' →
      closure (fK '' E') ⊆ closure {fK z} := by
    intro E' z hz
    apply closure_minimal _ isClosed_closure
    rintro _ ⟨w, hw, rfl⟩
    rw [← hz] at hw
    exact specializes_iff_mem_closure.mp ((specializes_iff_mem_closure.mpr hw).map fK.continuous)

  have smgen : ∀ y : Y, (∃ W : Y.Opens, y ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ v)) →
      ∃ ξ : Y, ∀ y', y' ⤳ y → ξ ⤳ y' := by
    rintro y ⟨W, hW, hWsm⟩
    haveI := hWsm
    haveI hdomW := wcpa_dj_lus_cvs_smooth_valuation_stalk_domain K R W.toScheme (W.ι ≫ v)
      (⟨y, hW⟩ : W)
    haveI hdom : IsDomain (Y.presheaf.stalk y) :=
      MulEquiv.isDomain _ (W.stalkIso (⟨y, hW⟩ : W)).symm.commRingCatIsoToRingEquiv.toMulEquiv
    refine ⟨Y.fromSpecStalk y (genericPoint _), ?_⟩
    intro y' hy'
    have h1 : y' ∈ Set.range (Y.fromSpecStalk y) := by
      rw [Scheme.range_fromSpecStalk]; exact hy'
    obtain ⟨q, rfl⟩ := h1
    exact (genericPoint_specializes q).map (Y.fromSpecStalk y).continuous

  have maxgen : ∀ E' ∈ irreducibleComponents ↥(Limits.pullback v j),
      ∀ z : ↥(Limits.pullback v j), closure {z} = E' → ∀ ξ : Y, ξ ⤳ fK z → ξ = fK z := by
    intro E' hE' z hz ξ hξ
    have hvξ : v ξ = η := hηmin _ (by have h1 := hξ.map v.continuous; rwa [hvK z] at h1)
    obtain ⟨z', hz'⟩ : ξ ∈ Set.range fK := by rw [hKrange]; exact hvξ
    have hz'z : z' ⤳ z := hKemb.toIsInducing.specializes_iff.mp (by rw [hz']; exact hξ)
    have hsub : E' ⊆ closure {z'} := by
      rw [← hz]; exact specializes_iff_closure_subset.mp hz'z
    have hz'E : z' ∈ closure {z} := by
      rw [hz]
      exact hE'.2 isIrreducible_singleton.closure hsub (subset_closure (Set.mem_singleton z'))
    have hzz' : z ⤳ z' := specializes_iff_mem_closure.mpr hz'E
    rw [← hz', (hz'z.antisymm hzz').eq]

  have s2 : ∀ τ : Spec (.of ↥R) ⟶ Y, τ ≫ v = 𝟙 _ →
      (∃ W : Y.Opens, τ 𝔪 ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ v)) →
      ∀ E' ∈ irreducibleComponents ↥(Limits.pullback v j), τ 𝔪 ∈ closure (fK '' E') →
        τ η ∈ fK '' E' := by
    intro τ hτ hsm E' hE' hy
    obtain ⟨z, hz⟩ := genK E' hE'
    obtain ⟨ξ, hξ⟩ := smgen _ hsm
    have hzy : fK z ⤳ τ 𝔪 := specializes_iff_mem_closure.mpr (clK E' z hz hy)
    have hξz := maxgen E' hE' z hz ξ (hξ _ hzy)
    have hsy : τ η ⤳ τ 𝔪 := (hηall 𝔪).map τ.continuous
    have hzs : fK z ⤳ τ η := by rw [← hξz]; exact hξ _ hsy
    have hvs : v (τ η) = η := by rw [pt hτ η]; rfl
    obtain ⟨w, hw⟩ : τ η ∈ Set.range fK := by rw [hKrange]; exact hvs
    have hzw : z ⤳ w := hKemb.toIsInducing.specializes_iff.mp (by rw [hw]; exact hzs)
    exact ⟨w, by rw [← hz]; exact specializes_iff_mem_closure.mp hzw, hw⟩

  have reach : ∀ y : Y, v y = η → ∃ y', y ⤳ y' ∧ v y' = 𝔪 := by
    intro y hvy
    have hcl : IsClosed (v '' closure {y}) := v.isClosedMap _ isClosed_closure
    have h1 : v y ∈ v '' closure {y} := ⟨y, subset_closure (Set.mem_singleton y), rfl⟩
    rw [hvy] at h1
    obtain ⟨y', hy', hvy'⟩ := (hηall 𝔪).mem_closed hcl h1
    exact ⟨y', specializes_iff_mem_closure.mpr hy', hvy'⟩

  have hT : ∀ E' ∈ irreducibleComponents ↥(Limits.pullback v j),
      (∀ b, ¬ ∃ x ∈ E', ∃ q : ↥(Spec (.of K)), fK x = ε b (j q)) →
      f0 '' D₀ = closure (fK '' E') ∩ v ⁻¹' {𝔪} := by
    intro E' hE' hAF'
    have key : ∀ y₀, f0 y₀ ∈ closure (fK '' E') → y₀ ∈ D₀ ∧ f0 '' D₀ ⊆ closure (fK '' E') := by
      intro y₀ hy₀
      obtain ⟨D, hD, hy₀D, hDsub⟩ := s3 E' hE' y₀ hy₀
      by_cases hDD : D = D₀
      · rw [hDD] at hy₀D hDsub
        exact ⟨hy₀D, hDsub⟩
      · exfalso
        obtain ⟨b, hb⟩ := hother₀ D hD hDD
        have h1 : ε b 𝔪 ∈ f0 '' D := (M0 (ε b) D).mp hb
        have h2 := s2 (ε b) (hε1 b) (hε3 b 𝔪) E' hE' (hDsub h1)
        exact hAF' b ((MK (ε b) E').mpr h2)
    obtain ⟨z, hz⟩ := genK E' hE'
    obtain ⟨y, hzy, hvy⟩ := reach (fK z) (hvK z)
    obtain ⟨y₁, rfl⟩ : y ∈ Set.range f0 := by rw [h0range]; exact hvy
    have hzE : z ∈ E' := by rw [← hz]; exact subset_closure (Set.mem_singleton z)
    have hy₁ : f0 y₁ ∈ closure (fK '' E') :=
      hzy.mem_closed isClosed_closure (subset_closure ⟨z, hzE, rfl⟩)
    have hsub := (key y₁ hy₁).2
    ext y
    constructor
    · rintro ⟨y₀, hy₀, rfl⟩
      exact ⟨hsub ⟨y₀, hy₀, rfl⟩, hv0 y₀⟩
    · rintro ⟨hy, hvy'⟩
      obtain ⟨y₀, rfl⟩ : y ∈ Set.range f0 := by rw [h0range]; exact hvy'
      exact ⟨y₀, (key y₀ hy).1, rfl⟩

  obtain ⟨ξ₀, hξ₀⟩ : ∃ ξ₀, closure {ξ₀} = D₀ := by
    refine ⟨hD₀.1.genericPoint, ?_⟩
    have h1 := hD₀.1.isGenericPoint_genericPoint_closure
    rw [(isClosed_of_mem_irreducibleComponents D₀ hD₀).closure_eq] at h1
    exact h1
  obtain ⟨ζ, hζ⟩ := s1 D₀ hD₀ ξ₀ hξ₀
  have G4 : ∀ E' ∈ irreducibleComponents ↥(Limits.pullback v j), ∀ z, closure {z} = E' →
      f0 ξ₀ ∈ closure (fK '' E') → ζ = fK z := by
    intro E' hE' z hz h
    have hzξ : fK z ⤳ f0 ξ₀ := specializes_iff_mem_closure.mpr (clK E' z hz h)
    exact maxgen E' hE' z hz ζ (hζ _ hzξ)
  have G4' : ∀ E₁ ∈ irreducibleComponents ↥(Limits.pullback v j),
      ∀ E₂ ∈ irreducibleComponents ↥(Limits.pullback v j),
      f0 ξ₀ ∈ closure (fK '' E₁) → f0 ξ₀ ∈ closure (fK '' E₂) → E₁ = E₂ := by
    intro E₁ hE₁ E₂ hE₂ h1 h2
    obtain ⟨z₁, hz₁⟩ := genK E₁ hE₁
    obtain ⟨z₂, hz₂⟩ := genK E₂ hE₂
    have e := hfKinj ((G4 E₁ hE₁ z₁ hz₁ h1).symm.trans (G4 E₂ hE₂ z₂ hz₂ h2))
    rw [← hz₁, ← hz₂, e]
  have hξ₀D : ξ₀ ∈ D₀ := by rw [← hξ₀]; exact subset_closure (Set.mem_singleton _)
  have hTE := hT E hE hAF
  have hξE : f0 ξ₀ ∈ closure (fK '' E) := by
    have h1 : f0 ξ₀ ∈ f0 '' D₀ := ⟨ξ₀, hξ₀D, rfl⟩
    rw [hTE] at h1
    exact h1.1

  have G5 : ∀ E' : Set ↥(Limits.pullback v j), E' ∈ irreducibleComponents ↥(Limits.pullback v j) →
      (∀ b, ¬ ∃ x ∈ E', ∃ q : ↥(Spec (.of K)), fK x = ε b (j q)) → E' = E := by
    intro E' hE' hAF'
    have h1 : f0 ξ₀ ∈ closure (fK '' E') := by
      have h2 : f0 ξ₀ ∈ f0 '' D₀ := ⟨ξ₀, hξ₀D, rfl⟩
      rw [hT E' hE' hAF'] at h2
      exact h2.1
    exact G4' E' hE' E hE h1 hξE

  have G6 : ∀ i : Fin (k + 1), (∃ x ∈ E, ∃ q : ↥(Spec (.of K)), fK x = σ i (j q)) ↔
      (∃ x ∈ D₀, ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥R))), f0 x = σ i (c q)) := by
    intro i
    rw [MK (σ i) E, M0 (σ i) D₀]
    constructor
    · intro h
      have h1 : σ i 𝔪 ∈ closure (fK '' E) :=
        ((hηall 𝔪).map (σ i).continuous).mem_closed isClosed_closure (subset_closure h)
      have h2 : σ i 𝔪 ∈ closure (fK '' E) ∩ v ⁻¹' {𝔪} := ⟨h1, hvσ i 𝔪⟩
      rw [← hTE] at h2
      exact h2
    · intro h
      have h1 : σ i 𝔪 ∈ closure (fK '' E) := by
        rw [hTE] at h
        exact h.1
      exact s2 (σ i) (hS1 i) (hS3 i 𝔪) E hE h1
  have hlastE := (G6 (Fin.last k)).mpr hlast₀
  have hMk : Nat.card {i : Fin k // ∃ x ∈ E, ∃ q : ↥(Spec (.of K)),
        fK x = σ (Fin.castSucc i) (j q)} =
      Nat.card {i : Fin k // ∃ x ∈ D₀, ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥R))),
        f0 x = σ (Fin.castSucc i) (c q)} :=
    Nat.card_congr (Equiv.subtypeEquivRight (fun i => G6 (Fin.castSucc i)))

  have hP1E := s4 E hE D₀ hD₀ hP1₀ hTE

  have hclEc : ∀ n ∈ closure Eᶜ, ∃ E' ∈ irreducibleComponents ↥(Limits.pullback v j),
      E' ≠ E ∧ n ∈ E' := by
    intro n hn
    have hU : IsClosed (⋃ E' ∈ {E' | E' ∈ irreducibleComponents ↥(Limits.pullback v j) ∧ E' ≠ E},
        E') :=
      (hfinK.subset (fun E' hE' => hE'.1)).isClosed_biUnion
        (fun E' hE' => isClosed_of_mem_irreducibleComponents E' hE'.1)
    have hsubU : Eᶜ ⊆
        ⋃ E' ∈ {E' | E' ∈ irreducibleComponents ↥(Limits.pullback v j) ∧ E' ≠ E}, E' := by
      intro y hy
      obtain ⟨E'', hE'', hyE''⟩ :=
        exists_mem_irreducibleComponents_subset_of_isIrreducible {y} isIrreducible_singleton
      refine Set.mem_biUnion (x := E'') ⟨hE'', ?_⟩ (hyE'' (Set.mem_singleton y))
      intro h
      rw [h] at hyE''
      exact hy (hyE'' (Set.mem_singleton y))
    have hnU := closure_minimal hsubU hU hn
    obtain ⟨E', ⟨hE'c, hE'ne⟩, hnE'⟩ := Set.mem_iUnion₂.mp hnU
    exact ⟨E', hE'c, hE'ne, hnE'⟩
  choose ρ hρ1 hρ2 using fun n : ↥(Limits.pullback v j) => reach (fK n) (hvK n)
  have hφex : ∀ n, ∃ y, f0 y = ρ n := by
    intro n
    have h : ρ n ∈ Set.range f0 := by rw [h0range]; exact hρ2 n
    exact h
  choose φ hφ using hφex
  have hmaps : ∀ n ∈ E ∩ closure Eᶜ, φ n ∈ D₀ ∩ closure D₀ᶜ := by
    rintro n ⟨hnE, hncl⟩
    have hρcl : ∀ E' : Set ↥(Limits.pullback v j), n ∈ E' → f0 (φ n) ∈ closure (fK '' E') := by
      intro E' hnE'
      rw [hφ n]
      exact (hρ1 n).mem_closed isClosed_closure (subset_closure ⟨n, hnE', rfl⟩)
    refine ⟨?_, ?_⟩
    · have h1 : f0 (φ n) ∈ f0 '' D₀ := by
        rw [hTE]
        exact ⟨hρcl E hnE, hv0 (φ n)⟩
      obtain ⟨y, hy, hyeq⟩ := h1
      rw [← hf0inj hyeq]
      exact hy
    · obtain ⟨E', hE'c, hE'ne, hnE'⟩ := hclEc n hncl
      obtain ⟨D', hD', hφD', hD'sub⟩ := s3 E' hE'c (φ n) (hρcl E' hnE')
      have hD'ne : D' ≠ D₀ := by
        intro h
        rw [h] at hD'sub
        exact hE'ne (G4' E' hE'c E hE (hD'sub ⟨ξ₀, hξ₀D, rfl⟩) hξE)
      by_contra hncl'
      have hU : IsOpen (closure D₀ᶜ)ᶜ := isClosed_closure.isOpen_compl
      have hO : IsOpen D₀ᶜ := (isClosed_of_mem_irreducibleComponents D₀ hD₀).isOpen_compl
      have hne1 : (D' ∩ (closure D₀ᶜ)ᶜ).Nonempty := ⟨φ n, hφD', hncl'⟩
      have hne2 : (D' ∩ D₀ᶜ).Nonempty := by
        by_contra hemp
        have hsub : D' ⊆ D₀ := by
          intro x hx
          by_contra hx'
          exact hemp ⟨x, hx, hx'⟩
        exact hD'ne (Set.Subset.antisymm hsub (hD'.2 hD₀.1 hsub))
      obtain ⟨x, _, hxU, hxO⟩ := hD'.1.2 _ _ hU hO hne1 hne2
      exact hxU (subset_closure hxO)
  have hinj : Set.InjOn φ (E ∩ closure Eᶜ) := by
    intro n₁ hn₁ n₂ hn₂ heq
    have e : ρ n₁ = ρ n₂ := by rw [← hφ n₁, ← hφ n₂, heq]
    exact s6 E hE n₁ hn₁ n₂ hn₂ (ρ n₁) (hρ2 n₁) (hρ1 n₁) (by rw [e]; exact hρ1 n₂)
  have hS₀fin : (D₀ ∩ closure D₀ᶜ).Finite := Set.finite_of_ncard_ne_zero (by omega)
  have hNd : (E ∩ closure Eᶜ).ncard ≤ (D₀ ∩ closure D₀ᶜ).ncard :=
    Set.ncard_le_ncard_of_injOn φ hmaps hinj hS₀fin

  have hstab : 3 ≤ (E ∩ closure Eᶜ).ncard +
      Nat.card {i : Fin (k + 1) // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)), fK x = σ i (j p)} :=
    hst.2.2 K j E hE hP1E
  have hsplit : Nat.card {i : Fin (k + 1) // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)), fK x = σ i (j p)} =
      Nat.card {i : Fin k // ∃ x ∈ E, ∃ q : ↥(Spec (.of K)),
        fK x = σ (Fin.castSucc i) (j q)} + 1 := by
    rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card, Fintype.card_subtype,
      Fintype.card_subtype, Finset.card_filter, Finset.card_filter, Fin.sum_univ_castSucc,
      if_pos hlastE]
  refine ⟨hP1E, hlastE, ?_, ?_, G5⟩
  · omega
  · omega

theorem wcpa_dj_lfc_af_classify : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (k : ℕ)
    (σ : Fin (k + 1) → (Spec (.of ↥W) ⟶ Z₁)) (r : ℕ) (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁))
    (E₀ : Set ↥(Limits.pullback u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))),
    wcpaDjStablePtd u₁ (k + 1) σ →
    wcpaDjSections u₁ (k + 1 + r) (Fin.append σ ε) →
    E₀ ∈ irreducibleComponents ↥(Limits.pullback u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) →
    (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
      (θ : Er ≅ @Proj _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W))
        MvPolynomial.gradedAlgebra),
      IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E₀ ∧
      θ.hom ≫ @Proj.toSpecZero _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W))
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap (IsLocalRing.ResidueField ↥W)
            ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W) 0))) =
      ι ≫ Limits.pullback.snd u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) →
    (∃ x ∈ E₀, ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
      Limits.pullback.fst u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x =
      σ (Fin.last k)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q)) →
    (E₀ ∩ closure E₀ᶜ).ncard + Nat.card {i : Fin k // ∃ x ∈ E₀,
      ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
      Limits.pullback.fst u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x =
      σ (Fin.castSucc i)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q)} ≤ 2 →
    (E₀ ∩ closure E₀ᶜ).Nonempty →
    (∀ b, ¬ ∃ x ∈ E₀, ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
      Limits.pullback.fst u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x =
      ε b (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q)) →
    (∀ E ∈ irreducibleComponents ↥(Limits.pullback u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
      E ≠ E₀ → ∃ b, ∃ x ∈ E, ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
        Limits.pullback.fst u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x =
        ε b (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q)) →
    (∀ (K : Type u) [Field K] [IsAlgClosed K] (t' : Spec (.of K) ⟶ Spec (.of Ω))
      (E : Set ↥(Limits.pullback u₁ (t' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))))),
      E ∈ irreducibleComponents
        ↥(Limits.pullback u₁ (t' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))) →
      (∃ (Er : Scheme.{u})
        (ι : Er ⟶ Limits.pullback u₁ (t' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))))
        (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra),
        IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
        θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
        ι ≫ Limits.pullback.snd u₁ (t' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))) →
      3 ≤ (E ∩ closure Eᶜ).ncard + Nat.card {i : Fin k // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
        Limits.pullback.fst u₁ (t' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) x =
          σ (Fin.castSucc i) ((t' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) p)}) →
    ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Spec (.of ↥W)),
      (∀ E : Set ↥(Limits.pullback u₁ s), E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
        (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback u₁ s)
          (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
          ι ≫ Limits.pullback.snd u₁ s) →
        (∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = σ (Fin.last k) (s q)) →
        (E ∩ closure Eᶜ).ncard + Nat.card {i : Fin k // ∃ x ∈ E, ∃ q : ↥(Spec (.of K)),
          Limits.pullback.fst u₁ s x = σ (Fin.castSucc i) (s q)} ≤ 2 →
        (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q))) ∧
      (∀ E : Set ↥(Limits.pullback u₁ s), E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
        (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) →
        (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback u₁ s)
          (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
          ι ≫ Limits.pullback.snd u₁ s) ∧
        (∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = σ (Fin.last k) (s q)) ∧
        (E ∩ closure Eᶜ).ncard + Nat.card {i : Fin k // ∃ x ∈ E, ∃ q : ↥(Spec (.of K)),
          Limits.pullback.fst u₁ s x = σ (Fin.castSucc i) (s q)} = 2 ∧
        1 ≤ (E ∩ closure Eᶜ).ncard ∧
        (∀ E' : Set ↥(Limits.pullback u₁ s), E' ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
          (∀ b, ¬ ∃ x ∈ E', ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) →
          E' = E) ∧
        ∀ t' : Spec (.of K) ⟶ Spec (.of Ω),
          s ≠ t' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) :=
by
  intro Ω _ _ W Z₁ u₁ k σ r ε E₀ hst hsec hE₀ hP1₀ hp₀ hcnt₀ hnode havoid hcov gen K _ _ s
  classical
  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]

  have spu : ∀ (X P V C : Scheme.{u}) (f : X ⟶ P) (b : V ⟶ P)
      (ψ : C ⟶ X) (g : C ⟶ V) (σ : P ⟶ X) (τ : V ⟶ C), IsPullback ψ g f b → σ ≫ f = 𝟙 P →
      τ ≫ g = 𝟙 V → τ ≫ ψ = b ≫ σ → ∀ c : C, ψ c = σ (b (g c)) ↔ c = τ (g c) := by
    intro X P V C f b ψ g σ τ H1 H2 H3 H4 c
    have hcomp : ∀ x : V, ψ (τ x) = σ (b x) := by
      intro x
      rw [← Scheme.Hom.comp_apply, H4, Scheme.Hom.comp_apply]
    have hgτ : ∀ x : V, g (τ x) = x := by
      intro x
      rw [← Scheme.Hom.comp_apply, H3]
      rfl
    constructor
    · intro h
      have hout : IsPullback (τ ≫ g) b b (σ ≫ f) := by
        rw [H3, H2]
        exact IsPullback.id_horiz b
      have hsq : IsPullback τ b ψ σ := IsPullback.of_right hout H4 H1.flip
      obtain ⟨p, hp, _⟩ := Scheme.exists_preimage_of_isPullback hsq c (b (g c)) h
      have hg : g c = p := by rw [← hp, hgτ]
      rw [hg, hp]
    · intro h
      calc ψ c = ψ (τ (g c)) := congrArg ψ h
        _ = σ (b (g c)) := hcomp (g c)

  have comp_homeo : ∀ {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y] (h : X ≃ₜ Y)
      (E : Set X), E ∈ irreducibleComponents X → h '' E ∈ irreducibleComponents Y := by
    intro X Y _ _ h E hE
    refine image_mem_irreducibleComponents_of_isPreirreducible_fiber h h.continuous h.isOpenMap
      ?_ h.surjective hE
    intro y
    apply Set.Subsingleton.isPreirreducible
    intro a ha a' ha'
    exact h.injective (ha.trans ha'.symm)
  have hss : ∀ {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y] (h : X ≃ₜ Y)
      (A : Set Y), h '' (h.symm '' A) = A := by
    intro X Y _ _ h A
    ext y
    constructor
    · rintro ⟨x, ⟨z, hz, rfl⟩, rfl⟩
      rwa [Homeomorph.apply_symm_apply]
    · intro hy
      exact ⟨h.symm y, ⟨y, hy, rfl⟩, Homeomorph.apply_symm_apply h y⟩

  have resAC : ∀ (L : Type u) [Field L] [IsAlgClosed L] (V : ValuationSubring L),
      IsAlgClosed (IsLocalRing.ResidueField ↥V) := by
    intro L _ _ V
    apply IsAlgClosed.of_exists_root
    intro p hmon hirr
    obtain ⟨q, hqmap, hqdeg, hqmon⟩ := Polynomial.lifts_and_degree_eq_and_monic
      ((Polynomial.mem_lifts p).mpr
        (Polynomial.map_surjective (IsLocalRing.residue ↥V) IsLocalRing.residue_surjective p)) hmon
    have hdeg : (q.map (algebraMap ↥V L)).degree ≠ 0 := by
      rw [Polynomial.degree_map_eq_of_injective (IsFractionRing.injective ↥V L), hqdeg]
      exact (Polynomial.degree_pos_of_irreducible hirr).ne'
    obtain ⟨θ, hθ⟩ := IsAlgClosed.exists_root _ hdeg
    have hint : IsIntegral ↥V θ := ⟨q, hqmon, by rw [← Polynomial.eval_map]; exact hθ⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    refine ⟨IsLocalRing.residue ↥V y, ?_⟩
    have hq0 : Polynomial.eval y q = 0 := by
      apply IsFractionRing.injective ↥V L
      rw [map_zero, ← Polynomial.eval₂_at_apply, hy, ← Polynomial.eval_map]
      exact hθ
    rw [← hqmap, Polynomial.eval_map, Polynomial.eval₂_at_apply, hq0, map_zero]
  haveI hκ : IsAlgClosed (IsLocalRing.ResidueField ↥W) := resAC Ω W

  have bct : ∀ {Z T T' : Scheme.{u}} (uu : Z ⟶ T) (b : T' ⟶ T) (L : Type u) [Field L]
      (s' : Spec (.of L) ⟶ T') (t : Spec (.of L) ⟶ T), s' ≫ b = t →
      ∃ h : ↥(Limits.pullback (Limits.pullback.snd uu b) s') ≃ₜ ↥(Limits.pullback uu t),
        (∀ E, E ∈ irreducibleComponents ↥(Limits.pullback (Limits.pullback.snd uu b) s') ↔
          h '' E ∈ irreducibleComponents ↥(Limits.pullback uu t)) ∧
        (∀ E, (h '' E ∩ closure (h '' E)ᶜ).ncard = (E ∩ closure Eᶜ).ncard) ∧
        (∀ E, (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback (Limits.pullback.snd uu b) s')
            (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) L)
              MvPolynomial.gradedAlgebra),
            IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
            θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) L)
              MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
                (algebraMap L ↥(MvPolynomial.homogeneousSubmodule (Fin 2) L 0))) =
            ι ≫ Limits.pullback.snd (Limits.pullback.snd uu b) s') ↔
          (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback uu t)
            (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) L)
              MvPolynomial.gradedAlgebra),
            IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = h '' E ∧
            θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) L)
              MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
                (algebraMap L ↥(MvPolynomial.homogeneousSubmodule (Fin 2) L 0))) =
            ι ≫ Limits.pullback.snd uu t)) ∧
        (∀ (τ : T ⟶ Z) (τ' : T' ⟶ Limits.pullback uu b), τ ≫ uu = 𝟙 T →
          τ' ≫ Limits.pullback.snd uu b = 𝟙 T' → τ' ≫ Limits.pullback.fst uu b = b ≫ τ →
          ∀ E, (∃ x ∈ E, ∃ q : ↥(Spec (.of L)),
              Limits.pullback.fst (Limits.pullback.snd uu b) s' x = τ' (s' q)) ↔
            (∃ y ∈ h '' E, ∃ q : ↥(Spec (.of L)), Limits.pullback.fst uu t y = τ (t q))) := by
    intro Z T T' uu b L _ s' t hst'
    subst hst'
    have hpb : IsPullback (Limits.pullback.fst uu b) (Limits.pullback.snd uu b) uu b :=
      IsPullback.of_hasPullback uu b
    obtain ⟨e, I1, I2⟩ : ∃ e : Limits.pullback (Limits.pullback.snd uu b) s' ≅
        Limits.pullback uu (s' ≫ b),
        e.hom ≫ Limits.pullback.fst uu (s' ≫ b) =
          Limits.pullback.fst (Limits.pullback.snd uu b) s' ≫ Limits.pullback.fst uu b ∧
        e.hom ≫ Limits.pullback.snd uu (s' ≫ b) =
          Limits.pullback.snd (Limits.pullback.snd uu b) s' :=
      ⟨_, Limits.pullbackLeftPullbackSndIso_hom_fst uu b s',
        Limits.pullbackLeftPullbackSndIso_hom_snd uu b s'⟩
    have I3 : e.inv ≫ Limits.pullback.snd (Limits.pullback.snd uu b) s' =
        Limits.pullback.snd uu (s' ≫ b) := by
      rw [← I2, ← Category.assoc, e.inv_hom_id, Category.id_comp]
    obtain ⟨h, hh⟩ : ∃ h : ↥(Limits.pullback (Limits.pullback.snd uu b) s') ≃ₜ
        ↥(Limits.pullback uu (s' ≫ b)), ∀ x, h x = e.hom x :=
      ⟨Scheme.homeoOfIso e, Scheme.homeoOfIso_apply e⟩
    have hinv : ∀ y, e.inv y = h.symm y := by
      intro y
      apply h.injective
      rw [Homeomorph.apply_symm_apply, hh, ← Scheme.Hom.comp_apply, e.inv_hom_id]
      rfl
    have hsi : ∀ A : Set ↥(Limits.pullback (Limits.pullback.snd uu b) s'),
        h.symm '' (h '' A) = A := by
      intro A
      rw [Set.image_image]
      simp
    have hcnt : ∀ E : Set ↥(Limits.pullback (Limits.pullback.snd uu b) s'),
        (h '' E ∩ closure (h '' E)ᶜ).ncard = (E ∩ closure Eᶜ).ncard := by
      intro E
      rw [← h.image_compl, ← h.image_closure, ← Set.image_inter h.injective]
      exact Set.ncard_image_of_injective _ h.injective
    refine ⟨h, ?_, hcnt, ?_, ?_⟩
    · intro E
      constructor
      · exact comp_homeo h E
      · intro hE'
        have := comp_homeo h.symm (h '' E) hE'
        rwa [hsi] at this
    · intro E
      constructor
      · intro hdat
        obtain ⟨Er, ι, θ, hci, hred, hrange, hθ⟩ := hdat
        refine ⟨Er, ι ≫ e.hom, θ, inferInstance, hred, ?_, ?_⟩
        · ext y
          constructor
          · rintro ⟨x, rfl⟩
            refine ⟨ι x, ?_, ?_⟩
            · rw [← hrange]; exact ⟨x, rfl⟩
            · rw [hh, Scheme.Hom.comp_apply]
          · rintro ⟨z, hz, rfl⟩
            rw [← hrange] at hz
            obtain ⟨x, rfl⟩ := hz
            exact ⟨x, by rw [hh, Scheme.Hom.comp_apply]⟩
        · rw [hθ, Category.assoc, I2]
      · intro hdat
        obtain ⟨Er, ι, θ, hci, hred, hrange, hθ⟩ := hdat
        refine ⟨Er, ι ≫ e.inv, θ, inferInstance, hred, ?_, ?_⟩
        · ext x
