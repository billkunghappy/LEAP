      have hE : E (s.orderEmbOfFin hs) (v (Finset.univ.map (s.orderEmbOfFin hs).toEmbedding) 0) = 0 :=
        (AddEquiv.map_eq_zero_iff _).mp ha
      have hC : v (Finset.univ.map (s.orderEmbOfFin hs).toEmbedding) ∈
