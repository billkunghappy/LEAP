    have h10 : PowerSeries.X ^ 2 ∣ θ₁ g₀ := (hE₁ g₀ 2).mp (hg₀b β₁ hβ₁ hne)
    have h01 : PowerSeries.X ^ 2 ∣ θ₀ g₁ := (hE₀ g₁ 2).mp (hg₁b β₀ hβ₀ hne.symm)
    have h11 : ¬ PowerSeries.X ^ 2 ∣ θ₁ g₁ := fun h => hg₁a ((hE₁ g₁ 2).mpr h)

    have hsq : ∀ θ : C.presheaf.stalk x →+* PowerSeries K,
