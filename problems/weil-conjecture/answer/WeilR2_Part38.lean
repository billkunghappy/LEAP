        (Y.residue (f η) |>.hom (Y.presheaf.stalkSpecializes h |>.hom a)) = 0 := by
      have := congrArg (fun g => g.hom (Y.presheaf.stalkSpecializes h |>.hom a))
        (Scheme.residue_residueFieldMap f η)
