      (by rw [← hGn E', MkG E']; exact hcnt)
    intro bb hbb
    exact hAF' bb ((hGm _ _ (hε1 bb) (hεR1 bb) (hεR2 bb) E').mpr hbb)
  ·
    intro E hE hAF
    obtain ⟨E', rfl⟩ : ∃ E', E = hG '' E' := ⟨hG.symm '' E, (hss hG E).symm⟩
    have hAF' : ∀ bb, ¬ ∃ x ∈ E', ∃ q : ↥(Spec (.of K)),
        Limits.pullback.fst (Limits.pullback.snd u₁ bR)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) x =
        εR bb (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) q) :=
      fun bb hbb => hAF bb ((hGm _ _ (hε1 bb) (hεR1 bb) (hεR2 bb) E').mp hbb)
    obtain ⟨hP1', hp', hsum', hnd', huniq'⟩ := wcpa_dj_lfc_afc_core_af K R hκR _
      (Limits.pullback.snd u₁ bR) k σR r εR D₀ hstR hsecR hD₀comp hD₀P1 hD₀last hD₀cnt hD₀nd1
      hD₀AF hD₀other E' ((hGc E').mpr hE) hAF'
    have hsum : ((hG '' E') ∩ closure (hG '' E')ᶜ).ncard +
        Nat.card {i : Fin k // ∃ x ∈ hG '' E', ∃ q : ↥(Spec (.of K)),
          Limits.pullback.fst u₁ s x = σ (Fin.castSucc i) (s q)} = 2 := by
      rw [hGn E', ← MkG E']
      exact hsum'
    have hP1 := (hGp E').mp hP1'
    refine ⟨hP1, (hGm _ _ (hσ1 _) (hσR1 _) (hσR2 _) E').mp hp', hsum,
      by rw [hGn E']; exact hnd', ?_, ?_⟩
    · intro E'' hE'' hAF''
      obtain ⟨E''', rfl⟩ : ∃ E''', E'' = hG '' E''' :=
        ⟨hG.symm '' E'', (hss hG E'').symm⟩
      congr 1
      exact huniq' E''' ((hGc E''').mpr hE'')
        (fun bb hbb => hAF'' bb ((hGm _ _ (hε1 bb) (hεR1 bb) (hεR2 bb) E''').mp hbb))
    · intro t' ht'
      subst ht'
      have h3 := gen K t' (hG '' E') hE hP1
      omega

theorem wcpa_dj_lge_cf_transport : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (r : ℕ)
    (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁)) (L : wcpaDjCoc Z₁)
    (t : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)),
    IsAlgClosed (IsLocalRing.ResidueField ↥W) →
    wcpaDjSemistable u₁ → wcpaDjSections u₁ r ε → wcpaDjCocOK L →
    wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) 1 t →
    (∀ a, (Z₁.basicOpen (t a) : Set Z₁) =
      ((L.V a ⊓ u₁ ⁻¹ᵁ ⊤ : Z₁.Opens) : Set Z₁) \ ⋃ i, Set.range ⇑(ε i)) →
    wcpaLccHAF u₁ ε →
    ∃ (ε₀ : Fin r → (Spec (.of (IsLocalRing.ResidueField ↥W)) ⟶ Limits.pullback u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))))
      (t₀ : ∀ a : Fin L.m, Γ(Limits.pullback u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))),
        (wcpaDjCocPull (Limits.pullback.fst u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L).V a ⊓
        Limits.pullback.snd u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ⁻¹ᵁ ⊤)),
      wcpaDjSemistable (Limits.pullback.snd u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ∧
      wcpaDjSections (Limits.pullback.snd u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) r ε₀ ∧
      wcpaDjCocOK (wcpaDjCocPull (Limits.pullback.fst u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L) ∧
      wcpaDjCompat (wcpaDjCocPull (Limits.pullback.fst u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L)
        (Limits.pullback.snd u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ⁻¹ᵁ ⊤)
        1 t₀ ∧
      (∀ a, ((Limits.pullback u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).basicOpen
            (t₀ a) : Set ↥(Limits.pullback u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) =
        (((wcpaDjCocPull (Limits.pullback.fst u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L).V a ⊓
          Limits.pullback.snd u₁
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ⁻¹ᵁ ⊤ :
            (Limits.pullback u₁
              (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).Opens) :
          Set ↥(Limits.pullback u₁
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) \
          ⋃ i, Set.range ⇑(ε₀ i)) ∧
      (∀ E ∈ irreducibleComponents ↥(Limits.pullback u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
        (∀ b, ε₀ b (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) ∉ E) →
        ∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback u₁
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
          (θ : Er ≅ @Proj _ _ _ _ _
            (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W))
            MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _
            (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W))
            MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
              (algebraMap (IsLocalRing.ResidueField ↥W)
                ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W) 0))) =
          ι ≫ Limits.pullback.snd u₁
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ∧
      (∀ E ∈ irreducibleComponents ↥(Limits.pullback u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
        ∀ E' ∈ irreducibleComponents ↥(Limits.pullback u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
        (∀ b, ε₀ b (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) ∉ E) →
        (∀ b, ε₀ b (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) ∉ E') → E = E') :=
by
  intro Ω _ _ W Z₁ u₁ r ε L t hκ hss hsec hOK hcompat hbo hAF
  classical


  have ss_bc : ∀ (M P'' Z : Scheme.{u}) (φ : P'' ⟶ M) (u : Z ⟶ M),
      wcpaDjSemistable u → wcpaDjSemistable (Limits.pullback.snd u φ) := by
    have hcomap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
        (σ : A ≃+* B) (n : ℕ), IsLocalRing.maximalIdeal A ^ n ≤
          Ideal.comap (σ : A →+* B) (IsLocalRing.maximalIdeal B ^ n) := by
      intro A B _ _ _ _ σ n
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
      apply Ideal.pow_right_mono
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
      intro h
      exact hx ((MulEquiv.isUnit_map (σ : A ≃* B)).mp h)
    have hfac : ∀ (A : Type u) [CommRing A] (I : Ideal A) (m n : ℕ) (h : m ≤ n)
        (x : AdicCompletion I A),
        Ideal.Quotient.factorPow I h (AdicCompletion.evalₐ I n x) =
          AdicCompletion.evalₐ I m x := by
      intro A _ I m n h x
      obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective I A x
      rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk, Ideal.Quotient.factorPow,
        Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
      have := (Submodule.Quotient.eq _).mp (AdicCompletion.AdicCauchySequence.mk_eq_mk h c)
      simpa [smul_eq_mul, Ideal.mul_top] using this
    have hmap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
        (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
          AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ (n : ℕ) x (a : A),
          AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
          AdicCompletion.evalₐ _ n (Φ x) = Ideal.Quotient.mk _ (σ a) := by
      intro A B _ _ _ _ σ
      let f : ∀ n : ℕ, AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
          B ⧸ IsLocalRing.maximalIdeal B ^ n := fun n =>
        (Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)).comp
          (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom
      have hf : ∀ (n : ℕ) x (a : A), AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
          f n x = Ideal.Quotient.mk _ (σ a) := by
        intro n x a ha
        show Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)
          (AdicCompletion.evalₐ _ n x) = _
        rw [ha, Ideal.quotientMap_mk]
        rfl
      have hcompat : ∀ {m n : ℕ} (hle : m ≤ n),
          (Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal B) hle).comp (f n) = f m := by
        intro m n hle
        ext x
        obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n x)
        have ha' : AdicCompletion.evalₐ _ m x = Ideal.Quotient.mk _ a := by
          rw [← hfac A _ m n hle x, ← ha, Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
        rw [RingHom.comp_apply, hf n x a ha.symm, hf m x a ha', Ideal.Quotient.factorPow,
          Ideal.Quotient.factor_mk]
      refine ⟨AdicCompletion.liftRingHom _ f hcompat, ?_⟩
      intro n x a ha
      rw [AdicCompletion.evalₐ_liftRingHom]
      exact hf n x a ha
    have s1 : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
        (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
          AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ a : A,
          Φ (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) =
            algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (σ a) := by
      intro A B _ _ _ _ σ
      obtain ⟨Φ, hΦ⟩ := hmap A B σ
      obtain ⟨Ψ, hΨ⟩ := hmap B A σ.symm
      have h1 : Φ.comp Ψ = RingHom.id _ := by
        ext1 y
        apply AdicCompletion.ext_evalₐ
        intro n
        obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
        rw [RingHom.comp_apply, hΦ n _ _ (hΨ n y b hb.symm), RingEquiv.apply_symm_apply,
          RingHom.id_apply, hb]
      have h2 : Ψ.comp Φ = RingHom.id _ := by
        ext1 y
        apply AdicCompletion.ext_evalₐ
        intro n
        obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
        rw [RingHom.comp_apply, hΨ n _ _ (hΦ n y b hb.symm), RingEquiv.symm_apply_apply,
          RingHom.id_apply, hb]
      refine ⟨RingEquiv.ofRingHom Φ Ψ h1 h2, ?_⟩
      intro a
      apply AdicCompletion.ext_evalₐ
      intro n
      have hof : ∀ (R : Type u) [CommRing R] (I : Ideal R) (r : R),
          AdicCompletion.evalₐ I n (algebraMap R (AdicCompletion I R) r) =
            Ideal.Quotient.mk _ r := by
        intro R _ I r
        rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of, Algebra.algebraMap_self,
          RingHom.id_apply]
      show AdicCompletion.evalₐ _ n (Φ _) = _
      rw [hΦ n _ a (hof A _ a), hof B _ (σ a)]
    have s2 : ∀ (K : Type u) [Field K] {X Y : Scheme.{u}} (i : X ⟶ Y) (p : X ⟶ Spec (.of K))
        (q : Y ⟶ Spec (.of K)), i ≫ q = p → ∀ x : X,
        ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ Y.presheaf.germ ⊤ (i x) trivial) ≫
          i.stalkMap x =
        (Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ x trivial := by
      intro K _ X Y i p q hi x
      have key : Y.presheaf.germ ⊤ (i x) trivial ≫ i.stalkMap x =
          i.appTop ≫ X.presheaf.germ ⊤ x trivial := Scheme.Hom.germ_stalkMap i ⊤ x trivial
      rw [← hi, Scheme.Hom.comp_appTop]
      simp only [Category.assoc]
      exact congrArg (fun t => (Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ t) key
    have s3 : ∀ {X Y S : Scheme.{u}} (i : X ⟶ Y) [IsIso i] (p : X ⟶ S) (q : Y ⟶ S), i ≫ q = p →
        ∀ (W' : Y.Opens), SmoothOfRelativeDimension 1 (W'.ι ≫ q) →
          SmoothOfRelativeDimension 1 ((i ⁻¹ᵁ W').ι ≫ p) := by
      intro X Y S i _ p q hi W' hW'
      have hfac' : (i ⁻¹ᵁ W').ι ≫ p = (i ∣_ W') ≫ (W'.ι ≫ q) := by
        rw [← hi, ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
      have hpb : IsPullback (i ∣_ W') ((i ∣_ W') ≫ (W'.ι ≫ q)) (W'.ι ≫ q) (𝟙 S) :=
        IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id]⟩
      rw [hfac']
      exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hW'
    intro M P'' Z φ u hss
    obtain ⟨hflat, hprop, hfib⟩ := hss
    haveI := hflat
    haveI := hprop
    refine ⟨inferInstance, inferInstance, ?_⟩
    intro K _ _ s w
    set i := (Limits.pullbackLeftPullbackSndIso u φ s).hom with hi_def
    have hi : i ≫ Limits.pullback.snd u (s ≫ φ) =
        Limits.pullback.snd (Limits.pullback.snd u φ) s :=
      Limits.pullbackLeftPullbackSndIso_hom_snd u φ s
    rcases hfib K (s ≫ φ) (i w) with ⟨W', hw', hsm⟩ | ⟨e₀, he₀⟩
    · left
      refine ⟨i ⁻¹ᵁ W', hw', ?_⟩
      exact s3 i _ _ hi W' hsm
    · right
      let τ := Iso.commRingCatIsoToRingEquiv (asIso (i.stalkMap w))
      obtain ⟨Φ, hΦ⟩ := s1 _ _ τ.symm
      refine ⟨Φ.trans e₀, ?_⟩
      have h2 := s2 K i _ _ hi w
      ext1 k
      have hk : τ.symm (((Scheme.ΓSpecIso (.of K)).inv ≫
          (Limits.pullback.snd (Limits.pullback.snd u φ) s).appTop ≫
          (Limits.pullback (Limits.pullback.snd u φ) s).presheaf.germ ⊤ w trivial).hom k) =
          ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd u (s ≫ φ)).appTop ≫
          (Limits.pullback u (s ≫ φ)).presheaf.germ ⊤ (i w) trivial).hom k := by
        rw [← h2, RingEquiv.symm_apply_eq]
        rfl
      have := RingHom.congr_fun he₀ k
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]
        at this ⊢
      rw [RingEquiv.trans_apply, hΦ, hk]
      exact this

  have hpull : ∀ {Y' Y : Scheme.{u}} (h : Y' ⟶ Y) (U : Y.Opens) (V V' : Y'.Opens)
      (h1 : V' ≤ h ⁻¹ᵁ U) (h2 : V ≤ V') (x : Γ(Y, U)),
      (Y'.presheaf.map (homOfLE h2).op).hom ((Y'.presheaf.map (homOfLE h1).op).hom
        ((h.app U).hom x)) = (h.appLE U V (h2.trans h1)).hom x := by
    intro Y' Y h U V V' h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp, Scheme.Hom.appLE,
      ← CommRingCat.comp_apply]
    rfl

  have compat_pull : ∀ {Y' Y : Scheme.{u}} (h : Y' ⟶ Y) (L : wcpaDjCoc Y) (O : Y.Opens)
      (O' : Y'.Opens) (hO : O' ≤ h ⁻¹ᵁ O) (t : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ O)),
      wcpaDjCompat L O 1 t → wcpaDjCompat (wcpaDjCocPull h L) O' 1
        (fun a => (h.appLE (L.V a ⊓ O) (h ⁻¹ᵁ L.V a ⊓ O') (fun x hx => ⟨hx.1, hO hx.2⟩)).hom
          (t a)) := by
    intro Y' Y h L O O' hO t ht
    rintro (a : Fin L.m) (b : Fin L.m)
    have hg : ∀ (V : Y'.Opens)
        (hV : V ≤ (wcpaDjCocPull h L).V a ⊓ (wcpaDjCocPull h L).V b),
        (Y'.presheaf.map (homOfLE hV).op).hom ((wcpaDjCocPull h L).g a b :
          Γ(Y', (wcpaDjCocPull h L).V a ⊓ (wcpaDjCocPull h L).V b)) =
        (h.appLE (L.V a ⊓ L.V b) V (fun x hx => hV hx)).hom (L.g a b) := by
      intro V hV
      exact hpull h (L.V a ⊓ L.V b) V _ _ hV _
    have hT : (h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ⊓ O') ≤ h ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ O) :=
      fun x hx => ⟨⟨hx.1.1, hx.1.2⟩, hO hx.2⟩
    have hres : ∀ (U : Y.Opens) (V V' : Y'.Opens) (e1 : V' ≤ h ⁻¹ᵁ U) (h2 : V ≤ V')
        (x : Γ(Y, U)),
        (Y'.presheaf.map (homOfLE h2).op).hom ((h.appLE U V' e1).hom x) =
          (h.appLE U V (h2.trans e1)).hom x := by
      intro U V V' e1 h2 x
      rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_map]
    have e := congrArg (h.appLE (L.V a ⊓ L.V b ⊓ O) _ hT).hom (ht a b)
    simp only [pow_one, map_mul] at e ⊢
    rw [hg]
    simp only [← CommRingCat.comp_apply, Scheme.Hom.map_appLE] at e
    have r1 := hres (L.V b ⊓ O) (h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ⊓ O') (h ⁻¹ᵁ L.V b ⊓ O')
      (fun x hx => ⟨hx.1, hO hx.2⟩) (fun x hx => ⟨hx.1.2, hx.2⟩) (t b)
    have r2 := hres (L.V a ⊓ O) (h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ⊓ O') (h ⁻¹ᵁ L.V a ⊓ O')
      (fun x hx => ⟨hx.1, hO hx.2⟩) (fun x hx => ⟨hx.1.1, hx.2⟩) (t a)
    exact r1.trans (e.trans (congrArg (HMul.hMul _) r2.symm))

  have cocok_pull : ∀ {Y' Y : Scheme.{u}} (h : Y' ⟶ Y) [IsAffineHom h] (L : wcpaDjCoc Y),
      wcpaDjCocOK L → wcpaDjCocOK (wcpaDjCocPull h L) := by
    intro Y' Y h _ L hL
    obtain ⟨hA, hcov, h1, hcoc⟩ := hL
    refine ⟨fun a => (hA a).preimage h, ?_, ?_, ?_⟩
    · show ⨆ a, h ⁻¹ᵁ L.V a = ⊤
      rw [← Scheme.Hom.preimage_iSup, hcov, Scheme.Hom.preimage_top]
    · intro a
      show Units.map _ (L.g a a) = 1
      rw [h1 a, map_one]
    · intro a b c
      have hg : ∀ (a b : Fin L.m) (V : Y'.Opens)
          (hV : V ≤ (wcpaDjCocPull h L).V a ⊓ (wcpaDjCocPull h L).V b),
          (Y'.presheaf.map (homOfLE hV).op).hom ((wcpaDjCocPull h L).g a b :
            Γ(Y', (wcpaDjCocPull h L).V a ⊓ (wcpaDjCocPull h L).V b)) =
          (h.appLE (L.V a ⊓ L.V b) V (fun x hx => hV hx)).hom (L.g a b) := by
        intro a b V hV
        exact hpull h (L.V a ⊓ L.V b) V _ _ hV _
      have hT : (h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ⊓ h ⁻¹ᵁ L.V c) ≤ h ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ L.V c) :=
        fun x hx => ⟨⟨hx.1.1, hx.1.2⟩, hx.2⟩
      have e := congrArg (h.appLE (L.V a ⊓ L.V b ⊓ L.V c) _ hT).hom (hcoc a b c)
      rw [map_mul] at e
      simp only [← CommRingCat.comp_apply, Scheme.Hom.map_appLE] at e
      have e1 := hg a b (h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ⊓ h ⁻¹ᵁ L.V c)
        (fun x hx => ⟨hx.1.1, hx.1.2⟩)
      have e2 := hg b c (h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ⊓ h ⁻¹ᵁ L.V c)
        (fun x hx => ⟨hx.1.2, hx.2⟩)
      have e3 := hg a c (h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ⊓ h ⁻¹ᵁ L.V c)
        (fun x hx => ⟨hx.1.1, hx.2⟩)
      exact (congrArg₂ (· * ·) e1 e2).trans (e.trans e3.symm)

  haveI hρ : IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI hfci : IsClosedImmersion (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) := inferInstance
  haveI hfaff : IsAffineHom (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) := inferInstance
  haveI := hκ
  set ρ := Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) with hρdef
  set f := Limits.pullback.fst u₁ ρ with hfdef
  set q := Limits.pullback.snd u₁ ρ with hqdef
  have hfinj : Function.Injective f := f.isClosedEmbedding.isEmbedding.injective
  have pt : ∀ {A B D : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ D} {d : A ⟶ D}, a ≫ b = d →
      ∀ z, b (a z) = d z := by
    intro A B D a b d h z
    rw [← Scheme.Hom.comp_apply, h]

  let ε₀ : Fin r → (Spec (.of (IsLocalRing.ResidueField ↥W)) ⟶ Limits.pullback u₁ ρ) :=
    fun b => Limits.pullback.lift (ρ ≫ ε b) (𝟙 _)
      (by rw [Category.assoc, hsec.1 b, Category.comp_id, Category.id_comp])
  have hε₀f : ∀ b, ε₀ b ≫ f = ρ ≫ ε b := fun b => Limits.pullback.lift_fst _ _ _
  have hε₀q : ∀ b, ε₀ b ≫ q = 𝟙 _ := fun b => Limits.pullback.lift_snd _ _ _
  have L1 : ∀ b p, f (ε₀ b p) = ε b (ρ p) := fun b p => by
    rw [pt (hε₀f b) p, Scheme.Hom.comp_apply]
  have hsec₀ : wcpaDjSections q r ε₀ := by
    refine ⟨hε₀q, ?_, ?_⟩
    · intro i j p p' hij heq
      apply hsec.2.1 i j (ρ p) (ρ p') hij
      rw [← L1, ← L1, heq]
    · intro j p
      obtain ⟨W', hW', hW'sm⟩ := hsec.2.2 j (ρ p)
      refine ⟨f ⁻¹ᵁ W', ?_, ?_⟩
      · show f (ε₀ j p) ∈ W'
        rw [L1]
        exact hW'
      · have h1 : IsPullback (f ∣_ W') (f ⁻¹ᵁ W').ι W'.ι f := isPullback_morphismRestrict f W'
        have h2 : IsPullback (f ∣_ W') ((f ⁻¹ᵁ W').ι ≫ q) (W'.ι ≫ u₁) ρ :=
          h1.paste_vert (IsPullback.of_hasPullback u₁ ρ)
        exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) h2 hW'sm
  have hrange : ∀ x, f x ∈ ⋃ i, Set.range ⇑(ε i) ↔ x ∈ ⋃ i, Set.range ⇑(ε₀ i) := by
    intro x
    simp only [Set.mem_iUnion, Set.mem_range]
    constructor
    · rintro ⟨b, p, hp⟩
      have h1 : u₁ (f x) = ρ (q x) := by
        rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
      have h2 : u₁ (ε b p) = p := by
        rw [← Scheme.Hom.comp_apply, hsec.1 b]
        rfl
      have h3 : p = ρ (q x) := by rw [← h2, hp, h1]
      refine ⟨b, q x, hfinj ?_⟩
      rw [L1, ← h3, hp]
    · rintro ⟨b, p, hp⟩
      exact ⟨b, ρ p, by rw [← hp, L1]⟩

  have hO : q ⁻¹ᵁ ⊤ ≤ f ⁻¹ᵁ (u₁ ⁻¹ᵁ ⊤) := fun x _ => trivial
  have hmem : ∀ a (x : ↥(Limits.pullback u₁ ρ)),
      x ∈ (Limits.pullback u₁ ρ).basicOpen ((f.appLE (L.V a ⊓ u₁ ⁻¹ᵁ ⊤)
        (f ⁻¹ᵁ L.V a ⊓ q ⁻¹ᵁ ⊤) (fun x hx => ⟨hx.1, hO hx.2⟩)).hom (t a)) ↔
      (x ∈ f ⁻¹ᵁ L.V a ∧ f x ∉ ⋃ i, Set.range (ε i)) := by
    intro a x
    have hb := Scheme.basicOpen_appLE f (f ⁻¹ᵁ L.V a ⊓ q ⁻¹ᵁ ⊤) (L.V a ⊓ u₁ ⁻¹ᵁ ⊤)
      (fun x hx => ⟨hx.1, hO hx.2⟩) (t a)
    have h1 : x ∈ (Limits.pullback u₁ ρ).basicOpen ((f.appLE (L.V a ⊓ u₁ ⁻¹ᵁ ⊤)
        (f ⁻¹ᵁ L.V a ⊓ q ⁻¹ᵁ ⊤) (fun x hx => ⟨hx.1, hO hx.2⟩)).hom (t a)) ↔
        x ∈ (f ⁻¹ᵁ L.V a ⊓ q ⁻¹ᵁ ⊤) ⊓ f ⁻¹ᵁ Z₁.basicOpen (t a) := by
      rw [← hb]
    rw [h1]
    have h2 : f x ∈ Z₁.basicOpen (t a) ↔ f x ∈ (Z₁.basicOpen (t a) : Set Z₁) := Iff.rfl
    rw [hbo a] at h2
    constructor
    · rintro ⟨⟨hx1, _⟩, hx2⟩
      exact ⟨hx1, (h2.mp hx2).2⟩
    · rintro ⟨hx1, hx2⟩
      exact ⟨⟨hx1, trivial⟩, h2.mpr ⟨⟨hx1, trivial⟩, hx2⟩⟩

  have hconv : ∀ E : Set ↥(Limits.pullback u₁ ρ),
      (∀ b, ε₀ b (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) ∉ E) →
      ∀ b, ¬ ∃ x ∈ E, ∃ q' : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
        f x = ε b (ρ q') := by
    intro E hE b hex
    obtain ⟨x, hx, q', hq'⟩ := hex
    have hr : x ∈ ⋃ i, Set.range ⇑(ε₀ i) :=
      (hrange x).mp (Set.mem_iUnion.mpr ⟨b, ρ q', hq'.symm⟩)
    obtain ⟨b', p, hp⟩ := Set.mem_iUnion.mp hr
    have hp' : p = IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W) :=
      Subsingleton.elim (α := PrimeSpectrum (IsLocalRing.ResidueField ↥W)) _ _
    apply hE b'
    rw [← hp', hp]
    exact hx
  refine ⟨ε₀, fun a => (f.appLE (L.V a ⊓ u₁ ⁻¹ᵁ ⊤) (f ⁻¹ᵁ L.V a ⊓ q ⁻¹ᵁ ⊤)
      (fun x hx => ⟨hx.1, hO hx.2⟩)).hom (t a), ss_bc _ _ _ ρ u₁ hss, hsec₀,
    cocok_pull f L hOK, compat_pull f L _ _ hO t hcompat, ?_, ?_, ?_⟩
  · intro a
    ext x
    constructor
    · intro hx
      obtain ⟨h1, h2⟩ := (hmem a x).mp hx
      exact ⟨⟨h1, trivial⟩, fun h => h2 ((hrange x).mpr h)⟩
    · rintro ⟨⟨h1, _⟩, h2⟩
      exact (hmem a x).mpr ⟨h1, fun h => h2 ((hrange x).mp h)⟩
  · intro E hE hE₀
    exact (hAF (IsLocalRing.ResidueField ↥W) ρ E hE (hconv E hE₀)).1
  · intro E hE E' hE' hE₀ hE₀'
    exact ((hAF (IsLocalRing.ResidueField ↥W) ρ E hE (hconv E hE₀)).2.2.2 E' hE'
      (hconv E' hE₀')).symm

theorem wcpa_dj_lge_point_section : ∀ (Y : Scheme.{u}) (L : wcpaDjCoc Y), wcpaDjCocOK L →
    ∀ (x : Y), IsClosed ({x} : Set Y) → ∀ (a₀ : Fin L.m), x ∈ L.V a₀ →
    ∀ (S : Set Y), IsClosed S → x ∉ S →
    ∀ (K : Y.Modules) (ι : K ⟶ wcStructMod Y),
    (∀ V : Y.Opens, Function.Injective (Scheme.Modules.Hom.app ι V)) →
    (∀ (V : Y.Opens) (f : Γ(Y, V)), (∃ k : Γ(K, V), Scheme.Modules.Hom.app ι V k = f) ↔
      ∀ (z : Y) (hz : z ∈ V), z ∈ insert x S →
        (Y.presheaf.germ V z hz).hom f ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z)) →
    ∀ n : ℕ, wcpaDjTwH1 L ⊤ K n →
    ∃ s : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ ⊤), wcpaDjCompat L ⊤ n s ∧ x ∈ Y.basicOpen (s a₀) :=
by
  intro Y L hL x hxc a₀ hx₀ S hS hxS K ι hinj hchar n hTw

  have cc : ∀ (T : Set Y),
      (∀ (V : Y.Opens) (f : Γ(Y, V)), (∃ k : Γ(K, V), Scheme.Modules.Hom.app ι V k = f) ↔
          ∀ (z : Y) (hz : z ∈ V), z ∈ T →
            (Y.presheaf.germ V z hz).hom f ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z)) →
      ∀ w : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ ⊤),
      (∀ (a b : Fin L.m) (z : Y) (hz : z ∈ L.V a ⊓ L.V b ⊓ ⊤), z ∈ T →
        (Y.presheaf.germ (L.V a ⊓ L.V b ⊓ ⊤) z hz).hom
          ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V b ⊓ ⊤ from
              le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (w b) -
            (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ L.V b from
              inf_le_left)).op).hom ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ n) *
            (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ ⊤ from
              le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (w a)) ∈
          IsLocalRing.maximalIdeal (Y.presheaf.stalk z)) →
      ∃ β : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ ⊤),
        (∀ (a : Fin L.m) (z : Y) (hz : z ∈ L.V a ⊓ ⊤), z ∈ T →
          (Y.presheaf.germ (L.V a ⊓ ⊤) z hz).hom (β a) ∈
            IsLocalRing.maximalIdeal (Y.presheaf.stalk z)) ∧
        wcpaDjCompat L ⊤ n (fun a => w a - β a) := by
    intro T hchar w hw
    have hres : ∀ (U V W : Y.Opens) (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(Y, U)),
        (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
          (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
      intro U V W h1 h2 x
      rw [← CommRingCat.comp_apply, ← Functor.map_comp]
      rfl
    obtain ⟨ιf, hιf⟩ : ∃ f : ∀ V : Y.Opens, Γ(K, V) → Γ(Y, V),
        ∀ V k, f V k = Scheme.Modules.Hom.app ι V k :=
      ⟨fun V k => Scheme.Modules.Hom.app ι V k, fun _ _ => rfl⟩
    have hinj' : ∀ V, Function.Injective (ιf V) := by
      intro V x y hxy
      rw [hιf, hιf] at hxy
      exact hinj V hxy
    have hchar' : ∀ (V : Y.Opens) (f : Γ(Y, V)), (∃ k : Γ(K, V), ιf V k = f) ↔
        ∀ (z : Y) (hz : z ∈ V), z ∈ T →
          (Y.presheaf.germ V z hz).hom f ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z) := by
      intro V f
      simp only [hιf]
      exact hchar V f
    have hadd : ∀ (V : Y.Opens) (x y : Γ(K, V)), ιf V (x + y) = ιf V x + ιf V y := by
      intro V x y
      rw [hιf, hιf, hιf]
      exact map_add _ x y
    have hsub : ∀ (V : Y.Opens) (x y : Γ(K, V)), ιf V (x - y) = ιf V x - ιf V y := by
      intro V x y
      rw [hιf, hιf, hιf]
      exact map_sub _ x y
    have hsmul : ∀ (V : Y.Opens) (r : Γ(Y, V)) (k : Γ(K, V)), ιf V (r • k) = r * ιf V k := by
      intro V r k
      rw [hιf, hιf]
      exact Scheme.Modules.Hom.app_smul ι r k
    have hnat : ∀ (U V : Y.Opens) (h : V ≤ U) (k : Γ(K, U)),
        ιf V ((K.presheaf.map (homOfLE h).op).hom k) =
          (Y.presheaf.map (homOfLE h).op).hom (ιf U k) := by
      intro U V h k
      rw [hιf, hιf]
      exact NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf ι) (homOfLE h).op k
    obtain ⟨c, hc⟩ : ∃ c : ∀ a b : Fin L.m, Γ(Y, L.V a ⊓ L.V b ⊓ ⊤), ∀ a b, c a b =
        (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V b ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (w b) -
          (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ L.V b from
            inf_le_left)).op).hom ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ n) *
          (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (w a) :=
      ⟨fun a b => (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V b ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (w b) -
          (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ L.V b from
            inf_le_left)).op).hom ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ n) *
          (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (w a),
        fun _ _ => rfl⟩
    have hvan : ∀ (a b : Fin L.m) (z : Y) (hz : z ∈ L.V a ⊓ L.V b ⊓ ⊤), z ∈ T →
        (Y.presheaf.germ (L.V a ⊓ L.V b ⊓ ⊤) z hz).hom (c a b) ∈
          IsLocalRing.maximalIdeal (Y.presheaf.stalk z) := by
      intro a b z hz hzT
      rw [hc]
      exact hw a b z hz hzT
    have hlift : ∀ a b : Fin L.m, ∃ k : Γ(K, L.V a ⊓ L.V b ⊓ ⊤), ιf _ k = c a b :=
      fun a b => (hchar' _ _).mpr (hvan a b)
    choose c' hc' using hlift
    obtain ⟨β', hβ'⟩ := hTw c' (by
      intro a b d
      apply hinj'
      rw [hadd, hsmul, hnat, hnat, hnat, hc', hc', hc', hc, hc, hc]
      have hg := congrArg (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤
        L.V a ⊓ L.V b ⊓ L.V d from inf_le_left)).op).hom (hL.2.2.2 a b d)
      simp only [map_mul, hres] at hg
      simp only [map_sub, map_mul, map_pow, hres]
      rw [← hg, mul_pow]
      ring)
    refine ⟨fun a => ιf _ (β' a), ?_, ?_⟩
    · intro a z hz hzT
      exact (hchar' _ _).mp ⟨β' a, rfl⟩ z hz hzT
    · intro a b
      have e := congrArg (ιf _) (hβ' a b)
      rw [hc', hsub, hsmul, hnat, hnat, hc] at e
      simp only [map_sub, map_pow] at e ⊢
      linear_combination e

  have core : ∀ (U O : Y.Opens), IsAffineOpen U → x ∈ O → ∀ G : x ∈ U → Y.presheaf.stalk x,
      ∃ w : Γ(Y, U), (∀ (z : Y) (hz : z ∈ U), z ∉ O →
        (Y.presheaf.germ U z hz).hom w ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z)) ∧
        ∀ hx : x ∈ U, (Y.presheaf.germ U x hx).hom w - G hx ∈
          IsLocalRing.maximalIdeal (Y.presheaf.stalk x) := by
    intro U O hU hxO G
    by_cases hx : x ∈ U
    swap
    · refine ⟨0, fun z hz _ => ?_, fun hx' => absurd hx' hx⟩
      rw [map_zero]
      exact Ideal.zero_mem _
    have hmax : (hU.primeIdealOf ⟨x, hx⟩).asIdeal.IsMaximal := by
      have ha : hU.fromSpec (hU.primeIdealOf ⟨x, hx⟩) = x := hU.fromSpec_primeIdealOf ⟨x, hx⟩
      have hinj : Function.Injective hU.fromSpec := hU.fromSpec.isOpenEmbedding.injective
      have hpre : (⇑hU.fromSpec) ⁻¹' {x} = {hU.primeIdealOf ⟨x, hx⟩} := by
        ext q
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        constructor
        · intro h; exact hinj (h.trans ha.symm)
        · intro h; rw [h]; exact ha
      have hcl : IsClosed ((⇑hU.fromSpec) ⁻¹' {x}) := hxc.preimage hU.fromSpec.continuous
      rw [hpre] at hcl
      exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp hcl
    obtain ⟨f, hfle, hxf⟩ := hU.exists_basicOpen_le (V := O ⊓ U) ⟨x, ⟨hxO, hx⟩⟩ hx
    have hfu : IsUnit ((Y.presheaf.germ U x hx).hom f) := (Scheme.mem_basicOpen Y f x hx).mp hxf
    have hfv : ∀ (z : Y) (hz : z ∈ U), z ∉ O →
        (Y.presheaf.germ U z hz).hom f ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z) := by
      intro z hz hzO
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have hzD : z ∈ Y.basicOpen f := (Scheme.mem_basicOpen Y f z hz).mpr hu
      exact hzO (hfle hzD).1
    have hlift : ∀ τ : Y.presheaf.stalk x, ∃ r : Γ(Y, U),
        (Y.presheaf.germ U x hx).hom r - τ ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk x) := by
      intro τ
      letI : Algebra Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) :=
        TopCat.Presheaf.algebra_section_stalk Y.presheaf ⟨x, hx⟩
      have := hU.isLocalization_stalk ⟨x, hx⟩
      let τ' : Y.presheaf.stalk (⟨x, hx⟩ : U).1 := τ
      obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.mk'_surjective
        (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl τ'
      have hs : (s : Γ(Y, U)) ∉ (hU.primeIdealOf ⟨x, hx⟩).asIdeal := s.2
      obtain ⟨y, i, hi, hyi⟩ := hmax.exists_inv hs
      have h1 : τ' * algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) s =
          algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) b := by
        rw [← hbs]; exact IsLocalization.mk'_spec _ b s
      have h2 : algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) y *
          algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) s +
          algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) i = 1 := by
        rw [← map_mul, ← map_add, hyi, map_one]
      have hu : IsUnit (algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) s) :=
        (IsLocalization.AtPrime.isUnit_to_map_iff _ (hU.primeIdealOf ⟨x, hx⟩).asIdeal s).mpr s.2
      have him : algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) i ∈
          IsLocalRing.maximalIdeal (Y.presheaf.stalk (⟨x, hx⟩ : U).1) :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff _ (hU.primeIdealOf ⟨x, hx⟩).asIdeal
          i).mpr hi
      refine ⟨b * y, ?_⟩
      show algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) (b * y) - τ' ∈
        IsLocalRing.maximalIdeal (Y.presheaf.stalk (⟨x, hx⟩ : U).1)
      have key : algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) s *
          (algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) (b * y) - τ') =
          -(algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) b *
            algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) i) := by
        rw [map_mul]
        linear_combination (algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) b) * h2 - h1
      have e : algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) (b * y) - τ' =
          ↑(hu.unit⁻¹) * (algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) s *
            (algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) (b * y) - τ')) := by
        rw [← mul_assoc, IsUnit.val_inv_mul, one_mul]
      rw [e, key]
      exact Ideal.mul_mem_left _ _ (neg_mem (Ideal.mul_mem_left _ _ him))
    obtain ⟨r, hr⟩ := hlift (G hx * ↑(hfu.unit⁻¹))
    refine ⟨f * r, fun z hz hzO => ?_, fun hx' => ?_⟩
    · rw [map_mul]
      exact Ideal.mul_mem_right _ _ (hfv z hz hzO)
    · have e : (Y.presheaf.germ U x hx').hom (f * r) - G hx' =
          (Y.presheaf.germ U x hx).hom f *
            ((Y.presheaf.germ U x hx).hom r - G hx * ↑(hfu.unit⁻¹)) := by
        rw [map_mul, mul_sub]
        congr 1
        rw [mul_comm (G hx), ← mul_assoc, IsUnit.mul_val_inv, one_mul]
      rw [e]
      exact Ideal.mul_mem_left _ _ hr

  have hA : ∀ a, IsAffineOpen (L.V a ⊓ ⊤) := fun a => by rw [inf_top_eq]; exact hL.1 a
  have hxO : x ∈ L.V a₀ ⊓ (⟨Sᶜ, hS.isOpen_compl⟩ : Y.Opens) := ⟨hx₀, hxS⟩
  choose w hw1 hw2 using fun a => core (L.V a ⊓ ⊤) (L.V a₀ ⊓ ⟨Sᶜ, hS.isOpen_compl⟩) (hA a) hxO
    (fun hx => (Y.presheaf.germ (L.V a₀ ⊓ L.V a) x ⟨hx₀, hx.1⟩).hom
      ((L.g a₀ a : Γ(Y, L.V a₀ ⊓ L.V a)) ^ n))
  have hwS : ∀ (a : Fin L.m) (z : Y) (hz : z ∈ L.V a ⊓ ⊤), z ∈ S →
      (Y.presheaf.germ (L.V a ⊓ ⊤) z hz).hom (w a) ∈
        IsLocalRing.maximalIdeal (Y.presheaf.stalk z) :=
    fun a z hz hzS => hw1 a z hz (fun h => h.2 hzS)

  have ringkey : ∀ (R : Type u) [CommRing R] (I : Ideal R) (A Bn C Ga Gb : R),
      Gb = Ga * Bn → A - Gb ∈ I → C - Ga ∈ I → A - Bn * C ∈ I := by
    intro R _ I A Bn C Ga Gb hG h1 h2
    have e : A - Bn * C = (A - Gb) - Bn * (C - Ga) + (Gb - Ga * Bn) := by ring
    rw [e, show Gb - Ga * Bn = 0 from sub_eq_zero.mpr hG, add_zero]
    exact Ideal.sub_mem _ h1 (Ideal.mul_mem_left _ _ h2)
  have hcob : ∀ (a b : Fin L.m) (z : Y) (hz : z ∈ L.V a ⊓ L.V b ⊓ ⊤), z ∈ insert x S →
      (Y.presheaf.germ (L.V a ⊓ L.V b ⊓ ⊤) z hz).hom
        ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V b ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (w b) -
          (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ L.V b from
            inf_le_left)).op).hom ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ n) *
          (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (w a)) ∈
        IsLocalRing.maximalIdeal (Y.presheaf.stalk z) := by
    intro a b z hz hzT
    rw [map_sub, map_mul, TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply,
      TopCat.Presheaf.germ_res_apply]
    rcases hzT with hzx | hzS
    · subst hzx
      have hQ : z ∈ L.V a₀ ⊓ L.V a ⊓ L.V b := ⟨⟨hx₀, hz.1.1⟩, hz.1.2⟩
      have hcoc := congrArg (fun t => (Y.presheaf.germ (L.V a₀ ⊓ L.V a ⊓ L.V b) z hQ).hom t ^ n)
        (hL.2.2.2 a₀ a b)
      simp only [map_mul, mul_pow, TopCat.Presheaf.germ_res_apply] at hcoc
      refine ringkey _ _ _ _ _ _ _ ?_ (hw2 b ⟨hz.1.2, trivial⟩) (hw2 a ⟨hz.1.1, trivial⟩)
      simp only [map_pow]
      exact hcoc.symm
    · exact Ideal.sub_mem _ (hwS b z _ hzS) (Ideal.mul_mem_left _ _ (hwS a z _ hzS))

  obtain ⟨β, hβ, hcompat⟩ := cc (insert x S) hchar w hcob
  refine ⟨fun a => w a - β a, hcompat, ?_⟩
  have hxa : x ∈ L.V a₀ ⊓ ⊤ := ⟨hx₀, trivial⟩
  apply (Scheme.mem_basicOpen Y _ x hxa).mpr
  have h1 := hw2 a₀ hxa
  rw [hL.2.2.1 a₀, Units.val_one, one_pow, map_one] at h1
  have h2 := hβ a₀ x hxa (Set.mem_insert x S)
  rw [map_sub]
  by_contra hnu
  have h3 : (Y.presheaf.germ (L.V a₀ ⊓ ⊤) x hxa).hom (w a₀) -
      (Y.presheaf.germ (L.V a₀ ⊓ ⊤) x hxa).hom (β a₀) ∈
      IsLocalRing.maximalIdeal (Y.presheaf.stalk x) :=
    (IsLocalRing.mem_maximalIdeal _).mpr hnu
  have h4 : (1 : Y.presheaf.stalk x) ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk x) := by
    have e : (1 : Y.presheaf.stalk x) =
        ((Y.presheaf.germ (L.V a₀ ⊓ ⊤) x hxa).hom (w a₀) -
          (Y.presheaf.germ (L.V a₀ ⊓ ⊤) x hxa).hom (β a₀)) -
        ((Y.presheaf.germ (L.V a₀ ⊓ ⊤) x hxa).hom (w a₀) - 1) -
        (Y.presheaf.germ (L.V a₀ ⊓ ⊤) x hxa).hom (β a₀) * (-1) := by ring
    rw [e]
    exact Ideal.sub_mem _ (Ideal.sub_mem _ h3 h1) (Ideal.mul_mem_right _ _ h2)
  exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top
    ((Ideal.eq_top_iff_one _).mpr h4)

theorem wcpa_dj_lsp_scd_valord_bounds : ∀ (F : Type u) [Field F] (V : ValuationSubring F),
    (∀ x : F, x ∈ V → 0 ≤ wcpaDjValOrd V x) ∧
    ((∃ u : F, wcpaDjValOrd V u = 1) →
      (∀ x y : F, x ≠ 0 → y ≠ 0 → wcpaDjValOrd V (x * y) = wcpaDjValOrd V x + wcpaDjValOrd V y) →
      ∀ (x : F) (hx : x ∈ V), x ≠ 0 → (⟨x, hx⟩ : V) ∈ IsLocalRing.maximalIdeal V →
        1 ≤ wcpaDjValOrd V x) :=
by
  intro F _ V
  classical
  have s1 : ∀ y : F, y ∈ V → sSup {n : ℕ | ∃ h : y⁻¹ ∈ V,
      (⟨y⁻¹, h⟩ : ↥V) ∈ (IsLocalRing.maximalIdeal ↥V) ^ n} = 0 := by
    intro y hy
    by_cases hy0 : y = 0
    · subst hy0
      apply Nat.sSup_of_not_bddAbove
      rw [not_bddAbove_iff]
      intro n
      have h0 : (0 : F)⁻¹ ∈ V := by rw [inv_zero]; exact V.zero_mem
      refine ⟨n + 1, ⟨h0, ?_⟩, by omega⟩
      have e : (⟨(0 : F)⁻¹, h0⟩ : V) = 0 := Subtype.ext (by simp)
      rw [e]
      exact Ideal.zero_mem _
    · by_cases hyi : y⁻¹ ∈ V
      · apply Nat.eq_zero_of_le_zero
        apply csSup_le'
        intro n hn
        obtain ⟨h, hn⟩ := hn
        by_contra hne
        have hunit : IsUnit (⟨y⁻¹, h⟩ : V) :=
          IsUnit.of_mul_eq_one (⟨y, hy⟩ : V)
            (Subtype.ext (show y⁻¹ * y = 1 from inv_mul_cancel₀ hy0))
        have hm := Ideal.pow_le_self (I := IsLocalRing.maximalIdeal V) (n := n) (by omega) hn
        exact IsLocalRing.notMem_maximalIdeal.mpr hunit hm
      · have e : {n : ℕ | ∃ h : y⁻¹ ∈ V,
            (⟨y⁻¹, h⟩ : ↥V) ∈ (IsLocalRing.maximalIdeal ↥V) ^ n} = ∅ := by
          ext n
          exact iff_of_false (fun ⟨h, _⟩ => hyi h) (Set.notMem_empty n)
        rw [e]
        exact csSup_empty
  have s2 : ∀ (y : F) (hy : y ∈ V), wcpaDjValOrd V y =
      ((sSup {n : ℕ | ∃ h : y ∈ V, (⟨y, h⟩ : ↥V) ∈ (IsLocalRing.maximalIdeal ↥V) ^ n} : ℕ) : ℤ) := by
    intro y hy
    unfold wcpaDjValOrd
    rw [s1 y hy]
    simp
  have s3 : ∀ (y : F) (hy : y ∈ V), (∀ n : ℕ, (⟨y, hy⟩ : V) ∈ (IsLocalRing.maximalIdeal ↥V) ^ n) →
      sSup {n : ℕ | ∃ h : y ∈ V, (⟨y, h⟩ : ↥V) ∈ (IsLocalRing.maximalIdeal ↥V) ^ n} = 0 := by
    intro y hy hall
    apply Nat.sSup_of_not_bddAbove
    rw [not_bddAbove_iff]
    intro n
    exact ⟨n + 1, ⟨hy, hall (n + 1)⟩, by omega⟩
  have hI : ∀ x : F, x ∈ V → 0 ≤ wcpaDjValOrd V x := by
    intro x hx
    rw [s2 x hx]
    exact Int.natCast_nonneg _
  refine ⟨hI, ?_⟩
  rintro ⟨u, hu⟩ hadd x hx hx0 hxm
  have hv0 : wcpaDjValOrd V 0 = 0 := by
    rw [s2 0 V.zero_mem, s3 0 V.zero_mem (fun n => by
      have e : (⟨0, V.zero_mem⟩ : V) = 0 := rfl
      rw [e]
      exact Ideal.zero_mem _)]
    simp
  have hu0 : u ≠ 0 := by
    rintro rfl
    rw [hv0] at hu
    exact zero_ne_one hu
  have hv1 : wcpaDjValOrd V 1 = 0 := by
    have e := hadd 1 1 one_ne_zero one_ne_zero
    rw [one_mul] at e
    linarith
  have hvui : wcpaDjValOrd V u⁻¹ = -1 := by
    have e := hadd u u⁻¹ hu0 (inv_ne_zero hu0)
    rw [mul_inv_cancel₀ hu0, hv1, hu] at e
    linarith
  by_cases hbdd : BddAbove {n : ℕ | ∃ h : x ∈ V, (⟨x, h⟩ : ↥V) ∈ (IsLocalRing.maximalIdeal ↥V) ^ n}
  · rw [s2 x hx]
    have h1 : 1 ∈ {n : ℕ | ∃ h : x ∈ V, (⟨x, h⟩ : ↥V) ∈ (IsLocalRing.maximalIdeal ↥V) ^ n} :=
      ⟨hx, by rw [pow_one]; exact hxm⟩
    have h2 := le_csSup hbdd h1
    exact_mod_cast h2
  · exfalso
    have hall : ∀ n : ℕ, (⟨x, hx⟩ : V) ∈ (IsLocalRing.maximalIdeal ↥V) ^ n := by
      intro n
      rw [not_bddAbove_iff] at hbdd
      obtain ⟨k, ⟨h, hk⟩, hnk⟩ := hbdd n
      exact Ideal.pow_le_pow_right hnk.le hk
    have hvx : wcpaDjValOrd V x = 0 := by
      rw [s2 x hx, Nat.sSup_of_not_bddAbove hbdd]
      simp
    rcases V.mem_or_inv_mem (x * u⁻¹) with h | h
    · have e := hadd x u⁻¹ hx0 (inv_ne_zero hu0)
      have h3 := hI _ h
      rw [hvx, hvui] at e
      linarith
    · have hxw : x * (x * u⁻¹)⁻¹ = u := by
        rw [mul_inv_rev, inv_inv, ← mul_assoc, mul_comm x u, mul_assoc, mul_inv_cancel₀ hx0,
          mul_one]
      have hu' : u ∈ V := hxw ▸ mul_mem hx h
      have hvu : wcpaDjValOrd V u = 0 := by
        rw [s2 u hu', s3 u hu' (fun n => by
          have e : (⟨u, hu'⟩ : V) = ⟨x, hx⟩ * ⟨(x * u⁻¹)⁻¹, h⟩ := Subtype.ext hxw.symm
          rw [e]
          exact Ideal.mul_mem_right _ _ (hall n))]
        simp
      rw [hvu] at hu
      exact zero_ne_one hu

theorem wcpa_dj_lsp_scd_compat_residue : ∀ (C : Scheme.{u}) (O : C.Opens) (L : wcpaDjCoc C)
    (t : ∀ a : Fin L.m, Γ(C, L.V a ⊓ O)), wcpaDjCompat L O 1 t →
    ∀ (ξ : C) (a b : Fin L.m) (hab : ξ ∈ L.V a ⊓ L.V b) (hO : ξ ∈ O),
      (C.presheaf.germ (L.V b ⊓ O) ξ ⟨hab.2, hO⟩ ≫ C.residue ξ).hom (t b) =
        (C.presheaf.germ (L.V a ⊓ L.V b) ξ hab ≫ C.residue ξ).hom
          (L.g a b : Γ(C, L.V a ⊓ L.V b)) *
        (C.presheaf.germ (L.V a ⊓ O) ξ ⟨hab.1, hO⟩ ≫ C.residue ξ).hom (t a) :=
by
  intro C O L t hcomp ξ a b hab hO
  have hW : ξ ∈ L.V a ⊓ L.V b ⊓ O := ⟨hab, hO⟩
  have key : ∀ (U : C.Opens) (i : L.V a ⊓ L.V b ⊓ O ≤ U) (s : Γ(C, U)),
      (C.presheaf.germ (L.V a ⊓ L.V b ⊓ O) ξ hW ≫ C.residue ξ).hom
        ((C.presheaf.map (homOfLE i).op).hom s) =
      (C.presheaf.germ U ξ (i hW) ≫ C.residue ξ).hom s := by
    intro U i s
    rw [← CommRingCat.comp_apply, ← Category.assoc, TopCat.Presheaf.germ_res]
  have h := hcomp a b
  rw [pow_one] at h
  have h' := congrArg (C.presheaf.germ (L.V a ⊓ L.V b ⊓ O) ξ hW ≫ C.residue ξ).hom h
  rw [map_mul, key, key, key] at h'
  exact h'

theorem wcpa_dj_lsp_scd_centre_in_chart : ∀ (K : Type u) [Field K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)), IsSeparated q →
    ∀ (U : C.Opens), IsAffineOpen U → ∀ (ξ x : C) (h : ξ ⤳ x) (hξ : ξ ∈ U)
    (V : ValuationSubring (C.residueField ξ)),
    (∀ s : Γ(C, U), (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom s ∈ V) →
    (∀ s : C.presheaf.stalk x,
      ∃ hs : (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom s ∈ V,
        s ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x) →
          (⟨(C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom s, hs⟩ : V) ∈
            IsLocalRing.maximalIdeal V) →
    x ∈ U :=
by
  intro K _ C q hsep U hU ξ x h hξ V hA hB
  haveI := hsep
  let φU : Γ(C, U) ⟶ CommRingCat.of V :=
    CommRingCat.ofHom ((C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom.codRestrict V hA)
  let φx : C.presheaf.stalk x ⟶ CommRingCat.of V :=
    CommRingCat.ofHom ((C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom.codRestrict V
      (fun s => (hB s).fst))
  let ι : CommRingCat.of V ⟶ CommRingCat.of (C.residueField ξ) :=
    CommRingCat.ofHom (algebraMap V (C.residueField ξ))
  have F1 : φU ≫ ι = C.presheaf.germ U ξ hξ ≫ C.residue ξ := by
    ext s; rfl
  have F2 : φx ≫ ι = C.presheaf.stalkSpecializes h ≫ C.residue ξ := by
    ext s; rfl
  let f₁ : Spec (CommRingCat.of V) ⟶ C := Spec.map φU ≫ hU.fromSpec
  let f₂ : Spec (CommRingCat.of V) ⟶ C := Spec.map φx ≫ C.fromSpecStalk x
  have e1 : Spec.map ι ≫ f₁ = C.fromSpecResidueField ξ := by
    show Spec.map ι ≫ Spec.map φU ≫ hU.fromSpec = _
    rw [← Spec.map_comp_assoc, F1, Spec.map_comp_assoc, ← IsAffineOpen.fromSpecStalk,
      IsAffineOpen.fromSpecStalk_eq_fromSpecStalk]
    rfl
  have e2 : Spec.map ι ≫ f₂ = C.fromSpecResidueField ξ := by
    show Spec.map ι ≫ Spec.map φx ≫ C.fromSpecStalk x = _
    rw [← Spec.map_comp_assoc, F2, Spec.map_comp_assoc,
      Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
    rfl
  have heq : f₁ = f₂ := by
    let g : C ⟶ ⊤_ Scheme := q ≫ Limits.terminal.from _
    haveI : IsSeparated g := inferInstance
    let S : ValuativeCommSq g :=
      { R := V, K := C.residueField ξ, i₁ := Spec.map ι ≫ f₁, i₂ := Limits.terminal.from _,
        commSq := ⟨Limits.terminal.hom_ext _ _⟩ }
    haveI hsub : Subsingleton S.commSq.LiftStruct := IsSeparated.valuativeCriterion g S
    let l₁ : S.commSq.LiftStruct := ⟨f₁, rfl, Limits.terminal.hom_ext _ _⟩
    let l₂ : S.commSq.LiftStruct := ⟨f₂, e2.trans e1.symm, Limits.terminal.hom_ext _ _⟩
    exact congrArg CommSq.LiftStruct.l (Subsingleton.elim l₁ l₂)
  haveI : IsLocalHom φx.hom := by
    constructor
    intro s hs
    by_contra hns
    have hm : s ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x) :=
      (IsLocalRing.mem_maximalIdeal _).mpr hns
    have h2 := (hB s).snd hm
    exact ((IsLocalRing.mem_maximalIdeal _).mp h2) hs
  let cp : Spec (CommRingCat.of V) := IsLocalRing.closedPoint V
  have hcp : f₂ cp = x := by
    show (Spec.map φx ≫ C.fromSpecStalk x) cp = x
    rw [Scheme.Hom.comp_apply]
    have hc : (Spec.map φx) cp = IsLocalRing.closedPoint (C.presheaf.stalk x) :=
      Spec_closedPoint
    rw [hc]
    exact Scheme.fromSpecStalk_closedPoint
  have hmem : x ∈ Set.range hU.fromSpec := by
    rw [← hcp, ← heq]
    exact ⟨(Spec.map φU) cp, (Scheme.Hom.comp_apply _ _ _).symm⟩
  rwa [hU.range_fromSpec] at hmem

theorem wcpa_dj_ffv_finite_over_transc (K F : Type u) [Field K] [Field F] [Algebra K F]
    (hF : wcpaDjFF1 K F) :
    ∀ f : F, Transcendental K f → FiniteDimensional (IntermediateField.adjoin K {f}) F :=
by
  have hF' : ∃ t : F, Transcendental K t ∧
      FiniteDimensional (IntermediateField.adjoin K {t}) F := hF
  obtain ⟨t, ht, hfin⟩ := hF'

  have htr : Algebra.trdeg K F = 1 := by
    have hind : AlgebraicIndependent K (Subtype.val : ({t} : Set F) → F) :=
      algebraicIndependent_unique_type_iff.mpr ht
    have halg : Algebra.IsAlgebraic (IntermediateField.adjoin K ({t} : Set F)) F :=
      Algebra.IsAlgebraic.of_finite _ _
    have halg2 : Algebra.IsAlgebraic (Algebra.adjoin K ({t} : Set F)) F :=
      IntermediateField.isAlgebraic_adjoin_iff_top.mp halg
    have hb : IsTranscendenceBasis K (Subtype.val : ({t} : Set F) → F) := by
      rw [hind.isTranscendenceBasis_iff_isAlgebraic, Subtype.range_coe]
      exact halg2
    rw [← hb.cardinalMk_eq_trdeg, Cardinal.mk_singleton]
  intro f hf

  have hindf : AlgebraicIndependent K (Subtype.val : ({f} : Set F) → F) :=
    algebraicIndependent_unique_type_iff.mpr hf
  have hbf : IsTranscendenceBasis K (Subtype.val : ({f} : Set F) → F) :=
    hindf.isTranscendenceBasis_of_trdeg_le_of_finite (by rw [htr, Cardinal.mk_singleton])
  have halgf : Algebra.IsAlgebraic (IntermediateField.adjoin K ({f} : Set F)) F := by
    have := hbf.isAlgebraic_field
    rwa [Subtype.range_coe] at this

  set L := IntermediateField.adjoin K ({t} : Set F) with hLdef
  set M := IntermediateField.adjoin K ({f} : Set F) with hMdef
  let b := Module.finBasis L F
  let S : Set F := insert t (Set.range b)
  have : Finite S := (Set.Finite.insert t (Set.finite_range b)).to_subtype
  have hint : ∀ x ∈ S, IsIntegral M x := fun x _ =>
    (Algebra.IsAlgebraic.isAlgebraic x).isIntegral
  have hE : FiniteDimensional M (IntermediateField.adjoin M S) :=
    IntermediateField.finiteDimensional_adjoin hint
  have htop : IntermediateField.adjoin M S = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hL : L ≤ (IntermediateField.adjoin M S).restrictScalars K := by
      rw [hLdef, IntermediateField.adjoin_simple_le_iff, IntermediateField.mem_restrictScalars]
      exact IntermediateField.subset_adjoin M S (Set.mem_insert t _)
    rw [← b.sum_repr x]
    apply IntermediateField.sum_mem
    intro i _
    rw [Algebra.smul_def, IntermediateField.algebraMap_apply]
    apply IntermediateField.mul_mem
    · exact (IntermediateField.mem_restrictScalars K).mp (hL (b.repr x i).2)
    · exact IntermediateField.subset_adjoin M S (Set.mem_insert_of_mem t (Set.mem_range_self i))
  rw [htop] at hE
  exact LinearEquiv.finiteDimensional
    (IntermediateField.topEquiv : (⊤ : IntermediateField M F) ≃ₐ[M] F).toLinearEquiv

theorem wcpa_dj_ffv_separating (K F : Type u) [Field K] [IsAlgClosed K] [Field F] [Algebra K F]
    (hF : wcpaDjFF1 K F) :
    ∃ z : F, Transcendental K z ∧ Algebra.IsSeparable (IntermediateField.adjoin K {z}) F ∧
      Algebra.IsSeparable (IntermediateField.adjoin K {z⁻¹}) F :=
by
  classical
  obtain ⟨t, ht, hfd⟩ := hF
  haveI := hfd

  haveI h1 : Algebra.EssFiniteType K (IntermediateField.adjoin K ({t} : Set F)) :=
    IntermediateField.essFiniteType_iff.mpr
      (IntermediateField.fg_def.mpr ⟨{t}, Set.finite_singleton t, rfl⟩)
  haveI h2 : Algebra.EssFiniteType (IntermediateField.adjoin K ({t} : Set F)) F := inferInstance
  haveI hEss : Algebra.EssFiniteType K F :=
    Algebra.EssFiniteType.comp K (IntermediateField.adjoin K ({t} : Set F)) F

  have htb : IsTranscendenceBasis K (Subtype.val : ({t} : Set F) → F) := by
    letI : Unique ({t} : Set F) := Set.uniqueSingleton t
    have hind : AlgebraicIndependent K (Subtype.val : ({t} : Set F) → F) :=
      algebraicIndependent_unique_type_iff.mpr (by exact ht)
    haveI : Algebra.IsAlgebraic (IntermediateField.adjoin K ({t} : Set F)) F := inferInstance
    have halg : Algebra.IsAlgebraic (Algebra.adjoin K ({t} : Set F)) F :=
      IntermediateField.isAlgebraic_adjoin_iff_top.mp this
    refine (AlgebraicIndependent.isTranscendenceBasis_iff_isAlgebraic hind).mpr ?_
    rw [Subtype.range_val]
    exact halg

  obtain ⟨s, hs, hsep⟩ := exists_isTranscendenceBasis_and_isSeparable_of_perfectField K F

  have hcard : Cardinal.mk (s : Set F) = 1 := by
    exact (hs.cardinalMk_eq htb).trans (Cardinal.mk_singleton t)
  obtain ⟨hsub, hne⟩ := Cardinal.eq_one_iff_unique.mp hcard
  obtain ⟨⟨z, hz⟩⟩ := hne
  have hsz : (s : Set F) = {z} := by
    refine Set.eq_singleton_iff_unique_mem.mpr ⟨hz, fun y hy => ?_⟩
    haveI := hsub
    exact congrArg Subtype.val (Subsingleton.elim (⟨y, hy⟩ : (s : Set F)) ⟨z, hz⟩)

  have hztr : Transcendental K z := hs.1.transcendental ⟨z, hz⟩
  have hsep' : Algebra.IsSeparable (IntermediateField.adjoin K {z}) F := by
    rw [hsz] at hsep
    exact hsep

  have heq : IntermediateField.adjoin K {z⁻¹} = IntermediateField.adjoin K ({z} : Set F) := by
    apply le_antisymm
    · exact IntermediateField.adjoin_simple_le_iff.mpr
        (IntermediateField.inv_mem _ (IntermediateField.mem_adjoin_simple_self K z))
    · apply IntermediateField.adjoin_simple_le_iff.mpr
      have := IntermediateField.inv_mem _ (IntermediateField.mem_adjoin_simple_self K z⁻¹)
      rwa [inv_inv] at this
  exact ⟨z, hztr, hsep', heq ▸ hsep'⟩

theorem wcpa_dj_ffv_dedekind_subring (K F : Type u) [Field K] [Field F] [Algebra K F] (z : F)
    (hz : Transcendental K z) [FiniteDimensional (IntermediateField.adjoin K {z}) F]
    [Algebra.IsSeparable (IntermediateField.adjoin K {z}) F] :
    ∃ A : Subring F, IsDedekindDomain ↥A ∧ IsFractionRing (↥A) F ∧
      ∀ V : ValuationSubring F, (∀ c : K, algebraMap K F c ∈ V) → z ∈ V → A ≤ V.toSubring :=
by
  classical
  have hDed : IsDedekindDomain ↥(Algebra.adjoin K {z}) := by
    have hrange := Algebra.adjoin_singleton_eq_range_aeval K z
    haveI : IsPrincipalIdealRing ↥((Polynomial.aeval (R := K) z).range) :=
      IsPrincipalIdealRing.of_surjective (Polynomial.aeval (R := K) z).rangeRestrict
        (AlgHom.rangeRestrict_surjective _)
    haveI : IsPrincipalIdealRing ↥(Algebra.adjoin K {z}) := by rw [hrange]; infer_instance
    exact IsPrincipalIdealRing.isDedekindDomain _
  haveI := hDed
  have s2 : ∀ (V : ValuationSubring F) (x : F), (∀ r ∈ Algebra.adjoin K {z}, r ∈ V) →
      _root_.IsIntegral ↥(Algebra.adjoin K {z}) x → x ∈ V := by
    intro V x hR hx
    let ι : ↥(Algebra.adjoin K {z}) →+* ↥V :=
      { toFun := fun r => ⟨r, hR r r.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hcomp : (algebraMap ↥V F).comp ι = algebraMap ↥(Algebra.adjoin K {z}) F := by
      ext r; rfl
    obtain ⟨p, hpm, hp⟩ := hx
    have hxV : _root_.IsIntegral ↥V x :=
      ⟨p.map ι, hpm.map ι, by rw [Polynomial.eval₂_map, hcomp]; exact hp⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hxV
    rw [← hy]; exact y.2
  have hA1 : IsDedekindDomain ↥((integralClosure ↥(Algebra.adjoin K {z}) F).toSubring) := by
    open scoped IntermediateField.algebraAdjoinAdjoin in
    exact integralClosure.isDedekindDomain ↥(Algebra.adjoin K {z})
      ↥(IntermediateField.adjoin K {z}) F
  have hA2 : IsFractionRing ↥((integralClosure ↥(Algebra.adjoin K {z}) F).toSubring) F := by
    open scoped IntermediateField.algebraAdjoinAdjoin in
    exact integralClosure.isFractionRing_of_finite_extension (A := ↥(Algebra.adjoin K {z}))
      ↥(IntermediateField.adjoin K {z}) F
  refine ⟨(integralClosure ↥(Algebra.adjoin K {z}) F).toSubring, hA1, hA2, ?_⟩
  intro V hK hzV x hx
  apply s2 V x
  · intro r hr
    have hle : Algebra.adjoin K {z} ≤ { V.toSubring with algebraMap_mem' := hK } :=
      Algebra.adjoin_le (by simpa using hzV)
    exact hle hr
  · exact hx

theorem wcpa_dj_ffv_dedekind_local (F : Type u) [Field F] (A : Subring F) [IsDedekindDomain ↥A]
    [IsFractionRing (↥A) F] (V : ValuationSubring F) (hAV : A ≤ V.toSubring) (hV : V ≠ ⊤) :
    IsDiscreteValuationRing ↥V ∧
      ∀ x : F, x ∈ V ↔ ∃ a s : F, a ∈ A ∧ s ∈ A ∧ s ≠ 0 ∧ s⁻¹ ∈ V ∧ x = a / s :=
by
  classical
  have hcoe : ∀ y : ↥A, algebraMap (↥A) F y = (y : F) := fun _ => rfl
  let ι : ↥A →+* ↥V :=
    { toFun := fun a => ⟨(a : F), hAV a.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hU : ∀ (y : F) (hy : y ∈ V), IsUnit (⟨y, hy⟩ : ↥V) ↔ (y ≠ 0 ∧ y⁻¹ ∈ V) := by
    intro y hy
    constructor
    · rintro ⟨u, hu⟩
      have h1 : y * (((u⁻¹ : (↥V)ˣ) : ↥V) : F) = 1 := by
        have := congrArg Subtype.val u.mul_inv
        rw [hu] at this
        exact this
      have hy0 : y ≠ 0 := left_ne_zero_of_mul_eq_one h1
      refine ⟨hy0, ?_⟩
      rw [← eq_inv_of_mul_eq_one_right h1]
      exact (((u⁻¹ : (↥V)ˣ) : ↥V)).2
    · rintro ⟨hy0, hyi⟩
      exact isUnit_iff_exists_inv.mpr ⟨⟨y⁻¹, hyi⟩, Subtype.ext (mul_inv_cancel₀ hy0)⟩
  set P : Ideal ↥A := Ideal.comap ι (IsLocalRing.maximalIdeal ↥V) with hPdef
  have hPprime : P.IsPrime := Ideal.comap_isPrime ι _
  have hP : ∀ s : ↥A, s ∉ P ↔ ((s : F) ≠ 0 ∧ (s : F)⁻¹ ∈ V) := by
    intro s
    rw [hPdef, Ideal.mem_comap, IsLocalRing.notMem_maximalIdeal]
    exact hU (s : F) (hAV s.2)
  have hP0 : P ≠ ⊥ := by
    intro hbot
    apply hV
    ext x
    simp only [ValuationSubring.mem_top, iff_true]
    obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := ↥A) x
    have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
    have hbP : b ∉ P := by rw [hbot, Ideal.mem_bot]; exact hb0
    obtain ⟨_, hbinv⟩ := (hP b).1 hbP
    rw [hcoe, hcoe, div_eq_mul_inv]
    exact V.mul_mem _ _ (hAV a.2) hbinv
  have : IsDiscreteValuationRing (Localization.AtPrime P) :=
    IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain ↥A hP0 _
  have hrep : ∀ x : F, x ∈ V → ∃ a s : F, a ∈ A ∧ s ∈ A ∧ s ≠ 0 ∧ s⁻¹ ∈ V ∧ x = a / s := by
    intro x hx
    by_cases hx0 : x = 0
    · exact ⟨0, 1, A.zero_mem, A.one_mem, one_ne_zero, by rw [inv_one]; exact V.one_mem,
        by rw [hx0, zero_div]⟩
    obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := ↥A) x
    rw [hcoe, hcoe] at hx hx0 ⊢
    have hb0 : (b : F) ≠ 0 := by
      have := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors (K := F) hb
      rwa [hcoe] at this
    set j := algebraMap (↥A) (Localization.AtPrime P) with hjdef
    have hj : Function.Injective j :=
      IsLocalization.injective (Localization.AtPrime P) (Ideal.primeCompl_le_nonZeroDivisors P)
    obtain ⟨c, hc⟩ := ValuationRing.cond (j a) (j b)
    obtain ⟨⟨r, t⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl c
    have hspec := IsLocalization.mk'_spec (Localization.AtPrime P) r t
    have htP : (t : ↥A) ∉ P := t.2
    obtain ⟨ht0, htinv⟩ := (hP t).1 htP
    rcases hc with hc | hc
    · have e : a * r = b * (t : ↥A) := hj (by
        rw [map_mul, map_mul, ← hc, mul_assoc, hspec])
      have eF : (a : F) * (r : F) = (b : F) * ((t : ↥A) : F) := congrArg Subtype.val e
      have hr0 : (r : F) ≠ 0 := by
        intro h
        rw [h, mul_zero] at eF
        exact mul_ne_zero hb0 ht0 eF.symm
      by_cases hr : r ∈ P
      · exfalso
        apply (hP r).2 _ hr
        refine ⟨hr0, ?_⟩
        have : (r : F)⁻¹ = (a : F) / (b : F) * ((t : ↥A) : F)⁻¹ := by
          field_simp
          linear_combination -eF
        rw [this]
        exact V.mul_mem _ _ hx htinv
      · obtain ⟨_, hrinv⟩ := (hP r).1 hr
        refine ⟨((t : ↥A) : F), (r : F), (t : ↥A).2, r.2, hr0, hrinv, ?_⟩
        rw [div_eq_div_iff hb0 hr0]
        linear_combination eF
    · have e : b * r = a * (t : ↥A) := hj (by
        rw [map_mul, map_mul, ← hc, mul_assoc, hspec])
      have eF : (b : F) * (r : F) = (a : F) * ((t : ↥A) : F) := congrArg Subtype.val e
      refine ⟨(r : F), ((t : ↥A) : F), r.2, (t : ↥A).2, ht0, htinv, ?_⟩
      rw [div_eq_div_iff hb0 ht0]
      linear_combination -eF
  refine ⟨?_, fun x => ⟨hrep x, ?_⟩⟩
  · letI : Algebra (↥A) (↥V) := ι.toAlgebra
    have : IsLocalization.AtPrime (↥V) P := by
      rw [IsLocalization.AtPrime, isLocalization_iff]
      refine ⟨?_, ?_, ?_⟩
      · intro y
        exact (hU _ _).2 ((hP y).1 y.2)
      · intro z
        obtain ⟨a, s, ha, hs, hs0, hsinv, hz⟩ := hrep z z.2
        refine ⟨(⟨a, ha⟩, ⟨⟨s, hs⟩, (hP _).2 ⟨hs0, hsinv⟩⟩), ?_⟩
        apply Subtype.ext
        show (z : F) * s = a
        rw [hz, div_mul_cancel₀ _ hs0]
      · intro x y hxy
        refine ⟨1, ?_⟩
        have h2 : x = y := Subtype.ext (congrArg (fun z : ↥V => (z : F)) hxy)
        rw [h2]
    exact IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain ↥A hP0 ↥V
  · rintro ⟨a, s, ha, _, _, hsinv, rfl⟩
    rw [div_eq_mul_inv]
    exact V.mul_mem _ _ (hAV ha) hsinv

theorem wcpa_dj_ffv_dedekind_finite (F : Type u) [Field F] (A : Subring F) [IsDedekindDomain ↥A]
    [IsFractionRing (↥A) F]
    (hchar : ∀ V : ValuationSubring F, A ≤ V.toSubring → V ≠ ⊤ →
      ∀ x : F, x ∈ V ↔ ∃ a s : F, a ∈ A ∧ s ∈ A ∧ s ≠ 0 ∧ s⁻¹ ∈ V ∧ x = a / s) :
    ∀ x : F, x ≠ 0 →
      {V : ValuationSubring F | A ≤ V.toSubring ∧ V ≠ ⊤ ∧ ¬ (x ∈ V ∧ x⁻¹ ∈ V)}.Finite :=
by
  classical
  intro x hx
  let g : ValuationSubring F → Ideal ↥A := fun V =>
    if h : A ≤ V.toSubring then Ideal.comap (Subring.inclusion h) (IsLocalRing.maximalIdeal ↥V)
    else ⊥
  have s1 : ∀ (V : ValuationSubring F) (h : A ≤ V.toSubring) (y : ↥A), (y : F) ≠ 0 →
      ((y : F)⁻¹ ∈ V ↔ y ∉ g V) := by
    intro V h y hy
    simp only [g, dif_pos h, Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
      not_not]
    constructor
    · intro hinv
      exact isUnit_iff_exists_inv.mpr ⟨⟨(y : F)⁻¹, hinv⟩, Subtype.ext (mul_inv_cancel₀ hy)⟩
    · intro hu
      obtain ⟨u, hu'⟩ := hu.exists_right_inv
      have h2 : (y : F) * (u : F) = 1 := congrArg Subtype.val hu'
      rw [← eq_inv_of_mul_eq_one_right h2]
      exact u.2
  have s2 : ∀ (V : ValuationSubring F) (h : A ≤ V.toSubring), (g V).IsPrime := by
    intro V h
    simp only [g, dif_pos h]
    haveI := (IsLocalRing.maximalIdeal.isMaximal ↥V).isPrime
    exact Ideal.comap_isPrime _ _
  have s3 : ∀ (V : ValuationSubring F) (h : A ≤ V.toSubring), V ≠ ⊤ → g V ≠ ⊥ := by
    intro V h hV hbot
    apply hV
    ext t
    simp only [ValuationSubring.mem_top, iff_true]
    obtain ⟨c, d, hd, hcd⟩ := IsFractionRing.div_surjective (A := ↥A) t
    have hd0 : (d : F) ≠ 0 := by
      intro h0
      exact nonZeroDivisors.ne_zero hd (Subtype.ext h0)
    have hdinv : (d : F)⁻¹ ∈ V := by
      rw [s1 V h d hd0, hbot]
      intro hm
      exact hd0 (by rw [Ideal.mem_bot.mp hm]; rfl)
    rw [← hcd, div_eq_mul_inv]
    exact V.mul_mem _ _ (h c.2) hdinv
  have s4 : ∀ (V W : ValuationSubring F) (hV : A ≤ V.toSubring) (hW : A ≤ W.toSubring),
      V ≠ ⊤ → W ≠ ⊤ → g V = g W → V = W := by
    intro V W hV hW hV' hW' hg
    have key : ∀ s : F, s ∈ A → s ≠ 0 → (s⁻¹ ∈ V ↔ s⁻¹ ∈ W) := by
      intro s hs hs0
      have e1 := s1 V hV ⟨s, hs⟩ hs0
      have e2 := s1 W hW ⟨s, hs⟩ hs0
      rw [e1, e2, hg]
    ext z
    rw [hchar V hV hV' z, hchar W hW hW' z]
    constructor
    · rintro ⟨a, s, ha, hs, hs0, hsV, rfl⟩
      exact ⟨a, s, ha, hs, hs0, (key s hs hs0).mp hsV, rfl⟩
    · rintro ⟨a, s, ha, hs, hs0, hsW, rfl⟩
      exact ⟨a, s, ha, hs, hs0, (key s hs hs0).mpr hsW, rfl⟩
  obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective (A := ↥A) x
  have hb0' : b ≠ 0 := nonZeroDivisors.ne_zero hb
  have hb0 : (b : F) ≠ 0 := fun h0 => hb0' (Subtype.ext h0)
  have ha0 : (a : F) ≠ 0 := by
    intro h0
    apply hx
    rw [← hab]
    show (a : F) / (b : F) = 0
    rw [h0, zero_div]
  have ha0' : a ≠ 0 := fun h => ha0 (by rw [h]; rfl)
  have hx' : x = (a : F) * (b : F)⁻¹ := by
    rw [← hab, div_eq_mul_inv]
    rfl
  have s6 : ∀ (V : ValuationSubring F) (h : A ≤ V.toSubring), ¬ (x ∈ V ∧ x⁻¹ ∈ V) →
      a ∈ g V ∨ b ∈ g V := by
    intro V h hnu
    by_contra hcon
    push_neg at hcon
    obtain ⟨ha, hb'⟩ := hcon
    have hai := (s1 V h a ha0).mpr ha
    have hbi := (s1 V h b hb0).mpr hb'
    apply hnu
    constructor
    · rw [hx']
      exact V.mul_mem _ _ (h a.2) hbi
    · rw [hx', mul_inv, inv_inv]
      exact V.mul_mem _ _ hai (h b.2)
  have hTa : {v : IsDedekindDomain.HeightOneSpectrum ↥A | v.asIdeal ∣ Ideal.span {a}}.Finite :=
    Ideal.finite_factors (by rw [Ne, Submodule.zero_eq_bot, Ideal.span_singleton_eq_bot]; exact ha0')
  have hTb : {v : IsDedekindDomain.HeightOneSpectrum ↥A |
      v.asIdeal ∣ Ideal.span {(b : ↥A)}}.Finite :=
    Ideal.finite_factors (by rw [Ne, Submodule.zero_eq_bot, Ideal.span_singleton_eq_bot]; exact hb0')
  have hmem : ∀ (v : IsDedekindDomain.HeightOneSpectrum ↥A) (y : ↥A), y ∈ v.asIdeal →
      v.asIdeal ∣ Ideal.span {y} := fun v y hy =>
    Ideal.dvd_iff_le.mpr (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hy))
  refine Set.Finite.of_injOn (f := g)
    (t := IsDedekindDomain.HeightOneSpectrum.asIdeal ''
      ({v : IsDedekindDomain.HeightOneSpectrum ↥A | v.asIdeal ∣ Ideal.span {a}} ∪
        {v : IsDedekindDomain.HeightOneSpectrum ↥A | v.asIdeal ∣ Ideal.span {(b : ↥A)}}))
    ?_ ?_ ((hTa.union hTb).image _)
  · rintro V ⟨h, hV, hnu⟩
    refine ⟨⟨g V, s2 V h, s3 V h hV⟩, ?_, rfl⟩
    rcases s6 V h hnu with h1 | h1
    · exact Or.inl (hmem _ _ h1)
    · exact Or.inr (hmem _ _ h1)
  · rintro V ⟨hV, hV', -⟩ W ⟨hW, hW', -⟩ hg
    exact s4 V W hV hW hV' hW' hg

theorem wcpa_dj_ffv_valord_dvr (F : Type u) [Field F] (V : ValuationSubring F)
    [IsDiscreteValuationRing ↥V] :
    (∃ π : F, π ≠ 0 ∧ wcpaDjValOrd V π = 1) ∧
    (∀ x y : F, x ≠ 0 → y ≠ 0 → wcpaDjValOrd V (x * y) = wcpaDjValOrd V x + wcpaDjValOrd V y) ∧
    (∀ x : F, x ≠ 0 → (x ∈ V ↔ 0 ≤ wcpaDjValOrd V x)) ∧
    (∀ x y : F, x ≠ 0 → y ≠ 0 → x + y ≠ 0 →
      min (wcpaDjValOrd V x) (wcpaDjValOrd V y) ≤ wcpaDjValOrd V (x + y)) ∧
    (∀ x : F, x ≠ 0 → (wcpaDjValOrd V x = 0 ↔ (x ∈ V ∧ x⁻¹ ∈ V))) :=
by
  classical
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible ↥V
  have hp0 : ((ϖ : ↥V) : F) ≠ 0 := fun h => hϖ.ne_zero (Subtype.ext h)
  have hcmul : ∀ a b : ↥V, ((a * b : ↥V) : F) = (a : F) * (b : F) := fun a b => rfl
  have hcpow : ∀ (a : ↥V) (n : ℕ), ((a ^ n : ↥V) : F) = (a : F) ^ n := fun a n => by
    induction n with
    | zero => rw [pow_zero, pow_zero]; rfl
    | succ n ih => rw [pow_succ, pow_succ, hcmul, ih]
  have hw0 : ∀ w : (↥V)ˣ, ((w : ↥V) : F) ≠ 0 := fun w h => w.ne_zero (Subtype.ext h)
  have hinv : ∀ w : (↥V)ˣ, (((w⁻¹ : (↥V)ˣ) : ↥V) : F) = ((w : ↥V) : F)⁻¹ := by
    intro w
    symm
    apply inv_eq_of_mul_eq_one_right
    rw [← hcmul, Units.mul_inv]
    rfl

  have s1 : ∀ (w : (↥V)ˣ) (k : ℤ), ((w : ↥V) : F) * ((ϖ : ↥V) : F) ^ k ∈ V ↔ 0 ≤ k := by
    intro w k
    constructor
    · intro h
      by_contra hk
      push_neg at hk
      obtain ⟨m, hm⟩ : ∃ m : ℕ, k = -((m : ℕ) : ℤ) := ⟨(-k).toNat, by omega⟩
      have hm1 : m ≠ 0 := by omega
      have ht : (((ϖ : ↥V) : F) ^ m)⁻¹ ∈ V := by
        have h2 : (((w⁻¹ : (↥V)ˣ) : ↥V) : F) * (((w : ↥V) : F) * ((ϖ : ↥V) : F) ^ k) ∈ V :=
          V.mul_mem _ _ (SetLike.coe_mem _) h
        rw [hinv, ← mul_assoc, inv_mul_cancel₀ (hw0 w), one_mul, hm, zpow_neg,
          zpow_natCast] at h2
        exact h2
      apply hϖ.not_isUnit
      have hu : IsUnit (ϖ ^ m) := by
        refine isUnit_iff_exists_inv.mpr ⟨⟨(((ϖ : ↥V) : F) ^ m)⁻¹, ht⟩, ?_⟩
        apply Subtype.ext
        rw [hcmul, hcpow]
        exact mul_inv_cancel₀ (pow_ne_zero _ hp0)
      exact (isUnit_pow_iff hm1).mp hu
    · intro hk
      obtain ⟨n, rfl⟩ := Int.eq_ofNat_of_zero_le hk
      rw [zpow_natCast, ← hcpow, ← hcmul]
      exact SetLike.coe_mem _

  have s2 : ∀ (w : (↥V)ˣ) (k : ℤ) (y : F), y = ((w : ↥V) : F) * ((ϖ : ↥V) : F) ^ k →
      sSup {n : ℕ | ∃ h : y ∈ V, (⟨y, h⟩ : ↥V) ∈ (IsLocalRing.maximalIdeal ↥V) ^ n} =
        k.toNat := by
    intro w k y hy
    have hmem := s1 w k
    rw [← hy] at hmem
    by_cases hk : 0 ≤ k
    · obtain ⟨n, rfl⟩ := Int.eq_ofNat_of_zero_le hk
      have hyV : y ∈ V := hmem.mpr hk
      have hye : ∀ h : y ∈ V, (⟨y, h⟩ : ↥V) = (w : ↥V) * ϖ ^ n := by
        intro h
        apply Subtype.ext
        rw [hcmul, hcpow]
        show y = _
        rw [hy, zpow_natCast]
      have hS : {m : ℕ | ∃ h : y ∈ V, (⟨y, h⟩ : ↥V) ∈ (IsLocalRing.maximalIdeal ↥V) ^ m} =
          Set.Iic n := by
        ext m
        simp only [Set.mem_setOf_eq, Set.mem_Iic]
        constructor
        · rintro ⟨h, hm⟩
          rw [hye h, hϖ.maximalIdeal_eq, Ideal.span_singleton_pow, Ideal.mem_span_singleton,
            Units.dvd_mul_left] at hm
          exact (pow_dvd_pow_iff hϖ.ne_zero hϖ.not_isUnit).mp hm
        · intro hm
          refine ⟨hyV, ?_⟩
          rw [hye hyV, hϖ.maximalIdeal_eq, Ideal.span_singleton_pow, Ideal.mem_span_singleton,
            Units.dvd_mul_left]
          exact (pow_dvd_pow_iff hϖ.ne_zero hϖ.not_isUnit).mpr hm
      rw [hS, csSup_Iic]
      simp
    · have hyV : y ∉ V := fun h => hk (hmem.mp h)
      have hS : {m : ℕ | ∃ h : y ∈ V, (⟨y, h⟩ : ↥V) ∈ (IsLocalRing.maximalIdeal ↥V) ^ m} =
          ∅ := by
        ext m
        simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
        rintro ⟨h, _⟩
        exact hyV h
      rw [hS, csSup_empty]
      exact (Int.toNat_eq_zero.mpr (by omega)).symm

  have s3 : ∀ x : F, x ≠ 0 → ∃ (w : (↥V)ˣ) (k : ℤ), x = ((w : ↥V) : F) * ((ϖ : ↥V) : F) ^ k := by
    intro x hx
    rcases V.mem_or_inv_mem x with h | h
    · have ha : (⟨x, h⟩ : ↥V) ≠ 0 := fun h0 => hx (congrArg Subtype.val h0)
      obtain ⟨n, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha hϖ
      refine ⟨u, n, ?_⟩
      rw [zpow_natCast, ← hcpow, ← hcmul]
      exact congrArg Subtype.val hu
    · have hx' : x⁻¹ ≠ 0 := inv_ne_zero hx
      have ha : (⟨x⁻¹, h⟩ : ↥V) ≠ 0 := fun h0 => hx' (congrArg Subtype.val h0)
      obtain ⟨n, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha hϖ
      refine ⟨u⁻¹, -(n : ℤ), ?_⟩
      have h1 : x⁻¹ = ((u : ↥V) : F) * ((ϖ : ↥V) : F) ^ n := by
        rw [← hcpow, ← hcmul]
        exact congrArg Subtype.val hu
      rw [hinv, zpow_neg, zpow_natCast, ← mul_inv, ← h1, inv_inv]

  have hinvrep : ∀ (w : (↥V)ˣ) (k : ℤ), (((w : ↥V) : F) * ((ϖ : ↥V) : F) ^ k)⁻¹ =
      (((w⁻¹ : (↥V)ˣ) : ↥V) : F) * ((ϖ : ↥V) : F) ^ (-k) := by
    intro w k
    rw [mul_inv, hinv, zpow_neg]
  have s4 : ∀ (w : (↥V)ˣ) (k : ℤ),
      wcpaDjValOrd V (((w : ↥V) : F) * ((ϖ : ↥V) : F) ^ k) = k := by
    intro w k
    unfold wcpaDjValOrd
    rw [s2 w k _ rfl, s2 w⁻¹ (-k) _ (hinvrep w k)]
    exact Int.toNat_sub_toNat_neg k
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · refine ⟨((ϖ : ↥V) : F), hp0, ?_⟩
    have h := s4 1 1
    have e : (((1 : (↥V)ˣ) : ↥V) : F) * ((ϖ : ↥V) : F) ^ (1 : ℤ) = ((ϖ : ↥V) : F) := by
      simp
    rw [e] at h
    exact h
  · intro x y hx hy
    obtain ⟨w, k, rfl⟩ := s3 x hx
    obtain ⟨w', l, rfl⟩ := s3 y hy
    have e : (((w : ↥V) : F) * ((ϖ : ↥V) : F) ^ k) * (((w' : ↥V) : F) * ((ϖ : ↥V) : F) ^ l) =
        (((w * w' : (↥V)ˣ) : ↥V) : F) * ((ϖ : ↥V) : F) ^ (k + l) := by
      rw [Units.val_mul, hcmul, zpow_add₀ hp0]
      ring
    rw [e, s4, s4, s4]
  · intro x hx
    obtain ⟨w, k, rfl⟩ := s3 x hx
    rw [s4]
    exact s1 w k
  · have A : ∀ (w w' : (↥V)ˣ) (k l : ℤ), k ≤ l →
        ((w : ↥V) : F) * ((ϖ : ↥V) : F) ^ k + ((w' : ↥V) : F) * ((ϖ : ↥V) : F) ^ l ≠ 0 →
        k ≤ wcpaDjValOrd V
          (((w : ↥V) : F) * ((ϖ : ↥V) : F) ^ k + ((w' : ↥V) : F) * ((ϖ : ↥V) : F) ^ l) := by
      intro w w' k l hkl hne
      have hsV : ((w : ↥V) : F) + ((w' : ↥V) : F) * ((ϖ : ↥V) : F) ^ (l - k) ∈ V :=
        V.add_mem _ _ (SetLike.coe_mem _) ((s1 w' (l - k)).mpr (by omega))
      have hpl : ((ϖ : ↥V) : F) ^ l = ((ϖ : ↥V) : F) ^ k * ((ϖ : ↥V) : F) ^ (l - k) := by
        rw [← zpow_add₀ hp0]
        congr 1
        ring
      have hsum : ((w : ↥V) : F) * ((ϖ : ↥V) : F) ^ k + ((w' : ↥V) : F) * ((ϖ : ↥V) : F) ^ l =
          ((ϖ : ↥V) : F) ^ k *
            (((w : ↥V) : F) + ((w' : ↥V) : F) * ((ϖ : ↥V) : F) ^ (l - k)) := by
        rw [hpl]
        ring
      have hs0 : ((w : ↥V) : F) + ((w' : ↥V) : F) * ((ϖ : ↥V) : F) ^ (l - k) ≠ 0 := by
        intro h0
        apply hne
        rw [hsum, h0, mul_zero]
      obtain ⟨w'', j, hj⟩ := s3 _ hs0
      have hj0 : 0 ≤ j := (s1 w'' j).mp (hj ▸ hsV)
      have e2 : ((ϖ : ↥V) : F) ^ k * (((w'' : ↥V) : F) * ((ϖ : ↥V) : F) ^ j) =
          ((w'' : ↥V) : F) * ((ϖ : ↥V) : F) ^ (k + j) := by
        rw [zpow_add₀ hp0]
        ring
      rw [hsum, hj, e2, s4]
      omega
    intro x y hx hy hxy
    obtain ⟨w, k, rfl⟩ := s3 x hx
    obtain ⟨w', l, rfl⟩ := s3 y hy
    rw [s4, s4]
    rcases le_total k l with hkl | hlk
    · exact (min_le_left _ _).trans (A w w' k l hkl hxy)
    · rw [add_comm] at hxy ⊢
      exact (min_le_right _ _).trans (A w' w l k hlk hxy)
  · intro x hx
    obtain ⟨w, k, rfl⟩ := s3 x hx
    rw [s4, hinvrep, s1, s1]
    omega

theorem wcpa_dj_ffv_integral_const (K F : Type u) [Field K] [IsAlgClosed K] [Field F] [Algebra K F] :
    (∀ x : F, IsAlgebraic K x → ∃ c : K, algebraMap K F c = x) ∧
    (∀ x : F, (∀ V : ValuationSubring F, wcpaDjNtV' K V → x ∈ V) →
      ∃ c : K, algebraMap K F c = x) :=
by
  classical
  have hA : ∀ x : F, IsAlgebraic K x → ∃ c : K, algebraMap K F c = x := by
    intro x hx
    have hint : IsIntegral K x := hx.isIntegral
    have hirr : Irreducible (minpoly K x) := minpoly.irreducible hint
    have hdeg : (minpoly K x).degree = 1 := IsAlgClosed.degree_eq_one_of_irreducible K hirr
    have hnat : (minpoly K x).natDegree = 1 := Polynomial.natDegree_eq_of_degree_eq_some hdeg
    exact RingHom.mem_range.mp (minpoly.natDegree_eq_one_iff.mp hnat)
  refine ⟨hA, ?_⟩
  intro x hV
  have hclaim : ∀ V : ValuationSubring F,
      Set.range (algebraMap K F) ⊆ (V.toSubring : Set F) → x ∈ V.toSubring := by
    intro V hsV
    by_cases htop : V = ⊤
    · subst htop
      exact ValuationSubring.mem_top x
    · exact hV V ⟨fun c => hsV (Set.mem_range_self c), htop⟩
  have hmem : x ∈ ⨅ (V : {V : ValuationSubring F //
      Set.range (algebraMap K F) ⊆ (V.toSubring : Set F)}), (V : ValuationSubring F).toSubring :=
    Subring.mem_iInf.mpr (fun V => hclaim V.1 V.2)
  rw [iInf_valuationSubring_superset] at hmem
  have hxS : IsIntegral (Subring.closure (Set.range (algebraMap K F))) x :=
    (mem_integralClosure_iff _ F).mp hmem
  have hSle : Subring.closure (Set.range (algebraMap K F)) ≤ (algebraMap K F).range :=
    Subring.closure_le.mpr (by rw [RingHom.coe_range])
  obtain ⟨p, hpm, hp0⟩ := hxS
  have hPm : (p.map (algebraMap (Subring.closure (Set.range (algebraMap K F))) F)).Monic :=
    hpm.map _
  have hPe : Polynomial.eval x
      (p.map (algebraMap (Subring.closure (Set.range (algebraMap K F))) F)) = 0 := by
    rw [Polynomial.eval_map]
    exact hp0
  have hlift : p.map (algebraMap (Subring.closure (Set.range (algebraMap K F))) F) ∈
      Polynomial.lifts (algebraMap K F) := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro n
    rw [Polynomial.coeff_map]
    exact RingHom.mem_range.mp (hSle (p.coeff n).2)
  obtain ⟨q, hqP, -, hqm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hPm
  have hxK : IsIntegral K x := ⟨q, hqm, by rw [Polynomial.eval₂_eq_eval_map, hqP]; exact hPe⟩
  exact hA x hxK.isAlgebraic

theorem wcpa_dj_ffv_finrank (K F : Type u) [Field K] [Field F] [Algebra K F]
    (htr : ∀ f : F, f ∉ Set.range (algebraMap K F) → Transcendental K f)
    (hfd : ∀ f : F, Transcendental K f → FiniteDimensional (IntermediateField.adjoin K {f}) F) :
    wcRRFinRank K F :=
by
  classical
  unfold wcRRFinRank
  intro f hfr
  have hf : Transcendental K f := htr f hfr
  haveI : FiniteDimensional (IntermediateField.adjoin K {f}) F := hfd f hf
  have key : ∀ q : Polynomial K,
      algebraMap (IntermediateField.adjoin K {f}) F
        (Polynomial.aeval (IntermediateField.AdjoinSimple.gen K f) q) = Polynomial.aeval f q := by
    intro q
    rw [← Polynomial.aeval_algebraMap_apply, IntermediateField.AdjoinSimple.algebraMap_gen]
  refine ⟨Module.finrank (IntermediateField.adjoin K {f}) F,
    ⟨Module.finBasis (IntermediateField.adjoin K {f}) F, ?_⟩, ?_⟩
  · intro p hp
    have hb := (Module.finBasis (IntermediateField.adjoin K {f}) F).linearIndependent
    have hc : ∑ j, (Polynomial.aeval (IntermediateField.AdjoinSimple.gen K f) (p j)) •
        (Module.finBasis (IntermediateField.adjoin K {f}) F) j = 0 := by
      simp only [Algebra.smul_def, key]
      exact hp
    have hc0 := Fintype.linearIndependent_iff.mp hb _ hc
    funext j
    have h0 : Polynomial.aeval f (p j) = 0 := by rw [← key, hc0 j, map_zero]
    exact (transcendental_iff.mp hf) _ h0
  · intro v
    have hnli : ¬ LinearIndependent (IntermediateField.adjoin K {f}) v := by
      intro h
      have := h.fintype_card_le_finrank
      simp at this
    obtain ⟨g, hg, i₀, hi₀⟩ := Fintype.not_linearIndependent_iff.mp hnli
    have hrs : ∀ i, ∃ r s : Polynomial K,
        ((g i : IntermediateField.adjoin K {f}) : F) * Polynomial.aeval f s = Polynomial.aeval f r ∧
          Polynomial.aeval f s ≠ 0 := by
      intro i
      by_cases hgi : g i = 0
      · exact ⟨0, 1, by simp [hgi], by simp⟩
      · obtain ⟨r, s, hrs⟩ := (IntermediateField.mem_adjoin_simple_iff K _).mp (g i).2
        have hs : Polynomial.aeval f s ≠ 0 := by
          intro h0
          rw [h0, div_zero] at hrs
          exact hgi (Subtype.ext hrs)
        exact ⟨r, s, by rw [hrs, div_mul_cancel₀ _ hs], hs⟩
    choose r s hr hs using hrs
    have hΔ0 : (∏ j, Polynomial.aeval f (s j)) ≠ 0 :=
      Finset.prod_ne_zero_iff.mpr (fun j _ => hs j)
    have hp : ∀ i, Polynomial.aeval f (r i * ∏ j ∈ Finset.univ.erase i, s j) =
        ((g i : IntermediateField.adjoin K {f}) : F) * ∏ j, Polynomial.aeval f (s j) := by
      intro i
      rw [Polynomial.aeval_mul, map_prod, ← hr i, mul_assoc,
        Finset.mul_prod_erase Finset.univ (fun j => Polynomial.aeval f (s j)) (Finset.mem_univ i)]
    refine ⟨fun i => r i * ∏ j ∈ Finset.univ.erase i, s j, ?_, ?_⟩
    · intro h
      have h1 := congrFun h i₀
      simp only [Pi.zero_apply] at h1
      have h2 := hp i₀
      rw [h1, map_zero] at h2
      apply hi₀
      have h3 : ((g i₀ : IntermediateField.adjoin K {f}) : F) = 0 := by
        rcases mul_eq_zero.mp h2.symm with h | h
        · exact h
        · exact absurd h hΔ0
      exact Subtype.ext h3
    · simp only [hp]
      have hg' : ∑ i, ((g i : IntermediateField.adjoin K {f}) : F) * v i = 0 := by
        simpa [Algebra.smul_def] using hg
      calc ∑ i, ((g i : IntermediateField.adjoin K {f}) : F) * (∏ j, Polynomial.aeval f (s j)) * v i
          = (∏ j, Polynomial.aeval f (s j)) *
              ∑ i, ((g i : IntermediateField.adjoin K {f}) : F) * v i := by
            rw [Finset.mul_sum]
            exact Finset.sum_congr rfl (fun i _ => by ring)
        _ = 0 := by rw [hg', mul_zero]

theorem wcpa_dj_cdp_ff_valuations (K F : Type u) [Field K] [IsAlgClosed K] [Field F] [Algebra K F]
    (hF : wcpaDjFF1 K F) :
    (∃ u : ValuationSubring F → F, ∀ V, wcpaDjNtV' K V → wcpaDjValOrd V (u V) = 1) ∧
    (∀ V : ValuationSubring F, wcpaDjNtV' K V → ∀ x y : F, x ≠ 0 → y ≠ 0 →
      wcpaDjValOrd V (x * y) = wcpaDjValOrd V x + wcpaDjValOrd V y) ∧
    (∀ x : F, x ≠ 0 → {V : ValuationSubring F | wcpaDjNtV' K V ∧ wcpaDjValOrd V x ≠ 0}.Finite) ∧
    (∀ x : F, x ≠ 0 →
      ∑ᶠ V, Set.indicator {V : ValuationSubring F | wcpaDjNtV' K V} (fun V => wcpaDjValOrd V x) V
        = 0) ∧
    (∀ x : F, wcpaDjValOrd (⊤ : ValuationSubring F) x = 0) :=
by
  classical

  have hfd := wcpa_dj_ffv_finite_over_transc K F hF
  obtain ⟨z, hz, hsep, hsep'⟩ := wcpa_dj_ffv_separating K F hF
  have hz' : Transcendental K z⁻¹ := by
    intro h
    exact hz (IsAlgebraic.inv_iff.mp h)
  haveI := hfd z hz
  haveI := hfd z⁻¹ hz'
  haveI := hsep
  haveI := hsep'

  obtain ⟨A₁, hA₁d, hA₁f, hA₁⟩ := wcpa_dj_ffv_dedekind_subring K F z hz
  obtain ⟨A₂, hA₂d, hA₂f, hA₂⟩ := wcpa_dj_ffv_dedekind_subring K F z⁻¹ hz'
  haveI := hA₁d
  haveI := hA₁f
  haveI := hA₂d
  haveI := hA₂f
  have cover : ∀ V : ValuationSubring F, wcpaDjNtV' K V →
      A₁ ≤ V.toSubring ∨ A₂ ≤ V.toSubring := by
    intro V hV
    rcases V.mem_or_inv_mem z with h | h
    · exact Or.inl (hA₁ V hV.1 h)
    · exact Or.inr (hA₂ V hV.1 h)

  have hdvr : ∀ V : ValuationSubring F, wcpaDjNtV' K V → IsDiscreteValuationRing ↥V := by
    intro V hV
    rcases cover V hV with h | h
    · exact (wcpa_dj_ffv_dedekind_local F A₁ V h hV.2).1
    · exact (wcpa_dj_ffv_dedekind_local F A₂ V h hV.2).1

  have hv := fun (V : ValuationSubring F) (hV : wcpaDjNtV' K V) =>
    @wcpa_dj_ffv_valord_dvr F _ V (hdvr V hV)

  have hfin3 : ∀ x : F, x ≠ 0 →
      {V : ValuationSubring F | wcpaDjNtV' K V ∧ wcpaDjValOrd V x ≠ 0}.Finite := by
    intro x hx
    have h1 := wcpa_dj_ffv_dedekind_finite F A₁
      (fun V h h' => (wcpa_dj_ffv_dedekind_local F A₁ V h h').2) x hx
    have h2 := wcpa_dj_ffv_dedekind_finite F A₂
      (fun V h h' => (wcpa_dj_ffv_dedekind_local F A₂ V h h').2) x hx
    refine (h1.union h2).subset ?_
    rintro V ⟨hV, hne⟩
    have hnu : ¬ (x ∈ V ∧ x⁻¹ ∈ V) := fun h => hne (((hv V hV).2.2.2.2 x hx).mpr h)
    rcases cover V hV with h | h
    · exact Or.inl ⟨h, hV.2, hnu⟩
    · exact Or.inr ⟨h, hV.2, hnu⟩

  have key : ∀ y : F, sSup {n : ℕ | ∃ h : y ∈ (⊤ : ValuationSubring F),
      (⟨y, h⟩ : ↥(⊤ : ValuationSubring F)) ∈
        (IsLocalRing.maximalIdeal ↥(⊤ : ValuationSubring F)) ^ n} = 0 := by
    intro y
    by_cases hy : y = 0
    · subst hy
      apply Nat.sSup_of_not_bddAbove
      rintro ⟨b, hb⟩
      have hmem : b + 1 ∈ {n : ℕ | ∃ h : (0 : F) ∈ (⊤ : ValuationSubring F),
          (⟨0, h⟩ : ↥(⊤ : ValuationSubring F)) ∈
            (IsLocalRing.maximalIdeal ↥(⊤ : ValuationSubring F)) ^ n} :=
        ⟨trivial, Ideal.zero_mem _⟩
      have := hb hmem
      omega
    · apply Nat.eq_zero_of_le_zero
      apply csSup_le'
      rintro n ⟨h, hn⟩
      by_contra hpos
      have hn0 : n ≠ 0 := by omega
      have hm : (⟨y, h⟩ : ↥(⊤ : ValuationSubring F)) ∈
          IsLocalRing.maximalIdeal ↥(⊤ : ValuationSubring F) := Ideal.pow_le_self hn0 hn
      have hunit : IsUnit (⟨y, h⟩ : ↥(⊤ : ValuationSubring F)) :=
        isUnit_iff_exists_inv.mpr ⟨⟨y⁻¹, trivial⟩, Subtype.ext (mul_inv_cancel₀ hy)⟩
      exact (IsLocalRing.mem_maximalIdeal _).mp hm hunit
  have hgoal5 : ∀ x : F, wcpaDjValOrd (⊤ : ValuationSubring F) x = 0 := by
    intro x
    unfold wcpaDjValOrd
    rw [key x, key x⁻¹]
    simp

  have hconst := (wcpa_dj_ffv_integral_const K F).2
  have htr : ∀ f : F, f ∉ Set.range (algebraMap K F) → Transcendental K f := by
    intro f hf halg
    exact hf ((wcpa_dj_ffv_integral_const K F).1 f halg)
  have hA6 := wcpa_dj_ffv_finrank K F htr hfd
  let w : {V : ValuationSubring F // wcpaDjNtV' K V} → Additive Fˣ →+ ℤ := fun V =>
    AddMonoidHom.mk' (fun a => wcpaDjValOrd V.1 ((Additive.toMul a : Fˣ) : F)) (by
      intro a b
      simp only [toMul_add, Units.val_mul]
      exact (hv V.1 V.2).2.1 _ _ (Units.ne_zero _) (Units.ne_zero _))
  have hform : ∀ (V : {V : ValuationSubring F // wcpaDjNtV' K V}) (f : Fˣ),
      w V (Additive.ofMul f) = wcpaDjValOrd V.1 (f : F) := fun V f => rfl
  have hw : wcValFamily K F {V : ValuationSubring F // wcpaDjNtV' K V} w := by
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro i a b h hh
      rw [hform, hform, hform, hh]
      have hab : (a : F) + (b : F) ≠ 0 := by rw [← hh]; exact h.ne_zero
      exact (hv i.1 i.2).2.2.2.1 _ _ a.ne_zero b.ne_zero hab
    · intro f
      refine ((hfin3 f f.ne_zero).preimage Subtype.val_injective.injOn).subset ?_
      intro i hi
      refine ⟨i.2, ?_⟩
      have hi' : w i (Additive.ofMul f) ≠ 0 := hi
      rwa [hform] at hi'
    · intro i
      obtain ⟨π, hπ, h1⟩ := (hv i.1 i.2).1
      exact ⟨Units.mk0 π hπ, by rw [hform]; exact h1⟩
    · intro f
      constructor
      · intro h
        apply hconst
        intro V hV
        have := h ⟨V, hV⟩
        rw [hform] at this
        exact ((hv V hV).2.2.1 f f.ne_zero).mpr this
      · rintro ⟨c, hc⟩ i
        rw [hform]
        apply ((hv i.1 i.2).2.2.1 f f.ne_zero).mp
        rw [← hc]
        exact i.2.1 c
  have hinj : Function.Injective w := by
    intro V W hVW
    have heq : ∀ x : F, x ≠ 0 → wcpaDjValOrd V.1 x = wcpaDjValOrd W.1 x := by
      intro x hx
      have := DFunLike.congr_fun hVW (Additive.ofMul (Units.mk0 x hx))
      rw [hform, hform] at this
      exact this
    apply Subtype.ext
    ext x
    by_cases hx : x = 0
    · subst hx
      exact ⟨fun _ => W.1.zero_mem, fun _ => V.1.zero_mem⟩
    · rw [(hv V.1 V.2).2.2.1 x hx, (hv W.1 W.2).2.2.1 x hx, heq x hx]
  have hR := wc_rr_residue_trivial K F _ w hw hA6
  have hD := wc_rr_dimension_step K F _ w hw hR
  have hP := wc_rr_pole_degree_le K F _ w hw hinj hR
  have h0 := wc_rr_degree_zero K F _ w hw hA6 hD hP
  have hgoal4 : ∀ x : F, x ≠ 0 →
      ∑ᶠ V, Set.indicator {V : ValuationSubring F | wcpaDjNtV' K V}
        (fun V => wcpaDjValOrd V x) V = 0 := by
    intro x hx
    have e := h0 (Units.mk0 x hx)
    simp only [hform, Units.val_mk0] at e
    have e2 : ∑ᶠ (V : ValuationSubring F) (_ : V ∈ {V : ValuationSubring F | wcpaDjNtV' K V}),
        wcpaDjValOrd V x = 0 := by
      rw [← finsum_subtype_eq_finsum_cond (f := fun V : ValuationSubring F => wcpaDjValOrd V x)
        (fun V => V ∈ {V : ValuationSubring F | wcpaDjNtV' K V})]
      exact e
    rw [← finsum_mem_def]
    exact e2

  refine ⟨⟨fun V => if h : wcpaDjNtV' K V then Classical.choose (hv V h).1 else 1,
    fun V hV => ?_⟩, fun V hV => (hv V hV).2.1, hfin3, hgoal4, hgoal5⟩
  simp only [dif_pos hV]
  exact (Classical.choose_spec (hv V hV).1).2

theorem wcpa_dj_cdp_chart_exists (K : Type u) [Field K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (hq : IsProper q) (L : wcpaDjCoc C) (hOK : wcpaDjCocOK L) (ξ : C)
    [Algebra K (C.residueField ξ)] (hA : algebraMap K (C.residueField ξ) = wcpaDjFK K q ξ)
    (V : ValuationSubring (C.residueField ξ)) (hV : wcpaDjNtV' K V) :
    ∃ b, wcpaDjChartGood L ξ V b :=
by
  classical

  have hTop : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (h : (⊤ : X.Opens) ≤ f ⁻¹ᵁ ⊤),
      f.appLE ⊤ ⊤ h = f.appTop := by
    intro X Y f h
    exact Scheme.Hom.appLE_eq_app f

  have hNat : ∀ {A B : CommRingCat.{u}} (φ : A ⟶ B) (y : Γ(Spec A, ⊤)),
      (Scheme.ΓSpecIso B).hom ((Spec.map φ).appTop y) = φ ((Scheme.ΓSpecIso A).hom y) := by
    intro A B φ y
    exact congrArg (fun ψ => ψ.hom y) (Scheme.ΓSpecIso_naturality φ)

  have s4 : ∀ (A B : CommRingCat.{u}) (φ : A ⟶ B) (ℓ : Spec A ⟶ C) (U : C.Opens)
      (h' : (⊤ : (Spec A).Opens) ≤ ℓ ⁻¹ᵁ U) (h : (⊤ : (Spec B).Opens) ≤ (Spec.map φ ≫ ℓ) ⁻¹ᵁ U)
      (x : Γ(C, U)), (Scheme.ΓSpecIso B).hom ((Spec.map φ ≫ ℓ).appLE U ⊤ h x) =
        φ ((Scheme.ΓSpecIso A).hom (ℓ.appLE U ⊤ h' x)) := by
    intro A B φ ℓ U h' h x
    rw [← Scheme.Hom.appLE_comp_appLE (Spec.map φ) ℓ U ⊤ ⊤ h' (Scheme.Hom.preimage_top _).ge,
      CommRingCat.comp_apply, hTop, hNat]

  have s5 : ∀ (g : Spec (C.residueField ξ) ⟶ C), g = C.fromSpecResidueField ξ →
      ∀ (U : C.Opens) (hξ : ξ ∈ U) (hle : (⊤ : (Spec (C.residueField ξ)).Opens) ≤ g ⁻¹ᵁ U)
      (x : Γ(C, U)), (Scheme.ΓSpecIso (C.residueField ξ)).hom (g.appLE U ⊤ hle x) =
        (C.presheaf.germ U ξ hξ ≫ C.residue ξ).hom x := by
    intro g hg U hξ hle x
    subst hg
    have h'' : (⊤ : (Spec (C.presheaf.stalk ξ)).Opens) ≤ C.fromSpecStalk ξ ⁻¹ᵁ U := by
      intro y _
      rw [Scheme.Hom.mem_preimage]
      refine ((IsLocalRing.specializes_closedPoint y).map
        (C.fromSpecStalk ξ).continuous).mem_open U.isOpen ?_
      rw [Scheme.fromSpecStalk_closedPoint]
      exact hξ
    have k : (C.fromSpecResidueField ξ).appLE U ⊤ hle =
        (C.fromSpecStalk ξ).appLE U ⊤ h'' ≫
          (Spec.map (C.residue ξ)).appLE ⊤ ⊤ (Scheme.Hom.preimage_top _).ge :=
      (Scheme.Hom.appLE_comp_appLE (Spec.map (C.residue ξ)) (C.fromSpecStalk ξ) U ⊤ ⊤ h''
        (Scheme.Hom.preimage_top _).ge).symm
    rw [k, CommRingCat.comp_apply, hTop, hNat, CommRingCat.comp_apply]
    congr 1
    rw [Scheme.Hom.appLE, Scheme.fromSpecStalk_app hξ]
    simp only [Category.assoc, CommRingCat.comp_apply]
    rw [← CommRingCat.comp_apply ((Spec (C.presheaf.stalk ξ)).presheaf.map _)
      ((Spec (C.presheaf.stalk ξ)).presheaf.map _), ← Functor.map_comp]
    rw [show ((homOfLE _).op ≫ (homOfLE h'').op : Opposite.op (⊤ : (Spec (C.presheaf.stalk ξ)).Opens) ⟶ Opposite.op ⊤) = 𝟙 _ from rfl]
    rw [CategoryTheory.Functor.map_id, CommRingCat.id_apply, ← CommRingCat.comp_apply,
      Iso.inv_hom_id, CommRingCat.id_apply]

  have hK : ∀ c : K, wcpaDjFK K q ξ c ∈ V := by
    intro c
    rw [← hA]
    exact hV.1 c
  set ι : CommRingCat.of V ⟶ C.residueField ξ := CommRingCat.ofHom (algebraMap V (C.residueField ξ))
    with hι
  set i₂ : Spec (.of V) ⟶ Spec (.of K) :=
    Spec.map (CommRingCat.ofHom ((wcpaDjFK K q ξ).codRestrict V hK)) with hi₂
  have e1 : CommRingCat.ofHom ((wcpaDjFK K q ξ).codRestrict V hK) ≫ ι =
      (Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ ξ trivial ≫ C.residue ξ := by
    ext c
    rfl
  have e2 : C.fromSpecResidueField ξ ≫ q = Spec.map ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫
      C.presheaf.germ ⊤ ξ trivial ≫ C.residue ξ) := by
    simp only [Spec.map_comp, Category.assoc]
    rw [← Scheme.fromSpecStalk_toSpecΓ_assoc, ← Scheme.toSpecΓ_naturality_assoc,
      ← SpecMap_ΓSpecIso_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id, Category.comp_id]
    rfl
  have hcomm : C.fromSpecResidueField ξ ≫ q = Spec.map ι ≫ i₂ := by
    rw [hi₂, ← Spec.map_comp, e1, e2]

  haveI := hq
  have hUC : UniversallyClosed q := inferInstance
  rw [UniversallyClosed.eq_valuativeCriterion] at hUC
  have hE : ValuativeCriterion.Existence q := hUC.1
  let S : ValuativeCommSq q :=
    ValuativeCommSq.mk (↥V) (C.residueField ξ) (C.fromSpecResidueField ξ) i₂ ⟨hcomm⟩
  haveI hL : S.commSq.HasLift := hE S
  set ℓ : Spec (.of V) ⟶ C := S.commSq.lift with hℓdef
  have hℓ : Spec.map ι ≫ ℓ = C.fromSpecResidueField ξ := S.commSq.fac_left

  have hmem : ℓ (IsLocalRing.closedPoint V) ∈ (⨆ a, L.V a) := by
    rw [hOK.2.1]; trivial
  obtain ⟨b, hb0⟩ := TopologicalSpace.Opens.mem_iSup.mp hmem
  have hb : ∀ y, ℓ y ∈ L.V b := fun y =>
    ((IsLocalRing.specializes_closedPoint y).map ℓ.continuous).mem_open (L.V b).isOpen hb0
  have hξb : ξ ∈ L.V b := by
    obtain ⟨p⟩ : Nonempty (Spec (C.residueField ξ)) := inferInstance
    have h2 : (Spec.map ι ≫ ℓ) p = ξ := by
      rw [hℓ]; exact Scheme.fromSpecResidueField_apply ξ p
    have h3 : (Spec.map ι ≫ ℓ) p = ℓ ((Spec.map ι) p) := by
      rw [Scheme.Hom.comp_apply]
    rw [← h2, h3]
    exact hb _
  refine ⟨b, hξb, fun x => ?_⟩
  have h' : (⊤ : (Spec (.of V)).Opens) ≤ ℓ ⁻¹ᵁ L.V b := fun y _ => hb y
  have hle : (⊤ : (Spec (C.residueField ξ)).Opens) ≤ (Spec.map ι ≫ ℓ) ⁻¹ᵁ L.V b :=
    fun y _ => hb _
  have k1 := s4 _ _ ι ℓ (L.V b) h' hle x
  have k2 := s5 (Spec.map ι ≫ ℓ) hℓ (L.V b) hξb hle x
  rw [← k2, k1]
  exact Subtype.prop _

theorem wcpa_dj_lsp_section_comp_deg_pos : ∀ (K : Type u) [Field K] [IsAlgClosed K] (C : Scheme.{u}) (q : C ⟶ Spec (.of K)) (L : wcpaDjCoc C) (t : ∀ a : Fin L.m, Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤)), wcpaDjSemistable q → wcpaDjCocOK L → wcpaDjCompat L (q ⁻¹ᵁ ⊤) 1 t → (∀ ξ : C, closure {ξ} ∈ irreducibleComponents C → ∀ a : Fin L.m, ξ ∈ L.V a → ξ ∈ C.basicOpen (t a)) → (∀ ξ : C, closure {ξ} ∈ irreducibleComponents C → ∃ x ∈ closure {ξ}, ∀ a : Fin L.m, x ∈ L.V a → x ∉ C.basicOpen (t a)) → ∀ ξ : C, closure {ξ} ∈ irreducibleComponents C → ∀ a : Fin L.m, ξ ∈ L.V a → 1 ≤ wcpaDjCompDeg L ξ a :=
by
  intro K _ _ C q L t hss hOK hcomp hnv hz ξ hξ a ha
  classical
  letI : Algebra K (C.residueField ξ) := (wcpaDjFK K q ξ).toAlgebra
  have hA : algebraMap K (C.residueField ξ) = wcpaDjFK K q ξ := rfl
  have hq : IsProper q := hss.2.1
  haveI := hq
  have hsep : IsSeparated q := inferInstance
  have htopmem : ∀ y : C, y ∈ q ⁻¹ᵁ (⊤ : (Spec (.of K)).Opens) := by
    intro y
    rw [Scheme.Hom.preimage_top]
    exact TopologicalSpace.Opens.mem_top y
  have hFF := wcpa_dj_cdp_residue_ff1 K C q hss ξ hξ hA
  obtain ⟨⟨u, hu⟩, hmul, hfin, hsum, htop⟩ := wcpa_dj_cdp_ff_valuations K (C.residueField ξ) hFF

  have hv1 : ∀ V : ValuationSubring (C.residueField ξ), wcpaDjNtV' K V →
      wcpaDjValOrd V (1 : C.residueField ξ) = 0 := by
    intro V hV
    have := hmul V hV 1 1 one_ne_zero one_ne_zero
    rw [one_mul] at this
    linarith
  have hvinv : ∀ V : ValuationSubring (C.residueField ξ), wcpaDjNtV' K V →
      ∀ x : C.residueField ξ, x ≠ 0 → wcpaDjValOrd V x⁻¹ = - wcpaDjValOrd V x := by
    intro V hV x hx
    have := hmul V hV x x⁻¹ hx (inv_ne_zero hx)
    rw [mul_inv_cancel₀ hx, hv1 V hV] at this
    linarith
  have hgb : ∀ (V : ValuationSubring (C.residueField ξ)) (b : Fin L.m),
      wcpaDjChartGood L ξ V b → ξ ∈ L.V b := by
    intro V b hg
    obtain ⟨hb, _⟩ := hg
    exact hb

  have hconst : ∀ (V : ValuationSubring (C.residueField ξ)) (b : Fin L.m),
      wcpaDjChartGood L ξ V b → ∀ c : K, algebraMap K (C.residueField ξ) c ∈ V := by
    intro V b hg c
    obtain ⟨hb, hgood⟩ := hg
    have key := hgood ((C.presheaf.map (homOfLE (le_top : L.V b ≤ ⊤)).op).hom
      (q.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)))
    have e : algebraMap K (C.residueField ξ) c = (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom
        ((C.presheaf.map (homOfLE (le_top : L.V b ≤ ⊤)).op).hom
          (q.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c))) := by
      rw [hA]
      unfold wcpaDjFK
      rw [← TopCat.Presheaf.germ_res C.presheaf (homOfLE (le_top : L.V b ≤ ⊤)) ξ hb]
      rfl
    rw [e]
    exact key
  have hNt_chart : ∀ V : ValuationSubring (C.residueField ξ), wcpaDjNtV' K V →
      ∃ b, wcpaDjChartGood L ξ V b :=
    fun V hV => wcpa_dj_cdp_chart_exists K C q hq L hOK ξ hA V hV

  obtain ⟨τ, hτ⟩ : ∃ τ : Fin L.m → C.residueField ξ, ∀ (b : Fin L.m) (hb : ξ ∈ L.V b),
      τ b = (C.presheaf.germ (L.V b ⊓ q ⁻¹ᵁ ⊤) ξ (TopologicalSpace.Opens.mem_inf.mpr ⟨hb, htopmem ξ⟩) ≫ C.residue ξ).hom (t b) :=
    ⟨fun b => if hb : ξ ∈ L.V b then
        (C.presheaf.germ (L.V b ⊓ q ⁻¹ᵁ ⊤) ξ (TopologicalSpace.Opens.mem_inf.mpr ⟨hb, htopmem ξ⟩) ≫ C.residue ξ).hom (t b) else 0,
      fun b hb => dif_pos hb⟩
  have hτ0 : ∀ b, ξ ∈ L.V b → τ b ≠ 0 := by
    intro b hb
    rw [hτ b hb, Scheme.germ_residue]
    exact (Scheme.evaluation_ne_zero_iff_mem_basicOpen C ξ _ (t b)).mpr (hnv ξ hξ b hb)
  have hratio : ∀ (b : Fin L.m) (hab : ξ ∈ L.V a ⊓ L.V b),
      (C.presheaf.germ (L.V a ⊓ L.V b) ξ hab ≫ C.residue ξ).hom
        (L.g a b : Γ(C, L.V a ⊓ L.V b)) = τ b * (τ a)⁻¹ := by
    intro b hab
    have h := wcpa_dj_lsp_scd_compat_residue C (q ⁻¹ᵁ ⊤) L t hcomp ξ a b hab (htopmem ξ)
    have e : τ b = (C.presheaf.germ (L.V a ⊓ L.V b) ξ hab ≫ C.residue ξ).hom
        (L.g a b : Γ(C, L.V a ⊓ L.V b)) * τ a := by
      rw [hτ b hab.2, hτ a ha]
      exact h
    rw [e, mul_inv_cancel_right₀ (hτ0 a ha)]
  have hτV : ∀ (V : ValuationSubring (C.residueField ξ)) (b : Fin L.m),
      wcpaDjChartGood L ξ V b → τ b ∈ V := by
    intro V b hg
    obtain ⟨hb, hgood⟩ := hg
    have hle : L.V b ≤ L.V b ⊓ q ⁻¹ᵁ ⊤ := by
      intro y hy
      exact TopologicalSpace.Opens.mem_inf.mpr ⟨hy, htopmem y⟩
    have key := hgood ((C.presheaf.map (homOfLE hle).op).hom (t b))
    have e : τ b = (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom
        ((C.presheaf.map (homOfLE hle).op).hom (t b)) := by
      rw [hτ b hb, ← TopCat.Presheaf.germ_res C.presheaf (homOfLE hle) ξ hb]
      rfl
    rw [e]
    exact key

  suffices main : ∀ T : ValuationSubring (C.residueField ξ) → ℤ,
      (∀ V, ¬ wcpaDjNtV' K V → T V = 0) →
      (∀ V, wcpaDjNtV' K V → ∃ b, ∃ _ : ξ ∈ L.V b, wcpaDjChartGood L ξ V b ∧
          T V = wcpaDjValOrd V (τ b) - wcpaDjValOrd V (τ a)) →
      1 ≤ ∑ᶠ V, T V by
    unfold wcpaDjCompDeg
    apply main
    · intro V hV
      beta_reduce
      split_ifs with hP
      · obtain ⟨b, hgood⟩ := hP.2
        have hall := hconst V b hgood
        have hVtop : V = ⊤ := by
          by_contra hne
          exact hV ⟨hall, hne⟩
        subst hVtop
        exact htop _
      · rfl
    · intro V hV
      obtain ⟨b0, hb0⟩ := hNt_chart V hV
      have hP : ξ ∈ L.V a ∧ ∃ b, wcpaDjChartGood L ξ V b := ⟨ha, b0, hb0⟩
      refine ⟨hP.2.choose, hgb V _ hP.2.choose_spec, hP.2.choose_spec, ?_⟩
      beta_reduce
      rw [dif_pos hP]
      have hbm := hgb V _ hP.2.choose_spec
      rw [hratio _ (TopologicalSpace.Opens.mem_inf.mpr ⟨ha, hbm⟩)]
      rw [hmul V hV _ _ (hτ0 _ hbm) (inv_ne_zero (hτ0 a ha)), hvinv V hV _ (hτ0 a ha)]
      ring
  intro T hT0 hT1
  haveI : Nonempty (Fin L.m) := ⟨a⟩
  choose! bs hbsξ hbsg hbsT using hT1
  obtain ⟨B, hBd⟩ : ∃ B : ValuationSubring (C.residueField ξ) → ℤ,
      B = Set.indicator {V : ValuationSubring (C.residueField ξ) | wcpaDjNtV' K V}
        (fun V => wcpaDjValOrd V (τ a)) := ⟨_, rfl⟩
  have hB_in : ∀ V, wcpaDjNtV' K V → B V = wcpaDjValOrd V (τ a) := by
    intro V hV; rw [hBd]; exact Set.indicator_of_mem (show V ∈ {V | wcpaDjNtV' K V} from hV) _
  have hB_out : ∀ V, ¬ wcpaDjNtV' K V → B V = 0 := by
    intro V hV; rw [hBd]; exact Set.indicator_of_notMem (show V ∉ {V | wcpaDjNtV' K V} from hV) _
  obtain ⟨A, hAd⟩ : ∃ A : ValuationSubring (C.residueField ξ) → ℤ, ∀ V, A V = T V + B V :=
    ⟨fun V => T V + B V, fun V => rfl⟩
  have hA_nonneg : ∀ V, 0 ≤ A V := by
    intro V
    by_cases hN : wcpaDjNtV' K V
    · rw [hAd V, hbsT V hN, hB_in V hN]
      have := (wcpa_dj_lsp_scd_valord_bounds _ V).1 _ (hτV V _ (hbsg V hN))
      linarith
    · rw [hAd V, hT0 V hN, hB_out V hN, add_zero]
  have hfinB : (Function.support B).Finite := by
    refine (hfin (τ a) (hτ0 a ha)).subset ?_
    intro V hV
    have hV' := Function.mem_support.mp hV
    by_cases hN : wcpaDjNtV' K V
    · exact ⟨hN, by rwa [hB_in V hN] at hV'⟩
    · exact absurd (hB_out V hN) hV'
  have hfinA : (Function.support A).Finite := by
    have hU : (⋃ b : Fin L.m, {V : ValuationSubring (C.residueField ξ) |
        wcpaDjNtV' K V ∧ τ b ≠ 0 ∧ wcpaDjValOrd V (τ b) ≠ 0}).Finite := by
      apply Set.finite_iUnion
      intro b
      by_cases hb0 : τ b = 0
      · exact Set.finite_empty.subset (fun V hV => (hV.2.1 hb0).elim)
      · exact (hfin (τ b) hb0).subset (fun V hV => ⟨hV.1, hV.2.2⟩)
    refine hU.subset ?_
    intro V hV
    have hV' := Function.mem_support.mp hV
    by_cases hN : wcpaDjNtV' K V
    · refine Set.mem_iUnion.mpr ⟨bs V, hN, hτ0 _ (hbsξ V hN), ?_⟩
      intro h0
      apply hV'
      rw [hAd V, hbsT V hN, hB_in V hN, h0]
      ring
    · exact absurd (by rw [hAd V, hT0 V hN, hB_out V hN, add_zero]) hV'
  have hTsum : ∑ᶠ V, T V = ∑ᶠ V, A V - ∑ᶠ V, B V := by
    rw [← finsum_sub_distrib (show Function.HasFiniteSupport A from hfinA)
      (show Function.HasFiniteSupport B from hfinB)]
    apply finsum_congr
    intro V
    rw [hAd V]
    ring
  have hsumB : ∑ᶠ V, B V = 0 := by
    rw [hBd]
    exact hsum (τ a) (hτ0 a ha)

  obtain ⟨x, hxcl, hx0⟩ := hz ξ hξ
  have hsp : ξ ⤳ x := specializes_iff_mem_closure.mpr hxcl
  obtain ⟨V₀, hdom⟩ := wcpa_dj_lsp_scd_dominating_valuation C ξ x hsp
  have hψ : ∀ (U : C.Opens) (hxU : x ∈ U) (s : Γ(C, U)),
      (C.presheaf.stalkSpecializes hsp ≫ C.residue ξ).hom ((C.presheaf.germ U x hxU).hom s) =
        (C.presheaf.germ U ξ (hsp.mem_open U.isOpen hxU) ≫ C.residue ξ).hom s := by
    intro U hxU s
    rw [← TopCat.Presheaf.germ_stalkSpecializes C.presheaf hxU hsp]
    rfl
  have hxtop : x ∈ (⨆ b, L.V b) := by
    rw [hOK.2.1]
    trivial
  obtain ⟨b₀, hb₀⟩ := TopologicalSpace.Opens.mem_iSup.mp hxtop
  have hξb₀ : ξ ∈ L.V b₀ := hsp.mem_open (L.V b₀).isOpen hb₀
  have hgood₀ : wcpaDjChartGood L ξ V₀ b₀ := by
    refine ⟨hξb₀, fun s => ?_⟩
    rw [← hψ (L.V b₀) hb₀ s]
    exact (hdom _).fst
  have hstar : ∀ (b : Fin L.m), x ∈ L.V b → τ b ∈ V₀.nonunits := by
    intro b hxb
    have hxO : x ∈ L.V b ⊓ q ⁻¹ᵁ ⊤ := TopologicalSpace.Opens.mem_inf.mpr ⟨hxb, htopmem x⟩
    have hnu : (C.presheaf.germ (L.V b ⊓ q ⁻¹ᵁ ⊤) x hxO).hom (t b) ∈
        IsLocalRing.maximalIdeal (C.presheaf.stalk x) := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      exact fun hu => hx0 b hxb ((Scheme.mem_basicOpen C (t b) x hxO).mpr hu)
    have e : τ b = (C.presheaf.stalkSpecializes hsp ≫ C.residue ξ).hom
        ((C.presheaf.germ (L.V b ⊓ q ⁻¹ᵁ ⊤) x hxO).hom (t b)) := by
      rw [hψ _ hxO, hτ b (hsp.mem_open (L.V b).isOpen hxb)]
    rw [e, ValuationSubring.mem_nonunits_iff_exists_mem_maximalIdeal]
    exact ⟨(hdom _).fst, (hdom _).snd hnu⟩
  have hV₀top : V₀ ≠ ⊤ := by
    intro hVt
    have h1 := hstar b₀ hb₀
    rw [hVt] at h1
    obtain ⟨h2, h3⟩ := ValuationSubring.mem_nonunits_iff_exists_mem_maximalIdeal.mp h1
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h3)
      (IsUnit.of_mul_eq_one
        (⟨(τ b₀)⁻¹, ValuationSubring.mem_top _⟩ : (⊤ : ValuationSubring (C.residueField ξ)))
        (Subtype.ext (by simp [hτ0 b₀ hξb₀])))
  have hN₀ : wcpaDjNtV' K V₀ := ⟨hconst V₀ b₀ hgood₀, hV₀top⟩
  obtain ⟨hbξ, hbgood⟩ := hbsg V₀ hN₀
  have hxb : x ∈ L.V (bs V₀) :=
    wcpa_dj_lsp_scd_centre_in_chart K C q hsep (L.V (bs V₀)) (hOK.1 _) ξ x hsp hbξ V₀ hbgood hdom
  obtain ⟨hm1, hm2⟩ :=
    ValuationSubring.mem_nonunits_iff_exists_mem_maximalIdeal.mp (hstar _ hxb)
  have hge1 : 1 ≤ wcpaDjValOrd V₀ (τ (bs V₀)) :=
    (wcpa_dj_lsp_scd_valord_bounds _ V₀).2 ⟨u V₀, hu V₀ hN₀⟩ (hmul V₀ hN₀) _ hm1
      (hτ0 _ hbξ) hm2
  have hAV₀ : 1 ≤ A V₀ := by
    rw [hAd V₀, hbsT V₀ hN₀, hB_in V₀ hN₀]
    linarith
  have hle := single_le_finsum V₀ (show Function.HasFiniteSupport A from hfinA) hA_nonneg
  rw [hTsum, hsumB]
  linarith

theorem wcpa_dj_fva_ss_sepsec_of_pointwise : ∀ (K : Type u) [Field K] [IsAlgClosed K]
    (C : Scheme.{u}) (q : C ⟶ Spec (.of K)) (L : wcpaDjCoc C) (e M : ℕ)
    (t : Fin (M + 1) → ∀ a : Fin L.m, Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤)),
    LocallyOfFiniteType q → wcpaDjCocOK L → (∀ J, wcpaDjCocSec q L e (t J)) →
    (∀ x : C, IsClosed ({x} : Set C) → ∃ c : Fin (M + 1) → K,
      ∀ (a : Fin L.m) (hx : x ∈ L.V a ⊓ q ⁻¹ᵁ ⊤),
        (C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) x hx).hom (wcpaDjLinComb K q L t c a) ∉
          IsLocalRing.maximalIdeal (C.presheaf.stalk x)) →
    (∀ x y : C, IsClosed ({x} : Set C) → IsClosed ({y} : Set C) → x ≠ y →
      ∃ c : Fin (M + 1) → K,
        (∀ (a : Fin L.m) (hx : x ∈ L.V a ⊓ q ⁻¹ᵁ ⊤),
          (C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) x hx).hom (wcpaDjLinComb K q L t c a) ∈
            IsLocalRing.maximalIdeal (C.presheaf.stalk x)) ∧
        (∀ (b : Fin L.m) (hy : y ∈ L.V b ⊓ q ⁻¹ᵁ ⊤),
          (C.presheaf.germ (L.V b ⊓ q ⁻¹ᵁ ⊤) y hy).hom (wcpaDjLinComb K q L t c b) ∉
            IsLocalRing.maximalIdeal (C.presheaf.stalk y))) →
    (∀ x : C, IsClosed ({x} : Set C) → ∀ (a : Fin L.m) (hx : x ∈ L.V a ⊓ q ⁻¹ᵁ ⊤),
      Ideal.span {g | ∃ c : Fin (M + 1) → K,
          (C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) x hx).hom (wcpaDjLinComb K q L t c a) = g ∧
          g ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x)} =
        IsLocalRing.maximalIdeal (C.presheaf.stalk x)) →
    wcpaDjSepSec K q L e M t :=
by
  intro K _ _ C q L e M t hlft hOK Hc P1 P2 P3
  classical
  haveI : LocallyOfFiniteType q := hlft

  have hsurj : ∀ y : C, IsClosed ({y} : Set C) →
      Function.Surjective ((C.evaluation ⊤ y trivial).hom.comp
        (q.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom)) := by
    intro y hy
    haveI : JacobsonSpace C := LocallyOfFiniteType.jacobsonSpace q
    haveI : LocallyOfFiniteType (C.fromSpecResidueField y) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hy
    set g := C.fromSpecResidueField y ≫ q with hg
    have hψ : Spec.map (Spec.preimage g) = g := Spec.map_preimage g
    have hft : (Spec.preimage g).hom.FiniteType := by
      have : LocallyOfFiniteType (Spec.map (Spec.preimage g)) := by rw [hψ]; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
    have hs2 : (C.fromSpecResidueField y).appTop ≫ (Scheme.ΓSpecIso (C.residueField y)).hom =
        C.evaluation ⊤ y trivial := by
      rw [Scheme.fromSpecResidueField, Scheme.Hom.comp_appTop, Scheme.fromSpecStalk_appTop]
      simp only [Category.assoc]
      erw [CategoryTheory.Functor.map_id, Category.id_comp, Scheme.ΓSpecIso_naturality,
        Iso.inv_hom_id_assoc, Scheme.germ_residue]
    have heq : Spec.preimage g = (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ q.appTop ≫
        C.evaluation ⊤ y trivial := by
      rw [Iso.eq_inv_comp, ← Scheme.ΓSpecIso_naturality, hψ, hg, Scheme.Hom.comp_appTop,
        Category.assoc, hs2]
    have hφ : (C.evaluation ⊤ y trivial).hom.comp
        (q.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom) =
        (Spec.preimage g).hom := by
      rw [heq]; rfl
    rw [hφ]
    letI : Algebra K (C.residueField y) := (Spec.preimage g).hom.toAlgebra
    haveI : Algebra.FiniteType K (C.residueField y) := hft
    haveI : Module.Finite K (C.residueField y) := finite_of_finite_type_of_isJacobsonRing K _
    intro s
    have hs : IsIntegral K s := Algebra.IsIntegral.isIntegral s
    have hdeg := IsAlgClosed.degree_eq_one_of_irreducible K (minpoly.irreducible hs)
    obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one K s hdeg
    exact ⟨c, hc⟩

  obtain ⟨ι, hι⟩ : ∃ ι : (x : C) → K →+* C.presheaf.stalk x, ∀ x c,
      ι x c = ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ x trivial).hom c :=
    ⟨fun x => ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ x trivial).hom,
      fun _ _ => rfl⟩
  have hG : ∀ (U : C.Opens) (x : C) (hx : x ∈ U) (c : K),
      (C.presheaf.germ U x hx).hom (wcpaDjKConst K q U c) = ι x c := by
    intro U x hx c
    rw [hι]
    have h := congrArg (fun φ => φ.hom (((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop).hom c))
      (C.presheaf.germ_res (homOfLE (le_top : U ≤ ⊤)) x hx)
    exact h

  have hval : ∀ x : C, IsClosed ({x} : Set C) → ∀ h : C.presheaf.stalk x,
      ∃ c : K, h - ι x c ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x) := by
    intro x hx h
    obtain ⟨c, hc⟩ := hsurj x hx ((C.residue x).hom h)
    refine ⟨c, ?_⟩
    have e1 : (C.residue x).hom (ι x c) = (C.residue x).hom h := by
      have hgr := C.germ_residue x (show x ∈ (⊤ : C.Opens) from trivial)
      have h2 := congrArg (fun φ => φ.hom (q.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c))) hgr
      rw [← hc, hι]
      exact h2
    have e2 : (C.residue x).hom (h - ι x c) = 0 := by rw [map_sub, e1, sub_self]
    exact (IsLocalRing.residue_eq_zero_iff _).mp e2

  have hshift : ∀ (x : C) (w : Fin (M + 1) → C.presheaf.stalk x) (u : C.presheaf.stalk x)
      (lam c : Fin (M + 1) → K),
      ∑ l, ι x (lam l) * w l =
        ∑ l, ι x (lam l) * (w l - ι x (c l) * u) + ι x (∑ l, lam l * c l) * u := by
    intro x w u lam c
    rw [map_sum, Finset.sum_mul, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [map_mul]; ring

  have hnorm : ∀ x : C, IsClosed ({x} : Set C) → ∀ (w : Fin (M + 1) → C.presheaf.stalk x)
      (u : C.presheaf.stalk x), IsUnit u →
      ∃ c : Fin (M + 1) → K,
        (∀ l, w l - ι x (c l) * u ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x)) ∧
        ∀ lam : Fin (M + 1) → K,
          ∑ l, ι x (lam l) * w l ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x) →
          ∑ l, lam l * c l = 0 := by
    intro x hx w u hu
    obtain ⟨v, hv⟩ := hu
    choose c hc using fun l => hval x hx (w l * ↑v⁻¹)
    have h1 : ∀ l, w l - ι x (c l) * u ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x) := by
      intro l
      have e : w l - ι x (c l) * u = (w l * ↑v⁻¹ - ι x (c l)) * u := by
        rw [← hv, sub_mul, mul_assoc, Units.inv_mul, mul_one]
      rw [e]
      exact Ideal.mul_mem_right _ _ (hc l)
    refine ⟨c, h1, fun lam hlam => ?_⟩
    by_contra hs
    have h2 : ∑ l, ι x (lam l) * (w l - ι x (c l) * u) ∈
        IsLocalRing.maximalIdeal (C.presheaf.stalk x) :=
      Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_left _ _ (h1 l))
    have h3 : ι x (∑ l, lam l * c l) * u ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x) := by
      have := Ideal.sub_mem _ hlam h2
      rwa [hshift x w u lam c, add_sub_cancel_left] at this
    have h4 : ι x (∑ l, lam l * c l) ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x) := by
      have := Ideal.mul_mem_right (↑v⁻¹ : C.presheaf.stalk x) _ h3
      rwa [← hv, mul_assoc, Units.mul_inv, mul_one] at this
    have hunit : IsUnit (ι x (∑ l, lam l * c l)) := (Ne.isUnit hs).map (ι x)
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h4)) hunit

  have hlin : ∀ (lam : Fin (M + 1) → K) (a : Fin L.m) (x : C) (hx : x ∈ L.V a ⊓ q ⁻¹ᵁ ⊤),
      (C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) x hx).hom (wcpaDjLinComb K q L t lam a) =
        ∑ l, ι x (lam l) * (C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) x hx).hom (t l a) := by
    intro lam a x hx
    unfold wcpaDjLinComb
    rw [map_sum]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [map_mul, hG]
  have hsub : ∀ (a : Fin L.m) (x : C) (hx : x ∈ L.V a ⊓ q ⁻¹ᵁ ⊤) (l J : Fin (M + 1)) (c : K),
      (C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) x hx).hom
          (t l a - wcpaDjKConst K q (L.V a ⊓ q ⁻¹ᵁ ⊤) c * t J a) =
        (C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) x hx).hom (t l a) -
          ι x c * (C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) x hx).hom (t J a) := by
    intro a x hx l J c
    rw [map_sub, map_mul, hG]

  have avoid : ∀ (W W' : C.Opens), ¬ W ≤ W' →
      ∃ x : C, IsClosed ({x} : Set C) ∧ x ∈ W ∧ x ∉ W' := by
    intro W W' h
    haveI : JacobsonSpace C := LocallyOfFiniteType.jacobsonSpace q
    obtain ⟨y, hyW, hyW'⟩ := SetLike.not_le_iff_exists.mp h
    have hne : ((W : Set C) ∩ (W' : Set C)ᶜ).Nonempty := ⟨y, hyW, hyW'⟩
    have hlc : IsLocallyClosed ((W : Set C) ∩ (W' : Set C)ᶜ) :=
      W.isOpen.isLocallyClosed.inter W'.isOpen.isClosed_compl.isLocallyClosed
    obtain ⟨x, ⟨hxW, hxW'⟩, hxc⟩ := nonempty_inter_closedPoints hne hlc
    exact ⟨x, mem_closedPoints_iff.mp hxc, hxW, hxW'⟩
  unfold wcpaDjSepSec
  refine ⟨fun J a b => Hc J a b, ?_, ?_, ?_⟩
  ·
    intro a
    have hU : L.V a ⊓ q ⁻¹ᵁ ⊤ = L.V a := by rw [Scheme.Hom.preimage_top, inf_top_eq]
    have haff : IsAffineOpen (L.V a ⊓ q ⁻¹ᵁ ⊤) := by rw [hU]; exact hOK.1 a
    rw [← haff.iSup_basicOpen_eq_self_iff]
    apply le_antisymm
    · exact iSup_le (fun f => C.basicOpen_le f.1)
    · by_contra hle
      obtain ⟨x, hxc, hxW, hxW'⟩ := avoid _ _ hle
      have hall : ∀ J, (C.presheaf.germ _ x hxW).hom (t J a) ∈
          IsLocalRing.maximalIdeal (C.presheaf.stalk x) := by
        intro J
        by_contra hJ
        have hu : IsUnit ((C.presheaf.germ _ x hxW).hom (t J a)) := by
          by_contra hnu
          exact hJ ((IsLocalRing.mem_maximalIdeal _).mpr hnu)
        apply hxW'
        exact TopologicalSpace.Opens.mem_iSup.mpr
          ⟨⟨t J a, J, rfl⟩, (Scheme.mem_basicOpen C _ x hxW).mpr hu⟩
      obtain ⟨lam, hlam⟩ := P1 x hxc
      apply hlam a hxW
      rw [hlin]
      exact Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_left _ _ (hall l))
  ·
    intro J a b x y hx hy hxc hyc hxy
    have hxa : x ∈ L.V a ⊓ q ⁻¹ᵁ ⊤ := C.basicOpen_le (t J a) hx
    have hyb : y ∈ L.V b ⊓ q ⁻¹ᵁ ⊤ := C.basicOpen_le (t J b) hy
    have hux : IsUnit ((C.presheaf.germ _ x hxa).hom (t J a)) :=
      (Scheme.mem_basicOpen C _ x hxa).mp hx
    obtain ⟨c, hc1, hc2⟩ :=
      hnorm x hxc (fun l => (C.presheaf.germ _ x hxa).hom (t l a)) _ hux
    obtain ⟨lam, hl1, hl2⟩ := P2 x y hxc hyc hxy
    have hs : ∑ l, lam l * c l = 0 := hc2 lam (by rw [← hlin]; exact hl1 a hxa)
    have hy' := hl2 b hyb
    by_cases hex : ∃ l, (C.presheaf.germ (L.V b ⊓ q ⁻¹ᵁ ⊤) y hyb).hom
        (t l b - wcpaDjKConst K q (L.V b ⊓ q ⁻¹ᵁ ⊤) (c l) * t J b) ∉
          IsLocalRing.maximalIdeal (C.presheaf.stalk y)
    · obtain ⟨l, hl⟩ := hex
      refine ⟨l, c l, ?_, hl⟩
      rw [hsub]
      exact hc1 l
    · push_neg at hex
      exfalso
      apply hy'
      rw [hlin, hshift y (fun l => (C.presheaf.germ _ y hyb).hom (t l b))
        ((C.presheaf.germ _ y hyb).hom (t J b)) lam c, hs, map_zero, zero_mul, add_zero]
      refine Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_left _ _ ?_)
      rw [← hsub]
      exact hex l
  ·
    intro J a x hx hxc
    have hxa : x ∈ L.V a ⊓ q ⁻¹ᵁ ⊤ := C.basicOpen_le (t J a) hx
    have hux : IsUnit ((C.presheaf.germ _ x hxa).hom (t J a)) :=
      (Scheme.mem_basicOpen C _ x hxa).mp hx
    obtain ⟨c, hc1, hc2⟩ :=
      hnorm x hxc (fun l => (C.presheaf.germ _ x hxa).hom (t l a)) _ hux
    refine ⟨c, le_antisymm ?_ ?_⟩
    · rw [Ideal.span_le]
      rintro _ ⟨l, rfl⟩
      show (C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) x hxa).hom
          (t l a - wcpaDjKConst K q (L.V a ⊓ q ⁻¹ᵁ ⊤) (c l) * t J a) ∈
        IsLocalRing.maximalIdeal (C.presheaf.stalk x)
      rw [hsub]
      exact hc1 l
    · rw [← P3 x hxc a hxa, Ideal.span_le]
      rintro g ⟨lam, rfl, hg⟩
      have hs := hc2 lam (by rw [← hlin]; exact hg)
      show _ ∈ Ideal.span _
      rw [hlin, hshift x (fun l => (C.presheaf.germ _ x hxa).hom (t l a))
        ((C.presheaf.germ _ x hxa).hom (t J a)) lam c, hs, map_zero, zero_mul, add_zero]
      refine Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨l, ?_⟩))
      show (C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) x hxa).hom
          (t l a - wcpaDjKConst K q (L.V a ⊓ q ⁻¹ᵁ ⊤) (c l) * t J a) = _
      rw [hsub]

theorem wcpa_dj_twr_construct : ∀ {Y : Scheme.{u}} (L : wcpaDjCoc Y), wcpaDjCocOK L → ∀ (r : ℕ) (F : Y.Modules), ∃ (G : Y.Modules) (φ : ∀ (a : Fin L.m) (O : Y.Opens), O ≤ L.V a → (Γ(G, O) →+ Γ(F, O))), (∀ a O h, Function.Bijective (φ a O h)) ∧ (∀ a O h (s : Γ(Y, O)) (x : Γ(G, O)), φ a O h (s • x) = s • φ a O h x) ∧ (∀ a O O' (h : O ≤ L.V a) (h' : O' ≤ O) (x : Γ(G, O)), φ a O' (h'.trans h) ((G.presheaf.map (homOfLE h').op).hom x) = (F.presheaf.map (homOfLE h').op).hom (φ a O h x)) ∧ (∀ a b O (ha : O ≤ L.V a) (hb : O ≤ L.V b) (x : Γ(G, O)), φ b O hb x = ((Y.presheaf.map (homOfLE (le_inf ha hb)).op).hom (L.g a b : Γ(Y, L.V a ⊓ L.V b))) ^ r • φ a O ha x) :=
by

  have s1 : ∀ {Y : Scheme.{u}} {m : ℕ} (V : Fin m → Y.Opens) (h : ∀ a b : Fin m, Γ(Y, V a ⊓ V b)) (F : Y.Modules), ∃ (P : PresheafOfModules.{u} Y.ringCatSheaf.obj) (π : ∀ (a : Fin m) (O : Y.Opens), P.presheaf.obj (Opposite.op O) →+ Γ(F, O ⊓ V a)), (∀ (O : Y.Opens) (x y : P.presheaf.obj (Opposite.op O)), (∀ a, π a O x = π a O y) → x = y) ∧ (∀ (O : Y.Opens) (x : P.presheaf.obj (Opposite.op O)) (a b : Fin m), (F.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right : O ⊓ V a ⊓ V b ≤ O ⊓ V b)).op).hom (π b O x) = (Y.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right : O ⊓ V a ⊓ V b ≤ V a ⊓ V b)).op).hom (h a b) • (F.presheaf.map (homOfLE (inf_le_left : O ⊓ V a ⊓ V b ≤ O ⊓ V a)).op).hom (π a O x)) ∧ (∀ (O : Y.Opens) (t : ∀ a, Γ(F, O ⊓ V a)), (∀ a b, (F.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right : O ⊓ V a ⊓ V b ≤ O ⊓ V b)).op).hom (t b) = (Y.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right : O ⊓ V a ⊓ V b ≤ V a ⊓ V b)).op).hom (h a b) • (F.presheaf.map (homOfLE (inf_le_left : O ⊓ V a ⊓ V b ≤ O ⊓ V a)).op).hom (t a)) → ∃ x : P.presheaf.obj (Opposite.op O), ∀ a, π a O x = t a) ∧ (∀ (O O' : Y.Opens) (h' : O' ≤ O) (x : P.presheaf.obj (Opposite.op O)) (a : Fin m), π a O' ((P.presheaf.map (homOfLE h').op).hom x) = (F.presheaf.map (homOfLE (inf_le_inf_right (V a) h')).op).hom (π a O x)) ∧ (∀ (O : Y.Opens) (s : Γ(Y, O)) (x : P.obj (Opposite.op O)) (a : Fin m), π a O ((show Y.ringCatSheaf.obj.obj (Opposite.op O) from s) • x) = (Y.presheaf.map (homOfLE (inf_le_left : O ⊓ V a ≤ O)).op).hom s • π a O x) := by
    intro Y m V h F
    have resF : ∀ {A B C : Y.Opens} (i : B ≤ A) (j : C ≤ B) (x : Γ(F, A)),
        (F.presheaf.map (homOfLE j).op).hom ((F.presheaf.map (homOfLE i).op).hom x) =
          (F.presheaf.map (homOfLE (j.trans i)).op).hom x := by
      intro A B C i j x
      show (F.presheaf.map (homOfLE i).op ≫ F.presheaf.map (homOfLE j).op).hom x = _
      rw [← Functor.map_comp]
      rfl
    have resY : ∀ {A B C : Y.Opens} (i : B ≤ A) (j : C ≤ B) (x : Γ(Y, A)),
        (Y.presheaf.map (homOfLE j).op).hom ((Y.presheaf.map (homOfLE i).op).hom x) =
          (Y.presheaf.map (homOfLE (j.trans i)).op).hom x := by
      intro A B C i j x
      show (Y.presheaf.map (homOfLE i).op ≫ Y.presheaf.map (homOfLE j).op).hom x = _
      rw [← Functor.map_comp]
      rfl
    have idF : ∀ {A : Y.Opens} (i : A ≤ A) (x : Γ(F, A)),
        (F.presheaf.map (homOfLE i).op).hom x = x := by
      intro A i x
      show (F.presheaf.map (𝟙 (Opposite.op A))).hom x = x
      rw [CategoryTheory.Functor.map_id]
      rfl
    have smulF : ∀ {A B : Y.Opens} (i : B ≤ A) (s : Γ(Y, A)) (x : Γ(F, A)),
        (F.presheaf.map (homOfLE i).op).hom (s • x) =
          (Y.presheaf.map (homOfLE i).op).hom s • (F.presheaf.map (homOfLE i).op).hom x :=
      fun i s x => Scheme.Modules.map_smul F (homOfLE i) s x

    letI instC : ∀ (O : Y.Opens), Module Γ(Y, O) (∀ a, Γ(F, O ⊓ V a)) := fun O =>
      letI : ∀ a, Module Γ(Y, O) Γ(F, O ⊓ V a) := fun a =>
        Module.compHom _ (Y.presheaf.map (homOfLE (inf_le_left : O ⊓ V a ≤ O)).op).hom
      Pi.module _ _ _
    have smul_apply : ∀ (O : Y.Opens) (s : Γ(Y, O)) (t : ∀ a, Γ(F, O ⊓ V a)) (a : Fin m),
        (s • t) a = (Y.presheaf.map (homOfLE (inf_le_left : O ⊓ V a ≤ O)).op).hom s • t a :=
      fun _ _ _ _ => rfl
    let Rel : ∀ O : Y.Opens, (∀ a, Γ(F, O ⊓ V a)) → Prop := fun O t => ∀ a b,
      (F.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
        O ⊓ V a ⊓ V b ≤ O ⊓ V b)).op).hom (t b) =
      (Y.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
        O ⊓ V a ⊓ V b ≤ V a ⊓ V b)).op).hom (h a b) •
      (F.presheaf.map (homOfLE (inf_le_left : O ⊓ V a ⊓ V b ≤ O ⊓ V a)).op).hom (t a)
    let S : ∀ O : Y.Opens, Submodule Γ(Y, O) (∀ a, Γ(F, O ⊓ V a)) := fun O =>
      { carrier := {t | Rel O t}
        zero_mem' := by
          intro a b
          simp only [Pi.zero_apply, map_zero, smul_zero]
        add_mem' := by
          intro t t' ht ht' a b
          simp only [Pi.add_apply, map_add, smul_add]
          rw [ht a b, ht' a b]
        smul_mem' := by
          intro c t ht a b
          rw [smul_apply, smul_apply, smulF, smulF, resY, resY, ht a b, smul_smul, smul_smul,
            mul_comm] }
    have memS : ∀ (O : Y.Opens) (t : ∀ a, Γ(F, O ⊓ V a)), t ∈ S O ↔ Rel O t :=
      fun _ _ => Iff.rfl

    let res : ∀ {O O' : Y.Opens}, O' ≤ O → S O →+ S O' := fun {O O'} h' =>
      { toFun := fun t => ⟨fun a => (F.presheaf.map (homOfLE (inf_le_inf_right (V a) h')).op).hom
            (t.1 a), by
          rw [memS]
          intro a b
          have e := congrArg (F.presheaf.map (homOfLE (inf_le_inf_right (V b)
            (inf_le_inf_right (V a) h') : O' ⊓ V a ⊓ V b ≤ O ⊓ V a ⊓ V b)).op).hom
            ((memS O t.1).1 t.2 a b)
          rw [resF, smulF, resY, resF] at e
          rw [resF, resF]
          exact e⟩
        map_zero' := Subtype.ext (funext fun a => map_zero _)
        map_add' := fun x y => Subtype.ext (funext fun a => map_add _ _ _) }
    let P₀ : Y.Opensᵒᵖ ⥤ Ab.{u} :=
      { obj := fun O => AddCommGrpCat.of (S O.unop)
        map := fun {O O'} f => AddCommGrpCat.ofHom (res (leOfHom f.unop))
        map_id := by
          intro O
          ext t a
          exact idF _ _
        map_comp := by
          intro O O' O'' f g
          ext t a
          exact (resF _ _ _).symm }
    letI instP : ∀ X : Y.Opensᵒᵖ, Module (Y.ringCatSheaf.obj.obj X) (P₀.obj X) := fun X =>
      (inferInstance : Module Γ(Y, X.unop) (S X.unop))
    have hsm : ∀ ⦃X X' : Y.Opensᵒᵖ⦄ (f : X ⟶ X') (r : Y.ringCatSheaf.obj.obj X) (x : P₀.obj X),
        (P₀.map f).hom (r • x) = (Y.ringCatSheaf.obj.map f).hom r • (P₀.map f).hom x := by
      intro X X' f r x
      apply Subtype.ext
      funext a
      exact (smulF _ _ _).trans (congrArg (· • _) ((resY _ _ _).trans (resY _ _ _).symm))
    refine ⟨PresheafOfModules.ofPresheaf P₀ hsm, fun a O =>
      ⟨⟨fun x => (show S O from x).1 a, rfl⟩, fun _ _ => rfl⟩, ?_, ?_, ?_, ?_, ?_⟩
    · intro O x y hxy
      exact Subtype.ext (funext hxy)
    · intro O x a b
      exact (memS O _).1 (show S O from x).2 a b
    · intro O t ht
      exact ⟨(⟨t, (memS O t).2 ht⟩ : S O), fun a => rfl⟩
    · intro O O' h' x a
      rfl
    · intro O s x a
      rfl

  have s2 : ∀ {Y : Scheme.{u}} {m : ℕ} (V : Fin m → Y.Opens) (h : ∀ a b : Fin m, Γ(Y, V a ⊓ V b)) (F : Y.Modules) (P : Y.Opensᵒᵖ ⥤ Ab.{u}) (π : ∀ (a : Fin m) (O : Y.Opens), P.obj (Opposite.op O) →+ Γ(F, O ⊓ V a)), (∀ (O : Y.Opens) (x y : P.obj (Opposite.op O)), (∀ a, π a O x = π a O y) → x = y) → (∀ (O : Y.Opens) (x : P.obj (Opposite.op O)) (a b : Fin m), (F.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right : O ⊓ V a ⊓ V b ≤ O ⊓ V b)).op).hom (π b O x) = (Y.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right : O ⊓ V a ⊓ V b ≤ V a ⊓ V b)).op).hom (h a b) • (F.presheaf.map (homOfLE (inf_le_left : O ⊓ V a ⊓ V b ≤ O ⊓ V a)).op).hom (π a O x)) → (∀ (O : Y.Opens) (t : ∀ a, Γ(F, O ⊓ V a)), (∀ a b, (F.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right : O ⊓ V a ⊓ V b ≤ O ⊓ V b)).op).hom (t b) = (Y.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right : O ⊓ V a ⊓ V b ≤ V a ⊓ V b)).op).hom (h a b) • (F.presheaf.map (homOfLE (inf_le_left : O ⊓ V a ⊓ V b ≤ O ⊓ V a)).op).hom (t a)) → ∃ x : P.obj (Opposite.op O), ∀ a, π a O x = t a) → (∀ (O O' : Y.Opens) (h' : O' ≤ O) (x : P.obj (Opposite.op O)) (a : Fin m), π a O' ((P.map (homOfLE h').op).hom x) = (F.presheaf.map (homOfLE (inf_le_inf_right (V a) h')).op).hom (π a O x)) → Presheaf.IsSheaf (Opens.grothendieckTopology Y) P := by
    intro Y m V h F P π hSep hRel hEx hNat
    have resF : ∀ {A B C : Y.Opens} (i : B ≤ A) (j : C ≤ B) (x : Γ(F, A)),
        (F.presheaf.map (homOfLE j).op).hom ((F.presheaf.map (homOfLE i).op).hom x) =
          (F.presheaf.map (homOfLE (j.trans i)).op).hom x := by
      intro A B C i j x
      show (F.presheaf.map (homOfLE i).op ≫ F.presheaf.map (homOfLE j).op).hom x = _
      rw [← Functor.map_comp]
      rfl
    have resY : ∀ {A B C : Y.Opens} (i : B ≤ A) (j : C ≤ B) (x : Γ(Y, A)),
        (Y.presheaf.map (homOfLE j).op).hom ((Y.presheaf.map (homOfLE i).op).hom x) =
          (Y.presheaf.map (homOfLE (j.trans i)).op).hom x := by
      intro A B C i j x
      show (Y.presheaf.map (homOfLE i).op ≫ Y.presheaf.map (homOfLE j).op).hom x = _
      rw [← Functor.map_comp]
      rfl
    have smulF : ∀ {A B : Y.Opens} (i : B ≤ A) (s : Γ(Y, A)) (x : Γ(F, A)),
        (F.presheaf.map (homOfLE i).op).hom (s • x) =
          (Y.presheaf.map (homOfLE i).op).hom s • (F.presheaf.map (homOfLE i).op).hom x :=
      fun i s x => Scheme.Modules.map_smul F (homOfLE i) s x
    let 𝔽 : TopCat.Sheaf Ab.{u} Y := ⟨F.presheaf, F.isSheaf⟩
    refine (TopCat.Presheaf.isSheaf_iff_isSheafUniqueGluing P).2 ?_
    intro ι U sf hsf
    have hsf' : ∀ i j, (P.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op).hom (sf i) =
        (P.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op).hom (sf j) := hsf

    have hcov : ∀ a, iSup U ⊓ V a ≤ iSup (fun i => U i ⊓ V a) :=
      fun a => (iSup_inf_eq U (V a)).le
    have hA : ∀ a, ∃ t : Γ(F, iSup U ⊓ V a), ∀ i,
        (F.presheaf.map (homOfLE (inf_le_inf_right (V a) (le_iSup U i))).op).hom t =
          π a (U i) (sf i) := by
      intro a
      obtain ⟨t, ht, -⟩ := TopCat.Sheaf.existsUnique_gluing' 𝔽 (fun i => U i ⊓ V a)
        (iSup U ⊓ V a) (fun i => homOfLE (inf_le_inf_right (V a) (le_iSup U i))) (hcov a)
        (fun i => π a (U i) (sf i)) (by
          intro i j
          have e := congrArg (π a (U i ⊓ U j)) (hsf' i j)
          rw [hNat, hNat] at e
          have e2 := congrArg (F.presheaf.map (homOfLE (le_inf (inf_le_inf inf_le_left inf_le_left)
            (inf_le_left.trans inf_le_right) :
              (U i ⊓ V a) ⊓ (U j ⊓ V a) ≤ (U i ⊓ U j) ⊓ V a)).op).hom e
          rw [resF, resF] at e2
          exact e2)
      exact ⟨t, ht⟩
    choose t ht using hA

    have hB : ∀ a b, (F.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
        iSup U ⊓ V a ⊓ V b ≤ iSup U ⊓ V b)).op).hom (t b) =
        (Y.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
        iSup U ⊓ V a ⊓ V b ≤ V a ⊓ V b)).op).hom (h a b) •
        (F.presheaf.map (homOfLE (inf_le_left :
          iSup U ⊓ V a ⊓ V b ≤ iSup U ⊓ V a)).op).hom (t a) := by
      intro a b
      refine TopCat.Sheaf.eq_of_locally_eq' 𝔽 (fun i => U i ⊓ V a ⊓ V b) (iSup U ⊓ V a ⊓ V b)
        (fun i => homOfLE (inf_le_inf_right (V b) (inf_le_inf_right (V a) (le_iSup U i))))
        (le_of_eq (by rw [iSup_inf_eq, iSup_inf_eq])) _ _ (fun i => ?_)
      have e1 : (F.presheaf.map (homOfLE (le_inf ((inf_le_left.trans inf_le_left).trans
          (le_iSup U i)) inf_le_right : U i ⊓ V a ⊓ V b ≤ iSup U ⊓ V b)).op).hom (t b) =
          (F.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
            U i ⊓ V a ⊓ V b ≤ U i ⊓ V b)).op).hom (π b (U i) (sf i)) := by
        rw [← ht b i, resF]
      have e2 : (F.presheaf.map (homOfLE (le_inf ((inf_le_left.trans inf_le_left).trans
          (le_iSup U i)) (inf_le_left.trans inf_le_right) :
            U i ⊓ V a ⊓ V b ≤ iSup U ⊓ V a)).op).hom (t a) =
          (F.presheaf.map (homOfLE (inf_le_left :
            U i ⊓ V a ⊓ V b ≤ U i ⊓ V a)).op).hom (π a (U i) (sf i)) := by
        rw [← ht a i, resF]
      show (F.presheaf.map (homOfLE _).op).hom ((F.presheaf.map (homOfLE _).op).hom (t b)) =
        (F.presheaf.map (homOfLE _).op).hom ((Y.presheaf.map (homOfLE _).op).hom (h a b) •
          (F.presheaf.map (homOfLE _).op).hom (t a))
      rw [resF, smulF, resY, resF, e1, e2]
      exact hRel (U i) (sf i) a b

    obtain ⟨x, hx⟩ := hEx (iSup U) t hB
    have hglue : ∀ i, (P.map (homOfLE (le_iSup U i)).op).hom x = sf i := by
      intro i
      apply hSep
      intro a
      rw [hNat, hx a]
      exact ht a i

    refine ⟨x, hglue, fun y hy => ?_⟩
    have hy' : ∀ i, (P.map (homOfLE (le_iSup U i)).op).hom y = sf i := hy
    apply hSep
    intro a
    refine TopCat.Sheaf.eq_of_locally_eq' 𝔽 (fun i => U i ⊓ V a) (iSup U ⊓ V a)
      (fun i => homOfLE (inf_le_inf_right (V a) (le_iSup U i))) (hcov a) _ _ (fun i => ?_)
    show (F.presheaf.map (homOfLE (inf_le_inf_right (V a) (le_iSup U i))).op).hom
        (π a (iSup U) y) =
      (F.presheaf.map (homOfLE (inf_le_inf_right (V a) (le_iSup U i))).op).hom (π a (iSup U) x)
    rw [← hNat (iSup U) (U i) (le_iSup U i), ← hNat (iSup U) (U i) (le_iSup U i), hy' i, hglue i]
  intro Y L hL r F

  have resF : ∀ {A B C : Y.Opens} (i : B ≤ A) (j : C ≤ B) (x : Γ(F, A)),
      (F.presheaf.map (homOfLE j).op).hom ((F.presheaf.map (homOfLE i).op).hom x) =
        (F.presheaf.map (homOfLE (j.trans i)).op).hom x := by
    intro A B C i j x
    show (F.presheaf.map (homOfLE i).op ≫ F.presheaf.map (homOfLE j).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have resY : ∀ {A B C : Y.Opens} (i : B ≤ A) (j : C ≤ B) (x : Γ(Y, A)),
      (Y.presheaf.map (homOfLE j).op).hom ((Y.presheaf.map (homOfLE i).op).hom x) =
        (Y.presheaf.map (homOfLE (j.trans i)).op).hom x := by
    intro A B C i j x
    show (Y.presheaf.map (homOfLE i).op ≫ Y.presheaf.map (homOfLE j).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have idF : ∀ {A : Y.Opens} (i : A ≤ A) (x : Γ(F, A)),
      (F.presheaf.map (homOfLE i).op).hom x = x := by
    intro A i x
    show (F.presheaf.map (𝟙 (Opposite.op A))).hom x = x
    rw [CategoryTheory.Functor.map_id]
    rfl
  have idY : ∀ {A : Y.Opens} (i : A ≤ A) (x : Γ(Y, A)),
      (Y.presheaf.map (homOfLE i).op).hom x = x := by
    intro A i x
    show (Y.presheaf.map (𝟙 (Opposite.op A))).hom x = x
    rw [CategoryTheory.Functor.map_id]
    rfl
  have smulF : ∀ {A B : Y.Opens} (i : B ≤ A) (s : Γ(Y, A)) (x : Γ(F, A)),
      (F.presheaf.map (homOfLE i).op).hom (s • x) =
        (Y.presheaf.map (homOfLE i).op).hom s • (F.presheaf.map (homOfLE i).op).hom x :=
    fun i s x => Scheme.Modules.map_smul F (homOfLE i) s x
  have injF : ∀ {A B : Y.Opens} (i : B ≤ A) (j : A ≤ B) (x y : Γ(F, A)),
      (F.presheaf.map (homOfLE i).op).hom x = (F.presheaf.map (homOfLE i).op).hom y → x = y := by
    intro A B i j x y hxy
    have e := congrArg (F.presheaf.map (homOfLE j).op).hom hxy
    rwa [resF, resF, idF, idF] at e

  obtain ⟨h, hh⟩ : ∃ h : ∀ a b : Fin L.m, Γ(Y, L.V a ⊓ L.V b),
      ∀ a b, h a b = (L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ r := ⟨_, fun _ _ => rfl⟩
  have haa : ∀ a, h a a = 1 := by
    intro a
    rw [hh, hL.2.2.1 a, Units.val_one, one_pow]
  have hcoc : ∀ a b c,
      (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V c ≤ L.V a ⊓ L.V b from
        inf_le_left)).op).hom (h a b) *
      (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V c ≤ L.V b ⊓ L.V c from
        le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (h b c) =
      (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V c ≤ L.V a ⊓ L.V c from
        le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (h a c) := by
    intro a b c
    rw [hh, hh, hh, map_pow, map_pow, map_pow, ← mul_pow]
    exact congrArg (· ^ r) (hL.2.2.2 a b c)

  obtain ⟨P, π, hSep, hRel, hEx, hNat, hSmul⟩ := s1 L.V h F
  have hP : Presheaf.IsSheaf (Opens.grothendieckTopology Y) P.presheaf :=
    s2 L.V h F P.presheaf π hSep hRel hEx hNat

  have hbij : ∀ (a : Fin L.m) (O : Y.Opens) (hO : O ≤ L.V a),
      Function.Bijective (fun x : P.presheaf.obj (Opposite.op O) =>
        (F.presheaf.map (homOfLE (le_inf le_rfl hO : O ≤ O ⊓ L.V a)).op).hom (π a O x)) := by
    intro a O hO
    constructor
    · intro x y hxy
      have ha : π a O x = π a O y := injF (le_inf le_rfl hO) inf_le_left _ _ hxy
      apply hSep
      intro b
      have hb := hRel O x a b
      have hb' := hRel O y a b
      rw [ha, ← hb'] at hb
      exact injF _ (le_inf (le_inf inf_le_left (inf_le_left.trans hO)) inf_le_right) _ _ hb
    · intro z
      obtain ⟨x, hx⟩ := hEx O (fun b =>
        (Y.presheaf.map (homOfLE (inf_le_inf_right (L.V b) hO :
          O ⊓ L.V b ≤ L.V a ⊓ L.V b)).op).hom (h a b) •
        (F.presheaf.map (homOfLE (inf_le_left : O ⊓ L.V b ≤ O)).op).hom z) (by
          intro b c
          beta_reduce
          rw [smulF, smulF, resY, resY, resF, resF, smul_smul]
          congr 1
          have hc := congrArg (Y.presheaf.map (homOfLE (show O ⊓ L.V b ⊓ L.V c ≤
            L.V a ⊓ L.V b ⊓ L.V c from le_inf (le_inf ((inf_le_left.trans inf_le_left).trans hO)
              (inf_le_left.trans inf_le_right)) inf_le_right)).op).hom (hcoc a b c)
          rw [map_mul, resY, resY, resY] at hc
          rw [← hc, mul_comm])
      refine ⟨x, ?_⟩
      beta_reduce
      rw [hx a]
      beta_reduce
      rw [haa, map_one, one_smul, resF, idF]

  refine ⟨⟨P, hP⟩, fun a O hO =>
    (F.presheaf.map (homOfLE (le_inf le_rfl hO : O ≤ O ⊓ L.V a)).op).hom.comp (π a O),
    ?_, ?_, ?_, ?_⟩
  · intro a O hO
    exact hbij a O hO
  · intro a O hO s x
    refine (congrArg (F.presheaf.map (homOfLE (le_inf le_rfl hO : O ≤ O ⊓ L.V a)).op).hom
      (hSmul O s x a)).trans ?_
    rw [smulF, resY, idY]
    rfl
  · intro a O O' hO h' x
    refine (congrArg (F.presheaf.map (homOfLE (le_inf le_rfl (h'.trans hO) :
      O' ≤ O' ⊓ L.V a)).op).hom (hNat O O' h' x a)).trans ?_
    rw [resF]
    exact (resF _ _ _).symm
  · intro a b O ha hb x
    have e := congrArg (F.presheaf.map (homOfLE (show O ≤ O ⊓ L.V a ⊓ L.V b from
      le_inf (le_inf le_rfl ha) hb)).op).hom (hRel O x a b)
    rw [resF, smulF, resY, resF, hh, map_pow] at e
    exact e

theorem wcpa_dj_twr_coherent_transfer : ∀ {Y : Scheme.{u}} {m : ℕ} (V : Fin m → Y.Opens), (∀ a, IsAffineOpen (V a)) → (⨆ a, V a) = ⊤ → ∀ (F G : Y.Modules) (φ : ∀ (a : Fin m) (O : Y.Opens), O ≤ V a → (Γ(G, O) →+ Γ(F, O))), (∀ a O h, Function.Bijective (φ a O h)) → (∀ a O h (s : Γ(Y, O)) (x : Γ(G, O)), φ a O h (s • x) = s • φ a O h x) → (∀ a O O' (h : O ≤ V a) (h' : O' ≤ O) (x : Γ(G, O)), φ a O' (h'.trans h) ((G.presheaf.map (homOfLE h').op).hom x) = (F.presheaf.map (homOfLE h').op).hom (φ a O h x)) → wcCoherentMod F → wcCoherentMod G :=
by
  intro Y m V hV hcov F G φ hbij hsmul hnat hF
  obtain ⟨hFq, hFfin⟩ := hF
  let B : Y.Opens → Prop := fun O => IsAffineOpen O ∧ ∃ a, O ≤ V a
  have s1 : ∀ O O' : Y.Opens, B O → O' ≤ O → IsAffineOpen O' → B O' := by
    rintro O O' ⟨_, a, hOa⟩ hle hO'
    exact ⟨hO', a, hle.trans hOa⟩
  have s2 : ∀ x : Y, ∃ O : Y.Opens, B O ∧ x ∈ O := by
    intro x
    have hx : x ∈ (⨆ a, V a) := by rw [hcov]; trivial
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    exact ⟨V a, ⟨hV a, a, le_rfl⟩, ha⟩
  have s3 := wc_cn_pb_basic_good_cover Y B s1 s2
  have s4 : ∀ O : Y.Opens, B O → ∀ f : Γ(Y, O),
      (∀ s : Γ(G, Y.basicOpen f), ∃ (n : ℕ) (t : Γ(G, O)),
        ((Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom f) ^ n • s =
          (G.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom t) ∧
      (∀ t : Γ(G, O), (G.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom t = 0 →
        ∃ n : ℕ, f ^ n • t = 0) := by
    rintro O ⟨hO, a, h⟩ f
    obtain ⟨hext, htor⟩ := hFq O hO f
    have hDO : Y.basicOpen f ≤ O := Y.basicOpen_le f
    refine ⟨fun s => ?_, fun t ht => ?_⟩
    · obtain ⟨n, t', ht'⟩ := hext (φ a (Y.basicOpen f) (hDO.trans h) s)
      obtain ⟨t, rfl⟩ := (hbij a O h).2 t'
      refine ⟨n, t, (hbij a (Y.basicOpen f) (hDO.trans h)).1 ?_⟩
      rw [hsmul, ht', hnat a O (Y.basicOpen f) h hDO t]
    · have h1 : (F.presheaf.map (homOfLE hDO).op).hom (φ a O h t) = 0 := by
        rw [← hnat a O (Y.basicOpen f) h hDO t, ht, map_zero]
      obtain ⟨n, hn⟩ := htor (φ a O h t) h1
      refine ⟨n, (hbij a O h).1 ?_⟩
      rw [hsmul, hn, map_zero]
  have hGq : wcQcoh G := wc_cn_pb_qcoh_of_good_basis Y G B s1 s3 s4
  refine ⟨hGq, fun W hW => ?_⟩
  obtain ⟨k, g, hspan, hg⟩ := s3 W hW
  refine wc_cn_pb_finite_of_basic_cover Y G hGq W hW k g hspan (fun i => ?_)
  obtain ⟨hDi, a, hi⟩ := hg i
  haveI := hFfin _ hDi
  let L : Γ(G, Y.basicOpen (g i)) →ₗ[Γ(Y, Y.basicOpen (g i))] Γ(F, Y.basicOpen (g i)) :=
    { toFun := φ a (Y.basicOpen (g i)) hi
      map_add' := map_add _
      map_smul' := fun s x => hsmul a _ hi s x }
  exact Module.Finite.equiv (LinearEquiv.ofBijective L (hbij a _ hi)).symm

theorem wcpa_dj_fva_ss_cocsec_finite : ∀ (K : Type u) [Field K] [IsAlgClosed K]
    (C : Scheme.{u}) (q : C ⟶ Spec (.of K)) (L : wcpaDjCoc C) (e : ℕ),
    wcpaDjSemistable q → wcpaDjCocOK L →
    ∃ (M : ℕ) (t : Fin (M + 1) → ∀ a : Fin L.m, Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤)),
      (∀ J, wcpaDjCocSec q L e (t J)) ∧
      ∀ s : ∀ a : Fin L.m, Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤), wcpaDjCocSec q L e s →
        ∃ c : Fin (M + 1) → K, ∀ a, s a = wcpaDjLinComb K q L t c a :=
by
  intro K _ _ C q L e hss hOK
  haveI : IsProper q := hss.2.1
  obtain ⟨G, φ, hBij, hSmul, hNat, hTr⟩ := wcpa_dj_twr_construct L hOK e (wcStructMod C)
  have hGcoh : wcCoherentMod G := wcpa_dj_twr_coherent_transfer L.V hOK.1 hOK.2.1
    (wcStructMod C) G φ hBij hSmul hNat (wc_struct_mod_coh C)
  obtain ⟨k, c, hc⟩ := wc_cn_coherent_global_sections_fg K C q G hGcoh

  have resG : ∀ {O O' O'' : C.Opens} (h1 : O' ≤ O) (h2 : O'' ≤ O') (x : Γ(G, O)),
      (G.presheaf.map (homOfLE h2).op).hom ((G.presheaf.map (homOfLE h1).op).hom x) =
        (G.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro O O' O'' h1 h2 x
    rw [← AddCommGrpCat.comp_apply, ← Functor.map_comp]
    rfl
  have resC : ∀ {O O' O'' : C.Opens} (h1 : O' ≤ O) (h2 : O'' ≤ O') (x : Γ(C, O)),
      (C.presheaf.map (homOfLE h2).op).hom ((C.presheaf.map (homOfLE h1).op).hom x) =
        (C.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro O O' O'' h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  let ΦA : ∀ a : Fin L.m, Γ(G, ⊤) →+ Γ(wcStructMod C, L.V a ⊓ q ⁻¹ᵁ ⊤) := fun a =>
    (φ a (L.V a ⊓ q ⁻¹ᵁ ⊤) inf_le_left).comp
      (G.presheaf.map (homOfLE (le_top : L.V a ⊓ q ⁻¹ᵁ ⊤ ≤ ⊤)).op).hom
  let Φ : Γ(G, ⊤) → ∀ a : Fin L.m, Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤) := fun x a => ΦA a x
  have key : ∀ (x : Γ(G, ⊤)) (a : Fin L.m) (O : C.Opens) (hO : O ≤ L.V a ⊓ q ⁻¹ᵁ ⊤),
      (C.presheaf.map (homOfLE hO).op).hom (Φ x a) =
        φ a O (hO.trans inf_le_left) ((G.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op).hom x) := by
    intro x a O hO
    have h1 := hNat a (L.V a ⊓ q ⁻¹ᵁ ⊤) O inf_le_left hO
      ((G.presheaf.map (homOfLE (le_top : L.V a ⊓ q ⁻¹ᵁ ⊤ ≤ ⊤)).op).hom x)
    rw [resG] at h1
    exact h1.symm

  have hcoc : ∀ x, wcpaDjCocSec q L e (Φ x) := by
    intro x a b
    rw [key x b, key x a, hTr a b (L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ ⊤) (inf_le_left.trans inf_le_left)
      (inf_le_left.trans inf_le_right), map_pow]
    rfl

  have hsig : ∀ (a : Fin L.m) (c : K),
      (C.presheaf.map (homOfLE (le_top : L.V a ⊓ q ⁻¹ᵁ ⊤ ≤ ⊤)).op).hom (wcCnSigma q ⊤ c) =
        wcpaDjKConst K q _ c := by
    intro a c
    unfold wcCnSigma
    rw [RingHom.comp_apply, resC]
    rfl
  let ΦC : ∀ a : Fin L.m, Γ(G, ⊤) →+ Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤) := fun a => ΦA a
  have hΦC : ∀ x a, Φ x a = ΦC a x := fun _ _ => rfl
  have hlin : ∀ (c : K) (y : Γ(G, ⊤)) (a : Fin L.m),
      Φ (wcCnSigma q ⊤ c • y) a = wcpaDjKConst K q _ c * Φ y a := by
    intro c y a
    show φ a _ inf_le_left ((G.presheaf.map _).hom (wcCnSigma q ⊤ c • y)) = _
    rw [Scheme.Modules.map_smul, hSmul, hsig]
    rfl

  have hsurj : ∀ s : ∀ a : Fin L.m, Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤), wcpaDjCocSec q L e s →
      ∃ x, Φ x = s := by
    intro s hs
    let U : Fin L.m → C.Opens := fun a => L.V a ⊓ q ⁻¹ᵁ ⊤
    let y : ∀ a : Fin L.m, Γ(G, U a) := fun a =>
      Function.surjInv (hBij a (U a) inf_le_left).2 (s a)
    have hy : ∀ a, φ a (U a) inf_le_left (y a) = s a := fun a =>
      Function.surjInv_eq (hBij a (U a) inf_le_left).2 (s a)
    have hcompat : TopCat.Presheaf.IsCompatible G.presheaf U y := by
      intro a b
      have hOa : U a ⊓ U b ≤ L.V a := inf_le_left.trans inf_le_left
      have hOb : U a ⊓ U b ≤ L.V b := inf_le_right.trans inf_le_left
      apply (hBij b (U a ⊓ U b) hOb).1
      have e1 : TopologicalSpace.Opens.infLELeft (U a) (U b) = homOfLE inf_le_left := rfl
      have e2 : TopologicalSpace.Opens.infLERight (U a) (U b) = homOfLE inf_le_right := rfl
      change φ b _ hOb ((G.presheaf.map (TopologicalSpace.Opens.infLELeft (U a) (U b)).op).hom
        (y a)) = φ b _ hOb ((G.presheaf.map (TopologicalSpace.Opens.infLERight (U a) (U b)).op).hom
        (y b))
      rw [e1, e2, hTr a b _ hOa hOb, hNat a (U a) _ inf_le_left inf_le_left (y a),
        hNat b (U b) _ inf_le_left inf_le_right (y b), hy a, hy b]
      have hW : U a ⊓ U b ≤ L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ ⊤ :=
        le_inf (le_inf hOa hOb) (inf_le_left.trans inf_le_right)
      have h1 := congrArg (C.presheaf.map (homOfLE hW).op).hom (hs a b)
      rw [map_mul, resC, resC, resC, map_pow] at h1
      exact h1.symm
    have hcover : (⊤ : C.Opens) ≤ ⨆ a, U a := by
      simp only [U, Scheme.Hom.preimage_top, inf_top_eq, hOK.2.1, le_refl]
    obtain ⟨x, hx, -⟩ := TopCat.Sheaf.existsUnique_gluing' ⟨G.presheaf, G.isSheaf⟩ U ⊤
      (fun a => homOfLE le_top) hcover y hcompat
    refine ⟨x, ?_⟩
    funext a
    show φ a (U a) inf_le_left ((G.presheaf.map (homOfLE le_top).op).hom x) = s a
    have hxa := hx a
    erw [hxa]
    exact hy a

  let d : Fin (k + 1) → Γ(G, ⊤) := fun J => if h : (J : ℕ) < k then c ⟨J, h⟩ else 0
  refine ⟨k, fun J => Φ (d J), fun J => hcoc _, ?_⟩
  intro s hs
  obtain ⟨x, hx⟩ := hsurj s hs
  obtain ⟨b, hb⟩ := hc x
  refine ⟨fun J => if h : (J : ℕ) < k then b ⟨J, h⟩ else 0, fun a => ?_⟩
  rw [← hx, hb]
  unfold wcpaDjLinComb
  rw [Fin.sum_univ_castSucc, hΦC, map_sum]
  have hlast : wcpaDjKConst K q (L.V a ⊓ q ⁻¹ᵁ ⊤)
      ((fun J : Fin (k + 1) => if h : (J : ℕ) < k then b ⟨J, h⟩ else 0) (Fin.last k)) *
      Φ (d (Fin.last k)) a = 0 := by
    have : ¬ ((Fin.last k : Fin (k + 1)) : ℕ) < k := by simp
    simp only [d, dif_neg this, map_zero, zero_mul]
  rw [hlast, add_zero]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  have hi : ((Fin.castSucc i : Fin (k + 1)) : ℕ) < k := by simp
  simp only [d, dif_pos hi]
  rw [← hΦC, hlin]
  rfl

theorem wcpa_dj_fva_bb_val_dvr : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (F : Type u) [Field F] (ψ : A →+* F), ringKrullDim A ≤ 1 →
    (∃ g ∈ IsLocalRing.maximalIdeal A, ψ g ≠ 0) →
    (∀ f : F, ∃ a s : A, ψ s ≠ 0 ∧ f * ψ s = ψ a) →
    ∀ V : ValuationSubring F, (∀ a : A, wcpaDjPsInPow V (ψ a) 0) →
    (∀ g ∈ IsLocalRing.maximalIdeal A, wcpaDjPsInPow V (ψ g) 1) →
    ∃ π : F, wcpaDjPsInPow V π 1 ∧ ¬ wcpaDjPsInPow V π 2 :=
by
  intro A _ _ _ F _ ψ hdim ⟨g, hg, hg0⟩ hfrac V h0 h1
  classical
  by_contra H
  push_neg at H

  have hsq : ∀ y : V, y ∈ IsLocalRing.maximalIdeal V → y ∈ IsLocalRing.maximalIdeal V ^ 2 := by
    intro y hy
    obtain ⟨_, hy2⟩ := H (y : F) ⟨y.2, by rw [pow_one]; exact hy⟩
    exact hy2

  have hfac : ∀ y : V, y ∈ IsLocalRing.maximalIdeal V → ∃ z t : V,
      z ∈ IsLocalRing.maximalIdeal V ∧ t ∈ IsLocalRing.maximalIdeal V ∧ y = z * t := by
    intro y hy
    have hy2 := hsq y hy
    rw [pow_two] at hy2
    refine Submodule.mul_induction_on (C := fun r => ∃ z t : V,
      z ∈ IsLocalRing.maximalIdeal V ∧ t ∈ IsLocalRing.maximalIdeal V ∧ r = z * t) hy2 ?_ ?_
    · intro a ha b hb
      exact ⟨a, b, ha, hb, rfl⟩
    · rintro _ _ ⟨z₁, t₁, hz₁, ht₁, rfl⟩ ⟨z₂, t₂, hz₂, ht₂, rfl⟩
      rcases ValuationRing.dvd_total z₁ z₂ with ⟨c, rfl⟩ | ⟨c, rfl⟩
      · exact ⟨z₁, t₁ + c * t₂, hz₁,
          Ideal.add_mem _ ht₁ (Ideal.mul_mem_left _ _ ht₂), by ring⟩
      · exact ⟨z₂, c * t₁ + t₂, hz₂,
          Ideal.add_mem _ (Ideal.mul_mem_left _ _ ht₁) ht₂, by ring⟩
  have hstep : ∀ y : V, ∃ z t : V, y ∈ IsLocalRing.maximalIdeal V → y ≠ 0 →
      z ∈ IsLocalRing.maximalIdeal V ∧ z ≠ 0 ∧ t ∈ IsLocalRing.maximalIdeal V ∧ y = z * t := by
    intro y
    by_cases hy : y ∈ IsLocalRing.maximalIdeal V
    · obtain ⟨z, t, hz, ht, rfl⟩ := hfac y hy
      exact ⟨z, t, fun _ hne => ⟨hz, left_ne_zero_of_mul hne, ht, rfl⟩⟩
    · exact ⟨0, 0, fun h => absurd h hy⟩
  choose nxt tt hnt using hstep

  have hmemV : ∀ a : A, ψ a ∈ V := fun a => (h0 a).1
  let φ : A →+* V := ψ.codRestrict V hmemV
  have hx₀m : φ g ∈ IsLocalRing.maximalIdeal V := by
    obtain ⟨_, hm⟩ := h1 g hg
    rw [pow_one] at hm
    exact hm
  have hx₀0 : φ g ≠ 0 := fun h => hg0 (congrArg Subtype.val h)

  let w : ℕ → V := fun k => nxt^[k] (φ g)
  have hwsucc : ∀ k, w (k + 1) = nxt (w k) := fun k => Function.iterate_succ_apply' nxt k (φ g)
  have hwm : ∀ k, w k ∈ IsLocalRing.maximalIdeal V ∧ w k ≠ 0 := by
    intro k
    induction k with
    | zero => exact ⟨hx₀m, hx₀0⟩
    | succ k ih =>
      rw [hwsucc]
      obtain ⟨hz, hz0, -, -⟩ := hnt (w k) ih.1 ih.2
      exact ⟨hz, hz0⟩
  have hwt : ∀ k, tt (w k) ∈ IsLocalRing.maximalIdeal V ∧ w k = w (k + 1) * tt (w k) := by
    intro k
    obtain ⟨-, -, ht, he⟩ := hnt (w k) (hwm k).1 (hwm k).2
    rw [hwsucc]
    exact ⟨ht, he⟩
  have hdvd : ∀ i k, k ≤ i → w i ∣ w k := by
    intro i
    induction i with
    | zero => intro k hk; rw [Nat.le_zero.mp hk]
    | succ i ih =>
      intro k hk
      rcases Nat.lt_or_ge k (i + 1) with h | h
      · exact dvd_trans ⟨tt (w i), (hwt i).2⟩ (ih k (by omega))
      · rw [show k = i + 1 by omega]
  have hndvd : ∀ i, ¬ w i ∣ w (i + 1) := by
    rintro i ⟨s, hs⟩
    have e := (hwt i).2
    rw [hs] at e
    have e2 : w i * (s * tt (w i)) = w i * 1 := by rw [mul_one, ← mul_assoc, ← e]
    have hst := mul_left_cancel₀ (hwm i).2 e2
    exact (IsLocalRing.mem_maximalIdeal _).mp (hwt i).1
      (IsUnit.of_mul_eq_one (b := s) (by rw [mul_comm]; exact hst))

  have hfrac' : ∀ v : V, ∃ a s : A, φ s ≠ 0 ∧ v * φ s = φ a := by
    intro v
    obtain ⟨a, s, hs, he⟩ := hfrac (v : F)
    exact ⟨a, s, fun h => hs (congrArg Subtype.val h), Subtype.ext he⟩
  have hden : ∀ n : ℕ, ∃ d : A, φ d ≠ 0 ∧ ∀ k ≤ n, ∃ a : A, φ d * w k = φ a := by
    intro n
    induction n with
    | zero =>
      obtain ⟨a, s, hs, he⟩ := hfrac' (w 0)
      exact ⟨s, hs, fun k hk => ⟨a, by rw [Nat.le_zero.mp hk, mul_comm]; exact he⟩⟩
    | succ n ih =>
      obtain ⟨d, hd, hk⟩ := ih
      obtain ⟨a, s, hs, he⟩ := hfrac' (w (n + 1))
      refine ⟨d * s, by rw [map_mul]; exact mul_ne_zero hd hs, fun k hk' => ?_⟩
      rcases Nat.lt_or_ge k (n + 1) with h | h
      · obtain ⟨b, hb⟩ := hk k (by omega)
        exact ⟨b * s, by rw [map_mul, map_mul, ← hb]; ring⟩
      · refine ⟨d * a, ?_⟩
        rw [show k = n + 1 by omega, map_mul, map_mul, ← he]
        ring

  have key : ∀ (R : Subring V) (π : A →+* R), Function.Surjective π →
      (∀ a, ((π a : R) : V) = φ a) → False := by
    intro R π hπs hπ
    haveI : IsNoetherianRing R := isNoetherianRing_of_surjective A R π hπs
    haveI : Ring.KrullDimLE 1 R := Ring.krullDimLE_iff.mpr
      ((ringKrullDim_le_of_surjective π hπs).trans (by exact_mod_cast hdim))
    set x : R := π g with hxdef
    have hxw : (x : V) = w 0 := hπ g
    have hx : x ≠ 0 := by
      intro h
      apply hx₀0
      rw [← hπ g, ← hxdef, h]
      rfl
    have hNfin : Module.length R (R ⧸ Ideal.span {x}) ≠ ⊤ :=
      Module.length_ne_top_iff.mpr
        (isFiniteLength_quotient_span_singleton R (mem_nonZeroDivisors_of_ne_zero hx))
    obtain ⟨N, hN⟩ := ENat.ne_top_iff_exists.mp hNfin
    obtain ⟨d, hd, hdk⟩ := hden (N + 1)
    have hdk' : ∀ k, ∃ a : A, k ≤ N + 1 → φ d * w k = φ a := fun k =>
      if h : k ≤ N + 1 then (hdk k h).imp (fun a ha _ => ha) else ⟨0, fun h' => absurd h' h⟩
    choose a ha using hdk'
    let u : ℕ → R := fun k => π (a k)
    have hu : ∀ k ≤ N + 1, ((u k : R) : V) = φ d * w k := fun k hk =>
      (hπ (a k)).trans (ha k hk).symm
    let K : V → Ideal R := fun c => Ideal.comap R.subtype (Ideal.span {c})
    have hK : ∀ (c : V) (r : R), r ∈ K c ↔ c ∣ (r : V) := fun c r =>
      Ideal.mem_comap.trans Ideal.mem_span_singleton
    let J : Ideal R := Ideal.span (u '' Set.Iic (N + 1))
    let I : ℕ → Ideal R := fun i => Ideal.span (u '' Set.Iic i) ⊔ Ideal.span {x} * J
    have hJK : J ≤ K (φ d) := by
      rw [Ideal.span_le]
      rintro _ ⟨k, hk, rfl⟩
      rw [SetLike.mem_coe, hK, hu k hk]
      exact dvd_mul_right _ _
    have hIK : ∀ i ≤ N + 1, I i ≤ K (φ d * w i) := by
      intro i hi
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        rintro _ ⟨k, hk, rfl⟩
        rw [SetLike.mem_coe, hK, hu k (le_trans hk hi)]
        exact mul_dvd_mul_left _ (hdvd i k hk)
      · rw [Ideal.span_singleton_mul_le_iff]
        intro z hz
        rw [hK]
        have e1 : φ d ∣ (z : V) := (hK _ _).mp (hJK hz)
        have e2 : w i ∣ (x : V) := by rw [hxw]; exact hdvd i 0 (Nat.zero_le _)
        show φ d * w i ∣ (x : V) * (z : V)
        rw [mul_comm (φ d)]
        exact mul_dvd_mul e2 e1
    have hImono : ∀ i, I i ≤ I (i + 1) := fun i =>
      sup_le_sup_right (Ideal.span_mono (Set.image_mono (Set.Iic_subset_Iic.mpr (Nat.le_succ i)))) _
    have hIlt : ∀ i, i + 1 ≤ N + 1 → I i < I (i + 1) := by
      intro i hi
      refine lt_of_le_of_ne (hImono i) ?_
      intro heq
      have hmem : u (i + 1) ∈ I (i + 1) :=
        Submodule.mem_sup_left (Ideal.subset_span ⟨i + 1, Set.mem_Iic.mpr le_rfl, rfl⟩)
      rw [← heq] at hmem
      have e := (hK _ _).mp (hIK i (by omega) hmem)
      rw [hu (i + 1) hi] at e
      exact hndvd i ((mul_dvd_mul_iff_left hd).mp e)
    have hcoh : ∀ k ≤ N + 1, Order.coheight (I k) + (k : ℕ∞) ≤ Order.coheight (I 0) := by
      intro k
      induction k with
      | zero => intro _; simp
      | succ k ih =>
        intro hk
        have e1 := Order.coheight_add_one_le (hIlt k hk)
        calc Order.coheight (I (k + 1)) + ((k + 1 : ℕ) : ℕ∞)
            = (Order.coheight (I (k + 1)) + 1) + (k : ℕ∞) := by push_cast; ring
          _ ≤ Order.coheight (I k) + (k : ℕ∞) := by gcongr
          _ ≤ Order.coheight (I 0) := ih (by omega)

    have hexact : Module.length R (R ⧸ Ideal.span {x} * J) =
        Module.length R (R ⧸ J) + Module.length R (R ⧸ Ideal.span {x}) := by
      have hle : J ≤ Submodule.comap (LinearMap.mulLeft R x) (Ideal.span {x} * J) := by
        intro j hj
        exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self x) hj
      have H2 : Ideal.span {x} * J ≤ Ideal.span {x} := Ideal.mul_le_left
      have hg' : ∀ r : R, Submodule.factor H2 (Submodule.Quotient.mk r) =
          Submodule.Quotient.mk r := fun r => Submodule.factor_mk H2 r
      refine Module.length_eq_add_of_exact
        (Submodule.mapQ J (Ideal.span {x} * J) (LinearMap.mulLeft R x) hle)
        (Submodule.factor H2) ?_ (Submodule.factor_surjective H2) ?_
      · rw [injective_iff_map_eq_zero]
        intro q hq
        obtain ⟨r, rfl⟩ := Submodule.Quotient.mk_surjective _ q
        rw [Submodule.mapQ_apply, LinearMap.mulLeft_apply, Submodule.Quotient.mk_eq_zero] at hq
        rw [Submodule.Quotient.mk_eq_zero]
        obtain ⟨z, hz, hzx⟩ := Ideal.mem_span_singleton_mul.mp hq
        have hzr : z = r := mul_left_cancel₀ hx hzx
        rw [← hzr]
        exact hz
      · intro q
        obtain ⟨r, rfl⟩ := Submodule.Quotient.mk_surjective _ q
        constructor
        · intro h
          rw [hg', Submodule.Quotient.mk_eq_zero] at h
          obtain ⟨s, hs⟩ := Ideal.mem_span_singleton'.mp h
          refine ⟨Submodule.Quotient.mk s, ?_⟩
          rw [Submodule.mapQ_apply, LinearMap.mulLeft_apply, ← hs, mul_comm x s]
        · rintro ⟨q', hq'⟩
          obtain ⟨s, rfl⟩ := Submodule.Quotient.mk_surjective _ q'
          rw [← hq', Submodule.mapQ_apply, LinearMap.mulLeft_apply, hg',
            Submodule.Quotient.mk_eq_zero]
          exact Ideal.mem_span_singleton'.mpr ⟨s, mul_comm _ _⟩

    have hu0 : u 0 ≠ 0 := by
      intro h
      apply mul_ne_zero hd (hwm 0).2
      rw [← hu 0 (Nat.zero_le _), h]
      rfl
    have hLfin : Module.length R (R ⧸ J) ≠ ⊤ := by
      have e1 : Module.length R (R ⧸ Ideal.span {u 0}) ≠ ⊤ :=
        Module.length_ne_top_iff.mpr
          (isFiniteLength_quotient_span_singleton R (mem_nonZeroDivisors_of_ne_zero hu0))
      have hle : Ideal.span {u 0} ≤ J :=
        (Ideal.span_singleton_le_iff_mem _).mpr (Ideal.subset_span ⟨0, Nat.zero_le _, rfl⟩)
      exact ne_top_of_le_ne_top e1
        (Module.length_le_of_surjective _ (Submodule.factor_surjective hle))
    obtain ⟨L, hL⟩ := ENat.ne_top_iff_exists.mp hLfin
    have hchain : Order.coheight J + ((N + 1 : ℕ) : ℕ∞) ≤
        Order.coheight (Ideal.span {x} * J) := by
      have hIJ : I (N + 1) ≤ J := sup_le le_rfl Ideal.mul_le_right
      have e1 : Order.coheight J ≤ Order.coheight (I (N + 1)) := Order.coheight_anti hIJ
      have e2 : Order.coheight (I 0) ≤ Order.coheight (Ideal.span {x} * J) :=
        Order.coheight_anti le_sup_right
      calc Order.coheight J + ((N + 1 : ℕ) : ℕ∞)
          ≤ Order.coheight (I (N + 1)) + ((N + 1 : ℕ) : ℕ∞) := by gcongr
        _ ≤ Order.coheight (I 0) := hcoh (N + 1) le_rfl
        _ ≤ _ := e2
    have l1 : Module.length R (R ⧸ J) = Order.coheight J := Module.length_quotient
    have l2 : Module.length R (R ⧸ Ideal.span {x} * J) =
        Order.coheight (Ideal.span {x} * J) := Module.length_quotient
    rw [← l1, ← l2, hexact, ← hL, ← hN] at hchain
    have hfinal : L + (N + 1) ≤ L + N := by exact_mod_cast hchain
    omega
  exact key φ.range φ.rangeRestrict φ.rangeRestrict_surjective (fun a => rfl)

theorem wcpa_dj_fva_ss_branch_basics : ∀ (K : Type u) [Field K] [IsAlgClosed K]
    (C : Scheme.{u}) (q : C ⟶ Spec (.of K)), wcpaDjSemistable q →
    {ξ : C | closure {ξ} ∈ irreducibleComponents C}.Finite ∧
    (∃ Z : Set C, Z.Finite ∧ ∀ x : C, IsClosed ({x} : Set C) → x ∉ Z →
      ∀ β β', wcpaDjPsBr q x β → wcpaDjPsBr q x β' → β = β') ∧
    (∀ x : C, IsClosed ({x} : Set C) → ∃ β, wcpaDjPsBr q x β) ∧
    (∀ x : C, IsClosed ({x} : Set C) → ∀ β, wcpaDjPsBr q x β →
      ∃ π, wcpaDjPsInPow β.2 π 1 ∧ ¬ wcpaDjPsInPow β.2 π 2) :=
by
  intro K _ _ C q hss
  classical
  haveI : IsProper q := hss.2.1
  haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian q
  haveI : CompactSpace C := QuasiCompact.compactSpace_of_compactSpace q
  haveI : AlgebraicGeometry.IsNoetherian C := {}

  have hgen : ∀ ζ : C, closure {ζ} ∈ irreducibleComponents C → ∀ y : C, y ⤳ ζ → y = ζ := by
    intro ζ hζ y hy
    have h1 : closure {ζ} ⊆ closure ({y} : Set C) := specializes_iff_closure_subset.mp hy
    rw [irreducibleComponents_eq_maximals_closed] at hζ
    have hζ' : Maximal (fun x : Set C => IsClosed x ∧ IsIrreducible x) (closure {ζ}) := hζ
    have h2 : closure {ζ} = closure ({y} : Set C) :=
      Maximal.eq_of_le hζ' ⟨isClosed_closure, isIrreducible_singleton.closure⟩ h1
    exact (inseparable_iff_closure_eq.mpr h2.symm).eq

  have hsp : ∀ (x ξ : C) (h : ξ ⤳ x) (g : C.presheaf.stalk x),
      wcpaDjPsSp x ξ g = (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom g := by
    intro x ξ h g
    unfold wcpaDjPsSp
    rw [dif_pos h]

  have hne : ∀ x : C, IsClosed ({x} : Set C) → ∀ ξ : C,
      closure {ξ} ∈ irreducibleComponents C → ξ ≠ x := by
    intro x hx ξ hξ h
    exact (wcpa_dj_lsp_generic_smooth K C q hss ξ hξ).1 (h ▸ hx)

  have s3 : ∀ (ξ x : C) (h : ξ ⤳ x),
      (∀ f : C.residueField ξ, ∃ a s : C.presheaf.stalk x,
        (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom s ≠ 0 ∧
        f * (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom s =
          (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom a) ∧
      (ξ ≠ x → ∃ g ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x),
        (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom g ≠ 0) := by
    intro ξ x h
    constructor
    · intro f
      letI := (C.presheaf.stalkSpecializes h).hom.toAlgebra
      haveI := wc_ldp_nc_stalkSpecializes_isLocalization C ξ x h
      obtain ⟨z, hz⟩ := C.residue_surjective ξ f
      obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj
        ((IsLocalRing.maximalIdeal (C.presheaf.stalk ξ)).comap
          (C.presheaf.stalkSpecializes h).hom).primeCompl z
      refine ⟨a, s, ?_, ?_⟩
      · have hs' : (s : C.presheaf.stalk x) ∉ (IsLocalRing.maximalIdeal (C.presheaf.stalk ξ)).comap
            (C.presheaf.stalkSpecializes h).hom := s.2
        rw [Ideal.mem_comap] at hs'
        intro h0
        exact hs' ((IsLocalRing.residue_eq_zero_iff _).mp h0)
      · rw [← hz]
        have e := congrArg (C.residue ξ).hom hs
        rw [map_mul] at e
        exact e
    · intro hne'
      by_contra hcon
      push_neg at hcon
      haveI : IsLocalHom (C.presheaf.stalkSpecializes h).hom := ⟨fun g hg => by
        by_contra hng
        have hgm : g ∈ IsLocalRing.maximalIdeal _ :=
          (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hng)
        have h0 := hcon g hgm
        have h1 : (C.presheaf.stalkSpecializes h).hom g ∈ IsLocalRing.maximalIdeal _ :=
          (IsLocalRing.residue_eq_zero_iff _).mp h0
        exact (IsLocalRing.mem_maximalIdeal _).mp h1 hg⟩
      apply hne'
      calc ξ = C.fromSpecStalk ξ (IsLocalRing.closedPoint (C.presheaf.stalk ξ)) :=
            Scheme.fromSpecStalk_closedPoint.symm
        _ = (Spec.map (C.presheaf.stalkSpecializes h) ≫ C.fromSpecStalk x)
              (IsLocalRing.closedPoint (C.presheaf.stalk ξ)) := by
            rw [Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
        _ = C.fromSpecStalk x (Spec.map (C.presheaf.stalkSpecializes h)
              (IsLocalRing.closedPoint (C.presheaf.stalk ξ))) := rfl
        _ = C.fromSpecStalk x (IsLocalRing.closedPoint (C.presheaf.stalk x)) := by
            rw [Spec_closedPoint]
        _ = x := Scheme.fromSpecStalk_closedPoint

  have s2 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (F : Type u) [Field F] (ψ : A →+* F),
      (∀ a b : A, a ∣ b ∨ b ∣ a) →
      (∀ f : F, ∃ a s : A, ψ s ≠ 0 ∧ f * ψ s = ψ a) →
      ∀ V : ValuationSubring F, (∀ g ∈ IsLocalRing.maximalIdeal A, wcpaDjPsInPow V (ψ g) 1) →
      ∀ f : F, f ∈ V → ∃ a : A, ψ a = f := by
    intro A _ _ F _ ψ hdvd hfrac V h1 f hf
    obtain ⟨a, s, hs, hfs⟩ := hfrac f
    rcases hdvd s a with ⟨c, rfl⟩ | ⟨c, rfl⟩
    · refine ⟨c, ?_⟩
      rw [map_mul] at hfs
      exact mul_left_cancel₀ hs (hfs.symm.trans (mul_comm _ _))
    · rw [map_mul] at hs hfs
      have ha : ψ a ≠ 0 := left_ne_zero_of_mul hs
      have hfc : f * ψ c = 1 := by
        apply mul_left_cancel₀ ha
        calc ψ a * (f * ψ c) = f * (ψ a * ψ c) := by ring
          _ = ψ a := hfs
          _ = ψ a * 1 := (mul_one _).symm
      by_cases hc : c ∈ IsLocalRing.maximalIdeal A
      · exfalso
        obtain ⟨hcV, hcm⟩ := h1 c hc
        rw [pow_one] at hcm
        have hm : (⟨f, hf⟩ : V) * ⟨ψ c, hcV⟩ ∈ IsLocalRing.maximalIdeal V :=
          Ideal.mul_mem_left _ _ hcm
        have h1V : (⟨f, hf⟩ : V) * ⟨ψ c, hcV⟩ = 1 := Subtype.ext hfc
        rw [h1V] at hm
        exact (IsLocalRing.maximalIdeal V).ne_top_iff_one.mp
          (IsLocalRing.maximalIdeal.isMaximal V).ne_top hm
      · have hcu : IsUnit c := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hc
          exact hc
        obtain ⟨u, rfl⟩ := hcu
        refine ⟨↑u⁻¹, ?_⟩
        calc ψ ↑u⁻¹ = f * ψ ↑u * ψ ↑u⁻¹ := by rw [hfc, one_mul]
          _ = f := by rw [mul_assoc, ← map_mul, Units.mul_inv, map_one, mul_one]

  have s6 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (F : Type u) [Field F] (ψ : A →+* F),
      (∃ g ∈ IsLocalRing.maximalIdeal A, ψ g ≠ 0) →
      ∃ V : ValuationSubring F, V ≠ ⊤ ∧ (∀ a : A, wcpaDjPsInPow V (ψ a) 0) ∧
        (∀ g ∈ IsLocalRing.maximalIdeal A, wcpaDjPsInPow V (ψ g) 1) := by
    intro A _ _ F _ ψ ⟨g₀, hg₀m, hg₀⟩
    haveI : IsLocalRing ψ.range :=
      IsLocalRing.of_surjective' ψ.rangeRestrict ψ.rangeRestrict_surjective
    obtain ⟨V, hV⟩ := LocalSubring.exists_le_valuationSubring (LocalSubring.mk ψ.range)
    obtain ⟨hle, hloc⟩ := LocalSubring.le_def.mp hV
    have hmemV : ∀ a : A, ψ a ∈ V := fun a => hle (ψ.mem_range_self a)
    have hunit : ∀ g : A, IsUnit (⟨ψ g, hmemV g⟩ : V) → IsUnit g := by
      intro g hg
      have h1 : IsUnit (ψ.rangeRestrict g) := isUnit_of_map_unit (Subring.inclusion hle) _ hg
      obtain ⟨u, hu⟩ := h1
      obtain ⟨g', hg'⟩ := ψ.rangeRestrict_surjective (↑u⁻¹ : ψ.range)
      have h2 : ψ.rangeRestrict (g * g') = 1 := by
        rw [map_mul, hg', ← hu, Units.mul_inv]
      have h3 : g * g' - 1 ∈ RingHom.ker ψ := by
        rw [RingHom.mem_ker, map_sub, map_one, sub_eq_zero]
        have := congrArg Subtype.val h2
        simpa using this
      by_contra hng
      have hgm : g ∈ IsLocalRing.maximalIdeal A :=
        (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hng)
      have h4 : g * g' - 1 ∈ IsLocalRing.maximalIdeal A :=
        IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top ψ) h3
      have h5 : (1 : A) ∈ IsLocalRing.maximalIdeal A := by
        have := Ideal.sub_mem _ (Ideal.mul_mem_right g' _ hgm) h4
        simpa using this
      exact (IsLocalRing.maximalIdeal A).ne_top_iff_one.mp
        (IsLocalRing.maximalIdeal.isMaximal A).ne_top h5
    have hm1 : ∀ g ∈ IsLocalRing.maximalIdeal A,
        (⟨ψ g, hmemV g⟩ : V) ∈ IsLocalRing.maximalIdeal V := by
      intro g hg
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      exact (IsLocalRing.mem_maximalIdeal _).mp hg (hunit g hu)
    refine ⟨V, ?_, fun a => ⟨hmemV a, ?_⟩, fun g hg => ⟨hmemV g, ?_⟩⟩
    · intro hVtop
      have hinv : (ψ g₀)⁻¹ ∈ V := by simp [hVtop]
      apply (IsLocalRing.mem_maximalIdeal _).mp (hm1 g₀ hg₀m)
      exact IsUnit.of_mul_eq_one (⟨(ψ g₀)⁻¹, hinv⟩ : V) (Subtype.ext (mul_inv_cancel₀ hg₀))
    · rw [pow_zero, Ideal.one_eq_top]
      exact Submodule.mem_top
    · rw [pow_one]
      exact hm1 g hg

  have s5 : ∀ (W : C.Opens), SmoothOfRelativeDimension 1 (W.ι ≫ q) → ∀ x : C, x ∈ W →
      IsDomain (C.presheaf.stalk x) ∧ (∀ a b : C.presheaf.stalk x, a ∣ b ∨ b ∣ a) ∧
      (IsClosed ({x} : Set C) → ringKrullDim (C.presheaf.stalk x) ≤ 1) := by
    intro W hW x hxW
    haveI := hW
    let ε := (W.stalkIso ⟨x, hxW⟩).commRingCatIsoToRingEquiv
    haveI := wcpa_smooth_stalk_isDomain K W.toScheme (W.ι ≫ q) 1 ⟨x, hxW⟩
    haveI := wcpa_dj_sgt_smooth_curve_stalk_valuation K W.toScheme (W.ι ≫ q) ⟨x, hxW⟩
    refine ⟨MulEquiv.isDomain _ ε.symm.toMulEquiv, ?_, ?_⟩
    · intro a b
      rcases ValuationRing.dvd_total (ε.symm a) (ε.symm b) with ⟨c, hc⟩ | ⟨c, hc⟩
      · left
        refine ⟨ε c, ?_⟩
        have := congrArg ε hc
        rwa [map_mul, RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply] at this
      · right
        refine ⟨ε c, ?_⟩
        have := congrArg ε hc
        rwa [map_mul, RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply] at this
    · intro hcl
      have hpre : (W.ι : W.toScheme ⟶ C) ⁻¹' {x} = {(⟨x, hxW⟩ : W)} := by
        ext y
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        constructor
        · intro h
          apply Subtype.ext
          exact h
        · intro h
          subst h
          simp
      have hcl' : IsClosed ({(⟨x, hxW⟩ : W)} : Set W.toScheme) := by
        rw [← hpre]
        exact hcl.preimage W.ι.continuous
      have h1 := wc_lfi_smooth_stalk_dim K W.toScheme (W.ι ≫ q) 1 ⟨x, hxW⟩ hcl'
      have h2 := ringKrullDim_eq_of_ringEquiv ε
      have h3 : ((1 : ℕ) : WithBot ℕ∞) ≤ 1 := by norm_num
      exact (h2.symm.trans h1).le.trans h3

  obtain ⟨U, hUiff, -, hUfin, hUdim⟩ : ∃ U : C.Opens,
      (∀ w : C, w ∈ U ↔ ∃ W : C.Opens, w ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q)) ∧
      (∀ w : C, w ∉ U → IsClosed ({w} : Set C)) ∧ ((U : Set C)ᶜ).Finite ∧
      (∀ w : C, w ∉ U → ringKrullDim (C.presheaf.stalk w) ≤ 1) := by
    let U : C.Opens := sSup {W : C.Opens | SmoothOfRelativeDimension 1 (W.ι ≫ q)}
    have hiff : ∀ w : C, w ∈ U ↔
        ∃ W : C.Opens, w ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q) := by
      intro w
      rw [TopologicalSpace.Opens.mem_sSup]
      constructor
      · rintro ⟨W, hW, hwW⟩
        exact ⟨W, hwW, hW⟩
      · rintro ⟨W, hwW, hW⟩
        exact ⟨W, hW, hwW⟩
    have hΦ : (asIso (Limits.pullback.fst q (𝟙 (Spec (.of K))))).symm.hom ≫
        Limits.pullback.snd q (𝟙 (Spec (.of K))) = q := by
      simp only [Iso.symm_hom, asIso_inv]
      rw [IsIso.inv_comp_eq, Limits.pullback.condition, Category.comp_id]
    have hres : ∀ w : C, w ∉ U → ∀ a : C.presheaf.stalk w, ∃ z : K,
        a - ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ w trivial).hom z ∈
          IsLocalRing.maximalIdeal (C.presheaf.stalk w) := by
      intro w hw
      rcases wcpa_dj_ssp_bw_ns_transport K
          (asIso (Limits.pullback.fst q (𝟙 (Spec (.of K))))).symm
          q (Limits.pullback.snd q (𝟙 (Spec (.of K)))) hΦ w (hss.2.2 K (𝟙 _) _) with
        hsm | hnode
      · exact absurd ((hiff w).mpr hsm) hw
      · exact wcpa_dj_nf_node_residue K (C.presheaf.stalk w) _ hnode
    obtain ⟨hcl, hfin⟩ := wcpa_dj_nf_nodes_closed_finite K C q U inferInstance hres
    exact ⟨U, hiff, hcl, hfin, wcpa_dj_nf_node_dim_le_one K C q U inferInstance hiff hcl⟩
  refine ⟨?_, ⟨(U : Set C)ᶜ, hUfin, ?_⟩, ?_, ?_⟩
  ·
    have hfin : (irreducibleComponents C).Finite := finite_irreducibleComponents_of_isNoetherian
    apply Set.Finite.of_finite_image (f := fun ξ : C => closure ({ξ} : Set C))
    · apply hfin.subset
      rintro _ ⟨ξ, hξ, rfl⟩
      exact hξ
    · intro a _ b _ hab
      exact (inseparable_iff_closure_eq.mpr hab).eq
  ·
    intro x hx hxU β β' hβ hβ'
    have hxU' : x ∈ U := not_not.mp hxU
    obtain ⟨W, hxW, hW⟩ := (hUiff x).mp hxU'
    obtain ⟨hdom, hdvd, -⟩ := s5 W hW x hxW
    have hgpt : ∀ ζ : C, closure {ζ} ∈ irreducibleComponents C → ζ ⤳ x →
        ζ = C.fromSpecStalk x ⟨⊥, Ideal.isPrime_bot⟩ := by
      intro ζ hζ hζx
      have hr : ζ ∈ Set.range (C.fromSpecStalk x) := by
        rw [Scheme.range_fromSpecStalk]
        exact hζx
      obtain ⟨p, hp⟩ := hr
      have h1 : (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum (C.presheaf.stalk x)) ⤳ p :=
        (PrimeSpectrum.le_iff_specializes _ _).mp bot_le
      have h2 := h1.map (C.fromSpecStalk x).continuous
      rw [hp] at h2
      exact (hgen ζ hζ _ h2).symm
    have hV : ∀ (ξ₀ : C) (hh : ξ₀ ⤳ x) (V₀ : ValuationSubring (C.residueField ξ₀)),
        wcpaDjPsBr q x ⟨ξ₀, V₀⟩ →
        ∀ f, f ∈ V₀ ↔ ∃ a, (C.presheaf.stalkSpecializes hh ≫ C.residue ξ₀).hom a = f := by
      intro ξ₀ hh V₀ hV₀ f
      have h0 : ∀ a, wcpaDjPsInPow V₀
          ((C.presheaf.stalkSpecializes hh ≫ C.residue ξ₀).hom a) 0 := by
        intro a
        rw [← hsp x ξ₀ hh]
        exact hV₀.2.2.2.2.1 a
      have h1 : ∀ g ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x), wcpaDjPsInPow V₀
          ((C.presheaf.stalkSpecializes hh ≫ C.residue ξ₀).hom g) 1 := by
        intro g hg
        rw [← hsp x ξ₀ hh]
        exact hV₀.2.2.2.2.2 g hg
      constructor
      · intro hf
        exact s2 _ _ _ hdvd (s3 ξ₀ x hh).1 V₀ h1 f hf
      · rintro ⟨a, rfl⟩
        exact (h0 a).1
    obtain ⟨ξ, V⟩ := β
    obtain ⟨ξ', V'⟩ := β'
    have e1 := hgpt ξ hβ.1 hβ.2.2.2.1
    have e2 := hgpt ξ' hβ'.1 hβ'.2.2.2.1
    have hξξ : ξ' = ξ := e2.trans e1.symm
    subst hξξ
    have hVV : V = V' := by
      ext f
      exact (hV _ hβ.2.2.2.1 _ hβ f).trans (hV _ hβ.2.2.2.1 _ hβ' f).symm
    subst hVV
    rfl
  ·
    intro x hx
    obtain ⟨Y, hY, hxY⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible
      (closure ({x} : Set C)) isIrreducible_singleton.closure
    have hYcl : IsClosed Y := isClosed_of_mem_irreducibleComponents Y hY
    have hYirr : IsIrreducible Y := hY.prop
    have hξ : closure {hYirr.genericPoint} = Y := by
      have := hYirr.isGenericPoint_genericPoint_closure
      rw [hYcl.closure_eq] at this
      exact isGenericPoint_def.mp this
    set ξ := hYirr.genericPoint with hξdef
    have hξG : closure {ξ} ∈ irreducibleComponents C := by rw [hξ]; exact hY
    have hξx : ξ ⤳ x := specializes_iff_mem_closure.mpr
      (by rw [hξ]; exact hxY (subset_closure (Set.mem_singleton x)))
    obtain ⟨-, hnt⟩ := s3 ξ x hξx
    obtain ⟨V, hVtop, hV0, hV1⟩ := s6 _ _ _ (hnt (hne x hx ξ hξG))
    refine ⟨⟨ξ, V⟩, hξG, hVtop, ?_, hξx, ?_, ?_⟩
    · intro c
      have e : C.presheaf.germ ⊤ x trivial ≫ C.presheaf.stalkSpecializes hξx =
          C.presheaf.germ ⊤ ξ trivial := TopCat.Presheaf.germ_stalkSpecializes _ _ _
      have hk : wcpaDjPsK q ξ c = (C.presheaf.stalkSpecializes hξx ≫ C.residue ξ).hom
          ((C.presheaf.germ ⊤ x trivial).hom
            (q.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c))) := by
        unfold wcpaDjPsK
        rw [← e]
        simp only [CommRingCat.hom_comp, RingHom.comp_apply]
      rw [hk]
      exact (hV0 _).1
    · intro g
      rw [hsp x ξ hξx]
      exact hV0 g
    · intro g hg
      rw [hsp x ξ hξx]
      exact hV1 g hg
  ·
    intro x hx β hβ
    obtain ⟨ξ, V⟩ := β
    have hξx : ξ ⤳ x := hβ.2.2.2.1
    obtain ⟨hfrac, hnt⟩ := s3 ξ x hξx
    have hdim : ringKrullDim (C.presheaf.stalk x) ≤ 1 := by
      by_cases hxU : x ∈ U
      · obtain ⟨W, hxW, hW⟩ := (hUiff x).mp hxU
        exact (s5 W hW x hxW).2.2 hx
      · exact hUdim x hxU
    exact wcpa_dj_fva_bb_val_dvr _ _ _ hdim (hnt (hne x hx ξ hβ.1)) hfrac V
      (fun a => by rw [← hsp x ξ hξx]; exact hβ.2.2.2.2.1 a)
      (fun g hg => by rw [← hsp x ξ hξx]; exact hβ.2.2.2.2.2 g hg)

theorem wcpa_dj_fva_ss_center_unique : ∀ (K : Type u) [Field K] [IsAlgClosed K]
    (C : Scheme.{u}) (q : C ⟶ Spec (.of K)), wcpaDjSemistable q →
    ∀ x y : C, IsClosed ({x} : Set C) → IsClosed ({y} : Set C) → ∀ β,
      wcpaDjPsBr q x β → wcpaDjPsBr q y β → x = y :=
by
  intro K _ _ C q hss x y _ _ β hβx hβy
  classical
  have hq : IsProper q := hss.2.1
  obtain ⟨ξ, V⟩ := β

  have key : ∀ z : C, wcpaDjPsBr q z ⟨ξ, V⟩ → ∃ a : Spec (.of V) ⟶ C,
      a (IsLocalRing.closedPoint (CommRingCat.of V)) = z ∧
      Spec.map (CommRingCat.ofHom (algebraMap V (C.residueField ξ))) ≫ a =
        Spec.map (C.residue ξ) ≫ C.fromSpecStalk ξ := by
    intro z hz
    obtain ⟨-, -, -, h, h0, h1⟩ := hz
    have hsp : ∀ g, wcpaDjPsSp z ξ g = (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom g :=
      fun g => by simp only [wcpaDjPsSp, dif_pos h]
    have hV : ∀ g, (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom g ∈ V := fun g => by
      obtain ⟨hm, -⟩ := h0 g
      rwa [hsp] at hm
    let φ : C.presheaf.stalk z →+* V :=
      (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom.codRestrict V hV
    have hm : ∀ g ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk z),
        φ g ∈ IsLocalRing.maximalIdeal V := by
      intro g hg
      obtain ⟨hf, hmem⟩ := h1 g hg
      rw [pow_one] at hmem
      have e : (⟨wcpaDjPsSp z ξ g, hf⟩ : V) = φ g := Subtype.ext (hsp g)
      rwa [e] at hmem
    have hloc : IsLocalHom φ := ⟨fun g hg => by
      by_contra hng
      have hg' : g ∈ IsLocalRing.maximalIdeal _ :=
        (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hng)
      exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp (hm g hg')) hg⟩
    haveI : IsLocalHom (CommRingCat.ofHom φ).hom := hloc
    refine ⟨Spec.map (CommRingCat.ofHom φ) ≫ C.fromSpecStalk z, ?_, ?_⟩
    · exact (congrArg (C.fromSpecStalk z) (Spec_closedPoint (f := CommRingCat.ofHom φ))).trans
        Scheme.fromSpecStalk_closedPoint
    · have hring : CommRingCat.ofHom φ ≫ CommRingCat.ofHom (algebraMap V (C.residueField ξ)) =
          C.presheaf.stalkSpecializes h ≫ C.residue ξ := by
        ext g; rfl
      rw [← Category.assoc, ← Spec.map_comp, hring, Spec.map_comp, Category.assoc,
        Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
  obtain ⟨ax, hax, hex⟩ := key x hβx
  obtain ⟨ay, hay, hey⟩ := key y hβy

  haveI := hq
  let f := q ≫ Limits.terminal.from (Spec (.of K))
  haveI hsep : IsSeparated f := inferInstance
  let Sq : ValuativeCommSq f :=
    { R := V, K := C.residueField ξ,
      i₁ := Spec.map (CommRingCat.ofHom (algebraMap V (C.residueField ξ))) ≫ ax,
      i₂ := ax ≫ f,
      commSq := ⟨Category.assoc _ _ _⟩ }
  have hU : Subsingleton Sq.commSq.LiftStruct := IsSeparated.valuativeCriterion (f := f) Sq
  have heq := congrArg CommSq.LiftStruct.l
    (Subsingleton.elim (α := Sq.commSq.LiftStruct) ⟨ax, rfl, rfl⟩
      ⟨ay, hey.trans hex.symm, Limits.terminal.hom_ext _ _⟩)
  calc x = ax (IsLocalRing.closedPoint (CommRingCat.of V)) := hax.symm
    _ = ay (IsLocalRing.closedPoint (CommRingCat.of V)) := by rw [show ax = ay from heq]
    _ = y := hay

theorem wcpa_dj_fva_cj_ff_dvr : ∀ (K F : Type u) [Field K] [IsAlgClosed K] [Field F] [Algebra K F],
    wcpaDjFF1 K F → ∀ V : ValuationSubring F, wcpaDjNtV' K V →
    (∀ f : F, f ≠ 0 → ∀ n : ℕ, (wcpaDjPsInPow V f n ↔ (n : ℤ) ≤ wcpaDjValOrd V f)) ∧
    (∀ f g : F, f ≠ 0 → g ≠ 0 → wcpaDjValOrd V (f * g) = wcpaDjValOrd V f + wcpaDjValOrd V g) ∧
    (∃ π : F, wcpaDjValOrd V π = 1) :=
by
  intro K F _ _ _ _ hF V hV
  classical
  have hfd := wcpa_dj_ffv_finite_over_transc K F hF
  obtain ⟨z, hz, hsep, hsep'⟩ := wcpa_dj_ffv_separating K F hF
  have hz' : Transcendental K z⁻¹ := by
    unfold Transcendental at hz ⊢
    exact fun h => hz (IsAlgebraic.inv_iff.mp h)
  haveI := hfd z hz
  haveI := hfd z⁻¹ hz'
  haveI := hsep
  haveI := hsep'
  obtain ⟨A₁, hA₁d, hA₁f, hA₁⟩ := wcpa_dj_ffv_dedekind_subring K F z hz
  obtain ⟨A₂, hA₂d, hA₂f, hA₂⟩ := wcpa_dj_ffv_dedekind_subring K F z⁻¹ hz'
  haveI := hA₁d
  haveI := hA₁f
  haveI := hA₂d
  haveI := hA₂f
  have hdvr : IsDiscreteValuationRing V := by
    rcases V.mem_or_inv_mem z with h | h
    · exact (wcpa_dj_ffv_dedekind_local F A₁ V (hA₁ V hV.1 h) hV.2).1
    · exact (wcpa_dj_ffv_dedekind_local F A₂ V (hA₂ V hV.1 h) hV.2).1
  haveI := hdvr
  obtain ⟨⟨π, hπ0, hπ⟩, hmul, hmem, -, hunit⟩ := wcpa_dj_ffv_valord_dvr F V
  refine ⟨?_, hmul, ⟨π, hπ⟩⟩
  have hv1 : wcpaDjValOrd V 1 = 0 :=
    (hunit 1 one_ne_zero).2 ⟨V.one_mem, by rw [inv_one]; exact V.one_mem⟩
  have hvpow : ∀ k : ℕ, wcpaDjValOrd V (π ^ k) = k := by
    intro k
    induction k with
    | zero => simpa using hv1
    | succ k ih =>
      rw [pow_succ, hmul _ _ (pow_ne_zero _ hπ0) hπ0, ih, hπ]
      push_cast
      ring
  have hshift : ∀ x : F, x ≠ 0 → ∀ k : ℕ,
      wcpaDjValOrd V (x * (π ^ k)⁻¹) = wcpaDjValOrd V x - k := by
    intro x hx k
    have hpk : π ^ k ≠ 0 := pow_ne_zero _ hπ0
    have e : x * (π ^ k)⁻¹ * π ^ k = x := by field_simp
    have h2 := hmul (x * (π ^ k)⁻¹) (π ^ k) (mul_ne_zero hx (inv_ne_zero hpk)) hpk
    rw [e, hvpow] at h2
    linarith
  have hπV : π ∈ V := (hmem π hπ0).2 (by rw [hπ]; norm_num)
  set πV : V := ⟨π, hπV⟩ with hπVdef
  have hmax : IsLocalRing.maximalIdeal V = Ideal.span {πV} := by
    apply le_antisymm
    · intro g hg
      by_cases hg0 : (g : F) = 0
      · have : g = 0 := Subtype.ext hg0
        rw [this]
        exact Ideal.zero_mem _
      · have hge : 0 ≤ wcpaDjValOrd V (g : F) := (hmem _ hg0).1 g.2
        have hgne : wcpaDjValOrd V (g : F) ≠ 0 := by
          intro h0
          have hinv := ((hunit _ hg0).1 h0).2
          apply (IsLocalRing.mem_maximalIdeal _).1 hg
          refine isUnit_iff_exists_inv.mpr ⟨⟨(g : F)⁻¹, hinv⟩, ?_⟩
          apply Subtype.ext
          show (g : F) * (g : F)⁻¹ = 1
          exact mul_inv_cancel₀ hg0
        have ha0 : 0 ≤ wcpaDjValOrd V ((g : F) * (π ^ 1)⁻¹) := by
          rw [hshift _ hg0 1]
          push_cast
          omega
        have haV : (g : F) * (π ^ 1)⁻¹ ∈ V :=
          (hmem _ (mul_ne_zero hg0 (inv_ne_zero (pow_ne_zero _ hπ0)))).2 ha0
        rw [Ideal.mem_span_singleton']
        refine ⟨⟨_, haV⟩, ?_⟩
        apply Subtype.ext
        show (g : F) * (π ^ 1)⁻¹ * π = g
        field_simp
    · rw [Ideal.span_singleton_le_iff_mem, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      rintro ⟨u, hu⟩
      have h1 : ((u⁻¹ : Vˣ) : V) * πV = 1 := by rw [← hu]; exact u.inv_mul
      have h2 : (((u⁻¹ : Vˣ) : V) : F) * π = 1 := congrArg Subtype.val h1
      have h3 : π⁻¹ ∈ V := by
        rw [← eq_inv_of_mul_eq_one_left h2]
        exact ((u⁻¹ : Vˣ) : V).2
      have h4 := (hunit π hπ0).2 ⟨hπV, h3⟩
      rw [hπ] at h4
      exact absurd h4 one_ne_zero
  intro f hf n
  have hpn : π ^ n ≠ 0 := pow_ne_zero _ hπ0
  have hmaxn : IsLocalRing.maximalIdeal V ^ n = Ideal.span {πV ^ n} := by
    rw [hmax, Ideal.span_singleton_pow]
  unfold wcpaDjPsInPow
  rw [hmaxn]
  constructor
  · rintro ⟨hfV, hspan⟩
    rw [Ideal.mem_span_singleton'] at hspan
    obtain ⟨a, ha⟩ := hspan
    have ha' : (a : F) * π ^ n = f := congrArg Subtype.val ha
    have haeq : (a : F) = f * (π ^ n)⁻¹ := by rw [← ha']; field_simp
    have h0 : 0 ≤ wcpaDjValOrd V (f * (π ^ n)⁻¹) :=
      (hmem _ (mul_ne_zero hf (inv_ne_zero hpn))).1 (haeq ▸ a.2)
    rw [hshift f hf n] at h0
    linarith
  · intro hn
    have h0 : 0 ≤ wcpaDjValOrd V (f * (π ^ n)⁻¹) := by rw [hshift f hf n]; linarith
    have haV := (hmem _ (mul_ne_zero hf (inv_ne_zero hpn))).2 h0
    have hfeq : f * (π ^ n)⁻¹ * π ^ n = f := by field_simp
    have hfV : f ∈ V := by rw [← hfeq]; exact mul_mem haV (pow_mem hπV n)
    refine ⟨hfV, ?_⟩
    rw [Ideal.mem_span_singleton']
    refine ⟨⟨_, haV⟩, ?_⟩
    apply Subtype.ext
    show f * (π ^ n)⁻¹ * π ^ n = f
    exact hfeq

theorem wcpa_dj_fva_cj_ff_family : ∀ (K F : Type u) [Field K] [IsAlgClosed K] [Field F] [Algebra K F],
    wcpaDjFF1 K F → ∃ w : {V : ValuationSubring F // wcpaDjNtV' K V} → Additive Fˣ →+ ℤ,
    wcValFamily K F {V : ValuationSubring F // wcpaDjNtV' K V} w ∧ Function.Injective w ∧
    ∀ (V : {V : ValuationSubring F // wcpaDjNtV' K V}) (f : Fˣ),
      w V (Additive.ofMul f) = wcpaDjValOrd V.1 (f : F) :=
by
  intro K F _ _ _ _ hF
  classical
  have hfd := wcpa_dj_ffv_finite_over_transc K F hF
  obtain ⟨z, hz, hsep, hsep'⟩ := wcpa_dj_ffv_separating K F hF
  have hz' : Transcendental K z⁻¹ := by
    unfold Transcendental at hz ⊢
    exact fun h => hz (IsAlgebraic.inv_iff.mp h)
  haveI := hfd z hz
  haveI := hfd z⁻¹ hz'
  haveI := hsep
  haveI := hsep'
  obtain ⟨A₁, hA₁d, hA₁f, hA₁⟩ := wcpa_dj_ffv_dedekind_subring K F z hz
  obtain ⟨A₂, hA₂d, hA₂f, hA₂⟩ := wcpa_dj_ffv_dedekind_subring K F z⁻¹ hz'
  haveI := hA₁d
  haveI := hA₁f
  haveI := hA₂d
  haveI := hA₂f
  have cover : ∀ V : ValuationSubring F, wcpaDjNtV' K V →
      A₁ ≤ V.toSubring ∨ A₂ ≤ V.toSubring := by
    intro V hV
    rcases V.mem_or_inv_mem z with h | h
    · exact Or.inl (hA₁ V hV.1 h)
    · exact Or.inr (hA₂ V hV.1 h)
  have hv : ∀ V : ValuationSubring F, wcpaDjNtV' K V →
      (∃ π : F, π ≠ 0 ∧ wcpaDjValOrd V π = 1) ∧
      (∀ x y : F, x ≠ 0 → y ≠ 0 →
        wcpaDjValOrd V (x * y) = wcpaDjValOrd V x + wcpaDjValOrd V y) ∧
      (∀ x : F, x ≠ 0 → (x ∈ V ↔ 0 ≤ wcpaDjValOrd V x)) ∧
      (∀ x y : F, x ≠ 0 → y ≠ 0 → x + y ≠ 0 →
        min (wcpaDjValOrd V x) (wcpaDjValOrd V y) ≤ wcpaDjValOrd V (x + y)) ∧
      (∀ x : F, x ≠ 0 → (wcpaDjValOrd V x = 0 ↔ (x ∈ V ∧ x⁻¹ ∈ V))) := by
    intro V hV
    rcases cover V hV with h | h
    · haveI := (wcpa_dj_ffv_dedekind_local F A₁ V h hV.2).1
      exact wcpa_dj_ffv_valord_dvr F V
    · haveI := (wcpa_dj_ffv_dedekind_local F A₂ V h hV.2).1
      exact wcpa_dj_ffv_valord_dvr F V
  have hfin : ∀ x : F, x ≠ 0 →
      {V : ValuationSubring F | wcpaDjNtV' K V ∧ wcpaDjValOrd V x ≠ 0}.Finite := by
    intro x hx
    have h1 := wcpa_dj_ffv_dedekind_finite F A₁
      (fun V h h' => (wcpa_dj_ffv_dedekind_local F A₁ V h h').2) x hx
    have h2 := wcpa_dj_ffv_dedekind_finite F A₂
      (fun V h h' => (wcpa_dj_ffv_dedekind_local F A₂ V h h').2) x hx
    refine (h1.union h2).subset ?_
    rintro V ⟨hV, hne⟩
    have hnu : ¬ (x ∈ V ∧ x⁻¹ ∈ V) := fun h => hne (((hv V hV).2.2.2.2 x hx).mpr h)
    rcases cover V hV with h | h
    · exact Or.inl ⟨h, hV.2, hnu⟩
    · exact Or.inr ⟨h, hV.2, hnu⟩
  obtain ⟨w, hw⟩ : ∃ w : {V : ValuationSubring F // wcpaDjNtV' K V} → Additive Fˣ →+ ℤ,
      ∀ V (f : Fˣ), w V (Additive.ofMul f) = wcpaDjValOrd V.1 (f : F) := by
    refine ⟨fun V => AddMonoidHom.mk'
      (fun a => wcpaDjValOrd V.1 ((Additive.toMul a : Fˣ) : F)) ?_, fun V f => rfl⟩
    intro a b
    show wcpaDjValOrd V.1 ((Additive.toMul (a + b) : Fˣ) : F) =
      wcpaDjValOrd V.1 ((Additive.toMul a : Fˣ) : F) + wcpaDjValOrd V.1 ((Additive.toMul b : Fˣ) : F)
    rw [toMul_add, Units.val_mul]
    exact (hv V.1 V.2).2.1 _ _ (Additive.toMul a).ne_zero (Additive.toMul b).ne_zero
  have hfam : wcValFamily K F {V : ValuationSubring F // wcpaDjNtV' K V} w := by
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro V a b h hab
      simp only [hw]
      rw [hab]
      have hne : (a : F) + (b : F) ≠ 0 := by rw [← hab]; exact h.ne_zero
      exact (hv V.1 V.2).2.2.2.1 _ _ a.ne_zero b.ne_zero hne
    · intro f
      have hpre := (hfin (f : F) f.ne_zero).preimage
        (f := (Subtype.val : {V : ValuationSubring F // wcpaDjNtV' K V} → ValuationSubring F))
        (fun _ _ _ _ h => Subtype.ext h)
      refine hpre.subset ?_
      intro V hV
      have hV' : w V (Additive.ofMul f) ≠ 0 := hV
      rw [hw] at hV'
      exact ⟨V.2, hV'⟩
    · intro V
      obtain ⟨π, hπ, hπ1⟩ := (hv V.1 V.2).1
      refine ⟨Units.mk0 π hπ, ?_⟩
      rw [hw]
      exact hπ1
    · intro f
      constructor
      · intro h
        refine (wcpa_dj_ffv_integral_const K F).2 (f : F) ?_
        intro V hV
        have h' := h ⟨V, hV⟩
        rw [hw] at h'
        exact ((hv V hV).2.2.1 _ f.ne_zero).mpr h'
      · rintro ⟨c, hc⟩ V
        rw [hw]
        apply ((hv V.1 V.2).2.2.1 _ f.ne_zero).mp
        rw [← hc]
        exact V.2.1 c
  have hinj : Function.Injective w := by
    intro V W hVW
    apply Subtype.ext
    ext x
    by_cases hx : x = 0
    · subst hx
      exact ⟨fun _ => W.1.zero_mem, fun _ => V.1.zero_mem⟩
    · have e1 := hw V (Units.mk0 x hx)
      have e2 := hw W (Units.mk0 x hx)
      rw [hVW] at e1
      rw [Units.val_mk0] at e1 e2
      have e : wcpaDjValOrd V.1 x = wcpaDjValOrd W.1 x := e1.symm.trans e2
      rw [(hv V.1 V.2).2.2.1 x hx, (hv W.1 W.2).2.2.1 x hx, e]
  exact ⟨w, hfam, hinj, hw⟩

theorem wcpa_dj_fva_cj_ff_finrank : ∀ (K F : Type u) [Field K] [IsAlgClosed K] [Field F] [Algebra K F],
    wcpaDjFF1 K F → wcRRFinRank K F :=
by
  intro K F _ _ _ _ hFF
  classical

  have hA : ∀ x : F, IsAlgebraic K x → ∃ c : K, algebraMap K F c = x := by
    intro x hx
    have hint : IsIntegral K x := hx.isIntegral
    have hirr : Irreducible (minpoly K x) := minpoly.irreducible hint
    have hdeg : (minpoly K x).degree = 1 := IsAlgClosed.degree_eq_one_of_irreducible K hirr
    have hnat : (minpoly K x).natDegree = 1 := Polynomial.natDegree_eq_of_degree_eq_some hdeg
    exact RingHom.mem_range.mp (minpoly.natDegree_eq_one_iff.mp hnat)
  have htr : ∀ f : F, f ∉ Set.range (algebraMap K F) → Transcendental K f :=
    fun f hf halg => hf (hA f halg)

  have hfd : ∀ f : F, Transcendental K f →
      FiniteDimensional (IntermediateField.adjoin K {f}) F := by
    have hF' : ∃ t : F, Transcendental K t ∧
        FiniteDimensional (IntermediateField.adjoin K {t}) F := hFF
    obtain ⟨t, ht, hfin⟩ := hF'
    have htrd : Algebra.trdeg K F = 1 := by
      have hind : AlgebraicIndependent K (Subtype.val : ({t} : Set F) → F) :=
        algebraicIndependent_unique_type_iff.mpr ht
      have halg : Algebra.IsAlgebraic (IntermediateField.adjoin K ({t} : Set F)) F :=
        Algebra.IsAlgebraic.of_finite _ _
      have halg2 : Algebra.IsAlgebraic (Algebra.adjoin K ({t} : Set F)) F :=
        IntermediateField.isAlgebraic_adjoin_iff_top.mp halg
      have hb : IsTranscendenceBasis K (Subtype.val : ({t} : Set F) → F) := by
        rw [hind.isTranscendenceBasis_iff_isAlgebraic, Subtype.range_coe]
        exact halg2
      rw [← hb.cardinalMk_eq_trdeg, Cardinal.mk_singleton]
    intro f hf
    have hindf : AlgebraicIndependent K (Subtype.val : ({f} : Set F) → F) :=
      algebraicIndependent_unique_type_iff.mpr hf
    have hbf : IsTranscendenceBasis K (Subtype.val : ({f} : Set F) → F) :=
      hindf.isTranscendenceBasis_of_trdeg_le_of_finite (by rw [htrd, Cardinal.mk_singleton])
    have halgf : Algebra.IsAlgebraic (IntermediateField.adjoin K ({f} : Set F)) F := by
      have := hbf.isAlgebraic_field
      rwa [Subtype.range_coe] at this
    set L := IntermediateField.adjoin K ({t} : Set F) with hLdef
    set M := IntermediateField.adjoin K ({f} : Set F) with hMdef
    let b := Module.finBasis L F
    let S : Set F := insert t (Set.range b)
    have : Finite S := (Set.Finite.insert t (Set.finite_range b)).to_subtype
    have hint : ∀ x ∈ S, IsIntegral M x := fun x _ =>
      (Algebra.IsAlgebraic.isAlgebraic x).isIntegral
    have hE : FiniteDimensional M (IntermediateField.adjoin M S) :=
      IntermediateField.finiteDimensional_adjoin hint
    have htop : IntermediateField.adjoin M S = ⊤ := by
      rw [eq_top_iff]
      intro x _
      have hL : L ≤ (IntermediateField.adjoin M S).restrictScalars K := by
        rw [hLdef, IntermediateField.adjoin_simple_le_iff, IntermediateField.mem_restrictScalars]
        exact IntermediateField.subset_adjoin M S (Set.mem_insert t _)
      rw [← b.sum_repr x]
      apply IntermediateField.sum_mem
      intro i _
      rw [Algebra.smul_def, IntermediateField.algebraMap_apply]
      apply IntermediateField.mul_mem
      · exact (IntermediateField.mem_restrictScalars K).mp (hL (b.repr x i).2)
      · exact IntermediateField.subset_adjoin M S (Set.mem_insert_of_mem t (Set.mem_range_self i))
    rw [htop] at hE
    exact LinearEquiv.finiteDimensional
      (IntermediateField.topEquiv : (⊤ : IntermediateField M F) ≃ₐ[M] F).toLinearEquiv

  unfold wcRRFinRank
  intro f hfr
  have hf : Transcendental K f := htr f hfr
  haveI : FiniteDimensional (IntermediateField.adjoin K {f}) F := hfd f hf
  have key : ∀ q : Polynomial K,
      algebraMap (IntermediateField.adjoin K {f}) F
        (Polynomial.aeval (IntermediateField.AdjoinSimple.gen K f) q) = Polynomial.aeval f q := by
    intro q
    rw [← Polynomial.aeval_algebraMap_apply, IntermediateField.AdjoinSimple.algebraMap_gen]
  refine ⟨Module.finrank (IntermediateField.adjoin K {f}) F,
    ⟨Module.finBasis (IntermediateField.adjoin K {f}) F, ?_⟩, ?_⟩
  · intro p hp
    have hb := (Module.finBasis (IntermediateField.adjoin K {f}) F).linearIndependent
    have hc : ∑ j, (Polynomial.aeval (IntermediateField.AdjoinSimple.gen K f) (p j)) •
        (Module.finBasis (IntermediateField.adjoin K {f}) F) j = 0 := by
      simp only [Algebra.smul_def, key]
      exact hp
    have hc0 := Fintype.linearIndependent_iff.mp hb _ hc
    funext j
    have h0 : Polynomial.aeval f (p j) = 0 := by rw [← key, hc0 j, map_zero]
    exact (transcendental_iff.mp hf) _ h0
  · intro v
    have hnli : ¬ LinearIndependent (IntermediateField.adjoin K {f}) v := by
      intro h
      have := h.fintype_card_le_finrank
      simp at this
    obtain ⟨g, hg, i₀, hi₀⟩ := Fintype.not_linearIndependent_iff.mp hnli
    have hrs : ∀ i, ∃ r s : Polynomial K,
        ((g i : IntermediateField.adjoin K {f}) : F) * Polynomial.aeval f s = Polynomial.aeval f r ∧
          Polynomial.aeval f s ≠ 0 := by
      intro i
      by_cases hgi : g i = 0
      · exact ⟨0, 1, by simp [hgi], by simp⟩
      · obtain ⟨r, s, hrs⟩ := (IntermediateField.mem_adjoin_simple_iff K _).mp (g i).2
        have hs : Polynomial.aeval f s ≠ 0 := by
          intro h0
          rw [h0, div_zero] at hrs
          exact hgi (Subtype.ext hrs)
        exact ⟨r, s, by rw [hrs, div_mul_cancel₀ _ hs], hs⟩
    choose r s hr hs using hrs
    have hΔ0 : (∏ j, Polynomial.aeval f (s j)) ≠ 0 :=
      Finset.prod_ne_zero_iff.mpr (fun j _ => hs j)
    have hp : ∀ i, Polynomial.aeval f (r i * ∏ j ∈ Finset.univ.erase i, s j) =
        ((g i : IntermediateField.adjoin K {f}) : F) * ∏ j, Polynomial.aeval f (s j) := by
      intro i
      rw [Polynomial.aeval_mul, map_prod, ← hr i, mul_assoc,
        Finset.mul_prod_erase Finset.univ (fun j => Polynomial.aeval f (s j)) (Finset.mem_univ i)]
    refine ⟨fun i => r i * ∏ j ∈ Finset.univ.erase i, s j, ?_, ?_⟩
    · intro h
      have h1 := congrFun h i₀
      simp only [Pi.zero_apply] at h1
      have h2 := hp i₀
      rw [h1, map_zero] at h2
      apply hi₀
      have h3 : ((g i₀ : IntermediateField.adjoin K {f}) : F) = 0 := by
        rcases mul_eq_zero.mp h2.symm with h | h
        · exact h
        · exact absurd h hΔ0
      exact Subtype.ext h3
    · simp only [hp]
      have hg' : ∑ i, ((g i : IntermediateField.adjoin K {f}) : F) * v i = 0 := by
        simpa [Algebra.smul_def] using hg
      calc ∑ i, ((g i : IntermediateField.adjoin K {f}) : F) * (∏ j, Polynomial.aeval f (s j)) * v i
          = (∏ j, Polynomial.aeval f (s j)) *
              ∑ i, ((g i : IntermediateField.adjoin K {f}) : F) * v i := by
            rw [Finset.mul_sum]
            exact Finset.sum_congr rfl (fun i _ => by ring)
        _ = 0 := by rw [hg', mul_zero]

theorem wcpa_dj_fva_cj_rr_jets : ∀ (Ω F I : Type u) [Field Ω] [IsAlgClosed Ω] [Field F] [Algebra Ω F]
    (w : I → Additive Fˣ →+ ℤ), wcValFamily Ω F I w → Function.Injective w → wcRRFinRank Ω F →
    ∃ c : ℕ, ∀ (D : I →₀ ℤ) (S : Finset I) (m : I → ℕ) (τ : I → Fˣ) (j : I → F),
      (c : ℤ) + ∑ i ∈ S, (m i : ℤ) ≤ D.sum (fun _ k => k) →
      (∀ i ∈ S, w i (Additive.ofMul (τ i)) = D i) →
      (∀ i ∈ S, ∀ hj : j i ≠ 0, 0 ≤ w i (Additive.ofMul (Units.mk0 (j i) hj))) →
      ∃ u : F, (∀ hu : u ≠ 0, ∀ i, 0 ≤ w i (Additive.ofMul (Units.mk0 u hu)) + D i) ∧
        ∀ i ∈ S, ∀ h : (τ i : F) * u - j i ≠ 0,
          (m i : ℤ) ≤ w i (Additive.ofMul (Units.mk0 ((τ i : F) * u - j i) h)) :=
by
  intro Ω F I _ _ _ _ w hw hinj hA6
  classical
  have hRes := wc_rr_residue_trivial Ω F I w hw hA6
  have hDim := wc_rr_dimension_step Ω F I w hw hRes
  have hPole := wc_rr_pole_degree_le Ω F I w hw hinj hRes
  have h0 := wc_rr_degree_zero Ω F I w hw hA6 hDim hPole
  obtain ⟨g, c, hRR⟩ := wc_rr_abstract_large_degree Ω F I w hw hA6 hDim hPole h0
  obtain ⟨A1, -, -, A4⟩ := hw

  have hcongr : ∀ (i : I) (x y : F) (hx : x ≠ 0) (hy : y ≠ 0), x = y →
      w i (Additive.ofMul (Units.mk0 x hx)) = w i (Additive.ofMul (Units.mk0 y hy)) := by
    intro i x y hx hy hxy
    subst hxy
    rfl
  have hmul : ∀ (i : I) (x y : F) (hx : x ≠ 0) (hy : y ≠ 0),
      w i (Additive.ofMul (Units.mk0 (x * y) (mul_ne_zero hx hy))) =
        w i (Additive.ofMul (Units.mk0 x hx)) + w i (Additive.ofMul (Units.mk0 y hy)) := by
    intro i x y hx hy
    rw [show Units.mk0 (x * y) (mul_ne_zero hx hy) = Units.mk0 x hx * Units.mk0 y hy from
      Units.ext rfl, ofMul_mul, map_add]
  have hmulU : ∀ (i : I) (t : Fˣ) (x : F) (hx : x ≠ 0) (h : (t : F) * x ≠ 0),
      w i (Additive.ofMul (Units.mk0 ((t : F) * x) h)) =
        w i (Additive.ofMul t) + w i (Additive.ofMul (Units.mk0 x hx)) := by
    intro i t x hx h
    rw [show Units.mk0 ((t : F) * x) h = t * Units.mk0 x hx from Units.ext rfl, ofMul_mul,
      map_add]
  have hconst : ∀ (i : I) (a : Ω) (ha : algebraMap Ω F a ≠ 0),
      w i (Additive.ofMul (Units.mk0 _ ha)) = 0 := by
    intro i a ha
    have h1 := (A4 (Units.mk0 _ ha)).mpr ⟨a, rfl⟩ i
    have ha' : algebraMap Ω F a⁻¹ ≠ 0 := by rw [map_inv₀]; exact inv_ne_zero ha
    have h2 := (A4 (Units.mk0 _ ha')).mpr ⟨a⁻¹, rfl⟩ i
    have e : Units.mk0 _ ha' = (Units.mk0 _ ha)⁻¹ := Units.ext (by simp [map_inv₀])
    rw [e, ofMul_inv, map_neg] at h2
    omega
  have hm1 : ∀ i : I, w i (Additive.ofMul (-1 : Fˣ)) = 0 := by
    intro i
    have e : (-1 : Fˣ) * (-1) = 1 := by simp
    have h2 : w i (Additive.ofMul ((-1 : Fˣ) * (-1))) =
        w i (Additive.ofMul (-1 : Fˣ)) + w i (Additive.ofMul (-1 : Fˣ)) := by
      rw [ofMul_mul, map_add]
    rw [e, ofMul_one, map_zero] at h2
    omega
  have getv : ∀ (i : I) (k : ℤ) (x : F) (hx : x ≠ 0), wcValGe F (w i) k x →
      k ≤ w i (Additive.ofMul (Units.mk0 x hx)) := by
    intro i k x hx h
    rcases h with h | ⟨_, h⟩
    · exact absurd h hx
    · exact h
  have hgeU : ∀ (i : I) (t : Fˣ) (k : ℤ) (x : F), wcValGe F (w i) k x →
      wcValGe F (w i) (w i (Additive.ofMul t) + k) ((t : F) * x) := by
    intro i t k x hx
    rcases hx with hx | ⟨hx, hk⟩
    · left; rw [hx, mul_zero]
    · have h : (t : F) * x ≠ 0 := mul_ne_zero t.ne_zero hx
      right
      refine ⟨h, ?_⟩
      rw [hmulU i t x hx h]
      omega
  have hneg : ∀ (i : I) (k : ℤ) (x : F), wcValGe F (w i) k x → wcValGe F (w i) k (-x) := by
    intro i k x hx
    have h := hgeU i (-1) k x hx
    rw [hm1, zero_add, Units.val_neg, Units.val_one, neg_one_mul] at h
    exact h
  have hadd : ∀ (i : I) (k : ℤ) (x y : F), wcValGe F (w i) k x → wcValGe F (w i) k y →
      wcValGe F (w i) k (x + y) := by
    intro i k x y hx hy
    rcases hx with hx | ⟨hx0, hx⟩
    · rw [hx, zero_add]; exact hy
    rcases hy with hy | ⟨hy0, hy⟩
    · rw [hy, add_zero]; exact Or.inr ⟨hx0, hx⟩
    by_cases hs : x + y = 0
    · exact Or.inl hs
    refine Or.inr ⟨hs, ?_⟩
    have := A1 i (Units.mk0 x hx0) (Units.mk0 y hy0) (Units.mk0 (x + y) hs) rfl
    exact le_trans (le_min hx hy) this
  have hsub : ∀ (i : I) (k : ℤ) (x y : F), wcValGe F (w i) k x → wcValGe F (w i) k y →
      wcValGe F (w i) k (x - y) := by
    intro i k x y hx hy
    rw [sub_eq_add_neg]
    exact hadd i k x (-y) hx (hneg i k y hy)
  have hsum : ∀ (i : I) (k : ℤ) (s : Finset I) (f : I → F),
      (∀ a ∈ s, wcValGe F (w i) k (f a)) → wcValGe F (w i) k (∑ a ∈ s, f a) := by
    intro i k s f hf
    induction s using Finset.induction_on with
    | empty => left; simp
    | insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact hadd _ _ _ _ (hf a (Finset.mem_insert_self a s))
        (ih (fun b hb => hf b (Finset.mem_insert_of_mem hb)))
  have hsmulC : ∀ (i : I) (k : ℤ) (a : Ω) (x : F), wcValGe F (w i) k x →
      wcValGe F (w i) k (algebraMap Ω F a * x) := by
    intro i k a x hx
    by_cases ha : algebraMap Ω F a = 0
    · left; rw [ha, zero_mul]
    · have h := hgeU i (Units.mk0 _ ha) k x hx
      rw [hconst, zero_add] at h
      exact h

  have hmem : ∀ (E : I →₀ ℤ) (f : F),
      f ∈ wcRRL Ω F I w E ↔ ∀ i, wcValGe F (w i) (-E i) f := by
    intro E f
    constructor
    · intro hf i
      unfold wcRRL at hf
      induction hf using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨hx0, hx⟩ := hx
        exact Or.inr ⟨hx0, by have := hx i; omega⟩
      | zero => exact Or.inl rfl
      | add x y _ _ hx hy => exact hadd _ _ _ _ hx hy
      | smul a x _ hx => rw [Algebra.smul_def]; exact hsmulC _ _ _ _ hx
    · intro hf
      by_cases hf0 : f = 0
      · rw [hf0]; exact Submodule.zero_mem _
      · unfold wcRRL
        refine Submodule.subset_span ⟨hf0, fun i => ?_⟩
        have := getv i _ f hf0 (hf i)
        omega

  have hex : ∀ (D : I →₀ ℤ) (S : Finset I) (m : I → ℕ),
      (c : ℤ) + ∑ i ∈ S, (m i : ℤ) ≤ D.sum (fun _ k => k) → ∀ i₀ ∈ S, ∀ k : ℕ, k < m i₀ →
      ∃ f : F, ∃ hf : f ≠ 0, (∀ i, 0 ≤ w i (Additive.ofMul (Units.mk0 f hf)) + D i) ∧
        w i₀ (Additive.ofMul (Units.mk0 f hf)) + D i₀ = k ∧
        ∀ i ∈ S, i ≠ i₀ → (m i : ℤ) ≤ w i (Additive.ofMul (Units.mk0 f hf)) + D i := by
    intro D S m hdeg i₀ hi₀ k hk
    obtain ⟨E, hE⟩ : ∃ E : I →₀ ℤ,
        E = D - ∑ a ∈ S.erase i₀, Finsupp.single a (m a : ℤ) - Finsupp.single i₀ (k : ℤ) :=
      ⟨_, rfl⟩
    have hEv : ∀ i, E i = D i - (∑ a ∈ S.erase i₀, Finsupp.single a (m a : ℤ) i) -
        Finsupp.single i₀ (k : ℤ) i := by
      intro i
      rw [hE, Finsupp.sub_apply, Finsupp.sub_apply, Finsupp.finset_sum_apply]
    have hEle : ∀ i, E i ≤ D i := by
      intro i
      rw [hEv i]
      have h1 : 0 ≤ ∑ a ∈ S.erase i₀, Finsupp.single a (m a : ℤ) i :=
        Finset.sum_nonneg (fun a _ => by rw [Finsupp.single_apply]; split_ifs <;> omega)
      have h2 : 0 ≤ Finsupp.single i₀ (k : ℤ) i := by
        rw [Finsupp.single_apply]; split_ifs <;> omega
      omega
    have hEi₀ : E i₀ = D i₀ - k := by
      rw [hEv i₀, Finset.sum_eq_zero (fun a ha => by
        rw [Finsupp.single_apply, if_neg (Finset.ne_of_mem_erase ha)]), Finsupp.single_eq_same]
      ring
    have hEi : ∀ i ∈ S, i ≠ i₀ → E i = D i - m i := by
      intro i hi hne
      rw [hEv i, Finset.sum_eq_single_of_mem i (Finset.mem_erase.mpr ⟨hne, hi⟩)
        (fun b _ hb => by rw [Finsupp.single_apply, if_neg hb]), Finsupp.single_eq_same,
        Finsupp.single_apply, if_neg (Ne.symm hne)]
      ring
    have hdegE : E.sum (fun _ k => k) =
        D.sum (fun _ k => k) - ∑ a ∈ S.erase i₀, (m a : ℤ) - k := by
      have e1 : ∀ a, (Finsupp.single a (m a : ℤ)).sum (fun _ k => k) = (m a : ℤ) :=
        fun a => Finsupp.sum_single_index rfl
      have e2 : (Finsupp.single i₀ (k : ℤ)).sum (fun _ k => k) = (k : ℤ) :=
        Finsupp.sum_single_index rfl
      rw [hE, Finsupp.sum_sub_index (fun _ _ _ => rfl), Finsupp.sum_sub_index (fun _ _ _ => rfl),
        ← Finsupp.sum_finset_sum_index (fun _ => rfl) (fun _ _ _ => rfl),
        Finset.sum_congr rfl (fun a _ => e1 a), e2]
    have hSe : (m i₀ : ℤ) + ∑ a ∈ S.erase i₀, (m a : ℤ) = ∑ a ∈ S, (m a : ℤ) :=
      Finset.add_sum_erase S (fun a => (m a : ℤ)) hi₀
    have hdegE' : (c : ℤ) + 1 ≤ E.sum (fun _ k => k) := by
      have hk' : (k : ℤ) + 1 ≤ m i₀ := by exact_mod_cast hk
      linarith
    have hdegE'' : (E - Finsupp.single i₀ 1).sum (fun _ k => k) = E.sum (fun _ k => k) - 1 := by
      rw [Finsupp.sum_sub_index (fun _ _ _ => rfl), Finsupp.sum_single_index rfl]
    obtain ⟨_, hrkE⟩ := hRR E (by linarith)
    obtain ⟨_, hrkE'⟩ := hRR (E - Finsupp.single i₀ 1) (by linarith)
    have hle : E - Finsupp.single i₀ 1 ≤ E := by
      rw [Finsupp.le_def]
      intro i
      rw [Finsupp.sub_apply, Finsupp.single_apply]
      split_ifs <;> omega
    have hsubm := (hDim.2.2 _ _ hle).1
    have hlt : wcRRL Ω F I w (E - Finsupp.single i₀ 1) < wcRRL Ω F I w E :=
      Submodule.lt_of_le_of_finrank_lt_finrank hsubm (by omega)
    obtain ⟨f, hfE, hfE'⟩ := SetLike.exists_of_lt hlt
    have hf0 : f ≠ 0 := fun h => hfE' (h ▸ Submodule.zero_mem _)
    have hfv : ∀ i, -E i ≤ w i (Additive.ofMul (Units.mk0 f hf0)) :=
      fun i => getv i _ f hf0 ((hmem E f).mp hfE i)
    obtain ⟨i, hi⟩ : ∃ i, ¬ wcValGe F (w i) (-((E - Finsupp.single i₀ 1 : I →₀ ℤ) i)) f := by
      by_contra hc
      push_neg at hc
      exact hfE' ((hmem _ f).mpr hc)
    have hlt' : w i (Additive.ofMul (Units.mk0 f hf0)) <
        -((E - Finsupp.single i₀ 1 : I →₀ ℤ) i) := by
      by_contra hc
      push_neg at hc
      exact hi (Or.inr ⟨hf0, hc⟩)
    have hii : i = i₀ := by
      by_contra hne
      rw [Finsupp.sub_apply, Finsupp.single_apply, if_neg (Ne.symm hne)] at hlt'
      have := hfv i
      omega
    rw [hii, Finsupp.sub_apply, Finsupp.single_eq_same] at hlt'
    have hfi₀ := hfv i₀
    refine ⟨f, hf0, fun i => ?_, ?_, fun i hi hne => ?_⟩
    · have := hfv i; have := hEle i; omega
    · omega
    · have := hfv i; have := hEi i hi hne; omega
  refine ⟨c, ?_⟩
  intro D S m τ j hdeg hτ hj

  have single : ∀ i₀ ∈ S, ∃ v : F, (∀ i, wcValGe F (w i) (-D i) v) ∧
      (∀ i ∈ S, i ≠ i₀ → wcValGe F (w i) (m i) ((τ i : F) * v)) ∧
      wcValGe F (w i₀) (m i₀) ((τ i₀ : F) * v - j i₀) := by
    intro i₀ hi₀
    have key : ∀ k : ℕ, k ≤ m i₀ → ∃ v : F, (∀ i, wcValGe F (w i) (-D i) v) ∧
        (∀ i ∈ S, i ≠ i₀ → wcValGe F (w i) (m i) ((τ i : F) * v)) ∧
        wcValGe F (w i₀) k ((τ i₀ : F) * v - j i₀) := by
      intro k
      induction k with
      | zero =>
        intro _
        refine ⟨0, fun i => Or.inl rfl, fun i _ _ => Or.inl (mul_zero _), ?_⟩
        rw [mul_zero, zero_sub]
        apply hneg
        by_cases hj0 : j i₀ = 0
        · exact Or.inl hj0
        · exact Or.inr ⟨hj0, by exact_mod_cast hj i₀ hi₀ hj0⟩
      | succ k ih =>
        intro hk
        obtain ⟨v, hR, hO, hJ⟩ := ih (by omega)
        obtain ⟨r, hr⟩ : ∃ r : F, r = (τ i₀ : F) * v - j i₀ := ⟨_, rfl⟩
        rw [← hr] at hJ
        by_cases hA : wcValGe F (w i₀) ((k + 1 : ℕ) : ℤ) r
        · exact ⟨v, hR, hO, hr ▸ hA⟩
        have hr0 : r ≠ 0 := fun h => hA (Or.inl h)
        have hrk := getv _ _ _ hr0 hJ
        have hrk' : w i₀ (Additive.ofMul (Units.mk0 r hr0)) < k + 1 := by
          by_contra hc
          push_neg at hc
          exact hA (Or.inr ⟨hr0, by push_cast; exact hc⟩)
        obtain ⟨f, hf, hfa, hfb, hfc⟩ := hex D S m hdeg i₀ hi₀ k (by omega)
        have ht0 : (τ i₀ : F) * f ≠ 0 := mul_ne_zero (τ i₀).ne_zero hf
        have hvt : w i₀ (Additive.ofMul (Units.mk0 ((τ i₀ : F) * f) ht0)) = k := by
          rw [hmulU i₀ (τ i₀) f hf ht0, hτ i₀ hi₀]
          omega
        have hh0 : r / ((τ i₀ : F) * f) ≠ 0 := div_ne_zero hr0 ht0
        have hrht : r = r / ((τ i₀ : F) * f) * ((τ i₀ : F) * f) := (div_mul_cancel₀ r ht0).symm
        have hvh : w i₀ (Additive.ofMul (Units.mk0 (r / ((τ i₀ : F) * f)) hh0)) = 0 := by
          have e := hmul i₀ _ _ hh0 ht0
          rw [hcongr i₀ _ r _ hr0 hrht.symm] at e
          omega
        obtain ⟨a, ha⟩ := hRes i₀ (Units.mk0 _ hh0) hvh
        have hid : (τ i₀ : F) * (v - algebraMap Ω F a * f) - j i₀ =
            ((τ i₀ : F) * f) * (r / ((τ i₀ : F) * f) - algebraMap Ω F a) := by
          linear_combination hrht - hr
        have hfD : ∀ i, wcValGe F (w i) (-D i) f :=
          fun i => Or.inr ⟨hf, by have := hfa i; omega⟩
        refine ⟨v - algebraMap Ω F a * f, fun i => hsub _ _ _ _ (hR i) (hsmulC _ _ _ _ (hfD i)),
          fun i hi hne => ?_, ?_⟩
        · have e : (τ i : F) * (v - algebraMap Ω F a * f) =
              (τ i : F) * v - algebraMap Ω F a * ((τ i : F) * f) := by ring
          rw [e]
          have h1 := hgeU i (τ i) ((m i : ℤ) - D i) f
            (Or.inr ⟨hf, by have := hfc i hi hne; omega⟩)
          have e2 : D i + ((m i : ℤ) - D i) = m i := by ring
          rw [hτ i hi, e2] at h1
          exact hsub _ _ _ _ (hO i hi hne) (hsmulC _ _ _ _ h1)
        · rw [hid]
          rcases ha with ha | ⟨h', hh', hpos⟩
          · left
            have : r / ((τ i₀ : F) * f) - algebraMap Ω F a = 0 := by
              rw [sub_eq_zero]; exact ha
            rw [this, mul_zero]
          · rw [Units.val_mk0] at hh'
            rw [← hh']
            have h1 := hgeU i₀ (Units.mk0 _ ht0) 1 (h' : F)
              (Or.inr ⟨h'.ne_zero, by rw [Units.mk0_val]; omega⟩)
            rw [hvt] at h1
            push_cast
            exact h1
    exact key (m i₀) le_rfl
  have hU : ∀ i₀, ∃ v : F, i₀ ∈ S → (∀ i, wcValGe F (w i) (-D i) v) ∧
      (∀ i ∈ S, i ≠ i₀ → wcValGe F (w i) (m i) ((τ i : F) * v)) ∧
      wcValGe F (w i₀) (m i₀) ((τ i₀ : F) * v - j i₀) := by
    intro i₀
    by_cases hi₀ : i₀ ∈ S
    · obtain ⟨v, h⟩ := single i₀ hi₀
      exact ⟨v, fun _ => h⟩
    · exact ⟨0, fun h => absurd h hi₀⟩
  choose U hU using hU
  refine ⟨∑ a ∈ S, U a, ?_, ?_⟩
  · intro hu i
    have h1 := hsum i (-D i) S U (fun a ha => (hU a ha).1 i)
    have h2 := getv _ _ _ hu h1
    omega
  · intro i hi h
    have e : (τ i : F) * ∑ a ∈ S, U a - j i =
        ((τ i : F) * U i - j i) + ∑ a ∈ S.erase i, (τ i : F) * U a := by
      rw [Finset.mul_sum, ← Finset.add_sum_erase S _ hi]
      ring
    have hv : wcValGe F (w i) (m i) ((τ i : F) * ∑ a ∈ S, U a - j i) := by
      rw [e]
      exact hadd _ _ _ _ (hU i hi).2.2 (hsum i (m i) (S.erase i) (fun a => (τ i : F) * U a)
        (fun a ha => (hU a (Finset.mem_of_mem_erase ha)).2.1 i hi (Finset.ne_of_mem_erase ha).symm))
    exact getv _ _ _ h hv

theorem wcpa_dj_lqu_sp_node_basis : ∀ (L : Type u) [Field L] (R : Type u) [CommRing R] [IsLocalRing R] (φ : L →+* R) (ψ : R →+* (MvPowerSeries (Fin 2) L ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})), ψ.comp φ = (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})).comp MvPowerSeries.C → (∀ (n : ℕ) (t : MvPowerSeries (Fin 2) L), ∃ r : R, ψ r - Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) t ∈ Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})) (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n)) → (∀ (n : ℕ) (r : R), ψ r ∈ Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})) (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n) ↔ r ∈ IsLocalRing.maximalIdeal R ^ n) → ∃ u v : R, (u ∈ IsLocalRing.maximalIdeal R ∧ v ∈ IsLocalRing.maximalIdeal R ∧ (∀ y ∈ IsLocalRing.maximalIdeal R, ∃ c₁ c₂ : L, y - (φ c₁ * u + φ c₂ * v) ∈ IsLocalRing.maximalIdeal R ^ 2) ∧ (∀ c₁ c₂ : L, φ c₁ * u + φ c₂ * v ∈ IsLocalRing.maximalIdeal R ^ 2 → c₁ = 0 ∧ c₂ = 0)) ∧ u * v ∈ IsLocalRing.maximalIdeal R ^ 3 :=
by
  intro L _ R _ _ φ ψ hφ hd hs
  classical
  set mk := Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 :
    MvPowerSeries (Fin 2) L)}) with hmk
  set N := IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) with hN

  have memN : ∀ T : MvPowerSeries (Fin 2) L, T ∈ N ↔ MvPowerSeries.constantCoeff T = 0 := by
    intro T
    rw [hN, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff,
      isUnit_iff_ne_zero, not_not]
  have hX : ∀ i : Fin 2, (MvPowerSeries.X i : MvPowerSeries (Fin 2) L) ∈ N := by
    intro i
    rw [memN, MvPowerSeries.constantCoeff_X]

  have hD : ∀ f : MvPowerSeries (Fin 2) L, MvPowerSeries.constantCoeff f = 0 →
      ∃ A B : MvPowerSeries (Fin 2) L, f = MvPowerSeries.X 0 * A + MvPowerSeries.X 1 * B := by
    intro f hf
    let A : MvPowerSeries (Fin 2) L := fun d => MvPowerSeries.coeff (d + Finsupp.single 0 1) f
    have hA : ∀ m : Fin 2 →₀ ℕ, 1 ≤ m 0 →
        MvPowerSeries.coeff m (MvPowerSeries.X 0 * A) = MvPowerSeries.coeff m f := by
      intro m hm
      have hle : Finsupp.single (0 : Fin 2) 1 ≤ m := Finsupp.single_le_iff.mpr hm
      rw [MvPowerSeries.X_def, MvPowerSeries.coeff_monomial_mul, if_pos hle, one_mul]
      show MvPowerSeries.coeff (m - Finsupp.single 0 1 + Finsupp.single 0 1) f = _
      rw [tsub_add_cancel_of_le hle]
    have hdvd : MvPowerSeries.X 1 ∣ f - MvPowerSeries.X 0 * A := by
      rw [MvPowerSeries.X_dvd_iff]
      intro m hm1
      by_cases hm0 : 1 ≤ m 0
      · rw [map_sub, hA m hm0, sub_self]
      · have hm : m = 0 := by
          ext i
          fin_cases i
          · simp only [Finsupp.coe_zero, Pi.zero_apply]; simp at hm0 ⊢; omega
          · simpa using hm1
        subst hm
        rw [map_sub, MvPowerSeries.coeff_zero_eq_constantCoeff_apply,
          MvPowerSeries.coeff_zero_eq_constantCoeff_apply, hf, map_mul,
          MvPowerSeries.constantCoeff_X, zero_mul, sub_zero]
    obtain ⟨B, hB⟩ := hdvd
    exact ⟨A, B, by rw [← hB]; ring⟩

  have s8a : ∀ T ∈ N, ∃ c₁ c₂ : L,
      T - (MvPowerSeries.C c₁ * MvPowerSeries.X 0 + MvPowerSeries.C c₂ * MvPowerSeries.X 1) ∈ N ^ 2 := by
    intro T hT
    obtain ⟨A, B, hAB⟩ := hD T ((memN T).mp hT)
    refine ⟨MvPowerSeries.constantCoeff A, MvPowerSeries.constantCoeff B, ?_⟩
    have hA' : A - MvPowerSeries.C (MvPowerSeries.constantCoeff A) ∈ N := by
      rw [memN, map_sub, MvPowerSeries.constantCoeff_C, sub_self]
    have hB' : B - MvPowerSeries.C (MvPowerSeries.constantCoeff B) ∈ N := by
      rw [memN, map_sub, MvPowerSeries.constantCoeff_C, sub_self]
    have heq : T - (MvPowerSeries.C (MvPowerSeries.constantCoeff A) * MvPowerSeries.X 0 +
        MvPowerSeries.C (MvPowerSeries.constantCoeff B) * MvPowerSeries.X 1) =
        MvPowerSeries.X 0 * (A - MvPowerSeries.C (MvPowerSeries.constantCoeff A)) +
        MvPowerSeries.X 1 * (B - MvPowerSeries.C (MvPowerSeries.constantCoeff B)) := by
      rw [hAB]; ring
    rw [heq, pow_two]
    exact add_mem (Ideal.mul_mem_mul (hX 0) hA') (Ideal.mul_mem_mul (hX 1) hB')

  have s8b : ∀ e : Fin 2 →₀ ℕ, e 0 + e 1 ≤ 1 → ∀ T ∈ N ^ 2, MvPowerSeries.coeff e T = 0 := by
    intro e he T hT
    rw [pow_two] at hT
    refine Submodule.mul_induction_on (C := fun x => MvPowerSeries.coeff e x = 0) hT ?_ ?_
    · intro a ha b hb
      show MvPowerSeries.coeff e (a * b) = 0
      rw [MvPowerSeries.coeff_mul]
      apply Finset.sum_eq_zero
      intro p hp
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
      have h0 : p.1 0 + p.2 0 = e 0 := by rw [← hp]; rfl
      have h1 : p.1 1 + p.2 1 = e 1 := by rw [← hp]; rfl
      by_cases hp1 : p.1 0 = 0 ∧ p.1 1 = 0
      · have hz : p.1 = 0 := by
          ext i
          fin_cases i
          · simpa using hp1.1
          · simpa using hp1.2
        rw [hz, MvPowerSeries.coeff_zero_eq_constantCoeff_apply, (memN a).mp ha, zero_mul]
      · have hz : p.2 = 0 := by
          ext i
          fin_cases i
          · simp only [Finsupp.coe_zero, Pi.zero_apply]; simp; omega
          · simp only [Finsupp.coe_zero, Pi.zero_apply]; simp; omega
        rw [hz, MvPowerSeries.coeff_zero_eq_constantCoeff_apply, (memN b).mp hb, mul_zero]
    · intro x y hx hy
      show MvPowerSeries.coeff e (x + y) = 0
      rw [map_add, hx, hy, add_zero]

  have hM : ∀ k : ℕ, ∀ T ∈ N ^ k, mk T ∈ Ideal.map mk (N ^ k) :=
    fun k T hT => Ideal.mem_map_of_mem _ hT
  have hMmono : ∀ {a b : ℕ}, a ≤ b → Ideal.map mk (N ^ b) ≤ Ideal.map mk (N ^ a) :=
    fun h => Ideal.map_mono (Ideal.pow_le_pow_right h)
  have hMsurj : ∀ (k : ℕ) (z : MvPowerSeries (Fin 2) L ⧸ Ideal.span {(MvPowerSeries.X 0 *
      MvPowerSeries.X 1 : MvPowerSeries (Fin 2) L)}), z ∈ Ideal.map mk (N ^ k) →
      ∃ T ∈ N ^ k, mk T = z :=
    fun k z hz => (Ideal.mem_map_iff_of_surjective mk Ideal.Quotient.mk_surjective).mp hz
  have hP3 : ∀ c : L, ψ (φ c) = mk (MvPowerSeries.C c) := fun c => by
    have := RingHom.congr_fun hφ c
    simpa using this
  have hP4 : mk (MvPowerSeries.X 0 * MvPowerSeries.X 1) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
  obtain ⟨u, hu⟩ := hd 3 (MvPowerSeries.X 0)
  obtain ⟨v, hv⟩ := hd 3 (MvPowerSeries.X 1)
  set δ₀ := ψ u - mk (MvPowerSeries.X 0) with hδ₀
  set δ₁ := ψ v - mk (MvPowerSeries.X 1) with hδ₁
  have hψu : ψ u = mk (MvPowerSeries.X 0) + δ₀ := by rw [hδ₀]; ring
  have hψv : ψ v = mk (MvPowerSeries.X 1) + δ₁ := by rw [hδ₁]; ring
  have h32 : (2 : ℕ) ≤ 3 := by norm_num
  have h31 : (1 : ℕ) ≤ 3 := by norm_num
  have hδ₀2 : δ₀ ∈ Ideal.map mk (N ^ 2) := hMmono h32 hu
  have hδ₁2 : δ₁ ∈ Ideal.map mk (N ^ 2) := hMmono h32 hv
  have hδ₀1 : δ₀ ∈ Ideal.map mk (N ^ 1) := hMmono h31 hu
  have hδ₁1 : δ₁ ∈ Ideal.map mk (N ^ 1) := hMmono h31 hv
  have hx0 : mk (MvPowerSeries.X 0) ∈ Ideal.map mk (N ^ 1) := hM 1 _ (by rw [pow_one]; exact hX 0)
  have hx1 : mk (MvPowerSeries.X 1) ∈ Ideal.map mk (N ^ 1) := hM 1 _ (by rw [pow_one]; exact hX 1)
  refine ⟨u, v, ⟨?_, ?_, ?_, ?_⟩, ?_⟩
  · have h := (hs 1 u).mp (by rw [hψu]; exact Ideal.add_mem _ hx0 hδ₀1)
    rwa [pow_one] at h
  · have h := (hs 1 v).mp (by rw [hψv]; exact Ideal.add_mem _ hx1 hδ₁1)
    rwa [pow_one] at h
  · intro y hy
    have h1 : ψ y ∈ Ideal.map mk (N ^ 1) := (hs 1 y).mpr (by rw [pow_one]; exact hy)
    obtain ⟨Y, hY, hYy⟩ := hMsurj 1 _ h1
    rw [pow_one] at hY
    obtain ⟨c₁, c₂, hc⟩ := s8a Y hY
    refine ⟨c₁, c₂, (hs 2 _).mp ?_⟩
    have heq : ψ (y - (φ c₁ * u + φ c₂ * v)) =
        mk (Y - (MvPowerSeries.C c₁ * MvPowerSeries.X 0 + MvPowerSeries.C c₂ * MvPowerSeries.X 1)) -
        (mk (MvPowerSeries.C c₁) * δ₀ + mk (MvPowerSeries.C c₂) * δ₁) := by
      rw [map_sub, map_add, map_mul, map_mul, hP3, hP3, hψu, hψv, ← hYy, map_sub, map_add, map_mul,
        map_mul]
      ring
    rw [heq]
    exact Ideal.sub_mem _ (hM 2 _ hc)
      (Ideal.add_mem _ (Ideal.mul_mem_left _ _ hδ₀2) (Ideal.mul_mem_left _ _ hδ₁2))
  · intro c₁ c₂ hc
    have h2 := (hs 2 _).mpr hc
    have heq : ψ (φ c₁ * u + φ c₂ * v) =
        mk (MvPowerSeries.C c₁ * MvPowerSeries.X 0 + MvPowerSeries.C c₂ * MvPowerSeries.X 1) +
        (mk (MvPowerSeries.C c₁) * δ₀ + mk (MvPowerSeries.C c₂) * δ₁) := by
      rw [map_add, map_mul, map_mul, hP3, hP3, hψu, hψv, map_add, map_mul, map_mul]
      ring
    rw [heq] at h2
    have h3 : mk (MvPowerSeries.C c₁ * MvPowerSeries.X 0 + MvPowerSeries.C c₂ * MvPowerSeries.X 1)
        ∈ Ideal.map mk (N ^ 2) := by
      have := Ideal.sub_mem _ h2
        (Ideal.add_mem _ (Ideal.mul_mem_left _ (mk (MvPowerSeries.C c₁)) hδ₀2)
          (Ideal.mul_mem_left _ (mk (MvPowerSeries.C c₂)) hδ₁2))
      rwa [add_sub_cancel_right] at this
    obtain ⟨Nn, hNn, hNZ⟩ := hMsurj 2 _ h3
    have h4 : (MvPowerSeries.C c₁ * MvPowerSeries.X 0 + MvPowerSeries.C c₂ * MvPowerSeries.X 1) - Nn
        ∈ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) L)} :=
      Ideal.Quotient.eq.mp hNZ.symm
    have hX01 : MvPowerSeries.X 0 * MvPowerSeries.X 1 ∈ N ^ 2 := by
      rw [pow_two]; exact Ideal.mul_mem_mul (hX 0) (hX 1)
    have h5 : (MvPowerSeries.C c₁ * MvPowerSeries.X 0 + MvPowerSeries.C c₂ * MvPowerSeries.X 1) - Nn
        ∈ N ^ 2 := (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hX01)) h4
    have hZ : MvPowerSeries.C c₁ * MvPowerSeries.X 0 + MvPowerSeries.C c₂ * MvPowerSeries.X 1
        ∈ N ^ 2 := by
      have := add_mem h5 hNn
      rwa [sub_add_cancel] at this
    have hne : (Finsupp.single (0 : Fin 2) 1 : Fin 2 →₀ ℕ) ≠ Finsupp.single 1 1 := by
      intro h
      have := congrArg (fun f : Fin 2 →₀ ℕ => f 0) h
      simp at this
    have hne' : (Finsupp.single (1 : Fin 2) 1 : Fin 2 →₀ ℕ) ≠ Finsupp.single 0 1 := hne.symm
    have e0 := s8b (Finsupp.single 0 1) (by simp) _ hZ
    have e1 := s8b (Finsupp.single 1 1) (by simp) _ hZ
    simp [MvPowerSeries.coeff_C_mul, MvPowerSeries.coeff_X, hne, hne'] at e0 e1
    exact ⟨e0, e1⟩
  · have huv : ψ (u * v) = mk (MvPowerSeries.X 0 * MvPowerSeries.X 1) +
        (mk (MvPowerSeries.X 0) * δ₁ + δ₀ * (mk (MvPowerSeries.X 1) + δ₁)) := by
      rw [map_mul, hψu, hψv, map_mul]
      ring
    apply (hs 3 _).mp
    rw [huv, hP4, zero_add]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hv) (Ideal.mul_mem_right _ _ hu)

theorem wcpa_dj_fva_cj_branch_count : ∀ (K : Type u) [Field K] [IsAlgClosed K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)), wcpaDjSemistable q → ∀ (x ξ : C), IsClosed ({x} : Set C) →
    ∃ s : Finset (ValuationSubring (C.residueField ξ)), s.card ≤ 2 ∧
      ∀ V, wcpaDjPsBr q x ⟨ξ, V⟩ ↔ V ∈ s :=
by
  have wcpa_dj_fva_bc_val_compare : ∀ (F : Type u) [Field F] (R : Subring F) (U : F), U ∈ R → U ≠ 0 →
      (∀ g ∈ R, ∃ c ∈ R, ∃ r ∈ R, (c = 0 ∨ c⁻¹ ∈ R) ∧ g = c + U * r) →
      (∀ g ∈ R, g ≠ 0 → ∃ (n : ℕ) (η : F), η ∈ R ∧ (∀ r ∈ R, η ≠ U * r) ∧ g = U ^ n * η) →
      (∀ f : F, ∃ g ∈ R, ∃ h ∈ R, h ≠ 0 ∧ f * h = g) →
      ∀ V₁ V₂ : ValuationSubring F, (∀ g ∈ R, g ∈ V₁) → (∀ g ∈ R, g ∈ V₂) →
        U⁻¹ ∉ V₁ → U⁻¹ ∉ V₂ → V₁ = V₂ := by
    intro F _ R U hUR hU0 H1 H2 H3 V₁ V₂ hR₁ hR₂ hU₁ hU₂

    have core : ∀ V : ValuationSubring F, (∀ g ∈ R, g ∈ V) → U⁻¹ ∉ V →
        ∀ (f : F) (n m : ℕ) (η η' : F), η ∈ R → (∀ r ∈ R, η ≠ U * r) → η' ∈ R →
          (∀ r ∈ R, η' ≠ U * r) → f * (U ^ m * η') = U ^ n * η → (f ∈ V ↔ m ≤ n) := by
      intro V hRV hUV f n m η η' hη hηU hη' hη'U hf
      set v := V.valuation with hv
      have hvU1 : v U ≤ 1 := (V.valuation_le_one_iff U).mpr (hRV U hUR)
      have hvU0 : v U ≠ 0 := by rw [Valuation.ne_zero_iff]; exact hU0
      have hvUlt : v U < 1 := by
        refine lt_of_le_of_ne hvU1 (fun h => hUV ?_)
        rw [← V.valuation_le_one_iff, map_inv₀, h, inv_one]

      have hunit : ∀ η ∈ R, (∀ r ∈ R, η ≠ U * r) → v η = 1 := by
        intro η hη hηU
        obtain ⟨c, hc, r, hr, hc0, hcr⟩ := H1 η hη
        have hc' : c⁻¹ ∈ R := by
          rcases hc0 with h0 | h0
          · exact absurd (by rw [hcr, h0, zero_add]) (hηU r hr)
          · exact h0
        have hcne : c ≠ 0 := by
          intro h0
          exact hηU r hr (by rw [hcr, h0, zero_add])
        have hvc : v c = 1 := by
          have h1 : v c ≤ 1 := (V.valuation_le_one_iff c).mpr (hRV c hc)
          have h2 : v c⁻¹ ≤ 1 := (V.valuation_le_one_iff _).mpr (hRV _ hc')
          rw [map_inv₀] at h2
          have h3 : v c ≠ 0 := by rw [Valuation.ne_zero_iff]; exact hcne
          refine le_antisymm h1 ?_
          by_contra hlt
          push_neg at hlt
          have : 1 < (v c)⁻¹ := one_lt_inv₀ (lt_of_le_of_ne zero_le h3.symm) |>.mpr hlt
          exact absurd h2 (not_le.mpr this)
        have hvr : v r ≤ 1 := (V.valuation_le_one_iff r).mpr (hRV r hr)
        have hlt : v (U * r) < v c := by
          rw [map_mul, hvc]
          calc v U * v r ≤ v U * 1 := by gcongr
            _ = v U := mul_one _
            _ < 1 := hvUlt
        rw [hcr, add_comm, Valuation.map_add_eq_of_lt_right v hlt, hvc]
      have e1 := congrArg v hf
      rw [map_mul, map_mul, map_mul, map_pow, map_pow, hunit η hη hηU, hunit η' hη' hη'U,
        mul_one, mul_one] at e1
      rw [← V.valuation_le_one_iff]
      constructor
      · intro hle
        by_contra hmn
        push_neg at hmn
        obtain ⟨k, rfl⟩ : ∃ k, m = n + (k + 1) := ⟨m - n - 1, by omega⟩
        rw [pow_add, ← mul_assoc, mul_comm (v f), mul_assoc] at e1
        have e2 : v f * v U ^ (k + 1) = 1 := by
          have hpow : v U ^ n ≠ 0 := pow_ne_zero _ hvU0
          exact mul_left_cancel₀ hpow (by rw [e1, mul_one])
        have e3 : v f * v U ^ (k + 1) < 1 := by
          calc v f * v U ^ (k + 1) ≤ 1 * v U ^ (k + 1) := by gcongr
            _ = v U ^ (k + 1) := one_mul _
            _ < 1 := pow_lt_one₀ zero_le hvUlt (Nat.succ_ne_zero k)
        rw [e2] at e3
        exact lt_irrefl _ e3
      · intro hmn
        obtain ⟨k, rfl⟩ : ∃ k, n = m + k := ⟨n - m, by omega⟩
        rw [pow_add] at e1
        have e2 : v f = v U ^ k := by
          have hpow : v U ^ m ≠ 0 := pow_ne_zero _ hvU0
          exact mul_left_cancel₀ hpow (by rw [← e1, mul_comm])
        rw [e2]
        exact pow_le_one₀ zero_le hvU1
    apply ValuationSubring.ext
    intro f
    obtain ⟨g, hg, h, hh, hh0, hfh⟩ := H3 f
    by_cases hg0 : g = 0
    · have hf0 : f = 0 := by
        rw [hg0] at hfh
        exact (mul_eq_zero.mp hfh).resolve_right hh0
      rw [hf0]
      exact ⟨fun _ => V₂.zero_mem, fun _ => V₁.zero_mem⟩
    obtain ⟨n, η, hη, hηU, rfl⟩ := H2 g hg hg0
    obtain ⟨m, η', hη', hη'U, rfl⟩ := H2 h hh hh0
    rw [core V₁ hR₁ hU₁ f n m η η' hη hηU hη' hη'U hfh,
      core V₂ hR₂ hU₂ f n m η η' hη hηU hη' hη'U hfh]
  have wcpa_dj_fva_bc_node_ring : ∀ (K A F : Type u) [Field K] [CommRing A] [IsLocalRing A]
      [IsNoetherianRing A] [Field F] (φ : K →+* A) (ψ : A →+* F) (u v : A),
      (∀ a : A, ∃ z : K, a - φ z ∈ IsLocalRing.maximalIdeal A) →
      (∀ y ∈ IsLocalRing.maximalIdeal A, ∃ α β : A, y = α * u + β * v) →
      u * v ∈ IsLocalRing.maximalIdeal A ^ 3 → ψ u ≠ 0 →
      ∃ R : Subring F, ψ u ∈ R ∧ (∀ a : A, ψ a ∈ R) ∧
        (∀ V : ValuationSubring F, (∀ a : A, ψ a ∈ V) → ψ v / ψ u ∈ V → ∀ g ∈ R, g ∈ V) ∧
        (∀ g ∈ R, ∃ c ∈ R, ∃ r ∈ R, (c = 0 ∨ c⁻¹ ∈ R) ∧ g = c + ψ u * r) ∧
        ((∀ r ∈ R, ψ u * r ≠ 1) → ∀ g ∈ R, g ≠ 0 →
          ∃ (n : ℕ) (η : F), η ∈ R ∧ (∀ r ∈ R, η ≠ ψ u * r) ∧ g = ψ u ^ n * η) := by
    intro K A F _ _ _ _ _ φ ψ u v hres hgen huv hU0
    classical
    set U := ψ u with hUdef
    set t := ψ v / U with htdef
