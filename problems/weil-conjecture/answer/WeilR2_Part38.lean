      simp only [Scheme.Hom.comp_apply]
    · intro a b hab
      have hv := congrArg Subtype.val hab
      exact Subtype.ext hv
  rw [hncard] at h3
  exact le_trans h3 (Nat.add_le_add_left hcard _)

theorem wcpa_dj_sso_stab_descend : ∀ (S Y : Scheme.{u}) (v : Y ⟶ S) (n : ℕ) (σ : Fin n → (S ⟶ Y)), IsProper v → LocallyOfFinitePresentation v → (∀ i, σ i ≫ v = 𝟙 S) → ∀ (K L : Type u) [Field K] [IsAlgClosed K] [Field L] [IsAlgClosed L] (ι : K →+* L) (s : Spec (.of K) ⟶ S), wcpaDjSolStab v n σ L (Spec.map (CommRingCat.ofHom ι) ≫ s) → wcpaDjSolStab v n σ K s :=
by
  intro S Y v n σ hpr hfp hσ K L _ _ _ _ ι s hstab
  classical
  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]

  have spu : ∀ (X P V C : Scheme.{u}) (f : X ⟶ P) (b : V ⟶ P)
      (ψ : C ⟶ X) (g : C ⟶ V) (σ' : P ⟶ X) (τ : V ⟶ C), IsPullback ψ g f b → σ' ≫ f = 𝟙 P →
      τ ≫ g = 𝟙 V → τ ≫ ψ = b ≫ σ' → ∀ c : C, ψ c = σ' (b (g c)) → c = τ (g c) := by
    intro X P V C f b ψ g σ' τ H1 H2 H3 H4 c h
    have hgτ : ∀ x : V, g (τ x) = x := by
      intro x
      rw [← Scheme.Hom.comp_apply, H3]
      rfl
    have hout : IsPullback (τ ≫ g) b b (σ' ≫ f) := by
      rw [H3, H2]
      exact IsPullback.id_horiz b
    have hsq : IsPullback τ b ψ σ' := IsPullback.of_right hout H4 H1.flip
    obtain ⟨p, hp, _⟩ := Scheme.exists_preimage_of_isPullback hsq c (b (g c)) h
    have hg : g c = p := by rw [← hp, hgτ]
    rw [hg, hp]

  have hT : ∀ (Z : Type u) [TopologicalSpace Z] [T0Space Z], IsIrreducible (Set.univ : Set Z) →
      topologicalKrullDim Z ≤ 1 → ∀ x y : Z, x ⤳ y → x = y ∨ ∀ z, x ⤳ z := by
    intro Z _ _ hirr hdim x y hxy
    by_contra hcon
    push_neg at hcon
    obtain ⟨hne, z, hz⟩ := hcon
    let A0 : TopologicalSpace.IrreducibleCloseds Z :=
      ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
    let A1 : TopologicalSpace.IrreducibleCloseds Z :=
      ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
    let A2 : TopologicalSpace.IrreducibleCloseds Z := ⟨Set.univ, hirr, isClosed_univ⟩
    have h01 : A0 < A1 := by
      refine lt_of_le_of_ne ?_ ?_
      · show closure {y} ⊆ closure {x}
        exact specializes_iff_closure_subset.mp hxy
      · intro h
        have h' : closure ({y} : Set Z) = closure {x} :=
          congrArg (fun A : TopologicalSpace.IrreducibleCloseds Z => (A : Set Z)) h
        have hyx : y ⤳ x := specializes_iff_closure_subset.mpr h'.ge
        exact hne (hxy.antisymm hyx).eq
    have h12 : A1 < A2 := by
      refine lt_of_le_of_ne ?_ ?_
      · show closure {x} ⊆ Set.univ
        exact Set.subset_univ _
      · intro h
        have h' : closure ({x} : Set Z) = Set.univ :=
          congrArg (fun A : TopologicalSpace.IrreducibleCloseds Z => (A : Set Z)) h
        apply hz
        rw [specializes_iff_mem_closure, h']
        exact Set.mem_univ z
    let p : LTSeries (TopologicalSpace.IrreducibleCloseds Z) :=
      LTSeries.mk 2 ![A0, A1, A2] (Fin.strictMono_iff_lt_succ.mpr (by
        intro i
        fin_cases i
        exacts [h01, h12]))
    have hlen : ((2 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim Z := Order.LTSeries.length_le_krullDim p
    have h3 : ((2 : ℕ) : WithBot ℕ∞) ≤ 1 := hlen.trans hdim
    exact absurd h3 (by decide)

  have hw : Limits.pullback.fst v (Spec.map (CommRingCat.ofHom ι) ≫ s) ≫ v =
      (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom ι) ≫ s) ≫
        Spec.map (CommRingCat.ofHom ι)) ≫ s := by
    rw [Limits.pullback.condition, Category.assoc]
  obtain ⟨π, hπ1, hπ2⟩ : ∃ π : Limits.pullback v (Spec.map (CommRingCat.ofHom ι) ≫ s) ⟶
      Limits.pullback v s,
      π ≫ Limits.pullback.fst v s = Limits.pullback.fst v (Spec.map (CommRingCat.ofHom ι) ≫ s) ∧
      π ≫ Limits.pullback.snd v s =
        Limits.pullback.snd v (Spec.map (CommRingCat.ofHom ι) ≫ s) ≫
          Spec.map (CommRingCat.ofHom ι) :=
    ⟨Limits.pullback.lift _ _ hw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hP : IsPullback π (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom ι) ≫ s))
