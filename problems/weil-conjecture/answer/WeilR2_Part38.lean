    rw [IsIso.inv_comp_eq, Limits.pullback.condition, Category.comp_id]
  rcases wcpa_dj_ssp_bw_ns_transport K (asIso (Limits.pullback.fst q (𝟙 (Spec (.of K))))).symm
      q (Limits.pullback.snd q (𝟙 (Spec (.of K)))) hΦ x (hss.2.2 K (𝟙 _) _)
