              Spec.map (Scheme.ΓSpecIso (.of Ω)).inv := by
            rw [toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
        _ = X.fromSpecStalk p ≫ X.toSpecΓ ≫ Spec.map str.appTop ≫
              Spec.map (Scheme.ΓSpecIso (.of Ω)).inv := by
            rw [Scheme.toSpecΓ_naturality_assoc]
        _ = Spec.map (X.presheaf.germ ⊤ p trivial) ≫ Spec.map str.appTop ≫
              Spec.map (Scheme.ΓSpecIso (.of Ω)).inv := by
            rw [Scheme.fromSpecStalk_toSpecΓ_assoc]
