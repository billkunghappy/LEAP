            (PowerSeries.coeff 1 (θ₁ y) / PowerSeries.coeff 1 (θ₁ g₁)) * g₁ := ⟨_, rfl⟩
      have hwM : w ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x) := by
        rw [hw]
