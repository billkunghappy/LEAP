        rw [h, map_zero] at hr1
        exact zero_ne_one hr1
      have hprime : (RingHom.ker θ).IsPrime := RingHom.ker_isPrime θ
      have hmin : RingHom.ker θ ∈ minimalPrimes (C.presheaf.stalk x) := by
        rcases Ring.krullDimLE_one_iff.mp inferInstance _ hprime with h | h
        · exact h
        · exfalso
          have h' := IsLocalRing.eq_maximalIdeal h
          apply hθr
          rw [← RingHom.mem_ker, h']
