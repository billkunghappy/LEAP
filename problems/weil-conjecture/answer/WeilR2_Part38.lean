  refine le_antisymm (sup_le (Y.basicOpen_le t) (Y.basicOpen_le s)) ?_
  intro y hy
  by_cases hyD : y ∈ Set.range sY
  · obtain ⟨q, rfl⟩ := hyD
    exact TopologicalSpace.Opens.mem_sup.mpr (Or.inr (hN q hy))
  · have hyUV : y ∈ U ⊓ V := ⟨hy, hyD⟩
    obtain ⟨O, hOaff, hyO, hOle⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens Y)) hyUV
    have hO : O ≤ U := hOle.trans inf_le_left
    have hOV : O ≤ V := hOle.trans inf_le_right
    have hbot : sY ⁻¹ᵁ O = ⊥ := by
      rw [eq_bot_iff]
      intro x hx
      have hx' : sY x ∈ V := hOV hx
      exact absurd ⟨x, rfl⟩ hx'
    haveI : Subsingleton Γ(Spec (.of A), sY ⁻¹ᵁ O) :=
      CommRingCat.subsingleton_of_isTerminal
        (TopCat.Sheaf.isTerminalOfEqEmpty (Spec (.of A)).sheaf hbot)
    have h1 : (sY.app O).hom 1 = 0 := Subsingleton.elim _ _
    have hmem := (hG O hOaff hO 1).mp h1
    rw [Ideal.mem_span_singleton] at hmem
    have hunit := isUnit_of_dvd_one hmem
    have hyb : y ∈ Y.basicOpen ((Y.presheaf.map (homOfLE hO).op).hom t) := by
      rw [Scheme.basicOpen_of_isUnit Y hunit]; exact hyO
    rw [Scheme.basicOpen_res] at hyb
    exact TopologicalSpace.Opens.mem_sup.mpr (Or.inl hyb.2)

theorem wcpa_dj_p1rm_local_map : ∀ (A : Type u) [CommRing A] (Y : Scheme.{u}) (v : Y ⟶ Spec (.of A)) (Z : Scheme.{u}) (ψ : Spec (.of (Polynomial A)) ⟶ Z) (V : Y.Opens) (p d : Γ(Y, V)), ∃ g : (Y.basicOpen d).toScheme ⟶ Z, (∀ x, g x ∈ Set.range ψ) ∧ ∀ (T : Scheme.{u}) (k : T ⟶ (Y.basicOpen d).toScheme) (hV : ⊤ ≤ (k ≫ (Y.basicOpen d).ι) ⁻¹ᵁ V) (e : Γ(T, ⊤)), e * ((k ≫ (Y.basicOpen d).ι).appLE V ⊤ hV).hom d = ((k ≫ (Y.basicOpen d).ι).appLE V ⊤ hV).hom p → k ≫ g = T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom ((Scheme.ΓSpecIso (.of A)).inv ≫ (k ≫ (Y.basicOpen d).ι ≫ v).appTop).hom e)) ≫ ψ :=
