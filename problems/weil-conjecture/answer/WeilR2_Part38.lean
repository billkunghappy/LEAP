    obtain ⟨β₀, hβ₀, hE₀⟩ := arc θ₀ r₀ hθ₀C (fun y hy => (hθm y hy).1) hr₀m hc₀₀
    obtain ⟨β₁, hβ₁, hE₁⟩ := arc θ₁ r₁ hθ₁C (fun y hy => (hθm y hy).2) hr₁m hc₁₁
