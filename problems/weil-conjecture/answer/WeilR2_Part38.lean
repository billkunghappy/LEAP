  haveI : LocallyOfFinitePresentation (Limits.pullback.snd v s) :=
    MorphismProperty.of_isPullback (P := @LocallyOfFinitePresentation)
      (IsPullback.of_hasPullback v s) hfp
  haveI : IsProper (Limits.pullback.snd v s) :=
    MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback v s) hpr
  haveI : IsLocallyNoetherian (Limits.pullback v s) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd v s)
  haveI : CompactSpace ↥(Limits.pullback v s) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd v s)
  haveI : AlgebraicGeometry.IsNoetherian (Limits.pullback v s) :=
    (AlgebraicGeometry.isNoetherian_iff _).mpr ⟨inferInstance, inferInstance⟩
  haveI : TopologicalSpace.NoetherianSpace ↥(Limits.pullback v s) := inferInstance
  have hfin : (irreducibleComponents ↥(Limits.pullback v s)).Finite :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents

  unfold wcpaDjSolStab at hstab ⊢
  intro E hE hdat
  obtain ⟨Er, ιE, θ, hci, _hred, hrange, hθ⟩ := hdat
  haveI := hci
  have hEcl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
  have hEirr : IsIrreducible E := hE.1

  have hsq1 := (IsPullback.of_hasPullback ιE π).paste_vert hP
  rw [← hθ] at hsq1
  have hP1 := hsq1.paste_horiz (IsPullback.of_horiz_isIso (fst := θ.hom)
    (snd := θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))))
    (f := @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))))
    (g := 𝟙 (Spec (.of K))) ⟨by rw [Category.comp_id]⟩)
  rw [Category.comp_id] at hP1
  letI : Algebra K L := ι.toAlgebra
  obtain ⟨e, he, hee⟩ := wcpa_proj_base_change K L 1
  haveI := he
  have hP1' : IsPullback (Limits.pullback.fst ιE π ≫ θ.hom)
      (Limits.pullback.snd ιE π ≫ Limits.pullback.snd v (Spec.map (CommRingCat.ofHom ι) ≫ s))
      (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0))))
      (Spec.map (CommRingCat.ofHom (algebraMap K L))) := hP1
  let θ' := hP1'.isoPullback ≪≫ asIso e
  have hθ'eq : θ'.hom ≫ (@Proj.toSpecZero _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) L) MvPolynomial.gradedAlgebra ≫
        Spec.map (CommRingCat.ofHom
          (algebraMap L ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) L 0)))) =
      Limits.pullback.snd ιE π ≫ Limits.pullback.snd v (Spec.map (CommRingCat.ofHom ι) ≫ s) := by
    show (hP1'.isoPullback.hom ≫ e) ≫ _ = _
    rw [Category.assoc, hee, IsPullback.isoPullback_hom_snd]
  haveI hIL : AlgebraicGeometry.IsIntegral (wcProjK L 1) := (wc_projK_integral_normal L 1).1
  have hred' : IsReduced (Limits.pullback ιE π) := isReduced_of_isOpenImmersion θ'.hom
  have hrange' : Set.range ⇑(Limits.pullback.snd ιE π) = ⇑π ⁻¹' E := by
    rw [Scheme.Pullback.range_snd, hrange]
  have hirr : IsIrreducible (⇑π ⁻¹' E) := by
    rw [← hrange']
    have h0 : IsIrreducible (Set.univ : Set ↥(wcProjK L 1)) := IrreducibleSpace.isIrreducible_univ _
    have h1 : IsIrreducible (Set.univ : Set ↥(Limits.pullback ιE π)) := by
      have := h0.image (Scheme.homeoOfIso θ'.symm) (Scheme.homeoOfIso θ'.symm).continuous.continuousOn
      rwa [Set.image_univ_of_surjective (Scheme.homeoOfIso θ'.symm).surjective] at this
    have := h1.image (Limits.pullback.snd ιE π) (Limits.pullback.snd ιE π).continuous.continuousOn
    rwa [Set.image_univ] at this

  have hcomp : ⇑π ⁻¹' E ∈
      irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom ι) ≫ s)) := by
    show Maximal IsIrreducible (⇑π ⁻¹' E)
    refine ⟨hirr, fun F hF hle => ?_⟩
    have h1 : IsIrreducible (closure (⇑π '' F)) := (hF.image π π.continuous.continuousOn).closure
    have h2 : E ⊆ closure (⇑π '' F) := by
      intro x hx
      obtain ⟨x', rfl⟩ := π.surjective x
      exact subset_closure ⟨x', hle hx, rfl⟩
    have h3 := hE.2 h1 h2
    intro x hx
    exact h3 (subset_closure ⟨x, hx, rfl⟩)
  have hgen : ∀ C ∈ irreducibleComponents ↥(Limits.pullback v s), C ≠ E →
      ∀ ξ, IsGenericPoint ξ C → ξ ∉ E := by
    intro C hC hCE ξ hξ hξE
    have hCsub : C ⊆ E := by
      rw [← hξ.def]
      exact closure_minimal (Set.singleton_subset_iff.mpr hξE) hEcl
    exact hCE (Set.Subset.antisymm hCsub (hC.2 hEirr hCsub))
  have hthird : ∀ x ∈ closure Eᶜ, ∃ C ∈ irreducibleComponents ↥(Limits.pullback v s),
      C ≠ E ∧ x ∈ C := by
    have hOcl : IsClosed (⋃ C ∈ {C | C ∈ irreducibleComponents ↥(Limits.pullback v s) ∧ C ≠ E}, C) :=
      (hfin.subset (fun C h => h.1)).isClosed_biUnion
        (fun C h => isClosed_of_mem_irreducibleComponents C h.1)
    have hsub : Eᶜ ⊆ ⋃ C ∈ {C | C ∈ irreducibleComponents ↥(Limits.pullback v s) ∧ C ≠ E}, C := by
      intro y hy
      obtain ⟨C, hC, hyC⟩ :=
        exists_mem_irreducibleComponents_subset_of_isIrreducible {y} isIrreducible_singleton
      refine Set.mem_iUnion₂.mpr ⟨C, ⟨hC, ?_⟩, hyC rfl⟩
      intro hCE
      apply hy
      rw [← hCE]
      exact hyC rfl
    intro x hx
    obtain ⟨C, ⟨hC, hCE⟩, hxC⟩ := Set.mem_iUnion₂.mp (closure_minimal hsub hOcl hx)
    exact ⟨C, hC, hCE, hxC⟩
  have hnode : ⇑π ⁻¹' E ∩ closure (⇑π ⁻¹' E)ᶜ = ⇑π ⁻¹' (E ∩ closure Eᶜ) := by
    ext y
    constructor
    · rintro ⟨hy1, hy2⟩
      refine ⟨hy1, ?_⟩
      rw [← Set.preimage_compl] at hy2
      exact π.continuous.closure_preimage_subset _ hy2
    · rintro ⟨hy1, hy2⟩
      refine ⟨hy1, ?_⟩
      obtain ⟨C, hC, hCE, hyC⟩ := hthird _ hy2
      obtain ⟨ξ, hξ⟩ := QuasiSober.sober hC.1 (isClosed_of_mem_irreducibleComponents C hC)
      obtain ⟨y', hy'y, hy'ξ⟩ := Flat.generalizingMap π (hξ.specializes hyC)
      have hy'E : y' ∈ (⇑π ⁻¹' E)ᶜ := by
        intro h
        apply hgen C hC hCE ξ hξ
        rw [← hy'ξ]
        exact h
      exact closure_mono (Set.singleton_subset_iff.mpr hy'E) (specializes_iff_mem_closure.mp hy'y)

  have hE1 : ∀ a ∈ E, ∀ b ∈ E, a ⤳ b → a = b ∨ ∀ w ∈ E, a ⤳ w := by
    intro a ha b hb hab
    rw [← hrange] at ha hb
    obtain ⟨e₁, rfl⟩ := ha
    obtain ⟨e₂, rfl⟩ := hb
    have hind : Topology.IsInducing ιE := (IsClosedImmersion.isClosedEmbedding ιE).isInducing
    have hee : e₁ ⤳ e₂ := hind.specializes_iff.mp hab
    have hh : (Scheme.homeoOfIso θ) e₁ ⤳ (Scheme.homeoOfIso θ) e₂ :=
      hee.map (Scheme.homeoOfIso θ).continuous
    haveI hirrK : IrreducibleSpace ↥(wcProjK K 1) := by
      haveI : AlgebraicGeometry.IsIntegral (wcProjK K 1) := (wc_projK_integral_normal K 1).1
      infer_instance
    have hirrK' : IsIrreducible (Set.univ : Set ↥(wcProjK K 1)) :=
      IrreducibleSpace.isIrreducible_univ _
    have hdimK : topologicalKrullDim ↥(wcProjK K 1) ≤ 1 := by
      have h := wc_proj_space_dim K 1
      rw [Nat.cast_one] at h
      exact h.le
    rcases hT ↥(wcProjK K 1) hirrK' hdimK ((Scheme.homeoOfIso θ) e₁) ((Scheme.homeoOfIso θ) e₂) hh
      with h1 | h1
    · left
      rw [(Scheme.homeoOfIso θ).injective h1]
    · right
      intro w hw
      rw [← hrange] at hw
      obtain ⟨f, rfl⟩ := hw
      have : e₁ ⤳ f := (Scheme.homeoOfIso θ).isInducing.specializes_iff.mp (h1 _)
      exact this.map ιE.continuous

  have hs4 : ∀ x ∈ E, ∀ C ∈ irreducibleComponents ↥(Limits.pullback v s), C ≠ E → x ∈ C →
      ∀ y, x ⤳ y → y = x := by
    intro x hxE C hC hCE hxC y hxy
    have hyE : y ∈ E := hxy.mem_closed hEcl hxE
    rcases hE1 x hxE y hyE hxy with h | h
    · exact h.symm
    · exfalso
      have hEC : E ⊆ C := fun w hw =>
        (h w hw).mem_closed (isClosed_of_mem_irreducibleComponents C hC) hxC
      exact hCE (Set.Subset.antisymm (hE.2 hC.1 hEC) hEC)

  have hs5 : ∀ x : ↥(Limits.pullback v s), (∀ y, x ⤳ y → y = x) → ∀ c c', π c = x → π c' = x →
      c = c' := by
    intro x hcl c c' hc hc'
    obtain ⟨x₁, hx₁q, hxx₁⟩ := wc_rational_closed_specialization K _ (Limits.pullback.snd v s) x
    have hx1 : x₁ (IsLocalRing.closedPoint K) = x := hcl _ hxx₁
    have hwl : (Spec.map (CommRingCat.ofHom ι) ≫ x₁) ≫ Limits.pullback.snd v s =
        𝟙 _ ≫ Spec.map (CommRingCat.ofHom ι) := by
      rw [Category.assoc, hx₁q, Category.comp_id, Category.id_comp]
    have key : ∀ d, π d = x → d = hP.lift _ _ hwl
        (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom ι) ≫ s) d) := by
      intro d hd
      refine spu _ _ _ _ (Limits.pullback.snd v s) (Spec.map (CommRingCat.ofHom ι)) π
        (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom ι) ≫ s)) x₁ (hP.lift _ _ hwl) hP hx₁q
        (hP.lift_snd _ _ hwl) (hP.lift_fst _ _ hwl) d ?_
      rw [hd, Subsingleton.elim ((Spec.map (CommRingCat.ofHom ι))
        (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom ι) ≫ s) d))
        (IsLocalRing.closedPoint K), hx1]
    rw [key c hc, key c' hc', Subsingleton.elim
      (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom ι) ≫ s) c)
      (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom ι) ≫ s) c')]

  have hinj : Set.InjOn π (⇑π ⁻¹' (E ∩ closure Eᶜ)) := by
    intro c hc c' _ hcc
    obtain ⟨C, hC, hCE, hxC⟩ := hthird (π c) hc.2
    exact hs5 (π c) (hs4 (π c) hc.1 C hC hCE hxC) c c' rfl hcc.symm
  have hcard : (⇑π ⁻¹' (E ∩ closure Eᶜ)).ncard = (E ∩ closure Eᶜ).ncard := by
    rw [← hinj.ncard_image, Set.image_preimage_eq _ π.surjective]
  have hmark : Nat.card {i : Fin n // ∃ x ∈ ⇑π ⁻¹' E, ∃ p : ↥(Spec (.of L)),
      Limits.pullback.fst v (Spec.map (CommRingCat.ofHom ι) ≫ s) x =
        σ i ((Spec.map (CommRingCat.ofHom ι) ≫ s) p)} =
      Nat.card {i : Fin n // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
        Limits.pullback.fst v s x = σ i (s p)} := by
    refine Nat.card_congr (Equiv.subtypeEquivRight fun i => ⟨?_, ?_⟩)
    · rintro ⟨x, hx, p, hp⟩
      refine ⟨π x, hx, Spec.map (CommRingCat.ofHom ι) p, ?_⟩
      rw [pt hπ1 x, hp, Scheme.Hom.comp_apply]
    · rintro ⟨x, hx, p, hp⟩
      obtain ⟨x', rfl⟩ := π.surjective x
      refine ⟨x', hx, IsLocalRing.closedPoint L, ?_⟩
      rw [← pt hπ1 x', hp]
      show σ i (s p) = σ i (s (Spec.map (CommRingCat.ofHom ι) (IsLocalRing.closedPoint L)))
      rw [Subsingleton.elim (Spec.map (CommRingCat.ofHom ι) (IsLocalRing.closedPoint L)) p]
  have hmain := hstab (⇑π ⁻¹' E) hcomp
    ⟨Limits.pullback ιE π, Limits.pullback.snd ιE π, θ', inferInstance, hred', hrange', hθ'eq⟩
  rw [hnode, hcard, hmark] at hmain
  exact hmain

theorem wcpa_dj_sso_place_exists : ∀ (k K : Type u) [Field k] [IsAlgClosed k] [Field K] (ι : k →+* K), ∃ (R : ValuationSubring K) (j : k →+* ↥R), (∀ a, (j a : K) = ι a) ∧ Function.Bijective ((IsLocalRing.residue ↥R).comp j) :=
by
  intro k K _ _ _ ι
  classical

  let S : Set (ValuationSubring K) := {R | ∀ a, ι a ∈ R}
  have hchain : ∀ c ⊆ S, IsChain (fun x1 x2 => x2 ≤ x1) c → ∀ y ∈ c,
      ∃ lb ∈ S, ∀ z ∈ c, lb ≤ z := by
    intro c hcS hc y hy
    let T : Subring K := sInf ((fun R : ValuationSubring K => R.toSubring) '' c)
    have hmemT : ∀ x, x ∈ T ↔ ∀ R ∈ c, x ∈ R := by
      intro x
      simp only [T, Subring.mem_sInf, Set.mem_image]
      constructor
      · intro h R hR
        exact h _ ⟨R, hR, rfl⟩
      · rintro h _ ⟨R, hR, rfl⟩
        exact h R hR
    have hval : ∀ x : K, x ∈ T ∨ x⁻¹ ∈ T := by
      intro x
      by_contra hcon
      push_neg at hcon
      obtain ⟨h1, h2⟩ := hcon
      rw [hmemT] at h1 h2
      push_neg at h1 h2
      obtain ⟨R1, hR1, hx1⟩ := h1
      obtain ⟨R2, hR2, hx2⟩ := h2
      have htot : R2 ≤ R1 ∨ R1 ≤ R2 := by
        by_cases heq : R1 = R2
        · subst heq
          exact Or.inl le_rfl
        · exact hc hR1 hR2 heq
      rcases htot with h | h
      · rcases R2.mem_or_inv_mem x with hx | hx
        · exact hx1 (h hx)
        · exact hx2 hx
      · rcases R1.mem_or_inv_mem x with hx | hx
        · exact hx1 hx
        · exact hx2 (h hx)
    refine ⟨⟨T, hval⟩, ?_, ?_⟩
    · intro a
      show ι a ∈ T
      rw [hmemT]
      intro R hR
      exact hcS hR a
    · intro z hz x hx
      have hx' : x ∈ T := hx
      exact (hmemT x).1 hx' z hz
  have htop : (⊤ : ValuationSubring K) ∈ S := fun a => trivial
  obtain ⟨R, -, hRmin⟩ := zorn_ge_nonempty₀ S hchain ⊤ htop
  have hRS : ∀ a, ι a ∈ R := hRmin.prop
  have hmin : ∀ R' : ValuationSubring K, (∀ a, ι a ∈ R') → R' ≤ R → R ≤ R' :=
    fun R' h1 h2 => hRmin.2 h1 h2

  let j : k →+* R := ι.codRestrict R hRS
  let res := IsLocalRing.residue R
  let f : k →+* IsLocalRing.ResidueField R := res.comp j
  refine ⟨R, j, fun a => rfl, f.injective, ?_⟩
  intro ρ
  by_contra hρ
  push_neg at hρ

  let A : LocalSubring (IsLocalRing.ResidueField R) := LocalSubring.range f
  have hmemA : ∀ z, z ∈ A.toSubring ↔ ∃ a, f a = z := by
    intro z
    show z ∈ (LocalSubring.range f).toSubring ↔ _
    rw [LocalSubring.range_toSubring]
    exact Iff.rfl
  haveI hIC : IsIntegrallyClosedIn A.toSubring (IsLocalRing.ResidueField R) := by
    rw [isIntegrallyClosedIn_iff]
    refine ⟨Subtype.val_injective, ?_⟩
    intro z hz
    obtain ⟨p, hpm, hp⟩ := hz
    set P : Polynomial (IsLocalRing.ResidueField R) :=
      p.map (algebraMap A.toSubring (IsLocalRing.ResidueField R)) with hP
    have hPm : P.Monic := hpm.map _
    have hPl : P ∈ Polynomial.lifts f := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      rw [hP, Polynomial.coeff_map]
      exact (hmemA _).1 (p.coeff n).2
    obtain ⟨q, hqP, -, hqm⟩ := Polynomial.lifts_and_degree_eq_and_monic hPl hPm
    letI : Algebra k (IsLocalRing.ResidueField R) := f.toAlgebra
    have hint : _root_.IsIntegral k z := by
      refine ⟨q, hqm, ?_⟩
      have e1 : Polynomial.eval₂ f z q = Polynomial.eval z P := by
        rw [← hqP, Polynomial.eval_map]
      have e2 : Polynomial.eval z P =
          Polynomial.eval₂ (algebraMap A.toSubring (IsLocalRing.ResidueField R)) z p := by
        rw [hP, Polynomial.eval_map]
      rw [RingHom.algebraMap_toAlgebra, e1, e2, hp]
    have hdeg := IsAlgClosed.degree_eq_one_of_irreducible k (minpoly.irreducible hint)
    obtain ⟨a, ha⟩ := RingHom.mem_range.mp (minpoly.mem_range_of_degree_eq_one k z hdeg)
    exact ⟨⟨z, (hmemA z).2 ⟨a, ha⟩⟩, rfl⟩
  have hρA : ρ ∉ A.toSubring := by
    intro h
    obtain ⟨a, ha⟩ := (hmemA ρ).1 h
    exact hρ a ha
  obtain ⟨W, hAW, hρW⟩ :=
    LocalSubring.exists_le_valuationSubring_of_isIntegrallyClosedIn (R := A) hρA
  have hfW : ∀ a, f a ∈ W := by
    intro a
    exact (LocalSubring.le_def.mp hAW).1 ((hmemA _).2 ⟨a, rfl⟩)

  have L0 : ∀ y : R, (y : K)⁻¹ ∉ R → res y = 0 := by
    intro y hy
    rw [IsLocalRing.residue_eq_zero_iff]
    by_contra hm
    have hu : IsUnit y := IsLocalRing.notMem_maximalIdeal.mp hm
    apply hy
    obtain ⟨v, hv⟩ := hu.exists_right_inv
    have hyv : (y : K) * (v : K) = 1 := by
      simpa using congrArg (fun t : R => (t : K)) hv
    rw [← eq_inv_of_mul_eq_one_right hyv]
    exact v.2
  let T : Subring K := (W.toSubring.comap res).map R.subtype
  have hmemT : ∀ x : K, x ∈ T ↔ ∃ hx : x ∈ R, res ⟨x, hx⟩ ∈ W := by
    intro x
    simp only [T, Subring.mem_map, Subring.mem_comap]
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact ⟨y.2, hy⟩
    · rintro ⟨hx, h⟩
      exact ⟨⟨x, hx⟩, h, rfl⟩
  have hval : ∀ x : K, x ∈ T ∨ x⁻¹ ∈ T := by
    intro x
    by_cases hx0 : x = 0
    · left
      rw [hx0]
      exact T.zero_mem
    by_cases hxR : x ∈ R
    · by_cases hxiR : x⁻¹ ∈ R
      · rcases W.mem_or_inv_mem (res ⟨x, hxR⟩) with h | h
        · left
          exact (hmemT x).2 ⟨hxR, h⟩
        · right
          refine (hmemT _).2 ⟨hxiR, ?_⟩
          have hinv : res ⟨x⁻¹, hxiR⟩ = (res ⟨x, hxR⟩)⁻¹ := by
            symm
            apply inv_eq_of_mul_eq_one_right
            rw [← map_mul]
            have h1 : (⟨x, hxR⟩ : R) * ⟨x⁻¹, hxiR⟩ = 1 := Subtype.ext (mul_inv_cancel₀ hx0)
            rw [h1, map_one]
          rw [hinv]
          exact h
      · left
        refine (hmemT x).2 ⟨hxR, ?_⟩
        rw [L0 ⟨x, hxR⟩ hxiR]
        exact W.zero_mem
    · right
      have hxiR : x⁻¹ ∈ R := (R.mem_or_inv_mem x).resolve_left hxR
      refine (hmemT _).2 ⟨hxiR, ?_⟩
      rw [L0 ⟨x⁻¹, hxiR⟩ (by simpa using hxR)]
      exact W.zero_mem
  let R' : ValuationSubring K := ⟨T, hval⟩
  have hR'S : ∀ a, ι a ∈ R' := fun a => (hmemT _).2 ⟨hRS a, hfW a⟩
  have hR'R : R' ≤ R := fun x hx => ((hmemT x).1 hx).1
  have hRR' := hmin R' hR'S hR'R
  obtain ⟨r, hr⟩ := IsLocalRing.residue_surjective ρ
  obtain ⟨_, h⟩ := (hmemT r).1 (hRR' r.2)
  have h' : res r ∈ W := h
  have h'' : IsLocalRing.residue R r ∈ W := h'
  rw [hr] at h''
  exact hρW h''

theorem wcpa_dj_sso_field_invariance : ∀ (T Z : Scheme.{u}) [IsLocallyNoetherian T] (u : Z ⟶ T) (n : ℕ) (τ : Fin n → (T ⟶ Z)), Flat u → IsProper u → LocallyOfFinitePresentation u → (∀ i, τ i ≫ u = 𝟙 T) → ∀ W₀ : T.Opens, (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T), Set.range ⇑s ⊆ (W₀ : Set T) → wcpaDjSolSS u K s) → (∀ (i j : Fin n) (t : T), t ∈ W₀ → i ≠ j → τ i t ≠ τ j t) → (∀ (j : Fin n) (t : T), t ∈ W₀ → ∃ W : Z.Opens, τ j t ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ u)) → ∀ (K₀ : Type u) [Field K₀] [IsAlgClosed K₀] (s₀ : Spec (.of K₀) ⟶ T) (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T), s₀ (IsLocalRing.closedPoint K₀) ∈ W₀ → s (IsLocalRing.closedPoint K) = s₀ (IsLocalRing.closedPoint K₀) → wcpaDjSolStab u n τ K₀ s₀ → wcpaDjSolStab u n τ K s :=
by
  intro T Z _ u n τ hfl hpr hfp hτ W₀ hSS hdis hsm K₀ _ _ s₀ K _ _ s hW hpt hstab₀
  classical

  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]
  have spu : ∀ (X P V C : Scheme.{u}) (f : X ⟶ P) (b : V ⟶ P)
      (ψ : C ⟶ X) (g : C ⟶ V) (σ : P ⟶ X) (τ : V ⟶ C), IsPullback ψ g f b → σ ≫ f = 𝟙 P →
      τ ≫ g = 𝟙 V → τ ≫ ψ = b ≫ σ → ∀ c : C, ψ c = σ (b (g c)) → c = τ (g c) := by
    intro X P V C f b ψ g σ τ H1 H2 H3 H4 c h
    have hgτ : ∀ x : V, g (τ x) = x := by
      intro x
      rw [← Scheme.Hom.comp_apply, H3]
      rfl
