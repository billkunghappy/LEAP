    have htot : ∀ a b : C.presheaf.stalk x, a ∣ b ∨ b ∣ a := by
      intro a b
      let ε := (W.stalkIso ⟨x, hxW⟩).commRingCatIsoToRingEquiv
      rcases ValuationRing.dvd_total (ε.symm a) (ε.symm b) with ⟨c, hc⟩ | ⟨c, hc⟩
