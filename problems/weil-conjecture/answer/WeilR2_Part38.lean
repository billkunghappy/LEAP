    have hgen : ∀ δ : G, j (genericPoint P) ⤳ δ := fun δ =>
      specializes_iff_mem_closure.mpr (hcl ▸ Set.mem_univ δ)
    haveI : IrreducibleSpace G := by
      rw [irreducibleSpace_def, Set.top_eq_univ, ← hcl]
      exact isIrreducible_singleton.closure
    haveI : AlgebraicGeometry.IsIntegral G := isIntegral_of_irreducibleSpace_of_isReduced G
    refine ⟨hgen, fun δ h => ?_⟩
    rw [injective_iff_map_eq_zero]
    intro s hs
    obtain ⟨U, hδU, t, rfl⟩ := TopCat.Presheaf.exists_germ_eq G.presheaf s
    have hηU : j (genericPoint P) ∈ U := h.mem_open U.isOpen hδU
    unfold wcLr1uGerm at hs
    rw [CommRingCat.comp_apply, TopCat.Presheaf.germ_stalkSpecializes_apply] at hs
    have hinj : Function.Injective (j.stalkMap (genericPoint P)).hom :=
      (ConcreteCategory.bijective_of_isIso _).1
    have h0 : G.presheaf.germ U (j (genericPoint P)) hηU t = 0 := hinj (by rw [hs, map_zero])
    have ht : t = 0 := by
      haveI : Nonempty U := ⟨⟨_, hηU⟩⟩
