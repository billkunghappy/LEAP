  rw [h1, h2, CommRingCat.ofHom_comp, CommRingCat.ofHom_comp, Spec.map_comp, Spec.map_comp,
    Category.assoc, Category.assoc, ← hw]

theorem wcpa_dj_p1rm_no_common_zero : ∀ (A : Type u) [CommRing A] (Y : Scheme.{u}) (v : Y ⟶ Spec (.of A)) (sY : Spec (.of A) ⟶ Y), IsSeparated v → sY ≫ v = 𝟙 _ → ∀ (U : Y.Opens) (t s : Γ(Y, U)), (∀ (O : Y.Opens), IsAffineOpen O → ∀ hO : O ≤ U, ∀ x : Γ(Y, O), ((sY.app O).hom x = 0 ↔ x ∈ Ideal.span {(Y.presheaf.map (homOfLE hO).op).hom t})) → (∀ q : Spec (.of A), sY q ∈ U → sY q ∈ Y.basicOpen s) → Y.basicOpen t ⊔ Y.basicOpen s = U :=
