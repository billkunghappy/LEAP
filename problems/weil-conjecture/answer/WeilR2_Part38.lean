      have hκ : IsUnit (κ c) :=
        isUnit_iff_exists_inv.mpr ⟨κ c⁻¹, by rw [← map_mul, mul_inv_cancel₀ hc, map_one]⟩
      have hκq : IsUnit ((X.presheaf.germ U q hq).hom (κ c)) := hκ.map _
      by_contra hn
      have hmem : (X.presheaf.germ U q hq).hom (κ c + w * g) ∈
          IsLocalRing.maximalIdeal (X.presheaf.stalk q) :=
        (IsLocalRing.mem_maximalIdeal _).mpr hn
      have hκm : (X.presheaf.germ U q hq).hom (κ c) ∈
          IsLocalRing.maximalIdeal (X.presheaf.stalk q) := by
        have e : (X.presheaf.germ U q hq).hom (κ c) = (X.presheaf.germ U q hq).hom (κ c + w * g) -
            (X.presheaf.germ U q hq).hom w * (X.presheaf.germ U q hq).hom g := by
          rw [map_add, map_mul]; ring
        rw [e]
        exact Ideal.sub_mem _ hmem (Ideal.mul_mem_right _ _ hwq)
      exact (IsLocalRing.mem_maximalIdeal _).mp hκm hκq
    intro y z hy hz hwy hwz
    have dir : ∀ (p q : X) (hp : p ∈ U) (hq : q ∈ U),
        (X.presheaf.germ U p hp).hom w ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk p) →
        (X.presheaf.germ U q hq).hom w ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk q) →
        ∀ S : Set X, IsOpen S → p ∈ S → q ∈ S := by
      intro p q hp hq hwp hwq S hS hpS
      obtain ⟨f, hfV, hpf⟩ := hU.exists_basicOpen_le (V := (⟨S, hS⟩ : X.Opens) ⊓ U)
        ⟨p, ⟨hpS, hp⟩⟩ hp
      exact (hfV (key p q hp hq hwp hwq f hpf)).1
    have hins : Inseparable y z := by
      rw [inseparable_iff_forall_isOpen]
      intro S hS
      exact ⟨dir y z hy hz hwy hwz S hS, dir z y hz hy hwz hwy S hS⟩
    exact hins.eq

  have pole_excl : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
      (ψ : R →+* (wcProjK Ω 1).functionField), Function.Injective ψ → ∀ (r s v : R),
      s ∈ IsLocalRing.maximalIdeal R → ψ s = t - ψ r →
      v ∈ IsLocalRing.maximalIdeal R → ψ v * t = 1 → False := by
    intro R _ _ ψ hψ r s v hs hsr hv hvt
    have h1 : ψ (v * (s + r)) = ψ 1 := by
      rw [map_mul, map_add, hsr, sub_add_cancel, map_one, hvt]
    exact (IsLocalRing.mem_maximalIdeal _).mp hv (isUnit_iff_exists_inv.mpr ⟨_, hψ h1⟩)

  have psi_inj : ∀ (y : wcProjK Ω 1),
      Function.Injective ((wcProjK Ω 1).presheaf.stalkSpecializes (genericPoint_specializes y)).hom := by
    intro y
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨U, hcU, a, rfl⟩ := (wcProjK Ω 1).presheaf.germ_exist x
    have hU : genericPoint (wcProjK Ω 1) ∈ U :=
      ((genericPoint_spec (wcProjK Ω 1)).mem_open_set_iff U.isOpen).mpr ⟨y, trivial, hcU⟩
    rw [TopCat.Presheaf.germ_stalkSpecializes_apply] at hx
    have ha : a = 0 := by
      apply AlgebraicGeometry.germ_injective_of_isIntegral (wcProjK Ω 1) (genericPoint _) hU
      rw [hx, map_zero]
    rw [ha, map_zero]

  let κ : ∀ J : Fin (1 + 1), Ω →+* Γ(wcProjK Ω 1, wcSgD Ω 1 J) := fun J =>
    ((wcProjK Ω 1).presheaf.map (homOfLE (le_top : wcSgD Ω 1 J ≤ ⊤)).op).hom.comp
      ((wcProjKStr Ω 1).appTop.hom.comp (Scheme.ΓSpecIso (.of Ω)).inv.hom)
  have psi_const : ∀ (J : Fin (1 + 1)) (y : wcProjK Ω 1) (hy : y ∈ wcSgD Ω 1 J) (c : Ω),
      ((wcProjK Ω 1).presheaf.stalkSpecializes (genericPoint_specializes y)).hom
        (((wcProjK Ω 1).presheaf.germ (wcSgD Ω 1 J) y hy).hom (κ J c)) =
        wcLr1uConst (wcProjKStr Ω 1) c := by
    intro J y hy c
    rw [TopCat.Presheaf.germ_stalkSpecializes_apply]
    simp only [κ, RingHom.comp_apply]
    rw [TopCat.Presheaf.germ_res_apply]
    rfl
  have psiE : ∀ (y : wcProjK Ω 1) (hy : y ∈ wcSgD Ω 1 0),
      ((wcProjK Ω 1).presheaf.stalkSpecializes (genericPoint_specializes y)).hom
        (((wcProjK Ω 1).presheaf.germ (wcSgD Ω 1 0) y hy).hom (wcSgE Ω 1 0 1)) = t := by
    intro y hy
    rw [TopCat.Presheaf.germ_stalkSpecializes_apply, ht]
  have hfacts := wcpa_dj_gsfp_chart_facts Ω 1
  have hcover := wc_pp_basicOpen_cover Ω 1

  have chart_split : ∀ (J L : Fin (1 + 1)), J ≠ L → ∀ (a : Ω) (f : Γ(wcProjK Ω 1, wcSgD Ω 1 J)),
      ∃ (c : Ω) (g : Γ(wcProjK Ω 1, wcSgD Ω 1 J)), f = κ J c + (wcSgE Ω 1 J L - κ J a) * g := by
    intro J L hJL a f
    have hgen := wc_ldpi_oai_proj_gen Ω 1 J f
    have hEJJ : wcSgE Ω 1 J J = 1 := (hfacts.2 J J J).1
    induction hgen using Subring.closure_induction with
    | mem x hx =>
      rcases hx with ⟨j, rfl⟩ | ⟨c, rfl⟩
      · by_cases hj : j = J
        · subst hj
          exact ⟨1, 0, by rw [hEJJ, map_one, mul_zero, add_zero]⟩
        · have hjL : j = L := by
            have h3 : ∀ a b c : Fin (1 + 1), a ≠ b → c ≠ b → c = a := by decide
            exact h3 L J j (Ne.symm hJL) hj
          subst hjL
          exact ⟨a, 1, by ring⟩
      · exact ⟨c, 0, by rw [mul_zero, add_zero]; rfl⟩
    | zero => exact ⟨0, 0, by rw [map_zero, mul_zero, add_zero]⟩
    | one => exact ⟨1, 0, by rw [map_one, mul_zero, add_zero]⟩
    | add x y _ _ hx hy =>
      obtain ⟨c, g, rfl⟩ := hx
      obtain ⟨c', g', rfl⟩ := hy
      exact ⟨c + c', g + g', by rw [map_add]; ring⟩
    | neg x _ hx =>
      obtain ⟨c, g, rfl⟩ := hx
      exact ⟨-c, -g, by rw [map_neg]; ring⟩
    | mul x y _ _ hx hy =>
      obtain ⟨c, g, rfl⟩ := hx
      obtain ⟨c', g', rfl⟩ := hy
      exact ⟨c * c', κ J c * g' + κ J c' * g + (wcSgE Ω 1 J L - κ J a) * g * g',
        by rw [map_mul]; ring⟩

  have off_chart : ∀ y : wcProjK Ω 1, y ∉ wcSgD Ω 1 0 → ∃ hy : y ∈ wcSgD Ω 1 1,
      ((wcProjK Ω 1).presheaf.germ (wcSgD Ω 1 1) y hy).hom (wcSgE Ω 1 1 0) ∈
        IsLocalRing.maximalIdeal ((wcProjK Ω 1).presheaf.stalk y) ∧
      ((wcProjK Ω 1).presheaf.stalkSpecializes (genericPoint_specializes y)).hom
        (((wcProjK Ω 1).presheaf.germ (wcSgD Ω 1 1) y hy).hom (wcSgE Ω 1 1 0)) * t = 1 := by
    intro y hy0
    have hy1 : y ∈ wcSgD Ω 1 1 := by
      have hy : y ∈ (⊤ : (wcProjK Ω 1).Opens) := trivial
      rw [← hcover, TopologicalSpace.Opens.mem_iSup] at hy
      obtain ⟨b, hb⟩ := hy
      have h2 : ∀ b : Fin (1 + 1), b = 0 ∨ b = 1 := by decide
      rcases h2 b with rfl | rfl
      · exact absurd hb hy0
      · exact hb
    refine ⟨hy1, ?_, ?_⟩
    · apply (IsLocalRing.mem_maximalIdeal _).mpr
      intro hu
      have hb : y ∈ (wcProjK Ω 1).basicOpen (wcSgE Ω 1 1 0) :=
        ((wcProjK Ω 1).mem_basicOpen _ y hy1).mpr hu
      rw [(hfacts.2 1 0 0).2.1] at hb
      exact hy0 hb.2
    · have hη1 : genericPoint (wcProjK Ω 1) ∈ wcSgD Ω 1 1 :=
        ((genericPoint_spec (wcProjK Ω 1)).mem_open_set_iff (wcSgD Ω 1 1).isOpen).mpr
          ⟨y, trivial, hy1⟩
      have hηW : genericPoint (wcProjK Ω 1) ∈ wcSgD Ω 1 1 ⊓ wcSgD Ω 1 0 := ⟨hη1, hη⟩
      rw [TopCat.Presheaf.germ_stalkSpecializes_apply, ht]
      rw [← TopCat.Presheaf.germ_res_apply (wcProjK Ω 1).presheaf
        (homOfLE (inf_le_left : wcSgD Ω 1 1 ⊓ wcSgD Ω 1 0 ≤ wcSgD Ω 1 1)) _ hηW]
      rw [← TopCat.Presheaf.germ_res_apply (wcProjK Ω 1).presheaf
        (homOfLE (inf_le_right : wcSgD Ω 1 1 ⊓ wcSgD Ω 1 0 ≤ wcSgD Ω 1 0)) _ hηW]
      rw [← map_mul, ← (hfacts.2 1 0 1).2.2, (hfacts.2 1 1 1).1, map_one, map_one]

  have fin_germ : ∀ (y : wcProjK Ω 1) (hy : y ∈ wcSgD Ω 1 0) (a : Ω),
      wcLr1uVanish y (t - wcLr1uConst (wcProjKStr Ω 1) a) →
      ((wcProjK Ω 1).presheaf.germ (wcSgD Ω 1 0) y hy).hom (wcSgE Ω 1 0 1 - κ 0 a) ∈
        IsLocalRing.maximalIdeal ((wcProjK Ω 1).presheaf.stalk y) := by
    intro y hy a hv
    obtain ⟨s, hs, hsv⟩ := hv
    have e : ((wcProjK Ω 1).presheaf.germ (wcSgD Ω 1 0) y hy).hom (wcSgE Ω 1 0 1 - κ 0 a) = s := by
      apply psi_inj y
      rw [hsv, map_sub, map_sub, psiE y hy, psi_const 0 y hy a]
    rw [e]
    exact hs
  refine ⟨?_, ?_⟩
  · intro y z a hyv hzv
    have inD0 : ∀ x : wcProjK Ω 1, wcLr1uVanish x (t - wcLr1uConst (wcProjKStr Ω 1) a) →
        x ∈ wcSgD Ω 1 0 := by
      intro x hx
      by_contra hx0
      obtain ⟨hx1, hum, hut⟩ := off_chart x hx0
      obtain ⟨s, hs, hsv⟩ := hx
      exact pole_excl _ _ (psi_inj x)
        (((wcProjK Ω 1).presheaf.germ (wcSgD Ω 1 1) x hx1).hom (κ 1 a)) s _ hs
        (by rw [hsv, psi_const 1 x hx1 a]) hum hut
    have hy0 := inD0 y hyv
    have hz0 := inD0 z hzv
    exact unique_point _ _ (hfacts.1 0) (κ 0) (wcSgE Ω 1 0 1 - κ 0 a)
      (chart_split 0 1 (by decide) a) y z hy0 hz0 (fin_germ y hy0 a hyv) (fin_germ z hz0 a hzv)
  · intro y z hy hz
    have notD0 : ∀ x : wcProjK Ω 1, (∃ s ∈ IsLocalRing.maximalIdeal ((wcProjK Ω 1).presheaf.stalk x),
        ((wcProjK Ω 1).presheaf.stalkSpecializes (genericPoint_specializes x)).hom s * t = 1) →
        x ∉ wcSgD Ω 1 0 := by
      rintro x ⟨v, hv, hvt⟩ hx0
      exact pole_excl _ _ (psi_inj x)
        (((wcProjK Ω 1).presheaf.germ (wcSgD Ω 1 0) x hx0).hom (wcSgE Ω 1 0 1)) 0 v
        (Ideal.zero_mem _) (by rw [map_zero, psiE x hx0, sub_self]) hv hvt
    obtain ⟨hy1, hym, -⟩ := off_chart y (notD0 y hy)
    obtain ⟨hz1, hzm, -⟩ := off_chart z (notD0 z hz)
    have hsplit : ∀ f : Γ(wcProjK Ω 1, wcSgD Ω 1 1), ∃ (c : Ω) (g : Γ(wcProjK Ω 1, wcSgD Ω 1 1)),
        f = κ 1 c + wcSgE Ω 1 1 0 * g := by
      intro f
      obtain ⟨c, g, h⟩ := chart_split 1 0 (by decide) 0 f
      exact ⟨c, g, by rw [h, map_zero, sub_zero]⟩
    exact unique_point _ _ (hfacts.1 1) (κ 1) (wcSgE Ω 1 1 0) hsplit y z hy1 hz1 hym hzm

theorem wcpa_dj_lr1u_tv_mob_construct : ∀ (Ω K : Type u) [Field Ω] [Field K] (φ : Ω →+* K) (t : K) (R1 R2 R3 : Type u) [CommRing R1] [IsLocalRing R1] [CommRing R2] [IsLocalRing R2] [CommRing R3] [IsLocalRing R3] (ψ1 : R1 →+* K) (ψ2 : R2 →+* K) (ψ3 : R3 →+* K) (κ1 : Ω →+* R1) (κ2 : Ω →+* R2) (κ3 : Ω →+* R3), Function.Injective ψ1 → Function.Injective ψ2 → Function.Injective ψ3 → ψ1.comp κ1 = φ → ψ2.comp κ2 = φ → ψ3.comp κ3 = φ → ((∃ a : Ω, ∃ s ∈ IsLocalRing.maximalIdeal R1, ψ1 s = t - φ a) ∨ (∃ s ∈ IsLocalRing.maximalIdeal R1, ψ1 s * t = 1)) → ((∃ a : Ω, ∃ s ∈ IsLocalRing.maximalIdeal R2, ψ2 s = t - φ a) ∨ (∃ s ∈ IsLocalRing.maximalIdeal R2, ψ2 s * t = 1)) → ((∃ a : Ω, ∃ s ∈ IsLocalRing.maximalIdeal R3, ψ3 s = t - φ a) ∨ (∃ s ∈ IsLocalRing.maximalIdeal R3, ψ3 s * t = 1)) → (∀ a : Ω, (∃ s ∈ IsLocalRing.maximalIdeal R1, ψ1 s = t - φ a) → (∃ s ∈ IsLocalRing.maximalIdeal R2, ψ2 s = t - φ a) → False) → (∀ a : Ω, (∃ s ∈ IsLocalRing.maximalIdeal R1, ψ1 s = t - φ a) → (∃ s ∈ IsLocalRing.maximalIdeal R3, ψ3 s = t - φ a) → False) → (∀ a : Ω, (∃ s ∈ IsLocalRing.maximalIdeal R2, ψ2 s = t - φ a) → (∃ s ∈ IsLocalRing.maximalIdeal R3, ψ3 s = t - φ a) → False) → ((∃ s ∈ IsLocalRing.maximalIdeal R1, ψ1 s * t = 1) → (∃ s ∈ IsLocalRing.maximalIdeal R2, ψ2 s * t = 1) → False) → ((∃ s ∈ IsLocalRing.maximalIdeal R1, ψ1 s * t = 1) → (∃ s ∈ IsLocalRing.maximalIdeal R3, ψ3 s * t = 1) → False) → ((∃ s ∈ IsLocalRing.maximalIdeal R2, ψ2 s * t = 1) → (∃ s ∈ IsLocalRing.maximalIdeal R3, ψ3 s * t = 1) → False) → ∃ (g : K) (α β γ δ : Ω), (∃ s ∈ IsLocalRing.maximalIdeal R1, ψ1 s = g) ∧ (∃ s ∈ IsLocalRing.maximalIdeal R2, ψ2 s = g - 1) ∧ (∃ s ∈ IsLocalRing.maximalIdeal R3, ψ3 s * g = 1) ∧ α * δ - β * γ ≠ 0 ∧ t * (φ γ * g + φ δ) = φ α * g + φ β :=
by
  intro Ω K _ _ φ t R1 R2 R3 _ _ _ _ _ _ ψ1 ψ2 ψ3 κ1 κ2 κ3 _ _ _ hκ1 hκ2 hκ3 H1 H2 H3
    D12 D13 D23 I12 I13 I23
  have keyM : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (ψ : R →+* K) (κ : Ω →+* R),
      ψ.comp κ = φ → ∀ x : K, (∃ s ∈ IsLocalRing.maximalIdeal R, ψ s = x) → ∀ c : Ω,
      ∃ s ∈ IsLocalRing.maximalIdeal R, ψ s = x * φ c := by
    intro R _ _ ψ κ hκ x hx c
    obtain ⟨s, hs, hsx⟩ := hx
    refine ⟨s * κ c, Ideal.mul_mem_right _ _ hs, ?_⟩
    rw [map_mul, hsx, ← hκ, RingHom.comp_apply]
  have keyU : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (ψ : R →+* K) (κ : Ω →+* R),
      ψ.comp κ = φ → ∀ x : K, (∃ s ∈ IsLocalRing.maximalIdeal R, ψ s = x) → ∀ c : Ω, c ≠ 0 →
      x + φ c ≠ 0 ∧ ∀ y : K, (∃ s ∈ IsLocalRing.maximalIdeal R, ψ s = y) →
        ∃ s ∈ IsLocalRing.maximalIdeal R, ψ s = y * (x + φ c)⁻¹ := by
    intro R _ _ ψ κ hκ x hx c hc
    obtain ⟨s, hs, hsx⟩ := hx
    have hφc : ψ (κ c) = φ c := by rw [← hκ, RingHom.comp_apply]
    have hκu : IsUnit (κ c) := (isUnit_iff_ne_zero.mpr hc).map κ
    have hu : IsUnit (s + κ c) := by
      by_contra h
      have h1 : s + κ c ∈ IsLocalRing.maximalIdeal R :=
        (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr h)
      have h2 : κ c ∈ IsLocalRing.maximalIdeal R := by
        have h3 := Ideal.sub_mem _ h1 hs
        rwa [add_sub_cancel_left] at h3
      exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h2) hκu
    have hψu : ψ (s + κ c) = x + φ c := by rw [map_add, hsx, hφc]
    refine ⟨?_, ?_⟩
    · rw [← hψu]; exact (hu.map ψ).ne_zero
    · intro y hy
      obtain ⟨s', hs', hsy⟩ := hy
      refine ⟨s' * ↑(hu.unit⁻¹), Ideal.mul_mem_right _ _ hs', ?_⟩
      rw [map_mul, hsy, ← hψu]
      congr 1
      apply eq_inv_of_mul_eq_one_right
      rw [← map_mul, IsUnit.mul_val_inv, map_one]
  have hφne : ∀ a b : Ω, a ≠ b → φ a - φ b ≠ 0 := by
    intro a b hab
    rw [← map_sub]
    exact (map_ne_zero φ).mpr (sub_ne_zero.mpr hab)
  rcases H1 with ⟨a1, h1⟩ | p1 <;> rcases H2 with ⟨a2, h2⟩ | p2 <;>
    rcases H3 with ⟨a3, h3⟩ | p3
  ·
    have h12 : a1 ≠ a2 := by rintro rfl; exact D12 a1 h1 h2
    have h13 : a1 ≠ a3 := by rintro rfl; exact D13 a1 h1 h3
    have h23 : a2 ≠ a3 := by rintro rfl; exact D23 a2 h2 h3
    have hA21 := hφne a2 a1 h12.symm
    have hA23 := hφne a2 a3 h23
    obtain ⟨hD3, hU1⟩ := keyU R1 ψ1 κ1 hκ1 _ h1 (a1 - a3) (sub_ne_zero.mpr h13)
    obtain ⟨_, hU2⟩ := keyU R2 ψ2 κ2 hκ2 _ h2 (a2 - a3) (sub_ne_zero.mpr h23)
    obtain ⟨hD1, hU3⟩ := keyU R3 ψ3 κ3 hκ3 _ h3 (a3 - a1) (sub_ne_zero.mpr h13.symm)
    have e1 : t - φ a1 + φ (a1 - a3) = t - φ a3 := by rw [map_sub]; ring
    have e2 : t - φ a2 + φ (a2 - a3) = t - φ a3 := by rw [map_sub]; ring
    have e3 : t - φ a3 + φ (a3 - a1) = t - φ a1 := by rw [map_sub]; ring
    rw [e1] at hD3 hU1
    rw [e2] at hU2
    rw [e3] at hD1 hU3
    have hg : (φ a2 - φ a3) * (t - φ a1) / ((φ a2 - φ a1) * (t - φ a3)) *
        ((φ a2 - φ a1) * (t - φ a3)) = (φ a2 - φ a3) * (t - φ a1) :=
      div_mul_cancel₀ _ (mul_ne_zero hA21 hD3)
    refine ⟨(φ a2 - φ a3) * (t - φ a1) / ((φ a2 - φ a1) * (t - φ a3)),
      a3 * (a2 - a1), -(a1 * (a2 - a3)), a2 - a1, -(a2 - a3), ?_, ?_, ?_, ?_, ?_⟩
    · obtain ⟨s, hs, hse⟩ := hU1 _ (keyM R1 ψ1 κ1 hκ1 _ h1 ((a2 - a3) / (a2 - a1)))
      refine ⟨s, hs, ?_⟩
      rw [hse, map_div₀, map_sub, map_sub]
      field_simp
    · obtain ⟨s, hs, hse⟩ := hU2 _ (keyM R2 ψ2 κ2 hκ2 _ h2 ((a1 - a3) / (a2 - a1)))
      refine ⟨s, hs, ?_⟩
      rw [hse, map_div₀, map_sub, map_sub]
      field_simp
      ring
    · obtain ⟨s, hs, hse⟩ := hU3 _ (keyM R3 ψ3 κ3 hκ3 _ h3 ((a2 - a1) / (a2 - a3)))
      refine ⟨s, hs, ?_⟩
      rw [hse, map_div₀, map_sub, map_sub]
      field_simp
    · have : a3 * (a2 - a1) * -(a2 - a3) - -(a1 * (a2 - a3)) * (a2 - a1) =
          (a2 - a1) * (a2 - a3) * (a1 - a3) := by ring
      rw [this]
      exact mul_ne_zero (mul_ne_zero (sub_ne_zero.mpr h12.symm) (sub_ne_zero.mpr h23))
        (sub_ne_zero.mpr h13)
    · simp only [map_mul, map_sub, map_neg]
      linear_combination hg
  ·
    have h12 : a1 ≠ a2 := by rintro rfl; exact D12 a1 h1 h2
    have hA := hφne a2 a1 h12.symm
    obtain ⟨s3, hs3, hw⟩ := p3
    obtain ⟨hne, hU3⟩ :=
      keyU R3 ψ3 κ3 hκ3 _ (keyM R3 ψ3 κ3 hκ3 _ ⟨s3, hs3, rfl⟩ (-a1)) 1 one_ne_zero
    have ex : ψ3 s3 * φ (-a1) + φ 1 = 1 - φ a1 * ψ3 s3 := by rw [map_neg, map_one]; ring
    rw [ex] at hne hU3
    have hg : (t - φ a1) / (φ a2 - φ a1) * (φ a2 - φ a1) = t - φ a1 := div_mul_cancel₀ _ hA
    refine ⟨(t - φ a1) / (φ a2 - φ a1), a2 - a1, a1, 0, 1, ?_, ?_, ?_, ?_, ?_⟩
    · obtain ⟨s, hs, hse⟩ := keyM R1 ψ1 κ1 hκ1 _ h1 ((a2 - a1)⁻¹)
      refine ⟨s, hs, ?_⟩
      rw [hse, map_inv₀, map_sub, div_eq_mul_inv]
    · obtain ⟨s, hs, hse⟩ := keyM R2 ψ2 κ2 hκ2 _ h2 ((a2 - a1)⁻¹)
      refine ⟨s, hs, ?_⟩
      rw [hse, map_inv₀, map_sub, div_sub_one hA, div_eq_mul_inv]
      ring
    · obtain ⟨s, hs, hse⟩ := hU3 _ (keyM R3 ψ3 κ3 hκ3 _ ⟨s3, hs3, rfl⟩ (a2 - a1))
      refine ⟨s, hs, ?_⟩
      rw [hse, map_sub]
      have hD : ψ3 s3 * (t - φ a1) = 1 - φ a1 * ψ3 s3 := by linear_combination hw
      calc _ = (ψ3 s3 * (t - φ a1)) * (1 - φ a1 * ψ3 s3)⁻¹ *
            ((φ a2 - φ a1) * (φ a2 - φ a1)⁻¹) := by ring
        _ = 1 := by rw [hD, mul_inv_cancel₀ hne, mul_inv_cancel₀ hA, one_mul]
    · have : (a2 - a1) * 1 - a1 * 0 = a2 - a1 := by ring
      rw [this]; exact sub_ne_zero.mpr h12.symm
    · simp only [map_zero, map_one, map_sub]
      linear_combination (-1 : K) * hg
  ·
    have h13 : a1 ≠ a3 := by rintro rfl; exact D13 a1 h1 h3
    obtain ⟨s2, hs2, hw⟩ := p2
    obtain ⟨hD3, hU1⟩ := keyU R1 ψ1 κ1 hκ1 _ h1 (a1 - a3) (sub_ne_zero.mpr h13)
    obtain ⟨hD1, hU3⟩ := keyU R3 ψ3 κ3 hκ3 _ h3 (a3 - a1) (sub_ne_zero.mpr h13.symm)
    obtain ⟨hne, hU2⟩ :=
      keyU R2 ψ2 κ2 hκ2 _ (keyM R2 ψ2 κ2 hκ2 _ ⟨s2, hs2, rfl⟩ (-a3)) 1 one_ne_zero
    have e1 : t - φ a1 + φ (a1 - a3) = t - φ a3 := by rw [map_sub]; ring
    have e3 : t - φ a3 + φ (a3 - a1) = t - φ a1 := by rw [map_sub]; ring
    have ex : ψ2 s2 * φ (-a3) + φ 1 = 1 - φ a3 * ψ2 s2 := by rw [map_neg, map_one]; ring
    rw [e1] at hD3 hU1
    rw [e3] at hD1 hU3
    rw [ex] at hne hU2
    have hg : (t - φ a1) / (t - φ a3) * (t - φ a3) = t - φ a1 := div_mul_cancel₀ _ hD3
    refine ⟨(t - φ a1) / (t - φ a3), a3, -a1, 1, -1, ?_, ?_, ?_, ?_, ?_⟩
    · obtain ⟨s, hs, hse⟩ := hU1 _ h1
      exact ⟨s, hs, by rw [hse, div_eq_mul_inv]⟩
    · obtain ⟨s, hs, hse⟩ := hU2 _ (keyM R2 ψ2 κ2 hκ2 _ ⟨s2, hs2, rfl⟩ (a3 - a1))
      refine ⟨s, hs, ?_⟩
      rw [hse, div_sub_one hD3, ← div_eq_mul_inv, div_eq_div_iff hne hD3, map_sub]
      linear_combination (φ a3 - φ a1) * hw
    · obtain ⟨s, hs, hse⟩ := hU3 _ h3
      refine ⟨s, hs, ?_⟩
      rw [hse]
      field_simp
    · have : a3 * -1 - -a1 * 1 = a1 - a3 := by ring
      rw [this]; exact sub_ne_zero.mpr h13
    · simp only [map_one, map_neg]
      linear_combination hg
  · exact (I23 p2 p3).elim
  ·
    have h23 : a2 ≠ a3 := by rintro rfl; exact D23 a2 h2 h3
    have hA := hφne a2 a3 h23
    obtain ⟨s1, hs1, hw⟩ := p1
    obtain ⟨hD3, hU2⟩ := keyU R2 ψ2 κ2 hκ2 _ h2 (a2 - a3) (sub_ne_zero.mpr h23)
    obtain ⟨hne, hU1⟩ :=
      keyU R1 ψ1 κ1 hκ1 _ (keyM R1 ψ1 κ1 hκ1 _ ⟨s1, hs1, rfl⟩ (-a3)) 1 one_ne_zero
    have e2 : t - φ a2 + φ (a2 - a3) = t - φ a3 := by rw [map_sub]; ring
    have ex : ψ1 s1 * φ (-a3) + φ 1 = 1 - φ a3 * ψ1 s1 := by rw [map_neg, map_one]; ring
    rw [e2] at hD3 hU2
    rw [ex] at hne hU1
    have hg : (φ a2 - φ a3) / (t - φ a3) * (t - φ a3) = φ a2 - φ a3 := div_mul_cancel₀ _ hD3
    refine ⟨(φ a2 - φ a3) / (t - φ a3), a3, a2 - a3, 1, 0, ?_, ?_, ?_, ?_, ?_⟩
    · obtain ⟨s, hs, hse⟩ := hU1 _ (keyM R1 ψ1 κ1 hκ1 _ ⟨s1, hs1, rfl⟩ (a2 - a3))
      refine ⟨s, hs, ?_⟩
      rw [hse, ← div_eq_mul_inv, div_eq_div_iff hne hD3, map_sub]
      linear_combination (φ a2 - φ a3) * hw
    · obtain ⟨s, hs, hse⟩ := hU2 _ (keyM R2 ψ2 κ2 hκ2 _ h2 (-1))
      refine ⟨s, hs, ?_⟩
      rw [hse, map_neg, map_one, div_sub_one hD3, div_eq_mul_inv]
      ring
    · obtain ⟨s, hs, hse⟩ := keyM R3 ψ3 κ3 hκ3 _ h3 ((a2 - a3)⁻¹)
      refine ⟨s, hs, ?_⟩
      rw [hse, map_inv₀, map_sub]
      field_simp
    · have : a3 * 0 - (a2 - a3) * 1 = -(a2 - a3) := by ring
      rw [this]; exact neg_ne_zero.mpr (sub_ne_zero.mpr h23)
    · simp only [map_one, map_zero, map_sub]
      linear_combination hg
  · exact (I13 p1 p3).elim
  · exact (I12 p1 p2).elim
  · exact (I12 p1 p2).elim

theorem wcpa_dj_lr1u_tv_gauss_ring : ∀ (Ω K : Type u) [Field Ω] [Field K] (W : ValuationSubring Ω) (φ : Ω →+* K) (x : K), (∀ q : Polynomial Ω, q ≠ 0 → q.eval₂ φ x ≠ 0) → (∀ f : K, ∃ p q : Polynomial Ω, q.eval₂ φ x ≠ 0 ∧ f * q.eval₂ φ x = p.eval₂ φ x) → ∃ V : ValuationSubring K, (V : Set K) = {f | ∃ p q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) ∧ q.eval₂ (φ.comp W.subtype) x ≠ 0 ∧ f * q.eval₂ (φ.comp W.subtype) x = p.eval₂ (φ.comp W.subtype) x} ∧ ∀ ω : Ω, φ ω ∈ V ↔ ω ∈ W :=
by
  intro Ω K _ _ W φ x hT hG
  classical

  have gauss : ∀ (q₁ q₂ : Polynomial W), (∃ i, IsUnit (q₁.coeff i)) →
      (∃ i, IsUnit (q₂.coeff i)) → ∃ i, IsUnit ((q₁ * q₂).coeff i) := by
    rintro q₁ q₂ ⟨i₁, h₁⟩ ⟨i₂, h₂⟩
    have hr : ∀ a : W, IsUnit a → IsLocalRing.residue W a ≠ 0 := by
      intro a ha h
      rw [IsLocalRing.residue_eq_zero_iff] at h
      exact (IsLocalRing.mem_maximalIdeal _).mp h ha
    have n1 : q₁.map (IsLocalRing.residue W) ≠ 0 := by
      intro h
      apply hr _ h₁
      rw [← Polynomial.coeff_map, h, Polynomial.coeff_zero]
    have n2 : q₂.map (IsLocalRing.residue W) ≠ 0 := by
      intro h
      apply hr _ h₂
      rw [← Polynomial.coeff_map, h, Polynomial.coeff_zero]
    have n12 : (q₁ * q₂).map (IsLocalRing.residue W) ≠ 0 := by
      rw [Polynomial.map_mul]; exact mul_ne_zero n1 n2
    obtain ⟨n, hn⟩ : ∃ n, ((q₁ * q₂).map (IsLocalRing.residue W)).coeff n ≠ 0 := by
      by_contra h
      push_neg at h
      exact n12 (Polynomial.ext fun n => by rw [h n, Polynomial.coeff_zero])
    refine ⟨n, ?_⟩
    rw [Polynomial.coeff_map] at hn
    by_contra hu
    exact hn ((IsLocalRing.residue_eq_zero_iff _).mpr ((IsLocalRing.mem_maximalIdeal _).mpr hu))

  have normalize : ∀ F : Polynomial Ω, F ≠ 0 → ∃ (c : Ω) (F₀ : Polynomial W), c ≠ 0 ∧
      (∃ i, IsUnit (F₀.coeff i)) ∧ F = Polynomial.C c * F₀.map W.subtype := by
    intro F hF
    obtain ⟨j, hj, hmax⟩ := Finset.exists_max_image F.support
      (fun i => W.valuation (F.coeff i)) (Polynomial.support_nonempty.mpr hF)
    have hc : F.coeff j ≠ 0 := Polynomial.mem_support_iff.mp hj
    have hmem : ∀ i, (F.coeff j)⁻¹ * F.coeff i ∈ W := by
      intro i
      by_cases hi : i ∈ F.support
      · rw [← ValuationSubring.valuation_le_one_iff, Valuation.map_mul, Valuation.map_inv]
        have hv : W.valuation (F.coeff j) ≠ 0 := (Valuation.ne_zero_iff _).mpr hc
        calc (W.valuation (F.coeff j))⁻¹ * W.valuation (F.coeff i)
            ≤ (W.valuation (F.coeff j))⁻¹ * W.valuation (F.coeff j) := by
              gcongr; exact hmax i hi
          _ = 1 := inv_mul_cancel₀ hv
      · rw [Polynomial.notMem_support_iff.mp hi, mul_zero]; exact W.zero_mem
    have hlift : Polynomial.C (F.coeff j)⁻¹ * F ∈ Polynomial.lifts W.subtype := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      rw [Polynomial.coeff_C_mul]
      exact ⟨⟨_, hmem n⟩, rfl⟩
    obtain ⟨F₀, hF₀⟩ := (Polynomial.mem_lifts _).mp hlift
    refine ⟨F.coeff j, F₀, hc, ⟨j, ?_⟩, ?_⟩
    · have h0 : W.subtype (F₀.coeff j) = 1 := by
        have := congrArg (fun P => P.coeff j) hF₀
        simp only [Polynomial.coeff_map, Polynomial.coeff_C_mul] at this
        rw [this, inv_mul_cancel₀ hc]
      have h1 : F₀.coeff j = 1 := Subtype.ext (by rw [← ValuationSubring.subtype_apply, h0]; rfl)
      rw [h1]; exact isUnit_one
    · rw [hF₀, ← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ hc, Polynomial.C_1, one_mul]

  let S : Subring K :=
    { carrier := {f | ∃ p q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) ∧
        q.eval₂ (φ.comp W.subtype) x ≠ 0 ∧
        f * q.eval₂ (φ.comp W.subtype) x = p.eval₂ (φ.comp W.subtype) x}
      one_mem' := ⟨1, 1, ⟨0, by simp⟩, by simp, by simp⟩
      zero_mem' := ⟨0, 1, ⟨0, by simp⟩, by simp, by simp⟩
      mul_mem' := by
        rintro a b ⟨p₁, q₁, hq₁, hQ₁, e₁⟩ ⟨p₂, q₂, hq₂, hQ₂, e₂⟩
        refine ⟨p₁ * p₂, q₁ * q₂, gauss q₁ q₂ hq₁ hq₂, ?_, ?_⟩
        · rw [Polynomial.eval₂_mul]; exact mul_ne_zero hQ₁ hQ₂
        · rw [Polynomial.eval₂_mul, Polynomial.eval₂_mul, ← e₁, ← e₂]; ring
      add_mem' := by
        rintro a b ⟨p₁, q₁, hq₁, hQ₁, e₁⟩ ⟨p₂, q₂, hq₂, hQ₂, e₂⟩
        refine ⟨p₁ * q₂ + p₂ * q₁, q₁ * q₂, gauss q₁ q₂ hq₁ hq₂, ?_, ?_⟩
        · rw [Polynomial.eval₂_mul]; exact mul_ne_zero hQ₁ hQ₂
        · rw [Polynomial.eval₂_mul, Polynomial.eval₂_add, Polynomial.eval₂_mul,
            Polynomial.eval₂_mul, ← e₁, ← e₂]; ring
      neg_mem' := by
        rintro a ⟨p, q, hq, hQ, e⟩
        refine ⟨-p, q, hq, hQ, ?_⟩
        rw [Polynomial.eval₂_neg, ← e]; ring }

  have dich : ∀ f : K, f ∈ S ∨ f⁻¹ ∈ S := by
    intro f
    by_cases hf : f = 0
    · left; rw [hf]; exact S.zero_mem
    obtain ⟨p, q, hq, e⟩ := hG f
    have hq0 : q ≠ 0 := by rintro rfl; exact hq (Polynomial.eval₂_zero _ _)
    have hp0 : p ≠ 0 := by
      rintro rfl; rw [Polynomial.eval₂_zero] at e; exact mul_ne_zero hf hq e
    obtain ⟨cp, p₀, hcp, hp₀, rfl⟩ := normalize p hp0
    obtain ⟨cq, q₀, hcq, hq₀, rfl⟩ := normalize q hq0
    simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_map] at hq e
    have hQ₀ : q₀.eval₂ (φ.comp W.subtype) x ≠ 0 := right_ne_zero_of_mul hq
    have hφq : φ cq ≠ 0 := left_ne_zero_of_mul hq
    have hP₀ : p₀.eval₂ (φ.comp W.subtype) x ≠ 0 := by
      intro h; rw [h, mul_zero] at e; exact mul_ne_zero hf hq e
    have e' : f * q₀.eval₂ (φ.comp W.subtype) x =
        φ (cp / cq) * p₀.eval₂ (φ.comp W.subtype) x := by
      rw [map_div₀, div_mul_eq_mul_div, eq_div_iff hφq]
      linear_combination e
    rcases W.mem_or_inv_mem (cp / cq) with h | h
    · left
      refine ⟨Polynomial.C ⟨cp / cq, h⟩ * p₀, q₀, hq₀, hQ₀, ?_⟩
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, e']
      rfl
    · right
      refine ⟨Polynomial.C ⟨(cp / cq)⁻¹, h⟩ * q₀, p₀, hp₀, hP₀, ?_⟩
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_C]
      show f⁻¹ * _ = φ (cp / cq)⁻¹ * _
      have hl : φ (cp / cq) ≠ 0 := by
        rw [map_div₀]; exact div_ne_zero ((map_ne_zero φ).mpr hcp) hφq
      have hf' : f * f⁻¹ = 1 := mul_inv_cancel₀ hf
      have hl' : φ (cp / cq) * (φ (cp / cq))⁻¹ = 1 := mul_inv_cancel₀ hl
      rw [map_inv₀]
      linear_combination (-(f⁻¹ * (φ (cp / cq))⁻¹)) * e'
        - f⁻¹ * p₀.eval₂ (φ.comp W.subtype) x * hl'
        + (φ (cp / cq))⁻¹ * q₀.eval₂ (φ.comp W.subtype) x * hf'

  refine ⟨ValuationSubring.ofSubring S dich, rfl, ?_⟩
  intro ω
  constructor
  · rintro ⟨p, q, ⟨i, hi⟩, hQ, e⟩
    have hD : Polynomial.C ω * q.map W.subtype - p.map W.subtype = 0 := by
      by_contra hne
      apply hT _ hne
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_map,
        Polynomial.eval₂_map, e, sub_self]
    have hc := congrArg (fun P => P.coeff i) hD
    simp only [Polynomial.coeff_sub, Polynomial.coeff_C_mul, Polynomial.coeff_map,
      Polynomial.coeff_zero, sub_eq_zero] at hc
    obtain ⟨u, hu⟩ := hi
    have h1 : ((u : W) : Ω) * ((↑u⁻¹ : W) : Ω) = 1 := congrArg Subtype.val u.mul_inv
    have hω : ω = W.subtype (p.coeff i) * ((↑u⁻¹ : W) : Ω) := by
      rw [← hc, ← hu]
      calc ω = ω * (((u : W) : Ω) * ((↑u⁻¹ : W) : Ω)) := by rw [h1, mul_one]
        _ = ω * W.subtype (u : W) * ((↑u⁻¹ : W) : Ω) := by
          rw [ValuationSubring.subtype_apply]; ring
    rw [hω]
    exact W.mul_mem _ _ (p.coeff i).2 (↑u⁻¹ : W).2
  · intro h
    refine ⟨Polynomial.C ⟨ω, h⟩, 1, ⟨0, by simp⟩, by simp, ?_⟩
    rw [Polynomial.eval₂_one, mul_one, Polynomial.eval₂_C]
    rfl

theorem wcpa_dj_lr1u_tripod_valuation : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), W ≠ ⊤ → ∀ [AlgebraicGeometry.IsIntegral (wcProjK Ω 1)] (b1 b2 b3 : Spec (.of Ω) ⟶ wcProjK Ω 1), b1 ≫ wcProjKStr Ω 1 = 𝟙 _ → b2 ≫ wcProjKStr Ω 1 = 𝟙 _ → b3 ≫ wcProjKStr Ω 1 = 𝟙 _ → b1 (IsLocalRing.closedPoint Ω) ≠ b2 (IsLocalRing.closedPoint Ω) → b1 (IsLocalRing.closedPoint Ω) ≠ b3 (IsLocalRing.closedPoint Ω) → b2 (IsLocalRing.closedPoint Ω) ≠ b3 (IsLocalRing.closedPoint Ω) → (∃ g : (wcProjK Ω 1).functionField, wcLr1uMob (wcProjKStr Ω 1) (b1 (IsLocalRing.closedPoint Ω)) (b2 (IsLocalRing.closedPoint Ω)) (b3 (IsLocalRing.closedPoint Ω)) g) ∧ ∃ V : ValuationSubring (wcProjK Ω 1).functionField, (V : Set (wcProjK Ω 1).functionField) = wcLr1uTripod W (wcProjKStr Ω 1) (b1 (IsLocalRing.closedPoint Ω)) (b2 (IsLocalRing.closedPoint Ω)) (b3 (IsLocalRing.closedPoint Ω)) ∧ ∀ ω : Ω, wcLr1uConst (wcProjKStr Ω 1) ω ∈ V ↔ ω ∈ W :=
by
  intro Ω _ _ W _hWt _ b1 b2 b3 hb1 hb2 hb3 h12 h13 h23

  have transc : ∀ (K : Type u) [Field K] (φ : Ω →+* K) (R : Type u) [CommRing R] [IsLocalRing R]
      (ψ : R →+* K) (κ : Ω →+* R), Function.Injective ψ → ψ.comp κ = φ → ∀ g : K,
      (∃ s ∈ IsLocalRing.maximalIdeal R, ψ s * g = 1) →
      ∀ q : Polynomial Ω, q ≠ 0 → q.eval₂ φ g ≠ 0 := by
    intro K _ φ R _ _ ψ κ hψ hκ g ⟨s, hs, hsg⟩ q hq hqg
    have hsplit := IsAlgClosed.splits q
    have hprod : q = Polynomial.C q.leadingCoeff * (q.roots.map (fun r => Polynomial.X - Polynomial.C r)).prod :=
      (Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C
        ((Polynomial.splits_iff_card_roots).mp hsplit)).symm
    rw [hprod, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_multiset_prod,
      Multiset.map_map] at hqg
    rcases mul_eq_zero.mp hqg with h0 | h0
    · exact hq (Polynomial.leadingCoeff_eq_zero.mp (φ.injective (by rw [h0, map_zero])))
    · obtain ⟨r, -, hy0⟩ := Multiset.mem_map.mp (Multiset.prod_eq_zero_iff.mp h0)
      simp only [Function.comp_apply, Polynomial.eval₂_sub, Polynomial.eval₂_X,
        Polynomial.eval₂_C] at hy0
      have hgr : g = φ r := sub_eq_zero.mp hy0
      have h1 : ψ (s * κ r) = ψ 1 := by
        rw [map_mul, map_one, ← RingHom.comp_apply, hκ, ← hgr, hsg]
      have h2 : s * κ r = 1 := hψ h1
      exact (IsLocalRing.mem_maximalIdeal _ |>.mp hs) (isUnit_iff_exists_inv.mpr ⟨_, h2⟩)

  have rigid : ∀ (K : Type u) [Field K] (φ : Ω →+* K) (R1 R2 R3 : Type u) [CommRing R1] [IsLocalRing R1]
      [CommRing R2] [IsLocalRing R2] [CommRing R3] [IsLocalRing R3] (ψ1 : R1 →+* K) (ψ2 : R2 →+* K)
      (ψ3 : R3 →+* K) (κ1 : Ω →+* R1) (κ2 : Ω →+* R2) (κ3 : Ω →+* R3), Function.Injective ψ1 →
      Function.Injective ψ2 → Function.Injective ψ3 → ψ1.comp κ1 = φ → ψ2.comp κ2 = φ →
      ψ3.comp κ3 = φ → ∀ (g g' : K) (α β γ δ : Ω), (∃ s ∈ IsLocalRing.maximalIdeal R1, ψ1 s = g) →
      (∃ s ∈ IsLocalRing.maximalIdeal R2, ψ2 s = g - 1) →
      (∃ s ∈ IsLocalRing.maximalIdeal R3, ψ3 s * g = 1) →
      (∃ s ∈ IsLocalRing.maximalIdeal R1, ψ1 s = g') →
      (∃ s ∈ IsLocalRing.maximalIdeal R2, ψ2 s = g' - 1) →
      (∃ s ∈ IsLocalRing.maximalIdeal R3, ψ3 s * g' = 1) → α * δ - β * γ ≠ 0 →
      g' * (φ γ * g + φ δ) = φ α * g + φ β → g' = g := by
    intro K _ φ R1 R2 R3 _ _ _ _ _ _ ψ1 ψ2 ψ3 κ1 κ2 κ3 hψ1 hψ2 hψ3 hκ1 hκ2 hκ3 g g' α β γ δ
      ⟨s1, hs1, e1⟩ ⟨s2, hs2, e2⟩ ⟨s3, hs3, e3⟩ ⟨s1', hs1', e1'⟩ ⟨s2', hs2', e2'⟩ ⟨s3', hs3', e3'⟩
      hdet hrel
    have hφ1 : ∀ c, ψ1 (κ1 c) = φ c := fun c => by rw [← RingHom.comp_apply, hκ1]
    have hφ2 : ∀ c, ψ2 (κ2 c) = φ c := fun c => by rw [← RingHom.comp_apply, hκ2]
    have hφ3 : ∀ c, ψ3 (κ3 c) = φ c := fun c => by rw [← RingHom.comp_apply, hκ3]
    have resz : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (κ : Ω →+* R) (c : Ω),
        κ c ∈ IsLocalRing.maximalIdeal R → c = 0 := by
      intro R _ _ κ c hc
      by_contra hc0
      apply (IsLocalRing.mem_maximalIdeal _).mp hc
      exact isUnit_iff_exists_inv.mpr ⟨κ c⁻¹, by rw [← map_mul, mul_inv_cancel₀ hc0, map_one]⟩
    have hβ : β = 0 := by
      have h : s1' * (κ1 γ * s1 + κ1 δ) = κ1 α * s1 + κ1 β := hψ1 (by
        simp only [map_mul, map_add, hφ1, e1, e1']; exact hrel)
      apply resz R1 κ1
      have : κ1 β = s1' * (κ1 γ * s1 + κ1 δ) - κ1 α * s1 := by rw [h]; ring
      rw [this]
      exact Ideal.sub_mem _ (Ideal.mul_mem_right _ _ hs1') (Ideal.mul_mem_left _ _ hs1)
    subst hβ
    have hγ : γ = 0 := by
      have h : κ3 γ + κ3 δ * s3 = s3' * κ3 α := hψ3 (by
        simp only [map_mul, map_add, hφ3]
        have : ψ3 s3 * ψ3 s3' * (g' * (φ γ * g + φ δ)) = ψ3 s3 * ψ3 s3' * (φ α * g + φ 0) := by
          rw [hrel]
        rw [map_zero, add_zero] at this
        calc φ γ + φ δ * ψ3 s3 = (ψ3 s3' * g') * (φ γ * (ψ3 s3 * g) + φ δ * ψ3 s3) := by
                rw [e3, e3']; ring
          _ = ψ3 s3 * ψ3 s3' * (g' * (φ γ * g + φ δ)) := by ring
          _ = ψ3 s3 * ψ3 s3' * (φ α * g) := this
          _ = ψ3 s3' * φ α * (ψ3 s3 * g) := by ring
          _ = ψ3 s3' * φ α := by rw [e3, mul_one])
      apply resz R3 κ3
      have : κ3 γ = s3' * κ3 α - κ3 δ * s3 := by rw [← h]; ring
      rw [this]
      exact Ideal.sub_mem _ (Ideal.mul_mem_right _ _ hs3') (Ideal.mul_mem_left _ _ hs3)
    subst hγ
    have hδ0 : δ ≠ 0 := by
      intro h; apply hdet; rw [h]; ring
    have hαδ : α = δ := by
      have h : (1 + s2') * κ2 δ = κ2 α * (1 + s2) := hψ2 (by
        simp only [map_mul, map_add, map_one, hφ2, e2, e2']
        simp only [map_zero, zero_mul, zero_add, add_zero] at hrel
        rw [add_sub_cancel, add_sub_cancel, hrel])
      have : κ2 (α - δ) = s2' * κ2 δ - κ2 α * s2 := by
        rw [map_sub]; linear_combination (-1 : R2) * h
      have h0 := resz R2 κ2 (α - δ) (by
        rw [this]
        exact Ideal.sub_mem _ (Ideal.mul_mem_right _ _ hs2') (Ideal.mul_mem_left _ _ hs2))
      exact sub_eq_zero.mp h0
    subst hαδ
    simp only [map_zero, zero_mul, zero_add, add_zero] at hrel
    rw [mul_comm (φ α)] at hrel
    exact mul_right_cancel₀ (by rw [Ne, ← map_zero φ]; exact φ.injective.ne hδ0) hrel

  have hη : genericPoint (wcProjK Ω 1) ∈ wcSgD Ω 1 0 := by
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω))
    have hdeg : ∀ j : Fin (1+1), (MvPolynomial.X j : MvPolynomial (Fin (1+1)) Ω) ∈
