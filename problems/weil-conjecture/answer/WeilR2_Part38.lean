theorem wcpa_dj_p1rm_zero_not_in_j : ∀ (A : Type u) [CommRing A] (j c : Spec (.of (Polynomial A)) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra), IsPullback (Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A)) (LaurentPolynomial.T (-1))))) (Spec.map (CommRingCat.ofHom (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A))) j c → ∀ w : Spec (.of (Polynomial A)), (Polynomial.X : Polynomial A) ∈ w.asIdeal → c w ∉ Set.range j :=
