      · rw [Polynomial.hom_eval₂, hjκ, hjg]
      · rw [Polynomial.hom_eval₂, hevκ, hevg]
        rfl

    have hinvj : ∀ (t : X.presheaf.stalk p) (ht : IsUnit t), j (↑ht.unit⁻¹) * j t = 1 := by
      intro t ht
      rw [← map_mul, IsUnit.val_inv_mul, map_one]
    have hunit : ∀ (r : Polynomial Ω), r.eval u ≠ 0 → ∃ t, IsUnit t ∧ j t = r.eval₂ c g := by
      intro r hr
      obtain ⟨t, ht1, ht2⟩ := hE r
      refine ⟨t, isUnit_of_map_unit ev t ?_, ht1⟩
      rw [ht2]; exact Ne.isUnit hr
    have hfac : ∀ (r : Polynomial Ω), r ≠ 0 → ∃ (k : ℕ) (t : X.presheaf.stalk p), IsUnit t ∧
        r.eval₂ c g = (j s₀) ^ k * j t := by
      intro r hr
      obtain ⟨r₁, hr₁, hnd⟩ := Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd r hr u
      have hr₁u : r₁.eval u ≠ 0 := fun h => hnd (Polynomial.dvd_iff_isRoot.mpr h)
      obtain ⟨t, ht, htj⟩ := hunit r₁ hr₁u
      refine ⟨Polynomial.rootMultiplicity u r, t, ht, ?_⟩
      conv_lhs => rw [hr₁]
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_pow, Polynomial.eval₂_sub, Polynomial.eval₂_X,
        Polynomial.eval₂_C, ← hs₀', htj]
