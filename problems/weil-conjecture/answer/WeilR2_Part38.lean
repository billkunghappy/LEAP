  have hΦsmul0 : ∀ {p : ℕ} (a : Fin (p + 1) ↪o Fin (m + 1))
      (r : Γ(Y, wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a))
      (z : Γ(wcStructMod Y, wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a)),
