      have hinv' : (g s)⁻¹ ∈ (V : Set K) := hinv
      rw [hV] at hinv'
      obtain ⟨a, ha⟩ := hinv'
      simp only [RingHom.coe_comp, Function.comp_apply] at ha
      have h1 : g (φ a * s) = g 1 := by
        rw [map_mul, ha, map_one, inv_mul_cancel₀ hk0]
