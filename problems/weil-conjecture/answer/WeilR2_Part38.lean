      exact specializes_iff_mem_closure.mpr hy₀cl
    obtain ⟨a', _, ha'⟩ := Flat.generalizingMap p hsp
    exact ⟨a', ha'⟩

  obtain ⟨S, hScl', hS⟩ :=
    wcpa_dj_lus_cvs_ct_fc_fet_closure_section K R hκ Y v hss E hE hP1E
      (wcpa_dj_lus_cvs_ct_fc_closure_normal K R hκ Y v hss E hE hP1E) P p hpfin hpet hpsurj

  haveI hcci : IsClosedImmersion c :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have hf0ci : IsClosedImmersion f0 :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) (IsPullback.of_hasPullback v c).flip hcci
  haveI hj0ci : IsClosedImmersion j0 :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hpb.flip hf0ci
  have hj0inj : Function.Injective j0 := j0.isClosedEmbedding.injective
  apply hno (j0 ⁻¹' S) (hScl'.preimage j0.continuous)
  intro y hy
  obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hy
  have hyCl := (h𝒟 (C i) (hCmem i)).2 ⟨y, hi, rfl⟩
  have himg : j0 '' (p₀ ⁻¹' {y} ∩ j0 ⁻¹' S) = p ⁻¹' {f0 y} ∩ S := by
    ext b
    constructor
    · rintro ⟨a, ⟨ha1, ha2⟩, rfl⟩
      refine ⟨?_, ha2⟩
      rw [Set.mem_preimage, Set.mem_singleton_iff, hpj a, Set.mem_singleton_iff.mp ha1]
    · rintro ⟨hb1, hb2⟩
      obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := p) (g := f0) b y
        (Set.mem_singleton_iff.mp hb1)
      refine ⟨hpb.isoPullback.inv z, ⟨?_, ?_⟩, ?_⟩
      · rw [Set.mem_preimage, Set.mem_singleton_iff, ← Scheme.Hom.comp_apply,
          hpb.isoPullback_inv_snd, hz2]
      · rw [Set.mem_preimage, ← Scheme.Hom.comp_apply, hpb.isoPullback_inv_fst, hz1]
        exact hb2
      · rw [← Scheme.Hom.comp_apply, hpb.isoPullback_inv_fst, hz1]
  rw [← Set.ncard_image_of_injective _ hj0inj, himg]
  exact hS (f0 y) hyCl

theorem wcpa_dj_lus_cvs_closure_tree : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : ValuationSubring K), IsAlgClosed (IsLocalRing.ResidueField ↥R) → ∀ (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)), wcpaDjSemistable v →
    ∀ E ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))),
    (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra), IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧ θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = ι ≫ Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) →
    ∃ 𝒟 : Finset (Set ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))))), 𝒟.Nonempty ∧
      (∀ D ∈ 𝒟, D ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) ∧
        ∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥R)) MvPolynomial.gradedAlgebra), IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = D ∧ θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥R)) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField ↥R) ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥R) 0))) = ι ≫ Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) ∧
      (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) '' (⋃ D ∈ 𝒟, D) = closure ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) '' E) ∩ v ⁻¹' {IsLocalRing.closedPoint ↥R} ∧
      {x | ∃ D ∈ 𝒟, ∃ D' ∈ 𝒟, D ≠ D' ∧ x ∈ D ∧ x ∈ D'}.Finite ∧
      {x | ∃ D ∈ 𝒟, ∃ D' ∈ 𝒟, D ≠ D' ∧ x ∈ D ∧ x ∈ D'}.ncard + 1 ≤ 𝒟.card :=
by
  intro K _ _ R hκ Y v hss E hE hP1E
  classical
  haveI := hκ
  haveI : IsProper v := hss.2.1
  obtain ⟨_, ⟨hKemb, hKrange⟩, ⟨h0emb, h0range⟩, hfin0⟩ :=
    wcpa_dj_lus_cvs_fibre_topology K R Y v hss
  obtain ⟨_, hnodes⟩ := wcpa_dj_lfc_afc_fibre_nodes_finite _ _ v hss (IsLocalRing.ResidueField ↥R)
    (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))
  obtain ⟨hnoeth, hdim⟩ := wcpa_dj_lus_cvs_ct_closed_fibre_dim K R hκ Y v hss
  haveI := hnoeth
  set fK := Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) with hfK
  set f0 := Limits.pullback.fst v
    (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) with hf0
  set η := genericPoint (Spec (.of ↥R)) with hη
  set 𝔪 := IsLocalRing.closedPoint ↥R with h𝔪
  set Cl := closure (fK '' E) with hCl
  set T := f0 ⁻¹' Cl with hT

  have hEcl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
  obtain ⟨z, hzE⟩ : ∃ z, closure {z} = E := by
    refine ⟨hE.1.genericPoint, ?_⟩
    have h1 := hE.1.isGenericPoint_genericPoint_closure
    rw [hEcl.closure_eq] at h1
    exact h1
  have hzmem : z ∈ E := by rw [← hzE]; exact subset_closure rfl
  have hClg : Cl ⊆ closure {fK z} := by
    apply closure_minimal _ isClosed_closure
    rintro _ ⟨w, hw, rfl⟩
    rw [← hzE] at hw
    have h1 : z ⤳ w := specializes_iff_mem_closure.mpr hw
    exact specializes_iff_mem_closure.mp (h1.map fK.continuous)
  have hgCl : fK z ∈ Cl := subset_closure ⟨z, hzmem, rfl⟩
  have hvK : ∀ y, v (fK y) = η := by
    intro y
    have h1 : fK y ∈ Set.range fK := ⟨y, rfl⟩
    rw [hKrange] at h1
    exact h1
  have hv0 : ∀ y, v (f0 y) = 𝔪 := by
    intro y
    have h1 : f0 y ∈ Set.range f0 := ⟨y, rfl⟩
    rw [h0range] at h1
    exact h1
  have hfKinj : Function.Injective fK := hKemb.injective

  have KC : ∀ y ∈ T, ∃ D ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))), y ∈ D ∧ D ⊆ T := by
    intro y hy
    by_contra hno
    have hno' : ∀ D ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))), y ∈ D → ¬ D ⊆ T :=
      fun D hD hyD hDT => hno ⟨D, hD, hyD, hDT⟩
    have hTcl : IsClosed T := isClosed_closure.preimage f0.continuous
    obtain ⟨U, hUo, hyU, hUT⟩ :=
      wcpa_dj_lus_cvs_ct_dim_one_topology _ hdim T hTcl y hy hno'
    obtain ⟨V, hVo, hVU⟩ := h0emb.toIsEmbedding.toIsInducing.isOpen_iff.mp hUo
    have hyV : f0 y ∈ V := by
      rw [← hVU] at hyU
      exact hyU
    have hiso : ∀ x' ∈ V ∩ Cl, v x' = v (f0 y) → x' = f0 y := by
      rintro x' ⟨hx'V, hx'Cl⟩ hvx
      rw [hv0 y] at hvx
      obtain ⟨y', rfl⟩ : x' ∈ Set.range f0 := by rw [h0range]; exact hvx
      have hy'U : y' ∈ U ∩ T := ⟨by rw [← hVU]; exact hx'V, hx'Cl⟩
      rw [hUT] at hy'U
      rw [Set.mem_singleton_iff.mp hy'U]
    obtain ⟨V1, hV1o, hyV1, hV1⟩ :=
      wcpa_dj_lus_cvs_ct_closed_isolated_spread Y (Spec (.of ↥R)) v inferInstance Cl
        isClosed_closure (f0 y) hy ⟨V, hVo, hyV, hiso⟩
    have hgy : fK z ⤳ f0 y := specializes_iff_mem_closure.mpr (hClg hy)
    have hgV1 : fK z ∈ V1 := hgy.mem_open hV1o hyV1
    obtain ⟨V2, hV2o, hgV2, hV2⟩ := hV1 (fK z) ⟨hgV1, hgCl⟩
    have hOE : (fK ⁻¹' V2) ∩ E = {z} := by
      ext e
      constructor
      · rintro ⟨heV, heE⟩
        have h1 : fK e = fK z :=
          hV2 (fK e) ⟨heV, subset_closure ⟨e, heE, rfl⟩⟩ (by rw [hvK e, hvK z])
        exact Set.mem_singleton_iff.mpr (hfKinj h1)
      · intro he
        rw [Set.mem_singleton_iff] at he
        rw [he]
        exact ⟨hgV2, hzmem⟩
    obtain ⟨Er, ι, θ, hci, _, hrange, _⟩ := hP1E
    haveI := hci
    have hιinj : Function.Injective ι := ι.isClosedEmbedding.injective
    obtain ⟨e0, he0⟩ : z ∈ Set.range ι := by rw [hrange]; exact hzmem
    have hpre : ι ⁻¹' (fK ⁻¹' V2) = {e0} := by
      ext a
      constructor
      · intro ha
        have h1 : ι a ∈ fK ⁻¹' V2 ∩ E := ⟨ha, by rw [← hrange]; exact ⟨a, rfl⟩⟩
        rw [hOE] at h1
        exact Set.mem_singleton_iff.mpr (hιinj ((Set.mem_singleton_iff.mp h1).trans he0.symm))
      · intro ha
        rw [Set.mem_singleton_iff] at ha
        rw [Set.mem_preimage, ha, he0]
        exact hgV2
    have hopen : IsOpen ({e0} : Set Er) := by
      rw [← hpre]
      exact (hV2o.preimage fK.continuous).preimage ι.continuous
    apply wcpa_dj_lus_cvs_ct_P1_no_open_point K (θ.hom e0)
    rw [← Scheme.homeoOfIso_apply θ e0, ← Set.image_singleton]
    exact (Scheme.homeoOfIso θ).isOpenMap _ hopen

  have hTne : ∃ y0, y0 ∈ T := by
    have hcl : IsClosed (v '' Cl) := v.isClosedMap _ isClosed_closure
    have h1 : η ⤳ 𝔪 := genericPoint_specializes 𝔪
    have h2 : 𝔪 ∈ v '' Cl := h1.mem_closed hcl ⟨fK z, hgCl, hvK z⟩
    obtain ⟨x, hxCl, hxv⟩ := h2
    obtain ⟨y0, rfl⟩ : x ∈ Set.range f0 := by rw [h0range]; exact hxv
    exact ⟨y0, hxCl⟩

  have boundary : ∀ D ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))),
      ∀ D' ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))), D ≠ D' →
      ∀ x ∈ D, x ∈ D' → x ∈ closure Dᶜ := by
    intro D hD D' hD' hne x _ hxD'
    by_contra hx
    have hO : IsOpen (closure Dᶜ)ᶜ := isClosed_closure.isOpen_compl
    have hOD : (closure Dᶜ)ᶜ ⊆ D := by
      intro w hw
      by_contra hwD
      exact hw (subset_closure hwD)
    have hD'D : ¬ D' ⊆ D := by
      intro hsub
      exact hne (Set.Subset.antisymm (hD'.2 hD.1 hsub) hsub)
    obtain ⟨w, hwD', hwD⟩ := Set.inter_compl_nonempty_iff.mpr hD'D
    have hDc : IsOpen Dᶜ := (isClosed_of_mem_irreducibleComponents D hD).isOpen_compl
    obtain ⟨t, _, htO, htD⟩ :=
      hD'.1.isPreirreducible _ _ hO hDc ⟨x, hxD', hx⟩ ⟨w, hwD', hwD⟩
    exact htD (hOD htO)

  have hSfin : {D | D ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) ∧ D ⊆ T}.Finite :=
    hfin0.subset (fun D hD => hD.1)
  have hne : hSfin.toFinset.Nonempty := by
    obtain ⟨y0, hy0⟩ := hTne
    obtain ⟨D, hD, _, hDT⟩ := KC y0 hy0
    exact ⟨D, hSfin.mem_toFinset.mpr ⟨hD, hDT⟩⟩
  have hmem : ∀ D ∈ hSfin.toFinset, D ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) ∧
      f0 '' D ⊆ Cl := by
    intro D hD
    rw [hSfin.mem_toFinset] at hD
    refine ⟨hD.1, ?_⟩
    rintro _ ⟨x, hx, rfl⟩
    exact hD.2 hx
  refine ⟨hSfin.toFinset, hne, ?_, ?_, ?_, ?_⟩
  · intro D hD
    refine ⟨(hmem D hD).1, ?_⟩
    exact wcpa_dj_lus_cvs_ct_component_P1 K R hκ Y v hss E hE hP1E D (hmem D hD).1 (hmem D hD).2
  · ext w
    constructor
    · rintro ⟨x, hx, rfl⟩
      obtain ⟨D, hD, hxD⟩ := Set.mem_iUnion₂.mp hx
      exact ⟨(hmem D hD).2 ⟨x, hxD, rfl⟩, hv0 x⟩
    · rintro ⟨hwCl, hwv⟩
      obtain ⟨y, rfl⟩ : w ∈ Set.range f0 := by rw [h0range]; exact hwv
      obtain ⟨D, hD, hyD, hDT⟩ := KC y hwCl
      exact ⟨y, Set.mem_iUnion₂.mpr ⟨D, hSfin.mem_toFinset.mpr ⟨hD, hDT⟩, hyD⟩, rfl⟩
  · have hfinU : (⋃ D ∈ (hSfin.toFinset : Set (Set ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))))),
        D ∩ closure Dᶜ).Finite := by
      refine (hSfin.toFinset.finite_toSet).biUnion ?_
      intro D hD
      exact (hnodes D (hmem D (Finset.mem_coe.mp hD)).1).1
    refine hfinU.subset ?_
    rintro x ⟨D, hD, D', hD', hne', hxD, hxD'⟩
    refine Set.mem_iUnion₂.mpr ⟨D, Finset.mem_coe.mpr hD, hxD, ?_⟩
    exact boundary D (hmem D hD).1 D' (hmem D' hD').1 hne' x hxD hxD'
  · exact wcpa_dj_lus_cvs_ct_forest_count K R hκ Y v hss E hE hP1E hSfin.toFinset hne hmem

theorem wcpa_dj_lus_cvs_external_bound : ∀ {Y Yk Y0 S : Type u} [TopologicalSpace Y] [TopologicalSpace Yk] [TopologicalSpace Y0] [TopologicalSpace S] [QuasiSober Yk] [QuasiSober Y0] (v : Y → S) (fK : Yk → Y) (f0 : Y0 → Y) (η 𝔪 : S), Continuous v → Topology.IsEmbedding fK → Set.range fK = v ⁻¹' {η} → Topology.IsClosedEmbedding f0 → Set.range f0 = v ⁻¹' {𝔪} → (∀ y : Y0, ∃ y' : Y, v y' = η ∧ y' ⤳ f0 y) → (∀ E₁ ∈ irreducibleComponents Yk, ∀ E₂ ∈ irreducibleComponents Yk, E₁ ≠ E₂ → ∀ y : Y0, f0 y ∈ closure (fK '' E₁) → f0 y ∈ closure (fK '' E₂) → ∃ n ∈ E₁ ∩ E₂, fK n ⤳ f0 y) → (∀ n : Yk, IsClosed {n} → ∀ y y' : Y0, fK n ⤳ f0 y → fK n ⤳ f0 y' → y = y') → ∀ E ∈ irreducibleComponents Yk, (E ∩ closure Eᶜ).Finite → (∀ x ∈ E ∩ closure Eᶜ, IsClosed {x}) → ∀ 𝒟 : Finset (Set Y0), (∀ D ∈ 𝒟, D ∈ irreducibleComponents Y0) → f0 '' (⋃ D ∈ 𝒟, D) = closure (fK '' E) ∩ v ⁻¹' {𝔪} → {y | (∃ D ∈ 𝒟, y ∈ D) ∧ ∃ D' ∈ irreducibleComponents Y0, D' ∉ 𝒟 ∧ y ∈ D'}.Finite ∧ {y | (∃ D ∈ 𝒟, y ∈ D) ∧ ∃ D' ∈ irreducibleComponents Y0, D' ∉ 𝒟 ∧ y ∈ D'}.ncard ≤ (E ∩ closure Eᶜ).ncard :=
by
  intro Y Yk Y0 S _ _ _ _ _ _ v fK f0 η 𝔪 _hv _hKemb hKrange h0emb h0range hH2 hH3 hH4 E hE hextfin
    hextcl 𝒟 h𝒟 himg
  classical

  have s1 : ∀ E' ∈ irreducibleComponents Yk, E' ≠ E → E' ⊆ closure Eᶜ := by
    intro E' hE' hne x hx
    have hEcl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
    have hnon : (E' ∩ Eᶜ).Nonempty := by
      by_contra h
      have hsub : E' ⊆ E := by
        intro z hz
        by_contra hzE
        exact h ⟨z, hz, hzE⟩
      exact hne (le_antisymm hsub (hE'.2 hE.1 hsub))
    by_contra hxc
    have hU : IsOpen (closure Eᶜ)ᶜ := isClosed_closure.isOpen_compl
    obtain ⟨z, _, hzU, hzE⟩ :=
      hE'.1.isPreirreducible _ _ hU hEcl.isOpen_compl ⟨x, hx, hxc⟩ hnon
    exact hzU (subset_closure hzE)

  have himgsub : ∀ y : Y0, f0 y ∈ closure (fK '' E) → ∃ D ∈ 𝒟, y ∈ D := by
    intro y hy
    have h1 : f0 y ∈ closure (fK '' E) ∩ v ⁻¹' {𝔪} :=
      ⟨hy, by rw [← h0range]; exact ⟨y, rfl⟩⟩
    rw [← himg] at h1
    obtain ⟨g1, hg1, hfg⟩ := h1
    rw [h0emb.toIsEmbedding.injective hfg] at hg1
    obtain ⟨D, hD, hyD⟩ := Set.mem_iUnion₂.mp hg1
    exact ⟨D, hD, hyD⟩

  have s2 : ∀ D' ∈ irreducibleComponents Y0, D' ∉ 𝒟 → ∀ y ∈ D',
      ∃ E' ∈ irreducibleComponents Yk, E' ≠ E ∧ f0 y ∈ closure (fK '' E') := by
    intro D' hD' hD'𝒟 y hy
    have hD'cl : IsClosed D' := isClosed_of_mem_irreducibleComponents D' hD'
    have hg : IsGenericPoint hD'.1.genericPoint D' := by
      have h1 := hD'.1.isGenericPoint_genericPoint_closure
      rwa [hD'cl.closure_eq] at h1
    set g := hD'.1.genericPoint
    have hgy : g ⤳ y := hg.specializes hy
    obtain ⟨y', hvy', hy'g⟩ := hH2 g
    obtain ⟨w, rfl⟩ : y' ∈ Set.range fK := by rw [hKrange]; exact hvy'
    obtain ⟨E', hE', hwE'⟩ :=
      exists_mem_irreducibleComponents_subset_of_isIrreducible {w} isIrreducible_singleton
    have hwimg : fK w ∈ fK '' E' := ⟨w, hwE' (Set.mem_singleton w), rfl⟩
    have hmem : ∀ z, fK w ⤳ z → z ∈ closure (fK '' E') := fun z hz =>
      closure_mono (Set.singleton_subset_iff.mpr hwimg) (specializes_iff_mem_closure.mp hz)
    refine ⟨E', hE', ?_, hmem _ (hy'g.trans (hgy.map h0emb.continuous))⟩
    intro hEE
    rw [hEE] at hmem
    obtain ⟨D'', hD'', hgD''⟩ := himgsub g (hmem _ hy'g)
    have hg' : closure {g} = D' := hg
    have hsub : D' ⊆ D'' := by
      rw [← hg']
      exact closure_minimal (Set.singleton_subset_iff.mpr hgD'')
        (isClosed_of_mem_irreducibleComponents D'' (h𝒟 D'' hD''))
    have hDD : D'' = D' := le_antisymm (hD'.2 (h𝒟 D'' hD'').1 hsub) hsub
    exact hD'𝒟 (hDD ▸ hD'')
  set Sx := {y | (∃ D ∈ 𝒟, y ∈ D) ∧ ∃ D' ∈ irreducibleComponents Y0, D' ∉ 𝒟 ∧ y ∈ D'} with hSx

  have s3 : ∀ y ∈ Sx, ∃ n, n ∈ E ∩ closure Eᶜ ∧ fK n ⤳ f0 y := by
    rintro y ⟨⟨D, hD, hyD⟩, D', hD', hD'𝒟, hyD'⟩
    obtain ⟨E', hE', hne, hyE'⟩ := s2 D' hD' hD'𝒟 y hyD'
    have hyE : f0 y ∈ closure (fK '' E) := by
      have h1 : f0 y ∈ f0 '' (⋃ D ∈ 𝒟, D) := ⟨y, Set.mem_iUnion₂.mpr ⟨D, hD, hyD⟩, rfl⟩
      rw [himg] at h1
      exact h1.1
    obtain ⟨n, ⟨hnE, hnE'⟩, hn⟩ := hH3 E hE E' hE' (Ne.symm hne) y hyE hyE'
    exact ⟨n, ⟨hnE, s1 E' hE' hne hnE'⟩, hn⟩

  rcases isEmpty_or_nonempty Yk with hYk | hYk
  · have hS0 : Sx = ∅ := Set.eq_empty_of_subset_empty (fun y hy => by
      obtain ⟨n, _, _⟩ := s3 y hy
      exact isEmptyElim n)
    rw [hS0]
    exact ⟨Set.finite_empty, by simp⟩
  · choose! φ hφ using s3
    have hmaps : ∀ y ∈ Sx, φ y ∈ E ∩ closure Eᶜ := fun y hy => (hφ y hy).1
    have hinj : Set.InjOn φ Sx := by
      intro y1 hy1 y2 hy2 h
      have h1 := hφ y1 hy1
      have h2 := hφ y2 hy2
      rw [← h] at h2
      exact hH4 (φ y1) (hextcl _ h1.1) y1 y2 h1.2 h2.2
    exact ⟨Set.Finite.of_injOn hmaps hinj hextfin,
      Set.ncard_le_ncard_of_injOn φ hmaps hinj hextfin⟩

theorem wcpa_dj_lus_cvs_smooth_valuation_stalk_domain : ∀ (K : Type u) [Field K] (R : ValuationSubring K) (W : Scheme.{u}) (q : W ⟶ Spec (.of ↥R)) [SmoothOfRelativeDimension 1 q] (w : W), IsDomain (W.presheaf.stalk w) :=
by

  have t_kill : ∀ (S : Type u) [CommRing S] (Q 𝔮 : Ideal S) [Q.IsPrime] [𝔮.IsPrime],
      (∀ y ∈ 𝔮, ∃ c ∉ Q, c * y = 0) → IsDomain (Localization.AtPrime Q) := by
    intro S _ Q 𝔮 hQ h𝔮 H
    have hsub : ∀ y ∈ 𝔮, y ∈ Q := by
      intro y hy
      obtain ⟨c, hc, hcy⟩ := H y hy
      have : c * y ∈ Q := by rw [hcy]; exact Q.zero_mem
      exact (hQ.mem_or_mem this).resolve_left hc
    have hz : ∀ (x : S) (s : Q.primeCompl), x ∈ 𝔮 →
        IsLocalization.mk' (Localization.AtPrime Q) x s = 0 := by
      intro x s hx
      obtain ⟨c, hc, hcx⟩ := H x hx
      rw [IsLocalization.mk'_eq_zero_iff]
      exact ⟨⟨c, hc⟩, hcx⟩
    have : NoZeroDivisors (Localization.AtPrime Q) := by
      constructor
      intro a b hab
      obtain ⟨⟨x, s⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl a
      obtain ⟨⟨y, t⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl b
      rw [← IsLocalization.mk'_mul, IsLocalization.mk'_eq_zero_iff] at hab
      obtain ⟨m, hm⟩ := hab
      have hm𝔮 : (m : S) ∉ 𝔮 := fun h => m.2 (hsub _ h)
      have h1 : (m : S) * (x * y) ∈ 𝔮 := by rw [hm]; exact 𝔮.zero_mem
      rcases h𝔮.mem_or_mem h1 with h | h
      · exact absurd h hm𝔮
      rcases h𝔮.mem_or_mem h with h | h
      · left; exact hz x s h
      · right; exact hz y t h
    exact NoZeroDivisors.to_isDomain _

  have t_simple : ∀ (E : Type u) [CommRing E] (S : Type u) [CommRing S] [Algebra E S]
      (Q : Ideal S) [Q.IsPrime] (x : S) (f g φ ψ p₁ p₂ : Polynomial E) (n : ℕ),
      Polynomial.derivative f * p₁ + f * p₂ = g ^ n → f = φ * ψ →
      Polynomial.aeval x f = 0 → IsUnit (Polynomial.aeval x g) →
      Polynomial.aeval x φ ∈ Q → Polynomial.aeval x ψ ∉ Q := by
    intro E _ S _ _ Q hQ x f g φ ψ p₁ p₂ n hB hf hf0 hg hφ hψ
    have h1 : Polynomial.aeval x (Polynomial.derivative f) ∈ Q := by
      rw [hf, Polynomial.derivative_mul, map_add, map_mul, map_mul]
      exact Q.add_mem (Q.mul_mem_left _ hψ) (Q.mul_mem_right _ hφ)
    have h2 := congrArg (Polynomial.aeval x) hB
    rw [map_add, map_mul, map_mul, hf0, zero_mul, add_zero, map_pow] at h2
    have h3 : Polynomial.aeval x g ^ n ∈ Q := h2 ▸ Q.mul_mem_right _ h1
    exact hQ.ne_top (Ideal.eq_top_of_isUnit_mem _ h3 (hg.pow n))

  have t_factor : ∀ (E : Type u) [CommRing E] [IsDomain E] [IsIntegrallyClosed E] (S : Type u)
      [CommRing S] [Algebra E S] (Q : Ideal S) [Q.IsPrime] (x : S) (F : Polynomial E),
      F.Monic → Polynomial.aeval x F ∈ Q →
      ∃ φ ψ : Polynomial E, φ.Monic ∧ ψ.Monic ∧ F = φ * ψ ∧
        Irreducible (Polynomial.map (algebraMap E (FractionRing E)) φ) ∧
        Polynomial.aeval x φ ∈ Q := by
    intro E _ _ _ S _ _ Q hQ x F hF hFQ
    obtain ⟨d, hd⟩ : ∃ d, F.natDegree = d := ⟨_, rfl⟩
    induction d using Nat.strong_induction_on generalizing F with
    | _ d ih =>
    have hF1 : F ≠ 1 := by
      rintro rfl
      rw [map_one] at hFQ
      exact hQ.ne_top ((Ideal.eq_top_iff_one _).mpr hFQ)
    by_cases hirr : Irreducible F
    · refine ⟨F, 1, hF, Polynomial.monic_one, (mul_one F).symm, ?_, hFQ⟩
      exact (Polynomial.Monic.irreducible_iff_irreducible_map_fraction_map hF).mp hirr
    · rw [Polynomial.Monic.irreducible_iff_natDegree hF] at hirr
      push_neg at hirr
      obtain ⟨a, b, ha, hb, hab, ha0, hb0⟩ := hirr hF1
      have hdeg : F.natDegree = a.natDegree + b.natDegree := by
        rw [← hab, ha.natDegree_mul hb]
      have hQab : Polynomial.aeval x a * Polynomial.aeval x b ∈ Q := by
        rw [← map_mul, hab]; exact hFQ
      rcases hQ.mem_or_mem hQab with h | h
      · obtain ⟨φ, ψ, hφ, hψ, he, hi, hq⟩ := ih a.natDegree (by omega) a ha h rfl
        exact ⟨φ, ψ * b, hφ, hψ.mul hb, by rw [← hab, he, mul_assoc], hi, hq⟩
      · obtain ⟨φ, ψ, hφ, hψ, he, hi, hq⟩ := ih b.natDegree (by omega) b hb h rfl
        exact ⟨φ, ψ * a, hφ, hψ.mul ha, by rw [← hab, he, mul_comm a, mul_assoc], hi, hq⟩

  have t_mvnormal : ∀ (D : Type u) [CommRing D] [IsDomain D] [IsIntegrallyClosed D] (n : ℕ),
      IsIntegrallyClosed (MvPolynomial (Fin n) D) := by
    intro D _ _ _ n
    induction n with
    | zero =>
      exact IsIntegrallyClosed.of_equiv (MvPolynomial.isEmptyAlgEquiv D (Fin 0)).symm.toRingEquiv
    | succ n ih =>
      exact IsIntegrallyClosed.of_equiv (MvPolynomial.finSuccEquiv D n).symm.toRingEquiv

  have t_frac : ∀ (E : Type u) [CommRing E] (P : StandardEtalePair E) (y : P.Ring),
      ∃ (h : Polynomial E) (N : ℕ),
        y * (Polynomial.aeval P.X P.g) ^ N = Polynomial.aeval P.X h := by
    intro E _ P y
    let mk : Polynomial (Polynomial E) →+* P.Ring :=
      Ideal.Quotient.mk (Ideal.span {Polynomial.C P.f, Polynomial.X * Polynomial.C P.g - 1})
    have ha : ∀ p : Polynomial E, mk (Polynomial.C p) = Polynomial.aeval P.X p := by
      intro p
      have : mk.comp Polynomial.C = (Polynomial.aeval P.X : _ →ₐ[E] P.Ring).toRingHom := by
        apply Polynomial.ringHom_ext
        · intro c
          show mk (Polynomial.C (Polynomial.C c)) = Polynomial.aeval P.X (Polynomial.C c)
          rw [Polynomial.aeval_C]
          rfl
        · show mk (Polynomial.C Polynomial.X) = Polynomial.aeval P.X Polynomial.X
          rw [Polynomial.aeval_X]
          rfl
      exact RingHom.congr_fun this p
    have hu : Polynomial.aeval P.X P.g * mk Polynomial.X = 1 := P.aeval_X_g_mul_mk_X
    obtain ⟨H, rfl⟩ : ∃ H, mk H = y := Ideal.Quotient.mk_surjective y
    induction H using Polynomial.induction_on with
    | C p => exact ⟨p, 0, by rw [pow_zero, mul_one, ha]⟩
    | add H₁ H₂ ih₁ ih₂ =>
      obtain ⟨h₁, N₁, e₁⟩ := ih₁
      obtain ⟨h₂, N₂, e₂⟩ := ih₂
      refine ⟨h₁ * P.g ^ N₂ + h₂ * P.g ^ N₁, N₁ + N₂, ?_⟩
      rw [map_add, map_add, map_mul, map_mul, map_pow, map_pow, ← e₁, ← e₂]
      ring
    | monomial k a ih =>
      obtain ⟨h, N, e⟩ := ih
      refine ⟨h, N + 1, ?_⟩
      have e2 : mk (Polynomial.C a * Polynomial.X ^ (k + 1)) *
          Polynomial.aeval P.X P.g ^ (N + 1) =
          (mk (Polynomial.C a * Polynomial.X ^ k) * Polynomial.aeval P.X P.g ^ N) *
          (Polynomial.aeval P.X P.g * mk Polynomial.X) := by
        rw [pow_succ Polynomial.X, ← mul_assoc, map_mul (f := mk)]
        ring
      rw [e2, e, hu, mul_one]

  have t_away : ∀ (A : Type u) [CommRing A] (f : A) (p : Ideal A) [p.IsPrime], f ∉ p →
      (∀ (Q : Ideal (Localization.Away f)) [Q.IsPrime], IsDomain (Localization.AtPrime Q)) →
      IsDomain (Localization.AtPrime p) := by
    intro A _ f p hp hf H
    have hdisj : Disjoint (Submonoid.powers f : Set A) (p : Set A) := by
      rw [Set.disjoint_left]
      rintro _ ⟨k, rfl⟩ hk
      exact hf (hp.mem_of_pow_mem k hk)
    let Q := Ideal.map (algebraMap A (Localization.Away f)) p
    haveI hQ : Q.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f) _ p hp hdisj
    have hcomap : Q.comap (algebraMap A (Localization.Away f)) = p :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers f) _ hp hdisj
    haveI := H Q
    have hloc0 :=
      IsLocalization.isLocalization_atPrime_localization_atPrime (Submonoid.powers f) Q
    have hM : (Q.comap (algebraMap A (Localization.Away f))).primeCompl = p.primeCompl := by
      ext a
      rw [Ideal.mem_primeCompl_iff, Ideal.mem_primeCompl_iff, hcomap]
    have hloc : IsLocalization p.primeCompl (Localization.AtPrime Q) := by
      have h := hloc0
      unfold IsLocalization.AtPrime at h
      rwa [hM] at h
    exact MulEquiv.isDomain _ (IsLocalization.algEquiv p.primeCompl (Localization.AtPrime p)
      (Localization.AtPrime Q)).toMulEquiv

  have t_equiv : ∀ (S T : Type u) [CommRing S] [CommRing T] (e : S ≃+* T),
      (∀ (Q : Ideal T) [Q.IsPrime], IsDomain (Localization.AtPrime Q)) →
      ∀ (Q : Ideal S) [Q.IsPrime], IsDomain (Localization.AtPrime Q) := by
    intro S T _ _ e H Q hQ
    let Q' := Q.map e
    haveI : Q'.IsPrime := Ideal.map_isPrime_of_equiv e
    haveI := H Q'
    have hmem : ∀ y, y ∈ Q' ↔ e.symm y ∈ Q := by
      intro y
      show y ∈ Q.map e ↔ _
      rw [Ideal.mem_map_of_equiv]
      constructor
      · rintro ⟨x, hx, rfl⟩
        simpa using hx
      · intro h
        exact ⟨e.symm y, h, by simp⟩
    have hM : Submonoid.map e.toMonoidHom Q.primeCompl = Q'.primeCompl := by
      ext y
      constructor
      · rintro ⟨x, hx, rfl⟩
        show _ ∉ Q'
        rw [hmem]
        simpa using hx
      · intro hy
        refine ⟨e.symm y, ?_, by simp⟩
        show e.symm y ∉ Q
        rw [← hmem]
        exact hy
    exact MulEquiv.isDomain _ (IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime Q)
      (Localization.AtPrime Q') e hM).toMulEquiv

  have t_crux : ∀ (E : Type u) [CommRing E] [IsDomain E] [IsIntegrallyClosed E]
      (P : StandardEtalePair E) (Q : Ideal P.Ring) [Q.IsPrime],
      IsDomain (Localization.AtPrime Q) := by
    intro E _ _ _ P Q hQ
    classical
    obtain ⟨hf0, hgu⟩ : Polynomial.aeval P.X P.f = 0 ∧ IsUnit (Polynomial.aeval P.X P.g) :=
      P.hasMap_X
    obtain ⟨φ, ψ, hφm, hψm, hfφψ, hirr, hφQ⟩ :=
      t_factor E P.Ring Q P.X P.f P.monic_f (by rw [hf0]; exact Q.zero_mem)
    obtain ⟨p₁, p₂, n, hB⟩ := P.cond
    have hψQ := t_simple E P.Ring Q P.X P.f P.g φ ψ p₁ p₂ n hB hfφψ hf0 hgu hφQ
    haveI : Fact (Irreducible (Polynomial.map (algebraMap E (FractionRing E)) φ)) := ⟨hirr⟩
    have hinj : Function.Injective (algebraMap E (FractionRing E)) :=
      IsFractionRing.injective E (FractionRing E)
    let θ : AdjoinRoot (Polynomial.map (algebraMap E (FractionRing E)) φ) := AdjoinRoot.root _
    have key : ∀ h : Polynomial E, Polynomial.aeval θ h = 0 ↔ φ ∣ h := by
      intro h
      rw [← Polynomial.aeval_map_algebraMap (FractionRing E), AdjoinRoot.aeval_eq,
        AdjoinRoot.mk_eq_zero]
      exact Polynomial.map_dvd_map _ hinj hφm
    have hθ : P.HasMap θ := by
      refine ⟨(key _).mpr ⟨ψ, hfφψ⟩, ?_⟩
      refine isUnit_iff_ne_zero.mpr ?_
      intro h0
      obtain ⟨k, hk⟩ := (key _).mp h0
      have : Polynomial.aeval P.X P.g ∈ Q := by
        rw [hk, map_mul]; exact Q.mul_mem_right _ hφQ
      exact hQ.ne_top (Ideal.eq_top_of_isUnit_mem _ this hgu)
    let ρ := P.lift θ hθ
    have hρ : ∀ h : Polynomial E, ρ (Polynomial.aeval P.X h) = Polynomial.aeval θ h := by
      intro h
      rw [← Polynomial.aeval_algHom_apply, StandardEtalePair.lift_X]
    haveI : (RingHom.ker ρ).IsPrime := RingHom.ker_isPrime ρ
    refine t_kill P.Ring Q (RingHom.ker ρ) ?_
    intro y hy
    rw [RingHom.mem_ker] at hy
    obtain ⟨h, N, hN⟩ := t_frac E P y
    have h1 : Polynomial.aeval θ h = 0 := by
      rw [← hρ, ← hN, map_mul, hy, zero_mul]
    obtain ⟨k, hk⟩ := (key h).mp h1
    refine ⟨Polynomial.aeval P.X ψ * Polynomial.aeval P.X P.g ^ N, ?_, ?_⟩
    · intro hm
      rcases hQ.mem_or_mem hm with h2 | h2
      · exact hψQ h2
      · exact hQ.ne_top (Ideal.eq_top_of_isUnit_mem _ h2 (hgu.pow N))
    · calc Polynomial.aeval P.X ψ * Polynomial.aeval P.X P.g ^ N * y
            = Polynomial.aeval P.X ψ * (y * Polynomial.aeval P.X P.g ^ N) := by ring
        _ = Polynomial.aeval P.X P.f * Polynomial.aeval P.X k := by
            rw [hN, hk, hfφψ]; simp only [map_mul]; ring
        _ = 0 := by rw [hf0, zero_mul]

  have t_model : ∀ (B : Type u) [CommRing B] (W : Scheme.{u}) (s : W ⟶ Spec (.of B)) (n : ℕ)
      [SmoothOfRelativeDimension n s] (w : W),
      ∃ (A : Type u) (_ : CommRing A) (_ : Algebra B A) (_ : Algebra.Smooth B A) (p : Ideal A)
        (_ : p.IsPrime), Nonempty (W.presheaf.stalk w ≃+* Localization.AtPrime p) := by
    intro B _ W s n _ w
    have hs : Smooth s := SmoothOfRelativeDimension.smooth n s
    obtain ⟨V, hV, hw, -⟩ := exists_isAffineOpen_mem_and_subset (x := w) (U := ⊤) trivial
    have e : V ≤ s ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
    have h₁ : (s.appLE ⊤ V e).hom.Smooth :=
      HasRingHomProperty.appLE @Smooth s hs ⟨⊤, isAffineOpen_top (Spec (.of B))⟩ ⟨V, hV⟩ e
    set g : B →+* Γ(Spec (.of B), ⊤) := (Scheme.ΓSpecIso (.of B)).inv.hom with hg
    have hgb : Function.Bijective g := by
      refine Function.bijective_iff_has_inverse.mpr ⟨(Scheme.ΓSpecIso (.of B)).hom.hom, ?_, ?_⟩
      · intro x
        exact CommRingCat.hom_inv_apply (Scheme.ΓSpecIso (.of B)) x
      · intro x
        exact CommRingCat.inv_hom_apply (Scheme.ΓSpecIso (.of B)) x
    have h₂ : g.Smooth := RingHom.Smooth.of_bijective hgb
    set φ : B →+* Γ(W, V) := (s.appLE ⊤ V e).hom.comp g with hφdef
    have hφ : φ.Smooth := RingHom.Smooth.comp h₂ h₁
    obtain ⟨x, hx⟩ : ∃ x : V, (x : W) = w := ⟨⟨w, hw⟩, rfl⟩
    subst hx
    let p : Ideal Γ(W, V) := (hV.primeIdealOf x).asIdeal
    have hloc : IsLocalization.AtPrime (W.presheaf.stalk (x : W)) p := hV.isLocalization_stalk x
    have iso : W.presheaf.stalk (x : W) ≃+* Localization.AtPrime p :=
      (IsLocalization.algEquiv p.primeCompl (W.presheaf.stalk (x : W))
        (Localization.AtPrime p)).toRingEquiv
    exact ⟨Γ(W, V), inferInstance, φ.toAlgebra, hφ, p, inferInstance, ⟨iso⟩⟩

  intro K _ R W q _ w
  obtain ⟨A, _, _, _, p, _, ⟨e⟩⟩ := t_model R W q 1 w
  suffices h : IsDomain (Localization.AtPrime p) from MulEquiv.isDomain _ e.toMulEquiv
  obtain ⟨f, hfp, hst⟩ := Algebra.IsSmoothAt.exists_notMem_isStandardSmooth (R := R) p
  refine t_away A f p hfp ?_
  intro Q _
  obtain ⟨ι, σ, hσ, hι, ⟨Pr⟩⟩ := hst.out
  haveI : Algebra.IsStandardSmoothOfRelativeDimension Pr.dimension R (Localization.Away f) :=
    ⟨⟨ι, σ, hσ, hι, Pr, rfl⟩⟩
  obtain ⟨φ, hφ⟩ := Algebra.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial
    Pr.dimension R (Localization.Away f)
  letI : Algebra (MvPolynomial (Fin Pr.dimension) R) (Localization.Away f) :=
    φ.toRingHom.toAlgebra
  haveI : Algebra.Etale (MvPolynomial (Fin Pr.dimension) R) (Localization.Away f) := hφ
  obtain ⟨h, hh, hse⟩ :=
    Algebra.IsEtaleAt.exists_isStandardEtale (R := MvPolynomial (Fin Pr.dimension) R) Q
  refine t_away (Localization.Away f) h Q hh ?_
  intro Q' _
  obtain ⟨Pres⟩ := hse.nonempty_standardEtalePresentation
  haveI : IsIntegrallyClosed (MvPolynomial (Fin Pr.dimension) R) := t_mvnormal R Pr.dimension
  exact t_equiv _ _ Pres.equivRing.toRingEquiv (fun Q'' _ => t_crux _ Pres.P Q'') Q'

theorem wcpa_dj_lus_cvs_tree_pigeonhole : ∀ {α : Type u} (𝒟 : Finset (Set α)) (I X : Set α) (k : ℕ) (μ : Fin k → α), I.Finite → X.Finite → I.ncard + 1 ≤ 𝒟.card → (∀ x ∈ I, {D | D ∈ 𝒟 ∧ x ∈ D}.ncard ≤ 2) → (∀ x ∈ X, {D | D ∈ 𝒟 ∧ x ∈ D}.ncard ≤ 1) → (∀ i, {D | D ∈ 𝒟 ∧ μ i ∈ D}.ncard ≤ 1) → X.ncard + Nat.card {i : Fin k // ∃ D ∈ 𝒟, μ i ∈ D} ≤ 2 → ∃ D ∈ 𝒟, (D ∩ (I ∪ X)).ncard + Nat.card {i : Fin k // μ i ∈ D} ≤ 2 :=
by
  intro α 𝒟 I X k μ hI hX hcard hdI hdX hdμ hXM
  classical
  have inc : ∀ (S : Set α) (c : ℕ), S.Finite → (∀ x ∈ S, {D | D ∈ 𝒟 ∧ x ∈ D}.ncard ≤ c) →
      ∑ D ∈ 𝒟, (D ∩ S).ncard ≤ c * S.ncard := by
    intro S c hS hc
    have h1 : ∀ D ∈ 𝒟, (D ∩ S).ncard = (hS.toFinset.filter (fun x => x ∈ D)).card := by
      intro D _
      rw [← Set.ncard_coe_finset]
      congr 1
      ext x
      simp [and_comm]
    have h2 : ∀ x ∈ hS.toFinset, (𝒟.filter (fun D => x ∈ D)).card ≤ c := by
      intro x hx
      have := hc x (hS.mem_toFinset.mp hx)
      rw [← Set.ncard_coe_finset]
      convert this using 2
      ext D
      simp
    rw [Finset.sum_congr rfl h1]
    have h3 := Finset.sum_card_bipartiteAbove_eq_sum_card_bipartiteBelow (s := 𝒟)
      (t := hS.toFinset) (r := fun D x => x ∈ D)
    simp only [Finset.bipartiteAbove, Finset.bipartiteBelow] at h3
    rw [h3]
    calc ∑ x ∈ hS.toFinset, (𝒟.filter (fun D => x ∈ D)).card ≤ hS.toFinset.card • c :=
          Finset.sum_le_card_nsmul _ _ _ h2
      _ = c * S.ncard := by rw [smul_eq_mul, mul_comm, Set.ncard_eq_toFinset_card S hS]
  have marks : ∑ D ∈ 𝒟, Nat.card {i : Fin k // μ i ∈ D} ≤
      Nat.card {i : Fin k // ∃ D ∈ 𝒟, μ i ∈ D} := by
    have e1 : ∀ D : Set α, Nat.card {i : Fin k // μ i ∈ D} =
        (Finset.univ.filter (fun i => μ i ∈ D)).card := by
      intro D
      rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
    have e2 : Nat.card {i : Fin k // ∃ D ∈ 𝒟, μ i ∈ D} =
        (Finset.univ.filter (fun i => ∃ D ∈ 𝒟, μ i ∈ D)).card := by
      rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
    simp only [e1, e2]
    have h3 := Finset.sum_card_bipartiteAbove_eq_sum_card_bipartiteBelow (s := 𝒟)
      (t := (Finset.univ : Finset (Fin k))) (r := fun D i => μ i ∈ D)
    simp only [Finset.bipartiteAbove, Finset.bipartiteBelow] at h3
    rw [h3, Finset.card_filter]
    apply Finset.sum_le_sum
    intro i _
    split_ifs with h
    · have := hdμ i
      rw [← Set.ncard_coe_finset]
      convert this using 2
      ext D
      simp
    · rw [Nat.le_zero, Finset.card_eq_zero, Finset.filter_eq_empty_iff]
      intro D hD hμ
      exact h ⟨D, hD, hμ⟩
  have pt : ∀ D : Set α, (D ∩ (I ∪ X)).ncard ≤ (D ∩ I).ncard + (D ∩ X).ncard := by
    intro D
    rw [Set.inter_union_distrib_left]
    exact Set.ncard_union_le _ _
  have sI := inc I 2 hI hdI
  have sX := inc X 1 hX hdX
  have hsum : ∑ D ∈ 𝒟, ((D ∩ (I ∪ X)).ncard + Nat.card {i : Fin k // μ i ∈ D}) ≤
      2 * 𝒟.card := by
    calc _ ≤ ∑ D ∈ 𝒟, ((D ∩ I).ncard + (D ∩ X).ncard + Nat.card {i : Fin k // μ i ∈ D}) :=
          Finset.sum_le_sum (fun D _ => by have := pt D; omega)
      _ = ∑ D ∈ 𝒟, (D ∩ I).ncard + ∑ D ∈ 𝒟, (D ∩ X).ncard +
            ∑ D ∈ 𝒟, Nat.card {i : Fin k // μ i ∈ D} := by
          rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
      _ ≤ 2 * 𝒟.card := by omega
  by_contra hne
  push_neg at hne
  have h3 := Finset.card_nsmul_le_sum 𝒟
    (fun D => (D ∩ (I ∪ X)).ncard + Nat.card {i : Fin k // μ i ∈ D}) 3
    (fun D hD => hne D hD)
  rw [smul_eq_mul] at h3
  omega

theorem wcpa_dj_lus_cvs_closed_point_unique_specialization : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : ValuationSubring K) (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)), IsProper v → ∀ n : ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))), IsClosed {n} → ∀ y y' : Y, v y = IsLocalRing.closedPoint ↥R → v y' = IsLocalRing.closedPoint ↥R → Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) n ⤳ y → Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) n ⤳ y' → y = y' :=
by
  intro K _ _ R Y v hv n hn y y' hy hy' h1 h2
  haveI := hv
  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]

  have hrat : ∀ (X : Scheme.{u}) (f : X ⟶ Spec (.of K)) [LocallyOfFiniteType f] (x : X),
      ∃ x₁ : Spec (.of K) ⟶ X, x₁ ≫ f = 𝟙 _ ∧ x ⤳ x₁ (IsLocalRing.closedPoint K) := by
    intro X f _ x
    haveI : JacobsonSpace X := LocallyOfFiniteType.jacobsonSpace f
    have hZ : IsClosed (closure ({x} : Set X)) := isClosed_closure
    have hxZ : x ∈ closure ({x} : Set X) := subset_closure rfl
    have hc := JacobsonSpace.closure_inter_closedPoints hZ
    have hne : (closure ({x} : Set X) ∩ closedPoints X).Nonempty := by
      rw [← closure_nonempty_iff, hc]; exact ⟨x, hxZ⟩
    obtain ⟨y, hyZ, hyc⟩ := hne
    have hy : IsClosed ({y} : Set X) := mem_closedPoints_iff.mp hyc
    have hxy : x ⤳ y := specializes_iff_mem_closure.mpr hyZ
    haveI : LocallyOfFiniteType (X.fromSpecResidueField y) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hy
    obtain ⟨g, hg⟩ : ∃ g, g = X.fromSpecResidueField y ≫ f := ⟨_, rfl⟩
    haveI : LocallyOfFiniteType g := by rw [hg]; infer_instance
    let φ : CommRingCat.of K ⟶ X.residueField y := (Spec.fullyFaithful.preimage g).unop
    have hφ : Spec.map φ = g := Spec.map_preimage_unop g
    have hlft : LocallyOfFiniteType (Spec.map φ) := by rw [hφ]; infer_instance
    have hft : φ.hom.FiniteType :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp hlft
    letI : Algebra K (X.residueField y) := φ.hom.toAlgebra
    haveI : Algebra.FiniteType K (X.residueField y) := hft
    haveI hmf : Module.Finite K (X.residueField y) :=
      finite_of_finite_type_of_isJacobsonRing K (X.residueField y)
    have hfin : φ.hom.Finite := hmf
    have hint : φ.hom.IsIntegral := RingHom.IsIntegral.of_finite hfin
    have hbij : Function.Bijective φ.hom := IsAlgClosed.ringHom_bijective_of_isIntegral φ.hom hint
    let e : K ≃+* X.residueField y := RingEquiv.ofBijective φ.hom hbij
    let ψ : X.residueField y ⟶ CommRingCat.of K := CommRingCat.ofHom e.symm.toRingHom
    refine ⟨Spec.map ψ ≫ X.fromSpecResidueField y, ?_, ?_⟩
    · rw [Category.assoc, ← hg, ← hφ, ← Spec.map_comp]
      have h1 : φ ≫ ψ = 𝟙 _ := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro a
        show e.symm (φ.hom a) = a
        exact e.symm_apply_apply a
      rw [h1, Spec.map_id]
    · have hpt : ∀ z : Spec (X.residueField y), X.fromSpecResidueField y z = y :=
        fun z => Scheme.fromSpecResidueField_apply y z
      convert hxy using 1
      exact hpt _
  have hLFT : LocallyOfFiniteType
      (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) :=
    MorphismProperty.of_isPullback (P := @LocallyOfFiniteType)
      (IsPullback.of_hasPullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))))
      (inferInstance : LocallyOfFiniteType v)
  obtain ⟨x₁, hx₁, hsp⟩ := @hrat _
    (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) hLFT n
  obtain ⟨q, hq⟩ : ∃ q : ↥(Spec (.of K)), x₁ q = n :=
    ⟨_, Set.mem_singleton_iff.mp (hsp.mem_closed hn (Set.mem_singleton n))⟩

  have hsq : CommSq (x₁ ≫ Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))))
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) v (𝟙 _) := ⟨by
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hx₁, Category.id_comp,
      Category.comp_id]⟩
  have hVC : ValuativeCriterion v := by
    have h := hv
    rw [IsProper.eq_valuativeCriterion] at h
    exact h.1.1.1
  let S : ValuativeCommSq v :=
    { R := ↥R, K := K,
      i₁ := x₁ ≫ Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))),
      i₂ := 𝟙 _, commSq := hsq }
  obtain ⟨hU⟩ := hVC S
  obtain ⟨ρ', hfl, hfr⟩ := (default : S.commSq.LiftStruct)
  obtain ⟨ρ, hρ⟩ : ∃ ρ : Spec (.of ↥R) ⟶ Y, ρ = ρ' := ⟨ρ', rfl⟩
  have hfl' : Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) ≫ ρ =
      x₁ ≫ Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) := by
    rw [hρ]; exact hfl
  have hfr' : ρ ≫ v = 𝟙 _ := by rw [hρ]; exact hfr

  haveI : IsClosedImmersion (ρ ≫ v) := by rw [hfr']; infer_instance
  haveI : IsClosedImmersion ρ := IsClosedImmersion.of_comp ρ v
  have hcl : IsClosed (Set.range ρ) := ρ.isClosedEmbedding.isClosed_range

  have hmem : Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) n ∈
      Set.range ρ := by
    refine ⟨Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) q, ?_⟩
    rw [pt hfl' q, ← hq]
    exact (pt rfl q).symm

  have key : ∀ z : Y, v z = IsLocalRing.closedPoint ↥R →
      Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) n ⤳ z →
      z = ρ (IsLocalRing.closedPoint ↥R) := by
    intro z hz hsz
    obtain ⟨p, hp⟩ := hsz.mem_closed hcl hmem
    have hvp : v (ρ p) = p := by rw [pt hfr' p]; rfl
    rw [← hp] at hz ⊢
    rw [hvp] at hz
    rw [hz]
  rw [key y hy h1, key y' hy' h2]

theorem wcpa_dj_lus_tbw_chart_stalk_ring : ∀ (S : Type u) [CommRing S] (Y : Scheme.{u}) (v : Y ⟶ Spec (.of S)) (y : Y) (U : Scheme.{u}) (e : U ⟶ Y) (N : Type u) [CommRing N] [Algebra S N] (m : U ⟶ Spec (.of N)) (x' : U), Etale e → Etale m → m ≫ Spec.map (CommRingCat.ofHom (algebraMap S N)) = e ≫ v → e x' = y → ∃ (T : Type u) (_ : CommRing T) (_ : Algebra N T) (_ : Algebra.Etale N T) (q : Ideal T) (_ : q.IsPrime) (ψ : Y.presheaf.stalk y →+* Localization.AtPrime q), ψ.Flat ∧ IsLocalHom ψ ∧ ψ.comp ((Scheme.ΓSpecIso (.of S)).inv ≫ v.appTop ≫ Y.presheaf.germ ⊤ y trivial).hom = (algebraMap T (Localization.AtPrime q)).comp ((algebraMap N T).comp (algebraMap S N)) ∧ ∀ n : N, n ∈ (m x').asIdeal → algebraMap N T n ∈ q :=
by
  intro S _ Y v y U e N _ _ m x' he hm hcomm hex
  subst hex
  classical
  obtain ⟨V, hV, hx', -⟩ := exists_isAffineOpen_mem_and_subset (x := x') (U := ⊤) trivial
  have hle : V ≤ m ⁻¹ᵁ ⊤ := by simp
  set τ : N →+* Γ(U, V) := ((Scheme.ΓSpecIso (.of N)).inv ≫ m.appLE ⊤ V hle).hom with hτdef

  have hτ : τ.Etale := by
    have h1 : (m.appLE ⊤ V hle).hom.Etale :=
      HasRingHomProperty.appLE @Etale m hm ⟨⊤, isAffineOpen_top _⟩ ⟨V, hV⟩ hle
    have h2 : (Scheme.ΓSpecIso (.of N)).inv.hom.Etale :=
      RingHom.Etale.of_bijective (Scheme.ΓSpecIso (.of N)).symm.commRingCatIsoToRingEquiv.bijective
    rw [hτdef, CommRingCat.hom_comp]
    exact RingHom.Etale.stableUnderComposition _ _ h2 h1
  set P := hV.primeIdealOf ⟨x', hx'⟩ with hP

  have hcomap : (m x').asIdeal = Ideal.comap τ P.asIdeal := by
    have h1 := IsAffineOpen.SpecMap_appLE_fromSpec m (isAffineOpen_top (Spec (.of N))) hV hle
    let P' : ↥(Spec Γ(U, V)) := hV.primeIdealOf ⟨x', hx'⟩
    have h2 := congrArg (fun f : Spec Γ(U, V) ⟶ Spec (.of N) => f P') h1
    simp only [Scheme.Hom.comp_apply] at h2
    have h3 : hV.fromSpec P' = x' := IsAffineOpen.fromSpec_primeIdealOf hV ⟨x', hx'⟩
    rw [h3, IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv] at h2
    rw [← h2]
    rfl

  letI : Algebra Γ(U, V) (U.presheaf.stalk x') :=
    TopCat.Presheaf.algebra_section_stalk U.presheaf ⟨x', hx'⟩
  haveI := hV.isLocalization_stalk ⟨x', hx'⟩
  let j0 := IsLocalization.algEquiv P.asIdeal.primeCompl (U.presheaf.stalk x')
    (Localization.AtPrime P.asIdeal)
  have hj : ∀ t : Γ(U, V), j0 ((U.presheaf.germ V x' hx').hom t) =
      algebraMap Γ(U, V) (Localization.AtPrime P.asIdeal) t := fun t => j0.commutes t

  have hR : m.appLE ⊤ V hle ≫ U.presheaf.germ V x' hx' =
      m.appTop ≫ U.presheaf.germ ⊤ x' trivial := by
    rw [Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
    rfl
  have hL : Y.presheaf.germ ⊤ (e x') trivial ≫ e.stalkMap x' =
      e.appTop ≫ U.presheaf.germ ⊤ x' trivial :=
    Scheme.Hom.germ_stalkMap e ⊤ x' trivial
  have hC : (Scheme.ΓSpecIso (.of S)).inv ≫ v.appTop ≫ e.appTop =
      CommRingCat.ofHom (algebraMap S N) ≫ (Scheme.ΓSpecIso (.of N)).inv ≫ m.appTop := by
    rw [← Scheme.Hom.comp_appTop, ← hcomm, Scheme.Hom.comp_appTop, ← Category.assoc,
      ← Scheme.ΓSpecIso_inv_naturality, Category.assoc]
  have hcat : (Scheme.ΓSpecIso (.of S)).inv ≫ v.appTop ≫ Y.presheaf.germ ⊤ (e x') trivial ≫
      e.stalkMap x' = CommRingCat.ofHom (algebraMap S N) ≫ (Scheme.ΓSpecIso (.of N)).inv ≫
      m.appLE ⊤ V hle ≫ U.presheaf.germ V x' hx' := by
    rw [hL, hR]
    have := congrArg (· ≫ U.presheaf.germ ⊤ x' trivial) hC
    simpa only [Category.assoc] using this
  letI : Algebra N Γ(U, V) := τ.toAlgebra
  haveI : Algebra.Etale N Γ(U, V) := RingHom.Etale.toAlgebra hτ
  refine ⟨Γ(U, V), inferInstance, inferInstance, inferInstance, P.asIdeal, P.isPrime,
    (j0.toRingEquiv : U.presheaf.stalk x' →+* Localization.AtPrime P.asIdeal).comp
      (e.stalkMap x').hom, ?_, ?_, ?_, ?_⟩
  · exact RingHom.Flat.comp (Flat.stalkMap e x') (RingHom.Flat.of_bijective j0.bijective)
  · infer_instance
  · ext s
    exact (congrArg j0 (RingHom.congr_fun (congrArg CommRingCat.Hom.hom hcat) s)).trans (hj _)
  · intro n hn
    rw [hcomap] at hn
    exact hn

theorem wcpa_dj_lus_tbw_etale_loc_quot_prime : ∀ (N T : Type u) [CommRing N] [CommRing T] [Algebra N T] [Algebra.Etale N T] (q : Ideal T) [q.IsPrime] (f : N) (D : Type u) [CommRing D] [IsDomain D] [IsIntegrallyClosed D] (π : N →+* D), Function.Surjective π → RingHom.ker π = Ideal.span {f} → algebraMap N T f ∈ q → (Ideal.span {algebraMap T (Localization.AtPrime q) (algebraMap N T f)}).IsPrime :=
by
  have wc_ring_etale_localization_isDomain : ∀ (R T : Type u) [CommRing R] [IsDomain R]
      [IsIntegrallyClosed R] [CommRing T] [Algebra R T] [Algebra.Etale R T] (q : Ideal T)
      [q.IsPrime], IsDomain (Localization.AtPrime q) := by
    intro R T _ _ _ _ _ _ q _
    classical
    have s2 : ∀ (K A : Type u) [Field K] [CommRing A] [Algebra K A] [Algebra.Etale K A] (a b : A),
        a * b = 0 → ∃ ε : A, IsIdempotentElem ε ∧ ε * b = 0 ∧ (1 - ε) * a = 0 := by
      intro K A _ _ _ _ a b hab
      obtain ⟨I, _, Ai, hF, hA, e, -⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K A).mp inferInstance
      have hab' : ∀ i, e a i * e b i = 0 := by
        intro i
        have h := congrFun (congrArg e hab) i
        rw [map_mul, map_zero] at h
        exact h
      let ε' : (i : I) → Ai i := fun i => if e a i = 0 then 0 else 1
      have hε' : IsIdempotentElem ε' := by
        show ε' * ε' = ε'
        funext i
        simp only [Pi.mul_apply, ε']
        split_ifs <;> simp
      refine ⟨e.symm ε', hε'.map e.symm, ?_, ?_⟩
      · apply e.injective
        rw [map_mul, AlgEquiv.apply_symm_apply, map_zero]
        funext i
        simp only [Pi.mul_apply, Pi.zero_apply, ε']
        split_ifs with h
        · simp
        · rw [one_mul]
          exact (mul_eq_zero.mp (hab' i)).resolve_left h
      · apply e.injective
        rw [map_mul, map_sub, map_one, AlgEquiv.apply_symm_apply, map_zero]
        funext i
        simp only [Pi.mul_apply, Pi.sub_apply, Pi.one_apply, Pi.zero_apply, ε']
        split_ifs with h
        · rw [h, mul_zero]
        · simp
    let K := FractionRing R
    let S := TensorProduct R T K
    let j : T →ₐ[R] S := Algebra.TensorProduct.includeLeft
    have hj : ∀ t : T, j t = TensorProduct.tmul R t (1 : K) := fun t => rfl
    have hjinj : Function.Injective j :=
      Algebra.TensorProduct.includeLeft_injective (R := R) (S := R) (A := T) (B := K)
        (IsFractionRing.injective R K)
    have hsep : ∀ a b : S, a * b = 0 →
        ∃ ε : S, IsIdempotentElem ε ∧ ε * b = 0 ∧ (1 - ε) * a = 0 := by
      intro a b hab
      let c : S ≃ₐ[R] TensorProduct R K T := Algebra.TensorProduct.comm R T K
      obtain ⟨ε', hε', h1, h2⟩ := s2 K (TensorProduct R K T) (c a) (c b)
        (by rw [← map_mul, hab, map_zero])
      refine ⟨c.symm ε', hε'.map c.symm, ?_, ?_⟩
      · apply c.injective
        rw [map_mul, AlgEquiv.apply_symm_apply, map_zero]
        exact h1
      · apply c.injective
        rw [map_mul, map_sub, map_one, AlgEquiv.apply_symm_apply, map_zero]
        exact h2
    have hlift : ∀ ε : S, IsIdempotentElem ε → ∃ e : T, j e = ε := by
      intro ε hε
      have hint : IsIntegral T ε := by
        refine ⟨Polynomial.X ^ 2 - Polynomial.X,
          Polynomial.monic_X_pow_sub (Polynomial.degree_X_le.trans_lt (by norm_num)), ?_⟩
        rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_X, pow_two, hε.eq,
          sub_self]
      obtain ⟨w, hw⟩ := (TensorProduct.toIntegralClosure_bijective_of_smooth (R := R) (S := T)
        (B := K)).2 ⟨ε, (mem_integralClosure_iff T S).mpr hint⟩
      have hw' := congrArg Subtype.val hw
      simp only at hw'
      have key : ∀ w' : TensorProduct R T (integralClosure R K),
          ∃ t : T, ((TensorProduct.toIntegralClosure R T K w' : integralClosure T S) : S) = j t := by
        intro w'
        induction w' using TensorProduct.induction_on with
        | zero => exact ⟨0, by rw [map_zero, map_zero]; rfl⟩
        | tmul t c =>
          have hc : (c : K) ∈ (⊥ : Subalgebra R K) := by
            rw [← IsIntegrallyClosed.integralClosure_eq_bot R K]; exact c.2
          obtain ⟨r, hr⟩ := Algebra.mem_bot.mp hc
          refine ⟨r • t, ?_⟩
          rw [hj]
          change TensorProduct.tmul R t (c : K) = _
          rw [TensorProduct.smul_tmul, ← hr, Algebra.algebraMap_eq_smul_one]
        | add x y hx hy =>
          obtain ⟨t₁, h₁⟩ := hx
          obtain ⟨t₂, h₂⟩ := hy
          exact ⟨t₁ + t₂, by rw [map_add, Subalgebra.coe_add, h₁, h₂, map_add]⟩
      obtain ⟨t, ht⟩ := key w
      exact ⟨t, ht.symm.trans hw'⟩
    have hnzd : NoZeroDivisors (Localization.AtPrime q) := by
      refine ⟨fun {x y} hxy => ?_⟩
      obtain ⟨⟨s, u⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl x
      obtain ⟨⟨s', u'⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl y
      dsimp only at hxy ⊢
      rw [← IsLocalization.mk'_mul] at hxy
      obtain ⟨m, hm⟩ := (IsLocalization.mk'_eq_zero_iff _ _).mp hxy
      obtain ⟨ε, hε, h1, h2⟩ := hsep (j ((m : T) * s)) (j s')
        (by rw [← map_mul, mul_assoc, hm, map_zero])
      obtain ⟨e, rfl⟩ := hlift ε hε
      have he1 : e * s' = 0 := hjinj (by rw [map_mul, h1, map_zero])
      have he2 : (1 - e) * ((m : T) * s) = 0 :=
        hjinj (by rw [map_mul, map_sub, map_one, h2, map_zero])
      have he3 : e * e = e := hjinj (by rw [map_mul]; exact hε.eq)
      set π := algebraMap T (Localization.AtPrime q) with hπ
      have hē : π e * π e = π e := by rw [← map_mul, he3]
      rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (π e) with hu | hu
      · right
        have h1' : π e = 1 := hu.mul_left_cancel (by rw [hē, mul_one])
        have hs' : π s' = 0 := by
          have := congrArg π he1
          rwa [map_mul, h1', one_mul, map_zero] at this
        rw [IsLocalization.mk'_eq_mul_mk'_one, hs', zero_mul]
      · left
        have h0 : π e = 0 := (hu.mul_right_eq_zero).mp (by rw [sub_mul, one_mul, hē, sub_self])
        have hs : π s = 0 := by
          have := congrArg π he2
          rw [map_mul, map_sub, map_one, h0, sub_zero, one_mul, map_mul, map_zero] at this
          exact ((IsLocalization.map_units (Localization.AtPrime q) m).mul_right_eq_zero).mp this
        rw [IsLocalization.mk'_eq_mul_mk'_one, hs, zero_mul]
    exact NoZeroDivisors.to_isDomain _
  intro N T _ _ _ _ q _ f D _ _ _ π hπ hker hf
  set I : Ideal N := RingHom.ker π with hI
  set J : Ideal T := I.map (algebraMap N T) with hJ
  have hJspan : J = Ideal.span {algebraMap N T f} := by
    rw [hJ, hker, Ideal.map_span, Set.image_singleton]
  have hJq : J ≤ q := by
    rw [hJspan, Ideal.span_singleton_le_iff_mem]; exact hf
  let e : N ⧸ I ≃+* D := RingHom.quotientKerEquivOfSurjective hπ
  haveI : IsDomain (N ⧸ I) := MulEquiv.isDomain D e.toMulEquiv
  haveI : IsIntegrallyClosed (N ⧸ I) := IsIntegrallyClosed.of_equiv e.symm

  haveI hEt : Algebra.Etale (N ⧸ I) (T ⧸ J) := by
    haveI : Algebra.Etale (N ⧸ I) (TensorProduct N (N ⧸ I) T) := inferInstance
    let e₁ := Algebra.TensorProduct.comm N (N ⧸ I) T
    let e₂ := Algebra.TensorProduct.quotIdealMapEquivTensorQuot T I
    let eR : TensorProduct N (N ⧸ I) T ≃+* T ⧸ J := e₁.toRingEquiv.trans e₂.symm.toRingEquiv
    let eA : TensorProduct N (N ⧸ I) T ≃ₐ[N ⧸ I] T ⧸ J := AlgEquiv.ofRingEquiv (f := eR) (by
      intro x
      obtain ⟨n, rfl⟩ := Ideal.Quotient.mk_surjective x
      show e₂.symm (e₁ (algebraMap (N ⧸ I) (TensorProduct N (N ⧸ I) T) (Ideal.Quotient.mk I n))) = _
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
        Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul,
        Ideal.Quotient.algebraMap_quotient_map_quotient, Algebra.smul_def, mul_one]
      rfl)
    exact Algebra.Etale.of_equiv eA
  set q' : Ideal (T ⧸ J) := q.map (Ideal.Quotient.mk J) with hq'
  haveI hq'p : q'.IsPrime := Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
    (by rw [Ideal.mk_ker]; exact hJq)
  have hcomap : q'.comap (Ideal.Quotient.mk J) = q := by
    rw [hq', Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
    exact sup_eq_left.mpr hJq
  haveI hdom : IsDomain (Localization.AtPrime q') :=
    wc_ring_etale_localization_isDomain (N ⧸ I) (T ⧸ J) q'
  have hT : Submonoid.map (Ideal.Quotient.mk J) q.primeCompl = q'.primeCompl := by
    ext y
    simp only [Submonoid.mem_map, Ideal.mem_primeCompl_iff]
    constructor
    · rintro ⟨x, hx, rfl⟩ hy
      apply hx
      rw [← hcomap]; exact hy
    · intro hy
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      refine ⟨x, ?_, rfl⟩
      intro hx
      apply hy
      rw [← hcomap] at hx
      exact hx
  have hk := IsLocalization.ker_map (S := Localization.AtPrime q) (Localization.AtPrime q')
    (Ideal.Quotient.mk J) hT
  rw [Ideal.mk_ker] at hk
  have hmap : J.map (algebraMap T (Localization.AtPrime q)) =
      Ideal.span {algebraMap T (Localization.AtPrime q) (algebraMap N T f)} := by
    rw [hJspan, Ideal.map_span, Set.image_singleton]
  rw [← hmap, ← hk]
  exact RingHom.ker_isPrime _

theorem wcpa_dj_lus_tbw_nonsmooth_stalk_branches : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : ValuationSubring K), IsAlgClosed (IsLocalRing.ResidueField ↥R) → ∀ (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)), wcpaDjSemistable v → ∀ y : Y, v y = IsLocalRing.closedPoint ↥R → (¬ ∃ W : Y.Opens, y ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ v)) → ∀ P₁ ∈ minimalPrimes (Y.presheaf.stalk y), ∀ P₂ ∈ minimalPrimes (Y.presheaf.stalk y), P₁ ≠ P₂ → ∃ Q : Ideal (Y.presheaf.stalk y), Q.IsPrime ∧ P₁ ≤ Q ∧ P₂ ≤ Q ∧ Q.comap ((Scheme.ΓSpecIso (.of ↥R)).inv ≫ v.appTop ≫ Y.presheaf.germ ⊤ y trivial).hom = ⊥ :=
by
  intro K _ _ R hκ Y v hss y hy hns P₁ hP₁ P₂ hP₂ hne
  classical
  haveI : Flat v := hss.1
  haveI : IsProper v := hss.2.1
  have hlft : LocallyOfFiniteType v := inferInstance
  have hlfp := wcpa_dj_mn_flat_fp (Spec (.of ↥R)) Y v hss.1 hlft
  have hnd := wcpa_dj_nc_nonsmooth_fibre_node K R Y v y hκ hss hlfp hy hns
  obtain ⟨U, e, a, m, x', he, hm, hcomm, hex, hX0, hX1⟩ :=
    wcpa_dj_nc_chart_exists K R Y v y hκ hss.1 hlfp hy hnd
  obtain ⟨T, _, _, _, q, _, ψ, hψf, hψl, hψc, hmem⟩ :=
    wcpa_dj_lus_tbw_chart_stalk_ring ↥R Y v y U e (wcNcRing R a) m x' he hm hcomm hex
  have hX0' := hmem _ hX0
  have hX1' := hmem _ hX1
  letI : Algebra (Y.presheaf.stalk y) (Localization.AtPrime q) := ψ.toAlgebra
  haveI : Module.Flat (Y.presheaf.stalk y) (Localization.AtPrime q) := hψf
  haveI : IsLocalHom (algebraMap (Y.presheaf.stalk y) (Localization.AtPrime q)) := hψl
  haveI hff : Module.FaithfullyFlat (Y.presheaf.stalk y) (Localization.AtPrime q) :=
    Module.FaithfullyFlat.of_flat_of_isLocalHom
  rcases eq_or_ne a 0 with ha0 | ha
  ·
    have hx0 : (Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 0)) *
        (Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 1)) = 0 := by
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      apply Ideal.subset_span
      rw [Set.mem_singleton_iff, ha0, map_zero, sub_zero]
    obtain ⟨⟨π0, hπ0s, hπ0k⟩, ⟨π1, hπ1s, hπ1k⟩, ⟨ε, hε, hεk⟩⟩ :=
      wcpa_dj_lus_tbw_node_zero_quot_poly K R a ha0
    have hxp := wcpa_dj_lus_tbw_etale_loc_quot_prime (wcNcRing R a) T q _ (Polynomial ↥R) π0
      hπ0s hπ0k hX0'
    have hyp := wcpa_dj_lus_tbw_etale_loc_quot_prime (wcNcRing R a) T q _ (Polynomial ↥R) π1
      hπ1s hπ1k hX1'
    have htf := wcpa_dj_lus_tbw_node_zero_torsionfree ↥R (wcNcRing R a) T q _ _ ε hε hεk hX0' hX1'
    set x : Localization.AtPrime q := algebraMap T (Localization.AtPrime q)
      (@algebraMap (wcNcRing R a) T _ _ ‹Algebra (wcNcRing R a) T›
        (Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 0))) with hxdef
    set y' : Localization.AtPrime q := algebraMap T (Localization.AtPrime q)
      (@algebraMap (wcNcRing R a) T _ _ ‹Algebra (wcNcRing R a) T›
        (Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 1))) with hydef
    have hxy : x * y' = 0 := by
      rw [hxdef, hydef, ← map_mul, ← map_mul, hx0, map_zero, map_zero]

    have lift : ∀ P ∈ minimalPrimes (Y.presheaf.stalk y),
        P ≤ Ideal.comap ψ (Ideal.span {x, y'}) := by
      intro P hP
      haveI := hP.1.1
      obtain ⟨𝔓, h𝔓⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat
        (A := Y.presheaf.stalk y) (B := Localization.AtPrime q) ⟨P, hP.1.1⟩
      have h𝔓' : 𝔓.asIdeal.comap ψ = P := congrArg PrimeSpectrum.asIdeal h𝔓
      obtain ⟨P', hP', hP'le⟩ := Ideal.exists_minimalPrimes_le
        (I := (⊥ : Ideal (Localization.AtPrime q))) (J := 𝔓.asIdeal) bot_le
      haveI := hP'.1.1
      have hle1 : P'.comap ψ ≤ P := by
        rw [← h𝔓']; exact Ideal.comap_mono hP'le
      have hcomap : P'.comap ψ = P :=
        le_antisymm hle1 (hP.2 ⟨inferInstance, bot_le⟩ hle1)
      have h0 : x * y' ∈ P' := by rw [hxy]; exact P'.zero_mem
      have hP'le2 : P' ≤ Ideal.span {x, y'} := by
        rcases hP'.1.1.mem_or_mem h0 with h | h
        · have h1 : Ideal.span {x} ≤ P' := (Ideal.span_singleton_le_iff_mem _).mpr h
          have h2 : P' ≤ Ideal.span {x} := hP'.2 ⟨hxp, bot_le⟩ h1
          exact h2.trans (Ideal.span_mono (by simp))
        · have h1 : Ideal.span {y'} ≤ P' := (Ideal.span_singleton_le_iff_mem _).mpr h
          have h2 : P' ≤ Ideal.span {y'} := hP'.2 ⟨hyp, bot_le⟩ h1
          exact h2.trans (Ideal.span_mono (by simp))
      rw [← hcomap]; exact Ideal.comap_mono hP'le2

    obtain ⟨Q', hQ', hQ'le, hQ'dis⟩ := Ideal.exists_le_prime_disjoint (Ideal.span {x, y'})
      ((nonZeroDivisors ↥R).map (ψ.comp ((Scheme.ΓSpecIso (.of ↥R)).inv ≫ v.appTop ≫
        Y.presheaf.germ ⊤ y trivial).hom)) (by
        rw [Set.disjoint_left]
        intro s hs hsM
        obtain ⟨r, hr, hrs⟩ := Submonoid.mem_map.mp hsM
        subst hrs
        have hc := RingHom.congr_fun hψc r
        rw [hc] at hs
        exact htf r (nonZeroDivisors.ne_zero hr) hs)
    haveI := hQ'
    refine ⟨Q'.comap ψ, inferInstance, (lift P₁ hP₁).trans (Ideal.comap_mono hQ'le),
      (lift P₂ hP₂).trans (Ideal.comap_mono hQ'le), ?_⟩
    rw [Ideal.comap_comap, eq_bot_iff]
    intro r hr
    rw [Ideal.mem_bot]
    by_contra hr0
    exact Set.disjoint_left.mp hQ'dis hr
      (Submonoid.mem_map.mpr ⟨r, mem_nonZeroDivisors_of_ne_zero hr0, rfl⟩)
  ·
    obtain ⟨hd, hi⟩ := wcpa_dj_lus_tbw_node_ring_normal K R a ha
    haveI := hd
    haveI := hi
    haveI hB : IsDomain (Localization.AtPrime q) :=
      wc_ring_etale_localization_isDomain (wcNcRing R a) T q
    have hinj : Function.Injective ψ :=
      FaithfulSMul.algebraMap_injective (Y.presheaf.stalk y) (Localization.AtPrime q)
    haveI : IsDomain (Y.presheaf.stalk y) := Function.Injective.isDomain ψ hinj
    have hbot : ∀ P ∈ minimalPrimes (Y.presheaf.stalk y), P = ⊥ := fun P hP =>
      le_antisymm (hP.2 ⟨(inferInstance : (⊥ : Ideal (Y.presheaf.stalk y)).IsPrime), bot_le⟩
        bot_le) bot_le
    exact absurd ((hbot _ hP₁).trans (hbot _ hP₂).symm) hne

theorem wcpa_dj_lus_cvs_two_branch_witness : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : ValuationSubring K), IsAlgClosed (IsLocalRing.ResidueField ↥R) → ∀ (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)), wcpaDjSemistable v → ∀ E₁ ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))), ∀ E₂ ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))), E₁ ≠ E₂ → ∀ y : Y, v y = IsLocalRing.closedPoint ↥R → y ∈ closure ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) '' E₁) → y ∈ closure ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) '' E₂) → ∃ n ∈ E₁ ∩ E₂, Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) n ⤳ y :=
by
  intro K _ _ R hκ Y v hss
  classical
  obtain ⟨_, ⟨hKemb, hKrange⟩, _, _⟩ := wcpa_dj_lus_cvs_fibre_topology K R Y v hss
  set j := Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) with hj
  set fK := Limits.pullback.fst v j with hfK
  intro E₁ hE₁ E₂ hE₂ hne y hy h1 h2
  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]

  have hιemb : Topology.IsEmbedding (Y.fromSpecStalk y) := IsPreimmersion.isEmbedding _
  have hιrange : Set.range (Y.fromSpecStalk y) = {ξ | ξ ⤳ y} := Scheme.range_fromSpecStalk
  have hιv : Y.fromSpecStalk y ≫ v = Spec.map ((Scheme.ΓSpecIso (.of ↥R)).inv ≫ v.appTop ≫
      Y.presheaf.germ ⊤ y trivial) := by
    apply ext_of_isAffine
    rw [← cancel_mono (Scheme.ΓSpecIso _).hom, Scheme.ΓSpecIso_naturality, Scheme.Hom.comp_appTop,
      Scheme.fromSpecStalk_appTop]
    simp
  set η := genericPoint (Spec (.of ↥R)) with hη
  have hηall : ∀ t : ↥(Spec (.of ↥R)), η ⤳ t := fun t => genericPoint_specializes t
  have hηmin : ∀ t : ↥(Spec (.of ↥R)), t ⤳ η → t = η := fun t h => (h.antisymm (hηall t)).eq
  have hvK : ∀ x, v (fK x) = η := by
    intro x
    have h1 : fK x ∈ Set.range fK := ⟨x, rfl⟩
    rw [hKrange] at h1
    exact h1

  have gen : ∀ E ∈ irreducibleComponents ↥(Limits.pullback v j), y ∈ closure (fK '' E) →
      ∃ z, closure {z} = E ∧ ∃ P : PrimeSpectrum (Y.presheaf.stalk y),
        Y.fromSpecStalk y P = fK z ∧ P.asIdeal ∈ minimalPrimes (Y.presheaf.stalk y) := by
    intro E hE hyE
    have hEcl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
    obtain ⟨z, hzE⟩ : ∃ z, closure {z} = E := by
      refine ⟨hE.1.genericPoint, ?_⟩
      have h1 := hE.1.isGenericPoint_genericPoint_closure
      rw [hEcl.closure_eq] at h1
      exact h1
    have hclE : closure (fK '' E) ⊆ closure {fK z} := by
      apply closure_minimal _ isClosed_closure
      rintro _ ⟨w, hw, rfl⟩
      rw [← hzE] at hw
      have h1 : z ⤳ w := specializes_iff_mem_closure.mpr hw
      exact specializes_iff_mem_closure.mp (h1.map fK.continuous)
    have hzy : fK z ⤳ y := specializes_iff_mem_closure.mpr (hclE hyE)
    have hmem : fK z ∈ Set.range (Y.fromSpecStalk y) := by rw [hιrange]; exact hzy
    obtain ⟨P, hP⟩ : ∃ P : PrimeSpectrum (Y.presheaf.stalk y), Y.fromSpecStalk y P = fK z := hmem
    refine ⟨z, hzE, P, hP, ?_⟩
    show Minimal (fun q : Ideal (Y.presheaf.stalk y) => q.IsPrime ∧ ⊥ ≤ q) P.asIdeal
    refine ⟨⟨P.isPrime, bot_le⟩, ?_⟩
    rintro J ⟨hJ, -⟩ hJP
    let Q' : PrimeSpectrum (Y.presheaf.stalk y) := ⟨J, hJ⟩
    have hQ'P : Q' ⤳ P := (PrimeSpectrum.le_iff_specializes Q' P).mp hJP
    have h1 : Y.fromSpecStalk y Q' ⤳ fK z := by
      rw [← hP]; exact hQ'P.map (Y.fromSpecStalk y).continuous
    have h2 : v (Y.fromSpecStalk y Q') = η := by
      apply hηmin
      have h3 := h1.map v.continuous
      rwa [hvK z] at h3
    obtain ⟨w, hw⟩ : Y.fromSpecStalk y Q' ∈ Set.range fK := by rw [hKrange]; exact h2
    have hwz : w ⤳ z := hKemb.toIsInducing.specializes_iff.mp (by rw [hw]; exact h1)
    have hcl : closure {w} ⊆ E := by
      have hsub : E ⊆ closure {w} := by
        rw [← hzE]; exact specializes_iff_closure_subset.mp hwz
      exact hE.2 isIrreducible_singleton.closure hsub
    have hzw : z ⤳ w := specializes_iff_mem_closure.mpr
      (by rw [hzE]; exact hcl (subset_closure (Set.mem_singleton w)))
    have h3 : Y.fromSpecStalk y P ⤳ Y.fromSpecStalk y Q' := by
      rw [hP, ← hw]; exact hzw.map fK.continuous
    have h4 : P ⤳ Q' := hιemb.toIsInducing.specializes_iff.mp h3
    exact (PrimeSpectrum.le_iff_specializes P Q').mpr h4
  obtain ⟨z₁, hz₁, P₁, hP₁, hm₁⟩ := gen E₁ hE₁ h1
  obtain ⟨z₂, hz₂, P₂, hP₂, hm₂⟩ := gen E₂ hE₂ h2
  have hP12 : P₁.asIdeal ≠ P₂.asIdeal := by
    intro h
    have hPP : P₁ = P₂ := PrimeSpectrum.ext h
    apply hne
    have h3 : fK z₁ = fK z₂ := by rw [← hP₁, ← hP₂, hPP]
    rw [← hz₁, ← hz₂, hKemb.injective h3]
  by_cases hsm : ∃ W : Y.Opens, y ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ v)
  ·
    exfalso
    obtain ⟨W, hW, hWsm⟩ := hsm
    haveI := hWsm
    haveI hdomW := wcpa_dj_lus_cvs_smooth_valuation_stalk_domain K R W.toScheme (W.ι ≫ v)
      (⟨y, hW⟩ : W)
    haveI hdom : IsDomain (Y.presheaf.stalk y) :=
      MulEquiv.isDomain _ (W.stalkIso (⟨y, hW⟩ : W)).symm.commRingCatIsoToRingEquiv.toMulEquiv
    have hbot : ∀ P ∈ minimalPrimes (Y.presheaf.stalk y), P = ⊥ := fun P hP =>
      le_antisymm (hP.2 ⟨(inferInstance : (⊥ : Ideal (Y.presheaf.stalk y)).IsPrime), bot_le⟩
        bot_le) bot_le
    exact hP12 ((hbot _ hm₁).trans (hbot _ hm₂).symm)
  ·
    obtain ⟨Q, hQ, hQ1, hQ2, hQc⟩ := wcpa_dj_lus_tbw_nonsmooth_stalk_branches K R hκ Y v hss y hy
      hsm P₁.asIdeal hm₁ P₂.asIdeal hm₂ hP12
    let ζQ : PrimeSpectrum (Y.presheaf.stalk y) := ⟨Q, hQ⟩
    have hvζ : v (Y.fromSpecStalk y ζQ) = η := by
      apply hηmin
      rw [pt hιv ζQ]
      apply (PrimeSpectrum.le_iff_specializes _ _).mp
      show Ideal.comap ((Scheme.ΓSpecIso (.of ↥R)).inv ≫ v.appTop ≫
        Y.presheaf.germ ⊤ y trivial).hom Q ≤ _
      rw [hQc]; exact bot_le
    obtain ⟨n, hn⟩ : Y.fromSpecStalk y ζQ ∈ Set.range fK := by rw [hKrange]; exact hvζ
    have hspec : ∀ z (P : PrimeSpectrum (Y.presheaf.stalk y)), Y.fromSpecStalk y P = fK z →
        P.asIdeal ≤ Q → z ⤳ n := by
      intro z P hP hPQ
      have h3 : P ⤳ ζQ := (PrimeSpectrum.le_iff_specializes P ζQ).mp hPQ
      have h4 := h3.map (Y.fromSpecStalk y).continuous
      rw [hP, ← hn] at h4
      exact hKemb.toIsInducing.specializes_iff.mp h4
    refine ⟨n, ⟨?_, ?_⟩, ?_⟩
    · rw [← hz₁]; exact specializes_iff_mem_closure.mp (hspec z₁ P₁ hP₁ hQ1)
    · rw [← hz₂]; exact specializes_iff_mem_closure.mp (hspec z₂ P₂ hP₂ hQ2)
    · have h3 : Y.fromSpecStalk y ζQ ∈ Set.range (Y.fromSpecStalk y) := ⟨ζQ, rfl⟩
      rw [hιrange] at h3
      rw [hn]; exact h3

theorem wcpa_dj_lus_cfs_valuation_specialize : ∀ (K : Type u) [Field K] [IsAlgClosed K]
    (R : ValuationSubring K), IsAlgClosed (IsLocalRing.ResidueField ↥R) →
    ∀ (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)) (k : ℕ) (σ : Fin k → (Spec (.of ↥R) ⟶ Y)),
    wcpaDjSemistable v → wcpaDjSections v k σ →
    wcpaDjSolStab v k σ (IsLocalRing.ResidueField ↥R)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) →
    wcpaDjSolStab v k σ K (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) :=
by
  intro K _ _ R hκ Y v k σ hss hsec h₀
  classical
  unfold wcpaDjSolStab at h₀ ⊢
  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]
  obtain ⟨hE1, ⟨hKemb, hKrange⟩, ⟨h0emb, h0range⟩, hfin0⟩ :=
    wcpa_dj_lus_cvs_fibre_topology K R Y v hss
  have s2 := wcpa_dj_lus_cvs_closure_tree K R hκ Y v hss
  have s5 := wcpa_dj_lus_cvs_closed_fibre_component_mult K R hκ Y v hss
  have s10 := wcpa_dj_lus_cvs_closed_point_unique_specialization K R Y v hss.2.1
  have s11 := wcpa_dj_lus_cvs_two_branch_witness K R hκ Y v hss
  have hpb0 := IsPullback.of_hasPullback v
    (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))
  have hcondK := Limits.pullback.condition (f := v)
    (g := Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))
  set j := Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) with hj
  set c := Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))) with hc
  set fK := Limits.pullback.fst v j with hfK
  set f0 := Limits.pullback.fst v c with hf0
  set η := genericPoint (Spec (.of ↥R)) with hη
  set 𝔪 := IsLocalRing.closedPoint ↥R with h𝔪
  intro E hE hP1E
  have hηall : ∀ t : ↥(Spec (.of ↥R)), η ⤳ t := fun t => genericPoint_specializes t
  have hηmin : ∀ t : ↥(Spec (.of ↥R)), t ⤳ η → t = η := fun t h => (h.antisymm (hηall t)).eq
  obtain ⟨hS1, hS2, hS3⟩ := hsec
  have hvσ : ∀ i z, v (σ i z) = z := by
    intro i z
    rw [pt (hS1 i) z]
    rfl
  haveI := hss.1
  have hvgen : GeneralizingMap v := Flat.generalizingMap v
  have hv0 : ∀ y, v (f0 y) = 𝔪 := by
    intro y
    have h1 : f0 y ∈ Set.range f0 := ⟨y, rfl⟩
    rw [h0range] at h1
    exact h1
  have hvK : ∀ y, v (fK y) = η := by
    intro y
    have h1 : fK y ∈ Set.range fK := ⟨y, rfl⟩
    rw [hKrange] at h1
    exact h1
  have hf0inj : Function.Injective f0 := h0emb.toIsEmbedding.injective
  by_contra hlt
  push_neg at hlt
  obtain ⟨x0, hx0⟩ := hE.1.nonempty
  have hjη : ∀ p, j p = η := by
    intro p
    have h1 := pt hcondK x0
    rw [Scheme.Hom.comp_apply, hvK x0, Subsingleton.elim (Limits.pullback.snd v j x0) p] at h1
    exact h1.symm
  have hμex : ∀ i, ∃ m, f0 m = σ i 𝔪 := by
    intro i
    have h1 : σ i 𝔪 ∈ v ⁻¹' {𝔪} := hvσ i 𝔪
    rw [← h0range] at h1
    exact h1
  choose μ hμ using hμex
  obtain ⟨𝒟, _h𝒟ne, h𝒟, himg, hIfin, hIcard⟩ := s2 E hE hP1E
  have hEcl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
  obtain ⟨z, hzE⟩ : ∃ z, closure {z} = E := by
    refine ⟨hE.1.genericPoint, ?_⟩
    have h1 := hE.1.isGenericPoint_genericPoint_closure
    rw [hEcl.closure_eq] at h1
    exact h1
  have hclE : closure (fK '' E) ⊆ closure {fK z} := by
    apply closure_minimal _ isClosed_closure
    rintro _ ⟨w, hw, rfl⟩
    rw [← hzE] at hw
    have h1 : z ⤳ w := specializes_iff_mem_closure.mpr hw
    exact specializes_iff_mem_closure.mp (h1.map fK.continuous)

  have hmark : ∀ i, (∃ D ∈ 𝒟, μ i ∈ D) →
      ∃ x ∈ E, ∃ p : ↥(Spec (.of K)), fK x = σ i (j p) := by
    rintro i ⟨D, hD, hμD⟩
    have hy : σ i 𝔪 ∈ closure (fK '' E) := by
      have h1 : f0 (μ i) ∈ f0 '' (⋃ D ∈ 𝒟, D) := ⟨μ i, Set.mem_biUnion hD hμD, rfl⟩
      rw [himg, hμ i] at h1
      exact h1.1
    have hzy : fK z ⤳ σ i 𝔪 := specializes_iff_mem_closure.mpr (hclE hy)
    obtain ⟨W, hW, hWsm⟩ := hS3 i 𝔪
    haveI := hWsm
    haveI hdomW := wcpa_dj_lus_cvs_smooth_valuation_stalk_domain K R W.toScheme (W.ι ≫ v)
      (⟨σ i 𝔪, hW⟩ : W)
    haveI hdom : IsDomain (Y.presheaf.stalk (σ i 𝔪)) :=
      MulEquiv.isDomain _ (W.stalkIso (⟨σ i 𝔪, hW⟩ : W)).symm.commRingCatIsoToRingEquiv.toMulEquiv
    have hgen : ∀ y', y' ⤳ σ i 𝔪 →
        Y.fromSpecStalk (σ i 𝔪) (genericPoint _) ⤳ y' := by
      intro y' hy'
      have h1 : y' ∈ Set.range (Y.fromSpecStalk (σ i 𝔪)) := by
        rw [Scheme.range_fromSpecStalk]; exact hy'
      obtain ⟨q, rfl⟩ := h1
      exact (genericPoint_specializes q).map (Y.fromSpecStalk (σ i 𝔪)).continuous
    have hξz := hgen _ hzy
    have hvξ : v (Y.fromSpecStalk (σ i 𝔪) (genericPoint _)) = η := by
      apply hηmin
      have h1 := hξz.map v.continuous
      rwa [hvK z] at h1
    obtain ⟨z', hz'⟩ : Y.fromSpecStalk (σ i 𝔪) (genericPoint _) ∈ Set.range fK := by
      rw [hKrange]; exact hvξ
    have hz'z : z' ⤳ z := hKemb.toIsInducing.specializes_iff.mp (by rw [hz']; exact hξz)
    have hcl' : closure {z'} ⊆ E := by
      have hsub : E ⊆ closure {z'} := by
        rw [← hzE]
        exact specializes_iff_closure_subset.mp hz'z
      exact hE.2 isIrreducible_singleton.closure hsub
    have hsy : σ i η ⤳ σ i 𝔪 := (hηall 𝔪).map (σ i).continuous
    have hξs := hgen _ hsy
    obtain ⟨w, hw⟩ : σ i η ∈ Set.range fK := by
      rw [hKrange]; exact hvσ i η
    have hz'w : z' ⤳ w := hKemb.toIsInducing.specializes_iff.mp (by rw [hz', hw]; exact hξs)
    refine ⟨w, hcl' (specializes_iff_mem_closure.mp hz'w), Limits.pullback.snd v j x0, ?_⟩
    rw [hw, hjη]
  have hmarkle : Nat.card {i : Fin k // ∃ D ∈ 𝒟, μ i ∈ D} ≤
      Nat.card {i : Fin k // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)), fK x = σ i (j p)} :=
    Nat.card_le_card_of_injective (fun i => ⟨i.1, hmark i.1 i.2⟩)
      (fun a b h => Subtype.ext (congrArg Subtype.val h :))

  have hH2 : ∀ y, ∃ y' : ↥Y, v y' = η ∧ y' ⤳ f0 y := by
    intro y
    obtain ⟨x', hx', hvx'⟩ := hvgen (hηall (v (f0 y)))
    exact ⟨x', hvx', hx'⟩
  have hH3 : ∀ E₁ ∈ irreducibleComponents ↥(Limits.pullback v j),
      ∀ E₂ ∈ irreducibleComponents ↥(Limits.pullback v j), E₁ ≠ E₂ → ∀ y,
      f0 y ∈ closure (fK '' E₁) → f0 y ∈ closure (fK '' E₂) → ∃ n ∈ E₁ ∩ E₂, fK n ⤳ f0 y :=
    fun E₁ hE₁ E₂ hE₂ hne y h1 h2 => s11 E₁ hE₁ E₂ hE₂ hne (f0 y) (hv0 y) h1 h2
  have hH4 : ∀ n, IsClosed {n} → ∀ y y', fK n ⤳ f0 y → fK n ⤳ f0 y' → y = y' :=
    fun n hn y y' h1 h2 => hf0inj (s10 n hn (f0 y) (f0 y') (hv0 y) (hv0 y') h1 h2)
  obtain ⟨hExtfin, hExtle⟩ := wcpa_dj_lus_cvs_external_bound (⇑v) (⇑fK) (⇑f0) η 𝔪 v.continuous
    hKemb hKrange h0emb h0range hH2 hH3 hH4 E hE (hE1 E hE).1 (hE1 E hE).2 𝒟
    (fun D hD => (h𝒟 D hD).1) himg

  have hcompfin : ∀ x : ↥(Limits.pullback v c),
      {D | D ∈ irreducibleComponents ↥(Limits.pullback v c) ∧ x ∈ D}.Finite :=
    fun x => hfin0.subset (fun D hD => hD.1)
  have hsub𝒟 : ∀ x : ↥(Limits.pullback v c), {D | D ∈ 𝒟 ∧ x ∈ D} ⊆
      {D | D ∈ irreducibleComponents ↥(Limits.pullback v c) ∧ x ∈ D} :=
    fun x D hD => ⟨(h𝒟 D hD.1).1, hD.2⟩
  have hmI : ∀ x ∈ {x | ∃ D ∈ 𝒟, ∃ D' ∈ 𝒟, D ≠ D' ∧ x ∈ D ∧ x ∈ D'},
      {D | D ∈ 𝒟 ∧ x ∈ D}.ncard ≤ 2 :=
    fun x _ => (Set.ncard_le_ncard (hsub𝒟 x) (hcompfin x)).trans (s5 x).1
  have hmX : ∀ x ∈ {y | (∃ D ∈ 𝒟, y ∈ D) ∧ ∃ D' ∈ irreducibleComponents ↥(Limits.pullback v c),
      D' ∉ 𝒟 ∧ y ∈ D'}, {D | D ∈ 𝒟 ∧ x ∈ D}.ncard ≤ 1 := by
    rintro x ⟨_, D', hD', hD'𝒟, hxD'⟩
    have h1 : {D | D ∈ 𝒟 ∧ x ∈ D} ⊆
        {D | D ∈ irreducibleComponents ↥(Limits.pullback v c) ∧ x ∈ D} \ {D'} := by
      intro D hD
      refine ⟨hsub𝒟 x hD, ?_⟩
      intro h
      rw [Set.mem_singleton_iff] at h
      subst h
      exact hD'𝒟 hD.1
    have h2 := Set.ncard_diff_singleton_of_mem
      (show D' ∈ {D | D ∈ irreducibleComponents ↥(Limits.pullback v c) ∧ x ∈ D} from ⟨hD', hxD'⟩)
    have h3 := Set.ncard_le_ncard h1 ((hcompfin x).diff)
    have h4 := (s5 x).1
    omega
  have hmμ : ∀ i, {D | D ∈ 𝒟 ∧ μ i ∈ D}.ncard ≤ 1 := by
    intro i
    obtain ⟨W, hW, hWsm⟩ := hS3 i 𝔪
    have hsm : ∃ W0 : (Limits.pullback v c).Opens, μ i ∈ W0 ∧
        SmoothOfRelativeDimension 1 (W0.ι ≫ Limits.pullback.snd v c) := by
      refine ⟨f0 ⁻¹ᵁ W, ?_, ?_⟩
      · show f0 (μ i) ∈ W
        rw [hμ i]; exact hW
      · have h1 : IsPullback (f0 ∣_ W) (f0 ⁻¹ᵁ W).ι W.ι f0 := isPullback_morphismRestrict f0 W
        have h2 : IsPullback (f0 ∣_ W) ((f0 ⁻¹ᵁ W).ι ≫ Limits.pullback.snd v c) (W.ι ≫ v) c :=
          h1.paste_vert hpb0
        exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) h2 hWsm
    exact (Set.ncard_le_ncard (hsub𝒟 (μ i)) (hcompfin (μ i))).trans ((s5 (μ i)).2 hsm)
  have hsum : {y | (∃ D ∈ 𝒟, y ∈ D) ∧ ∃ D' ∈ irreducibleComponents ↥(Limits.pullback v c),
      D' ∉ 𝒟 ∧ y ∈ D'}.ncard + Nat.card {i : Fin k // ∃ D ∈ 𝒟, μ i ∈ D} ≤ 2 := by
    omega

  obtain ⟨D, hD, hDle⟩ := wcpa_dj_lus_cvs_tree_pigeonhole 𝒟 _ _ k μ hIfin hExtfin hIcard hmI hmX
    hmμ hsum

  have hDcl : D ∩ closure Dᶜ ⊆ D ∩ ({x | ∃ D ∈ 𝒟, ∃ D' ∈ 𝒟, D ≠ D' ∧ x ∈ D ∧ x ∈ D'} ∪
      {y | (∃ D ∈ 𝒟, y ∈ D) ∧ ∃ D' ∈ irreducibleComponents ↥(Limits.pullback v c),
        D' ∉ 𝒟 ∧ y ∈ D'}) := by
    rintro x ⟨hxD, hxcl⟩
    refine ⟨hxD, ?_⟩
    have hU : IsClosed (⋃ D' ∈ {D' | D' ∈ irreducibleComponents ↥(Limits.pullback v c) ∧ D' ≠ D},
        D') :=
      (hfin0.subset (fun D' hD' => hD'.1)).isClosed_biUnion
        (fun D' hD' => isClosed_of_mem_irreducibleComponents D' hD'.1)
    have hsubU : Dᶜ ⊆
        ⋃ D' ∈ {D' | D' ∈ irreducibleComponents ↥(Limits.pullback v c) ∧ D' ≠ D}, D' := by
      intro y hy
      obtain ⟨D'', hD'', hyD''⟩ :=
        exists_mem_irreducibleComponents_subset_of_isIrreducible {y} isIrreducible_singleton
      refine Set.mem_biUnion (x := D'') ⟨hD'', ?_⟩ (hyD'' (Set.mem_singleton y))
      intro h
      subst h
      exact hy (hyD'' (Set.mem_singleton y))
    have hxU := closure_minimal hsubU hU hxcl
    obtain ⟨D', ⟨hD'c, hD'ne⟩, hxD'⟩ := Set.mem_iUnion₂.mp hxU
    by_cases hD'𝒟 : D' ∈ 𝒟
    · exact Or.inl ⟨D, hD, D', hD'𝒟, fun h => hD'ne h.symm, hxD, hxD'⟩
    · exact Or.inr ⟨⟨D, hD, hxD⟩, D', hD'c, hD'𝒟, hxD'⟩
  have hDmarkf : ∀ i : {i : Fin k // ∃ x ∈ D, ∃ p : ↥(Spec (.of (IsLocalRing.ResidueField ↥R))),
      f0 x = σ i (c p)}, μ i.1 ∈ D := by
    rintro ⟨i, x, hxD, p, hxp⟩
    have hcp : c p = 𝔪 := by
      have h1 := congrArg (⇑v) hxp
      rw [hv0 x, hvσ i (c p)] at h1
      exact h1.symm
    rw [hcp, ← hμ i] at hxp
    rw [← hf0inj hxp]
    exact hxD
  have hDmark : Nat.card {i : Fin k // ∃ x ∈ D,
      ∃ p : ↥(Spec (.of (IsLocalRing.ResidueField ↥R))), f0 x = σ i (c p)} ≤
      Nat.card {i : Fin k // μ i ∈ D} :=
    Nat.card_le_card_of_injective (fun i => ⟨i.1, hDmarkf i⟩)
      (fun a b h => Subtype.ext (congrArg Subtype.val h :))
  have h3 := h₀ D (h𝒟 D hD).1 (h𝒟 D hD).2
  have h4 := Set.ncard_le_ncard hDcl ((hIfin.union hExtfin).inter_of_right D)
  omega

theorem wcpa_dj_lus_sm_closed_fibre_spreads : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (k : ℕ) (σ : Fin k → (Spec (.of ↥W) ⟶ Z₁))
    (τκ : Fin k → (Spec (.of (IsLocalRing.ResidueField ↥W)) ⟶ Limits.pullback u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))),
    wcpaDjSemistable u₁ → wcpaDjSections u₁ k σ →
    (∀ i, τκ i ≫ Limits.pullback.snd u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) = 𝟙 _) →
    (∀ i, τκ i ≫ Limits.pullback.fst u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) =
      Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) ≫ σ i) →
    wcpaDjStablePtd (Limits.pullback.snd u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) k τκ →
    wcpaDjStablePtd u₁ k σ :=
by
  intro Ω _ W Z₁ u₁ k σ τκ hss hsec hκ1 hκ2 hstκ
  classical
  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]

  have spu : ∀ (X P V C : Scheme.{u}) (f : X ⟶ P) (b : V ⟶ P)
      (ψ : C ⟶ X) (g : C ⟶ V) (σ : P ⟶ X) (τ : V ⟶ C), IsPullback ψ g f b → σ ≫ f = 𝟙 P →
      τ ≫ g = 𝟙 V → τ ≫ ψ = b ≫ σ → ∀ c : C, ψ c = σ (b (g c)) ↔ c = τ (g c) := by
    intro X P V C f b ψ g σ τ H1 H2 H3 H4 c
    have hcomp : ∀ x : V, ψ (τ x) = σ (b x) := by
      intro x
      rw [← Scheme.Hom.comp_apply, H4, Scheme.Hom.comp_apply]
    have hgτ : ∀ x : V, g (τ x) = x := by
      intro x
      rw [← Scheme.Hom.comp_apply, H3]
      rfl
    constructor
    · intro h
      have hout : IsPullback (τ ≫ g) b b (σ ≫ f) := by
        rw [H3, H2]
        exact IsPullback.id_horiz b
      have hsq : IsPullback τ b ψ σ := IsPullback.of_right hout H4 H1.flip
      obtain ⟨p, hp, _⟩ := Scheme.exists_preimage_of_isPullback hsq c (b (g c)) h
      have hg : g c = p := by rw [← hp, hgτ]
      rw [hg, hp]
    · intro h
      calc ψ c = ψ (τ (g c)) := congrArg ψ h
        _ = σ (b (g c)) := hcomp (g c)

  have ssbc : ∀ (M P'' Z : Scheme.{u}) (φ : P'' ⟶ M) (u : Z ⟶ M),
      wcpaDjSemistable u → wcpaDjSemistable (Limits.pullback.snd u φ) := by
    have hcomap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
        (σ : A ≃+* B) (n : ℕ), IsLocalRing.maximalIdeal A ^ n ≤
          Ideal.comap (σ : A →+* B) (IsLocalRing.maximalIdeal B ^ n) := by
      intro A B _ _ _ _ σ n
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
      apply Ideal.pow_right_mono
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
      intro h
      exact hx ((MulEquiv.isUnit_map (σ : A ≃* B)).mp h)
    have hfac : ∀ (A : Type u) [CommRing A] (I : Ideal A) (m n : ℕ) (h : m ≤ n)
        (x : AdicCompletion I A),
        Ideal.Quotient.factorPow I h (AdicCompletion.evalₐ I n x) = AdicCompletion.evalₐ I m x := by
      intro A _ I m n h x
      obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective I A x
      rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk, Ideal.Quotient.factorPow,
        Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
      have := (Submodule.Quotient.eq _).mp (AdicCompletion.AdicCauchySequence.mk_eq_mk h c)
      simpa [smul_eq_mul, Ideal.mul_top] using this
    have hmap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
        (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
          AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ (n : ℕ) x (a : A),
          AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
          AdicCompletion.evalₐ _ n (Φ x) = Ideal.Quotient.mk _ (σ a) := by
      intro A B _ _ _ _ σ
      let f : ∀ n : ℕ, AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
          B ⧸ IsLocalRing.maximalIdeal B ^ n := fun n =>
        (Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)).comp
          (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom
      have hf : ∀ (n : ℕ) x (a : A), AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
          f n x = Ideal.Quotient.mk _ (σ a) := by
        intro n x a ha
        show Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)
          (AdicCompletion.evalₐ _ n x) = _
        rw [ha, Ideal.quotientMap_mk]
        rfl
      have hcompat : ∀ {m n : ℕ} (hle : m ≤ n),
          (Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal B) hle).comp (f n) = f m := by
        intro m n hle
        ext x
        obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n x)
        have ha' : AdicCompletion.evalₐ _ m x = Ideal.Quotient.mk _ a := by
          rw [← hfac A _ m n hle x, ← ha, Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
        rw [RingHom.comp_apply, hf n x a ha.symm, hf m x a ha', Ideal.Quotient.factorPow,
          Ideal.Quotient.factor_mk]
      refine ⟨AdicCompletion.liftRingHom _ f hcompat, ?_⟩
      intro n x a ha
      rw [AdicCompletion.evalₐ_liftRingHom]
      exact hf n x a ha
    have s1 : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
        (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
          AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ a : A,
          Φ (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) =
            algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (σ a) := by
      intro A B _ _ _ _ σ
      obtain ⟨Φ, hΦ⟩ := hmap A B σ
      obtain ⟨Ψ, hΨ⟩ := hmap B A σ.symm
      have h1 : Φ.comp Ψ = RingHom.id _ := by
        ext1 y
        apply AdicCompletion.ext_evalₐ
        intro n
        obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
        rw [RingHom.comp_apply, hΦ n _ _ (hΨ n y b hb.symm), RingEquiv.apply_symm_apply,
          RingHom.id_apply, hb]
      have h2 : Ψ.comp Φ = RingHom.id _ := by
        ext1 y
        apply AdicCompletion.ext_evalₐ
        intro n
        obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
        rw [RingHom.comp_apply, hΨ n _ _ (hΦ n y b hb.symm), RingEquiv.symm_apply_apply,
          RingHom.id_apply, hb]
      refine ⟨RingEquiv.ofRingHom Φ Ψ h1 h2, ?_⟩
      intro a
      apply AdicCompletion.ext_evalₐ
      intro n
      have hof : ∀ (R : Type u) [CommRing R] (I : Ideal R) (r : R),
          AdicCompletion.evalₐ I n (algebraMap R (AdicCompletion I R) r) =
            Ideal.Quotient.mk _ r := by
        intro R _ I r
        rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of, Algebra.algebraMap_self,
          RingHom.id_apply]
      show AdicCompletion.evalₐ _ n (Φ _) = _
      rw [hΦ n _ a (hof A _ a), hof B _ (σ a)]
    have s2 : ∀ (K : Type u) [Field K] {X Y : Scheme.{u}} (i : X ⟶ Y) (p : X ⟶ Spec (.of K))
        (q : Y ⟶ Spec (.of K)), i ≫ q = p → ∀ x : X,
        ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ Y.presheaf.germ ⊤ (i x) trivial) ≫
          i.stalkMap x =
        (Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ x trivial := by
      intro K _ X Y i p q hi x
      have key : Y.presheaf.germ ⊤ (i x) trivial ≫ i.stalkMap x =
          i.appTop ≫ X.presheaf.germ ⊤ x trivial := Scheme.Hom.germ_stalkMap i ⊤ x trivial
      rw [← hi, Scheme.Hom.comp_appTop]
      simp only [Category.assoc]
      exact congrArg (fun t => (Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ t) key
    have s3 : ∀ {X Y S : Scheme.{u}} (i : X ⟶ Y) [IsIso i] (p : X ⟶ S) (q : Y ⟶ S), i ≫ q = p →
        ∀ (W' : Y.Opens), SmoothOfRelativeDimension 1 (W'.ι ≫ q) →
          SmoothOfRelativeDimension 1 ((i ⁻¹ᵁ W').ι ≫ p) := by
      intro X Y S i _ p q hi W' hW'
      have hfac' : (i ⁻¹ᵁ W').ι ≫ p = (i ∣_ W') ≫ (W'.ι ≫ q) := by
        rw [← hi, ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
      have hpb : IsPullback (i ∣_ W') ((i ∣_ W') ≫ (W'.ι ≫ q)) (W'.ι ≫ q) (𝟙 S) :=
        IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id]⟩
      rw [hfac']
      exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hW'
    intro M P'' Z φ u hss
    obtain ⟨hflat, hprop, hfib⟩ := hss
    haveI := hflat
    haveI := hprop
    refine ⟨inferInstance, inferInstance, ?_⟩
    intro K _ _ s w
    set i := (Limits.pullbackLeftPullbackSndIso u φ s).hom with hi_def
    have hi : i ≫ Limits.pullback.snd u (s ≫ φ) =
        Limits.pullback.snd (Limits.pullback.snd u φ) s :=
      Limits.pullbackLeftPullbackSndIso_hom_snd u φ s
    rcases hfib K (s ≫ φ) (i w) with ⟨W', hw', hsm⟩ | ⟨e₀, he₀⟩
    · left
      refine ⟨i ⁻¹ᵁ W', hw', ?_⟩
      exact s3 i _ _ hi W' hsm
    · right
      let τ := Iso.commRingCatIsoToRingEquiv (asIso (i.stalkMap w))
      obtain ⟨Φ, hΦ⟩ := s1 _ _ τ.symm
      refine ⟨Φ.trans e₀, ?_⟩
      have h2 := s2 K i _ _ hi w
      ext1 k
      have hk : τ.symm (((Scheme.ΓSpecIso (.of K)).inv ≫
          (Limits.pullback.snd (Limits.pullback.snd u φ) s).appTop ≫
          (Limits.pullback (Limits.pullback.snd u φ) s).presheaf.germ ⊤ w trivial).hom k) =
          ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd u (s ≫ φ)).appTop ≫
          (Limits.pullback u (s ≫ φ)).presheaf.germ ⊤ (i w) trivial).hom k := by
        rw [← h2, RingEquiv.symm_apply_eq]
        rfl
      have := RingHom.congr_fun he₀ k
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom] at this ⊢
      rw [RingEquiv.trans_apply, hΦ, hk]
      exact this

  have comp_homeo : ∀ {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y] (h : X ≃ₜ Y)
      (E : Set X), E ∈ irreducibleComponents X → h '' E ∈ irreducibleComponents Y := by
    intro X Y _ _ h E hE
    refine image_mem_irreducibleComponents_of_isPreirreducible_fiber h h.continuous h.isOpenMap
      ?_ h.surjective hE
    intro y
    apply Set.Subsingleton.isPreirreducible
    intro a ha a' ha'
    exact h.injective (ha.trans ha'.symm)

  have transfer : ∀ {Z T T' : Scheme.{u}} (uu : Z ⟶ T) (b : T' ⟶ T) (n : ℕ)
      (τ : Fin n → (T ⟶ Z)) (τ' : Fin n → (T' ⟶ Limits.pullback uu b)),
      (∀ i, τ i ≫ uu = 𝟙 T) → (∀ i, τ' i ≫ Limits.pullback.snd uu b = 𝟙 T') →
      (∀ i, τ' i ≫ Limits.pullback.fst uu b = b ≫ τ i) →
      ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ T'),
      (wcpaDjSolStab (Limits.pullback.snd uu b) n τ' K s ↔ wcpaDjSolStab uu n τ K (s ≫ b)) := by
    intro Z T T' uu b n τ τ' hS1 E1 E2 K _ s
    have hpb : IsPullback (Limits.pullback.fst uu b) (Limits.pullback.snd uu b) uu b :=
      IsPullback.of_hasPullback uu b
    obtain ⟨e, I1, I2⟩ : ∃ e : Limits.pullback (Limits.pullback.snd uu b) s ≅
        Limits.pullback uu (s ≫ b),
        e.hom ≫ Limits.pullback.fst uu (s ≫ b) =
          Limits.pullback.fst (Limits.pullback.snd uu b) s ≫ Limits.pullback.fst uu b ∧
        e.hom ≫ Limits.pullback.snd uu (s ≫ b) = Limits.pullback.snd (Limits.pullback.snd uu b) s :=
      ⟨_, Limits.pullbackLeftPullbackSndIso_hom_fst uu b s,
        Limits.pullbackLeftPullbackSndIso_hom_snd uu b s⟩
    have I3 : e.inv ≫ Limits.pullback.snd (Limits.pullback.snd uu b) s =
        Limits.pullback.snd uu (s ≫ b) := by
      rw [← I2, ← Category.assoc, e.inv_hom_id, Category.id_comp]
    obtain ⟨h, hh⟩ : ∃ h : ↥(Limits.pullback (Limits.pullback.snd uu b) s) ≃ₜ
        ↥(Limits.pullback uu (s ≫ b)), ∀ x, h x = e.hom x :=
      ⟨Scheme.homeoOfIso e, Scheme.homeoOfIso_apply e⟩
    have hinv : ∀ y, e.inv y = h.symm y := by
      intro y
      apply h.injective
      rw [Homeomorph.apply_symm_apply, hh, ← Scheme.Hom.comp_apply, e.inv_hom_id]
      rfl
    have hsi : ∀ A : Set ↥(Limits.pullback (Limits.pullback.snd uu b) s),
        h.symm '' (h '' A) = A := by
      intro A
      rw [Set.image_image]
      simp
    have hcnt : ∀ E : Set ↥(Limits.pullback (Limits.pullback.snd uu b) s),
        (h '' E ∩ closure (h '' E)ᶜ).ncard = (E ∩ closure Eᶜ).ncard := by
      intro E
      rw [← h.image_compl, ← h.image_closure, ← Set.image_inter h.injective]
      exact Set.ncard_image_of_injective _ h.injective
    have hcard : ∀ E : Set ↥(Limits.pullback (Limits.pullback.snd uu b) s),
        Nat.card {i : Fin n // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
            Limits.pullback.fst (Limits.pullback.snd uu b) s x = τ' i (s p)} =
          Nat.card {i : Fin n // ∃ y ∈ h '' E, ∃ p : ↥(Spec (.of K)),
            Limits.pullback.fst uu (s ≫ b) y = τ i ((s ≫ b) p)} := by
      intro E
      refine Nat.card_congr (Equiv.subtypeEquivRight ?_)
      intro i
      constructor
      · rintro ⟨x, hx, p, hp⟩
        refine ⟨h x, ⟨x, hx, rfl⟩, p, ?_⟩
        rw [hh, pt I1 x, Scheme.Hom.comp_apply, hp, pt (E2 i) (s p), Scheme.Hom.comp_apply,
          Scheme.Hom.comp_apply]
      · rintro ⟨y, ⟨x, hx, rfl⟩, p, hp⟩
        refine ⟨x, hx, p, ?_⟩
        set c := Limits.pullback.fst (Limits.pullback.snd uu b) s x with hc
        have e1 : Limits.pullback.fst uu b c = τ i (b (s p)) := by
          have h1 := pt I1 x
          rw [Scheme.Hom.comp_apply, ← hh, hp, Scheme.Hom.comp_apply] at h1
          exact h1.symm
        have e2 : Limits.pullback.snd uu b c = s p := by
          rw [hc, pt (Limits.pullback.condition (f := Limits.pullback.snd uu b) (g := s)) x,
            Scheme.Hom.comp_apply,
            Subsingleton.elim (Limits.pullback.snd (Limits.pullback.snd uu b) s x) p]
        have hc1 : Limits.pullback.fst uu b c = τ i (b (Limits.pullback.snd uu b c)) := by
          rw [e2]; exact e1
        have key2 := (spu Z T T' (Limits.pullback uu b) uu b
          (Limits.pullback.fst uu b) (Limits.pullback.snd uu b) (τ i) (τ' i) hpb (hS1 i) (E1 i)
          (E2 i) c).mp hc1
        rw [key2, e2]
    have hdatF : ∀ E : Set ↥(Limits.pullback (Limits.pullback.snd uu b) s),
        (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback (Limits.pullback.snd uu b) s)
          (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra ≫
            Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
            ι ≫ Limits.pullback.snd (Limits.pullback.snd uu b) s) →
        (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback uu (s ≫ b))
          (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = h '' E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra ≫
            Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
            ι ≫ Limits.pullback.snd uu (s ≫ b)) := by
      intro E hdat
      obtain ⟨Er, ι, θ, hci, hred, hrange, hθ⟩ := hdat
      refine ⟨Er, ι ≫ e.hom, θ, inferInstance, hred, ?_, ?_⟩
      · ext y
        constructor
        · rintro ⟨x, rfl⟩
          refine ⟨ι x, ?_, ?_⟩
          · rw [← hrange]; exact ⟨x, rfl⟩
          · rw [hh, Scheme.Hom.comp_apply]
        · rintro ⟨z, hz, rfl⟩
          rw [← hrange] at hz
          obtain ⟨x, rfl⟩ := hz
          exact ⟨x, by rw [hh, Scheme.Hom.comp_apply]⟩
      · rw [hθ, Category.assoc, I2]
    have hdatB : ∀ E : Set ↥(Limits.pullback (Limits.pullback.snd uu b) s),
        (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback uu (s ≫ b))
          (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = h '' E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra ≫
            Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
            ι ≫ Limits.pullback.snd uu (s ≫ b)) →
        (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback (Limits.pullback.snd uu b) s)
          (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra ≫
            Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
            ι ≫ Limits.pullback.snd (Limits.pullback.snd uu b) s) := by
      intro E hdat
      obtain ⟨Er, ι, θ, hci, hred, hrange, hθ⟩ := hdat
      refine ⟨Er, ι ≫ e.inv, θ, inferInstance, hred, ?_, ?_⟩
      · ext x
        constructor
        · rintro ⟨z, rfl⟩
          have hz : ι z ∈ h '' E := by rw [← hrange]; exact ⟨z, rfl⟩
          obtain ⟨x', hx', hxe⟩ := hz
          rw [Scheme.Hom.comp_apply, hinv, ← hxe, Homeomorph.symm_apply_apply]
          exact hx'
        · intro hx
          have hx2 : h x ∈ Set.range ι := by rw [hrange]; exact ⟨x, hx, rfl⟩
          obtain ⟨z, hz⟩ := hx2
          exact ⟨z, by rw [Scheme.Hom.comp_apply, hz, hinv, Homeomorph.symm_apply_apply]⟩
      · rw [hθ, Category.assoc, I3]
    unfold wcpaDjSolStab
    constructor
    · intro hL E' hE' hdat'
      obtain ⟨E, rfl⟩ : ∃ E, E' = h '' E := ⟨h.symm '' E', by rw [Set.image_image]; simp⟩
      have hE : E ∈ irreducibleComponents ↥(Limits.pullback (Limits.pullback.snd uu b) s) := by
        have := comp_homeo h.symm (h '' E) hE'
        rwa [hsi] at this
      have key := hL E hE (hdatB E hdat')
      rw [← hcard E, hcnt E]
      exact key
    · intro hR E hE hdat
      have key := hR (h '' E) (comp_homeo h E hE) (hdatF E hdat)
      rw [← hcard E, hcnt E] at key
      exact key

  refine ⟨hss, hsec, ?_⟩
  intro K _ _ s
  show wcpaDjSolStab u₁ k σ K s

  obtain ⟨φ, hφ⟩ : ∃ φ : ↥W →+* K, Spec.map (CommRingCat.ofHom φ) = s :=
    ⟨(Spec.preimage s).hom, by rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩

  haveI : IsLocalRing φ.range :=
    IsLocalRing.of_surjective' φ.rangeRestrict φ.rangeRestrict_surjective
  obtain ⟨R, hR⟩ := LocalSubring.exists_le_valuationSubring (LocalSubring.mk φ.range)
  obtain ⟨hsub, hloc⟩ := LocalSubring.le_def.mp hR
  have hlocφ : IsLocalHom φ.rangeRestrict := by
    constructor
    intro a ha
    obtain ⟨c, hc⟩ := ha.exists_right_inv
    obtain ⟨a', ha'⟩ := φ.rangeRestrict_surjective c
    have h1 : φ (a * a') = 1 := by
      have := congrArg Subtype.val hc
      rw [← ha'] at this
      simpa using this
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (a * a') with hu | hu
    · exact isUnit_of_mul_isUnit_left hu
    · exfalso
      have h2 : φ (1 - a * a') = 0 := by rw [map_sub, map_one, h1, sub_self]
      exact (hu.map φ).ne_zero h2
  let ι : ↥W →+* ↥R := (Subring.inclusion hsub).comp φ.rangeRestrict
  have hlocι : IsLocalHom ι := by
    constructor
    intro a ha
    exact hlocφ.map_nonunit a (hloc.map_nonunit _ ha)
  haveI := hlocι
  have hκR : IsAlgClosed (IsLocalRing.ResidueField ↥R) := by
    apply IsAlgClosed.of_exists_root
    intro p hmon hirr
    obtain ⟨q, hqmap, hqdeg, hqmon⟩ := Polynomial.lifts_and_degree_eq_and_monic
      ((Polynomial.mem_lifts p).mpr
        (Polynomial.map_surjective (IsLocalRing.residue ↥R) IsLocalRing.residue_surjective p)) hmon
    have hdeg : (q.map (algebraMap ↥R K)).degree ≠ 0 := by
      rw [Polynomial.degree_map_eq_of_injective (IsFractionRing.injective ↥R K), hqdeg]
      exact (Polynomial.degree_pos_of_irreducible hirr).ne'
    obtain ⟨θ, hθ⟩ := IsAlgClosed.exists_root _ hdeg
    have hint : IsIntegral ↥R θ := ⟨q, hqmon, by rw [← Polynomial.eval_map]; exact hθ⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    refine ⟨IsLocalRing.residue ↥R y, ?_⟩
    have hq0 : Polynomial.eval y q = 0 := by
      apply IsFractionRing.injective ↥R K
      rw [map_zero, ← Polynomial.eval₂_at_apply, hy, ← Polynomial.eval_map]
      exact hθ
    rw [← hqmap, Polynomial.eval_map, Polynomial.eval₂_at_apply, hq0, map_zero]
  haveI := hκR

  have E1 : Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) ≫ Spec.map (CommRingCat.ofHom ι) =
      s := by
    rw [← hφ, ← Spec.map_comp]
    congr 1
  have E2 : Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))) ≫
      Spec.map (CommRingCat.ofHom ι) =
      Spec.map (CommRingCat.ofHom (IsLocalRing.ResidueField.map ι)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) := by
    rw [← Spec.map_comp, ← Spec.map_comp]
    congr 1

  set b := Spec.map (CommRingCat.ofHom ι) with hb
  have hssR : wcpaDjSemistable (Limits.pullback.snd u₁ b) := ssbc _ _ Z₁ b u₁ hss
  obtain ⟨hS1, hS2, hS3⟩ := hsec
  let σR : Fin k → (Spec (.of ↥R) ⟶ Limits.pullback u₁ b) := fun i =>
    Limits.pullback.lift (b ≫ σ i) (𝟙 _)
      (by rw [Category.assoc, hS1 i, Category.comp_id, Category.id_comp])
  have ER1 : ∀ i, σR i ≫ Limits.pullback.snd u₁ b = 𝟙 _ := fun i =>
    Limits.pullback.lift_snd _ _ _
  have ER2 : ∀ i, σR i ≫ Limits.pullback.fst u₁ b = b ≫ σ i := fun i =>
    Limits.pullback.lift_fst _ _ _
  have hpbR : IsPullback (Limits.pullback.fst u₁ b) (Limits.pullback.snd u₁ b) u₁ b :=
    IsPullback.of_hasPullback u₁ b
  have hsecR : wcpaDjSections (Limits.pullback.snd u₁ b) k σR := by
    refine ⟨ER1, ?_, ?_⟩
    · intro i i' p q hii' heq
      apply hS2 i i' (b p) (b q) hii'
      have h1 := congrArg (fun x => Limits.pullback.fst u₁ b x) heq
      simp only at h1
      rw [pt (ER2 i) p, pt (ER2 i') q, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
      exact h1
    · intro i p
      obtain ⟨W', hW, hWsm⟩ := hS3 i (b p)
      refine ⟨Limits.pullback.fst u₁ b ⁻¹ᵁ W', ?_, ?_⟩
      · show Limits.pullback.fst u₁ b (σR i p) ∈ W'
        rw [pt (ER2 i) p, Scheme.Hom.comp_apply]
        exact hW
      · have h1 : IsPullback (Limits.pullback.fst u₁ b ∣_ W') (Limits.pullback.fst u₁ b ⁻¹ᵁ W').ι
            W'.ι (Limits.pullback.fst u₁ b) := isPullback_morphismRestrict _ W'
        have h2 : IsPullback (Limits.pullback.fst u₁ b ∣_ W')
            ((Limits.pullback.fst u₁ b ⁻¹ᵁ W').ι ≫ Limits.pullback.snd u₁ b) (W'.ι ≫ u₁) b :=
          h1.paste_vert hpbR
        exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) h2 hWsm

  have h0 : wcpaDjSolStab (Limits.pullback.snd u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) k τκ
      (IsLocalRing.ResidueField ↥R)
      (Spec.map (CommRingCat.ofHom (IsLocalRing.ResidueField.map ι))) :=
    hstκ.2.2 (IsLocalRing.ResidueField ↥R)
      (Spec.map (CommRingCat.ofHom (IsLocalRing.ResidueField.map ι)))
  have h1 := (transfer u₁ _ k σ τκ hS1 hκ1 hκ2 (IsLocalRing.ResidueField ↥R) _).mp h0
  rw [← E2] at h1
  have h2 := (transfer u₁ b k σ σR hS1 ER1 ER2 (IsLocalRing.ResidueField ↥R) _).mpr h1

  have h3 := wcpa_dj_lus_cfs_valuation_specialize K R hκR (Limits.pullback u₁ b)
    (Limits.pullback.snd u₁ b) k σR hssR hsecR h2

  have h4 := (transfer u₁ b k σ σR hS1 ER1 ER2 K _).mp h3
  rw [E1] at h4
  exact h4

theorem wcpa_dj_lr1k_mark_model : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X), wcpaDjSemistable uX → (∃ (N : ℕ) (j : X ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧ j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0))) = uX) → IsPullback ι (wcProjKStr Ω 1) uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) → ∃ (m : ℕ) (b : Fin m → (Spec (.of Ω) ⟶ wcProjK Ω 1)) (β : Fin m → (Spec (.of ↥W) ⟶ X)), 3 ≤ m ∧ (∀ a, b a ≫ wcProjKStr Ω 1 = 𝟙 _) ∧ (∀ (a a' : Fin m) (p q : ↥(Spec (.of Ω))), a ≠ a' → b a p ≠ b a' q) ∧ wcpaDjStablePtd uX m β ∧ ∀ a, b a ≫ ι = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ β a :=
by
  intro Ω _ _ W hW hWt X uX ι hss hXp hpb
  have h0 : wcpaDjSections uX 0 (Fin.elim0 : Fin 0 → (Spec (.of ↥W) ⟶ X)) :=
    ⟨fun j => j.elim0, fun i _ _ _ _ => i.elim0, fun j _ => j.elim0⟩
  obtain ⟨m', ε, τκ, hsec, hτs, hτf, hstκ⟩ :=
    wcpa_dj_lus_sm_aux_marking Ω W X uX 0 (Fin.elim0 : Fin 0 → (Spec (.of ↥W) ⟶ X)) hss h0
  have hst := wcpa_dj_lus_sm_closed_fibre_spreads Ω W X uX (0 + m')
    (Fin.append (Fin.elim0 : Fin 0 → (Spec (.of ↥W) ⟶ X)) ε) τκ hss hsec hτs hτf hstκ
  generalize Fin.append (Fin.elim0 : Fin 0 → (Spec (.of ↥W) ⟶ X)) ε = β at hst
  have hβsec : wcpaDjSections uX (0 + m') β := hst.2.1

  have h3 : 3 ≤ 0 + m' := by
    haveI : AlgebraicGeometry.IsIntegral (wcProjK Ω 1) := (wc_projK_integral_normal Ω 1).1
    have hsnd : hpb.isoPullback.hom ≫
        Limits.pullback.snd uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) =
        wcProjKStr Ω 1 := hpb.isoPullback_hom_snd
    have hsurj : Function.Surjective hpb.isoPullback.hom := hpb.isoPullback.hom.surjective
    haveI : IrreducibleSpace
        ↥(Limits.pullback uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))) :=
      Function.Surjective.irreducibleSpace hpb.isoPullback.hom.continuous hsurj
    have hE : (Set.univ : Set
        ↥(Limits.pullback uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))))) ∈
        irreducibleComponents
          ↥(Limits.pullback uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))) := by
      rw [irreducibleComponents_eq_singleton]; exact Set.mem_singleton _
    refine le_trans (hst.2.2 Ω (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) Set.univ hE
      ⟨wcProjK Ω 1, hpb.isoPullback.hom, Iso.refl _, inferInstance, inferInstance,
        Set.range_eq_univ.mpr hsurj, ?_⟩) ?_
    · rw [hsnd, Iso.refl_hom, Category.id_comp]
    · rw [Set.compl_univ, closure_empty, Set.inter_empty, Set.ncard_empty]
      have hc := Finite.card_subtype_le (fun i : Fin (0 + m') =>
        ∃ x ∈ (Set.univ : Set
          ↥(Limits.pullback uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))))),
        ∃ p : ↥(Spec (.of Ω)),
          Limits.pullback.fst uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) x =
            β i (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) p))
      rw [Nat.card_fin] at hc
      omega

  have hw : ∀ a, (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ β a) ≫ uX =
      𝟙 (Spec (.of Ω)) ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) := fun a => by
    rw [Category.assoc, hβsec.1 a, Category.comp_id, Category.id_comp]
  let b : Fin (0 + m') → (Spec (.of Ω) ⟶ wcProjK Ω 1) := fun a => hpb.lift _ _ (hw a)
  have hbs : ∀ a, b a ≫ wcProjKStr Ω 1 = 𝟙 _ := fun a => hpb.lift_snd _ _ _
  have hbι : ∀ a, b a ≫ ι = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ β a :=
    fun a => hpb.lift_fst _ _ _
  have hbd : ∀ (a a' : Fin (0 + m')) (p q : ↥(Spec (.of Ω))), a ≠ a' → b a p ≠ b a' q := by
    intro a a' p q hne heq
    apply hβsec.2.1 a a' (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) p)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) q) hne
    have h1 : ι (b a p) = ι (b a' q) := by rw [heq]
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hbι, hbι, Scheme.Hom.comp_apply,
      Scheme.Hom.comp_apply] at h1
    exact h1
  exact ⟨0 + m', b, β, h3, hbs, hbd, hst, hbι⟩

theorem wcpa_dj_ldx_lqf_of_no_fibre_specialization : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y), LocallyOfFiniteType f → (∀ x x' : X, x' ⤳ x → f x' = f x → x' = x) → LocallyQuasiFinite f :=
by
  have s2 : ∀ (A S : Type u) [CommRing A] [CommRing S] [Algebra A S], Algebra.FiniteType A S →
      (∀ q m : PrimeSpectrum S, q ≤ m → PrimeSpectrum.comap (algebraMap A S) q =
        PrimeSpectrum.comap (algebraMap A S) m → q = m) → Algebra.QuasiFinite A S := by
    intro A S _ _ _ hft hno
    have := hft
    refine Algebra.QuasiFinite.mk (fun P _ => ?_)
    rw [Module.finite_iff_krullDimLE_zero]
    refine Ring.KrullDimLE.mk₀ (fun Q hQ => ?_)
    obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal Q hQ.ne_top
    let p : PrimeSpectrum A := ⟨P, inferInstance⟩
    let E := PrimeSpectrum.preimageOrderIsoFiber A S p
    let a := E.symm ⟨Q, hQ⟩
    let b := E.symm ⟨M, hM.isPrime⟩
    have hab : a ≤ b := E.symm.le_iff_le.mpr hle
    have ha : PrimeSpectrum.comap (algebraMap A S) a.1 = p := a.2
