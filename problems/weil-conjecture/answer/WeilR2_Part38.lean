    exact ((Φ a).apply_symm_apply z).symm
  let toR : ∀ {p : ℕ} (a : Fin (p + 1) ↪o Fin (m + 1)),
      Γ(wcStructMod Y, wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a) ≃+
        Γ(Y, wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a) := fun a => AddEquiv.refl _
  let Ψ : ∀ {p : ℕ} (a : Fin (p + 1) ↪o Fin (m + 1)),
      Γ(L, wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a) ≃+
        Γ(Y, wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a) := fun a => (Φ a).trans (toR a)
