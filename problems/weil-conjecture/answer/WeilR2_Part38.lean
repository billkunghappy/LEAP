  have hvσ : ∀ i z, v (σ i z) = z := by
    intro i z
    rw [pt (hS1 i) z]
    rfl
  have hvε : ∀ z, v (ε b₀ z) = z := by
    intro z
    rw [pt hε1 z]
    rfl
  haveI := hss.1
  have hvgen : GeneralizingMap v := Flat.generalizingMap v
  have hv0 : ∀ y, v (f0 y) = 𝔪 := by
    intro y
    have h1 : f0 y ∈ Set.range f0 := ⟨y, rfl⟩
    rw [h0range] at h1
    exact h1
  have hvK : ∀ y, v (fK y) = η := by
    intro y
    have h1 : fK y ∈ Set.range fK := ⟨y, rfl⟩
    rw [hKrange] at h1
    exact h1
  have hf0inj : Function.Injective f0 := h0emb.toIsEmbedding.injective
  obtain ⟨x0, hx0⟩ := hE.1.nonempty
  have hjη : ∀ p, j p = η := by
    intro p
    have h1 := pt hcondK x0
    rw [Scheme.Hom.comp_apply, hvK x0, Subsingleton.elim (Limits.pullback.snd v j x0) p] at h1
    exact h1.symm
  have hμex : ∀ i, ∃ m, f0 m = σ i 𝔪 := by
    intro i
    have h1 : σ i 𝔪 ∈ v ⁻¹' {𝔪} := hvσ i 𝔪
    rw [← h0range] at h1
    exact h1
  choose μ hμ using hμex
  obtain ⟨𝒟, _h𝒟ne, h𝒟, himg, hIfin, hIcard⟩ := s2 E hE hP1E
  have hEcl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
  obtain ⟨z, hzE⟩ : ∃ z, closure {z} = E := by
    refine ⟨hE.1.genericPoint, ?_⟩
    have h1 := hE.1.isGenericPoint_genericPoint_closure
    rw [hEcl.closure_eq] at h1
    exact h1
  have hclE : closure (fK '' E) ⊆ closure {fK z} := by
    apply closure_minimal _ isClosed_closure
    rintro _ ⟨w, hw, rfl⟩
    rw [← hzE] at hw
    have h1 : z ⤳ w := specializes_iff_mem_closure.mpr hw
    exact specializes_iff_mem_closure.mp (h1.map fK.continuous)

  have hspec : ∀ τ : Spec (.of ↥R) ⟶ Y, (∀ z, v (τ z) = z) →
      (∃ x ∈ E, ∃ q : ↥(Spec (.of K)), fK x = τ (j q)) → ∃ D ∈ 𝒟, ∃ m ∈ D, f0 m = τ 𝔪 := by
    rintro τ hvτ ⟨x, hx, q, hxq⟩
    have h1 : τ η ∈ fK '' E := ⟨x, hx, by rw [hxq, hjη]⟩
    have h2 : τ 𝔪 ∈ closure (fK '' E) := by
      have h3 : τ η ⤳ τ 𝔪 := (hηall 𝔪).map τ.continuous
      exact closure_mono (Set.singleton_subset_iff.mpr h1) (specializes_iff_mem_closure.mp h3)
    have h4 : τ 𝔪 ∈ f0 '' (⋃ D ∈ 𝒟, D) := by
      rw [himg]
      exact ⟨h2, hvτ 𝔪⟩
    obtain ⟨m, hm, hfm⟩ := h4
    obtain ⟨D, hD, hmD⟩ := Set.mem_iUnion₂.mp hm
    exact ⟨D, hD, m, hmD, hfm⟩

  have hmark : ∀ i, (∃ D ∈ 𝒟, μ i ∈ D) →
      ∃ x ∈ E, ∃ p : ↥(Spec (.of K)), fK x = σ i (j p) := by
    rintro i ⟨D, hD, hμD⟩
    have hy : σ i 𝔪 ∈ closure (fK '' E) := by
      have h1 : f0 (μ i) ∈ f0 '' (⋃ D ∈ 𝒟, D) := ⟨μ i, Set.mem_biUnion hD hμD, rfl⟩
      rw [himg, hμ i] at h1
      exact h1.1
    have hzy : fK z ⤳ σ i 𝔪 := specializes_iff_mem_closure.mpr (hclE hy)
    obtain ⟨W, hW, hWsm⟩ := hS3 i 𝔪
    haveI := hWsm
    haveI hdomW := wcpa_dj_lus_cvs_smooth_valuation_stalk_domain K R W.toScheme (W.ι ≫ v)
      (⟨σ i 𝔪, hW⟩ : W)
    haveI hdom : IsDomain (Y.presheaf.stalk (σ i 𝔪)) :=
      MulEquiv.isDomain _ (W.stalkIso (⟨σ i 𝔪, hW⟩ : W)).symm.commRingCatIsoToRingEquiv.toMulEquiv
    have hgen : ∀ y', y' ⤳ σ i 𝔪 →
        Y.fromSpecStalk (σ i 𝔪) (genericPoint _) ⤳ y' := by
      intro y' hy'
      have h1 : y' ∈ Set.range (Y.fromSpecStalk (σ i 𝔪)) := by
        rw [Scheme.range_fromSpecStalk]; exact hy'
      obtain ⟨q, rfl⟩ := h1
      exact (genericPoint_specializes q).map (Y.fromSpecStalk (σ i 𝔪)).continuous
    have hξz := hgen _ hzy
    have hvξ : v (Y.fromSpecStalk (σ i 𝔪) (genericPoint _)) = η := by
      apply hηmin
      have h1 := hξz.map v.continuous
      rwa [hvK z] at h1
    obtain ⟨z', hz'⟩ : Y.fromSpecStalk (σ i 𝔪) (genericPoint _) ∈ Set.range fK := by
      rw [hKrange]; exact hvξ
    have hz'z : z' ⤳ z := hKemb.toIsInducing.specializes_iff.mp (by rw [hz']; exact hξz)
    have hcl' : closure {z'} ⊆ E := by
      have hsub : E ⊆ closure {z'} := by
        rw [← hzE]
        exact specializes_iff_closure_subset.mp hz'z
      exact hE.2 isIrreducible_singleton.closure hsub
    have hsy : σ i η ⤳ σ i 𝔪 := (hηall 𝔪).map (σ i).continuous
    have hξs := hgen _ hsy
    obtain ⟨w, hw⟩ : σ i η ∈ Set.range fK := by
      rw [hKrange]; exact hvσ i η
    have hz'w : z' ⤳ w := hKemb.toIsInducing.specializes_iff.mp (by rw [hz', hw]; exact hξs)
    refine ⟨w, hcl' (specializes_iff_mem_closure.mp hz'w), Limits.pullback.snd v j x0, ?_⟩
    rw [hw, hjη]
  have hmarkle : Nat.card {i : Fin (k + 1) // ∃ D ∈ 𝒟, μ i ∈ D} ≤
      Nat.card {i : Fin (k + 1) // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)), fK x = σ i (j p)} :=
    Nat.card_le_card_of_injective (fun i => ⟨i.1, hmark i.1 i.2⟩)
      (fun a b h => Subtype.ext (congrArg Subtype.val h :))
  have hsplit : Nat.card {i : Fin (k + 1) // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)), fK x = σ i (j p)} ≤
      Nat.card {i : Fin k // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
        fK x = σ (Fin.castSucc i) (j p)} + 1 := by
    simp only [Nat.card_eq_fintype_card, Fintype.card_subtype, Finset.card_filter]
    rw [Fin.sum_univ_castSucc]
    split_ifs <;> omega

  have hH2 : ∀ y, ∃ y' : ↥Y, v y' = η ∧ y' ⤳ f0 y := by
    intro y
    obtain ⟨x', hx', hvx'⟩ := hvgen (hηall (v (f0 y)))
    exact ⟨x', hvx', hx'⟩
  have hH3 : ∀ E₁ ∈ irreducibleComponents ↥(Limits.pullback v j),
      ∀ E₂ ∈ irreducibleComponents ↥(Limits.pullback v j), E₁ ≠ E₂ → ∀ y,
      f0 y ∈ closure (fK '' E₁) → f0 y ∈ closure (fK '' E₂) → ∃ n ∈ E₁ ∩ E₂, fK n ⤳ f0 y :=
    fun E₁ hE₁ E₂ hE₂ hne y h1 h2 => s11 E₁ hE₁ E₂ hE₂ hne (f0 y) (hv0 y) h1 h2
  have hH4 : ∀ n, IsClosed {n} → ∀ y y', fK n ⤳ f0 y → fK n ⤳ f0 y' → y = y' :=
    fun n hn y y' h1 h2 => hf0inj (s10 n hn (f0 y) (f0 y') (hv0 y) (hv0 y') h1 h2)
  obtain ⟨hExtfin, hExtle⟩ := wcpa_dj_lus_cvs_external_bound (⇑v) (⇑fK) (⇑f0) η 𝔪 v.continuous
    hKemb hKrange h0emb h0range hH2 hH3 hH4 E hE (hE1 E hE).1 (hE1 E hE).2 𝒟
    (fun D hD => (h𝒟 D hD).1) himg
  have hsum3 : {y | (∃ D ∈ 𝒟, y ∈ D) ∧ ∃ D' ∈ irreducibleComponents ↥(Limits.pullback v c),
      D' ∉ 𝒟 ∧ y ∈ D'}.ncard + Nat.card {i : Fin (k + 1) // ∃ D ∈ 𝒟, μ i ∈ D} ≤ 3 := by
    omega

  have hcompfin : ∀ x : ↥(Limits.pullback v c),
      {D | D ∈ irreducibleComponents ↥(Limits.pullback v c) ∧ x ∈ D}.Finite :=
    fun x => hfin0.subset (fun D hD => hD.1)
  have hsub𝒟 : ∀ x : ↥(Limits.pullback v c), {D | D ∈ 𝒟 ∧ x ∈ D} ⊆
      {D | D ∈ irreducibleComponents ↥(Limits.pullback v c) ∧ x ∈ D} :=
    fun x D hD => ⟨(h𝒟 D hD.1).1, hD.2⟩
  have hmI : ∀ x ∈ {x | ∃ D ∈ 𝒟, ∃ D' ∈ 𝒟, D ≠ D' ∧ x ∈ D ∧ x ∈ D'},
      {D | D ∈ 𝒟 ∧ x ∈ D}.ncard ≤ 2 :=
    fun x _ => (Set.ncard_le_ncard (hsub𝒟 x) (hcompfin x)).trans (s5 x).1
  have hmX : ∀ x ∈ {y | (∃ D ∈ 𝒟, y ∈ D) ∧ ∃ D' ∈ irreducibleComponents ↥(Limits.pullback v c),
      D' ∉ 𝒟 ∧ y ∈ D'}, {D | D ∈ 𝒟 ∧ x ∈ D}.ncard ≤ 1 := by
    rintro x ⟨_, D', hD', hD'𝒟, hxD'⟩
    have h1 : {D | D ∈ 𝒟 ∧ x ∈ D} ⊆
        {D | D ∈ irreducibleComponents ↥(Limits.pullback v c) ∧ x ∈ D} \ {D'} := by
      intro D hD
      refine ⟨hsub𝒟 x hD, ?_⟩
      intro h
      rw [Set.mem_singleton_iff] at h
      subst h
      exact hD'𝒟 hD.1
    have h2 := Set.ncard_diff_singleton_of_mem
      (show D' ∈ {D | D ∈ irreducibleComponents ↥(Limits.pullback v c) ∧ x ∈ D} from ⟨hD', hxD'⟩)
    have h3 := Set.ncard_le_ncard h1 ((hcompfin x).diff)
    have h4 := (s5 x).1
    omega
  have hmμc : ∀ i, {D | D ∈ irreducibleComponents ↥(Limits.pullback v c) ∧ μ i ∈ D}.ncard ≤ 1 := by
    intro i
    obtain ⟨W, hW, hWsm⟩ := hS3 i 𝔪
    have hsm : ∃ W0 : (Limits.pullback v c).Opens, μ i ∈ W0 ∧
        SmoothOfRelativeDimension 1 (W0.ι ≫ Limits.pullback.snd v c) := by
      refine ⟨f0 ⁻¹ᵁ W, ?_, ?_⟩
      · show f0 (μ i) ∈ W
        rw [hμ i]; exact hW
      · have h1 : IsPullback (f0 ∣_ W) (f0 ⁻¹ᵁ W).ι W.ι f0 := isPullback_morphismRestrict f0 W
        have h2 : IsPullback (f0 ∣_ W) ((f0 ⁻¹ᵁ W).ι ≫ Limits.pullback.snd v c) (W.ι ≫ v) c :=
          h1.paste_vert hpb0
        exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) h2 hWsm
    exact (s5 (μ i)).2 hsm
  have hmμ : ∀ i, {D | D ∈ 𝒟 ∧ μ i ∈ D}.ncard ≤ 1 := fun i =>
    (Set.ncard_le_ncard (hsub𝒟 (μ i)) (hcompfin (μ i))).trans (hmμc i)

  have hx3 : ∀ D ∈ 𝒟, 3 ≤ (D ∩ ({x | ∃ D ∈ 𝒟, ∃ D' ∈ 𝒟, D ≠ D' ∧ x ∈ D ∧ x ∈ D'} ∪
      {y | (∃ D ∈ 𝒟, y ∈ D) ∧ ∃ D' ∈ irreducibleComponents ↥(Limits.pullback v c),
        D' ∉ 𝒟 ∧ y ∈ D'})).ncard + Nat.card {i : Fin (k + 1) // μ i ∈ D} := by
    intro D hD
    have hDcl : D ∩ closure Dᶜ ⊆ D ∩ ({x | ∃ D ∈ 𝒟, ∃ D' ∈ 𝒟, D ≠ D' ∧ x ∈ D ∧ x ∈ D'} ∪
        {y | (∃ D ∈ 𝒟, y ∈ D) ∧ ∃ D' ∈ irreducibleComponents ↥(Limits.pullback v c),
          D' ∉ 𝒟 ∧ y ∈ D'}) := by
      rintro x ⟨hxD, hxcl⟩
      refine ⟨hxD, ?_⟩
      have hU : IsClosed (⋃ D' ∈ {D' | D' ∈ irreducibleComponents ↥(Limits.pullback v c) ∧ D' ≠ D},
          D') :=
        (hfin0.subset (fun D' hD' => hD'.1)).isClosed_biUnion
          (fun D' hD' => isClosed_of_mem_irreducibleComponents D' hD'.1)
      have hsubU : Dᶜ ⊆
          ⋃ D' ∈ {D' | D' ∈ irreducibleComponents ↥(Limits.pullback v c) ∧ D' ≠ D}, D' := by
        intro y hy
        obtain ⟨D'', hD'', hyD''⟩ :=
          exists_mem_irreducibleComponents_subset_of_isIrreducible {y} isIrreducible_singleton
        refine Set.mem_biUnion (x := D'') ⟨hD'', ?_⟩ (hyD'' (Set.mem_singleton y))
        intro h
        subst h
        exact hy (hyD'' (Set.mem_singleton y))
      have hxU := closure_minimal hsubU hU hxcl
      obtain ⟨D', ⟨hD'c, hD'ne⟩, hxD'⟩ := Set.mem_iUnion₂.mp hxU
      by_cases hD'𝒟 : D' ∈ 𝒟
      · exact Or.inl ⟨D, hD, D', hD'𝒟, fun h => hD'ne h.symm, hxD, hxD'⟩
      · exact Or.inr ⟨⟨D, hD, hxD⟩, D', hD'c, hD'𝒟, hxD'⟩
    have hDmarkf : ∀ i : {i : Fin (k + 1) // ∃ x ∈ D,
        ∃ p : ↥(Spec (.of (IsLocalRing.ResidueField ↥R))), f0 x = σ i (c p)}, μ i.1 ∈ D := by
      rintro ⟨i, x, hxD, p, hxp⟩
      have hcp : c p = 𝔪 := by
        have h1 := congrArg (⇑v) hxp
        rw [hv0 x, hvσ i (c p)] at h1
        exact h1.symm
      rw [hcp, ← hμ i] at hxp
      rw [← hf0inj hxp]
      exact hxD
    have hDmark : Nat.card {i : Fin (k + 1) // ∃ x ∈ D,
        ∃ p : ↥(Spec (.of (IsLocalRing.ResidueField ↥R))), f0 x = σ i (c p)} ≤
        Nat.card {i : Fin (k + 1) // μ i ∈ D} :=
      Nat.card_le_card_of_injective (fun i => ⟨i.1, hDmarkf i⟩)
        (fun a b h => Subtype.ext (congrArg Subtype.val h :))
    have h3 : 3 ≤ (D ∩ closure Dᶜ).ncard + Nat.card {i : Fin (k + 1) // ∃ x ∈ D,
        ∃ p : ↥(Spec (.of (IsLocalRing.ResidueField ↥R))), f0 x = σ i (c p)} :=
      hstab (IsLocalRing.ResidueField ↥R) c D (h𝒟 D hD).1 (h𝒟 D hD).2
    have h4 := Set.ncard_le_ncard hDcl ((hIfin.union hExtfin).inter_of_right D)
    omega

  have hcard1 : 𝒟.card ≤ 1 :=
    tree_single 𝒟 _ _ (k + 1) μ hIfin hExtfin hIcard hmI hmX hmμ hsum3 hx3
  obtain ⟨Da, hDa, ma, hmaD, hma⟩ := hspec (σ (Fin.last k)) (hvσ _) hElast
  obtain ⟨Db, hDb, mb, hmbD, hmb⟩ := hspec (ε b₀) hvε hb₀
  have hab : Da = Db := Finset.card_le_one.mp hcard1 Da hDa Db hDb

  have hmaμ : ma = μ (Fin.last k) := hf0inj (hma.trans (hμ _).symm)
  obtain ⟨x₀, hx₀D, q₀, hx₀⟩ := hD₀last
  have hcq : c q₀ = 𝔪 := by
    have h1 := congrArg (⇑v) hx₀
    rw [hv0 x₀, hvσ _ (c q₀)] at h1
    exact h1.symm
  have hx₀μ : x₀ = μ (Fin.last k) := by
    apply hf0inj
    rw [hx₀, hcq, hμ]
  have hμD₀ : μ (Fin.last k) ∈ D₀ := hx₀μ ▸ hx₀D
  have hμDa : μ (Fin.last k) ∈ Da := hmaμ ▸ hmaD
  have hDaD₀ : Da = D₀ :=
    (Set.ncard_le_one (hcompfin _)).mp (hmμc (Fin.last k)) Da ⟨(h𝒟 Da hDa).1, hμDa⟩ D₀
      ⟨hD₀, hμD₀⟩

  apply hD₀AF b₀
  refine ⟨mb, ?_, Limits.pullback.snd v c mb, ?_⟩
  · rw [← hDaD₀, hab]
    exact hmbD
  · have h1 := pt hcond0 mb
    rw [Scheme.Hom.comp_apply, hv0 mb] at h1
    rw [hmb, ← h1]

theorem wcpa_dj_lfc_afcaf_generic_point_generization : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : ValuationSubring K), IsAlgClosed (IsLocalRing.ResidueField ↥R) → ∀ (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)), wcpaDjSemistable v → ∀ D₀ ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))), ∀ ξ₀ : ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))), closure {ξ₀} = D₀ → ∃ ζ : Y, ∀ y' : Y, y' ⤳ Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) ξ₀ → ζ ⤳ y' :=
by
  classical

  have s1 : ∀ (Ω : Type u) [Field Ω], ¬ IsUnit (Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) Ω)}) (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) Ω)) ∧ ∀ n : ℕ, (Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) Ω)}) (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) Ω)) ^ n ≠ 0 := by
    intro Ω _
    constructor
    · rintro ⟨u, hu⟩
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (↑u⁻¹ : MvPowerSeries (Fin 2) Ω ⧸
        Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) Ω)})
      have h1 : Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 :
          MvPowerSeries (Fin 2) Ω)}) (MvPowerSeries.X 0 * y) =
          Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 :
          MvPowerSeries (Fin 2) Ω)}) 1 := by
        rw [map_mul, hy, ← hu, Units.mul_inv, map_one]
      rw [Ideal.Quotient.eq, Ideal.mem_span_singleton'] at h1
      obtain ⟨a, ha⟩ := h1
      have h2 := congrArg MvPowerSeries.constantCoeff ha
      simp at h2
    · intro n hn
      rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at hn
      obtain ⟨a, ha⟩ := hn
      have h2 := congrArg (MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) n)) ha
      rw [MvPowerSeries.X_pow_eq, MvPowerSeries.coeff_monomial_same] at h2
      have hXX : (MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) Ω) =
          MvPowerSeries.monomial (Finsupp.single 0 1 + Finsupp.single 1 1) 1 := by
        rw [MvPowerSeries.X_def, MvPowerSeries.X_def, MvPowerSeries.monomial_mul_monomial, mul_one]
      rw [hXX, MvPowerSeries.coeff_mul_monomial, if_neg] at h2
      · exact one_ne_zero h2.symm
      · intro hle
        exact absurd (hle 1) (by simp)

  have s2 : ∀ (X : Scheme.{u}) (Z : Set ↥X), Z ∈ irreducibleComponents ↥X → ∀ ξ : ↥X, closure {ξ} = Z → ∀ p : Ideal (X.presheaf.stalk ξ), p.IsPrime → p = IsLocalRing.maximalIdeal (X.presheaf.stalk ξ) := by
    intro X Z hZ ξ hξ p hp
    let P : PrimeSpectrum (X.presheaf.stalk ξ) := ⟨p, hp⟩
    have hy : X.fromSpecStalk ξ P ⤳ ξ := by
      have : X.fromSpecStalk ξ P ∈ Set.range (X.fromSpecStalk ξ) := ⟨P, rfl⟩
      rw [Scheme.range_fromSpecStalk] at this
      exact this
    have hsub : Z ⊆ closure {X.fromSpecStalk ξ P} := by
      rw [← hξ]; exact specializes_iff_closure_subset.mp hy
    have hmem : X.fromSpecStalk ξ P ∈ closure {ξ} := by
      rw [hξ]
      exact hZ.2 isIrreducible_singleton.closure hsub (subset_closure (Set.mem_singleton _))
    have heq : X.fromSpecStalk ξ P = ξ := (hy.antisymm (specializes_iff_mem_closure.mpr hmem)).eq
    have hP : P = IsLocalRing.closedPoint _ := by
      apply (X.fromSpecStalk ξ).isEmbedding.injective
      rw [heq, Scheme.fromSpecStalk_closedPoint]
    exact congrArg PrimeSpectrum.asIdeal hP

  have s3 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], (∀ p : Ideal A, p.IsPrime → p = IsLocalRing.maximalIdeal A) → (∀ x : AdicCompletion (IsLocalRing.maximalIdeal A) A, ∃ a : A, algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a = x) ∧ ∀ a : A, IsUnit a ∨ IsNilpotent a := by
    intro A _ _ _ hp
    have hnil : nilradical A = IsLocalRing.maximalIdeal A := by
      apply le_antisymm (nilradical_le_prime _)
      rw [nilradical_eq_sInf]
      apply le_sInf
      intro J hJ
      rw [hp J hJ]
    obtain ⟨N, hN⟩ := IsNoetherianRing.isNilpotent_nilradical A
    rw [hnil] at hN
    have hpowN : ∀ n, N ≤ n →
        (IsLocalRing.maximalIdeal A) ^ n • (⊤ : Submodule A A) = ⊥ := by
      intro n hn
      rw [Ideal.smul_eq_mul, Ideal.mul_top]
      have hN' : (IsLocalRing.maximalIdeal A) ^ N = ⊥ := by rw [hN]; rfl
      apply le_bot_iff.mp
      calc (IsLocalRing.maximalIdeal A) ^ n ≤ (IsLocalRing.maximalIdeal A) ^ N :=
            Ideal.pow_le_pow_right hn
        _ = ⊥ := hN'
    refine ⟨?_, ?_⟩
    · haveI : IsPrecomplete (IsLocalRing.maximalIdeal A) A := by
        refine IsPrecomplete.mk ?_
        intro f hf
        refine ⟨f N, fun n => ?_⟩
        rcases le_total n N with h | h
        · exact hf h
        · have := hf h
          rw [hpowN N le_rfl, SModEq.bot] at this
          rw [this]
      intro x
      obtain ⟨a, ha⟩ := AdicCompletion.of_surjective (IsLocalRing.maximalIdeal A) A x
      exact ⟨a, by rw [AdicCompletion.algebraMap_apply]; exact ha⟩
    · intro a
      by_cases ha : IsUnit a
      · exact Or.inl ha
      · right
        have : a ∈ nilradical A := by
          rw [hnil]; exact (IsLocalRing.mem_maximalIdeal a).mpr ha
        exact mem_nilradical.mp this

  intro K _ _ R hκ Y v hss D₀ hD₀ ξ₀ hξ₀
  haveI : IsProper v := hss.2.1
  haveI : IsAlgClosed (IsLocalRing.ResidueField ↥R) := hκ
  haveI : IsLocallyNoetherian (Limits.pullback v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))))
  rcases hss.2.2 (IsLocalRing.ResidueField ↥R)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) ξ₀ with
    hsm | ⟨e, -⟩
  swap
  · exfalso
    obtain ⟨hsurj, hdich⟩ := s3 _ (s2 _ D₀ hD₀ ξ₀ hξ₀)
    obtain ⟨a, ha⟩ := hsurj (e.symm (Ideal.Quotient.mk _ (MvPowerSeries.X 0)))
    have hφ : (e.toRingHom.comp (algebraMap _ (AdicCompletion (IsLocalRing.maximalIdeal _) _))) a
        = Ideal.Quotient.mk _ (MvPowerSeries.X 0) := by
      show e (algebraMap _ _ a) = _
      rw [ha]
      exact e.apply_symm_apply _
    rcases hdich a with hu | ⟨n, hn⟩
    · apply (s1 (IsLocalRing.ResidueField ↥R)).1
      rw [← hφ]
      exact hu.map _
    · apply (s1 (IsLocalRing.ResidueField ↥R)).2 n
      rw [← hφ, ← map_pow, hn, map_zero]
  have hLFP := wcpa_dj_mn_flat_fp (Spec (.of ↥R)) Y v hss.1 inferInstance
  obtain ⟨W', hW', hW'sm⟩ := wcpa_dj_bsc_smooth_descend (Spec (.of ↥R)) Y v
    (IsLocalRing.ResidueField ↥R)
    (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) ξ₀ hss.1 hLFP hsm
  haveI := hW'sm
  haveI hdomW := wcpa_dj_lus_cvs_smooth_valuation_stalk_domain K R W'.toScheme (W'.ι ≫ v)
    (⟨_, hW'⟩ : W')
  haveI hdom : IsDomain (Y.presheaf.stalk (Limits.pullback.fst v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) ξ₀)) :=
    MulEquiv.isDomain _ (W'.stalkIso (⟨_, hW'⟩ : W')).symm.commRingCatIsoToRingEquiv.toMulEquiv
  refine ⟨Y.fromSpecStalk (Limits.pullback.fst v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) ξ₀)
      (genericPoint _), ?_⟩
  intro y' hy'
  have h1 : y' ∈ Set.range (Y.fromSpecStalk (Limits.pullback.fst v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) ξ₀)) := by
    rw [Scheme.range_fromSpecStalk]; exact hy'
  obtain ⟨q, rfl⟩ := h1
  exact (genericPoint_specializes q).map (Y.fromSpecStalk _).continuous

theorem wcpa_dj_lfc_afcaf_closure_pure : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : ValuationSubring K), IsAlgClosed (IsLocalRing.ResidueField ↥R) → ∀ (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)), wcpaDjSemistable v → ∀ E ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))), ∀ y₀ : ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))), Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) y₀ ∈ closure ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) '' E) → ∃ D ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))), y₀ ∈ D ∧ (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) '' D ⊆ closure ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) '' E) :=
by
  intro K _ _ R hκ Y v hss E hE y₀ hy₀
  classical
  haveI := hκ
  haveI : IsProper v := hss.2.1
  obtain ⟨_, ⟨hKemb, hKrange⟩, ⟨h0emb, h0range⟩, _⟩ :=
    wcpa_dj_lus_cvs_fibre_topology K R Y v hss
  obtain ⟨hnoeth, hdim⟩ := wcpa_dj_lus_cvs_ct_closed_fibre_dim K R hκ Y v hss
  haveI := hnoeth
  set fK := Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) with hfK
  set f0 := Limits.pullback.fst v
    (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) with hf0
  set η := genericPoint (Spec (.of ↥R)) with hη
  set 𝔪 := IsLocalRing.closedPoint ↥R with h𝔪
  set Cl := closure (fK '' E) with hCl
  set T := f0 ⁻¹' Cl with hT
  have hEcl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
  obtain ⟨z, hzE⟩ : ∃ z, closure {z} = E := by
    refine ⟨hE.1.genericPoint, ?_⟩
    have h1 := hE.1.isGenericPoint_genericPoint_closure
    rw [hEcl.closure_eq] at h1
    exact h1
  have hzmem : z ∈ E := by rw [← hzE]; exact subset_closure rfl
  have hClg : Cl ⊆ closure {fK z} := by
    apply closure_minimal _ isClosed_closure
    rintro _ ⟨w, hw, rfl⟩
    rw [← hzE] at hw
    have h1 : z ⤳ w := specializes_iff_mem_closure.mpr hw
    exact specializes_iff_mem_closure.mp (h1.map fK.continuous)
  have hgCl : fK z ∈ Cl := subset_closure ⟨z, hzmem, rfl⟩
  have hvK : ∀ y, v (fK y) = η := by
    intro y
    have h1 : fK y ∈ Set.range fK := ⟨y, rfl⟩
    rw [hKrange] at h1
    exact h1
  have hv0 : ∀ y, v (f0 y) = 𝔪 := by
    intro y
    have h1 : f0 y ∈ Set.range f0 := ⟨y, rfl⟩
    rw [h0range] at h1
    exact h1
  have hfKinj : Function.Injective fK := hKemb.injective
  by_contra hno
  have hno' : ∀ D ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))), y₀ ∈ D → ¬ D ⊆ T :=
    fun D hD hyD hDT => hno ⟨D, hD, hyD, Set.image_subset_iff.mpr hDT⟩
  have hTcl : IsClosed T := isClosed_closure.preimage f0.continuous
  obtain ⟨U, hUo, hyU, hUT⟩ :=
    wcpa_dj_lus_cvs_ct_dim_one_topology _ hdim T hTcl y₀ hy₀ hno'
  obtain ⟨V, hVo, hVU⟩ := h0emb.toIsEmbedding.toIsInducing.isOpen_iff.mp hUo
  have hyV : f0 y₀ ∈ V := by
    rw [← hVU] at hyU
    exact hyU
  have hiso : ∀ x' ∈ V ∩ Cl, v x' = v (f0 y₀) → x' = f0 y₀ := by
    rintro x' ⟨hx'V, hx'Cl⟩ hvx
    rw [hv0 y₀] at hvx
    obtain ⟨y', rfl⟩ : x' ∈ Set.range f0 := by rw [h0range]; exact hvx
    have hy'U : y' ∈ U ∩ T := ⟨by rw [← hVU]; exact hx'V, hx'Cl⟩
    rw [hUT] at hy'U
    rw [Set.mem_singleton_iff.mp hy'U]
  obtain ⟨V1, hV1o, hyV1, hV1⟩ :=
    wcpa_dj_lus_cvs_ct_closed_isolated_spread Y (Spec (.of ↥R)) v inferInstance Cl
      isClosed_closure (f0 y₀) hy₀ ⟨V, hVo, hyV, hiso⟩
  have hgy : fK z ⤳ f0 y₀ := specializes_iff_mem_closure.mpr (hClg hy₀)
  have hgV1 : fK z ∈ V1 := hgy.mem_open hV1o hyV1
  obtain ⟨V2, hV2o, hgV2, hV2⟩ := hV1 (fK z) ⟨hgV1, hgCl⟩
  have hOE : (fK ⁻¹' V2) ∩ E = {z} := by
    ext e
    constructor
    · rintro ⟨heV, heE⟩
      have h1 : fK e = fK z :=
        hV2 (fK e) ⟨heV, subset_closure ⟨e, heE, rfl⟩⟩ (by rw [hvK e, hvK z])
      exact Set.mem_singleton_iff.mpr (hfKinj h1)
    · intro he
      rw [Set.mem_singleton_iff] at he
      rw [he]
      exact ⟨hgV2, hzmem⟩
  haveI : JacobsonSpace ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) :=
    LocallyOfFiniteType.jacobsonSpace (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))))
  have hlc : IsLocallyClosed ({z} : Set ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))))) := by
    rw [← hOE]
    exact (hV2o.preimage fK.continuous).isLocallyClosed.inter hEcl.isLocallyClosed
  have hzcl : IsClosed ({z} : Set ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))))) :=
    isClosed_singleton_of_isLocallyClosed_singleton hlc
  have hssK := wcpa_dj_mm_semistable_basechange (Spec (.of ↥R)) (Spec (.of K)) Y
    (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) v hss
  exact (wcpa_dj_lsp_generic_smooth K _ _ hssK z (by rw [hzE]; exact hE)).1 hzcl

theorem wcpa_dj_lfc_afcaf_pl_closure_component : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : ValuationSubring K) (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)), wcpaDjSemistable v → ∀ E ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))), closure ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) '' E) ∈ irreducibleComponents ↥Y :=
by
  intro K _ _ R Y v hss E hE
  obtain ⟨_, ⟨hKemb, hKrange⟩, _, _⟩ := wcpa_dj_lus_cvs_fibre_topology K R Y v hss
  set fK := Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) with hfK
  have hEcl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
  obtain ⟨z, hz⟩ : ∃ z, closure {z} = E := ⟨hE.1.genericPoint, by
      have h1 := hE.1.isGenericPoint_genericPoint_closure
      rw [hEcl.closure_eq] at h1
      exact h1⟩
  have hzE : z ∈ E := by rw [← hz]; exact subset_closure (Set.mem_singleton z)
  have hZirr : IsIrreducible (closure (fK '' E)) :=
    (hE.1.image fK fK.continuous.continuousOn).closure
  have hgZ : fK z ∈ closure (fK '' E) := subset_closure ⟨z, hzE, rfl⟩
  have hvg : v (fK z) = genericPoint (Spec (.of ↥R)) := by
    have h : fK z ∈ Set.range fK := ⟨z, rfl⟩
    rw [hKrange] at h
    exact h
  have hgcl : closure {fK z} ⊆ closure (fK '' E) :=
    closure_minimal (Set.singleton_subset_iff.mpr hgZ) isClosed_closure
  refine ⟨hZirr, ?_⟩
  intro Z' hZ' hsub
  have hζ := hZ'.isGenericPoint_genericPoint_closure
  have hb : hZ'.genericPoint ⤳ fK z := hζ.specializes (subset_closure (hsub hgZ))
  have hvζ : v hZ'.genericPoint = genericPoint (Spec (.of ↥R)) := by
    have h1 : v hZ'.genericPoint ⤳ v (fK z) := hb.map v.continuous
    rw [hvg] at h1
    have h2 : genericPoint (Spec (.of ↥R)) ⤳ v hZ'.genericPoint :=
      genericPoint_specializes (v hZ'.genericPoint)
    exact (h1.antisymm h2).eq
  obtain ⟨z', hz'⟩ : hZ'.genericPoint ∈ Set.range fK := by rw [hKrange]; exact hvζ
  have he : z' ⤳ z := hKemb.toIsInducing.specializes_iff.mp (by rw [hz']; exact hb)
  have hf : E ⊆ closure {z'} := by rw [← hz]; exact specializes_iff_closure_subset.mp he
  have hg : closure {z'} ⊆ E := hE.2 isIrreducible_singleton.closure hf
  have hz'E : z' ∈ E := hg (subset_closure (Set.mem_singleton z'))
  have hh : z ⤳ z' := specializes_iff_mem_closure.mpr (by rw [hz]; exact hz'E)
  have hzz : z' = z := (he.antisymm hh).eq
  have hζg : hZ'.genericPoint = fK z := by rw [← hz', hzz]
  calc Z' ⊆ closure Z' := subset_closure
    _ = closure {hZ'.genericPoint} := (isGenericPoint_def.mp hζ).symm
    _ = closure {fK z} := by rw [hζg]
    _ ⊆ closure (fK '' E) := hgcl

theorem wcpa_dj_lfc_afcaf_pl_integral_flat : ∀ (K : Type u) [Field K] (R : ValuationSubring K) (X : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] (w : X ⟶ Spec (.of ↥R)), w (genericPoint X) = genericPoint (Spec (.of ↥R)) → Flat w :=
by
  intro K _ R X _ w hw

  have s1 : ∀ (A B : Type u) [CommRing A] [IsDomain A] [IsBezout A] [CommRing B] [IsDomain B]
      (φ : A →+* B), Function.Injective φ → φ.Flat := by
    intro A B _ _ _ _ _ φ hφ
    algebraize [φ]
    change Module.Flat A B
    rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout,
      ← Submodule.isTorsionFree_iff_torsion_eq_bot,
      Module.isTorsionFree_iff_algebraMap_injective]
    exact hφ

  have s2 : ∀ (V : X.Opens), (V : Set X).Nonempty →
      Function.Injective (w.appLE ⊤ V le_top).hom := by
    intro V hV
    rw [injective_iff_map_eq_zero]
    intro s hs
    by_contra hne
    have h1 := Scheme.basicOpen_appLE w V ⊤ le_top s
    rw [hs, Scheme.basicOpen_zero] at h1
    have hD : (Spec (.of ↥R)).basicOpen s ≠ ⊥ := by
      rw [ne_eq, AlgebraicGeometry.basicOpen_eq_bot_iff]
      exact hne
    have hη : genericPoint (Spec (.of ↥R)) ∈ (Spec (.of ↥R)).basicOpen s := by
      have := ((genericPoint_spec (Spec (.of ↥R))).mem_open_set_iff
        ((Spec (.of ↥R)).basicOpen s).isOpen).mpr
      apply this
      rw [Set.univ_inter]
      exact (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hD
    have hξV : genericPoint X ∈ V :=
      ((genericPoint_spec X).mem_open_set_iff V.isOpen).mpr (by rw [Set.univ_inter]; exact hV)
    have hξ : genericPoint X ∈ V ⊓ w ⁻¹ᵁ (Spec (.of ↥R)).basicOpen s := by
      refine ⟨hξV, ?_⟩
      show w (genericPoint X) ∈ (Spec (.of ↥R)).basicOpen s
      rw [hw]; exact hη
    rw [← h1] at hξ
    exact hξ

  have hB : IsBezout Γ(Spec (.of ↥R), ⊤) :=
    Function.Surjective.isBezout (Scheme.ΓSpecIso (.of ↥R)).inv.hom
      (fun y => ⟨(Scheme.ΓSpecIso _).hom.hom y, by simp⟩)
  let ι := {U : X.affineOpens // (U : Set X).Nonempty}
  have hcover : ⨆ i : ι, (i.1 : X.Opens) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    obtain ⟨W, hW, hxW, -⟩ :=
      exists_isAffineOpen_mem_and_subset (show x ∈ (⊤ : X.Opens) from trivial)
    rw [TopologicalSpace.Opens.mem_iSup]
    exact ⟨⟨⟨W, hW⟩, ⟨x, hxW⟩⟩, hxW⟩
  apply HasRingHomProperty.of_iSup_eq_top (P := @Flat) (Q := RingHom.Flat)
    (fun i : ι => i.1) hcover
  intro i
  have : Nonempty (i.1 : X.Opens) := i.2.to_subtype
  have : IsDomain Γ(X, i.1) := IsIntegral.component_integral _
  exact s1 _ _ _ (s2 i.1 i.2)

theorem wcpa_dj_lfc_afcaf_pl_closed_bc : ∀ {Y S T X : Scheme.{u}} (v : Y ⟶ S) (s : T ⟶ S) (ι : X ⟶ Y), IsClosedImmersion ι → IsClosedImmersion (Limits.pullback.map (ι ≫ v) s v s ι (𝟙 T) (𝟙 S) (Category.comp_id (ι ≫ v)) ((Category.comp_id s).trans (Category.id_comp s).symm)) ∧ Set.range (Limits.pullback.map (ι ≫ v) s v s ι (𝟙 T) (𝟙 S) (Category.comp_id (ι ≫ v)) ((Category.comp_id s).trans (Category.id_comp s).symm)) = (Limits.pullback.fst v s) ⁻¹' Set.range ι ∧ Limits.pullback.map (ι ≫ v) s v s ι (𝟙 T) (𝟙 S) (Category.comp_id (ι ≫ v)) ((Category.comp_id s).trans (Category.id_comp s).symm) ≫ Limits.pullback.snd v s = Limits.pullback.snd (ι ≫ v) s :=
by
  intro Y S T X v s ι hι
  have H1 : Limits.pullback.map (ι ≫ v) s v s ι (𝟙 T) (𝟙 S) (Category.comp_id (ι ≫ v))
      ((Category.comp_id s).trans (Category.id_comp s).symm) ≫ Limits.pullback.fst v s =
      Limits.pullback.fst (ι ≫ v) s ≫ ι := Limits.pullback.lift_fst _ _ _
  have H2 : Limits.pullback.map (ι ≫ v) s v s ι (𝟙 T) (𝟙 S) (Category.comp_id (ι ≫ v))
      ((Category.comp_id s).trans (Category.id_comp s).symm) ≫ Limits.pullback.snd v s =
      Limits.pullback.snd (ι ≫ v) s :=
    (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)
  have Sq : IsPullback (Limits.pullback.map (ι ≫ v) s v s ι (𝟙 T) (𝟙 S) (Category.comp_id (ι ≫ v))
      ((Category.comp_id s).trans (Category.id_comp s).symm))
      (Limits.pullback.fst (ι ≫ v) s) (Limits.pullback.fst v s) ι := by
    refine IsPullback.of_right (h₁₂ := Limits.pullback.snd v s) (h₂₂ := v) (v₁₃ := s) ?_ H1
      (IsPullback.of_hasPullback v s).flip
    rw [H2]
    exact (IsPullback.of_hasPullback (ι ≫ v) s).flip
  have hcl := MorphismProperty.of_isPullback (P := @IsClosedImmersion) Sq.flip hι
  refine ⟨hcl, ?_, H2⟩
  ext y
  constructor
  · rintro ⟨x, rfl⟩
    refine ⟨Limits.pullback.fst (ι ≫ v) s x, ?_⟩
    rw [← Scheme.Hom.comp_apply, ← H1, Scheme.Hom.comp_apply]
  · intro hy
    rw [← Scheme.Pullback.range_fst (Limits.pullback.fst v s) ι] at hy
    obtain ⟨z, rfl⟩ := hy
    obtain ⟨w, rfl⟩ := Sq.isoPullback.hom.surjective z
    refine ⟨w, ?_⟩
    rw [← Scheme.Hom.comp_apply, Sq.isoPullback_hom_fst]

theorem wcpa_dj_lfc_afcaf_pl_reduced_closed_unique : ∀ {X₁ X₂ Y : Scheme.{u}} (i₁ : X₁ ⟶ Y) (i₂ : X₂ ⟶ Y), IsClosedImmersion i₁ → IsClosedImmersion i₂ → IsReduced X₁ → IsReduced X₂ → Set.range i₁ = Set.range i₂ → ∃ e : X₁ ≅ X₂, e.hom ≫ i₂ = i₁ :=
by
  intro X₁ X₂ Y i₁ i₂ h₁ h₂ r₁ r₂ hr
  have hrad : ∀ {Z : Scheme.{u}} (i : Z ⟶ Y), IsClosedImmersion i → IsReduced Z →
      (Scheme.Hom.ker i).radical = Scheme.Hom.ker i := by
    intro Z i hi hZ
    haveI := hi
    haveI := hZ
    ext U : 2
    rw [Scheme.IdealSheafData.radical_ideal, Scheme.Hom.ker_apply]
    have hs := i.app_surjective U U.2
    exact ((RingHom.ker_isRadical_iff_reduced_of_surjective hs).mpr inferInstance).radical
  haveI := h₁
  haveI := h₂
  have hsupp : (Scheme.Hom.ker i₁).support = (Scheme.Hom.ker i₂).support := by
    apply SetLike.coe_injective
    rw [Scheme.Hom.support_ker, Scheme.Hom.support_ker, hr]
  have hker : Scheme.Hom.ker i₁ = Scheme.Hom.ker i₂ := by
    rw [← hrad i₁ h₁ r₁, ← hrad i₂ h₂ r₂, ← Scheme.IdealSheafData.vanishingIdeal_support,
      ← Scheme.IdealSheafData.vanishingIdeal_support, hsupp]
  haveI := IsClosedImmersion.isIso_lift i₁ i₂ hker
  refine ⟨(asIso (IsClosedImmersion.lift i₁ i₂ hker.le)).symm, ?_⟩
  have hfac := IsClosedImmersion.lift_fac i₁ i₂ hker.le
  rw [Iso.symm_hom, asIso_inv, IsIso.inv_comp_eq, hfac]

theorem wcpa_dj_bfr_fibre_stalk : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Y : Scheme.{u}) (v : Y ⟶ Spec (.of A)) (x : ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))))), Function.Surjective (Scheme.Hom.stalkMap (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))) x).hom ∧ RingHom.ker (Scheme.Hom.stalkMap (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))) x).hom = Ideal.map ((Scheme.ΓSpecIso (.of A)).inv ≫ v.appTop ≫ Y.presheaf.germ ⊤ (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) x) trivial).hom (IsLocalRing.maximalIdeal A) :=
by
  intro A _ _ Y v x


  have PB : ∀ {T Z L Y : Scheme.{u}} (p : T ⟶ Z) (f : T ⟶ L) (h : Z ⟶ Y)
      (lam : L ⟶ Y), IsPullback p f h lam → IsClosedImmersion lam →
      ∀ (ξ : T) (t : L) (ht : f ξ = t) (e : h (p ξ) = lam t),
        Function.Surjective (p.stalkMap ξ).hom ∧
          RingHom.ker (p.stalkMap ξ).hom =
            Ideal.map (wcLdnmTvRho h (p ξ) (lam t) e) (RingHom.ker (lam.stalkMap t).hom) := by
    intro T Z L Y p f h lam hp hlam ξ t ht e
    subst ht
    haveI : IsClosedImmersion lam := hlam
    haveI hpc : IsClosedImmersion p :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hp.flip hlam
    have hπs : Function.Surjective (p.stalkMap ξ).hom := SurjectiveOnStalks.stalkMap_surjective p ξ
    have hlams : Function.Surjective (lam.stalkMap (f ξ)).hom :=
      SurjectiveOnStalks.stalkMap_surjective lam (f ξ)
    have hpinj : Function.Injective p := p.isClosedEmbedding.injective
    have key : Y.presheaf.stalkSpecializes (specializes_of_eq e) ≫
        h.stalkMap (p ξ) ≫ p.stalkMap ξ = lam.stalkMap (f ξ) ≫ f.stalkMap ξ := by
      have helper : ∀ (g₁ g₂ : T ⟶ Y) (hg : g₁ = g₂) (y : Y) (e1 : g₁ ξ = y) (e2 : g₂ ξ = y),
          Y.presheaf.stalkSpecializes (specializes_of_eq e1) ≫ g₁.stalkMap ξ =
            Y.presheaf.stalkSpecializes (specializes_of_eq e2) ≫ g₂.stalkMap ξ := by
        intro g₁ g₂ hg y e1 e2
        subst hg
        rfl
      have h1 := helper (p ≫ h) (f ≫ lam) hp.w ((f ≫ lam) ξ) e rfl
      rw [Scheme.Hom.stalkMap_comp p h ξ, Scheme.Hom.stalkMap_comp f lam ξ,
        TopCat.Presheaf.stalkSpecializes_refl] at h1
      exact h1.trans (Category.id_comp _)
    have s2 : ∀ x : Y.presheaf.stalk (lam (f ξ)),
        (p.stalkMap ξ).hom (wcLdnmTvRho h (p ξ) (lam (f ξ)) e x) =
          (f.stalkMap ξ).hom ((lam.stalkMap (f ξ)).hom x) := by
      intro x
      exact congrArg (fun φ => φ.hom x) key
    have s3 : Ideal.map (wcLdnmTvRho h (p ξ) (lam (f ξ)) e) (RingHom.ker (lam.stalkMap (f ξ)).hom) ≤
        RingHom.ker (p.stalkMap ξ).hom := by
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, RingHom.mem_ker, s2 x, RingHom.mem_ker.mp hx, map_zero]
    refine ⟨hπs, le_antisymm ?_ s3⟩
    set I := Ideal.map (wcLdnmTvRho h (p ξ) (lam (f ξ)) e)
      (RingHom.ker (lam.stalkMap (f ξ)).hom) with hIdef
    by_cases hI : I = ⊤
    · rw [hI]; exact le_top
    haveI : Nontrivial (Z.presheaf.stalk (p ξ) ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
    haveI hQloc : IsLocalRing (Z.presheaf.stalk (p ξ) ⧸ I) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    let Q : CommRingCat.{u} := CommRingCat.of (Z.presheaf.stalk (p ξ) ⧸ I)
    haveI : IsLocalRing Q := hQloc
    let φ : Z.presheaf.stalk (p ξ) ⟶ Q := CommRingCat.ofHom (Ideal.Quotient.mk I)
    haveI : IsLocalHom φ.hom :=
      Function.Surjective.isLocalHom (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    have hK : RingHom.ker (lam.stalkMap (f ξ)).hom ≤
        RingHom.ker ((Ideal.Quotient.mk I).comp (wcLdnmTvRho h (p ξ) (lam (f ξ)) e)) := by
      intro x hx
      rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_map_of_mem _ hx
    let μ0 := ((lam.stalkMap (f ξ)).hom.liftOfSurjective hlams) ⟨_, hK⟩
    have hμ0 : μ0.comp (lam.stalkMap (f ξ)).hom =
        (Ideal.Quotient.mk I).comp (wcLdnmTvRho h (p ξ) (lam (f ξ)) e) :=
      RingHom.liftOfSurjective_comp _ hlams _
    let μ : L.presheaf.stalk (f ξ) ⟶ Q := CommRingCat.ofHom μ0
    have hcone : lam.stalkMap (f ξ) ≫ μ =
        Y.presheaf.stalkSpecializes (specializes_of_eq e) ≫ h.stalkMap (p ξ) ≫ φ := by
      ext x
      exact RingHom.congr_fun hμ0 x
    have hY1 : Y.fromSpecStalk (h (p ξ)) =
        Spec.map (Y.presheaf.stalkSpecializes (specializes_of_eq e)) ≫ Y.fromSpecStalk (lam (f ξ)) :=
      (Scheme.SpecMap_stalkSpecializes_fromSpecStalk (specializes_of_eq e)).symm
    have w : (Spec.map φ ≫ Z.fromSpecStalk (p ξ)) ≫ h = (Spec.map μ ≫ L.fromSpecStalk (f ξ)) ≫ lam := by
      have e1 := congrArg Spec.map hcone
      simp only [Spec.map_comp, Category.assoc] at e1
      rw [Category.assoc, Category.assoc, ← Scheme.SpecMap_stalkMap_fromSpecStalk h,
        ← Scheme.SpecMap_stalkMap_fromSpecStalk lam, hY1, reassoc_of% e1]
    let ℓ : Spec Q ⟶ T := hp.lift _ _ w
    have hℓ : ℓ ≫ p = Spec.map φ ≫ Z.fromSpecStalk (p ξ) := hp.lift_fst _ _ w
    have hcp : (Spec.map φ) (IsLocalRing.closedPoint Q) =
        IsLocalRing.closedPoint (Z.presheaf.stalk (p ξ)) := Spec_closedPoint
    have hapt0 : (Spec.map φ ≫ Z.fromSpecStalk (p ξ)) (IsLocalRing.closedPoint Q) = p ξ := by
      change Z.fromSpecStalk (p ξ) ((Spec.map φ) (IsLocalRing.closedPoint Q)) = p ξ
      exact (congrArg (Z.fromSpecStalk (p ξ)) hcp).trans Scheme.fromSpecStalk_closedPoint
    have hpt : ℓ (IsLocalRing.closedPoint Q) = ξ := by
      apply hpinj
      change (ℓ ≫ p) (IsLocalRing.closedPoint Q) = p ξ
      exact (congrArg (fun g : Spec Q ⟶ Z => g (IsLocalRing.closedPoint Q)) hℓ).trans hapt0
    intro v hv
    rw [RingHom.mem_ker] at hv
    obtain ⟨U, hU, s, rfl⟩ := Z.presheaf.exists_germ_eq v
    have H0 : (T.presheaf.germ (p ⁻¹ᵁ U) ξ hU) ((p.app U) s) = 0 := by
      rw [← Scheme.Hom.germ_stalkMap_apply p U ξ hU s]; exact hv
    have hU' : (Spec.map φ ≫ Z.fromSpecStalk (p ξ)) (IsLocalRing.closedPoint Q) ∈ U :=
      Eq.mpr (congrArg (· ∈ U) hapt0) hU
    have E1s := congrArg (fun g => g.hom s) (Scheme.germ_stalkClosedPointTo_Spec_fromSpecStalk φ U hU')
    have gen : ∀ (g : Spec Q ⟶ Z) (hg : g = ℓ ≫ p) (hgU : g (IsLocalRing.closedPoint Q) ∈ U),
        (Scheme.stalkClosedPointTo g).hom ((Z.presheaf.germ U _ hgU).hom s) =
          (Scheme.stalkClosedPointTo ℓ).hom ((T.presheaf.germ (p ⁻¹ᵁ U)
            (ℓ (IsLocalRing.closedPoint Q)) (by subst hg; exact hgU)).hom ((p.app U).hom s)) := by
      rintro g rfl hgU
      rw [Scheme.stalkClosedPointTo_comp]
      exact congrArg (Scheme.stalkClosedPointTo ℓ).hom (Scheme.Hom.germ_stalkMap_apply p U _ hgU s)
    have gen2 : ∀ (x : T) (hx : x ∈ p ⁻¹ᵁ U), x = ξ →
        (T.presheaf.germ (p ⁻¹ᵁ U) x hx).hom ((p.app U).hom s) = 0 := by
      rintro x hx rfl; exact H0
    have h3 := gen _ hℓ.symm hU'
    rw [gen2 _ _ hpt, map_zero] at h3
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    exact E1s.symm.trans h3

  have hlam : IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (algebraMap A (IsLocalRing.ResidueField A)))) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have e : v (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom
        (algebraMap A (IsLocalRing.ResidueField A)))) x) =
      (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))
        (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom
          (algebraMap A (IsLocalRing.ResidueField A)))) x) := by
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
  obtain ⟨hsurj, hker1⟩ := PB _ _ v _ (IsPullback.of_hasPullback v _) hlam x _ rfl e

  have hz : ∀ t : ↥(Spec (.of (IsLocalRing.ResidueField A))),
      Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))) t =
        IsLocalRing.closedPoint A := by
    intro t
    haveI : IsLocalHom (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))).hom :=
      Function.Surjective.isLocalHom _ IsLocalRing.residue_surjective
    have ht : t = IsLocalRing.closedPoint (IsLocalRing.ResidueField A) := Subsingleton.elim _ _
    rw [ht]
    exact Spec_closedPoint

  have hgs : ∀ z : ↥(Spec (.of A)), z = IsLocalRing.closedPoint A →
      Function.Surjective ((Scheme.ΓSpecIso (.of A)).inv ≫
        (Spec (.of A)).presheaf.germ ⊤ z trivial).hom := by
    rintro z rfl
    have h0 := ΓSpecIso_hom_stalkClosedPointIso_inv (CommRingCat.of A)
    have h1 : (Scheme.ΓSpecIso (.of A)).inv ≫ (Spec (.of A)).presheaf.germ ⊤
        (IsLocalRing.closedPoint A) trivial = (stalkClosedPointIso (.of A)).inv := by
      rw [← cancel_epi (Scheme.ΓSpecIso (.of A)).hom, Iso.hom_inv_id_assoc]
      exact h0.symm
    rw [h1]
    exact (ConcreteCategory.bijective_of_isIso _).2

  have hs4 : ∀ t : ↥(Spec (.of (IsLocalRing.ResidueField A))),
      Ideal.comap ((Scheme.ΓSpecIso (.of A)).inv ≫ (Spec (.of A)).presheaf.germ ⊤
        (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))) t) trivial).hom
        (RingHom.ker (Scheme.Hom.stalkMap (Spec.map (CommRingCat.ofHom
          (algebraMap A (IsLocalRing.ResidueField A)))) t).hom) = IsLocalRing.maximalIdeal A := by
    intro t
    have hfac : (Scheme.ΓSpecIso (.of A)).inv ≫ (Spec (.of A)).presheaf.germ ⊤
        (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))) t) trivial ≫
        Scheme.Hom.stalkMap (Spec.map (CommRingCat.ofHom
          (algebraMap A (IsLocalRing.ResidueField A)))) t =
        CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)) ≫
          (Scheme.ΓSpecIso (.of (IsLocalRing.ResidueField A))).inv ≫
          (Spec (.of (IsLocalRing.ResidueField A))).presheaf.germ ⊤ t trivial := by
      rw [← Category.assoc (CommRingCat.ofHom _), Scheme.ΓSpecIso_inv_naturality, Category.assoc]
      exact congrArg (fun φ => (Scheme.ΓSpecIso (.of A)).inv ≫ φ)
        (Scheme.Hom.germ_stalkMap _ ⊤ t trivial)
    rw [RingHom.comap_ker, ← CommRingCat.hom_comp, Category.assoc, hfac, CommRingCat.hom_comp,
      CommRingCat.hom_ofHom, RingHom.ker_comp_of_injective _ (RingHom.injective _)]
    exact IsLocalRing.ker_residue

  have hrho : ∀ (z : ↥(Spec (.of A))) (e : v (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom
        (algebraMap A (IsLocalRing.ResidueField A)))) x) = z),
      (wcLdnmTvRho v _ z e).comp ((Spec (.of A)).presheaf.germ ⊤ z trivial).hom =
        (v.appTop ≫ Y.presheaf.germ ⊤ (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom
          (algebraMap A (IsLocalRing.ResidueField A)))) x) trivial).hom := by
    rintro z rfl
    unfold wcLdnmTvRho
    rw [TopCat.Presheaf.stalkSpecializes_refl, CommRingCat.hom_id, RingHom.comp_id,
      ← CommRingCat.hom_comp]
    exact congrArg CommRingCat.Hom.hom (Scheme.Hom.germ_stalkMap v ⊤ _ trivial)

  refine ⟨hsurj, ?_⟩
  rw [hker1]
  have hK : RingHom.ker (Scheme.Hom.stalkMap (Spec.map (CommRingCat.ofHom
        (algebraMap A (IsLocalRing.ResidueField A)))) (Limits.pullback.snd v (Spec.map
          (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) x)).hom =
      Ideal.map ((Scheme.ΓSpecIso (.of A)).inv ≫ (Spec (.of A)).presheaf.germ ⊤
        (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))
          (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom
            (algebraMap A (IsLocalRing.ResidueField A)))) x)) trivial).hom
        (IsLocalRing.maximalIdeal A) := by
    rw [← hs4, Ideal.map_comap_of_surjective _ (hgs _ (hz _))]
  rw [hK, Ideal.map_map]
  have hRG : (wcLdnmTvRho v _ _ e).comp ((Scheme.ΓSpecIso (.of A)).inv ≫
      (Spec (.of A)).presheaf.germ ⊤ _ trivial).hom =
      ((Scheme.ΓSpecIso (.of A)).inv ≫ v.appTop ≫ Y.presheaf.germ ⊤
        (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom
          (algebraMap A (IsLocalRing.ResidueField A)))) x) trivial).hom := by
    rw [CommRingCat.hom_comp, ← RingHom.comp_assoc, hrho _ e, ← CommRingCat.hom_comp]
  rw [hRG]

theorem wcpa_dj_bfr_closed_fibre_reduced : ∀ (A : Type u) [CommRing A] [IsLocalRing A], IsAlgClosed (IsLocalRing.ResidueField A) → ∀ (Y : Scheme.{u}) (v : Y ⟶ Spec (.of A)), wcpaDjSemistable v → ∀ w : ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))), _root_.IsReduced ((Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).presheaf.stalk w) :=
by
  intro A _ _ hκ Y v hss w
  haveI : IsAlgClosed (IsLocalRing.ResidueField A) := hκ
  haveI : IsProper v := hss.2.1
  rcases hss.2.2 (IsLocalRing.ResidueField A)
      (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) w with
    ⟨W, hwW, hWsm⟩ | ⟨e, he⟩
  · haveI := hWsm
    haveI hd : IsDomain (W.toScheme.presheaf.stalk ⟨w, hwW⟩) :=
      wcpa_smooth_stalk_isDomain (IsLocalRing.ResidueField A) W.toScheme
        (W.ι ≫ Limits.pullback.snd v
          (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))) 1 ⟨w, hwW⟩
    haveI : IsDomain ((Limits.pullback v (Spec.map (CommRingCat.ofHom
        (algebraMap A (IsLocalRing.ResidueField A))))).presheaf.stalk w) :=
      MulEquiv.isDomain _ (W.stalkIso ⟨w, hwW⟩).symm.commRingCatIsoToRingEquiv.toMulEquiv
    infer_instance
  · haveI : IsLocallyNoetherian (Limits.pullback v (Spec.map (CommRingCat.ofHom
        (algebraMap A (IsLocalRing.ResidueField A))))) :=
      LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd v
        (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))))
    exact wcpa_dj_nf_node_reduced _ _ _ ⟨e, he⟩

theorem wcpa_dj_bfr_node_zero_fibre_poly : ∀ (K : Type u) [Field K] (R : ValuationSubring K) (a : ↥R), a = 0 → (∃ π : wcNcRing R a →+* Polynomial (IsLocalRing.ResidueField ↥R), Function.Surjective π ∧ RingHom.ker π = Ideal.span {Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 0)} ⊔ Ideal.map (algebraMap ↥R (wcNcRing R a)) (IsLocalRing.maximalIdeal ↥R)) ∧ (∃ π : wcNcRing R a →+* Polynomial (IsLocalRing.ResidueField ↥R), Function.Surjective π ∧ RingHom.ker π = Ideal.span {Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 1)} ⊔ Ideal.map (algebraMap ↥R (wcNcRing R a)) (IsLocalRing.maximalIdeal ↥R)) ∧ Ideal.span {Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 0)} ⊓ Ideal.span {Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 1)} = ⊥ :=
by
  intro K _ R a ha
  subst ha
  classical
  have hcov : ∀ n : Fin 2, n = 0 ∨ n = 1 := by decide

  have hkill : ∀ {S : Type u} [CommRing S] (Φ : MvPolynomial (Fin 2) ↥R →+* S),
      Φ (MvPolynomial.X 0) * Φ (MvPolynomial.X 1) = 0 → ∀ x ∈ wcNcIdeal R 0, Φ x = 0 := by
    intro S _ Φ hΦ x hx
    have hle : wcNcIdeal R 0 ≤ RingHom.ker Φ := by
      unfold wcNcIdeal
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      simp [hΦ]
    exact hle hx
  have halg : ∀ r : ↥R, algebraMap ↥R (wcNcRing R 0) r =
      Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.C r) := by
    intro r
    rfl

  have branch : ∀ (i j : Fin 2), (∀ n : Fin 2, n = i ∨ n = j) →
      ∀ Φ : MvPolynomial (Fin 2) ↥R →+* Polynomial ↥R,
      (∀ r, Φ (MvPolynomial.C r) = Polynomial.C r) → Φ (MvPolynomial.X i) = 0 →
      Φ (MvPolynomial.X j) = Polynomial.X → (∀ x ∈ wcNcIdeal R 0, Φ x = 0) →
      ∃ (ψ : wcNcRing R 0 →+* Polynomial ↥R) (σ : Polynomial ↥R →+* wcNcRing R 0),
        (∀ r, ψ (algebraMap ↥R (wcNcRing R 0) r) = Polynomial.C r) ∧
        ψ (Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X i)) = 0 ∧
        σ.comp Polynomial.C = algebraMap ↥R (wcNcRing R 0) ∧
        σ Polynomial.X = Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X j) ∧
        (∀ s, ψ (σ s) = s) ∧
        (∀ z, z - σ (ψ z) ∈
          Ideal.span {Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X i)}) := by
    intro i j hij Φ hC hi hj hΦ
    obtain ⟨σ, hσC, hσX⟩ : ∃ σ : Polynomial ↥R →+* wcNcRing R 0,
        (∀ r, σ (Polynomial.C r) = Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.C r)) ∧
        σ Polynomial.X = Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X j) :=
      ⟨(Ideal.Quotient.mk (wcNcIdeal R 0)).comp
        (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X j)), fun r => by simp, by simp⟩
    refine ⟨Ideal.Quotient.lift (wcNcIdeal R 0) Φ hΦ, σ, ?_, ?_, ?_, hσX, ?_, ?_⟩
    · intro r
      rw [halg, Ideal.Quotient.lift_mk, hC]
    · rw [Ideal.Quotient.lift_mk, hi]
    · apply RingHom.ext
      intro r
      rw [RingHom.comp_apply, hσC, halg]
    · intro s
      have h : (Ideal.Quotient.lift (wcNcIdeal R 0) Φ hΦ).comp σ = RingHom.id _ := by
        apply Polynomial.ringHom_ext
        · intro r
          rw [RingHom.comp_apply, hσC, Ideal.Quotient.lift_mk, hC, RingHom.id_apply]
        · rw [RingHom.comp_apply, hσX, Ideal.Quotient.lift_mk, hj, RingHom.id_apply]
      exact RingHom.congr_fun h s
    · intro z
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
      rw [Ideal.Quotient.lift_mk]
      induction p using MvPolynomial.induction_on
      next r =>
        rw [hC, hσC, sub_self]
        exact Ideal.zero_mem _
      next p q hp hq =>
        simp only [map_add]
        rw [add_sub_add_comm]
        exact Ideal.add_mem _ hp hq
      next p n hp =>
        simp only [map_mul]
        rcases hij n with h | h
        · rw [h, hi, map_zero, mul_zero, sub_zero]
          exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
        · rw [h, hj, hσX, ← sub_mul]
          obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hp
          exact Ideal.mem_span_singleton'.mpr
            ⟨c * Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X j), by rw [← hc]; ring⟩

  have fib : ∀ (i j : Fin 2), (∀ n : Fin 2, n = i ∨ n = j) →
      ∀ Φ : MvPolynomial (Fin 2) ↥R →+* Polynomial ↥R,
      (∀ r, Φ (MvPolynomial.C r) = Polynomial.C r) → Φ (MvPolynomial.X i) = 0 →
      Φ (MvPolynomial.X j) = Polynomial.X → (∀ x ∈ wcNcIdeal R 0, Φ x = 0) →
      ∃ π : wcNcRing R 0 →+* Polynomial (IsLocalRing.ResidueField ↥R), Function.Surjective π ∧
        RingHom.ker π = Ideal.span {Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X i)} ⊔
          Ideal.map (algebraMap ↥R (wcNcRing R 0)) (IsLocalRing.maximalIdeal ↥R) := by
    intro i j hij Φ hC hi hj hΦ
    obtain ⟨ψ, σ, hψC, hψi, hσC, hσX, hsec, hnf⟩ := branch i j hij Φ hC hi hj hΦ
    refine ⟨(Polynomial.mapRingHom (IsLocalRing.residue ↥R)).comp ψ, ?_, ?_⟩
    · intro f
      obtain ⟨g, hg⟩ := Polynomial.map_surjective (IsLocalRing.residue ↥R)
        IsLocalRing.residue_surjective f
      exact ⟨σ g, by rw [RingHom.comp_apply, hsec, Polynomial.coe_mapRingHom, hg]⟩
    · apply le_antisymm
      · intro z hz
        rw [RingHom.mem_ker, RingHom.comp_apply] at hz
        have h1 : ψ z ∈ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥R) := by
          rw [← IsLocalRing.ker_residue, ← Polynomial.ker_mapRingHom]
          exact hz
        have h2 : σ (ψ z) ∈
            Ideal.map (algebraMap ↥R (wcNcRing R 0)) (IsLocalRing.maximalIdeal ↥R) := by
          rw [← hσC, ← Ideal.map_map]
          exact Ideal.mem_map_of_mem σ h1
        have h3 : z = (z - σ (ψ z)) + σ (ψ z) := by ring
        rw [h3]
        exact Ideal.add_mem _ (Ideal.mem_sup_left (hnf z)) (Ideal.mem_sup_right h2)
      · apply sup_le
        · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
            RingHom.comp_apply, hψi, map_zero]
        · rw [Ideal.map_le_iff_le_comap]
          intro r hr
          rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply, hψC,
            Polynomial.coe_mapRingHom, Polynomial.map_C,
            (IsLocalRing.residue_eq_zero_iff r).mpr hr, map_zero]
  obtain ⟨Φ0, hΦ0C, hΦ0a, hΦ0b⟩ : ∃ Φ : MvPolynomial (Fin 2) ↥R →+* Polynomial ↥R,
      (∀ r, Φ (MvPolynomial.C r) = Polynomial.C r) ∧ Φ (MvPolynomial.X 0) = 0 ∧
        Φ (MvPolynomial.X 1) = Polynomial.X :=
    ⟨MvPolynomial.eval₂Hom Polynomial.C ![0, Polynomial.X], fun r => by simp, by simp, by simp⟩
  obtain ⟨Φ1, hΦ1C, hΦ1a, hΦ1b⟩ : ∃ Φ : MvPolynomial (Fin 2) ↥R →+* Polynomial ↥R,
      (∀ r, Φ (MvPolynomial.C r) = Polynomial.C r) ∧ Φ (MvPolynomial.X 0) = Polynomial.X ∧
        Φ (MvPolynomial.X 1) = 0 :=
    ⟨MvPolynomial.eval₂Hom Polynomial.C ![Polynomial.X, 0], fun r => by simp, by simp, by simp⟩
  have k0 := hkill Φ0 (by rw [hΦ0a, zero_mul])
  have k1 := hkill Φ1 (by rw [hΦ1b, mul_zero])
  refine ⟨fib 0 1 hcov Φ0 hΦ0C hΦ0a hΦ0b k0,
    fib 1 0 (fun n => (hcov n).symm) Φ1 hΦ1C hΦ1b hΦ1a k1, ?_⟩

  obtain ⟨ψ1, σ1, -, hψ1x, -, hσ1X, hsec1, hnf1⟩ :=
    branch 1 0 (fun n => (hcov n).symm) Φ1 hΦ1C hΦ1b hΦ1a k1
  have hx10 : Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X 1) *
      Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X 0) = 0 := by
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    apply Ideal.subset_span
    rw [Set.mem_singleton_iff, map_zero, sub_zero, mul_comm]
  rw [eq_bot_iff]
  rintro z ⟨hz0, hz1⟩
  obtain ⟨A, hA⟩ := Ideal.mem_span_singleton'.mp hz0
  obtain ⟨B, hB⟩ := Ideal.mem_span_singleton'.mp hz1
  have hψz : ψ1 z = 0 := by rw [← hB, map_mul, hψ1x, mul_zero]
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (hnf1 A)
  have hz : z = σ1 (ψ1 A * Polynomial.X) := by
    rw [map_mul, hσ1X, ← hA]
    linear_combination (-(Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X 0))) * hc + c * hx10
  have hg : ψ1 A * Polynomial.X = 0 := by
    have h := congrArg ψ1 hz
    rw [hsec1, hψz] at h
    exact h.symm
  have hg0 : ψ1 A = 0 := Polynomial.monic_X.mul_left_eq_zero_iff.mp hg
  rw [Ideal.mem_bot, hz, hg0, zero_mul, map_zero]

theorem wcpa_dj_bfr_etale_loc_quot_reduced : ∀ (N T : Type u) [CommRing N] [CommRing T] [Algebra N T] [Algebra.Etale N T] (q : Ideal T) [q.IsPrime] (J : Ideal N) (D : Type u) [CommRing D] [IsDomain D] (π : N →+* D), Function.Surjective π → RingHom.ker π = J → _root_.IsReduced (Localization.AtPrime q ⧸ Ideal.map ((algebraMap T (Localization.AtPrime q)).comp (algebraMap N T)) J) :=
by
  intro N T _ _ _ _ q _ J D _ _ π _ hker
  classical
  haveI hJ : J.IsPrime := hker ▸ RingHom.ker_isPrime π
  rw [← IsScalarTower.algebraMap_eq N T (Localization.AtPrime q)]
  let e₁ := Algebra.TensorProduct.quotIdealMapEquivTensorQuot (Localization.AtPrime q) J
  haveI : Module.Flat N (Localization.AtPrime q) := Module.Flat.trans N T (Localization.AtPrime q)
  haveI : Algebra.FormallyUnramified N (Localization.AtPrime q) :=
    Algebra.FormallyUnramified.comp N T (Localization.AtPrime q)
  haveI : _root_.IsReduced (TensorProduct N (FractionRing (N ⧸ J)) (Localization.AtPrime q)) :=
    Algebra.FormallyUnramified.isReduced_of_field (FractionRing (N ⧸ J))
      (TensorProduct N (FractionRing (N ⧸ J)) (Localization.AtPrime q))
  let e₂ := Algebra.TensorProduct.comm N (Localization.AtPrime q) (FractionRing (N ⧸ J))
  haveI : _root_.IsReduced (TensorProduct N (Localization.AtPrime q) (FractionRing (N ⧸ J))) :=
    isReduced_of_injective e₂ e₂.injective
  let ι : (N ⧸ J) →ₐ[N] FractionRing (N ⧸ J) := IsScalarTower.toAlgHom N (N ⧸ J) _
  have hι : Function.Injective ι := IsFractionRing.injective (N ⧸ J) (FractionRing (N ⧸ J))
  let Φ := Algebra.TensorProduct.map (AlgHom.id N (Localization.AtPrime q)) ι
  have hΦ : Function.Injective Φ := by
    have h := Module.Flat.lTensor_preserves_injective_linearMap (M := Localization.AtPrime q)
      ι.toLinearMap hι
    convert h using 1
    ext x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul l a => rfl
    | add x y hx hy => simp only [map_add, hx, hy]
  haveI : _root_.IsReduced (TensorProduct N (Localization.AtPrime q) (N ⧸ J)) :=
    isReduced_of_injective Φ hΦ
  exact isReduced_of_injective e₁ e₁.injective

theorem wcpa_dj_lfc_afcaf_pl_branch_fibre_reduced : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : ValuationSubring K), IsAlgClosed (IsLocalRing.ResidueField ↥R) → ∀ (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)), wcpaDjSemistable v → ∀ y : Y, v y = IsLocalRing.closedPoint ↥R → ∀ P ∈ minimalPrimes (Y.presheaf.stalk y), _root_.IsReduced ((Y.presheaf.stalk y) ⧸ (P ⊔ Ideal.map ((Scheme.ΓSpecIso (.of ↥R)).inv ≫ v.appTop ≫ Y.presheaf.germ ⊤ y trivial).hom (IsLocalRing.maximalIdeal ↥R))) :=
by
  intro K _ _ R hκ Y v hss y hy P hP
  classical
  haveI : Flat v := hss.1
  haveI : IsProper v := hss.2.1

  have hdom : IsDomain (Y.presheaf.stalk y) → P = ⊥ := fun hd => by
    haveI := hd
    exact le_antisymm (hP.2 ⟨Ideal.isPrime_bot, bot_le⟩ bot_le) bot_le
  by_cases hP0 : P = ⊥
  ·
    subst hP0
    rw [bot_sup_eq]
    obtain ⟨_, _, ⟨_, h0range⟩, _⟩ := wcpa_dj_lus_cvs_fibre_topology K R Y v hss
    obtain ⟨y₀, rfl⟩ : y ∈ Set.range (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) := by
      rw [h0range]; exact hy
    obtain ⟨hsurj, hker⟩ := wcpa_dj_bfr_fibre_stalk (↥R) Y v y₀
    haveI := wcpa_dj_bfr_closed_fibre_reduced (↥R) hκ Y v hss y₀
    let e := (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hsurj)
    exact isReduced_of_injective e e.injective

  have hns : ¬ ∃ W : Y.Opens, y ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ v) := by
    rintro ⟨W, hW, hWsm⟩
    haveI := hWsm
    haveI hdomW := wcpa_dj_lus_cvs_smooth_valuation_stalk_domain K R W.toScheme (W.ι ≫ v)
      (⟨y, hW⟩ : W)
    haveI hd : IsDomain (Y.presheaf.stalk y) :=
      MulEquiv.isDomain _ (W.stalkIso (⟨y, hW⟩ : W)).symm.commRingCatIsoToRingEquiv.toMulEquiv
    exact hP0 (hdom hd)

  have hlfp := wcpa_dj_mn_flat_fp (Spec (.of ↥R)) Y v hss.1 inferInstance
  have hnd := wcpa_dj_nc_nonsmooth_fibre_node K R Y v y hκ hss hlfp hy hns
  obtain ⟨U, e, a, m, x', he, hm, hcomm, hex, hX0, hX1⟩ :=
    wcpa_dj_nc_chart_exists K R Y v y hκ hss.1 hlfp hy hnd
  obtain ⟨T, _, _, _, q, _, ψ, hψf, hψl, hψc, hmem⟩ :=
    wcpa_dj_lus_tbw_chart_stalk_ring ↥R Y v y U e (wcNcRing R a) m x' he hm hcomm hex
  have hX0' := hmem _ hX0
  have hX1' := hmem _ hX1
  letI : Algebra (Y.presheaf.stalk y) (Localization.AtPrime q) := ψ.toAlgebra
  haveI : Module.Flat (Y.presheaf.stalk y) (Localization.AtPrime q) := hψf
  haveI : IsLocalHom (algebraMap (Y.presheaf.stalk y) (Localization.AtPrime q)) := hψl
  haveI hff : Module.FaithfullyFlat (Y.presheaf.stalk y) (Localization.AtPrime q) :=
    Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hinj : Function.Injective ψ :=
    FaithfulSMul.algebraMap_injective (Y.presheaf.stalk y) (Localization.AtPrime q)
  rcases eq_or_ne a 0 with ha0 | ha
  swap
  ·
    obtain ⟨hd, hi⟩ := wcpa_dj_lus_tbw_node_ring_normal K R a ha
    haveI := hd
    haveI := hi
    haveI hB : IsDomain (Localization.AtPrime q) :=
      wc_ring_etale_localization_isDomain (wcNcRing R a) T q
    exact absurd (hdom (Function.Injective.isDomain ψ hinj)) hP0

  have key : ∀ (N T : Type u) [CommRing N] [Algebra ↥R N] [CommRing T] [Algebra N T]
      [Algebra.Etale N T] (q : Ideal T) [q.IsPrime]
      (ψ : Y.presheaf.stalk y →+* Localization.AtPrime q), ψ.Flat → IsLocalHom ψ →
      ψ.comp ((Scheme.ΓSpecIso (.of ↥R)).inv ≫ v.appTop ≫ Y.presheaf.germ ⊤ y trivial).hom =
        (algebraMap T (Localization.AtPrime q)).comp ((algebraMap N T).comp (algebraMap ↥R N)) →
      ∀ x₀ x₁ : N, x₀ * x₁ = 0 →
      (Ideal.span {algebraMap T (Localization.AtPrime q) (algebraMap N T x₀)}).IsPrime →
      (Ideal.span {algebraMap T (Localization.AtPrime q) (algebraMap N T x₁)}).IsPrime →
      Ideal.span {x₀} ⊓ Ideal.span {x₁} = ⊥ →
      (∃ ρ : N →+* Polynomial (IsLocalRing.ResidueField ↥R), Function.Surjective ρ ∧
        RingHom.ker ρ = Ideal.span {x₀} ⊔ Ideal.map (algebraMap ↥R N) (IsLocalRing.maximalIdeal ↥R)) →
      (∃ ρ : N →+* Polynomial (IsLocalRing.ResidueField ↥R), Function.Surjective ρ ∧
        RingHom.ker ρ = Ideal.span {x₁} ⊔ Ideal.map (algebraMap ↥R N) (IsLocalRing.maximalIdeal ↥R)) →
      _root_.IsReduced ((Y.presheaf.stalk y) ⧸ (P ⊔ Ideal.map ((Scheme.ΓSpecIso (.of ↥R)).inv ≫
        v.appTop ≫ Y.presheaf.germ ⊤ y trivial).hom (IsLocalRing.maximalIdeal ↥R))) := by
    intro N T _ _ _ _ _ q _ ψ hψf hψl hψc x₀ x₁ hx01 hxp hyp hinf ⟨ρx, hρxs, hρxk⟩ ⟨ρy, hρys, hρyk⟩
    letI : Algebra (Y.presheaf.stalk y) (Localization.AtPrime q) := ψ.toAlgebra
    haveI : Module.Flat (Y.presheaf.stalk y) (Localization.AtPrime q) := hψf
    haveI : IsLocalHom (algebraMap (Y.presheaf.stalk y) (Localization.AtPrime q)) := hψl
    haveI hff : Module.FaithfullyFlat (Y.presheaf.stalk y) (Localization.AtPrime q) :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hinj : Function.Injective ψ :=
      FaithfulSMul.algebraMap_injective (Y.presheaf.stalk y) (Localization.AtPrime q)
    set ιB : N →+* Localization.AtPrime q :=
      (algebraMap T (Localization.AtPrime q)).comp (algebraMap N T) with hιB
    have hιflat : ιB.Flat :=
      RingHom.Flat.comp (RingHom.flat_algebraMap_iff.mpr inferInstance)
        (RingHom.flat_algebraMap_iff.mpr inferInstance)
    change (Ideal.span {ιB x₀}).IsPrime at hxp
    change (Ideal.span {ιB x₁}).IsPrime at hyp

    have NI : ∀ (B : Type u) [CommRing B] (ι : N →+* B), ι.Flat →
        Ideal.span {ι x₀} ⊓ Ideal.span {ι x₁} = ⊥ := by
      intro B _ ι hι
      letI := ι.toAlgebra
      haveI : Module.Flat N B := hι
      rw [eq_bot_iff]
      rintro b ⟨hb0, hb1⟩
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hb0
      obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp hb1
      obtain ⟨κ, a', z, h1, h2⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
        (f := ![x₀, -x₁]) (x := ![c, d]) (by
          rw [Fin.sum_univ_two]
          simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Algebra.smul_def, map_neg]
          show ι x₀ * c + -ι x₁ * d = 0
          linear_combination hc - hd)
      have hc' : c = ∑ j, a' 0 j • z j := by simpa using h1 0
      have h3 : ∀ j, x₀ * a' 0 j = 0 := by
        intro j
        have h4 : x₀ * a' 0 j + -x₁ * a' 1 j = 0 := by simpa [Fin.sum_univ_two] using h2 j
        have h5 : x₀ * a' 0 j = x₁ * a' 1 j := by linear_combination h4
        have h6 : x₀ * a' 0 j ∈ Ideal.span {x₀} ⊓ Ideal.span {x₁} :=
          ⟨Ideal.mem_span_singleton'.mpr ⟨a' 0 j, mul_comm _ _⟩,
            Ideal.mem_span_singleton'.mpr ⟨a' 1 j, by rw [h5, mul_comm]⟩⟩
        rw [hinf] at h6
        exact h6
      rw [Ideal.mem_bot, ← hc, hc', Finset.sum_mul]
      refine Finset.sum_eq_zero (fun j _ => ?_)
      rw [Algebra.smul_def]
      show ι (a' 0 j) * z j * ι x₀ = 0
      rw [show ι (a' 0 j) * z j * ι x₀ = ι (x₀ * a' 0 j) * z j by rw [map_mul]; ring, h3,
        map_zero, zero_mul]
    have hinfB : Ideal.span {ιB x₀} ⊓ Ideal.span {ιB x₁} = ⊥ := NI _ ιB hιflat
    have hψc' : ψ.comp ((Scheme.ΓSpecIso (.of ↥R)).inv ≫ v.appTop ≫
        Y.presheaf.germ ⊤ y trivial).hom = ιB.comp (algebraMap ↥R N) := by
      rw [hψc, hιB]; rfl

    have branch : ∀ (u w : N) (ρ : N →+* Polynomial (IsLocalRing.ResidueField ↥R)),
        Function.Surjective ρ →
        RingHom.ker ρ = Ideal.span {u} ⊔
          Ideal.map (algebraMap ↥R N) (IsLocalRing.maximalIdeal ↥R) →
        u * w = 0 → (Ideal.span {ιB w}).IsPrime → Ideal.span {ιB u} ⊓ Ideal.span {ιB w} = ⊥ →
        P = Ideal.comap ψ (Ideal.span {ιB u}) →
        _root_.IsReduced ((Y.presheaf.stalk y) ⧸ (P ⊔ Ideal.map ((Scheme.ΓSpecIso (.of ↥R)).inv ≫
          v.appTop ≫ Y.presheaf.germ ⊤ y trivial).hom (IsLocalRing.maximalIdeal ↥R))) := by
      intro u w ρ hρs hρk huw hwp huw0 hPx
      haveI hPprime : P.IsPrime := hP.1.1

      have hext : Ideal.map ψ P = Ideal.span {ιB u} := by
        have hPQ : P ⊓ Ideal.comap ψ (Ideal.span {ιB w}) = ⊥ := by
          rw [hPx, ← Ideal.comap_inf, huw0]
          exact (RingHom.injective_iff_ker_eq_bot ψ).mp hinj
        have hQP : ¬ Ideal.comap ψ (Ideal.span {ιB w}) ≤ P := by
          intro hle
          have h1 : P ≤ Ideal.comap ψ (Ideal.span {ιB w}) :=
            haveI := hwp; hP.2 ⟨Ideal.IsPrime.comap ψ, bot_le⟩ hle
          exact hP0 (by rw [← inf_eq_left.mpr h1, hPQ])
        obtain ⟨r, hrQ, hrP⟩ := Set.not_subset.mp hQP
        have hr : r • ιB u = 0 := by
          obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp
            (show ψ r ∈ Ideal.span {ιB w} from hrQ)
          rw [Algebra.smul_def]
          show ψ r * ιB u = 0
          rw [← ht, mul_assoc, mul_comm (ιB w), ← map_mul, huw, map_zero, mul_zero]
        have hxmem : ιB u ∈ Ideal.map ψ P := by
          obtain ⟨κ, a', z, h1, h2⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
            (f := ![r]) (x := ![ιB u]) (by simpa using hr)
          have hx : ιB u = ∑ j, a' 0 j • z j := by simpa using h1 0
          rw [hx]
          refine Ideal.sum_mem _ (fun j _ => ?_)
          have h3 : r * a' 0 j = 0 := by simpa using h2 j
          have h4 : a' 0 j ∈ P := by
            have h5 : r * a' 0 j ∈ P := by rw [h3]; exact P.zero_mem
            exact (hPprime.mem_or_mem h5).resolve_left hrP
          rw [Algebra.smul_def]
          exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem ψ h4)
        apply le_antisymm
        · rw [hPx]; exact Ideal.map_comap_le
        · exact (Ideal.span_singleton_le_iff_mem _).mpr hxmem

      have hid : Ideal.map ψ (P ⊔ Ideal.map ((Scheme.ΓSpecIso (.of ↥R)).inv ≫
          v.appTop ≫ Y.presheaf.germ ⊤ y trivial).hom (IsLocalRing.maximalIdeal ↥R)) =
          Ideal.map ιB (Ideal.span {u} ⊔
            Ideal.map (algebraMap ↥R N) (IsLocalRing.maximalIdeal ↥R)) := by
        rw [Ideal.map_sup, Ideal.map_sup, hext, Ideal.map_map, Ideal.map_map, hψc',
          Ideal.map_span, Set.image_singleton]

      have hredB := wcpa_dj_bfr_etale_loc_quot_reduced N T q _
        (Polynomial (IsLocalRing.ResidueField ↥R)) ρ hρs hρk
      rw [← hιB, ← hid] at hredB

      have hc := Ideal.comap_map_eq_self_of_faithfullyFlat (A := Y.presheaf.stalk y)
        (B := Localization.AtPrime q) (P ⊔ Ideal.map ((Scheme.ΓSpecIso (.of ↥R)).inv ≫
          v.appTop ≫ Y.presheaf.germ ⊤ y trivial).hom (IsLocalRing.maximalIdeal ↥R))
      exact isReduced_of_injective (Ideal.quotientMap _ ψ Ideal.le_comap_map)
        (Ideal.quotientMap_injective' (le_of_eq hc))

    have hxy : ιB x₀ * ιB x₁ = 0 := by rw [← map_mul, hx01, map_zero]
    haveI := hP.1.1
    obtain ⟨𝔓, h𝔓⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat
      (A := Y.presheaf.stalk y) (B := Localization.AtPrime q) ⟨P, hP.1.1⟩
    have h𝔓' : 𝔓.asIdeal.comap ψ = P := congrArg PrimeSpectrum.asIdeal h𝔓
    obtain ⟨P', hP', hP'le⟩ := Ideal.exists_minimalPrimes_le
      (I := (⊥ : Ideal (Localization.AtPrime q))) (J := 𝔓.asIdeal) bot_le
    haveI := hP'.1.1
    have hle1 : P'.comap ψ ≤ P := by
      rw [← h𝔓']; exact Ideal.comap_mono hP'le
    have hcomap : P'.comap ψ = P :=
      le_antisymm hle1 (hP.2 ⟨inferInstance, bot_le⟩ hle1)
    have h0 : ιB x₀ * ιB x₁ ∈ P' := by rw [hxy]; exact P'.zero_mem
    rcases hP'.1.1.mem_or_mem h0 with h | h
    · have h2 : P' = Ideal.span {ιB x₀} :=
        le_antisymm (hP'.2 ⟨hxp, bot_le⟩ ((Ideal.span_singleton_le_iff_mem _).mpr h))
          ((Ideal.span_singleton_le_iff_mem _).mpr h)
      exact branch _ _ ρx hρxs hρxk hx01 hyp hinfB (by rw [← hcomap, h2])
    · have h2 : P' = Ideal.span {ιB x₁} :=
        le_antisymm (hP'.2 ⟨hyp, bot_le⟩ ((Ideal.span_singleton_le_iff_mem _).mpr h))
          ((Ideal.span_singleton_le_iff_mem _).mpr h)
      exact branch _ _ ρy hρys hρyk (by rw [mul_comm]; exact hx01) hxp
        (by rw [inf_comm]; exact hinfB) (by rw [← hcomap, h2])

  have hx0 : (Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 0)) *
      (Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 1)) = 0 := by
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    apply Ideal.subset_span
    rw [Set.mem_singleton_iff, ha0, map_zero, sub_zero]
  obtain ⟨⟨π0, hπ0s, hπ0k⟩, ⟨π1, hπ1s, hπ1k⟩, _⟩ :=
    wcpa_dj_lus_tbw_node_zero_quot_poly K R a ha0
  have hxp := wcpa_dj_lus_tbw_etale_loc_quot_prime (wcNcRing R a) T q _ (Polynomial ↥R) π0
    hπ0s hπ0k hX0'
  have hyp := wcpa_dj_lus_tbw_etale_loc_quot_prime (wcNcRing R a) T q _ (Polynomial ↥R) π1
    hπ1s hπ1k hX1'
  obtain ⟨hρx, hρy, hinf⟩ := wcpa_dj_bfr_node_zero_fibre_poly K R a ha0
  exact key (wcNcRing R a) T q ψ hψf hψl hψc _ _ hx0 hxp hyp hinf hρx hρy

theorem wcpa_dj_lfc_afcaf_pl_closure_fibre_reduced : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Y : Scheme.{u}) (v : Y ⟶ Spec (.of A)) (X : Scheme.{u}) (ι : X ⟶ Y), IsClosedImmersion ι → IsReduced X → Set.range ι ∈ irreducibleComponents ↥Y → (∀ y : Y, v y = IsLocalRing.closedPoint A → ∀ P ∈ minimalPrimes (Y.presheaf.stalk y), _root_.IsReduced ((Y.presheaf.stalk y) ⧸ (P ⊔ Ideal.map ((Scheme.ΓSpecIso (.of A)).inv ≫ v.appTop ≫ Y.presheaf.germ ⊤ y trivial).hom (IsLocalRing.maximalIdeal A)))) → IsReduced (Limits.pullback (ι ≫ v) (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))) :=
by
  intro A _ _ Y v X ι hι hXred hZ H
  classical
  haveI := hι
  haveI hcci : IsClosedImmersion (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective

  have c4 : ∀ p : ↥(Spec (.of (IsLocalRing.ResidueField A))),
      (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) p =
        IsLocalRing.closedPoint A := by
    intro p
    obtain rfl : p = IsLocalRing.closedPoint _ := Subsingleton.elim _ _
    rw [IsLocalRing.ResidueField.algebraMap_eq]
    exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A)

  have c3 : ∀ {S T U : Type u} [CommRing S] [CommRing T] [CommRing U] (f : S →+* T) (g : T →+* U),
      Function.Surjective f → Function.Surjective g → ∀ I : Ideal S, RingHom.ker g = Ideal.map f I →
      _root_.IsReduced (S ⧸ (RingHom.ker f ⊔ I)) → _root_.IsReduced U := by
    intro S T U _ _ _ f g hf hg I hker hred
    have hh : Function.Surjective (g.comp f) := hg.comp hf
    have hk : RingHom.ker (g.comp f) = RingHom.ker f ⊔ I := by
      rw [← RingHom.comap_ker, hker, Ideal.comap_map_of_surjective f hf, sup_comm,
        RingHom.ker_eq_comap_bot]
    let e := (Ideal.quotEquivOfEq hk.symm).trans (RingHom.quotientKerEquivOfSurjective hh)
    exact isReduced_of_injective e.symm e.symm.injective

  have c2 : ∀ x : X, RingHom.ker (ι.stalkMap x).hom ∈ minimalPrimes (Y.presheaf.stalk (ι x)) := by
    intro x
    haveI hirr : IrreducibleSpace X := by
      have hemb : Topology.IsEmbedding ι := ι.isClosedEmbedding.isEmbedding
      haveI : IrreducibleSpace (Set.range ι) := Subtype.irreducibleSpace hZ.1
      exact Function.Surjective.irreducibleSpace hemb.toHomeomorph.symm.continuous
        hemb.toHomeomorph.symm.surjective
    haveI : AlgebraicGeometry.IsIntegral X := isIntegral_of_irreducibleSpace_of_isReduced X
    have hJp : (RingHom.ker (ι.stalkMap x).hom).IsPrime := RingHom.ker_isPrime _
    let o : PrimeSpectrum (X.presheaf.stalk x) := ⟨⊥, Ideal.isPrime_bot⟩
    have hgen : X.fromSpecStalk x o = genericPoint X := by
      have hr : genericPoint X ∈ Set.range (X.fromSpecStalk x) := by
        rw [Scheme.range_fromSpecStalk]; exact genericPoint_specializes x
      obtain ⟨r, hr⟩ := hr
      have h1 : o ⤳ r := (PrimeSpectrum.le_iff_specializes o r).mp
        ((PrimeSpectrum.asIdeal_le_asIdeal o r).mp bot_le)
      have h2 := h1.map (X.fromSpecStalk x).continuous
      rw [hr] at h2
      exact (h2.antisymm (genericPoint_specializes _)).eq
    let j : PrimeSpectrum (Y.presheaf.stalk (ι x)) := ⟨RingHom.ker (ι.stalkMap x).hom, hJp⟩
    have hj : Y.fromSpecStalk (ι x) j = ι (genericPoint X) := by
      have e : Y.fromSpecStalk (ι x) (Spec.map (ι.stalkMap x) o) = ι (X.fromSpecStalk x o) := by
        have := congrArg (fun f => f o) (Scheme.SpecMap_stalkMap_fromSpecStalk ι (x := x))
        exact this
      have hoj : Spec.map (ι.stalkMap x) o = j := by
        apply PrimeSpectrum.ext
        show Ideal.comap (ι.stalkMap x).hom ⊥ = RingHom.ker (ι.stalkMap x).hom
        exact (RingHom.ker_eq_comap_bot _).symm
      rw [hoj, hgen] at e
      exact e
    have hZsub : Set.range ι ⊆ closure {ι (genericPoint X)} := by
      rintro _ ⟨z, rfl⟩
      exact specializes_iff_mem_closure.mp ((genericPoint_specializes z).map ι.continuous)
    refine ⟨⟨hJp, bot_le⟩, ?_⟩
    rintro Q ⟨hQ, -⟩ hQle
    let qq : PrimeSpectrum (Y.presheaf.stalk (ι x)) := ⟨Q, hQ⟩
    have h1 : qq ⤳ j := (PrimeSpectrum.le_iff_specializes qq j).mp
      ((PrimeSpectrum.asIdeal_le_asIdeal qq j).mp hQle)
    have h2 := h1.map (Y.fromSpecStalk (ι x)).continuous
    rw [hj] at h2
    have hsub : Set.range ι ⊆ closure {Y.fromSpecStalk (ι x) qq} := hZsub.trans h2.closure_subset
    have h3 : closure {Y.fromSpecStalk (ι x) qq} = Set.range ι :=
      (hZ.2 isIrreducible_singleton.closure hsub).antisymm hsub
    have h4 : ι (genericPoint X) ⤳ Y.fromSpecStalk (ι x) qq := by
      have hm : Y.fromSpecStalk (ι x) qq ∈ Set.range ι := by
        rw [← h3]; exact subset_closure (Set.mem_singleton _)
      rw [specializes_iff_mem_closure]; exact hZsub hm
    have h5 : Y.fromSpecStalk (ι x) qq = Y.fromSpecStalk (ι x) j := by
      rw [hj]; exact (h2.antisymm h4).eq
    have h6 : qq = j := (Y.fromSpecStalk (ι x)).isEmbedding.injective h5
    have h7 : Q = RingHom.ker (ι.stalkMap x).hom := congrArg PrimeSpectrum.asIdeal h6
    exact h7.symm.le

  have c1 : ∀ {W V : Scheme.{u}} (w0 : V ⟶ Spec (.of A)) (a : W ⟶ V)
      (b : W ⟶ Spec (.of (IsLocalRing.ResidueField A))),
      IsPullback a b w0 (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) →
      ∀ x : W, RingHom.ker (a.stalkMap x).hom = Ideal.map ((Scheme.ΓSpecIso (.of A)).inv ≫
        w0.appTop ≫ V.presheaf.germ ⊤ (a x) trivial).hom (IsLocalRing.maximalIdeal A) := by
    intro W V w0 a b hsq x
    haveI : IsClosedImmersion a :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq.flip hcci
    have ha : Function.Injective a := a.isClosedEmbedding.isEmbedding.injective
    have hw : a ≫ w0 = b ≫ Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))) :=
      hsq.w
    have e1 : V.presheaf.germ ⊤ (a x) trivial ≫ a.stalkMap x = a.appTop ≫ W.presheaf.germ ⊤ x trivial :=
      Scheme.Hom.germ_stalkMap a ⊤ x trivial
    have e2 : w0.appTop ≫ a.appTop =
        (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))).appTop ≫ b.appTop := by
      rw [← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop, hw]
    have hgerm : ((Scheme.ΓSpecIso (.of A)).inv ≫ w0.appTop ≫ V.presheaf.germ ⊤ (a x) trivial) ≫
        a.stalkMap x = CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)) ≫
          (Scheme.ΓSpecIso (.of (IsLocalRing.ResidueField A))).inv ≫ b.appTop ≫
            W.presheaf.germ ⊤ x trivial := by
      rw [Scheme.ΓSpecIso_inv_naturality_assoc]
      simp only [Category.assoc]
      rw [e1, ← Category.assoc w0.appTop, e2, Category.assoc]
    obtain ⟨φ, hφ⟩ : ∃ φ, φ = (Scheme.ΓSpecIso (.of A)).inv ≫ w0.appTop ≫
        V.presheaf.germ ⊤ (a x) trivial := ⟨_, rfl⟩
    rw [← hφ] at hgerm
    rw [← hφ]
    have hfs : V.fromSpecStalk (a x) ≫ w0 = Spec.map φ := by
      rw [hφ]
      have h1 : w0 = V.toSpecΓ ≫ Spec.map w0.appTop ≫ Spec.map (Scheme.ΓSpecIso (.of A)).inv := by
        rw [← Category.assoc, ← Scheme.toSpecΓ_naturality, Category.assoc, ← SpecMap_ΓSpecIso_hom,
          ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id, Category.comp_id]
      conv_lhs => rw [h1]
      rw [Spec.map_comp, Spec.map_comp, ← Category.assoc, Scheme.fromSpecStalk_toSpecΓ,
        Category.assoc]
    have hm0 : ∀ m ∈ IsLocalRing.maximalIdeal A, algebraMap A (IsLocalRing.ResidueField A) m = 0 :=
      fun m hm => by
        rw [IsLocalRing.ResidueField.algebraMap_eq]; exact (IsLocalRing.residue_eq_zero_iff m).mpr hm
    have hsup : Ideal.map φ.hom (IsLocalRing.maximalIdeal A) ≤ RingHom.ker (a.stalkMap x).hom := by
      rw [Ideal.map_le_iff_le_comap]
      intro m hm
      rw [Ideal.mem_comap, RingHom.mem_ker]
      have e := congrArg (fun k => k.hom m) hgerm
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e
      rw [e, hm0 m hm]
      simp only [map_zero]
    obtain ⟨J, hJ⟩ : ∃ J, J = Ideal.map φ.hom (IsLocalRing.maximalIdeal A) := ⟨_, rfl⟩
    rw [← hJ] at hsup ⊢
    refine le_antisymm ?_ hsup
    have hJne : J ≠ ⊤ := by
      intro htop
      have h1 : (1 : V.presheaf.stalk (a x)) ∈ RingHom.ker (a.stalkMap x).hom :=
        hsup (by rw [htop]; exact Submodule.mem_top)
      rw [RingHom.mem_ker, map_one] at h1
      exact one_ne_zero h1
    haveI : Nontrivial (V.presheaf.stalk (a x) ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJne
    haveI : IsLocalRing (V.presheaf.stalk (a x) ⧸ J) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
    obtain ⟨π, hπ⟩ : ∃ π : V.presheaf.stalk (a x) ⟶ CommRingCat.of (V.presheaf.stalk (a x) ⧸ J),
        π = CommRingCat.ofHom (Ideal.Quotient.mk J) := ⟨_, rfl⟩
    have hπs : Function.Surjective π.hom := by
      rw [hπ]; exact Ideal.Quotient.mk_surjective
    haveI hπloc : IsLocalHom π.hom := IsLocalHom.of_surjective _ hπs
    have hπker : ∀ r, π.hom r = 0 → r ∈ J := by
      intro r hr
      rw [hπ, CommRingCat.hom_ofHom] at hr
      exact Ideal.Quotient.eq_zero_iff_mem.mp hr
    have hker : RingHom.ker (IsLocalRing.residue A) ≤ RingHom.ker (φ ≫ π).hom := by
      rw [IsLocalRing.ker_residue]
      intro m hm
      rw [RingHom.mem_ker, CommRingCat.hom_comp, RingHom.comp_apply, hπ, CommRingCat.hom_ofHom]
      apply Ideal.Quotient.eq_zero_iff_mem.mpr
      rw [hJ]
      exact Ideal.mem_map_of_mem _ hm
    let ψ := RingHom.liftOfSurjective (IsLocalRing.residue A) IsLocalRing.residue_surjective
      ⟨(φ ≫ π).hom, hker⟩
    have hψ : ψ.comp (IsLocalRing.residue A) = (φ ≫ π).hom := RingHom.liftOfSurjective_comp _ _ _
    have hφπ : φ ≫ π = CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)) ≫
        CommRingCat.ofHom ψ := by
      apply CommRingCat.hom_ext
      rw [← hψ, CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom,
        IsLocalRing.ResidueField.algebraMap_eq]
    let t : Spec (CommRingCat.of (V.presheaf.stalk (a x) ⧸ J)) ⟶ V :=
      Spec.map π ≫ V.fromSpecStalk (a x)
    have htv : t ≫ w0 = Spec.map (CommRingCat.ofHom ψ) ≫
        Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))) := by
      show (Spec.map π ≫ V.fromSpecStalk (a x)) ≫ w0 = _
      rw [Category.assoc, hfs, ← Spec.map_comp, hφπ, Spec.map_comp]
    let ℓ := hsq.lift t (Spec.map (CommRingCat.ofHom ψ)) htv
    have hℓ : ℓ ≫ a = t := hsq.lift_fst _ _ _
    let q : Spec (CommRingCat.of (V.presheaf.stalk (a x) ⧸ J)) := IsLocalRing.closedPoint _
    haveI hG : IsLocalHom (a.stalkMap (ℓ q) ≫ Scheme.stalkClosedPointTo ℓ).hom := by
      rw [CommRingCat.hom_comp]; infer_instance
    have hsymm : (SpecToEquivOfLocalRing V (CommRingCat.of (V.presheaf.stalk (a x) ⧸ J))).symm
          ⟨a (ℓ q), ⟨a.stalkMap (ℓ q) ≫ Scheme.stalkClosedPointTo ℓ, hG⟩⟩ =
        (SpecToEquivOfLocalRing V (CommRingCat.of (V.presheaf.stalk (a x) ⧸ J))).symm
          ⟨a x, ⟨π, hπloc⟩⟩ := by
      rw [SpecToEquivOfLocalRing_symm_apply, SpecToEquivOfLocalRing_symm_apply]
      show Spec.map (a.stalkMap (ℓ q) ≫ Scheme.stalkClosedPointTo ℓ) ≫ V.fromSpecStalk (a (ℓ q)) = t
      rw [Spec.map_comp, Category.assoc, Scheme.SpecMap_stalkMap_fromSpecStalk,
        ← Category.assoc, Scheme.Spec_stalkClosedPointTo_fromSpecStalk, hℓ]
    have hξ := (SpecToEquivOfLocalRing V
      (CommRingCat.of (V.presheaf.stalk (a x) ⧸ J))).symm.injective hsymm
    have hℓq : ℓ q = x := ha (congrArg Sigma.fst hξ)
    intro r hr
    rw [RingHom.mem_ker] at hr
    apply hπker
    have claim : ∀ (w' : W) (_ : x = w')
        (G : W.presheaf.stalk w' ⟶ CommRingCat.of (V.presheaf.stalk (a x) ⧸ J))
        (hG' : IsLocalHom (a.stalkMap w' ≫ G).hom),
        (⟨a w', ⟨a.stalkMap w' ≫ G, hG'⟩⟩ : (z : V) × { f : V.presheaf.stalk z ⟶
          CommRingCat.of (V.presheaf.stalk (a x) ⧸ J) // IsLocalHom f.hom }) =
          ⟨a x, ⟨π, hπloc⟩⟩ → π.hom r = 0 := by
      rintro w' rfl G hG' heq
      rw [Sigma.mk.inj_iff] at heq
      have h2 : a.stalkMap x ≫ G = π := congrArg Subtype.val (eq_of_heq heq.2)
      rw [← h2, CommRingCat.hom_comp, RingHom.comp_apply, hr, map_zero]
    exact claim (ℓ q) hℓq.symm _ hG hξ

  haveI hstalk : ∀ x : ↥(Limits.pullback (ι ≫ v)
      (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))),
      _root_.IsReduced ((Limits.pullback (ι ≫ v)
        (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).presheaf.stalk x) := by
    intro x
    have hker := c1 (ι ≫ v) (Limits.pullback.fst (ι ≫ v)
      (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))))
      (Limits.pullback.snd (ι ≫ v)
      (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))))
      (IsPullback.of_hasPullback _ _) x
    have hgs : Function.Surjective ((Limits.pullback.fst (ι ≫ v)
        (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).stalkMap x).hom :=
      Scheme.Hom.stalkMap_surjective _ _
    have hcond := congrArg (fun k => k x) (Limits.pullback.condition (f := ι ≫ v)
      (g := Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))))
    simp only [Scheme.Hom.comp_apply] at hcond
    set x' := Limits.pullback.fst (ι ≫ v)
      (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) x with hx'
    have hvy : v (ι x') = IsLocalRing.closedPoint A := by rw [hcond]; exact c4 _
    have c5 : (Scheme.ΓSpecIso (.of A)).inv ≫ (ι ≫ v).appTop ≫ X.presheaf.germ ⊤ x' trivial =
        ((Scheme.ΓSpecIso (.of A)).inv ≫ v.appTop ≫ Y.presheaf.germ ⊤ (ι x') trivial) ≫
          ι.stalkMap x' := by
      rw [Scheme.Hom.comp_appTop]
      simp only [Category.assoc]
      exact (congrArg (fun k => (Scheme.ΓSpecIso (.of A)).inv ≫ v.appTop ≫ k)
        (Scheme.Hom.germ_stalkMap ι ⊤ x' trivial)).symm
    rw [c5, CommRingCat.hom_comp, ← Ideal.map_map] at hker
    have hR := H (ι x') hvy _ (c2 x')
    exact c3 (ι.stalkMap x').hom _ (Scheme.Hom.stalkMap_surjective ι x') hgs _ hker hR
  exact isReduced_of_isReduced_stalk _

theorem wcpa_dj_lfc_afcaf_pl_section : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥W)), IsProper v → Flat v → LocallyOfFinitePresentation v → (∃ θκ : Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W)) MvPolynomial.gradedAlgebra, θκ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W)) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField ↥W) ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W) 0))) = Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) → ∃ sY : Spec (.of ↥W) ⟶ Y, sY ≫ v = 𝟙 _ :=
