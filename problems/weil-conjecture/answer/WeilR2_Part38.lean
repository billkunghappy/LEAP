theorem wcpa_dj_lus_cvs_ct_ns_qg_spec_adjoin_ext : ∀ (R : Type u) [CommRing R] (F : Polynomial R) (T : Scheme.{u}) (φ₁ φ₂ : T ⟶ Spec (.of (AdjoinRoot F))), φ₁ ≫ Spec.map (CommRingCat.ofHom (AdjoinRoot.of F)) = φ₂ ≫ Spec.map (CommRingCat.ofHom (AdjoinRoot.of F)) → φ₁.appTop.hom ((Scheme.ΓSpecIso (.of (AdjoinRoot F))).inv.hom (AdjoinRoot.root F)) = φ₂.appTop.hom ((Scheme.ΓSpecIso (.of (AdjoinRoot F))).inv.hom (AdjoinRoot.root F)) → φ₁ = φ₂ :=
by
  intro R _ F T φ₁ φ₂ h1 h2
  apply ext_of_isAffine
  rw [← cancel_epi (Scheme.ΓSpecIso (.of (AdjoinRoot F))).inv]
  apply CommRingCat.hom_ext
  apply AdjoinRoot.ringHom_ext
  · have key : ∀ φ : T ⟶ Spec (.of (AdjoinRoot F)),
        CommRingCat.ofHom (AdjoinRoot.of F) ≫ (Scheme.ΓSpecIso (.of (AdjoinRoot F))).inv ≫ φ.appTop =
        (Scheme.ΓSpecIso (.of R)).inv ≫
          (φ ≫ Spec.map (CommRingCat.ofHom (AdjoinRoot.of F))).appTop := by
      intro φ
      rw [← Category.assoc, Scheme.ΓSpecIso_inv_naturality, Category.assoc, Scheme.Hom.comp_appTop]
    have e := key φ₁
    rw [h1, ← key φ₂] at e
    have h3 := congrArg CommRingCat.Hom.hom e
    simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom] using h3
  · exact h2

theorem wcpa_dj_lus_cvs_ct_ns_qg_spec_adjoin_lift : ∀ (R : Type u) [CommRing R] (F : Polynomial R) (T : Scheme.{u}) (s : T ⟶ Spec (.of R)) (x : Γ(T, ⊤)), Polynomial.eval₂ ((Scheme.ΓSpecIso (.of R)).inv ≫ s.appTop).hom x F = 0 → ∃ φ : T ⟶ Spec (.of (AdjoinRoot F)), φ ≫ Spec.map (CommRingCat.ofHom (AdjoinRoot.of F)) = s ∧ φ.appTop.hom ((Scheme.ΓSpecIso (.of (AdjoinRoot F))).inv.hom (AdjoinRoot.root F)) = x :=
by
  intro R _ F T s x hx
  set ρ : R →+* Γ(T, ⊤) := ((Scheme.ΓSpecIso (.of R)).inv ≫ s.appTop).hom with hρ
  let lam : AdjoinRoot F →+* Γ(T, ⊤) := AdjoinRoot.lift ρ x hx
  have hlam_of : lam.comp (AdjoinRoot.of F) = ρ := RingHom.ext fun a => AdjoinRoot.lift_of hx
  refine ⟨T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom lam), ?_, ?_⟩
  · rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hlam_of, hρ,
      CommRingCat.ofHom_hom, Spec.map_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality,
      Category.assoc, ← SpecMap_ΓSpecIso_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id,
      Category.comp_id]
  · have key : (Scheme.ΓSpecIso (.of (AdjoinRoot F))).inv ≫
        (T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom lam)).appTop = CommRingCat.ofHom lam := by
      rw [Scheme.Hom.comp_appTop, Scheme.toSpecΓ_appTop, ← Category.assoc,
        ← Scheme.ΓSpecIso_inv_naturality, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    have h2 := congrArg (fun f => f.hom (AdjoinRoot.root F)) key
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h2
    rw [h2]
    exact AdjoinRoot.lift_root hx

theorem wcpa_dj_lus_cvs_ct_ns_qg_affine_appLE : ∀ (C : Scheme.{u}) (V : C.Opens) (hV : IsAffineOpen V) (T : Scheme.{u}) (s : T ⟶ Spec Γ(C, V)) (h : ⊤ ≤ (s ≫ hV.fromSpec) ⁻¹ᵁ V), (Scheme.ΓSpecIso Γ(C, V)).inv ≫ s.appTop = (s ≫ hV.fromSpec).appLE V ⊤ h :=
