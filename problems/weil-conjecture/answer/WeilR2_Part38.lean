      have e0 := hsq θ₀ (fun y hy => (hθm y hy).1) _ hc
      have e1 := hsq θ₁ (fun y hy => (hθm y hy).2) _ hc
      simp only [map_sub, map_mul, hθ₀C, hθ₁C, PowerSeries.coeff_C_mul, hc₀₀, hc₁₁,
