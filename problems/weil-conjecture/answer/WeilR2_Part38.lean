  obtain ⟨B, hLB⟩ := LocalSubring.exists_le_valuationSubring (LocalSubring.mk S)
  rw [LocalSubring.le_def] at hLB
  obtain ⟨hsub, hloc⟩ := hLB
  have hSB : ∀ x : K, x ∈ S → x ∈ B := fun x hx => hsub hx
  have hT : ∀ x : K, x ∈ S → ∀ s ∈ B, x * s = 1 → ∃ y ∈ S, x * y = 1 := by
    intro x hx s hs hxs
    have hu : IsUnit (Subring.inclusion hsub ⟨x, hx⟩) :=
      isUnit_iff_exists_inv.mpr ⟨⟨s, hs⟩, Subtype.ext hxs⟩
    have hu' : IsUnit (⟨x, hx⟩ : (LocalSubring.mk S).toSubring) :=
      isUnit_of_map_unit (Subring.inclusion hsub) _ hu
    obtain ⟨y, hy⟩ := hu'.exists_right_inv
    exact ⟨y, y.2, congrArg Subtype.val hy⟩
  have hBV : ∀ x ∈ B, x ∈ V := by
    intro x hxB
    by_contra hxV
    have h1 : 1 < V.valuation x := by
      rw [← V.valuation_le_one_iff] at hxV
      exact not_le.mp hxV
    have hx0 : x ≠ 0 := by
      rintro rfl
      rw [Valuation.map_zero] at h1
      exact not_lt.mpr zero_le h1
    have h2 : V.valuation x⁻¹ < 1 := by
      rw [map_inv₀]
      exact inv_lt_one_of_one_lt₀ h1
    obtain ⟨y, hyS, hy⟩ := hT x⁻¹ (hM2 _ h2) x hxB (inv_mul_cancel₀ hx0)
    have hyx : y = x := by
      calc y = x * (x⁻¹ * y) := by rw [← mul_assoc, mul_inv_cancel₀ hx0, one_mul]
        _ = x := by rw [hy, mul_one]
    exact hxV (hM3 x (hyx ▸ hyS))
  refine ⟨B, hBV, ?_⟩
  unfold wcLr1uDom
  refine ⟨fun a => hSB _ (hM1 a), ?_⟩
  intro a s hs h
  obtain ⟨y, hyS, hy⟩ := hT (φ a) (hM1 a) s hs h
  obtain ⟨b, hb⟩ := (hS y).1 hyS
  by_contra hna
  have hab : a * b ∈ IsLocalRing.maximalIdeal A :=
    Ideal.mul_mem_right b _ ((IsLocalRing.mem_maximalIdeal a).2 hna)
  have hu : IsUnit (1 - a * b) :=
    IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ ((IsLocalRing.mem_maximalIdeal _).1 hab)
  have e : φ (1 - a * b) = φ a * (y - φ b) := by
    rw [map_sub, map_one, map_mul]
    linear_combination -hy
  have h1 := hU _ hu
  rw [e, Valuation.map_mul] at h1
  have h2 : V.valuation (φ a) * V.valuation (y - φ b) < 1 := by
    rw [mul_comm]; exact mul_lt_one_of_lt_of_le hb (hle a)
  rw [h1] at h2
  exact lt_irrefl _ h2

theorem wcpa_dj_lr1u_tcr_composite_unique : ∀ (Ω K : Type u) [Field Ω] [Field K] (c : Ω →+* K) (W : ValuationSubring Ω) (V : ValuationSubring K), (∀ ω : Ω, c ω ∈ V ↔ ω ∈ W) → ∀ g : K, (∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) → q.eval₂ (c.comp W.subtype) g ≠ 0 ∧ (q.eval₂ (c.comp W.subtype) g)⁻¹ ∈ V) → (∀ f : K, ∃ P Q : Polynomial Ω, Q.eval₂ c g ≠ 0 ∧ f * Q.eval₂ c g = P.eval₂ c g) → ∀ B B' : ValuationSubring K, (∀ x ∈ B, x ∈ V) → (∀ x ∈ B', x ∈ V) → (∀ w : ↥W, c (w : Ω) ∈ B) → (∀ w : ↥W, c (w : Ω) ∈ B') → g ∈ B → g ∈ B' → (∀ t ∈ B, g * t ≠ 1) → (∀ t ∈ B', g * t ≠ 1) → B = B' :=
by
  intro Ω K _ _ c W V hCC g hRT hGEN B B' hBV hB'V hBc hB'c hgB hgB' hBu hB'u
  classical
  have hcomp : ∀ w : ↥W, (c.comp W.subtype) w = c (w : Ω) := fun w => rfl

  have hX : ∃ i, IsUnit ((Polynomial.X : Polynomial ↥W).coeff i) := ⟨1, by simp⟩
  obtain ⟨hg0, hginvV⟩ := hRT Polynomial.X hX
  simp only [Polynomial.eval₂_X] at hg0 hginvV

  have hF4 : ∀ (P : Polynomial Ω), P ≠ 0 → ∃ α : Ω, α ≠ 0 ∧ ∃ p : Polynomial ↥W,
      (∃ i, IsUnit (p.coeff i)) ∧ ∀ x : K,
        P.eval₂ c x = c α * p.eval₂ (c.comp W.subtype) x := by
    intro P hP
    obtain ⟨i, hi, himax⟩ := Finset.exists_max_image P.support (fun j => W.valuation (P.coeff j))
      (Polynomial.support_nonempty.mpr hP)
    have hα : P.coeff i ≠ 0 := Polynomial.mem_support_iff.mp hi
    have hvα : W.valuation (P.coeff i) ≠ 0 := by simpa using hα
    have hlift : Polynomial.C (P.coeff i)⁻¹ * P ∈ Polynomial.lifts W.subtype := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      rw [Polynomial.coeff_C_mul]
      by_cases hn : n ∈ P.support
      · have hle := himax n hn
        have hmem : (P.coeff i)⁻¹ * P.coeff n ∈ W := by
          rw [← ValuationSubring.valuation_le_one_iff, map_mul, map_inv₀]
          rw [inv_mul_le_iff₀ (zero_lt_iff.mpr hvα), mul_one]
          exact hle
        exact ⟨⟨_, hmem⟩, rfl⟩
      · rw [Polynomial.notMem_support_iff.mp hn, mul_zero]
        exact ⟨0, rfl⟩
    obtain ⟨p, hp⟩ := (Polynomial.mem_lifts _).mp hlift
    refine ⟨P.coeff i, hα, p, ⟨i, ?_⟩, ?_⟩
    · have h1 : W.subtype (p.coeff i) = 1 := by
        rw [← Polynomial.coeff_map, hp, Polynomial.coeff_C_mul, inv_mul_cancel₀ hα]
      have h2 : p.coeff i = 1 := Subtype.ext h1
      rw [h2]; exact isUnit_one
    · intro x
      rw [← Polynomial.eval₂_map, hp, Polynomial.eval₂_mul, Polynomial.eval₂_C, ← mul_assoc,
        ← map_mul, mul_inv_cancel₀ hα, map_one, one_mul]

  have hD : ∀ D : ValuationSubring K, (∀ x ∈ D, x ∈ V) → (∀ w : ↥W, c (w : Ω) ∈ D) → g ∈ D →
      (∀ t ∈ D, g * t ≠ 1) → ∀ (x : K) (γ : Ω) (p q : Polynomial ↥W), γ ≠ 0 →
      ∀ (hp : ∃ i, IsUnit (p.coeff i)) (hq : ∃ i, IsUnit (q.coeff i)),
      x * q.eval₂ (c.comp W.subtype) g = c γ * p.eval₂ (c.comp W.subtype) g →
      (x ∈ D ↔ ∃ hγ : γ ∈ W, ¬ IsUnit (⟨γ, hγ⟩ : ↥W) ∨ Nat.find hq ≤ Nat.find hp) := by
    intro D hDV hDc hgD hDu x γ p q hγ hp hq hxe
    have hvg0 : 0 < D.valuation g := (Valuation.pos_iff _).mpr hg0
    have hvg1 : D.valuation g < 1 := by
      rw [← ValuationSubring.mem_nonunits_iff, ValuationSubring.mem_nonunits_iff_or]
      right
      intro h
      exact hDu _ h (mul_inv_cancel₀ hg0)
    have hunit : ∀ w : ↥W, IsUnit w → D.valuation (c (w : Ω)) = 1 := by
      intro w hw
