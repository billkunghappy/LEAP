  have h3 := hy.2.2 K t E₀ hE₀ ⟨Er, ι ≫ Φ.inv, θ, inferInstance, hEr, hrange,
    by rw [Category.assoc, Φ3]; exact hθ⟩
  have hcard : Nat.card {i : Fin k // ∃ x ∈ E₀, ∃ p : ↥(Spec (.of K)),
      Limits.pullback.fst c t x = y i (t p)} ≤
      Nat.card {i : Fin k // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
        Limits.pullback.fst u₁ (t ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) x =
          σ (Fin.castSucc i) ((t ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) p)} := by
    refine Nat.card_le_card_of_injective (fun j => ⟨j.1, ?_⟩) ?_
