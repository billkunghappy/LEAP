        rw [ha] at e
        field_simp at e
        exact e.symm
      rw [this]; exact hwV
    · intro v hv
      rw [hV] at hv
      obtain ⟨a, rfl⟩ := hv
      exact ⟨φ a, rfl⟩

  have L5 : ∀ (G : Scheme.{u}) (γ γ' : G) (hγ : γ' ⤳ γ) (K : Type u) [CommRing K]
      (g : G.presheaf.stalk γ' →+* K), Function.Injective g →
      Set.range g ⊆ Set.range (g.comp (G.presheaf.stalkSpecializes hγ).hom) → γ' = γ := by
    intro G γ γ' hγ K _ g hg hr
    set σ := (G.presheaf.stalkSpecializes hγ).hom with hσ
    haveI : IsLocalHom σ := by
      constructor
      intro t ht
      obtain ⟨s, hs⟩ := ht.exists_right_inv
      obtain ⟨t', ht'⟩ := hr ⟨s, rfl⟩
      simp only [RingHom.coe_comp, Function.comp_apply] at ht'
      have hst : σ t' = s := hg ht'
      have h1 : σ (t * t') = 1 := by rw [map_mul, hst, hs]
      rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (t * t') with hu | hu
      · exact isUnit_of_mul_isUnit_left hu
      · exfalso
        have h2 := hu.map σ
        rw [map_sub, map_one, h1, sub_self] at h2
        exact not_isUnit_zero h2
    have hcp : (Spec.map (CommRingCat.ofHom σ)) (IsLocalRing.closedPoint (G.presheaf.stalk γ')) =
        IsLocalRing.closedPoint (G.presheaf.stalk γ) := IsLocalRing.comap_closedPoint σ
    have e' : Spec.map (CommRingCat.ofHom σ) ≫ G.fromSpecStalk γ = G.fromSpecStalk γ' := by
      rw [hσ, CommRingCat.ofHom_hom]
      exact Scheme.SpecMap_stalkSpecializes_fromSpecStalk hγ
    have h1 : (Spec.map (CommRingCat.ofHom σ) ≫ G.fromSpecStalk γ)
        (IsLocalRing.closedPoint (G.presheaf.stalk γ')) = γ :=
      (Scheme.Hom.comp_apply _ _ _).trans
        ((congrArg (G.fromSpecStalk γ) hcp).trans Scheme.fromSpecStalk_closedPoint)
