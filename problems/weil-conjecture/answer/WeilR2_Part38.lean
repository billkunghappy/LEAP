        (by clear * - hOm; intro y hy; simp only [TopologicalSpace.Opens.mem_inf] at hy ⊢; aesop)))
  have BV : ∀ (V : Y.Opens) (J K : Fin N₁) (h1 : V ≤ D J ⊓ D K) (h2 : V ≤ D K) (h3 : V ≤ D J),
      (G.presheaf.map (homOfLE h1).op).hom (C J K) =
        (G.presheaf.map (homOfLE h2).op).hom (B K) -
          (Y.presheaf.map (homOfLE h2).op).hom (x J K) ^ k •
            (G.presheaf.map (homOfLE h3).op).hom (B J) := by
    intro V J K h1 h2 h3
    have e := congrArg (fun s => (G.presheaf.map (homOfLE h1).op).hom s) (hB J K)
    simp only [map_sub, sm, map_pow, rG, rY] at e
    exact e



  refine ⟨fun ν => (G.presheaf.map (homOfLE (hO ν)).op).hom (B (ι ν)) -
      (G.presheaf.map (homOfLE (show O ν ≤ D (ι ν) ⊓ O ν from le_inf (hO ν) le_rfl)).op).hom
        (w (ι ν) ν), fun ν μ => ?_⟩
  simp only [map_sub, rG]
  have e2 := WV (ι ν) (O ν ⊓ O μ) ν μ
    (by clear * - hOm; intro y hy; simp only [TopologicalSpace.Opens.mem_inf] at hy ⊢; aesop) le_rfl
    (by clear * - hOm; intro y hy; simp only [TopologicalSpace.Opens.mem_inf] at hy ⊢; aesop)
    (by clear * - hOm; intro y hy; simp only [TopologicalSpace.Opens.mem_inf] at hy ⊢; aesop)
  rw [rG0 (le_refl (O ν ⊓ O μ)) (c ν μ)] at e2
  have e3 := HxV (O ν ⊓ O μ) (ι ν) (ι μ) (ι ν)
    (by clear * - hOm; intro y hy; simp only [TopologicalSpace.Opens.mem_inf] at hy ⊢; aesop)
    (by clear * - hOm; intro y hy; simp only [TopologicalSpace.Opens.mem_inf] at hy ⊢; aesop)
    (by clear * - hOm; intro y hy; simp only [TopologicalSpace.Opens.mem_inf] at hy ⊢; aesop)
  rw [hxJJ, map_one] at e3
  exact alg2 _ _ _ _ _ _ _ _
    ((BV (O ν ⊓ O μ) (ι ν) (ι μ)
        (by clear * - hOm; intro y hy; simp only [TopologicalSpace.Opens.mem_inf] at hy ⊢; aesop)
        (by clear * - hOm; intro y hy; simp only [TopologicalSpace.Opens.mem_inf] at hy ⊢; aesop)
        (by clear * - hOm; intro y hy; simp only [TopologicalSpace.Opens.mem_inf] at hy ⊢; aesop)).symm.trans
      (CV (O ν ⊓ O μ) (ι ν) (ι μ) μ
        (by clear * - hOm; intro y hy; simp only [TopologicalSpace.Opens.mem_inf] at hy ⊢; aesop)
        (by clear * - hOm; intro y hy; simp only [TopologicalSpace.Opens.mem_inf] at hy ⊢; aesop)
        (by clear * - hOm; intro y hy; simp only [TopologicalSpace.Opens.mem_inf] at hy ⊢; aesop)
        (by clear * - hOm; intro y hy; simp only [TopologicalSpace.Opens.mem_inf] at hy ⊢; aesop)
        (by clear * - hOm; intro y hy; simp only [TopologicalSpace.Opens.mem_inf] at hy ⊢; aesop)))
    e2 e3

theorem wcpa_dj_sv_descent {Y : Scheme.{u}} (L : wcpaDjCoc Y) (hL : wcpaDjCocOK L) (e : ℕ)
    (U : Y.Opens) {M : ℕ} (t : Fin (M + 1) → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ U))
    (ht : ∀ J a b,
      (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ U ≤ L.V b ⊓ U from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (t J b) =
        (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ U ≤ L.V a ⊓ L.V b from
          inf_le_left)).op).hom ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ e) *
        (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ U ≤ L.V a ⊓ U from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (t J a))
    (D : Fin (M + 1) → Y.Opens) (x : ∀ J K, Γ(Y, D K))
    (hDt : ∀ J a, D J ⊓ (L.V a ⊓ U) = Y.basicOpen (t J a))
    (hxt : ∀ J K a,
      (Y.presheaf.map (homOfLE (show D K ⊓ (L.V a ⊓ U) ≤ D K from inf_le_left)).op).hom
          (x J K) *
        (Y.presheaf.map (homOfLE (show D K ⊓ (L.V a ⊓ U) ≤ L.V a ⊓ U from
          inf_le_right)).op).hom (t K a) =
        (Y.presheaf.map (homOfLE (show D K ⊓ (L.V a ⊓ U) ≤ L.V a ⊓ U from
          inf_le_right)).op).hom (t J a))
    (G : Y.Modules) (k : ℕ) {N : ℕ} (O : Fin N → Y.Opens) (ι : Fin N → Fin (M + 1))
    (α : Fin N → Fin L.m) (hOD : ∀ ν, O ν ≤ D (ι ν)) (hOV : ∀ ν, O ν ≤ L.V (α ν) ⊓ U)
    (hcov : (⨆ ν, O ν) = U) :
    wcpaSvTwV O (fun ν μ =>
      (Y.presheaf.map (homOfLE (show O ν ⊓ O μ ≤ D (ι μ) from
        inf_le_right.trans (hOD μ))).op).hom (x (ι ν) (ι μ)) ^ k) G →
    wcpaDjTwH1 L U G (e * k) :=
by
  intro hz c hc

  have rrY : ∀ {A B C : Y.Opens} (h1 : A ≤ B) (h2 : B ≤ C) (s : Γ(Y, C)),
      (Y.presheaf.map (homOfLE h1).op).hom ((Y.presheaf.map (homOfLE h2).op).hom s) =
        (Y.presheaf.map (homOfLE (h1.trans h2)).op).hom s := by
    intro A B C h1 h2 s
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Functor.map_comp]; rfl
  have rrG : ∀ {A B C : Y.Opens} (h1 : A ≤ B) (h2 : B ≤ C) (s : Γ(G, C)),
      (G.presheaf.map (homOfLE h1).op).hom ((G.presheaf.map (homOfLE h2).op).hom s) =
        (G.presheaf.map (homOfLE (h1.trans h2)).op).hom s := by
    intro A B C h1 h2 s
    rw [← AddMonoidHom.comp_apply, ← AddCommGrpCat.hom_comp, ← Functor.map_comp]; rfl
  have sG : ∀ {A B : Y.Opens} (h : A ≤ B) (r : Γ(Y, B)) (s : Γ(G, B)),
      (G.presheaf.map (homOfLE h).op).hom (r • s) =
        (Y.presheaf.map (homOfLE h).op).hom r • (G.presheaf.map (homOfLE h).op).hom s :=
    fun h r s => Scheme.Modules.map_smul G (homOfLE h) r s

  have alg1 : ∀ {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M]
      (Z Tl Tm Wl Wm Gq : R) (Cpr Cqr Cpq : M),
      Z * Tl = Gq ^ e * Tm → Tl * Wl = 1 → Tm * Wm = 1 →
      Cpr = Cqr + Gq ^ (e * k) • Cpq →
      Wl ^ k • Cpr = Wl ^ k • Cqr + Z ^ k • (Wm ^ k • Cpq) := by
    intro R M _ _ _ Z Tl Tm Wl Wm Gq Cpr Cqr Cpq hD hl hm hC
    have hDk : Z ^ k * Tl ^ k = Gq ^ (e * k) * Tm ^ k := by
      rw [← mul_pow, hD, mul_pow, ← pow_mul]
    have e1 : (Tl * Wl) ^ k = 1 := by rw [hl, one_pow]
    have e2 : (Tm * Wm) ^ k = 1 := by rw [hm, one_pow]
    have hS : Z ^ k * Wm ^ k = Gq ^ (e * k) * Wl ^ k := by
      linear_combination (Wl ^ k * Wm ^ k) * hDk - Z ^ k * Wm ^ k * e1 +
        Gq ^ (e * k) * Wl ^ k * e2
    linear_combination (norm := module) Wl ^ k • hC - hS • Cpq
  have alg2 : ∀ {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M]
      (X Tm Tn Wm Gpq : R) (C Bm Bn : M),
      Wm ^ k • C = Bm - X ^ k • Bn → X * Tm = Gpq ^ e * Tn → Tm * Wm = 1 →
      C = Tm ^ k • Bm - Gpq ^ (e * k) • (Tn ^ k • Bn) := by
    intro R M _ _ _ X Tm Tn Wm Gpq C Bm Bn h1 h2 h3
    have h2k : X ^ k * Tm ^ k = Gpq ^ (e * k) * Tn ^ k := by
      rw [← mul_pow, h2, mul_pow, ← pow_mul]
    have e1 : (Tm * Wm) ^ k = 1 := by rw [h3, one_pow]
    linear_combination (norm := module) Tm ^ k • h1 - e1 • C - h2k • Bn
  have alg3 : ∀ {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M]
      (Gpa Gqa Gpq : R) (Bn Bm Cpa Cqa Cpq : M),
      Cpa = Cqa + Gqa ^ (e * k) • Cpq → Cpq = Bm - Gpq ^ (e * k) • Bn → Gpq * Gqa = Gpa →
      Gpa ^ (e * k) • Bn + Cpa = Gqa ^ (e * k) • Bm + Cqa := by
    intro R M _ _ _ Gpa Gqa Gpq Bn Bm Cpa Cqa Cpq hE hF hH
    have Hn : Gpa ^ (e * k) = Gpq ^ (e * k) * Gqa ^ (e * k) := by rw [← hH, mul_pow]
    linear_combination (norm := module) hE + Gqa ^ (e * k) • hF + Hn • Bn
  have alg4 : ∀ {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M]
      (Gpa Gab Gpb : R) (β Ba Bb Cab Cpa Cpb : M),
      Bb = Gpb ^ (e * k) • β + Cpb → Ba = Gpa ^ (e * k) • β + Cpa →
      Cpb = Cab + Gab ^ (e * k) • Cpa →
      Gpa * Gab = Gpb → Cab = Bb - Gab ^ (e * k) • Ba := by
    intro R M _ _ _ Gpa Gab Gpb β Ba Bb Cab Cpa Cpb hBb hBa hE hH
    have Hn : Gpb ^ (e * k) = Gpa ^ (e * k) * Gab ^ (e * k) := by rw [← hH, mul_pow]
    linear_combination (norm := module) -hBb + Gab ^ (e * k) • hBa - hE - Hn • β

  have hVl : ∀ ν, O ν ≤ L.V (α ν) := fun ν => (hOV ν).trans inf_le_left
  have hUl : ∀ ν, O ν ≤ U := fun ν => (hOV ν).trans inf_le_right
  have I1 : ∀ ν μ, O ν ⊓ O μ ≤ L.V (α ν) ⊓ L.V (α μ) := fun ν μ =>
    le_inf (inf_le_left.trans (hVl ν)) (inf_le_right.trans (hVl μ))
  have I2 : ∀ ν μ, O ν ⊓ O μ ≤ L.V (α ν) ⊓ L.V (α μ) ⊓ U := fun ν μ =>
    le_inf (I1 ν μ) (inf_le_left.trans (hUl ν))
  have I3 : ∀ ν a, O ν ⊓ (L.V a ⊓ U) ≤ L.V (α ν) ⊓ L.V a := fun ν a =>
    le_inf (inf_le_left.trans (hVl ν)) (inf_le_right.trans inf_le_left)
  have I4 : ∀ ν a, O ν ⊓ (L.V a ⊓ U) ≤ L.V (α ν) ⊓ L.V a ⊓ U := fun ν a =>
    le_inf (I3 ν a) (inf_le_right.trans inf_le_right)
  have hcovG : ∀ W : Y.Opens, W ≤ U → W ≤ ⨆ ν, O ν ⊓ W := by
    intro W hW y hy
    have hyU : y ∈ ⨆ ν, O ν := by rw [hcov]; exact hW hy
    rw [TopologicalSpace.Opens.mem_iSup] at hyU ⊢
    obtain ⟨ν, hν⟩ := hyU
    exact ⟨ν, TopologicalSpace.Opens.mem_inf.mpr ⟨hν, hy⟩⟩

  obtain ⟨T, hT⟩ : ∃ T : ∀ ν, Γ(Y, O ν), ∀ ν,
      T ν = (Y.presheaf.map (homOfLE (hOV ν)).op).hom (t (ι ν) (α ν)) := ⟨_, fun _ => rfl⟩
  have hτ : ∀ ν, IsUnit (T ν) := by
    intro ν
    have hb : O ν ≤ Y.basicOpen (t (ι ν) (α ν)) := by
      rw [← hDt]; exact le_inf (hOD ν) (hOV ν)
    have h1 : IsUnit ((Y.presheaf.map (homOfLE (Y.basicOpen_le (t (ι ν) (α ν)))).op).hom
        (t (ι ν) (α ν))) :=
      RingedSpace.isUnit_res_basicOpen Y.toRingedSpace _
    have h2 := h1.map (Y.presheaf.map (homOfLE hb).op).hom
    rw [rrY] at h2
    rw [hT]; exact h2
  choose w hw using fun ν => isUnit_iff_exists.mp (hτ ν)
  have hgauge : ∀ ν μ,
      (Y.presheaf.map (homOfLE (show O ν ⊓ O μ ≤ D (ι μ) from
        inf_le_right.trans (hOD μ))).op).hom (x (ι ν) (ι μ)) *
      (Y.presheaf.map (homOfLE (inf_le_right : O ν ⊓ O μ ≤ O μ)).op).hom (T μ) =
      (Y.presheaf.map (homOfLE (I1 ν μ)).op).hom
        (L.g (α ν) (α μ) : Γ(Y, L.V (α ν) ⊓ L.V (α μ))) ^ e *
      (Y.presheaf.map (homOfLE (inf_le_left : O ν ⊓ O μ ≤ O ν)).op).hom (T ν) := by
    intro ν μ
    have hA := congrArg (Y.presheaf.map (homOfLE (show O ν ⊓ O μ ≤ D (ι μ) ⊓ (L.V (α μ) ⊓ U) from
      le_inf (inf_le_right.trans (hOD μ)) (inf_le_right.trans (hOV μ)))).op).hom
      (hxt (ι ν) (ι μ) (α μ))
    simp only [map_mul, rrY] at hA
    have hB := congrArg (Y.presheaf.map (homOfLE (I2 ν μ)).op).hom (ht (ι ν) (α ν) (α μ))
    simp only [map_mul, map_pow, rrY] at hB
    simp only [hT, rrY]
    exact hA.trans hB

  obtain ⟨c', hc'⟩ : ∃ c' : ∀ ν μ, Γ(G, O ν ⊓ O μ), ∀ ν μ,
      c' ν μ = (Y.presheaf.map (homOfLE (inf_le_right : O ν ⊓ O μ ≤ O μ)).op).hom (w μ ^ k) •
        (G.presheaf.map (homOfLE (I2 ν μ)).op).hom (c (α ν) (α μ)) := ⟨_, fun _ _ => rfl⟩
  obtain ⟨b, hb⟩ := hz c' (by
    intro ν μ l
    simp only [hc', sG, map_pow, rrY, rrG]
    have hC := congrArg (G.presheaf.map (homOfLE (show O ν ⊓ O μ ⊓ O l ≤
        L.V (α ν) ⊓ L.V (α μ) ⊓ L.V (α l) ⊓ U from
      le_inf (le_inf (le_inf ((inf_le_left.trans inf_le_left).trans (hVl ν))
        ((inf_le_left.trans inf_le_right).trans (hVl μ))) (inf_le_right.trans (hVl l)))
        (inf_le_right.trans (hUl l)))).op).hom (hc (α ν) (α μ) (α l))
    simp only [map_add, sG, map_pow, rrY, rrG] at hC
    have hD := congrArg (Y.presheaf.map (homOfLE (show O ν ⊓ O μ ⊓ O l ≤ O μ ⊓ O l from
      le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (hgauge μ l)
    simp only [map_mul, map_pow, rrY] at hD
    have hl := congrArg (Y.presheaf.map (homOfLE (show O ν ⊓ O μ ⊓ O l ≤ O l from
      inf_le_right)).op).hom (hw l).1
    have hm := congrArg (Y.presheaf.map (homOfLE (show O ν ⊓ O μ ⊓ O l ≤ O μ from
      inf_le_left.trans inf_le_right)).op).hom (hw μ).1
    simp only [map_mul, map_one] at hl hm
    exact alg1 _ _ _ _ _ _ _ _ _ hD hl hm hC)
  obtain ⟨β', hβ'def⟩ : ∃ β' : ∀ ν, Γ(G, O ν), ∀ ν, β' ν = T ν ^ k • b ν := ⟨_, fun _ => rfl⟩
  have hβ' : ∀ ν μ, (G.presheaf.map (homOfLE (I2 ν μ)).op).hom (c (α ν) (α μ)) =
      (G.presheaf.map (homOfLE (inf_le_right : O ν ⊓ O μ ≤ O μ)).op).hom (β' μ) -
      (Y.presheaf.map (homOfLE (I1 ν μ)).op).hom
          (L.g (α ν) (α μ) : Γ(Y, L.V (α ν) ⊓ L.V (α μ))) ^ (e * k) •
        (G.presheaf.map (homOfLE (inf_le_left : O ν ⊓ O μ ≤ O ν)).op).hom (β' ν) := by
    intro ν μ
    have h1 := hb ν μ
    rw [hc'] at h1
    simp only [sG, map_pow, rrY, rrG] at h1
    have h3 := congrArg (Y.presheaf.map (homOfLE (inf_le_right : O ν ⊓ O μ ≤ O μ)).op).hom
      (hw μ).1
    simp only [map_mul, map_one] at h3
    simp only [hβ'def, sG, map_pow]
    exact alg2 _ _ _ _ _ _ _ _ h1 (hgauge ν μ) h3

  obtain ⟨sf, hsf⟩ : ∃ sf : ∀ a ν, Γ(G, O ν ⊓ (L.V a ⊓ U)), ∀ a ν,
      sf a ν = (Y.presheaf.map (homOfLE (I3 ν a)).op).hom
          (L.g (α ν) a : Γ(Y, L.V (α ν) ⊓ L.V a)) ^ (e * k) •
        (G.presheaf.map (homOfLE (inf_le_left : O ν ⊓ (L.V a ⊓ U) ≤ O ν)).op).hom (β' ν) +
        (G.presheaf.map (homOfLE (I4 ν a)).op).hom (c (α ν) a) := ⟨_, fun _ _ => rfl⟩
  have hglue : ∀ a, ∃ Ba : Γ(G, L.V a ⊓ U), ∀ ν,
      (G.presheaf.map (homOfLE (inf_le_right : O ν ⊓ (L.V a ⊓ U) ≤ L.V a ⊓ U)).op).hom Ba =
        sf a ν := by
    intro a
    obtain ⟨s, hs, -⟩ := TopCat.Sheaf.existsUnique_gluing'
      (⟨G.presheaf, G.isSheaf⟩ : TopCat.Sheaf Ab Y)
      (fun ν => O ν ⊓ (L.V a ⊓ U)) (L.V a ⊓ U) (fun ν => homOfLE inf_le_right)
      (hcovG _ inf_le_right) (sf a) (by
        intro i j
        show (G.presheaf.map (homOfLE (inf_le_left :
            (O i ⊓ (L.V a ⊓ U)) ⊓ (O j ⊓ (L.V a ⊓ U)) ≤ O i ⊓ (L.V a ⊓ U))).op).hom (sf a i) =
          (G.presheaf.map (homOfLE (inf_le_right :
            (O i ⊓ (L.V a ⊓ U)) ⊓ (O j ⊓ (L.V a ⊓ U)) ≤ O j ⊓ (L.V a ⊓ U))).op).hom (sf a j)
        simp only [hsf, map_add, sG, map_pow, rrY, rrG]
        have hE := congrArg (G.presheaf.map (homOfLE (show
            (O i ⊓ (L.V a ⊓ U)) ⊓ (O j ⊓ (L.V a ⊓ U)) ≤ L.V (α i) ⊓ L.V (α j) ⊓ L.V a ⊓ U from
          le_inf (le_inf (le_inf (inf_le_left.trans (inf_le_left.trans (hVl i)))
            (inf_le_right.trans (inf_le_left.trans (hVl j))))
            (inf_le_left.trans (inf_le_right.trans inf_le_left)))
            (inf_le_left.trans (inf_le_right.trans inf_le_right)))).op).hom (hc (α i) (α j) a)
        simp only [map_add, sG, map_pow, rrY, rrG] at hE
        have hF := congrArg (G.presheaf.map (homOfLE (show
            (O i ⊓ (L.V a ⊓ U)) ⊓ (O j ⊓ (L.V a ⊓ U)) ≤ O i ⊓ O j from
          le_inf (inf_le_left.trans inf_le_left) (inf_le_right.trans inf_le_left))).op).hom
          (hβ' i j)
        simp only [map_sub, sG, map_pow, rrY, rrG] at hF
        have hH := congrArg (Y.presheaf.map (homOfLE (show
            (O i ⊓ (L.V a ⊓ U)) ⊓ (O j ⊓ (L.V a ⊓ U)) ≤ L.V (α i) ⊓ L.V (α j) ⊓ L.V a from
          le_inf (le_inf (inf_le_left.trans (inf_le_left.trans (hVl i)))
            (inf_le_right.trans (inf_le_left.trans (hVl j))))
            (inf_le_left.trans (inf_le_right.trans inf_le_left)))).op).hom
          (hL.2.2.2 (α i) (α j) a)
        simp only [map_mul, rrY] at hH
        exact alg3 _ _ _ _ _ _ _ _ hE hF hH)
    exact ⟨s, hs⟩
  choose B hB using hglue

  refine ⟨B, fun a b => ?_⟩
  refine TopCat.Sheaf.eq_of_locally_eq' (⟨G.presheaf, G.isSheaf⟩ : TopCat.Sheaf Ab Y)
    (fun ν => O ν ⊓ (L.V a ⊓ L.V b ⊓ U)) (L.V a ⊓ L.V b ⊓ U) (fun ν => homOfLE inf_le_right)
    (hcovG _ inf_le_right) _ _ (fun ν => ?_)
  show (G.presheaf.map (homOfLE (inf_le_right :
      O ν ⊓ (L.V a ⊓ L.V b ⊓ U) ≤ L.V a ⊓ L.V b ⊓ U)).op).hom (c a b) =
    (G.presheaf.map (homOfLE (inf_le_right :
      O ν ⊓ (L.V a ⊓ L.V b ⊓ U) ≤ L.V a ⊓ L.V b ⊓ U)).op).hom _
  simp only [map_sub, sG, map_pow, rrY, rrG]
  have hBb := congrArg (G.presheaf.map (homOfLE (show
      O ν ⊓ (L.V a ⊓ L.V b ⊓ U) ≤ O ν ⊓ (L.V b ⊓ U) from
    le_inf inf_le_left (le_inf (inf_le_right.trans (inf_le_left.trans inf_le_right))
      (inf_le_right.trans inf_le_right)))).op).hom (hB b ν)
  simp only [hsf, map_add, sG, map_pow, rrY, rrG] at hBb
  have hBa := congrArg (G.presheaf.map (homOfLE (show
      O ν ⊓ (L.V a ⊓ L.V b ⊓ U) ≤ O ν ⊓ (L.V a ⊓ U) from
    le_inf inf_le_left (le_inf (inf_le_right.trans (inf_le_left.trans inf_le_left))
      (inf_le_right.trans inf_le_right)))).op).hom (hB a ν)
  simp only [hsf, map_add, sG, map_pow, rrY, rrG] at hBa
  have hE := congrArg (G.presheaf.map (homOfLE (show
      O ν ⊓ (L.V a ⊓ L.V b ⊓ U) ≤ L.V (α ν) ⊓ L.V a ⊓ L.V b ⊓ U from
    le_inf (le_inf (le_inf (inf_le_left.trans (hVl ν))
      (inf_le_right.trans (inf_le_left.trans inf_le_left)))
      (inf_le_right.trans (inf_le_left.trans inf_le_right)))
      (inf_le_right.trans inf_le_right))).op).hom (hc (α ν) a b)
  simp only [map_add, sG, map_pow, rrY, rrG] at hE
  have hH := congrArg (Y.presheaf.map (homOfLE (show
      O ν ⊓ (L.V a ⊓ L.V b ⊓ U) ≤ L.V (α ν) ⊓ L.V a ⊓ L.V b from
    le_inf (le_inf (inf_le_left.trans (hVl ν))
      (inf_le_right.trans (inf_le_left.trans inf_le_left)))
      (inf_le_right.trans (inf_le_left.trans inf_le_right)))).op).hom (hL.2.2.2 (α ν) a b)
  simp only [map_mul, rrY] at hH
  exact alg4 _ _ _ _ _ _ _ _ _ hBb hBa hE hH

theorem wcpa_dj_lcp_ra_serre_vanishing : ∀ {Y T : Scheme.{u}} (q : Y ⟶ T) (W : T.Opens), IsAffineOpen W → IsNoetherianRing Γ(T, W) → IsProper q → ∀ L : wcpaDjCoc Y, wcpaDjCocOK L → ∀ e, 0 < e → wcpaDjVA q L W e → ∀ F : Y.Modules, wcCoherentMod F → ∃ n₀ : ℕ, ∀ n ≥ n₀, wcpaDjTwH1 L (q ⁻¹ᵁ W) F n :=
by
  intro Y T q W _hW hR _hq L hL e he hVA F hF
  haveI := hR
  obtain ⟨M, t, D, x, hDU, ht, hDaff, hDcov, hDt, hxJJ, hx, hxc, hxt, hgen⟩ :=
    wcpa_dj_sv_chart_data q W L hL e hVA
  obtain ⟨N, O, ι, α, hOD, hOV, hOcov, hbas⟩ :=
    wcpa_dj_sv_refinement D x hDaff hx L.V hL.2.1
  have hmult : ∀ G : Y.Modules, wcCoherentMod G →
      ∃ k₀ : ℕ, ∀ k ≥ k₀, wcpaDjTwH1 L (q ⁻¹ᵁ W) G (e * k) := by
    intro G hG
    obtain ⟨k₀, hk₀⟩ := wcpa_dj_sv_chart_serre Γ(T, W) M (q ⁻¹ᵁ W) (q.app W).hom D hDU x hDaff
      hxJJ hx hxc hgen G hG.1 (fun K => hG.2 _ (hDaff K))
    refine ⟨k₀, fun k hk => ?_⟩
    have h1 := wcpa_dj_sv_leray G hG.1 D hDaff x hxJJ hxc k O ι hOD hOcov hbas (hk₀ k hk)
    exact wcpa_dj_sv_descent L hL e (q ⁻¹ᵁ W) t ht D x hDt hxt G k O ι α hOD
      (fun ν => le_inf (hOV ν) ((hOD ν).trans (hDU _))) (hOcov.trans hDcov) h1
  have hres : ∀ r : ℕ, ∃ kr : ℕ, ∀ k ≥ kr, wcpaDjTwH1 L (q ⁻¹ᵁ W) F (e * k + r) := by
    intro r
    obtain ⟨G, hG, hGF⟩ := wcpa_dj_sv_twist_reduce L hL r F hF
    obtain ⟨k₀, hk₀⟩ := hmult G hG
    exact ⟨k₀, fun k hk => hGF _ _ (hk₀ k hk)⟩
  choose kr hkr using hres
  refine ⟨e * (Finset.range e).sup kr, fun n hn => ?_⟩
  have hK : (Finset.range e).sup kr ≤ n / e := by
    rw [Nat.le_div_iff_mul_le he, mul_comm]
    exact hn
  have hr : n % e < e := Nat.mod_lt _ he
  have h := hkr (n % e) (n / e) (le_trans (Finset.le_sup (Finset.mem_range.mpr hr)) hK)
  rwa [Nat.div_add_mod] at h

theorem wcpa_dj_lge_serre_no_tail : ∀ (K : Type u) [Field K] [IsAlgClosed K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (r : ℕ) (ε : Fin r → (Spec (.of K) ⟶ C)) (L : wcpaDjCoc C)
    (t : ∀ a : Fin L.m, Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤)),
    wcpaDjSemistable q → wcpaDjSections q r ε → wcpaDjCocOK L →
    wcpaDjCompat L (q ⁻¹ᵁ ⊤) 1 t →
    (∀ a, (C.basicOpen (t a) : Set C) =
      ((L.V a ⊓ q ⁻¹ᵁ ⊤ : C.Opens) : Set C) \ ⋃ i, Set.range ⇑(ε i)) →
    (∀ E ∈ irreducibleComponents C, ∃ b, ε b (IsLocalRing.closedPoint K) ∈ E) →
    ∀ F : C.Modules, wcCoherentMod F → ∃ n₀ : ℕ, ∀ n ≥ n₀, wcpaDjTwH1 L ⊤ F n :=
by
  intro K _ _ C q r ε L t hss hsec hOK hcomp hbo hA F hF
  set pt := IsLocalRing.closedPoint K with hpt
  have hcl : ∀ b, IsClosed ({ε b pt} : Set C) := fun b =>
    wc_pfam_mc_rational_point_closed K C q (ε b) (hsec.1 b)

  have ha : ∀ ξ : C, closure {ξ} ∈ irreducibleComponents C → ∀ a : Fin L.m, ξ ∈ L.V a →
      ξ ∈ C.basicOpen (t a) := by
    intro ξ hξ a hξa
    have h1 : ξ ∈ (C.basicOpen (t a) : Set C) := by
      rw [hbo a]
      refine ⟨⟨hξa, trivial⟩, ?_⟩
      intro hU
      rw [Set.mem_iUnion] at hU
      obtain ⟨b, p, hp⟩ := hU
      have hξb : ε b pt = ξ := by rw [← hp, Subsingleton.elim p pt]
      apply (wcpa_dj_lsp_generic_smooth K C q hss ξ hξ).1
      rw [← hξb]
      exact hcl b
    exact h1

  have hb : ∀ ξ : C, closure {ξ} ∈ irreducibleComponents C →
      ∃ x ∈ closure {ξ}, ∀ a : Fin L.m, x ∈ L.V a → x ∉ C.basicOpen (t a) := by
    intro ξ hξ
    obtain ⟨b, hbξ⟩ := hA (closure {ξ}) hξ
    refine ⟨ε b pt, hbξ, fun a _ hx => ?_⟩
    have h1 : ε b pt ∈ (C.basicOpen (t a) : Set C) := hx
    rw [hbo a] at h1
    exact h1.2 (Set.mem_iUnion.mpr ⟨b, pt, rfl⟩)
  have hdeg := wcpa_dj_lsp_section_comp_deg_pos K C q L t hss hOK hcomp ha hb
  obtain ⟨e, M, t', he, hsep⟩ := wcpa_dj_fva_separating_sections K C q L hss hOK hdeg
  have hVA : wcpaDjVA q L ⊤ e := wcpa_dj_fva_chart_criterion K C q L hss hOK e M t' hsep
  obtain ⟨n₀, hn₀⟩ := wcpa_dj_lcp_ra_serre_vanishing q ⊤ (isAffineOpen_top (Spec (.of K)))
    (isNoetherianRing_of_ringEquiv K (Scheme.ΓSpecIso (.of K)).symm.commRingCatIsoToRingEquiv)
    hss.2.1 L hOK e he hVA F hF
  exact ⟨n₀, fun n hn => hn₀ n hn⟩

theorem wcpa_dj_lcp_cta_ideal_coherent : ∀ (Y : Scheme.{u}) [IsLocallyNoetherian Y] (T : Set Y)
    (K : Y.Modules) (ι : K ⟶ wcStructMod Y),
    (∀ V : Y.Opens, Function.Injective (Scheme.Modules.Hom.app ι V)) →
    (∀ (V : Y.Opens) (f : Γ(Y, V)), (∃ k : Γ(K, V), Scheme.Modules.Hom.app ι V k = f) ↔
        ∀ (z : Y) (hz : z ∈ V), z ∈ T →
          (Y.presheaf.germ V z hz).hom f ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z)) →
    wcCoherentMod K :=
by
  intro Y _ T K ι hinj hchar
  refine ⟨fun U hU f => ?_, fun U hU => ?_⟩
  · have nat : ∀ (x : Γ(K, U)),
        Scheme.Modules.Hom.app ι (Y.basicOpen f)
            ((K.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom x) =
          (Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom
            (Scheme.Modules.Hom.app ι U x) := by
      intro x
      exact NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf ι)
        (homOfLE (Y.basicOpen_le f)).op x
    haveI : IsLocalization.Away f Γ(Y, Y.basicOpen f) := hU.isLocalization_basicOpen f
    refine ⟨fun s => ?_, fun t ht => ?_⟩
    · obtain ⟨σ, hσ⟩ : ∃ σ : Γ(Y, Y.basicOpen f), Scheme.Modules.Hom.app ι (Y.basicOpen f) s = σ :=
        ⟨_, rfl⟩
      obtain ⟨n, a, hE1⟩ := IsLocalization.Away.surj f σ
      have hE1' : σ * ((Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom f) ^ n =
          (Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom a := hE1
      have hb : ∀ (z : Y) (hz : z ∈ U), z ∈ T →
          (Y.presheaf.germ U z hz).hom (f * a) ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z) := by
        intro z hzU hzT
        rw [map_mul]
        by_cases hzD : z ∈ Y.basicOpen f
        · apply Ideal.mul_mem_left
          have h1 : (Y.presheaf.germ U z hzU).hom a =
              (Y.presheaf.germ (Y.basicOpen f) z hzD).hom
                ((Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom a) :=
            (TopCat.Presheaf.germ_res_apply Y.presheaf (homOfLE (Y.basicOpen_le f)) z hzD a).symm
          rw [h1, ← hE1', map_mul]
          apply Ideal.mul_mem_right
          exact (hchar _ σ).mp ⟨s, hσ⟩ z hzD hzT
        · apply Ideal.mul_mem_right
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          intro hu
          exact hzD ((Scheme.mem_basicOpen Y f z hzU).mpr hu)
      obtain ⟨t, ht⟩ := (hchar U (f * a)).mpr hb
      refine ⟨n + 1, t, hinj _ ?_⟩
      rw [Scheme.Modules.Hom.app_smul, nat, ht, hσ]
      change ((Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom f) ^ (n + 1) * σ =
        (Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom (f * a)
      rw [map_mul, ← hE1']
      ring
    · obtain ⟨τ, hτ⟩ : ∃ τ : Γ(Y, U), Scheme.Modules.Hom.app ι U t = τ := ⟨_, rfl⟩
      have h0 : (Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom τ = 0 := by
        rw [← hτ, ← nat, ht]
        exact map_zero _
      obtain ⟨⟨m, ⟨n, hn⟩⟩, hm⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers f)
        Γ(Y, Y.basicOpen f) τ).mp h0
      have hfn : f ^ n * τ = 0 := by
        have hn' : f ^ n = m := hn
        rw [hn']
        exact hm
      refine ⟨n, hinj U ?_⟩
      rw [Scheme.Modules.Hom.app_smul, map_zero, hτ]
      exact hfn
  · haveI : IsNoetherianRing Γ(Y, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
    let Λ : Γ(K, U) →ₗ[Γ(Y, U)] Γ(Y, U) :=
      { toFun := fun k => Scheme.Modules.Hom.app ι U k
        map_add' := fun x y => map_add _ x y
        map_smul' := fun r x => Scheme.Modules.Hom.app_smul ι r x }
    exact Module.Finite.of_injective Λ (hinj U)

theorem wcpa_dj_lge_sti_twist : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (q : Y ⟶ Spec (.of K)) (r : ℕ) (ε : Fin r → (Spec (.of K) ⟶ Y)) (σ : Spec (.of K) ⟶ Y) (L : wcpaDjCoc Y) (t : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤)), wcpaDjCocOK L → wcpaDjCompat L (q ⁻¹ᵁ ⊤) 1 t → (∀ a, (Y.basicOpen (t a) : Set Y) = ((L.V a ⊓ q ⁻¹ᵁ ⊤ : Y.Opens) : Set Y) \ ⋃ i, Set.range ⇑(ε i)) → ∀ (N : ℕ) (O : Fin N → Y.Opens) (α : Fin N → Fin L.m), (∀ ν, IsAffineOpen (O ν)) → (∀ ν, O ν ≤ L.V (α ν)) → (∀ ν, σ (IsLocalRing.closedPoint K) ∉ O ν) → (∀ z : Y, z ≠ σ (IsLocalRing.closedPoint K) → ∃ ν, z ∈ O ν) → ∀ (U : Y.Opens) (f : Γ(Y, U)) (a₀ : Fin L.m), IsAffineOpen U → U ≤ L.V a₀ → σ (IsLocalRing.closedPoint K) ∈ U → (Y.basicOpen f : Set Y) = (U : Set Y) \ {σ (IsLocalRing.closedPoint K)} → ∃ (M : wcpaDjCoc Y) (tM : ∀ i : Fin M.m, Γ(Y, M.V i ⊓ q ⁻¹ᵁ ⊤)) (β : Fin M.m → Fin L.m) (hβ : ∀ i, M.V i ≤ L.V (β i)), wcpaDjCocOK M ∧ wcpaDjCompat M (q ⁻¹ᵁ ⊤) 1 tM ∧ (∀ i, (Y.basicOpen (tM i) : Set Y) = ((M.V i ⊓ q ⁻¹ᵁ ⊤ : Y.Opens) : Set Y) \ ⋃ j, Set.range ⇑(Fin.append ε (fun _ : Fin 1 => σ) j)) ∧ ∀ i j, M.V i ⊓ M.V j ≤ U ∨ (M.g i j : Γ(Y, M.V i ⊓ M.V j)) = (Y.presheaf.map (homOfLE (inf_le_inf (hβ i) (hβ j))).op).hom (L.g (β i) (β j) : Γ(Y, L.V (β i) ⊓ L.V (β j))) :=
by
  intro K _ Y q r ε σ L t hOK hcompat hbo N O α hOaff hOle hOp hOcov U f a₀ hUaff hUa₀ hpU hf
  generalize hp : σ (IsLocalRing.closedPoint K) = p at hOp hOcov hpU hf

  have hres : ∀ {A B C : Y.Opens} (h1 : A ≤ B) (h2 : B ≤ C) (x : Γ(Y, C)),
      (Y.presheaf.map (homOfLE h1).op).hom ((Y.presheaf.map (homOfLE h2).op).hom x) =
        (Y.presheaf.map (homOfLE (h1.trans h2)).op).hom x := by
    intro A B C h1 h2 x
    show (Y.presheaf.map (homOfLE h2).op ≫ Y.presheaf.map (homOfLE h1).op).hom x = _
    rw [← Functor.map_comp]
    rfl

  obtain ⟨W, hWO, hWU⟩ : ∃ W : Fin (N + 1) → Y.Opens,
      (∀ (i : Fin (N + 1)) (h : (i : ℕ) < N), W i = O ⟨i, h⟩) ∧
        (∀ i : Fin (N + 1), ¬ (i : ℕ) < N → W i = U) :=
    ⟨fun i => if h : (i : ℕ) < N then O ⟨i, h⟩ else U, fun i h => dif_pos h, fun i h => dif_neg h⟩
  obtain ⟨β, hβO, hβU⟩ : ∃ β : Fin (N + 1) → Fin L.m,
      (∀ (i : Fin (N + 1)) (h : (i : ℕ) < N), β i = α ⟨i, h⟩) ∧
        (∀ i : Fin (N + 1), ¬ (i : ℕ) < N → β i = a₀) :=
    ⟨fun i => if h : (i : ℕ) < N then α ⟨i, h⟩ else a₀, fun i h => dif_pos h, fun i h => dif_neg h⟩
  have hβ : ∀ i, W i ≤ L.V (β i) := by
    intro i
    by_cases h : (i : ℕ) < N
    · rw [hWO i h, hβO i h]; exact hOle _
    · rw [hWU i h, hβU i h]; exact hUa₀
  have hpW : ∀ i : Fin (N + 1), (i : ℕ) < N → p ∉ W i := by
    intro i h hpi
    rw [hWO i h] at hpi
    exact hOp _ hpi

  obtain ⟨e, he1, he2⟩ : ∃ e : ∀ i, Γ(Y, W i), (∀ i : Fin (N + 1), (i : ℕ) < N → e i = 1) ∧
      (∀ (i : Fin (N + 1)) (h : ¬ (i : ℕ) < N),
        e i = (Y.presheaf.map (homOfLE (hWU i h).le).op).hom f) :=
    ⟨fun i => if h : (i : ℕ) < N then 1 else (Y.presheaf.map (homOfLE (hWU i h).le).op).hom f,
      fun i h => dif_pos h, fun i h => dif_neg h⟩

  have hunit : ∀ i j (V : Y.Opens) (h1 : V ≤ W i) (h2 : V ≤ W j), i ≠ j →
      IsUnit ((Y.presheaf.map (homOfLE h1).op).hom (e i)) := by
    intro i j V h1 h2 hij
    by_cases hi : (i : ℕ) < N
    · rw [he1 i hi, map_one]; exact isUnit_one
    · rw [he2 i hi, hres]
      have hj : (j : ℕ) < N := by
        have h3 := Fin.val_ne_of_ne hij
        have h4 := j.isLt
        have h5 := i.isLt
        omega
      have hVB : V ≤ Y.basicOpen f := by
        intro z hz
        have hzU : z ∈ U := by rw [← hWU i hi]; exact h1 hz
        have hzO : z ∈ O ⟨j, hj⟩ := by rw [← hWO j hj]; exact h2 hz
        have : z ∈ (Y.basicOpen f : Set Y) := by
          rw [hf]
          refine ⟨hzU, fun hzp => ?_⟩
          rw [Set.mem_singleton_iff] at hzp
          rw [hzp] at hzO
          exact hOp _ hzO
        exact this
      have hB : IsUnit ((Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom f) :=
        RingedSpace.isUnit_res_basicOpen Y.toRingedSpace f
      rw [← hres hVB (Y.basicOpen_le f)]
      exact hB.map _

  obtain ⟨ψ, hψd, hψc⟩ : ∃ ψ : ∀ i j : Fin (N + 1), (Γ(Y, W i ⊓ W j))ˣ, (∀ i, ψ i i = 1) ∧
      ∀ i j, (ψ i j : Γ(Y, W i ⊓ W j)) *
          (Y.presheaf.map (homOfLE (inf_le_left : W i ⊓ W j ≤ W i)).op).hom (e i) =
        (Y.presheaf.map (homOfLE (inf_le_right : W i ⊓ W j ≤ W j)).op).hom (e j) := by
    refine ⟨fun i j => if h : i = j then 1 else
        (hunit j i (W i ⊓ W j) inf_le_right inf_le_left (Ne.symm h)).unit *
          (hunit i j (W i ⊓ W j) inf_le_left inf_le_right h).unit⁻¹, fun i => dif_pos rfl,
        fun i j => ?_⟩
    dsimp only
    by_cases h : i = j
    · subst h
      rw [dif_pos rfl, Units.val_one, one_mul]
    · rw [dif_neg h, Units.val_mul, mul_assoc, IsUnit.val_inv_mul, mul_one, IsUnit.unit_spec]
  have hc' : ∀ i j (T : Y.Opens) (h : T ≤ W i ⊓ W j),
      (Y.presheaf.map (homOfLE h).op).hom (ψ i j : Γ(Y, W i ⊓ W j)) *
          (Y.presheaf.map (homOfLE (h.trans inf_le_left)).op).hom (e i) =
        (Y.presheaf.map (homOfLE (h.trans inf_le_right)).op).hom (e j) := by
    intro i j T h
    rw [← hres h inf_le_left, ← hres h inf_le_right, ← map_mul, hψc]
  have hψcoc : ∀ i j k,
      (Y.presheaf.map (homOfLE (show W i ⊓ W j ⊓ W k ≤ W i ⊓ W j from inf_le_left)).op).hom
          (ψ i j : Γ(Y, W i ⊓ W j)) *
        (Y.presheaf.map (homOfLE (show W i ⊓ W j ⊓ W k ≤ W j ⊓ W k from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom
          (ψ j k : Γ(Y, W j ⊓ W k)) =
      (Y.presheaf.map (homOfLE (show W i ⊓ W j ⊓ W k ≤ W i ⊓ W k from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom
          (ψ i k : Γ(Y, W i ⊓ W k)) := by
    intro i j k
    by_cases hij : i = j
    · subst hij
      rw [hψd, Units.val_one, map_one, one_mul]
    · have hx := hunit i j (W i ⊓ W j ⊓ W k) (inf_le_left.trans inf_le_left)
        (inf_le_left.trans inf_le_right) hij
      apply hx.mul_right_cancel
      have e1 := hc' i j (W i ⊓ W j ⊓ W k) inf_le_left
      have e2 := hc' j k (W i ⊓ W j ⊓ W k) (le_inf (inf_le_left.trans inf_le_right) inf_le_right)
      have e3 := hc' i k (W i ⊓ W j ⊓ W k) (le_inf (inf_le_left.trans inf_le_left) inf_le_right)
      rw [mul_right_comm, e1, mul_comm, e2, e3]

  have haff : ∀ i, IsAffineOpen (W i) := by
    intro i
    by_cases h : (i : ℕ) < N
    · rw [hWO i h]; exact hOaff _
    · rw [hWU i h]; exact hUaff
  have hcov : (⨆ i, W i) = ⊤ := by
    rw [eq_top_iff]
    intro z _
    rw [TopologicalSpace.Opens.mem_iSup]
    by_cases hz : z = p
    · refine ⟨Fin.last N, ?_⟩
      rw [hWU (Fin.last N) (by rw [Fin.val_last]; exact lt_irrefl N), hz]; exact hpU
    · obtain ⟨ν, hν⟩ := hOcov z hz
      refine ⟨ν.castSucc, ?_⟩
      rw [hWO ν.castSucc (by rw [Fin.coe_castSucc]; exact ν.isLt)]; exact hν

  have hbe : ∀ i z, z ∈ Y.basicOpen (e i) ↔ z ∈ W i ∧ z ≠ p := by
    intro i z
    by_cases h : (i : ℕ) < N
    · rw [he1 i h, Scheme.basicOpen_one]
      constructor
      · intro hz
        refine ⟨hz, fun hzp => hpW i h ?_⟩
        rw [← hzp]; exact hz
      · exact fun hz => hz.1
    · rw [he2 i h, Scheme.basicOpen_res]
      have hfz : z ∈ Y.basicOpen f ↔ z ∈ U ∧ z ≠ p := by
        have h0 := Set.ext_iff.mp hf z
        simp only [SetLike.mem_coe, Set.mem_diff, Set.mem_singleton_iff] at h0
        exact h0
      rw [TopologicalSpace.Opens.mem_inf, hfz, hWU i h]
      tauto

  have happ : ∀ z, z ∈ (⋃ j, Set.range ⇑(Fin.append ε (fun _ : Fin 1 => σ) j)) ↔
      z ∈ (⋃ i, Set.range ⇑(ε i)) ∨ z = p := by
    intro z
    simp only [Set.mem_iUnion, Set.mem_range]
    constructor
    · rintro ⟨j, x, hx⟩
      induction j using Fin.addCases with
      | left i => rw [Fin.append_left] at hx; exact Or.inl ⟨i, x, hx⟩
      | right i =>
        rw [Fin.append_right] at hx
        right
        rw [← hx, Subsingleton.elim x (IsLocalRing.closedPoint K)]
        exact hp
    · rintro (⟨i, x, hx⟩ | hz)
      · exact ⟨Fin.castAdd 1 i, x, by rw [Fin.append_left]; exact hx⟩
      · exact ⟨Fin.natAdd r 0, IsLocalRing.closedPoint K, by rw [Fin.append_right, hz]; exact hp⟩
  refine ⟨⟨N + 1, W, fun i j => Units.map
      (Y.presheaf.map (homOfLE (inf_le_inf (hβ i) (hβ j))).op).hom.toMonoidHom (L.g (β i) (β j)) *
        ψ i j⟩,
    fun i => (Y.presheaf.map (homOfLE (inf_le_left : W i ⊓ q ⁻¹ᵁ ⊤ ≤ W i)).op).hom (e i) *
      (Y.presheaf.map (homOfLE (inf_le_inf_right (q ⁻¹ᵁ ⊤) (hβ i))).op).hom (t (β i)),
    β, hβ, ?_, ?_, ?_, ?_⟩
  ·
    refine ⟨haff, hcov, fun i => ?_, fun i j k => ?_⟩
    · dsimp only
      rw [hOK.2.2.1 (β i), map_one, hψd, one_mul]
    · dsimp only
      have hL := congrArg (Y.presheaf.map (homOfLE (show W i ⊓ W j ⊓ W k ≤
        L.V (β i) ⊓ L.V (β j) ⊓ L.V (β k) from
          inf_le_inf (inf_le_inf (hβ i) (hβ j)) (hβ k))).op).hom (hOK.2.2.2 (β i) (β j) (β k))
      simp only [map_mul, hres] at hL
      simp only [Units.val_mul, Units.coe_map, RingHom.toMonoidHom_eq_coe, MonoidHom.coe_coe,
        map_mul, hres]
      rw [mul_mul_mul_comm, hL, hψcoc i j k]
  ·
    intro i j
    dsimp only
    have hα := congrArg (Y.presheaf.map (homOfLE
      (show W i ⊓ W j ⊓ q ⁻¹ᵁ ⊤ ≤ W i ⊓ W j from inf_le_left)).op).hom (hψc i j)
    have hβ' := congrArg (Y.presheaf.map (homOfLE
      (show W i ⊓ W j ⊓ q ⁻¹ᵁ ⊤ ≤ L.V (β i) ⊓ L.V (β j) ⊓ q ⁻¹ᵁ ⊤ from
        inf_le_inf_right _ (inf_le_inf (hβ i) (hβ j)))).op).hom (hcompat (β i) (β j))
    simp only [map_mul, hres, pow_one] at hα hβ'
    simp only [pow_one, Units.val_mul, Units.coe_map, RingHom.toMonoidHom_eq_coe,
      MonoidHom.coe_coe, map_mul, hres]
    rw [hβ', ← hα]
    ring
  ·
    intro i
    dsimp only
    rw [Scheme.basicOpen_mul, Scheme.basicOpen_res, Scheme.basicOpen_res]
    ext z
    have hbt := Set.ext_iff.mp (hbo (β i)) z
    simp only [TopologicalSpace.Opens.coe_inf, Set.mem_inter_iff, SetLike.mem_coe,
      Set.mem_diff] at hbt ⊢
    rw [hbe i z, happ z, hbt]
    have hzβ : z ∈ W i → z ∈ L.V (β i) := fun hz => hβ i hz
    tauto
  ·
    intro i j
    by_cases hi : (i : ℕ) < N
    · by_cases hj : (j : ℕ) < N
      · right
        dsimp only
        have hψ1 : (ψ i j : Γ(Y, W i ⊓ W j)) = 1 := by
          have h0 := hψc i j
          rw [he1 i hi, he1 j hj, map_one, map_one, mul_one] at h0
          exact h0
        rw [Units.val_mul, hψ1, mul_one, Units.coe_map]
        rfl
      · left
        exact inf_le_right.trans (hWU j hj).le
    · left
      exact inf_le_left.trans (hWU i hi).le

theorem wcpa_dj_lge_sti_descend : ∀ (Y : Scheme.{u}) (L M : wcpaDjCoc Y), wcpaDjCocOK L → wcpaDjCocOK M → ∀ (β : Fin M.m → Fin L.m) (hβ : ∀ i, M.V i ≤ L.V (β i)) (U : Y.Opens) (F : Y.Modules), (∀ (O : Y.Opens), O ≤ U → ∀ s : Γ(F, O), s = 0) → (∀ i j, M.V i ⊓ M.V j ≤ U ∨ (M.g i j : Γ(Y, M.V i ⊓ M.V j)) = (Y.presheaf.map (homOfLE (inf_le_inf (hβ i) (hβ j))).op).hom (L.g (β i) (β j) : Γ(Y, L.V (β i) ⊓ L.V (β j)))) → ∀ n : ℕ, wcpaDjTwH1 M ⊤ F n → wcpaDjTwH1 L ⊤ F n :=
by
  intro Y L M hL hM β hβ U F hF hag n hTw c hc

  have rrY : ∀ {A B C : Y.Opens} (h1 : A ≤ B) (h2 : B ≤ C) (s : Γ(Y, C)),
      (Y.presheaf.map (homOfLE h1).op).hom ((Y.presheaf.map (homOfLE h2).op).hom s) =
        (Y.presheaf.map (homOfLE (h1.trans h2)).op).hom s := by
    intro A B C h1 h2 s
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Functor.map_comp]; rfl
  have rrG : ∀ {A B C : Y.Opens} (h1 : A ≤ B) (h2 : B ≤ C) (s : Γ(F, C)),
      (F.presheaf.map (homOfLE h1).op).hom ((F.presheaf.map (homOfLE h2).op).hom s) =
        (F.presheaf.map (homOfLE (h1.trans h2)).op).hom s := by
    intro A B C h1 h2 s
    rw [← AddMonoidHom.comp_apply, ← AddCommGrpCat.hom_comp, ← Functor.map_comp]; rfl
  have sG : ∀ {A B : Y.Opens} (h : A ≤ B) (r : Γ(Y, B)) (s : Γ(F, B)),
      (F.presheaf.map (homOfLE h).op).hom (r • s) =
        (Y.presheaf.map (homOfLE h).op).hom r • (F.presheaf.map (homOfLE h).op).hom s :=
    fun h r s => Scheme.Modules.map_smul F (homOfLE h) r s

  have alg3 : ∀ {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M]
      (Gpa Gqa Gpq : R) (Bn Bm Cpa Cqa Cpq : M),
      Cpa = Cqa + Gqa ^ n • Cpq → Cpq = Bm - Gpq ^ n • Bn → Gpq * Gqa = Gpa →
      Gpa ^ n • Bn + Cpa = Gqa ^ n • Bm + Cqa := by
    intro R M _ _ _ Gpa Gqa Gpq Bn Bm Cpa Cqa Cpq hE hF hH
    have Hn : Gpa ^ n = Gpq ^ n * Gqa ^ n := by rw [← hH, mul_pow]
    linear_combination (norm := module) hE + Gqa ^ n • hF + Hn • Bn
  have alg4 : ∀ {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M]
      (Gpa Gab Gpb : R) (β Ba Bb Cab Cpa Cpb : M),
      Bb = Gpb ^ n • β + Cpb → Ba = Gpa ^ n • β + Cpa →
      Cpb = Cab + Gab ^ n • Cpa →
      Gpa * Gab = Gpb → Cab = Bb - Gab ^ n • Ba := by
    intro R M _ _ _ Gpa Gab Gpb β Ba Bb Cab Cpa Cpb hBb hBa hE hH
    have Hn : Gpb ^ n = Gpa ^ n * Gab ^ n := by rw [← hH, mul_pow]
    linear_combination (norm := module) -hBb + Gab ^ n • hBa - hE - Hn • β

  have I3 : ∀ ν a, M.V ν ⊓ (L.V a ⊓ ⊤) ≤ L.V (β ν) ⊓ L.V a := fun ν a =>
    le_inf (inf_le_left.trans (hβ ν)) (inf_le_right.trans inf_le_left)
  have I4 : ∀ ν a, M.V ν ⊓ (L.V a ⊓ ⊤) ≤ L.V (β ν) ⊓ L.V a ⊓ ⊤ := fun ν a =>
    le_inf (I3 ν a) le_top
  have I5 : ∀ ν a, M.V ν ⊓ (L.V a ⊓ ⊤) ≤ M.V ν ⊓ ⊤ := fun ν a =>
    le_inf inf_le_left le_top
  have hcovG : ∀ W : Y.Opens, W ≤ ⨆ ν, M.V ν ⊓ W := by
    intro W y hy
    have hyU : y ∈ ⨆ ν, M.V ν := by rw [hM.2.1]; trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hyU ⊢
    obtain ⟨ν, hν⟩ := hyU
    exact ⟨ν, TopologicalSpace.Opens.mem_inf.mpr ⟨hν, hy⟩⟩

  obtain ⟨b, hb⟩ := hTw (fun i j => (F.presheaf.map (homOfLE (show
      M.V i ⊓ M.V j ⊓ ⊤ ≤ L.V (β i) ⊓ L.V (β j) ⊓ ⊤ from
      inf_le_inf_right ⊤ (inf_le_inf (hβ i) (hβ j)))).op).hom (c (β i) (β j))) (by
    intro i j k
    rcases hag j k with hjk | hjk
    · have hT : M.V i ⊓ M.V j ⊓ M.V k ⊓ ⊤ ≤ U :=
        (inf_le_left.trans (le_inf (inf_le_left.trans inf_le_right) inf_le_right)).trans hjk
      exact (hF _ hT _).trans (hF _ hT _).symm
    · simp only [hjk, map_add, sG, map_pow, rrY, rrG]
      have hC := congrArg (F.presheaf.map (homOfLE (show
          M.V i ⊓ M.V j ⊓ M.V k ⊓ ⊤ ≤ L.V (β i) ⊓ L.V (β j) ⊓ L.V (β k) ⊓ ⊤ from
        le_inf (le_inf (le_inf (inf_le_left.trans (inf_le_left.trans (inf_le_left.trans (hβ i))))
          (inf_le_left.trans (inf_le_left.trans (inf_le_right.trans (hβ j)))))
          (inf_le_left.trans (inf_le_right.trans (hβ k)))) le_top)).op).hom
        (hc (β i) (β j) (β k))
      simp only [map_add, sG, map_pow, rrY, rrG] at hC
      exact hC)
  have hβ' : ∀ i j,
      (F.presheaf.map (homOfLE (show M.V i ⊓ M.V j ⊓ ⊤ ≤ L.V (β i) ⊓ L.V (β j) ⊓ ⊤ from
          inf_le_inf_right ⊤ (inf_le_inf (hβ i) (hβ j)))).op).hom (c (β i) (β j)) =
        (F.presheaf.map (homOfLE (show M.V i ⊓ M.V j ⊓ ⊤ ≤ M.V j ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (b j) -
        ((Y.presheaf.map (homOfLE (show M.V i ⊓ M.V j ⊓ ⊤ ≤ L.V (β i) ⊓ L.V (β j) from
          inf_le_left.trans (inf_le_inf (hβ i) (hβ j)))).op).hom
            (L.g (β i) (β j) : Γ(Y, L.V (β i) ⊓ L.V (β j)))) ^ n •
        (F.presheaf.map (homOfLE (show M.V i ⊓ M.V j ⊓ ⊤ ≤ M.V i ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (b i) := by
    intro i j
    rcases hag i j with hij | hij
    · have hT : M.V i ⊓ M.V j ⊓ ⊤ ≤ U := inf_le_left.trans hij
      exact (hF _ hT _).trans (hF _ hT _).symm
    · have h := hb i j
      simp only [hij, rrY] at h
      exact h

  obtain ⟨sf, hsf⟩ : ∃ sf : ∀ a ν, Γ(F, M.V ν ⊓ (L.V a ⊓ ⊤)), ∀ a ν,
      sf a ν = (Y.presheaf.map (homOfLE (I3 ν a)).op).hom
          (L.g (β ν) a : Γ(Y, L.V (β ν) ⊓ L.V a)) ^ n •
        (F.presheaf.map (homOfLE (I5 ν a)).op).hom (b ν) +
        (F.presheaf.map (homOfLE (I4 ν a)).op).hom (c (β ν) a) := ⟨_, fun _ _ => rfl⟩
  have hglue : ∀ a, ∃ Ba : Γ(F, L.V a ⊓ ⊤), ∀ ν,
      (F.presheaf.map (homOfLE (inf_le_right : M.V ν ⊓ (L.V a ⊓ ⊤) ≤ L.V a ⊓ ⊤)).op).hom Ba =
        sf a ν := by
    intro a
    obtain ⟨s, hs, -⟩ := TopCat.Sheaf.existsUnique_gluing'
      (⟨F.presheaf, F.isSheaf⟩ : TopCat.Sheaf Ab Y)
      (fun ν => M.V ν ⊓ (L.V a ⊓ ⊤)) (L.V a ⊓ ⊤) (fun ν => homOfLE inf_le_right)
      (hcovG _) (sf a) (by
        intro i j
        show (F.presheaf.map (homOfLE (inf_le_left :
            (M.V i ⊓ (L.V a ⊓ ⊤)) ⊓ (M.V j ⊓ (L.V a ⊓ ⊤)) ≤ M.V i ⊓ (L.V a ⊓ ⊤))).op).hom
              (sf a i) =
          (F.presheaf.map (homOfLE (inf_le_right :
            (M.V i ⊓ (L.V a ⊓ ⊤)) ⊓ (M.V j ⊓ (L.V a ⊓ ⊤)) ≤ M.V j ⊓ (L.V a ⊓ ⊤))).op).hom
              (sf a j)
        simp only [hsf, map_add, sG, map_pow, rrY, rrG]
        have hE := congrArg (F.presheaf.map (homOfLE (show
            (M.V i ⊓ (L.V a ⊓ ⊤)) ⊓ (M.V j ⊓ (L.V a ⊓ ⊤)) ≤
              L.V (β i) ⊓ L.V (β j) ⊓ L.V a ⊓ ⊤ from
          le_inf (le_inf (le_inf (inf_le_left.trans (inf_le_left.trans (hβ i)))
            (inf_le_right.trans (inf_le_left.trans (hβ j))))
            (inf_le_left.trans (inf_le_right.trans inf_le_left)))
            le_top)).op).hom (hc (β i) (β j) a)
        simp only [map_add, sG, map_pow, rrY, rrG] at hE
        have hF' := congrArg (F.presheaf.map (homOfLE (show
            (M.V i ⊓ (L.V a ⊓ ⊤)) ⊓ (M.V j ⊓ (L.V a ⊓ ⊤)) ≤ M.V i ⊓ M.V j ⊓ ⊤ from
          le_inf (le_inf (inf_le_left.trans inf_le_left) (inf_le_right.trans inf_le_left))
            le_top)).op).hom (hβ' i j)
        simp only [map_sub, sG, map_pow, rrY, rrG] at hF'
        have hH := congrArg (Y.presheaf.map (homOfLE (show
            (M.V i ⊓ (L.V a ⊓ ⊤)) ⊓ (M.V j ⊓ (L.V a ⊓ ⊤)) ≤ L.V (β i) ⊓ L.V (β j) ⊓ L.V a from
          le_inf (le_inf (inf_le_left.trans (inf_le_left.trans (hβ i)))
            (inf_le_right.trans (inf_le_left.trans (hβ j))))
            (inf_le_left.trans (inf_le_right.trans inf_le_left)))).op).hom
          (hL.2.2.2 (β i) (β j) a)
        simp only [map_mul, rrY] at hH
        exact alg3 _ _ _ _ _ _ _ _ hE hF' hH)
    exact ⟨s, hs⟩
  choose B hB using hglue

  refine ⟨B, fun a b' => ?_⟩
  refine TopCat.Sheaf.eq_of_locally_eq' (⟨F.presheaf, F.isSheaf⟩ : TopCat.Sheaf Ab Y)
    (fun ν => M.V ν ⊓ (L.V a ⊓ L.V b' ⊓ ⊤)) (L.V a ⊓ L.V b' ⊓ ⊤)
    (fun ν => homOfLE inf_le_right) (hcovG _) _ _ (fun ν => ?_)
  show (F.presheaf.map (homOfLE (inf_le_right :
      M.V ν ⊓ (L.V a ⊓ L.V b' ⊓ ⊤) ≤ L.V a ⊓ L.V b' ⊓ ⊤)).op).hom (c a b') =
    (F.presheaf.map (homOfLE (inf_le_right :
      M.V ν ⊓ (L.V a ⊓ L.V b' ⊓ ⊤) ≤ L.V a ⊓ L.V b' ⊓ ⊤)).op).hom _
  simp only [map_sub, sG, map_pow, rrY, rrG]
  have hBb := congrArg (F.presheaf.map (homOfLE (show
      M.V ν ⊓ (L.V a ⊓ L.V b' ⊓ ⊤) ≤ M.V ν ⊓ (L.V b' ⊓ ⊤) from
    le_inf inf_le_left (le_inf (inf_le_right.trans (inf_le_left.trans inf_le_right))
      le_top))).op).hom (hB b' ν)
  simp only [hsf, map_add, sG, map_pow, rrY, rrG] at hBb
  have hBa := congrArg (F.presheaf.map (homOfLE (show
      M.V ν ⊓ (L.V a ⊓ L.V b' ⊓ ⊤) ≤ M.V ν ⊓ (L.V a ⊓ ⊤) from
    le_inf inf_le_left (le_inf (inf_le_right.trans (inf_le_left.trans inf_le_left))
      le_top))).op).hom (hB a ν)
  simp only [hsf, map_add, sG, map_pow, rrY, rrG] at hBa
  have hE := congrArg (F.presheaf.map (homOfLE (show
      M.V ν ⊓ (L.V a ⊓ L.V b' ⊓ ⊤) ≤ L.V (β ν) ⊓ L.V a ⊓ L.V b' ⊓ ⊤ from
    le_inf (le_inf (le_inf (inf_le_left.trans (hβ ν))
      (inf_le_right.trans (inf_le_left.trans inf_le_left)))
      (inf_le_right.trans (inf_le_left.trans inf_le_right)))
      le_top)).op).hom (hc (β ν) a b')
  simp only [map_add, sG, map_pow, rrY, rrG] at hE
  have hH := congrArg (Y.presheaf.map (homOfLE (show
      M.V ν ⊓ (L.V a ⊓ L.V b' ⊓ ⊤) ≤ L.V (β ν) ⊓ L.V a ⊓ L.V b' from
    le_inf (le_inf (inf_le_left.trans (hβ ν))
      (inf_le_right.trans (inf_le_left.trans inf_le_left)))
      (inf_le_right.trans (inf_le_left.trans inf_le_right)))).op).hom (hL.2.2.2 (β ν) a b')
  simp only [map_mul, rrY] at hH
  exact alg4 _ _ _ _ _ _ _ _ _ hBb hBa hE hH

theorem wcpa_dj_lge_serre_tail_ideal : ∀ (K : Type u) [Field K] [IsAlgClosed K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (r : ℕ) (ε : Fin r → (Spec (.of K) ⟶ C)) (L : wcpaDjCoc C)
    (t : ∀ a : Fin L.m, Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤)),
    wcpaDjSemistable q → wcpaDjSections q r ε → wcpaDjCocOK L →
    wcpaDjCompat L (q ⁻¹ᵁ ⊤) 1 t →
    (∀ a, (C.basicOpen (t a) : Set C) =
      ((L.V a ⊓ q ⁻¹ᵁ ⊤ : C.Opens) : Set C) \ ⋃ i, Set.range ⇑(ε i)) →
    ∀ E₀ ∈ irreducibleComponents C, (∀ b, ε b (IsLocalRing.closedPoint K) ∉ E₀) →
    (∀ E ∈ irreducibleComponents C, E ≠ E₀ → ∃ b, ε b (IsLocalRing.closedPoint K) ∈ E) →
    ∀ (T : Set C), E₀ ⊆ T →
    ∀ (F : C.Modules) (ι : F ⟶ wcStructMod C),
    (∀ V : C.Opens, Function.Injective (Scheme.Modules.Hom.app ι V)) →
    (∀ (V : C.Opens) (f : Γ(C, V)), (∃ k : Γ(F, V), Scheme.Modules.Hom.app ι V k = f) ↔
      ∀ (z : C) (hz : z ∈ V), z ∈ T →
        (C.presheaf.germ V z hz).hom f ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk z)) →
    ∃ n₀ : ℕ, ∀ n ≥ n₀, wcpaDjTwH1 L ⊤ F n :=
by
  intro K _ _ C q r ε L t hss hsec hOK hcompat hbo E₀ hE₀ hE₀b hoth T hT F ι hinj hiff
  classical

  haveI : IsProper q := hss.2.1
  haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian q
  haveI : CompactSpace C := by
    rw [← isCompact_univ_iff]
    have h := QuasiCompact.isCompact_preimage (f := q) Set.univ isOpen_univ isCompact_univ
    simpa using h
  haveI : IsNoetherian C := {}

  haveI hred : AlgebraicGeometry.IsReduced C := by
    haveI := wcpa_dj_ldx_semistable_fibre_reduced C (Spec (.of K)) q hss K (𝟙 _)
    exact isReduced_of_isOpenImmersion (inv (Limits.pullback.fst q (𝟙 _)))
  have hcov : ∀ z : C, ∃ a, z ∈ L.V a := by
    intro z
    have hz : z ∈ (⊤ : C.Opens) := trivial
    rw [← hOK.2.1] at hz
    exact TopologicalSpace.Opens.mem_iSup.mp hz

  have hzero : ∀ (O : C.Opens), (O : Set C) ⊆ T → ∀ k : Γ(F, O), k = 0 := by
    intro O hO k
    have h1 := (hiff O (Scheme.Modules.Hom.app ι O k)).mp ⟨k, rfl⟩
    have h2 : C.basicOpen (Scheme.Modules.Hom.app ι O k : Γ(C, O)) = ⊥ := by
      rw [eq_bot_iff]
      intro z hz
      have hzO : z ∈ O := Scheme.basicOpen_le C _ hz
      have hu := (Scheme.mem_basicOpen C _ z hzO).mp hz
      exact absurd hu (h1 z hzO (hO hzO))
    have h3 := eq_zero_of_basicOpen_eq_bot _ h2
    apply hinj O
    rw [h3]
    exact (map_zero _).symm

  obtain ⟨t₃, ht₃s, -, ht₃E, ht₃o, ht₃x, ht₃sm⟩ :=
    wcpa_dj_lus_am_component_points K C q hss r ε hsec.1 E₀ hE₀
  have hpcl : IsClosed ({t₃ 0 (IsLocalRing.closedPoint K)} : Set C) :=
    wc_pfam_mc_rational_point_closed K C q (t₃ 0) (ht₃s 0)

  have hchart : ∀ (A O : C.Opens), IsAffineOpen A → t₃ 0 (IsLocalRing.closedPoint K) ∈ A →
      t₃ 0 (IsLocalRing.closedPoint K) ∈ O →
      ∃ U : C.Opens, IsAffineOpen U ∧ t₃ 0 (IsLocalRing.closedPoint K) ∈ U ∧ U ≤ A ∧ U ≤ O ∧
        (U : Set C) ⊆ E₀ := by
    intro A O hA hpA hpO
    set S : Set C := ⋃ E ∈ {E | E ∈ irreducibleComponents C ∧ E ≠ E₀}, E with hS
    have hScl : IsClosed S := by
      apply Set.Finite.isClosed_biUnion
      · exact TopologicalSpace.NoetherianSpace.finite_irreducibleComponents.subset
          (fun E hE => hE.1)
      · intro E hE
        exact isClosed_of_mem_irreducibleComponents E hE.1
    have hpS : t₃ 0 (IsLocalRing.closedPoint K) ∉ S := by
      intro h
      simp only [hS, Set.mem_iUnion, Set.mem_setOf_eq] at h
      obtain ⟨E, ⟨hE, hne⟩, hpE⟩ := h
      exact ht₃o 0 E hE hne hpE
    let G : C.Opens := O ⊓ ⟨Sᶜ, hScl.isOpen_compl⟩
    have hpG : t₃ 0 (IsLocalRing.closedPoint K) ∈ G := by
      show t₃ 0 (IsLocalRing.closedPoint K) ∈ (O : Set C) ∩ Sᶜ
      exact ⟨hpO, hpS⟩
    obtain ⟨h, hhG, hph⟩ := hA.exists_basicOpen_le (V := G) ⟨_, hpG⟩ hpA
    refine ⟨C.basicOpen h, hA.basicOpen h, hph, Scheme.basicOpen_le C h,
      le_trans hhG inf_le_left, ?_⟩
    intro z hz
    obtain ⟨E, hE, hzE⟩ :=
      exists_mem_irreducibleComponents_subset_of_isIrreducible {z} isIrreducible_singleton
    by_contra hzE₀
    have hne : E ≠ E₀ := fun h => hzE₀ (h ▸ hzE (Set.mem_singleton z))
    have hzG : z ∈ (O : Set C) ∩ Sᶜ := hhG hz
    apply hzG.2
    simp only [hS, Set.mem_iUnion, Set.mem_setOf_eq]
    exact ⟨E, ⟨hE, hne⟩, hzE (Set.mem_singleton z)⟩

  have hcover : ∃ (N : ℕ) (O : Fin N → C.Opens) (α : Fin N → Fin L.m),
      (∀ ν, IsAffineOpen (O ν)) ∧ (∀ ν, O ν ≤ L.V (α ν)) ∧
      (∀ ν, t₃ 0 (IsLocalRing.closedPoint K) ∉ O ν) ∧
      ∀ z : C, z ≠ t₃ 0 (IsLocalRing.closedPoint K) → ∃ ν, z ∈ O ν := by
    let P : C.Opens := ⟨{t₃ 0 (IsLocalRing.closedPoint K)}ᶜ, hpcl.isOpen_compl⟩
    have hloc : ∀ z : {z : C // z ≠ t₃ 0 (IsLocalRing.closedPoint K)},
        ∃ (a : Fin L.m) (h : Γ(C, L.V a)), C.basicOpen h ≤ L.V a ⊓ P ∧ z.1 ∈ C.basicOpen h := by
      intro z
      obtain ⟨a, ha⟩ := hcov z.1
      have hzP : z.1 ∈ L.V a ⊓ P := by
        show z.1 ∈ (L.V a : Set C) ∩ {t₃ 0 (IsLocalRing.closedPoint K)}ᶜ
        exact ⟨ha, z.2⟩
      obtain ⟨h, h1, h2⟩ := (hOK.1 a).exists_basicOpen_le (V := L.V a ⊓ P) ⟨z.1, hzP⟩ ha
      exact ⟨a, h, h1, h2⟩
    choose a h hle hmem using hloc
    have hcomp : IsCompact ({t₃ 0 (IsLocalRing.closedPoint K)}ᶜ : Set C) :=
      TopologicalSpace.NoetherianSpace.isCompact _
    obtain ⟨s, hs⟩ := hcomp.elim_finite_subcover (fun z => (C.basicOpen (h z) : Set C))
      (fun z => (C.basicOpen (h z)).isOpen) (by
        intro z hz
        exact Set.mem_iUnion.mpr ⟨⟨z, hz⟩, hmem ⟨z, hz⟩⟩)
    refine ⟨s.card, fun ν => C.basicOpen (h (s.equivFin.symm ν).1),
      fun ν => a (s.equivFin.symm ν).1, fun ν => (hOK.1 _).basicOpen _,
      fun ν => le_trans (hle _) inf_le_left, fun ν hpν => ?_, ?_⟩
    · have h1 : t₃ 0 (IsLocalRing.closedPoint K) ∈
          (L.V (a (s.equivFin.symm ν).1) : Set C) ∩ {t₃ 0 (IsLocalRing.closedPoint K)}ᶜ :=
        hle _ hpν
      exact h1.2 (Set.mem_singleton _)
    · intro z hz
      have hz' : z ∈ ({t₃ 0 (IsLocalRing.closedPoint K)}ᶜ : Set C) := hz
      have h1 := hs hz'
      simp only [Set.mem_iUnion] at h1
      obtain ⟨w, hw, hzw⟩ := h1
      refine ⟨s.equivFin ⟨w, hw⟩, ?_⟩
      have e : s.equivFin.symm (s.equivFin ⟨w, hw⟩) = ⟨w, hw⟩ := Equiv.symm_apply_apply _ _
      show z ∈ C.basicOpen (h (s.equivFin.symm (s.equivFin ⟨w, hw⟩)).1)
      rw [e]
      exact hzw

  obtain ⟨V, f, hVaff, hpV, hVf⟩ : ∃ (V : C.Opens) (f : Γ(C, V)), IsAffineOpen V ∧
      t₃ 0 (IsLocalRing.closedPoint K) ∈ V ∧
      (C.basicOpen f : Set C) = (V : Set C) \ {t₃ 0 (IsLocalRing.closedPoint K)} := by
    obtain ⟨V, f, hVa, hpV, hW⟩ := wcpa_dj_lsp_dc_local_eq_section q 1 (fun _ => t₃ 0)
      inferInstance
      ⟨fun _ => ht₃s 0, fun i j _ _ hij => absurd (Subsingleton.elim i j) hij,
        fun _ x => by rw [Subsingleton.elim x (IsLocalRing.closedPoint K)]; exact ht₃sm 0⟩
      0 (IsLocalRing.closedPoint K)
    refine ⟨V, f, hVa, hpV, ?_⟩
    ext z
    constructor
    · intro hz
      refine ⟨Scheme.basicOpen_le C f hz, ?_⟩
      intro hzp
      rw [Set.mem_singleton_iff] at hzp
      subst hzp
      obtain ⟨-, h2⟩ := hW V hVa (le_refl V)
      have h3 : ((t₃ 0).app V).hom ((C.presheaf.map (homOfLE (le_refl V)).op).hom f) = 0 :=
        (h2 ((C.presheaf.map (homOfLE (le_refl V)).op).hom f)).mpr
          (Ideal.subset_span (Set.mem_singleton _)) 0
      have e := Scheme.basicOpen_res C f (homOfLE (le_refl V)).op
      have h4 : t₃ 0 (IsLocalRing.closedPoint K) ∈
          C.basicOpen ((C.presheaf.map (homOfLE (le_refl V)).op).hom f) :=
        (congrArg (fun O : C.Opens => t₃ 0 (IsLocalRing.closedPoint K) ∈ O) e).mpr ⟨hpV, hz⟩
      have e2 := Scheme.preimage_basicOpen (t₃ 0)
        ((C.presheaf.map (homOfLE (le_refl V)).op).hom f)
      have h5 : IsLocalRing.closedPoint K ∈ (Spec (.of K)).basicOpen
          (((t₃ 0).app V).hom ((C.presheaf.map (homOfLE (le_refl V)).op).hom f)) :=
        (congrArg (fun O => IsLocalRing.closedPoint K ∈ O) e2).mp h4
      rw [h3, Scheme.basicOpen_zero] at h5
      exact h5
    · rintro ⟨hzV, hzp⟩
      let G : C.Opens := V ⊓ ⟨{t₃ 0 (IsLocalRing.closedPoint K)}ᶜ, hpcl.isOpen_compl⟩
      have hzG : z ∈ G := ⟨hzV, hzp⟩
      obtain ⟨h, hhG, hzh⟩ := hVa.exists_basicOpen_le (V := G) ⟨z, hzG⟩ hzV
      have hWV : C.basicOpen h ≤ V := le_trans hhG inf_le_left
      obtain ⟨-, h2⟩ := hW (C.basicOpen h) (hVa.basicOpen h) hWV
      have hbot : (t₃ 0) ⁻¹ᵁ C.basicOpen h = ⊥ := by
        rw [eq_bot_iff]
        intro x hx
        have hx' : t₃ 0 x ∈ C.basicOpen h := hx
        rw [Subsingleton.elim x (IsLocalRing.closedPoint K)] at hx'
        have hx'' : t₃ 0 (IsLocalRing.closedPoint K) ∈
            (V : Set C) ∩ {t₃ 0 (IsLocalRing.closedPoint K)}ᶜ := hhG hx'
        exact absurd (Set.mem_singleton _) hx''.2
      have h1 : ((t₃ 0).app (C.basicOpen h)).hom 1 = 0 := by
        apply eq_zero_of_basicOpen_eq_bot
        rw [eq_bot_iff, ← hbot]
        exact Scheme.basicOpen_le _ _
      have hu : IsUnit ((C.presheaf.map (homOfLE hWV).op).hom f) :=
        Ideal.span_singleton_eq_top.mp ((Ideal.eq_top_iff_one _).mpr ((h2 1).mp (fun _ => h1)))
      have e := Scheme.basicOpen_res C f (homOfLE hWV).op
      have e' := Scheme.basicOpen_of_isUnit C hu
      have hz2 : z ∈ C.basicOpen ((C.presheaf.map (homOfLE hWV).op).hom f) := by
        rw [e']
        exact hzh
      have hz4 : z ∈ C.basicOpen h ⊓ C.basicOpen f :=
        (congrArg (fun O : C.Opens => z ∈ O) e).mp hz2
      exact hz4.2

  obtain ⟨a₀, ha₀⟩ := hcov (t₃ 0 (IsLocalRing.closedPoint K))
  obtain ⟨U, hUaff, hpU, hUa₀, hUV, hUE₀⟩ := hchart (L.V a₀) V (hOK.1 a₀) ha₀ hpV
  set fU : Γ(C, U) := (C.presheaf.map (homOfLE hUV).op).hom f with hfUdef
  have hfU : (C.basicOpen fU : Set C) = (U : Set C) \ {t₃ 0 (IsLocalRing.closedPoint K)} := by
    rw [show C.basicOpen fU = U ⊓ C.basicOpen f from Scheme.basicOpen_res C f (homOfLE hUV).op,
      TopologicalSpace.Opens.coe_inf, hVf]
    ext z
    constructor
    · rintro ⟨hzU, -, hzp⟩
      exact ⟨hzU, hzp⟩
    · rintro ⟨hzU, hzp⟩
      exact ⟨hzU, hUV hzU, hzp⟩

  obtain ⟨N, O, α, hOaff, hOle, hOp, hOcov⟩ := hcover

  obtain ⟨M, tM, β, hβ, hOKM, hcompM, hboM, hagree⟩ :=
    wcpa_dj_lge_sti_twist K C q r ε (t₃ 0) L t hOK hcompat hbo N O α hOaff hOle hOp hOcov
      U fU a₀ hUaff hUa₀ hpU hfU

  have hsec' : wcpaDjSections q (r + 1) (Fin.append ε (fun _ : Fin 1 => t₃ 0)) := by
    refine ⟨fun j => ?_, fun i j x y hij => ?_, fun j x => ?_⟩
    · induction j using Fin.addCases with
      | left i => rw [Fin.append_left]; exact hsec.1 i
      | right i => rw [Fin.append_right]; exact ht₃s 0
    · induction i using Fin.addCases with
      | left i' =>
        induction j using Fin.addCases with
        | left j' =>
          rw [Fin.append_left, Fin.append_left]
          exact hsec.2.1 i' j' x y (fun h => hij (by rw [h]))
        | right j' =>
          rw [Fin.append_left, Fin.append_right, Subsingleton.elim x (IsLocalRing.closedPoint K),
            Subsingleton.elim y (IsLocalRing.closedPoint K)]
          exact fun h => ht₃x 0 i' h.symm
      | right i' =>
        induction j using Fin.addCases with
        | left j' =>
          rw [Fin.append_right, Fin.append_left, Subsingleton.elim x (IsLocalRing.closedPoint K),
            Subsingleton.elim y (IsLocalRing.closedPoint K)]
          exact ht₃x 0 j'
        | right j' =>
          exact absurd (congrArg (Fin.natAdd r) (Subsingleton.elim i' j')) hij
    · induction j using Fin.addCases with
      | left i => rw [Fin.append_left]; exact hsec.2.2 i x
      | right i =>
        rw [Fin.append_right, Subsingleton.elim x (IsLocalRing.closedPoint K)]
        exact ht₃sm 0

  have hcomp' : ∀ E ∈ irreducibleComponents C, ∃ b,
      (Fin.append ε (fun _ : Fin 1 => t₃ 0)) b (IsLocalRing.closedPoint K) ∈ E := by
    intro E hE
    by_cases h : E = E₀
    · refine ⟨Fin.natAdd r 0, ?_⟩
      rw [Fin.append_right, h]
      exact ht₃E 0
    · obtain ⟨b, hb⟩ := hoth E hE h
      exact ⟨Fin.castAdd 1 b, by rw [Fin.append_left]; exact hb⟩

  obtain ⟨n₀, hn₀⟩ := wcpa_dj_lge_serre_no_tail K C q (r + 1)
    (Fin.append ε (fun _ : Fin 1 => t₃ 0)) M tM hss hsec' hOKM hcompM hboM hcomp' F
    (wcpa_dj_lcp_cta_ideal_coherent C T F ι hinj hiff)

  have hFU : ∀ (O' : C.Opens), O' ≤ U → ∀ s : Γ(F, O'), s = 0 :=
    fun O' hO' s => hzero O' (fun z hz => hT (hUE₀ (hO' hz))) s

  exact ⟨n₀, fun n hn => wcpa_dj_lge_sti_descend C L M hOK hOKM β hβ U F hFU hagree n (hn₀ n hn)⟩

theorem wcpa_dj_lge_tr_p1_charts : ∀ (K : Type u) [Field K] (E : Scheme.{u}) (θ : E ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra), ∃ W₀ W₁ : E.Opens, IsAffineOpen W₀ ∧ IsAffineOpen W₁ ∧ W₀ ⊔ W₁ = ⊤ ∧ IsPrincipalIdealRing Γ(E, W₀) ∧ IsPrincipalIdealRing Γ(E, W₁) ∧ ∀ h : Γ(E, W₀ ⊓ W₁), ∃ (h₀ : Γ(E, W₀)) (h₁ : Γ(E, W₁)), h = (E.presheaf.map (homOfLE (inf_le_left : W₀ ⊓ W₁ ≤ W₀)).op).hom h₀ - (E.presheaf.map (homOfLE (inf_le_right : W₀ ⊓ W₁ ≤ W₁)).op).hom h₁ :=
by
  intro K _ E θ
  classical

  have transport : ∀ (P : Scheme.{u}) (φ : E ⟶ P) [IsIso φ] (D₀ D₁ : P.Opens),
      IsAffineOpen D₀ → IsAffineOpen D₁ → D₀ ⊔ D₁ = ⊤ →
      IsPrincipalIdealRing Γ(P, D₀) → IsPrincipalIdealRing Γ(P, D₁) →
      (∀ h : Γ(P, D₀ ⊓ D₁), ∃ (h₀ : Γ(P, D₀)) (h₁ : Γ(P, D₁)),
        h = (P.presheaf.map (homOfLE (inf_le_left : D₀ ⊓ D₁ ≤ D₀)).op).hom h₀ -
          (P.presheaf.map (homOfLE (inf_le_right : D₀ ⊓ D₁ ≤ D₁)).op).hom h₁) →
      ∃ W₀ W₁ : E.Opens, IsAffineOpen W₀ ∧ IsAffineOpen W₁ ∧ W₀ ⊔ W₁ = ⊤ ∧
        IsPrincipalIdealRing Γ(E, W₀) ∧ IsPrincipalIdealRing Γ(E, W₁) ∧
        ∀ h : Γ(E, W₀ ⊓ W₁), ∃ (h₀ : Γ(E, W₀)) (h₁ : Γ(E, W₁)),
          h = (E.presheaf.map (homOfLE (inf_le_left : W₀ ⊓ W₁ ≤ W₀)).op).hom h₀ -
            (E.presheaf.map (homOfLE (inf_le_right : W₀ ⊓ W₁ ≤ W₁)).op).hom h₁ := by
    intro P φ _ D₀ D₁ hA₀ hA₁ hsup hP₀ hP₁ hsplit
    have hsurj : ∀ U : P.Opens, Function.Surjective (φ.app U).hom := fun U =>
      (ConcreteCategory.bijective_of_isIso (φ.app U)).2
    refine ⟨φ ⁻¹ᵁ D₀, φ ⁻¹ᵁ D₁, hA₀.preimage_of_isIso φ, hA₁.preimage_of_isIso φ, ?_,
      IsPrincipalIdealRing.of_surjective (φ.app D₀).hom (hsurj D₀),
      IsPrincipalIdealRing.of_surjective (φ.app D₁).hom (hsurj D₁), ?_⟩
    · rw [← Scheme.Hom.preimage_sup, hsup, Scheme.Hom.preimage_top]
    · intro h
      obtain ⟨h', hh'⟩ := hsurj (D₀ ⊓ D₁) h
      obtain ⟨h₀', h₁', hs⟩ := hsplit h'
      refine ⟨(φ.app D₀).hom h₀', (φ.app D₁).hom h₁', ?_⟩
      have n₀ := congrArg (fun g => g.hom h₀')
        (Scheme.Hom.naturality φ (homOfLE (inf_le_left : D₀ ⊓ D₁ ≤ D₀)).op)
      have n₁ := congrArg (fun g => g.hom h₁')
        (Scheme.Hom.naturality φ (homOfLE (inf_le_right : D₀ ⊓ D₁ ≤ D₁)).op)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at n₀ n₁
      rw [← hh', hs, map_sub, n₀, n₁]
      rfl

  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) K) := MvPolynomial.gradedAlgebra
  have hdeg : ∀ e : Fin 2, (MvPolynomial.X e : MvPolynomial (Fin 2) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin 2) K 1 := fun e =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K e)

  have hcover : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0) ⊔
      Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 1) = ⊤ := by
    have hi : (⨆ a : Fin 2, Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        (MvPolynomial.X a)) = ⊤ := by
      refine Proj.iSup_basicOpen_eq_top _ _ ?_
      intro p hp
      have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin 2) K) 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) K)
          p).mp hp
      have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin 2) K) 0 p =
          MvPolynomial.homogeneousComponent 0 p :=
        (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
      rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
      rw [← Set.image_univ]
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro e he
      rw [MvPolynomial.mem_support_iff] at he
      have hne : e ≠ 0 := by
        rintro rfl
        exact he h0
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
      exact ⟨i, Set.mem_univ i, by simpa using hi⟩
    refine eq_top_iff.mpr ?_
    rw [← hi]
    refine iSup_le (fun a => ?_)
    fin_cases a
    · exact le_sup_left
    · exact le_sup_right
  have away_poly : ∀ (e : Fin 2) (x : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (MvPolynomial.X e)),
      ∃ P : Polynomial K, x = P.eval₂
        ((HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
            (Submonoid.powers (MvPolynomial.X e))).comp
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)))
        (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
          ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K e)) 1
          (MvPolynomial.X (e + 1))
          ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K (e + 1)))) := by
    intro e x
    have hne : e + 1 ≠ e := by fin_cases e <;> decide
    have hcases : ∀ j : Fin 2, j = e ∨ j = e + 1 := by
      intro j; fin_cases e <;> fin_cases j <;> simp

    have scale : ∀ {S : Type u} [CommRing S] (φ : K →+* S) (y : Fin (1 + 1) → S) (t : S) (n : ℕ)
        (F : MvPolynomial (Fin (1 + 1)) K), F.IsHomogeneous n →
        MvPolynomial.eval₂ φ (fun j => t * y j) F = t ^ n * MvPolynomial.eval₂ φ y F := by
      intro S _ φ y t n F hF
      conv_lhs => rw [F.as_sum]
      conv_rhs => rw [F.as_sum]
      rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun d hd => ?_)
      have hdeg : Finsupp.degree d = n := by
        by_contra h
        exact (MvPolynomial.mem_support_iff.mp hd) (hF.coeff_eq_zero h)
      rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
      have hp : (d.prod fun i e => (t * y i) ^ e) = t ^ n * d.prod fun i e => y i ^ e := by
        simp only [mul_pow]
        rw [Finsupp.prod_mul]
        congr 1
        rw [← hdeg, Finsupp.degree_apply]
        unfold Finsupp.prod
        rw [Finset.prod_pow_eq_pow_sum]
      rw [hp]
      ring
    have hX : (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K e)
    obtain ⟨n, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) hX x
    have hFh : F.IsHomogeneous n := by
      rw [smul_eq_mul, mul_one] at hF
      exact (MvPolynomial.mem_homogeneousSubmodule n F).1 hF

    obtain ⟨ρt, hρC, hρa, hρs⟩ : ∃ ρt : MvPolynomial (Fin (1 + 1)) K →+* Polynomial K,
        (∀ c : K, ρt (MvPolynomial.C c) = Polynomial.C c) ∧ ρt (MvPolynomial.X e) = 1 ∧
        ρt (MvPolynomial.X (e + 1)) = Polynomial.X :=
      ⟨MvPolynomial.eval₂Hom Polynomial.C (fun j => if j = e then (1 : Polynomial K) else Polynomial.X),
        fun c => by rw [MvPolynomial.eval₂Hom_C],
        by rw [MvPolynomial.eval₂Hom_X', if_pos rfl],
        by rw [MvPolynomial.eval₂Hom_X', if_neg hne]⟩
    refine ⟨ρt F, ?_⟩
    have hu1 : (Localization.mk 1 ⟨MvPolynomial.X e, Submonoid.mem_powers _⟩ :
        Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K)) *
        algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K)) (MvPolynomial.X e) = 1 := by
      rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
      exact Localization.mk_self (⟨MvPolynomial.X e, Submonoid.mem_powers _⟩ :
        Submonoid.powers (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K))
    have hcomp : ((algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X e))
          (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K))).comp
          (Polynomial.eval₂RingHom
            ((HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
              (Submonoid.powers (MvPolynomial.X e))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)))
            (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
              ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K e)) 1
              (MvPolynomial.X (e + 1))
              ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                (MvPolynomial.isHomogeneous_X K (e + 1)))))).comp ρt =
        MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K))).comp MvPolynomial.C)
          (fun j => (Localization.mk 1 ⟨MvPolynomial.X e, Submonoid.mem_powers _⟩ :
            Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K)) *
            algebraMap (MvPolynomial (Fin (1 + 1)) K)
              (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K))
              (MvPolynomial.X j)) := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, RingHom.comp_apply, hρC, Polynomial.coe_eval₂RingHom,
          Polynomial.eval₂_C, MvPolynomial.eval₂Hom_C, RingHom.comp_apply, RingHom.comp_apply,
          HomogeneousLocalization.algebraMap_apply, ← Localization.mk_one_eq_algebraMap]
        have h1 : ((algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0) c :
            ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)) : MvPolynomial (Fin (1 + 1)) K) =
            MvPolynomial.C c := by
          rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        rw [← h1]
        rfl
      · intro j
        rw [MvPolynomial.eval₂Hom_X', RingHom.comp_apply, RingHom.comp_apply]
        rcases hcases j with h | h
        · subst h
          rw [hρa, map_one, map_one, hu1]
        · subst h
          rw [hρs, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
            HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
            ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
          congr 1
          ext
          simp
    have hev : MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K))).comp MvPolynomial.C)
          (fun j => algebraMap (MvPolynomial (Fin (1 + 1)) K)
              (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K))
              (MvPolynomial.X j)) =
        algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K)) := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      · intro j
        rw [MvPolynomial.eval₂Hom_X']
    have h1 := RingHom.congr_fun hcomp F
    rw [RingHom.comp_apply, RingHom.comp_apply, Polynomial.coe_eval₂RingHom] at h1
    apply HomogeneousLocalization.val_injective (Submonoid.powers (MvPolynomial.X e))
    rw [HomogeneousLocalization.Away.val_mk, ← HomogeneousLocalization.algebraMap_apply,
      Localization.mk_eq_mk'_apply, eq_comm, IsLocalization.eq_mk'_iff_mul_eq]
    rw [h1, MvPolynomial.coe_eval₂Hom]
    have hs := scale ((algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K))).comp MvPolynomial.C)
      (fun j => algebraMap (MvPolynomial (Fin (1 + 1)) K)
            (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K))
            (MvPolynomial.X j))
      (Localization.mk 1 ⟨MvPolynomial.X e, Submonoid.mem_powers _⟩) n F hFh
    rw [hs, ← MvPolynomial.coe_eval₂Hom, hev]
    show _ * algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K)) (MvPolynomial.X e ^ n) = _
    rw [map_pow]
    calc (Localization.mk 1 ⟨MvPolynomial.X e, Submonoid.mem_powers _⟩ :
          Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K)) ^ n *
          algebraMap (MvPolynomial (Fin (1 + 1)) K)
            (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K)) F *
          algebraMap (MvPolynomial (Fin (1 + 1)) K)
            (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K))
            (MvPolynomial.X e) ^ n
        = ((Localization.mk 1 ⟨MvPolynomial.X e, Submonoid.mem_powers _⟩ :
          Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K)) *
          algebraMap (MvPolynomial (Fin (1 + 1)) K)
            (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K))
            (MvPolynomial.X e)) ^ n *
          algebraMap (MvPolynomial (Fin (1 + 1)) K)
            (Localization.Away (MvPolynomial.X e : MvPolynomial (Fin (1 + 1)) K)) F := by ring
      _ = _ := by rw [hu1, one_pow, one_mul]
  have pid : ∀ e : Fin 2, IsPrincipalIdealRing Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K),
      Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X e)) := by
    intro e
    have hdeg : (MvPolynomial.X e : MvPolynomial (Fin 2) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin 2) K 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K e)
    have hA : IsPrincipalIdealRing (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X e)) := by
      refine IsPrincipalIdealRing.of_surjective (Polynomial.eval₂RingHom
          ((HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
              (Submonoid.powers (MvPolynomial.X e))).comp
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)))
          (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
            ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K e)) 1
            (MvPolynomial.X (e + 1))
            ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K (e + 1))))) ?_
      intro x
      obtain ⟨P, hP⟩ := away_poly e x
      exact ⟨P, hP.symm⟩
    have hA' : IsPrincipalIdealRing (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X e)) := hA
    have hs : Function.Surjective
        (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X e)).hom := by
      intro y
      refine ⟨(Proj.basicOpenIsoAway (MvPolynomial.homogeneousSubmodule (Fin 2) K) _ hdeg one_pos).inv.hom y, ?_⟩
      have := Iso.inv_hom_id_apply (Proj.basicOpenIsoAway (MvPolynomial.homogeneousSubmodule (Fin 2) K) _ hdeg one_pos) y
      rwa [Proj.basicOpenIsoAway_hom] at this
    exact IsPrincipalIdealRing.of_surjective _ hs
  have split : ∀ h : Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K),
      Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0) ⊓
      Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 1)),
    ∃ (h₀ : Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K),
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0)))
      (h₁ : Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K),
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 1))),
      h = ((Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K)).presheaf.map
          (homOfLE (inf_le_left : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0) ⊓
            Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 1) ≤
            Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0))).op).hom h₀ -
        ((Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K)).presheaf.map
          (homOfLE (inf_le_right : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0) ⊓
            Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 1) ≤
            Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 1))).op).hom h₁ := by
    have hdeg : ∀ e : Fin 2, (MvPolynomial.X e : MvPolynomial (Fin 2) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin 2) K 1 := fun e =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K e)
    have hres : ∀ (X : Scheme.{u}) {U V W : X.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(X, U)),
        (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
          (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
      intro X U V W h1 h2 x
      rw [← CommRingCat.comp_apply, ← Functor.map_comp]
      rfl
    have hid : ∀ (X : Scheme.{u}) {U : X.Opens} (h1 : U ≤ U) (x : Γ(X, U)),
        (X.presheaf.map (homOfLE h1).op).hom x = x := by
      intro X U h1 x
      have e : (homOfLE h1).op = 𝟙 (Opposite.op U) := rfl
      rw [e, CategoryTheory.Functor.map_id]
      rfl

    have degsplit : ∀ (n : ℕ) (a : MvPolynomial (Fin 2) K),
        a ∈ MvPolynomial.homogeneousSubmodule (Fin 2) K (n • (1 + 1)) →
        ∃ b b' : MvPolynomial (Fin 2) K, b ∈ MvPolynomial.homogeneousSubmodule (Fin 2) K (n • 1) ∧
          b' ∈ MvPolynomial.homogeneousSubmodule (Fin 2) K (n • 1) ∧
          a = MvPolynomial.X 0 ^ n * b + MvPolynomial.X 1 ^ n * b' := by
      intro n a ha
      rw [MvPolynomial.mem_homogeneousSubmodule] at ha
      have hsupp : ∀ s ∈ a.support, s 0 + s 1 = 2 * n := by
        intro s hs
        have h1 : Finsupp.degree s = n • (1 + 1) := by
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp hs) (ha.coeff_eq_zero hne)
        rw [Finsupp.degree_eq_sum, Fin.sum_univ_two, smul_eq_mul] at h1
        omega
      refine ⟨∑ s ∈ a.support.filter (fun s => n ≤ s 0),
          MvPolynomial.monomial (s - Finsupp.single 0 n) (a.coeff s),
        ∑ s ∈ a.support.filter (fun s => ¬ n ≤ s 0),
          MvPolynomial.monomial (s - Finsupp.single 1 n) (a.coeff s), ?_, ?_, ?_⟩
      · refine Submodule.sum_mem _ (fun s hs => ?_)
        rw [Finset.mem_filter] at hs
        have h2 := hsupp s hs.1
        refine (MvPolynomial.mem_homogeneousSubmodule _ _).mpr
          (MvPolynomial.isHomogeneous_monomial _ ?_)
        rw [Finsupp.degree_eq_sum, Fin.sum_univ_two, smul_eq_mul]
        simp only [Finsupp.tsub_apply, Finsupp.single_apply]
        simp
        omega
      · refine Submodule.sum_mem _ (fun s hs => ?_)
        rw [Finset.mem_filter] at hs
        have h2 := hsupp s hs.1
        refine (MvPolynomial.mem_homogeneousSubmodule _ _).mpr
          (MvPolynomial.isHomogeneous_monomial _ ?_)
        rw [Finsupp.degree_eq_sum, Fin.sum_univ_two, smul_eq_mul]
        simp only [Finsupp.tsub_apply, Finsupp.single_apply]
        simp
        omega
      · rw [Finset.mul_sum, Finset.mul_sum]
        conv_lhs => rw [a.as_sum]
        rw [← Finset.sum_filter_add_sum_filter_not a.support (fun s => n ≤ s 0)]
        congr 1
        · refine Finset.sum_congr rfl (fun s hs => ?_)
          rw [Finset.mem_filter] at hs
          rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.monomial_mul, one_mul,
            add_tsub_cancel_of_le (Finsupp.single_le_iff.mpr hs.2)]
        · refine Finset.sum_congr rfl (fun s hs => ?_)
          rw [Finset.mem_filter] at hs
          have h2 := hsupp s hs.1
          have h3 : n ≤ s 1 := by omega
          rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.monomial_mul, one_mul,
            add_tsub_cancel_of_le (Finsupp.single_le_iff.mpr h3)]

    have hsurjA : ∀ (f : MvPolynomial (Fin 2) K) {m : ℕ} (hf : f ∈ MvPolynomial.homogeneousSubmodule (Fin 2) K m),
        0 < m → Function.Surjective (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin 2) K) f).hom := by
      intro f m hf hm y
      refine ⟨(Proj.basicOpenIsoAway (MvPolynomial.homogeneousSubmodule (Fin 2) K) f hf hm).inv.hom y, ?_⟩
      have := Iso.inv_hom_id_apply (Proj.basicOpenIsoAway (MvPolynomial.homogeneousSubmodule (Fin 2) K) f hf hm) y
      rwa [Proj.basicOpenIsoAway_hom] at this
    intro h
    have hfg : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin 2) K (1 + 1) := SetLike.mul_mem_graded (hdeg 0) (hdeg 1)
    have hVU : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0 * MvPolynomial.X 1) ≤
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0) ⊓
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 1) :=
      (Proj.basicOpen_mul _ _ _).le
    have hUV : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0) ⊓
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 1) ≤
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0 * MvPolynomial.X 1) :=
      (Proj.basicOpen_mul _ _ _).ge
    obtain ⟨x, hx⟩ := hsurjA _ hfg (by norm_num)
      (((Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K)).presheaf.map (homOfLE hVU).op).hom h)
    obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ hfg x
    obtain ⟨b, b', hb, hb', hab⟩ := degsplit n a ha
    have hxs : HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin 2) K) hfg n a ha =
        HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin 2) K) (hdeg 1)
          (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) K) = MvPolynomial.X 0 * MvPolynomial.X 1)
          (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin 2) K) (hdeg 0) n b' hb') +
        HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin 2) K) (hdeg 0)
          (mul_comm (MvPolynomial.X 0 : MvPolynomial (Fin 2) K) (MvPolynomial.X 1))
          (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin 2) K) (hdeg 1) n b hb) := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_add, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.add_mk_self]
      congr 1
      rw [hab]
      ring
    have e1 := congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin 2) K) (hdeg 0) n b' hb'))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin 2) K) (hdeg 1)
        (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) K) = MvPolynomial.X 0 * MvPolynomial.X 1))
    have e2 := congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin 2) K) (hdeg 1) n b hb))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin 2) K) (hdeg 0)
        (mul_comm (MvPolynomial.X 0 : MvPolynomial (Fin 2) K) (MvPolynomial.X 1)))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e1 e2
    refine ⟨(Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0)).hom
        (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin 2) K) (hdeg 0) n b' hb'),
      -(Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 1)).hom
        (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin 2) K) (hdeg 1) n b hb), ?_⟩
    have hh : h = ((Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K)).presheaf.map (homOfLE hUV).op).hom
        (((Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K)).presheaf.map (homOfLE hVU).op).hom h) := by
      rw [hres, hid]
    rw [hh, ← hx, hxs, map_add, map_add, e1, e2, hres, hres, map_neg, sub_neg_eq_add]
  exact transport _ θ.hom _ _
    (Proj.isAffineOpen_basicOpen _ _ (hdeg 0) one_pos)
    (Proj.isAffineOpen_basicOpen _ _ (hdeg 1) one_pos)
    hcover (pid 0) (pid 1) split

theorem wcpa_dj_lge_tr_pid_basic : ∀ (X : Scheme.{u}) (W : X.Opens), IsAffineOpen W → IsPrincipalIdealRing Γ(X, W) → ∀ O : X.Opens, O ≤ W → ∃ f : Γ(X, W), X.basicOpen f = O :=
by
  intro X W hW hpid O hO
  let S : Set (PrimeSpectrum Γ(X, W)) :=
    ((hW.fromSpec ⁻¹ᵁ O : (Spec Γ(X, W)).Opens) : Set (Spec Γ(X, W)))
  have hSo : IsOpen S := (hW.fromSpec ⁻¹ᵁ O).isOpen
  obtain ⟨I, hI⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal Sᶜ).mp hSo.isClosed_compl
  refine ⟨Submodule.IsPrincipal.generator I, ?_⟩
  have hspan : Ideal.span {Submodule.IsPrincipal.generator I} = I :=
    Ideal.span_singleton_generator I
  have hS : S = (PrimeSpectrum.basicOpen (Submodule.IsPrincipal.generator I) :
      Set (PrimeSpectrum Γ(X, W))) := by
    rw [PrimeSpectrum.basicOpen_eq_zeroLocus_compl, ← PrimeSpectrum.zeroLocus_span, hspan,
      ← hI, compl_compl]
  have h5 : hW.fromSpec ⁻¹ᵁ O =
      PrimeSpectrum.basicOpen (Submodule.IsPrincipal.generator I) := by
    apply TopologicalSpace.Opens.ext
    exact hS
  rw [← hW.fromSpec_image_basicOpen, ← h5, Scheme.Hom.image_preimage_eq_opensRange_inf,
    hW.opensRange_fromSpec, inf_eq_right.mpr hO]

theorem wcpa_dj_lge_tr_chart_cech : ∀ (X : Scheme.{u}) (W : X.Opens), IsAffineOpen W → (∀ O : X.Opens, O ≤ W → ∃ f : Γ(X, W), X.basicOpen f = O) → ∀ (m : ℕ) (O : Fin m → X.Opens), W ≤ ⨆ i, O i → ∀ e : ∀ i j : Fin m, Γ(X, O i ⊓ O j ⊓ W), (∀ i j k : Fin m, (X.presheaf.map (homOfLE (show O i ⊓ O j ⊓ O k ⊓ W ≤ O i ⊓ O k ⊓ W from inf_le_inf_right W (inf_le_inf_right (O k) inf_le_left))).op).hom (e i k) = (X.presheaf.map (homOfLE (show O i ⊓ O j ⊓ O k ⊓ W ≤ O j ⊓ O k ⊓ W from inf_le_inf_right W (inf_le_inf_right (O k) inf_le_right))).op).hom (e j k) + (X.presheaf.map (homOfLE (show O i ⊓ O j ⊓ O k ⊓ W ≤ O i ⊓ O j ⊓ W from le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (e i j)) → ∃ β : ∀ i : Fin m, Γ(X, O i ⊓ W), ∀ i j : Fin m, e i j = (X.presheaf.map (homOfLE (show O i ⊓ O j ⊓ W ≤ O j ⊓ W from le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (β j) - (X.presheaf.map (homOfLE (show O i ⊓ O j ⊓ W ≤ O i ⊓ W from le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (β i) :=
by
  intro X W hW hbas m O hcov e hcoc
  have hres : ∀ {A B C : X.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(X, A)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
        (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro A B C h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have hid : ∀ {A : X.Opens} (h : A ≤ A) (x : Γ(X, A)),
      (X.presheaf.map (homOfLE h).op).hom x = x := by
    intro A h x
    have e0 : X.presheaf.map (homOfLE h).op = 𝟙 _ := by
      rw [show (homOfLE h).op = 𝟙 (Opposite.op A) from rfl, X.presheaf.map_id]
    rw [e0]
    rfl
  choose f hf using fun i => hbas (O i ⊓ W) inf_le_right
  have hQP : ∀ i j, X.basicOpen (f i) ⊓ X.basicOpen (f j) ≤ O i ⊓ O j ⊓ W := by
    intro i j
    rw [hf i, hf j]
    intro x hx
    simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢
    tauto
  have hcovD : ∀ x : X, x ∈ W → ∃ i, x ∈ X.basicOpen (f i) := by
    intro x hx
    obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp (hcov hx)
    refine ⟨i, ?_⟩
    rw [hf i]
    exact TopologicalSpace.Opens.mem_inf.mpr ⟨hi, hx⟩
  have hQ : ∀ (V : X.Opens) (hVU : V ≤ W), IsAffineOpen V → ∀ k : Γ(X, W),
      (∀ e : Γ(wcStructMod X, V ⊓ X.basicOpen k), ∃ (n : ℕ) (w : Γ(wcStructMod X, V)),
        (X.presheaf.map (homOfLE (le_trans inf_le_left hVU : V ⊓ X.basicOpen k ≤ W)).op k) ^ n • e
          = (wcStructMod X).presheaf.map (homOfLE (inf_le_left : V ⊓ X.basicOpen k ≤ V)).op w) ∧
      (∀ z : Γ(wcStructMod X, V),
        (wcStructMod X).presheaf.map (homOfLE (inf_le_left : V ⊓ X.basicOpen k ≤ V)).op z = 0 →
        ∃ n : ℕ, (X.presheaf.map (homOfLE hVU).op k) ^ n • z = 0) := by
    intro V hVU hV k
    obtain ⟨hq1, hq2⟩ := (wc_struct_mod_coh X).1 V hV (X.presheaf.map (homOfLE hVU).op k)
    have hres' : X.presheaf.map (homOfLE (X.basicOpen_le (X.presheaf.map (homOfLE hVU).op k))).op
        (X.presheaf.map (homOfLE hVU).op k) =
        X.presheaf.map (homOfLE (le_trans (X.basicOpen_le _) hVU)).op k := by
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
      rfl
    have aux : ∀ (W' : X.Opens) (hWV : W' ≤ V) (hWU : W' ≤ W),
        W' = X.basicOpen (X.presheaf.map (homOfLE hVU).op k) →
        (∀ e : Γ(wcStructMod X, W'), ∃ (n : ℕ) (w : Γ(wcStructMod X, V)),
          (X.presheaf.map (homOfLE hWU).op k) ^ n • e =
            (wcStructMod X).presheaf.map (homOfLE hWV).op w) ∧
        (∀ z : Γ(wcStructMod X, V), (wcStructMod X).presheaf.map (homOfLE hWV).op z = 0 →
          ∃ n : ℕ, (X.presheaf.map (homOfLE hVU).op k) ^ n • z = 0) := by
      rintro W' hWV hWU rfl
      refine ⟨fun e => ?_, fun z hz => hq2 z hz⟩
      obtain ⟨n, w, hw⟩ := hq1 e
      refine ⟨n, w, ?_⟩
      rw [← hres']
      exact hw
    exact aux (V ⊓ X.basicOpen k) inf_le_left (le_trans inf_le_left hVU)
      (Scheme.basicOpen_res X k (homOfLE hVU).op).symm
  have H : ∀ e' : (∀ p : Fin m × Fin m, Γ(X, X.basicOpen (f p.1) ⊓ X.basicOpen (f p.2))),
      (∀ i j k : Fin m, (X.presheaf.map (homOfLE (inf_le_left : X.basicOpen (f i) ⊓
          X.basicOpen (f j) ⊓ X.basicOpen (f k) ≤ X.basicOpen (f i) ⊓ X.basicOpen (f j))).op).hom
          (e' (i, j)) +
        (X.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right) inf_le_right :
          X.basicOpen (f i) ⊓ X.basicOpen (f j) ⊓ X.basicOpen (f k) ≤
            X.basicOpen (f j) ⊓ X.basicOpen (f k))).op).hom (e' (j, k)) =
        (X.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right :
          X.basicOpen (f i) ⊓ X.basicOpen (f j) ⊓ X.basicOpen (f k) ≤
            X.basicOpen (f i) ⊓ X.basicOpen (f k))).op).hom (e' (i, k))) →
      ∃ w : (∀ i : Fin m, Γ(X, X.basicOpen (f i))), ∀ i j : Fin m,
        e' (i, j) = (X.presheaf.map (homOfLE (inf_le_left : X.basicOpen (f i) ⊓
            X.basicOpen (f j) ≤ X.basicOpen (f i))).op).hom (w i) -
          (X.presheaf.map (homOfLE (inf_le_right : X.basicOpen (f i) ⊓
            X.basicOpen (f j) ≤ X.basicOpen (f j))).op).hom (w j) :=
    fun e' he' => wc_qcoh_standard_cover_cech_h1 X (wcStructMod X) W hW hQ m f hcovD e' he'
  obtain ⟨w, hw⟩ := H (fun p => -(X.presheaf.map (homOfLE (hQP p.1 p.2)).op).hom (e p.1 p.2)) (by
    intro i j k
    have hT : X.basicOpen (f i) ⊓ X.basicOpen (f j) ⊓ X.basicOpen (f k) ≤
        O i ⊓ O j ⊓ O k ⊓ W := by
      rw [hf i, hf j, hf k]
      intro x hx
      simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢
      tauto
    have h := congrArg (X.presheaf.map (homOfLE hT).op).hom (hcoc i j k)
    rw [map_add] at h
    simp only [hres] at h
    simp only [map_neg, hres]
    linear_combination h)
  refine ⟨fun i => (X.presheaf.map (homOfLE (hf i).ge).op).hom (w i), fun i j => ?_⟩
  have hPQ : O i ⊓ O j ⊓ W ≤ X.basicOpen (f i) ⊓ X.basicOpen (f j) := by
    rw [hf i, hf j]
    intro x hx
    simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢
    tauto
  have h := congrArg (X.presheaf.map (homOfLE hPQ).op).hom (hw i j)
  simp only [map_neg, map_sub, hres, hid] at h
  simp only [hres]
  linear_combination -h

theorem wcpa_dj_lge_tr_glue_two : ∀ (X : Scheme.{u}) (W₀ W₁ : X.Opens), W₀ ⊔ W₁ = ⊤ → (∀ h : Γ(X, W₀ ⊓ W₁), ∃ (h₀ : Γ(X, W₀)) (h₁ : Γ(X, W₁)), h = (X.presheaf.map (homOfLE (inf_le_left : W₀ ⊓ W₁ ≤ W₀)).op).hom h₀ - (X.presheaf.map (homOfLE (inf_le_right : W₀ ⊓ W₁ ≤ W₁)).op).hom h₁) → ∀ (m : ℕ) (O : Fin m → X.Opens), (⨆ i, O i) = ⊤ → ∀ (e : ∀ i j : Fin m, Γ(X, O i ⊓ O j)) (β₀ : ∀ i : Fin m, Γ(X, O i ⊓ W₀)) (β₁ : ∀ i : Fin m, Γ(X, O i ⊓ W₁)), (∀ i j : Fin m, (X.presheaf.map (homOfLE (show O i ⊓ O j ⊓ W₀ ≤ O i ⊓ O j from inf_le_left)).op).hom (e i j) = (X.presheaf.map (homOfLE (show O i ⊓ O j ⊓ W₀ ≤ O j ⊓ W₀ from le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (β₀ j) - (X.presheaf.map (homOfLE (show O i ⊓ O j ⊓ W₀ ≤ O i ⊓ W₀ from le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (β₀ i)) → (∀ i j : Fin m, (X.presheaf.map (homOfLE (show O i ⊓ O j ⊓ W₁ ≤ O i ⊓ O j from inf_le_left)).op).hom (e i j) = (X.presheaf.map (homOfLE (show O i ⊓ O j ⊓ W₁ ≤ O j ⊓ W₁ from le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (β₁ j) - (X.presheaf.map (homOfLE (show O i ⊓ O j ⊓ W₁ ≤ O i ⊓ W₁ from le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (β₁ i)) → ∃ β : ∀ i : Fin m, Γ(X, O i), ∀ i j : Fin m, e i j = (X.presheaf.map (homOfLE (inf_le_right : O i ⊓ O j ≤ O j)).op).hom (β j) - (X.presheaf.map (homOfLE (inf_le_left : O i ⊓ O j ≤ O i)).op).hom (β i) :=
by
  intro X W₀ W₁ hsup hsplit m O hcov e β₀ β₁ hβ₀ hβ₁

  have hres : ∀ {U V W : X.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(X, U)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
        (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro U V W h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  have glue : ∀ {ι : Type} (U : ι → X.Opens) (V : X.Opens) (hUV : ∀ i, U i ≤ V), V ≤ iSup U →
      ∀ sf : ∀ i, Γ(X, U i),
      (∀ i j, (X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op).hom (sf i) =
        (X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op).hom (sf j)) →
      ∃ s : Γ(X, V), ∀ i, (X.presheaf.map (homOfLE (hUV i)).op).hom s = sf i := by
    intro ι U V hUV hcov' sf hcomp
    obtain ⟨s, hs, -⟩ := X.sheaf.existsUnique_gluing' U V (fun i => homOfLE (hUV i)) hcov' sf hcomp
    exact ⟨s, hs⟩

  have sep : ∀ {U₁ U₂ V : X.Opens} (h1 : U₁ ≤ V) (h2 : U₂ ≤ V), V ≤ U₁ ⊔ U₂ → ∀ s t : Γ(X, V),
      (X.presheaf.map (homOfLE h1).op).hom s = (X.presheaf.map (homOfLE h1).op).hom t →
      (X.presheaf.map (homOfLE h2).op).hom s = (X.presheaf.map (homOfLE h2).op).hom t →
      s = t := by
    intro U₁ U₂ V h1 h2 hc s t e1 e2
    exact X.sheaf.eq_of_locally_eq₂ (homOfLE h1) (homOfLE h2) hc s t e1 e2

  have glue2 : ∀ (V A B : X.Opens), V ≤ A ⊔ B → ∀ (s : Γ(X, V ⊓ A)) (t : Γ(X, V ⊓ B)),
      (X.presheaf.map (homOfLE (show V ⊓ A ⊓ B ≤ V ⊓ A from inf_le_left)).op).hom s =
      (X.presheaf.map (homOfLE (show V ⊓ A ⊓ B ≤ V ⊓ B from
        le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom t →
      ∃ u : Γ(X, V), (X.presheaf.map (homOfLE (inf_le_left : V ⊓ A ≤ V)).op).hom u = s ∧
        (X.presheaf.map (homOfLE (inf_le_left : V ⊓ B ≤ V)).op).hom u = t := by
    intro V A B hV s t hst
    let U : Bool → X.Opens := fun b => cond b (V ⊓ A) (V ⊓ B)
    let sf : ∀ b, Γ(X, U b) := fun b => match b with
      | true => s
      | false => t
    obtain ⟨u, hu⟩ := glue U V (fun b => by cases b <;> exact inf_le_left) (by
        intro x hx
        rw [TopologicalSpace.Opens.mem_iSup]
        rcases (TopologicalSpace.Opens.mem_sup.mp (hV hx)) with h | h
        · exact ⟨true, TopologicalSpace.Opens.mem_inf.mpr ⟨hx, h⟩⟩
        · exact ⟨false, TopologicalSpace.Opens.mem_inf.mpr ⟨hx, h⟩⟩) sf (by
        intro i j
        cases i <;> cases j
        · rfl
        · have h' := congrArg (X.presheaf.map (homOfLE (show (V ⊓ B) ⊓ (V ⊓ A) ≤ V ⊓ A ⊓ B from
            le_inf (le_inf (inf_le_left.trans inf_le_left) (inf_le_right.trans inf_le_right))
              (inf_le_left.trans inf_le_right))).op).hom hst
          simp only [hres] at h'
          exact h'.symm
        · have h' := congrArg (X.presheaf.map (homOfLE (show (V ⊓ A) ⊓ (V ⊓ B) ≤ V ⊓ A ⊓ B from
            le_inf (inf_le_left) (inf_le_right.trans inf_le_right))).op).hom hst
          simp only [hres] at h'
          exact h'
        · rfl)
    exact ⟨u, hu true, hu false⟩

  obtain ⟨h, hh⟩ := glue (fun i => O i ⊓ (W₀ ⊓ W₁)) (W₀ ⊓ W₁) (fun i => inf_le_right) (by
      intro x hx
      have hx' : x ∈ ⨆ i, O i := by rw [hcov]; trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hx' ⊢
      obtain ⟨i, hi⟩ := hx'
      exact ⟨i, TopologicalSpace.Opens.mem_inf.mpr ⟨hi, hx⟩⟩)
    (fun i => (X.presheaf.map (homOfLE (inf_le_inf_left (O i) inf_le_left :
        O i ⊓ (W₀ ⊓ W₁) ≤ O i ⊓ W₀)).op).hom (β₀ i) -
      (X.presheaf.map (homOfLE (inf_le_inf_left (O i) inf_le_right :
        O i ⊓ (W₀ ⊓ W₁) ≤ O i ⊓ W₁)).op).hom (β₁ i)) (by
      intro i j
      have A := congrArg (X.presheaf.map (homOfLE (show (O i ⊓ (W₀ ⊓ W₁)) ⊓ (O j ⊓ (W₀ ⊓ W₁)) ≤
          O i ⊓ O j ⊓ W₀ from le_inf (le_inf (inf_le_left.trans inf_le_left)
            (inf_le_right.trans inf_le_left))
            (inf_le_left.trans (inf_le_right.trans inf_le_left)))).op).hom (hβ₀ i j)
      have B := congrArg (X.presheaf.map (homOfLE (show (O i ⊓ (W₀ ⊓ W₁)) ⊓ (O j ⊓ (W₀ ⊓ W₁)) ≤
          O i ⊓ O j ⊓ W₁ from le_inf (le_inf (inf_le_left.trans inf_le_left)
            (inf_le_right.trans inf_le_left))
            (inf_le_left.trans (inf_le_right.trans inf_le_right)))).op).hom (hβ₁ i j)
      simp only [map_sub, hres] at A B ⊢
      linear_combination A - B)

  obtain ⟨h₀, h₁, hH⟩ := hsplit h

  have hβex : ∀ i, ∃ b : Γ(X, O i),
      (X.presheaf.map (homOfLE (inf_le_left : O i ⊓ W₀ ≤ O i)).op).hom b =
        β₀ i - (X.presheaf.map (homOfLE (inf_le_right : O i ⊓ W₀ ≤ W₀)).op).hom h₀ ∧
      (X.presheaf.map (homOfLE (inf_le_left : O i ⊓ W₁ ≤ O i)).op).hom b =
        β₁ i - (X.presheaf.map (homOfLE (inf_le_right : O i ⊓ W₁ ≤ W₁)).op).hom h₁ := by
    intro i
    apply glue2 (O i) W₀ W₁ (by rw [hsup]; exact le_top)
    have HQ := congrArg (X.presheaf.map (homOfLE (show O i ⊓ W₀ ⊓ W₁ ≤ W₀ ⊓ W₁ from
      le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom hH
    have GQ := congrArg (X.presheaf.map (homOfLE (show O i ⊓ W₀ ⊓ W₁ ≤ O i ⊓ (W₀ ⊓ W₁) from
      le_inf (inf_le_left.trans inf_le_left)
        (le_inf (inf_le_left.trans inf_le_right) inf_le_right))).op).hom (hh i)
    simp only [map_sub, hres] at HQ GQ ⊢
    linear_combination HQ - GQ
  choose β hP0 hP1 using hβex

  refine ⟨β, fun i j => ?_⟩
  refine sep (show O i ⊓ O j ⊓ W₀ ≤ O i ⊓ O j from inf_le_left)
    (show O i ⊓ O j ⊓ W₁ ≤ O i ⊓ O j from inf_le_left) ?_ _ _ ?_ ?_
  · intro x hx
    have hx' : x ∈ W₀ ⊔ W₁ := by rw [hsup]; trivial
    rcases TopologicalSpace.Opens.mem_sup.mp hx' with h' | h'
    · exact TopologicalSpace.Opens.mem_sup.mpr (Or.inl (TopologicalSpace.Opens.mem_inf.mpr ⟨hx, h'⟩))
    · exact TopologicalSpace.Opens.mem_sup.mpr (Or.inr (TopologicalSpace.Opens.mem_inf.mpr ⟨hx, h'⟩))
  · have A := hβ₀ i j
    have e1 := congrArg (X.presheaf.map (homOfLE (show O i ⊓ O j ⊓ W₀ ≤ O j ⊓ W₀ from
      le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (hP0 j)
    have e2 := congrArg (X.presheaf.map (homOfLE (show O i ⊓ O j ⊓ W₀ ≤ O i ⊓ W₀ from
      le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (hP0 i)
    simp only [map_sub, hres] at e1 e2 ⊢
    linear_combination A - e1 + e2
  · have A := hβ₁ i j
    have e1 := congrArg (X.presheaf.map (homOfLE (show O i ⊓ O j ⊓ W₁ ≤ O j ⊓ W₁ from
      le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (hP1 j)
    have e2 := congrArg (X.presheaf.map (homOfLE (show O i ⊓ O j ⊓ W₁ ≤ O i ⊓ W₁ from
      le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (hP1 i)
    simp only [map_sub, hres] at e1 e2 ⊢
    linear_combination A - e1 + e2

theorem wcpa_dj_lge_tr_closed_split : ∀ (Y : Scheme.{u}) (L : wcpaDjCoc Y), wcpaDjCocOK L → ∀ (t : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ ⊤)), wcpaDjCompat L ⊤ 1 t → ∀ (Er : Scheme.{u}) (ιE : Er ⟶ Y), IsClosedImmersion ιE → (∀ (a : Fin L.m) (y : Er), ιE y ∈ L.V a → ιE y ∈ Y.basicOpen (t a)) → (∀ (m : ℕ) (O : Fin m → Er.Opens), (⨆ i, O i) = ⊤ → ∀ e : ∀ i j : Fin m, Γ(Er, O i ⊓ O j), (∀ i j k : Fin m, (Er.presheaf.map (homOfLE (show O i ⊓ O j ⊓ O k ≤ O i ⊓ O k from inf_le_inf_right (O k) inf_le_left)).op).hom (e i k) = (Er.presheaf.map (homOfLE (show O i ⊓ O j ⊓ O k ≤ O j ⊓ O k from inf_le_inf_right (O k) inf_le_right)).op).hom (e j k) + (Er.presheaf.map (homOfLE (show O i ⊓ O j ⊓ O k ≤ O i ⊓ O j from inf_le_left)).op).hom (e i j)) → ∃ β : ∀ i : Fin m, Γ(Er, O i), ∀ i j : Fin m, e i j = (Er.presheaf.map (homOfLE (inf_le_right : O i ⊓ O j ≤ O j)).op).hom (β j) - (Er.presheaf.map (homOfLE (inf_le_left : O i ⊓ O j ≤ O i)).op).hom (β i)) → ∀ (n : ℕ) (c : ∀ a b : Fin L.m, Γ(Y, L.V a ⊓ L.V b ⊓ ⊤)), (∀ a b d : Fin L.m, (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V d ⊓ ⊤ from inf_le_inf_right ⊤ (inf_le_inf_right (L.V d) inf_le_left))).op).hom (c a d) = (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V b ⊓ L.V d ⊓ ⊤ from inf_le_inf_right ⊤ (inf_le_inf_right (L.V d) inf_le_right))).op).hom (c b d) + ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V b ⊓ L.V d from (inf_le_left : L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V b ⊓ L.V d).trans (inf_le_inf_right (L.V d) inf_le_right))).op).hom (L.g b d : Γ(Y, L.V b ⊓ L.V d))) ^ n * (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V b ⊓ ⊤ from le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (c a b)) → ∃ B : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ ⊤), ∀ a b : Fin L.m, (ιE.app (L.V a ⊓ L.V b ⊓ ⊤)).hom (c a b - ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V b ⊓ ⊤ from le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (B b) - ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ L.V b from inf_le_left)).op).hom (L.g a b : Γ(Y, L.V a ⊓ L.V b))) ^ n * (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ ⊤ from le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (B a))) = 0 :=
by
  intro Y L hOK t hcomp Er ιE hιE hbo hH1 n c hc
  classical

  have hA : ∀ {U : Y.Opens} {V V' : Er.Opens} (e : V ≤ ιE ⁻¹ᵁ U) (h : V' ≤ V) (x : Γ(Y, U)),
      (Er.presheaf.map (homOfLE h).op).hom ((ιE.appLE U V e).hom x) =
        (ιE.appLE U V' (h.trans e)).hom x := by
    intro U V V' e h x
    rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_map]
  have hpm : ∀ {U U' : Y.Opens}, U' ≤ U → ιE ⁻¹ᵁ U' ≤ ιE ⁻¹ᵁ U := by
    intro U U' h x hx
    exact h hx
  have hB : ∀ {U U' : Y.Opens} {V : Er.Opens} (e : V ≤ ιE ⁻¹ᵁ U') (h : U' ≤ U) (x : Γ(Y, U)),
      (ιE.appLE U' V e).hom ((Y.presheaf.map (homOfLE h).op).hom x) =
        (ιE.appLE U V (e.trans (hpm h))).hom x := by
    intro U U' V e h x
    rw [← CommRingCat.comp_apply, Scheme.Hom.map_appLE]
  have hres : ∀ {U V W : Er.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(Er, U)),
      (Er.presheaf.map (homOfLE h2).op).hom ((Er.presheaf.map (homOfLE h1).op).hom x) =
        (Er.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro U V W h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  have hunit : ∀ (a : Fin L.m) (V : Er.Opens) (e : V ≤ ιE ⁻¹ᵁ (L.V a ⊓ ⊤)),
      IsUnit ((ιE.appLE (L.V a ⊓ ⊤) V e).hom (t a)) := by
    intro a V e
    apply RingedSpace.isUnit_of_isUnit_germ Er.toRingedSpace V
    intro x hx
    have hmem : x ∈ Er.basicOpen ((ιE.appLE (L.V a ⊓ ⊤) V e).hom (t a)) := by
      rw [Scheme.basicOpen_appLE]
      have hxa : ιE x ∈ L.V a ⊓ ⊤ := e hx
      exact ⟨hx, hbo a x hxa.1⟩
    exact (Er.mem_basicOpen _ x hx).mp hmem

  have Fcmp : ∀ (a b : Fin L.m) (V : Er.Opens) (e0 : V ≤ ιE ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ ⊤))
      (e1 : V ≤ ιE ⁻¹ᵁ (L.V b ⊓ ⊤)) (e2 : V ≤ ιE ⁻¹ᵁ (L.V a ⊓ L.V b))
      (e3 : V ≤ ιE ⁻¹ᵁ (L.V a ⊓ ⊤)),
      (ιE.appLE (L.V b ⊓ ⊤) V e1).hom (t b) =
        (ιE.appLE (L.V a ⊓ L.V b) V e2).hom (L.g a b : Γ(Y, L.V a ⊓ L.V b)) *
        (ιE.appLE (L.V a ⊓ ⊤) V e3).hom (t a) := by
    intro a b V e0 e1 e2 e3
    have h := congrArg (ιE.appLE (L.V a ⊓ L.V b ⊓ ⊤) V e0).hom (hcomp a b)
    rw [pow_one, map_mul, hB, hB, hB] at h
    exact h
  have Fcoc : ∀ (a b d : Fin L.m) (V : Er.Opens)
      (e0 : V ≤ ιE ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤))
      (e1 : V ≤ ιE ⁻¹ᵁ (L.V a ⊓ L.V d ⊓ ⊤)) (e2 : V ≤ ιE ⁻¹ᵁ (L.V b ⊓ L.V d ⊓ ⊤))
      (e3 : V ≤ ιE ⁻¹ᵁ (L.V b ⊓ L.V d)) (e4 : V ≤ ιE ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ ⊤)),
      (ιE.appLE (L.V a ⊓ L.V d ⊓ ⊤) V e1).hom (c a d) =
        (ιE.appLE (L.V b ⊓ L.V d ⊓ ⊤) V e2).hom (c b d) +
        ((ιE.appLE (L.V b ⊓ L.V d) V e3).hom (L.g b d : Γ(Y, L.V b ⊓ L.V d))) ^ n *
        (ιE.appLE (L.V a ⊓ L.V b ⊓ ⊤) V e4).hom (c a b) := by
    intro a b d V e0 e1 e2 e3 e4
    have h := congrArg (ιE.appLE (L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤) V e0).hom (hc a b d)
    rw [map_add, map_mul, map_pow, hB, hB, hB, hB] at h
    exact h

  have alg1 : ∀ {R : Type u} [CommRing R] (Cik Cjk Cij G Uj Uk τj τk : R), τj * Uj = 1 →
      τk * Uk = 1 → τk = G * τj → Cik = Cjk + G ^ n * Cij →
      Cik * Uk ^ n = Cjk * Uk ^ n + Cij * Uj ^ n := by
    intro R _ Cik Cjk Cij G Uj Uk τj τk h1 h2 h3 h4
    have hU : Uj = G * Uk := by
      linear_combination (-Uj) * h2 + (Uj * Uk) * h3 + (G * Uk) * h1
    rw [hU, mul_pow, h4]
    ring
  have alg2 : ∀ {R : Type u} [CommRing R] (c' G τa τb Ub βa βb : R), τb * Ub = 1 →
      τb = G * τa → c' * Ub ^ n = βb - βa → c' = τb ^ n * βb - G ^ n * (τa ^ n * βa) := by
    intro R _ c' G τa τb Ub βa βb h1 h2 h3
    have e1 : τb ^ n * Ub ^ n = 1 := by rw [← mul_pow, h1, one_pow]
    have e3 : τb ^ n = G ^ n * τa ^ n := by rw [h2, mul_pow]
    linear_combination (-c') * e1 + τb ^ n * h3 - βa * e3

  obtain ⟨O, hO⟩ : ∃ O : Fin L.m → Er.Opens, ∀ a, O a = ιE ⁻¹ᵁ (L.V a ⊓ ⊤) :=
    ⟨_, fun _ => rfl⟩
  have hOle : ∀ a, O a ≤ ιE ⁻¹ᵁ (L.V a ⊓ ⊤) := fun a => (hO a).le
  have hleO : ∀ a, ιE ⁻¹ᵁ (L.V a ⊓ ⊤) ≤ O a := fun a => (hO a).ge
  have hm : ∀ (a : Fin L.m) (x : Er), x ∈ O a → ιE x ∈ L.V a := fun a x h => (hOle a h).1
  have hcov : (⨆ a, O a) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hx : ιE x ∈ (⊤ : Y.Opens) := trivial
    rw [← hOK.2.1] at hx
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    refine TopologicalSpace.Opens.mem_iSup.mpr ⟨a, hleO a ?_⟩
    exact ⟨ha, trivial⟩

  choose u hu using fun a => (hunit a (O a) (hOle a)).exists_right_inv
  have Fu : ∀ (a : Fin L.m) (V : Er.Opens) (h : V ≤ O a) (e : V ≤ ιE ⁻¹ᵁ (L.V a ⊓ ⊤)),
      (ιE.appLE (L.V a ⊓ ⊤) V e).hom (t a) * (Er.presheaf.map (homOfLE h).op).hom (u a) = 1 := by
    intro a V h e
    have h1 := congrArg (Er.presheaf.map (homOfLE h).op).hom (hu a)
    rw [map_mul, map_one, hA] at h1
    exact h1

  have lePab : ∀ a b : Fin L.m, O a ⊓ O b ≤ ιE ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ ⊤) :=
    fun a b x hx => ⟨⟨hm a x hx.1, hm b x hx.2⟩, trivial⟩
  obtain ⟨ee, hee⟩ : ∃ ee : ∀ a b : Fin L.m, Γ(Er, O a ⊓ O b), ∀ a b, ee a b =
      (ιE.appLE (L.V a ⊓ L.V b ⊓ ⊤) (O a ⊓ O b) (lePab a b)).hom (c a b) *
        ((Er.presheaf.map (homOfLE (inf_le_right : O a ⊓ O b ≤ O b)).op).hom (u b)) ^ n :=
    ⟨_, fun _ _ => rfl⟩
  have hcoc : ∀ i j k : Fin L.m, (Er.presheaf.map (homOfLE (show O i ⊓ O j ⊓ O k ≤ O i ⊓ O k from inf_le_inf_right (O k) inf_le_left)).op).hom (ee i k) = (Er.presheaf.map (homOfLE (show O i ⊓ O j ⊓ O k ≤ O j ⊓ O k from inf_le_inf_right (O k) inf_le_right)).op).hom (ee j k) + (Er.presheaf.map (homOfLE (show O i ⊓ O j ⊓ O k ≤ O i ⊓ O j from inf_le_left)).op).hom (ee i j) := by
    intro i j k
    rw [hee, hee, hee]
    simp only [map_mul, map_pow, hA, hres]
    exact alg1 _ _ _ _ _ _ _ _
      (Fu j (O i ⊓ O j ⊓ O k) (le_trans inf_le_left inf_le_right)
        (fun x hx => ⟨hm j x hx.1.2, trivial⟩))
      (Fu k (O i ⊓ O j ⊓ O k) inf_le_right (fun x hx => ⟨hm k x hx.2, trivial⟩))
      (Fcmp j k (O i ⊓ O j ⊓ O k)
        (fun x hx => ⟨⟨hm j x hx.1.2, hm k x hx.2⟩, trivial⟩)
        (fun x hx => ⟨hm k x hx.2, trivial⟩)
        (fun x hx => ⟨hm j x hx.1.2, hm k x hx.2⟩)
        (fun x hx => ⟨hm j x hx.1.2, trivial⟩))
      (Fcoc i j k (O i ⊓ O j ⊓ O k)
        (fun x hx => ⟨⟨⟨hm i x hx.1.1, hm j x hx.1.2⟩, hm k x hx.2⟩, trivial⟩)
        (fun x hx => ⟨⟨hm i x hx.1.1, hm k x hx.2⟩, trivial⟩)
        (fun x hx => ⟨⟨hm j x hx.1.2, hm k x hx.2⟩, trivial⟩)
        (fun x hx => ⟨hm j x hx.1.2, hm k x hx.2⟩)
        (fun x hx => ⟨⟨hm i x hx.1.1, hm j x hx.1.2⟩, trivial⟩))

  obtain ⟨β, hβ⟩ := hH1 L.m O hcov ee hcoc

  obtain ⟨BE, hBE⟩ : ∃ BE : ∀ a : Fin L.m, Γ(Er, O a), ∀ a,
      BE a = ((ιE.appLE (L.V a ⊓ ⊤) (O a) (hOle a)).hom (t a)) ^ n * β a :=
    ⟨_, fun _ => rfl⟩
  have key : ∀ (a b : Fin L.m) (V : Er.Opens) (h : V ≤ O a ⊓ O b)
      (e0 : V ≤ ιE ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ ⊤)) (e2 : V ≤ ιE ⁻¹ᵁ (L.V a ⊓ L.V b)),
      (ιE.appLE (L.V a ⊓ L.V b ⊓ ⊤) V e0).hom (c a b) =
        (Er.presheaf.map (homOfLE (h.trans inf_le_right)).op).hom (BE b) -
        ((ιE.appLE (L.V a ⊓ L.V b) V e2).hom (L.g a b : Γ(Y, L.V a ⊓ L.V b))) ^ n *
        (Er.presheaf.map (homOfLE (h.trans inf_le_left)).op).hom (BE a) := by
    intro a b V h e0 e2
    have h1 := congrArg (Er.presheaf.map (homOfLE h).op).hom (hβ a b)
    rw [hee] at h1
    simp only [map_mul, map_pow, map_sub, hA, hres] at h1
    rw [hBE, hBE]
    simp only [map_mul, map_pow, hA]
    exact alg2 _ _ _ _ _ _ _
      (Fu b V (h.trans inf_le_right) (fun x hx => ⟨hm b x (h hx).2, trivial⟩))
      (Fcmp a b V e0 (fun x hx => ⟨hm b x (h hx).2, trivial⟩) e2
        (fun x hx => ⟨hm a x (h hx).1, trivial⟩))
      h1

  have hlift : ∀ a, ∃ B : Γ(Y, L.V a ⊓ ⊤), (ιE.app (L.V a ⊓ ⊤)).hom B =
      (Er.presheaf.map (homOfLE (hleO a)).op).hom (BE a) := by
    intro a
    have haff : IsAffineOpen (L.V a ⊓ ⊤) := by rw [inf_top_eq]; exact hOK.1 a
    exact Scheme.Hom.app_surjective ιE (L.V a ⊓ ⊤) haff _
  choose B hB' using hlift
  have hBf : ∀ (a : Fin L.m) (V : Er.Opens) (h : V ≤ O a) (e : V ≤ ιE ⁻¹ᵁ (L.V a ⊓ ⊤)),
      (ιE.appLE (L.V a ⊓ ⊤) V e).hom (B a) = (Er.presheaf.map (homOfLE h).op).hom (BE a) := by
    intro a V h e
    have h1 := congrArg (Er.presheaf.map (homOfLE e).op).hom (hB' a)
    rw [Scheme.Hom.app_eq_appLE, hA, hres] at h1
    exact h1

  refine ⟨B, fun a b => ?_⟩
  rw [Scheme.Hom.app_eq_appLE]
  simp only [map_sub, map_mul, map_pow, hB]
  have hWa : ιE ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ ⊤) ≤ O a := fun x hx => hleO a ⟨hx.1.1, trivial⟩
  have hWb : ιE ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ ⊤) ≤ O b := fun x hx => hleO b ⟨hx.1.2, trivial⟩
  have hW2 : ιE ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ ⊤) ≤ ιE ⁻¹ᵁ (L.V a ⊓ L.V b) := fun x hx => hx.1
  have k := key a b (ιE ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ ⊤)) (le_inf hWa hWb) le_rfl hW2
  have hb := hBf b (ιE ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ ⊤)) hWb (fun x hx => ⟨hx.1.2, trivial⟩)
  have ha := hBf a (ιE ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ ⊤)) hWa (fun x hx => ⟨hx.1.1, trivial⟩)
  linear_combination k - hb +
    ((ιE.appLE (L.V a ⊓ L.V b) (ιE ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ ⊤)) hW2).hom
      (L.g a b : Γ(Y, L.V a ⊓ L.V b))) ^ n * ha

theorem wcpa_dj_lge_tr_ideal_correct : ∀ (Y : Scheme.{u}) (L : wcpaDjCoc Y), wcpaDjCocOK L → ∀ (T : Set Y) (F : Y.Modules) (ι : F ⟶ wcStructMod Y), (∀ V : Y.Opens, Function.Injective (Scheme.Modules.Hom.app ι V)) → (∀ (V : Y.Opens) (f : Γ(Y, V)), (∃ k : Γ(F, V), Scheme.Modules.Hom.app ι V k = f) ↔ ∀ (z : Y) (hz : z ∈ V), z ∈ T → (Y.presheaf.germ V z hz).hom f ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z)) → ∀ n : ℕ, wcpaDjTwH1 L ⊤ F n → (∀ c : ∀ a b : Fin L.m, Γ(Y, L.V a ⊓ L.V b ⊓ ⊤), (∀ a b d : Fin L.m, (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V d ⊓ ⊤ from inf_le_inf_right ⊤ (inf_le_inf_right (L.V d) inf_le_left))).op).hom (c a d) = (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V b ⊓ L.V d ⊓ ⊤ from inf_le_inf_right ⊤ (inf_le_inf_right (L.V d) inf_le_right))).op).hom (c b d) + ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V b ⊓ L.V d from (inf_le_left : L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V b ⊓ L.V d).trans (inf_le_inf_right (L.V d) inf_le_right))).op).hom (L.g b d : Γ(Y, L.V b ⊓ L.V d))) ^ n * (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V b ⊓ ⊤ from le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (c a b)) → ∃ B : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ ⊤), ∀ (a b : Fin L.m) (z : Y) (hz : z ∈ L.V a ⊓ L.V b ⊓ ⊤), z ∈ T → (Y.presheaf.germ (L.V a ⊓ L.V b ⊓ ⊤) z hz).hom (c a b - ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V b ⊓ ⊤ from le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (B b) - ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ L.V b from inf_le_left)).op).hom (L.g a b : Γ(Y, L.V a ⊓ L.V b))) ^ n * (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ ⊤ from le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (B a))) ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z)) → wcpaDjTwH1 L ⊤ (wcStructMod Y) n :=
by
  intro Y L hL T F ι hinj hchar n hTw hsplit c hc

  have hres : ∀ (U V W : Y.Opens) (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
        (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro U V W h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  obtain ⟨ιf, hιf⟩ : ∃ f : ∀ V : Y.Opens, Γ(F, V) → Γ(Y, V),
      ∀ V k, f V k = Scheme.Modules.Hom.app ι V k :=
    ⟨fun V k => Scheme.Modules.Hom.app ι V k, fun _ _ => rfl⟩
  have hinj' : ∀ V, Function.Injective (ιf V) := by
    intro V x y hxy
    rw [hιf, hιf] at hxy
    exact hinj V hxy
  have hchar' : ∀ (V : Y.Opens) (f : Γ(Y, V)), (∃ k : Γ(F, V), ιf V k = f) ↔
      ∀ (z : Y) (hz : z ∈ V), z ∈ T →
        (Y.presheaf.germ V z hz).hom f ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z) := by
    intro V f
    simp only [hιf]
    exact hchar V f
  have hadd : ∀ (V : Y.Opens) (x y : Γ(F, V)), ιf V (x + y) = ιf V x + ιf V y := by
    intro V x y
    rw [hιf, hιf, hιf]
    exact map_add _ x y
  have hsub : ∀ (V : Y.Opens) (x y : Γ(F, V)), ιf V (x - y) = ιf V x - ιf V y := by
    intro V x y
    rw [hιf, hιf, hιf]
    exact map_sub _ x y
  have hsmul : ∀ (V : Y.Opens) (r : Γ(Y, V)) (k : Γ(F, V)), ιf V (r • k) = r * ιf V k := by
    intro V r k
    rw [hιf, hιf]
    exact Scheme.Modules.Hom.app_smul ι r k
  have hnat : ∀ (U V : Y.Opens) (h : V ≤ U) (k : Γ(F, U)),
      ιf V ((F.presheaf.map (homOfLE h).op).hom k) =
        (Y.presheaf.map (homOfLE h).op).hom (ιf U k) := by
    intro U V h k
    rw [hιf, hιf]
    exact NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf ι) (homOfLE h).op k

  obtain ⟨cY, hcY⟩ : ∃ cY : ∀ a b : Fin L.m, Γ(Y, L.V a ⊓ L.V b ⊓ ⊤), ∀ a b, cY a b = c a b :=
    ⟨fun a b => c a b, fun _ _ => rfl⟩
  have hcR : ∀ a b d : Fin L.m, (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V d ⊓ ⊤ from inf_le_inf_right ⊤ (inf_le_inf_right (L.V d) inf_le_left))).op).hom (cY a d) = (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V b ⊓ L.V d ⊓ ⊤ from inf_le_inf_right ⊤ (inf_le_inf_right (L.V d) inf_le_right))).op).hom (cY b d) + ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V b ⊓ L.V d from (inf_le_left : L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V b ⊓ L.V d).trans (inf_le_inf_right (L.V d) inf_le_right))).op).hom (L.g b d : Γ(Y, L.V b ⊓ L.V d))) ^ n * (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V b ⊓ ⊤ from le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (cY a b) := by
    intro a b d
    rw [hcY, hcY, hcY]
    exact hc a b d

  obtain ⟨B, hB⟩ := hsplit cY hcR

  obtain ⟨c', hc'def⟩ : ∃ c' : ∀ a b : Fin L.m, Γ(Y, L.V a ⊓ L.V b ⊓ ⊤), ∀ a b, c' a b =
      cY a b - ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V b ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (B b) -
        ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ L.V b from
          inf_le_left)).op).hom (L.g a b : Γ(Y, L.V a ⊓ L.V b))) ^ n *
        (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (B a)) :=
    ⟨fun a b => cY a b - ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V b ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (B b) -
        ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ L.V b from
          inf_le_left)).op).hom (L.g a b : Γ(Y, L.V a ⊓ L.V b))) ^ n *
        (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (B a)),
      fun _ _ => rfl⟩
  have hvan : ∀ (a b : Fin L.m) (z : Y) (hz : z ∈ L.V a ⊓ L.V b ⊓ ⊤), z ∈ T →
      (Y.presheaf.germ (L.V a ⊓ L.V b ⊓ ⊤) z hz).hom (c' a b) ∈
        IsLocalRing.maximalIdeal (Y.presheaf.stalk z) := by
    intro a b z hz hzT
    rw [hc'def]
    exact hB a b z hz hzT

  have hlift : ∀ a b : Fin L.m, ∃ k : Γ(F, L.V a ⊓ L.V b ⊓ ⊤), ιf _ k = c' a b :=
    fun a b => (hchar' _ _).mpr (hvan a b)
  choose k hk using hlift

  obtain ⟨β', hβ'⟩ := hTw k (by
    intro a b d
    apply hinj'
    rw [hadd, hsmul, hnat, hnat, hnat, hk, hk, hk, hc'def, hc'def, hc'def]
    have hg := congrArg (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤
      L.V a ⊓ L.V b ⊓ L.V d from inf_le_left)).op).hom (hL.2.2.2 a b d)
    simp only [map_mul, hres] at hg
    have hcc := hcR a b d
    simp only [map_sub, map_mul, map_pow, hres]
    rw [← hg, mul_pow]
    linear_combination hcc)

  have key : ∀ a b : Fin L.m, cY a b =
      (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V b ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (B b + ιf _ (β' b)) -
        ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ L.V b from
          inf_le_left)).op).hom (L.g a b : Γ(Y, L.V a ⊓ L.V b))) ^ n *
        (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (B a + ιf _ (β' a)) := by
    intro a b
    have e := congrArg (ιf _) (hβ' a b)
    rw [hk, hsub, hsmul, hnat, hnat, hc'def] at e
    simp only [map_add]
    linear_combination e
  refine ⟨fun a => (B a + ιf _ (β' a) : Γ(Y, L.V a ⊓ ⊤)), fun a b => ?_⟩
  exact (hcY a b).symm.trans (key a b)

theorem wcpa_dj_lge_tail_reduce : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (L : wcpaDjCoc Y),
    wcpaDjCocOK L → ∀ (t : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ ⊤)), wcpaDjCompat L ⊤ 1 t →
    ∀ (E₀ : Set Y) (Er : Scheme.{u}) (ιE : Er ⟶ Y)
      (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        MvPolynomial.gradedAlgebra),
    IsClosedImmersion ιE → Set.range ιE = E₀ →
    (∀ a, ∀ z ∈ E₀, z ∈ L.V a → z ∈ Y.basicOpen (t a)) →
    ∀ (F : Y.Modules) (ι : F ⟶ wcStructMod Y),
    (∀ V : Y.Opens, Function.Injective (Scheme.Modules.Hom.app ι V)) →
    (∀ (V : Y.Opens) (f : Γ(Y, V)), (∃ k : Γ(F, V), Scheme.Modules.Hom.app ι V k = f) ↔
      ∀ (z : Y) (hz : z ∈ V), z ∈ E₀ →
        (Y.presheaf.germ V z hz).hom f ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z)) →
    ∀ n : ℕ, wcpaDjTwH1 L ⊤ F n → wcpaDjTwH1 L ⊤ (wcStructMod Y) n :=
by
  intro K _ Y L hOK t hcomp E₀ Er ιE θ hιE hrange hE₀t F ι hinj hiff n hTw

  have hres : ∀ {U V W : Er.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(Er, U)),
      (Er.presheaf.map (homOfLE h2).op).hom ((Er.presheaf.map (homOfLE h1).op).hom x) =
        (Er.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro U V W h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  have hH1 : ∀ (m : ℕ) (O : Fin m → Er.Opens), (⨆ i, O i) = ⊤ →
      ∀ e : ∀ i j : Fin m, Γ(Er, O i ⊓ O j),
      (∀ i j k : Fin m, (Er.presheaf.map (homOfLE (show O i ⊓ O j ⊓ O k ≤ O i ⊓ O k from
          inf_le_inf_right (O k) inf_le_left)).op).hom (e i k) =
        (Er.presheaf.map (homOfLE (show O i ⊓ O j ⊓ O k ≤ O j ⊓ O k from
          inf_le_inf_right (O k) inf_le_right)).op).hom (e j k) +
        (Er.presheaf.map (homOfLE (show O i ⊓ O j ⊓ O k ≤ O i ⊓ O j from
          inf_le_left)).op).hom (e i j)) →
      ∃ β : ∀ i : Fin m, Γ(Er, O i), ∀ i j : Fin m,
        e i j = (Er.presheaf.map (homOfLE (inf_le_right : O i ⊓ O j ≤ O j)).op).hom (β j) -
          (Er.presheaf.map (homOfLE (inf_le_left : O i ⊓ O j ≤ O i)).op).hom (β i) := by
    intro m O hcov e hcoc
    obtain ⟨W₀, W₁, hW₀, hW₁, hsup, hpid₀, hpid₁, hsplit⟩ := wcpa_dj_lge_tr_p1_charts K Er θ
    have chart : ∀ W : Er.Opens, IsAffineOpen W →
        (∀ O' : Er.Opens, O' ≤ W → ∃ f : Γ(Er, W), Er.basicOpen f = O') →
        ∃ β : ∀ i : Fin m, Γ(Er, O i ⊓ W), ∀ i j : Fin m,
          (Er.presheaf.map (homOfLE (show O i ⊓ O j ⊓ W ≤ O i ⊓ O j from inf_le_left)).op).hom
              (e i j) =
            (Er.presheaf.map (homOfLE (show O i ⊓ O j ⊓ W ≤ O j ⊓ W from
              le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (β j) -
            (Er.presheaf.map (homOfLE (show O i ⊓ O j ⊓ W ≤ O i ⊓ W from
              le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (β i) := by
      intro W hW hbas
      refine wcpa_dj_lge_tr_chart_cech Er W hW hbas m O (by rw [hcov]; exact le_top) (fun i j =>
        (Er.presheaf.map (homOfLE (show O i ⊓ O j ⊓ W ≤ O i ⊓ O j from inf_le_left)).op).hom
          (e i j)) ?_
      intro i j k
      have h := congrArg (Er.presheaf.map (homOfLE (show O i ⊓ O j ⊓ O k ⊓ W ≤ O i ⊓ O j ⊓ O k
        from inf_le_left)).op).hom (hcoc i j k)
      rw [map_add] at h
      simp only [hres] at h ⊢
      exact h
    obtain ⟨β₀, hβ₀⟩ := chart W₀ hW₀ (wcpa_dj_lge_tr_pid_basic Er W₀ hW₀ hpid₀)
    obtain ⟨β₁, hβ₁⟩ := chart W₁ hW₁ (wcpa_dj_lge_tr_pid_basic Er W₁ hW₁ hpid₁)
    exact wcpa_dj_lge_tr_glue_two Er W₀ W₁ hsup hsplit m O hcov e β₀ β₁ hβ₀ hβ₁

  have hbo : ∀ (a : Fin L.m) (y : Er), ιE y ∈ L.V a → ιE y ∈ Y.basicOpen (t a) := by
    intro a y hy
    exact hE₀t a (ιE y) (by rw [← hrange]; exact ⟨y, rfl⟩) hy

  have hgerm : ∀ (U : Y.Opens) (s : Γ(Y, U)) (y : Er) (hy : ιE y ∈ U),
      (ιE.app U).hom s = 0 →
      (Y.presheaf.germ U (ιE y) hy).hom s ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk (ιE y)) := by
    intro U s y hy hs
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have h1 := hu.map (ιE.stalkMap y).hom
    have h2 : (ιE.stalkMap y).hom ((Y.presheaf.germ U (ιE y) hy).hom s) = 0 := by
      rw [Scheme.Hom.germ_stalkMap_apply, hs, map_zero]
    rw [h2] at h1
    exact not_isUnit_zero h1

  refine wcpa_dj_lge_tr_ideal_correct Y L hOK E₀ F ι hinj hiff n hTw ?_
  intro c hc
  obtain ⟨B, hB⟩ := wcpa_dj_lge_tr_closed_split Y L hOK t hcomp Er ιE hιE hbo hH1 n c hc
  refine ⟨B, fun a b z hz hzE => ?_⟩
  rw [← hrange] at hzE
  obtain ⟨y, rfl⟩ := hzE
  exact hgerm _ _ y hz (hB a b)

theorem wcpa_dj_lcp_cta_ideal_sheaf : ∀ (Y : Scheme.{u}) (T : Set Y),
    ∃ (K : Y.Modules) (ι : K ⟶ wcStructMod Y),
      (∀ V : Y.Opens, Function.Injective (Scheme.Modules.Hom.app ι V)) ∧
      ∀ (V : Y.Opens) (f : Γ(Y, V)), (∃ k : Γ(K, V), Scheme.Modules.Hom.app ι V k = f) ↔
        ∀ (z : Y) (hz : z ∈ V), z ∈ T →
          (Y.presheaf.germ V z hz).hom f ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z) :=
by
  have s1 : ∀ (X : Scheme.{u}) (G M : X.Modules) (Ψ : ∀ V : X.Opens, Γ(G, V) → Γ(M, V) → Prop), (∀ V, Ψ V 0 0) → (∀ V g m g' m', Ψ V g m → Ψ V g' m' → Ψ V (g + g') (m + m')) → (∀ V (a : Γ(X, V)) g m, Ψ V g m → Ψ V (a • g) (a • m)) → (∀ V W (h : W ≤ V) g m, Ψ V g m → Ψ W (G.presheaf.map (homOfLE h).op g) (M.presheaf.map (homOfLE h).op m)) → (∀ V g m, (∀ x ∈ V, ∃ (W : X.Opens) (h : W ≤ V), x ∈ W ∧ Ψ W (G.presheaf.map (homOfLE h).op g) (M.presheaf.map (homOfLE h).op m)) → Ψ V g m) → ∃ (E : X.Modules) (α : E ⟶ G) (β : E ⟶ M), (∀ (V : X.Opens) (e e' : Γ(E, V)), Scheme.Modules.Hom.app α V e = Scheme.Modules.Hom.app α V e' → Scheme.Modules.Hom.app β V e = Scheme.Modules.Hom.app β V e' → e = e') ∧ ∀ (V : X.Opens) (g : Γ(G, V)) (m : Γ(M, V)), (∃ e : Γ(E, V), Scheme.Modules.Hom.app α V e = g ∧ Scheme.Modules.Hom.app β V e = m) ↔ Ψ V g m := by
    intro X G M Ψ h0 hadd hsmul hres hloc
    classical
    let S : ∀ V : X.Opens, Submodule Γ(X, V) (Γ(G, V) × Γ(M, V)) := fun V =>
      { carrier := {p | Ψ V p.1 p.2}
        add_mem' := fun {a b} ha hb => hadd V a.1 a.2 b.1 b.2 ha hb
        zero_mem' := h0 V
        smul_mem' := fun c p hp => hsmul V c p.1 p.2 hp }
    let P : (X.Opens)ᵒᵖ ⥤ Ab.{u} :=
      { obj := fun V => AddCommGrpCat.of (S V.unop)
        map := fun {V W} i => AddCommGrpCat.ofHom
          { toFun := fun p => ⟨((G.presheaf.map i).hom p.1.1, (M.presheaf.map i).hom p.1.2),
              hres V.unop W.unop i.unop.le p.1.1 p.1.2 p.2⟩
            map_zero' := Subtype.ext (Prod.ext (map_zero _) (map_zero _))
            map_add' := fun a b => Subtype.ext (Prod.ext (map_add _ _ _) (map_add _ _ _)) }
        map_id := fun V => by
          ext p
          · change (G.presheaf.map (𝟙 V)).hom p.1.1 = p.1.1
            rw [G.presheaf.map_id]; rfl
          · change (M.presheaf.map (𝟙 V)).hom p.1.2 = p.1.2
            rw [M.presheaf.map_id]; rfl
        map_comp := fun {V W Z} i j => by
          ext p
          · change (G.presheaf.map (i ≫ j)).hom p.1.1 =
              (G.presheaf.map j).hom ((G.presheaf.map i).hom p.1.1)
            rw [G.presheaf.map_comp]; rfl
          · change (M.presheaf.map (i ≫ j)).hom p.1.2 =
              (M.presheaf.map j).hom ((M.presheaf.map i).hom p.1.2)
            rw [M.presheaf.map_comp]; rfl }
    letI inst : ∀ V : (X.Opens)ᵒᵖ, Module ↑(X.ringCatSheaf.obj.obj V) ↑(P.obj V) := fun V =>
      (inferInstance : Module Γ(X, V.unop) (S V.unop))
    let Pm : PresheafOfModules X.ringCatSheaf.obj := PresheafOfModules.ofPresheaf P (by
      intro V W f r p
      apply Subtype.ext
      exact Prod.ext (Scheme.Modules.map_smul G f.unop r p.1.1)
        (Scheme.Modules.map_smul M f.unop r p.1.2))
    have hsh : TopCat.Presheaf.IsSheaf P := by
      rw [TopCat.Presheaf.isSheaf_iff_isSheafUniqueGluing]
      intro ι U sf hcompat
      let sG : ∀ i, Γ(G, U i) := fun i => (sf i).1.1
      let sM : ∀ i, Γ(M, U i) := fun i => (sf i).1.2
      have hcG : TopCat.Presheaf.IsCompatible G.presheaf U sG := by
        intro i j
        exact congrArg (fun q => q.1.1) (hcompat i j)
      have hcM : TopCat.Presheaf.IsCompatible M.presheaf U sM := by
        intro i j
        exact congrArg (fun q => q.1.2) (hcompat i j)
      obtain ⟨g, hg, huG⟩ := TopCat.Sheaf.existsUnique_gluing ⟨G.presheaf, G.isSheaf⟩ U sG hcG
      obtain ⟨m, hm, huM⟩ := TopCat.Sheaf.existsUnique_gluing ⟨M.presheaf, M.isSheaf⟩ U sM hcM
      have hΨ : Ψ (iSup U) g m := by
        apply hloc
        intro x hx
        obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
        refine ⟨U i, le_iSup U i, hi, ?_⟩
        have e1 := hg i
        have e2 := hm i
        change (G.presheaf.map (homOfLE (le_iSup U i)).op).hom g = sG i at e1
        change (M.presheaf.map (homOfLE (le_iSup U i)).op).hom m = sM i at e2
        change Ψ (U i) ((G.presheaf.map (homOfLE (le_iSup U i)).op).hom g)
          ((M.presheaf.map (homOfLE (le_iSup U i)).op).hom m)
        rw [e1, e2]
        exact (sf i).2
      exact ⟨⟨(g, m), hΨ⟩, fun i => Subtype.ext (Prod.ext (hg i) (hm i)),
        fun t ht => Subtype.ext (Prod.ext (huG t.1.1 fun i => congrArg (fun q => q.1.1) (ht i))
          (huM t.1.2 fun i => congrArg (fun q => q.1.2) (ht i)))⟩
    let E : X.Modules := SheafOfModules.mk Pm hsh
    let φG : P ⟶ G.presheaf :=
      { app := fun V => AddCommGrpCat.ofHom
          ((LinearMap.fst Γ(X, V.unop) Γ(G, V.unop) Γ(M, V.unop)).comp
            (S V.unop).subtype).toAddMonoidHom
        naturality := fun V W i => rfl }
    let φM : P ⟶ M.presheaf :=
      { app := fun V => AddCommGrpCat.ofHom
          ((LinearMap.snd Γ(X, V.unop) Γ(G, V.unop) Γ(M, V.unop)).comp
            (S V.unop).subtype).toAddMonoidHom
        naturality := fun V W i => rfl }
    let α : E ⟶ G := ⟨PresheafOfModules.homMk (M₁ := Pm) (M₂ := G.val) φG (fun V r p => rfl)⟩
    let β : E ⟶ M := ⟨PresheafOfModules.homMk (M₁ := Pm) (M₂ := M.val) φM (fun V r p => rfl)⟩
    have hα : ∀ V (e : Γ(E, V)), Scheme.Modules.Hom.app α V e = (e : S V).1.1 := fun V e => rfl
    have hβ : ∀ V (e : Γ(E, V)), Scheme.Modules.Hom.app β V e = (e : S V).1.2 := fun V e => rfl
    refine ⟨E, α, β, ?_, ?_⟩
    · intro V e e' h1 h2
      rw [hα, hα] at h1
      rw [hβ, hβ] at h2
      exact Subtype.ext (Prod.ext h1 h2)
    · intro V g m
      constructor
      · rintro ⟨e, h1, h2⟩
        rw [hα] at h1
        rw [hβ] at h2
        subst h1 h2
        exact (e : S V).2
      · intro h
        exact ⟨(⟨(g, m), h⟩ : S V), rfl, rfl⟩
  intro Y T
  have gr : ∀ (U V : Y.Opens) (i : V ⟶ U) (z : Y) (hz : z ∈ V) (f : Γ(Y, U)),
      (Y.presheaf.germ V z hz).hom ((Y.presheaf.map i.op).hom f) =
        (Y.presheaf.germ U z (i.le hz)).hom f :=
    fun U V i z hz f => TopCat.Presheaf.germ_res_apply Y.presheaf i z hz f
  let Pd : ∀ V : Y.Opens, Γ(Y, V) → Prop := fun V g =>
    ∀ (z : Y) (hz : z ∈ V), z ∈ T →
      (Y.presheaf.germ V z hz).hom g ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z)
  let Ψ : ∀ V : Y.Opens, Γ(wcStructMod Y, V) → Γ(wcStructMod Y, V) → Prop :=
    fun V g m => m = 0 ∧ Pd V g
  have padd : ∀ (V : Y.Opens) (g g' : Γ(Y, V)), Pd V g → Pd V g' → Pd V (g + g') := by
    intro V g g' hg hg' z hz hzT
    rw [map_add]
    exact Ideal.add_mem _ (hg z hz hzT) (hg' z hz hzT)
  have pmul : ∀ (V : Y.Opens) (a g : Γ(Y, V)), Pd V g → Pd V (a * g) := by
    intro V a g hg z hz hzT
    rw [map_mul]
    exact Ideal.mul_mem_left _ _ (hg z hz hzT)
  have pres : ∀ (V W : Y.Opens) (h : W ≤ V) (g : Γ(Y, V)), Pd V g →
      Pd W ((Y.presheaf.map (homOfLE h).op).hom g) := by
    intro V W h g hg z hz hzT
    rw [gr]
    exact hg z _ hzT
  have ploc : ∀ (V W : Y.Opens) (h : W ≤ V) (g : Γ(Y, V)) (z : Y) (hz : z ∈ V) (hzW : z ∈ W),
      (Y.presheaf.germ W z hzW).hom ((Y.presheaf.map (homOfLE h).op).hom g) ∈
        IsLocalRing.maximalIdeal (Y.presheaf.stalk z) →
      (Y.presheaf.germ V z hz).hom g ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z) := by
    intro V W h g z hz hzW H
    rw [gr] at H
    exact H
  have H0 : ∀ V, Ψ V 0 0 := by
    intro V
    refine ⟨rfl, ?_⟩
    intro z hz _
    show (Y.presheaf.germ V z hz).hom (0 : Γ(Y, V)) ∈ _
    rw [map_zero]
    exact Ideal.zero_mem _
  have Hadd : ∀ V g m g' m', Ψ V g m → Ψ V g' m' → Ψ V (g + g') (m + m') := by
    intro V g m g' m' ⟨hm, hg⟩ ⟨hm', hg'⟩
    refine ⟨?_, ?_⟩
    · rw [hm, hm', add_zero]
    · exact padd V g g' hg hg'
  have Hsmul : ∀ V (a : Γ(Y, V)) g m, Ψ V g m → Ψ V (a • g) (a • m) := by
    intro V a g m ⟨hm, hg⟩
    refine ⟨?_, ?_⟩
    · rw [hm, smul_zero]
    · exact pmul V a g hg
  have Hres : ∀ V W (h : W ≤ V) g m, Ψ V g m →
      Ψ W ((wcStructMod Y).presheaf.map (homOfLE h).op g)
        ((wcStructMod Y).presheaf.map (homOfLE h).op m) := by
    intro V W h g m ⟨hm, hg⟩
    refine ⟨?_, ?_⟩
    · rw [hm, map_zero]
    · exact pres V W h g hg
  have Hloc : ∀ V g m, (∀ x ∈ V, ∃ (W : Y.Opens) (h : W ≤ V), x ∈ W ∧
      Ψ W ((wcStructMod Y).presheaf.map (homOfLE h).op g)
        ((wcStructMod Y).presheaf.map (homOfLE h).op m)) → Ψ V g m := by
    intro V g m hW
    refine ⟨?_, ?_⟩
    · show (m : Γ(Y, V)) = (0 : Γ(Y, V))
      apply TopCat.Presheaf.section_ext Y.sheaf V
      intro x hx
      obtain ⟨W, h, hxW, hm, _⟩ := hW x hx
      have hm' : (Y.presheaf.map (homOfLE h).op).hom (m : Γ(Y, V)) = 0 := hm
      have e1 := gr V W (homOfLE h) x hxW (m : Γ(Y, V))
      rw [hm', map_zero] at e1
      have e2 := gr V W (homOfLE h) x hxW (0 : Γ(Y, V))
      rw [map_zero, map_zero] at e2
      exact e1.symm.trans e2
    · intro z hz hzT
      obtain ⟨W, h, hzW, _, hg⟩ := hW z hz
      exact ploc V W h g z hz hzW (hg z hzW hzT)
  obtain ⟨E, α, β, hjoint, himg⟩ :=
    s1 Y (wcStructMod Y) (wcStructMod Y) Ψ H0 Hadd Hsmul Hres Hloc
  refine ⟨E, α, ?_, ?_⟩
  · intro V e e' hee'
    have hb : ∀ e : Γ(E, V), Scheme.Modules.Hom.app β V e = 0 := fun e =>
      ((himg V _ _).mp ⟨e, rfl, rfl⟩).1
    exact hjoint V e e' hee' ((hb e).trans (hb e').symm)
  · intro V f
    constructor
    · rintro ⟨k, hk⟩
      have h := ((himg V _ _).mp ⟨k, rfl, rfl⟩).2
      rw [hk] at h
      exact h
    · intro hf
      obtain ⟨e, he, _⟩ := (himg V (f : Γ(wcStructMod Y, V)) 0).mpr ⟨rfl, hf⟩
      exact ⟨e, he⟩

theorem wcpa_dj_lge_closed_fibre_good : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (r : ℕ)
    (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁)) (L : wcpaDjCoc Z₁)
    (t : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)),
    IsAlgClosed (IsLocalRing.ResidueField ↥W) →
    wcpaDjSemistable u₁ → wcpaDjSections u₁ r ε → wcpaDjCocOK L →
    wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) 1 t →
    (∀ a, (Z₁.basicOpen (t a) : Set Z₁) =
      ((L.V a ⊓ u₁ ⁻¹ᵁ ⊤ : Z₁.Opens) : Set Z₁) \ ⋃ i, Set.range ⇑(ε i)) →
    wcpaLccHAF u₁ ε →
    ∃ m₀ : ℕ, 0 < m₀ ∧ ∀ e : ℕ, m₀ ≤ e →
      wcpaDjTwH1 (wcpaDjCocPull (Limits.pullback.fst u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L) ⊤
        (wcStructMod (Limits.pullback u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) e ∧
      wcpaLccGG (Limits.pullback.snd u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
        (wcpaDjCocPull (Limits.pullback.fst u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L) e :=
by
  intro Ω _ _ W Z₁ u₁ r ε L t hκ hss hsec hOK hcompat hbo hAF
  classical

  have key : ∀ (κ : Type u) [Field κ] [IsAlgClosed κ] (C : Scheme.{u}) (q : C ⟶ Spec (.of κ))
      (L₀ : wcpaDjCoc C) (ε₀ : Fin r → (Spec (.of κ) ⟶ C))
      (t₀ : ∀ a : Fin L₀.m, Γ(C, L₀.V a ⊓ q ⁻¹ᵁ ⊤)),
      wcpaDjSemistable q → wcpaDjSections q r ε₀ → wcpaDjCocOK L₀ →
      wcpaDjCompat L₀ (q ⁻¹ᵁ ⊤) 1 t₀ →
      (∀ a, (C.basicOpen (t₀ a) : Set C) =
        ((L₀.V a ⊓ q ⁻¹ᵁ ⊤ : C.Opens) : Set C) \ ⋃ i, Set.range ⇑(ε₀ i)) →
      (∀ E ∈ irreducibleComponents C, (∀ b, ε₀ b (IsLocalRing.closedPoint κ) ∉ E) →
        ∃ (Er : Scheme.{u}) (ι : Er ⟶ C)
          (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) κ)
            MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) κ)
            MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
              (algebraMap κ ↥(MvPolynomial.homogeneousSubmodule (Fin 2) κ 0))) = ι ≫ q) →
      (∀ E ∈ irreducibleComponents C, ∀ E' ∈ irreducibleComponents C,
        (∀ b, ε₀ b (IsLocalRing.closedPoint κ) ∉ E) →
        (∀ b, ε₀ b (IsLocalRing.closedPoint κ) ∉ E') → E = E') →
      ∃ m₀ : ℕ, 0 < m₀ ∧ ∀ e : ℕ, m₀ ≤ e →
        wcpaDjTwH1 L₀ ⊤ (wcStructMod C) e ∧ wcpaLccGG q L₀ e := by
    intro κ _ _ C q L₀ ε₀ t₀ hss₀ hsec₀ hOK₀ hcomp₀ hbo₀ hP1 huniq
    haveI : IsProper q := hss₀.2.1
    haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian q
    set pt := IsLocalRing.closedPoint κ with hpt
    have hcl : ∀ b, IsClosed ({ε₀ b pt} : Set C) := fun b =>
      wc_pfam_mc_rational_point_closed κ C q (ε₀ b) (hsec₀.1 b)
    have hcov : ∀ z : C, ∃ a, z ∈ L₀.V a := by
      intro z
      have hz : z ∈ (⊤ : C.Opens) := trivial
      rw [← hOK₀.2.1] at hz
      exact TopologicalSpace.Opens.mem_iSup.mp hz


    have hdata : ∃ (S : Set C), IsClosed S ∧ (∀ b, ε₀ b pt ∉ S) ∧
        (∃ nO : ℕ, ∀ n ≥ nO, wcpaDjTwH1 L₀ ⊤ (wcStructMod C) n) ∧
        ∀ b, ∃ (K : C.Modules) (ι : K ⟶ wcStructMod C),
          (∀ V : C.Opens, Function.Injective (Scheme.Modules.Hom.app ι V)) ∧
          (∀ (V : C.Opens) (f : Γ(C, V)), (∃ k : Γ(K, V), Scheme.Modules.Hom.app ι V k = f) ↔
            ∀ (z : C) (hz : z ∈ V), z ∈ insert (ε₀ b pt) S →
              (C.presheaf.germ V z hz).hom f ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk z)) ∧
          ∃ nb : ℕ, ∀ n ≥ nb, wcpaDjTwH1 L₀ ⊤ K n := by
      by_cases hA : ∀ E ∈ irreducibleComponents C, ∃ b, ε₀ b pt ∈ E
      ·
        refine ⟨∅, isClosed_empty, fun b h => h, ?_, fun b => ?_⟩
        · exact wcpa_dj_lge_serre_no_tail κ C q r ε₀ L₀ t₀ hss₀ hsec₀ hOK₀ hcomp₀ hbo₀ hA _
            (wc_struct_mod_coh C)
        · obtain ⟨K, ι, hinj, hiff⟩ := wcpa_dj_lcp_cta_ideal_sheaf C (insert (ε₀ b pt) ∅)
          exact ⟨K, ι, hinj, hiff, wcpa_dj_lge_serre_no_tail κ C q r ε₀ L₀ t₀ hss₀ hsec₀ hOK₀
            hcomp₀ hbo₀ hA K (wcpa_dj_lcp_cta_ideal_coherent C _ K ι hinj hiff)⟩
      ·
        push_neg at hA
        obtain ⟨E₀, hE₀, hE₀b⟩ := hA
        have hoth : ∀ E ∈ irreducibleComponents C, E ≠ E₀ → ∃ b, ε₀ b pt ∈ E := by
          intro E hE hne
          by_contra h
          push_neg at h
          exact hne (huniq E hE E₀ hE₀ h hE₀b)
        obtain ⟨Er, ιE, θ, hιE, -, hrange, -⟩ := hP1 E₀ hE₀ hE₀b
        have hE₀t : ∀ a, ∀ z ∈ E₀, z ∈ L₀.V a → z ∈ C.basicOpen (t₀ a) := by
          intro a z hz hza
          have h1 : z ∈ (C.basicOpen (t₀ a) : Set C) := by
            rw [hbo₀ a]
            refine ⟨⟨hza, trivial⟩, ?_⟩
            intro hU
            rw [Set.mem_iUnion] at hU
            obtain ⟨b, p, hp⟩ := hU
            apply hE₀b b
            have hzb : ε₀ b pt = z := by rw [← hp, Subsingleton.elim p pt]
            rw [hzb]
            exact hz
          exact h1
        obtain ⟨KE, ιK, hinjE, hiffE⟩ := wcpa_dj_lcp_cta_ideal_sheaf C E₀
        obtain ⟨nE, hnE⟩ := wcpa_dj_lge_serre_tail_ideal κ C q r ε₀ L₀ t₀ hss₀ hsec₀ hOK₀
          hcomp₀ hbo₀ E₀ hE₀ hE₀b hoth E₀ subset_rfl KE ιK hinjE hiffE
        refine ⟨E₀, isClosed_of_mem_irreducibleComponents E₀ hE₀, hE₀b,
          ⟨nE, fun n hn => wcpa_dj_lge_tail_reduce κ C L₀ hOK₀ t₀ hcomp₀ E₀ Er ιE θ hιE hrange
            hE₀t KE ιK hinjE hiffE n (hnE n hn)⟩, fun b => ?_⟩
        obtain ⟨K, ι, hinj, hiff⟩ := wcpa_dj_lcp_cta_ideal_sheaf C (insert (ε₀ b pt) E₀)
        exact ⟨K, ι, hinj, hiff, wcpa_dj_lge_serre_tail_ideal κ C q r ε₀ L₀ t₀ hss₀ hsec₀ hOK₀
          hcomp₀ hbo₀ E₀ hE₀ hE₀b hoth _ (Set.subset_insert _ _) K ι hinj hiff⟩
    obtain ⟨S, hScl, hSb, ⟨nO, hnO⟩, hK⟩ := hdata
    choose K ι hinj hiff nb hnb using hK
    choose ab hab using fun b => hcov (ε₀ b pt)
    refine ⟨max 1 (max nO (Finset.univ.sup nb)), lt_of_lt_of_le zero_lt_one (le_max_left _ _),
      fun e he => ?_⟩
    have hpos : 0 < e := lt_of_lt_of_le zero_lt_one (le_trans (le_max_left _ _) he)
    have heO : nO ≤ e := le_trans (le_max_left _ _) (le_trans (le_max_right _ _) he)
    have heb : ∀ b, nb b ≤ e := fun b =>
      le_trans (Finset.le_sup (Finset.mem_univ b)) (le_trans (le_max_right _ _)
        (le_trans (le_max_right _ _) he))
    refine ⟨hnO e heO, ?_⟩
    have hs : ∀ b, ∃ s : ∀ a : Fin L₀.m, Γ(C, L₀.V a ⊓ ⊤),
        wcpaDjCompat L₀ ⊤ e s ∧ ε₀ b pt ∈ C.basicOpen (s (ab b)) := fun b =>
      wcpa_dj_lge_point_section C L₀ hOK₀ (ε₀ b pt) (hcl b) (ab b) (hab b) S hScl (hSb b)
        (K b) (ι b) (hinj b) (hiff b) e (hnb b e (heb b))
    choose s hs1 hs2 using hs
    let s' : Fin r → ∀ a : Fin L₀.m, Γ(C, L₀.V a ⊓ q ⁻¹ᵁ ⊤) := s
    have hs1' : ∀ b, wcpaDjCompat L₀ (q ⁻¹ᵁ ⊤) e (s' b) := fun b => hs1 b
    have hs2' : ∀ b, ε₀ b pt ∈ C.basicOpen (s' b (ab b)) := fun b => hs2 b
    refine ⟨r + 1, Fin.cases (motive := fun _ => ∀ a : Fin L₀.m, Γ(C, L₀.V a ⊓ q ⁻¹ᵁ ⊤))
      (fun a => t₀ a ^ e) s', ?_, ?_⟩
    · intro J
      refine Fin.cases ?_ (fun b => ?_) J
      · intro a b
        have h := hcomp₀ a b
        simp only [Fin.cases_zero, map_pow] at h ⊢
        rw [h, mul_pow, pow_one]
      · simp only [Fin.cases_succ]
        exact hs1' b
    · rw [eq_top_iff]
      intro z _
      rw [TopologicalSpace.Opens.mem_iSup]
      obtain ⟨a, ha⟩ := hcov z
      by_cases hz : z ∈ ⋃ i, Set.range ⇑(ε₀ i)
      · rw [Set.mem_iUnion] at hz
        obtain ⟨b, p, hp⟩ := hz
        have hzb : z = ε₀ b pt := by rw [← hp, Subsingleton.elim p pt]
        refine ⟨b.succ, ?_⟩
        rw [TopologicalSpace.Opens.mem_iSup]
        refine ⟨ab b, ?_⟩
        simp only [Fin.cases_succ]
        rw [hzb]
        exact hs2' b
      · refine ⟨0, ?_⟩
        rw [TopologicalSpace.Opens.mem_iSup]
        refine ⟨a, ?_⟩
        simp only [Fin.cases_zero]
        rw [Scheme.basicOpen_pow C (t₀ a) hpos]
        have h1 : z ∈ (C.basicOpen (t₀ a) : Set C) := by
          rw [hbo₀ a]
          exact ⟨⟨ha, trivial⟩, hz⟩
        exact h1

  obtain ⟨ε₀, t₀, hss₀, hsec₀, hOK₀, hcomp₀, hbo₀, hP1, huniq⟩ :=
    wcpa_dj_lge_cf_transport Ω W Z₁ u₁ r ε L t hκ hss hsec hOK hcompat hbo hAF
  haveI := hκ
  exact key (IsLocalRing.ResidueField ↥W) _ _ _ ε₀ t₀ hss₀ hsec₀ hOK₀ hcomp₀ hbo₀ hP1 huniq

theorem wcpa_dj_lge_cbc_kernel_basis : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (n0 n1 n2 : ℕ) (D0 : Matrix (Fin n1) (Fin n0) A) (D1 : Matrix (Fin n2) (Fin n1) A), D1 * D0 = 0 → (∀ w : Fin n1 → IsLocalRing.ResidueField A, (D1.map (IsLocalRing.residue A)).mulVec w = 0 → ∃ v : Fin n0 → IsLocalRing.ResidueField A, w = (D0.map (IsLocalRing.residue A)).mulVec v) → ∃ (N : ℕ) (P : Matrix (Fin n0) (Fin N) A), D0 * P = 0 ∧ ∀ (R : Type u) [CommRing R] (φ : A →+* R) (v : Fin n0 → R), (D0.map φ).mulVec v = 0 → ∃! c : Fin N → R, v = (P.map φ).mulVec c :=
by
  classical
  intro A _ _ n0 n1 n2 D0 D1 hgf hex

  have s1 : ∀ (k : Type u) [Field k] (m n : ℕ) (M : Matrix (Fin m) (Fin n) k),
      ∃ G : Matrix (Fin n) (Fin m) k, M * G * M = M := by
    intro k _ m n M
    obtain ⟨s, hs⟩ := LinearMap.exists_rightInverse_of_surjective (Matrix.toLin' M).rangeRestrict
      (LinearMap.range_rangeRestrict (Matrix.toLin' M))
    obtain ⟨π, hπ⟩ := LinearMap.exists_leftInverse_of_injective
      (LinearMap.range (Matrix.toLin' M)).subtype (Submodule.ker_subtype _)
    refine ⟨LinearMap.toMatrix' (s ∘ₗ π), ?_⟩
    apply Matrix.toLin'.injective
    rw [Matrix.toLin'_mul, Matrix.toLin'_mul, Matrix.toLin'_toMatrix']
    apply LinearMap.ext
    intro x
    simp only [LinearMap.comp_apply]
    have h1 : Matrix.toLin' M x
        = (LinearMap.range (Matrix.toLin' M)).subtype ((Matrix.toLin' M).rangeRestrict x) := rfl
    have h2 : π ((LinearMap.range (Matrix.toLin' M)).subtype ((Matrix.toLin' M).rangeRestrict x))
        = (Matrix.toLin' M).rangeRestrict x := by
      have := LinearMap.congr_fun hπ ((Matrix.toLin' M).rangeRestrict x)
      simpa using this
    have h3 : ∀ y, Matrix.toLin' M (s y) = (LinearMap.range (Matrix.toLin' M)).subtype y := by
      intro y
      have := LinearMap.congr_fun hs y
      simp only [LinearMap.comp_apply, LinearMap.id_apply] at this
      conv_rhs => rw [← this]
      rfl
    rw [h1, h2, h3]

  have s2 : ∀ (n m : ℕ) (T : Matrix (Fin n) (Fin n) A) (f : Matrix (Fin n) (Fin m) A)
      (Φ : Matrix (Fin m) (Fin m) A), IsUnit T.det → T * f = f * Φ →
      ∃ (Ti : Matrix (Fin n) (Fin n) A) (Ψ : Matrix (Fin m) (Fin m) A),
        T * Ti = 1 ∧ Ti * f = f * Ψ := by
    intro n m T f Φ hdet hTf
    have hk : ∀ k : ℕ, T ^ k * f = f * Φ ^ k := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        rw [pow_succ, Matrix.mul_assoc, hTf, ← Matrix.mul_assoc, ih, Matrix.mul_assoc, ← pow_succ]
    have hp : ∀ p : Polynomial A, Polynomial.aeval T p * f = f * Polynomial.aeval Φ p := by
      intro p
      rw [Polynomial.aeval_eq_sum_range, Polynomial.aeval_eq_sum_range, Matrix.sum_mul,
        Matrix.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Matrix.smul_mul, Matrix.mul_smul, hk]
    set χ := T.charpoly with hχ
    have hCH : T * Polynomial.aeval T χ.divX + (χ.coeff 0) • (1 : Matrix (Fin n) (Fin n) A) = 0 := by
      have h := congrArg (Polynomial.aeval T) (Polynomial.X_mul_divX_add χ)
      rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, hχ,
        Matrix.aeval_self_charpoly, Algebra.algebraMap_eq_smul_one] at h
      exact h
    have hu : IsUnit (χ.coeff 0) := by
      rw [Matrix.det_eq_sign_charpoly_coeff] at hdet
      exact isUnit_of_mul_isUnit_right hdet
    obtain ⟨u', hu'⟩ := hu.exists_right_inv
    refine ⟨(-u') • Polynomial.aeval T χ.divX, (-u') • Polynomial.aeval Φ χ.divX, ?_, ?_⟩
    · rw [Matrix.mul_smul, eq_neg_of_add_eq_zero_left hCH, smul_neg, neg_smul, neg_neg, smul_smul,
        mul_comm, hu', one_smul]
    · rw [Matrix.smul_mul, Matrix.mul_smul, hp]

  have s3 : ∀ (f : Matrix (Fin n1) (Fin n0) A) (g : Matrix (Fin n2) (Fin n1) A)
      (G0 : Matrix (Fin n0) (Fin n1) A) (K : Matrix (Fin n1) (Fin n2) A), g * f = 0 →
      f.map (IsLocalRing.residue A) * G0.map (IsLocalRing.residue A) * f.map (IsLocalRing.residue A)
        = f.map (IsLocalRing.residue A) →
      g.map (IsLocalRing.residue A) * K.map (IsLocalRing.residue A) * g.map (IsLocalRing.residue A)
        = g.map (IsLocalRing.residue A) →
      (∀ w : Fin n1 → IsLocalRing.ResidueField A, (g.map (IsLocalRing.residue A)).mulVec w = 0 →
        ∃ v : Fin n0 → IsLocalRing.ResidueField A, w = (f.map (IsLocalRing.residue A)).mulVec v) →
      IsUnit (f * G0 + K * g).det := by
    intro f g G0 K hgf hG hK hex
    have hgfb : g.map (IsLocalRing.residue A) * f.map (IsLocalRing.residue A) = 0 := by
      rw [← Matrix.map_mul, hgf, Matrix.map_zero _ (map_zero _)]
    have hT : (f * G0 + K * g).map (IsLocalRing.residue A)
        = f.map (IsLocalRing.residue A) * G0.map (IsLocalRing.residue A)
          + K.map (IsLocalRing.residue A) * g.map (IsLocalRing.residue A) := by
      rw [Matrix.map_add _ (map_add _), Matrix.map_mul, Matrix.map_mul]
    have hdet : IsLocalRing.residue A (f * G0 + K * g).det
        = (f.map (IsLocalRing.residue A) * G0.map (IsLocalRing.residue A)
          + K.map (IsLocalRing.residue A) * g.map (IsLocalRing.residue A)).det := by
      rw [RingHom.map_det, RingHom.mapMatrix_apply, hT]
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hdet]
    intro h0
    obtain ⟨x, hx0, hx⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr h0
    apply hx0
    have hgT : g.map (IsLocalRing.residue A) * (f.map (IsLocalRing.residue A) *
        G0.map (IsLocalRing.residue A) + K.map (IsLocalRing.residue A) *
        g.map (IsLocalRing.residue A)) = g.map (IsLocalRing.residue A) := by
      rw [Matrix.mul_add, ← Matrix.mul_assoc, ← Matrix.mul_assoc, hgfb, Matrix.zero_mul, zero_add, hK]
    have hgx : (g.map (IsLocalRing.residue A)).mulVec x = 0 := by
      rw [← hgT, ← Matrix.mulVec_mulVec, hx, Matrix.mulVec_zero]
    obtain ⟨v, rfl⟩ := hex x hgx
    rw [Matrix.mulVec_mulVec, Matrix.add_mul, Matrix.mul_assoc (K.map _), hgfb, Matrix.mul_zero,
      add_zero, hG] at hx
    exact hx

  have s4 : ∀ (n : ℕ) (Q : Matrix (Fin n) (Fin n) A), Q * Q = Q →
      ∃ (N : ℕ) (P : Matrix (Fin n) (Fin N) A) (P' : Matrix (Fin N) (Fin n) A),
        P' * P = 1 ∧ P * P' = Q := by
    intro n Q hQ
    have hqq : Matrix.toLin' Q ∘ₗ Matrix.toLin' Q = Matrix.toLin' Q := by
      rw [← Matrix.toLin'_mul, hQ]
    let M := LinearMap.range (Matrix.toLin' Q)
    let r : (Fin n → A) →ₗ[A] M :=
      LinearMap.codRestrict M (Matrix.toLin' Q) (fun v => LinearMap.mem_range_self _ v)
    have hr : r ∘ₗ M.subtype = LinearMap.id := by
      apply LinearMap.ext
      rintro ⟨y, v, rfl⟩
      apply Subtype.ext
      show Matrix.toLin' Q (Matrix.toLin' Q v) = Matrix.toLin' Q v
      exact LinearMap.congr_fun hqq v
    have : Module.Projective A M := Module.Projective.of_split M.subtype r hr
    have : Module.Finite A M := Module.Finite.range _
    have : Module.Flat A M := Module.Flat.of_projective
    have : Module.Free A M := Module.free_of_flat_of_isLocalRing
    let b := Module.finBasis A M
    refine ⟨Module.finrank A M, LinearMap.toMatrix' (M.subtype ∘ₗ b.equivFun.symm.toLinearMap),
      LinearMap.toMatrix' (b.equivFun.toLinearMap ∘ₗ r), ?_, ?_⟩
    · rw [← LinearMap.toMatrix'_comp]
      have : (b.equivFun.toLinearMap ∘ₗ r) ∘ₗ (M.subtype ∘ₗ b.equivFun.symm.toLinearMap)
          = LinearMap.id := by
        apply LinearMap.ext
        intro x
        have h := LinearMap.congr_fun hr (b.equivFun.symm x)
        simp only [LinearMap.comp_apply, LinearMap.id_apply] at h ⊢
        simp only [LinearEquiv.coe_coe] at h ⊢
        rw [h]
        exact b.equivFun.apply_symm_apply x
      rw [this, LinearMap.toMatrix'_id]
    · rw [← LinearMap.toMatrix'_comp]
      have : (M.subtype ∘ₗ b.equivFun.symm.toLinearMap) ∘ₗ (b.equivFun.toLinearMap ∘ₗ r)
          = Matrix.toLin' Q := by
        apply LinearMap.ext
        intro x
        simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply]
        rfl
      rw [this, LinearMap.toMatrix'_toLin']

  obtain ⟨Gb, hGb⟩ := s1 (IsLocalRing.ResidueField A) n1 n0 (D0.map (IsLocalRing.residue A))
  obtain ⟨Kb, hKb⟩ := s1 (IsLocalRing.ResidueField A) n2 n1 (D1.map (IsLocalRing.residue A))
  let G0 : Matrix (Fin n0) (Fin n1) A :=
    Matrix.of fun i j => Function.surjInv (IsLocalRing.residue_surjective (R := A)) (Gb i j)
  let K : Matrix (Fin n1) (Fin n2) A :=
    Matrix.of fun i j => Function.surjInv (IsLocalRing.residue_surjective (R := A)) (Kb i j)
  have hG0 : G0.map (IsLocalRing.residue A) = Gb := by
    ext i j
    exact Function.surjInv_eq _ _
  have hK0 : K.map (IsLocalRing.residue A) = Kb := by
    ext i j
    exact Function.surjInv_eq _ _
  have hdet := s3 D0 D1 G0 K hgf (by rw [hG0]; exact hGb) (by rw [hK0]; exact hKb) hex
  have hTf : (D0 * G0 + K * D1) * D0 = D0 * (G0 * D0) := by
    rw [Matrix.add_mul, Matrix.mul_assoc K, hgf, Matrix.mul_zero, add_zero, Matrix.mul_assoc]
  obtain ⟨Ti, Ψ, hTi, hTiD⟩ := s2 n1 n0 _ D0 (G0 * D0) hdet hTf
  have hreg : D0 * (G0 * Ti) * D0 = D0 := by
    calc D0 * (G0 * Ti) * D0 = D0 * G0 * (Ti * D0) := by simp only [Matrix.mul_assoc]
      _ = D0 * G0 * (D0 * Ψ) := by rw [hTiD]
      _ = (D0 * G0 + K * D1) * D0 * Ψ := by rw [hTf]; simp only [Matrix.mul_assoc]
      _ = (D0 * G0 + K * D1) * (Ti * D0) := by rw [hTiD, Matrix.mul_assoc]
      _ = D0 := by rw [← Matrix.mul_assoc, hTi, Matrix.one_mul]
  set X := G0 * Ti with hX
  set Q : Matrix (Fin n0) (Fin n0) A := 1 - X * D0 with hQ
  have hXX : X * D0 * (X * D0) = X * D0 := by
    calc X * D0 * (X * D0) = X * (D0 * X * D0) := by simp only [Matrix.mul_assoc]
      _ = X * D0 := by rw [hreg]
  have hQQ : Q * Q = Q := by
    rw [hQ, sub_mul, mul_sub, mul_sub, one_mul, mul_one, one_mul, hXX]
    abel
  have hDQ : D0 * Q = 0 := by
    rw [hQ, Matrix.mul_sub, Matrix.mul_one, ← Matrix.mul_assoc, hreg, sub_self]
  obtain ⟨N, P, P', hPP, hPQ⟩ := s4 n0 Q hQQ
  have hDP : D0 * P = 0 := by
    calc D0 * P = D0 * (P * (P' * P)) := by rw [hPP, Matrix.mul_one]
      _ = D0 * Q * P := by rw [← hPQ]; simp only [Matrix.mul_assoc]
      _ = 0 := by rw [hDQ, Matrix.zero_mul]
  refine ⟨N, P, hDP, ?_⟩
  intro R _ φ v hv
  have e1 : P'.map φ * P.map φ = 1 := by
    rw [← Matrix.map_mul, hPP, Matrix.map_one _ (map_zero φ) (map_one φ)]
  have e2 : P.map φ * P'.map φ = 1 - X.map φ * D0.map φ := by
    rw [← Matrix.map_mul, hPQ, hQ, Matrix.map_sub _ (map_sub φ),
      Matrix.map_one _ (map_zero φ) (map_one φ), Matrix.map_mul]
  refine ⟨(P'.map φ).mulVec v, ?_, ?_⟩
  · show v = (P.map φ).mulVec ((P'.map φ).mulVec v)
    rw [Matrix.mulVec_mulVec, e2, Matrix.sub_mulVec, Matrix.one_mulVec, ← Matrix.mulVec_mulVec, hv,
      Matrix.mulVec_zero, sub_zero]
  · intro c hc
    rw [hc, Matrix.mulVec_mulVec, e1, Matrix.one_mulVec]

theorem wcpa_dj_lnm_coc_data : ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (D : I ⥤ Scheme.{u}) (c : Limits.Cone D), Limits.IsLimit c → (∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f)) → (∀ i, CompactSpace (D.obj i)) → (∀ i, QuasiSeparatedSpace (D.obj i)) → ∀ L : wcpaDjCoc c.pt, (∀ a, IsAffineOpen (L.V a)) → ∃ (i : I) (L' : wcpaDjCoc (D.obj i)), (∀ a, IsAffineOpen (L'.V a)) ∧ wcpaDjCocPull (c.π.app i) L' = L :=
by
  classical
  intro I _ _ D c hc hAff hCpt hQS L hV
  haveI : ∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f) := fun f => hAff f
  haveI := hQS

  have pre_w : ∀ {j j' : I} (f : j ⟶ j') (V : (D.obj j').Opens),
      c.π.app j ⁻¹ᵁ (D.map f ⁻¹ᵁ V) = c.π.app j' ⁻¹ᵁ V := by
    intro j j' f V
    rw [← Scheme.Hom.comp_preimage, c.w]

  have coneLE : ∀ {j j' : I} (e : j' ⟶ j) (V : (D.obj j).Opens) (V' : (D.obj j').Opens)
      (he : V' ≤ D.map e ⁻¹ᵁ V) (O : c.pt.Opens) (h : O ≤ c.π.app j ⁻¹ᵁ V)
      (h' : O ≤ c.π.app j' ⁻¹ᵁ V') (t : Γ(D.obj j, V)),
      ((c.π.app j').appLE V' O h').hom (((D.map e).appLE V V' he).hom t) =
        ((c.π.app j).appLE V O h).hom t := by
    intro j j' e V V' he O h h' t
    rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE]
    have key : ∀ (φ ψ : c.pt ⟶ D.obj j), φ = ψ → ∀ e₁ e₂,
        φ.appLE V O e₁ = ψ.appLE V O e₂ := by
      rintro φ _ rfl _ _; rfl
    exact congrArg (fun φ => φ.hom t) (key _ _ (c.w e) _ h)

  have resId : ∀ {X Y : Scheme.{u}} (P : X ⟶ Y) (V : Y.Opens) (O : X.Opens) (e : O ≤ P ⁻¹ᵁ V),
      (P.resLE V O e).appTop ≫ O.topIso.hom = V.topIso.hom ≫ P.appLE V O e := by
    intro X Y P V O e
    have h := Scheme.Hom.resLE_app_top P e
    change (P.resLE V O e).app ⊤ ≫ O.topIso.hom = _
    rw [h]
    erw [Category.assoc, Category.assoc, Iso.inv_hom_id, Category.comp_id]

  have hsec : ∀ (i : I) (U : (D.obj i).Opens), IsCompact (U : Set (D.obj i)) →
      ∀ s : Γ(c.pt, c.π.app i ⁻¹ᵁ U), ∃ (j : I) (f : j ⟶ i) (t : Γ(D.obj j, D.map f ⁻¹ᵁ U)),
        ((c.π.app j).appLE (D.map f ⁻¹ᵁ U) (c.π.app i ⁻¹ᵁ U) (pre_w f U).ge).hom t = s := by
    intro i U hU s
    haveI hC : ∀ j : Over i, CompactSpace ((opensDiagram D i U).obj j) := fun j =>
      isCompact_iff_compactSpace.mp ((D.map j.hom).isCompact_preimage hU)
    haveI hQ : ∀ j : Over i, QuasiSeparatedSpace ((opensDiagram D i U).obj j) := fun j =>
      (D.map j.hom ⁻¹ᵁ U).ι.isOpenEmbedding.quasiSeparatedSpace
    obtain ⟨jO, t', ht'⟩ := exists_appTop_π_eq_of_isLimit (opensDiagram D i U)
      (opensCone D c i U) (isLimitOpensCone D c hc i U) ((c.π.app i ⁻¹ᵁ U).topIso.inv.hom s)
    refine ⟨jO.left, jO.hom, (D.map jO.hom ⁻¹ᵁ U).topIso.hom.hom t', ?_⟩
    rw [opensCone_π_app] at ht'
    have e1 : (c.π.app i ⁻¹ᵁ U).topIso.hom.hom
        (((c.π.app jO.left).resLE (D.map jO.hom ⁻¹ᵁ U) (c.π.app i ⁻¹ᵁ U)
          (pre_w jO.hom U).ge).appTop.hom t') =
        ((c.π.app jO.left).appLE (D.map jO.hom ⁻¹ᵁ U) (c.π.app i ⁻¹ᵁ U)
          (pre_w jO.hom U).ge).hom ((D.map jO.hom ⁻¹ᵁ U).topIso.hom.hom t') := by
      exact congrArg (fun φ => CommRingCat.Hom.hom φ t') (resId (c.π.app jO.left)
        (D.map jO.hom ⁻¹ᵁ U) (c.π.app i ⁻¹ᵁ U) (pre_w jO.hom U).ge)
    have e2 : (c.π.app i ⁻¹ᵁ U).topIso.hom.hom ((c.π.app i ⁻¹ᵁ U).topIso.inv.hom s) = s := by
      rw [← CommRingCat.comp_apply, Iso.inv_hom_id, CommRingCat.id_apply]
    exact e1.symm.trans
      ((congrArg (fun x => (c.π.app i ⁻¹ᵁ U).topIso.hom.hom x) ht').symm.trans e2)

  have hunit : ∀ (i : I) (U : (D.obj i).Opens), IsCompact (U : Set (D.obj i)) →
      ∀ (O : c.pt.Opens), c.π.app i ⁻¹ᵁ U = O → ∀ u : (Γ(c.pt, O))ˣ,
      ∃ (j : I) (f : j ⟶ i) (T : (Γ(D.obj j, D.map f ⁻¹ᵁ U))ˣ),
        ∀ h : O ≤ c.π.app j ⁻¹ᵁ (D.map f ⁻¹ᵁ U),
          ((c.π.app j).appLE (D.map f ⁻¹ᵁ U) O h).hom (T : Γ(D.obj j, D.map f ⁻¹ᵁ U)) =
            (u : Γ(c.pt, O)) := by
    intro i U hU O hO
    subst hO
    intro u
    obtain ⟨j₁, f₁, t₁, ht₁⟩ := hsec i U hU u.val
    obtain ⟨j₂, f₂, t₂, ht₂⟩ := hsec i U hU u.inv
    obtain ⟨k, g₁, g₂, hk⟩ := IsCofiltered.cospan f₁ f₂
    have e₁ : D.map (g₁ ≫ f₁) ⁻¹ᵁ U ≤ D.map g₁ ⁻¹ᵁ (D.map f₁ ⁻¹ᵁ U) :=
      le_of_eq (by rw [D.map_comp g₁ f₁, Scheme.Hom.comp_preimage])
    have e₂ : D.map (g₁ ≫ f₁) ⁻¹ᵁ U ≤ D.map g₂ ⁻¹ᵁ (D.map f₂ ⁻¹ᵁ U) :=
      le_of_eq (by rw [hk, D.map_comp g₂ f₂, Scheme.Hom.comp_preimage])
    have hk' : c.π.app i ⁻¹ᵁ U ≤ c.π.app k ⁻¹ᵁ (D.map (g₁ ≫ f₁) ⁻¹ᵁ U) :=
      (pre_w (g₁ ≫ f₁) U).ge
    have h1 : ((c.π.app k).appLE _ _ hk').hom (((D.map g₁).appLE _ _ e₁).hom t₁) = u.val :=
      (coneLE g₁ _ _ e₁ _ (pre_w f₁ U).ge hk' t₁).trans ht₁
    have h2 : ((c.π.app k).appLE _ _ hk').hom (((D.map g₂).appLE _ _ e₂).hom t₂) = u.inv :=
      (coneLE g₂ _ _ e₂ _ (pre_w f₂ U).ge hk' t₂).trans ht₂
    set t₁' := ((D.map g₁).appLE _ _ e₁).hom t₁ with ht₁'
    set t₂' := ((D.map g₂).appLE _ _ e₂).hom t₂ with ht₂'
    have h12 : ((c.π.app k).appLE _ _ hk').hom (t₁' * t₂') =
        ((c.π.app k).appLE _ _ hk').hom 1 := by
      rw [map_mul, map_one, h1, h2, u.val_inv]
    have happ : ∀ x, ((c.π.app k).app (D.map (g₁ ≫ f₁) ⁻¹ᵁ U)).hom x =
        (c.pt.presheaf.map (homOfLE (pre_w (g₁ ≫ f₁) U).le).op).hom
          (((c.π.app k).appLE _ _ hk').hom x) := by
      intro x
      have hm := Scheme.Hom.appLE_map (c.π.app k) hk' (homOfLE (pre_w (g₁ ≫ f₁) U).le).op
      rw [Scheme.Hom.app_eq_appLE, ← hm]
      rfl
    have happ_eq : ((c.π.app k).app (D.map (g₁ ≫ f₁) ⁻¹ᵁ U)).hom (t₁' * t₂') =
        ((c.π.app k).app (D.map (g₁ ≫ f₁) ⁻¹ᵁ U)).hom 1 := by
      rw [happ, happ, h12]
    have hUk : IsCompact ((D.map (g₁ ≫ f₁) ⁻¹ᵁ U : (D.obj k).Opens) : Set (D.obj k)) :=
      (D.map (g₁ ≫ f₁)).isCompact_preimage hU
    obtain ⟨l, e, he⟩ := exists_app_map_eq_map_of_isLimit D c hc hUk (t₁' * t₂') 1 happ_eq
    have hel : D.map (e ≫ g₁ ≫ f₁) ⁻¹ᵁ U ≤ D.map e ⁻¹ᵁ (D.map (g₁ ≫ f₁) ⁻¹ᵁ U) :=
      le_of_eq (by rw [D.map_comp e (g₁ ≫ f₁), Scheme.Hom.comp_preimage])
    have hdecomp : ∀ x, ((D.map e).appLE _ _ hel).hom x =
        ((D.obj l).presheaf.map (homOfLE hel).op).hom (((D.map e).app _).hom x) := by
      intro x
      rw [← CommRingCat.comp_apply, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map]
    have hab : ((D.map e).appLE _ _ hel).hom t₁' * ((D.map e).appLE _ _ hel).hom t₂' = 1 := by
      rw [← map_mul, hdecomp, he, ← hdecomp, map_one]
    refine ⟨l, e ≫ g₁ ≫ f₁, ⟨((D.map e).appLE _ _ hel).hom t₁', ((D.map e).appLE _ _ hel).hom t₂',
      hab, (mul_comm _ _).trans hab⟩, fun h => ?_⟩
    exact (coneLE e _ _ hel _ hk' h t₁').trans h1

  obtain ⟨i₀, W, hWaff, hW⟩ : ∃ (i : I) (W : Fin L.m → (D.obj i).Opens),
      (∀ a, IsAffineOpen (W a)) ∧ ∀ a, c.π.app i ⁻¹ᵁ W a = L.V a := by
    choose iA WA hWA hpre using fun a => exists_isAffineOpen_preimage_eq D c hc (L.V a) (hV a)
    obtain ⟨i₀, hi₀⟩ := IsCofiltered.inf_objs_exists (Finset.univ.image iA)
    have t : ∀ a, Nonempty (i₀ ⟶ iA a) := fun a =>
      hi₀ (Finset.mem_image_of_mem iA (Finset.mem_univ a))
    refine ⟨i₀, fun a => D.map (t a).some ⁻¹ᵁ WA a, fun a => (hWA a).preimage _, fun a => ?_⟩
    show c.π.app i₀ ⁻¹ᵁ (D.map (t a).some ⁻¹ᵁ WA a) = L.V a
    rw [pre_w]
    exact hpre a
  have hWc : ∀ a b, IsCompact ((W a ⊓ W b : (D.obj i₀).Opens) : Set (D.obj i₀)) := by
    intro a b
    rw [TopologicalSpace.Opens.coe_inf]
    exact QuasiSeparatedSpace.inter_isCompact _ _ (W a).isOpen (hWaff a).isCompact
      (W b).isOpen (hWaff b).isCompact
  have hOk : ∀ a b, c.π.app i₀ ⁻¹ᵁ (W a ⊓ W b) = L.V a ⊓ L.V b := by
    intro a b
    rw [Scheme.Hom.preimage_inf, hW, hW]

  let P : Fin L.m × Fin L.m → ∀ j : I, (j ⟶ i₀) → Prop := fun p j f =>
    ∃ T : (Γ(D.obj j, D.map f ⁻¹ᵁ (W p.1 ⊓ W p.2)))ˣ,
      ∀ h : L.V p.1 ⊓ L.V p.2 ≤ c.π.app j ⁻¹ᵁ (D.map f ⁻¹ᵁ (W p.1 ⊓ W p.2)),
        ((c.π.app j).appLE _ _ h).hom (T : Γ(D.obj j, D.map f ⁻¹ᵁ (W p.1 ⊓ W p.2))) =
          (L.g p.1 p.2 : Γ(c.pt, L.V p.1 ⊓ L.V p.2))
  have hPst : ∀ p (j j' : I) (e : j' ⟶ j) (f : j ⟶ i₀), P p j f → P p j' (e ≫ f) := by
    rintro p j j' e f ⟨T, hT⟩
    have he : D.map (e ≫ f) ⁻¹ᵁ (W p.1 ⊓ W p.2) ≤ D.map e ⁻¹ᵁ (D.map f ⁻¹ᵁ (W p.1 ⊓ W p.2)) :=
      le_of_eq (by rw [D.map_comp e f, Scheme.Hom.comp_preimage])
    refine ⟨Units.map ((D.map e).appLE _ _ he).hom.toMonoidHom T, fun h => ?_⟩
    have h0 : L.V p.1 ⊓ L.V p.2 ≤ c.π.app j ⁻¹ᵁ (D.map f ⁻¹ᵁ (W p.1 ⊓ W p.2)) :=
      le_of_eq (by rw [pre_w, hOk])
    rw [← hT h0]
    exact coneLE e _ _ he _ h0 h _
  have hPex : ∀ p : Fin L.m × Fin L.m, ∃ (j : I) (f : j ⟶ i₀), P p j f := by
    intro p
    obtain ⟨j, f, T, hT⟩ := hunit i₀ (W p.1 ⊓ W p.2) (hWc p.1 p.2) (L.V p.1 ⊓ L.V p.2)
      (hOk p.1 p.2) (L.g p.1 p.2)
    exact ⟨j, f, T, hT⟩
  have hcommon : ∀ s : Finset (Fin L.m × Fin L.m), ∃ (j : I) (f : j ⟶ i₀), ∀ p ∈ s, P p j f := by
    intro s
    induction s using Finset.induction_on with
    | empty => exact ⟨i₀, 𝟙 i₀, fun p hp => by simp at hp⟩
    | insert p₀ s _ ih =>
      obtain ⟨j₁, f₁, h₁⟩ := ih
      obtain ⟨j₂, f₂, h₂⟩ := hPex p₀
      obtain ⟨l, g₁, g₂, hg⟩ := IsCofiltered.cospan f₁ f₂
      refine ⟨l, g₁ ≫ f₁, fun p hp => ?_⟩
      rcases Finset.mem_insert.mp hp with rfl | hp
      · rw [hg]; exact hPst _ _ _ g₂ f₂ h₂
      · exact hPst _ _ _ g₁ f₁ (h₁ p hp)
  obtain ⟨k, F, hall⟩ := hcommon Finset.univ
  have hall' : ∀ p : Fin L.m × Fin L.m, ∃ T : (Γ(D.obj k, D.map F ⁻¹ᵁ (W p.1 ⊓ W p.2)))ˣ,
      ∀ h : L.V p.1 ⊓ L.V p.2 ≤ c.π.app k ⁻¹ᵁ (D.map F ⁻¹ᵁ (W p.1 ⊓ W p.2)),
        ((c.π.app k).appLE _ _ h).hom (T : Γ(D.obj k, D.map F ⁻¹ᵁ (W p.1 ⊓ W p.2))) =
          (L.g p.1 p.2 : Γ(c.pt, L.V p.1 ⊓ L.V p.2)) := fun p => hall p (Finset.mem_univ p)
  choose T hT using hall'

  have pull_eq : ∀ {Y X : Scheme.{u}} (φ : Y ⟶ X) (m : ℕ) (V : Fin m → Y.Opens)
      (g : ∀ a b, (Γ(Y, V a ⊓ V b))ˣ) (W : Fin m → X.Opens),
      (∀ a, φ ⁻¹ᵁ W a = V a) → ∀ (t : ∀ a b, (Γ(X, W a ⊓ W b))ˣ),
      (∀ a b (h : V a ⊓ V b ≤ φ ⁻¹ᵁ (W a ⊓ W b)),
        (φ.appLE (W a ⊓ W b) (V a ⊓ V b) h).hom (t a b : Γ(X, W a ⊓ W b)) =
          (g a b : Γ(Y, V a ⊓ V b))) →
      wcpaDjCocPull φ (wcpaDjCoc.mk m W t) = wcpaDjCoc.mk m V g := by
    intro Y X φ m V g W hW t ht
    obtain rfl : V = fun a => φ ⁻¹ᵁ W a := (funext hW).symm
    unfold wcpaDjCocPull
    congr 1
    funext a b
    apply Units.ext
    exact ht a b _
  refine ⟨k, wcpaDjCoc.mk L.m (fun a => D.map F ⁻¹ᵁ W a) (fun a b => T (a, b)),
    fun a => (hWaff a).preimage _, ?_⟩
  exact pull_eq (c.π.app k) L.m L.V L.g (fun a => D.map F ⁻¹ᵁ W a)
    (fun a => (pre_w F (W a)).trans (hW a)) (fun a b => T (a, b)) (fun a b h => hT (a, b) h)

theorem wcpa_dj_lnm_coc_refine : ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (D : I ⥤ Scheme.{u}) (c : Limits.Cone D), Limits.IsLimit c → (∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f)) → (∀ i, CompactSpace (D.obj i)) → (∀ i, QuasiSeparatedSpace (D.obj i)) → ∀ (i : I) (L' : wcpaDjCoc (D.obj i)), (∀ a, IsAffineOpen (L'.V a)) → wcpaDjCocOK (wcpaDjCocPull (c.π.app i) L') → ∃ (j : I) (f : j ⟶ i), wcpaDjCocOK (wcpaDjCocPull (D.map f) L') :=
by
  classical
  intro I inst1 inst2 D c hc hA hC hQS i L' hL'aff hOK

  have red0 : ∀ {Y : Scheme.{u}} {U₁ U₂ U₃ : Y.Opens} (i : U₂ ≤ U₁) (j : U₃ ≤ U₂) (z : Γ(Y, U₁)),
      (Y.presheaf.map (homOfLE j).op).hom ((Y.presheaf.map (homOfLE i).op).hom z) =
        (Y.presheaf.map (homOfLE (j.trans i)).op).hom z := by
    intro Y U₁ U₂ U₃ i j z
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have red3 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) {U U' : Y.Opens} {V : X.Opens} (hU : U' ≤ U)
      (e : V ≤ f ⁻¹ᵁ U') (y : Γ(Y, U)),
      (X.presheaf.map (homOfLE e).op).hom ((f.app U').hom
          ((Y.presheaf.map (homOfLE hU).op).hom y)) =
        (X.presheaf.map (homOfLE (e.trans (fun x hx => hU hx))).op).hom ((f.app U).hom y) := by
    intro X Y f U U' V hU e y
    change (Y.presheaf.map (homOfLE hU).op ≫ f.app U' ≫ X.presheaf.map (homOfLE e).op).hom y =
      (f.app U ≫ X.presheaf.map (homOfLE (e.trans (fun x hx => hU hx))).op).hom y
    rw [Scheme.Hom.naturality_assoc, ← Functor.map_comp]
    rfl
  have idres : ∀ {Y : Scheme.{u}} (U : Y.Opens) (e : U ≤ U) (z : Γ(Y, U)),
      (Y.presheaf.map (homOfLE e).op).hom z = z := by
    intro Y U e z
    rw [show homOfLE e = 𝟙 U from Subsingleton.elim _ _, op_id, CategoryTheory.Functor.map_id]
    rfl
  have injres : ∀ {Y : Scheme.{u}} {A B : Y.Opens} (e : A ≤ B) (e' : B ≤ A) (z w : Γ(Y, B)),
      (Y.presheaf.map (homOfLE e).op).hom z = (Y.presheaf.map (homOfLE e).op).hom w → z = w := by
    intro Y A B e e' z w hzw
    have h1 := congrArg (Y.presheaf.map (homOfLE e').op).hom hzw
    rw [red0, red0, idres, idres] at h1
    exact h1
  have transfer : ∀ {Y' Y : Scheme.{u}} (h : Y' ⟶ Y) {U W : Y.Opens} (hWU : W ≤ U)
      {A B : Y'.Opens} (hBA : B ≤ A) (hA' : A ≤ h ⁻¹ᵁ U) (hB : B ≤ h ⁻¹ᵁ W) (y : Γ(Y, U)),
      (Y'.presheaf.map (homOfLE hBA).op).hom ((Y'.presheaf.map (homOfLE hA').op).hom
          ((h.app U).hom y)) =
        (Y'.presheaf.map (homOfLE hB).op).hom ((h.app W).hom
          ((Y.presheaf.map (homOfLE hWU).op).hom y)) := by
    intro Y' Y h U W hWU A B hBA hA' hB y
    rw [red0, red3]

  obtain ⟨xs, hxs⟩ : ∃ xs : ∀ a b d : Fin L'.m, Γ(D.obj i, L'.V a ⊓ L'.V b ⊓ L'.V d),
      ∀ a b d, xs a b d =
        ((D.obj i).presheaf.map (homOfLE (inf_le_left :
          L'.V a ⊓ L'.V b ⊓ L'.V d ≤ L'.V a ⊓ L'.V b)).op).hom (L'.g a b).val *
        ((D.obj i).presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
          L'.V a ⊓ L'.V b ⊓ L'.V d ≤ L'.V b ⊓ L'.V d)).op).hom (L'.g b d).val :=
    ⟨_, fun _ _ _ => rfl⟩
  obtain ⟨ys, hys⟩ : ∃ ys : ∀ a b d : Fin L'.m, Γ(D.obj i, L'.V a ⊓ L'.V b ⊓ L'.V d),
      ∀ a b d, ys a b d =
        ((D.obj i).presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
          L'.V a ⊓ L'.V b ⊓ L'.V d ≤ L'.V a ⊓ L'.V d)).op).hom (L'.g a d).val :=
    ⟨_, fun _ _ _ => rfl⟩

  have pull_iff : ∀ {Y' : Scheme.{u}} (h : Y' ⟶ D.obj i), (∀ a, IsAffineOpen (h ⁻¹ᵁ L'.V a)) →
      (wcpaDjCocOK (wcpaDjCocPull h L') ↔ (h ⁻¹ᵁ (⨆ a, L'.V a) = ⊤ ∧
        (∀ a, (h.app (L'.V a ⊓ L'.V a)).hom (L'.g a a).val =
          (h.app (L'.V a ⊓ L'.V a)).hom 1) ∧
        ∀ a b d, (h.app (L'.V a ⊓ L'.V b ⊓ L'.V d)).hom (xs a b d) =
          (h.app (L'.V a ⊓ L'.V b ⊓ L'.V d)).hom (ys a b d))) := by
    intro Y' h haff
    have e1 : ∀ a b d,
        (Y'.presheaf.map (homOfLE (inf_le_left :
          h ⁻¹ᵁ L'.V a ⊓ h ⁻¹ᵁ L'.V b ⊓ h ⁻¹ᵁ L'.V d ≤ h ⁻¹ᵁ L'.V a ⊓ h ⁻¹ᵁ L'.V b)).op).hom
          ((Y'.presheaf.map (homOfLE (show h ⁻¹ᵁ L'.V a ⊓ h ⁻¹ᵁ L'.V b ≤
            h ⁻¹ᵁ (L'.V a ⊓ L'.V b) from fun x hx => hx)).op).hom
            ((h.app (L'.V a ⊓ L'.V b)).hom (L'.g a b).val)) =
        (Y'.presheaf.map (homOfLE (show h ⁻¹ᵁ L'.V a ⊓ h ⁻¹ᵁ L'.V b ⊓ h ⁻¹ᵁ L'.V d ≤
            h ⁻¹ᵁ (L'.V a ⊓ L'.V b ⊓ L'.V d) from fun x hx => hx)).op).hom
          ((h.app (L'.V a ⊓ L'.V b ⊓ L'.V d)).hom
            (((D.obj i).presheaf.map (homOfLE (inf_le_left :
              L'.V a ⊓ L'.V b ⊓ L'.V d ≤ L'.V a ⊓ L'.V b)).op).hom (L'.g a b).val)) :=
      fun a b d => transfer h _ _ _ _ _
    have e2 : ∀ a b d,
        (Y'.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
          h ⁻¹ᵁ L'.V a ⊓ h ⁻¹ᵁ L'.V b ⊓ h ⁻¹ᵁ L'.V d ≤ h ⁻¹ᵁ L'.V b ⊓ h ⁻¹ᵁ L'.V d)).op).hom
          ((Y'.presheaf.map (homOfLE (show h ⁻¹ᵁ L'.V b ⊓ h ⁻¹ᵁ L'.V d ≤
            h ⁻¹ᵁ (L'.V b ⊓ L'.V d) from fun x hx => hx)).op).hom
            ((h.app (L'.V b ⊓ L'.V d)).hom (L'.g b d).val)) =
        (Y'.presheaf.map (homOfLE (show h ⁻¹ᵁ L'.V a ⊓ h ⁻¹ᵁ L'.V b ⊓ h ⁻¹ᵁ L'.V d ≤
            h ⁻¹ᵁ (L'.V a ⊓ L'.V b ⊓ L'.V d) from fun x hx => hx)).op).hom
          ((h.app (L'.V a ⊓ L'.V b ⊓ L'.V d)).hom
            (((D.obj i).presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
              L'.V a ⊓ L'.V b ⊓ L'.V d ≤ L'.V b ⊓ L'.V d)).op).hom (L'.g b d).val)) :=
      fun a b d => transfer h _ _ _ _ _
    have e3 : ∀ a b d,
        (Y'.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
          h ⁻¹ᵁ L'.V a ⊓ h ⁻¹ᵁ L'.V b ⊓ h ⁻¹ᵁ L'.V d ≤ h ⁻¹ᵁ L'.V a ⊓ h ⁻¹ᵁ L'.V d)).op).hom
          ((Y'.presheaf.map (homOfLE (show h ⁻¹ᵁ L'.V a ⊓ h ⁻¹ᵁ L'.V d ≤
            h ⁻¹ᵁ (L'.V a ⊓ L'.V d) from fun x hx => hx)).op).hom
            ((h.app (L'.V a ⊓ L'.V d)).hom (L'.g a d).val)) =
        (Y'.presheaf.map (homOfLE (show h ⁻¹ᵁ L'.V a ⊓ h ⁻¹ᵁ L'.V b ⊓ h ⁻¹ᵁ L'.V d ≤
            h ⁻¹ᵁ (L'.V a ⊓ L'.V b ⊓ L'.V d) from fun x hx => hx)).op).hom
          ((h.app (L'.V a ⊓ L'.V b ⊓ L'.V d)).hom
            (((D.obj i).presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
              L'.V a ⊓ L'.V b ⊓ L'.V d ≤ L'.V a ⊓ L'.V d)).op).hom (L'.g a d).val)) :=
      fun a b d => transfer h _ _ _ _ _
    constructor
    · rintro ⟨-, hcov, hid, hcoc⟩
      refine ⟨?_, ?_, ?_⟩
      · rw [Scheme.Hom.preimage_iSup]
        exact hcov
      · intro a
        apply injres (show h ⁻¹ᵁ L'.V a ⊓ h ⁻¹ᵁ L'.V a ≤ h ⁻¹ᵁ (L'.V a ⊓ L'.V a) from
          fun x hx => hx) (fun x hx => hx)
        rw [map_one, map_one]
        exact congrArg Units.val (hid a)
      · intro a b d
        apply injres (show h ⁻¹ᵁ L'.V a ⊓ h ⁻¹ᵁ L'.V b ⊓ h ⁻¹ᵁ L'.V d ≤
          h ⁻¹ᵁ (L'.V a ⊓ L'.V b ⊓ L'.V d) from fun x hx => hx) (fun x hx => hx)
        rw [hxs, hys, map_mul, map_mul, ← e1, ← e2, ← e3]
        exact hcoc a b d
    · rintro ⟨hcov, hid, hcoc⟩
      refine ⟨haff, ?_, ?_, ?_⟩
      · rw [Scheme.Hom.preimage_iSup] at hcov
        exact hcov
      · intro a
        apply Units.ext
        have h2 := congrArg (Y'.presheaf.map (homOfLE (show h ⁻¹ᵁ L'.V a ⊓ h ⁻¹ᵁ L'.V a ≤
          h ⁻¹ᵁ (L'.V a ⊓ L'.V a) from fun x hx => hx)).op).hom (hid a)
        rw [map_one, map_one] at h2
        exact h2
      · intro (a : Fin L'.m) (b : Fin L'.m) (d : Fin L'.m)
        have h2 := congrArg (Y'.presheaf.map (homOfLE (show h ⁻¹ᵁ L'.V a ⊓ h ⁻¹ᵁ L'.V b ⊓
          h ⁻¹ᵁ L'.V d ≤ h ⁻¹ᵁ (L'.V a ⊓ L'.V b ⊓ L'.V d) from fun x hx => hx)).op).hom
          (hcoc a b d)
        rw [hxs, hys, map_mul, map_mul, ← e1, ← e2, ← e3] at h2
        exact h2

  have sect : ∀ (U : (D.obj i).Opens), IsCompact (U : Set (D.obj i)) →
      ∀ s t : Γ(D.obj i, U), ((c.π.app i).app U).hom s = ((c.π.app i).app U).hom t →
      ∃ (j : I) (f : j ⟶ i), ∀ (k : I) (g : k ⟶ j),
        ((D.map (g ≫ f)).app U).hom s = ((D.map (g ≫ f)).app U).hom t := by
    intro U hU s t hst
    obtain ⟨j, f, hf⟩ :=
      @exists_app_map_eq_map_of_isLimit I _ D c hc _ (fun f => hA f) i U hU s t hst
    refine ⟨j, f, fun k g => ?_⟩
    rw [Functor.map_comp]
    exact congrArg ((D.map g).app (D.map f ⁻¹ᵁ U)).hom hf

  have cover : ∀ (U : (D.obj i).Opens), c.π.app i ⁻¹ᵁ U = ⊤ →
      ∃ (j : I) (f : j ⟶ i), ∀ (k : I) (g : k ⟶ j), D.map (g ≫ f) ⁻¹ᵁ U = ⊤ := by
    intro U hU
    obtain ⟨j, f, hf⟩ := @exists_map_eq_top I _ D c hc _ (fun f => hA f) hC i U hU
    exact ⟨j, f, fun k g => by
      rw [Functor.map_comp, Scheme.Hom.comp_preimage, hf, Scheme.Hom.preimage_top]⟩

  have combine : ∀ (ι : Type) [Fintype ι] (Q : ι → ∀ k : I, (k ⟶ i) → Prop),
      (∀ κ, ∃ (j : I) (f : j ⟶ i), ∀ (k : I) (g : k ⟶ j), Q κ k (g ≫ f)) →
      ∃ (j : I) (f : j ⟶ i), ∀ κ, Q κ j f := by
    intro ι _ Q hQ
    have key : ∀ s : Finset ι, ∃ (j : I) (f : j ⟶ i), ∀ κ ∈ s, ∀ (k : I) (g : k ⟶ j),
        Q κ k (g ≫ f) := by
      intro s
      induction s using Finset.induction_on with
      | empty => exact ⟨i, 𝟙 i, fun κ hκ => by simp at hκ⟩
      | insert κ₀ s _ ih =>
        obtain ⟨j₁, f₁, h₁⟩ := ih
        obtain ⟨j₂, f₂, h₂⟩ := hQ κ₀
        obtain ⟨k, g₁, g₂, hk⟩ := IsCofiltered.cospan f₁ f₂
        refine ⟨k, g₁ ≫ f₁, fun κ hκ k' g => ?_⟩
        rcases Finset.mem_insert.mp hκ with hκ | hκ
        · subst hκ
          rw [hk, ← Category.assoc]
          exact h₂ _ _
        · rw [← Category.assoc]
          exact h₁ κ hκ _ _
    obtain ⟨j, f, hf⟩ := key Finset.univ
    refine ⟨j, f, fun κ => ?_⟩
    have h1 := hf κ (Finset.mem_univ κ) j (𝟙 j)
    rwa [Category.id_comp] at h1

  haveI := hQS i
  have hc1 : ∀ a, IsCompact ((L'.V a : (D.obj i).Opens) : Set (D.obj i)) :=
    fun a => (hL'aff a).isCompact
  have hc2 : ∀ a b, IsCompact ((L'.V a ⊓ L'.V b : (D.obj i).Opens) : Set (D.obj i)) := by
    intro a b
    rw [TopologicalSpace.Opens.coe_inf]
    exact QuasiSeparatedSpace.inter_isCompact _ _ (L'.V a).isOpen (hc1 a) (L'.V b).isOpen (hc1 b)
  have hc3 : ∀ a b d, IsCompact ((L'.V a ⊓ L'.V b ⊓ L'.V d : (D.obj i).Opens) :
      Set (D.obj i)) := by
    intro a b d
    rw [TopologicalSpace.Opens.coe_inf]
    exact QuasiSeparatedSpace.inter_isCompact _ _ (L'.V a ⊓ L'.V b).isOpen (hc2 a b)
      (L'.V d).isOpen (hc1 d)

  have haffρ : ∀ a, IsAffineOpen (c.π.app i ⁻¹ᵁ L'.V a) := fun a => hOK.1 a
  obtain ⟨hcov, hid, hcoc⟩ := (pull_iff (c.π.app i) haffρ).mp hOK
  obtain ⟨j, f, hall⟩ := combine (Unit ⊕ (Fin L'.m ⊕ (Fin L'.m × Fin L'.m × Fin L'.m)))
    (Sum.elim (fun _ k f => D.map f ⁻¹ᵁ (⨆ a, L'.V a) = ⊤)
      (Sum.elim (fun a k f => ((D.map f).app (L'.V a ⊓ L'.V a)).hom (L'.g a a).val =
          ((D.map f).app (L'.V a ⊓ L'.V a)).hom 1)
        (fun p k f => ((D.map f).app (L'.V p.1 ⊓ L'.V p.2.1 ⊓ L'.V p.2.2)).hom
            (xs p.1 p.2.1 p.2.2) =
          ((D.map f).app (L'.V p.1 ⊓ L'.V p.2.1 ⊓ L'.V p.2.2)).hom (ys p.1 p.2.1 p.2.2))))
    (by
      rintro (u | a | ⟨a, b, d⟩)
      · exact cover _ hcov
      · exact sect _ (hc2 a a) _ _ (hid a)
      · exact sect _ (hc3 a b d) _ _ (hcoc a b d))
  have haff' : ∀ a, IsAffineOpen (D.map f ⁻¹ᵁ L'.V a) :=
    fun a => @IsAffineOpen.preimage _ _ _ (hL'aff a) (D.map f) (hA f)
  exact ⟨j, f, (pull_iff (D.map f) haff').mpr ⟨hall (Sum.inl ()),
    fun a => hall (Sum.inr (Sum.inl a)), fun a b d => hall (Sum.inr (Sum.inr (a, b, d)))⟩⟩

theorem wcpa_dj_lge_cbcm_flat_model : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (Y : Scheme.{u}) (q : Y ⟶ Spec (.of ↥W)) (L : wcpaDjCoc Y), wcpaDjSemistable q → wcpaDjCocOK L → ∃ (B : Type u) (_ : CommRing B) (_ : IsNoetherianRing B) (ψ : B →+* ↥W) (Y₀ : Scheme.{u}) (q₀ : Y₀ ⟶ Spec (.of B)) (φ : Y ⟶ Y₀) (L₀ : wcpaDjCoc Y₀), IsProper q₀ ∧ Flat q₀ ∧ IsPullback φ q q₀ (Spec.map (CommRingCat.ofHom ψ)) ∧ wcpaDjCocOK L₀ ∧ wcpaDjCocPull φ L₀ = L :=
by
  classical
  intro Ω _ W Y q L hss hOK
  haveI hqprop : IsProper q := hss.2.1
  have hqflat : Flat q := hss.1

  have red3 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) {U U' : Y.Opens} {V : X.Opens} (hU : U' ≤ U)
      (e : V ≤ f ⁻¹ᵁ U') (y : Γ(Y, U)),
      (X.presheaf.map (homOfLE e).op).hom ((f.app U').hom
          ((Y.presheaf.map (homOfLE hU).op).hom y)) =
        (X.presheaf.map (homOfLE (e.trans (fun x hx => hU hx))).op).hom ((f.app U).hom y) := by
    intro X Y f U U' V hU e y
    change (Y.presheaf.map (homOfLE hU).op ≫ f.app U' ≫ X.presheaf.map (homOfLE e).op).hom y =
      (f.app U ≫ X.presheaf.map (homOfLE (e.trans (fun x hx => hU hx))).op).hom y
    rw [Scheme.Hom.naturality_assoc, ← Functor.map_comp]
    rfl
  have pull_comp : ∀ {X Y W : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ W) (L : wcpaDjCoc W),
      wcpaDjCocPull f (wcpaDjCocPull g L) = wcpaDjCocPull (f ≫ g) L := by
    intro X Y W f g L
    simp only [wcpaDjCocPull]
    congr 1
    funext a b
    apply Units.ext
    exact red3 f _ _ _
  have red0 : ∀ {Y : Scheme.{u}} {U₁ U₂ U₃ : Y.Opens} (i : U₂ ≤ U₁) (j : U₃ ≤ U₂) (z : Γ(Y, U₁)),
      (Y.presheaf.map (homOfLE j).op).hom ((Y.presheaf.map (homOfLE i).op).hom z) =
        (Y.presheaf.map (homOfLE (j.trans i)).op).hom z := by
    intro Y U₁ U₂ U₃ i j z
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have pull_ok : ∀ {Y' Y : Scheme.{u}} (h : Y' ⟶ Y) (L : wcpaDjCoc Y),
      (∀ a, IsAffineOpen (h ⁻¹ᵁ L.V a)) → wcpaDjCocOK L → wcpaDjCocOK (wcpaDjCocPull h L) := by
    intro Y' Y h L haff hL
    obtain ⟨_, hcov, hid, hcoc⟩ := hL
    refine ⟨haff, ?_, ?_, ?_⟩
    · show ⨆ a, h ⁻¹ᵁ L.V a = ⊤
      rw [← Scheme.Hom.preimage_iSup, hcov, Scheme.Hom.preimage_top]
    · intro a
      show Units.map _ (L.g a a) = 1
      rw [hid a, map_one]
    · show ∀ a b c : Fin L.m, _
      intro a b c
      have H := congrArg (h.app (L.V a ⊓ L.V b ⊓ L.V c) ≫ Y'.presheaf.map (homOfLE
        (show h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ⊓ h ⁻¹ᵁ L.V c ≤ h ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ L.V c) from
          fun x hx => hx)).op).hom (hcoc a b c)
      rw [map_mul] at H
      simp only [CommRingCat.comp_apply, red3] at H
      show (Y'.presheaf.map (homOfLE _).op).hom ((Y'.presheaf.map (homOfLE _).op).hom
            ((h.app (L.V a ⊓ L.V b)).hom (L.g a b : Γ(Y, L.V a ⊓ L.V b)))) *
          (Y'.presheaf.map (homOfLE _).op).hom ((Y'.presheaf.map (homOfLE _).op).hom
            ((h.app (L.V b ⊓ L.V c)).hom (L.g b c : Γ(Y, L.V b ⊓ L.V c)))) =
        (Y'.presheaf.map (homOfLE _).op).hom ((Y'.presheaf.map (homOfLE _).op).hom
            ((h.app (L.V a ⊓ L.V c)).hom (L.g a c : Γ(Y, L.V a ⊓ L.V c))))
      exact (congrArg₂ (· * ·) (red0 _ _ _) (red0 _ _ _)).trans (H.trans (red0 _ _ _).symm)

  haveI hqfp : LocallyOfFinitePresentation q :=
    wcpa_dj_mn_flat_fp (Spec (.of ↥W)) Y q hqflat inferInstance

  obtain ⟨S₀, Y', hY, π, hYprop, hπ⟩ := wc_fet_lfp_model_over_subring ↥W
    (fun S => Subring.closure (S : Set ↥W))
    (fun S a ha => Subring.subset_closure (Finset.mem_coe.mpr ha)) Y q
  haveI := hYprop
  haveI hN0 : IsNoetherianRing ↥(Subring.closure ((S₀ : Finset ↥W) : Set ↥W)) :=
    is_noetherian_subring_closure _ (Finset.finite_toSet S₀)

  have hYlfp : LocallyOfFinitePresentation hY := by
    refine LocallyOfFinitePresentation.mk ?_
    intro U hU V hV e
    have hft := HasRingHomProperty.appLE @LocallyOfFiniteType hY inferInstance ⟨U, hU⟩ ⟨V, hV⟩ e
    haveI : IsNoetherianRing Γ(Spec (.of ↥(Subring.closure ((S₀ : Finset ↥W) : Set ↥W))), U) :=
      IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
    exact RingHom.FinitePresentation.of_finiteType.mp hft

  obtain ⟨E, ρ, hE, sE, ⟨hlim⟩, hAff, hCpt, hQS, -, -, -, hpbT, hpbS, -, -, -⟩ :=
    wc_ap_fp_model_limit_presentation ↥W Y q S₀ Y' hY π inferInstance inferInstance hYlfp hπ

  obtain ⟨i, L', hL'aff, hpull⟩ := wcpa_dj_lnm_coc_data (Finset ↥W)ᵒᵖ E (Limits.Cone.mk Y ρ) hlim
    hAff hCpt hQS L hOK.1

  obtain ⟨j, f, hOK''⟩ := wcpa_dj_lnm_coc_refine (Finset ↥W)ᵒᵖ E (Limits.Cone.mk Y ρ) hlim
    hAff hCpt hQS i L' hL'aff (by rw [hpull]; exact hOK)
  have hw0 : ρ.app j ≫ E.map f = ρ.app i := (Limits.Cone.mk Y ρ).w f
  have hL : wcpaDjCocPull (ρ.app j) (wcpaDjCocPull (E.map f) L') = L := by
    rw [pull_comp, hw0]
    exact hpull

  obtain ⟨S, hS, hflat⟩ := wcpa_dj_lsl_flat_level_scheme wcpa_dj_lsl_flat_level_ring ↥W S₀ Y' hY
    Y q π hπ hqflat

  set T' : Finset ↥W := j.unop ∪ S with hT'
  let g : (Opposite.op T' : (Finset ↥W)ᵒᵖ) ⟶ j :=
    (homOfLE (Finset.subset_union_left : j.unop ⊆ j.unop ∪ S)).op
  haveI hNB : IsNoetherianRing ↥(Subring.closure (((S₀ ∪ T' : Finset ↥W)) : Set ↥W)) :=
    is_noetherian_subring_closure _ (Finset.finite_toSet _)
  haveI : IsAffineHom (E.map g) := hAff g
  have hOK₀ := pull_ok (E.map g) (wcpaDjCocPull (E.map f) L')
    (fun a => (hOK''.1 a).preimage _) hOK''
  have hwg : ρ.app (Opposite.op T') ≫ E.map g = ρ.app j := (Limits.Cone.mk Y ρ).w g
  have hL₀ : wcpaDjCocPull (ρ.app (Opposite.op T'))
      (wcpaDjCocPull (E.map g) (wcpaDjCocPull (E.map f) L')) = L := by
    rw [pull_comp, hwg]
    exact hL
  have hprop : IsProper (hE T') :=
    MorphismProperty.of_isPullback (P := @IsProper) (hpbS T') hYprop
  have hsub : S ⊆ S₀ ∪ T' :=
    Finset.subset_union_right.trans Finset.subset_union_right
  have hT : Subring.closure (S : Set ↥W) ≤ Subring.closure ((S₀ ∪ T' : Finset ↥W) : Set ↥W) :=
    Subring.closure_mono (Finset.coe_subset.mpr hsub)
  have hfl : Flat (Limits.pullback.snd hY (Spec.map (CommRingCat.ofHom (Subring.inclusion
      (Subring.closure_mono (Finset.coe_subset.mpr
        (Finset.subset_union_left : S₀ ⊆ S₀ ∪ T'))))))) := hflat _ hT
  have hflat' : Flat (hE T') := by
    rw [← (hpbS T').isoPullback_hom_snd]
    infer_instance
  exact ⟨↥(Subring.closure (((S₀ ∪ T' : Finset ↥W)) : Set ↥W)), inferInstance, hNB,
    (Subring.closure (((S₀ ∪ T' : Finset ↥W)) : Set ↥W)).subtype, E.obj (Opposite.op T'), hE T',
    ρ.app (Opposite.op T'), _, hprop, hflat', hpbT T', hOK₀, hL₀⟩

theorem wcpa_dj_cfg_acd_sq_zero : ∀ (X : Scheme.{u}) (M : X.Modules) {m : ℕ} (V : Fin m → X.Opens) (O : X.Opens) (p : ℕ) (z : wcAcC M V O p), wcAcD M V O (p + 1) (wcAcD M V O p z) = 0 :=
by
  intro X M m V O p z

  have SV : ∀ {n : ℕ} (a : Fin (n + 1)) (x : Fin n),
      ((a.succAbove x : Fin (n + 1)) : ℕ) = if (x : ℕ) < (a : ℕ) then (x : ℕ) else (x : ℕ) + 1 := by
    intro n a x
    by_cases h : x.castSucc < a
    · rw [Fin.succAbove_of_castSucc_lt _ _ h]
      rw [Fin.lt_def, Fin.coe_castSucc] at h
      rw [if_pos h, Fin.coe_castSucc]
    · rw [Fin.succAbove_of_le_castSucc _ _ (not_lt.mp h)]
      rw [Fin.lt_def, Fin.coe_castSucc] at h
      rw [if_neg h, Fin.val_succ]

  let g : Fin (p + 3) × Fin (p + 2) → Fin (p + 3) × Fin (p + 2) := fun a =>
    if (a.2 : ℕ) < (a.1 : ℕ) then
      (⟨a.2, by have := a.2.isLt; omega⟩, ⟨a.1 - 1, by have := a.1.isLt; omega⟩)
    else (⟨a.2 + 1, by have := a.2.isLt; omega⟩, ⟨min a.1 (p + 1), by omega⟩)
  have hg1 : ∀ a : Fin (p + 3) × Fin (p + 2), (a.2 : ℕ) < (a.1 : ℕ) →
      ((g a).1 : ℕ) = a.2 ∧ ((g a).2 : ℕ) = a.1 - 1 := by
    intro a h
    have := a.2.isLt
    refine ⟨?_, ?_⟩ <;> (try simp [g, h]) <;> omega
  have hg2 : ∀ a : Fin (p + 3) × Fin (p + 2), ¬ (a.2 : ℕ) < (a.1 : ℕ) →
      ((g a).1 : ℕ) = a.2 + 1 ∧ ((g a).2 : ℕ) = a.1 := by
    intro a h
    have := a.2.isLt
    refine ⟨?_, ?_⟩ <;> (try simp [g, h]) <;> omega
  have gA : ∀ a : Fin (p + 3) × Fin (p + 2),
      (fun l : Fin (p + 1) => (g a).1.succAbove ((g a).2.succAbove l)) =
        fun l => a.1.succAbove (a.2.succAbove l) := by
    intro a
    funext l
    apply Fin.ext
    have h3 := a.1.isLt
    have h4 := a.2.isLt
    by_cases h : (a.2 : ℕ) < (a.1 : ℕ)
    · obtain ⟨e1, e2⟩ := hg1 a h
      simp only [SV, e1, e2]
      split_ifs <;> omega
    · obtain ⟨e1, e2⟩ := hg2 a h
      simp only [SV, e1, e2]
      split_ifs <;> omega
  have gB : ∀ a : Fin (p + 3) × Fin (p + 2),
      (-1 : ℤ) ^ ((g a).1 : ℕ) * (-1 : ℤ) ^ ((g a).2 : ℕ) =
        -((-1 : ℤ) ^ (a.1 : ℕ) * (-1 : ℤ) ^ (a.2 : ℕ)) := by
    intro a
    by_cases h : (a.2 : ℕ) < (a.1 : ℕ)
    · obtain ⟨e1, e2⟩ := hg1 a h
      rw [e1, e2]
      obtain ⟨n0, hn0⟩ : ∃ n0, (a.1 : ℕ) = n0 + 1 := ⟨(a.1 : ℕ) - 1, by omega⟩
      rw [hn0, Nat.add_sub_cancel, pow_succ]
      ring
    · obtain ⟨e1, e2⟩ := hg2 a h
      rw [e1, e2, pow_succ]
      ring
  have gC : ∀ a : Fin (p + 3) × Fin (p + 2), g a ≠ a := by
    intro a hc
    have hv : ((g a).1 : ℕ) = a.1 := by rw [hc]
    by_cases h : (a.2 : ℕ) < (a.1 : ℕ)
    · obtain ⟨e1, e2⟩ := hg1 a h
      omega
    · obtain ⟨e1, e2⟩ := hg2 a h
      omega
  have gD : ∀ a : Fin (p + 3) × Fin (p + 2), g (g a) = a := by
    intro a
    have h3 := a.1.isLt
    by_cases h : (a.2 : ℕ) < (a.1 : ℕ)
    · obtain ⟨e1, e2⟩ := hg1 a h
      have h' : ¬ ((g a).2 : ℕ) < ((g a).1 : ℕ) := by omega
      obtain ⟨f1, f2⟩ := hg2 (g a) h'
      refine Prod.ext (Fin.ext ?_) (Fin.ext ?_) <;> omega
    · obtain ⟨e1, e2⟩ := hg2 a h
      have h' : ((g a).2 : ℕ) < ((g a).1 : ℕ) := by omega
      obtain ⟨f1, f2⟩ := hg1 (g a) h'
      refine Prod.ext (Fin.ext ?_) (Fin.ext ?_) <;> omega

  have gE : ∀ a : Fin (p + 3) × Fin (p + 2),
      (Fin.succAboveOrderEmb (g a).2).trans (Fin.succAboveOrderEmb (g a).1) =
        (Fin.succAboveOrderEmb a.2).trans (Fin.succAboveOrderEmb a.1) := by
    intro a
    apply RelEmbedding.ext
    intro l
    simp only [RelEmbedding.trans_apply, Fin.succAboveOrderEmb_apply]
    exact congrFun (gA a) l

  have hres : ∀ (U1 U2 U3 : X.Opens) (h12 : U1 ≤ U2) (h23 : U2 ≤ U3) (x : Γ(M, U3)),
      (M.presheaf.map (homOfLE h12).op).hom ((M.presheaf.map (homOfLE h23).op).hom x) =
        (M.presheaf.map (homOfLE (h12.trans h23)).op).hom x := by
    intro U1 U2 U3 h12 h23 x
    have := congrArg (fun f => f.hom x) (M.presheaf.map_comp (homOfLE h23).op (homOfLE h12).op)
    exact this.symm
  funext a

  have s2 : ∀ F : (Fin (p + 1) ↪o Fin (p + 3)) → Γ(M, wcAcV V O a),
      ∑ j : Fin (p + 3), ∑ i : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ) * (-1 : ℤ) ^ (i : ℕ)) •
        F ((Fin.succAboveOrderEmb i).trans (Fin.succAboveOrderEmb j)) = 0 := by
    intro F
    rw [← Fintype.sum_prod_type' (f := fun (j : Fin (p + 3)) (i : Fin (p + 2)) =>
        ((-1 : ℤ) ^ (j : ℕ) * (-1 : ℤ) ^ (i : ℕ)) •
          F ((Fin.succAboveOrderEmb i).trans (Fin.succAboveOrderEmb j)))]
    refine Finset.sum_involution (fun a _ => g a) ?_ ?_ ?_ ?_
    · intro b _
      show ((-1 : ℤ) ^ (b.1 : ℕ) * (-1 : ℤ) ^ (b.2 : ℕ)) •
          F ((Fin.succAboveOrderEmb b.2).trans (Fin.succAboveOrderEmb b.1)) +
        ((-1 : ℤ) ^ ((g b).1 : ℕ) * (-1 : ℤ) ^ ((g b).2 : ℕ)) •
          F ((Fin.succAboveOrderEmb (g b).2).trans (Fin.succAboveOrderEmb (g b).1)) = 0
      rw [gE b, gB b, neg_smul, add_neg_cancel]
    · intro b _ _
      exact gC b
    · intro b _
      exact Finset.mem_univ _
    · intro b _
      exact gD b
  refine Eq.trans ?_ (s2 (fun e => (M.presheaf.map (homOfLE (show wcAcV V O a ≤
      wcAcV V O (e.trans a) from
      inf_le_inf_right O (le_iInf fun l => iInf_le (fun k => V (a k)) (e l)))).op).hom
      (z (e.trans a))))
  simp only [wcAcD, AddMonoidHom.coe_mk, ZeroHom.coe_mk]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [map_sum, Finset.smul_sum]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [map_zsmul, smul_smul]
  congr 1
  exact hres _ _ _ _ _ _

theorem wcpa_dj_cfg_two_of_three : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (X : Scheme.{u}) (h : X ⟶ Spec (.of B)) {m : ℕ} (V : Fin m → X.Opens) (S : ShortComplex X.Modules), (∀ (N : X.Modules) (p : ℕ) (z : wcAcC N V ⊤ p), wcAcD N V ⊤ (p + 1) (wcAcD N V ⊤ p z) = 0) → (∀ U : X.Opens, Function.Injective (Scheme.Modules.Hom.app S.f U)) → (∀ (U : X.Opens) (y : Γ(S.X₂, U)), Scheme.Modules.Hom.app S.g U y = 0 → ∃ x, Scheme.Modules.Hom.app S.f U x = y) → (∀ (p : ℕ) (a : Fin (p + 1) ↪o Fin m), Function.Surjective (Scheme.Modules.Hom.app S.g (wcAcV V ⊤ a))) → (wcAcFG B X h S.X₁ V → wcAcFG B X h S.X₃ V → wcAcFG B X h S.X₂ V) ∧ (wcAcFG B X h S.X₂ V → wcAcFG B X h S.X₃ V → wcAcFG B X h S.X₁ V) :=
by
  intro B _ _ X h m V S hdd hinj hex hsurj
  classical



  have L1 : ∀ (M Q : Type u) [AddCommGroup M] [Module B M] [AddCommGroup Q] [Module B Q]
      (g : M →ₗ[B] Q) (Z : Submodule B M) (R : Submodule B Q) (k : ℕ) (c : Fin k → Q),
      (∀ z ∈ Z, g z ∈ Submodule.span B (Set.range c) ⊔ R) →
      ∃ (m : ℕ) (e : Fin m → M), (∀ j, e j ∈ Z) ∧
        ∀ z ∈ Z, ∃ (β : Fin m → B) (ρ : Q), ρ ∈ R ∧ g z = ∑ j, β j • g (e j) + ρ := by
    intro M Q _ _ _ _ g Z R k c hZ
    have hT : ((Submodule.span B (Set.range c)).map R.mkQ).FG :=
      (Submodule.fg_span (Set.finite_range c)).map _
    have hle : Z.map (R.mkQ ∘ₗ g) ≤ (Submodule.span B (Set.range c)).map R.mkQ := by
      rintro _ ⟨z, hz, rfl⟩
      obtain ⟨t, ht, ρ, hρ, he⟩ := Submodule.mem_sup.mp (hZ z hz)
      refine ⟨t, ht, ?_⟩
      have h0 : R.mkQ ρ = 0 := by
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]; exact hρ
      rw [LinearMap.comp_apply, ← he, map_add, h0, add_zero]
    obtain ⟨m, s, hs⟩ := Submodule.fg_iff_exists_fin_generating_family.mp (hT.of_le hle)
    have hsN : ∀ j, s j ∈ Z.map (R.mkQ ∘ₗ g) := fun j => hs ▸ Submodule.subset_span ⟨j, rfl⟩
    choose e he hes using fun j => Submodule.mem_map.mp (hsN j)
    refine ⟨m, e, he, fun z hz => ?_⟩
    have hzN : R.mkQ (g z) ∈ Submodule.span B (Set.range s) := by
      rw [hs]; exact ⟨z, hz, rfl⟩
    obtain ⟨β, hβ⟩ := (Submodule.mem_span_range_iff_exists_fun B).mp hzN
    refine ⟨β, g z - ∑ j, β j • g (e j), ?_, by abel⟩
    have h1 : R.mkQ (g z - ∑ j, β j • g (e j)) = 0 := by
      rw [map_sub, map_sum, ← hβ]
      simp only [LinearMap.map_smul]
      rw [sub_eq_zero]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [← hes j, LinearMap.comp_apply]
    rwa [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h1
  have span_sum : ∀ {N : Type u} [AddCommGroup N] [Module B N] {k : ℕ} (c : Fin k → N)
      (b : Fin k → B), ∑ l, b l • c l ∈ Submodule.span B (Set.range c) :=
    fun c b => (Submodule.mem_span_range_iff_exists_fun B).mpr ⟨b, rfl⟩



  have dirA : ∀ (A C D : ℕ → Type u) [∀ n, AddCommGroup (A n)] [∀ n, Module B (A n)] [∀ n, AddCommGroup (C n)] [∀ n, Module B (C n)] [∀ n, AddCommGroup (D n)] [∀ n, Module B (D n)] (dA : ∀ n, A n →ₗ[B] A (n + 1)) (dC : ∀ n, C n →ₗ[B] C (n + 1)) (dD : ∀ n, D n →ₗ[B] D (n + 1)) (f : ∀ n, A n →ₗ[B] C n) (g : ∀ n, C n →ₗ[B] D n), (∀ n x, f (n + 1) (dA n x) = dC n (f n x)) → (∀ n x, g (n + 1) (dC n x) = dD n (g n x)) → (∀ n x, dC (n + 1) (dC n x) = 0) → (∀ n x, g n (f n x) = 0) → (∀ n, Function.Injective (f n)) → (∀ n y, g n y = 0 → ∃ x, f n x = y) → (∀ n, Function.Surjective (g n)) → ((∃ (k : ℕ) (c : Fin k → A 0), (∀ i, dA 0 (c i) = 0) ∧ ∀ z, dA 0 z = 0 → ∃ b : Fin k → B, z = ∑ i, b i • c i) ∧ ∀ p : ℕ, ∃ (k : ℕ) (c : Fin k → A (p + 1)), (∀ i, dA (p + 1) (c i) = 0) ∧ ∀ z, dA (p + 1) z = 0 → ∃ (b : Fin k → B) (x : A p), z = ∑ i, b i • c i + dA p x) → ((∃ (k : ℕ) (c : Fin k → D 0), (∀ i, dD 0 (c i) = 0) ∧ ∀ z, dD 0 z = 0 → ∃ b : Fin k → B, z = ∑ i, b i • c i) ∧ ∀ p : ℕ, ∃ (k : ℕ) (c : Fin k → D (p + 1)), (∀ i, dD (p + 1) (c i) = 0) ∧ ∀ z, dD (p + 1) z = 0 → ∃ (b : Fin k → B) (x : D p), z = ∑ i, b i • c i + dD p x) → ((∃ (k : ℕ) (c : Fin k → C 0), (∀ i, dC 0 (c i) = 0) ∧ ∀ z, dC 0 z = 0 → ∃ b : Fin k → B, z = ∑ i, b i • c i) ∧ ∀ p : ℕ, ∃ (k : ℕ) (c : Fin k → C (p + 1)), (∀ i, dC (p + 1) (c i) = 0) ∧ ∀ z, dC (p + 1) z = 0 → ∃ (b : Fin k → B) (x : C p), z = ∑ i, b i • c i + dC p x) := by
    intro A C D _ _ _ _ _ _ dA dC dD f g Hf Hg Hdd Hgf Hinj Hex Hsurj hA hD
    constructor
    · obtain ⟨kA, cA, hcA, HA⟩ := hA.1
      obtain ⟨kD, cD, hcD, HD⟩ := hD.1
      obtain ⟨me, e, he, hL⟩ := L1 (C 0) (D 0) (g 0) (LinearMap.ker (dC 0)) ⊥ kD cD (by
        intro z hz
        rw [LinearMap.mem_ker] at hz
        obtain ⟨b, hb⟩ := HD (g 0 z) (by rw [← Hg, hz, map_zero])
        rw [hb]; exact Submodule.mem_sup_left (span_sum cD b))
      have he' : ∀ j, dC 0 (e j) = 0 := fun j => LinearMap.mem_ker.mp (he j)
      refine ⟨me + kA, Fin.append e (fun l => f 0 (cA l)), ?_, fun z hz => ?_⟩
      · intro i
        refine Fin.addCases ?_ ?_ i
        · intro j; simp only [Fin.append_left]; exact he' j
        · intro l; simp only [Fin.append_right]; rw [← Hf, hcA, map_zero]
      · obtain ⟨β, ρ, hρ, hgz⟩ := hL z (LinearMap.mem_ker.mpr hz)
        rw [Submodule.mem_bot] at hρ
        subst hρ
        obtain ⟨a, ha⟩ := Hex 0 (z - ∑ j, β j • e j) (by
          rw [map_sub, map_sum, hgz, add_zero]; simp only [map_smul, sub_self])
        have hda : dA 0 a = 0 := by
          apply Hinj (0 + 1)
          rw [Hf, ha, map_zero, map_sub, map_sum, hz]
          simp only [map_smul, he', smul_zero, Finset.sum_const_zero, sub_zero]
        obtain ⟨b, hb⟩ := HA a hda
        refine ⟨Fin.append β b, ?_⟩
        rw [Fin.sum_univ_add]
        simp only [Fin.append_left, Fin.append_right]
        have hfa : f 0 a = ∑ l, b l • f 0 (cA l) := by rw [hb, map_sum]; simp only [map_smul]
        rw [← hfa, ha]; abel
    · intro p
      obtain ⟨kA, cA, hcA, HA⟩ := hA.2 p
      obtain ⟨kD, cD, hcD, HD⟩ := hD.2 p
      obtain ⟨me, e, he, hL⟩ := L1 (C (p + 1)) (D (p + 1)) (g (p + 1)) (LinearMap.ker (dC (p + 1)))
          (LinearMap.range (dD p)) kD cD (by
        intro z hz
        rw [LinearMap.mem_ker] at hz
        obtain ⟨b, w, hb⟩ := HD (g (p + 1) z) (by rw [← Hg, hz, map_zero])
        rw [hb]; exact Submodule.add_mem_sup (span_sum cD b) (LinearMap.mem_range_self (dD p) w))
      have he' : ∀ j, dC (p + 1) (e j) = 0 := fun j => LinearMap.mem_ker.mp (he j)
      refine ⟨me + kA, Fin.append e (fun l => f (p + 1) (cA l)), ?_, fun z hz => ?_⟩
      · intro i
        refine Fin.addCases ?_ ?_ i
        · intro j; simp only [Fin.append_left]; exact he' j
        · intro l; simp only [Fin.append_right]; rw [← Hf, hcA, map_zero]
      · obtain ⟨β, ρ, hρ, hgz⟩ := hL z (LinearMap.mem_ker.mpr hz)
        obtain ⟨t, rfl⟩ := LinearMap.mem_range.mp hρ
        obtain ⟨t', rfl⟩ := Hsurj p t
        obtain ⟨a, ha⟩ := Hex (p + 1) (z - ∑ j, β j • e j - dC p t') (by
          rw [map_sub, map_sub, map_sum, hgz, Hg]; simp only [map_smul]; abel)
        have hda : dA (p + 1) a = 0 := by
          apply Hinj (p + 1 + 1)
          rw [Hf, ha, map_zero, map_sub, map_sub, map_sum, hz, Hdd]
          simp only [map_smul, he', smul_zero, Finset.sum_const_zero, sub_zero]
        obtain ⟨b, w, hb⟩ := HA a hda
        refine ⟨Fin.append β b, t' + f p w, ?_⟩
        rw [Fin.sum_univ_add]
        simp only [Fin.append_left, Fin.append_right]
        have hfa : f (p + 1) a = ∑ l, b l • f (p + 1) (cA l) + dC p (f p w) := by
          rw [hb, map_add, map_sum, Hf]; simp only [map_smul]
        have hz' : z = ∑ j, β j • e j + dC p t' + f (p + 1) a := by rw [ha]; abel
        rw [map_add, hz', hfa]; abel



  have dirB : ∀ (A C D : ℕ → Type u) [∀ n, AddCommGroup (A n)] [∀ n, Module B (A n)] [∀ n, AddCommGroup (C n)] [∀ n, Module B (C n)] [∀ n, AddCommGroup (D n)] [∀ n, Module B (D n)] (dA : ∀ n, A n →ₗ[B] A (n + 1)) (dC : ∀ n, C n →ₗ[B] C (n + 1)) (dD : ∀ n, D n →ₗ[B] D (n + 1)) (f : ∀ n, A n →ₗ[B] C n) (g : ∀ n, C n →ₗ[B] D n), (∀ n x, f (n + 1) (dA n x) = dC n (f n x)) → (∀ n x, g (n + 1) (dC n x) = dD n (g n x)) → (∀ n x, dC (n + 1) (dC n x) = 0) → (∀ n x, g n (f n x) = 0) → (∀ n, Function.Injective (f n)) → (∀ n y, g n y = 0 → ∃ x, f n x = y) → (∀ n, Function.Surjective (g n)) → ((∃ (k : ℕ) (c : Fin k → C 0), (∀ i, dC 0 (c i) = 0) ∧ ∀ z, dC 0 z = 0 → ∃ b : Fin k → B, z = ∑ i, b i • c i) ∧ ∀ p : ℕ, ∃ (k : ℕ) (c : Fin k → C (p + 1)), (∀ i, dC (p + 1) (c i) = 0) ∧ ∀ z, dC (p + 1) z = 0 → ∃ (b : Fin k → B) (x : C p), z = ∑ i, b i • c i + dC p x) → ((∃ (k : ℕ) (c : Fin k → D 0), (∀ i, dD 0 (c i) = 0) ∧ ∀ z, dD 0 z = 0 → ∃ b : Fin k → B, z = ∑ i, b i • c i) ∧ ∀ p : ℕ, ∃ (k : ℕ) (c : Fin k → D (p + 1)), (∀ i, dD (p + 1) (c i) = 0) ∧ ∀ z, dD (p + 1) z = 0 → ∃ (b : Fin k → B) (x : D p), z = ∑ i, b i • c i + dD p x) → ((∃ (k : ℕ) (c : Fin k → A 0), (∀ i, dA 0 (c i) = 0) ∧ ∀ z, dA 0 z = 0 → ∃ b : Fin k → B, z = ∑ i, b i • c i) ∧ ∀ p : ℕ, ∃ (k : ℕ) (c : Fin k → A (p + 1)), (∀ i, dA (p + 1) (c i) = 0) ∧ ∀ z, dA (p + 1) z = 0 → ∃ (b : Fin k → B) (x : A p), z = ∑ i, b i • c i + dA p x) := by
    intro A C D _ _ _ _ _ _ dA dC dD f g Hf Hg Hdd Hgf Hinj Hex Hsurj hC hD

    have UD : ∀ n : ℕ, ∃ (k : ℕ) (t : Fin k → D n), (∀ u, dD n (t u) = 0) ∧
        ∀ y, dD n y = 0 → ∃ (γ : Fin k → B) (ρ : C n), dC n ρ = 0 ∧ y = ∑ u, γ u • t u + g n ρ := by
      intro n
      cases n with
      | zero =>
        obtain ⟨k, t, ht, Ht⟩ := hD.1
        refine ⟨k, t, ht, fun y hy => ?_⟩
        obtain ⟨γ, hγ⟩ := Ht y hy
        exact ⟨γ, 0, map_zero _, by rw [map_zero, add_zero]; exact hγ⟩
      | succ p' =>
        obtain ⟨k, t, ht, Ht⟩ := hD.2 p'
        refine ⟨k, t, ht, fun y hy => ?_⟩
        obtain ⟨γ, s, hγ⟩ := Ht y hy
        obtain ⟨s', rfl⟩ := Hsurj p' s
        exact ⟨γ, dC p' s', Hdd p' s', by rw [Hg]; exact hγ⟩
    constructor
    · obtain ⟨kC, cC, -, HC⟩ := hC.1
      obtain ⟨me, e, he, hL⟩ := L1 (A 0) (C 0) (f 0) (LinearMap.ker (dA 0)) ⊥ kC cC (by
        intro z hz
        rw [LinearMap.mem_ker] at hz
        obtain ⟨b, hb⟩ := HC (f 0 z) (by rw [← Hf, hz, map_zero])
        rw [hb]; exact Submodule.mem_sup_left (span_sum cC b))
      refine ⟨me, e, fun j => LinearMap.mem_ker.mp (he j), fun z hz => ?_⟩
      obtain ⟨β, ρ, hρ, hfz⟩ := hL z (LinearMap.mem_ker.mpr hz)
      rw [Submodule.mem_bot] at hρ
      subst hρ
      refine ⟨β, Hinj 0 ?_⟩
      rw [hfz, add_zero, map_sum]; simp only [map_smul]
    · intro p
      obtain ⟨kC, cC, -, HC⟩ := hC.2 p
      obtain ⟨me, e, he, hL⟩ := L1 (A (p + 1)) (C (p + 1)) (f (p + 1)) (LinearMap.ker (dA (p + 1)))
          (LinearMap.range (dC p)) kC cC (by
        intro z hz
        rw [LinearMap.mem_ker] at hz
        obtain ⟨b, w, hb⟩ := HC (f (p + 1) z) (by rw [← Hf, hz, map_zero])
        rw [hb]; exact Submodule.add_mem_sup (span_sum cC b) (LinearMap.mem_range_self (dC p) w))
      obtain ⟨n, t, ht, HUD⟩ := UD p
      choose w hw using fun u => Hsurj p (t u)
      have hy : ∀ u, g (p + 1) (dC p (w u)) = 0 := fun u => by rw [Hg, hw, ht]
      choose y hy' using fun u => Hex (p + 1) _ (hy u)
      have hycoc : ∀ u, dA (p + 1) (y u) = 0 := fun u => by
        apply Hinj (p + 1 + 1)
        rw [Hf, hy', Hdd, map_zero]
      refine ⟨me + n, Fin.append e y, ?_, fun z hz => ?_⟩
      · intro i
        refine Fin.addCases ?_ ?_ i
        · intro j; simp only [Fin.append_left]; exact LinearMap.mem_ker.mp (he j)
        · intro u; simp only [Fin.append_right]; exact hycoc u
      · obtain ⟨β, ρ, hρ, hfz⟩ := hL z (LinearMap.mem_ker.mpr hz)
        obtain ⟨v, rfl⟩ := LinearMap.mem_range.mp hρ
        have hgv : dD p (g p v) = 0 := by
          rw [← Hg]
          have hv : dC p v = f (p + 1) (z - ∑ j, β j • e j) := by
            rw [map_sub, hfz, map_sum]; simp only [map_smul]; abel
          rw [hv, Hgf]
        obtain ⟨γ, ρ', hρ', hγ⟩ := HUD (g p v) hgv
        obtain ⟨a, ha⟩ := Hex p (v - ∑ u, γ u • w u - ρ') (by
          rw [map_sub, map_sub, map_sum, hγ]; simp only [map_smul, hw]; abel)
        refine ⟨Fin.append β γ, a, ?_⟩
        rw [Fin.sum_univ_add]
        simp only [Fin.append_left, Fin.append_right]
        apply Hinj (p + 1)
        simp only [map_add, map_sum, map_sub, map_smul, Hf, ha, hy', hρ', sub_zero]
        rw [hfz]; abel



  letI inst : ∀ (K : X.Modules) (W : X.Opens), Module B Γ(K, W) := fun K W =>
    Module.compHom Γ(K, W) (wcCnSigma h W)
  have hσres : ∀ (W W' : X.Opens) (hle : W' ≤ W) (b : B),
      X.presheaf.map (homOfLE hle).op (wcCnSigma h W b) = wcCnSigma h W' b := by
    intro W W' hle b
    show (X.presheaf.map (homOfLE hle).op) ((X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op)
      ((h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom) b)) =
      (X.presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op)
      ((h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom) b)
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have hnat : ∀ (M N : X.Modules) (φ : M ⟶ N) (W W' : X.Opens) (hle : W' ≤ W) (x : Γ(M, W)),
      Scheme.Modules.Hom.app φ W' (M.presheaf.map (homOfLE hle).op x) =
        N.presheaf.map (homOfLE hle).op (Scheme.Modules.Hom.app φ W x) :=
    fun M N φ W W' hle x => PresheafOfModules.naturality_apply φ.val (homOfLE hle).op x
  have hres_smul : ∀ (K : X.Modules) (W W' : X.Opens) (hle : W' ≤ W) (b : B) (x : Γ(K, W)),
      K.presheaf.map (homOfLE hle).op (wcCnSigma h W b • x) =
        wcCnSigma h W' b • K.presheaf.map (homOfLE hle).op x := by
    intro K W W' hle b x
    rw [Scheme.Modules.map_smul, hσres]
  let dL : ∀ (K : X.Modules) (n : ℕ), wcAcC K V ⊤ n →ₗ[B] wcAcC K V ⊤ (n + 1) := fun K n =>
    { toFun := wcAcD K V ⊤ n
      map_add' := map_add _
      map_smul' := fun b z => by
        funext a
        show wcAcD K V ⊤ n (fun a => wcCnSigma h (wcAcV V ⊤ a) b • z a) a =
          wcCnSigma h (wcAcV V ⊤ a) b • wcAcD K V ⊤ n z a
        simp only [wcAcD, AddMonoidHom.coe_mk, ZeroHom.coe_mk]
        rw [Finset.smul_sum]
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [smul_comm]
        congr 1
        exact hres_smul K _ _ _ b _ }
  let cm : ∀ (M N : X.Modules), (M ⟶ N) → ∀ n : ℕ, wcAcC M V ⊤ n →ₗ[B] wcAcC N V ⊤ n :=
    fun M N φ n =>
    { toFun := fun z a => Scheme.Modules.Hom.app φ (wcAcV V ⊤ a) (z a)
      map_add' := fun z z' => funext fun a => map_add _ _ _
      map_smul' := fun b z => funext fun a =>
        Scheme.Modules.Hom.app_smul φ (wcCnSigma h (wcAcV V ⊤ a) b) (z a) }
  have hcm : ∀ (M N : X.Modules) (φ : M ⟶ N) (n : ℕ) (z : wcAcC M V ⊤ n),
      cm M N φ (n + 1) (dL M n z) = dL N n (cm M N φ n z) := by
    intro M N φ n z
    funext a
    show Scheme.Modules.Hom.app φ (wcAcV V ⊤ a) (wcAcD M V ⊤ n z a) =
      wcAcD N V ⊤ n (fun a => Scheme.Modules.Hom.app φ (wcAcV V ⊤ a) (z a)) a
    simp only [wcAcD, AddMonoidHom.coe_mk, ZeroHom.coe_mk, map_sum, map_zsmul]
    refine Finset.sum_congr rfl fun k _ => ?_
    congr 1
    exact hnat M N φ _ _ _ _
  have hzero : ∀ (W : X.Opens) (y : Γ(S.X₁, W)),
      Scheme.Modules.Hom.app S.g W (Scheme.Modules.Hom.app S.f W y) = 0 := by
    intro W y
    rw [← ConcreteCategory.comp_apply, ← Scheme.Modules.Hom.comp_app, S.zero,
      Scheme.Modules.Hom.zero_app]
    rfl
  have Hdd : ∀ n x, dL S.X₂ (n + 1) (dL S.X₂ n x) = 0 := fun n x => hdd S.X₂ n x
  have Hgf : ∀ n x, cm _ _ S.g n (cm _ _ S.f n x) = 0 := fun n x => funext fun a => hzero _ (x a)
  have Hinj : ∀ n, Function.Injective (cm _ _ S.f n) := fun n x y hxy =>
    funext fun a => hinj _ (congrFun hxy a)
  have Hex : ∀ n y, cm _ _ S.g n y = 0 → ∃ x, cm _ _ S.f n x = y := by
    intro n y hy
    choose x hx using fun a => hex _ (y a) (congrFun hy a)
    exact ⟨x, funext hx⟩
  have Hsurj : ∀ n, Function.Surjective (cm _ _ S.g n) := by
    intro n y
    choose x hx using fun a => hsurj n a (y a)
    exact ⟨x, funext hx⟩
  refine ⟨fun hA hD => ?_, fun hC hD => ?_⟩
  · exact dirA (fun n => wcAcC S.X₁ V ⊤ n) (fun n => wcAcC S.X₂ V ⊤ n) (fun n => wcAcC S.X₃ V ⊤ n)
      (dL S.X₁) (dL S.X₂) (dL S.X₃) (cm _ _ S.f) (cm _ _ S.g) (hcm _ _ S.f) (hcm _ _ S.g)
      Hdd Hgf Hinj Hex Hsurj hA hD
  · exact dirB (fun n => wcAcC S.X₁ V ⊤ n) (fun n => wcAcC S.X₂ V ⊤ n) (fun n => wcAcC S.X₃ V ⊤ n)
      (dL S.X₁) (dL S.X₂) (dL S.X₃) (cm _ _ S.f) (cm _ _ S.g) (hcm _ _ S.f) (hcm _ _ S.g)
      Hdd Hgf Hinj Hex Hsurj hC hD

theorem wcpa_dj_cfg_twist_transport : ∀ (B : Type u) [CommRing B] (Y : Scheme.{u}) (q : Y ⟶ Spec (.of B)) (L : wcpaDjCoc Y) (e : ℕ) (G : Y.Modules) (φ : ∀ (a : Fin L.m) (O : Y.Opens), O ≤ L.V a → (Γ(G, O) →+ Γ(wcStructMod Y, O))), (∀ a O h, Function.Bijective (φ a O h)) → (∀ a O h (s : Γ(Y, O)) (x : Γ(G, O)), φ a O h (s • x) = s • φ a O h x) → (∀ a O O' (h : O ≤ L.V a) (h' : O' ≤ O) (x : Γ(G, O)), φ a O' (h'.trans h) ((G.presheaf.map (homOfLE h').op).hom x) = ((wcStructMod Y).presheaf.map (homOfLE h').op).hom (φ a O h x)) → (∀ a b O (ha : O ≤ L.V a) (hb : O ≤ L.V b) (x : Γ(G, O)), φ b O hb x = ((Y.presheaf.map (homOfLE (le_inf ha hb)).op).hom (L.g a b : Γ(Y, L.V a ⊓ L.V b))) ^ e • φ a O ha x) → wcAcFG B Y q G L.V → wcCbcmFG q L e :=
by
  intro B _ Y q L e G φ hbij hlin hres htr hP

  have hmap : ∀ (a : Fin L.m) (O : Y.Opens) (h : O ≤ L.V a) {ι : Type} (s : Finset ι)
      (f : ι → Γ(G, O)), (φ a O h (∑ i ∈ s, f i) : Γ(Y, O)) = ∑ i ∈ s, (φ a O h (f i) : Γ(Y, O)) :=
    fun a O h _ s f => map_sum (φ a O h) f s
  have hzs : ∀ (a : Fin L.m) (O : Y.Opens) (h : O ≤ L.V a) (n : ℤ) (x : Γ(G, O)),
      @Eq Γ(wcStructMod Y, O) (φ a O h (n • x))
        (@HMul.hMul Γ(Y, O) Γ(Y, O) Γ(Y, O) _ (n : Γ(Y, O)) (φ a O h x)) := by
    intro a O h n x
    rw [map_zsmul]
    exact zsmul_eq_mul (α := Γ(Y, O)) _ n
  have hsm : ∀ (O : Y.Opens) (s : Γ(Y, O)) (x : Γ(wcStructMod Y, O)),
      @Eq Γ(wcStructMod Y, O) (s • x) (@HMul.hMul Γ(Y, O) Γ(Y, O) Γ(Y, O) _ s x) :=
    fun _ _ _ => rfl

  have hK : ∀ (n : ℕ) (U : Y.Opens) (F : Fin (n + 1) ↪o Fin L.m) (c : Fin L.m) (hc : U ≤ L.V c)
      (hUF : U ≤ wcAcV L.V ⊤ F) (x : Γ(G, wcAcV L.V ⊤ F)), F (Fin.last n) = c →
      (φ c U hc ((G.presheaf.map (homOfLE hUF).op).hom x) : Γ(Y, U)) =
        (Y.presheaf.map (homOfLE hUF).op).hom
          (φ (F (Fin.last n)) (wcAcV L.V ⊤ F)
            (inf_le_left.trans (iInf_le (fun k => L.V (F k)) (Fin.last n))) x) := by
    intro n U F c hc hUF x hFc
    subst hFc
    exact hres _ _ _ _ _ _

  obtain ⟨Θ, hΘ⟩ : ∃ Θ : ∀ n : ℕ, wcAcC G L.V ⊤ n →+ wcCbcmC L ⊤ n, ∀ n z b,
      Θ n z b = φ (b (Fin.last n)) (wcAcV L.V ⊤ b)
        (inf_le_left.trans (iInf_le (fun k => L.V (b k)) (Fin.last n))) (z b) :=
    ⟨fun n =>
      { toFun := fun z b => φ (b (Fin.last n)) (wcAcV L.V ⊤ b)
          (inf_le_left.trans (iInf_le (fun k => L.V (b k)) (Fin.last n))) (z b)
        map_zero' := by
          funext b
          exact map_zero _
        map_add' := fun x y => by
          funext b
          exact map_add _ _ _ }, fun _ _ _ => rfl⟩

  have hI : ∀ (p : ℕ) (z : wcAcC G L.V ⊤ p),
      Θ (p + 1) (wcAcD G L.V ⊤ p z) = wcCbcmD L ⊤ e p (Θ p z) := by
    intro p z
    funext b
    have e1 : ∀ k' : Fin (p + 1),
        (Fin.succAboveOrderEmb (Fin.castSucc k')).trans b (Fin.last p) = b (Fin.last (p + 1)) := by
      intro k'
      rw [RelEmbedding.trans_apply, Fin.succAboveOrderEmb_apply,
        Fin.succAbove_castSucc_of_le _ _ (Fin.le_last _), Fin.succ_last]
    have e2 : (Fin.succAboveOrderEmb (Fin.last (p + 1))).trans b (Fin.last p) =
        b (Fin.castSucc (Fin.last p)) := by
      rw [RelEmbedding.trans_apply, Fin.succAboveOrderEmb_apply, Fin.succAbove_last_apply]
    rw [hΘ]
    simp only [wcAcD, wcCbcmD, AddMonoidHom.coe_mk, ZeroHom.coe_mk]
    rw [hmap, Fin.sum_univ_castSucc (n := p + 1)]
    congr 1
    · refine Finset.sum_congr rfl (fun k' _ => ?_)
      refine (hzs _ _ _ _ _).trans ?_
      rw [Fin.val_castSucc, Int.cast_pow, Int.cast_neg, Int.cast_one, hΘ]
      congr 1
      exact hK p _ _ _ _ _ _ (e1 k')
    · refine (hzs _ _ _ _ _).trans ?_
      rw [Fin.val_last, Int.cast_pow, Int.cast_neg, Int.cast_one, hΘ]
      congr 1
      refine (htr (b (Fin.castSucc (Fin.last p))) (b (Fin.last (p + 1))) (wcAcV L.V ⊤ b)
        (inf_le_left.trans (iInf_le (fun k => L.V (b k)) (Fin.castSucc (Fin.last p)))) _ _).trans ?_
      refine (hsm _ _ _).trans ?_
      rw [map_pow]
      congr 1
      exact hK p _ _ _ _ _ _ e2

  have hsmul : ∀ (n : ℕ) (β : B) (w : wcAcC G L.V ⊤ n),
      Θ n (fun a => wcCnSigma q (wcAcV L.V ⊤ a) β • w a) =
        fun a => wcCnSigma q (wcCbcmV L ⊤ a) β * Θ n w a := by
    intro n β w
    funext a
    rw [hΘ, hΘ]
    exact hlin _ _ _ _ _
  have hinj : ∀ (n : ℕ) (x y : wcAcC G L.V ⊤ n), Θ n x = Θ n y → x = y := by
    intro n x y hxy
    funext a
    have h1 := congrFun hxy a
    rw [hΘ, hΘ] at h1
    exact (hbij _ _ _).1 h1
  have hsurj : ∀ (n : ℕ) (y : wcCbcmC L ⊤ n), ∃ x, Θ n x = y := by
    intro n y
    refine ⟨fun a => Function.surjInv (hbij (a (Fin.last n)) (wcAcV L.V ⊤ a)
      (inf_le_left.trans (iInf_le (fun k => L.V (a k)) (Fin.last n)))).2 (y a), ?_⟩
    funext a
    rw [hΘ]
    exact Function.surjInv_eq _ _

  obtain ⟨⟨k, c, hc, hgen⟩, hP2⟩ := hP
  refine ⟨⟨k, fun i => Θ 0 (c i), fun i => ?_, fun z hz => ?_⟩, fun p => ?_⟩
  · rw [← hI, hc, map_zero]
  · obtain ⟨z0, rfl⟩ := hsurj 0 z
    have hz0 : wcAcD G L.V ⊤ 0 z0 = 0 :=
      hinj (0 + 1) _ _ (by rw [hI, hz, map_zero])
    obtain ⟨β, hβ⟩ := hgen z0 hz0
    refine ⟨β, ?_⟩
    rw [hβ, map_sum]
    exact Finset.sum_congr rfl (fun i _ => hsmul 0 (β i) (c i))
  · obtain ⟨k, c, hc, hgen⟩ := hP2 p
    refine ⟨k, fun i => Θ (p + 1) (c i), fun i => by rw [← hI, hc, map_zero], fun z hz => ?_⟩
    obtain ⟨z0, rfl⟩ := hsurj (p + 1) z
    have hz0 : wcAcD G L.V ⊤ (p + 1) z0 = 0 :=
      hinj (p + 1 + 1) _ _ (by rw [hI, hz, map_zero])
    obtain ⟨β, x, hβ⟩ := hgen z0 hz0
    refine ⟨β, Θ p x, ?_⟩
    rw [hβ, map_add, map_sum, hI]
    congr 1
    exact Finset.sum_congr rfl (fun i _ => hsmul (p + 1) (β i) (c i))

theorem wcpa_dj_cgs_chow_closed : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (X : Scheme.{u}) (h : X ⟶ Spec (.of B)) [IsProper h] (T : TopologicalSpace.Closeds X), IsIrreducible (T : Set X) → ∃ (Z : Scheme.{u}) (p : Z ⟶ X) (m : ℕ) (g : Z ⟶ wcPm.{u} m), IsProper p ∧ IsReduced Z ∧ Set.range p ⊆ (T : Set X) ∧ IsClosedImmersion (Limits.prod.lift (p ≫ h) g) ∧ IsClosedImmersion (Limits.prod.lift p g) ∧ ∃ U₀ : X.Opens, IsAffineOpen U₀ ∧ ((U₀ : Set X) ∩ T).Nonempty ∧ IsClosedImmersion (p ∣_ U₀) ∧ ∀ x ∈ U₀, x ∈ T → x ∈ Set.range p :=
by
  intro B _ _ X h _ T hT
  classical

  have hlift : ∀ (R S C : Scheme.{u}) [IsReduced R] (a : R ⟶ S) (j : C ⟶ S) [IsClosedImmersion j],
      Set.range a ⊆ Set.range j → ∃ b : R ⟶ C, b ≫ j = a := by
    intro R S C _ a j _ H
    refine ⟨IsClosedImmersion.lift j a ?_, IsClosedImmersion.lift_fac _ _ _⟩
    show _ ≤ Scheme.IdealSheafData.ofIdeals _
    rw [Scheme.IdealSheafData.le_ofIdeals_iff]
    intro V t ht
    have hj : t ∈ RingHom.ker (j.app V.1).hom :=
      Scheme.IdealSheafData.ideal_ofIdeals_le _ V ht
    rw [RingHom.mem_ker] at hj ⊢
    apply eq_zero_of_basicOpen_eq_bot
    rw [← Scheme.preimage_basicOpen]
    have hC : j ⁻¹ᵁ S.basicOpen t = ⊥ := by
      rw [Scheme.preimage_basicOpen, hj, Scheme.basicOpen_zero]
    apply eq_bot_iff.mpr
    intro x hx
    obtain ⟨c, hc⟩ := H ⟨x, rfl⟩
    have : c ∈ j ⁻¹ᵁ S.basicOpen t := by
      show j c ∈ S.basicOpen t
      rw [hc]; exact hx
    rw [hC] at this
    exact this

  have hdenseinj : ∀ (Z D : Scheme.{u}) [IsReduced Z] (δ : D ⟶ Z), DenseRange δ →
      ∀ (V : Z.Opens) (s t : Γ(Z, V)), δ.app V s = δ.app V t → s = t := by
    intro Z D _ δ hδ V s t hst
    rw [← sub_eq_zero]
    apply eq_zero_of_basicOpen_eq_bot
    have h0 : δ.app V (s - t) = 0 := by rw [map_sub, hst, sub_self]
    have hpre : δ ⁻¹ᵁ Z.basicOpen (s - t) = ⊥ := by
      rw [Scheme.preimage_basicOpen, h0, Scheme.basicOpen_zero]
    by_contra hne
    obtain ⟨z, hz⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hne
    obtain ⟨_, hzr, ⟨x, rfl⟩⟩ := hδ.inter_open_nonempty (Z.basicOpen (s - t))
      (Z.basicOpen (s - t)).isOpen ⟨z, hz⟩
    have hx : x ∈ δ ⁻¹ᵁ Z.basicOpen (s - t) := hzr
    rw [hpre] at hx
    exact hx
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace h
  have hsepX : IsSeparated (Limits.terminal.from X) := by
    have e : Limits.terminal.from X = h ≫ Limits.terminal.from (Spec (.of B)) :=
      Limits.terminal.hom_ext _ _
    rw [e]
    infer_instance

  obtain ⟨r, U, W, hU, hcovT, hW, hWT, hWU⟩ : ∃ (r : ℕ) (U : Fin (r + 1) → X.Opens) (W : X.Opens),
      (∀ i, IsAffineOpen (U i)) ∧ (∀ x ∈ (T : Set X), ∃ i, x ∈ U i) ∧ IsAffineOpen W ∧
        ((W : Set X) ∩ T).Nonempty ∧ ∀ i, W ≤ U i := by
    have hbasis : ∀ {U : X.Opens} {x : X}, x ∈ U → ∃ U' ∈ X.affineOpens, x ∈ U' ∧ U' ≤ U :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens
    have hA : ∀ x : X, ∃ A : X.Opens, IsAffineOpen A ∧ x ∈ A := by
      intro x
      obtain ⟨U', hU', hxU', -⟩ := hbasis (show x ∈ (⊤ : X.Opens) from trivial)
      exact ⟨U', hU', hxU'⟩
    choose A hAaff hAmem using hA
    have hTc : IsCompact (T : Set X) := T.isClosed.isCompact
    obtain ⟨t, ht⟩ := hTc.elim_finite_subcover (fun x : (T : Set X) => (A x : Set X))
      (fun _ => (A _).isOpen) (fun y hy => Set.mem_iUnion.mpr ⟨⟨y, hy⟩, hAmem y⟩)
    obtain ⟨y0, hy0⟩ := hT.nonempty
    have htne : t.Nonempty := by
      have := ht hy0
      simp only [Set.mem_iUnion] at this
      obtain ⟨x, hx, _⟩ := this
      exact ⟨x, hx⟩
    obtain ⟨r, hr⟩ : ∃ r, t.card = r + 1 := ⟨t.card - 1, by have := htne.card_pos; omega⟩
    let e := t.equivFinOfCardEq hr
    let U : Fin (r + 1) → X.Opens := fun i => A (e.symm i).1
    have hUT : ∀ i, ((T : Set X) ∩ (U i : Set X)).Nonempty :=
      fun i => ⟨(e.symm i).1.1, (e.symm i).1.2, hAmem _⟩
    have key : ∀ (s : Finset (Fin (r + 1))), ((T : Set X) ∩ (⋂ i ∈ s, (U i : Set X))).Nonempty := by
      intro s
      induction s using Finset.induction_on with
      | empty => simpa using hT.nonempty
      | insert j s hj ih =>
        have h := hT.2 (U j) (⋂ i ∈ s, (U i : Set X)) (U j).isOpen
          (isOpen_biInter_finset (fun i _ => (U i).isOpen)) (hUT j) ih
        simpa [Finset.set_biInter_insert] using h
    obtain ⟨y, hyT, hyU⟩ := key Finset.univ
    simp only [Finset.mem_univ, Set.iInter_true] at hyU
    let O : X.Opens := ⟨⋂ i, (U i : Set X), isOpen_iInter_of_finite (fun i => (U i).isOpen)⟩
    obtain ⟨W, hW, hyW, hWO⟩ := hbasis (show y ∈ O from hyU)
    refine ⟨r, U, W, fun i => hAaff _, ?_, hW, ⟨y, hyW, hyT⟩, ?_⟩
    · intro x hx
      have := ht hx
      simp only [Set.mem_iUnion] at this
      obtain ⟨z, hz, hxz⟩ := this
      refine ⟨e ⟨z, hz⟩, ?_⟩
      show x ∈ A (e.symm (e ⟨z, hz⟩)).1
      rw [Equiv.symm_apply_apply]
      exact hxz
    · intro i x hx
      exact Set.mem_iInter.mp (hWO hx) i

  have hgen2 : ∀ V : X.Opens, IsAffineOpen V → ∃ (n : ℕ) (a : Fin (n + 1) → Γ(X, V)), a 0 = 1 ∧
      ∀ t : Γ(X, V), t ∈ Subring.closure (Set.range ((X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom.comp
        (h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) ∪ Set.range a) := by
    intro V hV
    have h1 := HasRingHomProperty.appLE @LocallyOfFiniteType h inferInstance
      ⟨⊤, isAffineOpen_top _⟩ ⟨V, hV⟩ le_top
    have h2 : ((X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom.comp h.appTop.hom).FiniteType := h1
    have h3 : (Scheme.ΓSpecIso (.of B)).inv.hom.FiniteType := by
      apply RingHom.FiniteType.of_surjective
      intro x
      exact ⟨(Scheme.ΓSpecIso (.of B)).hom.hom x, by simp⟩
    have hft := RingHom.FiniteType.comp h2 h3
    set ρ := (X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom.comp
      (h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom) with hρ
    letI := ρ.toAlgebra
    obtain ⟨s, hs⟩ := (hft : Algebra.FiniteType B Γ(X, V)).out
    let a : Fin (s.card + 1) → Γ(X, V) := Fin.cons 1 (fun k => (s.equivFin.symm k).1)
    refine ⟨s.card, a, rfl, fun t => ?_⟩
    have ht : t ∈ (Algebra.adjoin B (s : Set Γ(X, V))).toSubring := by
      rw [hs]; trivial
    rw [Algebra.adjoin_eq_ring_closure] at ht
    refine Subring.closure_mono ?_ ht
    rintro x (hx | hx)
    · exact Or.inl hx
    · refine Or.inr ⟨(s.equivFin ⟨x, hx⟩).succ, ?_⟩
      simp [a]
  have hgen := fun i => hgen2 (U i) (hU i)
  choose n a ha0 hagen using hgen
  have hcard : 0 < Fintype.card (∀ i, Fin (n i + 1)) := Fintype.card_pos
  obtain ⟨N, hN⟩ : ∃ N : ℕ, Fintype.card (∀ i, Fin (n i + 1)) = N + 1 :=
    ⟨_, (Nat.succ_pred_eq_of_pos hcard).symm⟩
  let κ : Fin (N + 1) ≃ (∀ i, Fin (n i + 1)) := (Fintype.equivFinOfCardEq hN).symm
  obtain ⟨D, d, hDred, hDc, hd, hrange⟩ := wc_chow_reduced_trace X T W hW
  haveI := hDred
  haveI := hDc
  haveI := hd
  set ψ : D ⟶ X := d ≫ W.ι with hψdef
  have hψW : ∀ x : D, ψ x ∈ (W : Set X) ∩ T := by
    intro x
    rw [← hrange]
    exact ⟨x, rfl⟩
  have hψU : ∀ i, ψ ⁻¹ᵁ U i = ⊤ := by
    intro i
    apply eq_top_iff.mpr
    intro x _
    exact hWU i (hψW x).1
  let s : Fin (N + 1) → Γ(D, ⊤) := fun K => ∏ i, ψ.appLE (U i) ⊤ (hψU i).ge (a i (κ K i))
  have hs1 : s (κ.symm 0) = 1 := by
    simp only [s, Equiv.apply_symm_apply, Pi.zero_apply, ha0, map_one, Finset.prod_const_one]
  have hspan : Ideal.span (Set.range s) = ⊤ := by
    rw [Ideal.eq_top_iff_one, ← hs1]
    exact Ideal.subset_span ⟨_, rfl⟩
  obtain ⟨e, hcov, hbo, huniv⟩ := wc_pm_segre_coords.{u} N
  obtain ⟨φ, hφ, hrel⟩ := huniv D s hspan

  obtain ⟨hPproper, hfstproper⟩ : IsProper (Limits.terminal.from (wcPm.{u} N)) ∧
      ∀ (Y : Scheme.{u}), IsProper (Limits.prod.fst : Y ⨯ wcPm.{u} N ⟶ Y) := by
    letI 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (ULift.{u} ℤ)
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hP0 : IsProper (Proj.toSpecZero 𝒜) := by
      letI : IsScalarTower (ULift.{u} ℤ) (𝒜 0) (MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ)) :=
        IsScalarTower.of_algebraMap_eq (R := ULift.{u} ℤ) (S := 𝒜 0)
          (A := MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ)) (fun r => rfl)
      haveI : Algebra.FiniteType (𝒜 0) (MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ)) :=
        Algebra.FiniteType.of_restrictScalars_finiteType (ULift.{u} ℤ) _ _
      infer_instance
    have hsurj : Function.Surjective (algebraMap (ULift.{u} ℤ) (𝒜 0)) := by
      intro x
      have hx : (x : MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ)).IsHomogeneous 0 :=
        (MvPolynomial.mem_homogeneousSubmodule _ _).mp x.2
      refine ⟨(x : MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ)).coeff 0, ?_⟩
      apply Subtype.ext
      have h0 := hx.totalDegree_le
      have h1 : (x : MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ)).totalDegree = 0 := by omega
      rw [MvPolynomial.totalDegree_eq_zero_iff_eq_C] at h1
      rw [h1]
      simp
    let f : Spec (.of (𝒜 0)) ⟶ Spec (.of (ULift.{u} ℤ)) :=
      Spec.map (CommRingCat.ofHom (algebraMap (ULift.{u} ℤ) (𝒜 0)))
    have hf : IsFinite f := by
      rw [IsFinite.SpecMap_iff]
      exact RingHom.Finite.of_surjective _ hsurj
    have hT : IsIso (Limits.terminal.from (Spec (.of (ULift.{u} ℤ)))) := by
      have e : Limits.terminal.from (Spec (.of (ULift.{u} ℤ))) =
          (specULiftZIsTerminal.uniqueUpToIso Limits.terminalIsTerminal).hom :=
        Limits.terminal.hom_ext _ _
      rw [e]
      infer_instance
    have htop : IsProper (Limits.terminal.from (wcPm.{u} N)) := by
      have e : Limits.terminal.from (wcPm.{u} N) =
          Proj.toSpecZero 𝒜 ≫ f ≫ Limits.terminal.from (Spec (.of (ULift.{u} ℤ))) :=
        Limits.terminal.hom_ext _ _
      rw [e]
      infer_instance
    refine ⟨htop, fun Y => ?_⟩
    have hpb : IsPullback (Limits.prod.snd : Y ⨯ wcPm.{u} N ⟶ _) Limits.prod.fst
        (Limits.terminal.from (wcPm.{u} N)) (Limits.terminal.from Y) :=
      (IsPullback.of_isLimit_binaryFan_of_isTerminal (Limits.prodIsProd Y (wcPm.{u} N))
        Limits.terminalIsTerminal).flip
    exact MorphismProperty.of_isPullback (P := @IsProper) hpb htop
  haveI := hPproper
  have hsepP : IsSeparated (Limits.terminal.from (wcPm.{u} N)) := inferInstance
  obtain ⟨Z, p, g, δ, hZred, hΛ, hδ, hδp, hδg⟩ :=
    wc_graph_closure_reduced X (wcPm.{u} N) D ψ φ hsepX hsepP hlift
  haveI := hZred
  haveI := hΛ
  have hrangep : Set.range p ⊆ (T : Set X) := by
    have hcl : IsClosed (p ⁻¹' (T : Set X)) := T.isClosed.preimage p.continuous
    have hsub : Set.range δ ⊆ p ⁻¹' (T : Set X) := by
      rintro _ ⟨x, rfl⟩
      show p (δ x) ∈ (T : Set X)
      rw [← Scheme.Hom.comp_apply, hδp]
      exact (hψW x).2
    have huniv' : p ⁻¹' (T : Set X) = Set.univ := by
      apply Set.eq_univ_of_univ_subset
      rw [← hδ.closure_range]
      exact closure_minimal hsub hcl
    rintro _ ⟨z, rfl⟩
    have hz : z ∈ p ⁻¹' (T : Set X) := huniv' ▸ Set.mem_univ z
    exact hz
  have hp : IsProper p := by
    haveI := hfstproper X
    have h1 : IsProper (Limits.prod.lift p g ≫ Limits.prod.fst) := inferInstance
    rwa [Limits.prod.lift_fst] at h1
  haveI := hp
  have hpU : ∀ z : Z, ∃ i, p z ∈ U i := fun z => hcovT (p z) (hrangep ⟨z, rfl⟩)
  have hsepq : IsSeparated (p ≫ h) := inferInstance
  have hclosed : IsClosed (Set.range (Limits.prod.lift (p ≫ h) g)) := by
    haveI := hfstproper (Spec (.of B))
    haveI : IsProper (Limits.prod.lift (p ≫ h) g ≫ Limits.prod.fst) := by
      rw [Limits.prod.lift_fst]
      infer_instance
    haveI : IsProper (Limits.prod.lift (p ≫ h) g) := IsProper.of_comp _ Limits.prod.fst
    have hm := (Limits.prod.lift (p ≫ h) g).isClosedMap
    simpa using hm _ isClosed_univ
  have hcover := wc_chow_charts_cover X N e r U n a κ Z D p g δ ψ φ s hψU hdenseinj
    hδp hδg hδ ha0 (fun K => rfl) hφ hrel hcov hbo hpU
  have hCI : IsClosedImmersion (Limits.prod.lift (p ≫ h) g) := by
    refine wc_closed_immersion_of_charts B Z (p ≫ h) N g {J | ∃ i, κ J i = 0}
      wc_prod_affine_opens_gen hclosed ?_ ?_
    · intro z
      obtain ⟨J, hJ, hz⟩ := hcover z
      exact ⟨J, hJ, hz⟩
    · rintro J ⟨i, hi⟩
      obtain ⟨hVaff, hVgen⟩ := wc_chow_chart_generation B X h N e r U n a κ Z D p g δ ψ φ s hψU
        wc_prod_affine_opens_gen hdenseinj hδp hδg hδ ha0 (fun K => rfl) hφ hrel hU
        hagen hΛ i J hi
      have hle := wc_chow_chart_contained B X Z D h N p g δ (U i) J wc_prod_affine_opens_gen hsepq
        hδ (by rw [hδp]; exact hψU i) hVaff hVgen
      exact ⟨p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J, inf_le_right, le_inf hle le_rfl, hVaff, hVgen⟩

  have hpW : IsClosedImmersion (p ∣_ W) := by
    let V := p ⁻¹ᵁ W
    haveI : IsReduced (V : Scheme.{u}) := isReduced_of_isOpenImmersion V.ι
    have hrδ : Set.range δ ⊆ Set.range V.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      show p (δ x) ∈ W
      rw [← Scheme.Hom.comp_apply, hδp, Scheme.Hom.comp_apply]
      exact (d x).2
    let δV : D ⟶ (V : Scheme.{u}) := IsOpenImmersion.lift V.ι δ hrδ
    have hδV : δV ≫ V.ι = δ := IsOpenImmersion.lift_fac _ _ _
    let ρ : (V : Scheme.{u}) ⟶ (W : Scheme.{u}) ⨯ wcPm.{u} N := Limits.prod.lift (p ∣_ W) (V.ι ≫ g)
    have hρsep : IsSeparated ρ := by
      have e : ρ ≫ Limits.prod.map W.ι (𝟙 (wcPm.{u} N)) = V.ι ≫ Limits.prod.lift p g := by
        apply Limits.prod.hom_ext
        · simp [ρ, morphismRestrict_ι, V]
        · simp [ρ]
      haveI : IsSeparated (ρ ≫ Limits.prod.map W.ι (𝟙 (wcPm.{u} N))) := by rw [e]; infer_instance
      exact IsSeparated.of_comp ρ (Limits.prod.map W.ι (𝟙 (wcPm.{u} N)))
    have hfstsep : IsSeparated (Limits.prod.fst : (W : Scheme.{u}) ⨯ wcPm.{u} N ⟶ W) := by
      have hpb : IsPullback (Limits.prod.snd : (W : Scheme.{u}) ⨯ wcPm.{u} N ⟶ _) Limits.prod.fst
          (Limits.terminal.from (wcPm.{u} N)) (Limits.terminal.from (W : Scheme.{u})) :=
        (IsPullback.of_isLimit_binaryFan_of_isTerminal (Limits.prodIsProd (W : Scheme.{u}) (wcPm.{u} N))
          Limits.terminalIsTerminal).flip
      exact MorphismProperty.of_isPullback (P := @IsSeparated) hpb hsepP
    let γ : D ⟶ (W : Scheme.{u}) ⨯ wcPm.{u} N := Limits.prod.lift d (δ ≫ g)
    haveI hγ : IsClosedImmersion γ := by
      haveI : IsClosedImmersion (γ ≫ Limits.prod.fst) := by
        rw [Limits.prod.lift_fst]; infer_instance
      exact IsClosedImmersion.of_comp γ Limits.prod.fst
    have hd1 : δV ≫ p ∣_ W = d := by
      rw [← cancel_mono W.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, hδV, hδp]
    have hδVρ : δV ≫ ρ = γ := by
      apply Limits.prod.hom_ext
      · simp [ρ, γ, hd1]
      · simp [ρ, γ, ← Category.assoc, hδV]
    haveI : IsClosedImmersion (δV ≫ ρ) := by rw [hδVρ]; exact hγ
    haveI hδVci : IsClosedImmersion δV := IsClosedImmersion.of_comp δV ρ
    have hdenseV : DenseRange δV := by
      rw [DenseRange, dense_iff_inter_open]
      intro O hO hOne
      have hOZ : IsOpen (V.ι '' O) := V.ι.isOpenEmbedding.isOpenMap O hO
      obtain ⟨_, ⟨y, hyO, rfl⟩, ⟨x, hx⟩⟩ := hδ.inter_open_nonempty _ hOZ (hOne.image _)
      refine ⟨δV x, ?_, ⟨x, rfl⟩⟩
      have : V.ι (δV x) = V.ι y := by rw [← Scheme.Hom.comp_apply, hδV]; exact hx
      rw [V.ι.isOpenEmbedding.injective this]
      exact hyO
    haveI : Surjective δV := by
      constructor
      have hcl : IsClosed (Set.range δV) := δV.isClosedEmbedding.isClosed_range
      have h := hdenseV.closure_range
      rw [hcl.closure_eq] at h
      exact Set.range_eq_univ.mp h
    haveI : IsIso δV := isIso_of_isClosedImmersion_of_surjective δV
    have e : p ∣_ W = inv δV ≫ d := by rw [← hd1, IsIso.inv_hom_id_assoc]
    rw [e]
    infer_instance
  have hpts : ∀ x ∈ W, x ∈ T → x ∈ Set.range p := by
    intro x hxW hxT
    have hx : x ∈ Set.range ψ := by
      rw [hrange]
      exact ⟨hxW, hxT⟩
    obtain ⟨y, rfl⟩ := hx
    exact ⟨δ y, by rw [← Scheme.Hom.comp_apply, hδp]⟩
  exact ⟨Z, p, N, g, hp, hZred, hrangep, hCI, hΛ, W, hW, hWT, hpW, hpts⟩

theorem wcpa_dj_cgs_push_transport : ∀ (B : Type u) [CommRing B] (X Z : Scheme.{u}) (h : X ⟶ Spec (.of B)) (p : Z ⟶ X) (L : Z.Modules) {r : ℕ} (V : Fin r → X.Opens), wcAcFG B Z (p ≫ h) L (fun i => p ⁻¹ᵁ V i) → wcAcFG B X h ((Scheme.Modules.pushforward p).obj L) V :=
by
  intro B _ X Z h p L r V hL

  have hpre : ∀ {n : ℕ} (U : Fin n → X.Opens), p ⁻¹ᵁ (⨅ k, U k) = ⨅ k, p ⁻¹ᵁ U k := by
    intro n U
    rw [← Finset.inf_univ_eq_iInf, ← Finset.inf_univ_eq_iInf]
    suffices H : ∀ s : Finset (Fin n), p ⁻¹ᵁ s.inf U = s.inf (fun k => p ⁻¹ᵁ U k) from H _
    intro s
    induction s using Finset.induction_on with
    | empty => simp
    | insert a s ha ih => rw [Finset.inf_insert, Finset.inf_insert, Scheme.Hom.preimage_inf, ih]
  have hEq : ∀ (q : ℕ) (a : Fin (q + 1) ↪o Fin r),
      p ⁻¹ᵁ wcAcV V ⊤ a = wcAcV (fun i => p ⁻¹ᵁ V i) ⊤ a := by
    intro q a
    show p ⁻¹ᵁ ((⨅ j, V (a j)) ⊓ ⊤) = (⨅ j, p ⁻¹ᵁ V (a j)) ⊓ ⊤
    simp only [inf_top_eq]
    exact hpre _
  have hPQ : ∀ (q : ℕ) (a : Fin (q + 1) ↪o Fin r),
      p ⁻¹ᵁ wcAcV V ⊤ a ≤ wcAcV (fun i => p ⁻¹ᵁ V i) ⊤ a := fun q a => (hEq q a).le
  have hQP : ∀ (q : ℕ) (a : Fin (q + 1) ↪o Fin r),
      wcAcV (fun i => p ⁻¹ᵁ V i) ⊤ a ≤ p ⁻¹ᵁ wcAcV V ⊤ a := fun q a => (hEq q a).ge

  have hres : ∀ {U₁ U₂ U₃ : Z.Opens} (h12 : U₂ ≤ U₁) (h23 : U₃ ≤ U₂) (s : Γ(L, U₁)),
      (L.presheaf.map (homOfLE h23).op).hom ((L.presheaf.map (homOfLE h12).op).hom s) =
        (L.presheaf.map (homOfLE (h23.trans h12)).op).hom s := by
    intro U₁ U₂ U₃ h12 h23 s
    rw [← AddCommGrpCat.comp_apply, ← CategoryTheory.Functor.map_comp]
    rfl
  have hid : ∀ {U : Z.Opens} (h0 : U ≤ U) (s : Γ(L, U)),
      (L.presheaf.map (homOfLE h0).op).hom s = s := by
    intro U h0 s
    rw [show (homOfLE h0).op = 𝟙 (Opposite.op U) from rfl, CategoryTheory.Functor.map_id]
    rfl
  have hG : ∀ {W W' : X.Opens} (hle : W' ≤ W) (s : Γ((Scheme.Modules.pushforward p).obj L, W)),
      (((Scheme.Modules.pushforward p).obj L).presheaf.map (homOfLE hle).op).hom s =
        (L.presheaf.map (homOfLE (Scheme.Hom.preimage_mono p hle)).op).hom s :=
    fun _ _ => rfl

  have keyX : ∀ (W : X.Opens) (b : B),
      p.app W (wcCnSigma h W b) = wcCnSigma (p ≫ h) (p ⁻¹ᵁ W) b := by
    intro W b
    simp only [wcCnSigma, RingHom.comp_apply]
    rw [← CommRingCat.comp_apply, Scheme.Hom.naturality, CommRingCat.comp_apply,
      Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
    rfl
  have keyZ : ∀ (U U' : Z.Opens) (hU : U' ≤ U) (b : B),
      (Z.presheaf.map (homOfLE hU).op).hom (wcCnSigma (p ≫ h) U b) =
        wcCnSigma (p ≫ h) U' b := by
    intro U U' hU b
    simp only [wcCnSigma, RingHom.comp_apply]
    rw [← CommRingCat.comp_apply, ← CategoryTheory.Functor.map_comp]
    rfl

  obtain ⟨T, hT⟩ : ∃ T : ∀ q : ℕ, wcAcC L (fun i => p ⁻¹ᵁ V i) ⊤ q →+
      wcAcC ((Scheme.Modules.pushforward p).obj L) V ⊤ q, ∀ q z a,
      T q z a = (L.presheaf.map (homOfLE (hPQ q a)).op).hom (z a) :=
    ⟨fun q =>
      { toFun := fun z a => (L.presheaf.map (homOfLE (hPQ q a)).op).hom (z a)
        map_zero' := by
          funext a
          exact map_zero _
        map_add' := by
          intro x y
          funext a
          exact map_add _ _ _ }, fun _ _ _ => rfl⟩
  obtain ⟨S, hS⟩ : ∃ S : ∀ q : ℕ, wcAcC ((Scheme.Modules.pushforward p).obj L) V ⊤ q →+
      wcAcC L (fun i => p ⁻¹ᵁ V i) ⊤ q, ∀ q y a,
      S q y a = (L.presheaf.map (homOfLE (hQP q a)).op).hom (y a) :=
    ⟨fun q =>
      { toFun := fun y a => (L.presheaf.map (homOfLE (hQP q a)).op).hom (y a)
        map_zero' := by
          funext a
          exact map_zero _
        map_add' := by
          intro x y
          funext a
          exact map_add _ _ _ }, fun _ _ _ => rfl⟩
  have hC1 : ∀ q z, S q (T q z) = z := by
    intro q z
    funext a
    rw [hS, hT]
    exact (hres _ _ _).trans (hid _ _)
  have hC2 : ∀ q y, T q (S q y) = y := by
    intro q y
    funext a
    rw [hT, hS]
    exact (hres _ _ _).trans (hid _ _)

  have hA : ∀ q z, wcAcD ((Scheme.Modules.pushforward p).obj L) V ⊤ q (T q z) =
      T (q + 1) (wcAcD L (fun i => p ⁻¹ᵁ V i) ⊤ q z) := by
    intro q z
    funext a
    rw [hT]
    simp only [wcAcD, AddMonoidHom.coe_mk, ZeroHom.coe_mk, hT]
    rw [map_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [map_zsmul]
    congr 1
    exact (hG _ _).trans ((hres _ _ _).trans (hres _ _ _).symm)

  have hσ : ∀ q (b : B) (c : wcAcC L (fun i => p ⁻¹ᵁ V i) ⊤ q),
      T q (fun a => wcCnSigma (p ≫ h) (wcAcV (fun i => p ⁻¹ᵁ V i) ⊤ a) b • c a) =
        fun a => wcCnSigma h (wcAcV V ⊤ a) b • T q c a := by
    intro q b c
    funext a
    rw [hT, hT, Scheme.Modules.map_smul, keyZ, ← keyX]
    rfl

  have hCoc : ∀ q y, wcAcD ((Scheme.Modules.pushforward p).obj L) V ⊤ q y = 0 →
      wcAcD L (fun i => p ⁻¹ᵁ V i) ⊤ q (S q y) = 0 := by
    intro q y hy
    rw [← hC1 (q + 1) (wcAcD L (fun i => p ⁻¹ᵁ V i) ⊤ q (S q y)), ← hA, hC2, hy, map_zero]

  obtain ⟨⟨k0, c0, hc0, H0⟩, Hp⟩ := hL
  refine ⟨⟨k0, fun i => T 0 (c0 i), fun i => ?_, fun z hz => ?_⟩, fun q => ?_⟩
  · rw [hA, hc0 i, map_zero]
  · obtain ⟨b, hb⟩ := H0 _ (hCoc 0 z hz)
    refine ⟨b, ?_⟩
    rw [← hC2 0 z, hb, map_sum]
    exact Finset.sum_congr rfl (fun i _ => hσ 0 (b i) (c0 i))
  · obtain ⟨k, c, hc, H⟩ := Hp q
    refine ⟨k, fun i => T (q + 1) (c i), fun i => ?_, fun z hz => ?_⟩
    · rw [hA, hc i, map_zero]
    · obtain ⟨b, x, hb⟩ := H _ (hCoc (q + 1) z hz)
      refine ⟨b, T q x, ?_⟩
      rw [← hC2 (q + 1) z, hb, map_add, map_sum, hA]
      congr 1
      exact Finset.sum_congr rfl (fun i _ => hσ (q + 1) (b i) (c i))

theorem wcpa_dj_cgs_twist_sheaf : ∀ (Y : Scheme.{u}) (m : ℕ) (g : Y ⟶ wcPm.{u} m) (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)), wcGsCoords m e → (∀ k, IsAffineOpen (g ⁻¹ᵁ wcPmChart m k)) → (∀ y : Y, ∃ k, y ∈ g ⁻¹ᵁ wcPmChart m k) → ∀ w : ℕ, ∃ (L : Y.Modules) (φ : ∀ (k : Fin (m + 1)) (O : Y.Opens), O ≤ g ⁻¹ᵁ wcPmChart m k → (Γ(L, O) →+ Γ(wcStructMod Y, O))), wcCoherentMod L ∧ wcGsTw g e w L φ :=
by
  intro Y m g e he hDa hDc w

  have hres : ∀ (U V W : Y.Opens) (h1 : V ≤ U) (h2 : W ≤ V) (s : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom s) =
        (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom s := by
    intro U V W h1 h2 s
    have hc : Y.presheaf.map (homOfLE (h2.trans h1)).op =
        Y.presheaf.map (homOfLE h1).op ≫ Y.presheaf.map (homOfLE h2).op := by
      rw [← Functor.map_comp]
      rfl
    rw [hc]
    rfl

  have hunit : ∀ a b : Fin (m + 1), IsUnit ((Y.presheaf.map (homOfLE (inf_le_right :
      g ⁻¹ᵁ wcPmChart m a ⊓ g ⁻¹ᵁ wcPmChart m b ≤ g ⁻¹ᵁ wcPmChart m b)).op).hom
        (g.app (wcPmChart m b) (e b a))) := by
    intro a b
    have hbo : g ⁻¹ᵁ wcPmChart m a ⊓ g ⁻¹ᵁ wcPmChart m b ≤
        Y.basicOpen (g.app (wcPmChart m b) (e b a)) := by
      rw [← Scheme.preimage_basicOpen, ← he.2.1 b a, Scheme.Hom.preimage_inf]
      exact le_of_eq (inf_comm _ _)
    have h1 := RingedSpace.isUnit_res_basicOpen Y.toRingedSpace (g.app (wcPmChart m b) (e b a))
    have hc : Y.presheaf.map (homOfLE (inf_le_right :
        g ⁻¹ᵁ wcPmChart m a ⊓ g ⁻¹ᵁ wcPmChart m b ≤ g ⁻¹ᵁ wcPmChart m b)).op =
        Y.presheaf.map (homOfLE (Y.basicOpen_le (g.app (wcPmChart m b) (e b a)))).op ≫
          Y.presheaf.map (homOfLE hbo).op := by
      rw [← Functor.map_comp]
      rfl
    rw [hc]
    exact h1.map (Y.presheaf.map (homOfLE hbo).op).hom

  have hcoc : ∀ a b c : Fin (m + 1),
      (Y.presheaf.map (homOfLE ((inf_le_left.trans inf_le_right) : g ⁻¹ᵁ wcPmChart m a ⊓
          g ⁻¹ᵁ wcPmChart m b ⊓ g ⁻¹ᵁ wcPmChart m c ≤ g ⁻¹ᵁ wcPmChart m b)).op).hom
          (g.app (wcPmChart m b) (e b a)) *
        (Y.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m a ⊓ g ⁻¹ᵁ wcPmChart m b ⊓
          g ⁻¹ᵁ wcPmChart m c ≤ g ⁻¹ᵁ wcPmChart m c)).op).hom (g.app (wcPmChart m c) (e c b)) =
      (Y.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m a ⊓ g ⁻¹ᵁ wcPmChart m b ⊓
          g ⁻¹ᵁ wcPmChart m c ≤ g ⁻¹ᵁ wcPmChart m c)).op).hom (g.app (wcPmChart m c) (e c a)) := by
    intro a b c
    have hV : g ⁻¹ᵁ wcPmChart m a ⊓ g ⁻¹ᵁ wcPmChart m b ⊓ g ⁻¹ᵁ wcPmChart m c ≤
        g ⁻¹ᵁ (wcPmChart m c ⊓ wcPmChart m b) := by
      rw [Scheme.Hom.preimage_inf]
      exact le_inf inf_le_right (inf_le_left.trans inf_le_right)
    have hA : ∀ (k : Fin (m + 1)) (hk : wcPmChart m c ⊓ wcPmChart m b ≤ wcPmChart m k)
        (hk' : g ⁻¹ᵁ wcPmChart m a ⊓ g ⁻¹ᵁ wcPmChart m b ⊓ g ⁻¹ᵁ wcPmChart m c ≤
          g ⁻¹ᵁ wcPmChart m k)
        (x : Γ(wcPm.{u} m, wcPmChart m k)),
        (g.appLE (wcPmChart m c ⊓ wcPmChart m b) _ hV).hom
            ((wcPm.{u} m).presheaf.map (homOfLE hk).op x) =
          (Y.presheaf.map (homOfLE hk').op).hom (g.app (wcPmChart m k) x) := by
      intro k hk hk' x
      have e1 := congrArg (fun φ => φ.hom x) (Scheme.Hom.map_appLE g hV (homOfLE hk).op)
      have e2 := congrArg (fun φ => φ.hom x)
        (Scheme.Hom.appLE_map g (le_refl (g ⁻¹ᵁ wcPmChart m k)) (homOfLE hk').op)
      simp only [CommRingCat.comp_apply] at e1 e2
      rw [e1, Scheme.Hom.app_eq_appLE, ← e2]
    rw [← hA c inf_le_left _ (e c a), ← hA c inf_le_left _ (e c b),
      ← hA b inf_le_right _ (e b a), he.2.2.1 c b a, map_mul, mul_comm]
  have hsup : (⨆ k, g ⁻¹ᵁ wcPmChart m k) = ⊤ := by
    apply eq_top_iff.mpr
    intro y _
    obtain ⟨k, hk⟩ := hDc y
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨k, hk⟩
  let Lc : wcpaDjCoc Y := ⟨m + 1, fun k => g ⁻¹ᵁ wcPmChart m k, fun a b => (hunit a b).unit⟩
  have hOK : wcpaDjCocOK Lc := by
    refine ⟨hDa, hsup, ?_, ?_⟩
    · intro a
      apply Units.ext
      simp only [Lc, IsUnit.unit_spec, Units.val_one]
      rw [he.1 a]
      simp
    · intro a b c
      simp only [Lc, IsUnit.unit_spec, hres]
      exact hcoc a b c
  obtain ⟨L, φ, hbij, hsm, hrs, htr⟩ := wcpa_dj_twr_construct Lc hOK w (wcStructMod Y)
  have hcoh : wcCoherentMod L :=
    wcpa_dj_twr_coherent_transfer Lc.V hDa hsup (wcStructMod Y) L φ hbij hsm hrs
      (wc_struct_mod_coh Y)
  refine ⟨L, φ, hcoh, hbij, hsm, hrs, ?_⟩
  intro k l O hk hl x
  have h := htr l k O hl hk x
  simp only [Lc, IsUnit.unit_spec, hres] at h
  exact h

theorem wcpa_dj_cgs_chart_affine_gen : ∀ (X Z : Scheme.{u}) (p : Z ⟶ X) (m : ℕ) (g : Z ⟶ wcPm.{u} m) (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)), wcGsCoords m e → IsClosedImmersion (Limits.prod.lift p g) → ∀ (W : X.Opens) (k : Fin (m + 1)), IsAffineOpen W → IsAffineOpen (p ⁻¹ᵁ W ⊓ g ⁻¹ᵁ wcPmChart m k) ∧ ∀ s : Γ(Z, p ⁻¹ᵁ W ⊓ g ⁻¹ᵁ wcPmChart m k), ∃ P : MvPolynomial (Fin (m + 1)) Γ(X, W), MvPolynomial.eval₂ ((Z.presheaf.map (homOfLE (inf_le_left : p ⁻¹ᵁ W ⊓ g ⁻¹ᵁ wcPmChart m k ≤ p ⁻¹ᵁ W)).op).hom.comp (p.app W).hom) (fun l => (Z.presheaf.map (homOfLE (inf_le_right : p ⁻¹ᵁ W ⊓ g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l))) P = s :=
by
  intro X Z p m g e he hΛ W k hW
  classical

  have hprod : ∀ (X Y : Scheme.{u}) (U : X.Opens) (V : Y.Opens), IsAffineOpen U → IsAffineOpen V → IsAffineOpen ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V) ∧ ∀ t : Γ(X ⨯ Y, (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V), t ∈ Subring.closure (Set.range (((X ⨯ Y).presheaf.map (homOfLE (inf_le_left : (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V ≤ (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U)).op).hom.comp ((Limits.prod.fst : X ⨯ Y ⟶ X).app U).hom) ∪ Set.range (((X ⨯ Y).presheaf.map (homOfLE (inf_le_right : (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V ≤ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V)).op).hom.comp ((Limits.prod.snd : X ⨯ Y ⟶ Y).app V).hom)) := by
    intro X Y U V hU hV
    have s2 : ∀ (R A B P : CommRingCat.{u}) (f : R ⟶ A) (g : R ⟶ B) (inl : A ⟶ P) (inr : B ⟶ P),
        IsPushout f g inl inr → ∀ x : P, x ∈ Subring.closure (Set.range inl.hom ∪ Set.range inr.hom) := by
      intro R A B P f g inl inr hP x
      let S := Subring.closure (Set.range inl.hom ∪ Set.range inr.hom)
      let inl' : A ⟶ CommRingCat.of S := CommRingCat.ofHom (RingHom.codRestrict inl.hom S
        (fun a => Subring.subset_closure (Or.inl ⟨a, rfl⟩)))
      let inr' : B ⟶ CommRingCat.of S := CommRingCat.ofHom (RingHom.codRestrict inr.hom S
        (fun b => Subring.subset_closure (Or.inr ⟨b, rfl⟩)))
      have hw : f ≫ inl' = g ≫ inr' := by
        ext y
        exact ConcreteCategory.congr_hom hP.w y
      let d := hP.desc inl' inr' hw
      have hε : d ≫ CommRingCat.ofHom S.subtype = 𝟙 P := by
        apply hP.hom_ext
        · rw [Category.comp_id, ← Category.assoc, hP.inl_desc]
          ext a
          rfl
        · rw [Category.comp_id, ← Category.assoc, hP.inr_desc]
          ext a
          rfl
      have hx : (S.subtype (d x)) = x := by
        have := ConcreteCategory.congr_hom hε x
        exact this
      rw [← hx]
      exact (d x).property
    have s3 : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y) (U : Y.Opens) (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U),
        (f.resLE U V e).appTop ≫ V.topIso.hom = U.topIso.hom ≫ f.appLE U V e := by
      intro X Y f U V e
      rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE, Scheme.Hom.resLE_appLE,
        Scheme.Opens.topIso_hom, Scheme.Opens.topIso_hom]
      erw [Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
    have hP : IsPullback
        ((Limits.prod.fst : X ⨯ Y ⟶ X).resLE U ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓
          (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V) inf_le_left)
        ((Limits.prod.snd : X ⨯ Y ⟶ Y).resLE V ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓
          (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V) inf_le_right)
        (Limits.terminal.from (U : Scheme.{u})) (Limits.terminal.from (V : Scheme.{u})) := by
      have comm : (Limits.prod.fst : X ⨯ Y ⟶ X).resLE U ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓
          (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V) inf_le_left ≫ Limits.terminal.from (U : Scheme.{u}) =
          (Limits.prod.snd : X ⨯ Y ⟶ Y).resLE V ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓
          (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V) inf_le_right ≫ Limits.terminal.from (V : Scheme.{u}) :=
        Limits.terminal.hom_ext _ _
      have hrange : ∀ (s : Limits.PullbackCone (Limits.terminal.from (U : Scheme.{u}))
          (Limits.terminal.from (V : Scheme.{u}))),
          Set.range (Limits.prod.lift (s.fst ≫ U.ι) (s.snd ≫ V.ι)) ⊆
            Set.range ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V).ι := by
        intro s
        rw [Scheme.Opens.range_ι]
        rintro _ ⟨x, rfl⟩
        refine ⟨?_, ?_⟩
        · show (Limits.prod.fst : X ⨯ Y ⟶ X) (Limits.prod.lift (s.fst ≫ U.ι) (s.snd ≫ V.ι) x) ∈ U
          rw [← Scheme.Hom.comp_apply, Limits.prod.lift_fst, Scheme.Hom.comp_apply]
          have h : U.ι (s.fst x) ∈ Set.range U.ι := ⟨_, rfl⟩
          rwa [Scheme.Opens.range_ι] at h
        · show (Limits.prod.snd : X ⨯ Y ⟶ Y) (Limits.prod.lift (s.fst ≫ U.ι) (s.snd ≫ V.ι) x) ∈ V
          rw [← Scheme.Hom.comp_apply, Limits.prod.lift_snd, Scheme.Hom.comp_apply]
          have h : V.ι (s.snd x) ∈ Set.range V.ι := ⟨_, rfl⟩
          rwa [Scheme.Opens.range_ι] at h
      refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk _ _ comm) ?_
      refine Limits.PullbackCone.IsLimit.mk comm
        (fun s => IsOpenImmersion.lift _ _ (hrange s)) ?_ ?_ ?_
      · intro s
        rw [← cancel_mono U.ι, Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc,
          IsOpenImmersion.lift_fac, Limits.prod.lift_fst]
      · intro s
        rw [← cancel_mono V.ι, Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc,
          IsOpenImmersion.lift_fac, Limits.prod.lift_snd]
      · intro s m h1 h2
        apply IsOpenImmersion.lift_uniq
        apply Limits.prod.hom_ext
        · rw [Limits.prod.lift_fst, ← h1, Category.assoc, Category.assoc, Scheme.Hom.resLE_comp_ι]
        · rw [Limits.prod.lift_snd, ← h2, Category.assoc, Category.assoc, Scheme.Hom.resLE_comp_ι]
    haveI : IsAffine (U : Scheme.{u}) := hU
    haveI : IsAffine (V : Scheme.{u}) := hV
    have hWaff : IsAffineOpen ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓
        (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V) := IsAffine.of_isIso hP.isoPullback.hom
    have hgen := s2 _ _ _ _ _ _ _ _ (isPushout_appTop_of_isPullback hP)
    refine ⟨hWaff, fun t => ?_⟩
    have ht : ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V).topIso.hom
        (((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V).topIso.inv t)
        = t := by
      exact ConcreteCategory.congr_hom
        ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V).topIso.inv_hom_id t
    rw [← ht, ← Subring.mem_comap]
    refine (Subring.closure_le.mpr ?_) (hgen _)
    rintro _ (⟨y, rfl⟩ | ⟨z, rfl⟩)
    · rw [SetLike.mem_coe, Subring.mem_comap]
      apply Subring.subset_closure
      left
      refine ⟨U.topIso.hom y, ?_⟩
      have h := ConcreteCategory.congr_hom (s3 _ _ (Limits.prod.fst : X ⨯ Y ⟶ X) U
        ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V) inf_le_left) y
      exact h.symm
    · rw [SetLike.mem_coe, Subring.mem_comap]
      apply Subring.subset_closure
      right
      refine ⟨V.topIso.hom z, ?_⟩
      have h := ConcreteCategory.congr_hom (s3 _ _ (Limits.prod.snd : X ⨯ Y ⟶ Y) V
        ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V) inf_le_right) z
      exact h.symm

  have hC : IsAffineOpen (wcPmChart.{u} m k) :=
    (@Proj.isAffineOpen_basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) MvPolynomial.gradedAlgebra
      (MvPolynomial.X k) 1 ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr
        (MvPolynomial.isHomogeneous_X _ k)) one_pos : IsAffineOpen (wcPmChart.{u} m k))

  have s1 : ∀ (U : X.Opens) (C : (wcPm.{u} m).Opens), IsAffineOpen U → IsAffineOpen C →
      IsAffineOpen (p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C) ∧ ∀ t : Γ(Z, p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C), t ∈ Subring.closure
        (Set.range ((Z.presheaf.map (homOfLE (inf_le_left : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ p ⁻¹ᵁ U)).op).hom.comp
          (p.app U).hom) ∪
        Set.range ((Z.presheaf.map (homOfLE (inf_le_right : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ g ⁻¹ᵁ C)).op).hom.comp
          (g.app C).hom)) := by
    intro U C hU hC
    obtain ⟨hO', hgen⟩ := hprod X (wcPm.{u} m) U C hU hC
    obtain ⟨hAff, hsurj⟩ := isClosedImmersion_iff_isAffineHom.mp hΛ
    haveI := hAff
    set O' := (Limits.prod.fst : X ⨯ wcPm.{u} m ⟶ X) ⁻¹ᵁ U ⊓
      (Limits.prod.snd : X ⨯ wcPm.{u} m ⟶ wcPm.{u} m) ⁻¹ᵁ C with hO'def
    have hV : (Limits.prod.lift p g) ⁻¹ᵁ O' = p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C := by
      rw [hO'def, Scheme.Hom.preimage_inf, ← Scheme.Hom.comp_preimage, ← Scheme.Hom.comp_preimage,
        Limits.prod.lift_fst, Limits.prod.lift_snd]
    refine ⟨by rw [← hV]; exact hO'.preimage _, fun t => ?_⟩
    have hθs : ∀ (W : Z.Opens) (eW : (Limits.prod.lift p g) ⁻¹ᵁ O' = W),
        Function.Surjective ((Limits.prod.lift p g).appLE O' W eW.ge) := by
      intro W eW
      subst eW
      rw [Scheme.Hom.appLE_eq_app]
      exact hsurj _ hO'
    have gL : ∀ x : Γ(X, U), (Limits.prod.lift p g).appLE O' (p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C) hV.ge
        ((X ⨯ wcPm.{u} m).presheaf.map (homOfLE (inf_le_left :
          O' ≤ (Limits.prod.fst : X ⨯ wcPm.{u} m ⟶ X) ⁻¹ᵁ U)).op
          ((Limits.prod.fst : X ⨯ wcPm.{u} m ⟶ X).app U x)) =
        Z.presheaf.map (homOfLE (inf_le_left : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ p ⁻¹ᵁ U)).op (p.app U x) := by
      intro x
      have aux : ∀ (q : Z ⟶ X) (hq : q = p) (e' : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ q ⁻¹ᵁ U),
          q.appLE U (p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C) e' =
          p.app U ≫ Z.presheaf.map (homOfLE (inf_le_left : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ p ⁻¹ᵁ U)).op := by
        intro q hq e'
        subst hq
        rfl
      have hm : (Limits.prod.fst : X ⨯ wcPm.{u} m ⟶ X).app U ≫
          (X ⨯ wcPm.{u} m).presheaf.map (homOfLE (inf_le_left :
            O' ≤ (Limits.prod.fst : X ⨯ wcPm.{u} m ⟶ X) ⁻¹ᵁ U)).op ≫
          (Limits.prod.lift p g).appLE O' (p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C) hV.ge =
          p.app U ≫ Z.presheaf.map (homOfLE (inf_le_left : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ p ⁻¹ᵁ U)).op := by
        rw [Scheme.Hom.map_appLE, Scheme.Hom.app_eq_appLE (Limits.prod.fst : X ⨯ wcPm.{u} m ⟶ X),
          Scheme.Hom.appLE_comp_appLE]
        exact aux _ (Limits.prod.lift_fst p g) _
      exact congrArg (fun f => f.hom x) hm
    have gR : ∀ y : Γ(wcPm.{u} m, C), (Limits.prod.lift p g).appLE O' (p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C) hV.ge
        ((X ⨯ wcPm.{u} m).presheaf.map (homOfLE (inf_le_right :
          O' ≤ (Limits.prod.snd : X ⨯ wcPm.{u} m ⟶ wcPm.{u} m) ⁻¹ᵁ C)).op
          ((Limits.prod.snd : X ⨯ wcPm.{u} m ⟶ wcPm.{u} m).app C y)) =
        Z.presheaf.map (homOfLE (inf_le_right : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ g ⁻¹ᵁ C)).op (g.app C y) := by
      intro y
      have aux : ∀ (q : Z ⟶ wcPm.{u} m) (hq : q = g) (e' : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ q ⁻¹ᵁ C),
          q.appLE C (p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C) e' =
          g.app C ≫ Z.presheaf.map (homOfLE (inf_le_right : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ g ⁻¹ᵁ C)).op := by
        intro q hq e'
        subst hq
        rfl
      have hm : (Limits.prod.snd : X ⨯ wcPm.{u} m ⟶ wcPm.{u} m).app C ≫
          (X ⨯ wcPm.{u} m).presheaf.map (homOfLE (inf_le_right :
            O' ≤ (Limits.prod.snd : X ⨯ wcPm.{u} m ⟶ wcPm.{u} m) ⁻¹ᵁ C)).op ≫
          (Limits.prod.lift p g).appLE O' (p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C) hV.ge =
          g.app C ≫ Z.presheaf.map (homOfLE (inf_le_right : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ g ⁻¹ᵁ C)).op := by
        rw [Scheme.Hom.map_appLE,
          Scheme.Hom.app_eq_appLE (Limits.prod.snd : X ⨯ wcPm.{u} m ⟶ wcPm.{u} m),
          Scheme.Hom.appLE_comp_appLE]
        exact aux _ (Limits.prod.lift_snd p g) _
      exact congrArg (fun f => f.hom y) hm
    obtain ⟨u, rfl⟩ := hθs _ hV t
    apply Subring.mem_comap.mp
    refine Subring.closure_le.mpr ?_ (hgen u)
    rintro _ (⟨x, rfl⟩ | ⟨y, rfl⟩)
    · exact Subring.mem_comap.mpr (Subring.subset_closure (Or.inl ⟨x, (gL x).symm⟩))
    · exact Subring.mem_comap.mpr (Subring.subset_closure (Or.inr ⟨y, (gR y).symm⟩))

  have s3 : ∀ (A R S : Type u) [CommRing A] [CommRing R] [CommRing S] (φ : A →+* S) (ψ : R →+* S)
      (n : ℕ) (e : Fin n → R),
      (∀ r : R, ∃ q : MvPolynomial (Fin n) ℤ, MvPolynomial.eval₂ (Int.castRingHom R) e q = r) →
      ∀ t : S, t ∈ Subring.closure (Set.range φ ∪ Set.range ψ) →
      ∃ P : MvPolynomial (Fin n) A, MvPolynomial.eval₂ φ (fun l => ψ (e l)) P = t := by
    intro A R S _ _ _ φ ψ n e he t ht
    have hle : Subring.closure (Set.range φ ∪ Set.range ψ) ≤
        (MvPolynomial.eval₂Hom φ (fun l => ψ (e l))).range := by
      rw [Subring.closure_le]
      rintro _ (⟨a, rfl⟩ | ⟨r, rfl⟩)
      · exact ⟨MvPolynomial.C a, MvPolynomial.eval₂_C _ _ _⟩
      · obtain ⟨q, rfl⟩ := he r
        refine ⟨MvPolynomial.map (Int.castRingHom A) q, ?_⟩
        rw [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_map, MvPolynomial.eval₂_comp_left,
          RingHom.ext_int (φ.comp (Int.castRingHom A)) (ψ.comp (Int.castRingHom R))]
        rfl
    obtain ⟨P, hP⟩ := RingHom.mem_range.mp (hle ht)
    exact ⟨P, hP⟩

  obtain ⟨hAff, hcl⟩ := s1 W (wcPmChart.{u} m k) hW hC
  refine ⟨hAff, fun s => ?_⟩
  exact s3 _ _ _ _ _ (m + 1) (e k) (he.2.2.2 k) s (hcl s)

theorem wcpa_dj_cgs_chart_gen_top : ∀ (B : Type u) [CommRing B] (Y : Scheme.{u}) (hY : Y ⟶ Spec (.of B)) (m : ℕ) (g : Y ⟶ wcPm.{u} m) (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)), wcGsCoords m e → IsClosedImmersion (Limits.prod.lift hY g) → (∀ k, IsAffineOpen (⊤ ⊓ g ⁻¹ᵁ wcPmChart m k)) ∧ ∀ k (s : Γ(Y, ⊤ ⊓ g ⁻¹ᵁ wcPmChart m k)), ∃ P : MvPolynomial (Fin (m + 1)) B, MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (inf_le_left : ⊤ ⊓ g ⁻¹ᵁ wcPmChart m k ≤ ⊤)).op).hom.comp (wcCnSigma hY ⊤)) (fun l => (Y.presheaf.map (homOfLE (inf_le_right : ⊤ ⊓ g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l))) P = s :=
by
  have gen : ∀ (A : Type u) [CommRing A] (Y : Scheme.{u}) (hY : Y ⟶ Spec (.of A)) (m : ℕ) (g : Y ⟶ wcPm.{u} m), IsClosedImmersion (Limits.prod.lift hY g) → ∀ (k : Fin (m + 1)) (e : Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)), (∀ s : Γ(wcPm.{u} m, wcPmChart m k), ∃ p : MvPolynomial (Fin (m + 1)) ℤ, MvPolynomial.eval₂ (Int.castRingHom _) e p = s) → ∀ s : Γ(Y, g ⁻¹ᵁ wcPmChart m k), ∃ p : MvPolynomial (Fin (m + 1)) A, MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (le_top : g ⁻¹ᵁ wcPmChart m k ≤ ⊤)).op).hom.comp (hY.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (fun l => g.app (wcPmChart m k) (e l)) p = s := by

    have s1 : ∀ (R A B P : CommRingCat.{u}) (f : R ⟶ A) (g : R ⟶ B) (inl : A ⟶ P) (inr : B ⟶ P),
        IsPushout f g inl inr → ∀ x : P, x ∈ Subring.closure (Set.range inl.hom ∪ Set.range inr.hom) := by
      intro R A B P f g inl inr hP x
      let S := Subring.closure (Set.range inl.hom ∪ Set.range inr.hom)
      let inl' : A ⟶ CommRingCat.of S := CommRingCat.ofHom (RingHom.codRestrict inl.hom S
        (fun a => Subring.subset_closure (Or.inl ⟨a, rfl⟩)))
      let inr' : B ⟶ CommRingCat.of S := CommRingCat.ofHom (RingHom.codRestrict inr.hom S
        (fun b => Subring.subset_closure (Or.inr ⟨b, rfl⟩)))
      have hw : f ≫ inl' = g ≫ inr' := by
        ext y
        exact ConcreteCategory.congr_hom hP.w y
      let d := hP.desc inl' inr' hw
      have hε : d ≫ CommRingCat.ofHom S.subtype = 𝟙 P := by
        apply hP.hom_ext
        · rw [Category.comp_id, ← Category.assoc, hP.inl_desc]
          ext a
          rfl
        · rw [Category.comp_id, ← Category.assoc, hP.inr_desc]
          ext a
          rfl
      have hx : (S.subtype (d x)) = x := by
        have := ConcreteCategory.congr_hom hε x
        exact this
      rw [← hx]
      exact (d x).property

    have s2 : ∀ (A : Type u) [CommRing A] (X : Scheme.{u}) (D : X.Opens), IsAffineOpen D →
        IsPushout ((Limits.terminal.from X).appTop ≫ X.presheaf.map (homOfLE (le_top : D ≤ ⊤)).op)
          ((Limits.terminal.from (Spec (.of A))).appTop ≫ (Scheme.ΓSpecIso (.of A)).hom)
          ((Limits.prod.snd : Spec (.of A) ⨯ X ⟶ X).app D)
          ((Scheme.ΓSpecIso (.of A)).inv ≫ (Limits.prod.fst : Spec (.of A) ⨯ X ⟶ Spec (.of A)).appTop ≫
            (Spec (.of A) ⨯ X).presheaf.map
              (homOfLE (le_top : (Limits.prod.snd : Spec (.of A) ⨯ X ⟶ X) ⁻¹ᵁ D ≤ ⊤)).op) := by
      intro A _ X D hD
      set P := Spec (.of A) ⨯ X
      set q : P ⟶ X := Limits.prod.snd
      set r : P ⟶ Spec (.of A) := Limits.prod.fst
      have : IsAffine D := hD
      have Sq : IsPullback (q ∣_ D) ((q ⁻¹ᵁ D).ι ≫ r) (D.ι ≫ Limits.terminal.from X)
          (Limits.terminal.from (Spec (.of A))) :=
        IsPullback.paste_vert (isPullback_morphismRestrict q D)
          (IsPullback.of_hasBinaryProduct' (Spec (.of A)) X).flip
      have Po := isPushout_appTop_of_isPullback Sq
      refine IsPushout.of_iso Po (Iso.refl _) D.topIso (Scheme.ΓSpecIso (.of A)) (q ⁻¹ᵁ D).topIso
        ?_ ?_ ?_ ?_
      · rw [Iso.refl_hom, Category.id_comp, Scheme.Hom.comp_appTop, Category.assoc]
        congr 1
        rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
        exact (X.presheaf.map_comp _ _).symm
      · rw [Iso.refl_hom, Category.id_comp]
      · rw [morphismRestrict_appTop, Scheme.Opens.topIso_hom, Scheme.Opens.topIso_hom]
        show (q.app (D.ι ''ᵁ ⊤) ≫ P.presheaf.map (homOfLE (by rw [Scheme.Opens.ι_image_top, Scheme.Opens.ι_image_top]) : (q ⁻¹ᵁ D).ι ''ᵁ ⊤ ⟶ q ⁻¹ᵁ (D.ι ''ᵁ ⊤)).op) ≫ P.presheaf.map (homOfLE (by rw [Scheme.Opens.ι_image_top]) : q ⁻¹ᵁ D ⟶ (q ⁻¹ᵁ D).ι ''ᵁ ⊤).op = X.presheaf.map (homOfLE (by rw [Scheme.Opens.ι_image_top]) : D ⟶ D.ι ''ᵁ ⊤).op ≫ q.app D
        rw [Category.assoc, ← Functor.map_comp, Scheme.Hom.naturality]
        rfl
      · rw [Iso.hom_inv_id_assoc, Scheme.Hom.comp_appTop, Category.assoc]
        congr 1
        rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
        exact (P.presheaf.map_comp _ _).symm

    have s6 : ∀ (X Y T : Scheme.{u}) (ι : X ⟶ Y) (q : Y ⟶ T) (V : Y.Opens) (v : Γ(T, ⊤)),
        X.presheaf.map (homOfLE (le_top : ι ⁻¹ᵁ V ≤ ⊤)).op ((ι ≫ q).appTop v) =
          ι.app V (Y.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (q.appTop v)) := by
      intro X Y T ι q V v
      have h := Scheme.Hom.naturality ι (homOfLE (le_top : V ≤ ⊤)).op
      have h2 := congrArg (fun φ => (CommRingCat.Hom.hom φ) (q.appTop v)) h
      exact h2.symm

    have s3 : ∀ (A : Type u) [CommRing A] (Y P X : Scheme.{u}) (ι : Y ⟶ P) (q : P ⟶ X)
        (r : P ⟶ Spec (.of A)) (g : Y ⟶ X) (hY : Y ⟶ Spec (.of A)) (D : X.Opens),
        IsClosedImmersion ι → ι ≫ q = g → ι ≫ r = hY → IsAffineOpen (q ⁻¹ᵁ D) →
        (∀ t : Γ(P, q ⁻¹ᵁ D), t ∈ Subring.closure (Set.range (q.app D).hom ∪
          Set.range ((P.presheaf.map (homOfLE (le_top : q ⁻¹ᵁ D ≤ ⊤)).op).hom.comp
            (r.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)))) →
        ∀ s : Γ(Y, g ⁻¹ᵁ D), s ∈ Subring.closure (Set.range (g.app D).hom ∪
          Set.range ((Y.presheaf.map (homOfLE (le_top : g ⁻¹ᵁ D ≤ ⊤)).op).hom.comp
            (hY.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom))) := by
      intro A _ Y P X ι q r g hY D hι hq hr hW hgen s
      subst hq
      subst hr
      haveI := hι
      obtain ⟨t, ht⟩ := Scheme.Hom.app_surjective ι (q ⁻¹ᵁ D) hW s
      have hle := (Subring.closure_le (t := Subring.comap (ι.app (q ⁻¹ᵁ D)).hom
        (Subring.closure (Set.range ((ι ≫ q).app D).hom ∪
          Set.range ((Y.presheaf.map (homOfLE (le_top : (ι ≫ q) ⁻¹ᵁ D ≤ ⊤)).op).hom.comp
            ((ι ≫ r).appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)))))).mpr (by
        rintro _ (⟨y, rfl⟩ | ⟨a, rfl⟩)
        · refine Subring.mem_comap.mpr (Subring.subset_closure (Or.inl ⟨y, ?_⟩))
          rw [Scheme.Hom.comp_app]
          rfl
        · refine Subring.mem_comap.mpr (Subring.subset_closure (Or.inr ⟨a, ?_⟩))
          exact s6 Y P (Spec (.of A)) ι r (q ⁻¹ᵁ D) _) (hgen t)
      rw [← ht]
      exact Subring.mem_comap.mp hle

    have s4 : ∀ (A B R : Type u) [CommRing A] [CommRing B] [CommRing R] (n : ℕ) (σ : A →+* R)
        (φ : B →+* R) (e : Fin n → B),
        (∀ b : B, ∃ q : MvPolynomial (Fin n) ℤ, MvPolynomial.eval₂ (Int.castRingHom B) e q = b) →
        ∀ s ∈ Subring.closure (Set.range φ ∪ Set.range σ),
          ∃ p : MvPolynomial (Fin n) A, MvPolynomial.eval₂ σ (fun l => φ (e l)) p = s := by
      intro A B R _ _ _ n σ φ e he s hs
      have hle : Subring.closure (Set.range φ ∪ Set.range σ) ≤
          (MvPolynomial.eval₂Hom σ (fun l => φ (e l))).range := by
        rw [Subring.closure_le]
        rintro _ (⟨b, rfl⟩ | ⟨a, rfl⟩)
        · obtain ⟨q, rfl⟩ := he b
          refine RingHom.mem_range.mpr ⟨MvPolynomial.map (Int.castRingHom A) q, ?_⟩
          have hz : σ.comp (Int.castRingHom A) = φ.comp (Int.castRingHom B) := RingHom.ext_int _ _
          rw [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_map, hz]
          exact (MvPolynomial.eval₂_comp_left φ (Int.castRingHom B) e q).symm
        · exact RingHom.mem_range.mpr ⟨MvPolynomial.C a, by
            rw [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_C]⟩
      obtain ⟨p, hp⟩ := RingHom.mem_range.mp (hle hs)
      exact ⟨p, hp⟩

    intro A _ Y hY m g hι k e he s
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) :=
      MvPolynomial.gradedAlgebra
    have hD : IsAffineOpen (wcPmChart.{u} m k) :=
      Proj.isAffineOpen_basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ))
        (MvPolynomial.X k) (m := 1)
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)) Nat.one_pos
    haveI hsnd : IsAffineHom (Limits.prod.snd : Spec (.of A) ⨯ wcPm.{u} m ⟶ wcPm.{u} m) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasBinaryProduct' (Spec (.of A)) (wcPm.{u} m))
        (inferInstance : IsAffineHom (Limits.terminal.from (Spec (.of A))))
    have hW : IsAffineOpen ((Limits.prod.snd : Spec (.of A) ⨯ wcPm.{u} m ⟶ wcPm.{u} m) ⁻¹ᵁ
        wcPmChart.{u} m k) := hD.preimage _
    have hgenP := fun t => s1 _ _ _ _ _ _ _ _ (s2 A (wcPm.{u} m) (wcPmChart.{u} m k) hD) t
    have hgenY := s3 A Y (Spec (.of A) ⨯ wcPm.{u} m) (wcPm.{u} m) (Limits.prod.lift hY g)
      Limits.prod.snd Limits.prod.fst g hY (wcPmChart.{u} m k) hι (Limits.prod.lift_snd hY g)
      (Limits.prod.lift_fst hY g) hW hgenP
    exact s4 A Γ(wcPm.{u} m, wcPmChart m k) Γ(Y, g ⁻¹ᵁ wcPmChart m k) (m + 1) _
      (g.app (wcPmChart m k)).hom e he s (hgenY s)

  intro B _ Y hY m g e he hΛ
  obtain ⟨-, -, -, he4⟩ := he
  have hDa : ∀ k, IsAffineOpen (g ⁻¹ᵁ wcPmChart m k) := by
    intro k
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) :=
      MvPolynomial.gradedAlgebra
    have hD : IsAffineOpen (wcPmChart.{u} m k) :=
      Proj.isAffineOpen_basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ))
        (MvPolynomial.X k) (m := 1)
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)) Nat.one_pos
    haveI hsnd : IsAffineHom (Limits.prod.snd : Spec (.of B) ⨯ wcPm.{u} m ⟶ wcPm.{u} m) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasBinaryProduct' (Spec (.of B)) (wcPm.{u} m))
        (inferInstance : IsAffineHom (Limits.terminal.from (Spec (.of B))))
    have hW : IsAffineOpen ((Limits.prod.snd : Spec (.of B) ⨯ wcPm.{u} m ⟶ wcPm.{u} m) ⁻¹ᵁ
        wcPmChart.{u} m k) := hD.preimage _
    haveI := hΛ
    have h3 := hW.preimage (Limits.prod.lift hY g)
    have h4 : g ⁻¹ᵁ wcPmChart.{u} m k = Limits.prod.lift hY g ⁻¹ᵁ
        ((Limits.prod.snd : Spec (.of B) ⨯ wcPm.{u} m ⟶ wcPm.{u} m) ⁻¹ᵁ wcPmChart.{u} m k) := by
      conv_lhs => rw [← Limits.prod.lift_snd hY g]
      rfl
    rw [h4]
    exact h3
  refine ⟨fun k => ?_, fun k s => ?_⟩
  · rw [top_inf_eq]; exact hDa k
  · have hle : g ⁻¹ᵁ wcPmChart m k ≤ ⊤ ⊓ g ⁻¹ᵁ wcPmChart m k := le_inf le_top le_rfl
    have hρρ' : (Y.presheaf.map (homOfLE (inf_le_right : ⊤ ⊓ g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom
        ((Y.presheaf.map (homOfLE hle).op).hom s) = s := by
      rw [← CommRingCat.comp_apply, ← Functor.map_comp]
      have h1 : (homOfLE hle).op ≫ (homOfLE (inf_le_right : ⊤ ⊓ g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m k)).op = 𝟙 _ := rfl
      rw [h1, CategoryTheory.Functor.map_id, CommRingCat.id_apply]
    obtain ⟨p, hp⟩ := gen B Y hY m g hΛ k (e k) (he4 k) ((Y.presheaf.map (homOfLE hle).op).hom s)
    refine ⟨p, ?_⟩
    have hc : ((Y.presheaf.map (homOfLE (inf_le_right : ⊤ ⊓ g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom).comp
        ((Y.presheaf.map (homOfLE (le_top : g ⁻¹ᵁ wcPmChart m k ≤ ⊤)).op).hom.comp
          (hY.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) =
        (Y.presheaf.map (homOfLE (inf_le_left : ⊤ ⊓ g ⁻¹ᵁ wcPmChart m k ≤ ⊤)).op).hom.comp (wcCnSigma hY ⊤) := by
      have hrr : ∀ (U V W : Y.Opens) (h1 : V ≤ U) (h2 : W ≤ V) (h3 : W ≤ U) (x : Γ(Y, U)),
          (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
            (Y.presheaf.map (homOfLE h3).op).hom x := by
        intro U V W h1 h2 h3 x
        rw [← CommRingCat.comp_apply, ← Functor.map_comp]
        rfl
      apply RingHom.ext
      intro b
      change (Y.presheaf.map (homOfLE (inf_le_right : ⊤ ⊓ g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom
          ((Y.presheaf.map (homOfLE (le_top : g ⁻¹ᵁ wcPmChart m k ≤ ⊤)).op).hom
            ((hY.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom) b)) =
        (Y.presheaf.map (homOfLE (inf_le_left : ⊤ ⊓ g ⁻¹ᵁ wcPmChart m k ≤ ⊤)).op).hom
          ((Y.presheaf.map (homOfLE (le_top : (⊤ : Y.Opens) ≤ ⊤)).op).hom
            ((hY.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom) b))
      rw [hrr _ _ _ _ _ (le_top : ⊤ ⊓ g ⁻¹ᵁ wcPmChart m k ≤ ⊤),
        hrr _ _ _ _ _ (le_top : ⊤ ⊓ g ⁻¹ᵁ wcPmChart m k ≤ ⊤)]
    have key := congrArg (Y.presheaf.map (homOfLE (inf_le_right : ⊤ ⊓ g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom hp
    rw [hρρ'] at key
    rw [← hc]
    exact (MvPolynomial.eval₂_comp_left _ _ _ p).symm.trans key

theorem wcpa_dj_cgs_affine_cech_acyclic : ∀ (Y : Scheme.{u}) (M : Y.Modules), wcQcoh M → ∀ (U : Y.Opens), IsAffineOpen U → ∀ {r : ℕ} (O : Fin r → Y.Opens), (∀ y ∈ U, ∃ i, y ∈ O i) → (∀ (p : ℕ) (a : Fin (p + 1) ↪o Fin r), IsAffineOpen (wcAcV O U a)) → ∀ (q : ℕ) (z : wcAcC M O U (q + 1)), wcAcD M O U (q + 1) z = 0 → ∃ x : wcAcC M O U q, z = wcAcD M O U q x :=
by
  intro Y M hM U hU r O hcov hnerve
  classical

  have hsq : ∀ n : ℕ, ((-1 : ℤ) ^ n * (-1) ^ n) = 1 := fun n => by
    rw [← mul_pow]; norm_num
  have hres : ∀ {V1 V2 V3 : Y.Opens} (h1 : V2 ≤ V1) (h2 : V3 ≤ V2) (x : Γ(M, V1)),
      (M.presheaf.map (homOfLE h2).op).hom ((M.presheaf.map (homOfLE h1).op).hom x) =
        (M.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro V1 V2 V3 h1 h2 x
    change (M.presheaf.map (homOfLE h1).op ≫ M.presheaf.map (homOfLE h2).op).hom x = _
    rw [← CategoryTheory.Functor.map_comp]
    rfl
  have hresY : ∀ {V1 V2 V3 : Y.Opens} (h1 : V2 ≤ V1) (h2 : V3 ≤ V2) (x : Γ(Y, V1)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
        (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro V1 V2 V3 h1 h2 x
    change (Y.presheaf.map (homOfLE h1).op ≫ Y.presheaf.map (homOfLE h2).op).hom x = _
    rw [← CategoryTheory.Functor.map_comp]
    rfl
  have hrefl : ∀ {V : Y.Opens} (h : V ≤ V) (x : Γ(M, V)),
      (M.presheaf.map (homOfLE h).op).hom x = x := by
    intro V h x
    change (M.presheaf.map (𝟙 (Opposite.op V))).hom x = x
    rw [CategoryTheory.Functor.map_id]
    rfl
  have hresEq : ∀ {W : Y.Opens} {p : ℕ} (y : wcAcC M O W p) (c c' : Fin (p + 1) ↪o Fin r),
      c = c' → ∀ {V : Y.Opens} (h : V ≤ wcAcV O W c) (h' : V ≤ wcAcV O W c'),
      (M.presheaf.map (homOfLE h).op).hom (y c) = (M.presheaf.map (homOfLE h').op).hom (y c') := by
    intro W p y c c' hc V h h'
    subst hc
    rfl
  have hface : ∀ {W : Y.Opens} {p : ℕ} (a : Fin (p + 2) ↪o Fin r) (k : Fin (p + 2)),
      wcAcV O W a ≤ wcAcV O W ((Fin.succAboveOrderEmb k).trans a) := fun a k =>
    inf_le_inf_right _ (le_iInf fun i => iInf_le (fun j => O (a j)) _)
  have hD : ∀ {W : Y.Opens} {p : ℕ} (y : wcAcC M O W p) (a : Fin (p + 2) ↪o Fin r),
      wcAcD M O W p y a = ∑ k : Fin (p + 2), ((-1 : ℤ) ^ (k : ℕ)) •
        (M.presheaf.map (homOfLE (hface a k)).op).hom (y ((Fin.succAboveOrderEmb k).trans a)) :=
    fun _ _ => rfl
  have hVmem : ∀ {W : Y.Opens} {n : ℕ} (c : Fin (n + 1) ↪o Fin r) (m : Fin (n + 1)),
      wcAcV O W c ≤ O (c m) := fun c m => inf_le_left.trans (iInf_le _ m)

  have s1 : ∀ (W W' : Y.Opens) (h : W' ≤ W) (p : ℕ) (z : wcAcC M O W p),
      wcAcD M O W' p (fun a => (M.presheaf.map (homOfLE (inf_le_inf_left _ h :
        wcAcV O W' a ≤ wcAcV O W a)).op).hom (z a)) =
      fun a => (M.presheaf.map (homOfLE (inf_le_inf_left _ h :
        wcAcV O W' a ≤ wcAcV O W a)).op).hom (wcAcD M O W p z a) := by
    intro W W' h p z
    funext a
    rw [hD (W := W') _ a, hD (W := W) _ a, map_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [map_zsmul, hres, hres]

  have s2 : ∀ (W : Y.Opens) (c : Γ(Y, W)) (p : ℕ) (z : wcAcC M O W p),
      wcAcD M O W p (fun a => (Y.presheaf.map (homOfLE (inf_le_right :
        wcAcV O W a ≤ W)).op).hom c • z a) =
      fun a => (Y.presheaf.map (homOfLE (inf_le_right : wcAcV O W a ≤ W)).op).hom c •
        wcAcD M O W p z a := by
    intro W c p z
    funext a
    rw [hD (W := W) _ a, hD (W := W) _ a, Finset.smul_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [Scheme.Modules.map_smul, hresY, smul_comm]
  have hinj : ∀ {V W' : Y.Opens} (h1 : W' ≤ V) (h2 : V ≤ W') (y y' : Γ(M, V)),
      (M.presheaf.map (homOfLE h1).op).hom y = (M.presheaf.map (homOfLE h1).op).hom y' →
        y = y' := by
    intro V W' h1 h2 y y' h
    have := congrArg (M.presheaf.map (homOfLE h2).op).hom h
    rwa [hres, hres, hrefl, hrefl] at this

  have hR : ∀ {n : ℕ} (c : Fin (n + 2) ↪o Fin r) (m : Fin (n + 2)),
      Set.range ((Fin.succAboveOrderEmb m).trans c) = Set.range c \ {c m} := by
    intro n c m
    ext y
    simp only [Set.mem_range, RelEmbedding.coe_trans, RelEmbedding.trans_apply,
      Function.comp_apply, Fin.succAboveOrderEmb_apply, Set.mem_diff, Set.mem_singleton_iff]
    constructor
    · rintro ⟨k, rfl⟩
      exact ⟨⟨_, rfl⟩, fun h => Fin.succAbove_ne m k (c.injective h)⟩
    · rintro ⟨⟨t, rfl⟩, ht⟩
      obtain ⟨k, hk⟩ := Fin.exists_succAbove_eq (fun h : t = m => ht (by rw [h]))
      exact ⟨k, by rw [hk]⟩
  have hINC : ∀ (W : Y.Opens) (i0 : Fin r), W ≤ O i0 → ∀ {n m : ℕ} (c : Fin (n + 1) ↪o Fin r)
      (c' : Fin (m + 1) ↪o Fin r), Set.range c ⊆ insert i0 (Set.range c') →
      wcAcV O W c' ≤ wcAcV O W c := by
    intro W i0 hW n m c c' hsub
    refine le_inf (le_iInf fun k => ?_) inf_le_right
    rcases (Set.mem_insert_iff.mp (hsub ⟨k, rfl⟩)) with h | ⟨l, hl⟩
    · rw [h]; exact inf_le_right.trans hW
    · rw [← hl]; exact hVmem c' l
  have hsgn : ∀ a b c d : ℕ, a + b = c + d + 1 →
      (-1 : ℤ) ^ c * (-1) ^ d = -((-1) ^ a * (-1) ^ b) := by
    intro a b c d h
    rw [← pow_add, ← pow_add, h, pow_succ]
    ring
  have hsign : ∀ {n : ℕ} (J : Fin (n + 2)) (k j : Fin (n + 1)),
      (J.succAbove k).succAbove j = J → (J : ℕ) + (J.succAbove k : ℕ) = k + j + 1 := by
    intro n J k j h
    rcases Fin.lt_or_le k.castSucc J with hk | hk
    · rw [Fin.succAbove_of_castSucc_lt _ _ hk] at h ⊢
      have hk' := Fin.lt_iff_val_lt_val.mp hk
      rcases Fin.lt_or_le j.castSucc k.castSucc with hj | hj
      · rw [Fin.succAbove_of_castSucc_lt _ _ hj] at h
        have h1 := congrArg Fin.val h
        have hj' := Fin.lt_iff_val_lt_val.mp hj
        simp only [Fin.val_succ, Fin.val_castSucc] at h1 hj' hk' ⊢
        omega
      · rw [Fin.succAbove_of_le_castSucc _ _ hj] at h
        have h1 := congrArg Fin.val h
        simp only [Fin.val_succ, Fin.val_castSucc] at h1 hk' ⊢
        omega
    · rw [Fin.succAbove_of_le_castSucc _ _ hk] at h ⊢
      have hk' := Fin.le_iff_val_le_val.mp hk
      rcases Fin.lt_or_le j.castSucc k.succ with hj | hj
      · rw [Fin.succAbove_of_castSucc_lt _ _ hj] at h
        have h1 := congrArg Fin.val h
        simp only [Fin.val_succ, Fin.val_castSucc] at h1 hk' ⊢
        omega
      · rw [Fin.succAbove_of_le_castSucc _ _ hj] at h
        have h1 := congrArg Fin.val h
        have hj' := Fin.le_iff_val_le_val.mp hj
        simp only [Fin.val_succ, Fin.val_castSucc] at h1 hj' hk' ⊢
        omega

  have s3 : ∀ (W : Y.Opens) (i0 : Fin r), W ≤ O i0 → ∀ (q : ℕ) (z : wcAcC M O W (q + 1)),
      wcAcD M O W (q + 1) z = 0 → ∃ x : wcAcC M O W q, z = wcAcD M O W q x := by
    intro W i0 hW q z hz
    have hEX : ∀ (n : ℕ) (a' : Fin (n + 1) ↪o Fin r), i0 ∉ Set.range a' →
        ∃ b : Fin (n + 2) ↪o Fin r, Set.range b = insert i0 (Set.range a') := by
      intro n a' h
      have hnot : i0 ∉ Finset.univ.image a' := by simpa [Set.mem_range] using h
      have hcard : (insert i0 (Finset.univ.image a')).card = n + 2 := by
        rw [Finset.card_insert_of_notMem hnot, Finset.card_image_of_injective _ a'.injective]
        simp
      refine ⟨(insert i0 (Finset.univ.image a')).orderEmbOfFin hcard, ?_⟩
      rw [Finset.range_orderEmbOfFin, Finset.coe_insert, Finset.coe_image, Finset.coe_univ,
        Set.image_univ]
    choose B hB using hEX
    have hJ' : ∀ (n : ℕ) (a' : Fin (n + 1) ↪o Fin r) (h : i0 ∉ Set.range a'),
        ∃ j, B n a' h j = i0 := fun n a' h => by
      have : i0 ∈ Set.range (B n a' h) := by rw [hB]; exact Set.mem_insert _ _
      exact this
    choose J hJ using hJ'
    obtain ⟨x, hx0, hx1⟩ : ∃ x : wcAcC M O W q,
        (∀ a' : Fin (q + 1) ↪o Fin r, i0 ∈ Set.range a' → x a' = 0) ∧
        ∀ (a' : Fin (q + 1) ↪o Fin r) (h : i0 ∉ Set.range a'), x a' = ((-1 : ℤ) ^ (J q a' h : ℕ)) •
          (M.presheaf.map (homOfLE (hINC W i0 hW (n := q + 1) (m := q) (B q a' h) a' (hB q a' h).subset)).op).hom
            (z (B q a' h)) := by
      refine ⟨fun a' => if h : i0 ∈ Set.range a' then 0 else ((-1 : ℤ) ^ (J q a' h : ℕ)) •
          (M.presheaf.map (homOfLE (hINC W i0 hW (n := q + 1) (m := q) (B q a' h) a' (hB q a' h).subset)).op).hom
            (z (B q a' h)), ?_, ?_⟩
      · intro a' h
        show dite _ _ _ = _
        rw [dif_pos h]
      · intro a' h
        show dite _ _ _ = _
        rw [dif_neg h]
    refine ⟨x, ?_⟩
    funext a
    rw [hD (W := W) x a]
    by_cases ha : i0 ∈ Set.range a
    ·
      obtain ⟨j0, hj0⟩ := ha
      rw [Fin.sum_univ_succAbove _ j0, Finset.sum_eq_zero, add_zero]
      · beta_reduce
        have hF : i0 ∉ Set.range ((Fin.succAboveOrderEmb j0).trans a) := by
          rw [hR, ← hj0]; exact fun h => h.2 (Set.mem_singleton _)
        have hBa : B q _ hF = a := OrderEmbedding.range_inj_of_wellFoundedLT.mp (by
          rw [hB, hR, ← hj0, Set.insert_diff_singleton, Set.insert_eq_of_mem (Set.mem_range_self j0)])
        have hJj : J q _ hF = j0 := by
          apply a.injective
          have := hJ q _ hF
          rw [hBa] at this
          rw [this, hj0]
        rw [hx1 _ hF, map_zsmul, hres, smul_smul, hJj, hsq, one_smul]
        exact ((hresEq z _ _ hBa _ le_rfl).trans (hrefl _ _)).symm
      · intro k _
        beta_reduce
        have hmem : i0 ∈ Set.range ((Fin.succAboveOrderEmb (j0.succAbove k)).trans a) := by
          rw [hR, ← hj0]
          exact ⟨⟨j0, rfl⟩, fun h => Fin.succAbove_ne j0 k
            (a.injective (Set.mem_singleton_iff.mp h)).symm⟩
        rw [hx0 _ hmem, map_zero, smul_zero]
    ·
      have hle : wcAcV O W a ≤ wcAcV O W (B (q + 1) a ha) :=
        hINC W i0 hW (n := q + 2) (m := q + 1) (B (q + 1) a ha) a (hB (q + 1) a ha).subset
      have h1 : (Fin.succAboveOrderEmb (J (q + 1) a ha)).trans (B (q + 1) a ha) = a :=
        OrderEmbedding.range_inj_of_wellFoundedLT.mp (by
          rw [hR, hJ (q + 1) a ha, hB (q + 1) a ha, Set.insert_diff_self_of_notMem ha])
      have hfv : ∀ k, B (q + 1) a ha ((J (q + 1) a ha).succAbove k) = a k := fun k =>
        DFunLike.congr_fun h1 k
      have hc := congrFun hz (B (q + 1) a ha)
      rw [hD (W := W) z (B (q + 1) a ha), Fin.sum_univ_succAbove _ (J (q + 1) a ha),
        Pi.zero_apply] at hc
      have hc2 := congrArg (M.presheaf.map (homOfLE hle).op).hom hc
      simp only [map_add, map_sum, map_zsmul, map_zero, hres] at hc2
      have e1 : ∀ (h : wcAcV O W a ≤
          wcAcV O W ((Fin.succAboveOrderEmb (J (q + 1) a ha)).trans (B (q + 1) a ha))),
          (M.presheaf.map (homOfLE h).op).hom
            (z ((Fin.succAboveOrderEmb (J (q + 1) a ha)).trans (B (q + 1) a ha))) = z a :=
        fun h => (hresEq z _ _ h1 h le_rfl).trans (hrefl _ _)
      rw [e1] at hc2
      have hT := add_eq_zero_iff_neg_eq.mp hc2
      have hterm : ∀ k : Fin (q + 2), ((-1 : ℤ) ^ (k : ℕ)) •
          (M.presheaf.map (homOfLE (hface a k)).op).hom (x ((Fin.succAboveOrderEmb k).trans a)) =
          -(((-1 : ℤ) ^ (J (q + 1) a ha : ℕ)) • (((-1 : ℤ) ^ ((J (q + 1) a ha).succAbove k : ℕ)) •
            (M.presheaf.map (homOfLE (hle.trans (hface (B (q + 1) a ha)
              ((J (q + 1) a ha).succAbove k)))).op).hom
              (z ((Fin.succAboveOrderEmb ((J (q + 1) a ha).succAbove k)).trans
                (B (q + 1) a ha))))) := by
        intro k
        have hak : i0 ∉ Set.range ((Fin.succAboveOrderEmb k).trans a) := by
          rw [hR]; exact fun h => ha h.1
        have hBk : B q _ hak =
            (Fin.succAboveOrderEmb ((J (q + 1) a ha).succAbove k)).trans (B (q + 1) a ha) :=
          OrderEmbedding.range_inj_of_wellFoundedLT.mp (by
            rw [hB, hR, hR, hfv k, hB (q + 1) a ha, Set.insert_diff_of_notMem _
              (fun h => ha ⟨k, (Set.mem_singleton_iff.mp h).symm⟩)])
        have hj2 : ((J (q + 1) a ha).succAbove k).succAbove (J q _ hak) = J (q + 1) a ha := by
          apply (B (q + 1) a ha).injective
          rw [hJ (q + 1) a ha]
          have := hJ q _ hak
          rw [hBk] at this
          exact this
        rw [hx1 _ hak, map_zsmul, hres, smul_smul ((-1 : ℤ) ^ (k : ℕ)),
          smul_smul ((-1 : ℤ) ^ (J (q + 1) a ha : ℕ)),
          hsgn _ _ _ _ (hsign (J (q + 1) a ha) k (J q _ hak) hj2), neg_smul,
          hresEq z _ _ hBk _ (hle.trans (hface (B (q + 1) a ha) ((J (q + 1) a ha).succAbove k)))]
      rw [Finset.sum_congr rfl (fun k _ => hterm k), Finset.sum_neg_distrib, ← Finset.smul_sum,
        ← hT, smul_neg, neg_neg, smul_smul, hsq, one_smul]

  have s4 : ∀ (f : Γ(Y, U)) (q : ℕ) (z : wcAcC M O U (q + 1))
      (x' : wcAcC M O (Y.basicOpen f) q),
      (fun a => (M.presheaf.map (homOfLE (inf_le_inf_left _ (Y.basicOpen_le f) :
        wcAcV O (Y.basicOpen f) a ≤ wcAcV O U a)).op).hom (z a)) =
        wcAcD M O (Y.basicOpen f) q x' →
      ∃ (n : ℕ) (x : wcAcC M O U q), (fun a => (Y.presheaf.map (homOfLE (inf_le_right :
        wcAcV O U a ≤ U)).op).hom (f ^ n) • z a) = wcAcD M O U q x := by
    intro f q z x' hx'
    have hDU : Y.basicOpen f ≤ U := Y.basicOpen_le f
    have hbo : ∀ {p : ℕ} (a : Fin (p + 1) ↪o Fin r),
        Y.basicOpen ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV O U a ≤ U)).op).hom f) =
          wcAcV O (Y.basicOpen f) a := by
      intro p a
      rw [Scheme.basicOpen_res, inf_assoc, inf_eq_right.mpr hDU]
    haveI : ∀ n : ℕ, Finite (Fin n ↪o Fin r) := fun n =>
      Finite.of_injective (fun g : Fin n ↪o Fin r => (⇑g : Fin n → Fin r)) DFunLike.coe_injective
    have hnum : ∀ a : Fin (q + 1) ↪o Fin r, ∃ (n : ℕ) (t : Γ(M, wcAcV O U a)),
        ((Y.presheaf.map (homOfLE (Y.basicOpen_le
          ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV O U a ≤ U)).op).hom f))).op).hom
          ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV O U a ≤ U)).op).hom f)) ^ n •
          (M.presheaf.map (homOfLE (hbo a).le).op).hom (x' a) =
        (M.presheaf.map (homOfLE (Y.basicOpen_le
          ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV O U a ≤ U)).op).hom f))).op).hom t :=
      fun a => (hM _ (hnerve q a)
        ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV O U a ≤ U)).op).hom f)).1 _
    choose n t ht using hnum
    obtain ⟨N1, hN1⟩ := Finite.exists_le n
    obtain ⟨x, hx⟩ : ∃ x : wcAcC M O U q, ∀ a, x a =
        ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV O U a ≤ U)).op).hom f) ^ (N1 - n a) •
          t a := ⟨_, fun a => rfl⟩
    have hC1 : ∀ a : Fin (q + 1) ↪o Fin r,
        (M.presheaf.map (homOfLE (inf_le_inf_left _ hDU :
          wcAcV O (Y.basicOpen f) a ≤ wcAcV O U a)).op).hom (x a) =
        (Y.presheaf.map (homOfLE (inf_le_right :
          wcAcV O (Y.basicOpen f) a ≤ Y.basicOpen f)).op).hom
          ((Y.presheaf.map (homOfLE hDU).op).hom (f ^ N1)) • x' a := by
      intro a
      apply hinj (hbo a).le (hbo a).ge
      rw [hres, hx a, Scheme.Modules.map_smul, Scheme.Modules.map_smul, hresY, hresY, ← ht a]
      rw [map_pow, map_pow, hresY, smul_smul, ← pow_add, Nat.sub_add_cancel (hN1 a)]
    have hC1' : (fun a => (M.presheaf.map (homOfLE (inf_le_inf_left _ hDU :
          wcAcV O (Y.basicOpen f) a ≤ wcAcV O U a)).op).hom (x a)) =
        fun a => (Y.presheaf.map (homOfLE (inf_le_right :
          wcAcV O (Y.basicOpen f) a ≤ Y.basicOpen f)).op).hom
          ((Y.presheaf.map (homOfLE hDU).op).hom (f ^ N1)) • x' a := funext hC1
    have key : ∀ b : Fin (q + 2) ↪o Fin r,
        (M.presheaf.map (homOfLE (inf_le_inf_left _ hDU :
          wcAcV O (Y.basicOpen f) b ≤ wcAcV O U b)).op).hom
          ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV O U b ≤ U)).op).hom (f ^ N1) • z b -
            wcAcD M O U q x b) = 0 := by
      intro b
      have e1 := congrFun (s1 U (Y.basicOpen f) hDU q x) b
      have e2 := congrFun (s2 (Y.basicOpen f) ((Y.presheaf.map (homOfLE hDU).op).hom (f ^ N1))
        q x') b
      have e3 := congrFun hx' b
      beta_reduce at e1 e2 e3
      rw [map_sub, Scheme.Modules.map_smul, hresY, ← e1, hC1', e2, ← e3, hresY, sub_self]
    have hann : ∀ b : Fin (q + 2) ↪o Fin r, ∃ m : ℕ,
        ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV O U b ≤ U)).op).hom f) ^ m •
        ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV O U b ≤ U)).op).hom (f ^ N1) • z b -
          wcAcD M O U q x b) = 0 := by
      intro b
      refine (hM _ (hnerve (q + 1) b)
        ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV O U b ≤ U)).op).hom f)).2 _ ?_
      rw [← hres (inf_le_inf_left _ hDU : wcAcV O (Y.basicOpen f) b ≤ wcAcV O U b) (hbo b).le,
        key b, map_zero]
    choose m hm using hann
    obtain ⟨N2, hN2⟩ := Finite.exists_le m
    refine ⟨N2 + N1, fun a => (Y.presheaf.map (homOfLE (inf_le_right :
      wcAcV O U a ≤ U)).op).hom (f ^ N2) • x a, ?_⟩
    rw [s2 U (f ^ N2) q x]
    funext b
    have h0 : ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV O U b ≤ U)).op).hom f) ^ N2 •
        ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV O U b ≤ U)).op).hom (f ^ N1) • z b -
          wcAcD M O U q x b) = 0 := by
      rw [← Nat.sub_add_cancel (hN2 b), pow_add, mul_smul, hm b, smul_zero]
    rw [← map_pow, smul_sub, sub_eq_zero, smul_smul, ← map_mul, ← pow_add] at h0
    exact h0

  intro q z hz
  have hspan : Ideal.span {f : Γ(Y, U) | ∃ i, Y.basicOpen f ≤ O i} = ⊤ := by
    rw [← hU.self_le_iSup_basicOpen_iff]
    intro y hy
    obtain ⟨i, hi⟩ := hcov y hy
    obtain ⟨f, hf, hyf⟩ := hU.exists_basicOpen_le (V := U ⊓ O i) ⟨y, hy, hi⟩ hy
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨f, i, hf.trans inf_le_right⟩, hyf⟩
  have hloc : ∀ f ∈ {f : Γ(Y, U) | ∃ i, Y.basicOpen f ≤ O i}, ∃ (n : ℕ) (x : wcAcC M O U q),
      (fun a => (Y.presheaf.map (homOfLE (inf_le_right : wcAcV O U a ≤ U)).op).hom (f ^ n) • z a) =
        wcAcD M O U q x := by
    rintro f ⟨i0, hi0⟩
    have hz' : wcAcD M O (Y.basicOpen f) (q + 1) (fun a => (M.presheaf.map
        (homOfLE (inf_le_inf_left _ (Y.basicOpen_le f) :
          wcAcV O (Y.basicOpen f) a ≤ wcAcV O U a)).op).hom (z a)) = 0 := by
      rw [s1 U (Y.basicOpen f) (Y.basicOpen_le f) (q + 1) z, hz]
      funext a
      simp
    obtain ⟨x', hx'⟩ := s3 (Y.basicOpen f) i0 hi0 q _ hz'
    exact s4 f q z x' hx'

  let I : Ideal Γ(Y, U) :=
    { carrier := {c | ∃ x : wcAcC M O U q, (fun a => (Y.presheaf.map (homOfLE (inf_le_right :
        wcAcV O U a ≤ U)).op).hom c • z a) = wcAcD M O U q x}
      add_mem' := by
        rintro c c' ⟨x, hx⟩ ⟨x', hx'⟩
        refine ⟨x + x', ?_⟩
        rw [map_add, ← hx, ← hx']
        funext a
        simp only [Pi.add_apply, map_add, add_smul]
      zero_mem' := ⟨0, by funext a; simp⟩
      smul_mem' := by
        rintro c c' ⟨x, hx⟩
        refine ⟨fun a => (Y.presheaf.map (homOfLE (inf_le_right :
          wcAcV O U a ≤ U)).op).hom c • x a, ?_⟩
        rw [s2 U c q x, ← hx]
        funext a
        simp only [smul_eq_mul, map_mul, mul_smul] }
  have hI : {f : Γ(Y, U) | ∃ i, Y.basicOpen f ≤ O i} ⊆ (I.radical : Set Γ(Y, U)) := by
    intro f hf
    obtain ⟨n, x, hx⟩ := hloc f hf
    exact Ideal.mem_radical_iff.mpr ⟨n, x, hx⟩
  have htop : I.radical = ⊤ := by
    rw [eq_top_iff, ← hspan]
    exact Ideal.span_le.mpr hI
  have h1 : (1 : Γ(Y, U)) ∈ I := by
    rw [Ideal.radical_eq_top.mp htop]; exact Submodule.mem_top
  obtain ⟨x, hx⟩ := h1
  refine ⟨x, ?_⟩
  rw [← hx]
  funext a
  simp

theorem wcpa_dj_cgs_double_complex : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (Y : Scheme.{u}) (hY : Y ⟶ Spec (.of B)) (M : Y.Modules) {r n : ℕ} (E : Fin r → Y.Opens) (D : Fin n → Y.Opens), (∀ y : Y, ∃ i, y ∈ E i) → (∀ y : Y, ∃ k, y ∈ D k) → (∀ (t : ℕ) (τ : Fin (t + 1) ↪o Fin n) (q : ℕ) (z : wcAcC M E (wcAcV D ⊤ τ) (q + 1)), wcAcD M E (wcAcV D ⊤ τ) (q + 1) z = 0 → ∃ x, z = wcAcD M E (wcAcV D ⊤ τ) q x) → (∀ (s : ℕ) (σ : Fin (s + 1) ↪o Fin r) (q : ℕ) (z : wcAcC M D (wcAcV E ⊤ σ) (q + 1)), wcAcD M D (wcAcV E ⊤ σ) (q + 1) z = 0 → ∃ x, z = wcAcD M D (wcAcV E ⊤ σ) q x) → wcAcFG B Y hY M D → wcAcFG B Y hY M E :=
by
  intro B _ _ Y hY M r n E D hE hD hrow hcol hFG
  classical
  have stair : ∀ (K : ℕ → ℕ → Type u) [∀ s t, AddCommGroup (K s t)] [∀ s t, Module B (K s t)] (CE CD : ℕ → Type u) [∀ p, AddCommGroup (CE p)] [∀ p, Module B (CE p)] [∀ p, AddCommGroup (CD p)] [∀ p, Module B (CD p)] (dh : ∀ s t, K s t →ₗ[B] K (s + 1) t) (dv : ∀ s t, K s t →ₗ[B] K s (t + 1)) (dE : ∀ p, CE p →ₗ[B] CE (p + 1)) (dD : ∀ p, CD p →ₗ[B] CD (p + 1)) (eE : ∀ p, CE p →ₗ[B] K p 0) (eD : ∀ p, CD p →ₗ[B] K 0 p), (∀ s t x, dh (s + 1) t (dh s t x) = 0) → (∀ s t x, dv s (t + 1) (dv s t x) = 0) → (∀ s t x, dv (s + 1) t (dh s t x) = dh s (t + 1) (dv s t x)) → (∀ p x, dh p 0 (eE p x) = eE (p + 1) (dE p x)) → (∀ p x, dv p 0 (eE p x) = 0) → (∀ p x, dv 0 p (eD p x) = eD (p + 1) (dD p x)) → (∀ p x, dh 0 p (eD p x) = 0) → (∀ p, Function.Injective (eE p)) → (∀ p, Function.Injective (eD p)) → (∀ s x, dv s 0 x = 0 → ∃ y, x = eE s y) → (∀ s t x, dv s (t + 1) x = 0 → ∃ y, x = dv s t y) → (∀ t x, dh 0 t x = 0 → ∃ y, x = eD t y) → (∀ s t x, dh (s + 1) t x = 0 → ∃ y, x = dh s t y) → ((∃ (k : ℕ) (c : Fin k → CD 0), (∀ i, dD 0 (c i) = 0) ∧ ∀ z, dD 0 z = 0 → ∃ b : Fin k → B, z = ∑ i, b i • c i) → (∃ (k : ℕ) (c : Fin k → CE 0), (∀ i, dE 0 (c i) = 0) ∧ ∀ z, dE 0 z = 0 → ∃ b : Fin k → B, z = ∑ i, b i • c i)) ∧ ∀ p : ℕ, (∃ (k : ℕ) (c : Fin k → CD (p + 1)), (∀ i, dD (p + 1) (c i) = 0) ∧ ∀ z, dD (p + 1) z = 0 → ∃ (b : Fin k → B) (x : CD p), z = ∑ i, b i • c i + dD p x) → (∃ (k : ℕ) (c : Fin k → CE (p + 1)), (∀ i, dE (p + 1) (c i) = 0) ∧ ∀ z, dE (p + 1) z = 0 → ∃ (b : Fin k → B) (x : CE p), z = ∑ i, b i • c i + dE p x) := by

    have stair_ex : ∀ (K : ℕ → ℕ → Type u) [∀ s t, AddCommGroup (K s t)] [∀ s t, Module B (K s t)] (CE CD : ℕ → Type u) [∀ p, AddCommGroup (CE p)] [∀ p, Module B (CE p)] [∀ p, AddCommGroup (CD p)] [∀ p, Module B (CD p)] (dh : ∀ s t, K s t →ₗ[B] K (s + 1) t) (dv : ∀ s t, K s t →ₗ[B] K s (t + 1)) (dE : ∀ p, CE p →ₗ[B] CE (p + 1)) (dD : ∀ p, CD p →ₗ[B] CD (p + 1)) (eE : ∀ p, CE p →ₗ[B] K p 0) (eD : ∀ p, CD p →ₗ[B] K 0 p),
        (∀ s t x, dv s (t + 1) (dv s t x) = 0) →
        (∀ s t x, dv (s + 1) t (dh s t x) = dh s (t + 1) (dv s t x)) →
        (∀ p x, dh p 0 (eE p x) = eE (p + 1) (dE p x)) →
        (∀ p x, dv p 0 (eE p x) = 0) →
        (∀ p x, dv 0 p (eD p x) = eD (p + 1) (dD p x)) →
        (∀ p, Function.Injective (eD p)) →
        (∀ t x, dh 0 t x = 0 → ∃ y, x = eD t y) →
        (∀ s t x, dh (s + 1) t x = 0 → ∃ y, x = dh s t y) →
        ∀ (q : ℕ) (z : CE (q + 1)), dE (q + 1) z = 0 →
          ∃ (z' : CD (q + 1)) (T : ∀ π : ℕ × ℕ, K π.1 π.2),
            eE (q + 1) z = dh q 0 (T (q, 0)) ∧
            (∀ s t, s + t + 1 = q → dv (s + 1) t (T (s + 1, t)) = dh s (t + 1) (T (s, t + 1))) ∧
            eD (q + 1) z' = dv 0 q (T (0, q)) ∧ dD (q + 1) z' = 0 := by
      intro K _ _ CE CD _ _ _ _ dh dv dE dD eE eD vv com hE vE vD iD augR exR q z hz
      classical
      have Fr : ∀ (T : ∀ π : ℕ × ℕ, K π.1 π.2) (s d : ℕ), s + d = q →
          eE (q + 1) z = dh q 0 (T (q, 0)) →
          (∀ d', d = d' + 1 → dv (s + 1) d' (T (s + 1, d')) = dh s (d' + 1) (T (s, d' + 1))) →
          dv (s + 1) d (dh s d (T (s, d))) = 0 := by
        intro T s d hsd hi hii
        cases d with
        | zero =>
          obtain rfl : s = q := by omega
          rw [← hi]
          exact vE _ _
        | succ d' =>
          rw [← hii d' rfl]
          exact vv _ _ _
      have P : ∀ d, d ≤ q → ∃ T : ∀ π : ℕ × ℕ, K π.1 π.2,
          eE (q + 1) z = dh q 0 (T (q, 0)) ∧
          ∀ s t, s + t + 1 = q → q ≤ s + d → dv (s + 1) t (T (s + 1, t)) = dh s (t + 1) (T (s, t + 1)) := by
        intro d
        induction d with
        | zero =>
          intro _
          have h0 : dh (q + 1) 0 (eE (q + 1) z) = 0 := by rw [hE, hz, map_zero]
          obtain ⟨T₀, hT₀⟩ := exR q 0 _ h0
          refine ⟨Function.update (0 : ∀ π : ℕ × ℕ, K π.1 π.2) (q, 0) T₀, ?_, ?_⟩
          · rw [Function.update_self]
            exact hT₀
          · intro s t h1 h2
            omega
        | succ d ih =>
          intro hd
          obtain ⟨T, hi, hii⟩ := ih (by omega)
          obtain ⟨s, hs⟩ : ∃ s, s + (d + 1) = q := ⟨q - (d + 1), by omega⟩
          have hfr : dv (s + 2) d (dh (s + 1) d (T (s + 1, d))) = 0 :=
            Fr T (s + 1) d (by omega) hi (fun d' hd' => hii (s + 1) d' (by omega) (by omega))
          have ha : dh (s + 1) (d + 1) (dv (s + 1) d (T (s + 1, d))) = 0 := by
            rw [← com]; exact hfr
          obtain ⟨y, hy⟩ := exR s (d + 1) _ ha
          refine ⟨Function.update T (s, d + 1) y, ?_, ?_⟩
          · rw [Function.update_of_ne (by intro h; simp at h)]
            exact hi
          · intro s₀ t₀ h1 h2
            by_cases hs₀ : s₀ = s
            · subst hs₀
              obtain rfl : t₀ = d := by omega
              rw [Function.update_of_ne (by intro h; simp at h), Function.update_self]
              exact hy
            · rw [Function.update_of_ne (by intro h; simp at h; omega),
                Function.update_of_ne (by intro h; simp at h; omega)]
              exact hii s₀ t₀ h1 (by omega)
      obtain ⟨T, hi, hii⟩ := P q le_rfl
      have hii' : ∀ s t, s + t + 1 = q → dv (s + 1) t (T (s + 1, t)) = dh s (t + 1) (T (s, t + 1)) :=
        fun s t h => hii s t h (by omega)
      have hx : dh 0 (q + 1) (dv 0 q (T (0, q))) = 0 := by
        rw [← com]
        exact Fr T 0 q (by omega) hi (fun d' hd' => hii' 0 d' (by omega))
      obtain ⟨z', hz'⟩ := augR (q + 1) _ hx
      refine ⟨z', T, hi, hii', hz'.symm, ?_⟩
      apply iD (q + 2)
      rw [map_zero, ← vD, ← hz', vv]
    intro K _ _ CE CD _ _ _ _ dh dv dE dD eE eD hh vv com hE vE vD hD iE iD augC exC augR exR

    have kill : ∀ (q : ℕ) (z : CE (q + 1)) (w' : CD q) (T : ∀ π : ℕ × ℕ, K π.1 π.2),
        eE (q + 1) z = dh q 0 (T (q, 0)) →
        (∀ s t, s + t + 1 = q → dv (s + 1) t (T (s + 1, t)) = dh s (t + 1) (T (s, t + 1))) →
        eD (q + 1) (dD q w') = dv 0 q (T (0, q)) →
        ∃ y, z = dE q y := by
      intro q z w' T hi hii hiii
      have Inv : ∀ s, s ≤ q → ∃ t, s + t = q ∧ ∃ W : K s t, dv s t W = 0 ∧ dh s t (T (s, t) - W) = 0 := by
        intro s
        induction s with
        | zero =>
          intro _
          refine ⟨q, by omega, T (0, q) - eD q w', ?_, ?_⟩
          · rw [map_sub, ← hiii, vD, sub_self]
          · rw [sub_sub_cancel, hD]
        | succ s ih =>
          intro hs
          obtain ⟨t, hst, W, hW1, hW2⟩ := ih (by omega)
          obtain ⟨t', rfl⟩ : ∃ t', t = t' + 1 := ⟨t - 1, by omega⟩
          obtain ⟨V, hV⟩ := exC s t' W hW1
          refine ⟨t', by omega, T (s + 1, t') - dh s t' V, ?_, ?_⟩
          · rw [map_sub, hii s t' (by omega), com, ← hV, ← map_sub]
            exact hW2
          · rw [sub_sub_cancel, hh]
      obtain ⟨t, hqt, W, hW1, hW2⟩ := Inv q le_rfl
      obtain rfl : t = 0 := by omega
      obtain ⟨y, hy⟩ := augC q W hW1
      refine ⟨y, iE (q + 1) ?_⟩
      rw [hi, ← hE, ← hy, ← sub_eq_zero, ← map_sub]
      exact hW2

    have ex := stair_ex K CE CD dh dv dE dD eE eD vv com hE vE vD iD augR exR
    have ex' : ∀ (q : ℕ) (z' : CD (q + 1)), dD (q + 1) z' = 0 →
        ∃ (z : CE (q + 1)) (T : ∀ π : ℕ × ℕ, K π.1 π.2),
          eE (q + 1) z = dh q 0 (T (q, 0)) ∧
          (∀ s t, s + t + 1 = q → dv (s + 1) t (T (s + 1, t)) = dh s (t + 1) (T (s, t + 1))) ∧
          eD (q + 1) z' = dv 0 q (T (0, q)) ∧ dE (q + 1) z = 0 := by
      intro q z' hz'
      obtain ⟨z, T', h1, h2, h3, h4⟩ := stair_ex (fun s t => K t s) CD CE
        (fun s t => dv t s) (fun s t => dh t s) dD dE eD eE (fun s t x => hh t s x)
        (fun s t x => (com t s x).symm) (fun p x => vD p x) (fun p x => hD p x)
        (fun p x => hE p x) iE (fun t x hx => augC t x hx) (fun s t x hx => exC t s x hx) q z' hz'
      refine ⟨z, fun π => T' (π.2, π.1), h3, fun s t hst => (h2 t s (by omega)).symm, h1, h4⟩
    refine ⟨?_, ?_⟩
    ·
      rintro ⟨k, c', hc', hgen⟩
      have hc : ∀ i, ∃ c : CE 0, eD 0 (c' i) = eE 0 c := by
        intro i
        apply augC 0
        rw [vD, hc', map_zero]
      choose c hc using hc
      refine ⟨k, c, fun i => iE 1 ?_, fun z hz => ?_⟩
      · rw [map_zero, ← hE, ← hc, hD]
      · obtain ⟨z', hz'⟩ := augR 0 (eE 0 z) (by rw [hE, hz, map_zero])
        have hz'c : dD 0 z' = 0 := by
          apply iD 1
          rw [map_zero, ← vD, ← hz', vE]
        obtain ⟨b, hb⟩ := hgen z' hz'c
        refine ⟨b, iE 0 ?_⟩
        rw [hz', hb, map_sum, map_sum]
        simp only [map_smul, hc]
    · intro q ⟨k, c', hc', hgen⟩
      have hgen' := fun i => ex' q (c' i) (hc' i)
      choose c Tc hc1 hc2 hc3 hc4 using hgen'
      refine ⟨k, c, hc4, fun z hz => ?_⟩
      obtain ⟨z', T, h1, h2, h3, h4⟩ := ex q z hz
      obtain ⟨b, x', hb⟩ := hgen z' h4
      have k1 : eE (q + 1) (z - ∑ i, b i • c i) = dh q 0 ((T - ∑ i, b i • Tc i) (q, 0)) := by
        simp only [map_sub, map_sum, map_smul, Pi.sub_apply, Finset.sum_apply, Pi.smul_apply, h1, hc1]
      have k2 : ∀ s t, s + t + 1 = q → dv (s + 1) t ((T - ∑ i, b i • Tc i) (s + 1, t)) =
          dh s (t + 1) ((T - ∑ i, b i • Tc i) (s, t + 1)) := by
        intro s t hst
        simp only [map_sub, map_sum, map_smul, Pi.sub_apply, Finset.sum_apply, Pi.smul_apply,
          h2 s t hst, hc2 _ s t hst]
      have k3 : eD (q + 1) (dD q x') = dv 0 q ((T - ∑ i, b i • Tc i) (0, q)) := by
        have hx' : dD q x' = z' - ∑ i, b i • c' i := by rw [hb]; abel
        rw [hx']
        simp only [map_sub, map_sum, map_smul, Pi.sub_apply, Finset.sum_apply, Pi.smul_apply, h3, hc3]
      obtain ⟨y, hy⟩ := kill q (z - ∑ i, b i • c i) x' (T - ∑ i, b i • Tc i) k1 k2 k3
      exact ⟨b, y, by rw [← hy]; abel⟩
  have d0 : ∀ {m : ℕ} (V : Fin m → Y.Opens) (O : Y.Opens) (p : ℕ) (z : wcAcC M V O p),
      wcAcD M V O (p + 1) (wcAcD M V O p z) = 0 := by
    intro m V O p z

    have SV : ∀ {n : ℕ} (a : Fin (n + 1)) (x : Fin n),
        ((a.succAbove x : Fin (n + 1)) : ℕ) = if (x : ℕ) < (a : ℕ) then (x : ℕ) else (x : ℕ) + 1 := by
      intro n a x
      by_cases h : x.castSucc < a
      · rw [Fin.succAbove_of_castSucc_lt _ _ h]
        rw [Fin.lt_def, Fin.coe_castSucc] at h
        rw [if_pos h, Fin.coe_castSucc]
      · rw [Fin.succAbove_of_le_castSucc _ _ (not_lt.mp h)]
        rw [Fin.lt_def, Fin.coe_castSucc] at h
        rw [if_neg h, Fin.val_succ]

    let g : Fin (p + 3) × Fin (p + 2) → Fin (p + 3) × Fin (p + 2) := fun a =>
      if (a.2 : ℕ) < (a.1 : ℕ) then
        (⟨a.2, by have := a.2.isLt; omega⟩, ⟨a.1 - 1, by have := a.1.isLt; omega⟩)
      else (⟨a.2 + 1, by have := a.2.isLt; omega⟩, ⟨min a.1 (p + 1), by omega⟩)
    have hg1 : ∀ a : Fin (p + 3) × Fin (p + 2), (a.2 : ℕ) < (a.1 : ℕ) →
        ((g a).1 : ℕ) = a.2 ∧ ((g a).2 : ℕ) = a.1 - 1 := by
      intro a h
      have := a.2.isLt
      refine ⟨?_, ?_⟩ <;> (try simp [g, h]) <;> omega
    have hg2 : ∀ a : Fin (p + 3) × Fin (p + 2), ¬ (a.2 : ℕ) < (a.1 : ℕ) →
        ((g a).1 : ℕ) = a.2 + 1 ∧ ((g a).2 : ℕ) = a.1 := by
      intro a h
      have := a.2.isLt
      refine ⟨?_, ?_⟩ <;> (try simp [g, h]) <;> omega
    have gA : ∀ a : Fin (p + 3) × Fin (p + 2),
        (fun l : Fin (p + 1) => (g a).1.succAbove ((g a).2.succAbove l)) =
          fun l => a.1.succAbove (a.2.succAbove l) := by
      intro a
      funext l
      apply Fin.ext
      have h3 := a.1.isLt
      have h4 := a.2.isLt
      by_cases h : (a.2 : ℕ) < (a.1 : ℕ)
      · obtain ⟨e1, e2⟩ := hg1 a h
        simp only [SV, e1, e2]
        split_ifs <;> omega
      · obtain ⟨e1, e2⟩ := hg2 a h
        simp only [SV, e1, e2]
        split_ifs <;> omega
    have gB : ∀ a : Fin (p + 3) × Fin (p + 2),
        (-1 : ℤ) ^ ((g a).1 : ℕ) * (-1 : ℤ) ^ ((g a).2 : ℕ) =
          -((-1 : ℤ) ^ (a.1 : ℕ) * (-1 : ℤ) ^ (a.2 : ℕ)) := by
      intro a
      by_cases h : (a.2 : ℕ) < (a.1 : ℕ)
      · obtain ⟨e1, e2⟩ := hg1 a h
        rw [e1, e2]
        obtain ⟨n0, hn0⟩ : ∃ n0, (a.1 : ℕ) = n0 + 1 := ⟨(a.1 : ℕ) - 1, by omega⟩
        rw [hn0, Nat.add_sub_cancel, pow_succ]
        ring
      · obtain ⟨e1, e2⟩ := hg2 a h
        rw [e1, e2, pow_succ]
        ring
    have gC : ∀ a : Fin (p + 3) × Fin (p + 2), g a ≠ a := by
      intro a hc
      have hv : ((g a).1 : ℕ) = a.1 := by rw [hc]
      by_cases h : (a.2 : ℕ) < (a.1 : ℕ)
      · obtain ⟨e1, e2⟩ := hg1 a h
        omega
      · obtain ⟨e1, e2⟩ := hg2 a h
        omega
    have gD : ∀ a : Fin (p + 3) × Fin (p + 2), g (g a) = a := by
      intro a
      have h3 := a.1.isLt
      by_cases h : (a.2 : ℕ) < (a.1 : ℕ)
      · obtain ⟨e1, e2⟩ := hg1 a h
        have h' : ¬ ((g a).2 : ℕ) < ((g a).1 : ℕ) := by omega
        obtain ⟨f1, f2⟩ := hg2 (g a) h'
        refine Prod.ext (Fin.ext ?_) (Fin.ext ?_) <;> omega
      · obtain ⟨e1, e2⟩ := hg2 a h
        have h' : ((g a).2 : ℕ) < ((g a).1 : ℕ) := by omega
        obtain ⟨f1, f2⟩ := hg1 (g a) h'
        refine Prod.ext (Fin.ext ?_) (Fin.ext ?_) <;> omega

    have gE : ∀ a : Fin (p + 3) × Fin (p + 2),
        (Fin.succAboveOrderEmb (g a).2).trans (Fin.succAboveOrderEmb (g a).1) =
          (Fin.succAboveOrderEmb a.2).trans (Fin.succAboveOrderEmb a.1) := by
      intro a
      apply RelEmbedding.ext
      intro l
      simp only [RelEmbedding.trans_apply, Fin.succAboveOrderEmb_apply]
      exact congrFun (gA a) l

    have hres : ∀ (U1 U2 U3 : Y.Opens) (h12 : U1 ≤ U2) (h23 : U2 ≤ U3) (x : Γ(M, U3)),
        (M.presheaf.map (homOfLE h12).op).hom ((M.presheaf.map (homOfLE h23).op).hom x) =
          (M.presheaf.map (homOfLE (h12.trans h23)).op).hom x := by
      intro U1 U2 U3 h12 h23 x
      have := congrArg (fun f => f.hom x) (M.presheaf.map_comp (homOfLE h23).op (homOfLE h12).op)
      exact this.symm
    funext a

    have s2 : ∀ F : (Fin (p + 1) ↪o Fin (p + 3)) → Γ(M, wcAcV V O a),
        ∑ j : Fin (p + 3), ∑ i : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ) * (-1 : ℤ) ^ (i : ℕ)) •
          F ((Fin.succAboveOrderEmb i).trans (Fin.succAboveOrderEmb j)) = 0 := by
      intro F
      rw [← Fintype.sum_prod_type' (f := fun (j : Fin (p + 3)) (i : Fin (p + 2)) =>
          ((-1 : ℤ) ^ (j : ℕ) * (-1 : ℤ) ^ (i : ℕ)) •
            F ((Fin.succAboveOrderEmb i).trans (Fin.succAboveOrderEmb j)))]
      refine Finset.sum_involution (fun a _ => g a) ?_ ?_ ?_ ?_
      · intro b _
        show ((-1 : ℤ) ^ (b.1 : ℕ) * (-1 : ℤ) ^ (b.2 : ℕ)) •
            F ((Fin.succAboveOrderEmb b.2).trans (Fin.succAboveOrderEmb b.1)) +
          ((-1 : ℤ) ^ ((g b).1 : ℕ) * (-1 : ℤ) ^ ((g b).2 : ℕ)) •
            F ((Fin.succAboveOrderEmb (g b).2).trans (Fin.succAboveOrderEmb (g b).1)) = 0
        rw [gE b, gB b, neg_smul, add_neg_cancel]
      · intro b _ _
        exact gC b
      · intro b _
        exact Finset.mem_univ _
      · intro b _
        exact gD b
    refine Eq.trans ?_ (s2 (fun e => (M.presheaf.map (homOfLE (show wcAcV V O a ≤
        wcAcV V O (e.trans a) from
        inf_le_inf_right O (le_iInf fun l => iInf_le (fun k => V (a k)) (e l)))).op).hom
        (z (e.trans a))))
    simp only [wcAcD, AddMonoidHom.coe_mk, ZeroHom.coe_mk]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_sum, Finset.smul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_zsmul, smul_smul]
    congr 1
    exact hres _ _ _ _ _ _
  have hcomp : ∀ {W W' W'' : Y.Opens} (h1 : W' ≤ W) (h2 : W'' ≤ W') (x : Γ(M, W)),
      (M.presheaf.map (homOfLE h2).op).hom ((M.presheaf.map (homOfLE h1).op).hom x) =
        (M.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro W W' W'' h1 h2 x
    exact (congrArg (fun f => f.hom x) (M.presheaf.map_comp (homOfLE h1).op (homOfLE h2).op)).symm
  have hrefl : ∀ {W : Y.Opens} (h : W ≤ W) (x : Γ(M, W)),
      (M.presheaf.map (homOfLE h).op).hom x = x := by
    intro W h x
    exact congrArg (fun f => f.hom x) (M.presheaf.map_id (Opposite.op W))
  have hσres : ∀ (W W' : Y.Opens) (h : W' ≤ W) (b : B),
      (Y.presheaf.map (homOfLE h).op).hom (wcCnSigma hY W b) = wcCnSigma hY W' b := by
    intro W W' h b
    show (Y.presheaf.map (homOfLE h).op).hom ((Y.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom
      ((hY.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom) b)) =
      (Y.presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op).hom
      ((hY.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom) b)
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  letI inst : ∀ W : Y.Opens, Module B Γ(M, W) := fun W => Module.compHom Γ(M, W) (wcCnSigma hY W)
  have resB : ∀ {W W' : Y.Opens} (h : W' ≤ W) (b : B) (x : Γ(M, W)),
      (M.presheaf.map (homOfLE h).op).hom (b • x) = b • (M.presheaf.map (homOfLE h).op).hom x := by
    intro W W' h b x
    have e1 := Scheme.Modules.map_smul M (homOfLE h) (wcCnSigma hY W b) x
    have e2 := hσres W W' h b
    show (M.presheaf.map (homOfLE h).op).hom (wcCnSigma hY W b • x) =
      wcCnSigma hY W' b • (M.presheaf.map (homOfLE h).op).hom x
    rw [← e2]
    exact e1
  have acdB : ∀ {m : ℕ} (V : Fin m → Y.Opens) (O : Y.Opens) (p : ℕ) (b : B) (w : wcAcC M V O p),
      wcAcD M V O p (b • w) = b • wcAcD M V O p w := by
    intro m V O p b w
    funext a
    simp only [wcAcD, AddMonoidHom.coe_mk, ZeroHom.coe_mk, Pi.smul_apply]
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [resB, smul_comm]

  have G0 : ∀ {m : ℕ} (V : Fin m → Y.Opens) (O : Y.Opens), (∀ y : Y, ∃ k, y ∈ V k) →
      (∀ s : Γ(M, O), (∀ a : Fin 1 ↪o Fin m,
        (M.presheaf.map (homOfLE (inf_le_right : wcAcV V O a ≤ O)).op).hom s = 0) → s = 0) ∧
      ∀ x : wcAcC M V O 0, wcAcD M V O 0 x = 0 → ∃ s : Γ(M, O), ∀ a : Fin 1 ↪o Fin m,
        x a = (M.presheaf.map (homOfLE (inf_le_right : wcAcV V O a ≤ O)).op).hom s := by
    intro m V O hcov
    have hU : O ≤ iSup (fun a : Fin 1 ↪o Fin m => wcAcV V O a) := by
      intro y hy
      obtain ⟨k, hk⟩ := hcov y
      refine TopologicalSpace.Opens.mem_iSup.mpr
        ⟨OrderEmbedding.ofStrictMono (fun _ : Fin 1 => k) (Subsingleton.strictMono _), ?_⟩
      exact (inf_le_inf_right O (le_iInf fun _ => le_rfl) : V k ⊓ O ≤ _)
        (TopologicalSpace.Opens.mem_inf.mpr ⟨hk, hy⟩)
    refine ⟨fun s hs => ?_, fun x hx => ?_⟩
    · exact TopCat.Sheaf.eq_of_locally_eq' (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab Y)
        (fun a => wcAcV V O a) O (fun a => homOfLE inf_le_right) hU s 0
        (fun a => by rw [map_zero]; exact hs a)
    · have Tp : ∀ (b b' : Fin 1 ↪o Fin m), b = b' → ∀ (W : Y.Opens) (h : W ≤ wcAcV V O b)
          (h' : W ≤ wcAcV V O b'),
          (M.presheaf.map (homOfLE h).op).hom (x b) = (M.presheaf.map (homOfLE h').op).hom (x b') := by
        intro b b' hb W h h'
        subst hb
        rfl
      have Clt : ∀ a b : Fin 1 ↪o Fin m, a 0 < b 0 → ∀ (W : Y.Opens) (ha : W ≤ wcAcV V O a)
          (hb : W ≤ wcAcV V O b),
          (M.presheaf.map (homOfLE ha).op).hom (x a) = (M.presheaf.map (homOfLE hb).op).hom (x b) := by
        intro a b hab W ha hb
        let c : Fin 2 ↪o Fin m := OrderEmbedding.ofStrictMono
          (fun l : Fin 2 => if (l : ℕ) = 0 then a 0 else b 0) (by
            intro l l' hll'
            have h1 : (l : ℕ) < l' := hll'
            have h2 := l'.isLt
            have hl : (l : ℕ) = 0 := by omega
            have hl' : ¬ (l' : ℕ) = 0 := by omega
            show (if (l : ℕ) = 0 then a 0 else b 0) < (if (l' : ℕ) = 0 then a 0 else b 0)
            rw [if_pos hl, if_neg hl']
            exact hab)
        have hc0 : (Fin.succAboveOrderEmb 0).trans c = b := by
          apply DFunLike.ext
          intro l
          obtain rfl : l = 0 := Fin.ext (by have := l.isLt; simp at this ⊢; try omega)
          rfl
        have hc1 : (Fin.succAboveOrderEmb (Fin.succ 0)).trans c = a := by
          apply DFunLike.ext
          intro l
          obtain rfl : l = 0 := Fin.ext (by have := l.isLt; simp at this ⊢; try omega)
          rfl
        have hWc : W ≤ wcAcV V O c := by
          refine le_inf (le_iInf fun l => ?_) (ha.trans inf_le_right)
          by_cases hl : (l : ℕ) = 0
          · have e : c l = a 0 := by show (if (l : ℕ) = 0 then a 0 else b 0) = a 0; rw [if_pos hl]
            rw [e]
            exact ha.trans (inf_le_left.trans (iInf_le _ 0))
          · have e : c l = b 0 := by show (if (l : ℕ) = 0 then a 0 else b 0) = b 0; rw [if_neg hl]
            rw [e]
            exact hb.trans (inf_le_left.trans (iInf_le _ 0))
        have hx' := congrFun hx c
        simp only [wcAcD, AddMonoidHom.coe_mk, ZeroHom.coe_mk, Pi.zero_apply] at hx'
        rw [Fin.sum_univ_succ, Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero] at hx'
        have h2 := congrArg (M.presheaf.map (homOfLE hWc).op).hom hx'
        rw [map_add, map_zsmul, map_zsmul, hcomp, hcomp, map_zero] at h2
        rw [Tp _ b hc0 W _ hb, Tp _ a hc1 W _ ha] at h2
        simp only [Fin.val_zero, Fin.val_succ, zero_add, pow_zero, pow_one, one_smul, neg_smul] at h2
        rw [← sub_eq_add_neg, sub_eq_zero] at h2
        exact h2.symm
      have hcompat : TopCat.Presheaf.IsCompatible M.presheaf (fun a => wcAcV V O a) x := by
        intro a b
        rcases lt_trichotomy (a 0) (b 0) with h | h | h
        · exact Clt a b h _ _ _
        · have hab : a = b := by
            apply DFunLike.ext
            intro l
            obtain rfl : l = 0 := Fin.ext (by have := l.isLt; simp at this ⊢; try omega)
            exact h
          subst hab
          rfl
        · exact (Clt b a h _ _ _).symm
      obtain ⟨s, hs, -⟩ := TopCat.Sheaf.existsUnique_gluing'
        (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab Y) (fun a => wcAcV V O a) O
        (fun a => homOfLE inf_le_right) hU x hcompat
      exact ⟨s, fun a => (hs a).symm⟩

  let dhF : ∀ s t, (∀ τ : Fin (t + 1) ↪o Fin n, wcAcC M E (wcAcV D ⊤ τ) s) →
      (∀ τ : Fin (t + 1) ↪o Fin n, wcAcC M E (wcAcV D ⊤ τ) (s + 1)) :=
    fun s t z τ => wcAcD M E (wcAcV D ⊤ τ) s (z τ)
  let DVc : ∀ (s : ℕ) (σ : Fin (s + 1) ↪o Fin r) (t : ℕ),
      (∀ τ : Fin (t + 1) ↪o Fin n, Γ(M, wcAcV E (wcAcV D ⊤ τ) σ)) →
      ∀ τ : Fin (t + 1 + 1) ↪o Fin n, Γ(M, wcAcV E (wcAcV D ⊤ τ) σ) :=
    fun s σ t z τ' => ∑ k : Fin (t + 2), ((-1 : ℤ) ^ (k : ℕ)) •
      (M.presheaf.map (homOfLE (show wcAcV E (wcAcV D ⊤ τ') σ ≤
        wcAcV E (wcAcV D ⊤ ((Fin.succAboveOrderEmb k).trans τ')) σ from
        inf_le_inf_left _ (inf_le_inf_right ⊤
          (le_iInf fun i => iInf_le (fun j => D (τ' j)) _)))).op).hom
        (z ((Fin.succAboveOrderEmb k).trans τ'))
  let dvF : ∀ s t, (∀ τ : Fin (t + 1) ↪o Fin n, wcAcC M E (wcAcV D ⊤ τ) s) →
      (∀ τ : Fin (t + 1 + 1) ↪o Fin n, wcAcC M E (wcAcV D ⊤ τ) s) :=
    fun s t z τ' σ => DVc s σ t (fun τ => z τ σ) τ'
  let eEF : ∀ p, wcAcC M E ⊤ p → (∀ τ : Fin (0 + 1) ↪o Fin n, wcAcC M E (wcAcV D ⊤ τ) p) :=
    fun p y τ σ => (M.presheaf.map (homOfLE (show wcAcV E (wcAcV D ⊤ τ) σ ≤ wcAcV E ⊤ σ from
      inf_le_inf_left _ le_top)).op).hom (y σ)
  let eDF : ∀ p, wcAcC M D ⊤ p → (∀ τ : Fin (p + 1) ↪o Fin n, wcAcC M E (wcAcV D ⊤ τ) 0) :=
    fun p y τ σ => (M.presheaf.map (homOfLE (inf_le_right :
      wcAcV E (wcAcV D ⊤ τ) σ ≤ wcAcV D ⊤ τ)).op).hom (y τ)

  have colT : ∀ (s : ℕ) (σ : Fin (s + 1) ↪o Fin r),
      (∀ t z, DVc s σ (t + 1) (DVc s σ t z) = 0) ∧
      (∀ t z, DVc s σ (t + 1) z = 0 → ∃ x, z = DVc s σ t x) ∧
      (∀ z, DVc s σ 0 z = 0 → ∃ y : Γ(M, wcAcV E ⊤ σ), ∀ τ, z τ =
        (M.presheaf.map (homOfLE (show wcAcV E (wcAcV D ⊤ τ) σ ≤ wcAcV E ⊤ σ from
          inf_le_inf_left _ le_top)).op).hom y) ∧
      (∀ y : Γ(M, wcAcV E ⊤ σ), (∀ τ : Fin 1 ↪o Fin n,
        (M.presheaf.map (homOfLE (show wcAcV E (wcAcV D ⊤ τ) σ ≤ wcAcV E ⊤ σ from
          inf_le_inf_left _ le_top)).op).hom y = 0) → y = 0) := by
    intro s σ
    have hle : ∀ {t : ℕ} (a : Fin (t + 1) ↪o Fin n),
        wcAcV D (wcAcV E ⊤ σ) a ≤ wcAcV E (wcAcV D ⊤ a) σ :=
      fun a => le_inf (inf_le_right.trans inf_le_left) (le_inf inf_le_left le_top)
    have hle' : ∀ {t : ℕ} (a : Fin (t + 1) ↪o Fin n),
        wcAcV E (wcAcV D ⊤ a) σ ≤ wcAcV D (wcAcV E ⊤ σ) a :=
      fun a => le_inf (inf_le_right.trans inf_le_left) (le_inf inf_le_left le_top)
    let Φ : ∀ t, (∀ τ : Fin (t + 1) ↪o Fin n, Γ(M, wcAcV E (wcAcV D ⊤ τ) σ)) →
        wcAcC M D (wcAcV E ⊤ σ) t :=
      fun t z a => (M.presheaf.map (homOfLE (hle a)).op).hom (z a)
    let Ψ : ∀ t, wcAcC M D (wcAcV E ⊤ σ) t →
        (∀ τ : Fin (t + 1) ↪o Fin n, Γ(M, wcAcV E (wcAcV D ⊤ τ) σ)) :=
      fun t y a => (M.presheaf.map (homOfLE (hle' a)).op).hom (y a)
    have ΨΦ : ∀ t z, Ψ t (Φ t z) = z := by
      intro t z
      funext a
      simp only [Ψ, Φ]
      rw [hcomp, hrefl]
    have ΦΨ : ∀ t y, Φ t (Ψ t y) = y := by
      intro t y
      funext a
      simp only [Ψ, Φ]
      rw [hcomp, hrefl]
    have Ψ0 : ∀ t, Ψ t 0 = 0 := by
      intro t
      funext a
      exact map_zero _
    have Φ0 : ∀ t, Φ t 0 = 0 := by
      intro t
      funext a
      exact map_zero _
    have inter : ∀ t z, Φ (t + 1) (DVc s σ t z) = wcAcD M D (wcAcV E ⊤ σ) t (Φ t z) := by
      intro t z
      funext a
      simp only [Φ, DVc, wcAcD, AddMonoidHom.coe_mk, ZeroHom.coe_mk, map_sum, map_zsmul, hcomp]
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro t z
      rw [← ΨΦ (t + 1 + 1) (DVc s σ (t + 1) (DVc s σ t z)), inter, inter, d0, Ψ0]
    · intro t z hz
      have h1 : wcAcD M D (wcAcV E ⊤ σ) (t + 1) (Φ (t + 1) z) = 0 := by
        rw [← inter, hz, Φ0]
      obtain ⟨x, hx⟩ := hcol s σ t (Φ (t + 1) z) h1
      refine ⟨Ψ t x, ?_⟩
      calc z = Ψ (t + 1) (Φ (t + 1) z) := (ΨΦ _ _).symm
        _ = Ψ (t + 1) (wcAcD M D (wcAcV E ⊤ σ) t (Φ t (Ψ t x))) := by rw [hx, ΦΨ]
        _ = DVc s σ t (Ψ t x) := by rw [← inter, ΨΦ]
    · intro z hz
      have h1 : wcAcD M D (wcAcV E ⊤ σ) 0 (Φ 0 z) = 0 := by
        rw [← inter, hz, Φ0]
      obtain ⟨y, hy⟩ := (G0 D (wcAcV E ⊤ σ) hD).2 (Φ 0 z) h1
      refine ⟨y, fun τ => ?_⟩
      calc z τ = Ψ 0 (Φ 0 z) τ := by rw [ΨΦ]
        _ = (M.presheaf.map (homOfLE (hle' τ)).op).hom (Φ 0 z τ) := rfl
        _ = (M.presheaf.map (homOfLE (hle' τ)).op).hom
            ((M.presheaf.map (homOfLE (inf_le_right :
              wcAcV D (wcAcV E ⊤ σ) τ ≤ wcAcV E ⊤ σ)).op).hom y) := by rw [hy τ]
        _ = _ := hcomp _ _ _
    · intro y hy
      apply (G0 D (wcAcV E ⊤ σ) hD).1 y
      intro a
      have h := hcomp (show wcAcV E (wcAcV D ⊤ a) σ ≤ wcAcV E ⊤ σ from
        inf_le_inf_left _ le_top) (hle a) y
      rw [hy a, map_zero] at h
      exact h.symm

  have DVcAdd : ∀ s σ t z w, DVc s σ t (z + w) = DVc s σ t z + DVc s σ t w := by
    intro s σ t z w
    funext τ'
    simp only [DVc, Pi.add_apply, map_add, smul_add, Finset.sum_add_distrib]
  have DVcSmul : ∀ s σ t (b : B) z, DVc s σ t (b • z) = b • DVc s σ t z := by
    intro s σ t b z
    funext τ'
    simp only [DVc, Pi.smul_apply]
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [resB, smul_comm]
  have hhR : ∀ s t x, dhF (s + 1) t (dhF s t x) = 0 := by
    intro s t x
    funext τ
    exact d0 E (wcAcV D ⊤ τ) s (x τ)
  have vvR : ∀ s t x, dvF s (t + 1) (dvF s t x) = 0 := by
    intro s t x
    funext τ' σ
    exact congrFun ((colT s σ).1 t (fun τ => x τ σ)) τ'
  have comR : ∀ s t x, dvF (s + 1) t (dhF s t x) = dhF s (t + 1) (dvF s t x) := by
    intro s t x
    funext τ' σ'
    simp only [dvF, dhF, DVc, wcAcD, AddMonoidHom.coe_mk, ZeroHom.coe_mk, map_sum, map_zsmul,
      hcomp, Finset.smul_sum, smul_smul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun k _ => Finset.sum_congr rfl (fun l _ => ?_))
    rw [mul_comm]
  have hER : ∀ p x, dhF p 0 (eEF p x) = eEF (p + 1) (wcAcD M E ⊤ p x) := by
    intro p x
    funext τ σ'
    simp only [dhF, eEF, wcAcD, AddMonoidHom.coe_mk, ZeroHom.coe_mk, map_sum, map_zsmul, hcomp]
  have vER : ∀ p x, dvF p 0 (eEF p x) = 0 := by
    intro p x
    funext τ' σ
    simp only [dvF, DVc, eEF, Pi.zero_apply]
    rw [Fin.sum_univ_succ, Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero, hcomp, hcomp]
    simp only [Fin.val_zero, Fin.val_succ, zero_add, pow_zero, pow_one, one_smul, neg_smul]
    exact add_neg_cancel _
  have vDR : ∀ p x, dvF 0 p (eDF p x) = eDF (p + 1) (wcAcD M D ⊤ p x) := by
    intro p x
    funext τ' σ
    simp only [dvF, DVc, eDF, wcAcD, AddMonoidHom.coe_mk, ZeroHom.coe_mk, map_sum, map_zsmul, hcomp]
  have hDR : ∀ p x, dhF 0 p (eDF p x) = 0 := by
    intro p x
    funext τ σ'
    simp only [dhF, eDF, wcAcD, AddMonoidHom.coe_mk, ZeroHom.coe_mk, Pi.zero_apply]
    rw [Fin.sum_univ_succ, Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero, hcomp, hcomp]
    simp only [Fin.val_zero, Fin.val_succ, zero_add, pow_zero, pow_one, one_smul, neg_smul]
    exact add_neg_cancel _
  have iER : ∀ p x, eEF p x = 0 → x = 0 := by
    intro p x hx
    funext σ
    apply (colT p σ).2.2.2 (x σ)
    intro τ
    exact congrFun (congrFun hx τ) σ
  have iDR : ∀ p x, eDF p x = 0 → x = 0 := by
    intro p x hx
    funext τ
    apply (G0 E (wcAcV D ⊤ τ) hE).1 (x τ)
    intro a
    exact congrFun (congrFun hx τ) a
  have augCR : ∀ s x, dvF s 0 x = 0 → ∃ y, x = eEF s y := by
    intro s x hx
    have h : ∀ σ : Fin (s + 1) ↪o Fin r, ∃ y : Γ(M, wcAcV E ⊤ σ), ∀ τ, x τ σ =
        (M.presheaf.map (homOfLE (show wcAcV E (wcAcV D ⊤ τ) σ ≤ wcAcV E ⊤ σ from
          inf_le_inf_left _ le_top)).op).hom y :=
      fun σ => (colT s σ).2.2.1 (fun τ => x τ σ) (funext fun τ' => congrFun (congrFun hx τ') σ)
    choose y hy using h
    exact ⟨y, funext fun τ => funext fun σ => hy σ τ⟩
  have exCR : ∀ s t x, dvF s (t + 1) x = 0 → ∃ y, x = dvF s t y := by
    intro s t x hx
    have h := fun σ : Fin (s + 1) ↪o Fin r =>
      (colT s σ).2.1 t (fun τ => x τ σ) (funext fun τ' => congrFun (congrFun hx τ') σ)
    choose y hy using h
    exact ⟨fun τ σ => y σ τ, funext fun τ' => funext fun σ => congrFun (hy σ) τ'⟩
  have augRR : ∀ t x, dhF 0 t x = 0 → ∃ y, x = eDF t y := by
    intro t x hx
    have h := fun τ : Fin (t + 1) ↪o Fin n =>
      (G0 E (wcAcV D ⊤ τ) hE).2 (x τ) (congrFun hx τ)
    choose y hy using h
    exact ⟨y, funext fun τ => funext fun a => hy τ a⟩
  have exRR : ∀ s t x, dhF (s + 1) t x = 0 → ∃ y, x = dhF s t y := by
    intro s t x hx
    have h := fun τ : Fin (t + 1) ↪o Fin n => hrow t τ s (x τ) (congrFun hx τ)
    choose y hy using h
    exact ⟨y, funext fun τ => hy τ⟩

  let dh : ∀ s t, (∀ τ : Fin (t + 1) ↪o Fin n, wcAcC M E (wcAcV D ⊤ τ) s) →ₗ[B]
      (∀ τ : Fin (t + 1) ↪o Fin n, wcAcC M E (wcAcV D ⊤ τ) (s + 1)) := fun s t =>
    { toFun := dhF s t
      map_add' := fun x y => funext fun τ => map_add _ (x τ) (y τ)
      map_smul' := fun b x => funext fun τ => acdB E _ s b (x τ) }
  let dv : ∀ s t, (∀ τ : Fin (t + 1) ↪o Fin n, wcAcC M E (wcAcV D ⊤ τ) s) →ₗ[B]
      (∀ τ : Fin (t + 1 + 1) ↪o Fin n, wcAcC M E (wcAcV D ⊤ τ) s) := fun s t =>
    { toFun := dvF s t
      map_add' := fun x y => funext fun τ' => funext fun σ =>
        congrFun (DVcAdd s σ t (fun τ => x τ σ) (fun τ => y τ σ)) τ'
      map_smul' := fun b x => funext fun τ' => funext fun σ =>
        congrFun (DVcSmul s σ t b (fun τ => x τ σ)) τ' }
  let dE : ∀ p, wcAcC M E ⊤ p →ₗ[B] wcAcC M E ⊤ (p + 1) := fun p =>
    { toFun := wcAcD M E ⊤ p
      map_add' := fun x y => map_add _ x y
      map_smul' := fun b x => acdB E ⊤ p b x }
  let dD : ∀ p, wcAcC M D ⊤ p →ₗ[B] wcAcC M D ⊤ (p + 1) := fun p =>
    { toFun := wcAcD M D ⊤ p
      map_add' := fun x y => map_add _ x y
      map_smul' := fun b x => acdB D ⊤ p b x }
  let eE : ∀ p, wcAcC M E ⊤ p →ₗ[B] (∀ τ : Fin (0 + 1) ↪o Fin n, wcAcC M E (wcAcV D ⊤ τ) p) :=
    fun p =>
    { toFun := eEF p
      map_add' := fun x y => funext fun τ => funext fun σ => map_add _ (x σ) (y σ)
      map_smul' := fun b x => funext fun τ => funext fun σ => resB _ b (x σ) }
  let eD : ∀ p, wcAcC M D ⊤ p →ₗ[B] (∀ τ : Fin (p + 1) ↪o Fin n, wcAcC M E (wcAcV D ⊤ τ) 0) :=
    fun p =>
    { toFun := eDF p
      map_add' := fun x y => funext fun τ => funext fun σ => map_add _ (x τ) (y τ)
      map_smul' := fun b x => funext fun τ => funext fun σ => resB _ b (x τ) }
  have iE' : ∀ p, Function.Injective (eE p) := fun p =>
    (injective_iff_map_eq_zero (eE p)).mpr (iER p)
  have iD' : ∀ p, Function.Injective (eD p) := fun p =>
    (injective_iff_map_eq_zero (eD p)).mpr (iDR p)
  unfold wcAcFG at hFG ⊢
  obtain ⟨hF0, hFp⟩ := hFG
  obtain ⟨S0, Sp⟩ := stair (fun s t => ∀ τ : Fin (t + 1) ↪o Fin n, wcAcC M E (wcAcV D ⊤ τ) s)
    (fun p => wcAcC M E ⊤ p) (fun p => wcAcC M D ⊤ p) dh dv dE dD eE eD hhR vvR comR hER vER
    vDR hDR iE' iD' augCR exCR augRR exRR
  exact ⟨S0 hF0, fun p => Sp p (hFp p)⟩

theorem wcpa_dj_cgs_laur_fg_transfer : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (Y : Scheme.{u}) (hY : Y ⟶ Spec (.of B)) {m : ℕ} (L : Y.Modules) (D : Fin (m + 1) → Y.Opens) (K : Submodule (MvPolynomial (Fin (m + 1)) B) (Fin 1 → MvPolynomial (Fin (m + 1)) B)) (w : ℤ) (Θ : ∀ q : ℕ, (Finset (Fin (m + 1)) → Fin 1 → (Fin (m + 1) → ℤ) →₀ B) → wcAcC L D ⊤ q), wcGsLaurModel L D ⊤ B (wcCnSigma hY ⊤) K w Θ → (∀ p : ℕ, wcGradedH B (m + 1) 1 (fun _ => 0) K p w) → wcAcFG B Y hY L D :=
by
  intro B _ _ Y hY m L D K w Θ hΘ hG
  classical
  obtain ⟨M1, _M2, M3, M4, M5, M6⟩ := hΘ

  have hnoeth : ∀ (V : Type u) [AddCommGroup V] [Module B V] (N₀ : Submodule B V) (ι : Type u)
      (F : ι → V) (k : ℕ) (c : Fin k → V), (∀ i, ∃ b : Fin k → B, F i - ∑ l, b l • c l ∈ N₀) →
      ∃ (m : ℕ) (s : Fin m → ι), ∀ i, ∃ b : Fin m → B, F i - ∑ j, b j • F (s j) ∈ N₀ := by
    intro V _ _ N₀ ι F k c hF
    let L : (Fin k → B) →ₗ[B] (V ⧸ N₀) := Fintype.linearCombination B (fun l => N₀.mkQ (c l))
    let P : Submodule B (V ⧸ N₀) := Submodule.span B (Set.range (fun i => N₀.mkQ (F i)))
    have hPL : P ≤ LinearMap.range L := by
      rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      obtain ⟨b, hb⟩ := hF i
      refine ⟨b, ?_⟩
      have h0 : N₀.mkQ (F i - ∑ l, b l • c l) = 0 := (Submodule.Quotient.mk_eq_zero N₀).mpr hb
      rw [map_sub, map_sum, sub_eq_zero] at h0
      simp only [map_smul] at h0
      rw [Fintype.linearCombination_apply]
      exact h0.symm
    have hfgS : (Submodule.comap L P).FG := IsNoetherian.noetherian _
    have hPfg : P.FG := by
      have := hfgS.map L
      rwa [Submodule.map_comap_eq_of_le hPL] at this
    obtain ⟨T, hTsub, hTspan⟩ := (Submodule.fg_span_iff_fg_span_finset_subset _).mp hPfg
    have hpre : ∀ q : T, ∃ i, N₀.mkQ (F i) = q := fun q => hTsub q.2
    choose g hg using hpre
    refine ⟨T.card, fun j => g (T.equivFin.symm j), fun i => ?_⟩
    have hle : P ≤ Submodule.span B
        (Set.range (fun j : Fin T.card => N₀.mkQ (F (g (T.equivFin.symm j))))) := by
      change Submodule.span B _ ≤ _
      rw [hTspan, Submodule.span_le]
      intro q hq
      apply Submodule.subset_span
      refine ⟨T.equivFin ⟨q, hq⟩, ?_⟩
      simp only [Equiv.symm_apply_apply]
      exact hg ⟨q, hq⟩
    have hmem : N₀.mkQ (F i) ∈ P := Submodule.subset_span ⟨i, rfl⟩
    obtain ⟨b, hb⟩ := (Submodule.mem_span_range_iff_exists_fun B).mp (hle hmem)
    refine ⟨b, ?_⟩
    apply (Submodule.Quotient.mk_eq_zero N₀).mp
    change N₀.mkQ _ = 0
    rw [map_sub, map_sum, sub_eq_zero]
    simp only [map_smul]
    exact hb.symm

  have hKC : ∀ (σ : Finset (Fin (m + 1))) (x : Fin 1 → (Fin (m + 1) → ℤ) →₀ B),
      x ∈ wcLaurK B (m + 1) 1 (fun _ => 0) K w σ → x ∈ wcLaurC B (m + 1) 1 (fun _ => 0) w σ := by
    intro σ x hx
    unfold wcLaurK at hx
    simp only [wcLaurC, Set.mem_setOf_eq]
    induction hx using Submodule.span_induction with
    | mem v hv =>
      obtain ⟨k, f, _, hdeg, rfl⟩ := hv
      intro r
      refine Submodule.sum_mem _ (fun mm hm => ?_)
      apply Finsupp.single_mem_supported
      rw [Set.mem_setOf_eq]
      refine ⟨?_, ?_⟩
      · have h1 := hdeg r mm hm
        rw [Finset.sum_sub_distrib, h1]
        have h2 : ∑ i : Fin (m + 1), (if i ∈ σ then (k : ℤ) else 0) = (σ.card : ℤ) * k := by
          rw [Finset.sum_ite_mem, Finset.univ_inter, Finset.sum_const, nsmul_eq_mul]
        rw [h2]
        push_cast
        ring
      · intro i hi
        simp only [hi, if_false, sub_zero]
        exact Int.natCast_nonneg _
    | zero => intro r; exact Submodule.zero_mem _
    | add x y _ _ hx hy => intro r; exact Submodule.add_mem _ (hx r) (hy r)
    | smul a x _ hx => intro r; exact Submodule.smul_mem _ a (hx r)

  have hS' : ∀ (U V : Y.Opens) (h : V ≤ U) (c : B),
      (Y.presheaf.map (homOfLE h).op).hom (wcCnSigma hY U c) = wcCnSigma hY V c := by
    intro U V h c
    change (Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op ≫ Y.presheaf.map (homOfLE h).op).hom
        ((hY.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom) c) =
      (Y.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom
        ((hY.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom) c)
    rw [← Functor.map_comp]
    rfl
  have hres : ∀ (U V : Y.Opens) (h : V ≤ U) (b : B) (s : Γ(L, U)),
      (L.presheaf.map (homOfLE h).op).hom (wcCnSigma hY U b • s) =
        wcCnSigma hY V b • (L.presheaf.map (homOfLE h).op).hom s := by
    intro U V h b s
    have e := Scheme.Modules.map_smul L (homOfLE h) (wcCnSigma hY U b) s
    have e2 := hS' U V h b
    exact e.trans (congrArg (· • (L.presheaf.map (homOfLE h).op).hom s) e2)

  have hσ : ∀ (p : ℕ) (b : B) (x : wcAcC L D ⊤ p),
      wcAcD L D ⊤ p (fun a => wcCnSigma hY (wcAcV D ⊤ a) b • x a) =
        fun a => wcCnSigma hY (wcAcV D ⊤ a) b • wcAcD L D ⊤ p x a := by
    intro p b x
    funext a
    simp only [wcAcD, AddMonoidHom.coe_mk, ZeroHom.coe_mk]
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [hres]
    exact smul_comm _ _ _

  have hC : ∀ (q : ℕ) (v : Finset (Fin (m + 1)) → Fin 1 → (Fin (m + 1) → ℤ) →₀ B),
      (∀ s : Finset (Fin (m + 1)), s.card = q + 1 → v s ∈ wcLaurC B (m + 1) 1 (fun _ => 0) w s) →
      ∀ τ : Finset (Fin (m + 1)), τ.card = q + 2 →
        wcAltD (A := B) (m + 1) v τ ∈ wcLaurC B (m + 1) 1 (fun _ => 0) w τ := by
    intro q v hv τ hτ
    simp only [wcLaurC, Set.mem_setOf_eq] at hv ⊢
    intro r
    simp only [wcAltD, Finset.sum_apply, Pi.smul_apply]
    refine Submodule.sum_mem _ (fun i hi => Submodule.smul_mem _ _ ?_)
    have hcard : (τ.erase i).card = q + 1 := by
      have := Finset.card_erase_of_mem hi
      omega
    refine Finsupp.supported_mono ?_ (hv (τ.erase i) hcard r)
    rintro β ⟨h1, h2⟩
    exact ⟨h1, fun j hj => h2 j (fun hj' => hj (Finset.mem_of_mem_erase hj'))⟩
  have hΘ0 : ∀ q, Θ q 0 = 0 := fun q => (AddMonoidHom.mk' (Θ q) (M1 q)).map_zero
  have hAlt0 : wcAltD (A := B) (m + 1)
      (0 : Finset (Fin (m + 1)) → Fin 1 → (Fin (m + 1) → ℤ) →₀ B) = 0 := by
    funext τ
    simp [wcAltD]

  have hchase : ∀ P : ℕ, wcGradedH B (m + 1) 1 (fun _ => 0) K P w →
      ∃ (k : ℕ) (c : Fin k → wcAcC L D ⊤ P), ∀ z : wcAcC L D ⊤ P, wcAcD L D ⊤ P z = 0 →
        ∃ (bb : Fin k → B) (y : Finset (Fin (m + 1)) → Fin 1 → (Fin (m + 1) → ℤ) →₀ B),
          (∀ σ : Finset (Fin (m + 1)), (σ.card = P → y σ ∈ wcLaurC B (m + 1) 1 (fun _ => 0) w σ) ∧
            (σ.card ≠ P → y σ = 0)) ∧ (P = 0 → y = 0) ∧
          z = ∑ i, ((fun a => wcCnSigma hY (wcAcV D ⊤ a) (bb i) • c i a) : wcAcC L D ⊤ P) +
            Θ P (wcAltD (A := B) (m + 1) y) := by
    intro P hGP
    obtain ⟨k, c, hc⟩ := hGP
    refine ⟨k, fun l => Θ P (c l), fun z hz => ?_⟩
    obtain ⟨v, hv, hvz⟩ := M4 P z
    have hvC : ∀ s : Finset (Fin (m + 1)), s.card = P + 1 →
        v s ∈ wcLaurC B (m + 1) 1 (fun _ => 0) w s := fun s hs => (hv s).1 hs
    have hu : ∀ τ : Finset (Fin (m + 1)), τ.card = P + 2 →
        wcAltD (A := B) (m + 1) v τ ∈ wcLaurK B (m + 1) 1 (fun _ => 0) K w τ := by
      have h1 : Θ (P + 1) (wcAltD (A := B) (m + 1) v) = 0 := by
        rw [M6 P v hvC, hvz, hz]
      exact (M5 (P + 1) _ (hC P v hvC)).mp h1
    obtain ⟨bb, y, hy, hy0, hyK⟩ := hc v hv hu
    refine ⟨bb, y, hy, hy0, ?_⟩
    have hes : ∀ s, (v - (∑ l, bb l • c l) - wcAltD (A := B) (m + 1) y) s =
        v s - ∑ l, bb l • c l s - wcAltD (A := B) (m + 1) y s := by
      intro s
      simp only [Pi.sub_apply, Finset.sum_apply, Pi.smul_apply]
    have heK : ∀ s : Finset (Fin (m + 1)), s.card = P + 1 →
        (v - (∑ l, bb l • c l) - wcAltD (A := B) (m + 1) y) s ∈
          wcLaurK B (m + 1) 1 (fun _ => 0) K w s := by
      intro s hs
      rw [hes]
      exact hyK s hs
    have heC : ∀ s : Finset (Fin (m + 1)), s.card = P + 1 →
        (v - (∑ l, bb l • c l) - wcAltD (A := B) (m + 1) y) s ∈
          wcLaurC B (m + 1) 1 (fun _ => 0) w s :=
      fun s hs => hKC s _ (heK s hs)
    have he0 : Θ P (v - (∑ l, bb l • c l) - wcAltD (A := B) (m + 1) y) = 0 :=
      (M5 P _ heC).mpr heK
    have hXΘ : Θ P (∑ l, bb l • c l) =
        ∑ l, ((fun a => wcCnSigma hY (wcAcV D ⊤ a) (bb l) • Θ P (c l) a) : wcAcC L D ⊤ P) := by
      have h1 : Θ P (∑ l, bb l • c l) = ∑ l, Θ P (bb l • c l) :=
        map_sum (AddMonoidHom.mk' (Θ P) (M1 P)) (fun l => bb l • c l) Finset.univ
      rw [h1]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [M3 P (bb l) (c l)]
      funext a
      exact congrArg (· • Θ P (c l) a) (hS' ⊤ (wcAcV D ⊤ a) inf_le_right (bb l))
    have hv' : v = (v - (∑ l, bb l • c l) - wcAltD (A := B) (m + 1) y) + (∑ l, bb l • c l) +
        wcAltD (A := B) (m + 1) y := by abel
    have key : Θ P v =
        ∑ l, ((fun a => wcCnSigma hY (wcAcV D ⊤ a) (bb l) • Θ P (c l) a) : wcAcC L D ⊤ P) +
          Θ P (wcAltD (A := B) (m + 1) y) := by
      rw [hv', M1, M1, he0, zero_add, hXΘ]
    rw [← hvz]
    exact key

  have hup : ∀ (q : ℕ) (R : wcAcC L D ⊤ q → Prop), R 0 → (∀ x y, R x → R y → R (x + y)) →
      (∀ (b : B) (x : wcAcC L D ⊤ q), R x → R (fun a => wcCnSigma hY (wcAcV D ⊤ a) b • x a)) →
      ∀ (k : ℕ) (c : Fin k → wcAcC L D ⊤ q),
      (∀ z : wcAcC L D ⊤ q, wcAcD L D ⊤ q z = 0 → ∃ bb : Fin k → B,
        R (z - ∑ i, ((fun a => wcCnSigma hY (wcAcV D ⊤ a) (bb i) • c i a) : wcAcC L D ⊤ q))) →
      ∃ (k' : ℕ) (c' : Fin k' → wcAcC L D ⊤ q), (∀ i, wcAcD L D ⊤ q (c' i) = 0) ∧
        ∀ z : wcAcC L D ⊤ q, wcAcD L D ⊤ q z = 0 → ∃ bb : Fin k' → B,
          R (z - ∑ i, ((fun a => wcCnSigma hY (wcAcV D ⊤ a) (bb i) • c' i a) : wcAcC L D ⊤ q)) := by
    intro q R hR0 hRadd hRsmul k c hc
    letI inst : Module B (wcAcC L D ⊤ q) :=
      { smul := fun b x a => wcCnSigma hY (wcAcV D ⊤ a) b • x a
        one_smul := by
          intro x
          funext a
          exact (congrArg (· • x a) (map_one (wcCnSigma hY (wcAcV D ⊤ a)))).trans (one_smul _ _)
        mul_smul := by
          intro b c x
          funext a
          exact (congrArg (· • x a) (map_mul (wcCnSigma hY (wcAcV D ⊤ a)) b c)).trans
            (mul_smul _ _ _)
        smul_zero := by
          intro b
          funext a
          exact smul_zero _
        smul_add := by
          intro b x y
          funext a
          exact smul_add _ _ _
        add_smul := by
          intro b c x
          funext a
          exact (congrArg (· • x a) (map_add (wcCnSigma hY (wcAcV D ⊤ a)) b c)).trans
            (add_smul _ _ _)
        zero_smul := by
          intro x
          funext a
          exact (congrArg (· • x a) (map_zero (wcCnSigma hY (wcAcV D ⊤ a)))).trans
            (zero_smul _ _) }
    let N0 : Submodule B (wcAcC L D ⊤ q) :=
      { carrier := {x | R x}
        add_mem' := by
          intro x y hx hy
          exact hRadd x y hx hy
        zero_mem' := hR0
        smul_mem' := by
          intro b x hx
          exact hRsmul b x hx }
    obtain ⟨k', s, hs⟩ := hnoeth (wcAcC L D ⊤ q) N0
      {z : wcAcC L D ⊤ q // wcAcD L D ⊤ q z = 0} Subtype.val k c (fun i => hc i.1 i.2)
    exact ⟨k', fun j => (s j).1, fun j => (s j).2, fun z hz => hs ⟨z, hz⟩⟩

  unfold wcAcFG
  constructor
  · obtain ⟨k, c, hc⟩ := hchase 0 (hG 0)
    have hin : ∀ z : wcAcC L D ⊤ 0, wcAcD L D ⊤ 0 z = 0 → ∃ bb : Fin k → B,
        (z - ∑ i, ((fun a => wcCnSigma hY (wcAcV D ⊤ a) (bb i) • c i a) : wcAcC L D ⊤ 0)) = 0 := by
      intro z hz
      obtain ⟨bb, y, -, hy0, hz'⟩ := hc z hz
      rw [hy0 rfl, hAlt0, hΘ0, add_zero] at hz'
      exact ⟨bb, sub_eq_zero.mpr hz'⟩
    obtain ⟨k', c', hc'1, hc'2⟩ := hup 0 (fun x => x = 0) rfl
      (fun x y (hx : x = 0) (hy : y = 0) => by rw [hx, hy, add_zero])
      (fun b x (hx : x = 0) => by
        subst hx
        show (fun a => wcCnSigma hY (wcAcV D ⊤ a) b • (0 : wcAcC L D ⊤ 0) a) = 0
        funext a
        exact smul_zero _)
      k c hin
    exact ⟨k', c', hc'1, fun z hz => by
      obtain ⟨bb, h⟩ := hc'2 z hz
      exact ⟨bb, sub_eq_zero.mp h⟩⟩
  · intro p
    obtain ⟨k, c, hc⟩ := hchase (p + 1) (hG (p + 1))
    have hin : ∀ z : wcAcC L D ⊤ (p + 1), wcAcD L D ⊤ (p + 1) z = 0 → ∃ bb : Fin k → B,
        ∃ x' : wcAcC L D ⊤ p,
          (z - ∑ i, ((fun a => wcCnSigma hY (wcAcV D ⊤ a) (bb i) • c i a) : wcAcC L D ⊤ (p + 1)))
            = wcAcD L D ⊤ p x' := by
      intro z hz
      obtain ⟨bb, y, hy, -, hz'⟩ := hc z hz
      refine ⟨bb, Θ p y, ?_⟩
      rw [hz', M6 p y (fun s hs => (hy s).1 hs)]
      abel
    obtain ⟨k', c', hc'1, hc'2⟩ := hup (p + 1) (fun x => ∃ x' : wcAcC L D ⊤ p, x = wcAcD L D ⊤ p x')
      ⟨0, (map_zero _).symm⟩
      (by
        rintro x y ⟨x', rfl⟩ ⟨y', rfl⟩
        exact ⟨x' + y', (map_add _ _ _).symm⟩)
      (by
        rintro b x ⟨x', rfl⟩
        exact ⟨fun a => wcCnSigma hY (wcAcV D ⊤ a) b • x' a, (hσ p b x').symm⟩)
      k c hin
    refine ⟨k', c', hc'1, fun z hz => ?_⟩
    obtain ⟨bb, x', hx'⟩ := hc'2 z hz
    refine ⟨bb, x', ?_⟩
    rw [← hx']
    abel

theorem wcpa_dj_cgs_lm_chartJ_graded : ∀ (A : Type u) [CommRing A] (n : ℕ) (R1 : Fin n → Type u) [∀ i, CommRing (R1 i)] (α1 : ∀ i, A →+* R1 i) (t : ∀ i : Fin n, Fin n → R1 i), (∀ f ∈ wcChartJ A n R1 α1 t, ∀ t' : ℕ, (fun r => if (fun _ : Fin 1 => (0 : ℕ)) r ≤ t' then MvPolynomial.homogeneousComponent (t' - (fun _ : Fin 1 => (0 : ℕ)) r) (f r) else 0) ∈ wcChartJ A n R1 α1 t) ∧ ∀ f ∈ wcChartJ A n R1 α1 t, ∀ j, MvPolynomial.eval₂ (α1 j) (t j) (f 0) = 0 :=
by
  intro A _ n R1 _ α1 t
  classical
  have hmulhc : ∀ (φ ψ : MvPolynomial (Fin n) A) (i m : ℕ), φ.IsHomogeneous i →
      MvPolynomial.homogeneousComponent m (φ * ψ) =
        if i ≤ m then φ * MvPolynomial.homogeneousComponent (m - i) ψ else 0 := by
    intro φ ψ i m hφ
    let _ := @MvPolynomial.gradedAlgebra (Fin n) A _
    have hdec : ∀ (p : MvPolynomial (Fin n) A) (k : ℕ),
        ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin n) A) p) k :
          MvPolynomial (Fin n) A) = MvPolynomial.homogeneousComponent k p :=
      fun p k => MvPolynomial.decomposition.decompose'_apply p k
    have := DirectSum.coe_decompose_mul_of_left_mem
      (MvPolynomial.homogeneousSubmodule (Fin n) A)
      (b := ψ) m ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr hφ)
    rw [hdec, hdec] at this
    exact this
  refine ⟨?_, ?_⟩
  · intro f hf t'
    unfold wcChartJ at hf ⊢
    obtain ⟨N, c, gg, rfl⟩ := Submodule.mem_span_set'.mp hf
    choose e he _ using fun i => (gg i).2
    have hhom : ∀ i (r : Fin 1),
        ((gg i : Fin 1 → MvPolynomial (Fin n) A) r).IsHomogeneous (e i) := by
      intro i r
      rw [Fin.fin_one_eq_zero r]
      exact he i
    have key : (fun r : Fin 1 => if (fun _ : Fin 1 => (0 : ℕ)) r ≤ t' then
        MvPolynomial.homogeneousComponent (t' - (fun _ : Fin 1 => (0 : ℕ)) r)
          ((∑ i, c i • (gg i : Fin 1 → MvPolynomial (Fin n) A)) r) else 0) =
        ∑ i, (if e i ≤ t' then MvPolynomial.homogeneousComponent (t' - e i) (c i) else 0) •
          (gg i : Fin 1 → MvPolynomial (Fin n) A) := by
      funext r
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Nat.zero_le, if_true,
        Nat.sub_zero, map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [mul_comm, hmulhc _ _ _ _ (hhom i r)]
      by_cases h : e i ≤ t'
      · rw [if_pos h, if_pos h, mul_comm]
      · rw [if_neg h, if_neg h, zero_mul]
    rw [key]
    exact Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span (gg i).2))
  · intro f hf j
    unfold wcChartJ at hf
    induction hf using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨_, _, h⟩ := hx
      exact h j
    | zero => simp
    | add x y _ _ hx hy =>
      simp only [Pi.add_apply, MvPolynomial.eval₂_add, hx, hy, add_zero]
    | smul a x _ hx =>
      simp only [Pi.smul_apply, smul_eq_mul, MvPolynomial.eval₂_mul, hx, mul_zero]

theorem wcpa_dj_cgs_lm_eval_shift : ∀ {A T : Type u} [CommRing A] [CommRing T] (n : ℕ) (α : A →+* T) (u : Fin n → T) (s : Finset (Fin n)), (∀ i ∈ s, IsUnit (u i)) → (∀ (κ : ℕ) (h : MvPolynomial (Fin n) A), wcLaurEval n α u (∑ μ ∈ h.support, Finsupp.single (fun i => (μ i : ℤ) - if i ∈ s then (κ : ℤ) else 0) (h.coeff μ)) = (∏ i ∈ s, Ring.inverse (u i)) ^ κ * MvPolynomial.eval₂ α u h) ∧ (∀ (a0 : Fin n) (w : ℤ) (N : ℕ) (P : MvPolynomial (Fin n) A), a0 ∈ s → u a0 = 1 → ∃ x : (Fin n → ℤ) →₀ A, x ∈ Finsupp.supported A A {β : Fin n → ℤ | ∑ i, β i = w ∧ ∀ i, i ∉ s → 0 ≤ β i} ∧ wcLaurEval n α u x = (∏ i ∈ s, Ring.inverse (u i)) ^ N * MvPolynomial.eval₂ α u P) :=
by
  intro A T _ _ n α u s hs
  classical

  have hE1 : ∀ (v : T) (m κ : ℕ), IsUnit v →
      v ^ ((m : ℤ) - (κ : ℤ)).toNat * Ring.inverse v ^ (-((m : ℤ) - (κ : ℤ))).toNat
        = v ^ m * Ring.inverse v ^ κ := by
    intro v m κ hv
    have hvi : v * Ring.inverse v = 1 := Ring.mul_inverse_cancel v hv
    rcases le_total κ m with hkm | hmk
    · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hkm
      have h1 : ((κ + d : ℕ) : ℤ) - (κ : ℤ) = (d : ℤ) := by push_cast; ring
      rw [h1, Int.toNat_natCast, Int.toNat_neg_natCast, pow_zero, mul_one, pow_add,
        mul_comm (v ^ κ) (v ^ d), mul_assoc, ← mul_pow, hvi, one_pow, mul_one]
    · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hmk
      have h1 : -((m : ℤ) - ((m + d : ℕ) : ℤ)) = (d : ℤ) := by push_cast; ring
      have h2 : ((m : ℤ) - ((m + d : ℕ) : ℤ)).toNat = 0 := by
        apply Int.toNat_eq_zero.mpr; push_cast; omega
      rw [h1, h2, Int.toNat_natCast, pow_zero, one_mul, pow_add, ← mul_assoc, ← mul_pow, hvi,
        one_pow, one_mul]

  have hS : ∀ {ι : Type} (S : Finset ι) (b : ι → Fin n → ℤ) (c : ι → A),
      wcLaurEval n α u (∑ j ∈ S, Finsupp.single (b j) (c j)) =
        ∑ j ∈ S, α (c j) * ∏ k, (u k ^ (b j k).toNat * Ring.inverse (u k) ^ (-(b j k)).toNat) := by
    intro ι S b c
    induction S using Finset.induction_on with
    | empty => simp [wcLaurEval]
    | insert j S hj ih =>
      rw [Finset.sum_insert hj, Finset.sum_insert hj, ← ih]
      unfold wcLaurEval
      rw [Finsupp.sum_add_index' (fun β => by simp) (fun β c c' => by rw [map_add, add_mul]),
        Finsupp.sum_single_index (by simp)]

  have hP : ∀ (κ : ℕ) (μ : Fin n →₀ ℕ) (β : Fin n → ℤ),
      (∀ k, u k = 1 ∨ β k = (μ k : ℤ) - (if k ∈ s then (κ : ℤ) else 0)) →
      ∏ k, (u k ^ (β k).toNat * Ring.inverse (u k) ^ (-(β k)).toNat) =
        (∏ i ∈ s, Ring.inverse (u i)) ^ κ * ∏ k, u k ^ μ k := by
    intro κ μ β H
    have hpt : ∀ k, u k ^ (β k).toNat * Ring.inverse (u k) ^ (-(β k)).toNat =
        (if k ∈ s then Ring.inverse (u k) ^ κ else 1) * u k ^ μ k := by
      intro k
      rcases H k with h1 | h1
      · rw [h1, Ring.inverse_one]; simp
      · by_cases hk : k ∈ s
        · rw [h1, if_pos hk, if_pos hk, hE1 (u k) (μ k) κ (hs k hk), mul_comm]
        · rw [h1, if_neg hk, if_neg hk, sub_zero, Int.toNat_natCast, Int.toNat_neg_natCast,
            pow_zero, mul_one, one_mul]
    rw [Finset.prod_congr rfl (fun k _ => hpt k), Finset.prod_mul_distrib, Finset.prod_ite_mem,
      Finset.univ_inter, Finset.prod_pow]

  have hmain : ∀ (κ : ℕ) (P : MvPolynomial (Fin n) A) (b : (Fin n →₀ ℕ) → Fin n → ℤ),
      (∀ μ k, u k = 1 ∨ b μ k = (μ k : ℤ) - (if k ∈ s then (κ : ℤ) else 0)) →
      wcLaurEval n α u (∑ μ ∈ P.support, Finsupp.single (b μ) (P.coeff μ)) =
        (∏ i ∈ s, Ring.inverse (u i)) ^ κ * MvPolynomial.eval₂ α u P := by
    intro κ P b hb
    rw [hS, MvPolynomial.eval₂_eq', Finset.mul_sum]
    refine Finset.sum_congr rfl (fun μ _ => ?_)
    rw [hP κ μ (b μ) (hb μ)]
    ring
  refine ⟨fun κ h => hmain κ h (fun μ i => (μ i : ℤ) - if i ∈ s then (κ : ℤ) else 0)
    (fun μ k => Or.inr rfl), ?_⟩

  intro a0 w N P ha0 hu0
  obtain ⟨b, hb⟩ : ∃ b : (Fin n →₀ ℕ) → Fin n → ℤ, ∀ μ i, b μ i =
      (μ i : ℤ) - (if i ∈ s then (N : ℤ) else 0) +
        (if i = a0 then w - ∑ j, (μ j : ℤ) + (N : ℤ) * (s.card : ℤ) else 0) :=
    ⟨_, fun _ _ => rfl⟩
  refine ⟨∑ μ ∈ P.support, Finsupp.single (b μ) (P.coeff μ), ?_, ?_⟩
  · refine Submodule.sum_mem _ (fun μ _ => Finsupp.single_mem_supported A _ ?_)
    rw [Set.mem_setOf_eq]
    refine ⟨?_, ?_⟩
    · simp only [hb, Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_ite_mem,
        Finset.univ_inter, Finset.sum_const, Finset.sum_ite_eq', Finset.mem_univ, if_true,
        nsmul_eq_mul]
      ring
    · intro i hi
      have hia : i ≠ a0 := fun h => hi (h ▸ ha0)
      rw [hb, if_neg hi, if_neg hia]
      simp
  · refine hmain N P b (fun μ k => ?_)
    by_cases hk : k = a0
    · left; rw [hk]; exact hu0
    · right; rw [hb, if_neg hk, add_zero]

theorem wcpa_dj_cgs_lm_chart_facts : ∀ (Y : Scheme.{u}) (m : ℕ) (g : Y ⟶ wcPm.{u} m) (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)), wcGsCoords m e → (∀ k (W : Y.Opens) (hk : W ≤ g ⁻¹ᵁ wcPmChart m k), (Y.presheaf.map (homOfLE hk).op).hom (g.app (wcPmChart m k) (e k k)) = 1) ∧ (∀ k l i (W : Y.Opens) (hk : W ≤ g ⁻¹ᵁ wcPmChart m k) (hl : W ≤ g ⁻¹ᵁ wcPmChart m l), (Y.presheaf.map (homOfLE hk).op).hom (g.app (wcPmChart m k) (e k i)) = (Y.presheaf.map (homOfLE hk).op).hom (g.app (wcPmChart m k) (e k l)) * (Y.presheaf.map (homOfLE hl).op).hom (g.app (wcPmChart m l) (e l i))) ∧ (∀ k i (W : Y.Opens) (hk : W ≤ g ⁻¹ᵁ wcPmChart m k), Y.basicOpen ((Y.presheaf.map (homOfLE hk).op).hom (g.app (wcPmChart m k) (e k i))) = W ⊓ g ⁻¹ᵁ wcPmChart m i) ∧ (∀ k i (W : Y.Opens) (hk : W ≤ g ⁻¹ᵁ wcPmChart m k), W ≤ g ⁻¹ᵁ wcPmChart m i → IsUnit ((Y.presheaf.map (homOfLE hk).op).hom (g.app (wcPmChart m k) (e k i)))) ∧ (∀ (O : Y.Opens) (p : ℕ) (a : Fin (p + 1) ↪o Fin (m + 1)), Y.basicOpen (∏ j, (Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m (a 0) ≤ g ⁻¹ᵁ wcPmChart m (a 0))).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) (a j)))) = wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a) :=
by
  intro Y m g e he
  obtain ⟨hC1, hC2, hC3, -⟩ := he
  have resZ : ∀ {U V W : Y.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (z : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom z) =
        (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom z := by
    intro U V W h1 h2 z
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have BO0 : ∀ k i, Y.basicOpen (g.app (wcPmChart m k) (e k i)) =
      g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m i := by
    intro k i
    rw [← Scheme.preimage_basicOpen, ← hC2 k i, Scheme.Hom.preimage_inf]
  have hBO : ∀ k i (W : Y.Opens) (hk : W ≤ g ⁻¹ᵁ wcPmChart m k),
      Y.basicOpen ((Y.presheaf.map (homOfLE hk).op).hom (g.app (wcPmChart m k) (e k i))) =
        W ⊓ g ⁻¹ᵁ wcPmChart m i := by
    intro k i W hk
    have h := Scheme.basicOpen_res Y (g.app (wcPmChart m k) (e k i)) (homOfLE hk).op
    refine h.trans ?_
    rw [BO0, ← inf_assoc, inf_eq_left.mpr hk]
  have unitRes : ∀ (U W : Y.Opens) (f : Γ(Y, U)) (hWU : W ≤ U), W ≤ Y.basicOpen f →
      IsUnit ((Y.presheaf.map (homOfLE hWU).op).hom f) := by
    intro U W f hWU hWV
    have h1 : IsUnit ((Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom f) :=
      RingedSpace.isUnit_res_basicOpen Y.toRingedSpace f
    have h2 := h1.map (Y.presheaf.map (homOfLE hWV).op).hom
    rw [resZ] at h2
    exact h2
  have appRes : ∀ (U U' : (wcPm.{u} m).Opens) (hU' : U' ≤ U) (x : Γ(wcPm.{u} m, U))
      (W : Y.Opens) (hW' : W ≤ g ⁻¹ᵁ U') (hW : W ≤ g ⁻¹ᵁ U),
      (Y.presheaf.map (homOfLE hW).op).hom (g.app U x) =
        (Y.presheaf.map (homOfLE hW').op).hom
          (g.app U' (((wcPm.{u} m).presheaf.map (homOfLE hU').op).hom x)) := by
    intro U U' hU' x W hW' hW
    show (g.app U ≫ Y.presheaf.map (homOfLE hW).op).hom x =
      (((wcPm.{u} m).presheaf.map (homOfLE hU').op ≫ g.app U') ≫
        Y.presheaf.map (homOfLE hW').op).hom x
    rw [Scheme.Hom.naturality, Category.assoc, ← Functor.map_comp]
    rfl
  refine ⟨?_, ?_, hBO, ?_, ?_⟩
  · intro k W hk
    rw [hC1 k, map_one, map_one]
  · intro k l i W hk hl
    have hWV : W ≤ g ⁻¹ᵁ (wcPmChart m k ⊓ wcPmChart m l) := by
      rw [Scheme.Hom.preimage_inf]; exact le_inf hk hl
    rw [appRes _ _ (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m k) (e k i) W hWV hk,
      appRes _ _ (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m k) (e k l) W hWV hk,
      appRes _ _ (inf_le_right : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m l) (e l i) W hWV hl,
      ← map_mul, ← map_mul]
    have h3 := hC3 k l i
    exact congrArg (fun z => (Y.presheaf.map (homOfLE hWV).op).hom
      (g.app (wcPmChart m k ⊓ wcPmChart m l) z)) h3
  · intro k i W hk hi
    exact unitRes _ _ _ hk (by rw [BO0]; exact le_inf hk hi)
  · intro O p a
    have L1 : ∀ (U : Y.Opens) (s : Finset (Fin (p + 1))) (f : Fin (p + 1) → Γ(Y, U)),
        Y.basicOpen (∏ j ∈ s, f j) = U ⊓ s.inf (fun j => Y.basicOpen (f j)) := by
      intro U s f
      classical
      refine Finset.induction_on s ?_ ?_
      · rw [Finset.prod_empty, Scheme.basicOpen_one, Finset.inf_empty, inf_top_eq]
      · intro b s hb ih
        rw [Finset.prod_insert hb, Scheme.basicOpen_mul, ih, Finset.inf_insert, inf_left_comm]
    rw [L1]
    simp only [hBO]
    rw [Finset.inf_univ_eq_iInf]
    show _ = (⨅ k, g ⁻¹ᵁ wcPmChart m (a k)) ⊓ O
    apply le_antisymm
    · exact le_inf (le_iInf fun j => inf_le_right.trans ((iInf_le _ j).trans inf_le_right))
        (inf_le_left.trans inf_le_left)
    · have hR : (⨅ k, g ⁻¹ᵁ wcPmChart m (a k)) ⊓ O ≤ O ⊓ g ⁻¹ᵁ wcPmChart m (a 0) :=
        le_inf inf_le_right (inf_le_left.trans (iInf_le _ 0))
      exact le_inf hR (le_iInf fun j => le_inf hR (inf_le_left.trans (iInf_le _ j)))

theorem wcpa_dj_cgs_lm_loc_away : ∀ (Y : Scheme.{u}) (U W : Y.Opens) (f : Γ(Y, U)), IsAffineOpen U → W = Y.basicOpen f → ∀ hWU : W ≤ U, (∀ s : Γ(Y, W), ∃ (n : ℕ) (t : Γ(Y, U)), ((Y.presheaf.map (homOfLE hWU).op).hom f) ^ n * s = (Y.presheaf.map (homOfLE hWU).op).hom t) ∧ (∀ t : Γ(Y, U), (Y.presheaf.map (homOfLE hWU).op).hom t = 0 → ∃ n : ℕ, f ^ n * t = 0) :=
by
  intro Y U W f hU hW hWU
  letI : Algebra Γ(Y, U) Γ(Y, W) := (Y.presheaf.map (homOfLE hWU).op).hom.toAlgebra
  haveI hL : IsLocalization.Away f Γ(Y, W) :=
    hU.isLocalization_of_eq_basicOpen f (homOfLE hWU) hW
  refine ⟨fun s => ?_, fun t ht => ?_⟩
  · obtain ⟨n, a, h⟩ := IsLocalization.Away.surj f s
    exact ⟨n, a, by rw [mul_comm]; exact h⟩
  · obtain ⟨⟨_, n, rfl⟩, hm⟩ :=
      (IsLocalization.map_eq_zero_iff (Submonoid.powers f) Γ(Y, W) t).mp ht
    exact ⟨n, hm⟩

theorem wcpa_dj_cgs_lm_local_surj : ∀ (Y : Scheme.{u}) (m : ℕ) (g : Y ⟶ wcPm.{u} m) (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)), wcGsCoords m e → ∀ (O : Y.Opens) (A : Type u) [CommRing A] (ψ : A →+* Γ(Y, O)), (∀ k, IsAffineOpen (O ⊓ g ⁻¹ᵁ wcPmChart m k)) → (∀ k (s : Γ(Y, O ⊓ g ⁻¹ᵁ wcPmChart m k)), ∃ P : MvPolynomial (Fin (m + 1)) A, MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (inf_le_left : O ⊓ g ⁻¹ᵁ wcPmChart m k ≤ O)).op).hom.comp ψ) (fun l => (Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l))) P = s) → ∀ (w : ℕ) (p : ℕ) (a : Fin (p + 1) ↪o Fin (m + 1)) (r : Γ(Y, wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a)), ∃ x : Fin 1 → (Fin (m + 1) → ℤ) →₀ A, x ∈ wcLaurC A (m + 1) 1 (fun _ => 0) (w : ℤ) (Finset.univ.map a.toEmbedding) ∧ wcLaurEval (m + 1) ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ O)).op).hom.comp ψ) (fun i => (Y.presheaf.map (homOfLE ((inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (a j)) 0)) : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ g ⁻¹ᵁ wcPmChart m (a 0))).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) i))) (x 0) = r :=
by
  intro Y m g e he O A _ ψ hAff hGen w p a r
  classical
  obtain ⟨hdiag, -, -, hunit, hprod⟩ := wcpa_dj_cgs_lm_chart_facts Y m g e he

  have hUa0 : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ g ⁻¹ᵁ wcPmChart m (a 0) :=
    inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (a j)) 0)
  have hUaj : ∀ j, wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ g ⁻¹ᵁ wcPmChart m (a j) := fun j =>
    inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (a j)) j)
  have hUaO : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ O := inf_le_right
  have hWU : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ O ⊓ g ⁻¹ᵁ wcPmChart m (a 0) :=
    le_inf hUaO hUa0
  set π : Γ(Y, O ⊓ g ⁻¹ᵁ wcPmChart m (a 0)) := ∏ j, (Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m (a 0) ≤ g ⁻¹ᵁ wcPmChart m (a 0))).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) (a j))) with hπ
  have hbo : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a = Y.basicOpen π := (hprod O p a).symm

  obtain ⟨N, t, hNt⟩ := (wcpa_dj_cgs_lm_loc_away Y (O ⊓ g ⁻¹ᵁ wcPmChart m (a 0))
    (wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a) π (hAff (a 0)) hbo hWU).1 r

  obtain ⟨P, hP⟩ := hGen (a 0) t
  set ρ := (Y.presheaf.map (homOfLE hWU).op).hom with hρ
  set α := (Y.presheaf.map (homOfLE hUaO).op).hom.comp ψ with hα
  set u : Fin (m + 1) → Γ(Y, wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a) := fun i =>
    (Y.presheaf.map (homOfLE hUa0).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) i)) with hu

  have hresO : ∀ y : Γ(Y, O),
      ρ ((Y.presheaf.map (homOfLE (inf_le_left : O ⊓ g ⁻¹ᵁ wcPmChart m (a 0) ≤ O)).op).hom y) =
        (Y.presheaf.map (homOfLE hUaO).op).hom y := by
    intro y
    rw [hρ, ← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have hresD : ∀ y : Γ(Y, g ⁻¹ᵁ wcPmChart m (a 0)),
      ρ ((Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m (a 0) ≤ g ⁻¹ᵁ wcPmChart m (a 0))).op).hom y) =
        (Y.presheaf.map (homOfLE hUa0).op).hom y := by
    intro y
    rw [hρ, ← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  have hT : MvPolynomial.eval₂ α u P = ρ t := by
    rw [← hP, MvPolynomial.hom_eval₂]
    congr 1
    · ext y
      simp only [RingHom.comp_apply, hα]
      exact (hresO (ψ y)).symm
    · funext l
      exact (hresD _).symm

  have hρπ : ρ π = ∏ i ∈ Finset.univ.map a.toEmbedding, u i := by
    rw [hπ, map_prod, Finset.prod_map]
    refine Finset.prod_congr rfl (fun j _ => ?_)
    rw [hresD]
    rfl

  have hsU : ∀ i ∈ Finset.univ.map a.toEmbedding, IsUnit (u i) := by
    intro i hi
    obtain ⟨j, -, rfl⟩ := Finset.mem_map.mp hi
    exact hunit (a 0) (a j) _ hUa0 (hUaj j)
  have hu0 : u (a 0) = 1 := hdiag (a 0) _ hUa0
  have ha0 : a 0 ∈ Finset.univ.map a.toEmbedding :=
    Finset.mem_map_of_mem a.toEmbedding (Finset.mem_univ 0)

  obtain ⟨x0, hx0mem, hx0⟩ :=
    (wcpa_dj_cgs_lm_eval_shift (m + 1) α u (Finset.univ.map a.toEmbedding) hsU).2
      (a 0) (w : ℤ) N P ha0 hu0
  have hcancel : (∏ i ∈ Finset.univ.map a.toEmbedding, Ring.inverse (u i)) *
      (∏ i ∈ Finset.univ.map a.toEmbedding, u i) = 1 := by
    rw [← Finset.prod_mul_distrib]
    exact Finset.prod_eq_one (fun i hi => Ring.inverse_mul_cancel _ (hsU i hi))
  have hE : wcLaurEval (m + 1) α u x0 = r := by
    rw [hx0, hT, ← hNt, hρπ, ← mul_assoc, ← mul_pow, hcancel, one_pow, one_mul]

  refine ⟨fun _ => x0, ?_, hE⟩
  intro r'
  simpa only [Nat.cast_zero, sub_zero] using hx0mem

theorem wcpa_dj_cgs_lm_ksat_face_to_chart : ∀ (Y : Scheme.{u}) (m : ℕ) (g : Y ⟶ wcPm.{u} m) (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)), wcGsCoords m e → ∀ (O : Y.Opens) (A : Type u) [CommRing A] (ψ : A →+* Γ(Y, O)), (∀ k, IsAffineOpen (O ⊓ g ⁻¹ᵁ wcPmChart m k)) → ∀ (p : ℕ) (a : Fin (p + 1) ↪o Fin (m + 1)) (κ : ℕ) (h : MvPolynomial (Fin (m + 1)) A), wcLaurEval (m + 1) ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ O)).op).hom.comp ψ) (fun i => (Y.presheaf.map (homOfLE ((inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (a j)) 0)) : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ g ⁻¹ᵁ wcPmChart m (a 0))).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) i))) (∑ μ ∈ h.support, Finsupp.single (fun i => (μ i : ℤ) - if i ∈ Finset.univ.map a.toEmbedding then (κ : ℤ) else 0) (h.coeff μ)) = 0 → ∃ N : ℕ, MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (inf_le_left : O ⊓ g ⁻¹ᵁ wcPmChart m (a 0) ≤ O)).op).hom.comp ψ) (fun l => (Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m (a 0) ≤ g ⁻¹ᵁ wcPmChart m (a 0))).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) l))) ((∏ i ∈ Finset.univ.map a.toEmbedding, MvPolynomial.X i ^ N) * h) = 0 :=
by
  intro Y m g e he O A _ ψ hAff p a κ h hE
  classical
  obtain ⟨hC1, hC2, hC3, -⟩ := he

  have shift : ∀ {T : Type u} [CommRing T] (n : ℕ) (α : A →+* T) (u : Fin n → T)
      (s : Finset (Fin n)), (∀ i ∈ s, IsUnit (u i)) → ∀ (κ : ℕ) (h : MvPolynomial (Fin n) A),
      wcLaurEval n α u (∑ μ ∈ h.support, Finsupp.single (fun i => (μ i : ℤ) -
        if i ∈ s then (κ : ℤ) else 0) (h.coeff μ)) =
        (∏ i ∈ s, Ring.inverse (u i)) ^ κ * MvPolynomial.eval₂ α u h := by
    intro T _ n α u s hs
    have hE1 : ∀ (v : T) (m κ : ℕ), IsUnit v →
        v ^ ((m : ℤ) - (κ : ℤ)).toNat * Ring.inverse v ^ (-((m : ℤ) - (κ : ℤ))).toNat
          = v ^ m * Ring.inverse v ^ κ := by
      intro v m κ hv
      have hvi : v * Ring.inverse v = 1 := Ring.mul_inverse_cancel v hv
      rcases le_total κ m with hkm | hmk
      · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hkm
        have h1 : ((κ + d : ℕ) : ℤ) - (κ : ℤ) = (d : ℤ) := by push_cast; ring
        rw [h1, Int.toNat_natCast, Int.toNat_neg_natCast, pow_zero, mul_one, pow_add,
          mul_comm (v ^ κ) (v ^ d), mul_assoc, ← mul_pow, hvi, one_pow, mul_one]
      · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hmk
        have h1 : -((m : ℤ) - ((m + d : ℕ) : ℤ)) = (d : ℤ) := by push_cast; ring
        have h2 : ((m : ℤ) - ((m + d : ℕ) : ℤ)).toNat = 0 := by
          apply Int.toNat_eq_zero.mpr; push_cast; omega
        rw [h1, h2, Int.toNat_natCast, pow_zero, one_mul, pow_add, ← mul_assoc, ← mul_pow, hvi,
          one_pow, one_mul]
    have hS : ∀ {ι : Type} (S : Finset ι) (b : ι → Fin n → ℤ) (c : ι → A),
        wcLaurEval n α u (∑ j ∈ S, Finsupp.single (b j) (c j)) =
          ∑ j ∈ S, α (c j) * ∏ k, (u k ^ (b j k).toNat * Ring.inverse (u k) ^ (-(b j k)).toNat) := by
      intro ι S b c
      induction S using Finset.induction_on with
      | empty => simp [wcLaurEval]
      | insert j S hj ih =>
        rw [Finset.sum_insert hj, Finset.sum_insert hj, ← ih]
        unfold wcLaurEval
        rw [Finsupp.sum_add_index' (fun β => by simp) (fun β c c' => by rw [map_add, add_mul]),
          Finsupp.sum_single_index (by simp)]
    have hP : ∀ (κ : ℕ) (μ : Fin n →₀ ℕ) (β : Fin n → ℤ),
        (∀ k, β k = (μ k : ℤ) - (if k ∈ s then (κ : ℤ) else 0)) →
        ∏ k, (u k ^ (β k).toNat * Ring.inverse (u k) ^ (-(β k)).toNat) =
          (∏ i ∈ s, Ring.inverse (u i)) ^ κ * ∏ k, u k ^ μ k := by
      intro κ μ β H
      have hpt : ∀ k, u k ^ (β k).toNat * Ring.inverse (u k) ^ (-(β k)).toNat =
          (if k ∈ s then Ring.inverse (u k) ^ κ else 1) * u k ^ μ k := by
        intro k
        by_cases hk : k ∈ s
        · rw [H k, if_pos hk, if_pos hk, hE1 (u k) (μ k) κ (hs k hk), mul_comm]
        · rw [H k, if_neg hk, if_neg hk, sub_zero, Int.toNat_natCast, Int.toNat_neg_natCast,
            pow_zero, mul_one, one_mul]
      rw [Finset.prod_congr rfl (fun k _ => hpt k), Finset.prod_mul_distrib, Finset.prod_ite_mem,
        Finset.univ_inter, Finset.prod_pow]
    intro κ P
    rw [hS, MvPolynomial.eval₂_eq', Finset.mul_sum]
    refine Finset.sum_congr rfl (fun μ _ => ?_)
    rw [hP κ μ _ (fun k => rfl)]
    ring

  have cancel : ∀ {T : Type u} [CommRing T] (u : Fin (m + 1) → T) (x : T),
      (∀ i ∈ Finset.univ.map a.toEmbedding, IsUnit (u i)) →
      (∏ i ∈ Finset.univ.map a.toEmbedding, Ring.inverse (u i)) ^ κ * x = 0 → x = 0 := by
    intro T _ u x hu hx
    have hone : (∏ i ∈ Finset.univ.map a.toEmbedding, u i) ^ κ *
        (∏ i ∈ Finset.univ.map a.toEmbedding, Ring.inverse (u i)) ^ κ = 1 := by
      rw [← mul_pow, ← Finset.prod_mul_distrib,
        Finset.prod_congr rfl (fun i hi => Ring.mul_inverse_cancel _ (hu i hi)),
        Finset.prod_const_one, one_pow]
    calc x = ((∏ i ∈ Finset.univ.map a.toEmbedding, u i) ^ κ *
          (∏ i ∈ Finset.univ.map a.toEmbedding, Ring.inverse (u i)) ^ κ) * x := by
            rw [hone, one_mul]
      _ = (∏ i ∈ Finset.univ.map a.toEmbedding, u i) ^ κ *
          ((∏ i ∈ Finset.univ.map a.toEmbedding, Ring.inverse (u i)) ^ κ * x) := mul_assoc _ _ _
      _ = 0 := by rw [hx, mul_zero]

  have resZ : ∀ {U V W : Y.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (z : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom z) =
      (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom z := by
    intro U V W h1 h2 z
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  have BO0 : ∀ k i, Y.basicOpen (g.app (wcPmChart m k) (e k i)) =
      g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m i := by
    intro k i
    rw [← Scheme.preimage_basicOpen, ← hC2 k i, Scheme.Hom.preimage_inf]
  have s3 : ∀ k i (W : Y.Opens) (hk : W ≤ g ⁻¹ᵁ wcPmChart m k),
      Y.basicOpen ((Y.presheaf.map (homOfLE hk).op).hom (g.app (wcPmChart m k) (e k i))) =
        W ⊓ g ⁻¹ᵁ wcPmChart m i := by
    intro k i W hk
    rw [Scheme.basicOpen_res, BO0, ← inf_assoc, inf_eq_left.mpr hk]
  have unit : ∀ k i (W : Y.Opens) (hk : W ≤ g ⁻¹ᵁ wcPmChart m k), W ≤ g ⁻¹ᵁ wcPmChart m i →
      IsUnit ((Y.presheaf.map (homOfLE hk).op).hom (g.app (wcPmChart m k) (e k i))) := by
    intro k i W hk hi
    have hWb : W ≤ Y.basicOpen (g.app (wcPmChart m k) (e k i)) := by
      rw [BO0]; exact le_inf hk hi
    have h1 : IsUnit ((Y.presheaf.map (homOfLE (Y.basicOpen_le
        (g.app (wcPmChart m k) (e k i)))).op).hom (g.app (wcPmChart m k) (e k i))) :=
      RingedSpace.isUnit_res_basicOpen Y.toRingedSpace _
    have h2 := h1.map (Y.presheaf.map (homOfLE hWb).op).hom
    rw [resZ] at h2
    exact h2
  have L1 : ∀ (U : Y.Opens) {ι : Type} (t : Finset ι) (f : ι → Γ(Y, U)),
      Y.basicOpen (∏ j ∈ t, f j) = U ⊓ t.inf (fun j => Y.basicOpen (f j)) := by
    intro U ι t f
    induction t using Finset.induction_on with
    | empty => rw [Finset.prod_empty, Scheme.basicOpen_one, Finset.inf_empty, inf_top_eq]
    | insert b t hb ih =>
      rw [Finset.prod_insert hb, Scheme.basicOpen_mul, ih, Finset.inf_insert, inf_left_comm]
  have hprodBO : Y.basicOpen (∏ j, (Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m (a 0) ≤ g ⁻¹ᵁ wcPmChart m (a 0))).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) (a j)))) = wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a := by
    rw [L1]
    simp only [s3]
    rw [Finset.inf_univ_eq_iInf]
    show _ = (⨅ k, g ⁻¹ᵁ wcPmChart m (a k)) ⊓ O
    apply le_antisymm
    · refine le_inf (le_iInf fun j => ?_) (inf_le_left.trans inf_le_left)
      exact (inf_le_right.trans (iInf_le _ j)).trans inf_le_right
    · have hR : (⨅ k, g ⁻¹ᵁ wcPmChart m (a k)) ⊓ O ≤ O ⊓ g ⁻¹ᵁ wcPmChart m (a 0) :=
        le_inf inf_le_right (inf_le_left.trans (iInf_le _ 0))
      exact le_inf hR (le_iInf fun j => le_inf hR (inf_le_left.trans (iInf_le _ j)))

  have hk0 : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ g ⁻¹ᵁ wcPmChart m (a 0) :=
    inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (a j)) 0)
  have hO : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ O := inf_le_right
  have hWU : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ O ⊓ g ⁻¹ᵁ wcPmChart m (a 0) :=
    le_inf hO hk0

  have hunits : ∀ i ∈ Finset.univ.map a.toEmbedding,
      IsUnit ((Y.presheaf.map (homOfLE hk0).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) i))) := by
    intro i hi
    obtain ⟨j, -, rfl⟩ := Finset.mem_map.mp hi
    exact unit (a 0) (a.toEmbedding j) _ hk0
      (inf_le_left.trans (iInf_le (fun j' => g ⁻¹ᵁ wcPmChart m (a j')) j))

  have hI := shift (m + 1) ((Y.presheaf.map (homOfLE hO).op).hom.comp ψ)
    (fun i => (Y.presheaf.map (homOfLE hk0).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) i)))
    (Finset.univ.map a.toEmbedding) hunits κ h
  have hev := cancel _ _ hunits (hI.symm.trans hE)

  have htr : (Y.presheaf.map (homOfLE hWU).op).hom
      (MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (inf_le_left : O ⊓ g ⁻¹ᵁ wcPmChart m (a 0) ≤ O)).op).hom.comp ψ) (fun l => (Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m (a 0) ≤ g ⁻¹ᵁ wcPmChart m (a 0))).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) l))) h) =
      MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE hO).op).hom.comp ψ)
        (fun i => (Y.presheaf.map (homOfLE hk0).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) i))) h := by
    rw [MvPolynomial.hom_eval₂]
    congr 1
    · refine RingHom.ext fun c => ?_
      show (Y.presheaf.map (homOfLE hWU).op).hom
          ((Y.presheaf.map (homOfLE (inf_le_left : O ⊓ g ⁻¹ᵁ wcPmChart m (a 0) ≤ O)).op).hom (ψ c)) =
        (Y.presheaf.map (homOfLE hO).op).hom (ψ c)
      exact resZ _ _ _
    · funext l
      exact resZ _ _ _

  have hloc : ∀ t : Γ(Y, O ⊓ g ⁻¹ᵁ wcPmChart m (a 0)), (Y.presheaf.map (homOfLE hWU).op).hom t = 0 →
      ∃ n : ℕ, (∏ j, (Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m (a 0) ≤ g ⁻¹ᵁ wcPmChart m (a 0))).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) (a j)))) ^ n * t = 0 := by
    have locgen : ∀ (U W : Y.Opens) (f : Γ(Y, U)), IsAffineOpen U → W = Y.basicOpen f →
        ∀ hWU' : W ≤ U, ∀ t : Γ(Y, U), (Y.presheaf.map (homOfLE hWU').op).hom t = 0 →
          ∃ n : ℕ, f ^ n * t = 0 := by
      intro U W f hU hW hWU' t ht
      letI : Algebra Γ(Y, U) Γ(Y, W) := (Y.presheaf.map (homOfLE hWU').op).hom.toAlgebra
      haveI hL : IsLocalization.Away f Γ(Y, W) :=
        hU.isLocalization_of_eq_basicOpen f (homOfLE hWU') hW
      obtain ⟨⟨_, n, rfl⟩, hm⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers f) Γ(Y, W) t).mp ht
      exact ⟨n, hm⟩
    intro t ht
    exact locgen _ _ _ (hAff (a 0)) hprodBO.symm hWU t ht

  obtain ⟨N, hN⟩ := hloc _ (htr.trans hev)
  refine ⟨N, ?_⟩
  rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_prod]
  simp only [MvPolynomial.eval₂_pow, MvPolynomial.eval₂_X]
  rw [Finset.prod_pow, Finset.prod_map]
  exact hN

theorem wcpa_dj_cgs_lm_ksat_chart_saturate : ∀ (Y : Scheme.{u}) (m : ℕ) (g : Y ⟶ wcPm.{u} m) (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)), wcGsCoords m e → ∀ (O : Y.Opens) (A : Type u) [CommRing A] (ψ : A →+* Γ(Y, O)), (∀ k, IsAffineOpen (O ⊓ g ⁻¹ᵁ wcPmChart m k)) → ∀ (a0 : Fin (m + 1)) (s : Finset (Fin (m + 1))) (D : ℕ) (F : MvPolynomial (Fin (m + 1)) A), a0 ∈ s → F.IsHomogeneous D → MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (inf_le_left : O ⊓ g ⁻¹ᵁ wcPmChart m a0 ≤ O)).op).hom.comp ψ) (fun l => (Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m a0 ≤ g ⁻¹ᵁ wcPmChart m a0)).op).hom (g.app (wcPmChart m a0) (e a0 l))) F = 0 → ∃ M : ℕ, ∀ j, MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (inf_le_left : O ⊓ g ⁻¹ᵁ wcPmChart m j ≤ O)).op).hom.comp ψ) (fun l => (Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m j)).op).hom (g.app (wcPmChart m j) (e j l))) ((∏ i ∈ s, MvPolynomial.X i ^ M) * F) = 0 :=
by
  intro Y m g e he O A _ ψ hAff a0 s D F ha0 hF hV
  obtain ⟨_, hC2, hC3, -⟩ := he

  have resZ : ∀ {U V W : Y.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (h3 : W ≤ U) (z : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom z) =
        (Y.presheaf.map (homOfLE h3).op).hom z := by
    intro U V W h1 h2 h3 z
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  have BO0 : ∀ k i, Y.basicOpen (g.app (wcPmChart m k) (e k i)) =
      g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m i := by
    intro k i
    rw [← Scheme.preimage_basicOpen, ← hC2 k i, Scheme.Hom.preimage_inf]
  have hBO : ∀ k i (W : Y.Opens) (hk : W ≤ g ⁻¹ᵁ wcPmChart m k),
      Y.basicOpen ((Y.presheaf.map (homOfLE hk).op).hom (g.app (wcPmChart m k) (e k i))) =
        W ⊓ g ⁻¹ᵁ wcPmChart m i := by
    intro k i W hk
    have h := Scheme.basicOpen_res Y (g.app (wcPmChart m k) (e k i)) (homOfLE hk).op
    refine h.trans ?_
    rw [BO0, ← inf_assoc, inf_eq_left.mpr hk]

  have appRes : ∀ (U U' : (wcPm.{u} m).Opens) (hU' : U' ≤ U) (x : Γ(wcPm.{u} m, U))
      (W : Y.Opens) (hW' : W ≤ g ⁻¹ᵁ U') (hW : W ≤ g ⁻¹ᵁ U),
      (Y.presheaf.map (homOfLE hW).op).hom (g.app U x) =
        (Y.presheaf.map (homOfLE hW').op).hom
          (g.app U' (((wcPm.{u} m).presheaf.map (homOfLE hU').op).hom x)) := by
    intro U U' hU' x W hW' hW
    show (g.app U ≫ Y.presheaf.map (homOfLE hW).op).hom x =
      (((wcPm.{u} m).presheaf.map (homOfLE hU').op ≫ g.app U') ≫
        Y.presheaf.map (homOfLE hW').op).hom x
    rw [Scheme.Hom.naturality, Category.assoc, ← Functor.map_comp]
    rfl

  have cocycle : ∀ k l i (W : Y.Opens) (hk : W ≤ g ⁻¹ᵁ wcPmChart m k)
      (hl : W ≤ g ⁻¹ᵁ wcPmChart m l),
      (Y.presheaf.map (homOfLE hk).op).hom (g.app (wcPmChart m k) (e k i)) =
        (Y.presheaf.map (homOfLE hk).op).hom (g.app (wcPmChart m k) (e k l)) *
          (Y.presheaf.map (homOfLE hl).op).hom (g.app (wcPmChart m l) (e l i)) := by
    intro k l i W hk hl
    have hWV : W ≤ g ⁻¹ᵁ (wcPmChart m k ⊓ wcPmChart m l) := by
      rw [Scheme.Hom.preimage_inf]; exact le_inf hk hl
    rw [appRes _ _ (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m k) (e k i) W hWV hk,
      appRes _ _ (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m k) (e k l) W hWV hk,
      appRes _ _ (inf_le_right : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m l) (e l i) W hWV hl,
      ← map_mul, ← map_mul]
    have h3 := hC3 k l i
    exact congrArg (fun z => (Y.presheaf.map (homOfLE hWV).op).hom
      (g.app (wcPmChart m k ⊓ wcPmChart m l) z)) h3

  have homog : ∀ {T : Type u} [CommRing T] (α : A →+* T) (u : Fin (m + 1) → T) (lam : T),
      MvPolynomial.eval₂ α (fun i => lam * u i) F = lam ^ D * MvPolynomial.eval₂ α u F := by
    intro T _ α u lam
    rw [MvPolynomial.eval₂_eq', MvPolynomial.eval₂_eq', Finset.mul_sum]
    refine Finset.sum_congr rfl (fun d hd => ?_)
    have hdeg : ∑ i, d i = D := by
      by_contra hne
      have h0 := hF.coeff_eq_zero
        (show Finsupp.degree d ≠ D by rw [Finsupp.degree_eq_sum]; exact hne)
      exact (MvPolynomial.mem_support_iff.mp hd) h0
    simp only [mul_pow]
    rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
    ring

  have key : ∀ (V : Y.Opens) (hVO : V ≤ O) (hVa : V ≤ g ⁻¹ᵁ wcPmChart m a0),
      MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE hVO).op).hom.comp ψ)
        (fun l => (Y.presheaf.map (homOfLE hVa).op).hom (g.app (wcPmChart m a0) (e a0 l))) F
        = 0 := by
    intro V hVO hVa
    have hle : V ≤ O ⊓ g ⁻¹ᵁ wcPmChart m a0 := le_inf hVO hVa
    have h := congrArg (Y.presheaf.map (homOfLE hle).op).hom hV
    rw [map_zero, MvPolynomial.hom_eval₂] at h
    have e1 : (Y.presheaf.map (homOfLE hVO).op).hom.comp ψ =
        (Y.presheaf.map (homOfLE hle).op).hom.comp
          ((Y.presheaf.map (homOfLE (inf_le_left : O ⊓ g ⁻¹ᵁ wcPmChart m a0 ≤ O)).op).hom.comp ψ) :=
      RingHom.ext fun x => (resZ _ _ _ _).symm
    have e2 : (fun l => (Y.presheaf.map (homOfLE hVa).op).hom (g.app (wcPmChart m a0) (e a0 l))) =
        (fun l => (Y.presheaf.map (homOfLE hle).op).hom
          ((Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m a0 ≤
            g ⁻¹ᵁ wcPmChart m a0)).op).hom (g.app (wcPmChart m a0) (e a0 l)))) :=
      funext fun l => (resZ _ _ _ _).symm
    rw [e1, e2]
    exact h

  have hloc : ∀ j, ∃ n : ℕ,
      ((Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m j ≤
        g ⁻¹ᵁ wcPmChart m j)).op).hom (g.app (wcPmChart m j) (e j a0))) ^ n *
      MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (inf_le_left : O ⊓ g ⁻¹ᵁ wcPmChart m j ≤
        O)).op).hom.comp ψ) (fun l => (Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ
          wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m j)).op).hom (g.app (wcPmChart m j) (e j l))) F = 0 := by
    intro j
    have hWU : O ⊓ g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m a0 ≤ O ⊓ g ⁻¹ᵁ wcPmChart m j :=
      inf_le_left
    have hWO : O ⊓ g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m a0 ≤ O :=
      inf_le_left.trans inf_le_left
    have hWj : O ⊓ g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m a0 ≤ g ⁻¹ᵁ wcPmChart m j :=
      inf_le_left.trans inf_le_right
    have hWa : O ⊓ g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m a0 ≤ g ⁻¹ᵁ wcPmChart m a0 :=
      inf_le_right
    have hres : (Y.presheaf.map (homOfLE hWU).op).hom
        (MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (inf_le_left : O ⊓ g ⁻¹ᵁ wcPmChart m j ≤
          O)).op).hom.comp ψ) (fun l => (Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ
            wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m j)).op).hom (g.app (wcPmChart m j) (e j l))) F)
        = 0 := by
      rw [MvPolynomial.hom_eval₂]
      have e1 : (Y.presheaf.map (homOfLE hWU).op).hom.comp
          ((Y.presheaf.map (homOfLE (inf_le_left : O ⊓ g ⁻¹ᵁ wcPmChart m j ≤ O)).op).hom.comp ψ)
          = (Y.presheaf.map (homOfLE hWO).op).hom.comp ψ :=
        RingHom.ext fun x => resZ _ _ _ _
      have e2 : (fun i => (Y.presheaf.map (homOfLE hWU).op).hom
          ((Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m j ≤
            g ⁻¹ᵁ wcPmChart m j)).op).hom (g.app (wcPmChart m j) (e j i)))) =
          fun i => (Y.presheaf.map (homOfLE hWj).op).hom (g.app (wcPmChart m j) (e j a0)) *
            (Y.presheaf.map (homOfLE hWa).op).hom (g.app (wcPmChart m a0) (e a0 i)) :=
        funext fun i => (resZ _ _ hWj _).trans (cocycle j a0 i _ hWj hWa)
      refine (congrArg₂ (fun a b => MvPolynomial.eval₂ a b F) e1 e2).trans ?_
      refine (homog ((Y.presheaf.map (homOfLE hWO).op).hom.comp ψ)
        (fun i => (Y.presheaf.map (homOfLE hWa).op).hom (g.app (wcPmChart m a0) (e a0 i)))
        ((Y.presheaf.map (homOfLE hWj).op).hom (g.app (wcPmChart m j) (e j a0)))).trans ?_
      rw [key _ hWO hWa, mul_zero]
    letI : Algebra Γ(Y, O ⊓ g ⁻¹ᵁ wcPmChart m j)
        Γ(Y, O ⊓ g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m a0) :=
      (Y.presheaf.map (homOfLE hWU).op).hom.toAlgebra
    haveI hL : IsLocalization.Away
        ((Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m j ≤
          g ⁻¹ᵁ wcPmChart m j)).op).hom (g.app (wcPmChart m j) (e j a0)))
        Γ(Y, O ⊓ g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m a0) :=
      (hAff j).isLocalization_of_eq_basicOpen _ (homOfLE hWU) (hBO j a0 _ inf_le_right).symm
    obtain ⟨⟨_, n, rfl⟩, hm⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers
        ((Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m j ≤
          g ⁻¹ᵁ wcPmChart m j)).op).hom (g.app (wcPmChart m j) (e j a0))))
        Γ(Y, O ⊓ g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m a0) _).mp hres
    exact ⟨n, hm⟩

  choose n hn using hloc
  have key2 : ∀ (R : Type u) [CommRing R] (x P E : R) (a b : ℕ), b ≤ a → x ^ b * E = 0 →
      (x ^ a * P) * E = 0 := by
    intro R _ x P E a b hab h
    rw [← Nat.sub_add_cancel hab, pow_add]
    calc (x ^ (a - b) * x ^ b * P) * E = (x ^ (a - b) * P) * (x ^ b * E) := by ring
      _ = 0 := by rw [h, mul_zero]
  refine ⟨∑ j, n j, fun j => ?_⟩
  have hle : n j ≤ ∑ j, n j := Finset.single_le_sum (fun i _ => Nat.zero_le _) (Finset.mem_univ j)
  simp only [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_prod, MvPolynomial.eval₂_pow,
    MvPolynomial.eval₂_X]
  rw [← Finset.mul_prod_erase s _ ha0]
  exact key2 _ _ _ _ _ _ hle (hn j)

theorem wcpa_dj_cgs_lm_local_ker_sat : ∀ (Y : Scheme.{u}) (m : ℕ) (g : Y ⟶ wcPm.{u} m) (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)), wcGsCoords m e → ∀ (O : Y.Opens) (A : Type u) [CommRing A] (ψ : A →+* Γ(Y, O)), (∀ k, IsAffineOpen (O ⊓ g ⁻¹ᵁ wcPmChart m k)) → ∀ (w : ℕ) (p : ℕ) (a : Fin (p + 1) ↪o Fin (m + 1)) (x : Fin 1 → (Fin (m + 1) → ℤ) →₀ A), x ∈ wcLaurC A (m + 1) 1 (fun _ => 0) (w : ℤ) (Finset.univ.map a.toEmbedding) → wcLaurEval (m + 1) ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ O)).op).hom.comp ψ) (fun i => (Y.presheaf.map (homOfLE ((inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (a j)) 0)) : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ g ⁻¹ᵁ wcPmChart m (a 0))).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) i))) (x 0) = 0 → x ∈ wcLaurK A (m + 1) 1 (fun _ => 0) (wcChartJ A (m + 1) (fun k => Γ(Y, O ⊓ g ⁻¹ᵁ wcPmChart m k)) (fun k => (Y.presheaf.map (homOfLE (inf_le_left : O ⊓ g ⁻¹ᵁ wcPmChart m k ≤ O)).op).hom.comp ψ) (fun k l => (Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l)))) (w : ℤ) (Finset.univ.map a.toEmbedding) :=
by
  intro Y m g e he O A _ ψ hAff w p a x hx hE

  simp only [wcLaurC, Set.mem_setOf_eq, Nat.cast_zero, sub_zero] at hx
  obtain ⟨κ, h, hR1, hR2⟩ :=
    wc_gc_laur_repr A (m + 1) 1 (fun _ => (w : ℤ)) (Finset.univ.map a.toEmbedding) x hx
  have hR2' : ∀ μ ∈ (h 0).support, (∑ i, (μ i : ℤ)) =
      (w : ℤ) + (κ : ℤ) * ((Finset.univ.map a.toEmbedding).card : ℤ) := fun μ hμ => hR2 0 μ hμ

  rw [hR1 0] at hE
  obtain ⟨N, hN⟩ := wcpa_dj_cgs_lm_ksat_face_to_chart Y m g e he O A ψ hAff p a κ (h 0) hE

  have hhom : (h 0).IsHomogeneous
      ((w : ℤ) + (κ : ℤ) * ((Finset.univ.map a.toEmbedding).card : ℤ)).toNat :=
    (wc_cn_klm_shift_algebra A (m + 1) (Finset.univ.map a.toEmbedding) 0 0 (h 0)).2.2.2 _ hR2'
  have hXhom : ∀ L : ℕ, (∏ i ∈ Finset.univ.map a.toEmbedding,
      (MvPolynomial.X i : MvPolynomial (Fin (m + 1)) A) ^ L).IsHomogeneous
      (∑ i ∈ Finset.univ.map a.toEmbedding, L) := fun L =>
    MvPolynomial.IsHomogeneous.prod _ _ _ (fun i _ => MvPolynomial.isHomogeneous_X_pow i L)

  have ha0 : a 0 ∈ Finset.univ.map a.toEmbedding :=
    Finset.mem_map_of_mem a.toEmbedding (Finset.mem_univ 0)
  obtain ⟨M, hM⟩ := wcpa_dj_cgs_lm_ksat_chart_saturate Y m g e he O A ψ hAff (a 0)
    (Finset.univ.map a.toEmbedding) _ _ ha0 ((hXhom N).mul hhom) hN

  have hprod : (∏ i ∈ Finset.univ.map a.toEmbedding,
      (MvPolynomial.X i : MvPolynomial (Fin (m + 1)) A) ^ (N + M)) * h 0 =
      (∏ i ∈ Finset.univ.map a.toEmbedding,
        (MvPolynomial.X i : MvPolynomial (Fin (m + 1)) A) ^ M) *
      ((∏ i ∈ Finset.univ.map a.toEmbedding,
        (MvPolynomial.X i : MvPolynomial (Fin (m + 1)) A) ^ N) * h 0) := by
    rw [← mul_assoc, ← Finset.prod_mul_distrib]
    congr 1
    refine Finset.prod_congr rfl (fun i _ => ?_)
    ring

  unfold wcLaurK
  apply Submodule.subset_span
  rw [Set.mem_setOf_eq]
  refine ⟨κ + (N + M), fun _ => (∏ i ∈ Finset.univ.map a.toEmbedding,
      (MvPolynomial.X i : MvPolynomial (Fin (m + 1)) A) ^ (N + M)) * h 0, ?_, ?_, ?_⟩
  · unfold wcChartJ
    apply Submodule.subset_span
    rw [Set.mem_setOf_eq]
    refine ⟨_, (hXhom (N + M)).mul hhom, fun j => ?_⟩
    dsimp only
    rw [hprod]
    exact hM j
  · intro r μ hμ
    have hdeg := (wc_cn_klm_shift_algebra A (m + 1) (Finset.univ.map a.toEmbedding) κ (N + M)
      (h 0)).2.1 _ hR2' μ hμ
    simp only [Nat.cast_zero, sub_zero]
    push_cast at hdeg ⊢
    linear_combination hdeg
  · funext r
    obtain rfl := Fin.fin_one_eq_zero r
    rw [hR1 0]
    exact ((wc_cn_klm_shift_algebra A (m + 1) (Finset.univ.map a.toEmbedding) κ (N + M)
      (h 0)).1).symm

theorem wcpa_dj_cgs_lm_local_ker_van : ∀ (Y : Scheme.{u}) (m : ℕ) (g : Y ⟶ wcPm.{u} m) (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)), wcGsCoords m e → ∀ (O : Y.Opens) (A : Type u) [CommRing A] (ψ : A →+* Γ(Y, O)) (w : ℕ) (p : ℕ) (a : Fin (p + 1) ↪o Fin (m + 1)) (x : Fin 1 → (Fin (m + 1) → ℤ) →₀ A), x ∈ wcLaurK A (m + 1) 1 (fun _ => 0) (wcChartJ A (m + 1) (fun k => Γ(Y, O ⊓ g ⁻¹ᵁ wcPmChart m k)) (fun k => (Y.presheaf.map (homOfLE (inf_le_left : O ⊓ g ⁻¹ᵁ wcPmChart m k ≤ O)).op).hom.comp ψ) (fun k l => (Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l)))) (w : ℤ) (Finset.univ.map a.toEmbedding) → wcLaurEval (m + 1) ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ O)).op).hom.comp ψ) (fun i => (Y.presheaf.map (homOfLE ((inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (a j)) 0)) : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ g ⁻¹ᵁ wcPmChart m (a 0))).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) i))) (x 0) = 0 :=
by
  intro Y m g e he O A _ ψ w p a x hx
  classical

  have hres : ∀ {U V W : Y.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (h3 : W ≤ U) (x : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
        (Y.presheaf.map (homOfLE h3).op).hom x := by
    intro U V W h1 h2 h3 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  have hunit : ∀ (k i : Fin (m + 1)) (W : Y.Opens) (hk : W ≤ g ⁻¹ᵁ wcPmChart m k),
      W ≤ g ⁻¹ᵁ wcPmChart m i →
      IsUnit ((Y.presheaf.map (homOfLE hk).op).hom (g.app (wcPmChart m k) (e k i))) := by
    intro k i W hk hi
    have hbo : Y.basicOpen (g.app (wcPmChart m k) (e k i)) =
        g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m i := by
      rw [← Scheme.preimage_basicOpen, ← he.2.1 k i, Scheme.Hom.preimage_inf]
    have hWb : W ≤ Y.basicOpen (g.app (wcPmChart m k) (e k i)) := hbo ▸ le_inf hk hi
    have h1 : IsUnit ((Y.presheaf.map (homOfLE (Y.basicOpen_le
        (g.app (wcPmChart m k) (e k i)))).op).hom (g.app (wcPmChart m k) (e k i))) :=
      RingedSpace.isUnit_res_basicOpen Y.toRingedSpace (g.app (wcPmChart m k) (e k i))
    have h2 := h1.map (Y.presheaf.map (homOfLE hWb).op).hom
    rwa [hres] at h2

  have hK : ∀ f ∈ wcChartJ A (m + 1) (fun k => Γ(Y, O ⊓ g ⁻¹ᵁ wcPmChart m k))
      (fun k => (Y.presheaf.map (homOfLE (inf_le_left : O ⊓ g ⁻¹ᵁ wcPmChart m k ≤ O)).op).hom.comp ψ)
      (fun k l => (Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m k ≤
        g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l))), ∀ j,
      MvPolynomial.eval₂
        ((Y.presheaf.map (homOfLE (inf_le_left : O ⊓ g ⁻¹ᵁ wcPmChart m j ≤ O)).op).hom.comp ψ)
        (fun l => (Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m j ≤
          g ⁻¹ᵁ wcPmChart m j)).op).hom (g.app (wcPmChart m j) (e j l))) (f 0) = 0 := by
    intro f hf j
    unfold wcChartJ at hf
    induction hf using Submodule.span_induction with
    | mem f hf =>
      obtain ⟨_, _, h⟩ := hf
      exact h j
    | zero => rw [Pi.zero_apply, MvPolynomial.eval₂_zero]
    | add f f' _ _ hf hf' => rw [Pi.add_apply, MvPolynomial.eval₂_add, hf, hf', add_zero]
    | smul c f _ hf => rw [Pi.smul_apply, smul_eq_mul, MvPolynomial.eval₂_mul, hf, mul_zero]

  have hEadd : ∀ {T : Type u} [CommRing T] (α : A →+* T) (u : Fin (m + 1) → T)
      (x y : (Fin (m + 1) → ℤ) →₀ A),
      wcLaurEval (m + 1) α u (x + y) = wcLaurEval (m + 1) α u x + wcLaurEval (m + 1) α u y := by
    intro T _ α u x y
    unfold wcLaurEval
    apply Finsupp.sum_add_index'
    · intro β; simp
    · intro β c c'; rw [map_add, add_mul]
  have hEsmul : ∀ {T : Type u} [CommRing T] (α : A →+* T) (u : Fin (m + 1) → T) (c : A)
      (x : (Fin (m + 1) → ℤ) →₀ A),
      wcLaurEval (m + 1) α u (c • x) = α c * wcLaurEval (m + 1) α u x := by
    intro T _ α u c x
    unfold wcLaurEval
    rw [Finsupp.sum_smul_index']
    · rw [Finsupp.mul_sum]
      apply Finsupp.sum_congr
      intro β _
      rw [smul_eq_mul, map_mul, mul_assoc]
    · intro β; simp
  have hEzero : ∀ {T : Type u} [CommRing T] (α : A →+* T) (u : Fin (m + 1) → T),
      wcLaurEval (m + 1) α u 0 = 0 := by
    intro T _ α u
    unfold wcLaurEval
    exact Finsupp.sum_zero_index

  have hshift : ∀ {T : Type u} [CommRing T] (α : A →+* T) (u : Fin (m + 1) → T)
      (s : Finset (Fin (m + 1))), (∀ i ∈ s, IsUnit (u i)) →
      ∀ (κ : ℕ) (h : MvPolynomial (Fin (m + 1)) A),
      wcLaurEval (m + 1) α u (∑ μ ∈ h.support, Finsupp.single
        (fun i => (μ i : ℤ) - if i ∈ s then (κ : ℤ) else 0) (h.coeff μ)) =
      (∏ i ∈ s, Ring.inverse (u i)) ^ κ * MvPolynomial.eval₂ α u h := by
    intro T _ α u s hs κ h
    have hfac : ∀ (μ : Fin (m + 1) →₀ ℕ) (i : Fin (m + 1)),
        u i ^ ((μ i : ℤ) - if i ∈ s then (κ : ℤ) else 0).toNat *
          Ring.inverse (u i) ^ (-((μ i : ℤ) - if i ∈ s then (κ : ℤ) else 0)).toNat =
        (if i ∈ s then Ring.inverse (u i) ^ κ else 1) * u i ^ μ i := by
      intro μ i
      by_cases hi : i ∈ s
      · obtain ⟨υ, hυ⟩ := hs i hi
        simp only [hi, if_true]
        rw [← hυ, Ring.inverse_unit]
        have key : ∀ z : ℤ, (υ ^ z.toNat * υ⁻¹ ^ (-z).toNat : Tˣ) = υ ^ z := by
          intro z
          rw [inv_pow, ← zpow_natCast, ← zpow_natCast, ← zpow_neg, ← zpow_add,
            ← sub_eq_add_neg, Int.toNat_sub_toNat_neg]
        have key2 : (υ⁻¹ ^ κ * υ ^ (μ i) : Tˣ) = υ ^ ((μ i : ℤ) - κ) := by
          rw [zpow_sub, zpow_natCast, zpow_natCast, inv_pow, mul_comm]
        have := congrArg Units.val ((key ((μ i : ℤ) - κ)).trans key2.symm)
        simp only [Units.val_mul, Units.val_pow_eq_pow_val] at this
        exact this
      · simp only [hi, if_false, sub_zero, Int.toNat_natCast, one_mul]
        have h0 : (-(μ i : ℤ)).toNat = 0 := Int.toNat_eq_zero.mpr (by omega)
        rw [h0, pow_zero, mul_one]
    unfold wcLaurEval
    rw [← Finsupp.sum_finsetSum_index (fun β => by simp)
      (fun β c c' => by rw [map_add, add_mul])]
    rw [MvPolynomial.eval₂_eq', Finset.mul_sum]
    refine Finset.sum_congr rfl (fun μ _ => ?_)
    rw [Finsupp.sum_single_index (by rw [map_zero, zero_mul])]
    have hp : (∏ k, u k ^ ((μ k : ℤ) - if k ∈ s then (κ : ℤ) else 0).toNat *
          Ring.inverse (u k) ^ (-((μ k : ℤ) - if k ∈ s then (κ : ℤ) else 0)).toNat) =
        ∏ k, ((if k ∈ s then Ring.inverse (u k) ^ κ else 1) * u k ^ μ k) :=
      Finset.prod_congr rfl (fun i _ => hfac μ i)
    rw [hp, Finset.prod_mul_distrib, Finset.prod_ite_mem, Finset.univ_inter, Finset.prod_pow]
    ring

  have hUle : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ O ⊓ g ⁻¹ᵁ wcPmChart m (a 0) :=
    le_inf inf_le_right (inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (a j)) 0))
  have hev : ∀ P : MvPolynomial (Fin (m + 1)) A,
      MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ O)).op).hom.comp ψ) (fun i => (Y.presheaf.map (homOfLE ((inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (a j)) 0)) : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ g ⁻¹ᵁ wcPmChart m (a 0))).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) i))) P =
      (Y.presheaf.map (homOfLE hUle).op).hom (MvPolynomial.eval₂
        ((Y.presheaf.map (homOfLE (inf_le_left : O ⊓ g ⁻¹ᵁ wcPmChart m (a 0) ≤ O)).op).hom.comp ψ)
        (fun l => (Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m (a 0) ≤
          g ⁻¹ᵁ wcPmChart m (a 0))).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) l))) P) := by
    intro P
    rw [MvPolynomial.eval₂_comp_left]
    congr 1
    · ext c
      simp only [RingHom.comp_apply]
      exact (hres _ _ _ _).symm
    · funext i
      simp only [Function.comp_apply]
      exact (hres _ _ _ _).symm
  have hunits : ∀ i ∈ Finset.univ.map a.toEmbedding, IsUnit ((Y.presheaf.map (homOfLE ((inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (a j)) 0)) : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ g ⁻¹ᵁ wcPmChart m (a 0))).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) i))) := by
    intro i hi
    obtain ⟨j, -, rfl⟩ := Finset.mem_map.mp hi
    exact hunit (a 0) (a.toEmbedding j) _ _
      (inf_le_left.trans (iInf_le (fun j' => g ⁻¹ᵁ wcPmChart m (a j')) j))

  unfold wcLaurK at hx
  induction hx using Submodule.span_induction with
  | mem v hv =>
    obtain ⟨k, f, hf, -, rfl⟩ := hv
    refine (hshift _ _ _ hunits k (f 0)).trans ?_
    rw [hev, hK f hf (a 0)]
    simp only [map_zero, mul_zero]
  | zero => rw [Pi.zero_apply, hEzero]
  | add y y' _ _ hy hy' => rw [Pi.add_apply, hEadd, hy, hy', add_zero]
  | smul c y _ hy => rw [Pi.smul_apply, hEsmul, hy, mul_zero]

theorem wcpa_dj_cgs_lm_eval_alg : ∀ {A T T' : Type u} [CommRing A] [CommRing T] [CommRing T'] (n : ℕ) (α : A →+* T) (u : Fin n → T), (∀ x y : (Fin n → ℤ) →₀ A, wcLaurEval n α u (x + y) = wcLaurEval n α u x + wcLaurEval n α u y) ∧ (∀ (c : A) (x : (Fin n → ℤ) →₀ A), wcLaurEval n α u (c • x) = α c * wcLaurEval n α u x) ∧ (∀ (φ : T →+* T') (s : Finset (Fin n)) (x : (Fin n → ℤ) →₀ A), (∀ i ∈ s, IsUnit (u i)) → (∀ β ∈ x.support, ∀ i, i ∉ s → 0 ≤ β i) → φ (wcLaurEval n α u x) = wcLaurEval n (φ.comp α) (fun i => φ (u i)) x) ∧ (∀ (lam : T) (w : ℕ) (x : (Fin n → ℤ) →₀ A), IsUnit lam → (∀ β ∈ x.support, ∑ i, β i = (w : ℤ)) → wcLaurEval n α (fun i => lam * u i) x = lam ^ w * wcLaurEval n α u x) ∧ (∀ (lam : T) (D : ℕ) (P : MvPolynomial (Fin n) A), P.IsHomogeneous D → MvPolynomial.eval₂ α (fun i => lam * u i) P = lam ^ D * MvPolynomial.eval₂ α u P) :=
by
  intro A T T' _ _ _ n α u
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro x y
    unfold wcLaurEval
    exact Finsupp.sum_add_index' (fun _ => by simp) (fun _ _ _ => by rw [map_add, add_mul])
  · intro c x
    unfold wcLaurEval
    rw [Finsupp.sum_smul_index' (fun _ => by simp), Finsupp.mul_sum]
    exact Finsupp.sum_congr (fun β _ => by rw [smul_eq_mul, map_mul, mul_assoc])
  · intro φ s x hs hx
    unfold wcLaurEval
    rw [map_finsuppSum]
    refine Finsupp.sum_congr (fun β hβ => ?_)
    rw [map_mul, map_prod, RingHom.comp_apply]
    congr 1
    refine Finset.prod_congr rfl (fun k _ => ?_)
    rw [map_mul, map_pow, map_pow]
    congr 1
    by_cases hk : k ∈ s
    · have hu := hs k hk
      have hφu : IsUnit (φ (u k)) := hu.map φ
      have hinv : φ (Ring.inverse (u k)) = Ring.inverse (φ (u k)) := by
        apply hφu.mul_left_inj.mp
        rw [← map_mul, Ring.inverse_mul_cancel _ hu, Ring.inverse_mul_cancel _ hφu, map_one]
      rw [hinv]
    · have h0 : (-β k).toNat = 0 := Int.toNat_eq_zero.mpr (by have := hx β hβ k hk; omega)
      rw [h0, pow_zero, pow_zero]
  · intro lam w x hlam hx
    unfold wcLaurEval
    rw [Finsupp.mul_sum]
    refine Finsupp.sum_congr (fun β hβ => ?_)
    have hsum := hx β hβ
    rw [mul_left_comm]
    congr 1
    have hfac : ∀ k, (lam * u k) ^ (β k).toNat * Ring.inverse (lam * u k) ^ (-β k).toNat
        = (lam ^ (β k).toNat * Ring.inverse lam ^ (-β k).toNat) *
          (u k ^ (β k).toNat * Ring.inverse (u k) ^ (-β k).toNat) := by
      intro k
      rw [Ring.mul_inverse_rev]
      simp only [mul_pow]
      ring
    rw [Finset.prod_congr rfl (fun k _ => hfac k), Finset.prod_mul_distrib, Finset.prod_mul_distrib,
      Finset.prod_pow_eq_pow_sum, Finset.prod_pow_eq_pow_sum]
    have hP : (∑ k, (β k).toNat) = w + ∑ k, (-β k).toNat := by
      have h1 : ∀ k, ((β k).toNat : ℤ) = β k + ((-β k).toNat : ℤ) := fun k => by omega
      have h2 : ((∑ k, (β k).toNat : ℕ) : ℤ) = ((w + ∑ k, (-β k).toNat : ℕ) : ℤ) := by
        push_cast
        rw [Finset.sum_congr rfl (fun k _ => h1 k), Finset.sum_add_distrib, hsum]
      exact_mod_cast h2
    have hc : lam ^ (∑ k, (-β k).toNat) * Ring.inverse lam ^ (∑ k, (-β k).toNat) = 1 := by
      rw [← mul_pow, Ring.mul_inverse_cancel _ hlam, one_pow]
    rw [hP, pow_add]
    linear_combination (lam ^ w * ∏ k, (u k ^ (β k).toNat * Ring.inverse (u k) ^ (-β k).toNat)) * hc
  · intro lam D P hP
    rw [MvPolynomial.eval₂_eq', MvPolynomial.eval₂_eq', Finset.mul_sum]
    refine Finset.sum_congr rfl (fun d hd => ?_)
    have hdeg : ∑ i, d i = D := by
      by_contra hne
      have h0 := hP.coeff_eq_zero (show Finsupp.degree d ≠ D by rw [Finsupp.degree_eq_sum]; exact hne)
      exact (MvPolynomial.mem_support_iff.mp hd) h0
    simp only [mul_pow]
    rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
    ring

theorem wcpa_dj_cgs_lm_face_identity : ∀ (Y : Scheme.{u}) (m : ℕ) (g : Y ⟶ wcPm.{u} m) (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)), wcGsCoords m e → ∀ (O : Y.Opens) (A : Type u) [CommRing A] (ψ : A →+* Γ(Y, O)) (w : ℕ) (L : Y.Modules) (φ : ∀ (k : Fin (m + 1)) (O' : Y.Opens), O' ≤ g ⁻¹ᵁ wcPmChart m k → (Γ(L, O') →+ Γ(wcStructMod Y, O'))), wcGsTw g e w L φ → ∀ (p : ℕ) (a : Fin (p + 2) ↪o Fin (m + 1)) (k : Fin (p + 2)) (x : Fin 1 → (Fin (m + 1) → ℤ) →₀ A), x ∈ wcLaurC A (m + 1) 1 (fun _ => 0) (w : ℤ) (Finset.univ.map ((Fin.succAboveOrderEmb k).trans a).toEmbedding) → ∀ yv : Γ(L, wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O ((Fin.succAboveOrderEmb k).trans a)), φ (((Fin.succAboveOrderEmb k).trans a) 0) _ (inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (((Fin.succAboveOrderEmb k).trans a) j)) 0)) yv = wcLaurEval (m + 1) ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O ((Fin.succAboveOrderEmb k).trans a) ≤ O)).op).hom.comp ψ) (fun i => (Y.presheaf.map (homOfLE ((inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (((Fin.succAboveOrderEmb k).trans a) j)) 0)) : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O ((Fin.succAboveOrderEmb k).trans a) ≤ g ⁻¹ᵁ wcPmChart m (((Fin.succAboveOrderEmb k).trans a) 0))).op).hom (g.app (wcPmChart m (((Fin.succAboveOrderEmb k).trans a) 0)) (e (((Fin.succAboveOrderEmb k).trans a) 0) i))) (x 0) → φ (a 0) _ (inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (a j)) 0)) ((L.presheaf.map (homOfLE (show wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O ((Fin.succAboveOrderEmb k).trans a) from inf_le_inf_right O (le_iInf fun i => iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (a j)) _))).op).hom yv) = wcLaurEval (m + 1) ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ O)).op).hom.comp ψ) (fun i => (Y.presheaf.map (homOfLE ((inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (a j)) 0)) : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ g ⁻¹ᵁ wcPmChart m (a 0))).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) i))) (x 0) :=
by
  intro Y m g e he O A _ ψ w L φ hTw p a k x hx yv hH
  obtain ⟨-, -, hres, htw⟩ := hTw
  obtain ⟨-, hcoc, -, hunit, -⟩ := wcpa_dj_cgs_lm_chart_facts Y m g e he
  have resZ : ∀ {U V W : Y.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (z : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom z) =
      (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom z := by
    intro U V W h1 h2 z
    change (Y.presheaf.map (homOfLE h1).op ≫ Y.presheaf.map (homOfLE h2).op).hom z = _
    rw [← Functor.map_comp]
    rfl
  have key : ∀ {p q : ℕ} (a : Fin (p + 1) ↪o Fin (m + 1)) (b : Fin (q + 1) ↪o Fin (m + 1))
      (ι : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O b)
      (x0 : (Fin (m + 1) → ℤ) →₀ A),
      (∀ β ∈ x0.support, ∑ i, β i = (w : ℤ) ∧
        ∀ i, i ∉ Finset.univ.map b.toEmbedding → 0 ≤ β i) →
      ∀ yv : Γ(L, wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O b),
      φ (b 0) _ (inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (b j)) 0)) yv =
        wcLaurEval (m + 1) ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O b ≤ O)).op).hom.comp ψ) (fun i => (Y.presheaf.map (homOfLE ((inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (b j)) 0)) : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O b ≤ g ⁻¹ᵁ wcPmChart m (b 0))).op).hom (g.app (wcPmChart m (b 0)) (e (b 0) i))) x0 →
      φ (a 0) _ (inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (a j)) 0))
          ((L.presheaf.map (homOfLE ι).op).hom yv) =
        wcLaurEval (m + 1) ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ O)).op).hom.comp ψ) (fun i => (Y.presheaf.map (homOfLE ((inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (a j)) 0)) : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ g ⁻¹ᵁ wcPmChart m (a 0))).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) i))) x0 := by
    intro p q a b ι x0 hx0 yv hH
    have ha : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ g ⁻¹ᵁ wcPmChart m (a 0) :=
      inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (a j)) 0)
    have hb : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O b ≤ g ⁻¹ᵁ wcPmChart m (b 0) :=
      inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (b j)) 0)
    have hb' : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ g ⁻¹ᵁ wcPmChart m (b 0) := ι.trans hb

    rw [htw (a 0) (b 0) _ ha hb', hres (b 0) _ _ hb ι yv, hH]

    have hunits : ∀ i ∈ Finset.univ.map b.toEmbedding,
        IsUnit ((Y.presheaf.map (homOfLE hb).op).hom (g.app (wcPmChart m (b 0)) (e (b 0) i))) := by
      intro i hi
      obtain ⟨j, -, rfl⟩ := Finset.mem_map.mp hi
      exact hunit (b 0) (b.toEmbedding j) _ hb
        (inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (b j)) j))
    obtain ⟨-, -, hnat, -, -⟩ := wcpa_dj_cgs_lm_eval_alg (T' := Γ(Y, wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a)) (m + 1)
      ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O b ≤ O)).op).hom.comp ψ)
      (fun i => (Y.presheaf.map (homOfLE hb).op).hom (g.app (wcPmChart m (b 0)) (e (b 0) i)))
    have h3 := hnat (Y.presheaf.map (homOfLE ι).op).hom (Finset.univ.map b.toEmbedding) x0 hunits
      (fun β hβ i hi => (hx0 β hβ).2 i hi)
    have hα : (Y.presheaf.map (homOfLE ι).op).hom.comp
        ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O b ≤ O)).op).hom.comp ψ) =
        (Y.presheaf.map (homOfLE (inf_le_right : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ O)).op).hom.comp ψ :=
      RingHom.ext fun c => by simp only [RingHom.comp_apply]; exact resZ _ _ _
    have hu : (fun i => (Y.presheaf.map (homOfLE ι).op).hom
        ((Y.presheaf.map (homOfLE hb).op).hom (g.app (wcPmChart m (b 0)) (e (b 0) i)))) =
        fun i => (Y.presheaf.map (homOfLE hb').op).hom (g.app (wcPmChart m (b 0)) (e (b 0) i)) :=
      funext fun i => resZ _ _ _
    rw [hα, hu] at h3

    have hua : (fun i => (Y.presheaf.map (homOfLE ha).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) i))) =
        fun i => (Y.presheaf.map (homOfLE ha).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) (b 0))) *
          (Y.presheaf.map (homOfLE hb').op).hom (g.app (wcPmChart m (b 0)) (e (b 0) i)) :=
      funext fun i => hcoc (a 0) (b 0) i _ ha hb'
    have hlam : IsUnit ((Y.presheaf.map (homOfLE ha).op).hom
        (g.app (wcPmChart m (a 0)) (e (a 0) (b 0)))) := hunit (a 0) (b 0) _ ha hb'
    obtain ⟨-, -, -, hscale, -⟩ := wcpa_dj_cgs_lm_eval_alg (T' := Γ(Y, wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a)) (m + 1)
      ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ O)).op).hom.comp ψ)
      (fun i => (Y.presheaf.map (homOfLE hb').op).hom (g.app (wcPmChart m (b 0)) (e (b 0) i)))
    have h4 := (congrArg (fun u => wcLaurEval (m + 1)
      ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤ O)).op).hom.comp ψ)
      u x0) hua).trans (hscale _ w x0 hlam (fun β hβ => (hx0 β hβ).1))

    exact (congrArg (fun t => (Y.presheaf.map (homOfLE ha).op).hom
      (g.app (wcPmChart m (a 0)) (e (a 0) (b 0))) ^ w * t) h3).trans h4.symm
  have hx0 : ∀ β ∈ (x 0).support, ∑ i, β i = (w : ℤ) ∧
      ∀ i, i ∉ Finset.univ.map ((Fin.succAboveOrderEmb k).trans a).toEmbedding → 0 ≤ β i := by
    intro β hβ
    obtain ⟨h1, h2⟩ := (Finsupp.mem_supported _ _).mp (hx 0) (Finset.mem_coe.mpr hβ)
    refine ⟨?_, h2⟩
    simpa using h1
  exact key a ((Fin.succAboveOrderEmb k).trans a) _ (x 0) hx0 yv hH

theorem wcpa_dj_cgs_laurent_model : ∀ (Y : Scheme.{u}) (m : ℕ) (g : Y ⟶ wcPm.{u} m) (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)), wcGsCoords m e → ∀ (O : Y.Opens) (A : Type u) [CommRing A] (ψ : A →+* Γ(Y, O)), (∀ k, IsAffineOpen (O ⊓ g ⁻¹ᵁ wcPmChart m k)) → (∀ k (s : Γ(Y, O ⊓ g ⁻¹ᵁ wcPmChart m k)), ∃ P : MvPolynomial (Fin (m + 1)) A, MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (inf_le_left : O ⊓ g ⁻¹ᵁ wcPmChart m k ≤ O)).op).hom.comp ψ) (fun l => (Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l))) P = s) → ∃ K : Submodule (MvPolynomial (Fin (m + 1)) A) (Fin 1 → MvPolynomial (Fin (m + 1)) A), (∀ f ∈ K, ∀ t : ℕ, (fun r => if (fun _ : Fin 1 => (0 : ℕ)) r ≤ t then MvPolynomial.homogeneousComponent (t - (fun _ : Fin 1 => (0 : ℕ)) r) (f r) else 0) ∈ K) ∧ ∀ (w : ℕ) (L : Y.Modules) (φ : ∀ (k : Fin (m + 1)) (O' : Y.Opens), O' ≤ g ⁻¹ᵁ wcPmChart m k → (Γ(L, O') →+ Γ(wcStructMod Y, O'))), wcGsTw g e w L φ → ∃ Θ, wcGsLaurModel L (fun k => g ⁻¹ᵁ wcPmChart m k) O A ψ K (w : ℤ) Θ :=
by
  intro Y m g e he O A _ ψ hAff hGen
  classical

  refine ⟨wcChartJ A (m + 1) (fun k => Γ(Y, O ⊓ g ⁻¹ᵁ wcPmChart m k))
    (fun k => (Y.presheaf.map (homOfLE (inf_le_left : O ⊓ g ⁻¹ᵁ wcPmChart m k ≤ O)).op).hom.comp ψ)
    (fun k l => (Y.presheaf.map (homOfLE (inf_le_right : O ⊓ g ⁻¹ᵁ wcPmChart m k ≤
      g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l))),
    (wcpa_dj_cgs_lm_chartJ_graded A (m + 1) _ _ _).1, ?_⟩
  intro w L φ hTw

  have hEadd : ∀ {T : Type u} [CommRing T] (α : A →+* T) (u : Fin (m + 1) → T)
      (x y : (Fin (m + 1) → ℤ) →₀ A),
      wcLaurEval (m + 1) α u (x + y) = wcLaurEval (m + 1) α u x + wcLaurEval (m + 1) α u y := by
    intro T _ α u x y
    unfold wcLaurEval
    apply Finsupp.sum_add_index'
    · intro β; simp
    · intro β c c'; rw [map_add, add_mul]
  have hEsmul : ∀ {T : Type u} [CommRing T] (α : A →+* T) (u : Fin (m + 1) → T) (c : A)
      (x : (Fin (m + 1) → ℤ) →₀ A),
      wcLaurEval (m + 1) α u (c • x) = α c * wcLaurEval (m + 1) α u x := by
    intro T _ α u c x
    unfold wcLaurEval
    rw [Finsupp.sum_smul_index']
    · rw [Finsupp.mul_sum]
      apply Finsupp.sum_congr
      intro β _
      rw [smul_eq_mul, map_mul, mul_assoc]
    · intro β; simp

  have hc8 : ∀ {p : ℕ} (a : Fin (p + 1 + 1) ↪o Fin (m + 1)) (k : Fin (p + 1 + 1)),
      ((Finset.univ.map a.toEmbedding).filter (· < a.toEmbedding k)).card = (k : ℕ) ∧
      (Finset.univ.map a.toEmbedding).erase (a.toEmbedding k) =
        Finset.univ.map ((Fin.succAboveOrderEmb k).trans a).toEmbedding := by
    intro p a k
    constructor
    · have h1 : (Finset.univ.map a.toEmbedding).filter (· < a.toEmbedding k) =
          (Finset.Iio k).map a.toEmbedding := by
        ext x
        simp only [Finset.mem_filter, Finset.mem_map, Finset.mem_univ, true_and, Finset.mem_Iio]
        constructor
        · rintro ⟨⟨j, rfl⟩, hj⟩; exact ⟨j, by simpa using hj, rfl⟩
        · rintro ⟨j, hj, rfl⟩; exact ⟨⟨j, rfl⟩, by simpa using hj⟩
      rw [h1, Finset.card_map, Fin.card_Iio]
    · ext x
      simp only [Finset.mem_erase, Finset.mem_map, Finset.mem_univ, true_and]
      constructor
      · rintro ⟨hx, j, rfl⟩
        have hjk : j ≠ k := fun h => hx (by rw [h])
        obtain ⟨z, hz⟩ := Fin.exists_succAbove_eq hjk
        exact ⟨z, by simp [hz]⟩
      · rintro ⟨z, rfl⟩
        refine ⟨?_, k.succAbove z, by simp⟩
        intro h
        simp at h
  have hcard : ∀ q (a : Fin (q + 1) ↪o Fin (m + 1)),
      (Finset.univ.map a.toEmbedding).card = q + 1 := by
    intro q a; simp
  have hrange : ∀ q (s : Finset (Fin (m + 1))) (h : s.card = q + 1),
      Finset.univ.map (s.orderEmbOfFin h).toEmbedding = s := by
    intro q s h
    simp [Finset.map_eq_image]
  have horder : ∀ q (a : Fin (q + 1) ↪o Fin (m + 1))
      (h : (Finset.univ.map a.toEmbedding).card = q + 1),
      (Finset.univ.map a.toEmbedding).orderEmbOfFin h = a := by
    intro q a h
    symm
    exact Finset.orderEmbOfFin_unique' h (fun x => by simp)

  have hbridge : ∀ (U : Y.Opens) {ι : Type} (s : Finset ι) (f : ι → Γ(Y, U)) (n : ι → ℤ),
      ((∑ k ∈ s, ((n k : Γ(Y, U)) * f k) : Γ(Y, U)) : Γ(wcStructMod Y, U)) =
        ∑ k ∈ s, n k • (f k : Γ(wcStructMod Y, U)) := by
    intro U ι s f n
    induction s using Finset.induction_on with
    | empty => rfl
    | insert b s hb ih =>
      rw [Finset.sum_insert hb, Finset.sum_insert hb, ← ih, ← Int.cast_smul_eq_zsmul Γ(Y, U)]
      rfl

  let E : ∀ {p : ℕ} (a : Fin (p + 1) ↪o Fin (m + 1)), ((Fin (m + 1) → ℤ) →₀ A) →
      Γ(Y, wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a) := fun a x =>
    wcLaurEval (m + 1) ((Y.presheaf.map (homOfLE (inf_le_right : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k)
      O a ≤ O)).op).hom.comp ψ) (fun i => (Y.presheaf.map (homOfLE ((inf_le_left.trans (iInf_le
      (fun j => g ⁻¹ᵁ wcPmChart m (a j)) 0)) : wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a ≤
      g ⁻¹ᵁ wcPmChart m (a 0))).op).hom (g.app (wcPmChart m (a 0)) (e (a 0) i))) x
  let Φ : ∀ {p : ℕ} (a : Fin (p + 1) ↪o Fin (m + 1)),
      Γ(L, wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a) ≃+
        Γ(wcStructMod Y, wcAcV (fun k => g ⁻¹ᵁ wcPmChart m k) O a) := fun a =>
    AddEquiv.ofBijective (φ (a 0) _ (inf_le_left.trans (iInf_le (fun j => g ⁻¹ᵁ wcPmChart m (a j)) 0)))
