    haveI : IsLocalHom φ.hom := ⟨fun a ha => by
      by_contra hna
      have := hker a hna
      rw [this] at ha
      exact not_isUnit_zero ha⟩
    set ψ := IsLocalRing.ResidueField.lift φ.hom with hψ
    have hψc : ψ.comp (IsLocalRing.residue R) = φ.hom := by
      ext a; exact IsLocalRing.ResidueField.lift_residue_apply φ.hom a
    have hψft : ψ.FiniteType := by
      rw [← hψc] at hft
