theorem wcpa_dj_lr1u_tcr_dominate_below : ∀ (K A : Type u) [Field K] [CommRing A] [IsLocalRing A] (φ : A →+* K) (V : ValuationSubring K), (∀ a : A, φ a ∈ V) → ∃ B : ValuationSubring K, (∀ x ∈ B, x ∈ V) ∧ wcLr1uDom φ (B : Set K) :=
by
  intro K A _ _ _ φ V hφV
  have hle : ∀ a : A, V.valuation (φ a) ≤ 1 := fun a => (V.valuation_le_one_iff _).mpr (hφV a)

  have hU : ∀ c : A, IsUnit c → V.valuation (φ c) = 1 := by
    intro c hc
    obtain ⟨d, hd⟩ := hc.exists_right_inv
    have h1 : V.valuation (φ c * φ d) = 1 := by rw [← map_mul, hd, map_one, map_one]
    rw [Valuation.map_mul] at h1
    refine le_antisymm (hle c) ?_
    by_contra hlt
    push_neg at hlt
    have h2 : V.valuation (φ c) * V.valuation (φ d) < 1 := mul_lt_one_of_lt_of_le hlt (hle d)
    rw [h1] at h2
    exact lt_irrefl _ h2

  obtain ⟨S, hS⟩ : ∃ S : Subring K, ∀ x : K, x ∈ S ↔ ∃ a : A, V.valuation (x - φ a) < 1 := by
    refine ⟨{ carrier := {x | ∃ a : A, V.valuation (x - φ a) < 1}
              mul_mem' := ?_
              one_mem' := ⟨1, by simp⟩
              add_mem' := ?_
              zero_mem' := ⟨0, by simp⟩
              neg_mem' := ?_ }, fun x => Iff.rfl⟩
    · rintro x y ⟨a, ha⟩ ⟨b, hb⟩
      refine ⟨a * b, ?_⟩
      have e : x * y - φ (a * b) = (x - φ a) * (y - φ b) + φ a * (y - φ b) + φ b * (x - φ a) := by
        rw [map_mul]; ring
      rw [e]
      refine Valuation.map_add_lt _ (Valuation.map_add_lt _ ?_ ?_) ?_
      · rw [Valuation.map_mul]; exact mul_lt_one_of_lt_of_le ha hb.le
      · rw [Valuation.map_mul, mul_comm]; exact mul_lt_one_of_lt_of_le hb (hle a)
      · rw [Valuation.map_mul, mul_comm]; exact mul_lt_one_of_lt_of_le ha (hle b)
    · rintro x y ⟨a, ha⟩ ⟨b, hb⟩
      refine ⟨a + b, ?_⟩
      have e : x + y - φ (a + b) = (x - φ a) + (y - φ b) := by rw [map_add]; ring
      rw [e]
      exact Valuation.map_add_lt _ ha hb
    · rintro x ⟨a, ha⟩
      refine ⟨-a, ?_⟩
      have e : -x - φ (-a) = -(x - φ a) := by rw [map_neg]; ring
      rw [e, Valuation.map_neg]
      exact ha
  have hM1 : ∀ a : A, φ a ∈ S := fun a => (hS _).2 ⟨a, by simp⟩
  have hM2 : ∀ x : K, V.valuation x < 1 → x ∈ S := fun x h => (hS _).2 ⟨0, by simpa using h⟩
  have hM3 : ∀ x : K, x ∈ S → x ∈ V := by
    intro x hx
    obtain ⟨a, ha⟩ := (hS x).1 hx
    have h := Valuation.map_add V.valuation (x - φ a) (φ a)
    rw [sub_add_cancel] at h
    exact (V.valuation_le_one_iff x).1 (h.trans (max_le ha.le (hle a)))

  have key : ∀ (x : K) (c : A), IsUnit c → V.valuation (x - φ c) < 1 →
      ∃ hx : x ∈ S, IsUnit (⟨x, hx⟩ : S) := by
    intro x c hc h
    have hxS : x ∈ S := (hS x).2 ⟨c, h⟩
    obtain ⟨d, hd⟩ := hc.exists_right_inv
    have hdU : IsUnit d := isUnit_iff_exists_inv.mpr ⟨c, by rw [mul_comm]; exact hd⟩
    have hcd : φ c * φ d = 1 := by rw [← map_mul, hd, map_one]
    have hvx : V.valuation x = 1 := by
      have h1 : V.valuation ((x - φ c) + φ c) = V.valuation (φ c) :=
