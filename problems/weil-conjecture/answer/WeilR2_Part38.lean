      (Scheme.IdealSheafData.range_subschemeι g.ker).trans (Scheme.Hom.support_ker g)
    have hcomp : g.imageι '' Set.range g.toImage = Set.range g := by
      ext p
      constructor
      · rintro ⟨_, ⟨y, rfl⟩, rfl⟩
        exact ⟨y, by rw [← Scheme.Hom.comp_apply, Scheme.Hom.toImage_imageι]⟩
      · rintro ⟨y, rfl⟩
        exact ⟨_, ⟨y, rfl⟩, by rw [← Scheme.Hom.comp_apply, Scheme.Hom.toImage_imageι]⟩
    have hdense : Dense (Set.range g.toImage) := by
      rw [dense_iff_closure_eq,
        g.imageι.isClosedEmbedding.isEmbedding.closure_eq_preimage_closure_image, hcomp,
        ← hrange']
      exact Set.preimage_range _
    have hjr : ∀ γ : g.image, (g.imageι ≫ Limits.pullback.fst uZ uZ') γ ∈ Set.range κ →
        γ ∈ Set.range g.toImage := by
      intro γ hγ
      rw [Scheme.Hom.comp_apply] at hγ
      have hmem : g.imageι γ ∈ closure (Set.range g) := hrange' ▸ ⟨γ, rfl⟩
      let N : (Limits.pullback uZ uZ').Opens := Limits.pullback.fst uZ uZ' ⁻¹ᵁ κ.opensRange
      have hgN' : Set.range g ⊆ (N : Set _) := by
        rintro _ ⟨y, rfl⟩
        show Limits.pullback.fst uZ uZ' (g y) ∈ (κ.opensRange : Set Z)
        rw [← Scheme.Hom.comp_apply, hg, Scheme.Hom.coe_opensRange]
        exact ⟨y, rfl⟩
      obtain ⟨gN, hgN⟩ : ∃ gN : wcProjK Ω 1 ⟶ N.toScheme, gN ≫ N.ι = g :=
        ⟨IsOpenImmersion.lift N.ι g (by
          rintro _ ⟨y, rfl⟩
          rw [Scheme.Opens.range_ι]
          exact hgN' ⟨y, rfl⟩), IsOpenImmersion.lift_fac _ _ _⟩
      obtain ⟨φ, hφ⟩ : ∃ φ : N.toScheme ⟶ wcProjK Ω 1, φ ≫ κ = N.ι ≫ Limits.pullback.fst uZ uZ' :=
        ⟨IsOpenImmersion.lift κ (N.ι ≫ Limits.pullback.fst uZ uZ') (by
          rintro _ ⟨q, rfl⟩
          have hq : N.ι q ∈ (N : Set _) := by rw [← Scheme.Opens.range_ι]; exact ⟨q, rfl⟩
          have hq' : Limits.pullback.fst uZ uZ' (N.ι q) ∈ (κ.opensRange : Set Z) := hq
          rw [Scheme.Hom.coe_opensRange] at hq'
          rw [Scheme.Hom.comp_apply]
          exact hq'), IsOpenImmersion.lift_fac _ _ _⟩
      have hsec : gN ≫ φ = 𝟙 _ := by
        rw [← cancel_mono κ, Category.assoc, hφ, ← Category.assoc, hgN, hg, Category.id_comp]
      haveI : IsSeparated (φ ≫ κ) := by rw [hφ]; infer_instance
      haveI : IsSeparated φ := IsSeparated.of_comp φ κ
      haveI : IsClosedImmersion (gN ≫ φ) := by rw [hsec]; infer_instance
      haveI : IsClosedImmersion gN := IsClosedImmersion.of_comp gN φ
      have hcl : IsClosed (Set.range gN) := gN.isClosedEmbedding.isClosed_range
      have hpN : g.imageι γ ∈ (N : Set _) := by
        show Limits.pullback.fst uZ uZ' (g.imageι γ) ∈ (κ.opensRange : Set Z)
        rw [Scheme.Hom.coe_opensRange]
        exact hγ
      rw [← Scheme.Opens.range_ι N] at hpN
      obtain ⟨q, hq⟩ := hpN
      have himg : N.ι '' Set.range gN = Set.range g := by
        ext p
        constructor
        · rintro ⟨_, ⟨y, rfl⟩, rfl⟩
          exact ⟨y, by rw [← Scheme.Hom.comp_apply, hgN]⟩
        · rintro ⟨y, rfl⟩
          exact ⟨_, ⟨y, rfl⟩, by rw [← Scheme.Hom.comp_apply, hgN]⟩
      have hqcl : q ∈ closure (Set.range gN) := by
        rw [N.ι.isOpenEmbedding.isEmbedding.closure_eq_preimage_closure_image, himg]
        rw [Set.mem_preimage, hq]
        exact hmem
      rw [hcl.closure_eq] at hqcl
      obtain ⟨y, hy⟩ := hqcl
      refine ⟨y, g.imageι.isClosedEmbedding.injective ?_⟩
      rw [← Scheme.Hom.comp_apply, Scheme.Hom.toImage_imageι, ← hq, ← hy, ← Scheme.Hom.comp_apply,
        hgN]

    obtain ⟨p₁, hp₁⟩ : ∃ p, p = g.imageι ≫ Limits.pullback.fst uZ uZ' := ⟨_, rfl⟩
    haveI : IsProper p₁ := by rw [hp₁]; infer_instance
    have hjp : g.toImage ≫ p₁ = κ := by
      rw [hp₁, ← Category.assoc, Scheme.Hom.toImage_imageι, hg]
    have hκp : ∀ y, κ y = p₁ (g.toImage y) := fun y => by
      rw [← Scheme.Hom.comp_apply, hjp]
    haveI : LocallyQuasiFinite p₁ := by
      refine wcpa_dj_ldx_lqf_of_no_fibre_specialization p₁ inferInstance ?_
      intro x x' hxx' heq
      by_cases hc : uZ (p₁ x) = IsLocalRing.closedPoint ↥W
      · rw [hp₁] at heq hc
        exact wcpa_dj_lr1u_no_contraction Ω W hW hWt m b h3 hbs hbd Z Z' uZ uZ' κ κ' σ σ' hstZ
          hstZ' hZp hZp' hpbZ hpbZ' hσ hσ' h g.image g.imageι g.toImage inferInstance hred
          inferInstance hdense ((Scheme.Hom.toImage_imageι g).trans hgdef) hjr x x' hxx' heq hc
      · obtain ⟨y, hy⟩ := (hrange _).mpr hc
        have hκr : p₁ x ∈ Set.range κ := by
          obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback
            (f := uZ) (g := Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) (p₁ x) y hy.symm
          refine ⟨hpbZ.isoPullback.inv w, ?_⟩
          rw [← Scheme.Hom.comp_apply, hpbZ.isoPullback_inv_fst, hw1]
        have hκr' : p₁ x' ∈ Set.range κ := heq ▸ hκr
        rw [hp₁] at hκr hκr'
        obtain ⟨y1, rfl⟩ := hjr x hκr
        obtain ⟨y2, rfl⟩ := hjr x' hκr'
        have e : κ y2 = κ y1 := by rw [hκp, hκp]; exact heq
        rw [κ.isOpenEmbedding.injective e]
    haveI : IsFinite p₁ := IsFinite.of_isProper_of_locallyQuasiFinite p₁
    obtain ⟨hZint, hZnorm⟩ := wcpa_dj_lr1u_model_normal Ω W hW hWt Z uZ κ hstZ.1 hZp hpbZ
    haveI := hZint
    haveI := hred
    haveI hiso : IsIso p₁ := (fbi Z g.image (wcProjK Ω 1) p₁ g.toImage κ hZnorm hdense hjp
      (fun x hx => hjr x (by rw [← hp₁]; exact hx))).1
    have hκinv : κ ≫ inv p₁ = g.toImage := (IsIso.comp_inv_eq _).mpr hjp.symm
    refine ⟨inv p₁ ≫ g.imageι ≫ Limits.pullback.snd uZ uZ', ?_, ?_⟩
    · have e : g.imageι ≫ Limits.pullback.snd uZ uZ' ≫ uZ' = p₁ ≫ uZ := by
        rw [hp₁, Category.assoc, Limits.pullback.condition]
      rw [Category.assoc, Category.assoc, e, IsIso.inv_hom_id_assoc]
    · rw [← Category.assoc, hκinv, ← Category.assoc, Scheme.Hom.toImage_imageι, hg']
  obtain ⟨Φ, hΦu, hΦι⟩ := core X X' uX uX' ι ι' β β' hst hst' hXp hXp' hpb hpb' hβ hβ'
  obtain ⟨Ψ, hΨu, hΨι⟩ := core X' X uX' uX ι' ι β' β hst' hst hXp' hXp hpb' hpb hβ' hβ
  obtain ⟨hXint, -⟩ := wcpa_dj_lr1u_model_normal Ω W hW hWt X uX ι hst.1 hXp hpb
  obtain ⟨hX'int, -⟩ := wcpa_dj_lr1u_model_normal Ω W hW hWt X' uX' ι' hst'.1 hXp' hpb'
  haveI := hXint
  haveI := hX'int
  haveI : IsProper uX := hst.1.2.1
  haveI : IsProper uX' := hst'.1.2.1
  haveI : IsOpenImmersion ι := MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb.flip heW
  haveI : IsOpenImmersion ι' :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb'.flip heW
  haveI : IsDominant ι := by
    rw [isDominant_iff]
    exact ι.isOpenEmbedding.isOpen_range.dense (Set.range_nonempty _)
  haveI : IsDominant ι' := by
    rw [isDominant_iff]
    exact ι'.isOpenEmbedding.isOpen_range.dense (Set.range_nonempty _)
  have h1 : Φ ≫ Ψ = 𝟙 X :=
    ext_of_isDominant_of_isSeparated uX (by rw [Category.assoc, hΨu, hΦu, Category.id_comp]) ι
      (by rw [← Category.assoc, hΦι, hΨι, Category.comp_id])
  have h2 : Ψ ≫ Φ = 𝟙 X' :=
    ext_of_isDominant_of_isSeparated uX' (by rw [Category.assoc, hΦu, hΨu, Category.id_comp]) ι'
      (by rw [← Category.assoc, hΨι, hΦι, Category.comp_id])
  exact ⟨Φ, ⟨⟨Ψ, h1, h2⟩⟩, hΦu, hΦι⟩

theorem wcpa_dj_lr1k_nodal_fibre_transport : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (Y Y' : Scheme.{u}) (g : Y ⟶ Spec (.of ↥W)) (g' : Y' ⟶ Spec (.of ↥W)) (Ψ : Y ⟶ Y'), IsIso Ψ → Ψ ≫ g' = g → (∀ w : ↥(Limits.pullback (g) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))), (∃ U : (Limits.pullback (g) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).Opens, w ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ Limits.pullback.snd (g) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) ∨ (∃ e : AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback (g) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w)) ((Limits.pullback (g) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w) ≃+* (MvPowerSeries (Fin 2) (IsLocalRing.ResidueField ↥W) ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), (e.toRingHom.comp ((algebraMap ((Limits.pullback (g) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w) (AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback (g) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w)) ((Limits.pullback (g) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w))).comp ((Scheme.ΓSpecIso (.of (IsLocalRing.ResidueField ↥W))).inv ≫ (Limits.pullback.snd (g) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).appTop ≫ (Limits.pullback (g) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.germ ⊤ w trivial).hom)) = (Ideal.Quotient.mk _).comp MvPowerSeries.C)) → (∀ w : ↥(Limits.pullback (g') (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))), (∃ U : (Limits.pullback (g') (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).Opens, w ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ Limits.pullback.snd (g') (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) ∨ (∃ e : AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback (g') (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w)) ((Limits.pullback (g') (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w) ≃+* (MvPowerSeries (Fin 2) (IsLocalRing.ResidueField ↥W) ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), (e.toRingHom.comp ((algebraMap ((Limits.pullback (g') (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w) (AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback (g') (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w)) ((Limits.pullback (g') (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w))).comp ((Scheme.ΓSpecIso (.of (IsLocalRing.ResidueField ↥W))).inv ≫ (Limits.pullback.snd (g') (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).appTop ≫ (Limits.pullback (g') (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.germ ⊤ w trivial).hom)) = (Ideal.Quotient.mk _).comp MvPowerSeries.C)) :=
by
  classical

  have adicT : ∀ (R S : Type u) [CommRing R] [CommRing S] [IsLocalRing R] [IsLocalRing S] (σ : R ≃+* S),
      ∃ σh : AdicCompletion (IsLocalRing.maximalIdeal R) R ≃+*
          AdicCompletion (IsLocalRing.maximalIdeal S) S,
        ∀ x : R, σh (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) x) =
          algebraMap S (AdicCompletion (IsLocalRing.maximalIdeal S) S) (σ x) := by
    intro R S _ _ _ _ σ
    have C0 : ∀ {T : Type u} [CommRing T] (K : Ideal T) {m n : ℕ} (hle : m ≤ n)
        (x : AdicCompletion K T),
        Ideal.Quotient.factorPow K hle (AdicCompletion.evalₐ K n x) =
          AdicCompletion.evalₐ K m x := by
      intro T _ K m n hle x
      obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective K T x
      rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
      have h := AdicCompletion.AdicCauchySequence.mk_eq_mk hle c
      rw [Submodule.Quotient.eq] at h
      rw [Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
      simpa [Ideal.smul_eq_mul, Ideal.mul_top] using h
    have gen : ∀ {A B : Type u} [CommRing A] [CommRing B] (K : Ideal A) (K' : Ideal B)
        (τ : A ≃+* B) (hn : ∀ n, K ^ n ≤ Ideal.comap (τ : A →+* B) (K' ^ n)),
        ∃ φ : AdicCompletion K A →+* AdicCompletion K' B, ∀ n (y : AdicCompletion K A),
          AdicCompletion.evalₐ K' n (φ y) =
            Ideal.quotientMap (K' ^ n) (τ : A →+* B) (hn n) (AdicCompletion.evalₐ K n y) := by
      intro A B _ _ K K' τ hn
      let f : ∀ n, AdicCompletion K A →+* B ⧸ K' ^ n := fun n =>
        (Ideal.quotientMap (K' ^ n) (τ : A →+* B) (hn n)).comp
          ((AdicCompletion.evalₐ K n : AdicCompletion K A →ₐ[A] A ⧸ K ^ n) :
            AdicCompletion K A →+* A ⧸ K ^ n)
      have hf : ∀ {m n : ℕ} (hle : m ≤ n),
          (Ideal.Quotient.factorPow K' hle).comp (f n) = f m := by
        intro m n hle
        have e1 : (Ideal.Quotient.factorPow K' hle).comp
              (Ideal.quotientMap (K' ^ n) (τ : A →+* B) (hn n)) =
            (Ideal.quotientMap (K' ^ m) (τ : A →+* B) (hn m)).comp
              (Ideal.Quotient.factorPow K hle) := by
          apply Ideal.Quotient.ringHom_ext
          ext r
          simp [Ideal.Quotient.factorPow, Ideal.quotientMap_mk, Ideal.Quotient.factor_mk]
        ext y
        show (Ideal.Quotient.factorPow K' hle) (Ideal.quotientMap (K' ^ n) (τ : A →+* B) (hn n)
          (AdicCompletion.evalₐ K n y)) = Ideal.quotientMap (K' ^ m) (τ : A →+* B) (hn m)
          (AdicCompletion.evalₐ K m y)
        rw [← C0 K hle y]
        exact RingHom.congr_fun e1 _
      refine ⟨AdicCompletion.liftRingHom K' f hf, fun n y => ?_⟩
      rw [AdicCompletion.evalₐ_liftRingHom]
      rfl
    set I := IsLocalRing.maximalIdeal R with hI
    set J := IsLocalRing.maximalIdeal S with hJ
    have hcJ : Ideal.comap (σ : R →+* S) J = I := by
      have : (Ideal.comap (σ : R →+* S) J).IsMaximal := Ideal.comap_isMaximal_of_equiv σ
      exact IsLocalRing.eq_maximalIdeal this
    have hcI : Ideal.comap (σ.symm : S →+* R) I = J := by
      have : (Ideal.comap (σ.symm : S →+* R) I).IsMaximal := Ideal.comap_isMaximal_of_equiv σ.symm
      exact IsLocalRing.eq_maximalIdeal this
    have hn : ∀ n, I ^ n ≤ Ideal.comap (σ : R →+* S) (J ^ n) := fun n => by
      rw [← hcJ]; exact Ideal.le_comap_pow _ n
    have hn' : ∀ n, J ^ n ≤ Ideal.comap (σ.symm : S →+* R) (I ^ n) := fun n => by
      rw [← hcI]; exact Ideal.le_comap_pow _ n
    obtain ⟨φ, hφ⟩ := gen I J σ hn
    obtain ⟨ψ, hψ⟩ := gen J I σ.symm hn'
    have h1 : φ.comp ψ = RingHom.id _ := by
      refine RingHom.ext fun z => ?_
      apply AdicCompletion.ext_evalₐ
      intro n
      rw [RingHom.comp_apply, hφ, hψ, RingHom.id_apply]
      obtain ⟨s, hs⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ J n z)
      rw [← hs, Ideal.quotientMap_mk, Ideal.quotientMap_mk]
      simp
    have h2 : ψ.comp φ = RingHom.id _ := by
      refine RingHom.ext fun z => ?_
      apply AdicCompletion.ext_evalₐ
      intro n
      rw [RingHom.comp_apply, hψ, hφ, RingHom.id_apply]
      obtain ⟨s, hs⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ I n z)
      rw [← hs, Ideal.quotientMap_mk, Ideal.quotientMap_mk]
      simp
    refine ⟨RingEquiv.ofRingHom φ ψ h1 h2, fun x => ?_⟩
    show φ _ = _
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hφ, AdicCompletion.algebraMap_apply, AdicCompletion.algebraMap_apply,
      Algebra.algebraMap_self, Algebra.algebraMap_self, RingHom.id_apply, RingHom.id_apply,
      AdicCompletion.evalₐ_of, AdicCompletion.evalₐ_of, Ideal.quotientMap_mk]
    rfl

  have nodeT : ∀ (R O O' : CommRingCat.{u}) [IsLocalRing O] [IsLocalRing O'] (τ : O ⟶ O') [IsIso τ]
      (c : R ⟶ O) (c' : R ⟶ O') (Q : Type u) [CommRing Q] (M : R →+* Q), c ≫ τ = c' →
      (∃ e : AdicCompletion (IsLocalRing.maximalIdeal O) O ≃+* Q,
        e.toRingHom.comp ((algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O)).comp
          c.hom) = M) →
      (∃ e : AdicCompletion (IsLocalRing.maximalIdeal O') O' ≃+* Q,
        e.toRingHom.comp ((algebraMap O' (AdicCompletion (IsLocalRing.maximalIdeal O') O')).comp
          c'.hom) = M) := by
    intro R O O' _ _ τ _ c c' Q _ M hc ⟨e, he⟩
    obtain ⟨σh, hσh⟩ := adicT O O' (asIso τ).commRingCatIsoToRingEquiv
    refine ⟨σh.symm.trans e, ?_⟩
    rw [← he, ← hc]
    refine RingHom.ext fun k => ?_
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
      RingEquiv.trans_apply, CommRingCat.hom_comp]
    rw [show τ.hom (c.hom k) = (asIso τ).commRingCatIsoToRingEquiv (c.hom k) from rfl, ← hσh,
      RingEquiv.symm_apply_apply]

  intro Ω _ W Y Y' g g' Ψ hΨ hΨg hnod
  haveI := hΨ
  set s₀ := Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) with hs₀
  have h₁ : (Limits.pullback.fst g' s₀ ≫ inv Ψ) ≫ g = Limits.pullback.snd g' s₀ ≫ s₀ := by
    rw [Category.assoc, ← hΨg, IsIso.inv_hom_id_assoc]; exact Limits.pullback.condition
  let ρ : Limits.pullback g' s₀ ⟶ Limits.pullback g s₀ := Limits.pullback.lift _ _ h₁
  have h₂ : (Limits.pullback.fst g s₀ ≫ Ψ) ≫ g' = Limits.pullback.snd g s₀ ≫ s₀ := by
    rw [Category.assoc, hΨg]; exact Limits.pullback.condition
  let θ : Limits.pullback g s₀ ⟶ Limits.pullback g' s₀ := Limits.pullback.lift _ _ h₂
  have hρθ : ρ ≫ θ = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
        Category.assoc, IsIso.inv_hom_id, Category.comp_id, Category.id_comp]
    · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd, Category.id_comp]
  have hθρ : θ ≫ ρ = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
        Category.assoc, IsIso.hom_inv_id, Category.comp_id, Category.id_comp]
    · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd, Category.id_comp]
  haveI hρiso : IsIso ρ := ⟨⟨θ, hρθ, hθρ⟩⟩
  have hρp : ρ ≫ Limits.pullback.snd g s₀ = Limits.pullback.snd g' s₀ :=
    Limits.pullback.lift_snd _ _ _

  intro w'
  rcases hnod (ρ w') with ⟨U, hU, hsm⟩ | hnode
  · left
    refine ⟨ρ ⁻¹ᵁ U, hU, ?_⟩
    have hcomp : (ρ ⁻¹ᵁ U).ι ≫ Limits.pullback.snd g' s₀ =
        (ρ ∣_ U) ≫ (U.ι ≫ Limits.pullback.snd g s₀) := by
      rw [← hρp, ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
    rw [hcomp]
    haveI := hsm
    exact (inferInstance : SmoothOfRelativeDimension (0 + 1)
      ((ρ ∣_ U) ≫ (U.ι ≫ Limits.pullback.snd g s₀)))
  · right
