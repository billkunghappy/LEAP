    haveI : SmoothOfRelativeDimension 1 (W.ι ≫ q) := hW
    haveI : Smooth (W.ι ≫ q) := SmoothOfRelativeDimension.smooth 1 (W.ι ≫ q)
    haveI : IsDomain (W.toScheme.presheaf.stalk ⟨x, hxW⟩) :=
