    obtain ⟨u, v, ⟨hu, hv, hspan, -⟩, huv⟩ := wcpa_dj_lqu_sp_node_basis K (C.presheaf.stalk x) _
      (e.toRingHom.comp (algebraMap _ _)) ((RingHom.comp_assoc _ _ _).trans he) hbr.1 hbr.2

    have hgen : ∀ y ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x),
