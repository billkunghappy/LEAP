        ((Category.comp_id φ).trans (Category.id_comp φ).symm) with hM
  set L := Limits.pullback.lift t₀ (𝟙 _) (ht₀.trans (Category.id_comp φ).symm) with hL
  have E1 : ∀ c, M c ≫ Limits.pullback.fst p φ = Limits.pullback.fst p φ ≫ a c := by
    intro c; exact Limits.pullback.lift_fst _ _ _
  have E2 : ∀ c, M c ≫ Limits.pullback.snd p φ = Limits.pullback.snd p φ ≫ 𝟙 _ := by
    intro c; exact Limits.pullback.lift_snd _ _ _
  have pM1 : ∀ c y, Limits.pullback.fst p φ (M c y) = a c (Limits.pullback.fst p φ y) := by
    intro c y; rw [← Scheme.Hom.comp_apply, E1, Scheme.Hom.comp_apply]
  have pM2 : ∀ c y, Limits.pullback.snd p φ (M c y) = Limits.pullback.snd p φ y := by
    intro c y; rw [← Scheme.Hom.comp_apply, E2, Category.comp_id]
  have pL1 : ∀ x, Limits.pullback.fst p φ (L x) = t₀ x := by
    intro x; rw [← Scheme.Hom.comp_apply, hL, Limits.pullback.lift_fst]
  have pL2 : ∀ x, Limits.pullback.snd p φ (L x) = x := by
    intro x; rw [← Scheme.Hom.comp_apply, hL, Limits.pullback.lift_snd]; rfl

  have key : ∀ w : V, p w = Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) z →
      ∃ c : ZMod 2, a c w = t₀ (θ.hom e₀) := by
    intro w hw
    obtain ⟨y, hy1, hy2⟩ := Scheme.Pullback.exists_preimage_pullback w (θ.hom e₀) (hw.trans hγ.symm)
    obtain ⟨c, x, hcx⟩ := hpart y
    have hcx' : M c y = L x := hcx
    have hx : x = θ.hom e₀ := by
      have h := congrArg (Limits.pullback.snd p φ) hcx'
      rw [pM2, pL2, hy2] at h
      exact h.symm
    refine ⟨c, ?_⟩
    have h := congrArg (Limits.pullback.fst p φ) hcx'
    rw [pM1, pL1, hy1, hx] at h
    exact h
  refine ⟨(Set.finite_range (fun c : ZMod 2 => a c (t₀ (θ.hom e₀)))).subset ?_, ?_⟩
  · intro w hw
    obtain ⟨c, hc⟩ := key w hw
    refine ⟨-c, ?_⟩
    show a (-c) (t₀ (θ.hom e₀)) = w
    rw [← hc, ← T2, neg_add_cancel, T3]
  · intro w hw hfix
    obtain ⟨c, hc⟩ := key w hw
    have h1 : a 1 (t₀ (θ.hom e₀)) = t₀ (θ.hom e₀) := by
      rw [← hc, ← T2, add_comm, T2, hfix]
    have hne : M 1 (L (θ.hom e₀)) ≠ L (θ.hom e₀) := hneq 1 (by decide) (θ.hom e₀) (θ.hom e₀)
    apply hne
    apply hqinj
    rw [pM1, pL1, h1]

theorem wcpa_dj_lus_cvs_ct_fcn_reduced_stalk_ker : ∀ (X Z : Scheme.{u}) (ι : Z ⟶ X), IsClosedImmersion ι → IsReduced Z → ∀ (g : X), Set.range ι = closure ({g} : Set X) → ∀ (z : Z) (h : g ⤳ ι z), RingHom.ker (ι.stalkMap z).hom = (IsLocalRing.maximalIdeal (X.presheaf.stalk g)).comap (X.presheaf.stalkSpecializes h).hom :=
by
  intro X Z ι hι hred g hrange z h
  have hg : g ∈ Set.range ι := by rw [hrange]; exact subset_closure rfl
  obtain ⟨zg, rfl⟩ := hg
  have hemb : Topology.IsInducing ι := ι.isClosedEmbedding.isInducing
  have hz : zg ⤳ z := hemb.specializes_iff.mp h
  have hgen : ∀ y : Z, zg ⤳ y := by
    intro y
    apply hemb.specializes_iff.mp
    rw [specializes_iff_mem_closure, ← hrange]
    exact ⟨y, rfl⟩
  have hsq : ∀ a, (ι.stalkMap zg).hom ((X.presheaf.stalkSpecializes h).hom a) =
      (Z.presheaf.stalkSpecializes hz).hom ((ι.stalkMap z).hom a) := fun a =>
    Scheme.Hom.stalkSpecializes_stalkMap_apply ι zg z hz a
  have s3 : ∀ b : Z.presheaf.stalk z, (Z.presheaf.stalkSpecializes hz).hom b ∈
      IsLocalRing.maximalIdeal (Z.presheaf.stalk zg) → b = 0 := by
    intro b hb
    obtain ⟨U, hzU, s, rfl⟩ := Z.presheaf.exists_germ_eq b
    have hzgU : zg ∈ U := hz.mem_open U.isOpen hzU
    rw [TopCat.Presheaf.germ_stalkSpecializes_apply] at hb
    have hnu : zg ∉ Z.basicOpen s := by
      intro hm
      rw [Scheme.mem_basicOpen _ _ _ hzgU] at hm
      exact (IsLocalRing.mem_maximalIdeal _).mp hb hm
    have hbot : Z.basicOpen s = ⊥ := by
      by_contra hne
      obtain ⟨y, hy⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hne
      exact hnu ((hgen y).mem_open (Z.basicOpen s).isOpen hy)
    rw [basicOpen_eq_bot_iff] at hbot
    rw [hbot, map_zero]
  ext a
  rw [RingHom.mem_ker, Ideal.mem_comap]
  constructor
  · intro ha
    have e := hsq a
    rw [ha, map_zero] at e
    rw [IsLocalRing.mem_maximalIdeal, ← map_mem_nonunits_iff (ι.stalkMap zg).hom, e]
    exact zero_mem_nonunits.mpr zero_ne_one
  · intro ha
    apply s3
    rw [← hsq, IsLocalRing.mem_maximalIdeal, map_mem_nonunits_iff]
    exact ha

theorem wcpa_dj_lus_cvs_ct_fcn_maximal_point_prime_bot : ∀ (X : Scheme.{u}) (g y : X) (h : g ⤳ y), (∀ g' : X, g' ⤳ g → g' = g) → IsDomain (X.presheaf.stalk y) → (IsLocalRing.maximalIdeal (X.presheaf.stalk g)).comap (X.presheaf.stalkSpecializes h).hom = ⊥ :=
by
  intro X g y h hmax hdom
  classical
  set p := (Spec.map (X.presheaf.stalkSpecializes h))
    (IsLocalRing.closedPoint (X.presheaf.stalk g)) with hp
  have hpI : p.asIdeal = (IsLocalRing.maximalIdeal (X.presheaf.stalk g)).comap
      (X.presheaf.stalkSpecializes h).hom := by
    rfl
  have hφp : X.fromSpecStalk y p = g := by
    have e := Scheme.Hom.comp_apply (Spec.map (X.presheaf.stalkSpecializes h))
      (X.fromSpecStalk y) (IsLocalRing.closedPoint (X.presheaf.stalk g))
    rw [Scheme.SpecMap_stalkSpecializes_fromSpecStalk, Scheme.fromSpecStalk_closedPoint] at e
    exact e.symm
  let q : PrimeSpectrum (X.presheaf.stalk y) := ⟨⊥, Ideal.isPrime_bot⟩
  have hqp : q ⤳ p := (PrimeSpectrum.le_iff_specializes q p).mp
    (show (⊥ : Ideal (X.presheaf.stalk y)) ≤ p.asIdeal from bot_le)
  have h1 := hqp.map (X.fromSpecStalk y).continuous
  rw [hφp] at h1
  have hφq : X.fromSpecStalk y q = g := hmax _ h1
  have hinj : Function.Injective (X.fromSpecStalk y) := (X.fromSpecStalk y).isEmbedding.injective
  have hqp' : q = p := hinj (hφq.trans hφp.symm)
  rw [← hpI, ← hqp']

theorem wcpa_dj_lus_cvs_ct_fcn_generic_fibre_normal : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : ValuationSubring K), IsAlgClosed (IsLocalRing.ResidueField ↥R) → ∀ (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)), wcpaDjSemistable v →
    ∀ E ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))),
    (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra), IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧ θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = ι ≫ Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) →
    ∀ (g y : Y) (h : g ⤳ y), closure ({g} : Set Y) = closure ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) '' E) → v y = genericPoint (Spec (.of ↥R)) → IsIntegrallyClosed (Y.presheaf.stalk y ⧸ (IsLocalRing.maximalIdeal (Y.presheaf.stalk g)).comap (Y.presheaf.stalkSpecializes h).hom) :=
by
  intro K _ _ R hκ Y v hss E hE hP1E g y h hgcl hvy
  classical
  obtain ⟨_, ⟨hKemb, hKrange⟩, _, _⟩ := wcpa_dj_lus_cvs_fibre_topology K R Y v hss
  set fK := Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) with hfK
  have hvg : v g = genericPoint (Spec (.of ↥R)) := by
    have h1 : v g ⤳ genericPoint (Spec (.of ↥R)) := by rw [← hvy]; exact h.map v.continuous
    exact (h1.antisymm (genericPoint_specializes _)).eq
  obtain ⟨eg, rfl⟩ : g ∈ Set.range fK := by rw [hKrange]; exact hvg
  obtain ⟨e, rfl⟩ : y ∈ Set.range fK := by rw [hKrange]; exact hvy

  have hEcl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
  obtain ⟨zE, hzE⟩ : ∃ z, closure {z} = E := by
    refine ⟨hE.1.genericPoint, ?_⟩
    have h1 := hE.1.isGenericPoint_genericPoint_closure
    rw [hEcl.closure_eq] at h1
    exact h1
  have hpre : ∀ x, fK x ∈ closure (fK '' E) → x ∈ E := by
    intro x hx
    have h1 : x ∈ closure E := by
      rw [hKemb.toIsInducing.closure_eq_preimage_closure_image]; exact hx
    rwa [hEcl.closure_eq] at h1
  have heE : e ∈ E := hpre e (by rw [← hgcl]; exact specializes_iff_mem_closure.mp h)
  have hegE : eg ∈ E := hpre eg (by rw [← hgcl]; exact subset_closure rfl)
  have hcleg : closure ({eg} : Set _) = E := by
    apply Set.Subset.antisymm (closure_minimal (Set.singleton_subset_iff.mpr hegE) hEcl)
    have hzmem : zE ∈ E := by rw [← hzE]; exact subset_closure rfl
    have h1 : fK eg ⤳ fK zE :=
      specializes_iff_mem_closure.mpr (by rw [hgcl]; exact subset_closure ⟨zE, hzmem, rfl⟩)
    have h2 : eg ⤳ zE := hKemb.toIsInducing.specializes_iff.mp h1
    rw [← hzE]; exact specializes_iff_closure_subset.mp h2

  obtain ⟨Er, ιE, θ, hci, hred, hrange, -⟩ := hP1E
  haveI := hci
  obtain ⟨e', rfl⟩ : e ∈ Set.range ιE := by rw [hrange]; exact heE
  have hsp : eg ⤳ ιE e' := hKemb.toIsInducing.specializes_iff.mp h
  have hker := wcpa_dj_lus_cvs_ct_fcn_reduced_stalk_ker _ Er ιE hci hred eg
    (hrange.trans hcleg.symm) e' hsp
  have hsurj : Function.Surjective (ιE.stalkMap e').hom :=
    SurjectiveOnStalks.stalkMap_surjective ιE e'
  let σ1 := (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hsurj)
  let τ := (asIso (θ.hom.stalkMap e')).commRingCatIsoToRingEquiv
  obtain ⟨-, hic⟩ := wc_projK_one_stalk_normal K (θ.hom e')
  haveI := hic
  haveI hK : IsIntegrallyClosed ((Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).presheaf.stalk (ιE e') ⧸
      (IsLocalRing.maximalIdeal ((Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).presheaf.stalk eg)).comap
        ((Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).presheaf.stalkSpecializes hsp).hom) :=
    IsIntegrallyClosed.of_equiv (τ.trans σ1.symm)

  haveI hjp : IsPreimmersion (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) :=
    IsPreimmersion.of_isLocalization (nonZeroDivisors ↥R)
  haveI : IsPreimmersion fK :=
    MorphismProperty.of_isPullback (P := @IsPreimmersion)
      (IsPullback.of_hasPullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).flip hjp
  set α := (fK.stalkMap (ιE e')).hom with hα
  set β := (fK.stalkMap eg).hom with hβdef
  set sp := (Y.presheaf.stalkSpecializes h).hom with hspdef
  set sp' := ((Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).presheaf.stalkSpecializes hsp).hom with hsp'def
  set J := (IsLocalRing.maximalIdeal ((Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).presheaf.stalk eg)).comap sp' with hJ
  have hsq : β.comp sp = sp'.comp α := by
    have h0 := Scheme.Hom.stalkSpecializes_stalkMap fK eg (ιE e') hsp
    have h1 := congrArg CommRingCat.Hom.hom h0
    simpa only [CommRingCat.hom_comp] using h1
  have hβ : (IsLocalRing.maximalIdeal ((Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).presheaf.stalk eg)).comap β =
      IsLocalRing.maximalIdeal (Y.presheaf.stalk (fK eg)) := by
    ext x
    rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal,
      map_mem_nonunits_iff]
  have hP : J.comap α = (IsLocalRing.maximalIdeal (Y.presheaf.stalk (fK eg))).comap sp := by
    rw [hJ, Ideal.comap_comap, ← hsq, ← Ideal.comap_comap, hβ]
  have hφ : Function.Surjective ((Ideal.Quotient.mk J).comp α) :=
    Ideal.Quotient.mk_surjective.comp (SurjectiveOnStalks.stalkMap_surjective fK (ιE e'))
  have hkerφ : RingHom.ker ((Ideal.Quotient.mk J).comp α) =
      (IsLocalRing.maximalIdeal (Y.presheaf.stalk (fK eg))).comap sp := by
    rw [← RingHom.comap_ker, Ideal.mk_ker, hP]
  let σ2 := (Ideal.quotEquivOfEq hkerφ.symm).trans (RingHom.quotientKerEquivOfSurjective hφ)
  exact IsIntegrallyClosed.of_equiv σ2.symm

theorem wcpa_dj_lus_tbw_node_ring_normal : ∀ (K : Type u) [Field K] (R : ValuationSubring K) (a : ↥R), a ≠ 0 → IsDomain (wcNcRing R a) ∧ IsIntegrallyClosed (wcNcRing R a) :=
by

  have S1 : ∀ (A N : Type u) [CommRing A] [CommRing N] [Algebra A N] (a : A) (u v : N),
      u * v = algebraMap A N a →
      (∀ r : A, ∃ F G : Polynomial A,
        algebraMap A N r = Polynomial.aeval u F + v * Polynomial.aeval v G) ∧
      (∀ n₁ n₂ : N, (∃ F G : Polynomial A, n₁ = Polynomial.aeval u F + v * Polynomial.aeval v G) →
        (∃ F G : Polynomial A, n₂ = Polynomial.aeval u F + v * Polynomial.aeval v G) →
        ∃ F G : Polynomial A, n₁ + n₂ = Polynomial.aeval u F + v * Polynomial.aeval v G) ∧
      (∀ n : N, (∃ F G : Polynomial A, n = Polynomial.aeval u F + v * Polynomial.aeval v G) →
        ∃ F G : Polynomial A, n * u = Polynomial.aeval u F + v * Polynomial.aeval v G) ∧
      (∀ n : N, (∃ F G : Polynomial A, n = Polynomial.aeval u F + v * Polynomial.aeval v G) →
        ∃ F G : Polynomial A, n * v = Polynomial.aeval u F + v * Polynomial.aeval v G) := by
    intro A N _ _ _ a u v huv
    refine ⟨fun r => ⟨Polynomial.C r, 0, by simp⟩, ?_, ?_, ?_⟩
    · rintro n₁ n₂ ⟨F₁, G₁, rfl⟩ ⟨F₂, G₂, rfl⟩
      exact ⟨F₁ + F₂, G₁ + G₂, by simp only [map_add]; ring⟩
    · rintro n ⟨F, G, rfl⟩
      have hG := congrArg (Polynomial.aeval v) (Polynomial.X_mul_divX_add G)
      simp only [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at hG
      refine ⟨Polynomial.X * F + Polynomial.C (a * G.coeff 0), Polynomial.C a * G.divX, ?_⟩
      simp only [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
      linear_combination (Polynomial.aeval v G) * huv - (algebraMap A N a) * hG
    · rintro n ⟨F, G, rfl⟩
      have hF := congrArg (Polynomial.aeval u) (Polynomial.X_mul_divX_add F)
      simp only [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at hF
      refine ⟨Polynomial.C a * F.divX, Polynomial.C (F.coeff 0) + Polynomial.X * G, ?_⟩
      simp only [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
      linear_combination ((Polynomial.aeval u) F.divX) * huv - v * hF

  have S2 : ∀ (K : Type u) [Field K] (R : ValuationSubring K) (a : ↥R) (p q : LaurentPolynomial ↥R),
      p * q = LaurentPolynomial.C a →
      ∃ θ : wcNcRing R a →+* LaurentPolynomial ↥R,
        (∀ r : ↥R, θ (algebraMap (↥R) (wcNcRing R a) r) = LaurentPolynomial.C r) ∧
        θ (Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 0)) = p ∧
        θ (Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 1)) = q := by
    intro K _ R a p q hpq
    let Φ : MvPolynomial (Fin 2) ↥R →+* LaurentPolynomial ↥R :=
      MvPolynomial.eval₂Hom LaurentPolynomial.C ![p, q]
    have hle : ∀ z ∈ wcNcIdeal R a, Φ z = 0 := by
      intro z hz
      have : wcNcIdeal R a ≤ RingHom.ker Φ := by
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
        simp [Φ, hpq]
      exact this hz
    refine ⟨Ideal.Quotient.lift _ Φ hle, ?_, ?_, ?_⟩
    · intro r
      rw [← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.lift_mk, MvPolynomial.algebraMap_eq]
      simp [Φ]
    · rw [Ideal.Quotient.lift_mk]; simp [Φ]
    · rw [Ideal.Quotient.lift_mk]; simp [Φ]

  have S3 : ∀ (A : Type u) [CommRing A] [IsDomain A] (F Q : Polynomial A), Q.coeff 0 = 0 →
      Polynomial.toLaurent F + LaurentPolynomial.invert (Polynomial.toLaurent Q) = 0 →
      F = 0 ∧ Q = 0 := by
    intro A _ _ F Q hQ0 h
    have h1 : Polynomial.toLaurent (F * Polynomial.X ^ Q.natDegree + Q.reverse) = 0 := by
      rw [map_add, map_mul, Polynomial.toLaurent_X_pow, LaurentPolynomial.toLaurent_reverse,
        ← add_mul, h, zero_mul]
    have h2 : F * Polynomial.X ^ Q.natDegree + Q.reverse = 0 := by
      apply Polynomial.toLaurent_injective; rw [h1, map_zero]
    have hF : F = 0 := by
      ext j
      have h3 := congrArg (fun p => Polynomial.coeff p (j + Q.natDegree)) h2
      simp only [Polynomial.coeff_add, Polynomial.coeff_mul_X_pow, Polynomial.coeff_zero] at h3
      rw [Polynomial.coeff_zero]
      rcases j with _ | k
      · rw [Polynomial.coeff_reverse, zero_add, Polynomial.revAt_le le_rfl, Nat.sub_self, hQ0,
          add_zero] at h3
        exact h3
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (p := Q.reverse), add_zero] at h3
        · exact h3
        · exact lt_of_le_of_lt (Polynomial.reverse_natDegree_le Q) (by omega)
    refine ⟨hF, ?_⟩
    rw [hF, zero_mul, zero_add, Polynomial.reverse_eq_zero] at h2
    exact h2

  have S4 : ∀ (A N : Type u) [CommRing A] [CommRing N] [Algebra A N] (a : A) (x y : N)
      (θ : N →+* LaurentPolynomial A), (∀ r : A, θ (algebraMap A N r) = LaurentPolynomial.C r) →
      θ x = LaurentPolynomial.T 1 → θ y = LaurentPolynomial.C a * LaurentPolynomial.T (-1) →
      ∀ F G : Polynomial A,
      θ (Polynomial.aeval x F + y * Polynomial.aeval y G) = Polynomial.toLaurent F +
        LaurentPolynomial.invert (Polynomial.toLaurent ((Polynomial.X * G).comp
          (Polynomial.C a * Polynomial.X))) := by
    intro A N _ _ _ a x y θ hC hx hy F G
    have e1 : θ.comp (Polynomial.aeval x).toRingHom = Polynomial.toLaurent := by
      apply Polynomial.ringHom_ext
      · intro r; simp [hC]
      · simp [hx]
    have e2 : θ.comp (Polynomial.aeval y).toRingHom =
        ((LaurentPolynomial.invert (R := A)).toRingEquiv.toRingHom).comp
          (Polynomial.toLaurent.comp (Polynomial.compRingHom (Polynomial.C a * Polynomial.X))) := by
      apply Polynomial.ringHom_ext
      · intro r; simp [hC]
      · simp [hy]
    rw [show y * Polynomial.aeval y G = Polynomial.aeval y (Polynomial.X * G) by simp, map_add]
    have h1 := RingHom.congr_fun e1 F
    have h2 := RingHom.congr_fun e2 (Polynomial.X * G)
    simp only [RingHom.comp_apply] at h1 h2
    simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at h1 h2
    rw [h1, h2]
    simp

  have S5 : ∀ (A N : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [CommRing N]
      [Algebra A N] (x : N) (θ : N →+* LaurentPolynomial A),
      (∀ r : A, θ (algebraMap A N r) = LaurentPolynomial.C r) →
      θ x = LaurentPolynomial.T 1 → Function.Injective θ →
      IsIntegrallyClosed (Localization (Submonoid.powers x)) := by
    intro A N _ _ _ _ _ x θ hC hx hinj
    letI : Algebra N (LaurentPolynomial A) := θ.toAlgebra
    have hθ : ∀ f : Polynomial A, θ (Polynomial.aeval x f) = Polynomial.toLaurent f := by
      intro f
      have e : θ.comp (Polynomial.aeval x).toRingHom = Polynomial.toLaurent := by
        apply Polynomial.ringHom_ext
        · intro r; simp [hC]
        · simp [hx]
      have := RingHom.congr_fun e f
      simpa using this
    have : IsLocalization.Away x (LaurentPolynomial A) := by
      apply IsLocalization.Away.mk
      · rw [RingHom.algebraMap_toAlgebra, hx]; exact LaurentPolynomial.isUnit_T 1
      · intro s
        obtain ⟨n, f, hf⟩ := LaurentPolynomial.exists_T_pow s
        refine ⟨n, Polynomial.aeval x f, ?_⟩
        rw [RingHom.algebraMap_toAlgebra, hx, hθ, hf, LaurentPolynomial.T_pow]
        simp
      · intro a b h
        refine ⟨0, ?_⟩
        rw [RingHom.algebraMap_toAlgebra] at h
        rw [hinj h]
    have : IsIntegrallyClosed (LaurentPolynomial A) :=
      isIntegrallyClosed_of_isLocalization (LaurentPolynomial A)
        (Submonoid.powers (Polynomial.X : Polynomial A))
        (powers_le_nonZeroDivisors_of_noZeroDivisors Polynomial.X_ne_zero)
    exact IsIntegrallyClosed.of_equiv (IsLocalization.algEquiv (Submonoid.powers x)
      (LaurentPolynomial A) (Localization (Submonoid.powers x))).toRingEquiv

  have S6 : ∀ (A N : Type u) [CommRing A] [CommRing N] [Algebra A N] (a : A) (x y : N),
      x * y = algebraMap A N a →
      (∀ n : N, ∃ F G : Polynomial A, n = Polynomial.aeval x F + y * Polynomial.aeval y G) →
      (∀ F G : Polynomial A, Polynomial.aeval x F + y * Polynomial.aeval y G = 0 → F = 0 ∧ G = 0) →
      ∀ n n' : N, y * n = x * n' → ∃ m : N, n = x * m := by
    intro A N _ _ _ a x y hxy hnf U n n' h
    obtain ⟨F, G, rfl⟩ := hnf n
    obtain ⟨F', G', rfl⟩ := hnf n'
    have hF := congrArg (Polynomial.aeval x) (Polynomial.X_mul_divX_add F)
    simp only [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at hF
    have hG' := congrArg (Polynomial.aeval y) (Polynomial.X_mul_divX_add G')
    simp only [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at hG'
    have hNF : Polynomial.aeval x (Polynomial.C a * F.divX - Polynomial.X * F' -
        Polynomial.C (a * G'.coeff 0)) + y * Polynomial.aeval y (Polynomial.C (F.coeff 0) +
        Polynomial.X * G - Polynomial.C a * G'.divX) = 0 := by
      simp only [map_add, map_sub, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
      linear_combination h + y * hF - x * y * hG' + (algebraMap A N (G'.coeff 0) +
        y * Polynomial.aeval y G'.divX - Polynomial.aeval x F.divX) * hxy
    have hP2 := congrArg (Polynomial.aeval y) (U _ _ hNF).2
    simp only [map_add, map_sub, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, map_zero] at hP2
    refine ⟨Polynomial.aeval x F.divX + y * Polynomial.aeval y G'.divX, ?_⟩
    linear_combination hP2 - hF - Polynomial.aeval y G'.divX * hxy

  have S7 : ∀ (N : Type u) [CommRing N] (x y : N), (∀ n : N, x * n = 0 → n = 0) →
      (∀ n n' : N, y * n = x * n' → ∃ m : N, n = x * m) →
      ∀ (i j : ℕ) (n₁ n₂ : N), y ^ j * n₁ = x ^ i * n₂ → ∃ m : N, n₁ = x ^ i * m := by
    intro N _ x y hnzd hdiv
    have aux : ∀ (j : ℕ) (n n'' : N), y ^ j * n = x * n'' → ∃ m, n = x * m := by
      intro j
      induction j with
      | zero => intro n n'' h; exact ⟨n'', by simpa using h⟩
      | succ j ih =>
        intro n n'' h
        obtain ⟨m₁, hm₁⟩ := hdiv (y ^ j * n) n'' (by rw [← h]; ring)
        exact ih n m₁ hm₁
    intro i
    induction i with
    | zero => intro j n₁ n₂ _; exact ⟨n₁, by simp⟩
    | succ i ih =>
      intro j n₁ n₂ h
      obtain ⟨m₁, hm₁⟩ := aux j n₁ (x ^ i * n₂) (by rw [h]; ring)
      have h2 : y ^ j * m₁ = x ^ i * n₂ := by
        have h3 : x * (y ^ j * m₁ - x ^ i * n₂) = 0 := by
          rw [hm₁] at h
          linear_combination h
        exact sub_eq_zero.mp (hnzd _ h3)
      obtain ⟨m, hm⟩ := ih j m₁ n₂ h2
      exact ⟨m, by rw [hm₁, hm]; ring⟩

  have S8 : ∀ (N : Type u) [CommRing N] [IsDomain N] (x y : N), x ≠ 0 → y ≠ 0 →
      IsIntegrallyClosed (Localization (Submonoid.powers x)) →
      IsIntegrallyClosed (Localization (Submonoid.powers y)) →
      (∀ (i j : ℕ) (n₁ n₂ : N), y ^ j * n₁ = x ^ i * n₂ → ∃ m : N, n₁ = x ^ i * m) →
      IsIntegrallyClosed N := by
    intro N _ _ x y hx hy hLx hLy hcop
    have hS : ∀ i, (![Submonoid.powers x, Submonoid.powers y] : Fin 2 → Submonoid N) i ≤
        nonZeroDivisors N := by
      intro i; fin_cases i
      · exact powers_le_nonZeroDivisors_of_noZeroDivisors hx
      · exact powers_le_nonZeroDivisors_of_noZeroDivisors hy
    refine IsIntegrallyClosed.of_localization_submonoid _ hS ?_ ?_
    · intro i; fin_cases i
      · exact hLx
      · exact hLy
    · apply le_antisymm _ bot_le
      intro z hz
      rw [Algebra.mem_iInf] at hz
      obtain ⟨b, s, hs, hz1⟩ := hz 0
      obtain ⟨c, t, ht, hz2⟩ := hz 1
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at hs ht
      obtain ⟨i, rfl⟩ := hs
      obtain ⟨j, rfl⟩ := ht
      rw [hz1, IsLocalization.mk'_eq_iff_eq] at hz2
      have h3 := IsFractionRing.injective N (FractionRing N) hz2
      obtain ⟨m, hm⟩ := hcop i j b c (by simpa using h3)
      rw [Algebra.mem_bot]
      refine ⟨m, ?_⟩
      rw [hz1]
      simp only [hm]
      exact (IsLocalization.mk'_mul_cancel_left m ⟨x ^ i, _⟩).symm

  intro K _ R a ha
  set x : wcNcRing R a := Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 0) with hxdef
  set y : wcNcRing R a := Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 1) with hydef
  have hxy : x * y = algebraMap ↥R (wcNcRing R a) a := by
    rw [hxdef, hydef, ← map_mul, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq,
      Ideal.Quotient.eq]
    exact Ideal.subset_span (Set.mem_singleton _)
  have hyx : y * x = algebraMap ↥R (wcNcRing R a) a := (mul_comm y x).trans hxy
  have hnf : ∀ n : wcNcRing R a,
      (∃ F G : Polynomial ↥R, n = Polynomial.aeval x F + y * Polynomial.aeval y G) ∧
      (∃ F G : Polynomial ↥R, n = Polynomial.aeval y F + x * Polynomial.aeval x G) := by
    obtain ⟨c1, a1, mu1, mv1⟩ := S1 ↥R (wcNcRing R a) a x y hxy
    obtain ⟨c2, a2, mu2, mv2⟩ := S1 ↥R (wcNcRing R a) a y x hyx
    intro n
    obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective n
    refine MvPolynomial.induction_on (motive := fun P =>
      (∃ F G : Polynomial ↥R, Ideal.Quotient.mk (wcNcIdeal R a) P =
        Polynomial.aeval x F + y * Polynomial.aeval y G) ∧
      (∃ F G : Polynomial ↥R, Ideal.Quotient.mk (wcNcIdeal R a) P =
        Polynomial.aeval y F + x * Polynomial.aeval x G)) P ?_ ?_ ?_
    · intro r
      rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
      exact ⟨c1 r, c2 r⟩
    · intro p q hp hq
      rw [map_add]
      exact ⟨a1 _ _ hp.1 hq.1, a2 _ _ hp.2 hq.2⟩
    · intro p i hp
      rw [map_mul]
      have hi : i = 0 ∨ i = 1 := by fin_cases i <;> simp
      rcases hi with rfl | rfl
      · exact ⟨mu1 _ hp.1, mv2 _ hp.2⟩
      · exact ⟨mv1 _ hp.1, mu2 _ hp.2⟩
  have hT : LaurentPolynomial.T 1 * (LaurentPolynomial.C a * LaurentPolynomial.T (-1)) =
      (LaurentPolynomial.C a : LaurentPolynomial ↥R) := by
    rw [mul_left_comm, ← LaurentPolynomial.T_add]; simp
  have hT' : LaurentPolynomial.C a * LaurentPolynomial.T (-1) * LaurentPolynomial.T 1 =
      (LaurentPolynomial.C a : LaurentPolynomial ↥R) := by
    rw [mul_comm]; exact hT
  obtain ⟨θx, hθxC, hθxx, hθxy⟩ := S2 K R a _ _ hT
  obtain ⟨θy, hθyC, hθyx, hθyy⟩ := S2 K R a _ _ hT'

  have huniq : ∀ (u v : wcNcRing R a) (θ : wcNcRing R a →+* LaurentPolynomial ↥R),
      (∀ r : ↥R, θ (algebraMap ↥R (wcNcRing R a) r) = LaurentPolynomial.C r) →
      θ u = LaurentPolynomial.T 1 → θ v = LaurentPolynomial.C a * LaurentPolynomial.T (-1) →
      ∀ F G : Polynomial ↥R, θ (Polynomial.aeval u F + v * Polynomial.aeval v G) = 0 →
      F = 0 ∧ G = 0 := by
    intro u v θ hC hu hv F G h
    rw [S4 ↥R (wcNcRing R a) a u v θ hC hu hv F G] at h
    have hQ0 : ((Polynomial.X * G).comp (Polynomial.C a * Polynomial.X)).coeff 0 = 0 := by
      rw [Polynomial.mul_comp, Polynomial.X_comp, mul_assoc, Polynomial.coeff_C_mul,
        Polynomial.coeff_X_mul_zero, mul_zero]
    obtain ⟨hF, hQ⟩ := S3 ↥R F _ hQ0 h
    refine ⟨hF, ?_⟩
    rw [Polynomial.mul_comp, Polynomial.X_comp] at hQ
    have hCX : (Polynomial.C a * Polynomial.X : Polynomial ↥R) ≠ 0 :=
      mul_ne_zero (Polynomial.C_ne_zero.mpr ha) Polynomial.X_ne_zero
    have hGc := (mul_eq_zero.mp hQ).resolve_left hCX
    rcases Polynomial.comp_eq_zero_iff.mp hGc with hG | ⟨_, hG⟩
    · exact hG
    · exfalso
      apply hCX
      rw [hG]
      simp
  have hinj : ∀ (u v : wcNcRing R a) (θ : wcNcRing R a →+* LaurentPolynomial ↥R),
      (∀ r : ↥R, θ (algebraMap ↥R (wcNcRing R a) r) = LaurentPolynomial.C r) →
      θ u = LaurentPolynomial.T 1 → θ v = LaurentPolynomial.C a * LaurentPolynomial.T (-1) →
      (∀ n : wcNcRing R a, ∃ F G : Polynomial ↥R, n = Polynomial.aeval u F + v * Polynomial.aeval v G) →
      Function.Injective θ := by
    intro u v θ hC hu hv hn
    rw [injective_iff_map_eq_zero]
    intro n hn0
    obtain ⟨F, G, rfl⟩ := hn n
    obtain ⟨rfl, rfl⟩ := huniq u v θ hC hu hv F G hn0
    simp
  have hinjx := hinj x y θx hθxC hθxx hθxy (fun n => (hnf n).1)
  have hinjy := hinj y x θy hθyC hθyy hθyx (fun n => (hnf n).2)
  haveI hdom : IsDomain (wcNcRing R a) := Function.Injective.isDomain θx hinjx
  refine ⟨hdom, ?_⟩
  have hx0 : x ≠ 0 := by
    intro h
    have this : θx x = LaurentPolynomial.T 1 := hθxx
    rw [h, map_zero] at this
    exact (LaurentPolynomial.isUnit_T (R := ↥R) 1).ne_zero this.symm
  have hy0 : y ≠ 0 := by
    intro h
    have this : θy y = LaurentPolynomial.T 1 := hθyy
    rw [h, map_zero] at this
    exact (LaurentPolynomial.isUnit_T (R := ↥R) 1).ne_zero this.symm
  have hLx := S5 ↥R (wcNcRing R a) x θx hθxC hθxx hinjx
  have hLy := S5 ↥R (wcNcRing R a) y θy hθyC hθyy hinjy
  have hdiv := S6 ↥R (wcNcRing R a) a x y hxy (fun n => (hnf n).1)
    (fun F G h => huniq x y θx hθxC hθxx hθxy F G (by rw [h, map_zero]))
  have hcop := S7 (wcNcRing R a) x y (fun n h => (mul_eq_zero.mp h).resolve_left hx0) hdiv
  exact S8 (wcNcRing R a) x y hx0 hy0 hLx hLy hcop

theorem wcpa_dj_lus_tbw_node_zero_quot_poly : ∀ (K : Type u) [Field K] (R : ValuationSubring K) (a : ↥R), a = 0 → (∃ π : wcNcRing R a →+* Polynomial ↥R, Function.Surjective π ∧ RingHom.ker π = Ideal.span {Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 0)}) ∧ (∃ π : wcNcRing R a →+* Polynomial ↥R, Function.Surjective π ∧ RingHom.ker π = Ideal.span {Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 1)}) ∧ (∃ ε : wcNcRing R a →+* ↥R, ε.comp (algebraMap ↥R (wcNcRing R a)) = RingHom.id ↥R ∧ RingHom.ker ε = Ideal.span {Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 0), Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 1)}) :=
by
  intro K _ R a ha
  subst ha
  classical
  have hcov : ∀ n : Fin 2, n = 0 ∨ n = 1 := by decide

  have hkill : ∀ {S : Type u} [CommRing S] (Φ : MvPolynomial (Fin 2) ↥R →+* S),
      Φ (MvPolynomial.X 0) * Φ (MvPolynomial.X 1) = 0 → ∀ x ∈ wcNcIdeal R 0, Φ x = 0 := by
    intro S _ Φ hΦ x hx
    have hle : wcNcIdeal R 0 ≤ RingHom.ker Φ := by
      unfold wcNcIdeal
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      simp [hΦ]
    exact hle hx

  have crit : ∀ {S : Type u} [CommRing S] (Φ : MvPolynomial (Fin 2) ↥R →+* S)
      (hΦ : ∀ x ∈ wcNcIdeal R 0, Φ x = 0) (σ : S →+* wcNcRing R 0)
      (J : Ideal (wcNcRing R 0)),
      (∀ s, Ideal.Quotient.lift (wcNcIdeal R 0) Φ hΦ (σ s) = s) →
      J ≤ RingHom.ker (Ideal.Quotient.lift (wcNcIdeal R 0) Φ hΦ) →
      (∀ p, Ideal.Quotient.mk (wcNcIdeal R 0) p - σ (Φ p) ∈ J) →
      Function.Surjective (Ideal.Quotient.lift (wcNcIdeal R 0) Φ hΦ) ∧
        RingHom.ker (Ideal.Quotient.lift (wcNcIdeal R 0) Φ hΦ) = J := by
    intro S _ Φ hΦ σ J h1 h2 h3
    refine ⟨fun s => ⟨σ s, h1 s⟩, le_antisymm ?_ h2⟩
    intro z hz
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
    rw [RingHom.mem_ker, Ideal.Quotient.lift_mk] at hz
    have h := h3 p
    rwa [hz, map_zero, sub_zero] at h

  have partAB : ∀ (i j : Fin 2), (∀ n : Fin 2, n = i ∨ n = j) →
      ∀ Φ : MvPolynomial (Fin 2) ↥R →+* Polynomial ↥R,
      (∀ r, Φ (MvPolynomial.C r) = Polynomial.C r) → Φ (MvPolynomial.X i) = 0 →
      Φ (MvPolynomial.X j) = Polynomial.X → ∀ hΦ : ∀ x ∈ wcNcIdeal R 0, Φ x = 0,
      Function.Surjective (Ideal.Quotient.lift (wcNcIdeal R 0) Φ hΦ) ∧
        RingHom.ker (Ideal.Quotient.lift (wcNcIdeal R 0) Φ hΦ) =
          Ideal.span {Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X i)} := by
    intro i j hij Φ hC hi hj hΦ
    obtain ⟨σ, hσC, hσX⟩ : ∃ σ : Polynomial ↥R →+* wcNcRing R 0,
        (∀ r, σ (Polynomial.C r) = Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.C r)) ∧
        σ Polynomial.X = Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X j) :=
      ⟨(Ideal.Quotient.mk (wcNcIdeal R 0)).comp
        (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X j)), fun r => by simp, by simp⟩
    apply crit Φ hΦ σ
    · intro s
      have h : (Ideal.Quotient.lift (wcNcIdeal R 0) Φ hΦ).comp σ = RingHom.id _ := by
        apply Polynomial.ringHom_ext
        · intro r
          rw [RingHom.comp_apply, hσC, Ideal.Quotient.lift_mk, hC, RingHom.id_apply]
        · rw [RingHom.comp_apply, hσX, Ideal.Quotient.lift_mk, hj, RingHom.id_apply]
      exact RingHom.congr_fun h s
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
        Ideal.Quotient.lift_mk, hi]
    · intro p
      induction p using MvPolynomial.induction_on
      next r =>
        rw [hC, hσC, sub_self]
        exact Ideal.zero_mem _
      next p q hp hq =>
        simp only [map_add]
        rw [add_sub_add_comm]
        exact Ideal.add_mem _ hp hq
      next p n hp =>
        simp only [map_mul]
        rcases hij n with h | h
        · rw [h, hi, map_zero, mul_zero, sub_zero]
          exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
        · rw [h, hj, hσX, ← sub_mul]
          first
            | simpa only [mul_comm] using
                Ideal.mul_mem_left _ (Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X j)) hp
            | exact (mul_comm (Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X j)) _) ▸
                Ideal.mul_mem_left _ _ hp
            | (obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hp
               exact Ideal.mem_span_singleton'.mpr
                 ⟨c * Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X j), by rw [← hc]; ring⟩)
  obtain ⟨Φ0, hΦ0C, hΦ0a, hΦ0b⟩ : ∃ Φ : MvPolynomial (Fin 2) ↥R →+* Polynomial ↥R,
      (∀ r, Φ (MvPolynomial.C r) = Polynomial.C r) ∧ Φ (MvPolynomial.X 0) = 0 ∧
        Φ (MvPolynomial.X 1) = Polynomial.X :=
    ⟨MvPolynomial.eval₂Hom Polynomial.C ![0, Polynomial.X], fun r => by simp, by simp, by simp⟩
  obtain ⟨Φ1, hΦ1C, hΦ1a, hΦ1b⟩ : ∃ Φ : MvPolynomial (Fin 2) ↥R →+* Polynomial ↥R,
      (∀ r, Φ (MvPolynomial.C r) = Polynomial.C r) ∧ Φ (MvPolynomial.X 0) = Polynomial.X ∧
        Φ (MvPolynomial.X 1) = 0 :=
    ⟨MvPolynomial.eval₂Hom Polynomial.C ![Polynomial.X, 0], fun r => by simp, by simp, by simp⟩
  have k0 := hkill Φ0 (by rw [hΦ0a, zero_mul])
  have k1 := hkill Φ1 (by rw [hΦ1b, mul_zero])

  obtain ⟨E, hEC, hE0, hE1⟩ : ∃ E : MvPolynomial (Fin 2) ↥R →+* ↥R,
      (∀ r, E (MvPolynomial.C r) = r) ∧ E (MvPolynomial.X 0) = 0 ∧ E (MvPolynomial.X 1) = 0 :=
    ⟨MvPolynomial.eval₂Hom (RingHom.id ↥R) ![0, 0], fun r => by simp, by simp, by simp⟩
  have kE := hkill E (by rw [hE0, zero_mul])
  have halg : ∀ r : ↥R, algebraMap ↥R (wcNcRing R 0) r =
      Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.C r) := by
    intro r
    first
      | rfl
      | (rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap])
      | (show algebraMap ↥R (MvPolynomial (Fin 2) ↥R ⧸ wcNcIdeal R 0) r = _
         rw [Ideal.Quotient.algebraMap_eq, RingHom.comp_apply, MvPolynomial.algebraMap_eq])
  have hsec : (Ideal.Quotient.lift (wcNcIdeal R 0) E kE).comp
      (algebraMap ↥R (wcNcRing R 0)) = RingHom.id ↥R := by
    apply RingHom.ext
    intro r
    rw [RingHom.comp_apply, halg, Ideal.Quotient.lift_mk, hEC, RingHom.id_apply]
  have hEX : ∀ n : Fin 2, E (MvPolynomial.X n) = 0 := by
    intro n
    rcases hcov n with h | h
    · rw [h, hE0]
    · rw [h, hE1]
  obtain ⟨-, hkerE⟩ := crit E kE (algebraMap ↥R (wcNcRing R 0))
    (Ideal.span {Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X 0),
      Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X 1)})
    (fun s => RingHom.congr_fun hsec s)
    (by
      rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
      refine ⟨?_, ?_⟩
      · rw [SetLike.mem_coe, RingHom.mem_ker, Ideal.Quotient.lift_mk, hE0]
      · rw [SetLike.mem_coe, RingHom.mem_ker, Ideal.Quotient.lift_mk, hE1])
    (by
      intro p
      induction p using MvPolynomial.induction_on
      next r =>
        rw [hEC, halg, sub_self]
        exact Ideal.zero_mem _
      next p q hp hq =>
        simp only [map_add]
        rw [add_sub_add_comm]
        exact Ideal.add_mem _ hp hq
      next p n _ =>
        simp only [map_mul]
        rw [hEX n, map_zero, mul_zero, sub_zero]
        apply Ideal.mul_mem_left
        rcases hcov n with h | h
        · rw [h]
          exact Ideal.subset_span (Set.mem_insert _ _)
        · rw [h]
          exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
  exact ⟨⟨_, partAB 0 1 hcov Φ0 hΦ0C hΦ0a hΦ0b k0⟩,
    ⟨_, partAB 1 0 (fun n => (hcov n).symm) Φ1 hΦ1C hΦ1b hΦ1a k1⟩,
    ⟨_, hsec, hkerE⟩⟩

theorem wcpa_dj_lus_tbw_node_zero_torsionfree : ∀ (R N T : Type u) [CommRing R] [IsDomain R] [CommRing N] [Algebra R N] [CommRing T] [Algebra N T] [Algebra.Etale N T] (q : Ideal T) [q.IsPrime] (x₀ x₁ : N) (ε : N →+* R), ε.comp (algebraMap R N) = RingHom.id R → RingHom.ker ε = Ideal.span {x₀, x₁} → algebraMap N T x₀ ∈ q → algebraMap N T x₁ ∈ q → ∀ r : R, r ≠ 0 → algebraMap T (Localization.AtPrime q) (algebraMap N T (algebraMap R N r)) ∉ Ideal.span {algebraMap T (Localization.AtPrime q) (algebraMap N T x₀), algebraMap T (Localization.AtPrime q) (algebraMap N T x₁)} :=
by
  intro R N T _ _ _ _ _ _ _ q _ x₀ x₁ ε hcomp hker h₀ h₁ r hr hmem
  have e : ∀ n : N, algebraMap T (Localization.AtPrime q) (algebraMap N T n) =
      algebraMap N (Localization.AtPrime q) n := fun n =>
    (IsScalarTower.algebraMap_apply N T (Localization.AtPrime q) n).symm
  rw [e, e, e] at hmem
  obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp hmem
  have : Module.Flat N (Localization.AtPrime q) := inferInstance
  obtain ⟨k, α, y, hA, hC⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
    (R := N) (M := Localization.AtPrime q) (f := ![algebraMap R N r, -x₀, -x₁])
    (x := ![1, a, b]) (by
      simp only [Fin.sum_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
        Matrix.cons_val_two, Matrix.tail_cons, Algebra.smul_def, map_neg, mul_one]
      rw [← hab]; ring)
  have hε0 : ε x₀ = 0 := by
    rw [← RingHom.mem_ker, hker]; exact Ideal.subset_span (Set.mem_insert _ _)
  have hε1 : ε x₁ = 0 := by
    rw [← RingHom.mem_ker, hker]; exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
  have hεr : ε (algebraMap R N r) = r := by
    have := RingHom.congr_fun hcomp r
    simpa using this
  have hm0 : algebraMap N (Localization.AtPrime q) x₀ ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
    rw [← e]
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime q) q _).mpr h₀
  have hm1 : algebraMap N (Localization.AtPrime q) x₁ ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
    rw [← e]
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime q) q _).mpr h₁
  have hα : ∀ j, algebraMap N (Localization.AtPrime q) (α 0 j) ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
    intro j
    have h := hC j
    simp only [Fin.sum_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
      Matrix.cons_val_two, Matrix.tail_cons] at h
    have h2 := congrArg ε h
    simp only [map_add, map_mul, map_neg, map_zero, hε0, hε1, hεr, zero_mul, neg_zero,
      add_zero] at h2
    have h3 : ε (α 0 j) = 0 := (mul_eq_zero.mp h2).resolve_left hr
    have h4 : α 0 j ∈ Ideal.span {x₀, x₁} := by rw [← hker]; exact h3
    obtain ⟨c, d, hcd⟩ := Ideal.mem_span_pair.mp h4
    rw [← hcd, map_add, map_mul, map_mul]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hm0) (Ideal.mul_mem_left _ _ hm1)
  have h1 : (1 : Localization.AtPrime q) ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
    have h := hA 0
    simp only [Matrix.cons_val_zero] at h
    rw [h]
    exact Ideal.sum_mem _ (fun j _ => by
      rw [Algebra.smul_def]; exact Ideal.mul_mem_right _ _ (hα j))
  exact (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime q)).ne_top
    ((Ideal.eq_top_iff_one _).mpr h1)

theorem wcpa_dj_lus_cvs_ct_fcn_nc_chart_stalk_iso : ∀ (S : Type u) [CommRing S] (Y : Scheme.{u}) (v : Y ⟶ Spec (.of S)) (U : Scheme.{u}) (e : U ⟶ Y) (N : Type u) [CommRing N] [Algebra S N] (m : U ⟶ Spec (.of N)) (x' : U), Etale e → Etale m → m ≫ Spec.map (CommRingCat.ofHom (algebraMap S N)) = e ≫ v → ∃ (T : Type u) (_ : CommRing T) (_ : Algebra N T) (_ : Algebra.Etale N T) (q : Ideal T) (_ : q.IsPrime) (j : U.presheaf.stalk x' ≃+* Localization.AtPrime q), (j.toRingHom.comp (e.stalkMap x').hom).Flat ∧ IsLocalHom (j.toRingHom.comp (e.stalkMap x').hom) ∧ (j.toRingHom.comp (e.stalkMap x').hom).comp ((Scheme.ΓSpecIso (.of S)).inv ≫ v.appTop ≫ Y.presheaf.germ ⊤ (e x') trivial).hom = (algebraMap T (Localization.AtPrime q)).comp ((algebraMap N T).comp (algebraMap S N)) ∧ ∀ n : N, n ∈ (m x').asIdeal → algebraMap N T n ∈ q :=
by
  intro S _ Y v U e N _ _ m x' he hm hcomm
  classical
  obtain ⟨V, hV, hx', -⟩ := exists_isAffineOpen_mem_and_subset (x := x') (U := ⊤) trivial
  have hle : V ≤ m ⁻¹ᵁ ⊤ := by simp
  set τ : N →+* Γ(U, V) := ((Scheme.ΓSpecIso (.of N)).inv ≫ m.appLE ⊤ V hle).hom with hτdef
  have hτ : τ.Etale := by
    have h1 : (m.appLE ⊤ V hle).hom.Etale :=
      HasRingHomProperty.appLE @Etale m hm ⟨⊤, isAffineOpen_top _⟩ ⟨V, hV⟩ hle
    have h2 : (Scheme.ΓSpecIso (.of N)).inv.hom.Etale :=
      RingHom.Etale.of_bijective (Scheme.ΓSpecIso (.of N)).symm.commRingCatIsoToRingEquiv.bijective
    rw [hτdef, CommRingCat.hom_comp]
    exact RingHom.Etale.stableUnderComposition _ _ h2 h1
  set P := hV.primeIdealOf ⟨x', hx'⟩ with hP
  have hcomap : (m x').asIdeal = Ideal.comap τ P.asIdeal := by
    have h1 := IsAffineOpen.SpecMap_appLE_fromSpec m (isAffineOpen_top (Spec (.of N))) hV hle
    let P' : ↥(Spec Γ(U, V)) := hV.primeIdealOf ⟨x', hx'⟩
    have h2 := congrArg (fun f : Spec Γ(U, V) ⟶ Spec (.of N) => f P') h1
    simp only [Scheme.Hom.comp_apply] at h2
    have h3 : hV.fromSpec P' = x' := IsAffineOpen.fromSpec_primeIdealOf hV ⟨x', hx'⟩
    rw [h3, IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv] at h2
    rw [← h2]
    rfl
  letI : Algebra Γ(U, V) (U.presheaf.stalk x') :=
    TopCat.Presheaf.algebra_section_stalk U.presheaf ⟨x', hx'⟩
  haveI := hV.isLocalization_stalk ⟨x', hx'⟩
  let j0 := IsLocalization.algEquiv P.asIdeal.primeCompl (U.presheaf.stalk x')
    (Localization.AtPrime P.asIdeal)
  have hj : ∀ t : Γ(U, V), j0 ((U.presheaf.germ V x' hx').hom t) =
      algebraMap Γ(U, V) (Localization.AtPrime P.asIdeal) t := fun t => j0.commutes t
  have hR : m.appLE ⊤ V hle ≫ U.presheaf.germ V x' hx' =
      m.appTop ≫ U.presheaf.germ ⊤ x' trivial := by
    rw [Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
    rfl
  have hL : Y.presheaf.germ ⊤ (e x') trivial ≫ e.stalkMap x' =
      e.appTop ≫ U.presheaf.germ ⊤ x' trivial :=
    Scheme.Hom.germ_stalkMap e ⊤ x' trivial
  have hC : (Scheme.ΓSpecIso (.of S)).inv ≫ v.appTop ≫ e.appTop =
      CommRingCat.ofHom (algebraMap S N) ≫ (Scheme.ΓSpecIso (.of N)).inv ≫ m.appTop := by
    rw [← Scheme.Hom.comp_appTop, ← hcomm, Scheme.Hom.comp_appTop, ← Category.assoc,
      ← Scheme.ΓSpecIso_inv_naturality, Category.assoc]
  have hcat : (Scheme.ΓSpecIso (.of S)).inv ≫ v.appTop ≫ Y.presheaf.germ ⊤ (e x') trivial ≫
      e.stalkMap x' = CommRingCat.ofHom (algebraMap S N) ≫ (Scheme.ΓSpecIso (.of N)).inv ≫
      m.appLE ⊤ V hle ≫ U.presheaf.germ V x' hx' := by
    rw [hL, hR]
    have := congrArg (· ≫ U.presheaf.germ ⊤ x' trivial) hC
    simpa only [Category.assoc] using this
  letI : Algebra N Γ(U, V) := τ.toAlgebra
  haveI : Algebra.Etale N Γ(U, V) := RingHom.Etale.toAlgebra hτ
  refine ⟨Γ(U, V), inferInstance, inferInstance, inferInstance, P.asIdeal, P.isPrime,
    j0.toRingEquiv, ?_, ?_, ?_, ?_⟩
  · exact RingHom.Flat.comp (Flat.stalkMap e x') (RingHom.Flat.of_bijective j0.bijective)
  · change IsLocalHom ((j0.toRingEquiv : U.presheaf.stalk x' →+* Localization.AtPrime P.asIdeal).comp
      (e.stalkMap x').hom)
    infer_instance
  · ext s
    exact (congrArg j0 (RingHom.congr_fun (congrArg CommRingCat.Hom.hom hcat) s)).trans (hj _)
  · intro n hn
    rw [hcomap] at hn
