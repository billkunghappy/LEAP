theorem wcpa_dj_lfc_afcaf_gnu_chart_off_vertex_smooth : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (a : ↥W) (i : Fin 2) (O : (Spec (.of (wcNcRing W a))).Opens), (∀ p : Spec (.of (wcNcRing W a)), p ∈ O ↔ Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X i) ∉ p.asIdeal) → SmoothOfRelativeDimension 1 (O.ι ≫ wcNcStr W a) :=
