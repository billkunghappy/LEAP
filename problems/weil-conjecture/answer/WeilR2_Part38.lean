          rw [← e1, ← Category.assoc s.fst, hs, Category.assoc s.snd, hzb1]
        have hl1 := hpb.lift_fst (s.fst ≫ Limits.pullback.fst v b) (s.snd ≫ b) h1
        have hl2 := hpb.lift_snd (s.fst ≫ Limits.pullback.fst v b) (s.snd ≫ b) h1
        rw [Category.comp_id] at hl2
        rw [Category.assoc, hsb1, ← Category.assoc, ← hl2, hl1]
      · have h3 : s.fst ≫ fb ≫ Limits.pullback.snd π b = s.snd ≫ zb ≫ Limits.pullback.snd π b := by
          rw [← Category.assoc, hs, Category.assoc]
        rw [e2, hzb2, Category.comp_id] at h3
        rw [Category.assoc, hsb2, Category.comp_id, h3]
    · intro s; exact Category.comp_id _
    · intro s m _ h2; rw [Category.comp_id] at h2; exact h2

  have key : ∀ (K : Type u) [Field K] (g : wcProjK K 1 ⟶ wcProjK K 1)
      (p q : Spec (.of K) ⟶ wcProjK K 1), g ≫ wcProjKStr K 1 = wcProjKStr K 1 →
      q ≫ wcProjKStr K 1 = 𝟙 _ → IsPullback p (𝟙 _) g q → IsIso g := by
    intro K _ g p q hg hq hpb
    haveI hprop : IsProper (wcProjKStr K 1) := wc_proj_space_isProper K 1
    haveI hirr : IrreducibleSpace ↥(wcProjK K 1) := wc_proj_space_irreducible K 1
    have hdim := wc_proj_space_dim K 1

    haveI hstred : ∀ x : wcProjK K 1, _root_.IsReduced ((wcProjK K 1).presheaf.stalk x) :=
      fun x => by
        haveI := (wc_projK_one_stalk_normal K x).1
        infer_instance
    haveI hred : AlgebraicGeometry.IsReduced (wcProjK K 1) := isReduced_of_isReduced_stalk _
    haveI hint : AlgebraicGeometry.IsIntegral (wcProjK K 1) :=
      isIntegral_of_irreducibleSpace_of_isReduced _

    haveI : IsClosedImmersion (q ≫ wcProjKStr K 1) := by rw [hq]; infer_instance
    haveI hqci : IsClosedImmersion q := IsClosedImmersion.of_comp q (wcProjKStr K 1)
    haveI : IsProper (g ≫ wcProjKStr K 1) := by rw [hg]; exact hprop
    haveI hgprop : IsProper g := IsProper.of_comp g (wcProjKStr K 1)

    have s3 : ∀ y : ↥(wcProjK K 1), IsClosed ({y} : Set ↥(wcProjK K 1)) ∨
        closure ({y} : Set ↥(wcProjK K 1)) = Set.univ := by
      intro y
      by_contra hcon
      push_neg at hcon
      obtain ⟨hncl, hnd⟩ := hcon
      obtain ⟨z, hz, hzy⟩ : ∃ z ∈ closure ({y} : Set ↥(wcProjK K 1)), z ≠ y := by
        by_contra h
        push_neg at h
        apply hncl
        have he : closure ({y} : Set ↥(wcProjK K 1)) = {y} :=
          Set.Subset.antisymm (fun w hw => h w hw) subset_closure
        rw [← he]
        exact isClosed_closure
      let A : TopologicalSpace.IrreducibleCloseds ↥(wcProjK K 1) :=
        ⟨closure {z}, isIrreducible_singleton.closure, isClosed_closure⟩
      let B : TopologicalSpace.IrreducibleCloseds ↥(wcProjK K 1) :=
        ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
      let C : TopologicalSpace.IrreducibleCloseds ↥(wcProjK K 1) :=
        ⟨Set.univ, IrreducibleSpace.isIrreducible_univ _, isClosed_univ⟩
      have hAB : A < B := by
        refine lt_of_le_of_ne ?_ ?_
        · show closure {z} ⊆ closure {y}
          exact closure_minimal (Set.singleton_subset_iff.mpr hz) isClosed_closure
        · intro h
          have h' : closure ({z} : Set ↥(wcProjK K 1)) = closure {y} :=
            congrArg TopologicalSpace.IrreducibleCloseds.carrier h
          exact hzy ((inseparable_iff_closure_eq.mpr h').eq)
      have hBC : B < C := by
        refine lt_of_le_of_ne (fun x _ => Set.mem_univ x) ?_
        intro h
        exact hnd (congrArg TopologicalSpace.IrreducibleCloseds.carrier h)
      have hle : topologicalKrullDim ↥(wcProjK K 1) ≤ 1 := by rw [hdim]; norm_num
      rcases (Order.krullDim_le_one_iff
          (α := TopologicalSpace.IrreducibleCloseds ↥(wcProjK K 1))).mp hle B with h | h
      · exact h.not_lt hAB
      · exact h.not_lt hBC

    have hNG : ∀ y : ↥(wcProjK K 1), y ≠ genericPoint ↥(wcProjK K 1) →
        IsClosed ({y} : Set ↥(wcProjK K 1)) := by
      intro y hy
      rcases s3 y with h | h
      · exact h
      · exact absurd ((isGenericPoint_def.mpr h).eq (genericPoint_spec _)) hy

    have s5 : ∀ y : ↥(wcProjK K 1), ValuationRing ((wcProjK K 1).presheaf.stalk y) := by
      intro y
      by_cases hy : y = genericPoint ↥(wcProjK K 1)
      · subst hy
        exact ValuationRing.of_field _
      · haveI := wc_curve_stalk_dvr K (wcProjK K 1) (wcProjKStr K 1)
          (fun x => (wc_projK_one_stalk_normal K x).2) hNG y hy
        exact (ValuationRing.iff_local_bezout_domain).mpr
          ⟨inferInstance, IsBezout.of_isPrincipalIdealRing _⟩

    obtain ⟨pt⟩ : Nonempty ↥(Spec (.of K)) := inferInstance
    have hq' : p ≫ g = q := by simpa using hpb.w
    have e₀ : g (p pt) = q pt := by rw [← Scheme.Hom.comp_apply, hq']
    have hfib : ∀ x : ↥(wcProjK K 1), g x = q pt → x = p pt := by
      intro x hx
      have hmem : x ∈ Set.range (Limits.pullback.fst g q) := by
        rw [Scheme.Pullback.range_fst]; exact ⟨pt, hx.symm⟩
      obtain ⟨w, hw⟩ := hmem
      have h1 : p (hpb.isoPullback.inv w) = x := by
        rw [← Scheme.Hom.comp_apply, hpb.isoPullback_inv_fst]; exact hw
      rw [← h1, Subsingleton.elim (hpb.isoPullback.inv w) pt]
    obtain ⟨_, hker⟩ := wc_ldnm_tvj_pullback_stalk p (𝟙 _) g q hpb hqci pt pt rfl e₀
    have hR : IsLocalRing.maximalIdeal ((Spec (.of K)).presheaf.stalk pt) = ⊥ := by
      haveI : pt.asIdeal.IsPrime := pt.isPrime
      have hx : pt.asIdeal = ⊥ := Ideal.eq_bot_of_prime _
      have h1 : IsField (Localization.AtPrime pt.asIdeal) := by
        rw [IsLocalRing.isField_iff_maximalIdeal_eq,
          ← IsLocalization.AtPrime.map_eq_maximalIdeal pt.asIdeal (Localization.AtPrime pt.asIdeal)]
        refine le_bot_iff.mp (Ideal.map_le_iff_le_comap.mpr ?_)
        intro a ha
        have ha0 : a = 0 := by
          have : a ∈ (⊥ : Ideal K) := hx ▸ ha
          exact (Ideal.mem_bot.mp this)
        rw [ha0]
        exact Ideal.zero_mem _
      exact IsLocalRing.isField_iff_maximalIdeal_eq.mp
        (MulEquiv.isField h1 (Spec.stalkIso (.of K) pt).commRingCatIsoToRingEquiv.toMulEquiv)
    have hkerloc : ∀ {A : Type u} [CommRing A] [IsLocalRing A]
        (φ : A →+* (Spec (.of K)).presheaf.stalk pt), IsLocalHom φ →
        RingHom.ker φ = IsLocalRing.maximalIdeal A := by
      intro A _ _ φ hφ
      rw [RingHom.ker_eq_comap_bot, ← hR]
      exact ((IsLocalRing.local_hom_TFAE φ).out 1 5).mp hφ
    have hp_ker : RingHom.ker (p.stalkMap pt).hom = IsLocalRing.maximalIdeal _ :=
      hkerloc _ inferInstance
    have hq_ker : RingHom.ker (q.stalkMap pt).hom = IsLocalRing.maximalIdeal _ :=
      hkerloc _ inferInstance
    have hm : Ideal.map (wcLdnmTvRho g (p pt) (q pt) e₀)
        (IsLocalRing.maximalIdeal ((wcProjK K 1).presheaf.stalk (q pt))) =
        IsLocalRing.maximalIdeal ((wcProjK K 1).presheaf.stalk (p pt)) := by
      rw [← hp_ker, ← hq_ker, hker]
    have hC : (wcProjK K 1).presheaf.stalkSpecializes (specializes_of_eq e₀) ≫
        g.stalkMap (p pt) ≫ p.stalkMap pt = q.stalkMap pt := by
      rw [Scheme.Hom.stalkMap_congr_hom q (p ≫ g) hq'.symm pt, Scheme.Hom.stalkMap_comp,
        TopCat.Presheaf.stalkCongr_hom]
      rfl
    have hC' : ∀ b, (p.stalkMap pt).hom (wcLdnmTvRho g (p pt) (q pt) e₀ b) =
        (q.stalkMap pt).hom b := by
      intro b
      rw [← hC]
      rfl
    have hres : ∀ a : (wcProjK K 1).presheaf.stalk (p pt),
        ∃ b : (wcProjK K 1).presheaf.stalk (q pt),
        a - wcLdnmTvRho g (p pt) (q pt) e₀ b ∈
          IsLocalRing.maximalIdeal ((wcProjK K 1).presheaf.stalk (p pt)) := by
      intro a
      obtain ⟨b, hb⟩ := Scheme.Hom.stalkMap_surjective q pt ((p.stalkMap pt).hom a)
      refine ⟨b, ?_⟩
      rw [← hp_ker, RingHom.mem_ker, map_sub, hC', hb, sub_self]

    obtain ⟨U₁, hyU₁, -, hfin⟩ :=
      wc_tvs_finite_near g ⊤ inferInstance (p pt) (q pt) e₀ trivial hfib hm hres
    obtain ⟨V, hyV, -, hci⟩ :=
      wc_tvs_closed_imm_of_finite g U₁ hfin (p pt) (q pt) e₀ hyU₁ hfib hm hres
    haveI := hci

    obtain ⟨η, hη⟩ : ∃ η : ↥(wcProjK K 1), IsGenericPoint η Set.univ :=
      ⟨_, genericPoint_spec _⟩
    have hdense : closure ({g η} : Set ↥(wcProjK K 1)) = Set.univ := by
      rcases s3 (g η) with h | h
      · exfalso
        have hall : ∀ x : ↥(wcProjK K 1), g x = g η := by
          intro x
          have hsp : η ⤳ x := hη.specializes (Set.mem_univ x)
          have h2 : g η ⤳ g x := hsp.map g.continuous
          have h3 : g x ∈ closure ({g η} : Set ↥(wcProjK K 1)) :=
            specializes_iff_mem_closure.mp h2
          rw [h.closure_eq] at h3
          exact h3
        have hsub : ∀ x : ↥(wcProjK K 1), x = p pt :=
          fun x => hfib x ((hall x).trans ((hall (p pt)).symm.trans e₀))
        haveI : Subsingleton ↥(wcProjK K 1) := ⟨fun a b => (hsub a).trans (hsub b).symm⟩
        haveI : Subsingleton (TopologicalSpace.IrreducibleCloseds ↥(wcProjK K 1)) := by
          constructor
          intro A B
          apply TopologicalSpace.IrreducibleCloseds.ext
          obtain ⟨a, ha⟩ := A.isIrreducible.nonempty
          obtain ⟨b, hb⟩ := B.isIrreducible.nonempty
          ext x
          constructor
          · intro _; rw [Subsingleton.elim x b]; exact hb
          · intro _; rw [Subsingleton.elim x a]; exact ha
        have h0 : topologicalKrullDim ↥(wcProjK K 1) ≤ 0 :=
          Order.krullDim_nonpos_of_subsingleton
        rw [hdim] at h0
        norm_num at h0
      · exact h
    have hgη : IsGenericPoint (g η) Set.univ := isGenericPoint_def.mpr hdense
    have hgsurj : Surjective g := by
      constructor
      have hcl : IsClosed (Set.range g) := g.isClosedMap.isClosed_range
      intro x
      exact (hgη.specializes (Set.mem_univ x)).mem_closed hcl ⟨η, rfl⟩
    haveI hsurjV : Surjective (g ∣_ V) :=
      MorphismProperty.of_isPullback (P := @Surjective) (isPullback_morphismRestrict g V).flip hgsurj
    haveI : AlgebraicGeometry.IsReduced V.toScheme := isReduced_of_isOpenImmersion V.ι
    haveI : IsIso (g ∣_ V) := isIso_of_isClosedImmersion_of_surjective (g ∣_ V)
    have hVne : V ≠ ⊥ := by
      rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]; exact ⟨q pt, hyV⟩
    exact wcpa_dj_sgt_birational_iso_valuative _ _ g V hVne inferInstance s5

  rintro Ω _ _ W Y v sY ⟨θκ, hθκ⟩ f z hf hz hpb fκ e₁ e₂
  obtain ⟨sκ, zκ, hzκ, hκ⟩ := s1 v _ _ f sY z hf hz hpb fκ e₁ e₂
  obtain ⟨e, he, heS⟩ := wcpa_dj_lpm_proj_space_bc_iso (↥W) (IsLocalRing.ResidueField ↥W) 1
  haveI := he
  have h1 : θκ.inv ≫ Limits.pullback.snd v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) =
      wcProjKStr (IsLocalRing.ResidueField ↥W) 1 := by
    rw [← hθκ, Iso.inv_hom_id_assoc]
  have hg : (θκ.inv ≫ fκ ≫ e) ≫ wcProjKStr (IsLocalRing.ResidueField ↥W) 1 =
      wcProjKStr (IsLocalRing.ResidueField ↥W) 1 := by
    rw [Category.assoc, Category.assoc, heS, e₂, h1]
  have hq : (zκ ≫ e) ≫ wcProjKStr (IsLocalRing.ResidueField ↥W) 1 = 𝟙 _ := by
    rw [Category.assoc, heS, hzκ]
  have hpb' : IsPullback (sκ ≫ θκ.hom) (𝟙 _) (θκ.inv ≫ fκ ≫ e) (zκ ≫ e) := by
    refine IsPullback.of_iso hκ (Iso.refl _) θκ (Iso.refl _) (asIso e) ?_ ?_ ?_ ?_
    · rw [Iso.refl_hom, Category.id_comp]
    · rw [Iso.refl_hom, Category.id_comp]
    · rw [asIso_hom, Iso.hom_inv_id_assoc]
    · rw [asIso_hom, Iso.refl_hom, Category.id_comp]
  have hiso := key (IsLocalRing.ResidueField ↥W) (θκ.inv ≫ fκ ≫ e) (sκ ≫ θκ.hom) (zκ ≫ e)
    hg hq hpb'
  haveI hiso' : IsIso (θκ.inv ≫ fκ ≫ e) := hiso
  have hfκ : fκ = θκ.hom ≫ (θκ.inv ≫ fκ ≫ e) ≫ inv e := by
    rw [Category.assoc, Category.assoc, IsIso.hom_inv_id, Category.comp_id,
      Iso.hom_inv_id_assoc]
  rw [hfκ]
  infer_instance

theorem wcpa_dj_lfc_ni_p1_rigid : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥W)) (sY : Spec (.of ↥W) ⟶ Y), IsProper v → Flat v → LocallyOfFinitePresentation v → sY ≫ v = 𝟙 _ → (∃ θκ : Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W)) MvPolynomial.gradedAlgebra, θκ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W)) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField ↥W) ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W) 0))) = Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) → ∃ θ : Y ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) ↥W) MvPolynomial.gradedAlgebra, θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin 2) ↥W 0))) = v :=
by
  intro Ω _ _ W Y v sY hP hF hL hs hθ
  haveI := hP
  have hsm := wcpa_dj_p1r_smooth Ω W Y v hP hF hL hθ
  obtain ⟨L, t, hOK, hCt, hgen⟩ := wcpa_dj_p1r_divisor_eq v sY inferInstance inferInstance
    inferInstance hs (fun q => hsm (sY q))
  have hH := wcpa_dj_p1r_h1_vanish Ω W Y v hP hF hL hθ L hOK
  obtain ⟨s, hCs, hsD⟩ := wcpa_dj_p1r_section_lift ↥W Y v sY inferInstance hs L t hOK hCt hgen hH
  obtain ⟨f, z, hf, hz, hpb⟩ := wcpa_dj_p1r_map_to_P1 ↥W Y v sY inferInstance hs L t s hOK hCt hCs
    hgen hsD
  let fκ := Limits.pullback.map v
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
    (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) ↥W)
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin 2) ↥W 0))))
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
    f (𝟙 _) (𝟙 _) (by rw [Category.comp_id, hf]) (by rw [Category.comp_id, Category.id_comp])
  have e₁ : fκ ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ ≫ f :=
    Limits.pullback.lift_fst _ _ _
  have e₂ : fκ ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ := by
    rw [Limits.pullback.lift_snd, Category.comp_id]
  have hκ := wcpa_dj_p1r_closed_fibre_iso Ω W Y v sY hθ f z hf hz hpb fκ e₁ e₂
  haveI := wcpa_dj_p1r_fibre_iso ↥W Y v f hP hF hL hf fκ e₁ e₂ hκ
  exact ⟨asIso f, hf⟩

theorem wcpa_dj_lfc_ni_clopen_p1_component : ∀ (A : Type u) [CommRing A] (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of A)) (C : Z₁.Opens) (θ : C.toScheme ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra), θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0))) = C.ι ≫ u₁ → IsClopen (C : Set Z₁) → ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ Spec (.of A)), IsReduced (Limits.pullback u₁ s) → ⇑(Limits.pullback.fst u₁ s) ⁻¹' (C : Set Z₁) ∈ irreducibleComponents ↥(Limits.pullback u₁ s) ∧ IsClopen (⇑(Limits.pullback.fst u₁ s) ⁻¹' (C : Set Z₁)) ∧ ∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback u₁ s) (θK : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra), IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = ⇑(Limits.pullback.fst u₁ s) ⁻¹' (C : Set Z₁) ∧ θK.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = ι ≫ Limits.pullback.snd u₁ s :=
by
  intro A _ Z₁ u₁ C θ hθ hclo K _ s hred
  classical
  have hE : IsClopen (⇑(Limits.pullback.fst u₁ s) ⁻¹' (C : Set Z₁)) :=
    hclo.preimage (Limits.pullback.fst u₁ s).continuous
  have hrange : Set.range (Limits.pullback.fst u₁ s ⁻¹ᵁ C).ι =
      ⇑(Limits.pullback.fst u₁ s) ⁻¹' (C : Set Z₁) := by
    rw [Scheme.Opens.range_ι]; rfl
  haveI hci : IsClosedImmersion (Limits.pullback.fst u₁ s ⁻¹ᵁ C).ι :=
    IsClosedImmersion.of_isPreimmersion _ (by rw [hrange]; exact hE.isClosed)
  haveI := hred
  haveI hOred : IsReduced (Limits.pullback.fst u₁ s ⁻¹ᵁ C).toScheme :=
    isReduced_of_isOpenImmersion (Limits.pullback.fst u₁ s ⁻¹ᵁ C).ι

  have P1 : IsPullback (Limits.pullback.fst u₁ s ∣_ C) (Limits.pullback.fst u₁ s ⁻¹ᵁ C).ι
      C.ι (Limits.pullback.fst u₁ s) := isPullback_morphismRestrict _ C
  have P2 : IsPullback (Limits.pullback.fst u₁ s) (Limits.pullback.snd u₁ s) u₁ s :=
    IsPullback.of_hasPullback u₁ s
  have P3 := P1.paste_vert P2
  have P4 : IsPullback ((Limits.pullback.fst u₁ s ∣_ C) ≫ θ.hom)
      ((Limits.pullback.fst u₁ s ⁻¹ᵁ C).ι ≫ Limits.pullback.snd u₁ s)
      (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A)
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0)))) s :=
    P3.of_iso (Iso.refl _) θ (Iso.refl _) (Iso.refl _)
      (by rw [Iso.refl_hom, Category.id_comp])
      (by rw [Iso.refl_hom, Iso.refl_hom, Category.id_comp, Category.comp_id])
      (by rw [Iso.refl_hom, Category.comp_id]; exact hθ.symm)
      (by rw [Iso.refl_hom, Iso.refl_hom, Category.id_comp, Category.comp_id])
  have hβ := P4.isoPullback_hom_snd

  have hbc : ∀ s' : Spec (.of K) ⟶ Spec (.of A), ∃ e : Limits.pullback
      (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A)
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0)))) s' ≅
      @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra,
      e.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
      Limits.pullback.snd _ _ := by
    intro s'
    obtain ⟨φ, rfl⟩ : ∃ φ, Spec.map φ = s' := ⟨Spec.preimage s', Spec.map_preimage s'⟩
    letI : Algebra A K := φ.hom.toAlgebra
    obtain ⟨e, he, heq⟩ := wcpa_dj_lpm_proj_space_bc_iso A K 1
    haveI := he
    exact ⟨asIso e, heq⟩
  obtain ⟨e, he⟩ := hbc s
  let θK := P4.isoPullback ≪≫ e
  have hθK : θK.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
      (Limits.pullback.fst u₁ s ⁻¹ᵁ C).ι ≫ Limits.pullback.snd u₁ s := by
    simp only [θK, Iso.trans_hom, Category.assoc]
    rw [he, hβ]

  haveI hP1irr : IrreducibleSpace ↥(@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
      MvPolynomial.gradedAlgebra) := wc_proj_space_irreducible K 1
  have hirr : IsIrreducible (⇑(Limits.pullback.fst u₁ s) ⁻¹' (C : Set Z₁)) := by
    have h1 := (IrreducibleSpace.isIrreducible_univ _).image
      (θK.inv ≫ (Limits.pullback.fst u₁ s ⁻¹ᵁ C).ι)
      (θK.inv ≫ (Limits.pullback.fst u₁ s ⁻¹ᵁ C).ι).continuous.continuousOn
    convert h1 using 1
    rw [← hrange]
    ext x
    constructor
    · rintro ⟨z, rfl⟩
      obtain ⟨y, rfl⟩ := θK.inv.surjective z
      exact ⟨y, trivial, by rw [Scheme.Hom.comp_apply]⟩
    · rintro ⟨y, -, rfl⟩
      exact ⟨θK.inv y, (Scheme.Hom.comp_apply _ _ _).symm⟩
  have hcomp : ⇑(Limits.pullback.fst u₁ s) ⁻¹' (C : Set Z₁) ∈
      irreducibleComponents ↥(Limits.pullback u₁ s) := by
    refine ⟨hirr, fun F hF hEF => ?_⟩
    obtain ⟨x, hx⟩ := hirr.nonempty
    exact hF.isPreirreducible.isPreconnected.subset_isClopen hE ⟨x, hEF hx, hx⟩
  exact ⟨hcomp, hE, _, _, θK, hci, hOred, hrange, hθK⟩

theorem wcpa_dj_lfc_not_isolated : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (k : ℕ)
    (σ : Fin (k + 1) → (Spec (.of ↥W) ⟶ Z₁))
    (E₀ : Set ↥(Limits.pullback u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))),
    wcpaDjStablePtd u₁ (k + 1) σ →
    E₀ ∈ irreducibleComponents ↥(Limits.pullback u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) →
    (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
      (θ : Er ≅ @Proj _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W))
        MvPolynomial.gradedAlgebra),
      IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E₀ ∧
      θ.hom ≫ @Proj.toSpecZero _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W))
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap (IsLocalRing.ResidueField ↥W)
            ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W) 0))) =
      ι ≫ Limits.pullback.snd u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) →
    (∃ x ∈ E₀, ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
      Limits.pullback.fst u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x =
      σ (Fin.last k)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q)) →
    (E₀ ∩ closure E₀ᶜ).ncard + Nat.card {i : Fin k // ∃ x ∈ E₀,
      ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
      Limits.pullback.fst u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x =
      σ (Fin.castSucc i)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q)} ≤ 2 →
    (∀ (K : Type u) [Field K] [IsAlgClosed K] (t : Spec (.of K) ⟶ Spec (.of Ω))
      (E : Set ↥(Limits.pullback u₁ (t ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))))),
      E ∈ irreducibleComponents
        ↥(Limits.pullback u₁ (t ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))) →
      (∃ (Er : Scheme.{u})
        (ι : Er ⟶ Limits.pullback u₁ (t ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))))
        (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra),
        IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
        θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
        ι ≫ Limits.pullback.snd u₁ (t ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))) →
      3 ≤ (E ∩ closure Eᶜ).ncard + Nat.card {i : Fin k // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
        Limits.pullback.fst u₁ (t ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) x =
          σ (Fin.castSucc i) ((t ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) p)}) →
    (E₀ ∩ closure E₀ᶜ).Nonempty :=
by
  intro Ω _ _ W Z₁ u₁ k σ E₀ hst hE₀ hP1₀ hp₀ hcnt₀ gen
  classical
  by_contra hne
  have hempty : E₀ ∩ closure E₀ᶜ = ∅ := Set.not_nonempty_iff_eq_empty.mp hne
  haveI : IsProper u₁ := hst.1.2.1
  haveI : Flat u₁ := hst.1.1
  haveI : HenselianLocalRing ↥W := wcpa_dj_lmga_valuation_henselian Ω W

  have hρpt : ∀ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
      Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q =
      IsLocalRing.closedPoint ↥W := by
    intro q
    have hq : q = IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W) := Subsingleton.elim _ _
    subst hq
    exact IsLocalRing.comap_closedPoint (IsLocalRing.residue ↥W)
  haveI : IsClosedImmersion
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have hemb : Topology.IsClosedEmbedding (Limits.pullback.fst u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    IsClosedImmersion.isClosedEmbedding _
  have hrange : Set.range (Limits.pullback.fst u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) =
      u₁ ⁻¹' {IsLocalRing.closedPoint ↥W} := by
    rw [Scheme.Pullback.range_fst]
    congr 1
    ext y
    simp only [Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨q, rfl⟩; exact hρpt q
    · intro hy
      exact ⟨IsLocalRing.closedPoint _, (hρpt _).trans hy.symm⟩

  have hE₀cl : IsClosed E₀ := isClosed_of_mem_irreducibleComponents _ hE₀
  have hE₀ccl : IsClosed E₀ᶜ := by
    rw [← closure_subset_iff_isClosed]
    intro y hy hyE
    have h1 : y ∈ E₀ ∩ closure E₀ᶜ := ⟨hyE, hy⟩
    rw [hempty] at h1
    exact h1
  obtain ⟨C', hC'clo, hC'⟩ := wc_proper_henselian_closed_fibre_clopen_extend ↥W Z₁ u₁
    (Limits.pullback.fst u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) '' E₀)
    (Limits.pullback.fst u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) '' E₀ᶜ)
    (hemb.isClosedMap _ hE₀cl) (hemb.isClosedMap _ hE₀ccl)
    (by
      rw [Set.disjoint_iff]
      rintro z ⟨⟨a, ha, rfl⟩, ⟨b, hb, hab⟩⟩
      have hba := hemb.injective hab
      subst hba
      exact hb ha)
    (by rw [← Set.image_union, Set.union_compl_self, Set.image_univ, hrange])
  have hχ : ∀ x, Limits.pullback.fst u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x ∈ C' ↔
      x ∈ E₀ := by
    intro x
    have hx : u₁ (Limits.pullback.fst u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x) =
        IsLocalRing.closedPoint ↥W := by
      have h1 : Limits.pullback.fst u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x ∈
          Set.range (Limits.pullback.fst u₁
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
        ⟨x, rfl⟩
      rw [hrange] at h1
      exact h1
    rw [hC' _ hx]
    constructor
    · rintro ⟨a, ha, hax⟩
      rw [← hemb.injective hax]
      exact ha
    · intro h
      exact ⟨x, h, rfl⟩

  have hsecC : ∀ (τ : Spec (.of ↥W) ⟶ Z₁) (a b : ↥(Spec (.of ↥W))), τ a ∈ C' → τ b ∈ C' := by
    intro τ a b ha
    have hcl : IsClopen (⇑τ ⁻¹' C') := hC'clo.preimage τ.continuous
    rcases isClopen_iff.mp hcl with h | h
    · have h1 : a ∈ (⇑τ ⁻¹' C') := ha
      rw [h] at h1
      exact h1.elim
    · have h1 : b ∈ (⇑τ ⁻¹' C') := by rw [h]; trivial
      exact h1
  have hM₀ : ∀ i : Fin k, ∀ a : ↥(Spec (.of ↥W)), σ (Fin.castSucc i) a ∈ C' →
      ∃ x ∈ E₀, ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
        Limits.pullback.fst u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x =
        σ (Fin.castSucc i)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q) := by
    intro i a ha
    obtain ⟨q⟩ : Nonempty ↥(Spec (.of (IsLocalRing.ResidueField ↥W))) := inferInstance
    have h := hsecC (σ (Fin.castSucc i)) a
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q) ha
    have hu : u₁ (σ (Fin.castSucc i)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q)) =
        IsLocalRing.closedPoint ↥W := by
      rw [← Scheme.Hom.comp_apply, hst.2.1.1 (Fin.castSucc i)]
      exact hρpt q
    have hmem : σ (Fin.castSucc i)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q) ∈
        Set.range (Limits.pullback.fst u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) := by
      rw [hrange]; exact hu
    obtain ⟨x, hx⟩ := hmem
    exact ⟨x, (hχ x).mp (by rw [hx]; exact h), q, hx⟩
  have hprange : Set.range (σ (Fin.last k)) ⊆ C' := by
    obtain ⟨x, hx, q, hxq⟩ := hp₀
    have hq : σ (Fin.last k)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q) ∈ C' := by
      rw [← hxq]
      exact (hχ x).mpr hx
    rintro _ ⟨a, rfl⟩
    exact hsecC _ _ a hq

  let C : Z₁.Opens := ⟨C', hC'clo.isOpen⟩
  have hredκ := wcpa_dj_ldx_semistable_fibre_reduced Z₁ (Spec (.of ↥W)) u₁ hst.1
    (IsLocalRing.ResidueField ↥W)
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
  obtain ⟨θκ, hθκ⟩ := wcpa_dj_lfc_ni_open_p1_fibre (Spec (.of ↥W)) (IsLocalRing.ResidueField ↥W)
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) Z₁ u₁ C E₀
    hredκ hχ hP1₀
  haveI : IsClosedImmersion C.ι :=
    IsClosedImmersion.of_isPreimmersion C.ι (by rw [Scheme.Opens.range_ι]; exact hC'clo.isClosed)
  haveI : LocallyOfFinitePresentation u₁ :=
    wcpa_dj_mn_flat_fp (Spec (.of ↥W)) Z₁ u₁ hst.1.1 inferInstance
  let sY : Spec (.of ↥W) ⟶ C.toScheme :=
    IsOpenImmersion.lift C.ι (σ (Fin.last k)) (by rw [Scheme.Opens.range_ι]; exact hprange)
  have hsYfac : sY ≫ C.ι = σ (Fin.last k) := IsOpenImmersion.lift_fac _ _ _
  have hsYv : sY ≫ C.ι ≫ u₁ = 𝟙 _ := by
    rw [← Category.assoc, hsYfac, hst.2.1.1]
  obtain ⟨θ, hθ⟩ := wcpa_dj_lfc_ni_p1_rigid Ω W C.toScheme (C.ι ≫ u₁) sY inferInstance
    inferInstance inferInstance hsYv ⟨θκ, hθκ⟩

  have hredΩ := wcpa_dj_ldx_semistable_fibre_reduced Z₁ (Spec (.of ↥W)) u₁ hst.1 Ω
    (𝟙 (Spec (.of Ω)) ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))
  obtain ⟨hcomp, hclo, hP1⟩ := wcpa_dj_lfc_ni_clopen_p1_component ↥W Z₁ u₁ C θ hθ hC'clo Ω
    (𝟙 (Spec (.of Ω)) ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) hredΩ
  have h3 := gen Ω (𝟙 _) _ hcomp hP1
  rw [hclo.compl.isClosed.closure_eq, Set.inter_compl_self, Set.ncard_empty, zero_add] at h3
  have key : ∀ {P Q : Fin k → Prop}, (∀ i, P i → Q i) →
      Nat.card {i // P i} ≤ Nat.card {i // Q i} := by
    intro P Q h
    exact Nat.card_le_card_of_injective (fun i => (⟨i.1, h i.1 i.2⟩ : {i // Q i}))
      (by
        intro a b hab
        apply Subtype.ext
        have := congrArg (fun z : {i // Q i} => z.1) hab
        exact this)
  have hfinal : ∀ (n m : ℕ), n + m ≤ 2 → 3 ≤ m → False := by
    intro n m h1 h2
    omega
  refine hfinal _ _ hcnt₀ (le_trans h3 (key ?_))
  intro i hi
  obtain ⟨x, hx, p', hxp⟩ := hi
  have h1 : σ (Fin.castSucc i)
      ((𝟙 (Spec (.of Ω)) ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) p') ∈ C' := by
    rw [← hxp]
    exact hx
  exact hM₀ i _ h1

theorem wcpa_dj_lfc_anchor_sections : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (k : ℕ)
    (σ : Fin (k + 1) → (Spec (.of ↥W) ⟶ Z₁))
    (E₀ : Set ↥(Limits.pullback u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))),
    wcpaDjSemistable u₁ → wcpaDjSections u₁ (k + 1) σ →
    E₀ ∈ irreducibleComponents ↥(Limits.pullback u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) →
    ∃ (r : ℕ) (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁)),
      wcpaDjSections u₁ (k + 1 + r) (Fin.append σ ε) ∧
      (∀ b, ¬ ∃ x ∈ E₀, ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
        Limits.pullback.fst u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x =
        ε b (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q)) ∧
      ∀ E ∈ irreducibleComponents ↥(Limits.pullback u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
        E ≠ E₀ → ∃ b, ∃ x ∈ E, ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
          Limits.pullback.fst u₁
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x =
          ε b (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q) :=
by
  intro Ω _ _ W Z₁ u₁ k σ
  classical
  set ρ : Spec (.of (IsLocalRing.ResidueField ↥W)) ⟶ Spec (.of ↥W) :=
    Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) with hρ
  intro E₀ hss hsec hE₀

  haveI hκ : IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
    apply IsAlgClosed.of_exists_root
    intro p hpm hirr
    have hlift : p ∈ Polynomial.lifts (IsLocalRing.residue ↥W) :=
      (Polynomial.mem_lifts p).mpr (Polynomial.map_surjective _ IsLocalRing.residue_surjective p)
    obtain ⟨q, hqmap, hqdeg, hqmon⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hpm
    have hpdeg : 0 < p.degree := Polynomial.degree_pos_of_irreducible hirr
    have hQdeg : (q.map (algebraMap ↥W Ω)).degree ≠ 0 := by
      rw [Polynomial.degree_map_eq_of_injective (IsFractionRing.injective ↥W Ω), hqdeg]
      exact hpdeg.ne'
    obtain ⟨θ, hθ⟩ := IsAlgClosed.exists_root _ hQdeg
    have hθ' : Polynomial.eval θ (q.map (algebraMap ↥W Ω)) = 0 := hθ
    have hint : IsIntegral ↥W θ := by
      show ∃ p : Polynomial ↥W, p.Monic ∧ Polynomial.eval₂ (algebraMap ↥W Ω) θ p = 0
      exact ⟨q, hqmon, by rw [← Polynomial.eval_map]; exact hθ'⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    have hqy : q.eval y = 0 := by
      apply IsFractionRing.injective ↥W Ω
      rw [map_zero, ← Polynomial.eval₂_at_apply, hy, ← Polynomial.eval_map]
      exact hθ'
    refine ⟨IsLocalRing.residue ↥W y, ?_⟩
    rw [← hqmap, Polynomial.eval_map, Polynomial.eval₂_at_apply, hqy, map_zero]

  haveI : IsProper u₁ := hss.2.1
  have hfin : (irreducibleComponents ↥(Limits.pullback u₁ ρ)).Finite := by
    haveI : IsLocallyNoetherian (Limits.pullback u₁ ρ) :=
      LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd u₁ ρ)
    haveI : CompactSpace ↥(Limits.pullback u₁ ρ) :=
      QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd u₁ ρ)
    haveI : AlgebraicGeometry.IsNoetherian (Limits.pullback u₁ ρ) :=
      AlgebraicGeometry.IsNoetherian.mk
    exact TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  haveI : IsClosedImmersion ρ := by
    apply IsClosedImmersion.spec_of_surjective
    show Function.Surjective (algebraMap ↥W (IsLocalRing.ResidueField ↥W))
    rw [IsLocalRing.ResidueField.algebraMap_eq]
    exact IsLocalRing.residue_surjective
  have hinj : Function.Injective (Limits.pullback.fst u₁ ρ) :=
    (Scheme.Hom.isClosedEmbedding (Limits.pullback.fst u₁ ρ)).isEmbedding.injective
  have hpt : ∀ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
      ρ q = IsLocalRing.closedPoint ↥W := by
    intro q
    rw [hρ, Spec.map_apply]
    have hq : q = IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W) := Subsingleton.elim _ _
    rw [hq, CommRingCat.hom_ofHom, IsLocalRing.ResidueField.algebraMap_eq]
    exact IsLocalRing.comap_closedPoint (IsLocalRing.residue ↥W)

  have hflat : Flat u₁ := hss.1
  have hlfp : LocallyOfFinitePresentation u₁ :=
    wcpa_dj_mn_flat_fp (Spec (.of ↥W)) Z₁ u₁ hflat inferInstance
  have one_anchor : ∀ z : Spec (.of (IsLocalRing.ResidueField ↥W)) ⟶ Limits.pullback u₁ ρ,
      z ≫ Limits.pullback.snd u₁ ρ = 𝟙 _ →
      (∃ V : (Limits.pullback u₁ ρ).Opens,
        z (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) ∈ V ∧
        SmoothOfRelativeDimension 1 (V.ι ≫ Limits.pullback.snd u₁ ρ)) →
      ∃ ε : Spec (.of ↥W) ⟶ Z₁, ε ≫ u₁ = 𝟙 _ ∧ ρ ≫ ε = z ≫ Limits.pullback.fst u₁ ρ ∧
        ∃ V' : Z₁.Opens,
          Limits.pullback.fst u₁ ρ (z (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))) ∈ V' ∧
          SmoothOfRelativeDimension 1 (V'.ι ≫ u₁) := by
    intro z hz hV
    obtain ⟨V', hV', hV'sm⟩ := wcpa_dj_bsc_smooth_descend (Spec (.of ↥W)) Z₁ u₁
      (IsLocalRing.ResidueField ↥W) ρ (z (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)))
      hflat hlfp hV
    have ht1 : (z ≫ Limits.pullback.fst u₁ ρ)
        (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) ∈ V' := by
      have e := Scheme.Hom.comp_apply z (Limits.pullback.fst u₁ ρ)
        (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))
      exact e ▸ hV'
    have ht2 : (z ≫ Limits.pullback.fst u₁ ρ) ≫ u₁ = ρ := by
      rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hz, Category.id_comp]
    obtain ⟨ε, hε1, hε2⟩ := wcpa_dj_lus_sm_hensel_section Ω W Z₁ u₁ V' hV'sm _ ht1 ht2
    exact ⟨ε, hε1, hε2, V', hV', hV'sm⟩

  have star : ∀ (f : Spec (.of ↥W) ⟶ Z₁)
      (g : Spec (.of (IsLocalRing.ResidueField ↥W)) ⟶ Limits.pullback u₁ ρ),
      ρ ≫ f = g ≫ Limits.pullback.fst u₁ ρ →
      f (IsLocalRing.closedPoint ↥W) =
        Limits.pullback.fst u₁ ρ (g (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))) := by
    intro f g h
    have e1 := Scheme.Hom.comp_apply ρ f (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))
    have e2 := Scheme.Hom.comp_apply g (Limits.pullback.fst u₁ ρ)
      (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))
    have e3 : (ρ ≫ f) (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) =
        (g ≫ Limits.pullback.fst u₁ ρ) (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) := by
      rw [h]
    exact (congrArg f (hpt _)).symm.trans (e1.symm.trans (e3.trans e2))

  let x : Fin (k + 1) → (Spec (.of (IsLocalRing.ResidueField ↥W)) ⟶ Limits.pullback u₁ ρ) :=
    fun i => Limits.pullback.lift (ρ ≫ σ i) (𝟙 _)
      (by rw [Category.assoc, hsec.1 i, Category.comp_id, Category.id_comp])
  have hx1 : ∀ i, x i ≫ Limits.pullback.snd u₁ ρ = 𝟙 _ := fun i => Limits.pullback.lift_snd _ _ _
  have hx2 : ∀ i, x i ≫ Limits.pullback.fst u₁ ρ = ρ ≫ σ i := fun i => Limits.pullback.lift_fst _ _ _
  have hσx : ∀ i, σ i (IsLocalRing.closedPoint ↥W) =
      Limits.pullback.fst u₁ ρ (x i (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))) :=
    fun i => star (σ i) (x i) (hx2 i).symm
  have hssκ : wcpaDjSemistable (Limits.pullback.snd u₁ ρ) :=
    wcpa_dj_mm_semistable_basechange (Spec (.of ↥W)) _ Z₁ ρ u₁ hss

  let S : Set (Set ↥(Limits.pullback u₁ ρ)) :=
    {D | D ∈ irreducibleComponents ↥(Limits.pullback u₁ ρ) ∧ D ≠ E₀}
  have memS : ∀ D, D ∈ irreducibleComponents ↥(Limits.pullback u₁ ρ) → D ≠ E₀ → D ∈ S :=
    fun D h1 h2 => ⟨h1, h2⟩
  have hSc : ∀ D, D ∈ S → D ∈ irreducibleComponents ↥(Limits.pullback u₁ ρ) := fun D h => h.1
  have hSne : ∀ D, D ∈ S → D ≠ E₀ := fun D h => h.2
  haveI : Finite ↥S := (hfin.subset hSc).to_subtype
  have hpts : ∀ D : ↥S, ∃ z : Spec (.of (IsLocalRing.ResidueField ↥W)) ⟶ Limits.pullback u₁ ρ,
      z ≫ Limits.pullback.snd u₁ ρ = 𝟙 _ ∧
      z (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) ∈ (D : Set ↥(Limits.pullback u₁ ρ)) ∧
      (∀ D' ∈ irreducibleComponents ↥(Limits.pullback u₁ ρ),
        D' ≠ (D : Set ↥(Limits.pullback u₁ ρ)) →
        z (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) ∉ D') ∧
      (∀ i, z (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) ≠
        x i (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))) ∧
      ∃ V : (Limits.pullback u₁ ρ).Opens,
        z (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) ∈ V ∧
        SmoothOfRelativeDimension 1 (V.ι ≫ Limits.pullback.snd u₁ ρ) := by
    intro D
    obtain ⟨t, ht1, -, ht3, ht4, ht5, ht6⟩ :=
      wcpa_dj_lus_am_component_points (IsLocalRing.ResidueField ↥W)
        (Limits.pullback u₁ ρ) (Limits.pullback.snd u₁ ρ) hssκ (k + 1) x hx1 D (hSc D D.2)
    exact ⟨t 0, ht1 0, ht3 0, ht4 0, ht5 0, ht6 0⟩
  choose z hz1 hz2 hz3 hz4 hz5 using hpts
  have hanc : ∀ D : ↥S, ∃ ε : Spec (.of ↥W) ⟶ Z₁, ε ≫ u₁ = 𝟙 _ ∧
      ρ ≫ ε = z D ≫ Limits.pullback.fst u₁ ρ ∧
      ∃ V' : Z₁.Opens,
        Limits.pullback.fst u₁ ρ (z D (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))) ∈ V' ∧
        SmoothOfRelativeDimension 1 (V'.ι ≫ u₁) :=
    fun D => one_anchor (z D) (hz1 D) (hz5 D)
  choose εD hε1 hε2 hε3 using hanc
  have hεpt : ∀ D : ↥S, εD D (IsLocalRing.closedPoint ↥W) =
      Limits.pullback.fst u₁ ρ (z D (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))) :=
    fun D => star (εD D) (z D) (hε2 D)
  let e : Fin (Nat.card ↥S) ≃ ↥S := (Finite.equivFin ↥S).symm
  refine ⟨Nat.card ↥S, fun b => εD (e b), ?_, ?_, ?_⟩
  ·
    apply wcpa_dj_lus_am_append_sections ↥W Z₁ u₁ inferInstance (k + 1) (Nat.card ↥S) σ
      (fun b => εD (e b)) hsec
    · intro j
      exact hε1 (e j)
    · intro j
      obtain ⟨V', hV', hV'sm⟩ := hε3 (e j)
      refine ⟨V', ?_, hV'sm⟩
      show εD (e j) (IsLocalRing.closedPoint ↥W) ∈ V'
      rw [hεpt]
      exact hV'
    · intro j j' hjj' heq
      have heq' : εD (e j) (IsLocalRing.closedPoint ↥W) = εD (e j') (IsLocalRing.closedPoint ↥W) :=
        heq
      rw [hεpt, hεpt] at heq'
      have h := hinj heq'
      refine hz3 (e j) (e j') (hSc _ (e j').2) ?_ (by rw [h]; exact hz2 (e j'))
      intro h'
      exact hjj' (e.injective (Subtype.ext h')).symm
    · intro i j heq
      have heq' : σ i (IsLocalRing.closedPoint ↥W) = εD (e j) (IsLocalRing.closedPoint ↥W) := heq
      rw [hσx, hεpt] at heq'
      exact hz4 (e j) i (hinj heq').symm
  ·
    rintro b ⟨x₀, hx₀, q, hq⟩
    have hq' : Limits.pullback.fst u₁ ρ x₀ = εD (e b) (ρ q) := hq
    rw [hpt q, hεpt] at hq'
    have h := hinj hq'
    exact hz3 (e b) E₀ hE₀ (fun h' => hSne _ (e b).2 h'.symm) (by rw [← h]; exact hx₀)
  ·
    intro E hE hne
    refine ⟨e.symm ⟨E, memS E hE hne⟩, z ⟨E, memS E hE hne⟩
      (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)), hz2 ⟨E, memS E hE hne⟩,
      IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W), ?_⟩
    show Limits.pullback.fst u₁ ρ (z ⟨E, memS E hE hne⟩
      (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))) =
      εD (e (e.symm ⟨E, memS E hE hne⟩)) (ρ (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)))
    rw [Equiv.apply_symm_apply]
    exact (hεpt _).symm.trans (congrArg (εD ⟨E, memS E hE hne⟩) (hpt _)).symm

theorem wcpa_dj_lsp_dc_glue : ∀ {Z T : Scheme.{u}} (uu : Z ⟶ T) (m : ℕ)
    (ε : Fin m → (T ⟶ Z)), IsSeparated uu → IsAffine T → ∀ (n : ℕ) (V : Fin n → Z.Opens)
    (f : ∀ a, Γ(Z, V a)), (∀ a, IsAffineOpen (V a)) → (⨆ a, V a) = ⊤ →
    (∀ a (W : Z.Opens), IsAffineOpen W → ∀ hW : W ≤ V a,
      (Z.presheaf.map (homOfLE hW).op).hom (f a) ∈ nonZeroDivisors Γ(Z, W) ∧
      ∀ s : Γ(Z, W), (∀ i, ((ε i).app W).hom s = 0) ↔
        s ∈ Ideal.span {(Z.presheaf.map (homOfLE hW).op).hom (f a)}) →
    (∀ a, (Z.basicOpen (f a) : Set Z) = (V a : Set Z) \ ⋃ i, Set.range ⇑(ε i)) →
    ∃ (L : wcpaDjCoc Z) (t : ∀ a : Fin L.m, Γ(Z, L.V a ⊓ uu ⁻¹ᵁ ⊤)),
      wcpaDjCocOK L ∧ wcpaDjCompat L (uu ⁻¹ᵁ ⊤) 1 t ∧
      ∀ a, (Z.basicOpen (t a) : Set Z) =
        ((L.V a ⊓ uu ⁻¹ᵁ ⊤ : Z.Opens) : Set Z) \ ⋃ i, Set.range ⇑(ε i) :=
by
  intro Z T uu m ε hsep haff n V f hV hcov hLE hBO
  classical

  haveI : IsSeparated uu := hsep
  haveI hZsep : Z.IsSeparated := by
    rw [Scheme.isSeparated_iff]
    have e : Limits.terminal.from Z = uu ≫ Limits.terminal.from T := Limits.terminal.hom_ext _ _
    rw [e]
    infer_instance
  have hab : ∀ a b, IsAffineOpen (V a ⊓ V b) := fun a b => (hV a).inf (hV b)
  have habc : ∀ a b c, IsAffineOpen (V a ⊓ V b ⊓ V c) := fun a b c => (hab a b).inf (hV c)

  have hR : ∀ (U U' U'' : Z.Opens) (h1 : U' ≤ U) (h2 : U'' ≤ U') (h3 : U'' ≤ U) (x : Γ(Z, U)),
      (Z.presheaf.map (homOfLE h2).op).hom ((Z.presheaf.map (homOfLE h1).op).hom x) =
      (Z.presheaf.map (homOfLE h3).op).hom x := by
    intro U U' U'' h1 h2 h3 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have hR2 : ∀ {U U' U'' : Z.Opens} (h1 : U' ≤ U) (h2 : U'' ≤ U') (x : Γ(Z, U)),
      (Z.presheaf.map (homOfLE h2).op).hom ((Z.presheaf.map (homOfLE h1).op).hom x) =
      (Z.presheaf.map (homOfLE (h2.trans h1)).op).hom x :=
    fun h1 h2 x => hR _ _ _ h1 h2 _ x

  have unit_of : ∀ (A : Type u) [CommRing A] (x y : A), x ∈ nonZeroDivisors A →
      y ∈ Ideal.span {x} → x ∈ Ideal.span {y} → ∃ g : Aˣ, y = (g : A) * x := by
    intro A _ x y hx hy hx'
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hy
    obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp hx'
    have h1 : (d * c) * x = 1 * x := by rw [mul_assoc, hc, hd, one_mul]
    have h2 : d * c = 1 := (mul_cancel_right_mem_nonZeroDivisors hx).mp h1
    exact ⟨⟨c, d, by rw [mul_comm]; exact h2, h2⟩, hc.symm⟩

  have hex : ∀ a b, ∃ g : (Γ(Z, V a ⊓ V b))ˣ,
      (Z.presheaf.map (homOfLE (inf_le_right : V a ⊓ V b ≤ V b)).op).hom (f b) =
      (g : Γ(Z, V a ⊓ V b)) *
        (Z.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ≤ V a)).op).hom (f a) := by
    intro a b
    have hA := hLE a (V a ⊓ V b) (hab a b) inf_le_left
    have hB := hLE b (V a ⊓ V b) (hab a b) inf_le_right
    exact unit_of _ _ _ hA.1 ((hA.2 _).mp ((hB.2 _).mpr (Ideal.mem_span_singleton_self _)))
      ((hB.2 _).mp ((hA.2 _).mpr (Ideal.mem_span_singleton_self _)))
  choose g hg using hex

  have key : ∀ a b c (W : Z.Opens), IsAffineOpen W → ∀ (h1 : W ≤ V a ⊓ V b)
      (h2 : W ≤ V b ⊓ V c) (h3 : W ≤ V a ⊓ V c),
      (Z.presheaf.map (homOfLE h1).op).hom (g a b : Γ(Z, V a ⊓ V b)) *
        (Z.presheaf.map (homOfLE h2).op).hom (g b c : Γ(Z, V b ⊓ V c)) =
      (Z.presheaf.map (homOfLE h3).op).hom (g a c : Γ(Z, V a ⊓ V c)) := by
    intro a b c W hW h1 h2 h3
    have ha : W ≤ V a := h1.trans inf_le_left
    have hb : W ≤ V b := h1.trans inf_le_right
    have hc : W ≤ V c := h2.trans inf_le_right
    have e1 := congrArg (Z.presheaf.map (homOfLE h1).op).hom (hg a b)
    rw [map_mul, hR _ _ _ _ _ hb, hR _ _ _ _ _ ha] at e1
    have e2 := congrArg (Z.presheaf.map (homOfLE h2).op).hom (hg b c)
    rw [map_mul, hR _ _ _ _ _ hc, hR _ _ _ _ _ hb] at e2
    have e3 := congrArg (Z.presheaf.map (homOfLE h3).op).hom (hg a c)
    rw [map_mul, hR _ _ _ _ _ hc, hR _ _ _ _ _ ha] at e3
    have hnz := (hLE a W hW ha).1
    apply (mul_cancel_right_mem_nonZeroDivisors hnz).mp
    linear_combination
      (-(Z.presheaf.map (homOfLE h2).op).hom (g b c : Γ(Z, V b ⊓ V c))) * e1 - e2 + e3
  refine ⟨⟨n, V, g⟩, fun a =>
    (Z.presheaf.map (homOfLE (inf_le_left : V a ⊓ uu ⁻¹ᵁ ⊤ ≤ V a)).op).hom (f a), ?_, ?_, ?_⟩
  · unfold wcpaDjCocOK
    refine ⟨hV, hcov, ?_, ?_⟩
    · intro a
      have e := hg a a
      have hnz := (hLE a (V a ⊓ V a) (hab a a) inf_le_left).1
      apply Units.ext
      rw [Units.val_one]
      apply (mul_cancel_right_mem_nonZeroDivisors hnz).mp
      rw [one_mul]
      exact e.symm
    · intro a b c
      exact key a b c _ (habc a b c) _ _ _
  · unfold wcpaDjCompat
    intro a b
    try dsimp only
    rw [pow_one, hR2, hR2]
    have e := congrArg
      (Z.presheaf.map (homOfLE (inf_le_left : V a ⊓ V b ⊓ uu ⁻¹ᵁ ⊤ ≤ V a ⊓ V b)).op).hom (hg a b)
    rw [map_mul, hR2, hR2] at e
    exact e
  · intro a
    show (Z.basicOpen ((Z.presheaf.map (homOfLE (inf_le_left : V a ⊓ uu ⁻¹ᵁ ⊤ ≤ V a)).op).hom
      (f a)) : Set Z) = ((V a ⊓ uu ⁻¹ᵁ ⊤ : Z.Opens) : Set Z) \ ⋃ i, Set.range ⇑(ε i)
    rw [Scheme.basicOpen_res]
    ext x
    have hx := Set.ext_iff.mp (hBO a) x
    simp only [Opposite.unop_op, TopologicalSpace.Opens.coe_inf, Set.mem_inter_iff,
      Set.mem_diff, SetLike.mem_coe] at hx ⊢
    tauto

theorem wcpa_dj_lsp_divisor_cocycle : ∀ {Z T : Scheme.{u}} (uu : Z ⟶ T) (m : ℕ)
    (ε : Fin m → (T ⟶ Z)), IsSeparated uu → QuasiCompact uu → IsAffine T →
    wcpaDjSections uu m ε →
    ∃ (L : wcpaDjCoc Z) (t : ∀ a : Fin L.m, Γ(Z, L.V a ⊓ uu ⁻¹ᵁ ⊤)),
      wcpaDjCocOK L ∧ wcpaDjCompat L (uu ⁻¹ᵁ ⊤) 1 t ∧
      ∀ a, (Z.basicOpen (t a) : Set Z) =
        ((L.V a ⊓ uu ⁻¹ᵁ ⊤ : Z.Opens) : Set Z) \ ⋃ i, Set.range ⇑(ε i) :=
by
  intro Z T uu m ε hsep hqc haff hsec
  classical
  obtain ⟨hs1, hs2, hs3⟩ := hsec
  haveI := hsep
  haveI := hqc

  have hclj : ∀ j, IsClosed (Set.range ⇑(ε j)) := by
    intro j
    haveI : IsClosedImmersion (ε j ≫ uu) := by rw [hs1 j]; infer_instance
    haveI : IsClosedImmersion (ε j) := IsClosedImmersion.of_comp (ε j) uu
    exact (ε j).isClosedEmbedding.isClosed_range
  have hD : IsClosed (⋃ i, Set.range ⇑(ε i)) := isClosed_iUnion_of_finite hclj

  have hP0 : ∀ (W : Z.Opens), (∀ i q, ε i q ∉ W) → ∀ i (s : Γ(Z, W)),
      ((ε i).app W).hom s = 0 := by
    intro W hW i s
    have hbot : ε i ⁻¹ᵁ W = ⊥ := eq_bot_iff.mpr (fun q hq => (hW i q hq).elim)
    haveI : Subsingleton Γ(T, ε i ⁻¹ᵁ W) :=
      CommRingCat.subsingleton_of_isTerminal (T.sheaf.isTerminalOfEqEmpty hbot)
    exact Subsingleton.elim _ _

  have hnbhd : ∀ (U : Z.Opens) (x : Z), x ∈ U → ∃ W : Z.Opens, IsAffineOpen W ∧ x ∈ W ∧ W ≤ U := by
    intro U x hx
    obtain ⟨W, hW, hxW, hWU⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens hx
    exact ⟨W, hW, hxW, hWU⟩
  let Dc : Z.Opens := ⟨(⋃ i, Set.range ⇑(ε i))ᶜ, hD.isOpen_compl⟩
  have hmiss : ∀ W : Z.Opens, W ≤ Dc → ∀ i q, ε i q ∉ W := by
    intro W hW i q hq
    exact hW hq (Set.mem_iUnion.mpr ⟨i, q, rfl⟩)

  have hoff : ∀ z : Z, z ∉ ⋃ i, Set.range ⇑(ε i) → ∃ (V : Z.Opens) (f : Γ(Z, V)),
      IsAffineOpen V ∧ z ∈ V ∧
      (∀ (W : Z.Opens), IsAffineOpen W → ∀ hW : W ≤ V,
        (Z.presheaf.map (homOfLE hW).op).hom f ∈ nonZeroDivisors Γ(Z, W) ∧
        ∀ s : Γ(Z, W), (∀ i, ((ε i).app W).hom s = 0) ↔
          s ∈ Ideal.span {(Z.presheaf.map (homOfLE hW).op).hom f}) := by
    intro z hz
    obtain ⟨V, hVaff, hzV, hVle⟩ := hnbhd Dc z hz
    refine ⟨V, 1, hVaff, hzV, fun W _ hW => ?_⟩
    rw [map_one, Ideal.span_singleton_one]
    exact ⟨one_mem _, fun s => iff_of_true (fun i => hP0 W (hmiss W (hW.trans hVle)) i s)
      Submodule.mem_top⟩

  have hbo : ∀ (V : Z.Opens) (f : Γ(Z, V)), IsAffineOpen V →
      (∀ (W : Z.Opens), IsAffineOpen W → ∀ hW : W ≤ V,
        (Z.presheaf.map (homOfLE hW).op).hom f ∈ nonZeroDivisors Γ(Z, W) ∧
        ∀ s : Γ(Z, W), (∀ i, ((ε i).app W).hom s = 0) ↔
          s ∈ Ideal.span {(Z.presheaf.map (homOfLE hW).op).hom f}) →
      (Z.basicOpen f : Set Z) = (V : Set Z) \ ⋃ i, Set.range ⇑(ε i) := by
    intro V f hV hLE
    have hvan : ∀ i, ((ε i).app V).hom f = 0 := by
      have h := (hLE V hV le_rfl).2 f
      have hid : (Z.presheaf.map (homOfLE (le_refl V)).op).hom f = f := by
        have e : homOfLE (le_refl V) = 𝟙 V := rfl
        rw [e, op_id, CategoryTheory.Functor.map_id]
        first | rfl | simp
      rw [hid] at h
      exact h.mpr (Ideal.mem_span_singleton_self f)
    ext x
    constructor
    · intro hx
      refine ⟨Z.basicOpen_le f hx, ?_⟩
      intro hxD
      obtain ⟨i, q, rfl⟩ := Set.mem_iUnion.mp hxD
      have hq : q ∈ ε i ⁻¹ᵁ Z.basicOpen f := hx
      rw [Scheme.preimage_basicOpen, hvan i, Scheme.basicOpen_zero] at hq
      exact hq
    · rintro ⟨hxV, hxD⟩
      obtain ⟨W, hWaff, hxW, hWle⟩ := hnbhd (V ⊓ Dc) x ⟨hxV, hxD⟩
      have hWV : W ≤ V := hWle.trans inf_le_left
      have h1 : (1 : Γ(Z, W)) ∈ Ideal.span {(Z.presheaf.map (homOfLE hWV).op).hom f} :=
        ((hLE W hWaff hWV).2 1).mp (fun i => hP0 W (hmiss W (hWle.trans inf_le_right)) i 1)
      have hunit : IsUnit ((Z.presheaf.map (homOfLE hWV).op).hom f) :=
        Ideal.span_singleton_eq_top.mp ((Ideal.eq_top_iff_one _).mpr h1)
      have h2 : Z.basicOpen ((Z.presheaf.map (homOfLE hWV).op).hom f) = W :=
        Scheme.basicOpen_of_isUnit Z hunit
      have h3 := Scheme.basicOpen_res Z f (homOfLE hWV).op
      rw [h2] at h3
      have h4 : x ∈ W ⊓ Z.basicOpen f := by rw [← h3]; exact hxW
      exact h4.2

  have hloc : ∀ z : Z, ∃ (V : Z.Opens) (f : Γ(Z, V)), IsAffineOpen V ∧ z ∈ V ∧
      (∀ (W : Z.Opens), IsAffineOpen W → ∀ hW : W ≤ V,
        (Z.presheaf.map (homOfLE hW).op).hom f ∈ nonZeroDivisors Γ(Z, W) ∧
        ∀ s : Γ(Z, W), (∀ i, ((ε i).app W).hom s = 0) ↔
          s ∈ Ideal.span {(Z.presheaf.map (homOfLE hW).op).hom f}) := by
    intro z
    by_cases hz : z ∈ ⋃ i, Set.range ⇑(ε i)
    · obtain ⟨j, p, rfl⟩ := Set.mem_iUnion.mp hz
      exact wcpa_dj_lsp_dc_local_eq_section uu m ε hsep ⟨hs1, hs2, hs3⟩ j p
    · exact hoff z hz
  choose V f hVaff hzV hLE using hloc
  haveI : CompactSpace Z := QuasiCompact.compactSpace_of_compactSpace uu
  obtain ⟨S, hS⟩ := isCompact_univ.elim_finite_subcover (fun z => (V z : Set Z))
    (fun z => (V z).isOpen) (fun z _ => Set.mem_iUnion.mpr ⟨z, hzV z⟩)
  let V' : Fin S.card → Z.Opens := fun a => V (S.equivFin.symm a)
  let f' : ∀ a, Γ(Z, V' a) := fun a => f (S.equivFin.symm a)
  have hcov : (⨆ a, V' a) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hx := hS (Set.mem_univ x)
    rw [Set.mem_iUnion₂] at hx
    obtain ⟨z, hzS, hxz⟩ := hx
    rw [TopologicalSpace.Opens.mem_iSup]
    refine ⟨S.equivFin ⟨z, hzS⟩, ?_⟩
    simp only [V', Equiv.symm_apply_apply]
    exact hxz
  exact wcpa_dj_lsp_dc_glue uu m ε hsep haff S.card V' f' (fun a => hVaff _) hcov
