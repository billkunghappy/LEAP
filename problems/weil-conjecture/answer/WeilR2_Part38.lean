  choose πs hπs using hπ

  obtain ⟨e, he⟩ : ∃ e : ℕ, e = 1 + ∑ ξ ∈ hGfin.toFinset, c ξ + 4 * (Zc.card + 2) := ⟨_, rfl⟩

