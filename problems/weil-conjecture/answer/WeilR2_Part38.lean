    (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra), IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧ θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = ι ≫ Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) →
    (∀ (Z : Scheme.{u}) (ι : Z ⟶ Y), IsClosedImmersion ι → IsReduced Z → Set.range ι = closure ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) '' E) → ∀ z : ↥Z, IsDomain (Z.presheaf.stalk z) ∧ IsIntegrallyClosed (Z.presheaf.stalk z)) →
    ∀ (P : Scheme.{u}) (p : P ⟶ Y), IsFinite p → Etale p → Surjective p → ∃ S : Set ↥P, IsClosed S ∧ ∀ y ∈ closure ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) '' E), (p ⁻¹' {y} ∩ S).ncard = 1 :=
by
  intro K _ _ R hκ Y v hss E hE hP1E hnorm P p hpfin hpet hpsurj
  classical
  obtain ⟨Er, ι, θ, hci, _, hrange, _⟩ := hP1E
  haveI := hci
  haveI := hpfin

  have hEcl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
  obtain ⟨z, hzE⟩ : ∃ z, closure {z} = E := by
    refine ⟨hE.1.genericPoint, ?_⟩
    have h1 := hE.1.isGenericPoint_genericPoint_closure
    rw [hEcl.closure_eq] at h1
    exact h1
  have hzmem : z ∈ E := by rw [← hzE]; exact subset_closure rfl
  obtain ⟨e, he⟩ : z ∈ Set.range ι := by rw [hrange]; exact hzmem

  have hClg : closure ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) '' E)
      ⊆ closure {Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) z} := by
    apply closure_minimal _ isClosed_closure
    rintro _ ⟨w, hw, rfl⟩
    rw [← hzE] at hw
    have h1 : z ⤳ w := specializes_iff_mem_closure.mpr hw
    exact specializes_iff_mem_closure.mp
      (h1.map (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).continuous)
  have hgCl : Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) z ∈
      closure ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) '' E) :=
    subset_closure ⟨z, hzmem, rfl⟩
  have hClz : closure {Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) z} =
      closure ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) '' E) :=
    le_antisymm (closure_minimal (Set.singleton_subset_iff.mpr hgCl) isClosed_closure) hClg

  obtain ⟨Zb, ιb, hcib, hredb, hrangeb⟩ := wcpa_dj_fcs_reduced_closed_subscheme Y
    (closure ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) '' E))
    isClosed_closure
  haveI := hcib
