    have hinj := (f.residueFieldMap η).hom.injective
    rw [CommRingCat.comp_apply]
    exact hinj (e2.trans (map_zero _).symm)
  have s4 : ∀ (X : Scheme.{u}) (y : X) (a : X.presheaf.stalk y), ∃ (U : X.affineOpens)
      (hy : y ∈ (U : X.Opens)) (f : Γ(X, U)), (X.presheaf.germ U y hy).hom f = a := by
    intro X y a
    obtain ⟨V, hV, s, hs⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf a
    obtain ⟨U', hU', hyU', hle⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens X)) hV
    refine ⟨⟨U', hU'⟩, hyU', X.presheaf.map (homOfLE hle).op s, ?_⟩
    rw [← hs]
    exact TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hle) y hyU' s
  intro C ξ
  have s2 : ∀ (U : C.affineOpens) (f : Γ(C, U)), ξ ∈ (U : C.Opens) →
      (f ∈ (Scheme.IdealSheafData.vanishingIdeal
        ⟨closure ({ξ} : Set C), isClosed_closure⟩).ideal U ↔ ξ ∉ C.basicOpen f) := by
    intro U f hξU
    rw [Scheme.IdealSheafData.vanishingIdeal_ideal, PrimeSpectrum.mem_vanishingIdeal]
    have key : ∀ p : PrimeSpectrum Γ(C, U), f ∈ p.asIdeal ↔ U.2.fromSpec p ∉ C.basicOpen f := by
      intro p
      have hb := U.2.fromSpec_preimage_basicOpen f
      rw [← not_iff_not, not_not, ← PrimeSpectrum.mem_basicOpen, ← hb]
      rfl
    constructor
    · intro H
      obtain ⟨p₀, hp₀⟩ : ξ ∈ Set.range U.2.fromSpec := by rw [U.2.range_fromSpec]; exact hξU
      have hc : p₀ ∈ ⇑U.2.fromSpec ⁻¹' (closure ({ξ} : Set C)) := by
        show U.2.fromSpec p₀ ∈ closure {ξ}
        rw [hp₀]; exact subset_closure rfl
      have := (key p₀).1 (H p₀ hc)
      rwa [hp₀] at this
    · intro H p hp
      rw [key]
      intro hb
      exact H ((specializes_iff_mem_closure.mpr hp).mem_open (C.basicOpen f).isOpen hb)
  have s3 : ∀ (y : C) (h : ξ ⤳ y) (U : C.Opens) (hy : y ∈ U) (f : Γ(C, U)),
      (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom ((C.presheaf.germ U y hy).hom f) = 0 ↔
        ξ ∉ C.basicOpen f := by
    intro y h U hy f
    rw [CommRingCat.comp_apply, TopCat.Presheaf.germ_stalkSpecializes_apply,
      ← CommRingCat.comp_apply, Scheme.germ_residue, Scheme.evaluation_eq_zero_iff_notMem_basicOpen]
  let Z : TopologicalSpace.Closeds C := ⟨closure ({ξ} : Set C), isClosed_closure⟩
  let I := Scheme.IdealSheafData.vanishingIdeal Z
  have hrange : Set.range I.subschemeι = closure ({ξ} : Set C) :=
    (Scheme.IdealSheafData.range_subschemeι I).trans
      (Scheme.IdealSheafData.coe_support_vanishingIdeal Z)
  refine ⟨I.subscheme, I.subschemeι, inferInstance, hrange, ?_⟩
  intro z h
  apply le_antisymm
  · obtain ⟨η, hη⟩ : ξ ∈ Set.range I.subschemeι := by rw [hrange]; exact subset_closure rfl
    have hηz : η ⤳ z := by
      rw [← I.subschemeι.isClosedEmbedding.isInducing.specializes_iff, hη]; exact h
    exact s1 I.subschemeι z η ξ hηz hη h
  · intro a ha
    rw [RingHom.mem_ker] at ha ⊢
    obtain ⟨U, hy, f, rfl⟩ := s4 C (I.subschemeι z) a
    have hξU : ξ ∈ (U : C.Opens) := h.mem_open (U : C.Opens).isOpen hy
    have hf : f ∈ I.ideal U := (s2 U f hξU).2 ((s3 _ h _ hy f).1 ha)
    have h0 : (I.subschemeι.app U).hom f = 0 := by
      rw [← RingHom.mem_ker, Scheme.IdealSheafData.ker_subschemeι_app]; exact hf
    rw [Scheme.Hom.germ_stalkMap_apply, h0, map_zero]

theorem wcpa_dj_p1rec_stalk_primes : ∀ (C : Scheme.{u}) (y ξ ξ' : C) (h : ξ ⤳ y) (h' : ξ' ⤳ y),
    (closure ({ξ} : Set C) ∈ irreducibleComponents C →
      RingHom.ker (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom ∈
        minimalPrimes (C.presheaf.stalk y)) ∧
    (RingHom.ker (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom =
      RingHom.ker (C.presheaf.stalkSpecializes h' ≫ C.residue ξ').hom → ξ = ξ') :=
by
  intro C y ξ ξ' h h'
  have s1 : ∀ (ζ : C) (hζ : ζ ⤳ y), C.fromSpecStalk y
      (⟨RingHom.ker (C.presheaf.stalkSpecializes hζ ≫ C.residue ζ).hom, RingHom.ker_isPrime _⟩ :
        PrimeSpectrum (C.presheaf.stalk y)) = ζ := by
    intro ζ hζ
    have e1 : Spec.map (C.presheaf.stalkSpecializes hζ ≫ C.residue ζ) ≫ C.fromSpecStalk y =
        C.fromSpecResidueField ζ := by
      rw [Spec.map_comp, Category.assoc, Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
      rfl
    obtain ⟨s⟩ : Nonempty (PrimeSpectrum (C.residueField ζ)) := inferInstance
    have hs : s.asIdeal = ⊥ := @Ideal.eq_bot_of_prime _ _ s.asIdeal s.isPrime
    have e2 : (Spec.map (C.presheaf.stalkSpecializes hζ ≫ C.residue ζ)) (s : Spec (C.residueField ζ)) =
        (⟨RingHom.ker (C.presheaf.stalkSpecializes hζ ≫ C.residue ζ).hom, RingHom.ker_isPrime _⟩ :
          PrimeSpectrum (C.presheaf.stalk y)) := by
      apply PrimeSpectrum.ext
      show Ideal.comap (C.presheaf.stalkSpecializes hζ ≫ C.residue ζ).hom s.asIdeal =
        RingHom.ker (C.presheaf.stalkSpecializes hζ ≫ C.residue ζ).hom
      rw [hs, RingHom.ker_eq_comap_bot]
    have e3 := Scheme.Hom.comp_apply (Spec.map (C.presheaf.stalkSpecializes hζ ≫ C.residue ζ))
      (C.fromSpecStalk y) (s : Spec (C.residueField ζ))
    rw [← e2, ← e3, e1]
    exact Scheme.fromSpecResidueField_apply ζ _
  refine ⟨fun hξ => ?_, fun heq => ?_⟩
  · set p : PrimeSpectrum (C.presheaf.stalk y) :=
      ⟨RingHom.ker (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom, RingHom.ker_isPrime _⟩
      with hp
    have hpξ : C.fromSpecStalk y p = ξ := s1 ξ h
    have hind : Topology.IsInducing (C.fromSpecStalk y) :=
      (C.fromSpecStalk y).isEmbedding.isInducing
    refine ⟨⟨RingHom.ker_isPrime _, bot_le⟩, fun Q hQ hle => ?_⟩
    let q : PrimeSpectrum (C.presheaf.stalk y) := ⟨Q, hQ.1⟩
    have hqp : q ⤳ p := (PrimeSpectrum.le_iff_specializes q p).mp hle
    have h1 : C.fromSpecStalk y q ⤳ ξ := hpξ ▸ hqp.map (C.fromSpecStalk y).continuous
    have h2 : closure ({ξ} : Set C) ⊆ closure {C.fromSpecStalk y q} :=
      specializes_iff_closure_subset.mp h1
    have h3 : closure ({ξ} : Set C) = closure {C.fromSpecStalk y q} :=
      hξ.eq_of_le isIrreducible_singleton.closure h2
    have h4 : ξ ⤳ C.fromSpecStalk y q := by
      rw [specializes_iff_mem_closure, h3]
      exact subset_closure rfl
    rw [← hpξ] at h4
    have h5 : p ⤳ q := hind.specializes_iff.mp h4
    exact (PrimeSpectrum.le_iff_specializes p q).mpr h5
  · rw [← s1 ξ h, ← s1 ξ' h']
    congr 1
    exact PrimeSpectrum.ext heq

theorem wcpa_dj_p1rec_other_component : ∀ (K : Type u) [Field K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) [IsProper q] (ξ y : C),
    closure ({ξ} : Set C) ∈ irreducibleComponents C →
    y ∈ closure (closure ({ξ} : Set C))ᶜ →
    ∃ ξ' : C, closure ({ξ'} : Set C) ∈ irreducibleComponents C ∧ ξ' ⤳ y ∧ ξ' ≠ ξ :=
by
  intro K _ C q _ ξ y hE hy
  haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian q
  haveI : CompactSpace C := QuasiCompact.compactSpace_of_compactSpace q
  haveI : AlgebraicGeometry.IsNoetherian C := AlgebraicGeometry.IsNoetherian.mk
  have hfin : (irreducibleComponents C).Finite :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  set E := closure ({ξ} : Set C) with hEdef
  set S := irreducibleComponents C \ {E} with hSdef
  have hSfin : S.Finite := hfin.subset Set.diff_subset
  have hScl : ∀ t ∈ S, IsClosed t := fun t ht => isClosed_of_mem_irreducibleComponents t ht.1
  have hU : IsClosed (⋃₀ S) := Set.Finite.isClosed_sUnion hSfin hScl
  have hsub : Eᶜ ⊆ ⋃₀ S := by
    intro x hx
    refine Set.mem_sUnion.mpr ⟨irreducibleComponent x, ⟨irreducibleComponent_mem_irreducibleComponents x, ?_⟩, mem_irreducibleComponent⟩
    intro h
    rw [Set.mem_singleton_iff] at h
    apply hx
    rw [← h]
    exact mem_irreducibleComponent
  have hyU : y ∈ ⋃₀ S := closure_minimal hsub hU hy
  obtain ⟨E', hE'S, hyE'⟩ := Set.mem_sUnion.mp hyU
  have hE'comp : E' ∈ irreducibleComponents C := hE'S.1
  have hE'ne : E' ≠ E := fun h => hE'S.2 (Set.mem_singleton_iff.mpr h)
  have hirr : IsIrreducible E' := hE'comp.1
  have hcl : IsClosed E' := isClosed_of_mem_irreducibleComponents E' hE'comp
  have hgen : IsGenericPoint hirr.genericPoint E' := hirr.isGenericPoint_genericPoint hcl
  refine ⟨hirr.genericPoint, ?_, hgen.specializes hyE', ?_⟩
  · rw [hgen.def]; exact hE'comp
  · intro h
    apply hE'ne
    rw [← hgen.def, h]

theorem wcpa_dj_p1rec_node_branch_valuation : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A]
    [IsLocalRing A] [IsNoetherianRing A] (P P' : Ideal A) [P.IsPrime] [P'.IsPrime],
    (AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
      (MvPowerSeries (Fin 2) K ⧸ Ideal.span
        {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)})) →
    P ∈ minimalPrimes A → P' ∈ minimalPrimes A → P ≠ P' → ValuationRing (A ⧸ P) :=
by
  intro K _ A _ _ _ P P' _ _ e hP hP' hne
  classical

  have hflat : Module.Flat A (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
    AdicCompletion.flat_of_isNoetherian (IsLocalRing.maximalIdeal A)
  have hff : Module.FaithfullyFlat A (AdicCompletion (IsLocalRing.maximalIdeal A) A) := by
    rw [Module.faithfullyFlat_iff]
    refine ⟨hflat, fun m hm h => ?_⟩
    rw [IsLocalRing.eq_maximalIdeal hm] at h
    have hev : ∀ x ∈ (IsLocalRing.maximalIdeal A) •
        (⊤ : Submodule A (AdicCompletion (IsLocalRing.maximalIdeal A) A)),
        AdicCompletion.evalOneₐ (IsLocalRing.maximalIdeal A) x = 0 := by
      intro x hx
      refine Submodule.smul_induction_on hx ?_ ?_
      · intro a ha n _
        rw [map_smul, Algebra.smul_def, Ideal.Quotient.algebraMap_eq,
          Ideal.Quotient.eq_zero_iff_mem.mpr ha, zero_mul]
      · intro x y hx hy
        rw [map_add, hx, hy, add_zero]
    have h1 := hev 1 (by rw [h]; exact Submodule.mem_top)
    rw [map_one] at h1
    exact one_ne_zero h1

  let σ : Fin 2 → MvPowerSeries (Fin 2) K →+* PowerSeries K := fun j =>
    { toFun := fun f => PowerSeries.mk (fun n => MvPowerSeries.coeff (Finsupp.single j n) f)
      map_one' := by
        ext n
        rw [PowerSeries.coeff_mk, MvPowerSeries.coeff_one, PowerSeries.coeff_one]
        simp
      map_mul' := by
        intro f g
        ext n
        rw [PowerSeries.coeff_mk, MvPowerSeries.coeff_mul, PowerSeries.coeff_mul,
          Finsupp.antidiagonal_single, Finset.sum_map]
        simp [PowerSeries.coeff_mk]
      map_zero' := by ext n; simp
      map_add' := by intro f g; ext n; simp }
  have hσc : ∀ (j : Fin 2) (f : MvPowerSeries (Fin 2) K) (n : ℕ),
      PowerSeries.coeff n (σ j f) = MvPowerSeries.coeff (Finsupp.single j n) f :=
    fun j f n => PowerSeries.coeff_mk n (fun n => MvPowerSeries.coeff (Finsupp.single j n) f)
  have hσX : ∀ i j : Fin 2, i ≠ j → σ j (MvPowerSeries.X i) = 0 := by
    intro i j hij
    ext n
    rw [hσc, MvPowerSeries.coeff_X, map_zero, if_neg]
    intro h
    have h2 := congrArg (fun m : Fin 2 →₀ ℕ => m i) h
    simp [Finsupp.single_apply, hij, Ne.symm hij] at h2
  have hσXne : ∀ j : Fin 2, σ j (MvPowerSeries.X j) ≠ 0 := by
    intro j h
    have h2 := congrArg (PowerSeries.coeff 1) h
    rw [hσc, MvPowerSeries.coeff_X, if_pos rfl, map_zero] at h2
    exact one_ne_zero h2
  have hσker : ∀ i j : Fin 2, i ≠ j → (∀ k : Fin 2, k ≠ j → k = i) →
      ∀ f, σ j f = 0 → MvPowerSeries.X i ∣ f := by
    intro i j hij hk f hf
    rw [MvPowerSeries.X_dvd_iff]
    intro m hm
    have hm' : m = Finsupp.single j (m j) := by
      ext k
      by_cases hkj : k = j
      · subst hkj; simp
      · rw [hk k hkj]
        simp [hm, Finsupp.single_apply, hij, Ne.symm hij]
    rw [hm', ← hσc, hf, map_zero]
  have hσsurj : ∀ j : Fin 2, Function.Surjective (σ j) := by
    intro j g
    let F : MvPowerSeries (Fin 2) K :=
      fun m => if m = Finsupp.single j (m j) then PowerSeries.coeff (m j) g else 0
    refine ⟨F, ?_⟩
    ext n
    have hF : MvPowerSeries.coeff (Finsupp.single j n) F =
        (if Finsupp.single j n = Finsupp.single j ((Finsupp.single j n) j)
          then PowerSeries.coeff ((Finsupp.single j n) j) g else 0) := rfl
    rw [hσc, hF]
    simp
  have hσspan : ∀ (j : Fin 2), ∀ a ∈ Ideal.span
      {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}, σ j a = 0 := by
    intro j a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, map_mul]
    fin_cases j
    · simp [hσX 1 0 (by decide)]
    · simp [hσX 0 1 (by decide)]

  let φ : Fin 2 → AdicCompletion (IsLocalRing.maximalIdeal A) A →+* PowerSeries K := fun j =>
    (Ideal.Quotient.lift _ (σ j) (hσspan j)).comp e.toRingHom
  have hφ : ∀ (j : Fin 2) (c : AdicCompletion (IsLocalRing.maximalIdeal A) A)
      (f : MvPowerSeries (Fin 2) K), e c = Ideal.Quotient.mk _ f → φ j c = σ j f := by
    intro j c f hf
    show Ideal.Quotient.lift _ (σ j) (hσspan j) (e c) = σ j f
    rw [hf, Ideal.Quotient.lift_mk]
  have hφsurj : ∀ j : Fin 2, Function.Surjective (φ j) := by
    intro j g
    obtain ⟨f, rfl⟩ := hσsurj j g
    obtain ⟨c, hc⟩ := e.surjective (Ideal.Quotient.mk _ f)
    exact ⟨c, hφ j c f hc⟩

  have hQinf : RingHom.ker (φ 0) ⊓ RingHom.ker (φ 1) = ⊥ := by
    rw [eq_bot_iff]
    intro c hc
    rw [Ideal.mem_inf, RingHom.mem_ker, RingHom.mem_ker] at hc
    obtain ⟨f, hf⟩ := Ideal.Quotient.mk_surjective (e c)
    rw [hφ 0 c f hf.symm] at hc
    rw [hφ 1 c f hf.symm] at hc
    obtain ⟨a, rfl⟩ := hσker 1 0 (by decide) (by decide) f hc.1
    have h2 := hc.2
    rw [map_mul] at h2
    have ha : σ 1 a = 0 := (mul_eq_zero.mp h2).resolve_left (hσXne 1)
    obtain ⟨b, rfl⟩ := hσker 0 1 (by decide) (by decide) a ha
    have hmem : MvPowerSeries.X 1 * (MvPowerSeries.X 0 * b) ∈ Ideal.span
        {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)} :=
      Ideal.mem_span_singleton'.mpr ⟨b, by ring⟩
    have hec : e c = 0 := by
      rw [← hf, Ideal.Quotient.eq_zero_iff_mem]
      exact hmem
    rw [Ideal.mem_bot]
    exact (map_eq_zero_iff e e.injective).mp hec
  have hQprime : ∀ j : Fin 2, (RingHom.ker (φ j)).IsPrime := fun j => RingHom.ker_isPrime _
  have hq : ∀ j : Fin 2, (Ideal.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
      (RingHom.ker (φ j))).IsPrime := by
    intro j
    haveI := hQprime j
    infer_instance

  have hcover : ∀ p : Ideal A, p.IsPrime →
      Ideal.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
        (RingHom.ker (φ 0)) ≤ p ∨
      Ideal.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
        (RingHom.ker (φ 1)) ≤ p := by
    intro p hp
    obtain ⟨𝔓, h𝔓, hlo⟩ := Ideal.exists_isPrime_liesOver_of_faithfullyFlat
      (B := AdicCompletion (IsLocalRing.maximalIdeal A) A) p
    have hp𝔓 : p = Ideal.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) 𝔓 :=
      hlo.over
    have hmul : RingHom.ker (φ 0) * RingHom.ker (φ 1) ≤ 𝔓 :=
      Ideal.mul_le_inf.trans (by rw [hQinf]; exact bot_le)
    rcases h𝔓.mul_le.mp hmul with h | h
    · left; rw [hp𝔓]; exact Ideal.comap_mono h
    · right; rw [hp𝔓]; exact Ideal.comap_mono h
  have hmin : ∀ (R : Ideal A), R ∈ minimalPrimes A → ∀ q : Ideal A, q.IsPrime → q ≤ R → q = R :=
    fun R hR q hq hle => le_antisymm hle (hR.2 ⟨hq, bot_le⟩ hle)
  have hPcase : ∀ R : Ideal A, R ∈ minimalPrimes A →
      Ideal.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
        (RingHom.ker (φ 0)) = R ∨
      Ideal.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
        (RingHom.ker (φ 1)) = R := by
    intro R hR
    rcases hcover R hR.1.1 with h | h
    · exact Or.inl (hmin R hR _ (hq 0) h)
    · exact Or.inr (hmin R hR _ (hq 1) h)

  have hkey : ∀ (j j' : Fin 2), RingHom.ker (φ j) ⊓ RingHom.ker (φ j') = ⊥ →
      Ideal.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
        (RingHom.ker (φ j)) = P →
      Ideal.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
        (RingHom.ker (φ j')) = P' →
      ValuationRing (A ⧸ P) := by
    intro j j' hinf hj hj'
    have hP'P : ¬ P' ≤ P := fun hle => hne (hmin P hP P' inferInstance hle).symm
    obtain ⟨y, hyP', hyP⟩ := Set.not_subset.mp hP'P
    have hyQ' : algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) y ∈
        RingHom.ker (φ j') := by
      rw [← Ideal.mem_comap, hj']
      exact hyP'

    have hmap : Ideal.map (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) P =
        RingHom.ker (φ j) := by
      apply le_antisymm
      · rw [← hj]; exact Ideal.map_comap_le
      · intro z hz
        have hyz : algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) y * z = 0 := by
          have h1 : algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) y * z ∈
              RingHom.ker (φ j) ⊓ RingHom.ker (φ j') :=
            ⟨Ideal.mul_mem_left _ _ hz, Ideal.mul_mem_right _ _ hyQ'⟩
          rw [hinf] at h1
          exact h1
        obtain ⟨k, a, w, hx, hf⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
          (R := A) (M := AdicCompletion (IsLocalRing.maximalIdeal A) A) (ι := Unit)
          (f := fun _ => y) (x := fun _ => z) (by simpa [Algebra.smul_def] using hyz)
        have hz' : z = ∑ i, a () i • w i := hx ()
        rw [hz']
        refine Ideal.sum_mem _ (fun i _ => ?_)
        have hai : y * a () i = 0 := by simpa using hf i
        have haP : a () i ∈ P := by
          rcases Ideal.IsPrime.mem_or_mem ‹P.IsPrime› (by rw [hai]; exact P.zero_mem) with h | h
          · exact absurd h hyP
          · exact h
        rw [Algebra.smul_def]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ haP)

    haveI : IsDomain (A ⧸ P) := Ideal.Quotient.isDomain P
    have hdesc : ∀ a b : A,
        φ j (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) ∣
          φ j (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) b) →
        Ideal.Quotient.mk P a ∣ Ideal.Quotient.mk P b := by
      intro a b ⟨t, ht⟩
      obtain ⟨d, rfl⟩ := hφsurj j t
      have hmem : algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) b -
          algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a * d ∈
          Ideal.map (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) P := by
        rw [hmap, RingHom.mem_ker, map_sub, map_mul, ht, sub_self]
      have hb : algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) b ∈
          Ideal.map (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
            (Ideal.span {a} ⊔ P) := by
        rw [Ideal.map_sup]
        have : algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) b =
            algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a * d +
            (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) b -
              algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a * d) := by ring
        rw [this]
        exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.mul_mem_right _ _
          (Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self a)))) (Ideal.mem_sup_right hmem)
      have hb' : b ∈ Ideal.span {a} ⊔ P := by
        rw [← Ideal.comap_map_eq_self_of_faithfullyFlat
          (B := AdicCompletion (IsLocalRing.maximalIdeal A) A) (Ideal.span {a} ⊔ P)]
        exact hb
      obtain ⟨c, p, hp, hcp⟩ := Ideal.mem_span_singleton_sup.mp hb'
      refine ⟨Ideal.Quotient.mk P c, ?_⟩
      rw [← hcp, map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hp, add_zero, map_mul, mul_comm]
    rw [ValuationRing.iff_dvd_total]
    constructor
    intro r s
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective r
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective s
    rcases ValuationRing.dvd_total
        (φ j (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a))
        (φ j (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) b)) with h | h
    · exact Or.inl (hdesc a b h)
    · exact Or.inr (hdesc b a h)

  have hinf' : RingHom.ker (φ 1) ⊓ RingHom.ker (φ 0) = ⊥ := by rw [inf_comm]; exact hQinf
  rcases hPcase P hP with h0 | h1
  · rcases hPcase P' hP' with h0' | h1'
    · exact absurd (h0.symm.trans h0') hne
    · exact hkey 0 1 hQinf h0 h1'
  · rcases hPcase P' hP' with h0' | h1'
    · exact hkey 1 0 hinf' h1 h0'
    · exact absurd (h1.symm.trans h1') hne

theorem wcpa_dj_p1rec_valuative_curve_P1 (K : Type u) [Field K] (Y : Scheme.{u})
    [AlgebraicGeometry.IsIntegral Y] (f : Y ⟶ Spec (.of K)) [IsProper f]
    (hval : ∀ y : Y, ValuationRing (Y.presheaf.stalk y))
    [Algebra K (Y.residueField (genericPoint Y))]
    (hA : algebraMap K (Y.residueField (genericPoint Y)) = wcpaDjFK K f (genericPoint Y))
    (ht : ∃ t : Y.residueField (genericPoint Y), Transcendental K t ∧
      IntermediateField.adjoin K {t} = ⊤) :
    ∃ θ : Y ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        MvPolynomial.gradedAlgebra,
      θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = f :=
by
  classical

  have s5 : ∀ (R : CommRingCat.{u}) (X : Scheme.{u}) (g : X ⟶ Spec R) (x : X),
      X.fromSpecStalk x ≫ g =
        Spec.map ((Scheme.ΓSpecIso R).inv ≫ g.appTop ≫ X.presheaf.germ ⊤ x trivial) := by
    intro R X g x
    have h1 : g = X.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso R).inv ≫ g.appTop) := by
      rw [Spec.map_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality, Category.assoc,
        ← SpecMap_ΓSpecIso_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id,
        Category.comp_id]
    conv_lhs => rw [h1]
    rw [← Category.assoc, Scheme.fromSpecStalk_toSpecΓ, ← Spec.map_comp, Category.assoc]

  have s3 : ∀ (X : Scheme.{u}) [IrreducibleSpace X],
      IsDominant (X.fromSpecStalk (genericPoint X)) := by
    intro X _
    have h1 : closure ({genericPoint X} : Set X) = Set.univ := (genericPoint_spec X).def
    refine ⟨?_⟩
    have hd : Dense ({genericPoint X} : Set X) := dense_iff_closure_eq.mpr h1
    refine hd.mono ?_
    rintro _ rfl
    rw [Scheme.range_fromSpecStalk]
    exact specializes_refl _

  have sext : ∀ (X Y' S : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] [S.IsSeparated]
      (sX : X ⟶ S) (sY : Y' ⟶ S) [IsProper sY]
      (hv : ∀ x : X, ValuationRing (X.presheaf.stalk x))
      (φ : Spec X.functionField ⟶ Y') (h : φ ≫ sY = X.fromSpecStalk (genericPoint X) ≫ sX),
      ∃ g : X ⟶ Y', g ≫ sY = sX ∧ X.fromSpecStalk (genericPoint X) ≫ g = φ := by
    intro X Y' S _ _ sX sY _ hv φ h
    have hdom := s3 X
    have hVC : ValuativeCriterion sY := by
      have h0 : (ValuativeCriterion ⊓ @QuasiCompact ⊓ @QuasiSeparated ⊓ @LocallyOfFiniteType)
          sY := by
        rw [← IsProper.eq_valuativeCriterion]; infer_instance
      exact h0.1.1.1
    set r := Scheme.RationalMap.ofFunctionField sX sY φ h with hr
    have htot : ∀ x : X, x ∈ r.domain := by
      intro x
      haveI := hv x
      have hdomx : IsDomain (X.presheaf.stalk x) :=
        Function.Injective.isDomain (algebraMap (X.presheaf.stalk x) X.functionField)
          (IsFractionRing.injective _ _)
      have hsp : genericPoint X ⤳ x := (genericPoint_spec X).specializes trivial
      have hsq : CommSq φ (Spec.map (CommRingCat.ofHom
          (algebraMap (X.presheaf.stalk x) X.functionField))) sY (X.fromSpecStalk x ≫ sX) := by
        constructor
        rw [h]
        show X.fromSpecStalk (genericPoint X) ≫ sX =
          Spec.map (X.presheaf.stalkSpecializes hsp) ≫ X.fromSpecStalk x ≫ sX
        rw [← Category.assoc, Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
      obtain ⟨l⟩ := (hVC.existence (@ValuativeCommSq.mk _ _ sY (X.presheaf.stalk x) _ hdomx
        (hv x) X.functionField _ _ _ φ (X.fromSpecStalk x ≫ sX) hsq)).exists_lift
      have hl1 : Spec.map (X.presheaf.stalkSpecializes hsp) ≫ l.l = φ := l.fac_left
      have hl2 : l.l ≫ sY = X.fromSpecStalk x ≫ sX := l.fac_right
      set p := Scheme.PartialMap.ofFromSpecStalk sX sY l.l hl2 with hp
      have hx : x ∈ p.domain := Scheme.PartialMap.mem_domain_ofFromSpecStalk sX sY l.l hl2
      have hfs : p.fromSpecStalkOfMem hx = l.l :=
        Scheme.PartialMap.fromSpecStalkOfMem_ofFromSpecStalk sX sY l.l hl2
      have hη : genericPoint X ∈ p.domain :=
        ((genericPoint_spec X).mem_open_set_iff p.domain.isOpen).mpr ⟨x, trivial, hx⟩
      have hclaim : Spec.map (X.presheaf.stalkSpecializes hsp) ≫
          p.domain.fromSpecStalkOfMem x hx = p.domain.fromSpecStalkOfMem (genericPoint X) hη := by
        rw [← cancel_mono p.domain.ι, Category.assoc, Scheme.Opens.fromSpecStalkOfMem_ι,
          Scheme.Opens.fromSpecStalkOfMem_ι, Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
      have hpf : p.fromFunctionField = φ := by
        show p.domain.fromSpecStalkOfMem (genericPoint X) _ ≫ p.hom = φ
        rw [← hclaim, Category.assoc]
        change Spec.map (X.presheaf.stalkSpecializes hsp) ≫ p.fromSpecStalkOfMem hx = φ
        rw [hfs, hl1]
      refine Scheme.RationalMap.mem_domain.mpr ⟨p, hx, ?_⟩
      apply Scheme.RationalMap.eq_of_fromFunctionField_eq
      rw [Scheme.RationalMap.fromFunctionField_toRationalMap, hpf,
        Scheme.RationalMap.fromFunctionField_ofFunctionField]
    haveI : Y'.IsSeparated := by
      refine ⟨?_⟩
      rw [← Limits.terminal.comp_from sY]
      infer_instance
    set Dm := r.toPartialMap with hDm
    have hdomD : Dm.domain = ⊤ := eq_top_iff.mpr (fun x _ => htot x)
    have hfac : X.fromSpecStalk (genericPoint X) ≫
        (X.topIso.inv ≫ (X.isoOfEq hdomD).inv ≫ Dm.hom) = φ := by
      have hη : genericPoint X ∈ Dm.domain := htot _
      have hk : X.fromSpecStalk (genericPoint X) ≫ X.topIso.inv ≫ (X.isoOfEq hdomD).inv =
          Dm.domain.fromSpecStalkOfMem (genericPoint X) hη := by
        rw [← cancel_mono Dm.domain.ι, Scheme.Opens.fromSpecStalkOfMem_ι, Category.assoc,
          Category.assoc, ← Scheme.isoOfEq_hom_ι X hdomD, Iso.inv_hom_id_assoc,
          ← Scheme.topIso_hom, Iso.inv_hom_id, Category.comp_id]
      rw [← Category.assoc, ← Category.assoc, Category.assoc _ X.topIso.inv, hk]
      change Dm.fromFunctionField = φ
      rw [← Scheme.RationalMap.fromFunctionField_toRationalMap, hDm,
        Scheme.RationalMap.toRationalMap_toPartialMap,
        Scheme.RationalMap.fromFunctionField_ofFunctionField]
    refine ⟨X.topIso.inv ≫ (X.isoOfEq hdomD).inv ≫ Dm.hom, ?_, hfac⟩
    haveI := hdom
    refine ext_of_isDominant_of_isSeparated (Limits.terminal.from S) ?_
      (X.fromSpecStalk (genericPoint X)) ?_
    · exact Limits.terminal.hom_ext _ _
    · rw [← Category.assoc, hfac, h]

  have s4 : ∀ (X Y S : Scheme.{u}) [AlgebraicGeometry.IsIntegral X]
      [AlgebraicGeometry.IsIntegral Y] (sX : X ⟶ S) (sY : Y ⟶ S) [IsSeparated sX]
      [IsSeparated sY] (F : X ⟶ Y) (G : Y ⟶ X) (a : Y.functionField ⟶ X.functionField)
      (b : X.functionField ⟶ Y.functionField), b ≫ a = 𝟙 _ → a ≫ b = 𝟙 _ →
      F ≫ sY = sX → G ≫ sX = sY →
      X.fromSpecStalk (genericPoint X) ≫ F = Spec.map a ≫ Y.fromSpecStalk (genericPoint Y) →
      Y.fromSpecStalk (genericPoint Y) ≫ G = Spec.map b ≫ X.fromSpecStalk (genericPoint X) →
      F ≫ G = 𝟙 X ∧ G ≫ F = 𝟙 Y := by
    intro X Y S _ _ sX sY _ _ F G a b hba hab hF hG h1 h2
    haveI := s3 X
    haveI := s3 Y
    constructor
    · refine ext_of_isDominant_of_isSeparated sX ?_ (X.fromSpecStalk (genericPoint X)) ?_
      · rw [Category.assoc, hG, hF, Category.id_comp]
      · rw [← Category.assoc, h1, Category.assoc, h2, ← Category.assoc, ← Spec.map_comp,
          hba, Spec.map_id, Category.id_comp, Category.comp_id]
    · refine ext_of_isDominant_of_isSeparated sY ?_ (Y.fromSpecStalk (genericPoint Y)) ?_
      · rw [Category.assoc, hF, hG, Category.id_comp]
      · rw [← Category.assoc, h2, Category.assoc, h1, ← Category.assoc, ← Spec.map_comp,
          hab, Spec.map_id, Category.id_comp, Category.comp_id]

  have s9 : ∀ (L M : Type u) [Field L] [Field M] (α : K →+* L) (β : K →+* M) (s : L) (m : M),
      (∀ p : Polynomial K, p.eval₂ α s = 0 → p = 0) →
      (∀ z : L, ∃ p q : Polynomial K, z = p.eval₂ α s / q.eval₂ α s) →
      (∀ p : Polynomial K, p.eval₂ β m = 0 → p = 0) →
      (∀ z : M, ∃ p q : Polynomial K, z = p.eval₂ β m / q.eval₂ β m) →
      ∃ σ : M ≃+* L, ∀ c : K, σ (β c) = α c := by
    intro L M _ _ α β s m h1 h2 h3 h4
    letI iL : Algebra (Polynomial K) L := (Polynomial.eval₂RingHom α s).toAlgebra
    letI iM : Algebra (Polynomial K) M := (Polynomial.eval₂RingHom β m).toAlgebra
    have injL : Function.Injective (algebraMap (Polynomial K) L) := by
      rw [injective_iff_map_eq_zero]
      exact fun p hp => h1 p hp
    have injM : Function.Injective (algebraMap (Polynomial K) M) := by
      rw [injective_iff_map_eq_zero]
      exact fun p hp => h3 p hp
    haveI : FaithfulSMul (Polynomial K) L := (faithfulSMul_iff_algebraMap_injective _ _).mpr injL
    haveI : FaithfulSMul (Polynomial K) M := (faithfulSMul_iff_algebraMap_injective _ _).mpr injM
    haveI : IsFractionRing (Polynomial K) L := IsFractionRing.of_field _ _ h2
    haveI : IsFractionRing (Polynomial K) M := IsFractionRing.of_field _ _ h4
    refine ⟨(IsLocalization.algEquiv (nonZeroDivisors (Polynomial K)) M L).toRingEquiv, ?_⟩
    intro c
    have := (IsLocalization.algEquiv (nonZeroDivisors (Polynomial K)) M L).commutes
      (Polynomial.C c)
    have e1 : algebraMap (Polynomial K) M (Polynomial.C c) = β c := Polynomial.eval₂_C _ _
    have e2 : algebraMap (Polynomial K) L (Polynomial.C c) = α c := Polynomial.eval₂_C _ _
    rw [e1, e2] at this
    exact this

  have genP : ∀ (A B L : Type u) [CommRing A] [CommRing B] [Field L]
      (e : MvPolynomial (Fin 1) K ≃+* A) (a : A →+* B) (g : B →+* L) (c : K →+* L),
      Function.Bijective a → Function.Injective g → (∀ z : L, ∃ x y : B, z = g x / g y) →
      (∀ k, g (a (e (MvPolynomial.C k))) = c k) →
      ∃ x : L, (∀ p : Polynomial K, p.eval₂ c x = 0 → p = 0) ∧
        ∀ z : L, ∃ p q : Polynomial K, z = p.eval₂ c x / q.eval₂ c x := by
    intro A B L _ _ _ e a g c ha hg hfr hk
    obtain ⟨ψ, hψinj, hψC, hψfr⟩ : ∃ ψ : MvPolynomial (Fin 1) K →+* L, Function.Injective ψ ∧
        ψ.comp MvPolynomial.C = c ∧ ∀ z : L, ∃ P Q, z = ψ P / ψ Q := by
      refine ⟨g.comp (a.comp e.toRingHom), hg.comp (ha.1.comp e.injective),
        RingHom.ext fun k => hk k, ?_⟩
      intro z
      obtain ⟨x, y, hxy⟩ := hfr z
      obtain ⟨P, rfl⟩ := (ha.2.comp e.surjective) x
      obtain ⟨Q, rfl⟩ := (ha.2.comp e.surjective) y
      exact ⟨P, Q, hxy⟩
    set v : MvPolynomial (Fin 1) K →+* Polynomial K :=
      MvPolynomial.eval₂Hom Polynomial.C (fun _ => Polynomial.X) with hv
    set w : Polynomial K →+* MvPolynomial (Fin 1) K :=
      Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0) with hw
    have hvw : v.comp w = RingHom.id _ := by
      apply Polynomial.ringHom_ext
      · intro k
        simp [hv, hw]
      · simp [hv, hw]
    have hψw : ψ.comp w = Polynomial.eval₂RingHom c (ψ (MvPolynomial.X 0)) := by
      apply Polynomial.ringHom_ext
      · intro k
        simp only [hw, RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        exact RingHom.congr_fun hψC k
      · simp [hw]
    have hψv : ψ = (Polynomial.eval₂RingHom c (ψ (MvPolynomial.X 0))).comp v := by
      apply MvPolynomial.ringHom_ext
      · intro k
        simp only [hv, RingHom.comp_apply, MvPolynomial.eval₂Hom_C, Polynomial.coe_eval₂RingHom,
          Polynomial.eval₂_C]
        exact RingHom.congr_fun hψC k
      · intro i
        rw [Subsingleton.elim i 0]
        simp [hv]
    refine ⟨ψ (MvPolynomial.X 0), ?_, ?_⟩
    · intro p hp
      have hp' : ψ (w p) = 0 := by
        rw [← RingHom.comp_apply, hψw]
        exact hp
      have h0 : w p = 0 := hψinj (hp'.trans (map_zero ψ).symm)
      have := RingHom.congr_fun hvw p
      rw [RingHom.comp_apply, h0, map_zero] at this
      exact this.symm
    · intro z
      obtain ⟨P, Q, hPQ⟩ := hψfr z
      refine ⟨v P, v Q, ?_⟩
      have e1 : ∀ R, ψ R = Polynomial.eval₂ c (ψ (MvPolynomial.X 0)) (v R) := by
        intro R
        conv_lhs => rw [hψv]
        rfl
      rw [← e1, ← e1]
      exact hPQ

  have genY : ∀ (L M : Type u) [Field L] [Field M] [Algebra K M]
      (c : K →+* L) (ρ : L →+* M), Function.Bijective ρ → algebraMap K M = ρ.comp c →
      (∃ t : M, Transcendental K t ∧ IntermediateField.adjoin K {t} = ⊤) →
      ∃ t₀ : L, (∀ p : Polynomial K, p.eval₂ c t₀ = 0 → p = 0) ∧
        ∀ z : L, ∃ p q : Polynomial K, z = p.eval₂ c t₀ / q.eval₂ c t₀ := by
    intro L M _ _ _ c ρ hρ hA' ht'
    obtain ⟨t, htr, hadj⟩ := ht'
    obtain ⟨t₀, rfl⟩ := hρ.2 t
    have key : ∀ p : Polynomial K, ρ (p.eval₂ c t₀) = Polynomial.aeval (ρ t₀) p := by
      intro p
      rw [Polynomial.hom_eval₂, ← hA', Polynomial.aeval_def]
    refine ⟨t₀, ?_, ?_⟩
    · intro p hp
      apply (transcendental_iff.mp htr) p
      rw [← key, hp, map_zero]
    · intro z
      have hz : ρ z ∈ IntermediateField.adjoin K {ρ t₀} := by rw [hadj]; trivial
      obtain ⟨r, s, hrs⟩ := (IntermediateField.mem_adjoin_simple_iff K _).mp hz
      refine ⟨r, s, hρ.1 ?_⟩
      rw [map_div₀, key, key]
      exact hrs

  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) K) := MvPolynomial.gradedAlgebra
  haveI hPint : AlgebraicGeometry.IsIntegral (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K)) :=
    (wc_projK_integral_normal K 1).1
  haveI hPprop : IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) K) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0)))) :=
    wc_pp_proper K 1
  haveI hPsm : SmoothOfRelativeDimension 1
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) K) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0)))) :=
    wc_proj_space_smooth K 1
  have hvalP : ∀ w : Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K),
      ValuationRing ((Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K)).presheaf.stalk w) :=
    fun w => wcpa_dj_sgt_smooth_curve_stalk_valuation K _
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) K) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))))
      w

  have hdeg : (MvPolynomial.X 0 : MvPolynomial (Fin 2) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin 2) K 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K 0)
  have hm : (0 : ℕ) < 1 := Nat.one_pos
  have hη : genericPoint (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K)) ∈
      Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0) := by
    obtain ⟨y, hy⟩ := (wcpa_dj_gs_bf_P1_dense K).nonempty
    exact ((genericPoint_spec _).mem_open_set_iff (Proj.basicOpen _ _).isOpen).mpr
      ⟨y, trivial, hy⟩

  have hc : (Scheme.ΓSpecIso (.of K)).inv ≫
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) K) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0)))).appTop ≫
      (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K)).presheaf.germ ⊤
        (genericPoint (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K))) trivial =
      CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0)) ≫
      CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin 2) K) (Submonoid.powers (MvPolynomial.X 0))) ≫
      Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0) ≫
      (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K)).presheaf.germ
        (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0))
        (genericPoint (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K))) hη := by
    apply Spec.map_injective
    rw [← s5]
    have hι : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        (MvPolynomial.X 0)).ι = (Proj.basicOpenIsoSpec _ (MvPolynomial.X 0) hdeg hm).hom ≫
        Proj.awayι _ (MvPolynomial.X 0) hdeg hm :=
      (Iso.inv_comp_eq _).mp (Proj.basicOpenIsoSpec_inv_ι _ (MvPolynomial.X 0) hdeg hm)
    rw [← Scheme.Opens.fromSpecStalkOfMem_ι (Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0)) _ hη, hι,
      Proj.basicOpenIsoSpec_hom]
    simp only [Category.assoc]
    rw [Proj.awayι_toSpecZero_assoc]
    unfold Proj.basicOpenToSpec
    simp only [Category.assoc]
    erw [reassoc_of% (Scheme.Opens.fromSpecStalkOfMem_toSpecΓ (Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0)) _ hη)]
    simp only [Spec.map_comp, Category.assoc]

  obtain ⟨e, he⟩ : ∃ e : MvPolynomial (Fin 1) K ≃+* HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0),
      ∀ c : K, e (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin 2) K) (Submonoid.powers (MvPolynomial.X 0))
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0) c) :=
    wc_pp_dehomogenize_ringEquiv K 1 0
  haveI hisoaw : IsIso (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin 2) K)
      (MvPolynomial.X 0)) := by
    rw [← Proj.basicOpenIsoAway_hom _ (MvPolynomial.X 0) hdeg hm]
    infer_instance
  haveI hneD : Nonempty (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K)
      (MvPolynomial.X 0)) := ⟨⟨_, hη⟩⟩
  haveI hfrD := functionField_isFractionRing_of_isAffineOpen
    (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K))
    (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0))
    (Proj.isAffineOpen_basicOpen _ (MvPolynomial.X 0) hdeg hm)
  obtain ⟨xP, hxP1, hxP2⟩ := genP _ _ _ e
    (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0)).hom
    ((Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K)).presheaf.germ
        (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0))
        (genericPoint (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K))) hη).hom
    ((Scheme.ΓSpecIso (.of K)).inv ≫
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) K) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0)))).appTop ≫
      (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K)).presheaf.germ ⊤
        (genericPoint (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K))) trivial).hom
    (ConcreteCategory.bijective_of_isIso _)
    (germ_injective_of_isIntegral _ _ hη)
    (fun z => by
      obtain ⟨x, y, _, hxy⟩ := IsFractionRing.div_surjective
        (A := Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K),
          Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) K) (MvPolynomial.X 0))) z
      exact ⟨x, y, hxy.symm⟩)
    (fun k => by rw [hc, he k]; rfl)
  have hρbij : Function.Bijective (Y.residue (genericPoint Y)).hom :=
    ⟨RingHom.injective _, Scheme.residue_surjective _ _⟩
  obtain ⟨tY, htY1, htY2⟩ := genY _ _
    ((Scheme.ΓSpecIso (.of K)).inv ≫ f.appTop ≫ Y.presheaf.germ ⊤ (genericPoint Y) trivial).hom
    (Y.residue (genericPoint Y)).hom hρbij (by rw [hA]; rfl) ht

  obtain ⟨σ, hσ⟩ := s9 _ _ _ _ xP tY hxP1 hxP2 htY1 htY2
  set cP := (Scheme.ΓSpecIso (.of K)).inv ≫
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) K) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0)))).appTop ≫
      (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K)).presheaf.germ ⊤
        (genericPoint (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K))) trivial with hcP
  set cY := (Scheme.ΓSpecIso (.of K)).inv ≫ f.appTop ≫
      Y.presheaf.germ ⊤ (genericPoint Y) trivial with hcY
  let a : (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K)).functionField ⟶ Y.functionField :=
    CommRingCat.ofHom σ.symm.toRingHom
  let b : Y.functionField ⟶ (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K)).functionField :=
    CommRingCat.ofHom σ.toRingHom
  have hca : cP ≫ a = cY := by
    ext k
    show σ.symm (cP.hom k) = cY.hom k
    rw [← hσ k, RingEquiv.symm_apply_apply]
  have hcb : cY ≫ b = cP := by
    ext k
    exact hσ k
  have hab : a ≫ b = 𝟙 _ := by
    ext z
    show σ (σ.symm z) = z
    exact RingEquiv.apply_symm_apply σ z
  have hba : b ≫ a = 𝟙 _ := by
    ext z
    show σ.symm (σ z) = z
    exact RingEquiv.symm_apply_apply σ z

  obtain ⟨F, hF1, hF2⟩ := sext Y (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K))
    (Spec (.of K)) f
    (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) K) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))))
    hval (Spec.map a ≫ (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K)).fromSpecStalk
      (genericPoint (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K))))
    (by rw [Category.assoc, s5, s5, ← Spec.map_comp, hca])

  obtain ⟨G, hG1, hG2⟩ := sext (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K)) Y
    (Spec (.of K))
    (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) K) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))))
    f hvalP (Spec.map b ≫ Y.fromSpecStalk (genericPoint Y))
    (by rw [Category.assoc, s5, s5, ← Spec.map_comp, hcb])

  obtain ⟨hFG, hGF⟩ := s4 Y (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K)) (Spec (.of K))
    f (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) K) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))))
    F G a b hba hab hF1 hG1 hF2 hG2
  exact ⟨⟨F, G, hFG, hGF⟩, hF1⟩

theorem wcpa_dj_p1rec_residue_transfer (K : Type u) [Field K] (C Er : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (ι : Er ⟶ C) [SurjectiveOnStalks ι] (z : Er) (y : C) (hy : ι z = y)
    [Algebra K (C.residueField y)] [Algebra K (Er.residueField z)]
    (hA : algebraMap K (C.residueField y) = wcpaDjFK K q y)
    (hA' : algebraMap K (Er.residueField z) = wcpaDjFK K (ι ≫ q) z)
    (ht : ∃ t : C.residueField y, IntermediateField.adjoin K {t} = ⊤) :
    ∃ t' : Er.residueField z, IntermediateField.adjoin K {t'} = ⊤ :=
by
  subst hy
  obtain ⟨t, hadj⟩ := ht
  have hres : ∀ a, (ι.residueFieldMap z).hom ((C.residue (ι z)).hom a) =
      (Er.residue z).hom ((ι.stalkMap z).hom a) := by
    intro a
    have h := congrArg (fun φ => φ.hom a) (Scheme.residue_residueFieldMap ι z)
    simpa using h
  have hsurj : Function.Surjective (ι.residueFieldMap z).hom := by
    intro x
    obtain ⟨a, rfl⟩ := Er.residue_surjective z x
    obtain ⟨b, rfl⟩ := ι.stalkMap_surjective z a
    exact ⟨_, hres b⟩
  have hK : ∀ c : K, (ι.residueFieldMap z).hom (wcpaDjFK K q (ι z) c) =
      wcpaDjFK K (ι ≫ q) z c := by
    intro c
    have hg := Scheme.Hom.germ_stalkMap_apply ι ⊤ z trivial
      (q.appTop ((Scheme.ΓSpecIso (.of K)).inv c))
    simp only [wcpaDjFK, CommRingCat.hom_comp, RingHom.comp_apply, Scheme.Hom.comp_appTop]
    rw [hres]
    congr 1
  let f : C.residueField (ι z) →ₐ[K] Er.residueField z :=
    { toRingHom := (ι.residueFieldMap z).hom
      commutes' := fun c => by rw [hA, hA']; exact hK c }
  refine ⟨f t, ?_⟩
  have hmap : IntermediateField.adjoin K {f t} =
      (IntermediateField.adjoin K {t}).map f := by
    rw [IntermediateField.adjoin_map, Set.image_singleton]
  rw [hmap, hadj, eq_top_iff]
  intro x _
  obtain ⟨s, hs⟩ := hsurj x
  exact (IntermediateField.mem_map _).mpr ⟨s, IntermediateField.mem_top, hs⟩

theorem wcpa_dj_csp_P1_recognition (K : Type u) [Field K] [IsAlgClosed K] (C : Scheme.{u})
    (q : C ⟶ Spec (.of K)) (hss : wcpaDjSemistable q) (ξ : C)
    (hξ : closure {ξ} ∈ irreducibleComponents C)
    [Algebra K (C.residueField ξ)] (hA : algebraMap K (C.residueField ξ) = wcpaDjFK K q ξ)
    (hnodes : ∀ c ∈ closure ({ξ} : Set C), IsClosed ({c} : Set C) →
      (¬ ∃ W : C.Opens, c ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q)) →
      c ∈ closure (closure ({ξ} : Set C))ᶜ)
    (ht : ∃ t : C.residueField ξ, IntermediateField.adjoin K {t} = ⊤) :
    ∃ (Er : Scheme.{u}) (ι : Er ⟶ C)
      (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        MvPolynomial.gradedAlgebra),
      IsClosedImmersion ι ∧ AlgebraicGeometry.IsReduced Er ∧ Set.range ι = closure {ξ} ∧
      θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = ι ≫ q :=
by
  classical

  haveI : IsProper q := hss.2.1
  haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian q
  have hξnc : ¬ IsClosed ({ξ} : Set C) := (wcpa_dj_lsp_generic_smooth K C q hss ξ hξ).1

  have hΦ : (asIso (Limits.pullback.fst q (𝟙 (Spec (.of K))))).symm.hom ≫
      Limits.pullback.snd q (𝟙 (Spec (.of K))) = q := by
    simp only [Iso.symm_hom, asIso_inv]
    rw [IsIso.inv_comp_eq, Limits.pullback.condition, Category.comp_id]
  have hdich := fun y : C => wcpa_dj_ssp_bw_ns_transport K
    (asIso (Limits.pullback.fst q (𝟙 (Spec (.of K))))).symm
    q (Limits.pullback.snd q (𝟙 (Spec (.of K)))) hΦ y (hss.2.2 K (𝟙 _) _)

  obtain ⟨Er, ι, hci, hrange, hker⟩ := wcpa_dj_p1rec_reduced_component C ξ
  haveI := hci
  have hspec : ∀ z : Er, ξ ⤳ ι z := fun z =>
    specializes_iff_mem_closure.mpr (by rw [← hrange]; exact Set.mem_range_self z)

  have hdom : ∀ z : Er, IsDomain (Er.presheaf.stalk z) := by
    intro z
    have hs := ι.stalkMap_surjective z
    let e1 := RingHom.quotientKerEquivOfSurjective hs
    let e2 := Ideal.quotEquivOfEq (hker z (hspec z))
    let g : Er.presheaf.stalk z →+* C.residueField ξ :=
      (RingHom.kerLift (C.presheaf.stalkSpecializes (hspec z) ≫ C.residue ξ).hom).comp
        (e2.toRingHom.comp e1.symm.toRingHom)
    have hg : Function.Injective g :=
      (RingHom.kerLift_injective _).comp (e2.injective.comp e1.symm.injective)
    exact Function.Injective.isDomain g hg
  haveI : ∀ z : Er, _root_.IsReduced (Er.presheaf.stalk z) := fun z => by
    haveI := hdom z
    infer_instance
  haveI hred : AlgebraicGeometry.IsReduced Er := isReduced_of_isReduced_stalk Er
  haveI hirr : IrreducibleSpace Er := by
    have hE : IsIrreducible (Set.range ι) := by
      rw [hrange]; exact isIrreducible_singleton.closure
    haveI : IrreducibleSpace (Set.range ι) := Subtype.irreducibleSpace hE
    let e := ι.isClosedEmbedding.toIsEmbedding.toHomeomorph
    exact Function.Surjective.irreducibleSpace e.symm.continuous e.symm.surjective
  haveI hint : AlgebraicGeometry.IsIntegral Er := isIntegral_of_irreducibleSpace_of_isReduced Er

  have hιη : ι (genericPoint Er) = ξ := by
    have h1 := (genericPoint_spec Er).image ι.continuous
    rw [Set.image_univ, hrange, closure_closure] at h1
    exact h1.eq isGenericPoint_closure

  have hval : ∀ z : Er, ValuationRing (Er.presheaf.stalk z) := by
    intro z
    haveI := hdom z
    have hs := ι.stalkMap_surjective z
    by_cases hsm : ∃ W : C.Opens, ι z ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q)
    · obtain ⟨W, hyW, hWs⟩ := hsm
      haveI : SmoothOfRelativeDimension 1 (W.ι ≫ q) := hWs
      haveI : Smooth (W.ι ≫ q) := SmoothOfRelativeDimension.smooth 1 _
      haveI := (wc_fntame_smooth_stalk_normal K W.toScheme (W.ι ≫ q) ⟨ι z, hyW⟩).1
      haveI := wcpa_dj_sgt_smooth_curve_stalk_valuation K W.toScheme (W.ι ≫ q) ⟨ι z, hyW⟩
      let e := (W.stalkIso ⟨ι z, hyW⟩).commRingCatIsoToRingEquiv
      exact Function.Surjective.valuationRing ((ι.stalkMap z).hom.comp e.toRingHom)
        (hs.comp e.surjective)
    · obtain ⟨e, he⟩ := (hdich (ι z)).resolve_left hsm
      have hyE : ι z ∈ closure ({ξ} : Set C) := by rw [← hrange]; exact Set.mem_range_self z
      have hFK : Function.Surjective (wcpaDjFK K q (ι z)) := by
        have := wcpa_dj_p1rec_node_residue K (C.presheaf.stalk (ι z))
          ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ (ι z) trivial).hom ⟨e, he⟩
        exact this
      have hcl := wcpa_dj_p1rec_rational_closed K C q (ι z) hFK
      have hyc := hnodes (ι z) hyE hcl hsm
      obtain ⟨ξ', hξ', h', hne⟩ := wcpa_dj_p1rec_other_component K C q ξ (ι z) hξ hyc
      have hPmin := (wcpa_dj_p1rec_stalk_primes C (ι z) ξ ξ' (hspec z) h').1 hξ
      have hP'min := (wcpa_dj_p1rec_stalk_primes C (ι z) ξ' ξ h' (hspec z)).1 hξ'
      have hPP' : RingHom.ker (C.presheaf.stalkSpecializes (hspec z) ≫ C.residue ξ).hom ≠
          RingHom.ker (C.presheaf.stalkSpecializes h' ≫ C.residue ξ').hom := fun heq =>
        hne ((wcpa_dj_p1rec_stalk_primes C (ι z) ξ ξ' (hspec z) h').2 heq).symm
      haveI : (RingHom.ker (C.presheaf.stalkSpecializes (hspec z) ≫ C.residue ξ).hom).IsPrime :=
        RingHom.ker_isPrime _
      haveI : (RingHom.ker (C.presheaf.stalkSpecializes h' ≫ C.residue ξ').hom).IsPrime :=
        RingHom.ker_isPrime _
      haveI := wcpa_dj_p1rec_node_branch_valuation K (C.presheaf.stalk (ι z))
        (RingHom.ker (C.presheaf.stalkSpecializes (hspec z) ≫ C.residue ξ).hom)
        (RingHom.ker (C.presheaf.stalkSpecializes h' ≫ C.residue ξ').hom) e hPmin hP'min hPP'
      let e1 := RingHom.quotientKerEquivOfSurjective hs
      let e2 := Ideal.quotEquivOfEq (hker z (hspec z))
      exact Function.Surjective.valuationRing (e1.toRingHom.comp e2.symm.toRingHom)
        (e1.surjective.comp e2.symm.surjective)

  letI : Algebra K (Er.residueField (genericPoint Er)) :=
    (wcpaDjFK K (ι ≫ q) (genericPoint Er)).toAlgebra
  have hAη : algebraMap K (Er.residueField (genericPoint Er)) =
      wcpaDjFK K (ι ≫ q) (genericPoint Er) := rfl
  obtain ⟨t', hadj⟩ := wcpa_dj_p1rec_residue_transfer K C Er q ι (genericPoint Er) ξ hιη hA hAη ht
  have htr : Transcendental K t' := by
    intro halg
    have hint' : IsIntegral K t' := halg.isIntegral
    have hdeg : (minpoly K t').degree = 1 :=
      IsAlgClosed.degree_eq_one_of_irreducible K (minpoly.irreducible hint')
    have hmem : t' ∈ (algebraMap K (Er.residueField (genericPoint Er))).range :=
      minpoly.mem_range_of_degree_eq_one K t' hdeg
    have hbot : IntermediateField.adjoin K {t'} = ⊥ :=
      IntermediateField.adjoin_simple_eq_bot_iff.mpr
        (IntermediateField.mem_bot.mpr (RingHom.mem_range.mp hmem))
    have hsurjF : Function.Surjective (wcpaDjFK K (ι ≫ q) (genericPoint Er)) := by
      intro x
      have hx : x ∈ (⊥ : IntermediateField K (Er.residueField (genericPoint Er))) := by
        rw [← hbot, hadj]; trivial
      exact IntermediateField.mem_bot.mp hx
    have hcl := wcpa_dj_p1rec_rational_closed K Er (ι ≫ q) (genericPoint Er) hsurjF
    apply hξnc
    have h2 := ι.isClosedEmbedding.isClosedMap _ hcl
    rwa [Set.image_singleton, hιη] at h2

  obtain ⟨θ, hθ⟩ := wcpa_dj_p1rec_valuative_curve_P1 K Er (ι ≫ q) hval hAη ⟨t', htr, hadj⟩
  exact ⟨Er, ι, θ, hci, hred, hrange, hθ⟩

theorem wcpa_dj_lus_cvs_ct_component_P1 : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : ValuationSubring K), IsAlgClosed (IsLocalRing.ResidueField ↥R) → ∀ (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)), wcpaDjSemistable v →
    ∀ E ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))),
    (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra), IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧ θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = ι ≫ Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) →
    ∀ D ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))),
    (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) '' D ⊆ closure ((Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) '' E) →
    ∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥R)) MvPolynomial.gradedAlgebra), IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = D ∧ θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥R)) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField ↥R) ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥R) 0))) = ι ≫ Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) :=
by
  intro K _ _ R hκ Y v hss E hE hP1E D hD hsub
  have hssq : wcpaDjSemistable (Limits.pullback.snd v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) :=
    wcpa_dj_mm_semistable_basechange _ _ _ _ v hss
  set ξ := hD.1.genericPoint with hξdef
  have hξD : closure {ξ} = D := by
    have h1 := hD.1.isGenericPoint_genericPoint_closure
    rw [(isClosed_of_mem_irreducibleComponents D hD).closure_eq] at h1
    exact h1
  letI : Algebra (IsLocalRing.ResidueField ↥R)
      ((Limits.pullback v (Spec.map (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))).residueField ξ) :=
    (wcpaDjFK (IsLocalRing.ResidueField ↥R) (Limits.pullback.snd v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) ξ).toAlgebra
  have hA : algebraMap (IsLocalRing.ResidueField ↥R)
      ((Limits.pullback v (Spec.map (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))).residueField ξ) =
      wcpaDjFK (IsLocalRing.ResidueField ↥R) (Limits.pullback.snd v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) ξ :=
    RingHom.algebraMap_toAlgebra _
  have ht := wcpa_dj_lus_cvs_ct_cp1_rational_residue K R hκ Y v hss E hE hP1E D hD hsub ξ hξD hA
  have hξ : closure {ξ} ∈ irreducibleComponents ↥(Limits.pullback v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) := by
    rw [hξD]; exact hD
  have hnodes : ∀ x ∈ closure ({ξ} : Set ↥(Limits.pullback v
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))))),
      IsClosed ({x} : Set ↥(Limits.pullback v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))))) →
      (¬ ∃ W : (Limits.pullback v (Spec.map (CommRingCat.ofHom
          (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))).Opens, x ∈ W ∧
        SmoothOfRelativeDimension 1 (W.ι ≫ Limits.pullback.snd v
          (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))))) →
      x ∈ closure (closure ({ξ} : Set ↥(Limits.pullback v
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))))))ᶜ := by
    intro x hx hcl hns
    rw [hξD] at hx ⊢
    exact wcpa_dj_lus_cvs_ct_cp1_no_self_node K R hκ Y v hss E hE hP1E D hD hsub x hx hcl hns
  obtain ⟨Er, ι, θ, h1, h2, h3, h4⟩ :=
    wcpa_dj_csp_P1_recognition (IsLocalRing.ResidueField ↥R) _ _ hssq ξ hξ hA hnodes ht
  exact ⟨Er, ι, θ, h1, h2, h3.trans hξD, h4⟩

theorem wcpa_dj_lus_cvs_closed_fibre_component_mult : ∀ (K : Type u) [Field K] (R : ValuationSubring K), IsAlgClosed (IsLocalRing.ResidueField ↥R) → ∀ (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)), wcpaDjSemistable v → ∀ y : ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))), {D | D ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) ∧ y ∈ D}.ncard ≤ 2 ∧ ((∃ W : (Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))).Opens, y ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))))) → {D | D ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) ∧ y ∈ D}.ncard ≤ 1) :=
by

  have c1 : ∀ (κ : Type u) [Field κ], ∃ P₀ P₁ : Ideal (MvPowerSeries (Fin 2) κ ⧸
      Ideal.span {(MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) : MvPowerSeries (Fin 2) κ)}),
      P₀.IsPrime ∧ P₁.IsPrime ∧ P₀ * P₁ = ⊥ := by
    intro κ _
    let ρ : Fin 2 → MvPowerSeries (Fin 2) κ →+* PowerSeries κ := fun j =>
      { toFun := fun f => PowerSeries.mk (fun n => MvPowerSeries.coeff (Finsupp.single j n) f)
        map_one' := by
          refine PowerSeries.ext fun n => ?_
          rw [PowerSeries.coeff_mk, MvPowerSeries.coeff_one, PowerSeries.coeff_one]
          simp [Finsupp.single_eq_zero]
        map_mul' := by
          intro f g
          refine PowerSeries.ext fun n => ?_
          rw [PowerSeries.coeff_mk, MvPowerSeries.coeff_mul, PowerSeries.coeff_mul,
            Finsupp.antidiagonal_single, Finset.sum_map]
          refine Finset.sum_congr rfl fun x _ => ?_
          rw [PowerSeries.coeff_mk, PowerSeries.coeff_mk]
          rfl
        map_zero' := by
          refine PowerSeries.ext fun n => ?_
          rw [PowerSeries.coeff_mk]
          simp
        map_add' := by
          intro f g
          refine PowerSeries.ext fun n => ?_
          rw [PowerSeries.coeff_mk, map_add, map_add, PowerSeries.coeff_mk, PowerSeries.coeff_mk] }
    have hρ : ∀ (j : Fin 2) (f : MvPowerSeries (Fin 2) κ) (n : ℕ),
        PowerSeries.coeff n (ρ j f) = MvPowerSeries.coeff (Finsupp.single j n) f := by
      intro j f n
      exact PowerSeries.coeff_mk n (fun n => MvPowerSeries.coeff (Finsupp.single j n) f)
    have hkill : ∀ i j : Fin 2, i ≠ j → ρ j (MvPowerSeries.X i) = 0 := by
      intro i j hij
      refine PowerSeries.ext fun n => ?_
      rw [hρ, MvPowerSeries.coeff_X, map_zero]
      simp [Finsupp.single_eq_single_iff, Ne.symm hij]
    have hdvd : ∀ i j : Fin 2, i ≠ j → ∀ f : MvPowerSeries (Fin 2) κ, ρ j f = 0 →
        MvPowerSeries.X i ∣ f := by
      intro i j hij f hf
      rw [MvPowerSeries.X_dvd_iff]
      intro m hm
      have hm' : m = Finsupp.single j (m j) := by
        ext a
        by_cases ha : a = j
        · rw [ha, Finsupp.single_eq_same]
        · have hai : a = i := by
            fin_cases a <;> fin_cases i <;> fin_cases j <;> simp_all
          rw [hai, hm, Finsupp.single_apply, if_neg (Ne.symm hij)]
      have h1 := congrArg (PowerSeries.coeff (m j)) hf
      rw [map_zero, hρ] at h1
      rw [hm']
      exact h1
    have hI : ∀ j : Fin 2, ∀ a ∈ Ideal.span {MvPowerSeries.X (0 : Fin 2) *
        (MvPowerSeries.X 1 : MvPowerSeries (Fin 2) κ)}, ρ j a = 0 := by
      intro j a ha
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton.mp ha
      rw [map_mul, map_mul]
      fin_cases j
      · simp [hkill 1 0 (by decide)]
      · simp [hkill 0 1 (by decide)]
    let ρb : Fin 2 → (MvPowerSeries (Fin 2) κ ⧸
        Ideal.span {(MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) : MvPowerSeries (Fin 2) κ)}) →+* PowerSeries κ :=
      fun j => Ideal.Quotient.lift _ (ρ j) (hI j)
    refine ⟨RingHom.ker (ρb 1), RingHom.ker (ρb 0), RingHom.ker_isPrime _,
      RingHom.ker_isPrime _, ?_⟩
    refine le_bot_iff.mp (Ideal.mul_le.mpr ?_)
    intro a ha b hb
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective a
    obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective b
    rw [RingHom.mem_ker] at ha hb
    have ha' : ρ 1 f = 0 := ha
    have hb' : ρ 0 g = 0 := hb
    obtain ⟨f', rfl⟩ := hdvd 0 1 (by decide) f ha'
    obtain ⟨g', rfl⟩ := hdvd 1 0 (by decide) g hb'
    rw [Ideal.mem_bot, ← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_span_singleton.mpr ⟨f' * g', by ring⟩

  have nodeA : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
      (κ : Type u) [Field κ],
      (AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* (MvPowerSeries (Fin 2) κ ⧸
        Ideal.span {(MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) : MvPowerSeries (Fin 2) κ)})) →
      ∃ S : Set (Ideal A), S.Finite ∧ S.ncard ≤ 2 ∧ minimalPrimes A ⊆ S := by
    intro A _ _ _ κ _ e
    haveI : IsHausdorff (IsLocalRing.maximalIdeal A) A :=
      IsHausdorff.of_isLocalRing _ A (IsLocalRing.maximalIdeal.isMaximal A).ne_top
    have hinj : Function.Injective
        (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) := by
      intro a b hab
      rw [AdicCompletion.algebraMap_apply, AdicCompletion.algebraMap_apply] at hab
      exact AdicCompletion.of_injective _ A hab
    let φ : A →+* (MvPowerSeries (Fin 2) κ ⧸
        Ideal.span {(MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) : MvPowerSeries (Fin 2) κ)}) :=
      e.toRingHom.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
    have hφinj : Function.Injective φ := e.injective.comp hinj
    obtain ⟨P₀, P₁, h₀, h₁, h01⟩ := c1 κ
    refine ⟨{Ideal.comap φ P₀, Ideal.comap φ P₁}, (Set.finite_singleton _).insert _, ?_, ?_⟩
    · exact (Set.ncard_insert_le _ _).trans (by rw [Set.ncard_singleton])
    · intro p hp
      have hp' : Minimal (fun q : Ideal A => q.IsPrime ∧ ⊥ ≤ q) p := hp
      have hpp : p.IsPrime := hp'.1.1
      have hprod : Ideal.comap φ P₀ * Ideal.comap φ P₁ ≤ p := by
        rw [Ideal.mul_le]
        intro a ha b hb
        have h1 : φ (a * b) = 0 := by
          rw [map_mul]
          have : φ a * φ b ∈ P₀ * P₁ := Ideal.mul_mem_mul ha hb
          rwa [h01, Ideal.mem_bot] at this
        have h2 : a * b = 0 := hφinj (h1.trans (map_zero φ).symm)
        rw [h2]
        exact p.zero_mem
      haveI := h₀
      haveI := h₁
      rcases hpp.mul_le.mp hprod with h | h
      · left
        exact (hp'.eq_of_le ⟨inferInstance, bot_le⟩ h).symm
      · right
        exact Set.mem_singleton_iff.mpr (hp'.eq_of_le ⟨inferInstance, bot_le⟩ h).symm

  have c3 : ∀ (X : Scheme.{u}) (x : X) (S : Set (Ideal (X.presheaf.stalk x))), S.Finite →
      minimalPrimes (X.presheaf.stalk x) ⊆ S →
      {D | D ∈ irreducibleComponents ↥X ∧ x ∈ D}.ncard ≤ S.ncard := by
    intro X x S hS hmin
    have key : ∀ D ∈ {D | D ∈ irreducibleComponents ↥X ∧ x ∈ D},
        ∃ m : Ideal (X.presheaf.stalk x), m ∈ minimalPrimes (X.presheaf.stalk x) ∧
          ∃ hm : m.IsPrime, D = closure {X.fromSpecStalk x ⟨m, hm⟩} := by
      rintro D ⟨hD, hxD⟩
      have hDcl : IsClosed D := isClosed_of_mem_irreducibleComponents D hD
      have hgen : closure {hD.1.genericPoint} = D := by
        have h1 := hD.1.isGenericPoint_genericPoint_closure
        rw [hDcl.closure_eq] at h1
        exact h1
      have hsp : hD.1.genericPoint ⤳ x :=
        specializes_iff_mem_closure.mpr (by rw [hgen]; exact hxD)
      have hr : hD.1.genericPoint ∈ Set.range (X.fromSpecStalk x) := by
        rw [Scheme.range_fromSpecStalk]; exact hsp
      obtain ⟨p, hp⟩ := hr
      have hpprime : p.asIdeal.IsPrime := p.isPrime
      obtain ⟨m, hm, hmp⟩ := Ideal.exists_minimalPrimes_le (I := ⊥) (J := p.asIdeal) bot_le
      have hmprime : m.IsPrime := hm.1.1
      refine ⟨m, hm, hmprime, ?_⟩
      have hqp : (⟨m, hmprime⟩ : PrimeSpectrum (X.presheaf.stalk x)) ⤳ p :=
        (PrimeSpectrum.le_iff_specializes _ p).mp hmp
      have hh : X.fromSpecStalk x ⟨m, hmprime⟩ ⤳ hD.1.genericPoint := by
        rw [← hp]; exact hqp.map (X.fromSpecStalk x).continuous
      have hsub : D ⊆ closure {X.fromSpecStalk x ⟨m, hmprime⟩} := by
        rw [← hgen]
        exact specializes_iff_closure_subset.mp hh
      exact ((hD.2 isIrreducible_singleton.closure hsub).antisymm hsub).symm
    choose! F hF using key
    refine Set.ncard_le_ncard_of_injOn F (fun D hD => hmin (hF D hD).1) ?_ hS
    intro D hD D' hD' hDD'
    obtain ⟨_, h1, e1⟩ := hF D hD
    obtain ⟨_, h2, e2⟩ := hF D' hD'
    have hq : (⟨F D, h1⟩ : PrimeSpectrum (X.presheaf.stalk x)) = ⟨F D', h2⟩ :=
      PrimeSpectrum.ext hDD'
    calc D = closure {X.fromSpecStalk x ⟨F D, h1⟩} := e1
      _ = closure {X.fromSpecStalk x ⟨F D', h2⟩} := by rw [hq]
      _ = D' := e2.symm

  have smooth_le : ∀ (X : Scheme.{u}) (κ : Type u) [Field κ] (sX : X ⟶ Spec (.of κ)) (y : X),
      (∃ W : X.Opens, y ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ sX)) →
      {D | D ∈ irreducibleComponents ↥X ∧ y ∈ D}.ncard ≤ 1 := by
    rintro X κ _ sX y ⟨W, hyW, hsm⟩
    haveI := hsm
    haveI hdomW := wcpa_smooth_stalk_isDomain κ W.toScheme (W.ι ≫ sX) 1 (⟨y, hyW⟩ : W)
    haveI : IsDomain (X.presheaf.stalk y) :=
      MulEquiv.isDomain _ (W.stalkIso (⟨y, hyW⟩ : W)).symm.commRingCatIsoToRingEquiv.toMulEquiv
    have h := c3 X y {⊥} (Set.finite_singleton _)
      (by rw [IsDomain.minimalPrimes_eq_singleton_bot])
    rwa [Set.ncard_singleton] at h

  intro K _ R hκ Y v hss y
  haveI := hκ
  haveI : IsProper v := hss.2.1
  haveI : IsLocallyNoetherian (Limits.pullback v (Spec.map (CommRingCat.ofHom
      (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom
      (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))))
  have hS := smooth_le _ _ (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom
      (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))) y
  refine ⟨?_, hS⟩
  rcases hss.2.2 (IsLocalRing.ResidueField ↥R) (Spec.map (CommRingCat.ofHom
      (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))) y with hsm | ⟨e, _⟩
  · exact (hS hsm).trans (by norm_num)
  · obtain ⟨S, hSfin, hScard, hmin⟩ := nodeA _ _ e
    exact (c3 _ y S hSfin hmin).trans hScard

theorem wcpa_dj_lus_cvs_ct_fc_cycle_extract : ∀ {α : Type u} (𝒟 : Finset (Set α)), 𝒟.Nonempty → {x | ∃ D ∈ 𝒟, ∃ D' ∈ 𝒟, D ≠ D' ∧ x ∈ D ∧ x ∈ D'}.Finite → (∀ x : α, {D | D ∈ 𝒟 ∧ x ∈ D}.ncard ≤ 2) → 𝒟.card ≤ {x | ∃ D ∈ 𝒟, ∃ D' ∈ 𝒟, D ≠ D' ∧ x ∈ D ∧ x ∈ D'}.ncard → ∃ (n : ℕ) (C : Fin (n + 2) → Set α) (x : Fin (n + 2) → α), Function.Injective C ∧ Function.Injective x ∧ (∀ i, C i ∈ 𝒟) ∧ ∀ i, x i ∈ C i ∧ x i ∈ C (finRotate (n + 2) i) :=
by
  intro α
  classical

  have walk_cycle : ∀ (𝒟 : Finset (Set α)), (∀ x : α, {D | D ∈ 𝒟 ∧ x ∈ D}.ncard ≤ 2) →
      ∀ (W : ℕ → Set α) (w : ℕ → α), (∀ k, W k ∈ 𝒟 ∧ w k ∈ W k ∧ w k ∈ W (k + 1) ∧
        W (k + 1) ≠ W k ∧ w (k + 1) ≠ w k) →
      ∃ (n : ℕ) (C : Fin (n + 2) → Set α) (x : Fin (n + 2) → α), Function.Injective C ∧
        Function.Injective x ∧ (∀ i, C i ∈ 𝒟) ∧ ∀ i, x i ∈ C i ∧ x i ∈ C (finRotate (n + 2) i) := by
    intro 𝒟 hmult W w hW
    have nothree : ∀ (A B C : Set α) (y : α), A ∈ 𝒟 → B ∈ 𝒟 → C ∈ 𝒟 → A ≠ B → A ≠ C → B ≠ C →
        y ∈ A → y ∈ B → y ∈ C → False := by
      intro A B C y hA hB hC hAB hAC hBC hyA hyB hyC
      have hfin : {D | D ∈ 𝒟 ∧ y ∈ D}.Finite := (𝒟.finite_toSet).subset (fun D hD => hD.1)
      have h3 : ({A, B, C} : Set (Set α)).ncard = 3 :=
        Set.ncard_eq_three.mpr ⟨A, B, C, hAB, hAC, hBC, rfl⟩
      have hsub : ({A, B, C} : Set (Set α)) ⊆ {D | D ∈ 𝒟 ∧ y ∈ D} := by
        intro D hD
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hD
        rcases hD with rfl | rfl | rfl
        · exact ⟨hA, hyA⟩
        · exact ⟨hB, hyB⟩
        · exact ⟨hC, hyC⟩
      have h4 := Set.ncard_le_ncard hsub hfin
      have h5 := hmult y
      omega
    have hrep : ∃ a ∈ Finset.range (𝒟.card + 1), ∃ b ∈ Finset.range (𝒟.card + 1), a ≠ b ∧ W a = W b :=
      Finset.exists_ne_map_eq_of_card_lt_of_maps_to (s := Finset.range (𝒟.card + 1)) (t := 𝒟)
        (by simp) (by intro a _; exact (hW a).1)
    have hex : ∃ j, ∃ i < j, W i = W j := by
      obtain ⟨a, -, b, -, hab, hWab⟩ := hrep
      rcases lt_or_gt_of_ne hab with h | h
      · exact ⟨b, a, h, hWab⟩
      · exact ⟨a, b, h, hWab.symm⟩
    obtain ⟨i, hij, hWij⟩ := Nat.find_spec hex
    set j := Nat.find hex with hjdef
    have hmin : ∀ m < j, ¬ ∃ i < m, W i = W m := fun m hm => Nat.find_min hex hm
    have inj : ∀ p q, p < j → q < j → W p = W q → p = q := by
      intro p q hp hq hpq
      by_contra hne
      rcases lt_or_gt_of_ne hne with h | h
      · exact hmin q hq ⟨p, h, hpq⟩
      · exact hmin p hp ⟨q, h, hpq.symm⟩
    have hj1 : j ≠ i + 1 := by
      intro h
      apply (hW i).2.2.2.1
      rw [hWij, h]
    obtain ⟨n, hn⟩ : ∃ n, j = i + n + 2 := ⟨j - i - 2, by omega⟩
    refine ⟨n, fun m => W (i + m.val), fun m => w (i + m.val), ?_, ?_, ?_, ?_⟩
    · intro a b hab
      have ha := a.isLt
      have hb := b.isLt
      have := inj _ _ (by omega) (by omega) hab
      exact Fin.ext (by omega)
    · have claim : ∀ p q, p < q → q < n + 2 → w (i + p) = w (i + q) → False := by
        intro p q hpq hq heq
        by_cases hq1 : q = p + 1
        · subst hq1
          apply (hW (i + p)).2.2.2.2
          rw [heq]
          exact congrArg w (by omega)
        · apply nothree (W (i + p)) (W (i + p + 1)) (W (i + q)) (w (i + p)) (hW _).1 (hW _).1 (hW _).1
          · intro h; have := inj _ _ (by omega) (by omega) h; omega
          · intro h; have := inj _ _ (by omega) (by omega) h; omega
          · intro h; have := inj _ _ (by omega) (by omega) h; omega
          · exact (hW _).2.1
          · exact (hW _).2.2.1
          · rw [heq]; exact (hW _).2.1
      intro a b hab
      by_contra hne
      have hv : a.val ≠ b.val := fun h => hne (Fin.ext h)
      have ha := a.isLt
      have hb := b.isLt
      rcases lt_or_gt_of_ne hv with h | h
      · exact claim _ _ h hb hab
      · exact claim _ _ h ha hab.symm
    · intro m
      exact (hW _).1
    · intro m
      refine ⟨(hW _).2.1, ?_⟩
      have hval : ((finRotate (n + 2) m) : ℕ) = if m = Fin.last (n + 1) then 0 else m.val + 1 :=
        coe_finRotate m
      show w (i + m.val) ∈ W (i + ((finRotate (n + 2) m) : ℕ))
      split_ifs at hval with hm
      · rw [hval, hm, Fin.val_last, add_zero, hWij]
        have h1 := (hW (i + (n + 1))).2.2.1
        rwa [show i + (n + 1) + 1 = j by omega] at h1
      · rw [hval]
        have h1 := (hW (i + m.val)).2.2.1
        rwa [show i + (m.val + 1) = i + m.val + 1 by omega]

  obtain ⟨Ifn, hIfn⟩ : ∃ f : Finset (Set α) → Set α,
      ∀ 𝒟, f 𝒟 = {x | ∃ D ∈ 𝒟, ∃ D' ∈ 𝒟, D ≠ D' ∧ x ∈ D ∧ x ∈ D'} := ⟨_, fun _ => rfl⟩
  have memI : ∀ (𝒟 : Finset (Set α)) (x : α),
      x ∈ Ifn 𝒟 ↔ ∃ D ∈ 𝒟, ∃ D' ∈ 𝒟, D ≠ D' ∧ x ∈ D ∧ x ∈ D' := by
    intro 𝒟 x; rw [hIfn]; rfl
  have main : ∀ 𝒟 : Finset (Set α), 𝒟.Nonempty → (Ifn 𝒟).Finite →
      (∀ x : α, {D | D ∈ 𝒟 ∧ x ∈ D}.ncard ≤ 2) → 𝒟.card ≤ (Ifn 𝒟).ncard →
      ∃ (n : ℕ) (C : Fin (n + 2) → Set α) (x : Fin (n + 2) → α), Function.Injective C ∧
        Function.Injective x ∧ (∀ i, C i ∈ 𝒟) ∧ ∀ i, x i ∈ C i ∧ x i ∈ C (finRotate (n + 2) i) := by
    refine Finset.strongInduction (fun 𝒟 ih => ?_)
    intro hne hfin hmult hcard
    by_cases hA : ∃ E ∈ 𝒟, (E ∩ Ifn 𝒟).ncard ≤ 1
    ·
      obtain ⟨E, hE, hE1⟩ := hA
      have hsub : 𝒟.erase E ⊂ 𝒟 := Finset.erase_ssubset hE
      have hI'sub : Ifn (𝒟.erase E) ⊆ Ifn 𝒟 := by
        intro x hx
        rw [memI] at hx ⊢
        obtain ⟨D, hD, D', hD', hne, h1, h2⟩ := hx
        exact ⟨D, Finset.mem_of_mem_erase hD, D', Finset.mem_of_mem_erase hD', hne, h1, h2⟩
      have hcov : Ifn 𝒟 ⊆ Ifn (𝒟.erase E) ∪ (E ∩ Ifn 𝒟) := by
        intro x hx
        have hx' := hx
        rw [memI] at hx
        obtain ⟨D, hD, D', hD', hne, h1, h2⟩ := hx
        by_cases hDE : D = E
        · right; exact ⟨hDE ▸ h1, hx'⟩
        by_cases hD'E : D' = E
        · right; exact ⟨hD'E ▸ h2, hx'⟩
        left
        rw [memI]
        exact ⟨D, Finset.mem_erase.mpr ⟨hDE, hD⟩, D', Finset.mem_erase.mpr ⟨hD'E, hD'⟩, hne, h1, h2⟩
      have hfin' : (Ifn (𝒟.erase E)).Finite := hfin.subset hI'sub
      have hc1 : (Ifn 𝒟).ncard ≤ (Ifn (𝒟.erase E) ∪ (E ∩ Ifn 𝒟)).ncard :=
        Set.ncard_le_ncard hcov (hfin'.union (hfin.subset Set.inter_subset_right))
      have hc2 : (Ifn (𝒟.erase E) ∪ (E ∩ Ifn 𝒟)).ncard ≤
          (Ifn (𝒟.erase E)).ncard + (E ∩ Ifn 𝒟).ncard := Set.ncard_union_le _ _
      have hcardE : (𝒟.erase E).card = 𝒟.card - 1 := Finset.card_erase_of_mem hE
      have hpos := hne.card_pos
      have hne' : (𝒟.erase E).Nonempty := by
        have hIne : (Ifn 𝒟).Nonempty := Set.nonempty_of_ncard_ne_zero (by omega)
        obtain ⟨x, hx⟩ := hIne
        rw [memI] at hx
        obtain ⟨D, hD, D', hD', hne, -, -⟩ := hx
        by_cases hDE : D = E
        · exact ⟨D', Finset.mem_erase.mpr ⟨fun h => hne (hDE.trans h.symm), hD'⟩⟩
        · exact ⟨D, Finset.mem_erase.mpr ⟨hDE, hD⟩⟩
      have hmult' : ∀ x : α, {D | D ∈ 𝒟.erase E ∧ x ∈ D}.ncard ≤ 2 := by
        intro x
        refine le_trans (Set.ncard_le_ncard ?_ ((𝒟.finite_toSet).subset (fun D hD => hD.1)))
          (hmult x)
        intro D hD
        exact ⟨Finset.mem_of_mem_erase hD.1, hD.2⟩
      obtain ⟨n, C, x, h1, h2, h3, h4⟩ := ih _ hsub hne' hfin' hmult' (by omega)
      exact ⟨n, C, x, h1, h2, fun i => Finset.mem_of_mem_erase (h3 i), h4⟩
    ·
      push_neg at hA
      have two : ∀ E ∈ 𝒟, ∃ a b, a ∈ E ∩ Ifn 𝒟 ∧ b ∈ E ∩ Ifn 𝒟 ∧ a ≠ b := by
        intro E hE
        exact (Set.one_lt_ncard_iff (hfin.subset Set.inter_subset_right)).mp (hA E hE)
      have step : ∀ p : Set α × α, (p.1 ∈ 𝒟 ∧ p.2 ∈ p.1 ∧ p.2 ∈ Ifn 𝒟) →
          ∃ q : Set α × α, (q.1 ∈ 𝒟 ∧ q.2 ∈ q.1 ∧ q.2 ∈ Ifn 𝒟) ∧ p.2 ∈ q.1 ∧ q.1 ≠ p.1 ∧
            q.2 ≠ p.2 := by
        intro p hp
        obtain ⟨-, -, hp3⟩ := hp
        have hx := hp3
        rw [memI] at hx
        obtain ⟨D₁, hD₁, D₂, hD₂, hne12, hx1, hx2⟩ := hx
        obtain ⟨E', hE', hxE', hE'ne⟩ : ∃ E' ∈ 𝒟, p.2 ∈ E' ∧ E' ≠ p.1 := by
          by_cases h : D₁ = p.1
          · exact ⟨D₂, hD₂, hx2, fun h' => hne12 (h.trans h'.symm)⟩
          · exact ⟨D₁, hD₁, hx1, h⟩
        obtain ⟨a, b, ha, hb, hab⟩ := two E' hE'
        by_cases hap : a = p.2
        · exact ⟨(E', b), ⟨hE', hb.1, hb.2⟩, hxE', hE'ne, fun h => hab (hap.trans h.symm)⟩
        · exact ⟨(E', a), ⟨hE', ha.1, ha.2⟩, hxE', hE'ne, hap⟩
      choose! f hf using step
      obtain ⟨E₀, hE₀⟩ := hne
      obtain ⟨y₀, -, hy₀, -, -⟩ := two E₀ hE₀
      obtain ⟨s, hs0, hsS⟩ : ∃ s : ℕ → Set α × α, s 0 = (E₀, y₀) ∧ ∀ k, s (k + 1) = f (s k) :=
        ⟨fun k => f^[k] (E₀, y₀), rfl, fun k => Function.iterate_succ_apply' f k _⟩
      have hQ : ∀ k, (s k).1 ∈ 𝒟 ∧ (s k).2 ∈ (s k).1 ∧ (s k).2 ∈ Ifn 𝒟 := by
        intro k
        induction k with
        | zero => rw [hs0]; exact ⟨hE₀, hy₀.1, hy₀.2⟩
        | succ k ihk => rw [hsS]; exact (hf _ ihk).1
      apply walk_cycle 𝒟 hmult (fun k => (s k).1) (fun k => (s k).2)
      intro k
      have h := hf (s k) (hQ k)
      refine ⟨(hQ k).1, (hQ k).2.1, ?_, ?_, ?_⟩
      · show (s k).2 ∈ (s (k + 1)).1
        rw [hsS]; exact h.2.1
      · show (s (k + 1)).1 ≠ (s k).1
        rw [hsS]; exact h.2.2.1
      · show (s (k + 1)).2 ≠ (s k).2
        rw [hsS]; exact h.2.2.2
  intro 𝒟 h1 h2 h3 h4
  exact main 𝒟 h1 (by rw [hIfn]; exact h2) h3 (by rw [hIfn]; exact h4)

theorem wcpa_dj_lus_cvs_ct_fc_tc_double_cover : ∀ (X₀ : Scheme.{u}) (V₁ V₂ A B : X₀.Opens), V₁ ⊔ V₂ = ⊤ → V₁ ⊓ V₂ = A ⊔ B → A ⊓ B = ⊥ → ∃ (P : Scheme.{u}) (p : P ⟶ X₀) (s₁ s₂ : Bool → ↥X₀ → ↥P), IsFinite p ∧ Etale p ∧ Surjective p ∧ (∀ b, ContinuousOn (s₁ b) (V₁ : Set ↥X₀)) ∧ (∀ b, ContinuousOn (s₂ b) (V₂ : Set ↥X₀)) ∧ (∀ y ∈ (V₁ : Set ↥X₀), p ⁻¹' {y} = {s₁ false y, s₁ true y} ∧ s₁ false y ≠ s₁ true y) ∧ (∀ y ∈ (V₂ : Set ↥X₀), p ⁻¹' {y} = {s₂ false y, s₂ true y} ∧ s₂ false y ≠ s₂ true y) ∧ (∀ b, ∀ y ∈ (B : Set ↥X₀), s₂ b y = s₁ b y) ∧ (∀ b, ∀ y ∈ (A : Set ↥X₀), s₂ b y = s₁ (!b) y) :=
by
  intro X₀ V₁ V₂ A B hsup hinf hAB
  classical

  have glue : ∀ (Y : Scheme.{u}) (J : Type u) (O : J → Y.Opens) (W : J → J → Y.Opens), (∀ j, W j j = O j) → (∀ j k, W j k ≤ O j) → (∀ j k, W j k = W k j) → (∀ i j k, W i j ⊓ W i k ≤ W j k) → ∃ (P : Scheme.{u}) (π : P ⟶ Y) (ι : ∀ j, (O j : Scheme.{u}) ⟶ P), (∀ j, IsOpenImmersion (ι j)) ∧ (∀ j, ι j ≫ π = (O j).ι) ∧ (∀ z : P, ∃ (j : J) (x : (O j : Scheme.{u})), ι j x = z) ∧ ∀ (j k : J) (x : (O j : Scheme.{u})) (y : (O k : Scheme.{u})), ι j x = ι k y ↔ ((O j).ι x = (O k).ι y ∧ (O j).ι x ∈ W j k) := by
    intro Y J O W h1 h2 h3 h4
    have hmem : ∀ (U : Y.Opens) (z : (U : Scheme.{u})), U.ι z ∈ U := by
      intro U z
      have : U.ι z ∈ Set.range U.ι := ⟨z, rfl⟩
      rwa [Scheme.Opens.range_ι] at this
    have hρ : ∀ i j k, Limits.pullback.fst (Y.homOfLE (h2 i j)) (Y.homOfLE (h2 i k)) ≫ (W i j).ι
        = Limits.pullback.snd (Y.homOfLE (h2 i j)) (Y.homOfLE (h2 i k)) ≫ (W i k).ι := by
      intro i j k
      rw [← Y.homOfLE_ι (h2 i j), ← Y.homOfLE_ι (h2 i k), ← Category.assoc,
        Limits.pullback.condition, Category.assoc]
    have hrange : ∀ i j k, Set.range (Limits.pullback.fst (Y.homOfLE (h2 i j)) (Y.homOfLE (h2 i k))
        ≫ (W i j).ι) ⊆ Set.range (W j k).ι := by
      intro i j k
      rintro _ ⟨z, rfl⟩
      rw [Scheme.Opens.range_ι]
      have e1 : (Limits.pullback.fst (Y.homOfLE (h2 i j)) (Y.homOfLE (h2 i k)) ≫ (W i j).ι) z ∈ W i j := by
        rw [Scheme.Hom.comp_apply]; exact hmem _ _
      have e2 : (Limits.pullback.fst (Y.homOfLE (h2 i j)) (Y.homOfLE (h2 i k)) ≫ (W i j).ι) z ∈ W i k := by
        rw [hρ, Scheme.Hom.comp_apply]; exact hmem _ _
      exact h4 i j k ⟨e1, e2⟩
    have hw : ∀ i j k, IsOpenImmersion.lift (W j k).ι _ (hrange i j k) ≫ Y.homOfLE (h2 j k)
        = (Limits.pullback.fst (Y.homOfLE (h2 i j)) (Y.homOfLE (h2 i k)) ≫ Y.homOfLE (h3 i j).le)
          ≫ Y.homOfLE (h2 j i) := by
      intro i j k
      apply (cancel_mono (O j).ι).1
      simp only [Category.assoc, Scheme.homOfLE_ι, IsOpenImmersion.lift_fac]
    obtain ⟨t', tfac, tρ⟩ : ∃ t' : ∀ i j k, Limits.pullback (Y.homOfLE (h2 i j)) (Y.homOfLE (h2 i k))
        ⟶ Limits.pullback (Y.homOfLE (h2 j k)) (Y.homOfLE (h2 j i)),
        (∀ i j k, t' i j k ≫ Limits.pullback.snd (Y.homOfLE (h2 j k)) (Y.homOfLE (h2 j i))
          = Limits.pullback.fst (Y.homOfLE (h2 i j)) (Y.homOfLE (h2 i k)) ≫ Y.homOfLE (h3 i j).le) ∧
        (∀ i j k, t' i j k ≫ Limits.pullback.fst (Y.homOfLE (h2 j k)) (Y.homOfLE (h2 j i)) ≫ (W j k).ι
          = Limits.pullback.fst (Y.homOfLE (h2 i j)) (Y.homOfLE (h2 i k)) ≫ (W i j).ι) :=
      ⟨fun i j k => Limits.pullback.lift _ _ (hw i j k),
        fun i j k => Limits.pullback.lift_snd _ _ _,
        fun i j k => by rw [← Category.assoc, Limits.pullback.lift_fst, IsOpenImmersion.lift_fac]⟩
    have coc : ∀ i j k, t' i j k ≫ t' j k i ≫ t' k i j = 𝟙 _ := by
      intro i j k
      apply (cancel_mono (Limits.pullback.fst (Y.homOfLE (h2 i j)) (Y.homOfLE (h2 i k))
        ≫ (W i j).ι)).1
      rw [Category.assoc, Category.assoc, tρ k i j, tρ j k i, tρ i j k, Category.id_comp]
    have fid : ∀ i, IsIso (Y.homOfLE (h2 i i)) := by
      intro i
      rw [← Scheme.isoOfEq_hom Y (h1 i)]
      infer_instance
    have tid : ∀ i, Y.homOfLE (h3 i i).le = 𝟙 _ := fun i => Scheme.homOfLE_rfl Y (W i i)
    let D : Scheme.GlueData.{u} := Scheme.GlueData.mk
      { J := J, U := fun j => (O j : Scheme.{u}), V := fun p => (W p.1 p.2 : Scheme.{u}),
        f := fun i j => Y.homOfLE (h2 i j), f_id := fid,
        t := fun i j => Y.homOfLE (h3 i j).le, t_id := tid, t' := t', t_fac := tfac, cocycle := coc }
      (fun i j => (inferInstance : IsOpenImmersion (Y.homOfLE (h2 i j))))
    have hcompat : ∀ i j, Y.homOfLE (h2 i j) ≫ (O i).ι
        = Y.homOfLE (h3 i j).le ≫ Y.homOfLE (h2 j i) ≫ (O j).ι := by
      intro i j
      simp only [Scheme.homOfLE_ι]
    have hdesc : ∀ (D : Scheme.GlueData.{u}) (m : ∀ j, D.U j ⟶ Y),
        (∀ i j, D.f i j ≫ m i = D.t i j ≫ D.f j i ≫ m j) →
        ∃ π : D.glued ⟶ Y, ∀ j, D.ι j ≫ π = m j := by
      intro D m hm
      refine ⟨Limits.Multicoequalizer.desc D.diagram Y m ?_, fun j =>
        Limits.Multicoequalizer.π_desc D.diagram Y m _ j⟩
      rintro ⟨i, j⟩
      exact hm i j
    obtain ⟨π, hπ⟩ := hdesc D (fun j => (O j).ι) hcompat
    refine ⟨D.glued, π, fun j => D.ι j, fun j => D.ι_isOpenImmersion j,
      hπ, fun z => D.ι_jointly_surjective z, ?_⟩
    intro j k x y
    rw [Scheme.GlueData.ι_eq_iff]
    show (∃ z : (W j k : Scheme.{u}), Y.homOfLE (h2 j k) z = x ∧
        (Y.homOfLE (h3 j k).le ≫ Y.homOfLE (h2 k j)) z = y) ↔ _
    constructor
    · rintro ⟨z, hx, hy⟩
      have ex : (O j).ι x = (W j k).ι z := by
        rw [← hx, ← Scheme.homOfLE_ι Y (h2 j k), Scheme.Hom.comp_apply]
      have ey : (O k).ι y = (W j k).ι z := by
        rw [← hy, ← Scheme.homOfLE_ι Y (h3 j k).le, ← Scheme.homOfLE_ι Y (h2 k j)]
        simp only [Scheme.Hom.comp_apply]
      refine ⟨ex.trans ey.symm, ?_⟩
      rw [ex]
      exact hmem _ _
    · rintro ⟨hxy, hxW⟩
      obtain ⟨z, hz⟩ : (O j).ι x ∈ Set.range (W j k).ι := by
        rw [Scheme.Opens.range_ι]; exact hxW
      refine ⟨z, ?_, ?_⟩
      · apply (O j).ι.isOpenEmbedding.injective
        rw [← hz, ← Scheme.homOfLE_ι Y (h2 j k), Scheme.Hom.comp_apply]
      · apply (O k).ι.isOpenEmbedding.injective
        rw [← hxy, ← hz, ← Scheme.homOfLE_ι Y (h3 j k).le, ← Scheme.homOfLE_ι Y (h2 k j)]
        simp only [Scheme.Hom.comp_apply]


  have gfe : ∀ (U : Scheme.{u}) (J : Type u) (O : J → U.Opens) (E : J → Scheme.{u}) (π : ∀ i, E i ⟶ (O i : Scheme.{u})) (W : Scheme.{u}) (p : W ⟶ U) (κ : ∀ i, E i ⟶ W), (∀ x : U, ∃ i, x ∈ O i) → (∀ i, IsOpenImmersion (κ i)) → (∀ i, κ i ≫ p = π i ≫ (O i).ι) → (∀ i, Set.range (κ i) = p ⁻¹' (O i : Set U)) → (∀ i, IsFinite (π i)) → (∀ i, Etale (π i)) → IsFinite p ∧ Etale p := by
    intro U J O E π W p κ Hcov Hopen Hcomm Hrange Hfin Het
    have hsup : iSup O = ⊤ := by
      rw [eq_top_iff]
      intro x _
      rw [TopologicalSpace.Opens.mem_iSup]
      exact Hcov x
    have hres : ∀ i, ∃ e : E i ≅ ((p ⁻¹ᵁ O i : W.Opens) : Scheme.{u}), p ∣_ O i = e.inv ≫ π i := by
      intro i
      have := Hopen i
      have hr : Set.range (κ i) = Set.range (p ⁻¹ᵁ O i).ι := by
        rw [Scheme.Opens.range_ι, Scheme.Hom.coe_preimage, Hrange i]
      refine ⟨IsOpenImmersion.isoOfRangeEq (κ i) (p ⁻¹ᵁ O i).ι hr, ?_⟩
      rw [Iso.eq_inv_comp, ← cancel_mono (O i).ι, Category.assoc, morphismRestrict_ι,
        ← Category.assoc, IsOpenImmersion.isoOfRangeEq_hom_fac, Hcomm]
    have hfin : IsFinite p := by
      refine @IsZariskiLocalAtTarget.of_iSup_eq_top @IsFinite
        (@HasAffineProperty.instIsZariskiLocalAtTarget @IsFinite
          (fun X _ f _ => IsAffine X ∧ f.appTop.hom.Finite)
          IsFinite.instHasAffinePropertyAndIsAffineFiniteCarrierObjOppositeOpensCarrierCarrierCommRingCatPresheafOpOpensTopHomAppTop)
        W U p J O hsup ?_
      intro i
      obtain ⟨e, he⟩ := hres i
      have := Hfin i
      rw [he]
      infer_instance
    have het : Etale p := by
      refine @IsZariskiLocalAtTarget.of_iSup_eq_top @Etale
        (HasRingHomProperty.instIsZariskiLocalAtTarget (P := @Etale)) W U p J O hsup ?_
      intro i
      obtain ⟨e, he⟩ := hres i
      have := Het i
      rw [he]
      infer_instance
    exact ⟨hfin, het⟩

  have fold_et : ∀ U : Scheme.{u}, Etale (Limits.coprod.desc (𝟙 U) (𝟙 U)) := by
    intro U
    refine @IsZariskiLocalAtSource.of_iSup_eq_top @Etale HasRingHomProperty.instIsZariskiLocalAtSource
      _ _ (Limits.coprod.desc (𝟙 U) (𝟙 U)) Bool
      (fun b => cond b (Limits.coprod.inr : U ⟶ U ⨿ U).opensRange
        (Limits.coprod.inl : U ⟶ U ⨿ U).opensRange) ?_ ?_
    · rw [iSup_bool_eq]
      exact (isCompl_opensRange_inl_inr U U).symm.sup_eq_top
    · intro b
      cases b
      · show Etale ((Limits.coprod.inl : U ⟶ U ⨿ U).opensRange.ι ≫ _)
        rw [← Scheme.Hom.isoOpensRange_inv_comp, Category.assoc, Limits.coprod.inl_desc,
          Category.comp_id]
        infer_instance
      · show Etale ((Limits.coprod.inr : U ⟶ U ⨿ U).opensRange.ι ≫ _)
        rw [← Scheme.Hom.isoOpensRange_inv_comp, Category.assoc, Limits.coprod.inr_desc,
          Category.comp_id]
        infer_instance

  have cdesc : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Z) (g : Y ⟶ Z), IsOpenImmersion f →
      IsOpenImmersion g → (∀ x y, f x ≠ g y) →
      IsOpenImmersion (Limits.coprod.desc f g) ∧
        Set.range (Limits.coprod.desc f g) = Set.range f ∪ Set.range g := by
    intro X Y Z f g hf hg hd
    have hl : ∀ x, Limits.coprod.desc f g ((Limits.coprod.inl : X ⟶ X ⨿ Y) x) = f x := fun x => by
      rw [← Scheme.Hom.comp_apply, Limits.coprod.inl_desc]
    have hr : ∀ y, Limits.coprod.desc f g ((Limits.coprod.inr : Y ⟶ X ⨿ Y) y) = g y := fun y => by
      rw [← Scheme.Hom.comp_apply, Limits.coprod.inr_desc]
    have hcases : ∀ w : ↥(X ⨿ Y), (∃ x, (Limits.coprod.inl : X ⟶ X ⨿ Y) x = w) ∨
        (∃ y, (Limits.coprod.inr : Y ⟶ X ⨿ Y) y = w) := by
      intro w
      obtain ⟨s, rfl⟩ := (coprodMk X Y).surjective w
      rcases s with x | y
      · left; exact ⟨x, (coprodMk_inl X Y x).symm⟩
      · right; exact ⟨y, (coprodMk_inr X Y y).symm⟩
    have hinj : Function.Injective (Limits.coprod.desc f g) := by
      intro w w' h
      rcases hcases w with ⟨x, rfl⟩ | ⟨y, rfl⟩ <;> rcases hcases w' with ⟨x', rfl⟩ | ⟨y', rfl⟩
      · rw [hl, hl] at h; rw [f.isOpenEmbedding.injective h]
      · rw [hl, hr] at h; exact absurd h (hd _ _)
      · rw [hr, hl] at h; exact absurd h.symm (hd _ _)
      · rw [hr, hr] at h; rw [g.isOpenEmbedding.injective h]
    refine ⟨IsOpenImmersion.of_forall_source_exists _ hinj (fun w => ?_), ?_⟩
    · rcases hcases w with ⟨x, rfl⟩ | ⟨y, rfl⟩
      · refine ⟨X, Limits.coprod.inl, inferInstance, Scheme.Hom.mem_opensRange.mpr ⟨x, rfl⟩, ?_⟩
        rw [Limits.coprod.inl_desc]; exact hf
      · refine ⟨Y, Limits.coprod.inr, inferInstance, Scheme.Hom.mem_opensRange.mpr ⟨y, rfl⟩, ?_⟩
        rw [Limits.coprod.inr_desc]; exact hg
    · ext z
      constructor
      · rintro ⟨w, rfl⟩
        rcases hcases w with ⟨x, rfl⟩ | ⟨y, rfl⟩
        · left; exact ⟨x, (hl x).symm⟩
        · right; exact ⟨y, (hr y).symm⟩
      · rintro (⟨x, rfl⟩ | ⟨y, rfl⟩)
        · exact ⟨_, hl x⟩
        · exact ⟨_, hr y⟩

  have hle : A ⊔ B ≤ V₁ ⊓ V₂ := hinf ▸ le_rfl
  have hA1 : A ≤ V₁ := le_sup_left.trans (hle.trans inf_le_left)
  have hA2 : A ≤ V₂ := le_sup_left.trans (hle.trans inf_le_right)
  have hB1 : B ≤ V₁ := le_sup_right.trans (hle.trans inf_le_left)
  have hB2 : B ≤ V₂ := le_sup_right.trans (hle.trans inf_le_right)
  have hAorB : ∀ y, y ∈ V₁ → y ∈ V₂ → y ∈ A ∨ y ∈ B := by
    intro y h1 h2
    have : y ∈ V₁ ⊓ V₂ := ⟨h1, h2⟩
    rw [hinf] at this
    exact this
  have hnAB : ∀ y, y ∈ A → y ∈ B → False := by
    intro y h1 h2
    have : y ∈ A ⊓ B := ⟨h1, h2⟩
    rw [hAB] at this
    exact this
  have hbot : ∀ y, y ∉ (⊥ : X₀.Opens) := fun y h => by simp at h
  have m2 : ∀ y, y ∉ V₁ → y ∈ V₂ := by
    intro y h
    have : y ∈ V₁ ⊔ V₂ := by rw [hsup]; trivial
    exact (TopologicalSpace.Opens.mem_sup.mp this).resolve_left h
  have m1 : ∀ y, y ∉ V₂ → y ∈ V₁ := by
    intro y h
    have : y ∈ V₁ ⊔ V₂ := by rw [hsup]; trivial
    exact (TopologicalSpace.Opens.mem_sup.mp this).resolve_right h

  obtain ⟨W, hW⟩ : ∃ W : ULift.{u} (Bool × Bool) → ULift.{u} (Bool × Bool) → X₀.Opens,
      ∀ j k, W j k = if j.down.1 = k.down.1 then (if j.down.2 = k.down.2 then cond j.down.1 V₂ V₁ else ⊥)
        else (if j.down.2 = k.down.2 then B else A) := ⟨_, fun _ _ => rfl⟩

  have hmemW : ∀ (a s a' t : Bool) (y : X₀), y ∈ W ⟨(a, s)⟩ ⟨(a', t)⟩ ↔
      (a = a' ∧ s = t ∧ y ∈ cond a V₂ V₁) ∨ (a ≠ a' ∧ s = t ∧ y ∈ B) ∨ (a ≠ a' ∧ s ≠ t ∧ y ∈ A) := by
    intro a s a' t y
    rw [hW]
    dsimp only
    by_cases h : a = a' <;> by_cases h' : s = t <;> simp [h, h']

  have g1 : ∀ j : ULift.{u} (Bool × Bool), W j j = cond j.down.1 V₂ V₁ := by
    rintro ⟨⟨a, s⟩⟩
    rw [hW]
    simp
  have g2 : ∀ j k : ULift.{u} (Bool × Bool), W j k ≤ cond j.down.1 V₂ V₁ := by
    rintro ⟨⟨a, s⟩⟩ ⟨⟨a', t⟩⟩ y hy
    rcases (hmemW a s a' t y).1 hy with ⟨rfl, -, h⟩ | ⟨-, -, h⟩ | ⟨-, -, h⟩
    · exact h
    · cases a
      · exact hB1 h
      · exact hB2 h
    · cases a
      · exact hA1 h
      · exact hA2 h
  have g3 : ∀ j k : ULift.{u} (Bool × Bool), W j k = W k j := by
    rintro ⟨⟨a, s⟩⟩ ⟨⟨a', t⟩⟩
    rw [hW, hW]
    cases a <;> cases a' <;> cases s <;> cases t <;> simp
  have g4 : ∀ i j k : ULift.{u} (Bool × Bool), W i j ⊓ W i k ≤ W j k := by
    rintro ⟨⟨a, s⟩⟩ ⟨⟨a', t⟩⟩ ⟨⟨a'', t''⟩⟩ y ⟨h1, h2⟩
    have h1' := (hmemW a s a' t y).1 h1
    have h2' := (hmemW a s a'' t'' y).1 h2
    apply (hmemW a' t a'' t'' y).2
    have pA1 : y ∈ A → y ∈ V₁ := fun h => hA1 h
    have pA2 : y ∈ A → y ∈ V₂ := fun h => hA2 h
    have pB1 : y ∈ B → y ∈ V₁ := fun h => hB1 h
    have pB2 : y ∈ B → y ∈ V₂ := fun h => hB2 h
    have pAB := hnAB y
    clear h1 h2
    cases a <;> cases a' <;> cases a'' <;> cases s <;> cases t <;> cases t'' <;>
      simp only [Bool.cond_true, Bool.cond_false, ne_eq, not_true_eq_false, not_false_eq_true,
        true_and, false_and, and_false, or_false, false_or, Bool.false_eq_true,
        Bool.true_eq_false] at h1' h2' ⊢ <;> tauto
  obtain ⟨P, π, ι, himm, hπ, hcov, hiff⟩ :=
    glue X₀ (ULift.{u} (Bool × Bool)) (fun j => cond j.down.1 V₂ V₁) W g1 g2 g3 g4
  have hπι : ∀ (j : ULift.{u} (Bool × Bool)) (x : ((cond j.down.1 V₂ V₁ : X₀.Opens) : Scheme.{u})),
      π (ι j x) = (cond j.down.1 V₂ V₁).ι x := by
    intro j x
    rw [← Scheme.Hom.comp_apply, hπ]

  have fib : ∀ (a : Bool) (y : X₀) (hy : y ∈ cond a V₂ V₁) (z : P), π z = y →
      ∃ c, z = ι ⟨(a, c)⟩ ⟨y, hy⟩ := by
    intro a y hy z hz
    obtain ⟨⟨⟨a', t⟩⟩, x, rfl⟩ := hcov z
    rw [hπι] at hz
    have hx : y ∈ cond a' V₂ V₁ := by rw [← hz]; exact x.2
    have key : ∀ c, y ∈ W ⟨(a', t)⟩ ⟨(a, c)⟩ → ι ⟨(a', t)⟩ x = ι ⟨(a, c)⟩ ⟨y, hy⟩ := by
      intro c hc
      exact (hiff _ _ _ _).2 ⟨hz, by rw [hz]; exact hc⟩
    by_cases ha : a' = a
    · subst ha
      exact ⟨t, key t ((hmemW _ _ _ _ y).2 (Or.inl ⟨rfl, rfl, hx⟩))⟩
    · have h12 : y ∈ V₁ ∧ y ∈ V₂ := by
        cases a <;> cases a'
        · exact absurd rfl ha
        · exact ⟨hy, hx⟩
        · exact ⟨hx, hy⟩
        · exact absurd rfl ha
      rcases hAorB y h12.1 h12.2 with hA | hB
      · exact ⟨!t, key (!t) ((hmemW _ _ _ _ y).2 (Or.inr (Or.inr ⟨ha, by cases t <;> decide, hA⟩)))⟩
      · exact ⟨t, key t ((hmemW _ _ _ _ y).2 (Or.inr (Or.inl ⟨ha, rfl, hB⟩)))⟩
  have dist : ∀ (a : Bool) (x x' : ((cond a V₂ V₁ : X₀.Opens) : Scheme.{u})),
      ι ⟨(a, false)⟩ x ≠ ι ⟨(a, true)⟩ x' := by
    intro a x x' h
    have := ((hiff _ _ _ _).1 h).2
    rcases (hmemW a false a true _).1 this with ⟨-, h', -⟩ | ⟨h', -⟩ | ⟨h', -⟩
    · exact absurd h' (by decide)
    · exact h' rfl
    · exact h' rfl

  obtain ⟨s₁, hs₁⟩ : ∃ s₁ : Bool → X₀ → P, ∀ b y (h : y ∈ V₁), s₁ b y = ι ⟨(false, b)⟩ ⟨y, h⟩ :=
    ⟨fun b y => if h : y ∈ V₁ then ι ⟨(false, b)⟩ ⟨y, h⟩ else ι ⟨(true, b)⟩ ⟨y, m2 y h⟩,
      fun b y h => dif_pos h⟩
  obtain ⟨s₂, hs₂⟩ : ∃ s₂ : Bool → X₀ → P, ∀ b y (h : y ∈ V₂), s₂ b y = ι ⟨(true, b)⟩ ⟨y, h⟩ :=
    ⟨fun b y => if h : y ∈ V₂ then ι ⟨(true, b)⟩ ⟨y, h⟩ else ι ⟨(false, b)⟩ ⟨y, m1 y h⟩,
      fun b y h => dif_pos h⟩

  have hcover : ∀ x : X₀, ∃ a : ULift.{u} Bool, x ∈ cond a.down V₂ V₁ := by
    intro x
    by_cases h : x ∈ V₁
    · exact ⟨⟨false⟩, h⟩
    · exact ⟨⟨true⟩, m2 x h⟩
  have hκ : ∀ a : ULift.{u} Bool,
      IsOpenImmersion (Limits.coprod.desc (ι ⟨(a.down, false)⟩) (ι ⟨(a.down, true)⟩)) ∧
      Set.range (Limits.coprod.desc (ι ⟨(a.down, false)⟩) (ι ⟨(a.down, true)⟩)) =
        Set.range (ι ⟨(a.down, false)⟩) ∪ Set.range (ι ⟨(a.down, true)⟩) :=
    fun a => cdesc _ _ (himm _) (himm _) (dist a.down)
  obtain ⟨hfin, het⟩ := gfe X₀ (ULift.{u} Bool) (fun a => cond a.down V₂ V₁)
    (fun a => ((cond a.down V₂ V₁ : X₀.Opens) : Scheme.{u}) ⨿ ((cond a.down V₂ V₁ : X₀.Opens) : Scheme.{u}))
    (fun a => Limits.coprod.desc (𝟙 _) (𝟙 _)) P π
    (fun a => Limits.coprod.desc (ι ⟨(a.down, false)⟩) (ι ⟨(a.down, true)⟩)) hcover
    (fun a => (hκ a).1)
    (fun a => by
      apply Limits.coprod.hom_ext
      · rw [Limits.coprod.inl_desc_assoc, Limits.coprod.inl_desc_assoc, Category.id_comp]
        exact hπ _
      · rw [Limits.coprod.inr_desc_assoc, Limits.coprod.inr_desc_assoc, Category.id_comp]
        exact hπ _)
    (fun a => by
      rw [(hκ a).2]
      ext z
      constructor
      · rintro (⟨x, rfl⟩ | ⟨x, rfl⟩)
        · show π (ι _ x) ∈ cond a.down V₂ V₁
          rw [hπι]; exact x.2
        · show π (ι _ x) ∈ cond a.down V₂ V₁
          rw [hπι]; exact x.2
      · intro hz
        obtain ⟨c, hc⟩ := fib a.down (π z) hz z rfl
        cases c
        · left; exact ⟨_, hc.symm⟩
        · right; exact ⟨_, hc.symm⟩)
    (fun a => inferInstance) (fun a => fold_et _)
  refine ⟨P, π, s₁, s₂, hfin, het, ⟨fun y => ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · by_cases h : y ∈ V₁
    · exact ⟨ι ⟨(false, false)⟩ ⟨y, h⟩, hπι _ _⟩
    · exact ⟨ι ⟨(true, false)⟩ ⟨y, m2 y h⟩, hπι _ _⟩
  · intro b y hy
    apply ContinuousAt.continuousWithinAt
    have e : s₁ b ∘ ⇑V₁.ι = ⇑(ι ⟨(false, b)⟩) := by
      funext w
      exact hs₁ b _ w.2
    have := ((V₁.ι).isOpenEmbedding.continuousAt_iff (g := s₁ b) (x := ⟨y, hy⟩)).1
      (by rw [e]; exact (ι _).continuous.continuousAt)
    exact this
  · intro b y hy
    apply ContinuousAt.continuousWithinAt
    have e : s₂ b ∘ ⇑V₂.ι = ⇑(ι ⟨(true, b)⟩) := by
      funext w
      exact hs₂ b _ w.2
    have := ((V₂.ι).isOpenEmbedding.continuousAt_iff (g := s₂ b) (x := ⟨y, hy⟩)).1
      (by rw [e]; exact (ι _).continuous.continuousAt)
    exact this
  · intro y hy
    rw [hs₁ false y hy, hs₁ true y hy]
    refine ⟨?_, dist false _ _⟩
    ext z
    simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_insert_iff]
    constructor
    · intro hz
      obtain ⟨c, rfl⟩ := fib false y hy z hz
      cases c
      · left; rfl
      · right; rfl
    · rintro (rfl | rfl) <;> exact hπι _ _
  · intro y hy
    rw [hs₂ false y hy, hs₂ true y hy]
    refine ⟨?_, dist true _ _⟩
    ext z
    simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_insert_iff]
    constructor
    · intro hz
      obtain ⟨c, rfl⟩ := fib true y hy z hz
      cases c
      · left; rfl
      · right; rfl
    · rintro (rfl | rfl) <;> exact hπι _ _
  · intro b y hy
    rw [hs₂ b y (hB2 hy), hs₁ b y (hB1 hy)]
    exact (hiff _ _ _ _).2 ⟨rfl, (hmemW true b false b y).2 (Or.inr (Or.inl ⟨by decide, rfl, hy⟩))⟩
  · intro b y hy
    rw [hs₂ b y (hA2 hy), hs₁ (!b) y (hA1 hy)]
    exact (hiff _ _ _ _).2 ⟨rfl, (hmemW true b false (!b) y).2
      (Or.inr (Or.inr ⟨by decide, by cases b <;> decide, hy⟩))⟩

theorem wcpa_dj_lus_cvs_ct_fc_tc_no_transversal : ∀ {X P : Type u} [TopologicalSpace X] [TopologicalSpace P] (p : P → X) (n : ℕ) (C : Fin (n + 2) → Set X) (x : Fin (n + 2) → X) (V₁ V₂ A B : Set X) (s₁ s₂ : Bool → X → P), (∀ i, IsClosed (C i) ∧ IsIrreducible (C i)) → Function.Injective x → (∀ i, x i ∈ C i ∧ x i ∈ C (finRotate (n + 2) i)) → IsClosed ({x (Fin.last (n + 1))} : Set X) → V₁ = {x (Fin.last (n + 1))}ᶜ → IsOpen V₂ → x (Fin.last (n + 1)) ∈ V₂ → (V₂ ∩ C (Fin.last (n + 1))) \ {x (Fin.last (n + 1))} ⊆ A → (V₂ ∩ C 0) \ {x (Fin.last (n + 1))} ⊆ B → (∀ b, ContinuousOn (s₁ b) V₁) → (∀ b, ContinuousOn (s₂ b) V₂) → (∀ y ∈ V₁, p ⁻¹' {y} = {s₁ false y, s₁ true y} ∧ s₁ false y ≠ s₁ true y) → (∀ y ∈ V₂, p ⁻¹' {y} = {s₂ false y, s₂ true y} ∧ s₂ false y ≠ s₂ true y) → (∀ b, ∀ y ∈ B, s₂ b y = s₁ b y) → (∀ b, ∀ y ∈ A, s₂ b y = s₁ (!b) y) → ∀ S₀ : Set P, IsClosed S₀ → ¬ ∀ y ∈ ⋃ i, C i, (p ⁻¹' {y} ∩ S₀).ncard = 1 :=
by
  intro X P _ _ p n C x V₁ V₂ A B s₁ s₂ hC hx hxC hcl hV₁ hV₂o hxV₂ hA hB hc₁ hc₂ hf₁ hf₂ htB htA
    S₀ hS₀ H

  have s1 : ∀ (s : Bool → X → P) (y : X), p ⁻¹' {y} = {s false y, s true y} →
      s false y ≠ s true y → (p ⁻¹' {y} ∩ S₀).ncard = 1 →
      (∃ b, s b y ∈ S₀) ∧ ∀ b b', s b y ∈ S₀ → s b' y ∈ S₀ → b = b' := by
    intro s y hfib hne hcard
    obtain ⟨z, hz⟩ := Set.ncard_eq_one.mp hcard
    have hmem : ∀ c, s c y ∈ p ⁻¹' {y} := by
      intro c
      rw [hfib]
      cases c
      · exact Set.mem_insert _ _
      · exact Set.mem_insert_of_mem _ (Set.mem_singleton _)
    refine ⟨?_, ?_⟩
    · have hzm : z ∈ p ⁻¹' {y} ∩ S₀ := by rw [hz]; exact Set.mem_singleton z
      have h1 := hzm.1
      rw [hfib] at h1
      rcases h1 with h | h
      · exact ⟨false, by rw [← h]; exact hzm.2⟩
      · rw [Set.mem_singleton_iff] at h
        exact ⟨true, by rw [← h]; exact hzm.2⟩
    · intro b b' hb hb'
      have e1 : s b y ∈ ({z} : Set P) := by rw [← hz]; exact ⟨hmem b, hb⟩
      have e2 : s b' y ∈ ({z} : Set P) := by rw [← hz]; exact ⟨hmem b', hb'⟩
      rw [Set.mem_singleton_iff] at e1 e2
      have e : s b y = s b' y := e1.trans e2.symm
      cases b <;> cases b'
      · rfl
      · exact absurd e hne
      · exact absurd e.symm hne
      · rfl

  have s2 : ∀ (s : Bool → X → P) (V Q : Set X), (∀ b, ContinuousOn (s b) V) → Q ⊆ V →
      IsPreconnected Q → (∀ y ∈ Q, ∃ b, s b y ∈ S₀) →
      (∀ y ∈ Q, ∀ b b', s b y ∈ S₀ → s b' y ∈ S₀ → b = b') →
      ∃ b, ∀ y ∈ Q, s b y ∈ S₀ := by
    intro s V Q hs hQV hQ hex huniq
    have key : ∀ c : Bool, ∃ u, IsClosed u ∧ ∀ y ∈ V, (s c y ∈ S₀ ↔ y ∈ u) := by
      intro c
      obtain ⟨u, hu, hue⟩ := continuousOn_iff_isClosed.mp (hs c) S₀ hS₀
      refine ⟨u, hu, fun y hy => ⟨fun h => ?_, fun h => ?_⟩⟩
      · have : y ∈ s c ⁻¹' S₀ ∩ V := ⟨h, hy⟩
        rw [hue] at this
        exact this.1
      · have : y ∈ u ∩ V := ⟨h, hy⟩
        rw [← hue] at this
        exact this.1
    obtain ⟨u0, hu0, k0⟩ := key false
    obtain ⟨u1, hu1, k1⟩ := key true
    have hcov : Q ⊆ u0 ∪ u1 := by
      intro y hy
      obtain ⟨b, hb⟩ := hex y hy
      cases b
      · exact Or.inl ((k0 y (hQV hy)).mp hb)
      · exact Or.inr ((k1 y (hQV hy)).mp hb)
    have hdis : Q ∩ (u0 ∩ u1) = ∅ := by
      ext y
      simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
      intro hy h0 h1
      exact Bool.false_ne_true
        (huniq y hy false true ((k0 y (hQV hy)).mpr h0) ((k1 y (hQV hy)).mpr h1))
    rcases isPreconnected_iff_subset_of_disjoint_closed.mp hQ u0 u1 hu0 hu1 hcov hdis with h | h
    · exact ⟨false, fun y hy => (k0 y (hQV hy)).mpr (h hy)⟩
    · exact ⟨true, fun y hy => (k1 y (hQV hy)).mpr (h hy)⟩

  have s3 : ∀ (D O : Set X), IsClosed D → IsIrreducible D → IsOpen O →
      IsPreconnected (D ∩ O) := by
    intro D O hD hDi hO
    rcases (D ∩ O).eq_empty_or_nonempty with h | h
    · rw [h]; exact isPreconnected_empty
    · have h1 : D ⊆ closure (D ∩ O) :=
        subset_closure_inter_of_isPreirreducible_of_isOpen hDi.isPreirreducible hO h
      have h2 : closure (D ∩ O) ⊆ D :=
        (closure_mono Set.inter_subset_left).trans hD.closure_eq.le
      have h3 : closure (D ∩ O) = D := h2.antisymm h1
      have h4 : IsPreirreducible (closure (D ∩ O)) := by rw [h3]; exact hDi.isPreirreducible
      exact (isPreirreducible_iff_closure.mp h4).isPreconnected

  have s4 : ∀ (D O : Set X) (z w : X), IsIrreducible D → IsOpen O → z ∈ D → z ∈ O →
      IsClosed ({z} : Set X) → w ∈ D → w ≠ z → ∃ a, a ∈ D ∧ a ∈ O ∧ a ≠ z := by
    intro D O z w hD hO hzD hzO hz hwD hwz
    by_contra hcon
    push_neg at hcon
    have h1 : D ⊆ closure (D ∩ O) :=
      subset_closure_inter_of_isPreirreducible_of_isOpen hD.isPreirreducible hO ⟨z, hzD, hzO⟩
    have h2 : D ∩ O ⊆ {z} := fun a ha => hcon a ha.1 ha.2
    have h3 : closure (D ∩ O) ⊆ {z} := (closure_mono h2).trans hz.closure_eq.le
    exact hwz (h3 (h1 hwD))

  have hV₁o : IsOpen V₁ := by rw [hV₁]; exact hcl.isOpen_compl
  have memV₁ : ∀ y, y ≠ x (Fin.last (n + 1)) → y ∈ V₁ := fun y h => by rw [hV₁]; exact h
  have memU : ∀ i y, y ∈ C i → y ∈ ⋃ i, C i := fun i y h => Set.mem_iUnion.mpr ⟨i, h⟩
  have fib₁ : ∀ i y, y ∈ C i → y ∈ V₁ → (∃ b, s₁ b y ∈ S₀) ∧
      ∀ b b', s₁ b y ∈ S₀ → s₁ b' y ∈ S₀ → b = b' := fun i y hy hV =>
    s1 s₁ y (hf₁ y hV).1 (hf₁ y hV).2 (H y (memU i y hy))
  have fib₂ : ∀ i y, y ∈ C i → y ∈ V₂ → (∃ b, s₂ b y ∈ S₀) ∧
      ∀ b b', s₂ b y ∈ S₀ → s₂ b' y ∈ S₀ → b = b' := fun i y hy hV =>
    s1 s₂ y (hf₂ y hV).1 (hf₂ y hV).2 (H y (memU i y hy))
  have ne_star : ∀ i, i ≠ Fin.last (n + 1) → x i ≠ x (Fin.last (n + 1)) :=
    fun i hi h => hi (hx h)
  have F1 : ∀ i : Fin (n + 1), finRotate (n + 2) i.castSucc = i.succ := by
    intro i
    apply Fin.ext
    rw [coe_finRotate_of_ne_last (Fin.castSucc_lt_last i).ne]
    simp

  have sheet : ∀ i, ∃ b, ∀ y ∈ C i ∩ V₁, s₁ b y ∈ S₀ := fun i =>
    s2 s₁ V₁ (C i ∩ V₁) hc₁ Set.inter_subset_right (s3 _ _ (hC i).1 (hC i).2 hV₁o)
      (fun y hy => (fib₁ i y hy.1 hy.2).1) (fun y hy => (fib₁ i y hy.1 hy.2).2)
  obtain ⟨β₁, hβ₁0⟩ := sheet 0
  have hβ₁ : ∀ i : Fin (n + 2), ∀ y ∈ C i ∩ V₁, s₁ β₁ y ∈ S₀ := by
    intro i
    induction i using Fin.induction with
    | zero => exact hβ₁0
    | succ i ih =>
      obtain ⟨b', hb'⟩ := sheet i.succ
      have hy0 : x i.castSucc ∈ C i.castSucc ∩ V₁ :=
        ⟨(hxC _).1, memV₁ _ (ne_star _ (Fin.castSucc_lt_last i).ne)⟩
      have hy1 : x i.castSucc ∈ C i.succ ∩ V₁ := by
        refine ⟨?_, hy0.2⟩
        rw [← F1 i]
        exact (hxC _).2
      have e := (fib₁ _ _ hy0.1 hy0.2).2 b' β₁ (hb' _ hy1) (ih _ hy0)
      rw [e] at hb'
      exact hb'

  obtain ⟨b', hb'⟩ := s2 s₂ V₂ (C (Fin.last (n + 1)) ∩ V₂) hc₂ Set.inter_subset_right
    (s3 _ _ (hC _).1 (hC _).2 hV₂o) (fun y hy => (fib₂ _ y hy.1 hy.2).1)
    (fun y hy => (fib₂ _ y hy.1 hy.2).2)
  obtain ⟨b'', hb''⟩ := s2 s₂ V₂ (C 0 ∩ V₂) hc₂ Set.inter_subset_right
    (s3 _ _ (hC _).1 (hC _).2 hV₂o) (fun y hy => (fib₂ _ y hy.1 hy.2).1)
    (fun y hy => (fib₂ _ y hy.1 hy.2).2)
  have hx0 : x (Fin.last (n + 1)) ∈ C 0 := by
    have := (hxC (Fin.last (n + 1))).2
    rwa [finRotate_last] at this
  have hbb : b' = b'' := (fib₂ _ _ (hxC (Fin.last (n + 1))).1 hxV₂).2 b' b''
    (hb' _ ⟨(hxC _).1, hxV₂⟩) (hb'' _ ⟨hx0, hxV₂⟩)
  rw [← hbb] at hb''

  have hj0 : x (Fin.last n).castSucc ∈ C (Fin.last (n + 1)) := by
    have := (hxC (Fin.last n).castSucc).2
    rwa [F1, Fin.succ_last] at this
  obtain ⟨a₀, ha₀C, ha₀V, ha₀ne⟩ := s4 (C (Fin.last (n + 1))) V₂ (x (Fin.last (n + 1)))
    (x (Fin.last n).castSucc) (hC _).2 hV₂o (hxC _).1 hxV₂ hcl hj0
    (ne_star _ (Fin.castSucc_lt_last _).ne)
  obtain ⟨b₀, hb₀C, hb₀V, hb₀ne⟩ := s4 (C 0) V₂ (x (Fin.last (n + 1))) (x 0) (hC 0).2 hV₂o
    hx0 hxV₂ hcl (hxC 0).1 (ne_star 0 Fin.last_pos.ne)

  have e1 : b' = β₁ := (fib₁ 0 b₀ hb₀C (memV₁ _ hb₀ne)).2 b' β₁
    (by rw [← htB b' b₀ (hB ⟨⟨hb₀V, hb₀C⟩, hb₀ne⟩)]; exact hb'' _ ⟨hb₀C, hb₀V⟩)
    (hβ₁ 0 b₀ ⟨hb₀C, memV₁ _ hb₀ne⟩)
  have e2 : (!b') = β₁ := (fib₁ _ a₀ ha₀C (memV₁ _ ha₀ne)).2 (!b') β₁
    (by rw [← htA b' a₀ (hA ⟨⟨ha₀V, ha₀C⟩, ha₀ne⟩)]; exact hb' _ ⟨ha₀C, ha₀V⟩)
    (hβ₁ _ a₀ ⟨ha₀C, memV₁ _ ha₀ne⟩)
  rw [← e1] at e2
  exact Bool.not_ne_self b' e2

theorem wcpa_dj_lus_cvs_ct_fc_twisted_cover : ∀ (X₀ : Scheme.{u}) [CompactSpace ↥X₀] [QuasiSeparatedSpace ↥X₀] (n : ℕ) (C : Fin (n + 2) → Set ↥X₀) (x : Fin (n + 2) → ↥X₀) (N : Set ↥X₀), (∀ i, IsClosed (C i) ∧ IsIrreducible (C i)) → Function.Injective x → (∀ i, x i ∈ C i ∧ x i ∈ C (finRotate (n + 2) i)) → IsClosed ({x (Fin.last (n + 1))} : Set ↥X₀) → IsOpen N → x (Fin.last (n + 1)) ∈ N → N ⊆ C (Fin.last (n + 1)) ∪ C 0 → N ∩ C (Fin.last (n + 1)) ∩ C 0 ⊆ {x (Fin.last (n + 1))} → ∃ (P₀ : Scheme.{u}) (p₀ : P₀ ⟶ X₀), IsFinite p₀ ∧ Etale p₀ ∧ Surjective p₀ ∧ ∀ S₀ : Set ↥P₀, IsClosed S₀ → ¬ ∀ y ∈ ⋃ i, C i, (p₀ ⁻¹' {y} ∩ S₀).ncard = 1 :=
by
  intro X₀ _ _ n C x N hC hx hxC hcl hNo hxN hNsub hNint
  let V₁ : X₀.Opens := ⟨{x (Fin.last (n + 1))}ᶜ, hcl.isOpen_compl⟩
  let V₂ : X₀.Opens := ⟨N, hNo⟩
  let A : X₀.Opens := ⟨N ∩ {x (Fin.last (n + 1))}ᶜ ∩ (C 0)ᶜ,
    (hNo.inter hcl.isOpen_compl).inter (hC 0).1.isOpen_compl⟩
  let B : X₀.Opens := ⟨N ∩ {x (Fin.last (n + 1))}ᶜ ∩ (C (Fin.last (n + 1)))ᶜ,
    (hNo.inter hcl.isOpen_compl).inter (hC (Fin.last (n + 1))).1.isOpen_compl⟩
  have h1 : V₁ ⊔ V₂ = ⊤ := by
    apply TopologicalSpace.Opens.ext
    rw [TopologicalSpace.Opens.coe_sup, TopologicalSpace.Opens.coe_top]
    show ({x (Fin.last (n + 1))}ᶜ : Set ↥X₀) ∪ N = Set.univ
    ext y
    constructor
    · intro _; exact Set.mem_univ y
    · intro _
      by_cases hy : y = x (Fin.last (n + 1))
      · right; rw [hy]; exact hxN
      · left; exact hy
  have h2 : V₁ ⊓ V₂ = A ⊔ B := by
    apply TopologicalSpace.Opens.ext
    rw [TopologicalSpace.Opens.coe_inf, TopologicalSpace.Opens.coe_sup]
    show ({x (Fin.last (n + 1))}ᶜ : Set ↥X₀) ∩ N =
      (N ∩ {x (Fin.last (n + 1))}ᶜ ∩ (C 0)ᶜ) ∪
        (N ∩ {x (Fin.last (n + 1))}ᶜ ∩ (C (Fin.last (n + 1)))ᶜ)
    ext y
    constructor
    · rintro ⟨hy1, hy2⟩
      by_cases h0 : y ∈ C 0
      · right
        exact ⟨⟨hy2, hy1⟩, fun hL' => hy1 (hNint ⟨⟨hy2, hL'⟩, h0⟩)⟩
      · left
        exact ⟨⟨hy2, hy1⟩, h0⟩
    · rintro (⟨⟨hy2, hy1⟩, _⟩ | ⟨⟨hy2, hy1⟩, _⟩)
      · exact ⟨hy1, hy2⟩
      · exact ⟨hy1, hy2⟩
  have h3 : A ⊓ B = ⊥ := by
    apply TopologicalSpace.Opens.ext
    rw [TopologicalSpace.Opens.coe_inf, TopologicalSpace.Opens.coe_bot]
    show (N ∩ {x (Fin.last (n + 1))}ᶜ ∩ (C 0)ᶜ) ∩
      (N ∩ {x (Fin.last (n + 1))}ᶜ ∩ (C (Fin.last (n + 1)))ᶜ) = ∅
    ext y
    constructor
    · rintro ⟨⟨⟨hyN, _⟩, h0⟩, ⟨_, hL'⟩⟩
      rcases hNsub hyN with h | h
      · exact absurd h hL'
      · exact absurd h h0
    · intro h; exact absurd h (Set.notMem_empty y)
  have hA : (N ∩ C (Fin.last (n + 1))) \ {x (Fin.last (n + 1))} ⊆
      N ∩ {x (Fin.last (n + 1))}ᶜ ∩ (C 0)ᶜ := by
    rintro y ⟨⟨hyN, hyL⟩, hyx⟩
    exact ⟨⟨hyN, hyx⟩, fun h0 => hyx (hNint ⟨⟨hyN, hyL⟩, h0⟩)⟩
  have hB : (N ∩ C 0) \ {x (Fin.last (n + 1))} ⊆
      N ∩ {x (Fin.last (n + 1))}ᶜ ∩ (C (Fin.last (n + 1)))ᶜ := by
    rintro y ⟨⟨hyN, hy0⟩, hyx⟩
    exact ⟨⟨hyN, hyx⟩, fun hL' => hyx (hNint ⟨⟨hyN, hL'⟩, hy0⟩)⟩
  obtain ⟨P, p, s₁, s₂, hfin, het, hsurj, hc₁, hc₂, hf₁, hf₂, htB, htA⟩ :=
    wcpa_dj_lus_cvs_ct_fc_tc_double_cover X₀ V₁ V₂ A B h1 h2 h3
  refine ⟨P, p, hfin, het, hsurj, fun S₀ hS₀ => ?_⟩
  exact wcpa_dj_lus_cvs_ct_fc_tc_no_transversal (⇑p) n C x {x (Fin.last (n + 1))}ᶜ N
    (N ∩ {x (Fin.last (n + 1))}ᶜ ∩ (C 0)ᶜ)
    (N ∩ {x (Fin.last (n + 1))}ᶜ ∩ (C (Fin.last (n + 1)))ᶜ) s₁ s₂ hC hx hxC hcl rfl hNo hxN
    hA hB hc₁ hc₂ hf₁ hf₂ htB htA S₀ hS₀

theorem wcpa_dj_fcs_normal_trivial_residue_unique_prime : ∀ (A B : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [CommRing B] (φ : A →+* B), φ.IsIntegral → ∀ t₀ : PrimeSpectrum B, t₀.asIdeal.comap φ = ⊥ → (∀ b : B, ∃ a a' : A, a' ≠ 0 ∧ b * φ a' - φ a ∈ t₀.asIdeal) → ∀ p : PrimeSpectrum A, ∃! t : PrimeSpectrum B, t₀ ≤ t ∧ t.asIdeal.comap φ = p.asIdeal :=
by
  intro A B _ _ _ _ φ hφ t₀ hker hres p
  classical
  haveI hIp : t₀.asIdeal.IsPrime := t₀.isPrime
  let π : B →+* B ⧸ t₀.asIdeal := Ideal.Quotient.mk t₀.asIdeal
  let ψ : A →+* B ⧸ t₀.asIdeal := π.comp φ
  have hψ : ∀ a, ψ a = π (φ a) := fun a => rfl

  have hinj : Function.Injective ψ := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    have h1 : φ a ∈ t₀.asIdeal := Ideal.Quotient.eq_zero_iff_mem.mp ha
    have h2 : a ∈ t₀.asIdeal.comap φ := h1
    rw [hker] at h2
    exact (Ideal.mem_bot).mp h2

  have hsurj : Function.Surjective ψ := by
    intro d
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective d
    obtain ⟨a, a', ha', hmem⟩ := hres b
    have hbir : ψ a' * π b = ψ a := by
      rw [hψ, hψ, mul_comm, ← map_mul]
      exact Ideal.Quotient.eq.mpr hmem
    obtain ⟨f, hfm, hf⟩ := hφ b
    have hf' : Polynomial.eval₂ ψ (π b) f = 0 := by
      have := Polynomial.hom_eval₂ f φ π b
      rw [hf, map_zero] at this
      exact this.symm
    have hg1 : ψ ((f.scaleRoots a').eval a) = 0 := by
      rw [← Polynomial.eval₂_hom, ← hbir, Polynomial.scaleRoots_eval₂_mul, hf', mul_zero]
    have hg : (f.scaleRoots a').eval a = 0 := by
      rw [← map_zero ψ] at hg1
      exact hinj hg1
    let K := FractionRing A
    let ι : A →+* K := algebraMap A K
    have hιinj : Function.Injective ι := IsFractionRing.injective A K
    let c : K := IsLocalization.mk' K a ⟨a', mem_nonZeroDivisors_of_ne_zero ha'⟩
    have hc : ι a' * c = ι a := IsLocalization.mk'_spec' K a ⟨a', mem_nonZeroDivisors_of_ne_zero ha'⟩
    have hι0 : ι a' ≠ 0 := by
      intro h
      apply ha'
      apply hιinj
      rw [h, map_zero]
    have hcf : Polynomial.eval₂ ι c f = 0 := by
      have h1 := Polynomial.scaleRoots_eval₂_mul (p := f) ι c a'
      rw [hc, Polynomial.eval₂_hom, hg, map_zero] at h1
      exact (mul_eq_zero.mp h1.symm).resolve_left (pow_ne_zero _ hι0)
    have hcint : IsIntegral A c := ⟨f, hfm, hcf⟩
    obtain ⟨a₀, ha₀⟩ := (IsIntegrallyClosed.isIntegral_iff (K := K)).mp hcint
    have ha₀a : a₀ * a' = a := by
      apply hιinj
      rw [map_mul]
      change ι a₀ * ι a' = ι a
      rw [ha₀, mul_comm, hc]
    refine ⟨a₀, ?_⟩
    have hne : ψ a' ≠ 0 := by
      intro h
      apply ha'
      apply hinj
      rw [h, map_zero]
    have h3 : ψ a' * (π b - ψ a₀) = 0 := by
      rw [mul_sub, hbir, mul_comm, ← map_mul, ha₀a, sub_self]
    have h4 := (mul_eq_zero.mp h3).resolve_left hne
    exact (sub_eq_zero.mp h4).symm

  let e : A ≃+* B ⧸ t₀.asIdeal := RingEquiv.ofBijective ψ ⟨hinj, hsurj⟩
  have he : ∀ a, e a = ψ a := fun a => rfl
  have hkey : ∀ x : B, φ (e.symm (π x)) - x ∈ t₀.asIdeal := by
    intro x
    apply Ideal.Quotient.eq.mp
    show π (φ (e.symm (π x))) = π x
    rw [← hψ, ← he, RingEquiv.apply_symm_apply]
  let T : Ideal B := p.asIdeal.comap ((e.symm : B ⧸ t₀.asIdeal →+* A).comp π)
  have hmemT : ∀ x, x ∈ T ↔ e.symm (π x) ∈ p.asIdeal := fun x => Iff.rfl
  haveI hTp : T.IsPrime := Ideal.comap_isPrime _ _
  refine ⟨⟨T, hTp⟩, ⟨?_, ?_⟩, ?_⟩
  · show t₀.asIdeal ≤ T
    intro x hx
    rw [hmemT]
    have : π x = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hx
    rw [this, map_zero]
    exact p.asIdeal.zero_mem
  · ext a
    show e.symm (π (φ a)) ∈ p.asIdeal ↔ a ∈ p.asIdeal
    rw [← hψ, ← he, RingEquiv.symm_apply_apply]
  · rintro t ⟨ht1, ht2⟩
    have ht1' : t₀.asIdeal ≤ t.asIdeal := ht1
    apply PrimeSpectrum.ext
    ext x
    show x ∈ t.asIdeal ↔ e.symm (π x) ∈ p.asIdeal
    rw [← ht2, Ideal.mem_comap]
    have hk := ht1' (hkey x)
    constructor
    · intro hx
      have := t.asIdeal.add_mem hk hx
      rwa [sub_add_cancel] at this
    · intro hx
      have := t.asIdeal.sub_mem hx hk
      rwa [sub_sub_cancel] at this

theorem wcpa_dj_fcs_finite_normal_closure_section : ∀ (Z W : Scheme.{u}) [AlgebraicGeometry.IsIntegral Z], (∀ U : Z.Opens, IsAffineOpen U → Nonempty ↥U → IsIntegrallyClosed ↑Γ(Z, U)) → (∀ (A B : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [CommRing B] (φ : A →+* B), φ.IsIntegral → ∀ t₀ : PrimeSpectrum B, t₀.asIdeal.comap φ = ⊥ → (∀ b : B, ∃ a a' : A, a' ≠ 0 ∧ b * φ a' - φ a ∈ t₀.asIdeal) → ∀ p : PrimeSpectrum A, ∃! t : PrimeSpectrum B, t₀ ≤ t ∧ t.asIdeal.comap φ = p.asIdeal) → ∀ (q : W ⟶ Z), IsFinite q → ∀ x : ↥W, closure ({q x} : Set ↥Z) = Set.univ → Function.Surjective (Scheme.Hom.residueFieldMap q x).hom → ∃ S : Set ↥W, IsClosed S ∧ ∀ w : ↥Z, (q ⁻¹' {w} ∩ S).ncard = 1 :=
by
  intro Z W _ hnorm halg q hq x hgen hres
  haveI := hq
  refine ⟨closure {x}, isClosed_closure, ?_⟩
  intro w
  obtain ⟨U, hU, hw, -⟩ := exists_isAffineOpen_mem_and_subset (x := w) (U := ⊤) trivial
  have hV : IsAffineOpen (q ⁻¹ᵁ U) := hU.preimage q
  haveI : Nonempty U := ⟨⟨w, hw⟩⟩
  haveI : IsDomain Γ(Z, U) := AlgebraicGeometry.IsIntegral.component_integral U
  haveI : IsIntegrallyClosed Γ(Z, U) := hnorm U hU ⟨⟨w, hw⟩⟩
  have hφ : (q.app U).hom.IsIntegral := (IsFinite.finite_app q U hU).to_isIntegral

  have hqx : q x ∈ U := by
    have h1 : w ∈ closure ({q x} : Set Z) := by rw [hgen]; trivial
    exact (specializes_iff_mem_closure.mpr h1).mem_open U.isOpen hw
  have hx : x ∈ q ⁻¹ᵁ U := hqx
  have hxt : hV.fromSpec (hV.primeIdealOf ⟨x, hx⟩) = x := hV.fromSpec_primeIdealOf _
  have hUemb : Topology.IsEmbedding hU.fromSpec := hU.fromSpec.isOpenEmbedding.isEmbedding
  have hVemb : Topology.IsEmbedding hV.fromSpec := hV.fromSpec.isOpenEmbedding.isEmbedding

  have hsq : ∀ T : PrimeSpectrum Γ(W, q ⁻¹ᵁ U),
      hU.fromSpec (PrimeSpectrum.comap (q.app U).hom T) = q (hV.fromSpec T) := by
    intro T
    have h := IsAffineOpen.SpecMap_appLE_fromSpec q hU hV le_rfl
    rw [Scheme.Hom.appLE_eq_app] at h
    have h2 := congrArg (fun f : Spec Γ(W, q ⁻¹ᵁ U) ⟶ Z => f (T : Spec Γ(W, q ⁻¹ᵁ U))) h
    simp only at h2
    exact h2

  have hbot : (hU.primeIdealOf ⟨q x, hqx⟩).asIdeal = ⊥ := by
    let Q : PrimeSpectrum Γ(Z, U) := ⟨⊥, Ideal.isPrime_bot⟩
    have h1 : hU.fromSpec Q ∈ closure ({q x} : Set Z) := by rw [hgen]; trivial
    have h1' : q x ⤳ hU.fromSpec Q := specializes_iff_mem_closure.mpr h1
    have e : hU.fromSpec (hU.primeIdealOf ⟨q x, hqx⟩) = q x := hU.fromSpec_primeIdealOf _
    rw [← e] at h1'
    have h2 := hUemb.isInducing.specializes_iff.mp h1'
    have h3 : hU.primeIdealOf ⟨q x, hqx⟩ ≤ Q := (PrimeSpectrum.le_iff_specializes _ _).mpr h2
    exact le_bot_iff.mp h3

  have hcomap : (hV.primeIdealOf ⟨x, hx⟩).asIdeal.comap (q.app U).hom = ⊥ := by
    have e1 := hsq (hV.primeIdealOf ⟨x, hx⟩)
    rw [hxt] at e1
    have e2 : hU.fromSpec (PrimeSpectrum.comap (q.app U).hom (hV.primeIdealOf ⟨x, hx⟩)) =
        hU.fromSpec (hU.primeIdealOf ⟨q x, hqx⟩) := by
      rw [e1, hU.fromSpec_primeIdealOf]
    have e3 := hUemb.injective e2
    rw [← PrimeSpectrum.comap_asIdeal, e3, hbot]

  have hgr : ∀ y : Γ(Z, U), (Z.residue (q x)).hom ((Z.presheaf.germ U (q x) hqx).hom y) =
      (Z.evaluation U (q x) hqx).hom y := fun y => by
    rw [← Scheme.germ_residue]; rfl
  have hnat : ∀ y : Γ(Z, U), (q.residueFieldMap x).hom ((Z.evaluation U (q x) hqx).hom y) =
      (W.evaluation (q ⁻¹ᵁ U) x hx).hom ((q.app U).hom y) := fun y => by
    have h := Scheme.evaluation_naturality q x hqx
    exact congrArg (fun f => f.hom y) h
  have hres2 : ∀ b : Γ(W, q ⁻¹ᵁ U), ∃ a a' : Γ(Z, U), a' ≠ 0 ∧
      b * (q.app U).hom a' - (q.app U).hom a ∈ (hV.primeIdealOf ⟨x, hx⟩).asIdeal := by
    intro b
    obtain ⟨c, hc⟩ := hres ((W.evaluation (q ⁻¹ᵁ U) x hx).hom b)
    obtain ⟨s, hs⟩ := Z.residue_surjective (q x) c
    letI := TopCat.Presheaf.algebra_section_stalk Z.presheaf (⟨q x, hqx⟩ : U)
    have hloc := hU.isLocalization_stalk ⟨q x, hqx⟩
    obtain ⟨⟨a, a'⟩, hsa⟩ := IsLocalization.surj (S := Z.presheaf.stalk ((⟨q x, hqx⟩ : U) : Z))
      (hU.primeIdealOf ⟨q x, hqx⟩).asIdeal.primeCompl s
    refine ⟨a, a'.1, ?_, ?_⟩
    · intro h0
      have ha' : (a'.1 : Γ(Z, U)) ∉ (hU.primeIdealOf ⟨q x, hqx⟩).asIdeal :=
        (Ideal.mem_primeCompl_iff).mp a'.2
      apply ha'
      rw [h0]
      exact Ideal.zero_mem _
    · rw [TopCat.Presheaf.stalk_open_algebraMap] at hsa
      have hsa2 := congrArg (Z.residue (q x)).hom hsa
      rw [map_mul, hs, hgr, hgr] at hsa2
      have hsa3 := congrArg (q.residueFieldMap x).hom hsa2
      rw [map_mul, hc, hnat, hnat] at hsa3
      have h0 : (W.evaluation (q ⁻¹ᵁ U) x hx).hom
          (b * (q.app U).hom a'.1 - (q.app U).hom a) = 0 := by
        rw [map_sub, map_mul, hsa3, sub_self]
      have hnot := (Scheme.evaluation_eq_zero_iff_notMem_basicOpen W x hx _).mp h0
      by_contra hr
      apply hnot
      have hmem : hV.primeIdealOf ⟨x, hx⟩ ∈
          hV.fromSpec ⁻¹ᵁ W.basicOpen (b * (q.app U).hom a'.1 - (q.app U).hom a) := by
        rw [hV.fromSpec_preimage_basicOpen]
        exact hr
      have h5 := (hV.fromSpec.mem_preimage).mp hmem
      rwa [hxt] at h5

  obtain ⟨T, ⟨hT1, hT2⟩, huniq⟩ := halg Γ(Z, U) Γ(W, q ⁻¹ᵁ U) (q.app U).hom hφ
    (hV.primeIdealOf ⟨x, hx⟩) hcomap hres2 (hU.primeIdealOf ⟨w, hw⟩)

  have hset : q ⁻¹' {w} ∩ closure {x} = {hV.fromSpec T} := by
    ext y
    simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_singleton_iff]
    constructor
    · rintro ⟨hy1, hy2⟩
      have hyV : y ∈ Set.range hV.fromSpec := by
        rw [hV.range_fromSpec]
        exact (q.mem_preimage).mpr (by rw [hy1]; exact hw)
      obtain ⟨T', rfl⟩ := hyV
      have hsp : x ⤳ hV.fromSpec T' := specializes_iff_mem_closure.mpr hy2
      rw [← hxt] at hsp
      have h3 := hVemb.isInducing.specializes_iff.mp hsp
      have h3' : hV.primeIdealOf ⟨x, hx⟩ ≤ T' := (PrimeSpectrum.le_iff_specializes _ _).mpr h3
      have h4 : PrimeSpectrum.comap (q.app U).hom T' = hU.primeIdealOf ⟨w, hw⟩ := by
        apply hUemb.injective
        rw [hsq T', hy1, hU.fromSpec_primeIdealOf]
      exact congrArg hV.fromSpec (huniq T' ⟨h3', congrArg PrimeSpectrum.asIdeal h4⟩)
    · rintro rfl
      refine ⟨?_, ?_⟩
      · rw [← hsq T]
        have e : PrimeSpectrum.comap (q.app U).hom T = hU.primeIdealOf ⟨w, hw⟩ :=
          PrimeSpectrum.ext (by rw [PrimeSpectrum.comap_asIdeal]; exact hT2)
        rw [e, hU.fromSpec_primeIdealOf]
      · rw [← hxt]
        apply specializes_iff_mem_closure.mp
        exact ((PrimeSpectrum.le_iff_specializes _ _).mp hT1).map hV.fromSpec.continuous
  rw [hset, Set.ncard_singleton]

theorem wcpa_dj_fcs_reduced_closed_subscheme : ∀ (X : Scheme.{u}) (T : Set ↥X), IsClosed T → ∃ (Z : Scheme.{u}) (ι : Z ⟶ X), IsClosedImmersion ι ∧ IsReduced Z ∧ Set.range ι = T :=
by
  intro X T hT
  let Tc : TopologicalSpace.Closeds X := ⟨T, hT⟩
  let I := Scheme.IdealSheafData.vanishingIdeal Tc
  have hsec : ∀ U : X.affineOpens, _root_.IsReduced Γ(I.subscheme, I.subschemeι ⁻¹ᵁ (U : X.Opens)) := by
    intro U
    have h : (I.ideal U).IsRadical := by
      rw [Scheme.IdealSheafData.vanishingIdeal_ideal]
      exact PrimeSpectrum.isRadical_vanishingIdeal _
    have := (Ideal.isRadical_iff_quotient_reduced (I.ideal U)).mp h
    exact isReduced_of_injective (I.subschemeObjIso U).commRingCatIsoToRingEquiv.toRingHom
      (I.subschemeObjIso U).commRingCatIsoToRingEquiv.injective
  have hcov : ∀ (Y : Scheme.{u}) {κ : Type u} (U : κ → Y.Opens), iSup U = ⊤ →
      (∀ i, IsAffineOpen (U i)) → (∀ i, _root_.IsReduced Γ(Y, U i)) → IsReduced Y := by
    intro Y κ U hU haff hred
    let 𝒰 := Y.openCoverOfIsOpenCover U (TopologicalSpace.IsOpenCover.mk hU)
    have : ∀ i, IsReduced (𝒰.X i) := by
      intro i
      have : IsAffine (U i) := haff i
      have := hred i
      have : _root_.IsReduced Γ((U i : Scheme), ⊤) :=
        isReduced_of_injective (U i).topIso.commRingCatIsoToRingEquiv.toRingHom
          (U i).topIso.commRingCatIsoToRingEquiv.injective
      exact isReduced_of_isAffine_isReduced (U i : Scheme)
    exact IsReduced.of_openCover Y 𝒰
  refine ⟨I.subscheme, I.subschemeι, inferInstance, ?_, ?_⟩
  · refine hcov I.subscheme (fun i : X.affineOpens => I.subschemeι ⁻¹ᵁ (i : X.Opens)) ?_ ?_ hsec
    · rw [← Scheme.Hom.preimage_iSup, iSup_affineOpens_eq_top, Scheme.Hom.preimage_top]
    · intro i
      exact i.2.preimage I.subschemeι
  · exact (Scheme.IdealSheafData.range_subschemeι I).trans
      (Scheme.IdealSheafData.coe_support_vanishingIdeal Tc)

theorem wcpa_dj_fcs_section_residue_trivial : ∀ {T P Y Z : Scheme.{u}} (s : T ⟶ P) (p : P ⟶ Y) (h : T ⟶ Y) (ι : Z ⟶ Y), SurjectiveOnStalks h → IsClosedImmersion ι → s ≫ p = h → ∀ (e : ↥T) (ζ : ↥Z), ι ζ = h e → ∃ x : ↥(Limits.pullback p ι), Limits.pullback.snd p ι x = ζ ∧ Function.Surjective (Scheme.Hom.residueFieldMap (Limits.pullback.snd p ι) x).hom :=
by
  intro T P Y Z s p h ι hSOS hι hsp e ζ hζ
  subst hsp

  have s1 : ∀ {X W : Scheme.{u}} (f : X ⟶ W) [SurjectiveOnStalks f] (x : X),
      Function.Surjective (Scheme.Hom.residueFieldMap f x).hom := by
    intro X W f _ x
    have e1 := Scheme.residue_residueFieldMap f x
    have e2 := congrArg (fun g => ⇑(CommRingCat.Hom.hom g)) e1
    simp only [CommRingCat.hom_comp, RingHom.coe_comp] at e2
    have hR : Function.Surjective
        (⇑(X.residue x).hom ∘ ⇑(Scheme.Hom.stalkMap f x).hom) :=
      (Scheme.residue_surjective X x).comp (f.stalkMap_surjective x)
    rw [← e2] at hR
    exact Function.Surjective.of_comp hR
  have comp_fun : ∀ {X W V : Scheme.{u}} (f : X ⟶ W) (g : W ⟶ V) (x : X),
      ⇑(Scheme.Hom.residueFieldMap (f ≫ g) x).hom =
        ⇑(Scheme.Hom.residueFieldMap f x).hom ∘ ⇑(Scheme.Hom.residueFieldMap g (f x)).hom := by
    intro X W V f g x
    rw [Scheme.residueFieldMap_comp]
    rfl

  have hp : ∀ t : P, t = s e → Function.Surjective (Scheme.Hom.residueFieldMap p t).hom := by
    rintro t rfl
    have H := s1 (s ≫ p) e
    rw [comp_fun] at H
    intro y
    obtain ⟨a, ha⟩ := H ((Scheme.Hom.residueFieldMap s e).hom y)
    exact ⟨a, (Scheme.Hom.residueFieldMap s e).hom.injective ha⟩

  obtain ⟨x, hx1, hx2⟩ := Scheme.Pullback.exists_preimage_pullback (f := p) (g := ι) (s e) ζ hζ.symm
  refine ⟨x, hx2, ?_⟩

  have h5 : Function.Surjective
      (Scheme.Hom.residueFieldMap (Limits.pullback.fst p ι ≫ p) x).hom := by
    rw [comp_fun]
    exact (s1 (Limits.pullback.fst p ι) x).comp (hp _ hx1)

  have key : ∀ f g : Limits.pullback p ι ⟶ Y, f = g →
      Function.Surjective (Scheme.Hom.residueFieldMap f x).hom →
      Function.Surjective (Scheme.Hom.residueFieldMap g x).hom := by
    rintro f g rfl H; exact H
  have h6 := key _ _ Limits.pullback.condition h5
  rw [comp_fun] at h6
  exact Function.Surjective.of_comp h6

theorem wcpa_dj_lus_cvs_ct_fc_fet_closure_section : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : ValuationSubring K), IsAlgClosed (IsLocalRing.ResidueField ↥R) → ∀ (Y : Scheme.{u}) (v : Y ⟶ Spec (.of ↥R)), wcpaDjSemistable v →
