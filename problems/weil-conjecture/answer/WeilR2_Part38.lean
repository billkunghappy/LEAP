  have hZmem : ∀ z : C, IsClosed ({z} : Set C) → z ∈ Z → z ∈ Zc := by
    intro z hz hzZ
    rw [hZc]
    exact Finset.mem_filter.mpr ⟨hZfin.mem_toFinset.mpr hzZ, hz⟩
  have hPcl1 : ∀ x : C, IsClosed ({x} : Set C) → ∀ p ∈ insert x Zc, IsClosed ({p} : Set C) := by
    intro x hx p hp
    rcases Finset.mem_insert.mp hp with h | h
    · rw [h]; exact hx
    · exact hZcl p h

  have hπ : ∀ β : (Σ ξ : C, ValuationSubring (C.residueField ξ)), ∃ π : C.residueField β.1,
