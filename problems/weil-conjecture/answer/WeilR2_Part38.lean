  set c1 := b1 (IsLocalRing.closedPoint Ω) with hc1
  set c2 := b2 (IsLocalRing.closedPoint Ω) with hc2
  set c3 := b3 (IsLocalRing.closedPoint Ω) with hc3
  set φ := wcLr1uConst (wcProjKStr Ω 1) with hφ
  set t : (wcProjK Ω 1).functionField :=
    ((wcProjK Ω 1).presheaf.germ (wcSgD Ω 1 0) (genericPoint (wcProjK Ω 1)) hη).hom
      (wcSgE Ω 1 0 1) with ht
  obtain ⟨hinj1, κ1, hκ1⟩ := stalk_facts (wcProjK Ω 1) (wcProjKStr Ω 1) c1
  obtain ⟨hinj2, κ2, hκ2⟩ := stalk_facts (wcProjK Ω 1) (wcProjKStr Ω 1) c2
  obtain ⟨hinj3, κ3, hκ3⟩ := stalk_facts (wcProjK Ω 1) (wcProjKStr Ω 1) c3
  have hV1 := wcpa_dj_lr1u_tv_chart_values Ω hη t ht b1 hb1
  have hV2 := wcpa_dj_lr1u_tv_chart_values Ω hη t ht b2 hb2
  have hV3 := wcpa_dj_lr1u_tv_chart_values Ω hη t ht b3 hb3
  obtain ⟨hfin, hinf⟩ := wcpa_dj_lr1u_tv_chart_inj Ω hη t ht
  obtain ⟨g, α, β, γ, δ, hg1, hg2, hg3, hdet, hrel⟩ := wcpa_dj_lr1u_tv_mob_construct Ω
    (wcProjK Ω 1).functionField φ t _ _ _ _ _ _ κ1 κ2 κ3 hinj1 hinj2 hinj3 hκ1 hκ2 hκ3
    hV1 hV2 hV3
    (fun a h1 h2 => h12 (hfin c1 c2 a h1 h2)) (fun a h1 h2 => h13 (hfin c1 c3 a h1 h2))
    (fun a h1 h2 => h23 (hfin c2 c3 a h1 h2)) (fun h1 h2 => h12 (hinf c1 c2 h1 h2))
    (fun h1 h2 => h13 (hinf c1 c3 h1 h2)) (fun h1 h2 => h23 (hinf c2 c3 h1 h2))
  have hgen := wcpa_dj_lr1u_tv_gen_transfer Ω (wcProjK Ω 1).functionField φ t g α β γ δ hdet hrel
