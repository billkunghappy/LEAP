  · intro T hT p y hy
    obtain ⟨t, ht⟩ := hT
    obtain ⟨A, _, _, π, hπs, hπb⟩ :=
      wc_cover_presheaf_coind K ℓ m S hS Uo hUo q' Γ α hG hα T t ht
    let act : MonoidAlgebra ℤ_[ℓ] Γ →
        ((wcCcPre (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ).obj
          (Opposite.op T) →+
        (wcCcPre (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ).obj
