      FreeAbelianGroup.map_of_apply
        (f := fun g : ULift.{u+1} (V ⟶ V) => (ULift.up (g.down ≫ f) : ULift.{u+1} (V ⟶ V'))) _
    have e2 : ((yoneda.obj V' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map f.op).hom
          (FreeAbelianGroup.of (ULift.up (𝟙 V'))) =
        (FreeAbelianGroup.of (ULift.up (f ≫ 𝟙 V')) : FreeAbelianGroup (ULift.{u+1} (V ⟶ V'))) :=
      FreeAbelianGroup.map_of_apply
        (f := fun g : ULift.{u+1} (V' ⟶ V') => (ULift.up (f ≫ g.down) : ULift.{u+1} (V ⟶ V'))) _
