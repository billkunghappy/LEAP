        Functor.whiskerLeft (wcSliceFunctor S U).op
          (toSheafify (Scheme.ProEt.topology S)
            (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))
      (Opposite.op (Scheme.ProEt.mk (𝟙 U.left)))
      (FreeAbelianGroup.of (ULift.up (𝟙 (Scheme.ProEt.mk (𝟙 U.left)))))
    have hb : ((yonedaEquiv (F := (wcSliceFunctor S U).op ⋙ yoneda.obj U)).symm
        (wcLpscBetaTop S U)).app (Opposite.op (Scheme.ProEt.mk (𝟙 U.left)))
          (𝟙 (Scheme.ProEt.mk (𝟙 U.left))) = wcLpscBetaTop S U ≫ 𝟙 U := by
      have hb0 : ((yonedaEquiv (F := (wcSliceFunctor S U).op ⋙ yoneda.obj U)).symm
          (wcLpscBetaTop S U)).app (Opposite.op (Scheme.ProEt.mk (𝟙 U.left)))
            (𝟙 (Scheme.ProEt.mk (𝟙 U.left))) =
          (wcSliceFunctor S U).map (𝟙 (Scheme.ProEt.mk (𝟙 U.left))) ≫ wcLpscBetaTop S U := by
        first
          | rfl
          | exact yonedaEquiv_symm_app_apply _ _ _
          | (erw [yonedaEquiv_symm_app_apply]; rfl)
      rw [hb0]
      first
        | rw [CategoryTheory.Functor.map_id, Category.id_comp, Category.comp_id]
        | simp only [CategoryTheory.Functor.map_id, Category.id_comp, Category.comp_id]
        | (apply MorphismProperty.Over.Hom.ext; rfl)
        | rfl
        | simp
    have hn1 := NatTrans.naturality_apply (toSheafify (Scheme.ProEt.topology S)
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) (wcLpscBetaTop S U).op
          (FreeAbelianGroup.of (ULift.up (𝟙 U)))
    have hn2 := NatTrans.naturality_apply f.hom (wcLpscBetaTop S U).op
      ((toSheafify (Scheme.ProEt.topology S)
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
          (Opposite.op U) (FreeAbelianGroup.of (ULift.up (𝟙 U))))
    refine Eq.trans (congrArg (fun x => f.hom.app
      (Opposite.op ((wcSliceFunctor S U).obj (Scheme.ProEt.mk (𝟙 U.left)))) x) e2) ?_
    refine Eq.trans ?_ hn2
    refine congrArg (fun x => f.hom.app
      (Opposite.op ((wcSliceFunctor S U).obj (Scheme.ProEt.mk (𝟙 U.left)))) x) ?_
    refine Eq.trans ?_ hn1
    show (toSheafify (Scheme.ProEt.topology S)
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
        (Opposite.op ((wcSliceFunctor S U).obj (Scheme.ProEt.mk (𝟙 U.left))))
        (FreeAbelianGroup.of (ULift.up (((yonedaEquiv
          (F := (wcSliceFunctor S U).op ⋙ yoneda.obj U)).symm
          (wcLpscBetaTop S U)).app (Opposite.op (Scheme.ProEt.mk (𝟙 U.left)))
            (𝟙 (Scheme.ProEt.mk (𝟙 U.left)))))) = _
    rw [hb]
    rfl
  have hΦ : ∀ Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      Function.Bijective (fun f : wcFreeSheaf S U ⟶ Y =>
        wcLpscGen S U (Scheme.ProEt.mk (𝟙 U.left)) U (wcLpscBetaTop S U) ≫
          (wcLpscG S U).map f) := by
    intro Y
    have h1 := hev (Scheme.ProEt.topology U.left) (Scheme.ProEt.mk (𝟙 U.left))
      ((wcLpscG S U).obj Y)
    have h2 := hev (Scheme.ProEt.topology S) U Y
    have h3 : Function.Bijective (fun x : Y.obj.obj (Opposite.op U) =>
        Y.obj.map (wcLpscBetaTop S U).op x) :=
      ConcreteCategory.bijective_of_isIso (Y.obj.map (wcLpscBetaTop S U).op)
    refine ⟨fun f₁ f₂ hf => h2.1 (h3.1 ?_), fun g => ?_⟩
    · have := congrArg (fun φ : wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)) ⟶
          (wcLpscG S U).obj Y => φ.hom.app (Opposite.op (Scheme.ProEt.mk (𝟙 U.left)))
        ((toSheafify (Scheme.ProEt.topology U.left)
          (yoneda.obj (Scheme.ProEt.mk (𝟙 U.left)) ⋙ uliftFunctor.{u+1, u} ⋙
            AddCommGrpCat.free)).app
          (Opposite.op (Scheme.ProEt.mk (𝟙 U.left)))
          (FreeAbelianGroup.of (ULift.up (𝟙 (Scheme.ProEt.mk (𝟙 U.left))))))) hf
      exact (hclaim Y f₁).symm.trans (this.trans (hclaim Y f₂))
    · obtain ⟨y, hy⟩ := h3.2 (g.hom.app (Opposite.op (Scheme.ProEt.mk (𝟙 U.left)))
        ((toSheafify (Scheme.ProEt.topology U.left)
          (yoneda.obj (Scheme.ProEt.mk (𝟙 U.left)) ⋙ uliftFunctor.{u+1, u} ⋙
            AddCommGrpCat.free)).app
          (Opposite.op (Scheme.ProEt.mk (𝟙 U.left)))
          (FreeAbelianGroup.of (ULift.up (𝟙 (Scheme.ProEt.mk (𝟙 U.left)))))))
      obtain ⟨f, hf⟩ := h2.2 y
      refine ⟨f, h1.1 ?_⟩
      exact (hclaim Y f).trans
        ((congrArg (fun x => Y.obj.map (wcLpscBetaTop S U).op x) hf).trans hy)
  obtain ⟨θ, hθ⟩ : ∃ θ : L.obj (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left))) ⟶
      wcFreeSheaf S U,
      adj.homEquiv _ _ θ = wcLpscGen S U (Scheme.ProEt.mk (𝟙 U.left)) U (wcLpscBetaTop S U) :=
    ⟨_, (adj.homEquiv _ _).apply_symm_apply _⟩
  have hbij : ∀ T, Function.Bijective (fun f : wcFreeSheaf S U ⟶ T => θ ≫ f) := by
    intro T
    have e : (fun f : wcFreeSheaf S U ⟶ T => θ ≫ f) =
        (adj.homEquiv _ T).symm ∘ (fun f : wcFreeSheaf S U ⟶ T =>
          wcLpscGen S U (Scheme.ProEt.mk (𝟙 U.left)) U (wcLpscBetaTop S U) ≫
            (wcLpscG S U).map f) := by
      funext f
      simp only [Function.comp_apply]
      rw [_root_.Equiv.eq_symm_apply, Adjunction.homEquiv_naturality_right, hθ]
    rw [e]
    exact (adj.homEquiv _ T).symm.bijective.comp (hΦ T)
  haveI : IsIso θ := isIso_of_coyoneda_map_bijective θ hbij
  have hψ : Function.Bijective
      (fun y : Abelian.Ext (wcFreeSheaf S U) (wcIntSheaf S ℓ) j =>
        (Abelian.Ext.mk₀ θ).comp y (zero_add j)) := by
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun γ => (Abelian.Ext.mk₀ (inv θ)).comp γ (zero_add j), ?_, ?_⟩
    · intro β
      simp only
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    · intro γ
      simp only
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
  have hfac : (fun y : Abelian.Ext (wcFreeSheaf S U) (wcIntSheaf S ℓ) j =>
      (Abelian.Ext.mk₀ (wcLpscGen S U (Scheme.ProEt.mk (𝟙 U.left)) U (wcLpscBetaTop S U))).comp
        (Abelian.Ext.mapExactFunctor (wcLpscG S U) y) (zero_add j)) =
      adj.extEquiv ∘ (fun y : Abelian.Ext (wcFreeSheaf S U) (wcIntSheaf S ℓ) j =>
        (Abelian.Ext.mk₀ θ).comp y (zero_add j)) := by
    funext y
    simp only [Function.comp_apply]
    rw [Adjunction.extEquiv_apply, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀_assoc,
      ← hθ, Adjunction.homEquiv_unit]
  have hT : Function.Bijective (fun y : Abelian.Ext (wcFreeSheaf S U) (wcIntSheaf S ℓ) j =>
      (Abelian.Ext.mk₀ (wcLpscGen S U (Scheme.ProEt.mk (𝟙 U.left)) U (wcLpscBetaTop S U))).comp
        (Abelian.Ext.mapExactFunctor (wcLpscG S U) y) (zero_add j)) := by
    rw [hfac]
    exact adj.extEquiv.bijective.comp hψ
  have hgen : ∀ {A X Y : Sheaf (Scheme.ProEt.topology U.left) AddCommGrpCat.{u+1}} (e : X ≅ Y)
      (t : Abelian.Ext A Y j),
      (t.comp (Abelian.Ext.mk₀ e.inv) (add_zero j)).comp (Abelian.Ext.mk₀ e.hom) (add_zero j) = t := by
    intro A X Y e t
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero j) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  have hpost : Function.Bijective (fun t : Abelian.Ext
      (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left))) ((wcLpscG S U).obj (wcIntSheaf S ℓ)) j =>
        t.comp (Abelian.Ext.mk₀ lam.hom) (add_zero j)) := by
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun t => t.comp (Abelian.Ext.mk₀ lam.inv) (add_zero j), fun t => ?_, fun t => ?_⟩
    · exact hgen lam.symm t
    · exact hgen lam t
  have hρ : ⇑(wcIzRho S U ℓ j lam) =
      (fun t : Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))
          ((wcLpscG S U).obj (wcIntSheaf S ℓ)) j =>
        t.comp (Abelian.Ext.mk₀ lam.hom) (add_zero j)) ∘
      (fun y : Abelian.Ext (wcFreeSheaf S U) (wcIntSheaf S ℓ) j =>
        (Abelian.Ext.mk₀ (wcLpscGen S U (Scheme.ProEt.mk (𝟙 U.left)) U (wcLpscBetaTop S U))).comp
          (Abelian.Ext.mapExactFunctor (wcLpscG S U) y) (zero_add j)) := by
    funext e
    rfl
  rw [hρ]
  exact hpost.comp hT

theorem wc_iz_rho_trans (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] {U V : S.ProEt} (a : V ⟶ U)
    [WeaklyEtale a.left]
    [(wcSliceFunctor S U).IsContinuous (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)]
    [(wcLpscG S U).Additive] [Limits.PreservesFiniteLimits (wcLpscG S U)]
    [Limits.PreservesFiniteColimits (wcLpscG S U)]
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    [(wcLpscG S V).Additive] [Limits.PreservesFiniteLimits (wcLpscG S V)]
    [Limits.PreservesFiniteColimits (wcLpscG S V)]
    [(wcSliceFunctor U.left (Scheme.ProEt.mk a.left)).IsContinuous
      (Scheme.ProEt.topology (Scheme.ProEt.mk a.left).left) (Scheme.ProEt.topology U.left)]
    [(wcLpscG U.left (Scheme.ProEt.mk a.left)).Additive]
    [Limits.PreservesFiniteLimits (wcLpscG U.left (Scheme.ProEt.mk a.left))]
    [Limits.PreservesFiniteColimits (wcLpscG U.left (Scheme.ProEt.mk a.left))]
    (lamU : (wcLpscG S U).obj (wcIntSheaf S ℓ) ≅ wcIntSheaf U.left ℓ)
    (hlamU : wcIzLamNorm S U ℓ lamU)
    (lamV : (wcLpscG S V).obj (wcIntSheaf S ℓ) ≅ wcIntSheaf V.left ℓ)
    (hlamV : wcIzLamNorm S V ℓ lamV)
    (lam' : (wcLpscG U.left (Scheme.ProEt.mk a.left)).obj (wcIntSheaf U.left ℓ) ≅
      wcIntSheaf (Scheme.ProEt.mk a.left).left ℓ)
    (hlam' : wcIzLamNorm U.left (Scheme.ProEt.mk a.left) ℓ lam')
    (j : ℕ) (e : Abelian.Ext (wcFreeSheaf S U) (wcIntSheaf S ℓ) j) :
    wcIzRho S V ℓ j lamV ((Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp e (zero_add j)) =
      wcIzRho U.left (Scheme.ProEt.mk a.left) ℓ j lam'
        ((Abelian.Ext.mk₀ (wcFreeSheafMap U.left (wcZmToTop U.left (Scheme.ProEt.mk a.left)))).comp
          (wcIzRho S U ℓ j lamU e) (zero_add j)) :=
by
  classical
  let σ : wcSliceFunctor S V ⟶
      wcSliceFunctor U.left (Scheme.ProEt.mk a.left) ⋙ wcSliceFunctor S U :=
    { app := fun W => MorphismProperty.Over.homMk (𝟙 W.left) (by
          change 𝟙 W.left ≫ (W.hom ≫ a.left) ≫ U.hom = W.hom ≫ V.hom
          rw [Category.id_comp, Category.assoc, MorphismProperty.Over.w a]) trivial
      naturality := fun W W' t => by
        apply MorphismProperty.Over.Hom.ext
        change t.left ≫ 𝟙 W'.left = 𝟙 W.left ≫ t.left
        rw [Category.comp_id, Category.id_comp] }
  let ω : wcLpscG S U ⋙ wcLpscG U.left (Scheme.ProEt.mk a.left) ⟶ wcLpscG S V :=
    { app := fun F => ⟨Functor.whiskerRight (NatTrans.op σ) F.obj⟩
      naturality := fun F F' φ => by
        apply Sheaf.hom_ext
        apply NatTrans.ext
        funext W
        first
          | exact (φ.hom.naturality (σ.app W.unop).op).symm
          | exact φ.hom.naturality (σ.app W.unop).op }
  have hB : (wcLpscG U.left (Scheme.ProEt.mk a.left)).map lamU.hom ≫ lam'.hom =
      ω.app (wcIntSheaf S ℓ) ≫ lamV.hom := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext W
    obtain ⟨W⟩ := W
    apply AddCommGrpCat.ext
    intro t
    obtain ⟨f⟩ := t
    apply ULift.ext
    apply ContinuousMap.ext
    intro x
    have h1 := hlam' W ((lamU.hom.hom.app (Opposite.op
      ((wcSliceFunctor U.left (Scheme.ProEt.mk a.left)).obj W))).hom (ULift.up f)).down x
    have h2 := hlamU ((wcSliceFunctor U.left (Scheme.ProEt.mk a.left)).obj W) f x
    have h3 := hlamV W ((wcIntSheaf S ℓ).obj.map (σ.app W).op (ULift.up f)).down x
    exact (h1.trans h2).trans h3.symm
  have hev : ∀ {C : Type (u+1)} [Category.{u} C] (J' : GrothendieckTopology C)
      [HasWeakSheafify J' AddCommGrpCat.{u+1}] (W : C) (Q : Sheaf J' AddCommGrpCat.{u+1}),
      Function.Bijective (fun φ : (presheafToSheaf J' AddCommGrpCat.{u+1}).obj
          (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Q =>
        φ.hom.app (Opposite.op W)
          ((toSheafify J' (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op W) (FreeAbelianGroup.of (ULift.up (𝟙 W))))) := by
    intro C _ J' _ W Q
    let e := ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ Q).trans
      (((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj).homEquiv
        (yoneda.obj W ⋙ uliftFunctor.{u+1, u}) _).trans uliftYonedaEquiv)
    have h : (fun φ : (presheafToSheaf J' AddCommGrpCat.{u+1}).obj
          (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Q =>
        φ.hom.app (Opposite.op W)
          ((toSheafify J' (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op W) (FreeAbelianGroup.of (ULift.up (𝟙 W))))) = ⇑e := by
      funext φ
      simp only [e, Equiv.trans_apply]
      rw [Adjunction.homEquiv_unit, sheafificationAdjunction_unit_app]
      rfl
    rw [h]
    exact e.bijective
  have hkey : ∀ {C : Type (u+1)} [Category.{u} C] (J' : GrothendieckTopology C)
      [HasWeakSheafify J' AddCommGrpCat.{u+1}] (P : Cᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (Q : Sheaf J' AddCommGrpCat.{u+1}) (γ : P ⟶ Q.obj) (U : Cᵒᵖ) (s : P.obj U),
      (((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv P Q).symm γ).hom.app U
        ((toSheafify J' P).app U s) = γ.app U s := by
    intro C _ J' _ P Q γ U s
    have h := (sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv_unit P Q
      (((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv P Q).symm γ)
    rw [Equiv.apply_symm_apply, sheafificationAdjunction_unit_app] at h
    exact (congrArg (fun φ : P ⟶ Q.obj => φ.app U s) h).symm
  let tS : ∀ (T : Scheme.{u}) (Z X : T.ProEt), (X ⟶ Z) →
      ((wcFreeSheaf T Z).obj.obj (Opposite.op X) : Type (u+1)) := fun T Z X m =>
    (toSheafify (Scheme.ProEt.topology T)
      (yoneda.obj Z ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op X)
      (FreeAbelianGroup.of (ULift.up m))
  have hE : ∀ (T : Scheme.{u}) (Y : T.ProEt)
      [(wcSliceFunctor T Y).IsContinuous (Scheme.ProEt.topology Y.left) (Scheme.ProEt.topology T)]
      (W : Y.left.ProEt) (Z : T.ProEt) (β : (wcSliceFunctor T Y).obj W ⟶ Z),
      (wcLpscGen T Y W Z β).hom.app (Opposite.op W) (tS Y.left W W (𝟙 W)) =
        tS T Z ((wcSliceFunctor T Y).obj W) β := by
    intro T Y _ W Z β
    have e2 := hkey (Scheme.ProEt.topology Y.left)
      (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
      ((wcLpscG T Y).obj (wcFreeSheaf T Z))
      (Functor.whiskerRight ((yonedaEquiv (F := (wcSliceFunctor T Y).op ⋙ yoneda.obj Z)).symm β)
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerLeft (wcSliceFunctor T Y).op
          (toSheafify (Scheme.ProEt.topology T)
            (yoneda.obj Z ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))
      (Opposite.op W) (FreeAbelianGroup.of (ULift.up (𝟙 W)))
    refine e2.trans ?_
    have hb : ((yonedaEquiv (F := (wcSliceFunctor T Y).op ⋙ yoneda.obj Z)).symm β).app
        (Opposite.op W) (𝟙 W) = β := by
      have hb0 : ((yonedaEquiv (F := (wcSliceFunctor T Y).op ⋙ yoneda.obj Z)).symm β).app
          (Opposite.op W) (𝟙 W) = (wcSliceFunctor T Y).map (𝟙 W) ≫ β := by
        first
          | rfl
          | exact yonedaEquiv_symm_app_apply _ _ _
          | (erw [yonedaEquiv_symm_app_apply]; rfl)
      rw [hb0, CategoryTheory.Functor.map_id, Category.id_comp]
    show (toSheafify (Scheme.ProEt.topology T)
        (yoneda.obj Z ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
        (Opposite.op ((wcSliceFunctor T Y).obj W))
        (FreeAbelianGroup.of (ULift.up (((yonedaEquiv
          (F := (wcSliceFunctor T Y).op ⋙ yoneda.obj Z)).symm β).app (Opposite.op W) (𝟙 W)))) = _
    rw [hb]
  have hF : ∀ (T : Scheme.{u}) {Z Z' : T.ProEt} (f : Z ⟶ Z') (X : T.ProEt) (m : X ⟶ Z),
      (wcFreeSheafMap T f).hom.app (Opposite.op X) (tS T Z X m) = tS T Z' X (m ≫ f) := by
    intro T Z Z' f X m
    have h := congrArg (fun φ : (yoneda.obj Z ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
        sheafify (Scheme.ProEt.topology T)
          (yoneda.obj Z' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =>
        φ.app (Opposite.op X)
          (FreeAbelianGroup.of (ULift.up m) : FreeAbelianGroup (ULift.{u+1} (X ⟶ Z))))
      (toSheafify_naturality (Scheme.ProEt.topology T)
        (Functor.whiskerRight (yoneda.map f) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))
    exact h.symm
  have hR' : ∀ (T : Scheme.{u}) (Z X Y : T.ProEt) (k : Y ⟶ X) (m : X ⟶ Z),
      (wcFreeSheaf T Z).obj.map k.op (tS T Z X m) = tS T Z Y (k ≫ m) := by
    intro T Z X Y k m
    exact (NatTrans.naturality_apply (toSheafify (Scheme.ProEt.topology T)
      (yoneda.obj Z ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) k.op
      (FreeAbelianGroup.of (ULift.up m) : FreeAbelianGroup (ULift.{u+1} (X ⟶ Z)))).symm
  have hR0 : ∀ (T : Scheme.{u}) (Z X : T.ProEt) (m : X ⟶ Z),
      tS T Z X m = (wcFreeSheaf T Z).obj.map m.op (tS T Z Z (𝟙 Z)) := by
    intro T Z X m
    rw [hR' T Z Z X m (𝟙 Z), Category.comp_id]
  have heq : σ.app (Scheme.ProEt.mk (𝟙 V.left)) ≫
      (wcSliceFunctor S U).map (wcLpscBetaTop U.left (Scheme.ProEt.mk a.left) ≫
        wcZmToTop U.left (Scheme.ProEt.mk a.left)) ≫ wcLpscBetaTop S U =
      wcLpscBetaTop S V ≫ a := by
    apply MorphismProperty.Over.Hom.ext
    change 𝟙 _ ≫ ((𝟙 _ ≫ a.left) ≫ 𝟙 _) = 𝟙 _ ≫ a.left
    simp only [Category.id_comp, Category.comp_id]
  have hA : wcLpscGen U.left (Scheme.ProEt.mk a.left)
        (Scheme.ProEt.mk (𝟙 (Scheme.ProEt.mk a.left).left)) (Scheme.ProEt.mk a.left)
        (wcLpscBetaTop U.left (Scheme.ProEt.mk a.left)) ≫
      (wcLpscG U.left (Scheme.ProEt.mk a.left)).map
        (wcFreeSheafMap U.left (wcZmToTop U.left (Scheme.ProEt.mk a.left))) ≫
      (wcLpscG U.left (Scheme.ProEt.mk a.left)).map
        (wcLpscGen S U (Scheme.ProEt.mk (𝟙 U.left)) U (wcLpscBetaTop S U)) ≫
      ω.app (wcFreeSheaf S U) =
      wcLpscGen S V (Scheme.ProEt.mk (𝟙 V.left)) V (wcLpscBetaTop S V) ≫
        (wcLpscG S V).map (wcFreeSheafMap S a) := by
