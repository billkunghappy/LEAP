        (fun T : (wcP1Over K).left.ProEt =>
          ∀ t, T.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K)))
        (Opposite.op T)) at x y
      have hb : wcExtZeroSub (wcCoverBasePre (q' ≫ Uo.ι) ℓ)
          (fun T : (wcP1Over K).left.ProEt =>
            ∀ t, T.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K)))
          (Opposite.op T) = ⊥ := iSup_neg hT
      have hz : ∀ z : (wcCoverBasePre (q' ≫ Uo.ι) ℓ).obj (Opposite.op T),
          z ∈ wcExtZeroSub (wcCoverBasePre (q' ≫ Uo.ι) ℓ)
            (fun T : (wcP1Over K).left.ProEt =>
