      rw [h3]; group
  refine ⟨Φ ^ (-bb) * v⁻¹ * Φ ^ bb, bb, ?_, ?_⟩
  · have h4 := hconjΓ (-bb) v⁻¹ (Γ.inv_mem hv)
    rwa [neg_neg] at h4
  · intro a b
    have e1 : Φ ^ bb * (Φ ^ (-bb) * v⁻¹ * Φ ^ bb) * (Φ ^ (-(d : ℤ)) * u⁻¹) *
        (Φ ^ bb * (Φ ^ (-bb) * v⁻¹ * Φ ^ bb))⁻¹ =
        ((pH⁻¹ * xH * pH : H) : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) := by
      rw [Subgroup.coe_mul, Subgroup.coe_mul, Subgroup.coe_inv, hpH, hxH]; group
    rw [e1, ← hyH]
    exact hclose _ _ hfin2 a b

theorem wc_vqm_chebotarev (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (φ : W ⟶ W) (hB : wcVQGalFrame D ℓ hP W w r θ φ)
    (Γ : Subgroup (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (Φ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (hΦ : wcVQFrame D ℓ hP W r θ φ (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
    (hΓ : ∀ h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ, h ∈ Γ ↔
      ∃ γ : W ⟶ W, γ ≫ w = w ∧ wcVQFrame D ℓ hP W r θ γ (h : Matrix (Fin r) (Fin r) ℚ_[ℓ])) :
    ∃ e : ℤ, (e = 1 ∨ e = -1) ∧ ∀ (k : ℤ), ∀ h ∈ Γ, ∀ (N t : ℕ), 1 ≤ N →
      ∃ (d : ℕ) (x : (wcP1Over F'').left) (h' c : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (j : ℤ),
        h' ∈ Γ ∧ c ∈ Γ ∧ 1 ≤ d ∧ x ∈ wcP1ClosedPt F'' d ∧
        (∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) ∧ (N : ℤ) ∣ (d : ℤ) - k ∧
        (∀ a b, ‖((Φ ^ j * c * (Φ ^ (e * (d : ℤ)) * h') * (Φ ^ j * c)⁻¹ :
            (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b -
          ((Φ ^ (e * k) * h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
            Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(t : ℤ))) ∧
        (wcPencilLoc D ℓ hP x d = 0 ∨
          wcPencilLoc D ℓ hP x d =
            ((Φ ^ (e * (d : ℤ)) * h' : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
              Matrix (Fin r) (Fin r) ℚ_[ℓ]).charpoly.aroots (AlgebraicClosure ℚ_[ℓ])) :=
by
  classical
  obtain ⟨hθc, _, hconn, _, hcov, hgal, hφw, _, _, _⟩ := id hB
  obtain ⟨z₀⟩ := @ConnectedSpace.toNonempty _ _ hconn

  have hsurj : ∀ v : Fin r → ℚ_[ℓ], ∃ x : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op W),
      ∀ z : W.left, (show C(↥W.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x).down) z = v := by
    intro v
    have key : ∀ y, (θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
        ((θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom y) = y := by
      intro y
      change ((θ.inv ≫ θ.hom).hom.app (Opposite.op (Over.mk (𝟙 W)))).hom y = y
      rw [θ.inv_hom_id]
      rfl
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
      (ULift.up (ContinuousMap.const ↥W.left v)), ?_⟩
    intro z
    erw [key]
    rfl

  choose A hA using fun γ : W ⟶ W =>
    wc_proet_deck_frame_linear (wcP1Over F'').left ℓ (wcPencilVQ D ℓ hP) W hconn r θ γ
  have hex : ∀ γ : W ⟶ W, wcVQFrame D ℓ hP W r θ γ (LinearMap.toMatrix' (A γ)) := by
    intro γ s z
    rw [LinearMap.toMatrix'_mulVec]
    exact hA γ W (𝟙 W) γ (Category.id_comp γ).symm s z
  have hval : ∀ (γ : W ⟶ W) (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]), wcVQFrame D ℓ hP W r θ γ g →
      ∀ v, g.mulVec v = A γ v := by
    intro γ g hg v
    obtain ⟨x, hx⟩ := hsurj v
    have h1 := hg x z₀
    have h2 := hA γ W (𝟙 W) γ (Category.id_comp γ).symm x z₀
    rw [hx] at h1 h2
    exact h1.symm.trans h2
  have huniq : ∀ (γ : W ⟶ W) (g g' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      wcVQFrame D ℓ hP W r θ γ g → wcVQFrame D ℓ hP W r θ γ g' → g = g' := by
    intro γ g g' hg hg'
    apply Matrix.toLin'.injective
    refine LinearMap.ext fun v => ?_
    rw [Matrix.toLin'_apply, Matrix.toLin'_apply, hval γ g hg v, hval γ g' hg' v]
  have hcomp : ∀ (a b : W ⟶ W) (g g' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      wcVQFrame D ℓ hP W r θ a g → wcVQFrame D ℓ hP W r θ b g' →
      wcVQFrame D ℓ hP W r θ (a ≫ b) (g' * g) := by
    intro a b g g' hg hg' s z
    refine (hA b W a (a ≫ b) rfl s z).trans ?_
    rw [← hval b g' hg', hg s z, Matrix.mulVec_mulVec]
  have h1 : wcVQFrame D ℓ hP W r θ (𝟙 W) 1 := fun s z => (Matrix.one_mulVec _).symm
  have hgen : ∀ (σ : W ⟶ W) (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]), wcVQFrame D ℓ hP W r θ σ g →
      ∀ (V : (wcP1Over F'').left.ProEt) (f : V ⟶ W)
        (s : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op V)) (z : V.left),
        (show C(↥V.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (f ≫ σ)))).hom s).down) z =
        g.mulVec ((show C(↥V.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk f))).hom s).down) z) := by
    intro σ g hg V f s z
    rw [hval σ g hg]
    exact hA σ V f (f ≫ σ) rfl s z

  obtain ⟨it, hitdef⟩ : ∃ it : ℕ → (W ⟶ W),
      ∀ d, it d = (fun γ : W ⟶ W => φ ≫ γ)^[d] (𝟙 W) := ⟨_, fun _ => rfl⟩
  have hit0 : it 0 = 𝟙 W := hitdef 0
  have hits : ∀ d, it (d + 1) = φ ≫ it d := by
    intro d
    rw [hitdef, hitdef]
    exact Function.iterate_succ_apply' _ _ _
  have hfrΦ : ∀ d : ℕ, wcVQFrame D ℓ hP W r θ (it d)
      ((Φ ^ d : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) := by
    intro d
    induction d with
    | zero => rw [hit0, pow_zero, Units.val_one]; exact h1
    | succ d ih =>
      rw [hits, pow_succ, Units.val_mul]
      exact hcomp _ _ _ _ hΦ ih

  have hdeck : ∀ δ : W ⟶ W, δ ≫ w = w → ∃ u : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ, u ∈ Γ ∧
      wcVQFrame D ℓ hP W r θ δ (u : Matrix (Fin r) (Fin r) ℚ_[ℓ]) := by
    intro δ hδ
    obtain ⟨δ', hδ', he⟩ := hgal W δ (𝟙 W) hconn (by rw [hδ, Category.id_comp])
    have hc := hcomp δ δ' _ _ (hex δ) (hex δ')
    rw [← he] at hc
    have h1' := huniq _ _ _ hc h1
    have h2' : LinearMap.toMatrix' (A δ) * LinearMap.toMatrix' (A δ') = 1 :=
      mul_eq_one_comm.mp h1'
    exact ⟨⟨_, _, h2', h1'⟩, (hΓ _).mpr ⟨δ, hδ, hex δ⟩, hex δ⟩

  have hlift : ∀ (d : ℕ) (x : (wcP1Over F'').left), (∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) →
      ∀ Nx : wcFrobNbhd F'' x d, ∃ (ι : Nx.V ⟶ W) (δ : W ⟶ W), δ ≫ w = w ∧
        Nx.φ ≫ ι = ι ≫ (it d ≫ δ) := by
    intro d x hxS Nx
    letI := Nx.ringA
    haveI := Nx.hensA
    haveI := Nx.sepA
    obtain ⟨g₀⟩ := wc_P1_strict_local_geomPoint_map F'' hP Nx.V Nx.A Nx.e
    have hz : ∃ z : W.left, w.left z = g₀.left (Nx.e.inv (IsLocalRing.closedPoint Nx.A)) := by
      apply hcov
      intro i
      rw [← Scheme.Hom.comp_apply g₀.left (wcGeomPoint F'' (wcP1Over F'') hP).hom,
        MorphismProperty.Over.w g₀, Nx.hx]
      exact hxS i
    obtain ⟨ι, hι⟩ := wc_P1bar_strict_local_lift F'' hP W w Nx.V g₀ Nx.A Nx.e hz
    obtain ⟨t, ht0, hts⟩ : ∃ t : ℕ → (wcGeomPoint F'' (wcP1Over F'') hP ⟶
        wcGeomPoint F'' (wcP1Over F'') hP), t 0 = 𝟙 _ ∧
        ∀ j, t (j + 1) = wcGeomFrob F'' (wcP1Over F'') hP ≫ t j :=
      ⟨fun j => (fun γ => wcGeomFrob F'' (wcP1Over F'') hP ≫ γ)^[j] (𝟙 _), rfl,
        fun j => Function.iterate_succ_apply' _ _ _⟩
    have hcomm := wc_frobNbhd_geomFrob_iterate_comm F'' hP x d Nx g₀ t ht0 hts
    have hitw : ∀ j, it j ≫ w = w ≫ t j := by
      intro j
      induction j with
      | zero => rw [hit0, ht0, Category.id_comp, Category.comp_id]
      | succ j ih =>
        rw [hits, Category.assoc, ih, ← Category.assoc, hφw, Category.assoc, hts]
    have hV : ConnectedSpace Nx.V.left := by
      rw [connectedSpace_iff_clopen]
      refine ⟨⟨Nx.e.inv (IsLocalRing.closedPoint Nx.A)⟩, fun s hs => ?_⟩
      have hspec : ∀ v : Nx.V.left, v ⤳ Nx.e.inv (IsLocalRing.closedPoint Nx.A) := by
        intro v
        have h1 : Nx.e.hom v ⤳ IsLocalRing.closedPoint Nx.A :=
          IsLocalRing.specializes_closedPoint _
        have h2 := h1.map Nx.e.inv.continuous
        have h3 : Nx.e.inv (Nx.e.hom v) = v := by
          rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]; rfl
        rwa [h3] at h2
      by_cases h0 : Nx.e.inv (IsLocalRing.closedPoint Nx.A) ∈ s
      · right
        exact Set.eq_univ_of_forall fun v => (hspec v).mem_open hs.isOpen h0
      · left
        exact Set.eq_empty_of_forall_notMem fun v hv => h0 ((hspec v).mem_closed hs.isClosed hv)
    have heq : (ι ≫ it d) ≫ w = (Nx.φ ≫ ι) ≫ w := by
      calc (ι ≫ it d) ≫ w = ι ≫ (it d ≫ w) := Category.assoc _ _ _
        _ = ι ≫ (w ≫ t d) := by rw [hitw d]
        _ = (ι ≫ w) ≫ t d := (Category.assoc _ _ _).symm
        _ = g₀ ≫ t d := by rw [hι]
        _ = Nx.φ ≫ g₀ := hcomm.symm
        _ = Nx.φ ≫ (ι ≫ w) := by rw [hι]
        _ = (Nx.φ ≫ ι) ≫ w := (Category.assoc _ _ _).symm
    obtain ⟨δ, hδ, hδe⟩ := hgal Nx.V (ι ≫ it d) (Nx.φ ≫ ι) hV heq
    exact ⟨ι, δ, hδ, by rw [hδe, Category.assoc]⟩

  refine ⟨-1, Or.inr rfl, ?_⟩
  intro k h hh N t hN
  obtain ⟨d, x, hd, hx, hxS, hdiv, H⟩ :=
    wc_vqmc_cheb_density F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ φ hB Γ Φ hΦ hΓ k h hh N t hN
  have key : ∀ Nx : wcFrobNbhd F'' x d, ∃ (ι : Nx.V ⟶ W) (σ : W ⟶ W)
      (u : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ), u ∈ Γ ∧ Nx.φ ≫ ι = ι ≫ σ ∧
      (∀ (V : (wcP1Over F'').left.ProEt) (f : V ⟶ W)
        (s : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op V)) (z : V.left),
        (show C(↥V.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (f ≫ σ)))).hom s).down) z =
        ((u * Φ ^ d : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
          Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec ((show C(↥V.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk f))).hom s).down) z)) ∧
      ∃ (c : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (j : ℤ), c ∈ Γ ∧
        ∀ a b, ‖((Φ ^ j * c * (Φ ^ (-(d : ℤ)) * u⁻¹) * (Φ ^ j * c)⁻¹ :
            (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b -
          ((Φ ^ (-k) * h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
            Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(t : ℤ)) := by
    intro Nx
    obtain ⟨ι, δ, hδ, hσ⟩ := hlift d x hxS Nx
    obtain ⟨u, hu, hfu⟩ := hdeck δ hδ
    have hfr : wcVQFrame D ℓ hP W r θ (it d ≫ δ)
        ((u * Φ ^ d : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) := by
      rw [Units.val_mul]
      exact hcomp _ _ _ _ (hfrΦ d) hfu
    obtain ⟨c, j, hc, happ⟩ := H Nx ι δ u hδ hu (by rw [← hitdef]; exact hfr)
      (by rw [← hitdef]; exact hσ)
    exact ⟨ι, it d ≫ δ, u, hu, hσ, hgen _ _ hfr, c, j, hc, happ⟩
  by_cases hb : Nonempty (wcPencilStalkBasis D ℓ hP x d)
  · obtain ⟨ι, σ, u, hu, hσ, hg, c, j, hc, happ⟩ := key hb.some.N
    refine ⟨d, x, u⁻¹, c, j, Γ.inv_mem hu, hc, hd, hx, hxS, hdiv,
      by simp only [neg_one_mul]; exact happ, Or.inr ?_⟩
    have hloc := wc_vqmc_stalk_dictionary F' F'' Y n D ℓ hP W r θ hθc x d hb.some.N ι σ
      (u * Φ ^ d) hσ hg hb.some.r hb.some.e hb.some.he
    unfold wcPencilLoc
    rw [dif_pos hb, hloc, neg_one_mul, mul_inv_rev, zpow_neg, zpow_natCast]
  · obtain ⟨Nx⟩ := wc_P1_frob_nbhd_exists F'' d hd x hx
    obtain ⟨ι, σ, u, hu, hσ, hg, c, j, hc, happ⟩ := key Nx
    refine ⟨d, x, u⁻¹, c, j, Γ.inv_mem hu, hc, hd, hx, hxS, hdiv,
      by simp only [neg_one_mul]; exact happ, Or.inl ?_⟩
    unfold wcPencilLoc
    rw [dif_neg hb]

theorem wc_vqm_system_to_datum (ℓ : ℕ) [Fact (Nat.Prime ℓ)] {X : Type*}
    (good : ℕ → X → Prop) (loc : X → ℕ → Multiset (AlgebraicClosure ℚ_[ℓ]))
    (r m : ℕ) (J : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (Γ : Subgroup (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (Φ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (μ : ℚ_[ℓ]) (e : ℤ)
    (v₀ : Fin m → Fin r → ℚ_[ℓ]) (ε : Fin m → ℚ_[ℓ])
    (T : Fin m → (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (hJ : J.transpose = -J) (hJdet : IsUnit J.det)
    (hΓint : ∀ h ∈ Γ, ∀ a b, ‖(h : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1)
    (hΦint : ∀ a b, ‖(Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1)
    (hΦint' : ∀ a b,
      ‖((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1)
    (hnorm : ∀ h ∈ Γ, Φ * h * Φ⁻¹ ∈ Γ ∧ Φ⁻¹ * h * Φ ∈ Γ)
    (hΓJ : ∀ h ∈ Γ, (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J *
      (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = J)
    (hμ : μ ≠ 0)
    (hΦJ : (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J *
      (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = μ • J)
    (he : e = 1 ∨ e = -1)
    (hT : ∀ s, v₀ s ≠ 0 ∧ ε s ≠ 0 ∧ T s ∈ Γ ∧
      (T s : Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
        1 + ε s • Matrix.vecMulVec (v₀ s) (Matrix.vecMul (v₀ s) J))
    (hF : ∀ s, ∃ h ∈ Γ, ((Φ * h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
      Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec (v₀ s) ∈ Submodule.span ℚ_[ℓ] {v₀ s})
    (hspan : Submodule.span ℚ_[ℓ]
      {v | ∃ h ∈ Γ, ∃ s, v = (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec (v₀ s)} = ⊤)
    (hgen : ∀ Wsub : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]),
      (∀ h ∈ Γ, ∀ s, ∀ x ∈ Wsub,
        ((h * T s * h⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
          Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec x ∈ Wsub) →
      ∀ h ∈ Γ, ∀ x ∈ Wsub, (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec x ∈ Wsub)
    (hcheb : ∀ (k : ℤ), ∀ h ∈ Γ, ∀ (N t : ℕ), 1 ≤ N →
      ∃ (d : ℕ) (x : X) (h' c : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (j : ℤ),
        h' ∈ Γ ∧ c ∈ Γ ∧ 1 ≤ d ∧ good d x ∧ (N : ℤ) ∣ (d : ℤ) - k ∧
        (∀ a b, ‖((Φ ^ j * c * (Φ ^ (e * (d : ℤ)) * h') * (Φ ^ j * c)⁻¹ :
            (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b -
          ((Φ ^ (e * k) * h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
            Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(t : ℤ))) ∧
        (loc x d = 0 ∨ loc x d = ((Φ ^ (e * (d : ℤ)) * h' : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
          Matrix (Fin r) (Fin r) ℚ_[ℓ]).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]))) :
    ∃ (G : Type) (_ : Group G) (ρ : G →* Matrix (Fin r) (Fin r) ℚ_[ℓ])
      (deg : G →* Multiplicative ℤ) (F₁ : G) (μ' : ℚ_[ℓ]) (τ : Fin m → G) (Fs : Fin m → G),
      (∀ σ a b, ‖ρ σ a b‖ ≤ 1) ∧
      deg F₁ = Multiplicative.ofAdd 1 ∧ μ' ≠ 0 ∧ (ρ F₁).transpose * J * ρ F₁ = μ' • J ∧
      (∀ g : G, ∃ c : ℚ_[ℓ], c ≠ 0 ∧ (ρ g).transpose * J * ρ g = c • J) ∧
      (∀ s, v₀ s ≠ 0 ∧ deg (τ s) = 1 ∧ ε s ≠ 0 ∧
        ρ (τ s) = 1 + ε s • Matrix.vecMulVec (v₀ s) (Matrix.vecMul (v₀ s) J)) ∧
      (∀ s, deg (Fs s) = Multiplicative.ofAdd 1 ∧
        (ρ (Fs s)).mulVec (v₀ s) ∈ Submodule.span ℚ_[ℓ] {v₀ s}) ∧
      Submodule.span ℚ_[ℓ] {v | ∃ (g : G) (s : Fin m), v = (ρ g).mulVec (v₀ s)} = ⊤ ∧
      (∀ Wsub : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]),
        (∀ (h : G) (s : Fin m), ∀ w ∈ Wsub, (ρ (h * τ s * h⁻¹)).mulVec w ∈ Wsub) →
        ∀ g : G, deg g = 1 → ∀ w ∈ Wsub, (ρ g).mulVec w ∈ Wsub) ∧
      ∀ (γ : G) (N t : ℕ), 1 ≤ N → ∃ (d : ℕ) (x : X) (σ c : G),
        1 ≤ d ∧ good d x ∧ (N : ℤ) ∣ (d : ℤ) - Multiplicative.toAdd (deg γ) ∧
        (∀ a b, ‖ρ (c * σ * c⁻¹) a b - ρ γ a b‖ ≤ (ℓ : ℝ) ^ (-(t : ℤ))) ∧
        (loc x d = 0 ∨ loc x d = (ρ σ).charpoly.aroots (AlgebraicClosure ℚ_[ℓ])) :=
by
  classical

  have hnormΦ : Φ ∈ Subgroup.normalizer (Γ : Set (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) := by
    rw [Subgroup.mem_normalizer_iff]
    intro h
    constructor
    · intro hh; exact (hnorm h hh).1
    · intro hh
      have h2 := (hnorm _ hh).2
      have e1 : Φ⁻¹ * (Φ * h * Φ⁻¹) * Φ = h := by group
      rwa [e1] at h2
  have hconj : ∀ (k : ℤ), ∀ h ∈ Γ, Φ ^ k * h * (Φ ^ k)⁻¹ ∈ Γ := by
    intro k h hh
    exact (Subgroup.mem_normalizer_iff.mp (Subgroup.zpow_mem _ hnormΦ k) h).mp hh

  have star : ∀ (g : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (k : ℤ), g = Φ ^ k * (Φ ^ (-k) * g) := by
    intro g k; group

  have intmul : ∀ A B : Matrix (Fin r) (Fin r) ℚ_[ℓ], (∀ a b, ‖A a b‖ ≤ 1) →
      (∀ a b, ‖B a b‖ ≤ 1) → ∀ a b, ‖(A * B) a b‖ ≤ 1 := by
    intro A B hA hB a b
    rw [Matrix.mul_apply]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg zero_le_one
    intro c _
    rw [norm_mul]
    exact mul_le_one₀ (hA a c) (norm_nonneg _) (hB c b)
  have intpow : ∀ k : ℤ, ∀ a b,
      ‖((Φ ^ k : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1 := by
    intro k
    induction k using Int.induction_on with
    | zero =>
      intro a b
      rw [zpow_zero, Units.val_one, Matrix.one_apply]
      split_ifs <;> simp
    | succ i ih =>
      rw [zpow_add_one, Units.val_mul]
      exact intmul _ _ ih hΦint
    | pred i ih =>
      rw [zpow_sub_one, Units.val_mul]
      exact intmul _ _ ih hΦint'
  have intzh : ∀ (k : ℤ), ∀ h ∈ Γ, ∀ a b,
      ‖((Φ ^ k * h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1 := by
    intro k h hh
    rw [Units.val_mul]
    exact intmul _ _ (intpow k) (hΓint h hh)

  have simmul : ∀ (A B : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (a b : ℚ_[ℓ]),
      A.transpose * J * A = a • J → B.transpose * J * B = b • J →
      (A * B).transpose * J * (A * B) = (a * b) • J := by
    intro A B a b hA hB
    calc (A * B).transpose * J * (A * B) = B.transpose * (A.transpose * J * A) * B := by
          rw [Matrix.transpose_mul]; simp only [Matrix.mul_assoc]
      _ = (a * b) • J := by rw [hA, Matrix.mul_smul, Matrix.smul_mul, hB, smul_smul]
  have hinvJ : ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose
      * J * ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = μ⁻¹ • J := by
    have hPQ : (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) *
        ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = 1 :=
      Units.mul_inv Φ
    have hJ' : J = μ⁻¹ • ((Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J *
        (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ])) := by
      rw [hΦJ, smul_smul, inv_mul_cancel₀ hμ, one_smul]
    calc ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose
          * J * ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ])
        = ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose
          * (μ⁻¹ • ((Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J *
            (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ])))
          * ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) := by
          rw [← hJ']
      _ = μ⁻¹ • (((Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) *
            ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ])).transpose
            * J * ((Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) *
            ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]))) := by
          rw [Matrix.mul_smul, Matrix.smul_mul, Matrix.transpose_mul]
          simp only [Matrix.mul_assoc]
      _ = μ⁻¹ • J := by rw [hPQ, Matrix.transpose_one, Matrix.one_mul, Matrix.mul_one]
  have simpow : ∀ k : ℤ,
      ((Φ ^ k : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J *
        ((Φ ^ k : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = μ ^ k • J := by
    intro k
    induction k using Int.induction_on with
    | zero =>
      rw [zpow_zero, zpow_zero, Units.val_one, Matrix.transpose_one, Matrix.one_mul,
        Matrix.mul_one, one_smul]
    | succ i ih =>
      rw [zpow_add_one₀ hμ, zpow_add_one Φ, Units.val_mul]
      exact simmul _ _ _ _ ih hΦJ
    | pred i ih =>
      rw [zpow_sub_one₀ hμ, zpow_sub_one Φ, Units.val_mul]
      exact simmul _ _ _ _ ih hinvJ
  have simzh : ∀ (k : ℤ), ∀ h ∈ Γ,
      ((Φ ^ k * h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J *
        ((Φ ^ k * h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
        (μ ^ k * 1) • J := by
    intro k h hh
    rw [Units.val_mul]
    exact simmul _ _ _ _ (simpow k) (by rw [one_smul]; exact hΓJ h hh)

  have inveig : ∀ (u : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (v : Fin r → ℚ_[ℓ]), v ≠ 0 →
      (u : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec v ∈ Submodule.span ℚ_[ℓ] {v} →
      ((u⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec v ∈
        Submodule.span ℚ_[ℓ] {v} := by
    intro u v hv hu
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hu
    have key : ((u⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec
        ((u : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec v) = v := by
      rw [Matrix.mulVec_mulVec, Units.inv_mul, Matrix.one_mulVec]
    have ha0 : a ≠ 0 := by
      rintro rfl
      rw [← ha, zero_smul, Matrix.mulVec_zero] at key
      exact hv key.symm
    rw [← ha, Matrix.mulVec_smul] at key
    refine Submodule.mem_span_singleton.mpr ⟨a⁻¹, ?_⟩
    calc a⁻¹ • v = a⁻¹ • (a • ((u⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
          Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec v) := by rw [key]
      _ = _ := by rw [smul_smul, inv_mul_cancel₀ ha0, one_smul]

  let S : Subgroup ((Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ × Multiplicative ℤ) :=
    { carrier := {p | Φ ^ (-(e * Multiplicative.toAdd p.2)) * p.1 ∈ Γ}
      one_mem' := by
        show Φ ^ (-(e * Multiplicative.toAdd (1 : Multiplicative ℤ))) * 1 ∈ Γ
        rw [toAdd_one, mul_zero, neg_zero, zpow_zero, mul_one]
        exact Γ.one_mem
      mul_mem' := by
        intro p q hp hq
        show Φ ^ (-(e * Multiplicative.toAdd (p.2 * q.2))) * (p.1 * q.1) ∈ Γ
        rw [toAdd_mul]
        have e1 : Φ ^ (-(e * (Multiplicative.toAdd p.2 + Multiplicative.toAdd q.2))) *
            (p.1 * q.1) =
            (Φ ^ (-(e * Multiplicative.toAdd q.2)) *
              (Φ ^ (-(e * Multiplicative.toAdd p.2)) * p.1) *
              (Φ ^ (-(e * Multiplicative.toAdd q.2)))⁻¹) *
            (Φ ^ (-(e * Multiplicative.toAdd q.2)) * q.1) := by group
        rw [e1]
        exact Γ.mul_mem (hconj _ _ hp) hq
      inv_mem' := by
        intro p hp
        show Φ ^ (-(e * Multiplicative.toAdd (p.2⁻¹))) * p.1⁻¹ ∈ Γ
        rw [toAdd_inv]
        have e1 : Φ ^ (-(e * -Multiplicative.toAdd p.2)) * p.1⁻¹ =
            Φ ^ (e * Multiplicative.toAdd p.2) *
              (Φ ^ (-(e * Multiplicative.toAdd p.2)) * p.1)⁻¹ *
              (Φ ^ (e * Multiplicative.toAdd p.2))⁻¹ := by group
        rw [e1]
        exact hconj _ _ (Γ.inv_mem hp) }
  have hSmem : ∀ p : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ × Multiplicative ℤ,
      p ∈ S ↔ Φ ^ (-(e * Multiplicative.toAdd p.2)) * p.1 ∈ Γ := fun p => Iff.rfl
  let ρ : S →* Matrix (Fin r) (Fin r) ℚ_[ℓ] :=
    (Units.coeHom (Matrix (Fin r) (Fin r) ℚ_[ℓ])).comp ((MonoidHom.fst _ _).comp S.subtype)
  let deg : S →* Multiplicative ℤ := (MonoidHom.snd _ _).comp S.subtype

  have hιmem : ∀ h ∈ Γ, ((h, 1) : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ × Multiplicative ℤ) ∈ S := by
    intro h hh
    rw [hSmem]
    show Φ ^ (-(e * Multiplicative.toAdd (1 : Multiplicative ℤ))) * h ∈ Γ
    rw [toAdd_one, mul_zero, neg_zero, zpow_zero, one_mul]
    exact hh
  have hF₁mem : ((Φ ^ e, Multiplicative.ofAdd 1) :
      (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ × Multiplicative ℤ) ∈ S := by
    rw [hSmem]
    show Φ ^ (-(e * Multiplicative.toAdd (Multiplicative.ofAdd (1 : ℤ)))) * Φ ^ e ∈ Γ
    rw [toAdd_ofAdd, mul_one, ← zpow_add, neg_add_cancel, zpow_zero]
    exact Γ.one_mem
  choose hs hsΓ hsF using hF
  have hFsmem : ∀ s, (((Φ * hs s) ^ e, Multiplicative.ofAdd 1) :
      (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ × Multiplicative ℤ) ∈ S := by
    intro s
    rw [hSmem]
    show Φ ^ (-(e * Multiplicative.toAdd (Multiplicative.ofAdd (1 : ℤ)))) * (Φ * hs s) ^ e ∈ Γ
    rw [toAdd_ofAdd, mul_one]
    rcases he with h1 | h1
    · rw [h1]
      have e1 : Φ ^ (-(1 : ℤ)) * (Φ * hs s) ^ (1 : ℤ) = hs s := by group
      rw [e1]
      exact hsΓ s
    · rw [h1]
      have e1 : Φ ^ (-(-1 : ℤ)) * (Φ * hs s) ^ (-1 : ℤ) = Φ * (hs s)⁻¹ * Φ⁻¹ := by group
      rw [e1]
      exact (hnorm _ (Γ.inv_mem (hsΓ s))).1
  refine ⟨S, inferInstance, ρ, deg, ⟨_, hF₁mem⟩, μ ^ e, fun s => ⟨_, hιmem _ (hT s).2.2.1⟩,
    fun s => ⟨_, hFsmem s⟩, ?_, rfl, zpow_ne_zero e hμ, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  ·
    rintro ⟨⟨g, n⟩, hσ⟩ a b
    show ‖(g : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1
    rw [star g (e * Multiplicative.toAdd n)]
    exact intzh _ _ hσ a b
  ·
    exact simpow e
  ·
    rintro ⟨⟨u, n⟩, hu⟩
    refine ⟨μ ^ (e * Multiplicative.toAdd n) * 1,
      mul_ne_zero (zpow_ne_zero _ hμ) one_ne_zero, ?_⟩
    show (u : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J * (u : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = _
    rw [star u (e * Multiplicative.toAdd n)]
    exact simzh _ _ hu
  ·
    intro s
    exact ⟨(hT s).1, rfl, (hT s).2.1, (hT s).2.2.2⟩
  ·
    intro s
    refine ⟨rfl, ?_⟩
    show (((Φ * hs s) ^ e : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
      Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec (v₀ s) ∈ Submodule.span ℚ_[ℓ] {v₀ s}
    rcases he with h1 | h1
    · rw [h1, zpow_one]
      exact hsF s
    · rw [h1, zpow_neg_one]
      exact inveig _ _ (hT s).1 (hsF s)
  ·
    rw [eq_top_iff, ← hspan]
    apply Submodule.span_mono
    rintro v ⟨h, hh, s, rfl⟩
    exact ⟨⟨(h, 1), hιmem h hh⟩, s, rfl⟩
  ·
    intro Wsub hyp g hg w hw
    obtain ⟨⟨u, n⟩, hu⟩ := g
    have hn : n = 1 := hg
    subst hn
    have hu' : u ∈ Γ := by
      have h1 := (hSmem _).mp hu
      change Φ ^ (-(e * Multiplicative.toAdd (1 : Multiplicative ℤ))) * u ∈ Γ at h1
      rwa [toAdd_one, mul_zero, neg_zero, zpow_zero, one_mul] at h1
    show (u : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec w ∈ Wsub
    refine hgen Wsub ?_ u hu' w hw
    intro h hh s x hx
    exact hyp ⟨(h, 1), hιmem h hh⟩ s x hx
  ·
    rintro ⟨⟨g, n⟩, hγ⟩ N t hN
    have hγ' : Φ ^ (-(e * Multiplicative.toAdd n)) * g ∈ Γ := hγ
    obtain ⟨d, x, h', c, j, hh', hc, hd, hx, hdiv, happ, hloc⟩ :=
      hcheb (Multiplicative.toAdd n) _ hγ' N t hN
    have hσmem : ((Φ ^ (e * (d : ℤ)) * h', Multiplicative.ofAdd (d : ℤ)) :
        (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ × Multiplicative ℤ) ∈ S := by
      rw [hSmem]
      show Φ ^ (-(e * Multiplicative.toAdd (Multiplicative.ofAdd (d : ℤ)))) *
        (Φ ^ (e * (d : ℤ)) * h') ∈ Γ
      rw [toAdd_ofAdd, ← mul_assoc, ← zpow_add, neg_add_cancel, zpow_zero, one_mul]
      exact hh'
    have hcmem : ((Φ ^ j * c, Multiplicative.ofAdd (e * j)) :
        (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ × Multiplicative ℤ) ∈ S := by
      rw [hSmem]
      show Φ ^ (-(e * Multiplicative.toAdd (Multiplicative.ofAdd (e * j)))) * (Φ ^ j * c) ∈ Γ
      have hee : e * (e * j) = j := by
        rcases he with h1 | h1 <;> rw [h1] <;> ring
      rw [toAdd_ofAdd, hee, ← mul_assoc, ← zpow_add, neg_add_cancel, zpow_zero, one_mul]
      exact hc
    refine ⟨d, x, ⟨_, hσmem⟩, ⟨_, hcmem⟩, hd, hx, hdiv, ?_, hloc⟩
    intro a b
    have h1 := happ a b
    rw [← star g (e * Multiplicative.toAdd n)] at h1
    exact h1

theorem wc_pencil_VQ_raw_monodromy_datum_nm (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n) (hNM : wcPencilNoMixed D)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∃ (r m : ℕ) (J : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (G : Type) (_ : Group G)
      (ρ : G →* Matrix (Fin r) (Fin r) ℚ_[ℓ]) (deg : G →* Multiplicative ℤ) (F₁ : G) (μ : ℚ_[ℓ])
      (v₀ : Fin m → Fin r → ℚ_[ℓ]) (ε : Fin m → ℚ_[ℓ]) (τ : Fin m → G) (Fs : Fin m → G),
      J.transpose = -J ∧ IsUnit J.det ∧ (∀ σ a b, ‖ρ σ a b‖ ≤ 1) ∧
      deg F₁ = Multiplicative.ofAdd 1 ∧ μ ≠ 0 ∧ (ρ F₁).transpose * J * ρ F₁ = μ • J ∧
      (∀ g : G, ∃ c : ℚ_[ℓ], c ≠ 0 ∧ (ρ g).transpose * J * ρ g = c • J) ∧
      (∀ s, v₀ s ≠ 0 ∧ deg (τ s) = 1 ∧ ε s ≠ 0 ∧
        ρ (τ s) = 1 + ε s • Matrix.vecMulVec (v₀ s) (Matrix.vecMul (v₀ s) J)) ∧
      (∀ s, deg (Fs s) = Multiplicative.ofAdd 1 ∧
        (ρ (Fs s)).mulVec (v₀ s) ∈ Submodule.span ℚ_[ℓ] {v₀ s}) ∧
      Submodule.span ℚ_[ℓ] {v | ∃ (g : G) (s : Fin m), v = (ρ g).mulVec (v₀ s)} = ⊤ ∧
      (∀ W : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]),
        (∀ (h : G) (s : Fin m), ∀ w ∈ W, (ρ (h * τ s * h⁻¹)).mulVec w ∈ W) →
        ∀ g : G, deg g = 1 → ∀ w ∈ W, (ρ g).mulVec w ∈ W) ∧
      ∀ (γ : G) (N t : ℕ), 1 ≤ N → ∃ (d : ℕ) (x : (wcP1Over F'').left) (σ c : G),
        1 ≤ d ∧ x ∈ wcP1ClosedPt F'' d ∧ (∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) ∧
        (N : ℤ) ∣ (d : ℤ) - Multiplicative.toAdd (deg γ) ∧
        (∀ a b, ‖ρ (c * σ * c⁻¹) a b - ρ γ a b‖ ≤ (ℓ : ℝ) ^ (-(t : ℤ))) ∧
        (wcPencilLoc D ℓ hP x d = 0 ∨
          wcPencilLoc D ℓ hP x d = (ρ σ).charpoly.aroots (AlgebraicClosure ℚ_[ℓ])) :=
by
  obtain ⟨W, w, r, θ, φ, hB⟩ := wc_vqm_galois_frame_exists F' F'' Y n hn hn2 D ℓ hℓ hP hNI
  obtain ⟨Γ, Φ, hΦ, hΓ, hnorm, hΓint, hΦint, hΦint'⟩ :=
    wc_vqm_frame_group F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ φ hB
  have hhom := wc_pencil_E_hom_const_zero_nm F' F'' Y n hn hn2 D hNM ℓ hℓ hP hNI
  obtain ⟨J, μ, hJ, hJdet, hμ, hΓJ, hΦJ⟩ :=
    wc_vqm_cup_form_hz F' F'' Y n hn hn2 D ℓ hℓ hP hNI hhom W w r θ φ hB Γ Φ hΦ hΓ
  obtain ⟨m, v₀, ε, T, hT, hF, hspan, hgen⟩ :=
    wc_vqm_vanishing_system_hz F' F'' Y n hn hn2 D ℓ hℓ hP hNI hhom W w r θ φ hB Γ Φ hΦ hΓ J hJ
      hJdet hΓJ
  obtain ⟨e, he, hcheb⟩ := wc_vqm_chebotarev F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ φ hB Γ Φ hΦ hΓ
  obtain ⟨G, hG, ρ, deg, F₁, μ', τ, Fs, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10⟩ :=
    wc_vqm_system_to_datum ℓ
      (fun d x => x ∈ wcP1ClosedPt F'' d ∧ ∀ i, x ≠ D.S i (IsLocalRing.closedPoint F''))
      (wcPencilLoc D ℓ hP) r m J Γ Φ μ e v₀ ε T hJ hJdet hΓint hΦint hΦint' hnorm hΓJ hμ hΦJ he
      hT hF hspan hgen
      (fun k h hh N t hN => by
        obtain ⟨d, x, h', c, j, hh', hc, hd, hx, hxS, hdiv, happ, hloc⟩ := hcheb k h hh N t hN
        exact ⟨d, x, h', c, j, hh', hc, hd, ⟨hx, hxS⟩, hdiv, happ, hloc⟩)
  refine ⟨r, m, J, G, hG, ρ, deg, F₁, μ', v₀, ε, τ, Fs, hJ, hJdet, h1, h2, h3, h4, h5, h6, h7,
    h8, h9, ?_⟩
  intro γ N t hN
  obtain ⟨d, x, σ, c, hd, hgood, hdiv, happ, hloc⟩ := h10 γ N t hN
  exact ⟨d, x, σ, c, hd, hgood.1, hgood.2, hdiv, happ, hloc⟩

theorem wc_block_class_stability {K : Type*} [Field K] [CharZero K] (r m : ℕ)
    (J : Matrix (Fin r) (Fin r) K) (hJ : J.transpose = -J) (hJdet : IsUnit J.det)
    {G : Type*} [Group G] (ρ : G →* Matrix (Fin r) (Fin r) K) (deg : G →* Multiplicative ℤ)
    (v₀ : Fin m → Fin r → K) (ε : Fin m → K) (τ Fs : Fin m → G)
    (hsim : ∀ g : G, ∃ c : K, c ≠ 0 ∧ (ρ g).transpose * J * ρ g = c • J)
    (hτ : ∀ s, v₀ s ≠ 0 ∧ deg (τ s) = 1 ∧ ε s ≠ 0 ∧
      ρ (τ s) = 1 + ε s • Matrix.vecMulVec (v₀ s) (Matrix.vecMul (v₀ s) J))
    (hF : ∀ s, deg (Fs s) = Multiplicative.ofAdd 1 ∧
      (ρ (Fs s)).mulVec (v₀ s) ∈ Submodule.span K {v₀ s})
    (hspan : Submodule.span K {v | ∃ (g : G) (s : Fin m), v = (ρ g).mulVec (v₀ s)} = ⊤)
    (hgen : ∀ W : Submodule K (Fin r → K),
      (∀ (h : G) (s : Fin m), ∀ w ∈ W, (ρ (h * τ s * h⁻¹)).mulVec w ∈ W) →
      ∀ g : G, deg g = 1 → ∀ w ∈ W, (ρ g).mulVec w ∈ W) :
    ∀ g : G, ∀ v ∈ {v | ∃ (g : G) (s : Fin m), v = (ρ g).mulVec (v₀ s)},
      Relation.EqvGen (fun u w => u ∈ {v | ∃ (g : G) (s : Fin m), v = (ρ g).mulVec (v₀ s)} ∧
        w ∈ {v | ∃ (g : G) (s : Fin m), v = (ρ g).mulVec (v₀ s)} ∧
        ∑ a, u a * J.mulVec w a ≠ 0) ((ρ g).mulVec v) v :=
by
  classical
  set S : Set (Fin r → K) := {v | ∃ (g : G) (s : Fin m), v = (ρ g).mulVec (v₀ s)} with hSdef
  set R : (Fin r → K) → (Fin r → K) → Prop :=
    fun u w => u ∈ S ∧ w ∈ S ∧ ∑ a, u a * J.mulVec w a ≠ 0 with hRdef

  have hanti : ∀ u w : Fin r → K,
      ∑ a, u a * J.mulVec w a = -(∑ a, w a * J.mulVec u a) := by
    intro u w
    change dotProduct u (J.mulVec w) = -(dotProduct w (J.mulVec u))
    rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, hJ, Matrix.neg_mulVec,
      neg_dotProduct, dotProduct_comm]
  have hdiag : ∀ u : Fin r → K, ∑ a, u a * J.mulVec u a = 0 := by
    intro u
    have h := hanti u u
    have h2 : (2 : K) * (∑ a, u a * J.mulVec u a) = 0 := by linear_combination h
    exact (mul_eq_zero.mp h2).resolve_left two_ne_zero

  have hscale : ∀ (M : Matrix (Fin r) (Fin r) K) (c : K), M.transpose * J * M = c • J →
      ∀ u w : Fin r → K, ∑ a, (M.mulVec u) a * J.mulVec (M.mulVec w) a =
        c * ∑ a, u a * J.mulVec w a := by
    intro M c hM u w
    have hM' : M.transpose * (J * M) = c • J := by rw [← Matrix.mul_assoc]; exact hM
    change dotProduct (M.mulVec u) (J.mulVec (M.mulVec w)) = c * dotProduct u (J.mulVec w)
    rw [← Matrix.vecMul_transpose M u, ← Matrix.dotProduct_mulVec]
    simp only [Matrix.mulVec_mulVec]
    rw [hM', Matrix.smul_mulVec, dotProduct_smul, smul_eq_mul]

  have hnd : ∀ x : Fin r → K, (∀ u ∈ S, ∑ a, x a * J.mulVec u a = 0) → x = 0 := by
    intro x hx
    have hall : ∀ w, dotProduct x (J.mulVec w) = 0 := by
      intro w
      have hw : w ∈ Submodule.span K S := by rw [hspan]; trivial
      induction hw using Submodule.span_induction with
      | mem y hy => exact hx y hy
      | zero => simp
      | add y z _ _ hy hz => rw [Matrix.mulVec_add, dotProduct_add, hy, hz, add_zero]
      | smul c y _ hy => rw [Matrix.mulVec_smul, dotProduct_smul, hy, smul_zero]
    exact (Matrix.nondegenerate_of_det_ne_zero hJdet.ne_zero).eq_zero_of_ortho hall

  have hcomp : ∀ (x y : G) (w : Fin r → K),
      (ρ x).mulVec ((ρ y).mulVec w) = (ρ (x * y)).mulVec w := by
    intro x y w
    rw [Matrix.mulVec_mulVec, map_mul]
  have hSmap : ∀ g : G, ∀ u ∈ S, (ρ g).mulVec u ∈ S := by
    rintro g u ⟨g', s, rfl⟩
    exact ⟨g * g', s, hcomp g g' (v₀ s)⟩
  have hv0S : ∀ s, v₀ s ∈ S := fun s => ⟨1, s, by rw [map_one, Matrix.one_mulVec]⟩
  have h0 : (0 : Fin r → K) ∉ S := by
    rintro ⟨g, s, hg⟩
    apply (hτ s).1
    have := congrArg (fun w => (ρ g⁻¹).mulVec w) hg
    simp only [Matrix.mulVec_zero, hcomp, inv_mul_cancel, map_one, Matrix.one_mulVec] at this
    exact this.symm

  have hmem : ∀ a b, Relation.EqvGen R a b → a = b ∨ (a ∈ S ∧ b ∈ S) := by
    intro a b h
    induction h with
    | rel x y hxy => exact Or.inr ⟨hxy.1, hxy.2.1⟩
    | refl x => exact Or.inl rfl
    | symm x y _ ih =>
      rcases ih with h | h
      · exact Or.inl h.symm
      · exact Or.inr ⟨h.2, h.1⟩
    | trans x y z _ _ ih1 ih2 =>
      rcases ih1 with h1 | h1
      · subst h1; exact ih2
      · rcases ih2 with h2 | h2
        · subst h2; exact Or.inr h1
        · exact Or.inr ⟨h1.1, h2.2⟩
  have hmemS : ∀ v ∈ S, ∀ c, Relation.EqvGen R c v → c ∈ S := by
    intro v hv c hc
    rcases hmem c v hc with h | h
    · rw [h]; exact hv
    · exact h.1

  have hmap : ∀ g : G, ∀ a b, Relation.EqvGen R a b →
      Relation.EqvGen R ((ρ g).mulVec a) ((ρ g).mulVec b) := by
    intro g a b h
    obtain ⟨c, hc, hcJ⟩ := hsim g
    induction h with
    | rel x y hxy =>
      refine Relation.EqvGen.rel _ _ ⟨hSmap g x hxy.1, hSmap g y hxy.2.1, ?_⟩
      rw [hscale _ c hcJ]
      exact mul_ne_zero hc hxy.2.2
    | refl x => exact Relation.EqvGen.refl _
    | symm x y _ ih => exact Relation.EqvGen.symm _ _ ih
    | trans x y z _ _ ih1 ih2 => exact Relation.EqvGen.trans _ _ _ ih1 ih2

  have htrans : ∀ d ∈ S, ∀ (e : K), ∀ v ∈ S,
      (1 + e • Matrix.vecMulVec d (Matrix.vecMul d J)).mulVec v ∈ S →
      Relation.EqvGen R ((1 + e • Matrix.vecMulVec d (Matrix.vecMul d J)).mulVec v) v := by
    intro d hd e v hv hTv
    have hform : (1 + e • Matrix.vecMulVec d (Matrix.vecMul d J)).mulVec v =
        v + (e * ∑ a, d a * J.mulVec v a) • d := by
      have h1 : ∑ a, d a * J.mulVec v a = dotProduct (Matrix.vecMul d J) v :=
        Matrix.dotProduct_mulVec d J v
      rw [h1, Matrix.add_mulVec, Matrix.one_mulVec, Matrix.smul_mulVec]
      ext i
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Matrix.mulVec, Matrix.vecMulVec_apply,
        dotProduct, Finset.mul_sum, Finset.sum_mul]
      congr 1
      exact Finset.sum_congr rfl (fun j _ => by ring)
    by_cases ht : ∑ a, d a * J.mulVec v a = 0
    · rw [hform, ht, mul_zero, zero_smul, add_zero]
      exact Relation.EqvGen.refl _
    · have hR1 : R ((1 + e • Matrix.vecMulVec d (Matrix.vecMul d J)).mulVec v) d := by
        refine ⟨hTv, hd, ?_⟩
        rw [hform]
        change dotProduct (v + (e * ∑ a, d a * J.mulVec v a) • d) (J.mulVec d) ≠ 0
        rw [add_dotProduct, smul_dotProduct, smul_eq_mul]
        change ∑ a, v a * J.mulVec d a + (e * ∑ a, d a * J.mulVec v a) *
          ∑ a, d a * J.mulVec d a ≠ 0
        rw [hdiag d, mul_zero, add_zero, hanti v d]
        exact neg_ne_zero.mpr ht
      have hR2 : R d v := ⟨hd, hv, ht⟩
      exact Relation.EqvGen.trans _ d _ (Relation.EqvGen.rel _ _ hR1)
        (Relation.EqvGen.rel _ _ hR2)

  have hclos : ∀ v ∈ S, ∀ x ∈ S, x ∈ Submodule.span K {u | Relation.EqvGen R u v} →
      Relation.EqvGen R x v := by
    intro v hv x hx hxspan
    by_contra hxv
    apply h0
    have hx0 : x = 0 := by
      apply hnd
      intro u hu
      by_cases huv : Relation.EqvGen R u v
      · by_contra hne
        exact hxv (Relation.EqvGen.trans _ _ _ (Relation.EqvGen.rel _ _ ⟨hx, hu, hne⟩) huv)
      · have hC : ∀ c ∈ {u | Relation.EqvGen R u v}, ∑ a, c a * J.mulVec u a = 0 := by
          intro c hc
          by_contra hne
          have hcS : c ∈ S := hmemS v hv c hc
          exact huv (Relation.EqvGen.trans _ _ _
            (Relation.EqvGen.symm _ _ (Relation.EqvGen.rel _ _ ⟨hcS, hu, hne⟩)) hc)
        have hlin : ∀ y ∈ Submodule.span K {u | Relation.EqvGen R u v},
            ∑ a, y a * J.mulVec u a = 0 := by
          intro y hy
          induction hy using Submodule.span_induction with
          | mem y hy => exact hC y hy
          | zero => simp
          | add y z _ _ hy hz =>
            simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib, hy, hz, add_zero]
          | smul c y _ hy =>
            simp only [Pi.smul_apply, smul_eq_mul, mul_assoc, ← Finset.mul_sum, hy, mul_zero]
        exact hlin x hxspan
    rw [← hx0]
    exact hx

  have hconj : ∀ (h : G) (s : Fin m), ∀ v ∈ S,
      Relation.EqvGen R ((ρ (h * τ s * h⁻¹)).mulVec v) v := by
    intro h s v hv
    have hw : (ρ h⁻¹).mulVec v ∈ S := hSmap _ _ hv
    have e1 : (ρ (h * τ s * h⁻¹)).mulVec v =
        (ρ h).mulVec ((ρ (τ s)).mulVec ((ρ h⁻¹).mulVec v)) := by
      rw [hcomp, hcomp]
    have e2 : (ρ h).mulVec ((ρ h⁻¹).mulVec v) = v := by
      rw [hcomp, mul_inv_cancel, map_one, Matrix.one_mulVec]
    have hT := htrans (v₀ s) (hv0S s) (ε s) _ hw
      (by rw [← (hτ s).2.2.2]; exact hSmap _ _ hw)
    rw [← (hτ s).2.2.2] at hT
    have h3 := hmap h _ _ hT
    rw [e2] at h3
    rw [e1]
    exact h3

  have hdeg1 : ∀ k : G, deg k = 1 → ∀ v ∈ S, Relation.EqvGen R ((ρ k).mulVec v) v := by
    intro k hk v hv
    have hstab : ∀ (h : G) (s : Fin m), ∀ w ∈ Submodule.span K {u | Relation.EqvGen R u v},
        (ρ (h * τ s * h⁻¹)).mulVec w ∈ Submodule.span K {u | Relation.EqvGen R u v} := by
      intro h s w hw
      induction hw using Submodule.span_induction with
      | mem y hy =>
        apply Submodule.subset_span
        exact Relation.EqvGen.trans _ _ _ (hconj h s y (hmemS v hv y hy)) hy
      | zero => rw [Matrix.mulVec_zero]; exact Submodule.zero_mem _
      | add y z _ _ hy hz => rw [Matrix.mulVec_add]; exact Submodule.add_mem _ hy hz
      | smul c y _ hy => rw [Matrix.mulVec_smul]; exact Submodule.smul_mem _ c hy
    have hvW : v ∈ Submodule.span K {u | Relation.EqvGen R u v} :=
      Submodule.subset_span (Relation.EqvGen.refl v)
    exact hclos v hv _ (hSmap k v hv) (hgen _ hstab k hk v hvW)

  have hline : ∀ (s : Fin m) (a : ℤ),
      (ρ (Fs s ^ a)).mulVec (v₀ s) ∈ Submodule.span K {v₀ s} := by
    intro s a
    obtain ⟨lam, hlam⟩ := Submodule.mem_span_singleton.mp (hF s).2
    have hlam0 : lam ≠ 0 := by
      rintro rfl
      apply (hτ s).1
      rw [zero_smul] at hlam
      have := congrArg (fun w => (ρ (Fs s)⁻¹).mulVec w) hlam
      simp only [Matrix.mulVec_zero, hcomp, inv_mul_cancel, map_one, Matrix.one_mulVec] at this
      exact this.symm
    have hinvF : (ρ (Fs s)⁻¹).mulVec (v₀ s) = lam⁻¹ • v₀ s := by
      have h1 := congrArg (fun w => (ρ (Fs s)⁻¹).mulVec w) hlam
      simp only [Matrix.mulVec_smul, hcomp, inv_mul_cancel, map_one, Matrix.one_mulVec] at h1
      calc (ρ (Fs s)⁻¹).mulVec (v₀ s)
          = lam⁻¹ • (lam • (ρ (Fs s)⁻¹).mulVec (v₀ s)) := by
            rw [smul_smul, inv_mul_cancel₀ hlam0, one_smul]
        _ = lam⁻¹ • v₀ s := by rw [h1]
    refine Int.induction_on a ?_ ?_ ?_
    · rw [zpow_zero, map_one, Matrix.one_mulVec]
      exact Submodule.mem_span_singleton_self _
    · intro n ih
      rw [_root_.zpow_add_one, ← hcomp, ← hlam, Matrix.mulVec_smul]
      exact Submodule.smul_mem _ _ ih
    · intro n ih
      rw [_root_.zpow_sub_one, ← hcomp, hinvF, Matrix.mulVec_smul]
      exact Submodule.smul_mem _ _ ih

  have hall : ∀ (g : G) (s : Fin m), Relation.EqvGen R ((ρ g).mulVec (v₀ s)) (v₀ s) := by
    intro g s
    obtain ⟨a, ha⟩ : ∃ a : ℤ, deg g = Multiplicative.ofAdd a := ⟨Multiplicative.toAdd (deg g), rfl⟩
    obtain ⟨k, hgk, hk⟩ : ∃ k : G, g = Fs s ^ a * k ∧ deg k = 1 := by
      refine ⟨Fs s ^ (-a) * g, ?_, ?_⟩
      · rw [_root_.zpow_neg, mul_inv_cancel_left]
      · rw [map_mul, map_zpow, (hF s).1, ha, ← ofAdd_zsmul, ← ofAdd_add]
        simp
    have e1 : (ρ g).mulVec (v₀ s) = (ρ (Fs s ^ a)).mulVec ((ρ k).mulVec (v₀ s)) := by
      rw [hcomp, ← hgk]
    rw [e1]
    have h1 := hmap (Fs s ^ a) _ _ (hdeg1 k hk (v₀ s) (hv0S s))
    have h2 : Relation.EqvGen R ((ρ (Fs s ^ a)).mulVec (v₀ s)) (v₀ s) := by
      apply hclos (v₀ s) (hv0S s) _ (hSmap _ _ (hv0S s))
      refine Submodule.span_mono ?_ (hline s a)
      rw [Set.singleton_subset_iff]
      exact Relation.EqvGen.refl _
    exact Relation.EqvGen.trans _ _ _ h1 h2

  intro g v hv
  obtain ⟨g', s, rfl⟩ := hv
  rw [hcomp]
  exact Relation.EqvGen.trans _ _ _ (hall (g * g') s) (Relation.EqvGen.symm _ _ (hall g' s))

theorem wc_block_family_selection {K : Type*} [Field K] [CharZero K] (r : ℕ)
    (J : Matrix (Fin r) (Fin r) K) (hJ : J.transpose = -J) (hJdet : IsUnit J.det)
    (V : Set (Fin r → K)) (h0 : (0 : Fin r → K) ∉ V) (hspan : Submodule.span K V = ⊤) :
    ∃ (k p : ℕ) (δ : Fin k → Fin r → K) (β : Fin k → Fin p),
      (∀ i, δ i ∈ V) ∧ Submodule.span K (Set.range δ) = ⊤ ∧
      (∀ i j, β i ≠ β j → ∑ a, δ i a * J.mulVec (δ j) a = 0) ∧
      (∀ A : Set (Fin k), (∀ i ∈ A, ∀ j ∉ A, β i = β j → ∑ a, δ i a * J.mulVec (δ j) a = 0) →
        ∀ i j, β i = β j → (i ∈ A ↔ j ∈ A)) ∧
      (∀ i, ∀ v ∈ V,
        Relation.EqvGen (fun u w => u ∈ V ∧ w ∈ V ∧ ∑ a, u a * J.mulVec w a ≠ 0) (δ i) v →
        v ∈ Submodule.span K (δ '' {j | β j = β i})) :=
by
  classical
  obtain ⟨R, hR⟩ : ∃ R : (Fin r → K) → (Fin r → K) → Prop,
      R = fun u w => u ∈ V ∧ w ∈ V ∧ ∑ a, u a * J.mulVec w a ≠ 0 := ⟨_, rfl⟩
  have hRiff : ∀ u w, R u w ↔ u ∈ V ∧ w ∈ V ∧ ∑ a, u a * J.mulVec w a ≠ 0 := by
    intro u w; rw [hR]

  have emono : ∀ (s₁ s₂ : (Fin r → K) → (Fin r → K) → Prop), (∀ a b, s₁ a b → s₂ a b) →
      ∀ x y, Relation.EqvGen s₁ x y → Relation.EqvGen s₂ x y := by
    intro s₁ s₂ h x y hxy
    induction hxy with
    | rel a b hab => exact Relation.EqvGen.rel _ _ (h a b hab)
    | refl a => exact Relation.EqvGen.refl a
    | symm a b _ ih => exact Relation.EqvGen.symm _ _ ih
    | trans a b c _ _ ih1 ih2 => exact Relation.EqvGen.trans _ _ _ ih1 ih2

  have hlin1 : ∀ (S : Set (Fin r → K)) (u : Fin r → K), (∀ s ∈ S, ∑ a, s a * J.mulVec u a = 0) →
      ∀ x ∈ Submodule.span K S, ∑ a, x a * J.mulVec u a = 0 := by
    intro S u hS x hx
    induction hx using Submodule.span_induction with
    | mem x hx => exact hS x hx
    | zero => simp
    | add x y _ _ hx hy =>
      simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib, hx, hy, add_zero]
    | smul t x _ hx =>
      simp only [Pi.smul_apply, smul_eq_mul, mul_assoc, ← Finset.mul_sum, hx, mul_zero]
  have hadd1 : ∀ y z u : Fin r → K, ∑ a, (y + z) a * J.mulVec u a =
      ∑ a, y a * J.mulVec u a + ∑ a, z a * J.mulVec u a := by
    intro y z u; simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]

  have hnd : ∀ z : Fin r → K, (∀ u ∈ V, ∑ a, z a * J.mulVec u a = 0) → z = 0 := by
    intro z hz
    have h2 : ∀ u ∈ Submodule.span K V, ∑ a, z a * J.mulVec u a = 0 := by
      intro u hu
      induction hu using Submodule.span_induction with
      | mem x hx => exact hz x hx
      | zero => simp
      | add x y _ _ hx hy =>
        simp only [Matrix.mulVec_add, Pi.add_apply, mul_add, Finset.sum_add_distrib, hx, hy,
          add_zero]
      | smul t x _ hx =>
        simp only [Matrix.mulVec_smul, Pi.smul_apply, smul_eq_mul]
        rw [show ∑ a, z a * (t * J.mulVec x a) = t * ∑ a, z a * J.mulVec x a by
          rw [Finset.mul_sum]; exact Finset.sum_congr rfl (fun a _ => by ring), hx, mul_zero]
    funext b
    have h3 := h2 (J⁻¹.mulVec (Pi.single b 1)) (by rw [hspan]; exact Submodule.mem_top)
    rw [Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv J hJdet, Matrix.one_mulVec] at h3
    have h4 : ∑ a, z a * (Pi.single b (1 : K) : Fin r → K) a = z b := by
      show z ⬝ᵥ Pi.single b 1 = z b
      rw [dotProduct_single, mul_one]
    rw [h4] at h3
    simpa using h3

  have hanti : ∀ u w : Fin r → K, ∑ a, u a * J.mulVec w a = -∑ a, w a * J.mulVec u a := by
    intro u w
    show u ⬝ᵥ J.mulVec w = -(w ⬝ᵥ J.mulVec u)
    rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, hJ, Matrix.neg_mulVec,
      neg_dotProduct, dotProduct_comm]

  have hV : ∀ x y, Relation.EqvGen R x y → (x ∈ V ↔ y ∈ V) := by
    intro x y h
    induction h with
    | rel x y hxy =>
      have := (hRiff x y).mp hxy
      exact ⟨fun _ => this.2.1, fun _ => this.1⟩
    | refl => exact Iff.rfl
    | symm x y _ ih => exact ih.symm
    | trans x y z _ _ ih1 ih2 => exact ih1.trans ih2

  have hcs : ∀ B : Set (Fin r → K), B ⊆ V → Submodule.span K B = ⊤ →
      ∀ v ∈ V, v ∈ Submodule.span K {b | b ∈ B ∧ Relation.EqvGen R b v} := by
    intro B hBV hB v hv
    have hv' : v ∈ Submodule.span K {b | b ∈ B ∧ Relation.EqvGen R b v} ⊔
        Submodule.span K {b | b ∈ B ∧ ¬ Relation.EqvGen R b v} := by
      rw [← Submodule.span_union]
      have hsub : B ⊆ {b | b ∈ B ∧ Relation.EqvGen R b v} ∪
          {b | b ∈ B ∧ ¬ Relation.EqvGen R b v} := by
        intro b hb
        by_cases h : Relation.EqvGen R b v
        · exact Or.inl ⟨hb, h⟩
        · exact Or.inr ⟨hb, h⟩
      have h2 := Submodule.span_mono (R := K) hsub
      rw [hB] at h2
      exact h2 Submodule.mem_top
    obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp hv'
    have hz0 : ∀ u ∈ V, ∑ a, z a * J.mulVec u a = 0 := by
      intro u hu
      by_cases huv : Relation.EqvGen R u v
      · refine hlin1 _ u ?_ z hz
        intro b hb
        by_contra hne
        apply hb.2
        exact Relation.EqvGen.trans _ _ _
          (Relation.EqvGen.rel _ _ ((hRiff b u).mpr ⟨hBV hb.1, hu, hne⟩)) huv
      · have hvu : ∑ a, v a * J.mulVec u a = 0 := by
          by_contra hne
          exact huv (Relation.EqvGen.symm _ _
            (Relation.EqvGen.rel _ _ ((hRiff v u).mpr ⟨hv, hu, hne⟩)))
        have hyu : ∑ a, y a * J.mulVec u a = 0 := by
          refine hlin1 _ u ?_ y hy
          intro b hb
          by_contra hne
          apply huv
          exact Relation.EqvGen.trans _ _ _ (Relation.EqvGen.symm _ _
            (Relation.EqvGen.rel _ _ ((hRiff b u).mpr ⟨hBV hb.1, hu, hne⟩))) hb.2
        rw [← hyz, hadd1, hyu, zero_add] at hvu
        exact hvu
    have hz00 := hnd z hz0
    rw [hz00, add_zero] at hyz
    subst hyz; exact hy

  obtain ⟨b, hbV, hbspan, hbli⟩ := exists_linearIndependent K V
  have hbfin : b.Finite := hbli.setFinite
  obtain ⟨B, hBV, hBspan⟩ : ∃ B : Finset (Fin r → K), (↑B : Set (Fin r → K)) ⊆ V ∧
      Submodule.span K (↑B : Set (Fin r → K)) = ⊤ :=
    ⟨hbfin.toFinset, by rw [Set.Finite.coe_toFinset]; exact hbV,
      by rw [Set.Finite.coe_toFinset, hbspan, hspan]⟩

  have hpath : ∀ u w, Relation.EqvGen R u w → ∃ C : Finset (Fin r → K), u ∈ C ∧ w ∈ C ∧
      ∀ c ∈ C, Relation.EqvGen (fun x y => x ∈ C ∧ y ∈ C ∧ R x y) u c := by
    intro u w h
    induction h with
    | rel x y hxy =>
      refine ⟨{x, y}, by simp, by simp, ?_⟩
      intro c hc
      rcases Finset.mem_insert.mp hc with hc | hc
      · rw [hc]; exact Relation.EqvGen.refl _
      · rw [Finset.mem_singleton.mp hc]
        exact Relation.EqvGen.rel _ _ ⟨by simp, by simp, hxy⟩
    | refl x =>
      refine ⟨{x}, by simp, by simp, ?_⟩
      intro c hc
      rw [Finset.mem_singleton.mp hc]
      exact Relation.EqvGen.refl _
    | symm x y _ ih =>
      obtain ⟨C, hx, hy, hC⟩ := ih
      refine ⟨C, hy, hx, ?_⟩
      intro c hc
      exact Relation.EqvGen.trans _ _ _ (Relation.EqvGen.symm _ _ (hC y hy)) (hC c hc)
    | trans x y z _ _ ih1 ih2 =>
      obtain ⟨C₁, hx1, hy1, hC1⟩ := ih1
      obtain ⟨C₂, hy2, hz2, hC2⟩ := ih2
      have m1 : ∀ a b, (a ∈ C₁ ∧ b ∈ C₁ ∧ R a b) → (a ∈ C₁ ∪ C₂ ∧ b ∈ C₁ ∪ C₂ ∧ R a b) :=
        fun a b h => ⟨Finset.mem_union_left _ h.1, Finset.mem_union_left _ h.2.1, h.2.2⟩
      have m2 : ∀ a b, (a ∈ C₂ ∧ b ∈ C₂ ∧ R a b) → (a ∈ C₁ ∪ C₂ ∧ b ∈ C₁ ∪ C₂ ∧ R a b) :=
        fun a b h => ⟨Finset.mem_union_right _ h.1, Finset.mem_union_right _ h.2.1, h.2.2⟩
      refine ⟨C₁ ∪ C₂, Finset.mem_union_left _ hx1, Finset.mem_union_right _ hz2, ?_⟩
      intro c hc
      rcases Finset.mem_union.mp hc with hc | hc
      · exact emono _ _ m1 _ _ (hC1 c hc)
      · exact Relation.EqvGen.trans _ _ _ (emono _ _ m1 _ _ (hC1 y hy1))
          (emono _ _ m2 _ _ (hC2 c hc))
  have hpath' : ∀ q : (Fin r → K) × (Fin r → K), ∃ C : Finset (Fin r → K), q.1 ∈ C ∧
      (Relation.EqvGen R q.1 q.2 → q.2 ∈ C) ∧
      ∀ c ∈ C, Relation.EqvGen (fun x y => x ∈ C ∧ y ∈ C ∧ R x y) q.1 c := by
    intro q
    by_cases h : Relation.EqvGen R q.1 q.2
    · obtain ⟨C, h1, h2, h3⟩ := hpath _ _ h
      exact ⟨C, h1, fun _ => h2, h3⟩
    · refine ⟨{q.1}, by simp, fun h' => absurd h' h, ?_⟩
      intro c hc
      rw [Finset.mem_singleton.mp hc]
      exact Relation.EqvGen.refl _
  choose Cq hCq1 hCq2 hCq3 using hpath'
  obtain ⟨T, hTdef⟩ : ∃ T : Finset (Fin r → K), T = (B ×ˢ B).biUnion Cq := ⟨_, rfl⟩
  have hTsub : ∀ q ∈ B ×ˢ B, Cq q ⊆ T := by
    intro q hq
    rw [hTdef]
    exact Finset.subset_biUnion_of_mem Cq hq
  have hmonoT : ∀ q ∈ B ×ˢ B, ∀ x y,
      Relation.EqvGen (fun x y => x ∈ Cq q ∧ y ∈ Cq q ∧ R x y) x y →
      Relation.EqvGen (fun x y => x ∈ T ∧ y ∈ T ∧ R x y) x y := by
    intro q hq x y h
    exact emono _ _ (fun a b hab => ⟨hTsub q hq hab.1, hTsub q hq hab.2.1, hab.2.2⟩) x y h
  have hmonoR : ∀ x y, Relation.EqvGen (fun x y => x ∈ T ∧ y ∈ T ∧ R x y) x y →
      Relation.EqvGen R x y :=
    fun x y h => emono _ _ (fun a b hab => hab.2.2) x y h
  have hT1 : B ⊆ T := by
    intro b hb
    exact hTsub (b, b) (Finset.mem_product.mpr ⟨hb, hb⟩) (hCq1 (b, b))
  have hT2 : ∀ t ∈ T, ∃ b ∈ B, Relation.EqvGen (fun x y => x ∈ T ∧ y ∈ T ∧ R x y) b t := by
    intro t ht
    rw [hTdef] at ht
    obtain ⟨q, hq, htq⟩ := Finset.mem_biUnion.mp ht
    rw [← hTdef] at ht
    exact ⟨q.1, (Finset.mem_product.mp hq).1, hmonoT q hq _ _ (hCq3 q t htq)⟩
  have hTV : ∀ t ∈ T, t ∈ V := by
    intro t ht
    obtain ⟨b, hb, hbt⟩ := hT2 t ht
    exact (hV b t (hmonoR _ _ hbt)).mp (hBV hb)
  have hT3 : ∀ t ∈ T, ∀ t' ∈ T, Relation.EqvGen R t t' →
      Relation.EqvGen (fun x y => x ∈ T ∧ y ∈ T ∧ R x y) t t' := by
    intro t ht t' ht' htt'
    obtain ⟨b, hb, hbt⟩ := hT2 t ht
    obtain ⟨b', hb', hbt'⟩ := hT2 t' ht'
    have hbb' : Relation.EqvGen R b b' :=
      Relation.EqvGen.trans _ _ _ (hmonoR _ _ hbt)
        (Relation.EqvGen.trans _ _ _ htt' (Relation.EqvGen.symm _ _ (hmonoR _ _ hbt')))
    have hq : (b, b') ∈ B ×ˢ B := Finset.mem_product.mpr ⟨hb, hb'⟩
    have h1 := hmonoT (b, b') hq _ _ (hCq3 (b, b') b' (hCq2 (b, b') hbb'))
    exact Relation.EqvGen.trans _ _ _ (Relation.EqvGen.symm _ _ hbt)
      (Relation.EqvGen.trans _ _ _ h1 hbt')

  obtain ⟨k, δ, hδT, hδinj, hδsurj⟩ : ∃ (k : ℕ) (δ : Fin k → Fin r → K), (∀ i, δ i ∈ T) ∧
      Function.Injective δ ∧ ∀ x ∈ T, ∃ i, δ i = x :=
    ⟨T.card, fun i => (T.equivFin.symm i : Fin r → K), fun i => (T.equivFin.symm i).2,
      Subtype.val_injective.comp T.equivFin.symm.injective,
      fun x hx => ⟨T.equivFin ⟨x, hx⟩, by simp⟩⟩

  have hmin : ∀ (s t : Finset (Fin k)) (hs : s.Nonempty) (ht : t.Nonempty), s = t →
      s.min' hs = t.min' ht := by
    intro s t hs ht h; subst h; rfl
  obtain ⟨β, hβ⟩ : ∃ β : Fin k → Fin k, ∀ i j, β i = β j ↔ Relation.EqvGen R (δ i) (δ j) := by
    have hne : ∀ i, (Finset.univ.filter (fun j => Relation.EqvGen R (δ j) (δ i))).Nonempty :=
      fun i => ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ _, Relation.EqvGen.refl _⟩⟩
    refine ⟨fun i => (Finset.univ.filter (fun j => Relation.EqvGen R (δ j) (δ i))).min' (hne i),
      ?_⟩
    intro i j
    constructor
    · intro h
      have h1 := Finset.min'_mem _ (hne i)
      have h2 := Finset.min'_mem _ (hne j)
      simp only at h
      rw [h] at h1
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at h1 h2
      exact Relation.EqvGen.trans _ _ _ (Relation.EqvGen.symm _ _ h1) h2
    · intro h
      apply hmin
      ext l
      simp only [Finset.mem_filter, Finset.mem_univ, true_and]
      exact ⟨fun h' => Relation.EqvGen.trans _ _ _ h' h,
        fun h' => Relation.EqvGen.trans _ _ _ h' (Relation.EqvGen.symm _ _ h)⟩
  subst hR
  refine ⟨k, k, δ, β, fun i => hTV _ (hδT i), ?_, ?_, ?_, ?_⟩
  · rw [eq_top_iff, ← hBspan]
    apply Submodule.span_mono
    intro x hx
    obtain ⟨i, hi⟩ := hδsurj x (hT1 hx)
    exact ⟨i, hi⟩
  · intro i j hij
    by_contra hne
    exact hij ((hβ i j).mpr (Relation.EqvGen.rel _ _
      ((hRiff _ _).mpr ⟨hTV _ (hδT i), hTV _ (hδT j), hne⟩)))
  · intro A hA i j hij
    have hT3' := hT3 (δ i) (hδT i) (δ j) (hδT j) ((hβ i j).mp hij)
    have key : ∀ x y, Relation.EqvGen (fun x y => x ∈ T ∧ y ∈ T ∧
        (fun u w => u ∈ V ∧ w ∈ V ∧ ∑ a, u a * J.mulVec w a ≠ 0) x y) x y →
        (x ∈ δ '' A ↔ y ∈ δ '' A) := by
      intro x y h
      induction h with
      | rel x y hxy =>
        obtain ⟨hxT, hyT, hRxy⟩ := hxy
        obtain ⟨i', rfl⟩ := hδsurj x hxT
        obtain ⟨j', rfl⟩ := hδsurj y hyT
        rw [hδinj.mem_set_image, hδinj.mem_set_image]
        have hb : β i' = β j' := (hβ i' j').mpr (Relation.EqvGen.rel _ _ hRxy)
        have hω := ((hRiff _ _).mp hRxy).2.2
        constructor
        · intro hi'
          by_contra hj'
          exact hω (hA i' hi' j' hj' hb)
        · intro hj'
          by_contra hi'
          apply hω
          rw [hanti (δ i') (δ j'), hA j' hj' i' hi' hb.symm, neg_zero]
      | refl => exact Iff.rfl
      | symm x y _ ih => exact ih.symm
      | trans x y z _ _ ih1 ih2 => exact ih1.trans ih2
    have := key _ _ hT3'
    rwa [hδinj.mem_set_image, hδinj.mem_set_image] at this
  · intro i v hv hiv
    have h1 := hcs (↑B) hBV hBspan v hv
    refine Submodule.span_mono ?_ h1
    rintro x ⟨hxB, hxv⟩
    obtain ⟨j, rfl⟩ := hδsurj x (hT1 hxB)
    refine ⟨j, ?_, rfl⟩
    exact (hβ j i).mpr (Relation.EqvGen.trans _ _ _ hxv (Relation.EqvGen.symm _ _ hiv))

theorem wc_pencil_VQ_block_monodromy_datum_nm (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n) (hNM : wcPencilNoMixed D)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∃ (r k p : ℕ) (J : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (G : Type) (_ : Group G)
      (ρ : G →* Matrix (Fin r) (Fin r) ℚ_[ℓ]) (deg : G →* Multiplicative ℤ) (F₁ : G) (μ : ℚ_[ℓ])
      (δ : Fin k → Fin r → ℚ_[ℓ]) (β : Fin k → Fin p) (ε : Fin k → ℚ_[ℓ]) (τ : Fin k → G),
      J.transpose = -J ∧ IsUnit J.det ∧ (∀ σ a b, ‖ρ σ a b‖ ≤ 1) ∧
      deg F₁ = Multiplicative.ofAdd 1 ∧ μ ≠ 0 ∧ (ρ F₁).transpose * J * ρ F₁ = μ • J ∧
      (∀ i, deg (τ i) = 1 ∧ ε i ≠ 0 ∧
        ρ (τ i) = 1 + ε i • Matrix.vecMulVec (δ i) (Matrix.vecMul (δ i) J)) ∧
      Submodule.span ℚ_[ℓ] (Set.range δ) = ⊤ ∧
      (∀ i j, β i ≠ β j → ∑ a, δ i a * J.mulVec (δ j) a = 0) ∧
      (∀ A : Set (Fin k), (∀ i ∈ A, ∀ j ∉ A, β i = β j → ∑ a, δ i a * J.mulVec (δ j) a = 0) →
        ∀ i j, β i = β j → (i ∈ A ↔ j ∈ A)) ∧
      (∀ i, (ρ F₁).mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})) ∧
      ∀ (γ : G) (N t : ℕ), 1 ≤ N → ∃ (d : ℕ) (x : (wcP1Over F'').left) (σ c : G),
        1 ≤ d ∧ x ∈ wcP1ClosedPt F'' d ∧ (∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) ∧
        (N : ℤ) ∣ (d : ℤ) - Multiplicative.toAdd (deg γ) ∧
        (∀ a b, ‖ρ (c * σ * c⁻¹) a b - ρ γ a b‖ ≤ (ℓ : ℝ) ^ (-(t : ℤ))) ∧
        (wcPencilLoc D ℓ hP x d = 0 ∨
          wcPencilLoc D ℓ hP x d = (ρ σ).charpoly.aroots (AlgebraicClosure ℚ_[ℓ])) :=
by
  classical
  obtain ⟨r, m, J, G, hG, ρ, deg, F₁, μ, v₀, ε, τ, Fs, hJ, hJdet, hint, hF₁, hμ, hF₁J, hsim, hτ,
    hFs, hspan, hgen, hcheb⟩ := wc_pencil_VQ_raw_monodromy_datum_nm F' F'' Y n hn hn2 D hNM ℓ hℓ hP hNI
  have hinv : ∀ g : G, ρ g⁻¹ * ρ g = 1 := fun g => by rw [← map_mul, inv_mul_cancel, map_one]
  have h0 : (0 : Fin r → ℚ_[ℓ]) ∉ {v | ∃ (g : G) (s : Fin m), v = (ρ g).mulVec (v₀ s)} := by
    rintro ⟨g, s, hgs⟩
    apply (hτ s).1
    have := congrArg (ρ g⁻¹).mulVec hgs
    rw [Matrix.mulVec_zero, Matrix.mulVec_mulVec, hinv, Matrix.one_mulVec] at this
    exact this.symm
  obtain ⟨k, p, δ, β, hδV, hδspan, horth, hconn, hclass⟩ :=
    wc_block_family_selection r J hJ hJdet _ h0 hspan
  have hstab := wc_block_class_stability r m J hJ hJdet ρ deg v₀ ε τ Fs hsim hτ hFs hspan hgen
  have hδV' : ∀ i, ∃ (g : G) (s : Fin m), δ i = (ρ g).mulVec (v₀ s) := fun i => hδV i
  choose gi si hgi using hδV'
  choose ci hci0 hciJ using fun i => hsim (gi i)
  have hconj : ∀ (M M' : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (c e : ℚ_[ℓ]) (d : Fin r → ℚ_[ℓ]),
      c ≠ 0 → M * M' = 1 → M.transpose * J * M = c • J →
      M * (1 + e • Matrix.vecMulVec d (Matrix.vecMul d J)) * M' =
        1 + (e / c) • Matrix.vecMulVec (M.mulVec d) (Matrix.vecMul (M.mulVec d) J) := by
    intro M M' c e d hc h1 hMJ
    have hT : M.transpose * J = c • (J * M') := by
      calc M.transpose * J = M.transpose * J * (M * M') := by rw [h1, Matrix.mul_one]
        _ = (M.transpose * J * M) * M' := by simp only [Matrix.mul_assoc]
        _ = c • (J * M') := by rw [hMJ, Matrix.smul_mul]
    have hv : Matrix.vecMul (M.mulVec d) J = c • Matrix.vecMul (Matrix.vecMul d J) M' := by
      rw [← Matrix.vecMul_transpose, Matrix.vecMul_vecMul, hT, Matrix.vecMul_smul,
        Matrix.vecMul_vecMul]
    rw [hv, Matrix.vecMulVec_smul, smul_smul, div_mul_cancel₀ e hc, Matrix.mul_add,
      Matrix.mul_one, Matrix.add_mul, h1, Matrix.mul_smul, Matrix.smul_mul, Matrix.mul_vecMulVec,
      Matrix.vecMulVec_mul]
  refine ⟨r, k, p, J, G, hG, ρ, deg, F₁, μ, δ, β, fun i => ε (si i) / ci i,
    fun i => gi i * τ (si i) * (gi i)⁻¹, hJ, hJdet, hint, hF₁, hμ, hF₁J, ?_, hδspan, horth,
    hconn, ?_, hcheb⟩
  · intro i
    beta_reduce
    refine ⟨?_, div_ne_zero (hτ (si i)).2.2.1 (hci0 i), ?_⟩
    · rw [map_mul, map_mul, (hτ (si i)).2.1, mul_one, map_inv, mul_inv_cancel]
    · have h1 : ρ (gi i) * ρ (gi i)⁻¹ = 1 := by rw [← map_mul, mul_inv_cancel, map_one]
      rw [map_mul, map_mul, (hτ (si i)).2.2.2, hconj _ _ _ _ _ (hci0 i) h1 (hciJ i), ← hgi i]
  · intro i
    have hmem : (ρ F₁).mulVec (δ i) ∈ {v | ∃ (g : G) (s : Fin m), v = (ρ g).mulVec (v₀ s)} :=
      ⟨F₁ * gi i, si i, by rw [hgi i, Matrix.mulVec_mulVec, map_mul]⟩
    exact hclass i _ hmem (Relation.EqvGen.symm _ _ (hstab F₁ (δ i) (hδV i)))

theorem wc_sp_lie_span_block_transvections {k₀ : Type*} [Field k₀] [CharZero k₀]
    (r k p : ℕ) (J : Matrix (Fin r) (Fin r) k₀) (hJ : J.transpose = -J) (hJdet : IsUnit J.det)
    (δ : Fin k → Fin r → k₀) (β : Fin k → Fin p)
    (hspan : Submodule.span k₀ (Set.range δ) = ⊤)
    (horth : ∀ i j, β i ≠ β j → ∑ a, δ i a * J.mulVec (δ j) a = 0)
    (hconn : ∀ A : Set (Fin k), (∀ i ∈ A, ∀ j ∉ A, β i = β j → ∑ a, δ i a * J.mulVec (δ j) a = 0) →
      ∀ i j, β i = β j → (i ∈ A ↔ j ∈ A))
    (ε : Fin k → k₀) (hε : ∀ i, ε i ≠ 0) :
    ∀ V : Submodule k₀ (Matrix (Fin r) (Fin r) k₀),
      (∀ i, ε i • Matrix.vecMulVec (δ i) (Matrix.vecMul (δ i) J) ∈ V) →
      (∀ A ∈ V, ∀ B ∈ V, A * B - B * A ∈ V) →
      ∀ X : Matrix (Fin r) (Fin r) k₀, X.transpose * J + J * X = 0 →
        (∀ i, X.mulVec (δ i) ∈ Submodule.span k₀ (δ '' {j | β j = β i})) → X ∈ V :=
by
  classical
  intro V hgen hV X hX hBP

  obtain ⟨E, hE⟩ : ∃ E : (Fin r → k₀) → (Fin r → k₀) → Matrix (Fin r) (Fin r) k₀,
      ∀ u v, E u v = Matrix.vecMulVec u (Matrix.vecMul v J) := ⟨_, fun _ _ => rfl⟩
  set Bf : (Fin r → k₀) →ₗ[k₀] (Fin r → k₀) →ₗ[k₀] k₀ := Matrix.toLinearMap₂' k₀ J with hBf
  have hBfe : ∀ u v, Bf u v = ∑ a, u a * J.mulVec v a := by
    intro u v
    rw [hBf, Matrix.toLinearMap₂'_apply']
    rfl
  obtain ⟨Sm, hSm⟩ : ∃ Sm : (Fin r → k₀) → (Fin r → k₀) → Matrix (Fin r) (Fin r) k₀,
      ∀ u v, Sm u v = E u v + E v u := ⟨_, fun _ _ => rfl⟩

  have hprod : ∀ u v p q : Fin r → k₀, E u v * E p q = Bf v p • E u q := by
    intro u v p q
    rw [hE, hE, hE, hBfe]
    ext a b
    simp only [Matrix.mul_apply, Matrix.vecMulVec_apply, Matrix.smul_apply, smul_eq_mul]
    have h1 : ∑ c, Matrix.vecMul v J c * p c = ∑ a, v a * J.mulVec p a := by
      have := Matrix.dotProduct_mulVec v J p
      simp only [dotProduct] at this
      exact this.symm
    calc ∑ c, u a * Matrix.vecMul v J c * (p c * Matrix.vecMul q J b)
        = u a * Matrix.vecMul q J b * ∑ c, Matrix.vecMul v J c * p c := by
          rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro c _; ring
      _ = _ := by rw [h1]; ring

  have hJe : ∀ a e, J a e = - J e a := by
    intro a e
    have := congrFun (congrFun hJ e) a
    simp only [Matrix.transpose_apply, Matrix.neg_apply] at this
    exact this
  have hanti : ∀ u v : Fin r → k₀, Bf u v = - Bf v u := by
    intro u v
    rw [hBfe, hBfe]
    simp only [Matrix.mulVec, dotProduct, Finset.mul_sum]
    rw [Finset.sum_comm, ← Finset.sum_neg_distrib]
    apply Finset.sum_congr rfl; intro e _
    rw [← Finset.sum_neg_distrib]
    apply Finset.sum_congr rfl; intro a _
    rw [hJe]; ring

  have hbr : ∀ x b c : Fin r → k₀, E x x * Sm b c - Sm b c * E x x =
      Bf x b • Sm x c + Bf x c • Sm x b := by
    intro x b c
    simp only [hSm]
    rw [mul_add, add_mul, hprod, hprod, hprod, hprod, hanti c x, hanti b x]
    simp only [smul_add, neg_smul]
    abel

  have hG : ∀ i, E (δ i) (δ i) ∈ V := by
    intro i
    have h := hgen i
    rw [← hE] at h
    exact (Submodule.smul_mem_iff V (hε i)).mp h
  have hdiag : ∀ j, Sm (δ j) (δ j) ∈ V := by
    intro j
    rw [hSm, ← two_smul k₀]
    exact V.smul_mem _ (hG j)

  have hedge : ∀ i j, Bf (δ i) (δ j) ≠ 0 → Sm (δ i) (δ j) ∈ V := by
    intro i j h
    have h1 := hV _ (hG i) _ (hdiag j)
    rw [hbr, ← add_smul] at h1
    have h2 : Bf (δ i) (δ j) + Bf (δ i) (δ j) ≠ 0 := by
      rw [← two_mul]; exact mul_ne_zero two_ne_zero h
    exact (Submodule.smul_mem_iff V h2).mp h1

  have hprop : ∀ i p j, Sm (δ p) (δ j) ∈ V → Bf (δ i) (δ p) ≠ 0 → Sm (δ i) (δ j) ∈ V := by
    intro i p j hpj h
    have h1 := hV _ (hG i) _ hpj
    rw [hbr] at h1
    have h2 : Bf (δ i) (δ p) • Sm (δ i) (δ j) ∈ V := by
      have h3 := V.sub_mem h1 (V.smul_mem (Bf (δ i) (δ j)) (hedge i p h))
      rwa [add_sub_cancel_right] at h3
    exact (Submodule.smul_mem_iff V h).mp h2

  have hclos : ∀ i j, β i = β j → Sm (δ i) (δ j) ∈ V := by
    intro i j hij
    have hA := hconn {l | Sm (δ l) (δ j) ∈ V} (by
      intro a ha b hb _
      by_contra hne
      have h' : Bf (δ a) (δ b) ≠ 0 := by rw [hBfe]; exact hne
      have h'' : Bf (δ b) (δ a) ≠ 0 := by rw [hanti]; exact neg_ne_zero.mpr h'
      exact hb (hprop b a j ha h'')) i j hij
    exact hA.mpr (hdiag j)

  have hsymm : ∀ u v, Sm u v = Sm v u := by
    intro u v; rw [hSm, hSm, add_comm]
  have hext : ∀ (α : Fin p) (v : Fin r → k₀), (∀ i, β i = α → Sm (δ i) v ∈ V) →
      ∀ u ∈ Submodule.span k₀ (δ '' {j | β j = α}), Sm u v ∈ V := by
    intro α v hv
    let L : (Fin r → k₀) →ₗ[k₀] Matrix (Fin r) (Fin r) k₀ :=
      { toFun := fun u => Sm u v
        map_add' := by
          intro u u'
          simp only [hSm, hE]
          rw [Matrix.add_vecMulVec, Matrix.add_vecMul, Matrix.vecMulVec_add]
          abel
        map_smul' := by
          intro c u
          simp only [hSm, hE, RingHom.id_apply]
          rw [Matrix.smul_vecMulVec, Matrix.smul_vecMul, Matrix.vecMulVec_smul, smul_add] }
    have hle : Submodule.span k₀ (δ '' {j | β j = α}) ≤ V.comap L := by
      rw [Submodule.span_le]
      rintro _ ⟨i, hi, rfl⟩
      exact hv i hi
    intro u hu
    exact hle hu
  have hall : ∀ α : Fin p, ∀ u ∈ Submodule.span k₀ (δ '' {j | β j = α}),
      ∀ v ∈ Submodule.span k₀ (δ '' {j | β j = α}), Sm u v ∈ V := by
    intro α
    have h1 : ∀ j, β j = α → ∀ u ∈ Submodule.span k₀ (δ '' {j | β j = α}), Sm u (δ j) ∈ V :=
      fun j hj => hext α (δ j) (fun i hi => hclos i j (hi.trans hj.symm))
    intro u hu v hv
    rw [hsymm]
    exact hext α u (fun j hj => by rw [hsymm]; exact h1 j hj u hu) v hv

  have hcoef : ∀ a : Fin r, ∃ c : Fin k → k₀, ∑ i, c i • δ i = Pi.single a (1 : k₀) := by
    intro a
    have : (Pi.single a (1 : k₀) : Fin r → k₀) ∈ Submodule.span k₀ (Set.range δ) := by
      rw [hspan]; exact Submodule.mem_top
    exact (Submodule.mem_span_range_iff_exists_fun k₀).mp this
  choose c hc using hcoef
  have hrecon : ∀ v : Fin r → k₀, ∑ i, (∑ a, c a i * v a) • δ i = v := by
    intro v
    simp_rw [Finset.sum_smul]
    rw [Finset.sum_comm]
    have h : ∀ a, ∑ i, (c a i * v a) • δ i = v a • (Pi.single a (1 : k₀) : Fin r → k₀) := by
      intro a
      rw [← hc a, Finset.smul_sum]
      apply Finset.sum_congr rfl; intro i _
      rw [smul_smul, mul_comm]
    simp_rw [h]
    ext b
    simp [Finset.sum_apply, Pi.single_apply]
  obtain ⟨Q, hQ⟩ : ∃ Q : Fin p → Matrix (Fin r) (Fin r) k₀, ∀ α, Q α =
      ∑ i, if β i = α then Matrix.vecMulVec (δ i) (fun a => c a i) else 0 :=
    ⟨_, fun _ => rfl⟩
  have hQv : ∀ α (v : Fin r → k₀), (Q α).mulVec v =
      ∑ i, if β i = α then (∑ a, c a i * v a) • δ i else 0 := by
    intro α v
    rw [hQ, Matrix.sum_mulVec]
    apply Finset.sum_congr rfl; intro i _
    split_ifs
    · ext b
      simp only [Matrix.mulVec, dotProduct, Matrix.vecMulVec_apply, Pi.smul_apply, smul_eq_mul,
        Finset.sum_mul]
      apply Finset.sum_congr rfl; intro a _; ring
    · exact Matrix.zero_mulVec v
  have hQim : ∀ α (v : Fin r → k₀), (Q α).mulVec v ∈ Submodule.span k₀ (δ '' {j | β j = α}) := by
    intro α v
    rw [hQv]
    apply Submodule.sum_mem; intro i _
    split_ifs with hi
    · exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, hi, rfl⟩)
    · exact Submodule.zero_mem _
  have hQsum : ∀ v : Fin r → k₀, ∑ α, (Q α).mulVec v = v := by
    intro v
    simp_rw [hQv]
    rw [Finset.sum_comm]
    simp only [Finset.sum_ite_eq, Finset.mem_univ, if_true]
    exact hrecon v
  have hQ1 : ∑ α, Q α = 1 := by
    apply Matrix.toLin'.injective
    apply LinearMap.ext; intro v
    rw [Matrix.toLin'_apply, Matrix.toLin'_apply, Matrix.sum_mulVec, Matrix.one_mulVec]
    exact hQsum v
  have hOδ : ∀ γ (u : Fin r → k₀) j, γ ≠ β j → Bf ((Q γ).mulVec u) (δ j) = 0 := by
    intro γ u j hγ
    rw [hQv, LinearMap.map_sum₂]
    apply Finset.sum_eq_zero; intro i _
    split_ifs with hi
    · rw [LinearMap.map_smul₂, hBfe, horth i j (by rw [hi]; exact hγ), smul_zero]
    · rw [LinearMap.map_zero₂]
  have hOQ : ∀ α γ, α ≠ γ → ∀ u w : Fin r → k₀,
      Bf ((Q α).mulVec u) ((Q γ).mulVec w) = 0 := by
    intro α γ hαγ u w
    rw [hQv γ w, map_sum]
    apply Finset.sum_eq_zero; intro i _
    split_ifs with hi
    · rw [map_smul, hOδ α u i (by rw [hi]; exact hαγ), smul_zero]
    · rw [map_zero]
  have hadj : ∀ α (u w : Fin r → k₀), Bf ((Q α).mulVec u) w = Bf u ((Q α).mulVec w) := by
    intro α u w
    have h1 : Bf ((Q α).mulVec u) w = Bf ((Q α).mulVec u) ((Q α).mulVec w) := by
      conv_lhs => rw [← hQsum w]
      rw [map_sum, Finset.sum_eq_single α]
      · intro γ _ hγ; exact hOQ α γ (Ne.symm hγ) u w
      · intro h; exact absurd (Finset.mem_univ α) h
    have h2 : Bf u ((Q α).mulVec w) = Bf ((Q α).mulVec u) ((Q α).mulVec w) := by
      conv_lhs => rw [← hQsum u]
      rw [LinearMap.map_sum₂, Finset.sum_eq_single α]
      · intro γ _ hγ; exact hOQ γ α hγ u w
      · intro h; exact absurd (Finset.mem_univ α) h
    rw [h1, h2]
  have hJ0 : J.det ≠ 0 := hJdet.ne_zero
  have hnd : ∀ z : Fin r → k₀, (∀ u, Bf u z = 0) → z = 0 := by
    intro z hz
    apply Matrix.eq_zero_of_mulVec_eq_zero hJ0
    ext a
    have h := hz (Pi.single a 1)
    rw [hBfe] at h
    simpa [Pi.single_apply] using h
  have hkill : ∀ γ j, γ ≠ β j → (Q γ).mulVec (δ j) = 0 := by
    intro γ j hγ
    apply hnd; intro u
    rw [← hadj, hOδ γ u j hγ]
  have hfixδ : ∀ j, (Q (β j)).mulVec (δ j) = δ j := by
    intro j
    conv_rhs => rw [← hQsum (δ j)]
    rw [Finset.sum_eq_single (β j)]
    · intro γ _ hγ; exact hkill γ j hγ
    · intro h; exact absurd (Finset.mem_univ _) h
  have hfix : ∀ α, ∀ w ∈ Submodule.span k₀ (δ '' {j | β j = α}), (Q α).mulVec w = w := by
    intro α w hw
    have hle : Submodule.span k₀ (δ '' {j | β j = α}) ≤
        LinearMap.ker (Matrix.toLin' (Q α) - LinearMap.id) := by
      rw [Submodule.span_le]
      rintro _ ⟨j, hj, rfl⟩
      have hj' : β j = α := hj
      simp only [SetLike.mem_coe, LinearMap.mem_ker, LinearMap.sub_apply, Matrix.toLin'_apply,
        LinearMap.id_apply]
      rw [← hj', hfixδ, sub_self]
    have h := hle hw
    rw [LinearMap.mem_ker, LinearMap.sub_apply, Matrix.toLin'_apply, LinearMap.id_apply,
      sub_eq_zero] at h
    exact h
  have hadjM : ∀ α, (Q α).transpose * J = J * Q α := by
    intro α
    have key : ∀ u w : Fin r → k₀, u ⬝ᵥ ((Q α).transpose * J).mulVec w =
        u ⬝ᵥ (J * Q α).mulVec w := by
      intro u w
      rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec u (Q α).transpose,
        Matrix.vecMul_transpose]
      have h := hadj α u w
      rw [hBf, Matrix.toLinearMap₂'_apply', Matrix.toLinearMap₂'_apply'] at h
      exact h
    ext a b
    have h := key (Pi.single a 1) (Pi.single b 1)
    simpa [dotProduct, Matrix.mulVec, Pi.single_apply] using h

  have hXW : ∀ α, ∀ w ∈ Submodule.span k₀ (δ '' {j | β j = α}),
      X.mulVec w ∈ Submodule.span k₀ (δ '' {j | β j = α}) := by
    intro α w hw
    have hle : Submodule.span k₀ (δ '' {j | β j = α}) ≤
        (Submodule.span k₀ (δ '' {j | β j = α})).comap (Matrix.toLin' X) := by
      rw [Submodule.span_le]
      rintro _ ⟨j, hj, rfl⟩
      have hj' : β j = α := hj
      simp only [SetLike.mem_coe, Submodule.mem_comap, Matrix.toLin'_apply]
      have h := hBP j
      rw [hj'] at h
      exact h
    exact hle hw
  have hQXQ : ∀ α, Q α * X * Q α = X * Q α := by
    intro α
    apply Matrix.toLin'.injective
    apply LinearMap.ext; intro v
    simp only [Matrix.toLin'_apply, ← Matrix.mulVec_mulVec]
    exact hfix α _ (hXW α _ (hQim α v))
  have hsumQXQ : ∑ α, Q α * X * Q α = X := by
    simp_rw [hQXQ]
    rw [← Finset.mul_sum, hQ1, Matrix.mul_one]
  have hQE : ∀ α (u y : Fin r → k₀), Q α * E u y * Q α = E ((Q α).mulVec u) ((Q α).mulVec y) := by
    intro α u y
    rw [hE, hE, Matrix.mul_vecMulVec, Matrix.vecMulVec_mul, Matrix.vecMul_vecMul, ← hadjM α,
      ← Matrix.vecMul_vecMul, Matrix.vecMul_transpose]
  have hQS : ∀ α (u v : Fin r → k₀),
      Q α * Sm u v * Q α = Sm ((Q α).mulVec u) ((Q α).mulVec v) := by
    intro α u v
    rw [hSm, hSm, Matrix.mul_add, Matrix.add_mul, hQE, hQE]

  set Y := X * J⁻¹ with hY
  have hYJ : Y * J = X := by
    rw [hY, Matrix.mul_assoc, Matrix.nonsing_inv_mul J hJdet, Matrix.mul_one]
  have hJiJ : (J⁻¹).transpose * J = -1 := by
    have h1 := congrArg Matrix.transpose (Matrix.mul_nonsing_inv J hJdet)
    rw [Matrix.transpose_mul, Matrix.transpose_one, hJ, Matrix.mul_neg] at h1
    rw [← neg_neg ((J⁻¹).transpose * J), h1]
  have hXJ : X.transpose * J = -(J * X) := eq_neg_of_add_eq_zero_left hX
  have hYtJ : Y.transpose * J = X := by
    rw [hY, Matrix.transpose_mul, Matrix.mul_assoc, hXJ, Matrix.mul_neg, ← Matrix.mul_assoc,
      hJiJ, Matrix.neg_mul, Matrix.one_mul, neg_neg]
  have hdec : ∑ a : Fin r, Sm (Pi.single a (1 : k₀)) (Y a) = (2 : k₀) • X := by
    ext b c
    rw [Matrix.sum_apply]
    simp only [hSm, hE, Matrix.add_apply, Matrix.vecMulVec_apply, Finset.sum_add_distrib,
      Matrix.smul_apply, smul_eq_mul]
    have e1 : ∑ a : Fin r, (Pi.single a (1 : k₀) : Fin r → k₀) b * Matrix.vecMul (Y a) J c
        = (Y * J) b c := by
      simp [Matrix.mul_apply, Pi.single_apply, Matrix.vecMul, dotProduct]
    have e2 : ∑ a : Fin r, Y a b * Matrix.vecMul (Pi.single a (1 : k₀) : Fin r → k₀) J c
        = (Y.transpose * J) b c := by
      simp [Matrix.mul_apply, Pi.single_apply, Matrix.vecMul, dotProduct]
    rw [e1, e2, hYJ, hYtJ]; ring
  have hblk : ∀ α, Q α * X * Q α ∈ V := by
    intro α
    have h2 : (2 : k₀) • (Q α * X * Q α) =
        ∑ a : Fin r, Sm ((Q α).mulVec (Pi.single a (1 : k₀))) ((Q α).mulVec (Y a)) := by
      rw [← Matrix.smul_mul, ← Matrix.mul_smul, ← hdec, Finset.mul_sum, Finset.sum_mul]
      apply Finset.sum_congr rfl; intro a _
      exact hQS α _ _
    have h3 : (2 : k₀) • (Q α * X * Q α) ∈ V := by
      rw [h2]
      exact V.sum_mem (fun a _ => hall α _ (hQim α _) _ (hQim α _))
    exact (Submodule.smul_mem_iff V two_ne_zero).mp h3
  rw [← hsumQXQ]
  exact V.sum_mem (fun α _ => hblk α)

theorem wc_spb_adjoint_block_preserving (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r k p : ℕ)
    (J : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (hJ : J.transpose = -J) (hJdet : IsUnit J.det)
    (δ : Fin k → Fin r → ℚ_[ℓ]) (β : Fin k → Fin p)
    (hspan : Submodule.span ℚ_[ℓ] (Set.range δ) = ⊤)
    (horth : ∀ i j, β i ≠ β j → ∑ a, δ i a * J.mulVec (δ j) a = 0)
    (Z : Matrix (Fin r) (Fin r) ℚ_[ℓ])
    (hZ : ∀ i, Z.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})) :
    ∀ i, (J⁻¹ * Z.transpose * J).mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i}) :=
by
  classical
  have adj : ∀ x y : Fin r → ℚ_[ℓ],
      dotProduct x (J.mulVec ((J⁻¹ * Z.transpose * J).mulVec y)) =
        dotProduct (Z.mulVec x) (J.mulVec y) := by
    intro x y
    rw [Matrix.mulVec_mulVec, ← Matrix.mul_assoc, ← Matrix.mul_assoc,
      Matrix.mul_nonsing_inv J hJdet, Matrix.one_mul, ← Matrix.mulVec_mulVec,
      Matrix.dotProduct_mulVec, Matrix.vecMul_transpose]
  have orth : ∀ i j, β i ≠ β j → dotProduct (δ i) (J.mulVec (δ j)) = 0 :=
    fun i j h => horth i j h
  have bso : ∀ (i : Fin k) (b : Fin p), b ≠ β i →
      ∀ v ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = b}), dotProduct v (J.mulVec (δ i)) = 0 := by
    intro i b hb v hv
    induction hv using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨j, hj, rfl⟩ := hx
      have hj' : β j = b := hj
      exact orth j i (by rw [hj']; exact hb)
    | zero => exact zero_dotProduct _
    | add x y _ _ hx hy => rw [add_dotProduct, hx, hy, add_zero]
    | smul a x _ hx => rw [smul_dotProduct, hx, smul_zero]
  have nondeg : ∀ w : Fin r → ℚ_[ℓ], (∀ m, dotProduct (δ m) (J.mulVec w) = 0) → w = 0 := by
    intro w hw
    have hall : ∀ v ∈ Submodule.span ℚ_[ℓ] (Set.range δ), dotProduct v (J.mulVec w) = 0 := by
      intro v hv
      induction hv using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨m, rfl⟩ := hx
        exact hw m
      | zero => exact zero_dotProduct _
      | add x y _ _ hx hy => rw [add_dotProduct, hx, hy, add_zero]
      | smul a x _ hx => rw [smul_dotProduct, hx, smul_zero]
    have hg : J.mulVec w = 0 := by
      funext a
      have h := hall (Pi.single a 1) (by rw [hspan]; exact Submodule.mem_top)
      rw [single_dotProduct, one_mul] at h
      simpa using h
    have h2 : J⁻¹.mulVec (J.mulVec w) = J⁻¹.mulVec 0 := by rw [hg]
    rwa [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul J hJdet, Matrix.one_mulVec,
      Matrix.mulVec_zero] at h2
  have expand : ∀ (m : Fin k) (e : Fin k → ℚ_[ℓ]),
      dotProduct (δ m) (J.mulVec (∑ j, e j • δ j)) =
        ∑ j, e j * dotProduct (δ m) (J.mulVec (δ j)) := by
    intro m e
    rw [Matrix.mulVec_sum, dotProduct_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [Matrix.mulVec_smul, dotProduct_smul, smul_eq_mul]
  intro i
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℚ_[ℓ]).mp
    (show (J⁻¹ * Z.transpose * J).mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (Set.range δ) by
      rw [hspan]; exact Submodule.mem_top)
  obtain ⟨u, hu⟩ : ∃ u : Fin r → ℚ_[ℓ],
      u = ∑ j, (if β j = β i then c j else 0) • δ j := ⟨_, rfl⟩
  obtain ⟨w, hw⟩ : ∃ w : Fin r → ℚ_[ℓ],
      w = ∑ j, (if β j = β i then 0 else c j) • δ j := ⟨_, rfl⟩
  have huw : (J⁻¹ * Z.transpose * J).mulVec (δ i) = u + w := by
    rw [← hc, hu, hw, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    split_ifs <;> simp
  have huW : u ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i}) := by
    rw [hu]
    refine Submodule.sum_mem _ (fun j _ => ?_)
    split_ifs with h
    · exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, h, rfl⟩)
    · rw [zero_smul]; exact Submodule.zero_mem _
  have hw0 : w = 0 := by
    apply nondeg
    intro m
    by_cases hm : β m = β i
    · rw [hw, expand]
      refine Finset.sum_eq_zero (fun j _ => ?_)
      split_ifs with h
      · rw [zero_mul]
      · rw [orth m j (by rw [hm]; exact Ne.symm h), mul_zero]
    · have hwy : w = (J⁻¹ * Z.transpose * J).mulVec (δ i) - u := by
        rw [huw]; abel
      rw [hwy, Matrix.mulVec_sub, dotProduct_sub, adj, bso i (β m) hm _ (hZ m), hu, expand,
        zero_sub, neg_eq_zero]
      refine Finset.sum_eq_zero (fun j _ => ?_)
      split_ifs with h
      · rw [orth m j (by rw [h]; exact hm), mul_zero]
      · rw [zero_mul]
  rw [huw, hw0, add_zero]
  exact huW

theorem wc_spb_conj_span_contains (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r k p : ℕ)
    (J : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (δ : Fin k → Fin r → ℚ_[ℓ]) (β : Fin k → Fin p)
    (M : Fin k → Matrix (Fin r) (Fin r) ℚ_[ℓ])
    (hinv : ∀ L : List (Fin k × ℤ),
      (L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod *
        (((L.map (fun q => (q.1, -q.2))).reverse).map
          (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod = 1)
    (hLie : ∀ V : Submodule ℚ_[ℓ] (Matrix (Fin r) (Fin r) ℚ_[ℓ]), (∀ i, M i ∈ V) →
      (∀ A ∈ V, ∀ B ∈ V, A * B - B * A ∈ V) →
      ∀ X : Matrix (Fin r) (Fin r) ℚ_[ℓ], X.transpose * J + J * X = 0 →
        (∀ i, X.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})) → X ∈ V) :
    ∀ X : Matrix (Fin r) (Fin r) ℚ_[ℓ], X.transpose * J + J * X = 0 →
      (∀ i, X.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})) →
      X ∈ Submodule.span ℚ_[ℓ] (Set.range (fun w : List (Fin k × ℤ) × Fin k =>
        (w.1.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod * M w.2 *
          (((w.1.map (fun q => (q.1, -q.2))).reverse).map
            (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod)) :=
by
  intro X hX hXB
  set f : Fin k × ℤ → Matrix (Fin r) (Fin r) ℚ_[ℓ] :=
    fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1 with hf
  set ng : Fin k × ℤ → Fin k × ℤ := fun q => (q.1, -q.2) with hng
  obtain ⟨V, hV⟩ : ∃ V : Submodule ℚ_[ℓ] (Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      V = Submodule.span ℚ_[ℓ] (Set.range (fun w : List (Fin k × ℤ) × Fin k =>
        (w.1.map f).prod * M w.2 * ((w.1.map ng).reverse.map f).prod)) := ⟨_, rfl⟩
  have hgenV : ∀ (L : List (Fin k × ℤ)) (i : Fin k),
      (L.map f).prod * M i * ((L.map ng).reverse.map f).prod ∈ V := by
    intro L i
    rw [hV]
    exact Submodule.subset_span ⟨(L, i), rfl⟩
  have hng2 : ∀ L : List (Fin k × ℤ), (((L.map ng).reverse).map ng).reverse = L := by
    intro L
    have hc : ng ∘ ng = id := by
      funext q
      simp [hng]
    rw [List.map_reverse, List.reverse_reverse, List.map_map, hc, List.map_id]

  have had : ∀ (L₀ : List (Fin k × ℤ)), ∀ Y ∈ V,
      (L₀.map f).prod * Y * ((L₀.map ng).reverse.map f).prod ∈ V := by
    intro L₀ Y hY
    rw [hV] at hY
    induction hY using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨⟨L, i⟩, rfl⟩ := hx
      have e : (L₀.map f).prod * ((L.map f).prod * M i * ((L.map ng).reverse.map f).prod) *
          ((L₀.map ng).reverse.map f).prod
          = ((L₀ ++ L).map f).prod * M i * (((L₀ ++ L).map ng).reverse.map f).prod := by
        simp only [List.map_append, List.reverse_append, List.prod_append, mul_assoc]
      dsimp only
      rw [e]
      exact hgenV _ _
    | zero => simp
    | add x y _ _ hx hy =>
      rw [mul_add, add_mul]
      exact V.add_mem hx hy
    | smul c x _ hx =>
      rw [mul_smul_comm, smul_mul_assoc]
      exact V.smul_mem c hx

  have hgen : ∀ j, ∀ Y ∈ V, M j * Y - Y * M j ∈ V := by
    intro j Y hY
    have h1 : (1 + M j) * Y * (1 + -M j) ∈ V := by
      have := had [(j, 1)] Y hY
      simpa [hf, hng] using this
    have h2 : (1 + -M j) * Y * (1 + M j) ∈ V := by
      have := had [(j, -1)] Y hY
      simpa [hf, hng] using this
    have h2' : (1 + M j) * Y * (1 + -M j) - (1 + -M j) * Y * (1 + M j)
        = (2 : ℚ_[ℓ]) • (M j * Y - Y * M j) := by
      rw [two_smul]; noncomm_ring
    have key : M j * Y - Y * M j = (2 : ℚ_[ℓ])⁻¹ •
        ((1 + M j) * Y * (1 + -M j) - (1 + -M j) * Y * (1 + M j)) := by
      rw [h2', smul_smul, inv_mul_cancel₀ two_ne_zero, one_smul]
    rw [key]
    exact V.smul_mem _ (V.sub_mem h1 h2)

  have hbr : ∀ (L : List (Fin k × ℤ)) (i : Fin k), ∀ Y ∈ V,
      ((L.map f).prod * M i * ((L.map ng).reverse.map f).prod) * Y -
        Y * ((L.map f).prod * M i * ((L.map ng).reverse.map f).prod) ∈ V := by
    intro L i Y hY
    have hgg : (L.map f).prod * ((L.map ng).reverse.map f).prod = 1 := hinv L
    have hY' : ((L.map ng).reverse.map f).prod * Y * (L.map f).prod ∈ V := by
      have := had ((L.map ng).reverse) Y hY
      rwa [hng2 L] at this
    have hD := had L _ (hgen i _ hY')
    generalize (L.map f).prod = g at hgg hD ⊢
    generalize ((L.map ng).reverse.map f).prod = g' at hgg hD ⊢
    have e : g * (M i * (g' * Y * g) - g' * Y * g * M i) * g'
        = g * M i * g' * Y - Y * (g * M i * g') := by
      calc g * (M i * (g' * Y * g) - g' * Y * g * M i) * g'
          = g * M i * g' * Y * (g * g') - (g * g') * Y * (g * M i * g') := by noncomm_ring
        _ = _ := by rw [hgg, mul_one, one_mul]
    rw [← e]
    exact hD

  have hclosed : ∀ A ∈ V, ∀ B ∈ V, A * B - B * A ∈ V := by
    intro A hA B hB
    rw [hV] at hA
    induction hA using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨⟨L, i⟩, rfl⟩ := hx
      exact hbr L i B hB
    | zero => simp
    | add x y _ _ hx hy =>
      have e : (x + y) * B - B * (x + y) = (x * B - B * x) + (y * B - B * y) := by noncomm_ring
      rw [e]
      exact V.add_mem hx hy
    | smul c x _ hx =>
      have e : (c • x) * B - B * (c • x) = c • (x * B - B * x) := by
        rw [smul_sub, smul_mul_assoc, mul_smul_comm]
      rw [e]
      exact V.smul_mem c hx
  have hM : ∀ i, M i ∈ V := by
    intro i
    have := hgenV [] i
    simpa using this
  rw [← hV]
  exact hLie V hM hclosed X hX hXB

theorem wc_spb_finite_family (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (J : Matrix (Fin r) (Fin r) ℚ_[ℓ]) {ι : Type} (σ : ι → Matrix (Fin r) (Fin r) ℚ_[ℓ])
    (B : Submodule ℚ_[ℓ] (Matrix (Fin r) (Fin r) ℚ_[ℓ]))
    (hspan : ∀ X : Matrix (Fin r) (Fin r) ℚ_[ℓ], X.transpose * J + J * X = 0 → X ∈ B →
      X ∈ Submodule.span ℚ_[ℓ] (Set.range σ)) :
    ∃ (n : ℕ) (j : Fin n → ι) (c : Fin n → ℚ_[ℓ]) (u v : Fin n → Fin r),
      ∀ X : Matrix (Fin r) (Fin r) ℚ_[ℓ], X.transpose * J + J * X = 0 → X ∈ B →
        X = ∑ q, (c q * X (u q) (v q)) • σ (j q) :=
by
  classical
  let P : Submodule ℚ_[ℓ] (Matrix (Fin r) (Fin r) ℚ_[ℓ]) :=
    { carrier := {X | X.transpose * J + J * X = 0}
      add_mem' := by
        intro X Y hX hY
        simp only [Set.mem_setOf_eq] at hX hY ⊢
        rw [Matrix.transpose_add, Matrix.add_mul, Matrix.mul_add]
        calc X.transpose * J + Y.transpose * J + (J * X + J * Y)
            = (X.transpose * J + J * X) + (Y.transpose * J + J * Y) := by abel
          _ = 0 := by rw [hX, hY, add_zero]
      zero_mem' := by simp
      smul_mem' := by
        intro c X hX
        simp only [Set.mem_setOf_eq] at hX ⊢
        rw [Matrix.transpose_smul, Matrix.smul_mul, Matrix.mul_smul, ← smul_add, hX, smul_zero] }
  have hmemP : ∀ X : Matrix (Fin r) (Fin r) ℚ_[ℓ], X ∈ P ↔ X.transpose * J + J * X = 0 :=
    fun X => Iff.rfl
  let p := B ⊓ P
  have s1 : ∃ G : Fin r → Fin r → Matrix (Fin r) (Fin r) ℚ_[ℓ], (∀ a b, G a b ∈ p) ∧
      ∀ X ∈ p, X = ∑ a, ∑ b, X a b • G a b := by
    obtain ⟨pr, hpr⟩ := LinearMap.exists_leftInverse_of_injective p.subtype (Submodule.ker_subtype p)
    have hprx : ∀ x : p, pr (x : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = x := fun x => by
      have := LinearMap.congr_fun hpr x
      simpa using this
    refine ⟨fun a b => ((pr (Matrix.single a b (1 : ℚ_[ℓ])) : p) : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      fun a b => (pr _).2, ?_⟩
    intro X hX
    have hc : X = ∑ a, ∑ b, X a b • Matrix.single a b (1 : ℚ_[ℓ]) := by
      conv_lhs => rw [Matrix.matrix_eq_sum_single X]
      refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => ?_))
      rw [Matrix.smul_single, smul_eq_mul, mul_one]
    calc X = ((pr X : p) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) :=
          (congrArg Subtype.val (hprx ⟨X, hX⟩)).symm
      _ = ((pr (∑ a, ∑ b, X a b • Matrix.single a b (1 : ℚ_[ℓ])) : p) :
            Matrix (Fin r) (Fin r) ℚ_[ℓ]) :=
          congrArg (fun Y => ((pr Y : p) : Matrix (Fin r) (Fin r) ℚ_[ℓ])) hc
      _ = _ := by
          simp only [map_sum, map_smul, Submodule.coe_sum, Submodule.coe_smul]
  obtain ⟨G, hGp, hrep1⟩ := s1
  have hG : ∀ a b, G a b ∈ Submodule.span ℚ_[ℓ] (Set.range σ) := by
    intro a b
    have h := Submodule.mem_inf.mp (hGp a b)
    exact hspan _ ((hmemP _).mp h.2) h.1
  choose m f g hfg using fun a b => Submodule.mem_span_set'.mp (hG a b)
  choose jj hjj using fun a b i => Set.mem_range.mp (g a b i).2
  let S := Σ w : Fin r × Fin r, Fin (m w.1 w.2)
  let e := Fintype.equivFin S
  refine ⟨Fintype.card S, fun q => jj (e.symm q).1.1 (e.symm q).1.2 (e.symm q).2,
    fun q => f (e.symm q).1.1 (e.symm q).1.2 (e.symm q).2,
    fun q => (e.symm q).1.1, fun q => (e.symm q).1.2, ?_⟩
  intro X hX hXB
  have hXp : X ∈ p := Submodule.mem_inf.mpr ⟨hXB, (hmemP X).mpr hX⟩
  refine (hrep1 X hXp).trans ?_
  let F : S → Matrix (Fin r) (Fin r) ℚ_[ℓ] := fun s =>
    (f s.1.1 s.1.2 s.2 * X s.1.1 s.1.2) • σ (jj s.1.1 s.1.2 s.2)
  have h1 : (∑ q : Fin (Fintype.card S), (f (e.symm q).1.1 (e.symm q).1.2 (e.symm q).2 *
      X (e.symm q).1.1 (e.symm q).1.2) • σ (jj (e.symm q).1.1 (e.symm q).1.2 (e.symm q).2)) =
      ∑ s : S, F s := Equiv.sum_comp e.symm F
  rw [h1, Fintype.sum_sigma, Fintype.sum_prod_type]
  refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => ?_))
  rw [← hfg a b, Finset.smul_sum]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [← hjj a b i, smul_smul, mul_comm (X a b)]

theorem wc_spb_newton_step (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r k : ℕ)
    (J : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (hJ : J.transpose = -J) (hJdet : IsUnit J.det)
    (M : Fin k → Matrix (Fin r) (Fin r) ℚ_[ℓ])
    (B : Submodule ℚ_[ℓ] (Matrix (Fin r) (Fin r) ℚ_[ℓ]))
    (hB1 : (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) ∈ B)
    (hBadj : ∀ Z ∈ B, J⁻¹ * Z.transpose * J ∈ B)
    (n : ℕ) (Y : Fin n → Matrix (Fin r) (Fin r) ℚ_[ℓ])
    (c : Fin n → ℚ_[ℓ]) (u v : Fin n → Fin r)
    (hfam : ∀ X : Matrix (Fin r) (Fin r) ℚ_[ℓ], X.transpose * J + J * X = 0 → X ∈ B →
      X = ∑ q, (c q * X (u q) (v q)) • Y q)
    (hreal : ∀ (q₀ : Fin n) (m : ℤ), ∃ L : List (Fin k × ℤ),
      (L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod = 1 + ((m : ℤ) : ℚ_[ℓ]) • Y q₀) :
    ∃ κ : ℕ, ∀ e : ℕ, 4 * κ + 1 ≤ e → ∀ s : Matrix (Fin r) (Fin r) ℚ_[ℓ],
      s.transpose * J * s = J → s ∈ B →
      (∀ a b, ‖(s - 1) a b‖ ≤ (ℓ : ℝ) ^ (-(e : ℤ))) →
      ∃ L : List (Fin k × ℤ),
        (∀ a b, ‖(L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod a b‖ ≤ 1) ∧
        ∀ a b, ‖((L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod - s) a b‖ ≤
          (ℓ : ℝ) ^ (4 * (κ : ℤ) - 2 * (e : ℤ)) :=
by
  classical

  obtain ⟨K, hK⟩ : ∃ K : Matrix (Fin r) (Fin r) ℚ_[ℓ], K = J⁻¹ := ⟨_, rfl⟩
  have hJK : J * K = 1 := by rw [hK]; exact Matrix.mul_nonsing_inv J hJdet
  have hKJ : K * J = 1 := by rw [hK]; exact Matrix.nonsing_inv_mul J hJdet
  rw [← hK] at hBadj
  have hKtJ : K.transpose * J = -1 := by
    have h := congrArg Matrix.transpose hJK
    rw [Matrix.transpose_mul, Matrix.transpose_one, hJ, Matrix.mul_neg] at h
    exact neg_eq_iff_eq_neg.mp h

  have hℓ1 : (1 : ℝ) < ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt
  have hℓ0 : (0 : ℝ) < ℓ := by linarith
  have hℓne : (ℓ : ℝ) ≠ 0 := hℓ0.ne'
  have hpos : ∀ x : ℤ, (0 : ℝ) ≤ (ℓ : ℝ) ^ x := fun x => (zpow_pos hℓ0 x).le
  have hmono : ∀ x y : ℤ, x ≤ y → (ℓ : ℝ) ^ x ≤ (ℓ : ℝ) ^ y :=
    fun x y h => zpow_le_zpow_right₀ hℓ1.le h

  have bd_mono : ∀ (A : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (x y : ℤ), x ≤ y →
      (∀ a b, ‖A a b‖ ≤ (ℓ : ℝ) ^ x) → ∀ a b, ‖A a b‖ ≤ (ℓ : ℝ) ^ y :=
    fun A x y h hA a b => (hA a b).trans (hmono x y h)
  have bd_add : ∀ (A A' : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (z : ℤ),
      (∀ a b, ‖A a b‖ ≤ (ℓ : ℝ) ^ z) → (∀ a b, ‖A' a b‖ ≤ (ℓ : ℝ) ^ z) →
      ∀ a b, ‖(A + A') a b‖ ≤ (ℓ : ℝ) ^ z := by
    intro A A' z hA hA' a b
    rw [Matrix.add_apply]
    exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le (hA a b) (hA' a b))
  have bd_neg : ∀ (A : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (z : ℤ),
      (∀ a b, ‖A a b‖ ≤ (ℓ : ℝ) ^ z) → ∀ a b, ‖(-A) a b‖ ≤ (ℓ : ℝ) ^ z := by
    intro A z hA a b
    rw [Matrix.neg_apply, norm_neg]
    exact hA a b
  have bd_sub : ∀ (A A' : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (z : ℤ),
      (∀ a b, ‖A a b‖ ≤ (ℓ : ℝ) ^ z) → (∀ a b, ‖A' a b‖ ≤ (ℓ : ℝ) ^ z) →
      ∀ a b, ‖(A - A') a b‖ ≤ (ℓ : ℝ) ^ z := by
    intro A A' z hA hA'
    rw [sub_eq_add_neg]
    exact bd_add A (-A') z hA (bd_neg A' z hA')
  have bd_mul : ∀ (A A' : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (x y : ℤ),
      (∀ a b, ‖A a b‖ ≤ (ℓ : ℝ) ^ x) → (∀ a b, ‖A' a b‖ ≤ (ℓ : ℝ) ^ y) →
      ∀ a b, ‖(A * A') a b‖ ≤ (ℓ : ℝ) ^ (x + y) := by
    intro A A' x y hA hA' a b
    rw [Matrix.mul_apply, zpow_add₀ hℓne]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (mul_nonneg (hpos x) (hpos y))
    intro i _
    rw [norm_mul]
    exact mul_le_mul (hA a i) (hA' i b) (norm_nonneg _) (hpos x)
  have bd_smul : ∀ (γ : ℚ_[ℓ]) (A : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (x y : ℤ),
      ‖γ‖ ≤ (ℓ : ℝ) ^ x → (∀ a b, ‖A a b‖ ≤ (ℓ : ℝ) ^ y) →
      ∀ a b, ‖(γ • A) a b‖ ≤ (ℓ : ℝ) ^ (x + y) := by
    intro γ A x y hγ hA a b
    rw [Matrix.smul_apply, smul_eq_mul, norm_mul, zpow_add₀ hℓne]
    exact mul_le_mul hγ (hA a b) (norm_nonneg _) (hpos x)
  have bd_sum : ∀ (N : ℕ) (F : Fin N → Matrix (Fin r) (Fin r) ℚ_[ℓ]) (z : ℤ),
      (∀ q a b, ‖F q a b‖ ≤ (ℓ : ℝ) ^ z) → ∀ a b, ‖(∑ q, F q) a b‖ ≤ (ℓ : ℝ) ^ z := by
    intro N F z hF a b
    rw [Matrix.sum_apply]
    exact IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (hpos z) (fun q _ => hF q a b)
  have bd_one : ∀ a b, ‖(1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (0 : ℤ) := by
    intro a b
    rw [zpow_zero, Matrix.one_apply]
    split_ifs <;> simp

  have prod_est : ∀ (N : ℕ) (A : Fin N → Matrix (Fin r) (Fin r) ℚ_[ℓ]) (t : ℤ), t ≤ 0 →
      (∀ q a b, ‖A q a b‖ ≤ (ℓ : ℝ) ^ t) →
      (∀ a b, ‖((List.ofFn (fun q => 1 + A q)).prod - 1 - ∑ q, A q) a b‖ ≤
        (ℓ : ℝ) ^ (t + t)) ∧
      (∀ a b, ‖((List.ofFn (fun q => 1 + A q)).prod - 1) a b‖ ≤ (ℓ : ℝ) ^ t) := by
    intro N
    induction N with
    | zero =>
      intro A t _ _
      constructor <;> intro a b <;>
        simp only [List.ofFn_zero, List.prod_nil, Finset.univ_eq_empty, Finset.sum_empty,
          sub_self, Matrix.zero_apply, norm_zero] <;> exact hpos _
    | succ N ih =>
      intro A t ht hA
      have hih : (∀ a b, ‖((List.ofFn (fun q : Fin N => 1 + A q.succ)).prod - 1 -
            ∑ q : Fin N, A q.succ) a b‖ ≤ (ℓ : ℝ) ^ (t + t)) ∧
          (∀ a b, ‖((List.ofFn (fun q : Fin N => 1 + A q.succ)).prod - 1) a b‖ ≤
            (ℓ : ℝ) ^ t) :=
        ih (fun q => A q.succ) t ht (fun q => hA q.succ)
      obtain ⟨h1, h2⟩ := hih
      have hS : ∀ a b, ‖(∑ q : Fin N, A q.succ) a b‖ ≤ (ℓ : ℝ) ^ t :=
        bd_sum N (fun q => A q.succ) t (fun q => hA q.succ)
      have hL : (List.ofFn (fun q => 1 + A q)).prod =
          (1 + A 0) * (List.ofFn (fun q : Fin N => 1 + A q.succ)).prod := by
        rw [List.ofFn_succ, List.prod_cons]
      have hSum : ∑ q, A q = A 0 + ∑ q : Fin N, A q.succ := Fin.sum_univ_succ A
      rw [hL, hSum]
      have e1 : (1 + A 0) * (List.ofFn (fun q : Fin N => 1 + A q.succ)).prod - 1 -
          (A 0 + ∑ q : Fin N, A q.succ) =
          ((List.ofFn (fun q : Fin N => 1 + A q.succ)).prod - 1 - ∑ q : Fin N, A q.succ) +
            A 0 * ((List.ofFn (fun q : Fin N => 1 + A q.succ)).prod - 1) := by noncomm_ring
      have c1 : ∀ a b, ‖((1 + A 0) * (List.ofFn (fun q : Fin N => 1 + A q.succ)).prod - 1 -
          (A 0 + ∑ q : Fin N, A q.succ)) a b‖ ≤ (ℓ : ℝ) ^ (t + t) := by
        rw [e1]
        exact bd_add _ _ _ h1 (bd_mul _ _ _ _ (hA 0) h2)
      refine ⟨c1, ?_⟩
      have e2 : (1 + A 0) * (List.ofFn (fun q : Fin N => 1 + A q.succ)).prod - 1 =
          ((1 + A 0) * (List.ofFn (fun q : Fin N => 1 + A q.succ)).prod - 1 -
            (A 0 + ∑ q : Fin N, A q.succ)) + (A 0 + ∑ q : Fin N, A q.succ) := by abel
      rw [e2]
      exact bd_add _ _ _ (bd_mono _ _ _ (by omega) c1) (bd_add _ _ _ (hA 0) hS)

  have words : ∀ (N : ℕ) (P : Fin N → Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      (∀ q, ∃ L : List (Fin k × ℤ),
        (L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod = P q) →
      ∃ L : List (Fin k × ℤ), (L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod =
        (List.ofFn P).prod := by
    intro N
    induction N with
    | zero => intro P _; exact ⟨[], by simp⟩
    | succ N ih =>
      intro P hP
      obtain ⟨L0, hL0⟩ := hP 0
      obtain ⟨L1, hL1⟩ := ih (fun i => P i.succ) (fun q => hP q.succ)
      refine ⟨L0 ++ L1, ?_⟩
      rw [List.map_append, List.prod_append, hL0, hL1, List.ofFn_succ, List.prod_cons]

  have round : ∀ x : ℚ_[ℓ], ‖x‖ ≤ 1 → ∀ N : ℕ,
      ∃ m : ℤ, ‖x - ((m : ℤ) : ℚ_[ℓ])‖ ≤ (ℓ : ℝ) ^ (-(N : ℤ)) := by
    intro x hx N
    obtain ⟨y, hy⟩ : ∃ y : ℤ_[ℓ], (y : ℚ_[ℓ]) = x := ⟨⟨x, hx⟩, rfl⟩
    refine ⟨((PadicInt.appr y N : ℕ) : ℤ), ?_⟩
    have h := (PadicInt.norm_le_pow_iff_mem_span_pow
      (y - (PadicInt.appr y N : ℤ_[ℓ])) N).mpr (PadicInt.appr_spec N y)
    rw [PadicInt.norm_def, PadicInt.coe_sub, PadicInt.coe_natCast, hy] at h
    rw [Int.cast_natCast]
    exact h

  have hentry : ∀ (A : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (a b : Fin r),
      ‖A a b‖ ≤ ∑ a', ∑ b', ‖A a' b'‖ := by
    intro A a b
    have h1 : ‖A a b‖ ≤ ∑ b', ‖A a b'‖ :=
      Finset.single_le_sum (f := fun b' => ‖A a b'‖) (fun _ _ => norm_nonneg _)
        (Finset.mem_univ b)
    have h2 : ∑ b', ‖A a b'‖ ≤ ∑ a', ∑ b', ‖A a' b'‖ :=
      Finset.single_le_sum (f := fun a' => ∑ b', ‖A a' b'‖)
        (fun _ _ => Finset.sum_nonneg (fun _ _ => norm_nonneg _)) (Finset.mem_univ a)
    linarith
  have hnn : ∀ A : Matrix (Fin r) (Fin r) ℚ_[ℓ], 0 ≤ ∑ a', ∑ b', ‖A a' b'‖ :=
    fun A => Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ => norm_nonneg _))
  obtain ⟨κ, hκ⟩ := pow_unbounded_of_one_lt
    (1 + ∑ a, ∑ b, ‖J a b‖ + ∑ a, ∑ b, ‖K a b‖ + ∑ q, ∑ a, ∑ b, ‖Y q a b‖ +
      ∑ q, ‖c q‖ + ‖(2 : ℚ_[ℓ])⁻¹‖) hℓ1
  rw [← zpow_natCast] at hκ
  have nJ := hnn J
  have nK := hnn K
  have nY : 0 ≤ ∑ q, ∑ a, ∑ b, ‖Y q a b‖ := Finset.sum_nonneg (fun q _ => hnn (Y q))
  have nc : 0 ≤ ∑ q, ‖c q‖ := Finset.sum_nonneg (fun q _ => norm_nonneg (c q))
  have n2 := norm_nonneg ((2 : ℚ_[ℓ])⁻¹)
  have hJb : ∀ a b, ‖J a b‖ ≤ (ℓ : ℝ) ^ (κ : ℤ) := fun a b => by linarith [hentry J a b]
  have hKb : ∀ a b, ‖K a b‖ ≤ (ℓ : ℝ) ^ (κ : ℤ) := fun a b => by linarith [hentry K a b]
  have hYb : ∀ q a b, ‖Y q a b‖ ≤ (ℓ : ℝ) ^ (κ : ℤ) := by
    intro q a b
    have h1 := hentry (Y q) a b
    have h2 : ∑ a', ∑ b', ‖Y q a' b'‖ ≤ ∑ q', ∑ a', ∑ b', ‖Y q' a' b'‖ :=
      Finset.single_le_sum (f := fun q' => ∑ a', ∑ b', ‖Y q' a' b'‖) (fun q' _ => hnn (Y q'))
        (Finset.mem_univ q)
    linarith
  have hcb : ∀ q, ‖c q‖ ≤ (ℓ : ℝ) ^ (κ : ℤ) := by
    intro q
    have h2 : ‖c q‖ ≤ ∑ q', ‖c q'‖ :=
      Finset.single_le_sum (f := fun q' => ‖c q'‖) (fun q' _ => norm_nonneg _)
        (Finset.mem_univ q)
    linarith
  have h2b : ‖(2 : ℚ_[ℓ])⁻¹‖ ≤ (ℓ : ℝ) ^ (κ : ℤ) := by linarith

  refine ⟨κ, ?_⟩
  intro e he s hsJ hsB hZ
  obtain ⟨Z, rfl⟩ : ∃ Z, s = 1 + Z := ⟨s - 1, by abel⟩
  simp only [add_sub_cancel_left] at hZ
  have hN : Z.transpose * J + J * Z + Z.transpose * J * Z = 0 := by
    have e : (1 + Z).transpose * J * (1 + Z) =
        J + (Z.transpose * J + J * Z + Z.transpose * J * Z) := by
      rw [Matrix.transpose_add, Matrix.transpose_one]; noncomm_ring
    rw [e] at hsJ
    exact (add_right_inj J).mp (hsJ.trans (add_zero J).symm)
  have hT : (K * Z.transpose * J).transpose = -(J * Z * K.transpose) := by
    rw [Matrix.transpose_mul, Matrix.transpose_mul, Matrix.transpose_transpose, hJ]; noncomm_ring
  have hDsp : (Z - K * Z.transpose * J).transpose * J + J * (Z - K * Z.transpose * J) = 0 := by
    rw [Matrix.transpose_sub, hT]
    calc (Z.transpose - -(J * Z * K.transpose)) * J + J * (Z - K * Z.transpose * J)
        = Z.transpose * J + J * Z * (K.transpose * J) + J * Z - (J * K) * Z.transpose * J := by
          noncomm_ring
      _ = 0 := by rw [hKtJ, hJK]; noncomm_ring
  obtain ⟨X, hX⟩ : ∃ X : Matrix (Fin r) (Fin r) ℚ_[ℓ],
      X = (2 : ℚ_[ℓ])⁻¹ • (Z - K * Z.transpose * J) := ⟨_, rfl⟩
  have hXsp : X.transpose * J + J * X = 0 := by
    rw [hX, Matrix.transpose_smul, Matrix.smul_mul, Matrix.mul_smul, ← smul_add, hDsp, smul_zero]
  have hZB : Z ∈ B := by
    have h := B.sub_mem hsB hB1
    rwa [add_sub_cancel_left] at h
  have hXB : X ∈ B := by
    rw [hX]; exact B.smul_mem _ (B.sub_mem hZB (hBadj Z hZB))
  have hKN : K * Z.transpose * J + Z + K * Z.transpose * J * Z = 0 := by
    calc K * Z.transpose * J + Z + K * Z.transpose * J * Z
        = K * (Z.transpose * J + J * Z + Z.transpose * J * Z) + (1 - K * J) * Z := by
          noncomm_ring
      _ = 0 := by rw [hN, hKJ]; noncomm_ring
  have hZX : Z - X = -((2 : ℚ_[ℓ])⁻¹ • (K * Z.transpose * J * Z)) := by
    have h2 : (1 : ℚ_[ℓ]) - 2⁻¹ - 2⁻¹ = 0 := by norm_num
    have e : Z - (2 : ℚ_[ℓ])⁻¹ • (Z - K * Z.transpose * J) -
        -((2 : ℚ_[ℓ])⁻¹ • (K * Z.transpose * J * Z)) =
        ((1 : ℚ_[ℓ]) - 2⁻¹ - 2⁻¹) • Z +
          (2 : ℚ_[ℓ])⁻¹ • (K * Z.transpose * J + Z + K * Z.transpose * J * Z) := by
      simp only [smul_add, smul_sub, sub_smul, one_smul]; abel
    rw [← sub_eq_zero, hX, e, hKN, h2, zero_smul, smul_zero, add_zero]
  have hZt : ∀ a b, ‖Z.transpose a b‖ ≤ (ℓ : ℝ) ^ (-(e : ℤ)) := fun a b => by
    rw [Matrix.transpose_apply]; exact hZ b a
  have hZXb : ∀ a b, ‖(Z - X) a b‖ ≤ (ℓ : ℝ) ^ (3 * (κ : ℤ) - 2 * (e : ℤ)) := by
    rw [hZX]
    refine bd_neg _ _ (bd_mono _ _ _ ?_ (bd_smul _ _ _ _ h2b
      (bd_mul _ _ _ _ (bd_mul _ _ _ _ (bd_mul _ _ _ _ hKb hZt) hJb) hZ)))
    omega
  have hXb : ∀ a b, ‖X a b‖ ≤ (ℓ : ℝ) ^ (-(e : ℤ)) := by
    have h := bd_sub Z (Z - X) (-(e : ℤ)) hZ (bd_mono _ _ _ (by omega) hZXb)
    rwa [sub_sub_cancel] at h

  obtain ⟨x, hxdef⟩ : ∃ x : Fin n → ℚ_[ℓ], ∀ q, x q = c q * X (u q) (v q) :=
    ⟨_, fun q => rfl⟩
  have hxb : ∀ q, ‖x q‖ ≤ (ℓ : ℝ) ^ ((κ : ℤ) + -(e : ℤ)) := by
    intro q
    rw [hxdef, norm_mul, zpow_add₀ hℓne]
    exact mul_le_mul (hcb q) (hXb _ _) (norm_nonneg _) (hpos _)
  have hx1 : ∀ q, ‖x q‖ ≤ 1 := by
    intro q
    calc ‖x q‖ ≤ (ℓ : ℝ) ^ ((κ : ℤ) + -(e : ℤ)) := hxb q
      _ ≤ (ℓ : ℝ) ^ (0 : ℤ) := hmono _ _ (by omega)
      _ = 1 := zpow_zero _
  choose m hm using fun q => round (x q) (hx1 q) (2 * e)
  have hm' : ∀ q, ‖x q - ((m q : ℤ) : ℚ_[ℓ])‖ ≤ (ℓ : ℝ) ^ (-(2 * (e : ℤ))) := by
    intro q
    have h := hm q
    push_cast at h
    exact h
  have hmb : ∀ q, ‖((m q : ℤ) : ℚ_[ℓ])‖ ≤ (ℓ : ℝ) ^ ((κ : ℤ) + -(e : ℤ)) := by
    intro q
    have e1 : ((m q : ℤ) : ℚ_[ℓ]) = x q + -(x q - ((m q : ℤ) : ℚ_[ℓ])) := by ring
    rw [e1]
    refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le (hxb q) ?_)
    rw [norm_neg]
    exact (hm' q).trans (hmono _ _ (by omega))
  obtain ⟨A, hAdef⟩ : ∃ A : Fin n → Matrix (Fin r) (Fin r) ℚ_[ℓ],
      ∀ q, A q = ((m q : ℤ) : ℚ_[ℓ]) • Y q := ⟨_, fun q => rfl⟩
  have hAb : ∀ q a b, ‖A q a b‖ ≤ (ℓ : ℝ) ^ (((κ : ℤ) + -(e : ℤ)) + κ) := by
    intro q
    rw [hAdef]
    exact bd_smul _ _ _ _ (hmb q) (hYb q)
  obtain ⟨P1, P2⟩ := prod_est n A _ (by omega) hAb
  have hXsum : X = ∑ q, x q • Y q := by
    calc X = ∑ q, (c q * X (u q) (v q)) • Y q := hfam X hXsp hXB
      _ = ∑ q, x q • Y q := by simp only [hxdef]
  have hsumA : ∑ q, A q = X + ∑ q, (((m q : ℤ) : ℚ_[ℓ]) - x q) • Y q := by
    rw [hXsum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    rw [hAdef, ← add_smul]
    congr 1
    ring
  have hEb : ∀ a b, ‖(∑ q, (((m q : ℤ) : ℚ_[ℓ]) - x q) • Y q) a b‖ ≤
      (ℓ : ℝ) ^ (-(2 * (e : ℤ)) + κ) :=
    bd_sum n _ _ (fun q => bd_smul _ _ _ _ (by rw [norm_sub_rev]; exact hm' q) (hYb q))

  obtain ⟨L, hL⟩ := words n (fun q => 1 + A q) (fun q => by
    obtain ⟨L, hL⟩ := hreal q (m q)
    exact ⟨L, by rw [hL, hAdef]⟩)
  refine ⟨L, ?_, ?_⟩
  · rw [hL]
    intro a b
    have e2 : (List.ofFn (fun q => 1 + A q)).prod =
        1 + ((List.ofFn (fun q => 1 + A q)).prod - 1) := by abel
    rw [e2]
    calc _ ≤ (ℓ : ℝ) ^ (0 : ℤ) := bd_add _ _ _ bd_one (bd_mono _ _ _ (by omega) P2) a b
      _ = 1 := zpow_zero _
  · rw [hL]
    have efin : (List.ofFn (fun q => 1 + A q)).prod - (1 + Z) =
        ((List.ofFn (fun q => 1 + A q)).prod - 1 - ∑ q, A q) +
          (∑ q, (((m q : ℤ) : ℚ_[ℓ]) - x q) • Y q) - (Z - X) := by
      rw [hsumA]; abel
    rw [efin]
    exact bd_sub _ _ _ (bd_add _ _ _ (bd_mono _ _ _ (by omega) P1) (bd_mono _ _ _ (by omega) hEb))
      (bd_mono _ _ _ (by omega) hZXb)

theorem wc_spb_newton_iteration (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r k : ℕ)
    (J : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (hJdet : IsUnit J.det)
    (M : Fin k → Matrix (Fin r) (Fin r) ℚ_[ℓ])
    (B : Submodule ℚ_[ℓ] (Matrix (Fin r) (Fin r) ℚ_[ℓ]))
    (hBmul : ∀ X ∈ B, ∀ Y ∈ B, X * Y ∈ B)
    (hBadj : ∀ Z ∈ B, J⁻¹ * Z.transpose * J ∈ B)
    (hWB : ∀ L : List (Fin k × ℤ), (L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod ∈ B)
    (κ κ₂ : ℕ)
    (hJb : ∀ a b, ‖J a b‖ ≤ (ℓ : ℝ) ^ (κ₂ : ℤ)) (hKb : ∀ a b, ‖J⁻¹ a b‖ ≤ (ℓ : ℝ) ^ (κ₂ : ℤ))
    (hsympW : ∀ L : List (Fin k × ℤ),
      ((L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod).transpose * J *
        (L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod = J)
    (hstep : ∀ e : ℕ, 4 * κ + 1 ≤ e → ∀ s : Matrix (Fin r) (Fin r) ℚ_[ℓ],
      s.transpose * J * s = J → s ∈ B →
      (∀ a b, ‖(s - 1) a b‖ ≤ (ℓ : ℝ) ^ (-(e : ℤ))) →
      ∃ L : List (Fin k × ℤ),
        (∀ a b, ‖(L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod a b‖ ≤ 1) ∧
        ∀ a b, ‖((L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod - s) a b‖ ≤
          (ℓ : ℝ) ^ (4 * (κ : ℤ) - 2 * (e : ℤ))) :
    ∀ T e : ℕ, 4 * κ + 2 * κ₂ + 1 ≤ e → ∀ s : Matrix (Fin r) (Fin r) ℚ_[ℓ],
      s.transpose * J * s = J → s ∈ B →
      (∀ a b, ‖(s - 1) a b‖ ≤ (ℓ : ℝ) ^ (-(e : ℤ))) →
      ∃ L : List (Fin k × ℤ), ∀ a b,
        ‖((L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod - s) a b‖ ≤
          (ℓ : ℝ) ^ (-((e + T : ℕ) : ℤ)) :=
by
  classical
  have hℓpos : (0 : ℝ) < ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).pos
  have hℓ1 : (1 : ℝ) ≤ ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt.le
  have hz : ∀ z : ℤ, (0 : ℝ) ≤ (ℓ : ℝ) ^ z := fun z => (zpow_pos hℓpos z).le
  have mulb : ∀ (A C : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (x y : ℝ), 0 ≤ x → 0 ≤ y →
      (∀ a b, ‖A a b‖ ≤ x) → (∀ a b, ‖C a b‖ ≤ y) → ∀ a b, ‖(A * C) a b‖ ≤ x * y := by
    intro A C x y hx hy hA hC a b
    rw [Matrix.mul_apply]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (mul_nonneg hx hy)
    intro i _
    rw [norm_mul]
    exact mul_le_mul (hA a i) (hC i b) (norm_nonneg _) hx
  intro T
  induction T with
  | zero =>
    intro e he s hs hsB hs1
    refine ⟨[], fun a b => ?_⟩
    rw [List.map_nil, List.prod_nil, Nat.add_zero, Matrix.sub_apply, norm_sub_rev,
      ← Matrix.sub_apply]
    exact hs1 a b
  | succ T ih =>
    intro e he s hs hsB hs1
    obtain ⟨L₁, hL₁b, hL₁s⟩ := hstep e (by omega) s hs hsB hs1
    have hWs := hsympW L₁
    have hWBm := hWB L₁
    set W := (L₁.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod with hWdef
    have hVW : (J⁻¹ * W.transpose * J) * W = 1 := by
      rw [Matrix.mul_assoc, Matrix.mul_assoc, ← Matrix.mul_assoc W.transpose, hWs,
        Matrix.nonsing_inv_mul J hJdet]
    have hWV : W * (J⁻¹ * W.transpose * J) = 1 := mul_eq_one_comm.mp hVW
    set V := J⁻¹ * W.transpose * J with hVdef
    have hVsymp : V.transpose * J * V = J := by
      calc V.transpose * J * V = V.transpose * (W.transpose * J * W) * V := by rw [hWs]
        _ = (W * V).transpose * J * (W * V) := by
          rw [Matrix.transpose_mul W V]; simp only [Matrix.mul_assoc]
        _ = J := by rw [hWV]; simp
    have hVB : V ∈ B := hBadj W hWBm
    have hs'symp : (V * s).transpose * J * (V * s) = J := by
      calc (V * s).transpose * J * (V * s) = s.transpose * (V.transpose * J * V) * s := by
            rw [Matrix.transpose_mul V s]; simp only [Matrix.mul_assoc]
        _ = J := by rw [hVsymp, hs]
    have hs'B : V * s ∈ B := hBmul V hVB s hsB
    have hWs' : W * (V * s) = s := by rw [← Matrix.mul_assoc, hWV, Matrix.one_mul]
    have hs'1 : V * s - 1 = V * (s - W) := by rw [Matrix.mul_sub, hVW]
    have hWT : ∀ a b, ‖W.transpose a b‖ ≤ 1 := fun a b => by
      rw [Matrix.transpose_apply]; exact hL₁b b a
    have hsW : ∀ a b, ‖(s - W) a b‖ ≤ (ℓ : ℝ) ^ (4 * (κ : ℤ) - 2 * (e : ℤ)) := fun a b => by
      rw [Matrix.sub_apply, norm_sub_rev, ← Matrix.sub_apply]; exact hL₁s a b
    have hb1 := mulb J⁻¹ W.transpose ((ℓ : ℝ) ^ (κ₂ : ℤ)) 1 (hz _) zero_le_one hKb hWT
    have hb2 := mulb (J⁻¹ * W.transpose) J ((ℓ : ℝ) ^ (κ₂ : ℤ) * 1) ((ℓ : ℝ) ^ (κ₂ : ℤ))
      (mul_nonneg (hz _) zero_le_one) (hz _) hb1 hJb
    have hb3 := mulb (J⁻¹ * W.transpose * J) (s - W)
      ((ℓ : ℝ) ^ (κ₂ : ℤ) * 1 * (ℓ : ℝ) ^ (κ₂ : ℤ)) ((ℓ : ℝ) ^ (4 * (κ : ℤ) - 2 * (e : ℤ)))
      (mul_nonneg (mul_nonneg (hz _) zero_le_one) (hz _)) (hz _) hb2 hsW
    have hexp : (ℓ : ℝ) ^ (κ₂ : ℤ) * 1 * (ℓ : ℝ) ^ (κ₂ : ℤ) *
        (ℓ : ℝ) ^ (4 * (κ : ℤ) - 2 * (e : ℤ)) ≤ (ℓ : ℝ) ^ (-((e + 1 : ℕ) : ℤ)) := by
      rw [mul_one, ← zpow_add₀ hℓpos.ne', ← zpow_add₀ hℓpos.ne']
      apply zpow_le_zpow_right₀ hℓ1
      push_cast
      omega
    have hs'b : ∀ a b, ‖(V * s - 1) a b‖ ≤ (ℓ : ℝ) ^ (-((e + 1 : ℕ) : ℤ)) := fun a b => by
      rw [hs'1]; exact (hb3 a b).trans hexp
    obtain ⟨L₂, hL₂⟩ := ih (e + 1) (by omega) (V * s) hs'symp hs'B hs'b
    refine ⟨L₁ ++ L₂, fun a b => ?_⟩
    rw [List.map_append, List.prod_append, ← hWdef]
    have h := mulb W _ 1 _ zero_le_one (hz _) hL₁b hL₂ a b
    rw [one_mul, Matrix.mul_sub, hWs'] at h
    have he' : e + 1 + T = e + (T + 1) := by omega
    rw [he'] at h
    exact h

theorem wc_sp_block_congruence_integer_words (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r k p : ℕ)
    (J : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (hJ : J.transpose = -J) (hJdet : IsUnit J.det)
    (δ : Fin k → Fin r → ℚ_[ℓ]) (β : Fin k → Fin p)
    (hspan : Submodule.span ℚ_[ℓ] (Set.range δ) = ⊤)
    (horth : ∀ i j, β i ≠ β j → ∑ a, δ i a * J.mulVec (δ j) a = 0)
    (ε : Fin k → ℚ_[ℓ]) (M : Fin k → Matrix (Fin r) (Fin r) ℚ_[ℓ])
    (hM : ∀ i, M i = ε i • Matrix.vecMulVec (δ i) (Matrix.vecMul (δ i) J))
    (hLie : ∀ V : Submodule ℚ_[ℓ] (Matrix (Fin r) (Fin r) ℚ_[ℓ]), (∀ i, M i ∈ V) →
      (∀ A ∈ V, ∀ B ∈ V, A * B - B * A ∈ V) →
      ∀ X : Matrix (Fin r) (Fin r) ℚ_[ℓ], X.transpose * J + J * X = 0 →
        (∀ i, X.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})) → X ∈ V) :
    ∃ m₀ : ℕ, ∀ s : Matrix (Fin r) (Fin r) ℚ_[ℓ], s.transpose * J * s = J →
      (∀ i, s.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})) →
      (∀ a b, ‖s a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(m₀ : ℤ))) →
      ∀ t : ℕ, ∃ L : List (Fin k × ℤ), ∀ a b,
        ‖(L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod a b - s a b‖ ≤
          (ℓ : ℝ) ^ (-(t : ℤ)) :=
by
  classical

  have hJe : ∀ a e, J a e = - J e a := by
    intro a e
    have := congrFun (congrFun hJ e) a
    simp only [Matrix.transpose_apply, Matrix.neg_apply] at this
    exact this
  have hMe : ∀ i a b, M i a b = ε i * (δ i a * Matrix.vecMul (δ i) J b) := by
    intro i a b
    rw [hM i, Matrix.smul_apply, Matrix.vecMulVec_apply, smul_eq_mul]
  have hsq : ∀ i, M i * M i = 0 := by
    intro i
    have h0 : ∑ e, Matrix.vecMul (δ i) J e * δ i e = 0 := by
      have hS : ∑ e, Matrix.vecMul (δ i) J e * δ i e = ∑ e, ∑ a, δ i a * J a e * δ i e := by
        apply Finset.sum_congr rfl
        intro e _
        show (∑ a, δ i a * J a e) * δ i e = _
        rw [Finset.sum_mul]
      have hS2 : ∑ e, ∑ a, δ i a * J a e * δ i e = -∑ e, ∑ a, δ i a * J a e * δ i e := by
        conv_lhs => rw [Finset.sum_comm]
        rw [← Finset.sum_neg_distrib]
        apply Finset.sum_congr rfl
        intro e _
        rw [← Finset.sum_neg_distrib]
        apply Finset.sum_congr rfl
        intro a _
        rw [hJe]
        ring
      rw [hS]
      have h2 : (2 : ℚ_[ℓ]) * ∑ e, ∑ a, δ i a * J a e * δ i e = 0 := by
        linear_combination hS2
      exact (mul_eq_zero.mp h2).resolve_left two_ne_zero
    ext a b
    rw [Matrix.mul_apply, Matrix.zero_apply]
    have e1 : ∀ e, M i a e * M i e b = (ε i * ε i * δ i a * Matrix.vecMul (δ i) J b) *
        (Matrix.vecMul (δ i) J e * δ i e) := by
      intro e
      rw [hMe, hMe]
      ring
    rw [Finset.sum_congr rfl (fun e _ => e1 e), ← Finset.mul_sum, h0, mul_zero]
  have hsp : ∀ i, (M i).transpose * J + J * M i = 0 := by
    intro i
    ext a b
    have hw : ∀ c, Matrix.vecMul (δ i) J c = ∑ e, δ i e * J e c := fun c => rfl
    have h1 : ∑ e, J a e * δ i e = - Matrix.vecMul (δ i) J a := by
      rw [hw, ← Finset.sum_neg_distrib]
      apply Finset.sum_congr rfl
      intro e _
      rw [hJe a e]
      ring
    rw [Matrix.add_apply, Matrix.mul_apply, Matrix.mul_apply, Matrix.zero_apply]
    simp only [Matrix.transpose_apply, hMe]
    have e1 : ∑ x, ε i * (δ i x * Matrix.vecMul (δ i) J a) * J x b =
        ε i * Matrix.vecMul (δ i) J a * Matrix.vecMul (δ i) J b := by
      rw [hw b, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro e _
      ring
    have e2 : ∑ x, J a x * (ε i * (δ i x * Matrix.vecMul (δ i) J b)) =
        ε i * Matrix.vecMul (δ i) J b * ∑ e, J a e * δ i e := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro e _
      ring
    rw [e1, e2, h1]
    ring

  have hsmP : ∀ i (c : ℚ_[ℓ]), (c • M i).transpose * J + J * (c • M i) = 0 ∧
      (c • M i) * (c • M i) = 0 := by
    intro i c
    refine ⟨?_, ?_⟩
    · rw [Matrix.transpose_smul, Matrix.smul_mul, Matrix.mul_smul, ← smul_add, hsp i, smul_zero]
    · rw [Matrix.smul_mul, Matrix.mul_smul, hsq i, smul_zero, smul_zero]
  have keyS : ∀ P : Matrix (Fin r) (Fin r) ℚ_[ℓ], P.transpose * J + J * P = 0 → P * P = 0 →
      (1 + P).transpose * J * (1 + P) = J := by
    intro P h1 h2
    have h3 : P.transpose * J = -(J * P) := eq_neg_of_add_eq_zero_left h1
    have h4 : P.transpose * J * P = 0 := by
      rw [h3, neg_mul, Matrix.mul_assoc, h2, Matrix.mul_zero, neg_zero]
    rw [Matrix.transpose_add, Matrix.transpose_one]
    calc (1 + P.transpose) * J * (1 + P)
        = J + (P.transpose * J + J * P) + P.transpose * J * P := by noncomm_ring
      _ = J := by rw [h1, h4, add_zero, add_zero]
  have keyI : ∀ (A B P : Matrix (Fin r) (Fin r) ℚ_[ℓ]), A * B = 1 → P * P = 0 →
      (1 + P) * A * (B * (1 + -P)) = 1 := by
    intro A B P hAB hP
    calc (1 + P) * A * (B * (1 + -P)) = (1 + P) * (A * B) * (1 + -P) := by
          simp only [Matrix.mul_assoc]
      _ = 1 - P * P := by rw [hAB]; noncomm_ring
      _ = 1 := by rw [hP, sub_zero]
  have hinv : ∀ L : List (Fin k × ℤ),
      (L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod *
        (((L.map (fun q => (q.1, -q.2))).reverse).map
          (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod = 1 := by
    intro L
    induction L with
    | nil => simp
    | cons q L ih =>
      simp only [List.map_cons, List.reverse_cons, List.map_append, List.prod_cons,
        List.prod_append, List.map_nil, List.prod_nil, mul_one, Int.cast_neg, neg_smul]
      exact keyI _ _ _ ih (hsmP q.1 _).2
  have hsympW : ∀ L : List (Fin k × ℤ),
      ((L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod).transpose * J *
        (L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod = J := by
    intro L
    induction L with
    | nil => simp
    | cons q L ih =>
      rw [List.map_cons, List.prod_cons, Matrix.transpose_mul]
      have hA := keyS _ (hsmP q.1 ((q.2 : ℤ) : ℚ_[ℓ])).1 (hsmP q.1 ((q.2 : ℤ) : ℚ_[ℓ])).2
      calc ((L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod).transpose *
            (1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1).transpose * J *
            ((1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1) * (L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod)
          = ((L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod).transpose *
            ((1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1).transpose * J * (1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)) *
            (L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod := by
            simp only [Matrix.mul_assoc]
        _ = J := by rw [hA, ih]

  let B : Submodule ℚ_[ℓ] (Matrix (Fin r) (Fin r) ℚ_[ℓ]) :=
    { carrier := {X | ∀ i, X.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})}
      add_mem' := fun {X Y} hX hY i => by
        rw [Matrix.add_mulVec]
        exact Submodule.add_mem _ (hX i) (hY i)
      zero_mem' := fun i => by
        rw [Matrix.zero_mulVec]
        exact Submodule.zero_mem _
      smul_mem' := fun c X hX i => by
        rw [Matrix.smul_mulVec]
        exact Submodule.smul_mem _ c (hX i) }
  have hBmem : ∀ X, X ∈ B ↔
      ∀ i, X.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i}) := fun X => Iff.rfl
  have hB1 : (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) ∈ B := by
    rw [hBmem]
    intro i
    rw [Matrix.one_mulVec]
    exact Submodule.subset_span ⟨i, (show β i = β i from rfl), rfl⟩
  have hBmul : ∀ X ∈ B, ∀ Y ∈ B, X * Y ∈ B := by
    intro X hX Y hY
    rw [hBmem] at hX hY ⊢
    intro i
    have hle : Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i}) ≤
        (Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})).comap (Matrix.toLin' X) := by
      rw [Submodule.span_le]
      rintro _ ⟨j, hj, rfl⟩
      have hj' : β j = β i := hj
      have hset : {j' | β j' = β j} = {j' | β j' = β i} := by
        ext j'
        simp only [Set.mem_setOf_eq]
        rw [hj']
      show Matrix.toLin' X (δ j) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})
      rw [Matrix.toLin'_apply, ← hset]
      exact hX j
    rw [← Matrix.mulVec_mulVec]
    have h := hle (hY i)
    rw [Submodule.mem_comap, Matrix.toLin'_apply] at h
    exact h
  have hBM : ∀ i, M i ∈ B := by
    intro i
    rw [hBmem]
    intro j
    have hMv : (M i).mulVec (δ j) = (ε i * dotProduct (δ i) (J.mulVec (δ j))) • δ i := by
      rw [hM i, Matrix.smul_mulVec, Matrix.vecMulVec_mulVec, op_smul_eq_smul, smul_smul,
        ← Matrix.dotProduct_mulVec]
    rw [hMv]
    by_cases hij : β i = β j
    · exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, hij, rfl⟩)
    · have h0 : dotProduct (δ i) (J.mulVec (δ j)) = 0 := horth i j hij
      rw [h0, mul_zero, zero_smul]
      exact Submodule.zero_mem _
  have hBadj : ∀ Z ∈ B, J⁻¹ * Z.transpose * J ∈ B := fun Z hZ =>
    (hBmem _).2 (wc_spb_adjoint_block_preserving ℓ r k p J hJ hJdet δ β hspan horth Z
      ((hBmem Z).1 hZ))
  have hWB : ∀ L : List (Fin k × ℤ),
      (L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod ∈ B := by
    intro L
    induction L with
    | nil => rw [List.map_nil, List.prod_nil]; exact hB1
    | cons q L ih =>
      rw [List.map_cons, List.prod_cons]
      exact hBmul _ (B.add_mem hB1 (B.smul_mem _ (hBM q.1))) _ ih

  have hspanσ := wc_spb_conj_span_contains ℓ r k p J δ β M hinv hLie
  obtain ⟨n, j, c, u, v, hfam⟩ := wc_spb_finite_family ℓ r J
    (fun w : List (Fin k × ℤ) × Fin k =>
      (w.1.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod * M w.2 *
        (((w.1.map (fun q => (q.1, -q.2))).reverse).map
          (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod) B
    (fun X hX hXB => hspanσ X hX ((hBmem X).1 hXB))

  have hreal : ∀ (q₀ : Fin n) (m : ℤ), ∃ L : List (Fin k × ℤ),
      (L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod = 1 + ((m : ℤ) : ℚ_[ℓ]) •
        (((j q₀).1.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod * M (j q₀).2 *
          ((((j q₀).1.map (fun q => (q.1, -q.2))).reverse).map
            (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod) := by
    intro q₀ m
    refine ⟨(j q₀).1 ++ [((j q₀).2, m)] ++ (((j q₀).1.map (fun q => (q.1, -q.2))).reverse), ?_⟩
    rw [List.map_append, List.map_append, List.prod_append, List.prod_append]
    simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one]
    rw [Matrix.mul_add, Matrix.mul_one, Matrix.add_mul, hinv (j q₀).1, Matrix.mul_smul,
      Matrix.smul_mul]

  obtain ⟨κ, hstep⟩ := wc_spb_newton_step ℓ r k J hJ hJdet M B hB1 hBadj n
    (fun q => ((j q).1.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod * M (j q).2 *
          ((((j q).1.map (fun q => (q.1, -q.2))).reverse).map
            (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod) c u v hfam hreal

  have hℓ1 : (1 : ℝ) < ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt
  obtain ⟨κ₂, hκ₂⟩ := pow_unbounded_of_one_lt
    (1 + ∑ a, ∑ b, ‖J a b‖ + ∑ a, ∑ b, ‖J⁻¹ a b‖) hℓ1
  have hentry : ∀ (A : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (a b : Fin r),
      ‖A a b‖ ≤ ∑ a', ∑ b', ‖A a' b'‖ := by
    intro A a b
    have h1 : ‖A a b‖ ≤ ∑ b', ‖A a b'‖ :=
      Finset.single_le_sum (f := fun b' => ‖A a b'‖) (fun _ _ => norm_nonneg _)
        (Finset.mem_univ b)
    have h2 : ∑ b', ‖A a b'‖ ≤ ∑ a', ∑ b', ‖A a' b'‖ :=
      Finset.single_le_sum (f := fun a' => ∑ b', ‖A a' b'‖)
        (fun _ _ => Finset.sum_nonneg (fun _ _ => norm_nonneg _)) (Finset.mem_univ a)
    linarith
  have hnn : ∀ A : Matrix (Fin r) (Fin r) ℚ_[ℓ], 0 ≤ ∑ a', ∑ b', ‖A a' b'‖ :=
    fun A => Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ => norm_nonneg _))
  have hJb : ∀ a b, ‖J a b‖ ≤ (ℓ : ℝ) ^ (κ₂ : ℤ) := by
    intro a b
    rw [zpow_natCast]
    have := hentry J a b
    have := hnn J⁻¹
    linarith
  have hKb : ∀ a b, ‖J⁻¹ a b‖ ≤ (ℓ : ℝ) ^ (κ₂ : ℤ) := by
    intro a b
    rw [zpow_natCast]
    have := hentry J⁻¹ a b
    have := hnn J
    linarith

  have hs7 := wc_spb_newton_iteration ℓ r k J hJdet M B hBmul hBadj hWB κ κ₂ hJb hKb hsympW hstep
  refine ⟨4 * κ + 2 * κ₂ + 1, ?_⟩
  intro s hsJ hsBP hs1 t
  obtain ⟨L, hL⟩ := hs7 t (4 * κ + 2 * κ₂ + 1) le_rfl s hsJ ((hBmem s).2 hsBP)
    (fun a b => by rw [Matrix.sub_apply]; exact hs1 a b)
  refine ⟨L, fun a b => ?_⟩
  rw [← Matrix.sub_apply]
  refine (hL a b).trans ?_
  apply zpow_le_zpow_right₀ hℓ1.le
  push_cast
  omega

theorem wc_charpoly_companion_lift (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (h₁ h₂ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (hint : ∀ a b, ‖h₁ a b‖ ≤ 1)
    (hchar : h₁.charpoly = h₂.charpoly) (hsep : h₂.charpoly.Separable) :
    ∀ t : ℕ, ∃ t' : ℕ, ∀ g' : Matrix (Fin r) (Fin r) ℚ_[ℓ], (∀ a b, ‖g' a b‖ ≤ 1) →
      (∀ a b, ‖g' a b - h₁ a b‖ ≤ (ℓ : ℝ) ^ (-(t' : ℤ))) →
      ∃ g : Matrix (Fin r) (Fin r) ℚ_[ℓ],
        (∀ a b, ‖g a b - h₂ a b‖ ≤ (ℓ : ℝ) ^ (-(t : ℤ))) ∧ g.charpoly = g'.charpoly :=
by
  classical

  obtain ⟨Kry, hKry⟩ : ∃ Kry : Matrix (Fin r) (Fin r) ℚ_[ℓ] → (Fin r → ℚ_[ℓ]) →
      Matrix (Fin r) (Fin r) ℚ_[ℓ], ∀ A v a k, Kry A v a k = ((A ^ (k : ℕ)).mulVec v) a :=
    ⟨fun A v => Matrix.of fun a k => ((A ^ (k : ℕ)).mulVec v) a, fun _ _ _ _ => rfl⟩
  obtain ⟨Comp, hComp⟩ : ∃ Comp : (Fin r → ℚ_[ℓ]) → Matrix (Fin r) (Fin r) ℚ_[ℓ],
      ∀ c i j, Comp c i j = if (j : ℕ) + 1 = r then -c i
        else if (i : ℕ) = (j : ℕ) + 1 then (1 : ℚ_[ℓ]) else 0 :=
    ⟨fun c => Matrix.of fun i j => if (j : ℕ) + 1 = r then -c i
        else if (i : ℕ) = (j : ℕ) + 1 then (1 : ℚ_[ℓ]) else 0, fun _ _ _ => rfl⟩

  have hCH : ∀ A : Matrix (Fin r) (Fin r) ℚ_[ℓ],
      A ^ r + ∑ i : Fin r, A.charpoly.coeff i • A ^ (i : ℕ) = 0 := by
    intro A
    have h := Matrix.aeval_self_charpoly A
    rw [Polynomial.aeval_eq_sum_range, Matrix.charpoly_natDegree_eq_dim, Fintype.card_fin,
      Finset.sum_range_succ] at h
    have hr : A.charpoly.coeff r = 1 := by
      have := (Matrix.charpoly_monic A).coeff_natDegree
      rwa [Matrix.charpoly_natDegree_eq_dim, Fintype.card_fin] at this
    have e : ∑ i : Fin r, A.charpoly.coeff i • A ^ (i : ℕ) =
        ∑ i ∈ Finset.range r, A.charpoly.coeff i • A ^ i :=
      Fin.sum_univ_eq_sum_range (fun i => A.charpoly.coeff i • A ^ i) r
    rw [hr, one_smul] at h
    rw [e, add_comm]
    exact h

  have hkry : ∀ (A : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]),
      A * Kry A v = Kry A v * Comp (fun i => A.charpoly.coeff i) := by
    intro A v
    ext a j
    have hL : (A * Kry A v) a j = ((A ^ ((j : ℕ) + 1)).mulVec v) a := by
      rw [pow_succ', ← Matrix.mulVec_mulVec]
      simp only [Matrix.mul_apply, hKry, Matrix.mulVec, dotProduct]
    rw [hL, Matrix.mul_apply]
    by_cases hj : (j : ℕ) + 1 = r
    · simp only [hComp, hj, ite_true, hKry]
      have h := congrFun (congrArg (fun M => M.mulVec v) (hCH A)) a
      simp only [Matrix.add_mulVec, Matrix.sum_mulVec, Matrix.smul_mulVec, Matrix.zero_mulVec,
        Pi.add_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at h
      have e : ∑ x : Fin r, ((A ^ (x : ℕ)).mulVec v) a * -A.charpoly.coeff x
          = -∑ x : Fin r, A.charpoly.coeff x * ((A ^ (x : ℕ)).mulVec v) a := by
        rw [← Finset.sum_neg_distrib]
        exact Finset.sum_congr rfl (fun x _ => by ring)
      rw [e]
      linear_combination h
    · have hjr : (j : ℕ) + 1 < r := by have := j.isLt; omega
      rw [Finset.sum_eq_single ⟨(j : ℕ) + 1, hjr⟩]
      · simp [hComp, hj, hKry]
      · intro b _ hb
        have hb' : (b : ℕ) ≠ (j : ℕ) + 1 := fun h => hb (Fin.ext h)
        simp [hComp, hj, hb']
      · intro h; exact absurd (Finset.mem_univ _) h

  have hcyc : ∀ A : Matrix (Fin r) (Fin r) ℚ_[ℓ], A.charpoly.Separable →
      ∃ v : Fin r → ℚ_[ℓ], IsUnit (Kry A v).det := by
    intro A hA
    obtain ⟨φ, hφ⟩ : ∃ φ : ℚ_[ℓ] →+* AlgebraicClosure ℚ_[ℓ],
        φ = algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) := ⟨_, rfl⟩
    obtain ⟨Aφ, hAφ⟩ : ∃ Aφ : Matrix (Fin r) (Fin r) (AlgebraicClosure ℚ_[ℓ]),
        Aφ = A.map φ := ⟨_, rfl⟩
    have hgsep : Aφ.charpoly.Separable := by
      rw [hAφ, Matrix.charpoly_map]; exact hA.map
    have hnd : Aφ.charpoly.roots.Nodup := Polynomial.nodup_roots hgsep
    have hcard : Aφ.charpoly.roots.toFinset.card = r := by
      rw [Multiset.toFinset_card_of_nodup hnd, IsAlgClosed.card_roots_eq_natDegree,
        Matrix.charpoly_natDegree_eq_dim, Fintype.card_fin]
    obtain ⟨Sr, hSr⟩ : ∃ Sr : Finset (AlgebraicClosure ℚ_[ℓ]),
        Sr = Aφ.charpoly.roots.toFinset := ⟨_, rfl⟩
    rw [← hSr] at hcard
    obtain ⟨μ, hμ⟩ : ∃ μ : Fin r → AlgebraicClosure ℚ_[ℓ],
        μ = fun j => ((Sr.equivFin.symm (Fin.cast hcard.symm j) : Sr) : AlgebraicClosure ℚ_[ℓ]) :=
      ⟨_, rfl⟩
    have hμinj : Function.Injective μ := by
      intro i j hij
      rw [hμ] at hij
      have := Subtype.val_injective hij
      exact Fin.cast_injective _ (Sr.equivFin.symm.injective this)
    have hμroot : ∀ j, (Matrix.scalar (Fin r) (μ j) - Aφ).det = 0 := by
      intro j
      have hmem : μ j ∈ Sr := by
        rw [hμ]; exact (Sr.equivFin.symm (Fin.cast hcard.symm j)).2
      rw [hSr, Multiset.mem_toFinset,
        Polynomial.mem_roots (Matrix.charpoly_monic Aφ).ne_zero] at hmem
      rw [← Matrix.eval_charpoly]
      exact hmem
    have hev : ∀ j, ∃ w : Fin r → AlgebraicClosure ℚ_[ℓ], w ≠ 0 ∧ Aφ.mulVec w = μ j • w := by
      intro j
      obtain ⟨w, hw0, hw⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr (hμroot j)
      refine ⟨w, hw0, ?_⟩
      rw [Matrix.sub_mulVec, sub_eq_zero] at hw
      rw [← hw, Matrix.scalar_apply]
      ext x
      simp [Matrix.mulVec_diagonal]
    choose w hw0 hw using hev
    obtain ⟨W, hW⟩ : ∃ W : Matrix (Fin r) (Fin r) (AlgebraicClosure ℚ_[ℓ]),
        W = Matrix.of fun a j => w j a := ⟨_, rfl⟩
    have hWcol : W.col = w := by
      rw [hW]; rfl
    have hWli : LinearIndependent (AlgebraicClosure ℚ_[ℓ]) W.col := by
      rw [hWcol]
      refine Module.End.eigenvectors_linearIndependent' (Matrix.toLin' Aφ) μ hμinj w
        (fun j => ?_)
      rw [Module.End.hasEigenvector_iff, Module.End.mem_eigenspace_iff, Matrix.toLin'_apply]
      exact ⟨hw j, hw0 j⟩
    have hWu : IsUnit W := Matrix.linearIndependent_cols_iff_isUnit.mp hWli
    have hWdet : IsUnit W.det := (Matrix.isUnit_iff_isUnit_det W).mp hWu
    have hUW : W⁻¹ * W = 1 := Matrix.nonsing_inv_mul W hWdet
    have hWU : W * W⁻¹ = 1 := Matrix.mul_nonsing_inv W hWdet
    have hAW : Aφ * W = W * Matrix.diagonal μ := by
      ext a j
      rw [Matrix.mul_diagonal]
      have h := congrFun (hw j) a
      simp only [Matrix.mulVec, dotProduct, Pi.smul_apply, smul_eq_mul] at h
      simp only [Matrix.mul_apply, hW, Matrix.of_apply]
      rw [h, mul_comm]
    have hAk : ∀ k : ℕ, Aφ ^ k * W = W * Matrix.diagonal (fun j => μ j ^ k) := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        rw [pow_succ', Matrix.mul_assoc, ih, ← Matrix.mul_assoc, hAW, Matrix.mul_assoc,
          Matrix.diagonal_mul_diagonal]
        congr 2
        funext j
        ring
    have hAk' : ∀ k : ℕ, Aφ ^ k = W * Matrix.diagonal (fun j => μ j ^ k) * W⁻¹ := by
      intro k
      rw [← hAk k, Matrix.mul_assoc, hWU, Matrix.mul_one]
    have hdetU : (W⁻¹).det ≠ 0 := by
      intro h
      have := congrArg Matrix.det hUW
      rw [Matrix.det_mul, h, zero_mul, Matrix.det_one] at this
      exact zero_ne_one this
    obtain ⟨p, hp⟩ : ∃ p : Fin r → Polynomial (AlgebraicClosure ℚ_[ℓ]),
        p = fun j => ∑ k : Fin r, Polynomial.C (W⁻¹ j k) * Polynomial.X ^ (k : ℕ) := ⟨_, rfl⟩
    have hpeval : ∀ j x, (p j).eval x = ∑ k : Fin r, W⁻¹ j k * x ^ (k : ℕ) := by
      intro j x
      simp [hp, Polynomial.eval_finsetSum]
    have hp0 : ∀ j, p j ≠ 0 := by
      intro j hpj
      apply hdetU
      apply Matrix.det_eq_zero_of_row_eq_zero j
      intro k
      have h := congrArg (fun q => Polynomial.coeff q (k : ℕ)) hpj
      simp only [hp, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul_X_pow,
        Polynomial.coeff_zero] at h
      rw [Finset.sum_eq_single k] at h
      · simpa using h
      · intro b _ hb
        have : (k : ℕ) ≠ (b : ℕ) := fun e => hb (Fin.ext e).symm
        simp [this]
      · intro h'; exact absurd (Finset.mem_univ _) h'
    have hP0 : (∏ j, p j) ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun j _ => hp0 j)
    obtain ⟨s, hs⟩ := Infinite.exists_notMem_finset
      ((∏ j, p j).roots.toFinset.preimage φ (φ.injective.injOn))
    have hγ : ∀ j, (p j).eval (φ s) ≠ 0 := by
      intro j hj
      apply hs
      rw [Finset.mem_preimage, Multiset.mem_toFinset, Polynomial.mem_roots hP0,
        Polynomial.IsRoot, Polynomial.eval_prod]
      exact Finset.prod_eq_zero (Finset.mem_univ j) hj
    refine ⟨fun k => s ^ (k : ℕ), ?_⟩
    obtain ⟨γ, hγdef⟩ : ∃ γ : Fin r → AlgebraicClosure ℚ_[ℓ],
        γ = fun j => (p j).eval (φ s) := ⟨_, rfl⟩
    have hUv : (W⁻¹).mulVec (⇑φ ∘ fun k : Fin r => s ^ (k : ℕ)) = γ := by
      funext j
      rw [hγdef]
      dsimp only
      rw [hpeval]
      simp only [Matrix.mulVec, dotProduct, Function.comp, map_pow]
    have hkey : (Kry A (fun k => s ^ (k : ℕ))).map φ =
        W * (Matrix.diagonal γ * Matrix.vandermonde μ) := by
      ext a k
      rw [Matrix.map_apply, hKry, RingHom.map_mulVec, Matrix.map_pow, ← hAφ, hAk',
        ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hUv, Matrix.mul_apply]
      show (∑ j, W a j * ((Matrix.diagonal fun j => μ j ^ (k : ℕ)).mulVec γ) j) = _
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [Matrix.mulVec_diagonal, Matrix.diagonal_mul, Matrix.vandermonde_apply]
      ring
    have hdet : φ (Kry A (fun k => s ^ (k : ℕ))).det ≠ 0 := by
      rw [RingHom.map_det, RingHom.mapMatrix_apply, hkey, Matrix.det_mul, Matrix.det_mul,
        Matrix.det_diagonal]
      refine mul_ne_zero hWdet.ne_zero (mul_ne_zero ?_ ?_)
      · rw [hγdef]
        exact Finset.prod_ne_zero_iff.mpr (fun j _ => hγ j)
      · exact Matrix.det_vandermonde_ne_zero_iff.mpr hμinj
    exact isUnit_iff_ne_zero.mpr (fun h => hdet (by rw [h, map_zero]))

  intro t
  obtain ⟨v₁, hv₁⟩ := hcyc h₁ (hchar ▸ hsep)
  obtain ⟨v₂, hv₂⟩ := hcyc h₂ hsep
  obtain ⟨K₁, hK₁⟩ : ∃ K, K = Kry h₁ v₁ := ⟨_, rfl⟩
  obtain ⟨K₂, hK₂⟩ : ∃ K, K = Kry h₂ v₂ := ⟨_, rfl⟩
  obtain ⟨C, hC⟩ : ∃ C, C = Comp (fun i => h₂.charpoly.coeff i) := ⟨_, rfl⟩
  rw [← hK₁] at hv₁
  rw [← hK₂] at hv₂
  have hI₁ : h₁ * K₁ = K₁ * C := by
    have := hkry h₁ v₁
    rw [hchar, ← hK₁, ← hC] at this
    exact this
  have hI₂ : h₂ * K₂ = K₂ * C := by
    have := hkry h₂ v₂
    rw [← hK₂, ← hC] at this
    exact this
  have h1₁ : K₁⁻¹ * K₁ = 1 := Matrix.nonsing_inv_mul K₁ hv₁
  have h1₁' : K₁ * K₁⁻¹ = 1 := Matrix.mul_nonsing_inv K₁ hv₁
  have h1₂ : K₂⁻¹ * K₂ = 1 := Matrix.nonsing_inv_mul K₂ hv₂
  have h1₂' : K₂ * K₂⁻¹ = 1 := Matrix.mul_nonsing_inv K₂ hv₂
  obtain ⟨S, hS⟩ : ∃ S, S = K₂ * K₁⁻¹ := ⟨_, rfl⟩
  obtain ⟨Si, hSi⟩ : ∃ Si, Si = K₁ * K₂⁻¹ := ⟨_, rfl⟩
  have hSiS : Si * S = 1 := by
    rw [hS, hSi, Matrix.mul_assoc, ← Matrix.mul_assoc K₂⁻¹, h1₂, Matrix.one_mul, h1₁']
  have hK1C : K₁⁻¹ * h₁ = C * K₁⁻¹ := by
    calc K₁⁻¹ * h₁ = K₁⁻¹ * h₁ * (K₁ * K₁⁻¹) := by rw [h1₁', Matrix.mul_one]
      _ = K₁⁻¹ * (h₁ * K₁) * K₁⁻¹ := by simp only [Matrix.mul_assoc]
      _ = K₁⁻¹ * K₁ * C * K₁⁻¹ := by rw [hI₁]; simp only [Matrix.mul_assoc]
      _ = C * K₁⁻¹ := by rw [h1₁, Matrix.one_mul]
  have hconj : h₂ = S * h₁ * Si := by
    calc h₂ = h₂ * (K₂ * K₂⁻¹) := by rw [h1₂', Matrix.mul_one]
      _ = h₂ * K₂ * (K₁⁻¹ * K₁) * K₂⁻¹ := by rw [h1₁, Matrix.mul_one, Matrix.mul_assoc]
      _ = K₂ * (C * K₁⁻¹) * (K₁ * K₂⁻¹) := by rw [hI₂]; simp only [Matrix.mul_assoc]
      _ = K₂ * (K₁⁻¹ * h₁) * (K₁ * K₂⁻¹) := by rw [hK1C]
      _ = S * h₁ * Si := by rw [hS, hSi]; simp only [Matrix.mul_assoc]

  obtain ⟨B, hB1, hBS, hBSi⟩ : ∃ B : ℝ, 1 ≤ B ∧ (∀ a b, ‖S a b‖ ≤ B) ∧
      (∀ a b, ‖Si a b‖ ≤ B) := by
    have h1 : 0 ≤ ∑ a, ∑ b, ‖S a b‖ :=
      Finset.sum_nonneg (fun a _ => Finset.sum_nonneg (fun b _ => norm_nonneg _))
    have h2 : 0 ≤ ∑ a, ∑ b, ‖Si a b‖ :=
      Finset.sum_nonneg (fun a _ => Finset.sum_nonneg (fun b _ => norm_nonneg _))
    refine ⟨1 + ∑ a, ∑ b, ‖S a b‖ + ∑ a, ∑ b, ‖Si a b‖, by linarith, ?_, ?_⟩
    · intro a b
      have e1 : ‖S a b‖ ≤ ∑ b', ‖S a b'‖ :=
        Finset.single_le_sum (f := fun b' => ‖S a b'‖) (fun b' _ => norm_nonneg _)
          (Finset.mem_univ b)
      have e2 : ∑ b', ‖S a b'‖ ≤ ∑ a', ∑ b', ‖S a' b'‖ :=
        Finset.single_le_sum (f := fun a' => ∑ b', ‖S a' b'‖)
          (fun a' _ => Finset.sum_nonneg (fun b' _ => norm_nonneg _)) (Finset.mem_univ a)
      linarith
    · intro a b
      have e1 : ‖Si a b‖ ≤ ∑ b', ‖Si a b'‖ :=
        Finset.single_le_sum (f := fun b' => ‖Si a b'‖) (fun b' _ => norm_nonneg _)
          (Finset.mem_univ b)
      have e2 : ∑ b', ‖Si a b'‖ ≤ ∑ a', ∑ b', ‖Si a' b'‖ :=
        Finset.single_le_sum (f := fun a' => ∑ b', ‖Si a' b'‖)
          (fun a' _ => Finset.sum_nonneg (fun b' _ => norm_nonneg _)) (Finset.mem_univ a)
      linarith
  have hB0 : 0 ≤ B := by linarith

  have hprod : ∀ (X : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (ε : ℝ), 0 ≤ ε → (∀ a b, ‖X a b‖ ≤ ε) →
      ∀ a b, ‖(S * X * Si) a b‖ ≤ B * ε * B := by
    intro X ε hε hX a b
    have h1 : ∀ a j, ‖(S * X) a j‖ ≤ B * ε := by
      intro a j
      rw [Matrix.mul_apply]
      apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (mul_nonneg hB0 hε)
      intro i _
      rw [norm_mul]
      exact mul_le_mul (hBS a i) (hX i j) (norm_nonneg _) hB0
    rw [Matrix.mul_apply]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg
      (mul_nonneg (mul_nonneg hB0 hε) hB0)
    intro j _
    rw [norm_mul]
    exact mul_le_mul (h1 a j) (hBSi j b) (norm_nonneg _) (mul_nonneg hB0 hε)

  have hℓ1 : (1 : ℝ) < ℓ := by exact_mod_cast (Fact.out : Nat.Prime ℓ).one_lt
  have hℓpos : (0 : ℝ) < ℓ := by linarith
  obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt (B * B * (ℓ : ℝ) ^ t) hℓ1
  refine ⟨n, fun g' _ hg' => ?_⟩
  have hεt : B * (ℓ : ℝ) ^ (-(n : ℤ)) * B ≤ (ℓ : ℝ) ^ (-(t : ℤ)) := by
    rw [zpow_neg, zpow_neg, zpow_natCast, zpow_natCast]
    have hp1 : (0 : ℝ) < (ℓ : ℝ) ^ n := pow_pos hℓpos n
    have hp2 : (0 : ℝ) < (ℓ : ℝ) ^ t := pow_pos hℓpos t
    rw [show B * ((ℓ : ℝ) ^ n)⁻¹ * B = (B * B) / (ℓ : ℝ) ^ n by ring, inv_eq_one_div,
      div_le_div_iff₀ hp1 hp2]
    linarith
  refine ⟨S * g' * Si, ?_, ?_⟩
  · intro a b
    have e : S * g' * Si - h₂ = S * (g' - h₁) * Si := by
      rw [hconj, Matrix.mul_sub, Matrix.sub_mul]
    have := hprod (g' - h₁) _ (zpow_nonneg (Nat.cast_nonneg ℓ) _)
      (fun a b => by rw [Matrix.sub_apply]; exact hg' a b) a b
    rw [← e, Matrix.sub_apply] at this
    exact this.trans hεt
  · rw [Matrix.mul_assoc, Matrix.charpoly_mul_comm, Matrix.mul_assoc, hSiS, Matrix.mul_one]

theorem wc_bcr_cyclic_vector (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (A : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (hA : A.charpoly.Separable) :
    ∃ v : Fin r → ℚ_[ℓ], (∀ a, ‖v a‖ ≤ 1) ∧
      IsUnit (Matrix.of (fun a k : Fin r => ((A ^ (k : ℕ)).mulVec v) a)).det :=
by
  classical
  obtain ⟨φ, hφ⟩ : ∃ φ : ℚ_[ℓ] →+* AlgebraicClosure ℚ_[ℓ],
      φ = algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) := ⟨_, rfl⟩
  obtain ⟨Aφ, hAφ⟩ : ∃ Aφ : Matrix (Fin r) (Fin r) (AlgebraicClosure ℚ_[ℓ]),
      Aφ = A.map φ := ⟨_, rfl⟩
  have hgsep : Aφ.charpoly.Separable := by
    rw [hAφ, Matrix.charpoly_map]; exact hA.map
  have hnd : Aφ.charpoly.roots.Nodup := Polynomial.nodup_roots hgsep
  have hcard : Aφ.charpoly.roots.toFinset.card = r := by
    rw [Multiset.toFinset_card_of_nodup hnd, IsAlgClosed.card_roots_eq_natDegree,
      Matrix.charpoly_natDegree_eq_dim, Fintype.card_fin]
  obtain ⟨Sr, hSr⟩ : ∃ Sr : Finset (AlgebraicClosure ℚ_[ℓ]),
      Sr = Aφ.charpoly.roots.toFinset := ⟨_, rfl⟩
  rw [← hSr] at hcard
  obtain ⟨μ, hμ⟩ : ∃ μ : Fin r → AlgebraicClosure ℚ_[ℓ],
      μ = fun j => ((Sr.equivFin.symm (Fin.cast hcard.symm j) : Sr) : AlgebraicClosure ℚ_[ℓ]) :=
    ⟨_, rfl⟩
  have hμinj : Function.Injective μ := by
    intro i j hij
    rw [hμ] at hij
    have := Subtype.val_injective hij
    exact Fin.cast_injective _ (Sr.equivFin.symm.injective this)
  have hμroot : ∀ j, (Matrix.scalar (Fin r) (μ j) - Aφ).det = 0 := by
    intro j
    have hmem : μ j ∈ Sr := by
      rw [hμ]; exact (Sr.equivFin.symm (Fin.cast hcard.symm j)).2
    rw [hSr, Multiset.mem_toFinset,
      Polynomial.mem_roots (Matrix.charpoly_monic Aφ).ne_zero] at hmem
    rw [← Matrix.eval_charpoly]
    exact hmem
  have hev : ∀ j, ∃ w : Fin r → AlgebraicClosure ℚ_[ℓ], w ≠ 0 ∧ Aφ.mulVec w = μ j • w := by
    intro j
    obtain ⟨w, hw0, hw⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr (hμroot j)
    refine ⟨w, hw0, ?_⟩
    rw [Matrix.sub_mulVec, sub_eq_zero] at hw
    rw [← hw, Matrix.scalar_apply]
    ext x
    simp [Matrix.mulVec_diagonal]
  choose w hw0 hw using hev
  obtain ⟨W, hW⟩ : ∃ W : Matrix (Fin r) (Fin r) (AlgebraicClosure ℚ_[ℓ]),
      W = Matrix.of fun a j => w j a := ⟨_, rfl⟩
  have hWcol : W.col = w := by
    rw [hW]; rfl
  have hWli : LinearIndependent (AlgebraicClosure ℚ_[ℓ]) W.col := by
    rw [hWcol]
    refine Module.End.eigenvectors_linearIndependent' (Matrix.toLin' Aφ) μ hμinj w
      (fun j => ?_)
    rw [Module.End.hasEigenvector_iff, Module.End.mem_eigenspace_iff, Matrix.toLin'_apply]
    exact ⟨hw j, hw0 j⟩
  have hWu : IsUnit W := Matrix.linearIndependent_cols_iff_isUnit.mp hWli
  have hWdet : IsUnit W.det := (Matrix.isUnit_iff_isUnit_det W).mp hWu
  have hUW : W⁻¹ * W = 1 := Matrix.nonsing_inv_mul W hWdet
  have hWU : W * W⁻¹ = 1 := Matrix.mul_nonsing_inv W hWdet
  have hAW : Aφ * W = W * Matrix.diagonal μ := by
    ext a j
    rw [Matrix.mul_diagonal]
    have h := congrFun (hw j) a
    simp only [Matrix.mulVec, dotProduct, Pi.smul_apply, smul_eq_mul] at h
    simp only [Matrix.mul_apply, hW, Matrix.of_apply]
    rw [h, mul_comm]
  have hAk : ∀ k : ℕ, Aφ ^ k * W = W * Matrix.diagonal (fun j => μ j ^ k) := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      rw [pow_succ', Matrix.mul_assoc, ih, ← Matrix.mul_assoc, hAW, Matrix.mul_assoc,
        Matrix.diagonal_mul_diagonal]
      congr 2
      funext j
      ring
  have hAk' : ∀ k : ℕ, Aφ ^ k = W * Matrix.diagonal (fun j => μ j ^ k) * W⁻¹ := by
    intro k
    rw [← hAk k, Matrix.mul_assoc, hWU, Matrix.mul_one]
  have hdetU : (W⁻¹).det ≠ 0 := by
    intro h
    have := congrArg Matrix.det hUW
    rw [Matrix.det_mul, h, zero_mul, Matrix.det_one] at this
    exact zero_ne_one this
  obtain ⟨p, hp⟩ : ∃ p : Fin r → Polynomial (AlgebraicClosure ℚ_[ℓ]),
      p = fun j => ∑ k : Fin r, Polynomial.C (W⁻¹ j k) * Polynomial.X ^ (k : ℕ) := ⟨_, rfl⟩
  have hpeval : ∀ j x, (p j).eval x = ∑ k : Fin r, W⁻¹ j k * x ^ (k : ℕ) := by
    intro j x
    simp [hp, Polynomial.eval_finsetSum]
  have hp0 : ∀ j, p j ≠ 0 := by
    intro j hpj
    apply hdetU
    apply Matrix.det_eq_zero_of_row_eq_zero j
    intro k
    have h := congrArg (fun q => Polynomial.coeff q (k : ℕ)) hpj
    simp only [hp, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul_X_pow,
      Polynomial.coeff_zero] at h
    rw [Finset.sum_eq_single k] at h
    · simpa using h
    · intro b _ hb
      have : (k : ℕ) ≠ (b : ℕ) := fun e => hb (Fin.ext e).symm
      simp [this]
    · intro h'; exact absurd (Finset.mem_univ _) h'
  have hP0 : (∏ j, p j) ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun j _ => hp0 j)
  obtain ⟨ι, hι⟩ : ∃ ι : ℕ → AlgebraicClosure ℚ_[ℓ], ι = fun n : ℕ => φ (n : ℚ_[ℓ]) :=
    ⟨_, rfl⟩
  have hιinj : Function.Injective ι := by
    rw [hι]
    exact φ.injective.comp Nat.cast_injective
  obtain ⟨n, hn⟩ := Infinite.exists_notMem_finset
    ((∏ j, p j).roots.toFinset.preimage ι (hιinj.injOn))
  have hιn : ι n = φ (n : ℚ_[ℓ]) := by rw [hι]
  have hγ : ∀ j, (p j).eval (φ (n : ℚ_[ℓ])) ≠ 0 := by
    intro j hj
    apply hn
    rw [Finset.mem_preimage, Multiset.mem_toFinset, Polynomial.mem_roots hP0,
      Polynomial.IsRoot, Polynomial.eval_prod, hιn]
    exact Finset.prod_eq_zero (Finset.mem_univ j) hj
  refine ⟨fun k => (n : ℚ_[ℓ]) ^ (k : ℕ), ?_, ?_⟩
  · intro a
    have h1 : ‖(n : ℚ_[ℓ])‖ ≤ 1 := by
      have := Padic.norm_int_le_one (p := ℓ) (n : ℤ)
      rwa [Int.cast_natCast] at this
    show ‖(n : ℚ_[ℓ]) ^ (a : ℕ)‖ ≤ 1
    rw [norm_pow]
    exact pow_le_one₀ (norm_nonneg _) h1
  obtain ⟨γ, hγdef⟩ : ∃ γ : Fin r → AlgebraicClosure ℚ_[ℓ],
      γ = fun j => (p j).eval (φ (n : ℚ_[ℓ])) := ⟨_, rfl⟩
  have hUv : (W⁻¹).mulVec (⇑φ ∘ fun k : Fin r => (n : ℚ_[ℓ]) ^ (k : ℕ)) = γ := by
    funext j
    rw [hγdef]
    dsimp only
    rw [hpeval]
    simp only [Matrix.mulVec, dotProduct, Function.comp, map_pow]
  have hkey : (Matrix.of (fun a k : Fin r =>
        ((A ^ (k : ℕ)).mulVec (fun k : Fin r => (n : ℚ_[ℓ]) ^ (k : ℕ))) a)).map φ =
      W * (Matrix.diagonal γ * Matrix.vandermonde μ) := by
    ext a k
    rw [Matrix.map_apply, Matrix.of_apply, RingHom.map_mulVec, Matrix.map_pow, ← hAφ, hAk',
      ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hUv, Matrix.mul_apply]
    show (∑ j, W a j * ((Matrix.diagonal fun j => μ j ^ (k : ℕ)).mulVec γ) j) = _
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [Matrix.mulVec_diagonal, Matrix.diagonal_mul, Matrix.vandermonde_apply]
    ring
  have hdet : φ (Matrix.of (fun a k : Fin r =>
        ((A ^ (k : ℕ)).mulVec (fun k : Fin r => (n : ℚ_[ℓ]) ^ (k : ℕ))) a)).det ≠ 0 := by
    rw [RingHom.map_det, RingHom.mapMatrix_apply, hkey, Matrix.det_mul, Matrix.det_mul,
      Matrix.det_diagonal]
    refine mul_ne_zero hWdet.ne_zero (mul_ne_zero ?_ ?_)
    · rw [hγdef]
      exact Finset.prod_ne_zero_iff.mpr (fun j _ => hγ j)
    · exact Matrix.det_vandermonde_ne_zero_iff.mpr hμinj
  exact isUnit_iff_ne_zero.mpr (fun h => hdet (by rw [h, map_zero]))

theorem wc_bcr_charpoly_coeff_close (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r n : ℕ)
    (M N : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (hM : ∀ a b, ‖M a b‖ ≤ 1) (hN : ∀ a b, ‖N a b‖ ≤ 1)
    (hMN : ∀ a b, ‖M a b - N a b‖ ≤ (ℓ : ℝ) ^ (-(n : ℤ))) :
    (∀ i : ℕ, ‖M.charpoly.coeff i - N.charpoly.coeff i‖ ≤ (ℓ : ℝ) ^ (-(n : ℤ))) ∧
      ∀ i : ℕ, ‖M.charpoly.coeff i‖ ≤ 1 :=
by
  classical
  let M' : Matrix (Fin r) (Fin r) ℤ_[ℓ] := Matrix.of fun a b => (⟨M a b, hM a b⟩ : ℤ_[ℓ])
  let N' : Matrix (Fin r) (Fin r) ℤ_[ℓ] := Matrix.of fun a b => (⟨N a b, hN a b⟩ : ℤ_[ℓ])
  have hMl : M'.map (PadicInt.Coe.ringHom (p := ℓ)) = M := by ext a b; rfl
  have hNl : N'.map (PadicInt.Coe.ringHom (p := ℓ)) = N := by ext a b; rfl
  have cM : ∀ i, M.charpoly.coeff i = ((M'.charpoly.coeff i : ℤ_[ℓ]) : ℚ_[ℓ]) := by
    intro i
    rw [← hMl, Matrix.charpoly_map, Polynomial.coeff_map]
    rfl
  have cN : ∀ i, N.charpoly.coeff i = ((N'.charpoly.coeff i : ℤ_[ℓ]) : ℚ_[ℓ]) := by
    intro i
    rw [← hNl, Matrix.charpoly_map, Polynomial.coeff_map]
    rfl
  have hent : M'.map (Ideal.Quotient.mk (Ideal.span {(ℓ : ℤ_[ℓ]) ^ n})) =
      N'.map (Ideal.Quotient.mk (Ideal.span {(ℓ : ℤ_[ℓ]) ^ n})) := by
    ext a b
    simp only [Matrix.map_apply]
    rw [Ideal.Quotient.eq]
    apply (PadicInt.norm_le_pow_iff_mem_span_pow _ n).mp
    rw [PadicInt.norm_def, PadicInt.coe_sub]
    exact hMN a b
  have hc : ∀ i, M'.charpoly.coeff i - N'.charpoly.coeff i ∈
      Ideal.span {(ℓ : ℤ_[ℓ]) ^ n} := by
    intro i
    rw [← Ideal.Quotient.eq]
    have h := congrArg (fun p => Polynomial.coeff p i) (congrArg Matrix.charpoly hent)
    simp only [Matrix.charpoly_map, Polynomial.coeff_map] at h
    exact h
  refine ⟨fun i => ?_, fun i => ?_⟩
  · rw [cM, cN, ← PadicInt.coe_sub, ← PadicInt.norm_def]
    exact (PadicInt.norm_le_pow_iff_mem_span_pow _ n).mpr (hc i)
  · rw [cM, ← PadicInt.norm_def]
    exact PadicInt.norm_le_one _

theorem wc_bcr_poly_taylor_bound (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (hX : ∀ a b, ‖X a b‖ ≤ 1) (hY : ∀ a b, ‖Y a b‖ ≤ 1)
    (p : Polynomial ℚ_[ℓ]) (hp : ∀ k, ‖p.coeff k‖ ≤ 1) (η : ℝ) (hη : 0 ≤ η)
    (hXY : ∀ a b, ‖Y a b - X a b‖ ≤ η) :
    (∀ a b, ‖(Polynomial.aeval Y p - Polynomial.aeval X p) a b‖ ≤ η) ∧
      (Commute X Y → ∀ a b, ‖(Polynomial.aeval Y p - Polynomial.aeval X p -
        Polynomial.aeval X (Polynomial.derivative p) * (Y - X)) a b‖ ≤ η ^ 2) :=
by
  classical
  have hmul : ∀ (A B : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (e₁ e₂ : ℝ), 0 ≤ e₁ → 0 ≤ e₂ →
      (∀ a b, ‖A a b‖ ≤ e₁) → (∀ a b, ‖B a b‖ ≤ e₂) → ∀ a b, ‖(A * B) a b‖ ≤ e₁ * e₂ := by
    intro A B e₁ e₂ h1 h2 hA hB a b
    rw [Matrix.mul_apply]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (mul_nonneg h1 h2)
    intro c _
    rw [norm_mul]
    exact mul_le_mul (hA a c) (hB c b) (norm_nonneg _) h1
  have hadd : ∀ (A B : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (e : ℝ),
      (∀ a b, ‖A a b‖ ≤ e) → (∀ a b, ‖B a b‖ ≤ e) → ∀ a b, ‖(A + B) a b‖ ≤ e := by
    intro A B e hA hB a b
    rw [Matrix.add_apply]
    exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le (hA a b) (hB a b))
  have hsmul : ∀ (c : ℚ_[ℓ]) (A : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (e : ℝ), ‖c‖ ≤ 1 → 0 ≤ e →
      (∀ a b, ‖A a b‖ ≤ e) → ∀ a b, ‖(c • A) a b‖ ≤ e := by
    intro c A e hc he hA a b
    rw [Matrix.smul_apply, smul_eq_mul, norm_mul]
    calc ‖c‖ * ‖A a b‖ ≤ 1 * e := mul_le_mul hc (hA a b) (norm_nonneg _) zero_le_one
      _ = e := one_mul e
  have hsum : ∀ (s : Finset ℕ) (f : ℕ → Matrix (Fin r) (Fin r) ℚ_[ℓ]) (e : ℝ), 0 ≤ e →
      (∀ k ∈ s, ∀ a b, ‖f k a b‖ ≤ e) → ∀ a b, ‖(∑ k ∈ s, f k) a b‖ ≤ e := by
    intro s f e he hf a b
    rw [Matrix.sum_apply]
    exact IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg he (fun k hk => hf k hk a b)
  have hpowX : ∀ n : ℕ, ∀ a b, ‖(X ^ n) a b‖ ≤ 1 := by
    intro n
    induction n with
    | zero =>
      intro a b
      rw [pow_zero, Matrix.one_apply]
      split_ifs <;> simp
    | succ n ih =>
      intro a b
      rw [pow_succ]
      simpa using hmul _ _ 1 1 zero_le_one zero_le_one ih hX a b
  have hE : ∀ a b, ‖(Y - X) a b‖ ≤ η := fun a b => by rw [Matrix.sub_apply]; exact hXY a b
  have hnat : ∀ m : ℕ, ‖((m : ℕ) : ℚ_[ℓ])‖ ≤ 1 := by
    intro m
    have := Padic.norm_int_le_one (p := ℓ) (m : ℤ)
    exact_mod_cast this
  have hη2 : 0 ≤ η ^ 2 := sq_nonneg η

  have s1 : ∀ n : ℕ, ∀ a b, ‖(Y ^ n - X ^ n) a b‖ ≤ η := by
    intro n
    induction n with
    | zero => intro a b; simp [hη]
    | succ n ih =>
      have hid : Y ^ (n + 1) - X ^ (n + 1) = Y * (Y ^ n - X ^ n) + (Y - X) * X ^ n := by
        rw [pow_succ', pow_succ', mul_sub, sub_mul]; abel
      rw [hid]
      apply hadd
      · intro a b; simpa using hmul _ _ 1 η zero_le_one hη hY ih a b
      · intro a b; simpa using hmul _ _ η 1 hη zero_le_one hE (hpowX n) a b

  have s2 : Commute X Y → ∀ n : ℕ, ∀ a b,
      ‖(Y ^ (n + 1) - X ^ (n + 1) - ((n : ℚ_[ℓ]) + 1) • (X ^ n * (Y - X))) a b‖ ≤ η ^ 2 := by
    intro hc n
    have hXE : Commute X (Y - X) := hc.sub_right (Commute.refl X)
    induction n with
    | zero => intro a b; simp [hη2]
    | succ n ih =>
      have hcom : (Y - X) * (X * X ^ n) = X * X ^ n * (Y - X) := by
        rw [← pow_succ']; exact ((hXE.pow_left (n + 1)).eq).symm
      have hid : Y ^ (n + 1 + 1) - X ^ (n + 1 + 1) - (((n + 1 : ℕ) : ℚ_[ℓ]) + 1) •
            (X ^ (n + 1) * (Y - X)) =
          Y * (Y ^ (n + 1) - X ^ (n + 1) - ((n : ℚ_[ℓ]) + 1) • (X ^ n * (Y - X))) +
            ((n : ℚ_[ℓ]) + 1) • ((Y - X) * X ^ n * (Y - X)) := by
        rw [← sub_eq_zero]
        have key : Y ^ (n + 1 + 1) - X ^ (n + 1 + 1) - (((n + 1 : ℕ) : ℚ_[ℓ]) + 1) •
            (X ^ (n + 1) * (Y - X)) -
            (Y * (Y ^ (n + 1) - X ^ (n + 1) - ((n : ℚ_[ℓ]) + 1) • (X ^ n * (Y - X))) +
              ((n : ℚ_[ℓ]) + 1) • ((Y - X) * X ^ n * (Y - X))) =
            (Y - X) * (X * X ^ n) - X * X ^ n * (Y - X) := by
          rw [pow_succ' Y (n + 1), pow_succ' X (n + 1), pow_succ' X n]
          push_cast
          simp only [mul_sub, sub_mul, mul_add, mul_smul_comm, add_smul,
            one_smul, smul_sub, mul_assoc]
          abel
        rw [key, hcom, sub_self]
      rw [hid]
      intro a b
      apply hadd
      · intro a b; simpa using hmul _ _ 1 (η ^ 2) zero_le_one hη2 hY ih a b
      · intro a b
        have hc' : ‖((n : ℚ_[ℓ]) + 1)‖ ≤ 1 := by
          have := hnat (n + 1); push_cast at this; exact this
        refine hsmul _ _ (η ^ 2) hc' hη2 ?_ a b
        intro a b
        have h1 := hmul _ _ η 1 hη zero_le_one hE (hpowX n)
        have h2 := hmul _ _ (η * 1) η (by simpa using hη) hη h1 hE a b
        calc ‖((Y - X) * X ^ n * (Y - X)) a b‖ ≤ η * 1 * η := h2
          _ = η ^ 2 := by ring
  refine ⟨?_, ?_⟩
  · intro a b
    rw [Polynomial.aeval_eq_sum_range, Polynomial.aeval_eq_sum_range, ← Finset.sum_sub_distrib]
    refine hsum _ _ η hη (fun k _ => ?_) a b
    rw [← smul_sub]
    exact hsmul _ _ η (hp k) hη (s1 k)
  · intro hc a b
    set N := p.natDegree with hN
    have hder : (Polynomial.derivative p).natDegree < N + 1 :=
      lt_of_le_of_lt (Polynomial.natDegree_derivative_le p) (by omega)
    rw [Polynomial.aeval_eq_sum_range' (n := N + 2) (by omega) Y,
      Polynomial.aeval_eq_sum_range' (n := N + 2) (by omega) X,
      Polynomial.aeval_eq_sum_range' hder X]
    have heq : ∑ i ∈ Finset.range (N + 2), p.coeff i • Y ^ i -
        ∑ i ∈ Finset.range (N + 2), p.coeff i • X ^ i -
        (∑ i ∈ Finset.range (N + 1), (Polynomial.derivative p).coeff i • X ^ i) * (Y - X) =
        ∑ k ∈ Finset.range (N + 1), p.coeff (k + 1) •
          (Y ^ (k + 1) - X ^ (k + 1) - ((k : ℚ_[ℓ]) + 1) • (X ^ k * (Y - X))) := by
      rw [← Finset.sum_sub_distrib, Finset.sum_range_succ' _ (N + 1), Finset.sum_mul]
      simp only [pow_zero, sub_self, add_zero]
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [Polynomial.coeff_derivative, smul_mul_assoc, mul_smul, smul_sub, smul_sub]
    rw [heq]
    refine hsum _ _ (η ^ 2) hη2 (fun k _ => ?_) a b
    exact hsmul _ _ (η ^ 2) (hp (k + 1)) hη2 (s2 hc k)

theorem wc_bcr_newton_root (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (Φ W : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (hΦint : ∀ a b, ‖Φ a b‖ ≤ 1)
    (f g : Polynomial ℚ_[ℓ]) (C ε : ℝ)
    (hf : Polynomial.aeval Φ f = 0) (hg : ∀ k, ‖g.coeff k‖ ≤ 1)
    (hW : W ∈ Algebra.adjoin ℚ_[ℓ] {Φ})
    (hWF : W * Polynomial.aeval Φ (Polynomial.derivative f) = 1)
    (hC : 1 ≤ C) (hε : 0 ≤ ε) (hWC : ∀ a b, ‖W a b‖ ≤ C)
    (hgf : ∀ k, ‖g.coeff k - f.coeff k‖ ≤ ε) (hεC : ε * C ^ 2 < 1) :
    ∃ y ∈ Algebra.adjoin ℚ_[ℓ] {Φ}, Polynomial.aeval y g = 0 ∧
      ∀ a b, ‖y a b - Φ a b‖ ≤ C * ε :=
by
  classical

  have hmul : ∀ (X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (e₁ e₂ : ℝ), 0 ≤ e₁ → 0 ≤ e₂ →
      (∀ a b, ‖X a b‖ ≤ e₁) → (∀ a b, ‖Y a b‖ ≤ e₂) → ∀ a b, ‖(X * Y) a b‖ ≤ e₁ * e₂ := by
    intro X Y e₁ e₂ h1 h2 hX hY a b
    rw [Matrix.mul_apply]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (mul_nonneg h1 h2)
    intro c _
    rw [norm_mul]
    exact mul_le_mul (hX a c) (hY c b) (norm_nonneg _) h1
  have hadd : ∀ (X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (e : ℝ),
      (∀ a b, ‖X a b‖ ≤ e) → (∀ a b, ‖Y a b‖ ≤ e) → ∀ a b, ‖(X + Y) a b‖ ≤ e := by
    intro X Y e hX hY a b
    rw [Matrix.add_apply]
    exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le (hX a b) (hY a b))
  have hsub : ∀ (X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (e : ℝ),
      (∀ a b, ‖X a b‖ ≤ e) → (∀ a b, ‖Y a b‖ ≤ e) → ∀ a b, ‖(X - Y) a b‖ ≤ e := by
    intro X Y e hX hY a b
    rw [Matrix.sub_apply, sub_eq_add_neg]
    exact (IsUltrametricDist.norm_add_le_max _ _).trans
      (max_le (hX a b) (by rw [norm_neg]; exact hY a b))
  have hsmul : ∀ (c : ℚ_[ℓ]) (X : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (e : ℝ), ‖c‖ ≤ 1 → 0 ≤ e →
      (∀ a b, ‖X a b‖ ≤ e) → ∀ a b, ‖(c • X) a b‖ ≤ e := by
    intro c X e hc he hX a b
    rw [Matrix.smul_apply, smul_eq_mul, norm_mul]
    calc ‖c‖ * ‖X a b‖ ≤ 1 * e := mul_le_mul hc (hX a b) (norm_nonneg _) zero_le_one
      _ = e := one_mul e
  have h1int : ∀ a b, ‖(1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1 := by
    intro a b
    by_cases hab : a = b
    · subst hab; simp
    · simp [Matrix.one_apply_ne hab]
  have hnear : ∀ (X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (e : ℝ), e ≤ 1 → (∀ a b, ‖Y a b‖ ≤ 1) →
      (∀ a b, ‖X a b - Y a b‖ ≤ e) → ∀ a b, ‖X a b‖ ≤ 1 := by
    intro X Y e he hY hXY a b
    have e' : X a b = (X a b - Y a b) + Y a b := by ring
    rw [e']
    exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ((hXY a b).trans he) (hY a b))
  have hpowint : ∀ (X : Matrix (Fin r) (Fin r) ℚ_[ℓ]), (∀ a b, ‖X a b‖ ≤ 1) →
      ∀ n : ℕ, ∀ a b, ‖(X ^ n) a b‖ ≤ 1 := by
    intro X hX n
    induction n with
    | zero => intro a b; rw [pow_zero]; exact h1int a b
    | succ n ih =>
      intro a b
      rw [pow_succ]
      have := hmul _ _ 1 1 zero_le_one zero_le_one ih hX a b
      linarith
  have hnat : ∀ k : ℕ, ‖((k : ℚ_[ℓ]) + 1)‖ ≤ 1 := by
    intro k
    have := Padic.norm_int_le_one (p := ℓ) ((k : ℤ) + 1)
    push_cast at this
    exact this
  have hcoef : ∀ (X : Matrix (Fin r) (Fin r) ℚ_[ℓ]), (∀ a b, ‖X a b‖ ≤ 1) →
      ∀ (p : Polynomial ℚ_[ℓ]) (e : ℝ), 0 ≤ e → (∀ k, ‖p.coeff k‖ ≤ e) →
      ∀ a b, ‖(Polynomial.aeval X p) a b‖ ≤ e := by
    intro X hX p e he hp a b
    rw [Polynomial.aeval_eq_sum_range, Matrix.sum_apply]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg he
    intro i _
    rw [Matrix.smul_apply, smul_eq_mul, norm_mul]
    calc ‖p.coeff i‖ * ‖(X ^ i) a b‖ ≤ e * 1 :=
          mul_le_mul (hp i) (hpowint X hX i a b) (norm_nonneg _) he
      _ = e := mul_one e
  have hderiv : ∀ (p : Polynomial ℚ_[ℓ]) (e : ℝ), 0 ≤ e → (∀ k, ‖p.coeff k‖ ≤ e) →
      ∀ k, ‖(Polynomial.derivative p).coeff k‖ ≤ e := by
    intro p e he hp k
    rw [Polynomial.coeff_derivative, norm_mul]
    calc ‖p.coeff (k + 1)‖ * ‖(k : ℚ_[ℓ]) + 1‖ ≤ e * 1 :=
          mul_le_mul (hp _) (hnat k) (norm_nonneg _) he
      _ = e := mul_one e

  have hpowdiff : ∀ (X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ]), (∀ a b, ‖X a b‖ ≤ 1) →
      (∀ a b, ‖Y a b‖ ≤ 1) → ∀ η : ℝ, 0 ≤ η → (∀ a b, ‖Y a b - X a b‖ ≤ η) →
      ∀ n : ℕ, ∀ a b, ‖(Y ^ n - X ^ n) a b‖ ≤ η := by
    intro X Y hX hY η hη hXY n
    induction n with
    | zero =>
      intro a b
      rw [pow_zero, pow_zero, sub_self, Matrix.zero_apply, norm_zero]
      exact hη
    | succ n ih =>
      have e : Y ^ (n + 1) - X ^ (n + 1) = Y * (Y ^ n - X ^ n) + (Y - X) * X ^ n := by
        rw [pow_succ' Y n, pow_succ' X n, mul_sub, sub_mul]
        abel
      rw [e]
      refine hadd _ _ η ?_ ?_
      · intro a b
        have := hmul Y _ 1 η zero_le_one hη hY ih a b
        linarith
      · intro a b
        have := hmul (Y - X) (X ^ n) η 1 hη zero_le_one
          (fun a b => by rw [Matrix.sub_apply]; exact hXY a b) (hpowint X hX n) a b
        linarith
  have hT1 : ∀ (X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ]), (∀ a b, ‖X a b‖ ≤ 1) →
      (∀ a b, ‖Y a b‖ ≤ 1) → ∀ (p : Polynomial ℚ_[ℓ]), (∀ k, ‖p.coeff k‖ ≤ 1) →
      ∀ η : ℝ, 0 ≤ η → (∀ a b, ‖Y a b - X a b‖ ≤ η) →
      ∀ a b, ‖(Polynomial.aeval Y p - Polynomial.aeval X p) a b‖ ≤ η := by
    intro X Y hX hY p hp η hη hXY a b
    rw [Polynomial.aeval_eq_sum_range, Polynomial.aeval_eq_sum_range, ← Finset.sum_sub_distrib,
      Matrix.sum_apply]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg hη
    intro i _
    rw [← smul_sub, Matrix.smul_apply, smul_eq_mul, norm_mul]
    calc ‖p.coeff i‖ * ‖(Y ^ i - X ^ i) a b‖ ≤ 1 * η :=
          mul_le_mul (hp i) (hpowdiff X Y hX hY η hη hXY i a b) (norm_nonneg _) zero_le_one
      _ = η := one_mul η

  have hT2 : ∀ (X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ]), (∀ a b, ‖X a b‖ ≤ 1) →
      (∀ a b, ‖Y a b‖ ≤ 1) → ∀ (p : Polynomial ℚ_[ℓ]), (∀ k, ‖p.coeff k‖ ≤ 1) →
      ∀ η : ℝ, 0 ≤ η → (∀ a b, ‖Y a b - X a b‖ ≤ η) → X * Y = Y * X →
      ∀ a b, ‖(Polynomial.aeval Y p - Polynomial.aeval X p -
        Polynomial.aeval X (Polynomial.derivative p) * (Y - X)) a b‖ ≤ η ^ 2 := by
    intro X Y hX hY p hp η hη hXY hc
    obtain ⟨E, rfl⟩ : ∃ E, Y = X + E := ⟨Y - X, by abel⟩
    rw [add_sub_cancel_left]
    have hE : ∀ a b, ‖E a b‖ ≤ η := by
      intro a b
      have := hXY a b
      rwa [Matrix.add_apply, add_sub_cancel_left] at this
    have hEX : E * X = X * E := by
      rw [mul_add, add_mul] at hc
      exact (add_left_cancel hc).symm
    have hD : ∀ n : ℕ, ∀ a b, ‖((X + E) ^ (n + 1) - X ^ (n + 1) -
        ((n : ℚ_[ℓ]) + 1) • (X ^ n * E)) a b‖ ≤ η ^ 2 := by
      intro n
      induction n with
      | zero =>
        intro a b
        have e0 : (X + E) ^ (0 + 1) - X ^ (0 + 1) - (((0 : ℕ) : ℚ_[ℓ]) + 1) • (X ^ 0 * E) = 0 := by
          simp
        rw [e0, Matrix.zero_apply, norm_zero]
        positivity
      | succ n ih =>
        have hPEX : X ^ n * E * X = X ^ (n + 1) * E := by
          rw [mul_assoc, hEX, ← mul_assoc, ← pow_succ]
        have e : (X + E) ^ (n + 1 + 1) - X ^ (n + 1 + 1) -
            (((n + 1 : ℕ) : ℚ_[ℓ]) + 1) • (X ^ (n + 1) * E) =
            ((X + E) ^ (n + 1) - X ^ (n + 1) - ((n : ℚ_[ℓ]) + 1) • (X ^ n * E)) * (X + E) +
              ((n : ℚ_[ℓ]) + 1) • (X ^ n * E * E) := by
          rw [pow_succ (X + E) (n + 1), pow_succ X (n + 1), Nat.cast_succ, sub_mul, sub_mul,
            mul_add (X ^ (n + 1)) X E, smul_mul_assoc, mul_add (X ^ n * E) X E, hPEX, smul_add,
            add_smul ((n : ℚ_[ℓ]) + 1) 1 (X ^ (n + 1) * E), one_smul]
          abel
        rw [e]
        refine hadd _ _ _ ?_ ?_
        · intro a b
          have := hmul _ (X + E) (η ^ 2) 1 (by positivity) zero_le_one ih hY a b
          linarith
        · refine hsmul _ _ _ (hnat n) (by positivity) ?_
          intro a b
          have h1 := hmul (X ^ n) E 1 η zero_le_one hη (hpowint X hX n) hE
          have h2 := hmul (X ^ n * E) E (1 * η) η (by linarith) hη h1 hE a b
          calc _ ≤ 1 * η * η := h2
            _ = η ^ 2 := by ring
    obtain ⟨M, hM⟩ : ∃ M, M = p.natDegree + 1 := ⟨_, rfl⟩
    have h1 : p.natDegree < M + 1 := by omega
    have h2 : (Polynomial.derivative p).natDegree < M := by
      have := Polynomial.natDegree_derivative_le p
      omega
    have key : Polynomial.aeval (X + E) p - Polynomial.aeval X p -
        Polynomial.aeval X (Polynomial.derivative p) * E =
        ∑ i ∈ Finset.range M, p.coeff (i + 1) • ((X + E) ^ (i + 1) - X ^ (i + 1) -
          ((i : ℚ_[ℓ]) + 1) • (X ^ i * E)) := by
      rw [Polynomial.aeval_eq_sum_range' h1 (X + E), Polynomial.aeval_eq_sum_range' h1 X,
        Polynomial.aeval_eq_sum_range' h2 X, ← Finset.sum_sub_distrib, Finset.sum_range_succ',
        Finset.sum_mul, pow_zero, pow_zero, sub_self, add_zero, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Polynomial.coeff_derivative, smul_mul_assoc, smul_sub, smul_sub, smul_smul]
    intro a b
    rw [key, Matrix.sum_apply]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (by positivity)
    intro i _
    rw [Matrix.smul_apply, smul_eq_mul, norm_mul]
    calc _ ≤ 1 * η ^ 2 := mul_le_mul (hp _) (hD i a b) (norm_nonneg _) zero_le_one
      _ = η ^ 2 := one_mul _

  have hΦ𝒜 : Φ ∈ Algebra.adjoin ℚ_[ℓ] {Φ} := Algebra.self_mem_adjoin_singleton ℚ_[ℓ] Φ
  have hcomm𝒜 : ∀ u ∈ Algebra.adjoin ℚ_[ℓ] {Φ}, ∀ v ∈ Algebra.adjoin ℚ_[ℓ] {Φ},
      u * v = v * u := by
    intro u hu v hv
    have h1 : Commute Φ u :=
      Algebra.commute_of_mem_adjoin_singleton_of_commute hu (Commute.refl Φ)
    exact (Algebra.commute_of_mem_adjoin_singleton_of_commute hv h1.symm).eq
  have hFW : Polynomial.aeval Φ (Polynomial.derivative f) * W = 1 := mul_eq_one_comm.mp hWF
  have hC0 : 0 ≤ C := by linarith
  have hCε : C * ε ≤ ε * C ^ 2 := by
    nlinarith [mul_nonneg hC0 (mul_nonneg hε (sub_nonneg.mpr hC))]
  have hCε1 : C * ε ≤ 1 := by linarith
  have hεCε : ε ≤ C * ε := by nlinarith [mul_nonneg hε (sub_nonneg.mpr hC)]
  have hCε0 : 0 ≤ C * ε := mul_nonneg hC0 hε

  have hstep : ∀ y ∈ Algebra.adjoin ℚ_[ℓ] {Φ}, (∀ a b, ‖y a b - Φ a b‖ ≤ C * ε) →
      ∀ δ : ℝ, 0 ≤ δ → δ ≤ ε → (∀ a b, ‖(Polynomial.aeval y g) a b‖ ≤ δ) →
      y - W * Polynomial.aeval y g ∈ Algebra.adjoin ℚ_[ℓ] {Φ} ∧
      (∀ a b, ‖(y - W * Polynomial.aeval y g) a b - y a b‖ ≤ C * δ) ∧
      (∀ a b, ‖(y - W * Polynomial.aeval y g) a b - Φ a b‖ ≤ C * ε) ∧
      ∀ a b, ‖(Polynomial.aeval (y - W * Polynomial.aeval y g) g) a b‖ ≤ ε * C ^ 2 * δ := by
    intro y hy hyΦ δ hδ hδε hgy
    have hD𝒜 : Polynomial.aeval y g ∈ Algebra.adjoin ℚ_[ℓ] {Φ} :=
      Algebra.adjoin_singleton_le hy (Polynomial.aeval_mem_adjoin_singleton ℚ_[ℓ] y)
    have hy'𝒜 : y - W * Polynomial.aeval y g ∈ Algebra.adjoin ℚ_[ℓ] {Φ} :=
      Subalgebra.sub_mem _ hy (Subalgebra.mul_mem _ hW hD𝒜)
    have hWD := hmul W (Polynomial.aeval y g) C δ hC0 hδ hWC hgy
    have hsz : ∀ a b, ‖(y - W * Polynomial.aeval y g) a b - y a b‖ ≤ C * δ := by
      intro a b
      rw [Matrix.sub_apply, sub_sub_cancel_left, norm_neg]
      exact hWD a b
    have hCδ : C * δ ≤ C * ε := mul_le_mul_of_nonneg_left hδε hC0
    have hdist : ∀ a b, ‖(y - W * Polynomial.aeval y g) a b - Φ a b‖ ≤ C * ε := by
      intro a b
      have e : (y - W * Polynomial.aeval y g) a b - Φ a b =
          (y a b - Φ a b) + -((W * Polynomial.aeval y g) a b) := by
        rw [Matrix.sub_apply]; ring
      rw [e]
      refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le (hyΦ a b) ?_)
      rw [norm_neg]; exact (hWD a b).trans hCδ
    have hyint := hnear y Φ (C * ε) hCε1 hΦint hyΦ
    have hy'int := hnear _ Φ (C * ε) hCε1 hΦint hdist
    have hc := hcomm𝒜 y hy _ hy'𝒜
    have hR := hT2 y _ hyint hy'int g hg (C * δ) (mul_nonneg hC0 hδ) hsz hc
    have hid : Polynomial.aeval (y - W * Polynomial.aeval y g) g =
        (Polynomial.aeval (y - W * Polynomial.aeval y g) g - Polynomial.aeval y g -
          Polynomial.aeval y (Polynomial.derivative g) * (y - W * Polynomial.aeval y g - y)) +
        (Polynomial.aeval Φ (Polynomial.derivative f) -
          Polynomial.aeval y (Polynomial.derivative g)) * W * Polynomial.aeval y g := by
      have h3 : (Polynomial.aeval Φ (Polynomial.derivative f) -
          Polynomial.aeval y (Polynomial.derivative g)) * W * Polynomial.aeval y g =
          Polynomial.aeval y g - Polynomial.aeval y (Polynomial.derivative g) * W *
            Polynomial.aeval y g := by
        rw [sub_mul, sub_mul, hFW, one_mul]
      rw [h3, sub_sub_cancel_left, mul_neg, ← mul_assoc]
      abel
    have hA1 : ∀ a b, ‖(Polynomial.aeval Φ (Polynomial.derivative f) -
        Polynomial.aeval Φ (Polynomial.derivative g)) a b‖ ≤ C * ε := by
      intro a b
      have := hcoef Φ hΦint (Polynomial.derivative (f - g)) ε hε
        (hderiv _ ε hε (fun k => by rw [Polynomial.coeff_sub, norm_sub_rev]; exact hgf k)) a b
      rw [Polynomial.derivative_sub, map_sub] at this
      exact this.trans hεCε
    have hA2 : ∀ a b, ‖(Polynomial.aeval y (Polynomial.derivative g) -
        Polynomial.aeval Φ (Polynomial.derivative g)) a b‖ ≤ C * ε :=
      hT1 Φ y hΦint hyint _ (hderiv g 1 zero_le_one hg) (C * ε) hCε0 hyΦ
    have hFG : ∀ a b, ‖(Polynomial.aeval Φ (Polynomial.derivative f) -
        Polynomial.aeval y (Polynomial.derivative g)) a b‖ ≤ C * ε := by
      have e : Polynomial.aeval Φ (Polynomial.derivative f) -
          Polynomial.aeval y (Polynomial.derivative g) =
          (Polynomial.aeval Φ (Polynomial.derivative f) -
            Polynomial.aeval Φ (Polynomial.derivative g)) -
          (Polynomial.aeval y (Polynomial.derivative g) -
            Polynomial.aeval Φ (Polynomial.derivative g)) := by abel
      rw [e]
      exact hsub _ _ _ hA1 hA2
    have hFGW := hmul _ W (C * ε) C hCε0 hC0 hFG hWC
    have hFGWD := hmul _ (Polynomial.aeval y g) (C * ε * C) δ (mul_nonneg hCε0 hC0) hδ hFGW hgy
    refine ⟨hy'𝒜, hsz, hdist, ?_⟩
    intro a b
    rw [hid, Matrix.add_apply]
    refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ ?_)
    · refine (hR a b).trans ?_
      nlinarith [mul_nonneg (mul_nonneg (sq_nonneg C) hδ) (sub_nonneg.mpr hδε)]
    · refine (hFGWD a b).trans (le_of_eq ?_)
      ring

  have hq0 : 0 ≤ ε * C ^ 2 := mul_nonneg hε (sq_nonneg C)
  obtain ⟨Y, hY0, hYs⟩ : ∃ Y : ℕ → Matrix (Fin r) (Fin r) ℚ_[ℓ], Y 0 = Φ ∧
      ∀ n, Y (n + 1) = Y n - W * Polynomial.aeval (Y n) g :=
    ⟨fun n => (fun x => x - W * Polynomial.aeval x g)^[n] Φ, rfl,
      fun n => Function.iterate_succ_apply' _ _ _⟩
  have hP : ∀ n, Y n ∈ Algebra.adjoin ℚ_[ℓ] {Φ} ∧ (∀ a b, ‖Y n a b - Φ a b‖ ≤ C * ε) ∧
      ∀ a b, ‖(Polynomial.aeval (Y n) g) a b‖ ≤ ε * (ε * C ^ 2) ^ n := by
    intro n
    induction n with
    | zero =>
      rw [hY0, pow_zero, mul_one]
      refine ⟨hΦ𝒜, fun a b => by rw [sub_self, norm_zero]; exact hCε0, ?_⟩
      intro a b
      have e : Polynomial.aeval Φ g = Polynomial.aeval Φ (g - f) := by
        rw [map_sub, hf, sub_zero]
      rw [e]
      exact hcoef Φ hΦint _ ε hε (fun k => by rw [Polynomial.coeff_sub]; exact hgf k) a b
    | succ n ih =>
      obtain ⟨h1, h2, h3⟩ := ih
      have hδ0 : 0 ≤ ε * (ε * C ^ 2) ^ n := mul_nonneg hε (pow_nonneg hq0 n)
      have hδε : ε * (ε * C ^ 2) ^ n ≤ ε :=
        mul_le_of_le_one_right hε (pow_le_one₀ hq0 hεC.le)
      obtain ⟨k1, _, k3, k4⟩ := hstep (Y n) h1 h2 _ hδ0 hδε h3
      rw [hYs n]
      refine ⟨k1, k3, fun a b => (k4 a b).trans (le_of_eq ?_)⟩
      ring
  have hinc : ∀ n a b, ‖Y (n + 1) a b - Y n a b‖ ≤ C * ε * (ε * C ^ 2) ^ n := by
    intro n a b
    obtain ⟨h1, h2, h3⟩ := hP n
    have hδ0 : 0 ≤ ε * (ε * C ^ 2) ^ n := mul_nonneg hε (pow_nonneg hq0 n)
    have hδε : ε * (ε * C ^ 2) ^ n ≤ ε :=
      mul_le_of_le_one_right hε (pow_le_one₀ hq0 hεC.le)
    obtain ⟨_, k2, _, _⟩ := hstep (Y n) h1 h2 _ hδ0 hδε h3
    rw [hYs n]
    exact (k2 a b).trans (le_of_eq (by ring))

  have hcau : ∀ a b, CauchySeq (fun n => Y n a b) := by
    intro a b
    refine cauchySeq_of_le_geometric (ε * C ^ 2) (C * ε) hεC (fun n => ?_)
    rw [dist_eq_norm, norm_sub_rev]
    exact hinc n a b
  choose L hL using fun a b => cauchySeq_tendsto_of_complete (hcau a b)
  obtain ⟨y, hyL⟩ : ∃ y : Matrix (Fin r) (Fin r) ℚ_[ℓ], ∀ a b, y a b = L a b :=
    ⟨Matrix.of L, fun a b => rfl⟩
  have hL' : ∀ a b, Filter.Tendsto (fun n => Y n a b) Filter.atTop (nhds (y a b)) := by
    intro a b; rw [hyL]; exact hL a b
  have hYt : Filter.Tendsto Y Filter.atTop (nhds y) :=
    tendsto_pi_nhds.mpr (fun a => tendsto_pi_nhds.mpr (fun b => hL' a b))
  have hy𝒜 : y ∈ Algebra.adjoin ℚ_[ℓ] {Φ} := by
    have hcl := Submodule.closed_of_finiteDimensional
      (Subalgebra.toSubmodule (Algebra.adjoin ℚ_[ℓ] {Φ}))
    exact hcl.mem_of_tendsto hYt (Filter.Eventually.of_forall (fun n => (hP n).1))
  have hcont : Filter.Tendsto (fun n => Polynomial.aeval (Y n) g) Filter.atTop
      (nhds (Polynomial.aeval y g)) :=
    ((Polynomial.continuous_aeval g).tendsto y).comp hYt
  have hzero : Filter.Tendsto (fun n => Polynomial.aeval (Y n) g) Filter.atTop (nhds 0) := by
    refine tendsto_pi_nhds.mpr (fun a => tendsto_pi_nhds.mpr (fun b => ?_))
    show Filter.Tendsto (fun n => (Polynomial.aeval (Y n) g) a b) Filter.atTop (nhds 0)
    have ht : Filter.Tendsto (fun n : ℕ => ε * (ε * C ^ 2) ^ n) Filter.atTop (nhds 0) := by
      have := (tendsto_pow_atTop_nhds_zero_of_lt_one hq0 hεC).const_mul ε
      rw [mul_zero] at this
      exact this
    exact squeeze_zero_norm (fun n => (hP n).2.2 a b) ht
  refine ⟨y, hy𝒜, tendsto_nhds_unique hcont hzero, fun a b => ?_⟩
  exact le_of_tendsto' (((hL' a b).sub_const (Φ a b)).norm) (fun n => (hP n).2.1 a b)

theorem wc_bcr_inverse_perturb (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (A B : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (hA : IsUnit A.det) (C η : ℝ) (hC : 0 ≤ C)
    (hη : 0 ≤ η) (hAinv : ∀ a b, ‖A⁻¹ a b‖ ≤ C) (hBA : ∀ a b, ‖B a b - A a b‖ ≤ η)
    (hCη : C * η < 1) :
    IsUnit B.det ∧ (∀ a b, ‖B⁻¹ a b‖ ≤ C) ∧ ∀ a b, ‖B⁻¹ a b - A⁻¹ a b‖ ≤ C ^ 2 * η :=
by
  classical
  have hmul : ∀ (X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (e₁ e₂ : ℝ), 0 ≤ e₁ → 0 ≤ e₂ →
      (∀ a b, ‖X a b‖ ≤ e₁) → (∀ a b, ‖Y a b‖ ≤ e₂) → ∀ a b, ‖(X * Y) a b‖ ≤ e₁ * e₂ := by
    intro X Y e₁ e₂ h1 h2 hX hY a b
    rw [Matrix.mul_apply]
    refine IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (mul_nonneg h1 h2) ?_
    intro c _
    rw [norm_mul]
    exact mul_le_mul (hX a c) (hY c b) (norm_nonneg _) h1
  have hfix : ∀ (X Y E : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (c ε : ℝ), 0 ≤ c → 0 ≤ ε → ε < 1 →
      (∀ a b, ‖Y a b‖ ≤ c) → (∀ a b, ‖E a b‖ ≤ ε) → X = Y + E * X → ∀ a b, ‖X a b‖ ≤ c := by
    intro X Y E c ε hc hε hε1 hY hE hX a b
    haveI : Nonempty (Fin r × Fin r) := ⟨(a, b)⟩
    obtain ⟨p₀, hp₀⟩ := Finite.exists_max (fun p : Fin r × Fin r => ‖X p.1 p.2‖)
    have hm0 : 0 ≤ ‖X p₀.1 p₀.2‖ := norm_nonneg _
    have hmax : ∀ a' b', ‖X a' b'‖ ≤ ‖X p₀.1 p₀.2‖ := fun a' b' => hp₀ (a', b')
    have hEX := hmul E X ε _ hε hm0 hE hmax
    have h2 : ∀ a' b', ‖X a' b'‖ ≤ max c (ε * ‖X p₀.1 p₀.2‖) := by
      intro a' b'
      have e := congrFun (congrFun hX a') b'
      rw [Matrix.add_apply] at e
      rw [e]
      exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le_max (hY a' b') (hEX a' b'))
    have hmc : ‖X p₀.1 p₀.2‖ ≤ c := by
      by_contra hlt
      push_neg at hlt
      have hmpos : 0 < ‖X p₀.1 p₀.2‖ := lt_of_le_of_lt hc hlt
      have h3 := h2 p₀.1 p₀.2
      have h4 : ε * ‖X p₀.1 p₀.2‖ < ‖X p₀.1 p₀.2‖ := mul_lt_of_lt_one_left hmpos hε1
      rcases le_total c (ε * ‖X p₀.1 p₀.2‖) with h5 | h5
      · rw [max_eq_right h5] at h3; linarith
      · rw [max_eq_left h5] at h3; linarith
    exact (hmax a b).trans hmc
  obtain ⟨D, hDdef⟩ : ∃ D : Matrix (Fin r) (Fin r) ℚ_[ℓ], D = B - A := ⟨_, rfl⟩
  obtain ⟨E, hEdef⟩ : ∃ E : Matrix (Fin r) (Fin r) ℚ_[ℓ], E = -(A⁻¹ * D) := ⟨_, rfl⟩
  have hD : ∀ a b, ‖D a b‖ ≤ η := fun a b => by rw [hDdef, Matrix.sub_apply]; exact hBA a b
  have hε : 0 ≤ C * η := mul_nonneg hC hη
  have hE : ∀ a b, ‖E a b‖ ≤ C * η := fun a b => by
    rw [hEdef, Matrix.neg_apply, norm_neg]; exact hmul _ _ C η hC hη hAinv hD a b
  have hAB : A⁻¹ * B = 1 + A⁻¹ * D := by
    rw [hDdef, Matrix.mul_sub, Matrix.nonsing_inv_mul A hA]; abel
  have hBdet : IsUnit B.det := by
    rw [isUnit_iff_ne_zero]
    intro h0
    obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr h0
    have hv' : E.mulVec v = v := by
      have e1 : (A⁻¹ * B).mulVec v = 0 := by
        rw [← Matrix.mulVec_mulVec, hv, Matrix.mulVec_zero]
      rw [hAB, Matrix.add_mulVec, Matrix.one_mulVec] at e1
      rw [hEdef, Matrix.neg_mulVec]
      exact (eq_neg_of_add_eq_zero_left e1).symm
    have hX : (Matrix.of (fun a (_ : Fin r) => v a) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
        0 + E * Matrix.of (fun a (_ : Fin r) => v a) := by
      ext a b
      rw [zero_add, Matrix.mul_apply]
      simp only [Matrix.of_apply]
      rw [← congrFun hv' a]
      rfl
    have hb := hfix _ 0 E 0 (C * η) le_rfl hε hCη (fun a b => by simp) hE hX
    apply hv0
    funext a
    have := hb a a
    simp only [Matrix.of_apply] at this
    exact norm_le_zero_iff.mp this
  have hfixB : B⁻¹ = A⁻¹ + E * B⁻¹ := by
    have h1 : A⁻¹ = B⁻¹ + A⁻¹ * D * B⁻¹ := by
      calc A⁻¹ = A⁻¹ * (B * B⁻¹) := by rw [Matrix.mul_nonsing_inv B hBdet, Matrix.mul_one]
        _ = (A⁻¹ * B) * B⁻¹ := by rw [Matrix.mul_assoc]
        _ = (1 + A⁻¹ * D) * B⁻¹ := by rw [hAB]
        _ = B⁻¹ + A⁻¹ * D * B⁻¹ := by rw [Matrix.add_mul, Matrix.one_mul]
    rw [hEdef, Matrix.neg_mul]
    calc B⁻¹ = (B⁻¹ + A⁻¹ * D * B⁻¹) + -(A⁻¹ * D * B⁻¹) := by abel
      _ = A⁻¹ + -(A⁻¹ * D * B⁻¹) := by rw [← h1]
  have hBinv := hfix B⁻¹ A⁻¹ E C (C * η) hC hε hCη hAinv hE hfixB
  refine ⟨hBdet, hBinv, fun a b => ?_⟩
  have e : B⁻¹ - A⁻¹ = E * B⁻¹ := by
    nth_rewrite 1 [hfixB]
    abel
  rw [← Matrix.sub_apply, e]
  calc ‖(E * B⁻¹) a b‖ ≤ C * η * C := hmul E B⁻¹ (C * η) C hε hC hE hBinv a b
    _ = C ^ 2 * η := by ring

theorem wc_bcr_adjoin_inv_mem (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (Φ X : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (hX : X ∈ Algebra.adjoin ℚ_[ℓ] {Φ})
    (hXdet : IsUnit X.det) :
    X⁻¹ ∈ Algebra.adjoin ℚ_[ℓ] {Φ} :=
by
  classical
  have hc0 : X.charpoly.coeff 0 ≠ 0 := by
    intro h
    have hd := Matrix.det_eq_sign_charpoly_coeff X
    rw [h, mul_zero] at hd
    exact hXdet.ne_zero hd
  have h2 : X * Polynomial.aeval X X.charpoly.divX +
      algebraMap ℚ_[ℓ] (Matrix (Fin r) (Fin r) ℚ_[ℓ]) (X.charpoly.coeff 0) = 0 := by
    have := congrArg (Polynomial.aeval X) (Polynomial.X_mul_divX_add X.charpoly)
    rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C,
      Matrix.aeval_self_charpoly] at this
    exact this
  have h3 : X * ((-(X.charpoly.coeff 0)⁻¹) • Polynomial.aeval X X.charpoly.divX) = 1 := by
    rw [Matrix.mul_smul]
    have h4 : X * Polynomial.aeval X X.charpoly.divX =
        -((X.charpoly.coeff 0) • (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ])) := by
      rw [← Algebra.algebraMap_eq_smul_one]
      exact eq_neg_of_add_eq_zero_left h2
    rw [h4, smul_neg, neg_smul, neg_neg, smul_smul, inv_mul_cancel₀ hc0, one_smul]
  rw [Matrix.inv_eq_right_inv h3]
  exact Subalgebra.smul_mem _
    (Algebra.adjoin_singleton_le hX (Polynomial.aeval_mem_adjoin_singleton _ _)) _

theorem wc_bcr_krylov_charpoly (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (y : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ])
    (hv : IsUnit (Matrix.of (fun a k : Fin r => ((y ^ (k : ℕ)).mulVec v) a)).det)
    (g : Polynomial ℚ_[ℓ]) (hg : g.Monic) (hgdeg : g.natDegree = r)
    (hgy : Polynomial.aeval y g = 0) :
    y.charpoly = g ∧
      (IsUnit (Polynomial.aeval y (Polynomial.derivative g)).det → g.Separable) :=
by
  classical
  have hdet0 : (Matrix.of (fun a k : Fin r => ((y ^ (k : ℕ)).mulVec v) a)).det ≠ 0 :=
    hv.ne_zero
  have kry : ∀ p : Polynomial ℚ_[ℓ], Polynomial.aeval y p = 0 →
      (∀ n : ℕ, r ≤ n → p.coeff n = 0) → p = 0 := by
    intro p hp hdeg
    have hsum : Polynomial.aeval y p = ∑ i ∈ Finset.range r, p.coeff i • y ^ i := by
      by_cases hp0 : p = 0
      · subst hp0; simp
      · apply Polynomial.aeval_eq_sum_range'
        by_contra h
        push_neg at h
        exact (Polynomial.leadingCoeff_ne_zero.mpr hp0) (hdeg _ h)
    have hc : (fun k : Fin r => p.coeff (k : ℕ)) = 0 := by
      apply Matrix.eq_zero_of_mulVec_eq_zero hdet0
      have h2 : (Polynomial.aeval y p).mulVec v = 0 := by rw [hp]; exact Matrix.zero_mulVec v
      rw [hsum] at h2
      rw [← h2]
      ext a
      have e1 : ((∑ i ∈ Finset.range r, p.coeff i • y ^ i).mulVec v) a
          = ∑ i ∈ Finset.range r, ((y ^ i).mulVec v) a * p.coeff i := by
        rw [← Matrix.toLin'_apply, map_sum, LinearMap.sum_apply, Finset.sum_apply]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [map_smul, LinearMap.smul_apply, Pi.smul_apply, Matrix.toLin'_apply, smul_eq_mul,
          mul_comm]
      rw [e1, ← Fin.sum_univ_eq_sum_range (fun i => ((y ^ i).mulVec v) a * p.coeff i) r]
      simp only [Matrix.mulVec, dotProduct, Matrix.of_apply]
    ext n
    rw [Polynomial.coeff_zero]
    by_cases hn : n < r
    · exact congrFun hc ⟨n, hn⟩
    · exact hdeg n (by omega)
  have hχm := Matrix.charpoly_monic y
  have hχdeg : y.charpoly.natDegree = r := by
    rw [Matrix.charpoly_natDegree_eq_dim, Fintype.card_fin]
  have hI : y.charpoly = g := by
    rw [← sub_eq_zero]
    apply kry
    · rw [Polynomial.aeval_sub, Matrix.aeval_self_charpoly, hgy, sub_zero]
    · intro n hn
      rw [Polynomial.coeff_sub]
      rcases hn.lt_or_eq with h | h
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega),
          Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), sub_zero]
      · have h1 := hχm.coeff_natDegree
        have h2 := hg.coeff_natDegree
        rw [hχdeg] at h1
        rw [hgdeg] at h2
        rw [← h, h1, h2, sub_self]
  refine ⟨hI, fun hu => ?_⟩
  obtain ⟨q, hq⟩ := EuclideanDomain.gcd_dvd_left g (Polynomial.derivative g)
  obtain ⟨e, he⟩ := EuclideanDomain.gcd_dvd_right g (Polynomial.derivative g)
  set d := EuclideanDomain.gcd g (Polynomial.derivative g) with hd
  have hg0 : g ≠ 0 := hg.ne_zero
  have hd0 : d ≠ 0 := by intro h; apply hg0; rw [hq, h, zero_mul]
  have hq0 : q ≠ 0 := by intro h; apply hg0; rw [hq, h, mul_zero]
  have hdu : IsUnit (Polynomial.aeval y d) := by
    rw [Matrix.isUnit_iff_isUnit_det]
    rw [he, Polynomial.aeval_mul, Matrix.det_mul] at hu
    exact isUnit_of_mul_isUnit_left hu
  have hqy : Polynomial.aeval y q = 0 := by
    have h := hgy
    rw [hq, Polynomial.aeval_mul] at h
    exact hdu.mul_right_eq_zero.mp h
  have hqdeg : r ≤ q.natDegree := by
    by_contra hlt
    push_neg at hlt
    exact hq0 (kry q hqy (fun n hn => Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)))
  have hdeg2 : g.natDegree = d.natDegree + q.natDegree := by
    rw [hq]
    exact Polynomial.natDegree_mul hd0 hq0
  have hdn : d.natDegree = 0 := by omega
  have hdunit : IsUnit d := by
    rw [Polynomial.eq_C_of_natDegree_eq_zero hdn]
    apply Polynomial.isUnit_C.mpr
    apply isUnit_iff_ne_zero.mpr
    intro h0
    apply hd0
    rw [Polynomial.eq_C_of_natDegree_eq_zero hdn, h0, map_zero]
  rw [Polynomial.separable_def]
  exact EuclideanDomain.gcd_isUnit_iff.mp hdunit

theorem wc_bcr_similitude_root_fixed (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (J Φ M W y : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (μ : ℚ_[ℓ]) (B C η : ℝ)
    (hJdet : IsUnit J.det) (hμ : μ ≠ 0) (hΦint : ∀ a b, ‖Φ a b‖ ≤ 1)
    (hΦJ : Φ.transpose * J * Φ = μ • J) (hMJ : M.transpose * J * M = μ • J)
    (hMint : ∀ k, ‖M.charpoly.coeff k‖ ≤ 1)
    (hMΦ : ∀ k, ‖M.charpoly.coeff k - Φ.charpoly.coeff k‖ ≤ η)
    (hW : W ∈ Algebra.adjoin ℚ_[ℓ] {Φ})
    (hWF : W * Polynomial.aeval Φ (Polynomial.derivative Φ.charpoly) = 1)
    (hWC : ∀ a b, ‖W a b‖ ≤ C)
    (hy : y ∈ Algebra.adjoin ℚ_[ℓ] {Φ}) (hgy : Polynomial.aeval y M.charpoly = 0)
    (hyΦ : ∀ a b, ‖y a b - Φ a b‖ ≤ η)
    (hB : 1 ≤ B) (hC : 1 ≤ C) (hη : 0 ≤ η)
    (hJB : ∀ a b, ‖J a b‖ ≤ B) (hJiB : ∀ a b, ‖J⁻¹ a b‖ ≤ B)
    (hμB : ‖μ‖ ≤ B) (hμiB : ‖μ⁻¹‖ ≤ B) (hsmall : C * B ^ 5 * η < 1) :
    y.transpose * J * y = μ • J :=
by
  classical

  have hmul : ∀ (X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (e₁ e₂ : ℝ), 0 ≤ e₁ → 0 ≤ e₂ →
      (∀ a b, ‖X a b‖ ≤ e₁) → (∀ a b, ‖Y a b‖ ≤ e₂) → ∀ a b, ‖(X * Y) a b‖ ≤ e₁ * e₂ := by
    intro X Y e₁ e₂ h1 h2 hX hY a b
    rw [Matrix.mul_apply]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (mul_nonneg h1 h2)
    intro c _
    rw [norm_mul]
    exact mul_le_mul (hX a c) (hY c b) (norm_nonneg _) h1
  have h1int : ∀ a b, ‖(1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1 := by
    intro a b
    by_cases hab : a = b
    · subst hab; simp
    · simp [Matrix.one_apply_ne hab]
  have hpowint : ∀ (X : Matrix (Fin r) (Fin r) ℚ_[ℓ]), (∀ a b, ‖X a b‖ ≤ 1) →
      ∀ n : ℕ, ∀ a b, ‖(X ^ n) a b‖ ≤ 1 := by
    intro X hX n
    induction n with
    | zero => intro a b; rw [pow_zero]; exact h1int a b
    | succ n ih =>
      intro a b
      rw [pow_succ]
      have := hmul _ _ 1 1 zero_le_one zero_le_one ih hX a b
      linarith
  have hcoef : ∀ (X : Matrix (Fin r) (Fin r) ℚ_[ℓ]), (∀ a b, ‖X a b‖ ≤ 1) →
      ∀ (p : Polynomial ℚ_[ℓ]) (e : ℝ), 0 ≤ e → (∀ k, ‖p.coeff k‖ ≤ e) →
      ∀ a b, ‖(Polynomial.aeval X p) a b‖ ≤ e := by
    intro X hX p e he hp a b
    rw [Polynomial.aeval_eq_sum_range, Matrix.sum_apply]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg he
    intro i _
    rw [Matrix.smul_apply, smul_eq_mul, norm_mul]
    calc ‖p.coeff i‖ * ‖(X ^ i) a b‖ ≤ e * 1 :=
          mul_le_mul (hp i) (hpowint X hX i a b) (norm_nonneg _) he
      _ = e := mul_one e
  have hderiv : ∀ (p : Polynomial ℚ_[ℓ]) (e : ℝ), 0 ≤ e → (∀ k, ‖p.coeff k‖ ≤ e) →
      ∀ k, ‖(Polynomial.derivative p).coeff k‖ ≤ e := by
    intro p e he hp k
    rw [Polynomial.coeff_derivative, norm_mul]
    have h1 : ‖((k : ℚ_[ℓ]) + 1)‖ ≤ 1 := by
      have := Padic.norm_int_le_one (p := ℓ) ((k : ℤ) + 1)
      push_cast at this
      exact this
    calc ‖p.coeff (k + 1)‖ * ‖(k : ℚ_[ℓ]) + 1‖ ≤ e * 1 :=
          mul_le_mul (hp _) h1 (norm_nonneg _) he
      _ = e := mul_one e
  have hnear : ∀ (X : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (e : ℝ), e ≤ 1 →
      (∀ a b, ‖X a b - Φ a b‖ ≤ e) → ∀ a b, ‖X a b‖ ≤ 1 := by
    intro X e he hXY a b
    have e' : X a b = (X a b - Φ a b) + Φ a b := by ring
    rw [e']
    exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ((hXY a b).trans he) (hΦint a b))

  have hinvmem : ∀ X : Matrix (Fin r) (Fin r) ℚ_[ℓ], X ∈ Algebra.adjoin ℚ_[ℓ] {Φ} →
      IsUnit X.det → X⁻¹ ∈ Algebra.adjoin ℚ_[ℓ] {Φ} := by
    intro X hX hXdet
    have hc0 : X.charpoly.coeff 0 ≠ 0 := by
      intro h
      have hd := Matrix.det_eq_sign_charpoly_coeff X
      rw [h, mul_zero] at hd
      exact hXdet.ne_zero hd
    have h2 : X * Polynomial.aeval X X.charpoly.divX +
        algebraMap ℚ_[ℓ] (Matrix (Fin r) (Fin r) ℚ_[ℓ]) (X.charpoly.coeff 0) = 0 := by
      have := congrArg (Polynomial.aeval X) (Polynomial.X_mul_divX_add X.charpoly)
      rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C,
        Matrix.aeval_self_charpoly] at this
      exact this
    have h3 : X * ((-(X.charpoly.coeff 0)⁻¹) • Polynomial.aeval X X.charpoly.divX) = 1 := by
      rw [Matrix.mul_smul]
      have h4 : X * Polynomial.aeval X X.charpoly.divX =
          -((X.charpoly.coeff 0) • (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ])) := by
        rw [← Algebra.algebraMap_eq_smul_one]
        exact eq_neg_of_add_eq_zero_left h2
      rw [h4, smul_neg, neg_smul, neg_neg, smul_smul, inv_mul_cancel₀ hc0, one_smul]
    rw [Matrix.inv_eq_right_inv h3]
    exact Subalgebra.smul_mem _
      (Algebra.adjoin_singleton_le hX (Polynomial.aeval_mem_adjoin_singleton _ _)) _

  have hpert : ∀ (A B : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (_hA : IsUnit A.det) (C η : ℝ)
      (_hC : 0 ≤ C) (_hη : 0 ≤ η) (_hAinv : ∀ a b, ‖A⁻¹ a b‖ ≤ C)
      (_hBA : ∀ a b, ‖B a b - A a b‖ ≤ η) (_hCη : C * η < 1),
      IsUnit B.det ∧ (∀ a b, ‖B⁻¹ a b‖ ≤ C) ∧ ∀ a b, ‖B⁻¹ a b - A⁻¹ a b‖ ≤ C ^ 2 * η := by
    intro A B hA C η hC hη hAinv hBA hCη
    have hfix : ∀ (X Y E : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (c ε : ℝ), 0 ≤ c → 0 ≤ ε → ε < 1 →
        (∀ a b, ‖Y a b‖ ≤ c) → (∀ a b, ‖E a b‖ ≤ ε) → X = Y + E * X → ∀ a b, ‖X a b‖ ≤ c := by
      intro X Y E c ε hc hε hε1 hY hE hX a b
      have : Nonempty (Fin r × Fin r) := ⟨(a, b)⟩
      obtain ⟨p₀, hp₀⟩ := Finite.exists_max (fun p : Fin r × Fin r => ‖X p.1 p.2‖)
      have hm0 : 0 ≤ ‖X p₀.1 p₀.2‖ := norm_nonneg _
      have hmax : ∀ a' b', ‖X a' b'‖ ≤ ‖X p₀.1 p₀.2‖ := fun a' b' => hp₀ (a', b')
      have hEX := hmul E X ε _ hε hm0 hE hmax
      have h2 : ∀ a' b', ‖X a' b'‖ ≤ max c (ε * ‖X p₀.1 p₀.2‖) := by
        intro a' b'
        have e := congrFun (congrFun hX a') b'
        rw [Matrix.add_apply] at e
        rw [e]
        exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le_max (hY a' b') (hEX a' b'))
      have hmc : ‖X p₀.1 p₀.2‖ ≤ c := by
        by_contra hlt
        push_neg at hlt
        have hmpos : 0 < ‖X p₀.1 p₀.2‖ := lt_of_le_of_lt hc hlt
        have h3 := h2 p₀.1 p₀.2
        have h4 : ε * ‖X p₀.1 p₀.2‖ < ‖X p₀.1 p₀.2‖ := mul_lt_of_lt_one_left hmpos hε1
        rcases le_total c (ε * ‖X p₀.1 p₀.2‖) with h5 | h5
        · rw [max_eq_right h5] at h3; linarith
        · rw [max_eq_left h5] at h3; linarith
      exact (hmax a b).trans hmc
    obtain ⟨D, hDdef⟩ : ∃ D : Matrix (Fin r) (Fin r) ℚ_[ℓ], D = B - A := ⟨_, rfl⟩
    obtain ⟨E, hEdef⟩ : ∃ E : Matrix (Fin r) (Fin r) ℚ_[ℓ], E = -(A⁻¹ * D) := ⟨_, rfl⟩
    have hD : ∀ a b, ‖D a b‖ ≤ η := fun a b => by rw [hDdef, Matrix.sub_apply]; exact hBA a b
    have hε : 0 ≤ C * η := mul_nonneg hC hη
    have hE : ∀ a b, ‖E a b‖ ≤ C * η := fun a b => by
      rw [hEdef, Matrix.neg_apply, norm_neg]; exact hmul _ _ C η hC hη hAinv hD a b
    have hAB : A⁻¹ * B = 1 + A⁻¹ * D := by
      rw [hDdef, Matrix.mul_sub, Matrix.nonsing_inv_mul A hA]; abel
    have hBdet : IsUnit B.det := by
      rw [isUnit_iff_ne_zero]
      intro h0
      obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr h0
      have hv' : E.mulVec v = v := by
        have e1 : (A⁻¹ * B).mulVec v = 0 := by
          rw [← Matrix.mulVec_mulVec, hv, Matrix.mulVec_zero]
        rw [hAB, Matrix.add_mulVec, Matrix.one_mulVec] at e1
        rw [hEdef, Matrix.neg_mulVec]
        exact (eq_neg_of_add_eq_zero_left e1).symm
      have hX : (Matrix.of (fun a (_ : Fin r) => v a) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
          0 + E * Matrix.of (fun a (_ : Fin r) => v a) := by
        ext a b
        rw [zero_add, Matrix.mul_apply]
        simp only [Matrix.of_apply]
        rw [← congrFun hv' a]
        rfl
      have hb := hfix _ 0 E 0 (C * η) le_rfl hε hCη (fun a b => by simp) hE hX
      apply hv0
      funext a
      have := hb a a
      simp only [Matrix.of_apply] at this
      exact norm_le_zero_iff.mp this
    have hfixB : B⁻¹ = A⁻¹ + E * B⁻¹ := by
      have h1 : A⁻¹ = B⁻¹ + A⁻¹ * D * B⁻¹ := by
        calc A⁻¹ = A⁻¹ * (B * B⁻¹) := by rw [Matrix.mul_nonsing_inv B hBdet, Matrix.mul_one]
          _ = (A⁻¹ * B) * B⁻¹ := by rw [Matrix.mul_assoc]
          _ = (1 + A⁻¹ * D) * B⁻¹ := by rw [hAB]
          _ = B⁻¹ + A⁻¹ * D * B⁻¹ := by rw [Matrix.add_mul, Matrix.one_mul]
      rw [hEdef, Matrix.neg_mul]
      calc B⁻¹ = (B⁻¹ + A⁻¹ * D * B⁻¹) + -(A⁻¹ * D * B⁻¹) := by abel
        _ = A⁻¹ + -(A⁻¹ * D * B⁻¹) := by rw [← h1]
    have hBinv := hfix B⁻¹ A⁻¹ E C (C * η) hC hε hCη hAinv hE hfixB
    refine ⟨hBdet, hBinv, fun a b => ?_⟩
    have e : B⁻¹ - A⁻¹ = E * B⁻¹ := by
      nth_rewrite 1 [hfixB]
      abel
    rw [← Matrix.sub_apply, e]
    calc ‖(E * B⁻¹) a b‖ ≤ C * η * C := hmul E B⁻¹ (C * η) C hε hC hE hBinv a b
      _ = C ^ 2 * η := by ring

  have htaylor : ∀ (X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (_hX : ∀ a b, ‖X a b‖ ≤ 1)
      (_hY : ∀ a b, ‖Y a b‖ ≤ 1) (p : Polynomial ℚ_[ℓ]) (_hp : ∀ k, ‖p.coeff k‖ ≤ 1) (η : ℝ)
      (_hη : 0 ≤ η) (_hXY : ∀ a b, ‖Y a b - X a b‖ ≤ η),
      (∀ a b, ‖(Polynomial.aeval Y p - Polynomial.aeval X p) a b‖ ≤ η) ∧
        (Commute X Y → ∀ a b, ‖(Polynomial.aeval Y p - Polynomial.aeval X p -
          Polynomial.aeval X (Polynomial.derivative p) * (Y - X)) a b‖ ≤ η ^ 2) := by
    intro X Y hX hY p hp η hη hXY
    have hadd : ∀ (A B : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (e : ℝ),
        (∀ a b, ‖A a b‖ ≤ e) → (∀ a b, ‖B a b‖ ≤ e) → ∀ a b, ‖(A + B) a b‖ ≤ e := by
      intro A B e hA hB a b
      rw [Matrix.add_apply]
      exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le (hA a b) (hB a b))
    have hsmul : ∀ (c : ℚ_[ℓ]) (A : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (e : ℝ), ‖c‖ ≤ 1 → 0 ≤ e →
        (∀ a b, ‖A a b‖ ≤ e) → ∀ a b, ‖(c • A) a b‖ ≤ e := by
      intro c A e hc he hA a b
      rw [Matrix.smul_apply, smul_eq_mul, norm_mul]
      calc ‖c‖ * ‖A a b‖ ≤ 1 * e := mul_le_mul hc (hA a b) (norm_nonneg _) zero_le_one
        _ = e := one_mul e
    have hsum : ∀ (s : Finset ℕ) (f : ℕ → Matrix (Fin r) (Fin r) ℚ_[ℓ]) (e : ℝ), 0 ≤ e →
        (∀ k ∈ s, ∀ a b, ‖f k a b‖ ≤ e) → ∀ a b, ‖(∑ k ∈ s, f k) a b‖ ≤ e := by
      intro s f e he hf a b
      rw [Matrix.sum_apply]
      exact IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg he (fun k hk => hf k hk a b)
    have hpowX : ∀ n : ℕ, ∀ a b, ‖(X ^ n) a b‖ ≤ 1 := hpowint X hX
    have hE : ∀ a b, ‖(Y - X) a b‖ ≤ η := fun a b => by rw [Matrix.sub_apply]; exact hXY a b
    have hnat : ∀ m : ℕ, ‖((m : ℕ) : ℚ_[ℓ])‖ ≤ 1 := by
      intro m
      have := Padic.norm_int_le_one (p := ℓ) (m : ℤ)
      exact_mod_cast this
    have hη2 : 0 ≤ η ^ 2 := sq_nonneg η
    have s1 : ∀ n : ℕ, ∀ a b, ‖(Y ^ n - X ^ n) a b‖ ≤ η := by
      intro n
      induction n with
      | zero => intro a b; simp [hη]
      | succ n ih =>
        have hid : Y ^ (n + 1) - X ^ (n + 1) = Y * (Y ^ n - X ^ n) + (Y - X) * X ^ n := by
          rw [pow_succ', pow_succ', mul_sub, sub_mul]; abel
        rw [hid]
        apply hadd
        · intro a b; simpa using hmul _ _ 1 η zero_le_one hη hY ih a b
        · intro a b; simpa using hmul _ _ η 1 hη zero_le_one hE (hpowX n) a b
    have s2 : Commute X Y → ∀ n : ℕ, ∀ a b,
        ‖(Y ^ (n + 1) - X ^ (n + 1) - ((n : ℚ_[ℓ]) + 1) • (X ^ n * (Y - X))) a b‖ ≤ η ^ 2 := by
      intro hc n
      have hXE : Commute X (Y - X) := hc.sub_right (Commute.refl X)
      induction n with
      | zero => intro a b; simp [hη2]
      | succ n ih =>
        have hcom : (Y - X) * (X * X ^ n) = X * X ^ n * (Y - X) := by
          rw [← pow_succ']; exact ((hXE.pow_left (n + 1)).eq).symm
        have hid : Y ^ (n + 1 + 1) - X ^ (n + 1 + 1) - (((n + 1 : ℕ) : ℚ_[ℓ]) + 1) •
              (X ^ (n + 1) * (Y - X)) =
            Y * (Y ^ (n + 1) - X ^ (n + 1) - ((n : ℚ_[ℓ]) + 1) • (X ^ n * (Y - X))) +
              ((n : ℚ_[ℓ]) + 1) • ((Y - X) * X ^ n * (Y - X)) := by
          rw [← sub_eq_zero]
          have key : Y ^ (n + 1 + 1) - X ^ (n + 1 + 1) - (((n + 1 : ℕ) : ℚ_[ℓ]) + 1) •
              (X ^ (n + 1) * (Y - X)) -
              (Y * (Y ^ (n + 1) - X ^ (n + 1) - ((n : ℚ_[ℓ]) + 1) • (X ^ n * (Y - X))) +
                ((n : ℚ_[ℓ]) + 1) • ((Y - X) * X ^ n * (Y - X))) =
              (Y - X) * (X * X ^ n) - X * X ^ n * (Y - X) := by
            rw [pow_succ' Y (n + 1), pow_succ' X (n + 1), pow_succ' X n]
            push_cast
            simp only [mul_sub, sub_mul, mul_add, mul_smul_comm, add_smul,
              one_smul, smul_sub, mul_assoc]
            abel
          rw [key, hcom, sub_self]
        rw [hid]
        intro a b
        apply hadd
        · intro a b; simpa using hmul _ _ 1 (η ^ 2) zero_le_one hη2 hY ih a b
        · intro a b
          have hc' : ‖((n : ℚ_[ℓ]) + 1)‖ ≤ 1 := by
            have := hnat (n + 1); push_cast at this; exact this
          refine hsmul _ _ (η ^ 2) hc' hη2 ?_ a b
          intro a b
          have h1 := hmul _ _ η 1 hη zero_le_one hE (hpowX n)
          have h2 := hmul _ _ (η * 1) η (by simpa using hη) hη h1 hE a b
          calc ‖((Y - X) * X ^ n * (Y - X)) a b‖ ≤ η * 1 * η := h2
            _ = η ^ 2 := by ring
    refine ⟨?_, ?_⟩
    · intro a b
      rw [Polynomial.aeval_eq_sum_range, Polynomial.aeval_eq_sum_range, ← Finset.sum_sub_distrib]
      refine hsum _ _ η hη (fun k _ => ?_) a b
      rw [← smul_sub]
      exact hsmul _ _ η (hp k) hη (s1 k)
    · intro hc a b
      set N := p.natDegree with hN
      have hder : (Polynomial.derivative p).natDegree < N + 1 :=
        lt_of_le_of_lt (Polynomial.natDegree_derivative_le p) (by omega)
      rw [Polynomial.aeval_eq_sum_range' (n := N + 2) (by omega) Y,
        Polynomial.aeval_eq_sum_range' (n := N + 2) (by omega) X,
        Polynomial.aeval_eq_sum_range' hder X]
      have heq : ∑ i ∈ Finset.range (N + 2), p.coeff i • Y ^ i -
          ∑ i ∈ Finset.range (N + 2), p.coeff i • X ^ i -
          (∑ i ∈ Finset.range (N + 1), (Polynomial.derivative p).coeff i • X ^ i) * (Y - X) =
          ∑ k ∈ Finset.range (N + 1), p.coeff (k + 1) •
            (Y ^ (k + 1) - X ^ (k + 1) - ((k : ℚ_[ℓ]) + 1) • (X ^ k * (Y - X))) := by
        rw [← Finset.sum_sub_distrib, Finset.sum_range_succ' _ (N + 1), Finset.sum_mul]
        simp only [pow_zero, sub_self, add_zero]
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun k _ => ?_)
        rw [Polynomial.coeff_derivative, smul_mul_assoc, mul_smul, smul_sub, smul_sub]
      rw [heq]
      refine hsum _ _ (η ^ 2) hη2 (fun k _ => ?_) a b
      exact hsmul _ _ (η ^ 2) (hp (k + 1)) hη2 (s2 hc k)

  have hsc : ∀ a : ℚ_[ℓ], Matrix.scalar (Fin r) a = a • (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) := by
    intro a; rw [Matrix.scalar_apply, Matrix.smul_one_eq_diagonal]
  have hcard : Fintype.card (Fin r) = r := Fintype.card_fin r
  have hgdeg : M.charpoly.natDegree = r := by rw [Matrix.charpoly_natDegree_eq_dim, hcard]
  have hsim : ∀ X : Matrix (Fin r) (Fin r) ℚ_[ℓ], X.transpose * J * X = μ • J →
      J⁻¹ * X.transpose * J * X = μ • 1 := by
    intro X hX
    calc J⁻¹ * X.transpose * J * X = J⁻¹ * (X.transpose * J * X) := by simp only [Matrix.mul_assoc]
      _ = μ • 1 := by rw [hX, Matrix.mul_smul, Matrix.nonsing_inv_mul J hJdet]

  have hadj : ∀ (Y : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (p : Polynomial ℚ_[ℓ]),
      Polynomial.aeval (J⁻¹ * Y.transpose * J) p = J⁻¹ * (Polynomial.aeval Y p).transpose * J := by
    intro Y p
    have hpow : ∀ k : ℕ, (J⁻¹ * Y.transpose * J) ^ k = J⁻¹ * (Y ^ k).transpose * J := by
      intro k
      induction k with
      | zero =>
        rw [pow_zero, pow_zero, Matrix.transpose_one, Matrix.mul_one, Matrix.nonsing_inv_mul J hJdet]
      | succ k ih =>
        rw [pow_succ (J⁻¹ * Y.transpose * J), ih, pow_succ' Y, Matrix.transpose_mul]
        calc J⁻¹ * (Y ^ k).transpose * J * (J⁻¹ * Y.transpose * J)
            = J⁻¹ * (Y ^ k).transpose * (J * J⁻¹) * Y.transpose * J := by
              simp only [Matrix.mul_assoc]
          _ = J⁻¹ * ((Y ^ k).transpose * Y.transpose) * J := by
              rw [Matrix.mul_nonsing_inv J hJdet, Matrix.mul_one, Matrix.mul_assoc J⁻¹]
    rw [Polynomial.aeval_eq_sum_range, Polynomial.aeval_eq_sum_range, Matrix.transpose_sum,
      Finset.mul_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hpow, Matrix.transpose_smul, Matrix.mul_smul, Matrix.smul_mul]

  have hstar : ∀ t : ℚ_[ℓ], t ≠ 0 →
      M.charpoly.coeff 0 * M.charpoly.eval t = t ^ r * M.charpoly.eval (μ / t) := by
    intro t ht
    have hNM := hsim M hMJ
    have hkey : (Matrix.scalar (Fin r) t - J⁻¹ * M.transpose * J) * M =
        (-t) • (Matrix.scalar (Fin r) (μ / t) - M) := by
      rw [Matrix.sub_mul, hNM, hsc, hsc, Matrix.smul_mul, Matrix.one_mul, smul_sub, smul_smul,
        show -t * (μ / t) = -μ by field_simp, neg_smul, neg_smul]
      abel
    have hconj : Matrix.scalar (Fin r) t - J⁻¹ * M.transpose * J =
        J⁻¹ * (Matrix.scalar (Fin r) t - M).transpose * J := by
      rw [Matrix.transpose_sub, hsc, Matrix.transpose_smul, Matrix.transpose_one, Matrix.mul_sub,
        Matrix.sub_mul, Matrix.mul_smul, Matrix.mul_one, Matrix.smul_mul,
        Matrix.nonsing_inv_mul J hJdet]
    have hJJ : J⁻¹.det * J.det = 1 := by
      rw [← Matrix.det_mul, Matrix.nonsing_inv_mul J hJdet, Matrix.det_one]
    have h := congrArg Matrix.det hkey
    rw [Matrix.det_mul, Matrix.det_smul, hconj, Matrix.det_mul, Matrix.det_mul,
      Matrix.det_transpose, ← Matrix.eval_charpoly, ← Matrix.eval_charpoly,
      Matrix.det_eq_sign_charpoly_coeff M, hcard, neg_pow t] at h
    have hsq : ((-1 : ℚ_[ℓ]) ^ r) ^ 2 = 1 := by
      rw [← pow_mul, mul_comm, pow_mul, neg_one_sq, one_pow]
    linear_combination (-1 : ℚ_[ℓ]) ^ r * h -
      ((-1 : ℚ_[ℓ]) ^ r) ^ 2 * M.charpoly.eval t * M.charpoly.coeff 0 * hJJ -
      (M.charpoly.coeff 0 * M.charpoly.eval t - t ^ r * M.charpoly.eval (μ / t)) * hsq

  have hH : (∑ k ∈ Finset.range (r + 1),
      Polynomial.monomial (r - k) (M.charpoly.coeff k * μ ^ k)) =
      Polynomial.C (M.charpoly.coeff 0) * M.charpoly := by
    apply Polynomial.eq_of_infinite_eval_eq
    refine Set.Infinite.mono ?_ (Set.Finite.infinite_compl (Set.finite_singleton (0 : ℚ_[ℓ])))
    intro t ht
    have ht0 : t ≠ 0 := ht
    simp only [Set.mem_setOf_eq]
    rw [Polynomial.eval_finset_sum, Polynomial.eval_mul, Polynomial.eval_C, hstar t ht0,
      Polynomial.eval_eq_sum_range (μ / t), hgdeg, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun k hk => ?_)
    have hkr : k ≤ r := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
    have htk : t ^ k ≠ 0 := pow_ne_zero _ ht0
    rw [Polynomial.eval_monomial, ← pow_mul_pow_sub t hkr, div_pow]
    calc M.charpoly.coeff k * μ ^ k * t ^ (r - k)
        = M.charpoly.coeff k * μ ^ k * t ^ (r - k) * (t ^ k * (t ^ k)⁻¹) := by
          rw [mul_inv_cancel₀ htk, mul_one]
      _ = t ^ k * t ^ (r - k) * (M.charpoly.coeff k * (μ ^ k / t ^ k)) := by
          rw [div_eq_mul_inv]; ring

  have hrefl : ∀ w : Matrix (Fin r) (Fin r) ℚ_[ℓ], IsUnit w.det →
      Polynomial.aeval (μ • w⁻¹) M.charpoly * w ^ r =
        M.charpoly.coeff 0 • Polynomial.aeval w M.charpoly := by
    intro w hw
    have hc : Commute w⁻¹ w := by
      show w⁻¹ * w = w * w⁻¹
      rw [Matrix.nonsing_inv_mul w hw, Matrix.mul_nonsing_inv w hw]
    have e2 : Polynomial.aeval w (Polynomial.C (M.charpoly.coeff 0) * M.charpoly) =
        M.charpoly.coeff 0 • Polynomial.aeval w M.charpoly := by
      rw [map_mul, Polynomial.aeval_C, ← Algebra.smul_def]
    rw [← e2, ← hH, map_sum, Polynomial.aeval_eq_sum_range (p := M.charpoly) (μ • w⁻¹), hgdeg,
      Finset.sum_mul]
    refine Finset.sum_congr rfl (fun k hk => ?_)
    have hkr : k ≤ r := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
    rw [Polynomial.aeval_monomial, ← Algebra.smul_def, smul_pow, smul_smul, smul_mul_assoc,
      ← pow_mul_pow_sub w hkr, ← mul_assoc, ← hc.mul_pow, Matrix.nonsing_inv_mul w hw, one_pow,
      Matrix.one_mul]

  have hcomm𝒜 : ∀ X ∈ Algebra.adjoin ℚ_[ℓ] {Φ}, ∀ Y ∈ Algebra.adjoin ℚ_[ℓ] {Φ}, Commute X Y := by
    intro X hX Y hY
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hX hY
    obtain ⟨p, rfl⟩ := hX
    obtain ⟨q, rfl⟩ := hY
    show _ * _ = _ * _
    rw [← map_mul, ← map_mul, mul_comm]

  have hΦs := hsim Φ hΦJ
  have hΦleft : (μ⁻¹ • (J⁻¹ * Φ.transpose * J)) * Φ = 1 := by
    rw [smul_mul_assoc, hΦs, smul_smul, inv_mul_cancel₀ hμ, one_smul]
  have hΦu : IsUnit Φ.det := Matrix.isUnit_det_of_left_inverse hΦleft
  have hΦinv : Φ⁻¹ = μ⁻¹ • (J⁻¹ * Φ.transpose * J) := Matrix.inv_eq_left_inv hΦleft
  have hΦ𝒜 : Φ ∈ Algebra.adjoin ℚ_[ℓ] {Φ} := Algebra.self_mem_adjoin_singleton ℚ_[ℓ] Φ
  have hΦs𝒜 : J⁻¹ * Φ.transpose * J ∈ Algebra.adjoin ℚ_[ℓ] {Φ} := by
    have h1 := Subalgebra.smul_mem _ (hinvmem Φ hΦ𝒜 hΦu) μ
    rwa [hΦinv, smul_smul, mul_inv_cancel₀ hμ, one_smul] at h1
  obtain ⟨N, hN⟩ : ∃ N, N = J⁻¹ * y.transpose * J := ⟨_, rfl⟩
  have hN𝒜 : N ∈ Algebra.adjoin ℚ_[ℓ] {Φ} := by
    have hy' := hy
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hy'
    obtain ⟨p, hp⟩ := hy'
    have hp' : Polynomial.aeval Φ p = y := hp
    rw [hN, ← hp', ← hadj]
    exact Algebra.adjoin_singleton_le hΦs𝒜 (Polynomial.aeval_mem_adjoin_singleton ℚ_[ℓ] _)

  have hB0 : 0 ≤ B := by linarith
  have hA_right : (J⁻¹ * Φ.transpose * J) * (μ⁻¹ • Φ) = 1 := by
    rw [Matrix.mul_smul, hΦs, smul_smul, inv_mul_cancel₀ hμ, one_smul]
  have hAu : IsUnit (J⁻¹ * Φ.transpose * J).det := Matrix.isUnit_det_of_right_inverse hA_right
  have hAinv : (J⁻¹ * Φ.transpose * J)⁻¹ = μ⁻¹ • Φ := Matrix.inv_eq_right_inv hA_right
  have hAinvB : ∀ a b, ‖(J⁻¹ * Φ.transpose * J)⁻¹ a b‖ ≤ B := by
    intro a b
    rw [hAinv, Matrix.smul_apply, smul_eq_mul, norm_mul]
    calc ‖μ⁻¹‖ * ‖Φ a b‖ ≤ B * 1 := mul_le_mul hμiB (hΦint a b) (norm_nonneg _) hB0
      _ = B := mul_one B
  have hNA : ∀ a b, ‖N a b - (J⁻¹ * Φ.transpose * J) a b‖ ≤ B * η * B := by
    intro a b
    have e : N a b - (J⁻¹ * Φ.transpose * J) a b = (J⁻¹ * (y - Φ).transpose * J) a b := by
      rw [hN, Matrix.transpose_sub, Matrix.mul_sub, Matrix.sub_mul, Matrix.sub_apply]
    rw [e]
    have h1 : ∀ a b, ‖(y - Φ).transpose a b‖ ≤ η := by
      intro a b; rw [Matrix.transpose_apply, Matrix.sub_apply]; exact hyΦ b a
    exact hmul _ _ (B * η) B (mul_nonneg hB0 hη) hB0
      (hmul _ _ B η hB0 hη hJiB h1) hJB a b
  have hB35 : B ^ 3 ≤ C * B ^ 5 := by
    have h1 : B ^ 3 ≤ B ^ 5 := pow_le_pow_right₀ hB (by norm_num)
    have h2 : B ^ 5 ≤ C * B ^ 5 := le_mul_of_one_le_left (pow_nonneg hB0 5) hC
    linarith
  have hCη3 : B * (B * η * B) < 1 := by
    have e : B * (B * η * B) = B ^ 3 * η := by ring
    rw [e]
    have := mul_le_mul_of_nonneg_right hB35 hη
    linarith
  obtain ⟨hNu, -, hNinv⟩ := hpert (J⁻¹ * Φ.transpose * J) N hAu B
    (B * η * B) hB0 (mul_nonneg (mul_nonneg hB0 hη) hB0) hAinvB hNA hCη3
  obtain ⟨z, hz⟩ : ∃ z, z = μ • N⁻¹ := ⟨_, rfl⟩
  obtain ⟨ρ, hρdef⟩ : ∃ ρ : ℝ, ρ = B * (B ^ 2 * (B * η * B)) := ⟨_, rfl⟩
  have hzΦ : ∀ a b, ‖z a b - Φ a b‖ ≤ ρ := by
    intro a b
    have e : z a b - Φ a b = μ * (N⁻¹ a b - (J⁻¹ * Φ.transpose * J)⁻¹ a b) := by
      rw [hz, hAinv, Matrix.smul_apply, Matrix.smul_apply, smul_eq_mul, smul_eq_mul, mul_sub,
        ← mul_assoc, mul_inv_cancel₀ hμ, one_mul]
    rw [e, norm_mul, hρdef]
    exact mul_le_mul hμB (hNinv a b) (norm_nonneg _) hB0
  have hz𝒜 : z ∈ Algebra.adjoin ℚ_[ℓ] {Φ} := by
    rw [hz]; exact Subalgebra.smul_mem _ (hinvmem N hN𝒜 hNu) μ

  have hgN : Polynomial.aeval N M.charpoly = 0 := by
    rw [hN, hadj, hgy, Matrix.transpose_zero, Matrix.mul_zero, Matrix.zero_mul]
  have hgz : Polynomial.aeval z M.charpoly = 0 := by
    have h1 := hrefl N hNu
    rw [hgN, smul_zero, ← hz] at h1
    have hNr : IsUnit (N ^ r).det := by rw [Matrix.det_pow]; exact hNu.pow r
    calc Polynomial.aeval z M.charpoly
        = Polynomial.aeval z M.charpoly * N ^ r * (N ^ r)⁻¹ :=
          (Matrix.mul_nonsing_inv_cancel_right _ _ hNr).symm
      _ = 0 := by rw [h1, Matrix.zero_mul]

  have hρ5 : ρ = B ^ 5 * η := by rw [hρdef]; ring
  have hCρ : C * ρ < 1 := by
    rw [hρ5, ← mul_assoc]; exact hsmall
  have hηρ : η ≤ ρ := by
    rw [hρ5]; exact le_mul_of_one_le_left hη (one_le_pow₀ hB)
  have hρ0 : 0 ≤ ρ := hη.trans hηρ
  have hρ1 : ρ < 1 := by
    have := le_mul_of_one_le_left hρ0 hC
    linarith
  have hyint := hnear y η (hηρ.trans hρ1.le) hyΦ
  have hzint := hnear z ρ hρ1.le hzΦ

  have hzy : z = y := by
    by_contra hne
    have hex : ∃ a b, z a b ≠ y a b := by
      by_contra h
      push_neg at h
      exact hne (Matrix.ext h)
    obtain ⟨a₁, b₁, hab₁⟩ := hex
    have : Nonempty (Fin r × Fin r) := ⟨(a₁, b₁)⟩
    obtain ⟨⟨a₀, b₀⟩, hmax⟩ := Finite.exists_max (fun q : Fin r × Fin r => ‖(z - y) q.1 q.2‖)
    obtain ⟨t, ht⟩ : ∃ t : ℝ, t = ‖(z - y) a₀ b₀‖ := ⟨_, rfl⟩
    have hle : ∀ a b, ‖(z - y) a b‖ ≤ t := by
      intro a b; rw [ht]; exact hmax (a, b)
    have htpos : 0 < t := by
      have h1 : 0 < ‖(z - y) a₁ b₁‖ := by
        rw [norm_pos_iff, Matrix.sub_apply, sub_ne_zero]; exact hab₁
      exact lt_of_lt_of_le h1 (hle a₁ b₁)
    have htρ : t ≤ ρ := by
      rw [ht, Matrix.sub_apply]
      have e : z a₀ b₀ - y a₀ b₀ = (z a₀ b₀ - Φ a₀ b₀) + (-(y a₀ b₀ - Φ a₀ b₀)) := by ring
      rw [e]
      refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le (hzΦ a₀ b₀) ?_)
      rw [norm_neg]; exact (hyΦ a₀ b₀).trans hηρ
    have hzy' : ∀ a b, ‖z a b - y a b‖ ≤ t := by
      intro a b; rw [← Matrix.sub_apply]; exact hle a b
    have hT := htaylor y z hyint hzint M.charpoly hMint t htpos.le hzy'
    have hDg : ∀ a b,
        ‖(Polynomial.aeval y (Polynomial.derivative M.charpoly) * (z - y)) a b‖ ≤ t ^ 2 := by
      intro a b
      have := hT.2 (hcomm𝒜 y hy z hz𝒜) a b
      rwa [hgz, hgy, sub_zero, zero_sub, Matrix.neg_apply, norm_neg] at this
    have hgd_int : ∀ k, ‖(Polynomial.derivative M.charpoly).coeff k‖ ≤ 1 :=
      hderiv _ 1 zero_le_one hMint
    have hFD : ∀ a b, ‖(Polynomial.aeval Φ (Polynomial.derivative Φ.charpoly) -
        Polynomial.aeval y (Polynomial.derivative M.charpoly)) a b‖ ≤ η := by
      intro a b
      have e : (Polynomial.aeval Φ (Polynomial.derivative Φ.charpoly) -
          Polynomial.aeval y (Polynomial.derivative M.charpoly)) a b =
          (Polynomial.aeval Φ (Polynomial.derivative (Φ.charpoly - M.charpoly))) a b +
          -((Polynomial.aeval y (Polynomial.derivative M.charpoly) -
            Polynomial.aeval Φ (Polynomial.derivative M.charpoly)) a b) := by
        rw [Polynomial.derivative_sub, map_sub, Matrix.sub_apply, Matrix.sub_apply,
          Matrix.sub_apply]
        ring
      rw [e]
      refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ ?_)
      · refine hcoef Φ hΦint _ η hη ?_ a b
        refine hderiv _ η hη (fun k => ?_)
        rw [Polynomial.coeff_sub, norm_sub_rev]
        exact hMΦ k
      · rw [norm_neg]
        exact (htaylor Φ y hΦint hyint _ hgd_int η hη hyΦ).1 a b
    have hid : z - y = W * ((Polynomial.aeval Φ (Polynomial.derivative Φ.charpoly) -
        Polynomial.aeval y (Polynomial.derivative M.charpoly)) * (z - y)) +
        W * (Polynomial.aeval y (Polynomial.derivative M.charpoly) * (z - y)) := by
      rw [← Matrix.mul_add, Matrix.sub_mul, sub_add_cancel, ← Matrix.mul_assoc, hWF,
        Matrix.one_mul]
    have hb1 := hmul W _ C (η * t) (by linarith) (mul_nonneg hη htpos.le) hWC
      (hmul _ _ η t hη htpos.le hFD hle) a₀ b₀
    have hb2 := hmul W _ C (t ^ 2) (by linarith) (sq_nonneg t) hWC hDg a₀ b₀
    have htle : t ≤ max (C * (η * t)) (C * t ^ 2) := by
      have h3 := (IsUltrametricDist.norm_add_le_max _ _).trans (max_le_max hb1 hb2)
      rw [← Matrix.add_apply, ← hid, ← ht] at h3
      exact h3
    have hCη : C * η < 1 := by
      have := mul_le_mul_of_nonneg_left hηρ (by linarith : (0 : ℝ) ≤ C)
      linarith
    have hCt : C * t < 1 := by
      have := mul_le_mul_of_nonneg_left htρ (by linarith : (0 : ℝ) ≤ C)
      linarith
    rcases le_max_iff.mp htle with h | h
    · nlinarith [mul_pos (sub_pos.mpr hCη) htpos]
    · nlinarith [mul_pos (sub_pos.mpr hCt) htpos]

  have hNy : N * y = μ • 1 := by
    rw [← hzy, hz, Matrix.mul_smul, Matrix.mul_nonsing_inv N hNu]
  calc y.transpose * J * y = (J * J⁻¹) * y.transpose * J * y := by
        rw [Matrix.mul_nonsing_inv J hJdet, Matrix.one_mul]
    _ = J * (N * y) := by rw [hN]; simp only [Matrix.mul_assoc]
    _ = μ • J := by rw [hNy, Matrix.mul_smul, Matrix.mul_one]

theorem wc_block_charpoly_reach (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r k p : ℕ)
    (J : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (hJ : J.transpose = -J) (hJdet : IsUnit J.det)
    (δ : Fin k → Fin r → ℚ_[ℓ]) (β : Fin k → Fin p)
    (hspan : Submodule.span ℚ_[ℓ] (Set.range δ) = ⊤)
    (horth : ∀ i j, β i ≠ β j → ∑ a, δ i a * J.mulVec (δ j) a = 0)
    (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (μ : ℚ_[ℓ]) (hμ : μ ≠ 0)
    (hΦint : ∀ a b, ‖Φ a b‖ ≤ 1) (hΦJ : Φ.transpose * J * Φ = μ • J)
    (hΦBP : ∀ i, Φ.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i}))
    (hsep : Φ.charpoly.Separable) :
    ∀ m' : ℕ, ∃ m₀ : ℕ, ∀ s : Matrix (Fin r) (Fin r) ℚ_[ℓ], s.transpose * J * s = J →
      (∀ a b, ‖s a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(m₀ : ℤ))) →
      (Φ * s).charpoly.Separable ∧ ∃ s' : Matrix (Fin r) (Fin r) ℚ_[ℓ],
        s'.transpose * J * s' = J ∧
        (∀ i, s'.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})) ∧
        (∀ a b, ‖s' a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(m' : ℤ))) ∧
        (Φ * s').charpoly = (Φ * s).charpoly :=
by
  classical
  intro m'
  have hℓ1 : (1 : ℝ) < ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt
  have hℓ0 : (0 : ℝ) < ℓ := by linarith

  have hmul : ∀ (X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (e₁ e₂ : ℝ), 0 ≤ e₁ → 0 ≤ e₂ →
      (∀ a b, ‖X a b‖ ≤ e₁) → (∀ a b, ‖Y a b‖ ≤ e₂) → ∀ a b, ‖(X * Y) a b‖ ≤ e₁ * e₂ := by
    intro X Y e₁ e₂ h1 h2 hX hY a b
    rw [Matrix.mul_apply]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (mul_nonneg h1 h2)
    intro c _
    rw [norm_mul]
    exact mul_le_mul (hX a c) (hY c b) (norm_nonneg _) h1
  have hbound : ∀ X : Matrix (Fin r) (Fin r) ℚ_[ℓ], ∃ c : ℝ, 1 ≤ c ∧ ∀ a b, ‖X a b‖ ≤ c := by
    intro X
    refine ⟨1 + ∑ a, ∑ b, ‖X a b‖, ?_, ?_⟩
    · have : 0 ≤ ∑ a, ∑ b, ‖X a b‖ :=
        Finset.sum_nonneg (fun a _ => Finset.sum_nonneg (fun b _ => norm_nonneg _))
      linarith
    · intro a b
      have h1 : ‖X a b‖ ≤ ∑ b', ‖X a b'‖ :=
        Finset.single_le_sum (f := fun b' => ‖X a b'‖) (fun b' _ => norm_nonneg _)
          (Finset.mem_univ b)
      have h2 : ∑ b', ‖X a b'‖ ≤ ∑ a', ∑ b', ‖X a' b'‖ :=
        Finset.single_le_sum (f := fun a' => ∑ b', ‖X a' b'‖)
          (fun a' _ => Finset.sum_nonneg (fun b' _ => norm_nonneg _)) (Finset.mem_univ a)
      linarith
  have h1int : ∀ a b, ‖(1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1 := by
    intro a b
    by_cases hab : a = b
    · subst hab; simp
    · simp [Matrix.one_apply_ne hab]
  have hnear : ∀ (X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (e : ℝ), e ≤ 1 → (∀ a b, ‖Y a b‖ ≤ 1) →
      (∀ a b, ‖X a b - Y a b‖ ≤ e) → ∀ a b, ‖X a b‖ ≤ 1 := by
    intro X Y e he hY hXY a b
    have e' : X a b = (X a b - Y a b) + Y a b := by ring
    rw [e']
    exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ((hXY a b).trans he) (hY a b))
  have hpowint : ∀ (X : Matrix (Fin r) (Fin r) ℚ_[ℓ]), (∀ a b, ‖X a b‖ ≤ 1) →
      ∀ n : ℕ, ∀ a b, ‖(X ^ n) a b‖ ≤ 1 := by
    intro X hX n
    induction n with
    | zero => intro a b; rw [pow_zero]; exact h1int a b
    | succ n ih =>
      intro a b
      rw [pow_succ]
      have := hmul _ _ 1 1 zero_le_one zero_le_one ih hX a b
      linarith
  have hcoef : ∀ (p : Polynomial ℚ_[ℓ]) (e : ℝ), 0 ≤ e → (∀ k, ‖p.coeff k‖ ≤ e) →
      ∀ a b, ‖(Polynomial.aeval Φ p) a b‖ ≤ e := by
    intro p e he hp a b
    rw [Polynomial.aeval_eq_sum_range, Matrix.sum_apply]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg he
    intro i _
    rw [Matrix.smul_apply, smul_eq_mul, norm_mul]
    calc ‖p.coeff i‖ * ‖(Φ ^ i) a b‖ ≤ e * 1 :=
          mul_le_mul (hp i) (hpowint Φ hΦint i a b) (norm_nonneg _) he
      _ = e := mul_one e
  have hderiv : ∀ (p : Polynomial ℚ_[ℓ]) (e : ℝ), 0 ≤ e → (∀ k, ‖p.coeff k‖ ≤ e) →
      ∀ k, ‖(Polynomial.derivative p).coeff k‖ ≤ e := by
    intro p e he hp k
    rw [Polynomial.coeff_derivative, norm_mul]
    have h1 : ‖((k : ℚ_[ℓ]) + 1)‖ ≤ 1 := by
      have := Padic.norm_int_le_one (p := ℓ) ((k : ℤ) + 1)
      push_cast at this
      exact this
    calc ‖p.coeff (k + 1)‖ * ‖(k : ℚ_[ℓ]) + 1‖ ≤ e * 1 :=
          mul_le_mul (hp _) h1 (norm_nonneg _) he
      _ = e := mul_one e

  have hBPmul : ∀ X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ],
      (∀ i, X.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})) →
      (∀ i, Y.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})) →
      ∀ i, (X * Y).mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i}) := by
    intro X Y hX hY i
    have hle : Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i}) ≤
        (Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})).comap (Matrix.toLin' X) := by
      rw [Submodule.span_le]
      rintro _ ⟨j, hj, rfl⟩
      have hj' : β j = β i := hj
      have hset : {j' | β j' = β j} = {j' | β j' = β i} := by
        ext j'
        simp only [Set.mem_setOf_eq]
        rw [hj']
      show Matrix.toLin' X (δ j) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})
      rw [Matrix.toLin'_apply, ← hset]
      exact hX j
    rw [← Matrix.mulVec_mulVec]
    have h := hle (hY i)
    rw [Submodule.mem_comap, Matrix.toLin'_apply] at h
    exact h
  have hBP𝒜 : ∀ X ∈ Algebra.adjoin ℚ_[ℓ] {Φ},
      ∀ i, X.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i}) := by
    intro X hX
    induction hX using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact hΦBP
    | algebraMap c =>
      intro i
      rw [Algebra.algebraMap_eq_smul_one, Matrix.smul_mulVec, Matrix.one_mulVec]
      exact Submodule.smul_mem _ c (Submodule.subset_span ⟨i, rfl, rfl⟩)
    | add x y _ _ hx hy =>
      intro i
      rw [Matrix.add_mulVec]
      exact Submodule.add_mem _ (hx i) (hy i)
    | mul x y _ _ hx hy => exact hBPmul x y hx hy

  have hΦ𝒜 : Φ ∈ Algebra.adjoin ℚ_[ℓ] {Φ} := Algebra.self_mem_adjoin_singleton ℚ_[ℓ] Φ
  have hfΦ : Polynomial.aeval Φ Φ.charpoly = 0 := Matrix.aeval_self_charpoly Φ
  obtain ⟨a₀, b₀, hab⟩ := (Polynomial.separable_def _).mp hsep
  obtain ⟨W, hWdef⟩ : ∃ W, W = Polynomial.aeval Φ b₀ := ⟨_, rfl⟩
  have hW𝒜 : W ∈ Algebra.adjoin ℚ_[ℓ] {Φ} := by
    rw [hWdef]; exact Polynomial.aeval_mem_adjoin_singleton ℚ_[ℓ] Φ
  have hWF : W * Polynomial.aeval Φ (Polynomial.derivative Φ.charpoly) = 1 := by
    have := congrArg (Polynomial.aeval Φ) hab
    rw [map_add, map_mul, map_mul, hfΦ, mul_zero, zero_add, map_one] at this
    rw [hWdef]; exact this

  have hJ0 : J.det ≠ 0 := hJdet.ne_zero
  have hΦdet0 : Φ.det ≠ 0 := by
    intro h0
    have h := congrArg Matrix.det hΦJ
    rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, h0, Matrix.det_smul] at h
    have h2 : μ ^ Fintype.card (Fin r) * J.det = 0 := by rw [← h]; ring
    exact mul_ne_zero (pow_ne_zero _ hμ) hJ0 h2
  have hΦu : IsUnit Φ.det := isUnit_iff_ne_zero.mpr hΦdet0
  have hΦi𝒜 : Φ⁻¹ ∈ Algebra.adjoin ℚ_[ℓ] {Φ} := wc_bcr_adjoin_inv_mem ℓ r Φ Φ hΦ𝒜 hΦu

  obtain ⟨cJ, hcJ1, hcJ⟩ := hbound J
  obtain ⟨cJi, hcJi1, hcJi⟩ := hbound J⁻¹
  obtain ⟨C, hC1, hWC⟩ := hbound W
  obtain ⟨P, hP1, hPC⟩ := hbound Φ⁻¹
  obtain ⟨B, hBdef⟩ : ∃ B : ℝ, B = cJ + cJi + ‖μ‖ + ‖μ⁻¹‖ := ⟨_, rfl⟩
  have hμ0 := norm_nonneg μ
  have hμi0 := norm_nonneg μ⁻¹
  have hB1 : 1 ≤ B := by rw [hBdef]; linarith
  have hJB : ∀ a b, ‖J a b‖ ≤ B := fun a b => by have := hcJ a b; rw [hBdef]; linarith
  have hJiB : ∀ a b, ‖J⁻¹ a b‖ ≤ B := fun a b => by have := hcJi a b; rw [hBdef]; linarith
  have hμB : ‖μ‖ ≤ B := by rw [hBdef]; linarith
  have hμiB : ‖μ⁻¹‖ ≤ B := by rw [hBdef]; linarith
  have hB5 : 1 ≤ B ^ 5 := one_le_pow₀ hB1
  obtain ⟨v, hvint, hvdet⟩ := wc_bcr_cyclic_vector ℓ r Φ hsep
  obtain ⟨K₀, hK₀⟩ : ∃ K : Matrix (Fin r) (Fin r) ℚ_[ℓ],
      K = Matrix.of (fun a k : Fin r => ((Φ ^ (k : ℕ)).mulVec v) a) := ⟨_, rfl⟩
  rw [← hK₀] at hvdet
  have hd₀ : 0 < ‖K₀.det‖ := norm_pos_iff.mpr hvdet.ne_zero
  have hmv : ∀ (X : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (e : ℝ), 0 ≤ e → (∀ a b, ‖X a b‖ ≤ e) →
      ∀ a, ‖X.mulVec v a‖ ≤ e := by
    intro X e he hX a
    simp only [Matrix.mulVec, dotProduct]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg he
    intro b _
    rw [norm_mul]
    calc ‖X a b‖ * ‖v b‖ ≤ e * 1 := mul_le_mul (hX a b) (hvint b) (norm_nonneg _) he
      _ = e := mul_one e
  obtain ⟨c, hc⟩ := pow_unbounded_of_one_lt C hℓ1
  have hm'pos : (0 : ℝ) < (ℓ : ℝ) ^ (-(m' : ℤ)) := by positivity
  obtain ⟨θ, hθdef⟩ : ∃ θ : ℝ, θ = min (min (1 / (C * B ^ 5)) ‖K₀.det‖)
      ((ℓ : ℝ) ^ (-(m' : ℤ)) / P) := ⟨_, rfl⟩
  have hθ0 : 0 < θ := by
    rw [hθdef]
    refine lt_min (lt_min (by positivity) hd₀) (by positivity)
  obtain ⟨N, hN⟩ := pow_unbounded_of_one_lt θ⁻¹ hℓ1
  obtain ⟨τ, hτdef⟩ : ∃ τ : ℝ, τ = (ℓ : ℝ) ^ (-(N : ℤ)) := ⟨_, rfl⟩
  have hτ0 : 0 ≤ τ := by rw [hτdef]; positivity
  have hτθ : τ < θ := by
    have e : τ = ((ℓ : ℝ) ^ N)⁻¹ := by rw [hτdef, zpow_neg, zpow_natCast]
    rw [e, inv_lt_comm₀ (by positivity) hθ0]
    exact hN
  have hτ1 : τ * (C * B ^ 5) < 1 := by
    have : τ < 1 / (C * B ^ 5) :=
      lt_of_lt_of_le hτθ (by rw [hθdef]; exact (min_le_left _ _).trans (min_le_left _ _))
    rwa [lt_div_iff₀ (by positivity)] at this
  have hτd : τ < ‖K₀.det‖ :=
    lt_of_lt_of_le hτθ (by rw [hθdef]; exact (min_le_left _ _).trans (min_le_right _ _))
  have hτP : τ * P < (ℓ : ℝ) ^ (-(m' : ℤ)) := by
    have : τ < (ℓ : ℝ) ^ (-(m' : ℤ)) / P :=
      lt_of_lt_of_le hτθ (by rw [hθdef]; exact min_le_right _ _)
    rwa [lt_div_iff₀ (by positivity)] at this
  obtain ⟨ε, hεdef⟩ : ∃ ε : ℝ, ε = (ℓ : ℝ) ^ (-((c + N : ℕ) : ℤ)) := ⟨_, rfl⟩
  have hε0 : 0 ≤ ε := by rw [hεdef]; positivity
  have hε1 : ε ≤ 1 := by rw [hεdef]; exact zpow_le_one_of_nonpos₀ hℓ1.le (by omega)
  have hCc : C * ((ℓ : ℝ) ^ c)⁻¹ ≤ 1 := by
    rw [← div_eq_mul_inv, div_le_one (by positivity)]; exact hc.le
  have hητ : C * ε ≤ τ := by
    have e : ε = ((ℓ : ℝ) ^ c)⁻¹ * τ := by
      rw [hεdef, hτdef, Nat.cast_add, neg_add, zpow_add₀ hℓ0.ne']
      simp only [zpow_neg, zpow_natCast]
    rw [e, ← mul_assoc]
    calc C * ((ℓ : ℝ) ^ c)⁻¹ * τ ≤ 1 * τ := mul_le_mul_of_nonneg_right hCc hτ0
      _ = τ := one_mul τ
  obtain ⟨η, hηdef⟩ : ∃ η : ℝ, η = C * ε := ⟨_, rfl⟩
  rw [← hηdef] at hητ
  have hη0 : 0 ≤ η := by rw [hηdef]; positivity
  have hεη : ε ≤ η := by rw [hηdef]; nlinarith
  have hsmall : C * B ^ 5 * η < 1 := by
    have : C * B ^ 5 * η ≤ τ * (C * B ^ 5) := by
      rw [mul_comm τ]; exact mul_le_mul_of_nonneg_left hητ (by positivity)
    linarith
  have hCη : C * η < 1 := by
    have : C * η ≤ C * B ^ 5 * η := by
      have h := mul_le_mul_of_nonneg_left hB5 (by positivity : 0 ≤ C * η)
      linarith
    linarith
  have hεC : ε * C ^ 2 < 1 := by
    have e : ε * C ^ 2 = C * η := by rw [hηdef]; ring
    rw [e]; exact hCη
  have hη1 : η ≤ 1 := by
    have : η ≤ C * η := by nlinarith
    linarith

  refine ⟨c + N, ?_⟩
  intro s hsJ hs1
  rw [← hεdef] at hs1
  have hsint : ∀ a b, ‖s a b‖ ≤ 1 := hnear s 1 ε hε1 h1int hs1
  have hMint : ∀ a b, ‖(Φ * s) a b‖ ≤ 1 := by
    intro a b
    have := hmul Φ s 1 1 zero_le_one zero_le_one hΦint hsint a b
    linarith
  have hMΦ : ∀ a b, ‖(Φ * s) a b - Φ a b‖ ≤ ε := by
    intro a b
    have e : (Φ * s) a b - Φ a b = (Φ * (s - 1)) a b := by
      rw [Matrix.mul_sub, Matrix.mul_one, Matrix.sub_apply]
    rw [e]
    have := hmul Φ (s - 1) 1 ε zero_le_one hε0 hΦint
      (fun a b => by rw [Matrix.sub_apply]; exact hs1 a b) a b
    linarith
  have hMJ : (Φ * s).transpose * J * (Φ * s) = μ • J := by
    rw [Matrix.transpose_mul]
    calc s.transpose * Φ.transpose * J * (Φ * s)
        = s.transpose * (Φ.transpose * J * Φ) * s := by simp only [Matrix.mul_assoc]
      _ = μ • (s.transpose * J * s) := by rw [hΦJ, Matrix.mul_smul, Matrix.smul_mul]
      _ = μ • J := by rw [hsJ]
  obtain ⟨hgf, hgint⟩ := wc_bcr_charpoly_coeff_close ℓ r (c + N) (Φ * s) Φ hMint hΦint
    (by rw [← hεdef]; exact hMΦ)
  set g := (Φ * s).charpoly with hg
  have hgf' : ∀ k, ‖g.coeff k - Φ.charpoly.coeff k‖ ≤ ε := by rw [hεdef]; exact hgf
  have hgfη : ∀ k, ‖g.coeff k - Φ.charpoly.coeff k‖ ≤ η := fun k => (hgf' k).trans hεη

  obtain ⟨y, hy𝒜, hgy, hyΦ⟩ := wc_bcr_newton_root ℓ r Φ W hΦint Φ.charpoly g C ε hfΦ hgint
    hW𝒜 hWF hC1 hε0 hWC hgf' hεC
  rw [← hηdef] at hyΦ

  have hyJ : y.transpose * J * y = μ • J :=
    wc_bcr_similitude_root_fixed ℓ r J Φ (Φ * s) W y μ B C η hJdet hμ hΦint hΦJ hMJ hgint
      hgfη hW𝒜 hWF hWC hy𝒜 hgy hyΦ hB1 hC1 hη0 hJB hJiB hμB hμiB hsmall

  have hyint : ∀ a b, ‖y a b‖ ≤ 1 := hnear y Φ η hη1 hΦint hyΦ
  have hpowclose : ∀ n : ℕ, ∀ a b, ‖(y ^ n - Φ ^ n) a b‖ ≤ η := by
    intro n
    have h := (wc_bcr_poly_taylor_bound ℓ r Φ y hΦint hyint (Polynomial.X ^ n)
      (fun k => by rw [Polynomial.coeff_X_pow]; split_ifs <;> simp) η hη0 hyΦ).1
    rw [Polynomial.aeval_X_pow, Polynomial.aeval_X_pow] at h
    exact h
  obtain ⟨K₁, hK₁⟩ : ∃ K : Matrix (Fin r) (Fin r) ℚ_[ℓ],
      K = Matrix.of (fun a k : Fin r => ((y ^ (k : ℕ)).mulVec v) a) := ⟨_, rfl⟩
  have hK₀int : ∀ a b, ‖K₀ a b‖ ≤ 1 := by
    intro a b
    rw [hK₀, Matrix.of_apply]
    exact hmv _ 1 zero_le_one (hpowint Φ hΦint _) a
  have hK₁int : ∀ a b, ‖K₁ a b‖ ≤ 1 := by
    intro a b
    rw [hK₁, Matrix.of_apply]
    exact hmv _ 1 zero_le_one (hpowint y hyint _) a
  have hK : ∀ a b, ‖K₁ a b - K₀ a b‖ ≤ (ℓ : ℝ) ^ (-(N : ℤ)) := by
    intro a b
    have e : K₁ a b - K₀ a b = ((y ^ (b : ℕ) - Φ ^ (b : ℕ)).mulVec v) a := by
      rw [hK₁, hK₀, Matrix.of_apply, Matrix.of_apply, Matrix.sub_mulVec, Pi.sub_apply]
    rw [e, ← hτdef]
    exact (hmv _ η hη0 (hpowclose b) a).trans hητ
  have hKdet : IsUnit K₁.det := by
    obtain ⟨hc0, _⟩ := wc_bcr_charpoly_coeff_close ℓ r N K₁ K₀ hK₁int hK₀int hK
    have hdd : ‖K₁.det - K₀.det‖ ≤ τ := by
      rw [Matrix.det_eq_sign_charpoly_coeff K₁, Matrix.det_eq_sign_charpoly_coeff K₀, ← mul_sub,
        norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul, hτdef]
      exact hc0 0
    rw [isUnit_iff_ne_zero]
    intro h0
    rw [h0, zero_sub, norm_neg] at hdd
    linarith
  have hKdet' : IsUnit (Matrix.of (fun a k : Fin r => ((y ^ (k : ℕ)).mulVec v) a)).det := by
    rw [← hK₁]; exact hKdet
  have hFu : IsUnit (Polynomial.aeval Φ (Polynomial.derivative Φ.charpoly)).det :=
    Matrix.isUnit_det_of_left_inverse hWF
  have hFinv : (Polynomial.aeval Φ (Polynomial.derivative Φ.charpoly))⁻¹ = W :=
    Matrix.inv_eq_left_inv hWF
  have hg'int : ∀ k, ‖(Polynomial.derivative g).coeff k‖ ≤ 1 :=
    hderiv g 1 zero_le_one hgint
  have hg'close : ∀ a b, ‖(Polynomial.aeval y (Polynomial.derivative g)) a b -
      (Polynomial.aeval Φ (Polynomial.derivative Φ.charpoly)) a b‖ ≤ η := by
    intro a b
    have e : (Polynomial.aeval y (Polynomial.derivative g)) a b -
        (Polynomial.aeval Φ (Polynomial.derivative Φ.charpoly)) a b =
        (Polynomial.aeval y (Polynomial.derivative g) -
          Polynomial.aeval Φ (Polynomial.derivative g)) a b +
        (Polynomial.aeval Φ (Polynomial.derivative (g - Φ.charpoly))) a b := by
      rw [Polynomial.derivative_sub, map_sub, Matrix.sub_apply, Matrix.sub_apply]
      ring
    rw [e]
    refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ ?_)
    · exact (wc_bcr_poly_taylor_bound ℓ r Φ y hΦint hyint _ hg'int η hη0 hyΦ).1 a b
    · refine hcoef _ η hη0 ?_ a b
      refine hderiv _ η hη0 (fun k => ?_)
      rw [Polynomial.coeff_sub]
      exact hgfη k
  obtain ⟨hg'u, _, _⟩ := wc_bcr_inverse_perturb ℓ r
    (Polynomial.aeval Φ (Polynomial.derivative Φ.charpoly))
    (Polynomial.aeval y (Polynomial.derivative g)) hFu C η (by linarith) hη0
    (by rw [hFinv]; exact hWC) hg'close hCη
  have hgmonic : g.Monic := Matrix.charpoly_monic _
  have hgdeg : g.natDegree = r := by rw [hg, Matrix.charpoly_natDegree_eq_dim, Fintype.card_fin]
  obtain ⟨hychar, hsepimp⟩ := wc_bcr_krylov_charpoly ℓ r y v hKdet' g hgmonic hgdeg hgy
  have hgsep : g.Separable := hsepimp hg'u

  have hΦiJ : (Φ⁻¹).transpose * J * Φ⁻¹ = μ⁻¹ • J := by
    have h1 : (Φ⁻¹).transpose * (Φ.transpose * J * Φ) * Φ⁻¹ = J := by
      have e1 : (Φ⁻¹).transpose * Φ.transpose = 1 := by
        rw [← Matrix.transpose_mul, Matrix.mul_nonsing_inv Φ hΦu, Matrix.transpose_one]
      calc (Φ⁻¹).transpose * (Φ.transpose * J * Φ) * Φ⁻¹
          = ((Φ⁻¹).transpose * Φ.transpose) * J * (Φ * Φ⁻¹) := by simp only [Matrix.mul_assoc]
        _ = J := by rw [e1, Matrix.mul_nonsing_inv Φ hΦu, Matrix.one_mul, Matrix.mul_one]
    rw [hΦJ, Matrix.mul_smul, Matrix.smul_mul] at h1
    calc (Φ⁻¹).transpose * J * Φ⁻¹ = μ⁻¹ • (μ • ((Φ⁻¹).transpose * J * Φ⁻¹)) := by
          rw [smul_smul, inv_mul_cancel₀ hμ, one_smul]
      _ = μ⁻¹ • J := by rw [h1]
  refine ⟨hgsep, Φ⁻¹ * y, ?_, ?_, ?_, ?_⟩
  · rw [Matrix.transpose_mul]
    calc y.transpose * (Φ⁻¹).transpose * J * (Φ⁻¹ * y)
        = y.transpose * ((Φ⁻¹).transpose * J * Φ⁻¹) * y := by simp only [Matrix.mul_assoc]
      _ = μ⁻¹ • (y.transpose * J * y) := by rw [hΦiJ, Matrix.mul_smul, Matrix.smul_mul]
      _ = J := by rw [hyJ, smul_smul, inv_mul_cancel₀ hμ, one_smul]
  · exact hBP𝒜 _ (Subalgebra.mul_mem _ hΦi𝒜 hy𝒜)
  · intro a b
    have e : (Φ⁻¹ * y) a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b = (Φ⁻¹ * (y - Φ)) a b := by
      rw [Matrix.mul_sub, Matrix.nonsing_inv_mul Φ hΦu, Matrix.sub_apply]
    rw [e]
    have h := hmul Φ⁻¹ (y - Φ) P η (by linarith) hη0 hPC
      (fun a b => by rw [Matrix.sub_apply]; exact hyΦ a b) a b
    have h2 : P * η ≤ P * τ := mul_le_mul_of_nonneg_left hητ (by linarith)
    linarith
  · rw [← Matrix.mul_assoc, Matrix.mul_nonsing_inv Φ hΦu, Matrix.one_mul, hychar]

theorem wc_bsp_charpoly_rank_one_affine {F : Type*} [Field F] [Infinite F] (r : ℕ)
    (X : Matrix (Fin r) (Fin r) F) (u w : Fin r → F) (c : F) :
    (X + c • Matrix.vecMulVec u w).charpoly =
      X.charpoly + Polynomial.C c * ((X + Matrix.vecMulVec u w).charpoly - X.charpoly) :=
by
  classical
  have s1 : ∀ (A : Matrix (Fin r) (Fin r) F), IsUnit A.det → ∀ c' : F,
      (A - c' • Matrix.vecMulVec u w).det =
        A.det * (1 - c' * (Matrix.replicateRow Unit w * A⁻¹ * Matrix.replicateCol Unit u) () ()) := by
    intro A hA c'
    have e : A - c' • Matrix.vecMulVec u w =
        A + Matrix.replicateCol Unit ((-c') • u) * Matrix.replicateRow Unit w := by
      rw [← Matrix.vecMulVec_eq, Matrix.smul_vecMulVec, neg_smul, sub_eq_add_neg]
    rw [e, Matrix.det_add_replicateCol_mul_replicateRow hA, Matrix.det_unique (n := Unit),
      Matrix.replicateCol_smul, Matrix.mul_smul]
    simp only [Matrix.add_apply, Matrix.smul_apply, Matrix.one_apply_eq, smul_eq_mul]
    have hd : (default : Unit) = () := rfl
    rw [hd]
    ring
  apply Polynomial.eq_of_infinite_eval_eq
  have hfin : {t : F | X.charpoly.IsRoot t}.Finite :=
    Polynomial.finite_setOfPred_isRoot (Matrix.charpoly_monic X).ne_zero
  refine Set.Infinite.mono ?_ hfin.infinite_compl
  intro t ht
  simp only [Set.mem_compl_iff, Set.mem_setOf_eq, Polynomial.IsRoot.def] at ht
  simp only [Set.mem_setOf_eq, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
    Polynomial.eval_sub, Matrix.eval_charpoly] at ht ⊢
  have hA : IsUnit (Matrix.scalar (Fin r) t - X).det := isUnit_iff_ne_zero.mpr ht
  have h1 := s1 _ hA 1
  rw [one_smul] at h1
  rw [sub_add_eq_sub_sub, sub_add_eq_sub_sub, s1 _ hA c, h1]
  ring

theorem wc_bsp_pencil_more_roots {K : Type*} [Field K] [IsAlgClosed K] [CharZero K]
    [DecidableEq K] (f D : Polynomial K) (a : K) (hf : f.Monic) (hD : D.degree < f.degree)
    (hm : 2 ≤ f.rootMultiplicity a)
    (hdiv : ¬ (Polynomial.X - Polynomial.C a) ^ f.rootMultiplicity a ∣ D) :
    {c : K | (f + Polynomial.C c * D).roots.toFinset.card ≤ f.roots.toFinset.card}.Finite :=
by
  have hf0 : f ≠ 0 := hf.ne_zero
  have hD0 : D ≠ 0 := by
    rintro rfl
    exact hdiv (dvd_zero _)
  obtain ⟨G, hGdef⟩ : ∃ G, G = gcd f D := ⟨_, rfl⟩
  have hG0 : G ≠ 0 := by
    intro h
    rw [hGdef, gcd_eq_zero_iff] at h
    exact hf0 h.1
  have hGD : G ∣ D := by rw [hGdef]; exact gcd_dvd_right f D
  obtain ⟨F, hF⟩ : G ∣ f := by rw [hGdef]; exact gcd_dvd_left f D
  obtain ⟨Q, hQ⟩ := hGD
  have hcop : IsCoprime F Q := by
    have h := isCoprime_div_gcd_div_gcd (p := f) hD0
    rw [← hGdef, ← EuclideanDomain.eq_div_of_mul_eq_right hG0 hF.symm,
      ← EuclideanDomain.eq_div_of_mul_eq_right hG0 hQ.symm] at h
    exact h
  have hF0 : F ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hF
    exact hf0 hF
  have hQ0 : Q ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hQ
    exact hD0 hQ
  have hnat : Q.natDegree < F.natDegree := by
    have h1 : D.natDegree < f.natDegree := Polynomial.natDegree_lt_natDegree hD0 hD
    rw [hF, hQ, Polynomial.natDegree_mul hG0 hQ0, Polynomial.natDegree_mul hG0 hF0] at h1
    omega
  have hdeg : Q.degree < F.degree := Polynomial.degree_lt_degree hnat
  have hW0 : F * Polynomial.derivative Q - Polynomial.derivative F * Q ≠ 0 := by
    intro h
    have h1 : F ∣ Polynomial.derivative F * Q :=
      ⟨Polynomial.derivative Q, (sub_eq_zero.mp h).symm⟩
    have h2 : F ∣ Polynomial.derivative F := hcop.dvd_of_dvd_mul_right h1
    have h3 : Polynomial.derivative F = 0 :=
      Polynomial.eq_zero_of_dvd_of_degree_lt h2 (Polynomial.degree_derivative_lt hF0)
    have h4 : F.natDegree = 0 := Polynomial.derivative_eq_zero.mp h3
    omega

  have hdef : (Polynomial.eval a G = 0 ∧ Polynomial.eval a F = 0) ∨
      2 ≤ F.rootMultiplicity a := by
    have hmul : f.rootMultiplicity a = G.rootMultiplicity a + F.rootMultiplicity a := by
      rw [hF]
      exact Polynomial.rootMultiplicity_mul (mul_ne_zero hG0 hF0)
    have hlt : G.rootMultiplicity a < f.rootMultiplicity a := by
      by_contra hle
      push_neg at hle
      apply hdiv
      have hGD' : G ∣ D := ⟨Q, hQ⟩
      exact dvd_trans ((Polynomial.le_rootMultiplicity_iff hG0).mp hle) hGD'
    by_cases hg : G.rootMultiplicity a = 0
    · right; omega
    · left
      constructor
      · exact (Polynomial.rootMultiplicity_pos hG0).mp (Nat.pos_of_ne_zero hg)
      · exact (Polynomial.rootMultiplicity_pos hF0).mp (by omega)
  obtain ⟨W, hWdef⟩ : ∃ W, W = F * Polynomial.derivative Q - Polynomial.derivative F * Q :=
    ⟨_, rfl⟩
  rw [← hWdef] at hW0
  apply ((W.roots.toFinset ∪ G.roots.toFinset).image
    (fun ζ => -Polynomial.eval ζ F / Polynomial.eval ζ Q)).finite_toSet.subset
  intro c hc
  rw [Set.mem_setOf_eq] at hc
  rw [Finset.mem_coe]
  by_contra hcB
  have hstar : ∀ ζ, Polynomial.eval ζ (F + Polynomial.C c * Q) = 0 →
      (Polynomial.eval ζ W = 0 ∨ Polynomial.eval ζ G = 0) → False := by
    intro ζ hP hζ
    have hP' : Polynomial.eval ζ F + c * Polynomial.eval ζ Q = 0 := by
      simpa only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C] using hP
    have hQζ : Polynomial.eval ζ Q ≠ 0 := by
      intro hq
      obtain ⟨u, v, huv⟩ := hcop
      have e := congrArg (Polynomial.eval ζ) huv
      simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_one] at e
      rw [hq, mul_zero, add_zero] at hP'
      rw [hP', hq, mul_zero, mul_zero, add_zero] at e
      exact zero_ne_one e
    apply hcB
    rw [Finset.mem_image]
    refine ⟨ζ, ?_, ?_⟩
    · rw [Finset.mem_union, Multiset.mem_toFinset, Multiset.mem_toFinset,
        Polynomial.mem_roots hW0, Polynomial.mem_roots hG0]
      exact hζ
    · rw [div_eq_iff hQζ]
      linear_combination -hP'
  have hCQ : (Polynomial.C c * Q).degree < F.degree := by
    by_cases hc0 : c = 0
    · rw [hc0, Polynomial.C_0, zero_mul, Polynomial.degree_zero]
      exact lt_of_le_of_lt bot_le hdeg
    · rw [Polynomial.degree_C_mul hc0]; exact hdeg
  have hPdeg : (F + Polynomial.C c * Q).degree = F.degree :=
    Polynomial.degree_add_eq_left_of_degree_lt hCQ
  have hPnat : (F + Polynomial.C c * Q).natDegree = F.natDegree :=
    Polynomial.natDegree_add_eq_left_of_degree_lt hCQ
  have hP0 : F + Polynomial.C c * Q ≠ 0 := by
    intro h
    rw [h, Polynomial.degree_zero] at hPdeg
    exact hF0 (Polynomial.degree_eq_bot.mp hPdeg.symm)
  have hPnodup : (F + Polynomial.C c * Q).roots.Nodup := by
    rw [Multiset.nodup_iff_count_le_one]
    intro ζ
    rw [Polynomial.count_roots]
    by_contra h
    push_neg at h
    obtain ⟨h1, h2⟩ := (Polynomial.one_lt_rootMultiplicity_iff_isRoot hP0).mp h
    apply hstar ζ h1
    left
    rw [hWdef]
    have h1' : Polynomial.eval ζ F + c * Polynomial.eval ζ Q = 0 := by
      simpa only [Polynomial.IsRoot.def, Polynomial.eval_add, Polynomial.eval_mul,
        Polynomial.eval_C] using h1
    have h2' : Polynomial.eval ζ (Polynomial.derivative F) +
        c * Polynomial.eval ζ (Polynomial.derivative Q) = 0 := by
      simpa only [Polynomial.IsRoot.def, Polynomial.derivative_add, Polynomial.derivative_C_mul,
        Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C] using h2
    simp only [Polynomial.eval_sub, Polynomial.eval_mul]
    linear_combination (Polynomial.eval ζ (Polynomial.derivative Q)) * h1' -
      (Polynomial.eval ζ Q) * h2'
  have hfc : f + Polynomial.C c * D = G * (F + Polynomial.C c * Q) := by
    rw [hF, hQ]; ring
  rw [hfc, hF] at hc
  rw [Polynomial.roots_mul (mul_ne_zero hG0 hP0), Polynomial.roots_mul (mul_ne_zero hG0 hF0),
    Multiset.toFinset_add, Multiset.toFinset_add] at hc
  have hdisjF : Disjoint G.roots.toFinset (F + Polynomial.C c * Q).roots.toFinset := by
    rw [Finset.disjoint_left]
    intro ζ h1 h2
    rw [Multiset.mem_toFinset, Polynomial.mem_roots hG0] at h1
    rw [Multiset.mem_toFinset, Polynomial.mem_roots hP0] at h2
    exact hstar ζ h2 (Or.inr h1)
  rw [Finset.card_union_of_disjoint hdisjF, Multiset.toFinset_card_of_nodup hPnodup,
    IsAlgClosed.card_roots_eq_natDegree, hPnat] at hc
  have hU := Finset.card_union_add_card_inter G.roots.toFinset F.roots.toFinset
  have hFle : F.roots.toFinset.card ≤ F.natDegree :=
    (Multiset.toFinset_card_le _).trans (Polynomial.card_roots' F)
  rcases hdef with ⟨haG, haF⟩ | h2
  · have hmem : a ∈ G.roots.toFinset ∩ F.roots.toFinset := by
      rw [Finset.mem_inter, Multiset.mem_toFinset, Multiset.mem_toFinset,
        Polynomial.mem_roots hG0, Polynomial.mem_roots hF0]
      exact ⟨haG, haF⟩
    have := Finset.card_pos.mpr ⟨a, hmem⟩
    omega
  · have hnd : ¬ F.roots.Nodup := by
      rw [Multiset.nodup_iff_count_le_one]
      intro h
      have := h a
      rw [Polynomial.count_roots] at this
      omega
    have hlt : F.roots.toFinset.card < F.natDegree := by
      have h3 : F.roots.toFinset.card ≠ F.roots.card := fun h =>
        hnd (Multiset.toFinset_card_eq_card_iff_nodup.mp h)
      have h4 := Multiset.toFinset_card_le F.roots
      have h5 := Polynomial.card_roots' F
      omega
    omega

theorem wc_bsp_similitude_block_form_nondeg (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r k p : ℕ)
    (J : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (hJ : J.transpose = -J) (hJdet : IsUnit J.det)
    (δ : Fin k → Fin r → ℚ_[ℓ]) (β : Fin k → Fin p)
    (hspan : Submodule.span ℚ_[ℓ] (Set.range δ) = ⊤)
    (horth : ∀ i j, β i ≠ β j → ∑ a, δ i a * J.mulVec (δ j) a = 0)
    (X : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (μ : ℚ_[ℓ]) (hμ : μ ≠ 0)
    (hXJ : X.transpose * J * X = μ • J)
    (hXBP : ∀ i, X.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i}))
    (a : AlgebraicClosure ℚ_[ℓ])
    (ha2 : a ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) μ)
    (ha : Polynomial.aeval a X.charpoly = 0) :
    ∃ i j, β i = β j ∧
      Matrix.vecMul (fun x => algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((δ i + δ j) x))
          (J.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))) ⬝ᵥ
        (Polynomial.aeval (X.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])))
            ((X.charpoly.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))) /ₘ
              (Polynomial.X - Polynomial.C a) ^ (X.charpoly.map
                (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).rootMultiplicity a) *
          X.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).mulVec
          (fun x => algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((δ i + δ j) x)) ≠ 0 :=
by
  classical

  have crux : ∀ (JK XK : Matrix (Fin r) (Fin r) (AlgebraicClosure ℚ_[ℓ]))
      (m : AlgebraicClosure ℚ_[ℓ]), JK.transpose = -JK → JK.det ≠ 0 →
      XK.transpose * JK * XK = m • JK → m ≠ 0 → a ^ 2 ≠ m → XK.charpoly.eval a = 0 →
      ∃ x y : Fin r → AlgebraicClosure ℚ_[ℓ],
        x ⬝ᵥ (JK * (Polynomial.aeval XK (XK.charpoly /ₘ (Polynomial.X - Polynomial.C a) ^
            XK.charpoly.rootMultiplicity a) * XK)).mulVec y +
        y ⬝ᵥ (JK * (Polynomial.aeval XK (XK.charpoly /ₘ (Polynomial.X - Polynomial.C a) ^
            XK.charpoly.rootMultiplicity a) * XK)).mulVec x ≠ 0 := by
    intro JK XK m hJ' hJd hsim hm ha2' ha'
    have hf0 : XK.charpoly ≠ 0 := (Matrix.charpoly_monic XK).ne_zero
    obtain ⟨g, hg⟩ : ∃ g, g = XK.charpoly /ₘ (Polynomial.X - Polynomial.C a) ^
        XK.charpoly.rootMultiplicity a := ⟨_, rfl⟩
    rw [← hg]
    have hdet : (Matrix.scalar (Fin r) a - XK).det = 0 := by
      rw [← Matrix.eval_charpoly]; exact ha'
    obtain ⟨x0, hx0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    have hXx : XK.mulVec x0 = a • x0 := by
      rw [Matrix.sub_mulVec, sub_eq_zero] at hv
      rw [← hv, Matrix.scalar_apply]
      ext x
      simp [Matrix.mulVec_diagonal]
    have hinj : ∀ v, JK.mulVec v = 0 → v = 0 := fun v hv0 => by
      by_contra hne
      exact hJd (Matrix.exists_mulVec_eq_zero_iff.mp ⟨v, hne, hv0⟩)
    obtain ⟨ψ, hψdef⟩ : ∃ ψ, ψ = JK.mulVec x0 := ⟨_, rfl⟩
    have hψ : ψ ≠ 0 := fun h => hx0 (hinj x0 (hψdef ▸ h))
    have h1 : XK.transpose.mulVec (JK.mulVec (XK.mulVec x0)) = m • ψ := by
      rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, hsim, Matrix.smul_mulVec, hψdef]
    have h2 : XK.transpose.mulVec (JK.mulVec (XK.mulVec x0)) = a • (XK.transpose.mulVec ψ) := by
      rw [hXx, Matrix.mulVec_smul, Matrix.mulVec_smul, hψdef]
    have ha0 : a ≠ 0 := by
      intro h0
      have : m • ψ = 0 := by rw [← h1, h2, h0, zero_smul]
      exact hψ ((smul_eq_zero.mp this).resolve_left hm)
    obtain ⟨b, hb⟩ : ∃ b, b = m / a := ⟨_, rfl⟩
    have hXtψ : XK.transpose.mulVec ψ = b • ψ := by
      have h3 : a • (XK.transpose.mulVec ψ) = m • ψ := h2.symm.trans h1
      rw [hb, div_eq_inv_mul, ← smul_smul, ← h3, smul_smul, inv_mul_cancel₀ ha0, one_smul]
    have hba : b ≠ a := by
      intro h
      rw [hb, div_eq_iff ha0] at h
      exact ha2' (by rw [h, sq])
    have hfb : XK.charpoly.eval b = 0 := by
      rw [← Matrix.charpoly_transpose, Matrix.eval_charpoly]
      apply Matrix.exists_mulVec_eq_zero_iff.mp
      refine ⟨ψ, hψ, ?_⟩
      rw [Matrix.sub_mulVec, hXtψ, Matrix.scalar_apply, sub_eq_zero]
      ext x
      simp [Matrix.mulVec_diagonal]
    have hgb : g.eval b = 0 := by
      have h5 := Polynomial.pow_mul_divByMonic_rootMultiplicity_eq XK.charpoly a
      rw [← hg] at h5
      have h4 := congrArg (Polynomial.eval b) h5
      rw [Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_sub, Polynomial.eval_X,
        Polynomial.eval_C, hfb] at h4
      exact (mul_eq_zero.mp h4).resolve_left (pow_ne_zero _ (sub_ne_zero.mpr hba))
    have hga : g.eval a ≠ 0 := by
      rw [hg]; exact Polynomial.eval_divByMonic_pow_rootMultiplicity_ne_zero a hf0
    have hpowx : ∀ n : ℕ, (XK ^ n).mulVec x0 = a ^ n • x0 := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        rw [pow_succ', ← Matrix.mulVec_mulVec, ih, Matrix.mulVec_smul, hXx, smul_smul, pow_succ]
    have hψX : Matrix.vecMul ψ XK = b • ψ := by rw [← Matrix.mulVec_transpose]; exact hXtψ
    have hpowψ : ∀ n : ℕ, Matrix.vecMul ψ (XK ^ n) = b ^ n • ψ := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        rw [pow_succ, ← Matrix.vecMul_vecMul, ih, Matrix.smul_vecMul, hψX, smul_smul, pow_succ]
    have hright : ∀ q : Polynomial (AlgebraicClosure ℚ_[ℓ]),
        (Polynomial.aeval XK q).mulVec x0 = q.eval a • x0 := by
      intro q
      induction q using Polynomial.induction_on' with
      | add p q hp hq => rw [map_add, Matrix.add_mulVec, hp, hq, Polynomial.eval_add, add_smul]
      | monomial n c =>
        rw [Polynomial.aeval_monomial, ← Matrix.mulVec_mulVec, hpowx,
          Algebra.algebraMap_eq_smul_one, Matrix.smul_mulVec, Matrix.one_mulVec,
          Polynomial.eval_monomial, smul_smul]
    have hleft : ∀ q : Polynomial (AlgebraicClosure ℚ_[ℓ]),
        Matrix.vecMul ψ (Polynomial.aeval XK q) = q.eval b • ψ := by
      intro q
      induction q using Polynomial.induction_on' with
      | add p q hp hq => rw [map_add, Matrix.vecMul_add, hp, hq, Polynomial.eval_add, add_smul]
      | monomial n c =>
        rw [Polynomial.aeval_monomial, Algebra.algebraMap_eq_smul_one, Matrix.smul_mul,
          Matrix.one_mul, Matrix.vecMul_smul, hpowψ, Polynomial.eval_monomial, smul_smul]
    obtain ⟨b', hb'⟩ := Function.ne_iff.mp hψ
    refine ⟨Pi.single b' 1, x0, ?_⟩
    have e1 : Pi.single b' 1 ⬝ᵥ (JK * (Polynomial.aeval XK g * XK)).mulVec x0 =
        a * g.eval a * ψ b' := by
      rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hXx, Matrix.mulVec_smul, hright,
        Matrix.mulVec_smul, Matrix.mulVec_smul, ← hψdef, single_dotProduct]
      simp only [Pi.smul_apply, smul_eq_mul, one_mul]
      ring
    have e2 : x0 ⬝ᵥ (JK * (Polynomial.aeval XK g * XK)).mulVec (Pi.single b' 1) = 0 := by
      rw [Matrix.dotProduct_mulVec, ← Matrix.vecMul_vecMul, ← Matrix.vecMul_vecMul]
      have h6 : Matrix.vecMul x0 JK = -ψ := by
        rw [← Matrix.mulVec_transpose, hJ', Matrix.neg_mulVec, hψdef]
      rw [h6, Matrix.neg_vecMul, hleft, hgb, zero_smul, neg_zero, Matrix.zero_vecMul,
        zero_dotProduct]
    rw [e1, e2, add_zero]
    exact mul_ne_zero (mul_ne_zero ha0 hga) hb'

  have polar : ∀ (S : Matrix (Fin r) (Fin r) (AlgebraicClosure ℚ_[ℓ]))
      (d : Fin k → Fin r → AlgebraicClosure ℚ_[ℓ]),
      Submodule.span (AlgebraicClosure ℚ_[ℓ]) (Set.range d) = ⊤ →
      (∀ i j, β i ≠ β j → d i ⬝ᵥ S.mulVec (d j) = 0) →
      (∀ i j, β i = β j → (d i + d j) ⬝ᵥ S.mulVec (d i + d j) = 0) →
      ∀ x y : Fin r → AlgebraicClosure ℚ_[ℓ], x ⬝ᵥ S.mulVec y + y ⬝ᵥ S.mulVec x = 0 := by
    intro S d hsp hc hd
    have hdd : ∀ i, d i ⬝ᵥ S.mulVec (d i) = 0 := by
      intro i
      have h := hd i i rfl
      simp only [Matrix.mulVec_add, dotProduct_add, add_dotProduct] at h
      have h4 : (4 : AlgebraicClosure ℚ_[ℓ]) * (d i ⬝ᵥ S.mulVec (d i)) = 0 := by
        linear_combination h
      exact (mul_eq_zero.mp h4).resolve_left (by norm_num)
    have hpair : ∀ i j, d i ⬝ᵥ S.mulVec (d j) + d j ⬝ᵥ S.mulVec (d i) = 0 := by
      intro i j
      by_cases hij : β i = β j
      · have h := hd i j hij
        simp only [Matrix.mulVec_add, dotProduct_add, add_dotProduct] at h
        linear_combination h - hdd i - hdd j
      · rw [hc i j hij, hc j i (Ne.symm hij), add_zero]
    let Q : LinearMap.BilinForm (AlgebraicClosure ℚ_[ℓ]) (Fin r → AlgebraicClosure ℚ_[ℓ]) :=
      Matrix.toBilin' S + (Matrix.toBilin' S).flip
    have hQ : Q = 0 := by
      refine LinearMap.ext_on_range hsp (fun i => ?_)
      refine LinearMap.ext_on_range hsp (fun j => ?_)
      change Matrix.toBilin' S (d i) (d j) + Matrix.toBilin' S (d j) (d i) = 0
      rw [Matrix.toBilin'_apply', Matrix.toBilin'_apply']
      exact hpair i j
    intro x y
    have h7 : Q x y = 0 := by simp [hQ]
    change Matrix.toBilin' S x y + Matrix.toBilin' S y x = 0 at h7
    rwa [Matrix.toBilin'_apply', Matrix.toBilin'_apply'] at h7

  have cross : ∀ (ι : ℚ_[ℓ] →+* AlgebraicClosure ℚ_[ℓ]) (hp : Polynomial (AlgebraicClosure ℚ_[ℓ]))
      (i j : Fin k), β i ≠ β j →
      (fun x => ι (δ i x)) ⬝ᵥ (J.map ι * (Polynomial.aeval (X.map ι) hp * X.map ι)).mulVec
        (fun x => ι (δ j x)) = 0 := by
    intro ι hp i j hij
    have hstab : ∀ w ∈ Submodule.span ℚ_[ℓ] (δ '' {j' | β j' = β j}),
        X.mulVec w ∈ Submodule.span ℚ_[ℓ] (δ '' {j' | β j' = β j}) := by
      intro w hw
      induction hw using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨j', hj', rfl⟩ := hx
        have h1 := hXBP j'
        rw [Set.mem_setOf_eq] at hj'
        rw [hj'] at h1
        exact h1
      | zero => rw [Matrix.mulVec_zero]; exact Submodule.zero_mem _
      | add x y _ _ hx hy => rw [Matrix.mulVec_add]; exact Submodule.add_mem _ hx hy
      | smul c x _ hx => rw [Matrix.mulVec_smul]; exact Submodule.smul_mem _ c hx
    have hpow : ∀ n : ℕ, (X ^ n).mulVec (δ j) ∈ Submodule.span ℚ_[ℓ] (δ '' {j' | β j' = β j}) := by
      intro n
      induction n with
      | zero => rw [pow_zero, Matrix.one_mulVec]; exact Submodule.subset_span ⟨j, rfl, rfl⟩
      | succ n ih => rw [pow_succ', ← Matrix.mulVec_mulVec]; exact hstab _ ih
    have horthb : ∀ w ∈ Submodule.span ℚ_[ℓ] (δ '' {j' | β j' = β j}),
        δ i ⬝ᵥ J.mulVec w = 0 := by
      intro w hw
      induction hw using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨j', hj', rfl⟩ := hx
        rw [Set.mem_setOf_eq] at hj'
        exact horth i j' (by rw [hj']; exact hij)
      | zero => rw [Matrix.mulVec_zero, dotProduct_zero]
      | add x y _ _ hx hy => rw [Matrix.mulVec_add, dotProduct_add, hx, hy, add_zero]
      | smul c x _ hx => rw [Matrix.mulVec_smul, dotProduct_smul, hx, smul_zero]
    have hK : ∀ n : ℕ, (fun x => ι (δ i x)) ⬝ᵥ (J.map ι * X.map ι ^ n).mulVec
        (fun x => ι (δ j x)) = 0 := by
      intro n
      have e : (fun x => ι (δ i x)) ⬝ᵥ (J.map ι * X.map ι ^ n).mulVec (fun x => ι (δ j x)) =
          ι (δ i ⬝ᵥ J.mulVec ((X ^ n).mulVec (δ j))) := by
        rw [Matrix.mulVec_mulVec, RingHom.map_dotProduct, ← Matrix.map_pow, ← Matrix.map_mul]
        congr 1
        funext x
        exact (RingHom.map_mulVec ι (J * X ^ n) (δ j) x).symm
      rw [e, horthb _ (hpow n), map_zero]
    have hGX : Polynomial.aeval (X.map ι) hp * X.map ι =
        Polynomial.aeval (X.map ι) (hp * Polynomial.X) := by
      rw [Polynomial.aeval_mul, Polynomial.aeval_X]
    rw [hGX, Polynomial.aeval_eq_sum_range, Finset.mul_sum, Matrix.sum_mulVec, dotProduct_sum]
    apply Finset.sum_eq_zero
    intro n _
    rw [Matrix.mul_smul, Matrix.smul_mulVec, dotProduct_smul, hK n, smul_zero]

  have spanK : ∀ ι : ℚ_[ℓ] →+* AlgebraicClosure ℚ_[ℓ],
      Submodule.span (AlgebraicClosure ℚ_[ℓ]) (Set.range (fun i => fun x => ι (δ i x))) = ⊤ := by
    intro ι
    have hmem : ∀ w ∈ Submodule.span ℚ_[ℓ] (Set.range δ), (fun x => ι (w x)) ∈
        Submodule.span (AlgebraicClosure ℚ_[ℓ]) (Set.range (fun i => fun x => ι (δ i x))) := by
      intro w hw
      induction hw using Submodule.span_induction with
      | mem x hx => obtain ⟨i, rfl⟩ := hx; exact Submodule.subset_span ⟨i, rfl⟩
      | zero => convert Submodule.zero_mem _ using 1; funext x; simp
      | add x y _ _ hx hy => convert Submodule.add_mem _ hx hy using 1; funext x; simp
      | smul c x _ hx => convert Submodule.smul_mem _ (ι c) hx using 1; funext x; simp
    rw [Submodule.eq_top_iff']
    intro v
    rw [pi_eq_sum_univ v]
    refine Submodule.sum_mem _ (fun b _ => Submodule.smul_mem _ _ ?_)
    convert hmem (fun j => if b = j then 1 else 0) (by rw [hspan]; exact Submodule.mem_top)
      using 1
    funext x
    by_cases h : b = x <;> simp [h]

  have ha' : (X.charpoly.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).eval a = 0 := by
    rw [Polynomial.eval_map, ← Polynomial.aeval_def]; exact ha
  have hJK : (J.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).transpose =
      -(J.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))) := by
    rw [← Matrix.transpose_map, hJ]; ext u v; simp
  have hJKdet : (J.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det ≠ 0 := by
    rw [← RingHom.mapMatrix_apply, ← RingHom.map_det]
    exact (map_ne_zero _).mpr hJdet.ne_zero
  have hXJK : (X.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).transpose *
      J.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])) *
      X.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])) =
      algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) μ •
        J.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])) := by
    rw [← Matrix.transpose_map, ← Matrix.map_mul, ← Matrix.map_mul, hXJ]
    ext u v
    simp
  by_contra hcon
  push_neg at hcon
  obtain ⟨x, y, hxy⟩ := crux (J.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])))
    (X.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])))
    (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) μ) hJK hJKdet hXJK
    ((map_ne_zero _).mpr hμ) ha2 (by rw [Matrix.charpoly_map]; exact ha')
  rw [Matrix.charpoly_map] at hxy
  apply hxy
  refine polar _ _ (spanK (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])))
    (cross (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])) _) ?_ x y
  intro i j hij
  have h := hcon i j hij
  have hv : (fun x => algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((δ i + δ j) x)) =
      (fun x => algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) (δ i x)) +
        (fun x => algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) (δ j x)) := by
    funext x; simp
  rw [hv, ← Matrix.dotProduct_mulVec, Matrix.mulVec_mulVec] at h
  exact h

theorem wc_bsp_charpoly_rank_one_residue {F : Type*} [Field F] [Infinite F] (r : ℕ)
    (X : Matrix (Fin r) (Fin r) F) (y w : Fin r → F) (g : Polynomial F) :
    X.charpoly ∣ g * ((X + Matrix.vecMulVec y w).charpoly - X.charpoly) →
      w ⬝ᵥ (Polynomial.aeval X g).mulVec y = 0 :=
by
  intro hdiv

  have s1 : ∀ (u : Fin r → F) (z₀ : F), IsUnit (Matrix.scalar (Fin r) z₀ - X).det →
      Polynomial.eval z₀ ((X + Matrix.vecMulVec u w).charpoly - X.charpoly) =
        -((Matrix.scalar (Fin r) z₀ - X).det *
          (w ⬝ᵥ Matrix.mulVec (Matrix.scalar (Fin r) z₀ - X)⁻¹ u)) := by
    intro u z₀ hA
    rw [Polynomial.eval_sub, Matrix.eval_charpoly, Matrix.eval_charpoly]
    have hM : Matrix.scalar (Fin r) z₀ - (X + Matrix.vecMulVec u w) =
        (Matrix.scalar (Fin r) z₀ - X) +
          Matrix.replicateCol Unit (-u) * Matrix.replicateRow Unit w := by
      rw [← Matrix.vecMulVec_eq, Matrix.neg_vecMulVec]; abel
    rw [hM, Matrix.det_add_replicateCol_mul_replicateRow hA, Matrix.det_unique (n := Unit)]
    have he : (1 + Matrix.replicateRow Unit w * (Matrix.scalar (Fin r) z₀ - X)⁻¹ *
        Matrix.replicateCol Unit (-u) : Matrix Unit Unit F) default default =
        1 - w ⬝ᵥ Matrix.mulVec (Matrix.scalar (Fin r) z₀ - X)⁻¹ u := by
      rw [Matrix.add_apply, Matrix.one_apply_eq, Matrix.dotProduct_mulVec]
      simp [Matrix.mul_apply, Matrix.replicateRow, Matrix.replicateCol, dotProduct, Matrix.vecMul,
        sub_eq_add_neg]
    rw [he]; ring

  have s2 : ∀ g' : Polynomial F, ∃ P : Polynomial F, ∀ z₀ : F,
      IsUnit (Matrix.scalar (Fin r) z₀ - X).det →
      Polynomial.eval z₀ P = w ⬝ᵥ Matrix.mulVec (Matrix.scalar (Fin r) z₀ - X)⁻¹
        (Polynomial.eval z₀ g' • y - Matrix.mulVec (Polynomial.aeval X g') y) := by
    intro g'
    induction g' using Polynomial.induction_on with
    | C a =>
      refine ⟨0, fun z₀ _ => ?_⟩
      simp [Polynomial.aeval_C, Algebra.algebraMap_eq_smul_one, Matrix.smul_mulVec]
    | add p q hp hq =>
      obtain ⟨Pp, hPp⟩ := hp
      obtain ⟨Pq, hPq⟩ := hq
      refine ⟨Pp + Pq, fun z₀ hz => ?_⟩
      rw [Polynomial.eval_add, hPp z₀ hz, hPq z₀ hz, ← dotProduct_add, ← Matrix.mulVec_add]
      congr 2
      rw [Polynomial.eval_add, Polynomial.aeval_add, Matrix.add_mulVec, add_smul]
      abel
    | monomial n a ih =>
      obtain ⟨Pn, hPn⟩ := ih
      refine ⟨Polynomial.X * Pn + Polynomial.C (a * (w ⬝ᵥ (X ^ n).mulVec y)), fun z₀ hz => ?_⟩
      have F1 : ∀ v, ((Matrix.scalar (Fin r) z₀ - X)⁻¹).mulVec
          ((Matrix.scalar (Fin r) z₀ - X).mulVec v) = v := by
        intro v
        rw [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul _ hz, Matrix.one_mulVec]
      have F2 : ∀ v, (Matrix.scalar (Fin r) z₀ - X).mulVec v = z₀ • v - X.mulVec v := by
        intro v
        rw [Matrix.sub_mulVec]
        congr 1
        ext i
        simp [Matrix.scalar_apply, Matrix.mulVec_diagonal]
      have hXn : X.mulVec ((X ^ n).mulVec y) = (X ^ (n + 1)).mulVec y := by
        rw [Matrix.mulVec_mulVec, pow_succ']
      have hv : Polynomial.eval z₀ (Polynomial.C a * Polynomial.X ^ (n + 1)) • y -
          (Polynomial.aeval X (Polynomial.C a * Polynomial.X ^ (n + 1))).mulVec y =
          z₀ • (Polynomial.eval z₀ (Polynomial.C a * Polynomial.X ^ n) • y -
            (Polynomial.aeval X (Polynomial.C a * Polynomial.X ^ n)).mulVec y) +
          (Matrix.scalar (Fin r) z₀ - X).mulVec (a • (X ^ n).mulVec y) := by
        rw [F2]
        simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X,
          map_mul, Polynomial.aeval_C, Polynomial.aeval_X_pow, Algebra.algebraMap_eq_smul_one,
          smul_mul_assoc, one_mul, Matrix.smul_mulVec, Matrix.mulVec_smul, hXn]
        rw [pow_succ]
        module
      rw [hv, Matrix.mulVec_add, F1, dotProduct_add, Matrix.mulVec_smul, dotProduct_smul,
        ← hPn z₀ hz, dotProduct_smul]
      simp [smul_eq_mul]

  have s3 : ∀ u : Fin r → F,
      X.charpoly ∣ (X + Matrix.vecMulVec u w).charpoly - X.charpoly → w ⬝ᵥ u = 0 := by
    intro u h
    rcases Nat.eq_zero_or_pos r with hr | hr
    · subst hr; simp [dotProduct]
    have hp := Matrix.charpoly_monic (X + Matrix.vecMulVec u w)
    have hf := Matrix.charpoly_monic X
    have hdp := Matrix.charpoly_degree_eq_dim (X + Matrix.vecMulVec u w)
    have hdf := Matrix.charpoly_degree_eq_dim X
    have hlt : ((X + Matrix.vecMulVec u w).charpoly - X.charpoly).degree <
        X.charpoly.degree := by
      rw [hdf, ← hdp]
      exact Polynomial.degree_sub_lt_left (by rw [hdp, hdf]) hp.ne_zero
        (by rw [hp.leadingCoeff, hf.leadingCoeff])
    have h0 := Polynomial.eq_zero_of_dvd_of_degree_lt h hlt
    rw [sub_eq_zero] at h0
    have : Nonempty (Fin r) := ⟨⟨0, hr⟩⟩
    have ht : (X + Matrix.vecMulVec u w).trace = X.trace := by
      rw [Matrix.trace_eq_neg_charpoly_coeff, Matrix.trace_eq_neg_charpoly_coeff X, h0]
    rw [Matrix.trace_add, Matrix.trace_vecMulVec] at ht
    rw [dotProduct_comm]
    linear_combination ht

  obtain ⟨P, hP⟩ := s2 g
  have hstar : (X + Matrix.vecMulVec ((Polynomial.aeval X g).mulVec y) w).charpoly -
      X.charpoly = g * ((X + Matrix.vecMulVec y w).charpoly - X.charpoly) +
        X.charpoly * P := by
    apply Polynomial.eq_of_infinite_eval_eq
    apply Set.Infinite.mono _
      (Polynomial.finite_setOfPred_isRoot (Matrix.charpoly_monic X).ne_zero).infinite_compl
    intro z₀ hz
    simp only [Set.mem_compl_iff, Set.mem_setOf_eq] at hz
    have hA : IsUnit (Matrix.scalar (Fin r) z₀ - X).det := by
      rw [← Matrix.eval_charpoly]; exact isUnit_iff_ne_zero.mpr hz
    show Polynomial.eval z₀ _ = Polynomial.eval z₀ _
    rw [s1 _ z₀ hA, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_mul, s1 y z₀ hA,
      hP z₀ hA, Matrix.eval_charpoly, Matrix.mulVec_sub, dotProduct_sub, Matrix.mulVec_smul,
      dotProduct_smul, smul_eq_mul]
    ring

  apply s3
  rw [hstar]
  exact dvd_add hdiv (dvd_mul_right _ _)

theorem wc_block_separable_perturb (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r k p : ℕ)
    (J : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (hJ : J.transpose = -J) (hJdet : IsUnit J.det)
    (δ : Fin k → Fin r → ℚ_[ℓ]) (β : Fin k → Fin p)
    (hspan : Submodule.span ℚ_[ℓ] (Set.range δ) = ⊤)
    (horth : ∀ i j, β i ≠ β j → ∑ a, δ i a * J.mulVec (δ j) a = 0)
    (Φ₀ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (μ : ℚ_[ℓ]) (hμ : μ ≠ 0)
    (hΦJ : Φ₀.transpose * J * Φ₀ = μ • J)
    (hΦBP : ∀ i, Φ₀.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})) :
    ∀ m : ℕ, ∃ s₀ : Matrix (Fin r) (Fin r) ℚ_[ℓ], s₀.transpose * J * s₀ = J ∧
      (∀ i, s₀.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})) ∧
      (∀ a b, ‖s₀ a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ))) ∧
      (Φ₀ * s₀).charpoly.Separable :=
by
  classical
  intro m
  have hℓ : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt
  have hℓ0 : (ℓ : ℝ) ≠ 0 := ne_of_gt (lt_trans zero_lt_one hℓ)
  have hε0 : (0 : ℝ) ≤ (ℓ : ℝ) ^ (-(m : ℤ)) := (zpow_pos (lt_trans zero_lt_one hℓ) _).le
  have hε1 : (ℓ : ℝ) ^ (-(m : ℤ)) ≤ 1 := zpow_le_one_of_nonpos₀ hℓ.le (by omega)
  have hJ0 : J.det ≠ 0 := hJdet.ne_zero

  have hvvF : ∀ (v w y : Fin r → ℚ_[ℓ]), (Matrix.vecMulVec v w).mulVec y = (w ⬝ᵥ y) • v := by
    intro v w y
    ext a
    simp only [Matrix.mulVec, dotProduct, Matrix.vecMulVec_apply, Pi.smul_apply, smul_eq_mul,
      Finset.sum_mul]
    exact Finset.sum_congr rfl (fun b _ => by ring)

  have s1 : ∀ (v : Fin r → ℚ_[ℓ]) (c : ℚ_[ℓ]),
      (1 + c • Matrix.vecMulVec v (Matrix.vecMul v J)).transpose * J *
        (1 + c • Matrix.vecMulVec v (Matrix.vecMul v J)) = J := by
    intro v c
    set w := Matrix.vecMul v J with hw
    have hwu : w = -(J.mulVec v) := by
      rw [hw, ← Matrix.mulVec_transpose, hJ, Matrix.neg_mulVec]
    have hq : w ⬝ᵥ v = 0 := by
      have h1 : v ⬝ᵥ J.mulVec v = w ⬝ᵥ v := by rw [Matrix.dotProduct_mulVec]
      have h2 : w ⬝ᵥ v = -(w ⬝ᵥ v) := by
        conv_lhs => rw [hwu]
        rw [neg_dotProduct, dotProduct_comm, h1]
      have h3 : (2 : ℚ_[ℓ]) * (w ⬝ᵥ v) = 0 := by linear_combination h2
      exact (mul_eq_zero.mp h3).resolve_left two_ne_zero
    have hNN : Matrix.vecMulVec w w * Matrix.vecMulVec v w = 0 := by
      ext a b
      simp only [Matrix.mul_apply, Matrix.vecMulVec_apply, Matrix.zero_apply]
      have : ∑ x, w a * w x * (v x * w b) = (w a * w b) * (w ⬝ᵥ v) := by
        rw [dotProduct, Finset.mul_sum]
        exact Finset.sum_congr rfl (fun x _ => by ring)
      rw [this, hq, mul_zero]
    have hT : (1 + c • Matrix.vecMulVec v w).transpose = 1 + c • Matrix.vecMulVec w v := by
      rw [Matrix.transpose_add, Matrix.transpose_one, Matrix.transpose_smul,
        Matrix.transpose_vecMulVec]
    have hNJ : Matrix.vecMulVec w v * J = Matrix.vecMulVec w w := by
      rw [Matrix.vecMulVec_mul]
    have hJN : J * Matrix.vecMulVec v w = -Matrix.vecMulVec w w := by
      rw [Matrix.mul_vecMulVec]
      have : J.mulVec v = -w := by rw [hwu, neg_neg]
      rw [this]
      ext a b
      simp [Matrix.vecMulVec_apply]
    rw [hT]
    have hexp : (1 + c • Matrix.vecMulVec w v) * J * (1 + c • Matrix.vecMulVec v w)
        = J + c • (Matrix.vecMulVec w v * J + J * Matrix.vecMulVec v w) +
          (c * c) • (Matrix.vecMulVec w v * J * Matrix.vecMulVec v w) := by
      simp only [add_mul, mul_add, one_mul, mul_one, smul_mul_assoc, mul_smul_comm, smul_add,
        smul_smul]
      abel
    rw [hexp, hNJ, hJN, hNN, add_neg_cancel, smul_zero, smul_zero, add_zero, add_zero]

  have s1bp : ∀ (i j : Fin k), β i = β j → ∀ (c : ℚ_[ℓ]) (i' : Fin k),
      (1 + c • Matrix.vecMulVec (δ i + δ j) (Matrix.vecMul (δ i + δ j) J)).mulVec (δ i') ∈
        Submodule.span ℚ_[ℓ] (δ '' {j' | β j' = β i'}) := by
    intro i j hij c i'
    rw [Matrix.add_mulVec, Matrix.one_mulVec, Matrix.smul_mulVec, hvvF]
    have hmem : δ i' ∈ Submodule.span ℚ_[ℓ] (δ '' {j' | β j' = β i'}) :=
      Submodule.subset_span ⟨i', rfl, rfl⟩
    refine Submodule.add_mem _ hmem ?_
    by_cases hb : β i = β i'
    · refine Submodule.smul_mem _ _ (Submodule.smul_mem _ _ (Submodule.add_mem _ ?_ ?_))
      · exact Submodule.subset_span ⟨i, hb, rfl⟩
      · exact Submodule.subset_span ⟨j, hij.symm.trans hb, rfl⟩
    · have h0 : Matrix.vecMul (δ i + δ j) J ⬝ᵥ δ i' = 0 := by
        rw [← Matrix.dotProduct_mulVec, add_dotProduct]
        have e1 : δ i ⬝ᵥ J.mulVec (δ i') = 0 := horth i i' hb
        have e2 : δ j ⬝ᵥ J.mulVec (δ i') = 0 := horth j i' (fun h => hb (hij.trans h))
        rw [e1, e2, add_zero]
      rw [h0, zero_smul, smul_zero]
      exact Submodule.zero_mem _

  have hBPmul : ∀ X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ],
      (∀ i, X.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})) →
      (∀ i, Y.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})) →
      ∀ i, (X * Y).mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i}) := by
    intro X Y hX hY i
    have hle : Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i}) ≤
        (Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})).comap (Matrix.toLin' X) := by
      rw [Submodule.span_le]
      rintro _ ⟨j, hj, rfl⟩
      have hj' : β j = β i := hj
      have hset : {j' | β j' = β j} = {j' | β j' = β i} := by
        ext j'
        simp only [Set.mem_setOf_eq]
        rw [hj']
      show Matrix.toLin' X (δ j) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})
      rw [Matrix.toLin'_apply, ← hset]
      exact hX j
    rw [← Matrix.mulVec_mulVec]
    have h := hle (hY i)
    rw [Submodule.mem_comap, Matrix.toLin'_apply] at h
    exact h

  have s2 : ∀ X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ],
      (∀ a b, ‖X a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ))) →
      (∀ a b, ‖Y a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ))) →
      ∀ a b, ‖(X * Y) a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ)) := by
    intro X Y hX hY a b
    have e : X * Y - 1 = (X - 1) * (Y - 1) + (X - 1) + (Y - 1) := by noncomm_ring
    have e' : (X * Y) a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b =
        ((X - 1) * (Y - 1)) a b + (X - 1) a b + (Y - 1) a b := by
      rw [← Matrix.sub_apply, e, Matrix.add_apply, Matrix.add_apply]
    rw [e']
    have h1 : ‖((X - 1) * (Y - 1)) a b‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ)) := by
      rw [Matrix.mul_apply]
      apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg hε0
      intro k _
      rw [norm_mul, Matrix.sub_apply, Matrix.sub_apply]
      exact (mul_le_mul (hX a k) ((hY k b).trans hε1) (norm_nonneg _) hε0).trans
        (le_of_eq (mul_one _))
    refine (IsUltrametricDist.norm_add_le_max _ _).trans
      (max_le ((IsUltrametricDist.norm_add_le_max _ _).trans (max_le h1 ?_)) ?_)
    · rw [Matrix.sub_apply]; exact hX a b
    · rw [Matrix.sub_apply]; exact hY a b

  have s8 : ∀ (v : Fin r → ℚ_[ℓ]) (B : Set ℚ_[ℓ]), B.Finite → ∃ c : ℚ_[ℓ], c ≠ 0 ∧ c ∉ B ∧
      ∀ a b, ‖(1 + c • Matrix.vecMulVec v (Matrix.vecMul v J)) a b -
        (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ)) := by
    intro v B hB
    set w := Matrix.vecMul v J with hw
    set C : ℝ := 1 + ∑ a, ∑ b, ‖v a * w b‖ with hC
    have hCb : ∀ a b, ‖v a * w b‖ ≤ C := by
      intro a b
      have h1 : ‖v a * w b‖ ≤ ∑ b', ‖v a * w b'‖ :=
        Finset.single_le_sum (f := fun b' => ‖v a * w b'‖) (fun _ _ => norm_nonneg _)
          (Finset.mem_univ b)
      have h2 : ∑ b', ‖v a * w b'‖ ≤ ∑ a', ∑ b', ‖v a' * w b'‖ :=
        Finset.single_le_sum (f := fun a' => ∑ b', ‖v a' * w b'‖)
          (fun _ _ => Finset.sum_nonneg (fun _ _ => norm_nonneg _)) (Finset.mem_univ a)
      linarith
    obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt C hℓ
    have hinj : Function.Injective (fun k : ℕ => (ℓ : ℚ_[ℓ]) ^ (n + m + k)) := by
      intro k₁ k₂ h
      have h' : ((ℓ ^ (n + m + k₁) : ℕ) : ℚ_[ℓ]) = ((ℓ ^ (n + m + k₂) : ℕ) : ℚ_[ℓ]) := by
        push_cast; exact h
      have h'' : n + m + k₁ = n + m + k₂ :=
        Nat.pow_right_injective (Fact.out : ℓ.Prime).two_le (Nat.cast_injective h')
      omega
    obtain ⟨x, hx⟩ := ((Set.infinite_range_of_injective hinj).diff hB).nonempty
    obtain ⟨⟨k', rfl⟩, hxB⟩ := hx
    refine ⟨(ℓ : ℚ_[ℓ]) ^ (n + m + k'),
      pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : ℓ.Prime).ne_zero), hxB, fun a b => ?_⟩
    rw [Matrix.add_apply, add_sub_cancel_left, Matrix.smul_apply, Matrix.vecMulVec_apply,
      smul_eq_mul, norm_mul, Padic.norm_p_pow]
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ (-((n + m + k' : ℕ) : ℤ)) := zpow_pos (lt_trans zero_lt_one hℓ) _
    calc (ℓ : ℝ) ^ (-((n + m + k' : ℕ) : ℤ)) * ‖v a * w b‖ ≤
          (ℓ : ℝ) ^ (-((n + m + k' : ℕ) : ℤ)) * (ℓ : ℝ) ^ (n : ℤ) := by
          apply mul_le_mul_of_nonneg_left _ hpos.le
          rw [zpow_natCast]; exact (hCb a b).trans hn.le
      _ = (ℓ : ℝ) ^ (-((n + m + k' : ℕ) : ℤ) + n) := by rw [zpow_add₀ hℓ0]
      _ ≤ (ℓ : ℝ) ^ (-(m : ℤ)) := zpow_le_zpow_right₀ hℓ.le (by omega)

  have s7 : ∀ (X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (δ' : AlgebraicClosure ℚ_[ℓ]),
      (Matrix.scalar (Fin r) δ' - X.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det ≠ 0 →
      {c : ℚ_[ℓ] | (Matrix.scalar (Fin r) δ' -
          (X * (1 + c • Y)).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det = 0}.Finite := by
    intro X Y δ' hdet
    set f := algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) with hf
    set B := Matrix.scalar (Fin r) δ' - X.map f with hB
    set Z := (X * Y).map f with hZ
    set p : Polynomial (AlgebraicClosure ℚ_[ℓ]) :=
      ((Polynomial.X : Polynomial (AlgebraicClosure ℚ_[ℓ])) • (-Z).map Polynomial.C +
        B.map Polynomial.C).det with hp
    have hp0 : p ≠ 0 := by
      intro h
      apply hdet
      rw [← Polynomial.coeff_det_X_add_C_zero (-Z) B, ← hp, h, Polynomial.coeff_zero]
    have heval : ∀ z, p.eval z = (B + z • (-Z)).det := by
      intro z
      rw [hp, show Polynomial.eval z = ⇑(Polynomial.evalRingHom z) from rfl, RingHom.map_det]
      congr 1
      ext a b
      simp [RingHom.mapMatrix_apply, Matrix.map_apply] <;> ring
    apply Set.Finite.subset ((p.roots.toFinset.finite_toSet).preimage f.injective.injOn)
    intro c hc
    simp only [Set.mem_setOf_eq] at hc
    simp only [Set.mem_preimage, Finset.mem_coe, Multiset.mem_toFinset]
    rw [Polynomial.mem_roots hp0, Polynomial.IsRoot, heval]
    have hm : (X * (1 + c • Y)).map f = X.map f + f c • Z := by
      rw [mul_add, mul_one, mul_smul_comm, hZ]
      ext a b
      simp only [Matrix.add_apply, Matrix.map_apply, Matrix.smul_apply, smul_eq_mul, map_add,
        map_mul]
    have : B + f c • (-Z) = Matrix.scalar (Fin r) δ' - (X * (1 + c • Y)).map f := by
      rw [hm, smul_neg, hB]; abel
    rw [this]; exact hc

  have core : ∀ (X : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (a : AlgebraicClosure ℚ_[ℓ])
      (x₀ w₀ : Fin r → AlgebraicClosure ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]),
      (Matrix.scalar (Fin r) a - X.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).mulVec x₀ = 0 →
      Matrix.vecMul w₀ (Matrix.scalar (Fin r) a -
        X.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))) = 0 →
      Matrix.vecMul w₀ (X.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))) ⬝ᵥ
        (fun i => algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) (v i)) ≠ 0 →
      (fun i => algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) (v i)) ⬝ᵥ
        (J.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).mulVec x₀ ≠ 0 →
      ∀ c : ℚ_[ℓ], c ≠ 0 →
        Module.finrank (AlgebraicClosure ℚ_[ℓ]) (LinearMap.ker (Matrix.toLin'
          (Matrix.scalar (Fin r) a - (X * (1 + c • Matrix.vecMulVec v (Matrix.vecMul v J))).map
            (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))))) <
        Module.finrank (AlgebraicClosure ℚ_[ℓ]) (LinearMap.ker (Matrix.toLin'
          (Matrix.scalar (Fin r) a - X.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))))) := by
    intro X a x₀ w₀ v hAx₀ hw₀A hP1 hP2 c hc
    set f := algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) with hf
    set A := Matrix.scalar (Fin r) a - X.map f with hAdef
    set vK : Fin r → AlgebraicClosure ℚ_[ℓ] := fun i => f (v i) with hvK
    set u := (X.map f).mulVec vK with hu
    set ω := Matrix.vecMul vK (J.map f) with hω
    have hmap : (X * (1 + c • Matrix.vecMulVec v (Matrix.vecMul v J))).map f =
        X.map f + f c • Matrix.vecMulVec u ω := by
      rw [mul_add, mul_one, mul_smul_comm, Matrix.mul_vecMulVec]
      ext p q
      simp only [Matrix.map_apply, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul, map_add,
        map_mul, Matrix.vecMulVec_apply, RingHom.map_mulVec, RingHom.map_vecMul]
      rfl
    have hvv : ∀ x, (Matrix.vecMulVec u ω).mulVec x = (ω ⬝ᵥ x) • u := by
      intro x
      ext p
      simp only [Matrix.mulVec, dotProduct, Matrix.vecMulVec_apply, Pi.smul_apply, smul_eq_mul,
        Finset.sum_mul]
      exact Finset.sum_congr rfl (fun b _ => by ring)
    set A' := Matrix.scalar (Fin r) a -
      (X * (1 + c • Matrix.vecMulVec v (Matrix.vecMul v J))).map f with hA'def
    have hsm : ∀ (γ : AlgebraicClosure ℚ_[ℓ]) (M : Matrix (Fin r) (Fin r) (AlgebraicClosure ℚ_[ℓ]))
        (x : Fin r → AlgebraicClosure ℚ_[ℓ]), (γ • M).mulVec x = γ • M.mulVec x := by
      intro γ M x
      ext i
      simp only [Matrix.mulVec, dotProduct, Matrix.smul_apply, Pi.smul_apply, smul_eq_mul,
        Finset.mul_sum]
      exact Finset.sum_congr rfl (fun j _ => by ring)
    have hA'x : ∀ x, A'.mulVec x = A.mulVec x - (f c * (ω ⬝ᵥ x)) • u := by
      intro x
      rw [hA'def, hmap, sub_add_eq_sub_sub, Matrix.sub_mulVec, hsm, hvv, smul_smul]
    have hwu : w₀ ⬝ᵥ u = Matrix.vecMul w₀ (X.map f) ⬝ᵥ vK := Matrix.dotProduct_mulVec _ _ _
    have hωx : ω ⬝ᵥ x₀ = vK ⬝ᵥ (J.map f).mulVec x₀ := (Matrix.dotProduct_mulVec _ _ _).symm
    have hfc : f c ≠ 0 := (map_ne_zero f).mpr hc
    have hle : LinearMap.ker (Matrix.toLin' A') ≤ LinearMap.ker (Matrix.toLin' A) := by
      intro x hx
      rw [LinearMap.mem_ker, Matrix.toLin'_apply] at hx ⊢
      rw [hA'x] at hx
      have h1 : A.mulVec x = (f c * (ω ⬝ᵥ x)) • u := sub_eq_zero.mp hx
      have h2 : w₀ ⬝ᵥ A.mulVec x = 0 := by
        rw [Matrix.dotProduct_mulVec, hw₀A, zero_dotProduct]
      rw [h1, dotProduct_smul, smul_eq_mul, hwu] at h2
      have h3 : ω ⬝ᵥ x = 0 := by
        rcases mul_eq_zero.mp h2 with h | h
        · exact (mul_eq_zero.mp h).resolve_left hfc
        · exact absurd h hP1
      rw [h1, h3, mul_zero, zero_smul]
    have hlt : LinearMap.ker (Matrix.toLin' A') < LinearMap.ker (Matrix.toLin' A) := by
      refine lt_of_le_of_ne hle (fun heq => ?_)
      have hx₀' : x₀ ∈ LinearMap.ker (Matrix.toLin' A) := by
        rw [LinearMap.mem_ker, Matrix.toLin'_apply]; exact hAx₀
      rw [← heq, LinearMap.mem_ker, Matrix.toLin'_apply, hA'x, hAx₀, zero_sub,
        neg_eq_zero] at hx₀'
      have hu0 : u ≠ 0 := by
        intro h; apply hP1; rw [← hwu, h, dotProduct_zero]
      exact smul_ne_zero (mul_ne_zero hfc (by rw [hωx]; exact hP2)) hu0 hx₀'
    exact Submodule.finrank_lt_finrank_of_lt hlt

  have s6 : ∀ X : Matrix (Fin r) (Fin r) ℚ_[ℓ], X.transpose * J * X = μ • J →
      ∀ a : AlgebraicClosure ℚ_[ℓ], a ^ 2 = algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) μ →
      (Matrix.scalar (Fin r) a - X.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det = 0 →
      ∃ i : Fin k, ∀ c : ℚ_[ℓ], c ≠ 0 →
        Module.finrank (AlgebraicClosure ℚ_[ℓ]) (LinearMap.ker (Matrix.toLin'
          (Matrix.scalar (Fin r) a - (X * (1 + c • Matrix.vecMulVec (δ i + δ i)
            (Matrix.vecMul (δ i + δ i) J))).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))))) <
        Module.finrank (AlgebraicClosure ℚ_[ℓ]) (LinearMap.ker (Matrix.toLin'
          (Matrix.scalar (Fin r) a - X.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))))) := by
    intro X hXJ a ha2 hA
    obtain ⟨x₀, hx₀, hAx₀⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hA
    set f := algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) with hf
    have hXx : (X.map f).mulVec x₀ = a • x₀ := by
      have hv := hAx₀
      rw [Matrix.sub_mulVec, sub_eq_zero] at hv
      rw [← hv, Matrix.scalar_apply]
      ext x
      simp [Matrix.mulVec_diagonal]
    have hJK : (J.map f).det ≠ 0 := by
      rw [show (J.map f).det = f J.det from (RingHom.map_det f J).symm]
      exact (map_ne_zero f).mpr hJ0
    set w₀ := (J.map f).mulVec x₀ with hw₀
    have hw₀0 : w₀ ≠ 0 := fun h => hJK (Matrix.exists_mulVec_eq_zero_iff.mp ⟨x₀, hx₀, h⟩)
    have ha0 : a ≠ 0 := by
      intro h0
      apply hμ
      apply f.injective
      rw [map_zero, ← ha2, h0]
      ring
    have hXJK : (X.map f).transpose * J.map f * X.map f = f μ • J.map f := by
      rw [← Matrix.transpose_map, ← Matrix.map_mul, ← Matrix.map_mul, hXJ]
      ext p q
      simp
    have hXw : Matrix.vecMul w₀ (X.map f) = a • w₀ := by
      have h1 : (X.map f).transpose.mulVec ((J.map f).mulVec ((X.map f).mulVec x₀)) =
          (f μ • J.map f).mulVec x₀ := by
        rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, hXJK]
      rw [hXx, Matrix.mulVec_smul, Matrix.mulVec_smul, Matrix.smul_mulVec, ← ha2, ← hw₀] at h1
      rw [← Matrix.mulVec_transpose]
      have h2 : a • ((X.map f).transpose.mulVec w₀) = a • (a • w₀) := by
        rw [h1, smul_smul, sq]
      exact smul_right_injective _ ha0 h2
    have hw₀A : Matrix.vecMul w₀ (Matrix.scalar (Fin r) a - X.map f) = 0 := by
      rw [Matrix.vecMul_sub, hXw, Matrix.scalar_apply, sub_eq_zero]
      ext x
      simp [Matrix.vecMul_diagonal, mul_comm]
    have hex : ∃ i, w₀ ⬝ᵥ (fun x => f (δ i x)) ≠ 0 := by
      by_contra hall
      push_neg at hall
      apply hw₀0
      ext b
      have hb : (Pi.single b (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ]) ∈
          Submodule.span ℚ_[ℓ] (Set.range δ) := by
        rw [hspan]; exact Submodule.mem_top
      obtain ⟨cf, hcf⟩ := (Submodule.mem_span_range_iff_exists_fun ℚ_[ℓ]).mp hb
      have hfun : (fun x => f ((Pi.single b (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ]) x)) =
          (Pi.single b (1 : AlgebraicClosure ℚ_[ℓ]) : Fin r → AlgebraicClosure ℚ_[ℓ]) := by
        ext x
        by_cases h : x = b
        · subst h; simp
        · simp [Pi.single_apply, h]
      have e1 : w₀ b = w₀ ⬝ᵥ (fun x => f ((Pi.single b (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ]) x)) := by
        rw [hfun]
        simp [dotProduct, Pi.single_apply]
      have e2 : (fun x => f ((Pi.single b (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ]) x)) =
          ∑ i, f (cf i) • (fun x => f (δ i x)) := by
        rw [← hcf]
        ext x
        simp [Finset.sum_apply, map_sum]
      rw [Pi.zero_apply, e1, e2, dotProduct_sum]
      exact Finset.sum_eq_zero (fun i _ => by rw [dotProduct_smul, hall i, smul_zero])
    obtain ⟨i, hi⟩ := hex
    have hvv2 : (fun x => f ((δ i + δ i) x)) = (fun x => f (δ i x)) + (fun x => f (δ i x)) := by
      ext x; simp
    have hP1 : Matrix.vecMul w₀ (X.map f) ⬝ᵥ (fun x => f ((δ i + δ i) x)) ≠ 0 := by
      rw [hXw, smul_dotProduct, smul_eq_mul, hvv2, dotProduct_add, ← two_mul]
      exact mul_ne_zero ha0 (mul_ne_zero two_ne_zero hi)
    have hP2 : (fun x => f ((δ i + δ i) x)) ⬝ᵥ (J.map f).mulVec x₀ ≠ 0 := by
      rw [← hw₀, dotProduct_comm, hvv2, dotProduct_add, ← two_mul]
      exact mul_ne_zero two_ne_zero hi
    exact ⟨i, core X a x₀ w₀ (δ i + δ i) hAx₀ hw₀A hP1 hP2⟩

  have hBR : ∀ (X : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (δ' : AlgebraicClosure ℚ_[ℓ]),
      Polynomial.aeval δ' X.charpoly =
        (Matrix.scalar (Fin r) δ' - X.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det := by
    intro X δ'
    rw [← Matrix.eval_charpoly, Matrix.charpoly_map, Polynomial.eval_map, ← Polynomial.aeval_def]

  have hsim : ∀ s : Matrix (Fin r) (Fin r) ℚ_[ℓ], s.transpose * J * s = J →
      (Φ₀ * s).transpose * J * (Φ₀ * s) = μ • J := by
    intro s hsJ
    rw [Matrix.transpose_mul]
    calc s.transpose * Φ₀.transpose * J * (Φ₀ * s)
        = s.transpose * (Φ₀.transpose * J * Φ₀) * s := by simp only [Matrix.mul_assoc]
      _ = μ • (s.transpose * J * s) := by rw [hΦJ, Matrix.mul_smul, Matrix.smul_mul]
      _ = μ • J := by rw [hsJ]

  obtain ⟨Inv, hInv⟩ : ∃ Inv : Matrix (Fin r) (Fin r) ℚ_[ℓ] → Prop, ∀ s, Inv s ↔
      (s.transpose * J * s = J ∧
        (∀ i, s.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})) ∧
        (∀ a b, ‖s a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ)))) :=
    ⟨_, fun s => Iff.rfl⟩
  have hInv1 : Inv 1 := by
    rw [hInv]
    refine ⟨by simp, fun i => ?_, fun a b => by rw [sub_self, norm_zero]; exact hε0⟩
    rw [Matrix.one_mulVec]
    exact Submodule.subset_span ⟨i, rfl, rfl⟩
  have hInvT : ∀ s, Inv s → ∀ i j, β i = β j → ∀ c : ℚ_[ℓ],
      (∀ a b, ‖(1 + c • Matrix.vecMulVec (δ i + δ j) (Matrix.vecMul (δ i + δ j) J)) a b -
        (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ))) →
      Inv (s * (1 + c • Matrix.vecMulVec (δ i + δ j) (Matrix.vecMul (δ i + δ j) J))) := by
    intro s hs i j hij c hc1
    obtain ⟨hsJ, hsBP, hs1⟩ := (hInv s).mp hs
    rw [hInv]
    refine ⟨?_, hBPmul _ _ hsBP (s1bp i j hij c), s2 _ _ hs1 hc1⟩
    rw [Matrix.transpose_mul, show ∀ T : Matrix (Fin r) (Fin r) ℚ_[ℓ],
        T.transpose * s.transpose * J * (s * T) = T.transpose * (s.transpose * J * s) * T
        from fun T => by simp only [Matrix.mul_assoc], hsJ]
    exact s1 _ c

  have hPA : ∀ T : Finset (AlgebraicClosure ℚ_[ℓ]),
      (∀ a ∈ T, a ^ 2 = algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) μ) →
      ∃ s, Inv s ∧ ∀ a ∈ T, (Matrix.scalar (Fin r) a -
        (Φ₀ * s).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det ≠ 0 := by
    intro T
    induction T using Finset.induction_on with
    | empty => intro _; exact ⟨1, hInv1, fun a h => by simp at h⟩
    | insert a0 T ha0T ih =>
      intro hT
      obtain ⟨s₀, hs₀, hs₀T⟩ := ih (fun a ha => hT a (Finset.mem_insert_of_mem ha))
      have ha0 := hT a0 (Finset.mem_insert_self a0 T)
      have R : ∀ n : ℕ, ∀ s, Inv s → (∀ a' ∈ T, (Matrix.scalar (Fin r) a' -
            (Φ₀ * s).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det ≠ 0) →
          Module.finrank (AlgebraicClosure ℚ_[ℓ]) (LinearMap.ker (Matrix.toLin'
            (Matrix.scalar (Fin r) a0 -
              (Φ₀ * s).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))))) = n →
          ∃ s', Inv s' ∧ ∀ a' ∈ insert a0 T, (Matrix.scalar (Fin r) a' -
            (Φ₀ * s').map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det ≠ 0 := by
        intro n
        induction n using Nat.strong_induction_on with
        | _ n ihn =>
          intro s hs hsT hn
          by_cases hd : (Matrix.scalar (Fin r) a0 -
              (Φ₀ * s).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det = 0
          · obtain ⟨hsJ, hsBP, hs1⟩ := (hInv s).mp hs
            obtain ⟨i, hi⟩ := s6 (Φ₀ * s) (hsim s hsJ) a0 ha0 hd
            obtain ⟨c, hc0, hcB, hc1⟩ := s8 (δ i + δ i) _ (Set.Finite.biUnion T.finite_toSet
              (fun a' ha' => s7 (Φ₀ * s) (Matrix.vecMulVec (δ i + δ i)
                (Matrix.vecMul (δ i + δ i) J)) a' (hsT a' ha')))
            have hs' := hInvT s hs i i rfl c hc1
            have hΦst : Φ₀ * (s * (1 + c • Matrix.vecMulVec (δ i + δ i)
                (Matrix.vecMul (δ i + δ i) J))) = Φ₀ * s * (1 + c • Matrix.vecMulVec (δ i + δ i)
                (Matrix.vecMul (δ i + δ i) J)) := (Matrix.mul_assoc _ _ _).symm
            have hs'T : ∀ a' ∈ T, (Matrix.scalar (Fin r) a' -
                (Φ₀ * (s * (1 + c • Matrix.vecMulVec (δ i + δ i)
                  (Matrix.vecMul (δ i + δ i) J)))).map
                  (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det ≠ 0 := by
              intro a' ha' h0
              rw [hΦst] at h0
              exact hcB (Set.mem_iUnion₂.mpr ⟨a', ha', h0⟩)
            have hlt := hi c hc0
            rw [← hΦst, hn] at hlt
            exact ihn _ hlt _ hs' hs'T rfl
          · refine ⟨s, hs, fun a' ha' => ?_⟩
            rcases Finset.mem_insert.mp ha' with h | h
            · rw [h]; exact hd
            · exact hsT a' h
      exact R _ s₀ hs₀ hs₀T rfl

  have hcnt : ∀ Y : Matrix (Fin r) (Fin r) ℚ_[ℓ],
      ((Y.charpoly.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).roots.toFinset).card ≤ r := by
    intro Y
    calc _ ≤ (Y.charpoly.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).roots.card :=
          Multiset.toFinset_card_le _
      _ ≤ (Y.charpoly.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).natDegree :=
          Polynomial.card_roots' _
      _ = r := by
          rw [Polynomial.natDegree_map, Matrix.charpoly_natDegree_eq_dim, Fintype.card_fin]
  have hq0 : (Polynomial.X ^ 2 - Polynomial.C μ : Polynomial ℚ_[ℓ]) ≠ 0 :=
    Polynomial.X_pow_sub_C_ne_zero (by norm_num) μ
  obtain ⟨Δ, hΔmem⟩ : ∃ Δ : Finset (AlgebraicClosure ℚ_[ℓ]), ∀ a, a ∈ Δ ↔
      a ^ 2 = algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) μ :=
    ⟨((Polynomial.X ^ 2 - Polynomial.C μ).aroots (AlgebraicClosure ℚ_[ℓ])).toFinset, fun a => by
      rw [Multiset.mem_toFinset, Polynomial.mem_aroots]
      simp [hq0, sub_eq_zero]⟩
  obtain ⟨sA, hsA, hsAΔ⟩ := hPA Δ (fun a h => (hΔmem a).mp h)
  have hPB : ∀ n : ℕ, ∀ s : Matrix (Fin r) (Fin r) ℚ_[ℓ], Inv s →
      (∀ a ∈ Δ, (Matrix.scalar (Fin r) a -
        (Φ₀ * s).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det ≠ 0) →
      r - (((Φ₀ * s).charpoly.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).roots.toFinset).card
        = n →
      ∃ s' : Matrix (Fin r) (Fin r) ℚ_[ℓ], Inv s' ∧ (Φ₀ * s').charpoly.Separable := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ihn =>
      intro s hs hsΔ hn
      by_cases hsep : (Φ₀ * s).charpoly.Separable
      · exact ⟨s, hs, hsep⟩
      obtain ⟨hsJ, hsBP, hs1⟩ := (hInv s).mp hs
      have hXJ : (Φ₀ * s).transpose * J * (Φ₀ * s) = μ • J := hsim s hsJ
      have hXBP := hBPmul Φ₀ s hΦBP hsBP
      have hfK0 : (Φ₀ * s).charpoly.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])) ≠ 0 :=
        ((Matrix.charpoly_monic (Φ₀ * s)).map _).ne_zero
      obtain ⟨a, ha⟩ : ∃ a, 2 ≤ ((Φ₀ * s).charpoly.map
          (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).rootMultiplicity a := by
        have hs' : ¬ ((Φ₀ * s).charpoly.map
            (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).roots.Nodup := by
          rw [Polynomial.nodup_roots_iff_of_splits hfK0 (IsAlgClosed.splits _),
            Polynomial.separable_map]
          exact hsep
        rw [Multiset.nodup_iff_count_le_one] at hs'
        push_neg at hs'
        obtain ⟨a, ha⟩ := hs'
        exact ⟨a, by rw [Polynomial.count_roots] at ha; omega⟩
      have haroot : Polynomial.aeval a (Φ₀ * s).charpoly = 0 := by
        have h1 : 0 < ((Φ₀ * s).charpoly.map
            (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).rootMultiplicity a := by omega
        have h2 := (Polynomial.rootMultiplicity_pos hfK0).mp h1
        rw [Polynomial.IsRoot, Polynomial.eval_map] at h2
        rw [Polynomial.aeval_def]
        exact h2
      have ha2 : a ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) μ := by
        intro h
        apply hsΔ a ((hΔmem a).mpr h)
        rw [← hBR]
        exact haroot
      obtain ⟨i, j, hij, hB⟩ := wc_bsp_similitude_block_form_nondeg ℓ r k p J hJ hJdet δ β
        hspan horth (Φ₀ * s) μ hμ hXJ hXBP a ha2 haroot
      obtain ⟨D, hD⟩ : ∃ D : Polynomial ℚ_[ℓ], D = ((Φ₀ * s) + Matrix.vecMulVec
          ((Φ₀ * s).mulVec (δ i + δ j)) (Matrix.vecMul (δ i + δ j) J)).charpoly -
          (Φ₀ * s).charpoly := ⟨_, rfl⟩
      have hmapM : ((Φ₀ * s) + Matrix.vecMulVec ((Φ₀ * s).mulVec (δ i + δ j))
          (Matrix.vecMul (δ i + δ j) J)).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])) =
          (Φ₀ * s).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])) + Matrix.vecMulVec
            (((Φ₀ * s).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).mulVec
              (fun x => algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((δ i + δ j) x)))
            (Matrix.vecMul (fun x => algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((δ i + δ j) x))
              (J.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])))) := by
        ext a b
        simp only [Matrix.map_apply, Matrix.add_apply, Matrix.vecMulVec_apply, map_add, map_mul,
          RingHom.map_mulVec, RingHom.map_vecMul]
        rfl
      have hDK : D.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])) =
          ((Φ₀ * s).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])) + Matrix.vecMulVec
            (((Φ₀ * s).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).mulVec
              (fun x => algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((δ i + δ j) x)))
            (Matrix.vecMul (fun x => algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((δ i + δ j) x))
              (J.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))))).charpoly -
          ((Φ₀ * s).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).charpoly := by
        rw [hD, Polynomial.map_sub, ← Matrix.charpoly_map, ← Matrix.charpoly_map, hmapM]
      obtain ⟨g, hg⟩ : ∃ g : Polynomial (AlgebraicClosure ℚ_[ℓ]),
          g = (Φ₀ * s).charpoly.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])) /ₘ
            (Polynomial.X - Polynomial.C a) ^ ((Φ₀ * s).charpoly.map
              (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).rootMultiplicity a := ⟨_, rfl⟩
      have hfac := Polynomial.pow_mul_divByMonic_rootMultiplicity_eq
        ((Φ₀ * s).charpoly.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))) a
      rw [← hg] at hfac
      rw [← hg] at hB
      have hndiv : ¬ (Polynomial.X - Polynomial.C a) ^ ((Φ₀ * s).charpoly.map
          (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).rootMultiplicity a ∣
          D.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])) := by
        rintro ⟨h, hh⟩
        have hdvd : ((Φ₀ * s).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).charpoly ∣
            g * (((Φ₀ * s).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])) + Matrix.vecMulVec
              (((Φ₀ * s).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).mulVec
                (fun x => algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((δ i + δ j) x)))
              (Matrix.vecMul (fun x => algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((δ i + δ j) x))
                (J.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))))).charpoly -
            ((Φ₀ * s).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).charpoly) := by
          rw [← hDK, hh, Matrix.charpoly_map]
          refine ⟨h, ?_⟩
          rw [← mul_assoc, mul_comm g, hfac]
        have h0 := wc_bsp_charpoly_rank_one_residue r
          ((Φ₀ * s).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])))
          (((Φ₀ * s).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).mulVec
            (fun x => algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((δ i + δ j) x)))
          (Matrix.vecMul (fun x => algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((δ i + δ j) x))
            (J.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])))) g hdvd
        rw [Matrix.mulVec_mulVec] at h0
        exact hB h0
      have hpen : ∀ c : ℚ_[ℓ], ((Φ₀ * s * (1 + c • Matrix.vecMulVec (δ i + δ j)
          (Matrix.vecMul (δ i + δ j) J))).charpoly).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))
          = (Φ₀ * s).charpoly.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])) +
            Polynomial.C (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) c) *
              D.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])) := by
        intro c
        rw [Matrix.mul_add, Matrix.mul_one, Matrix.mul_smul, Matrix.mul_vecMulVec,
          wc_bsp_charpoly_rank_one_affine, ← hD, Polynomial.map_add, Polynomial.map_mul,
          Polynomial.map_C]
      have hdeg : (D.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).degree <
          ((Φ₀ * s).charpoly.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).degree := by
        rw [Polynomial.degree_map, Polynomial.degree_map, hD]
        have hP := Matrix.charpoly_monic ((Φ₀ * s) + Matrix.vecMulVec
          ((Φ₀ * s).mulVec (δ i + δ j)) (Matrix.vecMul (δ i + δ j) J))
        have e1 : ((Φ₀ * s) + Matrix.vecMulVec ((Φ₀ * s).mulVec (δ i + δ j))
            (Matrix.vecMul (δ i + δ j) J)).charpoly.degree = (Φ₀ * s).charpoly.degree := by
          rw [Matrix.charpoly_degree_eq_dim, Matrix.charpoly_degree_eq_dim]
        rw [← e1]
        exact Polynomial.degree_sub_lt e1 hP.ne_zero
          (by rw [hP.leadingCoeff, (Matrix.charpoly_monic (Φ₀ * s)).leadingCoeff])
      have hB0 := wc_bsp_pencil_more_roots
        ((Φ₀ * s).charpoly.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])))
        (D.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))) a
        ((Matrix.charpoly_monic (Φ₀ * s)).map _) hdeg ha hndiv
      have hB1 := hB0.preimage (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])).injective.injOn
      obtain ⟨c, hc0, hcB, hc1⟩ := s8 (δ i + δ j) _ (hB1.union (Set.Finite.biUnion
        Δ.finite_toSet (fun a' ha' => s7 (Φ₀ * s) (Matrix.vecMulVec (δ i + δ j)
          (Matrix.vecMul (δ i + δ j) J)) a' (hsΔ a' ha'))))
      have hgt : ((Φ₀ * s).charpoly.map
            (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).roots.toFinset.card <
          ((Φ₀ * s).charpoly.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])) +
            Polynomial.C (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) c) *
              D.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).roots.toFinset.card := by
        by_contra hle
        push_neg at hle
        exact hcB (Or.inl hle)
      have hs' := hInvT s hs i j hij c hc1
      have hΦst : Φ₀ * (s * (1 + c • Matrix.vecMulVec (δ i + δ j) (Matrix.vecMul (δ i + δ j) J)))
          = Φ₀ * s * (1 + c • Matrix.vecMulVec (δ i + δ j) (Matrix.vecMul (δ i + δ j) J)) :=
        (Matrix.mul_assoc _ _ _).symm
      have hs'Δ : ∀ a' ∈ Δ, (Matrix.scalar (Fin r) a' -
          (Φ₀ * (s * (1 + c • Matrix.vecMulVec (δ i + δ j) (Matrix.vecMul (δ i + δ j) J)))).map
            (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det ≠ 0 := by
        intro a' ha' h0
        rw [hΦst] at h0
        exact hcB (Or.inr (Set.mem_iUnion₂.mpr ⟨a', ha', h0⟩))
      have hcount : (((Φ₀ * (s * (1 + c • Matrix.vecMulVec (δ i + δ j)
          (Matrix.vecMul (δ i + δ j) J)))).charpoly.map
            (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).roots.toFinset).card =
          ((Φ₀ * s).charpoly.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])) +
            Polynomial.C (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) c) *
              D.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).roots.toFinset.card := by
        rw [hΦst, hpen]
      have hb1 := hcnt (Φ₀ * (s * (1 + c • Matrix.vecMulVec (δ i + δ j)
          (Matrix.vecMul (δ i + δ j) J))))
      exact ihn _ (by omega) _ hs' hs'Δ rfl
  obtain ⟨s', hs', hsep⟩ := hPB _ sA hsA hsAΔ rfl
  obtain ⟨h1, h2, h3⟩ := (hInv s').mp hs'
  exact ⟨s', h1, h2, h3, hsep⟩

theorem wc_pencil_VQ_chebotarev_datum_nm (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n) (hNM : wcPencilNoMixed D)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∃ (r m₀ : ℕ) (J Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      J.transpose = -J ∧ IsUnit J.det ∧ (∀ a b, ‖Φ a b‖ ≤ 1) ∧ ‖Φ.det‖ = 1 ∧
      ∀ s : Matrix (Fin r) (Fin r) ℚ_[ℓ], s.transpose * J * s = J →
        (∀ a b, ‖s a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(m₀ : ℤ))) →
        ∀ N t : ℕ, 1 ≤ N → ∃ d : ℕ, 1 ≤ d ∧ N ∣ d - 1 ∧ ∃ x ∈ wcP1ClosedPt F'' d,
          (∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) ∧
          (wcPencilLoc D ℓ hP x d = 0 ∨
            ∃ g : Matrix (Fin r) (Fin r) ℚ_[ℓ],
              (∀ a b, ‖g a b - (Φ * s) a b‖ ≤ (ℓ : ℝ) ^ (-(t : ℤ))) ∧
              wcPencilLoc D ℓ hP x d = g.charpoly.aroots (AlgebraicClosure ℚ_[ℓ])) :=
by
  classical
  obtain ⟨r, k, p, J, G, hG, ρ, deg, F₁, μ, δ, β, ε, τ, hJ, hJdet, hint, hF₁, hμ, hF₁J, hτ,
    hspan, horth, hconn, hF₁BP, hcheb⟩ :=
    wc_pencil_VQ_block_monodromy_datum_nm F' F'' Y n hn hn2 D hNM ℓ hℓ hP hNI
  obtain ⟨M, hM⟩ : ∃ M : Fin k → Matrix (Fin r) (Fin r) ℚ_[ℓ],
      ∀ i, M i = ε i • Matrix.vecMulVec (δ i) (Matrix.vecMul (δ i) J) := ⟨_, fun i => rfl⟩
  have hLie0 := wc_sp_lie_span_block_transvections r k p J hJ hJdet δ β hspan horth hconn ε
    (fun i => (hτ i).2.1)
  have hLie : ∀ V : Submodule ℚ_[ℓ] (Matrix (Fin r) (Fin r) ℚ_[ℓ]), (∀ i, M i ∈ V) →
      (∀ A ∈ V, ∀ B ∈ V, A * B - B * A ∈ V) →
      ∀ X : Matrix (Fin r) (Fin r) ℚ_[ℓ], X.transpose * J + J * X = 0 →
        (∀ i, X.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})) → X ∈ V :=
    fun V hV hcl X hX hXB => hLie0 V (fun i => by rw [← hM i]; exact hV i) hcl X hX hXB
  obtain ⟨mw, hmw⟩ :=
    wc_sp_block_congruence_integer_words ℓ r k p J hJ hJdet δ β hspan horth ε M hM hLie

  have hℓ1 : (1 : ℝ) ≤ (ℓ : ℝ) := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt.le
  have hmulL : ∀ (A X : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (e : ℝ), 0 ≤ e → (∀ a b, ‖A a b‖ ≤ 1) →
      (∀ a b, ‖X a b‖ ≤ e) → ∀ a b, ‖(A * X) a b‖ ≤ e := by
    intro A X e he hA hX a b
    rw [Matrix.mul_apply]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg he
    intro c _
    rw [norm_mul]
    calc ‖A a c‖ * ‖X c b‖ ≤ 1 * e := mul_le_mul (hA a c) (hX c b) (norm_nonneg _) zero_le_one
      _ = e := one_mul e
  have hmulR : ∀ (X B : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (e : ℝ), 0 ≤ e → (∀ a b, ‖X a b‖ ≤ e) →
      (∀ a b, ‖B a b‖ ≤ 1) → ∀ a b, ‖(X * B) a b‖ ≤ e := by
    intro X B e he hX hB a b
    rw [Matrix.mul_apply]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg he
    intro c _
    rw [norm_mul]
    calc ‖X a c‖ * ‖B c b‖ ≤ e * 1 := mul_le_mul (hX a c) (hB c b) (norm_nonneg _) he
      _ = e := mul_one e
  have hnearInt : ∀ (X : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (m : ℕ),
      (∀ a b, ‖X a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ))) →
      ∀ a b, ‖X a b‖ ≤ 1 := by
    intro X m hX a b
    have hpow : (ℓ : ℝ) ^ (-(m : ℤ)) ≤ 1 := zpow_le_one_of_nonpos₀ hℓ1 (by omega)
    have h1 : ‖(1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1 := by
      by_cases hab : a = b
      · subst hab; simp
      · simp [Matrix.one_apply_ne hab]
    have e : X a b = (X a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b) +
        (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b := by ring
    rw [e]
    exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ((hX a b).trans hpow) h1)

  have hdetle : ∀ X : Matrix (Fin r) (Fin r) ℚ_[ℓ], (∀ a b, ‖X a b‖ ≤ 1) → ‖X.det‖ ≤ 1 := by
    intro X hX
    rw [Matrix.det_apply]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg zero_le_one
    intro σ _
    have h1 : ‖∏ i, X (σ i) i‖ ≤ 1 := by
      rw [norm_prod]
      first
        | exact Finset.prod_le_one₀ (fun i _ => norm_nonneg _) (fun i _ => hX _ _)
        | exact Finset.prod_le_one' (fun i _ => hX _ _)
        | exact Finset.prod_le_one (fun i _ => norm_nonneg _) (fun i _ => hX _ _)
    rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h
    · rw [h, one_smul]; exact h1
    · rw [h, Units.neg_smul, one_smul, norm_neg]; exact h1
  have hunit : ∀ σ : G, ‖(ρ σ).det‖ = 1 := by
    intro σ
    have h1 : ρ σ * ρ σ⁻¹ = 1 := by rw [← map_mul, mul_inv_cancel, map_one]
    have h2 : (ρ σ).det * (ρ σ⁻¹).det = 1 := by rw [← Matrix.det_mul, h1, Matrix.det_one]
    have h3 : ‖(ρ σ).det‖ * ‖(ρ σ⁻¹).det‖ = 1 := by rw [← norm_mul, h2, norm_one]
    have ha := hdetle (ρ σ) (hint σ)
    have hb := hdetle (ρ σ⁻¹) (hint σ⁻¹)
    have ha0 := norm_nonneg (ρ σ).det
    have hb0 := norm_nonneg (ρ σ⁻¹).det
    nlinarith
  have hsdet : ∀ s : Matrix (Fin r) (Fin r) ℚ_[ℓ], s.transpose * J * s = J → ‖s.det‖ = 1 := by
    intro s hsJ
    have h := congrArg Matrix.det hsJ
    rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose] at h
    have hJ0 : J.det ≠ 0 := hJdet.ne_zero
    have h2 : s.det * s.det = 1 := by
      have h' : s.det * s.det * J.det = 1 * J.det := by linear_combination h
      exact mul_right_cancel₀ hJ0 h'
    have h3 : ‖s.det‖ * ‖s.det‖ = 1 := by rw [← norm_mul, h2, norm_one]
    rcases mul_self_eq_one_iff.mp h3 with h4 | h4
    · exact h4
    · have := norm_nonneg s.det
      linarith

  have hBPmul : ∀ X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ],
      (∀ i, X.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})) →
      (∀ i, Y.mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})) →
      ∀ i, (X * Y).mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i}) := by
    intro X Y hX hY i
    have hle : Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i}) ≤
        (Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})).comap (Matrix.toLin' X) := by
      rw [Submodule.span_le]
      rintro _ ⟨j, hj, rfl⟩
      have hj' : β j = β i := hj
      have hset : {j' | β j' = β j} = {j' | β j' = β i} := by
        ext j'
        simp only [Set.mem_setOf_eq]
        rw [hj']
      show Matrix.toLin' X (δ j) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})
      rw [Matrix.toLin'_apply, ← hset]
      exact hX j
    rw [← Matrix.mulVec_mulVec]
    have h := hle (hY i)
    rw [Submodule.mem_comap, Matrix.toLin'_apply] at h
    exact h

  have hJe : ∀ a e, J a e = - J e a := by
    intro a e
    have := congrFun (congrFun hJ e) a
    simp only [Matrix.transpose_apply, Matrix.neg_apply] at this
    exact this
  have hsq : ∀ i, M i * M i = 0 := by
    intro i
    have h0 : ∑ e, Matrix.vecMul (δ i) J e * δ i e = 0 := by
      have hS : ∑ e, Matrix.vecMul (δ i) J e * δ i e = ∑ e, ∑ a, δ i a * J a e * δ i e := by
        apply Finset.sum_congr rfl
        intro e _
        show (∑ a, δ i a * J a e) * δ i e = _
        rw [Finset.sum_mul]
      have hS2 : ∑ e, ∑ a, δ i a * J a e * δ i e = -∑ e, ∑ a, δ i a * J a e * δ i e := by
        conv_lhs => rw [Finset.sum_comm]
        rw [← Finset.sum_neg_distrib]
        apply Finset.sum_congr rfl
        intro e _
        rw [← Finset.sum_neg_distrib]
        apply Finset.sum_congr rfl
        intro a _
        rw [hJe]
        ring
      rw [hS]
      have h2 : (2 : ℚ_[ℓ]) * ∑ e, ∑ a, δ i a * J a e * δ i e = 0 := by
        linear_combination hS2
      exact (mul_eq_zero.mp h2).resolve_left two_ne_zero
    ext a b
    rw [Matrix.mul_apply, Matrix.zero_apply]
    have e1 : ∀ e, M i a e * M i e b = (ε i * ε i * δ i a * Matrix.vecMul (δ i) J b) *
        (Matrix.vecMul (δ i) J e * δ i e) := by
      intro e
      simp only [hM i, Matrix.smul_apply, Matrix.vecMulVec_apply, smul_eq_mul]
      ring
    rw [Finset.sum_congr rfl (fun e _ => e1 e), ← Finset.mul_sum, h0, mul_zero]

  have hρτ : ∀ i, ρ (τ i) = 1 + M i := fun i => by rw [hM i]; exact (hτ i).2.2
  have hstep : ∀ i (c : ℚ_[ℓ]), (1 + c • M i) * (1 + M i) = 1 + (c + 1) • M i := by
    intro i c
    simp only [mul_add, add_mul, mul_one, one_mul, smul_mul_assoc, hsq i, smul_zero, add_zero,
      add_smul, one_smul]
    abel
  have hstep' : ∀ i (c : ℚ_[ℓ]), (1 + c • M i) * (1 - M i) = 1 + (c - 1) • M i := by
    intro i c
    simp only [mul_sub, add_mul, mul_one, one_mul, smul_mul_assoc, hsq i, smul_zero, add_zero,
      sub_smul, one_smul, sub_zero]
    abel
  have hρτinv : ∀ i, ρ (τ i)⁻¹ = 1 - M i := by
    intro i
    have h2 : (1 - M i) * (1 + M i) = 1 := by
      calc (1 - M i) * (1 + M i) = 1 + M i - M i * (1 + M i) := by rw [sub_mul, one_mul]
        _ = 1 := by rw [mul_add, mul_one, hsq i, add_zero, add_sub_cancel_right]
    have h3 : ρ (τ i) * ρ (τ i)⁻¹ = 1 := by rw [← map_mul, mul_inv_cancel, map_one]
    calc ρ (τ i)⁻¹ = ((1 - M i) * (1 + M i)) * ρ (τ i)⁻¹ := by rw [h2, one_mul]
      _ = (1 - M i) * (ρ (τ i) * ρ (τ i)⁻¹) := by rw [hρτ i, mul_assoc]
      _ = 1 - M i := by rw [h3, mul_one]
  have hpow : ∀ i (a : ℤ), ρ (τ i ^ a) = 1 + (a : ℚ_[ℓ]) • M i := by
    intro i a
    refine Int.induction_on a ?_ ?_ ?_
    · rw [zpow_zero, map_one, Int.cast_zero, zero_smul, add_zero]
    · intro m ih
      rw [zpow_add_one, map_mul, ih, hρτ i, hstep, Int.cast_add, Int.cast_one, Int.cast_natCast]
    · intro m ih
      rw [zpow_sub_one, map_mul, ih, hρτinv i, hstep', Int.cast_sub, Int.cast_one]
  have hword : ∀ L : List (Fin k × ℤ),
      ρ (L.map (fun q => τ q.1 ^ q.2)).prod =
        (L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod ∧
      deg (L.map (fun q => τ q.1 ^ q.2)).prod = 1 := by
    intro L
    induction L with
    | nil => exact ⟨by rw [List.map_nil, List.prod_nil, map_one, List.map_nil, List.prod_nil],
        by rw [List.map_nil, List.prod_nil, map_one]⟩
    | cons q L ih =>
      refine ⟨?_, ?_⟩
      · rw [List.map_cons, List.prod_cons, map_mul, ih.1, hpow, List.map_cons, List.prod_cons]
      · rw [List.map_cons, List.prod_cons, map_mul, ih.2, map_zpow, (hτ q.1).1, one_zpow,
          mul_one]

  obtain ⟨s₀, hs₀J, hs₀BP, hs₀1, hs₀sep⟩ :=
    wc_block_separable_perturb ℓ r k p J hJ hJdet δ β hspan horth (ρ F₁) μ hμ hF₁J hF₁BP mw
  have hs₀int := hnearInt s₀ mw hs₀1
  have hΦint : ∀ a b, ‖(ρ F₁ * s₀) a b‖ ≤ 1 := hmulL (ρ F₁) s₀ 1 zero_le_one (hint F₁) hs₀int
  have hΦdet : ‖(ρ F₁ * s₀).det‖ = 1 := by
    rw [Matrix.det_mul, norm_mul, hunit F₁, hsdet s₀ hs₀J, one_mul]
  have hΦJ : (ρ F₁ * s₀).transpose * J * (ρ F₁ * s₀) = μ • J := by
    rw [Matrix.transpose_mul]
    calc s₀.transpose * (ρ F₁).transpose * J * (ρ F₁ * s₀)
        = s₀.transpose * ((ρ F₁).transpose * J * ρ F₁) * s₀ := by simp only [Matrix.mul_assoc]
      _ = μ • (s₀.transpose * J * s₀) := by rw [hF₁J, Matrix.mul_smul, Matrix.smul_mul]
      _ = μ • J := by rw [hs₀J]
  have hΦBP := hBPmul (ρ F₁) s₀ hF₁BP hs₀BP
  obtain ⟨m₀, hm₀⟩ := wc_block_charpoly_reach ℓ r k p J hJ hJdet δ β hspan horth (ρ F₁ * s₀) μ hμ
    hΦint hΦJ hΦBP hs₀sep mw
  refine ⟨r, m₀, J, ρ F₁ * s₀, hJ, hJdet, hΦint, hΦdet, ?_⟩
  intro s hsJ hs1 N t hN
  obtain ⟨hsep, s', hs'J, hs'BP, hs'1, hs'char⟩ := hm₀ s hsJ hs1
  have hs'int := hnearInt s' mw hs'1
  have hΦs'int := hmulL (ρ F₁ * s₀) s' 1 zero_le_one hΦint hs'int
  obtain ⟨t', ht'⟩ :=
    wc_charpoly_companion_lift ℓ r (ρ F₁ * s₀ * s') (ρ F₁ * s₀ * s) hΦs'int hs'char hsep t
  have huJ : (s₀ * s').transpose * J * (s₀ * s') = J := by
    rw [Matrix.transpose_mul]
    calc s'.transpose * s₀.transpose * J * (s₀ * s')
        = s'.transpose * (s₀.transpose * J * s₀) * s' := by simp only [Matrix.mul_assoc]
      _ = J := by rw [hs₀J, hs'J]
  have huBP := hBPmul s₀ s' hs₀BP hs'BP
  have hu1 : ∀ a b, ‖(s₀ * s') a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤
      (ℓ : ℝ) ^ (-(mw : ℤ)) := by
    intro a b
    have e : (s₀ * s') a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b =
        ((s₀ - 1) * s') a b + (s' a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b) := by
      rw [Matrix.sub_mul, Matrix.one_mul, Matrix.sub_apply]
      ring
    rw [e]
    refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ (hs'1 a b))
    exact hmulR (s₀ - 1) s' _ (by positivity)
      (fun a b => by rw [Matrix.sub_apply]; exact hs₀1 a b) hs'int a b
  obtain ⟨L, hL⟩ := hmw (s₀ * s') huJ huBP hu1 t'
  obtain ⟨hρw, hdegw⟩ := hword L
  obtain ⟨d, x, σ, c, hd, hx, hxS, hdiv, happ, hloc⟩ :=
    hcheb (F₁ * (L.map (fun q => τ q.1 ^ q.2)).prod) N t' hN
  have hdegγ : Multiplicative.toAdd (deg (F₁ * (L.map (fun q => τ q.1 ^ q.2)).prod)) = 1 := by
    rw [map_mul, hdegw, mul_one, hF₁]
    rfl
  rw [hdegγ] at hdiv
  have hdivN : N ∣ d - 1 := by
    have h1 : ((d - 1 : ℕ) : ℤ) = (d : ℤ) - 1 := by omega
    rw [← h1] at hdiv
    exact Int.natCast_dvd_natCast.mp hdiv
  refine ⟨d, hd, hdivN, x, hx, hxS, ?_⟩
  rcases hloc with h0 | hσ
  · exact Or.inl h0
  · right
    have hg'near : ∀ a b, ‖ρ (c * σ * c⁻¹) a b - (ρ F₁ * s₀ * s') a b‖ ≤
        (ℓ : ℝ) ^ (-(t' : ℤ)) := by
      intro a b
      have hγ : ρ (F₁ * (L.map (fun q => τ q.1 ^ q.2)).prod) =
          ρ F₁ * (L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod := by
        rw [map_mul, hρw]
      have e : ρ (c * σ * c⁻¹) a b - (ρ F₁ * s₀ * s') a b =
          (ρ (c * σ * c⁻¹) a b - ρ (F₁ * (L.map (fun q => τ q.1 ^ q.2)).prod) a b) +
            (ρ F₁ * ((L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • M q.1)).prod - s₀ * s')) a b := by
        rw [hγ, Matrix.mul_sub, Matrix.sub_apply, ← Matrix.mul_assoc]
        ring
      rw [e]
      refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le (happ a b) ?_)
      exact hmulL (ρ F₁) _ _ (by positivity) (hint F₁)
        (fun a b => by rw [Matrix.sub_apply]; exact hL a b) a b
    obtain ⟨g, hg, hgchar⟩ := ht' (ρ (c * σ * c⁻¹)) (hint (c * σ * c⁻¹)) hg'near
    refine ⟨g, hg, ?_⟩
    rw [hσ, hgchar]
    have h1 : ρ (c * σ * c⁻¹) = (ρ c * ρ σ) * ρ c⁻¹ := by rw [map_mul, map_mul]
    have h2 : ρ c⁻¹ * ρ c = 1 := by rw [← map_mul, inv_mul_cancel, map_one]
    rw [h1, Matrix.charpoly_mul_comm, ← mul_assoc, h2, one_mul]

theorem wc_symplectic_perturb_avoid_eigen (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r m : ℕ)
    (J Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) :
    J.transpose = -J → IsUnit J.det → IsUnit Φ.det →
      ∀ Δ : Finset (AlgebraicClosure ℚ_[ℓ]), ∃ s : Matrix (Fin r) (Fin r) ℚ_[ℓ],
        s.transpose * J * s = J ∧
        (∀ a b, ‖s a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ))) ∧
        ∀ δ ∈ Δ, Polynomial.aeval δ (Φ * s).charpoly ≠ 0 :=
by
  classical
  intro hJ hJu hΦu Δ
  have hℓ : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt
  have hℓ0 : (ℓ : ℝ) ≠ 0 := ne_of_gt (lt_trans zero_lt_one hℓ)
  have hε0 : (0 : ℝ) ≤ (ℓ : ℝ) ^ (-(m : ℤ)) := (zpow_pos (lt_trans zero_lt_one hℓ) _).le
  have hε1 : (ℓ : ℝ) ^ (-(m : ℤ)) ≤ 1 := zpow_le_one_of_nonpos₀ hℓ.le (by omega)
  have hJ0 : J.det ≠ 0 := hJu.ne_zero
  have hΦ0 : Φ.det ≠ 0 := hΦu.ne_zero

  have s1 : ∀ (v : Fin r → ℚ_[ℓ]) (c : ℚ_[ℓ]),
      (1 + c • Matrix.vecMulVec v (Matrix.vecMul v J)).transpose * J *
        (1 + c • Matrix.vecMulVec v (Matrix.vecMul v J)) = J := by
    intro v c
    set w := Matrix.vecMul v J with hw
    have hwu : w = -(J.mulVec v) := by
      rw [hw, ← Matrix.mulVec_transpose, hJ, Matrix.neg_mulVec]
    have hq : w ⬝ᵥ v = 0 := by
      have h1 : v ⬝ᵥ J.mulVec v = w ⬝ᵥ v := by rw [Matrix.dotProduct_mulVec]
      have h2 : w ⬝ᵥ v = -(w ⬝ᵥ v) := by
        conv_lhs => rw [hwu]
        rw [neg_dotProduct, dotProduct_comm, h1]
      have h3 : (2 : ℚ_[ℓ]) * (w ⬝ᵥ v) = 0 := by linear_combination h2
      exact (mul_eq_zero.mp h3).resolve_left two_ne_zero
    have hNN : Matrix.vecMulVec w w * Matrix.vecMulVec v w = 0 := by
      ext a b
      simp only [Matrix.mul_apply, Matrix.vecMulVec_apply, Matrix.zero_apply]
      have : ∑ x, w a * w x * (v x * w b) = (w a * w b) * (w ⬝ᵥ v) := by
        rw [dotProduct, Finset.mul_sum]
        exact Finset.sum_congr rfl (fun x _ => by ring)
      rw [this, hq, mul_zero]
    have hT : (1 + c • Matrix.vecMulVec v w).transpose = 1 + c • Matrix.vecMulVec w v := by
      rw [Matrix.transpose_add, Matrix.transpose_one, Matrix.transpose_smul,
        Matrix.transpose_vecMulVec]
    have hNJ : Matrix.vecMulVec w v * J = Matrix.vecMulVec w w := by
      rw [Matrix.vecMulVec_mul]
    have hJN : J * Matrix.vecMulVec v w = -Matrix.vecMulVec w w := by
      rw [Matrix.mul_vecMulVec]
      have : J.mulVec v = -w := by rw [hwu, neg_neg]
      rw [this]
      ext a b
      simp [Matrix.vecMulVec_apply]
    rw [hT]
    have hexp : (1 + c • Matrix.vecMulVec w v) * J * (1 + c • Matrix.vecMulVec v w)
        = J + c • (Matrix.vecMulVec w v * J + J * Matrix.vecMulVec v w) +
          (c * c) • (Matrix.vecMulVec w v * J * Matrix.vecMulVec v w) := by
      simp only [add_mul, mul_add, one_mul, mul_one, smul_mul_assoc, mul_smul_comm, smul_add,
        smul_smul]
      abel
    rw [hexp, hNJ, hJN, hNN, add_neg_cancel, smul_zero, smul_zero, add_zero, add_zero]

  have s2 : ∀ X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ],
      (∀ a b, ‖X a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ))) →
      (∀ a b, ‖Y a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ))) →
      ∀ a b, ‖(X * Y) a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ)) := by
    intro X Y hX hY a b
    have e : X * Y - 1 = (X - 1) * (Y - 1) + (X - 1) + (Y - 1) := by noncomm_ring
    have e' : (X * Y) a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b =
        ((X - 1) * (Y - 1)) a b + (X - 1) a b + (Y - 1) a b := by
      rw [← Matrix.sub_apply, e, Matrix.add_apply, Matrix.add_apply]
    rw [e']
    have h1 : ‖((X - 1) * (Y - 1)) a b‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ)) := by
      rw [Matrix.mul_apply]
      apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg hε0
      intro k _
      rw [norm_mul, Matrix.sub_apply, Matrix.sub_apply]
      exact (mul_le_mul (hX a k) ((hY k b).trans hε1) (norm_nonneg _) hε0).trans
        (le_of_eq (mul_one _))
    refine (IsUltrametricDist.norm_add_le_max _ _).trans
      (max_le ((IsUltrametricDist.norm_add_le_max _ _).trans (max_le h1 ?_)) ?_)
    · rw [Matrix.sub_apply]; exact hX a b
    · rw [Matrix.sub_apply]; exact hY a b

  have s5 : ∀ v : Fin r → ℚ_[ℓ], ∃ j₀ : ℕ, ∀ j : ℕ, j₀ ≤ j → ∀ a b,
      ‖(1 + ((ℓ : ℚ_[ℓ]) ^ j) • Matrix.vecMulVec v (Matrix.vecMul v J)) a b -
        (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ)) := by
    intro v
    set w := Matrix.vecMul v J with hw
    set C : ℝ := 1 + ∑ a, ∑ b, ‖v a * w b‖ with hC
    have hCb : ∀ a b, ‖v a * w b‖ ≤ C := by
      intro a b
      have h1 : ‖v a * w b‖ ≤ ∑ b', ‖v a * w b'‖ :=
        Finset.single_le_sum (f := fun b' => ‖v a * w b'‖) (fun _ _ => norm_nonneg _)
          (Finset.mem_univ b)
      have h2 : ∑ b', ‖v a * w b'‖ ≤ ∑ a', ∑ b', ‖v a' * w b'‖ :=
        Finset.single_le_sum (f := fun a' => ∑ b', ‖v a' * w b'‖)
          (fun _ _ => Finset.sum_nonneg (fun _ _ => norm_nonneg _)) (Finset.mem_univ a)
      linarith
    obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt C hℓ
    refine ⟨n + m, fun j hj a b => ?_⟩
    rw [Matrix.add_apply, add_sub_cancel_left, Matrix.smul_apply, Matrix.vecMulVec_apply,
      smul_eq_mul, norm_mul, Padic.norm_p_pow]
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ (-(j : ℤ)) := zpow_pos (lt_trans zero_lt_one hℓ) _
    calc (ℓ : ℝ) ^ (-(j : ℤ)) * ‖v a * w b‖ ≤ (ℓ : ℝ) ^ (-(j : ℤ)) * (ℓ : ℝ) ^ (n : ℤ) := by
          apply mul_le_mul_of_nonneg_left _ hpos.le
          rw [zpow_natCast]; exact (hCb a b).trans hn.le
      _ = (ℓ : ℝ) ^ (-(j : ℤ) + n) := by rw [zpow_add₀ hℓ0]
      _ ≤ (ℓ : ℝ) ^ (-(m : ℤ)) := zpow_le_zpow_right₀ hℓ.le (by omega)

  have s6 : ∀ (j₀ : ℕ) (B : Set ℚ_[ℓ]), B.Finite → ∃ j : ℕ, j₀ ≤ j ∧ (ℓ : ℚ_[ℓ]) ^ j ∉ B := by
    intro j₀ B hB
    have hinj : Function.Injective (fun k : ℕ => (ℓ : ℚ_[ℓ]) ^ (j₀ + k)) := by
      intro k₁ k₂ h
      have h' : ((ℓ ^ (j₀ + k₁) : ℕ) : ℚ_[ℓ]) = ((ℓ ^ (j₀ + k₂) : ℕ) : ℚ_[ℓ]) := by
        push_cast; exact h
      have h'' : j₀ + k₁ = j₀ + k₂ :=
        Nat.pow_right_injective (Fact.out : ℓ.Prime).two_le (Nat.cast_injective h')
      omega
    obtain ⟨x, hx⟩ := ((Set.infinite_range_of_injective hinj).diff hB).nonempty
    obtain ⟨⟨k, rfl⟩, hxB⟩ := hx
    exact ⟨j₀ + k, by omega, hxB⟩

  have s4 : ∀ (X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (δ : AlgebraicClosure ℚ_[ℓ]),
      (Matrix.scalar (Fin r) δ - X.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det ≠ 0 →
      {c : ℚ_[ℓ] | (Matrix.scalar (Fin r) δ -
          (X * (1 + c • Y)).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det = 0}.Finite := by
    intro X Y δ hdet
    set f := algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) with hf
    set B := Matrix.scalar (Fin r) δ - X.map f with hB
    set Z := (X * Y).map f with hZ
    set p : Polynomial (AlgebraicClosure ℚ_[ℓ]) :=
      ((Polynomial.X : Polynomial (AlgebraicClosure ℚ_[ℓ])) • (-Z).map Polynomial.C +
        B.map Polynomial.C).det with hp
    have hp0 : p ≠ 0 := by
      intro h
      apply hdet
      rw [← Polynomial.coeff_det_X_add_C_zero (-Z) B, ← hp, h, Polynomial.coeff_zero]
    have heval : ∀ z, p.eval z = (B + z • (-Z)).det := by
      intro z
      rw [hp, show Polynomial.eval z = ⇑(Polynomial.evalRingHom z) from rfl, RingHom.map_det]
      congr 1
      ext a b
      simp [RingHom.mapMatrix_apply, Matrix.map_apply] <;> ring
    apply Set.Finite.subset ((p.roots.toFinset.finite_toSet).preimage f.injective.injOn)
    intro c hc
    simp only [Set.mem_setOf_eq] at hc
    simp only [Set.mem_preimage, Finset.mem_coe, Multiset.mem_toFinset]
    rw [Polynomial.mem_roots hp0, Polynomial.IsRoot, heval]
    have hm : (X * (1 + c • Y)).map f = X.map f + f c • Z := by
      rw [mul_add, mul_one, mul_smul_comm, hZ]
      ext a b
      simp only [Matrix.add_apply, Matrix.map_apply, Matrix.smul_apply, smul_eq_mul, map_add,
        map_mul]
    have : B + f c • (-Z) = Matrix.scalar (Fin r) δ - (X * (1 + c • Y)).map f := by
      rw [hm, smul_neg, hB]; abel
    rw [this]; exact hc

  have s3 : ∀ (X : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (δ : AlgebraicClosure ℚ_[ℓ]), X.det ≠ 0 →
      (Matrix.scalar (Fin r) δ - X.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det = 0 →
      ∃ v : Fin r → ℚ_[ℓ], ∀ c : ℚ_[ℓ], c ≠ 0 →
        Module.finrank (AlgebraicClosure ℚ_[ℓ]) (LinearMap.ker (Matrix.toLin'
          (Matrix.scalar (Fin r) δ - (X * (1 + c • Matrix.vecMulVec v (Matrix.vecMul v J))).map
            (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))))) <
        Module.finrank (AlgebraicClosure ℚ_[ℓ]) (LinearMap.ker (Matrix.toLin'
          (Matrix.scalar (Fin r) δ - X.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))))) := by
    intro X δ hX hA
    set f := algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) with hf
    set A := Matrix.scalar (Fin r) δ - X.map f with hAdef
    have hXK : (X.map f).det ≠ 0 := by
      rw [show (X.map f).det = f X.det from (RingHom.map_det f X).symm]
      exact (map_ne_zero f).mpr hX
    have hJK : (J.map f).det ≠ 0 := by
      rw [show (J.map f).det = f J.det from (RingHom.map_det f J).symm]
      exact (map_ne_zero f).mpr hJ0
    obtain ⟨x₀, hx₀, hAx₀⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hA
    obtain ⟨w₀, hw₀, hw₀A⟩ := Matrix.exists_vecMul_eq_zero_iff.mpr hA
    set α := Matrix.vecMul w₀ (X.map f) with hα
    set β := (J.map f).mulVec x₀ with hβ
    have hα0 : α ≠ 0 := fun h => hXK (Matrix.exists_vecMul_eq_zero_iff.mp ⟨w₀, hw₀, h⟩)
    have hβ0 : β ≠ 0 := fun h => hJK (Matrix.exists_mulVec_eq_zero_iff.mp ⟨x₀, hx₀, h⟩)
    obtain ⟨j₁, hj₁⟩ := Function.ne_iff.mp hα0
    obtain ⟨j₂, hj₂⟩ := Function.ne_iff.mp hβ0
    rw [Pi.zero_apply] at hj₁ hj₂
    have key : ∀ j : Fin r,
        α ⬝ᵥ (fun i => f ((Pi.single j (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ]) i)) = α j ∧
        (fun i => f ((Pi.single j (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ]) i)) ⬝ᵥ β = β j := by
      intro j
      have hfun : (fun i => f ((Pi.single j (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ]) i)) =
          (Pi.single j (1 : AlgebraicClosure ℚ_[ℓ]) : Fin r → AlgebraicClosure ℚ_[ℓ]) := by
        ext i
        by_cases h : i = j
        · subst h; simp
        · simp [Pi.single_apply, h]
      rw [hfun]
      constructor
      · simp [dotProduct, Pi.single_apply]
      · simp [dotProduct, Pi.single_apply]
    have hv : ∃ v : Fin r → ℚ_[ℓ], α ⬝ᵥ (fun i => f (v i)) ≠ 0 ∧
        (fun i => f (v i)) ⬝ᵥ β ≠ 0 := by
      by_cases h2 : α j₂ = 0
      · by_cases h1 : β j₁ = 0
        · have hsum : (fun i => f (((Pi.single j₁ (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ]) +
                (Pi.single j₂ (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ])) i)) =
              (fun i => f ((Pi.single j₁ (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ]) i)) +
                (fun i => f ((Pi.single j₂ (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ]) i)) := by
            ext i; simp
          refine ⟨(Pi.single j₁ (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ]) +
            (Pi.single j₂ (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ]), ?_, ?_⟩
          · rw [hsum, dotProduct_add, (key j₁).1, (key j₂).1, h2, add_zero]; exact hj₁
          · rw [hsum, add_dotProduct, (key j₁).2, (key j₂).2, h1, zero_add]; exact hj₂
        · exact ⟨(Pi.single j₁ (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ]),
            by rw [(key j₁).1]; exact hj₁, by rw [(key j₁).2]; exact h1⟩
      · exact ⟨(Pi.single j₂ (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ]),
          by rw [(key j₂).1]; exact h2, by rw [(key j₂).2]; exact hj₂⟩
    obtain ⟨v, hP1, hP2⟩ := hv
    refine ⟨v, fun c hc => ?_⟩
    set vK : Fin r → AlgebraicClosure ℚ_[ℓ] := fun i => f (v i) with hvK
    set u := (X.map f).mulVec vK with hu
    set ω := Matrix.vecMul vK (J.map f) with hω
    have hmap : (X * (1 + c • Matrix.vecMulVec v (Matrix.vecMul v J))).map f =
        X.map f + f c • Matrix.vecMulVec u ω := by
      rw [mul_add, mul_one, mul_smul_comm, Matrix.mul_vecMulVec]
      ext a b
      simp only [Matrix.map_apply, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul, map_add,
        map_mul, Matrix.vecMulVec_apply, RingHom.map_mulVec, RingHom.map_vecMul]
      rfl
    have hvv : ∀ x, (Matrix.vecMulVec u ω).mulVec x = (ω ⬝ᵥ x) • u := by
      intro x
      ext a
      simp only [Matrix.mulVec, dotProduct, Matrix.vecMulVec_apply, Pi.smul_apply, smul_eq_mul,
        Finset.sum_mul]
      exact Finset.sum_congr rfl (fun b _ => by ring)
    set A' := Matrix.scalar (Fin r) δ -
      (X * (1 + c • Matrix.vecMulVec v (Matrix.vecMul v J))).map f with hA'def
    have hsm : ∀ (γ : AlgebraicClosure ℚ_[ℓ]) (M : Matrix (Fin r) (Fin r) (AlgebraicClosure ℚ_[ℓ]))
        (x : Fin r → AlgebraicClosure ℚ_[ℓ]), (γ • M).mulVec x = γ • M.mulVec x := by
      intro γ M x
      ext i
      simp only [Matrix.mulVec, dotProduct, Matrix.smul_apply, Pi.smul_apply, smul_eq_mul,
        Finset.mul_sum]
      exact Finset.sum_congr rfl (fun j _ => by ring)
    have hA'x : ∀ x, A'.mulVec x = A.mulVec x - (f c * (ω ⬝ᵥ x)) • u := by
      intro x
      rw [hA'def, hmap, sub_add_eq_sub_sub, Matrix.sub_mulVec, hsm, hvv, smul_smul]
    have hwu : w₀ ⬝ᵥ u = α ⬝ᵥ vK := Matrix.dotProduct_mulVec _ _ _
    have hωx : ω ⬝ᵥ x₀ = vK ⬝ᵥ β := (Matrix.dotProduct_mulVec _ _ _).symm
    have hfc : f c ≠ 0 := (map_ne_zero f).mpr hc
    have hle : LinearMap.ker (Matrix.toLin' A') ≤ LinearMap.ker (Matrix.toLin' A) := by
      intro x hx
      rw [LinearMap.mem_ker, Matrix.toLin'_apply] at hx ⊢
      rw [hA'x] at hx
      have h1 : A.mulVec x = (f c * (ω ⬝ᵥ x)) • u := sub_eq_zero.mp hx
      have h2 : w₀ ⬝ᵥ A.mulVec x = 0 := by
        rw [Matrix.dotProduct_mulVec, hw₀A, zero_dotProduct]
      rw [h1, dotProduct_smul, smul_eq_mul, hwu] at h2
      have h3 : ω ⬝ᵥ x = 0 := by
        rcases mul_eq_zero.mp h2 with h | h
        · exact (mul_eq_zero.mp h).resolve_left hfc
        · exact absurd h hP1
      rw [h1, h3, mul_zero, zero_smul]
    have hlt : LinearMap.ker (Matrix.toLin' A') < LinearMap.ker (Matrix.toLin' A) := by
      refine lt_of_le_of_ne hle (fun heq => ?_)
      have hx₀' : x₀ ∈ LinearMap.ker (Matrix.toLin' A) := by
        rw [LinearMap.mem_ker, Matrix.toLin'_apply]; exact hAx₀
      rw [← heq, LinearMap.mem_ker, Matrix.toLin'_apply, hA'x, hAx₀, zero_sub,
        neg_eq_zero] at hx₀'
      have hu0 : u ≠ 0 := by
        intro h; apply hP1; rw [← hwu, h, dotProduct_zero]
      exact smul_ne_zero (mul_ne_zero hfc (by rw [hωx]; exact hP2)) hu0 hx₀'
    exact Submodule.finrank_lt_finrank_of_lt hlt

  have hBR : ∀ (X : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (δ : AlgebraicClosure ℚ_[ℓ]),
      Polynomial.aeval δ X.charpoly =
        (Matrix.scalar (Fin r) δ - X.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det := by
    intro X δ
    rw [← Matrix.eval_charpoly, Matrix.charpoly_map, Polynomial.eval_map, ← Polynomial.aeval_def]
  have hsdet : ∀ s : Matrix (Fin r) (Fin r) ℚ_[ℓ], s.transpose * J * s = J → s.det ≠ 0 := by
    intro s hs h0
    have h := congrArg Matrix.det hs
    rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, h0, zero_mul, zero_mul] at h
    exact hJ0 h.symm

  have hQ : ∀ P : Finset (AlgebraicClosure ℚ_[ℓ]), ∃ s : Matrix (Fin r) (Fin r) ℚ_[ℓ],
      s.transpose * J * s = J ∧
      (∀ a b, ‖s a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ))) ∧
      ∀ δ ∈ P, (Matrix.scalar (Fin r) δ -
        (Φ * s).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det ≠ 0 := by
    intro P
    induction P using Finset.induction_on with
    | empty =>
      exact ⟨1, by simp, fun a b => by rw [sub_self, norm_zero]; exact hε0,
        fun δ h => by simp at h⟩
    | insert δ P hδP ih =>
      obtain ⟨s₀, hs₀J, hs₀1, hs₀P⟩ := ih
      have R : ∀ n : ℕ, ∀ s : Matrix (Fin r) (Fin r) ℚ_[ℓ], s.transpose * J * s = J →
          (∀ a b, ‖s a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ))) →
          (∀ δ' ∈ P, (Matrix.scalar (Fin r) δ' -
            (Φ * s).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det ≠ 0) →
          Module.finrank (AlgebraicClosure ℚ_[ℓ]) (LinearMap.ker (Matrix.toLin'
            (Matrix.scalar (Fin r) δ -
              (Φ * s).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))))) = n →
          ∃ s' : Matrix (Fin r) (Fin r) ℚ_[ℓ], s'.transpose * J * s' = J ∧
            (∀ a b, ‖s' a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤
              (ℓ : ℝ) ^ (-(m : ℤ))) ∧
            ∀ δ' ∈ insert δ P, (Matrix.scalar (Fin r) δ' -
              (Φ * s').map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det ≠ 0 := by
        intro n
        induction n using Nat.strong_induction_on with
        | _ n ihn =>
          intro s hsJ hs1 hsP hn
          by_cases hd : (Matrix.scalar (Fin r) δ -
              (Φ * s).map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det = 0
          · have hX : (Φ * s).det ≠ 0 := by
              rw [Matrix.det_mul]; exact mul_ne_zero hΦ0 (hsdet s hsJ)
            obtain ⟨v, hv⟩ := s3 (Φ * s) δ hX hd
            obtain ⟨j₀, hj₀⟩ := s5 v
            have hfin : (⋃ δ' ∈ P, {c : ℚ_[ℓ] | (Matrix.scalar (Fin r) δ' -
                ((Φ * s) * (1 + c • Matrix.vecMulVec v (Matrix.vecMul v J))).map
                  (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det = 0}).Finite :=
              Set.Finite.biUnion P.finite_toSet (fun δ' hδ' => s4 (Φ * s) _ δ' (hsP δ' hδ'))
            obtain ⟨j, hjj, hjB⟩ := s6 j₀ _ hfin
            have hc0 : (ℓ : ℚ_[ℓ]) ^ j ≠ 0 :=
              pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : ℓ.Prime).ne_zero)
            have hs'J : (s * (1 + ((ℓ : ℚ_[ℓ]) ^ j) • Matrix.vecMulVec v (Matrix.vecMul v J))).transpose
                * J * (s * (1 + ((ℓ : ℚ_[ℓ]) ^ j) • Matrix.vecMulVec v (Matrix.vecMul v J))) = J := by
              rw [Matrix.transpose_mul, show ∀ T : Matrix (Fin r) (Fin r) ℚ_[ℓ],
                  T.transpose * s.transpose * J * (s * T) = T.transpose * (s.transpose * J * s) * T
                  from fun T => by simp only [Matrix.mul_assoc], hsJ]
              exact s1 v _
            have hs'1 := s2 s _ hs1 (hj₀ j hjj)
            have hΦst : Φ * (s * (1 + ((ℓ : ℚ_[ℓ]) ^ j) • Matrix.vecMulVec v (Matrix.vecMul v J)))
                = Φ * s * (1 + ((ℓ : ℚ_[ℓ]) ^ j) • Matrix.vecMulVec v (Matrix.vecMul v J)) :=
              (Matrix.mul_assoc _ _ _).symm
            have hs'P : ∀ δ' ∈ P, (Matrix.scalar (Fin r) δ' -
                (Φ * (s * (1 + ((ℓ : ℚ_[ℓ]) ^ j) • Matrix.vecMulVec v (Matrix.vecMul v J)))).map
                  (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).det ≠ 0 := by
              intro δ' hδ' h0
              apply hjB
              rw [Set.mem_iUnion₂]
              rw [hΦst] at h0
              exact ⟨δ', hδ', h0⟩
            have hlt := hv _ hc0
            rw [← hΦst, hn] at hlt
            exact ihn _ hlt _ hs'J hs'1 hs'P rfl
          · refine ⟨s, hsJ, hs1, fun δ' hδ' => ?_⟩
            rcases Finset.mem_insert.mp hδ' with h | h
            · rw [h]; exact hd
            · exact hsP δ' h
      exact R _ s₀ hs₀J hs₀1 hs₀P rfl
  obtain ⟨s, hsJ, hs1, hsΔ⟩ := hQ Δ
  exact ⟨s, hsJ, hs1, fun δ hδ => by rw [hBR]; exact hsΔ δ hδ⟩

theorem wc_charpoly_power_avoid_stable (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (h₀ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) :
    (∀ a b, ‖h₀ a b‖ ≤ 1) → ‖h₀.det‖ = 1 →
      ∀ δ : AlgebraicClosure ℚ_[ℓ], Polynomial.aeval δ h₀.charpoly ≠ 0 →
        ∃ N t : ℕ, 1 ≤ N ∧ ∀ d : ℕ, 1 ≤ d → N ∣ d - 1 →
          ∀ g : Matrix (Fin r) (Fin r) ℚ_[ℓ],
            (∀ a b, ‖g a b - h₀ a b‖ ≤ (ℓ : ℝ) ^ (-(t : ℤ))) →
            Polynomial.aeval (δ ^ d) g.charpoly ≠ 0 :=
by

  have t_s4a : ∀ (P : Polynomial ℚ_[ℓ]) (z : AlgebraicClosure ℚ_[ℓ]), ‖z‖ ≤ 1 →
      ∀ c : ℝ, 0 ≤ c → (∀ i, ‖P.coeff i‖ ≤ c) → ‖Polynomial.aeval z P‖ ≤ c := by
    intro P z hz c hc hP
    rw [Polynomial.aeval_eq_sum_range]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg hc
    intro i _
    rw [Algebra.smul_def, norm_mul, norm_pow, PadicAlgCl.norm_extends]
    calc ‖P.coeff i‖ * ‖z‖ ^ i ≤ c * 1 :=
          mul_le_mul (hP i) (pow_le_one₀ (norm_nonneg _) hz) (by positivity) hc
      _ = c := mul_one c

  have t_s4b : ∀ (P : Polynomial ℚ_[ℓ]) (z w : AlgebraicClosure ℚ_[ℓ]), ‖z‖ ≤ 1 → ‖w‖ ≤ 1 →
      (∀ i, ‖P.coeff i‖ ≤ 1) →
      ‖Polynomial.aeval z P - Polynomial.aeval w P‖ ≤ ‖z - w‖ := by
    intro P z w hz hw hP
    rw [Polynomial.aeval_eq_sum_range, Polynomial.aeval_eq_sum_range, ← Finset.sum_sub_distrib]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (norm_nonneg _)
    intro i _
    rw [← smul_sub, Algebra.smul_def, norm_mul, PadicAlgCl.norm_extends, ← geom_sum₂_mul,
      norm_mul]
    have h1 : ‖∑ j ∈ Finset.range i, z ^ j * w ^ (i - 1 - j)‖ ≤ 1 := by
      apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg zero_le_one
      intro j _
      rw [norm_mul, norm_pow, norm_pow]
      calc ‖z‖ ^ j * ‖w‖ ^ (i - 1 - j) ≤ 1 * 1 :=
            mul_le_mul (pow_le_one₀ (norm_nonneg _) hz) (pow_le_one₀ (norm_nonneg _) hw)
              (by positivity) zero_le_one
        _ = 1 := one_mul 1
    calc ‖P.coeff i‖ * (‖∑ j ∈ Finset.range i, z ^ j * w ^ (i - 1 - j)‖ * ‖z - w‖)
          ≤ 1 * (1 * ‖z - w‖) :=
            mul_le_mul (hP i) (mul_le_mul_of_nonneg_right h1 (norm_nonneg _)) (by positivity)
              zero_le_one
      _ = ‖z - w‖ := by ring

  have t_s1 : ∀ (P : Polynomial ℚ_[ℓ]), P.Monic → (∀ i, ‖P.coeff i‖ ≤ 1) → ‖P.coeff 0‖ = 1 →
      ∀ z : AlgebraicClosure ℚ_[ℓ], Polynomial.aeval z P = 0 → ‖z‖ = 1 := by
    intro P hm hP h0 z hz
    obtain ⟨n, hn⟩ : ∃ n, P.natDegree = n := ⟨_, rfl⟩
    have hexp := Polynomial.aeval_eq_sum_range (p := P) z
    rw [hn] at hexp
    rcases Nat.eq_zero_or_pos n with hn0 | hnpos
    · exfalso
      rw [hn0, Finset.sum_range_one, pow_zero, Algebra.smul_def, mul_one] at hexp
      have h1 : ‖Polynomial.aeval z P‖ = 1 := by rw [hexp, PadicAlgCl.norm_extends, h0]
      rw [hz, norm_zero] at h1
      exact zero_ne_one h1
    by_contra hne
    rcases lt_or_gt_of_ne hne with hlt | hgt
    · rw [Finset.sum_range_succ'] at hexp
      have hS : ‖∑ i ∈ Finset.range n, P.coeff (i + 1) • z ^ (i + 1)‖ ≤ ‖z‖ := by
        apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (norm_nonneg _)
        intro i _
        rw [Algebra.smul_def, norm_mul, norm_pow, PadicAlgCl.norm_extends]
        calc ‖P.coeff (i + 1)‖ * ‖z‖ ^ (i + 1) ≤ 1 * ‖z‖ :=
              mul_le_mul (hP _) (pow_le_of_le_one (norm_nonneg _) hlt.le (by omega))
                (by positivity) zero_le_one
          _ = ‖z‖ := one_mul _
      have hc0 : ‖P.coeff 0 • z ^ 0‖ = 1 := by
        rw [pow_zero, Algebra.smul_def, mul_one, PadicAlgCl.norm_extends, h0]
      have hne' : ‖∑ i ∈ Finset.range n, P.coeff (i + 1) • z ^ (i + 1)‖ ≠
          ‖P.coeff 0 • z ^ 0‖ := by
        rw [hc0]; exact (hS.trans_lt hlt).ne
      have h2 := IsUltrametricDist.norm_add_eq_max_of_norm_ne_norm hne'
      rw [← hexp, hz, norm_zero, hc0] at h2
      exact (lt_max_of_lt_right one_pos).ne h2
    · rw [Finset.sum_range_succ] at hexp
      have hlead : P.coeff n = 1 := by rw [← hn]; exact hm.coeff_natDegree
      have hS : ‖∑ i ∈ Finset.range n, P.coeff i • z ^ i‖ ≤ ‖z‖ ^ (n - 1) := by
        apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (by positivity)
        intro i hi
        rw [Finset.mem_range] at hi
        rw [Algebra.smul_def, norm_mul, norm_pow, PadicAlgCl.norm_extends]
        calc ‖P.coeff i‖ * ‖z‖ ^ i ≤ 1 * ‖z‖ ^ (n - 1) :=
              mul_le_mul (hP _) (pow_le_pow_right₀ hgt.le (by omega)) (by positivity)
                zero_le_one
          _ = ‖z‖ ^ (n - 1) := one_mul _
      have htop : ‖P.coeff n • z ^ n‖ = ‖z‖ ^ n := by
        rw [hlead, one_smul, norm_pow]
      have hlt' : ‖z‖ ^ (n - 1) < ‖z‖ ^ n := pow_lt_pow_right₀ hgt (by omega)
      have hne' : ‖∑ i ∈ Finset.range n, P.coeff i • z ^ i‖ ≠ ‖P.coeff n • z ^ n‖ := by
        rw [htop]; exact (hS.trans_lt hlt').ne
      have h2 := IsUltrametricDist.norm_add_eq_max_of_norm_ne_norm hne'
      rw [← hexp, hz, norm_zero, htop] at h2
      exact (lt_max_of_lt_right (pow_pos (by linarith) n)).ne h2

  have t_s2 : ∀ (t : ℕ) (X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      (∀ a b, ‖X a b‖ ≤ 1) → (∀ a b, ‖Y a b‖ ≤ 1) →
      (∀ a b, ‖X a b - Y a b‖ ≤ (ℓ : ℝ) ^ (-(t : ℤ))) →
      (∀ i, ‖X.charpoly.coeff i‖ ≤ 1) ∧
        ∀ i, ‖X.charpoly.coeff i - Y.charpoly.coeff i‖ ≤ (ℓ : ℝ) ^ (-(t : ℤ)) := by
    intro t X Y hX hY hXY
    let X' : Matrix (Fin r) (Fin r) ℤ_[ℓ] := fun a b => ⟨X a b, hX a b⟩
    let Y' : Matrix (Fin r) (Fin r) ℤ_[ℓ] := fun a b => ⟨Y a b, hY a b⟩
    have hXm : X = X'.map PadicInt.Coe.ringHom := by ext a b; rfl
    have hYm : Y = Y'.map PadicInt.Coe.ringHom := by ext a b; rfl
    have hcX : ∀ i, X.charpoly.coeff i = ((X'.charpoly.coeff i : ℤ_[ℓ]) : ℚ_[ℓ]) := by
      intro i; rw [hXm, Matrix.charpoly_map, Polynomial.coeff_map]; try rfl
    have hcY : ∀ i, Y.charpoly.coeff i = ((Y'.charpoly.coeff i : ℤ_[ℓ]) : ℚ_[ℓ]) := by
      intro i; rw [hYm, Matrix.charpoly_map, Polynomial.coeff_map]; try rfl
    refine ⟨fun i => ?_, fun i => ?_⟩
    · rw [hcX, ← PadicInt.norm_def]; exact PadicInt.norm_le_one _
    · have hmat : X'.map (PadicInt.toZModPow t) = Y'.map (PadicInt.toZModPow t) := by
        ext a b
        simp only [Matrix.map_apply]
        rw [← sub_eq_zero, ← map_sub, ← RingHom.mem_ker, PadicInt.ker_toZModPow,
          ← PadicInt.norm_le_pow_iff_mem_span_pow, PadicInt.norm_def, PadicInt.coe_sub]
        exact hXY a b
      have hc := congrArg (fun p => p.coeff i) (congrArg Matrix.charpoly hmat)
      simp only [Matrix.charpoly_map, Polynomial.coeff_map] at hc
      rw [hcX, hcY, ← PadicInt.coe_sub, ← PadicInt.norm_def,
        PadicInt.norm_le_pow_iff_mem_span_pow, ← PadicInt.ker_toZModPow, RingHom.mem_ker,
        map_sub, hc, sub_self]

  have t_s3 : ∀ δ : AlgebraicClosure ℚ_[ℓ], ‖δ‖ = 1 → ∀ s : ℕ,
      ∃ N : ℕ, 1 ≤ N ∧ ∀ k : ℕ, ‖δ ^ (N * k) - 1‖ ≤ (ℓ : ℝ) ^ (-(s : ℤ)) := by
    classical
    intro δ hδ s
    have hint : IsIntegral ℚ_[ℓ] δ := Algebra.IsIntegral.isIntegral δ
    have hpm : (minpoly ℚ_[ℓ] δ).Monic := minpoly.monic hint
    have hsv : spectralValue (minpoly ℚ_[ℓ] δ) ≤ 1 := by
      have h : ‖δ‖ = spectralValue (minpoly ℚ_[ℓ] δ) :=
        (PadicAlgCl.spectralNorm_eq ℓ δ).symm.trans rfl
      rw [← h, hδ]
    have hcoef : ∀ n, ‖(minpoly ℚ_[ℓ] δ).coeff n‖ ≤ 1 :=
      (spectralValue_le_one_iff hpm).mp hsv
    have hlift : minpoly ℚ_[ℓ] δ ∈ Polynomial.lifts (PadicInt.Coe.ringHom (p := ℓ)) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      exact ⟨⟨(minpoly ℚ_[ℓ] δ).coeff n, hcoef n⟩, rfl⟩
    obtain ⟨q, hqmap, hqdeg, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hpm
    let φ : ℤ_[ℓ] →+* AlgebraicClosure ℚ_[ℓ] :=
      (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])).comp PadicInt.Coe.ringHom
    have hφn : ∀ x : ℤ_[ℓ], ‖φ x‖ = ‖x‖ := by
      intro x
      show ‖algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) (x : ℚ_[ℓ])‖ = ‖x‖
      rw [PadicAlgCl.norm_extends, PadicInt.norm_def]
    have hq0 : Polynomial.eval₂ φ δ q = 0 := by
      have h := Polynomial.eval₂_map (p := q) (PadicInt.Coe.ringHom (p := ℓ))
        (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])) δ
      rw [hqmap, ← Polynomial.aeval_def, minpoly.aeval] at h
      exact h.symm
    obtain ⟨D, hD⟩ : ∃ D, q.natDegree = D := ⟨_, rfl⟩
    have hDpos : 0 < D := by rw [← hD, hqdeg]; exact minpoly.natDegree_pos hint
    have hq1 : q ≠ 1 := by
      intro h; rw [h, Polynomial.natDegree_one] at hD; omega
    have hrep : ∀ n : ℕ, δ ^ n =
        ∑ i ∈ Finset.range D, φ (((Polynomial.X ^ n) %ₘ q).coeff i) * δ ^ i := by
      intro n
      have h1 := Polynomial.modByMonic_add_div (Polynomial.X ^ n) q
      have h2 : Polynomial.eval₂ φ δ (Polynomial.X ^ n) =
          Polynomial.eval₂ φ δ ((Polynomial.X ^ n) %ₘ q) := by
        conv_lhs => rw [← h1]
        rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, hq0, zero_mul, add_zero]
      rw [Polynomial.eval₂_X_pow] at h2
      have hlt := Polynomial.natDegree_modByMonic_lt (Polynomial.X ^ n) hqm hq1
      rw [hD] at hlt
      rw [h2, Polynomial.eval₂_eq_sum_range' φ hlt]
    let F : ℕ → (Fin D → ZMod (ℓ ^ s)) := fun n i =>
      PadicInt.toZModPow s (((Polynomial.X ^ n) %ₘ q).coeff i)
    have key : ∀ a b : ℕ, F a = F b → ‖δ ^ b - δ ^ a‖ ≤ (ℓ : ℝ) ^ (-(s : ℤ)) := by
      intro a b hab
      rw [hrep a, hrep b, ← Finset.sum_sub_distrib]
      apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (by positivity)
      intro i hi
      rw [Finset.mem_range] at hi
      have hi' := congrFun hab ⟨i, hi⟩
      simp only [F] at hi'
      rw [← sub_mul, ← map_sub, norm_mul, norm_pow, hδ, one_pow, mul_one, hφn,
        PadicInt.norm_le_pow_iff_mem_span_pow, ← PadicInt.ker_toZModPow, RingHom.mem_ker,
        map_sub, hi', sub_self]
    obtain ⟨x, y, hxy, hFxy⟩ := Finite.exists_ne_map_eq_of_infinite F
    obtain ⟨a, b, hab, hFab⟩ : ∃ a b, a < b ∧ F a = F b := by
      rcases lt_or_gt_of_ne hxy with h | h
      · exact ⟨x, y, h, hFxy⟩
      · exact ⟨y, x, h, hFxy.symm⟩
    refine ⟨b - a, by omega, ?_⟩
    have hδa : ‖δ ^ a‖ = 1 := by rw [norm_pow, hδ, one_pow]
    have hN : ‖δ ^ (b - a) - 1‖ ≤ (ℓ : ℝ) ^ (-(s : ℤ)) := by
      have h := key a b hFab
      have e : δ ^ b - δ ^ a = δ ^ a * (δ ^ (b - a) - 1) := by
        rw [mul_sub, mul_one, ← pow_add, Nat.add_sub_cancel' hab.le]
      rw [e, norm_mul, hδa, one_mul] at h
      exact h
    intro k
    rw [pow_mul, ← geom_sum_mul, norm_mul]
    have hg : ‖∑ j ∈ Finset.range k, (δ ^ (b - a)) ^ j‖ ≤ 1 := by
      apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg zero_le_one
      intro j _
      rw [norm_pow, norm_pow, hδ, one_pow, one_pow]
    calc _ ≤ 1 * (ℓ : ℝ) ^ (-(s : ℤ)) := mul_le_mul hg hN (norm_nonneg _) zero_le_one
      _ = _ := one_mul _

  intro hint hdet δ hδ
  have hℓ1 : (1 : ℝ) < ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt
  have hεt : ∀ t : ℕ, 1 ≤ t → (ℓ : ℝ) ^ (-(t : ℤ)) < 1 :=
    fun t ht => zpow_lt_one_of_neg₀ hℓ1 (by omega)
  have hεpos : ∀ t : ℕ, 0 < (ℓ : ℝ) ^ (-(t : ℤ)) := fun t => zpow_pos (by linarith) _
  have hc0 : ∀ M : Matrix (Fin r) (Fin r) ℚ_[ℓ], ‖M.charpoly.coeff 0‖ = ‖M.det‖ := by
    intro M
    rw [Matrix.det_eq_sign_charpoly_coeff, norm_mul, norm_pow, norm_neg, norm_one, one_pow,
      one_mul]
  have hG : ∀ t : ℕ, 1 ≤ t → ∀ g : Matrix (Fin r) (Fin r) ℚ_[ℓ],
      (∀ a b, ‖g a b - h₀ a b‖ ≤ (ℓ : ℝ) ^ (-(t : ℤ))) →
      (∀ i, ‖g.charpoly.coeff i‖ ≤ 1) ∧
        (∀ i, ‖g.charpoly.coeff i - h₀.charpoly.coeff i‖ ≤ (ℓ : ℝ) ^ (-(t : ℤ))) ∧
        ‖g.charpoly.coeff 0‖ = 1 := by
    intro t ht g hg
    have gint : ∀ a b, ‖g a b‖ ≤ 1 := by
      intro a b
      have e : g a b = (g a b - h₀ a b) + h₀ a b := by ring
      rw [e]
      exact (IsUltrametricDist.norm_add_le_max _ _).trans
        (max_le ((hg a b).trans (hεt t ht).le) (hint a b))
    obtain ⟨h1, h2⟩ := t_s2 t g h₀ gint hint hg
    refine ⟨h1, h2, ?_⟩
    have h00 : ‖h₀.charpoly.coeff 0‖ = 1 := by rw [hc0, hdet]
    have e : g.charpoly.coeff 0 =
        (g.charpoly.coeff 0 - h₀.charpoly.coeff 0) + h₀.charpoly.coeff 0 := by ring
    have hne : ‖g.charpoly.coeff 0 - h₀.charpoly.coeff 0‖ ≠ ‖h₀.charpoly.coeff 0‖ := by
      rw [h00]; exact ((h2 0).trans_lt (hεt t ht)).ne
    rw [e, IsUltrametricDist.norm_add_eq_max_of_norm_ne_norm hne, h00]
    exact max_eq_right ((h2 0).trans (hεt t ht).le)
  have h0coef : ∀ i, ‖h₀.charpoly.coeff i‖ ≤ 1 :=
    (t_s2 0 h₀ h₀ hint hint (fun a b => by rw [sub_self, norm_zero]; exact (hεpos 0).le)).1
  by_cases hδ1 : ‖δ‖ = 1
  · have hεp : 0 < ‖Polynomial.aeval δ h₀.charpoly‖ := norm_pos_iff.mpr hδ
    obtain ⟨t₀, ht₀⟩ := pow_unbounded_of_one_lt (‖Polynomial.aeval δ h₀.charpoly‖⁻¹) hℓ1
    have hεtε : (ℓ : ℝ) ^ (-((t₀ + 1 : ℕ) : ℤ)) < ‖Polynomial.aeval δ h₀.charpoly‖ := by
      rw [zpow_neg, zpow_natCast]
      have h1 : (ℓ : ℝ) ^ t₀ ≤ (ℓ : ℝ) ^ (t₀ + 1) := pow_le_pow_right₀ hℓ1.le (by omega)
      rw [inv_lt_comm₀ (by positivity) hεp]
      linarith
    obtain ⟨N, hN1, hNk⟩ := t_s3 δ hδ1 (t₀ + 1)
    refine ⟨N, t₀ + 1, hN1, ?_⟩
    intro d hd hNd g hg
    obtain ⟨k, hk⟩ := hNd
    have hdk : d = N * k + 1 := by omega
    obtain ⟨_, hg2, _⟩ := hG (t₀ + 1) (by omega) g hg
    have hzn : ‖δ ^ d‖ = 1 := by rw [norm_pow, hδ1, one_pow]
    have hzδ : ‖δ ^ d - δ‖ < ‖Polynomial.aeval δ h₀.charpoly‖ := by
      have e : δ ^ d - δ = δ * (δ ^ (N * k) - 1) := by rw [hdk, pow_succ]; ring
      rw [e, norm_mul, hδ1, one_mul]
      exact (hNk k).trans_lt hεtε
    have hE1 : ‖Polynomial.aeval (δ ^ d) h₀.charpoly - Polynomial.aeval δ h₀.charpoly‖ <
        ‖Polynomial.aeval δ h₀.charpoly‖ :=
      (t_s4b _ (δ ^ d) δ hzn.le hδ1.le h0coef).trans_lt hzδ
    have hE2 : ‖Polynomial.aeval (δ ^ d) g.charpoly - Polynomial.aeval (δ ^ d) h₀.charpoly‖ <
        ‖Polynomial.aeval δ h₀.charpoly‖ := by
      rw [← Polynomial.aeval_sub]
      refine (t_s4a _ (δ ^ d) hzn.le ((ℓ : ℝ) ^ (-((t₀ + 1 : ℕ) : ℤ))) (hεpos _).le
        ?_).trans_lt hεtε
      intro i; rw [Polynomial.coeff_sub]; exact hg2 i
    have e : Polynomial.aeval (δ ^ d) g.charpoly =
        ((Polynomial.aeval (δ ^ d) g.charpoly - Polynomial.aeval (δ ^ d) h₀.charpoly) +
          (Polynomial.aeval (δ ^ d) h₀.charpoly - Polynomial.aeval δ h₀.charpoly)) +
          Polynomial.aeval δ h₀.charpoly := by ring
    have hsmall : ‖(Polynomial.aeval (δ ^ d) g.charpoly - Polynomial.aeval (δ ^ d) h₀.charpoly) +
          (Polynomial.aeval (δ ^ d) h₀.charpoly - Polynomial.aeval δ h₀.charpoly)‖ <
        ‖Polynomial.aeval δ h₀.charpoly‖ :=
      (IsUltrametricDist.norm_add_le_max _ _).trans_lt (max_lt hE2 hE1)
    intro h0
    have h3 := IsUltrametricDist.norm_add_eq_max_of_norm_ne_norm hsmall.ne
    rw [← e, h0, norm_zero] at h3
    exact (lt_max_of_lt_right hεp).ne h3
  · refine ⟨1, 1, le_rfl, ?_⟩
    intro d hd _ g hg h0
    obtain ⟨hg1, _, hg3⟩ := hG 1 le_rfl g hg
    have h1 := t_s1 g.charpoly (Matrix.charpoly_monic g) hg1 hg3 (δ ^ d) h0
    rw [norm_pow] at h1
    exact hδ1 ((pow_eq_one_iff_of_nonneg (norm_nonneg _) (by omega)).mp h1)

theorem wc_pencil_VQ_generic_avoidance_nm (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n) (hNM : wcPencilNoMixed D)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∀ Δ : Finset (AlgebraicClosure ℚ_[ℓ]), (0 : AlgebraicClosure ℚ_[ℓ]) ∉ Δ →
      ∀ N₀ : Finset ℕ, (∀ k ∈ N₀, 2 ≤ k) →
        ∃ d : ℕ, 1 ≤ d ∧ (∀ k ∈ N₀, ¬ k ∣ d) ∧ ∃ x ∈ wcP1ClosedPt F'' d,
          (∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) ∧
          ∀ δ ∈ Δ, δ ^ d ∉ wcPencilLoc D ℓ hP x d :=
by
  classical
  intro Δ _hΔ N₀ hN₀
  obtain ⟨r, m₀, J, Φ, hJ, hJdet, hΦint, hΦdet, hcheb⟩ :=
    wc_pencil_VQ_chebotarev_datum_nm F' F'' Y n hn hn2 D hNM ℓ hℓ hP hNI
  have hℓ1 : (1 : ℝ) ≤ (ℓ : ℝ) := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt.le
  have hΦu : IsUnit Φ.det := by
    rw [isUnit_iff_ne_zero]
    intro h0
    rw [h0, norm_zero] at hΦdet
    exact zero_ne_one hΦdet
  obtain ⟨s, hsJ, hs1, havoid⟩ :=
    wc_symplectic_perturb_avoid_eigen ℓ r m₀ J Φ hJ hJdet hΦu Δ

  have hsint : ∀ a b, ‖s a b‖ ≤ 1 := by
    intro a b
    have hpow : (ℓ : ℝ) ^ (-(m₀ : ℤ)) ≤ 1 := zpow_le_one_of_nonpos₀ hℓ1 (by omega)
    have h1 : ‖(1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1 := by
      by_cases hab : a = b
      · subst hab; simp
      · simp [Matrix.one_apply_ne hab]
    have e : s a b = (s a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b) +
        (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b := by ring
    rw [e]
    exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ((hs1 a b).trans hpow) h1)
  have hh0int : ∀ a b, ‖(Φ * s) a b‖ ≤ 1 := by
    intro a b
    rw [Matrix.mul_apply]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg zero_le_one
    intro c _
    rw [norm_mul]
    exact mul_le_one₀ (hΦint a c) (norm_nonneg _) (hsint c b)
  have hsdet : ‖s.det‖ = 1 := by
    have h := congrArg Matrix.det hsJ
    rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose] at h
    have hJ0 : J.det ≠ 0 := hJdet.ne_zero
    have h2 : s.det * s.det = 1 := by
      have h' : s.det * s.det * J.det = 1 * J.det := by linear_combination h
      exact mul_right_cancel₀ hJ0 h'
    have h3 : ‖s.det‖ * ‖s.det‖ = 1 := by rw [← norm_mul, h2, norm_one]
    rcases mul_self_eq_one_iff.mp h3 with h4 | h4
    · exact h4
    · have := norm_nonneg s.det
      linarith
  have hh0det : ‖(Φ * s).det‖ = 1 := by
    rw [Matrix.det_mul, norm_mul, hΦdet, hsdet, one_mul]

  have hper : ∀ δ : Δ, ∃ N t : ℕ, 1 ≤ N ∧ ∀ d : ℕ, 1 ≤ d → N ∣ d - 1 →
      ∀ g : Matrix (Fin r) (Fin r) ℚ_[ℓ],
        (∀ a b, ‖g a b - (Φ * s) a b‖ ≤ (ℓ : ℝ) ^ (-(t : ℤ))) →
        Polynomial.aeval ((δ : AlgebraicClosure ℚ_[ℓ]) ^ d) g.charpoly ≠ 0 :=
    fun δ => wc_charpoly_power_avoid_stable ℓ r (Φ * s) hh0int hh0det δ (havoid δ δ.2)
  choose Nf tf hNf hstab using hper
  have hN1 : 1 ≤ (∏ δ : Δ, Nf δ) * ∏ k ∈ N₀, k := by
    have h1 : 0 < ∏ δ : Δ, Nf δ := Finset.prod_pos (fun δ _ => hNf δ)
    have h2 : 0 < ∏ k ∈ N₀, k := Finset.prod_pos (fun k hk => by have := hN₀ k hk; omega)
    exact Nat.mul_pos h1 h2

  obtain ⟨d, hd, hNd, x, hx, hxS, hloc⟩ :=
    hcheb s hsJ hs1 ((∏ δ : Δ, Nf δ) * ∏ k ∈ N₀, k) (∑ δ : Δ, tf δ) hN1
  refine ⟨d, hd, ?_, x, hx, hxS, ?_⟩
  ·
    intro k hk hkd
    have hk1 : k ∣ d - 1 :=
      ((Finset.dvd_prod_of_mem (fun k : ℕ => k) hk).trans (dvd_mul_left _ _)).trans hNd
    have hk2 : k ∣ 1 := by
      have e : d = (d - 1) + 1 := by omega
      rw [e] at hkd
      first
        | exact (Nat.dvd_add_right hk1).mp hkd
        | exact (Nat.dvd_add_iff_right hk1).mpr hkd
        | exact (dvd_add_right_iff.mp hkd : k ∣ 1)
        | exact (Nat.dvd_add_right_iff_of_dvd hk1).mp hkd
    have h3 := Nat.le_of_dvd one_pos hk2
    have h4 := hN₀ k hk
    omega
  ·
    intro δ hδ hmem
    rcases hloc with h0 | ⟨g, hg, hgloc⟩
    · rw [h0] at hmem
      exact Multiset.notMem_zero _ hmem
    · have hNδ : Nf ⟨δ, hδ⟩ ∣ d - 1 :=
        ((Finset.dvd_prod_of_mem Nf (Finset.mem_univ _)).trans (dvd_mul_right _ _)).trans hNd
      have htle : tf ⟨δ, hδ⟩ ≤ ∑ δ : Δ, tf δ :=
        Finset.single_le_sum (f := tf) (fun _ _ => Nat.zero_le _) (Finset.mem_univ _)
      have hg' : ∀ a b, ‖g a b - (Φ * s) a b‖ ≤ (ℓ : ℝ) ^ (-((tf ⟨δ, hδ⟩ : ℕ) : ℤ)) := by
        intro a b
        refine (hg a b).trans ?_
        exact zpow_le_zpow_right₀ hℓ1 (by omega)
      apply hstab ⟨δ, hδ⟩ d hd hNδ g hg'
      rw [hgloc] at hmem
      exact (Polynomial.mem_aroots'.mp hmem).2

theorem wc_vps_rational_powersum_algebraic : ∀ {K : Type*} [Field K] [CharZero K] (T : Finset K)
    (m : K → ℤ), (0 : K) ∉ T →
    (∀ j : ℕ, 1 ≤ j → ∃ c : ℚ, ∑ y ∈ T, (m y : K) * y ^ j = algebraMap ℚ K c) →
    ∀ β ∈ T, m β ≠ 0 → IsAlgebraic ℚ β :=
by
  classical
  intro K _ _ T m h0 hrat β hβ hm

  have s1 : ∀ (T : Finset K) (c : K → K), (0 : K) ∉ T →
      (∀ r : ℕ, 1 ≤ r → r ≤ T.card → ∑ y ∈ T, c y * y ^ r = 0) → ∀ y ∈ T, c y = 0 := by
    intro T
    induction T using Finset.induction_on with
    | empty => intro c _ _ y hy; simp at hy
    | insert a T' haT ih =>
      intro c h0 H
      have ha0 : a ≠ 0 := fun h => h0 (by rw [← h]; exact Finset.mem_insert_self a T')
      have h0' : (0 : K) ∉ T' := fun h => h0 (Finset.mem_insert_of_mem h)
      have hcard : (insert a T').card = T'.card + 1 := Finset.card_insert_of_notMem haT
      have H' : ∀ n : ℕ, 1 ≤ n → n ≤ T'.card + 1 →
          c a * a ^ n + ∑ y ∈ T', c y * y ^ n = 0 := by
        intro n hn hn'
        have := H n hn (by rw [hcard]; exact hn')
        rwa [Finset.sum_insert haT] at this
      have hc' : ∀ y ∈ T', c y * (y - a) = 0 := by
        apply ih (fun y => c y * (y - a)) h0'
        intro n hn hn'
        have e1 := H' (n + 1) (by omega) (by omega)
        have e2 := H' n hn (by omega)
        have key : ∑ y ∈ T', c y * (y - a) * y ^ n
            = (c a * a ^ (n + 1) + ∑ y ∈ T', c y * y ^ (n + 1))
              - a * (c a * a ^ n + ∑ y ∈ T', c y * y ^ n) := by
          rw [mul_add, Finset.mul_sum]
          have : ∑ y ∈ T', c y * (y - a) * y ^ n
              = ∑ y ∈ T', (c y * y ^ (n + 1) - a * (c y * y ^ n)) := by
            apply Finset.sum_congr rfl
            intro y _
            ring
          rw [this, Finset.sum_sub_distrib]
          ring
        show ∑ y ∈ T', c y * (y - a) * y ^ n = 0
        rw [key, e1, e2]
        ring
      have hcT : ∀ y ∈ T', c y = 0 := by
        intro y hy
        have hne : y - a ≠ 0 := sub_ne_zero.mpr (fun h => haT (by rw [← h]; exact hy))
        exact (mul_eq_zero.mp (hc' y hy)).resolve_right hne
      have e1 := H' 1 le_rfl (by omega)
      rw [Finset.sum_eq_zero (fun y hy => by rw [hcT y hy, zero_mul]), add_zero, pow_one] at e1
      have hca : c a = 0 := (mul_eq_zero.mp e1).resolve_right ha0
      intro y hy
      rcases Finset.mem_insert.mp hy with h | h
      · rw [h]; exact hca
      · exact hcT y h

  let s : ℕ → ℚ := fun j => if h : 1 ≤ j then Classical.choose (hrat j h) else 0
  have hs : ∀ j, 1 ≤ j → ∑ y ∈ T, (m y : K) * y ^ j = algebraMap ℚ K (s j) := by
    intro j hj
    simp only [s, dif_pos hj]
    exact Classical.choose_spec (hrat j hj)

  let v : Fin (T.card + 1) → (Fin T.card → ℚ) := fun i r => s ((i : ℕ) + (r : ℕ) + 1)
  have hnli : ¬ LinearIndependent ℚ v := by
    intro hli
    have := hli.fintype_card_le_finrank
    rw [Fintype.card_fin, Module.finrank_fin_fun] at this
    omega
  obtain ⟨g, hgsum, i₀, hi₀⟩ := Fintype.not_linearIndependent_iff.mp hnli
  have hker : ∀ r : Fin T.card, ∑ i : Fin (T.card + 1), g i * s ((i : ℕ) + (r : ℕ) + 1) = 0 := by
    intro r
    have := congrFun hgsum r
    simpa [v, Finset.sum_apply] using this

  let G : Polynomial ℚ := ∑ i : Fin (T.card + 1), Polynomial.C (g i) * Polynomial.X ^ (i : ℕ)
  have hG0 : G ≠ 0 := by
    intro hG
    have hc : G.coeff (i₀ : ℕ) = g i₀ := by
      simp only [G, Polynomial.finset_sum_coeff, Polynomial.coeff_C_mul_X_pow]
      rw [Finset.sum_eq_single i₀]
      · simp
      · intro b _ hb
        rw [if_neg]
        intro h
        exact hb (Fin.ext h.symm)
      · intro h; exact absurd (Finset.mem_univ i₀) h
    rw [hG, Polynomial.coeff_zero] at hc
    exact hi₀ hc.symm
  have hev : ∀ y : K, Polynomial.aeval y G =
      ∑ i : Fin (T.card + 1), algebraMap ℚ K (g i) * y ^ (i : ℕ) := by
    intro y
    simp only [G, map_sum, map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X]

  have hd : ∀ ρ : ℕ, 1 ≤ ρ → ρ ≤ T.card →
      ∑ y ∈ T, ((m y : K) * Polynomial.aeval y G) * y ^ ρ = 0 := by
    intro ρ hρ1 hρt
    have hr : ρ - 1 < T.card := by omega
    have e1 : ∑ y ∈ T, ((m y : K) * Polynomial.aeval y G) * y ^ ρ
        = ∑ i : Fin (T.card + 1), algebraMap ℚ K (g i) *
            ∑ y ∈ T, (m y : K) * y ^ ((i : ℕ) + ρ) := by
      simp only [hev, Finset.mul_sum, Finset.sum_mul]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun y _ => ?_))
      rw [pow_add]; ring
    rw [e1]
    have e2 : ∀ i : Fin (T.card + 1), ∑ y ∈ T, (m y : K) * y ^ ((i : ℕ) + ρ) =
        algebraMap ℚ K (s ((i : ℕ) + ((⟨ρ - 1, hr⟩ : Fin T.card) : ℕ) + 1)) := by
      intro i
      have : (i : ℕ) + ρ = (i : ℕ) + (ρ - 1) + 1 := by omega
      rw [this]
      exact hs _ (by omega)
    simp only [e2, ← map_mul, ← map_sum]
    rw [hker ⟨ρ - 1, hr⟩, map_zero]
  have hc := s1 T (fun y => (m y : K) * Polynomial.aeval y G) h0 hd β hβ
  have hm' : (m β : K) ≠ 0 := Int.cast_ne_zero.mpr hm
  exact ⟨G, hG0, (mul_eq_zero.mp hc).resolve_left hm'⟩

theorem wc_vps_conj_invariant : ∀ {K : Type*} [Field K] [IsAlgClosed K] [CharZero K] (T : Finset K)
    (m : K → ℤ), (0 : K) ∉ T →
    (∀ j : ℕ, 1 ≤ j → ∃ c : ℚ, ∑ y ∈ T, (m y : K) * y ^ j = algebraMap ℚ K c) →
    (∀ γ ∈ T, m γ ≠ 0 → IsAlgebraic ℚ γ) →
    ∀ β ∈ T, m β ≠ 0 → ∀ β' ∈ T, Polynomial.aeval β' (minpoly ℚ β) = 0 → m β' = m β :=
by
  intro K _ _ _ T m h0 hrat halgT β hβT hmβ β' hβ'T hroot
  classical
  set L := algebraicClosure ℚ K with hLdef

  have s1 : ∀ (U : Finset L) (c : L → L), (0 : L) ∉ U →
      (∀ n : ℕ, 1 ≤ n → ∑ x ∈ U, c x * x ^ n = 0) → ∀ x ∈ U, c x = 0 := by
    intro U
    induction U using Finset.induction_on with
    | empty => intro c _ _ x hx; simp at hx
    | insert a U' haU ih =>
      intro c h0 H
      have ha0 : a ≠ 0 := fun h => h0 (by rw [← h]; exact Finset.mem_insert_self a U')
      have h0' : (0 : L) ∉ U' := fun h => h0 (Finset.mem_insert_of_mem h)
      have H' : ∀ n : ℕ, 1 ≤ n → c a * a ^ n + ∑ x ∈ U', c x * x ^ n = 0 := by
        intro n hn
        have := H n hn
        rwa [Finset.sum_insert haU] at this
      have hc' : ∀ x ∈ U', c x * (x - a) = 0 := by
        apply ih (fun x => c x * (x - a)) h0'
        intro n hn
        have e1 := H' (n + 1) (by omega)
        have e2 := H' n hn
        have key : ∑ x ∈ U', c x * (x - a) * x ^ n
            = (c a * a ^ (n + 1) + ∑ x ∈ U', c x * x ^ (n + 1))
              - a * (c a * a ^ n + ∑ x ∈ U', c x * x ^ n) := by
          rw [mul_add, Finset.mul_sum]
          have : ∑ x ∈ U', c x * (x - a) * x ^ n
              = ∑ x ∈ U', (c x * x ^ (n + 1) - a * (c x * x ^ n)) := by
            apply Finset.sum_congr rfl
            intro x _
            ring
          rw [this, Finset.sum_sub_distrib]
          ring
        rw [key, e1, e2]
        ring
      have hcU : ∀ x ∈ U', c x = 0 := by
        intro x hx
        have hne : x - a ≠ 0 := sub_ne_zero.mpr (fun h => haU (by rw [← h]; exact hx))
        exact (mul_eq_zero.mp (hc' x hx)).resolve_right hne
      have e1 := H' 1 le_rfl
      rw [Finset.sum_eq_zero (fun x hx => by rw [hcU x hx, zero_mul]), add_zero, pow_one] at e1
      have hca : c a = 0 := (mul_eq_zero.mp e1).resolve_right ha0
      intro x hx
      rcases Finset.mem_insert.mp hx with h | h
      · rw [h]; exact hca
      · exact hcU x h

  have hβalg : IsAlgebraic ℚ β := halgT β hβT hmβ
  have hβ'alg : IsAlgebraic ℚ β' := ⟨minpoly ℚ β, minpoly.ne_zero hβalg.isIntegral, hroot⟩
  have hβL : β ∈ L := mem_algebraicClosure_iff.mpr hβalg
  have hβ'L : β' ∈ L := mem_algebraicClosure_iff.mpr hβ'alg
  set b : L := ⟨β, hβL⟩ with hb
  set b' : L := ⟨β', hβ'L⟩ with hb'
  have hbalg : IsAlgebraic ℚ b := IntermediateField.isAlgebraic_iff.mpr hβalg
  have hmin : minpoly ℚ b = minpoly ℚ β := IntermediateField.minpoly_eq b
  have hroot' : Polynomial.aeval b' (minpoly ℚ b) = 0 := by
    rw [hmin]
    apply Subtype.val_injective
    have := Polynomial.aeval_algHom_apply L.val b' (minpoly ℚ β)
    show L.val (Polynomial.aeval b' (minpoly ℚ β)) = L.val 0
    rw [← this, map_zero]
    exact hroot
  have : Normal ℚ L := inferInstance
  obtain ⟨τ, hτ⟩ := minpoly.exists_algEquiv_of_root' hbalg hroot'

  set T' : Finset L := T.subtype (· ∈ L) with hT'def
  have hT' : ∀ x : L, x ∈ T' ↔ (x : K) ∈ T := fun x => Finset.mem_subtype
  have hratL : ∀ j : ℕ, 1 ≤ j → ∃ q : ℚ,
      ∑ x ∈ T', ((m (x : K) : ℤ) : L) * x ^ j = algebraMap ℚ L q := by
    intro j hj
    obtain ⟨q, hq⟩ := hrat j hj
    refine ⟨q, ?_⟩
    apply Subtype.val_injective
    show L.val (∑ x ∈ T', ((m (x : K) : ℤ) : L) * x ^ j) = L.val (algebraMap ℚ L q)
    rw [AlgHom.commutes, ← hq, map_sum]
    simp only [map_mul, map_pow, map_intCast]
    show ∑ x ∈ T', ((m (x : K) : ℤ) : K) * (x : K) ^ j = ∑ y ∈ T, ((m y : ℤ) : K) * y ^ j
    have e := Finset.sum_subtype_eq_sum_filter (s := T) (p := (· ∈ L))
      (f := fun y : K => (m y : K) * y ^ j)
    refine e.trans ?_
    apply Finset.sum_filter_of_ne
    intro y hy hne
    by_contra hyL
    apply hne
    have hmy : m y = 0 := by
      by_contra h
      exact hyL (mem_algebraicClosure_iff.mpr (halgT y hy h))
    simp [hmy]
  have hinv : ∀ j : ℕ, 1 ≤ j → ∑ x ∈ T', ((m (x : K) : ℤ) : L) * τ x ^ j
      = ∑ x ∈ T', ((m (x : K) : ℤ) : L) * x ^ j := by
    intro j hj
    obtain ⟨q, hq⟩ := hratL j hj
    have := congrArg τ hq
    rw [map_sum, AlgEquiv.commutes] at this
    simp only [map_mul, map_pow, map_intCast] at this
    rw [this, hq]

  have h0T' : (0 : L) ∉ T' := by
    intro h
    exact h0 ((hT' 0).mp h)
  set U : Finset L := T' ∪ T'.image τ with hU
  have h0U : (0 : L) ∉ U := by
    intro h
    rcases Finset.mem_union.mp h with h | h
    · exact h0T' h
    · obtain ⟨x, hx, hx0⟩ := Finset.mem_image.mp h
      have : x = 0 := (map_eq_zero_iff τ τ.injective).mp hx0
      exact h0T' (this ▸ hx)
  set c : L → L := fun x => ((m (x : K) : ℤ) : L) with hc
  set d : L → L := fun δ => (if δ ∈ T'.image τ then c (τ.symm δ) else 0) -
      (if δ ∈ T' then c δ else 0) with hd
  have hdsum : ∀ n : ℕ, 1 ≤ n → ∑ δ ∈ U, d δ * δ ^ n = 0 := by
    intro n hn
    have e1 : ∑ δ ∈ U, d δ * δ ^ n =
        ∑ δ ∈ U, (if δ ∈ T'.image τ then c (τ.symm δ) * δ ^ n else 0) -
        ∑ δ ∈ U, (if δ ∈ T' then c δ * δ ^ n else 0) := by
      rw [← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro δ _
      simp only [hd, sub_mul, ite_mul, zero_mul]
    rw [e1, Finset.sum_ite_mem, Finset.sum_ite_mem, Finset.union_inter_cancel_right,
      Finset.union_inter_cancel_left, Finset.sum_image (fun x _ y _ h => τ.injective h)]
    simp only [AlgEquiv.symm_apply_apply]
    rw [sub_eq_zero]
    exact hinv n hn
  have hdzero := s1 U d h0U hdsum
  have hb'T' : b' ∈ T' := (hT' b').mpr hβ'T
  have hbT' : b ∈ T' := (hT' b).mpr hβT
  have hb'U : b' ∈ U := Finset.mem_union_left _ hb'T'
  have hb'img : b' ∈ T'.image τ := Finset.mem_image.mpr ⟨b, hbT', hτ⟩
  have key := hdzero b' hb'U
  have hsymm : τ.symm b' = b := by rw [← hτ, AlgEquiv.symm_apply_apply]
  simp only [hd, if_pos hb'img, if_pos hb'T', hsymm, sub_eq_zero] at key

  have key2 := congrArg L.val key
  simp only [hc, map_intCast] at key2
  exact_mod_cast key2.symm

theorem wc_vps_good_index : ∀ {K : Type*} [Field K] [CharZero K] [DecidableEq K] {ι : Type*}
    (deg : ι → ℕ) (P : ι → Multiset K) (A B : Multiset K), (∀ i, 1 ≤ deg i) →
    (∀ i (j : ℕ), 1 ≤ j → ∃ c : ℚ, ((P i).map (· ^ j)).sum + (A.map (· ^ (deg i * j))).sum -
      (B.map (· ^ (deg i * j))).sum = algebraMap ℚ K c) →
    (∀ Δ : Finset K, (0 : K) ∉ Δ → ∀ N₀ : Finset ℕ, (∀ k ∈ N₀, 2 ≤ k) →
      ∃ i, (∀ k ∈ N₀, ¬ k ∣ deg i) ∧ ∀ δ ∈ Δ, δ ^ deg i ∉ P i) →
    ∀ Ω : Finset K, (0 : K) ∉ Ω → (∀ a ∈ A, a ∈ Ω) → (∀ b ∈ B, b ∈ Ω) →
    ∃ n : ℕ, 1 ≤ n ∧ ∃ (T : Finset K) (m : K → ℤ), (0 : K) ∉ T ∧
      (∀ j : ℕ, 1 ≤ j → ∃ c : ℚ, ∑ y ∈ T, (m y : K) * y ^ j = algebraMap ℚ K c) ∧
      ∀ ω ∈ Ω, ω ^ n ∈ T ∧ m (ω ^ n) = (A.count ω : ℤ) - (B.count ω : ℤ) :=
by
  intro K _ _ _ ι deg P A B hdeg hH1 hH2 Ω h0 hA hB

  have s1 : ∀ (a b : K) (n : ℕ), b ≠ 0 → 1 ≤ n →
      (a ≠ b → 2 ≤ orderOf (a / b) → ¬ orderOf (a / b) ∣ n) → a ^ n = b ^ n → a = b := by
    intro a b n hb hn hord hab
    by_contra hne
    have h1 : (a / b) ^ n = 1 := by
      rw [div_pow, hab, div_self (pow_ne_zero n hb)]
    have hfin : IsOfFinOrder (a / b) := isOfFinOrder_iff_pow_eq_one.mpr ⟨n, by omega, h1⟩
    have hdvd : orderOf (a / b) ∣ n := orderOf_dvd_of_pow_eq_one h1
    have hpos : 0 < orderOf (a / b) := hfin.orderOf_pos
    have hne1 : orderOf (a / b) ≠ 1 := by
      intro h
      rw [orderOf_eq_one_iff] at h
      exact hne ((div_eq_one_iff_eq hb).mp h)
    exact hord hne (by omega) hdvd

  have s2 : ∀ (M : Multiset K) (T : Finset K) (j : ℕ), 1 ≤ j → (∀ y ∈ M, y ≠ 0 → y ∈ T) →
      (M.map (· ^ j)).sum = ∑ y ∈ T, (M.count y : K) * y ^ j := by
    intro M T j hj hMT
    rw [Finset.sum_multiset_map_count]
    simp only [nsmul_eq_mul]
    have e1 : ∑ y ∈ M.toFinset, (M.count y : K) * y ^ j =
        ∑ y ∈ M.toFinset ∪ T, (M.count y : K) * y ^ j :=
      Finset.sum_subset Finset.subset_union_left (fun y _ hy => by
        rw [Multiset.count_eq_zero.mpr (fun h => hy (Multiset.mem_toFinset.mpr h))]
        simp)
    have e2 : ∑ y ∈ T, (M.count y : K) * y ^ j =
        ∑ y ∈ M.toFinset ∪ T, (M.count y : K) * y ^ j := by
      apply Finset.sum_subset Finset.subset_union_right
      intro y hyU hyT
      have hyM : y ∈ M.toFinset := by
        rcases Finset.mem_union.mp hyU with h | h
        · exact h
        · exact absurd h hyT
      by_cases hy0 : y = 0
      · rw [hy0, zero_pow (by omega), mul_zero]
      · exact absurd (hMT y (Multiset.mem_toFinset.mp hyM) hy0) hyT
    rw [e1, e2]

  have s3 : ∀ (M : Multiset K) (n : ℕ), (∀ a ∈ M, a ∈ Ω) →
      (∀ a ∈ Ω, ∀ b ∈ Ω, a ^ n = b ^ n → a = b) → ∀ ω ∈ Ω,
      (M.map (· ^ n)).count (ω ^ n) = M.count ω := by
    intro M n hM hinj ω hω
    have hf : Multiset.filter (fun a => ω ^ n = a ^ n) M = Multiset.filter (fun a => ω = a) M :=
      Multiset.filter_congr (fun a ha => ⟨fun h => hinj ω hω a (hM a ha) h, fun h => by rw [h]⟩)
    rw [Multiset.count_map, Multiset.count_eq_card_filter_eq, ← hf]

  obtain ⟨N₀, hN₀def⟩ : ∃ N₀ : Finset ℕ, N₀ = (((Ω ×ˢ Ω).filter (fun p : K × K => p.1 ≠ p.2)).image
      (fun p => orderOf (p.1 / p.2))).filter (fun k => 2 ≤ k) := ⟨_, rfl⟩
  have hN₀ : ∀ k ∈ N₀, 2 ≤ k := fun k hk => by
    rw [hN₀def] at hk
    exact (Finset.mem_filter.mp hk).2
  have hmemN : ∀ a ∈ Ω, ∀ b ∈ Ω, a ≠ b → 2 ≤ orderOf (a / b) → orderOf (a / b) ∈ N₀ := by
    intro a ha b hb hab h2
    rw [hN₀def, Finset.mem_filter, Finset.mem_image]
    exact ⟨⟨(a, b), Finset.mem_filter.mpr ⟨Finset.mem_product.mpr ⟨ha, hb⟩, hab⟩, rfl⟩, h2⟩

  obtain ⟨i, hdiv, havoid⟩ := hH2 Ω h0 N₀ hN₀
  have hn : 1 ≤ deg i := hdeg i

  have hinj : ∀ a ∈ Ω, ∀ b ∈ Ω, a ^ deg i = b ^ deg i → a = b := by
    intro a ha b hb hab
    exact s1 a b (deg i) (fun h => h0 (h ▸ hb)) hn
      (fun hne h2 => hdiv _ (hmemN a ha b hb hne h2)) hab

  obtain ⟨T, hT⟩ : ∃ T : Finset K, T = ((P i).toFinset.filter (· ≠ 0)) ∪ Ω.image (· ^ deg i) :=
    ⟨_, rfl⟩
  obtain ⟨m, hm⟩ : ∃ m : K → ℤ, m = fun y => ((P i).count y : ℤ) +
      ((A.map (· ^ deg i)).count y : ℤ) - ((B.map (· ^ deg i)).count y : ℤ) := ⟨_, rfl⟩
  have hΩT : ∀ ω ∈ Ω, ω ^ deg i ∈ T := fun ω hω => by
    rw [hT]
    exact Finset.mem_union_right _ (Finset.mem_image_of_mem _ hω)
  refine ⟨deg i, hn, T, m, ?_, ?_, ?_⟩
  ·
    intro h
    rw [hT] at h
    rcases Finset.mem_union.mp h with h | h
    · exact (Finset.mem_filter.mp h).2 rfl
    · obtain ⟨ω, hω, hω0⟩ := Finset.mem_image.mp h
      have : ω = 0 := (pow_eq_zero_iff (by omega)).mp hω0
      exact h0 (this ▸ hω)
  ·
    intro j hj
    obtain ⟨c, hc⟩ := hH1 i j hj
    refine ⟨c, ?_⟩
    rw [← hc]
    have hPT : ∀ y ∈ P i, y ≠ 0 → y ∈ T := fun y hy hy0 => by
      rw [hT]
      exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨Multiset.mem_toFinset.mpr hy, hy0⟩)
    have hAT : ∀ y ∈ A.map (· ^ deg i), y ≠ 0 → y ∈ T := fun y hy _ => by
      obtain ⟨a, ha, rfl⟩ := Multiset.mem_map.mp hy
      exact hΩT a (hA a ha)
    have hBT : ∀ y ∈ B.map (· ^ deg i), y ≠ 0 → y ∈ T := fun y hy _ => by
      obtain ⟨a, ha, rfl⟩ := Multiset.mem_map.mp hy
      exact hΩT a (hB a ha)
    have hAmap : (A.map (· ^ (deg i * j))).sum = ((A.map (· ^ deg i)).map (· ^ j)).sum := by
      rw [Multiset.map_map]
      congr 1
      exact Multiset.map_congr rfl (fun a _ => by simp [pow_mul])
    have hBmap : (B.map (· ^ (deg i * j))).sum = ((B.map (· ^ deg i)).map (· ^ j)).sum := by
      rw [Multiset.map_map]
      congr 1
      exact Multiset.map_congr rfl (fun a _ => by simp [pow_mul])
    rw [hAmap, hBmap, s2 (P i) T j hj hPT, s2 _ T j hj hAT, s2 _ T j hj hBT,
      ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro y _
    rw [hm]
    push_cast
    ring
  ·
    intro ω hω
    refine ⟨hΩT ω hω, ?_⟩
    rw [hm]
    show ((P i).count (ω ^ deg i) : ℤ) + ((A.map (· ^ deg i)).count (ω ^ deg i) : ℤ) -
      ((B.map (· ^ deg i)).count (ω ^ deg i) : ℤ) = _
    rw [Multiset.count_eq_zero.mpr (havoid ω hω), s3 A (deg i) hA hinj ω hω,
      s3 B (deg i) hB hinj ω hω]
    simp

theorem wc_vps_conj_stable_rational : ∀ {K : Type*} [Field K] [IsAlgClosed K] [CharZero K]
    [DecidableEq K] (A B : Multiset K),
    (∀ ω : K, (A.count ω : ℤ) - (B.count ω : ℤ) ≠ 0 → IsAlgebraic ℚ ω ∧
      ∀ ω' : K, Polynomial.aeval ω' (minpoly ℚ ω) = 0 →
        (A.count ω' : ℤ) - (B.count ω' : ℤ) = (A.count ω : ℤ) - (B.count ω : ℤ)) →
    ∀ k : ℕ, ∃ c : ℚ, (A.map (· ^ k)).sum - (B.map (· ^ k)).sum = algebraMap ℚ K c :=
by
  intro K _ _ _ _ A B hH k
  classical

  have s2 : ∀ β : K, IsAlgebraic ℚ β → ∃ c : ℚ,
      ∑ ω ∈ ((minpoly ℚ β).aroots K).toFinset, ω ^ k = algebraMap ℚ K c := by
    intro β hβ
    have h : IsIntegral ℚ β := hβ.isIntegral
    haveI : FiniteDimensional ℚ (IntermediateField.adjoin ℚ {β}) :=
      IntermediateField.adjoin.finiteDimensional h
    refine ⟨Algebra.trace ℚ (IntermediateField.adjoin ℚ {β})
      (IntermediateField.AdjoinSimple.gen ℚ β ^ k), ?_⟩
    rw [trace_eq_sum_embeddings K]
    first
      | (rw [Finset.sum_subtype ((minpoly ℚ β).aroots K).toFinset
            (p := fun x : K => x ∈ (minpoly ℚ β).aroots K) (fun x => Multiset.mem_toFinset)
            (fun x : K => x ^ k)]
         refine Fintype.sum_equiv (IntermediateField.algHomAdjoinIntegralEquiv ℚ h).symm _ _ ?_
         intro x
         rw [map_pow, IntermediateField.algHomAdjoinIntegralEquiv_symm_apply_gen])
      | (simp only [map_pow]
         rw [← (IntermediateField.algHomAdjoinIntegralEquiv ℚ h).symm.sum_comp]
         simp only [IntermediateField.algHomAdjoinIntegralEquiv_symm_apply_gen]
         first
           | exact Finset.sum_subtype ((minpoly ℚ β).aroots K).toFinset
               (p := fun x : K => x ∈ (minpoly ℚ β).aroots K) (fun x => Multiset.mem_toFinset)
               (fun x : K => x ^ k)
           | convert Finset.sum_subtype ((minpoly ℚ β).aroots K).toFinset
               (p := fun x : K => x ∈ (minpoly ℚ β).aroots K) (fun x => Multiset.mem_toFinset)
               (fun x : K => x ^ k) using 1)
  obtain ⟨μ, hμ⟩ : ∃ μ : K → ℤ, ∀ ω, μ ω = (A.count ω : ℤ) - (B.count ω : ℤ) :=
    ⟨_, fun _ => rfl⟩
  have hH' : ∀ ω : K, μ ω ≠ 0 → IsAlgebraic ℚ ω ∧
      ∀ ω' : K, Polynomial.aeval ω' (minpoly ℚ ω) = 0 → μ ω' = μ ω := by
    intro ω hω
    rw [hμ] at hω
    obtain ⟨h1, h2⟩ := hH ω hω
    exact ⟨h1, fun ω' h => by rw [hμ, hμ]; exact h2 ω' h⟩

  have hcount : ∀ M : Multiset K, (∀ x ∈ M, x ∈ A + B) →
      (M.map (· ^ k)).sum = ∑ ω ∈ (A + B).toFinset, (M.count ω : K) * ω ^ k := by
    intro M hM
    rw [Finset.sum_multiset_map_count]
    simp only [nsmul_eq_mul]
    apply Finset.sum_subset
    · intro x hx
      rw [Multiset.mem_toFinset] at hx ⊢
      exact hM x hx
    · intro x _ hx
      rw [Multiset.mem_toFinset] at hx
      rw [Multiset.count_eq_zero.mpr hx]
      simp
  have e1 : (A.map (· ^ k)).sum - (B.map (· ^ k)).sum =
      ∑ ω ∈ (A + B).toFinset, (μ ω : K) * ω ^ k := by
    rw [hcount A (fun x hx => Multiset.mem_add.mpr (Or.inl hx)),
      hcount B (fun x hx => Multiset.mem_add.mpr (Or.inr hx)), ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun ω _ => ?_
    rw [hμ]; push_cast; ring
  have e2 : ∑ ω ∈ (A + B).toFinset, (μ ω : K) * ω ^ k =
      ∑ ω ∈ (A + B).toFinset.filter (fun ω => μ ω ≠ 0), (μ ω : K) * ω ^ k := by
    refine (Finset.sum_filter_of_ne fun ω _ h => ?_).symm
    intro h0
    apply h
    rw [h0]; simp
  rw [e1, e2, ← Finset.sum_fiberwise_of_maps_to (g := minpoly ℚ)
    (t := ((A + B).toFinset.filter (fun ω => μ ω ≠ 0)).image (minpoly ℚ))
    (fun x hx => Finset.mem_image_of_mem _ hx)]
  have hfib : ∀ q ∈ ((A + B).toFinset.filter (fun ω => μ ω ≠ 0)).image (minpoly ℚ),
      ∃ c : ℚ, ∑ x ∈ ((A + B).toFinset.filter (fun ω => μ ω ≠ 0)).filter
        (fun x => minpoly ℚ x = q), (μ x : K) * x ^ k = algebraMap ℚ K c := by
    intro q hq
    obtain ⟨ω₀, hω₀S, rfl⟩ := Finset.mem_image.mp hq
    have hμ0 : μ ω₀ ≠ 0 := (Finset.mem_filter.mp hω₀S).2
    obtain ⟨halg, hconj⟩ := hH' ω₀ hμ0
    have hint : IsIntegral ℚ ω₀ := halg.isIntegral
    have hfeq : ((A + B).toFinset.filter (fun ω => μ ω ≠ 0)).filter
        (fun x => minpoly ℚ x = minpoly ℚ ω₀) = ((minpoly ℚ ω₀).aroots K).toFinset := by
      ext ω
      rw [Finset.mem_filter, Multiset.mem_toFinset, Polynomial.mem_aroots]
      constructor
      · rintro ⟨_, h⟩
        refine ⟨minpoly.ne_zero hint, ?_⟩
        rw [← h]; exact minpoly.aeval ℚ ω
      · rintro ⟨_, h⟩
        have hμω : μ ω = μ ω₀ := hconj ω h
        refine ⟨Finset.mem_filter.mpr ⟨?_, ?_⟩, ?_⟩
        · rw [Multiset.mem_toFinset]
          by_contra hn
          apply hμ0
          rw [← hμω, hμ,
            Multiset.count_eq_zero.mpr (fun h' => hn (Multiset.mem_add.mpr (Or.inl h'))),
            Multiset.count_eq_zero.mpr (fun h' => hn (Multiset.mem_add.mpr (Or.inr h')))]
          simp
        · rw [hμω]; exact hμ0
        · exact (minpoly.eq_of_irreducible_of_monic (minpoly.irreducible hint) h
            (minpoly.monic hint)).symm
    rw [hfeq]
    obtain ⟨c₀, hc₀⟩ := s2 ω₀ halg
    refine ⟨(μ ω₀ : ℚ) * c₀, ?_⟩
    have hsum : ∑ x ∈ ((minpoly ℚ ω₀).aroots K).toFinset, (μ x : K) * x ^ k =
        (μ ω₀ : K) * ∑ x ∈ ((minpoly ℚ ω₀).aroots K).toFinset, x ^ k := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun ω hω => ?_)
      rw [hconj ω (Polynomial.mem_aroots.mp (Multiset.mem_toFinset.mp hω)).2]
    rw [hsum, hc₀, map_mul, map_intCast]
  choose! c hc using hfib
  refine ⟨∑ q ∈ ((A + B).toFinset.filter (fun ω => μ ω ≠ 0)).image (minpoly ℚ), c q, ?_⟩
  rw [map_sum]
  exact Finset.sum_congr rfl (fun q hq => hc q hq)

theorem wc_virtual_powersum_rational {K : Type*} [Field K] [IsAlgClosed K] [CharZero K]
    {ι : Type*} (deg : ι → ℕ) (P : ι → Multiset K) (A B : Multiset K)
    (hA0 : (0 : K) ∉ A) (hB0 : (0 : K) ∉ B) (hdeg : ∀ i, 1 ≤ deg i)
    (hH1 : ∀ i (j : ℕ), 1 ≤ j → ∃ c : ℚ, ((P i).map (· ^ j)).sum +
      (A.map (· ^ (deg i * j))).sum - (B.map (· ^ (deg i * j))).sum = algebraMap ℚ K c)
    (hH2 : ∀ Δ : Finset K, (0 : K) ∉ Δ → ∀ N₀ : Finset ℕ, (∀ k ∈ N₀, 2 ≤ k) →
      ∃ i, (∀ k ∈ N₀, ¬ k ∣ deg i) ∧ ∀ δ ∈ Δ, δ ^ deg i ∉ P i) :
    ∀ k : ℕ, 1 ≤ k → ∃ c : ℚ, (A.map (· ^ k)).sum - (B.map (· ^ k)).sum = algebraMap ℚ K c :=
by
  classical
  intro k _hk
  obtain ⟨Δ₀, hΔ₀⟩ : ∃ Δ : Finset K, Δ = (A + B).toFinset := ⟨_, rfl⟩
  have h0Δ₀ : (0 : K) ∉ Δ₀ := by
    rw [hΔ₀, Multiset.mem_toFinset, Multiset.mem_add]
    rintro (h | h)
    · exact hA0 h
    · exact hB0 h
  have hAΔ : ∀ a ∈ A, a ∈ Δ₀ := fun a ha => by
    rw [hΔ₀, Multiset.mem_toFinset, Multiset.mem_add]; exact Or.inl ha
  have hBΔ : ∀ b ∈ B, b ∈ Δ₀ := fun b hb => by
    rw [hΔ₀, Multiset.mem_toFinset, Multiset.mem_add]; exact Or.inr hb
  have hμΔ : ∀ ω : K, (A.count ω : ℤ) - (B.count ω : ℤ) ≠ 0 → ω ∈ Δ₀ := by
    intro ω hω
    by_contra hn
    apply hω
    have hA : A.count ω = 0 := Multiset.count_eq_zero.mpr (fun h => hn (hAΔ ω h))
    have hB : B.count ω = 0 := Multiset.count_eq_zero.mpr (fun h => hn (hBΔ ω h))
    rw [hA, hB]
    simp

  have halg : ∀ ω : K, (A.count ω : ℤ) - (B.count ω : ℤ) ≠ 0 → IsAlgebraic ℚ ω := by
    obtain ⟨n₁, hn₁, T₁, m₁, h0T₁, hrat₁, hω₁⟩ :=
      wc_vps_good_index deg P A B hdeg hH1 hH2 Δ₀ h0Δ₀ hAΔ hBΔ
    intro ω hω
    obtain ⟨hmem, hm⟩ := hω₁ ω (hμΔ ω hω)
    have hne : m₁ (ω ^ n₁) ≠ 0 := by rw [hm]; exact hω
    have h1 := wc_vps_rational_powersum_algebraic T₁ m₁ h0T₁ hrat₁ (ω ^ n₁) hmem hne
    exact IsAlgebraic.of_pow (by omega) h1

  have hinv : ∀ ω : K, (A.count ω : ℤ) - (B.count ω : ℤ) ≠ 0 → ∀ ω' : K,
      Polynomial.aeval ω' (minpoly ℚ ω) = 0 →
      (A.count ω' : ℤ) - (B.count ω' : ℤ) = (A.count ω : ℤ) - (B.count ω : ℤ) := by
    obtain ⟨Ω, hΩ⟩ : ∃ Ω : Finset K, Ω = Δ₀ ∪
        (Δ₀.filter (fun ω => (A.count ω : ℤ) - (B.count ω : ℤ) ≠ 0)).biUnion
          (fun ω => ((minpoly ℚ ω).aroots K).toFinset) := ⟨_, rfl⟩
    have h0Ω : (0 : K) ∉ Ω := by
      rw [hΩ, Finset.mem_union, Finset.mem_biUnion]
      rintro (h | ⟨ω, hω, h0⟩)
      · exact h0Δ₀ h
      · rw [Finset.mem_filter] at hω
        have hint : IsIntegral ℚ ω := (halg ω hω.2).isIntegral
        have hω0 : ω ≠ 0 := fun h => h0Δ₀ (h ▸ hω.1)
        rw [Multiset.mem_toFinset, Polynomial.mem_aroots] at h0
        apply minpoly.coeff_zero_ne_zero hint hω0
        have h2 := h0.2
        rw [Polynomial.aeval_def, Polynomial.eval₂_at_zero] at h2
        exact (algebraMap ℚ K).injective (by rw [h2, map_zero])
    have hΔΩ : ∀ x ∈ Δ₀, x ∈ Ω := fun x hx => by
      rw [hΩ]; exact Finset.mem_union_left _ hx
    obtain ⟨n, _hn, T₂, m₂, h0T₂, hrat₂, hω₂⟩ :=
      wc_vps_good_index deg P A B hdeg hH1 hH2 Ω h0Ω (fun a ha => hΔΩ a (hAΔ a ha))
        (fun b hb => hΔΩ b (hBΔ b hb))
    have halg₂ := wc_vps_rational_powersum_algebraic T₂ m₂ h0T₂ hrat₂
    intro ω hω ω' hω'
    have hωΔ := hμΔ ω hω
    have hint : IsIntegral ℚ ω := (halg ω hω).isIntegral
    have hω'Ω : ω' ∈ Ω := by
      rw [hΩ, Finset.mem_union, Finset.mem_biUnion]
      right
      refine ⟨ω, Finset.mem_filter.mpr ⟨hωΔ, hω⟩, ?_⟩
      rw [Multiset.mem_toFinset, Polynomial.mem_aroots]
      exact ⟨minpoly.ne_zero hint, hω'⟩
    obtain ⟨hmem, hm⟩ := hω₂ ω (hΔΩ ω hωΔ)
    obtain ⟨hmem', hm'⟩ := hω₂ ω' hω'Ω
    have hne : m₂ (ω ^ n) ≠ 0 := by rw [hm]; exact hω

    have hpow : Polynomial.aeval (ω' ^ n) (minpoly ℚ (ω ^ n)) = 0 := by
      have h1 : Polynomial.aeval ω (Polynomial.expand ℚ n (minpoly ℚ (ω ^ n))) = 0 := by
        rw [Polynomial.expand_aeval, minpoly.aeval]
      have h2 : minpoly ℚ ω ∣ Polynomial.expand ℚ n (minpoly ℚ (ω ^ n)) := minpoly.dvd ℚ ω h1
      have h3 := Polynomial.aeval_eq_zero_of_dvd_aeval_eq_zero h2 hω'
      rwa [Polynomial.expand_aeval] at h3
    have heq := wc_vps_conj_invariant T₂ m₂ h0T₂ hrat₂ halg₂ (ω ^ n) hmem hne (ω' ^ n) hmem' hpow
    rw [← hm, ← hm']
    exact heq

  exact wc_vps_conj_stable_rational A B (fun ω hω => ⟨halg ω hω, hinv ω hω⟩) k

theorem wc_pencil_VQ_local_rationality_nm (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n) (hNM : wcPencilNoMixed D)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∀ d : ℕ, 1 ≤ d → ∀ x ∈ wcP1ClosedPt F'' d, (∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) →
      ∀ j : ℕ, ∃ c : ℚ, ((wcPencilLoc D ℓ hP x d).map (· ^ j)).sum =
        algebraMap ℚ (AlgebraicClosure ℚ_[ℓ]) c :=
by
  classical
  intro d hd x hx hxS j
  rcases Nat.eq_zero_or_pos j with hj0 | hjpos
  · subst hj0
    refine ⟨(Multiset.card (wcPencilLoc D ℓ hP x d) : ℚ), ?_⟩
    simp
  · obtain ⟨A, B, hA0, hB0, hAB⟩ :=
      wc_pencil_VQ_fibre_zeta_split F' F'' Y n hn hn2 D ℓ hℓ hP hNI
    let ι := {p : ℕ × (wcP1Over F'').left // 1 ≤ p.1 ∧ p.2 ∈ wcP1ClosedPt F'' p.1 ∧
      ∀ i, p.2 ≠ D.S i (IsLocalRing.closedPoint F'')}
    have hH1 : ∀ (i : ι) (j : ℕ), 1 ≤ j → ∃ c : ℚ,
        ((wcPencilLoc D ℓ hP i.1.2 i.1.1).map (· ^ j)).sum +
          (A.map (· ^ (i.1.1 * j))).sum - (B.map (· ^ (i.1.1 * j))).sum =
            algebraMap ℚ (AlgebraicClosure ℚ_[ℓ]) c :=
      fun i j hj => hAB i.1.1 i.2.1 i.1.2 i.2.2.1 i.2.2.2 j hj
    have hH2 : ∀ Δ : Finset (AlgebraicClosure ℚ_[ℓ]), (0 : AlgebraicClosure ℚ_[ℓ]) ∉ Δ →
        ∀ N₀ : Finset ℕ, (∀ k ∈ N₀, 2 ≤ k) →
        ∃ i : ι, (∀ k ∈ N₀, ¬ k ∣ i.1.1) ∧
          ∀ δ ∈ Δ, δ ^ i.1.1 ∉ wcPencilLoc D ℓ hP i.1.2 i.1.1 := by
      intro Δ hΔ N₀ hN₀
      obtain ⟨d', hd', hdiv, x', hx', hx'S, hδ⟩ :=
        wc_pencil_VQ_generic_avoidance_nm F' F'' Y n hn hn2 D hNM ℓ hℓ hP hNI Δ hΔ N₀ hN₀
      exact ⟨⟨(d', x'), hd', hx', hx'S⟩, hdiv, hδ⟩
    obtain ⟨c', hc'⟩ := wc_virtual_powersum_rational (ι := ι) (fun i => i.1.1)
      (fun i => wcPencilLoc D ℓ hP i.1.2 i.1.1) A B hA0 hB0 (fun i => i.2.1) hH1 hH2
      (d * j) (Nat.mul_pos hd hjpos)
    obtain ⟨c, hc⟩ := hAB d hd x hx hxS j hjpos
    refine ⟨c - c', ?_⟩
    rw [map_sub, ← hc, ← hc']
    ring

theorem wc_similitude_aroots_symm (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (M J : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (μ : ℚ_[ℓ]) (hμ : μ ≠ 0) (hJ : J.det ≠ 0)
    (hMJ : M.transpose * J * M = μ • J) :
    (M.charpoly.aroots (AlgebraicClosure ℚ_[ℓ])).map
        (fun γ => algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) μ / γ) =
      M.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) :=
by
  classical

  have feq : ∀ {L : Type} [Field L] (A B : Matrix (Fin r) (Fin r) L) (c : L), B.det ≠ 0 →
      A.transpose * B * A = c • B → ∀ t : L, t ≠ 0 →
      A.det * A.charpoly.eval t = (-t) ^ r * A.charpoly.eval (c / t) := by
    intro L _ A B c hB hAB t ht
    have hsc : ∀ s : L, Matrix.scalar (Fin r) s = s • (1 : Matrix (Fin r) (Fin r) L) := by
      intro s
      rw [Matrix.scalar_apply, Matrix.smul_one_eq_diagonal]
    have key : A.transpose * B * (Matrix.scalar (Fin r) t - A) =
        (-t) • ((Matrix.scalar (Fin r) (c / t) - A.transpose) * B) := by
      rw [hsc, hsc, Matrix.mul_sub, hAB, Matrix.sub_mul, Matrix.mul_smul, Matrix.mul_one,
        Matrix.smul_mul, Matrix.one_mul, smul_sub, smul_smul,
        show -t * (c / t) = -c by field_simp, neg_smul, neg_smul, sub_neg_eq_add]
      abel
    have h := congrArg Matrix.det key
    rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, ← Matrix.eval_charpoly,
      Matrix.det_smul, Fintype.card_fin, Matrix.det_mul, ← Matrix.eval_charpoly,
      Matrix.charpoly_transpose] at h
    apply mul_right_cancel₀ hB
    linear_combination h
  set K := AlgebraicClosure ℚ_[ℓ] with hKdef
  set f := algebraMap ℚ_[ℓ] K with hfdef
  have hdetM : M.det ≠ 0 := by
    have h := congrArg Matrix.det hMJ
    rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, Matrix.det_smul,
      Fintype.card_fin] at h
    intro h0
    rw [h0, zero_mul, zero_mul] at h
    exact (mul_ne_zero (pow_ne_zero r hμ) hJ) h.symm
  set MK := M.map f with hMKdef
  set JK := J.map f with hJKdef
  have hJK : JK.det ≠ 0 := by
    rw [show JK.det = f J.det from (RingHom.map_det f J).symm]
    exact (map_ne_zero f).mpr hJ
  have hdetMK : MK.det ≠ 0 := by
    rw [show MK.det = f M.det from (RingHom.map_det f M).symm]
    exact (map_ne_zero f).mpr hdetM
  have hMJK : MK.transpose * JK * MK = f μ • JK := by
    have h : (M.transpose * J * M).map f = (μ • J).map f := by rw [hMJ]
    rw [Matrix.map_mul, Matrix.map_mul, Matrix.transpose_map] at h
    rw [h]
    ext i j
    simp [JK]
  have hS : M.charpoly.aroots K = MK.charpoly.roots := by
    rw [Polynomial.aroots_def, ← Matrix.charpoly_map]
  rw [hS]
  set c := f μ with hcdef
  set χ := MK.charpoly with hχdef
  set S := χ.roots with hSdef
  have hmon : χ.Monic := Matrix.charpoly_monic MK
  have hcard : Multiset.card S = r := by
    rw [hSdef, IsAlgClosed.card_roots_eq_natDegree, hχdef, Matrix.charpoly_natDegree_eq_dim,
      Fintype.card_fin]
  have hprod : (S.map fun a => Polynomial.X - Polynomial.C a).prod = χ :=
    Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hmon
      (by rw [hcard, hχdef, Matrix.charpoly_natDegree_eq_dim, Fintype.card_fin])
  have hdetS : MK.det = S.prod := Matrix.det_eq_prod_roots_charpoly MK
  have hSp : S.prod ≠ 0 := hdetS ▸ hdetMK
  have h0 : (0 : K) ∉ S := fun h => hSp (Multiset.prod_eq_zero h)
  have hevalχ : ∀ t : K, χ.eval t = (S.map fun g => t - g).prod := by
    intro t
    conv_lhs => rw [← hprod]
    rw [Polynomial.eval_multiset_prod, Multiset.map_map]
    congr 1
    apply Multiset.map_congr rfl
    intro g _
    simp
  set Q := ((S.map fun g => c / g).map fun a => Polynomial.X - Polynomial.C a).prod with hQdef
  have hQroots : Q.roots = S.map fun g => c / g := Polynomial.roots_multiset_prod_X_sub_C _
  have hevalQ : ∀ t : K, Q.eval t = (S.map fun g => t - c / g).prod := by
    intro t
    rw [hQdef, Polynomial.eval_multiset_prod, Multiset.map_map, Multiset.map_map]
    congr 1
    apply Multiset.map_congr rfl
    intro g _
    simp
  have key : ∀ t : K, t ≠ 0 → Q.eval t = χ.eval t := by
    intro t ht
    have hfe := feq MK JK c hJK hMJK t ht
    rw [hdetS] at hfe
    have e1 : (S.map fun g => t - c / g).prod =
        (S.map fun g => (-t) * g⁻¹).prod * (S.map fun g => c / t - g).prod := by
      rw [← Multiset.prod_map_mul]
      congr 1
      apply Multiset.map_congr rfl
      intro g hg
      have hg0 : g ≠ 0 := fun h => h0 (h ▸ hg)
      have hA : t * t⁻¹ = 1 := mul_inv_cancel₀ ht
      have hB : g * g⁻¹ = 1 := mul_inv_cancel₀ hg0
      show t - c / g = -t * g⁻¹ * (c / t - g)
      linear_combination (c * g⁻¹) * hA - t * hB
    have e2 : (S.map fun g => (-t) * g⁻¹).prod = (-t) ^ r * (S.prod)⁻¹ := by
      rw [Multiset.prod_map_mul, Multiset.map_const', Multiset.prod_replicate, hcard,
        Multiset.prod_map_inv, Multiset.map_id']
    rw [hevalQ, e1, e2, ← hevalχ (c / t)]
    calc (-t) ^ r * (S.prod)⁻¹ * χ.eval (c / t)
        = (S.prod)⁻¹ * ((-t) ^ r * χ.eval (c / t)) := by ring
      _ = (S.prod)⁻¹ * (S.prod * χ.eval t) := by rw [hfe]
      _ = χ.eval t := by rw [← mul_assoc, inv_mul_cancel₀ hSp, one_mul]
  have hQχ : Q = χ := by
    have hX : Polynomial.X * Q = Polynomial.X * χ := by
      apply Polynomial.funext
      intro x
      by_cases hx : x = 0
      · simp [hx]
      · rw [Polynomial.eval_mul, Polynomial.eval_mul, key x hx]
    exact mul_left_cancel₀ Polynomial.X_ne_zero hX
  rw [← hQroots, hQχ]

theorem wc_gram_similitude {W : Type*} [AddCommGroup W] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (s : ℚ_[ℓ] → W →+ W) (r : ℕ) (e : W ≃+ (Fin r → ℚ_[ℓ]))
    (he : ∀ (c : ℚ_[ℓ]) (x : W), e (s c x) = c • e x) (Φ : W →+ W)
    (b : W →+ W →+ ℚ_[ℓ]) (μ : ℚ_[ℓ])
    (hbl : ∀ (c : ℚ_[ℓ]) (x y : W), b (s c x) y = c * b x y)
    (hbr : ∀ (c : ℚ_[ℓ]) (x y : W), b x (s c y) = c * b x y)
    (hbΦ : ∀ x y : W, b (Φ x) (Φ y) = μ * b x y)
    (hnd : ∀ x : W, (∀ y, b x y = 0) → x = 0) :
    ∃ J : Matrix (Fin r) (Fin r) ℚ_[ℓ], J.det ≠ 0 ∧
      (wcAddEquivMatrix e Φ).transpose * J * wcAddEquivMatrix e Φ = μ • J :=
by
  set v : Fin r → W := fun a => e.symm (Pi.single a 1) with hv
  set J : Matrix (Fin r) (Fin r) ℚ_[ℓ] := Matrix.of (fun a c => b (v a) (v c)) with hJ
  have expand : ∀ x : W, x = ∑ a, s (e x a) (v a) := by
    intro x
    apply e.injective
    rw [map_sum]
    ext k
    simp [he, hv, Finset.sum_apply, Pi.single_apply]
  have coord : ∀ x y : W, b x y = ∑ a, ∑ c, e x a * e y c * J a c := by
    intro x y
    have h1 : b x y = ∑ a, e x a * b (v a) y := by
      conv_lhs => rw [expand x]
      rw [map_sum, AddMonoidHom.finsetSum_apply]
      exact Finset.sum_congr rfl (fun a _ => hbl _ _ _)
    have h2 : ∀ a, b (v a) y = ∑ c, e y c * J a c := by
      intro a
      conv_lhs => rw [expand y]
      rw [map_sum]
      exact Finset.sum_congr rfl (fun c _ => by rw [hbr]; rfl)
    rw [h1]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [h2, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun c _ => ?_)
    ring
  have hM : ∀ a j, wcAddEquivMatrix e Φ a j = e (Φ (v j)) a := fun a j => rfl
  have rel : (wcAddEquivMatrix e Φ).transpose * J * wcAddEquivMatrix e Φ = μ • J := by
    ext i j
    rw [Matrix.mul_apply, Matrix.smul_apply, smul_eq_mul]
    simp only [Matrix.mul_apply, Matrix.transpose_apply, hM]
    have hJij : J i j = b (v i) (v j) := rfl
    rw [hJij, ← hbΦ, coord]
    simp only [Finset.sum_mul]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun c _ => by ring))
  have hdet : J.det ≠ 0 := by
    intro h0
    obtain ⟨w, hw0, hw⟩ := Matrix.exists_vecMul_eq_zero_iff.mpr h0
    have hwc : ∀ c, ∑ a, w a * J a c = 0 := by
      intro c
      have := congrFun hw c
      simpa [Matrix.vecMul, dotProduct] using this
    apply hw0
    have hx : e.symm w = 0 := by
      apply hnd
      intro y
      rw [coord, AddEquiv.apply_symm_apply, Finset.sum_comm]
      apply Finset.sum_eq_zero
      intro c _
      have : ∑ a, w a * e y c * J a c = e y c * ∑ a, w a * J a c := by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun a _ => by ring)
      rw [this, hwc c, mul_zero]
    rw [← AddEquiv.apply_symm_apply e w, hx, map_zero]
  exact ⟨J, hdet, rel⟩

theorem wc_form_descent_quotient {W Q : Type*} [AddCommGroup W] [AddCommGroup Q]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (sW : ℚ_[ℓ] → W →+ W) (sQ : ℚ_[ℓ] → Q →+ Q)
    (π : W →+ Q) (hπ : Function.Surjective π)
    (hπs : ∀ (c : ℚ_[ℓ]) (w : W), π (sW c w) = sQ c (π w))
    (ΦW : W →+ W) (ΦQ : Q →+ Q) (hπΦ : ∀ w : W, π (ΦW w) = ΦQ (π w))
    (b : W →+ W →+ ℚ_[ℓ]) (μ : ℚ_[ℓ])
    (hbl : ∀ (c : ℚ_[ℓ]) (w w' : W), b (sW c w) w' = c * b w w')
    (hbr : ∀ (c : ℚ_[ℓ]) (w w' : W), b w (sW c w') = c * b w w')
    (hbΦ : ∀ w w' : W, b (ΦW w) (ΦW w') = μ * b w w')
    (hradL : ∀ w : W, (∀ w', b w w' = 0) ↔ π w = 0)
    (hradR : ∀ w : W, (∀ w', b w' w = 0) ↔ π w = 0) :
    ∃ b' : Q →+ Q →+ ℚ_[ℓ],
      (∀ (c : ℚ_[ℓ]) (x y : Q), b' (sQ c x) y = c * b' x y) ∧
      (∀ (c : ℚ_[ℓ]) (x y : Q), b' x (sQ c y) = c * b' x y) ∧
      (∀ x y : Q, b' (ΦQ x) (ΦQ y) = μ * b' x y) ∧
      (∀ x : Q, (∀ y, b' x y = 0) → x = 0) :=
by
  obtain ⟨s, hs⟩ : ∃ s : Q → W, ∀ x, π (s x) = x :=
    ⟨Function.surjInv hπ, Function.surjInv_eq hπ⟩
  have K : ∀ w w' : W, b (s (π w)) (s (π w')) = b w w' := by
    intro w w'
    have h1 : b (s (π w) - w) (s (π w')) = 0 :=
      (hradL _).mpr (by rw [map_sub, hs, sub_self]) _
    have h2 : b w (s (π w') - w') = 0 :=
      (hradR _).mpr (by rw [map_sub, hs, sub_self]) _
    rw [map_sub, AddMonoidHom.sub_apply, sub_eq_zero] at h1
    rw [map_sub, sub_eq_zero] at h2
    rw [h1, h2]
  let inner : Q → Q →+ ℚ_[ℓ] := fun x => AddMonoidHom.mk' (fun y => b (s x) (s y)) (by
    intro y₁ y₂
    have h := K (s x) (s y₁ + s y₂)
    simp only [hs, map_add] at h
    exact h)
  have hinner : ∀ x y, inner x y = b (s x) (s y) := fun x y => rfl
  let b' : Q →+ Q →+ ℚ_[ℓ] := AddMonoidHom.mk' inner (by
    intro x₁ x₂
    ext y
    have h := K (s x₁ + s x₂) (s y)
    simp only [hs, map_add, AddMonoidHom.add_apply] at h
    rw [AddMonoidHom.add_apply, hinner, hinner, hinner]
    exact h)
  have hb' : ∀ x y, b' x y = b (s x) (s y) := fun x y => rfl
  refine ⟨b', ?_, ?_, ?_, ?_⟩
  · intro c x y
    obtain ⟨w, rfl⟩ := hπ x
    obtain ⟨w', rfl⟩ := hπ y
    rw [hb', hb', ← hπs, K, K, hbl]
  · intro c x y
    obtain ⟨w, rfl⟩ := hπ x
    obtain ⟨w', rfl⟩ := hπ y
    rw [hb', hb', ← hπs, K, K, hbr]
  · intro x y
    obtain ⟨w, rfl⟩ := hπ x
    obtain ⟨w', rfl⟩ := hπ y
    rw [hb', hb', ← hπΦ, ← hπΦ, K, K, hbΦ]
  · intro x hx
    obtain ⟨w, rfl⟩ := hπ x
    apply (hradL w).mp
    intro w'
    rw [← K, ← hb']
    exact hx _

theorem wc_pencil_R_stalk_basis (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'') :
    ∀ d : ℕ, 1 ≤ d → ∀ x ∈ wcP1ClosedPt F'' d, (∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) →
    ∀ N : wcFrobNbhd F'' x d,
    ∃ (r : ℕ) (e : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0 ≃+
        (Fin r → ℚ_[ℓ])),
      ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0),
        e ((Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 1) c)).postcomp
          (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) y) = c • e y :=
by
  classical
  intro d hd x hx hS N
  have hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  obtain ⟨W, w, r, -, hcov, hW⟩ := wc_pencil_Rq_scalar_triv_cover F' F'' Y n D ℓ hℓ hP (n - 1)
  letI := N.ringA
  haveI := N.hensA
  haveI := N.sepA
  have hV : wcScalarTriv (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1)) (wcRqScalar D.f ℓ (n - 1))
      N.V r :=
    wc_proet_scalarTriv_strict_local F'' hP ℓ _ _ r D.m D.S D.hS W w hcov hW N.V N.A N.e
      (by intro i; rw [N.hx]; exact hS i)
  obtain ⟨b, hb, -⟩ := wc_proet_scalarTriv_stalk_basis _ ℓ _ _ r N.V N.A N.e N.φ hV
  exact ⟨r, b, hb⟩

theorem wc_pencil_Rq_cup_pairing (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∃ B : ∀ V : (wcP1Over F'').left.ProEt,
        (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V) →+
          (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V) →+
            (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op V),
      (∀ (V V' : (wcP1Over F'').left.ProEt) (a : V' ⟶ V)
          (y y' : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
        B V' (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom y)
            (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom y') =
          ((wcRq D.f ℓ (2 * (n - 1))).obj.map a.op).hom (B V y y')) ∧
      (∀ (V : (wcP1Over F'').left.ProEt) (c : ℚ_[ℓ])
          (y y' : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
        B V (((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op V)).hom y) y' =
          ((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op V)).hom (B V y y')) ∧
      (∀ (V : (wcP1Over F'').left.ProEt) (c : ℚ_[ℓ])
          (y y' : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
        B V y (((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op V)).hom y') =
          ((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op V)).hom (B V y y')) ∧
      (∀ (V : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A]
          [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)),
        IsClosed ({V.hom (e.inv (IsLocalRing.closedPoint A))} : Set (wcP1Over F'').left) →
        (∀ i, V.hom (e.inv (IsLocalRing.closedPoint A)) ≠ D.S i (IsLocalRing.closedPoint F'')) →
        (∀ y, (∀ y', B V y y' = 0) → y = 0) ∧ (∀ y', (∀ y, B V y y' = 0) → y' = 0)) :=
by
  classical

  have s1 : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (Da : wcHMPullData f ℓ) (i j k : ℕ)
      (hk : i + j = k) (x : wcHM S ℓ i) (y : wcHM S ℓ j),
      wcHMPull Da k (wcHMCup S ℓ i j k hk x y) =
        wcHMCup S' ℓ i j k hk (wcHMPull Da i x) (wcHMPull Da j y) := by
    intro S S' f Da i j k hk x y
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := Da.additive
    haveI := Da.presLim
    haveI := Da.presColim
    show (Abelian.Ext.mk₀ Da.μ.inv).comp ((Abelian.Ext.mapExactFunctor Da.Φ (x.comp y hk)).comp
        (Abelian.Ext.mk₀ Da.μ.hom) (add_zero k)) (zero_add k) =
      ((Abelian.Ext.mk₀ Da.μ.inv).comp ((Abelian.Ext.mapExactFunctor Da.Φ x).comp
        (Abelian.Ext.mk₀ Da.μ.hom) (add_zero i)) (zero_add i)).comp
      ((Abelian.Ext.mk₀ Da.μ.inv).comp ((Abelian.Ext.mapExactFunctor Da.Φ y).comp
        (Abelian.Ext.mk₀ Da.μ.hom) (add_zero j)) (zero_add j)) hk
    rw [Abelian.Ext.mapExactFunctor_comp]
    generalize Abelian.Ext.mapExactFunctor Da.Φ x = X
    generalize Abelian.Ext.mapExactFunctor Da.Φ y = Y'
    rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ Da.μ.inv)
        (X.comp (Abelian.Ext.mk₀ Da.μ.hom) (add_zero i)) _ (zero_add i) hk (by omega),
      Abelian.Ext.comp_assoc_of_second_deg_zero X (Abelian.Ext.mk₀ Da.μ.hom) _ hk,
      ← Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mk₀ Da.μ.hom)
        (Abelian.Ext.mk₀ Da.μ.inv) _ (zero_add j),
      Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    congr 1
    exact Abelian.Ext.comp_assoc_of_third_deg_zero X Y' _ hk

  have s2 : ∀ (S : Scheme.{u}) (i j k : ℕ) (hk : i + j = k) (c : ℚ_[ℓ]) (x : wcHM S ℓ i)
      (y : wcHM S ℓ j),
      wcHMCup S ℓ i j k hk (wcHMScalar S ℓ i c x) y =
          wcHMScalar S ℓ k c (wcHMCup S ℓ i j k hk x y) ∧
        wcHMCup S ℓ i j k hk x (wcHMScalar S ℓ j c y) =
          wcHMScalar S ℓ k c (wcHMCup S ℓ i j k hk x y) := by
    intro S i j k hk c x y
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    have hcent : (Abelian.Ext.mk₀ (wcHMConst S ℓ c)).comp y (zero_add j) =
        y.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero j) :=
      wc_hm_unit_end_central S ℓ (wcHMConst S ℓ c) j y
    refine ⟨?_, ?_⟩
    · show (x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero i)).comp y hk =
        (x.comp y hk).comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero k)
      rw [Abelian.Ext.comp_assoc_of_second_deg_zero x (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) y hk,
        hcent]
      exact (Abelian.Ext.comp_assoc_of_third_deg_zero x y _ hk).symm
    · show x.comp (y.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero j)) hk =
        (x.comp y hk).comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero k)
      exact (Abelian.Ext.comp_assoc_of_third_deg_zero x y _ hk).symm

  have hcov : ∀ U : (wcP1Over F'').left.ProEt,
      Sieve.generate (fun (W : (wcP1Over F'').left.ProEt) (_ : W ⟶ U) =>
        Projective (wcFreeSheaf (wcP1Over F'').left W)) ∈
        Scheme.ProEt.topology (wcP1Over F'').left U := by
    intro U
    apply wc_proet_sieve_of_affine_finite_covers (wcP1Over F'').left U
    intro W v hW
    obtain ⟨Δ, δ, hΔ, hδ, hsurj, h1, h2, h3, h4⟩ := wc_exists_wcontractible_cover W.left hW
    let W' : (wcP1Over F'').left.ProEt := MorphismProperty.Over.mk ⊤ (δ ≫ W.hom)
      (@MorphismProperty.comp_mem _ _ @WeaklyEtale
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ hδ W.prop)
    let e : W' ⟶ W := MorphismProperty.Over.homMk δ rfl trivial
    refine ⟨1, fun _ => W', fun _ => e, fun _ => hΔ, ?_, ?_⟩
    · intro y
      obtain ⟨x, hx⟩ := hsurj.surj y
      exact ⟨0, x, hx⟩
    · intro _
      exact ⟨W', 𝟙 _, e ≫ v,
        wc_proet_free_projective_wcontractible (wcP1Over F'').left W' ⟨hΔ, h1, h2, h3, h4⟩,
        Category.id_comp _⟩

  have s5 : ∀ (G H : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
      (σG : ℚ_[ℓ] → (G ⟶ G)) (σH : ℚ_[ℓ] → (H ⟶ H))
      (β : ∀ V : (wcP1Over F'').left.ProEt, Projective (wcFreeSheaf (wcP1Over F'').left V) →
        G.obj.obj (Opposite.op V) →+ G.obj.obj (Opposite.op V) →+ H.obj.obj (Opposite.op V))
      (hβ : ∀ (V V' : (wcP1Over F'').left.ProEt)
        (hV : Projective (wcFreeSheaf (wcP1Over F'').left V))
        (hV' : Projective (wcFreeSheaf (wcP1Over F'').left V')) (a : V' ⟶ V)
        (y y' : G.obj.obj (Opposite.op V)),
        β V' hV' ((G.obj.map a.op).hom y) ((G.obj.map a.op).hom y') =
          (H.obj.map a.op).hom (β V hV y y'))
      (hβL : ∀ (V : (wcP1Over F'').left.ProEt)
        (hV : Projective (wcFreeSheaf (wcP1Over F'').left V)) (c : ℚ_[ℓ])
        (y y' : G.obj.obj (Opposite.op V)),
        β V hV (((σG c).hom.app (Opposite.op V)).hom y) y' =
          ((σH c).hom.app (Opposite.op V)).hom (β V hV y y'))
      (hβR : ∀ (V : (wcP1Over F'').left.ProEt)
        (hV : Projective (wcFreeSheaf (wcP1Over F'').left V)) (c : ℚ_[ℓ])
        (y y' : G.obj.obj (Opposite.op V)),
        β V hV y (((σG c).hom.app (Opposite.op V)).hom y') =
          ((σH c).hom.app (Opposite.op V)).hom (β V hV y y')),
      ∃ B : ∀ V : (wcP1Over F'').left.ProEt,
          G.obj.obj (Opposite.op V) →+ G.obj.obj (Opposite.op V) →+ H.obj.obj (Opposite.op V),
        (∀ (V V' : (wcP1Over F'').left.ProEt) (a : V' ⟶ V) (y y' : G.obj.obj (Opposite.op V)),
          B V' ((G.obj.map a.op).hom y) ((G.obj.map a.op).hom y') =
            (H.obj.map a.op).hom (B V y y')) ∧
        (∀ (V : (wcP1Over F'').left.ProEt) (c : ℚ_[ℓ]) (y y' : G.obj.obj (Opposite.op V)),
          B V (((σG c).hom.app (Opposite.op V)).hom y) y' =
            ((σH c).hom.app (Opposite.op V)).hom (B V y y')) ∧
        (∀ (V : (wcP1Over F'').left.ProEt) (c : ℚ_[ℓ]) (y y' : G.obj.obj (Opposite.op V)),
          B V y (((σG c).hom.app (Opposite.op V)).hom y') =
            ((σH c).hom.app (Opposite.op V)).hom (B V y y')) ∧
        (∀ (V : (wcP1Over F'').left.ProEt) (hV : Projective (wcFreeSheaf (wcP1Over F'').left V))
          (y y' : G.obj.obj (Opposite.op V)), B V y y' = β V hV y y') := by
    intro G H σG σH β hβ hβL hβR
    let Good : (wcP1Over F'').left.ProEt → Prop :=
      fun W => Projective (wcFreeSheaf (wcP1Over F'').left W)
    let P : ((wcP1Over F'').left.ProEt)ᵒᵖ ⥤ Type (u+1) := H.obj ⋙ forget AddCommGrpCat
    have hPsh : Presieve.IsSheaf (Scheme.ProEt.topology (wcP1Over F'').left) P :=
      (isSheaf_iff_isSheaf_of_type _ P).mp
        ((Presheaf.isSheaf_iff_isSheaf_forget _ H.obj (forget AddCommGrpCat)).mp H.property)
    let T : ∀ U : (wcP1Over F'').left.ProEt, Presieve U := fun U => fun W _ => Good W
    have hT : ∀ U, Presieve.IsSheafFor P (T U) := fun U =>
      (Presieve.isSheafFor_iff_generate (T U)).mpr (hPsh _ (hcov U))
    have hU : ∀ (U : (wcP1Over F'').left.ProEt) (t t' : H.obj.obj (Opposite.op U)),
        (∀ (W : (wcP1Over F'').left.ProEt) (g : W ⟶ U), Good W →
          (H.obj.map g.op).hom t = (H.obj.map g.op).hom t') → t = t' :=
      fun U t t' h => (hT U).isSeparatedFor.ext (fun W g hg => h W g hg)
    have hGmap : ∀ {V W Z : (wcP1Over F'').left.ProEt} (g : W ⟶ V) (f : Z ⟶ W)
        (y : G.obj.obj (Opposite.op V)),
        (G.obj.map f.op).hom ((G.obj.map g.op).hom y) = (G.obj.map (f ≫ g).op).hom y := by
      intro V W Z g f y
      rw [op_comp, Functor.map_comp]
      rfl
    have hHmap : ∀ {V W Z : (wcP1Over F'').left.ProEt} (g : W ⟶ V) (f : Z ⟶ W)
        (y : H.obj.obj (Opposite.op V)),
        (H.obj.map f.op).hom ((H.obj.map g.op).hom y) = (H.obj.map (f ≫ g).op).hom y := by
      intro V W Z g f y
      rw [op_comp, Functor.map_comp]
      rfl
    have hnatG : ∀ (c : ℚ_[ℓ]) {V W : (wcP1Over F'').left.ProEt} (g : W ⟶ V)
        (y : G.obj.obj (Opposite.op V)),
        (G.obj.map g.op).hom (((σG c).hom.app (Opposite.op V)).hom y) =
          ((σG c).hom.app (Opposite.op W)).hom ((G.obj.map g.op).hom y) := by
      intro c V W g y
      exact (congrArg (fun f => f.hom y) ((σG c).hom.naturality g.op)).symm
    have hnatH : ∀ (c : ℚ_[ℓ]) {V W : (wcP1Over F'').left.ProEt} (g : W ⟶ V)
        (y : H.obj.obj (Opposite.op V)),
        (H.obj.map g.op).hom (((σH c).hom.app (Opposite.op V)).hom y) =
          ((σH c).hom.app (Opposite.op W)).hom ((H.obj.map g.op).hom y) := by
      intro c V W g y
      exact (congrArg (fun f => f.hom y) ((σH c).hom.naturality g.op)).symm
    let fam : ∀ (V : (wcP1Over F'').left.ProEt) (y y' : G.obj.obj (Opposite.op V)),
        Presieve.FamilyOfElements P (T V) :=
      fun V y y' W g hg => β W hg ((G.obj.map g.op).hom y) ((G.obj.map g.op).hom y')
    have hcomp : ∀ (V : (wcP1Over F'').left.ProEt) (y y' : G.obj.obj (Opposite.op V)),
        (fam V y y').Compatible := by
      intro V y y' Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ heq
      apply hU Z
      intro Z' k hk
      change (H.obj.map k.op).hom ((H.obj.map g₁.op).hom
          (β Y₁ h₁ ((G.obj.map f₁.op).hom y) ((G.obj.map f₁.op).hom y'))) =
        (H.obj.map k.op).hom ((H.obj.map g₂.op).hom
          (β Y₂ h₂ ((G.obj.map f₂.op).hom y) ((G.obj.map f₂.op).hom y')))
      rw [hHmap, hHmap, ← hβ Y₁ Z' h₁ hk (k ≫ g₁), ← hβ Y₂ Z' h₂ hk (k ≫ g₂),
        hGmap, hGmap, hGmap, hGmap, Category.assoc, Category.assoc, heq]
    have hex : ∀ (V : (wcP1Over F'').left.ProEt) (y y' : G.obj.obj (Opposite.op V)),
        ∃ t : H.obj.obj (Opposite.op V),
        ∀ (W : (wcP1Over F'').left.ProEt) (g : W ⟶ V) (hg : Good W),
          (H.obj.map g.op).hom t =
            β W hg ((G.obj.map g.op).hom y) ((G.obj.map g.op).hom y') := by
      intro V y y'
      exact ⟨(hT V).amalgamate (fam V y y') (hcomp V y y'),
        fun W g hg => (hT V).valid_glue (hcomp V y y') g hg⟩
    choose Bf hstar using hex
    have hadd1 : ∀ (V : (wcP1Over F'').left.ProEt) (y₁ y₂ y' : G.obj.obj (Opposite.op V)),
        Bf V (y₁ + y₂) y' = Bf V y₁ y' + Bf V y₂ y' := by
      intro V y₁ y₂ y'
      apply hU V
      intro W g hg
      rw [map_add, hstar _ _ _ _ _ hg, hstar _ _ _ _ _ hg, hstar _ _ _ _ _ hg]
      simp only [map_add, AddMonoidHom.add_apply]
    have hadd2 : ∀ (V : (wcP1Over F'').left.ProEt) (y y₁ y₂ : G.obj.obj (Opposite.op V)),
        Bf V y (y₁ + y₂) = Bf V y y₁ + Bf V y y₂ := by
      intro V y y₁ y₂
      apply hU V
      intro W g hg
      rw [map_add, hstar _ _ _ _ _ hg, hstar _ _ _ _ _ hg, hstar _ _ _ _ _ hg]
      simp only [map_add]
    let B : ∀ V : (wcP1Over F'').left.ProEt,
        G.obj.obj (Opposite.op V) →+ G.obj.obj (Opposite.op V) →+ H.obj.obj (Opposite.op V) :=
      fun V => AddMonoidHom.mk' (fun y => AddMonoidHom.mk' (fun y' => Bf V y y') (hadd2 V y))
        (fun y₁ y₂ => AddMonoidHom.ext (fun y' => hadd1 V y₁ y₂ y'))
    have hB : ∀ (V : (wcP1Over F'').left.ProEt) (y y' : G.obj.obj (Opposite.op V)),
        B V y y' = Bf V y y' := fun _ _ _ => rfl
    refine ⟨B, ?_, ?_, ?_, ?_⟩
    · intro V V' a y y'
      rw [hB, hB]
      apply hU V'
      intro W g hg
      rw [hHmap, hstar _ _ _ _ _ hg, hstar _ _ _ _ _ hg, hGmap, hGmap]
    · intro V c y y'
      rw [hB, hB]
      apply hU V
      intro W g hg
      rw [hnatH, hstar _ _ _ _ _ hg, hstar _ _ _ _ _ hg, hnatG, hβL]
    · intro V c y y'
      rw [hB, hB]
      apply hU V
      intro W g hg
      rw [hnatH, hstar _ _ _ _ _ hg, hstar _ _ _ _ _ hg, hnatG, hβR]
    · intro V hV y y'
      rw [hB]
      apply hU V
      intro W g hg
      rw [hstar _ _ _ _ _ hg, hβ V W hV hg g]

  obtain ⟨Φ, hΦs, hΦn⟩ := wc_pencil_Rq_hm_comparison F' F'' Y n D ℓ
  have h₂ : (n - 1) + (n - 1) = 2 * (n - 1) := (two_mul (n - 1)).symm

  let β : ∀ V : (wcP1Over F'').left.ProEt, Projective (wcFreeSheaf (wcP1Over F'').left V) →
      (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V) →+
        (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V) →+
          (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op V) :=
    fun V hV => AddMonoidHom.mk'
      (fun y => AddMonoidHom.mk'
        (fun y' => (Φ (2 * (n - 1)) V hV).symm
          (wcHMCup ((wcProEtPullback D.f).obj V).left ℓ (n - 1) (n - 1) (2 * (n - 1))
            (two_mul (n - 1)).symm (Φ (n - 1) V hV y) (Φ (n - 1) V hV y')))
        (fun a b => by simp only [map_add]))
      (fun a b => by
        ext y'
        simp only [map_add, AddMonoidHom.mk'_apply, AddMonoidHom.add_apply])
  have hβdef : ∀ (V : (wcP1Over F'').left.ProEt)
      (hV : Projective (wcFreeSheaf (wcP1Over F'').left V))
      (y y' : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
      β V hV y y' = (Φ (2 * (n - 1)) V hV).symm
        (wcHMCup ((wcProEtPullback D.f).obj V).left ℓ (n - 1) (n - 1) (2 * (n - 1))
          (two_mul (n - 1)).symm (Φ (n - 1) V hV y) (Φ (n - 1) V hV y')) := fun _ _ _ _ => rfl
  have hβ : ∀ (V V' : (wcP1Over F'').left.ProEt)
      (hV : Projective (wcFreeSheaf (wcP1Over F'').left V))
      (hV' : Projective (wcFreeSheaf (wcP1Over F'').left V')) (a : V' ⟶ V)
      (y y' : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
      β V' hV' (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom y)
          (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom y') =
        ((wcRq D.f ℓ (2 * (n - 1))).obj.map a.op).hom (β V hV y y') := by
    intro V V' hV hV' a y y'
    obtain ⟨Da, hDa⟩ := wc_hm_pull_data_exists ((wcProEtPullback D.f).map a).left ℓ
    rw [hβdef, hβdef, hΦn (n - 1) V V' hV hV' a Da hDa y, hΦn (n - 1) V V' hV hV' a Da hDa y',
      ← s1]
    apply (Φ (2 * (n - 1)) V' hV').injective
    rw [AddEquiv.apply_symm_apply, hΦn (2 * (n - 1)) V V' hV hV' a Da hDa,
      AddEquiv.apply_symm_apply]
  have hβL : ∀ (V : (wcP1Over F'').left.ProEt)
      (hV : Projective (wcFreeSheaf (wcP1Over F'').left V)) (c : ℚ_[ℓ])
      (y y' : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
      β V hV (((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op V)).hom y) y' =
        ((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op V)).hom (β V hV y y') := by
    intro V hV c y y'
    rw [hβdef, hβdef, hΦs (n - 1) V hV c y, (s2 _ _ _ _ _ c _ _).1]
    apply (Φ (2 * (n - 1)) V hV).injective
    rw [AddEquiv.apply_symm_apply, hΦs (2 * (n - 1)) V hV c, AddEquiv.apply_symm_apply]
  have hβR : ∀ (V : (wcP1Over F'').left.ProEt)
      (hV : Projective (wcFreeSheaf (wcP1Over F'').left V)) (c : ℚ_[ℓ])
      (y y' : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
      β V hV y (((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op V)).hom y') =
        ((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op V)).hom (β V hV y y') := by
    intro V hV c y y'
    rw [hβdef, hβdef, hΦs (n - 1) V hV c y', (s2 _ _ _ _ _ c _ _).2]
    apply (Φ (2 * (n - 1)) V hV).injective
    rw [AddEquiv.apply_symm_apply, hΦs (2 * (n - 1)) V hV c, AddEquiv.apply_symm_apply]
  obtain ⟨B, hN, hL, hR, hagree⟩ := s5 (wcRq D.f ℓ (n - 1)) (wcRq D.f ℓ (2 * (n - 1)))
    (wcRqScalar D.f ℓ (n - 1)) (wcRqScalar D.f ℓ (2 * (n - 1))) β hβ hβL hβR
  refine ⟨B, hN, hL, hR, ?_⟩
  intro V A _ _ _ e hcl hoff
  have hV := wc_proet_free_projective_strict_local (wcP1Over F'').left V A e
  obtain ⟨hp1, hp2⟩ := wc_pencil_fibre_hm_cup_perfect F' F'' Y n hn hn2 D ℓ hℓ V A e hcl hoff
  constructor
  · intro y hy
    have h0 : Φ (n - 1) V hV y = 0 := by
      apply hp1
      intro z
      have hz := hy ((Φ (n - 1) V hV).symm z)
      rw [hagree V hV, hβdef, AddEquiv.apply_symm_apply] at hz
      exact (AddEquiv.map_eq_zero_iff _).mp hz
    exact (AddEquiv.map_eq_zero_iff _).mp h0
  · intro y' hy'
    have h0 : Φ (n - 1) V hV y' = 0 := by
      apply hp2
      intro z
      have hz := hy' ((Φ (n - 1) V hV).symm z)
      rw [hagree V hV, hβdef, AddEquiv.apply_symm_apply] at hz
      exact (AddEquiv.map_eq_zero_iff _).mp hz
    exact (AddEquiv.map_eq_zero_iff _).mp h0

theorem wc_frobNbhd_geomFrob_equivariant (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (x : (wcP1Over K).left) (d : ℕ) (N : wcFrobNbhd K x d)
    (g : N.V ⟶ wcGeomPoint K (wcP1Over K) hP) :
    N.φ ≫ g = (fun k : N.V ⟶ wcGeomPoint K (wcP1Over K) hP =>
      k ≫ wcGeomFrob K (wcP1Over K) hP)^[d] g :=
by
  classical
  letI := N.ringA
  letI := N.hensA
  set ρ : AlgebraicClosure K →+* AlgebraicClosure K :=
    ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
      (AlgebraicClosure K) _ _ _).symm : AlgebraicClosure K →+* AlgebraicClosure K) with hρ

  have hσρ : ∀ y : AlgebraicClosure K, ρ y ^ Nat.card K = y := by
    intro y
    have h1 := @FiniteField.frobeniusAlgEquivOfAlgebraic_apply K _ (Fintype.ofFinite K)
      (AlgebraicClosure K) _ _ _
      ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
        (AlgebraicClosure K) _ _ _).symm y)
    rw [AlgEquiv.apply_symm_apply, Fintype.card_eq_nat_card] at h1
    exact h1.symm

  have s1 : ∀ (k : ℕ) (b : AlgebraicClosure K), ((⇑ρ)^[k] b) ^ (Nat.card K ^ k) = b := by
    intro k
    induction k with
    | zero => intro b; simp
    | succ k ih =>
      intro b
      rw [Function.iterate_succ_apply, pow_succ, pow_mul, ih, hσρ]

  haveI hcharK : CharP K (ringChar K) := ringChar.charP K
  have hpK : (ringChar K).Prime := CharP.char_is_prime K (ringChar K)
  haveI : Fact (ringChar K).Prime := ⟨hpK⟩

  have s3 : ∀ c : AlgebraicClosure K, ∃ r : ℕ, 1 ≤ r ∧ c ^ (ringChar K ^ r) = c := by
    intro c
    have hint : IsIntegral K c := Algebra.IsIntegral.isIntegral c
    haveI : FiniteDimensional K (IntermediateField.adjoin K {c}) :=
      IntermediateField.adjoin.finiteDimensional hint
    haveI : Finite (IntermediateField.adjoin K {c}) := Module.finite_of_finite K
    letI : Fintype (IntermediateField.adjoin K {c}) := Fintype.ofFinite _
    letI : Fintype K := Fintype.ofFinite K
    have h1 := FiniteField.pow_card
      (⟨c, IntermediateField.mem_adjoin_simple_self K c⟩ : IntermediateField.adjoin K {c})
    have h2 : c ^ Fintype.card (IntermediateField.adjoin K {c}) = c := by
      have := congrArg Subtype.val h1
      simpa using this
    obtain ⟨n, _, hn⟩ := FiniteField.card K (ringChar K)
    have hm : 0 < Module.finrank K (IntermediateField.adjoin K {c}) := Module.finrank_pos
    have h3 : Fintype.card (IntermediateField.adjoin K {c}) =
        ringChar K ^ ((n : ℕ) * Module.finrank K (IntermediateField.adjoin K {c})) := by
      rw [Fintype.card_eq_nat_card, Module.natCard_eq_pow_finrank (K := K), pow_mul, ← hn,
        Fintype.card_eq_nat_card]
    refine ⟨(n : ℕ) * Module.finrank K (IntermediateField.adjoin K {c}), ?_, ?_⟩
    · have := n.pos
      exact Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (by omega) hm.ne')
    · rw [← h3]; exact h2

  have s2 : ∀ [CharP N.A (ringChar K)] (r : ℕ), 1 ≤ r → ∀ u v : N.A,
      u ^ (ringChar K ^ r) = u → v ^ (ringChar K ^ r) = v →
      u - v ∈ IsLocalRing.maximalIdeal N.A → u = v := by
    intro _ r hr u v hu hv huv
    have hz : (u - v) ^ (ringChar K ^ r) = u - v := by rw [sub_pow_char_pow, hu, hv]
    have hQ : 2 ≤ ringChar K ^ r := by
      have := Nat.one_lt_pow (by omega : r ≠ 0) hpK.one_lt
      omega
    have hz2 : (1 - (u - v) ^ (ringChar K ^ r - 1)) * (u - v) = 0 := by
      have e : (u - v) ^ (ringChar K ^ r) = (u - v) ^ (ringChar K ^ r - 1) * (u - v) := by
        rw [← pow_succ]; congr 1; omega
      rw [sub_mul, one_mul, ← e, hz, sub_self]
    have hm : (u - v) ^ (ringChar K ^ r - 1) ∈ IsLocalRing.maximalIdeal N.A :=
      Ideal.pow_mem_of_mem _ huv _ (by omega)
    have hunit : IsUnit (1 - (u - v) ^ (ringChar K ^ r - 1)) :=
      IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ ((IsLocalRing.mem_maximalIdeal _).mp hm)
    exact sub_eq_zero.mp ((hunit.mul_right_eq_zero).mp hz2)

  have s5 : ∀ (τ : AlgebraicClosure K →+* N.A) (b : AlgebraicClosure K),
      N.ψ (τ b) = τ ((⇑ρ)^[d] b) := by
    intro τ b
    haveI : CharP N.A (ringChar K) := by
      rw [CharP.charP_iff_prime_eq_zero hpK]
      rw [← map_natCast τ, ← map_natCast (algebraMap K (AlgebraicClosure K)),
        CharP.cast_eq_zero, map_zero, map_zero]
    set c := (⇑ρ)^[d] b with hc
    have hcb : c ^ (Nat.card K ^ d) = b := s1 d b
    obtain ⟨r, hr, hcr⟩ := s3 c
    have hu : (N.ψ (τ b)) ^ (ringChar K ^ r) = N.ψ (τ b) := by
      rw [← map_pow, ← map_pow, ← hcb, pow_right_comm, hcr]
    have hv : (τ c) ^ (ringChar K ^ r) = τ c := by rw [← map_pow, hcr]
    have huv : N.ψ (τ b) - τ c ∈ IsLocalRing.maximalIdeal N.A := by
      rw [← hcb, map_pow, map_pow]
      exact N.hfrob (τ c)
    exact s2 r hr _ _ hu hv huv

  have hF : (wcGeomFrob K (wcP1Over K) hP).left ≫ Limits.pullback.snd (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
      Limits.pullback.snd (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ≫
        Spec.map (CommRingCat.ofHom ρ) :=
    Limits.pullback.lift_snd _ _ _
  have s4' : ∀ a : N.V ⟶ wcGeomPoint K (wcP1Over K) hP,
      (a ≫ wcGeomFrob K (wcP1Over K) hP).left ≫ Limits.pullback.snd (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
      a.left ≫ Limits.pullback.snd (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ≫
        Spec.map (CommRingCat.ofHom ρ) := fun a =>
    (Category.assoc a.left (wcGeomFrob K (wcP1Over K) hP).left _).trans
      (congrArg (a.left ≫ ·) hF)
  have z0 : ∀ {Y : Scheme.{u}} (h : Y ⟶ Limits.pullback (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))),
      h ≫ Limits.pullback.snd (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
      h ≫ Limits.pullback.snd (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ≫
        Spec.map (CommRingCat.ofHom (ρ ^ 0)) := by
    intro Y h
    rw [pow_zero]
    change _ = _ ≫ _ ≫ Spec.map (CommRingCat.ofHom (RingHom.id _))
    rw [CommRingCat.ofHom_id, Spec.map_id, Category.comp_id]
  have zs : ∀ (k : ℕ) {Y : Scheme.{u}} (h : Y ⟶ Limits.pullback (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))),
      (h ≫ Limits.pullback.snd (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ≫
        Spec.map (CommRingCat.ofHom (ρ ^ k))) ≫ Spec.map (CommRingCat.ofHom ρ) =
      h ≫ Limits.pullback.snd (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ≫
        Spec.map (CommRingCat.ofHom (ρ ^ (k + 1))) := by
    intro k Y h
    rw [Category.assoc, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, pow_succ,
      RingHom.mul_def]
  have s4 : ∀ k : ℕ, ((fun k' : N.V ⟶ wcGeomPoint K (wcP1Over K) hP =>
        k' ≫ wcGeomFrob K (wcP1Over K) hP)^[k] g).left ≫
        Limits.pullback.snd (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
      g.left ≫ Limits.pullback.snd (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ≫
        Spec.map (CommRingCat.ofHom (ρ ^ k)) := by
    intro k
    induction k with
    | zero => exact z0 g.left
    | succ k ih =>
      rw [Function.iterate_succ_apply']
      exact (s4' _).trans ((Category.assoc _ _ _).symm.trans
        ((congrArg (· ≫ Spec.map (CommRingCat.ofHom ρ)) ih).trans (zs k g.left)))

  have key : ∀ {Y : Scheme.{u}} (e : Y ≅ Spec (.of N.A)) (φl : Y ⟶ Y)
      (gl : Y ⟶ Limits.pullback (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))),
      e.inv ≫ φl ≫ e.hom = Spec.map (CommRingCat.ofHom N.ψ) →
      e.inv ≫ (φl ≫ gl) ≫ Limits.pullback.snd (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
        e.inv ≫ gl ≫ Limits.pullback.snd (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ≫
          Spec.map (CommRingCat.ofHom (ρ ^ d)) := by
    intro Y e φl gl hψ
    have hψ' : Spec.map (CommRingCat.ofHom N.ψ) ≫ e.inv = e.inv ≫ φl := by
      rw [← hψ]
      simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]
    obtain ⟨T, hT⟩ : ∃ T : CommRingCat.of (AlgebraicClosure K) ⟶ CommRingCat.of N.A,
        Spec.map T = e.inv ≫ gl ≫ Limits.pullback.snd (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :=
      ⟨Spec.preimage _, Spec.map_preimage _⟩
    have hTring : T ≫ CommRingCat.ofHom N.ψ = CommRingCat.ofHom (ρ ^ d) ≫ T := by
      ext b
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
        Function.comp_apply]
      rw [RingHom.coe_pow]
      exact s5 T.hom b
    have eL : Spec.map (T ≫ CommRingCat.ofHom N.ψ) =
        e.inv ≫ (φl ≫ gl) ≫ Limits.pullback.snd (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) := by
      rw [Spec.map_comp, hT, ← Category.assoc, hψ']
      simp only [Category.assoc]
    have eR : Spec.map (CommRingCat.ofHom (ρ ^ d) ≫ T) =
        e.inv ≫ gl ≫ Limits.pullback.snd (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ≫
          Spec.map (CommRingCat.ofHom (ρ ^ d)) := by
      rw [Spec.map_comp, hT]
      simp only [Category.assoc]
    rw [← eL, ← eR, hTring]

  apply MorphismProperty.Over.Hom.ext
  refine Limits.pullback.hom_ext (f := (wcP1Over K).hom)
    (g := Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ?_ ?_
  · have hw : ∀ a : N.V ⟶ wcGeomPoint K (wcP1Over K) hP,
        a.left ≫ Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) = N.V.hom :=
      fun a => MorphismProperty.Over.w a
    exact (hw (N.φ ≫ g)).trans (hw _).symm
  · refine Eq.trans ?_ (s4 d).symm
    apply (cancel_epi N.e.inv).mp
    exact key N.e N.φ.left g.left N.hψ

theorem wc_pencil_geomOffS_lift (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (V : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A] [IsLocalRing A]
    (e : V.left ≅ Spec (.of A))
    (hoff : ∀ i, V.hom (e.inv (IsLocalRing.closedPoint A)) ≠ D.S i (IsLocalRing.closedPoint F''))
    (g : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP) :
    ∃ h : V ⟶ wcPencilGeomOffS D hP,
      h ≫ wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D)
        (wcGeomPoint F'' (wcP1Over F'') hP) = g :=
by
  classical
  have hh : g.left ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom = V.hom := MorphismProperty.Over.w g
  have hSig := (wc_P1_sections_closed_generize F'' D.m D.S D.hS).1
  have hspec : ∀ v : V.left, V.hom v ⤳ V.hom (e.inv (IsLocalRing.closedPoint A)) := by
    intro v
    have h1 : e.hom v ⤳ IsLocalRing.closedPoint A := IsLocalRing.specializes_closedPoint _
    have h2 := (h1.map e.inv.continuous).map V.hom.continuous
    have h3 : e.inv (e.hom v) = v := by
      rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]; rfl
    rwa [h3] at h2
  have hO : ∀ v : V.left, V.hom v ∈ wcPencilSOpen D := by
    intro v
    show V.hom v ∈ (⋃ i, closure {D.S i (IsLocalRing.closedPoint F'')})ᶜ
    simp only [Set.mem_compl_iff, Set.mem_iUnion, not_exists]
    intro i hmem
    have hc := (hspec v).mem_closed isClosed_closure hmem
    have hsub : closure {D.S i (IsLocalRing.closedPoint F'')} ⊆
        {p | ∃ j, p = D.S j (IsLocalRing.closedPoint F'')} :=
      closure_minimal (Set.singleton_subset_iff.mpr ⟨i, rfl⟩) hSig
    obtain ⟨j, hj⟩ := hsub hc
    exact hoff j hj
  have hrange : Set.range V.hom ⊆ Set.range (wcPencilSOpen D).ι := by
    rintro _ ⟨v, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact hO v
  let u := IsOpenImmersion.lift (wcPencilSOpen D).ι V.hom hrange
  have hu : u ≫ (wcPencilSOpen D).ι = V.hom := IsOpenImmersion.lift_fac _ _ _
  let k := Limits.pullback.lift u g.left (hu.trans hh.symm)
  have hk : k ≫ (Limits.pullback.snd (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom ≫
      (wcGeomPoint F'' (wcP1Over F'') hP).hom) = V.hom := by
    rw [Limits.pullback.lift_snd_assoc, hh]
  refine ⟨MorphismProperty.Over.homMk k hk trivial, ?_⟩
  apply MorphismProperty.Over.Hom.ext
  exact Limits.pullback.lift_snd _ _ _

theorem wc_pencil_geomOffS_frob (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∃ Fb : wcPencilGeomOffS D hP ⟶ wcPencilGeomOffS D hP,
      Fb ≫ wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D) (wcGeomPoint F'' (wcP1Over F'') hP) =
        wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D) (wcGeomPoint F'' (wcP1Over F'') hP) ≫
          wcGeomFrob F'' (wcP1Over F'') hP ∧
      ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ wcPencilGeomOffS D hP),
        a ≫ wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D) (wcGeomPoint F'' (wcP1Over F'') hP) =
          b ≫ wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D) (wcGeomPoint F'' (wcP1Over F'') hP) →
        a = b :=
by
  let O := wcPencilSOpen D
  let P := wcGeomPoint F'' (wcP1Over F'') hP
  let Fr := wcGeomFrob F'' (wcP1Over F'') hP
  have hw : Fr.left ≫ P.hom = P.hom := MorphismProperty.Over.w Fr
  have hc : Limits.pullback.fst O.ι P.hom ≫ O.ι =
      (Limits.pullback.snd O.ι P.hom ≫ Fr.left) ≫ P.hom := by
    rw [Category.assoc, hw]
    exact Limits.pullback.condition
  let Fbl : Limits.pullback O.ι P.hom ⟶ Limits.pullback O.ι P.hom :=
    Limits.pullback.lift (Limits.pullback.fst O.ι P.hom)
      (Limits.pullback.snd O.ι P.hom ≫ Fr.left) hc
  have hK : Fbl ≫ Limits.pullback.snd O.ι P.hom = Limits.pullback.snd O.ι P.hom ≫ Fr.left :=
    Limits.pullback.lift_snd _ _ _
  have hov : Fbl ≫ (Limits.pullback.snd O.ι P.hom ≫ P.hom) =
      Limits.pullback.snd O.ι P.hom ≫ P.hom := by
    rw [← Category.assoc, hK, Category.assoc, hw]
  let Fb : wcPencilGeomOffS D hP ⟶ wcPencilGeomOffS D hP :=
    MorphismProperty.Over.homMk Fbl hov trivial
  refine ⟨Fb, ?_, ?_⟩
  · apply MorphismProperty.Over.Hom.ext
    exact hK
  · intro V a b hab
    have h1 : a.left ≫ Limits.pullback.snd O.ι P.hom = b.left ≫ Limits.pullback.snd O.ι P.hom :=
      congrArg (fun t => t.left) hab
    apply MorphismProperty.Over.Hom.ext
    exact (cancel_mono (Limits.pullback.snd O.ι P.hom)).mp h1

theorem wc_pencil_geomOffS_connected (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ConnectedSpace (wcPencilGeomOffS D hP).left :=
by
  obtain ⟨Ub, hUb, hUbc, -, -, -⟩ := wc_P1bar_smooth_locus F'' hP D.m D.S D.hS
  have hSig := (wc_P1_sections_closed_generize F'' D.m D.S D.hS).1
  have hO : ∀ p : (wcP1Over F'').left, p ∈ ((wcPencilSOpen D : (wcP1Over F'').left.Opens) :
      Set (wcP1Over F'').left) ↔ ∀ i, p ≠ D.S i (IsLocalRing.closedPoint F'') := by
    intro p
    show p ∈ (⋃ i, closure {D.S i (IsLocalRing.closedPoint F'')})ᶜ ↔ _
    rw [Set.mem_compl_iff, Set.mem_iUnion]
    constructor
    · intro h i hpi
      exact h ⟨i, by rw [hpi]; exact subset_closure (Set.mem_singleton _)⟩
    · rintro h ⟨i, hi⟩
      have hsub : closure {D.S i (IsLocalRing.closedPoint F'')} ⊆
          {p : (wcP1Over F'').left | ∃ i : Fin D.m, p = D.S i (IsLocalRing.closedPoint F'')} :=
        closure_minimal (fun q hq => ⟨i, hq⟩) hSig
      obtain ⟨k, hk⟩ := hsub hi
      exact h k hk
  change ConnectedSpace
    ↥(Limits.pullback (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom)
  have hrange : Set.range
      (Limits.pullback.snd (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom) =
      (Ub : Set (wcGeomPoint F'' (wcP1Over F'') hP).left) := by
    rw [Scheme.Pullback.range_snd, Scheme.Opens.range_ι]
    ext q
    rw [Set.mem_preimage, hO, SetLike.mem_coe, hUb]
  have hUconn : _root_.IsConnected (Ub : Set (wcGeomPoint F'' (wcP1Over F'') hP).left) := by
    rw [← Scheme.Opens.range_ι Ub]
    exact isConnected_range Ub.ι.continuous
  rw [← hrange] at hUconn
  have hind : Topology.IsInducing
      (Limits.pullback.snd (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom) :=
    (Limits.pullback.snd (wcPencilSOpen D).ι
      (wcGeomPoint F'' (wcP1Over F'') hP).hom).isOpenEmbedding.isEmbedding.isInducing
  have hpre : _root_.IsPreconnected (Set.univ :
      Set ↥(Limits.pullback (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom)) := by
    rw [← hind.isPreconnected_image, Set.image_univ]
    exact hUconn.isPreconnected
  haveI : Nonempty
      ↥(Limits.pullback (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom) :=
    Set.range_nonempty_iff_nonempty.mp hUconn.nonempty
  exact connectedSpace_iff_univ.mpr ⟨Set.univ_nonempty, hpre⟩

theorem wc_proet_frob_line_transport (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (σ : ℚ_[ℓ] → (G ⟶ G))
    (hσ1 : σ 1 = 𝟙 G) (hσm : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (B V₀ V : S.ProEt) (Fb : B ⟶ B) (h₀ : V₀ ⟶ B) (h : V ⟶ B) (φ₀ : V₀ ⟶ V₀) (φ : V ⟶ V)
    (d : ℕ) (hφ₀ : φ₀ ≫ h₀ = h₀ ≫ Fb) (hφ : φ ≫ h = (fun k : V ⟶ B => k ≫ Fb)^[d] h)
    (hb₀ : Function.Bijective (G.obj.map h₀.op).hom) (hb : Function.Bijective (G.obj.map h.op).hom)
    (μ : ℚ_[ℓ]) (e₀ : G.obj.obj (Opposite.op V₀) ≃+ (Fin 1 → ℚ_[ℓ]))
    (he₀ : ∀ (c : ℚ_[ℓ]) (t : G.obj.obj (Opposite.op V₀)),
      e₀ (((σ c).hom.app (Opposite.op V₀)).hom t) = c • e₀ t)
    (hμ : ∀ t : G.obj.obj (Opposite.op V₀),
      (G.obj.map φ₀.op).hom t = ((σ μ).hom.app (Opposite.op V₀)).hom t) :
    ∃ e : G.obj.obj (Opposite.op V) ≃+ (Fin 1 → ℚ_[ℓ]),
      (∀ (c : ℚ_[ℓ]) (t : G.obj.obj (Opposite.op V)),
        e (((σ c).hom.app (Opposite.op V)).hom t) = c • e t) ∧
      ∀ t : G.obj.obj (Opposite.op V),
        (G.obj.map φ.op).hom t = ((σ (μ ^ d)).hom.app (Opposite.op V)).hom t :=
by

  have F1 : ∀ {X Y Z : S.ProEt} (a : X ⟶ Y) (b : Y ⟶ Z) (z : G.obj.obj (Opposite.op Z)),
      (G.obj.map (a ≫ b).op).hom z = (G.obj.map a.op).hom ((G.obj.map b.op).hom z) := by
    intro X Y Z a b z
    rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp]
    rfl

  have F2 : ∀ {X Y : S.ProEt} (a : X ⟶ Y) (c : ℚ_[ℓ]) (y : G.obj.obj (Opposite.op Y)),
      ((σ c).hom.app (Opposite.op X)).hom ((G.obj.map a.op).hom y) =
        (G.obj.map a.op).hom (((σ c).hom.app (Opposite.op Y)).hom y) := by
    intro X Y a c y
    have hn := congrArg (fun f => f.hom y) ((σ c).hom.naturality a.op)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at hn
    first
      | exact hn
      | exact hn.symm

  have F3 : ∀ {X : S.ProEt} (y : G.obj.obj (Opposite.op X)),
      ((σ 1).hom.app (Opposite.op X)).hom y = y := by
    intro X y
    rw [hσ1]
    rfl

  have F4 : ∀ {X : S.ProEt} (a b : ℚ_[ℓ]) (y : G.obj.obj (Opposite.op X)),
      ((σ (a * b)).hom.app (Opposite.op X)).hom y =
        ((σ a).hom.app (Opposite.op X)).hom (((σ b).hom.app (Opposite.op X)).hom y) := by
    intro X a b y
    rw [hσm]
    rfl

  have s2 : ∀ c : G.obj.obj (Opposite.op B),
      (G.obj.map Fb.op).hom c = ((σ μ).hom.app (Opposite.op B)).hom c := by
    intro c
    apply hb₀.1
    rw [← F1, ← hφ₀, F1, hμ, F2]

  have s3 : ∀ (k : ℕ) (c : G.obj.obj (Opposite.op B)),
      (G.obj.map ((fun k : V ⟶ B => k ≫ Fb)^[k] h).op).hom c =
        (G.obj.map h.op).hom (((σ (μ ^ k)).hom.app (Opposite.op B)).hom c) := by
    intro k
    induction k with
    | zero =>
      intro c
      rw [pow_zero, F3]
      rfl
    | succ k ih =>
      intro c
      rw [Function.iterate_succ_apply']
      beta_reduce
      rw [F1, s2, ih, pow_succ, F4]

  have s4 : ∀ t : G.obj.obj (Opposite.op V),
      (G.obj.map φ.op).hom t = ((σ (μ ^ d)).hom.app (Opposite.op V)).hom t := by
    intro t
    obtain ⟨c, rfl⟩ := hb.2 t
    rw [← F1, hφ, s3, F2]

  let eh := AddEquiv.ofBijective (G.obj.map h.op).hom hb
  let eh₀ := AddEquiv.ofBijective (G.obj.map h₀.op).hom hb₀
  refine ⟨eh.symm.trans (eh₀.trans e₀), ?_, s4⟩
  intro c t
  obtain ⟨b, rfl⟩ := hb.2 t
  have key : ∀ x, eh.symm ((G.obj.map h.op).hom x) = x := fun x => eh.symm_apply_apply x
  simp only [AddEquiv.trans_apply]
  rw [F2, key, key]
  show e₀ ((G.obj.map h₀.op).hom (((σ c).hom.app (Opposite.op B)).hom b)) =
    c • e₀ ((G.obj.map h₀.op).hom b)
  rw [← F2, he₀]

theorem wc_pencil_R2_frob_nbhd_line (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'') :
    ∀ d : ℕ, 1 ≤ d → ∀ x ∈ wcP1ClosedPt F'' d, (∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) →
    ∀ N : wcFrobNbhd F'' x d,
    ∃ tr : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (2 * (n - 1))) 0 ≃+
        (Fin 1 → ℚ_[ℓ]),
      (∀ (c : ℚ_[ℓ]) (t : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
          (wcRq D.f ℓ (2 * (n - 1))) 0),
        tr ((Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (2 * (n - 1)) c)).postcomp
          (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) t) = c • tr t) ∧
      (∀ t : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (2 * (n - 1))) 0,
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left N.φ)).precomp
            (wcRq D.f ℓ (2 * (n - 1))) (zero_add 0) t =
          (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (2 * (n - 1))
            ((Nat.card F'' : ℚ_[ℓ]) ^ ((n - 1) * d)))).postcomp
            (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) t) :=
by
  classical
  intro d hd x hx hS N
  letI := N.ringA
  letI := N.hensA
  letI := N.sepA

  have hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  have hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')

  obtain ⟨ev, hpost, hpre⟩ := wc_free_ext0_eval (wcP1Over F'').left
  obtain ⟨r, ⟨θ⟩⟩ := wc_pencil_R2_geomConst_offS F' F'' Y n hn hn2 D ℓ hℓ hP
  obtain ⟨Fb, hFb, hcancel⟩ := wc_pencil_geomOffS_frob F' F'' Y n D hP
  have hB := wc_pencil_geomOffS_connected F' F'' Y n D hP
  have hσ1 : wcRqScalar D.f ℓ (2 * (n - 1)) 1 = 𝟙 _ := by
    unfold wcRqScalar
    rw [(wc_ladic_scalar_ring _ ℓ).1]
    exact CategoryTheory.Functor.map_id _ _
  have hσm : ∀ a b : ℚ_[ℓ], wcRqScalar D.f ℓ (2 * (n - 1)) (a * b) =
      wcRqScalar D.f ℓ (2 * (n - 1)) b ≫ wcRqScalar D.f ℓ (2 * (n - 1)) a := by
    intro a b
    unfold wcRqScalar
    rw [(wc_ladic_scalar_ring _ ℓ).2.1 a b]
    exact CategoryTheory.Functor.map_comp _ _ _
  have hevs : ∀ (V : (wcP1Over F'').left.ProEt) (c : ℚ_[ℓ])
      (t : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op V)),
      (ev V (wcRq D.f ℓ (2 * (n - 1)))).symm
          (((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op V)).hom t) =
        (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (2 * (n - 1)) c)).postcomp
          (wcFreeSheaf (wcP1Over F'').left V) (add_zero 0)
          ((ev V (wcRq D.f ℓ (2 * (n - 1)))).symm t) := by
    intro V c t
    apply (ev V (wcRq D.f ℓ (2 * (n - 1)))).injective
    rw [AddEquiv.apply_symm_apply, hpost, AddEquiv.apply_symm_apply]

  obtain ⟨V₀, g₀, φ₀, A₀, iA₀, hA₀, sA₀, e₀', ε, hv, hφg, hε, hεφ⟩ :=
    wc_P1bar_strict_local_nbhd F'' D.u0 D.hu0 hP
  obtain ⟨hGI, hPr, hSm⟩ := wc_pencil_fibre_props F' F'' Y n hn2 D
  haveI : GeometricallyIrreducible (Over.mk (Limits.pullback.snd D.f D.u0)).hom := hGI
  haveI : IsProper (Over.mk (Limits.pullback.snd D.f D.u0)).hom := hPr
  haveI : SmoothOfRelativeDimension (n - 1) (Over.mk (Limits.pullback.snd D.f D.u0)).hom := hSm
  obtain ⟨Ψ, hΨb, hΨs, hΨf⟩ := wc_pencil_strict_nbhd_sections_pbc F' F'' Y n hn2 D ℓ hℓ hX
    (2 * (n - 1)) V₀ φ₀ A₀ e₀' ε hv hε hεφ
  obtain ⟨⟨e₁, he₁⟩, hfr⟩ :=
    wc_top_coh_frobenius F'' (Over.mk (Limits.pullback.snd D.f D.u0)) (n - 1) ℓ hℓ hX
  have hμExt : ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ (2 * (n - 1))) 0,
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ₀)).comp y (zero_add 0) =
        y.comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (2 * (n - 1))
          ((Nat.card F'' : ℚ_[ℓ]) ^ (n - 1)))) (add_zero 0) := by
    intro y
    apply hΨb.1
    rw [hΨf, hΨs, hfr]
  have hμ : ∀ t : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op V₀),
      ((wcRq D.f ℓ (2 * (n - 1))).obj.map φ₀.op).hom t =
        ((wcRqScalar D.f ℓ (2 * (n - 1)) ((Nat.card F'' : ℚ_[ℓ]) ^ (n - 1))).hom.app
          (Opposite.op V₀)).hom t := by
    intro t
    obtain ⟨y, rfl⟩ := (ev V₀ (wcRq D.f ℓ (2 * (n - 1)))).surjective t
    rw [← hpre, ← hpost]
    congr 1
    exact hμExt y
  let E₀ : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op V₀) ≃+ (Fin 1 → ℚ_[ℓ]) :=
    (ev V₀ (wcRq D.f ℓ (2 * (n - 1)))).symm.trans ((AddEquiv.ofBijective Ψ hΨb).trans e₁)
  have hE₀ : ∀ (c : ℚ_[ℓ]) (t : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op V₀)),
      E₀ (((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op V₀)).hom t) = c • E₀ t := by
    intro c t
    have h1 := hΨs c ((ev V₀ (wcRq D.f ℓ (2 * (n - 1)))).symm t)
    have h2 := he₁ c (Ψ ((ev V₀ (wcRq D.f ℓ (2 * (n - 1)))).symm t))
    simp only [E₀, AddEquiv.trans_apply, AddEquiv.ofBijective_apply, hevs]
    rw [← h2, ← h1]
    rfl
  obtain ⟨h₀, hh₀⟩ := wc_pencil_geomOffS_lift F' F'' Y n D hP V₀ A₀ e₀'
    (fun i => by rw [hv]; exact D.hu0S i) g₀
  have hh₀φ : φ₀ ≫ h₀ = h₀ ≫ Fb := by
    apply hcancel
    simp only [Category.assoc]
    rw [hh₀, hφg, hFb, ← Category.assoc, hh₀]
  have hb₀ : Function.Bijective ((wcRq D.f ℓ (2 * (n - 1))).obj.map h₀.op).hom :=
    ⟨wc_proet_geomConst_restrict_injective _ ℓ (wcRq D.f ℓ (2 * (n - 1)))
        (wcPencilGeomOffS D hP) V₀ h₀ r θ hB ⟨e₀'.inv (IsLocalRing.closedPoint A₀)⟩,
      fun w => wc_proet_geomConst_section_of_local _ ℓ (wcRq D.f ℓ (2 * (n - 1)))
        (wcPencilGeomOffS D hP) V₀ h₀ A₀ e₀' r θ w⟩

  obtain ⟨h⟩ := wc_P1_strict_local_offS_map F' F'' Y n D hP N.V N.A N.e
    (fun i => by rw [N.hx]; exact hS i)
  have h1 := wc_frobNbhd_geomFrob_equivariant F'' hP x d N
    (h ≫ wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D) (wcGeomPoint F'' (wcP1Over F'') hP))
  have hit : ∀ k : ℕ,
      (fun k' : N.V ⟶ wcGeomPoint F'' (wcP1Over F'') hP =>
        k' ≫ wcGeomFrob F'' (wcP1Over F'') hP)^[k]
          (h ≫ wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D)
            (wcGeomPoint F'' (wcP1Over F'') hP)) =
        ((fun k' : N.V ⟶ wcPencilGeomOffS D hP => k' ≫ Fb)^[k] h) ≫
          wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D)
            (wcGeomPoint F'' (wcP1Over F'') hP) := by
    intro k
    induction k with
    | zero => rfl
    | succ k ih =>
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih, Category.assoc,
        Category.assoc, hFb]
  have hhφ : N.φ ≫ h = (fun k' : N.V ⟶ wcPencilGeomOffS D hP => k' ≫ Fb)^[d] h := by
    apply hcancel
    rw [Category.assoc, h1, hit]
  have hb : Function.Bijective ((wcRq D.f ℓ (2 * (n - 1))).obj.map h.op).hom :=
    ⟨wc_proet_geomConst_restrict_injective _ ℓ (wcRq D.f ℓ (2 * (n - 1)))
        (wcPencilGeomOffS D hP) N.V h r θ hB ⟨N.e.inv (IsLocalRing.closedPoint N.A)⟩,
      fun w => wc_proet_geomConst_section_of_local _ ℓ (wcRq D.f ℓ (2 * (n - 1)))
        (wcPencilGeomOffS D hP) N.V h N.A N.e r θ w⟩

  obtain ⟨E, hEs, hEf⟩ := wc_proet_frob_line_transport (wcP1Over F'').left ℓ
    (wcRq D.f ℓ (2 * (n - 1))) (wcRqScalar D.f ℓ (2 * (n - 1))) hσ1 hσm
    (wcPencilGeomOffS D hP) V₀ N.V Fb h₀ h φ₀ N.φ d hh₀φ hhφ hb₀ hb
    ((Nat.card F'' : ℚ_[ℓ]) ^ (n - 1)) E₀ hE₀ hμ

  refine ⟨(ev N.V (wcRq D.f ℓ (2 * (n - 1)))).trans E, ?_, ?_⟩
  · intro c t
    simp only [AddEquiv.trans_apply]
    rw [hpost, hEs]
  · intro t
    apply (ev N.V (wcRq D.f ℓ (2 * (n - 1)))).injective
    rw [hpre, hpost, hEf, ← pow_mul]

theorem wc_pencil_E_hom_const_zero_offS (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n) (hNM : wcPencilNoMixed D)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∀ φ : (Subobject.underlying.obj (wcPencilE D ℓ hP)).over (wcPencilGeomOffS D hP) ⟶
        (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).over (wcPencilGeomOffS D hP),
      φ = 0 :=
by
  classical
  intro φ

  haveI hsub : Subsingleton (Spec (.of F'')) := by
    show Subsingleton (PrimeSpectrum F''); infer_instance
  have hpt : ∀ i, IsClosed ({D.S i (IsLocalRing.closedPoint F'')} : Set (wcP1Over F'').left) := by
    intro i
    haveI := isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)
    have hr : IsClosed (Set.range (D.S i)) := (D.S i).isClosedEmbedding.isClosed_range
    have e : Set.range (D.S i) = {D.S i (IsLocalRing.closedPoint F'')} := by
      ext x
      simp only [Set.mem_range, Set.mem_singleton_iff]
      constructor
      · rintro ⟨p, rfl⟩; rw [Subsingleton.elim p (IsLocalRing.closedPoint F'')]
      · rintro rfl; exact ⟨_, rfl⟩
    rw [← e]; exact hr

  let Zs : Finset (wcP1Over F'').left :=
    Finset.univ.image (fun i => D.S i (IsLocalRing.closedPoint F''))
  have hZ : ∀ z ∈ Zs, IsClosed ({z} : Set (wcP1Over F'').left) := by
    intro z hz
    obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hz
    exact hpt i
  have hO : ((wcPencilSOpen D : (wcP1Over F'').left.Opens) : Set (wcP1Over F'').left) =
      ((Zs : Set (wcP1Over F'').left))ᶜ := by
    show (⋃ i, closure {D.S i (IsLocalRing.closedPoint F'')})ᶜ = _
    congr 1
    ext p
    simp only [Set.mem_iUnion, Zs, Finset.coe_image, Finset.coe_univ, Set.image_univ,
      Set.mem_range]
    constructor
    · rintro ⟨i, hi⟩
      rw [(hpt i).closure_eq] at hi
      exact ⟨i, (Set.mem_singleton_iff.mp hi).symm⟩
    · rintro ⟨i, rfl⟩
      exact ⟨i, subset_closure rfl⟩

  have hrange : ∀ (T : (wcP1Over F'').left.ProEt) (x : T.left),
      T.hom x ∈ ((wcPencilSOpen D : (wcP1Over F'').left.Opens) : Set (wcP1Over F'').left) →
      ∃ y : (wcOpenRestr (wcP1Over F'').left (wcPencilSOpen D) T).left,
        (wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D) T).left y = x := by
    intro T x hx
    have h1 : x ∈ Set.range (Limits.pullback.snd (wcPencilSOpen D).ι T.hom) := by
      rw [IsOpenImmersion.range_pullbackSnd, Scheme.Opens.opensRange_ι]
      exact hx
    obtain ⟨y, hy⟩ := h1
    exact ⟨y, hy⟩

  obtain ⟨η, hη, hne⟩ : ∃ η : (wcP1Over F'').left, (∀ x : (wcP1Over F'').left, η ⤳ x) ∧
      ∃ x : (wcP1Over F'').left, x ≠ η := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') :=
      MvPolynomial.gradedAlgebra
    change ∃ η : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F''),
      (∀ x, η ⤳ x) ∧ ∃ x, x ≠ η
    have hprime : (⊥ : HomogeneousIdeal
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'')).toIdeal.IsPrime := by
      rw [HomogeneousIdeal.toIdeal_bot]
      exact Ideal.isPrime_bot
    have hX : ∀ j : Fin (1 + 1), MvPolynomial.X j ∈
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') :=
      fun j => HomogeneousIdeal.mem_irrelevant_of_mem
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') (i := 1) Nat.one_pos
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X F'' j))
    have hirr : ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'')
        ≤ ⊥ := by
      intro h
      have h0 := h (hX 0)
      rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at h0
      exact MvPolynomial.X_ne_zero (0 : Fin (1 + 1)) h0
    let η : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') :=
      ⟨⊥, hprime, hirr⟩
    let J : Ideal (MvPolynomial (Fin (1 + 1)) F'') := Ideal.span {MvPolynomial.X 0}
    have hJh : J.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') := by
      apply Ideal.homogeneous_span
      intro y hy
      rw [Set.mem_singleton_iff] at hy
      subst hy
      exact ⟨1, (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X F'' 0)⟩
    let I := Ideal.homogeneousHull (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') J
    have hI : I.toIdeal = J := hJh.toIdeal_homogeneousHull_eq_self
    have hIprime : I.toIdeal.IsPrime := by
      rw [hI]
      exact (Ideal.span_singleton_prime (MvPolynomial.X_ne_zero 0)).mpr MvPolynomial.X_prime
    have hIirr : ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'')
        ≤ I := by
      intro h
      have h1 := h (hX 1)
      rw [← HomogeneousIdeal.mem_iff, hI, Ideal.mem_span_singleton] at h1
      obtain ⟨c, hc⟩ := h1
      have := congrArg (MvPolynomial.eval ![(0 : F''), 1]) hc
      simp at this
    let x : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') :=
      ⟨I, hIprime, hIirr⟩
    refine ⟨η, fun y => ?_, x, ?_⟩
    · apply specializes_iff_mem_closure.mpr
      apply (ProjectiveSpectrum.le_iff_mem_closure _ η y).mp
      apply (ProjectiveSpectrum.as_ideal_le_as_ideal _ η y).mp
      exact bot_le
    · intro hxη
      have e : I = ⊥ := congrArg ProjectiveSpectrum.asHomogeneousIdeal hxη
      have h0 : MvPolynomial.X 0 ∈ I.toIdeal := by
        rw [hI]; exact Ideal.mem_span_singleton_self _
      rw [e, HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at h0
      exact MvPolynomial.X_ne_zero (0 : Fin (1 + 1)) h0
  have hetaS : η ∉ {p : (wcP1Over F'').left | ∃ i : Fin D.m, p = D.S i (IsLocalRing.closedPoint F'')} := by
    rintro ⟨i, hi⟩
    obtain ⟨x, hx⟩ := hne
    have hxm : x ∈ ({D.S i (IsLocalRing.closedPoint F'')} : Set (wcP1Over F'').left) :=
      (hη x).mem_closed (hpt i) (by rw [Set.mem_singleton_iff]; exact hi)
    exact hx ((Set.mem_singleton_iff.mp hxm).trans hi.symm)
  have hgenS : ∀ (T : (wcP1Over F'').left.ProEt) (t : T.left),
      T.hom t ∈ {p : (wcP1Over F'').left | ∃ i : Fin D.m, p = D.S i (IsLocalRing.closedPoint F'')} →
      ∃ t' : T.left, t' ⤳ t ∧
        T.hom t' ∉ {p : (wcP1Over F'').left | ∃ i : Fin D.m, p = D.S i (IsLocalRing.closedPoint F'')} := by
    intro T t _
    haveI : WeaklyEtale T.hom := T.prop
    obtain ⟨t', ht', hpt'⟩ := Flat.generalizingMap T.hom (hη (T.hom t))
    refine ⟨t', ht', ?_⟩
    rw [show T.hom t' = η from hpt']
    exact hetaS
  have hOmem : ∀ p : (wcP1Over F'').left,
      p ∉ {p : (wcP1Over F'').left | ∃ i : Fin D.m, p = D.S i (IsLocalRing.closedPoint F'')} →
      p ∈ ((wcPencilSOpen D : (wcP1Over F'').left.Opens) : Set (wcP1Over F'').left) := by
    intro p hp
    rw [hO]
    intro hpZ
    apply hp
    obtain ⟨i, _, hi⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hpZ)
    exact ⟨i, hi.symm⟩
  have hgen : ∀ (T : (wcP1Over F'').left.ProEt) (x : T.left),
      ∃ y : (wcOpenRestr (wcP1Over F'').left (wcPencilSOpen D) T).left,
        (wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D) T).left y ⤳ x := by
    intro T x
    by_cases hx : T.hom x ∈
        {p : (wcP1Over F'').left | ∃ i : Fin D.m, p = D.S i (IsLocalRing.closedPoint F'')}
    · obtain ⟨t', ht', hnot⟩ := hgenS T x hx
      obtain ⟨y, hy⟩ := hrange T t' (hOmem _ hnot)
      exact ⟨y, by rw [hy]; exact ht'⟩
    · obtain ⟨y, hy⟩ := hrange T x (hOmem _ hx)
      exact ⟨y, by rw [hy]⟩

  have hloc := wc_P1_proet_open_local_clopen F'' (wcPencilSOpen D) Zs hZ hO

  have s4 : ∀ {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y] (ι : Y → X),
      Continuous ι → (∀ x : X, ∃ y : Y, ι y ⤳ x) →
      (∀ x : X, ∃ U : Set X, IsOpen U ∧ x ∈ U ∧ ∀ C : Set Y, C ⊆ ι ⁻¹' U → IsOpen C →
          IsOpen (ι ⁻¹' U \ C) → ∃ W : Set X, W ⊆ U ∧ IsOpen W ∧ IsOpen (U \ W) ∧
            ι ⁻¹' W = C) →
      ∀ f : C(Y, ℚ_[ℓ]), ∃ F : C(X, ℚ_[ℓ]), ∀ y, F (ι y) = f y := by
    intro X Y _ _ ι hι hg hl f
    have L : ∀ (y : Y) (x : X), ι y ⤳ x → ∀ ε > 0, ∃ W : Set X, IsOpen W ∧ x ∈ W ∧
        ∀ y', ι y' ∈ W → dist (f y') (f y) < ε := by
      intro y x hyx ε hε
      obtain ⟨U, hU, hxU, hex⟩ := hl x
      have hB := IsUltrametricDist.isClopen_ball (f y) ε
      have hdiff : ι ⁻¹' U \ (f ⁻¹' Metric.ball (f y) ε ∩ ι ⁻¹' U) =
          ι ⁻¹' U ∩ f ⁻¹' (Metric.ball (f y) ε)ᶜ := by
        ext z
        simp only [Set.mem_diff, Set.mem_inter_iff, Set.mem_preimage, Set.mem_compl_iff]
        tauto
      obtain ⟨W, _, hW, hUW, hWC⟩ := hex (f ⁻¹' Metric.ball (f y) ε ∩ ι ⁻¹' U)
        Set.inter_subset_right
        ((hB.isOpen.preimage f.continuous).inter (hU.preimage hι))
        (by rw [hdiff]; exact (hU.preimage hι).inter (hB.compl.isOpen.preimage f.continuous))
      refine ⟨W, hW, ?_, ?_⟩
      · by_contra hxW
        have h1 : ι y ∈ U \ W := hyx.mem_open hUW ⟨hxU, hxW⟩
        have h2 : y ∈ ι ⁻¹' W := by
          rw [hWC]
          exact ⟨Metric.mem_ball_self hε, h1.1⟩
        exact h1.2 h2
      · intro y' hy'
        have h2 : y' ∈ ι ⁻¹' W := hy'
        rw [hWC] at h2
        exact h2.1
    have wd : ∀ (y₁ y₂ : Y) (x : X), ι y₁ ⤳ x → ι y₂ ⤳ x → f y₁ = f y₂ := by
      intro y₁ y₂ x h1 h2
      refine (eq_of_forall_dist_le fun ε hε => ?_).symm
      obtain ⟨W, hW, hxW, hb⟩ := L y₁ x h1 ε hε
      exact (hb y₂ (h2.mem_open hW hxW)).le
    choose g hgx using hg
    refine ⟨⟨fun x => f (g x), ?_⟩, fun y => wd _ _ _ (hgx (ι y)) (specializes_refl _)⟩
    rw [Metric.continuous_iff']
    intro a ε hε
    obtain ⟨W, hW, haW, hb⟩ := L (g a) a (hgx a) ε hε
    filter_upwards [hW.mem_nhds haW] with x' hx'
    exact hb (g x') ((hgx x').mem_open hW hx')
  have hext : ∀ (T : (wcP1Over F'').left.ProEt)
      (g : C((wcOpenRestr (wcP1Over F'').left (wcPencilSOpen D) T).left, ℚ_[ℓ])),
      ∃ G : C(T.left, ℚ_[ℓ]), ∀ y : (wcOpenRestr (wcP1Over F'').left (wcPencilSOpen D) T).left,
        G ((wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D) T).left y) = g y :=
    fun T g => s4 _ (wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D) T).left.continuous
      (hgen T) (hloc T) g

  unfold wcPencilNoMixed at hNM
  exact wc_proet_openRestr_over_hom_zero (wcP1Over F'').left ℓ (wcPencilSOpen D)
    (wcGeomPoint F'' (wcP1Over F'') hP) _ hgen hext (hNM ℓ hℓ hP hNI) φ

theorem wc_pencil_R_stalk_orth_pairing (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n) (hNM : wcPencilNoMixed D)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∀ d : ℕ, 1 ≤ d → ∀ x ∈ wcP1ClosedPt F'' d, (∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) →
    ∀ N : wcFrobNbhd F'' x d,
    ∃ b : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0 →+
        Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0 →+ ℚ_[ℓ],
      (∀ (c : ℚ_[ℓ]) (y y' : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
          (wcRq D.f ℓ (n - 1)) 0),
        b ((Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 1) c)).postcomp
          (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) y) y' = c * b y y') ∧
      (∀ (c : ℚ_[ℓ]) (y y' : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
          (wcRq D.f ℓ (n - 1)) 0),
        b y ((Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 1) c)).postcomp
          (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) y') = c * b y y') ∧
      (∀ y y' : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0,
        b ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left N.φ)).precomp
            (wcRq D.f ℓ (n - 1)) (zero_add 0) y)
          ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left N.φ)).precomp
            (wcRq D.f ℓ (n - 1)) (zero_add 0) y') =
          (Nat.card F'' : ℚ_[ℓ]) ^ ((n - 1) * d) * b y y') ∧
      (∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0,
        (∀ y' : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0,
          b y y' = 0) → y = 0) ∧
      (∀ y' : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0,
        (∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0,
          b y y' = 0) → y' = 0) ∧
      (∀ (z : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
          (Subobject.underlying.obj (wcPencilE D ℓ hP)) 0)
        (w : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
          (Subobject.underlying.obj (wcPencilC D ℓ hP)) 0),
        b ((Abelian.Ext.mk₀ (wcPencilE D ℓ hP).arrow).postcomp
            (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) z)
          ((Abelian.Ext.mk₀ (wcPencilC D ℓ hP).arrow).postcomp
            (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) w) = 0 ∧
        b ((Abelian.Ext.mk₀ (wcPencilC D ℓ hP).arrow).postcomp
            (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) w)
          ((Abelian.Ext.mk₀ (wcPencilE D ℓ hP).arrow).postcomp
            (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) z) = 0) :=
by
  classical
  intro d hd x hx hS N
  letI := N.ringA
  letI := N.hensA
  letI := N.sepA
  obtain ⟨B, hnat, hsL, hsR, hperf⟩ := wc_pencil_Rq_cup_pairing F' F'' Y n hn hn2 D ℓ hℓ hP
  obtain ⟨ev, hpost, hpre⟩ := wc_free_ext0_eval (wcP1Over F'').left
  obtain ⟨tr, htr, hfrob⟩ := wc_pencil_R2_frob_nbhd_line F' F'' Y n hn hn2 D ℓ hℓ d hd x hx hS N
  have h2s : ∀ (c : ℚ_[ℓ]) (t : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op N.V)),
      (ev N.V (wcRq D.f ℓ (2 * (n - 1)))).symm
          (((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op N.V)).hom t) =
        (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (2 * (n - 1)) c)).postcomp
          (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0)
          ((ev N.V (wcRq D.f ℓ (2 * (n - 1)))).symm t) := by
    intro c t
    apply (ev N.V (wcRq D.f ℓ (2 * (n - 1)))).injective
    rw [AddEquiv.apply_symm_apply, hpost, AddEquiv.apply_symm_apply]
  have h2φ : ∀ t : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op N.V),
      (ev N.V (wcRq D.f ℓ (2 * (n - 1)))).symm
          (((wcRq D.f ℓ (2 * (n - 1))).obj.map N.φ.op).hom t) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left N.φ)).precomp
          (wcRq D.f ℓ (2 * (n - 1))) (zero_add 0) ((ev N.V (wcRq D.f ℓ (2 * (n - 1)))).symm t) := by
    intro t
    apply (ev N.V (wcRq D.f ℓ (2 * (n - 1)))).injective
    rw [AddEquiv.apply_symm_apply, hpre, AddEquiv.apply_symm_apply]
  have hline : ∀ t : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op N.V),
      tr ((ev N.V (wcRq D.f ℓ (2 * (n - 1)))).symm t) 0 = 0 → t = 0 := by
    intro t ht
    have h3 : tr ((ev N.V (wcRq D.f ℓ (2 * (n - 1)))).symm t) = 0 := by
      funext i
      rw [Fin.fin_one_eq_zero i, Pi.zero_apply]
      exact ht
    have h4 : (ev N.V (wcRq D.f ℓ (2 * (n - 1)))).symm t = 0 :=
      tr.injective (h3.trans (map_zero tr).symm)
    exact (ev N.V (wcRq D.f ℓ (2 * (n - 1)))).symm.injective (h4.trans (map_zero _).symm)
  have hcl : IsClosed ({N.V.hom (N.e.inv (IsLocalRing.closedPoint N.A))} :
      Set (wcP1Over F'').left) := by
    rw [N.hx]
    exact hx.1
  have hoff : ∀ i, N.V.hom (N.e.inv (IsLocalRing.closedPoint N.A)) ≠
      D.S i (IsLocalRing.closedPoint F'') := by
    intro i
    rw [N.hx]
    exact hS i
  have hpf := hperf N.V N.A N.e hcl hoff
  obtain ⟨b, hb⟩ : ∃ b : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0 →+
      Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0 →+ ℚ_[ℓ],
      ∀ y y', b y y' = tr ((ev N.V (wcRq D.f ℓ (2 * (n - 1)))).symm
        (B N.V (ev N.V (wcRq D.f ℓ (n - 1)) y) (ev N.V (wcRq D.f ℓ (n - 1)) y'))) 0 :=
    ⟨AddMonoidHom.mk' (fun y => AddMonoidHom.mk'
        (fun y' => tr ((ev N.V (wcRq D.f ℓ (2 * (n - 1)))).symm
          (B N.V (ev N.V (wcRq D.f ℓ (n - 1)) y) (ev N.V (wcRq D.f ℓ (n - 1)) y'))) 0)
        (fun a a' => by simp only [map_add, Pi.add_apply]))
      (fun a a' => by
        ext y'
        simp only [AddMonoidHom.mk'_apply, AddMonoidHom.add_apply, map_add, Pi.add_apply]),
     fun _ _ => rfl⟩
  refine ⟨b, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro c y y'
    rw [hb, hb, hpost, hsL, h2s, htr, Pi.smul_apply, smul_eq_mul]
  · intro c y y'
    rw [hb, hb, hpost, hsR, h2s, htr, Pi.smul_apply, smul_eq_mul]
  · intro y y'
    rw [hb, hb, hpre, hpre, hnat, h2φ, hfrob, htr, Pi.smul_apply, smul_eq_mul]
  · intro y hy
    have h1 : ∀ u', B N.V (ev N.V (wcRq D.f ℓ (n - 1)) y) u' = 0 := by
      intro u'
      have h := hy ((ev N.V (wcRq D.f ℓ (n - 1))).symm u')
      rw [hb, AddEquiv.apply_symm_apply] at h
      exact hline _ h
    have h5 := hpf.1 (ev N.V (wcRq D.f ℓ (n - 1)) y) h1
    exact (ev N.V (wcRq D.f ℓ (n - 1))).injective (h5.trans (map_zero _).symm)
  · intro y' hy'
    have h1 : ∀ u, B N.V u (ev N.V (wcRq D.f ℓ (n - 1)) y') = 0 := by
      intro u
      have h := hy' ((ev N.V (wcRq D.f ℓ (n - 1))).symm u)
      rw [hb, AddEquiv.apply_symm_apply] at h
      exact hline _ h
    have h5 := hpf.2 (ev N.V (wcRq D.f ℓ (n - 1)) y') h1
    exact (ev N.V (wcRq D.f ℓ (n - 1))).injective (h5.trans (map_zero _).symm)
  · intro z w
    obtain ⟨r₂, ⟨θ₂⟩⟩ := wc_pencil_R2_geomConst_offS F' F'' Y n hn hn2 D ℓ hℓ hP
    have hE0 := wc_pencil_E_hom_const_zero_offS F' F'' Y n hn hn2 D hNM ℓ hℓ hP hNI
    have hE := wc_proet_over_hom_zero_of_geomConst (wcP1Over F'').left ℓ
      (wcPencilGeomOffS D hP) (Subobject.underlying.obj (wcPencilE D ℓ hP))
      (wcRq D.f ℓ (2 * (n - 1))) r₂ θ₂ hE0
    have hGC := wc_pencil_GC_max_exists F' F'' Y n hn hn2 D ℓ hℓ hP
    have hCspec : wcPencilGC F'' hP ℓ (Subobject.underlying.obj (wcPencilC D ℓ hP)) := by
      unfold wcPencilC
      rw [dif_pos hGC]
      exact (Classical.choose_spec hGC).2.1
    obtain ⟨rC, ⟨θC⟩⟩ := hCspec
    obtain ⟨s'⟩ := wc_P1_strict_local_offS_map F' F'' Y n D hP N.V N.A N.e hoff
    obtain ⟨c, hc⟩ := wc_proet_geomConst_section_of_local (wcP1Over F'').left ℓ
      (Subobject.underlying.obj (wcPencilC D ℓ hP)) (wcGeomPoint F'' (wcP1Over F'') hP) N.V
      (s' ≫ wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D) (wcGeomPoint F'' (wcP1Over F'') hP))
      N.A N.e rC θC (ev N.V (Subobject.underlying.obj (wcPencilC D ℓ hP)) w)
    have hc2 : ((Subobject.underlying.obj (wcPencilC D ℓ hP)).obj.map s'.op).hom
        (((Subobject.underlying.obj (wcPencilC D ℓ hP)).obj.map
          (wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D)
            (wcGeomPoint F'' (wcP1Over F'') hP)).op).hom c) =
        ev N.V (Subobject.underlying.obj (wcPencilC D ℓ hP)) w := by
      rw [← hc]
      first
        | rfl
        | (rw [op_comp, Functor.map_comp]; rfl)
        | simp only [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
        | simp [op_comp, Functor.map_comp]
    have h8 := wc_proet_pairing_orth_of_hom_zero (wcP1Over F'').left
      (wcPencilGeomOffS D hP) (Subobject.underlying.obj (wcPencilE D ℓ hP))
      (Subobject.underlying.obj (wcPencilC D ℓ hP)) (wcRq D.f ℓ (n - 1))
      (wcRq D.f ℓ (2 * (n - 1))) (wcPencilE D ℓ hP).arrow (wcPencilC D ℓ hP).arrow B hnat hE
      (((Subobject.underlying.obj (wcPencilC D ℓ hP)).obj.map
        (wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D)
          (wcGeomPoint F'' (wcP1Over F'') hP)).op).hom c)
      N.V s' (ev N.V (Subobject.underlying.obj (wcPencilE D ℓ hP)) z)
    rw [hc2] at h8
    refine ⟨?_, ?_⟩
    · rw [hb, hpost, hpost, h8.1, map_zero, map_zero, Pi.zero_apply]
    · rw [hb, hpost, hpost, h8.2, map_zero, map_zero, Pi.zero_apply]

theorem wc_pencil_R_stalk_rank_sum_nm (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (hNM : wcPencilNoMixed D)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∀ d : ℕ, 1 ≤ d → ∀ x ∈ wcP1ClosedPt F'' d, (∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) →
    ∀ N : wcFrobNbhd F'' x d,
    ∀ (r : ℕ) (e : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0 ≃+
        (Fin r → ℚ_[ℓ])),
      (∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0),
        e ((Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 1) c)).postcomp
          (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) y) = c • e y) →
      ∃ UE UC : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]),
        (∀ z : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
            (Subobject.underlying.obj (wcPencilE D ℓ hP)) 0,
          e ((Abelian.Ext.mk₀ (wcPencilE D ℓ hP).arrow).postcomp
            (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) z) ∈ UE) ∧
        (∀ v ∈ UE, ∃ z : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
            (Subobject.underlying.obj (wcPencilE D ℓ hP)) 0,
          e ((Abelian.Ext.mk₀ (wcPencilE D ℓ hP).arrow).postcomp
            (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) z) = v) ∧
        (∀ w : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
            (Subobject.underlying.obj (wcPencilC D ℓ hP)) 0,
          e ((Abelian.Ext.mk₀ (wcPencilC D ℓ hP).arrow).postcomp
            (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) w) ∈ UC) ∧
        (∀ v ∈ UC, ∃ w : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
            (Subobject.underlying.obj (wcPencilC D ℓ hP)) 0,
          e ((Abelian.Ext.mk₀ (wcPencilC D ℓ hP).arrow).postcomp
            (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) w) = v) ∧
        Module.finrank ℚ_[ℓ] UE + Module.finrank ℚ_[ℓ] UC = r :=
by
  classical
  intro d hd x hx hS N r e he

  have hpp : ∀ {A B C : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (f : A ⟶ B) (g : B ⟶ C) (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) A 0),
      (Abelian.Ext.mk₀ g).postcomp (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0)
          ((Abelian.Ext.mk₀ f).postcomp (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) y) =
        (Abelian.Ext.mk₀ (f ≫ g)).postcomp (wcFreeSheaf (wcP1Over F'').left N.V)
          (add_zero 0) y := by
    intro A B C f g y
    show (y.comp (Abelian.Ext.mk₀ f) (add_zero 0)).comp (Abelian.Ext.mk₀ g) (add_zero 0) =
      y.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero 0)
    rw [Abelian.Ext.comp_assoc y (Abelian.Ext.mk₀ f) (Abelian.Ext.mk₀ g) (add_zero 0)
      (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀]
  have hpost : ∀ {A B' : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (g : A ⟶ B') (f : wcFreeSheaf (wcP1Over F'').left N.V ⟶ A),
      (Abelian.Ext.mk₀ g).postcomp (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0)
        (Abelian.Ext.mk₀ f) = Abelian.Ext.mk₀ (f ≫ g) := by
    intro A B' g f
    show (Abelian.Ext.mk₀ f).comp (Abelian.Ext.mk₀ g) (add_zero 0) = _
    exact Abelian.Ext.mk₀_comp_mk₀ f g
  have hinj : ∀ {A B' : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (g : A ⟶ B') [Mono g],
      Function.Injective ((Abelian.Ext.mk₀ g).postcomp
        (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0)) := by
    intro A B' g _ y y' h
    rw [← Abelian.Ext.mk₀_homEquiv₀_apply y, ← Abelian.Ext.mk₀_homEquiv₀_apply y',
      hpost, hpost] at h
    have h' := (Abelian.Ext.mk₀_bijective _ _).1 h
    rw [← Abelian.Ext.mk₀_homEquiv₀_apply y, ← Abelian.Ext.mk₀_homEquiv₀_apply y',
      (cancel_mono g).mp h']

  have img : ∀ (X : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
      (m : X ⟶ wcRq D.f ℓ (n - 1)) (σX : ℚ_[ℓ] → (X ⟶ X))
      (hm : ∀ c : ℚ_[ℓ], σX c ≫ m = m ≫ wcRqScalar D.f ℓ (n - 1) c),
      ∃ U : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]), ∀ v, v ∈ U ↔
        ∃ z : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) X 0,
          e ((Abelian.Ext.mk₀ m).postcomp (wcFreeSheaf (wcP1Over F'').left N.V)
            (add_zero 0) z) = v := by
    intro X m σX hm
    refine ⟨{ carrier := {v | ∃ z : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) X 0,
                e ((Abelian.Ext.mk₀ m).postcomp (wcFreeSheaf (wcP1Over F'').left N.V)
                  (add_zero 0) z) = v}
              zero_mem' := ⟨0, by simp only [map_zero]⟩
              add_mem' := by
                rintro _ _ ⟨z, rfl⟩ ⟨z', rfl⟩
                exact ⟨z + z', by simp only [map_add]⟩
              smul_mem' := by
                rintro c _ ⟨z, rfl⟩
                rw [Set.mem_setOf_eq]
                refine ⟨(Abelian.Ext.mk₀ (σX c)).postcomp
                  (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) z, ?_⟩
                rw [hpp, hm, ← hpp, he] }, fun v => Iff.rfl⟩

  have sub : ∀ (X : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
      (m : X ⟶ wcRq D.f ℓ (n - 1)) [Mono m] (σX : ℚ_[ℓ] → (X ⟶ X))
      (hm : ∀ c : ℚ_[ℓ], σX c ≫ m = m ≫ wcRqScalar D.f ℓ (n - 1) c)
      (U : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]))
      (hU : ∀ v, v ∈ U ↔ ∃ z : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) X 0,
          e ((Abelian.Ext.mk₀ m).postcomp (wcFreeSheaf (wcP1Over F'').left N.V)
            (add_zero 0) z) = v) (k : ℕ)
      (b : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) X 0 ≃+ (Fin k → ℚ_[ℓ]))
      (hb : ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) X 0),
        b ((Abelian.Ext.mk₀ (σX c)).postcomp (wcFreeSheaf (wcP1Over F'').left N.V)
          (add_zero 0) y) = c • b y),
      Module.finrank ℚ_[ℓ] U = k := by
    intro X m _ σX hm U hU k b hb
    have hbs : ∀ (c : ℚ_[ℓ]) (v : Fin k → ℚ_[ℓ]), b.symm (c • v) =
        (Abelian.Ext.mk₀ (σX c)).postcomp (wcFreeSheaf (wcP1Over F'').left N.V)
          (add_zero 0) (b.symm v) := fun c v =>
      b.injective (by rw [hb, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    let L : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) :=
      { toFun := fun v => e ((Abelian.Ext.mk₀ m).postcomp
          (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) (b.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by
          simp only [RingHom.id_apply]
          rw [hbs, hpp, hm, ← hpp, he] }
    have hLapp : ∀ v, L v = e ((Abelian.Ext.mk₀ m).postcomp
        (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) (b.symm v)) := fun v => rfl
    have hL : Function.Injective L := by
      intro v w h
      rw [hLapp, hLapp] at h
      exact b.symm.injective (hinj m (e.injective h))
    have hUL : U = LinearMap.range L := by
      ext v
      rw [hU, LinearMap.mem_range]
      constructor
      · rintro ⟨z, rfl⟩
        exact ⟨b z, by rw [hLapp, AddEquiv.symm_apply_apply]⟩
      · rintro ⟨u, rfl⟩
        exact ⟨b.symm u, (hLapp u).symm⟩
    rw [hUL, LinearMap.finrank_range_of_inj hL, Module.finrank_fin_fun]

  have hra : ∀ (a : ℕ)
      (bR : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0 ≃+
        (Fin a → ℚ_[ℓ])),
      (∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
          (wcRq D.f ℓ (n - 1)) 0),
        bR ((Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 1) c)).postcomp
          (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) y) = c • bR y) → r = a := by
    intro a bR hbR
    have hbs : ∀ (c : ℚ_[ℓ]) (v : Fin a → ℚ_[ℓ]), bR.symm (c • v) =
        (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 1) c)).postcomp
          (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) (bR.symm v) := fun c v =>
      bR.injective (by rw [hbR, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    let L : (Fin a → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) :=
      (bR.symm.trans e).toLinearEquiv (fun c v => by
        show e (bR.symm (c • v)) = c • e (bR.symm v)
        rw [hbs, he])
    have h1 := L.finrank_eq
    rw [Module.finrank_fin_fun, Module.finrank_fin_fun] at h1
    exact h1.symm

  have stabE : wcPencilStable D ℓ (wcPencilE D ℓ hP) := by
    unfold wcPencilE
    split_ifs with h
    · exact (Classical.choose_spec h).1
    · intro c
      exact ⟨(⊤ : Subobject (wcRq D.f ℓ (n - 1))).factorThru
        ((⊤ : Subobject (wcRq D.f ℓ (n - 1))).arrow ≫ wcRqScalar D.f ℓ (n - 1) c)
        (Subobject.top_factors _), Subobject.factorThru_arrow _ _ _⟩
  have stabC : wcPencilStable D ℓ (wcPencilC D ℓ hP) := by
    unfold wcPencilC
    split_ifs with h
    · exact (Classical.choose_spec h).1
    · intro c
      exact ⟨(⊤ : Subobject (wcRq D.f ℓ (n - 1))).factorThru
        ((⊤ : Subobject (wcRq D.f ℓ (n - 1))).arrow ≫ wcRqScalar D.f ℓ (n - 1) c)
        (Subobject.top_factors _), Subobject.factorThru_arrow _ _ _⟩
  choose ψE hψE using stabE
  choose ψC hψC using stabC
  obtain ⟨UE, hUE⟩ := img _ (wcPencilE D ℓ hP).arrow ψE hψE
  obtain ⟨UC, hUC⟩ := img _ (wcPencilC D ℓ hP).arrow ψC hψC

  obtain ⟨b, hL, hR, -, hNL, hNR, hO⟩ :=
    wc_pencil_R_stalk_orth_pairing F' F'' Y n hn hn2 D hNM ℓ hℓ hP hNI d hd x hx hS N
  have hes : ∀ (c : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]), e.symm (c • v) =
      (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 1) c)).postcomp
        (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) (e.symm v) := fun c v =>
    e.injective (by rw [he, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
  let B : LinearMap.BilinForm ℚ_[ℓ] (Fin r → ℚ_[ℓ]) :=
    LinearMap.mk₂ ℚ_[ℓ] (fun v w => b (e.symm v) (e.symm w))
      (fun v₁ v₂ w => by simp only [map_add, AddMonoidHom.add_apply])
      (fun c v w => by simp only [hes, hL, smul_eq_mul])
      (fun v w₁ w₂ => by simp only [map_add])
      (fun c v w => by simp only [hes, hR, smul_eq_mul])
  have hB : ∀ v w, B v w = b (e.symm v) (e.symm w) := fun _ _ => rfl
  have hSL : ∀ v, (∀ w, B v w = 0) → v = 0 := by
    intro v hv
    have h0 : e.symm v = 0 := hNL _ (fun y' => by
      have := hv (e y')
      rwa [hB, AddEquiv.symm_apply_apply] at this)
    rw [← e.apply_symm_apply v, h0, map_zero]
  have hSR : ∀ w, (∀ v, B v w = 0) → w = 0 := by
    intro w hw
    have h0 : e.symm w = 0 := hNR _ (fun y => by
      have := hw (e y)
      rwa [hB, AddEquiv.symm_apply_apply] at this)
    rw [← e.apply_symm_apply w, h0, map_zero]
  have hBnd : B.Nondegenerate := ⟨hSL, hSR⟩
  have hUCle : UC ≤ B.orthogonal UE := by
    intro v hv
    refine LinearMap.BilinForm.mem_orthogonal_iff.mpr (fun u hu => ?_)
    obtain ⟨w, rfl⟩ := (hUC v).1 hv
    obtain ⟨z, rfl⟩ := (hUE u).1 hu
    show B _ _ = 0
    rw [hB, AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply]
    exact (hO z w).1
  have hup : Module.finrank ℚ_[ℓ] UE + Module.finrank ℚ_[ℓ] UC ≤ r := by
    have h1 := Submodule.finrank_mono hUCle
    have h2 := LinearMap.BilinForm.finrank_orthogonal hBnd UE
    have h3 := Submodule.finrank_le UE
    rw [Module.finrank_fin_fun] at h2 h3
    omega

  have hlow : r ≤ Module.finrank ℚ_[ℓ] UE + Module.finrank ℚ_[ℓ] UC := by
    by_cases hEc : ∃ M : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M ∧
        wcPencilGC F'' hP ℓ (Limits.cokernel M.arrow) ∧
        ∀ M' : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M' →
          wcPencilGC F'' hP ℓ (Limits.cokernel M'.arrow) → M ≤ M'
    · have hE : wcPencilE D ℓ hP = Classical.choose hEc := dif_pos hEc
      have hgc : wcPencilGC F'' hP ℓ (Limits.cokernel (wcPencilE D ℓ hP).arrow) := by
        rw [hE]; exact (Classical.choose_spec hEc).2.1
      obtain ⟨W, w, a, hconn, hcov, hRW⟩ :=
        wc_pencil_Rq_scalar_triv_cover F' F'' Y n D ℓ hℓ hP (n - 1)
      have restr : ∀ (G : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}),
          wcPencilGC F'' hP ℓ G → ∃ b : ℕ,
            Nonempty (G.over W ≅ (wcContSheaf (wcP1Over F'').left (Fin b → ℚ_[ℓ])).over W) := by
        intro G hG
        obtain ⟨b, ⟨θ⟩⟩ := hG
        exact ⟨b, ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback
          AddCommGrpCat.{u+1} w).mapIso θ⟩⟩
      obtain ⟨k, hEW⟩ := wc_scalarTriv_sub_of_coker_const (wcP1Over F'').left ℓ W hconn
        (wcRq D.f ℓ (n - 1)) (Subobject.underlying.obj (wcPencilE D ℓ hP))
        (wcRqScalar D.f ℓ (n - 1)) ψE a hRW (wcPencilE D ℓ hP).arrow hψE
        (Or.inr (restr _ hgc))
      have hEW' := hEW
      unfold wcScalarTriv at hEW'
      obtain ⟨θM, -⟩ := hEW'
      have hRW' := hRW
      unfold wcScalarTriv at hRW'
      obtain ⟨θR, -⟩ := hRW'
      obtain ⟨M', c, hM's, ⟨θ'⟩, hac⟩ := wc_pencil_R_perp_GC_sub F' F'' Y n hn hn2 D ℓ hℓ hP
        (wcPencilE D ℓ hP) (fun c => ⟨ψE c, hψE c⟩) hgc W w hconn hcov a k θR θM
      have hCex := wc_pencil_GC_max_exists F' F'' Y n hn hn2 D ℓ hℓ hP
      have hC : wcPencilC D ℓ hP = Classical.choose hCex := dif_pos hCex
      have hle : M' ≤ wcPencilC D ℓ hP := by
        rw [hC]; exact (Classical.choose_spec hCex).2.2 M' hM's ⟨c, ⟨θ'⟩⟩
      choose ψ' hψ' using hM's
      have hM'W := wc_scalarTriv_sub_of_plain_triv (wcP1Over F'').left ℓ W hconn
        (wcRq D.f ℓ (n - 1)) (Subobject.underlying.obj M') (wcRqScalar D.f ℓ (n - 1)) ψ' a c
        hRW M'.arrow hψ'
        ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback
          AddCommGrpCat.{u+1} w).mapIso θ'⟩
      letI := N.ringA
      letI := N.hensA
      letI := N.sepA
      have hxN : ∀ i, N.V.hom (N.e.inv (IsLocalRing.closedPoint N.A)) ≠
          D.S i (IsLocalRing.closedPoint F'') := by
        intro i
        rw [N.hx]
        exact hS i
      obtain ⟨bR, hbR, -⟩ := wc_proet_scalarTriv_stalk_basis (wcP1Over F'').left ℓ
        (wcRq D.f ℓ (n - 1)) (wcRqScalar D.f ℓ (n - 1)) a N.V N.A N.e (𝟙 N.V)
        (wc_proet_scalarTriv_strict_local F'' hP ℓ (wcRq D.f ℓ (n - 1))
          (wcRqScalar D.f ℓ (n - 1)) a D.m D.S D.hS W w hcov hRW N.V N.A N.e hxN)
      obtain ⟨bE, hbE, -⟩ := wc_proet_scalarTriv_stalk_basis (wcP1Over F'').left ℓ
        (Subobject.underlying.obj (wcPencilE D ℓ hP)) ψE k N.V N.A N.e (𝟙 N.V)
        (wc_proet_scalarTriv_strict_local F'' hP ℓ (Subobject.underlying.obj (wcPencilE D ℓ hP))
          ψE k D.m D.S D.hS W w hcov hEW N.V N.A N.e hxN)
      obtain ⟨b', hb', -⟩ := wc_proet_scalarTriv_stalk_basis (wcP1Over F'').left ℓ
        (Subobject.underlying.obj M') ψ' c N.V N.A N.e (𝟙 N.V)
        (wc_proet_scalarTriv_strict_local F'' hP ℓ (Subobject.underlying.obj M')
          ψ' c D.m D.S D.hS W w hcov hM'W N.V N.A N.e hxN)
      have hra' := hra a bR hbR
      have hdE := sub _ (wcPencilE D ℓ hP).arrow ψE hψE UE hUE k bE hbE
      obtain ⟨U', hU'⟩ := img _ M'.arrow ψ' hψ'
      have hd' := sub _ M'.arrow ψ' hψ' U' hU' c b' hb'
      have hU'C : U' ≤ UC := by
        intro v hv
        obtain ⟨z, rfl⟩ := (hU' v).1 hv
        rw [hUC]
        refine ⟨(Abelian.Ext.mk₀ (Subobject.ofLE M' (wcPencilC D ℓ hP) hle)).postcomp
          (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) z, ?_⟩
        rw [hpp, Subobject.ofLE_arrow]
      have hfin := Submodule.finrank_mono hU'C
      omega
    · have hE : wcPencilE D ℓ hP = ⊤ := dif_neg hEc
      have hiso : IsIso (wcPencilE D ℓ hP).arrow := by
        rw [hE]
        infer_instance
      have htop : UE = ⊤ := by
        rw [eq_top_iff]
        intro v _
        rw [hUE]
        refine ⟨Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ (e.symm v) ≫
          inv (wcPencilE D ℓ hP).arrow), ?_⟩
        rw [hpost, Category.assoc, IsIso.inv_hom_id, Category.comp_id,
          Abelian.Ext.mk₀_homEquiv₀_apply, AddEquiv.apply_symm_apply]
      have hfin : Module.finrank ℚ_[ℓ] UE = r := by
        rw [htop, finrank_top, Module.finrank_fin_fun]
      omega
  exact ⟨UE, UC, fun z => (hUE _).2 ⟨z, rfl⟩, fun v hv => (hUE v).1 hv,
    fun w => (hUC _).2 ⟨w, rfl⟩, fun v hv => (hUC v).1 hv, le_antisymm hup hlow⟩

theorem wc_pencil_R_stalk_radical_form (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n) (hNM : wcPencilNoMixed D)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∀ d : ℕ, 1 ≤ d → ∀ x ∈ wcP1ClosedPt F'' d, (∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) →
    ∀ N : wcFrobNbhd F'' x d,
    ∃ b : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0 →+
        Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0 →+ ℚ_[ℓ],
      (∀ (c : ℚ_[ℓ]) (y y' : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
          (wcRq D.f ℓ (n - 1)) 0),
        b ((Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 1) c)).postcomp
          (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) y) y' = c * b y y') ∧
      (∀ (c : ℚ_[ℓ]) (y y' : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
          (wcRq D.f ℓ (n - 1)) 0),
        b y ((Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 1) c)).postcomp
          (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) y') = c * b y y') ∧
      (∀ y y' : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0,
        b ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left N.φ)).precomp
            (wcRq D.f ℓ (n - 1)) (zero_add 0) y)
          ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left N.φ)).precomp
            (wcRq D.f ℓ (n - 1)) (zero_add 0) y') =
          (Nat.card F'' : ℚ_[ℓ]) ^ ((n - 1) * d) * b y y') ∧
      (∀ z : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
          (Subobject.underlying.obj (wcPencilE D ℓ hP)) 0,
        (∀ z' : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
            (Subobject.underlying.obj (wcPencilE D ℓ hP)) 0,
          b ((Abelian.Ext.mk₀ (wcPencilE D ℓ hP).arrow).postcomp
              (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) z)
            ((Abelian.Ext.mk₀ (wcPencilE D ℓ hP).arrow).postcomp
              (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) z') = 0) ↔
        ∃ w : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
            (Subobject.underlying.obj (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)) 0,
          z = (Abelian.Ext.mk₀ ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).ofLE (wcPencilE D ℓ hP)
            inf_le_left)).postcomp (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) w) ∧
      (∀ z : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
          (Subobject.underlying.obj (wcPencilE D ℓ hP)) 0,
        (∀ z' : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
            (Subobject.underlying.obj (wcPencilE D ℓ hP)) 0,
          b ((Abelian.Ext.mk₀ (wcPencilE D ℓ hP).arrow).postcomp
              (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) z')
            ((Abelian.Ext.mk₀ (wcPencilE D ℓ hP).arrow).postcomp
              (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) z) = 0) ↔
        ∃ w : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
            (Subobject.underlying.obj (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)) 0,
          z = (Abelian.Ext.mk₀ ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).ofLE (wcPencilE D ℓ hP)
            inf_le_left)).postcomp (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) w) :=
by
  classical
  intro d hd x hx hS N
  obtain ⟨r, e, he⟩ := wc_pencil_R_stalk_basis F' F'' Y n hn hn2 D ℓ hℓ d hd x hx hS N
  obtain ⟨b, hL, hR, hF, hNL, hNR, hO⟩ :=
    wc_pencil_R_stalk_orth_pairing F' F'' Y n hn hn2 D hNM ℓ hℓ hP hNI d hd x hx hS N
  obtain ⟨UE, UC, hE1, hE2, hC1, hC2, hdim⟩ :=
    wc_pencil_R_stalk_rank_sum_nm F' F'' Y n hn hn2 D hNM ℓ hℓ hP hNI d hd x hx hS N r e he

  have hpost : ∀ {A B' : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (g : A ⟶ B') (f : wcFreeSheaf (wcP1Over F'').left N.V ⟶ A),
      (Abelian.Ext.mk₀ g).postcomp (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0)
        (Abelian.Ext.mk₀ f) = Abelian.Ext.mk₀ (f ≫ g) := by
    intro A B' g f
    show (Abelian.Ext.mk₀ f).comp (Abelian.Ext.mk₀ g) (add_zero 0) = _
    exact Abelian.Ext.mk₀_comp_mk₀ f g

  have hint : ∀ {T : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (E' C' : Subobject T)
      (z : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (Subobject.underlying.obj E') 0),
      (∃ w : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (Subobject.underlying.obj C') 0,
        (Abelian.Ext.mk₀ E'.arrow).postcomp (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) z =
          (Abelian.Ext.mk₀ C'.arrow).postcomp (wcFreeSheaf (wcP1Over F'').left N.V)
            (add_zero 0) w) ↔
      ∃ w' : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
          (Subobject.underlying.obj (E' ⊓ C')) 0,
        z = (Abelian.Ext.mk₀ ((E' ⊓ C').ofLE E' inf_le_left)).postcomp
          (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) w' := by
    intro T E' C' z
    constructor
    · rintro ⟨w, hw⟩
      rw [← Abelian.Ext.mk₀_homEquiv₀_apply z, ← Abelian.Ext.mk₀_homEquiv₀_apply w,
        hpost, hpost] at hw
      have hw' := (Abelian.Ext.mk₀_bijective _ _).1 hw
      have hfac : (E' ⊓ C').Factors (Abelian.Ext.homEquiv₀ z ≫ E'.arrow) := by
        refine (Subobject.inf_factors _).mpr ⟨Subobject.factors_comp_arrow _, ?_⟩
        rw [hw']
        exact Subobject.factors_comp_arrow _
      refine ⟨Abelian.Ext.mk₀ ((E' ⊓ C').factorThru _ hfac), ?_⟩
      rw [hpost]
      conv_lhs => rw [← Abelian.Ext.mk₀_homEquiv₀_apply z]
      congr 1
      rw [← cancel_mono E'.arrow, Category.assoc, Subobject.ofLE_arrow,
        Subobject.factorThru_arrow]
    · rintro ⟨w', rfl⟩
      refine ⟨Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ w' ≫ (E' ⊓ C').ofLE C' inf_le_right), ?_⟩
      conv_lhs => rw [← Abelian.Ext.mk₀_homEquiv₀_apply w']
      rw [hpost, hpost, hpost, Category.assoc, Category.assoc, Subobject.ofLE_arrow,
        Subobject.ofLE_arrow]

  have hes : ∀ (c : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]), e.symm (c • v) =
      (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 1) c)).postcomp
        (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) (e.symm v) := fun c v =>
    e.injective (by rw [he, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
  let B : LinearMap.BilinForm ℚ_[ℓ] (Fin r → ℚ_[ℓ]) :=
    LinearMap.mk₂ ℚ_[ℓ] (fun v w => b (e.symm v) (e.symm w))
      (fun v₁ v₂ w => by simp only [map_add, AddMonoidHom.add_apply])
      (fun c v w => by simp only [hes, hL, smul_eq_mul])
      (fun v w₁ w₂ => by simp only [map_add])
      (fun c v w => by simp only [hes, hR, smul_eq_mul])
  have hB : ∀ v w, B v w = b (e.symm v) (e.symm w) := fun _ _ => rfl
  let B2 : LinearMap.BilinForm ℚ_[ℓ] (Fin r → ℚ_[ℓ]) :=
    LinearMap.mk₂ ℚ_[ℓ] (fun v w => b (e.symm w) (e.symm v))
      (fun v₁ v₂ w => by simp only [map_add])
      (fun c v w => by simp only [hes, hR, smul_eq_mul])
      (fun v w₁ w₂ => by simp only [map_add, AddMonoidHom.add_apply])
      (fun c v w => by simp only [hes, hL, smul_eq_mul])
  have hB2 : ∀ v w, B2 v w = b (e.symm w) (e.symm v) := fun _ _ => rfl

  have LA : ∀ B' : LinearMap.BilinForm ℚ_[ℓ] (Fin r → ℚ_[ℓ]),
      (∀ v, (∀ w, B' v w = 0) → v = 0) → (∀ w, (∀ v, B' v w = 0) → w = 0) →
      (∀ u ∈ UE, ∀ v ∈ UC, B' u v = 0) → ∀ v, (∀ u ∈ UE, B' u v = 0) ↔ v ∈ UC := by
    intro B' hSL hSR hOrth v
    have hB' : B'.Nondegenerate := ⟨hSL, hSR⟩
    have h1 : UC ≤ B'.orthogonal UE := fun w hw =>
      LinearMap.BilinForm.mem_orthogonal_iff.mpr (fun u hu => hOrth u hu w hw)
    have h2 : Module.finrank ℚ_[ℓ] (B'.orthogonal UE) = Module.finrank ℚ_[ℓ] UC := by
      rw [LinearMap.BilinForm.finrank_orthogonal hB', Module.finrank_fin_fun]
      omega
    have h3 : UC = B'.orthogonal UE := Submodule.eq_of_le_of_finrank_le h1 h2.le
    rw [h3, LinearMap.BilinForm.mem_orthogonal_iff]
  have hSL : ∀ v, (∀ w, B v w = 0) → v = 0 := by
    intro v hv
    have h0 : e.symm v = 0 := hNL _ (fun y' => by
      have := hv (e y')
      rwa [hB, AddEquiv.symm_apply_apply] at this)
    rw [← e.apply_symm_apply v, h0, map_zero]
  have hSR : ∀ w, (∀ v, B v w = 0) → w = 0 := by
    intro w hw
    have h0 : e.symm w = 0 := hNR _ (fun y => by
      have := hw (e y)
      rwa [hB, AddEquiv.symm_apply_apply] at this)
    rw [← e.apply_symm_apply w, h0, map_zero]
  have hOr : ∀ u ∈ UE, ∀ v ∈ UC, B u v = 0 := by
    intro u hu v hv
    obtain ⟨z, rfl⟩ := hE2 u hu
    obtain ⟨w, rfl⟩ := hC2 v hv
    rw [hB, AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply]
    exact (hO z w).1
  have hOl : ∀ u ∈ UE, ∀ v ∈ UC, B2 u v = 0 := by
    intro u hu v hv
    obtain ⟨z, rfl⟩ := hE2 u hu
    obtain ⟨w, rfl⟩ := hC2 v hv
    rw [hB2, AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply]
    exact (hO z w).2
  have hradR : ∀ v, (∀ u ∈ UE, b (e.symm u) (e.symm v) = 0) ↔ v ∈ UC := by
    intro v
    have := LA B hSL hSR hOr v
    simp only [hB] at this
    exact this
  have hradL : ∀ v, (∀ u ∈ UE, b (e.symm v) (e.symm u) = 0) ↔ v ∈ UC := by
    intro v
    have := LA B2
      (fun v hv => hSR v (fun w => by have h := hv w; rw [hB2] at h; rw [hB]; exact h))
      (fun w hw => hSL w (fun v => by have h := hw v; rw [hB2] at h; rw [hB]; exact h)) hOl v
    simp only [hB2] at this
    exact this

  have hmemC : ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0,
      e y ∈ UC ↔ ∃ w : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
          (Subobject.underlying.obj (wcPencilC D ℓ hP)) 0,
        y = (Abelian.Ext.mk₀ (wcPencilC D ℓ hP).arrow).postcomp
          (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) w := by
    intro y
    constructor
    · intro hv
      obtain ⟨w, hw⟩ := hC2 _ hv
      exact ⟨w, e.injective hw.symm⟩
    · rintro ⟨w, rfl⟩
      exact hC1 w
  have keyL : ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0,
      (∀ z' : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
          (Subobject.underlying.obj (wcPencilE D ℓ hP)) 0,
        b y ((Abelian.Ext.mk₀ (wcPencilE D ℓ hP).arrow).postcomp
          (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) z') = 0) ↔ e y ∈ UC := by
    intro y
    rw [← hradL]
    constructor
    · intro h u hu
      obtain ⟨z', rfl⟩ := hE2 u hu
      rw [AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply]
      exact h z'
    · intro h z'
      have := h _ (hE1 z')
      rwa [AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply] at this
  have keyR : ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0,
      (∀ z' : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
          (Subobject.underlying.obj (wcPencilE D ℓ hP)) 0,
        b ((Abelian.Ext.mk₀ (wcPencilE D ℓ hP).arrow).postcomp
          (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) z') y = 0) ↔ e y ∈ UC := by
    intro y
    rw [← hradR]
    constructor
    · intro h u hu
      obtain ⟨z', rfl⟩ := hE2 u hu
      rw [AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply]
      exact h z'
    · intro h z'
      have := h _ (hE1 z')
      rwa [AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply] at this
  refine ⟨b, hL, hR, hF, fun z => ?_, fun z => ?_⟩
  · rw [keyL, hmemC, hint]
  · rw [keyR, hmemC, hint]

theorem wc_pencil_VQ_local_symplectic (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n) (hNM : wcPencilNoMixed D)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∀ d : ℕ, 1 ≤ d → ∀ x ∈ wcP1ClosedPt F'' d, (∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) →
      (wcPencilLoc D ℓ hP x d).map
          (fun γ => (Nat.card F'' : AlgebraicClosure ℚ_[ℓ]) ^ ((n - 1) * d) / γ) =
        wcPencilLoc D ℓ hP x d :=
by
  classical
  intro d hd x hx hS
  unfold wcPencilLoc
  by_cases h : Nonempty (wcPencilStalkBasis D ℓ hP x d)
  swap
  · rw [dif_neg h, Multiset.map_zero]
  rw [dif_pos h]
  obtain ⟨bR, hL, hR, hF, hRadL, hRadR⟩ :=
    wc_pencil_R_stalk_radical_form F' F'' Y n hn hn2 D hNM ℓ hℓ hP hNI d hd x hx hS h.some.N
  haveI hproj : Projective (wcFreeSheaf (wcP1Over F'').left h.some.N.V) := by
    letI := h.some.N.ringA
    letI := h.some.N.hensA
    letI := h.some.N.sepA
    exact wc_proet_free_projective_strict_local _ _ h.some.N.A h.some.N.e
  haveI hmono : Mono ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).ofLE (wcPencilE D ℓ hP)
      inf_le_left) :=
    mono_of_mono_fac (Subobject.ofLE_arrow _)
  have h5 := wc_ext0_projective_cokernel (P := wcFreeSheaf (wcP1Over F'').left h.some.N.V)
    ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).ofLE (wcPencilE D ℓ hP) inf_le_left)
  choose ψ hψ₁ hψ₂ using wc_pencil_VQScalar_spec F' F'' Y n D ℓ hP
  have hpp : ∀ {A B C : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (f : A ⟶ B) (g : B ⟶ C)
      (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left h.some.N.V) A 0),
      (Abelian.Ext.mk₀ g).postcomp (wcFreeSheaf (wcP1Over F'').left h.some.N.V) (add_zero 0)
          ((Abelian.Ext.mk₀ f).postcomp (wcFreeSheaf (wcP1Over F'').left h.some.N.V)
            (add_zero 0) y) =
        (Abelian.Ext.mk₀ (f ≫ g)).postcomp (wcFreeSheaf (wcP1Over F'').left h.some.N.V)
          (add_zero 0) y := by
    intro A B C f g y
