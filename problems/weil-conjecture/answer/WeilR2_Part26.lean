        ((toSheafify (Scheme.ProEt.topology Y') ((wcProEtBaseChange ι).op ⋙
          (wcFreeSheaf X' ((wcProEtPullback ι).obj V)).obj)).app (Opposite.op V)).hom
          (wcFreeGen X' ((wcProEtPullback ι).obj V)) := fun V => (hEv Y' V _).2 _
  choose c hc using hc_ex

  have hiso : ∀ V : Y'.ProEt, IsIso ((adj.homEquiv (wcFreeSheaf Y' V)
      (wcFreeSheaf X' ((wcProEtPullback ι).obj V))).symm (c V)) := by
    intro V
    have hgc : adj.homEquiv (wcFreeSheaf Y' V) (wcFreeSheaf X' ((wcProEtPullback ι).obj V))
        ((adj.homEquiv (wcFreeSheaf Y' V)
          (wcFreeSheaf X' ((wcProEtPullback ι).obj V))).symm (c V)) = c V :=
      Equiv.apply_symm_apply _ _
    apply isIso_of_coyoneda_map_bijective
    intro T
    haveI := hcont
    have hsheaf : Presheaf.IsSheaf (Scheme.ProEt.topology Y')
        ((wcProEtBaseChange ι).op ⋙ T.obj) :=
      Functor.op_comp_isSheaf (wcProEtBaseChange ι) (Scheme.ProEt.topology Y')
        (Scheme.ProEt.topology X') T
    haveI := isIso_toSheafify (Scheme.ProEt.topology Y') hsheaf
    have hτ : Function.Bijective (fun s => ((toSheafify (Scheme.ProEt.topology Y')
        ((wcProEtBaseChange ι).op ⋙ T.obj)).app (Opposite.op V)).hom s) :=
      ConcreteCategory.bijective_of_isIso _
    have key : ((fun h : wcFreeSheaf Y' V ⟶ (wcProEtPush ι).obj T =>
          (h.hom.app (Opposite.op V)).hom (wcFreeGen Y' V)) ∘
          (adj.homEquiv (wcFreeSheaf Y' V) T)) ∘
          (fun x => (adj.homEquiv (wcFreeSheaf Y' V)
            (wcFreeSheaf X' ((wcProEtPullback ι).obj V))).symm (c V) ≫ x) =
        (fun s => ((toSheafify (Scheme.ProEt.topology Y')
          ((wcProEtBaseChange ι).op ⋙ T.obj)).app (Opposite.op V)).hom s) ∘
        (fun x : wcFreeSheaf X' ((wcProEtPullback ι).obj V) ⟶ T =>
          (x.hom.app (Opposite.op ((wcProEtPullback ι).obj V))).hom
            (wcFreeGen X' ((wcProEtPullback ι).obj V))) := by
      funext x
      show (((adj.homEquiv (wcFreeSheaf Y' V) T)
          ((adj.homEquiv (wcFreeSheaf Y' V)
            (wcFreeSheaf X' ((wcProEtPullback ι).obj V))).symm (c V) ≫ x)).hom.app
            (Opposite.op V)).hom (wcFreeGen Y' V) = _
      rw [Adjunction.homEquiv_naturality_right, hgc]
      show (((wcProEtPush ι).map x).hom.app (Opposite.op V)).hom
          (((c V).hom.app (Opposite.op V)).hom (wcFreeGen Y' V)) = _
      rw [hc V]
      exact hB x V _
    have hL : Function.Bijective ((fun h : wcFreeSheaf Y' V ⟶ (wcProEtPush ι).obj T =>
          (h.hom.app (Opposite.op V)).hom (wcFreeGen Y' V)) ∘
          (adj.homEquiv (wcFreeSheaf Y' V) T)) :=
      (hEv Y' V _).comp (adj.homEquiv _ _).bijective
    have hR := hτ.comp (hEv X' ((wcProEtPullback ι).obj V) T)
    rw [← key] at hR
    exact (Function.Bijective.of_comp_iff' hL _).mp hR

  have hnatc : ∀ {V V' : Y'.ProEt} (f : V ⟶ V'),
      wcFreeSheafMap Y' f ≫ c V' =
        c V ≫ (wcProEtPush ι).map (wcFreeSheafMap X' ((wcProEtPullback ι).map f)) := by
    intro V V' f
    apply (hEv Y' V _).1
    show ((c V').hom.app (Opposite.op V)).hom
        (((wcFreeSheafMap Y' f).hom.app (Opposite.op V)).hom (wcFreeGen Y' V)) =
      (((wcProEtPush ι).map (wcFreeSheafMap X' ((wcProEtPullback ι).map f))).hom.app
        (Opposite.op V)).hom (((c V).hom.app (Opposite.op V)).hom (wcFreeGen Y' V))
    have hnat := congrArg (fun φ => φ.hom (wcFreeGen Y' V')) ((c V').hom.naturality f.op)
    have hnat2 := congrArg (fun φ => φ.hom (wcFreeGen X' ((wcProEtPullback ι).obj V')))
      ((toSheafify (Scheme.ProEt.topology Y') ((wcProEtBaseChange ι).op ⋙
          (wcFreeSheaf X' ((wcProEtPullback ι).obj V')).obj)).naturality f.op)
    calc ((c V').hom.app (Opposite.op V)).hom
          (((wcFreeSheafMap Y' f).hom.app (Opposite.op V)).hom (wcFreeGen Y' V))
        = ((c V').hom.app (Opposite.op V)).hom
          (((wcFreeSheaf Y' V').obj.map f.op).hom (wcFreeGen Y' V')) := by rw [hA Y' f]
      _ = ((((wcProEtPush ι).obj (wcFreeSheaf X' ((wcProEtPullback ι).obj V'))).obj.map
