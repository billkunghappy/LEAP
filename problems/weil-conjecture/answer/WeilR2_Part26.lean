    have e2 : adj.homEquiv (wcFreeSheaf Y' V) (wcFreeSheaf X' ((wcProEtPullback ι).obj V'))
        ((adj.homEquiv (wcFreeSheaf Y' V) (wcFreeSheaf X' ((wcProEtPullback ι).obj V))).symm (c V) ≫
          wcFreeSheafMap X' ((wcProEtPullback ι).map f)) =
        c V ≫ (wcProEtPush ι).map (wcFreeSheafMap X' ((wcProEtPullback ι).map f)) := by
      rw [Adjunction.homEquiv_naturality_right, Equiv.apply_symm_apply]
    show L.map (wcFreeSheafMap Y' f) ≫ (adj.homEquiv (wcFreeSheaf Y' V')
          (wcFreeSheaf X' ((wcProEtPullback ι).obj V'))).symm (c V') =
        (adj.homEquiv (wcFreeSheaf Y' V) (wcFreeSheaf X' ((wcProEtPullback ι).obj V))).symm (c V) ≫
          wcFreeSheafMap X' ((wcProEtPullback ι).map f)
    apply (adj.homEquiv (wcFreeSheaf Y' V) (wcFreeSheaf X' ((wcProEtPullback ι).obj V'))).injective
    rw [e1, e2]
