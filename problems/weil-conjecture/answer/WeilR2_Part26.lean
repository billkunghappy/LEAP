      _ = (((wcProEtPush ι).map (wcFreeSheafMap X' ((wcProEtPullback ι).map f))).hom.app
            (Opposite.op V)).hom (((c V).hom.app (Opposite.op V)).hom (wcFreeGen Y' V)) := by
          rw [hc V]
          exact (hB _ V _).symm

  refine ⟨fun V => @asIso _ _ _ _ ((adj.homEquiv (wcFreeSheaf Y' V)
      (wcFreeSheaf X' ((wcProEtPullback ι).obj V))).symm (c V)) (hiso V), ?_, ?_⟩
  · unfold wcPushThetaNorm
    intro V
    exact (congrArg (fun φ => (φ.hom.app (Opposite.op V)).hom (wcFreeGen Y' V))
      (Equiv.apply_symm_apply (adj.homEquiv (wcFreeSheaf Y' V)
        (wcFreeSheaf X' ((wcProEtPullback ι).obj V))) (c V))).trans (hc V)
  · intro V V' f
    have e1 : adj.homEquiv (wcFreeSheaf Y' V) (wcFreeSheaf X' ((wcProEtPullback ι).obj V'))
        (L.map (wcFreeSheafMap Y' f) ≫ (adj.homEquiv (wcFreeSheaf Y' V')
          (wcFreeSheaf X' ((wcProEtPullback ι).obj V'))).symm (c V')) =
        wcFreeSheafMap Y' f ≫ c V' := by
