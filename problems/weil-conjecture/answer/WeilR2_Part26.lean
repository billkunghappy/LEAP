        ⟨Matrix.of w0, hI0⟩ (fun p s => ⟨F p s.1 s.2, hF2 p s.1 s.2⟩) p
    refine ⟨fun p => (seq p).1, hH0, fun p => ?_⟩
    show F p (seq p).1 (seq p).2 * Rs.c (p + 1) + Rs.c p * (seq p).1 = _
    rw [hF1, sub_add_cancel]
  obtain ⟨H, hH0, hH⟩ := hHex

  have hmono := wc_chmp_cover_nsmul_mono (q' ≫ Uo.ι)
    (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ℓ (Fact.out : ℓ.Prime).pos
  obtain ⟨hi, hℓH⟩ := wc_cgev_K_ell_null ℓ hmono lamF hlamF Rs H hH0 hH

  obtain ⟨E, hE⟩ := wc_cover_sheaf_mod_ell_classical K ℓ hℓ m S hS Uo hUo q' Γ α hG hα
  obtain ⟨Hs, hHs, hiso⟩ :=
    wc_cgev_K_H1_classical (wcP1Over K).left ℓ hmono lamF hlamF Rs hi hℓH ⟨E, hE⟩
  refine ⟨hi, ?_, Hs, hHs, hiso⟩

  obtain ⟨lamP, hlamP, hFP, hPact, hPscal⟩ :=
    wc_cover_presheaf_ring_action K ℓ m S hS Uo hUo q' Γ α hG hα lamF hlamF hlamFs
  intro p hp
  obtain ⟨p', rfl⟩ : ∃ p', p = p' + 2 := ⟨p - 2, by omega⟩
  refine wc_cgev_sheafify_exact_of_local (wcP1Over K).left
    (wcCcPre (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ)
    lamP hlamP lamF hlamF hFP N Rs (fun T => ∃ t : T.left ⟶ V, T.hom = t ≫ q' ≫ Uo.ι)
    ?_ ?_ ?_ p'
  · intro T T' f hT
    obtain ⟨t, ht⟩ := hT
