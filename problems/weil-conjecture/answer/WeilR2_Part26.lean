    have hfac : wcFreeSheafMap (wcP1Over K).left g ≫
        Limits.cokernel.π (wcFreeSheafMap (wcP1Over K).left (wcPunctIncl K (S i0) hP)) =
        wcFreeSheafMap (wcP1Over K).left cc.hom ≫
          Limits.cokernel.π (wcFreeSheafMap (wcP1Over K).left
            (wcOpenRestrIncl (wcP1Over K).left (wcPunctOpen K (S i0)) V₀)) ≫ κ := by
      rw [hπκ, ← Category.assoc, hfun, hcc]
    have hfac' : ∀ c' : Limits.cokernel (wcFreeSheafMap (wcP1Over K).left
        (wcPunctIncl K (S i0) hP)) ⟶ G,
        wcFreeSheafMap (wcP1Over K).left g ≫
          Limits.cokernel.π (wcFreeSheafMap (wcP1Over K).left (wcPunctIncl K (S i0) hP)) ≫ c' =
        wcFreeSheafMap (wcP1Over K).left cc.hom ≫
          Limits.cokernel.π (wcFreeSheafMap (wcP1Over K).left
            (wcOpenRestrIncl (wcP1Over K).left (wcPunctOpen K (S i0)) V₀)) ≫ κ ≫ c' := by
      intro c'
      have := congrArg (fun t => t ≫ c') hfac
      simpa only [Category.assoc] using this
    have hinv : wcFreeSheafMap (wcP1Over K).left cc.inv ≫
        wcFreeSheafMap (wcP1Over K).left cc.hom = 𝟙 _ := by
      rw [hfun, cc.inv_hom_id, hid]
    have hhom : wcFreeSheafMap (wcP1Over K).left cc.hom ≫
        wcFreeSheafMap (wcP1Over K).left cc.inv = 𝟙 _ := by
      rw [hfun, cc.hom_inv_id, hid]
    refine ⟨fun c' hc' => ?_, fun h => ?_⟩
    · exact abs_inj (wcFreeSheafMap (wcP1Over K).left cc.hom)
        (wcFreeSheafMap (wcP1Over K).left cc.inv)
        (wcFreeSheafMap (wcP1Over K).left
          (wcOpenRestrIncl (wcP1Over K).left (wcPunctOpen K (S i0)) V₀)) κ c' hinv
        ((hfac' c').symm.trans hc')
    · have hz : wcFreeSheafMap (wcP1Over K).left
          (wcOpenRestrIncl (wcP1Over K).left (wcPunctOpen K (S i0)) V₀) ≫
          wcFreeSheafMap (wcP1Over K).left cc.inv ≫ h = 0 := hzeroT _ hVT _
      obtain ⟨c', hc'⟩ := abs_surj (wcFreeSheafMap (wcP1Over K).left cc.hom)
        (wcFreeSheafMap (wcP1Over K).left cc.inv)
        (wcFreeSheafMap (wcP1Over K).left
          (wcOpenRestrIncl (wcP1Over K).left (wcPunctOpen K (S i0)) V₀)) κ h hhom hz
      exact ⟨c', (hfac' c').trans hc'⟩

  have hT'O : ∀ (O : (wcP1Over K).left.Opens) (T : (wcP1Over K).left.ProEt)
      (t' : (wcOpenRestr (wcP1Over K).left O T).left),
      (wcOpenRestr (wcP1Over K).left O T).hom t' ∈ (O : Set (wcP1Over K).left) := by
    intro O T t'
    have key : ∀ p : ↥(Limits.pullback O.ι T.hom),
        (Limits.pullback.snd O.ι T.hom ≫ T.hom) p ∈ (O : Set (wcP1Over K).left) := by
      intro p
      rw [← Limits.pullback.condition, Scheme.Hom.comp_apply, ← Scheme.Opens.range_ι O]
      exact Set.mem_range_self _
    exact key t'
  have hnotO : ∀ u0 : Spec (.of K) ⟶ (wcP1Over K).left,
      u0 (IsLocalRing.closedPoint K) ∉ (wcPunctOpen K u0 : Set (wcP1Over K).left) := by
    intro u0 h
    have h' : u0 (IsLocalRing.closedPoint K) ∈
        (closure {u0 (IsLocalRing.closedPoint K)})ᶜ := h
    exact h' (subset_closure (Set.mem_singleton _))
  let H : (wcP1Over K).left.ProEt → Finset (Fin m) := fun T =>
    Finset.univ.filter (fun i => ∃ t : T.left, T.hom t = S i (IsLocalRing.closedPoint K))
  have hmemH : ∀ (T : (wcP1Over K).left.ProEt) (i : Fin m),
      i ∈ H T ↔ ∃ t : T.left, T.hom t = S i (IsLocalRing.closedPoint K) := by
    intro T i
    simp only [H, Finset.mem_filter, Finset.mem_univ, true_and]
  have hcardlt : ∀ (T : (wcP1Over K).left.ProEt) (i0 : Fin m) (t0 : T.left),
      T.hom t0 = S i0 (IsLocalRing.closedPoint K) →
      (H (wcOpenRestr (wcP1Over K).left (wcPunctOpen K (S i0)) T)).card < (H T).card := by
    intro T i0 t0 ht0
    have hsub : H (wcOpenRestr (wcP1Over K).left (wcPunctOpen K (S i0)) T) ⊆ H T := by
      intro i hi
      rw [hmemH] at hi ⊢
      obtain ⟨t', ht'⟩ := hi
      refine ⟨(wcOpenRestrIncl (wcP1Over K).left (wcPunctOpen K (S i0)) T).left t', ?_⟩
      rw [← ht', ← MorphismProperty.Over.w
        (wcOpenRestrIncl (wcP1Over K).left (wcPunctOpen K (S i0)) T), Scheme.Hom.comp_apply]
    have hi0 : i0 ∈ H T := (hmemH T i0).mpr ⟨t0, ht0⟩
    have hi0' : i0 ∉ H (wcOpenRestr (wcP1Over K).left (wcPunctOpen K (S i0)) T) := by
      intro hi
      rw [hmemH] at hi
      obtain ⟨t', ht'⟩ := hi
      have h1 := hT'O (wcPunctOpen K (S i0)) T t'
      rw [ht'] at h1
      exact hnotO (S i0) h1
    exact Finset.card_lt_card ((Finset.ssubset_iff_of_subset hsub).mpr ⟨i0, hi0, hi0'⟩)
  have hoi : ∀ (T : (wcP1Over K).left.ProEt) (g : T ⟶ wcGeomPoint K (wcP1Over K) hP),
      IsOpenImmersion g.left → ∀ O : (wcP1Over K).left.Opens,
      IsOpenImmersion (wcOpenRestrIncl (wcP1Over K).left O T ≫ g).left := by
    intro T g hg O
    have e : (wcOpenRestrIncl (wcP1Over K).left O T ≫ g).left =
        Limits.pullback.snd O.ι T.hom ≫ g.left := rfl
    rw [e]
    haveI := hg
    haveI hsnd : IsOpenImmersion (Limits.pullback.snd O.ι T.hom) := by
      first
        | infer_instance
        | exact MorphismProperty.pullback_snd (P := @IsOpenImmersion) _ _ inferInstance
    exact @IsOpenImmersion.comp _ _ _ _ _ hsnd hg
  have hsum : ∀ (i0 : Fin m)
      (c' : ∀ i : Fin m, Limits.cokernel (wcFreeSheafMap (wcP1Over K).left
        (wcPunctIncl K (S i) hP)) ⟶ G)
      (d : Limits.cokernel (wcFreeSheafMap (wcP1Over K).left (wcPunctIncl K (S i0) hP)) ⟶ G),
      ∑ i, Limits.cokernel.π (wcFreeSheafMap (wcP1Over K).left (wcPunctIncl K (S i) hP)) ≫
          (c' + (Pi.single i0 d : ∀ i : Fin m, Limits.cokernel (wcFreeSheafMap (wcP1Over K).left
            (wcPunctIncl K (S i) hP)) ⟶ G)) i =
        (∑ i, Limits.cokernel.π (wcFreeSheafMap (wcP1Over K).left (wcPunctIncl K (S i) hP)) ≫
          c' i) +
        Limits.cokernel.π (wcFreeSheafMap (wcP1Over K).left (wcPunctIncl K (S i0) hP)) ≫ d := by
    intro i0 c' d
    simp only [Pi.add_apply, Preadditive.comp_add, Finset.sum_add_distrib]
    congr 1
    rw [Finset.sum_eq_single i0]
    · rw [Pi.single_eq_same]
    · intro i _ hi
      first
        | rw [Pi.single_eq_of_ne hi, Limits.comp_zero]
        | simp [hi]
    · intro h
      exact absurd (Finset.mem_univ i0) h
  have claim : ∀ N : ℕ, ∀ (T : (wcP1Over K).left.ProEt)
      (g : T ⟶ wcGeomPoint K (wcP1Over K) hP), IsOpenImmersion g.left → (H T).card ≤ N →
      ∀ x : wcFreeSheaf (wcP1Over K).left T ⟶ G,
      ∃ c : ∀ i : Fin m, Limits.cokernel (wcFreeSheafMap (wcP1Over K).left
          (wcPunctIncl K (S i) hP)) ⟶ G,
        x = wcFreeSheafMap (wcP1Over K).left g ≫
          ∑ i, Limits.cokernel.π (wcFreeSheafMap (wcP1Over K).left (wcPunctIncl K (S i) hP)) ≫
            c i := by
    intro N
    induction N with
    | zero =>
      intro T g _ hcard x
      refine ⟨fun _ => 0, ?_⟩
      have hav : ∀ (t : T.left) (i : Fin m), T.hom t ≠ S i (IsLocalRing.closedPoint K) := by
        intro t i hti
        have hmem : i ∈ H T := (hmemH T i).mpr ⟨t, hti⟩
        have := Finset.card_pos.mpr ⟨i, hmem⟩
        omega
      rw [hzeroT T hav x]
      simp
    | succ N ih =>
      intro T g hg hcard x
      by_cases hav : ∀ (t : T.left) (i : Fin m), T.hom t ≠ S i (IsLocalRing.closedPoint K)
      · refine ⟨fun _ => 0, ?_⟩
        rw [hzeroT T hav x]
        simp
      push_neg at hav
      obtain ⟨t0, i0, ht0⟩ := hav
      obtain ⟨c', hc'⟩ := ih _ (wcOpenRestrIncl (wcP1Over K).left (wcPunctOpen K (S i0)) T ≫ g)
        (hoi T g hg _) (by have := hcardlt T i0 t0 ht0; omega)
        (wcFreeSheafMap (wcP1Over K).left
          (wcOpenRestrIncl (wcP1Over K).left (wcPunctOpen K (S i0)) T) ≫ x)
      have hρ : wcFreeSheafMap (wcP1Over K).left
          (wcOpenRestrIncl (wcP1Over K).left (wcPunctOpen K (S i0)) T) ≫
          (x - wcFreeSheafMap (wcP1Over K).left g ≫
            ∑ i, Limits.cokernel.π (wcFreeSheafMap (wcP1Over K).left (wcPunctIncl K (S i) hP)) ≫
              c' i) = 0 := by
        rw [Preadditive.comp_sub, hc', ← hfun, Category.assoc, sub_self]
      obtain ⟨κ₁, hκ₁, hπ⟩ := wc_P1bar_open_punct_excision K (S i0) (hS i0) hP T g hg ⟨t0, ht0⟩
      haveI := hκ₁
      have hd : wcFreeSheafMap (wcP1Over K).left g ≫
          Limits.cokernel.π (wcFreeSheafMap (wcP1Over K).left (wcPunctIncl K (S i0) hP)) ≫
            inv κ₁ ≫ Limits.cokernel.desc _ _ hρ =
          x - wcFreeSheafMap (wcP1Over K).left g ≫
            ∑ i, Limits.cokernel.π (wcFreeSheafMap (wcP1Over K).left (wcPunctIncl K (S i) hP)) ≫
              c' i := by
        rw [← Category.assoc, ← hπ, Category.assoc, IsIso.hom_inv_id_assoc,
          Limits.cokernel.π_desc]
      refine ⟨c' + (Pi.single i0 (inv κ₁ ≫ Limits.cokernel.desc _ _ hρ) :
        ∀ i : Fin m, Limits.cokernel (wcFreeSheafMap (wcP1Over K).left
          (wcPunctIncl K (S i) hP)) ⟶ G), ?_⟩
      rw [hsum, Preadditive.comp_add, hd]
      abel
  have hgen : ∀ f : wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP) ⟶ G,
      ∃ c : ∀ i : Fin m, Limits.cokernel (wcFreeSheafMap (wcP1Over K).left
          (wcPunctIncl K (S i) hP)) ⟶ G,
        f = ∑ i, Limits.cokernel.π (wcFreeSheafMap (wcP1Over K).left (wcPunctIncl K (S i) hP)) ≫
          c i := by
    intro f
    obtain ⟨c, hc⟩ := claim m (wcGeomPoint K (wcP1Over K) hP) (𝟙 _)
      (by
        show IsOpenImmersion (𝟙 (wcGeomPoint K (wcP1Over K) hP).left)
        infer_instance)
      ((Finset.card_le_univ _).trans (Fintype.card_fin m).le) f
    refine ⟨c, ?_⟩
    rw [hc, hid, Category.id_comp]

  refine ⟨?_, ?_⟩
  · apply wc_proet_P1_finite_supp_ext_vanish K hP m S hS G _ 1 le_rfl
    intro V hV s
    obtain ⟨eF, -, hzero⟩ := proet_free_sheaf_hom_equiv (wcP1Over K).left V
    have hφ : (eF G).symm s = 0 := hzeroT V hV _
    rw [← (eF G).apply_symm_apply s, hφ, hzero G]
  · intro V A _ _ _ e hx g
    have hcr : ∀ (i k : Fin m), i ≠ k → wcFreeSheafMap (wcP1Over K).left (g i) ≫
        Limits.cokernel.π (wcFreeSheafMap (wcP1Over K).left (wcPunctIncl K (S k) hP)) = 0 := by
      intro i k hik
      apply hcross (S k) (hS k) (V i) (A i) (e i) _ (g i)
      rw [hx i]
      intro h
      exact hik (hSinj h)
    have hsumg : ∀ (i : Fin m) (c : ∀ k : Fin m, Limits.cokernel (wcFreeSheafMap (wcP1Over K).left
          (wcPunctIncl K (S k) hP)) ⟶ G),
        wcFreeSheafMap (wcP1Over K).left (g i) ≫
          ∑ k, Limits.cokernel.π (wcFreeSheafMap (wcP1Over K).left (wcPunctIncl K (S k) hP)) ≫
            c k =
        wcFreeSheafMap (wcP1Over K).left (g i) ≫
          Limits.cokernel.π (wcFreeSheafMap (wcP1Over K).left (wcPunctIncl K (S i) hP)) ≫ c i := by
      intro i c
      rw [Preadditive.comp_sum, Finset.sum_eq_single i]
      · intro k _ hk
        rw [← Category.assoc, hcr i k (Ne.symm hk), Limits.zero_comp]
      · intro h
        exact absurd (Finset.mem_univ i) h
    constructor
    · intro y₁ y₂ hy
      obtain ⟨f₁, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y₁
      obtain ⟨f₂, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y₂
      suffices hf : f₁ = f₂ by rw [hf]
      have hgi : ∀ i, wcFreeSheafMap (wcP1Over K).left (g i) ≫ (f₁ - f₂) = 0 := by
        intro i
        have h1 := congrFun hy i
        simp only [Abelian.Ext.mk₀_comp_mk₀] at h1
        rw [Preadditive.comp_sub, (Abelian.Ext.mk₀_bijective _ _).1 h1, sub_self]
      obtain ⟨c, hc⟩ := hgen (f₁ - f₂)
      have hci : ∀ i, c i = 0 := by
        intro i
        apply (hloc i (V i) (A i) (e i) (hx i) (g i)).1
        rw [← hsumg i c, ← hc, hgi i]
      rw [← sub_eq_zero, hc]
      simp [hci]
    · intro w
      have hw : ∀ i, ∃ c : Limits.cokernel (wcFreeSheafMap (wcP1Over K).left
          (wcPunctIncl K (S i) hP)) ⟶ G,
          Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (g i) ≫
            Limits.cokernel.π (wcFreeSheafMap (wcP1Over K).left (wcPunctIncl K (S i) hP)) ≫ c) =
          w i := by
        intro i
        obtain ⟨h, hh⟩ := (Abelian.Ext.mk₀_bijective _ _).2 (w i)
        obtain ⟨c, hc⟩ := (hloc i (V i) (A i) (e i) (hx i) (g i)).2 h
        exact ⟨c, by rw [hc, hh]⟩
      choose c hc using hw
      refine ⟨Abelian.Ext.mk₀ (∑ i, Limits.cokernel.π (wcFreeSheafMap (wcP1Over K).left
        (wcPunctIncl K (S i) hP)) ≫ c i), ?_⟩
      funext i
      simp only [Abelian.Ext.mk₀_comp_mk₀]
      rw [hsumg i c, hc i]

theorem wc_pi_addEquiv_charpoly_aroots {V : Type*} [AddCommGroup V] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (sV : ℚ_[ℓ] → V →+ V) (ΦV : V →+ V) (m : ℕ) (W : Fin m → Type*)
    [∀ j, AddCommGroup (W j)]
    (sW : ∀ j, ℚ_[ℓ] → W j →+ W j) (ΦW : ∀ j, W j →+ W j)
    (τ : V ≃+ ((j : Fin m) → W j))
    (hτs : ∀ (c : ℚ_[ℓ]) (v : V) (j : Fin m), τ (sV c v) j = sW j c (τ v j))
    (hτΦ : ∀ (v : V) (j : Fin m), τ (ΦV v) j = ΦW j (τ v j))
    (r : Fin m → ℕ) (e : ∀ j, W j ≃+ (Fin (r j) → ℚ_[ℓ]))
    (he : ∀ (j : Fin m) (c : ℚ_[ℓ]) (w : W j), e j (sW j c w) = c • e j w) :
    ∃ (R : ℕ) (eV : V ≃+ (Fin R → ℚ_[ℓ])), (∀ (c : ℚ_[ℓ]) (v : V), eV (sV c v) = c • eV v) ∧
      (wcAddEquivMatrix eV ΦV).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) =
        ∑ j, (wcAddEquivMatrix (e j) (ΦW j)).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) :=
by

  have two : ∀ (A B : Type u_2) [AddCommGroup A] [AddCommGroup B] (a b : ℕ)
      (s₁ : ℚ_[ℓ] → A →+ A) (s₂ : ℚ_[ℓ] → B →+ B) (Φ₁ : A →+ A) (Φ₂ : B →+ B)
      (e₁ : A ≃+ (Fin a → ℚ_[ℓ])) (e₂ : B ≃+ (Fin b → ℚ_[ℓ]))
      (_he₁ : ∀ (c : ℚ_[ℓ]) (w : A), e₁ (s₁ c w) = c • e₁ w)
      (_he₂ : ∀ (c : ℚ_[ℓ]) (w : B), e₂ (s₂ c w) = c • e₂ w),
      ∃ e₁₂ : A × B ≃+ (Fin (a + b) → ℚ_[ℓ]),
        (∀ (c : ℚ_[ℓ]) (w : A × B), e₁₂ (s₁ c w.1, s₂ c w.2) = c • e₁₂ w) ∧
        (wcAddEquivMatrix e₁₂ (Φ₁.prodMap Φ₂)).charpoly =
          (wcAddEquivMatrix e₁ Φ₁).charpoly * (wcAddEquivMatrix e₂ Φ₂).charpoly := by
    intro A B _ _ a b s₁ s₂ Φ₁ Φ₂ e₁ e₂ he₁ he₂
    let ι : Fin a ⊕ Fin b ≃ Fin (a + b) := finSumFinEquiv
    let e₁₂ : A × B ≃+ (Fin (a + b) → ℚ_[ℓ]) :=
      { toFun := fun w k => Sum.elim (e₁ w.1) (e₂ w.2) (ι.symm k)
        invFun := fun z => (e₁.symm (fun i => z (ι (Sum.inl i))),
          e₂.symm (fun i => z (ι (Sum.inr i))))
        left_inv := fun w => by
          simp only [Equiv.symm_apply_apply, Sum.elim_inl, Sum.elim_inr,
            AddEquiv.symm_apply_apply]
        right_inv := fun z => by
          funext k
          obtain ⟨t, rfl⟩ := ι.surjective k
          cases t <;> simp only [Equiv.symm_apply_apply, Sum.elim_inl, Sum.elim_inr,
            AddEquiv.apply_symm_apply]
        map_add' := fun w w' => by
          funext k
          obtain ⟨t, rfl⟩ := ι.surjective k
          cases t <;> simp }
    have hE : ∀ (w : A × B) (t : Fin a ⊕ Fin b),
        e₁₂ w (ι t) = Sum.elim (e₁ w.1) (e₂ w.2) t := fun w t => by
      show Sum.elim (e₁ w.1) (e₂ w.2) (ι.symm (ι t)) = _
      rw [Equiv.symm_apply_apply]
    have hEs : ∀ z, e₁₂.symm z = (e₁.symm (fun i => z (ι (Sum.inl i))),
        e₂.symm (fun i => z (ι (Sum.inr i)))) := fun z => rfl
    refine ⟨e₁₂, ?_, ?_⟩
    · intro c w
      funext k
      obtain ⟨t, rfl⟩ := ι.surjective k
      rw [Pi.smul_apply, hE, hE]
      cases t <;> simp [he₁, he₂]
    · have hsingle : ∀ (t s : Fin a ⊕ Fin b),
          (Pi.single (ι t) (1 : ℚ_[ℓ]) : Fin (a + b) → ℚ_[ℓ]) (ι s) =
            (Pi.single t (1 : ℚ_[ℓ]) : Fin a ⊕ Fin b → ℚ_[ℓ]) s := by
        intro t s
        simp only [Pi.single_apply, ι.injective.eq_iff]
      have hll : ∀ j : Fin a, (fun i : Fin a =>
          (Pi.single (Sum.inl j : Fin a ⊕ Fin b) (1 : ℚ_[ℓ]) : Fin a ⊕ Fin b → ℚ_[ℓ]) (Sum.inl i)) =
            Pi.single j 1 := by
        intro j; funext i; simp [Pi.single_apply]
      have hlr : ∀ j : Fin a, (fun i : Fin b =>
          (Pi.single (Sum.inl j : Fin a ⊕ Fin b) (1 : ℚ_[ℓ]) : Fin a ⊕ Fin b → ℚ_[ℓ]) (Sum.inr i)) =
            0 := by
        intro j; funext i; simp [Pi.single_apply]
      have hrl : ∀ j : Fin b, (fun i : Fin a =>
          (Pi.single (Sum.inr j : Fin a ⊕ Fin b) (1 : ℚ_[ℓ]) : Fin a ⊕ Fin b → ℚ_[ℓ]) (Sum.inl i)) =
            0 := by
        intro j; funext i; simp [Pi.single_apply]
      have hrr : ∀ j : Fin b, (fun i : Fin b =>
          (Pi.single (Sum.inr j : Fin a ⊕ Fin b) (1 : ℚ_[ℓ]) : Fin a ⊕ Fin b → ℚ_[ℓ]) (Sum.inr i)) =
            Pi.single j 1 := by
        intro j; funext i; simp [Pi.single_apply]
      have hcol : ∀ t : Fin a ⊕ Fin b, e₁₂.symm (Pi.single (ι t) 1) =
          (e₁.symm (fun i => (Pi.single t (1 : ℚ_[ℓ]) : Fin a ⊕ Fin b → ℚ_[ℓ]) (Sum.inl i)),
            e₂.symm (fun i => (Pi.single t (1 : ℚ_[ℓ]) : Fin a ⊕ Fin b → ℚ_[ℓ]) (Sum.inr i))) := by
        intro t
        rw [hEs]
        simp only [hsingle]
      have hblock : (wcAddEquivMatrix e₁₂ (Φ₁.prodMap Φ₂)).submatrix ι ι =
          Matrix.fromBlocks (wcAddEquivMatrix e₁ Φ₁) 0 0 (wcAddEquivMatrix e₂ Φ₂) := by
        ext s t
        rw [Matrix.submatrix_apply]
        simp only [wcAddEquivMatrix, Matrix.of_apply]
        rw [hcol, AddMonoidHom.coe_prodMap, Prod.map_apply, hE]
        have hza : ∀ x, e₁ (Φ₁ (e₁.symm (fun _ : Fin a => (0 : ℚ_[ℓ])))) x = 0 := by
          intro x
          rw [show (fun _ : Fin a => (0 : ℚ_[ℓ])) = 0 from rfl, map_zero, map_zero, map_zero]
          rfl
        have hzb : ∀ x, e₂ (Φ₂ (e₂.symm (fun _ : Fin b => (0 : ℚ_[ℓ])))) x = 0 := by
          intro x
          rw [show (fun _ : Fin b => (0 : ℚ_[ℓ])) = 0 from rfl, map_zero, map_zero, map_zero]
          rfl
        cases s <;> cases t <;>
          simp [hll, hlr, hrl, hrr, hza, hzb, Matrix.fromBlocks_apply₁₁, Matrix.fromBlocks_apply₁₂,
            Matrix.fromBlocks_apply₂₁, Matrix.fromBlocks_apply₂₂]
      calc (wcAddEquivMatrix e₁₂ (Φ₁.prodMap Φ₂)).charpoly
          = (Matrix.reindex ι.symm ι.symm (wcAddEquivMatrix e₁₂ (Φ₁.prodMap Φ₂))).charpoly :=
            (Matrix.charpoly_reindex _ _).symm
        _ = (Matrix.fromBlocks (wcAddEquivMatrix e₁ Φ₁) 0 0 (wcAddEquivMatrix e₂ Φ₂)).charpoly := by
            rw [Matrix.reindex_apply, Equiv.symm_symm, hblock]
        _ = _ := Matrix.charpoly_fromBlocks_zero₁₂ _ _ _

  have core : ∀ (k : ℕ) (X : Fin k → Type u_2) [∀ j, AddCommGroup (X j)]
      (sX : ∀ j, ℚ_[ℓ] → X j →+ X j) (ΦX : ∀ j, X j →+ X j) (rX : Fin k → ℕ)
      (eX : ∀ j, X j ≃+ (Fin (rX j) → ℚ_[ℓ]))
      (_heX : ∀ (j : Fin k) (c : ℚ_[ℓ]) (w : X j), eX j (sX j c w) = c • eX j w),
      ∃ (R : ℕ) (eP : ((j : Fin k) → X j) ≃+ (Fin R → ℚ_[ℓ])),
        (∀ (c : ℚ_[ℓ]) (x : (j : Fin k) → X j), eP (fun j => sX j c (x j)) = c • eP x) ∧
        (wcAddEquivMatrix eP (AddMonoidHom.piMap ΦX)).charpoly.aroots
            (AlgebraicClosure ℚ_[ℓ]) =
          ∑ j, (wcAddEquivMatrix (eX j) (ΦX j)).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) := by
    intro k
    induction k with
    | zero =>
      intro X _ sX ΦX rX eX heX
      let eP : ((j : Fin 0) → X j) ≃+ (Fin 0 → ℚ_[ℓ]) :=
        { toFun := fun _ => 0
          invFun := fun _ j => j.elim0
          left_inv := fun x => funext fun j => j.elim0
          right_inv := fun z => funext fun i => i.elim0
          map_add' := fun _ _ => funext fun i => i.elim0 }
      refine ⟨0, eP, fun c x => funext fun i => i.elim0, ?_⟩
      rw [Matrix.charpoly_isEmpty, Polynomial.aroots_one, Fin.sum_univ_zero]
    | succ k ih =>
      intro X _ sX ΦX rX eX heX
      obtain ⟨R', eP', heP', hroots'⟩ := ih (fun i => X i.succ) (fun i => sX i.succ)
        (fun i => ΦX i.succ) (fun i => rX i.succ) (fun i => eX i.succ) (fun i => heX i.succ)
      obtain ⟨e₁₂, he₁₂, hcp⟩ := two (X 0) ((i : Fin k) → X i.succ) (rX 0) R' (sX 0)
        (fun c => AddMonoidHom.piMap (fun i => sX i.succ c)) (ΦX 0)
        (AddMonoidHom.piMap (fun i => ΦX i.succ)) (eX 0) eP' (heX 0)
        (fun c w => heP' c w)
      let κ : ((j : Fin (k + 1)) → X j) ≃+ (X 0 × ((i : Fin k) → X i.succ)) :=
        { toFun := fun x => (x 0, fun i => x i.succ)
          invFun := fun p => Fin.cons p.1 p.2
          left_inv := fun x => Fin.cons_self_tail x
          right_inv := fun p => Prod.ext (by exact Fin.cons_zero (α := X) p.1 p.2)
            (funext fun i => by exact Fin.cons_succ (α := X) p.1 p.2 i)
          map_add' := fun x y => rfl }
      refine ⟨rX 0 + R', κ.trans e₁₂, ?_, ?_⟩
      · intro c x
        exact he₁₂ c (κ x)
      · have hM : wcAddEquivMatrix (κ.trans e₁₂) (AddMonoidHom.piMap ΦX) =
            wcAddEquivMatrix e₁₂ ((ΦX 0).prodMap (AddMonoidHom.piMap (fun i => ΦX i.succ))) := by
          ext a b
          simp only [wcAddEquivMatrix, Matrix.of_apply, AddEquiv.trans_apply,
            AddEquiv.symm_trans_apply]
          have hκ : ∀ y, κ (AddMonoidHom.piMap ΦX (κ.symm y)) =
              ((ΦX 0).prodMap (AddMonoidHom.piMap (fun i => ΦX i.succ))) (κ (κ.symm y)) :=
            fun y => rfl
          rw [hκ, AddEquiv.apply_symm_apply]
        have hmon : ((wcAddEquivMatrix (eX 0) (ΦX 0)).charpoly *
            (wcAddEquivMatrix eP' (AddMonoidHom.piMap (fun i => ΦX i.succ))).charpoly) ≠ 0 :=
          ((Matrix.charpoly_monic _).mul (Matrix.charpoly_monic _)).ne_zero
        rw [hM, hcp, Polynomial.aroots_mul hmon, hroots', Fin.sum_univ_succ]

  obtain ⟨R, eP, heP, hroots⟩ := core m W sW ΦW r e he
  refine ⟨R, τ.trans eP, ?_, ?_⟩
  · intro c v
    have h1 : τ (sV c v) = fun j => sW j c (τ v j) := funext (hτs c v)
    show eP (τ (sV c v)) = c • eP (τ v)
    rw [h1, heP]
  · have hM : wcAddEquivMatrix (τ.trans eP) ΦV = wcAddEquivMatrix eP (AddMonoidHom.piMap ΦW) := by
      ext a b
      simp only [wcAddEquivMatrix, Matrix.of_apply, AddEquiv.trans_apply,
        AddEquiv.symm_trans_apply]
      have h2 : ∀ y, τ (ΦV (τ.symm y)) = AddMonoidHom.piMap ΦW y := by
        intro y
        funext j
        rw [hτΦ, AddEquiv.apply_symm_apply, AddMonoidHom.piMap_apply]
      rw [h2]
    rw [hM, hroots]

theorem wc_pencil_KS_quotient_punctual (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n))
    (σQ : ℚ_[ℓ] → (Limits.cokernel (wcPencilKS D ℓ hP).arrow ⟶
      Limits.cokernel (wcPencilKS D ℓ hP).arrow))
    (hσQ : ∀ c : ℚ_[ℓ], Limits.cokernel.π (wcPencilKS D ℓ hP).arrow ≫ σQ c =
      wcPencilVQScalar D ℓ hP c ≫ Limits.cokernel.π (wcPencilKS D ℓ hP).arrow) :
    (∀ y : wcCohG F'' (wcP1Over F'') hP (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 1, y = 0) ∧
    ∃ (rQ : ℕ) (eQ : wcCohG F'' (wcP1Over F'') hP (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 0 ≃+
        (Fin rQ → ℚ_[ℓ])),
      (∀ (c : ℚ_[ℓ]) (y : wcCohG F'' (wcP1Over F'') hP
          (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 0),
        eQ (wcCohGEnd F'' (wcP1Over F'') hP (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 0
          (σQ c) y) = c • eQ y) ∧
      (wcAddEquivMatrix eQ (wcCohGFrob F'' (wcP1Over F'') hP
          (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 0)).charpoly.aroots
          (AlgebraicClosure ℚ_[ℓ]) =
        ∑ j : Fin D.m, wcPencilLoc D ℓ hP (D.S j (IsLocalRing.closedPoint F'')) 1 :=
by
  classical

  have hfun : ∀ {A B C : (wcP1Over F'').left.ProEt} (a : A ⟶ B) (b : B ⟶ C),
      wcFreeSheafMap (wcP1Over F'').left a ≫ wcFreeSheafMap (wcP1Over F'').left b =
        wcFreeSheafMap (wcP1Over F'').left (a ≫ b) := by
    intro A B C a b
    have e : Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
        Functor.whiskerRight (yoneda.map (a ≫ b))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
      rw [yoneda.map_comp, Functor.whiskerRight_comp]
    exact ((presheafToSheaf (Scheme.ProEt.topology (wcP1Over F'').left)
      AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
      (congrArg (presheafToSheaf (Scheme.ProEt.topology (wcP1Over F'').left)
        AddCommGrpCat.{u+1}).map e)
  have hassoc : ∀ {X₁ X₂ X₃ X₄ : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left)
      AddCommGrpCat.{u+1}} (α : Abelian.Ext X₁ X₂ 0) (β : Abelian.Ext X₂ X₃ 0)
      (γ : Abelian.Ext X₃ X₄ 0),
      (α.comp β (add_zero 0)).comp γ (add_zero 0) = α.comp (β.comp γ (add_zero 0)) (add_zero 0) :=
    fun α β γ => Abelian.Ext.comp_assoc α β γ (add_zero 0) (add_zero 0) rfl
  have hmk : ∀ {X₁ X₂ X₃ : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left)
      AddCommGrpCat.{u+1}} (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃),
      (Abelian.Ext.mk₀ f).comp (Abelian.Ext.mk₀ g) (add_zero 0) = Abelian.Ext.mk₀ (f ≫ g) :=
    fun f g => Abelian.Ext.mk₀_comp_mk₀ f g

  obtain ⟨hKS0, hKSmax⟩ := wc_pencil_KS_greatest F' F'' Y n hn hn2 D ℓ hℓ hP hNI
  have hsupp := wc_proet_coker_greatest_zeroAtS_off_S F'' D.m D.S (wcPencilVQ D ℓ hP)
    (wcPencilKS D ℓ hP) hKS0 hKSmax
  have hb := wc_pencil_VQ_S_stalk_basis F' F'' Y n hn hn2 D ℓ hℓ hP hNI
  let B : ∀ j : Fin D.m, wcPencilStalkBasis D ℓ hP (D.S j (IsLocalRing.closedPoint F'')) 1 :=
    fun j => (hb j).some
  have hg : ∀ j : Fin D.m, ∃ g : (B j).N.V ⟶ wcGeomPoint F'' (wcP1Over F'') hP,
      (B j).N.φ ≫ g = g ≫ wcGeomFrob F'' (wcP1Over F'') hP :=
    fun j => wc_frobNbhd_geom_lift F'' hP _ (B j).N
  choose g hgφ using hg

  obtain ⟨hQ1, hQ0⟩ := wc_P1_punctual_coh F'' hP D.m D.S D.hS D.hSinj
    (Limits.cokernel (wcPencilKS D ℓ hP).arrow) hsupp
  refine ⟨hQ1, ?_⟩
  have hst := @hQ0 (fun j => (B j).N.V) (fun j => (B j).N.A) (fun j => (B j).N.ringA)
    (fun j => (B j).N.hensA) (fun j => (B j).N.sepA) (fun j => (B j).N.e) (fun j => (B j).N.hx) g

  have hproj : ∀ j : Fin D.m, Projective (wcFreeSheaf (wcP1Over F'').left (B j).N.V) :=
    fun j => @wc_proet_free_projective_strict_local (wcP1Over F'').left (B j).N.V (B j).N.A
      (B j).N.ringA (B j).N.hensA (B j).N.sepA (B j).N.e
  let pj : ∀ j : Fin D.m,
      Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (B j).N.V) (wcPencilVQ D ℓ hP) 0 →+
        Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (B j).N.V)
          (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 0 :=
    fun j => (Abelian.Ext.mk₀ (Limits.cokernel.π (wcPencilKS D ℓ hP).arrow)).postcomp _ (add_zero 0)
  have hpj : ∀ j : Fin D.m, Function.Bijective (pj j) := by
    intro j
    haveI := hproj j
    obtain ⟨hsurj, hker⟩ := wc_ext0_projective_cokernel
      (P := wcFreeSheaf (wcP1Over F'').left (B j).N.V) (wcPencilKS D ℓ hP).arrow
    refine ⟨(injective_iff_map_eq_zero (pj j)).mpr ?_, hsurj⟩
    intro y hy
    obtain ⟨z, rfl⟩ := (hker y).mp hy
    rw [@hKS0 j (B j).N.V (B j).N.A (B j).N.ringA (B j).N.hensA (B j).N.sepA (B j).N.e
      (B j).N.hx z, map_zero]
  have h1 : ∀ (j : Fin D.m) (z : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (B j).N.V)
      (wcPencilVQ D ℓ hP) 0), (AddEquiv.ofBijective (pj j) (hpj j)).symm (pj j z) = z :=
    fun j z => (AddEquiv.ofBijective (pj j) (hpj j)).symm_apply_apply z
  let sW : ∀ j : Fin D.m, ℚ_[ℓ] →
      (Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (B j).N.V)
          (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 0 →+
        Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (B j).N.V)
          (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 0) :=
    fun j c => (Abelian.Ext.mk₀ (σQ c)).postcomp _ (add_zero 0)
  let ΦW : ∀ j : Fin D.m,
      Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (B j).N.V)
          (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 0 →+
        Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (B j).N.V)
          (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 0 :=
    fun j => (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (B j).N.φ)).precomp _ (zero_add 0)
  have hc1 : ∀ (j : Fin D.m) (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (B j).N.V)
      (wcPencilVQ D ℓ hP) 0),
      pj j ((Abelian.Ext.mk₀ (wcPencilVQScalar D ℓ hP c)).postcomp
        (wcFreeSheaf (wcP1Over F'').left (B j).N.V) (add_zero 0) y) = sW j c (pj j y) := by
    intro j c y
    show (y.comp (Abelian.Ext.mk₀ (wcPencilVQScalar D ℓ hP c)) (add_zero 0)).comp
        (Abelian.Ext.mk₀ (Limits.cokernel.π (wcPencilKS D ℓ hP).arrow)) (add_zero 0) =
      (y.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (wcPencilKS D ℓ hP).arrow)) (add_zero 0)).comp
        (Abelian.Ext.mk₀ (σQ c)) (add_zero 0)
    rw [hassoc, hassoc, hmk, hmk, hσQ c]
  have hc2 : ∀ (j : Fin D.m) (z : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (B j).N.V)
      (wcPencilVQ D ℓ hP) 0),
      ΦW j (pj j z) = pj j ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (B j).N.φ)).precomp
        (wcPencilVQ D ℓ hP) (zero_add 0) z) := by
    intro j z
    show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (B j).N.φ)).comp
        (z.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (wcPencilKS D ℓ hP).arrow)) (add_zero 0))
        (zero_add 0) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (B j).N.φ)).comp z (zero_add 0)).comp
        (Abelian.Ext.mk₀ (Limits.cokernel.π (wcPencilKS D ℓ hP).arrow)) (add_zero 0)
    rw [hassoc]

  let e' : ∀ j : Fin D.m, Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (B j).N.V)
      (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 0 ≃+ (Fin (B j).r → ℚ_[ℓ]) :=
    fun j => (AddEquiv.ofBijective (pj j) (hpj j)).symm.trans (B j).e
  have he' : ∀ (j : Fin D.m) (c : ℚ_[ℓ]) (w : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (B j).N.V)
      (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 0), e' j (sW j c w) = c • e' j w := by
    intro j c w
    obtain ⟨y, rfl⟩ := (hpj j).2 w
    show (B j).e ((AddEquiv.ofBijective (pj j) (hpj j)).symm (sW j c (pj j y))) =
      c • (B j).e ((AddEquiv.ofBijective (pj j) (hpj j)).symm (pj j y))
    rw [← hc1, h1, h1]
    exact (B j).he c y
  have hmat : ∀ j : Fin D.m, wcAddEquivMatrix (e' j) (ΦW j) =
      wcAddEquivMatrix (B j).e ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
        (B j).N.φ)).precomp (wcPencilVQ D ℓ hP) (zero_add 0)) := by
    intro j
    ext a b
    show (e' j) (ΦW j ((e' j).symm (Pi.single b 1))) a =
      (B j).e ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (B j).N.φ)).precomp
        (wcPencilVQ D ℓ hP) (zero_add 0) ((B j).e.symm (Pi.single b 1))) a
    have hs : (e' j).symm (Pi.single b 1) = pj j ((B j).e.symm (Pi.single b 1)) := rfl
    rw [hs, hc2]
    show (B j).e ((AddEquiv.ofBijective (pj j) (hpj j)).symm (pj j _)) a = _
    rw [h1]

  let stH : wcCohG F'' (wcP1Over F'') hP (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 0 →+
      ((j : Fin D.m) → Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (B j).N.V)
        (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 0) :=
    Pi.addMonoidHom (fun j => (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (g j))).precomp
      (Limits.cokernel (wcPencilKS D ℓ hP).arrow) (zero_add 0))
  have hstH : Function.Bijective stH := hst
  let τ := AddEquiv.ofBijective stH hstH
  have hτs : ∀ (c : ℚ_[ℓ])
      (v : wcCohG F'' (wcP1Over F'') hP (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 0) (j : Fin D.m),
      τ (wcCohGEnd F'' (wcP1Over F'') hP (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 0 (σQ c) v) j =
        sW j c (τ v j) := by
    intro c v j
    show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (g j))).comp
        (v.comp (Abelian.Ext.mk₀ (σQ c)) (add_zero 0)) (zero_add 0) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (g j))).comp v (zero_add 0)).comp
        (Abelian.Ext.mk₀ (σQ c)) (add_zero 0)
    rw [hassoc]
  have hτΦ : ∀ (v : wcCohG F'' (wcP1Over F'') hP (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 0)
      (j : Fin D.m),
      τ (wcCohGFrob F'' (wcP1Over F'') hP (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 0 v) j =
        ΦW j (τ v j) := by
    intro v j
    show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (g j))).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (wcGeomFrob F'' (wcP1Over F'') hP))).comp
          v (zero_add 0)) (zero_add 0) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (B j).N.φ)).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (g j))).comp v (zero_add 0))
        (zero_add 0)
    rw [← hassoc, ← hassoc, hmk, hmk, hfun, hfun, hgφ j]

  obtain ⟨R, eV, heV, hroots⟩ := wc_pi_addEquiv_charpoly_aroots ℓ
    (fun c => wcCohGEnd F'' (wcP1Over F'') hP (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 0 (σQ c))
    (wcCohGFrob F'' (wcP1Over F'') hP (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 0) D.m
    (fun j => Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (B j).N.V)
      (Limits.cokernel (wcPencilKS D ℓ hP).arrow) 0)
    sW ΦW τ hτs hτΦ (fun j => (B j).r) e' he'

  refine ⟨R, eV, heV, ?_⟩
  rw [hroots]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [hmat j]
  unfold wcPencilLoc
  rw [dif_pos (hb j)]

theorem wc_KS_ext0_postcomp_bijective (F' F'' : Type u) [Field F'] [Field F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (V : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A] [IsLocalRing A]
    (e : V.left ≅ Spec (.of A)) (x : (wcP1Over F'').left)
    (hxS : ∀ i, x ≠ D.S i (IsLocalRing.closedPoint F''))
    (hx : V.hom (e.inv (IsLocalRing.closedPoint A)) = x) :
    Function.Bijective ((Abelian.Ext.mk₀ (wcPencilKS D ℓ hP).arrow).postcomp
      (wcFreeSheaf (wcP1Over F'').left V) (add_zero 0)) :=
by
  classical

  have hsieve : ∀ (S : Scheme.{u}) (W : S.ProEt) (B : Type u) [CommRing B] [HenselianLocalRing B]
      [IsSepClosed (IsLocalRing.ResidueField B)] (eW : W.left ≅ Spec (.of B)) (T : Sieve W),
      T ∈ Scheme.ProEt.topology S W → T.arrows (𝟙 W) := by
    intro S W B _ _ _ eW T hT
    have s6 : ∀ (R E : Type u) [CommRing R] [CommRing E] [Algebra R E],
        WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R E))) → Algebra.WeaklyEtale R E := by
      intro R E _ _ _ hW
      have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap R E))) := hW.flat
      have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R E)))) :=
        hW.flat_diagonal
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
        RingHom.flat_algebraMap_iff] at hf
      rw [diagonal_SpecMap] at hd
      have hd' : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' R (S := E)).toRingHom)) := by
        have heq : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) =
            (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) ≫
              (pullbackSpecIso R E E).inv) ≫ (pullbackSpecIso R E E).hom := by
          rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
        rw [heq]
        infer_instance
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hd'
      exact ⟨hf, hd'⟩
    have s7 : ∀ (E : Type u) [CommRing E] [Algebra B E],
        Algebra.WeaklyEtale B E → ∀ (p : Ideal E) [p.IsPrime],
        p.comap (algebraMap B E) = IsLocalRing.maximalIdeal B → Nonempty (E →ₐ[B] B) := by
      intro E _ _ hAE p _ hp
      haveI : Algebra.WeaklyEtale E (Localization.AtPrime p) :=
        wc_localization_weaklyEtale E (Localization.AtPrime p) p.primeCompl
      haveI := hAE
      haveI : Algebra.WeaklyEtale B (Localization.AtPrime p) := Algebra.WeaklyEtale.trans B E _
      have hloc : IsLocalHom (algebraMap B (Localization.AtPrime p)) := by
        have h1 : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap
            (algebraMap B (Localization.AtPrime p)) = IsLocalRing.maximalIdeal B := by
          rw [IsScalarTower.algebraMap_eq B E (Localization.AtPrime p), ← Ideal.comap_comap]
          have h2 : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap
              (algebraMap E (Localization.AtPrime p)) = p :=
            Localization.AtPrime.under_maximalIdeal
          rw [h2, hp]
        exact ((IsLocalRing.local_hom_TFAE (algebraMap B (Localization.AtPrime p))).out 1 5).mpr h1
      have hbij := wc_olivier B (Localization.AtPrime p) inferInstance inferInstance hloc
        inferInstance
      let eqv : B ≃ₐ[B] Localization.AtPrime p := AlgEquiv.ofBijective (Algebra.ofId B _) hbij
      exact ⟨eqv.symm.toAlgHom.comp (IsScalarTower.toAlgHom B E (Localization.AtPrime p))⟩
    have s5 : ∀ {U V' : Scheme.{u}} (e' : U ≅ Spec (.of B)) (g : V' ⟶ U) [WeaklyEtale g] (v : V'),
        e'.hom (g v) = IsLocalRing.closedPoint B → ∃ σ : U ⟶ V', σ ≫ g = 𝟙 U := by
      intro U V' e' g _ v hv
      obtain ⟨E, ι, hι, hvι, -⟩ :=
        Scheme.exists_affine_mem_range_and_range_subset (U := (⊤ : V'.Opens)) (x := v) trivial
      obtain ⟨w, hw⟩ := hvι
      have := hι
      let h : Spec E ⟶ Spec (.of B) := ι ≫ g ≫ e'.hom
      have hWh : WeaklyEtale h := inferInstance
      let φ : CommRingCat.of B ⟶ E := Spec.preimage h
      have hφ : Spec.map φ = h := Spec.map_preimage h
      letI : Algebra B E := (CommRingCat.Hom.hom φ).toAlgebra
      have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap B E))) := by
        change WeaklyEtale (Spec.map φ)
        rw [hφ]
        exact hWh
      have hAE : Algebra.WeaklyEtale B E := s6 B E hW'
      let p : PrimeSpectrum E := w
      have hq : (p.asIdeal).comap (algebraMap B E) = IsLocalRing.maximalIdeal B := by
        have h1 : (Spec.map φ) w = IsLocalRing.closedPoint B := by
          rw [hφ]
          show e'.hom (g (ι w)) = _
          rw [hw, hv]
        exact congrArg PrimeSpectrum.asIdeal h1
      obtain ⟨τ⟩ := s7 E hAE p.asIdeal hq
      let τ' : E ⟶ CommRingCat.of B := CommRingCat.ofHom (τ : E →+* B)
      have hret : φ ≫ τ' = 𝟙 _ := by
        ext r
        exact τ.commutes r
      refine ⟨e'.hom ≫ Spec.map τ' ≫ ι, ?_⟩
      rw [← cancel_mono e'.hom]
      simp only [Category.assoc, Category.id_comp]
      have h3 : ι ≫ g ≫ e'.hom = Spec.map φ := hφ.symm
      rw [h3, ← Spec.map_comp, hret, Spec.map_id, Category.comp_id]
    have s4 : ∀ (U : S.ProEt) (R : Presieve U), R ∈ (Scheme.ProEt.precoverage S).coverings U →
        ∀ (W' : S.ProEt) (a : W' ⟶ U), Nonempty (W'.left ≅ Spec (.of B)) →
        ∃ (Y' : S.ProEt) (g : Y' ⟶ U) (h : W' ⟶ Y'), R g ∧ h ≫ g = a := by
      intro U R hR W' a ⟨eW'⟩
      have hR' : Presieve.map (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          (Scheme.precoverage @WeaklyEtale).coverings U.left := hR.2
      obtain ⟨Y'', g', hg', y', hy'⟩ :=
        (Scheme.instJointlySurjectivePrecoverage (P := @WeaklyEtale)).exists_eq _ hR'
          (a.left (eW'.inv (IsLocalRing.closedPoint B)))
      obtain ⟨Y', hY, g, hg, hgg⟩ := Presieve.map_iff.mp hg'
      subst hY
      have hgl : g.left = g' := hgg.trans (by simp only [eqToHom_refl]; exact Category.id_comp _)
      haveI : WeaklyEtale U.hom := U.prop
      haveI : WeaklyEtale (g.left ≫ U.hom) := by
        rw [MorphismProperty.Over.w g]; exact Y'.prop
      haveI : WeaklyEtale g.left := WeaklyEtale.of_comp g.left U.hom
      obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := a.left) (g := g.left)
        (eW'.inv (IsLocalRing.closedPoint B)) y' (by rw [hgl]; exact hy'.symm)
      obtain ⟨σ, hσ⟩ := s5 eW' (Limits.pullback.fst a.left g.left) z (by
        rw [hz1]
        change (eW'.inv ≫ eW'.hom) (IsLocalRing.closedPoint B) = _
        rw [Iso.inv_hom_id]
        rfl)
      have hh₀ : (σ ≫ Limits.pullback.snd a.left g.left) ≫ g.left = a.left := by
        rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hσ, Category.id_comp]
      refine ⟨Y', g, MorphismProperty.Over.homMk (σ ≫ Limits.pullback.snd a.left g.left) ?_ trivial,
        hg, ?_⟩
      · rw [← MorphismProperty.Over.w g, ← Category.assoc, hh₀, MorphismProperty.Over.w a]
      · apply MorphismProperty.Over.Hom.ext
        exact hh₀
    have s3 : ∀ (Pr : S.ProEt → Prop),
        (∀ (U : S.ProEt) (R : Presieve U), R ∈ (Scheme.ProEt.precoverage S).coverings U →
          ∀ (W' : S.ProEt) (a : W' ⟶ U), Pr W' →
            ∃ (Y' : S.ProEt) (g : Y' ⟶ U) (h : W' ⟶ Y'), R g ∧ h ≫ g = a) →
        ∀ (U : S.ProEt) (T : Sieve U), T ∈ Scheme.ProEt.topology S U →
          ∀ (W' : S.ProEt) (a : W' ⟶ U), Pr W' → T.arrows a := by
      intro Pr hK
      let JP : GrothendieckTopology S.ProEt :=
        GrothendieckTopology.mk
          (fun U => {T : Sieve U | ∀ (W' : S.ProEt) (a : W' ⟶ U), Pr W' → T.arrows a})
          (by
            intro U W' a _
            trivial)
          (by
            intro U Y' T f hT W' a hW
            rw [Sieve.pullback_apply]
            exact hT W' (a ≫ f) hW)
          (by
            intro U T hT R hR W' a hW
            have h1 := hR (hT W' a hW) W' (𝟙 W') hW
            rw [Sieve.pullback_apply, Category.id_comp] at h1
            exact h1)
      have hle : Scheme.ProEt.topology S ≤ JP := by
        rw [Precoverage.toGrothendieck_le_iff_le_toPrecoverage]
        intro U R hR
        show ∀ (W' : S.ProEt) (a : W' ⟶ U), Pr W' → (Sieve.generate R).arrows a
        intro W' a hW
        obtain ⟨Y', g, h, hg, hhg⟩ := hK U R hR W' a hW
        exact ⟨Y', h, g, hg, hhg⟩
      intro U T hT W' a hW
      have h1 : T ∈ JP U := GrothendieckTopology.le_def.mp hle U hT
      exact h1 W' a hW
    exact s3 (fun W' => Nonempty (W'.left ≅ Spec (.of B))) s4 W T hT W (𝟙 W) ⟨eW⟩

  have hvan : ∀ (W : (wcP1Over F'').left.ProEt) (B : Type u) [CommRing B] [HenselianLocalRing B]
      [IsSepClosed (IsLocalRing.ResidueField B)] (eW : W.left ≅ Spec (.of B)),
      IsEmpty (W ⟶ V) → ∀ g : wcFreeSheaf (wcP1Over F'').left W ⟶ wcFreeSheaf (wcP1Over F'').left V,
        g = 0 := by
    intro W B _ _ _ eW hE g
    obtain ⟨eF, -, heF0⟩ := proet_free_sheaf_hom_equiv (wcP1Over F'').left W
    let J := Scheme.ProEt.topology (wcP1Over F'').left
    let P₀ : (wcP1Over F'').left.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
    have hz : ∀ z : FreeAbelianGroup (ULift.{u+1} (W ⟶ V)), z = 0 := fun z =>
      FreeAbelianGroup.induction_on z rfl (fun a => (hE.false a.down).elim)
        (fun a _ => (hE.false a.down).elim) (fun a b ha hb => by rw [ha, hb, add_zero])
    have ht : ∀ t : (sheafify J P₀).obj (Opposite.op W), t = 0 := by
      intro t
      haveI : Presheaf.IsLocallySurjective J (toSheafify J P₀) :=
        Presheaf.isLocallySurjective_toSheafify' J P₀
      have hT := Presheaf.imageSieve_mem J (toSheafify J P₀) t
      have h1 := hsieve (wcP1Over F'').left W B eW _ hT
      rw [Presheaf.imageSieve_apply] at h1
      obtain ⟨t₀, ht₀⟩ := h1
      have h2 : t = (toSheafify J P₀).app (Opposite.op W) t₀ := by
        rw [ht₀]; simp
      have h3 : t₀ = 0 := hz t₀
      rw [h2, h3, map_zero]
    apply (eF _).injective
    rw [heF0]
    exact ht (eF _ g)

  have hclosed : ∀ i, IsClosed ({D.S i (IsLocalRing.closedPoint F'')} :
      Set (wcP1Over F'').left) := by
    intro i
    haveI : IsClosedImmersion (D.S i) :=
      isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)
    have h1 := (D.S i).isClosedEmbedding.isClosed_range
    have h2 : Set.range (D.S i) = {D.S i (IsLocalRing.closedPoint F'')} := by
      ext q
      constructor
      · rintro ⟨r, rfl⟩
        rw [Subsingleton.elim r (IsLocalRing.closedPoint F'')]
        rfl
      · rintro rfl
        exact ⟨_, rfl⟩
    rwa [h2] at h1

  have hnohom : ∀ (W : (wcP1Over F'').left.ProEt) (i : Fin D.m) (w : W.left),
      W.hom w = D.S i (IsLocalRing.closedPoint F'') → IsEmpty (W ⟶ V) := by
    intro W i w hw
    refine ⟨fun a => ?_⟩
    have hq : V.hom (a.left w) = D.S i (IsLocalRing.closedPoint F'') := by
      rw [← hw, ← Scheme.Hom.comp_apply, MorphismProperty.Over.w a]
    have hsp : a.left w ⤳ e.inv (IsLocalRing.closedPoint A) := by
      have h1 := (IsLocalRing.specializes_closedPoint
        (R := A) (e.hom (a.left w))).map e.inv.continuous
      have h2 : e.inv (e.hom (a.left w)) = a.left w := by
        rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]
        rfl
      rwa [h2] at h1
    have h3 := hsp.map V.hom.continuous
    rw [hq] at h3
    have h4 := h3.mem_closed (hclosed i) rfl
    rw [hx] at h4
    exact hxS i h4

  have hgreat : ∀ M' : Subobject (wcPencilVQ D ℓ hP),
      wcZeroAtS F'' D.m D.S (Subobject.underlying.obj M') → M' ≤ wcPencilKS D ℓ hP := by
    intro M' hM'
    unfold wcPencilKS
    split
    · rename_i h
      exact (Classical.choose_spec h).2 M' hM'
    · exact le_top

  constructor
  · intro z₁ z₂ h
    obtain ⟨k₁, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 z₁
    obtain ⟨k₂, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 z₂
    have h' : (Abelian.Ext.mk₀ k₁).comp (Abelian.Ext.mk₀ (wcPencilKS D ℓ hP).arrow) (add_zero 0) =
        (Abelian.Ext.mk₀ k₂).comp (Abelian.Ext.mk₀ (wcPencilKS D ℓ hP).arrow) (add_zero 0) := h
    rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀] at h'
    have h'' := (Abelian.Ext.mk₀_bijective _ _).1 h'
    rw [cancel_mono] at h''
    rw [h'']
  · intro y
    obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
    have hM : wcZeroAtS F'' D.m D.S (Subobject.underlying.obj (Limits.imageSubobject g)) := by
      intro i W B _ _ _ eW hW z
      obtain ⟨k, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 z
      haveI := wc_proet_free_projective_strict_local _ W B eW
      have hE := hnohom W i _ hW
      have hk : k = Projective.factorThru k (Limits.factorThruImageSubobject g) ≫
          Limits.factorThruImageSubobject g := (Projective.factorThru_comp _ _).symm
      rw [hk, hvan W B eW hE (Projective.factorThru k _), Limits.zero_comp, Abelian.Ext.mk₀_zero]
    have hle := hgreat _ hM
    refine ⟨Abelian.Ext.mk₀ (Limits.factorThruImageSubobject g ≫
      Subobject.ofLE (Limits.imageSubobject g) _ hle), ?_⟩
    show (Abelian.Ext.mk₀ _).comp (Abelian.Ext.mk₀ (wcPencilKS D ℓ hP).arrow) (add_zero 0) = _
    rw [Abelian.Ext.mk₀_comp_mk₀, Category.assoc, Subobject.ofLE_arrow,
      Limits.imageSubobject_arrow_comp]

theorem wc_proet_strict_local_map_through_point (S : Scheme.{u}) (V₁ V₂ : S.ProEt) (A : Type u)
    [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₁.left ≅ Spec (.of A)) (v₂ : V₂.left)
    (hv : V₂.hom v₂ = V₁.hom (e.inv (IsLocalRing.closedPoint A))) :
    ∃ h : V₁ ⟶ V₂, h.left (e.inv (IsLocalRing.closedPoint A)) = v₂ :=
by
  classical
  haveI h2 : WeaklyEtale V₂.hom := V₂.prop
  have hq : WeaklyEtale (Limits.pullback.fst V₁.hom V₂.hom) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback V₁.hom V₂.hom).flip
      V₂.prop
  obtain ⟨t, ht1, ht2⟩ := Scheme.Pullback.exists_preimage_pullback (f := V₁.hom) (g := V₂.hom)
    (e.inv (IsLocalRing.closedPoint A)) v₂ hv.symm
  haveI : WeaklyEtale (Limits.pullback.fst V₁.hom V₂.hom) := hq
  haveI : WeaklyEtale ((Limits.pullback V₁.hom V₂.hom).fromSpecStalk t) :=
    wc_fromSpecStalk_weaklyEtale _ t
  obtain ⟨k, hkdef⟩ : ∃ k, k = (Limits.pullback V₁.hom V₂.hom).fromSpecStalk t ≫
      Limits.pullback.fst V₁.hom V₂.hom ≫ e.hom := ⟨_, rfl⟩
  have hk : WeaklyEtale k := by rw [hkdef]; infer_instance
  have hφ : Spec.map (Spec.preimage k) = k := Spec.map_preimage k
  have hk' : WeaklyEtale (Spec.map (CommRingCat.ofHom (Spec.preimage k).hom)) := by
    change WeaklyEtale (Spec.map (Spec.preimage k))
    rw [hφ]; exact hk
  letI := (Spec.preimage k).hom.toAlgebra
  have hWE := wc_lpkt_specMap_weaklyEtale_ring _ _ (Spec.preimage k).hom hk'
  have h2e : ∀ y : Spec (CommRingCat.of A), e.hom (e.inv y) = y := by
    intro y
    first
      | simp
      | (rw [← Scheme.Hom.comp_apply, e.inv_hom_id]; rfl)
      | exact congrArg (fun f : Spec (CommRingCat.of A) ⟶ Spec (CommRingCat.of A) => f y) e.inv_hom_id
  have hk_pt : k (IsLocalRing.closedPoint ((Limits.pullback V₁.hom V₂.hom).presheaf.stalk t)) =
      IsLocalRing.closedPoint A := by
    have h1 : k (IsLocalRing.closedPoint ((Limits.pullback V₁.hom V₂.hom).presheaf.stalk t)) =
        e.hom ((Limits.pullback.fst V₁.hom V₂.hom) ((Limits.pullback V₁.hom V₂.hom).fromSpecStalk t
          (IsLocalRing.closedPoint ((Limits.pullback V₁.hom V₂.hom).presheaf.stalk t)))) := by
      subst hkdef
      first | rfl | simp [Scheme.Hom.comp_apply]
    rw [h1, Scheme.fromSpecStalk_closedPoint, ht1]
    exact h2e _
  have hcomap : PrimeSpectrum.comap (Spec.preimage k).hom
      (IsLocalRing.closedPoint ((Limits.pullback V₁.hom V₂.hom).presheaf.stalk t)) =
      IsLocalRing.closedPoint A := by
    have h5 : (Spec.map (Spec.preimage k))
        (IsLocalRing.closedPoint ((Limits.pullback V₁.hom V₂.hom).presheaf.stalk t)) =
        PrimeSpectrum.comap (Spec.preimage k).hom
          (IsLocalRing.closedPoint ((Limits.pullback V₁.hom V₂.hom).presheaf.stalk t)) := by
      first | rfl | simp [Spec.map_base]
    rw [← h5, hφ]
    exact hk_pt
  have hloc : IsLocalHom (Spec.preimage k).hom :=
    (IsLocalRing.isLocalHom_iff_comap_closedPoint (Spec.preimage k).hom).mpr hcomap
  have hbij : Function.Bijective (Spec.preimage k).hom :=
    wc_olivier _ _ inferInstance inferInstance hloc hWE
  haveI : IsIso (Spec.preimage k) := (ConcreteCategory.isIso_iff_bijective _).mpr hbij
  haveI hkiso : IsIso k := by
    rw [← hφ]; infer_instance
  have hcq : (Limits.pullback V₁.hom V₂.hom).fromSpecStalk t ≫ Limits.pullback.fst V₁.hom V₂.hom =
      k ≫ e.inv := by
    rw [hkdef]; simp
  have hinvk : ∀ p, (inv k) (k p) = p := by
    intro p
    rw [← Scheme.Hom.comp_apply, IsIso.hom_inv_id]
    rfl
  obtain ⟨s, hs, hspt⟩ : ∃ s : V₁.left ⟶ Limits.pullback V₁.hom V₂.hom,
      s ≫ Limits.pullback.fst V₁.hom V₂.hom = 𝟙 _ ∧ s (e.inv (IsLocalRing.closedPoint A)) = t := by
    refine ⟨e.hom ≫ inv k ≫ (Limits.pullback V₁.hom V₂.hom).fromSpecStalk t, ?_, ?_⟩
    · rw [Category.assoc, Category.assoc, hcq, IsIso.inv_hom_id_assoc, Iso.hom_inv_id]
    · have h3 : (inv k) (e.hom (e.inv (IsLocalRing.closedPoint A))) =
          IsLocalRing.closedPoint ((Limits.pullback V₁.hom V₂.hom).presheaf.stalk t) := by
        have h4 : e.hom (e.inv (IsLocalRing.closedPoint A)) =
            k (IsLocalRing.closedPoint ((Limits.pullback V₁.hom V₂.hom).presheaf.stalk t)) :=
          (h2e _).trans hk_pt.symm
        exact (congrArg (fun p => (inv k) p) h4).trans (hinvk _)
      have h6 : (Limits.pullback V₁.hom V₂.hom).fromSpecStalk t
          (IsLocalRing.closedPoint ((Limits.pullback V₁.hom V₂.hom).presheaf.stalk t)) = t := by
        first
          | exact Scheme.fromSpecStalk_closedPoint
          | rw [Scheme.fromSpecStalk_closedPoint]
          | simp [Scheme.fromSpecStalk_closedPoint]
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
      exact (congrArg (fun p => (Limits.pullback V₁.hom V₂.hom).fromSpecStalk t p) h3).trans h6
  have hh : (s ≫ Limits.pullback.snd V₁.hom V₂.hom) ≫ V₂.hom = V₁.hom := by
    rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hs, Category.id_comp]
  refine ⟨MorphismProperty.Over.homMk (s ≫ Limits.pullback.snd V₁.hom V₂.hom) hh trivial, ?_⟩
  show (s ≫ Limits.pullback.snd V₁.hom V₂.hom) (e.inv (IsLocalRing.closedPoint A)) = v₂
  rw [Scheme.Hom.comp_apply, hspt, ht2]

theorem wc_frob_nbhd_map_comm (K : Type u) [Field K] [Finite K] (d : ℕ)
    (V₁ V₂ : (wcP1Over K).left.ProEt) (φ₁ : V₁ ⟶ V₁) (φ₂ : V₂ ⟶ V₂)
    (A₁ A₂ : Type u) [CommRing A₁] [IsLocalRing A₁] [CommRing A₂] [IsLocalRing A₂]
    (e₁ : V₁.left ≅ Spec (.of A₁)) (e₂ : V₂.left ≅ Spec (.of A₂))
    (ψ₁ : A₁ →+* A₁) (ψ₂ : A₂ →+* A₂)
    (hψ₁ : e₁.inv ≫ φ₁.left ≫ e₁.hom = Spec.map (CommRingCat.ofHom ψ₁))
    (hψ₂ : e₂.inv ≫ φ₂.left ≫ e₂.hom = Spec.map (CommRingCat.ofHom ψ₂))
    (hf₁ : ∀ a : A₁, ψ₁ a ^ (Nat.card K ^ d) - a ∈ IsLocalRing.maximalIdeal A₁)
    (hf₂ : ∀ a : A₂, ψ₂ a ^ (Nat.card K ^ d) - a ∈ IsLocalRing.maximalIdeal A₂)
    (h : V₁ ⟶ V₂)
    (hh : h.left (e₁.inv (IsLocalRing.closedPoint A₁)) = e₂.inv (IsLocalRing.closedPoint A₂)) :
    h ≫ φ₂ = φ₁ ≫ h :=
by
  classical

  have wc_flat_quot_absorb : ∀ (R : Type u) [CommRing R] (I : Ideal R),
      Module.Flat R (R ⧸ I) → ∀ x ∈ I, ∃ z ∈ I, x * z = x := by
    intro R _ I hflat x hx
    have hrel : ∑ i : Fin 1, (fun _ => x) i • (fun _ => (1 : R ⧸ I)) i = 0 := by
      rw [Fin.sum_univ_one]
      show x • (1 : R ⧸ I) = 0
      rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, mul_one,
        Ideal.Quotient.eq_zero_iff_mem]
      exact hx
    obtain ⟨k, a, y, h1, h2⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrel
    choose b hb using fun j => Ideal.Quotient.mk_surjective (I := I) (y j)
    set w : R := ∑ j, a 0 j * b j with hw
    have h10 : (1 : R ⧸ I) = ∑ j, a 0 j • y j := h1 0
    have hmk : Ideal.Quotient.mk I w = 1 := by
      rw [hw, map_sum, h10]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_mul, hb j, Algebra.smul_def, Ideal.Quotient.algebraMap_eq]
    have hxw : x * w = 0 := by
      rw [hw, Finset.mul_sum]
      refine Finset.sum_eq_zero (fun j _ => ?_)
      have := h2 j
      rw [Fin.sum_univ_one] at this
      rw [← mul_assoc, this, zero_mul]
    refine ⟨1 - w, ?_, ?_⟩
    · rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, hmk, sub_self]
    · rw [mul_sub, mul_one, hxw, sub_zero]

  have s6 : ∀ (R B A : Type u) [CommRing R] [CommRing B] [CommRing A] [Algebra R B] [Algebra R A]
      [IsLocalRing A], Algebra.WeaklyEtale R B → ∀ f₁ f₂ : B →ₐ[R] A,
      (∀ b : B, IsLocalRing.residue A (f₁ b) = IsLocalRing.residue A (f₂ b)) → f₁ = f₂ := by
    intro R B A _ _ _ _ _ _ hW f₁ f₂ hres
    have hμsurj : Function.Surjective (Algebra.TensorProduct.lmul' R (S := B)) := fun b =>
      ⟨b ⊗ₜ[R] (1 : B), by rw [Algebra.TensorProduct.lmul'_apply_tmul, mul_one]⟩
    have hflatQ : Module.Flat (TensorProduct R B B)
        (TensorProduct R B B ⧸ RingHom.ker (Algebra.TensorProduct.lmul' R (S := B)).toRingHom) := by
      let e := RingHom.quotientKerEquivOfSurjective
        (f := (Algebra.TensorProduct.lmul' R (S := B)).toRingHom) hμsurj
      have h1 : ((Algebra.TensorProduct.lmul' R (S := B)).toRingHom).Flat := hW.flat_lmul'
      have h2 : (e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' R (S := B)).toRingHom).Flat :=
        RingHom.Flat.comp h1 (RingHom.Flat.of_bijective (f := e.symm.toRingHom) e.symm.bijective)
      have h3 : e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' R (S := B)).toRingHom =
          algebraMap _ (TensorProduct R B B ⧸
            RingHom.ker (Algebra.TensorProduct.lmul' R (S := B)).toRingHom) := by
        refine RingHom.ext fun t => ?_
        rw [Ideal.Quotient.algebraMap_eq]
        show e.symm (Algebra.TensorProduct.lmul' R (S := B) t) = Ideal.Quotient.mk _ t
        rw [e.symm_apply_eq]
        rfl
      rw [h3, RingHom.flat_algebraMap_iff] at h2
      exact h2
    have habs := wc_flat_quot_absorb _ _ hflatQ
    have hclaim : ∀ t : TensorProduct R B B,
        IsLocalRing.residue A (Algebra.TensorProduct.productMap f₁ f₂ t) =
          IsLocalRing.residue A (f₁ (Algebra.TensorProduct.lmul' R (S := B) t)) := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | tmul a b =>
        rw [Algebra.TensorProduct.productMap_apply_tmul, Algebra.TensorProduct.lmul'_apply_tmul,
          map_mul, map_mul, map_mul, hres b]
      | add x y hx hy => rw [map_add, map_add, map_add, map_add, hx, hy, map_add]
    have hkill : ∀ t ∈ RingHom.ker (Algebra.TensorProduct.lmul' R (S := B)).toRingHom,
        Algebra.TensorProduct.productMap f₁ f₂ t = 0 := by
      intro t ht
      obtain ⟨z, hz, htz⟩ := habs t ht
      have hz0 : Algebra.TensorProduct.lmul' R (S := B) z = 0 := RingHom.mem_ker.mp hz
      have hrz : IsLocalRing.residue A (Algebra.TensorProduct.productMap f₁ f₂ z) = 0 := by
        rw [hclaim, hz0, map_zero, map_zero]
      have hmem := (IsLocalRing.residue_eq_zero_iff _).mp hrz
      have hu : IsUnit (1 - Algebra.TensorProduct.productMap f₁ f₂ z) :=
        IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ hmem
      have h1 : Algebra.TensorProduct.productMap f₁ f₂ t *
          (1 - Algebra.TensorProduct.productMap f₁ f₂ z) = 0 := by
        rw [mul_sub, mul_one, ← map_mul, htz, sub_self]
      exact hu.mul_left_eq_zero.mp h1
    apply AlgHom.ext
    intro b
    have ht : b ⊗ₜ[R] (1 : B) - (1 : B) ⊗ₜ[R] b ∈
        RingHom.ker (Algebra.TensorProduct.lmul' R (S := B)).toRingHom := by
      rw [RingHom.mem_ker]
      show Algebra.TensorProduct.lmul' R (S := B) (b ⊗ₜ[R] (1 : B) - (1 : B) ⊗ₜ[R] b) = 0
      rw [map_sub, Algebra.TensorProduct.lmul'_apply_tmul, Algebra.TensorProduct.lmul'_apply_tmul,
        mul_one, one_mul, sub_self]
    have h0 := hkill _ ht
    rw [map_sub, Algebra.TensorProduct.productMap_apply_tmul,
      Algebra.TensorProduct.productMap_apply_tmul, map_one, map_one, mul_one, one_mul,
      sub_eq_zero] at h0
    exact h0

  have lpkt : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R →+* S),
      WeaklyEtale (Spec.map (CommRingCat.ofHom ψ)) → @Algebra.WeaklyEtale R S _ _ ψ.toAlgebra := by
    intro R S _ _ ψ hW
    letI : Algebra R S := ψ.toAlgebra
    have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R S))) := hW
    have hf : Module.Flat R S := RingHom.flat_algebraMap_iff.mp
      ((HasRingHomProperty.Spec_iff (P := @Flat)).mp hW'.flat)
    have h2 := hW'.flat_diagonal
    rw [diagonal_SpecMap] at h2
    have h3 : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' (S := S) R).toRingHom)) := by
      have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) =
          (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) ≫
            (pullbackSpecIso R S S).inv) ≫ (pullbackSpecIso R S S).hom := by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [e]
      exact MorphismProperty.comp_mem @Flat _ _ h2 inferInstance
    exact Algebra.WeaklyEtale.mk (flat := hf) ((HasRingHomProperty.Spec_iff (P := @Flat)).mp h3)

  have s7 : ∀ (S : Scheme.{u}) (B A : Type u) [CommRing B] [IsLocalRing B] [CommRing A]
      (p : Spec (.of B) ⟶ S), WeaklyEtale p → ∀ g₁ g₂ : B →+* A,
      Spec.map (CommRingCat.ofHom g₁) ≫ p = Spec.map (CommRingCat.ofHom g₂) ≫ p →
      ∃ (R : CommRingCat.{u}) (φ : R →+* B), @Algebra.WeaklyEtale R B _ _ φ.toAlgebra ∧
        g₁.comp φ = g₂.comp φ := by
    intro S B A _ _ _ p hp g₁ g₂ hg
    obtain ⟨W, hW, hsW, -⟩ := exists_isAffineOpen_mem_and_subset
      (x := p (IsLocalRing.closedPoint B)) (U := ⊤) (by simp)
    have hsub : Set.range p ⊆ Set.range W.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨y, rfl⟩
      exact ((IsLocalRing.specializes_closedPoint y).map p.continuous).mem_open W.isOpen hsW
    have hfac : IsOpenImmersion.lift W.ι p hsub ≫ W.ι = p := IsOpenImmersion.lift_fac _ _ _
    haveI : WeaklyEtale (IsOpenImmersion.lift W.ι p hsub ≫ W.ι) := by rw [hfac]; exact hp
    haveI : WeaklyEtale (IsOpenImmersion.lift W.ι p hsub) :=
      WeaklyEtale.of_comp (IsOpenImmersion.lift W.ι p hsub) W.ι
    haveI hq : WeaklyEtale (IsOpenImmersion.lift W.ι p hsub ≫ hW.isoSpec.hom) := inferInstance
    have hφc : Spec.map (Spec.preimage (IsOpenImmersion.lift W.ι p hsub ≫ hW.isoSpec.hom)) =
        IsOpenImmersion.lift W.ι p hsub ≫ hW.isoSpec.hom := Spec.map_preimage _
    refine ⟨Γ(S, W), (Spec.preimage (IsOpenImmersion.lift W.ι p hsub ≫ hW.isoSpec.hom)).hom,
      ?_, ?_⟩
    · apply lpkt
      show WeaklyEtale (Spec.map (Spec.preimage (IsOpenImmersion.lift W.ι p hsub ≫ hW.isoSpec.hom)))
      rw [hφc]
      exact hq
    · have h1 : Spec.map (CommRingCat.ofHom g₁) ≫ IsOpenImmersion.lift W.ι p hsub =
          Spec.map (CommRingCat.ofHom g₂) ≫ IsOpenImmersion.lift W.ι p hsub := by
        rw [← cancel_mono W.ι, Category.assoc, Category.assoc, hfac, hg]
      have h2 : Spec.map (Spec.preimage (IsOpenImmersion.lift W.ι p hsub ≫ hW.isoSpec.hom) ≫
            CommRingCat.ofHom g₁) =
          Spec.map (Spec.preimage (IsOpenImmersion.lift W.ι p hsub ≫ hW.isoSpec.hom) ≫
            CommRingCat.ofHom g₂) := by
        rw [Spec.map_comp, Spec.map_comp, hφc, ← Category.assoc, ← Category.assoc, h1]
      have h4 := congrArg CommRingCat.Hom.hom (Spec.map_injective h2)
      rw [CommRingCat.hom_comp, CommRingCat.hom_comp, CommRingCat.hom_ofHom,
        CommRingCat.hom_ofHom] at h4
      exact h4

  obtain ⟨ρ, hρ⟩ : ∃ ρ : A₂ →+* A₁,
      Spec.map (CommRingCat.ofHom ρ) = e₁.inv ≫ h.left ≫ e₂.hom :=
    ⟨(Spec.preimage (e₁.inv ≫ h.left ≫ e₂.hom)).hom, by
      rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
  have hloc : IsLocalHom ρ := by
    rw [IsLocalRing.isLocalHom_iff_comap_closedPoint]
    have h1 : (Spec.map (CommRingCat.ofHom ρ)) (IsLocalRing.closedPoint A₁) =
        IsLocalRing.closedPoint A₂ := by
      have e1 := (Scheme.Hom.comp_apply e₁.inv (h.left ≫ e₂.hom) (IsLocalRing.closedPoint A₁)).trans
        (Scheme.Hom.comp_apply h.left e₂.hom (e₁.inv (IsLocalRing.closedPoint A₁)))
      have e2 : e₂.hom (e₂.inv (IsLocalRing.closedPoint A₂)) = IsLocalRing.closedPoint A₂ :=
        (Scheme.Hom.comp_apply e₂.inv e₂.hom (IsLocalRing.closedPoint A₂)).symm.trans
          ((congrArg (fun f : Spec (.of A₂) ⟶ Spec (.of A₂) => f (IsLocalRing.closedPoint A₂))
            e₂.inv_hom_id).trans rfl)
      rw [hρ]
      exact e1.trans ((congrArg e₂.hom hh).trans e2)
    exact h1

  have C1 : e₁.inv ≫ (h.left ≫ φ₂.left) ≫ e₂.hom = Spec.map (CommRingCat.ofHom (ρ.comp ψ₂)) := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp, ← hψ₂, hρ]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
  have C2 : e₁.inv ≫ (φ₁.left ≫ h.left) ≫ e₂.hom = Spec.map (CommRingCat.ofHom (ψ₁.comp ρ)) := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp, ← hψ₁, hρ]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]

  have hw₂ : φ₂.left ≫ V₂.hom = V₂.hom := MorphismProperty.Over.w φ₂
  have hwh : h.left ≫ V₂.hom = V₁.hom := MorphismProperty.Over.w h
  have hw₁ : φ₁.left ≫ V₁.hom = V₁.hom := MorphismProperty.Over.w φ₁
  haveI : WeaklyEtale V₂.hom := V₂.prop
  have hp₂ : WeaklyEtale (e₂.inv ≫ V₂.hom) := inferInstance
  have E1 : Spec.map (CommRingCat.ofHom (ρ.comp ψ₂)) ≫ (e₂.inv ≫ V₂.hom) = e₁.inv ≫ V₁.hom := by
    rw [← C1]
    simp only [Category.assoc, Iso.hom_inv_id_assoc, hw₂, hwh]
  have E2 : Spec.map (CommRingCat.ofHom (ψ₁.comp ρ)) ≫ (e₂.inv ≫ V₂.hom) = e₁.inv ≫ V₁.hom := by
    rw [← C2]
    simp only [Category.assoc, Iso.hom_inv_id_assoc, hwh, hw₁]

  letI : Fintype K := Fintype.ofFinite K
  haveI hcharK : CharP K (ringChar K) := ringChar.charP K
  haveI hpp : Fact (Nat.Prime (ringChar K)) := ⟨CharP.char_is_prime K (ringChar K)⟩
  obtain ⟨n, -, hn⟩ := FiniteField.card K (ringChar K)
  have hQ : Nat.card K ^ d = ringChar K ^ ((n : ℕ) * d) := by
    rw [Nat.card_eq_fintype_card, hn, pow_mul]
  rw [hQ] at hf₁ hf₂
  obtain ⟨κ, -⟩ : ∃ κ : K →+* A₁, True :=
    ⟨(Spec.preimage (e₁.inv ≫ V₁.hom ≫ (wcP1Over K).hom)).hom, trivial⟩
  haveI : CharP (IsLocalRing.ResidueField A₁) (ringChar K) := by
    letI : Algebra K (IsLocalRing.ResidueField A₁) := ((IsLocalRing.residue A₁).comp κ).toAlgebra
    haveI : IsSimpleRing K := DivisionRing.isSimpleRing K
    exact charP_of_injective_algebraMap (R := K) (A := IsLocalRing.ResidueField A₁)
      (RingHom.injective (algebraMap K (IsLocalRing.ResidueField A₁))) (ringChar K)

  have hres : ∀ a : A₂, IsLocalRing.residue A₁ ((ρ.comp ψ₂) a) =
      IsLocalRing.residue A₁ ((ψ₁.comp ρ) a) := by
    intro a
    simp only [RingHom.comp_apply]
    have hu : (IsLocalRing.residue A₁ (ρ (ψ₂ a))) ^ (ringChar K ^ ((n : ℕ) * d)) =
        IsLocalRing.residue A₁ (ρ a) := by
      have h1 := map_nonunit ρ _ (hf₂ a)
      rw [← IsLocalRing.residue_eq_zero_iff] at h1
      simp only [map_sub, map_pow, sub_eq_zero] at h1
      exact h1
    have hw : (IsLocalRing.residue A₁ (ψ₁ (ρ a))) ^ (ringChar K ^ ((n : ℕ) * d)) =
        IsLocalRing.residue A₁ (ρ a) := by
      have h1 := hf₁ (ρ a)
      rw [← IsLocalRing.residue_eq_zero_iff] at h1
      simp only [map_sub, map_pow, sub_eq_zero] at h1
      exact h1
    have h0 : (IsLocalRing.residue A₁ (ρ (ψ₂ a)) - IsLocalRing.residue A₁ (ψ₁ (ρ a))) ^
        (ringChar K ^ ((n : ℕ) * d)) = 0 := by
      rw [sub_pow_char_pow, hu, hw, sub_self]
    exact sub_eq_zero.mp ((pow_eq_zero_iff (pow_ne_zero _ hpp.out.ne_zero)).mp h0)

  obtain ⟨R, φ, hWR, hcomp⟩ := s7 _ A₂ A₁ (e₂.inv ≫ V₂.hom) hp₂ (ρ.comp ψ₂) (ψ₁.comp ρ)
    (E1.trans E2.symm)
  have hg : ρ.comp ψ₂ = ψ₁.comp ρ := by
    letI : Algebra R A₂ := φ.toAlgebra
    letI : Algebra R A₁ := ((ρ.comp ψ₂).comp φ).toAlgebra
    let F₁ : A₂ →ₐ[R] A₁ := { (ρ.comp ψ₂) with commutes' := fun r => rfl }
    let F₂ : A₂ →ₐ[R] A₁ :=
      { (ψ₁.comp ρ) with commutes' := fun r => (RingHom.congr_fun hcomp r).symm }
    have hF := s6 R A₂ A₁ hWR F₁ F₂ hres
    exact RingHom.ext fun a => AlgHom.congr_fun hF a

  apply MorphismProperty.Over.Hom.ext
  show h.left ≫ φ₂.left = φ₁.left ≫ h.left
  have key : e₁.inv ≫ (h.left ≫ φ₂.left) ≫ e₂.hom = e₁.inv ≫ (φ₁.left ≫ h.left) ≫ e₂.hom := by
    rw [C1, C2, hg]
  rw [Iso.cancel_iso_inv_left, Iso.cancel_iso_hom_right] at key
  exact key

theorem wc_proet_strict_local_endo_isIso (S : Scheme.{u}) (V : S.ProEt) (A : Type u)
    [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A)) (α : V ⟶ V)
    (hα : α.left (e.inv (IsLocalRing.closedPoint A)) = e.inv (IsLocalRing.closedPoint A)) :
    IsIso α :=
by
  classical

  have s6 : ∀ (R E : Type u) [CommRing R] [CommRing E] [Algebra R E],
      WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R E))) → Algebra.WeaklyEtale R E := by
    intro R E _ _ _ hW
    have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap R E))) := hW.flat
    have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R E)))) :=
      hW.flat_diagonal
    rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
      RingHom.flat_algebraMap_iff] at hf
    rw [diagonal_SpecMap] at hd
    have hd' : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' R (S := E)).toRingHom)) := by
      have heq : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) =
          (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) ≫
            (pullbackSpecIso R E E).inv) ≫ (pullbackSpecIso R E E).hom := by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [heq]
      infer_instance
    rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hd'
    exact ⟨hf, hd'⟩

  haveI : WeaklyEtale V.hom := V.prop
  haveI : WeaklyEtale (α.left ≫ V.hom) := by
    rw [MorphismProperty.Over.w α]; exact V.prop
  haveI : WeaklyEtale α.left := WeaklyEtale.of_comp α.left V.hom

  let f : Spec (.of A) ⟶ Spec (.of A) := e.inv ≫ α.left ≫ e.hom
  have hWf : WeaklyEtale f := inferInstance
  let θc : CommRingCat.of A ⟶ CommRingCat.of A := Spec.preimage f
  have hθ : Spec.map θc = f := Spec.map_preimage f
  let θ : A →+* A := θc.hom
  have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (@algebraMap A A _ _ θ.toAlgebra))) := by
    change WeaklyEtale (Spec.map θc)
    rw [hθ]; exact hWf
  have hAE : @Algebra.WeaklyEtale A A _ _ θ.toAlgebra := @s6 A A _ _ θ.toAlgebra hW'

  have h1 : (Spec.map θc) (IsLocalRing.closedPoint A) = IsLocalRing.closedPoint A := by
    rw [hθ]
    show e.hom (α.left (e.inv (IsLocalRing.closedPoint A))) = _
    rw [hα]
    change (e.inv ≫ e.hom) (IsLocalRing.closedPoint A) = _
    rw [Iso.inv_hom_id]
    rfl
  have h2 : Ideal.comap θ (IsLocalRing.maximalIdeal A) = IsLocalRing.maximalIdeal A :=
    congrArg PrimeSpectrum.asIdeal h1
  have hloc : IsLocalHom θ := ((IsLocalRing.local_hom_TFAE θ).out 1 5).mpr h2

  have hbij : Function.Bijective θ :=
    @wc_olivier A A _ _ θ.toAlgebra _ _ inferInstance inferInstance hloc hAE

  haveI : IsIso (Spec.map θc) := isIso_SpecMap_iff.mpr hbij
  haveI : IsIso f := by rw [← hθ]; infer_instance
  have hαeq : α.left = e.hom ≫ f ≫ e.inv := by
    simp only [f, Category.assoc, Iso.hom_inv_id, Category.comp_id, Iso.hom_inv_id_assoc]
  haveI : IsIso α.left := by rw [hαeq]; infer_instance

  have hβ : inv α.left ≫ V.hom = V.hom :=
    (IsIso.inv_comp_eq α.left).mpr (MorphismProperty.Over.w α).symm
  let β : V ⟶ V := MorphismProperty.Over.homMk (inv α.left) hβ trivial
  refine ⟨⟨β, ?_, ?_⟩⟩
  · apply MorphismProperty.Over.Hom.ext
    exact IsIso.hom_inv_id α.left
  · apply MorphismProperty.Over.Hom.ext
    exact IsIso.inv_hom_id α.left

theorem wc_stalkLoc_basis_indep (K : Type u) [Field K] [Finite K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (x : (wcP1Over K).left) (d : ℕ)
    (b₁ b₂ : wcStalkBasis K ℓ G σ x d) :
    (wcAddEquivMatrix b₁.e ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left b₁.N.φ)).precomp
      G (zero_add 0))).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) =
    (wcAddEquivMatrix b₂.e ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left b₂.N.φ)).precomp
      G (zero_add 0))).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) :=
by
  classical

  have s10 : ∀ {W : Type (u+1)} [AddCommGroup W] (s : ℚ_[ℓ] → W →+ W) (Φ : W →+ W),
      (∀ (c : ℚ_[ℓ]) (x : W), Φ (s c x) = s c (Φ x)) →
      ∀ (r r' : ℕ) (e : W ≃+ (Fin r → ℚ_[ℓ])) (e' : W ≃+ (Fin r' → ℚ_[ℓ])),
      (∀ (c : ℚ_[ℓ]) (x : W), e (s c x) = c • e x) →
      (∀ (c : ℚ_[ℓ]) (x : W), e' (s c x) = c • e' x) →
      (wcAddEquivMatrix e Φ).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) =
        (wcAddEquivMatrix e' Φ).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) := by
    intro W _ s Φ hΦ r r' e e' he he'
    have hes : ∀ (c : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]), e.symm (c • v) = s c (e.symm v) := fun c v =>
      e.injective (by rw [he, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    have hes' : ∀ (c : ℚ_[ℓ]) (v : Fin r' → ℚ_[ℓ]), e'.symm (c • v) = s c (e'.symm v) :=
      fun c v => e'.injective (by rw [he', AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    have hr : r = r' := by
      let L₀ : (Fin r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin r' → ℚ_[ℓ]) :=
        (e.symm.trans e').toLinearEquiv (fun c v => by
          rw [AddEquiv.trans_apply, AddEquiv.trans_apply, hes, he'])
      have h1 := L₀.finrank_eq
      simpa using h1
    subst hr
    let L : (Fin r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) :=
      (e.symm.trans e').toLinearEquiv (fun c v => by
        rw [AddEquiv.trans_apply, AddEquiv.trans_apply, hes, he'])
    let LA : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) :=
      { toFun := fun v => e (Φ (e.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes, hΦ, he, RingHom.id_apply] }
    let LB : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) :=
      { toFun := fun v => e' (Φ (e'.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes', hΦ, he', RingHom.id_apply] }
    have hA : wcAddEquivMatrix e Φ = LinearMap.toMatrix' LA := by
      ext a b
      rw [LinearMap.toMatrix'_apply]
      rfl
    have hB : wcAddEquivMatrix e' Φ = LinearMap.toMatrix' LB := by
      ext a b
      rw [LinearMap.toMatrix'_apply]
      rfl
    have hconj : LB = L.conj LA := by
      apply LinearMap.ext
      intro v
      rw [LinearEquiv.conj_apply_apply]
      show e' (Φ (e'.symm v)) = e' (e.symm (e (Φ (e.symm (e (e'.symm v))))))
      rw [AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply]
    have hcp : ∀ T : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]),
        (LinearMap.toMatrix' T).charpoly = T.charpoly := by
      intro T
      have h2 := LinearMap.charpoly_toMatrix T (Pi.basisFun ℚ_[ℓ] (Fin r))
      rwa [LinearMap.toMatrix_eq_toMatrix'] at h2
    rw [hA, hB, hcp, hcp, hconj, LinearEquiv.charpoly_conj]

  have F1 : ∀ {U U' U'' : (wcP1Over K).left.ProEt} (a : U ⟶ U') (b : U' ⟶ U''),
      wcFreeSheafMap (wcP1Over K).left (a ≫ b) =
        wcFreeSheafMap (wcP1Over K).left a ≫ wcFreeSheafMap (wcP1Over K).left b := by
    intro U U' U'' a b
    unfold wcFreeSheafMap
    rw [CategoryTheory.Functor.map_comp, Functor.whiskerRight_comp,
      CategoryTheory.Functor.map_comp]
    all_goals rfl
  have F0 : ∀ (U : (wcP1Over K).left.ProEt),
      wcFreeSheafMap (wcP1Over K).left (𝟙 U) = 𝟙 _ := by
    intro U
    unfold wcFreeSheafMap
    rw [CategoryTheory.Functor.map_id, Functor.whiskerRight_id', CategoryTheory.Functor.map_id]
    rfl
  have hPre : ∀ {U U' U'' : (wcP1Over K).left.ProEt} (a : U ⟶ U') (b : U' ⟶ U'')
      (y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left U'') G 0),
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left a)).precomp G (zero_add 0)
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left b)).precomp G (zero_add 0) y) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (a ≫ b))).precomp G (zero_add 0) y := by
    intro U U' U'' a b y
    show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left a)).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left b)).comp y (zero_add 0)) (zero_add 0) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (a ≫ b))).comp y (zero_add 0)
    rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, F1]
  have hPreId : ∀ {U : (wcP1Over K).left.ProEt}
      (y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left U) G 0),
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (𝟙 U))).precomp G (zero_add 0) y = y := by
    intro U y
    show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (𝟙 U))).comp y (zero_add 0) = y
    rw [F0, Abelian.Ext.mk₀_id_comp]
  have hPreSc : ∀ {U U' : (wcP1Over K).left.ProEt} (a : U ⟶ U') (c : ℚ_[ℓ])
      (y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left U') G 0),
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left a)).precomp G (zero_add 0)
        ((Abelian.Ext.mk₀ (σ c)).postcomp (wcFreeSheaf (wcP1Over K).left U') (add_zero 0) y) =
      (Abelian.Ext.mk₀ (σ c)).postcomp (wcFreeSheaf (wcP1Over K).left U) (add_zero 0)
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left a)).precomp G (zero_add 0) y) := by
    intro U U' a c y
    show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left a)).comp
        (y.comp (Abelian.Ext.mk₀ (σ c)) (add_zero 0)) (zero_add 0) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left a)).comp y (zero_add 0)).comp
        (Abelian.Ext.mk₀ (σ c)) (add_zero 0)
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (add_zero 0) (by omega)).symm
  have hPreIso : ∀ {U U' : (wcP1Over K).left.ProEt} (α : U ⟶ U'), IsIso α →
      Function.Bijective ⇑((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left α)).precomp G
        (zero_add 0)) := by
    intro U U' α hα
    refine Function.bijective_iff_has_inverse.mpr
      ⟨⇑((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (inv α))).precomp G (zero_add 0)),
        ?_, ?_⟩
    · intro y
      rw [hPre, IsIso.inv_hom_id, hPreId]
    · intro y
      rw [hPre, IsIso.hom_inv_id, hPreId]

  letI := b₁.N.ringA
  haveI := b₁.N.hensA
  haveI := b₁.N.sepA
  letI := b₂.N.ringA
  haveI := b₂.N.hensA
  haveI := b₂.N.sepA
  obtain ⟨h, hh⟩ := wc_proet_strict_local_map_through_point (wcP1Over K).left b₁.N.V b₂.N.V
    b₁.N.A b₁.N.e (b₂.N.e.inv (IsLocalRing.closedPoint b₂.N.A)) (b₂.N.hx.trans b₁.N.hx.symm)
  obtain ⟨h', hh'⟩ := wc_proet_strict_local_map_through_point (wcP1Over K).left b₂.N.V b₁.N.V
    b₂.N.A b₂.N.e (b₁.N.e.inv (IsLocalRing.closedPoint b₁.N.A)) (b₁.N.hx.trans b₂.N.hx.symm)
  have hcomm : h ≫ b₂.N.φ = b₁.N.φ ≫ h :=
    wc_frob_nbhd_map_comm K d b₁.N.V b₂.N.V b₁.N.φ b₂.N.φ b₁.N.A b₂.N.A b₁.N.e b₂.N.e
      b₁.N.ψ b₂.N.ψ b₁.N.hψ b₂.N.hψ b₁.N.hfrob b₂.N.hfrob h hh
  have hI1 : IsIso (h ≫ h') :=
    wc_proet_strict_local_endo_isIso (wcP1Over K).left b₁.N.V b₁.N.A b₁.N.e (h ≫ h') (by
      have hc : (h ≫ h').left = h.left ≫ h'.left := rfl
      rw [hc, Scheme.Hom.comp_apply, hh, hh'])
  have hI2 : IsIso (h' ≫ h) :=
    wc_proet_strict_local_endo_isIso (wcP1Over K).left b₂.N.V b₂.N.A b₂.N.e (h' ≫ h) (by
      have hc : (h' ≫ h).left = h'.left ≫ h.left := rfl
      rw [hc, Scheme.Hom.comp_apply, hh', hh])
  have hbij : Function.Bijective
      ⇑((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left h)).precomp G (zero_add 0)) := by
    constructor
    · intro y₁ y₂ hy
      have h3 := congrArg
        ⇑((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left h')).precomp G (zero_add 0)) hy
      rw [hPre, hPre] at h3
      exact (hPreIso _ hI2).1 h3
    · intro z
      obtain ⟨w, hw⟩ := (hPreIso _ hI1).2 z
      exact ⟨(Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left h')).precomp G (zero_add 0) w,
        by rw [hPre, hw]⟩
  obtain ⟨T, hTdef⟩ : ∃ T : Abelian.Ext (wcFreeSheaf (wcP1Over K).left b₂.N.V) G 0 ≃+
      Abelian.Ext (wcFreeSheaf (wcP1Over K).left b₁.N.V) G 0,
      ⇑T = ⇑((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left h)).precomp G (zero_add 0)) :=
    ⟨AddEquiv.ofBijective _ hbij, rfl⟩
  have hT : ∀ y, T ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left b₂.N.φ)).precomp G
      (zero_add 0) y) = (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left b₁.N.φ)).precomp G
      (zero_add 0) (T y) := by
    intro y
    rw [hTdef, hPre, hPre, hcomm]
  have hM : wcAddEquivMatrix (T.trans b₁.e)
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left b₂.N.φ)).precomp G (zero_add 0)) =
      wcAddEquivMatrix b₁.e
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left b₁.N.φ)).precomp G (zero_add 0)) := by
    ext a c
    simp only [wcAddEquivMatrix, Matrix.of_apply, AddEquiv.trans_apply,
      AddEquiv.symm_trans_apply]
    rw [hT, AddEquiv.apply_symm_apply]
  have he' : ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left b₂.N.V) G 0),
      (T.trans b₁.e) ((Abelian.Ext.mk₀ (σ c)).postcomp (wcFreeSheaf (wcP1Over K).left b₂.N.V)
        (add_zero 0) y) = c • (T.trans b₁.e) y := by
    intro c y
    rw [AddEquiv.trans_apply, AddEquiv.trans_apply, hTdef, hPreSc, b₁.he]
  rw [← hM]
  exact s10 (fun c => (Abelian.Ext.mk₀ (σ c)).postcomp (wcFreeSheaf (wcP1Over K).left b₂.N.V)
      (add_zero 0))
    ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left b₂.N.φ)).precomp G (zero_add 0))
    (fun c y => hPreSc b₂.N.φ c y) _ _ (T.trans b₁.e) b₂.e he' b₂.he

theorem wc_pencil_KS_stalks_off_S (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n))
    (ψ : ℚ_[ℓ] → (Subobject.underlying.obj (wcPencilKS D ℓ hP) ⟶
        Subobject.underlying.obj (wcPencilKS D ℓ hP)))
    (hψ : ∀ c : ℚ_[ℓ], ψ c ≫ (wcPencilKS D ℓ hP).arrow =
        (wcPencilKS D ℓ hP).arrow ≫ wcPencilVQScalar D ℓ hP c) :
    ∀ d : ℕ, 1 ≤ d → ∀ x ∈ wcPencilOffS D d,
      wcStalkLoc F'' ℓ (Subobject.underlying.obj (wcPencilKS D ℓ hP)) ψ x d =
        wcPencilLoc D ℓ hP x d :=
by
  classical
  intro d hd x hx
  obtain ⟨_, _, hxS⟩ := hx

  have hbij : ∀ N : wcFrobNbhd F'' x d,
      Function.Bijective ((Abelian.Ext.mk₀ (wcPencilKS D ℓ hP).arrow).postcomp
        (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0)) := by
    intro N
    letI := N.ringA
    haveI := N.hensA
    exact wc_KS_ext0_postcomp_bijective F' F'' Y n D ℓ hP N.V N.A N.e x hxS N.hx

  have hFr : ∀ (V : (wcP1Over F'').left.ProEt) (φ : V ⟶ V)
      (z : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V)
        (Subobject.underlying.obj (wcPencilKS D ℓ hP)) 0),
      (Abelian.Ext.mk₀ (wcPencilKS D ℓ hP).arrow).postcomp
        (wcFreeSheaf (wcP1Over F'').left V) (add_zero 0)
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ)).precomp
          (Subobject.underlying.obj (wcPencilKS D ℓ hP)) (zero_add 0) z) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ)).precomp
        (wcPencilVQ D ℓ hP) (zero_add 0)
        ((Abelian.Ext.mk₀ (wcPencilKS D ℓ hP).arrow).postcomp
          (wcFreeSheaf (wcP1Over F'').left V) (add_zero 0) z) := by
    intro V φ z
    show ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ)).comp z (zero_add 0)).comp
        (Abelian.Ext.mk₀ (wcPencilKS D ℓ hP).arrow) (add_zero 0) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ)).comp
        (z.comp (Abelian.Ext.mk₀ (wcPencilKS D ℓ hP).arrow) (add_zero 0)) (zero_add 0)
    exact Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (add_zero 0) (by omega)

  have hSc : ∀ (V : (wcP1Over F'').left.ProEt) (c : ℚ_[ℓ])
      (z : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V)
        (Subobject.underlying.obj (wcPencilKS D ℓ hP)) 0),
      (Abelian.Ext.mk₀ (wcPencilKS D ℓ hP).arrow).postcomp
        (wcFreeSheaf (wcP1Over F'').left V) (add_zero 0)
        ((Abelian.Ext.mk₀ (ψ c)).postcomp (wcFreeSheaf (wcP1Over F'').left V) (add_zero 0) z) =
      (Abelian.Ext.mk₀ (wcPencilVQScalar D ℓ hP c)).postcomp
        (wcFreeSheaf (wcP1Over F'').left V) (add_zero 0)
        ((Abelian.Ext.mk₀ (wcPencilKS D ℓ hP).arrow).postcomp
          (wcFreeSheaf (wcP1Over F'').left V) (add_zero 0) z) := by
    intro V c z
    show (z.comp (Abelian.Ext.mk₀ (ψ c)) (add_zero 0)).comp
        (Abelian.Ext.mk₀ (wcPencilKS D ℓ hP).arrow) (add_zero 0) =
      (z.comp (Abelian.Ext.mk₀ (wcPencilKS D ℓ hP).arrow) (add_zero 0)).comp
        (Abelian.Ext.mk₀ (wcPencilVQScalar D ℓ hP c)) (add_zero 0)
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (add_zero 0) (by omega),
      Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hψ c]

  have hmat : ∀ {W₁ W₂ : Type (u+1)} [AddCommGroup W₁] [AddCommGroup W₂] {r : ℕ}
      (I : W₁ ≃+ W₂) (Φ₁ : W₁ →+ W₁) (Φ₂ : W₂ →+ W₂) (_ : ∀ z, I (Φ₁ z) = Φ₂ (I z))
      (e : W₁ ≃+ (Fin r → ℚ_[ℓ])),
      wcAddEquivMatrix (I.symm.trans e) Φ₂ = wcAddEquivMatrix e Φ₁ := by
    intro W₁ W₂ _ _ r I Φ₁ Φ₂ hI e
    ext a b
    simp only [wcAddEquivMatrix, Matrix.of_apply, AddEquiv.trans_apply,
      AddEquiv.symm_trans_apply, AddEquiv.symm_symm]
    rw [← hI, AddEquiv.symm_apply_apply]
  unfold wcStalkLoc wcPencilLoc
  by_cases h₁ : Nonempty (wcStalkBasis F'' ℓ (Subobject.underlying.obj (wcPencilKS D ℓ hP)) ψ x d)
  · rw [dif_pos h₁]
    let I := AddEquiv.ofBijective _ (hbij h₁.some.N)
    have he₂ : ∀ (c : ℚ_[ℓ])
        (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left h₁.some.N.V) (wcPencilVQ D ℓ hP) 0),
        (I.symm.trans h₁.some.e) ((Abelian.Ext.mk₀ (wcPencilVQScalar D ℓ hP c)).postcomp
          (wcFreeSheaf (wcP1Over F'').left h₁.some.N.V) (add_zero 0) y) =
          c • (I.symm.trans h₁.some.e) y := by
      intro c y
      obtain ⟨z, rfl⟩ := I.surjective y
      have h' : (Abelian.Ext.mk₀ (wcPencilVQScalar D ℓ hP c)).postcomp
          (wcFreeSheaf (wcP1Over F'').left h₁.some.N.V) (add_zero 0) (I z) =
          I ((Abelian.Ext.mk₀ (ψ c)).postcomp
            (wcFreeSheaf (wcP1Over F'').left h₁.some.N.V) (add_zero 0) z) :=
        (hSc _ c z).symm
      rw [AddEquiv.trans_apply, AddEquiv.trans_apply, h', AddEquiv.symm_apply_apply,
        AddEquiv.symm_apply_apply, h₁.some.he]
    have hP2 : Nonempty (wcPencilStalkBasis D ℓ hP x d) :=
      ⟨⟨h₁.some.N, h₁.some.r, I.symm.trans h₁.some.e, he₂⟩⟩
    rw [dif_pos hP2]
    have hM : wcAddEquivMatrix (I.symm.trans h₁.some.e)
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left h₁.some.N.φ)).precomp
          (wcPencilVQ D ℓ hP) (zero_add 0)) =
        wcAddEquivMatrix h₁.some.e
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left h₁.some.N.φ)).precomp
          (Subobject.underlying.obj (wcPencilKS D ℓ hP)) (zero_add 0)) :=
      hmat I _ _ (fun z => hFr _ _ z) h₁.some.e
    have key := wc_stalkLoc_basis_indep F'' ℓ (wcPencilVQ D ℓ hP) (wcPencilVQScalar D ℓ hP) x d
      ⟨h₁.some.N, h₁.some.r, I.symm.trans h₁.some.e, he₂⟩
      ⟨hP2.some.N, hP2.some.r, hP2.some.e, hP2.some.he⟩
    exact (congrArg (fun M => M.charpoly.aroots (AlgebraicClosure ℚ_[ℓ])) hM).symm.trans key
  · rw [dif_neg h₁]
    have hP2 : ¬ Nonempty (wcPencilStalkBasis D ℓ hP x d) := by
      rintro ⟨b₂⟩
      apply h₁
      let I := AddEquiv.ofBijective _ (hbij b₂.N)
      refine ⟨⟨b₂.N, b₂.r, I.trans b₂.e, ?_⟩⟩
      intro c z
      rw [AddEquiv.trans_apply, AddEquiv.trans_apply, ← b₂.he]
      exact congrArg b₂.e (hSc _ c z)
    rw [dif_neg hP2]

theorem wc_pencil_VQ_lisse (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    wcLisseOffS F'' hP ℓ D.m D.S (wcPencilVQ D ℓ hP) (wcPencilVQScalar D ℓ hP) :=
by
  classical

  haveI := D.proper
  haveI hsep : IsSeparated (wcP1Over F'').hom := (inferInstance : IsSeparated (wcProjKStr F'' 1))
  haveI hcomp : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
  haveI hfp : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom
  haveI hPw : WeaklyEtale (wcGeomPoint F'' (wcP1Over F'') hP).hom := hP

  obtain ⟨Ub, hUb, hconn, hcpt, hqs, hqcι⟩ := wc_P1bar_smooth_locus F'' hP D.m D.S D.hS
  haveI := hqcι
  have hu : WeaklyEtale (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := inferInstance

  have htors : ∀ j : ℕ, ∃ (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme),
      IsFinite πE ∧ Etale πE ∧ Surjective πE ∧
      ∃ hE : WeaklyEtale (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom),
      ∃ (b' : ℕ) (e' : Fin b' → ℕ),
        Nonempty ((((wcProEtPush D.f).rightDerived (Nat.unpair j).1).obj
            (wcContSheaf D.Yt.left (ZMod (ℓ ^ (Nat.unpair j).2)))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hE) ≅
          (wcContSheaf (wcP1Over F'').left ((i : Fin b') → ZMod (ℓ ^ e' i))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hE)) := by
    intro j
    obtain ⟨N, V, v, het, hcov, hV, b, e, hiso⟩ :=
      wc_pencil_Rq_torsion_etale_locally_const F' F'' Y n D ℓ hℓ hP Ub hUb
        (Nat.unpair j).1 (Nat.unpair j).2
    exact wc_proet_loc_const_finite_fet_trivial (wcP1Over F'').left _ ℓ Ub.toScheme
      (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hu hconn hcpt hqs N V v het hcov hV b e hiso
  choose E πE hfin het hsurj hE b' e' hθ using htors

  obtain ⟨W₀, p, hpWE, hpqc, hpsurj, hW₀conn, hW₀cpt, hW₀qs, ht⟩ :=
    wc_fet_tower_connected_limit Ub.toScheme hconn hcpt hqs E πE hfin het hsurj
  choose t ht using ht
  haveI := hpWE
  haveI := hpqc
  have hWE : WeaklyEtale (p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := inferInstance
  have havoid0 : ∀ (y : W₀) (i : Fin D.m),
      (p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) y ≠ D.S i (IsLocalRing.closedPoint F'') := by
    intro y i
    have hmem : Ub.ι (p y) ∈ Set.range Ub.ι := ⟨p y, rfl⟩
    rw [Scheme.Opens.range_ι] at hmem
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    exact (hUb _).1 hmem i

  let W : (wcP1Over F'').left.ProEt :=
    MorphismProperty.Over.mk ⊤ (p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hWE
  let w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP :=
    MorphismProperty.Over.homMk (p ≫ Ub.ι) (Category.assoc _ _ _) trivial
  let Ej : ℕ → (wcP1Over F'').left.ProEt := fun j =>
    MorphismProperty.Over.mk ⊤ (πE j ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) (hE j)
  let c : ∀ j, W ⟶ Ej j := fun j =>
    MorphismProperty.Over.homMk (t j)
      (show t j ≫ πE j ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom =
          p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom by
        rw [← Category.assoc, ht j]) trivial

  have hres : ∀ q' k : ℕ, ∃ (b : ℕ) (e : Fin b → ℕ),
      Nonempty ((((wcProEtPush D.f).rightDerived q').obj (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))).over W ≅
        (wcContSheaf (wcP1Over F'').left ((j : Fin b) → ZMod (ℓ ^ e j))).over W) := by
    intro q' k
    have h := hθ (Nat.pair q' k)
    rw [Nat.unpair_pair] at h
    obtain ⟨θ⟩ := h
    exact ⟨b' (Nat.pair q' k), e' (Nat.pair q' k),
      ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback AddCommGrpCat.{u+1}
        (c (Nat.pair q' k))).mapIso θ⟩⟩

  obtain ⟨a, b, e, hZ⟩ :=
    wc_proet_Rq_int_const_of_torsion_const D.f ℓ W hW₀conn hW₀cpt hW₀qs hres (n - 1)
  obtain ⟨τ, hτ⟩ := wc_proet_Rq_rat_linear_triv D.f ℓ W hW₀conn hW₀cpt hW₀qs (n - 1) a b e hZ
  have hR : wcScalarTriv (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1)) (wcRqScalar D.f ℓ (n - 1)) W a :=
    ⟨τ, fun c' => hτ c'⟩

  choose ψ hψE hψπ using wc_pencil_VQScalar_spec F' F'' Y n D ℓ hP
  have restr : ∀ (G : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}),
      wcPencilGC F'' hP ℓ G → ∃ b : ℕ,
        Nonempty (G.over W ≅ (wcContSheaf (wcP1Over F'').left (Fin b → ℚ_[ℓ])).over W) := by
    intro G hG
    obtain ⟨b, ⟨θ⟩⟩ := hG
    exact ⟨b, ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback
      AddCommGrpCat.{u+1} w).mapIso θ⟩⟩
  have hcok : IsIso (wcPencilE D ℓ hP).arrow ∨ ∃ b : ℕ,
      Nonempty ((Limits.cokernel (wcPencilE D ℓ hP).arrow).over W ≅
        (wcContSheaf (wcP1Over F'').left (Fin b → ℚ_[ℓ])).over W) := by
    by_cases h : ∃ M : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M ∧
        wcPencilGC F'' hP ℓ (Limits.cokernel M.arrow) ∧
        ∀ M' : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M' →
          wcPencilGC F'' hP ℓ (Limits.cokernel M'.arrow) → M ≤ M'
    · have hE : wcPencilE D ℓ hP = Classical.choose h := dif_pos h
      have hgc : wcPencilGC F'' hP ℓ (Limits.cokernel (wcPencilE D ℓ hP).arrow) := by
        rw [hE]; exact (Classical.choose_spec h).2.1
      exact Or.inr (restr _ hgc)
    · have hE : wcPencilE D ℓ hP = ⊤ := dif_neg h
      left
      rw [hE]
      infer_instance

  obtain ⟨e₁, hEW⟩ := wc_scalarTriv_sub_of_coker_const (wcP1Over F'').left ℓ W hW₀conn
    (wcRq D.f ℓ (n - 1)) (Subobject.underlying.obj (wcPencilE D ℓ hP))
    (wcRqScalar D.f ℓ (n - 1)) ψ a hR (wcPencilE D ℓ hP).arrow hψE hcok

  obtain ⟨k, hZk⟩ := restr _ (wc_pencil_EC_geomConst F' F'' Y n hn hn2 D ℓ hℓ hP)

  obtain ⟨r, hVQ⟩ := wc_scalarTriv_coker_of_const (wcP1Over F'').left ℓ W hW₀conn
    (Subobject.underlying.obj (wcPencilE D ℓ hP))
    (Subobject.underlying.obj (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)) ψ e₁ hEW k hZk
    ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).ofLE (wcPencilE D ℓ hP) inf_le_left)
    (wcPencilVQScalar D ℓ hP) hψπ

  unfold wcLisseOffS
  refine ⟨W, w, r, ?_, hW₀conn, ?_, ?_, hVQ⟩
  · show QuasiCompact (p ≫ Ub.ι)
    infer_instance
  · intro z i
    exact havoid0 z i
  · intro x hx
    have hxU : x ∈ Ub := (hUb x).2 hx
    obtain ⟨y, hy⟩ : x ∈ Set.range Ub.ι := by rw [Scheme.Opens.range_ι]; exact hxU
    obtain ⟨z, hz⟩ := hpsurj.surj y
    refine ⟨z, ?_⟩
    show (p ≫ Ub.ι) z = x
    rw [Scheme.Hom.comp_apply, hz, hy]

theorem wc_zeroAtS_greatest_app_bijective (K : Type u) [Field K] (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) (M : Subobject G)
    (hM : ∀ M' : Subobject G, wcZeroAtS K m S (Subobject.underlying.obj M') → M' ≤ M)
    (T : (wcP1Over K).left.ProEt)
    (hT : ∀ (t : T.left) (i : Fin m), T.hom t ≠ S i (IsLocalRing.closedPoint K)) :
    Function.Bijective (M.arrow.hom.app (Opposite.op T)) :=
by
  classical

  have s6 : ∀ (R E : Type u) [CommRing R] [CommRing E] [Algebra R E],
      WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R E))) → Algebra.WeaklyEtale R E := by
    intro R E _ _ _ hW
    have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap R E))) := hW.flat
    have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R E)))) :=
      hW.flat_diagonal
    rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
      RingHom.flat_algebraMap_iff] at hf
    rw [diagonal_SpecMap] at hd
    have hd' : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' R (S := E)).toRingHom)) := by
      have heq : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) =
          (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) ≫
            (pullbackSpecIso R E E).inv) ≫ (pullbackSpecIso R E E).hom := by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [heq]
      infer_instance
    rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hd'
    exact ⟨hf, hd'⟩

  have hcov : ∀ (S' : Scheme.{u}) (A : Type u) [CommRing A] [HenselianLocalRing A]
      [IsSepClosed (IsLocalRing.ResidueField A)]
      (U : S'.ProEt) (R' : Sieve U), R' ∈ Scheme.ProEt.topology S' U →
      ∀ (W : S'.ProEt) (a : W ⟶ U), Nonempty (W.left ≅ Spec (.of A)) → R'.arrows a := by
    intro S' A _ _ _

    have s7 : ∀ (E : Type u) [CommRing E] [Algebra A E],
        Algebra.WeaklyEtale A E → ∀ (p : Ideal E) [p.IsPrime],
        p.comap (algebraMap A E) = IsLocalRing.maximalIdeal A → Nonempty (E →ₐ[A] A) := by
      intro E _ _ hAE p _ hp
      haveI : Algebra.WeaklyEtale E (Localization.AtPrime p) :=
        wc_localization_weaklyEtale E (Localization.AtPrime p) p.primeCompl
      haveI := hAE
      haveI : Algebra.WeaklyEtale A (Localization.AtPrime p) := Algebra.WeaklyEtale.trans A E _
      have hloc : IsLocalHom (algebraMap A (Localization.AtPrime p)) := by
        have h1 : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap
            (algebraMap A (Localization.AtPrime p)) = IsLocalRing.maximalIdeal A := by
          rw [IsScalarTower.algebraMap_eq A E (Localization.AtPrime p), ← Ideal.comap_comap]
          have h2 : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap
              (algebraMap E (Localization.AtPrime p)) = p :=
            Localization.AtPrime.under_maximalIdeal
          rw [h2, hp]
        exact ((IsLocalRing.local_hom_TFAE (algebraMap A (Localization.AtPrime p))).out 1 5).mpr h1
      have hbij := wc_olivier A (Localization.AtPrime p) inferInstance inferInstance hloc
        inferInstance
      let eqv : A ≃ₐ[A] Localization.AtPrime p := AlgEquiv.ofBijective (Algebra.ofId A _) hbij
      exact ⟨eqv.symm.toAlgHom.comp (IsScalarTower.toAlgHom A E (Localization.AtPrime p))⟩

    have s5 : ∀ {U V : Scheme.{u}} (e : U ≅ Spec (.of A)) (g : V ⟶ U) [WeaklyEtale g] (v : V),
        e.hom (g v) = IsLocalRing.closedPoint A → ∃ σ : U ⟶ V, σ ≫ g = 𝟙 U := by
      intro U V e g _ v hv
      obtain ⟨E, ι, hι, hvι, -⟩ :=
        Scheme.exists_affine_mem_range_and_range_subset (U := (⊤ : V.Opens)) (x := v) trivial
      obtain ⟨w, hw⟩ := hvι
      have := hι
      let h : Spec E ⟶ Spec (.of A) := ι ≫ g ≫ e.hom
      have hWh : WeaklyEtale h := inferInstance
      let φ : CommRingCat.of A ⟶ E := Spec.preimage h
      have hφ : Spec.map φ = h := Spec.map_preimage h
      letI : Algebra A E := (CommRingCat.Hom.hom φ).toAlgebra
      have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap A E))) := by
        change WeaklyEtale (Spec.map φ)
        rw [hφ]
        exact hWh
      have hAE : Algebra.WeaklyEtale A E := s6 A E hW'
      let p : PrimeSpectrum E := w
      have hq : (p.asIdeal).comap (algebraMap A E) = IsLocalRing.maximalIdeal A := by
        have h1 : (Spec.map φ) w = IsLocalRing.closedPoint A := by
          rw [hφ]
          show e.hom (g (ι w)) = _
          rw [hw, hv]
        exact congrArg PrimeSpectrum.asIdeal h1
      obtain ⟨τ⟩ := s7 E hAE p.asIdeal hq
      let τ' : E ⟶ CommRingCat.of A := CommRingCat.ofHom (τ : E →+* A)
      have hret : φ ≫ τ' = 𝟙 _ := by
        ext r
        exact τ.commutes r
      refine ⟨e.hom ≫ Spec.map τ' ≫ ι, ?_⟩
      rw [← cancel_mono e.hom]
      simp only [Category.assoc, Category.id_comp]
      have h3 : ι ≫ g ≫ e.hom = Spec.map φ := hφ.symm
      rw [h3, ← Spec.map_comp, hret, Spec.map_id, Category.comp_id]

    have s4 : ∀ (U : S'.ProEt) (R : Presieve U), R ∈ (Scheme.ProEt.precoverage S').coverings U →
        ∀ (W : S'.ProEt) (a : W ⟶ U), Nonempty (W.left ≅ Spec (.of A)) →
        ∃ (Y : S'.ProEt) (g : Y ⟶ U) (h : W ⟶ Y), R g ∧ h ≫ g = a := by
      intro U R hR W a ⟨eW⟩
      have hR' : Presieve.map (Scheme.ProEt.forget S' ⋙ Over.forget S') R ∈
          (Scheme.precoverage @WeaklyEtale).coverings U.left := hR.2
      obtain ⟨Y', g', hg', y', hy'⟩ :=
        (Scheme.instJointlySurjectivePrecoverage (P := @WeaklyEtale)).exists_eq _ hR'
          (a.left (eW.inv (IsLocalRing.closedPoint A)))
      obtain ⟨Y, hY, g, hg, hgg⟩ := Presieve.map_iff.mp hg'
      subst hY
      have hgl : g.left = g' := hgg.trans (by simp only [eqToHom_refl]; exact Category.id_comp _)
      haveI : WeaklyEtale U.hom := U.prop
      haveI : WeaklyEtale (g.left ≫ U.hom) := by
        rw [MorphismProperty.Over.w g]; exact Y.prop
      haveI : WeaklyEtale g.left := WeaklyEtale.of_comp g.left U.hom
      obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := a.left) (g := g.left)
        (eW.inv (IsLocalRing.closedPoint A)) y' (by rw [hgl]; exact hy'.symm)
      obtain ⟨σ, hσ⟩ := s5 eW (Limits.pullback.fst a.left g.left) z (by
        rw [hz1]
        change (eW.inv ≫ eW.hom) (IsLocalRing.closedPoint A) = _
        rw [Iso.inv_hom_id]
        rfl)
      have hh₀ : (σ ≫ Limits.pullback.snd a.left g.left) ≫ g.left = a.left := by
        rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hσ, Category.id_comp]
      refine ⟨Y, g, MorphismProperty.Over.homMk (σ ≫ Limits.pullback.snd a.left g.left) ?_ trivial,
        hg, ?_⟩
      · rw [← MorphismProperty.Over.w g, ← Category.assoc, hh₀, MorphismProperty.Over.w a]
      · apply MorphismProperty.Over.Hom.ext
        exact hh₀

    have s3 : ∀ (P : S'.ProEt → Prop),
        (∀ (U : S'.ProEt) (R : Presieve U), R ∈ (Scheme.ProEt.precoverage S').coverings U →
          ∀ (W : S'.ProEt) (a : W ⟶ U), P W →
            ∃ (Y : S'.ProEt) (g : Y ⟶ U) (h : W ⟶ Y), R g ∧ h ≫ g = a) →
        ∀ (U : S'.ProEt) (R₀ : Sieve U), R₀ ∈ Scheme.ProEt.topology S' U →
          ∀ (W : S'.ProEt) (a : W ⟶ U), P W → R₀.arrows a := by
      intro P hK
      let JP : GrothendieckTopology S'.ProEt :=
        GrothendieckTopology.mk
          (fun U => {R₀ : Sieve U | ∀ (W : S'.ProEt) (a : W ⟶ U), P W → R₀.arrows a})
          (by
            intro U W a _
            trivial)
          (by
            intro U Y R₀ f hR₀ W a hW
            rw [Sieve.pullback_apply]
            exact hR₀ W (a ≫ f) hW)
          (by
            intro U R₀ hR₀ R hR W a hW
            have h1 := hR (hR₀ W a hW) W (𝟙 W) hW
            rw [Sieve.pullback_apply, Category.id_comp] at h1
            exact h1)
      have hle : Scheme.ProEt.topology S' ≤ JP := by
        rw [Precoverage.toGrothendieck_le_iff_le_toPrecoverage]
        intro U R hR
        show ∀ (W : S'.ProEt) (a : W ⟶ U), P W → (Sieve.generate R).arrows a
        intro W a hW
        obtain ⟨Y, g, h, hg, hhg⟩ := hK U R hR W a hW
        exact ⟨Y, h, g, hg, hhg⟩
      intro U R₀ hR₀ W a hW
      have h1 : R₀ ∈ JP U := GrothendieckTopology.le_def.mp hle U hR₀
      exact h1 W a hW
    exact s3 (fun W => Nonempty (W.left ≅ Spec (.of A))) s4

  have hfree0 : ∀ (i : Fin m) (V : (wcP1Over K).left.ProEt) (A : Type u) [CommRing A]
      [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
      (e : V.left ≅ Spec (.of A)),
      V.hom (e.inv (IsLocalRing.closedPoint A)) = S i (IsLocalRing.closedPoint K) →
      ∀ u' : wcFreeSheaf (wcP1Over K).left V ⟶ wcFreeSheaf (wcP1Over K).left T, u' = 0 := by
    intro i V A _ _ _ e hV u'
    have hVT : IsEmpty (V ⟶ T) := ⟨fun h => hT (h.left (e.inv (IsLocalRing.closedPoint A))) i (by
      rw [← hV, ← MorphismProperty.Over.w h]
      rfl)⟩
    obtain ⟨eV, -, heV0⟩ := proet_free_sheaf_hom_equiv (wcP1Over K).left V
    apply (eV _).injective
    rw [heV0]
    have hs : ∀ s : ToType ((sheafify (Scheme.ProEt.topology (wcP1Over K).left)
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj (Opposite.op V)),
        s = 0 := by
      intro s
      have hmem := Presheaf.imageSieve_mem (Scheme.ProEt.topology (wcP1Over K).left)
        (toSheafify (Scheme.ProEt.topology (wcP1Over K).left)
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) s
      have h1 := hcov _ A V _ hmem V (𝟙 V) ⟨e⟩
      rw [Presheaf.imageSieve_apply] at h1
      obtain ⟨t, ht⟩ := h1
      have ht0 : t = 0 := @Subsingleton.elim (FreeAbelianGroup (ULift.{u+1} (V ⟶ T))) _ t 0
      rw [ht0, map_zero] at ht
      exact (ht.trans (by simp)).symm
    exact hs _

  obtain ⟨eF, heF, -⟩ := proet_free_sheaf_hom_equiv (wcP1Over K).left T
  constructor
  ·
    intro a b hab
    have h1 : eF G ((eF _).symm a ≫ M.arrow) = eF G ((eF _).symm b ≫ M.arrow) := by
      rw [heF, heF, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
      exact hab
    have h2 := (cancel_mono M.arrow).mp ((eF G).injective h1)
    have h3 := congrArg (eF _) h2
    rwa [Equiv.apply_symm_apply, Equiv.apply_symm_apply] at h3
  ·
    intro y
    obtain ⟨x, rfl⟩ := (eF G).surjective y
    have hI : wcZeroAtS K m S (Subobject.underlying.obj (Limits.imageSubobject x)) := by
      unfold wcZeroAtS
      intro i V A _ _ _ e hV z
      haveI : Projective (wcFreeSheaf (wcP1Over K).left V) :=
        wc_proet_free_projective_strict_local _ V A e
      obtain ⟨u', hu'⟩ := Projective.factors (Abelian.Ext.homEquiv₀ z)
        (Limits.factorThruImageSubobject x)
      have hu0 := hfree0 i V A e hV u'
      rw [hu0, Limits.zero_comp] at hu'
      rw [← Abelian.Ext.homEquiv₀.symm_apply_apply z, ← hu', Abelian.Ext.homEquiv₀_symm_apply,
        Abelian.Ext.mk₀_zero]
    have hle := hM _ hI
    refine ⟨eF _ (Limits.factorThruImageSubobject x ≫ Subobject.ofLE _ _ hle), ?_⟩
    rw [← heF, Category.assoc, Subobject.ofLE_arrow, Limits.imageSubobject_arrow_comp]

theorem wc_pencil_KS_lisse (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n))
    (ψ : ℚ_[ℓ] → (Subobject.underlying.obj (wcPencilKS D ℓ hP) ⟶
        Subobject.underlying.obj (wcPencilKS D ℓ hP)))
    (hψ : ∀ c : ℚ_[ℓ], ψ c ≫ (wcPencilKS D ℓ hP).arrow =
        (wcPencilKS D ℓ hP).arrow ≫ wcPencilVQScalar D ℓ hP c) :
    wcLisseOffS F'' hP ℓ D.m D.S (Subobject.underlying.obj (wcPencilKS D ℓ hP)) ψ :=
by
  classical

  obtain ⟨W, w, r, hqc, hconn, havoid, hcov, t, ht⟩ :=
    wc_pencil_VQ_lisse F' F'' Y n hn hn2 D ℓ hℓ hP

  have s4 : ∀ {X Z : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (f : X ⟶ Z), (∀ T : Over W, Function.Bijective (f.hom.app (Opposite.op T.left))) →
      IsIso (((Scheme.ProEt.topology (wcP1Over F'').left).overPullback
        AddCommGrpCat.{u+1} W).map f) := by
    intro X Z f hf
    haveI : ∀ T : (Over W)ᵒᵖ, IsIso (((sheafToPresheaf _ _).map
        (((Scheme.ProEt.topology (wcP1Over F'').left).overPullback
          AddCommGrpCat.{u+1} W).map f)).app T) := by
      intro T
      exact (ConcreteCategory.isIso_iff_bijective _).mpr (hf T.unop)
    haveI : IsIso ((sheafToPresheaf _ _).map
        (((Scheme.ProEt.topology (wcP1Over F'').left).overPullback
          AddCommGrpCat.{u+1} W).map f)) := NatIso.isIso_of_isIso_app _
    exact isIso_of_reflects_iso _ (sheafToPresheaf _ _)

  have havoidT : ∀ (T : Over W) (z : T.left.left) (i : Fin D.m),
      T.left.hom z ≠ D.S i (IsLocalRing.closedPoint F'') := by
    intro T z i h
    apply havoid (T.hom.left z) i
    have hw : T.hom.left ≫ W.hom = T.left.hom := MorphismProperty.Over.w T.hom
    rw [← h, ← hw]
    rfl

  have hiso : IsIso (((Scheme.ProEt.topology (wcP1Over F'').left).overPullback
      AddCommGrpCat.{u+1} W).map (wcPencilKS D ℓ hP).arrow) := by
    by_cases h : ∃ M : Subobject (wcPencilVQ D ℓ hP),
        wcZeroAtS F'' D.m D.S (Subobject.underlying.obj M) ∧
        ∀ M' : Subobject (wcPencilVQ D ℓ hP),
          wcZeroAtS F'' D.m D.S (Subobject.underlying.obj M') → M' ≤ M
    · have hKS : wcPencilKS D ℓ hP = Classical.choose h := dif_pos h
      have hmax : ∀ M' : Subobject (wcPencilVQ D ℓ hP),
          wcZeroAtS F'' D.m D.S (Subobject.underlying.obj M') → M' ≤ wcPencilKS D ℓ hP := by
        rw [hKS]; exact (Classical.choose_spec h).2
      apply s4
      intro T
      exact wc_zeroAtS_greatest_app_bijective F'' D.m D.S (wcPencilVQ D ℓ hP)
        (wcPencilKS D ℓ hP) hmax T.left (havoidT T)
    · have hKS : wcPencilKS D ℓ hP = ⊤ := dif_neg h
      haveI : IsIso (wcPencilKS D ℓ hP).arrow := by
        rw [hKS]; infer_instance
      infer_instance

  unfold wcLisseOffS wcScalarTriv
  refine ⟨W, w, r, hqc, hconn, havoid, hcov,
    asIso (((Scheme.ProEt.topology (wcP1Over F'').left).overPullback
      AddCommGrpCat.{u+1} W).map (wcPencilKS D ℓ hP).arrow) ≪≫ t, ?_⟩
  intro c
  simp only [Iso.trans_hom, asIso_hom, Category.assoc]
  rw [← Functor.map_comp_assoc, hψ c, Functor.map_comp_assoc, ht c]

theorem wc_hattori_free_class_regroup {Γ : Type u} [Group Γ] [Fintype Γ] [DecidableEq Γ]
    {Y : Type u} [Fintype Y] [DecidableEq Y] (act : Γ → Y → Y) (hact1 : ∀ y, act 1 y = y)
    (hactmul : ∀ g h y, act (g * h) y = act g (act h y)) (hfree : ∀ g y, act g y = y → g = 1)
    (Φ : Y → Y) (hΦ : ∀ g y, Φ (act g y) = act g (Φ y)) (hfix : ∀ y, ∃ g, act g (Φ y) = y)
    {B : Type u} [Fintype B] (π : Y → B) (hπ : Function.Surjective π)
    (hπfib : ∀ y y', π y = π y' ↔ ∃ g, y' = act g y)
    {R : Type*} [CommRing R] [IsDomain R] [CharZero R] (hs : Γ → R)
    (hH : ∀ γ : Γ, ∑ τ : Γ, hs (τ⁻¹ * γ * τ) =
      ((Finset.univ.filter (fun y => act γ (Φ y) = y)).card : R))
    {Λ : Type*} [CommRing Λ] (red : R →+* Λ) (χ : Γ → Λ) (hχ : ∀ g h, χ (h * g * h⁻¹) = χ g)
    (w : B → Λ) (hw : ∀ y g, act g (Φ y) = y → w (π y) = χ g) :
    ∑ g : Γ, red (hs g) * χ g = ∑ b : B, w b :=
by
  classical
  have finj : ∀ (g h : Γ) (z : Y), act g z = act h z → g = h := by
    intro g h z hgh
    have h1 : act (h⁻¹ * g) z = z := by
      rw [hactmul, hgh, ← hactmul, inv_mul_cancel, hact1]
    exact (inv_mul_eq_one.mp (hfree _ _ h1)).symm
  choose c hc using hfix
  have hiff : ∀ γ y, act γ (Φ y) = y ↔ c y = γ := by
    intro γ y
    constructor
    · intro h
      exact finj _ _ _ ((hc y).trans h.symm)
    · rintro rfl
      exact hc y
  have hcconj : ∀ a y, c (act a y) = a * c y * a⁻¹ := by
    intro a y
    apply (hiff _ _).mp
    rw [hΦ, ← hactmul]
    have e : a * c y * a⁻¹ * a = a * c y := by group
    rw [e, hactmul, hc y]
  have hcπ : ∀ y y', π y = π y' → ConjClasses.mk (c y) = ConjClasses.mk (c y') := by
    intro y y' h
    obtain ⟨a, rfl⟩ := (hπfib y y').mp h
    rw [hcconj, ConjClasses.mk_eq_mk_iff_isConj]
    exact isConj_iff.mpr ⟨a, rfl⟩
  have hfib : ∀ b, (Finset.univ.filter (fun y => π y = b)).card = Fintype.card Γ := by
    intro b
    obtain ⟨y0, rfl⟩ := hπ b
    rw [← Finset.card_univ]
    symm
    apply Finset.card_bij (fun g _ => act g y0)
    · intro g _
      simp only [Finset.mem_filter, Finset.mem_univ, true_and]
      exact ((hπfib y0 (act g y0)).mpr ⟨g, rfl⟩).symm
    · intro g _ g' _ h
      exact finj _ _ _ h
    · intro y hy
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hy
      obtain ⟨g, hg⟩ := (hπfib y0 y).mp hy.symm
      exact ⟨g, Finset.mem_univ _, hg.symm⟩
  obtain ⟨sec, hsec⟩ : ∃ sec : B → Y, ∀ b, π (sec b) = b :=
    ⟨Function.surjInv hπ, Function.surjInv_eq hπ⟩
  obtain ⟨rep, hrep⟩ : ∃ rep : ConjClasses Γ → Γ, ∀ C, ConjClasses.mk (rep C) = C :=
    ⟨fun C => Classical.choose (ConjClasses.exists_rep C),
     fun C => Classical.choose_spec (ConjClasses.exists_rep C)⟩
  have hχrep : ∀ g, χ g = χ (rep (ConjClasses.mk g)) := by
    intro g
    have h1 : IsConj g (rep (ConjClasses.mk g)) :=
      ConjClasses.mk_eq_mk_iff_isConj.mp (hrep _).symm
    obtain ⟨a, ha⟩ := isConj_iff.mp h1
    rw [← ha, hχ]
  have hcls : ∀ y, ConjClasses.mk (c (sec (π y))) = ConjClasses.mk (c y) :=
    fun y => hcπ _ _ (hsec (π y))
  have hwb : ∀ b, w b = χ (rep (ConjClasses.mk (c (sec b)))) := by
    intro b
    have h1 := hw (sec b) (c (sec b)) (hc (sec b))
    rw [hsec] at h1
    rw [h1, hχrep]
  have hcount : ∀ C : ConjClasses Γ,
      ∑ γ ∈ Finset.univ.filter (fun γ => ConjClasses.mk γ = C),
        (Finset.univ.filter (fun y => act γ (Φ y) = y)).card =
      Fintype.card Γ * (Finset.univ.filter (fun b => ConjClasses.mk (c (sec b)) = C)).card := by
    intro C
    calc ∑ γ ∈ Finset.univ.filter (fun γ => ConjClasses.mk γ = C),
          (Finset.univ.filter (fun y => act γ (Φ y) = y)).card
        = ∑ y : Y, if ConjClasses.mk (c y) = C then 1 else 0 := by
          simp only [Finset.card_filter]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun y _ => ?_)
          simp only [hiff]
          rw [Finset.sum_ite_eq]
          simp
      _ = ∑ b : B, if ConjClasses.mk (c (sec b)) = C then Fintype.card Γ else 0 := by
          rw [← Finset.sum_fiberwise Finset.univ π
            (fun y => if ConjClasses.mk (c y) = C then 1 else 0)]
          refine Finset.sum_congr rfl (fun b _ => ?_)
          have h1 : ∀ y ∈ Finset.univ.filter (fun y => π y = b),
              (if ConjClasses.mk (c y) = C then 1 else 0) =
                (if ConjClasses.mk (c (sec b)) = C then 1 else 0 : ℕ) := by
            intro y hy
            simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hy
            rw [← hy, hcls]
          rw [Finset.sum_congr rfl h1, Finset.sum_const, hfib b]
          split_ifs <;> simp
      _ = _ := by
          rw [← Finset.sum_filter, Finset.sum_const, smul_eq_mul, mul_comm]
  have hS : ∀ C : ConjClasses Γ,
      ∑ γ ∈ Finset.univ.filter (fun γ => ConjClasses.mk γ = C), hs γ =
        ((Finset.univ.filter (fun b => ConjClasses.mk (c (sec b)) = C)).card : R) := by
    intro C
    have hre : ∀ τ : Γ, ∑ γ ∈ Finset.univ.filter (fun γ => ConjClasses.mk γ = C),
        hs (τ⁻¹ * γ * τ) =
        ∑ γ ∈ Finset.univ.filter (fun γ => ConjClasses.mk γ = C), hs γ := by
      intro τ
      apply Finset.sum_nbij' (fun γ => τ⁻¹ * γ * τ) (fun γ => τ * γ * τ⁻¹)
      · intro γ hγ
        simp only [Finset.mem_univ, true_and, Finset.mem_filter] at hγ ⊢
        rw [← hγ, ConjClasses.mk_eq_mk_iff_isConj]
        exact isConj_iff.mpr ⟨τ, by group⟩
      · intro γ hγ
        simp only [Finset.mem_univ, true_and, Finset.mem_filter] at hγ ⊢
        rw [← hγ, ConjClasses.mk_eq_mk_iff_isConj]
        exact isConj_iff.mpr ⟨τ⁻¹, by group⟩
      · intro γ _
        group
      · intro γ _
        group
      · intro γ _
        rfl
    have hcard : (Fintype.card Γ : R) ≠ 0 := Nat.cast_ne_zero.mpr Fintype.card_pos.ne'
    apply mul_left_cancel₀ hcard
    calc (Fintype.card Γ : R) * ∑ γ ∈ Finset.univ.filter (fun γ => ConjClasses.mk γ = C), hs γ
        = ∑ τ : Γ, ∑ γ ∈ Finset.univ.filter (fun γ => ConjClasses.mk γ = C),
            hs (τ⁻¹ * γ * τ) := by
          rw [Finset.sum_congr rfl (fun τ _ => hre τ), Finset.sum_const, Finset.card_univ,
            nsmul_eq_mul]
      _ = ∑ γ ∈ Finset.univ.filter (fun γ => ConjClasses.mk γ = C),
            ((Finset.univ.filter (fun y => act γ (Φ y) = y)).card : R) := by
          rw [Finset.sum_comm]
          exact Finset.sum_congr rfl (fun γ _ => hH γ)
      _ = _ := by
          rw [← Nat.cast_sum, hcount C, Nat.cast_mul]
  have hL : ∑ g : Γ, red (hs g) * χ g = ∑ C : ConjClasses Γ,
      ((Finset.univ.filter (fun b => ConjClasses.mk (c (sec b)) = C)).card : Λ) * χ (rep C) := by
    rw [← Finset.sum_fiberwise Finset.univ ConjClasses.mk (fun g => red (hs g) * χ g)]
    refine Finset.sum_congr rfl (fun C _ => ?_)
    have h1 : ∀ g ∈ Finset.univ.filter (fun g => ConjClasses.mk g = C),
        red (hs g) * χ g = red (hs g) * χ (rep C) := by
      intro g hg
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hg
      rw [hχrep g, hg]
    rw [Finset.sum_congr rfl h1, ← Finset.sum_mul, ← map_sum, hS C, map_natCast]
  have hR : ∑ b : B, w b = ∑ C : ConjClasses Γ,
      ((Finset.univ.filter (fun b => ConjClasses.mk (c (sec b)) = C)).card : Λ) * χ (rep C) := by
    rw [← Finset.sum_fiberwise Finset.univ (fun b => ConjClasses.mk (c (sec b))) w]
    refine Finset.sum_congr rfl (fun C _ => ?_)
    have h1 : ∀ b ∈ Finset.univ.filter (fun b => ConjClasses.mk (c (sec b)) = C),
        w b = χ (rep C) := by
      intro b hb
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hb
      rw [hwb b, hb]
    rw [Finset.sum_congr rfl h1, Finset.sum_const, nsmul_eq_mul]
  rw [hL, hR]

theorem wc_aroots_pow_sum_trace (ℓ : ℕ) [Fact (Nat.Prime ℓ)] {r : ℕ}
    (B : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (k : ℕ) :
    ((B.charpoly.aroots (AlgebraicClosure ℚ_[ℓ])).map (· ^ k)).sum =
      algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) (B ^ k).trace :=
by
  classical
  have gen : ∀ {K : Type} [Field K] [IsAlgClosed K] (A : Matrix (Fin r) (Fin r) K) (n : ℕ),
      (A ^ n).trace = (A.charpoly.roots.map (· ^ n)).sum := by
    intro K _ _ A n
    set f : Module.End K (Fin r → K) := Matrix.toLin' A with hf
    have h1 : (A ^ n).trace = LinearMap.trace K (Fin r → K) (f ^ n) := by
      rw [← Matrix.trace_toLin'_eq, Matrix.toLin'_pow]
    have h2 : A.charpoly = LinearMap.charpoly f := (Matrix.charpoly_toLin' A).symm
    rw [h1, h2]
    set p := LinearMap.charpoly f with hp
    have s3 : ∀ μ : K, LinearMap.trace K (f.maxGenEigenspace μ)
        ((f ^ n).restrict (Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.self_pow f n) μ)) =
        (Module.finrank K (f.maxGenEigenspace μ) : K) * μ ^ n := by
      intro μ
      have hW : Set.MapsTo f (f.maxGenEigenspace μ) (f.maxGenEigenspace μ) :=
        Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.refl f) μ
      set a : Module.End K (f.maxGenEigenspace μ) := f.restrict hW with ha_def
      set c : Module.End K (f.maxGenEigenspace μ) := algebraMap K _ μ with hc_def
      have ha : (f ^ n).restrict
          (Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.self_pow f n) μ) = a ^ n :=
        (Module.End.pow_restrict n hW _).symm
      have hnil : IsNilpotent (a - c) := by
        have := Module.End.isNilpotent_restrict_maxGenEigenspace_sub_algebraMap f μ
        convert this using 1
        ext x
        simp [a, c, LinearMap.coe_restrict_apply, Algebra.algebraMap_eq_smul_one]
        rfl
      have hac : Commute a c := by
        show a * c = c * a
        exact (Algebra.commutes μ a).symm
      have key : ∀ {R : Type} [Ring R] (x y : R), Commute x y → IsNilpotent (x - y) →
          IsNilpotent (x ^ n - y ^ n) := by
        intro R _ x y hxy hn
        have hd : Commute (x - y) x := (Commute.refl x).sub_left hxy.symm
        have hd' : Commute (x - y) y := hxy.sub_left (Commute.refl y)
        have hcomm : Commute (x - y)
            (∑ i ∈ Finset.range n, x ^ i * y ^ (n - 1 - i)) :=
          Commute.sum_right _ _ _ (fun i _ => (hd.pow_right i).mul_right (hd'.pow_right _))
        rw [← hxy.geom_sum₂_mul n]
        exact Commute.isNilpotent_mul_left hcomm.symm hn
      have hnil2 : IsNilpotent (a ^ n - c ^ n) := key a c hac hnil
      have ht : LinearMap.trace K _ (a ^ n - c ^ n) = 0 :=
        (LinearMap.isNilpotent_trace_of_isNilpotent hnil2).eq_zero
      rw [ha]
      have h3 := (LinearMap.trace K (f.maxGenEigenspace μ)).map_sub (a ^ n) (c ^ n)
      have ht' : LinearMap.trace K _ (a ^ n) = LinearMap.trace K _ (c ^ n) :=
        sub_eq_zero.mp (h3.symm.trans ht)
      rw [ht', hc_def, ← map_pow, Algebra.algebraMap_eq_smul_one, map_smul, LinearMap.trace_one,
        smul_eq_mul, mul_comm]
    have hI : DirectSum.IsInternal (fun μ => f.maxGenEigenspace μ) :=
      DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
        (Module.End.independent_maxGenEigenspace f) (Module.End.iSup_maxGenEigenspace_eq_top f)
    have hb : ∀ μ, f.maxGenEigenspace μ ≠ ⊥ ↔ μ ∈ p.roots.toFinset := by
      intro μ
      rw [Multiset.mem_toFinset, ← Multiset.count_ne_zero, Polynomial.count_roots,
        hp, ← LinearMap.finrank_maxGenEigenspace_eq, ne_eq, ne_eq, Submodule.finrank_eq_zero]
    have hN : {μ | f.maxGenEigenspace μ ≠ ⊥}.Finite := by
      apply (p.roots.toFinset.finite_toSet).subset
      intro μ hμ
      exact (hb μ).1 hμ
    have hmaps := Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.self_pow f n)
    rw [LinearMap.trace_eq_sum_trace_restrict' hI hN hmaps]
    have hfs : hN.toFinset = p.roots.toFinset := by
      ext μ
      rw [Set.Finite.mem_toFinset, ← hb μ]
      rfl
    rw [hfs, Finset.sum_multiset_map_count]
    refine Finset.sum_congr rfl (fun μ _ => ?_)
    rw [s3, LinearMap.finrank_maxGenEigenspace_eq, ← hp, ← Polynomial.count_roots, nsmul_eq_mul]
  have hR : algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) (B ^ k).trace =
      ((B.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))) ^ k).trace := by
    rw [AddMonoidHom.map_trace, Matrix.map_pow]
  have hL : B.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) =
      (B.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).charpoly.roots := by
    rw [Polynomial.aroots_def, Matrix.charpoly_map]
  rw [hR, hL]
  exact (gen _ k).symm

theorem wc_galcover_points {W E : Scheme.{u}} (q : E ⟶ W) (Γ : Type u) [Group Γ]
    (α : Γ →* Aut E) (hG : wcGalCover q Γ α) :
    (∀ (L : Type u) [Field L] (y y' : Spec (.of L) ⟶ E), y ≫ q = y' ≫ q →
      ∃! γ : Γ, y' = y ≫ (α γ).hom) ∧
    ∀ (L : Type u) [Field L] [IsAlgClosed L] (x : Spec (.of L) ⟶ W), ∃ y, y ≫ q = x :=
by
  obtain ⟨_, hfin, _, hsurj, hα, hiso⟩ := hG
  set Φ := Limits.Sigma.desc (fun γ : Γ => Limits.pullback.lift (α γ).hom (𝟙 E)
      ((hα γ).trans (Category.id_comp q).symm)) with hΦ
  have hι : ∀ γ, Limits.Sigma.ι (fun _ : Γ => E) γ ≫ Φ = Limits.pullback.lift (α γ).hom (𝟙 E)
      ((hα γ).trans (Category.id_comp q).symm) := fun γ => Limits.Sigma.ι_comp_desc _ _
  refine ⟨?_, ?_⟩
  · intro L _ y y' h
    obtain ⟨pt⟩ : Nonempty (Spec (CommRingCat.of L)) := inferInstance
    have huniq : ∀ γ₁ γ₂ : Γ, y ≫ (α γ₁).hom = y ≫ (α γ₂).hom → γ₁ = γ₂ := by
      intro γ₁ γ₂ h12
      have h1 : (y ≫ Limits.Sigma.ι (fun _ : Γ => E) γ₁) ≫ Φ =
          (y ≫ Limits.Sigma.ι (fun _ : Γ => E) γ₂) ≫ Φ := by
        rw [Category.assoc, Category.assoc, hι, hι]
        apply Limits.pullback.hom_ext
        · simp only [Category.assoc, Limits.pullback.lift_fst]; exact h12
        · simp only [Category.assoc, Limits.pullback.lift_snd]
      have h2 := (cancel_mono Φ).mp h1
      have h3 : (Limits.Sigma.ι (fun _ : Γ => E) γ₁) (y pt) =
          (Limits.Sigma.ι (fun _ : Γ => E) γ₂) (y pt) := by
        have := congrArg (fun g => g pt) h2
        simpa only [Scheme.Hom.comp_apply] using this
      rw [sigmaι_eq_iff] at h3
      exact (Sigma.mk.inj_iff.mp h3).1
    obtain ⟨γ, hγ⟩ : ∃ γ, y' = y ≫ (α γ).hom := by
      let p := Limits.pullback.lift y' y h.symm
      let s := p ≫ inv Φ
      have hs : s ≫ Φ = p := by simp [s]
      obtain ⟨⟨γ, e⟩, he⟩ :=
        (sigmaMk (fun _ : Γ => E)).surjective (s pt)
      rw [sigmaMk_mk] at he
      have hrange : Set.range s.base ⊆
          Set.range (Limits.Sigma.ι (fun _ : Γ => E) γ).base := by
        rintro _ ⟨z, rfl⟩
        have hz : z = pt := Subsingleton.elim _ _
        exact ⟨e, by rw [hz]; exact he⟩
      let t := IsOpenImmersion.lift (Limits.Sigma.ι (fun _ : Γ => E) γ) s hrange
      have ht : t ≫ Limits.Sigma.ι (fun _ : Γ => E) γ = s := IsOpenImmersion.lift_fac _ _ _
      have hp : p = t ≫ Limits.pullback.lift (α γ).hom (𝟙 E)
          ((hα γ).trans (Category.id_comp q).symm) := by
        rw [← hs, ← ht, Category.assoc, hι]
      have h1 : y = t := by
        have e1 : p ≫ Limits.pullback.snd q q = y := Limits.pullback.lift_snd _ _ _
        rw [hp, Category.assoc, Limits.pullback.lift_snd, Category.comp_id] at e1
        exact e1.symm
      have h2 : y' = t ≫ (α γ).hom := by
        have e1 : p ≫ Limits.pullback.fst q q = y' := Limits.pullback.lift_fst _ _ _
        rw [hp, Category.assoc, Limits.pullback.lift_fst] at e1
        exact e1.symm
      exact ⟨γ, by rw [h2, h1]⟩
    exact ⟨γ, hγ, fun γ' hγ' => huniq γ' γ (hγ'.symm.trans hγ)⟩
  · intro L _ _ x
    let P := Limits.pullback q x
    let f : P ⟶ Spec (.of L) := Limits.pullback.snd q x
    haveI : IsFinite f := inferInstance
    haveI : Surjective f := inferInstance
    haveI : IsAffine P := isAffine_of_isAffineHom f
    obtain ⟨pt⟩ : Nonempty (Spec (CommRingCat.of L)) := inferInstance
    obtain ⟨p₀, -⟩ := f.surjective pt
    haveI : Nontrivial Γ(P, ⊤) := by
      have hne : Nonempty (⊤ : P.Opens) := ⟨⟨p₀, trivial⟩⟩
      exact Scheme.component_nontrivial P ⊤
    let ψ : L →+* Γ(P, ⊤) := f.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom
    have hψ : ψ.Finite := by
      apply RingHom.Finite.comp (IsFinite.finite_app f ⊤ (isAffineOpen_top _))
      apply RingHom.Finite.of_surjective
      intro a
      exact ⟨(Scheme.ΓSpecIso (CommRingCat.of L)).hom.hom a, by simp⟩
    obtain ⟨r, hr⟩ : ∃ r : Γ(P, ⊤) →+* L, r.comp ψ = RingHom.id L := by
      obtain ⟨M, hM⟩ := Ideal.exists_maximal Γ(P, ⊤)
      letI := Ideal.Quotient.field M
      let π := Ideal.Quotient.mk M
      have hπ : Function.Surjective π := Ideal.Quotient.mk_surjective
      let g : L →+* (Γ(P, ⊤) ⧸ M) := π.comp ψ
      have hg : g.Finite := RingHom.Finite.comp (RingHom.Finite.of_surjective π hπ) hψ
      letI := g.toAlgebra
      haveI : Module.Finite L (Γ(P, ⊤) ⧸ M) := hg
      haveI : Algebra.IsIntegral L (Γ(P, ⊤) ⧸ M) := Algebra.IsIntegral.of_finite _ _
      have hbij : Function.Bijective (algebraMap L (Γ(P, ⊤) ⧸ M)) :=
        IsAlgClosed.algebraMap_bijective_of_isIntegral
      let e := RingEquiv.ofBijective (algebraMap L (Γ(P, ⊤) ⧸ M)) hbij
      refine ⟨(e.symm : (Γ(P, ⊤) ⧸ M) →+* L).comp π, ?_⟩
      ext l
      show e.symm (e l) = l
      exact e.symm_apply_apply l
    let r' : Γ(P, ⊤) ⟶ CommRingCat.of L := CommRingCat.ofHom r
    have hr' : (Scheme.ΓSpecIso (CommRingCat.of L)).inv ≫ f.appTop ≫ r' = 𝟙 _ := by
      ext l
      exact congrArg (fun φ => φ l) hr
    let z : Spec (.of L) ⟶ P := Spec.map r' ≫ P.isoSpec.inv
    have hz : z ≫ f = 𝟙 _ := by
      simp only [z, Category.assoc]
      rw [← Scheme.isoSpec_inv_naturality f, Scheme.isoSpec_Spec_inv, ← Category.assoc,
        ← Spec.map_comp, ← Spec.map_comp, hr', Spec.map_id]
    refine ⟨z ≫ Limits.pullback.fst q x, ?_⟩
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hz, Category.id_comp]

theorem wc_trace_add_saturated {R M : Type*} [CommRing R] [IsDomain R] [IsPrincipalIdealRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M] [Module.IsTorsionFree R M]
    (S : Submodule R M) (hS : ∀ (r : R) (x : M), r ≠ 0 → r • x ∈ S → x ∈ S)
    (φ : M →ₗ[R] M) (hφ : S ≤ S.comap φ) :
    LinearMap.trace R M φ = LinearMap.trace R S (φ.restrict (fun x hx => hφ hx)) +
      LinearMap.trace R (M ⧸ S) (S.mapQ S φ hφ) :=
by
  classical
  haveI hQtf : Module.IsTorsionFree R (M ⧸ S) := by
    refine Module.IsTorsionFree.of_smul_eq_zero ?_
    intro r q hrq
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective S q
    by_cases hr : r = 0
    · exact Or.inl hr
    · right
      rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hrq
      exact (Submodule.Quotient.mk_eq_zero S).mpr (hS r x hr hrq)
  haveI : Module.Free R (M ⧸ S) := Module.free_of_finite_type_torsion_free'
  obtain ⟨σ, hσ⟩ := Module.projective_lifting_property S.mkQ (LinearMap.id)
    (Submodule.mkQ_surjective S)
  have hσ' : ∀ q, (Submodule.Quotient.mk (σ q) : M ⧸ S) = q := fun q => LinearMap.congr_fun hσ q
  have hmem : ∀ x : M, x - σ (Submodule.Quotient.mk x) ∈ S := by
    intro x
    rw [← Submodule.Quotient.mk_eq_zero, Submodule.Quotient.mk_sub, hσ', sub_self]
  let π : M →ₗ[R] S := LinearMap.codRestrict S (LinearMap.id - σ ∘ₗ S.mkQ) (fun x => hmem x)
  have hmkS : ∀ s : S, (Submodule.Quotient.mk (s : M) : M ⧸ S) = 0 := fun s =>
    (Submodule.Quotient.mk_eq_zero S).mpr s.2
  let e : M ≃ₗ[R] (S × (M ⧸ S)) := LinearEquiv.ofLinear (π.prod S.mkQ) (S.subtype.coprod σ)
    (LinearMap.ext fun p => by
      obtain ⟨s, q⟩ := p
      have h1 : (Submodule.Quotient.mk ((s : M) + σ q) : M ⧸ S) = q := by
        rw [Submodule.Quotient.mk_add, hmkS, hσ', zero_add]
      refine Prod.ext (Subtype.ext ?_) ?_
      · show ((s : M) + σ q) - σ (Submodule.Quotient.mk ((s : M) + σ q)) = s
        rw [h1, add_sub_cancel_right]
      · show (Submodule.Quotient.mk ((s : M) + σ q) : M ⧸ S) = q
        exact h1)
    (LinearMap.ext fun x => by
      show (x - σ (Submodule.Quotient.mk x)) + σ (Submodule.Quotient.mk x) = x
      exact sub_add_cancel _ _)
  let h : (M ⧸ S) →ₗ[R] S := π ∘ₗ φ ∘ₗ σ
  have hblock : e.conj φ = (φ.restrict (p := S) (q := S) (fun x hx => hφ hx)).prodMap
      (S.mapQ S φ hφ) + (LinearMap.inl R S (M ⧸ S) ∘ₗ h) ∘ₗ LinearMap.snd R S (M ⧸ S) := by
    apply LinearMap.ext
    rintro ⟨s, q⟩
    have hφs : φ s ∈ S := hφ s.2
    have hφs0 : (Submodule.Quotient.mk (φ s) : M ⧸ S) = 0 :=
      (Submodule.Quotient.mk_eq_zero S).mpr hφs
    have hQ : S.mapQ S φ hφ (Submodule.Quotient.mk (σ q)) =
        (Submodule.Quotient.mk (φ (σ q)) : M ⧸ S) := rfl
    rw [hσ'] at hQ
    refine Prod.ext (Subtype.ext ?_) ?_
    · show φ ((s : M) + σ q) - σ (Submodule.Quotient.mk (φ ((s : M) + σ q))) =
        φ s + (φ (σ q) - σ (Submodule.Quotient.mk (φ (σ q))))
      rw [map_add, Submodule.Quotient.mk_add, hφs0, zero_add]
      abel
    · show (Submodule.Quotient.mk (φ ((s : M) + σ q)) : M ⧸ S) = S.mapQ S φ hφ q + 0
      rw [map_add, Submodule.Quotient.mk_add, hφs0, zero_add, add_zero, hQ]
  rw [← LinearMap.trace_conj' φ e, hblock, map_add, LinearMap.trace_prodMap',
    LinearMap.trace_comp_comm', ← LinearMap.comp_assoc, LinearMap.snd_comp_inl,
    LinearMap.zero_comp, map_zero, add_zero]

theorem wc_trace_restrict_eq_of_smul_mem {R M : Type*} [CommRing R] [IsDomain R]
    [IsPrincipalIdealRing R] [AddCommGroup M] [Module R M] [Module.Finite R M]
    [Module.IsTorsionFree R M] (P Q : Submodule R M) (hPQ : P ≤ Q) (φ : M →ₗ[R] M)
    (hP : P ≤ P.comap φ) (hQ : Q ≤ Q.comap φ) (h : ∀ x ∈ Q, ∃ c : R, c ≠ 0 ∧ c • x ∈ P) :
    LinearMap.trace R P (φ.restrict (fun x hx => hP hx)) =
      LinearMap.trace R Q (φ.restrict (fun x hx => hQ hx)) :=
by
  classical

  have key : ∀ T : Finset M, (↑T : Set M) ⊆ Q →
      ∃ c : R, c ≠ 0 ∧ ∀ x ∈ Submodule.span R (↑T : Set M), c • x ∈ P := by
    intro T
    induction T using Finset.induction_on with
    | empty =>
      intro _
      refine ⟨1, one_ne_zero, fun x hx => ?_⟩
      rw [Finset.coe_empty, Submodule.span_empty, Submodule.mem_bot] at hx
      rw [hx, smul_zero]
      exact P.zero_mem
    | insert y T' hyT ih =>
      intro hT
      rw [Finset.coe_insert, Set.insert_subset_iff] at hT
      obtain ⟨cy, hcy0, hcy⟩ := h y hT.1
      obtain ⟨c', hc'0, hc'⟩ := ih hT.2
      refine ⟨cy * c', mul_ne_zero hcy0 hc'0, fun x hx => ?_⟩
      rw [Finset.coe_insert, Submodule.mem_span_insert] at hx
      obtain ⟨a, z, hz, rfl⟩ := hx
      have e : (cy * c') • (a • y + z) = (a * c') • (cy • y) + cy • (c' • z) := by
        rw [smul_add, smul_smul, smul_smul, smul_smul]
        congr 1
        congr 1
        ring
      rw [e]
      exact P.add_mem (P.smul_mem _ hcy) (P.smul_mem _ (hc' z hz))
  have hQfg : Q.FG := IsNoetherian.noetherian Q
  obtain ⟨S, hS⟩ := hQfg
  obtain ⟨c, hc0, hc'⟩ := key S (by rw [← hS]; exact Submodule.subset_span)
  have hc : ∀ x ∈ Q, c • x ∈ P := fun x hx => hc' x (by rw [hS]; exact hx)

  let α : Q →ₗ[R] P := LinearMap.codRestrict P (c • Q.subtype) (fun x => by
    simpa using hc x x.2)
  let β : P →ₗ[R] Q := LinearMap.codRestrict Q (φ ∘ₗ P.subtype) (fun y => hQ (hPQ y.2))
  have h1 : β ∘ₗ α = c • (φ.restrict (fun x hx => hQ hx) : Q →ₗ[R] Q) := by
    ext x
    simp [α, β, LinearMap.restrict_apply]
  have h2 : α ∘ₗ β = c • (φ.restrict (fun x hx => hP hx) : P →ₗ[R] P) := by
    ext x
    simp [α, β, LinearMap.restrict_apply]
  have h3 := LinearMap.trace_comp_comm' α β
  rw [h1, h2, map_smul, map_smul, smul_eq_mul, smul_eq_mul] at h3
  exact (mul_left_cancel₀ hc0 h3).symm

theorem wc_ratcoord_of_saturated_quotient (ℓ : ℕ) [Fact (Nat.Prime ℓ)] {H Z : Type*}
    [AddCommGroup H] [AddCommGroup Z] [Module ℤ_[ℓ] Z] [Module.Finite ℤ_[ℓ] Z]
    (B S : Submodule ℤ_[ℓ] Z) (hS : ∀ z, z ∈ S ↔ ∃ n : ℕ, ((ℓ : ℤ_[ℓ]) ^ n) • z ∈ B)
    (π : Z →+ H) (hπ : Function.Surjective π) (hker : ∀ z, π z = 0 ↔ z ∈ B)
    (τ : Z →ₗ[ℤ_[ℓ]] Z) (hτS : S ≤ S.comap τ) (τH : H →+ H)
    (hτ : ∀ z, τH (π z) = π (τ z)) :
    ∃ (r : ℕ) (ι : H →+ (Fin r → ℚ_[ℓ])) (A : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      wcRatCoord ℓ ι ∧ (∀ x, ι (τH x) = A.mulVec (ι x)) ∧
      A.trace = ((LinearMap.trace ℤ_[ℓ] (Z ⧸ S) (S.mapQ S τ hτS) : ℤ_[ℓ]) : ℚ_[ℓ]) :=
by
  classical
  have hℓ1 : (1 : ℝ) < ℓ := Nat.one_lt_cast.mpr (Fact.out : ℓ.Prime).one_lt
  have hℓpos : (0 : ℝ) < ℓ := by linarith

  have htf : Module.IsTorsionFree ℤ_[ℓ] (Z ⧸ S) := by
    rw [Module.isTorsionFree_iff_smul_eq_zero]
    intro a q hq
    obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective S q
    by_cases ha : a = 0
    · exact Or.inl ha
    right
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hq
    obtain ⟨n, hn⟩ := (hS _).mp hq
    have hspec := PadicInt.unitCoeff_spec ha
    have hu := Units.inv_mul (PadicInt.unitCoeff ha)
    rw [Submodule.Quotient.mk_eq_zero, hS]
    refine ⟨n + a.valuation, ?_⟩
    have heq : ((ℓ : ℤ_[ℓ]) ^ (n + a.valuation)) • z =
        (((PadicInt.unitCoeff ha)⁻¹ : ℤ_[ℓ]ˣ) : ℤ_[ℓ]) • (((ℓ : ℤ_[ℓ]) ^ n) • a • z) := by
      rw [smul_smul, smul_smul]
      congr 1
      linear_combination (-((((PadicInt.unitCoeff ha)⁻¹ : ℤ_[ℓ]ˣ) : ℤ_[ℓ]) *
        (ℓ : ℤ_[ℓ]) ^ n)) * hspec - ((ℓ : ℤ_[ℓ]) ^ n * (ℓ : ℤ_[ℓ]) ^ a.valuation) * hu
    rw [heq]
    exact B.smul_mem _ hn
  have := htf
  have : Module.Free ℤ_[ℓ] (Z ⧸ S) := Module.free_of_finite_type_torsion_free'
  let b := Module.finBasis ℤ_[ℓ] (Z ⧸ S)

  let ι₀ : Z →+ (Fin (Module.finrank ℤ_[ℓ] (Z ⧸ S)) → ℚ_[ℓ]) :=
    AddMonoidHom.mk' (fun z j => ((b.repr (S.mkQ z) j : ℤ_[ℓ]) : ℚ_[ℓ])) (fun x y => by
      funext j
      simp only [map_add, Finsupp.add_apply, PadicInt.coe_add, Pi.add_apply])
  have hι₀ : ∀ z j, ι₀ z j = ((b.repr (S.mkQ z) j : ℤ_[ℓ]) : ℚ_[ℓ]) := fun z j => rfl
  have hBS : ∀ z, z ∈ B → z ∈ S := fun z hz =>
    (hS z).mpr ⟨0, by rw [pow_zero, one_smul]; exact hz⟩
  have hstar : ∀ z, ι₀ z = 0 ↔ z ∈ S := by
    intro z
    constructor
    · intro h
      have h1 : b.repr (S.mkQ z) = 0 := by
        ext j
        have h2 := congrFun h j
        rw [hι₀, Pi.zero_apply, PadicInt.coe_eq_zero] at h2
        rw [h2, Finsupp.zero_apply]
      rw [LinearEquiv.map_eq_zero_iff] at h1
      exact (Submodule.Quotient.mk_eq_zero S).mp h1
    · intro h
      have hzS : S.mkQ z = 0 := (Submodule.Quotient.mk_eq_zero S).mpr h
      funext j
      rw [hι₀, hzS, map_zero, Finsupp.zero_apply, Pi.zero_apply, PadicInt.coe_zero]
  have hle : π.ker ≤ ι₀.ker := by
    intro z hz
    rw [AddMonoidHom.mem_ker] at hz ⊢
    exact (hstar z).mpr (hBS z ((hker z).mp hz))
  let ι : H →+ (Fin (Module.finrank ℤ_[ℓ] (Z ⧸ S)) → ℚ_[ℓ]) :=
    π.liftOfRightInverse (Function.surjInv hπ) (Function.rightInverse_surjInv hπ) ⟨ι₀, hle⟩
  have hιπ : ∀ z, ι (π z) = ι₀ z := fun z =>
    AddMonoidHom.liftOfRightInverse_comp_apply π _ _ ⟨ι₀, hle⟩ z

  set f := S.mapQ S τ hτS with hf
  let A := (LinearMap.toMatrix b b f).map (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ]))
  have hmv : ∀ q, (fun j => ((b.repr (f q) j : ℤ_[ℓ]) : ℚ_[ℓ])) =
      A.mulVec (fun j => ((b.repr q j : ℤ_[ℓ]) : ℚ_[ℓ])) := by
    intro q
    funext j
    rw [← LinearMap.toMatrix_mulVec_repr b b f q]
    exact RingHom.map_mulVec PadicInt.Coe.ringHom (LinearMap.toMatrix b b f) (b.repr q) j
  have htr : A.trace = ((LinearMap.trace ℤ_[ℓ] (Z ⧸ S) f : ℤ_[ℓ]) : ℚ_[ℓ]) := by
    rw [LinearMap.trace_eq_matrix_trace ℤ_[ℓ] b f]
    exact (AddMonoidHom.map_trace PadicInt.Coe.ringHom (LinearMap.toMatrix b b f)).symm
  refine ⟨Module.finrank ℤ_[ℓ] (Z ⧸ S), ι, A, ?_, ?_, htr⟩
  · unfold wcRatCoord
    refine ⟨?_, ?_, ?_, ?_⟩
    ·
      intro x
      obtain ⟨z, rfl⟩ := hπ x
      rw [hιπ, hstar, hS]
      constructor
      · rintro ⟨n, hn⟩
        refine ⟨n, ?_⟩
        rw [← map_nsmul, ← Nat.cast_smul_eq_nsmul ℤ_[ℓ], Nat.cast_pow, hker]
        exact hn
      · rintro ⟨n, hn⟩
        refine ⟨n, ?_⟩
        rw [← map_nsmul, ← Nat.cast_smul_eq_nsmul ℤ_[ℓ], Nat.cast_pow, hker] at hn
        exact hn
    ·
      intro v
      have hn : ∀ j, ∃ n : ℕ, ‖v j‖ < (ℓ : ℝ) ^ n := fun j => pow_unbounded_of_one_lt _ hℓ1
      choose n hn using hn
      have hK : ∀ j, ‖(ℓ : ℚ_[ℓ]) ^ (∑ i, n i) * v j‖ ≤ 1 := by
        intro j
        rw [norm_mul, norm_pow, Padic.norm_p, inv_pow]
        have h1 : (ℓ : ℝ) ^ (n j) ≤ (ℓ : ℝ) ^ (∑ i, n i) :=
          pow_le_pow_right₀ hℓ1.le
            (Finset.single_le_sum (fun i _ => Nat.zero_le (n i)) (Finset.mem_univ j))
        have h2 : (0 : ℝ) < (ℓ : ℝ) ^ (∑ i, n i) := pow_pos hℓpos _
        rw [inv_mul_le_iff₀ h2]
        linarith [hn j]
      let w : Fin (Module.finrank ℤ_[ℓ] (Z ⧸ S)) → ℤ_[ℓ] :=
        fun j => ⟨(ℓ : ℚ_[ℓ]) ^ (∑ i, n i) * v j, hK j⟩
      obtain ⟨z, hz⟩ := Submodule.mkQ_surjective S (b.equivFun.symm w)
      refine ⟨∑ i, n i, π z, ?_⟩
      funext j
      have hw : b.repr (b.equivFun.symm w) j = w j := by
        rw [← Module.Basis.equivFun_apply, LinearEquiv.apply_symm_apply]
      rw [hιπ, hι₀, hz, hw, Pi.smul_apply, smul_eq_mul]
    ·
      intro x a
      obtain ⟨z, rfl⟩ := hπ x
      refine ⟨π (a • z), ?_⟩
      funext j
      rw [hιπ, hιπ, Pi.smul_apply, hι₀, hι₀, map_smul, map_smul, Finsupp.smul_apply,
        smul_eq_mul, smul_eq_mul, PadicInt.coe_mul]
    ·
      intro x hx
      obtain ⟨z, rfl⟩ := hπ x
      funext j
      rw [Pi.zero_apply]
      by_contra hne
      have hpos : 0 < ‖ι (π z) j‖ := norm_pos_iff.mpr hne
      have hlt : (ℓ : ℝ)⁻¹ < 1 := (inv_lt_one₀ hℓpos).mpr hℓ1
      obtain ⟨k, hk⟩ := exists_pow_lt_of_lt_one hpos hlt
      obtain ⟨y, hy⟩ := hx k
      obtain ⟨z', rfl⟩ := hπ y
      have h1 : ι (π z) j = (ℓ : ℚ_[ℓ]) ^ k * ((b.repr (S.mkQ z') j : ℤ_[ℓ]) : ℚ_[ℓ]) := by
        rw [hy, Pi.smul_apply, smul_eq_mul, hιπ z', hι₀]
      have h2 : ‖ι (π z) j‖ ≤ (ℓ : ℝ)⁻¹ ^ k := by
        rw [h1, norm_mul, norm_pow, Padic.norm_p, ← PadicInt.norm_def]
        exact mul_le_of_le_one_right (by positivity) (PadicInt.norm_le_one _)
      linarith
  ·
    intro x
    obtain ⟨z, rfl⟩ := hπ x
    rw [hτ, hιπ, hιπ]
    funext j
    have hm : S.mkQ (τ z) = f (S.mkQ z) := by
      rw [hf, Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.mapQ_apply]
    rw [hι₀, hm]
    exact congrFun (hmv (S.mkQ z)) j

theorem wc_gmodel_chain_trace_formula (ℓ : ℕ) [Fact (Nat.Prime ℓ)] {Γ : Type*} [Group Γ]
    [Fintype Γ] {n : ℕ} (ε F : Matrix (Fin n) (Fin n) (MonoidAlgebra ℤ_[ℓ] Γ)) (hF : F * ε = F)
    (c : MonoidAlgebra ℤ_[ℓ] Γ) (N : Submodule ℤ_[ℓ] (Fin n → MonoidAlgebra ℤ_[ℓ] Γ))
    (hN : ∀ v, v ∈ N ↔ Matrix.vecMul v ε = v)
    (T : (Fin n → MonoidAlgebra ℤ_[ℓ] Γ) →ₗ[ℤ_[ℓ]] (Fin n → MonoidAlgebra ℤ_[ℓ] Γ))
    (hT : ∀ v, T v = c • Matrix.vecMul v F) (hTN : ∀ v ∈ N, T v ∈ N) :
    LinearMap.trace ℤ_[ℓ] N (T.restrict hTN) =
      ∑ j : Fin n, ∑ τ : Γ, (c * MonoidAlgebra.single τ 1 * F j j).coeff τ :=
by
  classical
  have hall : ∀ v, T v ∈ N := by
    intro v
    rw [hN, hT, Matrix.smul_vecMul, Matrix.vecMul_vecMul, hF]
  rw [LinearMap.trace_restrict_eq_of_forall_mem N T hall hTN]
  set b := Pi.basis (fun _ : Fin n => MonoidAlgebra.basis Γ ℤ_[ℓ]) with hb
  rw [LinearMap.trace_eq_matrix_trace ℤ_[ℓ] b T, Matrix.trace, Fintype.sum_sigma]
  refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun τ _ => ?_
  rw [Matrix.diag_apply, LinearMap.toMatrix_apply, hb, Pi.basis_apply, Pi.basis_repr,
    MonoidAlgebra.basis_apply, hT, Matrix.single_vecMul, mul_assoc]
  rfl

theorem wc_ab_cochain_homology_elementwise (C : CochainComplex AddCommGrpCat.{u+1} ℕ) (i : ℕ) :
    ∃ p : ↥(C.d i (i + 1)).hom.ker →+ C.homology i,
      Function.Surjective p ∧
      (∀ z, p z = 0 ↔ (z.1 = 0 ∨ ∃ j, j + 1 = i ∧ ∃ y : C.X j, (C.d j i).hom y = z.1)) ∧
      ∀ (φ : C ⟶ C) (z z' : ↥(C.d i (i + 1)).hom.ker), z'.1 = (φ.f i).hom z.1 →
        (HomologicalComplex.homologyMap φ i).hom (p z) = p z' :=
by
  classical
  have hmono : Function.Injective (C.iCycles i).hom :=
    (AddCommGrpCat.mono_iff_injective (C.iCycles i)).mp inferInstance
  have hepi : Function.Surjective (C.homologyπ i).hom :=
    (AddCommGrpCat.epi_iff_surjective (C.homologyπ i)).mp inferInstance
  let ι : AddCommGrpCat.of ↥(C.d i (i + 1)).hom.ker ⟶ C.X i :=
    AddCommGrpCat.ofHom (C.d i (i + 1)).hom.ker.subtype
  have hι : ι ≫ C.d i (i + 1) = 0 := by
    ext x
    exact x.2
  let κ : ↥(C.d i (i + 1)).hom.ker →+ C.cycles i :=
    (C.liftCycles ι (i + 1) (CochainComplex.next ℕ i) hι).hom
  have hκ : ∀ z, (C.iCycles i).hom (κ z) = z.1 := by
    intro z
    exact congrArg (fun f => f.hom z) (C.liftCycles_i ι (i + 1) (CochainComplex.next ℕ i) hι)
  have hκs : Function.Surjective κ := by
    intro c
    have hc : (C.iCycles i).hom c ∈ (C.d i (i + 1)).hom.ker := by
      have h := congrArg (fun f => f.hom c) (C.iCycles_d i (i + 1))
      exact h
    exact ⟨⟨_, hc⟩, hmono (by rw [hκ])⟩
  have hπ : ∀ (k : ℕ) (hk : (ComplexShape.up ℕ).prev i = k) (c : C.cycles i),
      (C.homologyπ i).hom c = 0 ↔ ∃ y : C.X k, (C.d k i).hom y = (C.iCycles i).hom c := by
    intro k hk c
    have hS := ShortComplex.exact_of_g_is_cokernel
      (ShortComplex.mk (C.toCycles k i) (C.homologyπ i) (C.toCycles_comp_homologyπ k i))
      (C.homologyIsCokernel k i hk)
    rw [ShortComplex.ab_exact_iff] at hS
    have hti : ∀ y, (C.iCycles i).hom ((C.toCycles k i).hom y) = (C.d k i).hom y := fun y =>
      congrArg (fun f => f.hom y) (C.toCycles_i k i)
    constructor
    · intro h
      obtain ⟨y, hy⟩ := hS c h
      have hy' : (C.toCycles k i).hom y = c := hy
      exact ⟨y, by rw [← hti, hy']⟩
    · rintro ⟨y, hy⟩
      have h1 : (C.toCycles k i).hom y = c := hmono (by rw [hti, hy])
      rw [← h1]
      exact congrArg (fun f => f.hom y) (C.toCycles_comp_homologyπ k i)
  refine ⟨(C.homologyπ i).hom.comp κ, hepi.comp hκs, ?_, ?_⟩
  · intro z
    show (C.homologyπ i).hom (κ z) = 0 ↔ _
    rcases Nat.eq_zero_or_eq_succ_pred i with hi | hi
    · have hk : (ComplexShape.up ℕ).prev i = 0 := by
        rw [hi]; exact CochainComplex.prev_nat_zero
      have hd : C.d 0 i = 0 := C.shape 0 i (by simp; omega)
      rw [hπ 0 hk, hκ z]
      constructor
      · rintro ⟨y, hy⟩
        left
        rw [← hy, hd]
        rfl
      · rintro (h | ⟨j, hj, _⟩)
        · exact ⟨0, by rw [h, map_zero]⟩
        · omega
    · set j := i.pred with hj
      have hk : (ComplexShape.up ℕ).prev i = j := by
        rw [hi]; exact CochainComplex.prev_nat_succ j
      rw [hπ j hk, hκ z]
      constructor
      · rintro ⟨y, hy⟩
        exact Or.inr ⟨j, hi.symm, y, hy⟩
      · rintro (h | ⟨j', hj', y, hy⟩)
        · exact ⟨0, by rw [h, map_zero]⟩
        · obtain rfl : j' = j := by omega
          exact ⟨y, hy⟩
  · intro φ z z' hz
    have hc : (HomologicalComplex.cyclesMap φ i).hom (κ z) = κ z' := by
      apply hmono
      rw [hκ z']
      have h1 : (C.iCycles i).hom ((HomologicalComplex.cyclesMap φ i).hom (κ z)) =
          (φ.f i).hom ((C.iCycles i).hom (κ z)) :=
        congrArg (fun f => f.hom (κ z)) (HomologicalComplex.cyclesMap_i φ i)
      rw [h1, hκ z, hz]
    show (HomologicalComplex.homologyMap φ i).hom ((C.homologyπ i).hom (κ z)) =
      (C.homologyπ i).hom (κ z')
    rw [← hc]
    exact congrArg (fun f => f.hom (κ z)) (HomologicalComplex.homologyπ_naturality φ i)

theorem wc_gmodel_hopf_coords (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Γ : Type u) [Group Γ] [Fintype Γ]
    (P : wcGModel ℓ Γ) (e : ℕ) (he : 1 ≤ e) (γ : Γ) :
    ∃ (r : ℕ → ℕ) (ι : ∀ i, (wcGModelAb P).homology i →+ (Fin (r i) → ℚ_[ℓ]))
      (A : ∀ i, Matrix (Fin (r i)) (Fin (r i)) ℚ_[ℓ]),
      (∀ i < 3, wcRatCoord ℓ (ι i)) ∧
      (∀ i < 3, ∀ x, ι i ((HomologicalComplex.homologyMap
          (wcGModelAct P γ ≫ wcCxIter (wcGModelFrob P) e) i).hom x) = (A i).mulVec (ι i x)) ∧
      ((wcGModelTr P e γ : ℤ_[ℓ]) : ℚ_[ℓ]) =
        ∑ i ∈ Finset.range 3, (-1 : ℚ_[ℓ]) ^ i * (A i).trace :=
by
  classical
  have hℓ0 : ((ℓ : ℤ_[ℓ])) ≠ 0 := Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero
  have conjSub : ∀ {M : Type u} [AddCommGroup M] [Module ℤ_[ℓ] M] (Z B : Submodule ℤ_[ℓ] M)
      (hBZ : B ≤ Z) (φ : M →ₗ[ℤ_[ℓ]] M) (hZ : ∀ x ∈ Z, φ x ∈ Z) (hB : ∀ x ∈ B, φ x ∈ B)
      (h' : ∀ x ∈ B.comap Z.subtype, (φ.restrict hZ) x ∈ B.comap Z.subtype),
      LinearMap.trace ℤ_[ℓ] (B.comap Z.subtype) ((φ.restrict hZ).restrict h') =
        LinearMap.trace ℤ_[ℓ] B (φ.restrict hB) := by
    intro M _ _ Z B hBZ φ hZ hB h'
    rw [← LinearMap.trace_conj' ((φ.restrict hZ).restrict h') (Submodule.comapSubtypeEquivOfLe hBZ)]
    congr 1
  let Ns : ∀ i, Submodule ℤ_[ℓ] (Fin (P.k i) → MonoidAlgebra ℤ_[ℓ] Γ) := fun i =>
    { carrier := {v | Matrix.vecMul v (P.ε i) = v}
      add_mem' := fun {v w} hv hw => by
        simp only [Set.mem_setOf_eq] at hv hw ⊢
        rw [Matrix.add_vecMul, hv, hw]
      zero_mem' := by
        simp only [Set.mem_setOf_eq]
        exact Matrix.zero_vecMul _
      smul_mem' := fun c v hv => by
        simp only [Set.mem_setOf_eq] at hv ⊢
        rw [Matrix.smul_vecMul, hv] }
  have hNs : ∀ i v, v ∈ Ns i ↔ Matrix.vecMul v (P.ε i) = v := fun i v => Iff.rfl
  let g : MonoidAlgebra ℤ_[ℓ] Γ := MonoidAlgebra.single γ⁻¹ (1 : ℤ_[ℓ])
  let DW : ∀ i, (Fin (P.k i) → MonoidAlgebra ℤ_[ℓ] Γ) →ₗ[ℤ_[ℓ]]
      (Fin (P.k (i + 1)) → MonoidAlgebra ℤ_[ℓ] Γ) := fun i =>
    { toFun := fun v => Matrix.vecMul v (P.δ i)
      map_add' := fun v w => Matrix.add_vecMul _ v w
      map_smul' := fun c v => Matrix.smul_vecMul c v _ }
  let TW : ∀ i, (Fin (P.k i) → MonoidAlgebra ℤ_[ℓ] Γ) →ₗ[ℤ_[ℓ]]
      (Fin (P.k i) → MonoidAlgebra ℤ_[ℓ] Γ) := fun i =>
    { toFun := fun v => g • Matrix.vecMul v (P.f i ^ e)
      map_add' := fun v w => by simp only [Matrix.add_vecMul, smul_add]
      map_smul' := fun c v => by
        simp only [Matrix.smul_vecMul, RingHom.id_apply]
        exact (smul_comm c g _).symm }
  have hFε : ∀ i, P.f i ^ e * P.ε i = P.f i ^ e := by
    intro i
    have h1 : e = e - 1 + 1 := by omega
    rw [h1, pow_succ, mul_assoc, P.hfε]
  have hNT : ∀ i v, TW i v ∈ Ns i := by
    intro i v
    show Matrix.vecMul (g • Matrix.vecMul v (P.f i ^ e)) (P.ε i) = g • Matrix.vecMul v (P.f i ^ e)
    rw [Matrix.smul_vecMul, Matrix.vecMul_vecMul, hFε]
  have hND : ∀ i v, v ∈ Ns i → DW i v ∈ Ns (i + 1) := by
    intro i v _
    show Matrix.vecMul (Matrix.vecMul v (P.δ i)) (P.ε (i + 1)) = Matrix.vecMul v (P.δ i)
    rw [Matrix.vecMul_vecMul, P.hδε]
  let T : ∀ i, Ns i →ₗ[ℤ_[ℓ]] Ns i := fun i => (TW i).restrict (fun v _ => hNT i v)
  let D : ∀ i, Ns i →ₗ[ℤ_[ℓ]] Ns (i + 1) := fun i => (DW i).restrict (fun v hv => hND i v hv)
  have hpowδ : ∀ i n, P.f i ^ n * P.δ i = P.δ i * P.f (i + 1) ^ n := by
    intro i n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ, pow_succ, Matrix.mul_assoc, ← P.hδf, ← Matrix.mul_assoc, ih, Matrix.mul_assoc]
  have hcomm : ∀ i (x : Ns i), D i (T i x) = T (i + 1) (D i x) := by
    intro i x
    apply Subtype.ext
    show Matrix.vecMul (g • Matrix.vecMul x.1 (P.f i ^ e)) (P.δ i) =
      g • Matrix.vecMul (Matrix.vecMul x.1 (P.δ i)) (P.f (i + 1) ^ e)
    rw [Matrix.smul_vecMul, Matrix.vecMul_vecMul, Matrix.vecMul_vecMul, hpowδ]
  have hZT : ∀ i, LinearMap.ker (D i) ≤ (LinearMap.ker (D i)).comap (T i) := by
    intro i x hx
    rw [Submodule.mem_comap, LinearMap.mem_ker, hcomm, LinearMap.mem_ker.mp hx, map_zero]
  have hZT' : ∀ i, ∀ x ∈ LinearMap.ker (D i), T i x ∈ LinearMap.ker (D i) :=
    fun i x hx => hZT i hx
  have hR : ∀ i, ∀ x ∈ LinearMap.range (D i), T (i + 1) x ∈ LinearMap.range (D i) := by
    intro i x hx
    obtain ⟨y, rfl⟩ := LinearMap.mem_range.mp hx
    exact LinearMap.mem_range.mpr ⟨T i y, hcomm i y⟩
  let rt : ℕ → ℤ_[ℓ] := fun i =>
    LinearMap.trace ℤ_[ℓ] (LinearMap.range (D i)) ((T (i + 1)).restrict (hR i))
  have core : ∀ i (B : Submodule ℤ_[ℓ] (Ns i)) (hBT : ∀ x ∈ B, T i x ∈ B)
      (hBZ : B ≤ LinearMap.ker (D i)) (H : Type (u+1)) [AddCommGroup H]
      (π : LinearMap.ker (D i) →+ H) (hπ : Function.Surjective π)
      (hker : ∀ z, π z = 0 ↔ (z : Ns i) ∈ B) (τH : H →+ H)
      (hτ : ∀ z, τH (π z) = π ((T i).restrict (hZT' i) z)),
      ∃ (r : ℕ) (ι : H →+ (Fin r → ℚ_[ℓ])) (A : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
        wcRatCoord ℓ ι ∧ (∀ x, ι (τH x) = A.mulVec (ι x)) ∧
        A.trace = ((LinearMap.trace ℤ_[ℓ] (Ns i) (T i) -
          LinearMap.trace ℤ_[ℓ] B ((T i).restrict hBT) - rt i : ℤ_[ℓ]) : ℚ_[ℓ]) := by
    intro i B hBT hBZ H _ π hπ hker τH hτ
    let τ : LinearMap.ker (D i) →ₗ[ℤ_[ℓ]] LinearMap.ker (D i) :=
      (T i).restrict (hZT' i)
    let BZ : Submodule ℤ_[ℓ] (LinearMap.ker (D i)) := B.comap (LinearMap.ker (D i)).subtype
    have hBZτ : BZ ≤ BZ.comap τ := by
      intro w hw
      exact hBT _ hw
    let S : Submodule ℤ_[ℓ] (LinearMap.ker (D i)) :=
      { carrier := {z | ∃ n : ℕ, ((ℓ : ℤ_[ℓ]) ^ n) • z ∈ BZ}
        add_mem' := by
          rintro a b ⟨n, hn⟩ ⟨m, hm⟩
          show ∃ k : ℕ, ((ℓ : ℤ_[ℓ]) ^ k) • (a + b) ∈ BZ
          refine ⟨n + m, ?_⟩
          rw [smul_add, pow_add]
          refine BZ.add_mem ?_ ?_
          · rw [mul_comm, mul_smul]
            exact BZ.smul_mem _ hn
          · rw [mul_smul]
            exact BZ.smul_mem _ hm
        zero_mem' := by
          show ∃ k : ℕ, ((ℓ : ℤ_[ℓ]) ^ k) • (0 : LinearMap.ker (D i)) ∈ BZ
          exact ⟨0, by rw [smul_zero]; exact BZ.zero_mem⟩
        smul_mem' := by
          rintro c z ⟨n, hn⟩
          show ∃ k : ℕ, ((ℓ : ℤ_[ℓ]) ^ k) • (c • z) ∈ BZ
          refine ⟨n, ?_⟩
          rw [smul_comm]
          exact BZ.smul_mem c hn }
    have hSmem : ∀ z, z ∈ S ↔ ∃ n : ℕ, ((ℓ : ℤ_[ℓ]) ^ n) • z ∈ BZ := fun z => Iff.rfl
    have hτS : S ≤ S.comap τ := by
      intro z hz
      obtain ⟨n, hn⟩ := (hSmem z).mp hz
      rw [Submodule.mem_comap, hSmem]
      refine ⟨n, ?_⟩
      rw [← LinearMap.map_smul]
      exact hBZτ hn
    have hZsat : ∀ (r : ℤ_[ℓ]) (x : Ns i), r ≠ 0 → r • x ∈ LinearMap.ker (D i) →
        x ∈ LinearMap.ker (D i) := by
      intro r x hr hx
      rw [LinearMap.mem_ker, map_smul] at hx
      exact LinearMap.mem_ker.mpr ((smul_eq_zero.mp hx).resolve_left hr)
    have hSsat : ∀ (r : ℤ_[ℓ]) (z : LinearMap.ker (D i)), r ≠ 0 → r • z ∈ S → z ∈ S := by
      intro r z hr hz
      obtain ⟨n, hn⟩ := (hSmem _).mp hz
      have hspec := PadicInt.unitCoeff_spec hr
      have hu := Units.inv_mul (PadicInt.unitCoeff hr)
      rw [hSmem]
      refine ⟨n + r.valuation, ?_⟩
      have heq : ((ℓ : ℤ_[ℓ]) ^ (n + r.valuation)) • z =
          (((PadicInt.unitCoeff hr)⁻¹ : ℤ_[ℓ]ˣ) : ℤ_[ℓ]) • (((ℓ : ℤ_[ℓ]) ^ n) • r • z) := by
        rw [smul_smul, smul_smul]
        congr 1
        linear_combination (-((((PadicInt.unitCoeff hr)⁻¹ : ℤ_[ℓ]ˣ) : ℤ_[ℓ]) *
          (ℓ : ℤ_[ℓ]) ^ n)) * hspec - ((ℓ : ℤ_[ℓ]) ^ n * (ℓ : ℤ_[ℓ]) ^ r.valuation) * hu
      rw [heq]
      exact BZ.smul_mem _ hn
    have hBS : BZ ≤ S := by
      intro z hz
      rw [hSmem]
      exact ⟨0, by rw [pow_zero, one_smul]; exact hz⟩
    have e1 := wc_trace_add_saturated (LinearMap.ker (D i)) hZsat (T i) (hZT i)
    have e2 := @wc_trace_add_saturated ℤ_[ℓ] (LinearMap.ker (D i)) _ _ _ _ _ _ _ S hSsat τ hτS
    have e3 := @wc_trace_restrict_eq_of_smul_mem ℤ_[ℓ] (LinearMap.ker (D i)) _ _ _ _ _ _ _ BZ S hBS τ hBZτ hτS (by
      intro x hx
      obtain ⟨n, hn⟩ := (hSmem x).mp hx
      exact ⟨_, pow_ne_zero n hℓ0, hn⟩)
    have e4 : LinearMap.trace ℤ_[ℓ] (Ns i ⧸ LinearMap.ker (D i))
        ((LinearMap.ker (D i)).mapQ (LinearMap.ker (D i)) (T i) (hZT i)) = rt i := by
      have h := @LinearMap.trace_conj' ℤ_[ℓ] _ (Ns i ⧸ LinearMap.ker (D i)) _ _ (LinearMap.range (D i)) _ _
        ((LinearMap.ker (D i)).mapQ (LinearMap.ker (D i)) (T i) (hZT i)) (D i).quotKerEquivRange
      rw [← h]
      show _ = LinearMap.trace ℤ_[ℓ] (LinearMap.range (D i)) ((T (i + 1)).restrict (hR i))
      congr 1
      apply LinearMap.ext
      intro y
      obtain ⟨q, rfl⟩ := (D i).quotKerEquivRange.surjective y
      obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ q
      rw [LinearEquiv.conj_apply_apply, LinearEquiv.symm_apply_apply, Submodule.mapQ_apply]
      apply Subtype.ext
      simp only [LinearMap.quotKerEquivRange_apply_mk, LinearMap.restrict_apply]
      exact hcomm i x
    have e5 : LinearMap.trace ℤ_[ℓ] BZ (τ.restrict (fun x hx => hBZτ hx)) =
        LinearMap.trace ℤ_[ℓ] B ((T i).restrict hBT) := by
      exact conjSub (LinearMap.ker (D i)) B hBZ (T i) (hZT' i) hBT (fun x hx => hBZτ hx)
    obtain ⟨r, ι, A, hι, hA, htr⟩ :=
      @wc_ratcoord_of_saturated_quotient ℓ _ H (LinearMap.ker (D i)) _ _ _ _ BZ S hSmem π hπ hker τ hτS τH hτ
    refine ⟨r, ι, A, hι, hA, ?_⟩
    rw [htr]; refine congrArg (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ])) ?_
    linear_combination -e1 - e2 - e4 + e3 - e5
  have hd : ∀ i (x : ULift.{u+1} (wcIdemSub (P.ε i))),
      (ULift.down (((wcGModelAb P).d i (i + 1)).hom x :
        ULift.{u+1} (wcIdemSub (P.ε (i + 1))))).1 = Matrix.vecMul (ULift.down x).1 (P.δ i) := by
    intro i x
    dsimp only [wcGModelAb]
    rw [CochainComplex.of_d]
    rfl
  have hiter : ∀ n i (v : wcIdemSub (P.ε i)),
      (ULift.down (((wcCxIter (wcGModelFrob P) n).f i).hom
        (ULift.up v : ULift.{u+1} (wcIdemSub (P.ε i))) : ULift.{u+1} (wcIdemSub (P.ε i)))).1 =
        Matrix.vecMul v.1 (P.f i ^ n) := by
    intro n i v
    induction n with
    | zero =>
      rw [pow_zero, Matrix.vecMul_one]
      rfl
    | succ n ih =>
      rw [pow_succ, ← Matrix.vecMul_vecMul, ← ih]
      rfl
  have h𝕋 : ∀ i (v : wcIdemSub (P.ε i)),
      (ULift.down (((wcGModelAct P γ ≫ wcCxIter (wcGModelFrob P) e).f i).hom
        (ULift.up v : ULift.{u+1} (wcIdemSub (P.ε i))) : ULift.{u+1} (wcIdemSub (P.ε i)))).1 =
        g • Matrix.vecMul v.1 (P.f i ^ e) := by
    intro i v
    rw [← Matrix.smul_vecMul]
    exact hiter e i (wcSmulHom (MonoidAlgebra.single γ⁻¹ (1 : ℤ_[ℓ])) (P.ε i) v)
  have hmemker : ∀ i (z : LinearMap.ker (D i)),
      (ULift.up (⟨z.1.1, z.1.2⟩ : wcIdemSub (P.ε i)) : ULift.{u+1} (wcIdemSub (P.ε i))) ∈
        ((wcGModelAb P).d i (i + 1)).hom.ker := by
    intro i z
    exact AddMonoidHom.mem_ker.mpr (ULift.ext _ _ (Subtype.ext ((hd i _).trans
      (congrArg Subtype.val (LinearMap.mem_ker.mp z.2)))))
  let ι0 : ∀ i, LinearMap.ker (D i) →+ ((wcGModelAb P).d i (i + 1)).hom.ker := fun i =>
    { toFun := fun z => ⟨ULift.up ⟨z.1.1, z.1.2⟩, hmemker i z⟩
      map_zero' := Subtype.ext (ULift.ext _ _ (Subtype.ext rfl))
      map_add' := fun _ _ => Subtype.ext (ULift.ext _ _ (Subtype.ext rfl)) }
  have plumb : ∀ i, ∃ π : LinearMap.ker (D i) →+ (wcGModelAb P).homology i,
      Function.Surjective π ∧
      (∀ z, π z = 0 ↔ ((z : Ns i) = 0 ∨ ∃ j, j + 1 = i ∧ ∃ y : (wcGModelAb P).X j,
        ((wcGModelAb P).d j i).hom y = (ι0 i z).1)) ∧
      ∀ z, (HomologicalComplex.homologyMap (wcGModelAct P γ ≫ wcCxIter (wcGModelFrob P) e) i).hom
        (π z) = π ((T i).restrict (hZT' i) z) := by
    intro i
    obtain ⟨p, hps, hpk, hpn⟩ := wc_ab_cochain_homology_elementwise (wcGModelAb P) i
    refine ⟨p.comp (ι0 i), ?_, ?_, ?_⟩
    · intro h
      obtain ⟨w, rfl⟩ := hps h
      refine ⟨⟨⟨(ULift.down (w.1 : ULift.{u+1} (wcIdemSub (P.ε i)))).1,
        (ULift.down (w.1 : ULift.{u+1} (wcIdemSub (P.ε i)))).2⟩, ?_⟩, ?_⟩
      · apply LinearMap.mem_ker.mpr
        apply Subtype.ext
        exact (hd i w.1).symm.trans (congrArg (fun y => (ULift.down
          (y : ULift.{u+1} (wcIdemSub (P.ε (i + 1))))).1) (AddMonoidHom.mem_ker.mp w.2))
      · exact congrArg p (Subtype.ext rfl)
    · intro z
      show p (ι0 i z) = 0 ↔ _
      rw [hpk]
      apply or_congr_left
      constructor
      · intro h
        apply Subtype.ext
        exact congrArg (fun y => (ULift.down (y : ULift.{u+1} (wcIdemSub (P.ε i)))).1) h
      · intro h
        exact ULift.ext _ _ (Subtype.ext (congrArg Subtype.val h))
    · intro z
      refine hpn _ (ι0 i z) (ι0 i _) ?_
      exact ULift.ext _ _ (Subtype.ext (h𝕋 i ⟨z.1.1, z.1.2⟩).symm)
  have degree : ∀ i, ∃ (r : ℕ) (ι : (wcGModelAb P).homology i →+ (Fin r → ℚ_[ℓ]))
      (A : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      wcRatCoord ℓ ι ∧
      (∀ x, ι ((HomologicalComplex.homologyMap
        (wcGModelAct P γ ≫ wcCxIter (wcGModelFrob P) e) i).hom x) = A.mulVec (ι x)) ∧
      ∃ b : ℤ_[ℓ], A.trace = ((LinearMap.trace ℤ_[ℓ] (Ns i) (T i) - b - rt i : ℤ_[ℓ]) : ℚ_[ℓ]) ∧
        (i = 0 → b = 0) ∧ (∀ j, i = j + 1 → b = rt j) := by
    intro i
    obtain ⟨π, hπs, hπk, hπτ⟩ := plumb i
    cases i with
    | zero =>
      have hBT : ∀ x ∈ (⊥ : Submodule ℤ_[ℓ] (Ns 0)), T 0 x ∈ (⊥ : Submodule ℤ_[ℓ] (Ns 0)) := by
        intro x hx
        rw [(Submodule.mem_bot _).mp hx, map_zero]
        exact Submodule.zero_mem _
      have hker : ∀ z, π z = 0 ↔ (z : Ns 0) ∈ (⊥ : Submodule ℤ_[ℓ] (Ns 0)) := by
        intro z
        rw [hπk, Submodule.mem_bot]
        constructor
        · rintro (h | ⟨j, hj, _⟩)
          · exact h
          · exact absurd hj (Nat.succ_ne_zero j)
        · intro h
          exact Or.inl h
      obtain ⟨r, ι, A, hι, hA, htr⟩ := core 0 ⊥ hBT bot_le _ π hπs hker _ hπτ
      refine ⟨r, ι, A, hι, hA, _, htr, fun _ => ?_, fun j hj => absurd hj.symm (Nat.succ_ne_zero j)⟩
      have h0 : (T 0).restrict hBT = 0 := LinearMap.ext fun x => Subsingleton.elim _ _
      rw [h0, map_zero]
    | succ j =>
      have hBZ : LinearMap.range (D j) ≤ LinearMap.ker (D (j + 1)) := by
        intro x hx
        obtain ⟨y, rfl⟩ := LinearMap.mem_range.mp hx
        rw [LinearMap.mem_ker]
        apply Subtype.ext
        show Matrix.vecMul (Matrix.vecMul y.1 (P.δ j)) (P.δ (j + 1)) = 0
        rw [Matrix.vecMul_vecMul, P.hδδ, Matrix.vecMul_zero]
      have hker : ∀ z, π z = 0 ↔ (z : Ns (j + 1)) ∈ LinearMap.range (D j) := by
        intro z
        rw [hπk]
        constructor
        · rintro (h | ⟨j', hj', y, hy⟩)
          · rw [h]
            exact Submodule.zero_mem _
          · have hjj : j' = j := by omega
            subst hjj
            refine LinearMap.mem_range.mpr ⟨⟨(ULift.down (y : ULift.{u+1} (wcIdemSub (P.ε _)))).1,
              (ULift.down (y : ULift.{u+1} (wcIdemSub (P.ε _)))).2⟩, ?_⟩
            apply Subtype.ext
            exact (hd _ y).symm.trans (congrArg (fun w => (ULift.down
              (w : ULift.{u+1} (wcIdemSub (P.ε _)))).1) hy)
        · intro h
          obtain ⟨w, hw⟩ := LinearMap.mem_range.mp h
          right
          refine ⟨j, rfl, (ULift.up (⟨w.1, w.2⟩ : wcIdemSub (P.ε j)) :
            ULift.{u+1} (wcIdemSub (P.ε j))), ?_⟩
          exact ULift.ext _ _ (Subtype.ext ((hd j _).trans (congrArg Subtype.val hw)))
      obtain ⟨r, ι, A, hι, hA, htr⟩ :=
        core (j + 1) (LinearMap.range (D j)) (hR j) hBZ _ π hπs hker _ hπτ
      refine ⟨r, ι, A, hι, hA, _, htr, fun h => absurd h (Nat.succ_ne_zero j), fun j' hj' => ?_⟩
      have hjj : j = j' := by omega
      subst hjj
      rfl
  have hs4 : ∀ i, LinearMap.trace ℤ_[ℓ] (Ns i) (T i) =
      ∑ j : Fin (P.k i), ∑ τ : Γ, (g * MonoidAlgebra.single τ 1 * (P.f i ^ e) j j).coeff τ :=
    fun i => wc_gmodel_chain_trace_formula ℓ (P.ε i) (P.f i ^ e) (hFε i) g (Ns i) (hNs i) (TW i)
      (fun v => rfl) (fun v _ => hNT i v)
  have htrW : wcGModelTr P e γ =
      ∑ i ∈ Finset.range 3, (-1 : ℤ_[ℓ]) ^ i * LinearMap.trace ℤ_[ℓ] (Ns i) (T i) := by
    simp only [wcGModelTr]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    exact congrArg (fun x => (-1 : ℤ_[ℓ]) ^ i * x) (hs4 i).symm
  have hrt2 : rt 2 = 0 := by
    have h3 : P.k 3 = 0 := P.hk 3 le_rfl
    show LinearMap.trace ℤ_[ℓ] (LinearMap.range (D 2)) ((T (2 + 1)).restrict (hR 2)) = 0
    have h0 : (T (2 + 1)).restrict (hR 2) = 0 :=
      LinearMap.ext fun x => Subtype.ext (Subtype.ext (funext fun j => (Fin.cast h3 j).elim0))
    rw [h0, map_zero]
  choose r ι A hι hA b htrb hb0 hbs using degree
  refine ⟨r, ι, A, fun i _ => hι i, fun i _ => hA i, ?_⟩
  rw [htrW]
  have hc : ∀ x : ℤ_[ℓ], (x : ℚ_[ℓ]) = PadicInt.Coe.ringHom x := fun _ => rfl
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, htrb, hb0 0 rfl, hbs 1 0 rfl,
    hbs 2 1 rfl, hrt2, hc, map_add, map_sub, map_mul, map_pow, map_neg, map_one, map_zero]
  ring

theorem wc_ext_ses_ratcoord_trace {C : Type*} [Category C] [Abelian C] [HasExt C]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (P : C) (Fr : P ⟶ P) (Sc : ShortComplex C) (hSc : Sc.ShortExact)
    (s₁ : Sc.X₁ ⟶ Sc.X₁) (s₂ : Sc.X₂ ⟶ Sc.X₂) (s₃ : Sc.X₃ ⟶ Sc.X₃)
    (h₁₂ : s₁ ≫ Sc.f = Sc.f ≫ s₂) (h₂₃ : s₂ ≫ Sc.g = Sc.g ≫ s₃) (e : ℕ)
    (h1 : ∀ y : Abelian.Ext P Sc.X₃ 1, y = 0) (h2 : ∀ y : Abelian.Ext P Sc.X₃ 2, y = 0)
    (rF rG : ℕ → ℕ) (ιF : ∀ i, Abelian.Ext P Sc.X₁ i →+ (Fin (rF i) → ℚ_[ℓ]))
    (ιG : ∀ i, Abelian.Ext P Sc.X₂ i →+ (Fin (rG i) → ℚ_[ℓ]))
    (AF : ∀ i, Matrix (Fin (rF i)) (Fin (rF i)) ℚ_[ℓ])
    (AG : ∀ i, Matrix (Fin (rG i)) (Fin (rG i)) ℚ_[ℓ])
    (r₀ : ℕ) (ι₀ : Abelian.Ext P Sc.X₃ 0 →+ (Fin r₀ → ℚ_[ℓ])) (A₀ : Matrix (Fin r₀) (Fin r₀) ℚ_[ℓ])
    (hιF : ∀ i < 3, wcRatCoord ℓ (ιF i)) (hιG : ∀ i < 3, wcRatCoord ℓ (ιG i))
    (hι₀ : wcRatCoord ℓ ι₀)
    (hAF : ∀ i < 3, ∀ x, ιF i ((⇑((Abelian.Ext.mk₀ Fr).precomp Sc.X₁ (zero_add i)))^[e]
        ((Abelian.Ext.mk₀ s₁).postcomp P (add_zero i) x)) = (AF i).mulVec (ιF i x))
    (hAG : ∀ i < 3, ∀ x, ιG i ((⇑((Abelian.Ext.mk₀ Fr).precomp Sc.X₂ (zero_add i)))^[e]
        ((Abelian.Ext.mk₀ s₂).postcomp P (add_zero i) x)) = (AG i).mulVec (ιG i x))
    (hA₀ : ∀ x, ι₀ ((⇑((Abelian.Ext.mk₀ Fr).precomp Sc.X₃ (zero_add 0)))^[e]
        ((Abelian.Ext.mk₀ s₃).postcomp P (add_zero 0) x)) = A₀.mulVec (ι₀ x)) :
    ∑ i ∈ Finset.range 3, (-1 : ℚ_[ℓ]) ^ i * (AF i).trace =
      ∑ i ∈ Finset.range 3, (-1 : ℚ_[ℓ]) ^ i * (AG i).trace - A₀.trace :=
by
  classical
  have hpne : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
  have hl0 : (ℓ : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hpne
  have hlk : ∀ k : ℕ, ((ℓ ^ k : ℕ) : ℚ_[ℓ]) ≠ 0 := fun k => by
    exact_mod_cast pow_ne_zero k hpne



  have s1 : ∀ (X Y : C) (a b : ℕ) {r s : ℕ} (ιM : Abelian.Ext P X a →+ (Fin r → ℚ_[ℓ]))
      (ιN : Abelian.Ext P Y b →+ (Fin s → ℚ_[ℓ])), wcRatCoord ℓ ιM → wcRatCoord ℓ ιN →
      ∀ φ : Abelian.Ext P X a →+ Abelian.Ext P Y b,
      ∃ B : Matrix (Fin s) (Fin r) ℚ_[ℓ], ∀ x, ιN (φ x) = B.mulVec (ιM x) := by
    intro X Y a b r s ιM ιN hM hN φ
    obtain ⟨hM1, hM2, hM3, hM4⟩ := hM
    obtain ⟨hN1, hN2, hN3, hN4⟩ := hN

    have W : ∀ u, ιM u = 0 → ιN (φ u) = 0 := by
      intro u hu
      obtain ⟨k, hk⟩ := (hM1 u).mp hu
      have h1' : ιN (φ ((ℓ ^ k : ℕ) • u)) = 0 := by rw [hk, map_zero, map_zero]
      rw [map_nsmul, map_nsmul, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ]] at h1'
      exact (smul_eq_zero.mp h1').resolve_left (hlk k)
    have W' : ∀ y y', ιM y = ιM y' → ιN (φ y) = ιN (φ y') := by
      intro y y' h
      have := W (y - y') (by rw [map_sub, h, sub_self])
      rwa [map_sub, map_sub, sub_eq_zero] at this

    have Z : ∀ (x y) (c : ℤ_[ℓ]), ιM y = (c : ℚ_[ℓ]) • ιM x →
        ιN (φ y) = (c : ℚ_[ℓ]) • ιN (φ x) := by
      intro x y c hy
      obtain ⟨z, hz⟩ := hN3 (φ x) c
      have key : ιN (φ y - z) = 0 := by
        apply hN4
        intro k
        obtain ⟨ck, hck⟩ := Ideal.mem_span_singleton'.mp (PadicInt.appr_spec k c)
        have hc : (c : ℚ_[ℓ]) = ((c.appr k : ℕ) : ℚ_[ℓ]) + (ck : ℚ_[ℓ]) * (ℓ : ℚ_[ℓ]) ^ k := by
          have := congrArg (fun t : ℤ_[ℓ] => (t : ℚ_[ℓ])) hck
          push_cast at this
          linear_combination -this
        obtain ⟨yk, hyk⟩ := hM3 x ck
        obtain ⟨zk, hzk⟩ := hN3 (φ x) ck
        have e1 : ιM y = ιM (c.appr k • x + (ℓ ^ k : ℕ) • yk) := by
          rw [map_add, map_nsmul, map_nsmul, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ],
            ← Nat.cast_smul_eq_nsmul ℚ_[ℓ], hyk, hy, hc]
          push_cast
          module
        have e3 : ιN (φ y) = ((c.appr k : ℕ) : ℚ_[ℓ]) • ιN (φ x) +
            (ℓ : ℚ_[ℓ]) ^ k • ιN (φ yk) := by
          rw [W' _ _ e1, map_add, map_add, map_nsmul, map_nsmul, map_nsmul, map_nsmul,
            ← Nat.cast_smul_eq_nsmul ℚ_[ℓ], ← Nat.cast_smul_eq_nsmul ℚ_[ℓ], Nat.cast_pow]
        refine ⟨φ yk - zk, ?_⟩
        simp only [map_sub]
        rw [e3, hz, hzk, hc]
        module
      rw [map_sub, sub_eq_zero] at key
      rw [key, hz]

    have S : ∀ (y) (xs : Fin r → Abelian.Ext P X a) (cs : Fin r → ℤ_[ℓ]),
        ιM y = ∑ j, (cs j : ℚ_[ℓ]) • ιM (xs j) →
        ιN (φ y) = ∑ j, (cs j : ℚ_[ℓ]) • ιN (φ (xs j)) := by
      intro y xs cs hy
      choose ys hys using fun j => hM3 (xs j) (cs j)
      have h1' : ιM y = ιM (∑ j, ys j) := by
        rw [hy, map_sum]
        exact Finset.sum_congr rfl (fun j _ => (hys j).symm)
      rw [W' _ _ h1', map_sum, map_sum]
      exact Finset.sum_congr rfl (fun j _ => Z (xs j) (ys j) (cs j) (hys j))

    choose kk xx hxx using fun j : Fin r => hM2 (Pi.single j 1)
    obtain ⟨B, hB⟩ : ∃ B : Matrix (Fin s) (Fin r) ℚ_[ℓ],
        B = Matrix.of fun i j => ((ℓ : ℚ_[ℓ]) ^ kk j)⁻¹ * ιN (φ (xx j)) i := ⟨_, rfl⟩
    have hcol : ∀ j, B.mulVec (ιM (xx j)) = ιN (φ (xx j)) := by
      intro j
      rw [← hxx j, Matrix.mulVec_smul]
      ext i
      simp only [hB, Pi.smul_apply, smul_eq_mul, Matrix.mulVec, dotProduct, Pi.single_apply,
        mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ,
        if_true, Matrix.of_apply]
      field_simp
    refine ⟨B, fun x => ?_⟩
    have hnl : ‖(ℓ : ℚ_[ℓ])‖ < 1 := Padic.norm_p_lt_one
    have hn0 : 0 ≤ ‖(ℓ : ℚ_[ℓ])‖ := norm_nonneg _
    have hex : ∀ q : ℚ_[ℓ], ∃ n : ℕ, ‖(ℓ : ℚ_[ℓ])‖ ^ n * ‖q‖ ≤ 1 := by
      intro q
      rcases eq_or_lt_of_le (norm_nonneg q) with h | h
      · exact ⟨0, by rw [← h]; simp⟩
      · obtain ⟨n, hn⟩ := exists_pow_lt_of_lt_one (inv_pos.mpr h) hnl
        exact ⟨n, (le_div_iff₀ h).mp (by rw [one_div]; exact hn.le)⟩
    choose mm hmm using fun j => hex (((ℓ : ℚ_[ℓ]) ^ kk j)⁻¹ * ιM x j)
    set m := ∑ j, mm j with hm
    have hbound : ∀ j, ‖(ℓ : ℚ_[ℓ]) ^ m * (((ℓ : ℚ_[ℓ]) ^ kk j)⁻¹ * ιM x j)‖ ≤ 1 := by
      intro j
      rw [norm_mul, norm_pow]
      refine le_trans (mul_le_mul_of_nonneg_right (pow_le_pow_of_le_one hn0 hnl.le
        (Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ j))) (norm_nonneg _))
        (hmm j)
    obtain ⟨cc, hcc⟩ : ∃ cc : Fin r → ℤ_[ℓ], ∀ j, (cc j : ℚ_[ℓ]) =
        (ℓ : ℚ_[ℓ]) ^ m * (((ℓ : ℚ_[ℓ]) ^ kk j)⁻¹ * ιM x j) :=
      ⟨fun j => ⟨_, hbound j⟩, fun j => rfl⟩
    have hv : ιM ((ℓ ^ m : ℕ) • x) = ∑ j, (cc j : ℚ_[ℓ]) • ιM (xx j) := by
      rw [map_nsmul, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ]]
      ext i
      simp only [← hxx, hcc, Pi.smul_apply, Finset.sum_apply, smul_eq_mul, Pi.single_apply,
        mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ,
        if_true]
      push_cast
      field_simp
    have e1 : ιN (φ ((ℓ ^ m : ℕ) • x)) = (ℓ : ℚ_[ℓ]) ^ m • ιN (φ x) := by
      rw [map_nsmul, map_nsmul, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ], Nat.cast_pow]
    have e2 : ιM ((ℓ ^ m : ℕ) • x) = (ℓ : ℚ_[ℓ]) ^ m • ιM x := by
      rw [map_nsmul, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ], Nat.cast_pow]
    have hfin : (ℓ : ℚ_[ℓ]) ^ m • ιN (φ x) = (ℓ : ℚ_[ℓ]) ^ m • B.mulVec (ιM x) := by
      rw [← e1, S _ xx cc hv, ← Matrix.mulVec_smul, ← e2, hv, Matrix.mulVec_sum]
      simp only [Matrix.mulVec_smul, hcol]
    exact (smul_right_inj (pow_ne_zero m hl0)).mp hfin



  have s2 : ∀ (X : C) (a : ℕ) {r n : ℕ} (ι : Abelian.Ext P X a →+ (Fin r → ℚ_[ℓ])),
      wcRatCoord ℓ ι → ∀ (B₁ B₂ : Matrix (Fin n) (Fin r) ℚ_[ℓ]),
      (∀ x, B₁.mulVec (ι x) = B₂.mulVec (ι x)) → B₁ = B₂ := by
    intro X a r n ι hι B₁ B₂ h
    obtain ⟨-, h2', -, -⟩ := hι
    apply Matrix.ext_of_mulVec_single
    intro j
    obtain ⟨k, x, hx⟩ := h2' (Pi.single j 1)
    have := h x
    rw [← hx, Matrix.mulVec_smul, Matrix.mulVec_smul] at this
    exact (smul_right_inj (pow_ne_zero k hl0)).mp this



  have s3 : ∀ (X Y : C) (a b : ℕ) {r s : ℕ} (ιM : Abelian.Ext P X a →+ (Fin r → ℚ_[ℓ]))
      (ιN : Abelian.Ext P Y b →+ (Fin s → ℚ_[ℓ])), wcRatCoord ℓ ιM → wcRatCoord ℓ ιN →
      ∀ (φ : Abelian.Ext P X a →+ Abelian.Ext P Y b) (B : Matrix (Fin s) (Fin r) ℚ_[ℓ]),
      (∀ x, ιN (φ x) = B.mulVec (ιM x)) →
      ((∀ x, φ x = 0 → x = 0) → ∀ v, B.mulVec v = 0 → v = 0) ∧
      (Function.Surjective φ → ∀ w, ∃ v, B.mulVec v = w) := by
    intro X Y a b r s ιM ιN hM hN φ B hB
    obtain ⟨hM1, hM2, -, -⟩ := hM
    obtain ⟨hN1, hN2, -, -⟩ := hN
    refine ⟨fun hinj v hv => ?_, fun hs w => ?_⟩
    · obtain ⟨k, x, hx⟩ := hM2 v
      have h0 : ιN (φ x) = 0 := by rw [hB, ← hx, Matrix.mulVec_smul, hv, smul_zero]
      obtain ⟨j, hj⟩ := (hN1 _).mp h0
      have hx0 : (ℓ ^ j : ℕ) • x = 0 := hinj _ (by rw [map_nsmul, hj])
      have hx1 : ιM x = 0 := (hM1 x).mpr ⟨j, hx0⟩
      rw [hx1] at hx
      exact (smul_eq_zero.mp hx).resolve_left (pow_ne_zero k hl0)
    · obtain ⟨k, y, hy⟩ := hN2 w
      obtain ⟨x, rfl⟩ := hs y
      refine ⟨((ℓ : ℚ_[ℓ]) ^ k)⁻¹ • ιM x, ?_⟩
      rw [Matrix.mulVec_smul, ← hB, ← hy, smul_smul, inv_mul_cancel₀ (pow_ne_zero k hl0),
        one_smul]



  have s4 : ∀ (X Y Z : C) (a b c : ℕ) {r s t : ℕ}
      (ιM : Abelian.Ext P X a →+ (Fin r → ℚ_[ℓ])) (ιN : Abelian.Ext P Y b →+ (Fin s → ℚ_[ℓ]))
      (ιQ : Abelian.Ext P Z c →+ (Fin t → ℚ_[ℓ])),
      wcRatCoord ℓ ιM → wcRatCoord ℓ ιN → wcRatCoord ℓ ιQ →
      ∀ (φ : Abelian.Ext P X a →+ Abelian.Ext P Y b) (ψ : Abelian.Ext P Y b →+ Abelian.Ext P Z c),
      (∀ y, ψ y = 0 ↔ ∃ x, φ x = y) →
      ∀ (Bφ : Matrix (Fin s) (Fin r) ℚ_[ℓ]) (Bψ : Matrix (Fin t) (Fin s) ℚ_[ℓ]),
      (∀ x, ιN (φ x) = Bφ.mulVec (ιM x)) → (∀ y, ιQ (ψ y) = Bψ.mulVec (ιN y)) →
      ∀ v, Bψ.mulVec v = 0 ↔ ∃ w, Bφ.mulVec w = v := by
    intro X Y Z a b c r s t ιM ιN ιQ hM hN hQ φ ψ hex Bφ Bψ hBφ hBψ v
    obtain ⟨-, hM2, -, -⟩ := hM
    obtain ⟨-, hN2, -, -⟩ := hN
    obtain ⟨hQ1, -, -, -⟩ := hQ
    constructor
    · intro hv
      obtain ⟨k, y, hy⟩ := hN2 v
      have h0 : ιQ (ψ y) = 0 := by rw [hBψ, ← hy, Matrix.mulVec_smul, hv, smul_zero]
      obtain ⟨j, hj⟩ := (hQ1 _).mp h0
      obtain ⟨x, hx⟩ := (hex _).mp (by rw [map_nsmul, hj] : ψ ((ℓ ^ j : ℕ) • y) = 0)
      refine ⟨((ℓ : ℚ_[ℓ]) ^ (j + k))⁻¹ • ιM x, ?_⟩
      rw [Matrix.mulVec_smul, ← hBφ, hx, map_nsmul, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ], ← hy,
        Nat.cast_pow, smul_smul, smul_smul, mul_assoc, ← pow_add,
        inv_mul_cancel₀ (pow_ne_zero _ hl0), one_smul]
    · rintro ⟨w, rfl⟩
      obtain ⟨k, x, hx⟩ := hM2 w
      have h0 : (ℓ : ℚ_[ℓ]) ^ k • Bψ.mulVec (Bφ.mulVec w) = 0 := by
        rw [← Matrix.mulVec_smul, ← Matrix.mulVec_smul, hx, ← hBφ, ← hBψ,
          (hex _).mpr ⟨x, rfl⟩, map_zero]
      exact (smul_eq_zero.mp h0).resolve_left (pow_ne_zero k hl0)



  have s5 : ∀ {U W Q : Type} [AddCommGroup U] [Module ℚ_[ℓ] U] [FiniteDimensional ℚ_[ℓ] U]
      [AddCommGroup W] [Module ℚ_[ℓ] W] [FiniteDimensional ℚ_[ℓ] W]
      [AddCommGroup Q] [Module ℚ_[ℓ] Q] [FiniteDimensional ℚ_[ℓ] Q]
      (f : U →ₗ[ℚ_[ℓ]] W) (g : W →ₗ[ℚ_[ℓ]] Q), Function.Injective f → Function.Surjective g →
      (∀ w, g w = 0 ↔ ∃ u, f u = w) →
      ∀ (a : U →ₗ[ℚ_[ℓ]] U) (b : W →ₗ[ℚ_[ℓ]] W) (c : Q →ₗ[ℚ_[ℓ]] Q),
      (∀ u, b (f u) = f (a u)) → (∀ w, g (b w) = c (g w)) →
      LinearMap.trace ℚ_[ℓ] W b = LinearMap.trace ℚ_[ℓ] U a + LinearMap.trace ℚ_[ℓ] Q c := by
    intro U W Q _ _ _ _ _ _ _ _ _ f g hf hg hfg a b c hab hbc
    obtain ⟨s, hs⟩ := LinearMap.exists_rightInverse_of_surjective g (LinearMap.range_eq_top.mpr hg)
    obtain ⟨p₀, hp₀⟩ := LinearMap.exists_leftInverse_of_injective f (LinearMap.ker_eq_bot.mpr hf)
    have hgs : ∀ q, g (s q) = q := fun q => LinearMap.congr_fun hs q
    have hp0 : ∀ u, p₀ (f u) = u := fun u => LinearMap.congr_fun hp₀ u
    obtain ⟨p, hp⟩ : ∃ p : W →ₗ[ℚ_[ℓ]] U, ∀ w, p w = p₀ (w - s (g w)) :=
      ⟨p₀ ∘ₗ (LinearMap.id - s ∘ₗ g), fun w => rfl⟩
    have hpf : ∀ u, p (f u) = u := by
      intro u
      have h0 : g (f u) = 0 := (hfg _).mpr ⟨u, rfl⟩
      rw [hp, h0, map_zero, sub_zero, hp0]
    have hsplit : ∀ w, f (p w) + s (g w) = w := by
      intro w
      obtain ⟨u, hu⟩ := (hfg (w - s (g w))).mp (by rw [map_sub, hgs, sub_self])
      rw [hp, ← hu, hp0, hu, sub_add_cancel]
    have hb : b = (b ∘ₗ f) ∘ₗ p + (b ∘ₗ s) ∘ₗ g := by
      apply LinearMap.ext
      intro w
      simp only [LinearMap.add_apply, LinearMap.comp_apply]
      rw [← map_add, hsplit]
    have t1 : LinearMap.trace ℚ_[ℓ] W ((b ∘ₗ f) ∘ₗ p) = LinearMap.trace ℚ_[ℓ] U a := by
      rw [LinearMap.trace_comp_comm' p (b ∘ₗ f)]
      congr 1
      apply LinearMap.ext
      intro u
      simp only [LinearMap.comp_apply]
      rw [hab, hpf]
    have t2 : LinearMap.trace ℚ_[ℓ] W ((b ∘ₗ s) ∘ₗ g) = LinearMap.trace ℚ_[ℓ] Q c := by
      rw [LinearMap.trace_comp_comm' g (b ∘ₗ s)]
      congr 1
      apply LinearMap.ext
      intro q
      simp only [LinearMap.comp_apply]
      rw [hbc, hgs]
    rw [hb, map_add, t1, t2]



  have hrr : ∀ {p q : ℕ} (M : Matrix (Fin q) (Fin p) ℚ_[ℓ]) (w : Fin p → ℚ_[ℓ]),
      ((Matrix.toLin' M).rangeRestrict w : Fin q → ℚ_[ℓ]) = M.mulVec w := fun M w => rfl
  have s6 : ∀ {n₀ n₁ n₂ n₃ n₄ : ℕ}
      (B₀ : Matrix (Fin n₁) (Fin n₀) ℚ_[ℓ]) (B₁ : Matrix (Fin n₂) (Fin n₁) ℚ_[ℓ])
      (B₂ : Matrix (Fin n₃) (Fin n₂) ℚ_[ℓ]) (B₃ : Matrix (Fin n₄) (Fin n₃) ℚ_[ℓ])
      (A₀ : Matrix (Fin n₀) (Fin n₀) ℚ_[ℓ]) (A₁ : Matrix (Fin n₁) (Fin n₁) ℚ_[ℓ])
      (A₂ : Matrix (Fin n₂) (Fin n₂) ℚ_[ℓ]) (A₃ : Matrix (Fin n₃) (Fin n₃) ℚ_[ℓ])
      (A₄ : Matrix (Fin n₄) (Fin n₄) ℚ_[ℓ]),
      (∀ v, B₀.mulVec v = 0 → v = 0) →
      (∀ v, B₁.mulVec v = 0 ↔ ∃ w, B₀.mulVec w = v) →
      (∀ v, B₂.mulVec v = 0 ↔ ∃ w, B₁.mulVec w = v) →
      (∀ v, B₃.mulVec v = 0 ↔ ∃ w, B₂.mulVec w = v) →
      (∀ v, ∃ w, B₃.mulVec w = v) →
      B₀ * A₀ = A₁ * B₀ → B₁ * A₁ = A₂ * B₁ → B₂ * A₂ = A₃ * B₂ → B₃ * A₃ = A₄ * B₃ →
      A₀.trace - A₁.trace + A₂.trace - A₃.trace + A₄.trace = 0 := by
    intro n₀ n₁ n₂ n₃ n₄ B₀ B₁ B₂ B₃ A₀ A₁ A₂ A₃ A₄ h₀ h₁ h₂ h₃ h₄ c₀ c₁ c₂ c₃
    have hA₂ : ∀ x ∈ LinearMap.range (Matrix.toLin' B₁),
        Matrix.toLin' A₂ x ∈ LinearMap.range (Matrix.toLin' B₁) := by
      rintro x ⟨w, rfl⟩
      exact ⟨A₁.mulVec w, by simp only [Matrix.toLin'_apply, Matrix.mulVec_mulVec, c₁]⟩
    have hA₃ : ∀ x ∈ LinearMap.range (Matrix.toLin' B₂),
        Matrix.toLin' A₃ x ∈ LinearMap.range (Matrix.toLin' B₂) := by
      rintro x ⟨w, rfl⟩
      exact ⟨A₂.mulVec w, by simp only [Matrix.toLin'_apply, Matrix.mulVec_mulVec, c₂]⟩
    have E1 := s5 (Matrix.toLin' B₀) (Matrix.toLin' B₁).rangeRestrict
      ((injective_iff_map_eq_zero _).mpr (fun v hv => h₀ v (by rwa [Matrix.toLin'_apply] at hv)))
      (LinearMap.surjective_rangeRestrict _)
      (fun w => by
        rw [← Submodule.coe_eq_zero, hrr]
        simp only [Matrix.toLin'_apply]
        exact h₁ w)
      (Matrix.toLin' A₀) (Matrix.toLin' A₁) ((Matrix.toLin' A₂).restrict hA₂)
      (fun u => by simp only [Matrix.toLin'_apply, Matrix.mulVec_mulVec, c₀])
      (fun w => by
        apply Subtype.ext
        rw [LinearMap.coe_restrict_apply, hrr, hrr, Matrix.toLin'_apply, Matrix.toLin'_apply,
          Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, c₁])
    have E2 := s5 (LinearMap.range (Matrix.toLin' B₁)).subtype (Matrix.toLin' B₂).rangeRestrict
      (fun x y hxy => Subtype.ext hxy)
      (LinearMap.surjective_rangeRestrict _)
      (fun w => by
        rw [← Submodule.coe_eq_zero, hrr]
        constructor
        · intro hw
          obtain ⟨w', hw'⟩ := (h₂ w).mp hw
          exact ⟨⟨w, LinearMap.mem_range.mpr ⟨w', by rw [Matrix.toLin'_apply]; exact hw'⟩⟩, rfl⟩
        · rintro ⟨⟨u, hu⟩, rfl⟩
          obtain ⟨w', hw'⟩ := LinearMap.mem_range.mp hu
          rw [Matrix.toLin'_apply] at hw'
          exact (h₂ u).mpr ⟨w', hw'⟩)
      ((Matrix.toLin' A₂).restrict hA₂) (Matrix.toLin' A₂) ((Matrix.toLin' A₃).restrict hA₃)
      (fun u => rfl)
      (fun w => by
        apply Subtype.ext
        rw [LinearMap.coe_restrict_apply, hrr, hrr, Matrix.toLin'_apply, Matrix.toLin'_apply,
          Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, c₂])
    have E3 := s5 (LinearMap.range (Matrix.toLin' B₂)).subtype (Matrix.toLin' B₃)
      (fun x y hxy => Subtype.ext hxy)
      (fun v => by
        obtain ⟨w, hw⟩ := h₄ v
        exact ⟨w, by rw [Matrix.toLin'_apply]; exact hw⟩)
      (fun w => by
        rw [Matrix.toLin'_apply]
        constructor
        · intro hw
          obtain ⟨w', hw'⟩ := (h₃ w).mp hw
          exact ⟨⟨w, LinearMap.mem_range.mpr ⟨w', by rw [Matrix.toLin'_apply]; exact hw'⟩⟩, rfl⟩
        · rintro ⟨⟨u, hu⟩, rfl⟩
          obtain ⟨w', hw'⟩ := LinearMap.mem_range.mp hu
          rw [Matrix.toLin'_apply] at hw'
          exact (h₃ u).mpr ⟨w', hw'⟩)
      ((Matrix.toLin' A₃).restrict hA₃) (Matrix.toLin' A₃) (Matrix.toLin' A₄)
      (fun u => rfl)
      (fun w => by simp only [Matrix.toLin'_apply, Matrix.mulVec_mulVec, c₃])
    rw [Matrix.trace_toLin'_eq, Matrix.trace_toLin'_eq] at E1
    rw [Matrix.trace_toLin'_eq] at E2
    rw [Matrix.trace_toLin'_eq, Matrix.trace_toLin'_eq] at E3
    linear_combination -E1 + E2 - E3



  have s7 : ∀ {m n : ℕ} (B : Matrix (Fin n) (Fin m) ℚ_[ℓ]) (A : Matrix (Fin m) (Fin m) ℚ_[ℓ])
      (A' : Matrix (Fin n) (Fin n) ℚ_[ℓ]), (∀ v, B.mulVec v = 0 → v = 0) →
      (∀ w, ∃ v, B.mulVec v = w) → B * A = A' * B → A.trace = A'.trace := by
    intro m n B A A' hinj hsurj hc
    have hbij : Function.Bijective (Matrix.toLin' B) :=
      ⟨(injective_iff_map_eq_zero _).mpr (fun v hv => hinj v (by rwa [Matrix.toLin'_apply] at hv)),
        fun w => by
          obtain ⟨v, hv⟩ := hsurj w
          exact ⟨v, by rw [Matrix.toLin'_apply]; exact hv⟩⟩
    have hconj : (LinearEquiv.ofBijective (Matrix.toLin' B) hbij).conj (Matrix.toLin' A) =
        Matrix.toLin' A' := by
      apply LinearMap.ext
      intro w
      obtain ⟨v, rfl⟩ := (LinearEquiv.ofBijective (Matrix.toLin' B) hbij).surjective w
      have key : (LinearEquiv.ofBijective (Matrix.toLin' B) hbij).symm
          ((LinearEquiv.ofBijective (Matrix.toLin' B) hbij) v) = v :=
        LinearEquiv.symm_apply_apply _ v
      rw [LinearEquiv.conj_apply]
      simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, key]
      simp only [LinearEquiv.ofBijective_apply, Matrix.toLin'_apply, Matrix.mulVec_mulVec, hc]
    rw [← Matrix.trace_toLin'_eq A, ← Matrix.trace_toLin'_eq A', ← hconj,
      LinearMap.trace_conj']



  have semi : ∀ {Y Z : C} {n i j : ℕ} (β : Abelian.Ext Y Z n) (h : i + n = j) (k : ℕ)
      (y : Abelian.Ext P Y i),
      β.postcomp P h ((⇑((Abelian.Ext.mk₀ Fr).precomp Y (zero_add i)))^[k] y) =
      (⇑((Abelian.Ext.mk₀ Fr).precomp Z (zero_add j)))^[k] (β.postcomp P h y) := by
    intro Y Z n i j β h k y
    have hs : Function.Semiconj (β.postcomp P h)
        ((Abelian.Ext.mk₀ Fr).precomp Y (zero_add i))
        ((Abelian.Ext.mk₀ Fr).precomp Z (zero_add j)) := by
      intro y
      show ((Abelian.Ext.mk₀ Fr).comp y (zero_add i)).comp β h =
        (Abelian.Ext.mk₀ Fr).comp (y.comp β h) (zero_add j)
      exact Abelian.Ext.comp_assoc _ _ _ _ _ (by omega)
    exact hs.iterate_right k y
  have P1 : ∀ (i : ℕ) (x : Abelian.Ext P Sc.X₁ i),
      (Abelian.Ext.mk₀ Sc.f).postcomp P (add_zero i)
        ((⇑((Abelian.Ext.mk₀ Fr).precomp Sc.X₁ (zero_add i)))^[e]
          ((Abelian.Ext.mk₀ s₁).postcomp P (add_zero i) x)) =
      (⇑((Abelian.Ext.mk₀ Fr).precomp Sc.X₂ (zero_add i)))^[e]
        ((Abelian.Ext.mk₀ s₂).postcomp P (add_zero i)
          ((Abelian.Ext.mk₀ Sc.f).postcomp P (add_zero i) x)) := by
    intro i x
    rw [semi]
    congr 1
    show (x.comp (Abelian.Ext.mk₀ s₁) (add_zero i)).comp (Abelian.Ext.mk₀ Sc.f) (add_zero i) =
      (x.comp (Abelian.Ext.mk₀ Sc.f) (add_zero i)).comp (Abelian.Ext.mk₀ s₂) (add_zero i)
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, h₁₂]
  have P2 : ∀ (i : ℕ) (x : Abelian.Ext P Sc.X₂ i),
      (Abelian.Ext.mk₀ Sc.g).postcomp P (add_zero i)
        ((⇑((Abelian.Ext.mk₀ Fr).precomp Sc.X₂ (zero_add i)))^[e]
          ((Abelian.Ext.mk₀ s₂).postcomp P (add_zero i) x)) =
      (⇑((Abelian.Ext.mk₀ Fr).precomp Sc.X₃ (zero_add i)))^[e]
        ((Abelian.Ext.mk₀ s₃).postcomp P (add_zero i)
          ((Abelian.Ext.mk₀ Sc.g).postcomp P (add_zero i) x)) := by
    intro i x
    rw [semi]
    congr 1
    show (x.comp (Abelian.Ext.mk₀ s₂) (add_zero i)).comp (Abelian.Ext.mk₀ Sc.g) (add_zero i) =
      (x.comp (Abelian.Ext.mk₀ Sc.g) (add_zero i)).comp (Abelian.Ext.mk₀ s₃) (add_zero i)
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, h₂₃]
  have P3 : ∀ x : Abelian.Ext P Sc.X₃ 0,
      hSc.extClass.postcomp P (zero_add 1)
        ((⇑((Abelian.Ext.mk₀ Fr).precomp Sc.X₃ (zero_add 0)))^[e]
          ((Abelian.Ext.mk₀ s₃).postcomp P (add_zero 0) x)) =
      (⇑((Abelian.Ext.mk₀ Fr).precomp Sc.X₁ (zero_add 1)))^[e]
        ((Abelian.Ext.mk₀ s₁).postcomp P (add_zero 1)
          (hSc.extClass.postcomp P (zero_add 1) x)) := by
    intro x
    rw [semi]
    congr 1
    show (x.comp (Abelian.Ext.mk₀ s₃) (add_zero 0)).comp hSc.extClass (zero_add 1) =
      (x.comp hSc.extClass (zero_add 1)).comp (Abelian.Ext.mk₀ s₁) (add_zero 1)
    have hnat : (Abelian.Ext.mk₀ s₃).comp hSc.extClass (zero_add 1) =
        hSc.extClass.comp (Abelian.Ext.mk₀ s₁) (add_zero 1) :=
      (hSc.extClass_naturality hSc (ShortComplex.Hom.mk s₁ s₂ s₃ h₁₂ h₂₃)).symm
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add 1) (by omega),
      Abelian.Ext.comp_assoc _ _ _ (zero_add 1) (add_zero 1) (by omega), hnat]



  have L1 : ∀ x : Abelian.Ext P Sc.X₁ 0,
      (Abelian.Ext.mk₀ Sc.f).postcomp P (add_zero 0) x = 0 → x = 0 := by
    intro x hx
    obtain ⟨g, rfl⟩ : ∃ g, Abelian.Ext.mk₀ g = x := ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply x⟩
    change (Abelian.Ext.mk₀ g).comp (Abelian.Ext.mk₀ Sc.f) (add_zero 0) = 0 at hx
    rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_eq_zero_iff] at hx
    have := hSc.mono_f
    have hg : g = 0 := (cancel_mono Sc.f).mp (by rw [hx, Limits.zero_comp])
    rw [hg, Abelian.Ext.mk₀_zero]
  have L2 : ∀ (i : ℕ) (y : Abelian.Ext P Sc.X₂ i),
      (Abelian.Ext.mk₀ Sc.g).postcomp P (add_zero i) y = 0 ↔
        ∃ x, (Abelian.Ext.mk₀ Sc.f).postcomp P (add_zero i) x = y := by
    intro i y
    constructor
    · intro h
      exact Abelian.Ext.covariant_sequence_exact₂ P hSc y h
    · rintro ⟨x, rfl⟩
      show (x.comp (Abelian.Ext.mk₀ Sc.f) (add_zero i)).comp (Abelian.Ext.mk₀ Sc.g) (add_zero i) = 0
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Sc.zero, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
  have L3 : ∀ z : Abelian.Ext P Sc.X₃ 0, hSc.extClass.postcomp P (zero_add 1) z = 0 ↔
      ∃ y, (Abelian.Ext.mk₀ Sc.g).postcomp P (add_zero 0) y = z := by
    intro z
    constructor
    · intro h
      exact Abelian.Ext.covariant_sequence_exact₃ P hSc z (zero_add 1) h
    · rintro ⟨y, rfl⟩
      show (y.comp (Abelian.Ext.mk₀ Sc.g) (add_zero 0)).comp hSc.extClass (zero_add 1) = 0
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add 1) (by omega), hSc.comp_extClass,
        Abelian.Ext.comp_zero]
  have L4 : ∀ x : Abelian.Ext P Sc.X₁ 1, (Abelian.Ext.mk₀ Sc.f).postcomp P (add_zero 1) x = 0 ↔
      ∃ z, hSc.extClass.postcomp P (zero_add 1) z = x := by
    intro x
    constructor
    · intro h
      exact Abelian.Ext.covariant_sequence_exact₁ P hSc x h (zero_add 1)
    · rintro ⟨z, rfl⟩
      show (z.comp hSc.extClass (zero_add 1)).comp (Abelian.Ext.mk₀ Sc.f) (add_zero 1) = 0
      rw [Abelian.Ext.comp_assoc _ _ _ (zero_add 1) (add_zero 1) (by omega), hSc.extClass_comp,
        Abelian.Ext.comp_zero]
  have L5 : ∀ x : Abelian.Ext P Sc.X₁ 2,
      (Abelian.Ext.mk₀ Sc.f).postcomp P (add_zero 2) x = 0 → x = 0 := by
    intro x h
    obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₁ P hSc x h (show 1 + 1 = 2 from rfl)
    rw [← hz, h1 z, Abelian.Ext.zero_comp]



  have comm : ∀ (X Y : C) (a b : ℕ) {r s : ℕ} (ιM : Abelian.Ext P X a →+ (Fin r → ℚ_[ℓ]))
      (ιN : Abelian.Ext P Y b →+ (Fin s → ℚ_[ℓ])), wcRatCoord ℓ ιM →
      ∀ (φ : Abelian.Ext P X a →+ Abelian.Ext P Y b) (TM : Abelian.Ext P X a → Abelian.Ext P X a)
      (TN : Abelian.Ext P Y b → Abelian.Ext P Y b) (AM : Matrix (Fin r) (Fin r) ℚ_[ℓ])
      (AN : Matrix (Fin s) (Fin s) ℚ_[ℓ]) (B : Matrix (Fin s) (Fin r) ℚ_[ℓ]),
      (∀ x, ιN (φ x) = B.mulVec (ιM x)) → (∀ x, ιM (TM x) = AM.mulVec (ιM x)) →
      (∀ y, ιN (TN y) = AN.mulVec (ιN y)) → (∀ x, φ (TM x) = TN (φ x)) →
      B * AM = AN * B := by
    intro X Y a b r s ιM ιN hM φ TM TN AM AN B hB hTM hTN hφT
    apply s2 X a ιM hM
    intro x
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, ← hTM, ← hB, hφT, hTN, hB]
  have hF0 := hιF 0 (by norm_num)
  have hF1 := hιF 1 (by norm_num)
  have hF2 := hιF 2 (by norm_num)
  have hG0 := hιG 0 (by norm_num)
  have hG1 := hιG 1 (by norm_num)
  have hG2 := hιG 2 (by norm_num)
  obtain ⟨Ba0, hBa0⟩ := s1 Sc.X₁ Sc.X₂ 0 0 (ιF 0) (ιG 0) hF0 hG0
    ((Abelian.Ext.mk₀ Sc.f).postcomp P (add_zero 0))
  obtain ⟨Bb0, hBb0⟩ := s1 Sc.X₂ Sc.X₃ 0 0 (ιG 0) ι₀ hG0 hι₀
    ((Abelian.Ext.mk₀ Sc.g).postcomp P (add_zero 0))
  obtain ⟨Bd, hBd⟩ := s1 Sc.X₃ Sc.X₁ 0 1 ι₀ (ιF 1) hι₀ hF1
    (hSc.extClass.postcomp P (zero_add 1))
  obtain ⟨Ba1, hBa1⟩ := s1 Sc.X₁ Sc.X₂ 1 1 (ιF 1) (ιG 1) hF1 hG1
    ((Abelian.Ext.mk₀ Sc.f).postcomp P (add_zero 1))
  obtain ⟨Ba2, hBa2⟩ := s1 Sc.X₁ Sc.X₂ 2 2 (ιF 2) (ιG 2) hF2 hG2
    ((Abelian.Ext.mk₀ Sc.f).postcomp P (add_zero 2))
  have cA0 : Ba0 * AF 0 = AG 0 * Ba0 :=
    comm _ _ 0 0 (ιF 0) (ιG 0) hF0 _ _ _ (AF 0) (AG 0) Ba0 hBa0
      (hAF 0 (by norm_num)) (hAG 0 (by norm_num)) (P1 0)
  have cB0 : Bb0 * AG 0 = A₀ * Bb0 :=
    comm _ _ 0 0 (ιG 0) ι₀ hG0 _ _ _ (AG 0) A₀ Bb0 hBb0
      (hAG 0 (by norm_num)) hA₀ (P2 0)
  have cD : Bd * A₀ = AF 1 * Bd :=
    comm _ _ 0 1 ι₀ (ιF 1) hι₀ _ _ _ A₀ (AF 1) Bd hBd
      hA₀ (hAF 1 (by norm_num)) P3
  have cA1 : Ba1 * AF 1 = AG 1 * Ba1 :=
    comm _ _ 1 1 (ιF 1) (ιG 1) hF1 _ _ _ (AF 1) (AG 1) Ba1 hBa1
      (hAF 1 (by norm_num)) (hAG 1 (by norm_num)) (P1 1)
  have cA2 : Ba2 * AF 2 = AG 2 * Ba2 :=
    comm _ _ 2 2 (ιF 2) (ιG 2) hF2 _ _ _ (AF 2) (AG 2) Ba2 hBa2
      (hAF 2 (by norm_num)) (hAG 2 (by norm_num)) (P1 2)
  have inj0 := (s3 _ _ 0 0 (ιF 0) (ιG 0) hF0 hG0 _ Ba0 hBa0).1 L1
  have ex1 := s4 _ _ _ 0 0 0 (ιF 0) (ιG 0) ι₀ hF0 hG0 hι₀ _ _ (L2 0) Ba0 Bb0 hBa0 hBb0
  have ex2 := s4 _ _ _ 0 0 1 (ιG 0) ι₀ (ιF 1) hG0 hι₀ hF1 _ _ L3 Bb0 Bd hBb0 hBd
  have ex3 := s4 _ _ _ 0 1 1 ι₀ (ιF 1) (ιG 1) hι₀ hF1 hG1 _ _ L4 Bd Ba1 hBd hBa1
  have surj1 := (s3 _ _ 1 1 (ιF 1) (ιG 1) hF1 hG1 _ Ba1 hBa1).2
    (fun y => (L2 1 y).mp (h1 _))
  have inj2 := (s3 _ _ 2 2 (ιF 2) (ιG 2) hF2 hG2 _ Ba2 hBa2).1 L5
  have surj2 := (s3 _ _ 2 2 (ιF 2) (ιG 2) hF2 hG2 _ Ba2 hBa2).2
    (fun y => (L2 2 y).mp (h2 _))
  have H5 := s6 Ba0 Bb0 Bd Ba1 (AF 0) (AG 0) A₀ (AF 1) (AG 1) inj0 ex1 ex2 ex3 surj1
    cA0 cB0 cD cA1
  have H6 := s7 Ba2 (AF 2) (AG 2) inj2 surj2 cA2
  simp only [Finset.sum_range_succ, Finset.sum_range_zero]
  linear_combination H5 + H6

theorem wc_cx_homology_cohG (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (𝓗 : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) (i : ℕ) :
    ∃ θ : (wcCx K hP 𝓗).homology i ≃+ wcCohG K (wcP1Over K) hP 𝓗 i,
      ∀ (σ : 𝓗 ⟶ 𝓗) (e : ℕ) (x : (wcCx K hP 𝓗).homology i),
        θ ((HomologicalComplex.homologyMap (wcCxMap K hP σ ≫ wcCxIter (wcCxFrob K hP 𝓗) e) i).hom
            x) =
          (⇑(wcCohGFrob K (wcP1Over K) hP 𝓗 i))^[e] (wcCohGEnd K (wcP1Over K) hP 𝓗 i σ (θ x)) :=
by
  show ∃ θ : (((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
        (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj (injectiveResolution 𝓗).cocomplex).homology i ≃+
        Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) 𝓗 i,
      ∀ (σ : 𝓗 ⟶ 𝓗) (e : ℕ) (x : (((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf
          (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex
          (ComplexShape.up ℕ)).obj (injectiveResolution 𝓗).cocomplex).homology i),
        θ ((HomologicalComplex.homologyMap
          (((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
            (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex
            (ComplexShape.up ℕ)).map
              (InjectiveResolution.desc σ (injectiveResolution 𝓗) (injectiveResolution 𝓗)) ≫
           wcCxIter ((NatTrans.mapHomologicalComplex (preadditiveCoyoneda.map
            (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)).op)
            (ComplexShape.up ℕ)).app (injectiveResolution 𝓗).cocomplex) e) i).hom x) =
          (⇑((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left
              (wcGeomFrob K (wcP1Over K) hP))).precomp 𝓗 (zero_add i)))^[e]
            ((Abelian.Ext.mk₀ σ).postcomp (wcFreeSheaf (wcP1Over K).left
              (wcGeomPoint K (wcP1Over K) hP)) (add_zero i) (θ x))
  have key : ∀ (P Y : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (R : InjectiveResolution Y) (g : P ⟶ P) (n : ℕ),
      ∃ θ : (((preadditiveCoyoneda.obj (Opposite.op P)).mapHomologicalComplex
          (ComplexShape.up ℕ)).obj R.cocomplex).homology n ≃+ Abelian.Ext P Y n,
        ∀ (σ : Y ⟶ Y) (e : ℕ) (x : (((preadditiveCoyoneda.obj (Opposite.op P)).mapHomologicalComplex
          (ComplexShape.up ℕ)).obj R.cocomplex).homology n),
          θ ((HomologicalComplex.homologyMap
            (((preadditiveCoyoneda.obj (Opposite.op P)).mapHomologicalComplex
              (ComplexShape.up ℕ)).map (InjectiveResolution.desc σ R R) ≫
             wcCxIter ((NatTrans.mapHomologicalComplex (preadditiveCoyoneda.map g.op)
              (ComplexShape.up ℕ)).app R.cocomplex) e) n).hom x) =
            (⇑((Abelian.Ext.mk₀ g).precomp Y (zero_add n)))^[e]
              ((Abelian.Ext.mk₀ σ).postcomp P (add_zero n) (θ x)) := by
    intro P Y R g n
    set Kc := ((preadditiveCoyoneda.obj (Opposite.op P)).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj R.cocomplex with hKc
    let ιf : Kc.cycles n →+ (P ⟶ R.cocomplex.X n) := (Kc.iCycles n).hom
    let tc : ∀ p : ℕ, (P ⟶ R.cocomplex.X p) →+ Kc.cycles n := fun p => (Kc.toCycles p n).hom
    let πf : Kc.cycles n →+ Kc.homology n := (Kc.homologyπ n).hom
    have hιd : ∀ c, ιf c ≫ R.cocomplex.d n (n + 1) = 0 := by
      intro c
      have h := congrArg (fun φ => AddCommGrpCat.Hom.hom φ c) (Kc.iCycles_d n (n + 1))
      exact h
    have hιtc : ∀ (p : ℕ) (y : P ⟶ R.cocomplex.X p), ιf (tc p y) = y ≫ R.cocomplex.d p n := by
      intro p y
      have h := congrArg (fun φ => AddCommGrpCat.Hom.hom φ y) (Kc.toCycles_i p n)
      exact h
    have hπtc : ∀ (p : ℕ) (y : P ⟶ R.cocomplex.X p), πf (tc p y) = 0 := by
      intro p y
      have h := congrArg (fun φ => AddCommGrpCat.Hom.hom φ y) (Kc.toCycles_comp_homologyπ p n)
      exact h
    have hcongr : ∀ (f f' : P ⟶ R.cocomplex.X n) (hf : f ≫ R.cocomplex.d n (n + 1) = 0)
        (hf' : f' ≫ R.cocomplex.d n (n + 1) = 0), f = f' →
        R.extMk f (n + 1) rfl hf = R.extMk f' (n + 1) rfl hf' := by
      rintro f f' hf hf' rfl; rfl
    have hkill : ∀ (p : ℕ) (y : P ⟶ R.cocomplex.X p)
        (hy : (y ≫ R.cocomplex.d p n) ≫ R.cocomplex.d n (n + 1) = 0),
        R.extMk (y ≫ R.cocomplex.d p n) (n + 1) rfl hy = 0 := by
      intro p y hy
      by_cases h : p + 1 = n
      · exact (R.extMk_eq_zero_iff _ _ rfl hy p h).mpr ⟨y, rfl⟩
      · have h0 : R.cocomplex.d p n = 0 := R.cocomplex.shape _ _ (by simpa using h)
        have h1 : y ≫ R.cocomplex.d p n = 0 := by rw [h0, Limits.comp_zero]
        exact (hcongr _ 0 hy (by simp) h1).trans (R.extMk_zero _ _)
    have deg0 : ∀ (f : P ⟶ R.cocomplex.X 0) (hf : f ≫ R.cocomplex.d 0 1 = 0),
        R.extMk f 1 rfl hf = 0 → f = 0 := by
      intro f hf h
      have h2 := congrArg R.extEquivCohomologyClass h
      rw [R.extEquivCohomologyClass_extMk, R.extEquivCohomologyClass_zero,
        CochainComplex.HomComplex.CohomologyClass.mk_eq_zero_iff,
        CochainComplex.HomComplex.Cocycle.fromSingleMk_mem_coboundaries_iff _ _ _ _ _ (-1)
          (by norm_num)] at h2
      obtain ⟨g, hg⟩ := h2
      have hz : Limits.IsZero (R.cochainComplex.X (-1)) :=
        CochainComplex.isZero_of_isStrictlyGE R.cochainComplex 0 (-1)
      have hg0 : g = 0 := hz.eq_of_tgt _ _
      rw [hg0, Limits.zero_comp] at hg
      have e : f = (f ≫ (R.cochainComplexXIso ((0 : ℕ) : ℤ) 0 rfl).inv) ≫
          (R.cochainComplexXIso ((0 : ℕ) : ℤ) 0 rfl).hom := by simp
      rw [e, ← hg, Limits.zero_comp]
    have deg0' : ∀ (m : ℕ) (hm : m = 0) (f : P ⟶ R.cocomplex.X m)
        (hf : f ≫ R.cocomplex.d m (m + 1) = 0), R.extMk f (m + 1) rfl hf = 0 → f = 0 := by
      intro m hm
      subst hm
      exact deg0
    let α : Kc.cycles n →+ Abelian.Ext P Y n :=
      { toFun := fun c => R.extMk (ιf c) (n + 1) rfl (hιd c)
        map_zero' := (hcongr _ 0 _ (by simp) (map_zero ιf)).trans (R.extMk_zero _ _)
        map_add' := fun c d => (hcongr _ _ _ (by
            rw [Preadditive.add_comp, hιd c, hιd d, add_zero]) (map_add ιf c d)).trans
              (R.add_extMk _ _ _ _ (hιd c) (hιd d)).symm }
    have hα : ∀ c, α c = R.extMk (ιf c) (n + 1) rfl (hιd c) := fun _ => rfl
    have hπ : Function.Surjective πf :=
      (AddCommGrpCat.epi_iff_surjective _).mp inferInstance
    have hι : Function.Injective ιf :=
      (AddCommGrpCat.mono_iff_injective _).mp inferInstance
    have hexπ : (ShortComplex.mk (Kc.toCycles ((ComplexShape.up ℕ).prev n) n) (Kc.homologyπ n)
        (Kc.toCycles_comp_homologyπ _ n)).Exact :=
      ShortComplex.exact_of_g_is_cokernel _ (Kc.homologyIsCokernel _ n rfl)
    have hexι : (ShortComplex.mk (Kc.iCycles n) (Kc.d n (n + 1)) (Kc.iCycles_d _ _)).Exact :=
      ShortComplex.exact_of_f_is_kernel _ (Kc.cyclesIsKernel n (n + 1) (by simp))
    have hπex : ∀ c, πf c = 0 → ∃ y, tc ((ComplexShape.up ℕ).prev n) y = c := by
      intro c hc
      obtain ⟨y, hy⟩ := (ShortComplex.ab_exact_iff _).mp hexπ c hc
      exact ⟨y, hy⟩
    have hιex : ∀ f : P ⟶ R.cocomplex.X n, f ≫ R.cocomplex.d n (n + 1) = 0 →
        ∃ c, ιf c = f := by
      intro f hf
      obtain ⟨c, hc⟩ := (ShortComplex.ab_exact_iff _).mp hexι f hf
      exact ⟨c, hc⟩
    have hker : πf.ker ≤ α.ker := by
      intro c hc
      rw [AddMonoidHom.mem_ker] at hc ⊢
      obtain ⟨y, rfl⟩ := hπex c hc
      rw [hα]
      exact (hcongr _ _ _ (by rw [← hιtc]; exact hιd _) (hιtc _ y)).trans (hkill _ _ _)
    let θ₀ : Kc.homology n →+ Abelian.Ext P Y n :=
      πf.liftOfRightInverse (Function.surjInv hπ) (Function.rightInverse_surjInv hπ) ⟨α, hker⟩
    have hθ₀ : ∀ c, θ₀ (πf c) = α c := fun c =>
      AddMonoidHom.liftOfRightInverse_comp_apply _ _ _ _ c
    have hsurj : Function.Surjective θ₀ := by
      intro ξ
      obtain ⟨f, hf, rfl⟩ := R.extMk_surjective ξ (n + 1) rfl
      obtain ⟨c, hc⟩ := hιex f hf
      refine ⟨πf c, ?_⟩
      rw [hθ₀, hα]
      exact hcongr _ _ _ _ hc
    have hinj : Function.Injective θ₀ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨c, rfl⟩ := hπ z
      rw [hθ₀, hα] at hz
      by_cases hn : n = 0
      · have h0 := deg0' n hn _ (hιd c) hz
        have hc0 : c = 0 := hι (by rw [map_zero]; exact h0)
        rw [hc0, map_zero]
      · obtain ⟨y, hy⟩ := (R.extMk_eq_zero_iff _ (n + 1) rfl (hιd c) (n - 1) (by omega)).mp hz
        have hc : c = tc (n - 1) y := by
          apply hι
          rw [hιtc]
          exact hy.symm
        rw [hc]
        exact hπtc _ y
    let θ : Kc.homology n ≃+ Abelian.Ext P Y n := AddEquiv.ofBijective θ₀ ⟨hinj, hsurj⟩
    have hθ : ∀ c, θ (πf c) = R.extMk (ιf c) (n + 1) rfl (hιd c) := fun c => hθ₀ c
    refine ⟨θ, ?_⟩
    set Fg := (NatTrans.mapHomologicalComplex (preadditiveCoyoneda.map g.op)
      (ComplexShape.up ℕ)).app R.cocomplex with hFg
    set Mσ := fun σ : Y ⟶ Y => ((preadditiveCoyoneda.obj (Opposite.op P)).mapHomologicalComplex
      (ComplexShape.up ℕ)).map (InjectiveResolution.desc σ R R) with hMσ
    have hF : ∀ x, θ ((HomologicalComplex.homologyMap Fg n).hom x) =
        (Abelian.Ext.mk₀ g).precomp Y (zero_add n) (θ x) := by
      intro x
      obtain ⟨c, rfl⟩ := hπ x
      have h1 : (HomologicalComplex.homologyMap Fg n).hom (πf c) =
          πf ((HomologicalComplex.cyclesMap Fg n).hom c) := by
        have h := congrArg (fun φ => AddCommGrpCat.Hom.hom φ c)
          (HomologicalComplex.homologyπ_naturality Fg n)
        exact h
      have h2 : ιf ((HomologicalComplex.cyclesMap Fg n).hom c) = g ≫ ιf c := by
        have h := congrArg (fun φ => AddCommGrpCat.Hom.hom φ c)
          (HomologicalComplex.cyclesMap_i Fg n)
        exact h
      rw [h1, hθ, hθ]
      refine (hcongr _ _ _ (by rw [Category.assoc, hιd, Limits.comp_zero]) h2).trans ?_
      rw [← R.mk₀_comp_extMk]
      rfl
    have hM : ∀ (σ : Y ⟶ Y) x, θ ((HomologicalComplex.homologyMap (Mσ σ) n).hom x) =
        (Abelian.Ext.mk₀ σ).postcomp P (add_zero n) (θ x) := by
      intro σ x
      obtain ⟨c, rfl⟩ := hπ x
      let ψ : R.Hom R σ := InjectiveResolution.Hom.mk (InjectiveResolution.desc σ R R)
        (by
          rw [CochainComplex.single₀_map_f_zero]
          exact InjectiveResolution.desc_commutes_zero σ R R)
      have h1 : (HomologicalComplex.homologyMap (Mσ σ) n).hom (πf c) =
          πf ((HomologicalComplex.cyclesMap (Mσ σ) n).hom c) := by
        have h := congrArg (fun φ => AddCommGrpCat.Hom.hom φ c)
          (HomologicalComplex.homologyπ_naturality (Mσ σ) n)
        exact h
      have h2 : ιf ((HomologicalComplex.cyclesMap (Mσ σ) n).hom c) =
          ιf c ≫ ψ.hom.f n := by
        have h := congrArg (fun φ => AddCommGrpCat.Hom.hom φ c)
          (HomologicalComplex.cyclesMap_i (Mσ σ) n)
        exact h
      rw [h1, hθ, hθ]
      refine (hcongr _ _ _ (by rw [Category.assoc, ψ.hom.comm, ← Category.assoc, hιd,
        Limits.zero_comp]) h2).trans ?_
      rw [← InjectiveResolution.extMk_comp_mk₀ _ _ _ _ ψ]
      rfl
    have hIter : ∀ e x, θ ((HomologicalComplex.homologyMap (wcCxIter Fg e) n).hom x) =
        (⇑((Abelian.Ext.mk₀ g).precomp Y (zero_add n)))^[e] (θ x) := by
      intro e
      induction e with
      | zero =>
        intro x
        simp only [wcCxIter, HomologicalComplex.homologyMap_id]
        rfl
      | succ e ih =>
        intro x
        simp only [wcCxIter, HomologicalComplex.homologyMap_comp]
        rw [Function.iterate_succ_apply', ← ih, ← hF]
        rfl
    intro σ e x
    rw [HomologicalComplex.homologyMap_comp]
    show θ ((HomologicalComplex.homologyMap (wcCxIter Fg e) n).hom
      ((HomologicalComplex.homologyMap (Mσ σ) n).hom x)) = _
    rw [hIter, hM]
  exact key _ _ (injectiveResolution 𝓗)
    (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)) i

theorem wc_cc_fromNormalization_finite (K : Type u) [Field K] (Uo : (wcP1Over K).left.Opens)
    (V : Scheme.{u}) (q' : V ⟶ Uo.toScheme) (hfin : IsFinite q') (het : Etale q')
    [QuasiCompact (q' ≫ Uo.ι)] [QuasiSeparated (q' ≫ Uo.ι)] :
    IsFinite (q' ≫ Uo.ι).fromNormalization :=
by
  classical
  haveI := hfin
  haveI := het
  apply wc_fnf_fromNormalization_finite_of_local (q' ≫ Uo.ι)
  intro y
  have hY : (⨆ j : Fin (1 + 1), Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (MvPolynomial.X j)) = ⊤ := by
    apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
    intro a ha
    have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
    have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
      rw [← MvPolynomial.decomposition.decompose'_apply]
      exact ha'
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) h0
    obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨l, Set.mem_univ _, hl⟩
  have hx : y ∈ (⨆ j : Fin (1 + 1), Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (MvPolynomial.X j)) := by
    rw [hY]; trivial
  obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  obtain ⟨χ, -⟩ := wc_projK_one_affine_chart K a
  set U : (wcP1Over K).left.Opens := Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X a) with hUdef
  have hyU : y ∈ U := ha
  let φ : U.toScheme ≅ Spec (.of (Polynomial K)) := χ
  have hU : IsAffineOpen U := by
    haveI : IsAffine U.toScheme := IsAffine.of_isIso φ.hom
    exact this
  let eR : Γ((wcP1Over K).left, U) ≃+* Polynomial K :=
    (U.topIso.symm ≪≫ (Scheme.Γ.mapIso φ.op).symm ≪≫
      Scheme.ΓSpecIso (.of (Polynomial K))).commRingCatIsoToRingEquiv
  haveI : IsDomain Γ((wcP1Over K).left, U) :=
    MulEquiv.isDomain _ eR.toMulEquiv
  haveI : IsPrincipalIdealRing Γ((wcP1Over K).left, U) :=
    IsPrincipalIdealRing.of_surjective eR.symm eR.symm.surjective
  have hclosed : IsClosed ((hU.fromSpec ⁻¹ᵁ Uo :
      Set (Spec Γ((wcP1Over K).left, U))))ᶜ :=
    (hU.fromSpec ⁻¹ᵁ Uo).isOpen.isClosed_compl
  obtain ⟨I, hI⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal
    (R := Γ((wcP1Over K).left, U))
    ((hU.fromSpec ⁻¹ᵁ Uo : Set (Spec Γ((wcP1Over K).left, U))))ᶜ).mp
    hclosed
  set g := Submodule.IsPrincipal.generator I with hgdef
  have hT : hU.fromSpec ⁻¹ᵁ Uo = PrimeSpectrum.basicOpen g := by
    apply TopologicalSpace.Opens.ext
    have h1 : (PrimeSpectrum.basicOpen g :
        Set (PrimeSpectrum Γ((wcP1Over K).left, U))) =
        (PrimeSpectrum.zeroLocus {g})ᶜ := PrimeSpectrum.basicOpen_eq_zeroLocus_compl g
    have h2 : PrimeSpectrum.zeroLocus
        ({g} : Set Γ((wcP1Over K).left, U)) =
        PrimeSpectrum.zeroLocus (I : Set Γ((wcP1Over K).left, U)) := by
      rw [← PrimeSpectrum.zeroLocus_span, hgdef, Ideal.span_singleton_generator]
    have key : ((hU.fromSpec ⁻¹ᵁ Uo : Set (Spec Γ((wcP1Over K).left, U))) :
        Set (PrimeSpectrum Γ((wcP1Over K).left, U))) =
        (PrimeSpectrum.basicOpen g :
          Set (PrimeSpectrum Γ((wcP1Over K).left, U))) := by
      rw [h1, h2]
      exact (compl_compl _).symm.trans (congrArg (fun s => sᶜ) hI)
    exact key
  have hUUo : U ⊓ Uo = (wcP1Over K).left.basicOpen g := by
    have h1 := hU.fromSpec_image_basicOpen g
    rw [← hT, Scheme.Hom.image_preimage_eq_opensRange_inf, hU.opensRange_fromSpec] at h1
    exact h1
  set V' : Uo.toScheme.Opens := Uo.ι ⁻¹ᵁ U with hV'def
  have hV : Uo.ι ''ᵁ V' = (wcP1Over K).left.basicOpen g := by
    rw [hV'def, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι,
      inf_comm, hUUo]
  have hle : Uo.ι ''ᵁ V' ≤ U := by
    rw [hV]; exact Scheme.basicOpen_le _ _
  have hV'aff : IsAffineOpen V' :=
    (Uo.ι.isAffineOpen_iff_of_isOpenImmersion).mp (hV ▸ hU.basicOpen g)
  have hpre : IsAffineOpen (q' ⁻¹ᵁ V') := hV'aff.preimage q'
  letI algRT : Algebra Γ((wcP1Over K).left, U)
      Γ((wcP1Over K).left, Uo.ι ''ᵁ V') :=
    ((wcP1Over K).left.presheaf.map (homOfLE hle).op).hom.toAlgebra
  haveI hloc : IsLocalization.Away g Γ((wcP1Over K).left, Uo.ι ''ᵁ V') :=
    hU.isLocalization_of_eq_basicOpen g (homOfLE hle) hV
  letI algTB : Algebra Γ((wcP1Over K).left, Uo.ι ''ᵁ V')
      Γ(V, (q' ≫ Uo.ι) ⁻¹ᵁ U) := (q'.app V').hom.toAlgebra
  letI algRB : Algebra Γ((wcP1Over K).left, U)
      Γ(V, (q' ≫ Uo.ι) ⁻¹ᵁ U) := ((q' ≫ Uo.ι).app U).hom.toAlgebra
  haveI : IsScalarTower Γ((wcP1Over K).left, U)
      Γ((wcP1Over K).left, Uo.ι ''ᵁ V') Γ(V, (q' ≫ Uo.ι) ⁻¹ᵁ U) := by
    apply IsScalarTower.of_algebraMap_eq'
    show ((q' ≫ Uo.ι).app U).hom = (q'.app V').hom.comp
      ((wcP1Over K).left.presheaf.map (homOfLE hle).op).hom
    rw [Scheme.Hom.comp_app, Scheme.Opens.ι_app]
    rfl
  have hEt0 := HasRingHomProperty.appLE (P := @Etale) q' het ⟨V', hV'aff⟩ ⟨q' ⁻¹ᵁ V', hpre⟩ le_rfl
  rw [← Scheme.Hom.app_eq_appLE] at hEt0
  haveI : Algebra.Etale Γ((wcP1Over K).left, Uo.ι ''ᵁ V')
      Γ(V, (q' ≫ Uo.ι) ⁻¹ᵁ U) := hEt0
  refine ⟨U, hU, hyU, ?_⟩
  exact wc_fnf_integralClosure_finite_of_etale_localization
    Γ((wcP1Over K).left, U)
    Γ((wcP1Over K).left, Uo.ι ''ᵁ V') (Submonoid.powers g)
    Γ(V, (q' ≫ Uo.ι) ⁻¹ᵁ U)
    (fun A _ _ _ _ _ => wc_fnf_integralClosure_finite_of_etale_field
      Γ((wcP1Over K).left, U)
      (FractionRing Γ((wcP1Over K).left, U)) A)

theorem wc_cc_normalization_closed_stalk_regular (K : Type u) [Field K]
    (Uo : (wcP1Over K).left.Opens) (V : Scheme.{u}) (q' : V ⟶ Uo.toScheme)
    (hfin : IsFinite q') (het : Etale q') [QuasiCompact (q' ≫ Uo.ι)] [QuasiSeparated (q' ≫ Uo.ι)]
    (z : ↥(q' ≫ Uo.ι).normalization) (hz : IsClosed ({z} : Set ↥(q' ≫ Uo.ι).normalization)) :
    IsRegularLocalRing ((q' ≫ Uo.ι).normalization.presheaf.stalk z) ∧
      ringKrullDim ((q' ≫ Uo.ι).normalization.presheaf.stalk z) = ((1 : ℕ) : WithBot ℕ∞) :=
by
  classical
  haveI := hfin
  haveI := het

  have s6 : ∀ (A A' : Type u) [CommRing A] [CommRing A'] (e : A ≃+* A') (𝔪 : Ideal A)
      [𝔪.IsMaximal],
      (IsRegularLocalRing (Localization.AtPrime (𝔪.map e)) ∧
        ringKrullDim (Localization.AtPrime (𝔪.map e)) = ((1 : ℕ) : WithBot ℕ∞)) →
      IsRegularLocalRing (Localization.AtPrime 𝔪) ∧
        ringKrullDim (Localization.AtPrime 𝔪) = ((1 : ℕ) : WithBot ℕ∞) := by
    intro A A' _ _ e 𝔪 _ h
    have hS : Submonoid.map (e : A →* A') 𝔪.primeCompl = (𝔪.map e).primeCompl := by
      ext x
      simp only [Submonoid.mem_map, Ideal.primeCompl, Submonoid.mem_mk, Subsemigroup.mem_mk,
        Set.mem_compl_iff, SetLike.mem_coe]
      rw [Ideal.mem_map_of_equiv]
      constructor
      · rintro ⟨a, ha, rfl⟩ ⟨b, hb, hba⟩
        exact ha (by rw [← e.injective hba]; exact hb)
      · intro hx
        refine ⟨e.symm x, fun h => hx ⟨e.symm x, h, by simp⟩, by simp⟩
    let φ := IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime 𝔪)
      (Localization.AtPrime (𝔪.map e)) e hS
    have := h.1
    exact ⟨IsRegularLocalRing.of_ringEquiv φ.symm, (ringKrullDim_eq_of_ringEquiv φ).trans h.2⟩

  have F1 : ∀ (I : Type u) [Finite I] (D : I → Type u) [∀ i, CommRing (D i)]
      [∀ i, IsDedekindDomain (D i)], (∀ i, ¬ IsField (D i)) →
      ∀ (𝔪 : Ideal (∀ i, D i)) [𝔪.IsMaximal],
      IsRegularLocalRing (Localization.AtPrime 𝔪) ∧
        ringKrullDim (Localization.AtPrime 𝔪) = ((1 : ℕ) : WithBot ℕ∞) := by
    intro I _ D _ _ hD 𝔪 _
    haveI := Fintype.ofFinite I
    have hex : ∃ i, (Pi.single i 1 : ∀ j, D j) ∉ 𝔪 := by
      by_contra hcon
      push_neg at hcon
      apply (Ideal.IsMaximal.ne_top ‹_›)
      rw [Ideal.eq_top_iff_one, ← Finset.univ_sum_single (1 : ∀ j, D j)]
      exact Ideal.sum_mem _ (fun i _ => hcon i)
    obtain ⟨i, hi⟩ := hex
    set ei : ∀ j, D j := Pi.single i 1 with hei
    have hid : IsIdempotentElem ei := by
      rw [IsIdempotentElem, hei, ← Pi.single_mul, mul_one]
    have h1e : 1 - ei ∈ 𝔪 := by
      have : ei * (1 - ei) ∈ 𝔪 := by
        rw [mul_sub, mul_one, hid.eq, sub_self]; exact 𝔪.zero_mem
      exact ((Ideal.IsMaximal.isPrime ‹_›).mem_or_mem this).resolve_left hi
    let π : (∀ j, D j) →+* D i := Pi.evalRingHom D i
    have hπ : Function.Surjective π := fun x => ⟨Pi.single i x, by simp [π]⟩
    have hker : RingHom.ker π = Ideal.span {1 - ei} := RingHom.ker_evalRingHom D i
    have hkle : RingHom.ker π ≤ 𝔪 := by
      rw [hker, Ideal.span_le, Set.singleton_subset_iff]; exact h1e
    have hcomap : (𝔪.map π).comap π = 𝔪 := by
      rw [Ideal.comap_map_of_surjective π hπ, ← RingHom.ker_eq_comap_bot]
      exact sup_eq_left.mpr hkle
    haveI h𝔫 : (𝔪.map π).IsMaximal := by
      rcases Ideal.map_eq_top_or_isMaximal_of_surjective π hπ (‹𝔪.IsMaximal›) with h | h
      · exfalso
        apply (‹𝔪.IsMaximal›).ne_top
        rw [← hcomap, h, Ideal.comap_top]
      · exact h
    letI : Algebra (∀ j, D j) (D i) := π.toAlgebra
    haveI : IsLocalization.Away ei (D i) := IsLocalization.away_of_isIdempotentElem hid hker hπ
    haveI hl2 : IsLocalization
        (Submonoid.comap (algebraMap (∀ j, D j) (D i)) (𝔪.map π).primeCompl)
        (Localization.AtPrime (𝔪.map π)) :=
      IsLocalization.localization_localization_isLocalization_of_has_all_units
        (Submonoid.powers ei) (𝔪.map π).primeCompl (Localization.AtPrime (𝔪.map π))
        (fun x hx hx𝔫 => h𝔫.ne_top (Ideal.eq_top_of_isUnit_mem _ hx𝔫 hx))
    have hsub : Submonoid.comap (algebraMap (∀ j, D j) (D i)) (𝔪.map π).primeCompl =
        𝔪.primeCompl := by
      ext x
      show π x ∉ 𝔪.map π ↔ x ∉ 𝔪
      rw [← Ideal.mem_comap, hcomap]
    rw [hsub] at hl2
    let φ := IsLocalization.algEquiv 𝔪.primeCompl (Localization.AtPrime 𝔪)
      (Localization.AtPrime (𝔪.map π))
    haveI : IsDomain (Localization.AtPrime (𝔪.map π)) :=
      IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors (𝔪.map π))
    haveI : IsDiscreteValuationRing (Localization.AtPrime (𝔪.map π)) :=
      IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain (D i)
        (Ring.ne_bot_of_isMaximal_of_not_isField h𝔫 (hD i)) _
    refine ⟨IsRegularLocalRing.of_ringEquiv φ.symm.toRingEquiv, ?_⟩
    rw [ringKrullDim_eq_of_ringEquiv φ.toRingEquiv,
      IsDiscreteValuationRing.ringKrullDim_eq_one, Nat.cast_one]

  have F2 : ∀ (R : Type u) [CommRing R] (I : Type u) [Fintype I] (A : I → Type u)
      [∀ i, CommRing (A i)] [∀ i, Algebra R (A i)],
      Nonempty (integralClosure R (∀ i, A i) ≃+* (∀ i, integralClosure R (A i))) := by
    intro R _ I _ A _ _
    exact ⟨
    { toFun := fun x i => ⟨x.1 i, x.2.map (Pi.evalAlgHom R A i)⟩
      invFun := fun y => ⟨fun i => (y i).1, by
        choose p hp hpy using fun i => (y i).2
        refine ⟨∏ i, p i, Polynomial.monic_prod_of_monic _ _ (fun i _ => hp i), ?_⟩
        rw [← Polynomial.aeval_def, map_prod]
        funext i
        rw [Finset.prod_apply, Pi.zero_apply]
        apply Finset.prod_eq_zero (Finset.mem_univ i)
        have h := Polynomial.aeval_algHom_apply (Pi.evalAlgHom R A i) (fun j => (y j).1) (p i)
        simp only [Pi.evalAlgHom_apply] at h
        rw [← h, Polynomial.aeval_def]
        exact hpy i⟩
      left_inv := fun x => rfl
      right_inv := fun y => rfl
      map_mul' := fun x y => rfl
      map_add' := fun x y => rfl }⟩

  have s4 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] (B : Type u)
      [CommRing B] [Algebra R B] [Algebra.Etale R B],
      Nonempty (integralClosure R B ≃+*
        integralClosure R (TensorProduct R (FractionRing R) B)) := by
    intro R _ _ _ B _ _ _
    have G2loc : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] (f0 : R →+* A)
        (x : A) (s : R) (p : Polynomial R), p.Monic → f0 s ≠ 0 →
        Polynomial.eval₂ f0 x (p.scaleRoots s) = 0 → ∃ c, x = f0 s * c := by
      intro A _ _ _ f0 x s p hp hs hx
      set g := algebraMap A (FractionRing A) with hg
      have hginj : Function.Injective g := IsFractionRing.injective A (FractionRing A)
      have hτ : g (f0 s) ≠ 0 := fun h => hs (hginj (h.trans (map_zero g).symm))
      set w := g x / g (f0 s) with hw
      have hgx : g x = (g.comp f0) s * w := by
        rw [RingHom.comp_apply, hw, mul_div_cancel₀ _ hτ]
      have h1 : Polynomial.eval₂ (g.comp f0) (g x) (p.scaleRoots s) = 0 := by
        rw [← Polynomial.hom_eval₂, hx, map_zero]
      rw [hgx, Polynomial.scaleRoots_eval₂_mul] at h1
      have h2 : Polynomial.eval₂ (g.comp f0) w p = 0 := by
        rcases mul_eq_zero.mp h1 with h | h
        · exact absurd (pow_eq_zero_iff'.mp h).1 hτ
        · exact h
      have hint : IsIntegral A w := by
        refine ⟨p.map f0, hp.map f0, ?_⟩
        rw [Polynomial.eval₂_map]
        exact h2
      obtain ⟨c, hc⟩ := (IsIntegrallyClosed.isIntegral_iff (K := FractionRing A)).mp hint
      refine ⟨c, hginj ?_⟩
      rw [map_mul, hc, hgx, RingHom.comp_apply]
    have G2 : ∀ (s : R), s ≠ 0 → ∀ (b : B) (p : Polynomial R), p.Monic →
        Polynomial.aeval b (p.scaleRoots s) = 0 → b ∈ Ideal.span {algebraMap R B s} := by
      intro s hs b p hp hb
      have hreg : IsSMulRegular B s :=
        Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hs)
      apply Ideal.mem_of_localization_maximal
      intro P hP
      obtain ⟨hdom, hic⟩ := wc_pks_etale_localization_normal R B P
      rw [Ideal.map_span, Set.image_singleton, Ideal.mem_span_singleton']
      have hne : ((algebraMap B (Localization.AtPrime P)).comp (algebraMap R B)) s ≠ 0 := by
        intro h0
        rw [RingHom.comp_apply, IsLocalization.map_eq_zero_iff P.primeCompl] at h0
        obtain ⟨⟨m, hm⟩, hm0⟩ := h0
        have : m = 0 := by
          apply hreg
          simp only [smul_zero]
          rw [Algebra.smul_def, mul_comm]
          exact hm0
        exact hm (this ▸ P.zero_mem)
      obtain ⟨c, hc⟩ := G2loc (Localization.AtPrime P)
        ((algebraMap B (Localization.AtPrime P)).comp (algebraMap R B))
        (algebraMap B (Localization.AtPrime P) b) s p hp hne (by
          rw [← Polynomial.hom_eval₂, ← Polynomial.aeval_def, hb, map_zero])
      exact ⟨c, by rw [hc, RingHom.comp_apply, mul_comm]⟩
    set K₀ := FractionRing R with hK₀
    set L := TensorProduct R K₀ B with hL
    let ι : B →ₐ[R] L := Algebra.TensorProduct.includeRight
    have hι : Function.Injective ι :=
      Algebra.TensorProduct.includeRight_injective (IsFractionRing.injective R K₀)
    have hcomm : ∀ (r : R) (b : B), algebraMap R L r * ι b = ι (algebraMap R B r * b) := by
      intro r b
      rw [map_mul, AlgHom.commutes]
    have hden : ∀ y : L, ∃ s : R, s ≠ 0 ∧ ∃ b : B, algebraMap R L s * y = ι b := by
      intro y
      induction y using TensorProduct.induction_on with
      | zero => exact ⟨1, one_ne_zero, 0, by simp⟩
      | tmul k b' =>
        obtain ⟨a, d, hd, rfl⟩ := IsFractionRing.div_surjective R k
        have hd0 : d ≠ 0 := nonZeroDivisors.ne_zero hd
        have hdK : algebraMap R K₀ d ≠ 0 := fun h =>
          hd0 (IsFractionRing.injective R K₀ (h.trans (map_zero _).symm))
        refine ⟨d, hd0, a • b', ?_⟩
        rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul, one_mul,
          mul_div_cancel₀ _ hdK, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
        rfl
      | add y₁ y₂ h₁ h₂ =>
        obtain ⟨s₁, hs₁, b₁, hb₁⟩ := h₁
        obtain ⟨s₂, hs₂, b₂, hb₂⟩ := h₂
        refine ⟨s₁ * s₂, mul_ne_zero hs₁ hs₂,
          algebraMap R B s₂ * b₁ + algebraMap R B s₁ * b₂, ?_⟩
        rw [map_add, ← hcomm, ← hcomm, ← hb₁, ← hb₂, map_mul]
        ring
    let φ : integralClosure R B →ₐ[R] integralClosure R L :=
      (ι.comp (integralClosure R B).val).codRestrict (integralClosure R L)
        (fun x => x.2.map ι)
    have hφinj : Function.Injective φ := by
      intro x y hxy
      apply Subtype.ext
      apply hι
      exact congrArg Subtype.val hxy
    have hφsurj : Function.Surjective φ := by
      rintro ⟨y, p, hp, hpy⟩
      obtain ⟨s, hs, b, hb⟩ := hden y
      have h1 : Polynomial.aeval (algebraMap R L s * y) (p.scaleRoots s) = 0 :=
        Polynomial.scaleRoots_aeval_eq_zero (by rw [Polynomial.aeval_def]; exact hpy)
      rw [hb, Polynomial.aeval_algHom_apply] at h1
      have h2 : Polynomial.aeval b (p.scaleRoots s) = 0 := hι (h1.trans (map_zero ι).symm)
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (G2 s hs b p hp h2)
      have hu : IsUnit (algebraMap R L s) := by
        rw [IsScalarTower.algebraMap_apply R K₀ L]
        apply IsUnit.map
        apply Ne.isUnit
        exact fun h => hs (IsFractionRing.injective R K₀ (h.trans (map_zero _).symm))
      have hyc : y = ι c := by
        apply hu.mul_left_cancel
        rw [hb, ← hc, mul_comm c, ← hcomm]
      have hcint : IsIntegral R c := by
        rw [← isIntegral_algHom_iff ι hι, ← hyc]
        exact ⟨p, hp, hpy⟩
      exact ⟨⟨c, hcint⟩, Subtype.ext hyc.symm⟩
    exact ⟨(AlgEquiv.ofBijective φ ⟨hφinj, hφsurj⟩).toRingEquiv⟩

  have s5 : ∀ (R : Type u) [CommRing R] [IsDedekindDomain R], ¬ IsField R →
      ∀ (L : Type u) [CommRing L] [Algebra (FractionRing R) L] [Algebra R L]
        [IsScalarTower R (FractionRing R) L] [Algebra.Etale (FractionRing R) L]
        (C : Type u) [CommRing C] (e₀ : C ≃+* integralClosure R L)
        (𝔪 : Ideal C) [𝔪.IsMaximal],
      IsRegularLocalRing (Localization.AtPrime 𝔪) ∧
        ringKrullDim (Localization.AtPrime 𝔪) = ((1 : ℕ) : WithBot ℕ∞) := by
    intro R _ _ hR L _ _ _ _ _ C _ e₀ 𝔪 _
    obtain ⟨I, hI, A, hAf, hAa, e, hA⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod (FractionRing R) L).mp ‹_›
    haveI := Fintype.ofFinite I
    letI hAR : ∀ i, Algebra R (A i) := fun i =>
      ((algebraMap (FractionRing R) (A i)).comp (algebraMap R (FractionRing R))).toAlgebra
    haveI hAT : ∀ i, IsScalarTower R (FractionRing R) (A i) := fun i =>
      IsScalarTower.of_algebraMap_eq' rfl
    haveI hAfin : ∀ i, FiniteDimensional (FractionRing R) (A i) := fun i => (hA i).1
    haveI hAsep : ∀ i, Algebra.IsSeparable (FractionRing R) (A i) := fun i => (hA i).2
    haveI hDed : ∀ i, IsDedekindDomain (integralClosure R (A i)) := fun i =>
      integralClosure.isDedekindDomain R (FractionRing R) (A i)
    have hnf : ∀ i, ¬ IsField (integralClosure R (A i)) := by
      intro i h
      apply hR
      have hinj : Function.Injective (algebraMap R (integralClosure R (A i))) := by
        intro a b hab
        have h1 : algebraMap (FractionRing R) (A i) (algebraMap R (FractionRing R) a) =
            algebraMap (FractionRing R) (A i) (algebraMap R (FractionRing R) b) :=
          congrArg Subtype.val hab
        exact IsFractionRing.injective R (FractionRing R)
          ((algebraMap (FractionRing R) (A i)).injective h1)
      exact (Algebra.IsIntegral.isField_iff_isField hinj).mpr h
    let ε₁ : integralClosure R L ≃+* integralClosure R (∀ i, A i) :=
      (AlgEquiv.mapIntegralClosure (e.restrictScalars R)).toRingEquiv
    obtain ⟨ε₂⟩ := F2 R I A
    let ε : C ≃+* ∀ i, integralClosure R (A i) := e₀.trans (ε₁.trans ε₂)
    haveI : (𝔪.map ε).IsMaximal := Ideal.map_isMaximal_of_equiv ε
    exact s6 _ _ ε 𝔪 (F1 I (fun i => integralClosure R (A i)) hnf (𝔪.map ε))

  have gen : ∀ (Z : Scheme.{u}) (W : Z.Opens) (hW : IsAffineOpen W) (zW : W),
      IsClosed ({(zW : Z)} : Set Z) →
      (∀ (𝔭 : Ideal Γ(Z, W)) [𝔭.IsMaximal], IsRegularLocalRing (Localization.AtPrime 𝔭) ∧
          ringKrullDim (Localization.AtPrime 𝔭) = ((1 : ℕ) : WithBot ℕ∞)) →
      IsRegularLocalRing (Z.presheaf.stalk zW) ∧
        ringKrullDim (Z.presheaf.stalk zW) = ((1 : ℕ) : WithBot ℕ∞) := by
    intro Z W hW zW hzc HW
    haveI hloc := hW.isLocalization_stalk zW
    have hmax : (hW.primeIdealOf zW).asIdeal.IsMaximal := by
      haveI := hW.isOpenImmersion_fromSpec
      have hinj : Function.Injective hW.fromSpec := hW.fromSpec.isOpenEmbedding.injective
      have hpre : hW.fromSpec ⁻¹' {(zW : Z)} = {hW.primeIdealOf zW} := by
        ext p
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        constructor
        · intro hp
          apply hinj
          rw [hp, hW.fromSpec_primeIdealOf]
        · rintro rfl
          rw [hW.fromSpec_primeIdealOf]
      have hcl : IsClosed ({hW.primeIdealOf zW} : Set (Spec Γ(Z, W))) := by
        rw [← hpre]
        exact hzc.preimage hW.fromSpec.continuous
      exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp hcl
    have h1 := HW (hW.primeIdealOf zW).asIdeal
    let φ₁ := IsLocalization.algEquiv (hW.primeIdealOf zW).asIdeal.primeCompl
      (Z.presheaf.stalk zW) (Localization.AtPrime (hW.primeIdealOf zW).asIdeal)
    have := h1.1
    exact ⟨IsRegularLocalRing.of_ringEquiv φ₁.symm.toRingEquiv,
      (ringKrullDim_eq_of_ringEquiv φ₁.toRingEquiv).trans h1.2⟩

  have hY : (⨆ j : Fin (1 + 1), Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (MvPolynomial.X j)) = ⊤ := by
    apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
    intro a ha
    have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
    have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
      rw [← MvPolynomial.decomposition.decompose'_apply]
      exact ha'
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) h0
    obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨l, Set.mem_univ _, hl⟩
  have hx : (q' ≫ Uo.ι).fromNormalization z ∈ (⨆ j : Fin (1 + 1), Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (MvPolynomial.X j)) := by
    rw [hY]; trivial
  obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  obtain ⟨χ, -⟩ := wc_projK_one_affine_chart K a
  set U : (wcP1Over K).left.Opens := Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X a) with hUdef
  have hyU : (q' ≫ Uo.ι).fromNormalization z ∈ U := ha
  let φ : U.toScheme ≅ Spec (.of (Polynomial K)) := χ
  have hU : IsAffineOpen U := by
    haveI : IsAffine U.toScheme := IsAffine.of_isIso φ.hom
    exact this
  let eR : Γ((wcP1Over K).left, U) ≃+* Polynomial K :=
    (U.topIso.symm ≪≫ (Scheme.Γ.mapIso φ.op).symm ≪≫
      Scheme.ΓSpecIso (.of (Polynomial K))).commRingCatIsoToRingEquiv
  haveI : IsDomain Γ((wcP1Over K).left, U) :=
    MulEquiv.isDomain _ eR.toMulEquiv
  haveI : IsPrincipalIdealRing Γ((wcP1Over K).left, U) :=
    IsPrincipalIdealRing.of_surjective eR.symm eR.symm.surjective
  have hnfR : ¬ IsField Γ((wcP1Over K).left, U) := fun h =>
    Polynomial.not_isField K (MulEquiv.isField h eR.symm.toMulEquiv)
  have hclosed : IsClosed ((hU.fromSpec ⁻¹ᵁ Uo :
      Set (Spec Γ((wcP1Over K).left, U))))ᶜ :=
    (hU.fromSpec ⁻¹ᵁ Uo).isOpen.isClosed_compl
  obtain ⟨I, hI⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal
    (R := Γ((wcP1Over K).left, U))
    ((hU.fromSpec ⁻¹ᵁ Uo : Set (Spec Γ((wcP1Over K).left, U))))ᶜ).mp
    hclosed
  set g := Submodule.IsPrincipal.generator I with hgdef
  have hT : hU.fromSpec ⁻¹ᵁ Uo = PrimeSpectrum.basicOpen g := by
    apply TopologicalSpace.Opens.ext
    have h1 : (PrimeSpectrum.basicOpen g :
        Set (PrimeSpectrum Γ((wcP1Over K).left, U))) =
        (PrimeSpectrum.zeroLocus {g})ᶜ := PrimeSpectrum.basicOpen_eq_zeroLocus_compl g
    have h2 : PrimeSpectrum.zeroLocus
        ({g} : Set Γ((wcP1Over K).left, U)) =
        PrimeSpectrum.zeroLocus (I : Set Γ((wcP1Over K).left, U)) := by
      rw [← PrimeSpectrum.zeroLocus_span, hgdef, Ideal.span_singleton_generator]
    have key : ((hU.fromSpec ⁻¹ᵁ Uo : Set (Spec Γ((wcP1Over K).left, U))) :
        Set (PrimeSpectrum Γ((wcP1Over K).left, U))) =
        (PrimeSpectrum.basicOpen g :
          Set (PrimeSpectrum Γ((wcP1Over K).left, U))) := by
      rw [h1, h2]
      exact (compl_compl _).symm.trans (congrArg (fun s => sᶜ) hI)
    exact key
  have hUUo : U ⊓ Uo = (wcP1Over K).left.basicOpen g := by
    have h1 := hU.fromSpec_image_basicOpen g
    rw [← hT, Scheme.Hom.image_preimage_eq_opensRange_inf, hU.opensRange_fromSpec] at h1
    exact h1
  set V' : Uo.toScheme.Opens := Uo.ι ⁻¹ᵁ U with hV'def
  have hV : Uo.ι ''ᵁ V' = (wcP1Over K).left.basicOpen g := by
    rw [hV'def, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι,
      inf_comm, hUUo]
  have hle : Uo.ι ''ᵁ V' ≤ U := by
    rw [hV]; exact Scheme.basicOpen_le _ _
  have hV'aff : IsAffineOpen V' :=
    (Uo.ι.isAffineOpen_iff_of_isOpenImmersion).mp (hV ▸ hU.basicOpen g)
  have hpre : IsAffineOpen (q' ⁻¹ᵁ V') := hV'aff.preimage q'
  letI algRT : Algebra Γ((wcP1Over K).left, U)
      Γ((wcP1Over K).left, Uo.ι ''ᵁ V') :=
    ((wcP1Over K).left.presheaf.map (homOfLE hle).op).hom.toAlgebra
  haveI hloc : IsLocalization.Away g Γ((wcP1Over K).left, Uo.ι ''ᵁ V') :=
    hU.isLocalization_of_eq_basicOpen g (homOfLE hle) hV
  letI algTB : Algebra Γ((wcP1Over K).left, Uo.ι ''ᵁ V')
      Γ(V, (q' ≫ Uo.ι) ⁻¹ᵁ U) := (q'.app V').hom.toAlgebra
  letI algRB : Algebra Γ((wcP1Over K).left, U)
      Γ(V, (q' ≫ Uo.ι) ⁻¹ᵁ U) := ((q' ≫ Uo.ι).app U).hom.toAlgebra
  haveI : IsScalarTower Γ((wcP1Over K).left, U)
      Γ((wcP1Over K).left, Uo.ι ''ᵁ V') Γ(V, (q' ≫ Uo.ι) ⁻¹ᵁ U) := by
    apply IsScalarTower.of_algebraMap_eq'
    show ((q' ≫ Uo.ι).app U).hom = (q'.app V').hom.comp
      ((wcP1Over K).left.presheaf.map (homOfLE hle).op).hom
    rw [Scheme.Hom.comp_app, Scheme.Opens.ι_app]
    rfl
  have hEt0 := HasRingHomProperty.appLE (P := @Etale) q' het ⟨V', hV'aff⟩ ⟨q' ⁻¹ᵁ V', hpre⟩ le_rfl
  rw [← Scheme.Hom.app_eq_appLE] at hEt0
  haveI : Algebra.Etale Γ((wcP1Over K).left, Uo.ι ''ᵁ V')
      Γ(V, (q' ≫ Uo.ι) ⁻¹ᵁ U) := hEt0
  haveI : Algebra.Etale Γ((wcP1Over K).left, U) Γ((wcP1Over K).left, Uo.ι ''ᵁ V') :=
    Algebra.Etale.of_isLocalizationAway g
  haveI hEtRB : Algebra.Etale Γ((wcP1Over K).left, U) Γ(V, (q' ≫ Uo.ι) ⁻¹ᵁ U) :=
    Algebra.Etale.comp Γ((wcP1Over K).left, U) Γ((wcP1Over K).left, Uo.ι ''ᵁ V')
      Γ(V, (q' ≫ Uo.ι) ⁻¹ᵁ U)
  haveI : IsDedekindDomain Γ((wcP1Over K).left, U) :=
    IsPrincipalIdealRing.isDedekindDomain Γ((wcP1Over K).left, U)

  have Hgen : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsPrincipalIdealRing R], ¬ IsField R →
      ∀ (B : Type u) [CommRing B] [Algebra R B] [Algebra.Etale R B]
        (𝔪 : Ideal (integralClosure R B)) [𝔪.IsMaximal],
      IsRegularLocalRing (Localization.AtPrime 𝔪) ∧
        ringKrullDim (Localization.AtPrime 𝔪) = ((1 : ℕ) : WithBot ℕ∞) := by
    intro R _ _ _ hR B _ _ _ 𝔪 _
    haveI : IsDedekindDomain R := IsPrincipalIdealRing.isDedekindDomain R
    obtain ⟨e⟩ := s4 R B
    exact s5 R hR (TensorProduct R (FractionRing R) B) (integralClosure R B) e 𝔪
  have H : ∀ (𝔪 : Ideal (integralClosure Γ((wcP1Over K).left, U) Γ(V, (q' ≫ Uo.ι) ⁻¹ᵁ U)))
      [𝔪.IsMaximal], IsRegularLocalRing (Localization.AtPrime 𝔪) ∧
        ringKrullDim (Localization.AtPrime 𝔪) = ((1 : ℕ) : WithBot ℕ∞) := fun 𝔪 _ =>
    Hgen Γ((wcP1Over K).left, U) hnfR Γ(V, (q' ≫ Uo.ι) ⁻¹ᵁ U) 𝔪

  have hW : IsAffineOpen ((q' ≫ Uo.ι).fromNormalization ⁻¹ᵁ U) :=
    hU.preimage (q' ≫ Uo.ι).fromNormalization
  let ε : Γ((q' ≫ Uo.ι).normalization, (q' ≫ Uo.ι).fromNormalization ⁻¹ᵁ U) ≃+*
      integralClosure Γ((wcP1Over K).left, U) Γ(V, (q' ≫ Uo.ι) ⁻¹ᵁ U) :=
    (Scheme.Hom.normalizationObjIso (q' ≫ Uo.ι) hU).commRingCatIsoToRingEquiv
  exact gen (q' ≫ Uo.ι).normalization ((q' ≫ Uo.ι).fromNormalization ⁻¹ᵁ U) hW ⟨z, hyU⟩ hz
    (fun 𝔭 _ =>
      haveI : (𝔭.map ε).IsMaximal := Ideal.map_isMaximal_of_equiv ε
      s6 _ _ ε 𝔭 (H (𝔭.map ε)))

theorem wc_cover_compactify (K : Type u) [Field K] [Finite K]
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ] [Fintype Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α) (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
    (γ : Γ) :
    ∃ (Y : Scheme.{u}) (qb : Y ⟶ (wcP1Over K).left) (jV : V ⟶ Y) (a : Y ⟶ Y),
      IsFinite qb ∧ IsProper (qb ≫ (wcP1Over K).hom) ∧
      SmoothOfRelativeDimension 1 (qb ≫ (wcP1Over K).hom) ∧
      IsOpenImmersion jV ∧ IsPullback jV q' qb Uo.ι ∧ a ≫ qb = qb ∧
      (α γ).hom ≫ jV = jV ≫ a :=
by
  obtain ⟨-, hfin, het, -, -⟩ := hG
  haveI := hfin
  haveI := het
  haveI hXp : IsProper (wcP1Over K).hom := wc_proj_space_isProper K 1
  haveI : IsLocallyNoetherian (wcP1Over K).left :=
    LocallyOfFiniteType.isLocallyNoetherian (wcP1Over K).hom
  haveI : QuasiCompact (q' ≫ Uo.ι) := inferInstance
  haveI : QuasiSeparated (q' ≫ Uo.ι) := inferInstance
  have H : q' ≫ Uo.ι =
      ((α γ).hom ≫ (q' ≫ Uo.ι).toNormalization) ≫ (q' ≫ Uo.ι).fromNormalization := by
    rw [Category.assoc, Scheme.Hom.toNormalization_fromNormalization]
    exact (hα γ).symm
  have hqb : IsFinite (q' ≫ Uo.ι).fromNormalization :=
    wc_cc_fromNormalization_finite K Uo V q' hfin het
  have hpb := wc_hfe_normalization_restrict _ V Uo q' hfin
  haveI := hqb
  refine ⟨(q' ≫ Uo.ι).normalization, (q' ≫ Uo.ι).fromNormalization,
    (q' ≫ Uo.ι).toNormalization, (q' ≫ Uo.ι).normalizationDesc _ _ H, hqb, ?_, ?_, ?_, hpb,
    ?_, ?_⟩
  · infer_instance
  · haveI : PerfectField K := PerfectField.ofFinite
    exact wc_odp_smooth_of_closed_regular K _ _ 1 (fun z hz =>
      Or.inr (wc_cc_normalization_closed_stalk_regular K Uo V q' hfin het z hz))
  · exact MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb.flip inferInstance
  · exact Scheme.Hom.normalizationDesc_comp _ _ _ H
  · exact (Scheme.Hom.toNormalization_normalizationDesc _ _ _ H).symm

theorem wc_cover_excision_ses (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left)) (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V Y : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (qb : Y ⟶ (wcP1Over K).left) (jV : V ⟶ Y)
    (hqb : IsFinite qb) (hjV : IsOpenImmersion jV) (hpb : IsPullback jV q' qb Uo.ι)
    (b : V ⟶ V) (hb : b ≫ q' ≫ Uo.ι = q' ≫ Uo.ι) (a : Y ⟶ Y) (ha : a ≫ qb = qb)
    (hab : b ≫ jV = jV ≫ a) :
    ∃ ιF : wcCoverSheaf (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ⟶
        wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ,
      Mono ιF ∧
      wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ b hb ≫ ιF =
        ιF ≫ wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ a ha ∧
      ∀ W : (wcP1Over K).left.ProEt,
        (∀ (w : W.left) (i : Fin m), W.hom w ≠ S i (IsLocalRing.closedPoint K)) →
        ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left W) (Limits.cokernel ιF) 0, y = 0 :=
by
  have main : ∀ {X : Scheme.{u}} (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ X)) (Uo : X.Opens)
      (hUo : ∀ p : X, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
      {V Y : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (qb : Y ⟶ X) (jV : V ⟶ Y)
      (hpb : IsPullback jV q' qb Uo.ι)
      (b : V ⟶ V) (hb : b ≫ q' ≫ Uo.ι = q' ≫ Uo.ι) (a : Y ⟶ Y) (ha : a ≫ qb = qb)
      (hab : b ≫ jV = jV ≫ a),
      ∃ ιF : wcCoverSheaf (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ⟶
          wcCoverSheaf qb (∅ : Set X) ℓ,
        Mono ιF ∧
        wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ b hb ≫ ιF =
          ιF ≫ wcCoverAct qb (∅ : Set X) ℓ a ha ∧
        ∀ W : X.ProEt,
          (∀ (w : W.left) (i : Fin m), W.hom w ≠ S i (IsLocalRing.closedPoint K)) →
          ∀ y : Abelian.Ext (wcFreeSheaf X W) (Limits.cokernel ιF) 0, y = 0 := by
    intro X m S Uo hUo V Y q' qb jV hpb b hb a ha hab
    classical

    let pZ : X.ProEt → Prop :=
      fun T => ∀ t, T.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K))
    let p0 : X.ProEt → Prop := fun T => ∀ t, T.hom t ∉ (∅ : Set X)
    have hpZ : ∀ {T T' : X.ProEt} (_ : T' ⟶ T), pZ T → pZ T' :=
      fun g h t => by rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]; exact h _
    have hp0 : ∀ {T T' : X.ProEt} (_ : T' ⟶ T), p0 T → p0 T' :=
      fun g h t => by rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]; exact h _
    let Fz : Scheme.{u}ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      continuousMapPresheafAb.{0, u} ℤ_[ℓ] ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}
    have hw : jV ≫ qb = q' ≫ Uo.ι := hpb.w

    let σ : wcPbFun (q' ≫ Uo.ι) ⟶ wcPbFun qb :=
      { app := fun T => (Limits.pullback.lift
            (Limits.pullback.fst ((Scheme.ProEt.forget X).obj T).hom (q' ≫ Uo.ι))
            (Limits.pullback.snd ((Scheme.ProEt.forget X).obj T).hom (q' ≫ Uo.ι) ≫ jV)
            (by rw [Category.assoc, hw]; exact Limits.pullback.condition) :
            Limits.pullback ((Scheme.ProEt.forget X).obj T).hom (q' ≫ Uo.ι) ⟶
              Limits.pullback ((Scheme.ProEt.forget X).obj T).hom qb)
        naturality := fun T T' g => by
          apply Limits.pullback.hom_ext <;>
            simp only [wcPbFun, Functor.comp_map, Over.forget_map, Over.pullback_map_left,
              Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_snd,
              Limits.pullback.lift_fst_assoc, Limits.pullback.lift_snd_assoc] }

    have key : ∀ {Tm : Scheme.{u}} (t : Tm ⟶ X) (tU : Tm ⟶ Uo.toScheme) (_ : tU ≫ Uo.ι = t)
        (w : Limits.pullback.fst t (q' ≫ Uo.ι) ≫ t =
          (Limits.pullback.snd t (q' ≫ Uo.ι) ≫ jV) ≫ qb),
        IsIso (Limits.pullback.lift (Limits.pullback.fst t (q' ≫ Uo.ι))
          (Limits.pullback.snd t (q' ≫ Uo.ι) ≫ jV) w) := by
      intro Tm t tU htU w
      have c₁ := Limits.pullback.condition (f := t) (g := q' ≫ Uo.ι)
      have c₂ := Limits.pullback.condition (f := t) (g := qb)
      have w₁ : Limits.pullback.snd t qb ≫ qb = (Limits.pullback.fst t qb ≫ tU) ≫ Uo.ι := by
        rw [Category.assoc, htU, c₂]
      let v : Limits.pullback t qb ⟶ V :=
        hpb.lift (Limits.pullback.snd t qb) (Limits.pullback.fst t qb ≫ tU) w₁
      have hv1 : v ≫ jV = Limits.pullback.snd t qb := hpb.lift_fst _ _ _
      have hv2 : v ≫ q' = Limits.pullback.fst t qb ≫ tU := hpb.lift_snd _ _ _
      have w₂ : Limits.pullback.fst t qb ≫ t = v ≫ q' ≫ Uo.ι := by
        rw [← Category.assoc, hv2, Category.assoc, htU]
      let ρ : Limits.pullback t qb ⟶ Limits.pullback t (q' ≫ Uo.ι) :=
        Limits.pullback.lift (Limits.pullback.fst t qb) v w₂
      refine ⟨⟨ρ, ?_, ?_⟩⟩
      · apply Limits.pullback.hom_ext
        · simp only [ρ, Category.assoc, Limits.pullback.lift_fst, Category.id_comp]
        · simp only [ρ, Category.assoc, Limits.pullback.lift_snd, Category.id_comp]
          apply hpb.hom_ext
          · rw [Category.assoc, hv1, Limits.pullback.lift_snd]
          · rw [Category.assoc, hv2, ← Category.assoc, Limits.pullback.lift_fst,
              ← cancel_mono Uo.ι, Category.assoc, htU, c₁, Category.assoc]
      · apply Limits.pullback.hom_ext
        · simp only [ρ, Category.assoc, Limits.pullback.lift_fst, Category.id_comp]
        · simp only [ρ, Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc,
            Category.id_comp]
          exact hv1
    have hσiso : ∀ T : X.ProEt, pZ T → IsIso (σ.app T) := by
      intro T hT
      have hrange : Set.range T.hom.base ⊆ Set.range Uo.ι.base := by
        rw [Scheme.Opens.range_ι]
        rintro _ ⟨t, rfl⟩
        apply (hUo _).mpr
        intro i hi
        exact hT t (Set.mem_range.mpr ⟨i, hi.symm⟩)
      exact key ((Scheme.ProEt.forget X).obj T).hom (IsOpenImmersion.lift Uo.ι T.hom hrange)
        (IsOpenImmersion.lift_fac _ _ _) _

    have hEgen : ∀ {Tm : Scheme.{u}} (t : Tm ⟶ X)
        (w1 : Limits.pullback.fst t (q' ≫ Uo.ι) ≫ t =
          (Limits.pullback.snd t (q' ≫ Uo.ι) ≫ jV) ≫ qb)
        (e1 : t ≫ 𝟙 X = 𝟙 Tm ≫ t) (e2 : (q' ≫ Uo.ι) ≫ 𝟙 X = b ≫ q' ≫ Uo.ι)
        (e3 : t ≫ 𝟙 X = 𝟙 Tm ≫ t) (e4 : qb ≫ 𝟙 X = a ≫ qb),
        Limits.pullback.map t (q' ≫ Uo.ι) t (q' ≫ Uo.ι) (𝟙 _) b (𝟙 X) e1 e2 ≫
          Limits.pullback.lift (Limits.pullback.fst t (q' ≫ Uo.ι))
            (Limits.pullback.snd t (q' ≫ Uo.ι) ≫ jV) w1 =
        Limits.pullback.lift (Limits.pullback.fst t (q' ≫ Uo.ι))
            (Limits.pullback.snd t (q' ≫ Uo.ι) ≫ jV) w1 ≫
          Limits.pullback.map t qb t qb (𝟙 _) a (𝟙 X) e3 e4 := by
      intro Tm t w1 e1 e2 e3 e4
      apply Limits.pullback.hom_ext
      · simp only [Limits.pullback.map, Category.assoc, Limits.pullback.lift_fst,
          Category.comp_id]
      · simp only [Limits.pullback.map, Category.assoc, Limits.pullback.lift_snd,
          Limits.pullback.lift_snd_assoc, hab]
    have hE : wcPbAct (q' ≫ Uo.ι) b hb ≫ σ = σ ≫ wcPbAct qb a ha := by
      apply NatTrans.ext; funext T
      exact hEgen ((Scheme.ProEt.forget X).obj T).hom _
        (by rw [Category.comp_id, Category.id_comp]) (by rw [Category.comp_id, hb])
        (by rw [Category.comp_id, Category.id_comp]) (by rw [Category.comp_id, ha])

    have hext_iso : ∀ {F F' : X.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}} (α : F ⟶ F')
        (p : X.ProEt → Prop) (hp : ∀ {T T' : X.ProEt} (_ : T' ⟶ T), p T → p T'),
        (∀ T : X.ProEtᵒᵖ, p T.unop → Function.Bijective (α.app T).hom) →
        IsIso (wcExtZeroMap α p hp) := by
      intro F F' α p hp hα
      have hcomp : ∀ T, IsIso ((wcExtZeroMap α p hp).app T) := by
        intro T
        rw [ConcreteCategory.isIso_iff_bijective]
        by_cases h : p T.unop
        · constructor
          · intro (x : wcExtZeroSub F p T) (y : wcExtZeroSub F p T) hxy
            apply Subtype.ext
            apply (hα T h).1
            exact congrArg Subtype.val hxy
          · intro (y : wcExtZeroSub F' p T)
            obtain ⟨x, hx⟩ := (hα T h).2 y.1
            have hxmem : x ∈ wcExtZeroSub F p T := by
              show x ∈ (⨆ _ : p T.unop, (⊤ : AddSubgroup _)); rw [iSup_pos h]
              exact AddSubgroup.mem_top _
            exact ⟨⟨x, hxmem⟩, Subtype.ext hx⟩
        · have h0 : ∀ {G : X.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}} (z : wcExtZeroSub G p T),
              z = 0 := by
            intro G z
            apply Subtype.ext
            have hz : z.1 ∈ (⨆ _ : p T.unop, (⊤ : AddSubgroup (G.obj T))) := z.2
            rw [iSup_neg h, AddSubgroup.mem_bot] at hz
            exact hz
          constructor
          · intro (x : wcExtZeroSub F p T) (y : wcExtZeroSub F p T) _
            exact (h0 x).trans (h0 y).symm
          · intro (y : wcExtZeroSub F' p T)
            exact ⟨0, (h0 _).trans (h0 y).symm⟩
      have := hcomp
      exact NatIso.isIso_of_isIso_app _

    let σF : wcCoverBasePre qb ℓ ⟶ wcCoverBasePre (q' ≫ Uo.ι) ℓ :=
      Functor.whiskerRight (NatTrans.op σ) Fz
    have hσFbij : ∀ T : X.ProEtᵒᵖ, pZ T.unop → Function.Bijective (σF.app T).hom := by
      intro T hT
      have := hσiso T.unop hT
      have : IsIso (σF.app T) := by
        show IsIso (Fz.map (σ.app T.unop).op)
        infer_instance
      exact (ConcreteCategory.isIso_iff_bijective (σF.app T)).mp this
    let Sg : wcExtZeroPre (wcCoverBasePre qb ℓ) pZ hpZ ⟶
        wcExtZeroPre (wcCoverBasePre (q' ≫ Uo.ι) ℓ) pZ hpZ := wcExtZeroMap σF pZ hpZ
    have hSg : IsIso Sg := hext_iso σF pZ hpZ hσFbij
    let e := @asIso _ _ _ _ Sg hSg

    have htop0 : ∀ T : X.ProEtᵒᵖ, wcExtZeroSub (wcCoverBasePre qb ℓ) p0 T = ⊤ :=
      fun T => iSup_pos (fun t h => h)
    have hle : ∀ T, wcExtZeroSub (wcCoverBasePre qb ℓ) pZ T ≤
        wcExtZeroSub (wcCoverBasePre qb ℓ) p0 T := fun T => by rw [htop0 T]; exact le_top
    let incl : wcExtZeroPre (wcCoverBasePre qb ℓ) pZ hpZ ⟶
        wcExtZeroPre (wcCoverBasePre qb ℓ) p0 hp0 :=
      { app := fun T => AddCommGrpCat.ofHom (AddSubgroup.inclusion (hle T))
        naturality := fun _ _ _ => rfl }
    have hinclmono : Mono incl := by
      have : ∀ T, Mono (incl.app T) := fun T =>
        (AddCommGrpCat.mono_iff_injective _).mpr (AddSubgroup.inclusion_injective (hle T))
      exact NatTrans.mono_of_mono_app incl
    let η : wcExtZeroPre (wcCoverBasePre (q' ≫ Uo.ι) ℓ) pZ hpZ ⟶
        wcExtZeroPre (wcCoverBasePre qb ℓ) p0 hp0 := e.inv ≫ incl
    have hηmono : Mono η := mono_comp e.inv incl

    let actF : wcExtZeroPre (wcCoverBasePre (q' ≫ Uo.ι) ℓ) pZ hpZ ⟶
        wcExtZeroPre (wcCoverBasePre (q' ≫ Uo.ι) ℓ) pZ hpZ :=
      wcExtZeroMap (Functor.whiskerRight (NatTrans.op (wcPbAct (q' ≫ Uo.ι) b hb)) Fz) pZ hpZ
    let actG : wcExtZeroPre (wcCoverBasePre qb ℓ) p0 hp0 ⟶
        wcExtZeroPre (wcCoverBasePre qb ℓ) p0 hp0 :=
      wcExtZeroMap (Functor.whiskerRight (NatTrans.op (wcPbAct qb a ha)) Fz) p0 hp0
    let actG' : wcExtZeroPre (wcCoverBasePre qb ℓ) pZ hpZ ⟶
        wcExtZeroPre (wcCoverBasePre qb ℓ) pZ hpZ :=
      wcExtZeroMap (Functor.whiskerRight (NatTrans.op (wcPbAct qb a ha)) Fz) pZ hpZ
    have hE'' : ∀ T : X.ProEtᵒᵖ, Fz.map ((wcPbAct qb a ha).app T.unop).op ≫
        Fz.map (σ.app T.unop).op = Fz.map (σ.app T.unop).op ≫
        Fz.map ((wcPbAct (q' ≫ Uo.ι) b hb).app T.unop).op := by
      intro T
      rw [← Fz.map_comp, ← Fz.map_comp, ← op_comp, ← op_comp, ← NatTrans.comp_app,
        ← NatTrans.comp_app, hE]
    have hi : actG' ≫ e.hom = e.hom ≫ actF := by
      apply NatTrans.ext; funext T
      apply AddCommGrpCat.hom_ext; apply AddMonoidHom.ext; intro x
      apply Subtype.ext
      exact congrArg (fun φ => φ.hom x.1) (hE'' T)
    have hii : incl ≫ actG = actG' ≫ incl := by
      apply NatTrans.ext; funext T
      apply AddCommGrpCat.hom_ext; apply AddMonoidHom.ext; intro x
      rfl
    have hiii : actF ≫ e.inv = e.inv ≫ actG' := by
      rw [← cancel_epi e.hom, e.hom_inv_id_assoc, ← Category.assoc, ← hi, Category.assoc,
        e.hom_inv_id, Category.comp_id]
    have hiv : actF ≫ η = η ≫ actG := by
      show actF ≫ (e.inv ≫ incl) = (e.inv ≫ incl) ≫ actG
      calc actF ≫ (e.inv ≫ incl) = (actF ≫ e.inv) ≫ incl := (Category.assoc _ _ _).symm
        _ = (e.inv ≫ actG') ≫ incl := by rw [hiii]
        _ = e.inv ≫ (actG' ≫ incl) := Category.assoc _ _ _
        _ = e.inv ≫ (incl ≫ actG) := by rw [hii]
        _ = (e.inv ≫ incl) ≫ actG := (Category.assoc _ _ _).symm

    have hηsurj : ∀ T : X.ProEt, pZ T → Function.Surjective (η.app (Opposite.op T)).hom := by
      intro T hT
      have h1 : Function.Surjective (e.inv.app (Opposite.op T)).hom := by
        intro y
        refine ⟨(e.hom.app (Opposite.op T)).hom y, ?_⟩
        have := congrArg (fun φ => φ.hom y) (e.hom_inv_id_app (Opposite.op T))
        exact this
      have h2 : Function.Surjective (incl.app (Opposite.op T)).hom := by
        intro (y : wcExtZeroSub (wcCoverBasePre qb ℓ) p0 (Opposite.op T))
        have hy : y.1 ∈ wcExtZeroSub (wcCoverBasePre qb ℓ) pZ (Opposite.op T) := by
          show _ ∈ (⨆ _ : pZ T, (⊤ : AddSubgroup _)); rw [iSup_pos hT]
          exact AddSubgroup.mem_top _
        exact ⟨⟨y.1, hy⟩, rfl⟩
      exact h2.comp h1
    have hQ : ∀ T : X.ProEt, pZ T → ∀ z : (Limits.cokernel η).obj (Opposite.op T), z = 0 := by
      intro T hT z
      have : Epi (((evaluation X.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op T)).map η) :=
        (AddCommGrpCat.epi_iff_surjective _).mpr (hηsurj T hT)
      have hz := Limits.IsZero.of_iso (Limits.isZero_cokernel_of_epi
        (((evaluation X.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op T)).map η))
        (Limits.PreservesCokernel.iso ((evaluation X.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj
          (Opposite.op T)) η)
      exact @Subsingleton.elim _ (AddCommGrpCat.isZero_iff_subsingleton.mp hz) z 0
    have hsec : ∀ T : X.ProEt, pZ T → ∀ s : (sheafify (Scheme.ProEt.topology X)
        (Limits.cokernel η)).obj (Opposite.op T), s = 0 := by
      intro T hT s
      have : Presheaf.IsLocallySurjective (Scheme.ProEt.topology X)
          (toSheafify (Scheme.ProEt.topology X) (Limits.cokernel η)) :=
        Presheaf.isLocallySurjective_toSheafify' _ _
      have hmem := Presheaf.imageSieve_mem (Scheme.ProEt.topology X)
        (toSheafify (Scheme.ProEt.topology X) (Limits.cokernel η)) s
      refine ((presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).obj
        (Limits.cokernel η)).isSeparated _ _ hmem s 0 ?_
      intro T' f hf
      rw [Presheaf.imageSieve_apply] at hf
      obtain ⟨t₀, ht₀⟩ := hf
      have h0 : t₀ = 0 := hQ T' (hpZ f hT) t₀
      rw [h0, map_zero] at ht₀
      exact ht₀.symm.trans (map_zero _).symm
    have hCz : ∀ T : X.ProEt, pZ T → Subsingleton ((Limits.cokernel
        ((presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map η)).obj.obj
          (Opposite.op T)) := by
      intro T hT
      have hz1 : Limits.IsZero (((presheafToSheaf (Scheme.ProEt.topology X)
          AddCommGrpCat.{u+1}).obj (Limits.cokernel η)).obj.obj (Opposite.op T)) :=
        AddCommGrpCat.isZero_iff_subsingleton.mpr
          ⟨fun s t => (hsec T hT s).trans (hsec T hT t).symm⟩
      have hz2 := Limits.IsZero.of_iso hz1
        ((sheafToPresheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1} ⋙
          (evaluation X.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op T)).mapIso
            (Limits.PreservesCokernel.iso
              (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) η)).symm
      exact AddCommGrpCat.isZero_iff_subsingleton.mp hz2
    refine ⟨(presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map η, ?_, ?_, ?_⟩
    · exact Functor.map_mono _ η
    · have h : (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map actF ≫
          (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map η =
          (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map η ≫
          (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map actG := by
        rw [← Functor.map_comp, ← Functor.map_comp, hiv]
      exact h
    · intro W hW y
      have hWZ : pZ W := fun w hmem => by
        obtain ⟨i, hi⟩ := Set.mem_range.mp hmem
        exact hW w i hi.symm
      obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
      have hg : g = 0 := by
        apply ((sheafificationAdjunction (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) _).injective
        apply NatTrans.ext; funext T
        apply AddCommGrpCat.hom_ext; apply AddMonoidHom.ext; intro x
        by_cases hT : Nonempty (T.unop ⟶ W)
        · obtain ⟨f⟩ := hT
          exact @Subsingleton.elim _ (hCz T.unop (hpZ f hWZ)) _ _
        · have hz : ∀ z : FreeAbelianGroup (ULift.{u+1} (T.unop ⟶ W)), z = 0 := fun z =>
            FreeAbelianGroup.induction_on z rfl (fun c => (hT ⟨c.down⟩).elim)
              (fun c _ => (hT ⟨c.down⟩).elim) (fun c d hc hd => by rw [hc, hd, add_zero])
          rw [hz x]
          exact (map_zero _).trans (map_zero _).symm
      rw [hg, Abelian.Ext.mk₀_zero]
  exact main m S Uo hUo q' qb jV hpb b hb a ha hab

theorem wc_cover_D_strict_eval (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left)) (Uo : (wcP1Over K).left.Opens)
    {V Y : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (qb : Y ⟶ (wcP1Over K).left)
    (a : Y ⟶ Y) (ha : a ≫ qb = qb)
    (ιF : wcCoverSheaf (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ⟶
        wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) (hmono : Mono ιF)
    (σD : Limits.cokernel ιF ⟶ Limits.cokernel ιF)
    (hσD : Limits.cokernel.π ιF ≫ σD =
      wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ a ha ≫ Limits.cokernel.π ιF)
    (W : (wcP1Over K).left.ProEt) (A : Type u) [instA : CommRing A] [henA : HenselianLocalRing A]
    [sepA : IsSepClosed (IsLocalRing.ResidueField A)] (e : W.left ≅ Spec (.of A)) (i : Fin m)
    (hx : W.hom (e.inv (IsLocalRing.closedPoint A)) = S i (IsLocalRing.closedPoint K))
    (aQ : Limits.pullback W.hom qb ⟶ Limits.pullback W.hom qb)
    (haQ1 : aQ ≫ Limits.pullback.fst W.hom qb = Limits.pullback.fst W.hom qb)
    (haQ2 : aQ ≫ Limits.pullback.snd W.hom qb = Limits.pullback.snd W.hom qb ≫ a)
    (φ : W ⟶ W) (φQ : Limits.pullback W.hom qb ⟶ Limits.pullback W.hom qb)
    (hφQ1 : φQ ≫ Limits.pullback.fst W.hom qb = Limits.pullback.fst W.hom qb ≫ φ.left)
    (hφQ2 : φQ ≫ Limits.pullback.snd W.hom qb = Limits.pullback.snd W.hom qb) :
    ∃ Ψ : Abelian.Ext (wcFreeSheaf (wcP1Over K).left W) (Limits.cokernel ιF) 0 ≃+
        C(↥(Limits.pullback W.hom qb), ℤ_[ℓ]),
      (∀ (y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left W) (Limits.cokernel ιF) 0)
          (z : ↥(Limits.pullback W.hom qb)),
        Ψ ((Abelian.Ext.mk₀ σD).postcomp (wcFreeSheaf (wcP1Over K).left W) (add_zero 0) y) z =
          Ψ y (aQ z)) ∧
      ∀ (y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left W) (Limits.cokernel ιF) 0)
          (z : ↥(Limits.pullback W.hom qb)),
        Ψ ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left φ)).precomp
          (Limits.cokernel ιF) (zero_add 0) y) z = Ψ y (φQ z) :=
by
  classical

  have hid : ∀ (S : Scheme.{u}) (V : S.ProEt), Nonempty (V.left ≅ Spec (.of A)) →
      ∀ T : Sieve V, T ∈ Scheme.ProEt.topology S V → T.arrows (𝟙 V) := by
    intro S
    have s6 : ∀ (R E : Type u) [CommRing R] [CommRing E] [Algebra R E],
        WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R E))) →
          Algebra.WeaklyEtale R E := by
      intro R E _ _ _ hW
      have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap R E))) := hW.flat
      have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R E)))) :=
        hW.flat_diagonal
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
        RingHom.flat_algebraMap_iff] at hf
      rw [diagonal_SpecMap] at hd
      have hd' : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' R (S := E)).toRingHom)) := by
        have heq : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) =
            (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) ≫
              (pullbackSpecIso R E E).inv) ≫ (pullbackSpecIso R E E).hom := by
          rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
        rw [heq]
        infer_instance
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hd'
      exact ⟨hf, hd'⟩
    have s7 : ∀ (E : Type u) [CommRing E] [Algebra A E],
        Algebra.WeaklyEtale A E → ∀ (p : Ideal E) [p.IsPrime],
        p.comap (algebraMap A E) = IsLocalRing.maximalIdeal A → Nonempty (E →ₐ[A] A) := by
      intro E _ _ hAE p _ hp
      haveI : Algebra.WeaklyEtale E (Localization.AtPrime p) :=
        wc_localization_weaklyEtale E (Localization.AtPrime p) p.primeCompl
      haveI := hAE
      haveI : Algebra.WeaklyEtale A (Localization.AtPrime p) := Algebra.WeaklyEtale.trans A E _
      have hloc : IsLocalHom (algebraMap A (Localization.AtPrime p)) := by
        have h1 : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap
            (algebraMap A (Localization.AtPrime p)) = IsLocalRing.maximalIdeal A := by
          rw [IsScalarTower.algebraMap_eq A E (Localization.AtPrime p), ← Ideal.comap_comap]
          have h2 : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap
              (algebraMap E (Localization.AtPrime p)) = p :=
            Localization.AtPrime.under_maximalIdeal
          rw [h2, hp]
        exact ((IsLocalRing.local_hom_TFAE (algebraMap A (Localization.AtPrime p))).out 1 5).mpr h1
      have hbij := wc_olivier A (Localization.AtPrime p) inferInstance inferInstance hloc
        inferInstance
      let eqv : A ≃ₐ[A] Localization.AtPrime p := AlgEquiv.ofBijective (Algebra.ofId A _) hbij
      exact ⟨eqv.symm.toAlgHom.comp (IsScalarTower.toAlgHom A E (Localization.AtPrime p))⟩
    have s5 : ∀ {U V : Scheme.{u}} (e : U ≅ Spec (.of A)) (g : V ⟶ U) [WeaklyEtale g] (v : V),
        e.hom (g v) = IsLocalRing.closedPoint A → ∃ σ : U ⟶ V, σ ≫ g = 𝟙 U := by
      intro U V e g _ v hv
      obtain ⟨E, ι, hι, hvι, -⟩ :=
        Scheme.exists_affine_mem_range_and_range_subset (U := (⊤ : V.Opens)) (x := v) trivial
      obtain ⟨w, hw⟩ := hvι
      have := hι
      let h : Spec E ⟶ Spec (.of A) := ι ≫ g ≫ e.hom
      have hWh : WeaklyEtale h := inferInstance
      let φ : CommRingCat.of A ⟶ E := Spec.preimage h
      have hφ : Spec.map φ = h := Spec.map_preimage h
      letI : Algebra A E := (CommRingCat.Hom.hom φ).toAlgebra
      have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap A E))) := by
        change WeaklyEtale (Spec.map φ)
        rw [hφ]
        exact hWh
      have hAE : Algebra.WeaklyEtale A E := s6 A E hW'
      let p : PrimeSpectrum E := w
      have hq : (p.asIdeal).comap (algebraMap A E) = IsLocalRing.maximalIdeal A := by
        have h1 : (Spec.map φ) w = IsLocalRing.closedPoint A := by
          rw [hφ]
          show e.hom (g (ι w)) = _
          rw [hw, hv]
        exact congrArg PrimeSpectrum.asIdeal h1
      obtain ⟨τ⟩ := s7 E hAE p.asIdeal hq
      let τ' : E ⟶ CommRingCat.of A := CommRingCat.ofHom (τ : E →+* A)
      have hret : φ ≫ τ' = 𝟙 _ := by
        ext r
        exact τ.commutes r
      refine ⟨e.hom ≫ Spec.map τ' ≫ ι, ?_⟩
      rw [← cancel_mono e.hom]
      simp only [Category.assoc, Category.id_comp]
      have h3 : ι ≫ g ≫ e.hom = Spec.map φ := hφ.symm
      rw [h3, ← Spec.map_comp, hret, Spec.map_id, Category.comp_id]
    have s4 : ∀ (U : S.ProEt) (R : Presieve U), R ∈ (Scheme.ProEt.precoverage S).coverings U →
        ∀ (W : S.ProEt) (a : W ⟶ U), Nonempty (W.left ≅ Spec (.of A)) →
        ∃ (Y : S.ProEt) (g : Y ⟶ U) (h : W ⟶ Y), R g ∧ h ≫ g = a := by
      intro U R hR W a ⟨eW⟩
      have hR' : Presieve.map (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          (Scheme.precoverage @WeaklyEtale).coverings U.left := hR.2
      obtain ⟨Y', g', hg', y', hy'⟩ :=
        (Scheme.instJointlySurjectivePrecoverage (P := @WeaklyEtale)).exists_eq _ hR'
          (a.left (eW.inv (IsLocalRing.closedPoint A)))
      obtain ⟨Y, hY, g, hg, hgg⟩ := Presieve.map_iff.mp hg'
      subst hY
      have hgl : g.left = g' := hgg.trans (by simp only [eqToHom_refl]; exact Category.id_comp _)
      haveI : WeaklyEtale U.hom := U.prop
      haveI : WeaklyEtale (g.left ≫ U.hom) := by
        rw [MorphismProperty.Over.w g]; exact Y.prop
      haveI : WeaklyEtale g.left := WeaklyEtale.of_comp g.left U.hom
      obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := a.left) (g := g.left)
        (eW.inv (IsLocalRing.closedPoint A)) y' (by rw [hgl]; exact hy'.symm)
      obtain ⟨σ, hσ⟩ := s5 eW (Limits.pullback.fst a.left g.left) z (by
        rw [hz1]
        change (eW.inv ≫ eW.hom) (IsLocalRing.closedPoint A) = _
        rw [Iso.inv_hom_id]
        rfl)
      have hh₀ : (σ ≫ Limits.pullback.snd a.left g.left) ≫ g.left = a.left := by
        rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hσ, Category.id_comp]
      refine ⟨Y, g, MorphismProperty.Over.homMk (σ ≫ Limits.pullback.snd a.left g.left) ?_ trivial,
        hg, ?_⟩
      · rw [← MorphismProperty.Over.w g, ← Category.assoc, hh₀, MorphismProperty.Over.w a]
      · apply MorphismProperty.Over.Hom.ext
        exact hh₀
    have s3 : ∀ (P : S.ProEt → Prop),
        (∀ (U : S.ProEt) (R : Presieve U), R ∈ (Scheme.ProEt.precoverage S).coverings U →
          ∀ (W : S.ProEt) (a : W ⟶ U), P W →
            ∃ (Y : S.ProEt) (g : Y ⟶ U) (h : W ⟶ Y), R g ∧ h ≫ g = a) →
        ∀ (U : S.ProEt) (T : Sieve U), T ∈ Scheme.ProEt.topology S U →
          ∀ (W : S.ProEt) (a : W ⟶ U), P W → T.arrows a := by
      intro P hK
      let JP : GrothendieckTopology S.ProEt :=
        GrothendieckTopology.mk
          (fun U => {T : Sieve U | ∀ (W : S.ProEt) (a : W ⟶ U), P W → T.arrows a})
          (by
            intro U W a _
            trivial)
          (by
            intro U Y T f hT W a hW
            rw [Sieve.pullback_apply]
            exact hT W (a ≫ f) hW)
          (by
            intro U T hT R hR W a hW
            have h1 := hR (hT W a hW) W (𝟙 W) hW
            rw [Sieve.pullback_apply, Category.id_comp] at h1
            exact h1)
      have hle : Scheme.ProEt.topology S ≤ JP := by
        rw [Precoverage.toGrothendieck_le_iff_le_toPrecoverage]
        intro U R hR
        show ∀ (W : S.ProEt) (a : W ⟶ U), P W → (Sieve.generate R).arrows a
        intro W a hW
        obtain ⟨Y, g, h, hg, hhg⟩ := hK U R hR W a hW
        exact ⟨Y, h, g, hg, hhg⟩
      intro U T hT W a hW
      have h1 : T ∈ JP U := GrothendieckTopology.le_def.mp hle U hT
      exact h1 W a hW
    intro V hV T hT
    exact s3 (fun W => Nonempty (W.left ≅ Spec (.of A))) s4 V T hT V (𝟙 V) hV

  have hbij : ∀ P : ((wcP1Over K).left.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1},
      Function.Bijective
        ((toSheafify (Scheme.ProEt.topology (wcP1Over K).left) P).app (Opposite.op W)).hom := by
    intro P
    have hW := hid _ W ⟨e⟩
    constructor
    · intro x y hxy
      have h1 := Presheaf.equalizerSieve_mem (Scheme.ProEt.topology (wcP1Over K).left)
        (toSheafify (Scheme.ProEt.topology (wcP1Over K).left) P) x y hxy
      have h2 := hW _ h1
      rw [Presheaf.equalizerSieve_apply] at h2
      simpa using h2
    · intro s
      have h1 := Presheaf.imageSieve_mem (Scheme.ProEt.topology (wcP1Over K).left)
        (toSheafify (Scheme.ProEt.topology (wcP1Over K).left) P) (U := Opposite.op W) s
      have h2 := hW _ h1
      rw [Presheaf.imageSieve_apply] at h2
      obtain ⟨t, ht⟩ := h2
      exact ⟨t, ht.trans (by simp)⟩

  let PF := wcExtZeroPre (wcCoverBasePre (q' ≫ Uo.ι) ℓ)
    (fun T : (wcP1Over K).left.ProEt =>
      ∀ t, T.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K)))
    (fun g h t => by rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]; exact h _)
  let PG := wcExtZeroPre (wcCoverBasePre qb ℓ)
    (fun T : (wcP1Over K).left.ProEt => ∀ t, T.hom t ∉ (∅ : Set (wcP1Over K).left))
    (fun g h t => by rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]; exact h _)

  have hF0 : ∀ s : (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ).obj.obj (Opposite.op W), s = 0 := by
    intro s
    obtain ⟨⟨x1, hx1⟩, hxs⟩ := (hbij PF).2 s
    subst hxs
    have hn : ¬ (∀ t, W.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K))) :=
      fun h => h (e.inv (IsLocalRing.closedPoint A)) ⟨i, hx.symm⟩
    have hmem : x1 ∈ (⨆ _ : (∀ t, W.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K))),
        (⊤ : AddSubgroup ((wcCoverBasePre (q' ≫ Uo.ι) ℓ).obj (Opposite.op W)))) := hx1
    rw [iSup_neg hn, AddSubgroup.mem_bot] at hmem
    subst hmem
    exact map_zero _
  obtain ⟨ev, hev1, hev2⟩ := wc_free_ext0_eval (wcP1Over K).left
  have hE0 : ∀ z : Abelian.Ext (wcFreeSheaf (wcP1Over K).left W) (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ) 0, z = 0 := by
    intro z
    apply (ev W _).injective
    rw [map_zero]
    exact hF0 _

  haveI : Projective (wcFreeSheaf (wcP1Over K).left W) :=
    wc_proet_free_projective_strict_local _ W A e
  haveI := hmono
  obtain ⟨hsurj, hker⟩ := wc_ext0_projective_cokernel (P := wcFreeSheaf (wcP1Over K).left W) ιF
  have hinj : Function.Injective ((Abelian.Ext.mk₀ (Limits.cokernel.π ιF)).postcomp
      (wcFreeSheaf (wcP1Over K).left W) (add_zero 0)) := by
    rw [injective_iff_map_eq_zero]
    intro y hy
    obtain ⟨z, rfl⟩ := (hker y).1 hy
    rw [hE0 z, map_zero]
  obtain ⟨τ, hτ⟩ : ∃ τ : Abelian.Ext (wcFreeSheaf (wcP1Over K).left W)
      (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) 0 ≃+
      Abelian.Ext (wcFreeSheaf (wcP1Over K).left W) (Limits.cokernel ιF) 0,
      ∀ w, τ w = (Abelian.Ext.mk₀ (Limits.cokernel.π ιF)).postcomp
        (wcFreeSheaf (wcP1Over K).left W) (add_zero 0) w :=
    ⟨AddEquiv.ofBijective _ ⟨hinj, hsurj⟩, fun _ => rfl⟩
  have hassoc : ∀ {X₁ X₂ X₃ X₄ : Sheaf (Scheme.ProEt.topology (wcP1Over K).left)
      AddCommGrpCat.{u+1}} (α : Abelian.Ext X₁ X₂ 0) (β : Abelian.Ext X₂ X₃ 0)
      (γ : Abelian.Ext X₃ X₄ 0),
      (α.comp β (add_zero 0)).comp γ (add_zero 0) = α.comp (β.comp γ (add_zero 0)) (add_zero 0) :=
    fun α β γ => Abelian.Ext.comp_assoc α β γ (add_zero 0) (add_zero 0) rfl
  have hτσ : ∀ w, (Abelian.Ext.mk₀ σD).postcomp (wcFreeSheaf (wcP1Over K).left W) (add_zero 0)
      (τ w) = τ ((Abelian.Ext.mk₀ (wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ a ha)).postcomp
        (wcFreeSheaf (wcP1Over K).left W) (add_zero 0) w) := by
    intro w
    rw [hτ, hτ]
    show (w.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ιF)) (add_zero 0)).comp
        (Abelian.Ext.mk₀ σD) (add_zero 0) =
      (w.comp (Abelian.Ext.mk₀ (wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ a ha))
        (add_zero 0)).comp (Abelian.Ext.mk₀ (Limits.cokernel.π ιF)) (add_zero 0)
    rw [hassoc, hassoc, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hσD]
  have hτφ : ∀ w, (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left φ)).precomp
      (Limits.cokernel ιF) (zero_add 0) (τ w) =
      τ ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left φ)).precomp
        (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) (zero_add 0) w) := by
    intro w
    rw [hτ, hτ]
    show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left φ)).comp
        (w.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ιF)) (add_zero 0)) (zero_add 0) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left φ)).comp w (zero_add 0)).comp
        (Abelian.Ext.mk₀ (Limits.cokernel.π ιF)) (add_zero 0)
    rw [hassoc]

  have pW : ∀ t, W.hom t ∉ (∅ : Set (wcP1Over K).left) := fun t h => Set.notMem_empty _ h
  obtain ⟨Θ, hΘt⟩ : ∃ Θ : (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ).obj.obj
      (Opposite.op W) ≃+ C(↥(Limits.pullback W.hom qb), ℤ_[ℓ]),
      ∀ x : ↑(PG.obj (Opposite.op W)),
        Θ (((toSheafify (Scheme.ProEt.topology (wcP1Over K).left) PG).app (Opposite.op W)).hom x) =
          (Subtype.val x : ULift.{u+1} C(↥(Limits.pullback W.hom qb), ℤ_[ℓ])).down := by
    let Θ₀ : ↑(PG.obj (Opposite.op W)) ≃+ C(↥(Limits.pullback W.hom qb), ℤ_[ℓ]) :=
      { toFun := fun x => (Subtype.val x : ULift.{u+1} C(↥(Limits.pullback W.hom qb), ℤ_[ℓ])).down
        invFun := fun h => Subtype.mk (ULift.up h) (by
          show _ ∈ (⨆ _ : _, (⊤ : AddSubgroup _))
          rw [iSup_pos pW]
          exact AddSubgroup.mem_top _)
        left_inv := fun x => rfl
        right_inv := fun h => rfl
        map_add' := fun x y => rfl }
    exact ⟨(AddEquiv.ofBijective _ (hbij PG)).symm.trans Θ₀,
      fun x => congrArg Θ₀ ((AddEquiv.ofBijective _ (hbij PG)).symm_apply_apply x)⟩
  let ηa := wcExtZeroMap (Functor.whiskerRight (NatTrans.op (wcPbAct qb a ha))
      (continuousMapPresheafAb.{0, u} ℤ_[ℓ] ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}))
    (fun T : (wcP1Over K).left.ProEt => ∀ t, T.hom t ∉ (∅ : Set (wcP1Over K).left))
    (fun g h t => by rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]; exact h _)
  have hnat : ∀ x : ↑(PG.obj (Opposite.op W)),
      ((wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ a ha).hom.app (Opposite.op W)).hom
        (((toSheafify (Scheme.ProEt.topology (wcP1Over K).left) PG).app (Opposite.op W)).hom x) =
      ((toSheafify (Scheme.ProEt.topology (wcP1Over K).left) PG).app (Opposite.op W)).hom
        ((ηa.app (Opposite.op W)).hom x) := fun x =>
    (congrArg (fun f => (f.app (Opposite.op W)).hom x)
      (toSheafify_naturality (Scheme.ProEt.topology (wcP1Over K).left) ηa)).symm
  have hnatφ : ∀ x : ↑(PG.obj (Opposite.op W)),
      ((wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ).obj.map φ.op).hom
        (((toSheafify (Scheme.ProEt.topology (wcP1Over K).left) PG).app (Opposite.op W)).hom x) =
      ((toSheafify (Scheme.ProEt.topology (wcP1Over K).left) PG).app (Opposite.op W)).hom
        ((PG.map φ.op).hom x) := fun x =>
    (congrArg (fun f => f.hom x)
      ((toSheafify (Scheme.ProEt.topology (wcP1Over K).left) PG).naturality φ.op)).symm
  have haQ' : ((wcPbAct qb a ha).app W : Limits.pullback W.hom qb ⟶ Limits.pullback W.hom qb) =
      aQ := by
    apply Limits.pullback.hom_ext
    · refine Eq.trans ?_ haQ1.symm
      first
        | exact (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
        | (simp only [wcPbAct, Limits.pullback.map, Limits.pullback.lift_fst, Category.comp_id]; done)
        | (simp [wcPbAct, Limits.pullback.map])
    · refine Eq.trans ?_ haQ2.symm
      first
        | exact Limits.pullback.lift_snd _ _ _
        | (simp only [wcPbAct, Limits.pullback.map, Limits.pullback.lift_snd]; done)
        | (simp [wcPbAct, Limits.pullback.map])
  have e2 := Over.pullback_map_left qb ((Scheme.ProEt.forget (wcP1Over K).left).obj W)
    (k := (Scheme.ProEt.forget (wcP1Over K).left).map φ)
  have hφQ' : ((wcPbFun qb).map φ : Limits.pullback W.hom qb ⟶ Limits.pullback W.hom qb) =
      φQ := by
    apply Limits.pullback.hom_ext
    · refine Eq.trans ?_ hφQ1.symm
      first
        | exact (congrArg (fun f => f ≫ Limits.pullback.fst W.hom qb) e2).trans
            (Limits.pullback.lift_fst _ _ _)
        | exact Limits.pullback.lift_fst _ _ _
        | (simp [wcPbFun, Over.pullback_map_left])
    · refine Eq.trans ?_ hφQ2.symm
      first
        | exact (congrArg (fun f => f ≫ Limits.pullback.snd W.hom qb) e2).trans
            (Limits.pullback.lift_snd _ _ _)
        | exact Limits.pullback.lift_snd _ _ _
        | (simp [wcPbFun, Over.pullback_map_left])
  have keyA : ∀ (z : ↥(Limits.pullback W.hom qb))
      (s : (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ).obj.obj (Opposite.op W)),
      Θ (((wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ a ha).hom.app (Opposite.op W)).hom s) z =
        Θ s (aQ z) := by
    intro z s
    obtain ⟨x, rfl⟩ := (hbij PG).2 s
    have k1 := congrArg (fun s => Θ s z) (hnat x)
    have k2 := hΘt ((ηa.app (Opposite.op W)).hom x)
    have k3 := hΘt x
    refine k1.trans ((congrArg (fun f => f z) k2).trans
      (Eq.trans ?_ (congrArg (fun f => f (aQ z)) k3).symm))
    rw [← haQ']
    all_goals rfl
  have keyφ : ∀ (z : ↥(Limits.pullback W.hom qb))
      (s : (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ).obj.obj (Opposite.op W)),
      Θ (((wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ).obj.map φ.op).hom s) z =
        Θ s (φQ z) := by
    intro z s
    obtain ⟨x, rfl⟩ := (hbij PG).2 s
    have k1 := congrArg (fun s => Θ s z) (hnatφ x)
    have k2 := hΘt ((PG.map φ.op).hom x)
    have k3 := hΘt x
    refine k1.trans ((congrArg (fun f => f z) k2).trans
      (Eq.trans ?_ (congrArg (fun f => f (φQ z)) k3).symm))
    rw [← hφQ']
    all_goals rfl

  refine ⟨τ.symm.trans ((ev W _).trans Θ), ?_, ?_⟩
  · intro y z
    obtain ⟨w, rfl⟩ := τ.surjective y
    simp only [AddEquiv.trans_apply, AddEquiv.symm_apply_apply]
    have h1 : τ.symm ((Abelian.Ext.mk₀ σD).postcomp (wcFreeSheaf (wcP1Over K).left W)
        (add_zero 0) (τ w)) =
        (Abelian.Ext.mk₀ (wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ a ha)).postcomp
          (wcFreeSheaf (wcP1Over K).left W) (add_zero 0) w := by
      rw [hτσ, AddEquiv.symm_apply_apply]
    rw [h1, hev1]
    exact keyA z _
  · intro y z
    obtain ⟨w, rfl⟩ := τ.surjective y
    simp only [AddEquiv.trans_apply, AddEquiv.symm_apply_apply]
    have h2 : τ.symm ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left φ)).precomp
        (Limits.cokernel ιF) (zero_add 0) (τ w)) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left φ)).precomp
          (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) (zero_add 0) w := by
      rw [hτφ, AddEquiv.symm_apply_apply]
    rw [h2, hev2]
    exact keyφ z _

theorem wc_finite_point_eq_of_sepClosed : ∀ {Q W : Scheme.{u}} (f : Q ⟶ W) [IsFinite f] (L : Type u) [Field L] (z₁ z₂ : Spec (.of L) ⟶ Q) (w : W), z₁ ≫ f = z₂ ≫ f → z₁ (IsLocalRing.closedPoint L) = z₂ (IsLocalRing.closedPoint L) → f (z₁ (IsLocalRing.closedPoint L)) = w → IsSepClosed (W.residueField w) → z₁ = z₂ :=
by
  intro Q W f _ L _ z₁ z₂ w hcomp hpt hw hsep
  subst hw

  have hfin : (f.residueFieldMap (z₁ (IsLocalRing.closedPoint L))).hom.Finite := by
    generalize z₁ (IsLocalRing.closedPoint L) = x
    have h : ∀ y : Q, f y = f x → x ⤳ y → y = x := by
      intro y hy hspec
      haveI : DiscreteTopology ↑(⇑f ⁻¹' {f x}) := (Scheme.Hom.fiberHomeo f (f x)).discreteTopology
      let a : ↑(⇑f ⁻¹' {f x}) := ⟨x, rfl⟩
      let b : ↑(⇑f ⁻¹' {f x}) := ⟨y, hy⟩
      have hab : a ⤳ b := Topology.IsInducing.subtypeVal.specializes_iff.mp hspec
      exact (congrArg Subtype.val (specializes_iff_eq.mp hab)).symm
    have hsq : Q.fromSpecResidueField x ≫ f =
        Spec.map (f.residueFieldMap x) ≫ W.fromSpecResidueField (f x) :=
      (Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField f x).symm
    set p₁ := Limits.pullback.fst f (W.fromSpecResidueField (f x)) with hp₁
    set p₂ := Limits.pullback.snd f (W.fromSpecResidueField (f x)) with hp₂
    set ι : Spec (Q.residueField x) ⟶ Limits.pullback f (W.fromSpecResidueField (f x)) :=
      Limits.pullback.lift (Q.fromSpecResidueField x) (Spec.map (f.residueFieldMap x)) hsq with hι
    have h1 : ι ≫ p₁ = Q.fromSpecResidueField x := Limits.pullback.lift_fst _ _ hsq
    have h2 : ι ≫ p₂ = Spec.map (f.residueFieldMap x) := Limits.pullback.lift_snd _ _ hsq
    have hp₁pre : IsPreimmersion p₁ := inferInstance
    have : IsPreimmersion (ι ≫ p₁) := by rw [h1]; infer_instance
    have hιpre : IsPreimmersion ι := IsPreimmersion.of_comp ι p₁
    have hcl : IsClosed (Set.range ι) := by
      rw [Set.range_unique]
      apply isClosed_of_closure_subset
      intro v hv
      have hwv : ι default ⤳ v := specializes_iff_mem_closure.mpr hv
      have ha : p₁ (ι default) = x := by
        have hm : p₁ (ι default) ∈ Set.range (Q.fromSpecResidueField x) := by
          refine ⟨default, ?_⟩
          rw [← Scheme.Hom.comp_apply, h1]
        rw [Scheme.range_fromSpecResidueField] at hm
        exact hm
      have hb : x ⤳ p₁ v := by
        have := hwv.map p₁.continuous
        rwa [ha] at this
      have hc : f (p₁ v) = f x := by
        have hm : f (p₁ v) ∈ Set.range (W.fromSpecResidueField (f x)) := by
          refine ⟨p₂ v, ?_⟩
          rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hp₁, hp₂,
            Limits.pullback.condition]
        rw [Scheme.range_fromSpecResidueField] at hm
        exact hm
      have hd : p₁ v = p₁ (ι default) := by rw [h (p₁ v) hc hb, ha]
      exact Set.mem_singleton_iff.mpr ((Scheme.Hom.isEmbedding p₁).injective hd)
    have : IsClosedImmersion ι := IsClosedImmersion.of_isPreimmersion ι hcl
    have : LocallyOfFiniteType p₂ := inferInstance
    have h5 : LocallyOfFiniteType (Spec.map (f.residueFieldMap x)) := by
      rw [← h2]; infer_instance
    have h6 : (f.residueFieldMap x).hom.FiniteType :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp h5
    exact RingHom.finite_iff_finiteType_of_isJacobsonRing.mpr h6

  have e1 := Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField L Q z₁
  have e2 := Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField L Q z₂
  set φ₁ := Scheme.descResidueField (Scheme.stalkClosedPointTo z₁) with hφ₁
  set φ₂ := (Scheme.residueFieldCongr hpt).hom ≫
    Scheme.descResidueField (Scheme.stalkClosedPointTo z₂) with hφ₂
  have hz₂ : Spec.map φ₂ ≫ Q.fromSpecResidueField (z₁ (IsLocalRing.closedPoint L)) = z₂ := by
    rw [hφ₂, Spec.map_comp, Category.assoc, Scheme.residueFieldCongr_fromSpecResidueField, e2]
  have hsq := Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField f
    (z₁ (IsLocalRing.closedPoint L))
  have hr : f.residueFieldMap (z₁ (IsLocalRing.closedPoint L)) ≫ φ₁ =
      f.residueFieldMap (z₁ (IsLocalRing.closedPoint L)) ≫ φ₂ := by
    apply Spec.map_injective
    rw [← cancel_mono (W.fromSpecResidueField (f (z₁ (IsLocalRing.closedPoint L)))),
      Spec.map_comp, Spec.map_comp, Category.assoc, Category.assoc, hsq, ← Category.assoc,
      ← Category.assoc, e1, hz₂, hcomp]

  letI : Algebra (W.residueField (f (z₁ (IsLocalRing.closedPoint L))))
      (Q.residueField (z₁ (IsLocalRing.closedPoint L))) :=
    (f.residueFieldMap (z₁ (IsLocalRing.closedPoint L))).hom.toAlgebra
  haveI : Module.Finite (W.residueField (f (z₁ (IsLocalRing.closedPoint L))))
      (Q.residueField (z₁ (IsLocalRing.closedPoint L))) := hfin
  haveI : Algebra.IsIntegral (W.residueField (f (z₁ (IsLocalRing.closedPoint L))))
      (Q.residueField (z₁ (IsLocalRing.closedPoint L))) :=
    Algebra.IsIntegral.of_finite _ _
  haveI : IsPurelyInseparable (W.residueField (f (z₁ (IsLocalRing.closedPoint L))))
      (Q.residueField (z₁ (IsLocalRing.closedPoint L))) :=
    Algebra.IsAlgebraic.isPurelyInseparable_of_isSepClosed
  have hinj := IsPurelyInseparable.injective_comp_algebraMap
    (W.residueField (f (z₁ (IsLocalRing.closedPoint L))))
    (Q.residueField (z₁ (IsLocalRing.closedPoint L))) L
  have hφ : φ₁ = φ₂ := by
    apply CommRingCat.hom_ext
    apply hinj
    have := congrArg CommRingCat.Hom.hom hr
    rw [CommRingCat.hom_comp, CommRingCat.hom_comp] at this
    exact this
  rw [← e1, ← hz₂, hφ]

theorem wc_finite_henselian_fibre_contfun_bij : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] (W Q : Scheme.{u}) (e : W ≅ Spec (.of A)) (f : Q ⟶ W) [IsFinite f] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], Finite {z : Q // e.hom (f z) = IsLocalRing.closedPoint A} ∧ Function.Bijective (fun (h : C(↥Q, ℤ_[ℓ])) (z : {z : Q // e.hom (f z) = IsLocalRing.closedPoint A}) => h z.1) :=
by
  intro A _ _ W Q e f _ ℓ _
  classical
  obtain ⟨g, hg⟩ : ∃ g : Q ⟶ Spec (.of A), g = f ≫ e.hom := ⟨_, rfl⟩
  haveI : IsFinite g := by rw [hg]; infer_instance
  have hgapp : ∀ z : Q, g z = e.hom (f z) := by
    intro z; rw [hg]; exact Scheme.Hom.comp_apply _ _ _
  have memFib : ∀ z : Q, z ∈ g ⁻¹' {IsLocalRing.closedPoint A} ↔
      e.hom (f z) = IsLocalRing.closedPoint A := by
    intro z
    exact ⟨fun h => (hgapp z).symm.trans h, fun h => (hgapp z).trans h⟩
  have hFibfin : (g ⁻¹' {IsLocalRing.closedPoint A}).Finite :=
    Scheme.Hom.finite_preimage_singleton g _
  have hDfin : Finite {z : Q // e.hom (f z) = IsLocalRing.closedPoint A} := by
    haveI := hFibfin.to_subtype
    exact Finite.of_equiv _ (Equiv.subtypeEquivRight memFib)
  have hclosed : IsClosed ({IsLocalRing.closedPoint A} : Set (Spec (.of A))) :=
    IsLocalRing.isClosed_singleton_closedPoint A

  have s1gen : ∀ (s : ↥(Spec (.of A))), IsClosed ({s} : Set ↥(Spec (.of A))) →
      ∀ x : Q, g x = s → IsClosed ({x} : Set Q) := by
    intro s hs x hx
    have hF : IsClosed (g ⁻¹' {s}) := hs.preimage g.continuous
    have : DiscreteTopology ↥(g.fiber s) := inferInstance
    have : DiscreteTopology ↥(g ⁻¹' {s}) := (Scheme.Hom.fiberHomeo g s).discreteTopology
    have hxF : x ∈ g ⁻¹' {s} := hx
    have h1 := (isClosed_discrete ({⟨x, hxF⟩} : Set ↥(g ⁻¹' {s}))).trans hF
    rwa [Set.image_singleton] at h1
  have s1 : ∀ x : Q, g x = IsLocalRing.closedPoint A → IsClosed ({x} : Set Q) :=
    fun x hx => s1gen _ hclosed x hx

  have s2 : ∀ q : Q, ∃ y : Q, g y = IsLocalRing.closedPoint A ∧ q ⤳ y := by
    intro q
    have hZ : IsClosed (g '' closure {q}) := g.isClosedMap _ isClosed_closure
    have hq : g q ∈ g '' closure {q} := Set.mem_image_of_mem _ (subset_closure rfl)
    obtain ⟨y, hy, hgy⟩ := (IsLocalRing.specializes_closedPoint (g q)).mem_closed hZ hq
    exact ⟨y, hgy, specializes_iff_mem_closure.mpr hy⟩
  refine ⟨hDfin, ?_, ?_⟩
  · intro h₁ h₂ hh
    ext q
    obtain ⟨y, hy, hqy⟩ := s2 q
    have e1 : h₁ q = h₁ y := (hqy.map h₁.continuous).eq
    have e2 : h₂ q = h₂ y := (hqy.map h₂.continuous).eq
    have e3 : h₁ y = h₂ y := congrFun hh ⟨y, (memFib y).1 hy⟩
    rw [e1, e2, e3]
  · intro c
    haveI := Fintype.ofFinite {z : Q // e.hom (f z) = IsLocalRing.closedPoint A}
    have hsplit : ∀ d : {z : Q // e.hom (f z) = IsLocalRing.closedPoint A},
        ∃ C : Set Q, IsClopen C ∧ ∀ x : Q, g x = IsLocalRing.closedPoint A →
          (x ∈ C ↔ x ∈ ({d.1} : Set Q)) := by
      intro d
      have hd : g d.1 = IsLocalRing.closedPoint A := (hgapp d.1).trans d.2
      apply wc_proper_henselian_closed_fibre_clopen_extend A Q g {d.1}
        (g ⁻¹' {IsLocalRing.closedPoint A} \ {d.1})
      · exact s1 d.1 hd
      · rw [← Set.biUnion_of_singleton (g ⁻¹' {IsLocalRing.closedPoint A} \ {d.1})]
        exact (hFibfin.subset Set.sdiff_subset).isClosed_biUnion (fun y hy => s1 y hy.1)
      · exact Set.disjoint_sdiff_right
      · exact Set.union_sdiff_cancel (Set.singleton_subset_iff.mpr hd)
    choose C hCo hCf using hsplit
    refine ⟨⟨fun x => ∑ d, (C d).indicator (fun _ => c d) x,
      continuous_finsetSum _ (fun d _ => (hCo d).continuous_indicator continuous_const)⟩, ?_⟩
    funext d'
    have hd' : g d'.1 = IsLocalRing.closedPoint A := (hgapp d'.1).trans d'.2
    show ∑ d, (C d).indicator (fun _ => c d) d'.1 = c d'
    rw [Finset.sum_eq_single d']
    · rw [Set.indicator_of_mem ((hCf d' d'.1 hd').2 rfl)]
    · intro b _ hb
      have hnm : d'.1 ∉ C b := by
        intro hm
        exact hb (Subtype.ext ((hCf b d'.1 hd').1 hm).symm)
      rw [Set.indicator_of_notMem hnm]
    · intro h
      exact absurd (Finset.mem_univ _) h

theorem wc_strict_nbhd_fibre_perm (K : Type u) [Field K] [Finite K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (u0 : Spec (.of K) ⟶ (wcP1Over K).left) (hu0 : u0 ≫ (wcP1Over K).hom = 𝟙 _)
    (W : (wcP1Over K).left.ProEt) (A : Type u) [instA : CommRing A] [henA : HenselianLocalRing A]
    [sepA : IsSepClosed (IsLocalRing.ResidueField A)] (e : W.left ≅ Spec (.of A))
    (ε : Limits.pullback W.hom u0 ≅ Spec (.of (AlgebraicClosure K)))
    (hx : W.hom (e.inv (IsLocalRing.closedPoint A)) = u0 (IsLocalRing.closedPoint K))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) =
        Limits.pullback.snd W.hom u0)
    (φ : W ⟶ W)
    (hφε : ε.inv ≫ Limits.pullback.fst W.hom u0 ≫ φ.left =
        Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _
          (Fintype.ofFinite K) (AlgebraicClosure K) _ _ _).symm :
            AlgebraicClosure K →+* AlgebraicClosure K)) ≫
          ε.inv ≫ Limits.pullback.fst W.hom u0)
