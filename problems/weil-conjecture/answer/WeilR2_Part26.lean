  haveI : WeaklyEtale P₂.hom := P₂.prop
  haveI : WeaklyEtale (g₂.left ≫ P.hom) := by
    rw [MorphismProperty.Over.w g₂]; exact P₂.prop
  haveI hf₂ : WeaklyEtale g₂.left := WeaklyEtale.of_comp g₂.left P.hom
  have hfe : WeaklyEtale (Limits.pullback.fst g₁.left g₂.left) := inferInstance
  have hPe : WeaklyEtale (Limits.pullback.fst g₁.left g₂.left ≫ P₁.hom) :=
    @MorphismProperty.comp_mem _ _ @WeaklyEtale
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      _ _ _ _ _ hfe P₁.prop
  let P₁₂ : X.ProEt := @Scheme.ProEt.mk X _ (Limits.pullback.fst g₁.left g₂.left ≫ P₁.hom) hPe
  have h₂ : Limits.pullback.snd g₁.left g₂.left ≫ P₂.hom =
      Limits.pullback.fst g₁.left g₂.left ≫ P₁.hom := by
    rw [← MorphismProperty.Over.w g₂, ← MorphismProperty.Over.w g₁, ← Category.assoc,
      ← Category.assoc, Limits.pullback.condition]
  let k₁ : P₁₂ ⟶ P₁ := MorphismProperty.Over.homMk (Limits.pullback.fst g₁.left g₂.left) rfl trivial
  let k₂ : P₁₂ ⟶ P₂ := MorphismProperty.Over.homMk (Limits.pullback.snd g₁.left g₂.left) h₂ trivial
  obtain ⟨z, hz₁, hz₂⟩ :=
    Scheme.Pullback.exists_preimage_pullback (f := g₁.left) (g := g₂.left) p₁ p₂ h
  refine ⟨P₁₂, k₁, k₂, z, ?_, hz₁, hz₂⟩
  apply MorphismProperty.Over.Hom.ext
  show Limits.pullback.fst g₁.left g₂.left ≫ g₁.left = Limits.pullback.snd g₁.left g₂.left ≫ g₂.left
  exact Limits.pullback.condition

theorem wc_ltl_int (X : Scheme.{u}) (Z : Set X) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (G : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (σ : ℚ_[ℓ] → (G ⟶ G))
    (W : X.ProEt) (θ : G.over W ≅ (wcContSheaf X (Fin r → ℚ_[ℓ])).over W)
    (hθ : ∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology X).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫
        θ.hom = θ.hom ≫ ((Scheme.ProEt.topology X).overPullback AddCommGrpCat.{u+1} W).map
          (wcConstScalar X ℓ r c))
    (hWU : ∀ z : W.left, W.hom z ∉ Z)
    (N : ↥(Limits.pullback W.hom W.hom) → GL (Fin r) ℤ_[ℓ])
    (hTR : ∀ (T : X.ProEt) (a b : T ⟶ W) (s : G.obj.obj (Opposite.op T)) (z : T.left),
        wcLtcVal θ a s z = Matrix.vecMul (wcLtcVal θ b s z)
          ((N (wcLtcPair a b z) : Matrix (Fin r) (Fin r) ℤ_[ℓ]).map
            (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ]))))
    (L : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (ι : L ⟶ G)
    (hL : ∀ (T : X.ProEt) (s : G.obj.obj (Opposite.op T)),
        (∃ t, (ι.hom.app (Opposite.op T)).hom t = s) ↔
          ∃ R : Sieve T, R ∈ Scheme.ProEt.topology X T ∧
            ∀ (T' : X.ProEt) (g : T' ⟶ T), R.arrows g →
              ((∀ t, T'.hom t ∉ Z) ∧
                ∀ (T'' : X.ProEt) (h : T'' ⟶ T') (b : T'' ⟶ W) (z : T''.left)
                  (i : Fin r), ‖wcLtcVal θ b ((G.obj.map (h ≫ g).op).hom s) z i‖ ≤ 1) ∨
              (G.obj.map g.op).hom s = 0) :
    (∀ (T : X.ProEt) (t : L.obj.obj (Opposite.op T)) (b : T ⟶ W) (z : T.left) (i : Fin r),
        ‖wcLtcVal θ b ((ι.hom.app (Opposite.op T)).hom t) z i‖ ≤ 1) ∧
    (∀ (T : X.ProEt) (b : T ⟶ W) (y : G.obj.obj (Opposite.op T)),
        (∀ (z : T.left) (i : Fin r), ‖wcLtcVal θ b y z i‖ ≤ 1) →
        ∃ t, (ι.hom.app (Opposite.op T)).hom t = y) :=
by
  have val1 : ∀ (T T' : X.ProEt) (c : T' ⟶ T) (b : T ⟶ W) (x : G.obj.obj (Opposite.op T))
      (z : T'.left), wcLtcVal θ (c ≫ b) ((G.obj.map c.op).hom x) z = wcLtcVal θ b x (c.left z) := by
    intro T T' c b x z
    have h := congrArg (fun φ => AddCommGrpCat.Hom.hom φ x)
      (θ.hom.hom.naturality (Over.homMk c rfl : Over.mk (c ≫ b) ⟶ Over.mk b).op)
    exact congrArg (fun w => (show C(↥T'.left, Fin r → ℚ_[ℓ]) from w.down) z) h
  have cs1 : ∀ (T : X.ProEt) (R : Sieve T), R ∈ Scheme.ProEt.topology X T →
      ∀ τ : T.left, ∃ (W' : X.ProEt) (f : W' ⟶ T), R.arrows f ∧ τ ∈ Set.range f.left := by
    intro T R hR
    have fact : ∀ {Z' : Scheme.{u}} (g : Z' ⟶ T.left),
        (Sieve.overEquiv ((Scheme.ProEt.forget X).obj T)
          (Sieve.functorPushforward (Scheme.ProEt.forget X) R)).arrows g →
        ∃ (W' : X.ProEt) (f : W' ⟶ T) (e : Z' ⟶ W'.left), R.arrows f ∧ g = e ≫ f.left := by
      intro Z' g hg
      have hg' := (Sieve.overEquiv_iff _ g).mp hg
      obtain ⟨W', φ, ψ, hφ, heq⟩ := hg'
      refine ⟨W', φ, ψ.left, hφ, ?_⟩
      have := congrArg CommaMorphism.left heq
      simp only [Over.homMk_left, Over.comp_left] at this
      exact this
    have hS : Sieve.overEquiv ((Scheme.ProEt.forget X).obj T)
        (Sieve.functorPushforward (Scheme.ProEt.forget X) R) ∈ Scheme.proetaleTopology T.left :=
      (GrothendieckTopology.mem_over_iff _ _).mp ((CoverPreserving.of_isContinuous
        (Scheme.ProEt.forget X) (Scheme.ProEt.topology X)
          (Scheme.proetaleTopology.over X)).cover_preserve hR)
    obtain ⟨R', hR', hle⟩ :=
      (Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition
        (J := Scheme.proetalePrecoverage)).mp hS
    obtain ⟨𝒰, h𝒰, hR'eq⟩ := (Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover).mp hR'
    haveI := h𝒰
    have hmem : ∀ j, (Sieve.overEquiv ((Scheme.ProEt.forget X).obj T)
        (Sieve.functorPushforward (Scheme.ProEt.forget X) R)).arrows (𝒰.f j) := by
      intro j
      apply hle
      rw [hR'eq]
      exact Presieve.ofArrows.mk j
    choose Wc fc ec hfc hec using fun j => fact (𝒰.f j) (hmem j)
    intro τ
    obtain ⟨U, hUa, hτU, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := τ) trivial
    obtain ⟨n, c, V, hV, hUeq⟩ :=
      QuasiCompactCover.exists_isAffineOpen_of_isCompact 𝒰.toPreZeroHypercover hUa.isCompact
    have hτ' : τ ∈ (U : Set T.left) := hτU
    rw [← hUeq] at hτ'
    obtain ⟨i, z, hz, hzτ⟩ := Set.mem_iUnion.mp hτ'
    refine ⟨Wc (c i), fc (c i), hfc _, ec (c i) z, ?_⟩
    rw [← hzτ, hec (c i), Scheme.Hom.comp_apply]
  have val0 : ∀ (T : X.ProEt) (a : T ⟶ W) (z : T.left), wcLtcVal θ a 0 z = 0 := by
    intro T a z
    have e2 : (θ.hom.hom.app (Opposite.op (Over.mk a))).hom 0 = 0 :=
      (θ.hom.hom.app (Opposite.op (Over.mk a))).hom.map_zero
    exact congrArg (fun w => (show C(↥T.left, Fin r → ℚ_[ℓ]) from w.down) z) e2
  have intv : ∀ (v : Fin r → ℚ_[ℓ]), (∀ j, ‖v j‖ ≤ 1) →
      ∀ (A : Matrix (Fin r) (Fin r) ℤ_[ℓ]) (i : Fin r),
      ‖Matrix.vecMul v (A.map (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ]))) i‖ ≤ 1 := by
    intro v hv A i
    simp only [Matrix.vecMul, dotProduct]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg zero_le_one
    intro j _
    rw [norm_mul]
    have h1 : ‖((A.map (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ]))) j i)‖ ≤ 1 := by
      rw [Matrix.map_apply, ← PadicInt.norm_def]
      exact PadicInt.norm_le_one _
    exact mul_le_one₀ (hv j) (norm_nonneg _) h1
  refine ⟨?_, ?_⟩
  · intro T t b z i
    obtain ⟨R, hR, hRg⟩ := (hL T _).mp ⟨t, rfl⟩
    obtain ⟨T', f, hf, z', rfl⟩ := cs1 T R hR z
    rw [← val1 T T' f b]
    rcases hRg T' f hf with ⟨-, hint⟩ | hz
    · have := hint T' (𝟙 T') (f ≫ b) z' i
      rwa [Category.id_comp] at this
    · rw [hz, val0, Pi.zero_apply, norm_zero]
      exact zero_le_one
  · intro T b y hy
    refine (hL T y).mpr ⟨⊤, (Scheme.ProEt.topology X).top_mem T, ?_⟩
    intro T' g _
    left
    refine ⟨?_, ?_⟩
    · intro t'
      have e1 := MorphismProperty.Over.w g
      have e2 := MorphismProperty.Over.w b
      rw [← e1, ← e2, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
      exact hWU _
    · intro T'' h b' z i
      rw [hTR T'' b' ((h ≫ g) ≫ b), val1 T T'' (h ≫ g) b y z]
      exact intv _ (fun j => hy _ j) _ i

theorem wc_ltl_uniq (X : Scheme.{u}) (Z : Set X) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (G : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (σ : ℚ_[ℓ] → (G ⟶ G))
    (W : X.ProEt) (θ : G.over W ≅ (wcContSheaf X (Fin r → ℚ_[ℓ])).over W)
    (hθ : ∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology X).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫
        θ.hom = θ.hom ≫ ((Scheme.ProEt.topology X).overPullback AddCommGrpCat.{u+1} W).map
          (wcConstScalar X ℓ r c))
    (hWqc : QuasiCompact W.hom) (hWs : ∀ p : X, p ∉ Z → ∃ z : W.left, W.hom z = p)
    (L : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (ι : L ⟶ G)
    (lam : ℤ_[ℓ] → (L ⟶ L)) (hlamι : ∀ a : ℤ_[ℓ], lam a ≫ ι = ι ≫ σ (a : ℚ_[ℓ]))
    (hmono : Mono ι)
    (hL' : ∀ (T : X.ProEt) (t : L.obj.obj (Opposite.op T)), ∃ R : Sieve T,
        R ∈ Scheme.ProEt.topology X T ∧ ∀ (T' : X.ProEt) (g : T' ⟶ T), R.arrows g →
          (∀ t', T'.hom t' ∉ Z) ∨ (G.obj.map g.op).hom ((ι.hom.app (Opposite.op T)).hom t) = 0)
    (hINT : ∀ (T : X.ProEt) (t : L.obj.obj (Opposite.op T)) (b : T ⟶ W) (z : T.left)
        (i : Fin r), ‖wcLtcVal θ b ((ι.hom.app (Opposite.op T)).hom t) z i‖ ≤ 1)
    (Q : ℕ → Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
    (π : ∀ n, L ⟶ Q n)
    (hex : ∀ n, 1 ≤ n → ∃ w : lam ((ℓ : ℤ_[ℓ]) ^ n) ≫ π n = 0,
      (ShortComplex.mk _ _ w).ShortExact) :
    ∀ (T : X.ProEt) (s : L.obj.obj (Opposite.op T)),
      (∀ n, 1 ≤ n → ((π n).hom.app (Opposite.op T)).hom s = 0) → s = 0 :=
by
  classical

  have nat : ∀ {A B : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}}
      (φ : A ⟶ B) {T T' : X.ProEt} (h : T' ⟶ T) (y : A.obj.obj (Opposite.op T)),
      (φ.hom.app (Opposite.op T')).hom ((A.obj.map h.op).hom y) =
        (B.obj.map h.op).hom ((φ.hom.app (Opposite.op T)).hom y) := by
    intro A B φ T T' h y
    have e := congrArg (fun f => f.hom y) (φ.hom.naturality h.op)
    simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] using e
  have fcomp : ∀ (A : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
      {T T' T'' : X.ProEt} (k : T'' ⟶ T') (h : T' ⟶ T)
      (y : A.obj.obj (Opposite.op T)),
      (A.obj.map (k ≫ h).op).hom y = (A.obj.map k.op).hom ((A.obj.map h.op).hom y) := by
    intro A T T' T'' k h y
    rw [op_comp, Functor.map_comp]
    rfl
  have val2 : ∀ (T : X.ProEt) (b : T ⟶ W) (a : ℚ_[ℓ]) (x : G.obj.obj (Opposite.op T))
      (z : T.left),
      wcLtcVal θ b (((σ a).hom.app (Opposite.op T)).hom x) z = a • wcLtcVal θ b x z := by
    intro T b a x z
    have h := congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk b))).hom x) (hθ a)
    exact congrArg (fun w => (show C(↥T.left, Fin r → ℚ_[ℓ]) from w.down) z) h
  have val3 : ∀ (T : X.ProEt) (b : T ⟶ W) (x x' : G.obj.obj (Opposite.op T)),
      (∀ z, wcLtcVal θ b x z = wcLtcVal θ b x' z) → x = x' := by
    intro T b x x' H
    have hinv : ∀ y : G.obj.obj (Opposite.op T),
        (θ.inv.hom.app (Opposite.op (Over.mk b))).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom y) = y :=
      fun y => congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk b))).hom y) θ.hom_inv_id
    have heq : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom x =
        (θ.hom.hom.app (Opposite.op (Over.mk b))).hom x' :=
      ULift.ext _ _ (ContinuousMap.ext H)
    rw [← hinv x, heq, hinv x']

  have padic : ∀ v : Fin r → ℚ_[ℓ], (∀ n : ℕ, 1 ≤ n → ∃ w : Fin r → ℚ_[ℓ],
      (∀ i, ‖w i‖ ≤ 1) ∧ v = ((ℓ : ℚ_[ℓ]) ^ n) • w) → v = 0 := by
    intro v h
    funext i
    show v i = 0
    by_contra hvi
    have hpos : 0 < ‖v i‖ := norm_pos_iff.mpr hvi
    have hq1 : ‖(ℓ : ℚ_[ℓ])‖ < 1 := Padic.norm_p_lt_one
    obtain ⟨N, hN⟩ := exists_pow_lt_of_lt_one hpos hq1
    obtain ⟨w, hw, hvw⟩ := h (N + 1) (by omega)
    have e : v i = (ℓ : ℚ_[ℓ]) ^ (N + 1) * w i := by
      rw [hvw, Pi.smul_apply, smul_eq_mul]
    have h1 : ‖v i‖ ≤ ‖(ℓ : ℚ_[ℓ])‖ ^ (N + 1) := by
      rw [e, norm_mul, norm_pow]
      exact mul_le_of_le_one_right (by positivity) (hw i)
    have h2 : ‖(ℓ : ℚ_[ℓ])‖ ^ (N + 1) ≤ ‖(ℓ : ℚ_[ℓ])‖ ^ N :=
      pow_le_pow_of_le_one (norm_nonneg _) hq1.le (by omega)
    linarith

  have hval0 : ∀ (P : X.ProEt) (b : P ⟶ W) (z : P.left),
      wcLtcVal θ b (0 : G.obj.obj (Opposite.op P)) z = 0 := by
    intro P b z
    have h := val2 P b 0 0 z
    rw [map_zero, zero_smul] at h
    exact h

  have hinj : ∀ T : X.ProEt, Function.Injective (ι.hom.app (Opposite.op T)) := fun T =>
    (AddCommGrpCat.mono_iff_injective (ι.hom.app (Opposite.op T))).mp
      (Functor.map_mono (sheafToPresheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1} ⋙
        (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op T)) ι)

  have hdiv : ∀ (P : X.ProEt) (s : L.obj.obj (Opposite.op P)) (n : ℕ), 1 ≤ n →
      ((π n).hom.app (Opposite.op P)).hom s = 0 →
      ∃ t : L.obj.obj (Opposite.op P),
        ((lam ((ℓ : ℤ_[ℓ]) ^ n)).hom.app (Opposite.op P)).hom t = s := by
    intro P s n hn hs
    obtain ⟨w, hS⟩ := hex n hn
    haveI := hS.mono_f
    have hE := hS.exact.map_of_mono_of_preservesKernel
      (sheafToPresheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1} ⋙
        (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op P)) hS.mono_f inferInstance
    obtain ⟨x, hx⟩ := (ShortComplex.ab_exact_iff _).mp hE s hs
    exact ⟨x, hx⟩

  have framed : ∀ (P : X.ProEt) (b : P ⟶ W) (s : L.obj.obj (Opposite.op P)),
      (∀ n, 1 ≤ n → ((π n).hom.app (Opposite.op P)).hom s = 0) →
      (ι.hom.app (Opposite.op P)).hom s = 0 := by
    intro P b s hs
    apply val3 P b
    intro z
    rw [hval0]
    apply padic
    intro n hn
    obtain ⟨t, ht⟩ := hdiv P s n hn (hs n hn)
    refine ⟨wcLtcVal θ b ((ι.hom.app (Opposite.op P)).hom t) z, fun i => hINT P t b z i, ?_⟩
    have hc : (ι.hom.app (Opposite.op P)).hom
          (((lam ((ℓ : ℤ_[ℓ]) ^ n)).hom.app (Opposite.op P)).hom t) =
        ((σ (((ℓ : ℤ_[ℓ]) ^ n : ℤ_[ℓ]) : ℚ_[ℓ])).hom.app (Opposite.op P)).hom
          ((ι.hom.app (Opposite.op P)).hom t) := by
      have := ConcreteCategory.congr_hom
        (congrArg (fun φ : L ⟶ G => φ.hom.app (Opposite.op P)) (hlamι ((ℓ : ℤ_[ℓ]) ^ n))) t
      exact this
    rw [← ht, hc, val2]
    congr 1

  have sep : ∀ {T : X.ProEt} (R : Sieve T), R ∈ Scheme.ProEt.topology X T →
      ∀ y : G.obj.obj (Opposite.op T),
        (∀ (T' : X.ProEt) (g : T' ⟶ T), R.arrows g → (G.obj.map g.op).hom y = 0) → y = 0 := by
    intro T R hR y hy
    exact G.isSeparated T R hR y 0 (fun T' g hg => (hy T' g hg).trans (map_zero _).symm)

  intro T s hs
  apply hinj T
  rw [map_zero]
  show (ι.hom.app (Opposite.op T)).hom s = 0
  obtain ⟨R, hR, hRg⟩ := hL' T s
  refine sep R hR _ ?_
  intro T' g hg
  rcases hRg T' g hg with hU | h0
  · obtain ⟨P, p, b, hcov⟩ : ∃ (P : X.ProEt) (p : P ⟶ T') (b : P ⟶ W),
        Sieve.generate (Presieve.singleton p) ∈ Scheme.ProEt.topology X T' := by
      haveI : WeaklyEtale W.hom := W.prop
      haveI : WeaklyEtale T'.hom := T'.prop
      haveI : QuasiCompact W.hom := hWqc
      have hfe : WeaklyEtale (Limits.pullback.fst T'.hom W.hom) := inferInstance
      have hPe : WeaklyEtale (Limits.pullback.fst T'.hom W.hom ≫ T'.hom) :=
        @MorphismProperty.comp_mem _ _ @WeaklyEtale
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition
          _ _ _ _ _ hfe T'.prop
      let P : X.ProEt := @Scheme.ProEt.mk X _ (Limits.pullback.fst T'.hom W.hom ≫ T'.hom) hPe
      have h₂ : Limits.pullback.snd T'.hom W.hom ≫ W.hom =
          Limits.pullback.fst T'.hom W.hom ≫ T'.hom := Limits.pullback.condition.symm
      let p : P ⟶ T' := MorphismProperty.Over.homMk (Limits.pullback.fst T'.hom W.hom) rfl trivial
      let b : P ⟶ W := MorphismProperty.Over.homMk (Limits.pullback.snd T'.hom W.hom) h₂ trivial
      have hsurj : Function.Surjective (Limits.pullback.fst T'.hom W.hom) := by
        intro t
        obtain ⟨w, hw⟩ := hWs (T'.hom t) (hU t)
        obtain ⟨z, hz, -⟩ :=
          Scheme.Pullback.exists_preimage_pullback (f := T'.hom) (g := W.hom) t w hw.symm
        exact ⟨z, hz⟩
      have hcov : Sieve.generate (Presieve.singleton p) ∈ Scheme.ProEt.topology X T' := by
        haveI : Surjective (Limits.pullback.fst T'.hom W.hom) := ⟨hsurj⟩
        have hb : Presieve.singleton (Limits.pullback.fst T'.hom W.hom) ∈
            Scheme.proetalePrecoverage.coverings T'.left :=
          Scheme.Hom.singleton_mem_propQCPrecoverage (P := @WeaklyEtale) hfe
        apply Precoverage.generate_mem_toGrothendieck
        apply Precoverage.mem_comap_iff.mpr
        rw [Presieve.map_singleton]
        exact hb
      exact ⟨P, p, b, hcov⟩
    refine sep _ hcov _ ?_
    intro Y f hf
    obtain ⟨Y', h, g', hg', rfl⟩ := hf
    cases hg'
    rw [fcomp]
    have key : (G.obj.map p.op).hom ((G.obj.map g.op).hom ((ι.hom.app (Opposite.op T)).hom s))
        = 0 := by
      rw [← fcomp, ← nat]
      apply framed P b
      intro n hn
      rw [nat, hs n hn, map_zero]
    rw [key, map_zero]
  · exact h0

theorem wc_ltl_loc (X : Scheme.{u}) (Z : Set X) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G L : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (ι : L ⟶ G)
    (lam : ℤ_[ℓ] → (L ⟶ L))
    (hL' : ∀ (T : X.ProEt) (t : L.obj.obj (Opposite.op T)), ∃ R : Sieve T,
        R ∈ Scheme.ProEt.topology X T ∧ ∀ (T' : X.ProEt) (g : T' ⟶ T), R.arrows g →
          (∀ t', T'.hom t' ∉ Z) ∨ (G.obj.map g.op).hom ((ι.hom.app (Opposite.op T)).hom t) = 0)
    (Q : ℕ → Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
    (π : ∀ n, L ⟶ Q n)
    (hex : ∀ n, 1 ≤ n → ∃ w : lam ((ℓ : ℤ_[ℓ]) ^ n) ≫ π n = 0,
      (ShortComplex.mk _ _ w).ShortExact) :
    ∀ n, 1 ≤ n → ∀ (T : X.ProEt) (x : (Q n).obj.obj (Opposite.op T)), ∃ R : Sieve T,
      R ∈ Scheme.ProEt.topology X T ∧ ∀ (T' : X.ProEt) (g : T' ⟶ T), R.arrows g →
        ∃ s : L.obj.obj (Opposite.op T'),
          ((π n).hom.app (Opposite.op T')).hom s = ((Q n).obj.map g.op).hom x ∧
          ((∀ t, T'.hom t ∉ Z) ∨ (ι.hom.app (Opposite.op T')).hom s = 0) :=
by
  intro n hn T x
  obtain ⟨w, hSE⟩ := hex n hn
  have nat : ∀ {A B : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}}
      (φ : A ⟶ B) {T T' : X.ProEt} (h : T' ⟶ T) (y : A.obj.obj (Opposite.op T)),
      (φ.hom.app (Opposite.op T')).hom ((A.obj.map h.op).hom y) =
        (B.obj.map h.op).hom ((φ.hom.app (Opposite.op T)).hom y) := by
    intro A B φ T T' h y
    have e := congrArg (fun f => f.hom y) (φ.hom.naturality h.op)
    simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] using e
  have fcomp : ∀ (A : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
      {T T' T'' : X.ProEt} (k : T'' ⟶ T') (h : T' ⟶ T)
      (y : A.obj.obj (Opposite.op T)),
      (A.obj.map (k ≫ h).op).hom y = (A.obj.map k.op).hom ((A.obj.map h.op).hom y) := by
    intro A T T' T'' k h y
    rw [op_comp, Functor.map_comp]
    rfl
  have hepi : Epi (π n) := hSE.epi_g
  have hls : Sheaf.IsLocallySurjective (π n) :=
    (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} (π n)).mpr hepi
  haveI : Presheaf.IsLocallySurjective (Scheme.ProEt.topology X) (π n).hom := hls
  have hI : Presheaf.imageSieve (π n).hom x ∈ Scheme.ProEt.topology X T :=
    Presheaf.imageSieve_mem (Scheme.ProEt.topology X) (π n).hom x
  have hlift : ∀ (T₁ : X.ProEt) (f : T₁ ⟶ T), (Presheaf.imageSieve (π n).hom x).arrows f →
      ∃ s : L.obj.obj (Opposite.op T₁),
        ((π n).hom.app (Opposite.op T₁)).hom s = ((Q n).obj.map f.op).hom x := by
    intro T₁ f hf
    obtain ⟨t, ht⟩ := hf
    exact ⟨t, ht⟩
  choose s hs using hlift
  choose Rf hRf hRf' using fun (T₁ : X.ProEt) (f : T₁ ⟶ T)
    (hf : (Presheaf.imageSieve (π n).hom x).arrows f) => hL' T₁ (s T₁ f hf)
  refine ⟨Sieve.bind (Presheaf.imageSieve (π n).hom x).arrows (fun T₁ f hf => Rf T₁ f hf),
    ?_, ?_⟩
  · exact GrothendieckTopology.bind_covering (Scheme.ProEt.topology X) hI
      (fun _ _ hf => hRf _ _ hf)
  · rintro T' g ⟨T₁, k, f, hf, hk, rfl⟩
    refine ⟨(L.obj.map k.op).hom (s T₁ f hf), ?_, ?_⟩
    · rw [nat, hs, fcomp]
    · rcases hRf' T₁ f hf T' k hk with h | h
      · exact Or.inl h
      · right
        rw [nat, h]

theorem wc_ltl_glue (X : Scheme.{u}) (L : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
    (Q : ℕ → Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (π : ∀ n, L ⟶ Q n)
    (huniq : ∀ (T : X.ProEt) (s : L.obj.obj (Opposite.op T)),
      (∀ n, 1 ≤ n → ((π n).hom.app (Opposite.op T)).hom s = 0) → s = 0) :
    ∀ (T : X.ProEt) (x : ∀ n, (Q n).obj.obj (Opposite.op T)) (R : Sieve T),
      R ∈ Scheme.ProEt.topology X T →
      (∀ (T' : X.ProEt) (h : T' ⟶ T), R.arrows h → ∃ s : L.obj.obj (Opposite.op T'),
        ∀ n, 1 ≤ n → ((π n).hom.app (Opposite.op T')).hom s = ((Q n).obj.map h.op).hom (x n)) →
      ∃ s : L.obj.obj (Opposite.op T), ∀ n, 1 ≤ n → ((π n).hom.app (Opposite.op T)).hom s = x n :=
by
  intro T x R hR hloc
  choose s hs using hloc
  have nat : ∀ (n : ℕ) {T₁ T₂ : X.ProEt} (k : T₂ ⟶ T₁) (y : L.obj.obj (Opposite.op T₁)),
      ((π n).hom.app (Opposite.op T₂)).hom ((L.obj.map k.op).hom y) =
        ((Q n).obj.map k.op).hom (((π n).hom.app (Opposite.op T₁)).hom y) := by
    intro n T₁ T₂ k y
    have e := congrArg (fun f => f.hom y) ((π n).hom.naturality k.op)
    simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] using e
  have fcomp : ∀ (A : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
      {T₀ T₁ T₂ : X.ProEt} (k : T₂ ⟶ T₁) (h : T₁ ⟶ T₀) (y : A.obj.obj (Opposite.op T₀)),
      (A.obj.map (k ≫ h).op).hom y = (A.obj.map k.op).hom ((A.obj.map h.op).hom y) := by
    intro A T₀ T₁ T₂ k h y
    rw [op_comp, Functor.map_comp]
    rfl
  have hsh : ∀ (A : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}),
      Presieve.IsSheaf (Scheme.ProEt.topology X) (A.obj ⋙ forget AddCommGrpCat.{u+1}) := by
    intro A
    have h1 := (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology X) A.obj
      (forget AddCommGrpCat.{u+1})).mp A.cond
    rwa [isSheaf_iff_isSheaf_of_type] at h1
  let fam : Presieve.FamilyOfElements (L.obj ⋙ forget AddCommGrpCat.{u+1}) R.arrows :=
    fun T' h hh => s T' h hh
  have hcomp : fam.Compatible := by
    rw [Presieve.compatible_iff_sieveCompatible]
    intro T₁ T₂ h k hh
    change s T₂ (k ≫ h) (R.downward_closed hh k) = (L.obj.map k.op).hom (s T₁ h hh)
    rw [← sub_eq_zero]
    apply huniq T₂
    intro n hn
    rw [map_sub, hs T₂ (k ≫ h) _ n hn, nat, hs T₁ h hh n hn, fcomp, sub_self]
  let t : L.obj.obj (Opposite.op T) := ((hsh L) R hR).amalgamate fam hcomp
  have hglue : ∀ (T' : X.ProEt) (h : T' ⟶ T) (hh : R.arrows h),
      (L.obj.map h.op).hom t = s T' h hh := by
    intro T' h hh
    exact ((hsh L) R hR).valid_glue hcomp h hh
  refine ⟨t, fun n hn => ?_⟩
  refine (((hsh (Q n)).isSeparated R hR).ext (fun T' h hh => ?_))
  change ((Q n).obj.map h.op).hom (((π n).hom.app (Opposite.op T)).hom t) =
    ((Q n).obj.map h.op).hom (x n)
  rw [← nat, hglue T' h hh, hs T' h hh n hn]

theorem wc_ltl_lift_W (X : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (G : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (σ : ℚ_[ℓ] → (G ⟶ G))
    (W : X.ProEt) (θ : G.over W ≅ (wcContSheaf X (Fin r → ℚ_[ℓ])).over W)
    (hθ : ∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology X).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫
        θ.hom = θ.hom ≫ ((Scheme.ProEt.topology X).overPullback AddCommGrpCat.{u+1} W).map
          (wcConstScalar X ℓ r c))
    (L : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (ι : L ⟶ G)
    (lam : ℤ_[ℓ] → (L ⟶ L)) (hlamι : ∀ a : ℤ_[ℓ], lam a ≫ ι = ι ≫ σ (a : ℚ_[ℓ]))
    (hmono : Mono ι)
    (hINT : ∀ (T : X.ProEt) (t : L.obj.obj (Opposite.op T)) (b : T ⟶ W) (z : T.left)
        (i : Fin r), ‖wcLtcVal θ b ((ι.hom.app (Opposite.op T)).hom t) z i‖ ≤ 1)
    (hINTc : ∀ (T : X.ProEt) (b : T ⟶ W) (y : G.obj.obj (Opposite.op T)),
        (∀ (z : T.left) (i : Fin r), ‖wcLtcVal θ b y z i‖ ≤ 1) →
        ∃ t, (ι.hom.app (Opposite.op T)).hom t = y)
    (Q : ℕ → Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
    (π : ∀ n, L ⟶ Q n) (τ : ∀ n, Q (n + 1) ⟶ Q n)
    (hex : ∀ n, 1 ≤ n → ∃ w : lam ((ℓ : ℤ_[ℓ]) ^ n) ≫ π n = 0,
      (ShortComplex.mk _ _ w).ShortExact)
    (hτ : ∀ n, 1 ≤ n → π (n + 1) ≫ τ n = π n)
    (hPB : ∀ (P P₁ P₂ : X.ProEt) (g₁ : P₁ ⟶ P) (g₂ : P₂ ⟶ P) (p₁ : P₁.left) (p₂ : P₂.left),
        g₁.left p₁ = g₂.left p₂ →
        ∃ (P₁₂ : X.ProEt) (k₁ : P₁₂ ⟶ P₁) (k₂ : P₁₂ ⟶ P₂) (q : P₁₂.left),
          k₁ ≫ g₁ = k₂ ≫ g₂ ∧ k₁.left q = p₁ ∧ k₂.left q = p₂) :
    ∀ (P : X.ProEt) (b : P ⟶ W) (x : ∀ n, (Q n).obj.obj (Opposite.op P)),
      (∀ n, 1 ≤ n → ((τ n).hom.app (Opposite.op P)).hom (x (n + 1)) = x n) →
      ∃ s : L.obj.obj (Opposite.op P), ∀ n, 1 ≤ n → ((π n).hom.app (Opposite.op P)).hom s = x n :=
by
  classical

  have nat : ∀ {A B : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}}
      (φ : A ⟶ B) {T T' : X.ProEt} (h : T' ⟶ T) (y : A.obj.obj (Opposite.op T)),
      (φ.hom.app (Opposite.op T')).hom ((A.obj.map h.op).hom y) =
        (B.obj.map h.op).hom ((φ.hom.app (Opposite.op T)).hom y) := by
    intro A B φ T T' h y
    have e := congrArg (fun f => f.hom y) (φ.hom.naturality h.op)
    simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] using e
  have ultra : ∀ (u v w : ℚ_[ℓ]) (e : ℝ), ‖u - v‖ ≤ e → ‖v - w‖ ≤ e → ‖u - w‖ ≤ e := by
    intro u v w e h1 h2
    calc ‖u - w‖ = ‖(u - v) + (v - w)‖ := by rw [sub_add_sub_cancel]
      _ ≤ max ‖u - v‖ ‖v - w‖ := Padic.nonarchimedean _ _
      _ ≤ e := max_le h1 h2
  have hℓ0 : (ℓ : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr (Fact.out : ℓ.Prime).ne_zero
  have hℓnorm : 0 < ‖(ℓ : ℚ_[ℓ])‖ := norm_pos_iff.mpr hℓ0
  have hpm : ∀ n m : ℕ, n ≤ m → ‖(ℓ : ℚ_[ℓ])‖ ^ m ≤ ‖(ℓ : ℚ_[ℓ])‖ ^ n := fun n m h =>
    pow_le_pow_of_le_one (norm_nonneg _) (Padic.norm_p_lt_one (p := ℓ)).le h
  have hsmall : ∀ e : ℝ, 0 < e → ∃ N : ℕ, 1 ≤ N ∧ ‖(ℓ : ℚ_[ℓ])‖ ^ N < e := by
    intro e he
    obtain ⟨N₀, hN₀⟩ := exists_pow_lt_of_lt_one he (Padic.norm_p_lt_one (p := ℓ))
    exact ⟨max N₀ 1, le_max_right _ _, lt_of_le_of_lt (hpm _ _ (le_max_left _ _)) hN₀⟩

  have val1 : ∀ (T T' : X.ProEt) (c : T' ⟶ T) (b : T ⟶ W) (y : G.obj.obj (Opposite.op T))
      (z : T'.left), wcLtcVal θ (c ≫ b) ((G.obj.map c.op).hom y) z = wcLtcVal θ b y (c.left z) := by
    intro T T' c b y z
    have h := congrArg (fun φ => AddCommGrpCat.Hom.hom φ y)
      (θ.hom.hom.naturality (Over.homMk c rfl : Over.mk (c ≫ b) ⟶ Over.mk b).op)
    exact congrArg (fun w => (show C(↥T'.left, Fin r → ℚ_[ℓ]) from w.down) z) h
  have val2 : ∀ (T : X.ProEt) (b : T ⟶ W) (a : ℚ_[ℓ]) (y : G.obj.obj (Opposite.op T))
      (z : T.left), wcLtcVal θ b (((σ a).hom.app (Opposite.op T)).hom y) z = a • wcLtcVal θ b y z := by
    intro T b a y z
    have h := congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk b))).hom y) (hθ a)
    exact congrArg (fun w => (show C(↥T.left, Fin r → ℚ_[ℓ]) from w.down) z) h
  have val3 : ∀ (T : X.ProEt) (b : T ⟶ W) (y y' : G.obj.obj (Opposite.op T)),
      (∀ z, wcLtcVal θ b y z = wcLtcVal θ b y' z) → y = y' := by
    intro T b y y' H
    have hinv : ∀ v : G.obj.obj (Opposite.op T),
        (θ.inv.hom.app (Opposite.op (Over.mk b))).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom v) = v :=
      fun v => congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk b))).hom v) θ.hom_inv_id
    have heq : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom y =
        (θ.hom.hom.app (Opposite.op (Over.mk b))).hom y' :=
      ULift.ext _ _ (ContinuousMap.ext H)
    rw [← hinv y, heq, hinv y']
  have val4 : ∀ (T : X.ProEt) (b : T ⟶ W) (f : C(T.left, Fin r → ℚ_[ℓ])),
      ∃ y : G.obj.obj (Opposite.op T), ∀ z, wcLtcVal θ b y z = f z := by
    intro T b f
    let v : ((wcContSheaf X (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op (Over.mk b)) :=
      ULift.up f
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk b))).hom v, fun z => ?_⟩
    have h := congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk b))).hom v) θ.inv_hom_id
    exact congrArg (fun w => (show C(↥T.left, Fin r → ℚ_[ℓ]) from w.down) z) h
  have hsub : ∀ (T : X.ProEt) (b : T ⟶ W) (y y' : G.obj.obj (Opposite.op T)) (z : T.left),
      wcLtcVal θ b (y - y') z = wcLtcVal θ b y z - wcLtcVal θ b y' z := by
    intro T b y y' z
    have h := map_sub (θ.hom.hom.app (Opposite.op (Over.mk b))).hom y y'
    exact congrArg (fun w => (show C(↥T.left, Fin r → ℚ_[ℓ]) from w.down) z) h
  have hvcont : ∀ (T : X.ProEt) (b : T ⟶ W) (y : G.obj.obj (Opposite.op T)),
      Continuous (fun z => wcLtcVal θ b y z) := fun T b y =>
    (show C(↥T.left, Fin r → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom y).down).continuous

  have hinj : ∀ T : X.ProEt, Function.Injective (ι.hom.app (Opposite.op T)) := fun T =>
    (AddCommGrpCat.mono_iff_injective (ι.hom.app (Opposite.op T))).mp
      (Functor.map_mono (sheafToPresheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1} ⋙
        (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op T)) ι)
  have hdiv : ∀ (T : X.ProEt) (s : L.obj.obj (Opposite.op T)) (n : ℕ), 1 ≤ n →
      ((π n).hom.app (Opposite.op T)).hom s = 0 →
      ∃ t : L.obj.obj (Opposite.op T),
        ((lam ((ℓ : ℤ_[ℓ]) ^ n)).hom.app (Opposite.op T)).hom t = s := by
    intro T s n hn hs
    obtain ⟨w, hS⟩ := hex n hn
    haveI := hS.mono_f
    have hE := hS.exact.map_of_mono_of_preservesKernel
      (sheafToPresheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1} ⋙
        (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op T)) hS.mono_f inferInstance
    obtain ⟨t, ht⟩ := (ShortComplex.ab_exact_iff _).mp hE s hs
    exact ⟨t, ht⟩
  have hkill : ∀ n, 1 ≤ n → ∀ (T : X.ProEt) (t : L.obj.obj (Opposite.op T)),
      ((π n).hom.app (Opposite.op T)).hom
        (((lam ((ℓ : ℤ_[ℓ]) ^ n)).hom.app (Opposite.op T)).hom t) = 0 := by
    intro n hn T t
    obtain ⟨w, -⟩ := hex n hn
    exact ConcreteCategory.congr_hom
      (congrArg (fun φ : L ⟶ Q n => φ.hom.app (Opposite.op T)) w) t
  have hlσ : ∀ (T : X.ProEt) (a : ℤ_[ℓ]) (t : L.obj.obj (Opposite.op T)),
      (ι.hom.app (Opposite.op T)).hom (((lam a).hom.app (Opposite.op T)).hom t) =
        ((σ (a : ℚ_[ℓ])).hom.app (Opposite.op T)).hom ((ι.hom.app (Opposite.op T)).hom t) := by
    intro T a t
    exact ConcreteCategory.congr_hom
      (congrArg (fun φ : L ⟶ G => φ.hom.app (Opposite.op T)) (hlamι a)) t
  have hI : ∀ n, 1 ≤ n → ∀ (T : X.ProEt) (y : (Q n).obj.obj (Opposite.op T)),
      Presheaf.imageSieve (π n).hom y ∈ Scheme.ProEt.topology X T := by
    intro n hn T y
    obtain ⟨w, hSE⟩ := hex n hn
    have hls : Sheaf.IsLocallySurjective (π n) :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} (π n)).mpr hSE.epi_g
    haveI : Presheaf.IsLocallySurjective (Scheme.ProEt.topology X) (π n).hom := hls
    exact Presheaf.imageSieve_mem (Scheme.ProEt.topology X) (π n).hom y
  have hlift : ∀ n (T T₁ : X.ProEt) (y : (Q n).obj.obj (Opposite.op T)) (f : T₁ ⟶ T),
      (Presheaf.imageSieve (π n).hom y).arrows f →
      ∃ s' : L.obj.obj (Opposite.op T₁),
        ((π n).hom.app (Opposite.op T₁)).hom s' = ((Q n).obj.map f.op).hom y := by
    intro n T T₁ y f hf
    obtain ⟨t, ht⟩ := hf
    exact ⟨t, ht⟩


  have cs : ∀ (Y : Scheme.{u}) (T : Y.ProEt) (R : Sieve T), R ∈ Scheme.ProEt.topology Y T →
      (∀ τ : T.left, ∃ (W : Y.ProEt) (f : W ⟶ T), R.arrows f ∧ τ ∈ Set.range f.left) ∧
      (∀ O : Set T.left, (∀ (W : Y.ProEt) (f : W ⟶ T), R.arrows f → IsOpen (f.left ⁻¹' O)) →
        IsOpen O) := by
    have subm : ∀ (U : Scheme.{u}) (n : ℕ) (A : Fin n → Scheme.{u}) (h : ∀ i, A i ⟶ U),
        IsAffine U → (∀ i, IsAffine (A i)) → (∀ i, Flat (h i)) →
        (∀ u : U, ∃ i, u ∈ Set.range (h i)) → ∀ O : Set U, (∀ i, IsOpen ((h i) ⁻¹' O)) →
          IsOpen O := by
      intro U n A h hU hA hfl hsurj O hO
      let A' : ULift.{u} (Fin n) → Scheme.{u} := fun k => A k.down
      let h' : ∀ k, A' k ⟶ U := fun k => h k.down
      haveI : ∀ k, IsAffine (A' k) := fun k => hA k.down
      haveI : ∀ k, Flat (h' k) := fun k => hfl k.down
      have hι : ∀ k (x : A' k), (Limits.Sigma.desc h') ((Limits.Sigma.ι A' k) x) = h' k x := by
        intro k x
        rw [← Scheme.Hom.comp_apply, Limits.Sigma.ι_comp_desc]
      haveI : Surjective (Limits.Sigma.desc h') := ⟨fun y => by
        obtain ⟨i, a, ha⟩ := hsurj y
        exact ⟨Limits.Sigma.ι A' ⟨i⟩ a, by rw [hι]; exact ha⟩⟩
      haveI : QuasiCompact (Limits.Sigma.desc h') := quasiCompact_of_compactSpace _
      have hq := Flat.isQuotientMap_of_surjective (Limits.Sigma.desc h')
      rw [← hq.isCoinducing.isOpen_preimage, ← (sigmaMk A').isOpen_preimage, isOpen_sigma_iff]
      intro k
      convert hO k.down using 1
      ext x
      simp only [Set.mem_preimage, sigmaMk_mk, hι]
      rfl
    intro Y T R hR
    have fact : ∀ {Z : Scheme.{u}} (g : Z ⟶ T.left),
        (Sieve.overEquiv ((Scheme.ProEt.forget Y).obj T)
          (Sieve.functorPushforward (Scheme.ProEt.forget Y) R)).arrows g →
        ∃ (W : Y.ProEt) (f : W ⟶ T) (e : Z ⟶ W.left), R.arrows f ∧ g = e ≫ f.left := by
      intro Z g hg
      have hg' := (Sieve.overEquiv_iff _ g).mp hg
      obtain ⟨W, φ, ψ, hφ, heq⟩ := hg'
      refine ⟨W, φ, ψ.left, hφ, ?_⟩
      have := congrArg CommaMorphism.left heq
      simp only [Over.homMk_left, Over.comp_left] at this
      exact this
    have hS : Sieve.overEquiv ((Scheme.ProEt.forget Y).obj T)
        (Sieve.functorPushforward (Scheme.ProEt.forget Y) R) ∈ Scheme.proetaleTopology T.left :=
      (GrothendieckTopology.mem_over_iff _ _).mp ((CoverPreserving.of_isContinuous
        (Scheme.ProEt.forget Y) (Scheme.ProEt.topology Y)
          (Scheme.proetaleTopology.over Y)).cover_preserve hR)
    obtain ⟨R', hR', hle⟩ :=
      (Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition
        (J := Scheme.proetalePrecoverage)).mp hS
    obtain ⟨𝒰, h𝒰, hR'eq⟩ := (Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover).mp hR'
    haveI := h𝒰
    have hmem : ∀ j, (Sieve.overEquiv ((Scheme.ProEt.forget Y).obj T)
        (Sieve.functorPushforward (Scheme.ProEt.forget Y) R)).arrows (𝒰.f j) := by
      intro j
      apply hle
      rw [hR'eq]
      exact Presieve.ofArrows.mk j
    choose W f e hf he using fun j => fact (𝒰.f j) (hmem j)
    refine ⟨fun τ => ?_, fun O hO => ?_⟩
    · obtain ⟨U, hUa, hτU, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := τ) trivial
      obtain ⟨n, c, V, hV, hUeq⟩ :=
        QuasiCompactCover.exists_isAffineOpen_of_isCompact 𝒰.toPreZeroHypercover hUa.isCompact
      have hτ' : τ ∈ (U : Set T.left) := hτU
      rw [← hUeq] at hτ'
      obtain ⟨i, z, hz, hzτ⟩ := Set.mem_iUnion.mp hτ'
      refine ⟨W (c i), f (c i), hf _, e (c i) z, ?_⟩
      rw [← hzτ, he (c i), Scheme.Hom.comp_apply]
    · rw [isOpen_iff_forall_mem_open]
      intro τ hτ
      obtain ⟨U, hUa, hτU, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := τ) trivial
      obtain ⟨n, c, V, hV, hUeq⟩ :=
        QuasiCompactCover.exists_isAffineOpen_of_isCompact 𝒰.toPreZeroHypercover hUa.isCompact
      have hle' : ∀ i, V i ≤ 𝒰.f (c i) ⁻¹ᵁ U := by
        intro i z hz
        show 𝒰.f (c i) z ∈ (U : Set T.left)
        rw [← hUeq]
        exact Set.mem_iUnion_of_mem i ⟨z, hz, rfl⟩
      let h : ∀ i, (V i).toScheme ⟶ U.toScheme := fun i => (𝒰.f (c i)).resLE U (V i) (hle' i)
      have hflat : ∀ i, Flat (h i) := fun i => by
        haveI := Scheme.Cover.map_prop 𝒰 (c i)
        infer_instance
      have hcomp : ∀ i, h i ≫ U.ι = (V i).ι ≫ 𝒰.f (c i) := fun i => Scheme.Hom.resLE_comp_ι _ _
      have hsurj : ∀ y : U.toScheme, ∃ i, y ∈ Set.range (h i) := by
        intro y
        have hy : U.ι y ∈ (U : Set T.left) := by
          rw [← Scheme.Opens.range_ι]; exact ⟨y, rfl⟩
        rw [← hUeq] at hy
        obtain ⟨i, z, hz, hzy⟩ := Set.mem_iUnion.mp hy
        refine ⟨i, ⟨z, hz⟩, U.ι.isOpenEmbedding.isEmbedding.injective ?_⟩
        show (h i ≫ U.ι) ⟨z, hz⟩ = U.ι y
        rw [hcomp]
        exact hzy
      have hO' : IsOpen (U.ι ⁻¹' O) := by
        refine subm U.toScheme n (fun i => (V i).toScheme) h hUa (fun i => hV i) hflat hsurj _ ?_
        intro i
        have : (h i) ⁻¹' (U.ι ⁻¹' O) = ((V i).ι ≫ e (c i)) ⁻¹' ((f (c i)).left ⁻¹' O) := by
          ext x
          show (h i ≫ U.ι) x ∈ O ↔ ((V i).ι ≫ e (c i) ≫ (f (c i)).left) x ∈ O
          rw [hcomp, he (c i)]
        rw [this]
        exact IsOpen.preimage (Scheme.Hom.continuous _) (hO _ _ (hf _))
      refine ⟨U.ι '' (U.ι ⁻¹' O), Set.image_preimage_subset _ _,
        U.ι.isOpenEmbedding.isOpenMap _ hO', ?_⟩
      rw [Set.image_preimage_eq_inter_range, Scheme.Opens.range_ι]
      exact ⟨hτ, hτU⟩

  have hC : ∀ n, 1 ≤ n → ∀ (T : X.ProEt) (a : T ⟶ W) (s₁ s₂ : L.obj.obj (Opposite.op T)),
      ((π n).hom.app (Opposite.op T)).hom s₁ = ((π n).hom.app (Opposite.op T)).hom s₂ ↔
        ∀ (z : T.left) (i : Fin r),
          ‖wcLtcVal θ a ((ι.hom.app (Opposite.op T)).hom s₁) z i -
            wcLtcVal θ a ((ι.hom.app (Opposite.op T)).hom s₂) z i‖ ≤ ‖(ℓ : ℚ_[ℓ])‖ ^ n := by
    intro n hn T a s₁ s₂
    have hcoe : (((ℓ : ℤ_[ℓ]) ^ n : ℤ_[ℓ]) : ℚ_[ℓ]) = (ℓ : ℚ_[ℓ]) ^ n := by
      rw [PadicInt.coe_pow, PadicInt.coe_natCast]
    have hD : ∀ z, wcLtcVal θ a ((ι.hom.app (Opposite.op T)).hom (s₁ - s₂)) z =
        wcLtcVal θ a ((ι.hom.app (Opposite.op T)).hom s₁) z -
          wcLtcVal θ a ((ι.hom.app (Opposite.op T)).hom s₂) z := by
      intro z; rw [map_sub, hsub]
    constructor
    · intro h z i
      have h0 : ((π n).hom.app (Opposite.op T)).hom (s₁ - s₂) = 0 := by
        rw [map_sub, h, sub_self]
      obtain ⟨t, ht⟩ := hdiv T _ n hn h0
      have e : wcLtcVal θ a ((ι.hom.app (Opposite.op T)).hom s₁) z i -
          wcLtcVal θ a ((ι.hom.app (Opposite.op T)).hom s₂) z i =
          wcLtcVal θ a ((ι.hom.app (Opposite.op T)).hom (s₁ - s₂)) z i := by
        rw [hD]; rfl
      rw [e, ← ht, hlσ, val2, hcoe, Pi.smul_apply, smul_eq_mul, norm_mul, norm_pow]
      exact mul_le_of_le_one_right (by positivity) (hINT T t a z i)
    · intro hb
      have hc0 : (ℓ : ℚ_[ℓ]) ^ n ≠ 0 := pow_ne_zero n hℓ0
      have hnpos : 0 < ‖(ℓ : ℚ_[ℓ])‖ ^ n := pow_pos hℓnorm n
      let g : C(↥T.left, Fin r → ℚ_[ℓ]) :=
        ⟨fun z => ((ℓ : ℚ_[ℓ]) ^ n)⁻¹ • wcLtcVal θ a ((ι.hom.app (Opposite.op T)).hom (s₁ - s₂)) z,
          by
            have hc := hvcont T a ((ι.hom.app (Opposite.op T)).hom (s₁ - s₂))
            exact (continuous_const_smul (((ℓ : ℚ_[ℓ]) ^ n)⁻¹)).comp hc⟩
      obtain ⟨y, hy⟩ := val4 T a g
      obtain ⟨t, ht⟩ := hINTc T a y (by
        intro z i
        rw [hy]
        show ‖(((ℓ : ℚ_[ℓ]) ^ n)⁻¹ •
          wcLtcVal θ a ((ι.hom.app (Opposite.op T)).hom (s₁ - s₂)) z) i‖ ≤ 1
        rw [Pi.smul_apply, smul_eq_mul, norm_mul, norm_inv, norm_pow, hD, Pi.sub_apply,
          inv_mul_le_iff₀ hnpos, mul_one]
        exact hb z i)
      have hlam : ((lam ((ℓ : ℤ_[ℓ]) ^ n)).hom.app (Opposite.op T)).hom t = s₁ - s₂ := by
        apply hinj T
        show (ι.hom.app (Opposite.op T)).hom _ = (ι.hom.app (Opposite.op T)).hom _
        apply val3 T a
        intro z
        rw [hlσ, val2, ht, hy, hcoe]
        show (ℓ : ℚ_[ℓ]) ^ n • (((ℓ : ℚ_[ℓ]) ^ n)⁻¹ •
          wcLtcVal θ a ((ι.hom.app (Opposite.op T)).hom (s₁ - s₂)) z) = _
        rw [smul_smul, mul_inv_cancel₀ hc0, one_smul]
      have := hkill n hn T t
      rw [hlam, map_sub, sub_eq_zero] at this
      exact this

  intro P b x hx

  have hWD : ∀ n, 1 ≤ n → ∀ (P₁ P₂ : X.ProEt) (f₁ : P₁ ⟶ P) (f₂ : P₂ ⟶ P)
      (s₁ : L.obj.obj (Opposite.op P₁)) (s₂ : L.obj.obj (Opposite.op P₂)),
      ((π n).hom.app (Opposite.op P₁)).hom s₁ = ((Q n).obj.map f₁.op).hom (x n) →
      ((π n).hom.app (Opposite.op P₂)).hom s₂ = ((Q n).obj.map f₂.op).hom (x n) →
      ∀ (p₁ : P₁.left) (p₂ : P₂.left), f₁.left p₁ = f₂.left p₂ → ∀ i : Fin r,
        ‖wcLtcVal θ (f₁ ≫ b) ((ι.hom.app (Opposite.op P₁)).hom s₁) p₁ i -
          wcLtcVal θ (f₂ ≫ b) ((ι.hom.app (Opposite.op P₂)).hom s₂) p₂ i‖ ≤
            ‖(ℓ : ℚ_[ℓ])‖ ^ n := by
    intro n hn P₁ P₂ f₁ f₂ s₁ s₂ h₁ h₂ p₁ p₂ hp i
    obtain ⟨P₁₂, k₁, k₂, q, hk, hq₁, hq₂⟩ := hPB P P₁ P₂ f₁ f₂ p₁ p₂ hp
    have hπ : ((π n).hom.app (Opposite.op P₁₂)).hom ((L.obj.map k₁.op).hom s₁) =
        ((π n).hom.app (Opposite.op P₁₂)).hom ((L.obj.map k₂.op).hom s₂) := by
      rw [nat, nat, h₁, h₂]
      have e1 : ((Q n).obj.map k₁.op).hom (((Q n).obj.map f₁.op).hom (x n)) =
          ((Q n).obj.map (k₁ ≫ f₁).op).hom (x n) := by
        rw [op_comp, Functor.map_comp]; rfl
      have e2 : ((Q n).obj.map k₂.op).hom (((Q n).obj.map f₂.op).hom (x n)) =
          ((Q n).obj.map (k₂ ≫ f₂).op).hom (x n) := by
        rw [op_comp, Functor.map_comp]; rfl
      rw [e1, e2, hk]
    have h := (hC n hn P₁₂ (k₁ ≫ f₁ ≫ b) _ _).mp hπ q i
    have e₁ : wcLtcVal θ (k₁ ≫ f₁ ≫ b)
        ((ι.hom.app (Opposite.op P₁₂)).hom ((L.obj.map k₁.op).hom s₁)) q =
        wcLtcVal θ (f₁ ≫ b) ((ι.hom.app (Opposite.op P₁)).hom s₁) p₁ := by
      rw [nat, val1, hq₁]
    have hb₂ : k₁ ≫ f₁ ≫ b = k₂ ≫ f₂ ≫ b := by
      rw [← Category.assoc, hk, Category.assoc]
    have e₂ : wcLtcVal θ (k₁ ≫ f₁ ≫ b)
        ((ι.hom.app (Opposite.op P₁₂)).hom ((L.obj.map k₂.op).hom s₂)) q =
        wcLtcVal θ (f₂ ≫ b) ((ι.hom.app (Opposite.op P₂)).hom s₂) p₂ := by
      rw [hb₂, nat, val1, hq₂]
    rw [e₁, e₂] at h
    exact h

  have Hdat : ∀ (n : ℕ) (p : P.left), ∃ (P' : X.ProEt) (f : P' ⟶ P)
      (s' : L.obj.obj (Opposite.op P')) (p' : P'.left),
      1 ≤ n → (((π n).hom.app (Opposite.op P')).hom s' = ((Q n).obj.map f.op).hom (x n) ∧
        f.left p' = p) := by
    intro n p
    by_cases hn : 1 ≤ n
    · obtain ⟨P', f, hf, hp⟩ := (cs X P _ (hI n hn P (x n))).1 p
      obtain ⟨s', hs'⟩ := hlift n P P' (x n) f hf
      obtain ⟨p', hp'⟩ := hp
      exact ⟨P', f, s', p', fun _ => ⟨hs', hp'⟩⟩
    · exact ⟨P, 𝟙 P, 0, p, fun h => absurd h hn⟩
  choose Pc fc sc pc hsc using Hdat
  obtain ⟨a, ha⟩ : ∃ a : ℕ → P.left → Fin r → ℚ_[ℓ], ∀ n p, a n p =
      wcLtcVal θ (fc n p ≫ b) ((ι.hom.app (Opposite.op (Pc n p))).hom (sc n p)) (pc n p) :=
    ⟨_, fun _ _ => rfl⟩
  have hint_a : ∀ n p i, ‖a n p i‖ ≤ 1 := by
    intro n p i
    rw [ha]
    exact hINT _ _ _ _ _
  have hcmp : ∀ n, 1 ≤ n → ∀ (P' : X.ProEt) (f : P' ⟶ P) (s' : L.obj.obj (Opposite.op P')),
      ((π n).hom.app (Opposite.op P')).hom s' = ((Q n).obj.map f.op).hom (x n) →
      ∀ (p' : P'.left) (i : Fin r),
        ‖a n (f.left p') i - wcLtcVal θ (f ≫ b) ((ι.hom.app (Opposite.op P')).hom s') p' i‖ ≤
          ‖(ℓ : ℚ_[ℓ])‖ ^ n := by
    intro n hn P' f s' hs' p' i
    rw [ha]
    exact hWD n hn _ _ _ f _ s' (hsc n (f.left p') hn).1 hs' _ p' (hsc n (f.left p') hn).2 i
  have hcau : ∀ n, 1 ≤ n → ∀ p i, ‖a (n + 1) p i - a n p i‖ ≤ ‖(ℓ : ℚ_[ℓ])‖ ^ n := by
    intro n hn p i
    obtain ⟨h1, h2⟩ := hsc (n + 1) p (by omega)
    have e1 : ((π n).hom.app (Opposite.op (Pc (n + 1) p))).hom (sc (n + 1) p) =
        ((Q n).obj.map (fc (n + 1) p).op).hom (x n) := by
      have := ConcreteCategory.congr_hom (congrArg
        (fun φ : L ⟶ Q n => φ.hom.app (Opposite.op (Pc (n + 1) p))) (hτ n hn)) (sc (n + 1) p)
      have e2 : ((π n).hom.app (Opposite.op (Pc (n + 1) p))).hom (sc (n + 1) p) =
          ((τ n).hom.app (Opposite.op (Pc (n + 1) p))).hom
            (((π (n + 1)).hom.app (Opposite.op (Pc (n + 1) p))).hom (sc (n + 1) p)) :=
        this.symm
      rw [e2, h1, nat, hx n hn]
    have := hcmp n hn _ (fc (n + 1) p) (sc (n + 1) p) e1 (pc (n + 1) p) i
    rw [h2] at this
    rw [norm_sub_rev, ha (n + 1) p]
    exact this

  have htail : ∀ p i n, 1 ≤ n → ∀ m, n ≤ m → ‖a m p i - a n p i‖ ≤ ‖(ℓ : ℚ_[ℓ])‖ ^ n := by
    intro p i n hn m hm
    induction m, hm using Nat.le_induction with
    | base => rw [sub_self, norm_zero]; positivity
    | succ m hm ih =>
      exact ultra _ _ _ _ ((hcau m (le_trans hn hm) p i).trans (hpm _ _ hm)) ih
  have hlim : ∀ p i, ∃ v : ℚ_[ℓ], Filter.Tendsto (fun m => a m p i) Filter.atTop (nhds v) := by
    intro p i
    apply cauchySeq_tendsto_of_complete
    rw [Metric.cauchySeq_iff']
    intro e he
    obtain ⟨N, hN1, hN⟩ := hsmall e he
    exact ⟨N, fun m hm => by
      rw [dist_eq_norm]; exact lt_of_le_of_lt (htail p i N hN1 m hm) hN⟩
  choose F hF using hlim
  have hFa : ∀ n, 1 ≤ n → ∀ p i, ‖F p i - a n p i‖ ≤ ‖(ℓ : ℚ_[ℓ])‖ ^ n := by
    intro n hn p i
    have hev : ∀ᶠ m in Filter.atTop, a m p i ∈ Metric.closedBall (a n p i) (‖(ℓ : ℚ_[ℓ])‖ ^ n) :=
      Filter.eventually_atTop.mpr ⟨n, fun m hm => by
        rw [Metric.mem_closedBall, dist_eq_norm]; exact htail p i n hn m hm⟩
    have := Metric.isClosed_closedBall.mem_of_tendsto (hF p i) hev
    rwa [Metric.mem_closedBall, dist_eq_norm] at this
  have hFint : ∀ p i, ‖F p i‖ ≤ 1 := by
    intro p i
    have hev : ∀ᶠ m in Filter.atTop, a m p i ∈ Metric.closedBall (0 : ℚ_[ℓ]) 1 :=
      Filter.Eventually.of_forall (fun m => by
        rw [Metric.mem_closedBall, dist_zero_right]; exact hint_a m p i)
    have := Metric.isClosed_closedBall.mem_of_tendsto (hF p i) hev
    rwa [Metric.mem_closedBall, dist_zero_right] at this
  have hKEY : ∀ n, 1 ≤ n → ∀ (P' : X.ProEt) (f : P' ⟶ P) (s' : L.obj.obj (Opposite.op P')),
      ((π n).hom.app (Opposite.op P')).hom s' = ((Q n).obj.map f.op).hom (x n) →
      ∀ (p' : P'.left) (i : Fin r),
        ‖F (f.left p') i - wcLtcVal θ (f ≫ b) ((ι.hom.app (Opposite.op P')).hom s') p' i‖ ≤
          ‖(ℓ : ℚ_[ℓ])‖ ^ n := fun n hn P' f s' hs' p' i =>
    ultra _ _ _ _ (hFa n hn _ i) (hcmp n hn P' f s' hs' p' i)

  have hball : ∀ n, 1 ≤ n → ∀ c : Fin r → ℚ_[ℓ],
      IsOpen {p : P.left | ∀ j, ‖F p j - c j‖ ≤ ‖(ℓ : ℚ_[ℓ])‖ ^ n} := by
    intro n hn c
    apply (cs X P _ (hI n hn P (x n))).2
    intro P' f hf
    obtain ⟨s', hs'⟩ := hlift n P P' (x n) f hf
    have heq : f.left ⁻¹' {p : P.left | ∀ j, ‖F p j - c j‖ ≤ ‖(ℓ : ℚ_[ℓ])‖ ^ n} =
        ⋂ j, (fun p' => wcLtcVal θ (f ≫ b) ((ι.hom.app (Opposite.op P')).hom s') p' j) ⁻¹'
          Metric.closedBall (c j) (‖(ℓ : ℚ_[ℓ])‖ ^ n) := by
      ext p'
      simp only [Set.mem_preimage, Set.mem_setOf_eq, Set.mem_iInter, Metric.mem_closedBall,
        dist_eq_norm]
      constructor
      · intro h j
        exact ultra _ _ _ _ ((norm_sub_rev _ _).trans_le (hKEY n hn P' f s' hs' p' j)) (h j)
      · intro h j
        exact ultra _ _ _ _ (hKEY n hn P' f s' hs' p' j) (h j)
    rw [heq]
    exact isOpen_iInter_of_finite (fun j => IsOpen.preimage
      ((continuous_apply j).comp (hvcont P' (f ≫ b) _))
      (IsUltrametricDist.isOpen_closedBall _ (pow_pos hℓnorm n).ne'))
  have hFc : Continuous F := by
    apply continuous_pi
    intro i
    rw [continuous_iff_continuousAt]
    intro y₀
    rw [ContinuousAt, Metric.tendsto_nhds]
    intro e he
    obtain ⟨N, hN1, hN⟩ := hsmall e he
    have hy₀ : y₀ ∈ {p : P.left | ∀ j, ‖F p j - F y₀ j‖ ≤ ‖(ℓ : ℚ_[ℓ])‖ ^ N} := by
      intro j
      rw [sub_self, norm_zero]
      positivity
    refine Filter.eventually_of_mem ((hball N hN1 (F y₀)).mem_nhds hy₀) ?_
    intro p hp
    rw [dist_eq_norm]
    exact lt_of_le_of_lt (hp i) hN

  obtain ⟨y, hy⟩ := val4 P b ⟨F, hFc⟩
  have hy' : ∀ z, wcLtcVal θ b y z = F z := fun z => hy z
  obtain ⟨s, hs⟩ := hINTc P b y (fun z i => by rw [hy']; exact hFint z i)

  refine ⟨s, fun n hn => ?_⟩
  apply (Q n).isSeparated P _ (hI n hn P (x n))
  intro P' f hf
  obtain ⟨s', hs'⟩ := hlift n P P' (x n) f hf
  show ((Q n).obj.map f.op).hom (((π n).hom.app (Opposite.op P)).hom s) =
    ((Q n).obj.map f.op).hom (x n)
  rw [← nat, ← hs']
  apply (hC n hn P' (f ≫ b) _ _).mpr
  intro p' i
  rw [nat, val1, hs, hy']
  exact hKEY n hn P' f s' hs' p' i

theorem wc_ltl_chart_two_cover (X : Scheme.{u}) (Z : Set X) (Y : X.ProEt) (B : Type u)
    [CommRing B] (e : Y.left ≅ Spec (.of B)) (g : B)
    (hZ : ∀ y : Y.left, Y.hom y ∈ Z ↔ g ∈ (e.hom y).asIdeal) :
    ∃ (YD YE : X.ProEt) (jD : YD ⟶ Y) (jE : YE ⟶ Y),
      (∀ R : Sieve Y, R.arrows jD → R.arrows jE → R ∈ Scheme.ProEt.topology X Y) ∧
      (∀ t : YD.left, YD.hom t ∉ Z) ∧
      (∀ y : YE.left, ∃ m : YE.left, y ⤳ m ∧ YE.hom m ∈ Z) :=
by
  classical

  let M : Submonoid B :=
    { carrier := {x | ∃ b, x = 1 + g * b}
      one_mem' := ⟨0, by ring⟩
      mul_mem' := by
        rintro x y ⟨a, rfl⟩ ⟨b, rfl⟩
        exact ⟨a + b + g * a * b, by ring⟩ }
  have hM : ∀ x, x ∈ M ↔ ∃ b, x = 1 + g * b := fun x => Iff.rfl
  let φD : Spec (.of (Localization.Away g)) ⟶ Spec (.of B) :=
    Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away g)))
  let φE : Spec (.of (Localization M)) ⟶ Spec (.of B) :=
    Spec.map (CommRingCat.ofHom (algebraMap B (Localization M)))
  haveI : WeaklyEtale Y.hom := Y.prop
  haveI hDw : WeaklyEtale φD := wc_lfi_specMap_weaklyEtale B _
    (wc_localization_weaklyEtale B _ (Submonoid.powers g))
  haveI hEw : WeaklyEtale φE := wc_lfi_specMap_weaklyEtale B _
    (wc_localization_weaklyEtale B _ M)
  let YD : X.ProEt := Scheme.ProEt.mk ((φD ≫ e.inv) ≫ Y.hom)
  let YE : X.ProEt := Scheme.ProEt.mk ((φE ≫ e.inv) ≫ Y.hom)
  let jD : YD ⟶ Y := MorphismProperty.Over.homMk (A := YD) (B := Y) (φD ≫ e.inv) rfl trivial
  let jE : YE ⟶ Y := MorphismProperty.Over.homMk (A := YE) (B := Y) (φE ≫ e.inv) rfl trivial
  have hstarD : ∀ t : Spec (.of (Localization.Away g)),
      Y.hom (e.inv (φD t)) ∈ Z ↔ algebraMap B (Localization.Away g) g ∈ t.asIdeal := by
    intro t
    rw [hZ, Scheme.inv_hom_apply]
    exact Iff.rfl
  have hstarE : ∀ t : Spec (.of (Localization M)),
      Y.hom (e.inv (φE t)) ∈ Z ↔ algebraMap B (Localization M) g ∈ t.asIdeal := by
    intro t
    rw [hZ, Scheme.inv_hom_apply]
    exact Iff.rfl
  refine ⟨YD, YE, jD, jE, ?_, ?_, ?_⟩
  ·
    intro R hRD hRE
    haveI : IsAffine Y.left := IsAffine.of_isIso e.hom
    haveI := quasiSeparatedSpace_of_isAffine Y.left
    let W : Fin 2 → X.ProEt := ![YD, YE]
    let h : ∀ i, W i ⟶ Y := fun i => match i with
      | 0 => jD
      | 1 => jE
    have hcov := proet_finite_affine_jointly_surjective_covers X Y 2 W h ?_ ?_
    · refine GrothendieckTopology.superset_covering _ ?_ hcov
      rw [Sieve.generate_le_iff]
      rintro _ _ ⟨i⟩
      match i with
      | 0 => exact hRD
      | 1 => exact hRE
    · intro i
      match i with
      | 0 => show IsAffine (Spec _); infer_instance
      | 1 => show IsAffine (Spec _); infer_instance
    · intro x
      by_cases hg : g ∈ (e.hom x).asIdeal
      · have hr : e.hom x ∈ Set.range (PrimeSpectrum.comap (algebraMap B (Localization M))) := by
          rw [PrimeSpectrum.localization_comap_range (Localization M) M]
          show Disjoint (M : Set B) ((e.hom x).asIdeal : Set B)
          rw [Set.disjoint_left]
          rintro a ⟨b, rfl⟩ ha
          apply (e.hom x).isPrime.ne_top
          rw [Ideal.eq_top_iff_one]
          have h1 : g * b ∈ (e.hom x).asIdeal := Ideal.mul_mem_right _ _ hg
          have h2 := Ideal.sub_mem _ ha h1
          simpa using h2
        obtain ⟨t, ht⟩ := hr
        refine ⟨1, t, ?_⟩
        change e.inv (φE t) = x
        rw [show φE t = e.hom x from ht, Scheme.hom_inv_apply]
      · have hr : e.hom x ∈ Set.range
            (PrimeSpectrum.comap (algebraMap B (Localization.Away g))) := by
          rw [PrimeSpectrum.localization_away_comap_range (Localization.Away g) g]
          exact (PrimeSpectrum.mem_basicOpen _ _).mpr hg
        obtain ⟨t, ht⟩ := hr
        refine ⟨0, t, ?_⟩
        change e.inv (φD t) = x
        rw [show φD t = e.hom x from ht, Scheme.hom_inv_apply]
  ·
    intro t ht
    have h1 := (hstarD t).mp ht
    exact t.isPrime.ne_top
      (Ideal.eq_top_of_isUnit_mem _ h1 (IsLocalization.Away.algebraMap_isUnit g))
  ·
    intro y
    let q : PrimeSpectrum (Localization M) := y
    obtain ⟨𝔪, h𝔪, hq𝔪⟩ := Ideal.exists_le_maximal q.asIdeal q.isPrime.ne_top
    let m : PrimeSpectrum (Localization M) := ⟨𝔪, h𝔪.isPrime⟩
    have hgm : algebraMap B (Localization M) g ∈ 𝔪 := by
      by_contra hn
      obtain ⟨z, i, hi, hzi⟩ := h𝔪.exists_inv hn
      obtain ⟨xx, hs⟩ := IsLocalization.surj M z
      obtain ⟨d, hd⟩ := (hM xx.2).mp xx.2.2
      have hmem : 1 + g * (d - xx.1) ∈ M := (hM _).mpr ⟨d - xx.1, rfl⟩
      have hunit := IsLocalization.map_units (Localization M) (⟨_, hmem⟩ : M)
      have hd' : algebraMap B (Localization M) (xx.2 : B) =
          1 + algebraMap B (Localization M) g * algebraMap B (Localization M) d := by
        rw [hd, map_add, map_one, map_mul]
      have key : i * algebraMap B (Localization M) (xx.2 : B) =
          algebraMap B (Localization M) (1 + g * (d - xx.1)) := by
        rw [map_add, map_one, map_mul, map_sub]
        linear_combination (algebraMap B (Localization M) (xx.2 : B)) * hzi
          - (algebraMap B (Localization M) g) * hs + hd'
      have hiu : IsUnit i := by
        apply isUnit_of_mul_isUnit_left (y := algebraMap B (Localization M) (xx.2 : B))
        rw [key]
        exact hunit
      exact h𝔪.ne_top (Ideal.eq_top_of_isUnit_mem _ hi hiu)
    refine ⟨m, ?_, ?_⟩
    · exact (PrimeSpectrum.le_iff_specializes q m).mp hq𝔪
    · exact (hstarE m).mpr hgm

theorem wc_ltl_zero_of_local_kill (X : Scheme.{u}) (Z : Set X) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (r : ℕ) (G : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (σ : ℚ_[ℓ] → (G ⟶ G))
    (W : X.ProEt) (θ : G.over W ≅ (wcContSheaf X (Fin r → ℚ_[ℓ])).over W)
    (hθ : ∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology X).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫
        θ.hom = θ.hom ≫ ((Scheme.ProEt.topology X).overPullback AddCommGrpCat.{u+1} W).map
          (wcConstScalar X ℓ r c))
    (hWqc : QuasiCompact W.hom) (hWs : ∀ p : X, p ∉ Z → ∃ z : W.left, W.hom z = p)
    (L : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (ι : L ⟶ G)
    (lam : ℤ_[ℓ] → (L ⟶ L)) (hlamι : ∀ a : ℤ_[ℓ], lam a ≫ ι = ι ≫ σ (a : ℚ_[ℓ]))
    (hιinj : ∀ (T : X.ProEt) (s : L.obj.obj (Opposite.op T)),
        (ι.hom.app (Opposite.op T)).hom s = 0 → s = 0)
    (hINT : ∀ (T : X.ProEt) (t : L.obj.obj (Opposite.op T)) (b : T ⟶ W) (z : T.left)
        (i : Fin r), ‖wcLtcVal θ b ((ι.hom.app (Opposite.op T)).hom t) z i‖ ≤ 1)
    (Q : ℕ → Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
    (π : ∀ n, L ⟶ Q n)
    (hex : ∀ n, 1 ≤ n → ∃ w : lam ((ℓ : ℤ_[ℓ]) ^ n) ≫ π n = 0,
      (ShortComplex.mk _ _ w).ShortExact)
    (hPB : ∀ (P P₁ P₂ : X.ProEt) (g₁ : P₁ ⟶ P) (g₂ : P₂ ⟶ P) (p₁ : P₁.left) (p₂ : P₂.left),
        g₁.left p₁ = g₂.left p₂ →
        ∃ (P₁₂ : X.ProEt) (k₁ : P₁₂ ⟶ P₁) (k₂ : P₁₂ ⟶ P₂) (q : P₁₂.left),
          k₁ ≫ g₁ = k₂ ≫ g₂ ∧ k₁.left q = p₁ ∧ k₂.left q = p₂) :
    ∀ (T : X.ProEt), (∀ t, T.hom t ∉ Z) → ∀ (s : L.obj.obj (Opposite.op T)),
      (∀ (z : T.left) (n : ℕ), 1 ≤ n → ∃ (T₁ : X.ProEt) (k : T₁ ⟶ T) (q : T₁.left),
        k.left q = z ∧ ((π n).hom.app (Opposite.op T₁)).hom ((L.obj.map k.op).hom s) = 0) →
      s = 0 :=
by
  classical

  have nat : ∀ {A B : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}}
      (φ : A ⟶ B) {T T' : X.ProEt} (h : T' ⟶ T) (y : A.obj.obj (Opposite.op T)),
      (φ.hom.app (Opposite.op T')).hom ((A.obj.map h.op).hom y) =
        (B.obj.map h.op).hom ((φ.hom.app (Opposite.op T)).hom y) := by
    intro A B φ T T' h y
    have e := congrArg (fun f => f.hom y) (φ.hom.naturality h.op)
    simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] using e
  have fcomp : ∀ (A : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
      {T T' T'' : X.ProEt} (k : T'' ⟶ T') (h : T' ⟶ T)
      (y : A.obj.obj (Opposite.op T)),
      (A.obj.map (k ≫ h).op).hom y = (A.obj.map k.op).hom ((A.obj.map h.op).hom y) := by
    intro A T T' T'' k h y
    rw [op_comp, Functor.map_comp]
    rfl

  have val1 : ∀ (T T' : X.ProEt) (c : T' ⟶ T) (b : T ⟶ W) (x : G.obj.obj (Opposite.op T))
      (z : T'.left),
      wcLtcVal θ (c ≫ b) ((G.obj.map c.op).hom x) z = wcLtcVal θ b x (c.left z) := by
    intro T T' c b x z
    have h := congrArg (fun φ => AddCommGrpCat.Hom.hom φ x)
      (θ.hom.hom.naturality (Over.homMk c rfl : Over.mk (c ≫ b) ⟶ Over.mk b).op)
    exact congrArg (fun w => (show C(↥T'.left, Fin r → ℚ_[ℓ]) from w.down) z) h
  have val2 : ∀ (T : X.ProEt) (b : T ⟶ W) (a : ℚ_[ℓ]) (x : G.obj.obj (Opposite.op T))
      (z : T.left),
      wcLtcVal θ b (((σ a).hom.app (Opposite.op T)).hom x) z = a • wcLtcVal θ b x z := by
    intro T b a x z
    have h := congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk b))).hom x) (hθ a)
    exact congrArg (fun w => (show C(↥T.left, Fin r → ℚ_[ℓ]) from w.down) z) h
  have val3 : ∀ (T : X.ProEt) (b : T ⟶ W) (x x' : G.obj.obj (Opposite.op T)),
      (∀ z, wcLtcVal θ b x z = wcLtcVal θ b x' z) → x = x' := by
    intro T b x x' H
    have hinv : ∀ y : G.obj.obj (Opposite.op T),
        (θ.inv.hom.app (Opposite.op (Over.mk b))).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom y) = y :=
      fun y => congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk b))).hom y) θ.hom_inv_id
    have heq : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom x =
        (θ.hom.hom.app (Opposite.op (Over.mk b))).hom x' :=
      ULift.ext _ _ (ContinuousMap.ext H)
    rw [← hinv x, heq, hinv x']

  have padic : ∀ v : Fin r → ℚ_[ℓ], (∀ n : ℕ, 1 ≤ n → ∃ w : Fin r → ℚ_[ℓ],
      (∀ i, ‖w i‖ ≤ 1) ∧ v = ((ℓ : ℚ_[ℓ]) ^ n) • w) → v = 0 := by
    intro v h
    funext i
    show v i = 0
    by_contra hvi
    have hpos : 0 < ‖v i‖ := norm_pos_iff.mpr hvi
    have hq1 : ‖(ℓ : ℚ_[ℓ])‖ < 1 := Padic.norm_p_lt_one
    obtain ⟨N, hN⟩ := exists_pow_lt_of_lt_one hpos hq1
    obtain ⟨w, hw, hvw⟩ := h (N + 1) (by omega)
    have e : v i = (ℓ : ℚ_[ℓ]) ^ (N + 1) * w i := by
      rw [hvw, Pi.smul_apply, smul_eq_mul]
    have h1 : ‖v i‖ ≤ ‖(ℓ : ℚ_[ℓ])‖ ^ (N + 1) := by
      rw [e, norm_mul, norm_pow]
      exact mul_le_of_le_one_right (by positivity) (hw i)
    have h2 : ‖(ℓ : ℚ_[ℓ])‖ ^ (N + 1) ≤ ‖(ℓ : ℚ_[ℓ])‖ ^ N :=
      pow_le_pow_of_le_one (norm_nonneg _) hq1.le (by omega)
    linarith
  have hval0 : ∀ (P : X.ProEt) (b : P ⟶ W) (z : P.left),
      wcLtcVal θ b (0 : G.obj.obj (Opposite.op P)) z = 0 := by
    intro P b z
    have h := val2 P b 0 0 z
    rw [map_zero, zero_smul] at h
    exact h

  have hdiv : ∀ (P : X.ProEt) (s : L.obj.obj (Opposite.op P)) (n : ℕ), 1 ≤ n →
      ((π n).hom.app (Opposite.op P)).hom s = 0 →
      ∃ t : L.obj.obj (Opposite.op P),
        ((lam ((ℓ : ℤ_[ℓ]) ^ n)).hom.app (Opposite.op P)).hom t = s := by
    intro P s n hn hs
    obtain ⟨w, hS⟩ := hex n hn
    haveI := hS.mono_f
    have hE := hS.exact.map_of_mono_of_preservesKernel
      (sheafToPresheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1} ⋙
        (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op P)) hS.mono_f inferInstance
    obtain ⟨x, hx⟩ := (ShortComplex.ab_exact_iff _).mp hE s hs
    exact ⟨x, hx⟩

  have sep : ∀ {T : X.ProEt} (R : Sieve T), R ∈ Scheme.ProEt.topology X T →
      ∀ y : G.obj.obj (Opposite.op T),
        (∀ (T' : X.ProEt) (g : T' ⟶ T), R.arrows g → (G.obj.map g.op).hom y = 0) → y = 0 := by
    intro T R hR y hy
    exact G.isSeparated T R hR y 0 (fun T' g hg => (hy T' g hg).trans (map_zero _).symm)

  intro T hT s hloc
  apply hιinj T s
  obtain ⟨P, p, b, hcov⟩ : ∃ (P : X.ProEt) (p : P ⟶ T) (b : P ⟶ W),
      Sieve.generate (Presieve.singleton p) ∈ Scheme.ProEt.topology X T := by
    haveI : WeaklyEtale W.hom := W.prop
    haveI : WeaklyEtale T.hom := T.prop
    haveI : QuasiCompact W.hom := hWqc
    have hfe : WeaklyEtale (Limits.pullback.fst T.hom W.hom) := inferInstance
    have hPe : WeaklyEtale (Limits.pullback.fst T.hom W.hom ≫ T.hom) :=
      @MorphismProperty.comp_mem _ _ @WeaklyEtale
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition
        _ _ _ _ _ hfe T.prop
    let P : X.ProEt := @Scheme.ProEt.mk X _ (Limits.pullback.fst T.hom W.hom ≫ T.hom) hPe
    have h₂ : Limits.pullback.snd T.hom W.hom ≫ W.hom =
        Limits.pullback.fst T.hom W.hom ≫ T.hom := Limits.pullback.condition.symm
    let p : P ⟶ T := MorphismProperty.Over.homMk (Limits.pullback.fst T.hom W.hom) rfl trivial
    let b : P ⟶ W := MorphismProperty.Over.homMk (Limits.pullback.snd T.hom W.hom) h₂ trivial
    have hsurj : Function.Surjective (Limits.pullback.fst T.hom W.hom) := by
      intro t
      obtain ⟨w, hw⟩ := hWs (T.hom t) (hT t)
      obtain ⟨z, hz, -⟩ :=
        Scheme.Pullback.exists_preimage_pullback (f := T.hom) (g := W.hom) t w hw.symm
      exact ⟨z, hz⟩
    have hcov : Sieve.generate (Presieve.singleton p) ∈ Scheme.ProEt.topology X T := by
      haveI : Surjective (Limits.pullback.fst T.hom W.hom) := ⟨hsurj⟩
      have hb : Presieve.singleton (Limits.pullback.fst T.hom W.hom) ∈
          Scheme.proetalePrecoverage.coverings T.left :=
        Scheme.Hom.singleton_mem_propQCPrecoverage (P := @WeaklyEtale) hfe
      apply Precoverage.generate_mem_toGrothendieck
      apply Precoverage.mem_comap_iff.mpr
      rw [Presieve.map_singleton]
      exact hb
    exact ⟨P, p, b, hcov⟩
  refine sep _ hcov _ ?_
  intro Y f hf
  obtain ⟨Y', h, g', hg', rfl⟩ := hf
  cases hg'
  rw [fcomp]
  have key : (G.obj.map p.op).hom ((ι.hom.app (Opposite.op T)).hom s) = 0 := by
    rw [← nat]
    apply val3 P b
    intro z
    rw [hval0]
    apply padic
    intro n hn
    obtain ⟨T₁, k, q, hkq, hkill⟩ := hloc (p.left z) n hn
    obtain ⟨P₁₂, k₁, k₂, q', hcomm, hk₁, -⟩ := hPB T P T₁ p k z q hkq.symm
    subst hk₁
    have hπ : ((π n).hom.app (Opposite.op P₁₂)).hom ((L.obj.map (k₁ ≫ p).op).hom s) = 0 := by
      rw [hcomm, fcomp, nat, hkill, map_zero]
    obtain ⟨t, ht⟩ := hdiv P₁₂ _ n hn hπ
    refine ⟨wcLtcVal θ (k₁ ≫ b) ((ι.hom.app (Opposite.op P₁₂)).hom t) q',
      fun i => hINT P₁₂ t (k₁ ≫ b) q' i, ?_⟩
    have hc : (ι.hom.app (Opposite.op P₁₂)).hom
          (((lam ((ℓ : ℤ_[ℓ]) ^ n)).hom.app (Opposite.op P₁₂)).hom t) =
        ((σ (((ℓ : ℤ_[ℓ]) ^ n : ℤ_[ℓ]) : ℚ_[ℓ])).hom.app (Opposite.op P₁₂)).hom
          ((ι.hom.app (Opposite.op P₁₂)).hom t) := by
      have := ConcreteCategory.congr_hom
        (congrArg (fun φ : L ⟶ G => φ.hom.app (Opposite.op P₁₂)) (hlamι ((ℓ : ℤ_[ℓ]) ^ n))) t
      exact this
    rw [← val1 P P₁₂ k₁ b, ← nat, ← fcomp, ← ht, hc, val2]
    congr 1
  rw [key, map_zero]

theorem wc_ltl_vanish_spec (X : Scheme.{u}) (Z : Set X)
    (G L : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (ι : L ⟶ G)
    (hιinj : ∀ (T : X.ProEt) (s : L.obj.obj (Opposite.op T)),
        (ι.hom.app (Opposite.op T)).hom s = 0 → s = 0)
    (Q : ℕ → Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
    (π : ∀ n, L ⟶ Q n) (τ : ∀ n, Q (n + 1) ⟶ Q n)
    (hPB : ∀ (P P₁ P₂ : X.ProEt) (g₁ : P₁ ⟶ P) (g₂ : P₂ ⟶ P) (p₁ : P₁.left) (p₂ : P₂.left),
        g₁.left p₁ = g₂.left p₂ →
        ∃ (P₁₂ : X.ProEt) (k₁ : P₁₂ ⟶ P₁) (k₂ : P₁₂ ⟶ P₂) (q : P₁₂.left),
          k₁ ≫ g₁ = k₂ ≫ g₂ ∧ k₁.left q = p₁ ∧ k₂.left q = p₂)
    (hLOC : ∀ n, 1 ≤ n → ∀ (T : X.ProEt) (x : (Q n).obj.obj (Opposite.op T)), ∃ R : Sieve T,
      R ∈ Scheme.ProEt.topology X T ∧ ∀ (T' : X.ProEt) (g : T' ⟶ T), R.arrows g →
        ∃ s : L.obj.obj (Opposite.op T'),
          ((π n).hom.app (Opposite.op T')).hom s = ((Q n).obj.map g.op).hom x ∧
          ((∀ t, T'.hom t ∉ Z) ∨ (ι.hom.app (Opposite.op T')).hom s = 0))
    (hU : ∀ (T : X.ProEt), (∀ t, T.hom t ∉ Z) →
      ∀ (x : ∀ n, (Q n).obj.obj (Opposite.op T)),
      (∀ n, 1 ≤ n → ((τ n).hom.app (Opposite.op T)).hom (x (n + 1)) = x n) →
      ∃ s : L.obj.obj (Opposite.op T), ∀ n, 1 ≤ n → ((π n).hom.app (Opposite.op T)).hom s = x n)
    (hZK : ∀ (T : X.ProEt), (∀ t, T.hom t ∉ Z) → ∀ (s : L.obj.obj (Opposite.op T)),
      (∀ (z : T.left) (n : ℕ), 1 ≤ n → ∃ (T₁ : X.ProEt) (k : T₁ ⟶ T) (q : T₁.left),
        k.left q = z ∧ ((π n).hom.app (Opposite.op T₁)).hom ((L.obj.map k.op).hom s) = 0) →
      s = 0) :
    ∀ (T : X.ProEt), (∀ y : T.left, ∃ m : T.left, y ⤳ m ∧ T.hom m ∈ Z) →
      ∀ (x : ∀ n, (Q n).obj.obj (Opposite.op T)),
      (∀ n, 1 ≤ n → ((τ n).hom.app (Opposite.op T)).hom (x (n + 1)) = x n) →
      ∀ n, 1 ≤ n → x n = 0 :=
by
  have nat : ∀ {A B : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}}
      (φ : A ⟶ B) {T T' : X.ProEt} (h : T' ⟶ T) (y : A.obj.obj (Opposite.op T)),
      (φ.hom.app (Opposite.op T')).hom ((A.obj.map h.op).hom y) =
        (B.obj.map h.op).hom ((φ.hom.app (Opposite.op T)).hom y) := by
    intro A B φ T T' h y
    have e := congrArg (fun f => f.hom y) (φ.hom.naturality h.op)
    simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] using e
  have fcomp : ∀ (A : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
      {T T' T'' : X.ProEt} (k : T'' ⟶ T') (h : T' ⟶ T)
      (y : A.obj.obj (Opposite.op T)),
      (A.obj.map (k ≫ h).op).hom y = (A.obj.map k.op).hom ((A.obj.map h.op).hom y) := by
    intro A T T' T'' k h y
    rw [op_comp, Functor.map_comp]
    rfl
  have hw : ∀ {T T' : X.ProEt} (c : T' ⟶ T) (t : T'.left), T'.hom t = T.hom (c.left t) := by
    intro T T' c t
    rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w c]
  have cs1 : ∀ (T : X.ProEt) (R : Sieve T), R ∈ Scheme.ProEt.topology X T →
      ∀ τ : T.left, ∃ (W : X.ProEt) (f : W ⟶ T), R.arrows f ∧ τ ∈ Set.range f.left := by
    intro T R hR
    have fact : ∀ {Z : Scheme.{u}} (g : Z ⟶ T.left),
        (Sieve.overEquiv ((Scheme.ProEt.forget X).obj T)
          (Sieve.functorPushforward (Scheme.ProEt.forget X) R)).arrows g →
        ∃ (W : X.ProEt) (f : W ⟶ T) (e : Z ⟶ W.left), R.arrows f ∧ g = e ≫ f.left := by
      intro Z g hg
      have hg' := (Sieve.overEquiv_iff _ g).mp hg
      obtain ⟨W, φ, ψ, hφ, heq⟩ := hg'
      refine ⟨W, φ, ψ.left, hφ, ?_⟩
      have := congrArg CommaMorphism.left heq
      simp only [Over.homMk_left, Over.comp_left] at this
      exact this
    have hS : Sieve.overEquiv ((Scheme.ProEt.forget X).obj T)
        (Sieve.functorPushforward (Scheme.ProEt.forget X) R) ∈ Scheme.proetaleTopology T.left :=
      (GrothendieckTopology.mem_over_iff _ _).mp ((CoverPreserving.of_isContinuous
        (Scheme.ProEt.forget X) (Scheme.ProEt.topology X) (Scheme.proetaleTopology.over X)).cover_preserve hR)
    obtain ⟨R', hR', hle⟩ :=
      (Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition (J := Scheme.proetalePrecoverage)).mp hS
    obtain ⟨𝒰, h𝒰, hR'eq⟩ := (Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover).mp hR'
    haveI := h𝒰
    have hmem : ∀ j, (Sieve.overEquiv ((Scheme.ProEt.forget X).obj T)
        (Sieve.functorPushforward (Scheme.ProEt.forget X) R)).arrows (𝒰.f j) := by
      intro j
      apply hle
      rw [hR'eq]
      exact Presieve.ofArrows.mk j
    choose W f e hf he using fun j => fact (𝒰.f j) (hmem j)
    intro τ
    obtain ⟨U, hUa, hτU, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := τ) trivial
    obtain ⟨n, c, V, hV, hUeq⟩ :=
      QuasiCompactCover.exists_isAffineOpen_of_isCompact 𝒰.toPreZeroHypercover hUa.isCompact
    have hτ' : τ ∈ (U : Set T.left) := hτU
    rw [← hUeq] at hτ'
    obtain ⟨i, z, hz, hzτ⟩ := Set.mem_iUnion.mp hτ'
    refine ⟨W (c i), f (c i), hf _, e (c i) z, ?_⟩
    rw [← hzτ, he (c i), Scheme.Hom.comp_apply]
  intro T hspec x hx n hn
  obtain ⟨R, hR, hRx⟩ := hLOC n hn T (x n)
  apply (Q n).isSeparated T R hR (x n) 0
  intro T' c hc
  refine Eq.trans ?_ (map_zero _).symm
  obtain ⟨sc, hsc, hdisj⟩ := hRx T' c hc
  rcases hdisj with hT' | hι
  · obtain ⟨s', hs'⟩ := hU T' hT' (fun k => ((Q k).obj.map c.op).hom (x k)) (by
      intro k hk
      rw [nat, hx k hk])
    have hs'' : ∀ k, 1 ≤ k → ((π k).hom.app (Opposite.op T')).hom s' =
        ((Q k).obj.map c.op).hom (x k) := hs'
    have hs0 : s' = 0 := by
      apply hZK T' hT' s'
      intro z n' hn'
      obtain ⟨m, hzm, hmZ⟩ := hspec (c.left z)
      obtain ⟨R', hR', hR'x⟩ := hLOC n' hn' T (x n')
      obtain ⟨T'', c', hc', t', ht'⟩ := cs1 T R' hR' m
      have hK : ((Q n').obj.map c'.op).hom (x n') = 0 := by
        obtain ⟨s₂, hs₂, hd⟩ := hR'x T'' c' hc'
        rcases hd with hd | hd
        · exact (hd t' (by rw [hw c' t', ht']; exact hmZ)).elim
        · rw [← hs₂, hιinj T'' s₂ hd, map_zero]
      haveI : WeaklyEtale (c'.left ≫ T.hom) := by
        rw [MorphismProperty.Over.w c']; exact T''.prop
      haveI : WeaklyEtale T.hom := T.prop
      haveI : WeaklyEtale c'.left := WeaklyEtale.of_comp c'.left T.hom
      rw [← ht'] at hzm
      obtain ⟨t'', -, ht''⟩ := (Flat.generalizingMap c'.left) hzm
      obtain ⟨P, k₁, k₂, q, hk, hq, -⟩ := hPB T T' T'' c c' z t'' ht''.symm
      refine ⟨P, k₁, q, hq, ?_⟩
      rw [nat, hs'' n' hn', ← fcomp, hk, fcomp, hK, map_zero]
    rw [← hs'' n hn, hs0, map_zero]
  · rw [← hsc, hιinj T' sc hι, map_zero]

theorem wc_ltl_lift_chart (X : Scheme.{u}) (Z : Set X) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (G : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (σ : ℚ_[ℓ] → (G ⟶ G))
    (W : X.ProEt) (θ : G.over W ≅ (wcContSheaf X (Fin r → ℚ_[ℓ])).over W)
    (hθ : ∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology X).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫
        θ.hom = θ.hom ≫ ((Scheme.ProEt.topology X).overPullback AddCommGrpCat.{u+1} W).map
          (wcConstScalar X ℓ r c))
    (hWqc : QuasiCompact W.hom) (hWs : ∀ p : X, p ∉ Z → ∃ z : W.left, W.hom z = p)
    (L : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (ι : L ⟶ G)
    (lam : ℤ_[ℓ] → (L ⟶ L)) (hlamι : ∀ a : ℤ_[ℓ], lam a ≫ ι = ι ≫ σ (a : ℚ_[ℓ]))
    (hmono : Mono ι)
    (hINT : ∀ (T : X.ProEt) (t : L.obj.obj (Opposite.op T)) (b : T ⟶ W) (z : T.left)
        (i : Fin r), ‖wcLtcVal θ b ((ι.hom.app (Opposite.op T)).hom t) z i‖ ≤ 1)
    (Q : ℕ → Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
    (π : ∀ n, L ⟶ Q n) (τ : ∀ n, Q (n + 1) ⟶ Q n)
    (hex : ∀ n, 1 ≤ n → ∃ w : lam ((ℓ : ℤ_[ℓ]) ^ n) ≫ π n = 0,
      (ShortComplex.mk _ _ w).ShortExact)
    (hPB : ∀ (P P₁ P₂ : X.ProEt) (g₁ : P₁ ⟶ P) (g₂ : P₂ ⟶ P) (p₁ : P₁.left) (p₂ : P₂.left),
        g₁.left p₁ = g₂.left p₂ →
        ∃ (P₁₂ : X.ProEt) (k₁ : P₁₂ ⟶ P₁) (k₂ : P₁₂ ⟶ P₂) (q : P₁₂.left),
          k₁ ≫ g₁ = k₂ ≫ g₂ ∧ k₁.left q = p₁ ∧ k₂.left q = p₂)
    (hLOC : ∀ n, 1 ≤ n → ∀ (T : X.ProEt) (x : (Q n).obj.obj (Opposite.op T)), ∃ R : Sieve T,
      R ∈ Scheme.ProEt.topology X T ∧ ∀ (T' : X.ProEt) (g : T' ⟶ T), R.arrows g →
        ∃ s : L.obj.obj (Opposite.op T'),
          ((π n).hom.app (Opposite.op T')).hom s = ((Q n).obj.map g.op).hom x ∧
          ((∀ t, T'.hom t ∉ Z) ∨ (ι.hom.app (Opposite.op T')).hom s = 0))
    (huniq : ∀ (T : X.ProEt) (s : L.obj.obj (Opposite.op T)),
      (∀ n, 1 ≤ n → ((π n).hom.app (Opposite.op T)).hom s = 0) → s = 0)
    (hGLUE : ∀ (T : X.ProEt) (x : ∀ n, (Q n).obj.obj (Opposite.op T)) (R : Sieve T),
      R ∈ Scheme.ProEt.topology X T →
      (∀ (T' : X.ProEt) (h : T' ⟶ T), R.arrows h → ∃ s : L.obj.obj (Opposite.op T'),
        ∀ n, 1 ≤ n → ((π n).hom.app (Opposite.op T')).hom s = ((Q n).obj.map h.op).hom (x n)) →
      ∃ s : L.obj.obj (Opposite.op T), ∀ n, 1 ≤ n → ((π n).hom.app (Opposite.op T)).hom s = x n)
    (hU : ∀ (T : X.ProEt), (∀ t, T.hom t ∉ Z) →
      ∀ (x : ∀ n, (Q n).obj.obj (Opposite.op T)),
      (∀ n, 1 ≤ n → ((τ n).hom.app (Opposite.op T)).hom (x (n + 1)) = x n) →
      ∃ s : L.obj.obj (Opposite.op T), ∀ n, 1 ≤ n → ((π n).hom.app (Opposite.op T)).hom s = x n) :
    ∀ (Y : X.ProEt) (B : Type u) [CommRing B] (e : Y.left ≅ Spec (.of B)) (g : B),
      (∀ y : Y.left, Y.hom y ∈ Z ↔ g ∈ (e.hom y).asIdeal) →
      ∀ (x : ∀ n, (Q n).obj.obj (Opposite.op Y)),
      (∀ n, 1 ≤ n → ((τ n).hom.app (Opposite.op Y)).hom (x (n + 1)) = x n) →
      ∃ s : L.obj.obj (Opposite.op Y), ∀ n, 1 ≤ n → ((π n).hom.app (Opposite.op Y)).hom s = x n :=
by
  have nat : ∀ {A B : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}}
      (φ : A ⟶ B) {T T' : X.ProEt} (h : T' ⟶ T) (y : A.obj.obj (Opposite.op T)),
      (φ.hom.app (Opposite.op T')).hom ((A.obj.map h.op).hom y) =
        (B.obj.map h.op).hom ((φ.hom.app (Opposite.op T)).hom y) := by
    intro A B φ T T' h y
    have e := congrArg (fun f => f.hom y) (φ.hom.naturality h.op)
    simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] using e
  have fcomp : ∀ (A : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
      {T T' T'' : X.ProEt} (k : T'' ⟶ T') (h : T' ⟶ T)
      (y : A.obj.obj (Opposite.op T)),
      (A.obj.map (k ≫ h).op).hom y = (A.obj.map k.op).hom ((A.obj.map h.op).hom y) := by
    intro A T T' T'' k h y
    rw [op_comp, Functor.map_comp]
    rfl

  have hιinj : ∀ (T : X.ProEt) (s : L.obj.obj (Opposite.op T)),
      (ι.hom.app (Opposite.op T)).hom s = 0 → s = 0 := by
    intro T s hs
    have hinj := (AddCommGrpCat.mono_iff_injective _).mp ((NatTrans.mono_iff_mono_app ι.hom).mp
      ((Sheaf.Hom.mono_iff_presheaf_mono (Scheme.ProEt.topology X) AddCommGrpCat.{u+1} ι).mp
        hmono) (Opposite.op T))
    exact hinj (hs.trans (map_zero _).symm)
  have hZK := wc_ltl_zero_of_local_kill X Z ℓ r G σ W θ hθ hWqc hWs L ι lam hlamι hιinj hINT
    Q π hex hPB
  have hVS := wc_ltl_vanish_spec X Z G L ι hιinj Q π τ hPB hLOC hU hZK

  have hC : ∀ {T T' : X.ProEt} (c : T' ⟶ T) (x : ∀ n, (Q n).obj.obj (Opposite.op T)),
      (∀ n, 1 ≤ n → ((τ n).hom.app (Opposite.op T)).hom (x (n + 1)) = x n) →
      ∀ n, 1 ≤ n → ((τ n).hom.app (Opposite.op T')).hom
          (((Q (n + 1)).obj.map c.op).hom (x (n + 1))) = ((Q n).obj.map c.op).hom (x n) := by
    intro T T' c x hx n hn
    rw [nat, hx n hn]

  intro Y B _ e g hZ x hx
  obtain ⟨YD, YE, jD, jE, hcov, hD, hE⟩ := wc_ltl_chart_two_cover X Z Y B e g hZ
  let R : Sieve Y :=
    { arrows := fun T' h => ∃ s : L.obj.obj (Opposite.op T'),
        ∀ n, 1 ≤ n → ((π n).hom.app (Opposite.op T')).hom s = ((Q n).obj.map h.op).hom (x n)
      downward_closed := by
        intro T' T'' h hh k
        obtain ⟨s, hs⟩ := hh
        exact ⟨(L.obj.map k.op).hom s, fun n hn => by rw [nat, hs n hn, fcomp]⟩ }
  have hRD : R.arrows jD := by
    obtain ⟨s, hs⟩ := hU YD hD (fun n => ((Q n).obj.map jD.op).hom (x n)) (hC jD x hx)
    exact ⟨s, hs⟩
  have hRE : R.arrows jE := by
    refine ⟨0, fun n hn => ?_⟩
    rw [map_zero]
    exact (hVS YE hE (fun n => ((Q n).obj.map jE.op).hom (x n)) (hC jE x hx) n hn).symm
  exact hGLUE Y x R (hcov R hRD hRE) (fun T' h hh => hh)

