  have hy2' : y.1.2 = ρ (xH ^ e) := Units.ext (by rw [hy2, hρ, Subgroup.coe_zpow, hxH])
  have hy'2' : y'.1.2 = ρ pH := Units.ext (by rw [hy'2, hρ, hpH])
  have h2' : y.1.2 = y'.1.2 * g₀.1.2 * (y'.1.2)⁻¹ := by
