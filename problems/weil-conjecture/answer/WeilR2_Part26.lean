    · intro h y
      have h1 : Abelian.Ext.homEquiv₀ y = 0 := e.injective ((h _).trans he.symm)
      rw [← Equiv.symm_apply_apply Abelian.Ext.homEquiv₀ y, h1, Abelian.Ext.homEquiv₀_symm_apply,
        Abelian.Ext.mk₀_zero]
  have hZero : ∀ (N : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}),
      wcZeroAtS F'' D.m D.S N ↔
        ∀ (i : Fin D.m) (V : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A]
          [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
          (e : V.left ≅ Spec (.of A)),
          V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F'') →
          ∀ x : N.obj.obj (Opposite.op V), x = 0 := by
    intro N
    constructor
    · intro h i V A _ _ _ e hV
      obtain ⟨eF, -, heF0⟩ := proet_free_sheaf_hom_equiv (wcP1Over F'').left V
      exact (hExt0 _ N _ (eF N) (heF0 N)).mp (h i V A e hV)
    · intro h i V A _ _ _ e hV
      obtain ⟨eF, -, heF0⟩ := proet_free_sheaf_hom_equiv (wcP1Over F'').left V
      exact (hExt0 _ N _ (eF N) (heF0 N)).mpr (h i V A e hV)

  let H : ∀ U : ((wcP1Over F'').left.ProEt)ᵒᵖ, AddSubgroup ((wcPencilVQ D ℓ hP).obj.obj U) :=
    fun U =>
    { carrier := {x | ∀ (i : Fin D.m) (W : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A]
          [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
          (e : W.left ≅ Spec (.of A)),
          W.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F'') →
          ∀ f : W ⟶ U.unop, (wcPencilVQ D ℓ hP).obj.map f.op x = 0}
      zero_mem' := by
        intro i W A _ _ _ e hW f
        exact map_zero _
      add_mem' := by
        intro a b ha hb i W A _ _ _ e hW f
        rw [map_add, ha i W A e hW f, hb i W A e hW f, add_zero]
      neg_mem' := by
        intro a ha i W A _ _ _ e hW f
        rw [map_neg, ha i W A e hW f, neg_zero] }
  have hres : ∀ {U V : ((wcP1Over F'').left.ProEt)ᵒᵖ} (f : U ⟶ V)
      (x : (wcPencilVQ D ℓ hP).obj.obj U), x ∈ H U → (wcPencilVQ D ℓ hP).obj.map f x ∈ H V := by
    intro U V f x hx i W A _ _ _ e hW g
    have h1 := hx i W A e hW (g ≫ f.unop)
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply] at h1
    exact h1
  have hloc : ∀ (X : (wcP1Over F'').left.ProEt) (x : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op X))
      (R : Sieve X), R ∈ Scheme.ProEt.topology (wcP1Over F'').left X →
      (∀ (Y : (wcP1Over F'').left.ProEt) (f : Y ⟶ X), R.arrows f →
        (wcPencilVQ D ℓ hP).obj.map f.op x ∈ H (Opposite.op Y)) →
      x ∈ H (Opposite.op X) := by
    intro X x R hR hfam i W A _ _ _ e hW f
    have hRf : R.arrows f := hFact _ A X R hR W f e
    have h1 := hfam W f hRf i W A e hW (𝟙 W)
    rw [op_id, CategoryTheory.Functor.map_id, ConcreteCategory.id_apply] at h1
    exact h1

  obtain ⟨M, hinj, hland, hgreat⟩ := hSub _ (wcPencilVQ D ℓ hP) H hres hloc
  have hex : ∃ M : Subobject (wcPencilVQ D ℓ hP),
      wcZeroAtS F'' D.m D.S (Subobject.underlying.obj M) ∧
      ∀ M' : Subobject (wcPencilVQ D ℓ hP),
        wcZeroAtS F'' D.m D.S (Subobject.underlying.obj M') → M' ≤ M := by
    refine ⟨M, ?_, ?_⟩
    · rw [hZero]
      intro i V A _ _ _ e hV x
      apply hinj (Opposite.op V)
      rw [map_zero]
      have h1 := hland (Opposite.op V) x i V A e hV (𝟙 V)
      rw [op_id, CategoryTheory.Functor.map_id, ConcreteCategory.id_apply] at h1
      exact h1
    · intro M' hM'
      rw [hZero] at hM'
      apply hgreat M'
      intro U x i W A _ _ _ e hW f
      rw [← NatTrans.naturality_apply,
        hM' i W A e hW (((Subobject.underlying.obj M').obj.map f.op) x), map_zero]

  unfold wcPencilKS
  rw [dif_pos hex]
  exact Classical.choose_spec hex

theorem wc_pencil_KS_stable (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    wcZeroAtS F'' D.m D.S (Subobject.underlying.obj (wcPencilKS D ℓ hP)) ∧
    ∃ ψ : ℚ_[ℓ] → (Subobject.underlying.obj (wcPencilKS D ℓ hP) ⟶
        Subobject.underlying.obj (wcPencilKS D ℓ hP)),
      (∀ c : ℚ_[ℓ], ψ c ≫ (wcPencilKS D ℓ hP).arrow =
        (wcPencilKS D ℓ hP).arrow ≫ wcPencilVQScalar D ℓ hP c) ∧
      ψ 1 = 𝟙 _ ∧ (∀ a b : ℚ_[ℓ], ψ (a + b) = ψ a + ψ b) ∧
      (∀ a b : ℚ_[ℓ], ψ (a * b) = ψ b ≫ ψ a) :=
by
  classical
  obtain ⟨h0, hmax⟩ := wc_pencil_KS_greatest F' F'' Y n hn hn2 D ℓ hℓ hP hNI

  have hstab : ∀ f : wcPencilVQ D ℓ hP ⟶ wcPencilVQ D ℓ hP,
      ∃ ψ : Subobject.underlying.obj (wcPencilKS D ℓ hP) ⟶
          Subobject.underlying.obj (wcPencilKS D ℓ hP),
        ψ ≫ (wcPencilKS D ℓ hP).arrow = (wcPencilKS D ℓ hP).arrow ≫ f := by
    intro f
    have hI : wcZeroAtS F'' D.m D.S
        (Subobject.underlying.obj (Limits.imageSubobject ((wcPencilKS D ℓ hP).arrow ≫ f))) := by
      intro i V A _ _ _ e hv y
      haveI := wc_proet_free_projective_strict_local (wcP1Over F'').left V A e
      have hu0 : Projective.factorThru (Abelian.Ext.homEquiv₀ y)
          (Limits.factorThruImageSubobject ((wcPencilKS D ℓ hP).arrow ≫ f)) = 0 :=
        Abelian.Ext.homEquiv₀.symm.injective (by
          rw [Abelian.Ext.homEquiv₀_symm_apply, Abelian.Ext.homEquiv₀_symm_apply,
            Abelian.Ext.mk₀_zero]
          exact h0 i V A e hv _)
      have ht0 : Abelian.Ext.homEquiv₀ y = 0 := by
        rw [← Projective.factorThru_comp (Abelian.Ext.homEquiv₀ y)
          (Limits.factorThruImageSubobject ((wcPencilKS D ℓ hP).arrow ≫ f)), hu0, Limits.zero_comp]
      rw [← Abelian.Ext.mk₀_homEquiv₀_apply y, ht0, Abelian.Ext.mk₀_zero]
    have hle := hmax _ hI
    refine ⟨Limits.factorThruImageSubobject ((wcPencilKS D ℓ hP).arrow ≫ f) ≫
      Subobject.ofLE _ _ hle, ?_⟩
    rw [Category.assoc, Subobject.ofLE_arrow, Limits.imageSubobject_arrow_comp]

  have key : ∀ (c : ℚ_[ℓ]) (U : (D.Yt.left.ProEt)ᵒᵖ)
      (x : ((wcLadicSheaf D.Yt.left ℓ).obj.obj U : Type (u+1))),
      (wcLadicScalar D.Yt.left ℓ c).hom.app U x =
        (ULift.up (c • (ULift.down x : C(↥((Scheme.ProEt.forget D.Yt.left ⋙
          Over.forget D.Yt.left).obj (Opposite.unop U)), ℚ_[ℓ]))) : _) := by
    intro c U x
    rfl
  have hL1 : wcLadicScalar D.Yt.left ℓ 1 = 𝟙 _ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [key]
    apply ULift.ext
    exact one_smul _ _
  have hLmul : ∀ a b : ℚ_[ℓ], wcLadicScalar D.Yt.left ℓ (a * b) =
      wcLadicScalar D.Yt.left ℓ b ≫ wcLadicScalar D.Yt.left ℓ a := by
    intro a b
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
      key, key, key]
    apply ULift.ext
    exact mul_smul _ _ _
  have hLadd : ∀ a b : ℚ_[ℓ], wcLadicScalar D.Yt.left ℓ (a + b) =
      wcLadicScalar D.Yt.left ℓ a + wcLadicScalar D.Yt.left ℓ b := by
    intro a b
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, key, key, key]
    apply ULift.ext
    exact add_smul _ _ _
  have hρ1 : wcRqScalar D.f ℓ (n - 1) 1 = 𝟙 _ := by
    show ((wcProEtPush D.f).rightDerived (n - 1)).map (wcLadicScalar D.Yt.left ℓ 1) = 𝟙 _
    rw [hL1, CategoryTheory.Functor.map_id]
  have hρadd : ∀ a b : ℚ_[ℓ], wcRqScalar D.f ℓ (n - 1) (a + b) =
      wcRqScalar D.f ℓ (n - 1) a + wcRqScalar D.f ℓ (n - 1) b := by
    intro a b
    show ((wcProEtPush D.f).rightDerived (n - 1)).map (wcLadicScalar D.Yt.left ℓ (a + b)) =
      ((wcProEtPush D.f).rightDerived (n - 1)).map (wcLadicScalar D.Yt.left ℓ a) +
        ((wcProEtPush D.f).rightDerived (n - 1)).map (wcLadicScalar D.Yt.left ℓ b)
    rw [hLadd]
    generalize wcLadicScalar D.Yt.left ℓ a = f
    generalize wcLadicScalar D.Yt.left ℓ b = g
    let I := injectiveResolution (wcLadicSheaf D.Yt.left ℓ)
    let φ := InjectiveResolution.desc f I I
    let ψ' := InjectiveResolution.desc g I I
    have hf : I.ι ≫ φ = (CochainComplex.single₀ _).map f ≫ I.ι :=
      InjectiveResolution.desc_commutes f I I
    have hg : I.ι ≫ ψ' = (CochainComplex.single₀ _).map g ≫ I.ι :=
      InjectiveResolution.desc_commutes g I I
    have hfg : I.ι ≫ (φ + ψ') = (CochainComplex.single₀ _).map (f + g) ≫ I.ι := by
      rw [Preadditive.comp_add, hf, hg, CategoryTheory.Functor.map_add, Preadditive.add_comp]
    rw [(wcProEtPush D.f).rightDerived_map_eq (n - 1) (f + g) (P := I) (Q := I) (φ + ψ') hfg,
      (wcProEtPush D.f).rightDerived_map_eq (n - 1) f (P := I) (Q := I) φ hf,
      (wcProEtPush D.f).rightDerived_map_eq (n - 1) g (P := I) (Q := I) ψ' hg,
      CategoryTheory.Functor.map_add, Preadditive.add_comp, Preadditive.comp_add]
  have hρmul : ∀ a b : ℚ_[ℓ], wcRqScalar D.f ℓ (n - 1) (a * b) =
      wcRqScalar D.f ℓ (n - 1) b ≫ wcRqScalar D.f ℓ (n - 1) a := by
    intro a b
    show ((wcProEtPush D.f).rightDerived (n - 1)).map (wcLadicScalar D.Yt.left ℓ (a * b)) =
      ((wcProEtPush D.f).rightDerived (n - 1)).map (wcLadicScalar D.Yt.left ℓ b) ≫
        ((wcProEtPush D.f).rightDerived (n - 1)).map (wcLadicScalar D.Yt.left ℓ a)
    rw [hLmul, CategoryTheory.Functor.map_comp]
  choose ε hεE hεπ using wc_pencil_VQScalar_spec F' F'' Y n D ℓ hP
  have hε1 : ε 1 = 𝟙 _ :=
    (cancel_mono (wcPencilE D ℓ hP).arrow).mp (by
      rw [hεE, hρ1, Category.comp_id, Category.id_comp])
  have hεadd : ∀ a b : ℚ_[ℓ], ε (a + b) = ε a + ε b := fun a b =>
    (cancel_mono (wcPencilE D ℓ hP).arrow).mp (by
      rw [hεE (a + b), Preadditive.add_comp, hεE a, hεE b, hρadd, Preadditive.comp_add])
  have hεmul : ∀ a b : ℚ_[ℓ], ε (a * b) = ε b ≫ ε a := fun a b =>
    (cancel_mono (wcPencilE D ℓ hP).arrow).mp (by
      rw [Category.assoc, hεE a, reassoc_of% (hεE b), hεE (a * b), hρmul])
  obtain ⟨π', hπepi, hπ'⟩ : ∃ π' : Subobject.underlying.obj (wcPencilE D ℓ hP) ⟶ wcPencilVQ D ℓ hP,
      Epi π' ∧ ∀ c : ℚ_[ℓ], π' ≫ wcPencilVQScalar D ℓ hP c = ε c ≫ π' :=
    ⟨Limits.cokernel.π ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).ofLE (wcPencilE D ℓ hP) inf_le_left),
      by exact (inferInstance : Epi (Limits.cokernel.π
        ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).ofLE (wcPencilE D ℓ hP) inf_le_left))),
      fun c => by exact hεπ c⟩
  have hσ1 : wcPencilVQScalar D ℓ hP 1 = 𝟙 _ :=
    (cancel_epi π').mp (by
      rw [hπ', hε1, Category.id_comp, Category.comp_id])
  have hσadd : ∀ a b : ℚ_[ℓ], wcPencilVQScalar D ℓ hP (a + b) =
      wcPencilVQScalar D ℓ hP a + wcPencilVQScalar D ℓ hP b := fun a b =>
    (cancel_epi π').mp (by
      rw [hπ' (a + b), Preadditive.comp_add, hπ' a, hπ' b, hεadd, Preadditive.add_comp])
  have hσmul : ∀ a b : ℚ_[ℓ], wcPencilVQScalar D ℓ hP (a * b) =
      wcPencilVQScalar D ℓ hP b ≫ wcPencilVQScalar D ℓ hP a := fun a b =>
    (cancel_epi π').mp (by
      rw [reassoc_of% (hπ' b), hπ' a, hπ' (a * b), hεmul, Category.assoc])

  choose ψ hψ using fun c : ℚ_[ℓ] => hstab (wcPencilVQScalar D ℓ hP c)
  refine ⟨h0, ψ, hψ, ?_, ?_, ?_⟩
  · exact (cancel_mono (wcPencilKS D ℓ hP).arrow).mp (by
      rw [hψ, hσ1, Category.comp_id, Category.id_comp])
  · intro a b
    exact (cancel_mono (wcPencilKS D ℓ hP).arrow).mp (by
      rw [hψ (a + b), Preadditive.add_comp, hψ a, hψ b, hσadd, Preadditive.comp_add])
  · intro a b
    exact (cancel_mono (wcPencilKS D ℓ hP).arrow).mp (by
      rw [hψ (a * b), hσmul, Category.assoc, hψ a, reassoc_of% (hψ b)])

theorem wc_proet_coker_greatest_zeroAtS_off_S (K : Type u) [Field K] (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (M : Subobject G)
    (hM0 : wcZeroAtS K m S (Subobject.underlying.obj M))
    (hM : ∀ M' : Subobject G, wcZeroAtS K m S (Subobject.underlying.obj M') → M' ≤ M) :
    ∀ V : (wcP1Over K).left.ProEt,
      (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
      ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left V) (Limits.cokernel M.arrow) 0, y = 0 :=
by
  classical

  have s6 : ∀ (R E : Type u) [CommRing R] [CommRing E] [Algebra R E],
      WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R E))) → Algebra.WeaklyEtale R E := by
    intro R E _ _ _ hW
    have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap R E))) := hW.flat
    have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R E)))) :=
      hW.flat_diagonal
    rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
      RingHom.flat_algebraMap_iff] at hf
    rw [diagonal_SpecMap] at hd
    have hd' : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' R (S := E)).toRingHom)) := by
      have heq : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) =
          (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) ≫
            (pullbackSpecIso R E E).inv) ≫ (pullbackSpecIso R E E).hom := by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [heq]
      infer_instance
    rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hd'
    exact ⟨hf, hd'⟩

  have s3 : ∀ (P : (wcP1Over K).left.ProEt → Prop),
      (∀ (U : (wcP1Over K).left.ProEt) (R : Presieve U),
        R ∈ (Scheme.ProEt.precoverage (wcP1Over K).left).coverings U →
        ∀ (W : (wcP1Over K).left.ProEt) (a : W ⟶ U), P W →
          ∃ (Y : (wcP1Over K).left.ProEt) (g : Y ⟶ U) (h : W ⟶ Y), R g ∧ h ≫ g = a) →
      ∀ (U : (wcP1Over K).left.ProEt) (T : Sieve U),
        T ∈ Scheme.ProEt.topology (wcP1Over K).left U →
        ∀ (W : (wcP1Over K).left.ProEt) (a : W ⟶ U), P W → T.arrows a := by
    intro P hK
    let JP : GrothendieckTopology (wcP1Over K).left.ProEt :=
      GrothendieckTopology.mk
        (fun U => {T : Sieve U | ∀ (W : (wcP1Over K).left.ProEt) (a : W ⟶ U), P W → T.arrows a})
        (by
          intro U W a _
          trivial)
        (by
          intro U Y T f hT W a hW
          rw [Sieve.pullback_apply]
          exact hT W (a ≫ f) hW)
        (by
          intro U T hT R hR W a hW
          have h1 := hR (hT W a hW) W (𝟙 W) hW
          rw [Sieve.pullback_apply, Category.id_comp] at h1
          exact h1)
    have hle : Scheme.ProEt.topology (wcP1Over K).left ≤ JP := by
      rw [Precoverage.toGrothendieck_le_iff_le_toPrecoverage]
      intro U R hR
      show ∀ (W : (wcP1Over K).left.ProEt) (a : W ⟶ U), P W → (Sieve.generate R).arrows a
      intro W a hW
      obtain ⟨Y, g, h, hg, hhg⟩ := hK U R hR W a hW
      exact ⟨Y, h, g, hg, hhg⟩
    intro U T hT W a hW
    have h1 : T ∈ JP U := GrothendieckTopology.le_def.mp hle U hT
    exact h1 W a hW

  have hsieve : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A]
      [IsSepClosed (IsLocalRing.ResidueField A)] (U : (wcP1Over K).left.ProEt) (T : Sieve U),
      T ∈ Scheme.ProEt.topology (wcP1Over K).left U →
      ∀ (W : (wcP1Over K).left.ProEt) (a : W ⟶ U) (e : W.left ≅ Spec (.of A)), T.arrows a := by
    intro A _ _ _
    have s7 : ∀ (E : Type u) [CommRing E] [Algebra A E],
        Algebra.WeaklyEtale A E → ∀ (p : Ideal E) [p.IsPrime],
        p.comap (algebraMap A E) = IsLocalRing.maximalIdeal A → Nonempty (E →ₐ[A] A) := by
      intro E _ _ hAE p _ hp
      haveI : Algebra.WeaklyEtale E (Localization.AtPrime p) :=
        wc_localization_weaklyEtale E (Localization.AtPrime p) p.primeCompl
      haveI := hAE
      haveI : Algebra.WeaklyEtale A (Localization.AtPrime p) := Algebra.WeaklyEtale.trans A E _
      have hloc : IsLocalHom (algebraMap A (Localization.AtPrime p)) := by
        have h1 : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap
            (algebraMap A (Localization.AtPrime p)) = IsLocalRing.maximalIdeal A := by
          rw [IsScalarTower.algebraMap_eq A E (Localization.AtPrime p), ← Ideal.comap_comap]
          have h2 : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap
              (algebraMap E (Localization.AtPrime p)) = p :=
            Localization.AtPrime.under_maximalIdeal
          rw [h2, hp]
        exact ((IsLocalRing.local_hom_TFAE (algebraMap A (Localization.AtPrime p))).out 1 5).mpr h1
      have hbij := wc_olivier A (Localization.AtPrime p) inferInstance inferInstance hloc
        inferInstance
      let eqv : A ≃ₐ[A] Localization.AtPrime p := AlgEquiv.ofBijective (Algebra.ofId A _) hbij
      exact ⟨eqv.symm.toAlgHom.comp (IsScalarTower.toAlgHom A E (Localization.AtPrime p))⟩
    have s5 : ∀ {U V : Scheme.{u}} (e : U ≅ Spec (.of A)) (g : V ⟶ U) [WeaklyEtale g] (v : V),
        e.hom (g v) = IsLocalRing.closedPoint A → ∃ σ : U ⟶ V, σ ≫ g = 𝟙 U := by
      intro U V e g _ v hv
      obtain ⟨E, ι, hι, hvι, -⟩ :=
        Scheme.exists_affine_mem_range_and_range_subset (U := (⊤ : V.Opens)) (x := v) trivial
      obtain ⟨w, hw⟩ := hvι
      have := hι
      let h : Spec E ⟶ Spec (.of A) := ι ≫ g ≫ e.hom
      have hWh : WeaklyEtale h := inferInstance
      let φ : CommRingCat.of A ⟶ E := Spec.preimage h
      have hφ : Spec.map φ = h := Spec.map_preimage h
      letI : Algebra A E := (CommRingCat.Hom.hom φ).toAlgebra
      have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap A E))) := by
        change WeaklyEtale (Spec.map φ)
        rw [hφ]
        exact hWh
      have hAE : Algebra.WeaklyEtale A E := s6 A E hW'
      let p : PrimeSpectrum E := w
      have hq : (p.asIdeal).comap (algebraMap A E) = IsLocalRing.maximalIdeal A := by
        have h1 : (Spec.map φ) w = IsLocalRing.closedPoint A := by
          rw [hφ]
          show e.hom (g (ι w)) = _
          rw [hw, hv]
        exact congrArg PrimeSpectrum.asIdeal h1
      obtain ⟨τ⟩ := s7 E hAE p.asIdeal hq
      let τ' : E ⟶ CommRingCat.of A := CommRingCat.ofHom (τ : E →+* A)
      have hret : φ ≫ τ' = 𝟙 _ := by
        ext r
        exact τ.commutes r
      refine ⟨e.hom ≫ Spec.map τ' ≫ ι, ?_⟩
      rw [← cancel_mono e.hom]
      simp only [Category.assoc, Category.id_comp]
      have h3 : ι ≫ g ≫ e.hom = Spec.map φ := hφ.symm
      rw [h3, ← Spec.map_comp, hret, Spec.map_id, Category.comp_id]
    have s4 : ∀ (U : (wcP1Over K).left.ProEt) (R : Presieve U),
        R ∈ (Scheme.ProEt.precoverage (wcP1Over K).left).coverings U →
        ∀ (W : (wcP1Over K).left.ProEt) (a : W ⟶ U), Nonempty (W.left ≅ Spec (.of A)) →
        ∃ (Y : (wcP1Over K).left.ProEt) (g : Y ⟶ U) (h : W ⟶ Y), R g ∧ h ≫ g = a := by
      intro U R hR W a ⟨eW⟩
      have hR' : Presieve.map (Scheme.ProEt.forget (wcP1Over K).left ⋙
          Over.forget (wcP1Over K).left) R ∈
          (Scheme.precoverage @WeaklyEtale).coverings U.left := hR.2
      obtain ⟨Y', g', hg', y', hy'⟩ :=
        (Scheme.instJointlySurjectivePrecoverage (P := @WeaklyEtale)).exists_eq _ hR'
          (a.left (eW.inv (IsLocalRing.closedPoint A)))
      obtain ⟨Y, hY, g, hg, hgg⟩ := Presieve.map_iff.mp hg'
      subst hY
      have hgl : g.left = g' := hgg.trans (by simp only [eqToHom_refl]; exact Category.id_comp _)
      haveI : WeaklyEtale U.hom := U.prop
      haveI : WeaklyEtale (g.left ≫ U.hom) := by
        rw [MorphismProperty.Over.w g]; exact Y.prop
      haveI : WeaklyEtale g.left := WeaklyEtale.of_comp g.left U.hom
      obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := a.left) (g := g.left)
        (eW.inv (IsLocalRing.closedPoint A)) y' (by rw [hgl]; exact hy'.symm)
      obtain ⟨σ, hσ⟩ := s5 eW (Limits.pullback.fst a.left g.left) z (by
        rw [hz1]
        change (eW.inv ≫ eW.hom) (IsLocalRing.closedPoint A) = _
        rw [Iso.inv_hom_id]
        rfl)
      have hh₀ : (σ ≫ Limits.pullback.snd a.left g.left) ≫ g.left = a.left := by
        rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hσ, Category.id_comp]
      refine ⟨Y, g, MorphismProperty.Over.homMk (σ ≫ Limits.pullback.snd a.left g.left) ?_ trivial,
        hg, ?_⟩
      · rw [← MorphismProperty.Over.w g, ← Category.assoc, hh₀, MorphismProperty.Over.w a]
      · apply MorphismProperty.Over.Hom.ext
        exact hh₀
    intro U T hT W a e
    exact s3 (fun W => Nonempty (W.left ≅ Spec (.of A))) s4 U T hT W a ⟨e⟩

  have hzero : ∀ (W T : (wcP1Over K).left.ProEt),
      (∀ R : Sieve W, R ∈ Scheme.ProEt.topology (wcP1Over K).left W → R.arrows (𝟙 W)) →
      IsEmpty (W ⟶ T) →
      ∀ u : wcFreeSheaf (wcP1Over K).left W ⟶ wcFreeSheaf (wcP1Over K).left T, u = 0 := by
    intro W T hW hWT u
    obtain ⟨eF, -, heF0⟩ := proet_free_sheaf_hom_equiv (wcP1Over K).left W
    apply (eF _).injective
    rw [heF0]
    generalize eF (wcFreeSheaf (wcP1Over K).left T) u = x
    have hT := Presheaf.imageSieve_mem (Scheme.ProEt.topology (wcP1Over K).left)
      (toSheafify (Scheme.ProEt.topology (wcP1Over K).left)
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) (U := Opposite.op W) x
    have h1 := hW _ hT
    obtain ⟨t, ht⟩ := h1
    haveI : IsEmpty (ULift.{u+1} (W ⟶ T)) := ⟨fun a => hWT.false a.down⟩
    have ht0 : t = 0 := @Subsingleton.elim (FreeAbelianGroup (ULift.{u+1} (W ⟶ T))) _ t 0
    subst ht0
    first
      | (rw [map_zero] at ht; simpa using ht.symm)
      | (simp only [map_zero, op_id, CategoryTheory.Functor.map_id] at ht; exact ht.symm.trans rfl)
      | (simp at ht; exact ht.symm)
      | (simpa using ht.symm)

  have toZ : ∀ X : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1},
      (∀ (i : Fin m) (W : (wcP1Over K).left.ProEt) (A : Type u) [CommRing A]
        [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
        (e : W.left ≅ Spec (.of A)),
        W.hom (e.inv (IsLocalRing.closedPoint A)) = S i (IsLocalRing.closedPoint K) →
        ∀ g : wcFreeSheaf (wcP1Over K).left W ⟶ X, g = 0) → wcZeroAtS K m S X := by
    intro X H i W A _ _ _ e hW y
    rw [← Abelian.Ext.mk₀_homEquiv₀_apply y, H i W A e hW (Abelian.Ext.homEquiv₀ y),
      Abelian.Ext.mk₀_zero]
  have ofZ : ∀ X : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1},
      wcZeroAtS K m S X →
      ∀ (i : Fin m) (W : (wcP1Over K).left.ProEt) (A : Type u) [CommRing A]
        [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
        (e : W.left ≅ Spec (.of A)),
        W.hom (e.inv (IsLocalRing.closedPoint A)) = S i (IsLocalRing.closedPoint K) →
        ∀ g : wcFreeSheaf (wcP1Over K).left W ⟶ X, g = 0 := by
    intro X hX i W A _ _ _ e hW g
    apply (Abelian.Ext.mk₀_bijective _ _).1
    rw [hX i W A e hW (Abelian.Ext.mk₀ g), Abelian.Ext.mk₀_zero]

  intro V hoff y
  have h0 : ∀ (i : Fin m) (W : (wcP1Over K).left.ProEt) (A : Type u) [CommRing A]
      [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
      (e : W.left ≅ Spec (.of A)),
      W.hom (e.inv (IsLocalRing.closedPoint A)) = S i (IsLocalRing.closedPoint K) →
      ∀ u : wcFreeSheaf (wcP1Over K).left W ⟶ wcFreeSheaf (wcP1Over K).left V, u = 0 := by
    intro i W A _ _ _ e hW u
    refine hzero W V (fun R hR => hsieve A W R hR W (𝟙 W) e) ⟨fun h => ?_⟩ u
    apply hoff (h.left (e.inv (IsLocalRing.closedPoint A))) i
    rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w h]
    exact hW
  obtain ⟨f, hf⟩ : ∃ f, Abelian.Ext.homEquiv₀ y = f := ⟨_, rfl⟩

  obtain ⟨I, q, hq, hqI⟩ : ∃ (I : Subobject (Limits.cokernel M.arrow))
      (q : wcFreeSheaf (wcP1Over K).left V ⟶ Subobject.underlying.obj I),
      Epi q ∧ q ≫ I.arrow = f :=
    ⟨Limits.imageSubobject f, Limits.factorThruImageSubobject f, inferInstance,
      Limits.imageSubobject_arrow_comp f⟩
  have hI : wcZeroAtS K m S (Subobject.underlying.obj I) := by
    apply toZ
    intro i W A _ _ _ e hW g
    haveI := wc_proet_free_projective_strict_local _ W A e
    obtain ⟨u, hu⟩ := Projective.factors g q
    rw [← hu, h0 i W A e hW u, Limits.zero_comp]

  obtain ⟨E, p₁, p₂, hp₁, hp₂, hcond⟩ : ∃ (E : Sheaf (Scheme.ProEt.topology (wcP1Over K).left)
      AddCommGrpCat.{u+1}) (p₁ : E ⟶ Subobject.underlying.obj I) (p₂ : E ⟶ G),
      Epi p₁ ∧ Mono p₂ ∧ p₁ ≫ I.arrow = p₂ ≫ Limits.cokernel.π M.arrow :=
    ⟨_, _, _, Abelian.epi_pullback_of_epi_g _ _, inferInstance, Limits.pullback.condition⟩
  haveI := hp₂
  obtain ⟨N, φ, hφ, hNarrow⟩ : ∃ (N : Subobject G) (φ : Subobject.underlying.obj N ⟶ E),
      IsIso φ ∧ φ ≫ p₂ = N.arrow :=
    ⟨Subobject.mk p₂, (Subobject.underlyingIso p₂).hom, inferInstance,
      Subobject.underlyingIso_hom_comp_eq_mk p₂⟩
  have hN : wcZeroAtS K m S (Subobject.underlying.obj N) := by
    apply toZ
    intro i W A _ _ _ e hW g
    have hk : g ≫ φ ≫ p₁ = 0 := ofZ _ hI i W A e hW _
    have hb : (g ≫ N.arrow) ≫ Limits.cokernel.π M.arrow = 0 := by
      calc (g ≫ N.arrow) ≫ Limits.cokernel.π M.arrow = (g ≫ φ ≫ p₁) ≫ I.arrow := by
            rw [← hNarrow]; simp only [Category.assoc, hcond]
        _ = 0 := by rw [hk, Limits.zero_comp]
    let hlim := Abelian.monoIsKernelOfCokernel
      (Limits.CokernelCofork.ofπ (Limits.cokernel.π M.arrow) (Limits.cokernel.condition M.arrow))
      (Limits.cokernelIsCokernel M.arrow)
    obtain ⟨t, ht⟩ := Limits.KernelFork.IsLimit.lift' hlim (g ≫ N.arrow) hb
    have ht0 : t = 0 := ofZ _ hM0 i W A e hW t
    rw [ht0, Limits.zero_comp] at ht
    rw [← cancel_mono N.arrow, Limits.zero_comp]
    exact ht.symm

  have hle := hM N hN
  have hNπ : N.arrow ≫ Limits.cokernel.π M.arrow = 0 := by
    rw [← Subobject.ofLE_arrow hle, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
  have hIarrow : I.arrow = 0 := by
    have h1 : φ ≫ p₁ ≫ I.arrow = φ ≫ 0 := by
      rw [hcond, ← Category.assoc, hNarrow, hNπ, Limits.comp_zero]
    rw [cancel_epi] at h1
    rw [← cancel_epi p₁, h1, Limits.comp_zero]
  have hf0 : f = 0 := by
    rw [← hqI, hIarrow, Limits.comp_zero]
  rw [← Abelian.Ext.mk₀_homEquiv₀_apply y, hf, hf0, Abelian.Ext.mk₀_zero]

theorem wc_P1_section_closedPt_one (K : Type u) [Field K] [Finite K]
    (s : Spec (.of K) ⟶ (wcP1Over K).left) (hs : s ≫ (wcP1Over K).hom = 𝟙 _) :
    s (IsLocalRing.closedPoint K) ∈ wcP1ClosedPt K 1 :=
by
  classical

  have hclosed : ∀ (X : Scheme.{u}) (q : X ⟶ Spec (.of K)) (s : Spec (.of K) ⟶ X),
      s ≫ q = 𝟙 _ → IsClosed ({s (IsLocalRing.closedPoint K)} : Set X) := by
    intro X q s hs
    have affine : ∀ (A : CommRingCat.{u}) (t : Spec (.of K) ⟶ Spec A) (g : Spec A ⟶ Spec (.of K)),
        t ≫ g = 𝟙 _ → IsClosed ({t (IsLocalRing.closedPoint K)} : Set (Spec A)) := by
      intro A t g htg
      obtain ⟨φ, rfl⟩ : ∃ φ, Spec.map φ = t := ⟨_, Spec.map_preimage t⟩
      obtain ⟨ψ, rfl⟩ : ∃ ψ, Spec.map ψ = g := ⟨_, Spec.map_preimage g⟩
      have h1 : ψ ≫ φ = 𝟙 _ := by
        apply Spec.map_injective
        rw [Spec.map_comp, htg, Spec.map_id]
      have hsurj : Function.Surjective φ.hom := fun k => ⟨ψ.hom k, by
        have := congrArg (fun f => f.hom k) h1
        simpa using this⟩
      have hmax := RingHom.ker_isMaximal_of_surjective φ.hom hsurj
      have hid : (PrimeSpectrum.comap φ.hom (IsLocalRing.closedPoint K)).asIdeal
          = RingHom.ker φ.hom := by
        rw [PrimeSpectrum.comap_asIdeal, RingHom.ker_eq_comap_bot]
        congr 1
        exact IsLocalRing.maximalIdeal_eq_bot
      have key := (PrimeSpectrum.isClosed_singleton_iff_isMaximal
        (PrimeSpectrum.comap φ.hom (IsLocalRing.closedPoint K))).mpr (by rw [hid]; exact hmax)
      exact key
    apply isClosed_of_closure_subset
    intro y hy
    have hxy : s (IsLocalRing.closedPoint K) ⤳ y := specializes_iff_mem_closure.mpr hy
    obtain ⟨V, hV, hyV, -⟩ :=
      exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) (TopologicalSpace.Opens.mem_top y)
    have hxV : s (IsLocalRing.closedPoint K) ∈ V := hxy.mem_open V.isOpen hyV
    have := hV.isOpenImmersion_fromSpec
    have hrange : Set.range hV.fromSpec = V := hV.range_fromSpec
    have hsub : Set.range s ⊆ Set.range hV.fromSpec := by
      rintro _ ⟨w, rfl⟩
      have hw : w = IsLocalRing.closedPoint K := Subsingleton.elim (α := PrimeSpectrum K) _ _
      rw [hw, hrange]
      exact hxV
    let t := IsOpenImmersion.lift hV.fromSpec s hsub
    have ht : t ≫ hV.fromSpec = s := IsOpenImmersion.lift_fac _ _ _
    have htg : t ≫ (hV.fromSpec ≫ q) = 𝟙 _ := by rw [← Category.assoc, ht, hs]
    have hcl := affine Γ(X, V) t (hV.fromSpec ≫ q) htg
    have hιt : hV.fromSpec (t (IsLocalRing.closedPoint K)) = s (IsLocalRing.closedPoint K) := by
      have e := Scheme.Hom.comp_apply t hV.fromSpec (IsLocalRing.closedPoint K)
      rw [ht] at e
      exact e.symm
    have hyr : y ∈ Set.range hV.fromSpec := by rw [hrange]; exact hyV
    obtain ⟨y', rfl⟩ := hyr
    have hspec : t (IsLocalRing.closedPoint K) ⤳ y' := by
      rw [← hV.fromSpec.isOpenEmbedding.isInducing.specializes_iff, hιt]
      exact hxy
    have hmem := hspec.mem_closed hcl rfl
    rw [Set.mem_singleton_iff] at hmem ⊢
    rw [hmem, hιt]

  have retract : ∀ (L : Type u) [Field L] (ι : K →+* L) (f : L →+* K),
      letI : Module K L := ι.toModule
      Module.finrank K L = 1 := by
    intro L _ ι f
    letI : Module K L := ι.toModule
    have hg : Function.Surjective (f.comp ι) :=
      Finite.injective_iff_surjective.mp (f.comp ι).injective
    have hsurj : Function.Surjective ι := by
      intro a
      obtain ⟨k, hk⟩ := hg (f a)
      exact ⟨k, f.injective hk⟩
    let Λ : K →ₗ[K] L :=
      { toFun := ι
        map_add' := map_add ι
        map_smul' := fun c k => by
          show ι (c * k) = ι c * ι k
          exact map_mul ι c k }
    let e : K ≃ₗ[K] L := LinearEquiv.ofBijective Λ ⟨ι.injective, hsurj⟩
    exact (LinearEquiv.finrank_eq e).symm.trans (Module.finrank_self K)

  obtain ⟨y, f, hyf⟩ : ∃ (y : (wcP1Over K).left)
      (f : (wcP1Over K).left.residueField y ⟶ CommRingCat.of K),
      s = Spec.map f ≫ (wcP1Over K).left.fromSpecResidueField y := by
    refine ⟨(Scheme.SpecToEquivOfField K (wcP1Over K).left s).1,
      (Scheme.SpecToEquivOfField K (wcP1Over K).left s).2, ?_⟩
    rw [← Scheme.SpecToEquivOfField_symm_apply, Equiv.symm_apply_apply]
  have hy : s (IsLocalRing.closedPoint K) = y := by
    have e := Scheme.Hom.comp_apply (Spec.map f)
      ((wcP1Over K).left.fromSpecResidueField y) (IsLocalRing.closedPoint K)
    rw [← hyf] at e
    rw [e, Scheme.fromSpecResidueField_apply]
  refine ⟨hclosed _ _ s hs, ?_⟩
  rw [hy]
  exact retract _ _ f.hom

theorem wc_pencil_Rq_S_nbhd_embed (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F'')) :
    ∃ (r : ℕ) (κ : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) (wcRq D.f ℓ (n - 1)) 0 →+
        (Fin r → ℚ_[ℓ])),
      Function.Injective κ ∧
      ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) (wcRq D.f ℓ (n - 1)) 0),
        κ ((Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 1) c)).postcomp
          (wcFreeSheaf (wcP1Over F'').left V) (add_zero 0) y) = c • κ y :=
by
  classical
  obtain ⟨E, a₀, L, instL, instSC, eE, hE⟩ :=
    wc_pencil_PL_generic_geom_point F'' D.m D.S D.hS V A e
  letI : Field L := instL
  haveI : IsSepClosed L := instSC
  have hinj := (wc_pencil_PL_specialization F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE).1
  obtain ⟨W, w, r, -, hcov, hW⟩ := wc_pencil_Rq_scalar_triv_cover F' F'' Y n D ℓ hℓ hP (n - 1)
  haveI hHL : HenselianLocalRing L := Field.henselian L
  haveI hRSC : IsSepClosed (IsLocalRing.ResidueField L) :=
    wc_henselian_sepClosed_transfer.2 L (IsLocalRing.ResidueField L)
      (RingEquiv.ofBijective (IsLocalRing.residue L)
        ⟨RingHom.injective _, IsLocalRing.residue_surjective⟩) instSC
  have hWE := wc_proet_scalarTriv_strict_local F'' hP ℓ (wcRq D.f ℓ (n - 1))
    (wcRqScalar D.f ℓ (n - 1)) r D.m D.S D.hS W w hcov hW E L eE
    (fun j => hE (eE.inv (IsLocalRing.closedPoint L)) j)
  obtain ⟨b, hb, -⟩ := wc_proet_scalarTriv_stalk_basis (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1))
    (wcRqScalar D.f ℓ (n - 1)) r E L eE (𝟙 E) hWE
  obtain ⟨es, -, hnat⟩ := wc_free_ext0_sections (wcP1Over F'').left (wcRq D.f ℓ (n - 1))
  let ρ : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) (wcRq D.f ℓ (n - 1)) 0 →+
      Abelian.Ext (wcFreeSheaf (wcP1Over F'').left E) (wcRq D.f ℓ (n - 1)) 0 :=
    (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a₀)).precomp (wcRq D.f ℓ (n - 1))
      (zero_add 0)
  have hρ : ∀ y, ρ y = (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a₀)).comp y
      (zero_add 0) := fun y => rfl
  have hρinj : Function.Injective ρ := by
    intro y y' h
    have h1 := congrArg (es E) h
    rw [hρ, hρ, hnat V E a₀ y, hnat V E a₀ y'] at h1
    exact (es V).injective (hinj h1)
  refine ⟨r, b.toAddMonoidHom.comp ρ, b.injective.comp hρinj, ?_⟩
  intro c y
  have e1 : ρ ((Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 1) c)).postcomp
      (wcFreeSheaf (wcP1Over F'').left V) (add_zero 0) y) =
      (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 1) c)).postcomp
        (wcFreeSheaf (wcP1Over F'').left E) (add_zero 0) (ρ y) := by
    show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a₀)).comp
        (y.comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 1) c)) (add_zero 0)) (zero_add 0) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a₀)).comp y (zero_add 0)).comp
        (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 1) c)) (add_zero 0)
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (add_zero 0) (by omega)).symm
  show b (ρ _) = c • b (ρ y)
  rw [e1]
  exact hb c (ρ y)

theorem wc_pencil_VQ_S_stalk_basis (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∀ j : Fin D.m, Nonempty (wcPencilStalkBasis D ℓ hP (D.S j (IsLocalRing.closedPoint F'')) 1) :=
by
  classical
  intro j

  have hx1 := wc_P1_section_closedPt_one F'' (D.S j) (D.hS j)
  obtain ⟨N⟩ := wc_P1_frob_nbhd_exists F'' 1 le_rfl _ hx1
  letI := N.ringA
  letI := N.hensA
  letI := N.sepA

  haveI hproj : Projective (wcFreeSheaf (wcP1Over F'').left N.V) :=
    @wc_proet_free_projective_strict_local (wcP1Over F'').left N.V N.A N.ringA N.hensA N.sepA N.e

  obtain ⟨r, κ, hκ, hκσ⟩ :=
    @wc_pencil_Rq_S_nbhd_embed F' F'' _ _ _ _ Y n hn hn2 D ℓ _ hℓ hP j N.V N.A N.ringA N.hensA
      N.sepA N.e N.hx

  choose ψ hψ₁ hψ₂ using fun c => wc_pencil_VQScalar_spec F' F'' Y n D ℓ hP c
  have hassoc : ∀ {X₁ X₂ X₃ X₄ : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left)
      AddCommGrpCat.{u+1}} (α : Abelian.Ext X₁ X₂ 0) (β : Abelian.Ext X₂ X₃ 0)
      (γ : Abelian.Ext X₃ X₄ 0),
      (α.comp β (add_zero 0)).comp γ (add_zero 0) = α.comp (β.comp γ (add_zero 0)) (add_zero 0) :=
    fun α β γ => Abelian.Ext.comp_assoc α β γ (add_zero 0) (add_zero 0) rfl
  have hmk : ∀ {X₁ X₂ X₃ : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left)
      AddCommGrpCat.{u+1}} (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃),
      (Abelian.Ext.mk₀ f).comp (Abelian.Ext.mk₀ g) (add_zero 0) = Abelian.Ext.mk₀ (f ≫ g) :=
    fun f g => Abelian.Ext.mk₀_comp_mk₀ f g

  let ψX : ℚ_[ℓ] → (Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
      (Subobject.underlying.obj (wcPencilE D ℓ hP)) 0 →+
      Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
        (Subobject.underlying.obj (wcPencilE D ℓ hP)) 0) :=
    fun c => (Abelian.Ext.mk₀ (ψ c)).postcomp (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0)
  let σ : ℚ_[ℓ] → (Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcPencilVQ D ℓ hP) 0 →+
      Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcPencilVQ D ℓ hP) 0) :=
    fun c => (Abelian.Ext.mk₀ (wcPencilVQScalar D ℓ hP c)).postcomp
      (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0)
  let ι : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
      (Subobject.underlying.obj (wcPencilE D ℓ hP)) 0 →+
      Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ (n - 1)) 0 :=
    (Abelian.Ext.mk₀ (wcPencilE D ℓ hP).arrow).postcomp
      (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0)
  have hι : Function.Injective ι := by
    intro y y' h
    obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
    obtain ⟨g', rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y'
    have h' : Abelian.Ext.mk₀ (g ≫ (wcPencilE D ℓ hP).arrow) =
        Abelian.Ext.mk₀ (g' ≫ (wcPencilE D ℓ hP).arrow) := by
      rw [← hmk, ← hmk]
      exact h
    have h'' := (Abelian.Ext.mk₀_bijective _ _).1 h'
    rw [cancel_mono] at h''
    rw [h'']
  let κX := κ.comp ι
  have hκX : Function.Injective κX := hκ.comp hι
  have hκXψ : ∀ (c : ℚ_[ℓ]) (x : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
      (Subobject.underlying.obj (wcPencilE D ℓ hP)) 0), κX (ψX c x) = c • κX x := by
    intro c x
    have e1 : ι (ψX c x) = (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 1) c)).postcomp
        (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) (ι x) := by
      show (x.comp (Abelian.Ext.mk₀ (ψ c)) (add_zero 0)).comp
          (Abelian.Ext.mk₀ (wcPencilE D ℓ hP).arrow) (add_zero 0) =
        (x.comp (Abelian.Ext.mk₀ (wcPencilE D ℓ hP).arrow) (add_zero 0)).comp
          (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 1) c)) (add_zero 0)
      rw [hassoc, hassoc, hmk, hmk, hψ₁ c]
    show κ (ι (ψX c x)) = c • κ (ι x)
    rw [e1]
    exact hκσ c (ι x)
  let p : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
      (Subobject.underlying.obj (wcPencilE D ℓ hP)) 0 →+
      Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcPencilVQ D ℓ hP) 0 :=
    (Abelian.Ext.mk₀ (Limits.cokernel.π ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).ofLE
      (wcPencilE D ℓ hP) inf_le_left))).postcomp
      (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0)
  have hp : Function.Surjective p :=
    (wc_ext0_projective_cokernel (P := wcFreeSheaf (wcP1Over F'').left N.V)
      ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).ofLE (wcPencilE D ℓ hP) inf_le_left)).1
  have hpψ : ∀ (c : ℚ_[ℓ]) (x : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
      (Subobject.underlying.obj (wcPencilE D ℓ hP)) 0), p (ψX c x) = σ c (p x) := by
    intro c x
    show (x.comp (Abelian.Ext.mk₀ (ψ c)) (add_zero 0)).comp
        (Abelian.Ext.mk₀ (Limits.cokernel.π ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).ofLE
          (wcPencilE D ℓ hP) inf_le_left))) (add_zero 0) =
      (x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).ofLE
          (wcPencilE D ℓ hP) inf_le_left))) (add_zero 0)).comp
        (Abelian.Ext.mk₀ (wcPencilVQScalar D ℓ hP c)) (add_zero 0)
    have h3 : (Abelian.Ext.mk₀ (Limits.cokernel.π ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).ofLE
          (wcPencilE D ℓ hP) inf_le_left))).comp
        (Abelian.Ext.mk₀ (wcPencilVQScalar D ℓ hP c)) (add_zero 0) =
        Abelian.Ext.mk₀ (ψ c ≫ Limits.cokernel.π ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).ofLE
          (wcPencilE D ℓ hP) inf_le_left)) := by
      rw [← hψ₂ c]
      exact Abelian.Ext.mk₀_comp_mk₀ _ _
    rw [hassoc, hassoc, hmk]
    exact congrArg (fun z => x.comp z (add_zero 0)) h3.symm

  let U : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]) :=
    { carrier := Set.range κX
      add_mem' := by
        rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
        exact ⟨x + y, map_add κX x y⟩
      zero_mem' := ⟨0, map_zero κX⟩
      smul_mem' := by
        rintro c _ ⟨x, rfl⟩
        exact ⟨ψX c x, hκXψ c x⟩ }
  let Wk : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]) :=
    { carrier := κX '' {x | p x = 0}
      add_mem' := by
        rintro _ _ ⟨x, hx, rfl⟩ ⟨y, hy, rfl⟩
        refine ⟨x + y, ?_, map_add κX x y⟩
        simp only [Set.mem_setOf_eq] at hx hy ⊢
        rw [map_add, hx, hy, add_zero]
      zero_mem' := ⟨0, by simp, map_zero κX⟩
      smul_mem' := by
        rintro c _ ⟨x, hx, rfl⟩
        refine ⟨ψX c x, ?_, hκXψ c x⟩
        simp only [Set.mem_setOf_eq] at hx ⊢
        rw [hpψ, hx, map_zero] }
  let Wk' : Submodule ℚ_[ℓ] U := Submodule.comap U.subtype Wk
  let M := U ⧸ Wk'
  let r' := Module.finrank ℚ_[ℓ] M
  let eM : M ≃ₗ[ℚ_[ℓ]] (Fin r' → ℚ_[ℓ]) := (Module.finBasis ℚ_[ℓ] M).equivFun
  let θt : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
      (Subobject.underlying.obj (wcPencilE D ℓ hP)) 0 →+ M :=
    { toFun := fun x => Submodule.Quotient.mk (⟨κX x, x, rfl⟩ : U)
      map_zero' := by
        rw [← Submodule.Quotient.mk_zero]
        congr 1
        exact Subtype.ext (map_zero κX)
      map_add' := fun x y => by
        rw [← Submodule.Quotient.mk_add]
        congr 1
        exact Subtype.ext (map_add κX x y) }
  have hθt : ∀ x, θt x = Submodule.Quotient.mk (⟨κX x, x, rfl⟩ : U) := fun x => rfl
  have hθt0 : ∀ x, θt x = 0 ↔ p x = 0 := by
    intro x
    rw [hθt, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap]
    constructor
    · rintro ⟨x', hx', hxx⟩
      have : x' = x := hκX hxx
      rw [← this]; exact hx'
    · intro hx
      exact ⟨x, hx, rfl⟩
  have hker : (AddMonoidHom.ker p) ≤ AddMonoidHom.ker θt := by
    intro x hx
    rw [AddMonoidHom.mem_ker] at hx ⊢
    exact (hθt0 x).2 hx
  let θ : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcPencilVQ D ℓ hP) 0 →+ M :=
    (QuotientAddGroup.lift (AddMonoidHom.ker p) θt hker).comp
      (QuotientAddGroup.quotientKerEquivOfSurjective p hp).symm.toAddMonoidHom
  have hθp : ∀ x, θ (p x) = θt x := by
    intro x
    have h1 : (QuotientAddGroup.quotientKerEquivOfSurjective p hp).symm (p x) =
        (QuotientAddGroup.mk x : _ ⧸ AddMonoidHom.ker p) := by
      apply (QuotientAddGroup.quotientKerEquivOfSurjective p hp).injective
      rw [AddEquiv.apply_symm_apply]
      rfl
    show QuotientAddGroup.lift (AddMonoidHom.ker p) θt hker
      ((QuotientAddGroup.quotientKerEquivOfSurjective p hp).symm (p x)) = θt x
    rw [h1]
    rfl
  have hθinj : Function.Injective θ := by
    rw [injective_iff_map_eq_zero]
    intro q hq
    obtain ⟨x, rfl⟩ := hp q
    rw [hθp] at hq
    exact (hθt0 x).1 hq
  have hθsurj : Function.Surjective θ := by
    intro m
    obtain ⟨⟨v, x, rfl⟩, rfl⟩ := Submodule.Quotient.mk_surjective Wk' m
    exact ⟨p x, hθp x⟩
  have hθσ : ∀ c q, θ (σ c q) = c • θ q := by
    intro c q
    obtain ⟨x, rfl⟩ := hp q
    rw [← hpψ, hθp, hθp, hθt, hθt, ← Submodule.Quotient.mk_smul]
    congr 1
    exact Subtype.ext (hκXψ c x)
  let e' := (AddEquiv.ofBijective θ ⟨hθinj, hθsurj⟩).trans eM.toAddEquiv
  have he' : ∀ (c : ℚ_[ℓ]) (q : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V)
      (wcPencilVQ D ℓ hP) 0), e' (σ c q) = c • e' q := by
    intro c q
    show eM (θ (σ c q)) = c • eM (θ q)
    rw [hθσ, LinearEquiv.map_smul]

  exact ⟨⟨N, r', e', he'⟩⟩

theorem wc_P1_punctual_coh (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (hSinj : Function.Injective (fun i => S i (IsLocalRing.closedPoint K)))
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (hsupp : ∀ V : (wcP1Over K).left.ProEt,
      (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
      ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left V) G 0, y = 0) :
    (∀ y : wcCohG K (wcP1Over K) hP G 1, y = 0) ∧
    ∀ (V : Fin m → (wcP1Over K).left.ProEt) (A : Fin m → Type u) [∀ i, CommRing (A i)]
      [∀ i, HenselianLocalRing (A i)] [∀ i, IsSepClosed (IsLocalRing.ResidueField (A i))]
      (e : ∀ i, (V i).left ≅ Spec (.of (A i)))
      (hx : ∀ i, (V i).hom ((e i).inv (IsLocalRing.closedPoint (A i))) =
        S i (IsLocalRing.closedPoint K))
      (g : ∀ i, V i ⟶ wcGeomPoint K (wcP1Over K) hP),
      Function.Bijective (fun y : wcCohG K (wcP1Over K) hP G 0 =>
        fun i => (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (g i))).comp y (zero_add 0)) :=
by
  classical

  have hfun : ∀ {A B C : (wcP1Over K).left.ProEt} (a : A ⟶ B) (b : B ⟶ C),
      wcFreeSheafMap (wcP1Over K).left a ≫ wcFreeSheafMap (wcP1Over K).left b =
        wcFreeSheafMap (wcP1Over K).left (a ≫ b) := by
    intro A B C a b
    have e : Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
        Functor.whiskerRight (yoneda.map (a ≫ b))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
      rw [yoneda.map_comp, Functor.whiskerRight_comp]
    exact ((presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
      AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
      (congrArg (presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
        AddCommGrpCat.{u+1}).map e)
  have hid : ∀ (A : (wcP1Over K).left.ProEt),
      wcFreeSheafMap (wcP1Over K).left (𝟙 A) = 𝟙 _ := by
    intro A
    have e : Functor.whiskerRight (yoneda.map (𝟙 A))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) = 𝟙 _ := by
      rw [yoneda.map_id, Functor.whiskerRight_id']
    exact (congrArg (presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
      AddCommGrpCat.{u+1}).map e).trans
      ((presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}).map_id _)

  have hzeroT : ∀ T : (wcP1Over K).left.ProEt,
      (∀ (t : T.left) (i : Fin m), T.hom t ≠ S i (IsLocalRing.closedPoint K)) →
      ∀ x : wcFreeSheaf (wcP1Over K).left T ⟶ G, x = 0 := by
    intro T hT x
    exact (Abelian.Ext.mk₀_bijective _ _).1 ((hsupp T hT _).trans (Abelian.Ext.mk₀_zero _ _).symm)

  have hclosed : ∀ s : Spec (.of K) ⟶ (wcP1Over K).left, s ≫ (wcP1Over K).hom = 𝟙 _ →
      IsClosed ({s (IsLocalRing.closedPoint K)} : Set (wcP1Over K).left) := by
    intro s hs
    haveI : IsClosedImmersion s := isClosedImmersion_of_comp_eq_id _ s hs
    have hrange : Set.range s = {s (IsLocalRing.closedPoint K)} := by
      ext z
      constructor
      · rintro ⟨a, rfl⟩
        rw [Subsingleton.elim a (IsLocalRing.closedPoint K)]
        exact Set.mem_singleton _
      · intro hz
        rw [Set.mem_singleton_iff.mp hz]
        exact ⟨_, rfl⟩
    rw [← hrange]
    exact s.isClosedEmbedding.isClosed_range
  have hin : ∀ (s : Spec (.of K) ⟶ (wcP1Over K).left), s ≫ (wcP1Over K).hom = 𝟙 _ →
      ∀ x : (wcP1Over K).left, x ≠ s (IsLocalRing.closedPoint K) →
        x ∈ (wcPunctOpen K s : Set (wcP1Over K).left) := by
    intro s hs x hx
    show x ∈ (closure {s (IsLocalRing.closedPoint K)})ᶜ
    rw [(hclosed s hs).closure_eq, Set.mem_compl_iff, Set.mem_singleton_iff]
    exact hx
  have hspec : ∀ (V : (wcP1Over K).left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A]
      (e : V.left ≅ Spec (.of A)) (v : V.left),
      V.hom v ⤳ V.hom (e.inv (IsLocalRing.closedPoint A)) := by
    intro V A _ _ e v
    have h3 : v ⤳ e.inv (IsLocalRing.closedPoint A) := by
      have := (IsLocalRing.specializes_closedPoint (e.hom v)).map e.inv.continuous
      rwa [Scheme.hom_inv_apply] at this
    exact h3.map V.hom.continuous

  have hcross : ∀ (s : Spec (.of K) ⟶ (wcP1Over K).left), s ≫ (wcP1Over K).hom = 𝟙 _ →
      ∀ (V : (wcP1Over K).left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A]
      (e : V.left ≅ Spec (.of A)),
      V.hom (e.inv (IsLocalRing.closedPoint A)) ≠ s (IsLocalRing.closedPoint K) →
      ∀ (g : V ⟶ wcGeomPoint K (wcP1Over K) hP),
      wcFreeSheafMap (wcP1Over K).left g ≫
        Limits.cokernel.π (wcFreeSheafMap (wcP1Over K).left (wcPunctIncl K s hP)) = 0 := by
    intro s hs V A _ _ e hne g
    have hrange : Set.range V.hom ⊆ Set.range (wcPunctOpen K s).ι := by
      rintro _ ⟨v, rfl⟩
      rw [Scheme.Opens.range_ι]
      apply hin s hs
      intro hv
      apply hne
      have h1 := hspec V A e v
      rw [hv] at h1
      exact Set.mem_singleton_iff.mp (h1.mem_closed (hclosed s hs) (Set.mem_singleton _))
    have hg : g.left ≫ Limits.pullback.fst (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) = V.hom :=
      MorphismProperty.Over.w g
    obtain ⟨l0, hl0, hl0'⟩ : ∃ l0 : V.left ⟶ (wcPunctGeom K s hP).left,
        l0 ≫ (wcPunctGeom K s hP).hom = V.hom ∧ l0 ≫ (wcPunctIncl K s hP).left = g.left :=
      ⟨Limits.pullback.lift (f := (wcPunctOpen K s).ι) (g := Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
          (IsOpenImmersion.lift (wcPunctOpen K s).ι V.hom hrange) g.left
          (by rw [IsOpenImmersion.lift_fac]; exact hg.symm),
        (Limits.pullback.lift_snd_assoc _ _ _ _).trans hg, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨l, hl⟩ : ∃ l : V ⟶ wcPunctGeom K s hP, l ≫ wcPunctIncl K s hP = g :=
      ⟨MorphismProperty.Over.homMk l0 hl0 trivial, MorphismProperty.Over.Hom.ext hl0'⟩
    rw [← hl, ← hfun, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]

  have abs_inj : ∀ {X₁ X₂ Y Z W : Sheaf (Scheme.ProEt.topology (wcP1Over K).left)
        AddCommGrpCat.{u+1}}
      (a : X₁ ⟶ X₂) (a' : X₂ ⟶ X₁) (ι : W ⟶ X₂) (k : Limits.cokernel ι ⟶ Y) [IsIso k]
      (c' : Y ⟶ Z), a' ≫ a = 𝟙 _ → a ≫ Limits.cokernel.π ι ≫ k ≫ c' = 0 → c' = 0 := by
    intro X₁ X₂ Y Z W a a' ι k _ c' ha h
    have h2 : Limits.cokernel.π ι ≫ k ≫ c' = 0 := by
      rw [← Category.id_comp (Limits.cokernel.π ι ≫ k ≫ c'), ← ha, Category.assoc, h,
        Limits.comp_zero]
    have h3 : k ≫ c' = 0 := by
      rw [← cancel_epi (Limits.cokernel.π ι), h2, Limits.comp_zero]
    rw [← Category.id_comp c', ← IsIso.inv_hom_id k, Category.assoc, h3, Limits.comp_zero]
  have abs_surj : ∀ {X₁ X₂ Y Z W : Sheaf (Scheme.ProEt.topology (wcP1Over K).left)
        AddCommGrpCat.{u+1}}
      (a : X₁ ⟶ X₂) (a' : X₂ ⟶ X₁) (ι : W ⟶ X₂) (k : Limits.cokernel ι ⟶ Y) [IsIso k]
      (h : X₁ ⟶ Z), a ≫ a' = 𝟙 _ → ι ≫ a' ≫ h = 0 →
      ∃ c' : Y ⟶ Z, a ≫ Limits.cokernel.π ι ≫ k ≫ c' = h := by
    intro X₁ X₂ Y Z W a a' ι k _ h ha hz
    refine ⟨inv k ≫ Limits.cokernel.desc ι (a' ≫ h) hz, ?_⟩
    rw [IsIso.hom_inv_id_assoc, Limits.cokernel.π_desc, ← Category.assoc, ha, Category.id_comp]

  have hloc : ∀ (i0 : Fin m) (V : (wcP1Over K).left.ProEt) (A : Type u) [CommRing A]
      [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
      (e : V.left ≅ Spec (.of A))
      (hx : V.hom (e.inv (IsLocalRing.closedPoint A)) = S i0 (IsLocalRing.closedPoint K))
      (g : V ⟶ wcGeomPoint K (wcP1Over K) hP),
      (∀ c' : Limits.cokernel (wcFreeSheafMap (wcP1Over K).left (wcPunctIncl K (S i0) hP)) ⟶ G,
        wcFreeSheafMap (wcP1Over K).left g ≫
          Limits.cokernel.π (wcFreeSheafMap (wcP1Over K).left (wcPunctIncl K (S i0) hP)) ≫ c' = 0 →
        c' = 0) ∧
      (∀ h : wcFreeSheaf (wcP1Over K).left V ⟶ G,
        ∃ c' : Limits.cokernel (wcFreeSheafMap (wcP1Over K).left (wcPunctIncl K (S i0) hP)) ⟶ G,
          wcFreeSheafMap (wcP1Over K).left g ≫
            Limits.cokernel.π (wcFreeSheafMap (wcP1Over K).left (wcPunctIncl K (S i0) hP)) ≫ c' =
          h) := by
    intro i0 V A _ _ _ e hx g
    obtain ⟨V₀, g₀, φ₀, A₀, iA₁, iA₂, iA₃, e₀, ε, hv, -, hε, -⟩ :=
      wc_P1bar_strict_local_nbhd K (S i0) (hS i0) hP
    obtain ⟨cc, hcc⟩ :=
      wc_pencil_PL_shens_nbhd_rigid K hP (S i0) (hS i0) V g A e hx V₀ g₀ A₀ e₀ hv
    obtain ⟨κ, hκ, hπκ⟩ :=
      wc_strict_nbhd_punct_excision K (S i0) (hS i0) hP V₀ g₀ A₀ e₀ ε hv hε
    haveI := hκ

    have hVT : ∀ (t : (wcOpenRestr (wcP1Over K).left (wcPunctOpen K (S i0)) V₀).left)
        (i : Fin m), (wcOpenRestr (wcP1Over K).left (wcPunctOpen K (S i0)) V₀).hom t ≠
          S i (IsLocalRing.closedPoint K) := by
      intro t i h
      set p := Limits.pullback.snd (wcPunctOpen K (S i0)).ι V₀.hom t with hp
      have h1 : (wcOpenRestr (wcP1Over K).left (wcPunctOpen K (S i0)) V₀).hom t = V₀.hom p := by
        first
          | exact Scheme.Hom.comp_apply (Limits.pullback.snd (wcPunctOpen K (S i0)).ι V₀.hom)
              V₀.hom t
          | rfl
      have h2 : V₀.hom p ∈ (wcPunctOpen K (S i0) : Set (wcP1Over K).left) := by
        have key : ∀ q : ↥(Limits.pullback (wcPunctOpen K (S i0)).ι V₀.hom),
            (Limits.pullback.snd (wcPunctOpen K (S i0)).ι V₀.hom ≫ V₀.hom) q ∈
              (wcPunctOpen K (S i0) : Set (wcP1Over K).left) := by
          intro q
          rw [← Limits.pullback.condition, Scheme.Hom.comp_apply,
            ← Scheme.Opens.range_ι (wcPunctOpen K (S i0))]
