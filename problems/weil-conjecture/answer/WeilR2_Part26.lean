theorem wc_fetg_frob_criterion : ∀ (Z : Scheme.{u}) (σ : Z ⟶ Z) (Ω : Type u) [Field Ω] (Q : ℕ) (φ : Ω →+* Ω), (∀ c, φ c = c ^ Q) → (∀ a : Spec (.of Ω) ⟶ Z, Spec.map (CommRingCat.ofHom φ) ≫ a = a ≫ σ → wcIsFrobAt σ (a (IsLocalRing.closedPoint Ω)) Q) ∧ (∀ (z : Z) (ι : Z.residueField z ⟶ CommRingCat.of Ω), wcIsFrobAt σ z Q → Spec.map (CommRingCat.ofHom φ) ≫ (Spec.map ι ≫ Z.fromSpecResidueField z) = (Spec.map ι ≫ Z.fromSpecResidueField z) ≫ σ) :=
by
  intro Z σ Ω _ Q φ hφ

  have s1 : ∀ (x : Z) (ι₁ ι₂ : Z.residueField x ⟶ CommRingCat.of Ω),
      Spec.map ι₁ ≫ Z.fromSpecResidueField x = Spec.map ι₂ ≫ Z.fromSpecResidueField x →
        ι₁ = ι₂ := by
    intro x ι₁ ι₂ h
    have h' : (Scheme.SpecToEquivOfField Ω Z).symm ⟨x, ι₁⟩ =
        (Scheme.SpecToEquivOfField Ω Z).symm ⟨x, ι₂⟩ := by
      rw [Scheme.SpecToEquivOfField_symm_apply, Scheme.SpecToEquivOfField_symm_apply]
      exact h
    have h2 := (Scheme.SpecToEquivOfField Ω Z).symm.injective h'
    exact eq_of_heq (Sigma.mk.inj_iff.mp h2).2

  have s2 : ∀ (x : Z) (hx : σ x = x),
      Spec.map ((Scheme.residueFieldCongr hx).inv ≫ σ.residueFieldMap x) ≫
        Z.fromSpecResidueField x = Z.fromSpecResidueField x ≫ σ := by
    intro x hx
    rw [Spec.map_comp, Category.assoc, Scheme.residueFieldCongr_inv,
      Scheme.residueFieldCongr_fromSpecResidueField,
      Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField]
  refine ⟨?_, ?_⟩
  ·
    intro a h
    obtain ⟨⟨x, ι⟩, rfl⟩ : ∃ p, (Scheme.SpecToEquivOfField Ω Z).symm p = a :=
      ⟨_, Equiv.symm_apply_apply _ a⟩
    rw [Scheme.SpecToEquivOfField_symm_apply] at h ⊢
    have hpt : ∀ p : ↥(Spec (.of Ω)), (Spec.map ι ≫ Z.fromSpecResidueField x) p = x := by
      intro p
      rw [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
    have hpt' : (Spec.map ι ≫ Z.fromSpecResidueField x) (IsLocalRing.closedPoint Ω) = x :=
      hpt _
    rw [hpt']
    have hx : σ x = x := by
      obtain ⟨p⟩ : Nonempty ↥(Spec (.of Ω)) := ⟨IsLocalRing.closedPoint Ω⟩
      have h1 := congrArg (fun f : Spec (.of Ω) ⟶ Z => f p) h
      simp only at h1
      simp only [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply] at h1
      exact h1.symm
    obtain ⟨Fr, hFrdef⟩ : ∃ Fr : Z.residueField x →+* Z.residueField x,
        Fr = ((Scheme.residueFieldCongr hx).inv ≫ σ.residueFieldMap x).hom := ⟨_, rfl⟩
    have hS : Spec.map (CommRingCat.ofHom Fr) ≫ Z.fromSpecResidueField x =
        Z.fromSpecResidueField x ≫ σ := by
      rw [hFrdef, CommRingCat.ofHom_hom]
      exact s2 x hx
    refine ⟨Fr, ?_, hS⟩
    have key : ι ≫ CommRingCat.ofHom φ = CommRingCat.ofHom Fr ≫ ι := by
      apply s1 x
      rw [Spec.map_comp, Spec.map_comp, Category.assoc, Category.assoc, hS, h, Category.assoc]
    intro c
    have e := congrArg (fun f => f.hom c) key
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at e
    rw [hφ, ← map_pow] at e
    exact (ι.hom.injective e).symm
  ·
    rintro z ι ⟨Fr, hFr, hS⟩
    have key : ι ≫ CommRingCat.ofHom φ = CommRingCat.ofHom Fr ≫ ι := by
      ext c
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, hφ, hFr,
        map_pow]
    rw [← Category.assoc, ← Spec.map_comp, key, Spec.map_comp, Category.assoc, hS]
    simp only [Category.assoc]

theorem wc_fetg_frob_conj : ∀ (K : Type u) [Field K] [Finite K] (Uo : (wcP1Over K).left.Opens) (Z : Scheme.{u}) (πZ : Z ⟶ Uo.toScheme) (G : Type) [Group G] [Finite G] (act : G → (Z ⟶ Z)), IsFinite πZ → (∀ g g', act (g * g') = act g ≫ act g') → (∀ g, act g ≫ πZ = πZ) → (∀ (T : Scheme.{u}), ConnectedSpace T → ∀ (a b : T ⟶ Z), a ≫ πZ = b ≫ πZ → ∃! g, b = a ≫ act g) → ∀ (d : ℕ) (z z' : Z) (y y' : G), Uo.ι (πZ z) = Uo.ι (πZ z') → wcIsFrobAt (act y) z (Nat.card K ^ d) → wcIsFrobAt (act y') z' (Nat.card K ^ d) → ∃ k : G, y' = k * y * k⁻¹ :=
by
  intro K _ _ Uo Z πZ G _ _ act _ hactm hactπ htors d z z' y y' hx hFy hFy'
  classical

  have alg : ∀ (k L L' : Type u) [Field k] [Field L] [Field L'] (r : k →+* L) (r' : k →+* L'),
      ∃ (Ω : Type u) (_ : Field Ω) (ι : L →+* Ω) (ι' : L' →+* Ω), ι.comp r = ι'.comp r' := by
    intro k L L' _ _ _ r r'
    letI : Algebra k L := r.toAlgebra
    letI : Algebra k L' := r'.toAlgebra
    obtain ⟨M, hM⟩ := Ideal.exists_maximal (TensorProduct k L L')
    letI : Field (TensorProduct k L L' ⧸ M) := Ideal.Quotient.field M
    refine ⟨TensorProduct k L L' ⧸ M, inferInstance,
      (Ideal.Quotient.mk M).comp (Algebra.TensorProduct.includeLeftRingHom),
      (Ideal.Quotient.mk M).comp (Algebra.TensorProduct.includeRight : L' →ₐ[k] _).toRingHom, ?_⟩
    ext c
    simp only [RingHom.comp_apply]
    congr 1
    show (r c) ⊗ₜ[k] (1 : L') = (1 : L) ⊗ₜ[k] (r' c)
    have h1 : r c = algebraMap k L c := rfl
    have h2 : r' c = algebraMap k L' c := rfl
    rw [h1, h2, Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,
      TensorProduct.smul_tmul]

  have frob : ∀ (Ω : Type u) [Field Ω] (χ : K →+* Ω), ∃ φ : Ω →+* Ω,
      ∀ c, φ c = c ^ (Nat.card K ^ d) := by
    intro Ω _ χ
    letI := Fintype.ofFinite K
    letI : Algebra K Ω := χ.toAlgebra
    have hFd : ∀ (n : ℕ) (c : Ω),
        (FiniteField.frobeniusAlgHom K Ω ^ n) c = c ^ (Fintype.card K ^ n) := by
      intro n
      induction n with
      | zero => intro c; simp
      | succ n ih =>
        intro c
        rw [pow_succ' (FiniteField.frobeniusAlgHom K Ω) n, AlgHom.mul_apply, ih,
          FiniteField.frobeniusAlgHom_apply, ← pow_mul, pow_succ (Fintype.card K) n]
    refine ⟨(FiniteField.frobeniusAlgHom K Ω ^ d).toRingHom, fun c => ?_⟩
    rw [← Fintype.card_eq_nat_card]
    exact hFd d c

  have grp : ∀ (T : Scheme.{u}), ConnectedSpace T → ∀ (a b Φ : T ⟶ Z) (k₀ : G),
      a ≫ πZ = b ≫ πZ → b = a ≫ act k₀ → Φ = a ≫ act (y * k₀) →
      Φ = b ≫ act y' → y * k₀ = k₀ * y' := by
    intro T hT a b Φ k₀ _ hk₀ h1 h2
    have c2 : a ≫ act (k₀ * y') = Φ := by
      rw [hactm, ← Category.assoc, ← hk₀, h2]
    have hac : a ≫ πZ = (a ≫ act (y * k₀)) ≫ πZ := by
      rw [Category.assoc, hactπ]
    obtain ⟨g, -, hg⟩ := htors T hT a _ hac
    exact (hg (y * k₀) rfl).trans (hg (k₀ * y') (h1.symm.trans c2.symm)).symm

  have hπ : πZ z = πZ z' := Uo.ι.isOpenEmbedding.isEmbedding.injective hx

  obtain ⟨Ω, _, ι₀, ι₀', hιι⟩ := alg _ _ _ (Scheme.Hom.residueFieldMap πZ z).hom
    ((Scheme.residueFieldCongr hπ).hom ≫ Scheme.Hom.residueFieldMap πZ z').hom
  obtain ⟨ι, hι⟩ : ∃ f : Z.residueField z ⟶ CommRingCat.of Ω, f.hom = ι₀ :=
    ⟨CommRingCat.ofHom ι₀, rfl⟩
  obtain ⟨ι', hι'⟩ : ∃ f : Z.residueField z' ⟶ CommRingCat.of Ω, f.hom = ι₀' :=
    ⟨CommRingCat.ofHom ι₀', rfl⟩
  have hrι : Scheme.Hom.residueFieldMap πZ z ≫ ι =
      ((Scheme.residueFieldCongr hπ).hom ≫ Scheme.Hom.residueFieldMap πZ z') ≫ ι' := by
    ext1
    rw [CommRingCat.hom_comp, CommRingCat.hom_comp, hι, hι']
    exact hιι
  have e1 : (Spec.map ι ≫ Z.fromSpecResidueField z) ≫ πZ =
      Spec.map (Scheme.Hom.residueFieldMap πZ z ≫ ι) ≫
        Uo.toScheme.fromSpecResidueField (πZ z) := by
    rw [Spec.map_comp, Category.assoc, Category.assoc,
      Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField]
  have e2 : (Spec.map ι' ≫ Z.fromSpecResidueField z') ≫ πZ =
      Spec.map (((Scheme.residueFieldCongr hπ).hom ≫ Scheme.Hom.residueFieldMap πZ z') ≫
        ι') ≫ Uo.toScheme.fromSpecResidueField (πZ z) := by
    rw [Spec.map_comp, Spec.map_comp]
    simp only [Category.assoc]
    rw [Scheme.residueFieldCongr_fromSpecResidueField,
      Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField]
  have hab : (Spec.map ι ≫ Z.fromSpecResidueField z) ≫ πZ =
      (Spec.map ι' ≫ Z.fromSpecResidueField z') ≫ πZ := by
    rw [e1, e2, hrι]

  obtain ⟨k₀, hk₀, -⟩ := htors (Spec (CommRingCat.of Ω)) inferInstance _ _ hab

  obtain ⟨φ, hφ⟩ := frob Ω (Spec.preimage
    (Spec.map ι ≫ Z.fromSpecResidueField z ≫ πZ ≫ Uo.ι ≫ (wcP1Over K).hom)).hom

  have htr : ∀ (w : Z) (ι₀ : Z.residueField w ⟶ CommRingCat.of Ω) (σ : Z ⟶ Z),
      wcIsFrobAt σ w (Nat.card K ^ d) →
      Spec.map (CommRingCat.ofHom φ) ≫ (Spec.map ι₀ ≫ Z.fromSpecResidueField w) =
        (Spec.map ι₀ ≫ Z.fromSpecResidueField w) ≫ σ := by
    rintro w ι₀ σ ⟨Fr, hFr, hcomm⟩
    have hring : ι₀ ≫ CommRingCat.ofHom φ = CommRingCat.ofHom Fr ≫ ι₀ := by
      ext c
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
      rw [hφ, hFr, map_pow]
    rw [← Category.assoc, ← Spec.map_comp, hring, Spec.map_comp, Category.assoc, hcomm,
      Category.assoc]
  have hA := htr z ι (act y) hFy
  have hB := htr z' ι' (act y') hFy'

  have hyk := grp (Spec (CommRingCat.of Ω)) inferInstance _ _
    (Spec.map (CommRingCat.ofHom φ) ≫ (Spec.map ι' ≫ Z.fromSpecResidueField z'))
    k₀ hab hk₀
    (by rw [hactm, hk₀]; simp only [Category.assoc] at hA ⊢; rw [reassoc_of% hA])
    hB

  refine ⟨k₀⁻¹, ?_⟩
  rw [inv_inv, mul_assoc, hyk, ← mul_assoc, inv_mul_cancel, one_mul]

theorem wc_fetg_low_count : ∀ (K : Type u) [Field K] [Finite K] (h : Polynomial K) (f : Polynomial (Polynomial K)) (n : ℕ), f.Monic → {p : AlgebraicClosure K × AlgebraicClosure K | Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) p.1 h ≠ 0 ∧ Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) p.1) p.2 f = 0 ∧ ∃ d ∈ n.properDivisors, p.1 ^ (Nat.card K ^ d) = p.1}.Finite ∧ Nat.card {p : AlgebraicClosure K × AlgebraicClosure K // Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) p.1 h ≠ 0 ∧ Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) p.1) p.2 f = 0 ∧ ∃ d ∈ n.properDivisors, p.1 ^ (Nat.card K ^ d) = p.1} ≤ f.natDegree * ∑ d ∈ n.properDivisors, (Nat.card K ^ d + 1) :=
by
  intro K _ _ h f n hf
  classical
  have hq1 : 1 < Nat.card K := Finite.one_lt_card
  let U : ℕ → Finset (AlgebraicClosure K) := fun d =>
    ((Polynomial.X : Polynomial (AlgebraicClosure K)) ^ (Nat.card K ^ d) - Polynomial.X).roots.toFinset
  let R : AlgebraicClosure K → Finset (AlgebraicClosure K) := fun u₀ =>
    (f.map (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀)).roots.toFinset
  let S : Finset (AlgebraicClosure K × AlgebraicClosure K) := n.properDivisors.biUnion
    (fun d => (U d).biUnion (fun u₀ => (R u₀).image (fun v₀ => (u₀, v₀))))
  have hU : ∀ d ∈ n.properDivisors, (U d).card ≤ Nat.card K ^ d := by
    intro d hd
    have hd0 : d ≠ 0 := (Nat.pos_of_mem_properDivisors hd).ne'
    calc (U d).card
        ≤ (((Polynomial.X : Polynomial (AlgebraicClosure K)) ^ (Nat.card K ^ d)
            - Polynomial.X).roots).card := Multiset.toFinset_card_le _
      _ ≤ ((Polynomial.X : Polynomial (AlgebraicClosure K)) ^ (Nat.card K ^ d)
            - Polynomial.X).natDegree := Polynomial.card_roots' _
      _ = Nat.card K ^ d := FiniteField.X_pow_card_pow_sub_X_natDegree_eq _ hd0 hq1
  have hR : ∀ u₀, (R u₀).card ≤ f.natDegree := by
    intro u₀
    calc (R u₀).card
        ≤ (f.map (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀)).roots.card :=
          Multiset.toFinset_card_le _
      _ ≤ (f.map (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀)).natDegree :=
          Polynomial.card_roots' _
      _ = f.natDegree := hf.natDegree_map _
  have hsub : {p : AlgebraicClosure K × AlgebraicClosure K |
      Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) p.1 h ≠ 0 ∧
      Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) p.1) p.2 f = 0 ∧
      ∃ d ∈ n.properDivisors, p.1 ^ (Nat.card K ^ d) = p.1} ⊆ ↑S := by
    rintro ⟨u₀, v₀⟩ ⟨-, hf0, d, hd, hpow⟩
    have hd0 : d ≠ 0 := (Nat.pos_of_mem_properDivisors hd).ne'
    rw [Finset.mem_coe, Finset.mem_biUnion]
    refine ⟨d, hd, ?_⟩
    rw [Finset.mem_biUnion]
    refine ⟨u₀, ?_, Finset.mem_image.mpr ⟨v₀, ?_, rfl⟩⟩
    · refine Multiset.mem_toFinset.mpr ((Polynomial.mem_roots
        (FiniteField.X_pow_card_pow_sub_X_ne_zero _ hd0 hq1)).mpr ?_)
      simp only [Polynomial.IsRoot, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X]
      exact sub_eq_zero.mpr hpow
    · refine Multiset.mem_toFinset.mpr ((Polynomial.mem_roots (hf.map _).ne_zero).mpr ?_)
      rw [Polynomial.IsRoot, ← Polynomial.eval₂_eq_eval_map]
      exact hf0
  refine ⟨S.finite_toSet.subset hsub, ?_⟩
  have hS : S.card ≤ ∑ d ∈ n.properDivisors, Nat.card K ^ d * f.natDegree := by
    refine Finset.card_biUnion_le.trans (Finset.sum_le_sum fun d hd => ?_)
    refine Finset.card_biUnion_le.trans ?_
    calc ∑ u ∈ U d, ((R u).image (fun v₀ => (u, v₀))).card
        ≤ ∑ u ∈ U d, f.natDegree :=
          Finset.sum_le_sum fun u _ => Finset.card_image_le.trans (hR u)
      _ = (U d).card * f.natDegree := by rw [Finset.sum_const, smul_eq_mul]
      _ ≤ Nat.card K ^ d * f.natDegree := Nat.mul_le_mul_right _ (hU d hd)
  have hfinal : ∑ d ∈ n.properDivisors, Nat.card K ^ d * f.natDegree ≤
      f.natDegree * ∑ d ∈ n.properDivisors, (Nat.card K ^ d + 1) := by
    rw [Finset.mul_sum]
    refine Finset.sum_le_sum fun d _ => ?_
    rw [mul_comm]
    exact Nat.mul_le_mul_left _ (Nat.le_succ _)
  have hcS : Nat.card (↑S : Set (AlgebraicClosure K × AlgebraicClosure K)) = S.card := by
    rw [Nat.card_coe_set_eq, Set.ncard_coe_finset]
  refine le_trans (Nat.card_mono S.finite_toSet hsub) ?_
  rw [hcS]
  exact hS.trans hfinal

theorem wc_fetg_frob_fixed_degree : ∀ (K : Type u) [Field K] [Finite K] (b : Spec (.of (AlgebraicClosure K)) ⟶ (wcP1Over K).left), b ≫ (wcP1Over K).hom = Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) → ∀ (n : ℕ), 1 ≤ n → (∀ (φ : AlgebraicClosure K →+* AlgebraicClosure K), (∀ c, φ c = c ^ (Nat.card K ^ n)) → Spec.map (CommRingCat.ofHom φ) ≫ b = b) → (∀ d ∈ n.properDivisors, ∀ (φ : AlgebraicClosure K →+* AlgebraicClosure K), (∀ c, φ c = c ^ (Nat.card K ^ d)) → Spec.map (CommRingCat.ofHom φ) ≫ b ≠ b) → b (IsLocalRing.closedPoint (AlgebraicClosure K)) ∈ wcP1ClosedPt K n :=
by
  intro K _ _ b _hbK n hn H1 H2
  classical
  have hq : 1 < Nat.card K := Finite.one_lt_card

  obtain ⟨ι, crit⟩ : ∃ ι : (wcP1Over K).left.residueField
        (b (IsLocalRing.closedPoint (AlgebraicClosure K))) ⟶ CommRingCat.of (AlgebraicClosure K),
      ∀ φ : AlgebraicClosure K →+* AlgebraicClosure K,
        (Spec.map (CommRingCat.ofHom φ) ≫ b = b ↔ ∀ c, φ (ι.hom c) = ι.hom c) := by
    set e := Scheme.SpecToEquivOfField (AlgebraicClosure K) (wcP1Over K).left
    have hb : b = Spec.map (e b).2 ≫ (wcP1Over K).left.fromSpecResidueField (e b).1 := by
      conv_lhs => rw [← e.symm_apply_apply b]
      rfl
    refine ⟨(e b).2, fun φ => ?_⟩
    have key : ∀ (y : (wcP1Over K).left)
        (ι : (wcP1Over K).left.residueField y ⟶ CommRingCat.of (AlgebraicClosure K)),
        b = Spec.map ι ≫ (wcP1Over K).left.fromSpecResidueField y →
        (Spec.map (CommRingCat.ofHom φ) ≫ b = b ↔ ∀ c, φ (ι.hom c) = ι.hom c) := by
      intro y ι hb'
      rw [hb', ← Category.assoc, ← Spec.map_comp, cancel_mono]
      constructor
      · intro h c
        have h2 := Spec.map_injective h
        have := congrArg (fun f => f.hom c) h2
        simpa using this
      · intro h
        congr 1
        ext c
        simpa using h c
    exact key _ _ hb

  letI : Fintype K := Fintype.ofFinite K
  have hfrob : ∀ m : ℕ, ∃ φ : AlgebraicClosure K →+* AlgebraicClosure K,
      ∀ c, φ c = c ^ (Nat.card K ^ m) := by
    intro m
    induction m with
    | zero => exact ⟨RingHom.id _, fun c => by simp⟩
    | succ m ih =>
      obtain ⟨φ, hφ⟩ := ih
      have h1 : ∀ x : AlgebraicClosure K,
          (FiniteField.frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K)) x =
            x ^ Fintype.card K := fun x => by
        rw [FiniteField.coe_frobeniusAlgEquivOfAlgebraic]
      refine ⟨(FiniteField.frobeniusAlgEquivOfAlgebraic K
        (AlgebraicClosure K)).toRingEquiv.toRingHom.comp φ, fun c => ?_⟩
      rw [RingHom.comp_apply, hφ]
      show (FiniteField.frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K))
        (c ^ Nat.card K ^ m) = _
      rw [h1, Fintype.card_eq_nat_card, ← pow_mul, pow_succ]

  have htrans : ∀ (m : ℕ) (φ : AlgebraicClosure K →+* AlgebraicClosure K),
      (∀ c, φ c = c ^ (Nat.card K ^ m)) →
      (Spec.map (CommRingCat.ofHom φ) ≫ b = b ↔
        ∀ c : (wcP1Over K).left.residueField (b (IsLocalRing.closedPoint (AlgebraicClosure K))),
          c ^ (Nat.card K ^ m) = c) := by
    intro m φ hφ
    rw [crit]
    constructor
    · intro h c
      apply ι.hom.injective
      rw [map_pow, ← hφ, h]
    · intro h c
      rw [hφ, ← map_pow, h]

  have ff : ∀ (κ : Type u) [Field κ] [Algebra K κ], (∀ c : κ, c ^ (Nat.card K ^ n) = c) →
      (∀ d ∈ n.properDivisors, ¬ ∀ c : κ, c ^ (Nat.card K ^ d) = c) →
      Module.Finite K κ ∧ Module.finrank K κ = n := by
    intro κ _ _ hFn hFd
    have hqn : 1 < Nat.card K ^ n := Nat.one_lt_pow (by omega) hq
    have hfin : Finite κ := by
      have hP := FiniteField.X_pow_card_sub_X_ne_zero κ hqn
      have hs := Polynomial.finite_setOfPred_isRoot hP
      refine Set.finite_univ_iff.mp (hs.subset fun c _ => ?_)
      simp only [Set.mem_ofPred_eq, Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, hFn c, sub_self]
    letI : Fintype κ := Fintype.ofFinite κ
    haveI : Module.Finite K κ := Module.Finite.of_finite
    have hcard : Fintype.card κ = Nat.card K ^ Module.finrank K κ := by
      rw [Fintype.card_eq_nat_card]; exact Module.natCard_eq_pow_finrank
    have hr1 : 1 ≤ Module.finrank K κ := by
      rcases Nat.eq_zero_or_pos (Module.finrank K κ) with h | h
      · exfalso
        have h1 : 1 < Fintype.card κ := Fintype.one_lt_card
        rw [hcard, h, pow_zero] at h1
        omega
      · exact h
    have hFr : ∀ c : κ, c ^ (Nat.card K ^ Module.finrank K κ) = c := fun c => by
      rw [← hcard]; exact FiniteField.pow_card c
    have hmin : ∀ m, 0 < m → (∀ c : κ, c ^ (Nat.card K ^ m) = c) → Module.finrank K κ ≤ m := by
      intro m hm hFm
      have hqm : 1 < Nat.card K ^ m := Nat.one_lt_pow (by omega) hq
      have hQ := FiniteField.X_pow_card_sub_X_ne_zero κ hqm
      have hdeg := FiniteField.X_pow_card_sub_X_natDegree_eq κ hqm
      have hsub : (Finset.univ : Finset κ).val ⊆
          (Polynomial.X ^ (Nat.card K ^ m) - Polynomial.X : Polynomial κ).roots := by
        intro c _
        rw [Polynomial.mem_roots hQ]
        simp only [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, hFm c, sub_self]
      have := Polynomial.card_le_degree_of_subset_roots hsub
      rw [hdeg, Finset.card_univ, hcard] at this
      exact (Nat.pow_le_pow_iff_right hq).mp this
    have hpow_mul : ∀ (m k : ℕ), (∀ c : κ, c ^ (Nat.card K ^ m) = c) →
        ∀ c : κ, c ^ (Nat.card K ^ (m * k)) = c := by
      intro m k hm
      induction k with
      | zero => intro c; simp
      | succ k ih => intro c; rw [Nat.mul_succ, pow_add, pow_mul, ih, hm]
    have hgcd : ∀ a b : ℕ, (∀ c : κ, c ^ (Nat.card K ^ a) = c) →
        (∀ c : κ, c ^ (Nat.card K ^ b) = c) → ∀ c : κ, c ^ (Nat.card K ^ (Nat.gcd a b)) = c := by
      intro a b
      refine Nat.gcd.induction
        (P := fun a b => (∀ c : κ, c ^ (Nat.card K ^ a) = c) →
          (∀ c : κ, c ^ (Nat.card K ^ b) = c) → ∀ c : κ, c ^ (Nat.card K ^ (Nat.gcd a b)) = c)
        a b (fun k _ h => by simpa using h) (fun m k hm ih hFm hFk => ?_)
      rw [Nat.gcd_rec]
      apply ih _ hFm
      intro c
      have h1 := hFk c
      rw [← Nat.mod_add_div k m, pow_add,
        pow_mul c (Nat.card K ^ (k % m)) (Nat.card K ^ (m * (k / m))),
        hpow_mul m (k / m) hFm] at h1
      exact h1
    have hg := hgcd _ _ hFr hFn
    have hgpos : 0 < Nat.gcd (Module.finrank K κ) n := Nat.gcd_pos_of_pos_left _ hr1
    have hle := hmin _ hgpos hg
    have hge : Nat.gcd (Module.finrank K κ) n ≤ Module.finrank K κ :=
      Nat.le_of_dvd hr1 (Nat.gcd_dvd_left _ n)
    have hrdvd : Module.finrank K κ ∣ n := by
      have heq : Nat.gcd (Module.finrank K κ) n = Module.finrank K κ := le_antisymm hge hle
      have h := Nat.gcd_dvd_right (Module.finrank K κ) n
      rwa [heq] at h
    refine ⟨inferInstance, ?_⟩
    by_contra hne
    have hlt : Module.finrank K κ < n := lt_of_le_of_ne (Nat.le_of_dvd (by omega) hrdvd) hne
    exact hFd _ (Nat.mem_properDivisors.mpr ⟨hrdvd, hlt⟩) hFr

  have hProper : IsProper (wcProjKStr K 1) := by
    letI := @MvPolynomial.gradedAlgebra (Fin (1+1)) K _
    letI : IsScalarTower K ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0)
        (MvPolynomial (Fin (1+1)) K) :=
      IsScalarTower.of_algebraMap_eq (R := K)
        (S := (MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0)
        (A := MvPolynomial (Fin (1+1)) K) (fun r => rfl)
    haveI : Algebra.FiniteType ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0)
        (MvPolynomial (Fin (1+1)) K) :=
      Algebra.FiniteType.of_restrictScalars_finiteType K _ _
    haveI : IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1+1)) K)) :=
      inferInstance
    have hbij : Function.Bijective
        (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0)) := by
      constructor
      · intro a b hab
        have h := congrArg (fun x : (MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0 =>
          (x : MvPolynomial (Fin (1+1)) K)) hab
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq] at h
        exact MvPolynomial.C_injective _ _ h
      · intro x
        have hx : (x : MvPolynomial (Fin (1+1)) K).IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule 0 _).mp x.2
        have ht : (x : MvPolynomial (Fin (1+1)) K).totalDegree = 0 :=
          Nat.le_zero.mp hx.totalDegree_le
        refine ⟨(x : MvPolynomial (Fin (1+1)) K).coeff 0, Subtype.ext ?_⟩
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp ht).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0))) := by
      rw [ConcreteCategory.isIso_iff_bijective]
      exact hbij
    show IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0))))
    infer_instance
  haveI hLOFT : LocallyOfFiniteType (wcP1Over K).hom := by
    show LocallyOfFiniteType (wcProjKStr K 1)
    infer_instance
  have hclosed : ∀ (Z : Scheme.{u}) (s : Z ⟶ Spec (.of K)) [LocallyOfFiniteType s] (x : Z),
      ((Z.residue x).hom.comp (wcLdpConst K s x)).Finite → IsClosed ({x} : Set Z) := by
    intro Z s _ x hfin
    set φ : CommRingCat.of K ⟶ Z.residueField x :=
      CommRingCat.ofHom (wcLdpConst K s x) ≫ Z.residue x with hφdef
    have hconst : CommRingCat.ofHom (wcLdpConst K s x) =
        (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ s.appTop ≫ Z.presheaf.germ ⊤ x trivial := by
      rfl
    have hstalk : Z.fromSpecStalk x ≫ s = Spec.map (CommRingCat.ofHom (wcLdpConst K s x)) := by
      calc Z.fromSpecStalk x ≫ s
          = Z.fromSpecStalk x ≫ s ≫ (Spec (CommRingCat.of K)).toSpecΓ ≫
              Spec.map (Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
            rw [toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
        _ = Z.fromSpecStalk x ≫ Z.toSpecΓ ≫ Spec.map s.appTop ≫
              Spec.map (Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
            rw [← Category.assoc s, Scheme.toSpecΓ_naturality, Category.assoc]
        _ = Spec.map (Z.presheaf.germ ⊤ x trivial) ≫ Spec.map s.appTop ≫
              Spec.map (Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
            rw [← Category.assoc, Scheme.fromSpecStalk_toSpecΓ]
        _ = Spec.map (CommRingCat.ofHom (wcLdpConst K s x)) := by
            rw [hconst, Spec.map_comp, Spec.map_comp, Category.assoc]
    have hcompat : Z.fromSpecResidueField x ≫ s = Spec.map φ := by
      rw [hφdef, Spec.map_comp, Scheme.fromSpecResidueField, Category.assoc, hstalk]
    haveI : JacobsonSpace Z := LocallyOfFiniteType.jacobsonSpace s
    have hft : φ.hom.FiniteType := RingHom.Finite.finiteType hfin
    have h1 : LocallyOfFiniteType (Spec.map φ) :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mpr hft
    haveI : LocallyOfFiniteType (Z.fromSpecResidueField x ≫ s) := by
      rw [hcompat]; exact h1
    haveI : LocallyOfFiniteType (Z.fromSpecResidueField x) :=
      locallyOfFiniteType_of_comp (Z.fromSpecResidueField x) s
    exact isClosed_singleton_iff_locallyOfFiniteType.mpr inferInstance

  obtain ⟨φn, hφn⟩ := hfrob n
  have hFn := (htrans n φn hφn).mp (H1 φn hφn)
  have hFd : ∀ d ∈ n.properDivisors, ¬ ∀ c : (wcP1Over K).left.residueField
      (b (IsLocalRing.closedPoint (AlgebraicClosure K))), c ^ (Nat.card K ^ d) = c := by
    intro d hd hFix
    obtain ⟨φd, hφd⟩ := hfrob d
    exact H2 d hd φd hφd ((htrans d φd hφd).mpr hFix)
  obtain ⟨hmodfin, hrank⟩ := @ff ((wcP1Over K).left.residueField
      (b (IsLocalRing.closedPoint (AlgebraicClosure K)))) _
    (((wcP1Over K).left.residue (b (IsLocalRing.closedPoint (AlgebraicClosure K)))).hom.comp
      (wcLdpConst K (wcP1Over K).hom (b (IsLocalRing.closedPoint (AlgebraicClosure K))))).toAlgebra
    hFn hFd
  exact ⟨hclosed _ (wcP1Over K).hom _ hmodfin, hrank⟩

theorem wc_fetg_p1_affine_line : ∀ (K : Type u) [Field K], ∃ j : Spec (.of (Polynomial K)) ⟶ (wcP1Over K).left, IsOpenImmersion j ∧ j ≫ (wcP1Over K).hom = Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) :=
by
  classical
  intro K _
  have hchart : ∀ (a : Fin (1 + 1)), ∃ eW : (@Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
      (MvPolynomial.X a) : Scheme.{u}) ≅ Spec (.of (Polynomial K)),
      eW.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) =
        (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
          MvPolynomial.gradedAlgebra (MvPolynomial.X a)).ι ≫ wcProjKStr K 1 := by
    intro a
    show ∃ e : (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X a) : Scheme.{u}) ≅ Spec (.of (Polynomial K)), e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) = (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X a)).ι ≫ (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0))))
    have hrev : a.rev ≠ a := by revert a; decide
    have hcases : ∀ i : Fin (1 + 1), i = a ∨ i = a.rev := by revert a; decide
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hscale : ∀ {S : Type u} [CommRing S] (f : K →+* S) (x : Fin (1 + 1) → S) (s : S)
        (p : MvPolynomial (Fin (1 + 1)) K) (n : ℕ), p.IsHomogeneous n →
        MvPolynomial.eval₂ f (fun i => s * x i) p = s ^ n * MvPolynomial.eval₂ f x p := by
      intro S _ f x s p n hp
      rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun d hd => ?_)
      have hdeg : ∑ i ∈ d.support, d i = n := by
        have h := hp (MvPolynomial.mem_support_iff.mp hd)
        simpa [Finsupp.weight_apply, Finsupp.sum] using h
      simp_rw [mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
      ring
    have hf : (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 1 := by
      rw [MvPolynomial.mem_homogeneousSubmodule]; exact MvPolynomial.isHomogeneous_X K a
    have hb : (MvPolynomial.X a.rev : MvPolynomial (Fin (1 + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K (1 • 1) := by
      rw [smul_eq_mul, mul_one, MvPolynomial.mem_homogeneousSubmodule]
      exact MvPolynomial.isHomogeneous_X K a.rev
    let T : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (MvPolynomial.X a) :=
      HomogeneousLocalization.Away.mk _ hf 1 (MvPolynomial.X a.rev) hb
    let ι₀ := HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (Submonoid.powers (MvPolynomial.X a))
    let c₀ := algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)
    let ψ : Polynomial K →+* HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X a) :=
      Polynomial.eval₂RingHom (ι₀.comp c₀) T
    let χ₀ : MvPolynomial (Fin (1 + 1)) K →+* Polynomial K :=
      MvPolynomial.eval₂Hom Polynomial.C (fun i => if i = a then 1 else Polynomial.X)
    have hχa : χ₀ (MvPolynomial.X a) = 1 := by simp [χ₀]
    have hχb : χ₀ (MvPolynomial.X a.rev) = Polynomial.X := by simp [χ₀, hrev]
    have hχC : ∀ k, χ₀ (MvPolynomial.C k) = Polynomial.C k := by intro k; simp [χ₀]
    let Λ : Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) →+*
        Polynomial K :=
      IsLocalization.Away.lift (MvPolynomial.X a) (g := χ₀) (by rw [hχa]; exact isUnit_one)
    have hΛ : ∀ p, Λ (algebraMap _ (Localization.Away (MvPolynomial.X a :
        MvPolynomial (Fin (1 + 1)) K)) p) = χ₀ p := fun p => IsLocalization.Away.lift_eq _ _ p
    let χ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (MvPolynomial.X a) →+* Polynomial K :=
      Λ.comp (algebraMap _ (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K)))
    have hΛ1 : ∀ y : Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K),
        Λ (IsLocalization.mk' (Localization.Away (MvPolynomial.X a :
          MvPolynomial (Fin (1 + 1)) K)) 1 y) = 1 := by
      intro y
      have h := congrArg Λ (IsLocalization.mk'_spec (Localization.Away (MvPolynomial.X a :
          MvPolynomial (Fin (1 + 1)) K)) (1 : MvPolynomial (Fin (1 + 1)) K) y)
      rw [map_mul, hΛ, hΛ] at h
      obtain ⟨n, hn⟩ := y.2
      rw [← hn, map_pow, hχa, one_pow, mul_one, map_one] at h
      exact h
    have F1 : ∀ n p hp, χ (HomogeneousLocalization.Away.mk _ hf n p hp) = χ₀ p := by
      intro n p hp
      simp only [χ, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk]
      rw [Localization.mk_eq_mk', IsLocalization.mk'_eq_mul_mk'_one, map_mul, hΛ, hΛ1, mul_one]
    have F0 : ∀ k : K, (ι₀ (c₀ k)).val = algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K))
        (MvPolynomial.C k) := by
      intro k
      rw [← Localization.mk_one_eq_algebraMap]
      rfl
    have hψC : ∀ k, ψ (Polynomial.C k) = ι₀ (c₀ k) := by
      intro k; simp [ψ]
    have hψX : ψ Polynomial.X = T := by simp [ψ]
    have hi : χ.comp ψ = RingHom.id _ := by
      apply Polynomial.ringHom_ext
      · intro k
        rw [RingHom.comp_apply, hψC, RingHom.id_apply]
        simp only [χ, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
        rw [F0, hΛ, hχC]
      · rw [RingHom.comp_apply, hψX, RingHom.id_apply, F1, hχb]
    have hii : ψ.comp χ = RingHom.id _ := by
      apply RingHom.ext
      intro y
      obtain ⟨n, p, hp, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ hf y
      rw [RingHom.comp_apply, F1, RingHom.id_apply]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk]
      let u : Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) :=
        Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩
      let V : MvPolynomial (Fin (1 + 1)) K →+*
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) :=
        (algebraMap _ _).comp (ψ.comp χ₀)
      let W : MvPolynomial (Fin (1 + 1)) K →+*
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) :=
        MvPolynomial.eval₂Hom (algebraMap K _) (fun i : Fin (1 + 1) => u *
          algebraMap (MvPolynomial (Fin (1 + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K))
            (MvPolynomial.X i))
      have hKA : ∀ k : K, algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K))
          (MvPolynomial.C k) = algebraMap K _ k := by
        intro k
        rw [IsScalarTower.algebraMap_apply K (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K)),
          MvPolynomial.algebraMap_eq]
      have hVW : V = W := by
        apply MvPolynomial.ringHom_ext
        · intro k
          simp only [V, W, RingHom.comp_apply, MvPolynomial.eval₂Hom_C, hχC, hψC,
            HomogeneousLocalization.algebraMap_apply]
          rw [F0, hKA]
        · intro i
          rcases hcases i with rfl | rfl
          · simp only [V, W, RingHom.comp_apply, MvPolynomial.eval₂Hom_X', hχa, map_one, u]
            rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
            exact (Localization.mk_self (⟨MvPolynomial.X i, Submonoid.mem_powers _⟩ :
              Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (1 + 1)) K))).symm
          · simp only [V, W, RingHom.comp_apply, MvPolynomial.eval₂Hom_X', hχb, hψX, u,
              HomogeneousLocalization.algebraMap_apply, T, HomogeneousLocalization.Away.val_mk]
            rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
            congr 1
            ext
            simp
      have hval : (ψ (χ₀ p)).val = V p := by
        simp only [V, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
      have hph : p.IsHomogeneous n := by
        have hp' := hp
        rw [smul_eq_mul, mul_one, MvPolynomial.mem_homogeneousSubmodule] at hp'
        exact hp'
      have heta : MvPolynomial.eval₂ (algebraMap K (Localization.Away (MvPolynomial.X a :
          MvPolynomial (Fin (1 + 1)) K))) (fun i : Fin (1 + 1) =>
            algebraMap (MvPolynomial (Fin (1 + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K))
            (MvPolynomial.X i)) p =
          algebraMap (MvPolynomial (Fin (1 + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K)) p := by
        have h := MvPolynomial.eval₂_comp_left (algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K)))
          MvPolynomial.C MvPolynomial.X p
        rw [MvPolynomial.eval₂_eta] at h
        rw [h, ← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_eq]
        rfl
      rw [hval, hVW]
      simp only [W, MvPolynomial.coe_eval₂Hom]
      rw [hscale _ _ u p n hph, heta, ← Localization.mk_one_eq_algebraMap]
      simp only [u]
      rw [Localization.mk_pow, Localization.mk_mul, one_pow, one_mul, mul_one]
      congr 1
    let e2 : Spec (.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X a))) ≅
        Spec (.of (Polynomial K)) :=
      { hom := Spec.map (CommRingCat.ofHom ψ)
        inv := Spec.map (CommRingCat.ofHom χ)
        hom_inv_id := by
          rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hii]
          exact Spec.map_id _
        inv_hom_id := by
          rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hi]
          exact Spec.map_id _ }
    have hcomp : ψ.comp (algebraMap K (Polynomial K)) =
        (HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
          (Submonoid.powers (MvPolynomial.X a))).comp
          (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)) := by
      rw [Polynomial.algebraMap_eq]
      exact RingHom.ext hψC
    refine ⟨Proj.basicOpenIsoSpec (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
      (MvPolynomial.X a) hf Nat.one_pos ≪≫ e2, ?_⟩
    rw [Iso.trans_hom, Category.assoc]
    change _ ≫ Spec.map (CommRingCat.ofHom ψ) ≫ _ = _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp, CommRingCat.ofHom_comp, Spec.map_comp,
      ← Proj.awayι_toSpecZero _ _ hf Nat.one_pos, ← Proj.basicOpenIsoSpec_inv_ι _ _ hf Nat.one_pos]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
  obtain ⟨eW, heW⟩ := hchart 0
  obtain ⟨j, hjdef⟩ : ∃ j : Spec (.of (Polynomial K)) ⟶ (wcP1Over K).left,
      j = eW.inv ≫ (@Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
        (MvPolynomial.X 0)).ι := ⟨_, rfl⟩
  refine ⟨j, ?_, ?_⟩
  · rw [hjdef]; infer_instance
  · rw [hjdef]
    show (eW.inv ≫ _) ≫ wcProjKStr K 1 = _
    rw [Category.assoc, ← heW, Iso.inv_hom_id_assoc]

theorem wc_fetg_cover_integral_surj : ∀ (K : Type u) [Field K] [Finite K] (Uo : (wcP1Over K).left.Opens) (Z : Scheme.{u}) (πZ : Z ⟶ Uo.toScheme), IsFinite πZ → Etale πZ → ConnectedSpace Z → AlgebraicGeometry.IsIntegral Z ∧ Surjective πZ :=
by
  intro K _ _ Uo Z πZ hfin het hZc
  haveI := hfin
  haveI := het
  haveI := hZc
  haveI : SmoothOfRelativeDimension 1 (wcProjKStr K 1) := wc_proj_space_smooth K 1
  haveI hq : Smooth (wcProjKStr K 1) := SmoothOfRelativeDimension.smooth 1 (wcProjKStr K 1)
  haveI hq' : Smooth (wcP1Over K).hom := hq
  haveI hs : Smooth (πZ ≫ Uo.ι ≫ (wcP1Over K).hom) := inferInstance
  have hdom : ∀ z : Z, IsDomain (Z.presheaf.stalk z) := fun z =>
    (wc_fntame_smooth_stalk_normal K Z (πZ ≫ Uo.ι ≫ (wcP1Over K).hom) z).1
  haveI : IsLocallyNoetherian Z :=
    LocallyOfFiniteType.isLocallyNoetherian (πZ ≫ Uo.ι ≫ (wcP1Over K).hom)
  haveI hirr : IrreducibleSpace Z := wcpa_irreducible_of_connected_domain_stalks Z hdom
  haveI hred_st : ∀ z : Z, _root_.IsReduced (Z.presheaf.stalk z) := fun z => by
    haveI := hdom z
    infer_instance
  haveI hred : AlgebraicGeometry.IsReduced Z := isReduced_of_isReduced_stalk Z
  refine ⟨isIntegral_of_irreducibleSpace_of_isReduced Z, ?_⟩

  haveI hP : IrreducibleSpace ↥(wcProjK K 1) := wc_proj_space_irreducible K 1
  have h1 : IsPreirreducible (Set.univ : Set ↥(wcProjK K 1)) :=
    (IrreducibleSpace.isIrreducible_univ _).isPreirreducible
  have h2 : IsPreirreducible (⇑Uo.ι ⁻¹' (Set.univ : Set ↥(wcProjK K 1))) :=
    h1.preimage Uo.ι.isOpenEmbedding
  rw [Set.preimage_univ] at h2
  haveI : PreconnectedSpace ↥Uo.toScheme := ⟨h2.isPreconnected⟩
  have hcl : IsClosed (Set.range ⇑πZ) := πZ.isClosedMap.isClosed_range
  have hop : IsOpen (Set.range ⇑πZ) := πZ.isOpenMap.isOpen_range
  have hne : (Set.range ⇑πZ).Nonempty := Set.range_nonempty _
  have huniv : Set.range ⇑πZ = Set.univ := IsClopen.eq_univ ⟨hcl, hop⟩ hne
  exact (surjective_iff πZ).mpr (Set.range_eq_univ.mp huniv)

theorem wc_fetg_cover_affine_piece : ∀ (K : Type u) [Field K] [Finite K] (Uo : (wcP1Over K).left.Opens) (Z : Scheme.{u}) (πZ : Z ⟶ Uo.toScheme) (G : Type) [Group G] [Finite G] (act : G → (Z ⟶ Z)) (j : Spec (.of (Polynomial K)) ⟶ (wcP1Over K).left), IsFinite πZ → Etale πZ → AlgebraicGeometry.IsIntegral Z → Surjective πZ → act 1 = 𝟙 Z → (∀ g g', act (g * g') = act g ≫ act g') → (∀ g, act g ≫ πZ = πZ) → IsOpenImmersion j → ∃ (h₁ : Polynomial K) (B : Type u) (_ : CommRing B) (_ : Algebra (Localization.Away h₁) B) (ι : Spec (.of B) ⟶ Z) (α : G → (B →+* B)), h₁ ≠ 0 ∧ IsDomain B ∧ Module.Finite (Localization.Away h₁) B ∧ Algebra.Etale (Localization.Away h₁) B ∧ IsOpenImmersion ι ∧ ι ≫ πZ ≫ Uo.ι = Spec.map (CommRingCat.ofHom ((algebraMap (Localization.Away h₁) B).comp (algebraMap (Polynomial K) (Localization.Away h₁)))) ≫ j ∧ (∀ g (a : Localization.Away h₁), α g (algebraMap (Localization.Away h₁) B a) = algebraMap (Localization.Away h₁) B a) ∧ α 1 = RingHom.id B ∧ (∀ g g', α (g * g') = (α g).comp (α g')) ∧ ∀ g, Spec.map (CommRingCat.ofHom (α g)) ≫ ι = ι ≫ act g :=
by
  intro K _ _
  have hKne : Nonempty ↥(Spec (.of (Polynomial K))) := inferInstance
  have hlocdom : ∀ h : Polynomial K, h ≠ 0 → IsDomain (Localization.Away h) := fun h hh =>
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hh)

  have hirrP : IrreducibleSpace ↥(wcP1Over K).left := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      MvPolynomial.gradedAlgebra
    show IrreducibleSpace (ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K))
    have hprime : (⊥ : HomogeneousIdeal
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)).toIdeal.IsPrime := by
      rw [HomogeneousIdeal.toIdeal_bot]
      exact Ideal.isPrime_bot
    have hirr : ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        ≤ ⊥ := by
      intro h
      have hX0 := HomogeneousIdeal.mem_irrelevant_of_mem
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (i := 1) Nat.one_pos
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
          (MvPolynomial.isHomogeneous_X K (0 : Fin (1 + 1))))
      have h0 := h hX0
      rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at h0
      exact MvPolynomial.X_ne_zero (0 : Fin (1 + 1)) h0
    let η : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      ⟨⊥, hprime, hirr⟩
    have hcl : closure ({η} : Set _) = Set.univ := by
      apply Set.eq_univ_of_forall
      intro x
      apply (ProjectiveSpectrum.le_iff_mem_closure _ η x).mp
      apply (ProjectiveSpectrum.as_ideal_le_as_ideal _ η x).mp
      exact bot_le
    apply (irreducibleSpace_def _).mpr
    rw [Set.top_eq_univ, ← hcl]
    exact isIrreducible_singleton.closure
  intro Uo Z πZ G _ _ act j hfin het hZint hsurj hact1 hactm hactπ hjo

  have s2 : ∀ (A : Type u) [CommRing A] (Y Z : Scheme.{u}) (πZ : Z ⟶ Y) (k : Spec (.of A) ⟶ Y),
      IsFinite πZ → Etale πZ → IsOpenImmersion k →
      ∃ (B : Type u) (_ : CommRing B) (_ : Algebra A B) (ι : Spec (.of B) ⟶ Z),
        Module.Finite A B ∧ Algebra.Etale A B ∧ IsOpenImmersion ι ∧
        IsPullback ι (Spec.map (CommRingCat.ofHom (algebraMap A B))) πZ k := by
    intro A _ Y Z πZ k hfin het hk
    haveI : IsAffine (Limits.pullback πZ k) := inferInstance
    let φ : A →+* Γ(Limits.pullback πZ k, ⊤) :=
      ((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ (Limits.pullback.snd πZ k).appTop).hom
    letI : Algebra A Γ(Limits.pullback πZ k, ⊤) := φ.toAlgebra
    have hkey : (Limits.pullback πZ k).isoSpec.inv ≫ Limits.pullback.snd πZ k =
        Spec.map (CommRingCat.ofHom (algebraMap A Γ(Limits.pullback πZ k, ⊤))) := by
      rw [← Scheme.isoSpec_inv_naturality, Scheme.isoSpec_Spec_inv, ← Spec.map_comp]
      rfl
    have hP : IsPullback ((Limits.pullback πZ k).isoSpec.inv ≫ Limits.pullback.fst πZ k)
        (Spec.map (CommRingCat.ofHom (algebraMap A Γ(Limits.pullback πZ k, ⊤)))) πZ k :=
      IsPullback.of_iso_pullback
        ⟨by rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hkey]⟩
        (Limits.pullback πZ k).isoSpec.symm rfl hkey
    have hsndfin : IsFinite (Limits.pullback.snd πZ k) :=
      MorphismProperty.of_isPullback (P := @IsFinite) (IsPullback.of_hasPullback πZ k) hfin
    have hsndet : Etale (Limits.pullback.snd πZ k) :=
      MorphismProperty.of_isPullback (P := @Etale) (IsPullback.of_hasPullback πZ k) het
    have hfstoi : IsOpenImmersion (Limits.pullback.fst πZ k) :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) (IsPullback.of_hasPullback πZ k).flip hk
    have hsfin : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap A Γ(Limits.pullback πZ k, ⊤)))) := by
      rw [← hkey]; infer_instance
    have hset : Etale (Spec.map (CommRingCat.ofHom (algebraMap A Γ(Limits.pullback πZ k, ⊤)))) := by
      rw [← hkey]; infer_instance
    refine ⟨Γ(Limits.pullback πZ k, ⊤), inferInstance, inferInstance,
      (Limits.pullback πZ k).isoSpec.inv ≫ Limits.pullback.fst πZ k, ?_, ?_, ?_, hP⟩
    · exact RingHom.finite_algebraMap.mp ((IsFinite.SpecMap_iff _).mp hsfin)
    · exact RingHom.Etale.toAlgebra ((HasRingHomProperty.Spec_iff (P := @Etale)).mp hset)
    · infer_instance

  have s3 : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] (Y Z : Scheme.{u})
      (πZ : Z ⟶ Y) (k : Spec (.of A) ⟶ Y) (ι : Spec (.of B) ⟶ Z) (G : Type) [Group G]
      (act : G → (Z ⟶ Z)), IsPullback ι (Spec.map (CommRingCat.ofHom (algebraMap A B))) πZ k →
      act 1 = 𝟙 Z → (∀ g g', act (g * g') = act g ≫ act g') → (∀ g, act g ≫ πZ = πZ) →
      ∃ α : G → (B →+* B), (∀ g (a : A), α g (algebraMap A B a) = algebraMap A B a) ∧
        α 1 = RingHom.id B ∧ (∀ g g', α (g * g') = (α g).comp (α g')) ∧
        ∀ g, Spec.map (CommRingCat.ofHom (α g)) ≫ ι = ι ≫ act g := by
    intro A B _ _ _ Y Z πZ k ι G _ act hP hact1 hactm hactπ
    have hw : ∀ g, (ι ≫ act g) ≫ πZ = Spec.map (CommRingCat.ofHom (algebraMap A B)) ≫ k :=
      fun g => by rw [Category.assoc, hactπ g]; exact hP.w
    obtain ⟨σ, hσ1, hσ2⟩ : ∃ σ : G → (Spec (.of B) ⟶ Spec (.of B)),
        (∀ g, σ g ≫ ι = ι ≫ act g) ∧
        ∀ g, σ g ≫ Spec.map (CommRingCat.ofHom (algebraMap A B)) =
          Spec.map (CommRingCat.ofHom (algebraMap A B)) :=
      ⟨fun g => hP.lift (ι ≫ act g) _ (hw g), fun g => hP.lift_fst _ _ _,
        fun g => hP.lift_snd _ _ _⟩
    have hσ1' : ∀ g {W : Scheme.{u}} (h : Z ⟶ W), σ g ≫ ι ≫ h = ι ≫ act g ≫ h := by
      intro g W h
      rw [← Category.assoc, hσ1, Category.assoc]
    obtain ⟨α, hα⟩ : ∃ α : G → (B →+* B), ∀ g, Spec.map (CommRingCat.ofHom (α g)) = σ g :=
      ⟨fun g => (Spec.preimage (σ g)).hom, fun g => by
        rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
    have hcomp : ∀ (f g : B →+* B), Spec.map (CommRingCat.ofHom (f.comp g)) =
        Spec.map (CommRingCat.ofHom f) ≫ Spec.map (CommRingCat.ofHom g) := fun f g => by
      rw [CommRingCat.ofHom_comp, Spec.map_comp]
    refine ⟨α, ?_, ?_, ?_, ?_⟩
    · intro g a
      have h1 : Spec.map (CommRingCat.ofHom ((α g).comp (algebraMap A B))) =
          Spec.map (CommRingCat.ofHom (algebraMap A B)) := by
        rw [CommRingCat.ofHom_comp, Spec.map_comp, hα, hσ2]
      have h2 := congrArg CommRingCat.Hom.hom (Spec.map_injective h1)
      rw [CommRingCat.hom_ofHom, CommRingCat.hom_ofHom] at h2
      exact RingHom.congr_fun h2 a
    · have h1 : σ 1 = 𝟙 _ := hP.hom_ext
        (by simp only [hσ1, hact1, Category.comp_id, Category.id_comp])
        (by simp only [hσ2, Category.id_comp])
      have h2 : Spec.map (CommRingCat.ofHom (α 1)) =
          Spec.map (CommRingCat.ofHom (RingHom.id B)) := by
        rw [hα, h1, CommRingCat.ofHom_id, Spec.map_id]
      have h3 := congrArg CommRingCat.Hom.hom (Spec.map_injective h2)
      rw [CommRingCat.hom_ofHom, CommRingCat.hom_ofHom] at h3
      exact h3
    · intro g g'
      have h1 : σ (g * g') = σ g ≫ σ g' := hP.hom_ext
        (by simp only [Category.assoc, hσ1, hσ1', hactm])
        (by simp only [Category.assoc, hσ2])
      have h2 : Spec.map (CommRingCat.ofHom (α (g * g'))) =
          Spec.map (CommRingCat.ofHom ((α g).comp (α g'))) := by
        rw [hcomp, hα, hα, hα, h1]
      have h3 := congrArg CommRingCat.Hom.hom (Spec.map_injective h2)
      rw [CommRingCat.hom_ofHom, CommRingCat.hom_ofHom] at h3
      exact h3
    · intro g
      rw [hα]
      exact hσ1 g

  have s4 : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] (Y Z : Scheme.{u})
      (πZ : Z ⟶ Y) (k : Spec (.of A) ⟶ Y) (ι : Spec (.of B) ⟶ Z),
      IsPullback ι (Spec.map (CommRingCat.ofHom (algebraMap A B))) πZ k → IsOpenImmersion ι →
      Surjective πZ → AlgebraicGeometry.IsIntegral Z → Nonempty (Spec (.of A)) → IsDomain B := by
    intro A B _ _ _ Y Z πZ k ι hP hι hs hZ hA
    obtain ⟨a⟩ := hA
    obtain ⟨z, hz⟩ := hs.surj (k a)
    obtain ⟨t, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := πZ) (g := k) z a hz
    haveI : Nonempty (Spec (.of B)) := ⟨hP.isoPullback.inv t⟩
    haveI : AlgebraicGeometry.IsIntegral (Spec (.of B)) := isIntegral_of_isOpenImmersion ι
    exact (affine_isIntegral_iff (.of B)).mp inferInstance

  have hUne : (↑Uo : Set ↥(wcP1Over K).left).Nonempty := by
    obtain ⟨z0⟩ := hZint.nonempty
    refine ⟨Uo.ι (πZ z0), ?_⟩
    rw [← Scheme.Opens.range_ι]
    exact ⟨_, rfl⟩
  have hjne : (Set.range ⇑j).Nonempty := by
    obtain ⟨x⟩ := hKne
    exact ⟨j x, x, rfl⟩
  obtain ⟨p, ⟨x, rfl⟩, hpU⟩ :=
    nonempty_preirreducible_inter (IsOpenImmersion.isOpen_range j) Uo.isOpen hjne hUne
  let x' : PrimeSpectrum (Polynomial K) := x
  have hopen : IsOpen (j ⁻¹' (↑Uo : Set ↥(wcP1Over K).left)) := Uo.isOpen.preimage j.continuous
  obtain ⟨v, ⟨h₁, rfl⟩, hxv, hvsub⟩ :=
    (PrimeSpectrum.isTopologicalBasis_basic_opens (R := Polynomial K)).exists_subset_of_mem_open
      (a := x') (u := j ⁻¹' (↑Uo : Set ↥(wcP1Over K).left)) hpU hopen
  have hh₁ : h₁ ≠ 0 := by
    intro h0
    have h2 : h₁ ∉ x'.asIdeal := (PrimeSpectrum.mem_basicOpen h₁ x').mp hxv
    rw [h0] at h2
    exact h2 (Ideal.zero_mem _)
  have hrange : Set.range ⇑(Spec.map (CommRingCat.ofHom
      (algebraMap (Polynomial K) (Localization.Away h₁))) ≫ j) ⊆
      (↑Uo : Set ↥(wcP1Over K).left) := by
    rintro _ ⟨w, rfl⟩
    rw [Scheme.Hom.comp_apply]
    have hw : (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (Localization.Away h₁))) w :
        PrimeSpectrum (Polynomial K)) ∈
        (PrimeSpectrum.basicOpen h₁ : Set (PrimeSpectrum (Polynomial K))) := by
      rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away h₁) h₁]
      exact ⟨w, by rw [Spec.map_apply]; rfl⟩
    exact hvsub hw
  obtain ⟨k, hk⟩ : ∃ k : Spec (.of (Localization.Away h₁)) ⟶ (wcP1Over K).left,
      k = Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (Localization.Away h₁))) ≫ j :=
    ⟨_, rfl⟩
  haveI : IsOpenImmersion k := by rw [hk]; infer_instance
  have hrange' : Set.range ⇑k ⊆ Set.range ⇑Uo.ι := by
    rw [Scheme.Opens.range_ι, hk]; exact hrange
  obtain ⟨k', hk'⟩ : ∃ k' : Spec (.of (Localization.Away h₁)) ⟶ Uo.toScheme, k' ≫ Uo.ι = k :=
    ⟨IsOpenImmersion.lift Uo.ι k hrange', IsOpenImmersion.lift_fac _ _ _⟩
  haveI : IsOpenImmersion (k' ≫ Uo.ι) := by rw [hk']; infer_instance
  haveI : IsOpenImmersion k' := IsOpenImmersion.of_comp k' Uo.ι

  haveI : IsDomain (Localization.Away h₁) := hlocdom h₁ hh₁
  obtain ⟨B, _, _, ι, hBfin, hBet, hιo, hP⟩ :=
    s2 (Localization.Away h₁) Uo.toScheme Z πZ k' hfin het inferInstance
  obtain ⟨α, hαfix, hα1, hαm, hαι⟩ := s3 _ B _ Z πZ k' ι G act hP hact1 hactm hactπ
  have hBdom : IsDomain B := s4 _ B _ Z πZ k' ι hP hιo hsurj hZint inferInstance
  refine ⟨h₁, B, _, _, ι, α, hh₁, hBdom, hBfin, hBet, hιo, ?_, hαfix, hα1, hαm, hαι⟩
  rw [← Category.assoc, hP.w, Category.assoc, hk', hk, ← Category.assoc, ← Spec.map_comp,
    ← CommRingCat.ofHom_comp]

theorem wc_fetg_galois_ring_presentation : ∀ (K : Type u) [Field K] [Finite K] (h₁ : Polynomial K) (B : Type u) [CommRing B] [IsDomain B] [Algebra (Localization.Away h₁) B] [Module.Finite (Localization.Away h₁) B] [Algebra.Etale (Localization.Away h₁) B] (G : Type) [Group G] [Finite G] (α : G → (B →+* B)), h₁ ≠ 0 → (∀ g (a : Localization.Away h₁), α g (algebraMap (Localization.Away h₁) B a) = algebraMap (Localization.Away h₁) B a) → α 1 = RingHom.id B → (∀ g g', α (g * g') = (α g).comp (α g')) → (∀ χ₁ χ₂ : B →+* AlgebraicClosure K, χ₁.comp (algebraMap (Localization.Away h₁) B) = χ₂.comp (algebraMap (Localization.Away h₁) B) → ∃! g, χ₂ = χ₁.comp (α g)) → ∃ (d : Polynomial K) (v : B) (e : ℕ) (f : Polynomial (Polynomial K)) (P : G → Polynomial (Polynomial K)), d ≠ 0 ∧ Function.Injective ((algebraMap (Localization.Away h₁) B).comp (algebraMap (Polynomial K) (Localization.Away h₁))) ∧ f.Monic ∧ f.natDegree = Nat.card G ∧ Irreducible (f.map (algebraMap (Polynomial K) (RatFunc K))) ∧ Polynomial.eval₂ ((algebraMap (Localization.Away h₁) B).comp (algebraMap (Polynomial K) (Localization.Away h₁))) v f = 0 ∧ (∀ b : B, ∃ (m : ℕ) (Q : Polynomial (Polynomial K)), ((algebraMap (Localization.Away h₁) B).comp (algebraMap (Polynomial K) (Localization.Away h₁))) (h₁ * d) ^ m * b = Polynomial.eval₂ ((algebraMap (Localization.Away h₁) B).comp (algebraMap (Polynomial K) (Localization.Away h₁))) v Q) ∧ ∀ g, ((algebraMap (Localization.Away h₁) B).comp (algebraMap (Polynomial K) (Localization.Away h₁))) (h₁ * d) ^ e * α g v = Polynomial.eval₂ ((algebraMap (Localization.Away h₁) B).comp (algebraMap (Polynomial K) (Localization.Away h₁))) v (P g) :=
by
  open Polynomial in
  · intro K _ _ h₁ B _ _ _ _ _ G _ _ α hh₁ hαfix _ _ htors
    classical


    have s2 : ∀ (h : Polynomial K), IsPrincipalIdealRing (Localization.Away h) := by
      intro h
      refine ⟨fun J => ?_⟩
      have hJ := IsLocalization.map_under (Submonoid.powers h) (Localization.Away h) J
      rw [← hJ, ← Submodule.IsPrincipal.span_singleton_generator (Ideal.under (Polynomial K) J),
        Ideal.map_span, Set.image_singleton]
      exact ⟨_, rfl⟩


    have s4 : ∀ (h : Polynomial K) (N : ℕ), h ≠ 0 → ∃ u₀ : AlgebraicClosure K,
        Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ h ≠ 0 ∧
        ∀ i j : ℕ, i < N → j < N → u₀ ^ i = u₀ ^ j → i = j := by
      intro h N hh
      set S := (Finset.range N ×ˢ Finset.range N).filter (fun p : ℕ × ℕ => p.1 < p.2) with hS
      set H : Polynomial K := h * ∏ p ∈ S, (X ^ p.2 - X ^ p.1) with hH
      have hfac : ∀ p ∈ S, (X ^ p.2 - X ^ p.1 : Polynomial K) ≠ 0 := by
        intro p hp hzero
        have hlt : p.1 < p.2 := (Finset.mem_filter.mp hp).2
        have := congrArg (fun q => Polynomial.coeff q p.2) hzero
        simp only [coeff_sub, coeff_X_pow, if_true, coeff_zero] at this
        rw [if_neg (Nat.ne_of_gt hlt)] at this
        simp at this
      have hH0 : H ≠ 0 := mul_ne_zero hh (Finset.prod_ne_zero_iff.mpr hfac)
      have hH' : H.map (algebraMap K (AlgebraicClosure K)) ≠ 0 := Polynomial.map_ne_zero hH0
      obtain ⟨u₀, hu₀⟩ :=
        Infinite.exists_notMem_finset (H.map (algebraMap K (AlgebraicClosure K))).roots.toFinset
      have hev : Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ H ≠ 0 := by
        intro h0
        apply hu₀
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hH', Polynomial.IsRoot.def,
          Polynomial.eval_map]
        exact h0
      rw [hH, eval₂_mul, eval₂_finsetProd] at hev
      have hev1 := left_ne_zero_of_mul hev
      have hev2 := Finset.prod_ne_zero_iff.mp (right_ne_zero_of_mul hev)
      refine ⟨u₀, hev1, ?_⟩
      have key : ∀ i j, i < N → j < N → i < j → u₀ ^ i ≠ u₀ ^ j := by
        intro i j hi hj hij heq
        have := hev2 (i, j) (by simp [hS, hi, hj, hij])
        simp only [eval₂_sub, eval₂_X_pow] at this
        exact this (by rw [heq, sub_self])
      intro i j hi hj heq
      rcases lt_trichotomy i j with hlt | heq' | hgt
      · exact absurd heq (key i j hi hj hlt)
      · exact heq'
      · exact absurd heq.symm (key j i hj hi hgt)


    have s5 : ∀ (A B Ω : Type u) [CommRing A] [CommRing B] [Algebra A B] [Field Ω] (n N : ℕ)
        (b : Module.Basis (Fin n) A B) (ev : A →+* Ω) (χ : Fin n → (B →+* Ω)) (t : A),
        (∀ k, (χ k).comp (algebraMap A B) = ev) → Function.Injective χ → n ^ 3 < N →
        (∀ i j : ℕ, i < N → j < N → ev t ^ i = ev t ^ j → i = j) →
        ∃ x : B, Function.Injective (fun k => χ k x) := by
      intro A B Ω _ _ _ _ n N b ev χ t hχ hinj hN hpow
      set E : Fin n → Fin n → Ω := fun k l => χ k (b l) with hE
      have semi : ∀ k (a : A) (y : B), χ k (a • y) = ev a * χ k y := by
        intro k a y
        rw [Algebra.smul_def, map_mul, ← RingHom.comp_apply, hχ k]
      have hexp : ∀ k (y : B), χ k y = ∑ l, ev (b.repr y l) * E k l := by
        intro k y
        conv_lhs => rw [← b.sum_repr y]
        rw [map_sum]
        refine Finset.sum_congr rfl fun l _ => ?_
        rw [semi]
      set q : Fin n → Polynomial Ω := fun k => ∑ l : Fin n, C (E k l) * X ^ (l : ℕ) with hq
      have hqcoeff : ∀ k (l : Fin n), (q k).coeff l = E k l := by
        intro k l
        simp only [hq, finsetSum_coeff, coeff_C_mul_X_pow]
        rw [Finset.sum_eq_single l]
        · simp
        · intro l' _ hl'
          rw [if_neg]
          intro h
          exact hl' (Fin.ext h).symm
        · intro h; exact absurd (Finset.mem_univ l) h
      have hqinj : ∀ k k', k ≠ k' → q k - q k' ≠ 0 := by
        intro k k' hkk' h0
        apply hkk'
        apply hinj
        apply RingHom.ext
        intro y
        rw [hexp k y, hexp k' y]
        refine Finset.sum_congr rfl fun l _ => ?_
        have := congrArg (fun p => Polynomial.coeff p (l : ℕ)) (sub_eq_zero.mp h0)
        simp only [hqcoeff] at this
        rw [this]
      have hqdeg : ∀ k, (q k).natDegree ≤ n := by
        intro k
        rw [natDegree_le_iff_degree_le]
        exact le_of_lt (degree_sum_fin_lt _)
      set P : Polynomial Ω := ∏ p ∈ (Finset.univ : Finset (Fin n)).offDiag, (q p.1 - q p.2) with hP
      have hP0 : P ≠ 0 := by
        rw [hP, Finset.prod_ne_zero_iff]
        intro p hp
        exact hqinj p.1 p.2 (Finset.mem_offDiag.mp hp).2.2
      have hPdeg : P.natDegree < N := by
        have h1 : P.natDegree ≤
            ∑ p ∈ (Finset.univ : Finset (Fin n)).offDiag, (q p.1 - q p.2).natDegree :=
          natDegree_prod_le _ _
        have h2 : ∑ p ∈ (Finset.univ : Finset (Fin n)).offDiag, (q p.1 - q p.2).natDegree ≤
            (Finset.univ : Finset (Fin n)).offDiag.card • n := by
          apply Finset.sum_le_card_nsmul
          intro p _
          exact (natDegree_sub_le _ _).trans (max_le (hqdeg _) (hqdeg _))
        have h3 : (Finset.univ : Finset (Fin n)).offDiag.card ≤ n * n := by
          rw [Finset.offDiag_card, Finset.card_univ, Fintype.card_fin]
          exact Nat.sub_le _ _
        have h4 : (Finset.univ : Finset (Fin n)).offDiag.card • n ≤ n * n * n := by
          rw [smul_eq_mul]
          exact Nat.mul_le_mul_right n h3
        have h5 : n * n * n = n ^ 3 := by ring
        omega
      set w := ev t with hw
      have hex : ∃ i, i < N ∧ P.eval (w ^ i) ≠ 0 := by
        by_contra hcon
        push_neg at hcon
        have hsub : (Finset.range N).image (fun i => w ^ i) ⊆ P.roots.toFinset := by
          intro z hz
          obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hz
          rw [Multiset.mem_toFinset, mem_roots hP0]
          exact hcon i (Finset.mem_range.mp hi)
        have hcard : ((Finset.range N).image (fun i => w ^ i)).card = N := by
          rw [Finset.card_image_of_injOn, Finset.card_range]
          intro i hi j hj hij
          exact hpow i j (Finset.mem_range.mp hi) (Finset.mem_range.mp hj) hij
        have := Finset.card_le_card hsub
        rw [hcard] at this
        have h6 := (Multiset.toFinset_card_le P.roots).trans (card_roots' P)
        omega
      obtain ⟨i, hi, hPi⟩ := hex
      refine ⟨∑ l : Fin n, algebraMap A B (t ^ (i * (l : ℕ))) * b l, ?_⟩
      have hval : ∀ k, χ k (∑ l : Fin n, algebraMap A B (t ^ (i * (l : ℕ))) * b l) =
          (q k).eval (w ^ i) := by
        intro k
        rw [map_sum, hq, Polynomial.eval_finsetSum]
        refine Finset.sum_congr rfl fun l _ => ?_
        rw [map_mul, ← RingHom.comp_apply, hχ k, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X, map_pow,
          ← pow_mul, mul_comm]
      intro k k' hkk'
      simp only at hkk'
      by_contra hne
      rw [hval, hval] at hkk'
      rw [hP, Polynomial.eval_prod, Finset.prod_ne_zero_iff] at hPi
      have := hPi (k, k') (Finset.mem_offDiag.mpr ⟨Finset.mem_univ _, Finset.mem_univ _, hne⟩)
      rw [Polynomial.eval_sub, hkk', sub_self] at this
      exact this rfl


    have s6 : ∀ (R A B : Type u) [CommRing R] [CommRing A] [Nontrivial A] [CommRing B] [Algebra R A]
        [Algebra A B] (h : R) [IsLocalization.Away h A] [Module.Free A B] [Module.Finite A B] (x : B),
        ∃ (k : ℕ) (f : Polynomial R), f.Monic ∧ f.natDegree = Module.finrank A B ∧
          Polynomial.eval₂ ((algebraMap A B).comp (algebraMap R A))
            (algebraMap A B (algebraMap R A h ^ k) * x) f = 0 := by
      intro R A B _ _ _ _ _ _ h _ _ _ x
      set F := (Algebra.lmul A B x).charpoly with hF
      have hFm : F.Monic := LinearMap.charpoly_monic _
      have hFdeg : F.natDegree = Module.finrank A B := LinearMap.charpoly_natDegree _
      have hFx : Polynomial.eval₂ (algebraMap A B) x F = 0 := by
        have h1 := LinearMap.aeval_self_charpoly (Algebra.lmul A B x)
        rw [← hF, Polynomial.aeval_algHom_apply] at h1
        have h2 : (Polynomial.aeval x F) * 1 = 0 := LinearMap.congr_fun h1 1
        rw [mul_one] at h2
        rw [← Polynomial.aeval_def]; exact h2
      obtain ⟨⟨c, hc⟩, hcint⟩ := IsLocalization.exist_integer_multiples_of_finset (Submonoid.powers h)
        (S := A) (Finset.image F.coeff (Finset.range (F.natDegree + 1)))
      obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hc
      set s := algebraMap R A h ^ k with hs
      have hcoef : ∀ i, ∃ r : R, algebraMap R A r = s * F.coeff i := by
        intro i
        by_cases hi : i ≤ F.natDegree
        · obtain ⟨r, hr⟩ := hcint (F.coeff i)
            (Finset.mem_image.mpr ⟨i, Finset.mem_range.mpr (by omega), rfl⟩)
          refine ⟨r, ?_⟩
          rw [hr]
          show (h ^ k : R) • F.coeff i = s * F.coeff i
          rw [Algebra.smul_def, map_pow]
        · refine ⟨0, ?_⟩
          rw [coeff_eq_zero_of_natDegree_lt (by omega), mul_zero, map_zero]
      have hlift : F.scaleRoots s ∈ Polynomial.lifts (algebraMap R A) := by
        rw [lifts_iff_coeff_lifts]
        intro i
        rw [coeff_scaleRoots]
        rcases lt_trichotomy i F.natDegree with hlt | heq | hgt
        · obtain ⟨r, hr⟩ := hcoef i
          obtain ⟨t, ht⟩ : ∃ t, F.natDegree - i = t + 1 := ⟨F.natDegree - i - 1, by omega⟩
          refine ⟨r * (h ^ k) ^ t, ?_⟩
          rw [map_mul, hr, map_pow, map_pow, ← hs, ht, pow_succ]
          ring
        · refine ⟨1, ?_⟩
          rw [heq, Nat.sub_self, pow_zero, mul_one, map_one]
          exact hFm.symm
        · refine ⟨0, ?_⟩
          rw [coeff_eq_zero_of_natDegree_lt hgt, zero_mul, map_zero]
      have hmon : (F.scaleRoots s).Monic := (monic_scaleRoots_iff s).mpr hFm
      obtain ⟨f, hfmap, hfdeg, hfm⟩ := lifts_and_natDegree_eq_and_monic hlift hmon
      refine ⟨k, f, hfm, by rw [hfdeg, natDegree_scaleRoots, hFdeg], ?_⟩
      rw [← eval₂_map, hfmap]
      exact scaleRoots_eval₂_eq_zero (algebraMap A B) hFx


    have s7 : ∀ (A B Ω : Type u) [CommRing A] [CommRing B] [Algebra A B] [Field Ω] (n : ℕ)
        (b : Module.Basis (Fin n) A B) (ev : A →+* Ω) (χ : Fin n → (B →+* Ω)) (v : B),
        (∀ k, (χ k).comp (algebraMap A B) = ev) → Function.Injective (fun k => χ k v) →
        ev (Matrix.det (Matrix.of fun j l : Fin n => b.repr (v ^ (j : ℕ)) l)) ≠ 0 := by
      intro A B Ω _ _ _ _ n b ev χ v hχ hinj
      set M := Matrix.of fun j l : Fin n => b.repr (v ^ (j : ℕ)) l with hM
      set E : Matrix (Fin n) (Fin n) Ω := Matrix.of fun k l => χ k (b l) with hE
      have semi : ∀ k (a : A) (y : B), χ k (a • y) = ev a * χ k y := by
        intro k a y
        rw [Algebra.smul_def, map_mul, ← RingHom.comp_apply, hχ k]
      have hV : Matrix.vandermonde (fun k => χ k v) = E * (M.map ev).transpose := by
        ext k j
        rw [Matrix.vandermonde_apply, Matrix.mul_apply]
        simp only [hE, hM, Matrix.of_apply, Matrix.transpose_apply, Matrix.map_apply]
        rw [← map_pow]
        conv_lhs => rw [← b.sum_repr (v ^ (j : ℕ))]
        rw [map_sum]
        refine Finset.sum_congr rfl fun l _ => ?_
        rw [semi, mul_comm]
      have hdet := congrArg Matrix.det hV
      rw [Matrix.det_mul, Matrix.det_transpose, ← RingHom.mapMatrix_apply, ← RingHom.map_det] at hdet
      intro h0
      rw [h0, mul_zero] at hdet
      exact (Matrix.det_vandermonde_ne_zero_iff.mpr hinj) hdet


    have s8 : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] (n : ℕ)
        (b : Module.Basis (Fin n) A B) (v y : B),
        ∃ c : Fin n → A, algebraMap A B (Matrix.det (Matrix.of fun j l : Fin n => b.repr (v ^ (j : ℕ)) l)) * y =
          ∑ j : Fin n, algebraMap A B (c j) * v ^ (j : ℕ) := by
      intro A B _ _ _ n b v y
      set M := Matrix.of fun j l : Fin n => b.repr (v ^ (j : ℕ)) l with hM
      have hadj := Matrix.adjugate_mul M
      refine ⟨fun j => ∑ l, b.repr y l * M.adjugate l j, ?_⟩
      have hv : ∀ j : Fin n, v ^ (j : ℕ) = ∑ l', M j l' • b l' := by
        intro j
        simp only [hM, Matrix.of_apply]
        exact (b.sum_repr (v ^ (j : ℕ))).symm
      have hy : y = ∑ l, b.repr y l • b l := (b.sum_repr y).symm
      simp only [← Algebra.smul_def]
      calc M.det • y = ∑ l, b.repr y l • (M.det • b l) := by
            conv_lhs => rw [hy]
            rw [Finset.smul_sum]
            refine Finset.sum_congr rfl fun l _ => ?_
            rw [smul_comm]
        _ = ∑ l, b.repr y l • ∑ l', (M.adjugate * M) l l' • b l' := by
            refine Finset.sum_congr rfl fun l _ => ?_
            congr 1
            rw [hadj]
            simp [Matrix.smul_apply, Matrix.one_apply]
        _ = ∑ l, ∑ j, ∑ l', (b.repr y l * M.adjugate l j * M j l') • b l' := by
            refine Finset.sum_congr rfl fun l _ => ?_
            simp only [Matrix.mul_apply, Finset.sum_smul, Finset.smul_sum, smul_smul]
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun l' _ => ?_
            rw [mul_assoc]
        _ = ∑ j, (∑ l, b.repr y l * M.adjugate l j) • v ^ (j : ℕ) := by
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [hv j, Finset.sum_smul]
            refine Finset.sum_congr rfl fun l _ => ?_
            rw [Finset.smul_sum]
            refine Finset.sum_congr rfl fun l' _ => ?_
            rw [smul_smul]


    have s9 : ∀ (R A B : Type u) [CommRing R] [CommRing A] [CommRing B] [Algebra R A] [Algebra A B]
        (h : R) [IsLocalization.Away h A] (n : ℕ) (D : A) (d : R) (jexp : ℕ) (v : B),
        D * algebraMap R A h ^ jexp = algebraMap R A d →
        (∀ y : B, ∃ c : Fin n → A, algebraMap A B D * y = ∑ j : Fin n, algebraMap A B (c j) * v ^ (j : ℕ)) →
        ∀ y : B, ∃ (m : ℕ) (Q : Polynomial R), ((algebraMap A B).comp (algebraMap R A)) (h * d) ^ m * y =
          Polynomial.eval₂ ((algebraMap A B).comp (algebraMap R A)) v Q := by
      intro R A B _ _ _ _ _ h _ n D d jexp v hD hc y
      obtain ⟨c, hcy⟩ := hc y
      choose nj aj hj using fun j => IsLocalization.Away.surj (S := A) h (c j)
      set L := ∑ j, nj j with hL
      set β := (algebraMap A B).comp (algebraMap R A) with hβ
      set ι := algebraMap A B
      set φ := algebraMap R A
      have hr : ∀ j, φ h ^ L * c j = φ (h ^ (L - nj j) * aj j) := by
        intro j
        have hle : nj j ≤ L := Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ j)
        rw [map_mul, map_pow, ← hj j, ← mul_assoc, mul_comm (φ h ^ (L - nj j)), mul_assoc, ← pow_add,
          Nat.sub_add_cancel hle, mul_comm]
      set Q₀ : Polynomial R := ∑ j : Fin n, C (h ^ (L - nj j) * aj j) * X ^ (j : ℕ) with hQ₀
      have hQ₀ev : ι (φ h) ^ L * (ι D * y) = Polynomial.eval₂ β v Q₀ := by
        rw [hcy, hQ₀, eval₂_finsetSum, Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [eval₂_mul, eval₂_C, eval₂_X_pow, ← mul_assoc, ← map_pow, ← map_mul, hr j]
        rfl
      have hβd : β d = ι D * ι (φ h) ^ jexp := by
        show ι (φ d) = _
        rw [← hD, map_mul, map_pow]
      refine ⟨L + 1, C (h ^ (jexp + 1) * d ^ L) * Q₀, ?_⟩
      rw [eval₂_mul, eval₂_C, ← hQ₀ev]
      have hβh : β h = ι (φ h) := rfl
      simp only [map_mul, map_pow, hβh, hβd]
      ring


    have s10 : ∀ (β : Polynomial K →+* B) (u₀ : AlgebraicClosure K) (n : ℕ)
        (χ : Fin n → (B →+* AlgebraicClosure K)) (f : Polynomial (Polynomial K)) (v : B),
        f.Monic → f.natDegree = n → 0 < n → Polynomial.eval₂ β v f = 0 →
        (∀ k, (χ k).comp β = Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) →
        Function.Injective (fun k => χ k v) → Irreducible (f.map (algebraMap (Polynomial K) (RatFunc K))) := by
      intro β u₀ n χ f v hm hdeg hn hfv hχ hinj
      rw [← hm.irreducible_iff_irreducible_map_fraction_map]
      set ψ := Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀ with hψ
      have key : ∀ g : Polynomial (Polynomial K), IsUnit g.leadingCoeff → Polynomial.eval₂ β v g = 0 →
          n ≤ g.natDegree := by
        intro g hg hgv
        have hψlc : ψ g.leadingCoeff ≠ 0 := (hg.map ψ).ne_zero
        have hdeg' := natDegree_map_of_leadingCoeff_ne_zero ψ hψlc
        have hg0 : g.map ψ ≠ 0 := by
          intro h0
          have := leadingCoeff_map_of_leadingCoeff_ne_zero ψ hψlc
          rw [h0, leadingCoeff_zero] at this
          exact hψlc this.symm
        have hroots : ∀ k, (g.map ψ).IsRoot (χ k v) := by
          intro k
          rw [IsRoot.def, Polynomial.eval_map, ← hχ k, ← hom_eval₂, hgv, map_zero]
        have hsub : Finset.univ.image (fun k => χ k v) ⊆ (g.map ψ).roots.toFinset := by
          intro x hx
          obtain ⟨k, -, rfl⟩ := Finset.mem_image.mp hx
          rw [Multiset.mem_toFinset, mem_roots hg0]
          exact hroots k
        have h1 := Finset.card_le_card hsub
        rw [Finset.card_image_of_injective _ hinj, Finset.card_univ, Fintype.card_fin] at h1
        calc n ≤ (g.map ψ).roots.toFinset.card := h1
          _ ≤ (g.map ψ).roots.card := Multiset.toFinset_card_le _
          _ ≤ (g.map ψ).natDegree := card_roots' _
          _ = g.natDegree := hdeg'
      refine ⟨?_, ?_⟩
      · intro hu
        have := (hm.isUnit_iff).mp hu
        rw [this, natDegree_one] at hdeg
        omega
      · intro g₁ g₂ hfg
        have hlc : g₁.leadingCoeff * g₂.leadingCoeff = 1 := by
          rw [← leadingCoeff_mul, ← hfg]; exact hm
        have hu1 : IsUnit g₁.leadingCoeff :=
          ⟨⟨g₁.leadingCoeff, g₂.leadingCoeff, hlc, by rw [mul_comm]; exact hlc⟩, rfl⟩
        have hu2 : IsUnit g₂.leadingCoeff :=
          ⟨⟨g₂.leadingCoeff, g₁.leadingCoeff, by rw [mul_comm]; exact hlc, hlc⟩, rfl⟩
        have hg10 : g₁ ≠ 0 := fun h => by rw [h, leadingCoeff_zero] at hu1; exact not_isUnit_zero hu1
        have hg20 : g₂ ≠ 0 := fun h => by rw [h, leadingCoeff_zero] at hu2; exact not_isUnit_zero hu2
        have hsum : g₁.natDegree + g₂.natDegree = n := by
          rw [← natDegree_mul hg10 hg20, ← hfg, hdeg]
        have hev : Polynomial.eval₂ β v g₁ * Polynomial.eval₂ β v g₂ = 0 := by
          rw [← eval₂_mul, ← hfg, hfv]
        have unit_of_deg0 : ∀ g : Polynomial (Polynomial K), IsUnit g.leadingCoeff →
            g.natDegree = 0 → IsUnit g := by
          intro g hg hg0
          rw [eq_C_of_natDegree_eq_zero hg0]
          apply isUnit_C.mpr
          have : g.leadingCoeff = g.coeff 0 := by rw [leadingCoeff, hg0]
          rw [← this]; exact hg
        rcases mul_eq_zero.mp hev with h | h
        · right
          have := key g₁ hu1 h
          exact unit_of_deg0 g₂ hu2 (by omega)
        · left
          have := key g₂ hu2 h
          exact unit_of_deg0 g₁ hu1 (by omega)


    have hAdom : IsDomain (Localization.Away h₁) :=
      IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hh₁)
    have hφinj : Function.Injective (algebraMap (Polynomial K) (Localization.Away h₁)) :=
      IsLocalization.injective (M := Submonoid.powers h₁) (Localization.Away h₁)
        (powers_le_nonZeroDivisors_of_noZeroDivisors hh₁)
    have hflat := Algebra.Smooth.flat (Localization.Away h₁) B
    have htf : Module.IsTorsionFree (Localization.Away h₁) B := Module.Flat.isTorsionFree
    have hιinj : Function.Injective (algebraMap (Localization.Away h₁) B) :=
      (Module.isTorsionFree_iff_algebraMap_injective).mp htf
    have hβinj : Function.Injective ((algebraMap (Localization.Away h₁) B).comp
        (algebraMap (Polynomial K) (Localization.Away h₁))) := hιinj.comp hφinj
    haveI : IsPrincipalIdealRing (Localization.Away h₁) := s2 h₁
    haveI : Module.Free (Localization.Away h₁) B := Module.free_of_finite_type_torsion_free'


    obtain ⟨u₀, hu₀, hpow⟩ := s4 h₁ (Nat.card G ^ 3 + 1) hh₁
    have hunit : IsUnit (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀ h₁) :=
      IsUnit.mk0 _ hu₀
    set ev : Localization.Away h₁ →+* AlgebraicClosure K := IsLocalization.Away.lift h₁ hunit with hev
    have hevφ : ev.comp (algebraMap (Polynomial K) (Localization.Away h₁)) =
        Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀ :=
      IsLocalization.Away.lift_comp h₁ hunit
    have hevφapp : ∀ r : Polynomial K, ev (algebraMap (Polynomial K) (Localization.Away h₁) r) =
        Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ r := fun r =>
      RingHom.congr_fun hevφ r


    have s3 : Module.finrank (Localization.Away h₁) B = Nat.card G ∧
        ∃ χ₀ : B →+* AlgebraicClosure K, χ₀.comp (algebraMap (Localization.Away h₁) B) = ev := by
      letI : Algebra (Localization.Away h₁) (AlgebraicClosure K) := ev.toAlgebra
      have halg : algebraMap (Localization.Away h₁) (AlgebraicClosure K) = ev :=
        RingHom.algebraMap_toAlgebra ev
      obtain ⟨hfin, hcard⟩ := wc_fet_card_hom_rankAtStalk wc_fet_field_etale_card_hom
        (Localization.Away h₁) B (AlgebraicClosure K)
      rw [Module.rankAtStalk_eq_finrank_of_free] at hcard
      have hcard' : Nat.card (B →ₐ[Localization.Away h₁] AlgebraicClosure K) =
          Module.finrank (Localization.Away h₁) B := by
        rw [hcard]; rfl
      have hpos : 0 < Module.finrank (Localization.Away h₁) B := Module.finrank_pos
      obtain ⟨⟨ψ₀⟩, -⟩ := Nat.card_pos_iff.mp (hcard' ▸ hpos)
      set χ₀ : B →+* AlgebraicClosure K := (ψ₀ : B →+* AlgebraicClosure K) with hχ₀def
      have hχ₀ : χ₀.comp (algebraMap (Localization.Away h₁) B) = ev := by
        rw [hχ₀def, AlgHom.comp_algebraMap, halg]
      have hχ₀app : ∀ a, χ₀ (algebraMap (Localization.Away h₁) B a) = ev a := fun a =>
        RingHom.congr_fun hχ₀ a
      refine ⟨?_, χ₀, hχ₀⟩
      let Φ : G → (B →ₐ[Localization.Away h₁] AlgebraicClosure K) := fun g =>
        { χ₀.comp (α g) with
          commutes' := fun a => by
            show χ₀ (α g (algebraMap (Localization.Away h₁) B a)) = _
            rw [hαfix, hχ₀app, halg] }
      have hΦ : ∀ g x, Φ g x = χ₀ (α g x) := fun g x => rfl
      have hbij : Function.Bijective Φ := by
        constructor
        · intro g g' hgg
          have heq : χ₀.comp (α g) = χ₀.comp (α g') := RingHom.ext fun x => by
            rw [RingHom.comp_apply, RingHom.comp_apply, ← hΦ, ← hΦ, hgg]
          have h1 : χ₀.comp (algebraMap (Localization.Away h₁) B) =
              (χ₀.comp (α g)).comp (algebraMap (Localization.Away h₁) B) :=
            RingHom.ext fun a => by simp only [RingHom.comp_apply, hαfix]
          obtain ⟨g₀, -, hu⟩ := htors χ₀ (χ₀.comp (α g)) h1
          exact (hu g rfl).trans (hu g' heq).symm
        · intro ψ
          have h1 : χ₀.comp (algebraMap (Localization.Away h₁) B) =
              (ψ : B →+* AlgebraicClosure K).comp (algebraMap (Localization.Away h₁) B) := by
            rw [hχ₀, AlgHom.comp_algebraMap, halg]
          obtain ⟨g, hg, -⟩ := htors χ₀ ψ h1
          refine ⟨g, AlgHom.ext fun x => ?_⟩
          rw [hΦ]
          exact (RingHom.congr_fun hg x).symm
      rw [← hcard', Nat.card_eq_of_bijective Φ hbij]
    obtain ⟨hrank, χ₀, hχ₀⟩ := s3
    have hχ₀app : ∀ a, χ₀ (algebraMap (Localization.Away h₁) B a) = ev a := fun a =>
      RingHom.congr_fun hχ₀ a


    let eG := Finite.equivFin G
    let χ : Fin (Nat.card G) → (B →+* AlgebraicClosure K) := fun k => χ₀.comp (α (eG.symm k))
    have hχι : ∀ k, (χ k).comp (algebraMap (Localization.Away h₁) B) = ev := fun k =>
      RingHom.ext fun a => by
        show χ₀ (α (eG.symm k) (algebraMap (Localization.Away h₁) B a)) = ev a
        rw [hαfix, hχ₀app]
    have hχιapp : ∀ k a, χ k (algebraMap (Localization.Away h₁) B a) = ev a := fun k a =>
      RingHom.congr_fun (hχι k) a
    have hχinj : Function.Injective χ := by
      intro k k' hkk
      have h1 : χ₀.comp (algebraMap (Localization.Away h₁) B) =
          (χ k).comp (algebraMap (Localization.Away h₁) B) := by rw [hχ₀, hχι]
      obtain ⟨g₀, -, hu⟩ := htors χ₀ (χ k) h1
      have e1 := hu (eG.symm k) rfl
      have e2 := hu (eG.symm k') hkk
      exact eG.symm.injective (e1.trans e2.symm)
    let b := Module.finBasisOfFinrankEq (Localization.Away h₁) B hrank


    have hevX : ev (algebraMap (Polynomial K) (Localization.Away h₁) Polynomial.X) = u₀ := by
      rw [hevφapp, eval₂_X]
    obtain ⟨x, hxinj⟩ := s5 (Localization.Away h₁) B (AlgebraicClosure K) (Nat.card G)
      (Nat.card G ^ 3 + 1) b ev χ (algebraMap (Polynomial K) (Localization.Away h₁) Polynomial.X)
      hχι hχinj (by omega) (by rw [hevX]; exact hpow)


    obtain ⟨k₀, f, hfm, hfdeg, hfv⟩ := s6 (Polynomial K) (Localization.Away h₁) B h₁ x
    set v := algebraMap (Localization.Away h₁) B (algebraMap (Polynomial K) (Localization.Away h₁) h₁ ^ k₀) * x
      with hvdef
    have hscal : ev (algebraMap (Polynomial K) (Localization.Away h₁) h₁ ^ k₀) ≠ 0 := by
      rw [map_pow, hevφapp]
      exact pow_ne_zero _ hu₀
    have hvinj : Function.Injective (fun k => χ k v) := by
      intro k k' hkk
      simp only [hvdef, map_mul, hχιapp] at hkk
      exact hxinj (mul_left_cancel₀ hscal hkk)
    have hχβ : ∀ k, (χ k).comp ((algebraMap (Localization.Away h₁) B).comp
        (algebraMap (Polynomial K) (Localization.Away h₁))) =
        Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀ := by
      intro k
      rw [← RingHom.comp_assoc, hχι, hevφ]
    have hnpos : 0 < Nat.card G := Nat.card_pos
    have hirr := s10 ((algebraMap (Localization.Away h₁) B).comp
        (algebraMap (Polynomial K) (Localization.Away h₁))) u₀ (Nat.card G) χ f v hfm
        (hfdeg.trans hrank) hnpos hfv hχβ hvinj


    set D := Matrix.det (Matrix.of fun j l : Fin (Nat.card G) => b.repr (v ^ (j : ℕ)) l) with hDdef
    have hevD : ev D ≠ 0 := s7 (Localization.Away h₁) B (AlgebraicClosure K) (Nat.card G) b ev χ v hχι hvinj
    obtain ⟨jexp, d, hd⟩ := IsLocalization.Away.surj (S := Localization.Away h₁) h₁ D
    have hd0 : d ≠ 0 := by
      intro hd0
      have := congrArg ev hd
      rw [hd0, map_zero, map_zero, map_mul, map_pow, hevφapp] at this
      exact mul_ne_zero hevD (pow_ne_zero _ hu₀) this
    have hrep := s9 (Polynomial K) (Localization.Away h₁) B h₁ (Nat.card G) D d jexp v hd
      (fun y => s8 (Localization.Away h₁) B (Nat.card G) b v y)


    choose m Q hQ using fun g => hrep (α g v)
    haveI : Fintype G := Fintype.ofFinite G
    refine ⟨d, v, ∑ g, m g, f, fun g => C ((h₁ * d) ^ (∑ g', m g' - m g)) * Q g, hd0, hβinj, hfm,
      hfdeg.trans hrank, hirr, hfv, hrep, ?_⟩
    intro g
    have hle : m g ≤ ∑ g', m g' := Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ g)
    rw [eval₂_mul, eval₂_C, ← hQ g, ← mul_assoc, map_pow, ← pow_add, Nat.sub_add_cancel hle]

theorem wc_fetg_monogenic_points : ∀ (K : Type u) [Field K] (B : Type u) [CommRing B] [IsDomain B] (β : Polynomial K →+* B) (H : Polynomial K) (v : B) (f : Polynomial (Polynomial K)), Function.Injective β → f.Monic → Irreducible (f.map (algebraMap (Polynomial K) (RatFunc K))) → Polynomial.eval₂ β v f = 0 → (∀ b : B, ∃ (m : ℕ) (Q : Polynomial (Polynomial K)), β H ^ m * b = Polynomial.eval₂ β v Q) → (∀ u₀ v₀ : AlgebraicClosure K, Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ H ≠ 0 → Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) v₀ f = 0 → ∃ χ : B →+* AlgebraicClosure K, χ.comp β = Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀ ∧ χ v = v₀) ∧ ∀ χ χ' : B →+* AlgebraicClosure K, χ.comp β = χ'.comp β → χ (β H) ≠ 0 → χ v = χ' v → χ = χ' :=
by
  classical
  intro K _ B _ _ β H v f hβ hfm hirr hfv hgen

  have hker : ∀ Q : Polynomial (Polynomial K), Polynomial.eval₂ β v Q = 0 → f ∣ Q := by
    intro Q hQ
    set ι := algebraMap (Polynomial K) (RatFunc K) with hι
    have hιinj : Function.Injective ι := IsFractionRing.injective (Polynomial K) (RatFunc K)
    rw [← Polynomial.modByMonic_eq_zero_iff_dvd hfm]
    by_contra hR
    have hRv : Polynomial.eval₂ β v (Q.modByMonic f) = 0 := by
      rw [Polynomial.eval₂_modByMonic_eq_self_of_root hfv]; exact hQ
    have hdeg : (Q.modByMonic f).degree < f.degree := Polynomial.degree_modByMonic_lt Q hfm
    have hR' : (Q.modByMonic f).map ι ≠ 0 := (Polynomial.map_ne_zero_iff hιinj).mpr hR
    have hndvd : ¬ f.map ι ∣ (Q.modByMonic f).map ι := by
      apply Polynomial.Monic.not_dvd_of_degree_lt (hfm.map ι) hR'
      rw [Polynomial.degree_map_eq_of_injective hιinj, Polynomial.degree_map_eq_of_injective hιinj]
      exact hdeg
    have hcop : IsCoprime (f.map ι) ((Q.modByMonic f).map ι) :=
      (Irreducible.coprime_iff_not_dvd hirr).mpr hndvd
    obtain ⟨a, b, hab⟩ := hcop
    obtain ⟨c₁, hc₁m, hc₁⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors (Polynomial K)) a
    obtain ⟨c₂, hc₂m, hc₂⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors (Polynomial K)) b
    have hma : (IsLocalization.integerNormalization (nonZeroDivisors (Polynomial K)) a).map ι =
        Polynomial.C (ι (c₁ : Polynomial K)) * a := by
      rw [hι, hc₁]
      ext i
      rw [Polynomial.coeff_smul, Polynomial.coeff_C_mul, Algebra.smul_def]
    have hmb : (IsLocalization.integerNormalization (nonZeroDivisors (Polynomial K)) b).map ι =
        Polynomial.C (ι (c₂ : Polynomial K)) * b := by
      rw [hι, hc₂]
      ext i
      rw [Polynomial.coeff_smul, Polynomial.coeff_C_mul, Algebra.smul_def]
    have hid : Polynomial.C (c₂ : Polynomial K) *
          IsLocalization.integerNormalization (nonZeroDivisors (Polynomial K)) a * f +
        Polynomial.C (c₁ : Polynomial K) *
          IsLocalization.integerNormalization (nonZeroDivisors (Polynomial K)) b * Q.modByMonic f =
        Polynomial.C ((c₁ : Polynomial K) * c₂) := by
      apply Polynomial.map_injective ι hιinj
      rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_mul,
        Polynomial.map_mul, Polynomial.map_C, Polynomial.map_C, Polynomial.map_C, hma, hmb,
        map_mul, Polynomial.C_mul]
      linear_combination (Polynomial.C (ι (c₁ : Polynomial K)) * Polynomial.C (ι (c₂ : Polynomial K))) * hab
    have hev := congrArg (Polynomial.eval₂ β v) hid
    simp only [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C, hfv, hRv,
      mul_zero, add_zero] at hev
    have h0 : c₁ * c₂ = 0 := hβ (by rw [← hev, map_zero])
    exact mul_ne_zero (nonZeroDivisors.ne_zero hc₁m) (nonZeroDivisors.ne_zero hc₂m) h0
  refine ⟨?_, ?_⟩
  ·
    intro u₀ v₀ hH hf
    set ev := Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀ with hev
    set Ev := Polynomial.eval₂RingHom ev v₀ with hEv
    have hEvf : Ev f = 0 := hf
    have hh₀ : ev H ≠ 0 := hH
    have hEvC : ∀ p, Ev (Polynomial.C p) = ev p := fun p => Polynomial.eval₂_C _ _
    have hEvCH : ∀ k : ℕ, Ev (Polynomial.C (H ^ k)) = ev H ^ k := fun k => by
      rw [hEvC, map_pow]
    have hW : ∀ (b : B) (m : ℕ) (Q : Polynomial (Polynomial K)) (m' : ℕ)
        (Q' : Polynomial (Polynomial K)), β H ^ m * b = Polynomial.eval₂ β v Q →
        β H ^ m' * b = Polynomial.eval₂ β v Q' → ev H ^ m' * Ev Q = ev H ^ m * Ev Q' := by
      intro b m Q m' Q' h1 h2
      have hS : Polynomial.eval₂ β v
          (Polynomial.C (H ^ m') * Q - Polynomial.C (H ^ m) * Q') = 0 := by
        rw [Polynomial.eval₂_sub, Polynomial.eval₂_mul, Polynomial.eval₂_mul, Polynomial.eval₂_C,
          Polynomial.eval₂_C, ← h1, ← h2, map_pow, map_pow]
        ring
      obtain ⟨D, hD⟩ := hker _ hS
      have h3 := congrArg Ev hD
      rw [map_sub, map_mul, map_mul, map_mul, hEvf, zero_mul, hEvCH, hEvCH] at h3
      exact sub_eq_zero.mp h3
    choose mm QQ hrep using hgen
    let χ₀ : B → AlgebraicClosure K := fun b => Ev (QQ b) / ev H ^ mm b
    have hW' : ∀ (b : B) (m : ℕ) (Q : Polynomial (Polynomial K)),
        β H ^ m * b = Polynomial.eval₂ β v Q → χ₀ b = Ev Q / ev H ^ m := by
      intro b m Q h
      have h4 := hW b (mm b) (QQ b) m Q (hrep b) h
      show Ev (QQ b) / ev H ^ mm b = Ev Q / ev H ^ m
      rw [div_eq_div_iff (pow_ne_zero _ hh₀) (pow_ne_zero _ hh₀)]
      linear_combination h4
    refine ⟨{ toFun := χ₀, map_one' := ?_, map_mul' := ?_, map_zero' := ?_, map_add' := ?_ },
      ?_, ?_⟩
    · show χ₀ 1 = 1
      rw [hW' 1 0 1 (by simp)]
      simp
    · intro x y
      show χ₀ (x * y) = Ev (QQ x) / ev H ^ mm x * (Ev (QQ y) / ev H ^ mm y)
      rw [hW' (x * y) (mm x + mm y) (QQ x * QQ y) (by
        rw [Polynomial.eval₂_mul, ← hrep x, ← hrep y]; ring)]
      rw [map_mul, pow_add, div_mul_div_comm]
    · show χ₀ 0 = 0
      rw [hW' 0 0 0 (by simp)]
      simp
    · intro x y
      show χ₀ (x + y) = Ev (QQ x) / ev H ^ mm x + Ev (QQ y) / ev H ^ mm y
      rw [hW' (x + y) (mm x + mm y)
        (Polynomial.C (H ^ mm y) * QQ x + Polynomial.C (H ^ mm x) * QQ y) (by
          rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_mul, Polynomial.eval₂_C,
            Polynomial.eval₂_C, ← hrep x, ← hrep y, map_pow, map_pow]
          ring)]
      rw [map_add, map_mul, map_mul, hEvCH, hEvCH]
      field_simp
      ring
    · apply RingHom.ext
      intro p
      show χ₀ (β p) = ev p
      rw [hW' (β p) 0 (Polynomial.C p) (by rw [Polynomial.eval₂_C, pow_zero, one_mul]), hEvC,
        pow_zero, div_one]
    · show χ₀ v = v₀
      rw [hW' v 0 Polynomial.X (by rw [Polynomial.eval₂_X, pow_zero, one_mul]), pow_zero, div_one]
      exact Polynomial.eval₂_X _ _
  ·
    intro χ χ' hcomp hH hv
    ext b
    obtain ⟨m, Q, hQ⟩ := hgen b
    have e1 := congrArg χ hQ
    have e2 := congrArg χ' hQ
    rw [map_mul, map_pow, Polynomial.hom_eval₂] at e1 e2
    rw [hcomp, hv] at e1
    have hH' : χ' (β H) = χ (β H) := (RingHom.congr_fun hcomp H).symm
    rw [← e1, hH'] at e2
    exact (mul_left_cancel₀ (pow_ne_zero m hH) e2).symm

theorem wc_fetg_chart_presentation : ∀ (K : Type u) [Field K] [Finite K] (Uo : (wcP1Over K).left.Opens) (Z : Scheme.{u}) (πZ : Z ⟶ Uo.toScheme) (G : Type) [Group G] [Finite G] (act : G → (Z ⟶ Z)), IsFinite πZ → Etale πZ → ConnectedSpace Z → act 1 = 𝟙 Z → (∀ g g', act (g * g') = act g ≫ act g') → (∀ g, act g ≫ πZ = πZ) → (∀ (T : Scheme.{u}), ConnectedSpace T → ∀ (a b : T ⟶ Z), a ≫ πZ = b ≫ πZ → ∃! g, b = a ≫ act g) → ∃ (h : Polynomial K) (e : ℕ) (f : Polynomial (Polynomial K)) (P : G → Polynomial (Polynomial K)) (Ξ : AlgebraicClosure K → AlgebraicClosure K → (Spec (.of (AlgebraicClosure K)) ⟶ Z)), h ≠ 0 ∧ f.Monic ∧ f.natDegree = Nat.card G ∧ Irreducible (f.map (algebraMap (Polynomial K) (RatFunc K))) ∧ (∀ u₀ v₀ : AlgebraicClosure K, Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ h ≠ 0 → Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) v₀ f = 0 → (∀ g, Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) (Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) v₀ (P g) / Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ h ^ e) f = 0) ∧ Function.Injective (fun g => Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) v₀ (P g) / Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ h ^ e) ∧ (∀ g g', Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) v₀ (P (g * g')) / Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ h ^ e = Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) (Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) v₀ (P g) / Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ h ^ e) (P g') / Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ h ^ e) ∧ Ξ u₀ v₀ ≫ πZ ≫ Uo.ι ≫ (wcP1Over K).hom = Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) ∧ ∀ (n : ℕ) (φ : AlgebraicClosure K →+* AlgebraicClosure K), (∀ c, φ c = c ^ (Nat.card K ^ n)) → (Spec.map (CommRingCat.ofHom φ) ≫ (Ξ u₀ v₀ ≫ πZ ≫ Uo.ι) = Ξ u₀ v₀ ≫ πZ ≫ Uo.ι ↔ u₀ ^ (Nat.card K ^ n) = u₀) ∧ ∀ g, u₀ ^ (Nat.card K ^ n) = u₀ → v₀ ^ (Nat.card K ^ n) = Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) v₀ (P g) / Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ h ^ e → Spec.map (CommRingCat.ofHom φ) ≫ Ξ u₀ v₀ = Ξ u₀ v₀ ≫ act g) :=
by
  intro K _ _ Uo Z πZ G _ _ act hfin het hZc hact1 hactm hactπ htors
  classical

  have hstar : ∀ {R S T : Type u} [CommRing R] [CommRing S] [CommRing T] (f : R →+* S)
      (g : S →+* T), Spec.map (CommRingCat.ofHom g) ≫ Spec.map (CommRingCat.ofHom f) =
        Spec.map (CommRingCat.ofHom (g.comp f)) := by
    intro R S T _ _ _ f g
    rw [← Spec.map_comp]
    rfl
  have hspec : ∀ {R S : Type u} [CommRing R] [CommRing S] (f g : R →+* S),
      Spec.map (CommRingCat.ofHom f) = Spec.map (CommRingCat.ofHom g) ↔ f = g := by
    intro R S _ _ f g
    constructor
    · intro h
      have h' := Spec.map_injective h
      exact congrArg CommRingCat.Hom.hom h'
    · intro h
      rw [h]

  obtain ⟨j, hjo, hjhom⟩ := wc_fetg_p1_affine_line K
  obtain ⟨hZint, hsurj⟩ := wc_fetg_cover_integral_surj K Uo Z πZ hfin het hZc
  obtain ⟨h₁, B, _, _, ι, α, hh₁, hBdom, hBfin, hBet, hιo, hιeq, hαfix, hα1, hαm, hαι⟩ :=
    wc_fetg_cover_affine_piece K Uo Z πZ G act j hfin het hZint hsurj hact1 hactm hactπ hjo
  have hαβ : ∀ g, (α g).comp ((algebraMap (Localization.Away h₁) B).comp
      (algebraMap (Polynomial K) (Localization.Away h₁))) =
      (algebraMap (Localization.Away h₁) B).comp
        (algebraMap (Polynomial K) (Localization.Away h₁)) :=
    fun g => RingHom.ext fun p => hαfix g _

  have htw : ∀ (χ₁ χ₂ : B →+* AlgebraicClosure K) (g : G),
      Spec.map (CommRingCat.ofHom χ₂) ≫ ι = (Spec.map (CommRingCat.ofHom χ₁) ≫ ι) ≫ act g ↔
        χ₂ = χ₁.comp (α g) := by
    intro χ₁ χ₂ g
    rw [Category.assoc, ← hαι g, ← Category.assoc, hstar, cancel_mono ι, hspec]
  have hgen : ∀ χ' : B →+* AlgebraicClosure K,
      Spec.map (CommRingCat.ofHom χ') ≫ ι ≫ πZ ≫ Uo.ι =
        Spec.map (CommRingCat.ofHom (χ'.comp ((algebraMap (Localization.Away h₁) B).comp
          (algebraMap (Polynomial K) (Localization.Away h₁))))) ≫ j := by
    intro χ'
    rw [hιeq, ← Category.assoc, hstar]

  have htorsR : ∀ χ₁ χ₂ : B →+* AlgebraicClosure K,
      χ₁.comp (algebraMap (Localization.Away h₁) B) =
        χ₂.comp (algebraMap (Localization.Away h₁) B) → ∃! g, χ₂ = χ₁.comp (α g) := by
    intro χ₁ χ₂ h12
    have e1 : χ₁.comp ((algebraMap (Localization.Away h₁) B).comp
        (algebraMap (Polynomial K) (Localization.Away h₁))) =
        χ₂.comp ((algebraMap (Localization.Away h₁) B).comp
        (algebraMap (Polynomial K) (Localization.Away h₁))) := by
      rw [← RingHom.comp_assoc, h12, RingHom.comp_assoc]
    have hab : (Spec.map (CommRingCat.ofHom χ₁) ≫ ι) ≫ πZ =
        (Spec.map (CommRingCat.ofHom χ₂) ≫ ι) ≫ πZ := by
      rw [← cancel_mono Uo.ι]
      simp only [Category.assoc]
      rw [hgen, hgen, e1]
    obtain ⟨g, hg, hgu⟩ := htors (Spec (.of (AlgebraicClosure K))) inferInstance _ _ hab
    exact ⟨g, (htw χ₁ χ₂ g).mp hg, fun g' hg' => hgu g' ((htw χ₁ χ₂ g').mpr hg')⟩

  obtain ⟨d, v, e, f, P, hd0, hβinj, hfm, hfdeg, hirr, hfv, hrep, hP⟩ :=
    wc_fetg_galois_ring_presentation K h₁ B G α hh₁ hαfix hα1 hαm htorsR
  set β : Polynomial K →+* B := (algebraMap (Localization.Away h₁) B).comp
    (algebraMap (Polynomial K) (Localization.Away h₁)) with hβdef

  obtain ⟨hex, huniq⟩ := wc_fetg_monogenic_points K B β (h₁ * d) v f hβinj hfm hirr hfv hrep
  have hh0 : h₁ * d ≠ 0 := mul_ne_zero hh₁ hd0

  have hgood : ∃ u₁ v₁ : AlgebraicClosure K,
      Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₁ (h₁ * d) ≠ 0 ∧
      Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₁) v₁ f = 0 := by
    have hmap0 : (h₁ * d).map (algebraMap K (AlgebraicClosure K)) ≠ 0 := Polynomial.map_ne_zero hh0
    obtain ⟨u₁, hu₁⟩ := Infinite.exists_notMem_finset
      ((h₁ * d).map (algebraMap K (AlgebraicClosure K))).roots.toFinset
    have hu : Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₁ (h₁ * d) ≠ 0 := by
      intro h0
      apply hu₁
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hmap0, Polynomial.IsRoot.def, Polynomial.eval_map]
      exact h0
    have hdeg : (f.map (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₁)).degree ≠ 0 := by
      have hpos : 0 < (f.map (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₁)).natDegree := by
        rw [hfm.natDegree_map, hfdeg]
        exact Nat.card_pos
      exact (Polynomial.natDegree_pos_iff_degree_pos.mp hpos).ne'
    obtain ⟨v₁, hv₁⟩ := IsAlgClosed.exists_root _ hdeg
    refine ⟨u₁, v₁, hu, ?_⟩
    rw [Polynomial.IsRoot.def, Polynomial.eval_map] at hv₁
    exact hv₁
  obtain ⟨u₁, v₁, hu₁, hv₁⟩ := hgood
  have hχ : ∀ u₀ v₀ : AlgebraicClosure K, ∃ χ : B →+* AlgebraicClosure K,
      (Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ (h₁ * d) ≠ 0 ∧
        Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) v₀ f = 0) →
      χ.comp β = Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀ ∧ χ v = v₀ := by
    intro u₀ v₀
    by_cases hg : Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ (h₁ * d) ≠ 0 ∧
        Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) v₀ f = 0
    · obtain ⟨χ, h1, h2⟩ := hex u₀ v₀ hg.1 hg.2
      exact ⟨χ, fun _ => ⟨h1, h2⟩⟩
    · obtain ⟨χ, -⟩ := hex u₁ v₁ hu₁ hv₁
      exact ⟨χ, fun h => absurd h hg⟩
  choose χf hχf using hχ

  have hkey : ∀ (χ' : B →+* AlgebraicClosure K) (u₀ : AlgebraicClosure K),
      χ'.comp β = Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀ →
      Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ (h₁ * d) ≠ 0 → ∀ g,
      χ' (α g v) = Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀)
        (χ' v) (P g) / Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ (h₁ * d) ^ e := by
    intro χ' u₀ hχ' hu g
    have h1 := congrArg χ' (hP g)
    rw [map_mul, map_pow, Polynomial.hom_eval₂, hχ'] at h1
    have h2 : χ' (β (h₁ * d)) = Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ (h₁ * d) := by
      show (χ'.comp β) (h₁ * d) = _
      rw [hχ', Polynomial.coe_eval₂RingHom]
    rw [h2] at h1
    rw [← h1, mul_div_cancel_left₀ _ (pow_ne_zero _ hu)]
  have hevC : ∀ u₀ : AlgebraicClosure K,
      (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀).comp
        (algebraMap K (Polynomial K)) = algebraMap K (AlgebraicClosure K) := by
    intro u₀
    ext c
    simp
  letI : Fintype K := Fintype.ofFinite K
  have hevfix : ∀ (n : ℕ) (φ : AlgebraicClosure K →+* AlgebraicClosure K),
      (∀ c, φ c = c ^ (Nat.card K ^ n)) → ∀ u₀ : AlgebraicClosure K,
      (φ.comp (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) =
        Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀ ↔ u₀ ^ (Nat.card K ^ n) = u₀) := by
    intro n φ hφ u₀
    have hφK : φ.comp (algebraMap K (AlgebraicClosure K)) = algebraMap K (AlgebraicClosure K) := by
      ext c
      rw [RingHom.comp_apply, hφ, ← map_pow,
        show Nat.card K = Fintype.card K from Fintype.card_eq_nat_card.symm,
        FiniteField.pow_card_pow]
    constructor
    · intro h
      have h1 := RingHom.congr_fun h Polynomial.X
      rw [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, hφ] at h1
      exact h1
    · intro h
      apply Polynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        exact RingHom.congr_fun hφK a
      · simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, hφ]
        exact h

  refine ⟨h₁ * d, e, f, P, fun u₀ v₀ => Spec.map (CommRingCat.ofHom (χf u₀ v₀)) ≫ ι, hh0, hfm,
    hfdeg, hirr, ?_⟩
  intro u₀ v₀ hu hv
  beta_reduce
  obtain ⟨hχβ, hχv⟩ := hχf u₀ v₀ ⟨hu, hv⟩
  generalize χf u₀ v₀ = χ at hχβ hχv ⊢
  have hχg : ∀ g, (χ.comp (α g)).comp β =
      Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀ := fun g => by
    rw [RingHom.comp_assoc, hαβ g, hχβ]
  have hψ : ∀ g, χ (α g v) =
      Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) v₀ (P g) /
        Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ (h₁ * d) ^ e := fun g => by
    rw [hkey χ u₀ hχβ hu g, hχv]
  have hb : Spec.map (CommRingCat.ofHom χ) ≫ ι ≫ πZ ≫ Uo.ι =
      Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀)) ≫ j := by
    rw [hgen, hχβ]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  ·
    intro g
    rw [← hψ g]
    have h1 := congrArg (χ.comp (α g)) hfv
    rw [Polynomial.hom_eval₂, hχg g, map_zero] at h1
    exact h1
  ·
    intro g g' hgg
    beta_reduce at hgg
    rw [← hψ g, ← hψ g'] at hgg
    have h1 : χ.comp (α g) = χ.comp (α g') := by
      apply huniq
      · rw [hχg, hχg]
      · show ((χ.comp (α g)).comp β) (h₁ * d) ≠ 0
        rw [hχg]
        exact hu
      · exact hgg
    have heq : χ.comp (algebraMap (Localization.Away h₁) B) =
        (χ.comp (α g)).comp (algebraMap (Localization.Away h₁) B) :=
      RingHom.ext fun a => (congrArg χ (hαfix g a)).symm
    obtain ⟨g₀, -, hu0⟩ := htorsR χ (χ.comp (α g)) heq
    exact (hu0 g rfl).trans (hu0 g' h1).symm
  ·
    intro g g'
    rw [← hψ (g * g'), ← hψ g, hαm]
    exact hkey (χ.comp (α g)) u₀ (hχg g) hu g'
  ·
    calc (Spec.map (CommRingCat.ofHom χ) ≫ ι) ≫ πZ ≫ Uo.ι ≫ (wcP1Over K).hom
        = (Spec.map (CommRingCat.ofHom χ) ≫ ι ≫ πZ ≫ Uo.ι) ≫ (wcP1Over K).hom := by
          simp only [Category.assoc]
      _ = Spec.map (CommRingCat.ofHom
            (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀)) ≫
            j ≫ (wcP1Over K).hom := by rw [hb, Category.assoc]
      _ = Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) := by
          rw [hjhom, hstar, hevC]
  ·
    intro n φ hφ
    constructor
    · simp only [Category.assoc]
      rw [hb, ← Category.assoc, hstar, cancel_mono j, hspec]
      exact hevfix n φ hφ u₀
    · intro g hu' hv'
      have hφχ : φ.comp χ = χ.comp (α g) := by
        apply huniq
        · rw [RingHom.comp_assoc, hχβ, hχg g]
          exact (hevfix n φ hφ u₀).mpr hu'
        · show φ ((χ.comp β) (h₁ * d)) ≠ 0
          rw [hχβ]
          exact (map_ne_zero φ).mpr hu
        · show φ (χ v) = χ (α g v)
          rw [hχv, hφ, hψ g]
          exact hv'
      rw [← Category.assoc, hstar, hφχ]
      exact (htw χ (χ.comp (α g)) g).mpr rfl

theorem wc_fetg_pw_fibre (K : Type u) [Field K] (G : Type) [Group G] [Fintype G]
    (h : Polynomial K) (e : ℕ) (f : Polynomial (Polynomial K))
    (P : G → Polynomial (Polynomial K)) (hf : f.Monic) (hdeg : f.natDegree = Fintype.card G)
    (hPW : wcFetgPW K G h e f P) (a : AlgebraicClosure K) (ha : wcFetgH h a ≠ 0) :
    wcFetgFibre K G h e f P a :=
by
  classical
  set φ := Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a with hφ
  have bridge : ∀ (F : Polynomial (Polynomial K)) (b : AlgebraicClosure K),
      wcFetgEv F a b = (F.map φ).eval b := fun F b => (Polynomial.eval_map φ b).symm
  have hmon : (f.map φ).Monic := hf.map φ
  have hNd : (f.map φ).natDegree = Fintype.card G := by
    rw [hf.natDegree_map φ, hdeg]
  have hNpos : 0 < Fintype.card G := Fintype.card_pos
  have hdeg0 : (f.map φ).degree ≠ 0 := by
    rw [Polynomial.degree_eq_natDegree hmon.ne_zero, hNd]
    exact_mod_cast hNpos.ne'
  have main : ∀ b, wcFetgEv f a b = 0 →
      f.map φ = ∏ g, (Polynomial.X - Polynomial.C (wcFetgEv (P g) a b / wcFetgH h a ^ e)) := by
    intro b hb
    obtain ⟨h1, h2, -⟩ := hPW a b ha hb
    set s : G → AlgebraicClosure K := fun g => wcFetgEv (P g) a b / wcFetgH h a ^ e with hs
    have hroot : ∀ g, (f.map φ).IsRoot (s g) := by
      intro g
      rw [Polynomial.IsRoot.def, ← bridge]
      exact h1 g
    have hdvd : (∏ g, (Polynomial.X - Polynomial.C (s g))) ∣ f.map φ := by
      apply Finset.prod_dvd_of_coprime
      · exact (Polynomial.pairwise_coprime_X_sub_C h2).set_pairwise _
      · intro g _
        exact Polynomial.dvd_iff_isRoot.mpr (hroot g)
    have hpm : (∏ g, (Polynomial.X - Polynomial.C (s g))).Monic :=
      Polynomial.monic_prod_of_monic _ _ (fun g _ => Polynomial.monic_X_sub_C (s g))
    have hpd : (∏ g, (Polynomial.X - Polynomial.C (s g))).natDegree = Fintype.card G := by
      rw [Polynomial.natDegree_prod_of_monic _ _ (fun g _ => Polynomial.monic_X_sub_C (s g))]
      simp [Polynomial.natDegree_X_sub_C]
    exact Polynomial.eq_of_monic_of_dvd_of_natDegree_le hpm hmon hdvd (by rw [hNd, hpd])
  have mem : ∀ b, wcFetgEv f a b = 0 → ∀ b', wcFetgEv f a b' = 0 →
      ∃ g, b' = wcFetgEv (P g) a b / wcFetgH h a ^ e := by
    intro b hb b' hb'
    have e1 : (f.map φ).eval b' = 0 := by rw [← bridge]; exact hb'
    rw [main b hb, Polynomial.eval_prod, Finset.prod_eq_zero_iff] at e1
    obtain ⟨g, -, hg⟩ := e1
    refine ⟨g, ?_⟩
    rw [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at hg
    exact hg
  obtain ⟨b₀, hb₀⟩ := IsAlgClosed.exists_root (f.map φ) hdeg0
  refine ⟨⟨b₀, by rw [bridge]; exact hb₀⟩, fun b hb => ⟨main b hb, ?_, mem b hb⟩⟩
  obtain ⟨g₁, hg₁⟩ := mem b hb b hb
  obtain ⟨-, h2, h3⟩ := hPW a b ha hb
  have h4 := h3 g₁ 1
  rw [← hg₁, mul_one] at h4
  have h5 : g₁ = 1 := h2 h4
  rw [← h5]
  exact hg₁.symm

theorem wc_fetg_pw_transfer (K : Type u) [Field K] (h : Polynomial K)
    (f : Polynomial (Polynomial K)) (hh : h ≠ 0) (hf : f.Monic)
    (hS : ∀ a : AlgebraicClosure K, wcFetgH h a ≠ 0 →
      ∃ S : Finset (AlgebraicClosure K), S.card = f.natDegree ∧ ∀ s ∈ S, wcFetgEv f a s = 0)
    (F : Polynomial (Polynomial K))
    (hF : ∀ a b : AlgebraicClosure K, wcFetgH h a ≠ 0 → wcFetgEv f a b = 0 → wcFetgEv F a b = 0) :
    f ∣ F :=
by
  classical
  have s1 : ∀ p : Polynomial K, (∀ a : AlgebraicClosure K, wcFetgH h a ≠ 0 →
      Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) a p = 0) → p = 0 := by
    intro p hp
    have hq : Polynomial.map (algebraMap K (AlgebraicClosure K)) (p * h) = 0 := by
      apply Polynomial.funext
      intro r
      rw [Polynomial.eval_map, Polynomial.eval₂_mul, Polynomial.eval_zero]
      by_cases hr : wcFetgH h r = 0
      · have h0 : Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) r h = 0 := hr
        rw [h0, mul_zero]
      · rw [hp r hr, zero_mul]
    rw [Polynomial.map_eq_zero_iff (algebraMap K (AlgebraicClosure K)).injective] at hq
    exact (mul_eq_zero.mp hq).resolve_right hh
  by_cases hf1 : f = 1
  · rw [hf1]; exact one_dvd F
  have hdeg : (F %ₘ f).natDegree < f.natDegree := Polynomial.natDegree_modByMonic_lt F hf hf1
  have hRF : F %ₘ f + f * (F /ₘ f) = F := Polynomial.modByMonic_add_div F f
  have hcoeff : ∀ i, (F %ₘ f).coeff i = 0 := by
    intro i
    apply s1
    intro a ha
    obtain ⟨S, hScard, hSf⟩ := hS a ha
    have hRa : Polynomial.map (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a)
        (F %ₘ f) = 0 := by
      apply Polynomial.eq_zero_of_natDegree_lt_card_of_eval_eq_zero' _ S
      · intro s hs
        rw [Polynomial.eval_map]
        have h1 := congrArg
          (Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a) s) hRF
        rw [Polynomial.eval₂_add, Polynomial.eval₂_mul] at h1
        have h2 : Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a)
            s f = 0 := hSf s hs
        have h3 : Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a)
            s F = 0 := hF a s ha (hSf s hs)
        rw [h2, h3, zero_mul, add_zero] at h1
        exact h1
      · refine lt_of_le_of_lt Polynomial.natDegree_map_le ?_
        rw [hScard]
        exact hdeg
    have h4 := congrArg (fun q => Polynomial.coeff q i) hRa
    simp only [Polynomial.coeff_map, Polynomial.coeff_zero, Polynomial.coe_eval₂RingHom] at h4
    exact h4
  have hR0 : F %ₘ f = 0 := Polynomial.ext (fun i => by rw [hcoeff i, Polynomial.coeff_zero])
  exact (Polynomial.modByMonic_eq_zero_iff_dvd hf).mp hR0

theorem wc_fetg_generic_package (K : Type u) [Field K] [Fintype K] (G : Type) [Group G]
    [Fintype G] [DecidableEq G] (h : Polynomial K) (e : ℕ) (f : Polynomial (Polynomial K))
    (P : G → Polynomial (Polynomial K)) (hh : h ≠ 0) (hf : f.Monic)
    (hdeg : f.natDegree = Fintype.card G)
    (hirr : Irreducible (f.map (algebraMap (Polynomial K) (RatFunc K))))
    (hPW : wcFetgPW K G h e f P)
    (hfib : ∀ a : AlgebraicClosure K, wcFetgH h a ≠ 0 → wcFetgFibre K G h e f P a)
    (hT : ∀ F : Polynomial (Polynomial K),
      (∀ a b : AlgebraicClosure K, wcFetgH h a ≠ 0 → wcFetgEv f a b = 0 → wcFetgEv F a b = 0) →
        f ∣ F) :
    ∃ (r : G → lwtrGenField (AlgebraicClosure K)) (H : Subgroup G) (ρ : G)
      (Φ : lwtrGenField (AlgebraicClosure K) ≃+* lwtrGenField (AlgebraicClosure K)),
      Function.Injective r ∧ wcFetgHO K h ≠ 0 ∧
      Polynomial.map (Polynomial.eval₂RingHom (wcFetgIota K) (wcFetgU K)) f =
        ∏ g, (Polynomial.X - Polynomial.C (r g)) ∧
      (∀ g k, wcFetgEvO K (P k) (r g) = wcFetgHO K h ^ e * r (g * k)) ∧
      (∀ a : AlgebraicClosure K,
        Φ (algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) a) =
          algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (a ^ Nat.card K)) ∧
      Φ (wcFetgU K) = wcFetgU K ∧
      (∀ g, Φ (r g) = r (ρ * g)) ∧
      (∀ τ : lwtrGenField (AlgebraicClosure K) ≃ₐ[RatFunc (AlgebraicClosure K)]
          lwtrGenField (AlgebraicClosure K), ∃ γ ∈ H, ∀ g, τ (r g) = r (γ * g)) ∧
      (∀ γ ∈ H, ∃ τ : lwtrGenField (AlgebraicClosure K) ≃ₐ[RatFunc (AlgebraicClosure K)]
          lwtrGenField (AlgebraicClosure K), ∀ g, τ (r g) = r (γ * g)) ∧
      (∀ γ, ρ * γ * ρ⁻¹ ∈ H ↔ γ ∈ H) ∧
      (∀ Pm : MvPolynomial (Fin 2) (AlgebraicClosure K),
        Polynomial.map (Φ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K))
            (lwtrGenEv (AlgebraicClosure K) Pm) =
          lwtrGenEv (AlgebraicClosure K) (MvPolynomial.map (lwtrFrob K) Pm)) ∧
      (∀ g, IsIntegral (Polynomial (AlgebraicClosure K)) (r g)) :=
by
  classical

  have lift : ∀ (F : Type u) [Field F] (σF : F ≃+* F),
      ∃ (ΦL : RatFunc F ≃+* RatFunc F) (Φ : lwtrGenField F ≃+* lwtrGenField F),
        (∀ l : RatFunc F, Φ (algebraMap (RatFunc F) (lwtrGenField F) l) =
          algebraMap (RatFunc F) (lwtrGenField F) (ΦL l)) ∧
        (∀ a : F, Φ (algebraMap F (lwtrGenField F) a) = algebraMap F (lwtrGenField F) (σF a)) ∧
        (∀ Pm : MvPolynomial (Fin 2) F,
          Polynomial.map (Φ : lwtrGenField F →+* lwtrGenField F) (lwtrGenEv F Pm) =
            lwtrGenEv F (MvPolynomial.map σF.toRingHom Pm)) ∧
        Φ (algebraMap (RatFunc F) (lwtrGenField F) RatFunc.X) =
          algebraMap (RatFunc F) (lwtrGenField F) RatFunc.X := by
    intro F _ σF
    set eA : Polynomial F ≃+* Polynomial F := Polynomial.mapEquiv σF with heA
    set ΦL : RatFunc F ≃+* RatFunc F :=
      IsFractionRing.ringEquivOfRingEquiv (A := Polynomial F) (B := Polynomial F)
        (K := RatFunc F) (L := RatFunc F) eA with hΦLdef
    set Φ : lwtrGenField F ≃+* lwtrGenField F :=
      IsAlgClosure.equivOfEquiv (lwtrGenField F) (lwtrGenField F) ΦL with hΦdef
    have h1 : ∀ l : RatFunc F, Φ (algebraMap (RatFunc F) (lwtrGenField F) l) =
        algebraMap (RatFunc F) (lwtrGenField F) (ΦL l) := fun l =>
      IsAlgClosure.equivOfEquiv_algebraMap (lwtrGenField F) (lwtrGenField F) ΦL l
    have hL : ∀ f : Polynomial F, ΦL (algebraMap (Polynomial F) (RatFunc F) f) =
        algebraMap (Polynomial F) (RatFunc F) (Polynomial.map (σF : F →+* F) f) := by
      intro f
      rw [hΦLdef, IsFractionRing.ringEquivOfRingEquiv_algebraMap, heA, Polynomial.mapEquiv_apply]
    have hH : ∀ f : Polynomial F, Φ (algebraMap (RatFunc F) (lwtrGenField F)
        (algebraMap (Polynomial F) (RatFunc F) f)) =
        algebraMap (RatFunc F) (lwtrGenField F)
          (algebraMap (Polynomial F) (RatFunc F) (Polynomial.map (σF : F →+* F) f)) := by
      intro f
      rw [h1, hL]
    have hFM : ∀ b : F, algebraMap F (lwtrGenField F) b =
        algebraMap (RatFunc F) (lwtrGenField F)
          (algebraMap (Polynomial F) (RatFunc F) (Polynomial.C b)) := by
      intro b
      rw [IsScalarTower.algebraMap_apply F (RatFunc F) (lwtrGenField F), RatFunc.algebraMap_C,
        RatFunc.algebraMap_eq_C]
    have h2 : ∀ a : F, Φ (algebraMap F (lwtrGenField F) a) =
        algebraMap F (lwtrGenField F) (σF a) := by
      intro a
      rw [hFM a, hH, Polynomial.map_C, hFM (σF a)]
      rfl
    have hU : Φ (algebraMap (RatFunc F) (lwtrGenField F) RatFunc.X) =
        algebraMap (RatFunc F) (lwtrGenField F) RatFunc.X := by
      rw [← RatFunc.algebraMap_X, hH, Polynomial.map_X]
    refine ⟨ΦL, Φ, h1, h2, ?_, hU⟩
    intro Pm
    induction Pm using MvPolynomial.induction_on with
    | C a =>
      rw [MvPolynomial.map_C, MvPolynomial.aeval_C, MvPolynomial.aeval_C,
        Polynomial.algebraMap_apply, Polynomial.algebraMap_apply, Polynomial.map_C]
      congr 1
      exact h2 a
    | add p q hp hq =>
      rw [map_add, Polynomial.map_add, hp, hq, map_add, map_add]
    | mul_X p n hp =>
      rw [map_mul, Polynomial.map_mul, hp, map_mul, map_mul, MvPolynomial.map_X]
      congr 1
      rw [MvPolynomial.aeval_X]
      fin_cases n
      · simp only [Fin.zero_eta, Fin.isValue, Matrix.cons_val_zero, Polynomial.map_C]
        congr 1
      · simp
  obtain ⟨ΦL, Φ, hΦL, hΦc, hΦev, hΦu⟩ :=
    lift (AlgebraicClosure K) (FiniteField.frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K)).toRingEquiv
  have hd1 : ∀ a : AlgebraicClosure K,
      Φ (algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) a) =
        algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (a ^ Nat.card K) := by
    intro a
    rw [hΦc]
    congr 1
    show (FiniteField.frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K)) a = _
    rw [FiniteField.frobeniusAlgEquivOfAlgebraic_apply, Fintype.card_eq_nat_card]
  have hΦι : ∀ a : K, Φ (wcFetgIota K a) = wcFetgIota K a := by
    intro a
    show Φ (algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K))
      (algebraMap K (AlgebraicClosure K) a)) =
        algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K))
          (algebraMap K (AlgebraicClosure K) a)
    rw [hΦc]
    congr 1
    show (FiniteField.frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K))
      (algebraMap K (AlgebraicClosure K) a) = _
    rw [FiniteField.frobeniusAlgEquivOfAlgebraic_apply, ← map_pow, FiniteField.pow_card]

  obtain ⟨φ, hφdef⟩ : ∃ φ : Polynomial K →+* lwtrGenField (AlgebraicClosure K),
      φ = Polynomial.eval₂RingHom (wcFetgIota K) (wcFetgU K) := ⟨_, rfl⟩
  have hφeq : (algebraMap (Polynomial (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K))).comp
      (Polynomial.mapRingHom (algebraMap K (AlgebraicClosure K))) = φ := by
    rw [hφdef]
    apply Polynomial.ringHom_ext
    · intro a
      rw [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C,
        Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      show _ = algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K))
        (algebraMap K (AlgebraicClosure K) a)
      rw [IsScalarTower.algebraMap_apply (AlgebraicClosure K) (Polynomial (AlgebraicClosure K))
        (lwtrGenField (AlgebraicClosure K)), Polynomial.algebraMap_eq]
    · rw [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X,
        Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
        IsScalarTower.algebraMap_apply (Polynomial (AlgebraicClosure K))
          (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K)), RatFunc.algebraMap_X]
  have hφinj : Function.Injective φ := by
    rw [← hφeq, RingHom.coe_comp]
    refine Function.Injective.comp ?_
      (Polynomial.map_injective _ (algebraMap K (AlgebraicClosure K)).injective)
    rw [IsScalarTower.algebraMap_eq (Polynomial (AlgebraicClosure K))
      (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K)), RingHom.coe_comp]
    exact (algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K))).injective.comp
      (IsFractionRing.injective _ _)
  have hφh : φ h ≠ 0 := (map_ne_zero_iff φ hφinj).mpr hh
  have hβ : φ (h ^ e) ≠ 0 := by rw [map_pow]; exact pow_ne_zero e hφh

  have homog : ∀ (E : Type u) [Field E] (χ : Polynomial K →+* E)
      (F Q : Polynomial (Polynomial K)) (B : Polynomial K) (M : ℕ) (w : E),
      F.natDegree ≤ M → χ B ≠ 0 →
      Polynomial.eval₂ χ w (∑ i ∈ Finset.range (M + 1),
          Polynomial.C (F.coeff i * B ^ (M - i)) * Q ^ i) =
        χ B ^ M * Polynomial.eval₂ χ (Polynomial.eval₂ χ w Q / χ B) F := by
    intro E _ χ F Q B M w hM hB
    rw [Polynomial.eval₂_eq_sum_range' χ (Nat.lt_succ_of_le hM), Polynomial.eval₂_finsetSum,
      Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i hi => ?_)
    have hi' : i ≤ M := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
    rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_pow, map_mul, map_pow, div_pow]
    have hpow : χ B ^ M = χ B ^ (M - i) * χ B ^ i := by rw [← pow_add, Nat.sub_add_cancel hi']
    have hBi : χ B ^ i ≠ 0 := pow_ne_zero i hB
    rw [hpow]
    field_simp

  have dvdroot : ∀ (D : Polynomial (Polynomial K)) (ξ : lwtrGenField (AlgebraicClosure K)),
      Polynomial.eval₂ φ ξ f = 0 → Polynomial.eval₂ φ ξ D = 0 → f ∣ D := by
    intro D ξ hξ hD
    have hj : (IsFractionRing.lift (A := Polynomial K) (K := RatFunc K) hφinj).comp
        (algebraMap (Polynomial K) (RatFunc K)) = φ :=
      RingHom.ext (fun x => IsFractionRing.lift_algebraMap hφinj x)
    have hf' : Polynomial.eval₂ (IsFractionRing.lift (A := Polynomial K) (K := RatFunc K) hφinj) ξ
        (f.map (algebraMap (Polynomial K) (RatFunc K))) = 0 := by
      rw [Polynomial.eval₂_map, hj]; exact hξ
    have hD' : Polynomial.eval₂ (IsFractionRing.lift (A := Polynomial K) (K := RatFunc K) hφinj) ξ
        (D.map (algebraMap (Polynomial K) (RatFunc K))) = 0 := by
      rw [Polynomial.eval₂_map, hj]; exact hD
    have hdvd : f.map (algebraMap (Polynomial K) (RatFunc K)) ∣
        D.map (algebraMap (Polynomial K) (RatFunc K)) := by
      by_contra hnd
      obtain ⟨A, B, hAB⟩ := (hirr.coprime_iff_not_dvd).mpr hnd
      have h1 := congrArg (Polynomial.eval₂RingHom
        (IsFractionRing.lift (A := Polynomial K) (K := RatFunc K) hφinj) ξ) hAB
      rw [map_add, map_mul, map_mul, map_one, Polynomial.coe_eval₂RingHom, hf', hD', mul_zero,
        mul_zero, add_zero] at h1
      exact zero_ne_one h1
    have hmon : (f.map (algebraMap (Polynomial K) (RatFunc K))).Monic := hf.map _
    rw [← Polynomial.modByMonic_eq_zero_iff_dvd hf]
    apply Polynomial.map_injective (algebraMap (Polynomial K) (RatFunc K))
      (IsFractionRing.injective _ _)
    rw [Polynomial.map_modByMonic _ hf, Polynomial.map_zero]
    exact (Polynomial.modByMonic_eq_zero_iff_dvd hmon).mpr hdvd

  have hNpos : 0 < Fintype.card G := Fintype.card_pos
  have hfmon : (f.map φ).Monic := hf.map φ
  have hfdeg : (f.map φ).natDegree = Fintype.card G := by rw [hf.natDegree_map, hdeg]
  obtain ⟨ξ, hξ⟩ := IsAlgClosed.exists_root (f.map φ) (by
    rw [Polynomial.degree_eq_natDegree hfmon.ne_zero, hfdeg]
    exact_mod_cast hNpos.ne')
  have hξ' : Polynomial.eval₂ φ ξ f = 0 := by rw [← Polynomial.eval_map]; exact hξ
  obtain ⟨r, hrdef⟩ : ∃ r : G → lwtrGenField (AlgebraicClosure K),
      ∀ g, r g = Polynomial.eval₂ φ ξ (P g) / φ h ^ e := ⟨_, fun g => rfl⟩

  have hF1 : ∀ g, f ∣ ∑ i ∈ Finset.range (f.natDegree + 1),
      Polynomial.C (f.coeff i * (h ^ e) ^ (f.natDegree - i)) * P g ^ i := by
    intro g
    apply hT
    intro a b ha hb
    have hχ : (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a) (h ^ e) ≠ 0 := by
      rw [map_pow]; exact pow_ne_zero _ ha
    show Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a) b _ = 0
    rw [homog _ _ f (P g) (h ^ e) f.natDegree b le_rfl hχ, map_pow]
    exact mul_eq_zero_of_right _ ((hPW a b ha hb).1 g)
  have hF2 : ∀ g k, f ∣ (∑ i ∈ Finset.range ((P k).natDegree + 1),
      Polynomial.C ((P k).coeff i * (h ^ e) ^ ((P k).natDegree - i)) * P g ^ i) -
        Polynomial.C ((h ^ e) ^ (P k).natDegree) * P (g * k) := by
    intro g k
    apply hT
    intro a b ha hb
    have hχ : (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a) (h ^ e) ≠ 0 := by
      rw [map_pow]; exact pow_ne_zero _ ha
    show Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a) b _ = 0
    rw [Polynomial.eval₂_sub, homog _ _ (P k) (P g) (h ^ e) _ b le_rfl hχ, Polynomial.eval₂_mul,
      Polynomial.eval₂_C, sub_eq_zero]
    have h3 := (div_left_inj' (pow_ne_zero e ha)).mp ((hPW a b ha hb).2.2 g k)
    have h4 : Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a)
        (Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a) b (P g) /
          (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a) (h ^ e)) (P k) =
        Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a) b
          (P (g * k)) := by
      rw [map_pow]; exact h3.symm
    rw [h4]
    simp only [map_pow]

  have hroot : ∀ g, Polynomial.eval₂ φ (r g) f = 0 := by
    intro g
    obtain ⟨q, hq⟩ := hF1 g
    have h1 := congrArg (Polynomial.eval₂ φ ξ) hq
    rw [Polynomial.eval₂_mul, hξ', zero_mul, homog _ φ f (P g) (h ^ e) f.natDegree ξ le_rfl hβ]
      at h1
    rcases mul_eq_zero.mp h1 with h2 | h2
    · exact absurd h2 (pow_ne_zero _ hβ)
    · rw [hrdef, ← map_pow]; exact h2
  have hPr : ∀ g k, Polynomial.eval₂ φ (r g) (P k) = φ h ^ e * r (g * k) := by
    intro g k
    obtain ⟨q, hq⟩ := hF2 g k
    have h1 := congrArg (Polynomial.eval₂ φ ξ) hq
    rw [Polynomial.eval₂_mul, hξ', zero_mul, Polynomial.eval₂_sub,
      homog _ φ (P k) (P g) (h ^ e) _ ξ le_rfl hβ, Polynomial.eval₂_mul, Polynomial.eval₂_C] at h1
    have h1' := sub_eq_zero.mp h1
    rw [map_pow φ (h ^ e) (P k).natDegree] at h1'
    have h2 := mul_left_cancel₀ (pow_ne_zero _ hβ) h1'
    rw [hrdef, hrdef, ← map_pow, h2, mul_div_assoc', mul_div_cancel_left₀ _ hβ]

  have hrinj : Function.Injective r := by
    intro g g' hgg
    rw [hrdef, hrdef, div_left_inj' (pow_ne_zero e hφh)] at hgg
    have hD : Polynomial.eval₂ φ ξ (P g - P g') = 0 := by
      rw [Polynomial.eval₂_sub, hgg, sub_self]
    obtain ⟨q, hq⟩ := dvdroot _ ξ hξ' hD
    have hhb : h.map (algebraMap K (AlgebraicClosure K)) ≠ 0 :=
      (Polynomial.map_ne_zero_iff (algebraMap K (AlgebraicClosure K)).injective).mpr hh
    obtain ⟨a, ha⟩ :=
      Infinite.exists_notMem_finset (h.map (algebraMap K (AlgebraicClosure K))).roots.toFinset
    have ha' : wcFetgH h a ≠ 0 := by
      intro h0
      apply ha
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hhb, Polynomial.IsRoot.def,
        Polynomial.eval_map]
      exact h0
    obtain ⟨b, hb⟩ := (hfib a ha').1
    apply (hPW a b ha' hb).2.1
    show wcFetgEv (P g) a b / wcFetgH h a ^ e = wcFetgEv (P g') a b / wcFetgH h a ^ e
    congr 1
    have h1 := congrArg
      (Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a) b) hq
    have hb' : Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a)
        b f = 0 := hb
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_mul, hb', zero_mul, sub_eq_zero] at h1
    exact h1

  have hsplit : f.map φ = ∏ g, (Polynomial.X - Polynomial.C (r g)) := by
    have hs : (Finset.univ.val.map r).Nodup := Multiset.Nodup.map hrinj Finset.univ.nodup
    have hle : Finset.univ.val.map r ≤ (f.map φ).roots := by
      rw [Multiset.le_iff_subset hs]
      intro x hx
      obtain ⟨g, -, rfl⟩ := Multiset.mem_map.mp hx
      rw [Polynomial.mem_roots hfmon.ne_zero, Polynomial.IsRoot.def, Polynomial.eval_map]
      exact hroot g
    have hdvd := (Multiset.prod_X_sub_C_dvd_iff_le_roots hfmon.ne_zero _).mpr hle
    have hprod : ∏ g, (Polynomial.X - Polynomial.C (r g)) =
        ((Finset.univ.val.map r).map (fun a => Polynomial.X - Polynomial.C a)).prod := by
      rw [Finset.prod_eq_multiset_prod, Multiset.map_map]; rfl
    rw [← hprod] at hdvd
    have hmon : (∏ g, (Polynomial.X - Polynomial.C (r g))).Monic :=
      Polynomial.monic_prod_of_monic _ _ (fun g _ => Polynomial.monic_X_sub_C (r g))
    have hdegp : (∏ g, (Polynomial.X - Polynomial.C (r g))).natDegree = Fintype.card G := by
      rw [Polynomial.natDegree_prod_of_monic _ _ (fun g _ => Polynomial.monic_X_sub_C (r g))]
      simp
    exact Polynomial.eq_of_monic_of_dvd_of_natDegree_le hmon hfmon hdvd (by rw [hfdeg, hdegp])

  have hint : ∀ g, IsIntegral (Polynomial (AlgebraicClosure K)) (r g) := by
    intro g
    refine ⟨f.map (Polynomial.mapRingHom (algebraMap K (AlgebraicClosure K))), hf.map _, ?_⟩
    rw [Polynomial.eval₂_map, hφeq]
    exact hroot g

  have transport : ∀ σ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K),
      (∀ a : K, σ (wcFetgIota K a) = wcFetgIota K a) → σ (wcFetgU K) = wcFetgU K →
      ∃ γ : G, ∀ g, σ (r g) = r (γ * g) := by
    intro σ hσι hσu
    have hσφ : σ.comp φ = φ := by
      rw [hφdef]
      apply Polynomial.ringHom_ext
      · intro a
        rw [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        exact hσι a
      · rw [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
        exact hσu
    have hσev : ∀ (F : Polynomial (Polynomial K)) (w : lwtrGenField (AlgebraicClosure K)),
        σ (Polynomial.eval₂ φ w F) = Polynomial.eval₂ φ (σ w) F := by
      intro F w; rw [Polynomial.hom_eval₂, hσφ]
    have hσh : σ (φ h) = φ h := by rw [← RingHom.comp_apply, hσφ]
    have hr1 : Polynomial.eval₂ φ (σ (r 1)) f = 0 := by rw [← hσev, hroot 1, map_zero]
    have h0 : (f.map φ).eval (σ (r 1)) = 0 := by rw [Polynomial.eval_map]; exact hr1
    rw [hsplit, Polynomial.eval_prod, Finset.prod_eq_zero_iff] at h0
    obtain ⟨γ, -, hγ⟩ := h0
    rw [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at hγ
    refine ⟨γ, fun g => ?_⟩
    have e1 := hPr 1 g
    rw [one_mul] at e1
    have e2 := congrArg σ e1
    rw [hσev, hγ, hPr γ g, map_mul, map_pow, hσh] at e2
    exact (mul_left_cancel₀ (pow_ne_zero e hφh) e2).symm
  obtain ⟨ρ, hρ⟩ := transport (Φ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K))
    hΦι hΦu
  have hρ' : ∀ g, Φ (r g) = r (ρ * g) := hρ
  have hιL : ∀ a : K, wcFetgIota K a =
      algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K))
        (algebraMap (AlgebraicClosure K) (RatFunc (AlgebraicClosure K))
          (algebraMap K (AlgebraicClosure K) a)) := fun a =>
    IsScalarTower.algebraMap_apply (AlgebraicClosure K) (RatFunc (AlgebraicClosure K))
      (lwtrGenField (AlgebraicClosure K)) _
  have hτ : ∀ τ : lwtrGenField (AlgebraicClosure K) ≃ₐ[RatFunc (AlgebraicClosure K)]
      lwtrGenField (AlgebraicClosure K), ∃ γ : G, ∀ g, τ (r g) = r (γ * g) := by
    intro τ
    obtain ⟨γ, hγ⟩ := transport τ.toRingEquiv.toRingHom
      (fun a => by
        show τ (wcFetgIota K a) = wcFetgIota K a
        rw [hιL, AlgEquiv.commutes])
      (by show τ (wcFetgU K) = wcFetgU K; exact AlgEquiv.commutes τ RatFunc.X)
    exact ⟨γ, hγ⟩

  obtain ⟨H, hHmem⟩ : ∃ H : Subgroup G, ∀ γ, γ ∈ H ↔
      ∃ τ : lwtrGenField (AlgebraicClosure K) ≃ₐ[RatFunc (AlgebraicClosure K)]
        lwtrGenField (AlgebraicClosure K), ∀ g, τ (r g) = r (γ * g) :=
    ⟨{ carrier := {γ | ∃ τ : lwtrGenField (AlgebraicClosure K) ≃ₐ[RatFunc (AlgebraicClosure K)]
          lwtrGenField (AlgebraicClosure K), ∀ g, τ (r g) = r (γ * g)}
       mul_mem' := by
         rintro γ₁ γ₂ ⟨τ₁, h₁⟩ ⟨τ₂, h₂⟩
         exact ⟨τ₂.trans τ₁, fun g => by rw [AlgEquiv.trans_apply, h₂, h₁, mul_assoc]⟩
       one_mem' := ⟨AlgEquiv.refl, fun g => by rw [one_mul]; rfl⟩
       inv_mem' := by
         rintro γ ⟨τ, hτ'⟩
         refine ⟨τ.symm, fun g => ?_⟩
         apply τ.injective
         rw [AlgEquiv.apply_symm_apply, hτ', mul_inv_cancel_left] },
     fun γ => Iff.rfl⟩
  have hΦsr : ∀ g, Φ.symm (r g) = r (ρ⁻¹ * g) := by
    intro g
    apply Φ.injective
    rw [RingEquiv.apply_symm_apply, hρ', mul_inv_cancel_left]
  have hΦsL : ∀ l, Φ.symm (algebraMap (RatFunc (AlgebraicClosure K))
      (lwtrGenField (AlgebraicClosure K)) l) =
      algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K)) (ΦL.symm l) := by
    intro l
    apply Φ.injective
    rw [RingEquiv.apply_symm_apply, hΦL, RingEquiv.apply_symm_apply]
  have hnorm : ∀ γ, ρ * γ * ρ⁻¹ ∈ H ↔ γ ∈ H := by
    intro γ
    rw [hHmem, hHmem]
    constructor
    · rintro ⟨τ, hτ'⟩
      refine ⟨AlgEquiv.ofRingEquiv (f := (Φ.trans τ.toRingEquiv).trans Φ.symm) (fun l => ?_),
        fun g => ?_⟩
      · rw [RingEquiv.trans_apply, RingEquiv.trans_apply, hΦL, AlgEquiv.coe_ringEquiv,
          AlgEquiv.commutes, hΦsL, RingEquiv.symm_apply_apply]
      · rw [AlgEquiv.ofRingEquiv_apply, RingEquiv.trans_apply, RingEquiv.trans_apply, hρ',
          AlgEquiv.coe_ringEquiv, hτ', hΦsr]
        congr 1
        group
    · rintro ⟨τ, hτ'⟩
      refine ⟨AlgEquiv.ofRingEquiv (f := (Φ.symm.trans τ.toRingEquiv).trans Φ) (fun l => ?_),
        fun g => ?_⟩
      · rw [RingEquiv.trans_apply, RingEquiv.trans_apply, hΦsL, AlgEquiv.coe_ringEquiv,
          AlgEquiv.commutes, hΦL, RingEquiv.apply_symm_apply]
      · rw [AlgEquiv.ofRingEquiv_apply, RingEquiv.trans_apply, RingEquiv.trans_apply, hΦsr,
          AlgEquiv.coe_ringEquiv, hτ', hρ']
        congr 1
        group

  subst hφdef
  refine ⟨r, H, ρ, Φ, hrinj, hφh, hsplit, hPr, hd1, hΦu, hρ',
    fun τ => ?_, fun γ hγ => (hHmem γ).mp hγ, hnorm, hΦev, hint⟩
  obtain ⟨γ, hγ⟩ := hτ τ
  exact ⟨γ, (hHmem γ).mpr ⟨τ, hγ⟩, hγ⟩

theorem wc_fetg_coset_cover (K : Type u) [Field K] [Finite K] (G : Type) [Group G] [Fintype G]
    [DecidableEq G] (f : Polynomial (Polynomial K)) (hf : f.Monic)
    (hdeg : f.natDegree = Fintype.card G)
    (hirr : Irreducible (f.map (algebraMap (Polynomial K) (RatFunc K))))
    (r : G → lwtrGenField (AlgebraicClosure K)) (hr : Function.Injective r)
    (hfr : Polynomial.map (Polynomial.eval₂RingHom (wcFetgIota K) (wcFetgU K)) f =
      ∏ g, (Polynomial.X - Polynomial.C (r g)))
    (Φ : lwtrGenField (AlgebraicClosure K) ≃+* lwtrGenField (AlgebraicClosure K))
    (hΦc : ∀ a : AlgebraicClosure K,
      Φ (algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) a) =
        algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (a ^ Nat.card K))
    (hΦu : Φ (wcFetgU K) = wcFetgU K)
    (ρ : G) (hΦr : ∀ g, Φ (r g) = r (ρ * g)) (H : Subgroup G)
    (hH : ∀ τ : lwtrGenField (AlgebraicClosure K) ≃ₐ[RatFunc (AlgebraicClosure K)]
      lwtrGenField (AlgebraicClosure K), ∃ γ ∈ H, ∀ g, τ (r g) = r (γ * g))
    (hρH : ∀ γ ∈ H, ρ * γ * ρ⁻¹ ∈ H) :
    ∀ g : G, ∃ γ ∈ H, ∃ t : ℕ, g = γ * ρ ^ t :=
by
  classical
  letI : Fintype K := Fintype.ofFinite K

  have hfixc : ∀ c : AlgebraicClosure K, c ^ Nat.card K = c →
      c ∈ Set.range (algebraMap K (AlgebraicClosure K)) := by
    intro c hc
    have hq : 1 < Nat.card K := Finite.one_lt_card
    by_contra hcn
    obtain ⟨P, hP⟩ : ∃ P : Polynomial (AlgebraicClosure K),
        P = Polynomial.X ^ Nat.card K - Polynomial.X := ⟨_, rfl⟩
    have hPdeg : P.natDegree = Nat.card K := by
      rw [hP]; exact FiniteField.X_pow_card_sub_X_natDegree_eq _ hq
    have hP0 : P ≠ 0 := by
      intro h; rw [h, Polynomial.natDegree_zero] at hPdeg; omega
    have hroot : ∀ x : AlgebraicClosure K, x ^ Nat.card K = x → x ∈ P.roots := by
      intro x hx
      rw [Polynomial.mem_roots hP0, Polynomial.IsRoot.def, hP, Polynomial.eval_sub,
        Polynomial.eval_pow, Polynomial.eval_X, hx, sub_self]
    have hcT : c ∉ Finset.univ.image (algebraMap K (AlgebraicClosure K)) := by
      intro h
      obtain ⟨a, _, ha⟩ := Finset.mem_image.mp h
      exact hcn ⟨a, ha⟩
    have hTcard : (insert c (Finset.univ.image (algebraMap K (AlgebraicClosure K)))).card =
        Nat.card K + 1 := by
      rw [Finset.card_insert_of_notMem hcT,
        Finset.card_image_of_injective _ (algebraMap K (AlgebraicClosure K)).injective,
        Finset.card_univ, Fintype.card_eq_nat_card]
    have hTsub : (insert c (Finset.univ.image (algebraMap K (AlgebraicClosure K)))).val ⊆
        P.roots := by
      intro x hx
      have hx' : x ∈ insert c (Finset.univ.image (algebraMap K (AlgebraicClosure K))) := hx
      rcases Finset.mem_insert.mp hx' with h | h
      · rw [h]; exact hroot c hc
      · obtain ⟨a, _, rfl⟩ := Finset.mem_image.mp h
        apply hroot
        rw [← map_pow, ← Fintype.card_eq_nat_card, FiniteField.pow_card a]
    have := Polynomial.card_le_degree_of_subset_roots hTsub
    omega

  obtain ⟨σ, hσ⟩ : ∃ σ : AlgebraicClosure K →+* AlgebraicClosure K,
      ∀ a, σ a = a ^ Nat.card K :=
    ⟨(FiniteField.frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K)).toRingEquiv.toRingHom,
      fun a => by
        have := congrFun (FiniteField.coe_frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K)) a
        rw [Fintype.card_eq_nat_card] at this
        exact this⟩

  have hΦpoly : ∀ p : Polynomial (AlgebraicClosure K),
      Φ (algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K))
        (algebraMap (Polynomial (AlgebraicClosure K)) (RatFunc (AlgebraicClosure K)) p)) =
      algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K))
        (algebraMap (Polynomial (AlgebraicClosure K)) (RatFunc (AlgebraicClosure K))
          (p.map σ)) := by
    intro p
    have key : (Φ.toRingHom).comp
        ((algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K))).comp
          (algebraMap (Polynomial (AlgebraicClosure K)) (RatFunc (AlgebraicClosure K)))) =
        ((algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K))).comp
          (algebraMap (Polynomial (AlgebraicClosure K)) (RatFunc (AlgebraicClosure K)))).comp
          (Polynomial.mapRingHom σ) := by
      apply Polynomial.ringHom_ext
      · intro a
        rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply,
          Polynomial.coe_mapRingHom, Polynomial.map_C, RatFunc.algebraMap_C, RatFunc.algebraMap_C,
          ← RatFunc.algebraMap_eq_C, ← IsScalarTower.algebraMap_apply,
          ← IsScalarTower.algebraMap_apply, hσ]
        exact hΦc a
      · rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply,
          Polynomial.coe_mapRingHom, Polynomial.map_X, RatFunc.algebraMap_X]
        exact hΦu
    exact RingHom.congr_fun key p

  obtain ⟨κ, hκ⟩ : ∃ κ : RatFunc K →+* RatFunc (AlgebraicClosure K), ∀ p : Polynomial K,
      κ (algebraMap (Polynomial K) (RatFunc K) p) =
        algebraMap (Polynomial (AlgebraicClosure K)) (RatFunc (AlgebraicClosure K))
          (p.map (algebraMap K (AlgebraicClosure K))) := by
    have hg : Function.Injective
        ((algebraMap (Polynomial (AlgebraicClosure K)) (RatFunc (AlgebraicClosure K))).comp
          (Polynomial.mapRingHom (algebraMap K (AlgebraicClosure K)))) :=
      (RatFunc.algebraMap_injective _).comp
        (Polynomial.map_injective _ (algebraMap K (AlgebraicClosure K)).injective)
    exact ⟨IsFractionRing.lift hg, fun p => IsFractionRing.lift_algebraMap hg p⟩

  have hdesc : ∀ l : RatFunc (AlgebraicClosure K),
      Φ (algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K)) l) =
        algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K)) l →
      l ∈ Set.range κ := by
    intro l hl
    have hψinj : Function.Injective (fun p : Polynomial (AlgebraicClosure K) =>
        algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K))
          (algebraMap (Polynomial (AlgebraicClosure K)) (RatFunc (AlgebraicClosure K)) p)) :=
      (algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K))).injective.comp
        (RatFunc.algebraMap_injective _)
    have hd0 : l.denom ≠ 0 := RatFunc.denom_ne_zero l
    have hdσm : (l.denom.map σ).Monic := (RatFunc.monic_denom l).map σ
    have hdσ0 : l.denom.map σ ≠ 0 := hdσm.ne_zero
    have hψd : algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K))
          (algebraMap (Polynomial (AlgebraicClosure K)) (RatFunc (AlgebraicClosure K))
            l.denom) ≠ 0 := by
      intro h
      apply hd0
      apply hψinj
      simp only [map_zero]
      exact h
    have hψdσ : algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K))
          (algebraMap (Polynomial (AlgebraicClosure K)) (RatFunc (AlgebraicClosure K))
            (l.denom.map σ)) ≠ 0 := by
      intro h
      apply hdσ0
      apply hψinj
      simp only [map_zero]
      exact h
    have h1 := congrArg
      (algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K)))
      (RatFunc.num_div_denom l)
    rw [map_div₀] at h1
    have h2 := congrArg Φ h1
    rw [map_div₀, hΦpoly, hΦpoly, hl, ← h1, div_eq_div_iff hψdσ hψd, ← map_mul, ← map_mul,
      ← map_mul, ← map_mul] at h2
    have h3 : l.num.map σ * l.denom = l.num * l.denom.map σ := hψinj h2
    have hdvd : l.denom ∣ l.denom.map σ := by
      apply (RatFunc.isCoprime_num_denom l).symm.dvd_of_dvd_mul_left
      rw [← h3]
      exact dvd_mul_left _ _
    have hdeq : l.denom.map σ = l.denom :=
      Polynomial.eq_of_monic_of_dvd_of_natDegree_le (RatFunc.monic_denom l) hdσm hdvd
        (Polynomial.natDegree_map_eq_of_injective σ.injective _).le
    rw [hdeq] at h3
    have hneq : l.num.map σ = l.num := mul_right_cancel₀ hd0 h3
    have hlift : ∀ p : Polynomial (AlgebraicClosure K), p.map σ = p →
        ∃ p₀ : Polynomial K, p₀.map (algebraMap K (AlgebraicClosure K)) = p := by
      intro p hp
      have hmem : p ∈ Polynomial.lifts (algebraMap K (AlgebraicClosure K)) := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro i
        apply hfixc
        rw [← hσ, ← Polynomial.coeff_map, hp]
      exact (Polynomial.mem_lifts p).mp hmem
    obtain ⟨n₀, hn₀⟩ := hlift _ hneq
    obtain ⟨d₀, hd₀⟩ := hlift _ hdeq
    refine ⟨algebraMap (Polynomial K) (RatFunc K) n₀ / algebraMap (Polynomial K) (RatFunc K) d₀,
      ?_⟩
    rw [map_div₀, hκ, hκ, hn₀, hd₀, RatFunc.num_div_denom]

  have hjf : (f.map (algebraMap (Polynomial K) (RatFunc K))).map
      ((algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K))).comp κ) =
      Polynomial.map (Polynomial.eval₂RingHom (wcFetgIota K) (wcFetgU K)) f := by
    rw [Polynomial.map_map]
    congr 1
    apply Polynomial.ringHom_ext
    · intro a
      rw [RingHom.comp_apply, RingHom.comp_apply, hκ, Polynomial.map_C, RatFunc.algebraMap_C,
        ← RatFunc.algebraMap_eq_C, ← IsScalarTower.algebraMap_apply, Polynomial.coe_eval₂RingHom,
        Polynomial.eval₂_C]
      rfl
    · rw [RingHom.comp_apply, RingHom.comp_apply, hκ, Polynomial.map_X, RatFunc.algebraMap_X,
        Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]

  have hrsep : ∀ g, r g ∈ separableClosure (RatFunc (AlgebraicClosure K))
      (lwtrGenField (AlgebraicClosure K)) := by
    intro g
    rw [mem_separableClosure_iff]
    have hfL : ((f.map (algebraMap (Polynomial K) (RatFunc K))).map κ).map
        (algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K))) =
        Polynomial.map (Polynomial.eval₂RingHom (wcFetgIota K) (wcFetgU K)) f := by
      rw [Polynomial.map_map]; exact hjf
    have hsepΩ : (Polynomial.map (Polynomial.eval₂RingHom (wcFetgIota K) (wcFetgU K)) f).Separable := by
      rw [hfr]; exact Polynomial.separable_prod_X_sub_C_iff.mpr hr
    have hsepL : ((f.map (algebraMap (Polynomial K) (RatFunc K))).map κ).Separable :=
      (Polynomial.separable_map _).mp (by rw [hfL]; exact hsepΩ)
    have haev : Polynomial.aeval (r g) ((f.map (algebraMap (Polynomial K) (RatFunc K))).map κ)
        = 0 := by
      rw [Polynomial.aeval_def, ← Polynomial.eval_map, hfL, hfr, Polynomial.eval_prod]
      exact Finset.prod_eq_zero (Finset.mem_univ g) (by simp)
    exact hsepL.of_dvd (minpoly.dvd _ _ haev)

  have hgal : ∀ e : separableClosure (RatFunc (AlgebraicClosure K))
      (lwtrGenField (AlgebraicClosure K)),
      (∀ τ : lwtrGenField (AlgebraicClosure K) ≃ₐ[RatFunc (AlgebraicClosure K)]
        lwtrGenField (AlgebraicClosure K), τ (e : lwtrGenField (AlgebraicClosure K)) = e) →
      (e : lwtrGenField (AlgebraicClosure K)) ∈ Set.range
        (algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K))) := by
    intro e he
    have hE : e ∈ Set.range (algebraMap (RatFunc (AlgebraicClosure K))
        (separableClosure (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K)))) := by
      rw [InfiniteGalois.mem_range_algebraMap_iff_fixed]
      intro τ
      apply Subtype.ext
      have h1 := AlgEquiv.liftNormal_commutes τ (lwtrGenField (AlgebraicClosure K)) e
      have h2 := he (τ.liftNormal (lwtrGenField (AlgebraicClosure K)))
      exact h1.symm.trans h2
    obtain ⟨l, hl⟩ := hE
    refine ⟨l, ?_⟩
    rw [IsScalarTower.algebraMap_apply (RatFunc (AlgebraicClosure K))
      (separableClosure (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K)))
      (lwtrGenField (AlgebraicClosure K)), hl]
    rfl

  obtain ⟨S, hS⟩ : ∃ S : Finset G, ∀ g, g ∈ S ↔ ∃ γ ∈ H, ∃ t : ℕ, g = γ * ρ ^ t :=
    ⟨Finset.univ.filter (fun g => ∃ γ ∈ H, ∃ t : ℕ, g = γ * ρ ^ t), by intro g; simp⟩
  have h1S : (1 : G) ∈ S := (hS 1).mpr ⟨1, H.one_mem, 0, by simp⟩
  have hHS : ∀ x ∈ H, ∀ s ∈ S, x * s ∈ S := by
    intro x hx s hs
    obtain ⟨γ, hγ, t, rfl⟩ := (hS s).mp hs
    exact (hS _).mpr ⟨x * γ, H.mul_mem hx hγ, t, (mul_assoc _ _ _).symm⟩
  have hρS : ∀ s ∈ S, ρ * s ∈ S := by
    intro s hs
    obtain ⟨γ, hγ, t, rfl⟩ := (hS s).mp hs
    exact (hS _).mpr ⟨ρ * γ * ρ⁻¹, hρH γ hγ, t + 1, by rw [pow_succ']; group⟩
  have hinv : ∀ (φ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K))
      (x : G), (∀ g, φ (r g) = r (x * g)) → (∀ s ∈ S, x * s ∈ S) →
      ∀ i, φ ((∏ s ∈ S, (Polynomial.X - Polynomial.C (r s))).coeff i) =
        (∏ s ∈ S, (Polynomial.X - Polynomial.C (r s))).coeff i := by
    intro φ x hφ hxS i
    have himg : S.image (fun s => x * s) = S := Finset.eq_of_subset_of_card_le
      (fun y hy => by
        obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hy
        exact hxS s hs)
      (Finset.card_image_of_injective _ (mul_right_injective x)).ge
    have hmap : (∏ s ∈ S, (Polynomial.X - Polynomial.C (r s))).map φ =
        ∏ s ∈ S, (Polynomial.X - Polynomial.C (r s)) := by
      rw [Polynomial.map_prod]
      simp only [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, hφ]
      conv_rhs => rw [← himg]
      rw [Finset.prod_image (fun a _ b _ h => mul_right_injective x h)]
    rw [← Polynomial.coeff_map, hmap]

  have hFlift : (∏ s ∈ S, (Polynomial.X - Polynomial.C (r s))) ∈ Polynomial.lifts
      ((algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K))).comp κ) := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro i
    have hE : (∏ s ∈ S, (Polynomial.X - Polynomial.C (r s))) =
        (∏ s ∈ S, (Polynomial.X - Polynomial.C (⟨r s, hrsep s⟩ : separableClosure
          (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K))))).map
          (algebraMap (separableClosure (RatFunc (AlgebraicClosure K))
            (lwtrGenField (AlgebraicClosure K))) (lwtrGenField (AlgebraicClosure K))) := by
      rw [Polynomial.map_prod]
      refine Finset.prod_congr rfl (fun s _ => ?_)
      rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
      rfl
    have hce : ∃ e : separableClosure (RatFunc (AlgebraicClosure K))
        (lwtrGenField (AlgebraicClosure K)),
        (e : lwtrGenField (AlgebraicClosure K)) =
          (∏ s ∈ S, (Polynomial.X - Polynomial.C (r s))).coeff i := by
      rw [hE, Polynomial.coeff_map]
      exact ⟨_, rfl⟩
    obtain ⟨e, he⟩ := hce
    have hfixτ : ∀ τ : lwtrGenField (AlgebraicClosure K) ≃ₐ[RatFunc (AlgebraicClosure K)]
        lwtrGenField (AlgebraicClosure K), τ (e : lwtrGenField (AlgebraicClosure K)) = e := by
      intro τ
      obtain ⟨γ, hγ, hτ⟩ := hH τ
      rw [he]
      exact hinv τ.toAlgHom.toRingHom γ hτ (hHS γ hγ) i
    obtain ⟨l, hl⟩ := hgal e hfixτ
    have hΦl : Φ (algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K)) l)
        = algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K)) l := by
      rw [hl, he]
      exact hinv Φ.toRingHom ρ hΦr hρS i
    obtain ⟨k, hk⟩ := hdesc l hΦl
    refine ⟨k, ?_⟩
    rw [RingHom.comp_apply, hk, hl, he]

  have hFm : (∏ s ∈ S, (Polynomial.X - Polynomial.C (r s))).Monic :=
    Polynomial.monic_prod_of_monic _ _ (fun s _ => Polynomial.monic_X_sub_C (r s))
  obtain ⟨F', hF'map, hF'deg, hF'm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hFlift hFm
  have hFdeg : (∏ s ∈ S, (Polynomial.X - Polynomial.C (r s))).natDegree = S.card :=
    Polynomial.natDegree_finsetProd_X_sub_C_eq_card S r
  have hFdvd : (∏ s ∈ S, (Polynomial.X - Polynomial.C (r s))) ∣
      Polynomial.map (Polynomial.eval₂RingHom (wcFetgIota K) (wcFetgU K)) f := by
    rw [hfr]
    exact Finset.prod_dvd_prod_of_subset S Finset.univ _ (Finset.subset_univ S)
  rw [← hF'map, ← hjf] at hFdvd
  have hF'dvd : F' ∣ f.map (algebraMap (Polynomial K) (RatFunc K)) :=
    (Polynomial.map_dvd_map _ (RingHom.injective _) hF'm).mp hFdvd
  obtain ⟨Q, hQ⟩ := hF'dvd
  have hSpos : 1 ≤ S.card := Finset.card_pos.mpr ⟨1, h1S⟩
  have hfKdeg : (f.map (algebraMap (Polynomial K) (RatFunc K))).natDegree = f.natDegree :=
    Polynomial.natDegree_map_eq_of_injective (RatFunc.algebraMap_injective K) f
  have hcard : S.card = Fintype.card G := by
    rcases hirr.isUnit_or_isUnit hQ with hu | hu
    · have := Polynomial.natDegree_eq_zero_of_isUnit hu
      omega
    · have hQ0 := Polynomial.natDegree_eq_zero_of_isUnit hu
      have hdm := Polynomial.natDegree_mul hF'm.ne_zero hu.ne_zero
      rw [← hQ] at hdm
      omega
  have hSuniv := Finset.eq_univ_of_card S hcard
  intro g
  exact (hS g).mp (hSuniv ▸ Finset.mem_univ g)

theorem wc_fetg_resolvent (K : Type u) [Field K] (G : Type) [Group G] [Fintype G] [DecidableEq G]
    (f : Polynomial (Polynomial K)) (P : G → Polynomial (Polynomial K)) (hf : f.Monic)
    (hdeg : f.natDegree = Fintype.card G) :
    ∃ B : ℕ, ∀ c : G → AlgebraicClosure K, ∃ (Rm : MvPolynomial (Fin 2) (AlgebraicClosure K))
      (D : Polynomial (AlgebraicClosure K)),
      Rm.totalDegree ≤ B ∧ D.natDegree ≤ B ∧ wcFetgResSpec K G f P c Rm D :=
by
  have t1 : ∀ (m d : ℕ) (M : Matrix (Fin m) (Fin m) (MvPolynomial (Fin 2) (AlgebraicClosure K))),
      (∀ i j, (M i j).totalDegree ≤ d) → M.det.totalDegree ≤ m * d := by
    intro m d M hM
    rw [Matrix.det_apply]
    refine (MvPolynomial.totalDegree_finsetSum _ _).trans ?_
    refine Finset.sup_le fun τ _ => ?_
    have hprod : (∏ i, M (τ i) i).totalDegree ≤ m * d := by
      refine (MvPolynomial.totalDegree_finsetProd _ _).trans ?_
      have := Finset.sum_le_card_nsmul (Finset.univ : Finset (Fin m))
        (fun i => (M (τ i) i).totalDegree) d (fun i _ => hM _ _)
      simpa using this
    rcases Int.units_eq_one_or (Equiv.Perm.sign τ) with h | h
    · rw [h, one_smul]; exact hprod
    · rw [h, Units.neg_smul, one_smul, MvPolynomial.totalDegree_neg]; exact hprod
  have t2 : ∀ (m d : ℕ) (M : Matrix (Fin m) (Fin m) (Polynomial (AlgebraicClosure K))),
      (∀ i j, (M i j).natDegree ≤ d) → M.det.natDegree ≤ m * d := by
    intro m d M hM
    rw [Matrix.det_apply]
    refine Polynomial.natDegree_sum_le_of_forall_le _ _ fun τ _ => ?_
    have hprod : (∏ i, M (τ i) i).natDegree ≤ m * d := by
      refine (Polynomial.natDegree_prod_le _ _).trans ?_
      have := Finset.sum_le_card_nsmul (Finset.univ : Finset (Fin m))
        (fun i => (M (τ i) i).natDegree) d (fun i _ => hM _ _)
      simpa using this
    rcases Int.units_eq_one_or (Equiv.Perm.sign τ) with h | h
    · rw [h, one_smul]; exact hprod
    · rw [h, Units.neg_smul, one_smul, Polynomial.natDegree_neg]; exact hprod
  have t3 : ∀ {R : Type u} [Semiring R] (f g : Polynomial R) (m n : ℕ) (i j : Fin (m + n)),
      Polynomial.sylvester f g m n i j = 0 ∨ (∃ k, Polynomial.sylvester f g m n i j = f.coeff k) ∨
        (∃ k, Polynomial.sylvester f g m n i j = g.coeff k) := by
    intro R _ f g m n i j
    unfold Polynomial.sylvester
    rw [Matrix.of_apply]
    refine Fin.addCases (fun j₁ => ?_) (fun j₁ => ?_) j
    · rw [Fin.addCases_left]
      split_ifs
      · exact Or.inr (Or.inr ⟨_, rfl⟩)
      · exact Or.inl rfl
    · rw [Fin.addCases_right]
      split_ifs
      · exact Or.inr (Or.inl ⟨_, rfl⟩)
      · exact Or.inl rfl
  have t4 : ∀ {R : Type u} [CommRing R] [IsDomain R] (β : G → R) (h : Polynomial R) (n : ℕ),
      h.natDegree ≤ n →
      Polynomial.resultant (∏ i, (Polynomial.X - Polynomial.C (β i))) h (Fintype.card G) n =
        ∏ i, h.eval (β i) := by
    intro R _ _ β h n hn
    have ha : (∏ i, (Polynomial.X - Polynomial.C (β i))).natDegree = Fintype.card G := by
      rw [Polynomial.natDegree_finsetProd_X_sub_C_eq_card, Finset.card_univ]
    have hb : (∏ i, (Polynomial.X - Polynomial.C (β i))).Splits :=
      Polynomial.Splits.prod (fun i _ => Polynomial.Splits.X_sub_C _)
    have hc : (∏ i, (Polynomial.X - Polynomial.C (β i))).leadingCoeff = 1 :=
      (Polynomial.monic_prod_of_monic _ _ (fun i _ => Polynomial.monic_X_sub_C _)).leadingCoeff
    have hd : (∏ i, (Polynomial.X - Polynomial.C (β i))).roots =
        Multiset.map β Finset.univ.val := by
      have : (∏ i, (Polynomial.X - Polynomial.C (β i))) =
          (Multiset.map (fun a => Polynomial.X - Polynomial.C a)
            (Multiset.map β Finset.univ.val)).prod := by
        rw [Finset.prod_eq_multiset_prod, Multiset.map_map]; rfl
      rw [this, Polynomial.roots_multiset_prod_X_sub_C]
    have key := Polynomial.resultant_eq_prod_eval
      (∏ i, (Polynomial.X - Polynomial.C (β i))) h n hn hb
    rw [ha, hc, one_pow, one_mul, hd, Multiset.map_map] at key
    rw [key]
    exact Finset.prod_map_val _ _
  have t5 : ∀ {R : Type u} [CommRing R] [IsDomain R] (A : G → R),
      Polynomial.resultant (∏ i, (Polynomial.X - Polynomial.C (A i)))
        (Polynomial.derivative (∏ i, (Polynomial.X - Polynomial.C (A i)))) (Fintype.card G)
        (Fintype.card G - 1) =
      ∏ p ∈ (Finset.univ : Finset G).offDiag, (A p.1 - A p.2) := by
    intro R _ _ A
    have hdeg : (Polynomial.derivative (∏ i, (Polynomial.X - Polynomial.C (A i)))).natDegree ≤
        Fintype.card G - 1 := by
      refine (Polynomial.natDegree_derivative_le _).trans ?_
      rw [Polynomial.natDegree_finsetProd_X_sub_C_eq_card, Finset.card_univ]
    rw [t4 A _ _ hdeg]
    have hnodal : (∏ i, (Polynomial.X - Polynomial.C (A i))) = Lagrange.nodal Finset.univ A := rfl
    have hev : ∀ i, (Polynomial.derivative (∏ i, (Polynomial.X - Polynomial.C (A i)))).eval (A i) =
        ∏ j ∈ Finset.univ.erase i, (A i - A j) := by
      intro i
      rw [hnodal, Lagrange.eval_nodal_derivative_eval_node_eq (Finset.mem_univ i),
        Lagrange.eval_nodal]
    rw [Finset.prod_congr rfl (fun i _ => hev i)]
    refine (Finset.prod_finset_product _ _ _ ?_ (f := fun p => A p.1 - A p.2)).symm
    intro p
    simp [Finset.mem_offDiag, Finset.mem_erase, ne_comm]
  have t6 : ∀ (p : MvPolynomial (Fin 2) (AlgebraicClosure K)) (j : ℕ),
      ((MvPolynomial.aeval ![Polynomial.C Polynomial.X, Polynomial.X] p :
        Polynomial (Polynomial (AlgebraicClosure K))).coeff j).natDegree ≤ p.totalDegree := by
    intro p j
    conv_lhs => rw [MvPolynomial.as_sum p]
    rw [map_sum, Polynomial.finsetSum_coeff]
    refine Polynomial.natDegree_sum_le_of_forall_le _ _ fun s hs => ?_
    have hs0 : s 0 ≤ p.totalDegree := by
      refine le_trans ?_ (MvPolynomial.le_totalDegree hs)
      rw [Finsupp.sum_fintype _ _ (by simp), Fin.sum_univ_two]
      omega
    rw [MvPolynomial.aeval_monomial, Finsupp.prod_fintype _ _ (by simp), Fin.prod_univ_two]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one,
      Polynomial.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
    rw [← Polynomial.C_pow, ← mul_assoc, ← Polynomial.C_mul, Polynomial.coeff_C_mul_X_pow]
    split_ifs
    · exact (Polynomial.natDegree_C_mul_X_pow_le _ _).trans hs0
    · rw [Polynomial.natDegree_zero]; exact Nat.zero_le _
  have t7 : ∀ (a : Polynomial K),
      (Polynomial.eval₂ (MvPolynomial.C.comp (algebraMap K (AlgebraicClosure K)))
        (MvPolynomial.X 0 : MvPolynomial (Fin 2) (AlgebraicClosure K)) a).totalDegree
        ≤ a.natDegree := by
    intro a
    rw [Polynomial.eval₂_eq_sum_range]
    refine (MvPolynomial.totalDegree_finsetSum _ _).trans (Finset.sup_le fun i hi => ?_)
    refine (MvPolynomial.totalDegree_mul _ _).trans ?_
    rw [RingHom.comp_apply, MvPolynomial.totalDegree_C, MvPolynomial.totalDegree_X_pow, zero_add]
    exact Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)

  obtain ⟨ιS, hιS⟩ : ∃ φ : Polynomial K →+* MvPolynomial (Fin 2) (AlgebraicClosure K),
      φ = Polynomial.eval₂RingHom (MvPolynomial.C.comp (algebraMap K (AlgebraicClosure K)))
        (MvPolynomial.X 0) := ⟨_, rfl⟩
  have hιSdeg : ∀ a : Polynomial K, (ιS a).totalDegree ≤ a.natDegree := by
    intro a; rw [hιS, Polynomial.coe_eval₂RingHom]; exact t7 a
  obtain ⟨dU, hdU⟩ : ∃ dU : Polynomial (Polynomial K) → ℕ,
      ∀ p j, (p.coeff j).natDegree ≤ dU p := by
    refine ⟨fun p => ∑ j ∈ p.support, (p.coeff j).natDegree, fun p j => ?_⟩
    by_cases hj : j ∈ p.support
    · exact Finset.single_le_sum (f := fun j => (p.coeff j).natDegree)
        (fun _ _ => Nat.zero_le _) hj
    · rw [Polynomial.mem_support_iff, not_not] at hj
      rw [hj, Polynomial.natDegree_zero]; exact Nat.zero_le _
  obtain ⟨n₀, hn₀⟩ : ∃ n₀ : ℕ, ∀ k, (P k).natDegree ≤ n₀ :=
    ⟨Finset.univ.sup (fun k => (P k).natDegree),
      fun k => Finset.le_sup (f := fun k => (P k).natDegree) (Finset.mem_univ k)⟩
  obtain ⟨δ, hδ1, hδf, hδP⟩ : ∃ δ : ℕ, 1 ≤ δ ∧ dU f ≤ δ ∧ ∀ k, dU (P k) ≤ δ := by
    refine ⟨1 + dU f + ∑ k, dU (P k), by omega, by omega, fun k => ?_⟩
    have : dU (P k) ≤ ∑ k, dU (P k) :=
      Finset.single_le_sum (f := fun k => dU (P k)) (fun _ _ => Nat.zero_le _)
        (Finset.mem_univ k)
    omega
  refine ⟨(Fintype.card G + n₀) * δ +
    (Fintype.card G + (Fintype.card G - 1)) * ((Fintype.card G + n₀) * δ), fun c => ?_⟩
  obtain ⟨fS, hfS⟩ : ∃ q : Polynomial (MvPolynomial (Fin 2) (AlgebraicClosure K)),
      q = f.map ιS := ⟨_, rfl⟩
  obtain ⟨gS, hgS⟩ : ∃ q : Polynomial (MvPolynomial (Fin 2) (AlgebraicClosure K)),
      q = Polynomial.C (MvPolynomial.X 1) -
        ∑ k, Polynomial.C (MvPolynomial.C (c k)) * (P k).map ιS := ⟨_, rfl⟩
  have hfSc : ∀ j, (fS.coeff j).totalDegree ≤ δ := by
    intro j; rw [hfS, Polynomial.coeff_map]; exact (hιSdeg _).trans ((hdU f j).trans hδf)
  have hgSc : ∀ j, (gS.coeff j).totalDegree ≤ δ := by
    intro j
    rw [hgS, Polynomial.coeff_sub, Polynomial.finsetSum_coeff]
    refine (MvPolynomial.totalDegree_sub _ _).trans (max_le ?_ ?_)
    · rw [Polynomial.coeff_C]
      split_ifs
      · rw [MvPolynomial.totalDegree_X]; exact hδ1
      · rw [MvPolynomial.totalDegree_zero]; exact Nat.zero_le _
    · refine (MvPolynomial.totalDegree_finsetSum _ _).trans (Finset.sup_le fun k _ => ?_)
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_map]
      refine (MvPolynomial.totalDegree_mul _ _).trans ?_
      rw [MvPolynomial.totalDegree_C, zero_add]
      exact (hιSdeg _).trans ((hdU _ j).trans (hδP k))
  have hgSd : gS.natDegree ≤ n₀ := by
    rw [hgS]
    refine (Polynomial.natDegree_sub_le _ _).trans (max_le ?_ ?_)
    · rw [Polynomial.natDegree_C]; exact Nat.zero_le _
    · refine Polynomial.natDegree_sum_le_of_forall_le _ _ fun k _ => ?_
      exact (Polynomial.natDegree_C_mul_le _ _).trans (Polynomial.natDegree_map_le.trans (hn₀ k))
  obtain ⟨Rm, hRm⟩ : ∃ r : MvPolynomial (Fin 2) (AlgebraicClosure K),
      r = Polynomial.resultant fS gS (Fintype.card G) n₀ := ⟨_, rfl⟩
  have hRmdeg : Rm.totalDegree ≤ (Fintype.card G + n₀) * δ := by
    rw [hRm]
    exact t1 _ _ (Polynomial.sylvester fS gS _ _) (fun i j => by
      rcases t3 fS gS _ _ i j with h | ⟨k, h⟩ | ⟨k, h⟩
      · rw [h, MvPolynomial.totalDegree_zero]; exact Nat.zero_le _
      · rw [h]; exact hfSc k
      · rw [h]; exact hgSc k)
  obtain ⟨ψ, hψ⟩ : ∃ ψ : MvPolynomial (Fin 2) (AlgebraicClosure K) →ₐ[AlgebraicClosure K]
      Polynomial (Polynomial (AlgebraicClosure K)),
      ψ = MvPolynomial.aeval (![Polynomial.C Polynomial.X, Polynomial.X] :
        Fin 2 → Polynomial (Polynomial (AlgebraicClosure K))) := ⟨_, rfl⟩
  obtain ⟨Rb, hRb⟩ : ∃ r : Polynomial (Polynomial (AlgebraicClosure K)),
      r = ψ Rm := ⟨_, rfl⟩
  obtain ⟨D, hD⟩ : ∃ d : Polynomial (AlgebraicClosure K),
      d = Polynomial.resultant Rb (Polynomial.derivative Rb) (Fintype.card G)
        (Fintype.card G - 1) := ⟨_, rfl⟩
  have hRbc : ∀ j, (Rb.coeff j).natDegree ≤ (Fintype.card G + n₀) * δ := fun j => by
    rw [hRb, hψ]; exact (t6 Rm j).trans hRmdeg
  have hRb'c : ∀ j, ((Polynomial.derivative Rb).coeff j).natDegree ≤
      (Fintype.card G + n₀) * δ := by
    intro j
    rw [Polynomial.coeff_derivative]
    refine Polynomial.natDegree_mul_le.trans ?_
    have : ((j : Polynomial (AlgebraicClosure K)) + 1).natDegree = 0 := by
      rw [← Nat.cast_succ, Polynomial.natDegree_natCast]
    rw [this, add_zero]; exact hRbc _
  have hDdeg : D.natDegree ≤
      (Fintype.card G + (Fintype.card G - 1)) * ((Fintype.card G + n₀) * δ) := by
    rw [hD]
    exact t2 _ _ (Polynomial.sylvester Rb (Polynomial.derivative Rb) _ _) (fun i j => by
      rcases t3 Rb (Polynomial.derivative Rb) _ _ i j with h | ⟨k, h⟩ | ⟨k, h⟩
      · rw [h, Polynomial.natDegree_zero]; exact Nat.zero_le _
      · rw [h]; exact hRbc k
      · rw [h]; exact hRb'c k)
  refine ⟨Rm, D, hRmdeg.trans (Nat.le_add_right _ _), hDdeg.trans (Nat.le_add_left _ _), ?_⟩

  intro E _ _ x β hβ
  obtain ⟨χ, hχ⟩ : ∃ χ : MvPolynomial (Fin 2) (AlgebraicClosure K) →+* Polynomial E,
      χ = (MvPolynomial.aeval ![Polynomial.C x, Polynomial.X]).toRingHom := ⟨_, rfl⟩
  have hχC : ∀ r, χ (MvPolynomial.C r) = Polynomial.C (algebraMap (AlgebraicClosure K) E r) := by
    intro r; rw [hχ]; simp [Polynomial.algebraMap_apply]
  have hχX0 : χ (MvPolynomial.X 0) = Polynomial.C x := by rw [hχ]; simp
  have hχX1 : χ (MvPolynomial.X 1) = Polynomial.X := by rw [hχ]; simp
  have hχA : ∀ r, MvPolynomial.aeval ![Polynomial.C x, Polynomial.X] r = χ r := by
    intro r; rw [hχ]; rfl
  have hχι : χ.comp ιS = Polynomial.C.comp (Polynomial.eval₂RingHom
      ((algebraMap (AlgebraicClosure K) E).comp (algebraMap K (AlgebraicClosure K))) x) := by
    apply Polynomial.ringHom_ext
    · intro a
      simp only [RingHom.comp_apply, hιS, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hχC]
    · simp only [RingHom.comp_apply, hιS, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, hχX0]
  have hfχ : fS.map χ = ∏ g, (Polynomial.X - Polynomial.C (Polynomial.C (β g))) := by
    rw [hfS, Polynomial.map_map, hχι, ← Polynomial.map_map, hβ, Polynomial.map_prod]
    simp only [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
  have hgev : ∀ b : E, (gS.map χ).eval (Polynomial.C b) = Polynomial.X - Polynomial.C
      (∑ k, algebraMap (AlgebraicClosure K) E (c k) * Polynomial.eval₂ (Polynomial.eval₂RingHom
        ((algebraMap (AlgebraicClosure K) E).comp (algebraMap K (AlgebraicClosure K))) x)
        b (P k)) := by
    intro b
    rw [hgS, Polynomial.eval_map, Polynomial.eval₂_sub, Polynomial.eval₂_C, hχX1,
      Polynomial.eval₂_finsetSum, map_sum]
    congr 1
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, hχC, Polynomial.eval₂_map, hχι,
      ← Polynomial.hom_eval₂ (P k) _ Polynomial.C b, Polynomial.C_mul]
  have hspec1 : χ Rm = ∏ g, (Polynomial.X - Polynomial.C
      (∑ k, algebraMap (AlgebraicClosure K) E (c k) * Polynomial.eval₂ (Polynomial.eval₂RingHom
        ((algebraMap (AlgebraicClosure K) E).comp (algebraMap K (AlgebraicClosure K))) x)
        (β g) (P k))) := by
    rw [hRm, ← Polynomial.resultant_map_map, hfχ]
    refine (t4 (fun g => Polynomial.C (β g)) _ _
      (Polynomial.natDegree_map_le.trans hgSd)).trans ?_
    exact Finset.prod_congr rfl fun g _ => hgev (β g)
  obtain ⟨evx, hevx⟩ : ∃ e : Polynomial (AlgebraicClosure K) →+* E,
      e = (Polynomial.aeval x).toRingHom := ⟨_, rfl⟩
  have hRbmap : Rb.map evx = χ Rm := by
    have hcomp : (Polynomial.mapRingHom evx).comp ψ.toRingHom = χ := by
      apply MvPolynomial.ringHom_ext
      · intro r
        rw [hχC, hevx, hψ]
        simp
      · refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
        · rw [hχX0, hevx, hψ]; simp
        · rw [hχX1, hevx, hψ]; simp
    rw [hRb, ← hcomp]; rfl
  refine ⟨by rw [hχA]; exact hspec1, ?_⟩
  have hev : Polynomial.aeval x D = evx D := by rw [hevx]; rfl
  rw [hev, hD, ← Polynomial.resultant_map_map, ← Polynomial.derivative_map, hRbmap, hspec1]
  exact t5 (fun g => ∑ k, algebraMap (AlgebraicClosure K) E (c k) *
    Polynomial.eval₂ (Polynomial.eval₂RingHom
      ((algebraMap (AlgebraicClosure K) E).comp (algebraMap K (AlgebraicClosure K))) x)
      (β g) (P k))

theorem wc_fetg_twist_vector (K : Type u) [Field K] [Finite K] (n : ℕ) (hn : 1 ≤ n) (G : Type)
    [Group G] [Fintype G] [DecidableEq G] (g₀ : G) (E : Type u) [Field E]
    [Algebra (AlgebraicClosure K) E] (W : Finset (G → E)) (hW0 : ∀ w ∈ W, w ≠ 0)
    (hWq : W.card < Nat.card K ^ n) :
    ∃ c : G → AlgebraicClosure K, (∀ k, c k ^ (Nat.card K ^ n) = c (g₀ * k)) ∧
      ∀ w ∈ W, ∑ k, algebraMap (AlgebraicClosure K) E (c k) * w k ≠ 0 :=
by
  classical
  have hfield : ∃ (L : Type u) (_ : Field L) (_ : Fintype L), Nat.card L = Nat.card K ^ n ∧
      Nonempty (AlgebraicClosure L →+* AlgebraicClosure K) := by
    haveI : Fact (Nat.Prime (ringChar K)) := ⟨CharP.char_is_prime K (ringChar K)⟩
    haveI : NeZero n := ⟨by omega⟩
    haveI : Module.Finite K (ULift.{u} (FiniteField.Extension K (ringChar K) n)) :=
      Module.Finite.equiv (ULift.moduleEquiv (R := K)).symm
    haveI : Finite (ULift.{u} (FiniteField.Extension K (ringChar K) n)) := Module.finite_of_finite K
    refine ⟨ULift.{u} (FiniteField.Extension K (ringChar K) n), inferInstance,
      Fintype.ofFinite _, ?_, ⟨?_⟩⟩
    · rw [Module.natCard_eq_pow_finrank (K := K), LinearEquiv.finrank_eq (ULift.moduleEquiv (R := K)),
        FiniteField.finrank_extension K (ringChar K) n]
    · exact (IsAlgClosed.lift : AlgebraicClosure (ULift.{u} (FiniteField.Extension K (ringChar K) n))
        →ₐ[K] AlgebraicClosure K).toRingHom
  obtain ⟨L, _, _, hL, ⟨φ⟩⟩ := hfield
  letI : Algebra (AlgebraicClosure L) E := ((algebraMap (AlgebraicClosure K) E).comp φ).toAlgebra
  have halg : ∀ x, algebraMap (AlgebraicClosure L) E x = algebraMap (AlgebraicClosure K) E (φ x) :=
    fun x => rfl
  let e : G ≃ Fin (Fintype.card G) := Fintype.equivFin G
  let σ : Equiv.Perm (Fin (Fintype.card G)) := e.symm.trans ((Equiv.mulLeft g₀).trans e)
  have hσ : ∀ k, σ (e k) = e (g₀ * k) := by
    intro k
    simp [σ]
  let W' : Finset (Fin (Fintype.card G) → E) := W.image (fun w => w ∘ e.symm)
  have hW0' : ∀ v ∈ W', v ≠ 0 := by
    intro v hv hv0
    obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hv
    apply hW0 w hw
    funext k
    have := congrFun hv0 (e k)
    simpa using this
  have hWq' : W'.card < Nat.card L := by
    rw [hL]; exact lt_of_le_of_lt Finset.card_image_le hWq
  obtain ⟨c', hc', hc'W⟩ := lw_twist_vector_exists L (Fintype.card G) σ E W' hW0' hWq'
  refine ⟨fun k => φ (c' (e k)), ?_, ?_⟩
  · intro k
    show φ (c' (e k)) ^ (Nat.card K ^ n) = φ (c' (e (g₀ * k)))
    rw [← map_pow, ← hL, hc', hσ]
  · intro w hw
    have h1 := hc'W (w ∘ e.symm) (Finset.mem_image_of_mem _ hw)
    have hsum : ∑ i, algebraMap (AlgebraicClosure L) E (c' i) * (w ∘ e.symm) i =
        ∑ k, algebraMap (AlgebraicClosure K) E (φ (c' (e k))) * w k := by
      rw [← Equiv.sum_comp e]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [halg, Function.comp_apply, Equiv.symm_apply_apply]
    intro h0
    apply h1
    rw [hsum]
    exact h0

theorem wc_fetg_orbit_factor (K : Type u) [Field K] [Fintype K] (G : Type) [Group G] [Fintype G]
    [DecidableEq G] (h : Polynomial K) (e : ℕ) (f : Polynomial (Polynomial K))
    (P : G → Polynomial (Polynomial K)) (n : ℕ) (hn : 1 ≤ n) (g₀ : G)
    (r : G → lwtrGenField (AlgebraicClosure K)) (H : Subgroup G) (ρ : G)
    (Φ : lwtrGenField (AlgebraicClosure K) ≃+* lwtrGenField (AlgebraicClosure K))
    (hr : Function.Injective r) (hh : wcFetgHO K h ≠ 0)
    (hfr : Polynomial.map (Polynomial.eval₂RingHom (wcFetgIota K) (wcFetgU K)) f =
      ∏ g, (Polynomial.X - Polynomial.C (r g)))
    (hPr : ∀ g k, wcFetgEvO K (P k) (r g) = wcFetgHO K h ^ e * r (g * k))
    (hΦc : ∀ a : AlgebraicClosure K,
      Φ (algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) a) =
        algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (a ^ Nat.card K))
    (hΦu : Φ (wcFetgU K) = wcFetgU K)
    (hΦr : ∀ g, Φ (r g) = r (ρ * g))
    (hH1 : ∀ τ : lwtrGenField (AlgebraicClosure K) ≃ₐ[RatFunc (AlgebraicClosure K)]
      lwtrGenField (AlgebraicClosure K), ∃ γ ∈ H, ∀ g, τ (r g) = r (γ * g))
    (hH2 : ∀ γ ∈ H, ∃ τ : lwtrGenField (AlgebraicClosure K) ≃ₐ[RatFunc (AlgebraicClosure K)]
      lwtrGenField (AlgebraicClosure K), ∀ g, τ (r g) = r (γ * g))
    (hρH : ∀ γ, ρ * γ * ρ⁻¹ ∈ H ↔ γ ∈ H)
    (hΦev : ∀ Pm : MvPolynomial (Fin 2) (AlgebraicClosure K),
      Polynomial.map (Φ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K))
          (lwtrGenEv (AlgebraicClosure K) Pm) =
        lwtrGenEv (AlgebraicClosure K) (MvPolynomial.map (lwtrFrob K) Pm))
    (hint : ∀ g, IsIntegral (Polynomial (AlgebraicClosure K)) (r g))
    (γ₀ : G) (hγ₀ : γ₀ ∈ H) (hg₀ : g₀ = γ₀ * ρ ^ n)
    (c : G → AlgebraicClosure K) (hc : ∀ k, c k ^ (Nat.card K ^ n) = c (g₀ * k))
    (hθ : Function.Injective (fun g => ∑ k,
      algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (c k) *
        wcFetgEvO K (P k) (r g)))
    (Rm : MvPolynomial (Fin 2) (AlgebraicClosure K))
    (hR : lwtrGenEv (AlgebraicClosure K) Rm = ∏ g, (Polynomial.X - Polynomial.C (∑ k,
      algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (c k) *
        wcFetgEvO K (P k) (r g)))) :
    ∃ P' : MvPolynomial (Fin 2) (AlgebraicClosure K), Irreducible P' ∧ P' ∣ Rm ∧
      (∀ m, P'.coeff m ^ (Nat.card K ^ n) = P'.coeff m) ∧ P'.totalDegree ≤ Rm.totalDegree :=
by
  classical

  have hcrux : ∀ (F : Type u) [Field F] (H' : Subgroup G)
      (θ : G → lwtrGenField F) (_ : Function.Injective θ)
      (_ : ∀ g, IsIntegral (Polynomial F) (θ g))
      (_ : ∀ τ : lwtrGenField F ≃ₐ[RatFunc F] lwtrGenField F,
        ∃ γ ∈ H', ∀ g, τ (θ g) = θ (γ * g))
      (_ : ∀ γ ∈ H', ∃ τ : lwtrGenField F ≃ₐ[RatFunc F] lwtrGenField F,
        ∀ g, τ (θ g) = θ (γ * g))
      (R : MvPolynomial (Fin 2) F)
      (_ : lwtrGenEv F R = ∏ g, (Polynomial.X - Polynomial.C (θ g))),
      ∃ P : MvPolynomial (Fin 2) F, Irreducible P ∧ P ∣ R ∧
        lwtrGenEv F P = ∏ γ : H', (Polynomial.X - Polynomial.C (θ (γ : G))) ∧
        Function.Injective (lwtrGenEv F) := by
    intro F _ H' θ hθinj hθint hK1 hK2 R hRθ
    obtain ⟨φ, hφd⟩ : ∃ φ : MvPolynomial (Fin 2) F →ₐ[F] Polynomial (Polynomial F),
        φ = MvPolynomial.aeval (R := F)
          (![Polynomial.C Polynomial.X, Polynomial.X] : Fin 2 → Polynomial (Polynomial F)) :=
      ⟨_, rfl⟩
    have hA : ∀ P : MvPolynomial (Fin 2) F, lwtrGenEv F P =
        Polynomial.map (algebraMap (Polynomial F) (lwtrGenField F)) (φ P) := by
      intro P
      rw [hφd]
      induction P using MvPolynomial.induction_on with
      | C a =>
        simp only [MvPolynomial.aeval_C, Polynomial.algebraMap_apply, Polynomial.map_C]
        rw [IsScalarTower.algebraMap_apply F (Polynomial F) (lwtrGenField F)]
        rfl
      | add p q hp hq => rw [map_add, map_add, hp, hq, Polynomial.map_add]
      | mul_X p i hp =>
        rw [map_mul, map_mul, hp, Polynomial.map_mul]
        congr 1
        fin_cases i
        · simp only [MvPolynomial.aeval_X]
          simp [Polynomial.map_C]
          rw [IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) (lwtrGenField F),
            RatFunc.algebraMap_X]
        · simp [MvPolynomial.aeval_X]
    have hB : Function.Bijective φ := by
      let inner : Polynomial F →+* MvPolynomial (Fin 2) F :=
        Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0)
      let ψ : Polynomial (Polynomial F) →+* MvPolynomial (Fin 2) F :=
        Polynomial.eval₂RingHom inner (MvPolynomial.X 1)
      have h1 : ψ.comp φ.toRingHom = RingHom.id _ := by
        apply MvPolynomial.ringHom_ext
        · intro a
          simp [ψ, inner, hφd, Polynomial.algebraMap_apply]
        · intro i
          fin_cases i <;> simp [ψ, inner, hφd]
      have h2inner : φ.toRingHom.comp inner = Polynomial.C := by
        apply Polynomial.ringHom_ext
        · intro b
          simp [inner, hφd, Polynomial.algebraMap_apply]
        · simp [inner, hφd]
      have h2 : φ.toRingHom.comp ψ = RingHom.id _ := by
        apply Polynomial.ringHom_ext
        · intro a
          have := congrArg (fun f => f a) h2inner
          simpa [ψ] using this
        · simp [ψ, hφd]
      refine ⟨fun p q hpq => ?_, fun Q => ⟨ψ Q, ?_⟩⟩
      · have hp := congrArg (fun f => f p) h1
        have hq := congrArg (fun f => f q) h1
        simp only [RingHom.comp_apply, RingHom.id_apply, AlgHom.toRingHom_eq_coe,
          RingHom.coe_coe] at hp hq
        rw [← hp, ← hq, hpq]
      · have := congrArg (fun f => f Q) h2
        simpa using this
    have hscal : algebraMap (Polynomial F) (lwtrGenField F) =
        (algebraMap (RatFunc F) (lwtrGenField F)).comp (algebraMap (Polynomial F) (RatFunc F)) :=
      IsScalarTower.algebraMap_eq _ _ _
    have hAinj : Function.Injective (algebraMap (Polynomial F) (lwtrGenField F)) := by
      rw [hscal]
      exact (algebraMap (RatFunc F) (lwtrGenField F)).injective.comp (RatFunc.algebraMap_injective F)
    have hevinj : Function.Injective (lwtrGenEv F) := by
      intro p q hpq
      rw [hA, hA] at hpq
      exact hB.1 (Polynomial.map_injective _ hAinj hpq)
    have hψ : Polynomial.map (algebraMap (RatFunc F) (lwtrGenField F))
        (Polynomial.map (algebraMap (Polynomial F) (RatFunc F)) (φ R)) =
        ∏ g, (Polynomial.X - Polynomial.C (θ g)) := by
      rw [Polynomial.map_map, ← hscal, ← hA R, hRθ]
    have ht : IsIntegral (Polynomial F) (θ 1) := hθint 1
    have htL : IsIntegral (RatFunc F) (θ 1) := ht.tower_top
    have hμmonic := minpoly.monic htL
    have hμirr := minpoly.irreducible htL
    have haevψ : Polynomial.aeval (θ 1)
        (Polynomial.map (algebraMap (Polynomial F) (RatFunc F)) (φ R)) = 0 := by
      rw [← Polynomial.eval_map_algebraMap, hψ, Polynomial.eval_prod]
      exact Finset.prod_eq_zero (Finset.mem_univ 1) (by simp)
    have hμψ := minpoly.dvd (RatFunc F) (θ 1) haevψ
    have hψsep : (Polynomial.map (algebraMap (Polynomial F) (RatFunc F)) (φ R)).Separable := by
      rw [← Polynomial.separable_map (algebraMap (RatFunc F) (lwtrGenField F)), hψ]
      exact Polynomial.separable_prod_X_sub_C_iff.mpr hθinj
    obtain ⟨μM, hμMd⟩ : ∃ p : Polynomial (lwtrGenField F),
        p = Polynomial.map (algebraMap (RatFunc F) (lwtrGenField F)) (minpoly (RatFunc F) (θ 1)) :=
      ⟨_, rfl⟩
    have hμMmonic : μM.Monic := by rw [hμMd]; exact hμmonic.map _
    have hμM0 : μM ≠ 0 := hμMmonic.ne_zero
    have hnodup : μM.roots.Nodup := by
      rw [hμMd]; exact Polynomial.nodup_roots ((hψsep.of_dvd hμψ).map)
    have hmemroots : ∀ a, a ∈ μM.roots ↔ ∃ γ : H', θ (γ : G) = a := by
      intro a
      rw [Polynomial.mem_roots hμM0, Polynomial.IsRoot.def, hμMd, Polynomial.eval_map_algebraMap]
      constructor
      · intro ha
        have h1 : minpoly (RatFunc F) (θ 1) = minpoly (RatFunc F) a :=
          minpoly.eq_of_irreducible_of_monic hμirr ha hμmonic
        have h2 := (Normal.minpoly_eq_iff_mem_orbit (lwtrGenField F)).mp h1.symm
        obtain ⟨τ, hτ⟩ := MulAction.mem_orbit_iff.mp h2
        obtain ⟨γ, hγ, hx⟩ := hK1 τ
        refine ⟨⟨γ, hγ⟩, ?_⟩
        show θ γ = a
        rw [← hτ, AlgEquiv.smul_def, hx 1, mul_one]
      · rintro ⟨⟨γ, hγ⟩, rfl⟩
        obtain ⟨τ, hx⟩ := hK2 γ hγ
        have hx1 := hx 1
        rw [mul_one] at hx1
        show Polynomial.aeval (θ γ) (minpoly (RatFunc F) (θ 1)) = 0
        rw [← hx1, Polynomial.aeval_algHom_apply, minpoly.aeval, map_zero]
    have hinj : Function.Injective (fun γ : H' => θ (γ : G)) := by
      intro a b hab
      exact Subtype.ext (hθinj hab)
    have hroots : μM.roots = Multiset.map (fun γ : H' => θ (γ : G)) Finset.univ.val := by
      rw [Multiset.Nodup.ext hnodup (Multiset.Nodup.map hinj Finset.univ.nodup)]
      intro a
      rw [hmemroots, Multiset.mem_map]
      simp
    have hsplit : μM.roots.card = μM.natDegree :=
      Polynomial.splits_iff_card_roots.mp (IsAlgClosed.splits μM)
    have hμMprod : μM = ∏ γ : H', (Polynomial.X - Polynomial.C (θ (γ : G))) := by
      rw [← Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hμMmonic hsplit, hroots,
        Multiset.map_map, Finset.prod_eq_multiset_prod]
      rfl
    have hQmonic := minpoly.monic ht
    have hQL : minpoly (RatFunc F) (θ 1) = Polynomial.map (algebraMap (Polynomial F) (RatFunc F))
        (minpoly (Polynomial F) (θ 1)) :=
      minpoly.isIntegrallyClosed_eq_field_fractions' (RatFunc F) ht
    have hQirr : Irreducible (minpoly (Polynomial F) (θ 1)) :=
      (hQmonic.irreducible_iff_irreducible_map_fraction_map (K := RatFunc F)).mpr
        (by rw [← hQL]; exact hμirr)
    obtain ⟨P, hφP⟩ := hB.2 (minpoly (Polynomial F) (θ 1))
    have hPirr : Irreducible P := by
      apply (MulEquiv.irreducible_iff (AlgEquiv.ofBijective φ hB) (x := P)).mp
      rw [AlgEquiv.ofBijective_apply, hφP]
      exact hQirr
    have hPev' : lwtrGenEv F P = μM := by
      rw [hA P, hφP, hscal, ← Polynomial.map_map, ← hQL, hμMd]
    have hQdvd : minpoly (Polynomial F) (θ 1) ∣ φ R := by
      rw [← Polynomial.map_dvd_map (algebraMap (Polynomial F) (RatFunc F))
        (RatFunc.algebraMap_injective F) hQmonic, ← hQL]
      exact hμψ
    obtain ⟨D', hD'⟩ := hQdvd
    obtain ⟨D, hD⟩ := hB.2 D'
    refine ⟨P, hPirr, ⟨D, hB.1 ?_⟩, ?_, hevinj⟩
    · rw [map_mul, hD, hφP, ← hD']
    · rw [hPev', hμMprod]

  obtain ⟨θ, hθd⟩ : ∃ θ : G → lwtrGenField (AlgebraicClosure K), θ = fun g => ∑ k,
      algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (c k) *
        wcFetgEvO K (P k) (r g) := ⟨_, rfl⟩
  have hθ' : Function.Injective θ := by rw [hθd]; exact hθ
  have hR' : lwtrGenEv (AlgebraicClosure K) Rm =
      ∏ g, (Polynomial.X - Polynomial.C (θ g)) := by rw [hR, hθd]
  have hθform : ∀ g, θ g = ∑ k,
      algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (c k) *
        (wcFetgHO K h ^ e * r (g * k)) := by
    intro g
    rw [hθd]
    exact Finset.sum_congr rfl fun k _ => by rw [hPr]

  have hhOfix : ∀ σ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K),
      σ.comp (wcFetgIota K) = wcFetgIota K → σ (wcFetgU K) = wcFetgU K →
      σ (wcFetgHO K h) = wcFetgHO K h := by
    intro σ h1 h2
    show σ (Polynomial.eval₂ (wcFetgIota K) (wcFetgU K) h) =
      Polynomial.eval₂ (wcFetgIota K) (wcFetgU K) h
    rw [Polynomial.hom_eval₂, h1, h2]

  have hconstτ : ∀ (τ : lwtrGenField (AlgebraicClosure K) ≃ₐ[RatFunc (AlgebraicClosure K)]
      lwtrGenField (AlgebraicClosure K)) (a : AlgebraicClosure K),
      τ (algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) a) =
        algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) a := by
    intro τ a
    rw [IsScalarTower.algebraMap_apply (AlgebraicClosure K) (RatFunc (AlgebraicClosure K))
      (lwtrGenField (AlgebraicClosure K)), AlgEquiv.commutes]
  have hhOτ : ∀ (τ : lwtrGenField (AlgebraicClosure K) ≃ₐ[RatFunc (AlgebraicClosure K)]
      lwtrGenField (AlgebraicClosure K)), τ (wcFetgHO K h) = wcFetgHO K h := by
    intro τ
    have h1 : (τ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K)).comp
        (wcFetgIota K) = wcFetgIota K := by
      apply RingHom.ext
      intro k
      show τ (algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K))
          (algebraMap K (AlgebraicClosure K) k)) =
        algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K))
          (algebraMap K (AlgebraicClosure K) k)
      exact hconstτ τ _
    have h2 : (τ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K))
        (wcFetgU K) = wcFetgU K := AlgEquiv.commutes τ _
    exact hhOfix _ h1 h2
  have hθτ : ∀ (τ : lwtrGenField (AlgebraicClosure K) ≃ₐ[RatFunc (AlgebraicClosure K)]
      lwtrGenField (AlgebraicClosure K)) (γ : G), (∀ g, τ (r g) = r (γ * g)) →
      ∀ g, τ (θ g) = θ (γ * g) := by
    intro τ γ hτ g
    rw [hθform, hθform, map_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [map_mul, map_mul, map_pow, hconstτ, hhOτ τ, hτ, mul_assoc]

  have hconstint : ∀ a : AlgebraicClosure K, IsIntegral (Polynomial (AlgebraicClosure K))
      (algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) a) := by
    intro a
    rw [IsScalarTower.algebraMap_apply (AlgebraicClosure K) (Polynomial (AlgebraicClosure K))
      (lwtrGenField (AlgebraicClosure K))]
    exact isIntegral_algebraMap
  have huint : IsIntegral (Polynomial (AlgebraicClosure K)) (wcFetgU K) := by
    have hu : wcFetgU K = algebraMap (Polynomial (AlgebraicClosure K))
        (lwtrGenField (AlgebraicClosure K)) Polynomial.X := by
      rw [IsScalarTower.algebraMap_apply (Polynomial (AlgebraicClosure K))
        (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K)), RatFunc.algebraMap_X]
    rw [hu]
    exact isIntegral_algebraMap
  have hhOint : IsIntegral (Polynomial (AlgebraicClosure K)) (wcFetgHO K h) := by
    show IsIntegral _ (Polynomial.eval₂ (wcFetgIota K) (wcFetgU K) h)
    rw [Polynomial.eval₂_eq_sum_range]
    exact IsIntegral.sum _ fun i _ =>
      IsIntegral.mul (hconstint (algebraMap K (AlgebraicClosure K) (h.coeff i))) (huint.pow _)
  have hθint : ∀ g, IsIntegral (Polynomial (AlgebraicClosure K)) (θ g) := by
    intro g
    rw [hθform]
    exact IsIntegral.sum _ fun k _ => (hconstint _).mul ((hhOint.pow _).mul (hint _))

  obtain ⟨P', hirr, hdvd, hev, hevinj⟩ := hcrux (AlgebraicClosure K) H θ hθ' hθint
    (fun τ => by
      obtain ⟨γ, hγ, hτ⟩ := hH1 τ
      exact ⟨γ, hγ, hθτ τ γ hτ⟩)
    (fun γ hγ => by
      obtain ⟨τ, hτ⟩ := hH2 γ hγ
      exact ⟨τ, hθτ τ γ hτ⟩) Rm hR'

  have hRm0 : Rm ≠ 0 := by
    intro h0
    have h1 := hR'
    rw [h0, map_zero] at h1
    exact (Polynomial.monic_prod_of_monic _ _
      fun g _ => Polynomial.monic_X_sub_C (θ g)).ne_zero h1.symm
  obtain ⟨D, hD⟩ := id hdvd
  have hP0 : P' ≠ 0 := by
    rintro rfl
    rw [zero_mul] at hD
    exact hRm0 hD
  have hD0 : D ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hD
    exact hRm0 hD
  have hdeg : P'.totalDegree ≤ Rm.totalDegree := by
    rw [hD, MvPolynomial.totalDegree_mul_of_isDomain hP0 hD0]
    omega

  have hΦc' : ∀ a : AlgebraicClosure K,
      (Φ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K))
        (algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) a) =
        algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (a ^ Nat.card K) :=
    hΦc
  have hΦr' : ∀ g, (Φ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K))
      (r g) = r (ρ * g) := hΦr
  have hΦι : (Φ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K)).comp
      (wcFetgIota K) = wcFetgIota K := by
    apply RingHom.ext
    intro k
    show (Φ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K))
        (algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K))
          (algebraMap K (AlgebraicClosure K) k)) =
      algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K))
        (algebraMap K (AlgebraicClosure K) k)
    rw [hΦc', ← map_pow, Nat.card_eq_fintype_card, FiniteField.pow_card]
  have hΦhO : (Φ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K))
      (wcFetgHO K h) = wcFetgHO K h := hhOfix _ hΦι hΦu
  have hΨc : ∀ (j : ℕ) (a : AlgebraicClosure K),
      ((Φ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K)) ^ j)
        (algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) a) =
        algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K))
          (a ^ (Nat.card K ^ j)) := by
    intro j
    induction j with
    | zero => intro a; simp
    | succ j ih =>
      intro a
      rw [pow_succ', RingHom.mul_def, RingHom.comp_apply, ih, hΦc', ← pow_mul, ← pow_succ]
  have hΨhO : ∀ j : ℕ,
      ((Φ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K)) ^ j)
        (wcFetgHO K h) = wcFetgHO K h := by
    intro j
    induction j with
    | zero => simp
    | succ j ih => rw [pow_succ', RingHom.mul_def, RingHom.comp_apply, ih, hΦhO]
  have hΨr : ∀ (j : ℕ) (g : G),
      ((Φ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K)) ^ j)
        (r g) = r (ρ ^ j * g) := by
    intro j
    induction j with
    | zero => intro g; simp
    | succ j ih =>
      intro g
      rw [pow_succ', RingHom.mul_def, RingHom.comp_apply, ih, hΦr', pow_succ', mul_assoc]
  have hΨθ : ∀ g,
      ((Φ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K)) ^ n)
        (θ g) = θ (ρ ^ n * g * g₀⁻¹) := by
    intro g
    rw [hθform, hθform, map_sum]
    simp only [map_mul, map_pow, hΨc, hΨhO, hΨr, hc]
    exact Fintype.sum_equiv (Equiv.mulLeft g₀) _ _ (fun k => by simp [mul_assoc])

  have hconj : ∀ j : ℕ, ∀ γ ∈ H, ρ ^ j * γ * (ρ ^ j)⁻¹ ∈ H := by
    intro j
    induction j with
    | zero => intro γ hγ; simpa using hγ
    | succ j ih =>
      intro γ hγ
      have h1 := (hρH _).mpr (ih γ hγ)
      rw [pow_succ', mul_inv_rev]
      simpa only [mul_assoc] using h1
  have hmemH : ∀ γ ∈ H, ρ ^ n * γ * g₀⁻¹ ∈ H := by
    intro γ hγ
    have e1 : ρ ^ n * γ * g₀⁻¹ = (ρ ^ n * γ * (ρ ^ n)⁻¹) * γ₀⁻¹ := by
      rw [hg₀, mul_inv_rev]
      simp only [mul_assoc]
    rw [e1]
    exact H.mul_mem (hconj n γ hγ) (H.inv_mem hγ₀)
  have hσinj : Function.Injective
      (fun γ : H => (⟨ρ ^ n * (γ : G) * g₀⁻¹, hmemH γ γ.2⟩ : H)) := by
    intro a b hab
    have h1 := congrArg Subtype.val hab
    simp only at h1
    exact Subtype.ext (mul_left_cancel (mul_right_cancel h1))
  have hprod : Polynomial.map
      ((Φ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K)) ^ n)
      (lwtrGenEv (AlgebraicClosure K) P') = lwtrGenEv (AlgebraicClosure K) P' := by
    rw [hev, Polynomial.map_prod]
    simp only [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, hΨθ]
    exact Fintype.prod_equiv (Equiv.ofBijective _ (Finite.injective_iff_bijective.mp hσinj))
      _ _ (fun γ => rfl)

  have hiter : ∀ (j : ℕ) (Pm : MvPolynomial (Fin 2) (AlgebraicClosure K)),
      Polynomial.map
        ((Φ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K)) ^ j)
        (lwtrGenEv (AlgebraicClosure K) Pm) =
      lwtrGenEv (AlgebraicClosure K) (MvPolynomial.map (lwtrFrob K ^ j) Pm) := by
    intro j
    induction j with
    | zero =>
      intro Pm
      rw [pow_zero, pow_zero, RingHom.one_def, RingHom.one_def, Polynomial.map_id,
        MvPolynomial.map_id]
    | succ j ih =>
      intro Pm
      rw [pow_succ, pow_succ, RingHom.mul_def, RingHom.mul_def, ← Polynomial.map_map, hΦev, ih,
        MvPolynomial.map_map]
  have hFr1 : ∀ a : AlgebraicClosure K, lwtrFrob K a = a ^ Nat.card K := by
    intro a
    show (FiniteField.frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K)) a = _
    rw [FiniteField.coe_frobeniusAlgEquivOfAlgebraic, Nat.card_eq_fintype_card]
  have hFr : ∀ (j : ℕ) (a : AlgebraicClosure K), (lwtrFrob K ^ j) a = a ^ (Nat.card K ^ j) := by
    intro j
    induction j with
    | zero => intro a; simp
    | succ j ih =>
      intro a
      rw [pow_succ', RingHom.mul_def, RingHom.comp_apply, ih, hFr1, ← pow_mul, ← pow_succ]
  have hfix : MvPolynomial.map (lwtrFrob K ^ n) P' = P' := by
    apply hevinj
    rw [← hiter n P', hprod]
  refine ⟨P', hirr, hdvd, fun m => ?_, hdeg⟩
  rw [← hFr n, ← MvPolynomial.coeff_map, hfix]

theorem wc_fetg_subfield_curve_count : ∀ Dg : ℕ, ∃ Q₀ : ℕ, ∀ (K : Type u) [Field K] [Finite K]
    (n : ℕ) (P' : MvPolynomial (Fin 2) (AlgebraicClosure K)), 1 ≤ n → Irreducible P' →
    P'.totalDegree ≤ Dg → (∀ m, P'.coeff m ^ (Nat.card K ^ n) = P'.coeff m) →
    Q₀ ≤ Nat.card K ^ n →
    Nat.card K ^ n ≤ 2 * Nat.card {z : Fin 2 → AlgebraicClosure K //
      (∀ i, z i ^ (Nat.card K ^ n) = z i) ∧ MvPolynomial.eval z P' = 0} :=
by
  classical
  intro Dg
  obtain ⟨Q₀, hQ₀⟩ := lw_plane_curve_count.{u} Dg (1 / 2) (by norm_num)
  refine ⟨Q₀, ?_⟩
  intro K _ _ n P' hn hirr hdeg hfix hQ
  letI : Fintype K := Fintype.ofFinite K
  have hq1 : 1 < Nat.card K := Finite.one_lt_card
  have hn0 : n ≠ 0 := by omega

  have hfrob : ∀ m : ℕ, ∃ φ : AlgebraicClosure K →+* AlgebraicClosure K,
      ∀ c, φ c = c ^ (Nat.card K ^ m) := by
    intro m
    induction m with
    | zero => exact ⟨RingHom.id _, fun c => by simp⟩
    | succ m ih =>
      obtain ⟨φ, hφ⟩ := ih
      have h1 : ∀ x : AlgebraicClosure K,
          (FiniteField.frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K)) x =
            x ^ Fintype.card K := fun x => by
        rw [FiniteField.coe_frobeniusAlgEquivOfAlgebraic]
      refine ⟨(FiniteField.frobeniusAlgEquivOfAlgebraic K
        (AlgebraicClosure K)).toRingEquiv.toRingHom.comp φ, fun c => ?_⟩
      rw [RingHom.comp_apply, hφ]
      show (FiniteField.frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K))
        (c ^ Nat.card K ^ m) = _
      rw [h1, Fintype.card_eq_nat_card, ← pow_mul, pow_succ]
  obtain ⟨φ, hφ⟩ := hfrob n

  have hL₀ : ∀ x : AlgebraicClosure K,
      x ∈ φ.eqLocusField (RingHom.id _) ↔ x ^ (Nat.card K ^ n) = x := by
    intro x
    rw [RingHom.mem_eqLocusField, hφ, RingHom.id_apply]
  have hK : ∀ k : K, algebraMap K (AlgebraicClosure K) k ∈ φ.eqLocusField (RingHom.id _) := by
    intro k
    rw [hL₀, ← map_pow]
    congr 1
    rw [← Fintype.card_eq_nat_card]
    exact FiniteField.pow_card_pow n k
  let L : IntermediateField K (AlgebraicClosure K) :=
    (φ.eqLocusField (RingHom.id _)).toIntermediateField hK
  have hL : ∀ x : AlgebraicClosure K, x ∈ L ↔ x ^ (Nat.card K ^ n) = x := fun x => hL₀ x

  have hfixcard : Nat.card {x : AlgebraicClosure K // x ^ (Nat.card K ^ n) = x} =
      Nat.card K ^ n := by
    have hpq : ringChar K ∣ Nat.card K ^ n := by
      have h1 : ringChar K ∣ Nat.card K := by
        apply ringChar.dvd
        rw [← Fintype.card_eq_nat_card]
        exact FiniteField.cast_card_eq_zero K
      exact h1.trans (dvd_pow_self _ hn0)
    obtain ⟨F, hF⟩ : ∃ F : Polynomial (AlgebraicClosure K),
        F = Polynomial.X ^ (Nat.card K ^ n) - Polynomial.X := ⟨_, rfl⟩
    have hsep : F.Separable := by
      rw [hF]; exact galois_poly_separable (ringChar K) _ hpq
    have hF0 : F ≠ 0 := by
      rw [hF]; exact FiniteField.X_pow_card_pow_sub_X_ne_zero _ hn0 hq1
    have hdegF : F.natDegree = Nat.card K ^ n := by
      rw [hF]; exact FiniteField.X_pow_card_pow_sub_X_natDegree_eq _ hn0 hq1
    have hroots : F.roots.card = Nat.card K ^ n := by
      rw [← hdegF]
      exact IsAlgClosed.card_roots_eq_natDegree
    have hnd : F.roots.Nodup := Polynomial.nodup_roots hsep
    have e : {x : AlgebraicClosure K // x ^ (Nat.card K ^ n) = x} ≃
        {x // x ∈ F.roots.toFinset} := Equiv.subtypeEquivRight (fun x => by
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hF0, Polynomial.IsRoot.def, hF,
        Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, sub_eq_zero])
    rw [Nat.card_congr e, Nat.card_eq_fintype_card, Fintype.card_coe,
      Multiset.toFinset_card_of_nodup hnd, hroots]
  have hcardL : Nat.card L = Nat.card K ^ n := by
    rw [← hfixcard]
    exact Nat.card_congr (Equiv.subtypeEquivRight hL)
  haveI : Finite L := Nat.finite_of_card_ne_zero (by rw [hcardL]; positivity)

  obtain ⟨P'', hP''⟩ : P' ∈ Set.range (MvPolynomial.map (algebraMap L (AlgebraicClosure K))) := by
    rw [MvPolynomial.mem_range_map_iff_coeffs_subset]
    intro c hc
    obtain ⟨m, -, rfl⟩ := MvPolynomial.mem_coeffs_iff.mp hc
    exact ⟨⟨P'.coeff m, (hL _).2 (hfix m)⟩, rfl⟩

  have hdeg'' : P''.totalDegree ≤ Dg := by
    have : P''.totalDegree = P'.totalDegree := by
      rw [← hP'']
      unfold MvPolynomial.totalDegree
      rw [MvPolynomial.support_map_of_injective _ (RingHom.injective _)]
    rw [this]; exact hdeg

  haveI : IsAlgClosure L (AlgebraicClosure K) := ⟨inferInstance, inferInstance⟩
  let ψ : AlgebraicClosure L ≃ₐ[L] AlgebraicClosure K :=
    IsAlgClosure.equiv L (AlgebraicClosure L) (AlgebraicClosure K)
  have hirr'' : Irreducible (MvPolynomial.map (algebraMap L (AlgebraicClosure L)) P'') := by
    have e1 : MvPolynomial.mapEquiv (Fin 2) ψ.toRingEquiv
        (MvPolynomial.map (algebraMap L (AlgebraicClosure L)) P'') = P' := by
      have hc : (ψ.toRingEquiv : AlgebraicClosure L →+* AlgebraicClosure K).comp
          (algebraMap L (AlgebraicClosure L)) = algebraMap L (AlgebraicClosure K) :=
        RingHom.ext fun x => ψ.commutes x
      rw [MvPolynomial.mapEquiv_apply, MvPolynomial.map_map]
      first
      | rw [hc, hP'']
      | (erw [hc]; exact hP'')
      | (simp only [hc, hP''])
    have h2 := hirr
    rw [← e1] at h2
    exact (MulEquiv.irreducible_iff _).mp h2

  have hlw := hQ₀ L P'' hdeg'' hirr'' (by rw [hcardL]; exact hQ)
  rw [hcardL] at hlw

  have key : ∀ z : Fin 2 → L, MvPolynomial.eval (fun i => (z i : AlgebraicClosure K)) P' =
      algebraMap L (AlgebraicClosure K) (MvPolynomial.eval z P'') := by
    intro z
    rw [← hP'', MvPolynomial.map_eval]
    rfl
  let eqv : {z : Fin 2 → L // MvPolynomial.eval z P'' = 0} ≃
      {z : Fin 2 → AlgebraicClosure K //
        (∀ i, z i ^ (Nat.card K ^ n) = z i) ∧ MvPolynomial.eval z P' = 0} :=
    { toFun := fun z => ⟨fun i => ((z.1 i : L) : AlgebraicClosure K),
        fun i => (hL _).1 (z.1 i).2, by rw [key, z.2, map_zero]⟩
      invFun := fun w => ⟨fun i => ⟨w.1 i, (hL _).2 (w.2.1 i)⟩, by
        apply (algebraMap L (AlgebraicClosure K)).injective
        rw [← key, map_zero]
        exact w.2.2⟩
      left_inv := fun z => Subtype.ext (funext fun i => Subtype.ext rfl)
      right_inv := fun w => Subtype.ext (funext fun i => rfl) }
  rw [← Nat.card_congr eqv]

  obtain ⟨N, hN⟩ : ∃ N, N = Nat.card {z : Fin 2 → L // MvPolynomial.eval z P'' = 0} :=
    ⟨_, rfl⟩
  rw [← hN] at hlw ⊢
  have h1 := (abs_sub_le_iff.mp hlw).2
  have h2 : ((Nat.card K ^ n : ℕ) : ℝ) ≤ ((2 * N : ℕ) : ℝ) := by
    push_cast
    push_cast at h1
    linarith
  exact Nat.cast_le.mp h2

theorem wc_fetg_point_transfer (K : Type u) [Field K] [Finite K] (G : Type) [Group G] [Fintype G]
    [DecidableEq G] (h : Polynomial K) (e : ℕ) (f : Polynomial (Polynomial K))
    (P : G → Polynomial (Polynomial K)) (hh : h ≠ 0) (hf : f.Monic)
    (hdeg : f.natDegree = Fintype.card G) (hPW : wcFetgPW K G h e f P)
    (hfib : ∀ a : AlgebraicClosure K, wcFetgH h a ≠ 0 → wcFetgFibre K G h e f P a)
    (n : ℕ) (hn : 1 ≤ n) (g₀ : G) (c : G → AlgebraicClosure K)
    (hc : ∀ k, c k ^ (Nat.card K ^ n) = c (g₀ * k))
    (Rm : MvPolynomial (Fin 2) (AlgebraicClosure K)) (D : Polynomial (AlgebraicClosure K))
    (hspec : wcFetgResSpec K G f P c Rm D) (hD : D ≠ 0)
    (P' : MvPolynomial (Fin 2) (AlgebraicClosure K)) (hP' : P' ∣ Rm) :
    Nat.card {z : Fin 2 → AlgebraicClosure K //
        (∀ i, z i ^ (Nat.card K ^ n) = z i) ∧ MvPolynomial.eval z P' = 0} ≤
      Nat.card {p : AlgebraicClosure K × AlgebraicClosure K // Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) p.1 h ≠ 0 ∧ Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) p.1) p.2 f = 0 ∧ p.1 ^ (Nat.card K ^ n) = p.1 ∧ p.2 ^ (Nat.card K ^ n) = Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) p.1) p.2 (P g₀) / Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) p.1 h ^ e} +
        (h.natDegree + D.natDegree) * Fintype.card G :=
by
  classical

  have hfrob : ∀ m : ℕ, ∃ φ : AlgebraicClosure K →+* AlgebraicClosure K,
      ∀ x, φ x = x ^ (Nat.card K ^ m) := by
    letI : Fintype K := Fintype.ofFinite K
    intro m
    induction m with
    | zero => exact ⟨RingHom.id _, fun x => by simp⟩
    | succ m ih =>
      obtain ⟨φ, hφ⟩ := ih
      have h1 : ∀ x : AlgebraicClosure K,
          (FiniteField.frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K)) x =
            x ^ Fintype.card K := fun x => by
        rw [FiniteField.coe_frobeniusAlgEquivOfAlgebraic]
      refine ⟨(FiniteField.frobeniusAlgEquivOfAlgebraic K
        (AlgebraicClosure K)).toRingEquiv.toRingHom.comp φ, fun x => ?_⟩
      rw [RingHom.comp_apply, hφ]
      show (FiniteField.frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K))
        (x ^ Nat.card K ^ m) = _
      rw [h1, Fintype.card_eq_nat_card, ← pow_mul, pow_succ]
  obtain ⟨φ, hφ0⟩ := hfrob n
  have hφι : ∀ x : K, φ (algebraMap K (AlgebraicClosure K) x) = algebraMap K (AlgebraicClosure K) x := by
    intro x
    letI : Fintype K := Fintype.ofFinite K
    rw [hφ0, ← map_pow, ← Fintype.card_eq_nat_card, FiniteField.pow_card_pow]
  obtain ⟨Q, hQ⟩ : ∃ Q, Q = Nat.card K ^ n := ⟨_, rfl⟩
  rw [← hQ] at hc hφ0 ⊢
  have hφ : ∀ x, φ x = x ^ Q := hφ0
  have hQ1 : 1 < Q := by
    rw [hQ]; exact Nat.one_lt_pow (by omega) Finite.one_lt_card
  have hφcomp : φ.comp (algebraMap K (AlgebraicClosure K)) = algebraMap K (AlgebraicClosure K) :=
    RingHom.ext hφι
  have hφev : ∀ (F : Polynomial (Polynomial K)) (a b : AlgebraicClosure K),
      φ (wcFetgEv F a b) = wcFetgEv F (φ a) (φ b) := by
    intro F a b
    have h1 : φ.comp (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a) =
        Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) (φ a) := by
      apply RingHom.ext
      intro p
      rw [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.coe_eval₂RingHom,
        Polynomial.hom_eval₂, hφcomp]
    show φ (Polynomial.eval₂ _ b F) = Polynomial.eval₂ _ (φ b) F
    rw [Polynomial.hom_eval₂, h1]
  have hφc : ∀ k, φ (c k) = c (g₀ * k) := fun k => by rw [hφ, hc]

  obtain ⟨θ, hθdef⟩ : ∃ θ : AlgebraicClosure K → AlgebraicClosure K → AlgebraicClosure K,
      θ = fun a w => ∑ k, c k * wcFetgEv (P k) a w := ⟨_, rfl⟩

  have hsplit : ∀ a : AlgebraicClosure K, ∃ β : G → AlgebraicClosure K,
      Polynomial.map (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a) f =
        ∏ g, (Polynomial.X - Polynomial.C (β g)) := by
    intro a
    have hmon := hf.map (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a)
    have hdeg' : (Polynomial.map (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a)
        f).natDegree = Fintype.card G := by rw [hf.natDegree_map, hdeg]
    have hroots : (Polynomial.map (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a)
        f).roots.card = (Polynomial.map (Polynomial.eval₂RingHom
          (algebraMap K (AlgebraicClosure K)) a) f).natDegree :=
      IsAlgClosed.card_roots_eq_natDegree
    have hprod := Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hmon hroots
    obtain ⟨l, hl⟩ : ∃ l, l = (Polynomial.map (Polynomial.eval₂RingHom
        (algebraMap K (AlgebraicClosure K)) a) f).roots.toList := ⟨_, rfl⟩
    have hlen : Fintype.card G = l.length := by
      rw [hl, Multiset.length_toList, hroots, hdeg']
    let eqv := Fintype.equivFinOfCardEq hlen
    refine ⟨fun g => l.get (eqv g), ?_⟩
    have e1 : ∏ g : G, (Polynomial.X - Polynomial.C (l.get (eqv g))) =
        ∏ i : Fin l.length, (Polynomial.X - Polynomial.C (l.get i)) :=
      Equiv.prod_comp eqv (fun i => Polynomial.X - Polynomial.C (l.get i))
    have e2 : List.ofFn (fun i : Fin l.length => Polynomial.X - Polynomial.C (l.get i)) =
        l.map (fun r => Polynomial.X - Polynomial.C r) := by
      apply List.ext_get
      · simp
      · intro m h1 h2
        simp
    rw [e1, ← List.prod_ofFn, e2, ← Multiset.prod_coe, ← Multiset.map_coe, hl,
      Multiset.coe_toList, hprod]
  choose β hβ using hsplit

  have hspecK : ∀ (a : AlgebraicClosure K) (b : G → AlgebraicClosure K),
      Polynomial.map (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a) f =
        ∏ g, (Polynomial.X - Polynomial.C (b g)) →
      (∀ z : Fin 2 → AlgebraicClosure K, z 0 = a →
        MvPolynomial.eval z Rm = ∏ g, (z 1 - θ a (b g))) ∧
      Polynomial.eval a D = ∏ p ∈ (Finset.univ : Finset G).offDiag, (θ a (b p.1) - θ a (b p.2)) := by
    intro a b hb
    have hb' : Polynomial.map (Polynomial.eval₂RingHom
        ((algebraMap (AlgebraicClosure K) (AlgebraicClosure K)).comp
          (algebraMap K (AlgebraicClosure K))) a) f =
        ∏ g, (Polynomial.X - Polynomial.C (b g)) := by
      rw [Algebra.algebraMap_self, RingHom.id_comp]; exact hb
    obtain ⟨S1, S2⟩ := @hspec (AlgebraicClosure K) _ (Algebra.id _) a b hb'
    simp only [Algebra.algebraMap_self, RingHom.id_comp, RingHom.id_apply] at S1 S2
    refine ⟨fun z hz => ?_, ?_⟩
    · have key : ∀ p : MvPolynomial (Fin 2) (AlgebraicClosure K),
          Polynomial.eval (z 1) (MvPolynomial.aeval ![Polynomial.C a, Polynomial.X] p) =
            MvPolynomial.eval z p := by
        intro p
        induction p using MvPolynomial.induction_on with
        | C r =>
          simp
        | add p q hp hq =>
          simp only [map_add, Polynomial.eval_add, hp, hq]
        | mul_X p i hp =>
          simp only [map_mul, Polynomial.eval_mul, hp, MvPolynomial.aeval_X, MvPolynomial.eval_X]
          congr 1
          fin_cases i
          · simp [hz]
          · simp
      rw [← key, S1, Polynomial.eval_prod]
      simp only [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, hθdef]
    · rw [← Polynomial.coe_aeval_eq_eval, S2, hθdef]

  have hZd : ∀ z : Fin 2 → AlgebraicClosure K,
      ((∀ i, z i ^ Q = z i) ∧ MvPolynomial.eval z P' = 0) →
      ∃ g, z 1 = θ (z 0) (β (z 0) g) ∧ wcFetgEv f (z 0) (β (z 0) g) = 0 := by
    intro z hz
    have hR : MvPolynomial.eval z Rm = 0 := by
      obtain ⟨R, hR⟩ := hP'
      rw [hR, map_mul, hz.2, zero_mul]
    rw [(hspecK (z 0) (β (z 0)) (hβ (z 0))).1 z rfl] at hR
    obtain ⟨g, -, hg⟩ := Finset.prod_eq_zero_iff.mp hR
    refine ⟨g, sub_eq_zero.mp hg, ?_⟩
    have := congrArg (Polynomial.eval (β (z 0) g)) (hβ (z 0))
    rw [Polynomial.eval_map, Polynomial.eval_prod,
      Finset.prod_eq_zero (Finset.mem_univ g) (by simp)] at this
    exact this
  have hW : ∀ z : Fin 2 → AlgebraicClosure K,
      ((∀ i, z i ^ Q = z i) ∧ MvPolynomial.eval z P' = 0) →
      ∃ w, wcFetgEv f (z 0) w = 0 ∧ θ (z 0) w = z 1 := fun z hz => by
    obtain ⟨g, h1, h2⟩ := hZd z hz
    exact ⟨_, h2, h1.symm⟩
  choose! wsel hwsel using hW

  obtain ⟨S, hScard, hSgood⟩ : ∃ S : Finset (AlgebraicClosure K),
      S.card ≤ h.natDegree + D.natDegree ∧
      ∀ a, a ∉ S → wcFetgH h a ≠ 0 ∧ Polynomial.eval a D ≠ 0 := by
    refine ⟨(Polynomial.map (algebraMap K (AlgebraicClosure K)) h).roots.toFinset ∪
      D.roots.toFinset, ?_, ?_⟩
    · have e1 := Finset.card_union_le
        (Polynomial.map (algebraMap K (AlgebraicClosure K)) h).roots.toFinset D.roots.toFinset
      have e2 := Multiset.toFinset_card_le
        (Polynomial.map (algebraMap K (AlgebraicClosure K)) h).roots
      have e3 := Multiset.toFinset_card_le D.roots
      have e4 := Polynomial.card_roots' (Polynomial.map (algebraMap K (AlgebraicClosure K)) h)
      have e5 := Polynomial.card_roots' D
      have e6 : (Polynomial.map (algebraMap K (AlgebraicClosure K)) h).natDegree ≤ h.natDegree :=
        Polynomial.natDegree_map_le
      omega
    · intro a ha
      rw [Finset.mem_union, not_or, Multiset.mem_toFinset, Multiset.mem_toFinset] at ha
      exact ⟨fun h0 => ha.1 ((Polynomial.mem_roots_map hh).mpr h0),
        fun h0 => ha.2 ((Polynomial.mem_roots hD).mpr h0)⟩

  have hTfin : {p : AlgebraicClosure K × AlgebraicClosure K |
      wcFetgEv f p.1 p.2 = 0 ∧ p.1 ^ Q = p.1}.Finite := by
    have hA : {x : AlgebraicClosure K | x ^ Q = x}.Finite := by
      refine (Polynomial.finite_setOfPred_isRoot
        (FiniteField.X_pow_card_sub_X_ne_zero (AlgebraicClosure K) hQ1)).subset ?_
      intro x hx
      simp only [Set.mem_setOf_eq, Polynomial.IsRoot.def, Polynomial.eval_sub,
        Polynomial.eval_pow, Polynomial.eval_X] at hx ⊢
      rw [hx, sub_self]
    have hB : ∀ a : AlgebraicClosure K, {b : AlgebraicClosure K | wcFetgEv f a b = 0}.Finite := by
      intro a
      refine (Polynomial.finite_setOfPred_isRoot
        (hf.map (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) a)).ne_zero).subset ?_
      intro b hb
      show Polynomial.IsRoot _ b
      rw [Polynomial.IsRoot.def, Polynomial.eval_map]
      exact hb
    refine (hA.prod (hA.biUnion fun a _ => hB a)).subset ?_
    rintro ⟨a, b⟩ ⟨h1, h2⟩
    exact ⟨h2, Set.mem_biUnion h2 h1⟩

  have crux : ∀ a w : AlgebraicClosure K, wcFetgH h a ≠ 0 → Polynomial.eval a D ≠ 0 →
      wcFetgEv f a w = 0 → a ^ Q = a → (θ a w) ^ Q = θ a w →
      w ^ Q = wcFetgEv (P g₀) a w / wcFetgH h a ^ e := by
    intro a w ha hDa hw haQ hθQ
    obtain ⟨hFb, hF1, hFall⟩ := (hfib a ha).2 w hw
    have hφa : φ a = a := by rw [hφ, haQ]
    have hφw : wcFetgEv f a (φ w) = 0 := by
      have := hφev f a w
      rw [hw, map_zero, hφa] at this
      exact this.symm
    obtain ⟨y, hy⟩ := hFall (φ w) hφw
    obtain ⟨-, -, PW3⟩ := hPW a w ha hw
    have hHe : wcFetgH h a ^ e ≠ 0 := pow_ne_zero _ ha
    have hE : ∀ g k, wcFetgEv (P k) a (wcFetgEv (P g) a w / wcFetgH h a ^ e) =
        wcFetgH h a ^ e * (wcFetgEv (P (g * k)) a w / wcFetgH h a ^ e) := by
      intro g k
      rw [PW3 g k]
      field_simp
    have hinj : ∀ g g', θ a (wcFetgEv (P g) a w / wcFetgH h a ^ e) =
        θ a (wcFetgEv (P g') a w / wcFetgH h a ^ e) → g = g' := by
      intro g g' hgg
      by_contra hne
      have hD' := (hspecK a (fun g => wcFetgEv (P g) a w / wcFetgH h a ^ e) hFb).2
      apply hDa
      rw [hD']
      exact Finset.prod_eq_zero (i := (g, g'))
        (Finset.mem_offDiag.mpr ⟨Finset.mem_univ _, Finset.mem_univ _, hne⟩) (sub_eq_zero.mpr hgg)
    have hφθ : φ (θ a w) = θ a (wcFetgEv (P (y * g₀⁻¹)) a w / wcFetgH h a ^ e) := by
      rw [hθdef]
      simp only [map_sum, map_mul, hφc, hφev, hφa, hy, hE]
      refine Fintype.sum_equiv (Equiv.mulLeft g₀) _ _ (fun k => ?_)
      rw [Equiv.coe_mulLeft]
      have : y * g₀⁻¹ * (g₀ * k) = y * k := by group
      rw [this]
    have h1 : θ a (wcFetgEv (P 1) a w / wcFetgH h a ^ e) =
        θ a (wcFetgEv (P (y * g₀⁻¹)) a w / wcFetgH h a ^ e) := by
      rw [hF1, ← hφθ, hφ, hθQ]
    have h2 := hinj _ _ h1
    have hy0 : y = g₀ := by
      have := h2.symm
      rwa [mul_inv_eq_one] at this
    rw [← hφ, hy, hy0]

  change Nat.card ↥{z : Fin 2 → AlgebraicClosure K |
      (∀ i, z i ^ Q = z i) ∧ MvPolynomial.eval z P' = 0} ≤
    Nat.card ↥{p : AlgebraicClosure K × AlgebraicClosure K | wcFetgH h p.1 ≠ 0 ∧
      wcFetgEv f p.1 p.2 = 0 ∧ p.1 ^ Q = p.1 ∧
      p.2 ^ Q = wcFetgEv (P g₀) p.1 p.2 / wcFetgH h p.1 ^ e} +
    (h.natDegree + D.natDegree) * Fintype.card G
  rw [Nat.card_coe_set_eq, Nat.card_coe_set_eq]
  set Zs := {z : Fin 2 → AlgebraicClosure K |
      (∀ i, z i ^ Q = z i) ∧ MvPolynomial.eval z P' = 0} with hZs
  set Ts := {p : AlgebraicClosure K × AlgebraicClosure K | wcFetgH h p.1 ≠ 0 ∧
      wcFetgEv f p.1 p.2 = 0 ∧ p.1 ^ Q = p.1 ∧
      p.2 ^ Q = wcFetgEv (P g₀) p.1 p.2 / wcFetgH h p.1 ^ e} with hTs
  have hTsfin : Ts.Finite := hTfin.subset (fun p hp => ⟨hp.2.1, hp.2.2.1⟩)
  set A := {z | z ∈ Zs ∧ z 0 ∉ S} with hAdef
  set B := (fun p : AlgebraicClosure K × G => ![p.1, θ p.1 (β p.1 p.2)]) ''
    ↑(S ×ˢ (Finset.univ : Finset G)) with hBdef
  let Φ : (Fin 2 → AlgebraicClosure K) → AlgebraicClosure K × AlgebraicClosure K :=
    fun z => (z 0, wsel z)
  have hmaps : ∀ z ∈ A, Φ z ∈ Ts := by
    intro z hz
    obtain ⟨hzZ, hzS⟩ := hz
    obtain ⟨ha, hDa⟩ := hSgood _ hzS
    obtain ⟨hw, hθw⟩ := hwsel z hzZ
    refine ⟨ha, hw, hzZ.1 0, ?_⟩
    exact crux _ _ ha hDa hw (hzZ.1 0) (by rw [hθw]; exact hzZ.1 1)
  have hinjA : Set.InjOn Φ A := by
    intro z hz z' hz' hzz
    have e0 : z 0 = z' 0 := congrArg Prod.fst hzz
    have e1 : wsel z = wsel z' := congrArg Prod.snd hzz
    have e2 : z 1 = z' 1 := by
      rw [← (hwsel z hz.1).2, ← (hwsel z' hz'.1).2, e0, e1]
    funext i
    fin_cases i
    · exact e0
    · exact e2
  have hAfin : A.Finite :=
    Set.Finite.of_finite_image (hTsfin.subset (fun p ⟨z, hz, hp⟩ => hp ▸ hmaps z hz)) hinjA
  have hBfin : B.Finite := (Finset.finite_toSet _).image _
  have hcov : Zs ⊆ A ∪ B := by
    intro z hz
    by_cases hzS : z 0 ∈ S
    · right
      obtain ⟨g, hg, -⟩ := hZd z hz
      refine ⟨(z 0, g), ?_, ?_⟩
      · simp [hzS]
      · funext i
        fin_cases i
        · simp
        · simp [hg]
    · left
      exact ⟨hz, hzS⟩
  have hA : A.ncard ≤ Ts.ncard := Set.ncard_le_ncard_of_injOn Φ hmaps hinjA hTsfin
  have hB : B.ncard ≤ S.card * Fintype.card G := by
    have e1 : B.ncard ≤ (↑(S ×ˢ (Finset.univ : Finset G)) : Set (AlgebraicClosure K × G)).ncard := by
      rw [hBdef]
      exact Set.ncard_image_le (Finset.finite_toSet _)
    rw [Set.ncard_coe_finset, Finset.card_product, Finset.card_univ] at e1
    exact e1
  have hZ : Zs.ncard ≤ A.ncard + B.ncard :=
    (Set.ncard_le_ncard hcov (hAfin.union hBfin)).trans (Set.ncard_union_le _ _)
  have hM : S.card * Fintype.card G ≤ (h.natDegree + D.natDegree) * Fintype.card G :=
    Nat.mul_le_mul_right _ hScard
  omega

theorem wc_fetg_growth : ∀ (q N C t o Q₀ : ℕ), 2 ≤ q → 1 ≤ o → ∃ n : ℕ, 1 ≤ n ∧ n % o = t % o ∧
    Q₀ ≤ q ^ n ∧ 2 * (N * ∑ d ∈ n.properDivisors, (q ^ d + 1) + C) < q ^ n :=
by
  intro q N C t o Q₀ hq ho
  have s1 : ∀ n : ℕ, ∑ d ∈ n.properDivisors, (q ^ d + 1) ≤
      ∑ d ∈ Finset.range (n / 2 + 1), (q ^ d + 1) := by
    intro n
    apply Finset.sum_le_sum_of_subset
    intro d hd
    rw [Nat.mem_properDivisors] at hd
    obtain ⟨⟨k, hk⟩, hlt⟩ := hd
    rw [Finset.mem_range]
    have hk2 : 2 ≤ k := by
      rcases k with _ | _ | k
      · rw [Nat.mul_zero] at hk; omega
      · rw [Nat.mul_one] at hk; omega
      · omega
    have : d * 2 ≤ d * k := Nat.mul_le_mul_left d hk2
    omega
  have s2 : ∀ m : ℕ, ∑ d ∈ Finset.range (m + 1), (q ^ d + 1) + 1 ≤ 3 * q ^ m := by
    intro m
    induction m with
    | zero => simp
    | succ m ih =>
      rw [Finset.sum_range_succ, pow_succ]
      have hy : 1 ≤ q ^ m := Nat.one_le_pow _ _ (by omega)
      have : q ^ m * 2 ≤ q ^ m * q := Nat.mul_le_mul_left _ hq
      linarith
  obtain ⟨K, hK⟩ : ∃ K, K = 6 * N + 2 * C + Q₀ + 1 := ⟨_, rfl⟩
  have hoK : 2 * K ≤ o * (2 * K) := Nat.le_mul_of_pos_left (2 * K) ho
  refine ⟨t % o + o * (2 * K), by omega, by rw [Nat.add_mul_mod_self_left, Nat.mod_mod], ?_⟩
  obtain ⟨n, hn⟩ : ∃ n, n = t % o + o * (2 * K) := ⟨_, rfl⟩
  rw [← hn]
  have hS1 := s1 n
  have hS2 := s2 (n / 2)
  have hmx : n / 2 < q ^ (n / 2) := Nat.lt_pow_self (by omega)
  have hpow : q ^ (n / 2 + n / 2) ≤ q ^ n := Nat.pow_le_pow_right (by omega) (by omega)
  rw [pow_add] at hpow
  obtain ⟨x, hx⟩ : ∃ x, x = q ^ (n / 2) := ⟨_, rfl⟩
  rw [← hx] at hS2 hmx hpow
  obtain ⟨S, hS⟩ : ∃ S, S = ∑ d ∈ n.properDivisors, (q ^ d + 1) := ⟨_, rfl⟩
  rw [← hS] at hS1 ⊢
  obtain ⟨T, hT⟩ : ∃ T, T = ∑ d ∈ Finset.range (n / 2 + 1), (q ^ d + 1) := ⟨_, rfl⟩
  rw [← hT] at hS1 hS2
  have hKx : K ≤ x := by omega
  have hx1 : 1 ≤ x := by omega
  have h1 : x * K ≤ x * x := Nat.mul_le_mul_left x hKx
  have h2 : N * S ≤ N * (3 * x) := Nat.mul_le_mul_left N (by omega)
  have h3 : C ≤ C * x := Nat.le_mul_of_pos_right C hx1
  have h4 : x ≤ x * x := Nat.le_mul_of_pos_right x hx1
  have h5 : 0 ≤ Q₀ * x := Nat.zero_le _
  constructor
  · omega
  · subst hK
    nlinarith

theorem wc_fetg_poly_chebotarev : ∀ (K : Type u) [Field K] [Finite K] (G : Type) [Group G] [Finite G] (h : Polynomial K) (e : ℕ) (f : Polynomial (Polynomial K)) (P : G → Polynomial (Polynomial K)), h ≠ 0 → f.Monic → f.natDegree = Nat.card G → Irreducible (f.map (algebraMap (Polynomial K) (RatFunc K))) → (∀ u₀ v₀ : AlgebraicClosure K, Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ h ≠ 0 → Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) v₀ f = 0 → (∀ g, Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) (Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) v₀ (P g) / Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ h ^ e) f = 0) ∧ Function.Injective (fun g => Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) v₀ (P g) / Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ h ^ e) ∧ (∀ g g', Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) v₀ (P (g * g')) / Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ h ^ e = Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) (Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) u₀) v₀ (P g) / Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ h ^ e) (P g') / Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) u₀ h ^ e)) → ∀ g₀ : G, ∃ n : ℕ, 1 ≤ n ∧ f.natDegree * ∑ d ∈ n.properDivisors, (Nat.card K ^ d + 1) < Nat.card {p : AlgebraicClosure K × AlgebraicClosure K // Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) p.1 h ≠ 0 ∧ Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) p.1) p.2 f = 0 ∧ p.1 ^ (Nat.card K ^ n) = p.1 ∧ p.2 ^ (Nat.card K ^ n) = Polynomial.eval₂ (Polynomial.eval₂RingHom (algebraMap K (AlgebraicClosure K)) p.1) p.2 (P g₀) / Polynomial.eval₂ (algebraMap K (AlgebraicClosure K)) p.1 h ^ e} :=
by
  classical
  intro K _ _ G _ _ h e f P hh hf hdeg hirr hPW0 g₀
  letI : Fintype G := Fintype.ofFinite G
  letI : Fintype K := Fintype.ofFinite K
  have hdegF : f.natDegree = Fintype.card G := by rw [hdeg, Nat.card_eq_fintype_card]
  have hPW : wcFetgPW K G h e f P := hPW0

  have hfib : ∀ a : AlgebraicClosure K, wcFetgH h a ≠ 0 → wcFetgFibre K G h e f P a :=
    fun a ha => wc_fetg_pw_fibre K G h e f P hf hdegF hPW a ha

  have hS : ∀ a : AlgebraicClosure K, wcFetgH h a ≠ 0 →
      ∃ S : Finset (AlgebraicClosure K), S.card = f.natDegree ∧ ∀ s ∈ S, wcFetgEv f a s = 0 := by
    intro a ha
    obtain ⟨⟨b, hb⟩, -⟩ := hfib a ha
    refine ⟨Finset.univ.image (fun g => wcFetgEv (P g) a b / wcFetgH h a ^ e), ?_, ?_⟩
    · rw [Finset.card_image_of_injective _ (hPW a b ha hb).2.1, Finset.card_univ, hdegF]
    · intro s hs
      obtain ⟨g, -, rfl⟩ := Finset.mem_image.mp hs
      exact (hPW a b ha hb).1 g
  have hT := wc_fetg_pw_transfer K h f hh hf hS

  obtain ⟨r, H, ρ, Φ, hr, hhO, hfr, hPr, hΦc, hΦu, hΦr, hH1, hH2, hρH, hΦev, hint⟩ :=
    wc_fetg_generic_package K G h e f P hh hf hdegF hirr hPW hfib hT

  obtain ⟨γ₀, hγ₀, t, hg₀t⟩ := wc_fetg_coset_cover K G f hf hdegF hirr r hr hfr Φ hΦc hΦu ρ hΦr
    H hH1 (fun γ hγ => (hρH γ).mpr hγ) g₀

  obtain ⟨B, hB⟩ := wc_fetg_resolvent K G f P hf hdegF
  obtain ⟨Q₀', hQ₀'⟩ := wc_fetg_subfield_curve_count.{u} B
  have hq : 2 ≤ Nat.card K := Finite.one_lt_card
  obtain ⟨n, hn1, hnmod, hQn, hgrow⟩ := wc_fetg_growth (Nat.card K) (Fintype.card G)
    ((h.natDegree + B) * Fintype.card G) t (orderOf ρ) (max Q₀' (Fintype.card G ^ 2 + 1)) hq
    (orderOf_pos ρ)
  have hρn : ρ ^ n = ρ ^ t := pow_eq_pow_iff_modEq.mpr hnmod
  have hg₀ : g₀ = γ₀ * ρ ^ n := by rw [hρn]; exact hg₀t

  obtain ⟨W, hWdef⟩ : ∃ W : Finset (G → lwtrGenField (AlgebraicClosure K)),
      W = (Finset.univ : Finset G).offDiag.image (fun p => fun k => r (p.1 * k) - r (p.2 * k)) :=
    ⟨_, rfl⟩
  have hW0 : ∀ w ∈ W, w ≠ 0 := by
    intro w hw hw0
    rw [hWdef] at hw
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hw
    rw [Finset.mem_offDiag] at hp
    have h1 := congrFun hw0 1
    simp only [mul_one, Pi.zero_apply, sub_eq_zero] at h1
    exact hp.2.2 (hr h1)
  have hWq : W.card < Nat.card K ^ n := by
    have h1 : W.card ≤ (Finset.univ : Finset G).offDiag.card := by
      rw [hWdef]; exact Finset.card_image_le
    rw [Finset.offDiag_card, Finset.card_univ] at h1
    have h2 : Fintype.card G ^ 2 + 1 ≤ Nat.card K ^ n := le_trans (le_max_right _ _) hQn
    have h3 : Fintype.card G * Fintype.card G - Fintype.card G ≤ Fintype.card G ^ 2 := by
      rw [pow_two]; exact Nat.sub_le _ _
    omega
  obtain ⟨c, hc, hcW⟩ := wc_fetg_twist_vector K n hn1 G g₀ (lwtrGenField (AlgebraicClosure K))
    W hW0 hWq
  obtain ⟨Rm, D, hRmB, hDB, hspec⟩ := hB c
  have hspecO := hspec (lwtrGenField (AlgebraicClosure K)) (wcFetgU K) r hfr

  have hΘ : ∀ g, (∑ k, algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (c k) *
      wcFetgEvO K (P k) (r g)) = wcFetgHO K h ^ e *
      ∑ k, algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (c k) * r (g * k) := by
    intro g
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [hPr g k]
    ring
  have hθ : Function.Injective (fun g => ∑ k,
      algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (c k) *
        wcFetgEvO K (P k) (r g)) := by
    intro g g' hgg
    by_contra hne
    simp only [hΘ] at hgg
    have hmem : (fun k => r (g * k) - r (g' * k)) ∈ W := by
      rw [hWdef]
      exact Finset.mem_image.mpr
        ⟨(g, g'), Finset.mem_offDiag.mpr ⟨Finset.mem_univ _, Finset.mem_univ _, hne⟩, rfl⟩
    apply hcW _ hmem
    have hpow : wcFetgHO K h ^ e ≠ 0 := pow_ne_zero _ hhO
    have h1 := mul_left_cancel₀ hpow hgg
    simp only [mul_sub, Finset.sum_sub_distrib, h1, sub_self]
  have hD : D ≠ 0 := by
    intro hD0
    have h2 := hspecO.2
    rw [hD0, map_zero] at h2
    refine (Finset.prod_ne_zero_iff.mpr ?_) h2.symm
    intro p hp
    rw [Finset.mem_offDiag] at hp
    exact sub_ne_zero.mpr (fun heq => hp.2.2 (hθ heq))

  obtain ⟨P', hP'irr, hP'dvd, hP'fix, hP'deg⟩ := wc_fetg_orbit_factor K G h e f P n hn1 g₀ r H ρ Φ
    hr hhO hfr hPr hΦc hΦu hΦr hH1 hH2 hρH hΦev hint γ₀ hγ₀ hg₀ c hc hθ Rm hspecO.1

  have hcount := hQ₀' K n P' hn1 hP'irr (le_trans hP'deg hRmB) hP'fix
    (le_trans (le_max_left _ _) hQn)
  have htrans := wc_fetg_point_transfer K G h e f P hh hf hdegF hPW hfib n hn1 g₀ c hc Rm D hspec
    hD P' hP'dvd

  refine ⟨n, hn1, ?_⟩
  rw [hdegF]
  have hM : (h.natDegree + D.natDegree) * Fintype.card G ≤ (h.natDegree + B) * Fintype.card G :=
    Nat.mul_le_mul_right _ (Nat.add_le_add_left hDB _)
  generalize Fintype.card G * ∑ d ∈ n.properDivisors, (Nat.card K ^ d + 1) = A at hgrow ⊢
  generalize (h.natDegree + D.natDegree) * Fintype.card G = M1 at hM htrans
  generalize (h.natDegree + B) * Fintype.card G = M2 at hM hgrow
  omega

theorem wc_cheb_fet_galois : ∀ (K : Type u) [Field K] [Finite K] (Uo : (wcP1Over K).left.Opens)
    (Z : Scheme.{u}) (πZ : Z ⟶ Uo.toScheme) (G : Type) [Group G] [Finite G] (act : G → (Z ⟶ Z)),
    IsFinite πZ → Etale πZ → ConnectedSpace Z → act 1 = 𝟙 Z →
    (∀ g g', act (g * g') = act g ≫ act g') → (∀ g, act g ≫ πZ = πZ) →
    (∀ (T : Scheme.{u}), ConnectedSpace T → ∀ (a b : T ⟶ Z), a ≫ πZ = b ≫ πZ →
      ∃! g, b = a ≫ act g) →
    ∀ g₀ : G, ∃ (d : ℕ) (x : (wcP1Over K).left) (z : Z), 1 ≤ d ∧ x ∈ wcP1ClosedPt K d ∧
      Uo.ι (πZ z) = x ∧ wcIsFrobAt (act g₀) z (Nat.card K ^ d) ∧
      ∀ (z' : Z) (y : G), Uo.ι (πZ z') = x → wcIsFrobAt (act y) z' (Nat.card K ^ d) →
        ∃ y' : G, y = y' * g₀ * y'⁻¹ :=
by
  intro K _ _ Uo Z πZ G _ _ act hfin het hZc hact1 hactm hactπ htors g₀
  classical

  obtain ⟨h, e, f, P, Ξ, hh0, hfm, hfdeg, hirr, hpts⟩ :=
    wc_fetg_chart_presentation K Uo Z πZ G act hfin het hZc hact1 hactm hactπ htors

  obtain ⟨n, hn1, hlt⟩ := wc_fetg_poly_chebotarev K G h e f P hh0 hfm hfdeg hirr
    (fun u₀ v₀ hu hv => ⟨(hpts u₀ v₀ hu hv).1, (hpts u₀ v₀ hu hv).2.1,
      (hpts u₀ v₀ hu hv).2.2.1⟩) g₀

  obtain ⟨hLfin, hLcard⟩ := wc_fetg_low_count K h f n hfm

  have pick : ∀ (A B : AlgebraicClosure K × AlgebraicClosure K → Prop),
      {p | B p}.Finite → Nat.card {p // B p} < Nat.card {p // A p} → ∃ p, A p ∧ ¬ B p := by
    intro A B hB hlt'
    by_contra hcon
    have hs : {p | A p} ⊆ {p | B p} := fun p hp => by
      by_contra hb
      exact hcon ⟨p, hp, hb⟩
    have hle : Nat.card {p | A p} ≤ Nat.card {p | B p} := Nat.card_mono hB hs
    exact absurd (lt_of_lt_of_le hlt' hle) (lt_irrefl _)
  obtain ⟨p, hpA, hpB⟩ := pick _ _ hLfin (lt_of_le_of_lt hLcard hlt)
  have hnod : ∀ d ∈ n.properDivisors, ¬ p.1 ^ (Nat.card K ^ d) = p.1 :=
    fun d hd hd' => hpB ⟨hpA.1, hpA.2.1, d, hd, hd'⟩

  letI : Fintype K := Fintype.ofFinite K
  have hfrob : ∀ m : ℕ, ∃ φ : AlgebraicClosure K →+* AlgebraicClosure K,
      ∀ c, φ c = c ^ (Nat.card K ^ m) := by
    intro m
    induction m with
    | zero => exact ⟨RingHom.id _, fun c => by simp⟩
    | succ m ih =>
      obtain ⟨φ, hφ⟩ := ih
      have h1 : ∀ x : AlgebraicClosure K,
          (FiniteField.frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K)) x =
            x ^ Fintype.card K := fun x => by
        rw [FiniteField.coe_frobeniusAlgEquivOfAlgebraic]
      refine ⟨(FiniteField.frobeniusAlgEquivOfAlgebraic K
        (AlgebraicClosure K)).toRingEquiv.toRingHom.comp φ, fun c => ?_⟩
      rw [RingHom.comp_apply, hφ]
      show (FiniteField.frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K))
        (c ^ Nat.card K ^ m) = _
      rw [h1, Fintype.card_eq_nat_card, ← pow_mul, pow_succ]
  obtain ⟨φn, hφn⟩ := hfrob n
  have hgood := hpts p.1 p.2 hpA.1 hpA.2.1
  have hover := hgood.2.2.2.1
  have hcl := hgood.2.2.2.2

  have htw : Spec.map (CommRingCat.ofHom φn) ≫ Ξ p.1 p.2 = Ξ p.1 p.2 ≫ act g₀ :=
    (hcl n φn hφn).2 g₀ hpA.2.2.1 hpA.2.2.2
  have hFrob := (wc_fetg_frob_criterion Z (act g₀) (AlgebraicClosure K) (Nat.card K ^ n) φn
    hφn).1 (Ξ p.1 p.2) htw

  have hbK : (Ξ p.1 p.2 ≫ πZ ≫ Uo.ι) ≫ (wcP1Over K).hom =
      Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) := by
    simpa only [Category.assoc] using hover
  have hx := wc_fetg_frob_fixed_degree K (Ξ p.1 p.2 ≫ πZ ≫ Uo.ι) hbK n hn1
    (fun φ hφ => (hcl n φ hφ).1.mpr hpA.2.2.1)
    (fun d hd φ hφ heq => hnod d hd ((hcl d φ hφ).1.mp heq))
  have hxz : Uo.ι (πZ (Ξ p.1 p.2 (IsLocalRing.closedPoint (AlgebraicClosure K)))) =
      (Ξ p.1 p.2 ≫ πZ ≫ Uo.ι) (IsLocalRing.closedPoint (AlgebraicClosure K)) := by
    first
    | rfl
    | (erw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply])
    | (simp only [Scheme.Hom.comp_apply])
  refine ⟨n, (Ξ p.1 p.2 ≫ πZ ≫ Uo.ι) (IsLocalRing.closedPoint (AlgebraicClosure K)),
    Ξ p.1 p.2 (IsLocalRing.closedPoint (AlgebraicClosure K)), hn1, hx, hxz, hFrob, ?_⟩

  intro z' y hz' hy
  exact wc_fetg_frob_conj K Uo Z πZ G act hfin hactm hactπ htors n _ z' g₀ y
    (hxz.trans hz'.symm) hFrob hy

theorem wc_vqmc_cheb_density (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (φ : W ⟶ W) (hB : wcVQGalFrame D ℓ hP W w r θ φ)
    (Γ : Subgroup (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (Φ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (hΦ : wcVQFrame D ℓ hP W r θ φ (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
    (hΓ : ∀ h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ, h ∈ Γ ↔
      ∃ γ : W ⟶ W, γ ≫ w = w ∧ wcVQFrame D ℓ hP W r θ γ (h : Matrix (Fin r) (Fin r) ℚ_[ℓ])) :
    ∀ (k : ℤ), ∀ h ∈ Γ, ∀ (N t : ℕ), 1 ≤ N →
      ∃ (d : ℕ) (x : (wcP1Over F'').left), 1 ≤ d ∧ x ∈ wcP1ClosedPt F'' d ∧
        (∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) ∧ (N : ℤ) ∣ (d : ℤ) - k ∧
        ∀ (Nx : wcFrobNbhd F'' x d) (ι : Nx.V ⟶ W) (δ : W ⟶ W)
          (u : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ), δ ≫ w = w → u ∈ Γ →
          wcVQFrame D ℓ hP W r θ ((fun γ : W ⟶ W => φ ≫ γ)^[d] (𝟙 W) ≫ δ)
            ((u * Φ ^ d : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) →
          Nx.φ ≫ ι = ι ≫ ((fun γ : W ⟶ W => φ ≫ γ)^[d] (𝟙 W) ≫ δ) →
          ∃ (c : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (j : ℤ), c ∈ Γ ∧
            ∀ a b, ‖((Φ ^ j * c * (Φ ^ (-(d : ℤ)) * u⁻¹) * (Φ ^ j * c)⁻¹ :
                (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b -
              ((Φ ^ (-k) * h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
                Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(t : ℤ)) :=
by
  classical
