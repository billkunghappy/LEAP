theorem wc_pcl_Y_int_comparison_act (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {Y : Scheme.{u}} (qb : Y ⟶ (wcP1Over K).left) (hqb : IsFinite qb)
    (hYp : IsProper (qb ≫ (wcP1Over K).hom))
    (a : Y ⟶ Y) (ha : a ≫ qb = qb)
    (hY : WeaklyEtale (Limits.pullback.fst (wcPclYo K qb).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (L : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
    (adj : L ⊣ wcProEtPush qb) [L.Additive] [Limits.PreservesFiniteLimits L]
    [Limits.PreservesFiniteColimits L]
    (θP : L.obj (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) ≅
      wcFreeSheaf Y ((wcProEtPullback qb).obj (wcGeomPoint K (wcP1Over K) hP)))
    (hθ : L.map (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)) ≫ θP.hom =
      θP.hom ≫ wcFreeSheafMap Y ((wcProEtPullback qb).map (wcGeomFrob K (wcP1Over K) hP)))
    (e : wcGeomPoint K (wcPclYo K qb) hY ≅ (wcProEtPullback qb).obj (wcGeomPoint K (wcP1Over K) hP))
    (he : e.hom ≫ (wcProEtPullback qb).map (wcGeomFrob K (wcP1Over K) hP) =
      wcGeomFrob K (wcPclYo K qb) hY ≫ e.hom)
    (i : ℕ) :
    ∃ T : wcCohG K (wcPclYo K qb) hY (wcIntSheaf Y ℓ) i ≃+ wcIntExt (wcXbar K (wcPclYo K qb)) ℓ i,
      (∀ (Dg : wcIntPullData (wcGeomFrobX K (wcPclYo K qb) hY) ℓ), wcIntPullCanonical Dg →
        ∀ y, T (wcCohGFrob K (wcPclYo K qb) hY (wcIntSheaf Y ℓ) i y) = wcIntPull Dg i (T y)) ∧
      (∀ (Da : wcIntPullData (wcPclAbar K qb a ha) ℓ), wcIntPullCanonical Da →
        ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
            ((wcProEtPush qb).obj (wcIntSheaf Y ℓ)) i,
          T (wcPushTransfer qb (wcIntSheaf Y ℓ) L adj (wcFreeSheafMap Y e.hom ≫ θP.inv) i
              (x.comp (Abelian.Ext.mk₀ (wcPclRhoA qb ℓ a ha)) (add_zero i))) =
            wcIntPull Da i (T (wcPushTransfer qb (wcIntSheaf Y ℓ) L adj
              (wcFreeSheafMap Y e.hom ≫ θP.inv) i x))) :=
by
  classical

  haveI : IsFinite qb := hqb
  haveI : IsLocallyNoetherian (wcP1Over K).left := (wc_projK_integral_normal K 1).2.2.2
  haveI : LocallyOfFinitePresentation qb := inferInstance
  haveI hPushC : Limits.PreservesFiniteColimits (wcProEtPush qb) := wc_proet_push_finite_exact qb
  haveI : (wcProEtPush qb).IsRightAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : Limits.PreservesFiniteLimits (wcProEtPush qb) := inferInstance
  haveI : (wcProEtPush qb).Additive := Functor.additive_of_preserves_binary_products _
  let FrY : Y.ProEt ⥤ Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} :=
    yoneda ⋙ (Functor.whiskeringRight _ _ _).obj (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⋙
      presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}
  have hFr : ∀ {U V : Y.ProEt} (f : U ⟶ V), wcFreeSheafMap Y f = FrY.map f := fun f => rfl
  have hcomp : ∀ {U V W : Y.ProEt} (f : U ⟶ V) (g : V ⟶ W),
      wcFreeSheafMap Y f ≫ wcFreeSheafMap Y g = wcFreeSheafMap Y (f ≫ g) := by
    intro U V W f g
    rw [hFr, hFr, hFr]
    exact (FrY.map_comp f g).symm
  let P0 := wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)
  let A := wcIntSheaf Y ℓ

  have hτ := ext_transfer_of_hom_bijective L (wcProEtPush qb) adj P0 (L.obj P0) (adj.unit.app P0)
    (fun Z => by
      have h1 : (fun f : L.obj P0 ⟶ Z => adj.unit.app P0 ≫ (wcProEtPush qb).map f) =
          ⇑(adj.homEquiv P0 Z) := funext fun f => (adj.homEquiv_unit P0 Z f).symm
      rw [h1]
      exact (adj.homEquiv P0 Z).bijective) A i
  have hleft : ∀ β : Abelian.Ext (L.obj P0) A i,
      (Abelian.Ext.mapExactFunctor L ((Abelian.Ext.mk₀ (adj.unit.app P0)).comp
        (Abelian.Ext.mapExactFunctor (wcProEtPush qb) β) (zero_add i))).comp
        (Abelian.Ext.mk₀ (adj.counit.app A)) (add_zero i) = β := by
    intro β
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor,
      Abelian.Ext.comp_assoc _ _ _ (zero_add i) (add_zero i) (by omega),
      Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp β adj.counit,
      Abelian.Ext.id_mapExactFunctor,
      ← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add i) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]
    erw [adj.left_triangle_components P0]
    exact Abelian.Ext.mk₀_id_comp β
  have hb' : Function.Bijective (fun x : Abelian.Ext P0 ((wcProEtPush qb).obj A) i =>
      (Abelian.Ext.mapExactFunctor L x).comp (Abelian.Ext.mk₀ (adj.counit.app A)) (add_zero i)) := by
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun β => (Abelian.Ext.mk₀ (adj.unit.app P0)).comp
        (Abelian.Ext.mapExactFunctor (wcProEtPush qb) β) (zero_add i), ?_, hleft⟩
    exact Function.LeftInverse.rightInverse_of_surjective hleft hτ.2
  have hbijψ : ∀ (ψ : wcFreeSheaf Y (wcGeomPoint K (wcPclYo K qb) hY) ⟶ L.obj P0), IsIso ψ →
      Function.Bijective (wcPushTransfer qb A L adj ψ i) := by
    intro ψ hψ
    have hpre : Function.Bijective (fun z : Abelian.Ext (L.obj P0) A i =>
        (Abelian.Ext.mk₀ ψ).comp z (zero_add i)) := by
      refine Function.bijective_iff_has_inverse.mpr
        ⟨fun z => (Abelian.Ext.mk₀ (inv ψ)).comp z (zero_add i), fun z => ?_, fun z => ?_⟩
      · show (Abelian.Ext.mk₀ (inv ψ)).comp ((Abelian.Ext.mk₀ ψ).comp z (zero_add i))
          (zero_add i) = z
        rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add i) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      · show (Abelian.Ext.mk₀ ψ).comp ((Abelian.Ext.mk₀ (inv ψ)).comp z (zero_add i))
          (zero_add i) = z
        rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add i) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    exact hpre.comp hb'
  have hFrobψ : ∀ (ψ : wcFreeSheaf Y (wcGeomPoint K (wcPclYo K qb) hY) ⟶ L.obj P0),
      ψ ≫ L.map (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)) =
        wcFreeSheafMap Y (wcGeomFrob K (wcPclYo K qb) hY) ≫ ψ →
      ∀ x : Abelian.Ext P0 ((wcProEtPush qb).obj A) i,
      wcPushTransfer qb A L adj ψ i
          ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left
            (wcGeomFrob K (wcP1Over K) hP))).comp x (zero_add i)) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap Y (wcGeomFrob K (wcPclYo K qb) hY))).comp
          (wcPushTransfer qb A L adj ψ i x) (zero_add i) := by
    intro ψ hψ x
    show (Abelian.Ext.mk₀ ψ).comp ((Abelian.Ext.mapExactFunctor L
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left
            (wcGeomFrob K (wcP1Over K) hP))).comp x (zero_add i))).comp
          (Abelian.Ext.mk₀ (adj.counit.app A)) (add_zero i)) (zero_add i) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap Y (wcGeomFrob K (wcPclYo K qb) hY))).comp
        ((Abelian.Ext.mk₀ ψ).comp ((Abelian.Ext.mapExactFunctor L x).comp
          (Abelian.Ext.mk₀ (adj.counit.app A)) (add_zero i)) (zero_add i)) (zero_add i)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (zero_add i) (add_zero i) (by omega),
      ← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add i) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, hψ, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add i) (by omega)]
  have hcompat : ∀ (θ' : L.obj P0 ≅
        wcFreeSheaf Y ((wcProEtPullback qb).obj (wcGeomPoint K (wcP1Over K) hP)))
      (e' : wcGeomPoint K (wcPclYo K qb) hY ≅
        (wcProEtPullback qb).obj (wcGeomPoint K (wcP1Over K) hP)),
      L.map (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)) ≫ θ'.hom =
        θ'.hom ≫ wcFreeSheafMap Y ((wcProEtPullback qb).map (wcGeomFrob K (wcP1Over K) hP)) →
      e'.hom ≫ (wcProEtPullback qb).map (wcGeomFrob K (wcP1Over K) hP) =
        wcGeomFrob K (wcPclYo K qb) hY ≫ e'.hom →
      (wcFreeSheafMap Y e'.hom ≫ θ'.inv) ≫
          L.map (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)) =
        wcFreeSheafMap Y (wcGeomFrob K (wcPclYo K qb) hY) ≫ (wcFreeSheafMap Y e'.hom ≫ θ'.inv) := by
    intro θ' e' hθ' he'
    have h1 : θ'.inv ≫
        L.map (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)) =
        wcFreeSheafMap Y ((wcProEtPullback qb).map (wcGeomFrob K (wcP1Over K) hP)) ≫ θ'.inv := by
      rw [Iso.inv_comp_eq, ← Category.assoc, Iso.eq_comp_inv]
      exact hθ'
    have h2 : wcFreeSheafMap Y e'.hom ≫
        wcFreeSheafMap Y ((wcProEtPullback qb).map (wcGeomFrob K (wcP1Over K) hP)) =
        wcFreeSheafMap Y (wcGeomFrob K (wcPclYo K qb) hY) ≫ wcFreeSheafMap Y e'.hom := by
      rw [hcomp, hcomp, he']
    rw [Category.assoc, h1, ← Category.assoc, h2, Category.assoc]
  have hiso : ∀ (θ' : L.obj P0 ≅
        wcFreeSheaf Y ((wcProEtPullback qb).obj (wcGeomPoint K (wcP1Over K) hP)))
      (e' : wcGeomPoint K (wcPclYo K qb) hY ≅
        (wcProEtPullback qb).obj (wcGeomPoint K (wcP1Over K) hP)),
      IsIso (wcFreeSheafMap Y e'.hom ≫ θ'.inv) := by
    intro θ' e'
    have h : wcFreeSheafMap Y e'.hom ≫ θ'.inv = ((FrY.mapIso e') ≪≫ θ'.symm).hom := rfl
    rw [h]
    exact Iso.isIso_hom _

  obtain ⟨θ₀, hθ₀N, hθ₀nat⟩ := wc_push_free_norm_exists qb L adj
  obtain ⟨e₀, he₀, hea⟩ := wc_pcl_ref_point_iso K hP qb a ha hY

  obtain ⟨Φ, hΦbij, hΦnat, hΦres⟩ := wc_int_free_ext_model.{u} ℓ i
  let T₀ : Abelian.Ext (wcFreeSheaf Y (wcGeomPoint K (wcPclYo K qb) hY)) A i ≃+
      wcIntExt (wcXbar K (wcPclYo K qb)) ℓ i :=
    (AddEquiv.ofBijective (Φ Y (wcGeomPoint K (wcPclYo K qb) hY))
      (hΦbij Y (wcGeomPoint K (wcPclYo K qb) hY))).symm
  have hT₀ : ∀ w, T₀ (Φ Y (wcGeomPoint K (wcPclYo K qb) hY) w) = w := fun w =>
    (AddEquiv.ofBijective (Φ Y (wcGeomPoint K (wcPclYo K qb) hY))
      (hΦbij Y (wcGeomPoint K (wcPclYo K qb) hY))).symm_apply_apply w
  let ψ := wcFreeSheafMap Y e.hom ≫ θP.inv
  let ψ₀ := wcFreeSheafMap Y e₀.hom ≫ (θ₀ (wcGeomPoint K (wcP1Over K) hP)).inv
  have hψF : ψ ≫ L.map (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)) =
      wcFreeSheafMap Y (wcGeomFrob K (wcPclYo K qb) hY) ≫ ψ := hcompat θP e hθ he
  have hψ₀F : ψ₀ ≫ L.map (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)) =
      wcFreeSheafMap Y (wcGeomFrob K (wcPclYo K qb) hY) ≫ ψ₀ :=
    hcompat (θ₀ (wcGeomPoint K (wcP1Over K) hP)) e₀ (hθ₀nat (wcGeomFrob K (wcP1Over K) hP)) he₀
  let Θ := AddEquiv.ofBijective (wcPushTransfer qb A L adj ψ i) (hbijψ ψ (hiso θP e))
  let Θ' := AddEquiv.ofBijective (wcPushTransfer qb A L adj ψ₀ i)
    (hbijψ ψ₀ (hiso (θ₀ (wcGeomPoint K (wcP1Over K) hP)) e₀))
  have key : ∀ w, (Θ.symm.trans (Θ'.trans T₀)) (wcPushTransfer qb A L adj ψ i w) =
      T₀ (wcPushTransfer qb A L adj ψ₀ i w) := by
    intro w
    show T₀ (Θ' (Θ.symm (Θ w))) = T₀ (Θ' w)
    rw [Θ.symm_apply_apply]
  refine ⟨Θ.symm.trans (Θ'.trans T₀), ?_, ?_⟩
  ·
    intro Dg hDg y
    obtain ⟨u, rfl⟩ := (hbijψ ψ (hiso θP e)).2 y
    have e1 : wcCohGFrob K (wcPclYo K qb) hY (wcIntSheaf Y ℓ) i (wcPushTransfer qb A L adj ψ i u) =
        wcPushTransfer qb A L adj ψ i
          ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left
            (wcGeomFrob K (wcP1Over K) hP))).comp u (zero_add i)) :=
      (hFrobψ ψ hψF u).symm
    obtain ⟨z, hz⟩ := (hΦbij Y (wcGeomPoint K (wcPclYo K qb) hY)).2
      (wcPushTransfer qb A L adj ψ₀ i u)
    have e2 := hFrobψ ψ₀ hψ₀F u
    rw [← hz] at e2
    show (Θ.symm.trans (Θ'.trans T₀)) (wcCohGFrob K (wcPclYo K qb) hY (wcIntSheaf Y ℓ) i
        (wcPushTransfer qb A L adj ψ i u)) =
      wcIntPull Dg i ((Θ.symm.trans (Θ'.trans T₀)) (wcPushTransfer qb A L adj ψ i u))
    rw [e1, key, key, e2, hΦnat Y (wcGeomFrob K (wcPclYo K qb) hY) Dg hDg z, hT₀]
    exact congrArg (wcIntPull Dg i) (by rw [← hz]; exact (hT₀ z).symm)
  ·
    intro Da hDa x
    show (Θ.symm.trans (Θ'.trans T₀)) (wcPushTransfer qb A L adj ψ i
        (x.comp (Abelian.Ext.mk₀ (wcPclRhoA qb ℓ a ha)) (add_zero i))) =
      wcIntPull Da i ((Θ.symm.trans (Θ'.trans T₀)) (wcPushTransfer qb A L adj ψ i x))
    rw [key, key]
    obtain ⟨La, adja, hLa, -, -⟩ := wc_proet_push_left_adjoint_free_nat a
    haveI := hLa
    haveI : (wcProEtPush a).IsRightAdjoint := ⟨_, ⟨adja⟩⟩
    haveI : Limits.PreservesFiniteLimits (wcProEtPush a) := inferInstance
    haveI : (wcProEtPush a).Additive := Functor.additive_of_preserves_binary_products _
    haveI : La.Additive := adja.left_adjoint_additive
    haveI : La.IsLeftAdjoint := ⟨_, ⟨adja⟩⟩
    haveI : Limits.PreservesFiniteColimits La := inferInstance
    obtain ⟨θa, hθaN, -⟩ := wc_push_free_norm_exists a La adja
    obtain ⟨s, hs, hlaw⟩ := wc_pcl_push_transfer_act_law K hP ℓ qb hqb a ha hY L adj θ₀ hθ₀N
      La adja θa hθaN e₀ hea i
    obtain ⟨z, hz⟩ := (hΦbij Y (wcGeomPoint K (wcPclYo K qb) hY)).2
      (wcPushTransfer qb A L adj ψ₀ i x)
    have hlaw' : wcPushTransfer qb A L adj ψ₀ i
        (x.comp (Abelian.Ext.mk₀ (wcPclRhoA qb ℓ a ha)) (add_zero i)) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap Y s)).comp
          (wcProEtRes a La adja θa ℤ_[ℓ] (wcGeomPoint K (wcPclYo K qb) hY) i
            (Φ Y (wcGeomPoint K (wcPclYo K qb) hY) z)) (zero_add i) := by
      rw [hz]
      exact hlaw x
    obtain ⟨D1, hD1⟩ := wc_int_pull_data_exists
      (Limits.pullback.fst (wcGeomPoint K (wcPclYo K qb) hY).hom a) ℓ
    obtain ⟨D2, hD2⟩ := wc_int_pull_data_exists s.left ℓ
    rw [hlaw', ← hz, hΦres a La adja θa hθaN (wcGeomPoint K (wcPclYo K qb) hY) D1 hD1 z]
    have h3 := hΦnat Y s D2 hD2 (wcIntPull D1 i z)
    exact (congrArg T₀ h3).trans ((hT₀ _).trans
      ((wc_int_pull_comp (Limits.pullback.fst (wcGeomPoint K (wcPclYo K qb) hY).hom a)
        s.left (wcPclAbar K qb a ha) hs D1 hD1 D2 hD2 Da hDa i z).symm.trans
        (congrArg (wcIntPull Da i) (hT₀ z).symm)))

theorem wc_pcl_cover_int_comparison (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {Y : Scheme.{u}} (qb : Y ⟶ (wcP1Over K).left) (hqb : IsFinite qb)
    (hYp : IsProper (qb ≫ (wcP1Over K).hom))
    (a : Y ⟶ Y) (ha : a ≫ qb = qb)
    (hY : WeaklyEtale (Limits.pullback.fst (wcPclYo K qb).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (i : ℕ) :
    ∃ Θ : wcCohG K (wcP1Over K) hP (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) i ≃+
        wcIntExt (wcXbar K (wcPclYo K qb)) ℓ i,
      (∀ (Dg : wcIntPullData (wcGeomFrobX K (wcPclYo K qb) hY) ℓ), wcIntPullCanonical Dg →
        ∀ x, Θ (wcCohGFrob K (wcP1Over K) hP
            (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) i x) = wcIntPull Dg i (Θ x)) ∧
      (∀ (Da : wcIntPullData (wcPclAbar K qb a ha) ℓ), wcIntPullCanonical Da →
        ∀ x, Θ (wcCohGEnd K (wcP1Over K) hP (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) i
            (wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ a ha) x) = wcIntPull Da i (Θ x)) :=
by
  classical

  haveI : IsFinite qb := hqb
  haveI : IsLocallyNoetherian (wcP1Over K).left := (wc_projK_integral_normal K 1).2.2.2
  haveI : LocallyOfFinitePresentation qb := inferInstance
  haveI hPushC : Limits.PreservesFiniteColimits (wcProEtPush qb) := wc_proet_push_finite_exact qb
  obtain ⟨L, adj, hLlim, θ, hθ⟩ := wc_proet_push_left_adjoint_free_nat qb
  haveI := hLlim
  haveI : (wcProEtPush qb).IsRightAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : L.IsLeftAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : Limits.PreservesFiniteLimits (wcProEtPush qb) := inferInstance
  haveI : Limits.PreservesFiniteColimits L := inferInstance
  haveI : (wcProEtPush qb).Additive := Functor.additive_of_preserves_binary_products _
  haveI : L.Additive := adj.left_adjoint_additive
  obtain ⟨e, he⟩ : ∃ e : wcGeomPoint K (wcPclYo K qb) hY ≅
      (wcProEtPullback qb).obj (wcGeomPoint K (wcP1Over K) hP),
      e.hom ≫ (wcProEtPullback qb).map (wcGeomFrob K (wcP1Over K) hP) =
        wcGeomFrob K (wcPclYo K qb) hY ≫ e.hom :=
    wc_geomPoint_pullback_iso K (wcP1Over K) (wcPclYo K qb) (Over.homMk qb rfl) hP hY

  have hsub : ∀ T : ((wcP1Over K).left.ProEt)ᵒᵖ, wcExtZeroSub (wcCoverBasePre qb ℓ)
      (fun T : (wcP1Over K).left.ProEt => ∀ t, T.hom t ∉ (∅ : Set (wcP1Over K).left)) T = ⊤ := by
    intro T
    unfold wcExtZeroSub
    exact iSup_pos (fun t => Set.notMem_empty _)
  let ι : wcExtZeroPre (wcCoverBasePre qb ℓ)
        (fun T : (wcP1Over K).left.ProEt => ∀ t, T.hom t ∉ (∅ : Set (wcP1Over K).left))
        (fun g h t => by rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]; exact h _) ≅
      (wcProEtBaseChange qb).op ⋙ (wcIntSheaf Y ℓ).val :=
    NatIso.ofComponents
      (fun T =>
        { hom := AddCommGrpCat.ofHom (wcExtZeroSub (wcCoverBasePre qb ℓ)
              (fun T : (wcP1Over K).left.ProEt => ∀ t, T.hom t ∉ (∅ : Set (wcP1Over K).left)) T).subtype
          inv := AddCommGrpCat.ofHom (AddMonoidHom.codRestrict (AddMonoidHom.id _)
              (wcExtZeroSub (wcCoverBasePre qb ℓ)
                (fun T : (wcP1Over K).left.ProEt => ∀ t, T.hom t ∉ (∅ : Set (wcP1Over K).left)) T)
              (fun x => by rw [hsub T]; exact AddSubgroup.mem_top x))
          hom_inv_id := by ext x; apply Subtype.ext; rfl
          inv_hom_id := by ext x; rfl })
      (by intro T T' g; ext x; rfl)
  let κ : wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ ≅
      (wcProEtPush qb).obj (wcIntSheaf Y ℓ) :=
    (presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}).mapIso ι
  have hκ : wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ a ha ≫ κ.hom =
      κ.hom ≫ wcPclRhoA qb ℓ a ha := by
    have h : wcExtZeroMap (Functor.whiskerRight (NatTrans.op (wcPbAct qb a ha))
          (continuousMapPresheafAb.{0, u} ℤ_[ℓ] ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}))
        (fun T : (wcP1Over K).left.ProEt => ∀ t, T.hom t ∉ (∅ : Set (wcP1Over K).left))
        (fun g h t => by rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]; exact h _) ≫
          ι.hom =
        ι.hom ≫ ((Functor.whiskerRight (NatTrans.op (wcPbAct qb a ha))
          (continuousMapPresheafAb.{0, u} ℤ_[ℓ] ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) :
          wcCoverBasePre qb ℓ ⟶ wcCoverBasePre qb ℓ) :
          (wcProEtBaseChange qb).op ⋙ (wcIntSheaf Y ℓ).val ⟶
            (wcProEtBaseChange qb).op ⋙ (wcIntSheaf Y ℓ).val) := by
      ext T x
      rfl
    have h2 := congrArg
      (fun f => (presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}).map f) h
    exact ((Functor.map_comp _ _ _).symm.trans h2).trans (Functor.map_comp _ _ _)
  let Θ₁ : wcCohG K (wcP1Over K) hP (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) i ≃+
      Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
        ((wcProEtPush qb).obj (wcIntSheaf Y ℓ)) i :=
    { toFun := fun x => x.comp (Abelian.Ext.mk₀ κ.hom) (add_zero i)
      invFun := fun y => y.comp (Abelian.Ext.mk₀ κ.inv) (add_zero i)
      left_inv := fun x => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      right_inv := fun y => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
      map_add' := fun x y => Abelian.Ext.add_comp _ _ _ _ }
  have hΘ₁ : ∀ x, Θ₁ x = x.comp (Abelian.Ext.mk₀ κ.hom) (add_zero i) := fun x => rfl

  let FrY : Y.ProEt ⥤ Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} :=
    yoneda ⋙ (Functor.whiskeringRight _ _ _).obj (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⋙
      presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}
  have hFr : ∀ {U V : Y.ProEt} (f : U ⟶ V), wcFreeSheafMap Y f = FrY.map f := fun f => rfl
  let P0 := wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)
  let A := wcIntSheaf Y ℓ
  let Ψ : wcFreeSheaf Y (wcGeomPoint K (wcPclYo K qb) hY) ≅ L.obj P0 :=
    (FrY.mapIso e).trans (θ (wcGeomPoint K (wcP1Over K) hP)).symm
  have hΨ : Ψ.hom = wcFreeSheafMap Y e.hom ≫ (θ (wcGeomPoint K (wcP1Over K) hP)).inv := rfl
  have hΘ₂ : ∀ x, wcPushTransfer qb A L adj
      (wcFreeSheafMap Y e.hom ≫ (θ (wcGeomPoint K (wcP1Over K) hP)).inv) i x =
      (Abelian.Ext.mk₀ (wcFreeSheafMap Y e.hom ≫ (θ (wcGeomPoint K (wcP1Over K) hP)).inv)).comp
        ((Abelian.Ext.mapExactFunctor L x).comp (Abelian.Ext.mk₀ (adj.counit.app A)) (add_zero i))
        (zero_add i) := fun x => rfl
  have hτ := ext_transfer_of_hom_bijective L (wcProEtPush qb) adj P0 (L.obj P0) (adj.unit.app P0)
    (fun Z => by
      have h1 : (fun f : L.obj P0 ⟶ Z => adj.unit.app P0 ≫ (wcProEtPush qb).map f) =
          ⇑(adj.homEquiv P0 Z) := funext fun f => (adj.homEquiv_unit P0 Z f).symm
      rw [h1]
      exact (adj.homEquiv P0 Z).bijective) A i
  have hleft : ∀ β : Abelian.Ext (L.obj P0) A i,
      (Abelian.Ext.mapExactFunctor L ((Abelian.Ext.mk₀ (adj.unit.app P0)).comp
        (Abelian.Ext.mapExactFunctor (wcProEtPush qb) β) (zero_add i))).comp
        (Abelian.Ext.mk₀ (adj.counit.app A)) (add_zero i) = β := by
    intro β
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor,
      Abelian.Ext.comp_assoc _ _ _ (zero_add i) (add_zero i) (by omega),
      Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp β adj.counit,
      Abelian.Ext.id_mapExactFunctor,
      ← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add i) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]
    erw [adj.left_triangle_components P0]
    exact Abelian.Ext.mk₀_id_comp β
  have hb' : Function.Bijective (fun x : Abelian.Ext P0 ((wcProEtPush qb).obj A) i =>
      (Abelian.Ext.mapExactFunctor L x).comp (Abelian.Ext.mk₀ (adj.counit.app A)) (add_zero i)) := by
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun β => (Abelian.Ext.mk₀ (adj.unit.app P0)).comp
        (Abelian.Ext.mapExactFunctor (wcProEtPush qb) β) (zero_add i), ?_, hleft⟩
    exact Function.LeftInverse.rightInverse_of_surjective hleft hτ.2
  have hpre : Function.Bijective (fun z : Abelian.Ext (L.obj P0) A i =>
      (Abelian.Ext.mk₀ (wcFreeSheafMap Y e.hom ≫ (θ (wcGeomPoint K (wcP1Over K) hP)).inv)).comp
        z (zero_add i)) := by
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun z => (Abelian.Ext.mk₀ Ψ.inv).comp z (zero_add i), fun z => ?_, fun z => ?_⟩
    · show (Abelian.Ext.mk₀ Ψ.inv).comp ((Abelian.Ext.mk₀ Ψ.hom).comp z (zero_add i))
        (zero_add i) = z
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add i) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    · show (Abelian.Ext.mk₀ Ψ.hom).comp ((Abelian.Ext.mk₀ Ψ.inv).comp z (zero_add i))
        (zero_add i) = z
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add i) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
  have hbij : Function.Bijective (wcPushTransfer qb A L adj
      (wcFreeSheafMap Y e.hom ≫ (θ (wcGeomPoint K (wcP1Over K) hP)).inv) i) := by
    rw [show ⇑(wcPushTransfer qb A L adj
        (wcFreeSheafMap Y e.hom ≫ (θ (wcGeomPoint K (wcP1Over K) hP)).inv) i) = _ from funext hΘ₂]
    exact hpre.comp hb'
  have hψ : (wcFreeSheafMap Y e.hom ≫ (θ (wcGeomPoint K (wcP1Over K) hP)).inv) ≫
      L.map (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)) =
      wcFreeSheafMap Y (wcGeomFrob K (wcPclYo K qb) hY) ≫
        (wcFreeSheafMap Y e.hom ≫ (θ (wcGeomPoint K (wcP1Over K) hP)).inv) := by
    have h1 : (θ (wcGeomPoint K (wcP1Over K) hP)).inv ≫
        L.map (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)) =
        wcFreeSheafMap Y ((wcProEtPullback qb).map (wcGeomFrob K (wcP1Over K) hP)) ≫
          (θ (wcGeomPoint K (wcP1Over K) hP)).inv := by
      rw [Iso.inv_comp_eq, ← Category.assoc, Iso.eq_comp_inv]
      exact hθ (wcGeomFrob K (wcP1Over K) hP)
    have h2 : wcFreeSheafMap Y e.hom ≫
        wcFreeSheafMap Y ((wcProEtPullback qb).map (wcGeomFrob K (wcP1Over K) hP)) =
        wcFreeSheafMap Y (wcGeomFrob K (wcPclYo K qb) hY) ≫ wcFreeSheafMap Y e.hom := by
      have hcomp : ∀ {U V W : Y.ProEt} (f : U ⟶ V) (g : V ⟶ W),
          wcFreeSheafMap Y f ≫ wcFreeSheafMap Y g = wcFreeSheafMap Y (f ≫ g) := by
        intro U V W f g
        first
          | exact (FrY.map_comp f g).symm
          | (unfold wcFreeSheafMap
             rw [← Functor.map_comp, ← Functor.whiskerRight_comp, ← yoneda.map_comp])
      rw [hcomp, hcomp, he]
    rw [Category.assoc, h1, ← Category.assoc, h2, Category.assoc]
  have hFrob2 : ∀ x : Abelian.Ext P0 ((wcProEtPush qb).obj A) i,
      wcPushTransfer qb A L adj
        (wcFreeSheafMap Y e.hom ≫ (θ (wcGeomPoint K (wcP1Over K) hP)).inv) i
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left
          (wcGeomFrob K (wcP1Over K) hP))).comp x (zero_add i)) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap Y (wcGeomFrob K (wcPclYo K qb) hY))).comp
        (wcPushTransfer qb A L adj
          (wcFreeSheafMap Y e.hom ≫ (θ (wcGeomPoint K (wcP1Over K) hP)).inv) i x) (zero_add i) := by
    intro x
    rw [hΘ₂, hΘ₂, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (zero_add i) (add_zero i) (by omega),
      ← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add i) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, hψ, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add i) (by omega)]

  obtain ⟨T, hTF, hTA⟩ := wc_pcl_Y_int_comparison_act K hP ℓ qb hqb hYp a ha hY L adj
    (θ (wcGeomPoint K (wcP1Over K) hP)) (hθ (wcGeomFrob K (wcP1Over K) hP)) e he i
  let Θ₂ := AddEquiv.ofBijective (wcPushTransfer qb A L adj
      (wcFreeSheafMap Y e.hom ≫ (θ (wcGeomPoint K (wcP1Over K) hP)).inv) i) hbij
  refine ⟨Θ₁.trans (Θ₂.trans T), ?_, ?_⟩
  · intro Dg hDg x
    have h1 : Θ₁ (wcCohGFrob K (wcP1Over K) hP (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) i x) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left
          (wcGeomFrob K (wcP1Over K) hP))).comp (Θ₁ x) (zero_add i) := by
      rw [hΘ₁, hΘ₁]
      exact Abelian.Ext.comp_assoc _ _ _ (zero_add i) (add_zero i) (by omega)
    simp only [AddEquiv.trans_apply, AddEquiv.ofBijective_apply, Θ₂]
    rw [h1, hFrob2]
    exact hTF Dg hDg _
  · intro Da hDa x
    have h2 : Θ₁ (wcCohGEnd K (wcP1Over K) hP (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) i
        (wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ a ha) x) =
        (Θ₁ x).comp (Abelian.Ext.mk₀ (wcPclRhoA qb ℓ a ha)) (add_zero i) := by
      rw [hΘ₁, hΘ₁]
      show (x.comp (Abelian.Ext.mk₀ (wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ a ha))
        (add_zero i)).comp (Abelian.Ext.mk₀ κ.hom) (add_zero i) = _
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, hκ, ← Abelian.Ext.mk₀_comp_mk₀,
        ← Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega)]
    simp only [AddEquiv.trans_apply, AddEquiv.ofBijective_apply, Θ₂]
    rw [h2]
    exact hTA Da hDa _

theorem wc_pcl_cover_coh_hm_coords (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    {Y : Scheme.{u}} (qb : Y ⟶ (wcP1Over K).left) (hqb : IsFinite qb)
    (hYp : IsProper (qb ≫ (wcP1Over K).hom))
    (hYs : SmoothOfRelativeDimension 1 (qb ≫ (wcP1Over K).hom))
    (a : Y ⟶ Y) (ha : a ≫ qb = qb)
    (hY : WeaklyEtale (Limits.pullback.fst (wcPclYo K qb).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (i : ℕ) (hi : i < 3) :
    ∃ (r : ℕ)
      (ι : wcCohG K (wcP1Over K) hP (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) i →+
        (Fin r → ℚ_[ℓ]))
      (T : wcHM (wcXbar K (wcPclYo K qb)) ℓ i ≃+ (Fin r → ℚ_[ℓ])),
      wcRatCoord ℓ ι ∧
      (∀ (c : ℚ_[ℓ]) (y : wcHM (wcXbar K (wcPclYo K qb)) ℓ i),
        T (wcHMScalar (wcXbar K (wcPclYo K qb)) ℓ i c y) = c • T y) ∧
      (∀ (Dg : wcHMPullData (wcGeomFrobX K (wcPclYo K qb) hY) ℓ), wcHMPullCanonical Dg →
        ∀ x, ι (wcCohGFrob K (wcP1Over K) hP (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) i x) =
          T (wcHMPull Dg i (T.symm (ι x)))) ∧
      (∀ (Da : wcHMPullData (wcPclAbar K qb a ha) ℓ), wcHMPullCanonical Da →
        ∀ x, ι (wcCohGEnd K (wcP1Over K) hP (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) i
            (wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ a ha) x) =
          T (wcHMPull Da i (T.symm (ι x)))) :=
by
  classical

  haveI hYo : IsProper (wcPclYo K qb).hom := hYp
  haveI hπ : IsProper (wcPi2 K (wcPclYo K qb)) := by
    first
      | exact MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback _ _).flip hYo
      | exact MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback _ _) hYo
      | infer_instance
  haveI : CompactSpace ↥(wcXbar K (wcPclYo K qb)) :=
    QuasiCompact.compactSpace_of_compactSpace (wcPi2 K (wcPclYo K qb))
  haveI : QuasiSeparatedSpace ↥(wcXbar K (wcPclYo K qb)) :=
    quasiSeparatedSpace_of_quasiSeparated (wcPi2 K (wcPclYo K qb))
  have hℓK : ((ℓ : ℕ) : AlgebraicClosure K) ≠ 0 := by
    intro h
    have h1 : ((ℓ : ℕ) : K) = 0 := by
      apply (algebraMap K (AlgebraicClosure K)).injective
      rw [map_natCast, map_zero]
      exact h
    have h2 : addOrderOf (1 : K) ∣ ℓ :=
      addOrderOf_dvd_of_nsmul_eq_zero (by rw [nsmul_eq_mul, mul_one]; exact h1)
    have h3 : addOrderOf (1 : K) ≠ 1 := by
      intro h1'
      have h0 := addOrderOf_nsmul_eq_zero (1 : K)
      rw [h1', one_nsmul] at h0
      exact one_ne_zero h0
    have h4 : addOrderOf (1 : K) = ℓ :=
      ((Nat.dvd_prime (Fact.out : Nat.Prime ℓ)).mp h2).resolve_left h3
    have h5 : addOrderOf (1 : K) ∣ Nat.card K := addOrderOf_dvd_natCard 1
    rw [h4] at h5
    exact hℓ h5

  obtain ⟨r, T, hT⟩ := wc_hm_proper_algclosed_findim (AlgebraicClosure K)
    (wcPi2 K (wcPclYo K qb)) ℓ hℓK i
  obtain ⟨E, hE⟩ := wc_int_rat_data_exists (wcXbar K (wcPclYo K qb)) ℓ
  obtain ⟨Θ, hΘF, hΘA⟩ := wc_pcl_cover_int_comparison K hP ℓ qb hqb hYp a ha hY i
  have hrat := wc_int_rat_rationalization (wcXbar K (wcPclYo K qb)) ℓ E hE i
  have hact := (wc_int_rho_act (wcXbar K (wcPclYo K qb)) ℓ E hE i).1
  have hfg := wc_hm_int_fg (AlgebraicClosure K) (wcPi2 K (wcPclYo K qb)) ℓ hℓK i

  have alg : ∀ (ρ : wcIntExt (wcXbar K (wcPclYo K qb)) ℓ i →+ (Fin r → ℚ_[ℓ]))
      (actM : ℤ_[ℓ] → wcIntExt (wcXbar K (wcPclYo K qb)) ℓ i →+
        wcIntExt (wcXbar K (wcPclYo K qb)) ℓ i),
      (∀ c y, ρ (actM c y) = (c : ℚ_[ℓ]) • ρ y) →
      (∀ v, ∃ (n : ℕ) (y : wcIntExt (wcXbar K (wcPclYo K qb)) ℓ i),
        ((ℓ : ℚ_[ℓ]) ^ n) • v = ρ y) →
      (∀ y, ρ y = 0 → ∃ s : ℕ, (ℓ ^ s : ℕ) • y = 0) →
      (∃ _ : Module ℤ_[ℓ] (wcIntExt (wcXbar K (wcPclYo K qb)) ℓ i),
        Module.Finite ℤ_[ℓ] (wcIntExt (wcXbar K (wcPclYo K qb)) ℓ i)) →
      wcRatCoord ℓ (ρ.comp Θ.toAddMonoidHom) := by
    intro ρ actM hact hden htor hfg
    have hℓ0 : (ℓ : ℚ_[ℓ]) ≠ 0 := by
      exact_mod_cast (Fact.out : Nat.Prime ℓ).ne_zero
    have hnv : ∀ (k : ℕ) (v : Fin r → ℚ_[ℓ]), (ℓ ^ k : ℕ) • v = ((ℓ : ℚ_[ℓ]) ^ k) • v := by
      intro k v
      rw [← Nat.cast_smul_eq_nsmul ℚ_[ℓ]]
      push_cast
      rfl
    have hdiv : ∀ (k : ℕ) (v : Fin r → ℚ_[ℓ]), (ℓ ^ k : ℕ) • v = 0 → v = 0 := by
      intro k v hv
      rw [hnv] at hv
      exact (smul_eq_zero.mp hv).resolve_left (pow_ne_zero _ hℓ0)
    have hker : ∀ y, ρ y = 0 ↔ ∃ s : ℕ, (ℓ ^ s : ℕ) • y = 0 := by
      intro y
      refine ⟨htor y, fun ⟨s, hs⟩ => hdiv s _ ?_⟩
      rw [← map_nsmul, hs, map_zero]
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro x
      simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddEquiv.coe_toAddMonoidHom]
      rw [hker]
      refine exists_congr (fun s => ?_)
      rw [← map_nsmul, map_eq_zero_iff Θ Θ.injective]
    · intro v
      obtain ⟨n, y, hy⟩ := hden v
      refine ⟨n, Θ.symm y, ?_⟩
      simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddEquiv.coe_toAddMonoidHom,
        AddEquiv.apply_symm_apply]
      exact hy
    · intro x c
      refine ⟨Θ.symm (actM c (Θ x)), ?_⟩
      simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddEquiv.coe_toAddMonoidHom,
        AddEquiv.apply_symm_apply]
      exact hact c (Θ x)
    · intro x hx
      simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddEquiv.coe_toAddMonoidHom] at hx ⊢
      obtain ⟨inst, hfin⟩ := hfg
      letI := inst
      haveI : IsNoetherian ℤ_[ℓ] (wcIntExt (wcXbar K (wcPclYo K qb)) ℓ i) :=
        isNoetherian_of_isNoetherianRing_of_finite ℤ_[ℓ] _
      have hns : ∀ (n : ℕ) (y : wcIntExt (wcXbar K (wcPclYo K qb)) ℓ i),
          n • y = (n : ℤ_[ℓ]) • y := fun n y =>
        (Nat.cast_smul_eq_nsmul ℤ_[ℓ] n y).symm
      let f : ℕ →o Submodule ℤ_[ℓ] (wcIntExt (wcXbar K (wcPclYo K qb)) ℓ i) :=
        { toFun := fun s => LinearMap.ker (((ℓ ^ s : ℕ) : ℤ_[ℓ]) • LinearMap.id)
          monotone' := by
            intro s t hst y hy
            simp only [LinearMap.mem_ker, LinearMap.smul_apply, LinearMap.id_apply] at hy ⊢
            obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hst
            rw [pow_add, Nat.cast_mul, mul_comm, mul_smul, hy, smul_zero] }
      have hmem : ∀ (s : ℕ) (y : wcIntExt (wcXbar K (wcPclYo K qb)) ℓ i),
          y ∈ f s ↔ (ℓ ^ s : ℕ) • y = 0 := by
        intro s y
        show y ∈ LinearMap.ker (((ℓ ^ s : ℕ) : ℤ_[ℓ]) • LinearMap.id) ↔ _
        rw [LinearMap.mem_ker, LinearMap.smul_apply, LinearMap.id_apply, hns]
      obtain ⟨s, hs⟩ := (monotone_stabilizes_iff_noetherian.mpr inferInstance) f
      have hall : ∀ (t : ℕ) (y : wcIntExt (wcXbar K (wcPclYo K qb)) ℓ i),
          (ℓ ^ t : ℕ) • y = 0 → (ℓ ^ s : ℕ) • y = 0 := by
        intro t y hy
        rw [← hmem] at hy ⊢
        rcases le_total t s with h | h
        · exact f.monotone h hy
        · rw [hs t h]; exact hy
      set m := Θ x with hm
      have hℓm : (ℓ : ℤ_[ℓ]) ∈ IsLocalRing.maximalIdeal ℤ_[ℓ] := by
        rw [PadicInt.maximalIdeal_eq_span_p]
        exact Ideal.mem_span_singleton_self _
      have hI : IsLocalRing.maximalIdeal ℤ_[ℓ] ≠ ⊤ := Ideal.IsMaximal.ne_top inferInstance
      have hK := Ideal.iInf_pow_smul_eq_bot_of_isLocalRing
        (M := wcIntExt (wcXbar K (wcPclYo K qb)) ℓ i) _ hI
      have hin : (ℓ ^ s : ℕ) • m ∈ ⨅ k : ℕ, (IsLocalRing.maximalIdeal ℤ_[ℓ]) ^ k •
          (⊤ : Submodule ℤ_[ℓ] (wcIntExt (wcXbar K (wcPclYo K qb)) ℓ i)) := by
        rw [Submodule.mem_iInf]
        intro k
        obtain ⟨y, hy⟩ := hx k
        have h0 : ρ (m - (ℓ ^ k : ℕ) • Θ y) = 0 := by
          rw [map_sub, map_nsmul, hnv, ← hy, sub_self]
        obtain ⟨t, ht⟩ := htor _ h0
        have h1 := hall t _ ht
        rw [smul_sub, sub_eq_zero] at h1
        rw [h1, smul_comm, hns (ℓ ^ k), Nat.cast_pow]
        exact Submodule.smul_mem_smul (Ideal.pow_mem_pow hℓm k) Submodule.mem_top
      rw [hK, Submodule.mem_bot] at hin
      exact (hker m).mpr ⟨s, hin⟩
  have hRC : wcRatCoord ℓ ((T.toAddMonoidHom.comp (wcIntRho E i)).comp Θ.toAddMonoidHom) := by
    refine alg (T.toAddMonoidHom.comp (wcIntRho E i))
      (fun c => wcIntAct (wcXbar K (wcPclYo K qb)) ℓ i (ContinuousMap.const _ (ULift.up c)))
      ?_ ?_ ?_ hfg
    · intro c y
      simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddEquiv.coe_toAddMonoidHom]
      rw [hact c y, hT]
    · intro v
      obtain ⟨n, y, hy⟩ := hrat.1 (T.symm v)
      refine ⟨n, y, ?_⟩
      simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddEquiv.coe_toAddMonoidHom]
      rw [← hy, hT, AddEquiv.apply_symm_apply]
    · intro y hy
      simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddEquiv.coe_toAddMonoidHom] at hy
      exact hrat.2 y ((map_eq_zero_iff T T.injective).mp hy)
  refine ⟨r, (T.toAddMonoidHom.comp (wcIntRho E i)).comp Θ.toAddMonoidHom, T, hRC, hT, ?_, ?_⟩
  · intro Dg hDg x
    obtain ⟨DgI, hDgI⟩ := wc_int_pull_data_exists (wcGeomFrobX K (wcPclYo K qb) hY) ℓ
    simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddEquiv.coe_toAddMonoidHom,
      AddEquiv.symm_apply_apply]
    rw [hΘF DgI hDgI x, wc_int_rat_pull_compat ℓ (wcGeomFrobX K (wcPclYo K qb) hY) Dg hDg DgI hDgI
      E hE E hE i (Θ x)]
  · intro Da hDa x
    obtain ⟨DaI, hDaI⟩ := wc_int_pull_data_exists (wcPclAbar K qb a ha) ℓ
    simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddEquiv.coe_toAddMonoidHom,
      AddEquiv.symm_apply_apply]
    rw [hΘA DaI hDaI x, wc_int_rat_pull_compat ℓ (wcPclAbar K qb a ha) Da hDa DaI hDaI
      E hE E hE i (Θ x)]

theorem wc_pcl_cel_gi_case (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] [SmoothOfRelativeDimension 1 X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (Fr : wcXbar F X ⟶ wcXbar F X) (hF : Fr ≫ wcPi2 F X = wcPi2 F X)
    (hEt : Etale (Limits.pullback.fst (wcGraph (wcPi2 F X) Fr hF 1)
        (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X))
    (DF : wcHMPullData Fr ℓ) (hDF : wcHMPullCanonical DF)
    (r : Fin 3 → ℕ) (E : ∀ i : Fin 3, wcHM (wcXbar F X) ℓ i ≃+ (Fin (r i) → ℚ_[ℓ]))
    (hE : ∀ (i : Fin 3) (c : ℚ_[ℓ]) (y : wcHM (wcXbar F X) ℓ i),
      E i (wcHMScalar (wcXbar F X) ℓ i c y) = c • E i y) :
    Finite {z : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X //
        z ≫ wcPi2 F X = 𝟙 _ ∧ z ≫ Fr = z} ∧
      ∑ i : Fin 3, (-1 : ℚ_[ℓ]) ^ (i : ℕ) * (wcAddEquivMatrix (E i) (wcHMPull DF i)).trace =
        (Nat.card {z : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X //
          z ≫ wcPi2 F X = 𝟙 _ ∧ z ≫ Fr = z} : ℚ_[ℓ]) :=
by
  classical

  have h : WeaklyEtale (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F)

  obtain ⟨T, hTs, -⟩ := wc_hm_comparison F X h ℓ
  obtain ⟨⟨e₁, he₁⟩, -⟩ := wc_top_coh_frobenius F X 1 ℓ hℓ h
  have hTinv : ∀ (i : ℕ) (c : ℚ_[ℓ]) (y : wcHM (wcXbar F X) ℓ i),
      (T i).symm (wcHMScalar (wcXbar F X) ℓ i c y) = wcCohScalar F X h ℓ i c ((T i).symm y) := by
    intro i c y
    apply (T i).injective
    rw [AddEquiv.apply_symm_apply, hTs, AddEquiv.apply_symm_apply]
  let η : wcHM (wcXbar F X) ℓ (2 * 1) →+ ℚ_[ℓ] :=
    (Pi.evalAddMonoidHom (fun _ : Fin 1 => ℚ_[ℓ]) 0).comp
      (e₁.toAddMonoidHom.comp (T (2 * 1)).symm.toAddMonoidHom)
  have hηapp : ∀ y, η y = e₁ ((T (2 * 1)).symm y) 0 := fun y => rfl
  have hηinj : Function.Injective η := by
    intro y y' hyy
    rw [hηapp, hηapp] at hyy
    have h1 : e₁ ((T (2 * 1)).symm y) = e₁ ((T (2 * 1)).symm y') := by
      funext k
      rw [Subsingleton.elim k 0]
      exact hyy
    exact (T (2 * 1)).symm.injective (e₁.injective h1)
  have hηc : ∀ (c : ℚ_[ℓ]) (x : wcHM (wcXbar F X) ℓ (2 * 1)),
      η (wcHMScalar (wcXbar F X) ℓ (2 * 1) c x) = c * η x := by
    intro c x
    rw [hηapp, hηapp, hTinv, he₁]
    rfl
  let ω : wcHM (wcXbar F X) ℓ (2 * 1) := T (2 * 1) (e₁.symm (fun _ => 1))
  have hω : η ω = 1 := by
    rw [hηapp]
    simp only [ω, AddEquiv.symm_apply_apply, AddEquiv.apply_symm_apply]

  have hvanHM : ∀ i : ℕ, 2 * 1 < i → ∀ x : wcHM (wcXbar F X) ℓ i, x = 0 := by
    intro i hi x
    have h0 := wc_coh_vanishing F X 1 ℓ hℓ h i hi ((T i).symm x)
    calc x = T i ((T i).symm x) := (AddEquiv.apply_symm_apply _ _).symm
      _ = T i 0 := by rw [h0]
      _ = 0 := map_zero _

  obtain ⟨Eσ, hU⟩ : ∃ Eσ : ∀ i : ℕ, Σ k : ℕ, (wcHM (wcXbar F X) ℓ i ≃+ (Fin k → ℚ_[ℓ])),
      ∀ (i : ℕ) (hi : i < 3), Eσ i = ⟨r ⟨i, hi⟩, E ⟨i, hi⟩⟩ := by
    refine ⟨fun i => if hi : i < 3 then ⟨r ⟨i, hi⟩, E ⟨i, hi⟩⟩ else
      ⟨0, AddEquiv.ofBijective (0 : wcHM (wcXbar F X) ℓ i →+ (Fin 0 → ℚ_[ℓ]))
        ⟨fun x y _ => by rw [hvanHM i (by omega) x, hvanHM i (by omega) y],
         fun v => ⟨0, Subsingleton.elim _ _⟩⟩⟩, ?_⟩
    intro i hi
    exact dif_pos hi
  have hE' : ∀ i ≤ 2 * 1, ∀ (c : ℚ_[ℓ]) (x : wcHM (wcXbar F X) ℓ i),
      (Eσ i).2 (wcHMScalar (wcXbar F X) ℓ i c x) = c • (Eσ i).2 x := by
    intro i hi c x
    rw [hU i (by omega)]
    exact hE ⟨i, by omega⟩ c x

  obtain ⟨D1, hD1⟩ := wc_hm_pull_data_exists (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) ℓ
  obtain ⟨D2, hD2⟩ := wc_hm_pull_data_exists (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ
  choose Dγ hDγ using fun m : ℕ => wc_hm_pull_data_exists (wcGraph (wcPi2 F X) Fr hF m) ℓ

  obtain ⟨c₀, hDI₀, htr⟩ := wc_lefschetz_diag_trace F X 1 ℓ hℓ Fr hF D1 hD1 D2 hD2 Dγ hDγ DF hDF
    η hηinj hηc ω hω hvanHM (fun i => (Eσ i).1) (fun i => (Eσ i).2) hE'

  obtain ⟨c, hPF, hTC⟩ := wc_diag_cycle_class_exists F X 1 ℓ hℓ D1 hD1 D2 hD2 η hηinj hηc ω hω
  have hN := wc_diag_class_norm F X 1 ℓ hℓ D1 hD1 D2 hD2 η hηinj hηc ω hω c hTC
  have hDI : wcDI D1 D2 1 η ω c := by
    intro j hj a b
    rw [hPF j hj a b, hN]
  have hcc : c = c₀ :=
    wc_diag_class_unique F X 1 ℓ hℓ D1 hD1 D2 hD2 η hηinj hηc ω hω c c₀ hDI hDI₀

  have ht : wcGraph (wcPi2 F X) Fr hF 1 ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _ := by
    unfold wcGraph; exact Limits.pullback.lift_fst _ _ _
  have hγ2 : wcGraph (wcPi2 F X) Fr hF 1 ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X) = Fr := by
    unfold wcGraph
    rw [Limits.pullback.lift_snd]
    show 𝟙 _ ≫ Fr = Fr
    exact Category.id_comp Fr
  have hcount := hTC (wcGraph (wcPi2 F X) Fr hF 1) ht (Dγ 1) (hDγ 1) _ hEt rfl

  have hK : Limits.pullback.fst (wcGraph (wcPi2 F X) Fr hF 1)
        (Limits.pullback.diagonal (wcPi2 F X)) =
        Limits.pullback.snd (wcGraph (wcPi2 F X) Fr hF 1)
          (Limits.pullback.diagonal (wcPi2 F X)) ∧
      Limits.pullback.fst (wcGraph (wcPi2 F X) Fr hF 1)
          (Limits.pullback.diagonal (wcPi2 F X)) ≫ Fr =
        Limits.pullback.snd (wcGraph (wcPi2 F X) Fr hF 1)
          (Limits.pullback.diagonal (wcPi2 F X)) := by
    have c' := Limits.pullback.condition (f := wcGraph (wcPi2 F X) Fr hF 1)
      (g := Limits.pullback.diagonal (wcPi2 F X))
    have c1 := congrArg (· ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) c'
    have c2 := congrArg (· ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) c'
    simp only [Category.assoc, ht, hγ2, Limits.pullback.diagonal_fst,
      Limits.pullback.diagonal_snd, Category.comp_id] at c1 c2
    exact ⟨c1, c2⟩
  have eqv : {z : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X //
        z ≫ wcPi2 F X = 𝟙 _ ∧ z ≫ Fr = z} ≃
      {w : Spec (.of (AlgebraicClosure F)) ⟶ Limits.pullback (wcGraph (wcPi2 F X) Fr hF 1)
          (Limits.pullback.diagonal (wcPi2 F X)) //
        w ≫ Limits.pullback.fst (wcGraph (wcPi2 F X) Fr hF 1)
          (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X = 𝟙 _} :=
    { toFun := fun z => ⟨Limits.pullback.lift z.1 z.1 (by
          apply Limits.pullback.hom_ext
          · simp only [Category.assoc, ht, Limits.pullback.diagonal_fst, Category.comp_id]
          · simp only [Category.assoc, hγ2, Limits.pullback.diagonal_snd, Category.comp_id]
            exact z.2.2),
        by rw [Limits.pullback.lift_fst_assoc]; exact z.2.1⟩
      invFun := fun w => ⟨w.1 ≫ Limits.pullback.fst _ _, by rw [Category.assoc]; exact w.2,
        by rw [Category.assoc, hK.2, ← hK.1]⟩
      left_inv := fun z => Subtype.ext (Limits.pullback.lift_fst _ _ _)
      right_inv := fun w => Subtype.ext (by
        apply Limits.pullback.hom_ext
        · exact Limits.pullback.lift_fst _ _ _
        · exact (Limits.pullback.lift_snd _ _ _).trans (congrArg (w.1 ≫ ·) hK.1)) }

  have hfinZ : Finite {w : Spec (.of (AlgebraicClosure F)) ⟶
      Limits.pullback (wcGraph (wcPi2 F X) Fr hF 1) (Limits.pullback.diagonal (wcPi2 F X)) //
        w ≫ Limits.pullback.fst (wcGraph (wcPi2 F X) Fr hF 1)
          (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X = 𝟙 _} := by
    haveI : IsClosedImmersion (Limits.pullback.diagonal (wcPi2 F X)) :=
      IsSeparated.isClosedImmersion_diagonal
    by_contra hnf
    rw [not_finite_iff_infinite] at hnf
    haveI := hnf
    obtain ⟨z, -, -, -, hcov⟩ := wc_closed_etale_points_decomp F X
      (Limits.pullback.fst (wcGraph (wcPi2 F X) Fr hF 1) (Limits.pullback.diagonal (wcPi2 F X)))
      hEt 0 Nat.card_eq_zero_of_infinite
    obtain ⟨w⟩ := @Infinite.nonempty _ hnf
    obtain ⟨k, -⟩ := hcov (w.1 default)
    exact k.elim0

  refine ⟨Finite.of_equiv _ eqv.symm, ?_⟩
  rw [Nat.card_congr eqv, ← hcount, hcc, htr 1 le_rfl,
    show (Finset.Iic (2 * 1) : Finset ℕ) = Finset.range 3 by decide, Finset.sum_range]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  show _ = (-1 : ℚ_[ℓ]) ^ (i : ℕ) * ((wcAddEquivMatrix (Eσ i).2 (wcHMPull DF i)) ^ 1).trace
  rw [pow_one, hU i i.isLt]

theorem wc_pcl_cel_split_field (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [IsProper X.hom] [SmoothOfRelativeDimension 1 X.hom] :
    ∃ (F' : Type u) (_ : Field F') (_ : Finite F') (_ : Algebra F F'),
      (∃ k : ℕ, Nat.card F' = Nat.card F ^ k) ∧
      ∃ (m : ℕ) (U : Fin m → (wcPclCelW F X F').Opens),
        (∀ c d, c ≠ d → Disjoint (U c : Set (wcPclCelW F X F')) (U d)) ∧
        (∀ p : wcPclCelW F X F', ∃ c, p ∈ U c) ∧
        ∀ c, GeometricallyIrreducible (wcPclCelPiece F X F' (U c)).hom ∧
          IsProper (wcPclCelPiece F X F' (U c)).hom ∧
          SmoothOfRelativeDimension 1 (wcPclCelPiece F X F' (U c)).hom :=
by
  classical

  have hGI : ∀ (L : Type u) [Field L] (V : Scheme.{u}) (g : V ⟶ Spec (.of L)),
      (∀ (K : Type u) [Field K] [IsAlgClosed K] (t : Spec (.of K) ⟶ Spec (.of L)),
        IrreducibleSpace ↥(Limits.pullback g t)) → GeometricallyIrreducible g := by
    intro L _ V g H
    constructor
    intro K _ y Z' fst snd hP
    let j : Spec (.of (AlgebraicClosure K)) ⟶ Spec (.of K) :=
      Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
    let a := Limits.pullback.fst g (j ≫ y)
    let b := Limits.pullback.snd g (j ≫ y)
    have hab : a ≫ g = (b ≫ j) ≫ y := by
      rw [Category.assoc]; exact Limits.pullback.condition
    let φ := hP.lift a (b ≫ j) hab
    have hφ₁ : φ ≫ fst = a := hP.lift_fst _ _ _
    have hφ₂ : φ ≫ snd = b ≫ j := hP.lift_snd _ _ _
    have hout : IsPullback (φ ≫ fst) b g (j ≫ y) := by
      rw [hφ₁]; exact IsPullback.of_hasPullback g (j ≫ y)
    have H' : IsPullback φ b snd j := IsPullback.of_right hout hφ₂ hP
    have hs : Surjective φ :=
      MorphismProperty.of_isPullback (P := @Surjective) H'.flip inferInstance
    have := H (AlgebraicClosure K) (j ≫ y)
    exact Function.Surjective.irreducibleSpace φ.continuous hs.surj

  have hOP : ∀ (L : Type u) [Field L] (V : Scheme.{u}) (g : V ⟶ Spec (.of L)) (U : V.Opens)
      (K : Type u) [Field K] (t : Spec (.of K) ⟶ Spec (.of L)),
      IsIrreducible ((Limits.pullback.fst g t) ⁻¹' (U : Set V)) →
      IrreducibleSpace ↥(Limits.pullback (U.ι ≫ g) t) := by
    intro L _ V g U K _ t h
    have hrange : Set.range (Limits.pullback.snd U.ι (Limits.pullback.fst g t)) =
        (Limits.pullback.fst g t) ⁻¹' (U : Set V) := by
      rw [Scheme.Pullback.range_snd, Scheme.Opens.range_ι]
    have hP0 : IrreducibleSpace ↥(Limits.pullback U.ι (Limits.pullback.fst g t)) := by
      rw [irreducibleSpace_def]
      refine ⟨?_, ?_⟩
      · obtain ⟨x, hx⟩ := h.nonempty
        rw [← hrange] at hx
        obtain ⟨y, _⟩ := hx
        exact ⟨y, Set.mem_univ _⟩
      · have := h.2.preimage (Limits.pullback.snd U.ι (Limits.pullback.fst g t)).isOpenEmbedding
        rw [← hrange, Set.preimage_range] at this
        exact this
    let e := Limits.pullbackRightPullbackFstIso g t U.ι
    exact Function.Surjective.irreducibleSpace e.hom.continuous e.hom.surjective

  obtain ⟨L, _, _, hfd, n, Z, hZc, hZcov, hZgeo⟩ := wc_finite_ext_geom_irred_cover F X.left X.hom
  haveI : Finite L := Module.finite_of_finite F
  have hsm : SmoothOfRelativeDimension 1
      (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F L)))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1)
      (IsPullback.of_hasPullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F L))))
      inferInstance
  have hdom : ∀ w : wcPclCelW F X L, IsDomain ((wcPclCelW F X L).presheaf.stalk w) :=
    fun w => wcpa_smooth_stalk_isDomain L (wcPclCelW F X L)
      (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F L)))) 1 w

  have hZirr : ∀ i, IsIrreducible (Z i) := by
    intro i
    have h1 := hZgeo i (AlgebraicClosure L)
      (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))
    have hs : Surjective (Limits.pullback.fst
        (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F L))))
        (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))) := inferInstance
    have := h1.image (Limits.pullback.fst
        (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F L))))
        (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))).base
      (Scheme.Hom.continuous _).continuousOn
    rwa [Set.image_preimage_eq _ hs.surj] at this

  have hkeyG : ∀ (W : Scheme.{u}) (w : W), IsDomain (W.presheaf.stalk w) →
      ∃ η : W, ∀ C : Set W, IsIrreducible C → IsClosed C → w ∈ C → C ⊆ closure {η} := by
    intro W w hw0
    refine ⟨W.fromSpecStalk w (⊥ : PrimeSpectrum (W.presheaf.stalk w)),
      fun C hC hCc hw => ?_⟩
    have hg := hC.isGenericPoint_genericPoint_closure
    rw [hCc.closure_eq] at hg
    have h1 : hC.genericPoint ⤳ w := hg.specializes hw
    have h2 : hC.genericPoint ∈ Set.range (W.fromSpecStalk w) := by
      rw [Scheme.range_fromSpecStalk]; exact h1
    obtain ⟨p, hp⟩ := h2
    have h3 : W.fromSpecStalk w (⊥ : PrimeSpectrum (W.presheaf.stalk w)) ⤳ hC.genericPoint := by
      rw [← hp]
      exact ((PrimeSpectrum.le_iff_specializes _ _).mp bot_le).map
        (W.fromSpecStalk w).continuous
    intro c hc
    exact (h3.trans (hg.specializes hc)).mem_closure
  have hkey : ∀ w : wcPclCelW F X L, ∃ η : wcPclCelW F X L, ∀ C : Set (wcPclCelW F X L),
      IsIrreducible C → IsClosed C → w ∈ C → C ⊆ closure {η} :=
    fun w => hkeyG _ w (hdom w)

  have hjoin : ∀ (i j : Fin n) (x : wcPclCelW F X L), x ∈ Z i → x ∈ Z j →
      ∃ k, Z i ⊆ Z k ∧ Z j ⊆ Z k := by
    intro i j x hi hj
    obtain ⟨η, hη⟩ := hkey x
    have hA := hη (Z i) (hZirr i) (hZc i) hi
    have hB := hη (Z j) (hZirr j) (hZc j) hj
    have hirr : IsIrreducible (closure ({η} : Set (wcPclCelW F X L))) :=
      isIrreducible_singleton.closure
    obtain ⟨z, hz, hsub⟩ := (isIrreducible_iff_sUnion_isClosed.mp hirr) (Finset.univ.image Z)
      (by
        intro z hz
        obtain ⟨k, _, rfl⟩ := Finset.mem_image.mp hz
        exact hZc k)
      (by
        intro y _
        have : y ∈ ⋃ i, Z i := by rw [hZcov]; trivial
        obtain ⟨k, hk⟩ := Set.mem_iUnion.mp this
        exact Set.mem_sUnion.mpr ⟨Z k, by simp, hk⟩)
    obtain ⟨k, _, rfl⟩ := Finset.mem_image.mp hz
    exact ⟨k, hA.trans hsub, hB.trans hsub⟩

  let s : Finset (Fin n) := Finset.univ.filter
    (fun i => (∀ j, Z i ⊆ Z j → Z j = Z i) ∧ ∀ j, j < i → Z j ≠ Z i)
  let m := s.card
  let e : Fin m → Fin n := fun c => (s.equivFin.symm c).1
  have he_mem : ∀ c, e c ∈ s := fun c => (s.equivFin.symm c).2
  have he_max : ∀ c j, Z (e c) ⊆ Z j → Z j = Z (e c) := fun c =>
    (Finset.mem_filter.mp (he_mem c)).2.1
  have he_first : ∀ c j, j < e c → Z j ≠ Z (e c) := fun c =>
    (Finset.mem_filter.mp (he_mem c)).2.2
  have hZe_inj : ∀ c d, c ≠ d → Z (e c) ≠ Z (e d) := by
    intro c d hcd heq
    have hne : e c ≠ e d := by
      intro h
      apply hcd
      have : s.equivFin.symm c = s.equivFin.symm d := Subtype.ext h
      exact s.equivFin.symm.injective this
    rcases lt_or_gt_of_ne hne with h | h
    · exact he_first d (e c) h heq
    · exact he_first c (e d) h heq.symm
  have hdisj : ∀ c d, c ≠ d → Disjoint (Z (e c)) (Z (e d)) := by
    intro c d hcd
    rw [Set.disjoint_left]
    intro x hxc hxd
    obtain ⟨k, hck, hdk⟩ := hjoin (e c) (e d) x hxc hxd
    have h1 := he_max c k hck
    have h2 := he_max d k hdk
    exact hZe_inj c d hcd (h1.symm.trans h2)
  have hcov : ∀ x : wcPclCelW F X L, ∃ c, x ∈ Z (e c) := by
    intro x
    have : x ∈ ⋃ i, Z i := by rw [hZcov]; trivial
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp this
    obtain ⟨b, hib, hb⟩ := Finset.exists_le_maximal (Finset.univ.image Z)
      (Finset.mem_image_of_mem Z (Finset.mem_univ i))
    have hbS : ∃ j, Z j = b := by
      obtain ⟨j, _, hj⟩ := Finset.mem_image.mp hb.1
      exact ⟨j, hj⟩
    let T : Finset (Fin n) := Finset.univ.filter (fun j => Z j = b)
    have hTne : T.Nonempty := by
      obtain ⟨j, hj⟩ := hbS
      exact ⟨j, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj⟩⟩
    let i0 := T.min' hTne
    have hi0 : Z i0 = b := (Finset.mem_filter.mp (T.min'_mem hTne)).2
    have hi0s : i0 ∈ s := by
      refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_, ?_⟩
      · intro j hj
        rw [hi0] at hj ⊢
        exact le_antisymm (hb.2 (Finset.mem_image_of_mem Z (Finset.mem_univ j)) hj) hj
      · intro j hj heq
        have hjT : j ∈ T := Finset.mem_filter.mpr ⟨Finset.mem_univ _, heq.trans hi0⟩
        exact absurd (T.min'_le j hjT) (not_le.mpr hj)
    refine ⟨s.equivFin ⟨i0, hi0s⟩, ?_⟩
    have : e (s.equivFin ⟨i0, hi0s⟩) = i0 := by
      show (s.equivFin.symm (s.equivFin ⟨i0, hi0s⟩)).1 = i0
      rw [Equiv.symm_apply_apply]
    rw [this, hi0]
    exact hib hi
  have hopen : ∀ c, IsOpen (Z (e c)) := by
    intro c
    have heq : Z (e c) = (⋃ d ∈ (Finset.univ.filter (fun d => d ≠ c)), Z (e d))ᶜ := by
      ext x
      simp only [Set.mem_compl_iff, Set.mem_iUnion, Finset.mem_filter, Finset.mem_univ,
        true_and, exists_prop, not_exists, not_and]
      constructor
      · intro hx d hdc hxd
        exact Set.disjoint_left.mp (hdisj c d (Ne.symm hdc)) hx hxd
      · intro h
        obtain ⟨d, hd⟩ := hcov x
        by_cases hdc : d = c
        · subst hdc; exact hd
        · exact absurd hd (h d hdc)
    rw [heq]
    exact (isClosed_biUnion_finset (fun d _ => hZc (e d))).isOpen_compl

  refine ⟨L, inferInstance, inferInstance, inferInstance,
    ⟨Module.finrank F L, Module.natCard_eq_pow_finrank⟩, m,
    fun c => ⟨Z (e c), hopen c⟩, fun c d hcd => hdisj c d hcd, fun p => hcov p, ?_⟩
  intro c
  let Uc : (wcPclCelW F X L).Opens := ⟨Z (e c), hopen c⟩
  have hUc : (Uc : Set (wcPclCelW F X L)) = Z (e c) := rfl
  refine ⟨?_, ?_, ?_⟩
  ·
    show GeometricallyIrreducible (Scheme.Opens.ι Uc ≫
      Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F L))))
    exact hGI L _ _ (fun K _ _ t => hOP L (wcPclCelW F X L)
      (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F L))))
      Uc K t (hZgeo (e c) K t))
  ·
    have : IsClosedImmersion (Scheme.Opens.ι Uc) :=
      IsClosedImmersion.of_isPreimmersion _ (by rw [Scheme.Opens.range_ι, hUc]; exact hZc (e c))
    show IsProper (Scheme.Opens.ι Uc ≫
      Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F L))))
    infer_instance
  ·
    have := smoothOfRelativeDimension_comp 0 1 (Scheme.Opens.ι Uc)
      (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F L))))
    simpa using this

theorem wc_pcl_cel_base_change_open (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    (F' : Type u) [Field F'] [Finite F'] [Algebra F F'] :
    ∃ (κ : AlgebraicClosure F ≃+* AlgebraicClosure F') (rW : wcXbar F X ⟶ wcPclCelW F X F'),
      ∀ U : (wcPclCelW F X F').Opens,
        ∃ θ : wcXbar F' (wcPclCelPiece F X F' U) ⟶ wcXbar F X,
          IsOpenImmersion θ ∧
          θ ≫ wcPi2 F X = wcPi2 F' (wcPclCelPiece F X F' U) ≫
            Spec.map (CommRingCat.ofHom (κ : AlgebraicClosure F →+* AlgebraicClosure F')) ∧
          Set.range ⇑θ = ⇑rW ⁻¹' (U : Set (wcPclCelW F X F')) :=
by
  classical

  haveI := IsAlgClosure.ofAlgebraic F F' (AlgebraicClosure F')
  obtain ⟨κ, hκ⟩ : ∃ κ : AlgebraicClosure F ≃+* AlgebraicClosure F',
      ∀ x : F, κ (algebraMap F (AlgebraicClosure F) x) =
        algebraMap F' (AlgebraicClosure F') (algebraMap F F' x) :=
    ⟨(IsAlgClosure.equiv F (AlgebraicClosure F) (AlgebraicClosure F')).toRingEquiv, fun x =>
      ((IsAlgClosure.equiv F (AlgebraicClosure F) (AlgebraicClosure F')).commutes x).trans
        (IsScalarTower.algebraMap_apply F F' (AlgebraicClosure F') x)⟩

  obtain ⟨j, hj⟩ : ∃ j : F' →+* AlgebraicClosure F,
      j = (κ.symm : AlgebraicClosure F' →+* AlgebraicClosure F).comp
        (algebraMap F' (AlgebraicClosure F')) := ⟨_, rfl⟩
  have R2 : j.comp (algebraMap F F') = algebraMap F (AlgebraicClosure F) := by
    apply RingHom.ext
    intro x
    rw [hj, RingHom.comp_apply, RingHom.comp_apply, ← hκ x]
    exact RingEquiv.symm_apply_apply κ _
  have R3 : (κ : AlgebraicClosure F →+* AlgebraicClosure F').comp j =
      algebraMap F' (AlgebraicClosure F') := by
    apply RingHom.ext
    intro y
    rw [hj, RingHom.comp_apply, RingHom.comp_apply]
    exact RingEquiv.apply_symm_apply κ _
  have Q1 : Spec.map (CommRingCat.ofHom j) ≫ Spec.map (CommRingCat.ofHom (algebraMap F F')) =
      Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, R2]
  have Q2 : Spec.map (CommRingCat.ofHom (κ : AlgebraicClosure F →+* AlgebraicClosure F')) ≫
      Spec.map (CommRingCat.ofHom j) =
      Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, R3]
  haveI hκi : IsIso (CommRingCat.ofHom (κ : AlgebraicClosure F →+* AlgebraicClosure F')) :=
    ⟨⟨CommRingCat.ofHom (κ.symm : AlgebraicClosure F' →+* AlgebraicClosure F),
      by ext x; simp, by ext x; simp⟩⟩

  have w : Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫ X.hom =
      (Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
          Spec.map (CommRingCat.ofHom j)) ≫ Spec.map (CommRingCat.ofHom (algebraMap F F')) := by
    rw [Limits.pullback.condition, Category.assoc, Q1]
  obtain ⟨rW, hrW1, hrW2⟩ : ∃ rW : wcXbar F X ⟶ wcPclCelW F X F',
      rW ≫ Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F'))) =
        Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ∧
      rW ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F'))) =
        Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
          Spec.map (CommRingCat.ofHom j) :=
    ⟨Limits.pullback.lift _ _ w, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩

  have hA : IsPullback rW (Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F'))))
      (Spec.map (CommRingCat.ofHom j)) := by
    refine IsPullback.of_right ?_ hrW2
      (IsPullback.of_hasPullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F'))))
    rw [hrW1, Q1]
    exact IsPullback.of_hasPullback _ _
  refine ⟨κ, rW, fun U => ?_⟩

  have hc' : Limits.pullback.fst (wcPclCelPiece F X F' U).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) ≫ U.ι ≫
        Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F'))) =
      Limits.pullback.snd (wcPclCelPiece F X F' U).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))) :=
    Limits.pullback.condition
  have w' : (Limits.pullback.fst (wcPclCelPiece F X F' U).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) ≫ U.ι ≫
        Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F')))) ≫ X.hom =
      (Limits.pullback.snd (wcPclCelPiece F X F' U).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) ≫
        Spec.map (CommRingCat.ofHom (κ : AlgebraicClosure F →+* AlgebraicClosure F'))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))) := by
    simp only [Category.assoc]
    rw [Limits.pullback.condition (f := X.hom)
      (g := Spec.map (CommRingCat.ofHom (algebraMap F F'))), reassoc_of% hc', ← Q1,
      reassoc_of% Q2]
  obtain ⟨θ, hθ1, hθ2⟩ : ∃ θ : wcXbar F' (wcPclCelPiece F X F' U) ⟶ wcXbar F X,
      θ ≫ Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
        Limits.pullback.fst (wcPclCelPiece F X F' U).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) ≫ U.ι ≫
          Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F'))) ∧
      θ ≫ wcPi2 F X = wcPi2 F' (wcPclCelPiece F X F' U) ≫
        Spec.map (CommRingCat.ofHom (κ : AlgebraicClosure F →+* AlgebraicClosure F')) :=
    ⟨Limits.pullback.lift _ _ w', Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩

  have C : θ ≫ rW = Limits.pullback.fst (wcPclCelPiece F X F' U).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) ≫ U.ι := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hrW1, hθ1, Category.assoc]
    · rw [Category.assoc, hrW2, reassoc_of% hθ2, Q2, Category.assoc, hc']

  have B : IsPullback (Spec.map (CommRingCat.ofHom (κ : AlgebraicClosure F →+* AlgebraicClosure F')))
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))
      (Spec.map (CommRingCat.ofHom j)) (𝟙 _) :=
    IsPullback.of_horiz_isIso ⟨by rw [Q2, Category.comp_id]⟩
  have O := (IsPullback.of_hasPullback (wcPclCelPiece F X F' U).hom
    (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))).flip.paste_horiz B
  rw [Category.comp_id] at O

  have hP : IsPullback θ (Limits.pullback.fst (wcPclCelPiece F X F' U).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) rW U.ι :=
    IsPullback.of_right (by rw [hθ2]; exact O) C hA.flip

  refine ⟨θ, MorphismProperty.of_isPullback (P := @IsOpenImmersion) hP.flip inferInstance, hθ2, ?_⟩
  ext p
  constructor
  · rintro ⟨q, rfl⟩
    show rW (θ q) ∈ (U : Set (wcPclCelW F X F'))
    rw [← Scheme.Hom.comp_apply, C, Scheme.Hom.comp_apply, ← Scheme.Opens.range_ι]
    exact ⟨_, rfl⟩
  · intro hp
    have hp' : rW p ∈ Set.range U.ι := by rw [Scheme.Opens.range_ι]; exact hp
    obtain ⟨u, hu⟩ := hp'
    obtain ⟨z, -, hz2⟩ := Scheme.Pullback.exists_preimage_pullback u p hu
    refine ⟨hP.flip.isoPullback.inv z, ?_⟩
    rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_snd, hz2]

theorem wc_pcl_cel_fix_etale_restrict {S T A A' : Scheme.{u}} (θ : S ⟶ T) [IsOpenImmersion θ]
    (πT : T ⟶ A) (πS : S ⟶ A') (g : A' ⟶ A) [IsIso g] (hθ : θ ≫ πT = πS ≫ g)
    (FrT : T ⟶ T) (hT : FrT ≫ πT = πT) (FrS : S ⟶ S) (hS : FrS ≫ πS = πS)
    (hc : FrS ≫ θ = θ ≫ FrT)
    (hEt : Etale (Limits.pullback.fst (wcGraph πT FrT hT 1) (Limits.pullback.diagonal πT) ≫ πT)) :
    Etale (Limits.pullback.fst (wcGraph πS FrS hS 1) (Limits.pullback.diagonal πS) ≫ πS) :=
by
  classical
  have hfix : ∀ {X B : Scheme.{u}} (π : X ⟶ B) (Fr : X ⟶ X) (hF : Fr ≫ π = π),
      (wcGraph π Fr hF 1 ≫ Limits.pullback.fst π π = 𝟙 _) ∧
      (wcGraph π Fr hF 1 ≫ Limits.pullback.snd π π = Fr) ∧
      (Limits.pullback.fst (wcGraph π Fr hF 1) (Limits.pullback.diagonal π) ≫ Fr =
        Limits.pullback.fst (wcGraph π Fr hF 1) (Limits.pullback.diagonal π)) := by
    intro X B π Fr hF
    have hγ1 : wcGraph π Fr hF 1 ≫ Limits.pullback.fst π π = 𝟙 _ := by
      unfold wcGraph; exact Limits.pullback.lift_fst _ _ _
    have hγ2 : wcGraph π Fr hF 1 ≫ Limits.pullback.snd π π = Fr := by
      unfold wcGraph; rw [Limits.pullback.lift_snd]; simp [wcIter]
    refine ⟨hγ1, hγ2, ?_⟩
    have c := Limits.pullback.condition (f := wcGraph π Fr hF 1)
      (g := Limits.pullback.diagonal π)
    have c1 := congrArg (· ≫ Limits.pullback.fst π π) c
    have c2 := congrArg (· ≫ Limits.pullback.snd π π) c
    simp only [Category.assoc, hγ1, hγ2, Limits.pullback.diagonal_fst,
      Limits.pullback.diagonal_snd, Category.comp_id] at c1 c2
    rw [c2, c1]
  obtain ⟨hT1, hT2, hTfix⟩ := hfix πT FrT hT
  obtain ⟨hS1, hS2, hSfix⟩ := hfix πS FrS hS
  haveI hmT : Mono (Limits.pullback.fst (wcGraph πT FrT hT 1) (Limits.pullback.diagonal πT)) :=
    Limits.pullback.fst_of_mono
  haveI hmS : Mono (Limits.pullback.fst (wcGraph πS FrS hS 1) (Limits.pullback.diagonal πS)) :=
    Limits.pullback.fst_of_mono
  set fT := Limits.pullback.fst (wcGraph πT FrT hT 1) (Limits.pullback.diagonal πT) with hfT
  set fS := Limits.pullback.fst (wcGraph πS FrS hS 1) (Limits.pullback.diagonal πS) with hfS
  have crit : ∀ {W : Scheme.{u}} (b : W ⟶ S), b ≫ FrS = b →
      b ≫ wcGraph πS FrS hS 1 = b ≫ Limits.pullback.diagonal πS := by
    intro W b hb
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, hS1, Limits.pullback.diagonal_fst, Category.comp_id]
    · simp only [Category.assoc, hS2, Limits.pullback.diagonal_snd, Category.comp_id, hb]
  have w : (fS ≫ θ) ≫ wcGraph πT FrT hT 1 = (fS ≫ θ) ≫ Limits.pullback.diagonal πT := by
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, hT1, Limits.pullback.diagonal_fst, Category.comp_id]
    · simp only [Category.assoc, hT2, Limits.pullback.diagonal_snd, Category.comp_id]
      rw [← hc, ← Category.assoc, hSfix]
  let ψ := Limits.pullback.lift (fS ≫ θ) (fS ≫ θ) w
  have hψ : ψ ≫ fT = fS ≫ θ := Limits.pullback.lift_fst _ _ _
  have hb : ∀ s : Limits.PullbackCone fT θ, s.snd ≫ FrS = s.snd := by
    intro s
    apply (cancel_mono θ).mp
    rw [Category.assoc, hc, ← Category.assoc, ← s.condition, Category.assoc, hTfix, s.condition]
  have hpb : IsPullback ψ fS fT θ := by
    refine IsPullback.of_isLimit (Limits.PullbackCone.IsLimit.mk hψ
      (fun s => Limits.pullback.lift s.snd s.snd (crit s.snd (hb s))) ?_ ?_ ?_)
    · intro s
      apply (cancel_mono fT).mp
      rw [Category.assoc, hψ, ← Category.assoc, Limits.pullback.lift_fst, s.condition]
    · intro s
      exact Limits.pullback.lift_fst _ _ _
    · intro s m _ h2
      apply (cancel_mono fS).mp
      rw [h2, Limits.pullback.lift_fst]
  haveI : IsOpenImmersion ψ :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb.flip inferInstance
  have hfac : fS ≫ πS = ψ ≫ ((fT ≫ πT) ≫ inv g) := by
    simp only [Category.assoc]
    rw [reassoc_of% hψ, reassoc_of% hθ, IsIso.hom_inv_id, Category.comp_id]
  haveI : Etale (fT ≫ πT) := hEt
  rw [hfac]
  infer_instance

theorem wc_pcl_cel_hm_clopen_split {S : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {m : ℕ}
    {Sc : Fin m → Scheme.{u}} (θ : ∀ c, Sc c ⟶ S) (hθ : ∀ c, IsOpenImmersion (θ c))
    (hdisj : ∀ c d, c ≠ d → Disjoint (Set.range ⇑(θ c)) (Set.range ⇑(θ d)))
    (hcov : ∀ p : S, ∃ c, p ∈ Set.range ⇑(θ c))
    (D : ∀ c, wcHMPullData (θ c) ℓ) (hD : ∀ c, wcHMPullCanonical (D c)) (n : ℕ) :
    Function.Bijective (fun x : wcHM S ℓ n => fun c => wcHMPull (D c) n x) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _

  have s1 : ∃ (P : S.ProEt → SheafOfModules.{u+1} (wcRingSheaf S ℓ))
      (Pm : ∀ (W W' : S.ProEt), (W' ⟶ W) → (P W' ⟶ P W))
      (ev : ∀ (W : S.ProEt) (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)),
        (P W ⟶ M) ≃ M.val.obj (Opposite.op W)),
      (∀ (W : S.ProEt) (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N)
        (g : P W ⟶ M), ev W N (g ≫ ψ) = (ψ.val.app (Opposite.op W)).hom (ev W M g)) ∧
      (∀ (W W' : S.ProEt) (b : W' ⟶ W) (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
        (g : P W ⟶ M), ev W' M (Pm W W' b ≫ g) = (M.val.map b.op).hom (ev W M g)) := by
    have hY := fun W : S.ProEt =>
      sheafOfModules_free_yoneda (Scheme.ProEt.topology S) (wcRingSheaf S ℓ) W
    choose P ev hnat _ using hY
    refine ⟨P, fun W W' b => (ev W' (P W)).symm
      (((P W).val.map b.op).hom (ev W (P W) (𝟙 (P W))) : (P W).val.obj (Opposite.op W')),
      ev, hnat, ?_⟩
    intro W W' b M g
    refine (hnat W' (P W) M g _).trans ?_
    refine (congrArg (g.val.app (Opposite.op W')).hom
      (Equiv.apply_symm_apply (ev W' (P W)) _)).trans ?_
    refine (PresheafOfModules.naturality_apply g.val b.op _).trans ?_
    refine congrArg (M.val.map b.op).hom ?_
    refine (hnat W (P W) M g (𝟙 _)).symm.trans ?_
    rw [Category.id_comp]
  obtain ⟨P, Pm, ev, hnat, hpre⟩ := s1

  obtain ⟨Θ, -, hΘn⟩ := wc_proet_free_module_ext_hm_natural S ℓ P Pm ev hnat hpre

  let T : S.ProEt := Scheme.ProEt.mk (𝟙 S)
  let Wc : Fin m → S.ProEt := fun c =>
    @Scheme.ProEt.mk S (Sc c) (θ c) (by haveI := hθ c; infer_instance)
  let b : ∀ c, Wc c ⟶ T := fun c =>
    MorphismProperty.Over.homMk (A := Wc c) (B := T) (θ c) (Category.comp_id _) trivial
  have hbopen : ∀ c, IsOpenImmersion (b c).left := fun c => hθ c
  have hsurj : ∀ x : T.left, ∃ c, x ∈ Set.range (b c).left := fun x => hcov x

  have hEmpty : ∀ (Z : S.ProEt), IsEmpty Z.left →
      ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (a b : F.obj.obj (Opposite.op Z)),
        a = b := by
    intro Z hZ F a b
    have hmem : Presieve.ofArrows (fun _ : PEmpty.{1} => Z) (fun i => i.elim) ∈
        (Scheme.ProEt.precoverage S).coverings Z := by
      rw [Scheme.ProEt.precoverage, Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      have hz := (Scheme.ofArrows_mem_precoverage_iff @IsOpenImmersion
        (X := fun _ : PEmpty.{1} => (Scheme.ProEt.forget S ⋙ Over.forget S).obj Z)
        (f := fun i => (Scheme.ProEt.forget S ⋙ Over.forget S).map i.elim)).mpr
        ⟨fun x => (hZ.false x).elim, fun i => i.elim⟩
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage _ hz,
        (Scheme.ofArrows_mem_precoverage_iff _).mpr ⟨fun x => (hZ.false x).elim, fun i => i.elim⟩⟩
    refine Sheaf.isSeparated F Z _ (Precoverage.generate_mem_toGrothendieck hmem) a b ?_
    intro Y f hf
    obtain ⟨Y', h, g', hg', -⟩ := hf
    rcases hg' with ⟨i⟩
    exact i.elim

  have hmemW : Presieve.ofArrows Wc b ∈ (Scheme.ProEt.precoverage S).coverings T := by
    rw [Scheme.ProEt.precoverage, Precoverage.mem_comap_iff, Presieve.map_ofArrows]
    have hz := (Scheme.ofArrows_mem_precoverage_iff @IsOpenImmersion
      (X := fun c => (Scheme.ProEt.forget S ⋙ Over.forget S).obj (Wc c))
      (f := fun c => (Scheme.ProEt.forget S ⋙ Over.forget S).map (b c))).mpr
      ⟨hsurj, hbopen⟩
    exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage _ hz,
      (Scheme.ofArrows_mem_precoverage_iff _).mpr ⟨hsurj, fun c => by
        have := hbopen c
        show WeaklyEtale (b c).left
        infer_instance⟩⟩

  have hBij : ∀ F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      Function.Bijective (fun s : F.obj.obj (Opposite.op T) => fun c => F.obj.map (b c).op s) := by
    intro F
    have hsh : Presieve.IsSheaf (Scheme.ProEt.topology S) (F.obj ⋙ forget AddCommGrpCat.{u+1}) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp
        ((sheafCompose (Scheme.ProEt.topology S) (forget AddCommGrpCat.{u+1})).obj F).cond
    have hsF : Presieve.IsSheafFor (F.obj ⋙ forget AddCommGrpCat.{u+1}) (Presieve.ofArrows Wc b) :=
      (Presieve.isSheafFor_iff_generate _).mpr
        (hsh _ (Precoverage.generate_mem_toGrothendieck hmemW))
    rw [Presieve.isSheafFor_arrows_iff] at hsF
    have hcompat : ∀ x : (c : Fin m) → (F.obj ⋙ forget AddCommGrpCat.{u+1}).obj (Opposite.op (Wc c)),
        Presieve.Arrows.Compatible (F.obj ⋙ forget AddCommGrpCat.{u+1}) b x := by
      intro x i j Z gi gj hij
      have e : gi.left ≫ (b i).left = gj.left ≫ (b j).left := congrArg (fun t => t.left) hij
      by_cases hij' : i = j
      · subst hij'
        have hg : gi = gj := by
          apply MorphismProperty.Over.Hom.ext
          have := hbopen i
          exact (cancel_mono (b i).left).mp e
        rw [hg]
      · have hZ : IsEmpty Z.left :=
          Scheme.isEmpty_of_commSq (f := (b i).left) (g := (b j).left)
            (i := gi.left) (j := gj.left) ⟨e⟩ (hdisj i j hij')
        exact hEmpty Z hZ F _ _
    constructor
    · intro s s' hss
      obtain ⟨t, -, huniq⟩ := hsF (fun c => (F.obj ⋙ forget AddCommGrpCat.{u+1}).map (b c).op s)
        (hcompat _)
      have e1 := huniq s (fun c => rfl)
      have e2 := huniq s' (fun c => (congrFun hss c).symm)
      exact e1.trans e2.symm
    · intro y
      obtain ⟨t, ht, -⟩ := hsF y (hcompat _)
      exact ⟨t, funext ht⟩

  have hHom : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
      Function.Bijective (fun g : P T ⟶ M => fun c => Pm T (Wc c) (b c) ≫ g) := by
    intro M
    have hmid := hBij ((SheafOfModules.toSheaf _).obj M)
    have heq : (fun g : P T ⟶ M => fun c => Pm T (Wc c) (b c) ≫ g) =
        (Equiv.piCongrRight (fun c => (ev (Wc c) M).symm)) ∘
          ((fun s : ((SheafOfModules.toSheaf _).obj M).obj.obj (Opposite.op T) =>
            fun c => ((SheafOfModules.toSheaf _).obj M).obj.map (b c).op s) ∘ (ev T M)) := by
      funext g c
      simp only [Function.comp_apply, Equiv.piCongrRight_apply]
      exact (Equiv.eq_symm_apply _).mpr (hpre T (Wc c) (b c) M g)
    rw [heq]
    exact (Equiv.bijective _).comp (hmid.comp (Equiv.bijective _))

  have hExt : Function.Bijective
      (fun β : Abelian.Ext (P T) (SheafOfModules.unit (wcRingSheaf S ℓ)) n =>
        fun c => (Abelian.Ext.mk₀ (Pm T (Wc c) (b c))).comp β (zero_add n)) := by
    have hπ : ∀ c, ∃ π : P T ⟶ P (Wc c),
        ∀ d, Pm T (Wc d) (b d) ≫ π =
          (Pi.single c (𝟙 (P (Wc c))) : ∀ d, P (Wc d) ⟶ P (Wc c)) d := by
      intro c
      obtain ⟨π, hπ⟩ := (hHom (P (Wc c))).2
        (Pi.single c (𝟙 (P (Wc c))) : ∀ d, P (Wc d) ⟶ P (Wc c))
      exact ⟨π, fun d => congrFun hπ d⟩
    choose π hπ using hπ
    have hsame : ∀ c, Pm T (Wc c) (b c) ≫ π c = 𝟙 _ := fun c => by
      rw [hπ c c, Pi.single_eq_same]
    have hne : ∀ c d, d ≠ c → Pm T (Wc d) (b d) ≫ π c = 0 := fun c d h => by
      rw [hπ c d, Pi.single_eq_of_ne h]
    have hsum : ∑ c, π c ≫ Pm T (Wc c) (b c) = 𝟙 (P T) := by
      apply (hHom (P T)).1
      funext d
      show Pm T (Wc d) (b d) ≫ ∑ c, π c ≫ Pm T (Wc c) (b c) = Pm T (Wc d) (b d) ≫ 𝟙 (P T)
      rw [Preadditive.comp_sum, Category.comp_id, Finset.sum_eq_single d]
      · rw [← Category.assoc, hsame, Category.id_comp]
      · intro c _ hc
        rw [← Category.assoc, hne c d (Ne.symm hc), Limits.zero_comp]
      · intro h; exact absurd (Finset.mem_univ d) h
    rw [Function.bijective_iff_has_inverse]
    refine ⟨fun y => ∑ c, (Abelian.Ext.mk₀ (π c)).comp (y c) (zero_add n), ?_, ?_⟩
    · intro β
      show ∑ c, (Abelian.Ext.mk₀ (π c)).comp
        ((Abelian.Ext.mk₀ (Pm T (Wc c) (b c))).comp β (zero_add n)) (zero_add n) = β
      simp_rw [Abelian.Ext.mk₀_comp_mk₀_assoc]
      rw [← Abelian.Ext.sum_comp, ← Abelian.Ext.mk₀_sum, hsum, Abelian.Ext.mk₀_id_comp]
    · intro y
      funext d
      show (Abelian.Ext.mk₀ (Pm T (Wc d) (b d))).comp
        (∑ c, (Abelian.Ext.mk₀ (π c)).comp (y c) (zero_add n)) (zero_add n) = y d
      rw [Abelian.Ext.comp_sum]
      simp_rw [Abelian.Ext.mk₀_comp_mk₀_assoc]
      rw [Finset.sum_eq_single d]
      · rw [hsame, Abelian.Ext.mk₀_id_comp]
      · intro c _ hc
        rw [hne c d (Ne.symm hc), Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]
      · intro h; exact absurd (Finset.mem_univ d) h

  have hΨ : Function.Bijective
      (fun (y : ∀ c, Abelian.Ext (P (Wc c)) (SheafOfModules.unit (wcRingSheaf S ℓ)) n) =>
        fun c => Θ n (Wc c) (y c)) :=
    (Equiv.piCongrRight (fun c => (Θ n (Wc c)).toEquiv)).bijective
  have heq : (fun x : wcHM S ℓ n => fun c => wcHMPull (D c) n x) =
      (fun (y : ∀ c, Abelian.Ext (P (Wc c)) (SheafOfModules.unit (wcRingSheaf S ℓ)) n) =>
        fun c => Θ n (Wc c) (y c)) ∘
        ((fun β : Abelian.Ext (P T) (SheafOfModules.unit (wcRingSheaf S ℓ)) n =>
          fun c => (Abelian.Ext.mk₀ (Pm T (Wc c) (b c))).comp β (zero_add n)) ∘
          (Θ n T).symm) := by
    funext x c
    show wcHMPull (D c) n x = Θ n (Wc c)
      ((Abelian.Ext.mk₀ (Pm T (Wc c) (b c))).comp ((Θ n T).symm x) (zero_add n))
    rw [hΘn n T (Wc c) (b c) (D c) (hD c)]
    exact (congrArg (wcHMPull (D c) n) ((Θ n T).apply_symm_apply x)).symm
  rw [heq]
  exact hΨ.comp (hExt.comp (Θ n T).symm.bijective)

theorem wc_pcl_cel_trace_split {S : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {m : ℕ}
    {Sc : Fin m → Scheme.{u}} (θ : ∀ c, Sc c ⟶ S) (hθ : ∀ c, IsOpenImmersion (θ c))
    (hdisj : ∀ c d, c ≠ d → Disjoint (Set.range ⇑(θ c)) (Set.range ⇑(θ d)))
    (hcov : ∀ p : S, ∃ c, p ∈ Set.range ⇑(θ c))
    (Fr : S ⟶ S) (DF : wcHMPullData Fr ℓ) (hDF : wcHMPullCanonical DF)
    (τ : Fin m → Fin m) (Frc : ∀ c, Sc c ⟶ Sc (τ c)) (hFrc : ∀ c, Frc c ≫ θ (τ c) = θ c ≫ Fr)
    (FrF : ∀ c, Sc c ⟶ Sc c) (hFrF : ∀ c, τ c = c → FrF c ≫ θ c = θ c ≫ Fr)
    (DFF : ∀ c, wcHMPullData (FrF c) ℓ) (hDFF : ∀ c, wcHMPullCanonical (DFF c))
    (n : ℕ) (r : ℕ) (E : wcHM S ℓ n ≃+ (Fin r → ℚ_[ℓ]))
    (hE : ∀ (a : ℚ_[ℓ]) (y : wcHM S ℓ n), E (wcHMScalar S ℓ n a y) = a • E y)
    (rc : Fin m → ℕ) (Ec : ∀ c, wcHM (Sc c) ℓ n ≃+ (Fin (rc c) → ℚ_[ℓ]))
    (hEc : ∀ c (a : ℚ_[ℓ]) (y : wcHM (Sc c) ℓ n), Ec c (wcHMScalar (Sc c) ℓ n a y) = a • Ec c y) :
    (wcAddEquivMatrix E (wcHMPull DF n)).trace =
      ∑ c ∈ Finset.univ.filter (fun c => τ c = c),
        (wcAddEquivMatrix (Ec c) (wcHMPull (DFF c) n)).trace :=
by
  classical

  have H_mul : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ) (i j k : ℕ) (hk : i + j = k)
      (x : wcHM S ℓ i) (y : wcHM S ℓ j),
      wcHMPull D k (wcHMCup S ℓ i j k hk x y) =
        wcHMCup S' ℓ i j k hk (wcHMPull D i x) (wcHMPull D j y) := by
    intro S S' f D i j k hk x y
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y hk)).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero k)) (zero_add k) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero i)) (zero_add i)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero j)) (zero_add j)) hk
    rw [Abelian.Ext.mapExactFunctor_comp]
    generalize Abelian.Ext.mapExactFunctor D.Φ x = z
    generalize Abelian.Ext.mapExactFunctor D.Φ y = w
    have e1 : (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        (w.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero j)) (zero_add j)) (zero_add j) =
        w.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero j) := by
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add j) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv)
        (z.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero i)) _ (zero_add i) hk (by omega),
      Abelian.Ext.comp_assoc z (Abelian.Ext.mk₀ D.μ.hom) _ (add_zero i) (zero_add j) (by omega), e1,
      Abelian.Ext.comp_assoc z w (Abelian.Ext.mk₀ D.μ.hom) hk (add_zero j) (by omega)]
  have pullScalar : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ),
      wcHMPullCanonical D → ∀ (n : ℕ) (c : ℚ_[ℓ]) (x : wcHM S ℓ n),
      wcHMPull D n (wcHMScalar S ℓ n c x) = wcHMScalar S' ℓ n c (wcHMPull D n x) := by
    intro S S' f D hD n c x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    have e0 : wcHMScalar S ℓ n c x =
        wcHMCup S ℓ n 0 n (add_zero n) x (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) := rfl
    have e0' : wcHMScalar S' ℓ n c (wcHMPull D n x) =
        wcHMCup S' ℓ n 0 n (add_zero n) (wcHMPull D n x) (Abelian.Ext.mk₀ (wcHMConst S' ℓ c)) := rfl
    rw [e0, e0', H_mul]
    congr 1
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        (Abelian.Ext.mk₀ (wcHMConst S ℓ c))).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero 0))
        (zero_add 0) = Abelian.Ext.mk₀ (wcHMConst S' ℓ c)
    rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀,
      wc_hm_pull_const D hD c]

  choose Dθ hDθ using fun c => wc_hm_pull_data_exists (θ c) ℓ
  choose Dk hDk using fun c => wc_hm_pull_data_exists (θ c ≫ Fr) ℓ
  choose DR hDR using fun c => wc_hm_pull_data_exists (Frc c) ℓ

  have hρ := wc_pcl_cel_hm_clopen_split θ hθ hdisj hcov Dθ hDθ n

  have hi : ∀ c x, wcHMPull (Dk c) n x = wcHMPull (Dθ c) n (wcHMPull DF n x) := fun c x =>
    wc_hm_pull_comp Fr (θ c) (θ c ≫ Fr) rfl DF hDF (Dθ c) (hDθ c) (Dk c) (hDk c) n x
  have hfix : ∀ c, τ c = c → ∀ x, wcHMPull (Dθ c) n (wcHMPull DF n x) =
      wcHMPull (DFF c) n (wcHMPull (Dθ c) n x) := by
    intro c h x
    rw [← hi]
    exact wc_hm_pull_comp (θ c) (FrF c) (θ c ≫ Fr) (hFrF c h) (Dθ c) (hDθ c) (DFF c) (hDFF c)
      (Dk c) (hDk c) n x
  have hmove : ∀ c, τ c ≠ c → ∀ x, wcHMPull (Dθ (τ c)) n x = 0 →
      wcHMPull (Dθ c) n (wcHMPull DF n x) = 0 := by
    intro c _ x hx
    rw [← hi, wc_hm_pull_comp (θ (τ c)) (Frc c) (θ c ≫ Fr) (hFrc c) (Dθ (τ c)) (hDθ (τ c))
      (DR c) (hDR c) (Dk c) (hDk c) n x, hx, map_zero]

  let ρ : ∀ c, wcHM S ℓ n →+ wcHM (Sc c) ℓ n := fun c => wcHMPull (Dθ c) n
  let P := wcHMPull DF n
  let Q : ∀ c, wcHM (Sc c) ℓ n →+ wcHM (Sc c) ℓ n := fun c => wcHMPull (DFF c) n
  have hρs : ∀ c (a : ℚ_[ℓ]) (x : wcHM S ℓ n),
      ρ c (wcHMScalar S ℓ n a x) = wcHMScalar (Sc c) ℓ n a (ρ c x) :=
    fun c a x => pullScalar (Dθ c) (hDθ c) n a x
  have hPs : ∀ (a : ℚ_[ℓ]) (x : wcHM S ℓ n),
      P (wcHMScalar S ℓ n a x) = wcHMScalar S ℓ n a (P x) :=
    fun a x => pullScalar DF hDF n a x
  have hQs : ∀ c (a : ℚ_[ℓ]) (y : wcHM (Sc c) ℓ n),
      Q c (wcHMScalar (Sc c) ℓ n a y) = wcHMScalar (Sc c) ℓ n a (Q c y) :=
    fun c a y => pullScalar (DFF c) (hDFF c) n a y
  have hEs : ∀ (a : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]), E.symm (a • v) = wcHMScalar S ℓ n a (E.symm v) :=
    fun a v => E.injective (by rw [hE, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
  have hEWs : ∀ c (a : ℚ_[ℓ]) (v : Fin (rc c) → ℚ_[ℓ]),
      (Ec c).symm (a • v) = wcHMScalar (Sc c) ℓ n a ((Ec c).symm v) :=
    fun c a v => (Ec c).injective
      (by rw [hEc, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
  letI instW : ∀ c, AddCommGroup (wcHM (Sc c) ℓ n) := fun c => inferInstance
  let eqv : wcHM S ℓ n ≃+ (∀ c, wcHM (Sc c) ℓ n) := AddEquiv.ofBijective (AddMonoidHom.pi ρ) hρ
  have heqv : ∀ x c, eqv x c = ρ c x := fun _ _ => rfl
  let σ : ∀ c, wcHM (Sc c) ℓ n →+ wcHM S ℓ n := fun c =>
    (eqv.symm : (∀ c, wcHM (Sc c) ℓ n) →+ wcHM S ℓ n).comp
      (AddMonoidHom.single (fun c => wcHM (Sc c) ℓ n) c)
  have hσ : ∀ c y, σ c y = eqv.symm (Pi.single c y) := fun _ _ => rfl
  have hρσ : ∀ c d y, ρ d (σ c y) = Pi.single (M := fun c => wcHM (Sc c) ℓ n) c y d := by
    intro c d y
    rw [← heqv, hσ, AddEquiv.apply_symm_apply]
  have hσs : ∀ c (a : ℚ_[ℓ]) (y : wcHM (Sc c) ℓ n),
      σ c (wcHMScalar (Sc c) ℓ n a y) = wcHMScalar S ℓ n a (σ c y) := by
    intro c a y
    apply eqv.injective
    funext d
    rw [heqv, heqv, hρs, hρσ, hρσ]
    by_cases h : d = c
    · subst h; simp
    · rw [Pi.single_eq_of_ne h, Pi.single_eq_of_ne h, map_zero]
  have hsum : ∀ x, ∑ c, σ c (ρ c x) = x := by
    intro x
    apply eqv.injective
    rw [map_sum]
    funext d
    rw [Finset.sum_apply]
    simp only [heqv, hρσ]
    rw [Finset.sum_eq_single d]
    · simp
    · intro b _ hb; exact Pi.single_eq_of_ne' hb _
    · intro h; exact absurd (Finset.mem_univ d) h
  let LA : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) :=
    { toFun := fun v => E (P (E.symm v))
      map_add' := fun v w => by simp only [map_add]
      map_smul' := fun a v => by simp only [hEs, hPs, hE, RingHom.id_apply] }
  let LQ : ∀ c, (Fin (rc c) → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin (rc c) → ℚ_[ℓ]) := fun c =>
    { toFun := fun v => Ec c (Q c ((Ec c).symm v))
      map_add' := fun v w => by simp only [map_add]
      map_smul' := fun a v => by simp only [hEWs, hQs, hEc, RingHom.id_apply] }
  let Pr : ∀ c, (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin (rc c) → ℚ_[ℓ]) := fun c =>
    { toFun := fun v => Ec c (ρ c (E.symm v))
      map_add' := fun v w => by simp only [map_add]
      map_smul' := fun a v => by simp only [hEs, hρs, hEc, RingHom.id_apply] }
  let J : ∀ c, (Fin (rc c) → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) := fun c =>
    { toFun := fun w => E (σ c ((Ec c).symm w))
      map_add' := fun v w => by simp only [map_add]
      map_smul' := fun a v => by simp only [hEWs, hσs, hE, RingHom.id_apply] }
  have hA : wcAddEquivMatrix E P = LinearMap.toMatrix' LA := by
    ext a b
    rw [LinearMap.toMatrix'_apply]
    rfl
  have hQ : ∀ c, wcAddEquivMatrix (Ec c) (Q c) = LinearMap.toMatrix' (LQ c) := by
    intro c
    ext a b
    rw [LinearMap.toMatrix'_apply]
    rfl
  have htr : ∀ {k : ℕ} (f : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])),
      (LinearMap.toMatrix' f).trace = LinearMap.trace ℚ_[ℓ] _ f := by
    intro k f
    rw [← LinearMap.toMatrix_eq_toMatrix', ← LinearMap.trace_eq_matrix_trace]
  have hid : ∑ c, J c ∘ₗ Pr c = LinearMap.id := by
    refine LinearMap.ext fun v => ?_
    rw [LinearMap.sum_apply, LinearMap.id_apply]
    show ∑ c, E (σ c ((Ec c).symm (Ec c (ρ c (E.symm v))))) = v
    simp only [AddEquiv.symm_apply_apply]
    rw [← map_sum, hsum, AddEquiv.apply_symm_apply]
  have hblock : ∀ c, LinearMap.trace ℚ_[ℓ] _ ((LA ∘ₗ J c) ∘ₗ Pr c) =
      if τ c = c then LinearMap.trace ℚ_[ℓ] _ (LQ c) else 0 := by
    intro c
    rw [LinearMap.trace_comp_comm']
    split_ifs with h
    · congr 1
      refine LinearMap.ext fun w => ?_
      show Ec c (ρ c (E.symm (E (P (E.symm (E (σ c ((Ec c).symm w)))))))) =
        Ec c (Q c ((Ec c).symm w))
      rw [AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply]
      show Ec c (wcHMPull (Dθ c) n (wcHMPull DF n (σ c ((Ec c).symm w)))) =
        Ec c (wcHMPull (DFF c) n ((Ec c).symm w))
      rw [hfix c h]
      show Ec c (Q c (ρ c (σ c ((Ec c).symm w)))) = _
      rw [hρσ, Pi.single_eq_same]
    · have h0 : Pr c ∘ₗ (LA ∘ₗ J c) = 0 := by
        refine LinearMap.ext fun w => ?_
        show Ec c (ρ c (E.symm (E (P (E.symm (E (σ c ((Ec c).symm w)))))))) = 0
        rw [AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply]
        show Ec c (wcHMPull (Dθ c) n (wcHMPull DF n (σ c ((Ec c).symm w)))) = 0
        rw [hmove c h _ (by show ρ (τ c) _ = 0; rw [hρσ, Pi.single_eq_of_ne h]), map_zero]
      rw [h0, map_zero]
  calc (wcAddEquivMatrix E (wcHMPull DF n)).trace = LinearMap.trace ℚ_[ℓ] _ LA := by
        show (wcAddEquivMatrix E P).trace = _
        rw [hA, htr]
    _ = LinearMap.trace ℚ_[ℓ] _ (LA ∘ₗ ∑ c, J c ∘ₗ Pr c) := by rw [hid, LinearMap.comp_id]
    _ = ∑ c, LinearMap.trace ℚ_[ℓ] _ ((LA ∘ₗ J c) ∘ₗ Pr c) := by
        have e : LA ∘ₗ ∑ c, J c ∘ₗ Pr c = ∑ c, (LA ∘ₗ J c) ∘ₗ Pr c := by
          refine LinearMap.ext fun v => ?_
          simp only [LinearMap.comp_apply, LinearMap.sum_apply, map_sum]
        rw [e, map_sum]
    _ = ∑ c, if τ c = c then LinearMap.trace ℚ_[ℓ] _ (LQ c) else 0 :=
        Finset.sum_congr rfl (fun c _ => hblock c)
    _ = ∑ c ∈ Finset.univ.filter (fun c => τ c = c),
          (wcAddEquivMatrix (Ec c) (wcHMPull (DFF c) n)).trace := by
        rw [Finset.sum_filter]
        refine Finset.sum_congr rfl (fun c _ => ?_)
        split_ifs
        · rw [show wcHMPull (DFF c) n = Q c from rfl, hQ, htr]
        · rfl

theorem wc_pcl_cel_fixed_count_split (K K' : Type u) [Field K] [Field K'] {T : Scheme.{u}}
    (πT : T ⟶ Spec (.of K)) (g : Spec (.of K') ⟶ Spec (.of K)) [IsIso g] (Fr : T ⟶ T)
    {m : ℕ} {Sc : Fin m → Scheme.{u}} (πc : ∀ c, Sc c ⟶ Spec (.of K'))
    (θ : ∀ c, Sc c ⟶ T) (hθ : ∀ c, IsOpenImmersion (θ c))
    (hdisj : ∀ c d, c ≠ d → Disjoint (Set.range ⇑(θ c)) (Set.range ⇑(θ d)))
    (hcov : ∀ p : T, ∃ c, p ∈ Set.range ⇑(θ c))
    (hθπ : ∀ c, θ c ≫ πT = πc c ≫ g)
    (τ : Fin m → Fin m) (Frc : ∀ c, Sc c ⟶ Sc (τ c)) (hFrc : ∀ c, Frc c ≫ θ (τ c) = θ c ≫ Fr)
    (FrF : ∀ c, Sc c ⟶ Sc c) (hFrF : ∀ c, τ c = c → FrF c ≫ θ c = θ c ≫ Fr)
    (hfin : ∀ c, τ c = c →
      Finite {w : Spec (.of K') ⟶ Sc c // w ≫ πc c = 𝟙 _ ∧ w ≫ FrF c = w}) :
    Finite {z : Spec (.of K) ⟶ T // z ≫ πT = 𝟙 _ ∧ z ≫ Fr = z} ∧
      Nat.card {z : Spec (.of K) ⟶ T // z ≫ πT = 𝟙 _ ∧ z ≫ Fr = z} =
        ∑ c ∈ Finset.univ.filter (fun c => τ c = c),
          Nat.card {w : Spec (.of K') ⟶ Sc c // w ≫ πc c = 𝟙 _ ∧ w ≫ FrF c = w} :=
by
  classical

  have huniq : ∀ (p : T) (c c' : Fin m), p ∈ Set.range ⇑(θ c) → p ∈ Set.range ⇑(θ c') →
      c = c' := by
    intro p c c' hp hp'
    by_contra h
    exact Set.disjoint_left.mp (hdisj c c' h) hp hp'

  have hlift : ∀ (z : Spec (.of K) ⟶ T), z ≫ πT = 𝟙 _ → z ≫ Fr = z →
      ∃ c, τ c = c ∧ ∃ w : Spec (.of K') ⟶ Sc c,
        w ≫ πc c = 𝟙 _ ∧ w ≫ FrF c = w ∧ inv g ≫ w ≫ θ c = z := by
    intro z hz₁ hz₂
    let p₀ : Spec (.of K) := default
    obtain ⟨c, q₀, hq₀⟩ := hcov (z p₀)
    haveI := hθ c
    have hrange : Set.range ⇑z ⊆ Set.range ⇑(θ c) := by
      rintro _ ⟨p, rfl⟩
      rw [Subsingleton.elim p p₀]
      exact ⟨q₀, hq₀⟩
    obtain ⟨w₀, hw₀⟩ : ∃ w₀ : Spec (.of K) ⟶ Sc c, w₀ ≫ θ c = z :=
      ⟨@IsOpenImmersion.lift _ _ _ (θ c) z (hθ c) hrange,
        @IsOpenImmersion.lift_fac _ _ _ (θ c) z (hθ c) hrange⟩
    have hτ : τ c = c := by
      by_contra hne
      have h1 : z p₀ ∈ Set.range ⇑(θ (τ c)) := by
        have e1 : (z ≫ Fr) p₀ = z p₀ := by rw [hz₂]
        have e2 : (Frc c ≫ θ (τ c)) q₀ = (θ c ≫ Fr) q₀ := by rw [hFrc c]
        simp only [Scheme.Hom.comp_apply] at e1 e2
        refine ⟨Frc c q₀, ?_⟩
        rw [e2, hq₀, e1]
      exact Set.disjoint_left.mp (hdisj (τ c) c hne) h1 ⟨q₀, hq₀⟩
    refine ⟨c, hτ, g ≫ w₀, ?_, ?_, ?_⟩
    · rw [← cancel_mono g]
      simp only [Category.assoc]
      rw [← hθπ c, reassoc_of% hw₀, hz₁, Category.comp_id, Category.id_comp]
    · rw [← cancel_mono (θ c)]
      simp only [Category.assoc]
      rw [hFrF c hτ, reassoc_of% hw₀, hz₂, hw₀]
    · rw [Category.assoc, IsIso.inv_hom_id_assoc, hw₀]

  let Φ : (Σ c : {c : Fin m // τ c = c},
      {w : Spec (.of K') ⟶ Sc c.1 // w ≫ πc c.1 = 𝟙 _ ∧ w ≫ FrF c.1 = w}) →
      {z : Spec (.of K) ⟶ T // z ≫ πT = 𝟙 _ ∧ z ≫ Fr = z} := fun x =>
    ⟨inv g ≫ x.2.1 ≫ θ x.1.1, by
      simp only [Category.assoc]
      rw [hθπ, ← Category.assoc x.2.1, x.2.2.1, Category.id_comp, IsIso.inv_hom_id], by
      simp only [Category.assoc]
      rw [← hFrF _ x.1.2, ← Category.assoc x.2.1, x.2.2.2]⟩
  have inj : Function.Injective Φ := by
    rintro ⟨⟨c, hc⟩, ⟨w, hw₁, hw₂⟩⟩ ⟨⟨c', hc'⟩, ⟨w', hw₁', hw₂'⟩⟩ h
    have h1 : inv g ≫ w ≫ θ c = inv g ≫ w' ≫ θ c' := congrArg Subtype.val h
    rw [cancel_epi] at h1
    have hcc : c = c' := by
      let p : Spec (.of K') := default
      refine huniq ((w ≫ θ c) p) c c' ⟨w p, ?_⟩ ⟨w' p, ?_⟩
      · rw [Scheme.Hom.comp_apply]
      · rw [h1, Scheme.Hom.comp_apply]
    subst hcc
    haveI := hθ c
    rw [cancel_mono] at h1
    subst h1
    rfl
  have surj : Function.Surjective Φ := by
    rintro ⟨z, hz₁, hz₂⟩
    obtain ⟨c, hc, w, hw₁, hw₂, hz⟩ := hlift z hz₁ hz₂
    exact ⟨⟨⟨c, hc⟩, ⟨w, hw₁, hw₂⟩⟩, Subtype.ext hz⟩

  haveI : ∀ c : {c : Fin m // τ c = c},
      Finite {w : Spec (.of K') ⟶ Sc c.1 // w ≫ πc c.1 = 𝟙 _ ∧ w ≫ FrF c.1 = w} :=
    fun c => hfin c.1 c.2
  refine ⟨Finite.of_surjective Φ surj, ?_⟩
  rw [← Nat.card_congr (Equiv.ofBijective Φ ⟨inj, surj⟩), Nat.card_sigma]
  exact (Finset.sum_subtype _ (fun c => by simp)
    (fun c => Nat.card {w : Spec (.of K') ⟶ Sc c // w ≫ πc c = 𝟙 _ ∧ w ≫ FrF c = w})).symm

theorem wc_pcl_curve_endo_lefschetz (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [IsProper X.hom] [SmoothOfRelativeDimension 1 X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (Fr : wcXbar F X ⟶ wcXbar F X) (hF : Fr ≫ wcPi2 F X = wcPi2 F X)
    (hEt : Etale (Limits.pullback.fst (wcGraph (wcPi2 F X) Fr hF 1)
        (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X))
    (DF : wcHMPullData Fr ℓ) (hDF : wcHMPullCanonical DF)
    (r : Fin 3 → ℕ) (E : ∀ i : Fin 3, wcHM (wcXbar F X) ℓ i ≃+ (Fin (r i) → ℚ_[ℓ]))
    (hE : ∀ (i : Fin 3) (c : ℚ_[ℓ]) (y : wcHM (wcXbar F X) ℓ i),
      E i (wcHMScalar (wcXbar F X) ℓ i c y) = c • E i y) :
    Finite {z : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X //
        z ≫ wcPi2 F X = 𝟙 _ ∧ z ≫ Fr = z} ∧
      ∑ i : Fin 3, (-1 : ℚ_[ℓ]) ^ (i : ℕ) * (wcAddEquivMatrix (E i) (wcHMPull DF i)).trace =
        (Nat.card {z : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X //
          z ≫ wcPi2 F X = 𝟙 _ ∧ z ≫ Fr = z} : ℚ_[ℓ]) :=
by

  obtain ⟨F', _, _, _, ⟨k, hk⟩, m, U, hUdisj, hUcov, hU⟩ := wc_pcl_cel_split_field F X
  obtain ⟨κ, rW, hθU⟩ := wc_pcl_cel_base_change_open F X F'
  choose θU hθUo hθUπ hθUr using hθU
  have hGI : ∀ c, GeometricallyIrreducible (wcPclCelPiece F X F' (U c)).hom := fun c => (hU c).1
  have hPr : ∀ c, IsProper (wcPclCelPiece F X F' (U c)).hom := fun c => (hU c).2.1
  have hSm : ∀ c, SmoothOfRelativeDimension 1 (wcPclCelPiece F X F' (U c)).hom :=
    fun c => (hU c).2.2
  have hθ : ∀ c, IsOpenImmersion (θU (U c)) := fun c => hθUo (U c)
  obtain ⟨g, hg⟩ : ∃ g : Spec (.of (AlgebraicClosure F')) ⟶ Spec (.of (AlgebraicClosure F)),
      g = Spec.map (CommRingCat.ofHom (κ : AlgebraicClosure F →+* AlgebraicClosure F')) :=
    ⟨_, rfl⟩
  haveI hκ : IsIso (CommRingCat.ofHom (κ : AlgebraicClosure F →+* AlgebraicClosure F')) :=
    ⟨⟨CommRingCat.ofHom (κ.symm : AlgebraicClosure F' →+* AlgebraicClosure F),
      by ext x; simp, by ext x; simp⟩⟩
  haveI : IsIso g := by rw [hg]; infer_instance
  have hθπ : ∀ c, θU (U c) ≫ wcPi2 F X = wcPi2 F' (wcPclCelPiece F X F' (U c)) ≫ g := by
    intro c; rw [hg]; exact hθUπ (U c)
  have hdisj : ∀ c d, c ≠ d →
      Disjoint (Set.range ⇑(θU (U c))) (Set.range ⇑(θU (U d))) := by
    intro c d hcd
    rw [hθUr (U c), hθUr (U d)]
    exact Disjoint.preimage _ (hUdisj c d hcd)
  have hcov : ∀ p : wcXbar F X, ∃ c, p ∈ Set.range ⇑(θU (U c)) := by
    intro p
    obtain ⟨c, hc⟩ := hUcov (rW p)
    exact ⟨c, by rw [hθUr (U c)]; exact hc⟩

  have hℓ' : ¬ ℓ ∣ Nat.card F' := by
    rw [hk]; intro h; exact hℓ ((Fact.out : ℓ.Prime).dvd_of_dvd_pow h)
  have hℓK : ((ℓ : ℕ) : AlgebraicClosure F') ≠ 0 := by
    intro h0
    have h1 : ((ℓ : ℕ) : F') = 0 := by
      apply (algebraMap F' (AlgebraicClosure F')).injective
      rw [map_natCast, map_zero]; exact h0
    haveI : Fact (Nat.Prime (ringChar F')) := ⟨CharP.char_is_prime F' (ringChar F')⟩
    have h2 : ringChar F' ∣ ℓ := ringChar.dvd h1
    have h3 : ringChar F' = ℓ :=
      (Nat.prime_dvd_prime_iff_eq (Fact.out : (ringChar F').Prime) (Fact.out : ℓ.Prime)).mp h2
    have h4 : ((Nat.card F' : ℕ) : F') = 0 := by
      letI := Fintype.ofFinite F'
      rw [Nat.card_eq_fintype_card]; exact FiniteField.cast_card_eq_zero F'
    apply hℓ'
    rw [← h3]; exact ringChar.dvd h4

  have hirr : ∀ c, _root_.IsPreconnected (Set.univ : Set (wcXbar F' (wcPclCelPiece F X F' (U c)))) := by
    intro c
    haveI : IrreducibleSpace (wcXbar F' (wcPclCelPiece F X F' (U c))) :=
      (hGI c).geometrically_irreducibleSpace
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))
        (Limits.pullback.fst _ _) (Limits.pullback.snd _ _) (IsPullback.of_hasPullback _ _)
    exact isPreconnected_univ
  have hclopen : ∀ d, IsClopen (Set.range ⇑(θU (U d))) := by
    intro d
    refine ⟨?_, @IsOpenImmersion.isOpen_range _ _ (θU (U d)) (hθ d)⟩
    have hcompl : (Set.range ⇑(θU (U d)))ᶜ = ⋃ e ∈ {e | e ≠ d}, Set.range ⇑(θU (U e)) := by
      ext p
      simp only [Set.mem_compl_iff, Set.mem_iUnion, Set.mem_setOf_eq, exists_prop]
      constructor
      · intro hp
        obtain ⟨e, he⟩ := hcov p
        refine ⟨e, fun h => hp ?_, he⟩
        subst h
        exact he
      · rintro ⟨e, hed, he⟩ hd
        exact Set.disjoint_left.mp (hdisj e d hed) he hd
    rw [← isOpen_compl_iff, hcompl]
    exact isOpen_biUnion (fun e _ => @IsOpenImmersion.isOpen_range _ _ (θU (U e)) (hθ e))
  have hτex : ∀ c, ∃ d, Set.range ⇑(θU (U c) ≫ Fr) ⊆ Set.range ⇑(θU (U d)) := by
    intro c
    by_cases hne : Nonempty (wcXbar F' (wcPclCelPiece F X F' (U c)))
    · obtain ⟨p⟩ := hne
      obtain ⟨d, hd⟩ := hcov ((θU (U c) ≫ Fr) p)
      refine ⟨d, ?_⟩
      have hpc : _root_.IsPreconnected (Set.range ⇑(θU (U c) ≫ Fr)) := by
        rw [← Set.image_univ]
        exact (hirr c).image _ (Scheme.Hom.continuous (θU (U c) ≫ Fr)).continuousOn
      exact hpc.subset_isClopen (hclopen d) ⟨(θU (U c) ≫ Fr) p, ⟨p, rfl⟩, hd⟩
    · refine ⟨c, ?_⟩
      rintro _ ⟨p, rfl⟩
      exact absurd ⟨p⟩ hne
  choose τ hτ using hτex
  have hFrcex : ∀ c, ∃ f : wcXbar F' (wcPclCelPiece F X F' (U c)) ⟶
      wcXbar F' (wcPclCelPiece F X F' (U (τ c))), f ≫ θU (U (τ c)) = θU (U c) ≫ Fr := fun c =>
    ⟨@IsOpenImmersion.lift _ _ _ (θU (U (τ c))) (θU (U c) ≫ Fr) (hθ (τ c)) (hτ c),
      @IsOpenImmersion.lift_fac _ _ _ (θU (U (τ c))) (θU (U c) ≫ Fr) (hθ (τ c)) (hτ c)⟩
  choose Frc hFrc using hFrcex
  have hFrFex : ∀ c, ∃ f : wcXbar F' (wcPclCelPiece F X F' (U c)) ⟶
      wcXbar F' (wcPclCelPiece F X F' (U c)), τ c = c → f ≫ θU (U c) = θU (U c) ≫ Fr := by
    intro c
    by_cases h : τ c = c
    · have hs : Set.range ⇑(θU (U c) ≫ Fr) ⊆ Set.range ⇑(θU (U c)) := by
        have h' := hτ c
        rw [h] at h'
        exact h'
      exact ⟨@IsOpenImmersion.lift _ _ _ (θU (U c)) (θU (U c) ≫ Fr) (hθ c) hs,
        fun _ => @IsOpenImmersion.lift_fac _ _ _ (θU (U c)) (θU (U c) ≫ Fr) (hθ c) hs⟩
    · exact ⟨𝟙 _, fun h' => absurd h' h⟩
  choose FrF hFrF using hFrFex
  have hFc : ∀ c, τ c = c →
      FrF c ≫ wcPi2 F' (wcPclCelPiece F X F' (U c)) = wcPi2 F' (wcPclCelPiece F X F' (U c)) := by
    intro c hc
    rw [← cancel_mono g, Category.assoc, ← hθπ c, ← Category.assoc, hFrF c hc, Category.assoc, hF]
  have hEtc : ∀ c (hc : τ c = c), Etale (Limits.pullback.fst
      (wcGraph (wcPi2 F' (wcPclCelPiece F X F' (U c))) (FrF c) (hFc c hc) 1)
      (Limits.pullback.diagonal (wcPi2 F' (wcPclCelPiece F X F' (U c)))) ≫
        wcPi2 F' (wcPclCelPiece F X F' (U c))) := fun c hc =>
    @wc_pcl_cel_fix_etale_restrict _ _ _ _ (θU (U c)) (hθ c) (wcPi2 F X)
      (wcPi2 F' (wcPclCelPiece F X F' (U c))) g inferInstance (hθπ c) Fr hF (FrF c) (hFc c hc)
      (hFrF c hc) hEt

  have hcoordex : ∀ (c : Fin m) (i : Fin 3), ∃ (rr : ℕ)
      (e : wcHM (wcXbar F' (wcPclCelPiece F X F' (U c))) ℓ i ≃+ (Fin rr → ℚ_[ℓ])),
      ∀ (a : ℚ_[ℓ]) (y : wcHM (wcXbar F' (wcPclCelPiece F X F' (U c))) ℓ i),
        e (wcHMScalar (wcXbar F' (wcPclCelPiece F X F' (U c))) ℓ i a y) = a • e y := by
    intro c i
    haveI := hPr c
    exact wc_hm_proper_algclosed_findim (AlgebraicClosure F')
      (wcPi2 F' (wcPclCelPiece F X F' (U c))) ℓ hℓK i
  choose rc Ec hEc using hcoordex
  choose DFF hDFF using fun c => wc_hm_pull_data_exists (FrF c) ℓ

  have hGIc : ∀ c (hc : τ c = c),
      Finite {w : Spec (.of (AlgebraicClosure F')) ⟶ wcXbar F' (wcPclCelPiece F X F' (U c)) //
        w ≫ wcPi2 F' (wcPclCelPiece F X F' (U c)) = 𝟙 _ ∧ w ≫ FrF c = w} ∧
      ∑ i : Fin 3, (-1 : ℚ_[ℓ]) ^ (i : ℕ) *
          (wcAddEquivMatrix (Ec c i) (wcHMPull (DFF c) i)).trace =
        (Nat.card {w : Spec (.of (AlgebraicClosure F')) ⟶ wcXbar F' (wcPclCelPiece F X F' (U c)) //
          w ≫ wcPi2 F' (wcPclCelPiece F X F' (U c)) = 𝟙 _ ∧ w ≫ FrF c = w} : ℚ_[ℓ]) := by
    intro c hc
    haveI := hGI c
    haveI := hPr c
    haveI := hSm c
    exact wc_pcl_cel_gi_case F' (wcPclCelPiece F X F' (U c)) ℓ hℓ' (FrF c) (hFc c hc) (hEtc c hc)
      (DFF c) (hDFF c) (rc c) (Ec c) (hEc c)

  obtain ⟨hfinS, hcard⟩ := wc_pcl_cel_fixed_count_split (AlgebraicClosure F) (AlgebraicClosure F')
    (wcPi2 F X) g Fr (Sc := fun c => wcXbar F' (wcPclCelPiece F X F' (U c)))
    (fun c => wcPi2 F' (wcPclCelPiece F X F' (U c))) (fun c => θU (U c)) hθ hdisj hcov hθπ
    τ Frc hFrc FrF hFrF (fun c hc => (hGIc c hc).1)

  have htr : ∀ i : Fin 3, (wcAddEquivMatrix (E i) (wcHMPull DF i)).trace =
      ∑ c ∈ Finset.univ.filter (fun c => τ c = c),
        (wcAddEquivMatrix (Ec c i) (wcHMPull (DFF c) i)).trace := fun i =>
    wc_pcl_cel_trace_split (Sc := fun c => wcXbar F' (wcPclCelPiece F X F' (U c)))
      (fun c => θU (U c)) hθ hdisj hcov Fr DF hDF τ Frc hFrc FrF hFrF DFF hDFF (i : ℕ) (r i) (E i)
      (hE i) (fun c => rc c i) (fun c => Ec c i) (fun c => hEc c i)

  refine ⟨hfinS, ?_⟩
  rw [hcard, Nat.cast_sum]
  simp_rw [htr, Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl (fun c hc => ?_)
  exact (hGIc c (Finset.mem_filter.mp hc).2).2

theorem wc_proper_cover_twisted_lefschetz (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    {Y : Scheme.{u}} (qb : Y ⟶ (wcP1Over K).left) (hqb : IsFinite qb)
    (hYp : IsProper (qb ≫ (wcP1Over K).hom))
    (hYs : SmoothOfRelativeDimension 1 (qb ≫ (wcP1Over K).hom))
    (a : Y ⟶ Y) (ha : a ≫ qb = qb) (e : ℕ) (he : 1 ≤ e) :
    ∃ (r : ℕ → ℕ)
      (ι : ∀ i, wcCohG K (wcP1Over K) hP (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) i →+
        (Fin (r i) → ℚ_[ℓ]))
      (A : ∀ i, Matrix (Fin (r i)) (Fin (r i)) ℚ_[ℓ]),
      (∀ i < 3, wcRatCoord ℓ (ι i)) ∧
      (∀ i < 3, ∀ x, ι i ((⇑(wcCohGFrob K (wcP1Over K) hP
          (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) i))^[e]
          (wcCohGEnd K (wcP1Over K) hP (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) i
            (wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ a ha) x)) =
          (A i).mulVec (ι i x)) ∧
      ∑ i ∈ Finset.range 3, (-1 : ℚ_[ℓ]) ^ i * (A i).trace =
        (Nat.card {y : Spec (.of (AlgebraicClosure K)) ⟶ Y //
          y ≫ qb ≫ (wcP1Over K).hom = wcKbarPt K ∧ wcFrE K e ≫ y ≫ a = y} : ℚ_[ℓ]) ∧
      Finite {y : Spec (.of (AlgebraicClosure K)) ⟶ Y //
          y ≫ qb ≫ (wcP1Over K).hom = wcKbarPt K ∧ wcFrE K e ≫ y ≫ a = y} :=
by
  classical
  haveI hYp' : IsProper (wcPclYo K qb).hom := hYp
  haveI hYs' : SmoothOfRelativeDimension 1 (wcPclYo K qb).hom := hYs
  have hY : WeaklyEtale (Limits.pullback.fst (wcPclYo K qb).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure K)
  obtain ⟨φ, hφ, hFφ⟩ := wc_abs_frob_exists K (wcPclYo K qb) hY

  have hab1 : wcPclAbar K qb a ha ≫ Limits.pullback.fst (wcPclYo K qb).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
      Limits.pullback.fst (wcPclYo K qb).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ≫ a :=
    Limits.pullback.lift_fst _ _ _
  have hab2 : wcPclAbar K qb a ha ≫ wcPi2 K (wcPclYo K qb) = wcPi2 K (wcPclYo K qb) :=
    (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)

  have hI1 : ∀ m : ℕ, wcIter (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ) m ≫ wcPi2 K (wcPclYo K qb) =
      wcPi2 K (wcPclYo K qb) := by
    intro m
    induction m with
    | zero => exact Category.id_comp _
    | succ m ih =>
      show (wcIter (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ) m ≫
        (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ)) ≫ wcPi2 K (wcPclYo K qb) = wcPi2 K (wcPclYo K qb)
      rw [Category.assoc, hFφ, ih]
  have hF' : (wcIter (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ) e ≫ wcPclAbar K qb a ha) ≫
      wcPi2 K (wcPclYo K qb) = wcPi2 K (wcPclYo K qb) := by
    rw [Category.assoc, hab2, hI1]

  have hnat : ∀ {A B : Scheme.{u}} (h' : A ⟶ B) (φA : A ⟶ A) (φB : B ⟶ B),
      wcIsAbsFrob φA (Nat.card K) → wcIsAbsFrob φB (Nat.card K) → h' ≫ φB = φA ≫ h' := by
    intro A B h' φA φB hA hB
    refine Scheme.Hom.ext ?_ ?_
    · ext a
      show (h' ≫ φB) a = (φA ≫ h') a
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hB.1, hA.1]
    · intro U
      have hU : U ≤ φB ⁻¹ᵁ U := fun y hy => by
        show φB y ∈ U
        rw [hB.1]
        exact hy
      have hVh : (φA ≫ h') ⁻¹ᵁ U ≤ h' ⁻¹ᵁ U := fun y hy => by
        have h1 : (φA ≫ h') y ∈ U := hy
        rw [Scheme.Hom.comp_apply, hA.1] at h1
        exact h1
      have hVA : (φA ≫ h') ⁻¹ᵁ U ≤ φA ⁻¹ᵁ ((φA ≫ h') ⁻¹ᵁ U) := fun y hy => by
        show (φA ≫ h') (φA y) ∈ U
        rw [hA.1]
        exact hy
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map, Scheme.Hom.app_eq_appLE,
        ← Scheme.Hom.appLE_comp_appLE h' φB U U _ hU hVh,
        ← Scheme.Hom.appLE_comp_appLE φA h' U _ _ hVh hVA]
      ext s
      simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply]
      rw [hA.2 _ hVA, hB.2 _ hU, map_pow]

  have key : ∀ {K : Type u} [Field K] {Y : Scheme.{u}} (π : Y ⟶ Spec (.of K))
      [IsSeparated π] [LocallyOfFiniteType π] (Fr : Y ⟶ Y) (hF : Fr ≫ π = π) (k φ : Y ⟶ Y)
      (q : ℕ), wcIsAbsFrob φ q → (q : K) = 0 → ∀ n : ℕ, wcIter Fr n = k ≫ φ →
      Etale (Limits.pullback.fst (wcGraph π Fr hF n) (Limits.pullback.diagonal π) ≫ π) := by
    have s2 : ∀ {K A W B : Type u} [CommRing K] [CommRing A] [CommRing W] [CommRing B]
        [Algebra K B] [Algebra A W] (f : A) [IsLocalization.Away f W] (θ : A →+* W) (ι : W →+* B),
        Function.Surjective ι → ∀ (q : ℕ), (q : B) = 0 →
        (∀ a : A, ι (algebraMap A W a) = ι (θ a)) → (∀ a : A, ∃ b : W, θ a = b ^ q) →
        Subsingleton Ω[B⁄K] := by
      intro K A W B _ _ _ _ _ _ f _ θ ι hι q hq hfix hpow
      have ha : ∀ a : A, KaehlerDifferential.D K B (ι (algebraMap A W a)) = 0 := by
        intro a
        obtain ⟨b, hb⟩ := hpow a
        rw [hfix a, hb, map_pow, Derivation.leibniz_pow, ← Nat.cast_smul_eq_nsmul B, hq, zero_smul]
      have hw : ∀ w : W, KaehlerDifferential.D K B (ι w) = 0 := by
        intro w
        obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj (Submonoid.powers f) w
        have h1 := congrArg (fun x => KaehlerDifferential.D K B (ι x)) hs
        simp only [map_mul, Derivation.leibniz, ha, smul_zero, zero_add] at h1
        have hu : IsUnit (ι (algebraMap A W s)) := (IsLocalization.map_units W s).map ι
        exact (hu.smul_left_cancel).mp (by rw [h1, smul_zero])
      have hall : ∀ b : B, KaehlerDifferential.D K B b = 0 := fun b => by
        obtain ⟨w, rfl⟩ := hι b
        exact hw w
      have htop := KaehlerDifferential.span_range_derivation K B
      have hbot : Submodule.span B (Set.range (KaehlerDifferential.D K B)) = ⊥ := by
        rw [Submodule.span_eq_bot]
        rintro _ ⟨b, rfl⟩
        exact hall b
      rw [hbot] at htop
      refine ⟨fun x y => ?_⟩
      have hx : x ∈ (⊥ : Submodule B Ω[B⁄K]) := htop ▸ Submodule.mem_top
      have hy : y ∈ (⊥ : Submodule B Ω[B⁄K]) := htop ▸ Submodule.mem_top
      rw [Submodule.mem_bot] at hx hy
      rw [hx, hy]
    have s3 : ∀ {K : Type u} [Field K] {Z : Scheme.{u}} (p : Z ⟶ Spec (.of K))
        [LocallyOfFiniteType p],
        (∀ z : Z, ∃ (V : Z.Opens) (_ : IsAffineOpen V), z ∈ V ∧
          letI : Algebra K Γ(Z, V) :=
            ((p.appLE ⊤ V (le_top.trans_eq (Scheme.Hom.preimage_top p).symm)).hom.comp
              (Scheme.ΓSpecIso (.of K)).inv.hom).toAlgebra
          Subsingleton Ω[Γ(Z, V)⁄K]) → Etale p := by
      intro K _ Z p _ H
      rw [HasRingHomProperty.iff_exists_appLE (P := @Etale) (Q := RingHom.Etale)
        (RingHom.StableUnderComposition.stableUnderCompositionWithLocalizationAway
          RingHom.Etale.stableUnderComposition (RingHom.PropertyIsLocal.HoldsForLocalizationAway
            RingHom.Etale.propertyIsLocal RingHom.Etale.containsIdentities)).1]
      intro z
      obtain ⟨V, hV, hz, hΩ⟩ := H z
      refine ⟨⟨⊤, isAffineOpen_top _⟩, ⟨V, hV⟩, hz,
        le_top.trans_eq (Scheme.Hom.preimage_top p).symm, ?_⟩
      letI : Algebra K Γ(Z, V) :=
        ((p.appLE ⊤ V (le_top.trans_eq (Scheme.Hom.preimage_top p).symm)).hom.comp
          (Scheme.ΓSpecIso (.of K)).inv.hom).toAlgebra
      have hft : RingHom.FiniteType
          ((p.appLE ⊤ V (le_top.trans_eq (Scheme.Hom.preimage_top p).symm)).hom.comp
            (Scheme.ΓSpecIso (.of K)).inv.hom) :=
        RingHom.FiniteType.comp
          (HasRingHomProperty.appLE @LocallyOfFiniteType p ‹_› ⟨⊤, isAffineOpen_top _⟩ ⟨V, hV⟩ _)
          (RingHom.FiniteType.of_surjective _
            (Scheme.ΓSpecIso (.of K)).commRingCatIsoToRingEquiv.symm.surjective)
      have : Algebra.FiniteType K Γ(Z, V) := hft
      have : Algebra.FinitePresentation K Γ(Z, V) := Algebra.FinitePresentation.of_finiteType.mp this
      have : Algebra.FormallyUnramified K Γ(Z, V) := Algebra.FormallyUnramified.mk hΩ
      have hψ : RingHom.Etale
          ((p.appLE ⊤ V (le_top.trans_eq (Scheme.Hom.preimage_top p).symm)).hom.comp
            (Scheme.ΓSpecIso (.of K)).inv.hom) :=
        (Algebra.Etale.of_formallyUnramified_of_flat : Algebra.Etale K Γ(Z, V))
      have h2 := RingHom.Etale.respectsIso.2 _
        (Scheme.ΓSpecIso (.of K)).commRingCatIsoToRingEquiv hψ
      convert h2 using 1
      ext x
      exact congrArg
        (fun y => (p.appLE ⊤ V (le_top.trans_eq (Scheme.Hom.preimage_top p).symm)).hom y)
        (Iso.hom_inv_id_apply (Scheme.ΓSpecIso (.of K)) x).symm
    have s4 : ∀ {Y : Scheme.{u}} (φ k : Y ⟶ Y) (q : ℕ), wcIsAbsFrob φ q →
        ∀ (U W : Y.Opens) (hW : W ≤ (k ≫ φ) ⁻¹ᵁ U) (a : Γ(Y, U)),
        ∃ b : Γ(Y, W), ((k ≫ φ).appLE U W hW).hom a = b ^ q := by
      intro Y φ k q hφ U W hW a
      have hφU : U ≤ φ ⁻¹ᵁ U := fun y hy =>
        (Scheme.Hom.mem_preimage φ).mpr (by rw [hφ.1 y]; exact hy)
      have e₂ : W ≤ k ⁻¹ᵁ U := fun y hy => by
        have h1 := (Scheme.Hom.mem_preimage _).mp (hW hy)
        rw [Scheme.Hom.comp_apply, hφ.1] at h1
        exact (Scheme.Hom.mem_preimage k).mpr h1
      refine ⟨(k.appLE U W e₂).hom a, ?_⟩
      have e := Scheme.Hom.appLE_comp_appLE k φ U U W hφU e₂
      rw [← e, CommRingCat.hom_comp, RingHom.comp_apply, hφ.2 U hφU a, map_pow]
    have hcongr : ∀ {A B : Scheme.{u}} (f₁ f₂ : A ⟶ B) (_ : f₁ = f₂) (U : B.Opens) (V : A.Opens)
        (e₁ : V ≤ f₁ ⁻¹ᵁ U) (e₂ : V ≤ f₂ ⁻¹ᵁ U), f₁.appLE U V e₁ = f₂.appLE U V e₂ := by
      intro A B f₁ f₂ hf U V e₁ e₂
      subst hf
      rfl
    intro K _ Y π _ _ Fr hF k φ q hφ hq n hk
    have hγ1 : wcGraph π Fr hF n ≫ Limits.pullback.fst π π = 𝟙 _ := by
      unfold wcGraph; exact Limits.pullback.lift_fst _ _ _
    have hγ2 : wcGraph π Fr hF n ≫ Limits.pullback.snd π π = wcIter Fr n := by
      unfold wcGraph; exact Limits.pullback.lift_snd _ _ _
    have s1 : Limits.pullback.fst (wcGraph π Fr hF n) (Limits.pullback.diagonal π) ≫
        wcIter Fr n = Limits.pullback.fst (wcGraph π Fr hF n) (Limits.pullback.diagonal π) := by
      have c := Limits.pullback.condition (f := wcGraph π Fr hF n)
        (g := Limits.pullback.diagonal π)
      have c1 := congrArg (· ≫ Limits.pullback.fst π π) c
      have c2 := congrArg (· ≫ Limits.pullback.snd π π) c
      simp only [Category.assoc, hγ1, hγ2, Limits.pullback.diagonal_fst,
        Limits.pullback.diagonal_snd, Category.comp_id] at c1 c2
      rw [c2, c1]
    rw [hk] at s1
    have : IsClosedImmersion (Limits.pullback.diagonal π) :=
      IsSeparated.isClosedImmersion_diagonal
    have : IsClosedImmersion
        (Limits.pullback.fst (wcGraph π Fr hF n) (Limits.pullback.diagonal π)) :=
      inferInstance
    set i := Limits.pullback.fst (wcGraph π Fr hF n) (Limits.pullback.diagonal π) with hi
    refine s3 (i ≫ π) (fun z => ?_)
    obtain ⟨U, hU, hxU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens Y)) (show i z ∈ (⊤ : Y.Opens) from trivial)
    have hU' : IsAffineOpen U := hU
    have hx' : i z ∈ (k ≫ φ) ⁻¹ᵁ U := by
      have e : (i ≫ k ≫ φ) z = i z := by rw [s1]
      rw [Scheme.Hom.comp_apply] at e
      exact (Scheme.Hom.mem_preimage _).mpr (by rw [e]; exact hxU)
    obtain ⟨f, hfW, hxW⟩ := hU'.exists_basicOpen_le (V := U ⊓ (k ≫ φ) ⁻¹ᵁ U)
      ⟨i z, TopologicalSpace.Opens.mem_inf.mpr ⟨hxU, hx'⟩⟩ hxU
    have hWU : Y.basicOpen f ≤ U := Y.basicOpen_le f
    have hWh : Y.basicOpen f ≤ (k ≫ φ) ⁻¹ᵁ U := hfW.trans inf_le_right
    have hWaff : IsAffineOpen (Y.basicOpen f) := hU'.basicOpen f
    refine ⟨i ⁻¹ᵁ Y.basicOpen f, IsAffineHom.isAffine_preimage _ hWaff,
      (Scheme.Hom.mem_preimage i).mpr hxW, ?_⟩
    letI : Algebra K Γ(Limits.pullback (wcGraph π Fr hF n) (Limits.pullback.diagonal π),
        i ⁻¹ᵁ Y.basicOpen f) :=
      (((i ≫ π).appLE ⊤ (i ⁻¹ᵁ Y.basicOpen f)
        (le_top.trans_eq (Scheme.Hom.preimage_top (i ≫ π)).symm)).hom.comp
        (Scheme.ΓSpecIso (.of K)).inv.hom).toAlgebra
    letI : Algebra Γ(Y, U) Γ(Y, Y.basicOpen f) := Scheme.algebra_section_section_basicOpen f
    have : IsLocalization.Away f Γ(Y, Y.basicOpen f) := hU'.isLocalization_basicOpen f
    refine s2 f ((k ≫ φ).appLE U (Y.basicOpen f) hWh).hom
      (i.appLE (Y.basicOpen f) (i ⁻¹ᵁ Y.basicOpen f) le_rfl).hom ?_ q ?_ ?_ ?_
    · have hs := Scheme.Hom.app_surjective i (Y.basicOpen f) hWaff
      rwa [Scheme.Hom.app_eq_appLE] at hs
    · rw [← map_natCast (algebraMap K Γ(Limits.pullback (wcGraph π Fr hF n)
        (Limits.pullback.diagonal π), i ⁻¹ᵁ Y.basicOpen f)) q, hq, map_zero]
    · intro a
      show (Y.presheaf.map (homOfLE hWU).op ≫
          i.appLE (Y.basicOpen f) (i ⁻¹ᵁ Y.basicOpen f) le_rfl).hom a =
        ((k ≫ φ).appLE U (Y.basicOpen f) hWh ≫
          i.appLE (Y.basicOpen f) (i ⁻¹ᵁ Y.basicOpen f) le_rfl).hom a
      rw [Scheme.Hom.map_appLE, Scheme.Hom.appLE_comp_appLE]
      exact congrArg (fun φ' => CommRingCat.Hom.hom φ' a)
        (hcongr i (i ≫ k ≫ φ) s1.symm U (i ⁻¹ᵁ Y.basicOpen f) _ _)
    · intro a
      exact s4 φ k q hφ U (Y.basicOpen f) hWh a
  have hq : (Nat.card K : AlgebraicClosure K) = 0 := by
    letI := Fintype.ofFinite K
    rw [← map_natCast (algebraMap K (AlgebraicClosure K)), Nat.card_eq_fintype_card,
      FiniteField.cast_card_eq_zero, map_zero]
  have hEt : Etale (Limits.pullback.fst (wcGraph (wcPi2 K (wcPclYo K qb))
      (wcIter (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ) e ≫ wcPclAbar K qb a ha) hF' 1)
      (Limits.pullback.diagonal (wcPi2 K (wcPclYo K qb))) ≫ wcPi2 K (wcPclYo K qb)) := by
    obtain ⟨m, rfl⟩ : ∃ m, e = m + 1 := ⟨e - 1, by omega⟩
    refine key (wcPi2 K (wcPclYo K qb)) _ hF'
      (wcIter (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ) m ≫ wcGeomFrobX K (wcPclYo K qb) hY ≫
        wcPclAbar K qb a ha) φ (Nat.card K) hφ hq 1 ?_
    show 𝟙 _ ≫ ((wcIter (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ) m ≫
      (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ)) ≫ wcPclAbar K qb a ha) = _
    simp only [Category.id_comp, Category.assoc]
    rw [hnat (wcPclAbar K qb a ha) φ φ hφ hφ]

  obtain ⟨Dg, hDg⟩ := wc_hm_pull_data_exists (wcGeomFrobX K (wcPclYo K qb) hY) ℓ
  obtain ⟨DgF, hDgF⟩ := wc_hm_pull_data_exists (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ) ℓ
  obtain ⟨Da, hDa⟩ := wc_hm_pull_data_exists (wcPclAbar K qb a ha) ℓ
  obtain ⟨DF, hDF⟩ := wc_hm_pull_data_exists
    (wcIter (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ) e ≫ wcPclAbar K qb a ha) ℓ
  choose DI hDI using fun m : ℕ => wc_hm_pull_data_exists
    (wcIter (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ) m) ℓ
  have F2 : ∀ (m k : ℕ) (x : wcHM (wcXbar K (wcPclYo K qb)) ℓ k),
      wcHMPull (DI m) k x = (⇑(wcHMPull DgF k))^[m] x := by
    intro m
    induction m with
    | zero => intro k x; exact wc_hm_pull_id _ rfl (DI 0) (hDI 0) k x
    | succ m ih =>
      intro k x
      rw [wc_hm_pull_comp (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ)
        (wcIter (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ) m)
        (wcIter (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ) (m + 1)) rfl DgF hDgF (DI m) (hDI m)
        (DI (m + 1)) (hDI (m + 1)) k x, ih, Function.iterate_succ_apply]
  have hPF : ∀ (k : ℕ) (x : wcHM (wcXbar K (wcPclYo K qb)) ℓ k),
      wcHMPull DF k x = (⇑(wcHMPull Dg k))^[e] (wcHMPull Da k x) := by
    intro k x
    have hfun : (⇑(wcHMPull DgF k)) = ⇑(wcHMPull Dg k) :=
      funext (wc_baffling K (wcPclYo K qb) hY ℓ φ hφ Dg hDg DgF hDgF k)
    rw [wc_hm_pull_comp (wcPclAbar K qb a ha) (wcIter (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ) e)
      _ rfl Da hDa (DI e) (hDI e) DF hDF k x, F2, hfun]

  have H_mul : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ) (i j k : ℕ) (hk : i + j = k)
      (x : wcHM S ℓ i) (y : wcHM S ℓ j),
      wcHMPull D k (wcHMCup S ℓ i j k hk x y) =
        wcHMCup S' ℓ i j k hk (wcHMPull D i x) (wcHMPull D j y) := by
    intro S S' f D i j k hk x y
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y hk)).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero k)) (zero_add k) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero i)) (zero_add i)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero j)) (zero_add j)) hk
    rw [Abelian.Ext.mapExactFunctor_comp]
    generalize Abelian.Ext.mapExactFunctor D.Φ x = z
    generalize Abelian.Ext.mapExactFunctor D.Φ y = w
    have e1 : (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        (w.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero j)) (zero_add j)) (zero_add j) =
        w.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero j) := by
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add j) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv)
        (z.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero i)) _ (zero_add i) hk (by omega),
      Abelian.Ext.comp_assoc z (Abelian.Ext.mk₀ D.μ.hom) _ (add_zero i) (zero_add j) (by omega), e1,
      Abelian.Ext.comp_assoc z w (Abelian.Ext.mk₀ D.μ.hom) hk (add_zero j) (by omega)]
  have pullScalar : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ),
      wcHMPullCanonical D → ∀ (n : ℕ) (c : ℚ_[ℓ]) (x : wcHM S ℓ n),
      wcHMPull D n (wcHMScalar S ℓ n c x) = wcHMScalar S' ℓ n c (wcHMPull D n x) := by
    intro S S' f D hD n c x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    have e0 : wcHMScalar S ℓ n c x =
        wcHMCup S ℓ n 0 n (add_zero n) x (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) := rfl
    have e0' : wcHMScalar S' ℓ n c (wcHMPull D n x) =
        wcHMCup S' ℓ n 0 n (add_zero n) (wcHMPull D n x) (Abelian.Ext.mk₀ (wcHMConst S' ℓ c)) := rfl
    rw [e0, e0', H_mul]
    congr 1
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        (Abelian.Ext.mk₀ (wcHMConst S ℓ c))).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero 0))
        (zero_add 0) = Abelian.Ext.mk₀ (wcHMConst S' ℓ c)
    rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀,
      wc_hm_pull_const D hD c]

  have hcoord : ∀ i : ℕ, ∃ (r : ℕ)
      (ι : wcCohG K (wcP1Over K) hP (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) i →+
        (Fin r → ℚ_[ℓ]))
      (A : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      (i < 3 → wcRatCoord ℓ ι) ∧
      (i < 3 → ∀ x, ι ((⇑(wcCohGFrob K (wcP1Over K) hP
          (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) i))^[e]
          (wcCohGEnd K (wcP1Over K) hP (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) i
            (wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ a ha) x)) = A.mulVec (ι x)) ∧
      (i < 3 → ∃ T : wcHM (wcXbar K (wcPclYo K qb)) ℓ i ≃+ (Fin r → ℚ_[ℓ]),
        (∀ (c : ℚ_[ℓ]) (y : wcHM (wcXbar K (wcPclYo K qb)) ℓ i),
          T (wcHMScalar (wcXbar K (wcPclYo K qb)) ℓ i c y) = c • T y) ∧
        A = wcAddEquivMatrix T (wcHMPull DF i)) := by
    intro i
    by_cases hi : i < 3
    · obtain ⟨R, ι, T, hι, hT, hFr, hAc⟩ :=
        wc_pcl_cover_coh_hm_coords K hP ℓ hℓ qb hqb hYp hYs a ha hY i hi
      have hes : ∀ (c : ℚ_[ℓ]) (v : Fin R → ℚ_[ℓ]),
          T.symm (c • v) = wcHMScalar (wcXbar K (wcPclYo K qb)) ℓ i c (T.symm v) := fun c v =>
        T.injective (by rw [hT, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
      let LA : (Fin R → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin R → ℚ_[ℓ]) :=
        { toFun := fun v => T (wcHMPull DF i (T.symm v))
          map_add' := fun v w => by simp only [map_add]
          map_smul' := fun c v => by
            simp only [hes, pullScalar DF hDF, hT, RingHom.id_apply] }
      have hA : wcAddEquivMatrix T (wcHMPull DF i) = LinearMap.toMatrix' LA := by
        ext a' b'
        rw [LinearMap.toMatrix'_apply]
        rfl
      have hit : ∀ (n : ℕ) y, ι ((⇑(wcCohGFrob K (wcP1Over K) hP
          (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) i))^[n] y) =
          T ((⇑(wcHMPull Dg i))^[n] (T.symm (ι y))) := by
        intro n
        induction n with
        | zero => intro y; simp
        | succ n ih =>
          intro y
          rw [Function.iterate_succ_apply', hFr Dg hDg, ih, AddEquiv.symm_apply_apply,
            Function.iterate_succ_apply']
      refine ⟨R, ι, wcAddEquivMatrix T (wcHMPull DF i), fun _ => hι, fun _ x => ?_,
        fun _ => ⟨T, hT, rfl⟩⟩
      have hact : T.symm (ι (wcCohGEnd K (wcP1Over K) hP
          (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) i
          (wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ a ha) x)) =
          wcHMPull Da i (T.symm (ι x)) := by
        rw [hAc Da hDa, AddEquiv.symm_apply_apply]
      rw [hit, hact, ← hPF, hA]
      exact (LinearMap.toMatrix'_mulVec LA (ι x)).symm
    · exact ⟨0, 0, 0, fun h => absurd h hi, fun h => absurd h hi, fun h => absurd h hi⟩
  choose r ι A hι hA hT using hcoord

  have hT3 : ∀ i : Fin 3, ∃ T : wcHM (wcXbar K (wcPclYo K qb)) ℓ i ≃+ (Fin (r i) → ℚ_[ℓ]),
      (∀ (c : ℚ_[ℓ]) (y : wcHM (wcXbar K (wcPclYo K qb)) ℓ i),
        T (wcHMScalar (wcXbar K (wcPclYo K qb)) ℓ i c y) = c • T y) ∧
      A i = wcAddEquivMatrix T (wcHMPull DF i) := fun i => hT i i.isLt
  choose E hEc hEA using hT3
  obtain ⟨hfinZ, htrZ⟩ := wc_pcl_curve_endo_lefschetz K (wcPclYo K qb) ℓ hℓ
    (wcIter (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ) e ≫ wcPclAbar K qb a ha) hF' hEt DF hDF
    (fun i : Fin 3 => r i) E hEc

  have hnatK : ∀ {Y : Scheme.{u}} (φ' : Y ⟶ Y) (q : ℕ), wcIsAbsFrob φ' q →
      ∀ (K : Type u) [Field K] (τ : K →+* K), (∀ a : K, τ a = a ^ q) →
      ∀ y : Spec (CommRingCat.of K) ⟶ Y,
        y ≫ φ' = Spec.map (CommRingCat.ofHom τ) ≫ y := by
    intro Y φ' q hφ' K _ τ hτ y
    have hall : ∀ t t' : ↥(Spec (CommRingCat.of K)), t = t' := fun t t' => Subsingleton.elim t t'
    obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset
      (x := y (default : ↥(Spec (CommRingCat.of K)))) (U := ⊤) (by simp)
    have eW : W ≤ φ' ⁻¹ᵁ W := by
      intro x hx
      rw [Scheme.Hom.mem_preimage, hφ'.1]
      exact hx
    have e1 : (⊤ : (Spec (CommRingCat.of K)).Opens) ≤ y ⁻¹ᵁ W := by
      intro t _
      rw [Scheme.Hom.mem_preimage, hall t default]
      exact hxW
    have e2 : (⊤ : (Spec (CommRingCat.of K)).Opens) ≤ (y ≫ φ') ⁻¹ᵁ W := by
      intro t _
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply, hφ'.1, hall t default]
      exact hxW
    have e3 : (⊤ : (Spec (CommRingCat.of K)).Opens) ≤
        (Spec.map (CommRingCat.ofHom τ) ≫ y) ⁻¹ᵁ W := by
      intro t _
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply,
        hall (Spec.map (CommRingCat.ofHom τ) t) default]
      exact hxW
    have e4 : (⊤ : (Spec (CommRingCat.of K)).Opens) ≤
        (Spec.map (CommRingCat.ofHom τ)) ⁻¹ᵁ ⊤ := by
      intro t _
      rw [Scheme.Hom.mem_preimage]
      trivial
    have cancel : ∀ (f₁ f₂ : Spec (CommRingCat.of K) ⟶ Y)
        (a₁ : (⊤ : (Spec (CommRingCat.of K)).Opens) ≤ f₁ ⁻¹ᵁ W)
        (a₂ : (⊤ : (Spec (CommRingCat.of K)).Opens) ≤ f₂ ⁻¹ᵁ W),
        f₁.appLE W ⊤ a₁ = f₂.appLE W ⊤ a₂ → f₁ = f₂ := by
      intro f₁ f₂ a₁ a₂ hh
      have h1 := IsAffineOpen.SpecMap_appLE_fromSpec f₁ hW
        (isAffineOpen_top (Spec (CommRingCat.of K))) a₁
      have h2 := IsAffineOpen.SpecMap_appLE_fromSpec f₂ hW
        (isAffineOpen_top (Spec (CommRingCat.of K))) a₂
      rw [hh, h2, IsAffineOpen.fromSpec_top] at h1
      exact ((Iso.cancel_iso_inv_left _ _ _).mp h1).symm
    have hA : (Spec.map (CommRingCat.ofHom τ)).appLE ⊤ ⊤ e4 =
        (Spec.map (CommRingCat.ofHom τ)).appTop :=
      (Scheme.Hom.app_eq_appLE _).symm
    have hS : ∀ u, ((Spec.map (CommRingCat.ofHom τ)).appLE ⊤ ⊤ e4).hom u = u ^ q := by
      intro u
      rw [hA]
      obtain ⟨a, rfl⟩ : ∃ a, (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom a = u :=
        ⟨(Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom u, by simp⟩
      have hn := congrArg (fun f => f.hom a)
        (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom τ))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at hn
      rw [← hn, hτ, map_pow]
    apply cancel (y ≫ φ') (Spec.map (CommRingCat.ofHom τ) ≫ y) e2 e3
    rw [← Scheme.Hom.appLE_comp_appLE y φ' W W ⊤ eW e1,
      ← Scheme.Hom.appLE_comp_appLE (Spec.map (CommRingCat.ofHom τ)) y W ⊤ ⊤ e1 e4]
    ext s
    simp only [CommRingCat.hom_comp, RingHom.comp_apply]
    rw [hφ'.2 W eW s, map_pow, hS]
  obtain ⟨σ, hσ⟩ : ∃ σ : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K,
      σ = @FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
        (AlgebraicClosure K) _ _ _ := ⟨_, rfl⟩
  have hτ : ∀ x : AlgebraicClosure K,
      (σ : AlgebraicClosure K →+* AlgebraicClosure K) x = x ^ Nat.card K := by
    subst hσ
    intro x
    show (@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
        (AlgebraicClosure K) _ _ _) x = _
    rw [FiniteField.frobeniusAlgEquivOfAlgebraic_apply, Fintype.card_eq_nat_card]
  have hFrE : wcFrE K e = Spec.map (CommRingCat.ofHom ((σ ^ e : AlgebraicClosure K ≃ₐ[K]
      AlgebraicClosure K) : AlgebraicClosure K →+* AlgebraicClosure K)) := by
    subst hσ
    rfl
  have hg : wcGeomFrobX K (wcPclYo K qb) hY ≫ Limits.pullback.fst (wcPclYo K qb).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
      Limits.pullback.fst (wcPclYo K qb).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :=
    MorphismProperty.Over.w (wcGeomFrob K (wcPclYo K qb) hY)
  have hFr1 : ∀ y : Spec (.of (AlgebraicClosure K)) ⟶ wcXbar K (wcPclYo K qb),
      y ≫ (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ) ≫ Limits.pullback.fst (wcPclYo K qb).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
        Spec.map (CommRingCat.ofHom (σ : AlgebraicClosure K →+* AlgebraicClosure K)) ≫ y ≫
          Limits.pullback.fst (wcPclYo K qb).hom
            (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) := by
    intro y
    rw [← Category.assoc, ← Category.assoc,
      hnatK φ (Nat.card K) hφ (AlgebraicClosure K) _ hτ (y ≫ wcGeomFrobX K (wcPclYo K qb) hY),
      Category.assoc, Category.assoc, hg]
  have I2 : ∀ (m : ℕ) (y : Spec (.of (AlgebraicClosure K)) ⟶ wcXbar K (wcPclYo K qb)),
      y ≫ wcIter (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ) m ≫ Limits.pullback.fst (wcPclYo K qb).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
        Spec.map (CommRingCat.ofHom ((σ ^ m : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K) :
          AlgebraicClosure K →+* AlgebraicClosure K)) ≫ y ≫
          Limits.pullback.fst (wcPclYo K qb).hom
            (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) := by
    intro m
    induction m with
    | zero =>
      intro y
      have e0 : ((σ ^ 0 : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K) :
          AlgebraicClosure K →+* AlgebraicClosure K) = RingHom.id _ := by
        apply RingHom.ext
        intro a
        show (σ ^ 0) a = a
        rw [pow_zero]
        rfl
      rw [e0, CommRingCat.ofHom_id, Spec.map_id, Category.id_comp]
      show y ≫ 𝟙 _ ≫ _ = _
      rw [Category.id_comp]
    | succ m ih =>
      intro y
      have e' : ((σ ^ (m + 1) : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K) :
          AlgebraicClosure K →+* AlgebraicClosure K) =
          (σ : AlgebraicClosure K →+* AlgebraicClosure K).comp
            ((σ ^ m : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K) :
              AlgebraicClosure K →+* AlgebraicClosure K) := by
        apply RingHom.ext
        intro a
        show (σ ^ (m + 1)) a = σ ((σ ^ m) a)
        rw [pow_succ']
        rfl
      show y ≫ (wcIter (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ) m ≫
        (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ)) ≫ _ = _
      rw [Category.assoc, ← Category.assoc y, hFr1 (y ≫ wcIter _ m), Category.assoc, ih, e',
        CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]
  have hfix : ∀ z : Spec (.of (AlgebraicClosure K)) ⟶ wcXbar K (wcPclYo K qb),
      z ≫ (wcIter (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ) e ≫ wcPclAbar K qb a ha) ≫
        Limits.pullback.fst (wcPclYo K qb).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
        wcFrE K e ≫ (z ≫ Limits.pullback.fst (wcPclYo K qb).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) ≫ a := by
    intro z
    have h1 := I2 e z
    rw [hFrE]
    simp only [Category.assoc] at h1 ⊢
    rw [hab1, reassoc_of% h1]
  have hsnd1 : ∀ z : Spec (.of (AlgebraicClosure K)) ⟶ wcXbar K (wcPclYo K qb),
      (z ≫ (wcIter (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ) e ≫ wcPclAbar K qb a ha) = z ↔
        wcFrE K e ≫ (z ≫ Limits.pullback.fst (wcPclYo K qb).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) ≫ a =
          z ≫ Limits.pullback.fst (wcPclYo K qb).hom
            (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) := by
    intro z
    constructor
    · intro h
      rw [← hfix z, ← Category.assoc, h]
    · intro h
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hfix z, h]
      · rw [Category.assoc, hF']
  let eqv : {y : Spec (.of (AlgebraicClosure K)) ⟶ Y //
          y ≫ qb ≫ (wcP1Over K).hom = wcKbarPt K ∧ wcFrE K e ≫ y ≫ a = y} ≃
      {z : Spec (.of (AlgebraicClosure K)) ⟶ wcXbar K (wcPclYo K qb) //
          z ≫ wcPi2 K (wcPclYo K qb) = 𝟙 _ ∧
          z ≫ (wcIter (wcGeomFrobX K (wcPclYo K qb) hY ≫ φ) e ≫ wcPclAbar K qb a ha) = z} :=
    { toFun := fun y => ⟨Limits.pullback.lift y.1 (𝟙 _) (by rw [Category.id_comp]; exact y.2.1),
        Limits.pullback.lift_snd _ _ _, (hsnd1 _).mpr (by
          rw [Limits.pullback.lift_fst]; exact y.2.2)⟩
      invFun := fun z => ⟨z.1 ≫ Limits.pullback.fst (wcPclYo K qb).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))), by
          show (z.1 ≫ Limits.pullback.fst (wcPclYo K qb).hom
            (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) ≫
              (wcPclYo K qb).hom = Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
          rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, z.2.1, Category.id_comp],
          (hsnd1 z.1).mp z.2.2⟩
      left_inv := fun y => Subtype.ext (Limits.pullback.lift_fst _ _ _)
      right_inv := fun z => Subtype.ext (by
          apply Limits.pullback.hom_ext
          · exact Limits.pullback.lift_fst _ _ _
          · rw [Limits.pullback.lift_snd]; exact z.2.1.symm) }
  haveI := hfinZ
  have hcard := Nat.card_congr eqv
  refine ⟨r, ι, A, fun i hi => hι i hi, fun i hi => hA i hi, ?_, Finite.of_equiv _ eqv.symm⟩
  rw [hcard, ← htrZ, Finset.sum_range]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [hEA i]

theorem wc_cover_point_split (K : Type u) [Field K] [Finite K] (Uo : (wcP1Over K).left.Opens)
    {V Y : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (qb : Y ⟶ (wcP1Over K).left) (jV : V ⟶ Y)
    (hjV : IsOpenImmersion jV) (hjq : jV ≫ qb = q' ≫ Uo.ι) (b : V ⟶ V) (a : Y ⟶ Y)
    (hab : b ≫ jV = jV ≫ a) (e : ℕ)
    (hfin : Finite {y : Spec (.of (AlgebraicClosure K)) ⟶ Y //
          y ≫ qb ≫ (wcP1Over K).hom = wcKbarPt K ∧ wcFrE K e ≫ y ≫ a = y}) :
    Nat.card {y : Spec (.of (AlgebraicClosure K)) ⟶ Y //
          y ≫ qb ≫ (wcP1Over K).hom = wcKbarPt K ∧ wcFrE K e ≫ y ≫ a = y} =
      Nat.card {v : Spec (.of (AlgebraicClosure K)) ⟶ V //
          v ≫ q' ≫ Uo.ι ≫ (wcP1Over K).hom = wcKbarPt K ∧ wcFrE K e ≫ v ≫ b = v} +
      Nat.card {y : Spec (.of (AlgebraicClosure K)) ⟶ Y //
          y ≫ qb ≫ (wcP1Over K).hom = wcKbarPt K ∧ wcFrE K e ≫ y ≫ a = y ∧
          ¬ ∃ v : V, jV v = y (IsLocalRing.closedPoint (AlgebraicClosure K))} :=
by
  classical
  haveI : IsOpenImmersion jV := hjV
  haveI := hfin
  let inV : {y : Spec (.of (AlgebraicClosure K)) ⟶ Y //
      y ≫ qb ≫ (wcP1Over K).hom = wcKbarPt K ∧ wcFrE K e ≫ y ≫ a = y} → Prop :=
    fun s => ∃ v : V, jV v = s.1 (IsLocalRing.closedPoint (AlgebraicClosure K))
  have e1 : {v : Spec (.of (AlgebraicClosure K)) ⟶ V //
      v ≫ q' ≫ Uo.ι ≫ (wcP1Over K).hom = wcKbarPt K ∧ wcFrE K e ≫ v ≫ b = v} ≃
      {s // inV s} := by
    refine Equiv.ofBijective (fun v => ⟨⟨v.1 ≫ jV, ?_, ?_⟩, ?_⟩) ⟨?_, ?_⟩
    · rw [Category.assoc, reassoc_of% hjq]
      exact v.2.1
    · rw [Category.assoc, ← hab, reassoc_of% v.2.2]
    · exact ⟨v.1 (IsLocalRing.closedPoint (AlgebraicClosure K)),
        (Scheme.Hom.comp_apply v.1 jV _).symm⟩
    · intro v w h
      apply Subtype.ext
      have h' : v.1 ≫ jV = w.1 ≫ jV := congrArg (fun s => s.1.1) h
      exact (cancel_mono jV).mp h'
    · rintro ⟨⟨y, hy1, hy2⟩, ⟨v0, hv0⟩⟩
      have H : Set.range y ⊆ Set.range jV := by
        rintro _ ⟨w, rfl⟩
        exact ⟨v0, by rw [hv0, Subsingleton.elim w (IsLocalRing.closedPoint (AlgebraicClosure K))]⟩
      have hvf : IsOpenImmersion.lift jV y H ≫ jV = y := IsOpenImmersion.lift_fac _ _ _
      refine ⟨⟨IsOpenImmersion.lift jV y H, ?_, ?_⟩, ?_⟩
      · rw [← reassoc_of% hjq, ← Category.assoc, hvf]
        exact hy1
      · apply (cancel_mono jV).mp
        simp only [Category.assoc]
        rw [hab, ← Category.assoc (IsOpenImmersion.lift jV y H) jV a, hvf, hy2]
      · apply Subtype.ext
        apply Subtype.ext
        exact hvf
  let e2 : {s // ¬ inV s} ≃ {y : Spec (.of (AlgebraicClosure K)) ⟶ Y //
      y ≫ qb ≫ (wcP1Over K).hom = wcKbarPt K ∧ wcFrE K e ≫ y ≫ a = y ∧
      ¬ ∃ v : V, jV v = y (IsLocalRing.closedPoint (AlgebraicClosure K))} :=
    { toFun := fun s => ⟨s.1.1, s.1.2.1, s.1.2.2, s.2⟩
      invFun := fun t => ⟨⟨t.1, t.2.1, t.2.2.1⟩, t.2.2.2⟩
      left_inv := fun s => rfl
      right_inv := fun t => rfl }
  calc _ = Nat.card ({s // inV s} ⊕ {s // ¬ inV s}) :=
        (Nat.card_congr (Equiv.sumCompl inV)).symm
    _ = Nat.card {s // inV s} + Nat.card {s // ¬ inV s} := Nat.card_sum
    _ = _ := by
      congr 1
      · exact (Nat.card_congr e1).symm
      · exact Nat.card_congr e2

theorem wc_cover_coh_twisted_lefschetz (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ] [Fintype Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α) (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
    (e : ℕ) (he : 1 ≤ e) (γ : Γ) (r : ℕ → ℕ)
    (ι : ∀ i, (wcCx K hP (wcCoverSheaf (q' ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ)).homology i →+
          (Fin (r i) → ℚ_[ℓ]))
    (A : ∀ i, Matrix (Fin (r i)) (Fin (r i)) ℚ_[ℓ])
    (hι : ∀ i < 3, wcRatCoord ℓ (ι i))
    (hA : ∀ i < 3, ∀ x, ι i ((HomologicalComplex.homologyMap
        (wcCxMap K hP (wcCoverAct (q' ≫ Uo.ι)
            (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (α γ).hom (hα γ)) ≫
          wcCxIter (wcCxFrob K hP (wcCoverSheaf (q' ≫ Uo.ι)
            (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ)) e) i).hom x) =
        (A i).mulVec (ι i x)) :
    ∑ i ∈ Finset.range 3, (-1 : ℚ_[ℓ]) ^ i * (A i).trace =
      (Nat.card {v : Spec (.of (AlgebraicClosure K)) ⟶ V //
          v ≫ q' ≫ Uo.ι ≫ (wcP1Over K).hom = wcKbarPt K ∧
          wcFrE K e ≫ v ≫ (α γ).hom = v} : ℚ_[ℓ]) :=
by
  classical

  obtain ⟨Y, qb, jV, a, hqb, hYp, hYs, hjV, hpb, ha, hab⟩ :=
    wc_cover_compactify K m S hS Uo hUo q' Γ α hG hα γ

  obtain ⟨ιF, hmono, hequiv, hsupp⟩ :=
    wc_cover_excision_ses K ℓ m S Uo hUo q' qb jV hqb hjV hpb (α γ).hom (hα γ) a ha hab
  haveI := hmono
  have hw : ιF ≫ (wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ a ha ≫ Limits.cokernel.π ιF) = 0 := by
    rw [← Category.assoc, ← hequiv, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
  let σD : Limits.cokernel ιF ⟶ Limits.cokernel ιF :=
    Limits.cokernel.desc ιF (wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ a ha ≫
      Limits.cokernel.π ιF) hw
  have hσD : Limits.cokernel.π ιF ≫ σD =
      wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ a ha ≫ Limits.cokernel.π ιF :=
    Limits.cokernel.π_desc _ _ _
  have hSc : (ShortComplex.mk ιF (Limits.cokernel.π ιF) (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance

  obtain ⟨h1D, h2D, r₀, ι₀, A₀, hι₀, hA₀, htr₀⟩ :=
    wc_cover_boundary_coh K hP ℓ hℓ m S hS Uo hUo q' qb jV hqb hjV hpb a ha ιF hmono hsupp σD hσD
      e he

  obtain ⟨rG, ιG, AG, hιG, hAG, htrG, hfin⟩ :=
    wc_proper_cover_twisted_lefschetz K hP ℓ hℓ qb hqb hYp hYs a ha e he

  choose θ hθ using fun i => wc_cx_homology_cohG K hP
    (wcCoverSheaf (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ) i
  have transport : ∀ {M N : Type (u+1)} [AddCommGroup M] [AddCommGroup N] {k : ℕ}
      (ψ : M ≃+ N) (ι : M →+ (Fin k → ℚ_[ℓ])), wcRatCoord ℓ ι →
        wcRatCoord ℓ (ι.comp ψ.symm.toAddMonoidHom) := by
    intro M N _ _ k ψ ι hι
    obtain ⟨h1, h2, h3, h4⟩ := hι
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro y
      simp only [AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom]
      rw [h1]
      constructor
      · rintro ⟨j, hj⟩
        refine ⟨j, ?_⟩
        apply ψ.symm.injective
        rw [map_nsmul, hj, map_zero]
      · rintro ⟨j, hj⟩
        exact ⟨j, by rw [← map_nsmul, hj, map_zero]⟩
    · intro v
      obtain ⟨j, x, hx⟩ := h2 v
      refine ⟨j, ψ x, ?_⟩
      simpa only [AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom,
        AddEquiv.symm_apply_apply] using hx
    · intro y a
      obtain ⟨x', hx'⟩ := h3 (ψ.symm y) a
      refine ⟨ψ x', ?_⟩
      simpa only [AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom,
        AddEquiv.symm_apply_apply] using hx'
    · intro y hy
      simp only [AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom] at hy ⊢
      apply h4 (ψ.symm y)
      intro j
      obtain ⟨y', hy'⟩ := hy j
      exact ⟨ψ.symm y', hy'⟩
  let ιE : ∀ i, wcCohG K (wcP1Over K) hP
      (wcCoverSheaf (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ) i →+
        (Fin (r i) → ℚ_[ℓ]) := fun i => (ι i).comp (θ i).symm.toAddMonoidHom
  have hιE : ∀ i < 3, wcRatCoord ℓ (ιE i) := fun i hi => transport (θ i) (ι i) (hι i hi)
  have hAE : ∀ i < 3, ∀ y, ιE i ((⇑(wcCohGFrob K (wcP1Over K) hP
      (wcCoverSheaf (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ) i))^[e]
      (wcCohGEnd K (wcP1Over K) hP
        (wcCoverSheaf (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ) i
        (wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ
          (α γ).hom (hα γ)) y)) = (A i).mulVec (ιE i y) := by
    intro i hi y
    obtain ⟨x, rfl⟩ := (θ i).surjective y
    have h := hθ i (wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ
      (α γ).hom (hα γ)) e x
    show ι i ((θ i).symm _) = (A i).mulVec (ι i ((θ i).symm (θ i x)))
    rw [← h, AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply]
    exact hA i hi x

  have key := wc_ext_ses_ratcoord_trace ℓ
    (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
    (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP))
    (ShortComplex.mk ιF (Limits.cokernel.π ιF) (Limits.cokernel.condition _)) hSc
    (wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ
      (α γ).hom (hα γ))
    (wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ a ha) σD hequiv hσD.symm e h1D h2D
    r rG ιE ιG A AG r₀ ι₀ A₀ hιE hιG hι₀ hAE hAG hA₀

  have hsplit := wc_cover_point_split K Uo q' qb jV hjV hpb.w (α γ).hom a hab e hfin
  rw [key, htrG, htr₀, hsplit, Nat.cast_add]
  ring

theorem wc_cover_lefschetz (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ] [Fintype Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α) (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
    (P : wcGModel ℓ Γ)
    (hM : wcIsModel K hP (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (q' ≫ Uo.ι)
      Γ α hα P) :
    ∀ e : ℕ, 1 ≤ e → ∀ γ : Γ,
      ((wcGModelTr P e γ : ℤ_[ℓ]) : ℚ_[ℓ]) =
        (Nat.card {v : Spec (.of (AlgebraicClosure K)) ⟶ V //
          v ≫ q' ≫ Uo.ι ≫ (wcP1Over K).hom = wcKbarPt K ∧
          wcFrE K e ≫ v ≫ (α γ).hom = v} : ℚ_[ℓ]) :=
by
  intro e he γ
  classical
  obtain ⟨Ψ, hqi, ⟨hF⟩, hAct⟩ := hM

  have hIter : ∀ (n i : ℕ), HomologicalComplex.homologyMap Ψ i ≫
      HomologicalComplex.homologyMap (wcCxIter (wcCxFrob K hP (wcCoverSheaf (q' ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ)) n) i =
      HomologicalComplex.homologyMap (wcCxIter (wcGModelFrob P) n) i ≫
        HomologicalComplex.homologyMap Ψ i := by
    intro n i
    induction n with
    | zero =>
      simp only [wcCxIter, HomologicalComplex.homologyMap_id, Category.comp_id, Category.id_comp]
    | succ n ih =>
      simp only [wcCxIter, HomologicalComplex.homologyMap_comp]
      rw [← Category.assoc, ih, Category.assoc, ← HomologicalComplex.homologyMap_comp,
        hF.homologyMap_eq i, HomologicalComplex.homologyMap_comp, Category.assoc]
  have hInt : ∀ i : ℕ, HomologicalComplex.homologyMap Ψ i ≫
      HomologicalComplex.homologyMap
        (wcCxMap K hP (wcCoverAct (q' ≫ Uo.ι)
            (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (α γ).hom (hα γ)) ≫
          wcCxIter (wcCxFrob K hP (wcCoverSheaf (q' ≫ Uo.ι)
            (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ)) e) i =
      HomologicalComplex.homologyMap (wcGModelAct P γ ≫ wcCxIter (wcGModelFrob P) e) i ≫
        HomologicalComplex.homologyMap Ψ i := by
    intro i
    rw [HomologicalComplex.homologyMap_comp, HomologicalComplex.homologyMap_comp,
      ← Category.assoc, ← HomologicalComplex.homologyMap_comp, (hAct γ).some.homologyMap_eq i,
      HomologicalComplex.homologyMap_comp, Category.assoc, hIter e i, ← Category.assoc]
  have hpt : ∀ (i : ℕ) (x : (wcGModelAb P).homology i),
      (HomologicalComplex.homologyMap
        (wcCxMap K hP (wcCoverAct (q' ≫ Uo.ι)
            (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (α γ).hom (hα γ)) ≫
          wcCxIter (wcCxFrob K hP (wcCoverSheaf (q' ≫ Uo.ι)
            (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ)) e) i).hom
        ((HomologicalComplex.homologyMap Ψ i).hom x) =
      (HomologicalComplex.homologyMap Ψ i).hom
        ((HomologicalComplex.homologyMap (wcGModelAct P γ ≫ wcCxIter (wcGModelFrob P) e) i).hom
          x) := by
    intro i x
    have h := congrArg (fun f => f.hom x) (hInt i)
    simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] using h

  have hiso : ∀ i : ℕ, IsIso (HomologicalComplex.homologyMap Ψ i) := by
    intro i
    haveI := hqi
    exact (quasiIsoAt_iff_isIso_homologyMap Ψ i).mp (QuasiIso.quasiIsoAt i)
  let φ : ∀ i : ℕ, (wcGModelAb P).homology i ≃+ (wcCx K hP (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ)).homology i := fun i =>
    haveI := hiso i
    (asIso (HomologicalComplex.homologyMap Ψ i)).addCommGroupIsoToAddEquiv
  have hφ : ∀ (i : ℕ) (x : (wcGModelAb P).homology i),
      φ i x = (HomologicalComplex.homologyMap Ψ i).hom x := fun i x => rfl

  have transport : ∀ {M N : Type (u+1)} [AddCommGroup M] [AddCommGroup N] {k : ℕ}
      (ψ : M ≃+ N) (ι : M →+ (Fin k → ℚ_[ℓ])), wcRatCoord ℓ ι →
        wcRatCoord ℓ (ι.comp ψ.symm.toAddMonoidHom) := by
    intro M N _ _ k ψ ι hι
    obtain ⟨h1, h2, h3, h4⟩ := hι
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro y
      simp only [AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom]
      rw [h1]
      constructor
      · rintro ⟨j, hj⟩
        refine ⟨j, ?_⟩
        apply ψ.symm.injective
        rw [map_nsmul, hj, map_zero]
      · rintro ⟨j, hj⟩
        exact ⟨j, by rw [← map_nsmul, hj, map_zero]⟩
    · intro v
      obtain ⟨j, x, hx⟩ := h2 v
      refine ⟨j, ψ x, ?_⟩
      simpa only [AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom,
        AddEquiv.symm_apply_apply] using hx
    · intro y a
      obtain ⟨x', hx'⟩ := h3 (ψ.symm y) a
      refine ⟨ψ x', ?_⟩
      simpa only [AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom,
        AddEquiv.symm_apply_apply] using hx'
    · intro y hy
      simp only [AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom] at hy ⊢
      apply h4 (ψ.symm y)
      intro j
      obtain ⟨y', hy'⟩ := hy j
      exact ⟨ψ.symm y', hy'⟩

  obtain ⟨r, ιm, A, hιm, hAm, htr⟩ := wc_gmodel_hopf_coords ℓ Γ P e he γ
  let ιc : ∀ i : ℕ, (wcCx K hP (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ)).homology i →+
        (Fin (r i) → ℚ_[ℓ]) := fun i => (ιm i).comp (φ i).symm.toAddMonoidHom
  have hιc : ∀ i < 3, wcRatCoord ℓ (ιc i) := fun i hi => transport (φ i) (ιm i) (hιm i hi)
  have hAc : ∀ i < 3, ∀ y, ιc i ((HomologicalComplex.homologyMap
      (wcCxMap K hP (wcCoverAct (q' ≫ Uo.ι)
          (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (α γ).hom (hα γ)) ≫
        wcCxIter (wcCxFrob K hP (wcCoverSheaf (q' ≫ Uo.ι)
          (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ)) e) i).hom y) =
      (A i).mulVec (ιc i y) := by
    intro i hi y
    obtain ⟨x, rfl⟩ := (φ i).surjective y
    have h1 : (φ i).symm ((HomologicalComplex.homologyMap
        (wcCxMap K hP (wcCoverAct (q' ≫ Uo.ι)
            (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (α γ).hom (hα γ)) ≫
          wcCxIter (wcCxFrob K hP (wcCoverSheaf (q' ≫ Uo.ι)
            (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ)) e) i).hom (φ i x)) =
        (HomologicalComplex.homologyMap (wcGModelAct P γ ≫ wcCxIter (wcGModelFrob P) e) i).hom
          x := by
      rw [AddEquiv.symm_apply_eq, hφ, hφ]
      exact hpt i x
    show ιm i ((φ i).symm _) = (A i).mulVec (ιm i ((φ i).symm (φ i x)))
    rw [h1, AddEquiv.symm_apply_apply]
    exact hAm i hi x

  have hcount := wc_cover_coh_twisted_lefschetz K hP ℓ hℓ m S hS Uo hUo q' Γ α hG hα e he γ r
    ιc A hιc hAc
  rw [htr, hcount]

theorem wc_strict_injective_resolution {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] [EnoughInjectives 𝒜]
    {Γ : Type*} [Group Γ] [Finite Γ] (A : 𝒜) (ρA : Γ → (A ⟶ A)) (h1 : ρA 1 = 𝟙 A)
    (hmul : ∀ a b, ρA (a * b) = ρA b ≫ ρA a) :
    ∃ (J : InjectiveResolution A) (ρJ : Γ → (J.cocomplex ⟶ J.cocomplex)),
      wcStrictResSpec ρA J ρJ :=
by

  have coind : ∀ (F : SingleObj Γ ⥤ 𝒜), ∃ (C : SingleObj Γ ⥤ 𝒜) (ι : F ⟶ C),
      Mono ι ∧ Injective C ∧ Injective (C.obj (SingleObj.star Γ)) := by
    intro F
    let I₀ : 𝒜 := Injective.under (F.obj (SingleObj.star Γ))
    let P : 𝒜 := Limits.piObj (fun _ : Γ => I₀)
    let ρC : Γ → (P ⟶ P) := fun a =>
      Limits.Pi.lift (fun s => Limits.Pi.π (fun _ : Γ => I₀) (s * a))
    have hρC : ∀ a s, ρC a ≫ Limits.Pi.π (fun _ : Γ => I₀) s =
        Limits.Pi.π (fun _ : Γ => I₀) (s * a) := fun a s => Limits.Pi.lift_comp_π _ _
    let ρh : Γ →* End P :=
      { toFun := ρC
        map_one' := by
          show ρC 1 = 𝟙 P
          apply Limits.Pi.hom_ext
          intro s
          rw [hρC, mul_one, Category.id_comp]
        map_mul' := by
          intro a b
          show ρC (a * b) = ρC b ≫ ρC a
          apply Limits.Pi.hom_ext
          intro s
          rw [Category.assoc, hρC, hρC, hρC, mul_assoc] }
    let C : SingleObj Γ ⥤ 𝒜 := SingleObj.functor ρh
    let π' : Γ → (C.obj (SingleObj.star Γ) ⟶ I₀) := fun s => Limits.Pi.π (fun _ : Γ => I₀) s
    have hCπ : ∀ (a s : Γ), C.map (SingleObj.toEnd Γ a) ≫ π' s = π' (s * a) := hρC
    have hext : ∀ {Z : 𝒜} (u v : Z ⟶ C.obj (SingleObj.star Γ)),
        (∀ s, u ≫ π' s = v ≫ π' s) → u = v := fun u v h => Limits.Pi.hom_ext _ _ h
    have liftNat : ∀ (G : SingleObj Γ ⥤ 𝒜) (k : G.obj (SingleObj.star Γ) ⟶ I₀),
        ∃ η : G ⟶ C, ∀ s, η.app (SingleObj.star Γ) ≫ π' s =
          G.map (SingleObj.toEnd Γ s) ≫ k := by
      intro G k
      let L : G.obj (SingleObj.star Γ) ⟶ C.obj (SingleObj.star Γ) :=
        Limits.Pi.lift (fun s => G.map (SingleObj.toEnd Γ s) ≫ k)
      have hL : ∀ s, L ≫ π' s = G.map (SingleObj.toEnd Γ s) ≫ k :=
        fun s => Limits.Pi.lift_comp_π _ _
      refine ⟨{ app := fun _ => L, naturality := ?_ }, hL⟩
      intro X Y f
      show G.map f ≫ L = L ≫ C.map f
      apply hext
      intro s
      have e : G.map f ≫ G.map (SingleObj.toEnd Γ s) = G.map (SingleObj.toEnd Γ (s * f)) :=
        (G.map_comp _ _).symm
      have e2 : C.map f ≫ π' s = π' (s * f) := hCπ f s
      rw [Category.assoc, hL, ← Category.assoc, e, Category.assoc, e2, hL]
    obtain ⟨ι, hι⟩ := liftNat F (Injective.ι (F.obj (SingleObj.star Γ)))
    refine ⟨C, ι, ?_, ?_, ?_⟩
    · rw [NatTrans.mono_iff_mono_app]
      intro x
      have h := hι 1
      rw [show SingleObj.toEnd Γ 1 = 𝟙 (SingleObj.star Γ) from rfl, F.map_id,
        Category.id_comp] at h
      haveI := Injective.ι_mono (F.obj (SingleObj.star Γ))
      exact mono_of_mono_fac h
    · constructor
      intro X Y g f hf
      have hf' : Mono (f.app (SingleObj.star Γ)) := (NatTrans.mono_iff_mono_app f).mp hf _
      obtain ⟨k', hk'⟩ := Injective.factors
        (g.app (SingleObj.star Γ) ≫ π' 1) (f.app (SingleObj.star Γ))
      obtain ⟨h, hh⟩ := liftNat Y k'
      refine ⟨h, ?_⟩
      refine NatTrans.ext (funext fun x => ?_)
      show f.app (SingleObj.star Γ) ≫ h.app (SingleObj.star Γ) = g.app (SingleObj.star Γ)
      apply hext
      intro s
      calc (f.app (SingleObj.star Γ) ≫ h.app (SingleObj.star Γ)) ≫ π' s
          = f.app (SingleObj.star Γ) ≫ Y.map (SingleObj.toEnd Γ s) ≫ k' := by
            rw [Category.assoc, hh]
        _ = X.map (SingleObj.toEnd Γ s) ≫ f.app (SingleObj.star Γ) ≫ k' := by
            rw [← Category.assoc, ← NatTrans.naturality, Category.assoc]
        _ = X.map (SingleObj.toEnd Γ s) ≫ g.app (SingleObj.star Γ) ≫ π' 1 := by rw [hk']
        _ = g.app (SingleObj.star Γ) ≫ C.map (SingleObj.toEnd Γ s) ≫ π' 1 := by
            rw [← Category.assoc, NatTrans.naturality, Category.assoc]
        _ = g.app (SingleObj.star Γ) ≫ π' s := by rw [hCπ, one_mul]
    · show Injective P
      infer_instance

  haveI hEI : EnoughInjectives (SingleObj Γ ⥤ 𝒜) := ⟨fun F => by
    obtain ⟨C, ι, hι, hC, _⟩ := coind F
    exact ⟨{ J := C, injective := hC, f := ι, mono := hι }⟩⟩
  let ρh : Γ →* End A := { toFun := ρA, map_one' := h1, map_mul' := fun a b => hmul a b }
  let Â : SingleObj Γ ⥤ 𝒜 := SingleObj.functor ρh
  let Ĵ : InjectiveResolution Â := InjectiveResolution.of Â
  have hinj : ∀ n, Injective ((Ĵ.cocomplex.X n).obj (SingleObj.star Γ)) := by
    intro n
    obtain ⟨C, ι, hι, _, hCs⟩ := coind (Ĵ.cocomplex.X n)
    haveI := Ĵ.injective n
    have hr : ι ≫ Injective.factorThru (𝟙 _) ι = 𝟙 _ := Injective.comp_factorThru _ _
    have hr' : ι.app (SingleObj.star Γ) ≫ (Injective.factorThru (𝟙 _) ι).app (SingleObj.star Γ)
        = 𝟙 _ := by
      rw [← NatTrans.comp_app, hr, NatTrans.id_app]
    exact (Retract.mk _ _ hr').injective

  let ev : (SingleObj Γ ⥤ 𝒜) ⥤ 𝒜 := (evaluation (SingleObj Γ) 𝒜).obj (SingleObj.star Γ)
  let M := ev.mapHomologicalComplex (ComplexShape.up ℕ)
  let K : CochainComplex 𝒜 ℕ := M.obj Ĵ.cocomplex
  let eS := HomologicalComplex.singleMapHomologicalComplex ev (ComplexShape.up ℕ) 0
  haveI := Ĵ.quasiIso
  haveI hq2 : QuasiIso (M.map Ĵ.ι) :=
    HomologicalComplex.quasiIso_map_of_preservesHomology _ _
  haveI hq1 : QuasiIso (eS.app Â).inv := quasiIso_of_isIso _
  have hq : QuasiIso ((eS.app Â).inv ≫ M.map Ĵ.ι) := quasiIso_comp _ _
  let J : InjectiveResolution A :=
    { cocomplex := K, injective := hinj, ι := (eS.app Â).inv ≫ M.map Ĵ.ι, quasiIso := hq }
  let ρJ : Γ → (J.cocomplex ⟶ J.cocomplex) := fun a =>
    { f := fun n => (Ĵ.cocomplex.X n).map (SingleObj.toEnd Γ a)
      comm' := fun i j _ => (Ĵ.cocomplex.d i j).naturality (SingleObj.toEnd Γ a) }
  have e1 : J.ι.f 0 = (Ĵ.ι.f 0).app (SingleObj.star Γ) := by
    have e0 : J.ι.f 0 = ((eS.app Â).inv ≫ M.map Ĵ.ι).f 0 := rfl
    rw [e0, HomologicalComplex.comp_f, Iso.app_inv,
      HomologicalComplex.singleMapHomologicalComplex_inv_app_self,
      Functor.mapHomologicalComplex_map_f]
    first
      | (show 𝟙 _ ≫ 𝟙 _ ≫ ev.map (Ĵ.ι.f 0) = _
         rw [Category.id_comp, Category.id_comp]
         rfl)
      | (simp [HomologicalComplex.singleObjXIsoOfEq, eqToHom_map]; rfl)
      | (simp [HomologicalComplex.singleObjXIsoOfEq, eqToHom_map])
  refine ⟨J, ρJ, ?_, ?_, ?_, ?_⟩
  · ext n
    exact (Ĵ.cocomplex.X n).map_id _
  · intro a b
    ext n
    exact (Ĵ.cocomplex.X n).map_comp (SingleObj.toEnd Γ b) (SingleObj.toEnd Γ a)
  · intro a
    rw [e1]
    exact ((Ĵ.ι.f 0).naturality (SingleObj.toEnd Γ a)).symm
  · intro n Y W i hi ρY ρW hYm hWm hY1 hW1 hiY g hg
    let ρYh : Γ →* End Y := { toFun := ρY, map_one' := hY1, map_mul' := hYm }
    let ρWh : Γ →* End W := { toFun := ρW, map_one' := hW1, map_mul' := hWm }
    let Ŷ : SingleObj Γ ⥤ 𝒜 := SingleObj.functor ρYh
    let Ŵ : SingleObj Γ ⥤ 𝒜 := SingleObj.functor ρWh
    let î : Ŷ ⟶ Ŵ := { app := fun _ => i, naturality := fun _ _ φ => hiY φ }
    let ĝ : Ŷ ⟶ Ĵ.cocomplex.X n := { app := fun _ => g, naturality := fun _ _ φ => hg φ }
    haveI : Mono î := by
      rw [NatTrans.mono_iff_mono_app]
      intro _
      exact hi
    haveI := Ĵ.injective n
    obtain ⟨ĥ, hĥ⟩ := Injective.factors ĝ î
    exact ⟨ĥ.app (SingleObj.star Γ), congrArg (fun t => t.app (SingleObj.star Γ)) hĥ,
      fun a => ĥ.naturality (SingleObj.toEnd Γ a)⟩

theorem wc_cover_sheaf_ring_action {X V : Scheme.{u}} (q : V ⟶ X) (Z : Set X) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (Γ : Type u) [Group Γ] (α : Γ →* Aut V)
    (hα : ∀ γ, (α γ).hom ≫ q = q) :
    ∃ lamF : MonoidAlgebra ℤ_[ℓ] Γ → (wcCoverSheaf q Z ℓ ⟶ wcCoverSheaf q Z ℓ),
      wcRingAct lamF ∧
      (∀ (g : Γ) (a : ℤ_[ℓ]), lamF (MonoidAlgebra.single g a) =
        wcCoverScal q Z ℓ a ≫ wcCoverAct q Z ℓ (α g⁻¹).hom (hα g⁻¹)) ∧
      ∀ g : Γ, lamF (MonoidAlgebra.single g 1) = wcCoverAct q Z ℓ (α g⁻¹).hom (hα g⁻¹) :=
by
  classical

  have hs1 : wcCoverScal q Z ℓ 1 = 𝟙 _ := by
    unfold wcCoverScal
    refine (congrArg (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map ?_).trans
      ((presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map_id _)
    ext T x
    apply Subtype.ext
    first
      | (apply ULift.ext; apply ContinuousMap.ext; intro t; exact one_mul _)
      | (apply ULift.ext; apply ContinuousMap.ext; intro t; exact one_smul _ _)
      | (apply ULift.ext; exact one_smul _ _)
  have hsadd : ∀ a b : ℤ_[ℓ],
      wcCoverScal q Z ℓ (a + b) = wcCoverScal q Z ℓ a + wcCoverScal q Z ℓ b := by
    intro a b
    unfold wcCoverScal
    refine (congrArg (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map ?_).trans
      ((presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map_add)
    ext T x
    apply Subtype.ext
    first
      | (apply ULift.ext; apply ContinuousMap.ext; intro t; exact add_mul a b _)
      | (apply ULift.ext; apply ContinuousMap.ext; intro t; exact add_smul a b _)
      | (apply ULift.ext; exact add_smul a b _)
  have hsmul : ∀ a b : ℤ_[ℓ],
      wcCoverScal q Z ℓ (a * b) = wcCoverScal q Z ℓ a ≫ wcCoverScal q Z ℓ b := by
    intro a b
    have key : ∀ u : ℤ_[ℓ], a * b * u = b * (a * u) := fun u => by ring
    unfold wcCoverScal
    refine (congrArg (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map ?_).trans
      ((presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map_comp _ _)
    ext T x
    apply Subtype.ext
    first
      | (apply ULift.ext; apply ContinuousMap.ext; intro t; exact key _)
      | (apply ULift.ext; apply ContinuousMap.ext; intro t
         exact (smul_smul b a _).symm.trans (by rw [mul_comm]))

  have hca : ∀ (a : ℤ_[ℓ]) (x : V ⟶ V) (hx : x ≫ q = q),
      wcCoverScal q Z ℓ a ≫ wcCoverAct q Z ℓ x hx =
        wcCoverAct q Z ℓ x hx ≫ wcCoverScal q Z ℓ a := by
    intro a x hx
    unfold wcCoverScal wcCoverAct
    refine ((presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
      ((congrArg (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map ?_).trans
        ((presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map_comp _ _))
    ext T y
    apply Subtype.ext
    first
      | rfl
      | (apply ULift.ext; apply ContinuousMap.ext; intro t; rfl)

  have hcongr : ∀ (a a' : V ⟶ V) (_ : a = a') (ha : a ≫ q = q) (ha' : a' ≫ q = q),
      wcCoverAct q Z ℓ a ha = wcCoverAct q Z ℓ a' ha' := by
    rintro a _ rfl _ _
    rfl
  have hact_id : ∀ (h : 𝟙 V ≫ q = q), wcCoverAct q Z ℓ (𝟙 V) h = 𝟙 _ := by
    intro h
    have hpb : wcPbAct q (𝟙 V) h = 𝟙 _ := by
      apply NatTrans.ext
      funext T
      simp only [wcPbAct, NatTrans.id_app]
      first
        | exact Limits.pullback.map_id
        | (apply Limits.pullback.hom_ext <;> simp [Limits.pullback.map] <;>
            exact (Category.id_comp _).symm)
    unfold wcCoverAct
    refine (congrArg (presheafToSheaf (Scheme.ProEt.topology X)
      AddCommGrpCat.{u+1}).map ?_).trans
      ((presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map_id _)
    rw [hpb]
    ext T x
    apply Subtype.ext
    rfl
  have hact_comp : ∀ (a b : V ⟶ V) (ha : a ≫ q = q) (hb : b ≫ q = q) (hab : (a ≫ b) ≫ q = q),
      wcCoverAct q Z ℓ (a ≫ b) hab = wcCoverAct q Z ℓ b hb ≫ wcCoverAct q Z ℓ a ha := by
    intro a b ha hb hab
    have hpb : wcPbAct q (a ≫ b) hab = wcPbAct q a ha ≫ wcPbAct q b hb := by
      apply NatTrans.ext
      funext T
      simp only [wcPbAct, NatTrans.comp_app]
      first
        | (refine Eq.trans ?_ (Limits.pullback.map_comp _ _ _ _ _ _ _ _ _ _).symm
           congr 1 <;> simp)
        | (rw [Limits.pullback.map_comp]; congr 1 <;> simp)
        | (apply Limits.pullback.hom_ext
           · rw [Category.assoc]
             erw [Limits.pullback.lift_fst, Limits.pullback.lift_fst, Limits.pullback.lift_fst]
           · rw [Category.assoc]
             erw [Limits.pullback.lift_snd, Limits.pullback.lift_snd]
             rw [← Category.assoc]
             erw [Limits.pullback.lift_snd]
             rw [Category.assoc])
    unfold wcCoverAct
    refine (congrArg (presheafToSheaf (Scheme.ProEt.topology X)
      AddCommGrpCat.{u+1}).map ?_).trans
      ((presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map_comp
        _ _)
    rw [hpb]
    ext T x
    apply Subtype.ext
    rfl
  have hρ1 : wcCoverAct q Z ℓ (α 1⁻¹).hom (hα 1⁻¹) = 𝟙 _ := by
    have h1 : (α 1⁻¹).hom = 𝟙 V := by
      rw [inv_one, map_one]
      rfl
    exact (hcongr _ _ h1 (hα 1⁻¹) (by rw [Category.id_comp])).trans (hact_id _)
  have hρmul : ∀ a b : Γ, wcCoverAct q Z ℓ (α (a * b)⁻¹).hom (hα (a * b)⁻¹) =
      wcCoverAct q Z ℓ (α b⁻¹).hom (hα b⁻¹) ≫ wcCoverAct q Z ℓ (α a⁻¹).hom (hα a⁻¹) := by
    intro a b
    have h1 : (α (a * b)⁻¹).hom = (α a⁻¹).hom ≫ (α b⁻¹).hom := by
      rw [mul_inv_rev, map_mul, Aut.Aut_mul_def]
      rfl
    exact (hcongr _ _ h1 (hα (a * b)⁻¹) (by rw [Category.assoc, hα b⁻¹, hα a⁻¹])).trans
      (hact_comp _ _ (hα a⁻¹) (hα b⁻¹) _)

  let fM : ℤ_[ℓ] →* End (wcCoverSheaf q Z ℓ) :=
    { toFun := fun a => wcCoverScal q Z ℓ a
      map_one' := hs1
      map_mul' := fun a b =>
        (congrArg (wcCoverScal q Z ℓ) (mul_comm a b)).trans (hsmul b a) }
  let fS : ℤ_[ℓ] →+* End (wcCoverSheaf q Z ℓ) := RingHom.mk' fM (fun a b => hsadd a b)
  let gM : Γ →* End (wcCoverSheaf q Z ℓ) :=
    { toFun := fun γ => wcCoverAct q Z ℓ (α γ⁻¹).hom (hα γ⁻¹)
      map_one' := hρ1
      map_mul' := fun a b => hρmul a b }
  have hcomm : ∀ (x : ℤ_[ℓ]) (y : Γ), Commute (fS x) (gM y) := fun x y =>
    (hca x (α y⁻¹).hom (hα y⁻¹)).symm
  let Φ := MonoidAlgebra.liftNCRingHom fS gM hcomm
  have hsing : ∀ (g : Γ) (a : ℤ_[ℓ]),
      (Φ (MonoidAlgebra.single g a) : wcCoverSheaf q Z ℓ ⟶ wcCoverSheaf q Z ℓ) =
        wcCoverScal q Z ℓ a ≫ wcCoverAct q Z ℓ (α g⁻¹).hom (hα g⁻¹) := fun g a =>
    (MonoidAlgebra.liftNCRingHom_single fS gM hcomm g a).trans (hca a _ _).symm
  refine ⟨fun r => (Φ r : wcCoverSheaf q Z ℓ ⟶ wcCoverSheaf q Z ℓ), ⟨?_, ?_, ?_⟩, hsing, ?_⟩
  · exact map_one Φ
  · intro a b
    exact map_add Φ a b
  · intro a b
    exact map_mul Φ a b
  · intro g
    refine (hsing g 1).trans ?_
    rw [hs1, Category.id_comp]

theorem wc_ring_injective_resolution (S : Scheme.{u}) (R : Type u) [Ring R]
    (hR : ∀ (n : ℕ) (r : R), 0 < n → (n : R) * r = 0 → r = 0)
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (lamG : R → (G ⟶ G))
    (hG : wcRingAct lamG) :
    ∃ (I : InjectiveResolution G) (lamI : R → (I.cocomplex ⟶ I.cocomplex)),
      wcRingResSpec lamG I lamI :=
by
  classical

  have hfree : ∀ {X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (j : X ⟶ Y) [Mono j],
      ∃ (TX TY : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
        (lamX : R → (TX ⟶ TX)) (lamY : R → (TY ⟶ TY)) (ηX : X ⟶ TX) (ηY : Y ⟶ TY)
        (Tj : TX ⟶ TY),
        wcRingAct lamX ∧ wcRingAct lamY ∧ Mono Tj ∧ (∀ r, lamX r ≫ Tj = Tj ≫ lamY r) ∧
        ηX ≫ Tj = j ≫ ηY ∧
        ∀ (C : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (lamC : R → (C ⟶ C)),
          wcRingAct lamC → ∀ f : X ⟶ C,
            ∃ fh : TX ⟶ C, ηX ≫ fh = f ∧ ∀ r, lamX r ≫ fh = fh ≫ lamC r := by
    intro X Y j hj
    have keyext : ∀ {A B : AddCommGrpCat.{u+1}} (f g : (wcRirTens R).obj A ⟶ B),
        (∀ (r : R) (a : A), f.hom (r ⊗ₜ[ℤ] a) = g.hom (r ⊗ₜ[ℤ] a)) → f = g := by
      intro A B f g h
      apply AddCommGrpCat.hom_ext
      have : f.hom.toIntLinearMap = g.hom.toIntLinearMap := TensorProduct.ext' h
      ext x
      exact LinearMap.congr_fun this x
    haveI : Module.IsTorsionFree ℤ R := by
      rw [Module.isTorsionFree_iff_smul_eq_zero]
      intro n r h
      rw [zsmul_eq_mul] at h
      rcases Int.eq_nat_or_neg n with ⟨k, rfl | rfl⟩
      · rcases Nat.eq_zero_or_pos k with hk | hk
        · left; simp [hk]
        · right; exact hR k r hk (by simpa using h)
      · rcases Nat.eq_zero_or_pos k with hk | hk
        · left; simp [hk]
        · right
          apply hR k r hk
          push_cast at h
          rw [neg_mul, neg_eq_zero] at h
          exact h
    haveI : Module.Flat ℤ R := inferInstance
    let F := presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}
    let lpre : ∀ (Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}), R →
        (Z.obj ⋙ wcRirTens R ⟶ Z.obj ⋙ wcRirTens R) :=
      fun Z a => Functor.whiskerLeft Z.obj (wcRirTensAct R a)
    have hlam : ∀ (Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
        wcRingAct (fun a => F.map (lpre Z a)) := by
      intro Z
      have h1 : lpre Z 1 = 𝟙 _ := by
        apply NatTrans.ext; funext U; apply keyext; intro r a
        show (1 * r) ⊗ₜ[ℤ] a = r ⊗ₜ[ℤ] a
        rw [one_mul]
      have hadd : ∀ a b : R, lpre Z (a + b) = lpre Z a + lpre Z b := by
        intro a b
        apply NatTrans.ext; funext U; apply keyext; intro r c
        show ((a + b) * r) ⊗ₜ[ℤ] c = (a * r) ⊗ₜ[ℤ] c + (b * r) ⊗ₜ[ℤ] c
        rw [add_mul, TensorProduct.add_tmul]
      have hmul : ∀ a b : R, lpre Z (a * b) = lpre Z b ≫ lpre Z a := by
        intro a b
        apply NatTrans.ext; funext U; apply keyext; intro r c
        show ((a * b) * r) ⊗ₜ[ℤ] c = (a * (b * r)) ⊗ₜ[ℤ] c
        rw [mul_assoc]
      refine ⟨?_, ?_, ?_⟩
      · show F.map (lpre Z 1) = 𝟙 _
        rw [h1, F.map_id]
      · intro a b
        show F.map (lpre Z (a + b)) = F.map (lpre Z a) + F.map (lpre Z b)
        rw [hadd, F.map_add]
      · intro a b
        show F.map (lpre Z (a * b)) = F.map (lpre Z b) ≫ F.map (lpre Z a)
        rw [hmul, F.map_comp]
    let ηpre : ∀ (Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
        Z.obj ⟶ Z.obj ⋙ wcRirTens R := fun Z =>
      { app := fun U => (wcRirTensUnit R).app (Z.obj.obj U)
        naturality := fun U V g => (wcRirTensUnit R).naturality (Z.obj.map g) }
    let Pj : X.obj ⋙ wcRirTens R ⟶ Y.obj ⋙ wcRirTens R :=
      Functor.whiskerRight j.hom (wcRirTens R)
    have hjU : ∀ U, Function.Injective (j.hom.app U).hom := by
      intro U
      haveI : Mono j.hom :=
        (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_mono j
      haveI : Mono (j.hom.app U) := (NatTrans.mono_iff_mono_app _).1 inferInstance U
      exact (AddCommGrpCat.mono_iff_injective _).1 inferInstance
    have hPjU : ∀ U, Mono (Pj.app U) := by
      intro U
      rw [AddCommGrpCat.mono_iff_injective]
      intro a b hab
      exact Module.Flat.lTensor_preserves_injective_linearMap (M := R)
        (j.hom.app U).hom.toIntLinearMap (hjU U) hab
    haveI : Mono Pj := NatTrans.mono_of_mono_app _
    have hPjeq : ∀ r, lpre X r ≫ Pj = Pj ≫ lpre Y r := fun r =>
      NatTrans.ext (funext fun U => ((wcRirTensAct R r).naturality (j.hom.app U)).symm)
    have hηeq : ηpre X ≫ Pj = j.hom ≫ ηpre Y :=
      NatTrans.ext (funext fun U => ((wcRirTensUnit R).naturality (j.hom.app U)).symm)
    refine ⟨F.obj (X.obj ⋙ wcRirTens R), F.obj (Y.obj ⋙ wcRirTens R),
      fun a => F.map (lpre X a), fun a => F.map (lpre Y a),
      ObjectProperty.homMk (ηpre X ≫ toSheafify _ _),
      ObjectProperty.homMk (ηpre Y ≫ toSheafify _ _), F.map Pj,
      hlam X, hlam Y, F.map_mono Pj, ?_, ?_, ?_⟩
    · intro r
      show F.map (lpre X r) ≫ F.map Pj = F.map Pj ≫ F.map (lpre Y r)
      rw [← F.map_comp, ← F.map_comp, hPjeq]
    · apply Sheaf.hom_ext
      show (ηpre X ≫ toSheafify _ _) ≫ sheafifyMap _ Pj = j.hom ≫ ηpre Y ≫ toSheafify _ _
      rw [Category.assoc, ← toSheafify_naturality, ← Category.assoc, hηeq, Category.assoc]
    · intro C lamC hC f
      obtain ⟨hC1, hCadd, hCmul⟩ := hC
      let B : ∀ U, R →+ (X.obj.obj U →+ C.obj.obj U) := fun U =>
        AddMonoidHom.mk' (fun r => ((lamC r).hom.app U).hom.comp (f.hom.app U).hom) (by
          intro a b
          ext x
          simp [hCadd, Sheaf.Hom.add_app])
      let Fpre : X.obj ⋙ wcRirTens R ⟶ C.obj :=
        { app := fun U => AddCommGrpCat.ofHom (TensorProduct.liftAddHom (B U) (by
              intro n r x
              rw [map_zsmul, map_zsmul]
              rfl))
          naturality := by
            intro U V g
            apply keyext
            intro r x
            have e1 := congrArg (fun φ => φ.hom x) (f.hom.naturality g)
            have e2 := congrArg (fun φ => φ.hom ((f.hom.app U).hom x))
              ((lamC r).hom.naturality g)
            change ((lamC r).hom.app V).hom ((f.hom.app V).hom ((X.obj.map g).hom x)) =
              (C.obj.map g).hom (((lamC r).hom.app U).hom ((f.hom.app U).hom x))
            have e1' : (f.hom.app V).hom ((X.obj.map g).hom x) =
                (C.obj.map g).hom ((f.hom.app U).hom x) := e1
            have e2' : ((lamC r).hom.app V).hom ((C.obj.map g).hom ((f.hom.app U).hom x)) =
                (C.obj.map g).hom (((lamC r).hom.app U).hom ((f.hom.app U).hom x)) := e2
            rw [e1', e2'] }
      have hFpre : ∀ U r x, (Fpre.app U).hom (r ⊗ₜ[ℤ] x) =
          ((lamC r).hom.app U).hom ((f.hom.app U).hom x) := fun _ _ _ => rfl
      refine ⟨ObjectProperty.homMk (sheafifyLift _ Fpre C.property), ?_, ?_⟩
      · apply Sheaf.hom_ext
        show (ηpre X ≫ toSheafify _ _) ≫ sheafifyLift _ Fpre C.property = f.hom
        rw [Category.assoc, toSheafify_sheafifyLift]
        ext U x
        show (Fpre.app U).hom ((1 : R) ⊗ₜ[ℤ] x) = (f.hom.app U).hom x
        rw [hFpre, hC1]
        rfl
      · intro r
        apply Sheaf.hom_ext
        show sheafifyMap _ (lpre X r) ≫ sheafifyLift _ Fpre C.property =
          sheafifyLift _ Fpre C.property ≫ (lamC r).hom
        apply sheafify_hom_ext _ _ _ C.property
        rw [← Category.assoc, ← toSheafify_naturality, Category.assoc, toSheafify_sheafifyLift,
          ← Category.assoc, toSheafify_sheafifyLift]
        apply NatTrans.ext; funext U; apply keyext; intro a x
        show (Fpre.app U).hom ((r * a) ⊗ₜ[ℤ] x) =
          ((lamC r).hom.app U).hom ((Fpre.app U).hom (a ⊗ₜ[ℤ] x))
        rw [hFpre, hFpre, hCmul]
        rfl

  have hull : ∀ (X : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (lamX : R → (X ⟶ X)),
      wcRingAct lamX →
      ∃ (K : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (lamK : R → (K ⟶ K))
        (ε : X ⟶ K), wcRingAct lamK ∧ Mono ε ∧ Injective K ∧
        (∀ r, lamX r ≫ ε = ε ≫ lamK r) ∧
        ∀ {Y W : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (i : Y ⟶ W) [Mono i]
          (lamY : R → (Y ⟶ Y)) (lamW : R → (W ⟶ W)),
          wcRingAct lamY → wcRingAct lamW → (∀ r, lamY r ≫ i = i ≫ lamW r) →
          ∀ g : Y ⟶ K, (∀ r, lamY r ≫ g = g ≫ lamK r) →
            ∃ h : W ⟶ K, i ≫ h = g ∧ ∀ r, lamW r ≫ h = h ≫ lamK r := by
    intro X lamX hX
    obtain ⟨I₀, hI₀, e, he⟩ : ∃ (I₀ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
        (_ : Injective I₀) (e : X ⟶ I₀), Mono e :=
      ⟨Injective.under X, inferInstance, Injective.ι X, inferInstance⟩
    obtain ⟨P, π, hPext, hPlift⟩ : ∃ (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
        (π : R → (P ⟶ I₀)),
        (∀ {Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f g : Z ⟶ P),
          (∀ r, f ≫ π r = g ≫ π r) → f = g) ∧
        (∀ {Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (φ : R → (Z ⟶ I₀)),
          ∃ f : Z ⟶ P, ∀ r, f ≫ π r = φ r) :=
      ⟨Limits.piObj (fun _ : R => I₀), Limits.Pi.π (fun _ : R => I₀),
        fun f g h => Limits.Pi.hom_ext f g h,
        fun φ => ⟨Limits.Pi.lift φ, fun r => by simp⟩⟩
    obtain ⟨Q, πQ, hQext, hQlift⟩ : ∃ (Q : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
        (πQ : R × R → (Q ⟶ I₀)),
        (∀ {Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f g : Z ⟶ Q),
          (∀ p, f ≫ πQ p = g ≫ πQ p) → f = g) ∧
        (∀ {Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (φ : R × R → (Z ⟶ I₀)),
          ∃ f : Z ⟶ Q, ∀ p, f ≫ πQ p = φ p) :=
      ⟨Limits.piObj (fun _ : R × R => I₀), Limits.Pi.π (fun _ : R × R => I₀),
        fun f g h => Limits.Pi.hom_ext f g h,
        fun φ => ⟨Limits.Pi.lift φ, fun p => by simp⟩⟩
    obtain ⟨δ, hδ⟩ := hQlift (fun p : R × R => π (p.1 + p.2) - π p.1 - π p.2)
    have hδ' : ∀ p : R × R, δ ≫ πQ p = π (p.1 + p.2) - π p.1 - π p.2 := hδ
    choose ρ hρ using fun a : R => hPlift (fun r => π (r * a))
    have hρ' : ∀ (a r : R), ρ a ≫ π r = π (r * a) := hρ
    obtain ⟨K, ι, hιδ, hιm, hιlift⟩ : ∃ (K : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
        (ι : K ⟶ P), ι ≫ δ = 0 ∧ Mono ι ∧
        ∀ {Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (k : Z ⟶ P), k ≫ δ = 0 →
          ∃ l : Z ⟶ K, l ≫ ι = k :=
      ⟨Limits.kernel δ, Limits.kernel.ι δ, Limits.kernel.condition δ, inferInstance,
        fun k hk => ⟨Limits.kernel.lift δ k hk, Limits.kernel.lift_ι δ k hk⟩⟩
    haveI := hιm
    have hI1 : ∀ x y : R, ι ≫ π (x + y) = ι ≫ π x + ι ≫ π y := by
      intro x y
      have h : ι ≫ δ ≫ πQ (x, y) = 0 := by
        rw [← Category.assoc, hιδ, Limits.zero_comp]
      rw [hδ', Preadditive.comp_sub, Preadditive.comp_sub] at h
      rw [← sub_eq_zero, ← sub_sub]
      exact h
    have hI3 : ∀ a : R, (ι ≫ ρ a) ≫ δ = 0 := by
      intro a
      apply hQext
      intro p
      simp only [Category.assoc, hδ', Preadditive.comp_sub, Limits.zero_comp]
      simp only [hρ']
      rw [add_mul, hI1]
      abel
    choose lamK hlamK using fun a : R => hιlift (ι ≫ ρ a) (hI3 a)
    have hKπ : ∀ (a r : R), lamK a ≫ ι ≫ π r = ι ≫ π (r * a) := by
      intro a r
      rw [← Category.assoc, hlamK, Category.assoc, hρ']
    have hKext : ∀ {Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f g : Z ⟶ K),
        (∀ r, f ≫ ι ≫ π r = g ≫ ι ≫ π r) → f = g := by
      intro Z f g h
      exact (cancel_mono ι).1 (hPext _ _ (fun r => by simpa only [Category.assoc] using h r))
    have hK : wcRingAct lamK := by
      refine ⟨?_, ?_, ?_⟩
      · apply hKext
        intro r
        rw [hKπ, mul_one, Category.id_comp]
      · intro a b
        apply hKext
        intro r
        simp only [Preadditive.add_comp]
        rw [hKπ, hKπ, hKπ, mul_add, hI1]
      · intro a b
        apply hKext
        intro r
        rw [hKπ, Category.assoc, hKπ, hKπ, mul_assoc]
    have hex : ∀ (W : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (lamW : R → (W ⟶ W)),
        wcRingAct lamW → ∀ h₀ : W ⟶ I₀,
          ∃ h : W ⟶ K, h ≫ ι ≫ π 1 = h₀ ∧ ∀ r, lamW r ≫ h = h ≫ lamK r := by
      intro W lamW hW h₀
      obtain ⟨hW1, hWadd, hWmul⟩ := hW
      obtain ⟨φ, hφ⟩ := hPlift (fun r => lamW r ≫ h₀)
      have hφ' : ∀ r, φ ≫ π r = lamW r ≫ h₀ := hφ
      have hφδ : φ ≫ δ = 0 := by
        apply hQext
        intro p
        simp only [Category.assoc, hδ', Preadditive.comp_sub, hφ', hWadd, Preadditive.add_comp,
          Limits.zero_comp]
        abel
      obtain ⟨h, hh⟩ := hιlift φ hφδ
      have hh' : ∀ r, h ≫ ι ≫ π r = lamW r ≫ h₀ := by
        intro r
        rw [← Category.assoc, hh, hφ']
      refine ⟨h, by rw [hh', hW1, Category.id_comp], fun a => ?_⟩
      apply hKext
      intro r
      simp only [Category.assoc, hh', hKπ, hWmul]
    have huniq : ∀ (W : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
        (lamW : R → (W ⟶ W)),
        ∀ h h' : W ⟶ K, (∀ r, lamW r ≫ h = h ≫ lamK r) → (∀ r, lamW r ≫ h' = h' ≫ lamK r) →
          h ≫ ι ≫ π 1 = h' ≫ ι ≫ π 1 → h = h' := by
      intro W lamW h h' hh hh' heq
      have key : ∀ (k : W ⟶ K), (∀ r, lamW r ≫ k = k ≫ lamK r) →
          ∀ r, k ≫ ι ≫ π r = lamW r ≫ k ≫ ι ≫ π 1 := by
        intro k hk r
        rw [← Category.assoc (lamW r), hk r, Category.assoc, hKπ, one_mul]
      apply hKext
      intro r
      rw [key h hh r, key h' hh' r, heq]
    have hRI : ∀ {Y W : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (i : Y ⟶ W)
        [Mono i] (lamY : R → (Y ⟶ Y)) (lamW : R → (W ⟶ W)),
        wcRingAct lamY → wcRingAct lamW → (∀ r, lamY r ≫ i = i ≫ lamW r) →
        ∀ g : Y ⟶ K, (∀ r, lamY r ≫ g = g ≫ lamK r) →
          ∃ h : W ⟶ K, i ≫ h = g ∧ ∀ r, lamW r ≫ h = h ≫ lamK r := by
      intro Y W i _ lamY lamW _ hW hi g hg
      obtain ⟨h₀, hh₀⟩ := Injective.factors (g ≫ ι ≫ π 1) i
      obtain ⟨h, hh, hheq⟩ := hex W lamW hW h₀
      refine ⟨h, huniq Y lamY (i ≫ h) g (fun r => ?_) hg ?_, hheq⟩
      · rw [reassoc_of% (hi r), hheq r, Category.assoc]
      · rw [Category.assoc, hh, hh₀]
    have hKinj : Injective K := by
      refine ⟨fun {A B} g f _ => ?_⟩
      obtain ⟨TX, TY, lX, lY, ηX, ηY, Tj, hlX, hlY, hTj, hTjeq, hη, hlift⟩ := hfree f
      obtain ⟨ĝ, hĝ, hĝeq⟩ := hlift K lamK hK g
      haveI := hTj
      obtain ⟨h', hh', -⟩ := hRI Tj lX lY hlX hlY hTjeq ĝ hĝeq
      exact ⟨ηY ≫ h', by rw [← Category.assoc, ← hη, Category.assoc, hh', hĝ]⟩
    obtain ⟨ε, hε, hεeq⟩ := hex X lamX hX e
    have hεm : Mono ε := mono_of_mono_fac hε
    exact ⟨K, lamK, ε, hK, hεm, hKinj, hεeq, hRI⟩

  choose K lamK ε hK hεm hKi hεe hRI using hull
  have hcok : ∀ (X : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (lamX : R → (X ⟶ X))
      (hX : wcRingAct lamX),
      ∃ lamC : R → (Limits.cokernel (ε X lamX hX) ⟶ Limits.cokernel (ε X lamX hX)),
        wcRingAct lamC ∧ ∀ r, Limits.cokernel.π (ε X lamX hX) ≫ lamC r =
          lamK X lamX hX r ≫ Limits.cokernel.π (ε X lamX hX) := by
    intro X lamX hX
    have hw : ∀ r, ε X lamX hX ≫ lamK X lamX hX r ≫ Limits.cokernel.π (ε X lamX hX) = 0 := by
      intro r
      rw [← Category.assoc, ← hεe X lamX hX r, Category.assoc, Limits.cokernel.condition,
        Limits.comp_zero]
    refine ⟨fun r => Limits.cokernel.desc _ _ (hw r), ⟨?_, ?_, ?_⟩, fun r => by simp⟩
    · apply (cancel_epi (Limits.cokernel.π (ε X lamX hX))).1
      rw [Limits.cokernel.π_desc, (hK X lamX hX).1, Category.id_comp, Category.comp_id]
    · intro a b
      apply (cancel_epi (Limits.cokernel.π (ε X lamX hX))).1
      rw [Limits.cokernel.π_desc, Preadditive.comp_add, Limits.cokernel.π_desc,
        Limits.cokernel.π_desc, (hK X lamX hX).2.1, Preadditive.add_comp]
    · intro a b
      apply (cancel_epi (Limits.cokernel.π (ε X lamX hX))).1
      rw [Limits.cokernel.π_desc, Limits.cokernel.π_desc_assoc, Category.assoc,
        Limits.cokernel.π_desc, (hK X lamX hX).2.2, Category.assoc]
  choose lamC hlamC hlamCπ using hcok
  let RO := {p : Σ X : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}, R → (X ⟶ X) //
    wcRingAct p.2}
  let nxt : RO → RO := fun p =>
    ⟨⟨Limits.cokernel (ε p.1.1 p.1.2 p.2), lamC p.1.1 p.1.2 p.2⟩, hlamC p.1.1 p.1.2 p.2⟩
  let stage : ℕ → RO := fun n => Nat.rec ⟨⟨G, lamG⟩, hG⟩ (fun _ p => nxt p) n
  let Xn : ℕ → Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} := fun n => (stage n).1.1
  let lX : (n : ℕ) → R → (Xn n ⟶ Xn n) := fun n => (stage n).1.2
  let hX : ∀ n, wcRingAct (lX n) := fun n => (stage n).2
  let Kn : ℕ → Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} :=
    fun n => K (Xn n) (lX n) (hX n)
  let lK : (n : ℕ) → R → (Kn n ⟶ Kn n) := fun n => lamK (Xn n) (lX n) (hX n)
  let εn : (n : ℕ) → (Xn n ⟶ Kn n) := fun n => ε (Xn n) (lX n) (hX n)
  let πn : (n : ℕ) → (Kn n ⟶ Xn (n + 1)) := fun n => Limits.cokernel.π (εn n)
  have hεπ : ∀ n, εn n ≫ πn n = 0 := fun n => Limits.cokernel.condition (εn n)
  have hπepi : ∀ n, Epi (πn n) := fun n => by
    show Epi (Limits.cokernel.π (εn n)); infer_instance
  have hεmono : ∀ n, Mono (εn n) := fun n => hεm _ _ _
  have hεeq : ∀ n r, lX n r ≫ εn n = εn n ≫ lK n r := fun n r => hεe _ _ _ r
  have hπeq : ∀ n r, πn n ≫ lX (n + 1) r = lK n r ≫ πn n := fun n r => hlamCπ _ _ _ r
  let d : (n : ℕ) → (Kn n ⟶ Kn (n + 1)) := fun n => πn n ≫ εn (n + 1)
  have hdd : ∀ n, d n ≫ d (n + 1) = 0 := by
    intro n
    show (πn n ≫ εn (n + 1)) ≫ (πn (n + 1) ≫ εn (n + 1 + 1)) = 0
    rw [Category.assoc, ← Category.assoc (εn (n + 1)), hεπ (n + 1), Limits.zero_comp,
      Limits.comp_zero]
  let C : CochainComplex (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) ℕ :=
    CochainComplex.of Kn d hdd
  have hCd : ∀ n, C.d n (n + 1) = d n := fun n => CochainComplex.of_d _ _ n
  have hι0 : εn 0 ≫ C.d 0 1 = 0 := by
    rw [hCd 0]
    show εn 0 ≫ πn 0 ≫ εn 1 = 0
    rw [← Category.assoc, hεπ 0, Limits.zero_comp]
  let ι : (CochainComplex.single₀ (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})).obj G ⟶
      C := (C.fromSingle₀Equiv G).symm ⟨εn 0, hι0⟩
  have hιf : ι.f 0 = εn 0 := CochainComplex.fromSingle₀Equiv_symm_apply_f_zero _ _
  have hexact : ∀ n, C.ExactAt (n + 1) := by
    intro n
    rw [HomologicalComplex.exactAt_iff' C n (n + 1) (n + 1 + 1) (CochainComplex.prev_nat_succ n)
      (CochainComplex.next ℕ (n + 1))]
    let S0 : ShortComplex (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
      ShortComplex.mk (εn (n + 1)) (πn (n + 1)) (hεπ (n + 1))
    have hS0 : S0.Exact := ShortComplex.exact_cokernel (εn (n + 1))
    let S1 : ShortComplex (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
      ShortComplex.mk (d n) (πn (n + 1)) (by
        show (πn n ≫ εn (n + 1)) ≫ πn (n + 1) = 0
        rw [Category.assoc, hεπ (n + 1), Limits.comp_zero])
    let φ1 : S1 ⟶ S0 := ShortComplex.Hom.mk (πn n) (𝟙 _) (𝟙 _)
      (by show πn n ≫ εn (n + 1) = (πn n ≫ εn (n + 1)) ≫ 𝟙 _; rw [Category.comp_id])
      (by show 𝟙 _ ≫ πn (n + 1) = πn (n + 1) ≫ 𝟙 _; rw [Category.comp_id, Category.id_comp])
    haveI : Epi φ1.τ₁ := hπepi n
    haveI : IsIso φ1.τ₂ := by change IsIso (𝟙 _); infer_instance
    haveI : Mono φ1.τ₃ := by change Mono (𝟙 _); infer_instance
    have hS1 : S1.Exact := (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ1).2 hS0
    let φ2 : S1 ⟶ C.sc' n (n + 1) (n + 1 + 1) :=
      ShortComplex.Hom.mk (𝟙 _) (𝟙 _) (εn (n + 1 + 1))
        (by
          show 𝟙 _ ≫ C.d n (n + 1) = d n ≫ 𝟙 _
          rw [hCd, Category.comp_id, Category.id_comp])
        (by
          show 𝟙 _ ≫ C.d (n + 1) (n + 1 + 1) = πn (n + 1) ≫ εn (n + 1 + 1)
          rw [hCd, Category.id_comp])
    haveI : Epi φ2.τ₁ := by change Epi (𝟙 _); infer_instance
    haveI : IsIso φ2.τ₂ := by change IsIso (𝟙 _); infer_instance
    haveI : Mono φ2.τ₃ := hεmono (n + 1 + 1)
    exact (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ2).1 hS1
  have hq : QuasiIso ι := by
    rw [quasiIso_iff]
    intro n
    cases n with
    | zero =>
      rw [CochainComplex.quasiIsoAt₀_iff, ShortComplex.quasiIso_iff_of_zeros]
      · refine ⟨?_, ?_⟩
        · have hz : ι.f 0 ≫ C.d 0 1 = 0 := by rw [hιf]; exact hι0
          let S0 : ShortComplex (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
            ShortComplex.mk (εn 0) (πn 0) (hεπ 0)
          have hS0 : S0.Exact := ShortComplex.exact_cokernel (εn 0)
          let φ0 : S0 ⟶ ShortComplex.mk (ι.f 0) (C.d 0 1) hz :=
            ShortComplex.Hom.mk (𝟙 _) (𝟙 _) (εn 1)
              (by
                first
                  | exact (Category.id_comp (ι.f 0)).trans (hιf.trans (Category.comp_id _).symm)
                  | (erw [Category.id_comp, Category.comp_id]; exact hιf)
                  | (simp only [Category.id_comp, Category.comp_id]; exact hιf))
              (by
                first
                  | exact (Category.id_comp _).trans (hCd 0)
                  | (erw [Category.id_comp]; exact hCd 0))
          haveI : Epi φ0.τ₁ := by change Epi (𝟙 _); infer_instance
          haveI : IsIso φ0.τ₂ := by change IsIso (𝟙 _); infer_instance
          haveI : Mono φ0.τ₃ := by change Mono (εn 1); exact hεmono 1
          exact (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ0).1 hS0
        · change Mono (ι.f 0)
          rw [hιf]
          exact hεmono 0
      all_goals first | rfl | simp
    | succ n =>
      rw [quasiIsoAt_iff_exactAt]
      · exact hexact n
      · exact CochainComplex.exactAt_succ_single_obj G n
  let I : InjectiveResolution G :=
    { cocomplex := C
      injective := fun n => hKi (Xn n) (lX n) (hX n)
      ι := ι
      quasiIso := hq }
  let lamI : R → (I.cocomplex ⟶ I.cocomplex) := fun r =>
    CochainComplex.ofHom (X := C) (Y := C) (fun n => lK n r) (by
      intro n
      rw [hCd]
      show lK n r ≫ πn n ≫ εn (n + 1) = (πn n ≫ εn (n + 1)) ≫ lK (n + 1) r
      rw [← Category.assoc, ← hπeq n r, Category.assoc, hεeq (n + 1) r, Category.assoc])
  have hlamIf : ∀ r n, (lamI r).f n = lK n r := fun r n => rfl
  refine ⟨I, lamI, ⟨?_, ?_, ?_⟩, ?_, ?_⟩
  · apply HomologicalComplex.hom_ext
    intro n
    rw [hlamIf, HomologicalComplex.id_f]
    exact (hK _ _ _).1
  · intro a b
    apply HomologicalComplex.hom_ext
    intro n
    rw [HomologicalComplex.add_f_apply, hlamIf, hlamIf, hlamIf]
    exact (hK _ _ _).2.1 a b
  · intro a b
    apply HomologicalComplex.hom_ext
    intro n
    rw [HomologicalComplex.comp_f, hlamIf, hlamIf, hlamIf]
    exact (hK _ _ _).2.2 a b
  · intro r
    show ι.f 0 ≫ lK 0 r = lamG r ≫ ι.f 0
    rw [hιf]
    exact (hεeq 0 r).symm
  · intro n Y W i _ lamY lamW hY hW hi g hg
    exact hRI (Xn n) (lX n) (hX n) i lamY lamW hY hW hi g hg

theorem wc_equivariant_resolution_comparison {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜]
    {Γ : Type*} [Group Γ] {A : 𝒜} (ρA : Γ → (A ⟶ A)) (J : InjectiveResolution A)
    (ρJ : Γ → (J.cocomplex ⟶ J.cocomplex)) (hJ : wcStrictResSpec ρA J ρJ)
    (I : InjectiveResolution A) (ρI : Γ → (I.cocomplex ⟶ I.cocomplex))
    (hI1 : ρI 1 = 𝟙 _) (hImul : ∀ a b, ρI (a * b) = ρI b ≫ ρI a)
    (hI0 : ∀ a, I.ι.f 0 ≫ (ρI a).f 0 = ρA a ≫ I.ι.f 0) :
    ∃ c : I.cocomplex ⟶ J.cocomplex, I.ι.f 0 ≫ c.f 0 = J.ι.f 0 ∧ ∀ a, ρI a ≫ c = c ≫ ρJ a :=
by
  classical

  have s1 : ∀ (m : ℕ) (S : ShortComplex 𝒜) (_ : S.Exact)
      (ρ₁ : Γ → (S.X₁ ⟶ S.X₁)) (ρ₂ : Γ → (S.X₂ ⟶ S.X₂)) (ρ₃ : Γ → (S.X₃ ⟶ S.X₃)),
      (∀ a b, ρ₂ (a * b) = ρ₂ b ≫ ρ₂ a) → ρ₂ 1 = 𝟙 _ →
      (∀ a b, ρ₃ (a * b) = ρ₃ b ≫ ρ₃ a) → ρ₃ 1 = 𝟙 _ →
      (∀ a, ρ₁ a ≫ S.f = S.f ≫ ρ₂ a) → (∀ a, ρ₂ a ≫ S.g = S.g ≫ ρ₃ a) →
      ∀ (k : S.X₂ ⟶ J.cocomplex.X m), (∀ a, ρ₂ a ≫ k = k ≫ (ρJ a).f m) → S.f ≫ k = 0 →
      ∃ h : S.X₃ ⟶ J.cocomplex.X m, S.g ≫ h = k ∧ ∀ a, ρ₃ a ≫ h = h ≫ (ρJ a).f m := by
    intro m S hS ρ₁ ρ₂ ρ₃ h2mul h21 h3mul h31 hf hg k hk hz
    have w : ∀ a, S.f ≫ ρ₂ a ≫ Limits.cokernel.π S.f = 0 := by
      intro a
      rw [← Category.assoc, ← hf a, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
    let ρC : Γ → (Limits.cokernel S.f ⟶ Limits.cokernel S.f) :=
      fun a => Limits.cokernel.desc S.f (ρ₂ a ≫ Limits.cokernel.π S.f) (w a)
    have hρC : ∀ a, Limits.cokernel.π S.f ≫ ρC a = ρ₂ a ≫ Limits.cokernel.π S.f := fun a =>
      Limits.cokernel.π_desc _ _ _
    have hCmul : ∀ a b, ρC (a * b) = ρC b ≫ ρC a := by
      intro a b
      rw [← cancel_epi (Limits.cokernel.π S.f), hρC, ← Category.assoc, hρC, Category.assoc, hρC,
        ← Category.assoc, h2mul]
    have hC1 : ρC 1 = 𝟙 _ := by
      rw [← cancel_epi (Limits.cokernel.π S.f), hρC, h21, Category.id_comp, Category.comp_id]
    haveI : Mono (Limits.cokernel.desc S.f S.g S.zero) := hS.mono_cokernelDesc
    have hj : ∀ a, ρC a ≫ Limits.cokernel.desc S.f S.g S.zero =
        Limits.cokernel.desc S.f S.g S.zero ≫ ρ₃ a := by
      intro a
      rw [← cancel_epi (Limits.cokernel.π S.f), ← Category.assoc, hρC, Category.assoc,
        Limits.cokernel.π_desc, ← Category.assoc, Limits.cokernel.π_desc, hg]
    have hg₀ : ∀ a, ρC a ≫ Limits.cokernel.desc S.f k hz =
        Limits.cokernel.desc S.f k hz ≫ (ρJ a).f m := by
      intro a
      rw [← cancel_epi (Limits.cokernel.π S.f), ← Category.assoc, hρC, Category.assoc,
        Limits.cokernel.π_desc, ← Category.assoc, Limits.cokernel.π_desc, hk]
    obtain ⟨h, hh1, hh2⟩ := hJ.2.2.2 m (Limits.cokernel.desc S.f S.g S.zero) ρC ρ₃ hCmul h3mul
      hC1 h31 hj (Limits.cokernel.desc S.f k hz) hg₀
    refine ⟨h, ?_, hh2⟩
    calc S.g ≫ h = (Limits.cokernel.π S.f ≫ Limits.cokernel.desc S.f S.g S.zero) ≫ h := by
          rw [Limits.cokernel.π_desc]
      _ = Limits.cokernel.π S.f ≫ Limits.cokernel.desc S.f k hz := by
          rw [Category.assoc, hh1]
      _ = k := Limits.cokernel.π_desc _ _ _

  obtain ⟨ιJ, hιJ⟩ : ∃ f : A ⟶ J.cocomplex.X 0, f = J.ι.f 0 := ⟨_, rfl⟩
  have hιJm : Mono ιJ := by subst hιJ; exact InjectiveResolution.instMonoFNatι J 0
  have key : ∀ a, ρA a ≫ ιJ = ιJ ≫ (ρJ a).f 0 := fun a => by
    subst hιJ; exact (hJ.2.2.1 a).symm
  have hAmul : ∀ a b, ρA (a * b) = ρA b ≫ ρA a := by
    intro a b
    apply (cancel_mono ιJ).1
    rw [Category.assoc, key a, ← Category.assoc, key b, Category.assoc,
      key (a * b), hJ.2.1 a b, HomologicalComplex.comp_f]
  have hA1 : ρA 1 = 𝟙 _ := by
    apply (cancel_mono ιJ).1
    rw [key 1, hJ.1, HomologicalComplex.id_f, Category.id_comp, Category.comp_id]

  have hIf_mul : ∀ n a b, (ρI (a * b)).f n = (ρI b).f n ≫ (ρI a).f n := fun n a b => by
    rw [hImul, HomologicalComplex.comp_f]
  have hIf_one : ∀ n, (ρI 1).f n = 𝟙 _ := fun n => by rw [hI1, HomologicalComplex.id_f]

  obtain ⟨c₀, hc₀, hE0⟩ := hJ.2.2.2 0 (I.ι.f 0) ρA (fun a => (ρI a).f 0) hAmul
    (fun a b => hIf_mul 0 a b) hA1 (hIf_one 0) (fun a => (hI0 a).symm) (J.ι.f 0)
    (fun a => (hJ.2.2.1 a).symm)

  obtain ⟨c₁, hc₁, hE1⟩ := s1 1 _ I.exact₀ ρA (fun a => (ρI a).f 0) (fun a => (ρI a).f 1)
    (fun a b => hIf_mul 0 a b) (hIf_one 0) (fun a b => hIf_mul 1 a b) (hIf_one 1)
    (fun a => (hI0 a).symm) (fun a => (ρI a).comm 0 1) (c₀ ≫ J.cocomplex.d 0 1) (by
      intro a
      show (ρI a).f 0 ≫ c₀ ≫ J.cocomplex.d 0 1 = (c₀ ≫ J.cocomplex.d 0 1) ≫ (ρJ a).f 1
      rw [← Category.assoc, hE0 a, Category.assoc, (ρJ a).comm 0 1, Category.assoc]) (by
      show I.ι.f 0 ≫ c₀ ≫ J.cocomplex.d 0 1 = 0
      rw [← Category.assoc, hc₀, J.ι_f_zero_comp_complex_d])

  have step : ∀ (n : ℕ) (f : I.cocomplex.X n ⟶ J.cocomplex.X n)
      (f' : I.cocomplex.X (n + 1) ⟶ J.cocomplex.X (n + 1)),
      (∀ a, (ρI a).f n ≫ f = f ≫ (ρJ a).f n) →
      (∀ a, (ρI a).f (n + 1) ≫ f' = f' ≫ (ρJ a).f (n + 1)) →
      f ≫ J.cocomplex.d n (n + 1) = I.cocomplex.d n (n + 1) ≫ f' →
      ∃ f'' : I.cocomplex.X (n + 1 + 1) ⟶ J.cocomplex.X (n + 1 + 1),
        (∀ a, (ρI a).f (n + 1 + 1) ≫ f'' = f'' ≫ (ρJ a).f (n + 1 + 1)) ∧
        f' ≫ J.cocomplex.d (n + 1) (n + 1 + 1) = I.cocomplex.d (n + 1) (n + 1 + 1) ≫ f'' := by
    intro n f f' hf hf' hc
    have hS := (I.cocomplex.exactAt_iff' n (n + 1) (n + 2) (CochainComplex.prev_nat_succ n)
      (CochainComplex.next ℕ (n + 1))).1 (I.cocomplex_exactAt_succ n)
    obtain ⟨f'', h1, h2⟩ := s1 (n + 2) _ hS (fun a => (ρI a).f n) (fun a => (ρI a).f (n + 1))
      (fun a => (ρI a).f (n + 2)) (fun a b => hIf_mul _ a b) (hIf_one _)
      (fun a b => hIf_mul _ a b) (hIf_one _) (fun a => (ρI a).comm n (n + 1))
      (fun a => (ρI a).comm (n + 1) (n + 2)) (f' ≫ J.cocomplex.d (n + 1) (n + 2)) (by
        intro a
        show (ρI a).f (n + 1) ≫ f' ≫ J.cocomplex.d (n + 1) (n + 2) =
          (f' ≫ J.cocomplex.d (n + 1) (n + 2)) ≫ (ρJ a).f (n + 2)
        rw [← Category.assoc, hf' a, Category.assoc, (ρJ a).comm (n + 1) (n + 2),
          Category.assoc]) (by
        show I.cocomplex.d n (n + 1) ≫ f' ≫ J.cocomplex.d (n + 1) (n + 2) = 0
        rw [← Category.assoc, ← hc, Category.assoc, HomologicalComplex.d_comp_d,
          Limits.comp_zero])
    exact ⟨f'', h2, h1.symm⟩

  let T : (n : ℕ) → {p : (I.cocomplex.X n ⟶ J.cocomplex.X n) ×
      (I.cocomplex.X (n + 1) ⟶ J.cocomplex.X (n + 1)) //
      (∀ a, (ρI a).f n ≫ p.1 = p.1 ≫ (ρJ a).f n) ∧
      (∀ a, (ρI a).f (n + 1) ≫ p.2 = p.2 ≫ (ρJ a).f (n + 1)) ∧
      p.1 ≫ J.cocomplex.d n (n + 1) = I.cocomplex.d n (n + 1) ≫ p.2} := fun n =>
    Nat.rec (motive := fun n => {p : (I.cocomplex.X n ⟶ J.cocomplex.X n) ×
      (I.cocomplex.X (n + 1) ⟶ J.cocomplex.X (n + 1)) //
      (∀ a, (ρI a).f n ≫ p.1 = p.1 ≫ (ρJ a).f n) ∧
      (∀ a, (ρI a).f (n + 1) ≫ p.2 = p.2 ≫ (ρJ a).f (n + 1)) ∧
      p.1 ≫ J.cocomplex.d n (n + 1) = I.cocomplex.d n (n + 1) ≫ p.2})
      ⟨(c₀, c₁), hE0, hE1, hc₁.symm⟩
      (fun n p => ⟨(p.1.2, Classical.choose (step n p.1.1 p.1.2 p.2.1 p.2.2.1 p.2.2.2)),
        p.2.2.1, (Classical.choose_spec (step n p.1.1 p.1.2 p.2.1 p.2.2.1 p.2.2.2)).1,
        (Classical.choose_spec (step n p.1.1 p.1.2 p.2.1 p.2.2.1 p.2.2.2)).2⟩) n
  let c : I.cocomplex ⟶ J.cocomplex :=
    { f := fun n => (T n).1.1
      comm' := by
        intro i j hij
        have hij' : i + 1 = j := hij
        subst hij'
        exact (T i).2.2.2 }
  refine ⟨c, ?_, ?_⟩
  · show I.ι.f 0 ≫ c₀ = J.ι.f 0
    exact hc₀
  · intro a
    ext n
    rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f]
    exact (T n).2.1 a

theorem wc_fgvan_of_ext_fg {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] [HasExt 𝒜] {R : Type*} [Ring R]
    {A : 𝒜} (lamA : R → (A ⟶ A)) (I : InjectiveResolution A)
    (lamI : R → (I.cocomplex ⟶ I.cocomplex))
    (hI0 : ∀ r, I.ι.f 0 ≫ (lamI r).f 0 = lamA r ≫ I.ι.f 0) (P : 𝒜)
    (hfg : ∀ n, ∃ (k : ℕ) (e : Fin k → Abelian.Ext P A n), ∀ x : Abelian.Ext P A n,
      ∃ c : Fin k → R, x = ∑ i, (e i).comp (Abelian.Ext.mk₀ (lamA (c i))) (add_zero n))
    (hvan : ∀ n, 3 ≤ n → ∀ x : Abelian.Ext P A n, x = 0) :
    wcFgVan (((preadditiveCoyoneda.obj (Opposite.op P)).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex)
      (fun r => ((preadditiveCoyoneda.obj (Opposite.op P)).mapHomologicalComplex
        (ComplexShape.up ℕ)).map (lamI r)) :=
by
  classical
  have cob : ∀ (q m : ℕ) (g : P ⟶ I.cocomplex.X q) (hg : g ≫ I.cocomplex.d q (q + 1) = 0)
      (u : Fin m → (P ⟶ I.cocomplex.X q)) (hu : ∀ a, u a ≫ I.cocomplex.d q (q + 1) = 0)
      (_ : I.extMk g (q + 1) rfl hg = ∑ a, I.extMk (u a) (q + 1) rfl (hu a)),
      ∃ k : P ⟶ I.cocomplex.X ((ComplexShape.up ℕ).prev q),
        g = ∑ a, u a + k ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev q) q := by
    intro q m g hg u hu h
    have hcongr : ∀ (f f' : P ⟶ I.cocomplex.X q) (_ : f = f')
        (hf : f ≫ I.cocomplex.d q (q + 1) = 0) (hf' : f' ≫ I.cocomplex.d q (q + 1) = 0),
        I.extMk f (q + 1) rfl hf = I.extMk f' (q + 1) rfl hf' := by
      intro f f' e hf hf'
      subst e
      rfl
    have s1 : ∀ (s : Finset (Fin m)) (hs : (∑ a ∈ s, u a) ≫ I.cocomplex.d q (q + 1) = 0),
        ∑ a ∈ s, I.extMk (u a) (q + 1) rfl (hu a) = I.extMk (∑ a ∈ s, u a) (q + 1) rfl hs := by
      intro s
      induction s using Finset.induction_on with
      | empty =>
        intro hs
        rw [Finset.sum_empty, hcongr _ 0 Finset.sum_empty hs (by rw [Limits.zero_comp]),
          I.extMk_zero]
      | insert a s ha ih =>
        intro hs
        have hs' : (∑ b ∈ s, u b) ≫ I.cocomplex.d q (q + 1) = 0 := by
          rw [Preadditive.sum_comp]
          exact Finset.sum_eq_zero (fun b _ => hu b)
        rw [hcongr _ _ (Finset.sum_insert ha) hs
            (by rw [Preadditive.add_comp, hu a, hs', add_zero]),
          ← I.add_extMk _ _ _ rfl (hu a) hs', ← ih hs',
          Finset.sum_insert ha (f := fun b => I.extMk (u b) (q + 1) rfl (hu b))]
    have hsum : (∑ a, u a) ≫ I.cocomplex.d q (q + 1) = 0 := by
      rw [Preadditive.sum_comp]
      exact Finset.sum_eq_zero (fun a _ => hu a)
    have hδ : (g - ∑ a, u a) ≫ I.cocomplex.d q (q + 1) = 0 := by
      rw [Preadditive.sub_comp, hg, hsum, sub_zero]
    have hext0 : I.extMk (g - ∑ a, u a) (q + 1) rfl hδ = 0 := by
      rw [← I.sub_extMk _ _ _ rfl hg hsum, ← s1 Finset.univ hsum, ← h, sub_self]
    rcases q with _ | p
    · refine ⟨0, ?_⟩
      rw [Limits.zero_comp, add_zero]
      have h1 := congrArg I.extEquivCohomologyClass hext0
      rw [InjectiveResolution.extEquivCohomologyClass_extMk,
        InjectiveResolution.extEquivCohomologyClass_zero,
        CochainComplex.HomComplex.CohomologyClass.mk_eq_zero_iff,
        CochainComplex.HomComplex.Cocycle.fromSingleMk_mem_coboundaries_iff _ _ _ _ _ (-1)
          (by norm_num)] at h1
      obtain ⟨g', hg'⟩ := h1
      have hz : Limits.IsZero (I.cochainComplex.X (-1)) :=
        CochainComplex.isZero_of_isStrictlyGE I.cochainComplex 0 (-1)
      rw [hz.eq_of_tgt g' 0, Limits.zero_comp] at hg'
      have h2 : (g - ∑ a, u a) = 0 := by
        rw [← cancel_mono (I.cochainComplexXIso ((0 : ℕ) : ℤ) 0 rfl).inv, Limits.zero_comp]
        exact hg'.symm
      exact sub_eq_zero.mp h2
    · obtain ⟨k, hk⟩ := (I.extMk_eq_zero_iff (g - ∑ a, u a) _ rfl hδ
        ((ComplexShape.up ℕ).prev (p + 1)) (by rw [CochainComplex.prev_nat_succ])).mp hext0
      exact ⟨k, by rw [hk]; abel⟩
  unfold wcFgVan
  refine ⟨fun n => ?_, fun n hn y hy => ?_⟩
  · obtain ⟨k, e, he⟩ := hfg n
    choose z hz hze using fun i => I.extMk_surjective (e i) (n + 1) rfl
    refine ⟨k, z, fun i => hz i, fun x hx0 => ?_⟩
    change P ⟶ I.cocomplex.X n at x
    have hx : x ≫ I.cocomplex.d n (n + 1) = 0 := hx0
    obtain ⟨c, hc⟩ := he (I.extMk x (n + 1) rfl hx)
    let φ : ∀ i, I.Hom I (lamA (c i)) := fun i =>
      ⟨lamI (c i), by rw [CochainComplex.single₀_map_f_zero]; exact hI0 (c i)⟩
    have hu : ∀ i, (z i ≫ (lamI (c i)).f n) ≫ I.cocomplex.d n (n + 1) = 0 := by
      intro i
      rw [Category.assoc, (lamI (c i)).comm, ← Category.assoc, hz i, Limits.zero_comp]
    have h : I.extMk x (n + 1) rfl hx =
        ∑ i, I.extMk (z i ≫ (lamI (c i)).f n) (n + 1) rfl (hu i) := by
      rw [hc]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [← hze i]
      exact InjectiveResolution.extMk_comp_mk₀ (z i) (n + 1) rfl (hz i) (φ i)
    obtain ⟨k', hk'⟩ := cob n k x hx _ hu h
    have hprev : (ComplexShape.up ℕ).prev n = n - 1 := by
      cases n with
      | zero => simp
      | succ j => simp [CochainComplex.prev_nat_succ]
    have key : ∀ m', (ComplexShape.up ℕ).prev n = m' → ∃ w : P ⟶ I.cocomplex.X m',
        x = ∑ i, z i ≫ (lamI (c i)).f n + w ≫ I.cocomplex.d m' n := by
      intro m' hm'
      subst hm'
      exact ⟨k', hk'⟩
    obtain ⟨w, hw⟩ := key (n - 1) hprev
    exact ⟨c, w, hw⟩
  · change P ⟶ I.cocomplex.X n at y
    have hy' : y ≫ I.cocomplex.d n (n + 1) = 0 := hy
    obtain ⟨g, hg⟩ :=
      (I.extMk_eq_zero_iff y (n + 1) rfl hy' (n - 1) (by omega)).mp (hvan n hn _)
    exact ⟨g, hg⟩

theorem wc_ext_les_vanishing_quotient {C : Type*} [Category C] [Abelian C] [HasExt C] (P : C)
    (Sc : ShortComplex C) (hSc : Sc.ShortExact)
    (hvan : ∀ j, 1 ≤ j → ∀ y : Abelian.Ext P Sc.X₃ j, y = 0) :
    Function.Injective (fun x : Abelian.Ext P Sc.X₁ 0 =>
      x.comp (Abelian.Ext.mk₀ Sc.f) (add_zero 0)) ∧
    (∀ y : Abelian.Ext P Sc.X₂ 0, y.comp (Abelian.Ext.mk₀ Sc.g) (add_zero 0) = 0 ↔
      ∃ x : Abelian.Ext P Sc.X₁ 0, x.comp (Abelian.Ext.mk₀ Sc.f) (add_zero 0) = y) ∧
    (∀ z : Abelian.Ext P Sc.X₃ 0, z.comp hSc.extClass (zero_add 1) = 0 ↔
      ∃ y : Abelian.Ext P Sc.X₂ 0, y.comp (Abelian.Ext.mk₀ Sc.g) (add_zero 0) = z) ∧
    (∀ x : Abelian.Ext P Sc.X₁ 1, x.comp (Abelian.Ext.mk₀ Sc.f) (add_zero 1) = 0 ↔
      ∃ z : Abelian.Ext P Sc.X₃ 0, z.comp hSc.extClass (zero_add 1) = x) ∧
    (∀ n, 1 ≤ n → Function.Surjective (fun x : Abelian.Ext P Sc.X₁ n =>
      x.comp (Abelian.Ext.mk₀ Sc.f) (add_zero n))) ∧
    (∀ n, 2 ≤ n → Function.Injective (fun x : Abelian.Ext P Sc.X₁ n =>
      x.comp (Abelian.Ext.mk₀ Sc.f) (add_zero n))) :=
by
  have hfg : (Abelian.Ext.mk₀ Sc.f).comp (Abelian.Ext.mk₀ Sc.g) (add_zero 0) = 0 := by
    rw [Abelian.Ext.mk₀_comp_mk₀, Sc.zero, Abelian.Ext.mk₀_zero]
  have hsub : ∀ n (x x' : Abelian.Ext P Sc.X₁ n),
      (x - x').comp (Abelian.Ext.mk₀ Sc.f) (add_zero n) =
        x.comp (Abelian.Ext.mk₀ Sc.f) (add_zero n) - x'.comp (Abelian.Ext.mk₀ Sc.f) (add_zero n) := by
    intro n x x'
    rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, ← sub_eq_add_neg]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro x x' h
    obtain ⟨a, rfl⟩ := (Abelian.Ext.mk₀_bijective P Sc.X₁).2 x
    obtain ⟨a', rfl⟩ := (Abelian.Ext.mk₀_bijective P Sc.X₁).2 x'
    simp only [Abelian.Ext.mk₀_comp_mk₀] at h
    have h2 := (Abelian.Ext.mk₀_bijective P Sc.X₂).1 h
    have := hSc.mono_f
    rw [cancel_mono] at h2
    rw [h2]
  · intro y
    constructor
    · intro hy
      exact Abelian.Ext.covariant_sequence_exact₂ P hSc y hy
    · rintro ⟨x, rfl⟩
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (add_zero 0) (by omega), hfg,
        Abelian.Ext.comp_zero]
  · intro z
    constructor
    · intro hz
      exact Abelian.Ext.covariant_sequence_exact₃ P hSc z (zero_add 1) hz
    · rintro ⟨y, rfl⟩
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add 1) (by omega), hSc.comp_extClass,
        Abelian.Ext.comp_zero]
  · intro x
    constructor
    · intro hx
      exact Abelian.Ext.covariant_sequence_exact₁ P hSc x hx (zero_add 1)
    · rintro ⟨z, rfl⟩
      rw [Abelian.Ext.comp_assoc _ _ _ (zero_add 1) (add_zero 1) (by omega), hSc.extClass_comp,
        Abelian.Ext.comp_zero]
  · intro n hn y
    exact Abelian.Ext.covariant_sequence_exact₂ P hSc y (hvan n hn _)
  · intro n hn x x' h
    have h0 : (x - x').comp (Abelian.Ext.mk₀ Sc.f) (add_zero n) = 0 := by
      rw [hsub]
      exact sub_eq_zero.mpr h
    obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₁ P hSc (x - x') h0
      (show (n - 1) + 1 = n by omega)
    rw [hvan (n - 1) (by omega) z, Abelian.Ext.zero_comp] at hz
    exact sub_eq_zero.mp hz.symm

theorem wc_padic_fg_five_term (ℓ : ℕ) [Fact (Nat.Prime ℓ)] {F0 G0 D0 F1 G1 : Type*}
    [AddCommGroup F0] [AddCommGroup G0] [AddCommGroup D0] [AddCommGroup F1] [AddCommGroup G1]
    [Module ℤ_[ℓ] F0] [Module ℤ_[ℓ] G0] [Module ℤ_[ℓ] D0] [Module ℤ_[ℓ] F1]
    [Module.Finite ℤ_[ℓ] D0]
    (a0 : F0 →+ G0) (b0 : G0 →+ D0) (c0 : D0 →+ F1) (a1 : F1 →+ G1)
    (ha0 : Function.Injective a0) (hb0 : ∀ y, b0 y = 0 ↔ ∃ x, a0 x = y)
    (hc0 : ∀ z, c0 z = 0 ↔ ∃ y, b0 y = z) (ha1 : ∀ x, a1 x = 0 ↔ ∃ z, c0 z = x)
    (ha1s : Function.Surjective a1)
    (hG0r : ∃ T : Finset G0, ∀ x, ∃ t ∈ T, ∃ x', x = t + ℓ • x')
    (hG0d : ∀ w : ℕ → G0, (∀ k, w k = ℓ • w (k + 1)) → w 0 = 0)
    (hG1r : ∃ T : Finset G1, ∀ x, ∃ t ∈ T, ∃ x', x = t + ℓ • x')
    (hG1d : ∀ w : ℕ → G1, (∀ k, w k = ℓ • w (k + 1)) → w 0 = 0) :
    Module.Finite ℤ_[ℓ] F0 ∧ Module.Finite ℤ_[ℓ] F1 :=
by
  classical


  have hℓ1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).one_lt
  have hsum : ∀ c : ℕ → ℤ_[ℓ], Summable (fun j => (ℓ : ℤ_[ℓ]) ^ j * c j) := by
    intro c
    refine Summable.of_norm_bounded (g := fun j : ℕ => ((ℓ : ℝ)⁻¹) ^ j)
      (summable_geometric_of_lt_one (by positivity) (inv_lt_one_of_one_lt₀ hℓ1)) ?_
    intro j
    calc ‖(ℓ : ℤ_[ℓ]) ^ j * c j‖ ≤ ‖(ℓ : ℤ_[ℓ]) ^ j‖ * ‖c j‖ := norm_mul_le _ _
      _ ≤ ‖(ℓ : ℤ_[ℓ]) ^ j‖ * 1 :=
          mul_le_mul_of_nonneg_left (PadicInt.norm_le_one _) (norm_nonneg _)
      _ = ((ℓ : ℝ)⁻¹) ^ j := by rw [mul_one, norm_pow, PadicInt.norm_p]
  obtain ⟨A, hA⟩ : ∃ A : (ℕ → ℤ_[ℓ]) → ℤ_[ℓ], ∀ c : ℕ → ℤ_[ℓ],
      A c = c 0 + (ℓ : ℤ_[ℓ]) * A (fun j => c (j + 1)) := by
    refine ⟨fun c => ∑' j, (ℓ : ℤ_[ℓ]) ^ j * c j, fun c => ?_⟩
    show ∑' j, (ℓ : ℤ_[ℓ]) ^ j * c j = c 0 + (ℓ : ℤ_[ℓ]) * ∑' j, (ℓ : ℤ_[ℓ]) ^ j * c (j + 1)
    rw [(hsum c).tsum_eq_zero_add, pow_zero, one_mul,
      ← (hsum (fun j => c (j + 1))).tsum_mul_left]
    congr 1
    apply tsum_congr
    intro j
    ring

  have hG0fin : Module.Finite ℤ_[ℓ] G0 := by
    have hT : ∃ T : Finset G0, ∀ m : G0, ∃ t ∈ T, ∃ m' : G0, m = t + (ℓ : ℤ_[ℓ]) • m' := by
      obtain ⟨T, hT⟩ := hG0r
      refine ⟨T, fun x => ?_⟩
      obtain ⟨t, ht, x', hx⟩ := hT x
      exact ⟨t, ht, x', by rw [Nat.cast_smul_eq_nsmul]; exact hx⟩
    have hD : ∀ w : ℕ → G0, (∀ n, w n = (ℓ : ℤ_[ℓ]) • w (n + 1)) → w 0 = 0 := by
      intro w hw
      exact hG0d w (fun k => by rw [hw k, Nat.cast_smul_eq_nsmul])
    obtain ⟨T, hT⟩ := hT
    choose dig hdigT nxt hnxt using hT
    rw [Module.finite_def]
    refine ⟨T, ?_⟩
    rw [eq_top_iff]
    intro m _
    obtain ⟨μ, hμ0, hμ⟩ : ∃ μ : ℕ → G0, μ 0 = m ∧ ∀ n, μ (n + 1) = nxt (μ n) :=
      ⟨fun n => nxt^[n] m, rfl, fun n => Function.iterate_succ_apply' nxt n m⟩
    obtain ⟨κ, hκ⟩ : ∃ κ : ℕ → G0 → ℤ_[ℓ], ∀ n s,
        κ n s = (if dig (μ n) = s then (1 : ℤ_[ℓ]) else 0) + (ℓ : ℤ_[ℓ]) * κ (n + 1) s := by
      refine ⟨fun n s => A (fun j => if dig (μ (n + j)) = s then (1 : ℤ_[ℓ]) else 0),
        fun n s => ?_⟩
      have h1 := hA (fun j => if dig (μ (n + j)) = s then (1 : ℤ_[ℓ]) else 0)
      have e : (fun j => if dig (μ (n + (j + 1))) = s then (1 : ℤ_[ℓ]) else 0) =
          (fun j => if dig (μ (n + 1 + j)) = s then (1 : ℤ_[ℓ]) else 0) := by
        funext j
        rw [show n + (j + 1) = n + 1 + j by omega]
      beta_reduce at h1
      rw [add_zero, e] at h1
      exact h1
    have hsplit : ∀ n, ∑ s ∈ T, κ n s • s =
        dig (μ n) + (ℓ : ℤ_[ℓ]) • ∑ s ∈ T, κ (n + 1) s • s := by
      intro n
      have h3 : ∑ s ∈ T, (if dig (μ n) = s then (1 : ℤ_[ℓ]) else 0) • s = dig (μ n) := by
        simp only [ite_smul, one_smul, zero_smul]
        rw [Finset.sum_ite_eq, if_pos (hdigT (μ n))]
      rw [Finset.sum_congr rfl (fun s _ => by rw [hκ n s]), Finset.smul_sum]
      simp only [add_smul, mul_smul, Finset.sum_add_distrib, h3]
    have hw : ∀ n, μ n - ∑ s ∈ T, κ n s • s =
        (ℓ : ℤ_[ℓ]) • (μ (n + 1) - ∑ s ∈ T, κ (n + 1) s • s) := by
      intro n
      have h2 : μ n = dig (μ n) + (ℓ : ℤ_[ℓ]) • μ (n + 1) := by rw [hμ n]; exact hnxt (μ n)
      rw [hsplit n, smul_sub]
      generalize dig (μ n) = d at h2 ⊢
      rw [h2]
      abel
    have h0 : μ 0 - ∑ s ∈ T, κ 0 s • s = 0 := hD (fun n => μ n - ∑ s ∈ T, κ n s • s) hw
    rw [hμ0, sub_eq_zero] at h0
    rw [h0]
    exact Submodule.sum_smul_mem _ _ (fun s hs => Submodule.subset_span hs)

  have hI : Ideal.span {(ℓ : ℤ_[ℓ])} ≤ (⊥ : Ideal ℤ_[ℓ]).jacobson := by
    rw [← PadicInt.maximalIdeal_eq_span_p]
    exact IsLocalRing.maximalIdeal_le_jacobson _
  have hsepG : ∀ y : G0, (∀ n : ℕ, ∃ z : G0, y = (ℓ : ℤ_[ℓ]) ^ n • z) → y = 0 := by
    intro y hy
    have hK := Ideal.iInf_pow_smul_eq_bot_of_le_jacobson (M := G0) _ hI
    have hmem : y ∈ ⨅ i : ℕ, (Ideal.span {(ℓ : ℤ_[ℓ])}) ^ i • (⊤ : Submodule ℤ_[ℓ] G0) := by
      rw [Submodule.mem_iInf]
      intro n
      obtain ⟨z, hz⟩ := hy n
      rw [hz]
      exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self _) n)
        Submodule.mem_top
    rw [hK] at hmem
    exact (Submodule.mem_bot _).mp hmem
  have hclosedD : ∀ (P : Submodule ℤ_[ℓ] D0) (d : D0),
      (∀ n : ℕ, ∃ z : D0, d - (ℓ : ℤ_[ℓ]) ^ n • z ∈ P) → d ∈ P := by
    intro P d hd
    have hK := Ideal.iInf_pow_smul_eq_bot_of_le_jacobson (M := D0 ⧸ P) _ hI
    have hmem : (Submodule.Quotient.mk d : D0 ⧸ P) ∈
        ⨅ i : ℕ, (Ideal.span {(ℓ : ℤ_[ℓ])}) ^ i • (⊤ : Submodule ℤ_[ℓ] (D0 ⧸ P)) := by
      rw [Submodule.mem_iInf]
      intro n
      obtain ⟨z, hz⟩ := hd n
      have e : (Submodule.Quotient.mk d : D0 ⧸ P) =
          (ℓ : ℤ_[ℓ]) ^ n • (Submodule.Quotient.mk z : D0 ⧸ P) := by
        rw [← Submodule.Quotient.mk_smul, ← sub_eq_zero, ← Submodule.Quotient.mk_sub,
          Submodule.Quotient.mk_eq_zero]
        exact hz
      rw [e]
      exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self _) n)
        Submodule.mem_top
    rw [hK] at hmem
    exact (Submodule.Quotient.mk_eq_zero P).mp ((Submodule.mem_bot _).mp hmem)
  have hsepD : ∀ y : D0, (∀ n : ℕ, ∃ z : D0, y = (ℓ : ℤ_[ℓ]) ^ n • z) → y = 0 := by
    intro y hy
    have h := hclosedD ⊥ y (fun n => by
      obtain ⟨z, hz⟩ := hy n
      refine ⟨z, ?_⟩
      rw [hz, sub_self]
      exact Submodule.zero_mem _)
    exact (Submodule.mem_bot _).mp h

  have lin_a0 : ∀ (c : ℤ_[ℓ]) (x : F0), a0 (c • x) = c • a0 x := by
    intro c x
    rw [← sub_eq_zero]
    apply hsepG
    intro n
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp (PadicInt.appr_spec n c)
    generalize c.appr n = m at ha
    obtain rfl : c = (m : ℤ_[ℓ]) + (ℓ : ℤ_[ℓ]) ^ n * a := by rw [mul_comm, ha]; ring
    have h1 : ∀ (k : ℕ) (u : F0), a0 ((k : ℤ_[ℓ]) • u) = (k : ℤ_[ℓ]) • a0 u := by
      intro k u
      rw [Nat.cast_smul_eq_nsmul, Nat.cast_smul_eq_nsmul, map_nsmul]
    refine ⟨a0 (a • x) - a • a0 x, ?_⟩
    rw [add_smul, add_smul, mul_smul, mul_smul, map_add, ← Nat.cast_pow, h1, h1, smul_sub]
    abel
  have lin_b0 : ∀ (c : ℤ_[ℓ]) (x : G0), b0 (c • x) = c • b0 x := by
    intro c x
    rw [← sub_eq_zero]
    apply hsepD
    intro n
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp (PadicInt.appr_spec n c)
    generalize c.appr n = m at ha
    obtain rfl : c = (m : ℤ_[ℓ]) + (ℓ : ℤ_[ℓ]) ^ n * a := by rw [mul_comm, ha]; ring
    have h1 : ∀ (k : ℕ) (u : G0), b0 ((k : ℤ_[ℓ]) • u) = (k : ℤ_[ℓ]) • b0 u := by
      intro k u
      rw [Nat.cast_smul_eq_nsmul, Nat.cast_smul_eq_nsmul, map_nsmul]
    refine ⟨b0 (a • x) - a • b0 x, ?_⟩
    rw [add_smul, add_smul, mul_smul, mul_smul, map_add, ← Nat.cast_pow, h1, h1, smul_sub]
    abel

  let a0L : F0 →ₗ[ℤ_[ℓ]] G0 :=
    { toFun := a0, map_add' := a0.map_add, map_smul' := fun c x => lin_a0 c x }
  have : IsNoetherian ℤ_[ℓ] G0 := isNoetherian_of_isNoetherianRing_of_finite ℤ_[ℓ] G0
  have hF0 : Module.Finite ℤ_[ℓ] F0 := Module.Finite.of_injective a0L ha0

  have hD0r : ∃ T : Finset D0, ∀ x, ∃ t ∈ T, ∃ x', x = t + ℓ • x' := by
    obtain ⟨k, e, he⟩ := Module.Finite.exists_fin (R := ℤ_[ℓ]) (M := D0)
    refine ⟨(Fintype.piFinset (fun _ : Fin k => Finset.range ℓ)).image
      (fun n => ∑ i, n i • e i), fun x => ?_⟩
    have hx : x ∈ Submodule.span ℤ_[ℓ] (Set.range e) := by rw [he]; exact Submodule.mem_top
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ_[ℓ]).mp hx
    have hdec : ∀ i, ∃ a : ℤ_[ℓ], c i = (((c i).appr 1 : ℕ) : ℤ_[ℓ]) + (ℓ : ℤ_[ℓ]) * a := by
      intro i
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp (PadicInt.appr_spec 1 (c i))
      refine ⟨a, ?_⟩
      rw [pow_one] at ha
      rw [mul_comm, ha]
      ring
    choose a ha using hdec
    refine ⟨∑ i, ((c i).appr 1) • e i,
      Finset.mem_image.mpr ⟨fun i => (c i).appr 1, ?_, rfl⟩, ∑ i, a i • e i, ?_⟩
    · rw [Fintype.mem_piFinset]
      intro i
      have h := PadicInt.appr_lt (c i) 1
      rw [pow_one] at h
      exact Finset.mem_range.mpr h
    · rw [← hc]
      calc ∑ i, c i • e i
          = ∑ i, ((((c i).appr 1 : ℕ) : ℤ_[ℓ]) • e i + (ℓ : ℤ_[ℓ]) • (a i • e i)) := by
            refine Finset.sum_congr rfl (fun i _ => ?_)
            conv_lhs => rw [ha i]
            rw [add_smul, mul_smul]
        _ = _ := by
            rw [Finset.sum_add_distrib, ← Finset.smul_sum]
            simp only [Nat.cast_smul_eq_nsmul]

  have hF1r : ∃ T : Finset F1, ∀ x, ∃ t ∈ T, ∃ x', x = t + ℓ • x' := by
    obtain ⟨TD, hTD⟩ := hD0r
    obtain ⟨TG, hTG⟩ := hG1r
    obtain ⟨s, hs'⟩ : ∃ s : G1 → F1, ∀ g, a1 (s g) = g := ⟨_, Function.surjInv_eq ha1s⟩
    refine ⟨(TG ×ˢ TD).image (fun p => s p.1 + c0 p.2), fun x => ?_⟩
    obtain ⟨t, ht, g', hg⟩ := hTG (a1 x)
    have hy : a1 (x - s t - ℓ • s g') = 0 := by
      rw [map_sub, map_sub, map_nsmul, hs', hs', hg]; abel
    obtain ⟨z, hz⟩ := (ha1 _).mp hy
    obtain ⟨r, hr, z', hz'⟩ := hTD z
    refine ⟨s t + c0 r, Finset.mem_image.mpr ⟨(t, r), Finset.mem_product.mpr ⟨ht, hr⟩, rfl⟩,
      s g' + c0 z', ?_⟩
    have hx : x = s t + ℓ • s g' + c0 z := by rw [hz]; abel
    rw [hx, hz', map_add, map_nsmul, nsmul_add]
    abel

  have hrange : ∀ d : D0, (∀ n : ℕ, ∃ z : D0, ∃ y : G0, b0 y = d - ℓ ^ n • z) →
      ∃ y : G0, b0 y = d := by
    intro d hd
    let b0L : G0 →ₗ[ℤ_[ℓ]] D0 :=
      { toFun := b0, map_add' := b0.map_add, map_smul' := fun c x => lin_b0 c x }
    have h := hclosedD (LinearMap.range b0L) d (fun n => by
      obtain ⟨z, y, hy⟩ := hd n
      refine ⟨z, LinearMap.mem_range.mpr ⟨y, ?_⟩⟩
      show b0 y = d - (ℓ : ℤ_[ℓ]) ^ n • z
      rw [hy, ← Nat.cast_pow, Nat.cast_smul_eq_nsmul])
    obtain ⟨y, hy⟩ := LinearMap.mem_range.mp h
    exact ⟨y, hy⟩

  have hF1d : ∀ w : ℕ → F1, (∀ k, w k = ℓ • w (k + 1)) → w 0 = 0 := by
    intro w hw
    have hker : ∀ k, a1 (w k) = 0 := by
      intro k
      exact hG1d (fun j => a1 (w (k + j))) (fun j => by
        show a1 (w (k + j)) = ℓ • a1 (w (k + (j + 1)))
        rw [hw (k + j), map_nsmul, add_assoc])
    choose d hd using fun k => (ha1 (w k)).mp (hker k)
    have hpow : ∀ n : ℕ, w 0 = ℓ ^ n • w n := by
      intro n
      induction n with
      | zero => simp
      | succ n ih => rw [ih, hw n, smul_smul, pow_succ]
    obtain ⟨y, hy⟩ := hrange (d 0) (fun n => by
      have h0 : c0 (d 0 - ℓ ^ n • d n) = 0 := by
        rw [map_sub, map_nsmul, hd, hd, ← hpow n, sub_self]
      obtain ⟨y, hy⟩ := (hc0 _).mp h0
      exact ⟨d n, y, hy⟩)
    rw [← hd 0]
    exact (hc0 _).mpr ⟨y, hy⟩

  have hF1 : Module.Finite ℤ_[ℓ] F1 := by
    have hT : ∃ T : Finset F1, ∀ m : F1, ∃ t ∈ T, ∃ m' : F1, m = t + (ℓ : ℤ_[ℓ]) • m' := by
      obtain ⟨T, hT⟩ := hF1r
      refine ⟨T, fun x => ?_⟩
      obtain ⟨t, ht, x', hx⟩ := hT x
      exact ⟨t, ht, x', by rw [Nat.cast_smul_eq_nsmul]; exact hx⟩
    have hD : ∀ w : ℕ → F1, (∀ n, w n = (ℓ : ℤ_[ℓ]) • w (n + 1)) → w 0 = 0 := by
      intro w hw
      exact hF1d w (fun k => by rw [hw k, Nat.cast_smul_eq_nsmul])
    obtain ⟨T, hT⟩ := hT
    choose dig hdigT nxt hnxt using hT
    rw [Module.finite_def]
    refine ⟨T, ?_⟩
    rw [eq_top_iff]
    intro m _
    obtain ⟨μ, hμ0, hμ⟩ : ∃ μ : ℕ → F1, μ 0 = m ∧ ∀ n, μ (n + 1) = nxt (μ n) :=
      ⟨fun n => nxt^[n] m, rfl, fun n => Function.iterate_succ_apply' nxt n m⟩
    obtain ⟨κ, hκ⟩ : ∃ κ : ℕ → F1 → ℤ_[ℓ], ∀ n s,
        κ n s = (if dig (μ n) = s then (1 : ℤ_[ℓ]) else 0) + (ℓ : ℤ_[ℓ]) * κ (n + 1) s := by
      refine ⟨fun n s => A (fun j => if dig (μ (n + j)) = s then (1 : ℤ_[ℓ]) else 0),
        fun n s => ?_⟩
      have h1 := hA (fun j => if dig (μ (n + j)) = s then (1 : ℤ_[ℓ]) else 0)
      have e : (fun j => if dig (μ (n + (j + 1))) = s then (1 : ℤ_[ℓ]) else 0) =
          (fun j => if dig (μ (n + 1 + j)) = s then (1 : ℤ_[ℓ]) else 0) := by
        funext j
        rw [show n + (j + 1) = n + 1 + j by omega]
      beta_reduce at h1
      rw [add_zero, e] at h1
      exact h1
    have hsplit : ∀ n, ∑ s ∈ T, κ n s • s =
        dig (μ n) + (ℓ : ℤ_[ℓ]) • ∑ s ∈ T, κ (n + 1) s • s := by
      intro n
      have h3 : ∑ s ∈ T, (if dig (μ n) = s then (1 : ℤ_[ℓ]) else 0) • s = dig (μ n) := by
        simp only [ite_smul, one_smul, zero_smul]
        rw [Finset.sum_ite_eq, if_pos (hdigT (μ n))]
      rw [Finset.sum_congr rfl (fun s _ => by rw [hκ n s]), Finset.smul_sum]
      simp only [add_smul, mul_smul, Finset.sum_add_distrib, h3]
    have hw : ∀ n, μ n - ∑ s ∈ T, κ n s • s =
        (ℓ : ℤ_[ℓ]) • (μ (n + 1) - ∑ s ∈ T, κ (n + 1) s • s) := by
      intro n
      have h2 : μ n = dig (μ n) + (ℓ : ℤ_[ℓ]) • μ (n + 1) := by rw [hμ n]; exact hnxt (μ n)
      rw [hsplit n, smul_sub]
      generalize dig (μ n) = d at h2 ⊢
      rw [h2]
      abel
    have h0 : μ 0 - ∑ s ∈ T, κ 0 s • s = 0 := hD (fun n => μ n - ∑ s ∈ T, κ n s • s) hw
    rw [hμ0, sub_eq_zero] at h0
    rw [h0]
    exact Submodule.sum_smul_mem _ _ (fun s hs => Submodule.subset_span hs)
  exact ⟨hF0, hF1⟩

theorem wc_cover_boundary_ext0_free (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (Uo : (wcP1Over K).left.Opens)
    {V Y : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (qb : Y ⟶ (wcP1Over K).left) (hqb : IsFinite qb)
    (ιF : wcCoverSheaf (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ⟶
      wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ)
    (hmono : Mono ιF)
    (hsupp : ∀ W : (wcP1Over K).left.ProEt,
      (∀ (w : W.left) (i : Fin m), W.hom w ≠ S i (IsLocalRing.closedPoint K)) →
      ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left W) (Limits.cokernel ιF) 0, y = 0) :
    ∃ N : ℕ, Nonempty (wcCohG K (wcP1Over K) hP (Limits.cokernel ιF) 0 ≃+ (Fin N → ℤ_[ℓ])) :=
by
  classical

  let L : Finset (wcP1Over K).left :=
    Finset.univ.image (fun i : Fin m => S i (IsLocalRing.closedPoint K))
  have hLmem : ∀ j : Fin L.card, ∃ i : Fin m,
      S i (IsLocalRing.closedPoint K) = (L.equivFin.symm j : (wcP1Over K).left) := by
    intro j
    obtain ⟨i, -, hi⟩ := Finset.mem_image.mp (L.equivFin.symm j).2
    exact ⟨i, hi⟩
  choose ι hι using hLmem
  let S' : Fin L.card → (Spec (.of K) ⟶ (wcP1Over K).left) := fun j => S (ι j)
  have hS' : ∀ j, S' j ≫ (wcP1Over K).hom = 𝟙 _ := fun j => hS (ι j)
  have hSinj' : Function.Injective (fun j => S' j (IsLocalRing.closedPoint K)) := by
    intro j j' h
    have h' : (L.equivFin.symm j : (wcP1Over K).left) = L.equivFin.symm j' := by
      rw [← hι j, ← hι j']
      exact h
    exact L.equivFin.symm.injective (Subtype.ext h')
  have hcov : ∀ i : Fin m, ∃ j,
      S' j (IsLocalRing.closedPoint K) = S i (IsLocalRing.closedPoint K) := by
    intro i
    refine ⟨L.equivFin ⟨S i (IsLocalRing.closedPoint K),
      Finset.mem_image_of_mem _ (Finset.mem_univ i)⟩, ?_⟩
    show S (ι _) (IsLocalRing.closedPoint K) = _
    rw [hι, Equiv.symm_apply_apply]
  have hsupp' : ∀ W : (wcP1Over K).left.ProEt,
      (∀ (w : W.left) (j : Fin L.card), W.hom w ≠ S' j (IsLocalRing.closedPoint K)) →
      ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left W) (Limits.cokernel ιF) 0, y = 0 := by
    intro W hW
    apply hsupp W
    intro w i
    obtain ⟨j, hj⟩ := hcov i
    rw [← hj]
    exact hW w j

  choose Vn g φ A instCR instHen instSep e ε hx hφ hε1 hε2 using
    fun j : Fin L.card => wc_P1bar_strict_local_nbhd K (S' j) (hS' j) hP

  have hsplit := (wc_P1_punctual_coh K hP L.card S' hS' hSinj' (Limits.cokernel ιF) hsupp').2
    Vn A e hx g
  let τ₀ : wcCohG K (wcP1Over K) hP (Limits.cokernel ιF) 0 →+
      ((j : Fin L.card) →
        Abelian.Ext (wcFreeSheaf (wcP1Over K).left (Vn j)) (Limits.cokernel ιF) 0) :=
    AddMonoidHom.mk' (fun y j =>
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (g j))).comp y (zero_add 0))
      (fun y y' => funext fun j => Abelian.Ext.comp_add _ _ _ _)
  let e1 := AddEquiv.ofBijective τ₀ hsplit

  have hact_id : ∀ (h : 𝟙 Y ≫ qb = qb),
      wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ (𝟙 Y) h = 𝟙 _ := by
    intro h
    have hpb : wcPbAct qb (𝟙 Y) h = 𝟙 _ := by
      apply NatTrans.ext
      funext T
      simp only [wcPbAct, NatTrans.id_app]
      first
        | exact Limits.pullback.map_id
        | (apply Limits.pullback.hom_ext <;> simp [Limits.pullback.map] <;>
            exact (Category.id_comp _).symm)
    unfold wcCoverAct
    refine (congrArg (presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
      AddCommGrpCat.{u+1}).map ?_).trans
      ((presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}).map_id _)
    rw [hpb]
    ext T x
    apply Subtype.ext
    rfl

  have hloc : ∀ j, ∃ n : ℕ, Nonempty (Abelian.Ext (wcFreeSheaf (wcP1Over K).left (Vn j))
      (Limits.cokernel ιF) 0 ≃+ (Fin n → ℤ_[ℓ])) := by
    intro j
    have ha : 𝟙 Y ≫ qb = qb := Category.id_comp qb
    have hσD : Limits.cokernel.π ιF ≫ 𝟙 _ =
        wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ (𝟙 Y) ha ≫ Limits.cokernel.π ιF := by
      rw [Category.comp_id, hact_id ha, Category.id_comp]
    obtain ⟨Ψ, -, -⟩ := wc_cover_D_strict_eval K ℓ m S Uo q' qb (𝟙 Y) ha ιF hmono (𝟙 _) hσD
      (Vn j) (A j) (e j) (ι j) (hx j) (𝟙 _) (by simp) (by simp) (𝟙 (Vn j)) (𝟙 _)
      (by exact (Category.id_comp _).trans (Category.comp_id _).symm) (by simp)
    haveI := hqb
    have hfinQ : IsFinite (Limits.pullback.fst (Vn j).hom qb ≫ (e j).hom) := inferInstance
    obtain ⟨n, O, t, c, hop, hdisj, hcov', hsec⟩ := wc_finite_strict_henselian_pieces (A j)
      (Limits.pullback (Vn j).hom qb) (Limits.pullback.fst (Vn j).hom qb ≫ (e j).hom) hfinQ

    have hpc : ∀ i, PreconnectedSpace (O i) := by
      intro i
      have hclaim : ∀ s : Set (O i), IsClopen s → c i ∈ s → s = Set.univ := by
        intro s hs hcs
        let U : (O i).Opens := ⟨s, hs.isOpen⟩
        have hcU : c i ∈ Set.range U.ι := by
          rw [Scheme.Opens.range_ι]
          exact hcs
        obtain ⟨σ, hσ⟩ := hsec i U.toScheme U.ι inferInstance hcU
        apply Set.eq_univ_of_forall
        intro x
        have hx' : U.ι (σ x) = x := by
          have h := congrArg (fun f : O i ⟶ O i => f x) hσ
          simpa using h
        have hmem : U.ι (σ x) ∈ Set.range U.ι := ⟨_, rfl⟩
        rw [Scheme.Opens.range_ι] at hmem
        rw [← hx']
        exact hmem
      rw [preconnectedSpace_iff_clopen]
      intro s hs
      by_cases hcs : c i ∈ s
      · exact Or.inr (hclaim s hs hcs)
      · left
        have h := hclaim sᶜ hs.compl hcs
        first | exact Set.compl_univ_iff.mp h | simpa using h

    have hopen : ∀ i, IsOpen (Set.range (t i)) := fun i => by
      haveI := hop i
      exact IsOpenImmersion.isOpen_range (t i)
    have hpre : ∀ i, _root_.IsPreconnected (Set.range (t i)) := fun i => by
      haveI := hpc i
      exact isPreconnected_range (t i).continuous
    have huniq : ∀ x i i', x ∈ Set.range (t i) → x ∈ Set.range (t i') → i = i' := by
      intro x i i' h h'
      by_contra hne
      exact Set.disjoint_left.mp (hdisj i i' hne) h h'
    have hconst : ∀ (h : C(↥(Limits.pullback (Vn j).hom qb), ℤ_[ℓ])) i x,
        x ∈ Set.range (t i) → h x = h (t i (c i)) := by
      intro h i x hx
      have hs := (hpre i).image h h.continuous.continuousOn
      exact hs.subsingleton (Set.mem_image_of_mem h hx)
        (Set.mem_image_of_mem h ⟨c i, rfl⟩)
    let Θ₀ : C(↥(Limits.pullback (Vn j).hom qb), ℤ_[ℓ]) →+ (Fin n → ℤ_[ℓ]) :=
      { toFun := fun h i => h (t i (c i))
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hbij : Function.Bijective Θ₀ := by
      constructor
      · intro h h' hh
        ext x
        obtain ⟨i, hi⟩ := hcov' x
        have := congrFun hh i
        rw [hconst h i x hi, hconst h' i x hi]
        exact this
      · intro v
        let idx : ↥(Limits.pullback (Vn j).hom qb) → Fin n := fun x => Classical.choose (hcov' x)
        have hidx : ∀ x, x ∈ Set.range (t (idx x)) := fun x => Classical.choose_spec (hcov' x)
        have hlc : IsLocallyConstant (fun x => v (idx x)) := by
          rw [IsLocallyConstant.iff_exists_open]
          intro x
          refine ⟨Set.range (t (idx x)), hopen _, hidx x, fun x' hx' => ?_⟩
          rw [huniq x' _ _ (hidx x') hx']
        refine ⟨⟨fun x => v (idx x), hlc.continuous⟩, ?_⟩
        funext i
        show v (idx (t i (c i))) = v i
        rw [huniq _ _ _ (hidx _) ⟨c i, rfl⟩]
    exact ⟨n, ⟨Ψ.trans (AddEquiv.ofBijective Θ₀ hbij)⟩⟩

  choose n hn using hloc
  refine ⟨∑ j, n j, ⟨?_⟩⟩
  let e2 := AddEquiv.piCongrRight (fun j => (hn j).some)
  let e3 : ((x : (j : Fin L.card) × Fin (n j)) → ℤ_[ℓ]) ≃+
      ((j : Fin L.card) → Fin (n j) → ℤ_[ℓ]) :=
    { Equiv.piCurry (fun _ _ => ℤ_[ℓ]) with map_add' := fun _ _ => rfl }
  let e4 : ((x : (j : Fin L.card) × Fin (n j)) → ℤ_[ℓ]) ≃+ (Fin (∑ j, n j) → ℤ_[ℓ]) :=
    AddEquiv.arrowCongr finSigmaFinEquiv (AddEquiv.refl ℤ_[ℓ])
  exact e1.trans (e2.trans (e3.symm.trans e4))

theorem wc_cover_proper_pushforward_ext (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Yo : Over (Spec (.of K)))
    (qb : Yo.left ⟶ (wcP1Over K).left) (hqb : IsFinite qb)
    (hYo : Yo.hom = qb ≫ (wcP1Over K).hom)
    (hU : WeaklyEtale (Limits.pullback.fst Yo.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))) (n : ℕ) :
    Nonempty (wcCohG K (wcP1Over K) hP (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) n ≃+
      wcCohG K Yo hU (wcIntSheaf Yo.left ℓ) n) :=
by
  classical

  have transport : ∀ (S : Scheme.{u}) {P P' A A' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
      (_φ : P' ≅ P) (_κ : A ≅ A') (n : ℕ), Nonempty (Abelian.Ext P A n ≃+ Abelian.Ext P' A' n) := by
    intro S P P' A A' φ κ n
    refine ⟨{ toFun := fun x => (Abelian.Ext.mk₀ φ.hom).comp
                (x.comp (Abelian.Ext.mk₀ κ.hom) (add_zero n)) (zero_add n),
              invFun := fun y => (Abelian.Ext.mk₀ φ.inv).comp
                (y.comp (Abelian.Ext.mk₀ κ.inv) (add_zero n)) (zero_add n),
              left_inv := ?_, right_inv := ?_, map_add' := ?_ }⟩
    · intro x
      simp only [Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero,
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Iso.hom_inv_id,
        Abelian.Ext.mk₀_id_comp, Abelian.Ext.comp_mk₀_id]
    · intro y
      simp only [Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero,
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Iso.hom_inv_id,
        Abelian.Ext.mk₀_id_comp, Abelian.Ext.comp_mk₀_id]
    · intro x y
      simp only [Abelian.Ext.add_comp, Abelian.Ext.comp_add]

  have hκ : Nonempty (wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ ≅
      (wcProEtPush qb).obj (wcIntSheaf Yo.left ℓ)) := by
    have htop : ∀ T, wcExtZeroSub (wcCoverBasePre qb ℓ)
        (fun T : (wcP1Over K).left.ProEt => ∀ t : ((𝟭 Scheme).obj T.left),
          T.hom t ∉ (∅ : Set (wcP1Over K).left)) T = ⊤ := fun T => by
      unfold wcExtZeroSub
      exact iSup_pos (fun t => Set.notMem_empty _)
    let κ1 : wcExtZeroPre (wcCoverBasePre qb ℓ)
        (fun T : (wcP1Over K).left.ProEt => ∀ t : ((𝟭 Scheme).obj T.left),
          T.hom t ∉ (∅ : Set (wcP1Over K).left))
        (fun g h t => by rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]; exact h _) ≅
        (wcProEtBaseChange qb).op ⋙ (wcIntSheaf Yo.left ℓ).obj :=
      NatIso.ofComponents (fun T => (AddEquiv.ofBijective
        (wcExtZeroSub (wcCoverBasePre qb ℓ)
          (fun T : (wcP1Over K).left.ProEt => ∀ t : ((𝟭 Scheme).obj T.left),
            T.hom t ∉ (∅ : Set (wcP1Over K).left)) T).subtype
        ⟨Subtype.val_injective, fun x =>
          ⟨⟨x, by rw [htop T]; exact AddSubgroup.mem_top x⟩, rfl⟩⟩).toAddCommGrpIso)
        (fun g => by ext x; rfl)
    exact ⟨(presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}).mapIso κ1⟩

  haveI hproper : IsProper (wcP1Over K).hom := wc_proj_space_isProper K 1
  haveI : IsLocallyNoetherian (wcP1Over K).left :=
    @LocallyOfFiniteType.isLocallyNoetherian _ _ (wcP1Over K).hom
      (@IsProper.toLocallyOfFiniteType _ _ _ hproper) inferInstance
  haveI : IsFinite qb := hqb
  haveI : LocallyOfFinitePresentation qb := inferInstance

  haveI hc : (wcProEtBC qb).IsContinuous (Scheme.ProEt.topology (wcP1Over K).left)
      (Scheme.ProEt.topology Yo.left) :=
    (wc_proet_pullback_continuous_flat qb).1
  have hsplit : ∀ (V : (wcP1Over K).left.ProEt) (T : Sieve ((wcProEtBC qb).obj V)),
      T ∈ Scheme.ProEt.topology Yo.left ((wcProEtBC qb).obj V) →
      ∃ R : Presieve V, Sieve.generate R ∈ Scheme.ProEt.topology (wcP1Over K).left V ∧
        ∀ ⦃W : (wcP1Over K).left.ProEt⦄ (f : W ⟶ V), R f →
          ∃ (n : ℕ) (P : Fin n → Yo.left.ProEt) (ι : ∀ k, P k ⟶ (wcProEtBC qb).obj W),
            (∀ k, IsOpenImmersion (ι k).left) ∧
            (∀ x : ((wcProEtBC qb).obj W).left, ∃! k, x ∈ Set.range ⇑(ι k).left) ∧
            ∀ k, T (ι k ≫ (wcProEtBC qb).map f) := by
    intro V T hT
    refine ⟨fun (W : (wcP1Over K).left.ProEt) (_ : W ⟶ V) => IsAffine W.left ∧
        (IsClosed {x : W.left | IsClosed ({x} : Set W.left)} ∧
        (∀ x : W.left, ∃! y : W.left, IsClosed ({y} : Set W.left) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : W.left | IsClosed ({x} : Set W.left)} ∧
        (∀ x : W.left, IsClosed ({x} : Set W.left) →
          HenselianLocalRing (W.left.presheaf.stalk x) ∧ IsSepClosed (W.left.residueField x))),
      wc_proet_cover_of_affine_local (fun Δ => IsClosed {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, ∃! y : Δ, IsClosed ({y} : Set Δ) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, IsClosed ({x} : Set Δ) →
          HenselianLocalRing (Δ.presheaf.stalk x) ∧ IsSepClosed (Δ.residueField x)))
        (fun V₀ hV₀ => wc_exists_wcontractible_cover V₀ hV₀) V, ?_⟩
    intro W f hRf
    obtain ⟨hWa, q1, q2, q3, q4⟩ := hRf
    haveI : IsAffine W.left := hWa
    haveI : IsAffine ((𝟭 Scheme.{u}).obj W.left) := hWa
    have hUa : IsAffine (Limits.pullback W.hom qb) :=
      isAffine_of_isAffineHom (Limits.pullback.fst W.hom qb)
    obtain ⟨r1, r2, r3, r4⟩ :=
      wc_wlocal_strictHensel_finite_stable (Limits.pullback.fst W.hom qb) hWa q1 q2 q3 q4
    have hRET := wc_wlocal_strictHensel_retraction (Limits.pullback W.hom qb) hUa r1 r2 r3 r4
    have hT' : T.pullback ((wcProEtBC qb).map f) ∈
        Scheme.ProEt.topology Yo.left ((wcProEtBC qb).obj W) :=
      (Scheme.ProEt.topology Yo.left).pullback_stable _ hT
    obtain ⟨n, P, fk, hPa, hTfk, hsurj⟩ :=
      wc_proet_cover_affine_finite_refine ((wcProEtBC qb).obj W) hUa _ hT'
    obtain ⟨m, Q, ι, hopen, huniq, hfac⟩ :=
      wc_ret_disjoint_open_refine ((wcProEtBC qb).obj W) hUa hRET n P fk hPa hsurj
    refine ⟨m, Q, ι, hopen, huniq, fun j => ?_⟩
    obtain ⟨k, h, hh⟩ := hfac j
    have hj := (T.pullback ((wcProEtBC qb).map f)).downward_closed (hTfk k) h
    rw [hh] at hj
    exact hj
  haveI hepi := wc_sheafPushforward_preservesEpi_of_split (wcProEtBC qb) hsplit
  haveI hlim : Limits.PreservesFiniteLimits ((wcProEtBC qb).sheafPushforwardContinuous
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology (wcP1Over K).left)
      (Scheme.ProEt.topology Yo.left)) :=
    inferInstance
  haveI : ((wcProEtBC qb).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology (wcP1Over K).left)
      (Scheme.ProEt.topology Yo.left)).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_preserves_terminal_object
  haveI : ((wcProEtBC qb).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology (wcP1Over K).left) (Scheme.ProEt.topology Yo.left)).Additive :=
    Functor.additive_of_preserves_binary_products _
  haveI : ((wcProEtBC qb).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology (wcP1Over K).left)
      (Scheme.ProEt.topology Yo.left)).PreservesHomology :=
    Functor.preservesHomology_of_preservesEpis_and_kernels _
  haveI hcolim : Limits.PreservesFiniteColimits ((wcProEtBC qb).sheafPushforwardContinuous
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology (wcP1Over K).left)
      (Scheme.ProEt.topology Yo.left)) :=
    Functor.preservesFiniteColimits_of_preservesHomology _
  have eIso : wcProEtPush qb ≅
      (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC qb) AddCommGrpCat.{u+1} _
        (Scheme.ProEt.topology (wcP1Over K).left) (Scheme.ProEt.topology Yo.left) hc) :=
    Functor.isoWhiskerRight (Functor.sheafPushforwardContinuousCompSheafToPresheafIso (wcProEtBC qb)
        AddCommGrpCat.{u+1} (Scheme.ProEt.topology (wcP1Over K).left)
        (Scheme.ProEt.topology Yo.left)).symm
        (presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) ≪≫
      Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft _ (asIso (sheafificationAdjunction
        (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}).counit) ≪≫
      Functor.rightUnitor _
  haveI hPushC : Limits.PreservesFiniteColimits (wcProEtPush qb) :=
    Limits.preservesFiniteColimits_of_natIso eIso.symm

  obtain ⟨L, adj, hL, θ, -⟩ := wc_proet_push_left_adjoint_free_nat qb
  haveI := hL
  haveI : L.PreservesMonomorphisms := inferInstance
  haveI : Limits.PreservesLimits (wcProEtPush qb) := adj.rightAdjoint_preservesLimits
  haveI : Limits.PreservesFiniteLimits (wcProEtPush qb) :=
    Limits.PreservesLimitsOfSize.preservesFiniteLimits _
  haveI : (wcProEtPush qb).PreservesZeroMorphisms :=
    @Functor.preservesZeroMorphisms_of_isRightAdjoint _ _ _ _ _ _ (wcProEtPush qb) adj.isRightAdjoint
  haveI : (wcProEtPush qb).Additive := Functor.additive_of_preserves_binary_products _

  set P := wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP) with hPdef
  set A := wcIntSheaf Yo.left ℓ with hAdef
  have hbij := wc_ext_adjoint_transfer L (wcProEtPush qb) adj P A n
  let f2 : Abelian.Ext (L.obj P) A n →+ Abelian.Ext P ((wcProEtPush qb).obj A) n :=
    AddMonoidHom.mk' (fun e => (Abelian.Ext.mk₀ (adj.unit.app P)).comp
      (Abelian.Ext.mapExactFunctor (wcProEtPush qb) e) (zero_add n))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add])
  have hf2 : Function.Bijective f2 := hbij

  obtain ⟨e, -⟩ := wc_geomPoint_pullback_iso K (wcP1Over K) Yo (Over.homMk qb hYo.symm) hP hU
  let ψ : wcFreeSheaf Yo.left (wcGeomPoint K Yo hU) ≅ L.obj P :=
    (presheafToSheaf (Scheme.ProEt.topology Yo.left) AddCommGrpCat.{u+1}).mapIso
      (Functor.isoWhiskerRight (yoneda.mapIso e) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≪≫
      (θ (wcGeomPoint K (wcP1Over K) hP)).symm
  obtain ⟨κ⟩ := hκ
  obtain ⟨E1⟩ := transport (wcP1Over K).left (Iso.refl P) κ n
  obtain ⟨E3⟩ := transport Yo.left ψ (Iso.refl A) n
  exact ⟨E1.trans ((AddEquiv.ofBijective f2 hf2).symm.trans E3)⟩

theorem wc_curve_int_ext_fg_van (K : Type u) [Field K] [Finite K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : ¬ ℓ ∣ Nat.card K) (Yo : Over (Spec (.of K))) [IsProper Yo.hom]
    [SmoothOfRelativeDimension 1 Yo.hom]
    (hU : WeaklyEtale (Limits.pullback.fst Yo.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))) :
    (∀ n, ∃ T : Finset (wcCohG K Yo hU (wcIntSheaf Yo.left ℓ) n),
      ∀ x, ∃ t ∈ T, ∃ x', x = t + ℓ • x') ∧
    (∀ n (w : ℕ → wcCohG K Yo hU (wcIntSheaf Yo.left ℓ) n),
      (∀ k, w k = ℓ • w (k + 1)) → w 0 = 0) ∧
    (∀ n, 3 ≤ n → ∀ x : wcCohG K Yo hU (wcIntSheaf Yo.left ℓ) n, x = 0) :=
by
  classical

  have hℓK : (ℓ : K) ≠ 0 := by
    intro h0
    haveI := Fintype.ofFinite K
    have hp : (ringChar K).Prime := CharP.char_is_prime K (ringChar K)
    have h1 : ringChar K ∣ ℓ := (CharP.cast_eq_zero_iff K (ringChar K) ℓ).mp h0
    have hpl : ringChar K = ℓ := (Nat.prime_dvd_prime_iff_eq hp (Fact.out : ℓ.Prime)).mp h1
    have h2 : ringChar K ∣ Nat.card K := (CharP.cast_eq_zero_iff K (ringChar K) _).mp (by
      rw [Nat.card_eq_fintype_card]; exact FiniteField.cast_card_eq_zero K)
    exact hℓ (hpl ▸ h2)
  have hℓKb : (ℓ : AlgebraicClosure K) ≠ 0 := by
    rw [← map_natCast (algebraMap K (AlgebraicClosure K)) ℓ]
    exact (map_ne_zero _).mpr hℓK
  have hpow : ∀ e : ℕ, ((ℓ ^ e : ℕ) : AlgebraicClosure K) ≠ 0 := by
    intro e
    rw [Nat.cast_pow]
    exact pow_ne_zero e hℓKb

  let Y := Yo.left
  let U := wcGeomPoint K Yo hU
  let f : U.left ⟶ Spec (.of (AlgebraicClosure K)) :=
    Limits.pullback.snd Yo.hom (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
  haveI hfP : IsProper f := by
    show IsProper (Limits.pullback.snd Yo.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
    infer_instance
  haveI hfS : SmoothOfRelativeDimension 1 f := by
    haveI := smoothOfRelativeDimension_isStableUnderBaseChange 1
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1)
      (IsPullback.of_hasPullback Yo.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) ‹_›
  have hdim : topologicalKrullDim U.left ≤ ((1 : ℕ) : WithBot ℕ∞) :=
    wc_smooth_alg_closed_dim_le (AlgebraicClosure K) U.left f 1

  have hfinZ : ∀ e k : ℕ, Finite (Abelian.Ext (wcFreeSheaf Y U)
      (wcContSheaf Y (ZMod (ℓ ^ e))) k) := by
    intro e k
    obtain ⟨E1⟩ := wc_ext_free_slice_cont Y U (ZMod (ℓ ^ e)) k
    obtain ⟨E2⟩ := wc_proet_etale_comparison_zmod (AlgebraicClosure K) U.left f (ℓ ^ e) k
    haveI := wc_etale_proper_finite (AlgebraicClosure K) U.left f (ℓ ^ e) (hpow e) k
    have h2 : Finite (Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))
        (wcZModSheaf U.left (ℓ ^ e)) k) := Finite.of_equiv _ E2.symm
    have h2' : Finite (Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))
        (wcContSheaf U.left (ZMod (ℓ ^ e))) k) := h2
    exact Finite.of_equiv _ E1.symm

  have hRD : ∀ i : ℕ,
      (∃ T : Finset (Abelian.Ext (wcFreeSheaf Y U) (wcIntSheaf Y ℓ) i),
        ∀ x, ∃ t ∈ T, ∃ x', x = t + ℓ • x') ∧
      (∀ w : ℕ → Abelian.Ext (wcFreeSheaf Y U) (wcIntSheaf Y ℓ) i,
        (∀ k, w k = ℓ • w (k + 1)) → w 0 = 0) := by
    intro i
    have hsepi := wc_int_ext_separated_of_finite Y (wcFreeSheaf Y U) ℓ hfinZ i
    have hGfin : Finite (Abelian.Ext (wcFreeSheaf Y U)
        (Limits.cokernel (wcIntScalar Y ℓ (ℓ : ℤ_[ℓ]))) i) := by
      have e0 := wc_int_coker_zmod Y ℓ 1 (ℓ : ℤ_[ℓ]) (pow_one _).symm
      obtain ⟨e⟩ := e0
      let E₁ : Abelian.Ext (wcFreeSheaf Y U)
          (Limits.cokernel (wcIntScalar Y ℓ (ℓ : ℤ_[ℓ]))) i ≃
          Abelian.Ext (wcFreeSheaf Y U) (wcZModSheaf Y (ℓ ^ 1)) i :=
        { toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero i)
          invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero i)
          left_inv := fun x => by
            simp only
            rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
              Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
          right_inv := fun y => by
            simp only
            rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
              Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }
      have h1 : Finite (Abelian.Ext (wcFreeSheaf Y U) (wcZModSheaf Y (ℓ ^ 1)) i) := hfinZ 1 i
      exact Finite.of_equiv _ E₁.symm
    obtain ⟨hs1, hsmul, hsadd, -⟩ := wc_int_scalar_ring Y ℓ
    let M := Abelian.Ext (wcFreeSheaf Y U) (wcIntSheaf Y ℓ) i
    letI smulM : SMul ℤ_[ℓ] M :=
      ⟨fun a m => m.comp (Abelian.Ext.mk₀ (wcIntScalar Y ℓ a)) (add_zero i)⟩
    have A1 : ∀ x : M, x.comp (Abelian.Ext.mk₀ (wcIntScalar Y ℓ 1)) (add_zero i) = x := by
      intro x; rw [hs1, Abelian.Ext.comp_mk₀_id]
    have Amul : ∀ (a b : ℤ_[ℓ]) (x : M),
        x.comp (Abelian.Ext.mk₀ (wcIntScalar Y ℓ (a * b))) (add_zero i) =
        (x.comp (Abelian.Ext.mk₀ (wcIntScalar Y ℓ b)) (add_zero i)).comp
          (Abelian.Ext.mk₀ (wcIntScalar Y ℓ a)) (add_zero i) := by
      intro a b x
      rw [hsmul, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc _ _ _ (add_zero i)
        (add_zero 0) (by omega)]
    have Aadd : ∀ (a b : ℤ_[ℓ]) (x : M),
        x.comp (Abelian.Ext.mk₀ (wcIntScalar Y ℓ (a + b))) (add_zero i) =
        x.comp (Abelian.Ext.mk₀ (wcIntScalar Y ℓ a)) (add_zero i) +
          x.comp (Abelian.Ext.mk₀ (wcIntScalar Y ℓ b)) (add_zero i) := by
      intro a b x
      rw [hsadd, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
    letI modM : Module ℤ_[ℓ] M := Module.ofMinimalAxioms
      (fun a x y => Abelian.Ext.add_comp x y _ _)
      (fun a b x => Aadd a b x)
      (fun a b x => Amul a b x)
      (fun x => A1 x)
    haveI hmono : Mono (wcIntScalar Y ℓ (ℓ : ℤ_[ℓ])) := wc_int_scalar_ell_mono Y ℓ
    let g := wcIntScalar Y ℓ (ℓ : ℤ_[ℓ])
    let S : ShortComplex (Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) :=
      ShortComplex.mk g (Limits.cokernel.π g) (Limits.cokernel.condition g)
    have hS : S.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel g) hmono inferInstance
    let β : M →+ Abelian.Ext (wcFreeSheaf Y U) (Limits.cokernel g) i :=
      (Abelian.Ext.mk₀ (Limits.cokernel.π g)).postcomp (wcFreeSheaf Y U) (add_zero i)
    have hT : ∃ T : Finset M, ∀ m : M, ∃ t ∈ T, ∃ m' : M, m = t + (ℓ : ℤ_[ℓ]) • m' := by
      have hfr : (Set.range β).Finite := Set.toFinite _
      let pre : Abelian.Ext (wcFreeSheaf Y U) (Limits.cokernel g) i → M :=
        fun y => if hy : ∃ m, β m = y then hy.choose else 0
      refine ⟨hfr.toFinset.image pre, fun m => ?_⟩
      refine ⟨pre (β m), Finset.mem_image_of_mem _ (hfr.mem_toFinset.mpr ⟨m, rfl⟩), ?_⟩
      have hpre : β (pre (β m)) = β m := by
        have hy : ∃ m', β m' = β m := ⟨m, rfl⟩
        simp only [pre, dif_pos hy]
        exact hy.choose_spec
      have h0 : (m - pre (β m)).comp (Abelian.Ext.mk₀ S.g) (add_zero i) = 0 := by
        change β (m - pre (β m)) = 0
        rw [map_sub, hpre, sub_self]
      obtain ⟨m', hm'⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS (m - pre (β m)) h0
      refine ⟨m', ?_⟩
      change m = pre (β m) + m'.comp (Abelian.Ext.mk₀ S.f) (add_zero i)
      rw [hm']
      abel
    have hD : ∀ w : ℕ → M, (∀ e, w e = (ℓ : ℤ_[ℓ]) • w (e + 1)) → w 0 = 0 := by
      intro w hw
      have hpw : ∀ e : ℕ, w 0 = ((ℓ : ℤ_[ℓ]) ^ e) • w e := by
        intro e
        induction e with
        | zero => rw [pow_zero, one_smul]
        | succ e ih => rw [ih, hw e, ← mul_smul, ← pow_succ]
      apply hsepi (w 0)
      intro e
      rw [hpw e]
      change ((w e).comp (Abelian.Ext.mk₀ (wcIntScalar Y ℓ ((ℓ : ℤ_[ℓ]) ^ e))) (add_zero i)).comp
        (Abelian.Ext.mk₀ (Limits.cokernel.π (wcIntScalar Y ℓ ((ℓ : ℤ_[ℓ]) ^ e)))) (add_zero i) = 0
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Limits.cokernel.condition, Abelian.Ext.mk₀_zero,
        Abelian.Ext.comp_zero]
    refine ⟨?_, ?_⟩
    · obtain ⟨T, hT⟩ := hT
      refine ⟨T, fun x => ?_⟩
      obtain ⟨t, ht, x', hx⟩ := hT x
      refine ⟨t, ht, x', ?_⟩
      rw [hx, Nat.cast_smul_eq_nsmul]
    · intro w hw
      exact hD w (fun k => by rw [Nat.cast_smul_eq_nsmul]; exact hw k)

  have hcpt : CompactSpace ↥U.left := QuasiCompact.compactSpace_of_compactSpace f
  have hqs : QuasiSeparatedSpace ↥U.left := quasiSeparatedSpace_of_quasiSeparated f
  have hT0 : ∀ (A : Type) [AddCommGroup A] [TopologicalSpace A] [DiscreteTopology A]
      [IsTopologicalAddGroup A], (∀ a : A, ∃ k : ℕ, ℓ ^ k • a = 0) →
      ∀ i : ℕ, 2 * 1 < i → ∀ z : Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))
        (wcContSheaf U.left A) i, z = 0 := by
    intro A _ _ _ _ hA i hi z
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology U.left) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    have het : ∀ ξ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology U.left)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
          ((constantSheaf (Scheme.smallEtaleTopology U.left) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} A))) i, ξ = 0 := by
      intro ξ
      obtain ⟨k, B, φ, y, htor, hy⟩ := wc_et_ext_torsion_colim_lift U.left hcpt hqs ℓ A hA i ξ
      have hy0 : y = 0 :=
        wc_et_cd_proper_torsion (AlgebraicClosure K) U.left f 1 hdim (ℓ ^ k) (hpow k) B htor i hi y
      rw [← hy, hy0, Abelian.Ext.zero_comp]
    obtain ⟨E3⟩ := wc_proet_etale_comparison_const (AlgebraicClosure K) U.left f
      (AddCommGrpCat.of (ULift.{u+1} A)) i
    have hpro : ∀ w : Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))
        ((constantSheaf (Scheme.ProEt.topology U.left) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} A))) i, w = 0 := by
      intro w
      exact E3.injective ((het (E3 w)).trans (het (E3 0)).symm)
    obtain ⟨e⟩ := wc_contSheaf_discrete_const U.left A
    have h1 : z.comp (Abelian.Ext.mk₀ e.hom) (add_zero i) = 0 := hpro _
    calc z = (z.comp (Abelian.Ext.mk₀ e.hom) (add_zero i)).comp (Abelian.Ext.mk₀ e.inv)
          (add_zero i) := by
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      _ = 0 := by rw [h1, Abelian.Ext.zero_comp]
  have hzmod : ∀ (k : ℕ) (a : ZMod (ℓ ^ k)), ℓ ^ k • a = 0 := by
    intro k a
    rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  have hvanZ : ∀ (k i : ℕ), 2 < i →
      ∀ y : Abelian.Ext (wcFreeSheaf Y U) (wcZModSheaf Y (ℓ ^ (k + 1))) i, y = 0 := by
    intro k i hi y
    obtain ⟨E1⟩ := wc_ext_free_slice_cont Y U (ZMod (ℓ ^ (k + 1))) i
    have hz := hT0 (ZMod (ℓ ^ (k + 1))) (fun a => ⟨k + 1, hzmod (k + 1) a⟩) i (by omega)
    let y' : Abelian.Ext (wcFreeSheaf Y U) (wcContSheaf Y (ZMod (ℓ ^ (k + 1)))) i := y
    show y' = 0
    exact E1.injective ((hz (E1 y')).trans (hz (E1 0)).symm)

  refine ⟨fun n => (hRD n).1, fun n w hw => (hRD n).2 w hw, ?_⟩
  intro n hn x
  obtain ⟨j, rfl⟩ : ∃ j, n = j + 1 := ⟨n - 1, by omega⟩
  exact wc_proet_int_ext_vanish_of_zmod_deg Y ℓ U j
    (fun k y => hvanZ k (j + 1) (by omega) y) x

theorem wc_ext_scalar_module {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] [HasExt 𝒜] {S : Type*}
    [CommRing S] {A : 𝒜} (lam : S → (A ⟶ A)) (hlam : wcRingAct lam) (P : 𝒜) (n : ℕ) :
    ∃ _ : Module S (Abelian.Ext P A n), ∀ (c : S) (x : Abelian.Ext P A n),
      c • x = x.comp (Abelian.Ext.mk₀ (lam c)) (add_zero n) :=
by
  obtain ⟨h1, hadd, hmul⟩ := hlam
  have h0 : lam 0 = 0 := by
    have h := hadd 0 0
    rw [add_zero] at h
    have h' : lam 0 + 0 = lam 0 + lam 0 := by rw [add_zero]; exact h
    exact (add_left_cancel h').symm
  refine ⟨{ smul := fun c x => x.comp (Abelian.Ext.mk₀ (lam c)) (add_zero n)
            one_smul := fun x => by
              show x.comp (Abelian.Ext.mk₀ (lam 1)) (add_zero n) = x
              rw [h1]
              exact Abelian.Ext.comp_mk₀_id x
            mul_smul := fun a b x => by
              show x.comp (Abelian.Ext.mk₀ (lam (a * b))) (add_zero n) =
                (x.comp (Abelian.Ext.mk₀ (lam b)) (add_zero n)).comp
                  (Abelian.Ext.mk₀ (lam a)) (add_zero n)
              rw [hmul a b, ← Abelian.Ext.mk₀_comp_mk₀]
              exact (Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 0) (by omega)).symm
            smul_zero := fun c => by
              show (0 : Abelian.Ext P A n).comp (Abelian.Ext.mk₀ (lam c)) (add_zero n) = 0
              exact Abelian.Ext.zero_comp _ _ _ _ _
            smul_add := fun c x y => by
              show (x + y).comp (Abelian.Ext.mk₀ (lam c)) (add_zero n) =
                x.comp (Abelian.Ext.mk₀ (lam c)) (add_zero n) +
                  y.comp (Abelian.Ext.mk₀ (lam c)) (add_zero n)
              exact Abelian.Ext.add_comp _ _ _ _
            add_smul := fun a b x => by
              show x.comp (Abelian.Ext.mk₀ (lam (a + b))) (add_zero n) =
                x.comp (Abelian.Ext.mk₀ (lam a)) (add_zero n) +
                  x.comp (Abelian.Ext.mk₀ (lam b)) (add_zero n)
              rw [hadd, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
            zero_smul := fun x => by
              show x.comp (Abelian.Ext.mk₀ (lam 0)) (add_zero n) = 0
              rw [h0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] }, fun c x => rfl⟩

theorem wc_cover_coh_fg_van (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α) (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
    (lamF : MonoidAlgebra ℤ_[ℓ] Γ → (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ⟶ wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
    (hlamF : wcRingAct lamF)
    (hlamFs : ∀ (g : Γ) (a : ℤ_[ℓ]), lamF (MonoidAlgebra.single g a) =
      wcCoverScal (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ a ≫
        wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ
          (α g⁻¹).hom (hα g⁻¹))
    (I : InjectiveResolution (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
    (lamI : MonoidAlgebra ℤ_[ℓ] Γ → (I.cocomplex ⟶ I.cocomplex))
    (hI : wcRingResSpec lamF I lamI) :
    wcFgVan (((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
          (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex (ComplexShape.up ℕ)).obj
          I.cocomplex)
      (fun r => ((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
          (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex (ComplexShape.up ℕ)).map
          (lamI r)) :=
by
  classical
  haveI : Finite Γ := hG.1
  letI : Fintype Γ := Fintype.ofFinite Γ

  have hsingle : ∀ {G : Type u} [Group G]
      {A : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      (lam : MonoidAlgebra ℤ_[ℓ] G → (A ⟶ A)), wcRingAct lam →
      wcRingAct (fun a : ℤ_[ℓ] => lam (MonoidAlgebra.single 1 a)) := by
    intro G _ A lam hl
    obtain ⟨h1, hadd, hmul⟩ := hl
    refine ⟨?_, fun x y => ?_, fun x y => ?_⟩
    · show lam (MonoidAlgebra.single 1 1) = _
      rw [← MonoidAlgebra.one_def]; exact h1
    · show lam (MonoidAlgebra.single 1 (x + y)) =
        lam (MonoidAlgebra.single 1 x) + lam (MonoidAlgebra.single 1 y)
      rw [MonoidAlgebra.single_add]; exact hadd _ _
    · show lam (MonoidAlgebra.single 1 (x * y)) =
        lam (MonoidAlgebra.single 1 y) ≫ lam (MonoidAlgebra.single 1 x)
      rw [← hmul, MonoidAlgebra.single_mul_single, mul_one]

  obtain ⟨Y, qb, jV, a, hqb, hprop, hsmooth, hjV, hpb, ha, hab⟩ :=
    wc_cover_compactify K m S hS Uo hUo q' Γ α hG hα 1
  obtain ⟨ιF, hmono, -, hsupp⟩ := wc_cover_excision_ses K ℓ m S Uo hUo q' qb jV hqb hjV hpb
    (α 1).hom (hα 1) a ha hab
  let Sc := ShortComplex.mk ιF (Limits.cokernel.π ιF) (Limits.cokernel.condition ιF)
  have hSc : Sc.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ιF) hmono
      (inferInstance : Epi (Limits.cokernel.π ιF))

  obtain ⟨ev, -, -⟩ := wc_free_ext0_eval (wcP1Over K).left
  have hDvan : ∀ j, 1 ≤ j → ∀ y : wcCohG K (wcP1Over K) hP Sc.X₃ j, y = 0 := by
    intro j hj y
    exact wc_proet_P1_finite_supp_ext_vanish K hP m S hS (Limits.cokernel ιF)
      (fun W hW s => by
        have h0 := hsupp W hW ((ev W _).symm s)
        rw [← (ev W _).apply_symm_apply s, h0, map_zero]) j hj y

  obtain ⟨hinj0, hex0, hexD, hex1, hsurj, hinj2⟩ :=
    wc_ext_les_vanishing_quotient (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
      Sc hSc hDvan
  let fA : ∀ n, wcCohG K (wcP1Over K) hP Sc.X₁ n →+ wcCohG K (wcP1Over K) hP Sc.X₂ n := fun n =>
    AddMonoidHom.mk' (fun x => x.comp (Abelian.Ext.mk₀ Sc.f) (add_zero n))
      (fun x y => Abelian.Ext.add_comp x y _ _)
  have hfAinj : ∀ n, 2 ≤ n → Function.Injective (fA n) := hinj2
  have hfAsurj : ∀ n, 1 ≤ n → Function.Surjective (fA n) := hsurj
  let b0 : wcCohG K (wcP1Over K) hP Sc.X₂ 0 →+ wcCohG K (wcP1Over K) hP Sc.X₃ 0 :=
    AddMonoidHom.mk' (fun x => x.comp (Abelian.Ext.mk₀ Sc.g) (add_zero 0))
      (fun x y => Abelian.Ext.add_comp x y _ _)
  let c0 : wcCohG K (wcP1Over K) hP Sc.X₃ 0 →+ wcCohG K (wcP1Over K) hP Sc.X₁ 1 :=
    AddMonoidHom.mk' (fun x => x.comp hSc.extClass (zero_add 1))
      (fun x y => Abelian.Ext.add_comp x y _ _)

  have hF := fun n => wc_ext_scalar_module (fun a : ℤ_[ℓ] => lamF (MonoidAlgebra.single 1 a))
    (hsingle lamF hlamF) (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) n
  choose modF hmodF using hF
  obtain ⟨lamG, hlamG, -, -⟩ := wc_cover_sheaf_ring_action qb (∅ : Set (wcP1Over K).left) ℓ
    PUnit.{u+1} 1 (fun _ => by rw [MonoidHom.one_apply]; exact Category.id_comp qb)
  have hGm := fun n => wc_ext_scalar_module (fun a : ℤ_[ℓ] => lamG (MonoidAlgebra.single 1 a))
    (hsingle lamG hlamG) (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) n
  choose modG _ using hGm
  obtain ⟨N, ⟨eD⟩⟩ := wc_cover_boundary_ext0_free K hP ℓ m S hS Uo q' qb hqb ιF hmono hsupp

  let Yo : Over (Spec (.of K)) := Over.mk (qb ≫ (wcP1Over K).hom)
  haveI : IsProper Yo.hom := hprop
  haveI : SmoothOfRelativeDimension 1 Yo.hom := hsmooth
  have hU : WeaklyEtale (Limits.pullback.fst Yo.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure K)
  have hEG := fun n => wc_cover_proper_pushforward_ext K hP ℓ Yo qb hqb rfl hU n
  have hG6 := wc_curve_int_ext_fg_van K ℓ hℓ Yo hU
  have hGr : ∀ n, ∃ T : Finset (wcCohG K (wcP1Over K) hP Sc.X₂ n),
      ∀ x, ∃ t ∈ T, ∃ x', x = t + ℓ • x' := by
    intro n
    obtain ⟨T, hT⟩ := hG6.1 n
    let eg := (hEG n).some
    refine ⟨T.image eg.symm, fun x => ?_⟩
    obtain ⟨t, ht, x', hx⟩ := hT (eg x)
    refine ⟨eg.symm t, Finset.mem_image_of_mem _ ht, eg.symm x', ?_⟩
    apply eg.injective
    rw [map_add, map_nsmul, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
    exact hx
  have hGd : ∀ n (w : ℕ → wcCohG K (wcP1Over K) hP Sc.X₂ n),
      (∀ k, w k = ℓ • w (k + 1)) → w 0 = 0 := by
    intro n w hw
    let eg := (hEG n).some
    have h1 := hG6.2.1 n (fun k => eg (w k)) (fun k => by
      show eg (w k) = ℓ • eg (w (k + 1))
      rw [hw k, map_nsmul])
    exact eg.injective (h1.trans (map_zero eg).symm)
  have hGv : ∀ n, 3 ≤ n → ∀ x : wcCohG K (wcP1Over K) hP Sc.X₂ n, x = 0 := by
    intro n hn x
    let eg := (hEG n).some
    exact eg.injective ((hG6.2.2 n hn (eg x)).trans (map_zero eg).symm)

  have h01 : @Module.Finite ℤ_[ℓ] (wcCohG K (wcP1Over K) hP Sc.X₁ 0) _ _ (modF 0) ∧
      @Module.Finite ℤ_[ℓ] (wcCohG K (wcP1Over K) hP Sc.X₁ 1) _ _ (modF 1) := by
    letI := modF 0
    letI := modF 1
    letI := modG 0
    letI : Module ℤ_[ℓ] (wcCohG K (wcP1Over K) hP Sc.X₃ 0) := AddEquiv.module ℤ_[ℓ] eD
    have hlinD : ∀ (c : ℤ_[ℓ]) (x : wcCohG K (wcP1Over K) hP Sc.X₃ 0), eD (c • x) = c • eD x :=
      fun c x => by
        first
          | exact eD.apply_symm_apply _
          | rfl
          | simp
    haveI : Module.Finite ℤ_[ℓ] (wcCohG K (wcP1Over K) hP Sc.X₃ 0) :=
      Module.Finite.equiv (eD.toLinearEquiv hlinD).symm
    exact wc_padic_fg_five_term ℓ (fA 0) b0 c0 (fA 1) hinj0 hex0 hexD hex1
      (hfAsurj 1 le_rfl) (hGr 0) (hGd 0) (hGr 1) (hGd 1)

  have hfinAll : ∀ n, @Module.Finite ℤ_[ℓ] (wcCohG K (wcP1Over K) hP Sc.X₁ n) _ _ (modF n) := by
    intro n
    match n with
    | 0 => exact h01.1
    | 1 => exact h01.2
    | n + 2 =>
      letI := modF (n + 2)
      have hs := hfAsurj (n + 2) (by omega)
      have hi := hfAinj (n + 2) (by omega)
      apply padic_fg_of_mod_ell_reps ℓ
      · obtain ⟨T, hT⟩ := hGr (n + 2)
        refine ⟨T.image (Function.surjInv hs), fun x => ?_⟩
        obtain ⟨t, ht, x', hx⟩ := hT (fA (n + 2) x)
        refine ⟨Function.surjInv hs t, Finset.mem_image_of_mem _ ht, Function.surjInv hs x', ?_⟩
        rw [Nat.cast_smul_eq_nsmul]
        apply hi
        rw [map_add, map_nsmul, Function.surjInv_eq hs, Function.surjInv_eq hs]
        exact hx
      · intro w hw
        have h1 := hGd (n + 2) (fun k => fA (n + 2) (w k)) (fun k => by
          show fA (n + 2) (w k) = ℓ • fA (n + 2) (w (k + 1))
          rw [hw k, Nat.cast_smul_eq_nsmul, map_nsmul])
        exact hi (h1.trans (map_zero _).symm)
  have hvan : ∀ n, 3 ≤ n → ∀ x : wcCohG K (wcP1Over K) hP Sc.X₁ n, x = 0 := by
    intro n hn x
    apply hfAinj n (by omega)
    rw [map_zero]
    exact hGv n hn _

  have hfg : ∀ n, ∃ (k : ℕ) (e : Fin k → wcCohG K (wcP1Over K) hP Sc.X₁ n),
      ∀ x : wcCohG K (wcP1Over K) hP Sc.X₁ n, ∃ c : Fin k → MonoidAlgebra ℤ_[ℓ] Γ,
        x = ∑ i, (e i).comp (Abelian.Ext.mk₀ (lamF (c i))) (add_zero n) := by
    intro n
    letI := modF n
    haveI := hfinAll n
    obtain ⟨k, e, he⟩ := Module.Finite.exists_fin (R := ℤ_[ℓ])
      (M := wcCohG K (wcP1Over K) hP Sc.X₁ n)
    refine ⟨k, e, fun x => ?_⟩
    have hx : x ∈ Submodule.span ℤ_[ℓ] (Set.range e) := by rw [he]; exact Submodule.mem_top
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ_[ℓ]).mp hx
    refine ⟨fun i => MonoidAlgebra.single 1 (c i), ?_⟩
    rw [← hc]
    exact Finset.sum_congr rfl (fun i _ => hmodF n (c i) (e i))
  exact wc_fgvan_of_ext_fg lamF I lamI hI.2.1 _ hfg hvan

theorem wc_three_term_model_exists (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Γ : Type u) [Group Γ] [Finite Γ]
    (D : CochainComplex AddCommGrpCat.{u+1} ℕ) (lamD : MonoidAlgebra ℤ_[ℓ] Γ → (D ⟶ D))
    (hD : wcRingAct lamD) (hfv : wcFgVan D lamD) :
    Nonempty (wcThreeTermModel D lamD) :=
by
  classical
  obtain ⟨h1, hadd, hmul⟩ := hD

  have E1one : ∀ n (x : D.X n), ((lamD 1).f n).hom x = x := by
    intro n x; rw [h1]; simp
  have E1add : ∀ n (a b : MonoidAlgebra ℤ_[ℓ] Γ) (x : D.X n),
      ((lamD (a + b)).f n).hom x = ((lamD a).f n).hom x + ((lamD b).f n).hom x := by
    intro n a b x; rw [hadd]; simp
  have E1mul : ∀ n (a b : MonoidAlgebra ℤ_[ℓ] Γ) (x : D.X n),
      ((lamD (a * b)).f n).hom x = ((lamD a).f n).hom (((lamD b).f n).hom x) := by
    intro n a b x; rw [hmul]; simp
  have hl0 : lamD 0 = 0 := by
    have h := hadd 0 0
    rw [add_zero] at h
    have h' := congrArg (fun f => f - lamD 0) h
    simpa using h'.symm
  have E1zero : ∀ n (x : D.X n), ((lamD 0).f n).hom x = 0 := by
    intro n x; rw [hl0]; simp

  have E2 : ∀ (i j : ℕ) (r : MonoidAlgebra ℤ_[ℓ] Γ) (x : D.X i),
      (D.d i j).hom (((lamD r).f i).hom x) = ((lamD r).f j).hom ((D.d i j).hom x) := by
    intro i j r x
    show ((lamD r).f i ≫ D.d i j).hom x = (D.d i j ≫ (lamD r).f j).hom x
    rw [(lamD r).comm]

  haveI : IsNoetherianRing (MonoidAlgebra ℤ_[ℓ] Γ) :=
    IsNoetherianRing.of_finite ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] Γ)
  have noeth : ∀ k : ℕ, IsNoetherian (MonoidAlgebra ℤ_[ℓ] Γ) (Fin k → MonoidAlgebra ℤ_[ℓ] Γ) :=
    fun k => isNoetherian_of_isNoetherianRing_of_finite _ _

  have lincomb : ∀ (n k : ℕ) (v : Fin k → D.X n),
      ∃ α : (Fin k → MonoidAlgebra ℤ_[ℓ] Γ) →+ D.X n,
        (∀ p, α p = ∑ i, ((lamD (p i)).f n).hom (v i)) ∧
        (∀ (r : MonoidAlgebra ℤ_[ℓ] Γ) p, α (r • p) = ((lamD r).f n).hom (α p)) := by
    intro n k v
    refine ⟨AddMonoidHom.mk' (fun p => ∑ i, ((lamD (p i)).f n).hom (v i)) ?_, fun p => rfl, ?_⟩
    · intro p q
      simp only [Pi.add_apply, E1add, Finset.sum_add_distrib]
    · intro r p
      simp only [AddMonoidHom.mk'_apply, Pi.smul_apply, smul_eq_mul, E1mul, map_sum]


  obtain ⟨k2, z2, hz2, hgen2⟩ := hfv.1 2
  have hz2' : ∀ i, (D.d 2 3).hom (z2 i) = 0 := hz2
  obtain ⟨α2, hα2, hl2⟩ := lincomb 2 k2 z2
  have hc2 : ∀ p, (D.d 2 3).hom (α2 p) = 0 := by
    intro p
    rw [hα2, map_sum]
    apply Finset.sum_eq_zero
    intro i _
    rw [E2, hz2' i, map_zero]
  have q2s : ∀ y, (D.d 2 3).hom y = 0 → ∃ p, ∃ w, (D.d 1 2).hom w = α2 p - y := by
    intro y hy
    obtain ⟨c, w, hw⟩ := hgen2 y hy
    have hw' : y = ∑ i, ((lamD (c i)).f 2).hom (z2 i) + (D.d 1 2).hom w := hw
    refine ⟨c, -w, ?_⟩
    rw [map_neg, hα2, hw']
    abel


  let K2 : Submodule (MonoidAlgebra ℤ_[ℓ] Γ) (Fin k2 → MonoidAlgebra ℤ_[ℓ] Γ) :=
    { carrier := {p | ∃ y : D.X 1, (D.d 1 2).hom y = α2 p}
      add_mem' := by
        rintro p q ⟨y, hy⟩ ⟨y', hy'⟩
        exact show ∃ y : D.X 1, (D.d 1 2).hom y = α2 (p + q) from
          ⟨y + y', by rw [map_add, map_add, hy, hy']⟩
      zero_mem' := show ∃ y : D.X 1, (D.d 1 2).hom y = α2 0 from
          ⟨0, by rw [map_zero, map_zero]⟩
      smul_mem' := by
        rintro r p ⟨y, hy⟩
        exact show ∃ y : D.X 1, (D.d 1 2).hom y = α2 (r • p) from
          ⟨((lamD r).f 1).hom y, by rw [E2, hy, hl2]⟩ }
  have hK2fg : K2.FG := by
    haveI := noeth k2
    exact IsNoetherian.noetherian K2
  obtain ⟨s, pj, hpj⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hK2fg
  have hpjK : ∀ j, ∃ y : D.X 1, (D.d 1 2).hom y = α2 (pj j) := by
    intro j
    have hj : pj j ∈ K2 := by
      rw [← hpj]
      exact Submodule.subset_span ⟨j, rfl⟩
    exact hj
  choose yj hyj using hpjK
  obtain ⟨t, w1, hw1, hgen1⟩ := hfv.1 1
  have hw1' : ∀ i, (D.d 1 2).hom (w1 i) = 0 := hw1
  let e : Fin (t + s) → (Fin k2 → MonoidAlgebra ℤ_[ℓ] Γ) :=
    Fin.addCases (motive := fun _ => Fin k2 → MonoidAlgebra ℤ_[ℓ] Γ) (fun _ => 0) pj
  let uv : Fin (t + s) → D.X 1 := Fin.addCases (motive := fun _ => D.X 1) w1 yj
  let d1 : (Fin (t + s) → MonoidAlgebra ℤ_[ℓ] Γ) →ₗ[MonoidAlgebra ℤ_[ℓ] Γ]
      (Fin k2 → MonoidAlgebra ℤ_[ℓ] Γ) := Fintype.linearCombination (MonoidAlgebra ℤ_[ℓ] Γ) e
  have hd1 : ∀ p, d1 p = ∑ i, p i • e i := fun p => Fintype.linearCombination_apply _ _ _
  obtain ⟨α1, hα1, hl1⟩ := lincomb 1 (t + s) uv
  have hu : ∀ i, (D.d 1 2).hom (uv i) = α2 (e i) := by
    intro i
    induction i using Fin.addCases with
    | left i =>
      simp only [uv, e, Fin.addCases_left]
      rw [hw1', map_zero]
    | right j =>
      simp only [uv, e, Fin.addCases_right]
      exact hyj j
  have hc1 : ∀ p, (D.d 1 2).hom (α1 p) = α2 (d1 p) := by
    intro p
    rw [hα1, map_sum, hd1, map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [E2, hu, hl2]
  have q2i : ∀ p, (∃ y, (D.d 1 2).hom y = α2 p) → ∃ p', d1 p' = p := by
    intro p hp
    have hpK : p ∈ K2 := hp
    rw [← hpj, Submodule.mem_span_range_iff_exists_fun] at hpK
    obtain ⟨c, hc⟩ := hpK
    refine ⟨Fin.addCases (motive := fun _ => MonoidAlgebra ℤ_[ℓ] Γ) (fun _ => 0) c, ?_⟩
    rw [hd1, Fin.sum_univ_add]
    simp only [e, Fin.addCases_left, Fin.addCases_right, smul_zero,
      Finset.sum_const_zero, zero_add]
    exact hc
  have q1s : ∀ y, (D.d 1 2).hom y = 0 → ∃ p, d1 p = 0 ∧ ∃ w, (D.d 0 1).hom w = α1 p - y := by
    intro y hy
    obtain ⟨c, w, hw⟩ := hgen1 y hy
    have hw' : y = ∑ i, ((lamD (c i)).f 1).hom (w1 i) + (D.d 0 1).hom w := hw
    refine ⟨Fin.addCases (motive := fun _ => MonoidAlgebra ℤ_[ℓ] Γ) c (fun _ => 0), ?_, -w, ?_⟩
    · rw [hd1, Fin.sum_univ_add]
      simp only [e, Fin.addCases_left, Fin.addCases_right, zero_smul, smul_zero,
        Finset.sum_const_zero, add_zero]
    · rw [hα1, Fin.sum_univ_add]
      simp only [uv, Fin.addCases_left, Fin.addCases_right, E1zero, Finset.sum_const_zero,
        add_zero, map_neg]
      rw [hw']
      abel


  let φ0 : MonoidAlgebra ℤ_[ℓ] Γ →+* AddMonoid.End (D.X 0) :=
    { toFun := fun r => ((lamD r).f 0).hom
      map_one' := AddMonoidHom.ext (fun x => E1one 0 x)
      map_mul' := fun a b => AddMonoidHom.ext (fun x => E1mul 0 a b x)
      map_zero' := AddMonoidHom.ext (fun x => E1zero 0 x)
      map_add' := fun a b => AddMonoidHom.ext (fun x => E1add 0 a b x) }
  letI : Module (MonoidAlgebra ℤ_[ℓ] Γ) (D.X 0) := Module.compHom (D.X 0) φ0
  let Ms : Submodule (MonoidAlgebra ℤ_[ℓ] Γ) (D.X 0 × (Fin (t + s) → MonoidAlgebra ℤ_[ℓ] Γ)) :=
    { carrier := {q | (D.d 0 1).hom q.1 = α1 q.2 ∧ d1 q.2 = 0}
      add_mem' := by
        rintro ⟨x, p⟩ ⟨x', p'⟩ ⟨hx1, hx2⟩ ⟨hx1', hx2'⟩
        exact show (D.d 0 1).hom (x + x') = α1 (p + p') ∧ d1 (p + p') = 0 from
          ⟨by rw [map_add, map_add, hx1, hx1'], by rw [map_add, hx2, hx2', add_zero]⟩
      zero_mem' := show (D.d 0 1).hom 0 = α1 0 ∧ d1 0 = 0 from
          ⟨by rw [map_zero, map_zero], map_zero d1⟩
      smul_mem' := by
        rintro r ⟨x, p⟩ ⟨hx1, hx2⟩
        exact show (D.d 0 1).hom (((lamD r).f 0).hom x) = α1 (r • p) ∧ d1 (r • p) = 0 from
          ⟨by rw [E2, hx1, hl1], by rw [map_smul, hx2, smul_zero]⟩ }
  obtain ⟨k0, z0, hz0, hgen0⟩ := hfv.1 0
  have hz0' : ∀ i, (D.d 0 1).hom (z0 i) = 0 := hz0
  have hd00 : D.d (0 - 1) 0 = 0 := D.shape _ _ (by rw [ComplexShape.up_Rel]; omega)
  have hker : Ms ⊓ LinearMap.ker (LinearMap.snd (MonoidAlgebra ℤ_[ℓ] Γ) (D.X 0)
      (Fin (t + s) → MonoidAlgebra ℤ_[ℓ] Γ)) =
      Submodule.span (MonoidAlgebra ℤ_[ℓ] Γ)
        (Set.range (fun i => ((z0 i : D.X 0), (0 : Fin (t + s) → MonoidAlgebra ℤ_[ℓ] Γ)))) := by
    apply le_antisymm
    · rintro ⟨x, p⟩ ⟨⟨hx1, hx2⟩, hx3⟩
      have hp : p = 0 := by simpa using hx3
      subst hp
      have hx : (D.d 0 1).hom x = 0 := hx1.trans (map_zero α1)
      obtain ⟨c, w, hw⟩ := hgen0 x hx
      have hw0 : (D.d (0 - 1) 0).hom w = 0 := by rw [hd00]; simp
      rw [hw0, add_zero] at hw
      rw [Submodule.mem_span_range_iff_exists_fun]
      refine ⟨c, ?_⟩
      ext
      · rw [Prod.fst_sum, hw]
        rfl
      · rw [Prod.snd_sum]
        simp
    · rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      rw [SetLike.mem_coe, Submodule.mem_inf]
      refine ⟨?_, LinearMap.mem_ker.mpr rfl⟩
      exact show (D.d 0 1).hom (z0 i) = α1 0 ∧ d1 0 = 0 from
        ⟨by rw [hz0', map_zero], map_zero d1⟩
  have hMsfg : Ms.FG := by
    apply Submodule.fg_of_fg_map_of_fg_inf_ker (LinearMap.snd (MonoidAlgebra ℤ_[ℓ] Γ) (D.X 0)
      (Fin (t + s) → MonoidAlgebra ℤ_[ℓ] Γ))
    · haveI := noeth (t + s)
      exact IsNoetherian.noetherian _
    · rw [hker]
      exact Submodule.fg_span (Set.finite_range _)
  haveI hMsfin : Module.Finite (MonoidAlgebra ℤ_[ℓ] Γ) Ms := Module.Finite.iff_fg.mpr hMsfg


  let d0' : Ms →ₗ[MonoidAlgebra ℤ_[ℓ] Γ] (Fin (t + s) → MonoidAlgebra ℤ_[ℓ] Γ) :=
    (LinearMap.snd (MonoidAlgebra ℤ_[ℓ] Γ) (D.X 0) (Fin (t + s) → MonoidAlgebra ℤ_[ℓ] Γ)).comp
      Ms.subtype
  let α0' : Ms →+ D.X 0 :=
    ((LinearMap.fst (MonoidAlgebra ℤ_[ℓ] Γ) (D.X 0) (Fin (t + s) → MonoidAlgebra ℤ_[ℓ] Γ)).comp
      Ms.subtype).toAddMonoidHom
  refine ⟨{
      M := ModuleCat.of (MonoidAlgebra ℤ_[ℓ] Γ) Ms
      fin := hMsfin
      a := t + s
      b := k2
      d0 := d0'
      d1 := d1
      α0 := α0'
      α1 := α1
      α2 := α2
      hdd := ?_
      hlin0 := ?_
      hlin1 := hl1
      hlin2 := hl2
      hc0 := ?_
      hc1 := hc1
      hc2 := hc2
      q0i := ?_
      q0s := ?_
      q1i := ?_
      q1s := q1s
      q2i := q2i
      q2s := q2s
      qhi := hfv.2 }⟩
  · intro x
    exact (x : Ms).2.2
  · intro r x
    rfl
  · intro x
    exact (x : Ms).2.1
  · intro x hx1 hx2
    exact Subtype.ext (Prod.ext hx2 hx1)
  · intro y hy
    refine ⟨(⟨(y, 0), show (D.d 0 1).hom y = α1 0 ∧ d1 0 = 0 from
      ⟨by rw [hy, map_zero], map_zero d1⟩⟩ : Ms), rfl, rfl⟩
  · rintro p hp ⟨y, hy⟩
    exact ⟨(⟨(y, p), show (D.d 0 1).hom y = α1 p ∧ d1 p = 0 from ⟨hy, hp⟩⟩ : Ms), rfl⟩

theorem wc_chmp_cover_nsmul_mono {X V : Scheme.{u}} (q : V ⟶ X) (Z : Set X) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (n : ℕ) (hn : 0 < n) : Mono (n • 𝟙 (wcCoverSheaf q Z ℓ)) :=
by
  classical
  have hn' : (n : ℤ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hn.ne'
  have key : ∀ (Y : Scheme.{u}) (w : ULift.{u+1} C(Y, ℤ_[ℓ])), n • w = 0 → w = 0 := by
    intro Y w h
    apply ULift.ext
    ext y
    have h0 : n • w.down = 0 := congrArg ULift.down h
    have h1 : (n • w.down) y = 0 := by rw [h0]; rfl
    rw [ContinuousMap.smul_apply, nsmul_eq_mul] at h1
    exact (mul_eq_zero.mp h1).resolve_left hn'
  set P := wcExtZeroPre (wcCoverBasePre q ℓ) (fun T : X.ProEt => ∀ t, T.hom t ∉ Z)
      (fun g h t => by rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]; exact h _)
    with hP
  have happ : ∀ T, Mono ((n • 𝟙 P).app T) := by
    intro T
    rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.mono_iff_injective,
      injective_iff_map_eq_zero]
    intro x hx
    have hx' : n • x = 0 := hx
    apply Subtype.ext
    have h2 : n • (x.1 : ULift.{u+1} C((wcPbFun q).obj T.unop, ℤ_[ℓ])) = 0 := by
      have := congrArg Subtype.val hx'
      exact this
    exact key ((wcPbFun q).obj T.unop) x.1 h2
  have hPmono : Mono (n • 𝟙 P) := NatTrans.mono_of_mono_app _
  have e : (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map (n • 𝟙 P) =
      n • 𝟙 ((presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).obj P) := by
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
  have hm : Mono ((presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
      (n • 𝟙 P)) := Functor.map_mono _ _
  rw [e] at hm
  exact hm

theorem wc_chmp_head_torsion_free (S : Scheme.{u})
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (ℓ : ℕ)
    (hG : Mono (ℓ • 𝟙 G)) (I : InjectiveResolution G) (U : S.ProEt) (R : Type u) [Ring R]
    (hR : ∀ r : R, ℓ • r = 0 → r = 0)
    (lamD : R → ((((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf S U))).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj I.cocomplex) ⟶
      (((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf S U))).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj I.cocomplex)))
    (T : wcThreeTermModel
      (((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf S U))).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj I.cocomplex) lamD) :
    ∀ x : T.M, ℓ • x = 0 → x = 0 :=
by
  intro x hx

  have h1 : T.d0 x = 0 := by
    have h : ℓ • T.d0 x = 0 := by rw [← map_nsmul, hx, map_zero]
    funext i
    apply hR
    have := congrFun h i
    simpa using this

  let y : wcFreeSheaf S U ⟶ I.cocomplex.X 0 := T.α0 x

  have h2 : y ≫ I.cocomplex.d 0 1 = 0 := by
    have h := T.hc0 x
    rw [h1, map_zero] at h
    exact h

  have h3 : ℓ • y = 0 := by
    have h : ℓ • T.α0 x = 0 := by rw [← map_nsmul, hx, map_zero]
    exact h

  let y' := I.exact₀.lift y h2
  have hy' : y' ≫ I.ι.f 0 = y := I.exact₀.lift_f y h2

  have hℓy' : ℓ • y' = 0 := by
    apply (cancel_mono (I.ι.f 0)).1
    rw [Preadditive.nsmul_comp, hy', h3, Limits.zero_comp]
  let e : ((CochainComplex.single₀ _).obj G).X 0 ≅ G :=
    HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 G
  have hz : (y' ≫ e.hom) ≫ (ℓ • 𝟙 G) = 0 ≫ (ℓ • 𝟙 G) := by
    rw [Preadditive.comp_nsmul, Category.comp_id, Limits.zero_comp, ← Preadditive.nsmul_comp,
      hℓy', Limits.zero_comp]
  have hz0 : y' ≫ e.hom = 0 := (cancel_mono _).1 hz
  have hy'0 : y' = 0 := by
    have : y' = (y' ≫ e.hom) ≫ e.inv := by
      erw [Category.assoc, e.hom_inv_id, Category.comp_id]
    rw [this, hz0, Limits.zero_comp]

  have hy0 : y = 0 := by rw [← hy', hy'0, Limits.zero_comp]
  exact T.q0i x h1 hy0

theorem wc_chmp_ext_free_vanish (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Γ : Type u) [Group Γ] [Finite Γ]
    (N : ModuleCat.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ)) (a k : ℕ) (hk : 2 ≤ k)
    (e : Abelian.Ext N (ModuleCat.of (MonoidAlgebra ℤ_[ℓ] Γ)
      (ULift.{u+1} (Fin a → MonoidAlgebra ℤ_[ℓ] Γ))) k) :
    e = 0 :=
by
  classical
  haveI : Fintype Γ := Fintype.ofFinite Γ
  obtain ⟨m, rfl⟩ : ∃ m, k = m + 1 + 1 := ⟨k - 2, by omega⟩

  have baer : ∀ (D : Type (u+1)) [AddCommGroup D] [Module ℤ_[ℓ] D],
      (∀ c : ℤ_[ℓ], c ≠ 0 → ∀ d : D, ∃ y : D, c • y = d) → Module.Injective ℤ_[ℓ] D := by
    intro D _ _ hdiv
    apply Module.Baer.injective
    intro I g
    by_cases hc : Submodule.IsPrincipal.generator I = 0
    · refine ⟨0, fun x hx => ?_⟩
      obtain ⟨t, rfl⟩ := (Submodule.IsPrincipal.mem_iff_eq_smul_generator I).mp hx
      have h0 : (⟨t • Submodule.IsPrincipal.generator I, hx⟩ : I) = 0 := by
        ext; simp [hc]
      rw [h0, map_zero, LinearMap.zero_apply]
    · obtain ⟨y, hy⟩ := hdiv _ hc (g ⟨_, Submodule.IsPrincipal.generator_mem I⟩)
      refine ⟨LinearMap.toSpanSingleton ℤ_[ℓ] D y, fun x hx => ?_⟩
      obtain ⟨t, rfl⟩ := (Submodule.IsPrincipal.mem_iff_eq_smul_generator I).mp hx
      rw [LinearMap.toSpanSingleton_apply, smul_assoc, hy, ← map_smul]
      rfl
  have hsmulQ : ∀ (c : ℤ_[ℓ]) (q : ℚ_[ℓ]), c • q = (c : ℚ_[ℓ]) * q := fun c q => by
    rw [Algebra.smul_def, PadicInt.algebraMap_apply]
  have hmk : ∀ z : ℤ_[ℓ], (Submodule.Quotient.mk (z : ℚ_[ℓ]) :
      ℚ_[ℓ] ⧸ LinearMap.range (Algebra.linearMap ℤ_[ℓ] ℚ_[ℓ])) = 0 := fun z =>
    (Submodule.Quotient.mk_eq_zero _).mpr
      ⟨z, by rw [Algebra.linearMap_apply, PadicInt.algebraMap_apply]⟩

  have divQ : ∀ c : ℤ_[ℓ], c ≠ 0 → ∀ d : ULift.{u+1} (Fin a → ℚ_[ℓ]), ∃ y, c • y = d := by
    intro c hc d
    have hc' : (c : ℚ_[ℓ]) ≠ 0 := by rwa [Ne, PadicInt.coe_eq_zero]
    refine ⟨⟨fun i => (c : ℚ_[ℓ])⁻¹ * d.down i⟩, ?_⟩
    apply ULift.ext
    funext i
    change c • ((c : ℚ_[ℓ])⁻¹ * d.down i) = d.down i
    rw [hsmulQ, ← mul_assoc, mul_inv_cancel₀ hc', one_mul]
  have divQ' : ∀ c : ℤ_[ℓ], c ≠ 0 → ∀ d : ULift.{u+1} (Fin a →
      ℚ_[ℓ] ⧸ LinearMap.range (Algebra.linearMap ℤ_[ℓ] ℚ_[ℓ])), ∃ y, c • y = d := by
    intro c hc d
    have hc' : (c : ℚ_[ℓ]) ≠ 0 := by rwa [Ne, PadicInt.coe_eq_zero]
    choose w hw using fun i => Submodule.Quotient.mk_surjective _ (d.down i)
    refine ⟨⟨fun i => Submodule.Quotient.mk ((c : ℚ_[ℓ])⁻¹ * w i)⟩, ?_⟩
    apply ULift.ext
    funext i
    change c • (Submodule.Quotient.mk ((c : ℚ_[ℓ])⁻¹ * w i) :
      ℚ_[ℓ] ⧸ LinearMap.range (Algebra.linearMap ℤ_[ℓ] ℚ_[ℓ])) = d.down i
    rw [← Submodule.Quotient.mk_smul, hsmulQ, ← mul_assoc, mul_inv_cancel₀ hc', one_mul, hw]

  haveI : Module.Injective ℤ_[ℓ] (ULift.{u+1} (Fin a → ℚ_[ℓ])) := baer _ divQ
  haveI : Module.Injective ℤ_[ℓ] (ULift.{u+1} (Fin a →
      ℚ_[ℓ] ⧸ LinearMap.range (Algebra.linearMap ℤ_[ℓ] ℚ_[ℓ]))) := baer _ divQ'
  haveI : Injective (ModuleCat.of ℤ_[ℓ] (ULift.{u+1} (Fin a → ℚ_[ℓ]))) :=
    Module.injective_object_of_injective_module ℤ_[ℓ] _
  haveI : Injective (ModuleCat.of ℤ_[ℓ] (ULift.{u+1} (Fin a →
      ℚ_[ℓ] ⧸ LinearMap.range (Algebra.linearMap ℤ_[ℓ] ℚ_[ℓ])))) :=
    Module.injective_object_of_injective_module ℤ_[ℓ] _
  have hI1 : Injective ((ModuleCat.coextendScalars.{0, u, u+1}
      (algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] Γ))).obj
      (ModuleCat.of ℤ_[ℓ] (ULift.{u+1} (Fin a → ℚ_[ℓ])))) :=
    Injective.injective_of_adjoint (ModuleCat.restrictCoextendScalarsAdj.{u+1, 0, u} _) _
  have hI2 : Injective ((ModuleCat.coextendScalars.{0, u, u+1}
      (algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] Γ))).obj
      (ModuleCat.of ℤ_[ℓ] (ULift.{u+1} (Fin a →
        ℚ_[ℓ] ⧸ LinearMap.range (Algebra.linearMap ℤ_[ℓ] ℚ_[ℓ]))))) :=
    Injective.injective_of_adjoint (ModuleCat.restrictCoextendScalarsAdj.{u+1, 0, u} _) _

  let toR : ↑((ModuleCat.restrictScalars (algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] Γ))).obj
      (ModuleCat.of (MonoidAlgebra ℤ_[ℓ] Γ) (MonoidAlgebra ℤ_[ℓ] Γ))) →
      MonoidAlgebra ℤ_[ℓ] Γ := fun s => s
  let ofR : MonoidAlgebra ℤ_[ℓ] Γ →
      ↑((ModuleCat.restrictScalars (algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] Γ))).obj
      (ModuleCat.of (MonoidAlgebra ℤ_[ℓ] Γ) (MonoidAlgebra ℤ_[ℓ] Γ))) := fun s => s
  let sg : Γ → ℤ_[ℓ] →
      ↑((ModuleCat.restrictScalars (algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] Γ))).obj
      (ModuleCat.of (MonoidAlgebra ℤ_[ℓ] Γ) (MonoidAlgebra ℤ_[ℓ] Γ))) :=
    fun g r => MonoidAlgebra.single g r
  have hsmulR : ∀ (c : ℤ_[ℓ]) (s : ↑((ModuleCat.restrictScalars
      (algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] Γ))).obj
      (ModuleCat.of (MonoidAlgebra ℤ_[ℓ] Γ) (MonoidAlgebra ℤ_[ℓ] Γ)))),
      toR (c • s) = MonoidAlgebra.single 1 c * toR s := by
    intro c s
    change (algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] Γ) c) * toR s = _
    rw [MonoidAlgebra.coe_algebraMap]
    rfl
  have hsg : ∀ (g : Γ) (c : ℤ_[ℓ]), c • sg g 1 = sg g c := by
    intro g c
    show toR (c • sg g 1) = toR (sg g c)
    rw [hsmulR]
    show MonoidAlgebra.single 1 c * MonoidAlgebra.single g 1 = MonoidAlgebra.single g c
    rw [MonoidAlgebra.single_mul_single, one_mul, mul_one]
  have extR : ∀ (M : ModuleCat.{u+1} ℤ_[ℓ])
      (φ₁ φ₂ : ↑((ModuleCat.restrictScalars
        (algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] Γ))).obj
        (ModuleCat.of (MonoidAlgebra ℤ_[ℓ] Γ) (MonoidAlgebra ℤ_[ℓ] Γ))) →ₗ[ℤ_[ℓ]] M),
      (∀ g : Γ, φ₁ (sg g 1) = φ₂ (sg g 1)) → φ₁ = φ₂ := by
    intro M φ₁ φ₂ h
    have key : ∀ x : MonoidAlgebra ℤ_[ℓ] Γ, φ₁ (ofR x) = φ₂ (ofR x) := by
      intro x
      induction x using MonoidAlgebra.induction_linear with
      | zero =>
        show φ₁ 0 = φ₂ 0
        rw [map_zero, map_zero]
      | add x y hx hy =>
        show φ₁ (ofR x + ofR y) = φ₂ (ofR x + ofR y)
        rw [map_add, map_add, hx, hy]
      | single g r =>
        show φ₁ (sg g r) = φ₂ (sg g r)
        rw [← hsg, map_smul, map_smul, h]
    apply LinearMap.ext
    intro s
    exact key (toR s)

  let ι₀ : ULift.{u+1} (Fin a → MonoidAlgebra ℤ_[ℓ] Γ) →
      (↑((ModuleCat.restrictScalars (algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] Γ))).obj
          (ModuleCat.of (MonoidAlgebra ℤ_[ℓ] Γ) (MonoidAlgebra ℤ_[ℓ] Γ))) →ₗ[ℤ_[ℓ]]
          ↑(ModuleCat.of ℤ_[ℓ] (ULift.{u+1} (Fin a → ℚ_[ℓ])))) := fun x =>
    { toFun := fun s => ⟨fun i => (((toR s * x.down i).coeff 1 : ℤ_[ℓ]) : ℚ_[ℓ])⟩
      map_add' := fun s t => by
        apply ULift.ext; funext i
        show ((((toR s + toR t) * x.down i).coeff 1 : ℤ_[ℓ]) : ℚ_[ℓ]) =
          (((toR s * x.down i).coeff 1 : ℤ_[ℓ]) : ℚ_[ℓ]) +
          (((toR t * x.down i).coeff 1 : ℤ_[ℓ]) : ℚ_[ℓ])
        rw [add_mul, MonoidAlgebra.coeff_add, Finsupp.add_apply, PadicInt.coe_add]
      map_smul' := fun c s => by
        apply ULift.ext; funext i
        show (((toR (c • s) * x.down i).coeff 1 : ℤ_[ℓ]) : ℚ_[ℓ]) =
          c • (((toR s * x.down i).coeff 1 : ℤ_[ℓ]) : ℚ_[ℓ])
        rw [hsmulR, mul_assoc, MonoidAlgebra.coeff_single_mul_apply, inv_one, one_mul,
          PadicInt.coe_mul, hsmulQ] }
  have hι₀ : ∀ x s i, ((ι₀ x s).down i : ℚ_[ℓ]) =
      (((toR s * x.down i).coeff 1 : ℤ_[ℓ]) : ℚ_[ℓ]) := fun _ _ _ => rfl
  have hrec : ∀ x i (h : Γ), ((ι₀ x (sg h⁻¹ 1)).down i : ℚ_[ℓ]) =
      (((x.down i).coeff h : ℤ_[ℓ]) : ℚ_[ℓ]) := by
    intro x i h
    rw [hι₀]
    show (((MonoidAlgebra.single h⁻¹ 1 * x.down i).coeff 1 : ℤ_[ℓ]) : ℚ_[ℓ]) = _
    rw [MonoidAlgebra.coeff_single_mul_apply, inv_inv, mul_one, one_mul]
  have ι₀add : ∀ x y, ι₀ (x + y) = ι₀ x + ι₀ y := by
    intro x y
    apply LinearMap.ext; intro s
    apply ULift.ext; funext i
    show (((toR s * (x.down i + y.down i)).coeff 1 : ℤ_[ℓ]) : ℚ_[ℓ]) =
      (((toR s * x.down i).coeff 1 : ℤ_[ℓ]) : ℚ_[ℓ]) +
      (((toR s * y.down i).coeff 1 : ℤ_[ℓ]) : ℚ_[ℓ])
    rw [mul_add, MonoidAlgebra.coeff_add, Finsupp.add_apply, PadicInt.coe_add]
  let E := ModuleCat.CoextendScalars.equiv (algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] Γ))
    (ModuleCat.of ℤ_[ℓ] (ULift.{u+1} (Fin a → ℚ_[ℓ])))
  let E' := ModuleCat.CoextendScalars.equiv (algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] Γ))
    (ModuleCat.of ℤ_[ℓ] (ULift.{u+1} (Fin a →
        ℚ_[ℓ] ⧸ LinearMap.range (Algebra.linearMap ℤ_[ℓ] ℚ_[ℓ]))))
  let ιlin : ULift.{u+1} (Fin a → MonoidAlgebra ℤ_[ℓ] Γ) →ₗ[MonoidAlgebra ℤ_[ℓ] Γ]
      ↑((ModuleCat.coextendScalars.{0, u, u+1}
        (algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] Γ))).obj
        (ModuleCat.of ℤ_[ℓ] (ULift.{u+1} (Fin a → ℚ_[ℓ])))) :=
    { toFun := fun x => E.symm (ι₀ x)
      map_add' := fun x y => by
        show E.symm (ι₀ (x + y)) = E.symm (ι₀ x) + E.symm (ι₀ y)
        rw [ι₀add, map_add]
      map_smul' := fun r x => by
        rw [RingHom.id_apply]
        apply E.injective
        rw [LinearEquiv.apply_symm_apply]
        apply LinearMap.ext; intro s
        erw [ModuleCat.CoextendScalars.smul_apply]
        rw [LinearEquiv.apply_symm_apply]
        apply ULift.ext; funext i
        show (((toR s * (r * x.down i)).coeff 1 : ℤ_[ℓ]) : ℚ_[ℓ]) =
          (((toR s * r * x.down i).coeff 1 : ℤ_[ℓ]) : ℚ_[ℓ])
        rw [mul_assoc] }
  have hιeq : ∀ x, E (ιlin x) = ι₀ x := fun x => LinearEquiv.apply_symm_apply _ _
  have hinj : Function.Injective ιlin := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    have h0 : ι₀ x = 0 := by rw [← hιeq, hx, map_zero]
    apply ULift.ext; funext i
    apply MonoidAlgebra.ext
    apply Finsupp.ext; intro h
    have := hrec x i h
    rw [h0, LinearMap.zero_apply] at this
    have h2 : ((x.down i).coeff h : ℚ_[ℓ]) = 0 := this.symm
    rw [PadicInt.coe_eq_zero] at h2
    exact h2

  let qlin : ULift.{u+1} (Fin a → ℚ_[ℓ]) →ₗ[ℤ_[ℓ]] ULift.{u+1} (Fin a →
      ℚ_[ℓ] ⧸ LinearMap.range (Algebra.linearMap ℤ_[ℓ] ℚ_[ℓ])) :=
    { toFun := fun x => ⟨fun i => Submodule.Quotient.mk (x.down i)⟩
      map_add' := fun x y => by
        apply ULift.ext; funext i
        exact Submodule.Quotient.mk_add _
      map_smul' := fun c x => by
        apply ULift.ext; funext i
        show (Submodule.Quotient.mk (c • x.down i) :
          ℚ_[ℓ] ⧸ LinearMap.range (Algebra.linearMap ℤ_[ℓ] ℚ_[ℓ])) =
          c • Submodule.Quotient.mk (x.down i)
        exact Submodule.Quotient.mk_smul _ c (x.down i) }
  have hq : ∀ x i, (qlin x).down i = Submodule.Quotient.mk (x.down i) := fun _ _ => rfl
  have qsurj : Function.Surjective qlin := by
    intro d
    choose w hw using fun i => Submodule.Quotient.mk_surjective _ (d.down i)
    exact ⟨⟨w⟩, ULift.ext _ _ (funext hw)⟩
  let qC := (ModuleCat.coextendScalars.{0, u, u+1}
        (algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] Γ))).map (ModuleCat.ofHom qlin)
  have hqC : ∀ φ s, E' (qC.hom φ) s = qlin (E φ s) := fun φ s =>
    ModuleCat.CoextendScalars.map_apply _ _ _ _

  have hback : ∀ x, qC.hom (ιlin x) = 0 := by
    intro x
    apply E'.injective
    rw [map_zero]
    apply LinearMap.ext; intro s
    rw [hqC, hιeq, LinearMap.zero_apply]
    apply ULift.ext; funext i
    rw [hq, hι₀]
    exact hmk _
  have hfwd : ∀ φ, qC.hom φ = 0 → ∃ x, ιlin x = φ := by
    intro φ hφ
    have hz : ∀ s i, ∃ z : ℤ_[ℓ], (z : ℚ_[ℓ]) = (E φ s).down i := by
      intro s i
      have h1 := congrArg (fun ψ => (E' ψ s).down i) hφ
      simp only at h1
      rw [hqC, map_zero, LinearMap.zero_apply, hq] at h1
      obtain ⟨z, hz⟩ := (Submodule.Quotient.mk_eq_zero _).mp h1
      exact ⟨z, by rw [← hz, Algebra.linearMap_apply, PadicInt.algebraMap_apply]⟩
    choose c hc using fun (i : Fin a) (h : Γ) => hz (sg h⁻¹ 1) i
    refine ⟨⟨fun i => MonoidAlgebra.ofCoeff (Finsupp.equivFunOnFinite.symm (c i))⟩, ?_⟩
    apply E.injective
    rw [hιeq]
    apply extR
    intro g
    apply ULift.ext; funext i
    rw [hι₀]
    show (((MonoidAlgebra.single g 1 * MonoidAlgebra.ofCoeff
      (Finsupp.equivFunOnFinite.symm (c i))).coeff 1 : ℤ_[ℓ]) : ℚ_[ℓ]) = _
    rw [MonoidAlgebra.coeff_single_mul_apply, one_mul, mul_one, MonoidAlgebra.coeff_ofCoeff]
    show ((c i g⁻¹ : ℤ_[ℓ]) : ℚ_[ℓ]) = _
    rw [hc, inv_inv]

  have hsurj : Function.Surjective qC.hom := by
    intro ψ
    choose y hy using fun g : Γ => qsurj (E' ψ (sg g 1))
    let φ₀ : ↑((ModuleCat.restrictScalars (algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] Γ))).obj
          (ModuleCat.of (MonoidAlgebra ℤ_[ℓ] Γ) (MonoidAlgebra ℤ_[ℓ] Γ))) →ₗ[ℤ_[ℓ]]
          ↑(ModuleCat.of ℤ_[ℓ] (ULift.{u+1} (Fin a → ℚ_[ℓ]))) :=
      { toFun := fun s => ∑ g, (toR s).coeff g • y g
        map_add' := fun s t => by
          show ∑ g, (toR s + toR t).coeff g • y g = _
          simp only [MonoidAlgebra.coeff_add, Finsupp.add_apply, add_smul,
            Finset.sum_add_distrib]
        map_smul' := fun c s => by
          show ∑ g, (toR (c • s)).coeff g • y g = c • ∑ g, (toR s).coeff g • y g
          rw [Finset.smul_sum]
          refine Finset.sum_congr rfl fun g _ => ?_
          rw [hsmulR, MonoidAlgebra.coeff_single_mul_apply, inv_one, one_mul, mul_smul] }
    refine ⟨E.symm φ₀, ?_⟩
    apply E'.injective
    apply extR
    intro g
    rw [hqC, LinearEquiv.apply_symm_apply]
    show qlin (∑ h, (MonoidAlgebra.single g (1 : ℤ_[ℓ])).coeff h • y h) = _
    rw [Finset.sum_eq_single g]
    · rw [MonoidAlgebra.coeff_single, Finsupp.single_eq_same, one_smul, hy]
    · intro h _ hne
      rw [MonoidAlgebra.coeff_single]
      first
        | rw [Finsupp.single_eq_of_ne hne, zero_smul]
        | rw [Finsupp.single_eq_of_ne (Ne.symm hne), zero_smul]
    · intro hg; exact absurd (Finset.mem_univ g) hg

  let S := ShortComplex.mk (ModuleCat.ofHom ιlin) qC (by
    apply ModuleCat.hom_ext
    apply LinearMap.ext; intro x
    exact hback x)
  have hS : S.ShortExact := by
    refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
    · rw [ShortComplex.moduleCat_exact_iff]
      intro x₂ hx₂
      exact hfwd x₂ hx₂
    · exact (ModuleCat.mono_iff_injective _).mpr hinj
    · exact (ModuleCat.epi_iff_surjective _).mpr hsurj

  have hx₁ : e.comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 :=
    @Abelian.Ext.eq_zero_of_injective _ _ _ _ N S.X₂ (m + 1) hI1 _
  obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ N hS e hx₁ (n₀ := m + 1) rfl
  have hx₃0 : x₃ = 0 := @Abelian.Ext.eq_zero_of_injective _ _ _ _ N S.X₃ m hI2 x₃
  rw [← hx₃, hx₃0, Abelian.Ext.zero_comp]

theorem wc_chmp_cone_ext_vanish {R : Type u} [Ring R] (D : CochainComplex AddCommGrpCat.{u+1} ℕ)
    (lamD : R → (D ⟶ D)) (hD : wcRingAct lamD) (T : wcThreeTermModel D lamD)
    (hinj : ∀ n, wcChmpInjD lamD n) (N : ModuleCat.{u+1} R) (hN : wcChmpVanD lamD N)
    (hfree : ∀ (a k : ℕ), 2 ≤ k →
      ∀ e : Abelian.Ext N (ModuleCat.of R (ULift.{u+1} (Fin a → R))) k, e = 0) :
    ∀ j, 4 ≤ j → ∀ e : Abelian.Ext N T.M j, e = 0 :=
by
  classical

  have h0 : lamD 0 = 0 := by
    have h := hD.2.1 0 0
    rw [add_zero] at h
    calc lamD 0 = lamD 0 + lamD 0 - lamD 0 := (add_sub_cancel_right _ _).symm
      _ = 0 := by rw [← h, sub_self]
  letI inst : ∀ n, Module R (D.X n) := fun n =>
    { smul := fun r x => ((lamD r).f n).hom x
      one_smul := fun x => by
        show ((lamD 1).f n).hom x = x
        rw [hD.1] <;> first | rfl | simp
      mul_smul := fun a b x => by
        show ((lamD (a * b)).f n).hom x = ((lamD a).f n).hom (((lamD b).f n).hom x)
        rw [hD.2.2] <;> first | rfl | simp
      smul_zero := fun r => map_zero _
      smul_add := fun r x y => map_add _ x y
      add_smul := fun a b x => by
        show ((lamD (a + b)).f n).hom x = ((lamD a).f n).hom x + ((lamD b).f n).hom x
        rw [hD.2.1] <;> first | rfl | simp
      zero_smul := fun x => by
        show ((lamD 0).f n).hom x = 0
        rw [h0] <;> first | rfl | simp }

  have hinjM : ∀ n, CategoryTheory.Injective (ModuleCat.of R (D.X n)) := by
    intro n
    refine ⟨?_⟩
    intro X Y g f hf
    have hfi : Function.Injective f.hom := (ModuleCat.mono_iff_injective f).mp hf
    obtain ⟨h, hh, hhf⟩ := hinj n X Y f hfi g.hom.toAddMonoidHom (fun r x => by
      show g.hom (r • x) = _
      rw [map_smul]
      rfl)
    refine ⟨ModuleCat.ofHom
      { toFun := fun y => h y
        map_add' := fun y z => h.map_add y z
        map_smul' := fun r y => hh r y }, ?_⟩
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    exact hhf x

  have shift : ∀ (S : ShortComplex (ModuleCat.{u+1} R)) (_ : S.ShortExact) (k : ℕ),
      (∀ e : Abelian.Ext N S.X₂ (k + 1), e = 0) → (∀ e : Abelian.Ext N S.X₃ k, e = 0) →
      ∀ e : Abelian.Ext N S.X₁ (k + 1), e = 0 := by
    intro S hS k h2 h3 x
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ N hS x (h2 _) rfl
    rw [← hx₃, h3 x₃, Abelian.Ext.zero_comp]
  have mid : ∀ (S : ShortComplex (ModuleCat.{u+1} R)) (_ : S.ShortExact) (k : ℕ),
      (∀ e : Abelian.Ext N S.X₁ k, e = 0) → (∀ e : Abelian.Ext N S.X₃ k, e = 0) →
      ∀ e : Abelian.Ext N S.X₂ k, e = 0 := by
    intro S hS k h1 h3 x
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ N hS x (h3 _)
    rw [← hx₁, h1 x₁, Abelian.Ext.zero_comp]

  have prod : ∀ (A B : Type (u+1)) [AddCommGroup A] [Module R A] [AddCommGroup B] [Module R B],
      CategoryTheory.Injective (ModuleCat.of R B) → ∀ k, 2 ≤ k →
      (∀ e : Abelian.Ext N (ModuleCat.of R A) k, e = 0) →
      ∀ e : Abelian.Ext N (ModuleCat.of R (A × B)) k, e = 0 := by
    intro A B _ _ _ _ hB k hk hA
    obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    let S : ShortComplex (ModuleCat.{u+1} R) :=
      ShortComplex.mk (ModuleCat.ofHom (LinearMap.inl R A B)) (ModuleCat.ofHom (LinearMap.snd R A B))
        (by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro x
          rfl)
    have hS : S.ShortExact :=
      { exact := by
          rw [ShortComplex.moduleCat_exact_iff]
          intro v hv
          refine ⟨v.1, ?_⟩
          exact Prod.ext rfl hv.symm
        mono_f := (ModuleCat.mono_iff_injective _).mpr (LinearMap.inl_injective)
        epi_g := (ModuleCat.epi_iff_surjective _).mpr (LinearMap.snd_surjective) }
    exact mid S hS (k' + 1) hA
      (fun e => @Abelian.Ext.eq_zero_of_injective _ _ _ _ _ _ k' hB e)

  have dd : ∀ (i j k : ℕ) (x : D.X i), (D.d j k).hom ((D.d i j).hom x) = 0 := by
    intro i j k x
    have := congrArg (fun g => AddCommGrpCat.Hom.hom g x) (D.d_comp_d i j k)
    first | exact this | simpa using this
  let dlin : ∀ i j : ℕ, D.X i →ₗ[R] D.X j := fun i j =>
    { toFun := fun x => (D.d i j).hom x
      map_add' := fun x y => map_add _ x y
      map_smul' := fun r x => congrArg (fun g => AddCommGrpCat.Hom.hom g x) ((lamD r).comm i j) }
  let dl : ∀ n : ℕ, D.X n →ₗ[R] D.X (n + 1) := fun n => dlin n (n + 1)
  have hdd : ∀ (n : ℕ) (x : D.X n), dl n x ∈ LinearMap.ker (dl (n + 1)) := fun n x =>
    dd n (n + 1) (n + 1 + 1) x

  let Sn : ℕ → ShortComplex (ModuleCat.{u+1} R) := fun n =>
    ShortComplex.mk (ModuleCat.ofHom (LinearMap.ker (dl n)).subtype)
      (ModuleCat.ofHom (LinearMap.codRestrict (LinearMap.ker (dl (n + 1))) (dl n) (hdd n)))
      (by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro z
        apply Subtype.ext
        exact z.2)
  have hSn : ∀ n, 2 ≤ n → (Sn n).ShortExact := by
    intro n hn
    refine { exact := ?_, mono_f := ?_, epi_g := ?_ }
    · rw [ShortComplex.moduleCat_exact_iff]
      intro x hx
      refine ⟨⟨x, ?_⟩, rfl⟩
      exact congrArg Subtype.val hx
    · exact (ModuleCat.mono_iff_injective _).mpr (LinearMap.ker (dl n)).injective_subtype
    · rw [ModuleCat.epi_iff_surjective]
      rintro ⟨y, hy⟩
      obtain ⟨w, hw⟩ := T.qhi (n + 1) (by omega) y hy
      exact ⟨w, Subtype.ext hw⟩
  have tail : ∀ m, 1 ≤ m → ∀ n, 2 ≤ n → 4 ≤ n + m →
      ∀ e : Abelian.Ext N (ModuleCat.of R (LinearMap.ker (dl n))) m, e = 0 := by
    intro m hm
    induction m, hm using Nat.le_induction with
    | base =>
      intro n hn hnm x₁
      have hS := hSn n (by omega)
      have hz : x₁.comp (Abelian.Ext.mk₀ (Sn n).f) (add_zero 1) = 0 :=
        @Abelian.Ext.eq_zero_of_injective _ _ _ _ _ _ 0 (hinjM n) _
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ N hS x₁ hz (zero_add 1)
      obtain ⟨φ, rfl⟩ : ∃ φ, Abelian.Ext.mk₀ φ = x₃ := ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply x₃⟩
      let f : N →+ D.X (n + 1) := ((LinearMap.ker (dl (n + 1))).subtype.comp φ.hom).toAddMonoidHom
      have hf : ∀ (r : R) (x : N), f (r • x) = ((lamD r).f (n + 1)).hom (f x) := by
        intro r x
        show ((φ.hom (r • x) : LinearMap.ker (dl (n + 1))) : D.X (n + 1)) = _
        rw [map_smul]
        rfl
      have hcoc : ∀ x : N, (D.d (n + 1) (n + 1 + 1)).hom (f x) = 0 := fun x => (φ.hom x).2
      obtain ⟨h, hhl, hh⟩ := hN (n + 1) (by omega) f hf hcoc
      let hl : N →ₗ[R] D.X n :=
        { toFun := fun x => h x
          map_add' := fun x y => h.map_add x y
          map_smul' := fun r x => hhl r x }
      have hφeq : φ = ModuleCat.ofHom hl ≫ (Sn n).g := by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro x
        apply Subtype.ext
        exact (hh x).symm
      rw [← hx₃, hφeq, ← Abelian.Ext.mk₀_comp_mk₀,
        Abelian.Ext.comp_assoc (a := 1) _ _ _ (add_zero 0) (zero_add 1) rfl,
        hS.comp_extClass, Abelian.Ext.comp_zero]
    | succ m hm ih =>
      intro n hn hnm
      exact shift (Sn n) (hSn n hn) m
        (fun e => @Abelian.Ext.eq_zero_of_injective _ _ _ _ _ _ m (hinjM n) e)
        (ih (n + 1) (by omega) (by omega))

  let α0l : T.M →ₗ[R] D.X 0 :=
    { toFun := fun x => T.α0 x, map_add' := T.α0.map_add, map_smul' := fun r x => T.hlin0 r x }
  let α1l : (Fin T.a → R) →ₗ[R] D.X 1 :=
    { toFun := fun x => T.α1 x, map_add' := T.α1.map_add, map_smul' := fun r x => T.hlin1 r x }
  let α2l : (Fin T.b → R) →ₗ[R] D.X 2 :=
    { toFun := fun x => T.α2 x, map_add' := T.α2.map_add, map_smul' := fun r x => T.hlin2 r x }
  let upA : (Fin T.a → R) →ₗ[R] ULift.{u+1} (Fin T.a → R) :=
    (ULift.moduleEquiv (R := R)).symm.toLinearMap
  let upB : (Fin T.b → R) →ₗ[R] ULift.{u+1} (Fin T.b → R) :=
    (ULift.moduleEquiv (R := R)).symm.toLinearMap
  let dnA : ULift.{u+1} (Fin T.a → R) →ₗ[R] (Fin T.a → R) :=
    (ULift.moduleEquiv (R := R)).toLinearMap
  let dnB : ULift.{u+1} (Fin T.b → R) →ₗ[R] (Fin T.b → R) :=
    (ULift.moduleEquiv (R := R)).toLinearMap
  let em : T.M →ₗ[R] (ULift.{u+1} (Fin T.a → R) × D.X 0) := (upA ∘ₗ T.d0).prod α0l
  let e0 : (ULift.{u+1} (Fin T.a → R) × D.X 0) →ₗ[R] (ULift.{u+1} (Fin T.b → R) × D.X 1) :=
    (upB ∘ₗ (-T.d1) ∘ₗ dnA ∘ₗ LinearMap.fst R _ _).prod
      (α1l ∘ₗ dnA ∘ₗ LinearMap.fst R _ _ - dlin 0 1 ∘ₗ LinearMap.snd R _ _)
  let e1 : (ULift.{u+1} (Fin T.b → R) × D.X 1) →ₗ[R] D.X 2 :=
    α2l ∘ₗ dnB ∘ₗ LinearMap.fst R _ _ + dlin 1 2 ∘ₗ LinearMap.snd R _ _
  have hem : ∀ m, em m = (ULift.up (T.d0 m), T.α0 m) := fun m => rfl
  have he0 : ∀ v, e0 v = (ULift.up (-(T.d1 v.1.down)), T.α1 v.1.down - (D.d 0 1).hom v.2) :=
    fun v => rfl
  have he1 : ∀ v, e1 v = T.α2 v.1.down + (D.d 1 2).hom v.2 := fun v => rfl

  have hC0 : ∀ k, 2 ≤ k →
      ∀ e : Abelian.Ext N (ModuleCat.of R (ULift.{u+1} (Fin T.a → R) × D.X 0)) k, e = 0 :=
    fun k hk => prod _ _ (hinjM 0) k hk (hfree T.a k hk)
  have hC1 : ∀ k, 2 ≤ k →
      ∀ e : Abelian.Ext N (ModuleCat.of R (ULift.{u+1} (Fin T.b → R) × D.X 1)) k, e = 0 :=
    fun k hk => prod _ _ (hinjM 1) k hk (hfree T.b k hk)

  have h12 : ∀ v, e1 v ∈ LinearMap.ker (dl 2) := by
    intro v
    show (D.d 2 3).hom (T.α2 v.1.down + (D.d 1 2).hom v.2) = 0
    rw [map_add, T.hc2, zero_add, dd]
  let S2 : ShortComplex (ModuleCat.{u+1} R) :=
    ShortComplex.mk (ModuleCat.ofHom (LinearMap.ker e1).subtype)
      (ModuleCat.ofHom (LinearMap.codRestrict (LinearMap.ker (dl 2)) e1 h12))
      (by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro z
        apply Subtype.ext
        exact z.2)
  have hS2 : S2.ShortExact := by
    refine { exact := ?_, mono_f := ?_, epi_g := ?_ }
    · rw [ShortComplex.moduleCat_exact_iff]
      intro x hx
      refine ⟨⟨x, ?_⟩, rfl⟩
      exact congrArg Subtype.val hx
    · exact (ModuleCat.mono_iff_injective _).mpr (LinearMap.ker e1).injective_subtype
    · rw [ModuleCat.epi_iff_surjective]
      rintro ⟨z, hz⟩
      obtain ⟨p, w, hw⟩ := T.q2s z hz
      refine ⟨(ULift.up p, -w), Subtype.ext ?_⟩
      show T.α2 p + (D.d 1 2).hom (-w) = z
      rw [map_neg, hw]
      abel
  have hK : ∀ k, 3 ≤ k → ∀ e : Abelian.Ext N (ModuleCat.of R (LinearMap.ker e1)) k, e = 0 := by
    intro k hk
    obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    exact shift S2 hS2 k' (hC1 (k' + 1) (by omega)) (tail k' (by omega) 2 le_rfl (by omega))

  have h01 : ∀ v, e0 v ∈ LinearMap.ker e1 := by
    intro v
    show T.α2 (-(T.d1 v.1.down)) + (D.d 1 2).hom (T.α1 v.1.down - (D.d 0 1).hom v.2) = 0
    rw [map_neg, map_sub, T.hc1, dd]
    abel
  let S1 : ShortComplex (ModuleCat.{u+1} R) :=
    ShortComplex.mk (ModuleCat.ofHom em)
      (ModuleCat.ofHom (LinearMap.codRestrict (LinearMap.ker e1) e0 h01))
      (by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro m
        apply Subtype.ext
        show ((ULift.up (-(T.d1 (T.d0 m))), T.α1 (T.d0 m) - (D.d 0 1).hom (T.α0 m)) :
          ULift.{u+1} (Fin T.b → R) × D.X 1) = 0
        rw [T.hdd, T.hc0, neg_zero, sub_self]
        rfl)
  have hS1 : S1.ShortExact := by
    refine { exact := ?_, mono_f := ?_, epi_g := ?_ }
    · rw [ShortComplex.moduleCat_exact_iff]
      intro v hv
      have hv' : e0 v = 0 := congrArg Subtype.val hv
      have h1 : -(T.d1 v.1.down) = 0 := congrArg (fun w => w.1.down) hv'
      have h2 : T.α1 v.1.down - (D.d 0 1).hom v.2 = 0 := congrArg Prod.snd hv'
      rw [neg_eq_zero] at h1
      rw [sub_eq_zero] at h2
      obtain ⟨x, hx⟩ := T.q1i v.1.down h1 ⟨v.2, h2.symm⟩
      have hc : (D.d 0 1).hom (T.α0 x - v.2) = 0 := by
        rw [map_sub, T.hc0, hx, h2, sub_self]
      obtain ⟨x', hx'0, hx'⟩ := T.q0s _ hc
      refine ⟨x - x', ?_⟩
      show ((ULift.up (T.d0 (x - x')), T.α0 (x - x')) : ULift.{u+1} (Fin T.a → R) × D.X 0) = v
      rw [map_sub, map_sub, hx'0, hx', hx, sub_zero, sub_sub_cancel]
    · refine (ModuleCat.mono_iff_injective _).mpr ?_
      refine (injective_iff_map_eq_zero em).mpr ?_
      intro m hm
      exact T.q0i m (congrArg (fun w => w.1.down) hm) (congrArg Prod.snd hm)
    · rw [ModuleCat.epi_iff_surjective]
      rintro ⟨v', hv⟩
      have hv2 : T.α2 v'.1.down + (D.d 1 2).hom v'.2 = 0 := hv
      obtain ⟨p'', hp''⟩ := T.q2i v'.1.down
        ⟨-v'.2, by rw [map_neg]; exact (eq_neg_of_add_eq_zero_left hv2).symm⟩
      have hc : (D.d 1 2).hom (T.α1 (-p'') - v'.2) = 0 := by
        rw [map_sub, T.hc1, map_neg, hp'', map_neg, ← neg_add', hv2, neg_zero]
      obtain ⟨p₁, hp₁, w, hw⟩ := T.q1s _ hc
      refine ⟨(ULift.up (-p'' - p₁), -w), Subtype.ext ?_⟩
      show ((ULift.up (-(T.d1 (-p'' - p₁))), T.α1 (-p'' - p₁) - (D.d 0 1).hom (-w)) :
        ULift.{u+1} (Fin T.b → R) × D.X 1) = v'
      refine Prod.ext ?_ ?_
      · show ULift.up (-(T.d1 (-p'' - p₁))) = v'.1
        apply ULift.ext
        show -(T.d1 (-p'' - p₁)) = v'.1.down
        rw [map_sub, map_neg, hp'', hp₁]
        abel
      · show T.α1 (-p'' - p₁) - (D.d 0 1).hom (-w) = v'.2
        rw [map_neg, hw, map_sub]
        abel
  intro j hj e
  obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
  exact shift S1 hS1 j' (hC0 (j' + 1) (by omega)) (hK j' (by omega)) e

theorem wc_chmp_frob_embed (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Γ : Type u) [Group Γ] [Finite Γ]
    (N : Type (u+1)) [AddCommGroup N] [Module (MonoidAlgebra ℤ_[ℓ] Γ) N]
    [Module.Finite (MonoidAlgebra ℤ_[ℓ] Γ) N] (hN : ∀ x : N, ℓ • x = 0) :
    ∃ (k : ℕ) (e : N →ₗ[MonoidAlgebra ℤ_[ℓ] Γ] wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k),
      Function.Injective e :=
by
  classical
  haveI : Fintype Γ := Fintype.ofFinite Γ
  have hℓ : Nat.Prime ℓ := Fact.out
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩

  have hring : ∀ (g : Γ) (c : ℤ_[ℓ]), ∃ a : ℤ_[ℓ], MonoidAlgebra.single g c =
      ((PadicInt.toZMod c).val : MonoidAlgebra ℤ_[ℓ] Γ) * MonoidAlgebra.single g (1 : ℤ_[ℓ]) +
      MonoidAlgebra.single g a * ((ℓ : ℕ) : MonoidAlgebra ℤ_[ℓ] Γ) := by
    intro g c
    have hker : c - ((PadicInt.toZMod c).val : ℤ_[ℓ]) ∈ Ideal.span {(ℓ : ℤ_[ℓ])} := by
      rw [← PadicInt.maximalIdeal_eq_span_p, ← PadicInt.ker_toZMod, RingHom.mem_ker, map_sub,
        map_natCast, ZMod.natCast_zmod_val, sub_self]
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hker
    refine ⟨a, ?_⟩
    rw [MonoidAlgebra.natCast_def, MonoidAlgebra.natCast_def, MonoidAlgebra.single_mul_single,
      MonoidAlgebra.single_mul_single]
    simp only [one_mul, mul_one]
    rw [← MonoidAlgebra.single_add, ha]
    congr 1
    ring
  have s1N : ∀ (g : Γ) (c : ℤ_[ℓ]) (y : N), MonoidAlgebra.single g c • y =
      (PadicInt.toZMod c).val • (MonoidAlgebra.single g (1 : ℤ_[ℓ]) • y) := by
    intro g c y
    obtain ⟨a, ha⟩ := hring g c
    rw [ha, add_smul, mul_smul, mul_smul, Nat.cast_smul_eq_nsmul, Nat.cast_smul_eq_nsmul, hN,
      smul_zero, add_zero]

  letI instN : Module (ZMod ℓ) N := AddCommGroup.zmodModule (n := ℓ) (G := N) hN
  obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := MonoidAlgebra ℤ_[ℓ] Γ) (M := N)
  have hT : (Set.range (fun p : Γ × Fin n =>
      MonoidAlgebra.single p.1 (1 : ℤ_[ℓ]) • s p.2)).Finite := Set.finite_range _
  let W : Submodule (ZMod ℓ) N := Submodule.span (ZMod ℓ)
      (Set.range (fun p : Γ × Fin n => MonoidAlgebra.single p.1 (1 : ℤ_[ℓ]) • s p.2))
  have hA : ∀ (a : MonoidAlgebra ℤ_[ℓ] Γ) (j : Fin n), (a • s j : N) ∈ W := by
    intro a j
    induction a using MonoidAlgebra.induction_linear
    next => rw [zero_smul]; exact W.zero_mem
    next f g hf hg => rw [add_smul]; exact W.add_mem hf hg
    next m c =>
      rw [s1N m c (s j)]
      exact W.toAddSubmonoid.nsmul_mem (Submodule.subset_span ⟨(m, j), rfl⟩) _
  have hB : ∀ x ∈ Submodule.span (MonoidAlgebra ℤ_[ℓ] Γ) (Set.range s),
      ∀ a : MonoidAlgebra ℤ_[ℓ] Γ, (a • x : N) ∈ W := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem y hy => obtain ⟨j, rfl⟩ := hy; exact fun a => hA a j
    | zero => intro a; rw [smul_zero]; exact W.zero_mem
    | add y z _ _ hy hz => intro a; rw [smul_add]; exact W.add_mem (hy a) (hz a)
    | smul b y _ hy => intro a; rw [smul_smul]; exact hy (a * b)
  have hW : W = ⊤ := by
    refine eq_top_iff.mpr fun x _ => ?_
    have := hB x (by rw [hs]; exact Submodule.mem_top) 1
    rwa [one_smul] at this
  haveI : Module.Finite (ZMod ℓ) N := ⟨⟨hT.toFinset, by rw [hT.coe_toFinset]; exact hW⟩⟩
  set k := Module.finrank (ZMod ℓ) N with hk
  let b := Module.finBasis (ZMod ℓ) N

  let Pk : Submodule (MonoidAlgebra ℤ_[ℓ] Γ) (Fin k → MonoidAlgebra ℤ_[ℓ] Γ) :=
    LinearMap.range (ℓ • LinearMap.id : (Fin k → MonoidAlgebra ℤ_[ℓ] Γ) →ₗ[MonoidAlgebra ℤ_[ℓ] Γ]
      (Fin k → MonoidAlgebra ℤ_[ℓ] Γ))
  let mk : (Fin k → MonoidAlgebra ℤ_[ℓ] Γ) →ₗ[MonoidAlgebra ℤ_[ℓ] Γ]
      wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k := Pk.mkQ
  have hmk : ∀ v, mk v = 0 ↔ v ∈ Pk := fun v => Submodule.Quotient.mk_eq_zero Pk
  have hmks : Function.Surjective mk := Pk.mkQ_surjective
  have hQ : ∀ q : wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k, ℓ • q = 0 := by
    intro q
    obtain ⟨v, rfl⟩ := hmks q
    rw [← map_nsmul, hmk]
    exact ⟨v, by first | rfl | simp only [LinearMap.smul_apply, LinearMap.id_apply]⟩
  have hval : ∀ (c d : ZMod ℓ) (q : wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k),
      (c + d).val • q = c.val • q + d.val • q := by
    letI : Module (ZMod ℓ) (wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k) := AddCommGroup.zmodModule (n := ℓ) (G := wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k) hQ
    have hcz : ∀ (c : ZMod ℓ) (q : wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k), c • q = c.val • q := by
      intro c q
      conv_lhs => rw [← ZMod.natCast_zmod_val c]
      exact Nat.cast_smul_eq_nsmul (ZMod ℓ) _ _
    intro c d q
    rw [← hcz, ← hcz, ← hcz, add_smul]
  have hsmulQ : ∀ (g : Γ) (c : ℤ_[ℓ]) (y : wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k),
      MonoidAlgebra.single g c • y =
        (PadicInt.toZMod c).val • (MonoidAlgebra.single g (1 : ℤ_[ℓ]) • y) := by
    intro g c y
    obtain ⟨a, ha⟩ := hring g c
    rw [ha, add_smul, mul_smul, mul_smul, Nat.cast_smul_eq_nsmul, Nat.cast_smul_eq_nsmul, hQ,
      smul_zero, add_zero]
  let δ : Fin k → Γ → (Fin k → MonoidAlgebra ℤ_[ℓ] Γ) :=
    fun i g => Pi.single i (MonoidAlgebra.single g (1 : ℤ_[ℓ]))
  let co : N → Fin k → Γ → ZMod ℓ :=
    fun x i g => b.repr (MonoidAlgebra.single g⁻¹ (1 : ℤ_[ℓ]) • x) i
  let E : N → wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k :=
    fun x => ∑ i, ∑ g, (co x i g).val • mk (δ i g)
  have hadd : ∀ x y, E (x + y) = E x + E y := by
    intro x y
    simp only [E, co, smul_add, map_add, Finsupp.add_apply, hval, Finset.sum_add_distrib]
  have hequiv : ∀ (m : Γ) (x : N), E (MonoidAlgebra.single m (1 : ℤ_[ℓ]) • x) =
      MonoidAlgebra.single m (1 : ℤ_[ℓ]) • E x := by
    intro m x
    simp only [E, Finset.smul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    have key : ∀ g, (co (MonoidAlgebra.single m (1 : ℤ_[ℓ]) • x) i (m * g)).val • mk (δ i (m * g)) =
        MonoidAlgebra.single m (1 : ℤ_[ℓ]) • ((co x i g).val • mk (δ i g)) := by
      intro g
      have h1 : MonoidAlgebra.single (m * g)⁻¹ (1 : ℤ_[ℓ]) • MonoidAlgebra.single m (1 : ℤ_[ℓ]) • x =
          MonoidAlgebra.single g⁻¹ (1 : ℤ_[ℓ]) • x := by
        rw [smul_smul, MonoidAlgebra.single_mul_single, mul_one, mul_inv_rev, inv_mul_cancel_right]
      have h2 : MonoidAlgebra.single m (1 : ℤ_[ℓ]) • δ i g = δ i (m * g) := by
        funext j
        by_cases hji : j = i
        · subst hji; simp [δ, MonoidAlgebra.single_mul_single]
        · simp [δ, Pi.single_apply, hji]
      have h3 : co (MonoidAlgebra.single m (1 : ℤ_[ℓ]) • x) i (m * g) = co x i g := by
        show b.repr (MonoidAlgebra.single (m * g)⁻¹ (1 : ℤ_[ℓ]) •
          MonoidAlgebra.single m (1 : ℤ_[ℓ]) • x) i = b.repr (MonoidAlgebra.single g⁻¹ (1 : ℤ_[ℓ]) • x) i
        rw [h1]
      rw [h3, ← h2, LinearMap.map_smul]
      exact smul_comm _ _ _
    exact (Equiv.sum_comp (Equiv.mulLeft m)
      (fun g => (co (MonoidAlgebra.single m (1 : ℤ_[ℓ]) • x) i g).val • mk (δ i g))).symm.trans
      (Finset.sum_congr rfl fun g _ => key g)
  let Eadd : N →+ wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k := AddMonoidHom.mk' E hadd
  have hlin : ∀ (r : MonoidAlgebra ℤ_[ℓ] Γ) (x : N), E (r • x) = r • E x := by
    intro r x
    induction r using MonoidAlgebra.induction_linear
    next => rw [zero_smul, zero_smul]; exact Eadd.map_zero
    next f g hf hg => rw [add_smul, add_smul, hadd, hf, hg]
    next m c =>
      rw [s1N, hsmulQ, ← hequiv]
      exact map_nsmul Eadd _ _
  let e : N →ₗ[MonoidAlgebra ℤ_[ℓ] Γ] wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k :=
    { toFun := E, map_add' := hadd, map_smul' := fun r x => hlin r x }
  refine ⟨k, e, ?_⟩
  rw [injective_iff_map_eq_zero]
  intro x hx
  have hx' : E x = 0 := hx
  have hEV : E x = mk (∑ i, ∑ g, (co x i g).val • δ i g) := by
    simp only [E, map_sum, map_nsmul]
  rw [hEV, hmk] at hx'
  obtain ⟨w, hw⟩ := hx'
  have hw' : ℓ • w = ∑ i, ∑ g, (co x i g).val • δ i g := by
    rw [← hw]
    first | rfl | simp only [LinearMap.smul_apply, LinearMap.id_apply]
  apply b.repr.injective
  ext i
  rw [map_zero, Finsupp.zero_apply]
  let cf : (Fin k → MonoidAlgebra ℤ_[ℓ] Γ) →+ ZMod ℓ :=
    { toFun := fun v => PadicInt.toZMod ((v i).coeff 1)
      map_zero' := by simp
      map_add' := by intro v v'; simp [MonoidAlgebra.coeff_add] }
  have hδ : ∀ i' g, cf (δ i' g) = if i' = i ∧ g = 1 then 1 else 0 := by
    intro i' g
    show PadicInt.toZMod (((Pi.single i' (MonoidAlgebra.single g (1 : ℤ_[ℓ])) : Fin k → MonoidAlgebra ℤ_[ℓ] Γ) i).coeff 1) = _
    by_cases hi : i' = i
    · subst hi
      rw [Pi.single_eq_same, MonoidAlgebra.coeff_single, Finsupp.single_apply]
      by_cases hg : g = 1
      · simp [hg]
      · simp [hg]
    · have hi' : i ≠ i' := Ne.symm hi
      simp [Pi.single_apply, hi', hi]
  have hsum : ∑ i', ∑ g, (co x i' g).val • cf (δ i' g) = b.repr x i := by
    simp only [hδ]
    rw [Finset.sum_eq_single i]
    · rw [Finset.sum_eq_single (1 : Γ)]
      · rw [if_pos ⟨rfl, rfl⟩]
        simp only [co, inv_one, ← MonoidAlgebra.one_def, one_smul, nsmul_eq_mul, mul_one,
          ZMod.natCast_zmod_val]
      · intro g _ hg; simp [hg]
      · intro h; exact absurd (Finset.mem_univ _) h
    · intro i' _ hi'; simp [hi']
    · intro h; exact absurd (Finset.mem_univ _) h
  have h0 : cf (ℓ • w) = 0 := by rw [map_nsmul, nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  have h1 : cf (∑ i', ∑ g, (co x i' g).val • δ i' g) = b.repr x i := by
    rw [← hsum]; simp only [map_sum, map_nsmul]
  rw [← h1, ← hw', h0]

theorem wc_chmp_torsion_shift (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Γ : Type u) [Group Γ] [Finite Γ]
    (M : ModuleCat.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ))
    (hemb : ∀ N : ModuleCat.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ), wcChmpTorsFG ℓ N →
      ∃ (k : ℕ) (e : N →ₗ[MonoidAlgebra ℤ_[ℓ] Γ] wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k),
        Function.Injective e)
    (h4 : ∀ N : ModuleCat.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ), wcChmpTorsFG ℓ N →
      ∀ j, 4 ≤ j → ∀ e : Abelian.Ext N M j, e = 0) :
    ∀ N : ModuleCat.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ), wcChmpTorsFG ℓ N →
      ∀ e : Abelian.Ext N M 2, e = 0 :=
by
  classical

  have hR : ∀ r : MonoidAlgebra ℤ_[ℓ] Γ, ℓ • r = 0 → r = 0 := fun r h =>
    (smul_eq_zero.mp h).resolve_left (Fact.out : ℓ.Prime).pos.ne'

  have s2a : ∀ {S : ShortComplex (ModuleCat.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ))} (hS : S.ShortExact)
      (n : ℕ), (∀ e : Abelian.Ext S.X₂ M n, e = 0) → (∀ e : Abelian.Ext S.X₃ M (n + 1), e = 0) →
      ∀ e : Abelian.Ext S.X₁ M n, e = 0 := by
    intro S hS n h2 h3 x
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS M x (add_comm 1 n) (h3 _)
    rw [← hx₂, h2 x₂, Abelian.Ext.comp_zero]

  have s2b : ∀ {S : ShortComplex (ModuleCat.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ))} (hS : S.ShortExact)
      (n : ℕ), (∀ e : Abelian.Ext S.X₁ M n, e = 0) → (∀ e : Abelian.Ext S.X₂ M (n + 1), e = 0) →
      ∀ e : Abelian.Ext S.X₃ M (n + 1), e = 0 := by
    intro S hS n h1 h2 x
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS M x (h2 _) (add_comm 1 n)
    rw [← hx₁, h1 x₁, Abelian.Ext.comp_zero]

  have s1 : ∀ (k n : ℕ), 2 ≤ n → ∀ e : Abelian.Ext (ModuleCat.of (MonoidAlgebra ℤ_[ℓ] Γ)
      (ULift.{u+1} (wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k))) M n, e = 0 := by
    intro k n hn
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 + 1 := ⟨n - 2, by omega⟩
    let fl : ULift.{u+1} (Fin k → MonoidAlgebra ℤ_[ℓ] Γ) →ₗ[MonoidAlgebra ℤ_[ℓ] Γ]
        ULift.{u+1} (Fin k → MonoidAlgebra ℤ_[ℓ] Γ) := ℓ • LinearMap.id
    let gl : ULift.{u+1} (Fin k → MonoidAlgebra ℤ_[ℓ] Γ) →ₗ[MonoidAlgebra ℤ_[ℓ] Γ]
        ULift.{u+1} (wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k) :=
      ULift.moduleEquiv.symm.toLinearMap ∘ₗ
        (LinearMap.range (ℓ • LinearMap.id : (Fin k → MonoidAlgebra ℤ_[ℓ] Γ) →ₗ[MonoidAlgebra ℤ_[ℓ] Γ]
          (Fin k → MonoidAlgebra ℤ_[ℓ] Γ))).mkQ ∘ₗ ULift.moduleEquiv.toLinearMap
    have hw : ModuleCat.ofHom fl ≫ ModuleCat.ofHom gl = 0 := by
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      apply ULift.ext
      show Submodule.Quotient.mk (ℓ • x.down) = (0 : wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k)
      exact (Submodule.Quotient.mk_eq_zero _).mpr ⟨x.down, rfl⟩
    have hS : (ShortComplex.mk _ _ hw).ShortExact := by
      refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
      · rw [ShortComplex.moduleCat_exact_iff]
        intro y hy
        have hy' : (Submodule.Quotient.mk y.down : wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k) = 0 :=
          congrArg ULift.down hy
        obtain ⟨v, hv⟩ := (Submodule.Quotient.mk_eq_zero _).mp hy'
        exact ⟨ULift.up v, ULift.ext _ _ hv⟩
      · rw [ModuleCat.mono_iff_injective]
        intro a b hab
        have hab' : ℓ • a.down = ℓ • b.down := congrArg ULift.down hab
        have h1 : ℓ • (a.down - b.down) = 0 := by
          rw [smul_sub]; exact sub_eq_zero.mpr hab'
        apply ULift.ext
        rw [← sub_eq_zero]
        funext i
        have := congrFun h1 i
        simp only [Pi.smul_apply, Pi.zero_apply] at this ⊢
        exact hR _ this
      · rw [ModuleCat.epi_iff_surjective]
        intro z
        obtain ⟨v, hv⟩ := Submodule.Quotient.mk_surjective _ z.down
        exact ⟨ULift.up v, ULift.ext _ _ hv⟩
    haveI : Projective (ModuleCat.of (MonoidAlgebra ℤ_[ℓ] Γ)
        (ULift.{u+1} (Fin k → MonoidAlgebra ℤ_[ℓ] Γ))) :=
      ModuleCat.projective_of_free
        ((Pi.basisFun (MonoidAlgebra ℤ_[ℓ] Γ) (Fin k)).map ULift.moduleEquiv.symm)
    exact s2b hS (m + 1) (fun e => Abelian.Ext.eq_zero_of_projective e)
      (fun e => Abelian.Ext.eq_zero_of_projective e)

  have shift : ∀ n, 2 ≤ n → (∀ N : ModuleCat.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ), wcChmpTorsFG ℓ N →
      ∀ e : Abelian.Ext N M (n + 1), e = 0) →
      ∀ N : ModuleCat.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ), wcChmpTorsFG ℓ N →
      ∀ e : Abelian.Ext N M n, e = 0 := by
    intro n hn hV N hN
    obtain ⟨k, e, he⟩ := hemb N hN
    let e' : N →ₗ[MonoidAlgebra ℤ_[ℓ] Γ] ULift.{u+1} (wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k) :=
      ULift.moduleEquiv.symm.toLinearMap ∘ₗ e
    have hw : ModuleCat.ofHom e' ≫ ModuleCat.ofHom (LinearMap.range e').mkQ = 0 := by
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      exact (Submodule.Quotient.mk_eq_zero _).mpr ⟨x, rfl⟩
    have hS : (ShortComplex.mk _ _ hw).ShortExact := by
      refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
      · rw [ShortComplex.moduleCat_exact_iff]
        intro y hy
        obtain ⟨x, hx⟩ := (Submodule.Quotient.mk_eq_zero _).mp hy
        exact ⟨x, hx⟩
      · rw [ModuleCat.mono_iff_injective]
        intro a b hab
        exact he (ULift.moduleEquiv.symm.injective hab)
      · rw [ModuleCat.epi_iff_surjective]
        exact Submodule.mkQ_surjective _
    have hN' : wcChmpTorsFG ℓ (ModuleCat.of (MonoidAlgebra ℤ_[ℓ] Γ)
        (ULift.{u+1} (wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k) ⧸ LinearMap.range e')) := by
      refine ⟨?_, ?_⟩
      · haveI : Module.Finite (MonoidAlgebra ℤ_[ℓ] Γ) (wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k) :=
          Module.Finite.of_surjective (Submodule.mkQ _) (Submodule.mkQ_surjective _)
        haveI : Module.Finite (MonoidAlgebra ℤ_[ℓ] Γ)
            (ULift.{u+1} (wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k)) :=
          Module.Finite.equiv ULift.moduleEquiv.symm
        exact Module.Finite.of_surjective (LinearMap.range e').mkQ (Submodule.mkQ_surjective _)
      · intro x
        obtain ⟨y, rfl⟩ := Submodule.mkQ_surjective (LinearMap.range e') x
        rw [← map_nsmul]
        have hy : ℓ • y = 0 := by
          apply ULift.ext
          obtain ⟨v, hv⟩ := Submodule.Quotient.mk_surjective _ y.down
          show ℓ • y.down = 0
          rw [← hv, ← Submodule.Quotient.mk_smul]
          exact (Submodule.Quotient.mk_eq_zero _).mpr ⟨v, rfl⟩
        rw [hy, map_zero]
    intro x
    exact s2a hS n (s1 k n hn) (hV _ hN') x
  have V3 := shift 3 (by norm_num) (fun N hN => h4 N hN 4 le_rfl)
  exact shift 2 le_rfl V3

theorem wc_chmp_rel_baer (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Γ : Type u) [Group Γ] [Finite Γ]
    (M : ModuleCat.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ)) (htf : ∀ x : M, ℓ • x = 0 → x = 0)
    (h2 : ∀ N : ModuleCat.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ), wcChmpTorsFG ℓ N →
      ∀ e : Abelian.Ext N M 2, e = 0) :
    ∀ (𝔟 : Submodule (MonoidAlgebra ℤ_[ℓ] Γ) (MonoidAlgebra ℤ_[ℓ] Γ))
      (h𝔟 : ((ℓ : ℕ) : MonoidAlgebra ℤ_[ℓ] Γ) ∈ 𝔟)
      (f : 𝔟 →ₗ[MonoidAlgebra ℤ_[ℓ] Γ] wcChmpModBar (MonoidAlgebra ℤ_[ℓ] Γ) ℓ M),
      f ⟨((ℓ : ℕ) : MonoidAlgebra ℤ_[ℓ] Γ), h𝔟⟩ = 0 →
      ∃ mb : wcChmpModBar (MonoidAlgebra ℤ_[ℓ] Γ) ℓ M,
        ∀ x : 𝔟, f x = (x : MonoidAlgebra ℤ_[ℓ] Γ) • mb :=
by
  classical
  intro 𝔟 h𝔟 f hf0

  let S : ShortComplex (ModuleCat.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ)) :=
    { X₁ := ModuleCat.of _ (ULift.{u+1} 𝔟)
      X₂ := ModuleCat.of _ (ULift.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ))
      X₃ := ModuleCat.of _ (ULift.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ ⧸ 𝔟))
      f := ModuleCat.ofHom (ULift.moduleEquiv.symm.toLinearMap ∘ₗ 𝔟.subtype ∘ₗ
        ULift.moduleEquiv.toLinearMap)
      g := ModuleCat.ofHom (ULift.moduleEquiv.symm.toLinearMap ∘ₗ 𝔟.mkQ ∘ₗ
        ULift.moduleEquiv.toLinearMap)
      zero := by
        ext x
        exact (Submodule.Quotient.mk_eq_zero 𝔟).mpr x.down.2 }
  have hSex : S.Exact := by
    rw [ShortComplex.moduleCat_exact_iff]
    intro y hy
    have hy' : y.down ∈ 𝔟 := by
      have := congrArg ULift.down hy
      simpa [S, Submodule.Quotient.mk_eq_zero] using this
    exact ⟨ULift.up ⟨y.down, hy'⟩, rfl⟩
  have hSf : Mono S.f := by
    rw [ModuleCat.mono_iff_injective]
    intro a b hab
    have := congrArg ULift.down hab
    apply ULift.ext
    apply Subtype.ext
    simpa [S] using this
  have hSg : Epi S.g := by
    rw [ModuleCat.epi_iff_surjective]
    intro z
    obtain ⟨r, hr⟩ := Submodule.mkQ_surjective 𝔟 z.down
    exact ⟨ULift.up r, by apply ULift.ext; simpa [S] using hr⟩
  have hS : S.ShortExact := ShortComplex.ShortExact.mk' hSex hSf hSg
  have hX3 : wcChmpTorsFG ℓ S.X₃ := by
    refine ⟨Module.Finite.equiv (ULift.moduleEquiv (R := MonoidAlgebra ℤ_[ℓ] Γ)).symm, ?_⟩
    intro z
    apply ULift.ext
    obtain ⟨r, hr⟩ := Submodule.mkQ_surjective 𝔟 z.down
    show ℓ • z.down = 0
    rw [← hr, ← map_nsmul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, nsmul_eq_mul,
      Nat.cast_comm]
    exact 𝔟.smul_mem r h𝔟
  have hproj : Projective S.X₂ := by
    show Projective (ModuleCat.of _ (ULift.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ)))
    rw [← IsProjective.iff_projective]
    infer_instance
  have hB : ∀ e : Abelian.Ext S.X₁ M 1, e = 0 := by
    intro e
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS M e
      (by norm_num : 1 + 1 = 2) (h2 _ hX3 _)
    rw [← hx₂, Abelian.Ext.eq_zero_of_projective x₂, Abelian.Ext.comp_zero]

  let T : ShortComplex (ModuleCat.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ)) :=
    { X₁ := M
      X₂ := M
      X₃ := ModuleCat.of _ (wcChmpModBar (MonoidAlgebra ℤ_[ℓ] Γ) ℓ M)
      f := ModuleCat.ofHom (ℓ • LinearMap.id)
      g := ModuleCat.ofHom (Submodule.mkQ _)
      zero := by
        ext x
        simp only [ModuleCat.hom_comp, ModuleCat.hom_ofHom, LinearMap.comp_apply,
          ModuleCat.hom_zero, LinearMap.zero_apply, Submodule.mkQ_apply]
        exact (Submodule.Quotient.mk_eq_zero _).mpr (LinearMap.mem_range_self _ x) }
  have hTex : T.Exact := by
    rw [ShortComplex.moduleCat_exact_iff]
    intro y hy
    have hy' : y ∈ LinearMap.range (ℓ • LinearMap.id : M →ₗ[MonoidAlgebra ℤ_[ℓ] Γ] M) :=
      (Submodule.Quotient.mk_eq_zero _).mp hy
    obtain ⟨x, hx⟩ := hy'
    exact ⟨x, hx⟩
  have hTf : Mono T.f := by
    rw [ModuleCat.mono_iff_injective]
    intro a b hab
    have hab' : ℓ • a = ℓ • b := hab
    have : ℓ • (a - b) = 0 := by rw [smul_sub, hab', sub_self]
    exact sub_eq_zero.mp (htf _ this)
  have hTg : Epi T.g := by
    rw [ModuleCat.epi_iff_surjective]
    exact Submodule.mkQ_surjective _
  have hT : T.ShortExact := ShortComplex.ShortExact.mk' hTex hTf hTg
  let g' : S.X₁ ⟶ T.X₃ := ModuleCat.ofHom (f ∘ₗ ULift.moduleEquiv.toLinearMap)
  obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ S.X₁ hT (Abelian.Ext.mk₀ g')
    (zero_add 1) (hB _)
  obtain ⟨G', rfl⟩ := (Abelian.Ext.mk₀_bijective S.X₁ T.X₂).2 x₂
  rw [Abelian.Ext.mk₀_comp_mk₀] at hx₂
  have hG : G' ≫ T.g = g' := (Abelian.Ext.mk₀_bijective _ _).1 hx₂

  let Fl : 𝔟 →ₗ[MonoidAlgebra ℤ_[ℓ] Γ] M :=
    G'.hom ∘ₗ (ULift.moduleEquiv (R := MonoidAlgebra ℤ_[ℓ] Γ) (M := 𝔟)).symm.toLinearMap
  have hF : ∀ x : 𝔟, (Submodule.Quotient.mk (Fl x) :
      wcChmpModBar (MonoidAlgebra ℤ_[ℓ] Γ) ℓ M) = f x := by
    intro x
    have := congrArg (fun h => h.hom (ULift.up x)) hG
    exact this
  have hFl : Fl ⟨((ℓ : ℕ) : MonoidAlgebra ℤ_[ℓ] Γ), h𝔟⟩ ∈
      LinearMap.range (ℓ • LinearMap.id : M →ₗ[MonoidAlgebra ℤ_[ℓ] Γ] M) := by
    rw [← Submodule.Quotient.mk_eq_zero, hF, hf0]
  obtain ⟨m, hm⟩ := hFl
  simp only [LinearMap.smul_apply, LinearMap.id_apply] at hm
  have key : ∀ x : 𝔟,
      ℓ • x = (x : MonoidAlgebra ℤ_[ℓ] Γ) • ⟨((ℓ : ℕ) : MonoidAlgebra ℤ_[ℓ] Γ), h𝔟⟩ := by
    intro x
    apply Subtype.ext
    show ℓ • (x : MonoidAlgebra ℤ_[ℓ] Γ) =
      (x : MonoidAlgebra ℤ_[ℓ] Γ) * ((ℓ : ℕ) : MonoidAlgebra ℤ_[ℓ] Γ)
    rw [nsmul_eq_mul, Nat.cast_comm]
  have hFx : ∀ x : 𝔟, Fl x = (x : MonoidAlgebra ℤ_[ℓ] Γ) • m := by
    intro x
    have h0 : ℓ • (Fl x - (x : MonoidAlgebra ℤ_[ℓ] Γ) • m) = 0 := by
      rw [smul_sub, ← map_nsmul, key x, map_smul, ← hm, smul_comm, sub_self]
    exact sub_eq_zero.mp (htf _ h0)
  refine ⟨Submodule.Quotient.mk m, fun x => ?_⟩
  rw [← hF, hFx, Submodule.Quotient.mk_smul]

theorem wc_chmp_frob_ext_split (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Γ : Type u) [Group Γ] [Finite Γ]
    (Q : Type (u+1)) [AddCommGroup Q] [Module (MonoidAlgebra ℤ_[ℓ] Γ) Q]
    (hQ : ∀ x : Q, ℓ • x = 0)
    (hrel : ∀ (𝔟 : Submodule (MonoidAlgebra ℤ_[ℓ] Γ) (MonoidAlgebra ℤ_[ℓ] Γ))
      (h𝔟 : ((ℓ : ℕ) : MonoidAlgebra ℤ_[ℓ] Γ) ∈ 𝔟) (f : 𝔟 →ₗ[MonoidAlgebra ℤ_[ℓ] Γ] Q),
      f ⟨((ℓ : ℕ) : MonoidAlgebra ℤ_[ℓ] Γ), h𝔟⟩ = 0 →
      ∃ mb : Q, ∀ x : 𝔟, f x = (x : MonoidAlgebra ℤ_[ℓ] Γ) • mb)
    (hembQ : ∃ (k : ℕ) (e : Q →ₗ[MonoidAlgebra ℤ_[ℓ] Γ] wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k),
      Function.Injective e) :
    ∀ (k : ℕ) (p : wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k →ₗ[MonoidAlgebra ℤ_[ℓ] Γ] Q),
      Function.Surjective p →
      ∃ s : Q →ₗ[MonoidAlgebra ℤ_[ℓ] Γ] wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k,
        p ∘ₗ s = LinearMap.id :=
by
  have key : ∀ (R : Type u) [Ring R] (Q : Type (u+1)) [AddCommGroup Q] [Module R Q]
      (hrel : ∀ (𝔟 : Submodule R R) (h𝔟 : ((ℓ : ℕ) : R) ∈ 𝔟) (f : 𝔟 →ₗ[R] Q),
        f ⟨((ℓ : ℕ) : R), h𝔟⟩ = 0 → ∃ mb : Q, ∀ x : 𝔟, f x = (x : R) • mb)
      (hembQ : ∃ (k : ℕ) (e : Q →ₗ[R] wcChmpModL R ℓ k), Function.Injective e),
      ∀ (k : ℕ) (p : wcChmpModL R ℓ k →ₗ[R] Q), Function.Surjective p →
        ∃ s : Q →ₗ[R] wcChmpModL R ℓ k, p ∘ₗ s = LinearMap.id := by
    intro R _ Q _ _ hrel hembQ
    classical
    have htors : ∀ (k : ℕ) (z : wcChmpModL R ℓ k), ℓ • z = 0 := by
      intro k z
      induction z using Submodule.Quotient.induction_on with
      | H y =>
        rw [← Submodule.Quotient.mk_smul]
        exact (Submodule.Quotient.mk_eq_zero _).mpr ⟨y, by
          first
            | rfl
            | simp only [LinearMap.smul_apply, LinearMap.id_apply]⟩
    obtain ⟨k0, e, he⟩ := hembQ
    have step : ∀ (φ : wcChmpModL R ℓ k0 →ₗ.[R] Q) (x : wcChmpModL R ℓ k0), ℓ • x = 0 →
        ∃ ψ : wcChmpModL R ℓ k0 →ₗ.[R] Q, φ ≤ ψ ∧ x ∈ ψ.domain := by
      intro φ x hx
      let 𝔟 : Submodule R R := φ.domain.comap (LinearMap.toSpanSingleton R _ x)
      let f : 𝔟 →ₗ[R] Q := φ.toFun ∘ₗ LinearMap.codRestrict φ.domain
        ((LinearMap.toSpanSingleton R _ x) ∘ₗ 𝔟.subtype) (fun r => r.2)
      have hℓx : ((ℓ : ℕ) : R) • x = 0 := by rw [Nat.cast_smul_eq_nsmul]; exact hx
      have hℓ𝔟 : ((ℓ : ℕ) : R) ∈ 𝔟 := by
        show (LinearMap.toSpanSingleton R _ x) ((ℓ : ℕ) : R) ∈ φ.domain
        rw [LinearMap.toSpanSingleton_apply, hℓx]
        exact φ.domain.zero_mem
      obtain ⟨m, hm⟩ := hrel 𝔟 hℓ𝔟 f (by
        have h0 : (⟨((ℓ : ℕ) : R) • x, hℓ𝔟⟩ : φ.domain) = 0 := Subtype.ext hℓx
        show φ.toFun ⟨((ℓ : ℕ) : R) • x, hℓ𝔟⟩ = 0
        rw [h0, map_zero])
      have hφ : ∀ (r : R) (h : r • x ∈ φ.domain), φ ⟨r • x, h⟩ = r • m := fun r h => hm ⟨r, h⟩
      have H : ∀ c : R, c • x = 0 → c • m = 0 := by
        intro c hc
        have hc' : c • x ∈ φ.domain := by rw [hc]; exact φ.domain.zero_mem
        rw [← hφ c hc']
        have h0 : (⟨c • x, hc'⟩ : φ.domain) = 0 := Subtype.ext hc
        rw [h0]
        exact φ.toFun.map_zero
      let T := LinearMap.toSpanSingleton R (wcChmpModL R ℓ k0) x
      have hkerT : LinearMap.ker T ≤ LinearMap.ker (LinearMap.toSpanSingleton R Q m) := by
        intro c hc
        rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply] at hc ⊢
        exact H c hc
      let χ : wcChmpModL R ℓ k0 →ₗ.[R] Q := ⟨LinearMap.range T,
        (LinearMap.ker T).liftQ (LinearMap.toSpanSingleton R Q m) hkerT ∘ₗ
          T.quotKerEquivRange.symm.toLinearMap⟩
      have hχ : ∀ (c : R) (h : T c ∈ LinearMap.range T), χ ⟨T c, h⟩ = c • m := by
        intro c h
        show (LinearMap.ker T).liftQ (LinearMap.toSpanSingleton R Q m) hkerT
          (T.quotKerEquivRange.symm ⟨T c, h⟩) = c • m
        rw [LinearMap.quotKerEquivRange_symm_apply_image, Submodule.mkQ_apply,
          Submodule.liftQ_apply, LinearMap.toSpanSingleton_apply]
      have hagree : ∀ (a : φ.domain) (b : χ.domain),
          (a : wcChmpModL R ℓ k0) = b → φ a = χ b := by
        intro a b hab
        obtain ⟨c, hc⟩ := b.2
        have hTc : T c = c • x := LinearMap.toSpanSingleton_apply R _ x c
        have hb : b = ⟨T c, ⟨c, rfl⟩⟩ := Subtype.ext hc.symm
        have hmem : c • x ∈ φ.domain := by rw [← hTc, hc, ← hab]; exact a.2
        have ha : a = ⟨c • x, hmem⟩ := Subtype.ext (by rw [hab, ← hc, hTc])
        rw [hb, ha, hφ]
        exact (hχ c (LinearMap.mem_range_self T c)).symm
      refine ⟨φ.sup χ hagree, LinearPMap.left_le_sup _ _ _, ?_⟩
      rw [LinearPMap.domain_sup]
      refine Submodule.mem_sup_right ⟨1, ?_⟩
      show T 1 = x
      rw [LinearMap.toSpanSingleton_apply, one_smul]
    let gen : Fin k0 → wcChmpModL R ℓ k0 := fun i => Submodule.Quotient.mk (Pi.single i (1 : R))
    have iter : ∀ s : Finset (Fin k0), ∃ φ : wcChmpModL R ℓ k0 →ₗ.[R] Q,
        LinearMap.range e ≤ φ.domain ∧
        (∀ (q : Q) (h : e q ∈ φ.domain), φ ⟨e q, h⟩ = q) ∧ ∀ i ∈ s, gen i ∈ φ.domain := by
      intro s
      induction s using Finset.induction_on with
      | empty =>
        refine ⟨⟨LinearMap.range e,
          ((LinearEquiv.ofInjective e he).symm : LinearMap.range e →ₗ[R] Q)⟩, le_rfl, ?_, by simp⟩
        intro q h
        show (LinearEquiv.ofInjective e he).symm ⟨e q, h⟩ = q
        rw [LinearEquiv.symm_apply_eq]
        ext
        rfl
      | insert a s ha ih =>
        obtain ⟨φ, h1, h2, h3⟩ := ih
        obtain ⟨ψ, hle, hx⟩ := step φ (gen a) (htors k0 _)
        refine ⟨ψ, h1.trans hle.1, ?_, ?_⟩
        · intro q h
          have hq : e q ∈ φ.domain := h1 (LinearMap.mem_range_self e q)
          exact (hle.2 (x := ⟨e q, hq⟩) (y := ⟨e q, h⟩) rfl).symm.trans (h2 q hq)
        · intro i hi
          rcases Finset.mem_insert.mp hi with rfl | hi
          · exact hx
          · exact hle.1 (h3 i hi)
    obtain ⟨φ, h1, h2, h3⟩ := iter Finset.univ
    have htop : ∀ z : wcChmpModL R ℓ k0, z ∈ φ.domain := by
      intro z
      induction z using Submodule.Quotient.induction_on with
      | H y =>
        have hy : y = ∑ i, y i • Pi.single i (1 : R) := by
          ext j
          simp [Finset.sum_apply, Pi.single_apply]
        rw [hy, ← Submodule.mkQ_apply, map_sum]
        refine Submodule.sum_mem _ (fun i _ => ?_)
        rw [map_smul, Submodule.mkQ_apply]
        exact Submodule.smul_mem _ _ (h3 i (Finset.mem_univ i))
    let ρ : wcChmpModL R ℓ k0 →ₗ[R] Q :=
      φ.toFun ∘ₗ LinearMap.codRestrict φ.domain LinearMap.id htop
    have hρ : ρ ∘ₗ e = LinearMap.id := LinearMap.ext fun q => h2 q (htop _)
    intro k p hp
    obtain ⟨h₀, hh₀⟩ := Module.projective_lifting_property p (ρ ∘ₗ Submodule.mkQ _) hp
    have hker : LinearMap.range (ℓ • LinearMap.id : (Fin k0 → R) →ₗ[R] (Fin k0 → R)) ≤
        LinearMap.ker h₀ := by
      rintro _ ⟨w, rfl⟩
      rw [LinearMap.mem_ker, LinearMap.smul_apply, LinearMap.id_apply, map_nsmul]
      exact htors k _
    let h := (LinearMap.range (ℓ • LinearMap.id :
      (Fin k0 → R) →ₗ[R] (Fin k0 → R))).liftQ h₀ hker
    have hph : p ∘ₗ h = ρ := by
      apply Submodule.linearMap_qext
      rw [LinearMap.comp_assoc, Submodule.liftQ_mkQ]
      exact hh₀
    refine ⟨h ∘ₗ e, ?_⟩
    rw [← LinearMap.comp_assoc, hph, hρ]
  exact key (MonoidAlgebra ℤ_[ℓ] Γ) Q hrel hembQ

theorem wc_chmp_lattice_lift (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Γ : Type u) [Group Γ] [Finite Γ]
    (M : Type (u+1)) [AddCommGroup M] [Module (MonoidAlgebra ℤ_[ℓ] Γ) M]
    [Module.Finite (MonoidAlgebra ℤ_[ℓ] Γ) M] (htf : ∀ x : M, ℓ • x = 0 → x = 0)
    (hsplit : ∀ (k : ℕ) (π : (Fin k → MonoidAlgebra ℤ_[ℓ] Γ) →ₗ[MonoidAlgebra ℤ_[ℓ] Γ] M),
      Function.Surjective π →
      ∃ s : wcChmpModBar (MonoidAlgebra ℤ_[ℓ] Γ) ℓ M →ₗ[MonoidAlgebra ℤ_[ℓ] Γ]
          wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k,
        ∀ (x : M) (y : Fin k → MonoidAlgebra ℤ_[ℓ] Γ),
          s (Submodule.Quotient.mk x) = Submodule.Quotient.mk y →
          (Submodule.Quotient.mk (π y) : wcChmpModBar (MonoidAlgebra ℤ_[ℓ] Γ) ℓ M) =
            Submodule.Quotient.mk x) :
    Module.Projective (MonoidAlgebra ℤ_[ℓ] Γ) M :=
by
  classical
  obtain ⟨k, π, hπ⟩ := Module.Finite.exists_fin' (MonoidAlgebra ℤ_[ℓ] Γ) M
  obtain ⟨s, hs⟩ := hsplit k π hπ

  set R := MonoidAlgebra ℤ_[ℓ] Γ with hRdef
  set N := LinearMap.range (ℓ • LinearMap.id : (Fin k → R) →ₗ[R] (Fin k → R)) with hNdef
  set NM := LinearMap.range (ℓ • LinearMap.id : M →ₗ[R] M) with hNMdef
  let E : Fin k → (Fin k → R) := fun i j => if i = j then 1 else 0
  choose y hy using fun i => Submodule.Quotient.mk_surjective N
    (s (Submodule.Quotient.mk (π (E i))))
  have h1 : ∀ i, ∃ v : Fin k → R, π (y i) - π (E i) = ℓ • π v := by
    intro i
    have h := hs (π (E i)) (y i) (hy i).symm
    rw [Submodule.Quotient.eq] at h
    obtain ⟨m, hm⟩ := h
    obtain ⟨v, rfl⟩ := hπ m
    refine ⟨v, ?_⟩
    rw [← hm, LinearMap.smul_apply, LinearMap.id_apply]
  choose v hv using h1
  let κ : Fin k → (Fin k → R) := fun i => E i - y i + ℓ • v i
  have hκ : ∀ i, π (κ i) = 0 := by
    intro i
    simp only [κ, map_add, map_sub, map_nsmul, ← hv i]
    abel
  let τ : (Fin k → R) →ₗ[R] (Fin k → R) :=
    { toFun := fun x => ∑ i, x i • κ i
      map_add' := fun a b => by
        simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
      map_smul' := fun r a => by
        simp only [Pi.smul_apply, smul_eq_mul, mul_smul, RingHom.id_apply, Finset.smul_sum] }
  have hτapp : ∀ x, τ x = ∑ i, x i • κ i := fun x => rfl
  have hτ0 : ∀ x, π (τ x) = 0 := by
    intro x
    rw [hτapp, map_sum]
    simp only [map_smul, hκ, smul_zero, Finset.sum_const_zero]
  have hτ1 : ∀ x, π x = 0 → ∃ z, π z = 0 ∧ τ x - x = ℓ • z := by
    intro x hx
    have key : N.mkQ (∑ i, x i • y i) = (s ∘ₗ NM.mkQ ∘ₗ π) (∑ i, x i • E i) := by
      simp only [map_sum, map_smul]
      refine Finset.sum_congr rfl fun i _ => ?_
      congr 1
      exact hy i
    rw [← pi_eq_sum_univ x, LinearMap.comp_apply, LinearMap.comp_apply, hx, map_zero,
      map_zero, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at key
    obtain ⟨w, hw⟩ := key
    rw [LinearMap.smul_apply, LinearMap.id_apply] at hw
    have hcomm : ∀ i, x i • (ℓ • v i) = ℓ • (x i • v i) := fun i => smul_comm _ _ _
    have hτx : τ x = ∑ i, x i • E i - ∑ i, x i • y i + ℓ • ∑ i, x i • v i := by
      rw [hτapp]
      simp only [κ, smul_add, smul_sub, hcomm, Finset.sum_add_distrib, Finset.sum_sub_distrib,
        Finset.smul_sum]
    have hz : τ x - x = ℓ • (∑ i, x i • v i - w) := by
      rw [hτx, ← pi_eq_sum_univ x, ← hw, smul_sub]
      abel
    refine ⟨∑ i, x i • v i - w, ?_, hz⟩
    apply htf
    rw [← map_nsmul, ← hz, map_sub, hτ0, hx, sub_zero]

  set K := LinearMap.ker π with hKdef
  have hτK : ∀ y, τ y ∈ K := fun y => LinearMap.mem_ker.mpr (hτ0 y)
  let u : K →ₗ[R] K := (LinearMap.codRestrict K τ hτK) ∘ₗ K.subtype
  have hu : ∀ x : K, (u x : Fin k → R) = τ x := fun x => rfl
  have hKnoeth : IsNoetherian ℤ_[ℓ] K := isNoetherian_submodule' (K.restrictScalars ℤ_[ℓ])
  have hℓm : (ℓ : ℤ_[ℓ]) ∈ IsLocalRing.maximalIdeal ℤ_[ℓ] := by
    rw [PadicInt.maximalIdeal_eq_span_p]
    exact Ideal.subset_span rfl
  have hsurj : Function.Surjective (u.restrictScalars ℤ_[ℓ]) := by
    rw [← LinearMap.range_eq_top]
    refine top_le_iff.mp (Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top
      (IsLocalRing.maximalIdeal_le_jacobson _) ?_)
    intro x _
    obtain ⟨z, hz, hzx⟩ := hτ1 x (LinearMap.mem_ker.mp x.2)
    have hzK : z ∈ K := LinearMap.mem_ker.mpr hz
    refine Submodule.mem_sup.mpr ⟨u x, ⟨x, rfl⟩, (ℓ : ℤ_[ℓ]) • (-⟨z, hzK⟩ : K),
      Submodule.smul_mem_smul hℓm trivial, ?_⟩
    apply Subtype.ext
    rw [Submodule.coe_add, hu, Submodule.coe_smul_of_tower, Submodule.coe_neg,
      Nat.cast_smul_eq_nsmul, smul_neg, ← hzx]
    abel
  have hinj : Function.Injective (u.restrictScalars ℤ_[ℓ]) :=
    IsNoetherian.injective_of_surjective_endomorphism _ hsurj
  let e : K ≃ₗ[R] K := LinearEquiv.ofBijective u ⟨hinj, hsurj⟩
  let ρ : (Fin k → R) →ₗ[R] (Fin k → R) :=
    K.subtype ∘ₗ e.symm.toLinearMap ∘ₗ LinearMap.codRestrict K τ hτK
  have hρK : ∀ y, π (ρ y) = 0 := fun y => LinearMap.mem_ker.mp (e.symm _).2
  have hρ : ∀ x, π x = 0 → ρ x = x := by
    intro x hx
    have hxK : x ∈ K := LinearMap.mem_ker.mpr hx
    have h2 : LinearMap.codRestrict K τ hτK x = e ⟨x, hxK⟩ := Subtype.ext rfl
    show ((e.symm (LinearMap.codRestrict K τ hτK x) : K) : Fin k → R) = x
    rw [h2, LinearEquiv.symm_apply_apply]

  have hle : K ≤ LinearMap.ker (LinearMap.id - ρ) := by
    intro x hx
    rw [LinearMap.mem_ker] at hx ⊢
    rw [LinearMap.sub_apply, LinearMap.id_apply, hρ x hx, sub_self]
  let σ : M →ₗ[R] (Fin k → R) :=
    (K.liftQ (LinearMap.id - ρ) hle) ∘ₗ (π.quotKerEquivOfSurjective hπ).symm.toLinearMap
  refine Module.Projective.of_split σ π ?_
  refine LinearMap.ext fun m => ?_
  obtain ⟨y0, rfl⟩ := hπ m
  have h3 : (π.quotKerEquivOfSurjective hπ).symm (π y0) = Submodule.Quotient.mk y0 := by
    rw [LinearEquiv.symm_apply_eq, LinearMap.quotKerEquivOfSurjective_apply_mk]
  show π (K.liftQ (LinearMap.id - ρ) hle ((π.quotKerEquivOfSurjective hπ).symm (π y0))) = π y0
  rw [h3, Submodule.liftQ_apply, LinearMap.sub_apply, LinearMap.id_apply, map_sub, hρK, sub_zero]

theorem wc_chmp_res_ring_injective (S : Scheme.{u}) (U : S.ProEt) (R : Type u) [Ring R]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (lamG : R → (G ⟶ G))
    (I : InjectiveResolution G) (lamI : R → (I.cocomplex ⟶ I.cocomplex))
    (hI : wcRingResSpec lamG I lamI) (n : ℕ) :
    wcChmpInjD (fun r => ((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf S U))).mapHomologicalComplex
      (ComplexShape.up ℕ)).map (lamI r)) n :=
by
  classical
  unfold wcRingResSpec at hI
  obtain ⟨-, -, hIext⟩ := hI
  unfold wcChmpInjD
  intro A B i hi g hg

  have extP : ∀ {M : Type (u+1)} [AddCommGroup M] {Q : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
      (α β : wcRriP S U M ⟶ Q),
      (∀ (T : (S.ProEt)ᵒᵖ) (φ : ULift.{u+1} (T.unop ⟶ U)) (m : M),
        (α.app T).hom (Finsupp.single φ m) = (β.app T).hom (Finsupp.single φ m)) → α = β :=
    fun α β h => NatTrans.ext (funext fun T => AddCommGrpCat.hom_ext (Finsupp.addHom_ext (h T)))
  have extZ : ∀ {Q : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
      (α β : (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Q),
      (∀ (T : (S.ProEt)ᵒᵖ) (φ : ULift.{u+1} (T.unop ⟶ U)),
        (α.app T).hom (FreeAbelianGroup.of φ) = (β.app T).hom (FreeAbelianGroup.of φ)) → α = β :=
    fun α β h => NatTrans.ext (funext fun T => AddCommGrpCat.hom_ext
      (FreeAbelianGroup.lift_ext _ _ (h T)))

  have appMap : ∀ {M N : Type (u+1)} [AddCommGroup M] [AddCommGroup N] (f : M →+ N)
      (T : (S.ProEt)ᵒᵖ) (φ : ULift.{u+1} (T.unop ⟶ U)) (m : M),
      ((wcRriMap S U f).app T).hom (Finsupp.single φ m) = Finsupp.single φ (f m) :=
    fun f T φ m => Finsupp.mapRange_single (hf := map_zero f)
  have appIota : ∀ {M : Type (u+1)} [AddCommGroup M] (m : M)
      (T : (S.ProEt)ᵒᵖ) (φ : ULift.{u+1} (T.unop ⟶ U)),
      ((wcRriIota S U m).app T).hom (FreeAbelianGroup.of φ) = Finsupp.single φ m :=
    fun m T φ => FreeAbelianGroup.lift_apply_of _ _
  have compApp : ∀ {F G H : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (α : F ⟶ G) (β : G ⟶ H)
      (T : (S.ProEt)ᵒᵖ) (x : F.obj T),
      ((α ≫ β).app T).hom x = (β.app T).hom ((α.app T).hom x) := fun _ _ _ _ => rfl
  have addApp : ∀ {F G : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (α β : F ⟶ G)
      (T : (S.ProEt)ᵒᵖ) (x : F.obj T),
      ((α + β).app T).hom x = (α.app T).hom x + (β.app T).hom x := fun _ _ _ _ => rfl
  have idApp : ∀ {F : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (T : (S.ProEt)ᵒᵖ) (x : F.obj T),
      ((𝟙 F : F ⟶ F).app T).hom x = x := fun _ _ => rfl
  have smulApp : ∀ (M : ModuleCat.{u+1} R) (r : R) (m : ↑M),
      DistribSMul.toAddMonoidHom (↑M) r m = r • m := fun _ _ _ => rfl

  have hact : ∀ (M : ModuleCat.{u+1} R),
      wcRingAct (fun r : R => (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
        (wcRriMap S U (DistribSMul.toAddMonoidHom (↑M) r))) := by
    intro M
    have h1 : wcRriMap S U (DistribSMul.toAddMonoidHom (↑M) (1 : R)) = 𝟙 _ :=
      extP _ _ (fun T φ m => by
        refine (appMap (DistribSMul.toAddMonoidHom (↑M) (1 : R)) T φ m).trans
          (Eq.trans ?_ (idApp T _).symm)
        exact congrArg (Finsupp.single φ) (one_smul R m))
    have h2 : ∀ r s : R, wcRriMap S U (DistribSMul.toAddMonoidHom (↑M) (r + s)) =
        wcRriMap S U (DistribSMul.toAddMonoidHom (↑M) r) +
          wcRriMap S U (DistribSMul.toAddMonoidHom (↑M) s) :=
      fun r s => extP _ _ (fun T φ m => by
        refine (appMap (DistribSMul.toAddMonoidHom (↑M) (r + s)) T φ m).trans
          (Eq.trans ?_ (addApp _ _ T _).symm)
        refine Eq.trans ?_ (congrArg₂ (· + ·) (appMap (DistribSMul.toAddMonoidHom (↑M) r) T φ m)
          (appMap (DistribSMul.toAddMonoidHom (↑M) s) T φ m)).symm
        exact (congrArg (Finsupp.single φ) (add_smul r s m)).trans
          (Finsupp.single_add φ (r • m) (s • m)))
    have h3 : ∀ r s : R, wcRriMap S U (DistribSMul.toAddMonoidHom (↑M) (r * s)) =
        wcRriMap S U (DistribSMul.toAddMonoidHom (↑M) s) ≫
          wcRriMap S U (DistribSMul.toAddMonoidHom (↑M) r) :=
      fun r s => extP _ _ (fun T φ m => by
        refine (appMap (DistribSMul.toAddMonoidHom (↑M) (r * s)) T φ m).trans
          (Eq.trans ?_ (compApp _ _ T _).symm)
        exact (congrArg (Finsupp.single φ) (mul_smul r s m)).trans
          ((appMap (DistribSMul.toAddMonoidHom (↑M) r) T φ (s • m)).symm.trans
            (congrArg (fun y => ((wcRriMap S U (DistribSMul.toAddMonoidHom (↑M) r)).app T).hom y)
              (appMap (DistribSMul.toAddMonoidHom (↑M) s) T φ m).symm)))
    unfold wcRingAct
    refine ⟨?_, fun r s => ?_, fun r s => ?_⟩
    · beta_reduce
      rw [h1, CategoryTheory.Functor.map_id]
    · beta_reduce
      rw [h2 r s, CategoryTheory.Functor.map_add]
    · beta_reduce
      rw [h3 r s, CategoryTheory.Functor.map_comp]

  have hjapp : ∀ T, Mono ((wcRriMap S U i.hom.toAddMonoidHom).app T) := fun T =>
    (AddCommGrpCat.mono_iff_injective _).mpr (fun a b hab =>
      Finsupp.mapRange_injective (⇑i.hom) (map_zero _) hi hab)
  haveI hj : Mono (wcRriMap S U i.hom.toAddMonoidHom) := NatTrans.mono_of_mono_app _
  haveI hj' : Mono ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
      (wcRriMap S U i.hom.toAddMonoidHom)) := inferInstance
  have hmj : ∀ r : R, wcRriMap S U (DistribSMul.toAddMonoidHom (↑A) r) ≫
      wcRriMap S U i.hom.toAddMonoidHom =
      wcRriMap S U i.hom.toAddMonoidHom ≫ wcRriMap S U (DistribSMul.toAddMonoidHom (↑B) r) :=
    fun r => extP _ _ (fun T φ m => by
      refine (compApp _ _ T _).trans (Eq.trans ?_ (compApp _ _ T _).symm)
      exact (congrArg (fun y => ((wcRriMap S U i.hom.toAddMonoidHom).app T).hom y)
          (appMap (DistribSMul.toAddMonoidHom (↑A) r) T φ m)).trans
        ((appMap i.hom.toAddMonoidHom T φ (r • m)).trans
        ((congrArg (Finsupp.single φ) (map_smul i.hom r m)).trans
        ((appMap (DistribSMul.toAddMonoidHom (↑B) r) T φ (i.hom m)).symm.trans
        (congrArg (fun y => ((wcRriMap S U (DistribSMul.toAddMonoidHom (↑B) r)).app T).hom y)
          (appMap i.hom.toAddMonoidHom T φ m).symm)))))
  have hcompat : ∀ r : R,
      (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
        (wcRriMap S U (DistribSMul.toAddMonoidHom (↑A) r)) ≫
      (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
        (wcRriMap S U i.hom.toAddMonoidHom) =
      (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
        (wcRriMap S U i.hom.toAddMonoidHom) ≫
      (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
        (wcRriMap S U (DistribSMul.toAddMonoidHom (↑B) r)) := by
    intro r
    rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp, hmj r]

  have hιadd : ∀ b b' : ↑B, (wcRriIota S U (b + b') : _ ⟶ wcRriP S U ↑B) =
      wcRriIota S U b + wcRriIota S U b' :=
    fun b b' => extZ _ _ (fun T φ => by
      refine (appIota (b + b') T φ).trans (Eq.trans ?_ (addApp _ _ T _).symm)
      exact (Finsupp.single_add φ b b').trans
        (congrArg₂ (· + ·) (appIota b T φ) (appIota b' T φ)).symm)
  have hιsmul : ∀ (r : R) (b : ↑B), (wcRriIota S U (r • b) : _ ⟶ wcRriP S U ↑B) =
      wcRriIota S U b ≫ wcRriMap S U (DistribSMul.toAddMonoidHom (↑B) r) :=
    fun r b => extZ _ _ (fun T φ => by
      refine (appIota (r • b) T φ).trans (Eq.trans ?_ (compApp _ _ T _).symm)
      exact (appMap (DistribSMul.toAddMonoidHom (↑B) r) T φ b).symm.trans
        (congrArg (fun y => ((wcRriMap S U (DistribSMul.toAddMonoidHom (↑B) r)).app T).hom y)
          (appIota b T φ).symm))
  have hιi : ∀ x : ↑A, (wcRriIota S U (i.hom x) : _ ⟶ wcRriP S U ↑B) =
      wcRriIota S U x ≫ wcRriMap S U i.hom.toAddMonoidHom :=
    fun x => extZ _ _ (fun T φ => by
      refine (appIota (i.hom x) T φ).trans (Eq.trans ?_ (compApp _ _ T _).symm)
      exact (appMap i.hom.toAddMonoidHom T φ x).symm.trans
        (congrArg (fun y => ((wcRriMap S U i.hom.toAddMonoidHom).app T).hom y)
          (appIota x T φ).symm))

  obtain ⟨gs, hgs⟩ : ∃ gs : ↑A → ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj
      (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ I.cocomplex.X n),
      ∀ x, gs x = g x := ⟨fun x => g x, fun x => rfl⟩
  have hgs_add : ∀ x y : ↑A, gs (x + y) = gs x + gs y := fun x y => by
    rw [hgs, hgs, hgs]; exact map_add g x y
  have hgs_lin : ∀ (r : R) (x : ↑A), gs (r • x) = gs x ≫ (lamI r).f n := fun r x => by
    rw [hgs, hgs]; exact hg r x

  obtain ⟨g', hg'⟩ : ∃ g' : ↑A →+ ((yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
      (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj (I.cocomplex.X n)),
      ∀ x, g' x = (sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
        _ _ (gs x) := by
    refine ⟨AddMonoidHom.mk' (fun x =>
      (sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
        _ _ (gs x)) ?_, fun x => rfl⟩
    intro x y
    rw [hgs_add, Adjunction.homEquiv_unit, Adjunction.homEquiv_unit, Adjunction.homEquiv_unit,
      Functor.map_add, Preadditive.comp_add]
  have hg'lin : ∀ (r : R) (x : ↑A), g' (r • x) =
      g' x ≫ (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map ((lamI r).f n) := by
    intro r x
    rw [hg', hg', hgs_lin, Adjunction.homEquiv_naturality_right]
  have appLift : ∀ (T : (S.ProEt)ᵒᵖ) (φ : ULift.{u+1} (T.unop ⟶ U)) (m : ↑A),
      ((wcRriLift S U g').app T).hom (Finsupp.single φ m) =
        ((g' m).app T).hom (FreeAbelianGroup.of φ) :=
    fun T φ m => Finsupp.liftAddHom_apply_single _ _ _

  have hg0eq : ∀ r : R, wcRriMap S U (DistribSMul.toAddMonoidHom (↑A) r) ≫ wcRriLift S U g' =
      wcRriLift S U g' ≫
        (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map ((lamI r).f n) := by
    intro r
    refine extP _ _ (fun T φ m => ?_)
    refine (compApp _ _ T _).trans (Eq.trans ?_ (compApp _ _ T _).symm)
    refine (congrArg (fun y => ((wcRriLift S U g').app T).hom y)
      (appMap (DistribSMul.toAddMonoidHom (↑A) r) T φ m)).trans ?_
    refine (appLift T φ (r • m)).trans ?_
    refine (congrArg (fun α => (α.app T).hom
      (FreeAbelianGroup.of φ : (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).obj T))
      (hg'lin r m)).trans ?_
    refine (compApp _ _ T _).trans ?_
    exact congrArg (fun y => (((sheafToPresheaf (Scheme.ProEt.topology S)
      AddCommGrpCat.{u+1}).map ((lamI r).f n)).app T).hom y) (appLift T φ m).symm
  have hιg0 : ∀ x : ↑A, wcRriIota S U x ≫ wcRriLift S U g' = g' x := by
    intro x
    refine extZ _ _ (fun T φ => ?_)
    refine (compApp _ _ T _).trans ?_
    exact (congrArg (fun y => ((wcRriLift S U g').app T).hom y) (appIota x T φ)).trans
      (appLift T φ x)

  obtain ⟨gt, hgtdef⟩ : ∃ gt, gt =
      ((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
        (wcRriP S U ↑A) (I.cocomplex.X n)).symm (wcRriLift S U g') := ⟨_, rfl⟩
  have hgt : ∀ r : R, (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
      (wcRriMap S U (DistribSMul.toAddMonoidHom (↑A) r)) ≫ gt = gt ≫ (lamI r).f n := by
    intro r
    rw [hgtdef, ← Adjunction.homEquiv_naturality_left_symm, hg0eq,
      Adjunction.homEquiv_naturality_right_symm]

  obtain ⟨ht, hti, htlin⟩ := hIext n
    ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
      (wcRriMap S U i.hom.toAddMonoidHom))
    (fun r => (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
      (wcRriMap S U (DistribSMul.toAddMonoidHom (↑A) r)))
    (fun r => (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
      (wcRriMap S U (DistribSMul.toAddMonoidHom (↑B) r)))
    (hact A) (hact B) hcompat gt hgt
  refine ⟨AddMonoidHom.mk' (fun b =>
    ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map (wcRriIota S U b) ≫ ht :
      wcFreeSheaf S U ⟶ I.cocomplex.X n)) ?_, ?_, ?_⟩
  · intro b b'
    show (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
        (wcRriIota S U (b + b')) ≫ ht =
      (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map (wcRriIota S U b) ≫ ht +
      (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map (wcRriIota S U b') ≫ ht
    rw [hιadd, Functor.map_add, Preadditive.add_comp]
  · intro r b
    show (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
        (wcRriIota S U (r • b)) ≫ ht =
      ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map (wcRriIota S U b) ≫ ht)
        ≫ (lamI r).f n
    rw [hιsmul, Functor.map_comp, Category.assoc, htlin, Category.assoc]
  · intro x
    refine Eq.trans ?_ (hgs x)
    show (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
        (wcRriIota S U (i.hom x)) ≫ ht = gs x
    rw [hιi, Functor.map_comp, Category.assoc, hti, hgtdef,
      ← Adjunction.homEquiv_naturality_left_symm, hιg0, hg', Equiv.symm_apply_apply]

theorem wc_cgev_free_resolution {R : Type u} [Ring R] [IsNoetherianRing R]
    (N : ModuleCat.{u+1} R) [Module.Finite R N] : Nonempty (wcCgevRes N) :=
by
  classical
  obtain ⟨a₀, s, hs⟩ := Module.Finite.exists_fin (R := R) (M := N)
  let ε : (Fin a₀ → R) →ₗ[R] N := Fintype.linearCombination R s
  have hεs : Function.Surjective ε := by
    rw [← LinearMap.range_eq_top]
    show LinearMap.range (Fintype.linearCombination R s) = ⊤
    rw [Fintype.range_linearCombination, hs]
  have hgen : ∀ (n : ℕ) (K : Submodule R (Fin n → R)),
      ∃ (m : ℕ) (g : Fin m → (Fin n → R)), Submodule.span R (Set.range g) = K :=
    fun n K => Submodule.fg_iff_exists_fin_generating_family.mp (IsNoetherian.noetherian K)
  choose m g hg using hgen
  have hid : ∀ (k n : ℕ) (g : Fin k → (Fin n → R)) (w : Fin k → R),
      Matrix.vecMul w (Matrix.of g) = ∑ i, w i • g i := by
    intro k n g w
    funext j
    simp [Matrix.vecMul, dotProduct, Finset.sum_apply]
  have key : ∀ (k n : ℕ) (g : Fin k → (Fin n → R)) (v : Fin n → R),
      v ∈ Submodule.span R (Set.range g) ↔
        ∃ w : Fin k → R, Matrix.vecMul w (Matrix.of g) = v := by
    intro k n g v
    rw [Submodule.mem_span_range_iff_exists_fun]
    simp only [hid]
  have key2 : ∀ (n : ℕ) (K : Submodule R (Fin n → R)) (v : Fin n → R),
      v ∈ K ↔ ∃ w : Fin (m n K) → R, Matrix.vecMul w (Matrix.of (g n K)) = v := by
    intro n K v
    have h := key _ _ (g n K) v
    rwa [hg n K] at h
  have memK : ∀ (n : ℕ) (K : Submodule R (Fin n → R)) (k : Fin (m n K)), g n K k ∈ K := by
    intro n K k
    have h : g n K k ∈ Submodule.span R (Set.range (g n K)) := Submodule.subset_span ⟨k, rfl⟩
    rwa [hg n K] at h
  let St := Σ n : ℕ, Submodule R (Fin n → R)
  let step : St → St := fun s =>
    ⟨m s.1 s.2, LinearMap.ker (Matrix.vecMulLinear (Matrix.of (g s.1 s.2)))⟩
  let st : ℕ → St := fun p =>
    Nat.rec (motive := fun _ => St) ⟨a₀, LinearMap.ker ε⟩ (fun _ s => step s) p
  refine ⟨{ a := fun p => (st p).1
            c := fun p => Matrix.of (g (st p).1 (st p).2)
            ε := ε
            surj := hεs
            ex0 := ?_
            ex := ?_
            hcc := ?_ }⟩
  · intro v
    rw [← LinearMap.mem_ker]
    exact key2 (st 0).1 (st 0).2 v
  · intro p v
    show Matrix.vecMulLinear (Matrix.of (g (st p).1 (st p).2)) v = 0 ↔ _
    rw [← LinearMap.mem_ker]
    exact key2 (st (p + 1)).1 (st (p + 1)).2 v
  · intro p
    ext k j
    have hk : g (st (p + 1)).1 (st (p + 1)).2 k ∈ (st (p + 1)).2 :=
      memK (st (p + 1)).1 (st (p + 1)).2 k
    have hk' : g (st (p + 1)).1 (st (p + 1)).2 k ∈
        LinearMap.ker (Matrix.vecMulLinear (Matrix.of (g (st p).1 (st p).2))) := hk
    have h2 := congrFun (LinearMap.mem_ker.mp hk') j
    rw [Matrix.vecMulLinear_apply] at h2
    simp only [Matrix.vecMul, dotProduct, Matrix.of_apply, Pi.zero_apply] at h2
    simp only [Matrix.mul_apply, Matrix.of_apply, Matrix.zero_apply]
    exact h2

theorem wc_cgev_coind_exact (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Γ : Type u) [Group Γ] [Finite Γ]
    (N : ModuleCat.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ)) (Rs : wcCgevRes N)
    (M : Type (u+1)) [AddCommGroup M] (act : MonoidAlgebra ℤ_[ℓ] Γ → (M →+ M))
    (hact1 : act 1 = AddMonoidHom.id M)
    (hactadd : ∀ a b, act (a + b) = act a + act b)
    (hactmul : ∀ a b, act (a * b) = (act a).comp (act b))
    (A : Type*) [AddCommGroup A] [Module ℤ_[ℓ] A] (π : M →+ A)
    (hπs : ∀ (a : ℤ_[ℓ]) (x : M), π (act (MonoidAlgebra.single 1 a) x) = a • π x)
    (hπb : Function.Bijective (fun (x : M) (g : Γ) => π (act (MonoidAlgebra.single g 1) x))) :
    ∀ (p : ℕ) (y : Fin (Rs.a (p + 2)) → M),
      (∀ i, ∑ j, act (Rs.c (p + 2) i j) (y j) = 0) →
      ∃ z : Fin (Rs.a (p + 1)) → M, ∀ i, ∑ j, act (Rs.c (p + 1) i j) (z j) = y i :=
by
  classical

  have hact0 : act 0 = 0 := by
    have h := hactadd 0 0
    rw [add_zero] at h
    exact add_left_cancel (h.symm.trans (add_zero _).symm)

  have actsum : ∀ (m : ℕ) (f : Fin m → MonoidAlgebra ℤ_[ℓ] Γ) (x : M),
      act (∑ i, f i) x = ∑ i, act (f i) x := by
    intro m f x
    induction (Finset.univ : Finset (Fin m)) using Finset.induction_on with
    | empty => simp [hact0]
    | insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha, hactadd, AddMonoidHom.add_apply, ih]

  have adj : ∀ (m n : ℕ) (C : Matrix (Fin m) (Fin n) (MonoidAlgebra ℤ_[ℓ] Γ))
      (w : Fin m → MonoidAlgebra ℤ_[ℓ] Γ) (y : Fin n → M),
      ∑ i, act (w i) (∑ j, act (C i j) (y j)) = ∑ j, act (Matrix.vecMul w C j) (y j) := by
    intro m n C w y
    simp only [map_sum, Matrix.vecMul, dotProduct, actsum, hactmul, AddMonoidHom.comp_apply]
    exact Finset.sum_comm

  have smul_eq : ∀ (b : ℤ_[ℓ]) (r : MonoidAlgebra ℤ_[ℓ] Γ),
      b • r = MonoidAlgebra.single 1 b * r := by
    intro b r
    rw [Algebra.smul_def, MonoidAlgebra.coe_algebraMap]
    simp

  have mkφ : ∀ (n : ℕ) (y : Fin n → M), ∃ φ : (Fin n → MonoidAlgebra ℤ_[ℓ] Γ) →ₗ[ℤ_[ℓ]] A,
      ∀ v, φ v = π (∑ j, act (v j) (y j)) := by
    intro n y
    refine ⟨{ toFun := fun v => π (∑ j, act (v j) (y j)), map_add' := ?_, map_smul' := ?_ },
      fun v => rfl⟩
    · intro v v'
      simp only [Pi.add_apply, hactadd, AddMonoidHom.add_apply, Finset.sum_add_distrib, map_add]
    · intro b v
      simp only [Pi.smul_apply, smul_eq, hactmul, AddMonoidHom.comp_apply, RingHom.id_apply]
      rw [show (∑ j, act (MonoidAlgebra.single 1 b) (act (v j) (y j))) =
          act (MonoidAlgebra.single 1 b) (∑ j, act (v j) (y j)) from (map_sum _ _ _).symm, hπs]

  have inj : ∀ (n : ℕ) (y : Fin n → M),
      (∀ v : Fin n → MonoidAlgebra ℤ_[ℓ] Γ, π (∑ j, act (v j) (y j)) = 0) → y = 0 := by
    intro n y hv
    funext k
    apply hπb.1
    funext g
    have h := hv (Pi.single k (MonoidAlgebra.single g 1))
    rw [Finset.sum_eq_single k (fun j _ hj => by
      rw [Pi.single_eq_of_ne hj, hact0, AddMonoidHom.zero_apply]) (by simp),
      Pi.single_eq_same] at h
    show π (act (MonoidAlgebra.single g 1) (y k)) =
      π (act (MonoidAlgebra.single g 1) ((0 : Fin n → M) k))
    rw [Pi.zero_apply, map_zero, map_zero]
    exact h

  have surj : ∀ (n : ℕ) (ψ : (Fin n → MonoidAlgebra ℤ_[ℓ] Γ) →ₗ[ℤ_[ℓ]] A),
      ∃ z : Fin n → M, ∀ v, π (∑ j, act (v j) (z j)) = ψ v := by
    intro n ψ
    have hz : ∀ k : Fin n, ∃ x : M, (fun g : Γ => π (act (MonoidAlgebra.single g 1) x)) =
        fun g => ψ (Pi.single k (MonoidAlgebra.single g 1)) := fun k => hπb.2 _
    choose z hz using hz
    have key : ∀ k (r : MonoidAlgebra ℤ_[ℓ] Γ), π (act r (z k)) = ψ (Pi.single k r) := by
      intro k r
      induction r using MonoidAlgebra.induction_linear with
      | zero => simp [hact0]
      | add f g hf hg =>
        rw [hactadd, AddMonoidHom.add_apply, map_add, hf, hg, Pi.single_add, map_add]
      | single g b =>
        have e : MonoidAlgebra.single g b =
            MonoidAlgebra.single 1 b * MonoidAlgebra.single g (1 : ℤ_[ℓ]) := by
          rw [MonoidAlgebra.single_mul_single, one_mul, mul_one]
        have hzk : π (act (MonoidAlgebra.single g 1) (z k)) =
            ψ (Pi.single k (MonoidAlgebra.single g 1)) := congrFun (hz k) g
        rw [e, hactmul, AddMonoidHom.comp_apply, hπs, hzk, ← smul_eq, Pi.single_smul, map_smul]
    refine ⟨z, fun v => ?_⟩
    rw [map_sum]
    simp only [key]
    conv_rhs => rw [← Finset.univ_sum_single v]
    rw [map_sum]

  have lift : ∀ (a0 a1 a2 a3 : ℕ) (C0 : Matrix (Fin a1) (Fin a0) (MonoidAlgebra ℤ_[ℓ] Γ))
      (C1 : Matrix (Fin a2) (Fin a1) (MonoidAlgebra ℤ_[ℓ] Γ))
      (C2 : Matrix (Fin a3) (Fin a2) (MonoidAlgebra ℤ_[ℓ] Γ)), C1 * C0 = 0 →
      (∀ v : Fin a1 → MonoidAlgebra ℤ_[ℓ] Γ, Matrix.vecMul v C0 = 0 →
        ∃ w : Fin a2 → MonoidAlgebra ℤ_[ℓ] Γ, Matrix.vecMul w C1 = v) →
      (∀ v : Fin a2 → MonoidAlgebra ℤ_[ℓ] Γ, Matrix.vecMul v C1 = 0 →
        ∃ w : Fin a3 → MonoidAlgebra ℤ_[ℓ] Γ, Matrix.vecMul w C2 = v) →
      ∀ φ : (Fin a2 → MonoidAlgebra ℤ_[ℓ] Γ) →ₗ[ℤ_[ℓ]] A,
      (∀ w : Fin a3 → MonoidAlgebra ℤ_[ℓ] Γ, φ (Matrix.vecMul w C2) = 0) →
      ∃ ψ : (Fin a1 → MonoidAlgebra ℤ_[ℓ] Γ) →ₗ[ℤ_[ℓ]] A,
        ∀ v : Fin a2 → MonoidAlgebra ℤ_[ℓ] Γ, ψ (Matrix.vecMul v C1) = φ v := by
    intro a0 a1 a2 a3 C0 C1 C2 h10 hex0 hex1 φ hφ
    let D : (Fin a2 → MonoidAlgebra ℤ_[ℓ] Γ) →ₗ[ℤ_[ℓ]] (Fin a1 → MonoidAlgebra ℤ_[ℓ] Γ) :=
      { toFun := fun v => Matrix.vecMul v C1
        map_add' := fun v v' => by rw [Matrix.add_vecMul]
        map_smul' := fun b v => by simp [Matrix.smul_vecMul] }
    let E : (Fin a1 → MonoidAlgebra ℤ_[ℓ] Γ) →ₗ[ℤ_[ℓ]] (Fin a0 → MonoidAlgebra ℤ_[ℓ] Γ) :=
      { toFun := fun v => Matrix.vecMul v C0
        map_add' := fun v v' => by rw [Matrix.add_vecMul]
        map_smul' := fun b v => by simp [Matrix.smul_vecMul] }
    obtain ⟨σ, hσ⟩ := LinearMap.exists_rightInverse_of_surjective E.rangeRestrict
      (LinearMap.range_rangeRestrict E)
    obtain ⟨τ, hτ⟩ := LinearMap.exists_rightInverse_of_surjective D.rangeRestrict
      (LinearMap.range_rangeRestrict D)
    have hEσ : ∀ t : LinearMap.range E, E (σ t) = t := fun t =>
      congrArg Subtype.val (LinearMap.congr_fun hσ t)
    have hDτ : ∀ t : LinearMap.range D, D (τ t) = t := fun t =>
      congrArg Subtype.val (LinearMap.congr_fun hτ t)
    let ρ0 : (Fin a1 → MonoidAlgebra ℤ_[ℓ] Γ) →ₗ[ℤ_[ℓ]] (Fin a1 → MonoidAlgebra ℤ_[ℓ] Γ) :=
      LinearMap.id - σ ∘ₗ E.rangeRestrict
    have hρ0 : ∀ x, ρ0 x ∈ LinearMap.range D := by
      intro x
      have hE : Matrix.vecMul (ρ0 x) C0 = 0 := by
        change E (x - σ (E.rangeRestrict x)) = 0
        rw [map_sub, hEσ]
        exact sub_self _
      obtain ⟨w, hw⟩ := hex0 _ hE
      exact ⟨w, hw⟩
    refine ⟨φ ∘ₗ τ ∘ₗ LinearMap.codRestrict _ ρ0 hρ0, fun v => ?_⟩
    have hED : E.rangeRestrict (D v) = 0 := by
      apply Subtype.ext
      change Matrix.vecMul (Matrix.vecMul v C1) C0 = 0
      rw [Matrix.vecMul_vecMul, h10, Matrix.vecMul_zero]
    have hρD : LinearMap.codRestrict _ ρ0 hρ0 (D v) = D.rangeRestrict v := by
      apply Subtype.ext
      change D v - σ (E.rangeRestrict (D v)) = D v
      rw [hED, map_zero, sub_zero]
    have hu : Matrix.vecMul (τ (D.rangeRestrict v) - v) C1 = 0 := by
      change D (τ (D.rangeRestrict v) - v) = 0
      rw [map_sub, hDτ]
      exact sub_self _
    obtain ⟨w, hw⟩ := hex1 _ hu
    have hφu : φ (τ (D.rangeRestrict v) - v) = 0 := by rw [← hw]; exact hφ w
    change φ (τ (LinearMap.codRestrict _ ρ0 hρ0 (D v))) = φ v
    rw [hρD]
    rw [map_sub, sub_eq_zero] at hφu
    exact hφu

  intro p
  show ∀ (y : Fin (Rs.a (p + 1 + 1)) → M),
    (∀ i, ∑ j, act (Rs.c (p + 1 + 1) i j) (y j) = 0) →
    ∃ z : Fin (Rs.a (p + 1)) → M, ∀ i, ∑ j, act (Rs.c (p + 1) i j) (z j) = y i
  intro y hy
  obtain ⟨φ, hφ⟩ := mkφ _ y
  have hφ0 : ∀ w : Fin (Rs.a (p + 1 + 1 + 1)) → MonoidAlgebra ℤ_[ℓ] Γ,
      φ (Matrix.vecMul w (Rs.c (p + 1 + 1))) = 0 := by
    intro w
    rw [hφ, ← adj]
    simp only [hy, map_zero, Finset.sum_const_zero]
  obtain ⟨ψ, hψ⟩ := lift _ _ _ _ (Rs.c p) (Rs.c (p + 1)) (Rs.c (p + 1 + 1)) (Rs.hcc p)
    (fun v h => (Rs.ex p v).mp h) (fun v h => (Rs.ex (p + 1) v).mp h) φ hφ0
  obtain ⟨z, hz⟩ := surj _ ψ
  refine ⟨z, ?_⟩
  have he := inj _ (fun i => ∑ j, act (Rs.c (p + 1) i j) (z j) - y i) (fun v => by
    simp only [map_sub, Finset.sum_sub_distrib]
    rw [adj, hz, hψ, hφ, sub_self])
  intro i
  exact sub_eq_zero.mp (congrFun he i)

theorem wc_cover_presheaf_coind (K : Type u) [Field K] [Finite K]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α) (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
    (T : (wcP1Over K).left.ProEt) (t : T.left ⟶ V) (ht : T.hom = t ≫ q' ≫ Uo.ι) :
    ∃ (A : Type u) (_ : AddCommGroup A) (_ : Module ℤ_[ℓ] A)
      (π : (wcCcPre (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ).obj
        (Opposite.op T) →+ A),
      (∀ (a : ℤ_[ℓ]) x, π (((wcCcScalP (q' ≫ Uo.ι)
          (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ a).app (Opposite.op T)).hom x) =
        a • π x) ∧
      Function.Bijective (fun x (g : Γ) => π (((wcCcActP (q' ≫ Uo.ι)
          (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (α g⁻¹).hom (hα g⁻¹)).app
            (Opposite.op T)).hom x)) :=
by
  classical
  obtain ⟨hfin, -, -, -, hα', hiso⟩ := hG
  haveI : Finite Γ := hfin

  open CategoryTheory.Limits in
  have s1 : ∀ {X W V T₀ : Scheme.{u}} (q' : V ⟶ W) (ι : W ⟶ X) [Mono ι] (Γ : Type u) [Finite Γ]
      (β : Γ → (V ⟶ V)) (hβ : ∀ γ, β γ ≫ q' = q')
      (_ : IsIso (Sigma.desc (fun γ : Γ => pullback.lift (β γ) (𝟙 V)
        ((hβ γ).trans (Category.id_comp q').symm)) : ∐ (fun _ : Γ => V) ⟶ pullback q' q'))
      (h : T₀ ⟶ X) (t : T₀ ⟶ V) (_ : h = t ≫ q' ≫ ι)
      (s : Γ → (T₀ ⟶ pullback h (q' ≫ ι)))
      (_ : ∀ γ, s γ ≫ pullback.fst h (q' ≫ ι) = 𝟙 T₀)
      (_ : ∀ γ, s γ ≫ pullback.snd h (q' ≫ ι) = t ≫ β γ),
      IsIso (Sigma.desc s) := by
    intro X W V T₀ q' ι _ Γ _ β hβ hiso h t ht s hs1 hs2
    let a : Cofan (fun _ : Γ => V) := Cofan.mk (pullback q' q') (fun γ => pullback.lift (β γ) (𝟙 V)
        ((hβ γ).trans (Category.id_comp q').symm))
    have hc : IsColimit a := ((Cofan.nonempty_isColimit_iff_isIso_sigmaDesc a).mpr hiso).some
    have hau : IsUniversalColimit a := FinitaryPreExtensive.isUniversal_finiteCoproducts hc
    have w₀ : pullback.snd h (q' ≫ ι) ≫ q' = (pullback.fst h (q' ≫ ι) ≫ t) ≫ q' := by
      apply (cancel_mono ι).mp
      simp only [Category.assoc]
      rw [← ht]
      exact pullback.condition.symm
    let p₂ : pullback h (q' ≫ ι) ⟶ pullback q' q' :=
      pullback.lift (pullback.snd h (q' ≫ ι)) (pullback.fst h (q' ≫ ι) ≫ t) w₀
    have hp₂f : p₂ ≫ pullback.fst q' q' = pullback.snd h (q' ≫ ι) := pullback.lift_fst _ _ _
    have hp₂s : p₂ ≫ pullback.snd q' q' = pullback.fst h (q' ≫ ι) ≫ t := pullback.lift_snd _ _ _
    have h₀ : IsPullback (pullback.fst h (q' ≫ ι)) p₂ t (pullback.snd q' q') := by
      refine IsPullback.of_isLimit (c := PullbackCone.mk (pullback.fst h (q' ≫ ι)) p₂ hp₂s.symm) ?_
      have w₁ : ∀ c : PullbackCone t (pullback.snd q' q'),
          c.fst ≫ h = (c.snd ≫ pullback.fst q' q') ≫ q' ≫ ι := by
        intro c
        have hc' := c.condition
        calc c.fst ≫ h = (c.fst ≫ t) ≫ q' ≫ ι := by rw [ht, Category.assoc]
          _ = (c.snd ≫ pullback.snd q' q') ≫ q' ≫ ι := by rw [hc']
          _ = (c.snd ≫ pullback.fst q' q') ≫ q' ≫ ι := by
            simp only [Category.assoc, pullback.condition_assoc]
      refine PullbackCone.IsLimit.mk _
        (fun c => pullback.lift c.fst (c.snd ≫ pullback.fst q' q') (w₁ c)) ?_ ?_ ?_
      · intro c
        exact pullback.lift_fst _ _ _
      · intro c
        apply pullback.hom_ext
        · rw [Category.assoc, hp₂f, pullback.lift_snd]
        · rw [Category.assoc, hp₂s, ← Category.assoc, pullback.lift_fst]
          exact c.condition
      · intro c m hm1 hm2
        apply pullback.hom_ext
        · rw [pullback.lift_fst]
          exact hm1
        · rw [pullback.lift_snd, ← hp₂f, ← Category.assoc]
          exact congrArg (· ≫ pullback.fst q' q') hm2
    let d : Cofan (fun _ : Γ => T₀) := Cofan.mk (pullback h (q' ≫ ι)) s
    have hd := hau.nonempty_isColimit_of_isPullback_left (fun _ => 𝟙 V) (pullback.snd q' q') t
      (fun _ => 𝟙 T₀) (fun _ => t) (fun _ => IsPullback.id_horiz t) h₀ d (Iso.refl _)
      (fun γ => pullback.lift_snd _ _ _)
      (fun γ => by
        show s γ ≫ 𝟙 _ ≫ _ = _
        rw [Category.id_comp]
        exact hs1 γ)
      (fun γ => by
        show s γ ≫ 𝟙 _ ≫ p₂ = t ≫ pullback.lift (β γ) (𝟙 V) _
        rw [Category.id_comp]
        apply pullback.hom_ext
        · rw [Category.assoc, hp₂f, hs2, Category.assoc, pullback.lift_fst]
        · rw [Category.assoc, hp₂s, ← Category.assoc, hs1, Category.assoc, pullback.lift_snd,
            Category.id_comp, Category.comp_id])
    exact (Cofan.nonempty_isColimit_iff_isIso_sigmaDesc d).mp hd

  open CategoryTheory.Limits in
  have s2 : ∀ {P T₀ : Scheme.{u}} (Γ : Type u) (s : Γ → (T₀ ⟶ P)) (_ : IsIso (Sigma.desc s)),
      Function.Bijective (fun (f : C(↥P, ℤ_[ℓ])) (γ : Γ) => f.comp (s γ).base.hom) := by
    intro P T₀ Γ s hs
    let H : (Σ _ : Γ, ↥T₀) ≃ₜ ↥P :=
      (sigmaMk (fun _ : Γ => T₀)).trans (Scheme.homeoOfIso (asIso (Sigma.desc s)))
    have hH : ∀ γ x, H ⟨γ, x⟩ = (s γ).base x := by
      intro γ x
      simp only [H, Homeomorph.trans_apply, sigmaMk_mk, Scheme.homeoOfIso_apply, asIso_hom]
      rw [← Scheme.Hom.comp_apply, Sigma.ι_comp_desc]
    constructor
    · intro f g hfg
      ext p
      obtain ⟨⟨γ, x⟩, rfl⟩ := H.surjective p
      rw [hH]
      have := congrArg (fun F => F γ x) hfg
      exact this
    · intro k
      refine ⟨(ContinuousMap.sigma k).comp ⟨H.symm, H.symm.continuous⟩, ?_⟩
      funext γ
      ext x
      show ContinuousMap.sigma k (H.symm ((s γ).base x)) = k γ x
      rw [← hH, Homeomorph.symm_apply_apply]
      rfl

  have hT : ∀ x : T.left, T.hom x ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K)) := by
    rintro x ⟨i, hi⟩
    have hmem : Uo.ι (q' (t x)) ∈ Uo := by
      have h1 : Uo.ι (q' (t x)) ∈ Set.range Uo.ι := ⟨_, rfl⟩
      rwa [Scheme.Opens.range_ι] at h1
    rw [ht, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hi
    exact (hUo _).mp hmem i hi.symm

  have hsw : ∀ γ : Γ, 𝟙 T.left ≫ T.hom = (t ≫ (α γ).hom) ≫ q' ≫ Uo.ι := by
    intro γ
    rw [Category.id_comp, ht, Category.assoc, hα γ]
  let s : Γ → (T.left ⟶ Limits.pullback T.hom (q' ≫ Uo.ι)) := fun γ =>
    Limits.pullback.lift (𝟙 T.left) (t ≫ (α γ).hom) (hsw γ)
  have hσ : IsIso (Limits.Sigma.desc s) :=
    s1 q' Uo.ι Γ (fun γ => (α γ).hom) hα' hiso T.hom t ht s
      (fun γ => Limits.pullback.lift_fst _ _ _) (fun γ => Limits.pullback.lift_snd _ _ _)
  have hψ := s2 Γ s hσ
  have hs₀w : 𝟙 T.left ≫ T.hom = t ≫ q' ≫ Uo.ι := by rw [Category.id_comp, ht]
  let s₀ : T.left ⟶ Limits.pullback T.hom (q' ≫ Uo.ι) := Limits.pullback.lift (𝟙 T.left) t hs₀w

  have hsub : wcExtZeroSub (wcCoverBasePre (q' ≫ Uo.ι) ℓ)
      (fun T : (wcP1Over K).left.ProEt =>
        ∀ t, T.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K))) (Opposite.op T) = ⊤ :=
    iSup_pos hT
  let E : (wcCcPre (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ).obj
      (Opposite.op T) → C(↥(Limits.pullback T.hom (q' ≫ Uo.ι)), ℤ_[ℓ]) := fun x =>
    (show ↥(wcExtZeroSub (wcCoverBasePre (q' ≫ Uo.ι) ℓ)
      (fun T : (wcP1Over K).left.ProEt =>
        ∀ t, T.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K))) (Opposite.op T))
      from x).1.down
  have hE : Function.Bijective E := by
    constructor
    · intro x y hxy
      exact Subtype.ext (ULift.ext _ _ hxy)
    · intro f
      refine ⟨(⟨ULift.up f, by rw [hsub]; exact AddSubgroup.mem_top _⟩ :
        ↥(wcExtZeroSub (wcCoverBasePre (q' ≫ Uo.ι) ℓ)
          (fun T : (wcP1Over K).left.ProEt =>
            ∀ t, T.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K))) (Opposite.op T))),
        rfl⟩
  let π : (wcCcPre (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ).obj
      (Opposite.op T) →+ C(↥T.left, ℤ_[ℓ]) :=
    { toFun := fun x => (E x).comp s₀.base.hom
      map_zero' := ContinuousMap.ext fun _ => rfl
      map_add' := fun _ _ => ContinuousMap.ext fun _ => rfl }
  have hkey : ∀ g : Γ,
      s₀ ≫ (wcPbAct (q' ≫ Uo.ι) (α g⁻¹).hom (hα g⁻¹)).app T = s g⁻¹ := by
    intro g
    have w : (Limits.pullback.fst T.hom (q' ≫ Uo.ι) ≫ 𝟙 T.left) ≫ T.hom =
        (Limits.pullback.snd T.hom (q' ≫ Uo.ι) ≫ (α g⁻¹).hom) ≫ q' ≫ Uo.ι := by
      erw [Category.comp_id]
      rw [Category.assoc, hα]
      exact Limits.pullback.condition
    show Limits.pullback.lift (𝟙 T.left) t hs₀w ≫ Limits.pullback.lift _ _ w =
      Limits.pullback.lift (𝟙 T.left) (t ≫ (α g⁻¹).hom) (hsw g⁻¹)
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc,
        Category.comp_id]
    · simp only [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc]
  refine ⟨C(↥T.left, ℤ_[ℓ]), inferInstance, inferInstance, π, ?_, ?_⟩
  · intro a x
    exact ContinuousMap.ext fun _ => rfl
  · have hfun : (fun x (g : Γ) => π (((wcCcActP (q' ≫ Uo.ι)
          (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (α g⁻¹).hom (hα g⁻¹)).app
            (Opposite.op T)).hom x)) =
        (fun (h : Γ → C(↥T.left, ℤ_[ℓ])) (g : Γ) => h g⁻¹) ∘
          (fun (f : C(↥(Limits.pullback T.hom (q' ≫ Uo.ι)), ℤ_[ℓ])) (γ : Γ) =>
            f.comp (s γ).base.hom) ∘ E := by
      funext x g
      ext p
      show (E x) (((wcPbAct (q' ≫ Uo.ι) (α g⁻¹).hom (hα g⁻¹)).app T).base (s₀.base p)) =
        (E x) ((s g⁻¹).base p)
      rw [← hkey g]
      rfl
    rw [hfun]
    have hρ : Function.Bijective (fun (h : Γ → C(↥T.left, ℤ_[ℓ])) (g : Γ) => h g⁻¹) :=
      Function.Involutive.bijective (fun h => funext fun g => by simp)
    exact (hρ.comp hψ).comp hE

theorem wc_cover_proet_torsor_covering (K : Type u) [Field K] [Finite K]
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α) (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
    (T : (wcP1Over K).left.ProEt)
    (hT : ∀ t, T.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K))) :
    ∃ R : Sieve T, R ∈ Scheme.ProEt.topology (wcP1Over K).left T ∧
      ∀ (T' : (wcP1Over K).left.ProEt) (f : T' ⟶ T), R.arrows f →
        ∃ t' : T'.left ⟶ V, T'.hom = t' ≫ q' ≫ Uo.ι :=
by
  classical

  have crit : ∀ (S : Scheme.{u}) (U : S.ProEt) (R : Sieve U),
      (∀ (W : S.ProEt) (v : W ⟶ U), IsAffine W.left →
        ∃ (m : ℕ) (W' : Fin m → S.ProEt) (e : ∀ j, W' j ⟶ W),
          (∀ j, IsAffine (W' j).left) ∧ (∀ y : W.left, ∃ j, y ∈ Set.range (e j).left) ∧
          ∀ j, R.arrows (e j ≫ v)) →
      R ∈ Scheme.ProEt.topology S U := by
    intro S U R hR
    have fin_covers : ∀ (U : S.ProEt) [QuasiSeparatedSpace U.left] (n : ℕ) (W : Fin n → S.ProEt)
        (h : ∀ i, W i ⟶ U), (∀ i, IsAffine (W i).left) →
        (∀ x : U.left, ∃ i, x ∈ Set.range (h i).left) →
        Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology S U := by
      intro U _ n W h hA hJ
      have hs : ∀ x : U.left, ∃ j y, (h j).left y = x := by
        intro x
        obtain ⟨j, y, hy⟩ := hJ x
        exact ⟨j, y, hy⟩
      have hq : ∀ i, QuasiCompact (h i).left := fun i => by
        haveI := hA i
        exact quasiCompact_of_compactSpace _
      have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
        have h1 : WeaklyEtale ((h i).left ≫ U.hom) := by
          rw [MorphismProperty.Over.w (h i)]
          exact (W i).prop
        haveI := U.prop
        exact @WeaklyEtale.of_comp _ _ _ (h i).left U.hom h1 U.prop
      have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
          Scheme.proetalePrecoverage.coverings U.left :=
        ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_finite _ _
          (Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
            hs (fun _ => trivial)) _ hq
            (inferInstanceAs (Finite (Fin n)))),
          (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
            ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
      exact Precoverage.generate_mem_toGrothendieck
        (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))
    have affine_local : ∀ (U : S.ProEt) (T : Sieve U),
        (∀ (V : S.ProEt) (f : V ⟶ U), IsAffine V.left → T.pullback f ∈ Scheme.ProEt.topology S V) →
        T ∈ Scheme.ProEt.topology S U := by
      intro U T hT
      have hU : WeaklyEtale U.hom := U.prop
      let W : U.left.affineCover.I₀ → S.ProEt := fun i =>
        MorphismProperty.Over.mk ⊤ (U.left.affineCover.f i ≫ U.hom) inferInstance
      let e : ∀ i, W i ⟶ U := fun i => MorphismProperty.Over.homMk (U.left.affineCover.f i) rfl trivial
      have hP : Presieve.ofArrows W e ∈ (Scheme.ProEt.precoverage S).coverings U := by
        show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)
          Scheme.proetalePrecoverage).coverings U
        rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
        change U.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings U.left
        exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left U.left.affineCover.mem₀,
          U.left.affineCover.mem₀.1,
          MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
      refine GrothendieckTopology.transitive _ (Precoverage.generate_mem_toGrothendieck hP) T ?_
      intro Y f hf
      obtain ⟨Y', h, g', hg', rfl⟩ := hf
      rcases hg' with ⟨i⟩
      rw [Sieve.pullback_comp]
      exact GrothendieckTopology.pullback_stable _ h
        (hT (W i) (e i) (show IsAffine (U.left.affineCover.X i) by infer_instance))
    apply affine_local U R
    intro W v hW
    obtain ⟨m, W', e, haff, hsurj, hR'⟩ := hR W v hW
    haveI : IsAffine W.left := hW
    refine GrothendieckTopology.superset_covering _ ?_ (fin_covers W m W' e haff hsurj)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨j⟩
    exact hR' j

  have hmem : ∀ t, T.hom t ∈ Uo := fun t =>
    (hUo _).mpr (fun i h => hT t ⟨i, h.symm⟩)
  have hrange : Set.range T.hom ⊆ Set.range Uo.ι := by
    rintro _ ⟨t, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact hmem t
  let u : T.left ⟶ Uo.toScheme := IsOpenImmersion.lift Uo.ι T.hom hrange
  have hu : u ≫ Uo.ι = T.hom := IsOpenImmersion.lift_fac _ _ _

  haveI : IsFinite q' := hG.2.1
  haveI : Etale q' := hG.2.2.1
  haveI : Surjective q' := hG.2.2.2.1

  let R : Sieve T :=
    { arrows := fun T' _ => ∃ t' : T'.left ⟶ V, T'.hom = t' ≫ q' ≫ Uo.ι
      downward_closed := by
        rintro T' T'' f ⟨t, ht⟩ g
        refine ⟨g.left ≫ t, ?_⟩
        rw [← MorphismProperty.Over.w g, ht, Category.assoc] }
  refine ⟨R, ?_, fun T' f hf => hf⟩

  apply crit _ T R
  intro W v hW
  haveI : IsAffine W.left := hW
  haveI hWe : WeaklyEtale W.hom := W.prop
  let g : W.left ⟶ Uo.toScheme := v.left ≫ u
  let p₁ : Limits.pullback g q' ⟶ W.left := Limits.pullback.fst g q'
  let p₂ : Limits.pullback g q' ⟶ V := Limits.pullback.snd g q'
  haveI : IsFinite p₁ := by dsimp [p₁]; infer_instance
  haveI : Etale p₁ := by dsimp [p₁]; infer_instance
  haveI : Surjective p₁ := by dsimp [p₁]; infer_instance
  have hPaff : IsAffine (Limits.pullback g q') := isAffine_of_isAffineHom p₁
  have hwe : WeaklyEtale (p₁ ≫ W.hom) := inferInstance
  let W₀ : (wcP1Over K).left.ProEt := MorphismProperty.Over.mk ⊤ (p₁ ≫ W.hom) hwe
  let e₀ : W₀ ⟶ W := MorphismProperty.Over.homMk p₁ rfl trivial
  refine ⟨1, fun _ => W₀, fun _ => e₀, fun _ => hPaff, fun y => ⟨0, Surjective.surj (f := p₁) y⟩,
    fun _ => ⟨p₂, ?_⟩⟩
  have hc : p₁ ≫ g = p₂ ≫ q' := Limits.pullback.condition
  show p₁ ≫ W.hom = p₂ ≫ q' ≫ Uo.ι
  rw [← MorphismProperty.Over.w v, ← hu, ← Category.assoc p₂, ← hc]
  simp only [g, Category.assoc]

theorem wc_cover_presheaf_ring_action (K : Type u) [Field K] [Finite K]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α) (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
    (lamF : MonoidAlgebra ℤ_[ℓ] Γ → (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ⟶ wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
    (hlamF : wcRingAct lamF)
    (hlamFs : ∀ (g : Γ) (a : ℤ_[ℓ]), lamF (MonoidAlgebra.single g a) =
      wcCoverScal (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ a ≫
        wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ
          (α g⁻¹).hom (hα g⁻¹)) :
    ∃ lamP : MonoidAlgebra ℤ_[ℓ] Γ →
        (wcCcPre (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ⟶
          wcCcPre (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ),
      wcRingAct lamP ∧
      (∀ r, lamF r =
        (presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}).map
          (lamP r)) ∧
      (∀ g : Γ, lamP (MonoidAlgebra.single g 1) = wcCcActP (q' ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (α g⁻¹).hom (hα g⁻¹)) ∧
      (∀ a : ℤ_[ℓ], lamP (MonoidAlgebra.single 1 a) = wcCcScalP (q' ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ a) :=
by
  classical
  let q : V ⟶ (wcP1Over K).left := q' ≫ Uo.ι
  let Z : Set (wcP1Over K).left := Set.range (fun i => S i (IsLocalRing.closedPoint K))

  have hs1 : wcCcScalP q Z ℓ 1 = 𝟙 _ := by
    unfold wcCcScalP
    ext T x
    apply Subtype.ext
    first
      | (apply ULift.ext; apply ContinuousMap.ext; intro t; exact one_mul _)
      | (apply ULift.ext; apply ContinuousMap.ext; intro t; exact one_smul _ _)
      | (apply ULift.ext; exact one_smul _ _)
  have hsadd : ∀ a b : ℤ_[ℓ],
      wcCcScalP q Z ℓ (a + b) = wcCcScalP q Z ℓ a + wcCcScalP q Z ℓ b := by
    intro a b
    unfold wcCcScalP
    ext T x
    apply Subtype.ext
    first
      | (apply ULift.ext; apply ContinuousMap.ext; intro t; exact add_mul a b _)
      | (apply ULift.ext; apply ContinuousMap.ext; intro t; exact add_smul a b _)
      | (apply ULift.ext; exact add_smul a b _)
  have hsmul : ∀ a b : ℤ_[ℓ],
      wcCcScalP q Z ℓ (a * b) = wcCcScalP q Z ℓ a ≫ wcCcScalP q Z ℓ b := by
    intro a b
    have key : ∀ u : ℤ_[ℓ], a * b * u = b * (a * u) := fun u => by ring
    unfold wcCcScalP
    ext T x
    apply Subtype.ext
    first
      | (apply ULift.ext; apply ContinuousMap.ext; intro t; exact key _)
      | (apply ULift.ext; apply ContinuousMap.ext; intro t
         exact (smul_smul b a _).symm.trans (by rw [mul_comm]))

  have hca : ∀ (a : ℤ_[ℓ]) (x : V ⟶ V) (hx : x ≫ q = q),
      wcCcScalP q Z ℓ a ≫ wcCcActP q Z ℓ x hx =
        wcCcActP q Z ℓ x hx ≫ wcCcScalP q Z ℓ a := by
    intro a x hx
    unfold wcCcScalP wcCcActP
    ext T y
    apply Subtype.ext
    first
      | rfl
      | (apply ULift.ext; apply ContinuousMap.ext; intro t; rfl)

  have hcongr : ∀ (a a' : V ⟶ V) (_ : a = a') (ha : a ≫ q = q) (ha' : a' ≫ q = q),
      wcCcActP q Z ℓ a ha = wcCcActP q Z ℓ a' ha' := by
    rintro a _ rfl _ _
    rfl
  have hact_id : ∀ (h : 𝟙 V ≫ q = q), wcCcActP q Z ℓ (𝟙 V) h = 𝟙 _ := by
    intro h
    have hpb : wcPbAct q (𝟙 V) h = 𝟙 _ := by
      apply NatTrans.ext
      funext T
      simp only [wcPbAct, NatTrans.id_app]
      first
        | exact Limits.pullback.map_id
        | (apply Limits.pullback.hom_ext <;> simp [Limits.pullback.map] <;>
            exact (Category.id_comp _).symm)
    unfold wcCcActP
    rw [hpb]
    ext T x
    apply Subtype.ext
    rfl
  have hact_comp : ∀ (a b : V ⟶ V) (ha : a ≫ q = q) (hb : b ≫ q = q) (hab : (a ≫ b) ≫ q = q),
      wcCcActP q Z ℓ (a ≫ b) hab = wcCcActP q Z ℓ b hb ≫ wcCcActP q Z ℓ a ha := by
    intro a b ha hb hab
    have hpb : wcPbAct q (a ≫ b) hab = wcPbAct q a ha ≫ wcPbAct q b hb := by
      apply NatTrans.ext
      funext T
      simp only [wcPbAct, NatTrans.comp_app]
      first
        | (refine Eq.trans ?_ (Limits.pullback.map_comp _ _ _ _ _ _ _ _ _ _).symm
           congr 1 <;> simp)
        | (rw [Limits.pullback.map_comp]; congr 1 <;> simp)
        | (apply Limits.pullback.hom_ext
           · rw [Category.assoc]
             erw [Limits.pullback.lift_fst, Limits.pullback.lift_fst, Limits.pullback.lift_fst]
           · rw [Category.assoc]
             erw [Limits.pullback.lift_snd, Limits.pullback.lift_snd]
             rw [← Category.assoc]
             erw [Limits.pullback.lift_snd]
             rw [Category.assoc])
    unfold wcCcActP
    rw [hpb]
    ext T x
    apply Subtype.ext
    rfl
  have hρ1 : wcCcActP q Z ℓ (α 1⁻¹).hom (hα 1⁻¹) = 𝟙 _ := by
    have h1 : (α 1⁻¹).hom = 𝟙 V := by
      rw [inv_one, map_one]
      rfl
    exact (hcongr _ _ h1 (hα 1⁻¹) (by rw [Category.id_comp])).trans (hact_id _)
  have hρmul : ∀ a b : Γ, wcCcActP q Z ℓ (α (a * b)⁻¹).hom (hα (a * b)⁻¹) =
      wcCcActP q Z ℓ (α b⁻¹).hom (hα b⁻¹) ≫ wcCcActP q Z ℓ (α a⁻¹).hom (hα a⁻¹) := by
    intro a b
    have h1 : (α (a * b)⁻¹).hom = (α a⁻¹).hom ≫ (α b⁻¹).hom := by
      rw [mul_inv_rev, map_mul, Aut.Aut_mul_def]
      rfl
    exact (hcongr _ _ h1 (hα (a * b)⁻¹) (by rw [Category.assoc, hα b⁻¹, hα a⁻¹])).trans
      (hact_comp _ _ (hα a⁻¹) (hα b⁻¹) _)

  let fM : ℤ_[ℓ] →* End (wcCcPre q Z ℓ) :=
    { toFun := fun a => wcCcScalP q Z ℓ a
      map_one' := hs1
      map_mul' := fun a b =>
        (congrArg (wcCcScalP q Z ℓ) (mul_comm a b)).trans (hsmul b a) }
  let fS : ℤ_[ℓ] →+* End (wcCcPre q Z ℓ) := RingHom.mk' fM (fun a b => hsadd a b)
  let gM : Γ →* End (wcCcPre q Z ℓ) :=
    { toFun := fun γ => wcCcActP q Z ℓ (α γ⁻¹).hom (hα γ⁻¹)
      map_one' := hρ1
      map_mul' := fun a b => hρmul a b }
  have hcomm : ∀ (x : ℤ_[ℓ]) (y : Γ), Commute (fS x) (gM y) := fun x y =>
    (hca x (α y⁻¹).hom (hα y⁻¹)).symm
  let Φ := MonoidAlgebra.liftNCRingHom fS gM hcomm
  have hsing : ∀ (g : Γ) (a : ℤ_[ℓ]),
      (Φ (MonoidAlgebra.single g a) : wcCcPre q Z ℓ ⟶ wcCcPre q Z ℓ) =
        wcCcScalP q Z ℓ a ≫ wcCcActP q Z ℓ (α g⁻¹).hom (hα g⁻¹) := fun g a =>
    (MonoidAlgebra.liftNCRingHom_single fS gM hcomm g a).trans (hca a _ _).symm

  have hz : lamF 0 = 0 := by
    have h := hlamF.2.1 0 0
    rw [add_zero] at h
    exact (add_eq_left.mp h.symm)
  have hii : ∀ r, lamF r =
      (presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}).map
        (Φ r : wcCcPre q Z ℓ ⟶ wcCcPre q Z ℓ) := by
    intro r
    induction r using MonoidAlgebra.induction_linear with
    | zero =>
      rw [hz]
      refine ((congrArg (presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
        AddCommGrpCat.{u+1}).map (map_zero Φ)).trans ?_).symm
      exact (presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
        AddCommGrpCat.{u+1}).map_zero _ _
    | add x y hx hy =>
      refine (hlamF.2.1 x y).trans ?_
      rw [hx, hy]
      refine ((congrArg (presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
        AddCommGrpCat.{u+1}).map (map_add Φ x y)).trans ?_).symm
      exact (presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
        AddCommGrpCat.{u+1}).map_add
    | single g a =>
      refine (hlamFs g a).trans ?_
      refine Eq.trans ?_ (congrArg (presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
        AddCommGrpCat.{u+1}).map (hsing g a).symm)
      exact ((presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
        AddCommGrpCat.{u+1}).map_comp _ _).symm
  refine ⟨fun r => (Φ r : wcCcPre q Z ℓ ⟶ wcCcPre q Z ℓ), ⟨?_, ?_, ?_⟩, hii, ?_, ?_⟩
  · exact map_one Φ
  · intro a b
    exact map_add Φ a b
  · intro a b
    exact map_mul Φ a b
  · intro g
    refine (hsing g 1).trans ?_
    rw [hs1, Category.id_comp]
  · intro a
    refine (hsing 1 a).trans ?_
    rw [hρ1, Category.comp_id]

theorem wc_cgev_sheafify_exact_of_local (Y : Scheme.{u}) {R : Type u} [Ring R]
    (P : (Y.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (lamP : R → (P ⟶ P)) (hlamP : wcRingAct lamP)
    (lamG : R → ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P ⟶
      (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P))
    (hlamG : wcRingAct lamG)
    (hGP : ∀ r, lamG r = (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map
      (lamP r))
    (N : ModuleCat.{u+1} R) (Rs : wcCgevRes N) (𝒯 : Y.ProEt → Prop)
    (h𝒯 : ∀ {T T' : Y.ProEt} (_ : T' ⟶ T), 𝒯 T → 𝒯 T')
    (hcov : ∀ T : Y.ProEt, Subsingleton (P.obj (Opposite.op T)) ∨
      ∃ Sv : Sieve T, Sv ∈ Scheme.ProEt.topology Y T ∧
        ∀ (T' : Y.ProEt) (f : T' ⟶ T), Sv.arrows f → 𝒯 T')
    (hex : ∀ T : Y.ProEt, 𝒯 T → ∀ (p : ℕ) (y : Fin (Rs.a (p + 2)) → P.obj (Opposite.op T)),
      (∀ i, ∑ j, ((lamP (Rs.c (p + 2) i j)).app (Opposite.op T)).hom (y j) = 0) →
      ∃ z : Fin (Rs.a (p + 1)) → P.obj (Opposite.op T),
        ∀ i, ∑ j, ((lamP (Rs.c (p + 1) i j)).app (Opposite.op T)).hom (z j) = y i) :
    ∀ p, (wcCgevK lamG hlamG Rs).ExactAt (p + 2) :=
by
  haveI : Limits.HasFiniteBiproducts (Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) :=
    Abelian.hasFiniteBiproducts

  have hz : ∀ (A B : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (T : (Y.ProEt)ᵒᵖ)
      (a : A.obj.obj T), ((0 : A ⟶ B).hom.app T).hom a = 0 := by
    intro A B T a
    have h := congrArg (fun φ : A ⟶ B => (φ.hom.app T).hom a) (add_zero (0 : A ⟶ B))
    simp only [Sheaf.Hom.add_app, AddCommGrpCat.hom_add, AddMonoidHom.add_apply] at h
    simpa using h
  have hsum : ∀ (A B : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) {ι : Type}
      (s : Finset ι) (f : ι → (A ⟶ B)) (T : (Y.ProEt)ᵒᵖ) (a : A.obj.obj T),
      ((∑ i ∈ s, f i).hom.app T).hom a = ∑ i ∈ s, ((f i).hom.app T).hom a := by
    intro A B ι s f T a
    classical
    induction s using Finset.induction_on with
    | empty => rw [Finset.sum_empty, Finset.sum_empty]; exact hz A B T a
    | insert i s hi ih =>
      rw [Finset.sum_insert hi, Finset.sum_insert hi, Sheaf.Hom.add_app, AddCommGrpCat.hom_add,
        AddMonoidHom.add_apply, ih]

  have hcomp_ext : ∀ (G0 : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (n : ℕ)
      (T : (Y.ProEt)ᵒᵖ) (x x' : (⨁ fun _ : Fin n => G0).obj.obj T),
      (∀ j, ((Limits.biproduct.π (fun _ : Fin n => G0) j).hom.app T).hom x =
        ((Limits.biproduct.π (fun _ : Fin n => G0) j).hom.app T).hom x') → x = x' := by
    intro G0 n T x x' h
    have e : ∀ x : (⨁ fun _ : Fin n => G0).obj.obj T, x = ∑ j,
        ((Limits.biproduct.ι (fun _ : Fin n => G0) j).hom.app T).hom
          (((Limits.biproduct.π (fun _ : Fin n => G0) j).hom.app T).hom x) := by
      intro x
      have := congrArg (fun φ : (⨁ fun _ : Fin n => G0) ⟶ (⨁ fun _ : Fin n => G0) =>
        (φ.hom.app T).hom x) (Limits.biproduct.total (f := fun _ : Fin n => G0))
      rw [hsum] at this
      exact this.symm
    rw [e x, e x']
    simp only [h]
  have hcomp_surj : ∀ (G0 : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (n : ℕ)
      (T : (Y.ProEt)ᵒᵖ) (y : Fin n → G0.obj.obj T), ∃ x : (⨁ fun _ : Fin n => G0).obj.obj T,
      ∀ j, ((Limits.biproduct.π (fun _ : Fin n => G0) j).hom.app T).hom x = y j := by
    intro G0 n T y
    refine ⟨∑ j, ((Limits.biproduct.ι (fun _ : Fin n => G0) j).hom.app T).hom (y j), fun k => ?_⟩
    rw [map_sum, Finset.sum_eq_single k]
    · exact congrArg (fun φ : G0 ⟶ G0 => (φ.hom.app T).hom (y k))
        (Limits.biproduct.ι_π_self (fun _ : Fin n => G0) k)
    · intro j _ hjk
      exact (congrArg (fun φ : G0 ⟶ G0 => (φ.hom.app T).hom (y j))
        (Limits.biproduct.ι_π_ne (fun _ : Fin n => G0) hjk)).trans (hz _ _ _ _)
    · intro hk; exact absurd (Finset.mem_univ k) hk
  have hmat : ∀ (G0 : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (n k : ℕ)
      (m : Fin n → Fin k → (G0 ⟶ G0)) (T : (Y.ProEt)ᵒᵖ) (x : (⨁ fun _ : Fin n => G0).obj.obj T)
      (i : Fin k),
      ((Limits.biproduct.π (fun _ : Fin k => G0) i).hom.app T).hom
        (((Limits.biproduct.matrix (f := fun _ : Fin n => G0) (g := fun _ : Fin k => G0) m).hom.app
          T).hom x) =
        ∑ j, ((m j i).hom.app T).hom
          (((Limits.biproduct.π (fun _ : Fin n => G0) j).hom.app T).hom x) := by
    intro G0 n k m T x i
    have h1 := congrArg (fun φ => (φ.hom.app T).hom x) (Limits.biproduct.matrix_π m i)
    rw [Limits.biproduct.desc_eq] at h1
    rw [hsum] at h1
    exact h1

  have s1 : ∀ (S : ShortComplex (Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})),
      (∀ (T : Y.ProEt) (x : S.X₂.obj.obj (Opposite.op T)), (S.g.hom.app (Opposite.op T)).hom x = 0 →
        Presheaf.imageSieve S.f.hom x ∈ Scheme.ProEt.topology Y T) → S.Exact := by
    intro S hS
    rw [ShortComplex.exact_iff_epi_toCycles]
    have hinj : ∀ T' : (Y.ProEt)ᵒᵖ, Function.Injective (S.iCycles.hom.app T').hom := by
      intro T'
      have h1 : Mono S.iCycles.hom := (sheafToPresheaf _ _).map_mono S.iCycles
      have h2 : Mono (S.iCycles.hom.app T') := (NatTrans.mono_iff_mono_app _).mp h1 T'
      exact (AddCommGrpCat.mono_iff_injective _).mp h2
    have : Sheaf.IsLocallySurjective S.toCycles := by
      rw [← Sheaf.isLocallySurjective_sheafToPresheaf_map_iff]
      refine Presheaf.IsLocallySurjective.mk (fun {U} c => ?_)
      have hx : (S.g.hom.app (Opposite.op U)).hom ((S.iCycles.hom.app (Opposite.op U)).hom c) = 0 := by
        have := congrArg (fun φ => (φ.hom.app (Opposite.op U)).hom c) S.iCycles_g
        exact this.trans (hz _ _ _ c)
      refine (Scheme.ProEt.topology Y).superset_covering ?_ (hS U _ hx)
      intro V g hg
      rw [Presheaf.imageSieve_apply] at hg ⊢
      obtain ⟨t, ht⟩ := hg
      refine ⟨t, hinj _ ?_⟩
      have e1 := congrArg (fun φ => (φ.hom.app (Opposite.op V)).hom t) S.toCycles_i
      refine e1.trans (ht.trans ?_)
      exact (NatTrans.naturality_apply S.iCycles.hom g.op c).symm
    exact Sheaf.epi_of_isLocallySurjective _

  have s3 : ∀ (T : Y.ProEt) (n : ℕ)
      (x : Fin n → (sheafify (Scheme.ProEt.topology Y) P).obj (Opposite.op T)),
      ∃ Sv : Sieve T, Sv ∈ Scheme.ProEt.topology Y T ∧ ∀ (T' : Y.ProEt) (f : T' ⟶ T), Sv.arrows f →
        ∃ y : Fin n → P.obj (Opposite.op T'), ∀ j,
          ((toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op T')).hom (y j) =
            ((sheafify (Scheme.ProEt.topology Y) P).map f.op).hom (x j) := by
    intro T n
    induction n with
    | zero =>
      intro x
      exact ⟨⊤, (Scheme.ProEt.topology Y).top_mem T, fun T' f _ => ⟨Fin.elim0, fun j => Fin.elim0 j⟩⟩
    | succ n ih =>
      intro x
      obtain ⟨Sv', hSv', hlift'⟩ := ih (fun j => x j.succ)
      have h0 := Presheaf.imageSieve_mem (Scheme.ProEt.topology Y)
        (toSheafify (Scheme.ProEt.topology Y) P) (x 0)
      refine ⟨_ ⊓ Sv', (Scheme.ProEt.topology Y).intersection_covering h0 hSv', fun T' f hf => ?_⟩
      obtain ⟨hf0, hf1⟩ := hf
      rw [Presheaf.imageSieve_apply] at hf0
      obtain ⟨y0, hy0⟩ := hf0
      obtain ⟨y', hy'⟩ := hlift' T' f hf1
      refine ⟨Fin.cons y0 y', fun j => ?_⟩
      rcases Fin.eq_zero_or_eq_succ j with rfl | ⟨k, rfl⟩
      · exact hy0
      · exact hy' k

  have s4 : ∀ (T : Y.ProEt) (n : ℕ) (w : Fin n → P.obj (Opposite.op T)),
      (∀ i, ((toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op T)).hom (w i) = 0) →
      ∃ Sv : Sieve T, Sv ∈ Scheme.ProEt.topology Y T ∧ ∀ (T' : Y.ProEt) (f : T' ⟶ T), Sv.arrows f →
        ∀ i, (P.map f.op).hom (w i) = 0 := by
    intro T n
    induction n with
    | zero =>
      intro w _
      exact ⟨⊤, (Scheme.ProEt.topology Y).top_mem T, fun T' f _ i => Fin.elim0 i⟩
    | succ n ih =>
      intro w hw
      obtain ⟨Sv', hSv', hv'⟩ := ih (fun j => w j.succ) (fun j => hw j.succ)
      have h0 := Presheaf.equalizerSieve_mem (Scheme.ProEt.topology Y)
        (toSheafify (Scheme.ProEt.topology Y) P) (w 0) (0 : P.obj (Opposite.op T))
        ((hw 0).trans (map_zero _).symm)
      refine ⟨_ ⊓ Sv', (Scheme.ProEt.topology Y).intersection_covering h0 hSv', fun T' f hf i => ?_⟩
      obtain ⟨hf0, hf1⟩ := hf
      rw [Presheaf.equalizerSieve_apply] at hf0
      rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨k, rfl⟩
      · exact hf0.trans (map_zero _)
      · exact hv' T' f hf1 k

  have hnat : ∀ (r : R) (T' : Y.ProEt) (u : P.obj (Opposite.op T')),
      ((lamG r).hom.app (Opposite.op T')).hom
        (((toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op T')).hom u) =
      ((toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op T')).hom
        (((lamP r).app (Opposite.op T')).hom u) := by
    intro r T' u
    have h1 : (lamG r).hom = sheafifyMap (Scheme.ProEt.topology Y) (lamP r) := by rw [hGP]
    have h2 := congrArg (fun φ => (φ.app (Opposite.op T')).hom u)
      (toSheafify_naturality (Scheme.ProEt.topology Y) (lamP r))
    rw [h1]
    exact h2.symm
  have hnatG : ∀ (r : R) (T1 T2 : Y.ProEt) (g : T2 ⟶ T1)
      (v : (sheafify (Scheme.ProEt.topology Y) P).obj (Opposite.op T1)),
      ((lamG r).hom.app (Opposite.op T2)).hom
        (((sheafify (Scheme.ProEt.topology Y) P).map g.op).hom v) =
      ((sheafify (Scheme.ProEt.topology Y) P).map g.op).hom (((lamG r).hom.app (Opposite.op T1)).hom v) :=
    fun r T1 T2 g v => NatTrans.naturality_apply (lamG r).hom g.op v
  have hnatP : ∀ (r : R) (T1 T2 : Y.ProEt) (g : T2 ⟶ T1) (v : P.obj (Opposite.op T1)),
      ((lamP r).app (Opposite.op T2)).hom ((P.map g.op).hom v) =
      (P.map g.op).hom (((lamP r).app (Opposite.op T1)).hom v) :=
    fun r T1 T2 g v => NatTrans.naturality_apply (lamP r) g.op v
  have hnatS : ∀ (T1 T2 : Y.ProEt) (g : T2 ⟶ T1) (v : P.obj (Opposite.op T1)),
      ((toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op T2)).hom ((P.map g.op).hom v) =
      ((sheafify (Scheme.ProEt.topology Y) P).map g.op).hom
        (((toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op T1)).hom v) :=
    fun T1 T2 g v => NatTrans.naturality_apply (toSheafify (Scheme.ProEt.topology Y) P) g.op v
  have hfunc : ∀ (T1 T2 T3 : Y.ProEt) (g1 : T2 ⟶ T1) (g2 : T3 ⟶ T2)
      (v : (sheafify (Scheme.ProEt.topology Y) P).obj (Opposite.op T1)),
      ((sheafify (Scheme.ProEt.topology Y) P).map (g2 ≫ g1).op).hom v =
      ((sheafify (Scheme.ProEt.topology Y) P).map g2.op).hom
        (((sheafify (Scheme.ProEt.topology Y) P).map g1.op).hom v) := by
    intro T1 T2 T3 g1 g2 v
    rw [op_comp, Functor.map_comp]
    rfl

  intro p
  rw [HomologicalComplex.exactAt_iff' _ (p + 1) (p + 2) (p + 2 + 1)
    (ComplexShape.prev_eq' _ (show (ComplexShape.up ℕ).Rel (p + 1) (p + 2) from rfl))
    (CochainComplex.next ℕ (p + 2))]
  apply s1
  intro T xx hxx
  have hdf : (wcCgevK lamG hlamG Rs).d (p + 1) (p + 2) =
      Limits.biproduct.matrix
        (f := fun _ : Fin (Rs.a (p + 1)) =>
          (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P)
        (g := fun _ : Fin (Rs.a (p + 2)) =>
          (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P)
        (fun j i => lamG (Rs.c (p + 1) i j)) := by
    show (wcCgevK lamG hlamG Rs).d (p + 1) (p + 1 + 1) = _
    unfold wcCgevK
    first
      | (rw [CochainComplex.of_d]; done)
      | (rw [CochainComplex.of_d]; rfl)
      | (erw [CochainComplex.of_d]; rfl)
      | (simp only [CochainComplex.of_d]; rfl)
      | (simp [CochainComplex.of]; rfl)
      | simp [CochainComplex.of]
  have hdg : (wcCgevK lamG hlamG Rs).d (p + 2) (p + 2 + 1) =
      Limits.biproduct.matrix
        (f := fun _ : Fin (Rs.a (p + 2)) =>
          (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P)
        (g := fun _ : Fin (Rs.a (p + 2 + 1)) =>
          (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P)
        (fun j i => lamG (Rs.c (p + 2) i j)) := by
    unfold wcCgevK
    first
      | (rw [CochainComplex.of_d]; done)
      | (rw [CochainComplex.of_d]; rfl)
      | (erw [CochainComplex.of_d]; rfl)
      | (simp only [CochainComplex.of_d]; rfl)
      | (simp [CochainComplex.of]; rfl)
      | simp [CochainComplex.of]
  obtain ⟨xc, hxc⟩ : ∃ xc : Fin (Rs.a (p + 2)) →
      (sheafify (Scheme.ProEt.topology Y) P).obj (Opposite.op T), ∀ j, xc j =
        ((Limits.biproduct.π (fun _ : Fin (Rs.a (p + 2)) =>
          (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P) j).hom.app
            (Opposite.op T)).hom xx := ⟨_, fun _ => rfl⟩
  have hcyc : ∀ i : Fin (Rs.a (p + 2 + 1)),
      ∑ j, ((lamG (Rs.c (p + 2) i j)).hom.app (Opposite.op T)).hom (xc j) = 0 := by
    intro i
    have h1 : (((wcCgevK lamG hlamG Rs).d (p + 2) (p + 2 + 1)).hom.app (Opposite.op T)).hom xx = 0 :=
      hxx
    rw [hdg] at h1
    have h2 := hmat ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P) _ _
      (fun j i => lamG (Rs.c (p + 2) i j)) (Opposite.op T) xx i
    have h3 := congrArg ((Limits.biproduct.π (fun _ : Fin (Rs.a (p + 2 + 1)) =>
      (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P) i).hom.app
        (Opposite.op T)).hom h1
    simp only [← hxc] at h2
    exact h2.symm.trans (h3.trans (map_zero _))
  have hC : ∀ (T'' : Y.ProEt) (g : T'' ⟶ T)
      (z : Fin (Rs.a (p + 1)) → (sheafify (Scheme.ProEt.topology Y) P).obj (Opposite.op T'')),
      (∀ i : Fin (Rs.a (p + 2)), ∑ j, ((lamG (Rs.c (p + 1) i j)).hom.app (Opposite.op T'')).hom (z j) =
        ((sheafify (Scheme.ProEt.topology Y) P).map g.op).hom (xc i)) →
      (Presheaf.imageSieve ((wcCgevK lamG hlamG Rs).sc' (p + 1) (p + 2) (p + 2 + 1)).f.hom xx).arrows
        g := by
    intro T'' g z hz'
    rw [Presheaf.imageSieve_apply]
    obtain ⟨uu, huu⟩ := hcomp_surj
      ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P) (Rs.a (p + 1))
      (Opposite.op T'') z
    refine ⟨uu, ?_⟩
    have e1 : ∀ i : Fin (Rs.a (p + 2)),
        ((Limits.biproduct.π (fun _ : Fin (Rs.a (p + 2)) =>
          (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P) i).hom.app
            (Opposite.op T'')).hom
          ((((wcCgevK lamG hlamG Rs).d (p + 1) (p + 2)).hom.app (Opposite.op T'')).hom uu) =
        ((sheafify (Scheme.ProEt.topology Y) P).map g.op).hom (xc i) := by
      intro i
      rw [hdf]
      refine (hmat ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P) _ _ _
        (Opposite.op T'') uu i).trans ?_
      simp only [huu]
      exact hz' i
    have e2 : ∀ i : Fin (Rs.a (p + 2)),
        ((Limits.biproduct.π (fun _ : Fin (Rs.a (p + 2)) =>
          (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P) i).hom.app
            (Opposite.op T'')).hom
          ((((wcCgevK lamG hlamG Rs).X (p + 2)).obj.map g.op).hom xx) =
        ((sheafify (Scheme.ProEt.topology Y) P).map g.op).hom (xc i) := by
      intro i
      rw [hxc]
      exact NatTrans.naturality_apply (Limits.biproduct.π (fun _ : Fin (Rs.a (p + 2)) =>
          (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P) i).hom g.op xx
    exact hcomp_ext ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P)
      (Rs.a (p + 2)) (Opposite.op T'') _ _ (fun i => (e1 i).trans (e2 i).symm)
  obtain ⟨S0, hS0, hlift⟩ := s3 T (Rs.a (p + 2)) xc
  refine (Scheme.ProEt.topology Y).transitive hS0 _ (fun T' f hf => ?_)
  obtain ⟨y, hy⟩ := hlift T' f hf
  rcases hcov T' with hsub | ⟨Sv, hSvJ, hSv𝒯⟩
  ·
    have := hsub
    have hfx : ∀ i, ((sheafify (Scheme.ProEt.topology Y) P).map f.op).hom (xc i) = 0 := by
      intro i
      rw [← hy i, Subsingleton.elim (y i) 0, map_zero]
    have hmem := hC T' f 0 (fun i => by
      simp only [Pi.zero_apply, map_zero, Finset.sum_const_zero]
      exact (hfx i).symm)
    rw [Sieve.pullback_eq_top_of_mem _ hmem]
    exact (Scheme.ProEt.topology Y).top_mem T'
  ·
    have hw : ∀ i, ((toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op T')).hom
        (∑ j, ((lamP (Rs.c (p + 2) i j)).app (Opposite.op T')).hom (y j)) = 0 := by
      intro i
      rw [map_sum]
      simp only [← hnat, hy, hnatG]
      have := hcyc i
      have h3 := congrArg ((sheafify (Scheme.ProEt.topology Y) P).map f.op).hom this
      rw [map_sum, map_zero] at h3
      exact h3
    obtain ⟨S1, hS1, hv⟩ := s4 T' _
      (fun i => ∑ j, ((lamP (Rs.c (p + 2) i j)).app (Opposite.op T')).hom (y j)) hw
    refine (Scheme.ProEt.topology Y).superset_covering ?_
      ((Scheme.ProEt.topology Y).intersection_covering hSvJ hS1)
    intro T'' h hh
    obtain ⟨hh1, hh2⟩ := hh
    have hT'' := hSv𝒯 T'' h hh1
    have hy' : ∀ i, ∑ j, ((lamP (Rs.c (p + 2) i j)).app (Opposite.op T'')).hom
        ((P.map h.op).hom (y j)) = 0 := by
      intro i
      have := hv T'' h hh2 i
      simp only [map_sum] at this
      simp only [hnatP]
      exact this
    obtain ⟨zt, hzt⟩ := hex T'' hT'' p (fun j => (P.map h.op).hom (y j)) hy'
    refine hC T'' (h ≫ f) (fun j => ((toSheafify (Scheme.ProEt.topology Y) P).app
      (Opposite.op T'')).hom (zt j)) (fun i => ?_)
    simp only [hnat]
    rw [← map_sum ((toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op T'')).hom, hzt i]
    simp only [hnatS, hy, hfunc]

theorem wc_cgev_K_ell_null {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {R : Type u} [Ring R] {A : 𝒜}
    (ℓ : ℕ) (hmono : Mono (ℓ • 𝟙 A)) (lamA : R → (A ⟶ A)) (hA : wcRingAct lamA)
    {N : ModuleCat.{u+1} R} (Rs : wcCgevRes N)
    (H : ∀ p, Matrix (Fin (Rs.a p)) (Fin (Rs.a (p + 1))) R)
    (hH0 : H 0 * Rs.c 0 = ℓ • (1 : Matrix (Fin (Rs.a 0)) (Fin (Rs.a 0)) R))
    (hH : ∀ p, H (p + 1) * Rs.c (p + 1) + Rs.c p * H p =
      ℓ • (1 : Matrix (Fin (Rs.a (p + 1))) (Fin (Rs.a (p + 1))) R)) :
    Mono ((wcCgevK lamA hA Rs).d 0 1) ∧ ℓ • 𝟙 ((wcCgevK lamA hA Rs).homology 1) = 0 :=
by
  classical
  haveI : Limits.HasFiniteBiproducts 𝒜 := Abelian.hasFiniteBiproducts
  let φ : R →+ (A ⟶ A) := AddMonoidHom.mk' lamA hA.2.1

  have hmul : ∀ {a n b : ℕ} (X : Matrix (Fin a) (Fin n) R) (Y : Matrix (Fin n) (Fin b) R),
      Limits.biproduct.matrix (fun (j : Fin b) (i : Fin n) => lamA (Y i j)) ≫
        Limits.biproduct.matrix (fun (j : Fin n) (i : Fin a) => lamA (X i j)) =
      Limits.biproduct.matrix (fun (j : Fin b) (i : Fin a) => lamA ((X * Y) i j)) := by
    intro a n b X Y
    apply Limits.biproduct.hom_ext'
    intro j
    apply Limits.biproduct.hom_ext
    intro k
    simp only [Category.assoc, Limits.biproduct.matrix_π, Limits.biproduct.ι_matrix_assoc,
      Limits.biproduct.lift_desc, Limits.biproduct.ι_desc]
    have h1 : ∀ i, lamA (Y i j) ≫ lamA (X k i) = φ (X k i * Y i j) := fun i => (hA.2.2 _ _).symm
    have h2 : ∑ i, X k i * Y i j = (X * Y) k j := (Matrix.mul_apply).symm
    rw [Finset.sum_congr rfl (fun i _ => h1 i), ← map_sum, h2]
    rfl

  have hadd : ∀ {a b : ℕ} (M M' : Matrix (Fin a) (Fin b) R),
      Limits.biproduct.matrix (fun (j : Fin b) (i : Fin a) => lamA ((M + M') i j)) =
        Limits.biproduct.matrix (fun (j : Fin b) (i : Fin a) => lamA (M i j)) +
        Limits.biproduct.matrix (fun (j : Fin b) (i : Fin a) => lamA (M' i j)) := by
    intro a b M M'
    apply Limits.biproduct.hom_ext'
    intro j
    apply Limits.biproduct.hom_ext
    intro k
    simp only [Category.assoc, Preadditive.add_comp, Preadditive.comp_add,
      Limits.biproduct.matrix_π, Limits.biproduct.ι_desc, Matrix.add_apply, hA.2.1]

  have hone : ∀ {a : ℕ} (n : ℕ),
      Limits.biproduct.matrix
        (fun (j : Fin a) (i : Fin a) => lamA ((n • (1 : Matrix (Fin a) (Fin a) R)) i j)) =
        n • 𝟙 (⨁ fun _ : Fin a => A) := by
    intro a n
    apply Limits.biproduct.hom_ext'
    intro j
    apply Limits.biproduct.hom_ext
    intro k
    simp only [Category.assoc, Limits.biproduct.matrix_π, Limits.biproduct.ι_desc,
      Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Matrix.smul_apply]
    have e : ∀ x : R, lamA (n • x) = n • lamA x := fun x => map_nsmul φ n x
    rw [e]
    by_cases hkj : k = j
    · subst hkj
      rw [Matrix.one_apply_eq, hA.1, Limits.biproduct.ι_π_self]
    · have hz : lamA 0 = 0 := map_zero φ
      rw [Matrix.one_apply_ne hkj, Limits.biproduct.ι_π_ne _ (Ne.symm hkj), hz]

  have htf : ∀ {n : ℕ} {Z : 𝒜} (g : Z ⟶ (⨁ fun _ : Fin n => A)), ℓ • g = 0 → g = 0 := by
    intro n Z g hg
    apply Limits.biproduct.hom_ext
    intro j
    rw [Limits.zero_comp, ← cancel_mono (ℓ • 𝟙 A), Limits.zero_comp, Preadditive.comp_nsmul,
      Category.comp_id, ← Preadditive.nsmul_comp, hg, Limits.zero_comp]

  have hd : ∀ p, (wcCgevK lamA hA Rs).d p (p + 1) =
      Limits.biproduct.matrix
        (fun (j : Fin (Rs.a p)) (i : Fin (Rs.a (p + 1))) => lamA (Rs.c p i j)) :=
    fun p => CochainComplex.of_d (V := 𝒜) (fun p => ⨁ fun _ : Fin (Rs.a p) => A)
      (fun p => Limits.biproduct.matrix
        (fun (j : Fin (Rs.a p)) (i : Fin (Rs.a (p + 1))) => lamA (Rs.c p i j))) p

  obtain ⟨η, hη⟩ : ∃ η : ∀ p, (wcCgevK lamA hA Rs).X (p + 1) ⟶ (wcCgevK lamA hA Rs).X p,
      ∀ p, η p = Limits.biproduct.matrix
        (fun (j : Fin (Rs.a (p + 1))) (i : Fin (Rs.a p)) => lamA (H p i j)) :=
    ⟨fun p => Limits.biproduct.matrix
        (fun (j : Fin (Rs.a (p + 1))) (i : Fin (Rs.a p)) => lamA (H p i j)), fun _ => rfl⟩
  have h0 : (wcCgevK lamA hA Rs).d 0 1 ≫ η 0 = ℓ • 𝟙 ((wcCgevK lamA hA Rs).X 0) := by
    have e := hmul (H 0) (Rs.c 0)
    rw [hH0, hone] at e
    rw [hη]
    refine Eq.trans ?_ e
    exact congrArg (· ≫ _) (hd 0)
  have hs : ∀ p, (wcCgevK lamA hA Rs).d (p + 1) (p + 1 + 1) ≫ η (p + 1) +
      η p ≫ (wcCgevK lamA hA Rs).d p (p + 1) = ℓ • 𝟙 ((wcCgevK lamA hA Rs).X (p + 1)) := by
    intro p
    have e := hadd (H (p + 1) * Rs.c (p + 1)) (Rs.c p * H p)
    rw [hH p, hone, ← hmul, ← hmul] at e
    rw [hη, hη, hd, hd]
    exact e.symm

  have hm : Mono ((wcCgevK lamA hA Rs).d 0 1) := by
    apply Preadditive.mono_of_cancel_zero
    intro P g hg
    apply htf (n := Rs.a 0) g
    calc ℓ • g = g ≫ (ℓ • 𝟙 _) := by rw [Preadditive.comp_nsmul, Category.comp_id]
      _ = g ≫ (wcCgevK lamA hA Rs).d 0 1 ≫ η 0 := by rw [h0]
      _ = 0 := by rw [← Category.assoc, hg, Limits.zero_comp]

  obtain ⟨hh, hhη⟩ : ∃ hh : ∀ i j : ℕ, (ComplexShape.up ℕ).Rel j i →
      ((wcCgevK lamA hA Rs).X i ⟶ (wcCgevK lamA hA Rs).X j),
      ∀ j (r : (ComplexShape.up ℕ).Rel j (j + 1)), hh (j + 1) j r = η j :=
    ⟨fun i j hij => eqToHom (congrArg (wcCgevK lamA hA Rs).X
        (show j + 1 = i from hij).symm) ≫ η j, fun j r => by simp⟩
  have key : Homotopy.nullHomotopicMap' hh = ℓ • 𝟙 (wcCgevK lamA hA Rs) := by
    apply HomologicalComplex.hom_ext
    intro n
    rw [HomologicalComplex.nsmul_f_apply, HomologicalComplex.id_f]
    rcases n with _ | m
    · rw [Homotopy.nullHomotopicMap'_f_of_not_rel_right (c := ComplexShape.up ℕ)
        (show (ComplexShape.up ℕ).Rel 0 (0 + 1) from rfl)
        (fun l hl => Nat.succ_ne_zero l hl), hhη 0]
      exact h0
    · rw [Homotopy.nullHomotopicMap'_f (c := ComplexShape.up ℕ)
        (show (ComplexShape.up ℕ).Rel m (m + 1) from rfl)
        (show (ComplexShape.up ℕ).Rel (m + 1) (m + 1 + 1) from rfl), hhη, hhη]
      exact hs m
  have hz : Homotopy (ℓ • 𝟙 (wcCgevK lamA hA Rs)) 0 :=
    (Homotopy.ofEq key.symm).trans (Homotopy.nullHomotopy' hh)
  have hn : ∀ k : ℕ, HomologicalComplex.homologyMap (k • 𝟙 (wcCgevK lamA hA Rs)) 1 =
      k • 𝟙 ((wcCgevK lamA hA Rs).homology 1) := by
    intro k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, HomologicalComplex.homologyMap_zero]
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul, HomologicalComplex.homologyMap_add, ih,
        HomologicalComplex.homologyMap_id]
  refine ⟨hm, ?_⟩
  rw [← hn ℓ, hz.homologyMap_eq 1, HomologicalComplex.homologyMap_zero]

theorem wc_cgev_K_H1_classical (Y : Scheme.{u}) {R : Type u} [Ring R]
    {A : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}}
    (ℓ : ℕ) (hmono : Mono (ℓ • 𝟙 A)) (lamA : R → (A ⟶ A)) (hA : wcRingAct lamA)
    {N : ModuleCat.{u+1} R} (Rs : wcCgevRes N)
    (h0 : Mono ((wcCgevK lamA hA Rs).d 0 1))
    (h1 : ℓ • 𝟙 ((wcCgevK lamA hA Rs).homology 1) = 0)
    (hcl : ∃ E : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
      Nonempty (Limits.cokernel (ℓ • 𝟙 A) ≅ (wcEpsInv Y).obj E)) :
    ∃ H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
      ℓ • 𝟙 H = 0 ∧ Nonempty ((wcCgevK lamA hA Rs).homology 1 ≅ (wcEpsInv Y).obj H) :=
by
  classical
  haveI : Limits.HasFiniteBiproducts (Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) :=
    Abelian.hasFiniteBiproducts
  haveI : Limits.HasFiniteBiproducts (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    Abelian.hasFiniteBiproducts
  haveI := hmono
  haveI := h0

  have hcomm : ∀ r, (ℓ • 𝟙 A) ≫ lamA r = lamA r ≫ (ℓ • 𝟙 A) := by
    intro r
    rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
  let lamC : R → (Limits.cokernel (ℓ • 𝟙 A) ⟶ Limits.cokernel (ℓ • 𝟙 A)) := fun r =>
    Limits.cokernel.desc (ℓ • 𝟙 A) (lamA r ≫ Limits.cokernel.π (ℓ • 𝟙 A))
      (by rw [← Category.assoc, hcomm, Category.assoc, Limits.cokernel.condition, Limits.comp_zero])
  have hK : ∀ r, Limits.cokernel.π (ℓ • 𝟙 A) ≫ lamC r = lamA r ≫ Limits.cokernel.π (ℓ • 𝟙 A) :=
    fun r => Limits.cokernel.π_desc _ _ _
  have hC : wcRingAct lamC := by
    refine ⟨?_, ?_, ?_⟩
    · rw [← cancel_epi (Limits.cokernel.π (ℓ • 𝟙 A)), hK, hA.1, Category.id_comp, Category.comp_id]
    · intro a b
      rw [← cancel_epi (Limits.cokernel.π (ℓ • 𝟙 A)), hK, hA.2.1, Preadditive.add_comp,
        Preadditive.comp_add, hK, hK]
    · intro a b
      rw [← cancel_epi (Limits.cokernel.π (ℓ • 𝟙 A)), hK, hA.2.2, reassoc_of% (hK b), hK,
        Category.assoc]

  have hdA : ∀ p, (wcCgevK lamA hA Rs).d p (p + 1) =
      Limits.biproduct.matrix
        (fun (j : Fin (Rs.a p)) (i : Fin (Rs.a (p + 1))) => lamA (Rs.c p i j)) :=
    fun p => CochainComplex.of_d (V := Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
      (fun p => ⨁ fun _ : Fin (Rs.a p) => A)
      (fun p => Limits.biproduct.matrix
        (fun (j : Fin (Rs.a p)) (i : Fin (Rs.a (p + 1))) => lamA (Rs.c p i j))) p
  have hdC : ∀ p, (wcCgevK lamC hC Rs).d p (p + 1) =
      Limits.biproduct.matrix
        (fun (j : Fin (Rs.a p)) (i : Fin (Rs.a (p + 1))) => lamC (Rs.c p i j)) :=
    fun p => CochainComplex.of_d (V := Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
      (fun p => ⨁ fun _ : Fin (Rs.a p) => Limits.cokernel (ℓ • 𝟙 A))
      (fun p => Limits.biproduct.matrix
        (fun (j : Fin (Rs.a p)) (i : Fin (Rs.a (p + 1))) => lamC (Rs.c p i j))) p

  have hgcomm : ∀ p, (Limits.biproduct.map (fun _ : Fin (Rs.a p) => Limits.cokernel.π (ℓ • 𝟙 A)) :
        (⨁ fun _ : Fin (Rs.a p) => A) ⟶ ⨁ fun _ : Fin (Rs.a p) => Limits.cokernel (ℓ • 𝟙 A)) ≫
      (Limits.biproduct.matrix
        (fun (j : Fin (Rs.a p)) (i : Fin (Rs.a (p + 1))) => lamC (Rs.c p i j)) :
        (⨁ fun _ : Fin (Rs.a p) => Limits.cokernel (ℓ • 𝟙 A)) ⟶
          ⨁ fun _ : Fin (Rs.a (p + 1)) => Limits.cokernel (ℓ • 𝟙 A)) =
      (Limits.biproduct.matrix
        (fun (j : Fin (Rs.a p)) (i : Fin (Rs.a (p + 1))) => lamA (Rs.c p i j)) :
        (⨁ fun _ : Fin (Rs.a p) => A) ⟶ ⨁ fun _ : Fin (Rs.a (p + 1)) => A) ≫
      (Limits.biproduct.map (fun _ : Fin (Rs.a (p + 1)) => Limits.cokernel.π (ℓ • 𝟙 A)) :
        (⨁ fun _ : Fin (Rs.a (p + 1)) => A) ⟶
          ⨁ fun _ : Fin (Rs.a (p + 1)) => Limits.cokernel (ℓ • 𝟙 A)) := by
    intro p
    apply Limits.biproduct.hom_ext'
    intro j
    apply Limits.biproduct.hom_ext
    intro k
    simp only [Category.assoc, Limits.biproduct.ι_map_assoc, Limits.biproduct.map_π,
      Limits.biproduct.matrix_π, Limits.biproduct.matrix_π_assoc, Limits.biproduct.ι_desc,
      Limits.biproduct.ι_desc_assoc]
    exact hK _
  let g : wcCgevK lamA hA Rs ⟶ wcCgevK lamC hC Rs :=
    { f := fun p => (Limits.biproduct.map (fun _ : Fin (Rs.a p) => Limits.cokernel.π (ℓ • 𝟙 A)) :
          (⨁ fun _ : Fin (Rs.a p) => A) ⟶ ⨁ fun _ : Fin (Rs.a p) => Limits.cokernel (ℓ • 𝟙 A))
      comm' := by
        rintro i _ rfl
        rw [hdA, hdC]
        exact hgcomm i }
  have hπℓ : ℓ • Limits.cokernel.π (ℓ • 𝟙 A) = 0 := by
    have := Limits.cokernel.condition (ℓ • 𝟙 A)
    rwa [Preadditive.nsmul_comp, Category.id_comp] at this
  have hz : ∀ p, (ℓ • 𝟙 (⨁ fun _ : Fin (Rs.a p) => A)) ≫
      Limits.biproduct.map (fun _ : Fin (Rs.a p) => Limits.cokernel.π (ℓ • 𝟙 A)) = 0 := by
    intro p
    rw [Preadditive.nsmul_comp, Category.id_comp]
    apply Limits.biproduct.hom_ext'
    intro j
    rw [Preadditive.comp_nsmul, Limits.biproduct.ι_map, ← Preadditive.nsmul_comp, hπℓ,
      Limits.zero_comp, Limits.comp_zero]
  have w : (ℓ • 𝟙 (wcCgevK lamA hA Rs)) ≫ g = 0 := by
    apply HomologicalComplex.hom_ext
    intro p
    exact hz p

  have hT : ∀ p, (ShortComplex.mk (ℓ • 𝟙 (⨁ fun _ : Fin (Rs.a p) => A))
      (Limits.biproduct.map (fun _ : Fin (Rs.a p) => Limits.cokernel.π (ℓ • 𝟙 A))) (hz p)).ShortExact := by
    intro p
    have hdesc : ∀ {Z' : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}}
        (g' : (⨁ fun _ : Fin (Rs.a p) => A) ⟶ Z'), (ℓ • 𝟙 (⨁ fun _ : Fin (Rs.a p) => A)) ≫ g' = 0 →
        ∀ j, (ℓ • 𝟙 A) ≫ Limits.biproduct.ι (fun _ : Fin (Rs.a p) => A) j ≫ g' = 0 := by
      intro Z' g' hg' j
      rw [Preadditive.nsmul_comp, Category.id_comp, ← Preadditive.comp_nsmul, ← Category.id_comp g',
        ← Preadditive.nsmul_comp, hg', Limits.comp_zero]
    refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
    · apply ShortComplex.exact_of_g_is_cokernel
      refine Limits.CokernelCofork.IsColimit.ofπ _ _
        (fun {Z'} g' hg' => Limits.biproduct.desc (fun j => Limits.cokernel.desc (ℓ • 𝟙 A)
          (Limits.biproduct.ι (fun _ : Fin (Rs.a p) => A) j ≫ g') (hdesc g' hg' j))) ?_ ?_
      · intro Z' g' hg'
        apply Limits.biproduct.hom_ext'
        intro j
        simp only [Limits.biproduct.ι_map_assoc, Limits.biproduct.ι_desc, Limits.cokernel.π_desc]
      · intro Z' g' hg' m hm
        apply Limits.biproduct.hom_ext'
        intro j
        rw [← cancel_epi (Limits.cokernel.π (ℓ • 𝟙 A))]
        simp only [Limits.biproduct.ι_desc, Limits.cokernel.π_desc]
        rw [← hm]
        exact (Limits.biproduct.ι_map_assoc (fun _ : Fin (Rs.a p) => Limits.cokernel.π (ℓ • 𝟙 A))
          j m).symm
    · apply Preadditive.mono_of_cancel_zero
      intro Z' g' hg'
      have hg2 : ℓ • g' = 0 := by
        rw [← hg']
        show ℓ • g' = g' ≫ (ℓ • 𝟙 _)
        rw [Preadditive.comp_nsmul, Category.comp_id]
      apply Limits.biproduct.hom_ext
      intro j
      rw [Limits.zero_comp, ← cancel_mono (ℓ • 𝟙 A), Limits.zero_comp, Preadditive.comp_nsmul,
        Category.comp_id, ← Preadditive.nsmul_comp, hg2, Limits.zero_comp]
    · exact (inferInstance : Epi (Limits.biproduct.map
        (fun _ : Fin (Rs.a p) => Limits.cokernel.π (ℓ • 𝟙 A))))
  have hSE : (ShortComplex.mk (ℓ • 𝟙 (wcCgevK lamA hA Rs)) g w).ShortExact := by
    apply HomologicalComplex.shortExact_of_degreewise_shortExact
    intro p
    exact hT p

  have hr : (ComplexShape.up ℕ).Rel 0 1 := rfl
  have hZ0 : Limits.IsZero ((wcCgevK lamA hA Rs).homology 0) := by
    have hc : (wcCgevK lamA hA Rs).iCycles 0 = 0 := by
      rw [← cancel_mono ((wcCgevK lamA hA Rs).d 0 1), Limits.zero_comp]
      exact HomologicalComplex.iCycles_d _ _ _
    have : Limits.IsZero ((wcCgevK lamA hA Rs).cycles 0) := Limits.IsZero.of_mono_eq_zero _ hc
    exact this.of_iso (CochainComplex.isoHomologyπ₀ _).symm
  have hn : ∀ k : ℕ, HomologicalComplex.homologyMap (k • 𝟙 (wcCgevK lamA hA Rs)) 1 =
      k • 𝟙 ((wcCgevK lamA hA Rs).homology 1) := by
    intro k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, HomologicalComplex.homologyMap_zero]
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul, HomologicalComplex.homologyMap_add, ih,
        HomologicalComplex.homologyMap_id]
  have hδmono : Mono (hSE.δ 0 1 hr) := by
    apply (hSE.homology_exact₃ 0 1 hr).mono_g
    exact hZ0.eq_of_src _ _
  have hδepi : Epi (hSE.δ 0 1 hr) := by
    apply (hSE.homology_exact₁ 0 1 hr).epi_f
    exact (hn ℓ).trans h1
  haveI := hδmono
  haveI := hδepi
  haveI : IsIso (hSE.δ 0 1 hr) := isIso_of_mono_of_epi _
  let e₂ : (wcCgevK lamC hC Rs).homology 0 ≅ Limits.kernel ((wcCgevK lamC hC Rs).d 0 1) :=
    (CochainComplex.isoHomologyπ₀ _).symm ≪≫
      Limits.IsLimit.conePointUniqueUpToIso
        ((wcCgevK lamC hC Rs).cyclesIsKernel 0 1 (CochainComplex.next ℕ 0))
        (Limits.limit.isLimit _)
  let e₁ : (wcCgevK lamA hA Rs).homology 1 ≅ Limits.kernel ((wcCgevK lamC hC Rs).d 0 1) :=
    (asIso (hSE.δ 0 1 hr)).symm ≪≫ e₂

  haveI hcont : (wcEtToProEt Y).IsContinuous (Scheme.smallEtaleTopology Y)
      (Scheme.ProEt.topology Y) := (wc_etToProEt_flat_cont Y).2
  haveI hunitIso : IsIso (Functor.sheafPullbackConstruction.sheafAdjunctionContinuous
      (wcEtToProEt Y) AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y)
      (Scheme.ProEt.topology Y)).unit := by
    haveI := fun G => wc_epsInv_unit_iso Y G
    exact NatIso.isIso_of_isIso_app _
  let ff : (wcEpsInv Y).FullyFaithful :=
    (Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y)
      (Scheme.ProEt.topology Y)).fullyFaithfulLOfIsIsoUnit
  haveI := ff.full
  haveI := ff.faithful
  obtain ⟨hEz, hEl, hEc⟩ := wc_epsInv_exact Y
  haveI := hEz
  haveI := hEl
  haveI := hEc
  haveI : (wcEpsInv Y).Additive := Functor.additive_of_preserves_binary_products _

  obtain ⟨E, ⟨eC⟩⟩ := hcl
  let lamE : R → (E ⟶ E) := fun r => (wcEpsInv Y).preimage (eC.inv ≫ lamC r ≫ eC.hom)
  have hM : ∀ r, (wcEpsInv Y).map (lamE r) = eC.inv ≫ lamC r ≫ eC.hom :=
    fun r => (wcEpsInv Y).map_preimage _
  let dE : (⨁ fun _ : Fin (Rs.a 0) => E) ⟶ ⨁ fun _ : Fin (Rs.a (0 + 1)) => E :=
    Limits.biproduct.matrix (fun (j : Fin (Rs.a 0)) (i : Fin (Rs.a (0 + 1))) => lamE (Rs.c 0 i j))
  have hdC0 : (wcCgevK lamC hC Rs).d 0 1 =
      Limits.biproduct.matrix
        (fun (j : Fin (Rs.a 0)) (i : Fin (Rs.a (0 + 1))) => lamC (Rs.c 0 i j)) := hdC 0
  let Q : ∀ k : ℕ, (⨁ fun _ : Fin k => Limits.cokernel (ℓ • 𝟙 A)) ≅
      (wcEpsInv Y).obj (⨁ fun _ : Fin k => E) := fun k =>
    Limits.biproduct.mapIso (fun _ => eC) ≪≫ ((wcEpsInv Y).mapBiproduct (fun _ : Fin k => E)).symm
  have hcomp : ∀ (j : Fin (Rs.a 0)) (i : Fin (Rs.a (0 + 1))),
      (wcEpsInv Y).map (Limits.biproduct.ι (fun _ : Fin (Rs.a 0) => E) j) ≫
        (wcEpsInv Y).map dE ≫
          (wcEpsInv Y).map (Limits.biproduct.π (fun _ : Fin (Rs.a (0 + 1)) => E) i) =
      eC.inv ≫ lamC (Rs.c 0 i j) ≫ eC.hom := by
    intro j i
    rw [← Functor.map_comp, ← Functor.map_comp, ← hM]
    congr 1
    simp only [dE, Limits.biproduct.matrix_π, Limits.biproduct.ι_desc]
  have sqi : (Q (Rs.a 0)).hom ≫ (wcEpsInv Y).map dE ≫ (Q (Rs.a (0 + 1))).inv =
      (Limits.biproduct.matrix
        (fun (j : Fin (Rs.a 0)) (i : Fin (Rs.a (0 + 1))) => lamC (Rs.c 0 i j)) :
        (⨁ fun _ : Fin (Rs.a 0) => Limits.cokernel (ℓ • 𝟙 A)) ⟶
          ⨁ fun _ : Fin (Rs.a (0 + 1)) => Limits.cokernel (ℓ • 𝟙 A)) := by
    apply Limits.biproduct.hom_ext'
    intro j
    apply Limits.biproduct.hom_ext
    intro i
    simp only [Q, Iso.trans_hom, Iso.trans_inv, Iso.symm_hom, Iso.symm_inv, Category.assoc,
      Limits.biproduct.mapIso_hom, Limits.biproduct.mapIso_inv, Functor.mapBiproduct_hom,
      Functor.mapBiproduct_inv, Limits.biproduct.ι_map_assoc, Limits.biproduct.ι_desc_assoc,
      Limits.biproduct.map_π, Limits.biproduct.matrix_π, Limits.biproduct.ι_desc]
    erw [Limits.biproduct.lift_π_assoc]
    rw [reassoc_of% (hcomp j i), Iso.hom_inv_id_assoc, Iso.hom_inv_id, Category.comp_id]
  have sqm : (Limits.biproduct.matrix
        (fun (j : Fin (Rs.a 0)) (i : Fin (Rs.a (0 + 1))) => lamC (Rs.c 0 i j)) :
        (⨁ fun _ : Fin (Rs.a 0) => Limits.cokernel (ℓ • 𝟙 A)) ⟶
          ⨁ fun _ : Fin (Rs.a (0 + 1)) => Limits.cokernel (ℓ • 𝟙 A)) ≫ (Q (Rs.a (0 + 1))).hom =
      (Q (Rs.a 0)).hom ≫ (wcEpsInv Y).map dE := by
    rw [← sqi, Category.assoc, Category.assoc, Iso.inv_hom_id, Category.comp_id]
  have sq : (wcCgevK lamC hC Rs).d 0 1 ≫ (Q (Rs.a (0 + 1))).hom =
      (Q (Rs.a 0)).hom ≫ (wcEpsInv Y).map dE := by
    rw [hdC0]
    exact sqm
  let iso : (wcCgevK lamA hA Rs).homology 1 ≅ (wcEpsInv Y).obj (Limits.kernel dE) :=
    e₁ ≪≫ Limits.kernel.mapIso ((wcCgevK lamC hC Rs).d 0 1) ((wcEpsInv Y).map dE)
      (Q (Rs.a 0)) (Q (Rs.a (0 + 1))) sq ≪≫ (Limits.PreservesKernel.iso (wcEpsInv Y) dE).symm
  refine ⟨Limits.kernel dE, ?_, ⟨iso⟩⟩
  apply (wcEpsInv Y).map_injective
  rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
    CategoryTheory.Functor.map_zero]
  calc ℓ • 𝟙 ((wcEpsInv Y).obj (Limits.kernel dE))
      = iso.inv ≫ (ℓ • 𝟙 ((wcCgevK lamA hA Rs).homology 1)) ≫ iso.hom := by
        rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Iso.inv_hom_id]
    _ = 0 := by rw [h1, Limits.zero_comp, Limits.comp_zero]

theorem wc_cover_coker_ell_modpre {X V : Scheme.{u}} (q : V ⟶ X) (Z : Set X) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] :
    Nonempty (Limits.cokernel (ℓ • 𝟙 (wcCoverSheaf q Z ℓ)) ≅
      (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).obj (wcCcModPre q Z ℓ)) :=
by
  classical
  have hℓpos : (0 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos

  have hρc : Continuous (PadicInt.toZMod (p := ℓ)) := by
    rw [continuous_discrete_rng]
    intro b
    rw [Metric.isOpen_iff]
    intro y hy
    refine ⟨(ℓ : ℝ) ^ (-((1 : ℕ) : ℤ)), zpow_pos hℓpos _, ?_⟩
    intro z hz
    rw [Metric.mem_ball, dist_eq_norm] at hz
    have h1 : z - y ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ 1} :=
      (PadicInt.norm_le_pow_iff_mem_span_pow _ _).mp hz.le
    rw [pow_one, ← PadicInt.maximalIdeal_eq_span_p, ← PadicInt.ker_toZMod, RingHom.mem_ker,
      map_sub, sub_eq_zero] at h1
    simp only [Set.mem_preimage, Set.mem_singleton_iff] at hy ⊢
    rw [h1, hy]

  have hdiv : ∀ (T : Type u) [TopologicalSpace T] (g : C(T, ℤ_[ℓ])),
      (∀ t, PadicInt.toZMod (g t) = 0) →
      ∃ c : C(T, ℤ_[ℓ]), ∀ t, g t = (ℓ : ℤ_[ℓ]) ^ 1 * c t := by
    intro T _ g hg
    have hl : ((ℓ : ℚ_[ℓ]) ^ 1) ≠ 0 :=
      pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
    have hb : ∀ t, ‖((g t : ℚ_[ℓ])) / (ℓ : ℚ_[ℓ]) ^ 1‖ ≤ 1 := by
      intro t
      have h1 : g t ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ 1} := by
        rw [pow_one, ← PadicInt.maximalIdeal_eq_span_p, ← PadicInt.ker_toZMod, RingHom.mem_ker]
        exact hg t
      have h2 := (PadicInt.norm_le_pow_iff_mem_span_pow _ _).mpr h1
      rw [PadicInt.norm_def] at h2
      rw [norm_div, Padic.norm_p_pow]
      exact (div_le_one (zpow_pos hℓpos _)).mpr h2
    refine ⟨⟨fun t => (⟨(g t : ℚ_[ℓ]) / (ℓ : ℚ_[ℓ]) ^ 1, hb t⟩ : ℤ_[ℓ]),
      Continuous.subtype_mk ((continuous_subtype_val.comp g.continuous).div_const _) hb⟩, ?_⟩
    intro t
    apply PadicInt.ext
    rw [PadicInt.coe_mul, PadicInt.coe_pow, PadicInt.coe_natCast]
    change (g t : ℚ_[ℓ]) = (ℓ : ℚ_[ℓ]) ^ 1 * ((g t : ℚ_[ℓ]) / (ℓ : ℚ_[ℓ]) ^ 1)
    have hl' : (ℓ : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero
    rw [pow_one, mul_div_assoc', mul_comm, mul_div_assoc, div_self hl', mul_one]

  have crit : ∀ {F G H : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (f : F ⟶ G) (g : G ⟶ H),
      (∀ U (x : F.obj U), g.app U (f.app U x) = 0) →
      (∀ U, Function.Surjective (g.app U)) →
      (∀ U (x : G.obj U), g.app U x = 0 → ∃ y, f.app U y = x) →
      Nonempty (Limits.cokernel f ≅ H) := by
    intro F G H f g h1 h2 h3
    have hzero : ∀ {P Q : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (U : (X.ProEt)ᵒᵖ)
        (y : P.obj U), (0 : P ⟶ Q).app U y = 0 := by
      intro P Q U y
      rfl
    have hcomp : ∀ {P Q R : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (p : P ⟶ Q)
        (r : Q ⟶ R) (U : (X.ProEt)ᵒᵖ) (y : P.obj U),
        (p ≫ r).app U y = r.app U (p.app U y) := by
      intro P Q R p r U y
      rfl
    have w : f ≫ g = 0 := by
      ext U x
      rw [hcomp, hzero, h1]
    haveI : Epi g := by
      haveI : ∀ U, Epi (g.app U) := fun U => (AddCommGrpCat.epi_iff_surjective _).mpr (h2 U)
      exact NatTrans.epi_of_epi_app _
    have fac : ∀ {A : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (k : G ⟶ A),
        f ≫ k = 0 → {l : H ⟶ A // g ≫ l = k} := by
      intro A k hk
      have hk' : ∀ U (y : F.obj U), k.app U (f.app U y) = 0 := by
        intro U y
        have := congrArg (fun φ => φ.app U y) hk
        simp only at this
        rw [hcomp, hzero] at this
        exact this
      have hd : ∀ U (x x' : G.obj U), g.app U x = g.app U x' →
          k.app U x = k.app U x' := by
        intro U x x' hxx
        obtain ⟨y, hy⟩ := h3 U (x - x') (by rw [map_sub, hxx, sub_self])
        have := hk' U y
        rw [hy, map_sub, sub_eq_zero] at this
        exact this
      let σ : ∀ U, H.obj U → G.obj U := fun U => Function.surjInv (h2 U)
      have hσ : ∀ U φ, g.app U (σ U φ) = φ := fun U φ => Function.surjInv_eq (h2 U) φ
      let lU : ∀ U, H.obj U ⟶ A.obj U := fun U => AddCommGrpCat.ofHom
        (AddMonoidHom.mk' (fun φ => k.app U (σ U φ)) (by
          intro φ ψ
          rw [← map_add]
          apply hd
          rw [map_add, hσ, hσ, hσ]))
      have hlU : ∀ U φ, lU U φ = k.app U (σ U φ) := fun U φ => rfl
      let l : H ⟶ A :=
        { app := lU
          naturality := by
            intro U V r
            ext φ
            rw [CategoryTheory.comp_apply, CategoryTheory.comp_apply, hlU, hlU,
              ← NatTrans.naturality_apply]
            apply hd
            rw [hσ, NatTrans.naturality_apply, hσ] }
      refine ⟨l, ?_⟩
      ext U x
      rw [hcomp]
      change lU U (g.app U x) = k.app U x
      rw [hlU]
      apply hd
      rw [hσ]
    exact ⟨Limits.IsColimit.coconePointUniqueUpToIso (Limits.cokernelIsCokernel f)
      (Limits.CokernelCofork.IsColimit.ofπ' g w fac)⟩

  have hbot : ∀ (F : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (U : (X.ProEt)ᵒᵖ) (z : F.obj U),
      z ∈ wcExtZeroSub F (fun T : X.ProEt => ∀ t, T.hom t ∉ Z) U →
      ¬ (∀ t, (Opposite.unop U).hom t ∉ Z) → z = 0 := by
    intro F U z hz hU
    have hb : wcExtZeroSub F (fun T : X.ProEt => ∀ t, T.hom t ∉ Z) U = ⊥ := iSup_neg hU
    rw [hb, AddSubgroup.mem_bot] at hz
    exact hz
  have htop : ∀ (F : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (U : (X.ProEt)ᵒᵖ) (z : F.obj U),
      (∀ t, (Opposite.unop U).hom t ∉ Z) →
      z ∈ wcExtZeroSub F (fun T : X.ProEt => ∀ t, T.hom t ∉ Z) U := by
    intro F U z hU
    have hb : wcExtZeroSub F (fun T : X.ProEt => ∀ t, T.hom t ∉ Z) U = ⊤ := iSup_pos hU
    rw [hb]
    exact AddSubgroup.mem_top _

  let ρ : continuousMapPresheafAb.{0, u} ℤ_[ℓ] ⟶ continuousMapPresheafAb.{0, u} (ZMod ℓ) :=
    { app := fun U => AddCommGrpCat.ofHom (AddMonoidHom.compLeftContinuous
          (↥(Opposite.unop U)) (PadicInt.toZMod (p := ℓ)).toAddMonoidHom hρc)
      naturality := fun U V f => by ext g; rfl }
  let red : wcCcPre q Z ℓ ⟶ wcCcModPre q Z ℓ :=
    wcExtZeroMap (Functor.whiskerLeft (wcPbFun q).op
      (Functor.whiskerRight ρ AddCommGrpCat.uliftFunctor.{u+1, u}))
      (fun T : X.ProEt => ∀ t, T.hom t ∉ Z)
      (fun g h t => by rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]; exact h _)

  have h1 : ∀ U (x : (wcCcPre q Z ℓ).obj U),
      red.app U ((ℓ • 𝟙 (wcCcPre q Z ℓ)).app U x) = 0 := by
    intro U x
    let f0 : C(↥((wcPbFun q).obj U.unop), ℤ_[ℓ]) :=
      ULift.down (x.1 : ULift.{u+1} C(↥((wcPbFun q).obj U.unop), ℤ_[ℓ]))
    apply Subtype.ext
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    change PadicInt.toZMod (ℓ • f0 t) = 0
    rw [nsmul_eq_mul, map_mul, map_natCast, ZMod.natCast_self, zero_mul]
  have h2 : ∀ U, Function.Surjective (red.app U) := by
    intro U φ
    by_cases hU : ∀ t, (Opposite.unop U).hom t ∉ Z
    · let φ0 : C(↥((wcPbFun q).obj U.unop), ZMod ℓ) :=
        ULift.down (φ.1 : ULift.{u+1} C(↥((wcPbFun q).obj U.unop), ZMod ℓ))
      let ψ0 : C(↥((wcPbFun q).obj U.unop), ℤ_[ℓ]) :=
        ⟨fun t => (((φ0 t).val : ℕ) : ℤ_[ℓ]),
          (continuous_of_discreteTopology
            (f := fun b : ZMod ℓ => ((b.val : ℕ) : ℤ_[ℓ]))).comp φ0.continuous⟩
      refine ⟨⟨ULift.up ψ0, htop _ U _ hU⟩, ?_⟩
      apply Subtype.ext
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      change PadicInt.toZMod (((φ0 t).val : ℕ) : ℤ_[ℓ]) = φ0 t
      rw [map_natCast, ZMod.natCast_zmod_val]
    · refine ⟨0, ?_⟩
      rw [map_zero]
      exact (Subtype.ext (hbot _ U φ.1 φ.2 hU)).symm
  have h3 : ∀ U (x : (wcCcPre q Z ℓ).obj U), red.app U x = 0 →
      ∃ y, (ℓ • 𝟙 (wcCcPre q Z ℓ)).app U y = x := by
    intro U x hx
    by_cases hU : ∀ t, (Opposite.unop U).hom t ∉ Z
    · let f0 : C(↥((wcPbFun q).obj U.unop), ℤ_[ℓ]) :=
        ULift.down (x.1 : ULift.{u+1} C(↥((wcPbFun q).obj U.unop), ℤ_[ℓ]))
      have hx' : ∀ t, PadicInt.toZMod (f0 t) = 0 := by
        intro t
        have := congrArg (fun z : (wcCcModPre q Z ℓ).obj U =>
          ((ULift.down z.1 : C(↥((wcPbFun q).obj U.unop), ZMod ℓ)) t)) hx
        exact this
      obtain ⟨c, hc⟩ := hdiv _ f0 hx'
      refine ⟨⟨ULift.up c, htop _ U _ hU⟩, ?_⟩
      apply Subtype.ext
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      change ℓ • c t = f0 t
      rw [hc t, pow_one, nsmul_eq_mul]
    · refine ⟨0, ?_⟩
      rw [map_zero]
      exact (Subtype.ext (hbot _ U x.1 x.2 hU)).symm

  obtain ⟨e₀⟩ := crit (ℓ • 𝟙 (wcCcPre q Z ℓ)) red h1 h2 h3
  have hmap : (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
      (ℓ • 𝟙 (wcCcPre q Z ℓ)) =
      ℓ • 𝟙 ((presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).obj
        (wcCcPre q Z ℓ)) := by
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
  exact ⟨Limits.cokernelIsoOfEq hmap.symm ≪≫
    (Limits.PreservesCokernel.iso (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
      (ℓ • 𝟙 (wcCcPre q Z ℓ))).symm ≪≫
    (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).mapIso e₀⟩

theorem wc_galcover_section_partition {X U V : Scheme.{u}} (ι : U ⟶ X) [IsOpenImmersion ι]
    (q' : V ⟶ U) (Γ : Type u) [Group Γ] (α : Γ →* Aut V) (hG : wcGalCover q' Γ α)
    (hα : ∀ γ, (α γ).hom ≫ q' ≫ ι = q' ≫ ι) (W : Scheme.{u}) (h : W ⟶ X) (t : W ⟶ V)
    (ht : h = t ≫ q' ≫ ι) :
    (∀ z : ↥(Limits.pullback h (q' ≫ ι)), ∃! γ : Γ, z ∈ Set.range ⇑(Limits.pullback.lift (𝟙 W)
      (t ≫ (α γ).hom) (by rw [Category.id_comp, ht, Category.assoc, hα γ]) :
        W ⟶ Limits.pullback h (q' ≫ ι))) ∧
    ∀ γ : Γ, Topology.IsOpenEmbedding ⇑(Limits.pullback.lift (𝟙 W) (t ≫ (α γ).hom)
      (by rw [Category.id_comp, ht, Category.assoc, hα γ]) : W ⟶ Limits.pullback h (q' ≫ ι)) :=
by
  classical
  obtain ⟨hfin, -, -, -, hα', hiso⟩ := hG
  haveI : Finite Γ := hfin

  open CategoryTheory.Limits in
  have s1 : ∀ {X W V T₀ : Scheme.{u}} (q' : V ⟶ W) (ι : W ⟶ X) [Mono ι] (Γ : Type u) [Finite Γ]
      (β : Γ → (V ⟶ V)) (hβ : ∀ γ, β γ ≫ q' = q')
      (_ : IsIso (Sigma.desc (fun γ : Γ => pullback.lift (β γ) (𝟙 V)
        ((hβ γ).trans (Category.id_comp q').symm)) : ∐ (fun _ : Γ => V) ⟶ pullback q' q'))
      (h : T₀ ⟶ X) (t : T₀ ⟶ V) (_ : h = t ≫ q' ≫ ι)
      (s : Γ → (T₀ ⟶ pullback h (q' ≫ ι)))
      (_ : ∀ γ, s γ ≫ pullback.fst h (q' ≫ ι) = 𝟙 T₀)
      (_ : ∀ γ, s γ ≫ pullback.snd h (q' ≫ ι) = t ≫ β γ),
      IsIso (Sigma.desc s) := by
    intro X W V T₀ q' ι _ Γ _ β hβ hiso h t ht s hs1 hs2
    let a : Cofan (fun _ : Γ => V) := Cofan.mk (pullback q' q') (fun γ => pullback.lift (β γ) (𝟙 V)
        ((hβ γ).trans (Category.id_comp q').symm))
    have hc : IsColimit a := ((Cofan.nonempty_isColimit_iff_isIso_sigmaDesc a).mpr hiso).some
    have hau : IsUniversalColimit a := FinitaryPreExtensive.isUniversal_finiteCoproducts hc
    have w₀ : pullback.snd h (q' ≫ ι) ≫ q' = (pullback.fst h (q' ≫ ι) ≫ t) ≫ q' := by
      apply (cancel_mono ι).mp
      simp only [Category.assoc]
      rw [← ht]
      exact pullback.condition.symm
    let p₂ : pullback h (q' ≫ ι) ⟶ pullback q' q' :=
      pullback.lift (pullback.snd h (q' ≫ ι)) (pullback.fst h (q' ≫ ι) ≫ t) w₀
    have hp₂f : p₂ ≫ pullback.fst q' q' = pullback.snd h (q' ≫ ι) := pullback.lift_fst _ _ _
    have hp₂s : p₂ ≫ pullback.snd q' q' = pullback.fst h (q' ≫ ι) ≫ t := pullback.lift_snd _ _ _
    have h₀ : IsPullback (pullback.fst h (q' ≫ ι)) p₂ t (pullback.snd q' q') := by
      refine IsPullback.of_isLimit (c := PullbackCone.mk (pullback.fst h (q' ≫ ι)) p₂ hp₂s.symm) ?_
      have w₁ : ∀ c : PullbackCone t (pullback.snd q' q'),
          c.fst ≫ h = (c.snd ≫ pullback.fst q' q') ≫ q' ≫ ι := by
        intro c
        have hc' := c.condition
        calc c.fst ≫ h = (c.fst ≫ t) ≫ q' ≫ ι := by rw [ht, Category.assoc]
          _ = (c.snd ≫ pullback.snd q' q') ≫ q' ≫ ι := by rw [hc']
          _ = (c.snd ≫ pullback.fst q' q') ≫ q' ≫ ι := by
            simp only [Category.assoc, pullback.condition_assoc]
      refine PullbackCone.IsLimit.mk _
        (fun c => pullback.lift c.fst (c.snd ≫ pullback.fst q' q') (w₁ c)) ?_ ?_ ?_
      · intro c
        exact pullback.lift_fst _ _ _
      · intro c
        apply pullback.hom_ext
        · rw [Category.assoc, hp₂f, pullback.lift_snd]
        · rw [Category.assoc, hp₂s, ← Category.assoc, pullback.lift_fst]
          exact c.condition
      · intro c m hm1 hm2
        apply pullback.hom_ext
        · rw [pullback.lift_fst]
          exact hm1
        · rw [pullback.lift_snd, ← hp₂f, ← Category.assoc]
          exact congrArg (· ≫ pullback.fst q' q') hm2
    let d : Cofan (fun _ : Γ => T₀) := Cofan.mk (pullback h (q' ≫ ι)) s
    have hd := hau.nonempty_isColimit_of_isPullback_left (fun _ => 𝟙 V) (pullback.snd q' q') t
      (fun _ => 𝟙 T₀) (fun _ => t) (fun _ => IsPullback.id_horiz t) h₀ d (Iso.refl _)
      (fun γ => pullback.lift_snd _ _ _)
      (fun γ => by
        show s γ ≫ 𝟙 _ ≫ _ = _
        rw [Category.id_comp]
        exact hs1 γ)
      (fun γ => by
        show s γ ≫ 𝟙 _ ≫ p₂ = t ≫ pullback.lift (β γ) (𝟙 V) _
        rw [Category.id_comp]
        apply pullback.hom_ext
        · rw [Category.assoc, hp₂f, hs2, Category.assoc, pullback.lift_fst]
        · rw [Category.assoc, hp₂s, ← Category.assoc, hs1, Category.assoc, pullback.lift_snd,
            Category.id_comp, Category.comp_id])
    exact (Cofan.nonempty_isColimit_iff_isIso_sigmaDesc d).mp hd

  open CategoryTheory.Limits in
  have s2 : ∀ {P T₀ : Scheme.{u}} (Γ : Type u) (s : Γ → (T₀ ⟶ P)) (_ : IsIso (Sigma.desc s)),
      (∀ z : ↥P, ∃! γ : Γ, z ∈ Set.range ⇑(s γ)) ∧ ∀ γ : Γ, Topology.IsOpenEmbedding ⇑(s γ) := by
    intro P T₀ Γ s hs
    let H : (Σ _ : Γ, ↥T₀) ≃ₜ ↥P :=
      (sigmaMk (fun _ : Γ => T₀)).trans (Scheme.homeoOfIso (asIso (Sigma.desc s)))
    have hH : ∀ γ x, H ⟨γ, x⟩ = s γ x := by
      intro γ x
      simp only [H, Homeomorph.trans_apply, sigmaMk_mk, Scheme.homeoOfIso_apply, asIso_hom]
      rw [← Scheme.Hom.comp_apply, Sigma.ι_comp_desc]
    refine ⟨fun z => ?_, fun γ => ?_⟩
    · obtain ⟨⟨γ, x⟩, rfl⟩ := H.surjective z
      refine ⟨γ, ⟨x, (hH γ x).symm⟩, ?_⟩
      rintro γ' ⟨x', hx'⟩
      rw [← hH] at hx'
      exact congrArg Sigma.fst (H.injective hx')
    · haveI : IsOpenImmersion (Sigma.ι (fun _ : Γ => T₀) γ ≫ Sigma.desc s) := inferInstance
      have e : s γ = Sigma.ι (fun _ : Γ => T₀) γ ≫ Sigma.desc s := (Sigma.ι_comp_desc s γ).symm
      rw [e]
      exact Scheme.Hom.isOpenEmbedding _
  have hsw : ∀ γ : Γ, 𝟙 W ≫ h = (t ≫ (α γ).hom) ≫ q' ≫ ι := by
    intro γ
    rw [Category.id_comp, ht, Category.assoc, hα γ]
  let s : Γ → (W ⟶ Limits.pullback h (q' ≫ ι)) := fun γ =>
    Limits.pullback.lift (𝟙 W) (t ≫ (α γ).hom) (hsw γ)
  have hσ : IsIso (Limits.Sigma.desc s) :=
    s1 q' ι Γ (fun γ => (α γ).hom) hα' hiso h t ht s
      (fun γ => Limits.pullback.lift_fst _ _ _) (fun γ => Limits.pullback.lift_snd _ _ _)
  exact s2 Γ s hσ

theorem wc_cover_modpre_local_etale (K : Type u) [Field K] [Finite K]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α) (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
    (hpart : ∀ (W : Scheme.{u}) (h : W ⟶ (wcP1Over K).left) (t : W ⟶ V)
      (ht : h = t ≫ q' ≫ Uo.ι),
      (∀ z : ↥(Limits.pullback h (q' ≫ Uo.ι)), ∃! γ : Γ, z ∈ Set.range ⇑(Limits.pullback.lift
        (𝟙 W) (t ≫ (α γ).hom) (by rw [Category.id_comp, ht, Category.assoc, hα γ]) :
          W ⟶ Limits.pullback h (q' ≫ Uo.ι))) ∧
      ∀ γ : Γ, Topology.IsOpenEmbedding ⇑(Limits.pullback.lift (𝟙 W) (t ≫ (α γ).hom)
        (by rw [Category.id_comp, ht, Category.assoc, hα γ]) :
          W ⟶ Limits.pullback h (q' ≫ Uo.ι))) :
    ∀ (T : (wcP1Over K).left.ProEt)
      (x : (wcCcModPre (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ).obj
        (Opposite.op T)),
      Sieve.generate (fun (W : (wcP1Over K).left.ProEt) (g : W ⟶ T) =>
        ∃ (V₁ : (wcP1Over K).left.Etale) (c : W ⟶ (wcEtToProEt (wcP1Over K).left).obj V₁)
          (σ : (wcCcModPre (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ).obj
            (Opposite.op ((wcEtToProEt (wcP1Over K).left).obj V₁))),
          ((wcCcModPre (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ).map
            g.op).hom x =
          ((wcCcModPre (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ).map
            c.op).hom σ) ∈ Scheme.ProEt.topology (wcP1Over K).left T :=
by
  classical
  haveI : Finite Γ := hG.1
  haveI : NeZero ℓ := ⟨(Fact.out : ℓ.Prime).ne_zero⟩

  have hcov : ∀ (S' : Scheme.{u}) (Q : S'.ProEt) (n : ℕ) (W : Fin n → S'.ProEt)
      (h : ∀ k, W k ⟶ Q), (∀ k, IsOpenMap ⇑(h k).left) →
      (∀ x : ↥Q.left, ∃ k, x ∈ Set.range ⇑(h k).left) →
      Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology S' Q := by
    intro S' Q n W h hO hJ
    have hs : ∀ x : Q.left, ∃ j y, (h j).left y = x := by
      intro x; obtain ⟨j, y, hy⟩ := hJ x; exact ⟨j, y, hy⟩
    have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
      have h1 : WeaklyEtale ((h i).left ≫ Q.hom) := by
        rw [MorphismProperty.Over.w (h i)]; exact (W i).prop
      exact @WeaklyEtale.of_comp _ _ _ (h i).left Q.hom h1 Q.prop
    have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
        Scheme.proetalePrecoverage.coverings Q.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (QuasiCompactCover.of_isOpenMap
        (𝒰 := Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
          hs (fun _ => trivial)) (fun i => hO i)),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
    exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))

  let F := (wcPbFun (q' ≫ Uo.ι)).op ⋙ continuousMapPresheafAb.{0, u} (ZMod ℓ) ⋙
    AddCommGrpCat.uliftFunctor.{u+1, u}
  let pZ : (wcP1Over K).left.ProEt → Prop := fun T =>
    ∀ t, T.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K))
  let Qpre := wcCcModPre (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ
  let ev : ∀ T : (wcP1Over K).left.ProEt, Qpre.obj (Opposite.op T) →
      C(↥(Limits.pullback T.hom (q' ≫ Uo.ι)), ZMod ℓ) := fun T x =>
    (Subtype.val (p := fun z => z ∈ wcExtZeroSub F pZ (Opposite.op T)) x).down
  have hev_inj : ∀ (T : (wcP1Over K).left.ProEt) (x y : Qpre.obj (Opposite.op T)),
      ev T x = ev T y → x = y := by
    intro T x y hxy
    exact Subtype.ext (ULift.ext _ _ hxy)
  have hev_surj : ∀ T : (wcP1Over K).left.ProEt, pZ T →
      ∀ f : C(↥(Limits.pullback T.hom (q' ≫ Uo.ι)), ZMod ℓ), ∃ x, ev T x = f := by
    intro T hT f
    have hsub : wcExtZeroSub F pZ (Opposite.op T) = ⊤ := iSup_pos hT
    exact ⟨(⟨ULift.up f, by rw [hsub]; exact AddSubgroup.mem_top _⟩ :
      ↥(wcExtZeroSub F pZ (Opposite.op T))), rfl⟩
  have hev_zero : ∀ T : (wcP1Over K).left.ProEt, ¬ pZ T →
      ∀ x : Qpre.obj (Opposite.op T), x = 0 := by
    intro T hT x
    have hb : wcExtZeroSub F pZ (Opposite.op T) = ⊥ := iSup_neg hT
    have hm := Subtype.property (p := fun z => z ∈ wcExtZeroSub F pZ (Opposite.op T)) x
    have hm' : Subtype.val (p := fun z => z ∈ wcExtZeroSub F pZ (Opposite.op T)) x = 0 := by
      simp only [hb, AddSubgroup.mem_bot] at hm
      exact hm
    apply hev_inj
    show (Subtype.val (p := fun z => z ∈ wcExtZeroSub F pZ (Opposite.op T)) x).down = _
    rw [hm']
    rfl
  have hwg : ∀ {A B : (wcP1Over K).left.ProEt} (g : A ⟶ B),
      (Limits.pullback.fst A.hom (q' ≫ Uo.ι) ≫ g.left) ≫ B.hom =
        Limits.pullback.snd A.hom (q' ≫ Uo.ι) ≫ q' ≫ Uo.ι := by
    intro A B g
    rw [Category.assoc, MorphismProperty.Over.w g]
    exact Limits.pullback.condition
  have hnat : ∀ {A B : (wcP1Over K).left.ProEt} (g : A ⟶ B) (y : Qpre.obj (Opposite.op B))
      (z : ↥(Limits.pullback A.hom (q' ≫ Uo.ι))),
      ev A ((Qpre.map g.op).hom y) z = ev B y (Limits.pullback.lift _ _ (hwg g) z) := by
    intro A B g y z
    have e : ((wcPbFun (q' ≫ Uo.ι)).map g :
        Limits.pullback A.hom (q' ≫ Uo.ι) ⟶ Limits.pullback B.hom (q' ≫ Uo.ι)) =
        Limits.pullback.lift _ _ (hwg g) := Over.pullback_map_left _ _
    exact congrArg (fun φ : Limits.pullback A.hom (q' ≫ Uo.ι) ⟶
      Limits.pullback B.hom (q' ≫ Uo.ι) => ev B y (φ z)) e

  have hpZV : ∀ y : V, (q' ≫ Uo.ι) y ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K)) := by
    rintro y ⟨i, hi⟩
    have hmem : Uo.ι (q' y) ∈ Uo := by
      have h1 : Uo.ι (q' y) ∈ Set.range Uo.ι := ⟨_, rfl⟩
      rwa [Scheme.Opens.range_ι] at h1
    rw [Scheme.Hom.comp_apply] at hi
    exact (hUo _).mp hmem i hi.symm

  haveI : Etale q' := hG.2.2.1
  have hq : Etale (q' ≫ Uo.ι) := inferInstance
  let Vet : (wcP1Over K).left.Etale := wcTorsorEt (q' ≫ Uo.ι) hq
  have hsr : ∀ γ : Γ, 𝟙 V ≫ q' ≫ Uo.ι = (𝟙 V ≫ (α γ).hom) ≫ q' ≫ Uo.ι := fun γ => by
    simp only [Category.id_comp, Category.assoc, hα]
  let r : Γ → (V ⟶ Limits.pullback (q' ≫ Uo.ι) (q' ≫ Uo.ι)) := fun γ =>
    Limits.pullback.lift (𝟙 V) (𝟙 V ≫ (α γ).hom) (hsr γ)
  obtain ⟨hVpart, hVopen⟩ := hpart V (q' ≫ Uo.ι) (𝟙 V) (Category.id_comp _).symm
  have L1 : ∀ D : Γ → ZMod ℓ, ∃ σa : C(↥(Limits.pullback (q' ≫ Uo.ι) (q' ≫ Uo.ι)), ZMod ℓ),
      ∀ γ y, σa (r γ y) = D γ := by
    intro D
    let gz : ↥(Limits.pullback (q' ≫ Uo.ι) (q' ≫ Uo.ι)) → Γ := fun z => (hVpart z).exists.choose
    have hgz : ∀ z, z ∈ Set.range (r (gz z)) := fun z => (hVpart z).exists.choose_spec
    have hgz' : ∀ γ y, gz (r γ y) = γ := fun γ y =>
      (hVpart (r γ y)).unique (hgz _) ⟨y, rfl⟩
    refine ⟨⟨fun z => D (gz z), ?_⟩, fun γ y => ?_⟩
    · rw [continuous_def]
      intro s _
      rw [isOpen_iff_forall_mem_open]
      intro z hz
      refine ⟨Set.range (r (gz z)), ?_, (hVopen (gz z)).isOpen_range, hgz z⟩
      rintro _ ⟨y, rfl⟩
      show D (gz (r (gz z) y)) ∈ s
      rw [hgz']
      exact hz
    · show D (gz (r γ y)) = D γ
      rw [hgz']

  have core : ∀ (T' : (wcP1Over K).left.ProEt) (t' : T'.left ⟶ V),
      T'.hom = t' ≫ q' ≫ Uo.ι → ∀ x' : Qpre.obj (Opposite.op T'),
      Sieve.generate (fun (W : (wcP1Over K).left.ProEt) (g : W ⟶ T') =>
        ∃ (V₁ : (wcP1Over K).left.Etale) (c : W ⟶ (wcEtToProEt (wcP1Over K).left).obj V₁)
          (σ : Qpre.obj (Opposite.op ((wcEtToProEt (wcP1Over K).left).obj V₁))),
          (Qpre.map g.op).hom x' = (Qpre.map c.op).hom σ) ∈
        Scheme.ProEt.topology (wcP1Over K).left T' := by
    intro T' t' ht' x'
    let f₀ := ev T' x'
    have hsw : ∀ γ : Γ, 𝟙 T'.left ≫ T'.hom = (t' ≫ (α γ).hom) ≫ q' ≫ Uo.ι := fun γ => by
      simp only [Category.id_comp, ht', Category.assoc, hα]
    let s : Γ → (T'.left ⟶ Limits.pullback T'.hom (q' ≫ Uo.ι)) := fun γ =>
      Limits.pullback.lift (𝟙 T'.left) (t' ≫ (α γ).hom) (hsw γ)
    let d : T'.left → (Γ → ZMod ℓ) := fun w γ => f₀ (s γ w)
    have hd : Continuous d := continuous_pi fun γ => f₀.continuous.comp (s γ).continuous
    haveI : WeaklyEtale T'.hom := T'.prop
    let e := Finite.equivFin (Γ → ZMod ℓ)
    let O : Fin (Nat.card (Γ → ZMod ℓ)) → T'.left.Opens := fun k =>
      ⟨d ⁻¹' {e.symm k}, (isOpen_discrete _).preimage hd⟩
    let Wk : Fin (Nat.card (Γ → ZMod ℓ)) → (wcP1Over K).left.ProEt := fun k =>
      Scheme.ProEt.mk ((O k).ι ≫ T'.hom)
    let jk : ∀ k, Wk k ⟶ T' := fun k => MorphismProperty.Over.homMk (O k).ι rfl trivial
    have hcovT := hcov _ T' _ Wk jk (fun k => (O k).ι.isOpenEmbedding.isOpenMap)
      (fun w => ⟨e (d w), by
        show w ∈ Set.range (O (e (d w))).ι
        rw [Scheme.Opens.range_ι]
        show d w ∈ ({e.symm (e (d w))} : Set _)
        rw [Equiv.symm_apply_apply]
        exact Set.mem_singleton _⟩)
    have key : ∀ (W : (wcP1Over K).left.ProEt) (j : W ⟶ T') (a : Γ → ZMod ℓ),
        (∀ w, d (j.left w) = a) →
        ∃ (V₁ : (wcP1Over K).left.Etale) (c : W ⟶ (wcEtToProEt (wcP1Over K).left).obj V₁)
          (σ : Qpre.obj (Opposite.op ((wcEtToProEt (wcP1Over K).left).obj V₁))),
          (Qpre.map j.op).hom x' = (Qpre.map c.op).hom σ := by
      intro W j a hda
      obtain ⟨σa, hσa⟩ := L1 a
      obtain ⟨σ, hσ⟩ := hev_surj ((wcEtToProEt (wcP1Over K).left).obj Vet) (fun y => hpZV y) σa
      have hc : (j.left ≫ t') ≫ q' ≫ Uo.ι = W.hom := by
        rw [Category.assoc, ← ht', MorphismProperty.Over.w j]
      let c : W ⟶ (wcEtToProEt (wcP1Over K).left).obj Vet :=
        MorphismProperty.Over.homMk (j.left ≫ t') hc trivial
      refine ⟨Vet, c, σ, ?_⟩
      let Jm : Limits.pullback W.hom (q' ≫ Uo.ι) ⟶ Limits.pullback T'.hom (q' ≫ Uo.ι) :=
        Limits.pullback.lift _ _ (hwg j)
      have hwC : (Limits.pullback.fst W.hom (q' ≫ Uo.ι) ≫ (j.left ≫ t')) ≫ q' ≫ Uo.ι =
          Limits.pullback.snd W.hom (q' ≫ Uo.ι) ≫ q' ≫ Uo.ι := by
        rw [Category.assoc, hc]; exact Limits.pullback.condition
      let Cm : Limits.pullback W.hom (q' ≫ Uo.ι) ⟶
          Limits.pullback (q' ≫ Uo.ι) (q' ≫ Uo.ι) :=
        Limits.pullback.lift _ _ hwC
      apply hev_inj
      ext z
      have hcW : W.hom = (j.left ≫ t') ≫ q' ≫ Uo.ι := hc.symm
      obtain ⟨γ, ⟨w, hw⟩, -⟩ := (hpart W.left W.hom (j.left ≫ t') hcW).1 z
      have hvw : 𝟙 W.left ≫ W.hom = ((j.left ≫ t') ≫ (α γ).hom) ≫ q' ≫ Uo.ι := by
        rw [Category.id_comp, hcW]; simp only [Category.assoc, hα]
      let v : W.left ⟶ Limits.pullback W.hom (q' ≫ Uo.ι) :=
        Limits.pullback.lift (𝟙 _) ((j.left ≫ t') ≫ (α γ).hom) hvw
      have hw' : v w = z := hw
      subst hw'
      have hJv : v ≫ Jm = j.left ≫ s γ := by
        apply Limits.pullback.hom_ext
        · simp only [v, Jm, s, Category.assoc, Limits.pullback.lift_fst,
            Limits.pullback.lift_fst_assoc, Category.id_comp, Category.comp_id]
        · simp only [v, Jm, s, Category.assoc, Limits.pullback.lift_snd,
            Limits.pullback.lift_snd_assoc, Category.id_comp]
      have hCv : v ≫ Cm = (j.left ≫ t') ≫ r γ := by
        apply Limits.pullback.hom_ext
        · simp only [v, Cm, r, Category.assoc, Limits.pullback.lift_fst,
            Limits.pullback.lift_fst_assoc, Category.id_comp, Category.comp_id]
        · simp only [v, Cm, r, Category.assoc, Limits.pullback.lift_snd,
            Limits.pullback.lift_snd_assoc, Category.id_comp]
      have hJz : Jm (v w) = s γ (j.left w) := by
        rw [← Scheme.Hom.comp_apply, hJv, Scheme.Hom.comp_apply]
      have hCz : Cm (v w) = r γ ((j.left ≫ t') w) := by
        rw [← Scheme.Hom.comp_apply, hCv, Scheme.Hom.comp_apply]
      calc ev W ((Qpre.map j.op).hom x') (v w)
          = f₀ (Jm (v w)) := hnat j x' (v w)
        _ = σa (Cm (v w)) := by
            rw [hJz, hCz, hσa]
            exact congrFun (hda w) γ
        _ = ev W ((Qpre.map c.op).hom σ) (v w) :=
            ((hnat c σ (v w)).trans (DFunLike.congr_fun hσ (Cm (v w)))).symm
    refine GrothendieckTopology.superset_covering _ ?_ hcovT
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨k⟩
    apply Sieve.le_generate
    refine key (Wk k) (jk k) (e.symm k) (fun w => ?_)
    have hmem : (O k).ι w ∈ ((O k : T'.left.Opens) : Set T'.left) := by
      rw [← Scheme.Opens.range_ι]; exact ⟨w, rfl⟩
    exact hmem

  have htors : ∀ (T : (wcP1Over K).left.ProEt), pZ T →
      ∃ R : Sieve T, R ∈ Scheme.ProEt.topology (wcP1Over K).left T ∧
        ∀ (T' : (wcP1Over K).left.ProEt) (f : T' ⟶ T), R.arrows f →
          ∃ t' : T'.left ⟶ V, T'.hom = t' ≫ q' ≫ Uo.ι := by
    intro T hT
    have crit : ∀ (S₀ : Scheme.{u}) (U : S₀.ProEt) (R : Sieve U),
        (∀ (W : S₀.ProEt) (v : W ⟶ U), IsAffine W.left →
          ∃ (m : ℕ) (W' : Fin m → S₀.ProEt) (e : ∀ j, W' j ⟶ W),
            (∀ j, IsAffine (W' j).left) ∧ (∀ y : W.left, ∃ j, y ∈ Set.range (e j).left) ∧
            ∀ j, R.arrows (e j ≫ v)) →
        R ∈ Scheme.ProEt.topology S₀ U := by
      intro S₀ U R hR
      have fin_covers : ∀ (U : S₀.ProEt) [QuasiSeparatedSpace U.left] (n : ℕ)
          (W : Fin n → S₀.ProEt)
          (h : ∀ i, W i ⟶ U), (∀ i, IsAffine (W i).left) →
          (∀ x : U.left, ∃ i, x ∈ Set.range (h i).left) →
          Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology S₀ U := by
        intro U _ n W h hA hJ
        have hs : ∀ x : U.left, ∃ j y, (h j).left y = x := by
          intro x
          obtain ⟨j, y, hy⟩ := hJ x
          exact ⟨j, y, hy⟩
        have hq : ∀ i, QuasiCompact (h i).left := fun i => by
          haveI := hA i
          exact quasiCompact_of_compactSpace _
        have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
          have h1 : WeaklyEtale ((h i).left ≫ U.hom) := by
            rw [MorphismProperty.Over.w (h i)]
            exact (W i).prop
          haveI := U.prop
          exact @WeaklyEtale.of_comp _ _ _ (h i).left U.hom h1 U.prop
        have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
            Scheme.proetalePrecoverage.coverings U.left :=
          ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_finite _ _
            (Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
              hs (fun _ => trivial)) _ hq
              (inferInstanceAs (Finite (Fin n)))),
            (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
              ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
        exact Precoverage.generate_mem_toGrothendieck
          (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))
      have affine_local : ∀ (U : S₀.ProEt) (T : Sieve U),
          (∀ (V : S₀.ProEt) (f : V ⟶ U), IsAffine V.left →
            T.pullback f ∈ Scheme.ProEt.topology S₀ V) →
          T ∈ Scheme.ProEt.topology S₀ U := by
        intro U T hT
        have hU : WeaklyEtale U.hom := U.prop
        let W : U.left.affineCover.I₀ → S₀.ProEt := fun i =>
          MorphismProperty.Over.mk ⊤ (U.left.affineCover.f i ≫ U.hom) inferInstance
        let e : ∀ i, W i ⟶ U := fun i =>
          MorphismProperty.Over.homMk (U.left.affineCover.f i) rfl trivial
        have hP : Presieve.ofArrows W e ∈ (Scheme.ProEt.precoverage S₀).coverings U := by
          show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S₀ ⋙ Over.forget S₀)
            Scheme.proetalePrecoverage).coverings U
          rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
          change U.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings U.left
          exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left U.left.affineCover.mem₀,
            U.left.affineCover.mem₀.1,
            MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
        refine GrothendieckTopology.transitive _ (Precoverage.generate_mem_toGrothendieck hP) T ?_
        intro Y f hf
        obtain ⟨Y', h, g', hg', rfl⟩ := hf
        rcases hg' with ⟨i⟩
        rw [Sieve.pullback_comp]
        exact GrothendieckTopology.pullback_stable _ h
          (hT (W i) (e i) (show IsAffine (U.left.affineCover.X i) by infer_instance))
      apply affine_local U R
      intro W v hW
      obtain ⟨m, W', e, haff, hsurj, hR'⟩ := hR W v hW
      haveI : IsAffine W.left := hW
      refine GrothendieckTopology.superset_covering _ ?_ (fin_covers W m W' e haff hsurj)
      rw [Sieve.generate_le_iff]
      rintro _ _ ⟨j⟩
      exact hR' j
    have hmem : ∀ t, T.hom t ∈ Uo := fun t =>
      (hUo _).mpr (fun i h => hT t ⟨i, h.symm⟩)
    have hrange : Set.range T.hom ⊆ Set.range Uo.ι := by
      rintro _ ⟨t, rfl⟩
      rw [Scheme.Opens.range_ι]
      exact hmem t
    let u : T.left ⟶ Uo.toScheme := IsOpenImmersion.lift Uo.ι T.hom hrange
    have hu : u ≫ Uo.ι = T.hom := IsOpenImmersion.lift_fac _ _ _
    haveI : IsFinite q' := hG.2.1
    haveI : Surjective q' := hG.2.2.2.1
    let R : Sieve T :=
      { arrows := fun T' _ => ∃ t' : T'.left ⟶ V, T'.hom = t' ≫ q' ≫ Uo.ι
        downward_closed := by
          rintro T' T'' f ⟨t, ht⟩ g
          refine ⟨g.left ≫ t, ?_⟩
          rw [← MorphismProperty.Over.w g, ht, Category.assoc] }
    refine ⟨R, ?_, fun T' f hf => hf⟩
    apply crit _ T R
    intro W v hW
    haveI : IsAffine W.left := hW
    haveI hWe : WeaklyEtale W.hom := W.prop
    let g : W.left ⟶ Uo.toScheme := v.left ≫ u
    let p₁ : Limits.pullback g q' ⟶ W.left := Limits.pullback.fst g q'
    let p₂ : Limits.pullback g q' ⟶ V := Limits.pullback.snd g q'
    haveI : IsFinite p₁ := by dsimp [p₁]; infer_instance
    haveI : Etale p₁ := by dsimp [p₁]; infer_instance
    haveI : Surjective p₁ := by dsimp [p₁]; infer_instance
    have hPaff : IsAffine (Limits.pullback g q') := isAffine_of_isAffineHom p₁
    have hwe : WeaklyEtale (p₁ ≫ W.hom) := inferInstance
    let W₀ : (wcP1Over K).left.ProEt := MorphismProperty.Over.mk ⊤ (p₁ ≫ W.hom) hwe
    let e₀ : W₀ ⟶ W := MorphismProperty.Over.homMk p₁ rfl trivial
    refine ⟨1, fun _ => W₀, fun _ => e₀, fun _ => hPaff, fun y => ⟨0, Surjective.surj (f := p₁) y⟩,
      fun _ => ⟨p₂, ?_⟩⟩
    have hc : p₁ ≫ g = p₂ ≫ q' := Limits.pullback.condition
    show p₁ ≫ W.hom = p₂ ≫ q' ≫ Uo.ι
    rw [← MorphismProperty.Over.w v, ← hu, ← Category.assoc p₂, ← hc]
    simp only [g, Category.assoc]

  intro T x
  by_cases hT : pZ T
  · obtain ⟨R, hR, hRt⟩ := htors T hT
    refine GrothendieckTopology.transitive _ hR _ ?_
    intro T' f hf
    obtain ⟨t', ht'⟩ := hRt T' f hf
    refine GrothendieckTopology.superset_covering _ ?_ (core T' t' ht' ((Qpre.map f.op).hom x))
    rw [Sieve.generate_le_iff]
    rintro W g ⟨V₁, c, σ, e⟩
    rw [Sieve.pullback_apply]
    apply Sieve.le_generate
    refine ⟨V₁, c, σ, ?_⟩
    have hcomp : (Qpre.map (g ≫ f).op).hom x = (Qpre.map g.op).hom ((Qpre.map f.op).hom x) := by
      rw [op_comp, Functor.map_comp]; rfl
    exact hcomp.trans e
  · have hx0 := hev_zero T hT x
    refine GrothendieckTopology.superset_covering _ ?_ (GrothendieckTopology.top_mem _ T)
    intro W g _
    apply Sieve.le_generate
    refine ⟨wcTorsorEt (𝟙 (wcP1Over K).left) inferInstance,
      MorphismProperty.Over.homMk W.hom (Category.comp_id _) trivial, 0, ?_⟩
    rw [hx0, map_zero, map_zero]

theorem wc_cover_modpre_etale_kill {X U V : Scheme.{u}} (ι : U ⟶ X) [IsOpenImmersion ι]
    (q' : V ⟶ U) [IsFinite q'] (Z : Set X) (hZ : ∀ x : X, x ∉ Z → x ∈ Set.range ι) (n : ℕ)
    (V₁ : X.Etale) (y : (wcCcModPre (q' ≫ ι) Z n).obj (Opposite.op ((wcEtToProEt X).obj V₁)))
    (T : X.ProEt) (h : T ⟶ (wcEtToProEt X).obj V₁) :
    ((wcCcModPre (q' ≫ ι) Z n).map h.op).hom y = 0 →
      ∃ (V₂ : X.Etale) (b : V₂ ⟶ V₁) (h' : T ⟶ (wcEtToProEt X).obj V₂),
        h' ≫ (wcEtToProEt X).map b = h ∧
          ((wcCcModPre (q' ≫ ι) Z n).map ((wcEtToProEt X).map b).op).hom y = 0 :=
by
  classical
  intro hy

  have hres : ∀ {T₁ T₂ : X.ProEt} (g : T₂ ⟶ T₁)
      (x : (wcCcModPre (q' ≫ ι) Z n).obj (Opposite.op T₁)),
      ((wcCcModPre (q' ≫ ι) Z n).map g.op).hom x = 0 ↔
      ∀ z : ↥((wcPbFun (q' ≫ ι)).obj T₂),
        ((ULift.down x.1 : C(↥((wcPbFun (q' ≫ ι)).obj T₁), ZMod n)))
          ((wcPbFun (q' ≫ ι)).map g z) = 0 := by
    intro T₁ T₂ g x
    constructor
    · intro hx z
      have := congrArg (fun w : (wcCcModPre (q' ≫ ι) Z n).obj (Opposite.op T₂) =>
        ((ULift.down w.1 : C(↥((wcPbFun (q' ≫ ι)).obj T₂), ZMod n)) z)) hx
      exact this
    · intro H
      apply Subtype.ext
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      exact H z

  have hfs : ∀ {T₁ T₂ : X.ProEt} (g : T₂ ⟶ T₁),
      (wcPbFun (q' ≫ ι)).map g ≫ Limits.pullback.fst T₁.hom (q' ≫ ι) =
        Limits.pullback.fst T₂.hom (q' ≫ ι) ≫ g.left ∧
      (wcPbFun (q' ≫ ι)).map g ≫ Limits.pullback.snd T₁.hom (q' ≫ ι) =
        Limits.pullback.snd T₂.hom (q' ≫ ι) := by
    intro T₁ T₂ g
    exact ⟨Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩

  by_cases hp : ∀ t, ((wcEtToProEt X).obj V₁).hom t ∉ Z
  swap
  · have hb : wcExtZeroSub ((wcPbFun (q' ≫ ι)).op ⋙ continuousMapPresheafAb.{0, u} (ZMod n) ⋙
        AddCommGrpCat.uliftFunctor.{u+1, u}) (fun T : X.ProEt => ∀ t, T.hom t ∉ Z)
        (Opposite.op ((wcEtToProEt X).obj V₁)) = ⊥ := iSup_neg hp
    have hkey : ∀ z : ((wcPbFun (q' ≫ ι)).op ⋙ continuousMapPresheafAb.{0, u} (ZMod n) ⋙
        AddCommGrpCat.uliftFunctor.{u+1, u}).obj (Opposite.op ((wcEtToProEt X).obj V₁)),
        z ∈ wcExtZeroSub ((wcPbFun (q' ≫ ι)).op ⋙ continuousMapPresheafAb.{0, u} (ZMod n) ⋙
          AddCommGrpCat.uliftFunctor.{u+1, u}) (fun T : X.ProEt => ∀ t, T.hom t ∉ Z)
          (Opposite.op ((wcEtToProEt X).obj V₁)) → z = 0 := by
      intro z hz
      rw [hb, AddSubgroup.mem_bot] at hz
      exact hz
    have hy0 : y = 0 := Subtype.ext (hkey _ y.2)
    refine ⟨V₁, 𝟙 V₁, h, ?_, ?_⟩
    · rw [CategoryTheory.Functor.map_id, Category.comp_id]
    · rw [hy0, map_zero]

  let y₀ : C(↥((wcPbFun (q' ≫ ι)).obj ((wcEtToProEt X).obj V₁)), ZMod n) :=
    ULift.down (y.1 : ULift.{u+1} C(↥((wcPbFun (q' ≫ ι)).obj ((wcEtToProEt X).obj V₁)), ZMod n))
  have hyT := (hres h y).mp hy

  have hr : Set.range ((wcEtToProEt X).obj V₁).hom ⊆ Set.range ι := by
    rintro _ ⟨t, rfl⟩
    exact hZ _ (hp t)
  obtain ⟨u, hu⟩ : ∃ u : ((wcEtToProEt X).obj V₁).left ⟶ U,
      u ≫ ι = ((wcEtToProEt X).obj V₁).hom :=
    ⟨IsOpenImmersion.lift ι _ hr, IsOpenImmersion.lift_fac _ _ _⟩
  have hcomm : Limits.pullback.fst ((wcEtToProEt X).obj V₁).hom (q' ≫ ι) ≫ u =
      Limits.pullback.snd ((wcEtToProEt X).obj V₁).hom (q' ≫ ι) ≫ q' := by
    rw [← cancel_mono ι, Category.assoc, hu, Limits.pullback.condition, Category.assoc]
  have hpb : IsPullback (Limits.pullback.fst ((wcEtToProEt X).obj V₁).hom (q' ≫ ι))
      (Limits.pullback.snd ((wcEtToProEt X).obj V₁).hom (q' ≫ ι)) u q' :=
    IsPullback.of_isLimit (Limits.PullbackCone.IsLimit.mk hcomm
      (fun s => Limits.pullback.lift s.fst s.snd (by
        rw [← hu, ← Category.assoc s.fst, s.condition, Category.assoc]))
      (fun s => Limits.pullback.lift_fst _ _ _) (fun s => Limits.pullback.lift_snd _ _ _)
      (fun s m h1 h2 => Limits.pullback.hom_ext
        (by rw [Limits.pullback.lift_fst]; exact h1) (by rw [Limits.pullback.lift_snd]; exact h2)))
  haveI : UniversallyClosed (Limits.pullback.fst ((wcEtToProEt X).obj V₁).hom (q' ≫ ι)) :=
    MorphismProperty.of_isPullback (P := @UniversallyClosed) hpb.flip inferInstance
  have hcl : IsClosedMap (Limits.pullback.fst ((wcEtToProEt X).obj V₁).hom (q' ≫ ι)) :=
    Scheme.Hom.isClosedMap _

  let Bad : Set ↥(Limits.pullback ((wcEtToProEt X).obj V₁).hom (q' ≫ ι)) := (y₀ ⁻¹' {0})ᶜ
  have hBad : IsClosed Bad :=
    ((isOpen_discrete {(0 : ZMod n)}).preimage y₀.continuous).isClosed_compl
  have hC : IsClosed ((Limits.pullback.fst ((wcEtToProEt X).obj V₁).hom (q' ≫ ι)) '' Bad) :=
    hcl Bad hBad
  obtain ⟨O, hOd⟩ : ∃ O : V₁.left.Opens, (O : Set V₁.left) =
      ((Limits.pullback.fst ((wcEtToProEt X).obj V₁).hom (q' ≫ ι)) '' Bad)ᶜ :=
    ⟨⟨_, hC.isOpen_compl⟩, rfl⟩
  have hOmem : ∀ x : V₁.left, x ∈ O ↔
      x ∉ (Limits.pullback.fst ((wcEtToProEt X).obj V₁).hom (q' ≫ ι)) '' Bad := by
    intro x
    rw [← SetLike.mem_coe, hOd]
    rfl

  have hO : ∀ t : T.left, h.left t ∈ O := by
    intro t
    refine (hOmem (h.left t)).mpr ?_
    rintro ⟨z, hzB, hzt⟩
    obtain ⟨w, hw1, hw2⟩ := Scheme.Pullback.exists_preimage_pullback (f := h.left)
      (g := Limits.pullback.fst ((wcEtToProEt X).obj V₁).hom (q' ≫ ι)) t z hzt.symm
    have e : Limits.pullback.fst h.left
          (Limits.pullback.fst ((wcEtToProEt X).obj V₁).hom (q' ≫ ι)) ≫ T.hom =
        (Limits.pullback.snd h.left
          (Limits.pullback.fst ((wcEtToProEt X).obj V₁).hom (q' ≫ ι)) ≫
          Limits.pullback.snd ((wcEtToProEt X).obj V₁).hom (q' ≫ ι)) ≫ (q' ≫ ι) := by
      simp only [Category.assoc]
