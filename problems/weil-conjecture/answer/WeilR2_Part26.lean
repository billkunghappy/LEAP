        exact k2
      have h4 : V₀.hom p ⤳ S i0 (IsLocalRing.closedPoint K) := by
        rw [← hv]; exact hspec V₀ A₀ e₀ p
      have h5 : S i0 (IsLocalRing.closedPoint K) ∈
          closure {S i (IsLocalRing.closedPoint K)} := by
        rw [← h, h1]; exact specializes_iff_mem_closure.mp h4
      rw [(hclosed (S i) (hS i)).closure_eq] at h5
      have h6 : V₀.hom p = S i0 (IsLocalRing.closedPoint K) := by
        rw [← h1, h, ← Set.mem_singleton_iff.mp h5]
      have h7 : V₀.hom p ∈ ((closure {S i0 (IsLocalRing.closedPoint K)})ᶜ :
          Set (wcP1Over K).left) := h2
