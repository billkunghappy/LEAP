theorem wc_epsInv_of_presheaf_local_etale (X : Scheme.{u})
    (P : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) :
    (∀ (T : X.ProEt) (x : P.obj (Opposite.op T)),
      Sieve.generate (fun (W : X.ProEt) (g : W ⟶ T) =>
        ∃ (V₁ : X.Etale) (c : W ⟶ (wcEtToProEt X).obj V₁)
          (σ : P.obj (Opposite.op ((wcEtToProEt X).obj V₁))),
          (P.map g.op).hom x = (P.map c.op).hom σ) ∈ Scheme.ProEt.topology X T) →
    (∀ (V₁ : X.Etale) (y : P.obj (Opposite.op ((wcEtToProEt X).obj V₁))) (T : X.ProEt)
      (h : T ⟶ (wcEtToProEt X).obj V₁), (P.map h.op).hom y = 0 →
      Sieve.generate (fun (W : X.ProEt) (g : W ⟶ T) =>
        ∃ (V₂ : X.Etale) (b : V₂ ⟶ V₁) (h' : W ⟶ (wcEtToProEt X).obj V₂),
          h' ≫ (wcEtToProEt X).map b = g ≫ h ∧
            (P.map ((wcEtToProEt X).map b).op).hom y = 0) ∈ Scheme.ProEt.topology X T) →
    ∃ E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1},
      Nonempty ((wcEpsInv X).obj E ≅
        (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).obj P) :=
by
  intro H1 H2
  haveI : (wcEtToProEt X).IsContinuous (Scheme.smallEtaleTopology X) (Scheme.ProEt.topology X) :=
    (wc_etToProEt_flat_cont X).2
  let H := (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).obj P
  let G := (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
    ((wcEtToProEt X).op ⋙ P)
  let η : (wcEtToProEt X).op ⋙ P ⟶ (((wcEtToProEt X).sheafPushforwardContinuous
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology X) (Scheme.ProEt.topology X)).obj H).obj :=
    Functor.whiskerLeft (wcEtToProEt X).op (toSheafify (Scheme.ProEt.topology X) P)
  let θ : G ⟶ ((wcEtToProEt X).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology X) (Scheme.ProEt.topology X)).obj H :=
    ObjectProperty.homMk (sheafifyLift (Scheme.smallEtaleTopology X) η
      (((wcEtToProEt X).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology X) (Scheme.ProEt.topology X)).obj H).property)

  have hθ : ∀ (V₁ : X.Etale) (σ : P.obj (Opposite.op ((wcEtToProEt X).obj V₁))),
      (θ.hom.app (Opposite.op V₁)).hom
        (((toSheafify (Scheme.smallEtaleTopology X) ((wcEtToProEt X).op ⋙ P)).app
          (Opposite.op V₁)).hom σ) =
      ((toSheafify (Scheme.ProEt.topology X) P).app
        (Opposite.op ((wcEtToProEt X).obj V₁))).hom σ := by
    intro V₁ σ
    have h := congrArg (fun φ => (φ.app (Opposite.op V₁)).hom σ)
      (toSheafify_sheafifyLift (Scheme.smallEtaleTopology X) η
        (((wcEtToProEt X).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology X) (Scheme.ProEt.topology X)).obj H).property)
    exact h
  have hHc : ∀ {A B E : X.ProEt} (f₁ : B ⟶ A) (f₂ : E ⟶ B) (z : H.obj.obj (Opposite.op A)),
      (H.obj.map f₂.op).hom ((H.obj.map f₁.op).hom z) = (H.obj.map (f₂ ≫ f₁).op).hom z := by
    intro A B E f₁ f₂ z
    rw [op_comp, Functor.map_comp]
    rfl

  have hsurj : ∀ (T : X.ProEt) (s : H.obj.obj (Opposite.op T)),
      Sieve.generate (fun (W : X.ProEt) (g : W ⟶ T) => ∃ (V₁ : X.Etale)
        (c : W ⟶ (wcEtToProEt X).obj V₁) (t : G.obj.obj (Opposite.op V₁)),
        (H.obj.map g.op).hom s = (H.obj.map c.op).hom ((θ.hom.app (Opposite.op V₁)).hom t))
        ∈ Scheme.ProEt.topology X T := by
    intro T s
    haveI := Presheaf.isLocallySurjective_toSheafify' (Scheme.ProEt.topology X) P
    have hR := Presheaf.imageSieve_mem (Scheme.ProEt.topology X)
      (toSheafify (Scheme.ProEt.topology X) P) (U := Opposite.op T) s
    refine (Scheme.ProEt.topology X).transitive hR _ ?_
    intro W g hg
    obtain ⟨x, hx⟩ := Eq.mp (Presheaf.imageSieve_apply _ s W g) hg
    have hx' : (H.obj.map g.op).hom s =
        ((toSheafify (Scheme.ProEt.topology X) P).app (Opposite.op W)).hom x := hx.symm
    refine (Scheme.ProEt.topology X).superset_covering ?_ (H1 W x)
    rw [Sieve.generate_le_iff]
    rintro W' g' ⟨V₁, c, σ, hσ⟩
    rw [Sieve.pullback_apply]
    apply Sieve.le_generate
    refine ⟨V₁, c, ((toSheafify (Scheme.smallEtaleTopology X) ((wcEtToProEt X).op ⋙ P)).app
      (Opposite.op V₁)).hom σ, ?_⟩
    calc (H.obj.map (g' ≫ g).op).hom s
        = (H.obj.map g'.op).hom ((H.obj.map g.op).hom s) := (hHc g g' s).symm
      _ = (H.obj.map g'.op).hom
            (((toSheafify (Scheme.ProEt.topology X) P).app (Opposite.op W)).hom x) := by
          rw [hx']
      _ = ((toSheafify (Scheme.ProEt.topology X) P).app (Opposite.op W')).hom
            ((P.map g'.op).hom x) :=
          (NatTrans.naturality_apply (toSheafify (Scheme.ProEt.topology X) P) g'.op x).symm
      _ = ((toSheafify (Scheme.ProEt.topology X) P).app (Opposite.op W')).hom
            ((P.map c.op).hom σ) := by rw [hσ]
      _ = (H.obj.map c.op).hom (((toSheafify (Scheme.ProEt.topology X) P).app
            (Opposite.op ((wcEtToProEt X).obj V₁))).hom σ) :=
          NatTrans.naturality_apply (toSheafify (Scheme.ProEt.topology X) P) c.op σ
      _ = _ := congrArg (H.obj.map c.op).hom (hθ V₁ σ).symm

  have hinj : ∀ (V₁ : X.Etale) (t : G.obj.obj (Opposite.op V₁)) (T : X.ProEt)
      (a : T ⟶ (wcEtToProEt X).obj V₁),
      (H.obj.map a.op).hom ((θ.hom.app (Opposite.op V₁)).hom t) = 0 →
      Sieve.generate (fun (W : X.ProEt) (g : W ⟶ T) => ∃ (V₂ : X.Etale) (b : V₂ ⟶ V₁)
        (a' : W ⟶ (wcEtToProEt X).obj V₂),
        a' ≫ (wcEtToProEt X).map b = g ≫ a ∧ (G.obj.map b.op).hom t = 0)
        ∈ Scheme.ProEt.topology X T := by
    intro V₁ t T a ha
    haveI := Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology X)
      ((wcEtToProEt X).op ⋙ P)
    haveI := Presheaf.isLocallyInjective_toSheafify' (Scheme.ProEt.topology X) P
    have hR := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology X)
      (toSheafify (Scheme.smallEtaleTopology X) ((wcEtToProEt X).op ⋙ P))
      (U := Opposite.op V₁) t
    have hP := (Scheme.ProEt.topology X).pullback_stable a
      ((CoverPreserving.of_isContinuous (wcEtToProEt X) (Scheme.smallEtaleTopology X)
        (Scheme.ProEt.topology X)).cover_preserve hR)
    refine (Scheme.ProEt.topology X).transitive hP _ ?_
    intro W g hg
    rw [Sieve.pullback_apply, Sieve.functorPushforward_apply,
      Presieve.functorPushforward.eq_1] at hg
    obtain ⟨V₁', r, k, hr, hga⟩ := hg
    obtain ⟨y, hy⟩ := Eq.mp (Presheaf.imageSieve_apply _ t V₁' r) hr
    have hy' : ((toSheafify (Scheme.smallEtaleTopology X) ((wcEtToProEt X).op ⋙ P)).app
        (Opposite.op V₁')).hom y = (G.obj.map r.op).hom t := hy
    have hθnat : (θ.hom.app (Opposite.op V₁')).hom ((G.obj.map r.op).hom t) =
        (H.obj.map ((wcEtToProEt X).map r).op).hom ((θ.hom.app (Opposite.op V₁)).hom t) :=
      NatTrans.naturality_apply θ.hom r.op t
    have hkill : ((toSheafify (Scheme.ProEt.topology X) P).app (Opposite.op W)).hom
          ((P.map k.op).hom y) =
        ((toSheafify (Scheme.ProEt.topology X) P).app (Opposite.op W)).hom 0 := by
      rw [map_zero]
      calc ((toSheafify (Scheme.ProEt.topology X) P).app (Opposite.op W)).hom
            ((P.map k.op).hom y)
          = (H.obj.map k.op).hom (((toSheafify (Scheme.ProEt.topology X) P).app
              (Opposite.op ((wcEtToProEt X).obj V₁'))).hom y) :=
            NatTrans.naturality_apply (toSheafify (Scheme.ProEt.topology X) P) k.op y
        _ = (H.obj.map k.op).hom ((θ.hom.app (Opposite.op V₁')).hom
              (((toSheafify (Scheme.smallEtaleTopology X) ((wcEtToProEt X).op ⋙ P)).app
                (Opposite.op V₁')).hom y)) :=
            congrArg (H.obj.map k.op).hom (hθ V₁' y).symm
        _ = (H.obj.map k.op).hom ((θ.hom.app (Opposite.op V₁')).hom
              ((G.obj.map r.op).hom t)) := by
            rw [hy']
        _ = (H.obj.map k.op).hom ((H.obj.map ((wcEtToProEt X).map r).op).hom
              ((θ.hom.app (Opposite.op V₁)).hom t)) := by rw [hθnat]
        _ = (H.obj.map g.op).hom ((H.obj.map a.op).hom
              ((θ.hom.app (Opposite.op V₁)).hom t)) := by
            have e1 := hHc ((wcEtToProEt X).map r) k ((θ.hom.app (Opposite.op V₁)).hom t)
            have e2 := hHc a g ((θ.hom.app (Opposite.op V₁)).hom t)
            rw [hga] at e2
            exact e1.trans e2.symm
        _ = 0 := by rw [ha, map_zero]
    have hE := Presheaf.equalizerSieve_mem (Scheme.ProEt.topology X)
      (toSheafify (Scheme.ProEt.topology X) P) ((P.map k.op).hom y) 0 hkill
    refine (Scheme.ProEt.topology X).transitive hE _ ?_
    intro W' k' hk'
    have hk'' : (P.map (k' ≫ k).op).hom y = 0 := by
      have h0 : (P.map k'.op).hom ((P.map k.op).hom y) = (P.map k'.op).hom 0 := hk'
      rw [map_zero] at h0
      rw [op_comp, Functor.map_comp]
      exact h0
    refine (Scheme.ProEt.topology X).superset_covering ?_ (H2 V₁' y W' (k' ≫ k) hk'')
    rw [Sieve.generate_le_iff]
    rintro W'' g'' ⟨V₂, b, h', hfac, hb0⟩
    rw [Sieve.pullback_apply, Sieve.pullback_apply]
    apply Sieve.le_generate
    refine ⟨V₂, b ≫ r, h', ?_, ?_⟩
    · simp only [Functor.map_comp, Category.assoc]
      rw [hga, ← Category.assoc h', hfac]
      simp only [Category.assoc]
    · calc (G.obj.map (b ≫ r).op).hom t
          = (G.obj.map b.op).hom ((G.obj.map r.op).hom t) := by
            rw [op_comp, Functor.map_comp]; rfl
        _ = (G.obj.map b.op).hom (((toSheafify (Scheme.smallEtaleTopology X)
              ((wcEtToProEt X).op ⋙ P)).app (Opposite.op V₁')).hom y) := by
            rw [hy']
        _ = ((toSheafify (Scheme.smallEtaleTopology X) ((wcEtToProEt X).op ⋙ P)).app
              (Opposite.op V₂)).hom ((P.map ((wcEtToProEt X).map b).op).hom y) :=
            (NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X)
              ((wcEtToProEt X).op ⋙ P)) b.op y).symm
        _ = 0 := by rw [hb0, map_zero]
  obtain ⟨e⟩ := wc_epsInv_iso_of_lan_criterion X G H θ hsurj hinj
  exact ⟨G, ⟨e⟩⟩

theorem wc_cover_sheaf_mod_ell_classical (K : Type u) [Field K] [Finite K]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α) (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι) :
    ∃ E : Sheaf (Scheme.smallEtaleTopology (wcP1Over K).left) AddCommGrpCat.{u+1},
      Nonempty (Limits.cokernel (ℓ • 𝟙 (wcCoverSheaf (q' ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ)) ≅
          (wcEpsInv (wcP1Over K).left).obj E) :=
by
  classical
  obtain ⟨e₁⟩ := wc_cover_coker_ell_modpre (q' ≫ Uo.ι)
    (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ
  have H1 := wc_cover_modpre_local_etale K ℓ m S hS Uo hUo q' Γ α hG hα
    (fun W h t ht => wc_galcover_section_partition Uo.ι q' Γ α hG hα W h t ht)
  haveI : IsFinite q' := hG.2.1
  have hZ : ∀ x : (wcP1Over K).left,
      x ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K)) → x ∈ Set.range Uo.ι := by
    intro x hx
    rw [Scheme.Opens.range_ι]
    exact (hUo x).2 (fun i hi => hx ⟨i, hi.symm⟩)
  obtain ⟨E, ⟨e₂⟩⟩ := wc_epsInv_of_presheaf_local_etale (wcP1Over K).left
    (wcCcModPre (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ) H1
    (by
      intro V₁ y T h hy
      obtain ⟨V₂, b, h', hb, hy'⟩ := wc_cover_modpre_etale_kill Uo.ι q' _ hZ ℓ V₁ y T h hy
      refine GrothendieckTopology.superset_covering _ ?_
        (GrothendieckTopology.top_mem _ T)
      intro W g _
      apply Sieve.le_generate
      exact ⟨V₂, b, g ≫ h', by rw [Category.assoc, hb], hy'⟩)
  exact ⟨E, ⟨e₁ ≪≫ e₂.symm⟩⟩

theorem wc_cgev_local_coind_complex (K : Type u) [Field K] [Finite K]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α) (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
    (lamF : MonoidAlgebra ℤ_[ℓ] Γ → (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ⟶ wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
    (hlamF : wcRingAct lamF)
    (hlamFs : ∀ (g : Γ) (a : ℤ_[ℓ]), lamF (MonoidAlgebra.single g a) =
      wcCoverScal (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ a ≫
        wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ
          (α g⁻¹).hom (hα g⁻¹))
    (N : ModuleCat.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ)) (hN : wcChmpTorsFG ℓ N) (Rs : wcCgevRes N) :
    Mono ((wcCgevK lamF hlamF Rs).d 0 1) ∧
      (∀ p, 2 ≤ p → (wcCgevK lamF hlamF Rs).ExactAt p) ∧
      ∃ H : Sheaf (Scheme.smallEtaleTopology (wcP1Over K).left) AddCommGrpCat.{u+1},
        ℓ • 𝟙 H = 0 ∧ Nonempty ((wcCgevK lamF hlamF Rs).homology 1 ≅ (wcEpsInv _).obj H) :=
by
  classical
  haveI : Finite Γ := hG.1

  have hHex : ∃ H : ∀ p, Matrix (Fin (Rs.a p)) (Fin (Rs.a (p + 1))) (MonoidAlgebra ℤ_[ℓ] Γ),
      H 0 * Rs.c 0 = ℓ • (1 : Matrix (Fin (Rs.a 0)) (Fin (Rs.a 0)) (MonoidAlgebra ℤ_[ℓ] Γ)) ∧
      ∀ p, H (p + 1) * Rs.c (p + 1) + Rs.c p * H p =
        ℓ • (1 : Matrix (Fin (Rs.a (p + 1))) (Fin (Rs.a (p + 1))) (MonoidAlgebra ℤ_[ℓ] Γ)) := by
    have h0 : ∀ k : Fin (Rs.a 0), ∃ w : Fin (Rs.a (0 + 1)) → MonoidAlgebra ℤ_[ℓ] Γ,
        Matrix.vecMul w (Rs.c 0) =
          (ℓ • (1 : Matrix (Fin (Rs.a 0)) (Fin (Rs.a 0)) (MonoidAlgebra ℤ_[ℓ] Γ))) k := by
      intro k
      refine (Rs.ex0 _).mp ?_
      have e : (ℓ • (1 : Matrix (Fin (Rs.a 0)) (Fin (Rs.a 0)) (MonoidAlgebra ℤ_[ℓ] Γ))) k =
          ℓ • ((1 : Matrix (Fin (Rs.a 0)) (Fin (Rs.a 0)) (MonoidAlgebra ℤ_[ℓ] Γ)) k) := rfl
      rw [e, map_nsmul]
      exact hN.2 _
    choose w0 hw0 using h0
    have hH0 : Matrix.of w0 * Rs.c 0 =
        ℓ • (1 : Matrix (Fin (Rs.a 0)) (Fin (Rs.a 0)) (MonoidAlgebra ℤ_[ℓ] Γ)) := by
      refine Matrix.ext fun k j => ?_
      rw [congrFun (Matrix.mul_apply_eq_vecMul (Matrix.of w0) (Rs.c 0) k) j]
      exact congrFun (hw0 k) j
    have hI0 : Rs.c 0 * Matrix.of w0 * Rs.c 0 = ℓ • Rs.c 0 := by
      rw [Matrix.mul_assoc, hH0, Matrix.mul_smul, Matrix.mul_one]
    have step : ∀ (p : ℕ) (A : Matrix (Fin (Rs.a p)) (Fin (Rs.a (p + 1))) (MonoidAlgebra ℤ_[ℓ] Γ)),
        Rs.c p * A * Rs.c p = ℓ • Rs.c p →
        ∃ B : Matrix (Fin (Rs.a (p + 1))) (Fin (Rs.a (p + 1 + 1))) (MonoidAlgebra ℤ_[ℓ] Γ),
          B * Rs.c (p + 1) = ℓ • (1 : Matrix (Fin (Rs.a (p + 1))) (Fin (Rs.a (p + 1)))
            (MonoidAlgebra ℤ_[ℓ] Γ)) - Rs.c p * A ∧
          Rs.c (p + 1) * B * Rs.c (p + 1) = ℓ • Rs.c (p + 1) := by
      intro p A hA
      have hrow : ∀ k : Fin (Rs.a (p + 1)), ∃ w : Fin (Rs.a (p + 1 + 1)) → MonoidAlgebra ℤ_[ℓ] Γ,
          Matrix.vecMul w (Rs.c (p + 1)) = (ℓ • (1 : Matrix (Fin (Rs.a (p + 1)))
            (Fin (Rs.a (p + 1))) (MonoidAlgebra ℤ_[ℓ] Γ)) - Rs.c p * A) k := by
        intro k
        refine (Rs.ex p _).mp ?_
        rw [← Matrix.mul_apply_eq_vecMul (ℓ • (1 : Matrix (Fin (Rs.a (p + 1)))
            (Fin (Rs.a (p + 1))) (MonoidAlgebra ℤ_[ℓ] Γ)) - Rs.c p * A) (Rs.c p) k,
          Matrix.sub_mul, Matrix.smul_mul, Matrix.one_mul, hA, sub_self]
        rfl
      choose w hw using hrow
      have hB : Matrix.of w * Rs.c (p + 1) = ℓ • (1 : Matrix (Fin (Rs.a (p + 1)))
          (Fin (Rs.a (p + 1))) (MonoidAlgebra ℤ_[ℓ] Γ)) - Rs.c p * A := by
        refine Matrix.ext fun k j => ?_
        rw [congrFun (Matrix.mul_apply_eq_vecMul (Matrix.of w) (Rs.c (p + 1)) k) j]
        exact congrFun (hw k) j
      refine ⟨Matrix.of w, hB, ?_⟩
      rw [Matrix.mul_assoc, hB, Matrix.mul_sub, Matrix.mul_smul, Matrix.mul_one,
