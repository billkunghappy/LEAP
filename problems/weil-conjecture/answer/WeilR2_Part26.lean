import WeilR2_Part25
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_wdr_residue_perm_order : ∀ (R₀ B₀ : Type u) [CommRing R₀] [CommRing B₀] [Algebra R₀ B₀] [Module.Finite R₀ B₀] (φ : B₀ ≃ₐ[R₀] B₀), ∃ M : ℕ, 1 ≤ M ∧ ∀ (Q : Ideal B₀) [Q.IsPrime] (b : B₀), algebraMap B₀ Q.ResidueField ((φ ^ M) b) = algebraMap B₀ Q.ResidueField b :=
by
  intro R₀ B₀ _ _ _ _ φ
  classical
  obtain ⟨g, bg, hbg⟩ := Module.Finite.exists_fin (R := R₀) (M := B₀)
  have s1 : ∀ (κ : Type u) [Field κ] [Algebra R₀ κ],
      Finite (B₀ →ₐ[R₀] κ) ∧ Nat.card (B₀ →ₐ[R₀] κ) ≤ g := by
    intro κ _ _
    let T : (B₀ →ₐ[R₀] κ) → (B₀ →* κ) := fun y => ((y : B₀ →+* κ) : B₀ →* κ)
    have hT : Function.Injective T := by
      intro y y' h
      ext x
      exact DFunLike.congr_fun h x
    have hli : LinearIndependent κ (fun y : B₀ →ₐ[R₀] κ => (⇑y : B₀ → κ)) :=
      (linearIndependent_monoidHom B₀ κ).comp T hT
    let ev : (B₀ →ₐ[R₀] κ) → (Fin g → κ) := fun y i => y (bg i)
    have hev : LinearIndependent κ ev := by
      rw [linearIndependent_iff'] at hli ⊢
      intro s c hs y hy
      apply hli s c _ y hy
      funext x
      have hx : x ∈ Submodule.span R₀ (Set.range bg) := by rw [hbg]; exact Submodule.mem_top
      obtain ⟨r, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun R₀).mp hx
      have hs' : ∀ i, ∑ y ∈ s, c y * y (bg i) = 0 := by
        intro i
        have := congrFun hs i
        simpa [Finset.sum_apply, ev] using this
      rw [Finset.sum_apply]
      simp only [Pi.smul_apply, smul_eq_mul, Pi.zero_apply, map_sum]
      calc ∑ y ∈ s, c y * ∑ i, y (r i • bg i)
          = ∑ i, algebraMap R₀ κ (r i) * ∑ y ∈ s, c y * y (bg i) := by
            simp only [Algebra.smul_def, Finset.mul_sum]
            rw [Finset.sum_comm]
            exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun y _ => by
              rw [map_mul, AlgHom.commutes]; ring
        _ = 0 := by simp [hs']
    have hfin : Finite (B₀ →ₐ[R₀] κ) := hev.finite
    refine ⟨hfin, ?_⟩
    haveI := Fintype.ofFinite (B₀ →ₐ[R₀] κ)
    rw [Nat.card_eq_fintype_card]
    have := hev.fintype_card_le_finrank
    simpa using this
  refine ⟨g.factorial, Nat.factorial_pos g, ?_⟩
  intro Q _ b
  obtain ⟨hfin, hcard⟩ := s1 Q.ResidueField
  haveI := hfin
  let π : Equiv.Perm (B₀ →ₐ[R₀] Q.ResidueField) :=
    { toFun := fun y => y.comp φ.toAlgHom
      invFun := fun y => y.comp φ.symm.toAlgHom
      left_inv := fun y => by ext x; simp
      right_inv := fun y => by ext x; simp }
  have hπn : ∀ (n : ℕ) (y : B₀ →ₐ[R₀] Q.ResidueField) (x : B₀), (π ^ n) y x = y ((φ ^ n) x) := by
    intro n
    induction n with
    | zero => intro y x; simp
    | succ n ih =>
      intro y x
      rw [pow_succ, Equiv.Perm.mul_apply, ih, pow_succ', AlgEquiv.mul_apply]
      rfl
  have hpow : π ^ g.factorial = 1 := by
    rw [← orderOf_dvd_iff_pow_eq_one]
    refine (orderOf_dvd_natCard π).trans ?_
    rw [Nat.card_perm]
    exact Nat.factorial_dvd_factorial hcard
  have h := hπn g.factorial (IsScalarTower.toAlgHom R₀ B₀ Q.ResidueField) b
  rw [hpow, Equiv.Perm.one_apply] at h
  simpa using h.symm

theorem wc_wdr_unramified_rigid : ∀ (R₀ B₀ : Type u) [CommRing R₀] [CommRing B₀] [Algebra R₀ B₀] [Module.Finite R₀ B₀] [Algebra.FormallyUnramified R₀ B₀] (f₁ f₂ : B₀ →ₐ[R₀] B₀), (∀ (Q : Ideal B₀) [Q.IsPrime] (b : B₀), algebraMap B₀ Q.ResidueField (f₁ b) = algebraMap B₀ Q.ResidueField (f₂ b)) → f₁ = f₂ :=
by
  intro R₀ B₀ _ _ _ _ _ f₁ f₂ h
  classical
  obtain ⟨n, b, hb⟩ : ∃ (n : ℕ) (s : Fin n → B₀), Submodule.span R₀ (Set.range s) = ⊤ :=
    Module.Finite.exists_fin
  have hnil : ∀ x : B₀, f₁ x - f₂ x ∈ nilradical B₀ := by
    intro x
    rw [nilradical_eq_sInf, Submodule.mem_sInf]
    intro Q hQ
    haveI : Ideal.IsPrime (Q : Ideal B₀) := hQ
    exact (Ideal.algebraMap_residueField_eq_zero (I := (Q : Ideal B₀))).mp
      (by rw [map_sub, h Q x, sub_self])
  set I : Ideal B₀ := Ideal.span (Set.range (fun i : Fin n => f₁ (b i) - f₂ (b i))) with hI
  have hIfg : I.FG := by
    rw [hI]
    exact Submodule.fg_span (Set.finite_range _)
  have hIle : I ≤ nilradical B₀ := by
    rw [hI, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact hnil (b i)
  have hInil : IsNilpotent I := (Ideal.FG.isNilpotent_iff_le_nilradical hIfg).mpr hIle
  have hmem : ∀ x : B₀, f₁ x - f₂ x ∈ I := by
    intro x
    have hx : x ∈ Submodule.span R₀ (Set.range b) := by rw [hb]; exact Submodule.mem_top
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun R₀).mp hx
    rw [map_sum, map_sum, ← Finset.sum_sub_distrib]
    refine Ideal.sum_mem _ (fun i _ => ?_)
    rw [map_smul, map_smul, ← smul_sub, Algebra.smul_def]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
  exact Algebra.FormallyUnramified.ext I hInil (fun x => Ideal.Quotient.eq.mpr (hmem x))

theorem wc_wdr_tau_periodic : ∀ (K : Type u) [Field K] [Finite K] (A : Type u) [CommRing A] [Algebra K A] (r : TensorProduct K A (AlgebraicClosure K)), ∃ N : ℕ, 1 ≤ N ∧ (⇑(wcWdTau K A))^[N] r = r :=
by
  intro K _ _ A _ _ r
  classical
  set σ := (@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
    (AlgebraicClosure K) _ _ _).symm with hσ

  have s1 : ∀ c : AlgebraicClosure K, ∃ N : ℕ, 1 ≤ N ∧ (⇑σ)^[N] c = c := by
    intro c
    have hint : IsIntegral K c := Algebra.IsIntegral.isIntegral c
    set p := minpoly K c with hp
    have hp0 : p ≠ 0 := minpoly.ne_zero hint
    have horb : ∀ n : ℕ, (⇑σ)^[n] c ∈ p.rootSet (AlgebraicClosure K) := by
      intro n
      rw [Polynomial.mem_rootSet]
      refine ⟨hp0, ?_⟩
      induction n with
      | zero => exact minpoly.aeval K c
      | succ n ih =>
        rw [Function.iterate_succ_apply']
        have := Polynomial.aeval_algHom_apply (σ : AlgebraicClosure K →ₐ[K] AlgebraicClosure K)
          ((⇑σ)^[n] c) p
        rw [AlgEquiv.coe_algHom] at this
        rw [this, ih, map_zero]
    obtain ⟨a, b, hab, heq⟩ := Set.Finite.exists_lt_map_eq_of_forall_mem horb
      (Polynomial.rootSet_finite p (AlgebraicClosure K))
    refine ⟨b - a, by omega, ?_⟩
    have hb : b = a + (b - a) := by omega
    rw [hb, Function.iterate_add_apply] at heq
    exact (Function.Injective.iterate σ.injective a heq).symm

  have s2 : ∀ (n : ℕ) (a : A) (c : AlgebraicClosure K),
      (⇑(wcWdTau K A))^[n] (a ⊗ₜ[K] c) = a ⊗ₜ[K] (⇑σ)^[n] c := by
    intro n
    induction n with
    | zero => intro a c; rfl
    | succ n ih =>
      intro a c
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih]
      simp only [wcWdTau, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, AlgEquiv.coe_algHom, hσ]

  have s3 : ∀ (n : ℕ) (x y : TensorProduct K A (AlgebraicClosure K)),
      (⇑(wcWdTau K A))^[n] (x + y) = (⇑(wcWdTau K A))^[n] x + (⇑(wcWdTau K A))^[n] y := by
    intro n
    induction n with
    | zero => intro x y; rfl
    | succ n ih =>
      intro x y
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply',
        Function.iterate_succ_apply', ih, map_add]

  induction r using TensorProduct.induction_on with
  | zero => exact ⟨1, le_rfl, by simp⟩
  | tmul a c =>
    obtain ⟨N, hN, hc⟩ := s1 c
    exact ⟨N, hN, by rw [s2, hc]⟩
  | add x y hx hy =>
    obtain ⟨Nx, hNx, hx⟩ := hx
    obtain ⟨Ny, hNy, hy⟩ := hy
    refine ⟨Nx * Ny, Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (by omega) (by omega)), ?_⟩
    have ex : (⇑(wcWdTau K A))^[Nx * Ny] x = x := Function.IsPeriodicPt.mul_const hx Ny
    have ey : (⇑(wcWdTau K A))^[Nx * Ny] y = y := Function.IsPeriodicPt.const_mul hy Nx
    rw [s3, ex, ey]

theorem wc_wdr_linearize : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (τ : R →+* R) (B : Type u) [CommRing B] [Algebra R B] [Module.Finite R B] (ψ : B ≃+* B), (∀ (r : R) (b : B), ψ (r • b) = τ r • ψ b) → (∀ r : R, ∃ N : ℕ, 1 ≤ N ∧ (⇑τ)^[N] r = r) → ∃ (N : ℕ) (Φ : B ≃ₐ[R] B) (g : ℕ) (b : Fin g → B), 1 ≤ N ∧ Submodule.span R (Set.range b) = ⊤ ∧ ∀ (k : ℕ) (i : Fin g), (Φ ^ k) (b i) = (⇑ψ)^[N * k] (b i) :=
by
  intro R _ _ τ B _ _ _ ψ hψ hper
  classical

  have hP : ∀ (n : ℕ) (y : B), ((ψ : B →+* B) ^ n) y = (⇑ψ)^[n] y := by
    intro n y
    rw [RingHom.coe_pow]
    rfl
  have hQ : ∀ (n : ℕ) (a : R), (τ ^ n) a = (⇑τ)^[n] a := by
    intro n a
    rw [RingHom.coe_pow]

  have hsl : ∀ (n : ℕ) (a : R) (y : B), (⇑ψ)^[n] (a • y) = (⇑τ)^[n] a • (⇑ψ)^[n] y := by
    intro n
    induction n with
    | zero => intro a y; rfl
    | succ n ih =>
      intro a y
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply',
        Function.iterate_succ_apply', ih, hψ]
  have hsum : ∀ (n g : ℕ) (x : Fin g → R) (c : Fin g → B),
      (⇑ψ)^[n] (∑ i, x i • c i) = ∑ i, (⇑τ)^[n] (x i) • (⇑ψ)^[n] (c i) := by
    intro n g x c
    rw [← hP n (∑ i, x i • c i), map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hP, hsl]

  have hcomm : ∀ {ι : Type} [Fintype ι] (x : ι → R),
      ∃ N : ℕ, 1 ≤ N ∧ ∀ i, (⇑τ)^[N] (x i) = x i := by
    intro ι _ x
    choose p hp1 hp2 using fun i => hper (x i)
    refine ⟨∏ i, p i, ?_, fun i => ?_⟩
    · have hpos : 0 < ∏ i, p i := Finset.prod_pos (fun i _ => by have := hp1 i; omega)
      omega
    · exact (show Function.IsPeriodicPt (⇑τ) (p i) (x i) from hp2 i).trans_dvd
        (Finset.dvd_prod_of_mem p (Finset.mem_univ i))
  have hdvd : ∀ {m n : ℕ} {a : R}, (⇑τ)^[m] a = a → m ∣ n → (⇑τ)^[n] a = a :=
    fun {m n a} h hd => (show Function.IsPeriodicPt (⇑τ) m a from h).trans_dvd hd

  obtain ⟨g, b, hspan⟩ := Module.Finite.exists_fin (R := R) (M := B)
  have hco : ∀ y : B, ∃ x : Fin g → R, ∑ i, x i • b i = y := by
    intro y
    have hy : y ∈ Submodule.span R (Set.range b) := by rw [hspan]; trivial
    exact (Submodule.mem_span_range_iff_exists_fun R).mp hy
  choose r hr using fun i => hco (ψ (b i))
  choose s hs using fun i j => hco (b i * b j)
  obtain ⟨u, hu⟩ := hco 1

  obtain ⟨Λ, hΛ⟩ : ∃ Λ : (Fin g → R) →ₗ[R] B, ∀ x, Λ x = ∑ i, x i • b i :=
    ⟨Fintype.linearCombination R b, fun x => by simp [Fintype.linearCombination_apply]⟩
  obtain ⟨t, v, hv⟩ := (Submodule.fg_iff_exists_fin_generating_family).mp
    (IsNoetherian.noetherian (LinearMap.ker Λ))
  have hv0 : ∀ l, ∑ i, v l i • b i = 0 := by
    intro l
    rw [← hΛ (v l), ← LinearMap.mem_ker, ← hv]
    exact Submodule.subset_span ⟨l, rfl⟩

  obtain ⟨N1, hN1, h1⟩ := hcomm (fun p : Fin g × Fin g => r p.1 p.2)
  obtain ⟨N2, hN2, h2⟩ := hcomm (fun p : Fin g × Fin g × Fin g => s p.1 p.2.1 p.2.2)
  obtain ⟨N3, hN3, h3⟩ := hcomm u
  obtain ⟨N4, hN4, h4⟩ := hcomm (fun p : Fin t × Fin g => v p.1 p.2)
  obtain ⟨N, hNdef⟩ : ∃ N, N = N1 * N2 * N3 * N4 := ⟨_, rfl⟩
  have hN : 1 ≤ N := by
    have := Nat.mul_pos (Nat.mul_pos (Nat.mul_pos hN1 hN2) hN3) hN4
    omega
  have hr' : ∀ i j, (⇑τ)^[N] (r i j) = r i j := fun i j =>
    hdvd (h1 (i, j)) ⟨N2 * N3 * N4, by rw [hNdef]; ring⟩
  have hs' : ∀ i j k, (⇑τ)^[N] (s i j k) = s i j k := fun i j k =>
    hdvd (h2 (i, j, k)) ⟨N1 * N3 * N4, by rw [hNdef]; ring⟩
  have hu' : ∀ k, (⇑τ)^[N] (u k) = u k := fun k =>
    hdvd (h3 k) ⟨N1 * N2 * N4, by rw [hNdef]; ring⟩
  have hv' : ∀ l i, (⇑τ)^[N] (v l i) = v l i := fun l i =>
    hdvd (h4 (l, i)) ⟨N1 * N2 * N3, by rw [hNdef]; ring⟩

  have hstab1 : ∀ x : Fin g → R, (∀ i, (⇑τ)^[N] (x i) = x i) →
      ∃ y : Fin g → R, (∀ i, (⇑τ)^[N] (y i) = y i) ∧ ψ (∑ i, x i • b i) = ∑ i, y i • b i := by
    intro x hx
    refine ⟨fun k => ∑ j, τ (x j) * r j k, ?_, ?_⟩
    · intro k
      rw [← hQ N, map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_mul, hQ, hQ, hr', ← Function.iterate_succ_apply, Function.iterate_succ_apply', hx]
    · simp only [map_sum, hψ, ← hr, Finset.smul_sum, smul_smul, Finset.sum_smul]
      exact Finset.sum_comm
  have hstab : ∀ (n : ℕ) (x : Fin g → R), (∀ i, (⇑τ)^[N] (x i) = x i) →
      ∃ y : Fin g → R, (∀ i, (⇑τ)^[N] (y i) = y i) ∧
        (⇑ψ)^[n] (∑ i, x i • b i) = ∑ i, y i • b i := by
    intro n
    induction n with
    | zero => intro x hx; exact ⟨x, hx, rfl⟩
    | succ n ih =>
      intro x hx
      obtain ⟨y, hy, hxy⟩ := ih x hx
      obtain ⟨z, hz, hyz⟩ := hstab1 y hy
      exact ⟨z, hz, by rw [Function.iterate_succ_apply', hxy, hyz]⟩

  obtain ⟨Φ₀, hΦ₀⟩ : ∃ Φ₀ : (Fin g → R) →ₗ[R] B, ∀ x, Φ₀ x = ∑ i, x i • (⇑ψ)^[N] (b i) :=
    ⟨Fintype.linearCombination R (fun i => (⇑ψ)^[N] (b i)),
      fun x => by simp [Fintype.linearCombination_apply]⟩
  have hker : LinearMap.ker Λ ≤ LinearMap.ker Φ₀ := by
    rw [← hv, Submodule.span_le]
    rintro _ ⟨l, rfl⟩
    rw [SetLike.mem_coe, LinearMap.mem_ker, hΦ₀]
    calc ∑ i, v l i • (⇑ψ)^[N] (b i) = ∑ i, (⇑τ)^[N] (v l i) • (⇑ψ)^[N] (b i) := by
          simp only [hv']
      _ = (⇑ψ)^[N] (∑ i, v l i • b i) := (hsum N g (v l) b).symm
      _ = 0 := by rw [hv0, ← hP N 0, map_zero]
  have hΛsurj : Function.Surjective Λ := by
    intro y
    obtain ⟨x, hx⟩ := hco y
    exact ⟨x, by rw [hΛ, hx]⟩
  obtain ⟨Φ, hF⟩ : ∃ Φ : B →ₗ[R] B, ∀ x : Fin g → R,
      Φ (∑ i, x i • b i) = ∑ i, x i • (⇑ψ)^[N] (b i) := by
    refine ⟨(LinearMap.ker Λ).liftQ Φ₀ hker ∘ₗ
      (Λ.quotKerEquivOfSurjective hΛsurj).symm.toLinearMap, fun x => ?_⟩
    rw [← hΛ x, ← hΦ₀ x]
    have h2 : (Λ.quotKerEquivOfSurjective hΛsurj).symm (Λ x) = Submodule.Quotient.mk x := by
      rw [LinearEquiv.symm_apply_eq, LinearMap.quotKerEquivOfSurjective_apply_mk]
    rw [LinearMap.comp_apply, LinearEquiv.coe_coe, h2, Submodule.liftQ_apply]
  have hK : ∀ x : Fin g → R, (∀ i, (⇑τ)^[N] (x i) = x i) →
      Φ (∑ i, x i • b i) = (⇑ψ)^[N] (∑ i, x i • b i) := by
    intro x hx
    rw [hF, hsum]
    simp only [hx]

  have hsingle : ∀ i, (∀ j, (⇑τ)^[N] ((Pi.single i (1 : R) : Fin g → R) j) =
      (Pi.single i (1 : R) : Fin g → R) j) ∧
      ∑ j, (Pi.single i (1 : R) : Fin g → R) j • b j = b i := by
    intro i
    refine ⟨fun j => ?_, ?_⟩
    · rw [← hQ N]
      by_cases hji : j = i
      · subst hji; simp
      · simp [hji]
    · simp [Pi.single_apply]
  have hΦb : ∀ i, Φ (b i) = (⇑ψ)^[N] (b i) := by
    intro i
    have := hK _ (hsingle i).1
    rwa [(hsingle i).2] at this
  have hΦbb : ∀ i j, Φ (b i * b j) = Φ (b i) * Φ (b j) := by
    intro i j
    rw [hΦb, hΦb, ← hs i j, hK _ (fun k => hs' i j k), hs i j, ← hP N (b i * b j), map_mul,
      hP, hP]
  have hΦ1 : Φ 1 = 1 := by
    rw [← hu, hK _ hu', hu, ← hP N 1, map_one]
  have hΦmul : ∀ x y : B, Φ (x * y) = Φ x * Φ y := by
    intro x y
    obtain ⟨xs, rfl⟩ := hco x
    obtain ⟨ys, rfl⟩ := hco y
    simp only [Finset.sum_mul_sum, smul_mul_smul_comm, map_sum, map_smul, hΦbb]
  have hsurj : Function.Surjective Φ := by
    intro y
    obtain ⟨z, rfl⟩ := (ψ.surjective.iterate N) y
    obtain ⟨zs, rfl⟩ := hco z
    refine ⟨∑ i, (⇑τ)^[N] (zs i) • b i, ?_⟩
    rw [hF, hsum]
  have hinj : Function.Injective Φ :=
    OrzechProperty.injective_of_surjective_endomorphism Φ hsurj
  let A : B →ₐ[R] B := AlgHom.ofLinearMap Φ hΦ1 hΦmul
  let Φe : B ≃ₐ[R] B := AlgEquiv.ofBijective A ⟨hinj, hsurj⟩
  have hΦe : ∀ y, Φe y = Φ y := fun y => rfl
  have hit : ∀ (k : ℕ) (x : Fin g → R), (∀ i, (⇑τ)^[N] (x i) = x i) →
      (Φe ^ k) (∑ i, x i • b i) = (⇑ψ)^[N * k] (∑ i, x i • b i) := by
    intro k
    induction k with
    | zero => intro x hx; simp
    | succ k ih =>
      intro x hx
      rw [pow_succ', AlgEquiv.mul_apply, ih x hx]
      obtain ⟨y, hy, hxy⟩ := hstab (N * k) x hx
      rw [hxy, hΦe, hK y hy, ← hxy, show N * (k + 1) = N + N * k by ring,
        Function.iterate_add_apply]
  refine ⟨N, Φe, g, b, hN, hspan, fun k i => ?_⟩
  have := hit k _ (hsingle i).1
  rwa [(hsingle i).2] at this

theorem wc_wdr_dedekind_data : ∀ (K : Type u) [Field K] [Finite K] (P : ℕ), 1 ≤ P → ∃ (Q m : ℕ) (y μ : Fin m → AlgebraicClosure K), 1 ≤ Q ∧ P ∣ Q ∧ (∀ i, (⇑(@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K) (AlgebraicClosure K) _ _ _).symm)^[Q] (y i) = y i) ∧ ∀ a < Q, ∑ i, μ i * (⇑(@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K) (AlgebraicClosure K) _ _ _).symm)^[a] (y i) = if a = 0 then 1 else 0 :=
by
  intro K _ _ P hP
  classical
  set Fr := @FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K) (AlgebraicClosure K) _ _ _ with hFrdef
  have hFr : ∀ x : AlgebraicClosure K, Fr x = x ^ Nat.card K := by
    intro x
    rw [hFrdef, FiniteField.frobeniusAlgEquivOfAlgebraic_apply, Fintype.card_eq_nat_card]
  have hq : 1 < Nat.card K := Finite.one_lt_card

  have s1 : ∃ z : AlgebraicClosure K, z ^ (Nat.card K ^ P) = z ∧
      ∀ c : ℕ, 0 < c → c < P → z ^ (Nat.card K ^ c) ≠ z := by
    haveI : Fact (Nat.Prime (ringChar K)) := ⟨CharP.char_is_prime K (ringChar K)⟩
    haveI : NeZero P := ⟨by omega⟩
    let E := FiniteField.Extension K (ringChar K) P
    have hE : Nat.card E = Nat.card K ^ P := by
      rw [Module.natCard_eq_pow_finrank (K := K), FiniteField.finrank_extension]
    let ι : E →ₐ[K] AlgebraicClosure K := IsAlgClosed.lift
    have hι : Function.Injective ι := (ι : E →+* AlgebraicClosure K).injective
    obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := Eˣ)
    have hord : orderOf g = Nat.card K ^ P - 1 := by
      rw [orderOf_eq_card_of_forall_mem_zpowers hg, Nat.card_units, hE]
    have hqP : 1 < Nat.card K ^ P := Nat.one_lt_pow (by omega) hq
    refine ⟨ι (g : E), ?_, ?_⟩
    · rw [← map_pow]
      congr 1
      have h1 : (g : E) ^ (Nat.card K ^ P - 1) = 1 := by
        rw [← Units.val_pow_eq_pow_val, ← hord, pow_orderOf_eq_one, Units.val_one]
      calc (g : E) ^ (Nat.card K ^ P) = (g : E) ^ (Nat.card K ^ P - 1 + 1) := by
            congr 1; omega
        _ = (g : E) ^ (Nat.card K ^ P - 1) * g := pow_succ _ _
        _ = g := by rw [h1, one_mul]
    · intro c hc0 hcP h
      rw [← map_pow] at h
      have h2 := hι h
      have hqc : 1 < Nat.card K ^ c := Nat.one_lt_pow (by omega) hq
      have h3 : (g : E) ^ (Nat.card K ^ c - 1) = 1 := by
        have h4 : (g : E) ^ (Nat.card K ^ c - 1) * g = 1 * g := by
          rw [← pow_succ, one_mul, show Nat.card K ^ c - 1 + 1 = Nat.card K ^ c by omega]
          exact h2
        exact mul_right_cancel₀ g.ne_zero h4
      have h4 : g ^ (Nat.card K ^ c - 1) = 1 :=
        Units.ext (by rw [Units.val_pow_eq_pow_val, h3, Units.val_one])
      have h5 := orderOf_dvd_of_pow_eq_one h4
      rw [hord] at h5
      have h6 := Nat.le_of_dvd (by omega) h5
      have h7 : Nat.card K ^ c < Nat.card K ^ P := Nat.pow_lt_pow_right hq hcP
      omega

  have hit : ∀ n (x : AlgebraicClosure K), (⇑Fr)^[n] x = x ^ (Nat.card K ^ n) := by
    intro n
    induction n with
    | zero => intro x; simp
    | succ n ih => intro x; rw [Function.iterate_succ_apply', ih, hFr, ← pow_mul, pow_succ]
  have hl1 : ∀ n x, (⇑Fr.symm)^[n] ((⇑Fr)^[n] x) = x := fun n =>
    Function.LeftInverse.iterate (fun x => Fr.symm_apply_apply x) n
  have hl2 : ∀ n x, (⇑Fr)^[n] ((⇑Fr.symm)^[n] x) = x := fun n =>
    Function.LeftInverse.iterate (fun x => Fr.apply_symm_apply x) n
  have hσpow : ∀ n (x : AlgebraicClosure K) (i : ℕ),
      (⇑Fr.symm)^[n] (x ^ i) = ((⇑Fr.symm)^[n] x) ^ i := by
    intro n
    induction n with
    | zero => intro x i; simp
    | succ n ih =>
      intro x i
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih, map_pow]
  obtain ⟨z, hz1, hz2⟩ := s1
  have hper : (⇑Fr.symm)^[P] z = z := by
    have := hl1 P z
    rwa [hit, hz1] at this
  have hinj : ∀ a k : ℕ, 0 < k → a + k < P → (⇑Fr.symm)^[a] z ≠ (⇑Fr.symm)^[a + k] z := by
    intro a k hk hakP h
    have h1 := congrArg ((⇑Fr)^[a + k]) h
    rw [hl2, add_comm a k, Function.iterate_add_apply, hl2, hit] at h1
    exact hz2 k hk (by omega) h1
  set w : Fin P → AlgebraicClosure K := fun a => (⇑Fr.symm)^[(a : ℕ)] z with hw
  have hwinj : Function.Injective w := by
    intro a b hab
    simp only [hw] at hab
    have ha := a.isLt
    have hb := b.isLt
    rcases lt_trichotomy (a : ℕ) b with h | h | h
    · exfalso
      have h' := hinj a (b - a) (by omega) (by omega)
      rw [show (a : ℕ) + (b - a) = b by omega] at h'
      exact h' hab
    · exact Fin.ext h
    · exfalso
      have h' := hinj b (a - b) (by omega) (by omega)
      rw [show (b : ℕ) + (a - b) = a by omega] at h'
      exact h' hab.symm

  let a₀ : Fin P := ⟨0, hP⟩
  have hinjOn : Set.InjOn w ↑(Finset.univ : Finset (Fin P)) := hwinj.injOn
  set B := Lagrange.basis (Finset.univ : Finset (Fin P)) w a₀ with hB
  have hdeg : B.natDegree < P := by
    rw [hB, Lagrange.natDegree_basis hinjOn (Finset.mem_univ a₀), Finset.card_univ,
      Fintype.card_fin]
    omega
  have heval : ∀ a : Fin P, ∑ i : Fin P, B.coeff i * w a ^ (i : ℕ) = if a = a₀ then 1 else 0 := by
    intro a
    rw [Fin.sum_univ_eq_sum_range (fun i => B.coeff i * w a ^ i) P,
      ← Polynomial.eval_eq_sum_range' hdeg]
    split_ifs with h
    · subst h; exact Lagrange.eval_basis_self hinjOn (Finset.mem_univ _)
    · exact Lagrange.eval_basis_of_ne (Ne.symm h) (Finset.mem_univ a)

  refine ⟨P, P, fun i => z ^ (i : ℕ), fun i => B.coeff i, hP, dvd_refl P, ?_, ?_⟩
  · intro i
    simp only
    rw [hσpow, hper]
  · intro a ha
    have h1 := heval ⟨a, ha⟩
    have h2 : ∀ i : Fin P, B.coeff (i : ℕ) * (⇑Fr.symm)^[a] (z ^ (i : ℕ)) =
        B.coeff (i : ℕ) * w ⟨a, ha⟩ ^ (i : ℕ) := by
      intro i
      rw [hσpow]
    rw [Finset.sum_congr rfl (fun i _ => h2 i), h1]
    simp [a₀, Fin.ext_iff]

theorem wc_wdr_periodic_in_fixed_span : ∀ (Λ : Type u) [Field Λ] (σ : Λ →+* Λ) (B : Type u) [CommRing B] (j : Λ →+* B) (ψ : B →+* B), (∀ (c : Λ) (b : B), ψ (j c * b) = j (σ c) * ψ b) → ∀ (Q m : ℕ) (y μ : Fin m → Λ), 1 ≤ Q → (∀ i, (⇑σ)^[Q] (y i) = y i) → (∀ a < Q, ∑ i, μ i * (⇑σ)^[a] (y i) = if a = 0 then 1 else 0) → ∀ b : B, (⇑ψ)^[Q] b = b → ∃ w : Fin m → B, (∀ i, ψ (w i) = w i) ∧ b = ∑ i, j (μ i) * w i :=
by
  intro Λ _ σ B _ j ψ hJ Q m y μ hQ hy hD b hb

  have iter : ∀ n : ℕ, ∀ c : Λ, ∀ x : B,
      (⇑ψ)^[n] (j c * x) = j ((⇑σ)^[n] c) * (⇑ψ)^[n] x := by
    intro n
    induction n with
    | zero => intro c x; simp
    | succ n ih =>
      intro c x
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply',
        Function.iterate_succ_apply', ih, hJ]

  refine ⟨fun i => ∑ a ∈ Finset.range Q, (⇑ψ)^[a] (j (y i) * b), ?_, ?_⟩
  ·
    intro i
    show ψ (∑ a ∈ Finset.range Q, (⇑ψ)^[a] (j (y i) * b)) =
      ∑ a ∈ Finset.range Q, (⇑ψ)^[a] (j (y i) * b)
    have hper : (⇑ψ)^[Q] (j (y i) * b) = j (y i) * b := by
      rw [iter, hy i, hb]
    have h1 : ψ (∑ a ∈ Finset.range Q, (⇑ψ)^[a] (j (y i) * b)) =
        ∑ a ∈ Finset.range Q, (⇑ψ)^[a + 1] (j (y i) * b) := by
      rw [map_sum]
      refine Finset.sum_congr rfl (fun a _ => ?_)
      rw [Function.iterate_succ_apply']
    rw [h1]
    have h2 := Finset.sum_range_succ' (fun a => (⇑ψ)^[a] (j (y i) * b)) Q
    have h3 := Finset.sum_range_succ (fun a => (⇑ψ)^[a] (j (y i) * b)) Q
    rw [hper] at h3
    rw [Function.iterate_zero_apply] at h2
    exact add_right_cancel (h2.symm.trans h3)
  ·
    show b = ∑ i, j (μ i) * ∑ a ∈ Finset.range Q, (⇑ψ)^[a] (j (y i) * b)
    have hexp : ∑ i, j (μ i) * ∑ a ∈ Finset.range Q, (⇑ψ)^[a] (j (y i) * b)
        = ∑ a ∈ Finset.range Q, j (∑ i, μ i * (⇑σ)^[a] (y i)) * (⇑ψ)^[a] b := by
      simp_rw [Finset.mul_sum, iter, map_sum, Finset.sum_mul]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun i _ => ?_))
      rw [map_mul]
      ring
    rw [hexp]

    have hcoef : ∀ a ∈ Finset.range Q,
        j (∑ i, μ i * (⇑σ)^[a] (y i)) * (⇑ψ)^[a] b = if a = 0 then b else 0 := by
      intro a ha
      rw [hD a (Finset.mem_range.mp ha)]
      split_ifs with h
      · subst h; simp
      · simp
    rw [Finset.sum_congr rfl hcoef, Finset.sum_ite_eq']
    rw [if_pos (Finset.mem_range.mpr (by omega))]

theorem wc_wdr_speiser_indep : ∀ (K : Type u) [Field K] [Finite K] (B : Type u) [CommRing B] (j : AlgebraicClosure K →+* B) (ψ : B →+* B), (∀ (c : AlgebraicClosure K) (b : B), ψ (j c * b) = j ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K) (AlgebraicClosure K) _ _ _).symm c) * ψ b) → ∀ (n : ℕ) (c : Fin n → AlgebraicClosure K) (w : Fin n → B), (∀ i, ψ (w i) = w i) → (∀ k : Fin n → K, ∑ i, j (algebraMap K (AlgebraicClosure K) (k i)) * w i = 0 → ∀ i, k i = 0) → ∑ i, j (c i) * w i = 0 → ∀ i, c i = 0 :=
by
  intro K _ _ B _ j ψ hψ
  classical
  letI : Fintype K := Fintype.ofFinite K
  set σ := (@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
    (AlgebraicClosure K) _ _ _) with hσ

  have hfix : ∀ x : AlgebraicClosure K, σ.symm x = x →
      ∃ k : K, algebraMap K (AlgebraicClosure K) k = x := by
    intro x hx
    have h1 : σ x = x := by
      have h0 := AlgEquiv.apply_symm_apply σ x
      rw [hx] at h0
      exact h0
    have h2 : x ^ Fintype.card K = x := by
      have h3 := FiniteField.frobeniusAlgEquivOfAlgebraic_apply K (AlgebraicClosure K) x
      rw [← h3]
      exact h1
    have hq : 1 < Fintype.card K := Fintype.one_lt_card
    by_contra hne
    push_neg at hne
    have hxZ : x ∉ Finset.univ.image (algebraMap K (AlgebraicClosure K)) := by
      intro h
      obtain ⟨k, _, hk⟩ := Finset.mem_image.mp h
      exact hne k hk
    have hZcard : (insert x (Finset.univ.image (algebraMap K (AlgebraicClosure K)))).card
        = Fintype.card K + 1 := by
      rw [Finset.card_insert_of_notMem hxZ,
        Finset.card_image_of_injective _ (algebraMap K (AlgebraicClosure K)).injective,
        Finset.card_univ]
    have hp0 : (Polynomial.X ^ Fintype.card K - Polynomial.X :
        Polynomial (AlgebraicClosure K)) ≠ 0 :=
      FiniteField.X_pow_card_sub_X_ne_zero _ hq
    have hsub : (insert x (Finset.univ.image (algebraMap K (AlgebraicClosure K)))).val ⊆
        (Polynomial.X ^ Fintype.card K - Polynomial.X :
          Polynomial (AlgebraicClosure K)).roots := by
      intro z hz
      rw [Polynomial.mem_roots hp0, Polynomial.IsRoot, Polynomial.eval_sub, Polynomial.eval_pow,
        Polynomial.eval_X, sub_eq_zero]
      have hz' : z ∈ insert x (Finset.univ.image (algebraMap K (AlgebraicClosure K))) := hz
      rcases Finset.mem_insert.mp hz' with h | h
      · rw [h]; exact h2
      · obtain ⟨k, _, hk⟩ := Finset.mem_image.mp h
        rw [← hk, ← map_pow, FiniteField.pow_card]
    have hle := Polynomial.card_le_degree_of_subset_roots hsub
    rw [FiniteField.X_pow_card_sub_X_natDegree_eq _ hq, hZcard] at hle
    omega

  have key : ∀ (n : ℕ) (w : Fin n → B), (∀ i, ψ (w i) = w i) →
      (∀ k : Fin n → K, ∑ i, j (algebraMap K (AlgebraicClosure K) (k i)) * w i = 0 →
        ∀ i, k i = 0) →
      ∀ s : ℕ, ∀ c : Fin n → AlgebraicClosure K,
        (Finset.univ.filter (fun i => c i ≠ 0)).card ≤ s →
        ∑ i, j (c i) * w i = 0 → ∀ i, c i = 0 := by
    intro n w hw hind s
    induction s with
    | zero =>
      intro c hc _ i
      by_contra hci
      have hmem : i ∈ Finset.univ.filter (fun i => c i ≠ 0) :=
        Finset.mem_filter.mpr ⟨Finset.mem_univ _, hci⟩
      have hpos := Finset.card_pos.mpr ⟨i, hmem⟩
      omega
    | succ s ih =>
      intro c hc hR i₀
      by_contra hci
      set a := (c i₀)⁻¹ with ha
      set d : Fin n → AlgebraicClosure K := fun i => a * c i with hd
      have hRd : ∑ i, j (d i) * w i = 0 := by
        have h4 : ∑ i, j (d i) * w i = j a * ∑ i, j (c i) * w i := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          simp only [hd, map_mul, mul_assoc]
        rw [h4, hR, mul_zero]
      have hd1 : d i₀ = 1 := by
        simp only [hd, ha]
        exact inv_mul_cancel₀ hci
      have hstar : ∑ i, j (σ.symm (d i)) * w i = 0 := by
        have h := congrArg ψ hRd
        rw [map_sum, map_zero] at h
        rw [← h]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [hψ, hw]
      set e : Fin n → AlgebraicClosure K := fun i => σ.symm (d i) - d i with he
      have hRe : ∑ i, j (e i) * w i = 0 := by
        have h5 : ∑ i, j (e i) * w i =
            ∑ i, j (σ.symm (d i)) * w i - ∑ i, j (d i) * w i := by
          rw [← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          simp only [he, map_sub, sub_mul]
        rw [h5, hstar, hRd, sub_zero]
      have hsub : Finset.univ.filter (fun i => e i ≠ 0) ⊆
          (Finset.univ.filter (fun i => c i ≠ 0)).erase i₀ := by
        intro i hi
        rw [Finset.mem_filter] at hi
        rw [Finset.mem_erase, Finset.mem_filter]
        refine ⟨?_, Finset.mem_univ _, ?_⟩
        · intro hii
          apply hi.2
          rw [hii]
          simp only [he, hd1, map_one, sub_self]
        · intro hc0
          apply hi.2
          simp only [he, hd, hc0, mul_zero, map_zero, sub_self]
      have hmem : i₀ ∈ Finset.univ.filter (fun i => c i ≠ 0) :=
        Finset.mem_filter.mpr ⟨Finset.mem_univ _, hci⟩
      have hcard := Finset.card_le_card hsub
      rw [Finset.card_erase_of_mem hmem] at hcard
      have hezero := ih e (by omega) hRe
      have hfx : ∀ i, ∃ k : K, algebraMap K (AlgebraicClosure K) k = d i :=
        fun i => hfix (d i) (sub_eq_zero.mp (hezero i))
      choose kk hkk using hfx
      have hk0 := hind kk (by simp only [hkk]; exact hRd) i₀
      have hd0 : d i₀ = 0 := by rw [← hkk i₀, hk0, map_zero]
      rw [hd0] at hd1
      exact zero_ne_one hd1
  intro n c w hw hind h0
  exact key n w hw hind n c
    ((Finset.card_filter_le _ _).trans (by rw [Finset.card_univ, Fintype.card_fin])) h0

theorem wc_wdr_productMap_bijective : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A] [Algebra K A] (B : Type u) [CommRing B] [Algebra (TensorProduct K A (AlgebraicClosure K)) B] [Algebra A B] [IsScalarTower A (TensorProduct K A (AlgebraicClosure K)) B] (C : Subalgebra A B), (∀ b : B, ∃ (n : ℕ) (c : Fin n → AlgebraicClosure K) (w : Fin n → B), (∀ i, w i ∈ C) ∧ b = ∑ i, algebraMap (TensorProduct K A (AlgebraicClosure K)) B ((1 : A) ⊗ₜ[K] c i) * w i) → (∀ (n : ℕ) (c : Fin n → AlgebraicClosure K) (w : Fin n → B), (∀ i, w i ∈ C) → (∀ k : Fin n → K, ∑ i, algebraMap (TensorProduct K A (AlgebraicClosure K)) B ((1 : A) ⊗ₜ[K] algebraMap K (AlgebraicClosure K) (k i)) * w i = 0 → ∀ i, k i = 0) → ∑ i, algebraMap (TensorProduct K A (AlgebraicClosure K)) B ((1 : A) ⊗ₜ[K] c i) * w i = 0 → ∀ i, c i = 0) → Function.Bijective (Algebra.TensorProduct.productMap C.val (IsScalarTower.toAlgHom A (TensorProduct K A (AlgebraicClosure K)) B)) :=
by
  intro K _ A _ _ B _ _ _ _ C hspan hind
  classical
  set Φ := Algebra.TensorProduct.productMap C.val
    (IsScalarTower.toAlgHom A (TensorProduct K A (AlgebraicClosure K)) B) with hΦdef

  have hΦ : ∀ (n : ℕ) (c : Fin n → AlgebraicClosure K) (w : Fin n → C),
      Φ (∑ i, w i ⊗ₜ[A] ((1 : A) ⊗ₜ[K] c i)) =
        ∑ i, algebraMap (TensorProduct K A (AlgebraicClosure K)) B ((1 : A) ⊗ₜ[K] c i) * (w i : B) := by
    intro n c w
    rw [map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hΦdef, Algebra.TensorProduct.productMap_apply_tmul, IsScalarTower.toAlgHom_apply]
    exact mul_comm _ _

  have hsurj : Function.Surjective Φ := by
    intro b
    obtain ⟨n, c, w, hw, hb⟩ := hspan b
    refine ⟨∑ i, (⟨w i, hw i⟩ : C) ⊗ₜ[A] ((1 : A) ⊗ₜ[K] c i), ?_⟩
    rw [hΦ]
    exact hb.symm

  have hrep : ∀ x : TensorProduct A C (TensorProduct K A (AlgebraicClosure K)),
      ∃ (n : ℕ) (c : Fin n → AlgebraicClosure K) (w : Fin n → C),
        x = ∑ i, w i ⊗ₜ[A] ((1 : A) ⊗ₜ[K] c i) := by
    have h0 : ∃ (n : ℕ) (c : Fin n → AlgebraicClosure K) (w : Fin n → C),
        (0 : TensorProduct A C (TensorProduct K A (AlgebraicClosure K))) =
          ∑ i, w i ⊗ₜ[A] ((1 : A) ⊗ₜ[K] c i) :=
      ⟨0, Fin.elim0, Fin.elim0, by simp⟩
    have hadd : ∀ x y : TensorProduct A C (TensorProduct K A (AlgebraicClosure K)),
        (∃ (n : ℕ) (c : Fin n → AlgebraicClosure K) (w : Fin n → C),
          x = ∑ i, w i ⊗ₜ[A] ((1 : A) ⊗ₜ[K] c i)) →
        (∃ (n : ℕ) (c : Fin n → AlgebraicClosure K) (w : Fin n → C),
          y = ∑ i, w i ⊗ₜ[A] ((1 : A) ⊗ₜ[K] c i)) →
        (∃ (n : ℕ) (c : Fin n → AlgebraicClosure K) (w : Fin n → C),
          x + y = ∑ i, w i ⊗ₜ[A] ((1 : A) ⊗ₜ[K] c i)) := by
      rintro x y ⟨n, c, w, rfl⟩ ⟨m, c', w', rfl⟩
      refine ⟨n + m, Fin.append c c', Fin.append w w', ?_⟩
      rw [Fin.sum_univ_add]
      simp only [Fin.append_left, Fin.append_right]
    intro x
    induction x using TensorProduct.induction_on with
    | zero => exact h0
    | tmul v t =>
      induction t using TensorProduct.induction_on with
      | zero => rw [TensorProduct.tmul_zero]; exact h0
      | tmul a l =>
        refine ⟨1, ![l], ![a • v], ?_⟩
        rw [Fin.sum_univ_one]
        simp only [Matrix.cons_val_zero]
        rw [TensorProduct.smul_tmul, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      | add t₁ t₂ h₁ h₂ => rw [TensorProduct.tmul_add]; exact hadd _ _ h₁ h₂
    | add x y hx hy => exact hadd _ _ hx hy

  have hscal : ∀ (k : K) (b : B),
      algebraMap (TensorProduct K A (AlgebraicClosure K)) B
        ((1 : A) ⊗ₜ[K] algebraMap K (AlgebraicClosure K) k) * b = algebraMap K A k • b := by
    intro k b
    have h1 : ((1 : A) ⊗ₜ[K] algebraMap K (AlgebraicClosure K) k) =
        algebraMap A (TensorProduct K A (AlgebraicClosure K)) (algebraMap K A k) := by
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
        Algebra.algebraMap_eq_smul_one (A := AlgebraicClosure K) k,
        Algebra.algebraMap_eq_smul_one (A := A) k, TensorProduct.tmul_smul,
        TensorProduct.smul_tmul']
    rw [h1, ← IsScalarTower.algebraMap_apply A (TensorProduct K A (AlgebraicClosure K)) B,
      Algebra.smul_def]

  have htrans : ∀ (κ : K) (v : C) (l : AlgebraicClosure K),
      v ⊗ₜ[A] ((1 : A) ⊗ₜ[K] (algebraMap K (AlgebraicClosure K) κ * l)) =
        (algebraMap K A κ • v) ⊗ₜ[A] ((1 : A) ⊗ₜ[K] l) := by
    intro κ v l
    have e1 : (1 : A) ⊗ₜ[K] (algebraMap K (AlgebraicClosure K) κ * l) =
        algebraMap K A κ • ((1 : A) ⊗ₜ[K] l) := by
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one, ← Algebra.smul_def,
        Algebra.algebraMap_eq_smul_one (A := A) κ, TensorProduct.tmul_smul,
        TensorProduct.smul_tmul']
    rw [e1]
    exact (TensorProduct.smul_tmul _ _ _).symm

  have hP : ∀ (n : ℕ) (c : Fin n → AlgebraicClosure K) (w : Fin n → C),
      Φ (∑ i, w i ⊗ₜ[A] ((1 : A) ⊗ₜ[K] c i)) = 0 →
        ∑ i, w i ⊗ₜ[A] ((1 : A) ⊗ₜ[K] c i) = 0 := by
    intro n
    induction n with
    | zero => intro c w _; simp
    | succ n ih =>
      intro c w hx
      by_cases hI : ∀ k : Fin (n + 1) → K, ∑ i, algebraMap (TensorProduct K A (AlgebraicClosure K)) B
          ((1 : A) ⊗ₜ[K] algebraMap K (AlgebraicClosure K) (k i)) * (w i : B) = 0 → ∀ i, k i = 0
      · rw [hΦ] at hx
        have hc := hind (n + 1) c (fun i => (w i : B)) (fun i => (w i).2) hI hx
        refine Finset.sum_eq_zero (fun i _ => ?_)
        rw [hc i, TensorProduct.tmul_zero, TensorProduct.tmul_zero]
      · push_neg at hI
        obtain ⟨k, hk, j, hkj⟩ := hI
        have hkB : ∑ i, algebraMap K A (k i) • (w i : B) = 0 := by
          rw [← hk]
          exact Finset.sum_congr rfl (fun i _ => (hscal (k i) (w i)).symm)
        have hkC : ∑ i, algebraMap K A (k i) • w i = 0 := by
          apply Subtype.ext
          exact_mod_cast hkB
        have hwj : w j = -∑ i, algebraMap K A (k (j.succAbove i) / k j) • w (j.succAbove i) := by
          have h1 := congrArg (fun y => algebraMap K A ((k j)⁻¹) • y) hkC
          simp only [smul_zero] at h1
          rw [Fin.sum_univ_succAbove _ j, smul_add, Finset.smul_sum, smul_smul, ← map_mul,
            inv_mul_cancel₀ hkj, map_one, one_smul] at h1
          rw [eq_neg_iff_add_eq_zero]
          calc w j + ∑ i, algebraMap K A (k (j.succAbove i) / k j) • w (j.succAbove i)
              = w j + ∑ i, algebraMap K A ((k j)⁻¹) •
                  algebraMap K A (k (j.succAbove i)) • w (j.succAbove i) := by
                congr 1
                refine Finset.sum_congr rfl (fun i _ => ?_)
                rw [smul_smul, ← map_mul, div_eq_inv_mul]
            _ = 0 := h1
        have heq : ∑ i, w i ⊗ₜ[A] ((1 : A) ⊗ₜ[K] c i) =
            ∑ i, w (j.succAbove i) ⊗ₜ[A] ((1 : A) ⊗ₜ[K] (c (j.succAbove i) -
              algebraMap K (AlgebraicClosure K) (k (j.succAbove i) / k j) * c j)) := by
          have h2 : ∑ i, w (j.succAbove i) ⊗ₜ[A] ((1 : A) ⊗ₜ[K] (c (j.succAbove i) -
                algebraMap K (AlgebraicClosure K) (k (j.succAbove i) / k j) * c j)) =
              ∑ i, w (j.succAbove i) ⊗ₜ[A] ((1 : A) ⊗ₜ[K] c (j.succAbove i)) -
                (∑ i, algebraMap K A (k (j.succAbove i) / k j) • w (j.succAbove i)) ⊗ₜ[A]
                  ((1 : A) ⊗ₜ[K] c j) := by
            rw [TensorProduct.sum_tmul, ← Finset.sum_sub_distrib]
            refine Finset.sum_congr rfl (fun i _ => ?_)
            rw [← htrans, ← TensorProduct.tmul_sub, ← TensorProduct.tmul_sub]
          rw [h2, Fin.sum_univ_succAbove _ j, hwj, TensorProduct.neg_tmul]
          abel
        rw [heq] at hx ⊢
        exact ih (fun i => c (j.succAbove i) -
          algebraMap K (AlgebraicClosure K) (k (j.succAbove i) / k j) * c j)
          (fun i => w (j.succAbove i)) hx

  have hinj : Function.Injective Φ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨n, c, w, rfl⟩ := hrep x
    exact hP n c w hx
  exact ⟨hinj, hsurj⟩

theorem wc_wdr_finite_of_bijective : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A] [Algebra K A] (B : Type u) [CommRing B] [Algebra (TensorProduct K A (AlgebraicClosure K)) B] [Algebra A B] [IsScalarTower A (TensorProduct K A (AlgebraicClosure K)) B] [Module.Finite (TensorProduct K A (AlgebraicClosure K)) B] (C : Subalgebra A B), Function.Bijective (Algebra.TensorProduct.productMap C.val (IsScalarTower.toAlgHom A (TensorProduct K A (AlgebraicClosure K)) B)) → Module.Finite A C :=
by
  intro K _ A _ _ B _ _ _ _ _ C hbij
  classical

  obtain ⟨θ₀, hθ₀⟩ := LinearMap.exists_leftInverse_of_injective
    (Algebra.linearMap K (AlgebraicClosure K))
    (LinearMap.ker_eq_bot.mpr (algebraMap K (AlgebraicClosure K)).injective)
  have hθ₀1 : θ₀ 1 = 1 := by
    have h := LinearMap.congr_fun hθ₀ 1
    simpa using h
  let θ : TensorProduct K A (AlgebraicClosure K) →ₗ[A] A :=
    (TensorProduct.AlgebraTensorModule.rid K A A).toLinearMap ∘ₗ θ₀.baseChange A
  have hθ1 : θ 1 = 1 := by
    rw [Algebra.TensorProduct.one_def]
    simp [θ, LinearMap.baseChange_tmul, hθ₀1]
  let P := Algebra.TensorProduct.productMap C.val
    (IsScalarTower.toAlgHom A (TensorProduct K A (AlgebraicClosure K)) B)
  have hP : ∀ (c : C) (ρ : TensorProduct K A (AlgebraicClosure K)),
      P (c ⊗ₜ[A] ρ) = ρ • (c : B) := by
    intro c ρ
    simp only [P, Algebra.TensorProduct.productMap_apply_tmul, Subalgebra.coe_val,
      IsScalarTower.coe_toAlgHom', Algebra.smul_def]
    exact mul_comm _ _
  let Θ : TensorProduct A C (TensorProduct K A (AlgebraicClosure K)) →ₗ[A] C :=
    (TensorProduct.rid A C).toLinearMap ∘ₗ LinearMap.lTensor C θ
  have hΘ : ∀ (c : C) (ρ : TensorProduct K A (AlgebraicClosure K)),
      Θ (c ⊗ₜ[A] ρ) = θ ρ • c := by
    intro c ρ
    simp [Θ]

  obtain ⟨n, b, hb⟩ := Module.Finite.exists_fin (R := TensorProduct K A (AlgebraicClosure K)) (M := B)
  choose z hz using fun i => hbij.2 (b i)
  choose S hS using fun i => TensorProduct.exists_finset (z i)
  let s : Finset C := Finset.univ.biUnion fun i => (S i).image Prod.fst
  have hgen : ∀ i, b i ∈ Submodule.span (TensorProduct K A (AlgebraicClosure K))
      ((fun w : C => (w : B)) '' (s : Set C)) := by
    intro i
    rw [← hz i, hS i, map_sum]
    apply Submodule.sum_mem
    intro p hp
    rw [hP]
    apply Submodule.smul_mem
    apply Submodule.subset_span
    exact ⟨p.1, Finset.mem_coe.2 (Finset.mem_biUnion.2
      ⟨i, Finset.mem_univ _, Finset.mem_image_of_mem _ hp⟩), rfl⟩
  have htop : Submodule.span (TensorProduct K A (AlgebraicClosure K))
      ((fun w : C => (w : B)) '' (s : Set C)) = ⊤ := by
    rw [eq_top_iff, ← hb]
    exact Submodule.span_le.2 (Set.range_subset_iff.2 hgen)
  have hmem : ∀ x : C, x ∈ Submodule.span A (s : Set C) := by
    intro x
    have hx : (x : B) ∈ Submodule.span (TensorProduct K A (AlgebraicClosure K))
        ((fun w : C => (w : B)) '' (s : Set C)) := by
      rw [htop]; exact Submodule.mem_top
    obtain ⟨t, hts, c, hc⟩ := (Submodule.mem_span_image_iff_exists_fun _).1 hx
    have hz' : (∑ i : t, ((i : C) ⊗ₜ[A] c i)) = x ⊗ₜ[A] (1 : TensorProduct K A (AlgebraicClosure K)) := by
      apply hbij.1
      show P _ = P _
      rw [map_sum, hP x 1, one_smul, ← hc]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      exact hP (i : C) (c i)
    have hx' : x = Θ (∑ i : t, ((i : C) ⊗ₜ[A] c i)) := by
      rw [hz', hΘ, hθ1, one_smul]
    rw [hx', map_sum]
    apply Submodule.sum_mem
    intro i _
    rw [hΘ]
    apply Submodule.smul_mem
    apply Submodule.subset_span
    exact hts i.2
  exact Module.finite_def.mpr ⟨s, eq_top_iff.2 (fun x _ => hmem x)⟩

theorem wc_wd_ring_core : wcWdRingCore.{u} :=
by
  intro K _ _ A _ _ _ B _ _ _ _ _ _ ψ hψ
  classical

  have hτt : ∀ (a : A) (c : AlgebraicClosure K), wcWdTau K A (a ⊗ₜ[K] c) =
      a ⊗ₜ[K] ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
        (AlgebraicClosure K) _ _ _).symm c) := by
    intro a c
    simp only [wcWdTau, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, AlgEquiv.coe_algHom]
  let j : AlgebraicClosure K →+* B :=
    (algebraMap (TensorProduct K A (AlgebraicClosure K)) B).comp
      (Algebra.TensorProduct.includeRight : AlgebraicClosure K →ₐ[K]
        TensorProduct K A (AlgebraicClosure K)).toRingHom
  have hj : ∀ c, j c = algebraMap (TensorProduct K A (AlgebraicClosure K)) B ((1 : A) ⊗ₜ[K] c) :=
    fun c => rfl
  have hJ : ∀ (c : AlgebraicClosure K) (b : B), (ψ : B →+* B) (j c * b) =
      j ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
        (AlgebraicClosure K) _ _ _).symm c) * (ψ : B →+* B) b := by
    intro c b
    show ψ (j c * b) = _ * ψ b
    rw [hj, hj, ← Algebra.smul_def, hψ, hτt, Algebra.smul_def]

  have halg : ∀ a : A, algebraMap A B a =
      (a ⊗ₜ[K] (1 : AlgebraicClosure K) : TensorProduct K A (AlgebraicClosure K)) • (1 : B) := by
    intro a
    rw [Algebra.smul_def, mul_one, IsScalarTower.algebraMap_apply A
      (TensorProduct K A (AlgebraicClosure K)) B, Algebra.TensorProduct.algebraMap_apply,
      Algebra.algebraMap_self, RingHom.id_apply]
  let C : Subalgebra A B :=
    { carrier := {b | ψ b = b}
      mul_mem' := fun {a b} ha hb => by
        simp only [Set.mem_setOf_eq] at ha hb ⊢
        rw [map_mul, ha, hb]
      add_mem' := fun {a b} ha hb => by
        simp only [Set.mem_setOf_eq] at ha hb ⊢
        rw [map_add, ha, hb]
      algebraMap_mem' := fun a => by
        simp only [Set.mem_setOf_eq]
        rw [halg, hψ, hτt, map_one, map_one] }
  have hC : ∀ b, b ∈ C ↔ ψ b = b := fun b => Iff.rfl

  haveI : IsNoetherianRing (TensorProduct K (AlgebraicClosure K) A) :=
    Algebra.FiniteType.isNoetherianRing (AlgebraicClosure K) _
  haveI : IsNoetherianRing (TensorProduct K A (AlgebraicClosure K)) :=
    isNoetherianRing_of_ringEquiv _ (Algebra.TensorProduct.comm K (AlgebraicClosure K) A).toRingEquiv

  have hforder : ∀ φ : B ≃ₐ[TensorProduct K A (AlgebraicClosure K)] B,
      ∃ M : ℕ, 1 ≤ M ∧ φ ^ M = 1 := by
    intro φ
    obtain ⟨M, hM, hres⟩ := wc_wdr_residue_perm_order _ B φ
    refine ⟨M, hM, ?_⟩
    have h := wc_wdr_unramified_rigid _ B (φ ^ M).toAlgHom
      (AlgHom.id (TensorProduct K A (AlgebraicClosure K)) B)
      (by intro Q hQ b; exact hres Q b)
    ext b
    have h2 := DFunLike.congr_fun h b
    simpa using h2

  obtain ⟨N, Φ, g, bb, hN, hspan, hΦ⟩ := wc_wdr_linearize (TensorProduct K A (AlgebraicClosure K))
    (wcWdTau K A).toRingHom B ψ hψ (fun r => wc_wdr_tau_periodic K A r)
  obtain ⟨M, hM, hM1⟩ := hforder Φ
  have hbb : ∀ i, (⇑ψ)^[N * M] (bb i) = bb i := by
    intro i
    have h := hΦ M i
    rw [hM1, AlgEquiv.one_apply] at h
    exact h.symm
  have hit : ∀ (n : ℕ) (r : TensorProduct K A (AlgebraicClosure K)) (b : B),
      (⇑ψ)^[n] (r • b) = (⇑(wcWdTau K A))^[n] r • (⇑ψ)^[n] b := by
    intro n
    induction n with
    | zero => intro r b; rfl
    | succ n ih =>
      intro r b
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply',
        Function.iterate_succ_apply', ih, hψ]
  have hsum : ∀ (n : ℕ) (f : Fin g → B), (⇑ψ)^[n] (∑ i, f i) = ∑ i, (⇑ψ)^[n] (f i) := by
    intro n
    induction n with
    | zero => intro f; rfl
    | succ n ih =>
      intro f
      rw [Function.iterate_succ_apply', ih, map_sum]
      simp only [Function.iterate_succ_apply']

  have hper : ∀ b : B, ∃ P : ℕ, 1 ≤ P ∧ (⇑ψ)^[P] b = b := by
    intro b
    have hb : b ∈ Submodule.span (TensorProduct K A (AlgebraicClosure K)) (Set.range bb) := by
      rw [hspan]; exact Submodule.mem_top
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hb
    choose per hper1 hper2 using fun i => wc_wdr_tau_periodic K A (c i)
    have hpos : 0 < N * M * ∏ i, per i :=
      Nat.mul_pos (Nat.mul_pos (by omega) (by omega))
        (Finset.prod_pos fun i _ => (by have := hper1 i; omega))
    refine ⟨N * M * ∏ i, per i, hpos, ?_⟩
    rw [hsum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hit]
    have e1 : (⇑(wcWdTau K A))^[N * M * ∏ i, per i] (c i) = c i :=
      Function.IsPeriodicPt.trans_dvd (hper2 i)
        (Dvd.dvd.mul_left (Finset.dvd_prod_of_mem per (Finset.mem_univ i)) _)
    have e2 : (⇑ψ)^[N * M * ∏ i, per i] (bb i) = bb i :=
      Function.IsPeriodicPt.trans_dvd (hbb i) (Dvd.intro _ rfl)
    rw [e1, e2]

  have hspan6 : ∀ b : B, ∃ (n : ℕ) (c : Fin n → AlgebraicClosure K) (w : Fin n → B),
      (∀ i, w i ∈ C) ∧
      b = ∑ i, algebraMap (TensorProduct K A (AlgebraicClosure K)) B ((1 : A) ⊗ₜ[K] c i) * w i := by
    intro b
    obtain ⟨P, hP, hPb⟩ := hper b
    obtain ⟨Q, m, y, μ, hQ, hPQ, hy, hμ⟩ := wc_wdr_dedekind_data K P hP
    have hQb : (⇑ψ)^[Q] b = b := Function.IsPeriodicPt.trans_dvd hPb hPQ
    obtain ⟨w, hw, hb⟩ := wc_wdr_periodic_in_fixed_span (AlgebraicClosure K)
      ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
        (AlgebraicClosure K) _ _ _).symm : AlgebraicClosure K →+* AlgebraicClosure K)
      B j (ψ : B →+* B) hJ Q m y μ hQ hy hμ b hQb
    exact ⟨m, μ, w, fun i => hw i, hb⟩

  have hind6 : ∀ (n : ℕ) (c : Fin n → AlgebraicClosure K) (w : Fin n → B), (∀ i, w i ∈ C) →
      (∀ k : Fin n → K, ∑ i, algebraMap (TensorProduct K A (AlgebraicClosure K)) B
        ((1 : A) ⊗ₜ[K] algebraMap K (AlgebraicClosure K) (k i)) * w i = 0 → ∀ i, k i = 0) →
      ∑ i, algebraMap (TensorProduct K A (AlgebraicClosure K)) B ((1 : A) ⊗ₜ[K] c i) * w i = 0 →
      ∀ i, c i = 0 :=
    fun n c w hw hk h0 => wc_wdr_speiser_indep K B j (ψ : B →+* B) hJ n c w hw hk h0
  have hbij := wc_wdr_productMap_bijective K A B C hspan6 hind6
  exact ⟨C, hC, wc_wdr_finite_of_bijective K A B C hbij, hbij⟩

theorem wc_wd_affine_case : wcWdRingCore.{u} → ∀ (K : Type u) [Field K] [Finite K] (A : Type u) [CommRing A] [Algebra K A] [Algebra.FiniteType K A], wcWdHasDescent (Spec.map (CommRingCat.ofHom (algebraMap A (TensorProduct K A (AlgebraicClosure K))))) (Spec.map (CommRingCat.ofHom (wcWdTau K A).toRingHom)) :=
by
  have s2t : ∀ (A C R B : Type u) [CommRing A] [CommRing C] [CommRing R] [CommRing B] [Algebra A C]
      [Algebra A R] [Algebra R B] [Algebra A B] [IsScalarTower A R B] (g : C →ₐ[A] B),
      Function.Bijective (Algebra.TensorProduct.productMap g (IsScalarTower.toAlgHom A R B)) →
      IsPullback (Spec.map (CommRingCat.ofHom g.toRingHom)) (Spec.map (CommRingCat.ofHom (algebraMap R B)))
        (Spec.map (CommRingCat.ofHom (algebraMap A C))) (Spec.map (CommRingCat.ofHom (algebraMap A R))) := by
    intro A C R B _ _ _ _ _ _ _ _ _ g hb
    have P := CommRingCat.isPushout_tensorProduct A C R
    let Φ := AlgEquiv.ofBijective _ hb
    have P2 : IsPushout (CommRingCat.ofHom (algebraMap A C)) (CommRingCat.ofHom (algebraMap A R))
        (CommRingCat.ofHom g.toRingHom) (CommRingCat.ofHom (algebraMap R B)) := by
      refine P.of_iso (Iso.refl _) (Iso.refl _) (Iso.refl _) Φ.toRingEquiv.toCommRingCatIso ?_ ?_ ?_ ?_
      · simp
      · simp
      · ext c
        simp [Φ]
      · ext r
        simp [Φ]
    exact isPullback_SpecMap_of_isPushout _ _ _ _ P2
  have s3t : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] (C : Subalgebra A B) (ψ : B ≃+* B),
      (∀ b, b ∈ C ↔ ψ b = b) → ∀ (E : Scheme.{u}) (e : E ≅ Spec (.of B)) (FE : E ⟶ E),
      FE ≫ e.hom = e.hom ≫ Spec.map (CommRingCat.ofHom (ψ : B →+* B)) →
      (FE ≫ e.hom ≫ Spec.map (CommRingCat.ofHom C.val.toRingHom) =
        e.hom ≫ Spec.map (CommRingCat.ofHom C.val.toRingHom)) ∧
      ∀ (Y' : Scheme.{u}) (h : E ⟶ Y'), IsAffine Y' → FE ≫ h = h →
        ∃ g : Spec (.of C) ⟶ Y', e.hom ≫ Spec.map (CommRingCat.ofHom C.val.toRingHom) ≫ g = h := by
    intro A B _ _ _ C ψ hC E e FE hFE
    have hι : CommRingCat.ofHom C.val.toRingHom ≫ CommRingCat.ofHom (ψ : B →+* B) =
        CommRingCat.ofHom C.val.toRingHom := by
      ext c
      simpa using ((hC c).1 c.2)
    refine ⟨?_, ?_⟩
    · rw [← Category.assoc, hFE, Category.assoc, ← Spec.map_comp, hι]
    · intro Y' h hY hh
      let φ := Spec.preimage (e.inv ≫ h ≫ Y'.isoSpec.hom)
      have hφ : Spec.map φ = e.inv ≫ h ≫ Y'.isoSpec.hom := Spec.map_preimage _
      have hΨ : Spec.map (CommRingCat.ofHom (ψ : B →+* B)) = e.inv ≫ FE ≫ e.hom := by
        rw [hFE, Iso.inv_hom_id_assoc]
      have hinv : φ ≫ CommRingCat.ofHom (ψ : B →+* B) = φ := by
        apply Spec.map_injective
        rw [Spec.map_comp, hφ, hΨ]
        simp only [Category.assoc, Iso.hom_inv_id_assoc]
        rw [← Category.assoc FE h, hh]
      have hmem : ∀ x, φ.hom x ∈ C := by
        intro x
        rw [hC]
        have := congrArg (fun f => f.hom x) hinv
        simpa using this
      let φ' := RingHom.codRestrict φ.hom C hmem
      refine ⟨Spec.map (CommRingCat.ofHom φ') ≫ Y'.isoSpec.inv, ?_⟩
      have hc : CommRingCat.ofHom φ' ≫ CommRingCat.ofHom C.val.toRingHom = φ := by
        ext x; rfl
      have e2 : Spec.map (CommRingCat.ofHom C.val.toRingHom) ≫ Spec.map (CommRingCat.ofHom φ') =
          e.inv ≫ h ≫ Y'.isoSpec.hom := by
        rw [← Spec.map_comp, hc, hφ]
      rw [reassoc_of% e2]
      simp
  have s1t : ∀ (R : Type u) [CommRing R] (τ : R →+* R) (E : Scheme.{u}) (πE : E ⟶ Spec (.of R))
      (FE FE' : E ⟶ E), IsFinite πE → Etale πE → FE ≫ FE' = 𝟙 E → FE' ≫ FE = 𝟙 E →
      FE ≫ πE = πE ≫ Spec.map (CommRingCat.ofHom τ) →
      ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B) (e : E ≅ Spec (.of B)) (ψ : B ≃+* B),
        Module.Finite R B ∧ Algebra.Etale R B ∧
        e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap R B)) = πE ∧
        FE ≫ e.hom = e.hom ≫ Spec.map (CommRingCat.ofHom (ψ : B →+* B)) ∧
        ∀ (r : R) (b : B), ψ (r • b) = τ r • ψ b := by
    intro R _ τ E πE FE FE' hfin het h1 h2 hπ
    haveI : IsAffine E := isAffine_of_isAffineHom πE
    let φ₀ : CommRingCat.of R ⟶ Γ(E, ⊤) := (Scheme.ΓSpecIso (.of R)).inv ≫ πE.appTop
    letI : Algebra R Γ(E, ⊤) := φ₀.hom.toAlgebra
    have hleg : E.isoSpec.hom ≫ Spec.map φ₀ = πE := by
      have := Scheme.isoSpec_hom_naturality πE
      rw [Scheme.isoSpec_Spec_hom] at this
      simp only [φ₀, Spec.map_comp]
      rw [reassoc_of% this, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id, Category.comp_id]
    have hleg' : Spec.map φ₀ = E.isoSpec.inv ≫ πE := by rw [← hleg, Iso.inv_hom_id_assoc]
    have hfinB : Module.Finite R Γ(E, ⊤) := by
      rw [← RingHom.finite_algebraMap]
      change φ₀.hom.Finite
      exact (IsFinite.SpecMap_iff φ₀).mp (by rw [hleg']; infer_instance)
    have hetB : Algebra.Etale R Γ(E, ⊤) := by
      rw [← RingHom.etale_algebraMap]
      change φ₀.hom.Etale
      exact (HasRingHomProperty.Spec_iff (P := @Etale)).mp (by rw [hleg']; infer_instance)
    have haa' : FE.appTop.hom.comp FE'.appTop.hom = RingHom.id _ := by
      have := congrArg (fun f => (Scheme.Hom.appTop f).hom) h1
      simp only [Scheme.Hom.comp_appTop, Scheme.Hom.id_appTop, CommRingCat.hom_comp,
        CommRingCat.hom_id] at this
      exact this
    have ha'a : FE'.appTop.hom.comp FE.appTop.hom = RingHom.id _ := by
      have := congrArg (fun f => (Scheme.Hom.appTop f).hom) h2
      simp only [Scheme.Hom.comp_appTop, Scheme.Hom.id_appTop, CommRingCat.hom_comp,
        CommRingCat.hom_id] at this
      exact this
    let ψ : Γ(E, ⊤) ≃+* Γ(E, ⊤) := RingEquiv.ofRingHom FE.appTop.hom FE'.appTop.hom haa' ha'a
    have hkey : φ₀ ≫ FE.appTop = CommRingCat.ofHom τ ≫ φ₀ := by
      have := congrArg Scheme.Hom.appTop hπ
      simp only [Scheme.Hom.comp_appTop] at this
      simp only [φ₀, Category.assoc]
      rw [this, ← Category.assoc, ← Category.assoc, Scheme.ΓSpecIso_inv_naturality]
    refine ⟨Γ(E, ⊤), inferInstance, inferInstance, E.isoSpec, ψ, hfinB, hetB, ?_, ?_, ?_⟩
    · rw [← hleg]; rfl
    · rw [← Scheme.isoSpec_hom_naturality FE]; rfl
    · intro r b
      have hk := congrArg (fun f => f.hom r) hkey
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at hk
      rw [Algebra.smul_def, Algebra.smul_def, map_mul]
      change FE.appTop.hom (φ₀.hom r) * _ = φ₀.hom (τ r) * _
      rw [hk]
  intro hcore K _ _ A _ _ _
  intro E πE FE FE' hfin het h1 h2 hπ
  obtain ⟨B, _, _, e, ψ, hfinB, hetB, hleg, hFE, hsemi⟩ :=
    s1t _ (wcWdTau K A).toRingHom E πE FE FE' hfin het h1 h2 hπ
  letI : Algebra A B := ((algebraMap (TensorProduct K A (AlgebraicClosure K)) B).comp
    (algebraMap A (TensorProduct K A (AlgebraicClosure K)))).toAlgebra
  haveI : IsScalarTower A (TensorProduct K A (AlgebraicClosure K)) B :=
    IsScalarTower.of_algebraMap_eq' rfl
  obtain ⟨C, hC, hCfin, hbij⟩ := hcore K A B ψ (fun r b => hsemi r b)
  have P0 := s2t A C (TensorProduct K A (AlgebraicClosure K)) B C.val hbij
  have hs3 := s3t A B C ψ hC E e FE hFE
  set j := e.hom ≫ Spec.map (CommRingCat.ofHom C.val.toRingHom) with hjdef
  set k := Spec.map (CommRingCat.ofHom (algebraMap A (TensorProduct K A (AlgebraicClosure K))))
    with hkdef
  have hpb : IsPullback j πE (Spec.map (CommRingCat.ofHom (algebraMap A C))) k := by
    rw [← hleg]
    exact P0.of_iso e.symm (Iso.refl _) (Iso.refl _) (Iso.refl _) (by simp [j]) (by simp)
      (by simp) (by simp)
  have hff : Flat k ∧ Surjective k := (flat_and_surjective_SpecMap_iff _).mpr (by
    rw [CommRingCat.hom_ofHom, RingHom.faithfullyFlat_algebraMap_iff]; infer_instance)
  have hQ : (@Surjective ⊓ @Flat ⊓ @QuasiCompact : MorphismProperty Scheme.{u}) k :=
    ⟨⟨hff.2, hff.1⟩, inferInstance⟩
  have hetY : Etale (Spec.map (CommRingCat.ofHom (algebraMap A C))) :=
    MorphismProperty.of_isPullback_of_descendsAlong (P := @Etale)
      (Q := @Surjective ⊓ @Flat ⊓ @QuasiCompact) hpb.flip hQ het
  have hfinY : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap A C))) :=
    (IsFinite.SpecMap_iff _).mpr (by rw [CommRingCat.hom_ofHom, RingHom.finite_algebraMap]; exact hCfin)
  have hsurj : Surjective j := MorphismProperty.of_isPullback (P := @Surjective) hpb.flip hff.2
  have hflat : Flat j := MorphismProperty.of_isPullback (P := @Flat) hpb.flip hff.1
  haveI : Epi j := Flat.epi_of_flat_of_surjective j
  refine ⟨Spec (.of C), Spec.map (CommRingCat.ofHom (algebraMap A C)), j, hfinY, hetY, hpb, hsurj,
    hs3.1, ?_⟩
  intro Y' πY' E' πE' j' F2 haff hj' hF2 hF2j f hf hfF
  haveI : IsAffine Y' := isAffine_of_isAffineHom πY'
  have hinv : FE ≫ (f ≫ j') = f ≫ j' := by
    rw [← Category.assoc, ← hfF, Category.assoc, hF2j]
  obtain ⟨g, hg⟩ := hs3.2 Y' (f ≫ j') inferInstance hinv
  have hg' : j ≫ g = f ≫ j' := by rw [hjdef, Category.assoc]; exact hg
  refine ⟨g, ⟨?_, hg'⟩, fun g₂ hg₂ => (cancel_epi j).mp (hg₂.2.trans hg'.symm)⟩
  rw [← cancel_epi j, reassoc_of% hg', hj', ← Category.assoc, hf]
  exact hpb.w.symm

theorem wc_wd_zariski_globalize : ∀ (T T' : Scheme.{u}) (k : T ⟶ T') (Fr Fr' : T ⟶ T), Fr ≫ Fr' = 𝟙 T → Fr' ≫ Fr = 𝟙 T → Fr ≫ k = k → Flat k → Surjective k → QuasiCompact k → (∀ V : T'.affineOpens, ∃ (TV T'V : Scheme.{u}) (kV : TV ⟶ T'V) (eV : T'V ≅ (V.1 : Scheme.{u})) (iV : TV ⟶ T) (FrV : TV ⟶ TV), IsPullback iV (kV ≫ eV.hom) k V.1.ι ∧ FrV ≫ iV = iV ≫ Fr ∧ wcWdHasDescent kV FrV) → wcWdHasDescent k Fr :=
by

  have transport : ∀ (A B B' : Scheme.{u}) (kk : A ⟶ B) (e : B ≅ B') (F : A ⟶ A),
      wcWdHasDescent kk F → wcWdHasDescent (kk ≫ e.hom) F := by
    intro A B B' kk e F hd E πE FE FE' h1 h2 h3 h4 h5
    obtain ⟨Y, πY, j, hf, he, hpb, hs, hFj, hfun⟩ := hd E πE FE FE' h1 h2 h3 h4 h5
    refine ⟨Y, πY ≫ e.hom, j, ?_, ?_, ?_, hs, hFj, ?_⟩
    · have := hf; infer_instance
    · have := he; infer_instance
    · have h2' : IsPullback kk (𝟙 A) e.hom (kk ≫ e.hom) :=
        IsPullback.of_vert_isIso ⟨by simp⟩
      have := hpb.paste_vert h2'
      rwa [Category.comp_id] at this
    · intro Y' πY' E' πE' j' F2 haff hj' hF2 hF2j f hf1 hf2
      have := haff
      obtain ⟨g, ⟨hg1, hg2⟩, hgu⟩ := hfun Y' (πY' ≫ e.inv) E' πE' j' F2 inferInstance
        (by rw [← Category.assoc, hj']; simp) hF2 hF2j f hf1 hf2
      refine ⟨g, ⟨?_, hg2⟩, fun g' hg' => hgu g' ⟨?_, hg'.2⟩⟩
      · rw [← hg1]; simp
      · rw [← Category.assoc, hg'.1]; simp

  have trans : ∀ (TU TU' U U' EU EU' YU YU' : Scheme.{u}) (e : U ⟶ U') (t : TU ⟶ TU') (kU : TU ⟶ U)
      (kU' : TU' ⟶ U') (FrU : TU ⟶ TU) (r : EU ⟶ EU') (πU : EU ⟶ TU) (πU' : EU' ⟶ TU')
      (FEU : EU ⟶ EU) (FEU' : EU' ⟶ EU') (qU : YU ⟶ U) (qU' : YU' ⟶ U') (jU : EU ⟶ YU)
      (jU' : EU' ⟶ YU'), Flat kU → Surjective kU → QuasiCompact kU → IsPullback t kU kU' e →
      IsPullback r πU πU' t → FrU ≫ kU = kU → FEU ≫ πU = πU ≫ FrU → FEU ≫ r = r ≫ FEU' →
      FEU' ≫ jU' = jU' → IsFinite qU' → IsPullback jU πU qU kU → IsPullback jU' πU' qU' kU' →
      (∀ (Y' : Scheme.{u}) (πY' : Y' ⟶ U) (E' : Scheme.{u}) (πE' : E' ⟶ TU) (j' : E' ⟶ Y')
        (F2 : E' ⟶ E'), IsAffineHom πY' → j' ≫ πY' = πE' ≫ kU → F2 ≫ πE' = πE' ≫ FrU →
        F2 ≫ j' = j' → ∀ f : EU ⟶ E', f ≫ πE' = πU → f ≫ F2 = FEU ≫ f →
          ∃! g : YU ⟶ Y', g ≫ πY' = qU ∧ jU ≫ g = f ≫ j') →
      ∃ φ : YU ⟶ YU', IsPullback φ qU qU' e ∧ jU ≫ φ = r ≫ jU' := by
    intro TU TU' U U' EU EU' YU YU' e t kU kU' FrU r πU πU' FEU FEU' qU qU' jU jU' hfl hsu hqc
      ht hr hFr hFEπ hFEr hFEj hqf hpb hpb' L
    have hw : (r ≫ jU') ≫ qU' = (πU ≫ kU) ≫ e := by
      simp only [Category.assoc]
      rw [hpb'.w, reassoc_of% hr.w, ht.w]
    obtain ⟨j'', hj1, hj2⟩ : ∃ j'' : EU ⟶ Limits.pullback qU' e,
        j'' ≫ Limits.pullback.fst qU' e = r ≫ jU' ∧ j'' ≫ Limits.pullback.snd qU' e = πU ≫ kU :=
      ⟨Limits.pullback.lift _ _ hw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have : IsFinite (Limits.pullback.snd qU' e) :=
      MorphismProperty.of_isPullback (P := @IsFinite) (IsPullback.of_hasPullback qU' e) hqf
    obtain ⟨g, ⟨hg1, hg2⟩, -⟩ := L (Limits.pullback qU' e) (Limits.pullback.snd qU' e) EU πU j''
      FEU inferInstance hj2 hFEπ
      (by
        apply Limits.pullback.hom_ext
        · simp only [Category.assoc]
          rw [hj1, reassoc_of% hFEr, hFEj]
        · simp only [Category.assoc]
          rw [hj2, reassoc_of% hFEπ, hFr])
      (𝟙 _) (Category.id_comp _) (by rw [Category.id_comp, Category.comp_id])
    have ha : IsPullback (r ≫ jU') πU qU' (kU ≫ e) := by
      have := hr.paste_horiz hpb'
      rwa [ht.w] at this
    have hb : IsPullback j'' πU (Limits.pullback.snd qU' e) kU := by
      refine IsPullback.of_right ?_ hj2 (IsPullback.of_hasPullback qU' e)
      rw [hj1]; exact ha
    have hc : IsPullback (𝟙 EU) jU j'' g := by
      refine IsPullback.of_right ?_ hg2.symm hb.flip
      rw [Category.id_comp, hg1]; exact hpb.flip
    have hQ : (@Surjective ⊓ @Flat ⊓ @QuasiCompact : MorphismProperty Scheme.{u}) j'' := by
      refine ⟨⟨?_, ?_⟩, ?_⟩
      · exact MorphismProperty.of_isPullback (P := @Surjective) hb.flip hsu
      · exact MorphismProperty.of_isPullback (P := @Flat) hb.flip hfl
      · exact MorphismProperty.of_isPullback (P := @QuasiCompact) hb.flip hqc
    have hiso : IsIso g := by
      have := MorphismProperty.of_isPullback_of_descendsAlong
        (P := MorphismProperty.isomorphisms Scheme.{u})
        (Q := (@Surjective ⊓ @Flat ⊓ @QuasiCompact : MorphismProperty Scheme.{u})) hc hQ
        ((MorphismProperty.isomorphisms.iff _).mpr inferInstance)
      exact (MorphismProperty.isomorphisms.iff _).mp this
    have hgp : IsPullback g qU (Limits.pullback.snd qU' e) (𝟙 U) :=
      IsPullback.of_horiz_isIso ⟨by rw [hg1, Category.comp_id]⟩
    refine ⟨g ≫ Limits.pullback.fst qU' e, ?_, ?_⟩
    · have := hgp.paste_horiz (IsPullback.of_hasPullback qU' e)
      rwa [Category.id_comp] at this
    · rw [← Category.assoc, hg2, Category.id_comp, hj1]

  have glueAff : ∀ (T' : Scheme.{u}) (W : T'.affineOpens → Scheme.{u}) (q : ∀ U, W U ⟶ (U.1 : Scheme.{u})) (φ : ∀ U U' : T'.affineOpens, U ≤ U' → (W U ⟶ W U')), (∀ U, φ U U le_rfl = 𝟙 _) → (∀ (U U' U'' : T'.affineOpens) (h : U ≤ U') (h' : U' ≤ U''), φ U U' h ≫ φ U' U'' h' = φ U U'' (h.trans h')) → (∀ (U U' : T'.affineOpens) (h : U ≤ U'), IsPullback (φ U U' h) (q U) (q U') (T'.homOfLE h)) → ∃ (V : Scheme.{u}) (p : V ⟶ T') (ι : ∀ U, W U ⟶ V), (∀ U, IsPullback (ι U) (q U) p U.1.ι) ∧ (∀ (U U' : T'.affineOpens) (h : U ≤ U'), φ U U' h ≫ ι U' = ι U) := by
    intro T' W q φ H1 H2 H3
    let F : T'.directedAffineCover.I₀ ⥤ Scheme.{u} :=
      { obj := fun U => W U
        map := fun {U U'} f => φ U U' (leOfHom f)
        map_id := fun U => H1 U
        map_comp := fun {U U' U''} f g => (H2 U U' U'' (leOfHom f) (leOfHom g)).symm }
    let α : F ⟶ T'.directedAffineCover.functorOfLocallyDirected :=
      { app := fun U => q U
        naturality := fun U U' f => (H3 U U' (leOfHom f)).w }
    have hα : NatTrans.Equifibered α := fun U U' f => H3 U U' (leOfHom f)
    have key : ∀ d : T'.directedAffineCover.RelativeGluingData, ∃ (V : Scheme.{u}) (p : V ⟶ T')
        (ι : ∀ U : T'.directedAffineCover.I₀, d.functor.obj U ⟶ V),
        (∀ U, IsPullback (ι U) (d.natTrans.app U) p (T'.directedAffineCover.f U)) ∧
        (∀ (U U' : T'.directedAffineCover.I₀) (f : U ⟶ U'), d.functor.map f ≫ ι U' = ι U) := by
      intro d
      exact ⟨d.glued, d.toBase, fun U => Limits.colimit.ι d.functor U,
        fun U => (d.isPullback_natTrans_ι_toBase U).flip,
        fun U U' f => Limits.colimit.w d.functor f⟩
    obtain ⟨V, p, ι, h1, h2⟩ := key ⟨F, α, hα⟩
    exact ⟨V, p, ι, h1, fun U U' h => h2 U U' (homOfLE h)⟩

  have isPbLocal : ∀ (V₀ V T T' : Scheme.{u}) (j : V₀ ⟶ V) (p₀ : V₀ ⟶ T) (p : V ⟶ T') (k : T ⟶ T') (ι : Type u) (S : ι → Scheme.{u}) (s : ∀ i, S i ⟶ T'), (∀ i, IsOpenImmersion (s i)) → (∀ x : T', ∃ i, x ∈ Set.range (s i)) → j ≫ p = p₀ ≫ k → (∀ i, ∃ (A B C : Scheme.{u}) (a : A ⟶ V₀) (b : B ⟶ V) (c : C ⟶ T) (jA : A ⟶ B) (pA : A ⟶ C) (pB : B ⟶ S i) (kC : C ⟶ S i), IsPullback b pB p (s i) ∧ IsPullback c kC k (s i) ∧ IsPullback a pA p₀ c ∧ jA ≫ b = a ≫ j ∧ IsPullback jA pA pB kC) → IsPullback j p₀ p k := by
    intro V₀ V T T' j p₀ p k ι S s hs hcov hw hloc
    choose A B C a b c jA pA pB kC H1 H2 H3 H4 H5 using hloc
    have hb : ∀ i, IsOpenImmersion (b i) := fun i =>
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) (H1 i).flip (hs i)
    have hc : ∀ x : V, ∃ i y, b i y = x := by
      intro x
      obtain ⟨i, hi⟩ := hcov (p x)
      have hx : x ∈ Set.range (Limits.pullback.fst p (s i)) := by
        rw [Scheme.Pullback.range_fst]; exact hi
      obtain ⟨w, hw'⟩ := hx
      refine ⟨i, (H1 i).isoPullback.inv w, ?_⟩
      rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_fst, hw']
    let 𝒰 : V.OpenCover := Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) ι B b hc hb
    apply Scheme.isPullback_of_openCover (𝒰 := 𝒰)
    intro i
    have Q1 : IsPullback (a i) (jA i) j (b i) := by
      refine IsPullback.of_bot ?_ (H4 i).symm (H1 i)
      have := (H3 i).paste_vert (H2 i)
      rw [← (H5 i).w, ← hw] at this
      exact this
    have P2 : IsPullback (jA i) (pA i ≫ c i) (b i ≫ p) k := by
      have := (H5 i).paste_vert (H2 i).flip
      rw [← (H1 i).w] at this
      exact this
    have L : IsPullback (Limits.pullback.snd j (b i)) (Limits.pullback.fst j (b i) ≫ p₀)
        (b i ≫ p) k := by
      refine IsPullback.of_iso P2 Q1.isoPullback (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
      · simp [IsPullback.isoPullback_hom_snd]
      · rw [Iso.refl_hom, Category.comp_id, ← Category.assoc, IsPullback.isoPullback_hom_fst,
          (H3 i).w]
      · simp
      · simp
    exact L
  intro T T' k Fr Fr' hFF' hF'F hFk hfl hsu hqc hloc
  have mapfs : ∀ (Z : Scheme.{u}) (f : Z ⟶ T') (U U' : T'.affineOpens) (h : U ≤ U'),
      Limits.pullback.map f U.1.ι f U'.1.ι (𝟙 _) (T'.homOfLE h) (𝟙 _) (by simp) (by simp) ≫
        Limits.pullback.fst f U'.1.ι = Limits.pullback.fst f U.1.ι ∧
      Limits.pullback.map f U.1.ι f U'.1.ι (𝟙 _) (T'.homOfLE h) (𝟙 _) (by simp) (by simp) ≫
        Limits.pullback.snd f U'.1.ι = Limits.pullback.snd f U.1.ι ≫ T'.homOfLE h :=
    fun Z f U U' h => ⟨(Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _),
      Limits.pullback.lift_snd _ _ _⟩

  have glue : ∀ (Z Y : Scheme.{u}) (f : Z ⟶ T') (g : ∀ U : T'.affineOpens, Limits.pullback f U.1.ι ⟶ Y),
      (∀ (U U' : T'.affineOpens) (h : U ≤ U'), Limits.pullback.map f U.1.ι f U'.1.ι (𝟙 _)
        (T'.homOfLE h) (𝟙 _) (by simp) (by simp) ≫ g U' = g U) →
      ∃ j : Z ⟶ Y, ∀ U : T'.affineOpens, Limits.pullback.fst f U.1.ι ≫ j = g U :=
    fun Z Y f g hg => ⟨Scheme.OpenCover.glueMorphismsOfLocallyDirected
      (Precoverage.ZeroHypercover.pullback₁ f T'.directedAffineCover) g
      (fun {U U'} hUU => hg U U' (leOfHom hUU)),
    fun U => Scheme.OpenCover.map_glueMorphismsOfLocallyDirected
      (Precoverage.ZeroHypercover.pullback₁ f T'.directedAffineCover) g
      (fun {U U'} hUU => hg U U' (leOfHom hUU)) U⟩
  have ext : ∀ (Z Y : Scheme.{u}) (f : Z ⟶ T') (a b : Z ⟶ Y),
      (∀ U : T'.affineOpens, Limits.pullback.fst f U.1.ι ≫ a = Limits.pullback.fst f U.1.ι ≫ b) →
      a = b :=
    fun Z Y f a b H =>
      Scheme.Cover.hom_ext (Precoverage.ZeroHypercover.pullback₁ f T'.directedAffineCover) a b H
  have hcov : ∀ x : T', ∃ U : T'.affineOpens, x ∈ Set.range U.1.ι := by
    intro x
    obtain ⟨U, y, hy⟩ := T'.directedAffineCover.exists_eq x
    exact ⟨U, y, hy⟩
  intro E πE FE FE' hEf hEe hFE1 hFE2 hFEπ

  choose TU T'V kV eV aU FrU hpbT hFrU hdescV using hloc
  obtain ⟨kU, hpbT, hdesc⟩ : ∃ kU : ∀ U : T'.affineOpens, TU U ⟶ (U.1 : Scheme.{u}),
      (∀ U, IsPullback (aU U) (kU U) k U.1.ι) ∧ (∀ U, wcWdHasDescent (kU U) (FrU U)) :=
    ⟨fun U => kV U ≫ (eV U).hom, hpbT, fun U => transport _ _ _ (kV U) (eV U) (FrU U) (hdescV U)⟩
  clear hdescV
  have hFrk : ∀ U, FrU U ≫ kU U = kU U := by
    intro U
    rw [← cancel_mono (U.1.ι)]
    simp only [Category.assoc]
    rw [← (hpbT U).w, reassoc_of% (hFrU U), hFk]
  have hkfl : ∀ U, Flat (kU U) := fun U => MorphismProperty.of_isPullback (P := @Flat) (hpbT U) hfl
  have hksu : ∀ U, Surjective (kU U) := fun U =>
    MorphismProperty.of_isPullback (P := @Surjective) (hpbT U) hsu
  have hkqc : ∀ U, QuasiCompact (kU U) := fun U =>
    MorphismProperty.of_isPullback (P := @QuasiCompact) (hpbT U) hqc
  have tex : ∀ (U U' : T'.affineOpens) (h : U ≤ U'), ∃ t : TU U ⟶ TU U',
      t ≫ aU U' = aU U ∧ t ≫ kU U' = kU U ≫ T'.homOfLE h :=
    fun U U' h => ⟨(hpbT U').lift (aU U) (kU U ≫ T'.homOfLE h)
      (by rw [Category.assoc, Scheme.homOfLE_ι]; exact (hpbT U).w),
      (hpbT U').lift_fst _ _ _, (hpbT U').lift_snd _ _ _⟩
  choose t ht1 ht2 using tex
  have htpb : ∀ U U' h, IsPullback (t U U' h) (kU U) (kU U') (T'.homOfLE h) := by
    intro U U' h
    refine IsPullback.of_right ?_ (ht2 U U' h) (hpbT U')
    rw [ht1, Scheme.homOfLE_ι]; exact hpbT U

  have hFEk : FE ≫ πE ≫ k = πE ≫ k := by rw [reassoc_of% hFEπ, hFk]
  have hFE'k : FE' ≫ πE ≫ k = πE ≫ k := by
    calc FE' ≫ πE ≫ k = FE' ≫ FE ≫ πE ≫ k := by rw [hFEk]
      _ = πE ≫ k := by rw [reassoc_of% hFE2]
  have πex : ∀ U : T'.affineOpens, ∃ π : Limits.pullback (πE ≫ k) U.1.ι ⟶ TU U,
      π ≫ aU U = Limits.pullback.fst (πE ≫ k) U.1.ι ≫ πE ∧
      π ≫ kU U = Limits.pullback.snd (πE ≫ k) U.1.ι :=
    fun U => ⟨(hpbT U).lift (Limits.pullback.fst (πE ≫ k) U.1.ι ≫ πE)
      (Limits.pullback.snd (πE ≫ k) U.1.ι)
      (by rw [Category.assoc]; exact Limits.pullback.condition),
      (hpbT U).lift_fst _ _ _, (hpbT U).lift_snd _ _ _⟩
  choose πU hπ1 hπ2 using πex
  have hE1 : ∀ U, IsPullback (Limits.pullback.fst (πE ≫ k) U.1.ι) (πU U) πE (aU U) := by
    intro U
    refine IsPullback.of_bot ?_ (hπ1 U).symm (hpbT U)
    rw [hπ2]; exact IsPullback.of_hasPullback (πE ≫ k) U.1.ι
  have FEex : ∀ (G : E ⟶ E), G ≫ πE ≫ k = πE ≫ k → ∀ U : T'.affineOpens,
      ∃ m : Limits.pullback (πE ≫ k) U.1.ι ⟶ Limits.pullback (πE ≫ k) U.1.ι,
      m ≫ Limits.pullback.fst (πE ≫ k) U.1.ι = Limits.pullback.fst (πE ≫ k) U.1.ι ≫ G ∧
      m ≫ Limits.pullback.snd (πE ≫ k) U.1.ι = Limits.pullback.snd (πE ≫ k) U.1.ι :=
    fun G hG U => ⟨Limits.pullback.lift (Limits.pullback.fst (πE ≫ k) U.1.ι ≫ G)
      (Limits.pullback.snd (πE ≫ k) U.1.ι)
      (by rw [Category.assoc, hG]; exact Limits.pullback.condition),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  choose FEU hFEU1 hFEU2 using FEex FE hFEk
  choose FE'U hFE'U1 hFE'U2 using FEex FE' hFE'k
  have rex : ∀ (U U' : T'.affineOpens) (h : U ≤ U'),
      ∃ r : Limits.pullback (πE ≫ k) U.1.ι ⟶ Limits.pullback (πE ≫ k) U'.1.ι,
      r = Limits.pullback.map (πE ≫ k) U.1.ι (πE ≫ k) U'.1.ι (𝟙 _) (T'.homOfLE h) (𝟙 _)
        (by simp) (by simp) ∧
      r ≫ Limits.pullback.fst (πE ≫ k) U'.1.ι = Limits.pullback.fst (πE ≫ k) U.1.ι ∧
      r ≫ Limits.pullback.snd (πE ≫ k) U'.1.ι = Limits.pullback.snd (πE ≫ k) U.1.ι ≫ T'.homOfLE h :=
    fun U U' h => ⟨_, rfl, (mapfs E (πE ≫ k) U U' h).1, (mapfs E (πE ≫ k) U U' h).2⟩
  choose r hr0 hr1 hr2 using rex
  have hrr : ∀ U, r U U le_rfl = 𝟙 _ := by
    intro U
    apply Limits.pullback.hom_ext
    · rw [hr1, Category.id_comp]
    · rw [hr2, Scheme.homOfLE_rfl, Category.comp_id, Category.id_comp]
  have hrrr : ∀ U U' U'' (h : U ≤ U') (h' : U' ≤ U''),
      r U U' h ≫ r U' U'' h' = r U U'' (h.trans h') := by
    intro U U' U'' h h'
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, hr1]
    · simp only [Category.assoc, hr2, reassoc_of% (hr2 U U' h), Scheme.homOfLE_homOfLE]
  have hE2 : ∀ U U' h, IsPullback (r U U' h) (πU U) (πU U') (t U U' h) := by
    intro U U' h
    refine IsPullback.of_right ?_ ?_ (hE1 U')
    · rw [hr1, ht1]; exact hE1 U
    · apply (hpbT U').hom_ext
      · simp only [Category.assoc, hπ1, ht1, reassoc_of% (hr1 U U' h)]
      · simp only [Category.assoc, hπ2, ht2, hr2, reassoc_of% (hπ2 U)]
  have hE3 : ∀ U, FEU U ≫ πU U = πU U ≫ FrU U := by
    intro U
    apply (hpbT U).hom_ext
    · simp only [Category.assoc, hπ1, hFrU, reassoc_of% (hFEU1 U), hFEπ, reassoc_of% (hπ1 U)]
    · simp only [Category.assoc, hπ2, hFrk, hFEU2]
  have hE4a : ∀ U, FEU U ≫ FE'U U = 𝟙 _ := by
    intro U
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, hFE'U1, reassoc_of% (hFEU1 U), hFE1, Category.comp_id,
        Category.id_comp]
    · simp only [Category.assoc, hFE'U2, hFEU2, Category.id_comp]
  have hE4b : ∀ U, FE'U U ≫ FEU U = 𝟙 _ := by
    intro U
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, hFEU1, reassoc_of% (hFE'U1 U), hFE2, Category.comp_id,
        Category.id_comp]
    · simp only [Category.assoc, hFE'U2, hFEU2, Category.id_comp]
  have hE5 : ∀ U U' h, FEU U ≫ r U U' h = r U U' h ≫ FEU U' := by
    intro U U' h
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, hr1, hFEU1, reassoc_of% (hr1 U U' h)]
    · simp only [Category.assoc, hr2, hFEU2, reassoc_of% (hFEU2 U)]
  have hπf : ∀ U, IsFinite (πU U) := fun U =>
    MorphismProperty.of_isPullback (P := @IsFinite) (hE1 U) hEf
  have hπe : ∀ U, Etale (πU U) := fun U =>
    MorphismProperty.of_isPullback (P := @Etale) (hE1 U) hEe

  have loc := fun U => hdesc U _ (πU U) (FEU U) (FE'U U) (hπf U) (hπe U) (hE4a U) (hE4b U) (hE3 U)
  choose YU qU jU hqf hqe hjpb hjs hFj L using loc
  have hjepi : ∀ U, Epi (jU U) := by
    intro U
    have : Flat (jU U) := MorphismProperty.of_isPullback (P := @Flat) (hjpb U).flip (hkfl U)
    have : Surjective (jU U) :=
      MorphismProperty.of_isPullback (P := @Surjective) (hjpb U).flip (hksu U)
    exact Flat.epi_of_flat_of_surjective _

  have trex := fun (U U' : T'.affineOpens) (h : U ≤ U') => trans _ _ _ _ _ _ (YU U) (YU U')
      (T'.homOfLE h) (t U U' h) (kU U) (kU U') (FrU U) (r U U' h) (πU U) (πU U') (FEU U) (FEU U')
      (qU U) (qU U') (jU U) (jU U') (hkfl U) (hksu U) (hkqc U) (htpb U U' h) (hE2 U U' h) (hFrk U)
      (hE3 U) (hE5 U U' h) (hFj U') (hqf U') (hjpb U) (hjpb U') (L U)
  choose φ hφpb hφj using trex
  have hφid : ∀ U, φ U U le_rfl = 𝟙 _ := by
    intro U
    rw [← cancel_epi (jU U), hφj, hrr, Category.id_comp, Category.comp_id]
  have hφcomp : ∀ (U U' U'' : T'.affineOpens) (h : U ≤ U') (h' : U' ≤ U''),
      φ U U' h ≫ φ U' U'' h' = φ U U'' (h.trans h') := by
    intro U U' U'' h h'
    rw [← cancel_epi (jU U), reassoc_of% (hφj U U' h), hφj U' U'' h', hφj U U'' (h.trans h'),
      ← Category.assoc, hrrr]

  obtain ⟨Y, πY, ι, hι, hιφ⟩ := glueAff T' YU qU φ hφid hφcomp hφpb
  obtain ⟨j, hj⟩ := glue E Y (πE ≫ k) (fun U => jU U ≫ ι U) (by
    intro U U' h
    show _ ≫ jU U' ≫ ι U' = jU U ≫ ι U
    rw [← hr0 U U' h, ← Category.assoc, ← hφj, Category.assoc, hιφ])
  have hj' : ∀ U, Limits.pullback.fst (πE ≫ k) U.1.ι ≫ j = jU U ≫ ι U := hj
  have hsnd : ∀ U : T'.affineOpens, (hι U).isoPullback.inv ≫ qU U = Limits.pullback.snd πY U.1.ι :=
    fun U => (hι U).isoPullback_inv_snd
  have hpf : IsFinite πY := by
    set_option backward.isDefEq.respectTransparency.types false in
    refine IsZariskiLocalAtTarget.of_openCover (P := @IsFinite) T'.directedAffineCover ?_
    intro (U : T'.affineOpens)
    change IsFinite (Limits.pullback.snd πY U.1.ι)
    rw [← hsnd U]
    haveI := hqf U
    infer_instance
  have hpe : Etale πY := by
    set_option backward.isDefEq.respectTransparency.types false in
    refine IsZariskiLocalAtTarget.of_openCover (P := @Etale) T'.directedAffineCover ?_
    intro (U : T'.affineOpens)
    change Etale (Limits.pullback.snd πY U.1.ι)
    rw [← hsnd U]
    haveI := hqe U
    infer_instance
  have hcomm : j ≫ πY = πE ≫ k := by
    apply ext E T' (πE ≫ k)
    intro U
    rw [reassoc_of% (hj' U), (hι U).w, reassoc_of% (hjpb U).w, ← (hpbT U).w,
      reassoc_of% (hπ1 U)]
  have hjpbG : IsPullback j πE πY k :=
    isPbLocal E Y T T' j πE πY k T'.affineOpens (fun U => (U.1 : Scheme.{u})) (fun U => U.1.ι)
      (fun U => inferInstance) hcov hcomm (fun U => ⟨_, _, _, Limits.pullback.fst (πE ≫ k) U.1.ι,
        ι U, aU U, jU U, πU U, qU U, kU U, hι U, hpbT U, hE1 U, (hj' U).symm, hjpb U⟩)
  refine ⟨Y, πY, j, hpf, hpe, hjpbG,
    MorphismProperty.of_isPullback (P := @Surjective) hjpbG.flip hsu, ?_, ?_⟩
  · apply ext E Y (πE ≫ k)
    intro U
    rw [← reassoc_of% (hFEU1 U), hj', reassoc_of% (hFj U)]

  intro Y' πY' E' πE' j' F2 haff hj'w hF2 hF2j f hf1 hf2
  have hjepiG : Epi j := by
    have : Flat j := MorphismProperty.of_isPullback (P := @Flat) hjpbG.flip hfl
    have : Surjective j := MorphismProperty.of_isPullback (P := @Surjective) hjpbG.flip hsu
    exact Flat.epi_of_flat_of_surjective _
  have locex : ∀ U : T'.affineOpens, ∃ hU : YU U ⟶ Y', hU ≫ πY' = qU U ≫ U.1.ι ∧
      jU U ≫ hU = Limits.pullback.fst (πE ≫ k) U.1.ι ≫ f ≫ j' := by
    intro U
    have w1 : (Limits.pullback.fst πE' (aU U) ≫ j') ≫ πY' =
        (Limits.pullback.snd πE' (aU U) ≫ kU U) ≫ U.1.ι := by
      simp only [Category.assoc, hj'w, Limits.pullback.condition_assoc, (hpbT U).w]
    obtain ⟨j'U, hj'U1, hj'U2⟩ : ∃ m : Limits.pullback πE' (aU U) ⟶ Limits.pullback πY' U.1.ι,
        m ≫ Limits.pullback.fst πY' U.1.ι = Limits.pullback.fst πE' (aU U) ≫ j' ∧
        m ≫ Limits.pullback.snd πY' U.1.ι = Limits.pullback.snd πE' (aU U) ≫ kU U :=
      ⟨Limits.pullback.lift _ _ w1, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have w2 : (Limits.pullback.fst πE' (aU U) ≫ F2) ≫ πE' =
        (Limits.pullback.snd πE' (aU U) ≫ FrU U) ≫ aU U := by
      simp only [Category.assoc, hF2, hFrU U, Limits.pullback.condition_assoc]
    obtain ⟨F2U, hF2U1, hF2U2⟩ : ∃ m : Limits.pullback πE' (aU U) ⟶ Limits.pullback πE' (aU U),
        m ≫ Limits.pullback.fst πE' (aU U) = Limits.pullback.fst πE' (aU U) ≫ F2 ∧
        m ≫ Limits.pullback.snd πE' (aU U) = Limits.pullback.snd πE' (aU U) ≫ FrU U :=
      ⟨Limits.pullback.lift _ _ w2, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have w3 : (Limits.pullback.fst (πE ≫ k) U.1.ι ≫ f) ≫ πE' = πU U ≫ aU U := by
      simp only [Category.assoc, hf1, hπ1 U]
    obtain ⟨fU, hfU1, hfU2⟩ : ∃ m : Limits.pullback (πE ≫ k) U.1.ι ⟶ Limits.pullback πE' (aU U),
        m ≫ Limits.pullback.fst πE' (aU U) = Limits.pullback.fst (πE ≫ k) U.1.ι ≫ f ∧
        m ≫ Limits.pullback.snd πE' (aU U) = πU U :=
      ⟨Limits.pullback.lift _ _ w3, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have : IsAffineHom (Limits.pullback.snd πY' U.1.ι) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback πY' U.1.ι) haff
    have c1 : F2U ≫ j'U = j'U := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, hj'U1, reassoc_of% hF2U1, hF2j]
      · simp only [Category.assoc, hj'U2, reassoc_of% hF2U2, hFrk U]
    have c2 : fU ≫ F2U = FEU U ≫ fU := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, hF2U1, reassoc_of% hfU1, hf2, hfU1, reassoc_of% (hFEU1 U)]
      · simp only [Category.assoc, hF2U2, reassoc_of% hfU2, hfU2, hE3 U]
    obtain ⟨gU, ⟨hgU1, hgU2⟩, -⟩ := L U (Limits.pullback πY' U.1.ι) (Limits.pullback.snd πY' U.1.ι)
      (Limits.pullback πE' (aU U)) (Limits.pullback.snd πE' (aU U)) j'U F2U inferInstance
      hj'U2 hF2U2 c1 fU hfU2 c2
    refine ⟨gU ≫ Limits.pullback.fst πY' U.1.ι, ?_, ?_⟩
    · simp only [Category.assoc, Limits.pullback.condition, reassoc_of% hgU1]
    · simp only [reassoc_of% hgU2, hj'U1, reassoc_of% hfU1]
  choose hU hU1 hU2 using locex
  have hUφ : ∀ U U' h, φ U U' h ≫ hU U' = hU U := by
    intro U U' h
    rw [← cancel_epi (jU U), reassoc_of% (hφj U U' h)]
    simp only [hU2, reassoc_of% (hr1 U U' h)]
  have isoC : ∀ (U U' : T'.affineOpens) (h : U ≤ U'),
      Limits.pullback.map πY U.1.ι πY U'.1.ι (𝟙 _) (T'.homOfLE h) (𝟙 _) (by simp) (by simp) ≫
        (hι U').isoPullback.inv = (hι U).isoPullback.inv ≫ φ U U' h := by
    intro U U' h
    apply (hι U').hom_ext
    · rw [Category.assoc, IsPullback.isoPullback_inv_fst, Category.assoc, hιφ,
        IsPullback.isoPullback_inv_fst]
      exact (mapfs Y πY U U' h).1
    · rw [Category.assoc, IsPullback.isoPullback_inv_snd, Category.assoc, (hφpb U U' h).w,
        ← Category.assoc, IsPullback.isoPullback_inv_snd]
      exact (mapfs Y πY U U' h).2
  obtain ⟨g, hg⟩ := glue Y Y' πY (fun U => (hι U).isoPullback.inv ≫ hU U) (by
    intro U U' h
    show _ ≫ (hι U').isoPullback.inv ≫ hU U' = (hι U).isoPullback.inv ≫ hU U
    rw [← Category.assoc, isoC, Category.assoc, hUφ])
  have hg' : ∀ U, Limits.pullback.fst πY U.1.ι ≫ g = (hι U).isoPullback.inv ≫ hU U := hg
  have hιg : ∀ U, ι U ≫ g = hU U := by
    intro U
    rw [← (hι U).isoPullback_hom_fst, Category.assoc, hg', Iso.hom_inv_id_assoc]
  have hgπ : g ≫ πY' = πY := by
    apply ext Y T' πY
    intro U
    rw [reassoc_of% (hg' U), hU1, reassoc_of% (hsnd U), Limits.pullback.condition]
  have hjg : j ≫ g = f ≫ j' := by
    apply ext E Y' (πE ≫ k)
    intro U
    rw [reassoc_of% (hj' U), hιg, hU2]
  exact ⟨g, ⟨hgπ, hjg⟩, fun g' hg'' => (cancel_epi j).mp (hg''.2.trans hjg.symm)⟩

theorem wc_wd_P1_chart : ∀ (K : Type u) [Field K] [Finite K] (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))) (Uo : (wcP1Over K).left.Opens) (Ub : (wcGeomPoint K (wcP1Over K) hP).left.Opens), (∀ y, y ∈ Ub ↔ (wcGeomPoint K (wcP1Over K) hP).hom y ∈ Uo) → ∀ (FrU : Ub.toScheme ⟶ Ub.toScheme), FrU ≫ Ub.ι = Ub.ι ≫ (wcGeomFrob K (wcP1Over K) hP).left → ∃ (u : Ub.toScheme ⟶ Uo.toScheme) (FrU' : Ub.toScheme ⟶ Ub.toScheme), u ≫ Uo.ι = Ub.ι ≫ (wcGeomPoint K (wcP1Over K) hP).hom ∧ FrU ≫ FrU' = 𝟙 _ ∧ FrU' ≫ FrU = 𝟙 _ ∧ FrU ≫ u = u ∧ Flat u ∧ Surjective u ∧ QuasiCompact u ∧ ∀ V : Uo.toScheme.affineOpens, ∃ (A : Type u) (_ : CommRing A) (_ : Algebra K A) (_ : Algebra.FiniteType K A) (iV : Spec (.of (TensorProduct K A (AlgebraicClosure K))) ⟶ Ub.toScheme) (eV : Spec (.of A) ≅ (V.1 : Scheme.{u})), IsPullback iV (Spec.map (CommRingCat.ofHom (algebraMap A (TensorProduct K A (AlgebraicClosure K)))) ≫ eV.hom) u V.1.ι ∧ Spec.map (CommRingCat.ofHom (wcWdTau K A).toRingHom) ≫ iV = iV ≫ FrU :=
by
  intro K _ _ hP
  classical

  have hFrfst : (wcGeomFrob K (wcP1Over K) hP).left ≫
      Limits.pullback.fst (wcP1Over K).hom (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
      Limits.pullback.fst (wcP1Over K).hom (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :=
    (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
  have hFr_snd : (wcGeomFrob K (wcP1Over K) hP).left ≫
      Limits.pullback.snd (wcP1Over K).hom (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
      Limits.pullback.snd (wcP1Over K).hom (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ≫
        Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
          (AlgebraicClosure K) _ _ _).symm : AlgebraicClosure K →+* AlgebraicClosure K)) :=
    Limits.pullback.lift_snd _ _ _

  have hιflat : Flat (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) := by
    rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom]
    exact RingHom.flat_algebraMap_iff.mpr inferInstance
  have hιsurj : Surjective (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) := by
    rw [surjective_iff]
    intro y
    refine ⟨IsLocalRing.closedPoint (AlgebraicClosure K), ?_⟩
    have hss : ∀ a b : PrimeSpectrum K, a = b := fun a b =>
      PrimeSpectrum.ext ((Ideal.eq_bot_of_prime _).trans (Ideal.eq_bot_of_prime _).symm)
    exact hss _ _
  have hιqc : QuasiCompact (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :=
    inferInstance
  have hpb0 := IsPullback.of_hasPullback (wcP1Over K).hom
    (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
  have hpflat : Flat (Limits.pullback.fst (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
    MorphismProperty.of_isPullback (P := @Flat) hpb0.flip hιflat
  have hpsurj : Surjective (Limits.pullback.fst (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
    MorphismProperty.of_isPullback (P := @Surjective) hpb0.flip hιsurj
  have hpqc : QuasiCompact (Limits.pullback.fst (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
    MorphismProperty.of_isPullback (P := @QuasiCompact) hpb0.flip hιqc

  have hw' : Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) ≫ 𝟙 _ =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
          (AlgebraicClosure K) _ _ _) : AlgebraicClosure K →+* AlgebraicClosure K)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) := by
    rw [Category.comp_id, ← Spec.map_comp]
    congr 1
    ext x
    exact ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
          (AlgebraicClosure K) _ _ _).commutes x).symm
  obtain ⟨Fr', hFr'fst, hFr'snd⟩ : ∃ Fr' : Limits.pullback (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ⟶
      Limits.pullback (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))),
      Fr' ≫ Limits.pullback.fst (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
        Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ∧
      Fr' ≫ Limits.pullback.snd (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
        Limits.pullback.snd (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ≫
          Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _
            (Fintype.ofFinite K) (AlgebraicClosure K) _ _ _) : AlgebraicClosure K →+* AlgebraicClosure K)) :=
    ⟨Limits.pullback.map _ _ _ _ (𝟙 _) _ (𝟙 _) (by simp) hw',
      (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _), Limits.pullback.lift_snd _ _ _⟩
  have hσe : Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _
        (Fintype.ofFinite K) (AlgebraicClosure K) _ _ _).symm : AlgebraicClosure K →+* AlgebraicClosure K)) ≫
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _
        (Fintype.ofFinite K) (AlgebraicClosure K) _ _ _) : AlgebraicClosure K →+* AlgebraicClosure K)) = 𝟙 _ := by
    rw [← Spec.map_comp, ← Spec.map_id]
