      _ = ((((wcProEtPush ι).obj (wcFreeSheaf X' ((wcProEtPullback ι).obj V'))).obj.map
            f.op).hom (((toSheafify (Scheme.ProEt.topology Y') ((wcProEtBaseChange ι).op ⋙
              (wcFreeSheaf X' ((wcProEtPullback ι).obj V')).obj)).app (Opposite.op V')).hom
              (wcFreeGen X' ((wcProEtPullback ι).obj V')))) := by rw [hc V']
      _ = ((toSheafify (Scheme.ProEt.topology Y') ((wcProEtBaseChange ι).op ⋙
              (wcFreeSheaf X' ((wcProEtPullback ι).obj V')).obj)).app (Opposite.op V)).hom
            ((((wcProEtBaseChange ι).op ⋙
              (wcFreeSheaf X' ((wcProEtPullback ι).obj V')).obj).map f.op).hom
              (wcFreeGen X' ((wcProEtPullback ι).obj V'))) := hnat2.symm
      _ = ((toSheafify (Scheme.ProEt.topology Y') ((wcProEtBaseChange ι).op ⋙
              (wcFreeSheaf X' ((wcProEtPullback ι).obj V')).obj)).app (Opposite.op V)).hom
            (((wcFreeSheaf X' ((wcProEtPullback ι).obj V')).obj.map
              ((wcProEtPullback ι).map f).op).hom
              (wcFreeGen X' ((wcProEtPullback ι).obj V'))) := rfl
      _ = ((toSheafify (Scheme.ProEt.topology Y') ((wcProEtBaseChange ι).op ⋙
              (wcFreeSheaf X' ((wcProEtPullback ι).obj V')).obj)).app (Opposite.op V)).hom
            (((wcFreeSheafMap X' ((wcProEtPullback ι).map f)).hom.app
              (Opposite.op ((wcProEtPullback ι).obj V))).hom
              (wcFreeGen X' ((wcProEtPullback ι).obj V))) := by
