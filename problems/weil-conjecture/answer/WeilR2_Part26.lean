theorem wc_clc_weil_descent : ∀ (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (Uo : (wcP1Over K).left.Opens) (Ub : (wcGeomPoint K (wcP1Over K) hP).left.Opens),
    (∀ y, y ∈ Ub ↔ (wcGeomPoint K (wcP1Over K) hP).hom y ∈ Uo) →
    ∀ (FrU : Ub.toScheme ⟶ Ub.toScheme),
    FrU ≫ Ub.ι = Ub.ι ≫ (wcGeomFrob K (wcP1Over K) hP).left →
    ∀ (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme) (FE FE' : E ⟶ E), IsFinite πE → Etale πE →
    FE ≫ FE' = 𝟙 E → FE' ≫ FE = 𝟙 E → FE ≫ πE = πE ≫ FrU →
    ∃ (Y : Scheme.{u}) (πY : Y ⟶ Uo.toScheme) (j : E ⟶ Y) (u : Ub.toScheme ⟶ Uo.toScheme),
      u ≫ Uo.ι = Ub.ι ≫ (wcGeomPoint K (wcP1Over K) hP).hom ∧
      IsFinite πY ∧ Etale πY ∧ IsPullback j πE πY u ∧ Surjective j ∧ FE ≫ j = j ∧
      ∀ f : E ⟶ E, f ≫ πE = πE → f ≫ FE = FE ≫ f →
        ∃! g : Y ⟶ Y, g ≫ πY = πY ∧ j ≫ g = f ≫ j :=
by
  intro K _ _ hP Uo Ub hUb FrU hFrU E πE FE FE' hfin het h1 h2 hπ
  obtain ⟨uu, FrU', hu, hF1, hF2, hFu, hflat, hsurj, hqc, hchart⟩ :=
    wc_wd_P1_chart K hP Uo Ub hUb FrU hFrU
  have hloc : ∀ V : Uo.toScheme.affineOpens, ∃ (TV T'V : Scheme) (kV : TV ⟶ T'V)
      (eV : T'V ≅ (V.1 : Scheme)) (iV : TV ⟶ Ub.toScheme) (FrV : TV ⟶ TV),
      IsPullback iV (kV ≫ eV.hom) uu V.1.ι ∧ FrV ≫ iV = iV ≫ FrU ∧ wcWdHasDescent kV FrV := by
    intro V
    obtain ⟨A, _, _, _, iV, eV, hpb, hfr⟩ := hchart V
    exact ⟨_, _, _, eV, iV, _, hpb, hfr, wc_wd_affine_case wc_wd_ring_core K A⟩
  have hdesc := wc_wd_zariski_globalize Ub.toScheme Uo.toScheme uu FrU FrU' hF1 hF2 hFu
    hflat hsurj hqc hloc
  obtain ⟨Y, πY, j, hYfin, hYet, hpb, hjs, hFj, hfun⟩ := hdesc E πE FE FE' hfin het h1 h2 hπ
  refine ⟨Y, πY, j, uu, hu, hYfin, hYet, hpb, hjs, hFj, ?_⟩
  intro f hf1 hf2
  haveI := hYfin
  exact hfun Y πY E πE j FE inferInstance hpb.w hπ hFj f hf1 hf2

theorem wc_clc_twisted_power : ∀ (U' : Scheme.{u}) (E : Scheme.{u}) (πE : E ⟶ U') (FrU : U' ⟶ U')
    (Q : Type) [Group Q] [Finite Q] (H : Subgroup Q) (P : Q) (M : ℕ) [NeZero M], P ^ M = 1 →
    (∀ η ∈ H, P * η * P⁻¹ ∈ H) → (∀ η ∈ H, P⁻¹ * η * P ∈ H) →
    ∀ (τ : H → (E ⟶ E)) (FH FH' : E ⟶ E), IsFinite πE → Etale πE → Surjective πE →
    ConnectedSpace E → τ 1 = 𝟙 E → (∀ η η', τ η ≫ τ η' = τ (η' * η)) → (∀ η, τ η ≫ πE = πE) →
    (∀ (T : Scheme.{u}), ConnectedSpace T → ∀ (a b : T ⟶ E), a ≫ πE = b ≫ πE →
      ∃! η, b = a ≫ τ η) →
    FH ≫ FH' = 𝟙 E → FH' ≫ FH = 𝟙 E → FH ≫ πE = πE ≫ FrU →
    (∀ η η' : H, (η' : Q) = P * η * P⁻¹ → τ η ≫ FH = FH ≫ τ η') →
    ∀ (G : Subgroup (Multiplicative (ZMod M) × Q)),
    (∀ y, y ∈ G ↔ ∃ (b : ℤ) (h : Q), h ∈ H ∧ y.1 = Multiplicative.ofAdd (b : ZMod M) ∧
      y.2 = P ^ (-b) * h) →
    ∃ (E'' : Scheme.{u}) (π'' : E'' ⟶ U') (in₀ : E ⟶ E'') (F'' F''' : E'' ⟶ E'')
      (act' : G → (E'' ⟶ E'')),
      IsFinite π'' ∧ Etale π'' ∧ in₀ ≫ π'' = πE ∧ F'' ≫ F''' = 𝟙 _ ∧ F''' ≫ F'' = 𝟙 _ ∧
      F'' ≫ π'' = π'' ≫ FrU ∧
      act' 1 = 𝟙 _ ∧ (∀ g g', act' (g * g') = act' g ≫ act' g') ∧ (∀ g, act' g ≫ π'' = π'') ∧
      (∀ g, act' g ≫ F'' = F'' ≫ act' g) ∧
      (∀ (T : Scheme.{u}), ConnectedSpace T → ∀ (a b : T ⟶ E''), a ≫ π'' = b ≫ π'' →
        ∃! g, b = a ≫ act' g) ∧
      (∀ C : Set E'', IsClopen C → F'' ⁻¹' C = C → C = ∅ ∨ C = Set.univ) ∧
      ∃ ε : ℤ, (ε = 1 ∨ ε = -1) ∧ ∀ (d : ℕ) (η : H), ∃ y : G,
        (y : Multiplicative (ZMod M) × Q).1 = Multiplicative.ofAdd (((ε * d : ℤ)) : ZMod M) ∧
