        (M2 : Limits.pullback (Limits.pullback.snd W.hom f) g ⟶
          Limits.pullback (Limits.pullback.snd W'.hom f) g),
        L ≫ Limits.pullback.fst W'.hom (g ≫ f) = Limits.pullback.fst W.hom (g ≫ f) ≫ u.left →
        L ≫ Limits.pullback.snd W'.hom (g ≫ f) = Limits.pullback.snd W.hom (g ≫ f) →
        M1 ≫ Limits.pullback.fst W'.hom f = Limits.pullback.fst W.hom f ≫ u.left →
        M1 ≫ Limits.pullback.snd W'.hom f = Limits.pullback.snd W.hom f →
        M2 ≫ Limits.pullback.fst (Limits.pullback.snd W'.hom f) g =
          Limits.pullback.fst (Limits.pullback.snd W.hom f) g ≫ M1 →
        M2 ≫ Limits.pullback.snd (Limits.pullback.snd W'.hom f) g =
          Limits.pullback.snd (Limits.pullback.snd W.hom f) g →
        L ≫ (Limits.pullbackLeftPullbackSndIso W'.hom f g).inv =
          (Limits.pullbackLeftPullbackSndIso W.hom f g).inv ≫ M2 := by
      intro L M1 M2 hL1 hL2 hM1 _ hM2 hM2'
      rw [Iso.comp_inv_eq, Category.assoc, Iso.eq_inv_comp]
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hL1, Category.assoc, Limits.pullbackLeftPullbackSndIso_hom_fst,
          reassoc_of% hM2, hM1, reassoc_of% (Limits.pullbackLeftPullbackSndIso_hom_fst W.hom f g)]
      · rw [Category.assoc, hL2, Limits.pullbackLeftPullbackSndIso_hom_snd, Category.assoc,
          Limits.pullbackLeftPullbackSndIso_hom_snd, hM2']
    apply MorphismProperty.Over.Hom.ext
    change ((wcProEtBC (g ≫ f)).map u).left ≫ (c W').hom.left =
      (c W).hom.left ≫ ((wcProEtBC g).map ((wcProEtBC f).map u)).left
    rw [hc W, hc W']
    exact key _ _ _ (hmap (g ≫ f) u).1 (hmap (g ≫ f) u).2 (hmap f u).1 (hmap f u).2
      (hmap g ((wcProEtBC f).map u)).1 (hmap g ((wcProEtBC f).map u)).2
  let α : wcProEtBC (g ≫ f) ≅ wcProEtBC f ⋙ wcProEtBC g := NatIso.ofComponents c nat
  have hα : ∀ (W : S.ProEt) (z : ↥((wcProEtBC (g ≫ f)).obj W).left),
      (Limits.pullback.fst W.hom f) ((Limits.pullback.fst (Limits.pullback.snd W.hom f) g)
        ((α.hom.app W).left z)) = (Limits.pullback.fst W.hom (g ≫ f)) z := by
    intro W z
    change (Limits.pullback.fst W.hom f) ((Limits.pullback.fst (Limits.pullback.snd W.hom f) g)
      ((c W).hom.left z)) = _
    rw [hc W]
    have key : ∀ z' : ↥(Limits.pullback W.hom (g ≫ f)),
        (Limits.pullback.fst W.hom f) ((Limits.pullback.fst (Limits.pullback.snd W.hom f) g)
          ((Limits.pullbackLeftPullbackSndIso W.hom f g).inv z')) =
        (Limits.pullback.fst W.hom (g ≫ f)) z' := by
      intro z'
      calc (Limits.pullback.fst W.hom f) ((Limits.pullback.fst (Limits.pullback.snd W.hom f) g)
            ((Limits.pullbackLeftPullbackSndIso W.hom f g).inv z'))
          = ((Limits.pullbackLeftPullbackSndIso W.hom f g).inv ≫
              Limits.pullback.fst (Limits.pullback.snd W.hom f) g ≫
                Limits.pullback.fst W.hom f) z' := rfl
        _ = (Limits.pullback.fst W.hom (g ≫ f)) z' := by
          rw [Limits.pullbackLeftPullbackSndIso_inv_fst]
    exact key z
  haveI := Df.cont
  haveI := Dg.cont
  haveI := Dk.cont
  haveI : (wcProEtBC f ⋙ wcProEtBC g).IsContinuous (Scheme.ProEt.topology S)
      (Scheme.ProEt.topology S'') :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology S') _
  let τ := (Functor.sheafPushforwardContinuousNatTrans α.hom RingCat.{u+1}
    (Scheme.ProEt.topology S) (Scheme.ProEt.topology S'')).app (wcIntRingSheaf S'' ℓ)
  let φfg : wcIntRingSheaf S ℓ ⟶ ((wcProEtBC f ⋙ wcProEtBC g).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.ProEt.topology S) (Scheme.ProEt.topology S'')).obj
        (wcIntRingSheaf S'' ℓ) :=
    Df.φ ≫ ((wcProEtBC f).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).map Dg.φ
  have hcompat : φfg ≫ τ = Dk.φ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext W
    induction W using Opposite.rec with
    | op W =>
    apply RingCat.hom_ext
    apply RingHom.ext
    intro s
    rw [hDk W s]
    apply ContinuousMap.ext
    intro z
    refine (congrArg (fun h : C(↥(Limits.pullback (Limits.pullback.snd W.hom f) g),
        ULift.{u+1} ℤ_[ℓ]) => h ((α.hom.app W).left.base z))
      (hDg ((wcProEtBC f).obj W) ((Df.φ.hom.app (Opposite.op W)).hom s :
        C(↥(Limits.pullback W.hom f), ULift.{u+1} ℤ_[ℓ])))).trans ?_
    refine (congrArg (fun h : C(↥(Limits.pullback W.hom f), ULift.{u+1} ℤ_[ℓ]) =>
        h ((Limits.pullback.fst (Limits.pullback.snd W.hom f) g).base
          ((α.hom.app W).left.base z))) (hDf W s)).trans ?_
    let s' : C(↥W.left, ULift.{u+1} ℤ_[ℓ]) := s
    exact congrArg (fun p => s' p) (hα W z)
  let ιc : SheafOfModules.pushforward Dg.φ ⋙ SheafOfModules.pushforward Df.φ ≅
      SheafOfModules.pushforward Dk.φ :=
    SheafOfModules.pushforwardComp Df.φ Dg.φ ≪≫
      SheafOfModules.pushforwardNatIso φfg α ≪≫ SheafOfModules.pushforwardCongr hcompat
  have θ : Dk.Φ ≅ Df.Φ ⋙ Dg.Φ := Dk.adj.leftAdjointUniq ((Df.adj.comp Dg.adj).ofNatIsoRight ιc)

  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S' ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S'' ℓ)) := HasExt.standard _
  haveI := Df.additive
  haveI := Df.presLim
  haveI := Df.presColim
  haveI := Dg.additive
  haveI := Dg.presLim
  haveI := Dg.presColim
  haveI := Dk.additive
  haveI := Dk.presLim
  haveI := Dk.presColim
  have h2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcIntRingSheaf S'' ℓ)} {a : ℕ}
      (f : A ⟶ B) (g : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add a) := by
    intro A B C' D' a f g z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcIntRingSheaf S'' ℓ)} {a : ℕ}
      (z : Abelian.Ext A B a) (f : B ⟶ C') (g : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero a) := by
    intro A B C' D' a z f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcIntRingSheaf S'' ℓ)} {a : ℕ}
      (f : A ⟶ B) (z : Abelian.Ext B C' a) (g : C' ⟶ D'),
      ((Abelian.Ext.mk₀ f).comp z (zero_add a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero a)) (zero_add a) := by
    intro A B C' D' a f z g
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _

  have central : ∀ (e : SheafOfModules.unit (wcIntRingSheaf S'' ℓ) ⟶
      SheafOfModules.unit (wcIntRingSheaf S'' ℓ)) (y : wcIntExt S'' ℓ n),
      (Abelian.Ext.mk₀ e).comp y (zero_add n) = y.comp (Abelian.Ext.mk₀ e) (add_zero n) := by
    intro e y
    have hcomm : ∀ (X : (S''.ProEt)ᵒᵖ) (a b : (wcIntRingSheaf S'' ℓ).obj.obj X), a * b = b * a := by
      intro X a b
      exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} ℤ_[ℓ]) _ a b
    have hext : ∃ m : 𝟭 (SheafOfModules.{u+1} (wcIntRingSheaf S'' ℓ)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcIntRingSheaf S'' ℓ)),
        m.app (SheafOfModules.unit (wcIntRingSheaf S'' ℓ)) = e := by
      let R := wcIntRingSheaf S'' ℓ
      let s := (SheafOfModules.unit R).unitHomEquiv e
      let σ : ∀ X : (S''.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
      have hσ : ∀ {X Y : (S''.ProEt)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
        fun f => PresheafOfModules.sections_property s f
      let L : ∀ (M : SheafOfModules.{u+1} R) (X : (S''.ProEt)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
        fun M X => ModuleCat.ofHom
          { toFun := fun x => σ X • x
            map_add' := fun x y => smul_add _ _ _
            map_smul' := fun r x => by
              simp only [RingHom.id_apply, smul_smul]
              rw [hcomm X] }
      let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
        ⟨PresheafOfModules.Hom.mk (L M) (by
          intro X Y f
          ext x
          show σ Y • (M.val.map f).hom x = (M.val.map f).hom (σ X • x)
          rw [PresheafOfModules.map_smul, hσ])⟩
      refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
      · intro M N g
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro X
        ext x
        show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
        exact ((g.val.app X).hom.map_smul _ _).symm
      · apply (SheafOfModules.unit R).unitHomEquiv.injective
        apply PresheafOfModules.sections_ext
        intro X
        rw [SheafOfModules.unitHomEquiv_apply_coe]
        show σ X • (1 : R.obj.obj X) = s.1 X
        rw [smul_eq_mul, mul_one]
    have hcen : ∀ (m : 𝟭 (SheafOfModules.{u+1} (wcIntRingSheaf S'' ℓ)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcIntRingSheaf S'' ℓ))) (z : wcIntExt S'' ℓ n),
        (Abelian.Ext.mk₀ (m.app (SheafOfModules.unit (wcIntRingSheaf S'' ℓ)))).comp z (zero_add n) =
          z.comp (Abelian.Ext.mk₀ (m.app (SheafOfModules.unit (wcIntRingSheaf S'' ℓ)))) (add_zero n) := by
      intro m z
      have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z m
      simp only [Abelian.Ext.id_mapExactFunctor] at h
      exact h.symm
    obtain ⟨m, hm⟩ := hext
    subst hm
    exact hcen m y
  have gen : ∀ {Y : SheafOfModules.{u+1} (wcIntRingSheaf S'' ℓ)} (y : Abelian.Ext Y Y n)
      (a a' : SheafOfModules.unit (wcIntRingSheaf S'' ℓ) ⟶ Y)
      (b b' : Y ⟶ SheafOfModules.unit (wcIntRingSheaf S'' ℓ)),
      a ≫ b = 𝟙 _ → b' ≫ a' = 𝟙 _ →
      (Abelian.Ext.mk₀ a).comp (y.comp (Abelian.Ext.mk₀ b) (add_zero n)) (zero_add n) =
        (Abelian.Ext.mk₀ a').comp (y.comp (Abelian.Ext.mk₀ b') (add_zero n)) (zero_add n) := by
    intro Y y a a' b b' hab hba
    have ea : (a ≫ b') ≫ a' = a := by rw [Category.assoc, hba, Category.comp_id]
    have eb : b' ≫ a' ≫ b = b := by rw [← Category.assoc, hba, Category.id_comp]
    have eE : (a ≫ b') ≫ (a' ≫ b) = 𝟙 _ := by rw [← Category.assoc, ea, hab]
    have hc : (Abelian.Ext.mk₀ (a ≫ b')).comp ((Abelian.Ext.mk₀ a').comp
          (y.comp (Abelian.Ext.mk₀ b') (add_zero n)) (zero_add n)) (zero_add n) =
        ((Abelian.Ext.mk₀ a').comp (y.comp (Abelian.Ext.mk₀ b') (add_zero n)) (zero_add n)).comp
          (Abelian.Ext.mk₀ (a ≫ b')) (add_zero n) :=
      central _ _
    have e1 : (Abelian.Ext.mk₀ a).comp (y.comp (Abelian.Ext.mk₀ b) (add_zero n)) (zero_add n) =
        ((Abelian.Ext.mk₀ (a ≫ b')).comp ((Abelian.Ext.mk₀ a').comp
          (y.comp (Abelian.Ext.mk₀ b') (add_zero n)) (zero_add n)) (zero_add n)).comp
          (Abelian.Ext.mk₀ (a' ≫ b)) (add_zero n) := by
      rw [h2, h4, h3, ea, eb]
    rw [e1, hc, h3, eE, Abelian.Ext.comp_mk₀_id]
  show (Abelian.Ext.mk₀ Dk.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dk.Φ x).comp
      (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero n)) (zero_add n) =
    (Abelian.Ext.mk₀ Dg.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dg.Φ
      ((Abelian.Ext.mk₀ Df.μ.inv).comp ((Abelian.Ext.mapExactFunctor Df.Φ x).comp
        (Abelian.Ext.mk₀ Df.μ.hom) (add_zero n)) (zero_add n))).comp
      (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero n)) (zero_add n)
  have nat' : (Abelian.Ext.mapExactFunctor Dk.Φ x).comp
      (Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcIntRingSheaf S ℓ)))) (add_zero n) =
      (Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcIntRingSheaf S ℓ)))).comp
        (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Dg.Φ) x) (zero_add n) :=
    Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x θ.hom
  have step1 : (Abelian.Ext.mapExactFunctor Dk.Φ x).comp (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero n) =
      ((Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcIntRingSheaf S ℓ)))).comp
        (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Dg.Φ) x) (zero_add n)).comp
        (Abelian.Ext.mk₀ (θ.inv.app (SheafOfModules.unit (wcIntRingSheaf S ℓ)) ≫ Dk.μ.hom))
        (add_zero n) := by
    rw [← nat', h3, Iso.hom_inv_id_app_assoc]
  have hL : (Abelian.Ext.mk₀ Dk.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dk.Φ x).comp
      (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero n)) (zero_add n) =
      (Abelian.Ext.mk₀ (Dk.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcIntRingSheaf S ℓ)))).comp
        ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Dg.Φ) x).comp
          (Abelian.Ext.mk₀ (θ.inv.app (SheafOfModules.unit (wcIntRingSheaf S ℓ)) ≫ Dk.μ.hom))
          (add_zero n)) (zero_add n) := by
    rw [step1, h4, h2]
  have hR : (Abelian.Ext.mk₀ Dg.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dg.Φ
      ((Abelian.Ext.mk₀ Df.μ.inv).comp ((Abelian.Ext.mapExactFunctor Df.Φ x).comp
        (Abelian.Ext.mk₀ Df.μ.hom) (add_zero n)) (zero_add n))).comp
      (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero n)) (zero_add n) =
      (Abelian.Ext.mk₀ (Dg.μ.inv ≫ Dg.Φ.map Df.μ.inv)).comp
        ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Dg.Φ) x).comp
          (Abelian.Ext.mk₀ (Dg.Φ.map Df.μ.hom ≫ Dg.μ.hom)) (add_zero n)) (zero_add n) := by
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, h4, h3, h2]
  rw [hL, hR]
  have hab : (Dk.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcIntRingSheaf S ℓ))) ≫
      (θ.inv.app (SheafOfModules.unit (wcIntRingSheaf S ℓ)) ≫ Dk.μ.hom) = 𝟙 _ := by
    rw [Category.assoc, Iso.hom_inv_id_app_assoc, Iso.inv_hom_id]
  have hba : (Dg.Φ.map Df.μ.hom ≫ Dg.μ.hom) ≫ (Dg.μ.inv ≫ Dg.Φ.map Df.μ.inv) =
      𝟙 (Dg.Φ.obj (Df.Φ.obj (SheafOfModules.unit (wcIntRingSheaf S ℓ)))) := by
    rw [Category.assoc, Iso.hom_inv_id_assoc, ← CategoryTheory.Functor.map_comp, Iso.hom_inv_id,
      CategoryTheory.Functor.map_id]
  exact gen _ _ _ _ _ hab hba

theorem wc_pcl_ref_point_iso (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    {Y : Scheme.{u}} (qb : Y ⟶ (wcP1Over K).left)
    (a : Y ⟶ Y) (ha : a ≫ qb = qb)
    (hY : WeaklyEtale (Limits.pullback.fst (wcPclYo K qb).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))) :
    ∃ e₀ : wcGeomPoint K (wcPclYo K qb) hY ≅
        (wcProEtPullback qb).obj (wcGeomPoint K (wcP1Over K) hP),
      e₀.hom ≫ (wcProEtPullback qb).map (wcGeomFrob K (wcP1Over K) hP) =
        wcGeomFrob K (wcPclYo K qb) hY ≫ e₀.hom ∧
      e₀.hom.left ≫ Limits.pullback.map (wcGeomPoint K (wcP1Over K) hP).hom qb
          (wcGeomPoint K (wcP1Over K) hP).hom qb (𝟙 _) a (𝟙 _) (by simp)
          (by rw [Category.comp_id, ha]) =
        wcPclAbar K qb a ha ≫ e₀.hom.left :=
by
  have key : ∀ (S Kk A B : Scheme.{u}) (σ : Kk ⟶ S) (φ : Kk ⟶ Kk) (a₀ : A ⟶ S) (b₀ : B ⟶ S)
      (f : B ⟶ A) (hf : f ≫ a₀ = b₀) (FrA : Limits.pullback a₀ σ ⟶ Limits.pullback a₀ σ)
      (FrB : Limits.pullback b₀ σ ⟶ Limits.pullback b₀ σ)
      (hA1 : FrA ≫ Limits.pullback.fst a₀ σ = Limits.pullback.fst a₀ σ)
      (_hA2 : FrA ≫ Limits.pullback.snd a₀ σ = Limits.pullback.snd a₀ σ ≫ φ)
      (hB1 : FrB ≫ Limits.pullback.fst b₀ σ = Limits.pullback.fst b₀ σ)
      (_hB2 : FrB ≫ Limits.pullback.snd b₀ σ = Limits.pullback.snd b₀ σ ≫ φ)
      (c : B ⟶ B) (hc : c ≫ f = f) (Ab : Limits.pullback b₀ σ ⟶ Limits.pullback b₀ σ)
      (hAb1 : Ab ≫ Limits.pullback.fst b₀ σ = Limits.pullback.fst b₀ σ ≫ c)
      (hAb2 : Ab ≫ Limits.pullback.snd b₀ σ = Limits.pullback.snd b₀ σ),
      ∃ ε : Limits.pullback b₀ σ ≅ Limits.pullback (Limits.pullback.fst a₀ σ) f,
        ε.hom ≫ Limits.pullback.snd (Limits.pullback.fst a₀ σ) f = Limits.pullback.fst b₀ σ ∧
        ε.hom ≫ Limits.pullback.lift (Limits.pullback.fst (Limits.pullback.fst a₀ σ) f ≫ FrA)
          (Limits.pullback.snd (Limits.pullback.fst a₀ σ) f)
          (by rw [Category.assoc, hA1]; exact Limits.pullback.condition) = FrB ≫ ε.hom ∧
        ε.hom ≫ Limits.pullback.map (Limits.pullback.fst a₀ σ) f (Limits.pullback.fst a₀ σ) f
          (𝟙 _) c (𝟙 _) (by simp) (by rw [Category.comp_id, hc]) = Ab ≫ ε.hom := by
    intro S Kk A B σ φ a₀ b₀ f hf FrA FrB hA1 hA2 hB1 hB2 c hc Ab hAb1 hAb2
    let E₁ : Limits.pullback b₀ σ ⟶ Limits.pullback a₀ σ :=
      Limits.pullback.lift (Limits.pullback.fst b₀ σ ≫ f) (Limits.pullback.snd b₀ σ)
        (by rw [Category.assoc, hf]; exact Limits.pullback.condition)
    have E₁f : E₁ ≫ Limits.pullback.fst a₀ σ = Limits.pullback.fst b₀ σ ≫ f :=
      Limits.pullback.lift_fst _ _ _
    have E₁s : E₁ ≫ Limits.pullback.snd a₀ σ = Limits.pullback.snd b₀ σ :=
      Limits.pullback.lift_snd _ _ _
    let E : Limits.pullback b₀ σ ⟶ Limits.pullback (Limits.pullback.fst a₀ σ) f :=
      Limits.pullback.lift E₁ (Limits.pullback.fst b₀ σ) E₁f
    have Ef : E ≫ Limits.pullback.fst (Limits.pullback.fst a₀ σ) f = E₁ :=
      Limits.pullback.lift_fst _ _ _
    have Es : E ≫ Limits.pullback.snd (Limits.pullback.fst a₀ σ) f = Limits.pullback.fst b₀ σ :=
      Limits.pullback.lift_snd _ _ _
    have hc' : Limits.pullback.snd (Limits.pullback.fst a₀ σ) f ≫ b₀ =
        (Limits.pullback.fst (Limits.pullback.fst a₀ σ) f ≫ Limits.pullback.snd a₀ σ) ≫ σ := by
      simp only [Category.assoc]
      rw [← Limits.pullback.condition, ← hf, Limits.pullback.condition_assoc]
    let E' : Limits.pullback (Limits.pullback.fst a₀ σ) f ⟶ Limits.pullback b₀ σ :=
      Limits.pullback.lift (Limits.pullback.snd (Limits.pullback.fst a₀ σ) f)
        (Limits.pullback.fst (Limits.pullback.fst a₀ σ) f ≫ Limits.pullback.snd a₀ σ) hc'
    have E'f : E' ≫ Limits.pullback.fst b₀ σ = Limits.pullback.snd (Limits.pullback.fst a₀ σ) f :=
      Limits.pullback.lift_fst _ _ _
    have E's : E' ≫ Limits.pullback.snd b₀ σ =
        Limits.pullback.fst (Limits.pullback.fst a₀ σ) f ≫ Limits.pullback.snd a₀ σ :=
      Limits.pullback.lift_snd _ _ _
    have h1 : E ≫ E' = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, E'f, Es, Category.id_comp]
      · rw [Category.assoc, E's, ← Category.assoc, Ef, E₁s, Category.id_comp]
    have h2 : E' ≫ E = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Ef, Category.id_comp]
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, E₁f, ← Category.assoc, E'f, ← Limits.pullback.condition]
        · rw [Category.assoc, E₁s, E's]
      · rw [Category.assoc, Es, E'f, Category.id_comp]
    have hE₁Fr : E₁ ≫ FrA = FrB ≫ E₁ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hA1, E₁f, Category.assoc, E₁f, ← Category.assoc, hB1]
      · rw [Category.assoc, hA2, ← Category.assoc, E₁s, Category.assoc, E₁s, hB2]
    have hE₁Ab : Ab ≫ E₁ = E₁ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, E₁f, ← Category.assoc, hAb1, Category.assoc, hc]
      · rw [Category.assoc, E₁s, hAb2]
    refine ⟨Iso.mk E E' h1 h2, Es, ?_, ?_⟩
    · show E ≫ _ = FrB ≫ E
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Ef, Category.assoc, Ef,
          hE₁Fr]
      · rw [Category.assoc, Limits.pullback.lift_snd, Es, Category.assoc, Es, hB1]
    · show E ≫ _ = Ab ≫ E
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, Category.comp_id, Ef, Category.assoc, Ef,
          hE₁Ab]
      · rw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc, Es, Category.assoc, Es,
          hAb1]
  obtain ⟨ε, hε1, hε2, hε3⟩ := key _ _ _ _
    (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
    (Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _
      (Fintype.ofFinite K) (AlgebraicClosure K) _ _ _).symm :
        AlgebraicClosure K →+* AlgebraicClosure K)))
    (wcP1Over K).hom (wcPclYo K qb).hom qb rfl
    (wcGeomFrob K (wcP1Over K) hP).left (wcGeomFrob K (wcPclYo K qb) hY).left
    (MorphismProperty.Over.w (wcGeomFrob K (wcP1Over K) hP)) (Limits.pullback.lift_snd _ _ _)
    (MorphismProperty.Over.w (wcGeomFrob K (wcPclYo K qb) hY)) (Limits.pullback.lift_snd _ _ _)
    a ha (wcPclAbar K qb a ha) (Limits.pullback.lift_fst _ _ _)
    ((Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _))
  refine ⟨MorphismProperty.Over.isoMk ε hε1, ?_, ?_⟩
  · apply MorphismProperty.Over.Hom.ext
    exact hε2
  · exact hε3

theorem wc_pcl_push_transfer_act_law (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {Y : Scheme.{u}} (qb : Y ⟶ (wcP1Over K).left) (hqb : IsFinite qb)
    (a : Y ⟶ Y) (ha : a ≫ qb = qb)
    (hY : WeaklyEtale (Limits.pullback.fst (wcPclYo K qb).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (L : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
    (adj : L ⊣ wcProEtPush qb) [L.Additive] [Limits.PreservesFiniteLimits L]
    [Limits.PreservesFiniteColimits L]
    (θ : ∀ V : (wcP1Over K).left.ProEt,
      L.obj (wcFreeSheaf (wcP1Over K).left V) ≅ wcFreeSheaf Y ((wcProEtPullback qb).obj V))
    (hθ : wcPushThetaNorm qb L adj θ)
    (La : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
    (adja : La ⊣ wcProEtPush a) [La.Additive] [Limits.PreservesFiniteLimits La]
    [Limits.PreservesFiniteColimits La]
    (θa : ∀ V : Y.ProEt, La.obj (wcFreeSheaf Y V) ≅ wcFreeSheaf Y ((wcProEtPullback a).obj V))
    (hθa : wcPushThetaNorm a La adja θa)
    (e₀ : wcGeomPoint K (wcPclYo K qb) hY ≅
      (wcProEtPullback qb).obj (wcGeomPoint K (wcP1Over K) hP))
    (hea : e₀.hom.left ≫ Limits.pullback.map (wcGeomPoint K (wcP1Over K) hP).hom qb
        (wcGeomPoint K (wcP1Over K) hP).hom qb (𝟙 _) a (𝟙 _) (by simp)
        (by rw [Category.comp_id, ha]) =
      wcPclAbar K qb a ha ≫ e₀.hom.left)
    (i : ℕ) :
    ∃ s : wcGeomPoint K (wcPclYo K qb) hY ⟶
        (wcProEtPullback a).obj (wcGeomPoint K (wcPclYo K qb) hY),
      s.left ≫ Limits.pullback.fst (wcGeomPoint K (wcPclYo K qb) hY).hom a = wcPclAbar K qb a ha ∧
      ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
          ((wcProEtPush qb).obj (wcIntSheaf Y ℓ)) i,
        wcPushTransfer qb (wcIntSheaf Y ℓ) L adj
            (wcFreeSheafMap Y e₀.hom ≫ (θ (wcGeomPoint K (wcP1Over K) hP)).inv) i
            (x.comp (Abelian.Ext.mk₀ (wcPclRhoA qb ℓ a ha)) (add_zero i)) =
          (Abelian.Ext.mk₀ (wcFreeSheafMap Y s)).comp
            (wcProEtRes a La adja θa ℤ_[ℓ] (wcGeomPoint K (wcPclYo K qb) hY) i
              (wcPushTransfer qb (wcIntSheaf Y ℓ) L adj
                (wcFreeSheafMap Y e₀.hom ≫ (θ (wcGeomPoint K (wcP1Over K) hP)).inv) i x))
            (zero_add i) :=
by
  classical

  have hsw : wcPclAbar K qb a ha ≫ (wcGeomPoint K (wcPclYo K qb) hY).hom =
      (wcGeomPoint K (wcPclYo K qb) hY).hom ≫ a := Limits.pullback.lift_fst _ _ _
  let s : wcGeomPoint K (wcPclYo K qb) hY ⟶
      (wcProEtPullback a).obj (wcGeomPoint K (wcPclYo K qb) hY) :=
    MorphismProperty.Over.homMk (Limits.pullback.lift (wcPclAbar K qb a ha)
      (wcGeomPoint K (wcPclYo K qb) hY).hom hsw) (Limits.pullback.lift_snd _ _ _) trivial
  have hs1 : s.left ≫ Limits.pullback.fst (wcGeomPoint K (wcPclYo K qb) hY).hom a =
      wcPclAbar K qb a ha := Limits.pullback.lift_fst _ _ _
  have hs2 : s ≫ (wcProEtPullback a).map e₀.hom ≫
      (wcPclM qb a ha).app (wcGeomPoint K (wcP1Over K) hP) = e₀.hom := by
    apply MorphismProperty.Over.Hom.ext
    have hw : e₀.hom.left ≫ Limits.pullback.snd (wcGeomPoint K (wcP1Over K) hP).hom qb =
        (wcGeomPoint K (wcPclYo K qb) hY).hom := MorphismProperty.Over.w e₀.hom
    show Limits.pullback.lift (wcPclAbar K qb a ha) (wcGeomPoint K (wcPclYo K qb) hY).hom hsw ≫
      Limits.pullback.lift (Limits.pullback.fst (wcGeomPoint K (wcPclYo K qb) hY).hom a ≫ e₀.hom.left)
        (Limits.pullback.snd (wcGeomPoint K (wcPclYo K qb) hY).hom a) _ ≫
      Limits.pullback.lift
        (Limits.pullback.fst (Limits.pullback.snd (wcGeomPoint K (wcP1Over K) hP).hom qb) a ≫
          Limits.pullback.fst (wcGeomPoint K (wcP1Over K) hP).hom qb)
        (Limits.pullback.snd (Limits.pullback.snd (wcGeomPoint K (wcP1Over K) hP).hom qb) a) _ =
      e₀.hom.left
    have h3' := (reassoc_of% hea) (Limits.pullback.fst (wcGeomPoint K (wcP1Over K) hP).hom qb)
    have h3 : e₀.hom.left ≫ Limits.pullback.fst (wcGeomPoint K (wcP1Over K) hP).hom qb =
        wcPclAbar K qb a ha ≫ e₀.hom.left ≫
          Limits.pullback.fst (wcGeomPoint K (wcP1Over K) hP).hom qb := by
      refine Eq.trans ?_ h3'
      exact congrArg (e₀.hom.left ≫ ·)
        ((Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)).symm
    apply Limits.pullback.hom_ext
    · repeat (first | rw [Category.assoc] | erw [Limits.pullback.lift_fst_assoc] |
        erw [Limits.pullback.lift_fst])
      refine Eq.trans ?_ h3.symm
      exact (Category.assoc _ _ _).symm.trans ((congrArg
        (· ≫ Limits.pullback.fst (wcGeomPoint K (wcP1Over K) hP).hom qb)
        ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ e₀.hom.left)
          (Limits.pullback.lift_fst _ _ _)))).trans (Category.assoc _ _ _))
    · repeat (first | rw [Category.assoc] | erw [Limits.pullback.lift_snd_assoc] |
        erw [Limits.pullback.lift_snd])
      first | done | exact hw.symm

  have s2 : ∀ (Xs : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (Ys : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (g : L.obj Xs ⟶ Ys),
      (adj.comp adja).homEquiv Xs Ys
          (((conjugateEquiv adj (adj.comp adja)).symm (wcPclGamma qb a ha)).app Xs ≫ g) =
        adj.homEquiv Xs Ys g ≫ (wcPclGamma qb a ha).app Ys := by
    intro Xs Ys g
    rw [Adjunction.homEquiv_unit, Adjunction.homEquiv_unit, Functor.map_comp, ← Category.assoc,
      ← unit_conjugateEquiv, Equiv.apply_symm_apply, Category.assoc,
      ← (wcPclGamma qb a ha).naturality g]
    rfl

  have s1 : ∀ {P B : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      {Q A : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}}
      (ψ : Q ⟶ L.obj P) (τ : Q ⟶ La.obj Q) (e : L.obj B ⟶ A) (κ : La.obj A ⟶ A) (ρ : B ⟶ B)
      (β : L ⋙ La ⟶ L),
      La.map e ≫ κ = β.app B ≫ L.map ρ ≫ e → τ ≫ La.map ψ ≫ β.app P = ψ →
      ∀ x : Abelian.Ext P B i,
        (Abelian.Ext.mk₀ ψ).comp ((Abelian.Ext.mapExactFunctor L
          (x.comp (Abelian.Ext.mk₀ ρ) (add_zero i))).comp (Abelian.Ext.mk₀ e) (add_zero i))
          (zero_add i) =
        (Abelian.Ext.mk₀ τ).comp ((Abelian.Ext.mapExactFunctor La ((Abelian.Ext.mk₀ ψ).comp
          ((Abelian.Ext.mapExactFunctor L x).comp (Abelian.Ext.mk₀ e) (add_zero i))
          (zero_add i))).comp (Abelian.Ext.mk₀ κ) (add_zero i)) (zero_add i) := by
    intro P B Q A ψ τ e κ ρ β h1 h2 x
    have hL : (Abelian.Ext.mapExactFunctor L (x.comp (Abelian.Ext.mk₀ ρ) (add_zero i))).comp
        (Abelian.Ext.mk₀ e) (add_zero i) =
        (Abelian.Ext.mapExactFunctor L x).comp (Abelian.Ext.mk₀ (L.map ρ ≫ e)) (add_zero i) := by
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.comp_assoc _ _ _ (add_zero i) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀]
    have hLa : (Abelian.Ext.mapExactFunctor La ((Abelian.Ext.mk₀ ψ).comp
          ((Abelian.Ext.mapExactFunctor L x).comp (Abelian.Ext.mk₀ e) (add_zero i))
          (zero_add i))).comp (Abelian.Ext.mk₀ κ) (add_zero i) =
        (Abelian.Ext.mk₀ (La.map ψ ≫ β.app P)).comp ((Abelian.Ext.mapExactFunctor L x).comp
          (Abelian.Ext.mk₀ (L.map ρ ≫ e)) (add_zero i)) (zero_add i) := by
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        ← Abelian.Ext.comp_mapExactFunctor,
        Abelian.Ext.comp_assoc _ _ _ (zero_add i) (add_zero i) (by omega),
        Abelian.Ext.comp_assoc _ _ _ (add_zero i) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, h1, ← Abelian.Ext.mk₀_comp_mk₀,
        ← Abelian.Ext.comp_assoc _ _ _ (add_zero i) (zero_add 0) (by omega),
        Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x β,
        Abelian.Ext.comp_assoc _ _ _ (zero_add i) (add_zero i) (by omega),
        ← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add i) (by omega),
        Abelian.Ext.mk₀_comp_mk₀]
    rw [hL, hLa, ← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add i) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, h2]

  have hEv : ∀ (S : Scheme.{u}) (W : S.ProEt) (Q : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
      Function.Bijective (fun g : wcFreeSheaf S W ⟶ Q =>
        (g.hom.app (Opposite.op W)).hom (wcFreeGen S W)) := by
    intro S W Q
    let P : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
    let γ : FreeAbelianGroup (ULift.{u+1} (W ⟶ W)) := FreeAbelianGroup.of (ULift.up (𝟙 W))
    have hext : ∀ {α B : Type (u+1)} [AddCommGroup B] (φ ψ : FreeAbelianGroup α →+ B),
        (∀ a, φ (FreeAbelianGroup.of a) = ψ (FreeAbelianGroup.of a)) → φ = ψ := by
      intro α B _ φ ψ h
      apply AddMonoidHom.ext
      intro z
      induction z using FreeAbelianGroup.induction_on with
      | zero => rw [map_zero, map_zero]
      | of a => exact h a
      | neg a ih => rw [map_neg, map_neg, ih]
      | add a b iha ihb => rw [map_add, map_add, iha, ihb]
    have hmap : ∀ (V V' : (S.ProEt)ᵒᵖ) (h : V ⟶ V') (a : ULift.{u+1} (V.unop ⟶ W)),
        (P.map h).hom (FreeAbelianGroup.of a) =
          (FreeAbelianGroup.of (ULift.up (h.unop ≫ a.down) : ULift.{u+1} (V'.unop ⟶ W)) :
            FreeAbelianGroup (ULift.{u+1} (V'.unop ⟶ W))) := by
      intro V V' h a
      exact FreeAbelianGroup.map_of_apply
        (f := fun g : ULift.{u+1} (V.unop ⟶ W) =>
          (ULift.up (h.unop ≫ g.down) : ULift.{u+1} (V'.unop ⟶ W))) a
    have hK : ∀ (η : P ⟶ Q.obj) (V : (S.ProEt)ᵒᵖ) (f : V.unop ⟶ W),
        (η.app V).hom (FreeAbelianGroup.of (ULift.up f : ULift.{u+1} (V.unop ⟶ W))) =
          (Q.obj.map f.op).hom ((η.app (Opposite.op W)).hom γ) := by
      intro η V f
      have e1 : (P.map f.op).hom γ =
          (FreeAbelianGroup.of (ULift.up f : ULift.{u+1} (V.unop ⟶ W)) :
            FreeAbelianGroup (ULift.{u+1} (V.unop ⟶ W))) := by
        refine (hmap (Opposite.op W) V f.op (ULift.up (𝟙 W))).trans ?_
        exact congrArg (fun g : V.unop ⟶ W =>
          (FreeAbelianGroup.of (ULift.up g : ULift.{u+1} (V.unop ⟶ W)) :
            FreeAbelianGroup (ULift.{u+1} (V.unop ⟶ W)))) (Category.comp_id f)
      have e2 := congrArg (fun φ => φ.hom γ) (η.naturality f.op)
      calc (η.app V).hom (FreeAbelianGroup.of (ULift.up f : ULift.{u+1} (V.unop ⟶ W)))
          = (η.app V).hom ((P.map f.op).hom γ) := congrArg (η.app V).hom e1.symm
        _ = (P.map f.op ≫ η.app V).hom γ := rfl
        _ = (η.app (Opposite.op W) ≫ Q.obj.map f.op).hom γ := e2
        _ = (Q.obj.map f.op).hom ((η.app (Opposite.op W)).hom γ) := rfl
    have hev : Function.Bijective (fun η : P ⟶ Q.obj => (η.app (Opposite.op W)).hom γ) := by
      constructor
      · intro η η' h
        simp only at h
        apply NatTrans.ext
        funext V
        apply AddCommGrpCat.hom_ext
        refine hext (α := ULift.{u+1} (V.unop ⟶ W)) _ _ (fun a => ?_)
        exact (hK η V a.down).trans
          ((congrArg (Q.obj.map a.down.op).hom h).trans (hK η' V a.down).symm)
      · intro x
        let F : ∀ V : (S.ProEt)ᵒᵖ, ULift.{u+1} (V.unop ⟶ W) → Q.obj.obj V :=
          fun V f => (Q.obj.map f.down.op).hom x
        refine ⟨{ app := fun V => AddCommGrpCat.ofHom (FreeAbelianGroup.lift (F V))
                  naturality := ?_ }, ?_⟩
        · intro V V' h
          apply AddCommGrpCat.hom_ext
          refine hext (α := ULift.{u+1} (V.unop ⟶ W)) _ _ (fun a => ?_)
          calc (P.map h ≫ AddCommGrpCat.ofHom (FreeAbelianGroup.lift (F V'))).hom
                (FreeAbelianGroup.of a)
              = FreeAbelianGroup.lift (F V') ((P.map h).hom (FreeAbelianGroup.of a)) := rfl
            _ = FreeAbelianGroup.lift (F V')
                  (FreeAbelianGroup.of (ULift.up (h.unop ≫ a.down) : ULift.{u+1} (V'.unop ⟶ W))) :=
                congrArg (FreeAbelianGroup.lift (F V')) (hmap V V' h a)
            _ = (Q.obj.map (h.unop ≫ a.down).op).hom x := FreeAbelianGroup.lift_apply_of _ _
            _ = (Q.obj.map h).hom ((Q.obj.map a.down.op).hom x) := by
                rw [op_comp, Quiver.Hom.op_unop, Functor.map_comp]
                rfl
            _ = (Q.obj.map h).hom (FreeAbelianGroup.lift (F V) (FreeAbelianGroup.of a)) :=
                congrArg (Q.obj.map h).hom (FreeAbelianGroup.lift_apply_of (F V) a).symm
            _ = (AddCommGrpCat.ofHom (FreeAbelianGroup.lift (F V)) ≫ Q.obj.map h).hom
                  (FreeAbelianGroup.of a) := rfl
        · show FreeAbelianGroup.lift (F (Opposite.op W)) γ = x
          refine (FreeAbelianGroup.lift_apply_of (F (Opposite.op W)) (ULift.up (𝟙 W))).trans ?_
          show (Q.obj.map (𝟙 W).op).hom x = x
          rw [op_id, CategoryTheory.Functor.map_id]
          rfl
    let sadj := sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}
    have hfac : ∀ g : (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj P ⟶ Q,
        (g.hom.app (Opposite.op W)).hom
            (((toSheafify (Scheme.ProEt.topology S) P).app (Opposite.op W)).hom γ) =
          (((sadj.homEquiv P Q) g).app (Opposite.op W)).hom γ := by
      intro g
      rw [Adjunction.homEquiv_unit, sheafificationAdjunction_unit_app]
      rfl
    have e : (fun g : wcFreeSheaf S W ⟶ Q => (g.hom.app (Opposite.op W)).hom (wcFreeGen S W)) =
        (fun η : P ⟶ Q.obj => (η.app (Opposite.op W)).hom γ) ∘ (sadj.homEquiv P Q) := by
      funext g
      exact hfac g
    rw [e]
    exact hev.comp (sadj.homEquiv P Q).bijective

  have hB : ∀ {S T : Scheme.{u}} (ι : T ⟶ S) {G H : Sheaf (Scheme.ProEt.topology T) AddCommGrpCat.{u+1}}
      (x : G ⟶ H) (W : S.ProEt) (s' : G.obj.obj (Opposite.op ((wcProEtBaseChange ι).obj W))),
      (((wcProEtPush ι).map x).hom.app (Opposite.op W)).hom
          (((toSheafify (Scheme.ProEt.topology S) ((wcProEtBaseChange ι).op ⋙ G.obj)).app
            (Opposite.op W)).hom s') =
        ((toSheafify (Scheme.ProEt.topology S) ((wcProEtBaseChange ι).op ⋙ H.obj)).app
            (Opposite.op W)).hom ((x.hom.app (Opposite.op ((wcProEtBaseChange ι).obj W))).hom s') := by
    intro S T ι G H x W s'
    exact (congrArg (fun φ => (φ.app (Opposite.op W)).hom s')
      (toSheafify_naturality (Scheme.ProEt.topology S)
        (Functor.whiskerLeft (wcProEtBaseChange ι).op x.hom))).symm

  have hA : ∀ (S : Scheme.{u}) {V V' : S.ProEt} (f : V ⟶ V'),
      ((wcFreeSheafMap S f).hom.app (Opposite.op V)).hom (wcFreeGen S V) =
        ((wcFreeSheaf S V').obj.map f.op).hom (wcFreeGen S V') := by
    intro S V V' f
    have h1 := congrArg (fun φ => (φ.app (Opposite.op V)).hom
        (FreeAbelianGroup.of (ULift.up (𝟙 V)) : FreeAbelianGroup (ULift.{u+1} (V ⟶ V))))
