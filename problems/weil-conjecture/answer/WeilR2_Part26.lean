theorem wc_iz_structure_maps (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ T : Scheme.{u},
      ∃ (ε : wcFreeSheaf T (Scheme.ProEt.mk (𝟙 T)) ⟶
          (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf T ℓ)).obj
            (SheafOfModules.unit (wcIntRingSheaf T ℓ)))
        (κ : (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf T ℓ)).obj
          (SheafOfModules.unit (wcIntRingSheaf T ℓ)) ≅ wcIntSheaf T ℓ),
        (∀ M : SheafOfModules.{u+1} (wcIntRingSheaf T ℓ),
          Function.Bijective (fun f : SheafOfModules.unit (wcIntRingSheaf T ℓ) ⟶ M =>
            ε ≫ (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf T ℓ)).map f)) ∧
        wcIzEpsNorm T ℓ ε ∧ wcIzKappaNorm T ℓ κ) ∧
    (∀ (S : Scheme.{u}) (U : S.ProEt)
        [(wcSliceFunctor S U).IsContinuous (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)],
      ∃ lam : (wcLpscG S U).obj (wcIntSheaf S ℓ) ≅ wcIntSheaf U.left ℓ,
        wcIzLamNorm S U ℓ lam) :=
by
  classical
  have corep : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
      (R : Sheaf J RingCat.{u+1}) (T : C) (hT : Limits.IsTerminal T),
      ∃ ε : (presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
          (SheafOfModules.toSheaf.{u+1} R).obj (SheafOfModules.unit R),
        (∀ M : SheafOfModules.{u+1} R, Function.Bijective
          (fun f : SheafOfModules.unit R ⟶ M => ε ≫ (SheafOfModules.toSheaf.{u+1} R).map f)) ∧
        (ε.hom.app (Opposite.op T)).hom
          (((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T)).hom (FreeAbelianGroup.of (ULift.up (𝟙 T)))) =
          (1 : R.obj.obj (Opposite.op T)) := by
    intro C _ J _ _ R T hT
    set P : Cᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free with hP
    let e : ∀ X : Cᵒᵖ, P.obj X := fun X => FreeAbelianGroup.of (ULift.up (hT.from X.unop))
    have hgen : ∀ (X : Cᵒᵖ) (x : ULift.{u+1} (X.unop ⟶ T)), x = ULift.up (hT.from X.unop) :=
      fun X x => ULift.ext _ _ (hT.hom_ext _ _)
    have hPmap : ∀ ⦃X Y : Cᵒᵖ⦄ (f : X ⟶ Y), P.map f (e X) = e Y := by
      intro X Y f
      exact (FreeAbelianGroup.map_of_apply _).trans (congrArg FreeAbelianGroup.of (hgen Y _))
    have huniq : ∀ (G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) (φ ψ : P ⟶ G),
        (∀ X : Cᵒᵖ, φ.app X (e X) = ψ.app X (e X)) → φ = ψ := by
      intro G φ ψ h
      apply NatTrans.ext
      funext X
      apply AddCommGrpCat.hom_ext
      apply FreeAbelianGroup.lift_ext
      intro x
      rw [hgen X x]
      exact h X
    let G0 : Cᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      (PresheafOfModules.toPresheaf R.obj).obj (PresheafOfModules.unit R.obj)
    let η : P ⟶ G0 :=
      { app := fun X => AddCommGrpCat.ofHom
          (FreeAbelianGroup.lift (β := G0.obj X) (fun _ => show G0.obj X from (1 : R.obj.obj X)))
        naturality := by
          intro X Y f
          apply AddCommGrpCat.hom_ext
          apply FreeAbelianGroup.lift_ext
          intro x
          show FreeAbelianGroup.lift _ (FreeAbelianGroup.map _ (FreeAbelianGroup.of x)) =
            (G0.map f).hom (FreeAbelianGroup.lift _ (FreeAbelianGroup.of x))
          rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
            FreeAbelianGroup.lift_apply_of]
          exact ((PresheafOfModules.presheaf_map_apply_coe (PresheafOfModules.unit R.obj) f _).trans
            (PresheafOfModules.unit_map_one R.obj f)).symm }
    have hη : ∀ X : Cᵒᵖ, η.app X (e X) = (1 : R.obj.obj X) := by
      intro X
      exact FreeAbelianGroup.lift_apply_of _ _
    let adj := sheafificationAdjunction J AddCommGrpCat.{u+1}
    obtain ⟨ε, hε⟩ : ∃ ε : (presheafToSheaf J AddCommGrpCat.{u+1}).obj P ⟶
        (SheafOfModules.toSheaf.{u+1} R).obj (SheafOfModules.unit R),
        adj.homEquiv _ _ ε = η := ⟨(adj.homEquiv _ _).symm η, Equiv.apply_symm_apply _ _⟩
    have hstar : toSheafify J P ≫ ε.hom = η := by
      refine Eq.trans ?_ hε
      rw [Adjunction.homEquiv_unit]
      exact congrArg (fun φ => φ ≫ ε.hom)
        (sheafificationAdjunction_unit_app J P).symm
    refine ⟨ε, fun M => ?_, ?_⟩
    swap
    · have h1 := congrArg (fun φ : P ⟶ G0 => (φ.app (Opposite.op T)).hom
        (FreeAbelianGroup.of (ULift.up (𝟙 T)) : P.obj (Opposite.op T))) hstar
      exact h1.trans (FreeAbelianGroup.lift_apply_of _ _)
    have key : ∀ f : SheafOfModules.unit R ⟶ M,
        adj.homEquiv P _ (ε ≫ (SheafOfModules.toSheaf R).map f) =
          η ≫ (PresheafOfModules.toPresheaf R.obj).map f.val := by
      intro f
