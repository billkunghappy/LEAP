            (α g⁻¹).hom (hα g⁻¹)).app (Opposite.op T)).hom x) := by
        intro x g
        show π (((lamP (MonoidAlgebra.single g 1)).app (Opposite.op T)).hom x) = _
        rw [hPact]
      simp only [e]
      exact hπb

theorem wc_cgev_P1_epsInv_torsion_cd (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (H : Sheaf (Scheme.smallEtaleTopology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (hH : ℓ • 𝟙 H = 0) :
    ∀ n, 3 ≤ n → ∀ x : wcCohG K (wcP1Over K) hP ((wcEpsInv _).obj H) n, x = 0 :=
by
  intro n hn x
  haveI hP1 : IsProper (wcP1Over K).hom := wc_proj_space_isProper K 1
  have hm : ((ℓ : ℕ) : AlgebraicClosure K) ≠ 0 := by
    intro hk
    have hk' : ((ℓ : ℕ) : K) = 0 := by
      apply (algebraMap K (AlgebraicClosure K)).injective
      rw [map_natCast, map_zero]
      exact hk
    haveI : Fintype K := Fintype.ofFinite K
    have hprime : Nat.Prime (ringChar K) := CharP.char_is_prime K (ringChar K)
    have h2 : ringChar K ∣ ℓ := (CharP.cast_eq_zero_iff K (ringChar K) _).mp hk'
    have h3 : ringChar K = ℓ := (Nat.prime_dvd_prime_iff_eq hprime (Fact.out : ℓ.Prime)).mp h2
    have h4 : ringChar K ∣ Nat.card K := by
      rw [Nat.card_eq_fintype_card]
      exact (CharP.cast_eq_zero_iff K (ringChar K) _).mp (FiniteField.cast_card_eq_zero K)
    exact hℓ (h3 ▸ h4)
  have key : ∀ (Yb : Scheme.{u}) (fY : Yb ⟶ Spec (.of (AlgebraicClosure K))) [IsProper fY]
      [SmoothOfRelativeDimension 1 fY] (G : Sheaf (Scheme.smallEtaleTopology Yb) AddCommGrpCat.{u+1}),
      ℓ • 𝟙 G = 0 →
      ∀ z : Abelian.Ext (wcFreeSheaf Yb (Scheme.ProEt.mk (𝟙 Yb))) ((wcEpsInv Yb).obj G) n, z = 0 := by
    intro Yb fY _ _ G hG z
    have hdim := wc_smooth_alg_closed_dim_le (AlgebraicClosure K) Yb fY 1
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Yb) AddCommGrpCat.{u+1}) := HasExt.standard _
    have het : ∀ ξ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Yb)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G n, ξ = 0 :=
      wc_et_cd_proper_torsion (AlgebraicClosure K) Yb fY 1 hdim ℓ hm G hG n (by omega)
    obtain ⟨E3⟩ := wc_proet_etale_comparison_epsInv (AlgebraicClosure K) Yb fY G n
    exact E3.injective ((het (E3 z)).trans (het (E3 0)).symm)
  have hPr : IsProper (Limits.pullback.snd (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) := inferInstance
  have hS : SmoothOfRelativeDimension 1 (Limits.pullback.snd (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @SmoothOfRelativeDimension 1)
      (IsPullback.of_hasPullback (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) (wc_p1_smooth_reldim_one K)
  obtain ⟨H', htor', E2⟩ := wc_ext_free_slice_epsInv_torsion (wcP1Over K).left
    (wcGeomPoint K (wcP1Over K) hP) ℓ H hH
  obtain ⟨E⟩ := E2 n
  have hY := @key (wcGeomPoint K (wcP1Over K) hP).left (Limits.pullback.snd (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) hPr hS H' htor'
  exact E.injective ((hY (E x)).trans (hY (E 0)).symm)

theorem wc_cgev_inj_truncation {𝒞 : Type*} [Category 𝒞] [Abelian 𝒞] [HasExt.{w} 𝒞] (P : 𝒞)
    (C : CochainComplex 𝒞 ℕ) (hinj : ∀ q, Injective (C.X q)) (h0 : Mono (C.d 0 1))
    (h2 : ∀ p, 2 ≤ p → C.ExactAt p)
    (hE : ∀ m, 3 ≤ m → ∀ x : Abelian.Ext P (C.homology 1) m, x = 0) :
    ∀ n, 3 ≤ n → ∀ f : P ⟶ C.X (n + 1), f ≫ C.d (n + 1) (n + 1 + 1) = 0 →
      ∃ g : P ⟶ C.X n, g ≫ C.d n (n + 1) = f :=
by
  have hw : ∀ q : ℕ, C.iCycles q ≫ C.toCycles q (q + 1) = 0 := by
    intro q
    rw [← cancel_mono (C.iCycles (q + 1)), Category.assoc, HomologicalComplex.toCycles_i,
      HomologicalComplex.iCycles_d, Limits.zero_comp]
  have hses : ∀ q : ℕ, C.ExactAt (q + 1) →
      (ShortComplex.mk (C.iCycles q) (C.toCycles q (q + 1)) (hw q)).ShortExact := by
    intro q hq
    have hexact : (ShortComplex.mk (C.iCycles q) (C.toCycles q (q + 1)) (hw q)).Exact := by
      apply ShortComplex.exact_of_f_is_kernel
      exact Limits.isKernelOfComp (C.iCycles (q + 1)) (C.d q (q + 1))
        (C.cyclesIsKernel q (q + 1) (CochainComplex.next ℕ q)) (hw q) (C.toCycles_i q (q + 1))
    have hepi : Epi (C.toCycles q (q + 1)) := by
      rw [HomologicalComplex.exactAt_iff' C q (q + 1) (q + 2) (CochainComplex.prev_nat_succ q)
        (CochainComplex.next ℕ (q + 1))] at hq
      rw [ShortComplex.exact_iff_epi_toCycles] at hq
      have h := HomologicalComplex.toCycles_cyclesIsoSc'_hom C q (q + 1) (q + 2)
        (CochainComplex.prev_nat_succ q) (CochainComplex.next ℕ (q + 1))
      have h' : Epi (C.toCycles q (q + 1) ≫ (C.cyclesIsoSc' q (q + 1) (q + 2)
          (CochainComplex.prev_nat_succ q) (CochainComplex.next ℕ (q + 1))).hom) := by
        rw [h]; exact hq
      exact (epi_comp_iff_of_isIso _ _).mp h'
    exact ShortComplex.ShortExact.mk' hexact inferInstance hepi
  have hS0 : (ShortComplex.mk (C.toCycles 0 1) (C.homologyπ 1)
      (C.toCycles_comp_homologyπ 0 1)).ShortExact := by
    have hmono : Mono (C.toCycles 0 1) := by
      have : Mono (C.toCycles 0 1 ≫ C.iCycles 1) := by
        rw [HomologicalComplex.toCycles_i]; exact h0
      exact mono_of_mono _ (C.iCycles 1)
    refine ShortComplex.ShortExact.mk' ?_ hmono inferInstance
    apply ShortComplex.exact_of_g_is_cokernel
    exact C.homologyIsCokernel 0 1 (CochainComplex.prev_nat_succ 0)
  have hvan : ∀ q k : ℕ, 3 ≤ k + q + 1 →
      ∀ x : Abelian.Ext P (C.cycles (q + 1)) (k + 1), x = 0 := by
    intro q
    induction q with
    | zero =>
      intro k hk x
      have h1 : x.comp (Abelian.Ext.mk₀ (C.homologyπ 1)) (add_zero _) = 0 :=
        hE (k + 1) (by omega) _
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS0 x h1
      have := hinj 0
      rw [← hx₁, Abelian.Ext.eq_zero_of_injective x₁, Abelian.Ext.zero_comp]
    | succ q ih =>
      intro k hk x
      have hSq := hses (q + 1) (h2 (q + 1 + 1) (by omega))
      have hy : x.comp hSq.extClass rfl = 0 := ih (k + 1) (by omega) _
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hSq x rfl hy
      have := hinj (q + 1)
      rw [← hx₂, Abelian.Ext.eq_zero_of_injective x₂, Abelian.Ext.zero_comp]
  intro n hn f hf
  obtain ⟨q, rfl⟩ : ∃ q, n = q + 1 := ⟨n - 1, by omega⟩
  have hSq := hses (q + 1) (h2 (q + 1 + 1) (by omega))
  have he : (Abelian.Ext.mk₀ (C.liftCycles f (q + 1 + 1 + 1) (CochainComplex.next ℕ _) hf)).comp
      hSq.extClass (zero_add 1) = 0 := hvan q 0 (by omega) _
  obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hSq _ (zero_add 1) he
  refine ⟨Abelian.Ext.homEquiv₀ x₂, ?_⟩
  have hx : Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ x₂ ≫ C.toCycles (q + 1) (q + 1 + 1)) =
      Abelian.Ext.mk₀ (C.liftCycles f (q + 1 + 1 + 1) (CochainComplex.next ℕ _) hf) := by
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply]
    exact hx₂
  have hg := (Abelian.Ext.mk₀_bijective _ _).1 hx
  rw [← C.toCycles_i, ← Category.assoc, hg, HomologicalComplex.liftCycles_i]

theorem wc_cgev_tot_qis {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {R : Type u} [Ring R] {A : 𝒜}
    (lamA : R → (A ⟶ A)) (hA : wcRingAct lamA) (I : InjectiveResolution A)
    (lamI : R → (I.cocomplex ⟶ I.cocomplex)) {N : ModuleCat.{u+1} R} (Rs : wcCgevRes N)
    (hdd : ∀ n, wcCgevTotD I lamI Rs n ≫ wcCgevTotD I lamI Rs (n + 1) = 0)
    (hcomm : ∀ n, wcCgevAugF I Rs n ≫ wcCgevTotD I lamI Rs n =
      (wcCgevK lamA hA Rs).d n (n + 1) ≫ wcCgevAugF I Rs (n + 1)) :
    QuasiIso (wcCgevAug lamA hA I lamI Rs hdd hcomm) :=
by
  classical
  haveI : Limits.HasFiniteBiproducts 𝒜 := Abelian.hasFiniteBiproducts
  obtain ⟨πT, hπT⟩ : ∃ πT : ∀ (n : ℕ) (x : Σ p : Fin (n + 1), Fin (Rs.a p)),
      wcCgevTotX I Rs n ⟶ I.cocomplex.X (n - x.1),
      ∀ n x, πT n x = Limits.biproduct.π
        (fun x : Σ p : Fin (n + 1), Fin (Rs.a p) => I.cocomplex.X (n - x.1)) x :=
    ⟨fun n x => Limits.biproduct.π
        (fun x : Σ p : Fin (n + 1), Fin (Rs.a p) => I.cocomplex.X (n - x.1)) x, fun n x => rfl⟩
  obtain ⟨ιT, hιT⟩ : ∃ ιT : ∀ (n : ℕ) (x : Σ p : Fin (n + 1), Fin (Rs.a p)),
      I.cocomplex.X (n - x.1) ⟶ wcCgevTotX I Rs n,
      ∀ n x, ιT n x = Limits.biproduct.ι
        (fun x : Σ p : Fin (n + 1), Fin (Rs.a p) => I.cocomplex.X (n - x.1)) x :=
    ⟨fun n x => Limits.biproduct.ι
        (fun x : Σ p : Fin (n + 1), Fin (Rs.a p) => I.cocomplex.X (n - x.1)) x, fun n x => rfl⟩
  have hext : ∀ (n : ℕ) {B : 𝒜} (f g : B ⟶ wcCgevTotX I Rs n),
      (∀ x, f ≫ πT n x = g ≫ πT n x) → f = g := by
    intro n B f g h
    apply Limits.biproduct.hom_ext
    intro x
    rw [← hπT]
    exact h x

  have CF : ∀ (n : ℕ) {B : 𝒜} (z : B ⟶ wcCgevTotX I Rs n) (y : Σ p : Fin (n + 1 + 1), Fin (Rs.a p)),
      z ≫ wcCgevTotD I lamI Rs n ≫ πT (n + 1) y =
      ∑ x : Σ p : Fin (n + 1), Fin (Rs.a p), (z ≫ πT n x) ≫ wcCgevTotEntry I lamI Rs n x y := by
    intro n B z y
    simp only [hπT]
    unfold wcCgevTotD
    erw [Limits.biproduct.matrix_π, Limits.biproduct.desc_eq, Preadditive.comp_sum]
    exact Finset.sum_congr rfl (fun x _ => (Category.assoc _ _ _).symm)
  have ιD : ∀ (n : ℕ) (x : Σ p : Fin (n + 1), Fin (Rs.a p)) (y : Σ p : Fin (n + 1 + 1), Fin (Rs.a p)),
      ιT n x ≫ wcCgevTotD I lamI Rs n ≫ πT (n + 1) y = wcCgevTotEntry I lamI Rs n x y := by
    intro n x y
    rw [hιT, hπT]
    unfold wcCgevTotD
    erw [← Category.assoc, Limits.biproduct.ι_matrix, Limits.biproduct.lift_π]
  have hdd' : ∀ (n : ℕ) {Z : 𝒜} (h : wcCgevTotX I Rs (n + 1 + 1) ⟶ Z),
      wcCgevTotD I lamI Rs n ≫ wcCgevTotD I lamI Rs (n + 1) ≫ h = 0 := by
    intro n Z h
    rw [← Category.assoc, hdd, Limits.zero_comp]
  have E0 : ∀ (n : ℕ) (x : Σ p : Fin (n + 1), Fin (Rs.a p)) (y : Σ p : Fin (n + 1 + 1), Fin (Rs.a p)),
      (y.1 : ℕ) ≠ x.1 → (y.1 : ℕ) ≠ x.1 + 1 → wcCgevTotEntry I lamI Rs n x y = 0 := by
    intro n x y h1 h2
    unfold wcCgevTotEntry
    rw [if_neg (fun h => h1 h.1), dif_neg h2]
  have E1 : ∀ (n : ℕ) (x : Σ p : Fin (n + 1), Fin (Rs.a p)) (y : Σ p : Fin (n + 1 + 1), Fin (Rs.a p)),
      (y.1 : ℕ) = x.1 → (y.2 : ℕ) ≠ x.2 → wcCgevTotEntry I lamI Rs n x y = 0 := by
    intro n x y h1 h2
    unfold wcCgevTotEntry
    rw [if_neg (fun h => h2 h.2), dif_neg (by omega)]
  have E2 : ∀ (n s : ℕ) (h1 : s < n + 1) (h2 : s < n + 1 + 1) (k : Fin (Rs.a s)),
      wcCgevTotEntry I lamI Rs n ⟨⟨s, h1⟩, k⟩ ⟨⟨s, h2⟩, k⟩ =
        ((-1 : ℤ) ^ s) • I.cocomplex.d (n - s) (n + 1 - s) := by
    intro n s h1 h2 k
    unfold wcCgevTotEntry
    rw [if_pos ⟨rfl, rfl⟩]
  have sgn : ∀ (s : ℕ) {X Y Z : 𝒜} (a : X ⟶ Y) (b : Y ⟶ Z),
      (((-1 : ℤ) ^ s) • a) ≫ (((-1 : ℤ) ^ s) • b) = a ≫ b := by
    intro s X Y Z a b
    rw [Preadditive.zsmul_comp, Preadditive.comp_zsmul, smul_smul]
    rcases neg_one_pow_eq_or ℤ s with h | h <;> rw [h] <;> simp

  have CYC : ∀ (n s : ℕ) (hs : s < n + 1) {B : 𝒜} (z : B ⟶ wcCgevTotX I Rs n),
      (∀ x : Σ p : Fin (n + 1), Fin (Rs.a p), (x.1 : ℕ) < s →
        z ≫ πT (n) x = 0) →
      (∀ y : Σ p : Fin (n + 1 + 1), Fin (Rs.a p), (y.1 : ℕ) = s →
        z ≫ wcCgevTotD I lamI Rs n ≫ πT (n + 1) y = 0) →
      ∀ k : Fin (Rs.a s), (z ≫ πT (n) ⟨⟨s, hs⟩, k⟩) ≫ I.cocomplex.d (n - s) (n + 1 - s) = 0 := by
    intro n s hs B z hlow hd k
    have h := hd ⟨⟨s, by omega⟩, k⟩ rfl
    rw [CF, Finset.sum_eq_single ⟨⟨s, hs⟩, k⟩] at h
    · rw [E2, Preadditive.comp_zsmul] at h
      rcases neg_one_pow_eq_or ℤ s with h1 | h1 <;> rw [h1] at h <;> simpa using h
    · intro b _ hne
      obtain ⟨⟨p, hp⟩, j⟩ := b
      rcases lt_trichotomy p s with hps | hps | hps
      · rw [hlow _ hps, Limits.zero_comp]
      · subst hps
        have hne' : ((⟨⟨p, by omega⟩, k⟩ : Σ p : Fin (n + 1 + 1), Fin (Rs.a p)).2 : ℕ) ≠
            ((⟨⟨p, hp⟩, j⟩ : Σ p : Fin (n + 1), Fin (Rs.a p)).2 : ℕ) := by
          intro hj
          exact hne (Sigma.ext rfl (heq_of_eq (Fin.ext hj.symm)))
        rw [E1 n _ _ rfl hne', Limits.comp_zero]
      · rw [E0, Limits.comp_zero]
        · show s ≠ p
          omega
        · show s ≠ p + 1
          omega
    · intro h'
      exact absurd (Finset.mem_univ _) h'

  have REF : ∀ (S : ShortComplex 𝒜), S.Exact → ∀ (r : ℕ) {B : 𝒜} (x : Fin r → (B ⟶ S.X₂)),
      (∀ k, x k ≫ S.g = 0) →
      ∃ (B' : 𝒜) (π : B' ⟶ B) (_ : Epi π) (v : Fin r → (B' ⟶ S.X₁)), ∀ k, π ≫ x k = v k ≫ S.f := by
    intro S hS r
    induction r with
    | zero => intro B x _; exact ⟨B, 𝟙 B, inferInstance, fun k => k.elim0, fun k => k.elim0⟩
    | succ r ih =>
      intro B x hx
      obtain ⟨B1, π1, hπ1, v1, hv1⟩ := ih (fun k => x k.castSucc) (fun k => hx _)
      obtain ⟨B2, π2, hπ2, w, hw⟩ := hS.exact_up_to_refinements (π1 ≫ x (Fin.last r))
        (by rw [Category.assoc, hx, Limits.comp_zero])
      refine ⟨B2, π2 ≫ π1, epi_comp _ _,
        Fin.lastCases (motive := fun _ => B2 ⟶ S.X₁) w (fun i => π2 ≫ v1 i), ?_⟩
      intro k
      induction k using Fin.lastCases with
      | last => rw [Fin.lastCases_last, Category.assoc, hw]
      | cast i => rw [Fin.lastCases_castSucc, Category.assoc, Category.assoc, hv1 i]

  have KILL : ∀ (m s : ℕ), s ≤ m → ∀ {B : 𝒜} (z : B ⟶ wcCgevTotX I Rs (m + 1)),
      (∀ x : Σ p : Fin (m + 1 + 1), Fin (Rs.a p), (x.1 : ℕ) < s →
        z ≫ πT (m + 1) x = 0) →
      (∀ y : Σ p : Fin (m + 1 + 1 + 1), Fin (Rs.a p), (y.1 : ℕ) = s →
        z ≫ wcCgevTotD I lamI Rs (m + 1) ≫ πT (m + 1 + 1) y = 0) →
      ∃ (B' : 𝒜) (q : B' ⟶ B) (_ : Epi q) (u : B' ⟶ wcCgevTotX I Rs m),
        ∀ x : Σ p : Fin (m + 1 + 1), Fin (Rs.a p), (x.1 : ℕ) ≤ s →
          (q ≫ z - u ≫ wcCgevTotD I lamI Rs m) ≫ πT (m + 1) x = 0 := by
    intro m s hs B z hlow hd
    have hc := CYC (m + 1) s (by omega) z hlow hd
    have e1 : m + 1 - s = m - s + 1 := by omega
    have e2 : m + 1 + 1 - s = m - s + 1 + 1 := by omega
    have hS : (I.cocomplex.sc' (m - s) (m - s + 1) (m - s + 1 + 1)).Exact :=
      (HomologicalComplex.exactAt_iff' I.cocomplex (m - s) (m - s + 1) (m - s + 1 + 1)
        (CochainComplex.prev_nat_succ _) (CochainComplex.next ℕ _)).mp
        (I.cocomplex_exactAt_succ _)
    obtain ⟨B', q, hq, v, hv⟩ := REF _ hS (Rs.a s)
      (fun k => (z ≫ πT (m + 1) ⟨⟨s, by omega⟩, k⟩) ≫ (I.cocomplex.XIsoOfEq e1).hom)
      (fun k => by
        show ((z ≫ _) ≫ (I.cocomplex.XIsoOfEq e1).hom) ≫
          I.cocomplex.d (m - s + 1) (m - s + 1 + 1) = 0
        rw [Category.assoc, HomologicalComplex.XIsoOfEq_hom_comp_d,
          ← HomologicalComplex.d_comp_XIsoOfEq_hom I.cocomplex e2, ← Category.assoc, hc k,
          Limits.zero_comp])
    obtain ⟨v', hv'⟩ : ∃ v' : Fin (Rs.a s) → (B' ⟶ I.cocomplex.X (m - s)), ∀ k,
        q ≫ ((z ≫ πT (m + 1) ⟨⟨s, by omega⟩, k⟩) ≫ (I.cocomplex.XIsoOfEq e1).hom) =
          v' k ≫ I.cocomplex.d (m - s) (m - s + 1) := ⟨v, hv⟩
    obtain ⟨u, hu⟩ : ∃ u : B' ⟶ wcCgevTotX I Rs m, u = ∑ k : Fin (Rs.a s),
        (((-1 : ℤ) ^ s) • v' k) ≫
          ιT (m)
            ⟨⟨s, by omega⟩, k⟩ := ⟨_, rfl⟩
    have uD : ∀ y : Σ p : Fin (m + 1 + 1), Fin (Rs.a p),
        u ≫ wcCgevTotD I lamI Rs m ≫ πT (m + 1) y =
        ∑ k : Fin (Rs.a s), (((-1 : ℤ) ^ s) • v' k) ≫
          wcCgevTotEntry I lamI Rs m ⟨⟨s, by omega⟩, k⟩ y := by
      intro y
      rw [hu, Preadditive.sum_comp]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      first
        | exact (Category.assoc _ _ _).trans (by rw [ιD])
        | (erw [Category.assoc, ιD])
        | simp only [Category.assoc, ιD]
    refine ⟨B', q, hq, u, ?_⟩
    intro x hx
    obtain ⟨⟨p, hp⟩, k'⟩ := x
    have hx' : p ≤ s := hx
    simp only [Preadditive.sub_comp, Category.assoc]
    rw [uD]
    rcases Nat.lt_or_ge p s with h | h
    · rw [hlow ⟨⟨p, hp⟩, k'⟩ h, Limits.comp_zero, Finset.sum_eq_zero, sub_zero]
      intro k _
      rw [E0]
      · exact Limits.comp_zero
      · show p ≠ s
        omega
      · show p ≠ s + 1
        omega
    · have hps : p = s := by omega
      subst hps
      rw [Finset.sum_eq_single k', E2 m _ _ hp k']
      first
        | erw [sgn]
        | simp only [Preadditive.zsmul_comp, Preadditive.comp_zsmul, smul_smul, ← pow_add,
            Even.neg_one_pow ⟨p, rfl⟩, one_smul]
      rw [sub_eq_zero]
      · apply (cancel_mono (I.cocomplex.XIsoOfEq e1).hom).mp
        rw [Category.assoc (v' k'), HomologicalComplex.d_comp_XIsoOfEq_hom]
        have h5 := hv' k'
        simp only [Category.assoc] at h5 ⊢
        exact h5
      · intro b _ hb
        rw [E1 m _ _ rfl (fun h => hb (Fin.ext h).symm)]
        exact Limits.comp_zero
      · intro h'
        exact absurd (Finset.mem_univ _) h'

  have STAIR : ∀ (m s : ℕ), s ≤ m + 1 → ∀ {B : 𝒜} (z : B ⟶ wcCgevTotX I Rs (m + 1)),
      (∀ y : Σ p : Fin (m + 1 + 1 + 1), Fin (Rs.a p), (y.1 : ℕ) ≤ m →
        z ≫ wcCgevTotD I lamI Rs (m + 1) ≫ πT (m + 1 + 1) y = 0) →
      ∃ (B' : 𝒜) (q : B' ⟶ B) (_ : Epi q) (u : B' ⟶ wcCgevTotX I Rs m),
        ∀ x : Σ p : Fin (m + 1 + 1), Fin (Rs.a p), (x.1 : ℕ) < s →
          (q ≫ z - u ≫ wcCgevTotD I lamI Rs m) ≫ πT (m + 1) x = 0 := by
    intro m s
    induction s with
    | zero =>
      intro _ B z _
      exact ⟨B, 𝟙 B, inferInstance, 0, fun x hx => absurd hx (Nat.not_lt_zero _)⟩
    | succ s ih =>
      intro hs B z H
      obtain ⟨B1, q1, hq1, u1, hz1⟩ := ih (by omega) z H
      obtain ⟨B2, q2, hq2, u2, hz2⟩ := KILL m s (by omega) (q1 ≫ z - u1 ≫ wcCgevTotD I lamI Rs m)
        hz1 (fun y hy => by
          rw [Preadditive.sub_comp, Category.assoc, Category.assoc, hdd' m, Limits.comp_zero,
            sub_zero, H y (by omega), Limits.comp_zero])
      refine ⟨B2, q2 ≫ q1, epi_comp _ _, q2 ≫ u1 + u2, fun x hx => ?_⟩
      have e : (q2 ≫ q1) ≫ z - (q2 ≫ u1 + u2) ≫ wcCgevTotD I lamI Rs m =
          q2 ≫ (q1 ≫ z - u1 ≫ wcCgevTotD I lamI Rs m) - u2 ≫ wcCgevTotD I lamI Rs m := by
        simp only [Preadditive.comp_sub, Preadditive.add_comp, Category.assoc]
        abel
      rw [e]
      exact hz2 x (by omega)

  have AUG_off : ∀ (n : ℕ) (x : Σ p : Fin (n + 1), Fin (Rs.a p)), (x.1 : ℕ) ≠ n →
      wcCgevAugF I Rs n ≫ πT n x = 0 := by
    intro n x hx
    rw [hπT]
    unfold wcCgevAugF
    erw [Limits.biproduct.matrix_π]
    apply Limits.biproduct.hom_ext'
    intro k
    simp only [Limits.biproduct.ι_desc, Limits.comp_zero]
    rw [dif_neg (fun h => hx h.1)]
  have AUG_on : ∀ (n : ℕ) (k : Fin (Rs.a n)),
      wcCgevAugF I Rs n ≫ πT n ⟨⟨n, Nat.lt_succ_self n⟩, k⟩ =
      Limits.biproduct.π (fun _ : Fin (Rs.a n) => A) k ≫ (I.ι.f 0 : A ⟶ I.cocomplex.X 0) ≫
        (I.cocomplex.XIsoOfEq (Nat.sub_self n).symm).hom := by
    intro n k
    rw [hπT]
    unfold wcCgevAugF
    erw [Limits.biproduct.matrix_π]
    apply Limits.biproduct.hom_ext'
    intro k'
    simp only [Limits.biproduct.ι_desc]
    by_cases hk : k' = k
    · subst hk
      rw [dif_pos (by simp), ← Category.assoc, Limits.biproduct.ι_π_self, Category.id_comp]
    · rw [dif_neg (by
          intro h; apply hk; rcases h with ⟨_, h2⟩
          first | exact Fin.ext h2.symm | exact Fin.ext (by simpa using h2.symm) | omega),
        ← Category.assoc,
        Limits.biproduct.ι_π_ne _ hk, Limits.zero_comp]
  have AM : ∀ n, Mono (wcCgevAugF I Rs n) := by
    intro n
    apply Preadditive.mono_of_cancel_zero
    intro P g hg
    apply Limits.biproduct.hom_ext
    intro k
    have h : g ≫ wcCgevAugF I Rs n ≫ πT n ⟨⟨n, Nat.lt_succ_self n⟩, k⟩ = 0 := by
      rw [← Category.assoc, hg, Limits.zero_comp]
    rw [AUG_on, ← Category.assoc] at h
    rw [Limits.zero_comp]
    have hm0 : Mono (I.ι.f 0) := inferInstance
    have hm : Mono ((I.ι.f 0 : A ⟶ I.cocomplex.X 0) ≫
        (I.cocomplex.XIsoOfEq (Nat.sub_self n).symm).hom) := @mono_comp _ _ _ _ _ _ hm0 _ _
    exact (@cancel_mono _ _ _ _ _ _ hm _ _).mp (h.trans Limits.zero_comp.symm)

  have TOP : ∀ (n : ℕ) {B : 𝒜} (z : B ⟶ wcCgevTotX I Rs n),
      (∀ x : Σ p : Fin (n + 1), Fin (Rs.a p), (x.1 : ℕ) < n → z ≫ πT n x = 0) →
      (∀ y : Σ p : Fin (n + 1 + 1), Fin (Rs.a p), (y.1 : ℕ) = n →
        z ≫ wcCgevTotD I lamI Rs n ≫ πT (n + 1) y = 0) →
      ∃ w : B ⟶ Limits.biproduct (fun _ : Fin (Rs.a n) => A), z = w ≫ wcCgevAugF I Rs n := by
    intro n B z hlow hd
    have hc := CYC n n (Nat.lt_succ_self n) z hlow hd
    have e0 : n - n = 0 := Nat.sub_self n
    have e1 : 1 = n + 1 - n := by omega
    have hk : ∀ k : Fin (Rs.a n), ((z ≫ πT n ⟨⟨n, Nat.lt_succ_self n⟩, k⟩) ≫
        (I.cocomplex.XIsoOfEq e0).hom) ≫ I.cocomplex.d 0 1 = 0 := by
      intro k
      apply (cancel_mono (I.cocomplex.XIsoOfEq e1).hom).mp
      rw [Category.assoc, Category.assoc, HomologicalComplex.d_comp_XIsoOfEq_hom,
        HomologicalComplex.XIsoOfEq_hom_comp_d, hc k, Limits.zero_comp]
    obtain ⟨wk, hwk⟩ : ∃ wk : Fin (Rs.a n) → (B ⟶ A), ∀ k,
        wk k ≫ (I.ι.f 0 : A ⟶ I.cocomplex.X 0) = (z ≫ πT n ⟨⟨n, Nat.lt_succ_self n⟩, k⟩) ≫
          (I.cocomplex.XIsoOfEq e0).hom :=
      ⟨fun k => I.exact₀.lift _ (hk k), fun k => I.exact₀.lift_f _ (hk k)⟩
    refine ⟨Limits.biproduct.lift (f := fun _ : Fin (Rs.a n) => A) wk, ?_⟩
    apply hext
    intro x
    obtain ⟨⟨p, hp⟩, k0⟩ := x
    rcases Nat.lt_or_ge p n with h | h
    · rw [hlow ⟨⟨p, hp⟩, k0⟩ h, Category.assoc, AUG_off n ⟨⟨p, hp⟩, k0⟩ (by show p ≠ n; omega),
        Limits.comp_zero]
    · have hpn : p = n := by omega
      subst hpn
      rw [Category.assoc, AUG_on, ← Category.assoc, Limits.biproduct.lift_π]
      refine Eq.trans ?_ (Category.assoc (wk k0) (I.ι.f 0 : A ⟶ I.cocomplex.X 0) _)
      rw [hwk k0, Category.assoc, HomologicalComplex.XIsoOfEq_hom_comp_XIsoOfEq_hom,
        HomologicalComplex.XIsoOfEq_rfl, Iso.refl_hom, Category.comp_id]

  obtain ⟨kd, hkd⟩ : ∃ kd : ∀ n, (Limits.biproduct (fun _ : Fin (Rs.a n) => A) ⟶
      Limits.biproduct (fun _ : Fin (Rs.a (n + 1)) => A)),
      ∀ n, kd n = (wcCgevK lamA hA Rs).d n (n + 1) :=
    ⟨fun n => (wcCgevK lamA hA Rs).d n (n + 1), fun n => rfl⟩
  have hcomm' : ∀ n, wcCgevAugF I Rs n ≫ wcCgevTotD I lamI Rs n =
      kd n ≫ wcCgevAugF I Rs (n + 1) := by
    intro n
    rw [hkd]
    exact hcomm n
  have CYCK : ∀ (n : ℕ) {W : 𝒜} (w : W ⟶ Limits.biproduct (fun _ : Fin (Rs.a n) => A)),
      w ≫ wcCgevAugF I Rs n ≫ wcCgevTotD I lamI Rs n = 0 → w ≫ kd n = 0 := by
    intro n W w h
    haveI := AM (n + 1)
    apply (cancel_mono (wcCgevAugF I Rs (n + 1))).mp
    rw [Category.assoc, ← hcomm', h, Limits.zero_comp]
  have EPI0 : ∀ {W : 𝒜} (y2 : W ⟶ wcCgevTotX I Rs 0), y2 ≫ wcCgevTotD I lamI Rs 0 = 0 →
      ∃ w : W ⟶ Limits.biproduct (fun _ : Fin (Rs.a 0) => A),
        w ≫ kd 0 = 0 ∧ y2 = w ≫ wcCgevAugF I Rs 0 := by
    intro W y2 hy2
    obtain ⟨w, hw⟩ := TOP 0 y2 (fun x hx => absurd hx (Nat.not_lt_zero _))
      (fun y _ => by rw [← Category.assoc, hy2, Limits.zero_comp])
    exact ⟨w, CYCK 0 w (by rw [← Category.assoc, ← hw]; exact hy2), hw⟩
  have EPIS : ∀ (m : ℕ) {W : 𝒜} (y2 : W ⟶ wcCgevTotX I Rs (m + 1)),
      y2 ≫ wcCgevTotD I lamI Rs (m + 1) = 0 →
      ∃ (W' : 𝒜) (q : W' ⟶ W) (_ : Epi q)
        (w : W' ⟶ Limits.biproduct (fun _ : Fin (Rs.a (m + 1)) => A))
        (u : W' ⟶ wcCgevTotX I Rs m),
        w ≫ kd (m + 1) = 0 ∧
          q ≫ y2 = w ≫ wcCgevAugF I Rs (m + 1) + u ≫ wcCgevTotD I lamI Rs m := by
    intro m W y2 hy2
    obtain ⟨W', q, hq, u, hz⟩ := STAIR m (m + 1) le_rfl y2
      (fun y _ => by rw [← Category.assoc, hy2, Limits.zero_comp])
    have hz0 : (q ≫ y2 - u ≫ wcCgevTotD I lamI Rs m) ≫ wcCgevTotD I lamI Rs (m + 1) = 0 := by
      rw [Preadditive.sub_comp, Category.assoc, Category.assoc, hy2, hdd, Limits.comp_zero,
        Limits.comp_zero, sub_zero]
    obtain ⟨w, hw⟩ := TOP (m + 1) _ hz
      (fun y _ => by rw [← Category.assoc, hz0, Limits.zero_comp])
    refine ⟨W', q, hq, w, u, CYCK (m + 1) w (by rw [← Category.assoc, ← hw]; exact hz0), ?_⟩
    rw [← hw, sub_add_cancel]
  have MONO1 : ∀ {W : 𝒜} (x2 : W ⟶ Limits.biproduct (fun _ : Fin (Rs.a (0 + 1)) => A))
      (y1 : W ⟶ wcCgevTotX I Rs 0),
      x2 ≫ wcCgevAugF I Rs (0 + 1) = y1 ≫ wcCgevTotD I lamI Rs 0 →
      ∃ v : W ⟶ Limits.biproduct (fun _ : Fin (Rs.a 0) => A), x2 = v ≫ kd 0 := by
    intro W x2 y1 h
    obtain ⟨v, hv⟩ := TOP 0 y1 (fun x hx => absurd hx (Nat.not_lt_zero _))
      (fun y hy => by
        rw [← Category.assoc, ← h, Category.assoc, AUG_off (0 + 1) y (by omega),
          Limits.comp_zero])
    haveI := AM (0 + 1)
    refine ⟨v, (cancel_mono (wcCgevAugF I Rs (0 + 1))).mp ?_⟩
    rw [h, hv, Category.assoc, Category.assoc, hcomm']
  have MONOS : ∀ (m : ℕ) {W : 𝒜}
      (x2 : W ⟶ Limits.biproduct (fun _ : Fin (Rs.a (m + 1 + 1)) => A))
      (y1 : W ⟶ wcCgevTotX I Rs (m + 1)),
      x2 ≫ wcCgevAugF I Rs (m + 1 + 1) = y1 ≫ wcCgevTotD I lamI Rs (m + 1) →
      ∃ (W' : 𝒜) (q : W' ⟶ W) (_ : Epi q)
        (v : W' ⟶ Limits.biproduct (fun _ : Fin (Rs.a (m + 1)) => A)),
        q ≫ x2 = v ≫ kd (m + 1) := by
    intro m W x2 y1 h
    obtain ⟨W', q, hq, u, hz⟩ := STAIR m (m + 1) le_rfl y1
      (fun y hy => by
        rw [← Category.assoc, ← h, Category.assoc, AUG_off (m + 1 + 1) y (by omega),
          Limits.comp_zero])
    have hz0 : (q ≫ y1 - u ≫ wcCgevTotD I lamI Rs m) ≫ wcCgevTotD I lamI Rs (m + 1) =
        q ≫ x2 ≫ wcCgevAugF I Rs (m + 1 + 1) := by
      rw [Preadditive.sub_comp, Category.assoc, Category.assoc, ← h, hdd, Limits.comp_zero,
        sub_zero]
    obtain ⟨v, hv⟩ := TOP (m + 1) _ hz
      (fun y hy => by
        rw [← Category.assoc, hz0, Category.assoc, Category.assoc,
          AUG_off (m + 1 + 1) y (by omega), Limits.comp_zero, Limits.comp_zero])
    haveI := AM (m + 1 + 1)
    refine ⟨W', q, hq, v, (cancel_mono (wcCgevAugF I Rs (m + 1 + 1))).mp ?_⟩
    rw [Category.assoc, ← hz0, hv, Category.assoc, Category.assoc, hcomm']

  have hTd : ∀ n, (wcCgevTot I lamI Rs hdd).d n (n + 1) = wcCgevTotD I lamI Rs n :=
    fun n => CochainComplex.of_d _ _ n
  rw [quasiIso_iff]
  intro j
  rw [quasiIsoAt_iff_isIso_homologyMap]
  have hepi : Epi (HomologicalComplex.homologyMap (wcCgevAug lamA hA I lamI Rs hdd hcomm) j) := by
    rcases j with _ | m
    · refine (HomologicalComplex.epi_homologyMap_iff_up_to_refinements _ 0 0 (0 + 1)
        CochainComplex.prev_nat_zero (CochainComplex.next ℕ 0)).mpr ?_
      intro W y2 hy2
      rw [hTd 0] at hy2
      obtain ⟨w, hw0, hw⟩ := EPI0 y2 hy2
      refine ⟨W, 𝟙 W, inferInstance, w, by rw [← hkd]; exact hw0, 0, ?_⟩
      rw [Category.id_comp, Limits.zero_comp, add_zero]
      exact hw
    · refine (HomologicalComplex.epi_homologyMap_iff_up_to_refinements _ m (m + 1) (m + 1 + 1)
        (CochainComplex.prev_nat_succ m) (CochainComplex.next ℕ (m + 1))).mpr ?_
      intro W y2 hy2
      rw [hTd (m + 1)] at hy2
      obtain ⟨W', q, hq, w, u, hw0, heq⟩ := EPIS m y2 hy2
      refine ⟨W', q, hq, w, by rw [← hkd]; exact hw0, u, ?_⟩
      rw [hTd m]
      exact heq
  have hmono : Mono (HomologicalComplex.homologyMap (wcCgevAug lamA hA I lamI Rs hdd hcomm) j) := by
    rcases j with _ | _ | m
    · refine (HomologicalComplex.mono_homologyMap_iff_up_to_refinements _ 0 0 (0 + 1)
        CochainComplex.prev_nat_zero (CochainComplex.next ℕ 0)).mpr ?_
      intro W x2 _ y1 h
      rw [HomologicalComplex.shape _ 0 0 (by simp), Limits.comp_zero] at h
      have hm : Mono ((wcCgevAug lamA hA I lamI Rs hdd hcomm).f 0) := AM 0
      have hx2 : x2 = 0 := Limits.zero_of_comp_mono _ h
      exact ⟨W, 𝟙 W, inferInstance, 0, by rw [hx2, Limits.comp_zero, Limits.zero_comp]⟩
    · refine (HomologicalComplex.mono_homologyMap_iff_up_to_refinements _ 0 (0 + 1) (0 + 1 + 1)
        (CochainComplex.prev_nat_succ 0) (CochainComplex.next ℕ (0 + 1))).mpr ?_
      intro W x2 _ y1 h
      rw [hTd 0] at h
      obtain ⟨v, hv⟩ := MONO1 x2 y1 h
      exact ⟨W, 𝟙 W, inferInstance, v, by rw [Category.id_comp, ← hkd]; exact hv⟩
    · refine (HomologicalComplex.mono_homologyMap_iff_up_to_refinements _ (m + 1) (m + 1 + 1)
        (m + 1 + 1 + 1) (CochainComplex.prev_nat_succ (m + 1))
        (CochainComplex.next ℕ (m + 1 + 1))).mpr ?_
      intro W x2 _ y1 h
      rw [hTd (m + 1)] at h
      obtain ⟨W', q, hq, v, hv⟩ := MONOS m x2 y1 h
      exact ⟨W', q, hq, v, by rw [← hkd]; exact hv⟩
  exact isIso_of_mono_of_epi _

theorem wc_cgev_tot_dsq {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {A : 𝒜}
    (I : InjectiveResolution A) {R : Type u} [Ring R] (lamI : R → (I.cocomplex ⟶ I.cocomplex))
    (hIact : wcRingAct lamI) {N : ModuleCat.{u+1} R} (Rs : wcCgevRes N) :
    ∀ n, wcCgevTotD I lamI Rs n ≫ wcCgevTotD I lamI Rs (n + 1) = 0 :=
by
  classical
  haveI : Limits.HasFiniteBiproducts 𝒜 := Abelian.hasFiniteBiproducts

  have hEV : ∀ (m : ℕ) (x : Σ p : Fin (m + 1), Fin (Rs.a p))
      (y : Σ p : Fin (m + 1 + 1), Fin (Rs.a p)),
      (y.1 : ℕ) = x.1 → (y.2 : ℕ) = x.2 →
      wcCgevTotEntry I lamI Rs m x y =
        ((-1 : ℤ) ^ (x.1 : ℕ)) • I.cocomplex.d (m - x.1) (m + 1 - y.1) := by
    intro m x y h1 h2
    unfold wcCgevTotEntry
    rw [if_pos ⟨h1, h2⟩]
  have hE0 : ∀ (m : ℕ) (x : Σ p : Fin (m + 1), Fin (Rs.a p))
      (y : Σ p : Fin (m + 1 + 1), Fin (Rs.a p)),
      ¬ ((y.1 : ℕ) = x.1 ∧ (y.2 : ℕ) = x.2) → (y.1 : ℕ) ≠ x.1 + 1 →
      wcCgevTotEntry I lamI Rs m x y = 0 := by
    intro m x y h1 h2
    unfold wcCgevTotEntry
    rw [if_neg h1, dif_neg h2]
  have hEH : ∀ (m : ℕ) (x : Σ p : Fin (m + 1), Fin (Rs.a p))
      (y : Σ p : Fin (m + 1 + 1), Fin (Rs.a p)) (h : (y.1 : ℕ) = x.1 + 1),
      wcCgevTotEntry I lamI Rs m x y =
        (lamI (Rs.c x.1 (Fin.cast (congrArg Rs.a h) y.2) x.2)).f (m - x.1) ≫
          (I.cocomplex.XIsoOfEq (by have := x.1.isLt; omega)).hom := by
    intro m x y h
    unfold wcCgevTotEntry
    rw [if_neg (fun h' => by have := h'.1; omega), dif_pos h]

  have hVV : ∀ (a b c s t : ℕ),
      ((-1 : ℤ) ^ s • I.cocomplex.d a b) ≫ ((-1 : ℤ) ^ t • I.cocomplex.d b c) = 0 := by
    intro a b c s t
    rw [Preadditive.zsmul_comp, Preadditive.comp_zsmul, HomologicalComplex.d_comp_d, smul_zero,
      smul_zero]

  have s1 : ∀ (φ : I.cocomplex ⟶ I.cocomplex) (a b c e s : ℕ) (h1 : b = c) (h2 : a = e),
      ((-1 : ℤ) ^ s • I.cocomplex.d a b) ≫ (φ.f b ≫ (I.cocomplex.XIsoOfEq h1).hom) +
        (φ.f a ≫ (I.cocomplex.XIsoOfEq h2).hom) ≫ ((-1 : ℤ) ^ (s + 1) • I.cocomplex.d e c) =
        0 := by
    intro φ a b c e s h1 h2
    subst h1 h2
    simp only [HomologicalComplex.XIsoOfEq_rfl, Iso.refl_hom, Category.comp_id,
      Category.id_comp, Preadditive.zsmul_comp, Preadditive.comp_zsmul,
      ← HomologicalComplex.Hom.comm]
    rw [pow_succ, mul_neg_one, neg_smul, add_neg_cancel]

  have s2 : ∀ (p : ℕ) (k : Fin (Rs.a p)) (K : Fin (Rs.a (p + 1 + 1))) (a b c : ℕ)
      (h1 : a = b) (h2 : b = c),
      ∑ j : Fin (Rs.a (p + 1)), ((lamI (Rs.c p j k)).f a ≫ (I.cocomplex.XIsoOfEq h1).hom) ≫
        ((lamI (Rs.c (p + 1) K j)).f b ≫ (I.cocomplex.XIsoOfEq h2).hom) = 0 := by
    intro p k K a b c h1 h2
    subst h1 h2
    simp only [HomologicalComplex.XIsoOfEq_rfl, Iso.refl_hom, Category.comp_id]
    have hm : ∀ j, (lamI (Rs.c p j k)).f a ≫ (lamI (Rs.c (p + 1) K j)).f a =
        (lamI (Rs.c (p + 1) K j * Rs.c p j k)).f a := by
      intro j
      rw [hIact.2.2, HomologicalComplex.comp_f]
    let ψ : R →+ (I.cocomplex.X a ⟶ I.cocomplex.X a) :=
      AddMonoidHom.mk' (fun r => (lamI r).f a)
        (fun r s => by rw [hIact.2.1, HomologicalComplex.add_f_apply])
    have hmul : ∑ j, Rs.c (p + 1) K j * Rs.c p j k = (Rs.c (p + 1) * Rs.c p) K k :=
      (Matrix.mul_apply).symm
    rw [Finset.sum_congr rfl (fun j _ => hm j)]
    change ∑ j, ψ (Rs.c (p + 1) K j * Rs.c p j k) = 0
    rw [← map_sum, hmul, Rs.hcc p, Matrix.zero_apply, map_zero]

  intro n
  show (Limits.biproduct.matrix (fun x y => wcCgevTotEntry I lamI Rs n x y) :
      (⨁ fun x : Σ p : Fin (n + 1), Fin (Rs.a p) => I.cocomplex.X (n - x.1)) ⟶
        (⨁ fun y : Σ p : Fin (n + 1 + 1), Fin (Rs.a p) => I.cocomplex.X (n + 1 - y.1))) ≫
    (Limits.biproduct.matrix (fun x y => wcCgevTotEntry I lamI Rs (n + 1) x y) :
      (⨁ fun x : Σ p : Fin (n + 1 + 1), Fin (Rs.a p) => I.cocomplex.X (n + 1 - x.1)) ⟶
        (⨁ fun y : Σ p : Fin (n + 1 + 1 + 1), Fin (Rs.a p) => I.cocomplex.X (n + 1 + 1 - y.1)))
      = 0
  apply Limits.biproduct.hom_ext'
  intro x
  apply Limits.biproduct.hom_ext
  intro z
  simp only [Limits.comp_zero, Limits.zero_comp, Category.assoc, Limits.biproduct.matrix_π,
    Limits.biproduct.ι_matrix_assoc, Limits.biproduct.lift_desc]
  obtain ⟨p, k⟩ := x
  obtain ⟨⟨P, hP⟩, K⟩ := z
  have hp := p.isLt
  by_cases h1 : P = (p : ℕ) + 1
  ·
    subst h1
    rw [Fintype.sum_eq_add
      (⟨⟨p, by omega⟩, k⟩ : Σ q : Fin (n + 1 + 1), Fin (Rs.a q))
      (⟨⟨p + 1, by omega⟩, K⟩ : Σ q : Fin (n + 1 + 1), Fin (Rs.a q)) ?_ ?_]
    · beta_reduce
      rw [hEV n ⟨p, k⟩ ⟨⟨p, _⟩, k⟩ rfl rfl, hEH (n + 1) ⟨⟨p, _⟩, k⟩ ⟨⟨p + 1, hP⟩, K⟩ rfl,
        hEH n ⟨p, k⟩ ⟨⟨p + 1, _⟩, K⟩ rfl, hEV (n + 1) ⟨⟨p + 1, _⟩, K⟩ ⟨⟨p + 1, hP⟩, K⟩ rfl rfl]
      exact s1 _ _ _ _ _ _ _ _
    · intro h
      have h' := congrArg (fun y : Σ q : Fin (n + 1 + 1), Fin (Rs.a q) => (y.1 : ℕ)) h
      change (p : ℕ) = (p : ℕ) + 1 at h'
      omega
    · rintro ⟨⟨q, hq⟩, j⟩ ⟨hne1, hne2⟩
      beta_reduce
      by_cases hq1 : q = (p : ℕ)
      · subst hq1
        by_cases hj : (j : ℕ) = k
        · exact (hne1 (Sigma.ext rfl (heq_of_eq (Fin.ext hj)))).elim
        · rw [hE0 n ⟨p, k⟩ ⟨⟨p, hq⟩, j⟩ (fun h => hj h.2) (by show (p : ℕ) ≠ p + 1; omega),
            Limits.zero_comp]
      · by_cases hq2 : q = (p : ℕ) + 1
        · subst hq2
          by_cases hj : (j : ℕ) = K
          · exact (hne2 (Sigma.ext rfl (heq_of_eq (Fin.ext hj)))).elim
          · rw [hE0 (n + 1) ⟨⟨p + 1, hq⟩, j⟩ ⟨⟨p + 1, hP⟩, K⟩ (fun h => hj h.2.symm)
              (by show (p : ℕ) + 1 ≠ p + 1 + 1; omega), Limits.comp_zero]
        · rw [hE0 n ⟨p, k⟩ ⟨⟨q, hq⟩, j⟩ (fun h => hq1 h.1) (by show q ≠ (p : ℕ) + 1; exact hq2),
            Limits.zero_comp]
  · by_cases h2 : P = (p : ℕ) + 1 + 1
    ·
      subst h2
      rw [Fintype.sum_sigma, Fintype.sum_eq_single (⟨p + 1, by omega⟩ : Fin (n + 1 + 1)) ?_]
      · have e : ∀ j : Fin (Rs.a ((⟨p + 1, by omega⟩ : Fin (n + 1 + 1)) : ℕ)),
            wcCgevTotEntry I lamI Rs n ⟨p, k⟩ ⟨⟨p + 1, by omega⟩, j⟩ ≫
              wcCgevTotEntry I lamI Rs (n + 1) ⟨⟨p + 1, by omega⟩, j⟩ ⟨⟨p + 1 + 1, hP⟩, K⟩ =
            ((lamI (Rs.c p j k)).f (n - p) ≫
                (I.cocomplex.XIsoOfEq (by omega : n - (p : ℕ) = n + 1 - ((p : ℕ) + 1))).hom) ≫
              ((lamI (Rs.c ((p : ℕ) + 1) K j)).f (n + 1 - ((p : ℕ) + 1)) ≫
                (I.cocomplex.XIsoOfEq
                  (by omega : n + 1 - ((p : ℕ) + 1) = n + 1 + 1 - ((p : ℕ) + 1 + 1))).hom) := by
          intro j
          rw [hEH n _ _ rfl, hEH (n + 1) _ _ rfl]
          rfl
        refine (Finset.sum_congr rfl (fun j _ => e j)).trans ?_
        exact s2 p k K _ _ _ _ _
      · rintro ⟨q, hq⟩ hqne
        apply Finset.sum_eq_zero
        intro j _
        by_cases hV : q = (p : ℕ) ∧ (j : ℕ) = k
        · rw [hE0 (n + 1) ⟨⟨q, hq⟩, j⟩ ⟨⟨p + 1 + 1, hP⟩, K⟩ (fun h => by
              have := h.1; change (p : ℕ) + 1 + 1 = q at this; omega)
            (by show (p : ℕ) + 1 + 1 ≠ q + 1; omega), Limits.comp_zero]
        · have hq2 : q ≠ (p : ℕ) + 1 := fun h => hqne (Fin.ext h)
          rw [hE0 n ⟨p, k⟩ ⟨⟨q, hq⟩, j⟩ hV (by show q ≠ (p : ℕ) + 1; exact hq2),
            Limits.zero_comp]
    ·
      apply Finset.sum_eq_zero
      rintro ⟨⟨q, hq⟩, j⟩ _
      by_cases hV : q = (p : ℕ) ∧ (j : ℕ) = k
      · by_cases hV2 : P = q ∧ (K : ℕ) = j
        · rw [hEV n ⟨p, k⟩ ⟨⟨q, hq⟩, j⟩ hV.1 hV.2,
            hEV (n + 1) ⟨⟨q, hq⟩, j⟩ ⟨⟨P, hP⟩, K⟩ hV2.1 hV2.2]
          exact hVV _ _ _ _ _
        · rw [hE0 (n + 1) ⟨⟨q, hq⟩, j⟩ ⟨⟨P, hP⟩, K⟩ hV2
            (by show P ≠ q + 1; omega), Limits.comp_zero]
      · by_cases hH : q = (p : ℕ) + 1
        · rw [hE0 (n + 1) ⟨⟨q, hq⟩, j⟩ ⟨⟨P, hP⟩, K⟩ (fun h => h1 (by
              have := h.1; change P = q at this; omega))
            (by show P ≠ q + 1; omega), Limits.comp_zero]
        · rw [hE0 n ⟨p, k⟩ ⟨⟨q, hq⟩, j⟩ hV (by show q ≠ (p : ℕ) + 1; exact hH),
            Limits.zero_comp]

theorem wc_cgev_aug_comm {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {R : Type u} [Ring R] {A : 𝒜}
    (lamA : R → (A ⟶ A)) (hA : wcRingAct lamA) (I : InjectiveResolution A)
    (lamI : R → (I.cocomplex ⟶ I.cocomplex))
    (hI0 : ∀ r, I.ι.f 0 ≫ (lamI r).f 0 = lamA r ≫ I.ι.f 0)
    {N : ModuleCat.{u+1} R} (Rs : wcCgevRes N) :
    ∀ n, wcCgevAugF I Rs n ≫ wcCgevTotD I lamI Rs n =
      (wcCgevK lamA hA Rs).d n (n + 1) ≫ wcCgevAugF I Rs (n + 1) :=
by
  classical
  have hV : ∀ (m m' : ℕ) (h0 : 0 = m),
      (I.ι.f 0 : A ⟶ I.cocomplex.X 0) ≫ (I.cocomplex.XIsoOfEq h0).hom ≫ I.cocomplex.d m m' = 0 := by
    intro m m' h0
    subst h0
    rw [HomologicalComplex.XIsoOfEq_rfl, Iso.refl_hom, Category.id_comp]
    by_cases hm : m' = 1
    · subst hm
      exact InjectiveResolution.ι_f_zero_comp_complex_d I
    · rw [I.cocomplex.shape 0 m' (by simp; omega), Limits.comp_zero]
  have hH : ∀ (r : R) (m m' : ℕ) (h0 : 0 = m) (h3 : m = m') (h1 : 0 = m'),
      (I.ι.f 0 : A ⟶ I.cocomplex.X 0) ≫ (I.cocomplex.XIsoOfEq h0).hom ≫ (lamI r).f m ≫
        (I.cocomplex.XIsoOfEq h3).hom = lamA r ≫ (I.ι.f 0 : A ⟶ I.cocomplex.X 0) ≫
          (I.cocomplex.XIsoOfEq h1).hom := by
    intro r m m' h0 h3 h1
    subst h0
    subst h3
    rw [HomologicalComplex.XIsoOfEq_rfl, Iso.refl_hom, Category.id_comp, Category.comp_id]
    first
      | (erw [Category.comp_id]; exact hI0 r)
      | (simp only [Category.comp_id]; exact hI0 r)
  intro n
  haveI : Limits.HasFiniteBiproducts 𝒜 := Abelian.hasFiniteBiproducts
  have hd : (wcCgevK lamA hA Rs).d n (n + 1) =
      Limits.biproduct.matrix (fun j i => lamA (Rs.c n i j)) := by
    unfold wcCgevK
    first
      | exact CochainComplex.of_d _ _ n
      | erw [CochainComplex.of_d]
      | simp only [CochainComplex.of_d]
  rw [hd]
  dsimp only [wcCgevK]
  apply Limits.biproduct.hom_ext'
  intro k
  apply Limits.biproduct.hom_ext
  intro y
  obtain ⟨kv, hk⟩ := k
  obtain ⟨⟨p, hp⟩, ⟨j, hj⟩⟩ := y
  dsimp only [wcCgevAugF, wcCgevTotD, wcCgevTotX]
  set ι0 : A ⟶ I.cocomplex.X 0 := I.ι.f 0 with hι0
  clear_value ι0
  simp only [Category.assoc, Limits.biproduct.ι_matrix_assoc, Limits.biproduct.matrix_π,
    Limits.biproduct.lift_desc]
  rw [Fintype.sum_eq_single (⟨Fin.last n, ⟨kv, hk⟩⟩ : Σ q : Fin (n + 1), Fin (Rs.a q))]
  rotate_left
  · rintro ⟨⟨p', hp'⟩, ⟨k', hk'⟩⟩ hne
    split_ifs with h
    · exfalso
      obtain ⟨h1, h2⟩ := h
      dsimp only at h1 h2
      subst h1
      subst h2
      exact hne rfl
    · exact Limits.zero_comp
  split_ifs with hc
  swap
  · exact (hc ⟨rfl, rfl⟩).elim
  by_cases hpn : p = n + 1
  · subst hpn
    rw [Fintype.sum_eq_single (⟨j, hj⟩ : Fin (Rs.a (n + 1)))]
    rotate_left
    · intro i hi
      split_ifs with h
      · exact (hi (Fin.ext h.2.symm)).elim
      · exact Limits.comp_zero
    simp only [wcCgevTotEntry]
    rw [if_neg (show ¬ (n + 1 = ((Fin.last n : Fin (n + 1)) : ℕ) ∧ j = kv) by simp)]
    rw [dif_pos (show n + 1 = ((Fin.last n : Fin (n + 1)) : ℕ) + 1 by simp)]
    rw [dif_pos (⟨trivial, trivial⟩ : True ∧ True)]
    simp only [Category.assoc]
    exact hH _ _ _ _ _ _
  · rw [Finset.sum_eq_zero (fun i _ => by rw [dif_neg (fun h => hpn h.1), Limits.comp_zero])]
    simp only [wcCgevTotEntry]
    split_ifs with h1 h2
    · have hV' : ∀ (m m' : ℕ) (h0 : 0 = m) (s : ℤ),
          (ι0 ≫ (I.cocomplex.XIsoOfEq h0).hom) ≫ (s • I.cocomplex.d m m') = 0 := by
        intro m m' h0 s
        rw [Preadditive.comp_zsmul, Category.assoc]
        exact (congrArg (fun t => s • t) (hV m m' h0)).trans (smul_zero s)
      exact hV' _ _ _ _
    · exact (hpn h2).elim
    · exact Limits.comp_zero

theorem wc_cgev_embed_cocycle {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {A : 𝒜}
    (I : InjectiveResolution A) {R : Type u} [Ring R] (lamI : R → (I.cocomplex ⟶ I.cocomplex))
    {N : ModuleCat.{u+1} R} (Rs : wcCgevRes N) (P : 𝒜) (n : ℕ)
    (f : N →+ (P ⟶ I.cocomplex.X n))
    (hlin : ∀ (r : R) (x : N), f (r • x) = f x ≫ (lamI r).f n)
    (hcoc : ∀ x : N, f x ≫ I.cocomplex.d n (n + 1) = 0) :
    wcCgevEmbed I Rs P n f ≫ wcCgevTotD I lamI Rs n = 0 :=
by
  have key : ∀ j : Fin (Rs.a (0 + 1)),
      ∑ k : Fin (Rs.a 0), f (Rs.ε (Pi.single k 1)) ≫ (lamI (Rs.c 0 j k)).f n = 0 := by
    intro j
    have h1 : ∀ k : Fin (Rs.a 0), f (Rs.ε (Pi.single k 1)) ≫ (lamI (Rs.c 0 j k)).f n =
        f (Rs.ε (Pi.single k (Rs.c 0 j k))) := by
      intro k
      rw [← hlin, ← LinearMap.map_smul]
      congr 2
      ext i
      by_cases h : i = k
      · subst h; simp
      · simp [Pi.single_apply, h]
    rw [Finset.sum_congr rfl (fun k _ => h1 k), ← map_sum, ← map_sum, Finset.univ_sum_single]
    have h2 : Rs.ε (fun k => Rs.c 0 j k) = 0 :=
      (Rs.ex0 _).mpr ⟨Pi.single j 1, by rw [Matrix.single_one_vecMul]; rfl⟩
    rw [h2, map_zero]
  haveI : Limits.HasFiniteBiproducts 𝒜 := Abelian.hasFiniteBiproducts
  unfold wcCgevEmbed wcCgevTotD
  show (Limits.biproduct.lift (fun y : Σ p : Fin (n + 1), Fin (Rs.a p) => _) :
      P ⟶ Limits.biproduct fun x : Σ p : Fin (n + 1), Fin (Rs.a p) => I.cocomplex.X (n - x.1)) ≫
    Limits.biproduct.matrix (fun x y => wcCgevTotEntry I lamI Rs n x y) = 0
  apply Limits.biproduct.hom_ext
  rintro ⟨⟨q, hq⟩, k'⟩
  rw [Category.assoc, Limits.biproduct.matrix_π, Limits.biproduct.lift_desc, Limits.zero_comp,
    Fintype.sum_sigma, Finset.sum_eq_single (⟨0, Nat.succ_pos n⟩ : Fin (n + 1))]
  rotate_left
  · intro p _ hp
    apply Finset.sum_eq_zero
    intro k _
    rw [dif_neg (fun h => hp (Fin.ext h)), Limits.zero_comp]
  · intro h; exact absurd (Finset.mem_univ _) h
  rcases q with _ | _ | q
  · apply Finset.sum_eq_zero
    intro k _
    simp only [wcCgevTotEntry]
    rw [dif_pos trivial]
    split_ifs with h1 h2
    · rw [Preadditive.comp_zsmul, Category.assoc, HomologicalComplex.XIsoOfEq_hom_comp_d,
        show f _ ≫ I.cocomplex.d n (n + 1 - 0) = 0 from hcoc _, smul_zero]
    all_goals first
      | exact Limits.comp_zero
      | (exfalso; omega)
      | simp_all
  · simp only [wcCgevTotEntry]
    calc _ = ∑ x : Fin (Rs.a 0), (f (Rs.ε (Pi.single x 1)) ≫ (lamI (Rs.c 0 k' x)).f n) ≫
          ((I.cocomplex.XIsoOfEq (show n = n - 0 from rfl)).hom ≫
            (I.cocomplex.XIsoOfEq (show n - 0 = n + 1 - (0 + 1) by omega)).hom) := by
          refine Finset.sum_congr rfl (fun x _ => ?_)
          rw [dif_pos trivial, if_neg (fun h : 0 + 1 = 0 ∧ _ => absurd h.1 (by omega)),
            dif_pos trivial]
          simp only [Category.assoc]
          rw [← Category.assoc (I.cocomplex.XIsoOfEq _).hom,
            ← HomologicalComplex.XIsoOfEq_hom_naturality]
          simp only [Category.assoc]
          all_goals rfl
      _ = 0 := by rw [← Preadditive.sum_comp, key, Limits.zero_comp]
  · apply Finset.sum_eq_zero
    intro k _
    simp only [wcCgevTotEntry]
    rw [dif_pos trivial, if_neg (fun h : q + 1 + 1 = 0 ∧ _ => absurd h.1 (by omega)),
      dif_neg (by omega : ¬ (q + 1 + 1 = 0 + 1)), Limits.comp_zero]

theorem wc_cgev_tot_descent (S : Scheme.{u}) (U : S.ProEt) {R : Type u} [Ring R]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (I : InjectiveResolution G)
    (lamI : R → (I.cocomplex ⟶ I.cocomplex)) (hIact : wcRingAct lamI)
    (N : ModuleCat.{u+1} R) (Rs : wcCgevRes N)
    (hdd : ∀ n, wcCgevTotD I lamI Rs n ≫ wcCgevTotD I lamI Rs (n + 1) = 0)
    (hinj : ∀ q, wcChmpInjD (fun r => ((preadditiveCoyoneda.obj
      (Opposite.op (wcFreeSheaf S U))).mapHomologicalComplex (ComplexShape.up ℕ)).map (lamI r)) q)
    (m : ℕ) (f : N →+ (wcFreeSheaf S U ⟶ I.cocomplex.X (m + 1)))
    (hf : ∀ (r : R) (x : N), f (r • x) = f x ≫ (lamI r).f (m + 1))
    (g : wcFreeSheaf S U ⟶ (wcCgevTot I lamI Rs hdd).X m)
    (hg : g ≫ (wcCgevTot I lamI Rs hdd).d m (m + 1) = wcCgevEmbed I Rs (wcFreeSheaf S U) (m + 1) f) :
    ∃ h : N →+ (wcFreeSheaf S U ⟶ I.cocomplex.X m),
      (∀ (r : R) (x : N), h (r • x) = h x ≫ (lamI r).f m) ∧
      ∀ x : N, h x ≫ I.cocomplex.d m (m + 1) = f x :=
by
  classical
  haveI : Limits.HasFiniteBiproducts (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
    Abelian.hasFiniteBiproducts
  obtain ⟨hI1, hIadd, hImul⟩ := hIact
  have hL1 : ∀ q (y : wcFreeSheaf S U ⟶ I.cocomplex.X q), y ≫ (lamI 1).f q = y := by
    intro q y; rw [hI1, HomologicalComplex.id_f, Category.comp_id]
  have hLmul : ∀ q (y : wcFreeSheaf S U ⟶ I.cocomplex.X q) (a b : R),
      y ≫ (lamI (a * b)).f q = (y ≫ (lamI b).f q) ≫ (lamI a).f q := by
    intro q y a b; rw [hImul, HomologicalComplex.comp_f, Category.assoc]
  let ψ : ∀ q, (wcFreeSheaf S U ⟶ I.cocomplex.X q) → R →+ (wcFreeSheaf S U ⟶ I.cocomplex.X q) :=
    fun q y => AddMonoidHom.mk' (fun r => y ≫ (lamI r).f q) (fun a b => by
      simp only [hIadd, HomologicalComplex.add_f_apply, Preadditive.comp_add])
  have hψ : ∀ q y r, ψ q y r = y ≫ (lamI r).f q := fun _ _ _ => rfl
  have hφadd : ∀ q n0 (y : Fin n0 → (wcFreeSheaf S U ⟶ I.cocomplex.X q)) (v w : Fin n0 → R),
      ∑ k, y k ≫ (lamI ((v + w) k)).f q =
        ∑ k, y k ≫ (lamI (v k)).f q + ∑ k, y k ≫ (lamI (w k)).f q := by
    intro q n0 y v w
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun k _ => map_add (ψ q (y k)) (v k) (w k))
  have hφsub : ∀ q n0 (y : Fin n0 → (wcFreeSheaf S U ⟶ I.cocomplex.X q)) (v w : Fin n0 → R),
      ∑ k, y k ≫ (lamI ((v - w) k)).f q =
        ∑ k, y k ≫ (lamI (v k)).f q - ∑ k, y k ≫ (lamI (w k)).f q := by
    intro q n0 y v w
    rw [← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl (fun k _ => map_sub (ψ q (y k)) (v k) (w k))
  have hφsmul : ∀ q n0 (y : Fin n0 → (wcFreeSheaf S U ⟶ I.cocomplex.X q)) (r : R) (v : Fin n0 → R),
      ∑ k, y k ≫ (lamI ((r • v) k)).f q = (∑ k, y k ≫ (lamI (v k)).f q) ≫ (lamI r).f q := by
    intro q n0 y r v
    rw [Preadditive.sum_comp]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [Pi.smul_apply, smul_eq_mul, hLmul]
  have hφsingle : ∀ q n0 (y : Fin n0 → (wcFreeSheaf S U ⟶ I.cocomplex.X q)) (k : Fin n0),
      ∑ j, y j ≫ (lamI ((Pi.single k (1 : R) : Fin n0 → R) j)).f q = y k := by
    intro q n0 y k
    rw [Finset.sum_eq_single_of_mem k (Finset.mem_univ _) (fun j _ hj => by
      rw [Pi.single_eq_of_ne hj]; exact map_zero (ψ q (y j))), Pi.single_eq_same, hL1]
  have hφ3 : ∀ q n0 n1 (C : Matrix (Fin n1) (Fin n0) R)
      (y : Fin n0 → (wcFreeSheaf S U ⟶ I.cocomplex.X q)),
      (∀ k', ∑ k, y k ≫ (lamI (C k' k)).f q = 0) →
      ∀ u : Fin n1 → R, ∑ k, y k ≫ (lamI (Matrix.vecMul u C k)).f q = 0 := by
    intro q n0 n1 C y hy u
    have e1 : ∀ k, y k ≫ (lamI (Matrix.vecMul u C k)).f q =
        ∑ k', (y k ≫ (lamI (C k' k)).f q) ≫ (lamI (u k')).f q := by
      intro k
      rw [show Matrix.vecMul u C k = ∑ k', u k' * C k' k from rfl, ← hψ, map_sum]
      refine Finset.sum_congr rfl (fun k' _ => ?_)
      rw [hψ, hLmul]
    rw [Finset.sum_congr rfl (fun k _ => e1 k), Finset.sum_comm]
    refine Finset.sum_eq_zero (fun k' _ => ?_)
    rw [← Preadditive.sum_comp, hy k', Limits.zero_comp]
  have hrow0 : ∀ q (y : Fin (Rs.a 0) → (wcFreeSheaf S U ⟶ I.cocomplex.X q)),
      (∀ k' : Fin (Rs.a (0 + 1)), ∑ k, y k ≫ (lamI (Rs.c 0 k' k)).f q = 0) →
      ∃ h : N →+ (wcFreeSheaf S U ⟶ I.cocomplex.X q),
        (∀ (r : R) (x : N), h (r • x) = h x ≫ (lamI r).f q) ∧
        ∀ k, h (Rs.ε (Pi.single k 1)) = y k := by
    intro q y hy
    have wd : ∀ v w, Rs.ε v = Rs.ε w →
        ∑ k, y k ≫ (lamI (v k)).f q = ∑ k, y k ≫ (lamI (w k)).f q := by
      intro v w hvw
      obtain ⟨u, hu⟩ := (Rs.ex0 (v - w)).mp (by rw [map_sub, hvw, sub_self])
      have := hφ3 q _ _ (Rs.c 0) y hy u
      rw [hu, hφsub] at this
      exact sub_eq_zero.mp this
    have hσ' : ∀ x, Rs.ε (Function.surjInv Rs.surj x) = x := Function.surjInv_eq Rs.surj
    refine ⟨AddMonoidHom.mk' (fun x => ∑ k, y k ≫ (lamI (Function.surjInv Rs.surj x k)).f q)
      (fun x x' => ?_), ?_, ?_⟩
    · show ∑ k, y k ≫ (lamI (Function.surjInv Rs.surj (x + x') k)).f q =
        ∑ k, y k ≫ (lamI (Function.surjInv Rs.surj x k)).f q +
          ∑ k, y k ≫ (lamI (Function.surjInv Rs.surj x' k)).f q
      rw [wd (Function.surjInv Rs.surj (x + x'))
        (Function.surjInv Rs.surj x + Function.surjInv Rs.surj x')
        (by rw [map_add, hσ', hσ', hσ'])]
      exact hφadd q _ y _ _
    · intro r x
      show ∑ k, y k ≫ (lamI (Function.surjInv Rs.surj (r • x) k)).f q =
        (∑ k, y k ≫ (lamI (Function.surjInv Rs.surj x k)).f q) ≫ (lamI r).f q
      rw [wd (Function.surjInv Rs.surj (r • x)) (r • Function.surjInv Rs.surj x)
        (by rw [map_smul, hσ', hσ']), hφsmul]
    · intro k
      show ∑ j, y j ≫ (lamI (Function.surjInv Rs.surj (Rs.ε (Pi.single k 1)) j)).f q = y k
      rw [wd _ (Pi.single k 1) (hσ' _), hφsingle]
  have hrowS : ∀ q (p : ℕ) (y : Fin (Rs.a (p + 1)) → (wcFreeSheaf S U ⟶ I.cocomplex.X q)),
      (∀ k' : Fin (Rs.a (p + 1 + 1)), ∑ k, y k ≫ (lamI (Rs.c (p + 1) k' k)).f q = 0) →
      ∃ z : Fin (Rs.a p) → (wcFreeSheaf S U ⟶ I.cocomplex.X q),
        ∀ k, ∑ k₀, z k₀ ≫ (lamI (Rs.c p k k₀)).f q = y k := by
    intro q p y hy
    let dl := Matrix.vecMulLinear (Rs.c p)
    have hdl : ∀ v, dl v = Matrix.vecMul v (Rs.c p) := fun v => rfl
    have wd : ∀ v w, dl v = dl w →
        ∑ k, y k ≫ (lamI (v k)).f q = ∑ k, y k ≫ (lamI (w k)).f q := by
      intro v w hvw
      obtain ⟨u, hu⟩ := (Rs.ex p (v - w)).mp (by rw [← hdl, map_sub, hvw, sub_self])
      have := hφ3 q _ _ (Rs.c (p + 1)) y hy u
      rw [hu, hφsub] at this
      exact sub_eq_zero.mp this
    have hB : ∀ b : LinearMap.range dl, ∃ v, dl v = b.1 := fun b => LinearMap.mem_range.mp b.2
    let ps : LinearMap.range dl → (wcFreeSheaf S U ⟶ I.cocomplex.X q) :=
      fun b => ∑ k, y k ≫ (lamI ((hB b).choose k)).f q
    have hps : ∀ (b : LinearMap.range dl) v, dl v = b.1 → ps b = ∑ k, y k ≫ (lamI (v k)).f q :=
      fun b v hv => wd _ _ ((hB b).choose_spec.trans hv.symm)
    let A' := ModuleCat.of R (ULift.{u+1} (LinearMap.range dl))
    let B' := ModuleCat.of R (ULift.{u+1} (Fin (Rs.a p) → R))
    let iL : ULift.{u+1} (LinearMap.range dl) →ₗ[R] ULift.{u+1} (Fin (Rs.a p) → R) :=
      { toFun := fun x => ULift.up x.down.1
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    let i : A' ⟶ B' := ModuleCat.ofHom iL
    have hi : Function.Injective i.hom := by
      intro x x' hxx
      exact ULift.ext _ _ (Subtype.ext (congrArg ULift.down hxx))
    let g' : ULift.{u+1} (LinearMap.range dl) →+ (wcFreeSheaf S U ⟶ I.cocomplex.X q) :=
      AddMonoidHom.mk' (fun x => ps x.down) (fun x x' => by
        obtain ⟨v, hv⟩ := hB x.down
        obtain ⟨v', hv'⟩ := hB x'.down
        show ps (x + x').down = ps x.down + ps x'.down
        rw [hps (x + x').down (v + v') (by rw [map_add, hv, hv']; rfl), hps _ v hv, hps _ v' hv']
        exact hφadd q _ y v v')
    obtain ⟨χ, hχ, hχi⟩ := hinj q A' B' i hi g' (by
      intro r x
      obtain ⟨v, hv⟩ := hB x.down
      show ps (r • x.down) = ps x.down ≫ (lamI r).f q
      rw [hps (r • x.down) (r • v) (by rw [map_smul, hv]; rfl), hps _ v hv, hφsmul])
    let χ' : ULift.{u+1} (Fin (Rs.a p) → R) → (wcFreeSheaf S U ⟶ I.cocomplex.X q) := fun x => χ x
    have hχ' : ∀ (r : R) x, χ' (r • x) = χ' x ≫ (lamI r).f q := hχ
    have hχi' : ∀ x, χ' (i.hom x) = ps x.down := hχi
    refine ⟨fun k₀ => χ' (ULift.up (Pi.single k₀ 1)), fun k => ?_⟩
    have e1 : ∀ k₀, χ' (ULift.up (Pi.single k₀ 1)) ≫ (lamI (Rs.c p k k₀)).f q =
        χ' (Rs.c p k k₀ • ULift.up (Pi.single k₀ 1)) := fun k₀ => (hχ' _ _).symm
    rw [Finset.sum_congr rfl (fun k₀ _ => e1 k₀)]
    have e2 : ∑ k₀, χ' (Rs.c p k k₀ • ULift.up (Pi.single k₀ 1)) =
        χ' (∑ k₀, Rs.c p k k₀ • ULift.up (Pi.single k₀ 1)) := (map_sum χ _ _).symm
    rw [e2]
    have e3 : (∑ k₀, Rs.c p k k₀ • (ULift.up (Pi.single k₀ (1 : R)) :
        ULift.{u+1} (Fin (Rs.a p) → R))) =
        i.hom (ULift.up ⟨dl (Pi.single k 1), LinearMap.mem_range_self dl _⟩) := by
      apply ULift.ext
      let eL := (ULift.moduleEquiv : ULift.{u+1} (Fin (Rs.a p) → R) ≃ₗ[R] (Fin (Rs.a p) → R))
      show eL (∑ k₀, Rs.c p k k₀ • (ULift.up (Pi.single k₀ (1 : R)) :
        ULift.{u+1} (Fin (Rs.a p) → R))) = Matrix.vecMul (Pi.single k 1) (Rs.c p)
      rw [map_sum]
      simp only [map_smul]
      change ∑ k₀, Rs.c p k k₀ • (Pi.single k₀ (1 : R) : Fin (Rs.a p) → R) =
        Matrix.vecMul (Pi.single k 1) (Rs.c p)
      ext j
      simp [Matrix.vecMul, dotProduct, Pi.single_apply, Finset.sum_apply]
    rw [e3, hχi']
    exact (hps _ _ rfl).trans (hφsingle q _ y k)
  have master : ∀ n (g : wcFreeSheaf S U ⟶ wcCgevTotX I Rs n)
      (y : Σ p : Fin (n + 1 + 1), Fin (Rs.a p)),
      g ≫ wcCgevTotD I lamI Rs n ≫ Limits.biproduct.π
        (fun y : Σ p : Fin (n + 1 + 1), Fin (Rs.a p) => I.cocomplex.X (n + 1 - y.1)) y =
      ∑ p : Fin (n + 1), ∑ k : Fin (Rs.a p), (g ≫ Limits.biproduct.π
        (fun x : Σ p : Fin (n + 1), Fin (Rs.a p) => I.cocomplex.X (n - x.1)) ⟨p, k⟩) ≫
          wcCgevTotEntry I lamI Rs n ⟨p, k⟩ y := by
    intro n g y
    unfold wcCgevTotD
    erw [Limits.biproduct.matrix_π, Limits.biproduct.desc_eq, Preadditive.comp_sum,
      Fintype.sum_sigma]
    exact Finset.sum_congr rfl (fun _ _ => Finset.sum_congr rfl (fun _ _ => (Category.assoc _ _ _).symm))
  have hE_zero : ∀ n (x : Σ p : Fin (n + 1), Fin (Rs.a p)) (y : Σ p : Fin (n + 1 + 1), Fin (Rs.a p)),
      (y.1 : ℕ) ≠ x.1 → (y.1 : ℕ) ≠ (x.1 : ℕ) + 1 → wcCgevTotEntry I lamI Rs n x y = 0 := by
    intro n x y h1 h2
    unfold wcCgevTotEntry
    rw [if_neg (fun h => h1 h.1), dif_neg h2]
  have hE_H : ∀ n t (ht : t < n + 1) (k : Fin (Rs.a t)) (k' : Fin (Rs.a (t + 1)))
      (ht' : t + 1 < n + 1 + 1),
      wcCgevTotEntry I lamI Rs n ⟨⟨t, ht⟩, k⟩ ⟨⟨t + 1, ht'⟩, k'⟩ =
        (lamI (Rs.c t k' k)).f (n - t) ≫
          (I.cocomplex.XIsoOfEq (by omega : n - t = n + 1 - (t + 1))).hom := by
    intro n t ht k k' ht'
    unfold wcCgevTotEntry
    rw [if_neg (fun h => by obtain ⟨h1, -⟩ := h; simp at h1), dif_pos rfl]
    rfl
  have hE_V0 : ∀ n (k : Fin (Rs.a 0)),
      wcCgevTotEntry I lamI Rs n ⟨⟨0, by omega⟩, k⟩ ⟨⟨0, by omega⟩, k⟩ =
        I.cocomplex.d (n - 0) (n + 1 - 0) := by
    intro n k
    unfold wcCgevTotEntry
    rw [if_pos ⟨rfl, rfl⟩]
    simp
  have hrel : ∀ n t (ht : t ≤ n) (g : wcFreeSheaf S U ⟶ wcCgevTotX I Rs n),
      (∀ x : Σ p : Fin (n + 1), Fin (Rs.a p), t < (x.1 : ℕ) → g ≫ Limits.biproduct.π
        (fun x : Σ p : Fin (n + 1), Fin (Rs.a p) => I.cocomplex.X (n - x.1)) x = 0) →
      ∀ k' : Fin (Rs.a (t + 1)),
      g ≫ wcCgevTotD I lamI Rs n ≫ Limits.biproduct.π
        (fun y : Σ p : Fin (n + 1 + 1), Fin (Rs.a p) => I.cocomplex.X (n + 1 - y.1))
          ⟨⟨t + 1, by omega⟩, k'⟩ =
      (∑ k : Fin (Rs.a t), (g ≫ Limits.biproduct.π
        (fun x : Σ p : Fin (n + 1), Fin (Rs.a p) => I.cocomplex.X (n - x.1)) ⟨⟨t, by omega⟩, k⟩) ≫
          (lamI (Rs.c t k' k)).f (n - t)) ≫
        (I.cocomplex.XIsoOfEq (by omega : n - t = n + 1 - (t + 1))).hom := by
    intro n t ht g hg k'
    rw [master, Preadditive.sum_comp,
      Finset.sum_eq_single_of_mem (⟨t, by omega⟩ : Fin (n + 1)) (Finset.mem_univ _) ?_]
    · refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [hE_H n t (by omega) k k' (by omega)]
      simp only [Category.assoc]
    · rintro ⟨p, hp⟩ _ hne
      refine Finset.sum_eq_zero (fun k _ => ?_)
      have hpt : p ≠ t := fun h => hne (Fin.ext h)
      rcases Nat.lt_or_gt_of_ne hpt with hlt | hgt
      · rw [hE_zero n _ _ (by show t + 1 ≠ p; omega) (by show t + 1 ≠ p + 1; omega),
          Limits.comp_zero]
      · rw [hg ⟨⟨p, hp⟩, k⟩ hgt, Limits.zero_comp]
  have hslot0 : ∀ n (g : wcFreeSheaf S U ⟶ wcCgevTotX I Rs n) (k : Fin (Rs.a 0)),
      g ≫ wcCgevTotD I lamI Rs n ≫ Limits.biproduct.π
        (fun y : Σ p : Fin (n + 1 + 1), Fin (Rs.a p) => I.cocomplex.X (n + 1 - y.1))
          ⟨⟨0, by omega⟩, k⟩ =
      (g ≫ Limits.biproduct.π
        (fun x : Σ p : Fin (n + 1), Fin (Rs.a p) => I.cocomplex.X (n - x.1)) ⟨⟨0, by omega⟩, k⟩) ≫
        I.cocomplex.d (n - 0) (n + 1 - 0) := by
    intro n g k
    rw [master, Finset.sum_eq_single_of_mem (⟨0, by omega⟩ : Fin (n + 1)) (Finset.mem_univ _) ?_]
    · rw [Finset.sum_eq_single_of_mem k (Finset.mem_univ _) ?_]
      · rw [hE_V0]
      · intro k₁ _ hk
        have : wcCgevTotEntry I lamI Rs n ⟨⟨0, by omega⟩, k₁⟩ ⟨⟨0, by omega⟩, k⟩ = 0 := by
          unfold wcCgevTotEntry
          rw [if_neg (fun h => hk (Fin.ext h.2.symm)), dif_neg (by show (0 : ℕ) ≠ 0 + 1; omega)]
        rw [this, Limits.comp_zero]
    · rintro ⟨p, hp⟩ _ hne
      refine Finset.sum_eq_zero (fun k₁ _ => ?_)
      have hp0 : p ≠ 0 := fun h => hne (Fin.ext h)
      rw [hE_zero n _ _ (by show 0 ≠ p; omega) (by show 0 ≠ p + 1; omega), Limits.comp_zero]
  have hkill : ∀ n s (hs : s ≤ n) (z : Fin (Rs.a s) → (wcFreeSheaf S U ⟶ I.cocomplex.X (n + 1 - (s + 1)))),
      ∃ w : wcFreeSheaf S U ⟶ wcCgevTotX I Rs n,
        (∀ y : Σ p : Fin (n + 1 + 1), Fin (Rs.a p), s + 1 < (y.1 : ℕ) →
          w ≫ wcCgevTotD I lamI Rs n ≫ Limits.biproduct.π
            (fun y : Σ p : Fin (n + 1 + 1), Fin (Rs.a p) => I.cocomplex.X (n + 1 - y.1)) y = 0) ∧
        ∀ k : Fin (Rs.a (s + 1)),
          w ≫ wcCgevTotD I lamI Rs n ≫ Limits.biproduct.π
            (fun y : Σ p : Fin (n + 1 + 1), Fin (Rs.a p) => I.cocomplex.X (n + 1 - y.1))
              ⟨⟨s + 1, by omega⟩, k⟩ =
          ∑ k₀, z k₀ ≫ (lamI (Rs.c s k k₀)).f (n + 1 - (s + 1)) := by
    intro n s hs z
    obtain ⟨w, hwdef⟩ : ∃ w : wcFreeSheaf S U ⟶ wcCgevTotX I Rs n, w = Limits.biproduct.lift
        (f := fun x : Σ p : Fin (n + 1), Fin (Rs.a p) => I.cocomplex.X (n - x.1))
        (fun x => if h : (x.1 : ℕ) = s then
          z (Fin.cast (congrArg Rs.a h) x.2) ≫
            (I.cocomplex.XIsoOfEq (by omega : n + 1 - (s + 1) = n - x.1)).hom
          else 0) := ⟨_, rfl⟩
    have hw : ∀ (p : Fin (n + 1)) (k : Fin (Rs.a p)), (p : ℕ) ≠ s →
        w ≫ Limits.biproduct.π
          (fun x : Σ p : Fin (n + 1), Fin (Rs.a p) => I.cocomplex.X (n - x.1)) ⟨p, k⟩ = 0 := by
      intro p k hp
      rw [hwdef]
      erw [Limits.biproduct.lift_π]
      rw [dif_neg hp]
    have hws : ∀ k₀ : Fin (Rs.a s),
        w ≫ Limits.biproduct.π
          (fun x : Σ p : Fin (n + 1), Fin (Rs.a p) => I.cocomplex.X (n - x.1)) ⟨⟨s, by omega⟩, k₀⟩ =
        z k₀ ≫ (I.cocomplex.XIsoOfEq (by omega : n + 1 - (s + 1) = n - s)).hom := by
      intro k₀
      rw [hwdef]
      erw [Limits.biproduct.lift_π]
      rw [dif_pos rfl]
      rfl
    have hsum : ∀ y, w ≫ wcCgevTotD I lamI Rs n ≫ Limits.biproduct.π
        (fun y : Σ p : Fin (n + 1 + 1), Fin (Rs.a p) => I.cocomplex.X (n + 1 - y.1)) y =
        ∑ k₀ : Fin (Rs.a s), (z k₀ ≫ (I.cocomplex.XIsoOfEq (by omega : n + 1 - (s + 1) = n - s)).hom) ≫
          wcCgevTotEntry I lamI Rs n ⟨⟨s, by omega⟩, k₀⟩ y := by
      intro y
      rw [master, Finset.sum_eq_single_of_mem (⟨s, by omega⟩ : Fin (n + 1)) (Finset.mem_univ _) ?_]
      · refine Finset.sum_congr rfl (fun k₀ _ => ?_)
        rw [hws]
      · rintro ⟨p, hp⟩ _ hne
        refine Finset.sum_eq_zero (fun k _ => ?_)
        rw [hw _ _ (fun h => hne (Fin.ext h)), Limits.zero_comp]
    refine ⟨w, fun y hy => ?_, fun k => ?_⟩
    · rw [hsum]
      refine Finset.sum_eq_zero (fun k₀ _ => ?_)
      rw [hE_zero n _ _ (by show (y.1 : ℕ) ≠ s; omega) (by show (y.1 : ℕ) ≠ s + 1; omega),
        Limits.comp_zero]
    · rw [hsum]
      refine Finset.sum_congr rfl (fun k₀ _ => ?_)
      rw [hE_H n s (by omega) k₀ k (by omega), Category.assoc,
        ← Category.assoc (I.cocomplex.XIsoOfEq _).hom,
        ← HomologicalComplex.XIsoOfEq_hom_naturality, Category.assoc,
        HomologicalComplex.XIsoOfEq_hom_comp_XIsoOfEq_hom, HomologicalComplex.XIsoOfEq_rfl,
        Iso.refl_hom, Category.comp_id]
  have hEmb0 : ∀ k : Fin (Rs.a 0), wcCgevEmbed I Rs (wcFreeSheaf S U) (m + 1) f ≫
      Limits.biproduct.π (fun y : Σ p : Fin (m + 1 + 1), Fin (Rs.a p) => I.cocomplex.X (m + 1 - y.1))
        ⟨⟨0, by omega⟩, k⟩ = f (Rs.ε (Pi.single k 1)) := by
    intro k
    unfold wcCgevEmbed
    erw [Limits.biproduct.lift_π]
    rw [dif_pos rfl]
    change f (Rs.ε (Pi.single k 1)) ≫ (I.cocomplex.XIsoOfEq (rfl : m + 1 = m + 1)).hom = _
    rw [HomologicalComplex.XIsoOfEq_rfl, Iso.refl_hom, Category.comp_id]
  have hEmbne : ∀ y : Σ p : Fin (m + 1 + 1), Fin (Rs.a p), (y.1 : ℕ) ≠ 0 →
      wcCgevEmbed I Rs (wcFreeSheaf S U) (m + 1) f ≫
        Limits.biproduct.π (fun y : Σ p : Fin (m + 1 + 1), Fin (Rs.a p) =>
          I.cocomplex.X (m + 1 - y.1)) y = 0 := by
    intro y hy
    unfold wcCgevEmbed
    erw [Limits.biproduct.lift_π]
    rw [dif_neg hy]
  have hTd : (wcCgevTot I lamI Rs hdd).d m (m + 1) = wcCgevTotD I lamI Rs m :=
    CochainComplex.of_d _ _ m
  rw [hTd] at hg
  have key : ∀ s, s ≤ m → ∀ g0 : wcFreeSheaf S U ⟶ wcCgevTotX I Rs m,
      (∀ x : Σ p : Fin (m + 1), Fin (Rs.a p), s < (x.1 : ℕ) → g0 ≫ Limits.biproduct.π
        (fun x : Σ p : Fin (m + 1), Fin (Rs.a p) => I.cocomplex.X (m - x.1)) x = 0) →
      g0 ≫ wcCgevTotD I lamI Rs m = wcCgevEmbed I Rs (wcFreeSheaf S U) (m + 1) f →
      ∃ h : N →+ (wcFreeSheaf S U ⟶ I.cocomplex.X m),
        (∀ (r : R) (x : N), h (r • x) = h x ≫ (lamI r).f m) ∧
        ∀ x : N, h x ≫ I.cocomplex.d m (m + 1) = f x := by
    intro s
    induction s with
    | zero =>
      intro _ g0 hsupp hg0
      have hy : ∀ k' : Fin (Rs.a (0 + 1)), ∑ k : Fin (Rs.a 0), (g0 ≫ Limits.biproduct.π
          (fun x : Σ p : Fin (m + 1), Fin (Rs.a p) => I.cocomplex.X (m - x.1)) ⟨⟨0, by omega⟩, k⟩) ≫
            (lamI (Rs.c 0 k' k)).f m = 0 := by
        intro k'
        have h1 := hrel m 0 (Nat.zero_le _) g0 hsupp k'
        erw [← Category.assoc, hg0, hEmbne _ (by show 0 + 1 ≠ 0; omega)] at h1
        exact (cancel_mono _).mp (h1.symm.trans Limits.zero_comp.symm)
      obtain ⟨h, hlin, hgen⟩ := hrow0 m (fun k => g0 ≫ Limits.biproduct.π
          (fun x : Σ p : Fin (m + 1), Fin (Rs.a p) => I.cocomplex.X (m - x.1)) ⟨⟨0, by omega⟩, k⟩) hy
      refine ⟨h, hlin, ?_⟩
      have hk : ∀ k, h (Rs.ε (Pi.single k 1)) ≫ I.cocomplex.d m (m + 1) =
          f (Rs.ε (Pi.single k 1)) := by
        intro k
        have h1 := hslot0 m g0 k
        erw [← Category.assoc, hg0, hEmb0] at h1
        rw [hgen k]
        exact h1.symm
      intro x
      obtain ⟨v, rfl⟩ := Rs.surj x
      have hv : v = ∑ k, v k • (Pi.single k (1 : R) : Fin (Rs.a 0) → R) := by
        ext j
        simp [Pi.single_apply, Finset.sum_apply]
      rw [hv, map_sum, map_sum, map_sum, Preadditive.sum_comp]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [map_smul, hlin, hf, Category.assoc, (lamI (v k)).comm m (m + 1), ← Category.assoc, hk]
    | succ s ih =>
      intro hs g0 hsupp hg0
      obtain ⟨n', rfl⟩ : ∃ n', m = n' + 1 := ⟨m - 1, by omega⟩
      have hy : ∀ k' : Fin (Rs.a (s + 1 + 1)), ∑ k : Fin (Rs.a (s + 1)), (g0 ≫ Limits.biproduct.π
          (fun x : Σ p : Fin (n' + 1 + 1), Fin (Rs.a p) => I.cocomplex.X (n' + 1 - x.1))
            ⟨⟨s + 1, by omega⟩, k⟩) ≫ (lamI (Rs.c (s + 1) k' k)).f (n' + 1 - (s + 1)) = 0 := by
        intro k'
        have h1 := hrel (n' + 1) (s + 1) hs g0 hsupp k'
        erw [← Category.assoc, hg0, hEmbne _ (by show s + 1 + 1 ≠ 0; omega)] at h1
        exact (cancel_mono _).mp (h1.symm.trans Limits.zero_comp.symm)
      obtain ⟨z, hz⟩ := hrowS (n' + 1 - (s + 1)) s (fun k => g0 ≫ Limits.biproduct.π
          (fun x : Σ p : Fin (n' + 1 + 1), Fin (Rs.a p) => I.cocomplex.X (n' + 1 - x.1))
            ⟨⟨s + 1, by omega⟩, k⟩) hy
      obtain ⟨w, hw1, hw2⟩ := hkill n' s (by omega) z
      refine ih (by omega) (g0 - w ≫ wcCgevTotD I lamI Rs n') ?_ ?_
      · intro x hx
        erw [Preadditive.sub_comp, Category.assoc]
        rcases Nat.lt_or_ge (s + 1) (x.1 : ℕ) with h | h
        · rw [hsupp x h, hw1 x h, sub_zero]
        · obtain ⟨⟨p, hp⟩, k⟩ := x
          have hp1 : p = s + 1 := by
            have h1 : s < p := hx
            have h2 : p ≤ s + 1 := h
            omega
          subst hp1
          rw [hw2 k, hz k, sub_self]
      · rw [Preadditive.sub_comp, Category.assoc, hdd, Limits.comp_zero, sub_zero, hg0]
  exact key m le_rfl g (fun x hx => absurd x.1.isLt (by omega)) hg

theorem wc_cgev_homological_package (S : Scheme.{u}) (U : S.ProEt) {R : Type u} [Ring R]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (lamG : R → (G ⟶ G))
    (hG : wcRingAct lamG) (I : InjectiveResolution G) (lamI : R → (I.cocomplex ⟶ I.cocomplex))
    (hI : wcRingResSpec lamG I lamI) (N : ModuleCat.{u+1} R) (Rs : wcCgevRes N)
    (h0 : Mono ((wcCgevK lamG hG Rs).d 0 1))
    (h2 : ∀ p, 2 ≤ p → (wcCgevK lamG hG Rs).ExactAt p)
    (hE : ∀ n, 3 ≤ n → ∀ x : Abelian.Ext (wcFreeSheaf S U) ((wcCgevK lamG hG Rs).homology 1) n,
      x = 0) :
    wcChmpVanD (fun r => ((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf S U))).mapHomologicalComplex
      (ComplexShape.up ℕ)).map (lamI r)) N :=
by
  classical
  have hinj := fun q => wc_chmp_res_ring_injective S U R G lamG I lamI hI q
  obtain ⟨hIact, hI0, -⟩ := hI
  have hdd := wc_cgev_tot_dsq I lamI hIact Rs
  have hcomm := wc_cgev_aug_comm lamG hG I lamI hI0 Rs
  haveI hqis : QuasiIso (wcCgevAug lamG hG I lamI Rs hdd hcomm) :=
    wc_cgev_tot_qis lamG hG I lamI Rs hdd hcomm
  have hTd : ∀ n, (wcCgevTot I lamI Rs hdd).d n (n + 1) = wcCgevTotD I lamI Rs n :=
    fun n => CochainComplex.of_d _ _ n
  have hinjT : ∀ q, Injective ((wcCgevTot I lamI Rs hdd).X q) := by
    intro q
    show Injective (wcCgevTotX I Rs q)
    unfold wcCgevTotX
    infer_instance
  have hqisAt : ∀ p, QuasiIsoAt (wcCgevAug lamG hG I lamI Rs hdd hcomm) p :=
    fun p => hqis.quasiIsoAt p
  have htr : ∀ p, (wcCgevK lamG hG Rs).ExactAt p → (wcCgevTot I lamI Rs hdd).ExactAt p :=
    fun p hp => (quasiIsoAt_iff_exactAt (wcCgevAug lamG hG I lamI Rs hdd hcomm) p hp).mp
      (hqisAt p)
  have hT0 : Mono ((wcCgevTot I lamI Rs hdd).d 0 1) := by
    have hK0 : (wcCgevK lamG hG Rs).ExactAt 0 := by
      rw [HomologicalComplex.exactAt_iff' _ 0 0 1 (by simp) (by simp)]
      rw [ShortComplex.exact_iff_mono _ ((wcCgevK lamG hG Rs).shape 0 0 (by simp))]
      exact h0
    have hT := htr 0 hK0
    rw [HomologicalComplex.exactAt_iff' _ 0 0 1 (by simp) (by simp)] at hT
    exact (ShortComplex.exact_iff_mono _ ((wcCgevTot I lamI Rs hdd).shape 0 0 (by simp))).mp hT
  have hT2 : ∀ p, 2 ≤ p → (wcCgevTot I lamI Rs hdd).ExactAt p := fun p hp => htr p (h2 p hp)
  have hiso : IsIso (HomologicalComplex.homologyMap (wcCgevAug lamG hG I lamI Rs hdd hcomm) 1) :=
    (quasiIsoAt_iff_isIso_homologyMap _ 1).mp (hqisAt 1)
  have hET : ∀ m, 3 ≤ m → ∀ x : Abelian.Ext (wcFreeSheaf S U)
      ((wcCgevTot I lamI Rs hdd).homology 1) m, x = 0 := by
    intro m hm x
    have hx : x.comp (Abelian.Ext.mk₀ (inv (HomologicalComplex.homologyMap
        (wcCgevAug lamG hG I lamI Rs hdd hcomm) 1))) (add_zero m) = 0 := hE m hm _
    calc x = (x.comp (Abelian.Ext.mk₀ (inv (HomologicalComplex.homologyMap
          (wcCgevAug lamG hG I lamI Rs hdd hcomm) 1))) (add_zero m)).comp
          (Abelian.Ext.mk₀ (HomologicalComplex.homologyMap
            (wcCgevAug lamG hG I lamI Rs hdd hcomm) 1)) (add_zero m) := by
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero m) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
      _ = 0 := by rw [hx, Abelian.Ext.zero_comp]
  intro j hj f hflin hfcoc
  obtain ⟨m, rfl⟩ : ∃ m, j = m + 1 := ⟨j - 1, by omega⟩
  let f' : N →+ (wcFreeSheaf S U ⟶ I.cocomplex.X (m + 1)) := f
  have hf' : ∀ (r : R) (x : N), f' (r • x) = f' x ≫ (lamI r).f (m + 1) := hflin
  have hfc' : ∀ x : N, f' x ≫ I.cocomplex.d (m + 1) (m + 1 + 1) = 0 := hfcoc
  have hemb := wc_cgev_embed_cocycle I lamI Rs (wcFreeSheaf S U) (m + 1) f' hf' hfc'
  obtain ⟨g, hg⟩ := wc_cgev_inj_truncation (wcFreeSheaf S U) (wcCgevTot I lamI Rs hdd) hinjT hT0
    hT2 hET m (by omega) (wcCgevEmbed I Rs (wcFreeSheaf S U) (m + 1) f')
    (by rw [hTd]; exact hemb)
  obtain ⟨h, hlin, hh⟩ := wc_cgev_tot_descent S U G I lamI hIact N Rs hdd hinj m f' hf' g hg
  exact ⟨h, fun r x => hlin r x, fun x => hh x⟩

theorem wc_chmp_geom_ext_vanish (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α) (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
    (lamF : MonoidAlgebra ℤ_[ℓ] Γ → (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ⟶ wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
    (hlamF : wcRingAct lamF)
    (hlamFs : ∀ (g : Γ) (a : ℤ_[ℓ]), lamF (MonoidAlgebra.single g a) =
      wcCoverScal (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ a ≫
        wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ
          (α g⁻¹).hom (hα g⁻¹))
    (I : InjectiveResolution (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
    (lamI : MonoidAlgebra ℤ_[ℓ] Γ → (I.cocomplex ⟶ I.cocomplex))
    (hI : wcRingResSpec lamF I lamI) :
    ∀ N : ModuleCat.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ), wcChmpTorsFG ℓ N →
      wcChmpVanD (fun r => ((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
          (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex (ComplexShape.up ℕ)).map
          (lamI r)) N :=
by
  classical
  intro N hN
  haveI : Finite Γ := hG.1
  haveI : IsNoetherianRing (MonoidAlgebra ℤ_[ℓ] Γ) := IsNoetherianRing.of_finite ℤ_[ℓ] _
  haveI : Module.Finite (MonoidAlgebra ℤ_[ℓ] Γ) N := hN.1
  obtain ⟨Rs⟩ := wc_cgev_free_resolution N
  obtain ⟨h0, h2, H, hH, ⟨e⟩⟩ := wc_cgev_local_coind_complex K ℓ hℓ m S hS Uo hUo q' Γ α hG hα
    lamF hlamF hlamFs N hN Rs
  have hcd := wc_cgev_P1_epsInv_torsion_cd K hP ℓ hℓ H hH
  refine wc_cgev_homological_package (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP) _ lamF
    hlamF I lamI hI N Rs h0 h2 ?_
  intro j hj x
  have hx : x.comp (Abelian.Ext.mk₀ e.hom) (add_zero j) = 0 := hcd j hj _
  calc x = (x.comp (Abelian.Ext.mk₀ e.hom) (add_zero j)).comp (Abelian.Ext.mk₀ e.inv)
        (add_zero j) := by
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero j) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, e.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    _ = 0 := by rw [hx, Abelian.Ext.zero_comp]

theorem wc_cover_model_head_projective (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α) (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
    (lamF : MonoidAlgebra ℤ_[ℓ] Γ → (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ⟶ wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
    (hlamF : wcRingAct lamF)
    (hlamFs : ∀ (g : Γ) (a : ℤ_[ℓ]), lamF (MonoidAlgebra.single g a) =
      wcCoverScal (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ a ≫
        wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ
          (α g⁻¹).hom (hα g⁻¹))
    (I : InjectiveResolution (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
    (lamI : MonoidAlgebra ℤ_[ℓ] Γ → (I.cocomplex ⟶ I.cocomplex))
    (hI : wcRingResSpec lamF I lamI)
    (T : wcThreeTermModel (((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
          (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex (ComplexShape.up ℕ)).obj
          I.cocomplex)
      (fun r => ((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
          (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex (ComplexShape.up ℕ)).map
          (lamI r))) :
    Module.Projective (MonoidAlgebra ℤ_[ℓ] Γ) T.M :=
by
  classical
  haveI : Finite Γ := hG.1
  have hℓpos : 0 < ℓ := (Fact.out : ℓ.Prime).pos
  obtain ⟨hIone, hIadd, hImul⟩ := hI.1

  have hD : wcRingAct (fun r => ((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf
      (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex
      (ComplexShape.up ℕ)).map (lamI r)) := by
    refine ⟨?_, ?_, ?_⟩
    · show CategoryTheory.Functor.map _ (lamI 1) = 𝟙 _
      rw [hIone, CategoryTheory.Functor.map_id]
    · intro a b
      show CategoryTheory.Functor.map _ (lamI (a + b)) =
        CategoryTheory.Functor.map _ (lamI a) + CategoryTheory.Functor.map _ (lamI b)
      rw [hIadd, CategoryTheory.Functor.map_add]
    · intro a b
      show CategoryTheory.Functor.map _ (lamI (a * b)) =
        CategoryTheory.Functor.map _ (lamI b) ≫ CategoryTheory.Functor.map _ (lamI a)
      rw [hImul, CategoryTheory.Functor.map_comp]

  have hR : ∀ r : MonoidAlgebra ℤ_[ℓ] Γ, ℓ • r = 0 → r = 0 := fun r h =>
    (smul_eq_zero.mp h).resolve_left hℓpos.ne'

  have hmono := wc_chmp_cover_nsmul_mono (q' ≫ Uo.ι)
    (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ℓ hℓpos
  have htf : ∀ x : T.M, ℓ • x = 0 → x = 0 :=
    wc_chmp_head_torsion_free (wcP1Over K).left _ ℓ hmono I (wcGeomPoint K (wcP1Over K) hP)
      (MonoidAlgebra ℤ_[ℓ] Γ) hR _ T

  have hinj := wc_chmp_res_ring_injective (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)
    (MonoidAlgebra ℤ_[ℓ] Γ) _ lamF I lamI hI

  have hgeom := wc_chmp_geom_ext_vanish K hP ℓ hℓ m S hS Uo hUo q' Γ α hG hα lamF hlamF hlamFs
    I lamI hI

  have h4 : ∀ N : ModuleCat.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ), wcChmpTorsFG ℓ N →
      ∀ j, 4 ≤ j → ∀ e : Abelian.Ext N T.M j, e = 0 := fun N hN =>
    wc_chmp_cone_ext_vanish _ _ hD T hinj N (hgeom N hN)
      (fun a k hk e => wc_chmp_ext_free_vanish ℓ Γ N a k hk e)
  have hemb : ∀ N : ModuleCat.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ), wcChmpTorsFG ℓ N →
      ∃ (k : ℕ) (e : N →ₗ[MonoidAlgebra ℤ_[ℓ] Γ] wcChmpModL (MonoidAlgebra ℤ_[ℓ] Γ) ℓ k),
        Function.Injective e := fun N hN => by
    haveI := hN.1
    exact wc_chmp_frob_embed ℓ Γ N hN.2
  have h2 := wc_chmp_torsion_shift ℓ Γ T.M hemb h4
  have hrel := wc_chmp_rel_baer ℓ Γ T.M htf h2

  have hQ : ∀ z : wcChmpModBar (MonoidAlgebra ℤ_[ℓ] Γ) ℓ T.M, ℓ • z = 0 := by
    intro z
    induction z using Submodule.Quotient.induction_on with
    | H x =>
      rw [← Submodule.Quotient.mk_smul]
      exact (Submodule.Quotient.mk_eq_zero _).mpr ⟨x, by
        first
          | rfl
          | simp only [LinearMap.smul_apply, LinearMap.id_apply]⟩
  haveI := T.fin
  have hembQ := wc_chmp_frob_embed ℓ Γ (wcChmpModBar (MonoidAlgebra ℤ_[ℓ] Γ) ℓ T.M) hQ
  have hsplitQ := wc_chmp_frob_ext_split ℓ Γ (wcChmpModBar (MonoidAlgebra ℤ_[ℓ] Γ) ℓ T.M) hQ
    hrel hembQ
  refine wc_chmp_lattice_lift ℓ Γ T.M htf ?_
  intro k π hπ
  have hle : LinearMap.range (ℓ • LinearMap.id :
      (Fin k → MonoidAlgebra ℤ_[ℓ] Γ) →ₗ[MonoidAlgebra ℤ_[ℓ] Γ] (Fin k → MonoidAlgebra ℤ_[ℓ] Γ)) ≤
      (LinearMap.range (ℓ • LinearMap.id : T.M →ₗ[MonoidAlgebra ℤ_[ℓ] Γ] T.M)).comap π := by
    rintro _ ⟨y, rfl⟩
    refine ⟨π y, ?_⟩
    show (ℓ • LinearMap.id : T.M →ₗ[MonoidAlgebra ℤ_[ℓ] Γ] T.M) (π y) =
      π ((ℓ • LinearMap.id : (Fin k → MonoidAlgebra ℤ_[ℓ] Γ) →ₗ[MonoidAlgebra ℤ_[ℓ] Γ]
        (Fin k → MonoidAlgebra ℤ_[ℓ] Γ)) y)
    rw [LinearMap.smul_apply, LinearMap.smul_apply, LinearMap.id_apply, LinearMap.id_apply,
      map_nsmul]
  let πb := Submodule.mapQ _ _ π hle
  have hπb : Function.Surjective πb := by
    intro z
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ z
    obtain ⟨y, rfl⟩ := hπ x
    exact ⟨Submodule.Quotient.mk y, Submodule.mapQ_apply _ _ _ _⟩
  obtain ⟨s, hs⟩ := hsplitQ k πb hπb
  refine ⟨s, fun x y hxy => ?_⟩
  calc (Submodule.Quotient.mk (π y) : wcChmpModBar (MonoidAlgebra ℤ_[ℓ] Γ) ℓ T.M)
      = πb (Submodule.Quotient.mk y) := (Submodule.mapQ_apply _ _ _ _).symm
    _ = πb (s (Submodule.Quotient.mk x)) := by rw [hxy]
    _ = Submodule.Quotient.mk x := by
      rw [← LinearMap.comp_apply, hs, LinearMap.id_apply]

theorem wc_gmodel_of_projective_head (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Γ : Type u) [Group Γ]
    (D : CochainComplex AddCommGrpCat.{u+1} ℕ) (lamD : MonoidAlgebra ℤ_[ℓ] Γ → (D ⟶ D))
    (hD : wcRingAct lamD) (Fr : D ⟶ D) (hFr : ∀ r, lamD r ≫ Fr = Fr ≫ lamD r)
    (T : wcThreeTermModel D lamD) (hT : Module.Projective (MonoidAlgebra ℤ_[ℓ] Γ) T.M) :
    ∃ (P : wcGModel ℓ Γ) (φ : wcGModelAb P ⟶ D), QuasiIso φ ∧
      (∀ γ : Γ, wcGModelAct P γ ≫ φ = φ ≫ lamD (MonoidAlgebra.single γ⁻¹ 1)) ∧
      Nonempty (Homotopy (wcGModelFrob P ≫ φ) (φ ≫ Fr)) :=
by
  classical
  have s1 : ∀ {K L : CochainComplex AddCommGrpCat.{u+1} ℕ} (φ : K ⟶ L),
      (∀ (n : ℕ) (x : K.X n), (K.d n (n + 1)).hom x = 0 → ∀ y : L.X (n - 1),
        (φ.f n).hom x = (L.d (n - 1) n).hom y → ∃ x' : K.X (n - 1), (K.d (n - 1) n).hom x' = x) →
      (∀ (n : ℕ) (y : L.X n), (L.d n (n + 1)).hom y = 0 → ∃ x : K.X n,
        (K.d n (n + 1)).hom x = 0 ∧ ∃ w : L.X (n - 1), (L.d (n - 1) n).hom w = (φ.f n).hom x - y) →
      QuasiIso φ := by
    intro K L φ hinj hsurj
    rw [quasiIso_iff]
    intro n
    have hp : (ComplexShape.up ℕ).prev n = n - 1 := by
      rcases n with _ | m
      · exact CochainComplex.prev_nat_zero
      · exact CochainComplex.prev_nat_succ m
    have hn : (ComplexShape.up ℕ).next n = n + 1 := ComplexShape.next_eq' _ rfl
    rw [quasiIsoAt_iff' φ (n - 1) n (n + 1) hp hn, ShortComplex.quasiIso_iff]
    have hmono : Mono (ShortComplex.homologyMap
        ((HomologicalComplex.shortComplexFunctor' AddCommGrpCat (ComplexShape.up ℕ)
          (n - 1) n (n + 1)).map φ)) := by
      rw [ShortComplex.mono_homologyMap_iff_up_to_refinements]
      intro A x₂ hx₂ y₁ hxy
      have hx : ∀ a, (K.d n (n + 1)).hom (x₂ a) = 0 := fun a => by
        exact congrArg (fun f => AddCommGrpCat.Hom.hom f a) hx₂
      have hy : ∀ a, (φ.f n).hom (x₂ a) = (L.d (n - 1) n).hom (y₁ a) := fun a => by
        exact congrArg (fun f => AddCommGrpCat.Hom.hom f a) hxy
      choose g hg using fun a => hinj n (x₂ a) (hx a) (y₁ a) (hy a)
      refine ⟨AddCommGrpCat.of (FreeAbelianGroup A),
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift id), ?_,
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift g), ?_⟩
      · rw [AddCommGrpCat.epi_iff_surjective]
        intro a
        exact ⟨FreeAbelianGroup.of a, by simp [FreeAbelianGroup.lift_apply_of]⟩
      · ext z
        change x₂.hom (FreeAbelianGroup.lift id (FreeAbelianGroup.of z)) =
          (K.d (n - 1) n).hom (FreeAbelianGroup.lift g (FreeAbelianGroup.of z))
        rw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
        exact (hg z).symm
    have hepi : Epi (ShortComplex.homologyMap
        ((HomologicalComplex.shortComplexFunctor' AddCommGrpCat (ComplexShape.up ℕ)
          (n - 1) n (n + 1)).map φ)) := by
      rw [ShortComplex.epi_homologyMap_iff_up_to_refinements]
      intro A y₂ hy₂
      have hy : ∀ a, (L.d n (n + 1)).hom (y₂ a) = 0 := fun a => by
        exact congrArg (fun f => AddCommGrpCat.Hom.hom f a) hy₂
      choose x hx w hw using fun a => hsurj n (y₂ a) (hy a)
      refine ⟨AddCommGrpCat.of (FreeAbelianGroup A),
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift id), ?_,
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift x), ?_,
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun a => -w a)), ?_⟩
      · rw [AddCommGrpCat.epi_iff_surjective]
        intro a
        exact ⟨FreeAbelianGroup.of a, by simp [FreeAbelianGroup.lift_apply_of]⟩
      · ext z
        change (K.d n (n + 1)).hom (FreeAbelianGroup.lift x (FreeAbelianGroup.of z)) = 0
        rw [FreeAbelianGroup.lift_apply_of]
        exact hx z
      · ext z
        have e := hw z
        change y₂.hom (FreeAbelianGroup.lift id (FreeAbelianGroup.of z)) =
          (φ.f n).hom (FreeAbelianGroup.lift x (FreeAbelianGroup.of z)) +
          (L.d (n - 1) n).hom (FreeAbelianGroup.lift (fun a => -w a) (FreeAbelianGroup.of z))
        rw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of,
          FreeAbelianGroup.lift_apply_of, map_neg]
        change _ = _ + -((L.d (n - 1) n).hom (w z))
        rw [e]
        have key : ∀ (G : Type (u+1)) [AddCommGroup G] (a b : G), b = a + -(a - b) :=
          fun G _ a b => by abel
        exact key _ _ _
    exact isIso_of_mono_of_epi _

  have lmul : ∀ (m : ℕ) (a b : (MonoidAlgebra ℤ_[ℓ] Γ)) (x : D.X m),
      ((lamD (a * b)).f m).hom x = ((lamD a).f m).hom (((lamD b).f m).hom x) := by
    intro m a b x
    rw [hD.2.2 a b, HomologicalComplex.comp_f]
    rfl
  have ladd : ∀ (m : ℕ) (a b : (MonoidAlgebra ℤ_[ℓ] Γ)) (x : D.X m),
      ((lamD (a + b)).f m).hom x = ((lamD a).f m).hom x + ((lamD b).f m).hom x := by
    intro m a b x
    rw [hD.2.1 a b, HomologicalComplex.add_f_apply]
    rfl
  have l0 : ∀ (m : ℕ) (x : D.X m), ((lamD 0).f m).hom x = 0 := by
    intro m x
    have h := ladd m 0 0 x
    rw [add_zero] at h
    exact left_eq_add.mp h |>.symm ▸ rfl
  have ld : ∀ (m m' : ℕ) (r : (MonoidAlgebra ℤ_[ℓ] Γ)) (x : D.X m),
      (D.d m m').hom (((lamD r).f m).hom x) = ((lamD r).f m').hom ((D.d m m').hom x) := by
    intro m m' r x
    have h := congrArg (fun f => AddCommGrpCat.Hom.hom f x) ((lamD r).comm m m')
    exact h
  have Frl : ∀ (m : ℕ) (r : (MonoidAlgebra ℤ_[ℓ] Γ)) (x : D.X m),
      (Fr.f m).hom (((lamD r).f m).hom x) = ((lamD r).f m).hom ((Fr.f m).hom x) := by
    intro m r x
    have h := congrArg (fun f => AddCommGrpCat.Hom.hom (HomologicalComplex.Hom.f f m) x) (hFr r)
    exact h
  have Frd : ∀ (m m' : ℕ) (x : D.X m),
      (D.d m m').hom ((Fr.f m).hom x) = (Fr.f m').hom ((D.d m m').hom x) := by
    intro m m' x
    have h := congrArg (fun f => AddCommGrpCat.Hom.hom f x) (Fr.comm m m')
    exact h
  have pdec : ∀ {n : ℕ} (p : Fin n → (MonoidAlgebra ℤ_[ℓ] Γ)), p = ∑ j, p j • Pi.single j (1 : (MonoidAlgebra ℤ_[ℓ] Γ)) := by
    intro n p
    conv_lhs => rw [← Finset.univ_sum_single p]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [← Pi.single_smul', smul_eq_mul, mul_one]
  have dec : ∀ {n : ℕ} (m : ℕ) (α : (Fin n → (MonoidAlgebra ℤ_[ℓ] Γ)) →+ D.X m),
      (∀ (r : (MonoidAlgebra ℤ_[ℓ] Γ)) (p : Fin n → (MonoidAlgebra ℤ_[ℓ] Γ)), α (r • p) = ((lamD r).f m).hom (α p)) →
      ∀ p, α p = ∑ j, ((lamD (p j)).f m).hom (α (Pi.single j 1)) := by
    intro n m α hα p
    conv_lhs => rw [pdec p]
    rw [map_sum]
    exact Finset.sum_congr rfl (fun j _ => hα _ _)

  have mkH : ∀ {n : ℕ} (m : ℕ) (w : Fin n → D.X m), ∃ h : (Fin n → (MonoidAlgebra ℤ_[ℓ] Γ)) →+ D.X m,
      (∀ p, h p = ∑ j, ((lamD (p j)).f m).hom (w j)) ∧
      (∀ (r : (MonoidAlgebra ℤ_[ℓ] Γ)) (p : Fin n → (MonoidAlgebra ℤ_[ℓ] Γ)), h (r • p) = ((lamD r).f m).hom (h p)) := by
    intro n m w
    refine ⟨{ toFun := fun p => ∑ j, ((lamD (p j)).f m).hom (w j)
              map_zero' := ?_
              map_add' := ?_ }, fun p => rfl, ?_⟩
    · simp only [Pi.zero_apply]
      exact Finset.sum_eq_zero (fun j _ => l0 m _)
    · intro p q
      simp only [Pi.add_apply]
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun j _ => ladd m _ _ _)
    · intro r p
      simp only [AddMonoidHom.coe_mk, ZeroHom.coe_mk, Pi.smul_apply, smul_eq_mul]
      rw [map_sum]
      exact Finset.sum_congr rfl (fun j _ => lmul m _ _ _)

  obtain ⟨F2, h2, hh2, hH2⟩ : ∃ (F2 : (Fin T.b → (MonoidAlgebra ℤ_[ℓ] Γ)) →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)] (Fin T.b → (MonoidAlgebra ℤ_[ℓ] Γ))) (h2 : (Fin T.b → (MonoidAlgebra ℤ_[ℓ] Γ)) →+ D.X 1),
      (∀ (r : (MonoidAlgebra ℤ_[ℓ] Γ)) (p : Fin T.b → (MonoidAlgebra ℤ_[ℓ] Γ)), h2 (r • p) = ((lamD r).f 1).hom (h2 p)) ∧
      ∀ p, T.α2 (F2 p) = (Fr.f 2).hom (T.α2 p) + (D.d 1 2).hom (h2 p) := by
    have cyc : ∀ j : Fin T.b, (D.d 2 3).hom ((Fr.f 2).hom (T.α2 (Pi.single j 1))) = 0 := by
      intro j
      rw [Frd, T.hc2, map_zero]
    choose P w hw using fun j => T.q2s _ (cyc j)
    obtain ⟨h2, hh2e, hh2⟩ := mkH 1 w
    refine ⟨Fintype.linearCombination (MonoidAlgebra ℤ_[ℓ] Γ) P, h2, hh2, fun p => ?_⟩
    rw [Fintype.linearCombination_apply, map_sum, dec 2 T.α2 T.hlin2 p, map_sum, hh2e, map_sum,
      ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [T.hlin2, Frl, ld, ← map_add, hw j, add_sub_cancel]


  obtain ⟨F1, h1, hh1, hC1, hH1⟩ : ∃ (F1 : (Fin T.a → (MonoidAlgebra ℤ_[ℓ] Γ)) →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)] (Fin T.a → (MonoidAlgebra ℤ_[ℓ] Γ)))
      (h1 : (Fin T.a → (MonoidAlgebra ℤ_[ℓ] Γ)) →+ D.X 0),
      (∀ (r : (MonoidAlgebra ℤ_[ℓ] Γ)) (p : Fin T.a → (MonoidAlgebra ℤ_[ℓ] Γ)), h1 (r • p) = ((lamD r).f 0).hom (h1 p)) ∧
      (∀ p, T.d1 (F1 p) = F2 (T.d1 p)) ∧
      ∀ p, T.α1 (F1 p) = (Fr.f 1).hom (T.α1 p) + h2 (T.d1 p) + (D.d 0 1).hom (h1 p) := by
    have hz : ∀ i : Fin T.a, (D.d 1 2).hom ((Fr.f 1).hom (T.α1 (Pi.single i 1)) +
        h2 (T.d1 (Pi.single i 1))) = T.α2 (F2 (T.d1 (Pi.single i 1))) := by
      intro i
      rw [map_add, Frd, T.hc1, hH2]
      try abel
    choose u hu using fun i => T.q2i _ ⟨_, hz i⟩
    have hy : ∀ i : Fin T.a, (D.d 1 2).hom (T.α1 (u i) - ((Fr.f 1).hom (T.α1 (Pi.single i 1)) +
        h2 (T.d1 (Pi.single i 1)))) = 0 := by
      intro i
      rw [map_sub, hz, T.hc1, hu, sub_self]
    choose c hc w hw using fun i => T.q1s _ (hy i)
    obtain ⟨h1, hh1e, hh1⟩ := mkH 0 (fun i => -w i)
    have hPd : ∀ i, T.d1 (u i - c i) = F2 (T.d1 (Pi.single i 1)) := by
      intro i; rw [map_sub, hu, hc, sub_zero]
    have hPa : ∀ i, T.α1 (u i - c i) = (Fr.f 1).hom (T.α1 (Pi.single i 1)) +
        h2 (T.d1 (Pi.single i 1)) + (D.d 0 1).hom (-w i) := by
      intro i
      rw [map_neg, hw, map_sub]
      abel
    have hdl : ∀ p : Fin T.a → (MonoidAlgebra ℤ_[ℓ] Γ), T.d1 p = ∑ i, p i • T.d1 (Pi.single i 1) := by
      intro p
      conv_lhs => rw [pdec p]
      rw [map_sum]
      exact Finset.sum_congr rfl (fun i _ => map_smul _ _ _)
    refine ⟨Fintype.linearCombination (MonoidAlgebra ℤ_[ℓ] Γ) (fun i => u i - c i), h1, hh1, fun p => ?_, fun p => ?_⟩
    · rw [Fintype.linearCombination_apply, map_sum, hdl p, map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_smul, map_smul, hPd]
    · have hsl : ∀ (r : (MonoidAlgebra ℤ_[ℓ] Γ)) (q : Fin T.a → (MonoidAlgebra ℤ_[ℓ] Γ)), (h2.comp T.d1.toAddMonoidHom) (r • q) =
          ((lamD r).f 1).hom ((h2.comp T.d1.toAddMonoidHom) q) := by
        intro r q
        simp only [AddMonoidHom.coe_comp, Function.comp_apply, LinearMap.toAddMonoidHom_coe,
          map_smul]
        exact hh2 r _
      have e2 := dec 1 (h2.comp T.d1.toAddMonoidHom) hsl p
      simp only [AddMonoidHom.coe_comp, Function.comp_apply, LinearMap.toAddMonoidHom_coe] at e2
      rw [Fintype.linearCombination_apply, map_sum, dec 1 T.α1 T.hlin1 p, e2, hh1e, map_sum,
        map_sum, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [T.hlin1, hPa, map_add, map_add, Frl, ld]


  haveI := T.fin
  obtain ⟨k, π, hπ⟩ := Module.Finite.exists_fin' (MonoidAlgebra ℤ_[ℓ] Γ) T.M
  obtain ⟨sec, hsec⟩ := Module.projective_lifting_property π LinearMap.id hπ
  have hπs : ∀ x, π (sec x) = x := fun x => congrArg (fun f => f x) hsec

  obtain ⟨FM, hC0, hH0⟩ : ∃ FM : T.M →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)] T.M,
      (∀ x, T.d0 (FM x) = F1 (T.d0 x)) ∧
      ∀ x, T.α0 (FM x) = (Fr.f 0).hom (T.α0 x) + h1 (T.d0 x) := by
    have hz : ∀ j : Fin k, (D.d 0 1).hom ((Fr.f 0).hom (T.α0 (π (Pi.single j 1))) +
        h1 (T.d0 (π (Pi.single j 1)))) = T.α1 (F1 (T.d0 (π (Pi.single j 1)))) := by
      intro j
      rw [map_add, Frd, T.hc0, hH1, T.hdd, map_zero]
      abel
    have hzz : ∀ j : Fin k, T.d1 (F1 (T.d0 (π (Pi.single j 1)))) = 0 := by
      intro j; rw [hC1, T.hdd, map_zero]
    choose x' hx' using fun j => T.q1i _ (hzz j) ⟨_, hz j⟩
    have hy : ∀ j : Fin k, (D.d 0 1).hom (T.α0 (x' j) - ((Fr.f 0).hom (T.α0 (π (Pi.single j 1))) +
        h1 (T.d0 (π (Pi.single j 1))))) = 0 := by
      intro j
      rw [map_sub, hz, T.hc0, hx', sub_self]
    choose c hc hca using fun j => T.q0s _ (hy j)
    have hXd : ∀ j, T.d0 (x' j - c j) = F1 (T.d0 (π (Pi.single j 1))) := by
      intro j; rw [map_sub, hx', hc, sub_zero]
    have hXa : ∀ j, T.α0 (x' j - c j) = (Fr.f 0).hom (T.α0 (π (Pi.single j 1))) +
        h1 (T.d0 (π (Pi.single j 1))) := by
      intro j; rw [map_sub, hca, sub_sub_cancel]
    refine ⟨(Fintype.linearCombination (MonoidAlgebra ℤ_[ℓ] Γ) (fun j => x' j - c j)) ∘ₗ sec, fun x => ?_, fun x => ?_⟩
    · rw [LinearMap.comp_apply, Fintype.linearCombination_apply, map_sum]
      conv_rhs => rw [← hπs x, pdec (sec x), map_sum, map_sum, map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_smul, map_smul, map_smul, map_smul, hXd]
    · rw [LinearMap.comp_apply, Fintype.linearCombination_apply, map_sum]
      have ea : T.α0 x = ∑ j, ((lamD (sec x j)).f 0).hom (T.α0 (π (Pi.single j 1))) := by
        conv_lhs => rw [← hπs x, pdec (sec x), map_sum, map_sum]
        exact Finset.sum_congr rfl (fun j _ => by rw [map_smul, T.hlin0])
      have eh : h1 (T.d0 x) = ∑ j, ((lamD (sec x j)).f 0).hom (h1 (T.d0 (π (Pi.single j 1)))) := by
        conv_lhs => rw [← hπs x, pdec (sec x), map_sum, map_sum, map_sum]
        exact Finset.sum_congr rfl (fun j _ => by rw [map_smul, map_smul, hh1])
      rw [ea, eh, map_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [T.hlin0, hXa, map_add, Frl]

  have hmat : ∀ {m n : ℕ} (g : (Fin m → (MonoidAlgebra ℤ_[ℓ] Γ)) →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)] (Fin n → (MonoidAlgebra ℤ_[ℓ] Γ))) (v : Fin m → (MonoidAlgebra ℤ_[ℓ] Γ)),
      Matrix.vecMul v (LinearMap.toMatrixRight' g) = g v := by
    intro m n g v
    rw [← Matrix.toLinearMapRight'_apply]
    show LinearMap.toMatrixRight'.symm (LinearMap.toMatrixRight' g) v = g v
    rw [LinearEquiv.symm_apply_apply]
  have hcomp : ∀ {l m n : ℕ} (f : (Fin l → (MonoidAlgebra ℤ_[ℓ] Γ)) →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)] (Fin m → (MonoidAlgebra ℤ_[ℓ] Γ)))
      (g : (Fin m → (MonoidAlgebra ℤ_[ℓ] Γ)) →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)] (Fin n → (MonoidAlgebra ℤ_[ℓ] Γ))) (h : (Fin l → (MonoidAlgebra ℤ_[ℓ] Γ)) →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)] (Fin n → (MonoidAlgebra ℤ_[ℓ] Γ))),
      (∀ v, g (f v) = h v) →
      LinearMap.toMatrixRight' f * LinearMap.toMatrixRight' g = LinearMap.toMatrixRight' h := by
    intro l m n f g h hfg
    rw [← LinearMap.toMatrixRight'_comp]
    congr 1
    exact LinearMap.ext hfg
  let kf : ℕ → ℕ := fun i => match i with
    | 0 => k | 1 => T.a | 2 => T.b | _ + 3 => 0
  let E0 := LinearMap.toMatrixRight' (sec ∘ₗ π)
  let D0 := LinearMap.toMatrixRight' (T.d0 ∘ₗ π)
  let D1 := LinearMap.toMatrixRight' T.d1
  let G0 := LinearMap.toMatrixRight' (sec ∘ₗ FM ∘ₗ π)
  let G1 := LinearMap.toMatrixRight' F1
  let G2 := LinearMap.toMatrixRight' F2
  let εf : ∀ i, Matrix (Fin (kf i)) (Fin (kf i)) (MonoidAlgebra ℤ_[ℓ] Γ) := fun i => match i with
    | 0 => E0 | 1 => 1 | 2 => 1 | _ + 3 => 1
  let δf : ∀ i, Matrix (Fin (kf i)) (Fin (kf (i + 1))) (MonoidAlgebra ℤ_[ℓ] Γ) := fun i => match i with
    | 0 => D0 | 1 => D1 | 2 => 0 | _ + 3 => 0
  let ff : ∀ i, Matrix (Fin (kf i)) (Fin (kf i)) (MonoidAlgebra ℤ_[ℓ] Γ) := fun i => match i with
    | 0 => G0 | 1 => G1 | 2 => G2 | _ + 3 => 0
  have hE0 : E0 * E0 = E0 := hcomp _ _ _ (fun v => by simp [hπs])
  have hE0D : E0 * D0 = D0 := hcomp _ _ _ (fun v => by simp [hπs])
  have hDD : D0 * D1 = 0 := by
    rw [hcomp _ _ (0 : (Fin k → (MonoidAlgebra ℤ_[ℓ] Γ)) →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)] (Fin T.b → (MonoidAlgebra ℤ_[ℓ] Γ))) (fun v => by simp [T.hdd]), map_zero]
  have hEG : E0 * G0 = G0 := hcomp _ _ _ (fun v => by simp [hπs])
  have hGE : G0 * E0 = G0 := hcomp _ _ _ (fun v => by simp [hπs])
  have hDG : D0 * G1 = G0 * D0 := by
    rw [hcomp _ _ (F1 ∘ₗ T.d0 ∘ₗ π) (fun v => rfl), hcomp _ _ (F1 ∘ₗ T.d0 ∘ₗ π)
      (fun v => by simp [hπs, hC0])]
  have hDG1 : D1 * G2 = G1 * D1 := by
    rw [hcomp _ _ (F2 ∘ₗ T.d1) (fun v => rfl), hcomp _ _ (F2 ∘ₗ T.d1) (fun v => by simp [hC1])]
  let P : wcGModel ℓ Γ :=
    { k := kf
      hk := fun i hi => by
        obtain ⟨n, rfl⟩ : ∃ n, i = n + 3 := ⟨i - 3, by omega⟩
        rfl
      ε := εf
      hε := fun i => match i with
        | 0 => hE0 | 1 => Matrix.mul_one _ | 2 => Matrix.mul_one _ | _ + 3 => Matrix.mul_one _
      δ := δf
      hδδ := fun i => match i with
        | 0 => hDD | 1 => Matrix.mul_zero _ | 2 => Matrix.zero_mul _ | _ + 3 => Matrix.zero_mul _
      hεδ := fun i => match i with
        | 0 => hE0D | 1 => Matrix.one_mul _ | 2 => Matrix.one_mul _ | _ + 3 => Matrix.one_mul _
      hδε := fun i => match i with
        | 0 => Matrix.mul_one _ | 1 => Matrix.mul_one _ | 2 => Matrix.zero_mul _
        | _ + 3 => Matrix.zero_mul _
      f := ff
      hεf := fun i => match i with
        | 0 => hEG | 1 => Matrix.one_mul _ | 2 => Matrix.one_mul _ | _ + 3 => Matrix.one_mul _
      hfε := fun i => match i with
        | 0 => hGE | 1 => Matrix.mul_one _ | 2 => Matrix.mul_one _ | _ + 3 => Matrix.mul_one _
      hδf := fun i => match i with
        | 0 => hDG | 1 => hDG1 | 2 => (Matrix.zero_mul _).trans (Matrix.mul_zero _).symm
        | _ + 3 => (Matrix.zero_mul _).trans (Matrix.mul_zero _).symm }


  have hKd : ∀ i, (wcGModelAb P).d i (i + 1) =
      AddCommGrpCat.ofHom (wcULiftHom (wcVecMulHom (P.ε i) (P.ε (i + 1)) (P.δ i) (P.hδε i))) := by
    intro i
    dsimp only [wcGModelAb]
    exact CochainComplex.of_d _ _ i
  have hsub : ∀ (n : ℕ) (x : (wcGModelAb P).X (n + 3)), x = 0 := by
    intro n x
    exact ULift.ext _ _ (Subtype.ext (funext fun i => Fin.elim0 i))
  let φf : ∀ i, (wcGModelAb P).X i ⟶ D.X i := fun i => match i with
    | 0 => AddCommGrpCat.ofHom ((T.α0.comp π.toAddMonoidHom).comp
        ((wcIdemSub E0).subtype.comp AddEquiv.ulift.toAddMonoidHom))
    | 1 => AddCommGrpCat.ofHom (T.α1.comp
        ((wcIdemSub (1 : Matrix (Fin T.a) (Fin T.a) (MonoidAlgebra ℤ_[ℓ] Γ))).subtype.comp
          AddEquiv.ulift.toAddMonoidHom))
    | 2 => AddCommGrpCat.ofHom (T.α2.comp
        ((wcIdemSub (1 : Matrix (Fin T.b) (Fin T.b) (MonoidAlgebra ℤ_[ℓ] Γ))).subtype.comp
          AddEquiv.ulift.toAddMonoidHom))
    | _ + 3 => 0
  let φ : wcGModelAb P ⟶ D := HomologicalComplex.Hom.mk φf (by
    rintro i j (rfl : i + 1 = j)
    rw [hKd i]
    match i with
    | 0 =>
      ext x
      show (D.d 0 1).hom (T.α0 (π x.down.1)) =
        T.α1 (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' (T.d0 ∘ₗ π)))
      rw [hmat]
      exact T.hc0 _
    | 1 =>
      ext x
      show (D.d 1 2).hom (T.α1 x.down.1) =
        T.α2 (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' T.d1))
      rw [hmat]
      exact T.hc1 _
    | 2 =>
      ext x
      show (D.d 2 3).hom (T.α2 x.down.1) = 0
      exact T.hc2 _
    | n + 3 =>
      ext x
      rw [hsub n x]
      simp only [map_zero])
  have hinj : ∀ (n : ℕ) (x : (wcGModelAb P).X n), ((wcGModelAb P).d n (n + 1)).hom x = 0 →
      ∀ y : D.X (n - 1), (φ.f n).hom x = (D.d (n - 1) n).hom y →
      ∃ x' : (wcGModelAb P).X (n - 1), ((wcGModelAb P).d (n - 1) n).hom x' = x := by
    intro n
    match n with
    | 0 =>
      intro x hx y hxy
      rw [hKd] at hx
      have h2 : T.d0 (π x.down.1) = 0 :=
        (hmat (T.d0 ∘ₗ π) x.down.1).symm.trans (congrArg (fun z => (ULift.down z).1) hx)
      rw [D.shape (0 - 1) 0 (by decide)] at hxy
      have ha : T.α0 (π x.down.1) = 0 := hxy
      have hπ0 : π x.down.1 = 0 := T.q0i _ h2 ha
      have hv : x.down.1 = 0 := by
        have hm : Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' (sec ∘ₗ π)) = x.down.1 :=
          x.down.2
        rw [hmat, LinearMap.comp_apply, hπ0, map_zero] at hm
        exact hm.symm
      refine ⟨0, ?_⟩
      rw [map_zero]
      exact (ULift.ext _ _ (Subtype.ext hv)).symm
    | 1 =>
      intro x hx y hxy
      rw [hKd] at hx
      have hd : T.d1 x.down.1 = 0 :=
        (hmat T.d1 x.down.1).symm.trans (congrArg (fun z => (ULift.down z).1) hx)
      have hxy' : (D.d 0 1).hom y = T.α1 x.down.1 := hxy.symm
      obtain ⟨m, hm⟩ := T.q1i _ hd ⟨y, hxy'⟩
      have hmem : Matrix.vecMul (sec m) (LinearMap.toMatrixRight' (sec ∘ₗ π)) = sec m := by
        rw [hmat, LinearMap.comp_apply, hπs]
      refine ⟨ULift.up ⟨sec m, hmem⟩, ?_⟩
      show ((wcGModelAb P).d 0 (0 + 1)).hom _ = x
      rw [hKd]
      apply ULift.ext
      apply Subtype.ext
      show Matrix.vecMul (sec m) (LinearMap.toMatrixRight' (T.d0 ∘ₗ π)) = x.down.1
      rw [hmat, LinearMap.comp_apply, hπs, hm]
    | 2 =>
      intro x hx y hxy
      have hxy' : (D.d 1 2).hom y = T.α2 x.down.1 := hxy.symm
      obtain ⟨p', hp'⟩ := T.q2i _ ⟨y, hxy'⟩
      refine ⟨ULift.up ⟨p', Matrix.vecMul_one p'⟩, ?_⟩
      show ((wcGModelAb P).d 1 (1 + 1)).hom _ = x
      rw [hKd]
      apply ULift.ext
      apply Subtype.ext
      show Matrix.vecMul p' (LinearMap.toMatrixRight' T.d1) = x.down.1
      rw [hmat, hp']
    | n + 3 =>
      intro x hx y hxy
      refine ⟨0, ?_⟩
      rw [map_zero]
      exact (hsub n x).symm
  have hsurj : ∀ (n : ℕ) (y : D.X n), (D.d n (n + 1)).hom y = 0 →
      ∃ x : (wcGModelAb P).X n, ((wcGModelAb P).d n (n + 1)).hom x = 0 ∧
      ∃ w : D.X (n - 1), (D.d (n - 1) n).hom w = (φ.f n).hom x - y := by
    intro n
    match n with
    | 0 =>
      intro y hy
      obtain ⟨m, hm0, hma⟩ := T.q0s y hy
      have hmem : Matrix.vecMul (sec m) (LinearMap.toMatrixRight' (sec ∘ₗ π)) = sec m := by
        rw [hmat, LinearMap.comp_apply, hπs]
      refine ⟨ULift.up ⟨sec m, hmem⟩, ?_, 0, ?_⟩
      · rw [hKd]
        apply ULift.ext
        apply Subtype.ext
        show Matrix.vecMul (sec m) (LinearMap.toMatrixRight' (T.d0 ∘ₗ π)) = 0
        rw [hmat, LinearMap.comp_apply, hπs, hm0]
      · rw [map_zero]
        show (0 : D.X 0) = T.α0 (π (sec m)) - y
        rw [hπs, hma, sub_self]
    | 1 =>
      intro y hy
      obtain ⟨p, hp, w, hw⟩ := T.q1s y hy
      refine ⟨ULift.up ⟨p, Matrix.vecMul_one p⟩, ?_, w, hw⟩
      rw [hKd]
      apply ULift.ext
      apply Subtype.ext
      show Matrix.vecMul p (LinearMap.toMatrixRight' T.d1) = 0
      rw [hmat, hp]
    | 2 =>
      intro y hy
      obtain ⟨p, w, hw⟩ := T.q2s y hy
      exact ⟨ULift.up ⟨p, Matrix.vecMul_one p⟩, hsub 0 _, w, hw⟩
    | n + 3 =>
      intro y hy
      obtain ⟨w, hw⟩ := T.qhi (n + 3) (by omega) y hy
      refine ⟨0, map_zero _, -w, ?_⟩
      rw [map_neg, hw, map_zero, zero_sub]
  have hequiv : ∀ γ : Γ, wcGModelAct P γ ≫ φ = φ ≫ lamD (MonoidAlgebra.single γ⁻¹ 1) := by
    intro γ
    apply HomologicalComplex.hom_ext
    intro i
    rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f]
    match i with
    | 0 =>
      ext x
      show T.α0 (π (MonoidAlgebra.single γ⁻¹ (1 : ℤ_[ℓ]) • x.down.1)) =
        ((lamD (MonoidAlgebra.single γ⁻¹ 1)).f 0).hom (T.α0 (π x.down.1))
      rw [map_smul, T.hlin0]
    | 1 =>
      ext x
      show T.α1 (MonoidAlgebra.single γ⁻¹ (1 : ℤ_[ℓ]) • x.down.1) =
        ((lamD (MonoidAlgebra.single γ⁻¹ 1)).f 1).hom (T.α1 x.down.1)
      exact T.hlin1 _ _
    | 2 =>
      ext x
      show T.α2 (MonoidAlgebra.single γ⁻¹ (1 : ℤ_[ℓ]) • x.down.1) =
        ((lamD (MonoidAlgebra.single γ⁻¹ 1)).f 2).hom (T.α2 x.down.1)
      exact T.hlin2 _ _
    | n + 3 =>
      ext x
      rw [hsub n x, map_zero, map_zero]
  let hom : ∀ i j, (wcGModelAb P).X i ⟶ D.X j := fun i j => match i, j with
    | 1, 0 => AddCommGrpCat.ofHom (h1.comp
        ((wcIdemSub (1 : Matrix (Fin T.a) (Fin T.a) (MonoidAlgebra ℤ_[ℓ] Γ))).subtype.comp
          AddEquiv.ulift.toAddMonoidHom))
    | 2, 1 => AddCommGrpCat.ofHom (h2.comp
        ((wcIdemSub (1 : Matrix (Fin T.b) (Fin T.b) (MonoidAlgebra ℤ_[ℓ] Γ))).subtype.comp
          AddEquiv.ulift.toAddMonoidHom))
    | _, _ => 0
  have htpy : Homotopy (wcGModelFrob P ≫ φ) (φ ≫ Fr) :=
    { hom := hom
      zero := by
        intro i j hij
        match i, j with
        | 0, _ => rfl
        | 1, 0 => exact absurd rfl hij
        | 1, _ + 1 => rfl
        | 2, 0 => rfl
        | 2, 1 => exact absurd rfl hij
        | 2, _ + 2 => rfl
        | _ + 3, _ => rfl
      comm := by
        intro i
        match i with
        | 0 =>
          rw [Homotopy.dNext_cochainComplex, Homotopy.prevD_zero_cochainComplex, hKd]
          ext x
          show T.α0 (π (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' (sec ∘ₗ FM ∘ₗ π)))) =
            h1 (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' (T.d0 ∘ₗ π))) + 0 +
              (Fr.f 0).hom (T.α0 (π x.down.1))
          rw [hmat, hmat, LinearMap.comp_apply, LinearMap.comp_apply, LinearMap.comp_apply, hπs,
            hH0, add_zero, add_comm]
        | 1 =>
          rw [Homotopy.dNext_cochainComplex, hKd,
            show prevD 1 hom = hom 1 0 ≫ D.d 0 1 from Homotopy.prevD_succ_cochainComplex hom 0]
          ext x
          show T.α1 (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' F1)) =
            h2 (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' T.d1)) +
              (D.d 0 1).hom (h1 x.down.1) + (Fr.f 1).hom (T.α1 x.down.1)
          rw [hmat, hmat, hH1]
          abel
        | 2 =>
          rw [Homotopy.dNext_cochainComplex, hKd,
            show prevD 2 hom = hom 2 1 ≫ D.d 1 2 from Homotopy.prevD_succ_cochainComplex hom 1]
          ext x
          show T.α2 (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' F2)) =
            0 + (D.d 1 2).hom (h2 x.down.1) + (Fr.f 2).hom (T.α2 x.down.1)
          rw [hmat, hH2]
          abel
        | n + 3 =>
          ext x
          rw [hsub n x, map_zero, map_zero] }
  exact ⟨P, φ, s1 φ hinj hsurj, hequiv, ⟨htpy⟩⟩

theorem wc_strict_cover_projective_model (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α) (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
    (J : InjectiveResolution (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
    (ρJ : Γ → (J.cocomplex ⟶ J.cocomplex))
    (hJ : wcStrictResSpec (fun γ => wcCoverAct (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (α γ⁻¹).hom (hα γ⁻¹)) J ρJ) :
    ∃ (P : wcGModel ℓ Γ) (φ : wcGModelAb P ⟶
        ((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
          (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex (ComplexShape.up ℕ)).obj
          J.cocomplex),
      QuasiIso φ ∧
      Nonempty (Homotopy (φ ≫ (NatTrans.mapHomologicalComplex (preadditiveCoyoneda.map
          (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)).op)
          (ComplexShape.up ℕ)).app J.cocomplex) (wcGModelFrob P ≫ φ)) ∧
      ∀ γ : Γ, φ ≫ ((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
          (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex (ComplexShape.up ℕ)).map
          (ρJ γ⁻¹) = wcGModelAct P γ ≫ φ :=
by
  classical
  haveI : Finite Γ := hG.1
  set E := (preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
    (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex (ComplexShape.up ℕ) with hEdef
  set 𝔉 := NatTrans.mapHomologicalComplex (preadditiveCoyoneda.map
    (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)).op)
    (ComplexShape.up ℕ) with h𝔉def

  obtain ⟨lamF, hLact, hLsing, hL1⟩ := wc_cover_sheaf_ring_action (q' ≫ Uo.ι)
    (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ Γ α hα

  have hR : ∀ (n : ℕ) (r : MonoidAlgebra ℤ_[ℓ] Γ), 0 < n →
      (n : MonoidAlgebra ℤ_[ℓ] Γ) * r = 0 → r = 0 := by
    intro n r hn h
    rw [← nsmul_eq_mul] at h
    exact (smul_eq_zero.mp h).resolve_left hn.ne'

  obtain ⟨I, lamI, hI⟩ := wc_ring_injective_resolution (wcP1Over K).left
    (MonoidAlgebra ℤ_[ℓ] Γ) hR _ lamF hLact
  have hI' := hI
  obtain ⟨hIact, hI0, -⟩ := hI'
  have hIact' := hIact
  obtain ⟨hIone, hIadd, hImul⟩ := hIact'

  have hρ1 : lamI (MonoidAlgebra.single 1 1) = 𝟙 _ := by
    rw [← MonoidAlgebra.one_def]
    exact hIone
  have hρmul : ∀ a b : Γ, lamI (MonoidAlgebra.single (a * b) 1) =
      lamI (MonoidAlgebra.single b 1) ≫ lamI (MonoidAlgebra.single a 1) := by
    intro a b
    rw [← hImul, MonoidAlgebra.single_mul_single, mul_one]
  have hρ0 : ∀ a : Γ, I.ι.f 0 ≫ (lamI (MonoidAlgebra.single a 1)).f 0 =
      wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ
        (α a⁻¹).hom (hα a⁻¹) ≫ I.ι.f 0 := by
    intro a
    rw [hI0, hL1 a]

  obtain ⟨c, hc0, hcA⟩ := wc_equivariant_resolution_comparison _ J ρJ hJ I
    (fun γ => lamI (MonoidAlgebra.single γ 1)) hρ1 hρmul hρ0

  have hι : I.ι ≫ c = (CochainComplex.single₀ _).map (𝟙 _) ≫ J.ι := by
    rw [CategoryTheory.Functor.map_id, Category.id_comp]
    apply HomologicalComplex.from_single_hom_ext
    rw [HomologicalComplex.comp_f]
    exact hc0
  let e := InjectiveResolution.homotopyEquiv I J
  have hce : Homotopy c e.hom :=
    InjectiveResolution.descHomotopy (𝟙 _) c e.hom hι (InjectiveResolution.desc_commutes _ _ _)
  let e' : HomotopyEquiv I.cocomplex J.cocomplex :=
    { hom := c
      inv := e.inv
      homotopyHomInvId := (hce.compRight e.inv).trans e.homotopyHomInvId
      homotopyInvHomId := (hce.compLeft e.inv).trans e.homotopyInvHomId }
  have hEc : QuasiIso (E.map c) := by
    have h := HomotopyEquiv.quasiIso_hom
      ((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
        (wcGeomPoint K (wcP1Over K) hP)))).mapHomotopyEquiv e')
    rw [Functor.mapHomotopyEquiv_hom] at h
    exact h

  have hLD : wcRingAct (fun r => E.map (lamI r)) := by
    refine ⟨?_, ?_, ?_⟩
    · show E.map (lamI 1) = 𝟙 _
      rw [hIone, CategoryTheory.Functor.map_id]
    · intro a b
      show E.map (lamI (a + b)) = E.map (lamI a) + E.map (lamI b)
      rw [hIadd, Functor.map_add]
    · intro a b
      show E.map (lamI (a * b)) = E.map (lamI b) ≫ E.map (lamI a)
      rw [hImul, Functor.map_comp]
  have hFr : ∀ r, (fun r => E.map (lamI r)) r ≫ 𝔉.app I.cocomplex =
      𝔉.app I.cocomplex ≫ (fun r => E.map (lamI r)) r := fun r => 𝔉.naturality (lamI r)

  have hfv := wc_cover_coh_fg_van K hP ℓ hℓ m S hS Uo hUo q' Γ α hG hα lamF hLact hLsing I lamI hI
  obtain ⟨T⟩ := wc_three_term_model_exists ℓ Γ (E.obj I.cocomplex) (fun r => E.map (lamI r))
    hLD hfv
  have hproj := wc_cover_model_head_projective K hP ℓ hℓ m S hS Uo hUo q' Γ α hG hα lamF hLact
    hLsing I lamI hI T
  obtain ⟨P, φ', hq, hA, ⟨hF⟩⟩ := wc_gmodel_of_projective_head ℓ Γ (E.obj I.cocomplex)
    (fun r => E.map (lamI r)) hLD (𝔉.app I.cocomplex) hFr T hproj

  refine ⟨P, φ' ≫ E.map c, ?_, ⟨?_⟩, ?_⟩
  · haveI := hq
    haveI := hEc
    exact quasiIso_comp _ _
  · have nat : E.map c ≫ 𝔉.app J.cocomplex = 𝔉.app I.cocomplex ≫ E.map c := 𝔉.naturality c
    refine (Homotopy.ofEq ?_).trans ((hF.symm.compRight (E.map c)).trans (Homotopy.ofEq ?_))
    · rw [Category.assoc, nat, ← Category.assoc]
    · rw [Category.assoc]
  · intro γ
    have hA' : wcGModelAct P γ ≫ φ' = φ' ≫ E.map (lamI (MonoidAlgebra.single γ⁻¹ 1)) := hA γ
    have hc' : lamI (MonoidAlgebra.single γ⁻¹ 1) ≫ c = c ≫ ρJ γ⁻¹ := hcA γ⁻¹
    rw [Category.assoc, ← Functor.map_comp, ← hc', Functor.map_comp, ← Category.assoc, ← hA',
      Category.assoc]

theorem wc_cover_model_exists (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α) (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι) :
    ∃ P : wcGModel ℓ Γ,
      wcIsModel K hP (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (q' ≫ Uo.ι)
        Γ α hα P :=
by
  classical

  set q : V ⟶ (wcP1Over K).left := q' ≫ Uo.ι with hqdef
  set Z : Set (wcP1Over K).left := Set.range (fun i => S i (IsLocalRing.closedPoint K)) with hZdef
  set 𝓕 := wcCoverSheaf q Z ℓ with h𝓕
  set E := (preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
    (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex (ComplexShape.up ℕ) with hEdef
  set 𝔉 := NatTrans.mapHomologicalComplex (preadditiveCoyoneda.map
    (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)).op)
    (ComplexShape.up ℕ) with h𝔉def
  have hfin : Finite Γ := hG.1

  have hcongr : ∀ (a a' : V ⟶ V) (_ : a = a') (ha : a ≫ q = q) (ha' : a' ≫ q = q),
      wcCoverAct q Z ℓ a ha = wcCoverAct q Z ℓ a' ha' := by
    rintro a _ rfl _ _
    rfl
  have hact_id : ∀ (h : 𝟙 V ≫ q = q), wcCoverAct q Z ℓ (𝟙 V) h = 𝟙 _ := by
    intro h
    have hpb : wcPbAct q (𝟙 V) h = 𝟙 _ := by
      apply NatTrans.ext
      funext T
      simp only [wcPbAct, NatTrans.id_app]
      first
        | exact Limits.pullback.map_id
        | (apply Limits.pullback.hom_ext <;> simp [Limits.pullback.map] <;>
            exact (Category.id_comp _).symm)
    unfold wcCoverAct
    refine (congrArg (presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
      AddCommGrpCat.{u+1}).map ?_).trans
      ((presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}).map_id _)
    rw [hpb]
    ext T x
    apply Subtype.ext
    rfl
  have hact_comp : ∀ (a b : V ⟶ V) (ha : a ≫ q = q) (hb : b ≫ q = q) (hab : (a ≫ b) ≫ q = q),
      wcCoverAct q Z ℓ (a ≫ b) hab = wcCoverAct q Z ℓ b hb ≫ wcCoverAct q Z ℓ a ha := by
    intro a b ha hb hab
    have hpb : wcPbAct q (a ≫ b) hab = wcPbAct q a ha ≫ wcPbAct q b hb := by
      apply NatTrans.ext
      funext T
      simp only [wcPbAct, NatTrans.comp_app]
      first
        | (refine Eq.trans ?_ (Limits.pullback.map_comp _ _ _ _ _ _ _ _ _ _).symm
           congr 1 <;> simp)
        | (rw [Limits.pullback.map_comp]; congr 1 <;> simp)
        | (apply Limits.pullback.hom_ext
           · rw [Category.assoc]
             erw [Limits.pullback.lift_fst, Limits.pullback.lift_fst, Limits.pullback.lift_fst]
           · rw [Category.assoc]
             erw [Limits.pullback.lift_snd, Limits.pullback.lift_snd]
             rw [← Category.assoc]
             erw [Limits.pullback.lift_snd]
             rw [Category.assoc])
    unfold wcCoverAct
    refine (congrArg (presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
      AddCommGrpCat.{u+1}).map ?_).trans
      ((presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}).map_comp
        _ _)
    rw [hpb]
    ext T x
    apply Subtype.ext
    rfl
  let ρ : Γ → (𝓕 ⟶ 𝓕) := fun γ => wcCoverAct q Z ℓ (α γ⁻¹).hom (hα γ⁻¹)
  have hρ1 : ρ 1 = 𝟙 𝓕 := by
    have h1 : (α 1⁻¹).hom = 𝟙 V := by
      rw [inv_one, map_one]
      rfl
    exact (hcongr _ _ h1 (hα 1⁻¹) (by rw [Category.id_comp])).trans (hact_id _)
  have hρmul : ∀ a b, ρ (a * b) = ρ b ≫ ρ a := by
    intro a b
    have h1 : (α (a * b)⁻¹).hom = (α a⁻¹).hom ≫ (α b⁻¹).hom := by
      rw [mul_inv_rev, map_mul, Aut.Aut_mul_def]
      rfl
    exact (hcongr _ _ h1 (hα (a * b)⁻¹) (by rw [Category.assoc, hα b⁻¹, hα a⁻¹])).trans
      (hact_comp _ _ (hα a⁻¹) (hα b⁻¹) _)
  have hρinv : ∀ γ, ρ γ⁻¹ = wcCoverAct q Z ℓ (α γ).hom (hα γ) := by
    intro γ
    exact hcongr _ _ (by rw [inv_inv]) _ _

  obtain ⟨J, ρJ, hJ⟩ := wc_strict_injective_resolution 𝓕 ρ hρ1 hρmul

  obtain ⟨P, φ, hφq, ⟨hφF⟩, hφA⟩ :=
    wc_strict_cover_projective_model K hP ℓ hℓ m S hS Uo hUo q' Γ α hG hα J ρJ hJ

  let I := injectiveResolution 𝓕
  let Θ : E.obj J.cocomplex ⟶ wcCx K hP 𝓕 := E.map (InjectiveResolution.desc (𝟙 𝓕) I J)
  have hΘq : QuasiIso Θ := by
    have h := HomotopyEquiv.quasiIso_hom
      ((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
        (wcGeomPoint K (wcP1Over K) hP)))).mapHomotopyEquiv (J.homotopyEquiv I))
    rw [Functor.mapHomotopyEquiv_hom] at h
    exact h
  have hΘF : Θ ≫ wcCxFrob K hP 𝓕 = 𝔉.app J.cocomplex ≫ Θ :=
    NatTrans.mapHomologicalComplex_naturality _ _
  have hΘA : ∀ γ : Γ, Homotopy (Θ ≫ wcCxMap K hP (wcCoverAct q Z ℓ (α γ).hom (hα γ)))
      (E.map (ρJ γ⁻¹) ≫ Θ) := by
    intro γ
    have h1 : J.ι ≫ (InjectiveResolution.desc (𝟙 𝓕) I J ≫
        InjectiveResolution.desc (wcCoverAct q Z ℓ (α γ).hom (hα γ)) I I) =
        (CochainComplex.single₀ _).map (wcCoverAct q Z ℓ (α γ).hom (hα γ)) ≫ I.ι := by
      rw [← Category.assoc, InjectiveResolution.desc_commutes, Category.assoc,
        InjectiveResolution.desc_commutes, ← Category.assoc, ← Functor.map_comp,
        Category.id_comp]
    have h2 : J.ι ≫ (ρJ γ⁻¹ ≫ InjectiveResolution.desc (𝟙 𝓕) I J) =
        (CochainComplex.single₀ _).map (wcCoverAct q Z ℓ (α γ).hom (hα γ)) ≫ I.ι := by
      apply HomologicalComplex.from_single_hom_ext
      simp only [HomologicalComplex.comp_f]
      have h3 : ρ γ⁻¹ ≫ J.ι.f 0 ≫ (InjectiveResolution.desc (𝟙 𝓕) I J).f 0 =
          wcCoverAct q Z ℓ (α γ).hom (hα γ) ≫ I.ι.f 0 := by
        have h4 := InjectiveResolution.desc_commutes_zero (𝟙 𝓕) I J
        have h5 : (𝟙 𝓕 ≫ I.ι.f 0 : 𝓕 ⟶ I.cocomplex.X 0) = I.ι.f 0 := Category.id_comp _
        refine (congrArg (fun t => ρ γ⁻¹ ≫ t) (h4.trans h5)).trans ?_
        exact congrArg (fun t => t ≫ I.ι.f 0) (hρinv γ)
      rw [← Category.assoc, hJ.2.2.1 γ⁻¹]
      refine ((Category.assoc _ _ _).trans h3).trans ?_
      first
        | rfl
        | (erw [CochainComplex.single₀_map_f_zero]; rfl)
        | simp
    have hh := InjectiveResolution.descHomotopy (wcCoverAct q Z ℓ (α γ).hom (hα γ)) _ _ h1 h2
    have hE := (preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
        (wcGeomPoint K (wcP1Over K) hP)))).mapHomotopy hh
    refine (Homotopy.ofEq ?_).trans (hE.trans (Homotopy.ofEq ?_))
    · exact (Functor.map_comp _ _ _).symm
    · exact Functor.map_comp _ _ _

  refine ⟨P, φ ≫ Θ, ?_, ⟨?_⟩, fun γ => ⟨?_⟩⟩
  · exact quasiIso_comp φ Θ
  · refine (Homotopy.ofEq ?_).trans ((hφF.compRight Θ).trans (Homotopy.ofEq ?_))
    · rw [Category.assoc, hΘF, ← Category.assoc]
    · rw [Category.assoc]
  · refine (Homotopy.ofEq (Category.assoc _ _ _)).trans
      (((hΘA γ).compLeft φ).trans (Homotopy.ofEq ?_))
    rw [← Category.assoc, hφA γ, Category.assoc]

theorem wc_stalk_basis_exists (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hlisse : wcLisseOffS K hP ℓ m S G σ) :
    ∀ d : ℕ, ∀ x ∈ wcOffS K m S d, Nonempty (wcStalkBasis K ℓ G σ x d) :=
by
  classical
  intro d x hx
  obtain ⟨hd0, hxd, hxS⟩ := hx
  obtain ⟨W, w, r, -, -, -, hcov, hW⟩ := hlisse

  have transfer : ∀ (V' W' : (wcP1Over K).left.ProEt) (h : V' ⟶ W'),
      wcScalarTriv (wcP1Over K).left ℓ G σ W' r → wcScalarTriv (wcP1Over K).left ℓ G σ V' r := by
    intro V' W' h hW'
    obtain ⟨t, ht⟩ := hW'
    let ε : (Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W' ⋙
        (Scheme.ProEt.topology (wcP1Over K).left).overMapPullback AddCommGrpCat.{u+1} h ≅
        (Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} V' :=
      Functor.sheafPushforwardContinuousComp' (Over.mapForget h) AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology (wcP1Over K).left).over V')
        ((Scheme.ProEt.topology (wcP1Over K).left).over W')
        (Scheme.ProEt.topology (wcP1Over K).left)
    refine ⟨(ε.app G).symm ≪≫
      ((Scheme.ProEt.topology (wcP1Over K).left).overMapPullback AddCommGrpCat.{u+1} h).mapIso t ≪≫
      ε.app _, ?_⟩
    intro c
    have n1 := ε.inv.naturality (σ c)
    have n2 := ε.hom.naturality (wcConstScalar (wcP1Over K).left ℓ r c)
    simp only [Functor.comp_map] at n1 n2
    simp only [Iso.trans_hom, Iso.symm_hom, Iso.app_inv, Iso.app_hom, Functor.mapIso_hom,
      Category.assoc]
    rw [← Category.assoc, n1, Category.assoc, ← Functor.map_comp_assoc, ht c,
      Functor.map_comp_assoc, n2]

  have hlocal : ∀ (V : (wcP1Over K).left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A]
      [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)),
      (∀ i, V.hom (e.inv (IsLocalRing.closedPoint A)) ≠ S i (IsLocalRing.closedPoint K)) →
      wcScalarTriv (wcP1Over K).left ℓ G σ V r := by
    intro V A _ _ _ e hx
    haveI hsub : Subsingleton ↥(Spec (CommRingCat.of K)) :=
      inferInstanceAs (Subsingleton (PrimeSpectrum K))
    have hπ : (wcP1Over K).hom (V.hom (e.inv (IsLocalRing.closedPoint A))) =
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
          (IsLocalRing.closedPoint (AlgebraicClosure K)) := Subsingleton.elim _ _
    obtain ⟨p, hp1, -⟩ := Scheme.Pullback.exists_preimage_pullback _ _ hπ
    have hp : (wcGeomPoint K (wcP1Over K) hP).hom p = V.hom (e.inv (IsLocalRing.closedPoint A)) :=
      hp1
    obtain ⟨z, hz⟩ := hcov p (fun i => by rw [hp]; exact hx i)
    have hWz : W.hom z = V.hom (e.inv (IsLocalRing.closedPoint A)) := by
      rw [← MorphismProperty.Over.w w, Scheme.Hom.comp_apply, hz, hp]
    obtain ⟨t, ht1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V.hom) (g := W.hom)
      (e.inv (IsLocalRing.closedPoint A)) z hWz.symm
    have hq : WeaklyEtale (Limits.pullback.fst V.hom W.hom) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback V.hom W.hom).flip
        W.prop
    haveI : WeaklyEtale (Limits.pullback.fst V.hom W.hom) := hq
    haveI : WeaklyEtale ((Limits.pullback V.hom W.hom).fromSpecStalk t) :=
      wc_fromSpecStalk_weaklyEtale _ t
    obtain ⟨k, hkdef⟩ : ∃ k, k = (Limits.pullback V.hom W.hom).fromSpecStalk t ≫
        Limits.pullback.fst V.hom W.hom ≫ e.hom := ⟨_, rfl⟩
    have hk : WeaklyEtale k := by rw [hkdef]; infer_instance
    have hφ : Spec.map (Spec.preimage k) = k := Spec.map_preimage k
    have hk' : WeaklyEtale (Spec.map (CommRingCat.ofHom (Spec.preimage k).hom)) := by
      change WeaklyEtale (Spec.map (Spec.preimage k))
      rw [hφ]; exact hk
    letI := (Spec.preimage k).hom.toAlgebra
    have hWE := wc_lpkt_specMap_weaklyEtale_ring _ _ (Spec.preimage k).hom hk'
    have hk_pt : k (IsLocalRing.closedPoint ((Limits.pullback V.hom W.hom).presheaf.stalk t)) =
        IsLocalRing.closedPoint A := by
      have h1 : k (IsLocalRing.closedPoint ((Limits.pullback V.hom W.hom).presheaf.stalk t)) =
          e.hom ((Limits.pullback.fst V.hom W.hom) ((Limits.pullback V.hom W.hom).fromSpecStalk t
            (IsLocalRing.closedPoint ((Limits.pullback V.hom W.hom).presheaf.stalk t)))) := by
        subst hkdef
        first | rfl | simp [Scheme.Hom.comp_apply]
      have h2 : ∀ y : Spec (CommRingCat.of A), e.hom (e.inv y) = y := by
        intro y
        first
          | simp
          | (rw [← Scheme.Hom.comp_apply, e.inv_hom_id]; rfl)
          | exact congrArg (fun f : Spec (CommRingCat.of A) ⟶ Spec (CommRingCat.of A) => f y) e.inv_hom_id
      rw [h1, Scheme.fromSpecStalk_closedPoint, ht1]
      first
        | exact h2 _
        | simp
        | exact congrArg (fun f : Spec (CommRingCat.of A) ⟶ Spec (CommRingCat.of A) => f _) e.inv_hom_id
    have hcomap : PrimeSpectrum.comap (Spec.preimage k).hom
        (IsLocalRing.closedPoint ((Limits.pullback V.hom W.hom).presheaf.stalk t)) =
        IsLocalRing.closedPoint A := by
      have h5 : (Spec.map (Spec.preimage k))
          (IsLocalRing.closedPoint ((Limits.pullback V.hom W.hom).presheaf.stalk t)) =
          PrimeSpectrum.comap (Spec.preimage k).hom
            (IsLocalRing.closedPoint ((Limits.pullback V.hom W.hom).presheaf.stalk t)) := by
        first | rfl | simp [Spec.map_base]
      rw [← h5, hφ]
      exact hk_pt
    have hloc : IsLocalHom (Spec.preimage k).hom :=
      (IsLocalRing.isLocalHom_iff_comap_closedPoint (Spec.preimage k).hom).mpr hcomap
    have hbij : Function.Bijective (Spec.preimage k).hom :=
      wc_olivier _ _ inferInstance inferInstance hloc hWE
    haveI : IsIso (Spec.preimage k) := (ConcreteCategory.isIso_iff_bijective _).mpr hbij
    haveI hkiso : IsIso k := by
      rw [← hφ]; infer_instance
    have hcq : (Limits.pullback V.hom W.hom).fromSpecStalk t ≫ Limits.pullback.fst V.hom W.hom =
        k ≫ e.inv := by
      rw [hkdef]; simp
    obtain ⟨s, hs⟩ : ∃ s : V.left ⟶ Limits.pullback V.hom W.hom,
        s ≫ Limits.pullback.fst V.hom W.hom = 𝟙 _ :=
      ⟨e.hom ≫ inv k ≫ (Limits.pullback V.hom W.hom).fromSpecStalk t, by
        rw [Category.assoc, Category.assoc, hcq, IsIso.inv_hom_id_assoc, Iso.hom_inv_id]⟩
    have hh : (s ≫ Limits.pullback.snd V.hom W.hom) ≫ W.hom = V.hom := by
      rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hs, Category.id_comp]
    exact transfer V W (MorphismProperty.Over.homMk (s ≫ Limits.pullback.snd V.hom W.hom) hh trivial) hW

  obtain ⟨N⟩ := wc_P1_frob_nbhd_exists K d (Nat.one_le_iff_ne_zero.mpr hd0) x hxd
  letI := N.ringA
  letI := N.hensA
  letI := N.sepA

  have hV : wcScalarTriv (wcP1Over K).left ℓ G σ N.V r :=
    hlocal N.V N.A N.e (fun i h => hxS i (N.hx.symm.trans h))

  obtain ⟨b, hb, -⟩ := wc_proet_scalarTriv_stalk_basis (wcP1Over K).left ℓ G σ r N.V N.A N.e N.φ hV
  exact ⟨⟨N, r, b, hb⟩⟩

theorem wc_offS_fixed_points_regroup (K : Type u) [Field K] [Finite K] (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left)) (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (np : ℕ → ℕ) (pt : (d : ℕ) → Fin (np d) → (wcP1Over K).left)
    (hnp : ∀ d, np d = Nat.card (wcOffS K m S d))
    (hpt : ∀ d i, pt d i ∈ wcOffS K m S d) (hinj : ∀ d, Function.Injective (pt d))
    (e : ℕ) (he : 1 ≤ e) :
    (wcFixedOffS K m S e).Finite ∧
    (∀ u ∈ wcFixedOffS K m S e, ∃ d ∈ e.divisors,
      u (IsLocalRing.closedPoint (AlgebraicClosure K)) ∈ wcOffS K m S d) ∧
    ∀ (M : Type*) [AddCommMonoid M] (T : (wcP1Over K).left → M),
      ∑ᶠ u ∈ wcFixedOffS K m S e, T (u (IsLocalRing.closedPoint (AlgebraicClosure K))) =
        ∑ d ∈ e.divisors, ∑ i : Fin (np d), d • T (pt d i) :=
by
  classical

  have s1 : ∀ (X : Scheme.{u}) (s : X ⟶ Spec (.of K)),
      ∃ E : {u : Spec (.of (AlgebraicClosure K)) ⟶ X // u ≫ s = wcKbarPt K ∧ wcFrE K e ≫ u = u} ≃
          Σ x : X, {φ : @AlgHom K (X.residueField x) (AlgebraicClosure K) _ _ _
              ((X.residue x).hom.comp (wcLdpConst K s x)).toAlgebra _ //
            ∀ a, ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
              (AlgebraicClosure K) _ _ _) ^ e) (φ a) = φ a},
        ∀ u, (E u).1 = u.1 (IsLocalRing.closedPoint (AlgebraicClosure K)) := by
    intro X s
    have hcompat : ∀ x : X, X.fromSpecResidueField x ≫ s =
        Spec.map (CommRingCat.ofHom (wcLdpConst K s x) ≫ X.residue x) := by
      intro x
      have hconst : CommRingCat.ofHom (wcLdpConst K s x) =
          (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ s.appTop ≫ X.presheaf.germ ⊤ x trivial := by
        rfl
      have hstalk : X.fromSpecStalk x ≫ s = Spec.map (CommRingCat.ofHom (wcLdpConst K s x)) := by
        calc X.fromSpecStalk x ≫ s
            = X.fromSpecStalk x ≫ s ≫ (Spec (CommRingCat.of K)).toSpecΓ ≫
                Spec.map (Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
              rw [toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
          _ = X.fromSpecStalk x ≫ X.toSpecΓ ≫ Spec.map s.appTop ≫
                Spec.map (Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
              rw [← Category.assoc s, Scheme.toSpecΓ_naturality, Category.assoc]
          _ = Spec.map (X.presheaf.germ ⊤ x trivial) ≫ Spec.map s.appTop ≫
                Spec.map (Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
              rw [← Category.assoc, Scheme.fromSpecStalk_toSpecΓ]
          _ = Spec.map (CommRingCat.ofHom (wcLdpConst K s x)) := by
              rw [hconst, Spec.map_comp, Spec.map_comp, Category.assoc]
      rw [Spec.map_comp, Scheme.fromSpecResidueField, Category.assoc, hstalk]
    have hfib : ∀ (x : X) (φ : X.residueField x ⟶ CommRingCat.of (AlgebraicClosure K)),
        (Spec.map φ ≫ X.fromSpecResidueField x) ≫ s = wcKbarPt K ↔
          ∀ c : K, φ.hom ((X.residue x).hom (wcLdpConst K s x c)) =
            algebraMap K (AlgebraicClosure K) c := by
      intro x φ
      rw [wcKbarPt, Category.assoc, hcompat x, ← Spec.map_comp, Spec.map_inj]
      constructor
      · intro h c
        exact congrArg (fun g => g.hom c) h
      · intro h
        ext c
        exact h c
    have hfrob : ∀ (x : X) (φ : X.residueField x ⟶ CommRingCat.of (AlgebraicClosure K)),
        wcFrE K e ≫ (Spec.map φ ≫ X.fromSpecResidueField x) = Spec.map φ ≫ X.fromSpecResidueField x ↔
          ∀ a, ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
              (AlgebraicClosure K) _ _ _) ^ e) (φ.hom a) = φ.hom a := by
      intro x φ
      rw [wcFrE, ← Category.assoc, ← Spec.map_comp]
      constructor
      · intro h a
        have h2 : (⟨x, φ ≫ CommRingCat.ofHom
            (((@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
              (AlgebraicClosure K) _ _ _) ^ e : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K) :
                AlgebraicClosure K →+* AlgebraicClosure K)⟩ :
              Σ y : X, (X.residueField y ⟶ CommRingCat.of (AlgebraicClosure K))) = ⟨x, φ⟩ :=
          (Scheme.SpecToEquivOfField (AlgebraicClosure K) X).symm.injective h
        have h3 := sigma_mk_injective h2
        exact congrArg (fun g => g.hom a) h3
      · intro h
        have h3 : φ ≫ CommRingCat.ofHom
            (((@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
              (AlgebraicClosure K) _ _ _) ^ e : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K) :
                AlgebraicClosure K →+* AlgebraicClosure K) = φ := by
          ext a
          exact h a
        rw [h3]
    let E0 := Scheme.SpecToEquivOfField (AlgebraicClosure K) X
    let e1 : {u : Spec (.of (AlgebraicClosure K)) ⟶ X // u ≫ s = wcKbarPt K ∧ wcFrE K e ≫ u = u} ≃
        {p : Σ x : X, (X.residueField x ⟶ CommRingCat.of (AlgebraicClosure K)) //
          E0.symm p ≫ s = wcKbarPt K ∧ wcFrE K e ≫ E0.symm p = E0.symm p} :=
      E0.subtypeEquiv (fun f => by rw [Equiv.symm_apply_apply])
    let e2 : {p : Σ x : X, (X.residueField x ⟶ CommRingCat.of (AlgebraicClosure K)) //
          E0.symm p ≫ s = wcKbarPt K ∧ wcFrE K e ≫ E0.symm p = E0.symm p} ≃
        Σ x : X, {φ : X.residueField x ⟶ CommRingCat.of (AlgebraicClosure K) //
          E0.symm ⟨x, φ⟩ ≫ s = wcKbarPt K ∧ wcFrE K e ≫ E0.symm ⟨x, φ⟩ = E0.symm ⟨x, φ⟩} :=
      { toFun := fun p => ⟨p.1.1, p.1.2, p.2⟩
        invFun := fun q => ⟨⟨q.1, q.2.1⟩, q.2.2⟩
        left_inv := fun ⟨⟨_, _⟩, _⟩ => rfl
        right_inv := fun ⟨_, _, _⟩ => rfl }
    let e3 : (Σ x : X, {φ : X.residueField x ⟶ CommRingCat.of (AlgebraicClosure K) //
          E0.symm ⟨x, φ⟩ ≫ s = wcKbarPt K ∧ wcFrE K e ≫ E0.symm ⟨x, φ⟩ = E0.symm ⟨x, φ⟩}) ≃
        Σ x : X, {φ : X.residueField x ⟶ CommRingCat.of (AlgebraicClosure K) //
          (∀ c : K, φ.hom ((X.residue x).hom (wcLdpConst K s x c)) =
            algebraMap K (AlgebraicClosure K) c) ∧
          ∀ a, ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
              (AlgebraicClosure K) _ _ _) ^ e) (φ.hom a) = φ.hom a} :=
      Equiv.sigmaCongrRight (fun x => Equiv.subtypeEquivRight
        (fun φ => and_congr (hfib x φ) (hfrob x φ)))
    let e4 : ∀ x : X, {φ : X.residueField x ⟶ CommRingCat.of (AlgebraicClosure K) //
          (∀ c : K, φ.hom ((X.residue x).hom (wcLdpConst K s x c)) =
            algebraMap K (AlgebraicClosure K) c) ∧
          ∀ a, ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
              (AlgebraicClosure K) _ _ _) ^ e) (φ.hom a) = φ.hom a} ≃
        {φ : @AlgHom K (X.residueField x) (AlgebraicClosure K) _ _ _
              ((X.residue x).hom.comp (wcLdpConst K s x)).toAlgebra _ //
            ∀ a, ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
              (AlgebraicClosure K) _ _ _) ^ e) (φ a) = φ a} := fun x =>
      letI := ((X.residue x).hom.comp (wcLdpConst K s x)).toAlgebra
      { toFun := fun φ => ⟨{ toRingHom := φ.1.hom, commutes' := φ.2.1 }, φ.2.2⟩
        invFun := fun σ => ⟨CommRingCat.ofHom σ.1.toRingHom, fun c => σ.1.commutes c, σ.2⟩
        left_inv := fun φ => rfl
        right_inv := fun σ => rfl }
    exact ⟨e1.trans (e2.trans (e3.trans (Equiv.sigmaCongrRight e4))), fun u => rfl⟩

  have s2 : ∃ (L : Type u) (_ : Field L) (_ : Algebra K L) (_ : Finite L), Module.finrank K L = e ∧
      ∀ (κ : Type u) [CommRing κ] [Algebra K κ],
        Nonempty ({φ : κ →ₐ[K] AlgebraicClosure K //
            ∀ a, ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
              (AlgebraicClosure K) _ _ _) ^ e) (φ a) = φ a} ≃ (κ →ₐ[K] L)) := by
    letI : Fintype K := Fintype.ofFinite K
    set τ := (@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
      (AlgebraicClosure K) _ _ _) with hτdef
    have hτ : ∀ b : AlgebraicClosure K, (τ ^ e) b = b ^ (Fintype.card K ^ e) := fun b => by
      rw [AlgEquiv.coe_pow, hτdef, FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate]
    have key : ∀ (L : Type u) [Field L] [Algebra K L] [Finite L], Module.finrank K L = e →
        ∀ (κ : Type u) [CommRing κ] [Algebra K κ],
          Nonempty ({φ : κ →ₐ[K] AlgebraicClosure K // ∀ a, (τ ^ e) (φ a) = φ a} ≃
            (κ →ₐ[K] L)) := by
      intro L _ _ _ hLe κ _ _
      letI : Fintype L := Fintype.ofFinite L
      haveI : Module.Finite K L := Module.Finite.of_finite
      haveI : Algebra.IsAlgebraic K L := Algebra.IsAlgebraic.of_finite K L
      have hcardL : Fintype.card L = Fintype.card K ^ e := by
        rw [Module.card_eq_pow_finrank (K := K) (V := L), hLe]
      let j : L →ₐ[K] AlgebraicClosure K := IsAlgClosed.lift
      have hj : Function.Injective j := (j : L →+* AlgebraicClosure K).injective
      have claimA : ∀ c : L, (τ ^ e) (j c) = j c := by
        intro c
        rw [hτ, ← map_pow, ← hcardL, FiniteField.pow_card]
      have hQ1 : 1 < Fintype.card K := Fintype.one_lt_card
      have hP0 : (Polynomial.X ^ Fintype.card K ^ e - Polynomial.X :
          Polynomial (AlgebraicClosure K)) ≠ 0 :=
        FiniteField.X_pow_card_pow_sub_X_ne_zero _ (by omega) hQ1
      have hPdeg : (Polynomial.X ^ Fintype.card K ^ e - Polynomial.X :
          Polynomial (AlgebraicClosure K)).natDegree = Fintype.card K ^ e :=
        FiniteField.X_pow_card_pow_sub_X_natDegree_eq _ (by omega) hQ1
      have hroot : ∀ b : AlgebraicClosure K, b ^ (Fintype.card K ^ e) = b →
          b ∈ (Polynomial.X ^ Fintype.card K ^ e - Polynomial.X :
            Polynomial (AlgebraicClosure K)).roots.toFinset := by
        intro b hb
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hP0, Polynomial.IsRoot.def]
        simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, hb, sub_self]
      have hI : (Finset.univ.image j) = (Polynomial.X ^ Fintype.card K ^ e - Polynomial.X :
            Polynomial (AlgebraicClosure K)).roots.toFinset := by
        apply Finset.eq_of_subset_of_card_le
        · intro b hb
          obtain ⟨c, -, rfl⟩ := Finset.mem_image.mp hb
          exact hroot _ (by rw [← hτ]; exact claimA c)
        · rw [Finset.card_image_of_injective _ hj, Finset.card_univ, hcardL]
          calc _ ≤ _ := Multiset.toFinset_card_le _
            _ ≤ _ := Polynomial.card_roots' _
            _ = _ := hPdeg
      have claimB : ∀ b, (τ ^ e) b = b → ∃ c, j c = b := by
        intro b hb
        have hb' : b ∈ Finset.univ.image j := by
          rw [hI]; exact hroot b (by rw [← hτ]; exact hb)
        obtain ⟨c, -, hc⟩ := Finset.mem_image.mp hb'
        exact ⟨c, hc⟩
      let Ψ : (κ →ₐ[K] L) → {φ : κ →ₐ[K] AlgebraicClosure K // ∀ a, (τ ^ e) (φ a) = φ a} :=
        fun ψ => ⟨j.comp ψ, fun a => claimA (ψ a)⟩
      have hΨ : Function.Bijective Ψ := by
        constructor
        · intro ψ₁ ψ₂ h
          ext a
          exact hj (congrArg (fun φ => φ.1 a) h)
        · rintro ⟨φ, hφ⟩
          let φ' := φ.codRestrict j.range (fun a => (AlgHom.mem_range j).2 (claimB _ (hφ a)))
          refine ⟨(AlgEquiv.ofInjective j hj).symm.toAlgHom.comp φ',
            Subtype.ext (AlgHom.ext fun a => ?_)⟩
          show j ((AlgEquiv.ofInjective j hj).symm (φ' a)) = φ a
          rw [← AlgEquiv.ofInjective_apply j hj, AlgEquiv.apply_symm_apply]
          rfl
      exact ⟨(Equiv.ofBijective Ψ hΨ).symm⟩
    haveI : Fact (Nat.Prime (ringChar K)) := ⟨CharP.char_is_prime K (ringChar K)⟩
    haveI : NeZero e := ⟨by omega⟩
    haveI hLfin : Finite (ULift.{u} (FiniteField.Extension K (ringChar K) e)) :=
      Finite.of_equiv _ Equiv.ulift.symm
    have hfr : Module.finrank K (ULift.{u} (FiniteField.Extension K (ringChar K) e)) = e := by
      rw [LinearEquiv.finrank_eq (ULift.moduleEquiv (R := K))]
      exact FiniteField.finrank_extension K (ringChar K) e
    exact ⟨_, inferInstance, inferInstance, hLfin, hfr, key _ hfr⟩

  obtain ⟨E, hE⟩ := s1 (wcP1Over K).left (wcP1Over K).hom
  obtain ⟨L, _, _, _, hLe, H⟩ := s2
  let G := fun x : (wcP1Over K).left =>
    (@H ((wcP1Over K).left.residueField x) _
      (((wcP1Over K).left.residue x).hom.comp (wcLdpConst K (wcP1Over K).hom x)).toAlgebra).some
  have hFfin : Finite {u : Spec (.of (AlgebraicClosure K)) ⟶ (wcP1Over K).left //
      u ≫ (wcP1Over K).hom = wcKbarPt K ∧ wcFrE K e ≫ u = u} := by
    obtain ⟨Φ1⟩ := wc_spec_field_points_sigma_equiv K L (wcP1Over K).left (wcP1Over K).hom
    obtain ⟨Φ2⟩ := wc_P1_field_points_equiv_option K L
    exact Finite.of_equiv (Option L)
      (Φ2.trans (Φ1.trans ((Equiv.sigmaCongrRight G).symm.trans E.symm)))
  have hA : (wcFixedOffS K m S e).Finite := by
    have hF : Set.Finite {u : Spec (.of (AlgebraicClosure K)) ⟶ (wcP1Over K).left |
        u ≫ (wcP1Over K).hom = wcKbarPt K ∧ wcFrE K e ≫ u = u} :=
      Set.finite_coe_iff.mp (by exact hFfin)
    exact hF.subset (fun u hu => ⟨hu.1, hu.2.1⟩)

  have hcov : ∀ u ∈ wcFixedOffS K m S e, ∃ d ∈ e.divisors,
      u (IsLocalRing.closedPoint (AlgebraicClosure K)) ∈ wcOffS K m S d := by
    intro u hu
    have hne := Nonempty.intro (G (E ⟨u, hu.1, hu.2.1⟩).1 (E ⟨u, hu.1, hu.2.1⟩).2)
    rw [hE ⟨u, hu.1, hu.2.1⟩] at hne
    obtain ⟨d, hd, hx⟩ := (wc_P1_residue_algHom_facts K L _).1.mp hne
    rw [hLe] at hd
    exact ⟨d, hd, (Nat.pos_of_mem_divisors hd).ne', hx, hu.2.2⟩

  have hfib : ∀ d ∈ e.divisors, ∀ x ∈ wcOffS K m S d,
      Nat.card {u // u ∈ wcFixedOffS K m S e ∧
        u (IsLocalRing.closedPoint (AlgebraicClosure K)) = x} = d := by
    intro d hd x hx
    let eq1 : {u // u ∈ wcFixedOffS K m S e ∧
          u (IsLocalRing.closedPoint (AlgebraicClosure K)) = x} ≃
        {v : {u : Spec (.of (AlgebraicClosure K)) ⟶ (wcP1Over K).left //
            u ≫ (wcP1Over K).hom = wcKbarPt K ∧ wcFrE K e ≫ u = u} //
          v.1 (IsLocalRing.closedPoint (AlgebraicClosure K)) = x} :=
      { toFun := fun u => ⟨⟨u.1, u.2.1.1, u.2.1.2.1⟩, u.2.2⟩
        invFun := fun v => ⟨v.1.1, ⟨v.1.2.1, v.1.2.2, fun i => by rw [v.2]; exact hx.2.2 i⟩, v.2⟩
        left_inv := fun u => rfl
        right_inv := fun v => rfl }
    have hcard := Nat.card_congr (eq1.trans ((E.subtypeEquiv
      (q := fun p => p.1 = x) (fun v => by rw [hE v])).trans
        ((Equiv.sigmaSubtype x).trans (G x))))
    rw [hcard]
    have hne : Nonempty (@AlgHom K ((wcP1Over K).left.residueField x) L _ _ _
        (((wcP1Over K).left.residue x).hom.comp (wcLdpConst K (wcP1Over K).hom x)).toAlgebra _) :=
      (wc_P1_residue_algHom_facts K L x).1.mpr ⟨d, by rw [hLe]; exact hd, hx.2.1⟩
    have h2 := (wc_P1_residue_algHom_facts K L x).2 hne
    exact h2.2.symm.trans hx.2.1.2

  have hPfin : ∀ d ∈ e.divisors, (wcOffS K m S d).Finite := by
    intro d hd
    refine (hA.image (fun u => u (IsLocalRing.closedPoint (AlgebraicClosure K)))).subset ?_
    intro x hx
    have hc := hfib d hd x hx
    have hpos : Nat.card {u // u ∈ wcFixedOffS K m S e ∧
        u (IsLocalRing.closedPoint (AlgebraicClosure K)) = x} ≠ 0 := by
      rw [hc]; exact (Nat.pos_of_mem_divisors hd).ne'
    obtain ⟨⟨u, hu, hux⟩⟩ := (Nat.card_ne_zero.mp hpos).1
    exact ⟨u, hu, hux⟩
  have hdisj : ∀ d ∈ e.divisors, ∀ d' ∈ e.divisors, ∀ b,
      b ∈ wcOffS K m S d → b ∈ wcOffS K m S d' → d = d' :=
    fun d _ d' _ b h h' => h.2.1.2.symm.trans h'.2.1.2
  refine ⟨hA, hcov, fun M _ T => ?_⟩
  have s3 : ∀ {α β : Type u} (A : Set α) (hA : A.Finite) (g : α → β)
      (D : Finset ℕ) (P : ℕ → Set β) (hPfin : ∀ d ∈ D, (P d).Finite)
      (hdisj : ∀ d ∈ D, ∀ d' ∈ D, ∀ b, b ∈ P d → b ∈ P d' → d = d')
      (hcov : ∀ u ∈ A, ∃ d ∈ D, g u ∈ P d)
      (hfib : ∀ d ∈ D, ∀ b ∈ P d, Nat.card {u // u ∈ A ∧ g u = b} = d)
      (np : ℕ → ℕ) (pt : (d : ℕ) → Fin (np d) → β) (hnp : ∀ d, np d = Nat.card (P d))
      (hpt : ∀ d i, pt d i ∈ P d) (hinj : ∀ d, Function.Injective (pt d)) (T : β → M),
      ∑ᶠ u ∈ A, T (g u) = ∑ d ∈ D, ∑ i : Fin (np d), d • T (pt d i) := by
    intro α β A hA g D P hPfin hdisj hcov hfib np pt hnp hpt hinj T
    have hsurj : ∀ d ∈ D, ∀ b ∈ P d, ∃ i, pt d i = b := by
      intro d hd b hb
      haveI : Finite (P d) := (hPfin d hd).to_subtype
      have hbij : Function.Bijective (fun i : Fin (np d) => (⟨pt d i, hpt d i⟩ : P d)) := by
        refine Function.Injective.bijective_of_nat_card_le ?_ ?_
        · intro i j h
          exact hinj d (congrArg Subtype.val h)
        · rw [Nat.card_fin, hnp d]
      obtain ⟨i, hi⟩ := hbij.2 ⟨b, hb⟩
      exact ⟨i, congrArg Subtype.val hi⟩
    rw [finsum_mem_eq_finite_toFinset_sum _ hA]
    have hmaps : ∀ u ∈ hA.toFinset, g u ∈ D.biUnion (fun d => Finset.univ.image (pt d)) := by
      intro u hu
      obtain ⟨d, hd, hgd⟩ := hcov u (hA.mem_toFinset.mp hu)
      obtain ⟨i, hi⟩ := hsurj d hd _ hgd
      exact Finset.mem_biUnion.mpr ⟨d, hd, Finset.mem_image.mpr ⟨i, Finset.mem_univ _, hi⟩⟩
    rw [← Finset.sum_fiberwise_of_maps_to hmaps]
    have hdisjT : (↑D : Set ℕ).PairwiseDisjoint (fun d => Finset.univ.image (pt d)) := by
      intro d hd d' hd' hne
      rw [Function.onFun, Finset.disjoint_left]
      intro b hb hb'
      obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hb
      obtain ⟨i', -, hi'⟩ := Finset.mem_image.mp hb'
      exact hne (hdisj d (Finset.mem_coe.mp hd) d' (Finset.mem_coe.mp hd') _ (hpt d i)
        (hi' ▸ hpt d' i'))
    rw [Finset.sum_biUnion hdisjT]
    refine Finset.sum_congr rfl (fun d hd => ?_)
    rw [Finset.sum_image (by intro a _ b _ h; exact hinj d h)]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    have hcard : (hA.toFinset.filter (fun u => g u = pt d i)).card = d := by
      refine Eq.trans ?_ (hfib d hd _ (hpt d i))
      rw [← Nat.card_eq_finsetCard]
      apply Nat.card_congr
      exact { toFun := fun u => ⟨u.1, hA.mem_toFinset.mp (Finset.mem_filter.mp u.2).1,
                (Finset.mem_filter.mp u.2).2⟩
              invFun := fun u => ⟨u.1, Finset.mem_filter.mpr ⟨hA.mem_toFinset.mpr u.2.1, u.2.2⟩⟩
              left_inv := fun u => rfl
              right_inv := fun u => rfl }
    calc ∑ u ∈ hA.toFinset with g u = pt d i, T (g u)
        = ∑ u ∈ hA.toFinset with g u = pt d i, T (pt d i) :=
          Finset.sum_congr rfl (fun u hu => by rw [(Finset.mem_filter.mp hu).2])
      _ = d • T (pt d i) := by rw [Finset.sum_const, hcard]
  exact s3 (wcFixedOffS K m S e) hA (fun u => u (IsLocalRing.closedPoint (AlgebraicClosure K)))
    e.divisors (wcOffS K m S) hPfin hdisj hcov hfib np pt hnp hpt hinj T

theorem wc_ltc_frame_change (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (σ : ℚ_[ℓ] → (G ⟶ G))
    (W : S.ProEt) (r : ℕ) (θ : G.over W ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W)
    (hθ : ∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫
        θ.hom = θ.hom ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map
          (wcConstScalar S ℓ r c))
    (P : (Fin r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])) :
    ∃ θ' : G.over W ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W,
      (∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫
        θ'.hom = θ'.hom ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map
          (wcConstScalar S ℓ r c)) ∧
      ∀ (T : S.ProEt) (a : T ⟶ W) (s : G.obj.obj (Opposite.op T)) (z : T.left),
        wcLtcVal θ' a s z = P (wcLtcVal θ a s z) :=
by
  classical
  have hpc : Continuous P.toLinearMap := LinearMap.continuous_of_finiteDimensional _
  have hqc : Continuous P.symm.toLinearMap := LinearMap.continuous_of_finiteDimensional _
  let mP : wcContSheaf S (Fin r → ℚ_[ℓ]) ⟶ wcContSheaf S (Fin r → ℚ_[ℓ]) :=
    wcContSheafMap S P.toLinearMap.toAddMonoidHom hpc
  let mQ : wcContSheaf S (Fin r → ℚ_[ℓ]) ⟶ wcContSheaf S (Fin r → ℚ_[ℓ]) :=
    wcContSheafMap S P.symm.toLinearMap.toAddMonoidHom hqc
  have h1 : mP ≫ mQ = 𝟙 _ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply]
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    exact P.symm_apply_apply _
  have h2 : mQ ≫ mP = 𝟙 _ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply]
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    exact P.apply_symm_apply _
  have h3 : ∀ c : ℚ_[ℓ], wcConstScalar S ℓ r c ≫ mP = mP ≫ wcConstScalar S ℓ r c := by
    intro c
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
      ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply]
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    exact P.map_smul c _
  let cP : wcContSheaf S (Fin r → ℚ_[ℓ]) ≅ wcContSheaf S (Fin r → ℚ_[ℓ]) :=
    { hom := mP, inv := mQ, hom_inv_id := h1, inv_hom_id := h2 }
  refine ⟨θ ≪≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).mapIso cP,
    ?_, ?_⟩
  · intro c
    show ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫
        θ.hom ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map mP =
      (θ.hom ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map mP) ≫
        ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map
          (wcConstScalar S ℓ r c)
    rw [← Category.assoc, hθ c, Category.assoc, Category.assoc, ← Functor.map_comp,
      ← Functor.map_comp, h3 c]
  · intro T a s z
    rfl

theorem wc_ltc_transition_relations (S : Scheme.{u})
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt) (k ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (θ : G.over W ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over W)
    (τ : ↥(Limits.pullback W.hom W.hom) → ((Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])))
    (hτ : ∀ (V : S.ProEt) (a b : V ⟶ W) (x : G.obj.obj (Opposite.op V)) (z : V.left),
      wcLtcVal θ b x z = τ (wcLtcPair a b z) (wcLtcVal θ a x z))
    (P : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))
    (hint : ∀ (V : S.ProEt) (a b : V ⟶ W) (x : G.obj.obj (Opposite.op V)) (z : V.left),
      (∀ i, ‖P (wcLtcVal θ a x z) i‖ ≤ 1) → ∀ i, ‖P (wcLtcVal θ b x z) i‖ ≤ 1) :
    (∀ (T : S.ProEt) (a : T ⟶ W) (z : T.left) (v : Fin k → ℚ_[ℓ]),
        τ (wcLtcPair a a z) v = v) ∧
      (∀ (T : S.ProEt) (a b c : T ⟶ W) (z : T.left) (v : Fin k → ℚ_[ℓ]),
        τ (wcLtcPair a c z) v = τ (wcLtcPair b c z) (τ (wcLtcPair a b z) v)) ∧
      (∀ (p : ↥(Limits.pullback W.hom W.hom)) (v : Fin k → ℚ_[ℓ]),
        τ ((Limits.pullbackSymmetry W.hom W.hom).hom p) (τ p v) = v) ∧
      (∀ (p : ↥(Limits.pullback W.hom W.hom)) (u : Fin k → ℚ_[ℓ]), (∀ i, ‖u i‖ ≤ 1) →
        ∀ i, ‖P (τ p (P.symm u)) i‖ ≤ 1) :=
by
  have hconst : ∀ (T : S.ProEt) (a : T ⟶ W) (v : Fin k → ℚ_[ℓ]),
      ∃ x : G.obj.obj (Opposite.op T), ∀ z : T.left, wcLtcVal θ a x z = v := by
    intro T a v
    let y₀ : ((wcContSheaf S (Fin k → ℚ_[ℓ])).over W).obj.obj (Opposite.op (Over.mk a)) :=
      (ULift.up (ContinuousMap.const (↥T.left) v) : ULift.{u+1} C(↥T.left, Fin k → ℚ_[ℓ]))
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk a))).hom y₀, fun z => ?_⟩
    have E0 : (θ.hom.hom.app (Opposite.op (Over.mk a))).hom
        ((θ.inv.hom.app (Opposite.op (Over.mk a))).hom y₀) = y₀ :=
      Iso.inv_hom_id_app_apply ((sheafToPresheaf _ AddCommGrpCat).mapIso θ)
        (Opposite.op (Over.mk a)) y₀
    unfold wcLtcVal
    rw [E0]
    rfl
  have hW : Limits.pullback.fst W.hom W.hom ≫ W.hom = Limits.pullback.snd W.hom W.hom ≫ W.hom :=
    Limits.pullback.condition
  let VZ : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst W.hom W.hom ≫ W.hom)
  let a₀ : VZ ⟶ W := MorphismProperty.Over.homMk (Limits.pullback.fst W.hom W.hom) rfl trivial
  let b₀ : VZ ⟶ W := MorphismProperty.Over.homMk (Limits.pullback.snd W.hom W.hom) hW.symm trivial
  have Lab : ∀ p : ↥(Limits.pullback W.hom W.hom), wcLtcPair a₀ b₀ p = p := by
    intro p
    have h : wcLtcPair a₀ b₀ = 𝟙 (Limits.pullback W.hom W.hom) := by
      apply Limits.pullback.hom_ext
      · unfold wcLtcPair
        rw [Limits.pullback.lift_fst]
        exact (Category.id_comp (Limits.pullback.fst W.hom W.hom)).symm
      · unfold wcLtcPair
        rw [Limits.pullback.lift_snd]
        exact (Category.id_comp (Limits.pullback.snd W.hom W.hom)).symm
    rw [h]
    rfl
  have Lba : ∀ p : ↥(Limits.pullback W.hom W.hom),
      wcLtcPair b₀ a₀ p = (Limits.pullbackSymmetry W.hom W.hom).hom p := by
    intro p
    have h : wcLtcPair b₀ a₀ = (Limits.pullbackSymmetry W.hom W.hom).hom := by
      apply Limits.pullback.hom_ext
      · unfold wcLtcPair
        rw [Limits.pullback.lift_fst]
        exact (Limits.pullbackSymmetry_hom_comp_fst W.hom W.hom).symm
      · unfold wcLtcPair
        rw [Limits.pullback.lift_snd]
        exact (Limits.pullbackSymmetry_hom_comp_snd W.hom W.hom).symm
    rw [h]
    rfl
  have F1 : ∀ (x : G.obj.obj (Opposite.op VZ)) (p : ↥(Limits.pullback W.hom W.hom)),
      wcLtcVal θ b₀ x p = τ p (wcLtcVal θ a₀ x p) := by
    intro x p
    have := hτ VZ a₀ b₀ x p
    rw [Lab] at this
    exact this
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro T a z v
    obtain ⟨x, hx⟩ := hconst T a v
    have E := hτ T a a x z
    rw [hx] at E
    exact E.symm
  · intro T a b c z v
    obtain ⟨x, hx⟩ := hconst T a v
    have E1 := hτ T a b x z
    have E2 := hτ T b c x z
    have E3 := hτ T a c x z
    rw [hx] at E1 E3
    rw [E1] at E2
    exact E3.symm.trans E2
  · intro p v
    obtain ⟨x, hx⟩ := hconst VZ a₀ v
    have E1 := F1 x p
    have E2 := hτ VZ b₀ a₀ x p
    rw [Lba, E1, hx p] at E2
    exact E2.symm
  · intro p u hu i
    obtain ⟨x, hx⟩ := hconst VZ a₀ (P.symm u)
    have H := hint VZ a₀ b₀ x p (by
      intro j
      rw [hx p, LinearEquiv.apply_symm_apply]
      exact hu j) i
    rw [F1, hx p] at H
    exact H

theorem wc_ltc_gl_field (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ) {Z : Type u} [TopologicalSpace Z]
    (sw : Z → Z) (hsw2 : ∀ p, sw (sw p) = p) (hsw : Continuous sw)
    (f : Z → ((Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])))
    (hf : ∀ v, Continuous (fun p => f p v)) (hinv : ∀ p v, f (sw p) (f p v) = v)
    (hint : ∀ p (u : Fin r → ℚ_[ℓ]), (∀ i, ‖u i‖ ≤ 1) → ∀ i, ‖f p u i‖ ≤ 1) :
    ∃ N : Z → GL (Fin r) ℤ_[ℓ],
      (∀ p v, Matrix.vecMul v ((N p : Matrix (Fin r) (Fin r) ℤ_[ℓ]).map
        (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ]))) = f (sw p) v) ∧
      ∀ n : ℕ, IsLocallyConstant (fun p => wcLtcRed.{u} ℓ n r (N p)) :=
by
  classical
  have he : ∀ i : Fin r, ∀ k, ‖(Pi.single i (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ]) k‖ ≤ 1 := by
    intro i k
    by_cases h : k = i
    · subst h; simp
    · simp [Pi.single_eq_of_ne h]
  have hvec : ∀ (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]))
      (M : Matrix (Fin r) (Fin r) ℤ_[ℓ]),
      (∀ i j, (M i j : ℚ_[ℓ]) = g (Pi.single i 1) j) →
      ∀ v, Matrix.vecMul v (M.map (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ]))) = g v := by
    intro g M hM v
    have hv : v = ∑ i, v i • (Pi.single i (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ]) := by
      ext k
      simp [Finset.sum_apply, Pi.single_apply]
    conv_rhs => rw [hv]
    rw [map_sum]
    ext j
    simp only [Matrix.vecMul, dotProduct, Matrix.map_apply, hM, map_smul, Finset.sum_apply,
      Pi.smul_apply, smul_eq_mul]
  have hext : ∀ X Y : Matrix (Fin r) (Fin r) ℤ_[ℓ],
      (∀ v : Fin r → ℚ_[ℓ], Matrix.vecMul v (X.map (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ]))) =
        Matrix.vecMul v (Y.map (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ])))) → X = Y := by
    intro X Y h
    ext i j
    have h1 := congrFun (h (Pi.single i 1)) j
    rw [Matrix.single_one_vecMul, Matrix.single_one_vecMul] at h1
    exact PadicInt.ext h1
  have hmapmul : ∀ X Y : Matrix (Fin r) (Fin r) ℤ_[ℓ],
      (X * Y).map (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ])) =
        X.map (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ])) * Y.map (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ])) :=
    fun X Y => Matrix.map_mul (f := PadicInt.Coe.ringHom (p := ℓ))
  have hone : ∀ v : Fin r → ℚ_[ℓ],
      Matrix.vecMul v ((1 : Matrix (Fin r) (Fin r) ℤ_[ℓ]).map (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ]))) = v := by
    intro v
    rw [Matrix.map_one _ (by simp) (by simp), Matrix.vecMul_one]
  let A : Z → Matrix (Fin r) (Fin r) ℤ_[ℓ] := fun p i j =>
    ⟨f (sw p) (Pi.single i 1) j, hint (sw p) _ (he i) j⟩
  let B : Z → Matrix (Fin r) (Fin r) ℤ_[ℓ] := fun p i j =>
    ⟨f p (Pi.single i 1) j, hint p _ (he i) j⟩
  have hA : ∀ p v, Matrix.vecMul v ((A p).map (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ]))) = f (sw p) v :=
    fun p => hvec (f (sw p)) (A p) (fun i j => rfl)
  have hB : ∀ p v, Matrix.vecMul v ((B p).map (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ]))) = f p v :=
    fun p => hvec (f p) (B p) (fun i j => rfl)
  have hAB : ∀ p, A p * B p = 1 := by
    intro p
    apply hext
    intro v
    rw [hmapmul, ← Matrix.vecMul_vecMul, hA p v, hB p (f (sw p) v), hone]
    have := hinv (sw p) v
    rwa [hsw2] at this
  have hBA : ∀ p, B p * A p = 1 := by
    intro p
    apply hext
    intro v
    rw [hmapmul, ← Matrix.vecMul_vecMul, hB p v, hA p (f p v), hone]
    exact hinv p v
  refine ⟨fun p => ⟨A p, B p, hAB p, hBA p⟩, fun p v => hA p v, ?_⟩
  intro n
  rw [IsLocallyConstant.iff_exists_open]
  intro p₀
  have hcont : ∀ i j : Fin r, Continuous (fun p => ((A p i j : ℤ_[ℓ]) : ℚ_[ℓ])) := by
    intro i j
    exact (continuous_apply j).comp ((hf (Pi.single i 1)).comp hsw)
  have hεpos : (0 : ℝ) < (ℓ : ℝ) ^ (-(n : ℤ)) := by
    have : (0 : ℝ) < ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).pos
    positivity
  refine ⟨⋂ i, ⋂ j, (fun p => ((A p i j : ℤ_[ℓ]) : ℚ_[ℓ])) ⁻¹'
    Metric.closedBall ((A p₀ i j : ℚ_[ℓ])) ((ℓ : ℝ) ^ (-(n : ℤ))), ?_, ?_, ?_⟩
  · exact isOpen_iInter_of_finite fun i => isOpen_iInter_of_finite fun j =>
      (IsUltrametricDist.isOpen_closedBall _ hεpos.ne').preimage (hcont i j)
  · simp only [Set.mem_iInter, Set.mem_preimage, Metric.mem_closedBall, dist_self]
    intro i j
    exact hεpos.le
  · intro p hp
    simp only [Set.mem_iInter, Set.mem_preimage, Metric.mem_closedBall] at hp
    have key : ∀ i j, PadicInt.toZModPow n (A p i j) = PadicInt.toZModPow n (A p₀ i j) := by
      intro i j
      have h1 : ‖A p i j - A p₀ i j‖ ≤ (ℓ : ℝ) ^ (-(n : ℤ)) := by
        rw [PadicInt.norm_def, PadicInt.coe_sub, ← dist_eq_norm]
        exact hp i j
      rw [PadicInt.norm_le_pow_iff_mem_span_pow, ← PadicInt.ker_toZModPow, RingHom.mem_ker,
        map_sub, sub_eq_zero] at h1
      exact h1
    have hGL : Matrix.GeneralLinearGroup.map (PadicInt.toZModPow n)
        (⟨A p, B p, hAB p, hBA p⟩ : GL (Fin r) ℤ_[ℓ]) =
        Matrix.GeneralLinearGroup.map (PadicInt.toZModPow n)
        (⟨A p₀, B p₀, hAB p₀, hBA p₀⟩ : GL (Fin r) ℤ_[ℓ]) := by
      apply Matrix.GeneralLinearGroup.ext
      intro i j
      rw [Matrix.GeneralLinearGroup.map_apply, Matrix.GeneralLinearGroup.map_apply]
      exact key i j
    show wcLtcRed.{u} ℓ n r ⟨A p, B p, hAB p, hBA p⟩ = wcLtcRed.{u} ℓ n r ⟨A p₀, B p₀, hAB p₀, hBA p₀⟩
    have h2 := congrArg (ULift.up.{u}) hGL
    exact h2

theorem wc_ltc_integral_trivialization (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hlisse : wcLisseOffS K hP ℓ m S G σ) :
    ∃ (W : (wcP1Over K).left.ProEt) (r : ℕ)
      (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).over W)
      (N : ↥(Limits.pullback W.hom W.hom) → GL (Fin r) ℤ_[ℓ]),
      (∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology (wcP1Over K).left).overPullback
          AddCommGrpCat.{u+1} W).map (σ c) ≫ θ.hom =
        θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over K).left).overPullback
          AddCommGrpCat.{u+1} W).map (wcConstScalar (wcP1Over K).left ℓ r c)) ∧
      QuasiCompact W.hom ∧
      (∀ z : W.left, W.hom z ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K))) ∧
      (∀ p : (wcP1Over K).left, p ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K)) →
        ∃ z : W.left, W.hom z = p) ∧
      (∀ n : ℕ, IsLocallyConstant (fun x => wcLtcRed.{u} ℓ n r (N x))) ∧
      (∀ (T : (wcP1Over K).left.ProEt) (a b : T ⟶ W) (s : G.obj.obj (Opposite.op T))
          (z : T.left),
        wcLtcVal θ a s z = Matrix.vecMul (wcLtcVal θ b s z)
          ((N (wcLtcPair a b z) : Matrix (Fin r) (Fin r) ℤ_[ℓ]).map
            (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ])))) ∧
      (∀ (T : (wcP1Over K).left.ProEt) (a : T ⟶ W) (z : T.left), N (wcLtcPair a a z) = 1) ∧
      (∀ (T : (wcP1Over K).left.ProEt) (a b c : T ⟶ W) (z : T.left),
        N (wcLtcPair a c z) = N (wcLtcPair b c z) * N (wcLtcPair a b z)) :=
by
  classical
  obtain ⟨W, w, r, hqc, hconn, hoff, hsurj, θ, hθ⟩ := hlisse
  obtain ⟨P, hPint⟩ := wc_qclift_transition_lattice K hP m S ℓ G W w hqc hconn hsurj r θ
  obtain ⟨τ, hτc, hτ⟩ := wc_qtl_transition_matrix_field (wcP1Over K).left G W r ℓ θ
  obtain ⟨θ', hθ', hval⟩ := wc_ltc_frame_change (wcP1Over K).left ℓ G σ W r θ hθ P
  have hτ' : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W) (x : G.obj.obj (Opposite.op V))
      (z : V.left), wcLtcVal θ b x z = τ (wcLtcPair a b z) (wcLtcVal θ a x z) :=
    fun V a b x z => hτ V a b x z
  have hint' : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W) (x : G.obj.obj (Opposite.op V))
      (z : V.left), (∀ i, ‖P (wcLtcVal θ a x z) i‖ ≤ 1) → ∀ i, ‖P (wcLtcVal θ b x z) i‖ ≤ 1 :=
    fun V a b x z h => hPint V a b x z h
  obtain ⟨R1, R2, R3, R4⟩ :=
    wc_ltc_transition_relations (wcP1Over K).left G W r ℓ θ τ hτ' P hint'
  have hswsw : (Limits.pullbackSymmetry W.hom W.hom).hom ≫
      (Limits.pullbackSymmetry W.hom W.hom).hom = 𝟙 _ := by
    apply Limits.pullback.hom_ext <;> simp
  have hsw2 : ∀ p, (Limits.pullbackSymmetry W.hom W.hom).hom
      ((Limits.pullbackSymmetry W.hom W.hom).hom p) = p := by
    intro p
    rw [← Scheme.Hom.comp_apply, hswsw]
    rfl
  have hpair : ∀ (T : (wcP1Over K).left.ProEt) (a b : T ⟶ W) (z : T.left),
      wcLtcPair b a z = (Limits.pullbackSymmetry W.hom W.hom).hom (wcLtcPair a b z) := by
    intro T a b z
    have h : wcLtcPair b a = wcLtcPair a b ≫ (Limits.pullbackSymmetry W.hom W.hom).hom := by
      apply Limits.pullback.hom_ext
      · simp only [wcLtcPair, Category.assoc, Limits.pullbackSymmetry_hom_comp_fst]
        erw [Limits.pullback.lift_fst, Limits.pullback.lift_snd]
      · simp only [wcLtcPair, Category.assoc, Limits.pullbackSymmetry_hom_comp_snd]
        erw [Limits.pullback.lift_fst, Limits.pullback.lift_snd]
    rw [h, Scheme.Hom.comp_apply]
  let f : ↥(Limits.pullback W.hom W.hom) → ((Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])) :=
    fun p => P.toLinearMap ∘ₗ τ p ∘ₗ P.symm.toLinearMap
  have hfapp : ∀ p v, f p v = P (τ p (P.symm v)) := fun p v => rfl
  have hPc : Continuous P := LinearMap.continuous_of_finiteDimensional P.toLinearMap
  have hf : ∀ v, Continuous (fun p => f p v) := fun v => hPc.comp (hτc (P.symm v))
  have hinv : ∀ p v, f ((Limits.pullbackSymmetry W.hom W.hom).hom p) (f p v) = v := by
    intro p v
    rw [hfapp, hfapp, LinearEquiv.symm_apply_apply, R3, LinearEquiv.apply_symm_apply]
  have hfint : ∀ p (u : Fin r → ℚ_[ℓ]), (∀ i, ‖u i‖ ≤ 1) → ∀ i, ‖f p u i‖ ≤ 1 :=
    fun p u hu i => R4 p u hu i
  obtain ⟨N, hNvec, hNlc⟩ := wc_ltc_gl_field ℓ r
    (fun p => (Limits.pullbackSymmetry W.hom W.hom).hom p) hsw2
    (Limits.pullbackSymmetry W.hom W.hom).hom.continuous f hf hinv hfint
  have hGLext : ∀ M M' : GL (Fin r) ℤ_[ℓ],
      (∀ v : Fin r → ℚ_[ℓ],
        Matrix.vecMul v ((M : Matrix (Fin r) (Fin r) ℤ_[ℓ]).map (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ]))) =
        Matrix.vecMul v ((M' : Matrix (Fin r) (Fin r) ℤ_[ℓ]).map
          (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ])))) → M = M' := by
    intro M M' h
    apply Matrix.GeneralLinearGroup.ext
    intro i j
    have h1 := congrFun (h (Pi.single i 1)) j
    rw [Matrix.single_one_vecMul, Matrix.single_one_vecMul] at h1
    exact PadicInt.ext h1
  have hmapmul : ∀ A B : Matrix (Fin r) (Fin r) ℤ_[ℓ],
      (A * B).map (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ])) =
        A.map (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ])) * B.map (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ])) :=
    fun A B => Matrix.map_mul (f := PadicInt.Coe.ringHom (p := ℓ))
  refine ⟨W, r, θ', N, hθ', ?_, ?_, ?_, hNlc, ?_, ?_, ?_⟩
  ·
    have hw : w.left ≫ (wcGeomPoint K (wcP1Over K) hP).hom = W.hom := MorphismProperty.Over.w w
    rw [← hw]
    haveI : QuasiCompact w.left := hqc
    haveI : QuasiCompact (wcGeomPoint K (wcP1Over K) hP).hom := by
      show QuasiCompact (Limits.pullback.fst (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
      infer_instance
    infer_instance
  ·
    rintro z ⟨i, hi⟩
    exact hoff z i hi.symm
  ·
    intro p hp
    obtain ⟨p', hp1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := (wcP1Over K).hom)
      (g := Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) p
      (IsLocalRing.closedPoint (AlgebraicClosure K)) (Subsingleton.elim _ _)
    have hp1' : (wcGeomPoint K (wcP1Over K) hP).hom p' = p := hp1
    obtain ⟨z, hz⟩ := hsurj p' (fun i h => hp ⟨i, h.symm.trans hp1'⟩)
    refine ⟨z, ?_⟩
    rw [← MorphismProperty.Over.w w, Scheme.Hom.comp_apply, hz]
    exact hp1'
  ·
    intro T a b s z
    rw [hNvec, hval, hval, hτ' T b a s z, hpair T a b z, hfapp, LinearEquiv.symm_apply_apply]
  ·
    intro T a z
    apply hGLext
    intro v
    rw [hNvec, ← hpair T a a z, hfapp, R1, LinearEquiv.apply_symm_apply, Units.val_one,
      Matrix.map_one _ (by simp) (by simp), Matrix.vecMul_one]
  ·
    intro T a b c z
    apply hGLext
    intro v
    rw [Units.val_mul, hmapmul, ← Matrix.vecMul_vecMul]
    simp only [hNvec]
    rw [← hpair T a c z, ← hpair T a b z, ← hpair T b c z, hfapp, hfapp, hfapp,
      LinearEquiv.symm_apply_apply, R2 T c b a z]

theorem wc_ftd_local_rep : wcFpqcFamDescHyp.{u} → wcFpqcLcDescHyp.{u} → wcGTorDescHyp.{u} → ∀ (U X : Scheme.{u}) (p : X ⟶ U), Flat p → QuasiCompact p → Surjective p → ∀ (Γ : Type) [Group Γ] [Finite Γ] (c : ↥(Limits.pullback p p) → Γ), IsLocallyConstant c → wcGCocycle (V := fun _ : Unit => X) (fun _ => p) (fun _ _ => c) → ∀ x : U, ∃ O : U.Opens, x ∈ O ∧ ∃ (E : Scheme.{u}) (π : E ⟶ (O : Scheme.{u})) (Λ : ∀ l : Unit, ↥(Limits.pullback (π ≫ O.ι) ((fun _ : Unit => p) l)) → Γ), IsFinite π ∧ Etale π ∧ wcGRep (V := fun _ : Unit => X) (fun _ => p) (fun _ _ => c) O (π ≫ O.ι) Λ :=
by
  intro hD hL hR U X p hflat hqc hsurj Γ _ _ c hc hG x
  classical

  have hhi : ∀ {A B : Scheme.{u}} (κ : A ≅ B) (y : ↥A), κ.inv (κ.hom y) = y := by
    intro A B κ y
    rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]
    first | rfl | simp
  have hii : ∀ {A B : Scheme.{u}} (κ : A ≅ B) (y : ↥B), κ.hom (κ.inv y) = y := by
    intro A B κ y
    rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]
    first | rfl | simp

  obtain ⟨O, hO, hxO, -⟩ :=
    exists_isAffineOpen_mem_and_subset (X := U) (x := x) (U := ⊤) trivial
  haveI : IsAffine (O : Scheme.{u}) := hO
  have key : ∀ (XO : Scheme.{u}) (j : XO ⟶ X) (pO : XO ⟶ (O : Scheme.{u})),
      IsPullback pO j O.ι p → pO ≫ O.ι = j ≫ p →
      ∃ (E : Scheme.{u}) (π : E ⟶ (O : Scheme.{u}))
        (Λ : ∀ l : Unit, ↥(Limits.pullback (π ≫ O.ι) ((fun _ : Unit => p) l)) → Γ),
        IsFinite π ∧ Etale π ∧
          wcGRep (V := fun _ : Unit => X) (fun _ => p) (fun _ _ => c) O (π ≫ O.ι) Λ := by
    intro XO j pO hpb hw
    haveI hflO : Flat pO := MorphismProperty.of_isPullback (P := @Flat) hpb.flip hflat
    haveI hqcO : QuasiCompact pO :=
      MorphismProperty.of_isPullback (P := @QuasiCompact) hpb.flip hqc
    have hsurjO : Surjective pO :=
      MorphismProperty.of_isPullback (P := @Surjective) hpb.flip hsurj

    have hjp : ∀ {Z : Scheme.{u}} {a d : Z ⟶ XO}, a ≫ pO = d ≫ pO →
        (a ≫ j) ≫ p = (d ≫ j) ≫ p := by
      intro Z a d h
      rw [Category.assoc, Category.assoc, ← hw, ← Category.assoc, h, Category.assoc]
    let μ : Limits.pullback pO pO ⟶ Limits.pullback p p :=
      Limits.pullback.map pO pO p p j j O.ι hw hw
    let cO : ↥(Limits.pullback pO pO) → Γ := fun y => c (μ y)
    have hμ' : ∀ {Z : Scheme.{u}} (a d : Z ⟶ XO) (h : a ≫ pO = d ≫ pO) (a' d' : Z ⟶ X)
        (h' : a' ≫ p = d' ≫ p), a ≫ j = a' → d ≫ j = d' →
        Limits.pullback.lift a d h ≫ μ = Limits.pullback.lift a' d' h' := by
      intro Z a d h a' d' h' ha hd
      apply Limits.pullback.hom_ext
      · simp only [μ, Limits.pullback.map, Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.lift_fst_assoc, ha]
      · simp only [μ, Limits.pullback.map, Category.assoc, Limits.pullback.lift_snd,
          Limits.pullback.lift_snd_assoc, hd]
    have hcO : ∀ {Z : Scheme.{u}} (a d : Z ⟶ XO) (h : a ≫ pO = d ≫ pO) (a' d' : Z ⟶ X)
        (h' : a' ≫ p = d' ≫ p), a ≫ j = a' → d ≫ j = d' → ∀ z : Z,
        cO (Limits.pullback.lift a d h z) = c (Limits.pullback.lift a' d' h' z) := by
      intro Z a d h a' d' h' ha hd z
      show c (μ (Limits.pullback.lift a d h z)) = _
      rw [← hμ' a d h a' d' h' ha hd, Scheme.Hom.comp_apply]
    have hcOlc : IsLocallyConstant cO := hc.comp_continuous μ.continuous
    have hGO : wcGCocycle (V := fun _ : Unit => XO) (fun _ => pO) (fun _ _ => cO) := by
      intro i i' i'' Z a b d hab hbd had z
      have e1 := hcO a d had (a ≫ j) (d ≫ j) (hjp had) rfl rfl z
      have e2 := hcO a b hab (a ≫ j) (b ≫ j) (hjp hab) rfl rfl z
      have e3 := hcO b d hbd (b ≫ j) (d ≫ j) (hjp hbd) rfl rfl z
      have e4 := hG () () () Z (a ≫ j) (b ≫ j) (d ≫ j) (hjp hab) (hjp hbd) (hjp had) z
      show cO (Limits.pullback.lift a d had z) =
        cO (Limits.pullback.lift a b hab z) * cO (Limits.pullback.lift b d hbd z)
      rw [e1, e2, e3]
      exact e4

    have hK : ∀ {T : Scheme.{u}} (tO : T ⟶ (O : Scheme.{u})),
        ∃ κ : Limits.pullback tO pO ≅ Limits.pullback (tO ≫ O.ι) p,
          κ.hom ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ ∧
          κ.hom ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ ≫ j := by
      intro T tO
      have e₁ : Limits.pullback.fst tO pO ≫ tO ≫ O.ι =
          (Limits.pullback.snd tO pO ≫ j) ≫ p := by
        rw [Category.assoc, ← hw, Limits.pullback.condition_assoc]
      have e₂ : (Limits.pullback.fst (tO ≫ O.ι) p ≫ tO) ≫ O.ι =
          Limits.pullback.snd (tO ≫ O.ι) p ≫ p := by
        rw [Category.assoc, Limits.pullback.condition]
      have e₃ : Limits.pullback.fst (tO ≫ O.ι) p ≫ tO = hpb.lift _ _ e₂ ≫ pO :=
        (hpb.lift_fst _ _ e₂).symm
      refine ⟨⟨Limits.pullback.lift (Limits.pullback.fst tO pO)
          (Limits.pullback.snd tO pO ≫ j) e₁,
        Limits.pullback.lift (Limits.pullback.fst (tO ≫ O.ι) p) (hpb.lift _ _ e₂) e₃, ?_, ?_⟩,
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
      · apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst,
            Category.id_comp]
        · apply hpb.hom_ext
          · rw [Category.assoc, Category.assoc, Limits.pullback.lift_snd_assoc, hpb.lift_fst,
              Category.id_comp, ← Limits.pullback.condition, ← Category.assoc,
              Limits.pullback.lift_fst]
          · rw [Category.assoc, Category.assoc, Limits.pullback.lift_snd_assoc, hpb.lift_snd,
              Category.id_comp, Limits.pullback.lift_snd]
      · apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst,
            Category.id_comp]
        · rw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc,
            Limits.pullback.lift_snd, hpb.lift_snd, Category.id_comp]

    have hFam : ∀ {T : Scheme.{u}} (tO : T ⟶ (O : Scheme.{u}))
        (κ : Limits.pullback tO pO ≅ Limits.pullback (tO ≫ O.ι) p),
        κ.hom ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ →
        κ.hom ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ ≫ j →
        ∀ lam : ∀ l : Unit, ↥(Limits.pullback (tO ≫ O.ι) p) → Γ,
        (wcGFam (V := fun _ : Unit => X) (fun _ => p) (fun _ _ => c) (tO ≫ O.ι) lam ↔
          wcGFam (V := fun _ : Unit => XO) (fun _ => pO) (fun _ _ => cO) tO
            (fun l w => lam l (κ.hom w))) := by
      intro T tO κ h1 h2 lam
      have hlift : ∀ {Z : Scheme.{u}} (a : Z ⟶ T) (b : Z ⟶ XO), a ≫ tO = b ≫ pO →
          a ≫ (tO ≫ O.ι) = (b ≫ j) ≫ p := by
        intro Z a b h
        rw [← Category.assoc, h, Category.assoc, hw, Category.assoc]
      have hκpt : ∀ {Z : Scheme.{u}} (a : Z ⟶ T) (bO : Z ⟶ XO) (hb : a ≫ tO = bO ≫ pO)
          (b : Z ⟶ X) (h : a ≫ (tO ≫ O.ι) = b ≫ p), bO ≫ j = b → ∀ z : Z,
          κ.hom (Limits.pullback.lift a bO hb z) = Limits.pullback.lift a b h z := by
        intro Z a bO hb b h hbj z
        have e : Limits.pullback.lift a bO hb ≫ κ.hom = Limits.pullback.lift a b h := by
          apply Limits.pullback.hom_ext
          · rw [Category.assoc, h1, Limits.pullback.lift_fst, Limits.pullback.lift_fst]
          · rw [Category.assoc, h2, Limits.pullback.lift_snd_assoc, hbj,
              Limits.pullback.lift_snd]
        rw [← e, Scheme.Hom.comp_apply]
      constructor
      · rintro ⟨hlc, hcomp⟩
        refine ⟨fun l => (hlc l).comp_continuous κ.hom.continuous, ?_⟩
        intro l l' Z a b b' h h' h'' z
        have e1 := hκpt a b' h' (b' ≫ j) (hlift a b' h') rfl z
        have e2 := hκpt a b h (b ≫ j) (hlift a b h) rfl z
        have e3 := hcO b b' h'' (b ≫ j) (b' ≫ j) (hjp h'') rfl rfl z
        have e4 := hcomp l l' Z a (b ≫ j) (b' ≫ j) (hlift a b h) (hlift a b' h') (hjp h'') z
        show lam l' (κ.hom (Limits.pullback.lift a b' h' z)) =
          lam l (κ.hom (Limits.pullback.lift a b h z)) * cO (Limits.pullback.lift b b' h'' z)
        rw [e1, e2, e3]
        exact e4
      · intro H
        refine ⟨fun l => ?_, ?_⟩
        · have hc' := (H.1 l).comp_continuous κ.inv.continuous
          convert hc' using 1
          funext y
          exact (congrArg (lam l) (hii κ y)).symm
        · intro l l' Z a b b' h h' h'' z
          have eb : (a ≫ tO) ≫ O.ι = b ≫ p := by rw [Category.assoc]; exact h
          have eb' : (a ≫ tO) ≫ O.ι = b' ≫ p := by rw [Category.assoc]; exact h'
          have hb1 := hpb.lift_fst (a ≫ tO) b eb
          have hb2 := hpb.lift_snd (a ≫ tO) b eb
          have hb1' := hpb.lift_fst (a ≫ tO) b' eb'
          have hb2' := hpb.lift_snd (a ≫ tO) b' eb'
          have hb : a ≫ tO = hpb.lift (a ≫ tO) b eb ≫ pO := hb1.symm
          have hb' : a ≫ tO = hpb.lift (a ≫ tO) b' eb' ≫ pO := hb1'.symm
          have hbb : hpb.lift (a ≫ tO) b eb ≫ pO = hpb.lift (a ≫ tO) b' eb' ≫ pO := by
            rw [hb1, hb1']
          have e1 := hκpt a _ hb' b' h' hb2' z
          have e2 := hκpt a _ hb b h hb2 z
          have e3 := hcO _ _ hbb b b' h'' hb2 hb2' z
          have e4 := H.2 l l' Z a _ _ hb hb' hbb z
          show lam l' (Limits.pullback.lift a b' h' z) =
            lam l (Limits.pullback.lift a b h z) * c (Limits.pullback.lift b b' h'' z)
          rw [← e1, ← e2, ← e3]
          exact e4

    have transfer : ∀ (E : Scheme.{u}) (π₀ : E ⟶ (O : Scheme.{u}))
        (Λ₁ : ∀ l : Unit, ↥(Limits.pullback π₀ pO) → Γ),
        wcGRep (V := fun _ : Unit => XO) (fun _ => pO) (fun _ _ => cO) ⊤ π₀ Λ₁ →
        ∃ Λ : ∀ l : Unit, ↥(Limits.pullback (π₀ ≫ O.ι) p) → Γ,
          wcGRep (V := fun _ : Unit => X) (fun _ => p) (fun _ _ => c) O (π₀ ≫ O.ι) Λ := by
      rintro E π₀ Λ₁ ⟨-, hR2, hR3⟩
      obtain ⟨κπ, hκπ1, hκπ2⟩ := hK π₀
      refine ⟨fun l y => Λ₁ l (κπ.inv y), ?_, ?_, ?_⟩
      · rintro _ ⟨e, rfl⟩
        exact (Set.ext_iff.mp (Scheme.Opens.range_ι O) _).mp
          ⟨π₀ e, by rw [Scheme.Hom.comp_apply]⟩
      · refine (hFam π₀ κπ hκπ1 hκπ2 _).mpr ?_
        convert hR2 using 1
        funext l w
        exact congrArg (Λ₁ l) (hhi κπ w)
      · intro T t ht lam hlam
        have hrange : Set.range t ⊆ Set.range O.ι := by
          rw [Scheme.Opens.range_ι]; exact ht
        obtain ⟨tO, rfl⟩ : ∃ tO : T ⟶ (O : Scheme.{u}), tO ≫ O.ι = t :=
          ⟨_, IsOpenImmersion.lift_fac O.ι t hrange⟩
        obtain ⟨κt, hκt1, hκt2⟩ := hK tO
        have hlamO := (hFam tO κt hκt1 hκt2 lam).mp hlam
        obtain ⟨φ, ⟨hφ, hφlam⟩, huniq⟩ := hR3 T tO (by simp) _ hlamO
        have hsqpt : ∀ (ψ : T ⟶ E) (hψ : ψ ≫ π₀ = tO) (w : ↥(Limits.pullback tO pO)),
            κπ.hom (Limits.pullback.map tO pO π₀ pO ψ (𝟙 _) (𝟙 _)
              (by rw [Category.comp_id, hψ]) (by simp) w) =
            Limits.pullback.map (tO ≫ O.ι) p (π₀ ≫ O.ι) p ψ (𝟙 _) (𝟙 _)
              (by rw [Category.comp_id, ← Category.assoc, hψ]) (by simp) (κt.hom w) := by
          intro ψ hψ w
          have hsq : Limits.pullback.map tO pO π₀ pO ψ (𝟙 _) (𝟙 _)
                (by rw [Category.comp_id, hψ]) (by simp) ≫ κπ.hom =
              κt.hom ≫ Limits.pullback.map (tO ≫ O.ι) p (π₀ ≫ O.ι) p ψ (𝟙 _) (𝟙 _)
                (by rw [Category.comp_id, ← Category.assoc, hψ]) (by simp) := by
            apply Limits.pullback.hom_ext
            · rw [Category.assoc, Category.assoc, hκπ1, Limits.pullback.lift_fst,
                Limits.pullback.lift_fst, ← Category.assoc, hκt1]
            · rw [Category.assoc, Category.assoc, hκπ2, Limits.pullback.lift_snd_assoc,
                Limits.pullback.lift_snd, ← Category.assoc, hκt2, Category.comp_id,
                Category.assoc, Category.comp_id]
          rw [← Scheme.Hom.comp_apply, hsq, Scheme.Hom.comp_apply]
        refine ⟨φ, ⟨by rw [← Category.assoc, hφ], fun l w => ?_⟩, ?_⟩
        · have h2 := hsqpt φ hφ (κt.inv w)
          rw [hii κt w] at h2
          refine (congrArg (lam l) (hii κt w)).symm.trans ((hφlam l (κt.inv w)).trans ?_)
          rw [← h2]
          exact (congrArg (Λ₁ l) (hhi κπ _)).symm
        · rintro φ' ⟨h', hlam'⟩
          have hφ' : φ' ≫ π₀ = tO := by
            apply (cancel_mono O.ι).mp
            rw [Category.assoc]; exact h'
          refine huniq φ' ⟨hφ', fun l w' => ?_⟩
          have h2 := hsqpt φ' hφ' w'
          refine (hlam' l (κt.hom w')).trans ?_
          rw [← h2]
          exact congrArg (Λ₁ l) (hhi κπ _)

    obtain ⟨n, W, k, w, E, π, σ, hfin, het, hWaff, hwopen, hσ, hOcov, hσcov, hmeet⟩ :=
      wc_fgtor_affine_sheeted (O : Scheme.{u}) Γ Unit (fun _ => XO) (fun _ => pO)
        (fun _ => hflO) (fun _ => hqcO) (fun _ _ => cO) (fun _ _ => hcOlc) hGO hR ⊤
        (isAffineOpen_top _) (fun y _ => ⟨(), hsurjO.surj y⟩)

    have hfl : ∀ m, Flat (w m ≫ (fun _ : Unit => pO) (k m)) := by
      intro m
      haveI := hwopen m
      show Flat (w m ≫ pO)
      infer_instance
    have hqc' : ∀ m, QuasiCompact (w m ≫ (fun _ : Unit => pO) (k m)) := by
      intro m
      haveI := hWaff m
      exact quasiCompact_of_compactSpace _
    obtain ⟨Λ₁, hΛ₁⟩ := wc_fgtor_rep_of_sheets hD hL (O : Scheme.{u}) Γ Unit (fun _ => XO)
      (fun _ => pO) (fun _ _ => cO) (fun _ _ => hcOlc) hGO ⊤ n W k w E π σ hfin het hfl hqc'
      hσ hOcov hσcov hmeet
    haveI : IsIso (⊤ : (O : Scheme.{u}).Opens).ι :=
      isIso_of_isOpenImmersion_of_opensRange_eq_top _ (Scheme.Opens.opensRange_ι _)
    have hfin₀ : IsFinite (π ≫ (⊤ : (O : Scheme.{u}).Opens).ι) := by
      haveI := hfin; infer_instance
    have het₀ : Etale (π ≫ (⊤ : (O : Scheme.{u}).Opens).ι) := by
      haveI := het; infer_instance
    obtain ⟨Λ, hΛ⟩ := transfer E (π ≫ (⊤ : (O : Scheme.{u}).Opens).ι) Λ₁ hΛ₁
    exact ⟨E, _, Λ, hfin₀, het₀, hΛ⟩
  obtain ⟨E, π, Λ, h1, h2, h3⟩ :=
    key _ _ _ (isPullback_morphismRestrict p O) (morphismRestrict_ι p O)
  exact ⟨O, hxO, E, π, Λ, h1, h2, h3⟩

theorem wc_ftd_deck_action : wcFpqcFamDescHyp.{u} → ∀ (U X E : Scheme.{u}) (p : X ⟶ U) (πE : E ⟶ U), Flat p → QuasiCompact p → Surjective p → IsFinite πE → Etale πE → ∀ (H : Type u) [Group H] [Finite H] (g : ↥(Limits.pullback p p) → H) (s : H → (X ⟶ E)), (∀ γ, s γ ≫ πE = p) → (∀ (Z : Scheme.{u}) (a b : Z ⟶ X) (hab : a ≫ p = b ≫ p) (γ γ' : H), a ≫ s γ = b ≫ s γ' ↔ ∀ z : Z, γ' = γ * g (Limits.pullback.lift a b hab z)) → (∀ (Z : Scheme.{u}), ConnectedSpace Z → ∀ (a : Z ⟶ X) (e : Z ⟶ E), a ≫ p = e ≫ πE → ∃ γ, e = a ≫ s γ) → ∃ ψ : H → (E ⟶ E), (∀ δ γ, s γ ≫ ψ δ = s (δ * γ)) ∧ (∀ δ, ψ δ ≫ πE = πE) ∧ ψ 1 = 𝟙 E ∧ (∀ δ ε, ψ (δ * ε) = ψ ε ≫ ψ δ) :=
by
  intro hD U X E p πE hpflat hpqc hpsurj hfin het H _ _ g s hs hMR hLOC
  haveI : IsFinite πE := hfin
  haveI : Etale πE := het

  haveI hpost : MorphismProperty.HasOfPostcompProperty @Flat @Etale :=
    (MorphismProperty.hasOfPostcompProperty_iff_le_diagonal (P := @Flat) (Q := @Etale)).2
      (fun X Y f hf => MorphismProperty.diagonal_iff.2 (by have : Etale f := hf; infer_instance))
  have hsflat : ∀ γ, Flat (s γ) := fun γ =>
    MorphismProperty.of_postcomp (W := @Flat) (W' := @Etale) (s γ) πE het
      (by rw [hs γ]; exact hpflat)
  have hsqc : ∀ γ, QuasiCompact (s γ) := fun γ => by
    haveI : QuasiCompact (s γ ≫ πE) := by rw [hs γ]; exact hpqc
    exact QuasiCompact.of_comp (s γ) πE

  have hcovH : ∀ y : E, ∃ γ x, s γ x = y := by
    intro y
    obtain ⟨x₀, hx₀⟩ := hpsurj.surj (πE y)
    obtain ⟨w, hw1, hw2⟩ :=
      Scheme.Pullback.exists_preimage_pullback (f := πE) (g := p) y x₀ hx₀.symm
    let r := (Limits.pullback πE p).fromSpecResidueField w
    let a := r ≫ Limits.pullback.snd πE p
    let e := r ≫ Limits.pullback.fst πE p
    have hae : a ≫ p = e ≫ πE := by
      simp only [a, e, Category.assoc, Limits.pullback.condition]
    obtain ⟨γ, hγ⟩ := hLOC _ inferInstance a e hae
    let z₀ : Spec ((Limits.pullback πE p).residueField w) := IsLocalRing.closedPoint _
    have hr : r z₀ = w := by
      have hmem : r z₀ ∈ Set.range r := ⟨z₀, rfl⟩
      rw [Scheme.range_fromSpecResidueField] at hmem
      exact hmem
    refine ⟨γ, a z₀, ?_⟩
    rw [← Scheme.Hom.comp_apply, ← hγ]
    show (r ≫ Limits.pullback.fst πE p) z₀ = y
    rw [Scheme.Hom.comp_apply, hr, hw1]

  let n := Nat.card H
  let eq : H ≃ Fin n := Finite.equivFin H
  let f : Fin n → (X ⟶ E) := fun i => s (eq.symm i)
  have hfflat : ∀ i, Flat (f i) := fun i => hsflat _
  have hfqc : ∀ i, QuasiCompact (f i) := fun i => hsqc _
  have hfcov : ∀ y : E, ∃ i, y ∈ Set.range (f i) := by
    intro y
    obtain ⟨γ, x, hx⟩ := hcovH y
    refine ⟨eq γ, x, ?_⟩
    show s (eq.symm (eq γ)) x = y
    rw [Equiv.symm_apply_apply]
    exact hx

  have hepi : ∀ (Y : Scheme.{u}) (φ₁ φ₂ : E ⟶ Y), (∀ γ, s γ ≫ φ₁ = s γ ≫ φ₂) → φ₁ = φ₂ := by
    intro Y φ₁ φ₂ h
    have huniq := hD E Y (Fin n) (fun _ => X) f hfflat hfqc hfcov (fun i => f i ≫ φ₁)
      (fun i j Z a b hab => by rw [← Category.assoc, hab, Category.assoc])
    exact huniq.unique (fun i => rfl) (fun i => (h _).symm)

  have hex : ∀ δ : H, ∃ φ : E ⟶ E, ∀ i, f i ≫ φ = s (δ * eq.symm i) := by
    intro δ
    refine (hD E E (Fin n) (fun _ => X) f hfflat hfqc hfcov
      (fun i => s (δ * eq.symm i)) ?_).exists
    intro i j Z a b hab'
    have hab'' : a ≫ s (eq.symm i) = b ≫ s (eq.symm j) := hab'
    have hab : a ≫ p = b ≫ p := by
      calc a ≫ p = (a ≫ s (eq.symm i)) ≫ πE := by rw [Category.assoc, hs]
        _ = (b ≫ s (eq.symm j)) ≫ πE := by rw [hab'']
        _ = b ≫ p := by rw [Category.assoc, hs]
    have h1 := (hMR Z a b hab (eq.symm i) (eq.symm j)).mp hab''
    refine (hMR Z a b hab (δ * eq.symm i) (δ * eq.symm j)).mpr ?_
    intro z
    rw [h1 z, mul_assoc]
  choose ψ hψi using hex
  have hψs : ∀ δ γ, s γ ≫ ψ δ = s (δ * γ) := by
    intro δ γ
    have h := hψi δ (eq γ)
    have e1 : f (eq γ) = s γ := by
      show s (eq.symm (eq γ)) = s γ
      rw [Equiv.symm_apply_apply]
    rw [e1, Equiv.symm_apply_apply] at h
    exact h

  refine ⟨ψ, hψs, ?_, ?_, ?_⟩
  · intro δ
    apply hepi U
    intro γ
    rw [← Category.assoc, hψs, hs, hs]
  · apply hepi E
    intro γ
    rw [hψs, one_mul, Category.comp_id]
  · intro δ ε
    apply hepi E
    intro γ
    rw [hψs, ← Category.assoc, hψs, hψs, mul_assoc]

theorem wc_ftd_torsor_iso : ∀ (U X E : Scheme.{u}) (p : X ⟶ U) (πE : E ⟶ U), Surjective p → Etale πE → ∀ (H : Type u) [Group H] (g : ↥(Limits.pullback p p) → H) (s : H → (X ⟶ E)), (∀ γ, s γ ≫ πE = p) → (∀ (Z : Scheme.{u}) (a b : Z ⟶ X) (hab : a ≫ p = b ≫ p) (γ γ' : H), a ≫ s γ = b ≫ s γ' ↔ ∀ z : Z, γ' = γ * g (Limits.pullback.lift a b hab z)) → (∀ (Z : Scheme.{u}), ConnectedSpace Z → ∀ (a : Z ⟶ X) (e : Z ⟶ E), a ≫ p = e ≫ πE → ∃ γ, e = a ≫ s γ) → ∀ (ψ : H → (E ⟶ E)) (hψs : ∀ δ γ, s γ ≫ ψ δ = s (δ * γ)) (hψπ : ∀ δ, ψ δ ≫ πE = πE), IsIso (Limits.Sigma.desc (fun δ : H => Limits.pullback.lift (ψ δ) (𝟙 E) ((hψπ δ).trans (Category.id_comp πE).symm)) : ∐ (fun _ : H => E) ⟶ Limits.pullback πE πE) :=
by
  intro U X E p πE hp hπ H _ g s hs hMR hLOC ψ hψs hψπ
  classical
  haveI : Surjective p := hp
  haveI : Etale πE := hπ
  let d : H → (E ⟶ Limits.pullback πE πE) := fun δ =>
    Limits.pullback.lift (ψ δ) (𝟙 E) ((hψπ δ).trans (Category.id_comp πE).symm)
  show IsIso (Limits.Sigma.desc d)
  have hd1 : ∀ δ, d δ ≫ Limits.pullback.fst πE πE = ψ δ := fun δ => Limits.pullback.lift_fst _ _ _
  have hd2 : ∀ δ, d δ ≫ Limits.pullback.snd πE πE = 𝟙 E := fun δ =>
    Limits.pullback.lift_snd _ _ _

  haveI hpost : MorphismProperty.HasOfPostcompProperty @Etale @Etale :=
    (MorphismProperty.hasOfPostcompProperty_iff_le_diagonal (P := @Etale) (Q := @Etale)).2
      (fun X Y f hf => MorphismProperty.diagonal_iff.2 (by have : Etale f := hf; infer_instance))
  haveI hOI : ∀ δ, IsOpenImmersion (d δ) := by
    intro δ
    have hsnd : Etale (Limits.pullback.snd πE πE) := inferInstance
    haveI : Etale (d δ) := MorphismProperty.of_postcomp (W := @Etale) (W' := @Etale) (d δ)
      (Limits.pullback.snd πE πE) hsnd (by rw [hd2]; infer_instance)
    haveI : Mono (d δ) := mono_of_mono_fac (hd2 δ)
    exact IsOpenImmersion.of_flat_of_mono (d δ)

  have hpt : ∀ (T : Scheme.{u}) (e : T ⟶ E) (t : T), ∃ (Z : Scheme.{u}) (z : Z) (r : Z ⟶ T)
      (a : Z ⟶ X) (γ : H), ConnectedSpace Z ∧ r z = t ∧ r ≫ e = a ≫ s γ := by
    intro T e t
    obtain ⟨w, hw⟩ := (Surjective.surj (f := p)) (πE (e t))
    have hq : (e ≫ πE) t = p w := by rw [Scheme.Hom.comp_apply, hw]
    obtain ⟨q, hq1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := e ≫ πE) (g := p) t w hq
    let φ := (Limits.pullback (e ≫ πE) p).fromSpecResidueField q
    let r := φ ≫ Limits.pullback.fst (e ≫ πE) p
    let a := φ ≫ Limits.pullback.snd (e ≫ πE) p
    have ha : a ≫ p = (r ≫ e) ≫ πE := by
      simp only [a, r, Category.assoc]
      rw [← Limits.pullback.condition]
    obtain ⟨γ, hγ⟩ := hLOC _ inferInstance a (r ≫ e) ha
    let z : Spec ((Limits.pullback (e ≫ πE) p).residueField q) := Classical.arbitrary _
    refine ⟨_, z, r, a, γ, inferInstance, ?_, hγ⟩
    have hz : φ z = q := by
      have : φ z ∈ Set.range ⇑φ := ⟨z, rfl⟩
      rw [Scheme.range_fromSpecResidueField] at this
      exact this
    show (φ ≫ Limits.pullback.fst (e ≫ πE) p) z = t
    rw [Scheme.Hom.comp_apply, hz, hq1]

  have hfac : ∀ (T : Scheme.{u}) (ζ : T ⟶ Limits.pullback πE πE) (δ : H),
      Set.range ⇑ζ ⊆ Set.range ⇑(d δ) → ζ = (ζ ≫ Limits.pullback.snd πE πE) ≫ d δ := by
    intro T ζ δ hsub
    have h1 := IsOpenImmersion.lift_fac (d δ) ζ hsub
    have h2 : IsOpenImmersion.lift (d δ) ζ hsub = ζ ≫ Limits.pullback.snd πE πE := by
      calc IsOpenImmersion.lift (d δ) ζ hsub
          = IsOpenImmersion.lift (d δ) ζ hsub ≫ d δ ≫ Limits.pullback.snd πE πE := by
            rw [hd2, Category.comp_id]
        _ = ζ ≫ Limits.pullback.snd πE πE := by rw [← Category.assoc, h1]
    rw [← h2, h1]

  have hdiag : ∀ (Z : Scheme.{u}) (a : Z ⟶ X) (z : Z), g (Limits.pullback.lift a a rfl z) = 1 := by
    intro Z a z
    have := (hMR Z a a rfl 1 1).mp rfl z
    rw [one_mul] at this
    exact this.symm

  have hdisj : Pairwise (Function.onFun Disjoint fun δ => Set.range ⇑(d δ)) := by
    intro γ δ hne
    rw [Function.onFun, Set.disjoint_left]
    intro y hyγ hyδ
    let ζ := (Limits.pullback πE πE).fromSpecResidueField y
    have hr : Set.range ⇑ζ = {y} := Scheme.range_fromSpecResidueField y
    have eγ := hfac _ ζ γ (by rw [hr, Set.singleton_subset_iff]; exact hyγ)
    have eδ := hfac _ ζ δ (by rw [hr, Set.singleton_subset_iff]; exact hyδ)
    have hψ : (ζ ≫ Limits.pullback.snd πE πE) ≫ ψ γ = (ζ ≫ Limits.pullback.snd πE πE) ≫ ψ δ := by
      rw [← hd1 γ, ← hd1 δ, ← Category.assoc, ← Category.assoc, ← eγ, ← eδ]
    obtain ⟨Z, z, r, a, γ₀, -, -, hra⟩ := hpt _ (ζ ≫ Limits.pullback.snd πE πE) (Classical.arbitrary _)
    have key : a ≫ s (γ * γ₀) = a ≫ s (δ * γ₀) := by
      rw [← hψs γ γ₀, ← hψs δ γ₀, ← Category.assoc, ← Category.assoc, ← hra]
      simp only [Category.assoc] at hψ ⊢
      rw [hψ]
    have h3 := (hMR Z a a rfl (γ * γ₀) (δ * γ₀)).mp key z
    rw [hdiag, mul_one] at h3
    exact hne (mul_right_cancel h3).symm

  have hcov : ∀ y : ↥(Limits.pullback πE πE), ∃ (δ : H) (e : E), d δ e = y := by
    intro y
    let ζ := (Limits.pullback πE πE).fromSpecResidueField y
    obtain ⟨Z, z, r, a, γ₂, hZ, -, h₂⟩ :=
      hpt _ (ζ ≫ Limits.pullback.snd πE πE) (Classical.arbitrary _)
    have ha : a ≫ p = (r ≫ ζ ≫ Limits.pullback.fst πE πE) ≫ πE := by
      rw [← hs γ₂, ← Category.assoc, ← h₂]
      simp only [Category.assoc]
      rw [Limits.pullback.condition]
    obtain ⟨γ₁, h₁⟩ := hLOC Z hZ a _ ha
    have hcl : r ≫ ζ = (r ≫ ζ ≫ Limits.pullback.snd πE πE) ≫ d (γ₁ * γ₂⁻¹) := by
      apply Limits.pullback.hom_ext
      · have h4 := congrArg (· ≫ ψ (γ₁ * γ₂⁻¹)) h₂
        simp only [Category.assoc] at h4 h₁ ⊢
        rw [hd1, h4, hψs, inv_mul_cancel_right, h₁]
      · simp only [Category.assoc, hd2, Category.comp_id]
    have h5 := congrArg (fun f : Z ⟶ Limits.pullback πE πE => f z) hcl
    simp only [Scheme.Hom.comp_apply] at h5
    have hζ : ζ (r z) = y := by
      have : ζ (r z) ∈ Set.range ⇑ζ := ⟨_, rfl⟩
      rwa [Scheme.range_fromSpecResidueField] at this
    refine ⟨γ₁ * γ₂⁻¹, Limits.pullback.snd πE πE (ζ (r z)), ?_⟩
    rw [← h5, hζ]

  haveI : IsOpenImmersion (Limits.Sigma.desc d) :=
    isOpenImmersion_sigmaDesc (fun _ : H => E) d hdisj
  apply isIso_of_isOpenImmersion_of_opensRange_eq_top
  apply TopologicalSpace.Opens.ext
  rw [Scheme.Hom.coe_opensRange, TopologicalSpace.Opens.coe_top, Set.eq_univ_iff_forall]
  intro y
  obtain ⟨δ, e, he⟩ := hcov y
  refine ⟨Limits.Sigma.ι (fun _ : H => E) δ e, ?_⟩
  rw [← Scheme.Hom.comp_apply, Limits.Sigma.ι_comp_desc, he]

theorem wc_ltc_finite_torsor_descent {X : Scheme.{u}} (Uo : X.Opens) (W : X.ProEt)
    (hqc : QuasiCompact W.hom) (hin : ∀ z : W.left, W.hom z ∈ Uo)
    (hsurj : ∀ p : X, p ∈ Uo → ∃ z : W.left, W.hom z = p)
    (H : Type u) [Group H] [Finite H] (c : ↥(Limits.pullback W.hom W.hom) → H)
    (hc : IsLocallyConstant c)
    (hdiag : ∀ (T : X.ProEt) (a : T ⟶ W) (z : T.left), c (wcLtcPair a a z) = 1)
    (hcoc : ∀ (T : X.ProEt) (a b b' : T ⟶ W) (z : T.left),
      c (wcLtcPair a b' z) = c (wcLtcPair b b' z) * c (wcLtcPair a b z)) :
    ∃ (V : Scheme.{u}) (q : V ⟶ Uo.toScheme) (α : H →* Aut V) (fr : W.left ⟶ V),
      fr ≫ q ≫ Uo.ι = W.hom ∧ wcGalCover q H α ∧
      ∀ (T : X.ProEt) (a b : T ⟶ W) (γ : H), (∀ z : T.left, c (wcLtcPair a b z) = γ) →
        b.left ≫ fr = a.left ≫ fr ≫ (α γ).hom :=
by
  classical

  have hD : wcFpqcFamDescHyp.{u} := by
    intro T Y I _ Xs f hf hqcf hcov s hs
    have hsh : Presieve.IsSheaf Scheme.fpqcTopology (yoneda.obj Y) :=
      GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable _
    have hcov' : Sieve.generate (Presieve.ofArrows Xs f) ∈ Scheme.fpqcTopology T := by
      apply Precoverage.generate_mem_toGrothendieck
      refine ⟨?_, ?_⟩
      · have hqcc : QuasiCompactCover (PreZeroHypercover.mk I Xs f) := by
          rw [quasiCompactCover_iff]
          intro V' hV'
          refine IsCompactOpenCovered.of_finite (κ := I) id (fun i => f i ⁻¹ᵁ V') ?_ ?_
          · intro i
            haveI := hqcf i
            exact (f i).isCompact_preimage hV'.isCompact
          · apply Set.Subset.antisymm
            · intro y hy
              obtain ⟨i, x, hx, rfl⟩ := Set.mem_iUnion.mp hy
              exact hx
            · intro y hy
              obtain ⟨i, x, rfl⟩ := hcov y
              exact Set.mem_iUnion.mpr ⟨i, x, hy, rfl⟩
        exact (Scheme.presieve₀_mem_qcPrecoverage_iff (E := PreZeroHypercover.mk I Xs f)).mpr hqcc
      · exact (Scheme.ofArrows_mem_precoverage_iff (P := @Flat)).2 ⟨hcov, hf⟩
    exact (Presieve.isSheafFor_arrows_iff (yoneda.obj Y) f).mp (hsh.isSheafFor _ hcov') s
      (fun i j Z a b hab => hs i j Z a b hab)

  have hL : wcFpqcLcDescHyp.{u} := by
    intro T I _ Xs₀ f₀ hf₀ hqcf₀ hcov₀ A h hloc₀
    have key : ∀ (J : Type u) [Finite J] (Xs : J → Scheme.{u}) (f : ∀ j, Xs j ⟶ T),
        (∀ j, Flat (f j)) → (∀ j, QuasiCompact (f j)) → (∀ x : T, ∃ j, x ∈ Set.range (f j)) →
        (∀ j, IsLocallyConstant (fun x : ↥(Xs j) => h (f j x))) → IsLocallyConstant h := by
      intro J _ Xs f hf hqcf hcov hloc
      haveI : ∀ i, Flat (f i) := hf
      have hFi : ∀ i x, (Limits.Sigma.desc f) (Limits.Sigma.ι Xs i x) = f i x := by
        intro i x
        rw [← Scheme.Hom.comp_apply, Limits.Sigma.ι_comp_desc]
      haveI hFflat : Flat (Limits.Sigma.desc f) := Flat.instDescScheme
      haveI hFsurj : Surjective (Limits.Sigma.desc f) :=
        Surjective.sigmaDesc_of_union_range_eq_univ
          (Set.eq_univ_of_forall (fun x => Set.mem_iUnion.mpr (hcov x)))
      haveI hFqc : QuasiCompact (Limits.Sigma.desc f) := by
        constructor
        intro K hKo hK
        have e : (Limits.Sigma.desc f) ⁻¹' K =
            ⋃ i, (Limits.Sigma.ι Xs i) '' ((f i) ⁻¹' K) := by
          apply Set.Subset.antisymm
          · intro y hy
            obtain ⟨⟨i, x⟩, rfl⟩ := (sigmaMk Xs).surjective y
            rw [sigmaMk_mk] at hy ⊢
            refine Set.mem_iUnion.mpr ⟨i, x, ?_, rfl⟩
            have h1 := hFi i x
            rw [Set.mem_preimage, h1] at hy
            exact hy
          · intro y hy
            obtain ⟨i, x, hx, rfl⟩ := Set.mem_iUnion.mp hy
            rw [Set.mem_preimage, hFi]
            exact hx
        rw [e]
        exact isCompact_iUnion (fun i =>
          (haveI := hqcf i; QuasiCompact.isCompact_preimage (f := f i) K hKo hK).image
            (Limits.Sigma.ι Xs i).continuous)
      have hQ := Flat.isQuotientMap_of_surjective (Limits.Sigma.desc f)
      rw [IsLocallyConstant.iff_isOpen_fiber]
      intro α
      rw [← hQ.isCoinducing.isOpen_preimage, ← (sigmaMk Xs).isOpen_preimage, isOpen_sigma_iff]
      intro i
      have e : Sigma.mk i ⁻¹' ((sigmaMk Xs) ⁻¹' ((Limits.Sigma.desc f) ⁻¹' (h ⁻¹' {α}))) =
          {x | h (f i x) = α} := by
        ext x
        simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_setOf_eq, sigmaMk_mk, hFi]
      rw [e]
      exact (hloc i).isOpen_fiber α
    exact key (ULift.{u} I) (fun j => Xs₀ j.down) (fun j => f₀ j.down) (fun j => hf₀ j.down)
      (fun j => hqcf₀ j.down)
      (fun x => by obtain ⟨i, hi⟩ := hcov₀ x; exact ⟨ULift.up i, hi⟩)
      (fun j => hloc₀ j.down)
  have hR : wcGTorDescHyp.{u} := wc_gtor_ring_descent

  haveI hWet : WeaklyEtale W.hom := W.prop
  have hcocZ : ∀ (Z : Scheme.{u}) (a b d : Z ⟶ W.left) (hab : a ≫ W.hom = b ≫ W.hom)
      (hbd : b ≫ W.hom = d ≫ W.hom) (had : a ≫ W.hom = d ≫ W.hom) (z : Z),
      c (Limits.pullback.lift a d had z) =
        c (Limits.pullback.lift b d hbd z) * c (Limits.pullback.lift a b hab z) := by
    intro Z a b d hab hbd had z
    haveI h2et : WeaklyEtale (Limits.pullback.fst W.hom W.hom ≫ W.hom) := inferInstance
    haveI hT3et : WeaklyEtale
        (Limits.pullback.fst W.hom (Limits.pullback.fst W.hom W.hom ≫ W.hom) ≫ W.hom) :=
      inferInstance
    have e12 : Limits.pullback.fst W.hom (Limits.pullback.fst W.hom W.hom ≫ W.hom) ≫ W.hom =
        (Limits.pullback.snd W.hom (Limits.pullback.fst W.hom W.hom ≫ W.hom) ≫
          Limits.pullback.fst W.hom W.hom) ≫ W.hom := by
      rw [Category.assoc]
      exact Limits.pullback.condition
    have e23 : (Limits.pullback.snd W.hom (Limits.pullback.fst W.hom W.hom ≫ W.hom) ≫
          Limits.pullback.fst W.hom W.hom) ≫ W.hom =
        (Limits.pullback.snd W.hom (Limits.pullback.fst W.hom W.hom ≫ W.hom) ≫
          Limits.pullback.snd W.hom W.hom) ≫ W.hom := by
      rw [Category.assoc, Category.assoc, Limits.pullback.condition]
    let T3o : X.ProEt := MorphismProperty.Over.mk ⊤
      (Limits.pullback.fst W.hom (Limits.pullback.fst W.hom W.hom ≫ W.hom) ≫ W.hom) hT3et
    let A1 : T3o ⟶ W := MorphismProperty.Over.homMk
      (Limits.pullback.fst W.hom (Limits.pullback.fst W.hom W.hom ≫ W.hom)) rfl trivial
    let A2 : T3o ⟶ W := MorphismProperty.Over.homMk
      (Limits.pullback.snd W.hom (Limits.pullback.fst W.hom W.hom ≫ W.hom) ≫
        Limits.pullback.fst W.hom W.hom) e12.symm trivial
    let A3 : T3o ⟶ W := MorphismProperty.Over.homMk
      (Limits.pullback.snd W.hom (Limits.pullback.fst W.hom W.hom ≫ W.hom) ≫
        Limits.pullback.snd W.hom W.hom) (e12.trans e23).symm trivial
    have hζ : a ≫ W.hom = Limits.pullback.lift b d hbd ≫
        (Limits.pullback.fst W.hom W.hom ≫ W.hom) := by
      rw [Limits.pullback.lift_fst_assoc, hab]
    let ζ : Z ⟶ Limits.pullback W.hom (Limits.pullback.fst W.hom W.hom ≫ W.hom) :=
      Limits.pullback.lift a (Limits.pullback.lift b d hbd) hζ
    have hz1 : ζ ≫ Limits.pullback.fst W.hom (Limits.pullback.fst W.hom W.hom ≫ W.hom) = a :=
      Limits.pullback.lift_fst _ _ _
    have hz2 : ζ ≫ Limits.pullback.snd W.hom (Limits.pullback.fst W.hom W.hom ≫ W.hom) =
        Limits.pullback.lift b d hbd :=
      Limits.pullback.lift_snd _ _ _
    have hzA1 : ζ ≫ A1.left = a := hz1
    have hzA2 : ζ ≫ A2.left = b := by
      show ζ ≫ Limits.pullback.snd W.hom (Limits.pullback.fst W.hom W.hom ≫ W.hom) ≫
          Limits.pullback.fst W.hom W.hom = b
      rw [← Category.assoc, hz2, Limits.pullback.lift_fst]
    have hzA3 : ζ ≫ A3.left = d := by
      show ζ ≫ Limits.pullback.snd W.hom (Limits.pullback.fst W.hom W.hom ≫ W.hom) ≫
          Limits.pullback.snd W.hom W.hom = d
      rw [← Category.assoc, hz2, Limits.pullback.lift_snd]
    have kpair : ∀ (T : X.ProEt) (k : Z ⟶ T.left) (B B' : T ⟶ W) (x y : Z ⟶ W.left)
        (hxy : x ≫ W.hom = y ≫ W.hom),
        k ≫ B.left = x → k ≫ B'.left = y →
        Limits.pullback.lift x y hxy = k ≫ wcLtcPair B B' := by
      intro T k B B' x y hxy hx hy
      apply Limits.pullback.hom_ext
      · refine (Limits.pullback.lift_fst _ _ _).trans ?_
        refine Eq.trans ?_ (Category.assoc _ _ _).symm
        show x = k ≫ Limits.pullback.lift B.left B'.left _ ≫ Limits.pullback.fst _ _
        rw [Limits.pullback.lift_fst, hx]
      · refine (Limits.pullback.lift_snd _ _ _).trans ?_
        refine Eq.trans ?_ (Category.assoc _ _ _).symm
        show y = k ≫ Limits.pullback.lift B.left B'.left _ ≫ Limits.pullback.snd _ _
        rw [Limits.pullback.lift_snd, hy]
    let ζ' : Z ⟶ T3o.left := ζ
    rw [kpair T3o ζ' A1 A3 a d had hzA1 hzA3, kpair T3o ζ' A2 A3 b d hbd hzA2 hzA3,
      kpair T3o ζ' A1 A2 a b hab hzA1 hzA2, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply,
      Scheme.Hom.comp_apply]
    exact hcoc T3o A1 A2 A3 (ζ' z)

  have hrange : Set.range W.hom.base ⊆ Set.range Uo.ι.base := by
    rintro _ ⟨z, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact hin z
  let p : W.left ⟶ Uo.toScheme := IsOpenImmersion.lift Uo.ι W.hom hrange
  have hp : p ≫ Uo.ι = W.hom := IsOpenImmersion.lift_fac _ _ _
  haveI hpost : MorphismProperty.HasOfPostcompProperty @Flat @IsOpenImmersion :=
    (MorphismProperty.hasOfPostcompProperty_iff_le_diagonal (P := @Flat)
      (Q := @IsOpenImmersion)).2
      (fun X Y f hf => MorphismProperty.diagonal_iff.2
        (by have : IsOpenImmersion f := hf; infer_instance))
  have hflatW : Flat W.hom := inferInstance
  have hpflat : Flat p := MorphismProperty.of_postcomp (W := @Flat) (W' := @IsOpenImmersion)
    p Uo.ι inferInstance (by rw [hp]; exact hflatW)
  have hpqc : QuasiCompact p := by
    haveI : QuasiCompact (p ≫ Uo.ι) := by rw [hp]; exact hqc
    exact QuasiCompact.of_comp p Uo.ι
  have hpsurj : Surjective p := by
    constructor
    intro y
    have hy : Uo.ι y ∈ Uo := by
      have h2 : Uo.ι y ∈ Set.range Uo.ι := ⟨_, rfl⟩
      rw [Scheme.Opens.range_ι] at h2
      exact h2
    obtain ⟨z, hz⟩ := hsurj (Uo.ι y) hy
    refine ⟨z, Uo.ι.isOpenEmbedding.injective ?_⟩
    show (p ≫ Uo.ι) z = Uo.ι y
    rw [hp]
    exact hz
  have toW : ∀ {Z : Scheme.{u}} {a b : Z ⟶ W.left}, a ≫ p = b ≫ p →
      a ≫ W.hom = b ≫ W.hom := fun h => by
    rw [← hp, ← Category.assoc, h, Category.assoc]

  let μ : Limits.pullback p p ⟶ Limits.pullback W.hom W.hom :=
    Limits.pullback.map p p W.hom W.hom (𝟙 _) (𝟙 _) Uo.ι (by rw [hp, Category.id_comp])
      (by rw [hp, Category.id_comp])
  have hμ : ∀ (Z : Scheme.{u}) (a b : Z ⟶ W.left) (h : a ≫ p = b ≫ p) (z : Z),
      μ (Limits.pullback.lift a b h z) = Limits.pullback.lift a b (toW h) z := by
    intro Z a b h z
    have e : Limits.pullback.lift a b h ≫ μ = Limits.pullback.lift a b (toW h) := by
      apply Limits.pullback.hom_ext
      · simp only [μ, Limits.pullback.map, Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.lift_fst_assoc, Category.comp_id]
      · simp only [μ, Limits.pullback.map, Category.assoc, Limits.pullback.lift_snd,
          Limits.pullback.lift_snd_assoc, Category.comp_id]
    rw [← e, Scheme.Hom.comp_apply]
  let eH : Shrink.{0} H ≃* H := Shrink.mulEquiv
  let g₀ : ↥(Limits.pullback p p) → Shrink.{0} H := fun y => eH.symm ((c (μ y))⁻¹)
  have hg₀lc : IsLocallyConstant g₀ :=
    (hc.comp_continuous μ.continuous).comp (fun h => eH.symm h⁻¹)
  have hg₀ : ∀ (Z : Scheme.{u}) (a b : Z ⟶ W.left) (h : a ≫ p = b ≫ p) (z : Z),
      g₀ (Limits.pullback.lift a b h z) = eH.symm (c (Limits.pullback.lift a b (toW h) z))⁻¹ := by
    intro Z a b h z
    show eH.symm (c (μ (Limits.pullback.lift a b h z)))⁻¹ = _
    rw [hμ]
  have hG : wcGCocycle (V := fun _ : Unit => W.left) (fun _ => p) (fun _ _ => g₀) := by
    intro i j k Z a b d hab hbd had z
    have e1 := hg₀ Z a d had z
    have e2 := hg₀ Z a b hab z
    have e3 := hg₀ Z b d hbd z
    have e4 := hcocZ Z a b d (toW hab) (toW hbd) (toW had) z
    show g₀ (Limits.pullback.lift a d had z) =
      g₀ (Limits.pullback.lift a b hab z) * g₀ (Limits.pullback.lift b d hbd z)
    rw [e1, e2, e3, e4, mul_inv_rev, map_mul]

  have hlocal := wc_ftd_local_rep hD hL hR Uo.toScheme W.left p hpflat hpqc hpsurj
    (Shrink.{0} H) g₀ hg₀lc hG
  obtain ⟨E, πE, Λ, hfin, het, hrep⟩ :=
    wc_gtor_rep_zariski_glue Uo.toScheme (Shrink.{0} H) Unit (fun _ => W.left) (fun _ => p)
      (fun _ _ => g₀) hlocal
  obtain ⟨hsurjE, s₀, hs₀, hMR₀, hLOC₀⟩ :=
    wc_fgtor_sheets_iff_of_rep Uo.toScheme (Shrink.{0} H) Unit (fun _ => W.left) (fun _ => p)
      (fun y => ⟨(), hpsurj.surj y⟩) (fun _ _ => g₀) (fun _ _ => hg₀lc) hG E πE Λ hrep

  let s : H → (W.left ⟶ E) := fun γ => s₀ () (eH.symm γ)
  let g : ↥(Limits.pullback p p) → H := fun y => (c (μ y))⁻¹
  have hs : ∀ γ, s γ ≫ πE = p := fun γ => hs₀ () _
  have hMR : ∀ (Z : Scheme.{u}) (a b : Z ⟶ W.left) (hab : a ≫ p = b ≫ p) (γ γ' : H),
      a ≫ s γ = b ≫ s γ' ↔ ∀ z : Z, γ' = γ * g (Limits.pullback.lift a b hab z) := by
    intro Z a b hab γ γ'
    rw [hMR₀ () () (eH.symm γ) (eH.symm γ') Z a b hab]
    apply forall_congr'
    intro z
    show eH.symm γ' = eH.symm γ * eH.symm (c (μ (Limits.pullback.lift a b hab z)))⁻¹ ↔ _
    rw [← map_mul, eH.symm.injective.eq_iff]
  have hLOC : ∀ (Z : Scheme.{u}), ConnectedSpace Z → ∀ (a : Z ⟶ W.left) (e : Z ⟶ E),
      a ≫ p = e ≫ πE → ∃ γ, e = a ≫ s γ := by
    intro Z hZ a e h
    obtain ⟨γ₀, hγ₀⟩ := hLOC₀ () Z hZ a e h
    refine ⟨eH γ₀, ?_⟩
    rw [hγ₀]
    show a ≫ s₀ () γ₀ = a ≫ s₀ () (eH.symm (eH γ₀))
    rw [MulEquiv.symm_apply_apply]

  obtain ⟨ψ, hψs, hψπ, hψ1, hψmul⟩ :=
    wc_ftd_deck_action hD Uo.toScheme W.left E p πE hpflat hpqc hpsurj hfin het H g s hs hMR hLOC
  have hinv : ∀ δ : H, ψ δ ≫ ψ δ⁻¹ = 𝟙 E := fun δ => by
    rw [← hψmul, inv_mul_cancel, hψ1]
  have hinv' : ∀ δ : H, ψ δ⁻¹ ≫ ψ δ = 𝟙 E := fun δ => by
    rw [← hψmul, mul_inv_cancel, hψ1]
  let α : H →* Aut E :=
    { toFun := fun δ =>
        { hom := ψ δ, inv := ψ δ⁻¹, hom_inv_id := hinv δ, inv_hom_id := hinv' δ }
      map_one' := by
        apply Iso.ext
        exact hψ1
      map_mul' := fun δ ε => by
        apply Iso.ext
        show ψ (δ * ε) = ψ ε ≫ ψ δ
        exact hψmul δ ε }

  refine ⟨E, πE, α, s 1, ?_, ?_, ?_⟩
  · rw [← Category.assoc, hs, hp]
  · exact ⟨inferInstance, hfin, het, hsurjE, fun γ => hψπ γ,
      wc_ftd_torsor_iso Uo.toScheme W.left E p πE hpsurj het H g s hs hMR hLOC ψ hψs hψπ⟩
  · intro T a b γ hγ
    have hab : b.left ≫ p = a.left ≫ p := by
      apply (cancel_mono Uo.ι).mp
      rw [Category.assoc, Category.assoc, hp, MorphismProperty.Over.w b,
        MorphismProperty.Over.w a]
    have h1 : a.left ≫ s 1 ≫ (α γ).hom = a.left ≫ s γ := by
      show a.left ≫ s 1 ≫ ψ γ = _
      rw [hψs, mul_one]
    rw [h1]
    refine (hMR T.left b.left a.left hab 1 γ).mpr ?_
    intro z
    show γ = 1 * (c (μ (Limits.pullback.lift b.left a.left hab z)))⁻¹
    rw [hμ, one_mul]
    show γ = (c (wcLtcPair b a z))⁻¹
    have e1 := hcoc T a b a z
    rw [hdiag T a z, hγ z] at e1
    exact eq_inv_of_mul_eq_one_right e1.symm

theorem wc_ltc_val_api (X : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (G : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (σ : ℚ_[ℓ] → (G ⟶ G))
    (W : X.ProEt) (θ : G.over W ≅ (wcContSheaf X (Fin r → ℚ_[ℓ])).over W)
    (hθ : ∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology X).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫
        θ.hom = θ.hom ≫ ((Scheme.ProEt.topology X).overPullback AddCommGrpCat.{u+1} W).map
          (wcConstScalar X ℓ r c)) :
    (∀ (T T' : X.ProEt) (c : T' ⟶ T) (b : T ⟶ W) (x : G.obj.obj (Opposite.op T)) (z : T'.left),
        wcLtcVal θ (c ≫ b) ((G.obj.map c.op).hom x) z = wcLtcVal θ b x (c.left z)) ∧
    (∀ (T : X.ProEt) (b : T ⟶ W) (a : ℚ_[ℓ]) (x : G.obj.obj (Opposite.op T)) (z : T.left),
        wcLtcVal θ b (((σ a).hom.app (Opposite.op T)).hom x) z = a • wcLtcVal θ b x z) ∧
    (∀ (T : X.ProEt) (b : T ⟶ W) (x x' : G.obj.obj (Opposite.op T)),
        (∀ z, wcLtcVal θ b x z = wcLtcVal θ b x' z) → x = x') ∧
    (∀ (T : X.ProEt) (b : T ⟶ W) (f : C(T.left, Fin r → ℚ_[ℓ])),
        ∃ x : G.obj.obj (Opposite.op T), ∀ z, wcLtcVal θ b x z = f z) :=
by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro T T' c b x z
    have h := congrArg (fun φ => AddCommGrpCat.Hom.hom φ x)
      (θ.hom.hom.naturality (Over.homMk c rfl : Over.mk (c ≫ b) ⟶ Over.mk b).op)
    exact congrArg (fun w => (show C(↥T'.left, Fin r → ℚ_[ℓ]) from w.down) z) h
  · intro T b a x z
    have h := congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk b))).hom x) (hθ a)
    exact congrArg (fun w => (show C(↥T.left, Fin r → ℚ_[ℓ]) from w.down) z) h
  · intro T b x x' H
    have hinv : ∀ y : G.obj.obj (Opposite.op T),
        (θ.inv.hom.app (Opposite.op (Over.mk b))).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom y) = y :=
      fun y => congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk b))).hom y) θ.hom_inv_id
    have heq : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom x =
        (θ.hom.hom.app (Opposite.op (Over.mk b))).hom x' :=
      ULift.ext _ _ (ContinuousMap.ext H)
    rw [← hinv x, heq, hinv x']
  · intro T b f
    let u : ((wcContSheaf X (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op (Over.mk b)) :=
      ULift.up f
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk b))).hom u, fun z => ?_⟩
    have h := congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk b))).hom u) θ.inv_hom_id
    exact congrArg (fun w => (show C(↥T.left, Fin r → ℚ_[ℓ]) from w.down) z) h

theorem wc_ltc_W_cover (X : Scheme.{u}) (Z : Set X) (W : X.ProEt) (hWqc : QuasiCompact W.hom)
    (hWs : ∀ p : X, p ∉ Z → ∃ z : W.left, W.hom z = p)
    (T : X.ProEt) (hT : ∀ t, T.hom t ∉ Z) :
    ∃ (P : X.ProEt) (p : P ⟶ T) (b : P ⟶ W),
      Sieve.generate (Presieve.singleton p) ∈ Scheme.ProEt.topology X T ∧
      QuasiCompact p.left ∧ Function.Surjective p.left ∧
      ∀ (T' : X.ProEt) (c : T' ⟶ T) (b' : T' ⟶ W), ∃ d : T' ⟶ P, d ≫ p = c ∧ d ≫ b = b' :=
by
  classical
  haveI : WeaklyEtale W.hom := W.prop
  haveI : WeaklyEtale T.hom := T.prop
  haveI : QuasiCompact W.hom := hWqc
  have hfe : WeaklyEtale (Limits.pullback.fst T.hom W.hom) := inferInstance
  have hfq : QuasiCompact (Limits.pullback.fst T.hom W.hom) := inferInstance
  have hPe : WeaklyEtale (Limits.pullback.fst T.hom W.hom ≫ T.hom) :=
    @MorphismProperty.comp_mem _ _ @WeaklyEtale
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      _ _ _ _ _ hfe T.prop
  let P : X.ProEt := @Scheme.ProEt.mk X _ (Limits.pullback.fst T.hom W.hom ≫ T.hom) hPe
  have h₂ : Limits.pullback.snd T.hom W.hom ≫ W.hom =
      Limits.pullback.fst T.hom W.hom ≫ T.hom := Limits.pullback.condition.symm
  let p : P ⟶ T := MorphismProperty.Over.homMk (Limits.pullback.fst T.hom W.hom) rfl trivial
  let b : P ⟶ W := MorphismProperty.Over.homMk (Limits.pullback.snd T.hom W.hom) h₂ trivial
  have hsurj : Function.Surjective (Limits.pullback.fst T.hom W.hom) := by
    intro t
    obtain ⟨w, hw⟩ := hWs (T.hom t) (hT t)
    obtain ⟨z, hz, -⟩ :=
      Scheme.Pullback.exists_preimage_pullback (f := T.hom) (g := W.hom) t w hw.symm
    exact ⟨z, hz⟩
  have hcov : Sieve.generate (Presieve.singleton p) ∈ Scheme.ProEt.topology X T := by
    haveI : Surjective (Limits.pullback.fst T.hom W.hom) := ⟨hsurj⟩
    have hb : Presieve.singleton (Limits.pullback.fst T.hom W.hom) ∈
        Scheme.proetalePrecoverage.coverings T.left :=
      Scheme.Hom.singleton_mem_propQCPrecoverage (P := @WeaklyEtale) hfe
    apply Precoverage.generate_mem_toGrothendieck
    apply Precoverage.mem_comap_iff.mpr
    rw [Presieve.map_singleton]
    exact hb
  refine ⟨P, p, b, hcov, hfq, hsurj, ?_⟩
  intro T' c b'
  have hcomp : c.left ≫ T.hom = b'.left ≫ W.hom :=
    (MorphismProperty.Over.w c).trans (MorphismProperty.Over.w b').symm
  have hd : Limits.pullback.lift c.left b'.left hcomp ≫
      (Limits.pullback.fst T.hom W.hom ≫ T.hom) = T'.hom := by
    rw [Limits.pullback.lift_fst_assoc]
    exact MorphismProperty.Over.w c
  let d : T' ⟶ P :=
    MorphismProperty.Over.homMk (Limits.pullback.lift c.left b'.left hcomp) hd trivial
  refine ⟨d, ?_, ?_⟩
  · apply MorphismProperty.Over.Hom.ext
    show Limits.pullback.lift c.left b'.left hcomp ≫ Limits.pullback.fst T.hom W.hom = c.left
    exact Limits.pullback.lift_fst _ _ _
  · apply MorphismProperty.Over.Hom.ext
    show Limits.pullback.lift c.left b'.left hcomp ≫ Limits.pullback.snd T.hom W.hom = b'.left
    exact Limits.pullback.lift_snd _ _ _

theorem wc_ltc_sheafify_sub (Y : Scheme.{u})
    (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
    (A : (Y.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (i : A ⟶ G.obj)
    (hi : ∀ (T : Y.ProEt) (x : A.obj (Opposite.op T)), (i.app (Opposite.op T)).hom x = 0 → x = 0) :
    Mono (ObjectProperty.homMk (sheafifyLift (Scheme.ProEt.topology Y) i G.2) :
      (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj A ⟶ G) ∧
    ∀ (T : Y.ProEt) (s : G.obj.obj (Opposite.op T)),
      (∃ t, ((sheafifyLift (Scheme.ProEt.topology Y) i G.2).app (Opposite.op T)).hom t = s) ↔
      ∃ R : Sieve T, R ∈ Scheme.ProEt.topology Y T ∧
        ∀ (T' : Y.ProEt) (g : T' ⟶ T), R.arrows g →
          ∃ a, (i.app (Opposite.op T')).hom a = (G.obj.map g.op).hom s :=
by
  classical

  have hE : ∀ (T : Y.ProEt) (a : A.obj (Opposite.op T)),
      ((sheafifyLift (Scheme.ProEt.topology Y) i G.2).app (Opposite.op T)).hom
        (((toSheafify (Scheme.ProEt.topology Y) A).app (Opposite.op T)).hom a) =
      (i.app (Opposite.op T)).hom a := by
    intro T a
    exact congrArg (fun φ => (φ.app (Opposite.op T)).hom a)
      (toSheafify_sheafifyLift (Scheme.ProEt.topology Y) i G.2)

  have hN : ∀ (T T' : Y.ProEt) (g : T' ⟶ T)
      (t : (sheafify (Scheme.ProEt.topology Y) A).obj (Opposite.op T)),
      ((sheafifyLift (Scheme.ProEt.topology Y) i G.2).app (Opposite.op T')).hom
        (((sheafify (Scheme.ProEt.topology Y) A).map g.op).hom t) =
      (G.obj.map g.op).hom
        (((sheafifyLift (Scheme.ProEt.topology Y) i G.2).app (Opposite.op T)).hom t) := by
    intro T T' g t
    exact congrArg (fun φ => φ.hom t)
      ((sheafifyLift (Scheme.ProEt.topology Y) i G.2).naturality g.op)

  have hloc : ∀ (T : Y.ProEt) (t : (sheafify (Scheme.ProEt.topology Y) A).obj (Opposite.op T))
      (T' : Y.ProEt) (g : T' ⟶ T)
      (hg : (Presheaf.imageSieve (toSheafify (Scheme.ProEt.topology Y) A) t).arrows g),
      ((toSheafify (Scheme.ProEt.topology Y) A).app (Opposite.op T')).hom
        (Presheaf.localPreimage (toSheafify (Scheme.ProEt.topology Y) A) t g hg) =
      ((sheafify (Scheme.ProEt.topology Y) A).map g.op).hom t :=
    fun T t T' g hg => Presheaf.app_localPreimage (toSheafify (Scheme.ProEt.topology Y) A) t g hg
  have hcov : ∀ (T : Y.ProEt) (t : (sheafify (Scheme.ProEt.topology Y) A).obj (Opposite.op T)),
      Presheaf.imageSieve (toSheafify (Scheme.ProEt.topology Y) A) t ∈
        Scheme.ProEt.topology Y T :=
    fun T t => Presheaf.IsLocallySurjective.imageSieve_mem t

  have hsepP : ∀ (P : (Y.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      Presheaf.IsSheaf (Scheme.ProEt.topology Y) P →
      ∀ (T : Y.ProEt) (R : Sieve T), R ∈ Scheme.ProEt.topology Y T →
      ∀ x y : P.obj (Opposite.op T),
      (∀ (T' : Y.ProEt) (g : T' ⟶ T), R.arrows g → (P.map g.op).hom x = (P.map g.op).hom y) →
      x = y := by
    intro P hP T R hR x y h
    have hs := (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology Y) P
      (forget AddCommGrpCat)).mp hP
    rw [isSheaf_iff_isSheaf_of_type] at hs
    exact (hs.isSeparated R hR).ext (fun T' g hg => h T' g hg)
  have haA : Presheaf.IsSheaf (Scheme.ProEt.topology Y) (sheafify (Scheme.ProEt.topology Y) A) :=
    ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj A).cond

  have hinj : ∀ T : Y.ProEt,
      Function.Injective ((sheafifyLift (Scheme.ProEt.topology Y) i G.2).app (Opposite.op T)).hom := by
    intro T
    rw [injective_iff_map_eq_zero]
    intro t ht
    refine hsepP _ haA T _ (hcov T t) t 0 (fun T' g hg => ?_)
    have h2 : (i.app (Opposite.op T')).hom
        (Presheaf.localPreimage (toSheafify (Scheme.ProEt.topology Y) A) t g hg) = 0 := by
      rw [← hE, hloc T t T' g hg, hN, ht, map_zero]
    rw [map_zero, ← hloc T t T' g hg, hi T' _ h2, map_zero]
  have hmono : Mono (ObjectProperty.homMk (sheafifyLift (Scheme.ProEt.topology Y) i G.2) :
      (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj A ⟶ G) :=
    Sheaf.mono_of_injective _ (fun X => hinj X.unop)
  refine ⟨hmono, fun T s => ⟨?_, ?_⟩⟩
  · rintro ⟨t, rfl⟩
    refine ⟨_, hcov T t, fun T' g hg =>
      ⟨Presheaf.localPreimage (toSheafify (Scheme.ProEt.topology Y) A) t g hg, ?_⟩⟩
    rw [← hE, hloc T t T' g hg, hN]
  · rintro ⟨R, hR, h⟩
    choose a ha using h
    let x : Presieve.FamilyOfElements
        (sheafify (Scheme.ProEt.topology Y) A ⋙ forget AddCommGrpCat) R.arrows :=
      fun T' g hg => ((toSheafify (Scheme.ProEt.topology Y) A).app (Opposite.op T')).hom
        (a T' g hg)
    have hs := (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology Y)
      (sheafify (Scheme.ProEt.topology Y) A) (forget AddCommGrpCat)).mp haA
    rw [isSheaf_iff_isSheaf_of_type] at hs
    have hx : x.Compatible := by
      rw [Presieve.compatible_iff_sieveCompatible]
      intro T' T'' g h hg
      apply hinj T''
      change ((sheafifyLift (Scheme.ProEt.topology Y) i G.2).app (Opposite.op T'')).hom
          (((toSheafify (Scheme.ProEt.topology Y) A).app (Opposite.op T'')).hom
            (a T'' (h ≫ g) (R.downward_closed hg h))) =
        ((sheafifyLift (Scheme.ProEt.topology Y) i G.2).app (Opposite.op T'')).hom
          (((sheafify (Scheme.ProEt.topology Y) A).map h.op).hom
            (((toSheafify (Scheme.ProEt.topology Y) A).app (Opposite.op T')).hom (a T' g hg)))
      rw [hE, hN, hE, ha, ha, op_comp, Functor.map_comp]
      rfl
    refine ⟨(hs R hR).amalgamate x hx, hsepP G.obj G.2 T R hR _ _ (fun T' g hg => ?_)⟩
    have hglue : ((sheafify (Scheme.ProEt.topology Y) A).map g.op).hom
        ((hs R hR).amalgamate x hx) = x g hg := (hs R hR).valid_glue hx g hg
    rw [← hN, hglue]
    exact (hE T' (a T' g hg)).trans (ha T' g hg)

theorem wc_ltc_ses_of_presheaf (Y : Scheme.{u}) (A : (Y.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
    (Q : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (e : A ⟶ A) (p : A ⟶ Q.obj)
    (he : ∀ (T : Y.ProEt) (x : A.obj (Opposite.op T)), (e.app (Opposite.op T)).hom x = 0 → x = 0)
    (hz : ∀ (T : Y.ProEt) (x : A.obj (Opposite.op T)),
      (p.app (Opposite.op T)).hom ((e.app (Opposite.op T)).hom x) = 0)
    (hk : ∀ (T : Y.ProEt) (x : A.obj (Opposite.op T)), (p.app (Opposite.op T)).hom x = 0 →
      ∃ y, (e.app (Opposite.op T)).hom y = x)
    (hs : ∀ (T : Y.ProEt) (y : Q.obj.obj (Opposite.op T)), ∃ R : Sieve T,
      R ∈ Scheme.ProEt.topology Y T ∧ ∀ (T' : Y.ProEt) (g : T' ⟶ T), R.arrows g →
        ∃ x, (p.app (Opposite.op T')).hom x = (Q.obj.map g.op).hom y) :
    ∃ w : (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map e ≫
        (ObjectProperty.homMk (sheafifyLift (Scheme.ProEt.topology Y) p Q.2) :
          (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj A ⟶ Q) = 0,
      (ShortComplex.mk _ _ w).ShortExact :=
by

  have h1 : e ≫ p = 0 := by
    ext ⟨T⟩ x
    exact hz T x

  have hex0 : (ShortComplex.mk e p h1).Exact := by
    rw [ShortComplex.exact_iff_isZero_homology]
    apply Functor.isZero
    rintro ⟨T⟩
    have hev : ((ShortComplex.mk e p h1).map
        ((evaluation (Y.ProEt)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op T))).Exact := by
      rw [ShortComplex.ab_exact_iff]
      intro x hx
      exact hk T x hx
    exact CategoryTheory.Limits.IsZero.of_iso ((ShortComplex.exact_iff_isZero_homology _).1 hev)
      ((ShortComplex.mk e p h1).mapHomologyIso
        ((evaluation (Y.ProEt)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op T))).symm

  have hexa := hex0.map (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
  let ι : (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj Q.obj ⟶ Q :=
    ObjectProperty.homMk (sheafifyLift (Scheme.ProEt.topology Y) (𝟙 Q.obj) Q.2)
  haveI hιiso : IsIso ι := by
    haveI : IsIso ((sheafToPresheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map ι) := by
      change IsIso (sheafifyLift (Scheme.ProEt.topology Y) (𝟙 Q.obj) Q.2)
      haveI := isIso_toSheafify (Scheme.ProEt.topology Y) Q.2
      haveI : IsIso (toSheafify (Scheme.ProEt.topology Y) Q.obj ≫
          sheafifyLift (Scheme.ProEt.topology Y) (𝟙 Q.obj) Q.2) := by
        rw [toSheafify_sheafifyLift]; infer_instance
      exact IsIso.of_isIso_comp_left (toSheafify (Scheme.ProEt.topology Y) Q.obj) _
    exact isIso_of_reflects_iso ι (sheafToPresheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
  have hcomp : (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map p ≫ ι =
      (ObjectProperty.homMk (sheafifyLift (Scheme.ProEt.topology Y) p Q.2) :
          (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj A ⟶ Q) := by
    apply Sheaf.hom_ext
    change sheafifyMap (Scheme.ProEt.topology Y) p ≫
      sheafifyLift (Scheme.ProEt.topology Y) (𝟙 Q.obj) Q.2 =
        sheafifyLift (Scheme.ProEt.topology Y) p Q.2
    rw [sheafifyMap_sheafifyLift, Category.comp_id]
  have w : (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map e ≫
      (ObjectProperty.homMk (sheafifyLift (Scheme.ProEt.topology Y) p Q.2) :
          (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj A ⟶ Q) = 0 := by
    rw [← hcomp, ← Category.assoc, ← Functor.map_comp, h1, Functor.map_zero, Limits.zero_comp]
  refine ⟨w, ?_⟩
  have hexact : (ShortComplex.mk _ _ w).Exact := by
    let isoS : (ShortComplex.mk e p h1).map
        (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) ≅ ShortComplex.mk _ _ w :=
      ShortComplex.isoMk (Iso.refl _) (Iso.refl _) (asIso ι) (by simp)
        (by
          change 𝟙 _ ≫ _ = (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map p ≫ ι
          rw [Category.id_comp, hcomp])
    exact ShortComplex.exact_of_iso isoS hexa

  haveI : Mono e := by
    refine (NatTrans.mono_iff_mono_app e).2 ?_
    rintro ⟨T⟩
    rw [AddCommGrpCat.mono_iff_injective]
    intro x y hxy
    have h0 := he T (x - y) (by rw [map_sub]; exact sub_eq_zero.2 hxy)
    exact sub_eq_zero.1 h0
  haveI : Mono (ShortComplex.mk _ _ w).f := by
    change Mono ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map e)
    infer_instance

  have hls : Presheaf.IsLocallySurjective (Scheme.ProEt.topology Y) p := by
    constructor
    intro U s
    obtain ⟨R, hR, hR'⟩ := hs U s
    apply (Scheme.ProEt.topology Y).superset_covering _ hR
    intro T' g hg
    obtain ⟨x, hx⟩ := hR' T' g hg
    exact ⟨x, hx⟩
  haveI : Presheaf.IsLocallySurjective (Scheme.ProEt.topology Y)
      (toSheafify (Scheme.ProEt.topology Y) A ≫ sheafifyLift (Scheme.ProEt.topology Y) p Q.2) := by
    rw [toSheafify_sheafifyLift]; exact hls
  haveI hls2 : Presheaf.IsLocallySurjective (Scheme.ProEt.topology Y)
      (sheafifyLift (Scheme.ProEt.topology Y) p Q.2) :=
    Presheaf.isLocallySurjective_of_isLocallySurjective (Scheme.ProEt.topology Y)
      (toSheafify (Scheme.ProEt.topology Y) A) _
  haveI : Sheaf.IsLocallySurjective
      (ObjectProperty.homMk (sheafifyLift (Scheme.ProEt.topology Y) p Q.2) :
          (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj A ⟶ Q) := hls2
  haveI : Epi (ShortComplex.mk _ _ w).g :=
    Sheaf.epi_of_isLocallySurjective
      (ObjectProperty.homMk (sheafifyLift (Scheme.ProEt.topology Y) p Q.2) :
          (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj A ⟶ Q)
  exact ShortComplex.ShortExact.mk' hexact inferInstance inferInstance

theorem wc_ltc_tw_frame_exists {X U' V : Scheme.{u}} (j : U' ⟶ X) [IsOpenImmersion j]
    (q : V ⟶ U') (Z : Set X) (Γ : Type u) [Group Γ] (α : Γ →* Aut V)
    (hα : ∀ g, (α g).hom ≫ q ≫ j = q ≫ j) (hcov : wcGalCover q Γ α) (ℓ n r : ℕ)
    (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (T : X.ProEt) (hT : ∀ t, T.hom t ∉ Z)
    (e : T.left ⟶ V) (he : e ≫ q ≫ j = T.hom) (f : C(↥T.left, Fin r → ZMod (ℓ ^ n))) :
    ∃ u : (wcLtcTwPre (q ≫ j) Z Γ α hα ℓ n r ρ).obj (Opposite.op T),
      ∀ t, wcLtcFrameVal u e t = f t :=
by
  classical


  open CategoryTheory.Limits in
  have s1 : ∀ {X W V T₀ : Scheme.{u}} (q' : V ⟶ W) (ι : W ⟶ X) [Mono ι] (Γ : Type u) [Finite Γ]
      (β : Γ → (V ⟶ V)) (hβ : ∀ γ, β γ ≫ q' = q')
      (_ : IsIso (Sigma.desc (fun γ : Γ => pullback.lift (β γ) (𝟙 V)
        ((hβ γ).trans (Category.id_comp q').symm)) : ∐ (fun _ : Γ => V) ⟶ pullback q' q'))
      (h : T₀ ⟶ X) (t : T₀ ⟶ V) (_ : h = t ≫ q' ≫ ι)
      (s : Γ → (T₀ ⟶ pullback h (q' ≫ ι)))
      (_ : ∀ γ, s γ ≫ pullback.fst h (q' ≫ ι) = 𝟙 T₀)
      (_ : ∀ γ, s γ ≫ pullback.snd h (q' ≫ ι) = t ≫ β γ),
      IsIso (Sigma.desc s) := by
    intro X W V T₀ q' ι _ Γ _ β hβ hiso h t ht s hs1 hs2
    let a : Cofan (fun _ : Γ => V) := Cofan.mk (pullback q' q') (fun γ => pullback.lift (β γ) (𝟙 V)
        ((hβ γ).trans (Category.id_comp q').symm))
    have hc : IsColimit a := ((Cofan.nonempty_isColimit_iff_isIso_sigmaDesc a).mpr hiso).some
    have hau : IsUniversalColimit a := FinitaryPreExtensive.isUniversal_finiteCoproducts hc
    have w₀ : pullback.snd h (q' ≫ ι) ≫ q' = (pullback.fst h (q' ≫ ι) ≫ t) ≫ q' := by
      apply (cancel_mono ι).mp
      simp only [Category.assoc]
      rw [← ht]
      exact pullback.condition.symm
    let p₂ : pullback h (q' ≫ ι) ⟶ pullback q' q' :=
      pullback.lift (pullback.snd h (q' ≫ ι)) (pullback.fst h (q' ≫ ι) ≫ t) w₀
    have hp₂f : p₂ ≫ pullback.fst q' q' = pullback.snd h (q' ≫ ι) := pullback.lift_fst _ _ _
    have hp₂s : p₂ ≫ pullback.snd q' q' = pullback.fst h (q' ≫ ι) ≫ t := pullback.lift_snd _ _ _
    have h₀ : IsPullback (pullback.fst h (q' ≫ ι)) p₂ t (pullback.snd q' q') := by
      refine IsPullback.of_isLimit (c := PullbackCone.mk (pullback.fst h (q' ≫ ι)) p₂ hp₂s.symm) ?_
      have w₁ : ∀ c : PullbackCone t (pullback.snd q' q'),
          c.fst ≫ h = (c.snd ≫ pullback.fst q' q') ≫ q' ≫ ι := by
        intro c
        have hc' := c.condition
        calc c.fst ≫ h = (c.fst ≫ t) ≫ q' ≫ ι := by rw [ht, Category.assoc]
          _ = (c.snd ≫ pullback.snd q' q') ≫ q' ≫ ι := by rw [hc']
          _ = (c.snd ≫ pullback.fst q' q') ≫ q' ≫ ι := by
            simp only [Category.assoc, pullback.condition_assoc]
      refine PullbackCone.IsLimit.mk _
        (fun c => pullback.lift c.fst (c.snd ≫ pullback.fst q' q') (w₁ c)) ?_ ?_ ?_
      · intro c
        exact pullback.lift_fst _ _ _
      · intro c
        apply pullback.hom_ext
        · rw [Category.assoc, hp₂f, pullback.lift_snd]
        · rw [Category.assoc, hp₂s, ← Category.assoc, pullback.lift_fst]
          exact c.condition
      · intro c m hm1 hm2
        apply pullback.hom_ext
        · rw [pullback.lift_fst]
          exact hm1
        · rw [pullback.lift_snd, ← hp₂f, ← Category.assoc]
          exact congrArg (· ≫ pullback.fst q' q') hm2
    let d : Cofan (fun _ : Γ => T₀) := Cofan.mk (pullback h (q' ≫ ι)) s
    have hd := hau.nonempty_isColimit_of_isPullback_left (fun _ => 𝟙 V) (pullback.snd q' q') t
      (fun _ => 𝟙 T₀) (fun _ => t) (fun _ => IsPullback.id_horiz t) h₀ d (Iso.refl _)
      (fun γ => pullback.lift_snd _ _ _)
      (fun γ => by
        show s γ ≫ 𝟙 _ ≫ _ = _
        rw [Category.id_comp]
        exact hs1 γ)
      (fun γ => by
        show s γ ≫ 𝟙 _ ≫ p₂ = t ≫ pullback.lift (β γ) (𝟙 V) _
        rw [Category.id_comp]
        apply pullback.hom_ext
        · rw [Category.assoc, hp₂f, hs2, Category.assoc, pullback.lift_fst]
        · rw [Category.assoc, hp₂s, ← Category.assoc, hs1, Category.assoc, pullback.lift_snd,
            Category.id_comp, Category.comp_id])
    exact (Cofan.nonempty_isColimit_iff_isIso_sigmaDesc d).mp hd

  open CategoryTheory.Limits in
  have s2 : ∀ {P T₀ : Scheme.{u}} (Γ : Type u) (s : Γ → (T₀ ⟶ P)) (_ : IsIso (Sigma.desc s)),
      (∀ z : ↥P, ∃! γ : Γ, z ∈ Set.range ⇑(s γ)) ∧ ∀ γ : Γ, Topology.IsOpenEmbedding ⇑(s γ) := by
    intro P T₀ Γ s hs
    let H : (Σ _ : Γ, ↥T₀) ≃ₜ ↥P :=
      (sigmaMk (fun _ : Γ => T₀)).trans (Scheme.homeoOfIso (asIso (Sigma.desc s)))
    have hH : ∀ γ x, H ⟨γ, x⟩ = s γ x := by
      intro γ x
      simp only [H, Homeomorph.trans_apply, sigmaMk_mk, Scheme.homeoOfIso_apply, asIso_hom]
      rw [← Scheme.Hom.comp_apply, Sigma.ι_comp_desc]
    refine ⟨fun z => ?_, fun γ => ?_⟩
    · obtain ⟨⟨γ, x⟩, rfl⟩ := H.surjective z
      refine ⟨γ, ⟨x, (hH γ x).symm⟩, ?_⟩
      rintro γ' ⟨x', hx'⟩
      rw [← hH] at hx'
      exact congrArg Sigma.fst (H.injective hx')
    · haveI : IsOpenImmersion (Sigma.ι (fun _ : Γ => T₀) γ ≫ Sigma.desc s) := inferInstance
      have e : s γ = Sigma.ι (fun _ : Γ => T₀) γ ≫ Sigma.desc s := (Sigma.ι_comp_desc s γ).symm
      rw [e]
      exact Scheme.Hom.isOpenEmbedding _

  have hsw : ∀ γ : Γ, 𝟙 T.left ≫ T.hom = (e ≫ (α γ).hom) ≫ q ≫ j := by
    intro γ
    rw [Category.id_comp, Category.assoc, hα γ, he]
  let s : Γ → (T.left ⟶ Limits.pullback T.hom (q ≫ j)) := fun γ =>
    Limits.pullback.lift (𝟙 T.left) (e ≫ (α γ).hom) (hsw γ)
  obtain ⟨hfin, -, -, -, hα', hiso⟩ := hcov
  haveI : Finite Γ := hfin
  have hσ : IsIso (Limits.Sigma.desc s) :=
    s1 q j Γ (fun γ => (α γ).hom) hα' hiso T.hom e he.symm s
      (fun γ => Limits.pullback.lift_fst _ _ _) (fun γ => Limits.pullback.lift_snd _ _ _)
  obtain ⟨hP1, hP2⟩ := s2 Γ s hσ

  let m : Γ → (Limits.pullback T.hom (q ≫ j) ⟶ Limits.pullback T.hom (q ≫ j)) := fun g =>
    Limits.pullback.map T.hom (q ≫ j) T.hom (q ≫ j) (𝟙 _) (α g).hom (𝟙 X) (by simp)
      (by simp [hα g])
  let pfst := Limits.pullback.fst T.hom (q ≫ j)
  have hfst : ∀ γ w, pfst (s γ w) = w := by
    intro γ w
    show (Limits.pullback.fst T.hom (q ≫ j))
      ((Limits.pullback.lift (𝟙 T.left) (e ≫ (α γ).hom) (hsw γ)) w) = w
    rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_fst]
    rfl
  have hsm : ∀ g c, s c ≫ m g = s (g * c) := by
    intro g c
    apply Limits.pullback.hom_ext
    · simp only [s, m, Limits.pullback.map, Category.assoc, Limits.pullback.lift_fst,
        Limits.pullback.lift_fst_assoc, Category.comp_id]
    · simp only [s, m, Limits.pullback.map, Category.assoc, Limits.pullback.lift_snd,
        Limits.pullback.lift_snd_assoc, map_mul, Aut.Aut_mul_def]
      rfl
  have hs1 : Limits.pullback.lift (𝟙 T.left) e (by rw [Category.id_comp, he]) = s 1 := by
    apply Limits.pullback.hom_ext
    · simp only [s, Limits.pullback.lift_fst]
    · simp only [s, Limits.pullback.lift_snd, map_one]
      exact (Category.comp_id e).symm

  let Mat : Γ → Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)) := fun g =>
    (((ρ g)⁻¹ : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))
  have hMat : ∀ g c, Mat (g * c) = Mat c * Mat g := by
    intro g c
    simp only [Mat, map_mul, mul_inv_rev, Units.val_mul]
  have hMat1 : Mat 1 = 1 := by
    simp only [Mat, map_one, inv_one, Units.val_one]

  let γf : ↥(Limits.pullback T.hom (q ≫ j)) → Γ := fun z => (hP1 z).exists.choose
  have hγspec : ∀ z, z ∈ Set.range ⇑(s (γf z)) := fun z => (hP1 z).exists.choose_spec
  have hγuniq : ∀ z c, z ∈ Set.range ⇑(s c) → c = γf z :=
    fun z c hc => (hP1 z).unique hc (hγspec z)
  have hγs : ∀ c w, γf (s c w) = c := fun c w => (hγuniq _ c ⟨w, rfl⟩).symm

  let xf : ↥(Limits.pullback T.hom (q ≫ j)) → (Fin r → ZMod (ℓ ^ n)) := fun z =>
    Matrix.vecMul (f (pfst z)) (Mat (γf z))
  have hγlc : IsLocallyConstant γf := by
    rw [IsLocallyConstant.iff_exists_open]
    intro z
    exact ⟨Set.range ⇑(s (γf z)), (hP2 (γf z)).isOpen_range, hγspec z,
      fun z' hz' => (hγuniq z' _ hz').symm⟩
  have hflc : IsLocallyConstant (fun z => f (pfst z)) :=
    (IsLocallyConstant.iff_continuous _).mpr (f.continuous.comp (Scheme.Hom.continuous _))
  have hxlc : IsLocallyConstant xf := hflc.comp₂ hγlc (fun v c => Matrix.vecMul v (Mat c))
  let x : C(↥(Limits.pullback T.hom (q ≫ j)), Fin r → ZMod (ℓ ^ n)) := ⟨xf, hxlc.continuous⟩
  have hEQ' : ∀ g c w, xf (m g (s c w)) = Matrix.vecMul (xf (s c w)) (Mat g) := by
    intro g c w
    have h1 : m g (s c w) = s (g * c) w := by rw [← Scheme.Hom.comp_apply, hsm]
    show Matrix.vecMul (f (pfst (m g (s c w)))) (Mat (γf (m g (s c w)))) =
      Matrix.vecMul (Matrix.vecMul (f (pfst (s c w))) (Mat (γf (s c w)))) (Mat g)
    rw [h1, hfst, hfst, hγs, hγs, hMat, Matrix.vecMul_vecMul]
  have hEQ : ∀ g z, xf (m g z) = Matrix.vecMul (xf z) (Mat g) := by
    intro g z
    obtain ⟨w, hw⟩ := hγspec z
    rw [← hw]
    exact hEQ' g _ w
  refine ⟨Subtype.mk (Subtype.mk (ULift.up x) ?_) ?_, ?_⟩
  · refine AddSubgroup.mem_iInf.mpr (fun g => ?_)
    refine AddMonoidHom.mem_ker.mpr ?_
    simp only [AddCommGrpCat.hom_sub]
    refine (AddMonoidHom.sub_apply _ _ _).trans (sub_eq_zero.mpr ?_)
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    exact hEQ g z
  · exact AddSubgroup.mem_iSup_of_mem hT (AddSubgroup.mem_top _)
  · intro t
    unfold wcLtcFrameVal
    rw [dif_pos he]
    show xf (Limits.pullback.lift (𝟙 T.left) e (by rw [Category.id_comp, he]) t) = f t
    rw [hs1]
    show Matrix.vecMul (f (pfst (s 1 t))) (Mat (γf (s 1 t))) = f t
    rw [hfst, hγs, hMat1, Matrix.vecMul_one]

theorem wc_ltc_glue_package (X : Scheme.{u}) (A : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
    (F : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
    (Rel : ∀ (T T' : X.ProEt), (T' ⟶ T) → A.obj (Opposite.op T) → F.obj.obj (Opposite.op T') → Prop)
    (H1 : ∀ (T : X.ProEt) (s : A.obj (Opposite.op T)), ∃ R : Sieve T,
      R ∈ Scheme.ProEt.topology X T ∧
        ∀ (T' : X.ProEt) (c : T' ⟶ T), R.arrows c → ∃ y, Rel T T' c s y)
    (H2 : ∀ (T T' : X.ProEt) (c : T' ⟶ T) (s : A.obj (Opposite.op T))
      (y y' : F.obj.obj (Opposite.op T')), Rel T T' c s y → Rel T T' c s y' → y = y')
    (H3 : ∀ (T T' T'' : X.ProEt) (c : T' ⟶ T) (d : T'' ⟶ T') (s : A.obj (Opposite.op T))
      (y : F.obj.obj (Opposite.op T')),
        Rel T T' c s y → Rel T T'' (d ≫ c) s ((F.obj.map d.op).hom y))
    (H4 : ∀ (T T' : X.ProEt) (c : T' ⟶ T) (s s' : A.obj (Opposite.op T))
      (y y' : F.obj.obj (Opposite.op T')),
        Rel T T' c s y → Rel T T' c s' y' → Rel T T' c (s + s') (y + y'))
    (H5 : ∀ (T T₂ T' : X.ProEt) (g : T ⟶ T₂) (c : T' ⟶ T) (s : A.obj (Opposite.op T₂))
      (y : F.obj.obj (Opposite.op T')),
        Rel T₂ T' (c ≫ g) s y → Rel T T' c ((A.map g.op).hom s) y) :
    ∃ Pn : A ⟶ F.obj, ∀ (T T' : X.ProEt) (c : T' ⟶ T) (s : A.obj (Opposite.op T))
      (y : F.obj.obj (Opposite.op T')),
        Rel T T' c s y → (F.obj.map c.op).hom ((Pn.app (Opposite.op T)).hom s) = y :=
by
  classical
  have hs : Presieve.IsSheaf (Scheme.ProEt.topology X) (F.obj ⋙ forget AddCommGrpCat) := by
    have h := (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology X) F.obj
      (forget AddCommGrpCat)).mp F.2
    rwa [isSheaf_iff_isSheaf_of_type] at h
  have hcompF : ∀ (T T' T'' : X.ProEt) (c : T' ⟶ T) (d : T'' ⟶ T')
      (x : F.obj.obj (Opposite.op T)),
      (F.obj.map d.op).hom ((F.obj.map c.op).hom x) = (F.obj.map (d ≫ c).op).hom x := by
    intro T T' T'' c d x
    rw [op_comp, Functor.map_comp, AddCommGrpCat.comp_apply]
  have sep : ∀ (T : X.ProEt) (R : Sieve T), R ∈ Scheme.ProEt.topology X T →
      ∀ (x x' : F.obj.obj (Opposite.op T)),
      (∀ (T' : X.ProEt) (g : T' ⟶ T), R.arrows g →
        (F.obj.map g.op).hom x = (F.obj.map g.op).hom x') → x = x' := by
    intro T R hR x x' h
    exact (hs.isSeparated R hR).ext (fun T' g hg => h T' g hg)
  have val : ∀ (T : X.ProEt) (s : A.obj (Opposite.op T)), ∃ v : F.obj.obj (Opposite.op T),
      ∀ (T' : X.ProEt) (c : T' ⟶ T) (y : F.obj.obj (Opposite.op T')),
        Rel T T' c s y → (F.obj.map c.op).hom v = y := by
    intro T s
    obtain ⟨R, hR, hex⟩ := H1 T s
    choose x hx using hex
    let xf : Presieve.FamilyOfElements (F.obj ⋙ forget AddCommGrpCat) R.arrows :=
      fun T' g hg => x T' g hg
    have key : ∀ (Z : X.ProEt) (a b : Z ⟶ T) (ha : R.arrows a) (hb : R.arrows b), a = b →
        x Z a ha = x Z b hb := by
      rintro Z a b ha hb rfl
      rfl
    have hcomp : xf.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ heq
      have e1 : (F.obj.map g₁.op).hom (x Y₁ f₁ h₁) = x Z (g₁ ≫ f₁) (R.downward_closed h₁ g₁) :=
        H2 _ _ _ _ _ _ (H3 _ _ _ _ _ _ _ (hx _ _ h₁)) (hx _ _ _)
      have e2 : (F.obj.map g₂.op).hom (x Y₂ f₂ h₂) = x Z (g₂ ≫ f₂) (R.downward_closed h₂ g₂) :=
        H2 _ _ _ _ _ _ (H3 _ _ _ _ _ _ _ (hx _ _ h₂)) (hx _ _ _)
      exact e1.trans ((key _ _ _ _ _ heq).trans e2.symm)
    have hv : ∀ (T' : X.ProEt) (g : T' ⟶ T) (hg : R.arrows g),
        (F.obj.map g.op).hom ((hs R hR).amalgamate xf hcomp) = x T' g hg :=
      fun T' g hg => (hs R hR).valid_glue hcomp g hg
    refine ⟨(hs R hR).amalgamate xf hcomp, ?_⟩
    intro T' c y hy
    apply sep T' (R.pullback c) ((Scheme.ProEt.topology X).pullback_stable c hR)
    intro T'' d hd
    rw [hcompF, hv T'' (d ≫ c) hd]
    exact H2 _ _ _ _ _ _ (hx _ _ hd) (H3 _ _ _ _ _ _ _ hy)
  choose φ hφ using val
  have hadd : ∀ (T : X.ProEt) (a b : A.obj (Opposite.op T)),
      φ T (a + b) = φ T a + φ T b := by
    intro T a b
    obtain ⟨Ra, hRa, hexa⟩ := H1 T a
    obtain ⟨Rb, hRb, hexb⟩ := H1 T b
    apply sep T (Ra ⊓ Rb) ((Scheme.ProEt.topology X).intersection_covering hRa hRb)
    intro T' g hg
    obtain ⟨ya, hya⟩ := hexa T' g hg.1
    obtain ⟨yb, hyb⟩ := hexb T' g hg.2
    rw [map_add, hφ T a T' g ya hya, hφ T b T' g yb hyb]
    exact hφ T (a + b) T' g _ (H4 _ _ _ _ _ _ _ hya hyb)
  have hnat : ∀ (T T₂ : X.ProEt) (g : T ⟶ T₂) (s : A.obj (Opposite.op T₂)),
      φ T ((A.map g.op).hom s) = (F.obj.map g.op).hom (φ T₂ s) := by
    intro T T₂ g s
    obtain ⟨R, hR, hex⟩ := H1 T₂ s
    apply sep T (R.pullback g) ((Scheme.ProEt.topology X).pullback_stable g hR)
    intro T' c hc
    obtain ⟨y, hy⟩ := hex T' (c ≫ g) hc
    rw [hcompF, hφ T₂ s T' (c ≫ g) y hy]
    exact hφ T _ T' c y (H5 _ _ _ _ _ _ _ hy)
  let Pn : A ⟶ F.obj :=
    { app := fun U => AddCommGrpCat.ofHom (AddMonoidHom.mk' (φ U.unop) (hadd U.unop))
      naturality := by
        intro U V f
        ext s
        have := hnat V.unop U.unop f.unop s
        simpa using this }
  exact ⟨Pn, fun T T' c s y h => hφ T s T' c y h⟩

theorem wc_ltc_glue_compat {X U' V : Scheme.{u}} (j : U' ⟶ X) [IsOpenImmersion j] (q : V ⟶ U')
    (Z : Set X) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n r : ℕ)
    (α : wcLtcGam.{u} ℓ r n →* Aut V) (hα : ∀ γ, (α γ).hom ≫ q ≫ j = q ≫ j)
    (hcov : wcGalCover q (wcLtcGam.{u} ℓ r n) α)
    (G : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (W : X.ProEt)
    (θ : G.over W ≅ (wcContSheaf X (Fin r → ℚ_[ℓ])).over W)
    (N : ↥(Limits.pullback W.hom W.hom) → GL (Fin r) ℤ_[ℓ])
    (hNlc : IsLocallyConstant (fun x => wcLtcRed.{u} ℓ n r (N x)))
    (hTR : ∀ (T : X.ProEt) (a b : T ⟶ W) (s : G.obj.obj (Opposite.op T)) (z : T.left),
        wcLtcVal θ a s z = Matrix.vecMul (wcLtcVal θ b s z)
          ((N (wcLtcPair a b z) : Matrix (Fin r) (Fin r) ℤ_[ℓ]).map
            (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ]))))
    (fr : W.left ⟶ V) (hf : fr ≫ q ≫ j = W.hom)
    (htrans : ∀ (T : X.ProEt) (a b : T ⟶ W) (γ : wcLtcGam.{u} ℓ r n),
        (∀ z : T.left, wcLtcRed.{u} ℓ n r (N (wcLtcPair a b z)) = γ) →
        b.left ≫ fr = a.left ≫ fr ≫ (α γ).hom)
    (T : X.ProEt) (a b : T ⟶ W) (s : G.obj.obj (Opposite.op T))
    (hsa : ∀ z i, ‖wcLtcVal θ a s z i‖ ≤ 1) (hsb : ∀ z i, ‖wcLtcVal θ b s z i‖ ≤ 1)
    (u₁ u₂ : (wcLtcTwPre (q ≫ j) Z (wcLtcGam.{u} ℓ r n) α hα ℓ n r
      (wcLtcRho.{u} ℓ r n)).obj (Opposite.op T))
    (h₁ : ∀ t, wcLtcFrameVal u₁ (a.left ≫ fr) t = wcLtcRedVec ℓ n r (wcLtcVal θ a s t))
    (h₂ : ∀ t, wcLtcFrameVal u₂ (b.left ≫ fr) t = wcLtcRedVec ℓ n r (wcLtcVal θ b s t)) :
    u₁ = u₂ :=
by
  classical


  open CategoryTheory.Limits in
  have s1 : ∀ {X W V T₀ : Scheme.{u}} (q' : V ⟶ W) (ι : W ⟶ X) [Mono ι] (Γ : Type u) [Finite Γ]
      (β : Γ → (V ⟶ V)) (hβ : ∀ γ, β γ ≫ q' = q')
      (_ : IsIso (Sigma.desc (fun γ : Γ => pullback.lift (β γ) (𝟙 V)
        ((hβ γ).trans (Category.id_comp q').symm)) : ∐ (fun _ : Γ => V) ⟶ pullback q' q'))
      (h : T₀ ⟶ X) (t : T₀ ⟶ V) (_ : h = t ≫ q' ≫ ι)
      (s : Γ → (T₀ ⟶ pullback h (q' ≫ ι)))
      (_ : ∀ γ, s γ ≫ pullback.fst h (q' ≫ ι) = 𝟙 T₀)
      (_ : ∀ γ, s γ ≫ pullback.snd h (q' ≫ ι) = t ≫ β γ),
      IsIso (Sigma.desc s) := by
    intro X W V T₀ q' ι _ Γ _ β hβ hiso h t ht s hs1 hs2
    let a : Cofan (fun _ : Γ => V) := Cofan.mk (pullback q' q') (fun γ => pullback.lift (β γ) (𝟙 V)
        ((hβ γ).trans (Category.id_comp q').symm))
    have hc : IsColimit a := ((Cofan.nonempty_isColimit_iff_isIso_sigmaDesc a).mpr hiso).some
    have hau : IsUniversalColimit a := FinitaryPreExtensive.isUniversal_finiteCoproducts hc
    have w₀ : pullback.snd h (q' ≫ ι) ≫ q' = (pullback.fst h (q' ≫ ι) ≫ t) ≫ q' := by
      apply (cancel_mono ι).mp
      simp only [Category.assoc]
      rw [← ht]
      exact pullback.condition.symm
    let p₂ : pullback h (q' ≫ ι) ⟶ pullback q' q' :=
      pullback.lift (pullback.snd h (q' ≫ ι)) (pullback.fst h (q' ≫ ι) ≫ t) w₀
    have hp₂f : p₂ ≫ pullback.fst q' q' = pullback.snd h (q' ≫ ι) := pullback.lift_fst _ _ _
    have hp₂s : p₂ ≫ pullback.snd q' q' = pullback.fst h (q' ≫ ι) ≫ t := pullback.lift_snd _ _ _
    have h₀ : IsPullback (pullback.fst h (q' ≫ ι)) p₂ t (pullback.snd q' q') := by
      refine IsPullback.of_isLimit (c := PullbackCone.mk (pullback.fst h (q' ≫ ι)) p₂ hp₂s.symm) ?_
      have w₁ : ∀ c : PullbackCone t (pullback.snd q' q'),
          c.fst ≫ h = (c.snd ≫ pullback.fst q' q') ≫ q' ≫ ι := by
        intro c
        have hc' := c.condition
        calc c.fst ≫ h = (c.fst ≫ t) ≫ q' ≫ ι := by rw [ht, Category.assoc]
          _ = (c.snd ≫ pullback.snd q' q') ≫ q' ≫ ι := by rw [hc']
          _ = (c.snd ≫ pullback.fst q' q') ≫ q' ≫ ι := by
            simp only [Category.assoc, pullback.condition_assoc]
      refine PullbackCone.IsLimit.mk _
        (fun c => pullback.lift c.fst (c.snd ≫ pullback.fst q' q') (w₁ c)) ?_ ?_ ?_
      · intro c
        exact pullback.lift_fst _ _ _
      · intro c
        apply pullback.hom_ext
        · rw [Category.assoc, hp₂f, pullback.lift_snd]
        · rw [Category.assoc, hp₂s, ← Category.assoc, pullback.lift_fst]
          exact c.condition
      · intro c m hm1 hm2
        apply pullback.hom_ext
        · rw [pullback.lift_fst]
          exact hm1
        · rw [pullback.lift_snd, ← hp₂f, ← Category.assoc]
          exact congrArg (· ≫ pullback.fst q' q') hm2
    let d : Cofan (fun _ : Γ => T₀) := Cofan.mk (pullback h (q' ≫ ι)) s
    have hd := hau.nonempty_isColimit_of_isPullback_left (fun _ => 𝟙 V) (pullback.snd q' q') t
      (fun _ => 𝟙 T₀) (fun _ => t) (fun _ => IsPullback.id_horiz t) h₀ d (Iso.refl _)
      (fun γ => pullback.lift_snd _ _ _)
      (fun γ => by
        show s γ ≫ 𝟙 _ ≫ _ = _
        rw [Category.id_comp]
        exact hs1 γ)
      (fun γ => by
        show s γ ≫ 𝟙 _ ≫ p₂ = t ≫ pullback.lift (β γ) (𝟙 V) _
        rw [Category.id_comp]
        apply pullback.hom_ext
        · rw [Category.assoc, hp₂f, hs2, Category.assoc, pullback.lift_fst]
        · rw [Category.assoc, hp₂s, ← Category.assoc, hs1, Category.assoc, pullback.lift_snd,
            Category.id_comp, Category.comp_id])
    exact (Cofan.nonempty_isColimit_iff_isIso_sigmaDesc d).mp hd
  open CategoryTheory.Limits in
  have s2 : ∀ {P T₀ : Scheme.{u}} (Γ : Type u) (s : Γ → (T₀ ⟶ P)) (_ : IsIso (Sigma.desc s)),
      (∀ z : ↥P, ∃! γ : Γ, z ∈ Set.range ⇑(s γ)) ∧ ∀ γ : Γ, Topology.IsOpenEmbedding ⇑(s γ) := by
    intro P T₀ Γ s hs
    let H : (Σ _ : Γ, ↥T₀) ≃ₜ ↥P :=
      (sigmaMk (fun _ : Γ => T₀)).trans (Scheme.homeoOfIso (asIso (Sigma.desc s)))
    have hH : ∀ γ x, H ⟨γ, x⟩ = s γ x := by
      intro γ x
      simp only [H, Homeomorph.trans_apply, sigmaMk_mk, Scheme.homeoOfIso_apply, asIso_hom]
      rw [← Scheme.Hom.comp_apply, Sigma.ι_comp_desc]
    refine ⟨fun z => ?_, fun γ => ?_⟩
    · obtain ⟨⟨γ, x⟩, rfl⟩ := H.surjective z
      refine ⟨γ, ⟨x, (hH γ x).symm⟩, ?_⟩
      rintro γ' ⟨x', hx'⟩
      rw [← hH] at hx'
      exact congrArg Sigma.fst (H.injective hx')
    · haveI : IsOpenImmersion (Sigma.ι (fun _ : Γ => T₀) γ ≫ Sigma.desc s) := inferInstance
      have e : s γ = Sigma.ι (fun _ : Γ => T₀) γ ≫ Sigma.desc s := (Sigma.ι_comp_desc s γ).symm
      rw [e]
      exact Scheme.Hom.isOpenEmbedding _
  obtain ⟨hfin, -, -, -, hα', hiso⟩ := hcov
  haveI : Finite (wcLtcGam.{u} ℓ r n) := hfin

  have hFV : ∀ (T0 : X.ProEt)
      (u : (wcLtcTwPre (q ≫ j) Z (wcLtcGam.{u} ℓ r n) α hα ℓ n r
        (wcLtcRho.{u} ℓ r n)).obj (Opposite.op T0))
      (e : T0.left ⟶ V) (he : e ≫ q ≫ j = T0.hom) (t : T0.left),
      wcLtcFrameVal u e t =
        (show C(↥(Limits.pullback T0.hom (q ≫ j)), Fin r → ZMod (ℓ ^ n)) from u.1.1.down)
          (Limits.pullback.lift (𝟙 T0.left) e (by rw [Category.id_comp, he]) t) := by
    intro T0 u e he t
    unfold wcLtcFrameVal
    rw [dif_pos he]
    try rfl

  have hshift : ∀ (T0 : X.ProEt)
      (u : (wcLtcTwPre (q ≫ j) Z (wcLtcGam.{u} ℓ r n) α hα ℓ n r
        (wcLtcRho.{u} ℓ r n)).obj (Opposite.op T0))
      (e : T0.left ⟶ V) (he : e ≫ q ≫ j = T0.hom) (γ : wcLtcGam.{u} ℓ r n) (t : T0.left),
      wcLtcFrameVal u (e ≫ (α γ).hom) t = Matrix.vecMul (wcLtcFrameVal u e t)
        (((wcLtcRho.{u} ℓ r n γ)⁻¹ : GL (Fin r) (ZMod (ℓ ^ n))) :
          Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) := by
    intro T0 u e he γ t
    have he' : (e ≫ (α γ).hom) ≫ q ≫ j = T0.hom := by rw [Category.assoc, hα γ, he]
    let m : Limits.pullback T0.hom (q ≫ j) ⟶ Limits.pullback T0.hom (q ≫ j) :=
      Limits.pullback.map T0.hom (q ≫ j) T0.hom (q ≫ j) (𝟙 _) (α γ).hom (𝟙 X) (by simp)
        (by simp [hα γ])
    have hmor : Limits.pullback.lift (𝟙 T0.left) (e ≫ (α γ).hom) (by rw [Category.id_comp, he']) =
        Limits.pullback.lift (𝟙 T0.left) e (by rw [Category.id_comp, he]) ≫ m := by
      apply Limits.pullback.hom_ext
      · simp only [m, Limits.pullback.map, Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.lift_fst_assoc, Category.comp_id]
      · simp only [m, Limits.pullback.map, Category.assoc, Limits.pullback.lift_snd,
          Limits.pullback.lift_snd_assoc]
    have hmem := AddSubgroup.mem_iInf.mp u.1.2 γ
    have h0 := AddMonoidHom.mem_ker.mp hmem
    simp only [AddCommGrpCat.hom_sub, AddMonoidHom.sub_apply, sub_eq_zero] at h0
    have heq : ∀ z, (show C(↥(Limits.pullback T0.hom (q ≫ j)), Fin r → ZMod (ℓ ^ n)) from
          u.1.1.down) (m z) =
        Matrix.vecMul ((show C(↥(Limits.pullback T0.hom (q ≫ j)), Fin r → ZMod (ℓ ^ n)) from
          u.1.1.down) z)
          (((wcLtcRho.{u} ℓ r n γ)⁻¹ : GL (Fin r) (ZMod (ℓ ^ n))) :
            Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) :=
      fun z => congrArg (fun w : (wcTwBase (q ≫ j) ℓ n r).obj (Opposite.op T0) =>
        (show C(↥(Limits.pullback T0.hom (q ≫ j)), Fin r → ZMod (ℓ ^ n)) from w.down) z) h0
    rw [hFV T0 u _ he', hFV T0 u e he, hmor, Scheme.Hom.comp_apply]
    exact heq _

  have hnat : ∀ (T0 T1 : X.ProEt) (k : T1 ⟶ T0)
      (u : (wcLtcTwPre (q ≫ j) Z (wcLtcGam.{u} ℓ r n) α hα ℓ n r
        (wcLtcRho.{u} ℓ r n)).obj (Opposite.op T0))
      (e : T0.left ⟶ V) (he : e ≫ q ≫ j = T0.hom) (z : T1.left),
      wcLtcFrameVal (((wcLtcTwPre (q ≫ j) Z (wcLtcGam.{u} ℓ r n) α hα ℓ n r
        (wcLtcRho.{u} ℓ r n)).map k.op).hom u) (k.left ≫ e) z = wcLtcFrameVal u e (k.left z) := by
    intro T0 T1 k u e he z
    have he' : (k.left ≫ e) ≫ q ≫ j = T1.hom := by
      rw [Category.assoc, he]; exact MorphismProperty.Over.w k
    have hmor : (Limits.pullback.lift (𝟙 T1.left) (k.left ≫ e)
          ((Category.id_comp _).trans he'.symm) : T1.left ⟶ (wcPbFun (q ≫ j)).obj T1) ≫
        (wcPbFun (q ≫ j)).map k =
        k.left ≫ (Limits.pullback.lift (𝟙 T0.left) e ((Category.id_comp _).trans he.symm) :
          T0.left ⟶ (wcPbFun (q ≫ j)).obj T0) := by
      apply Limits.pullback.hom_ext
      · simp only [wcPbFun, Functor.comp_map, Over.forget_map, Over.pullback_map_left]
        repeat (first | rw [Category.assoc] | erw [Limits.pullback.lift_fst_assoc] |
          erw [Limits.pullback.lift_fst] | rw [Category.id_comp] | rw [Category.comp_id])
        exact (Category.id_comp _).trans (Category.comp_id _).symm
      · simp only [wcPbFun, Functor.comp_map, Over.forget_map, Over.pullback_map_left]
        repeat (first | rw [Category.assoc] | erw [Limits.pullback.lift_snd_assoc] |
          erw [Limits.pullback.lift_snd])
    have hpt : (wcPbFun (q ≫ j)).map k
        ((Limits.pullback.lift (𝟙 T1.left) (k.left ≫ e) ((Category.id_comp _).trans he'.symm) :
          T1.left ⟶ (wcPbFun (q ≫ j)).obj T1) z) =
        (Limits.pullback.lift (𝟙 T0.left) e ((Category.id_comp _).trans he.symm) :
          T0.left ⟶ (wcPbFun (q ≫ j)).obj T0) (k.left z) := by
      have := congrArg (fun φ : T1.left ⟶ (wcPbFun (q ≫ j)).obj T0 => φ z) hmor
      exact (Scheme.Hom.comp_apply _ _ z).symm.trans (this.trans (Scheme.Hom.comp_apply _ _ z))
    unfold wcLtcFrameVal
    rw [dif_pos he', dif_pos he]
    exact congrArg (fun y => (show C(↥(Limits.pullback T0.hom (q ≫ j)), Fin r → ZMod (ℓ ^ n))
      from u.1.1.down) y) hpt

  have huniq : ∀ (e : T.left ⟶ V) (he : e ≫ q ≫ j = T.hom)
      (u u' : (wcLtcTwPre (q ≫ j) Z (wcLtcGam.{u} ℓ r n) α hα ℓ n r
        (wcLtcRho.{u} ℓ r n)).obj (Opposite.op T)),
      (∀ t, wcLtcFrameVal u e t = wcLtcFrameVal u' e t) → u = u' := by
    intro e he u u' hfv
    let s : wcLtcGam.{u} ℓ r n → (T.left ⟶ Limits.pullback T.hom (q ≫ j)) := fun γ =>
      Limits.pullback.lift (𝟙 T.left) (e ≫ (α γ).hom)
        (by rw [Category.id_comp, Category.assoc, hα γ, he])
    have hσ : IsIso (Limits.Sigma.desc s) :=
      s1 q j (wcLtcGam.{u} ℓ r n) (fun γ => (α γ).hom) hα' hiso T.hom e he.symm s
        (fun γ => Limits.pullback.lift_fst _ _ _) (fun γ => Limits.pullback.lift_snd _ _ _)
    obtain ⟨hP1, -⟩ := s2 (wcLtcGam.{u} ℓ r n) s hσ
    apply Subtype.ext
    apply Subtype.ext
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    obtain ⟨γ, ⟨w, rfl⟩, -⟩ := hP1 z
    have he' : (e ≫ (α γ).hom) ≫ q ≫ j = T.hom := by rw [Category.assoc, hα γ, he]
    have k1 := hshift T u e he γ w
    have k2 := hshift T u' e he γ w
    have k3 := hfv w
    rw [hFV T u _ he', hFV T u e he] at k1
    rw [hFV T u' _ he', hFV T u' e he] at k2
    rw [hFV T u e he, hFV T u' e he] at k3
    rw [k3] at k1
    exact k1.trans k2.symm

  have hloc : ∀ t : T.left, ∃ (T' : X.ProEt) (o : T' ⟶ T) (t' : T'.left), o.left t' = t ∧
      o.left ≫ b.left ≫ fr =
        o.left ≫ a.left ≫ fr ≫ (α (wcLtcRed.{u} ℓ n r (N (wcLtcPair a b t)))).hom := by
    intro t
    have hO : IsOpen {z : T.left | wcLtcRed.{u} ℓ n r (N (wcLtcPair a b z)) =
        wcLtcRed.{u} ℓ n r (N (wcLtcPair a b t))} :=
      (hNlc.comp_continuous (Scheme.Hom.continuous (wcLtcPair a b))).isOpen_fiber _
    let O' : T.left.Opens := ⟨_, hO⟩
    let o : wcVRes X T O' ⟶ T := MorphismProperty.Over.homMk O'.ι rfl trivial
    have ht : t ∈ Set.range O'.ι := by
      rw [Scheme.Opens.range_ι]; exact rfl
    obtain ⟨t', ht'⟩ := ht
    have hcl : ∀ c : T ⟶ W, (o ≫ c).left = o.left ≫ c.left := fun c => rfl
    have hpair : wcLtcPair (o ≫ a) (o ≫ b) = o.left ≫ wcLtcPair a b := by
      apply Limits.pullback.hom_ext
      · simp only [wcLtcPair, Category.assoc, Limits.pullback.lift_fst]
        exact hcl a
      · simp only [wcLtcPair, Category.assoc, Limits.pullback.lift_snd]
        exact hcl b
    have hconst : ∀ z : (wcVRes X T O').left,
        wcLtcRed.{u} ℓ n r (N (wcLtcPair (o ≫ a) (o ≫ b) z)) =
          wcLtcRed.{u} ℓ n r (N (wcLtcPair a b t)) := by
      intro z
      have hz : o.left z ∈ Set.range O'.ι := ⟨z, rfl⟩
      rw [Scheme.Opens.range_ι] at hz
      rw [hpair, Scheme.Hom.comp_apply]
      exact hz
    have h := htrans (wcVRes X T O') (o ≫ a) (o ≫ b) _ hconst
    refine ⟨wcVRes X T O', o, t', ht', ?_⟩
    rw [hcl a, hcl b] at h
    simpa only [Category.assoc] using h

  have hred : ∀ (v : Fin r → ℚ_[ℓ]) (M : Matrix (Fin r) (Fin r) ℤ_[ℓ]), (∀ i, ‖v i‖ ≤ 1) →
      wcLtcRedVec ℓ n r (Matrix.vecMul v (M.map (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ])))) =
        Matrix.vecMul (wcLtcRedVec ℓ n r v) (M.map (PadicInt.toZModPow (p := ℓ) n)) := by
    intro v M hv
    let x : Fin r → ℤ_[ℓ] := fun i => ⟨v i, hv i⟩
    have hc : ∀ i, Matrix.vecMul v (M.map (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ]))) i =
        ((Matrix.vecMul x M i : ℤ_[ℓ]) : ℚ_[ℓ]) := fun i =>
      (RingHom.map_vecMul PadicInt.Coe.ringHom M x i).symm
    have hrv : wcLtcRedVec ℓ n r v = fun i => PadicInt.toZModPow (p := ℓ) n (x i) := by
      funext i
      unfold wcLtcRedVec
      rw [dif_pos (hv i)]
    rw [hrv]
    funext i
    have hni : ‖Matrix.vecMul v (M.map (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ]))) i‖ ≤ 1 := by
      rw [hc i]; exact PadicInt.norm_le_one _
    unfold wcLtcRedVec
    rw [dif_pos hni]
    refine (congrArg (PadicInt.toZModPow (p := ℓ) n)
      (Subtype.ext (hc i) : (⟨_, hni⟩ : ℤ_[ℓ]) = Matrix.vecMul x M i)).trans ?_
    exact RingHom.map_vecMul (PadicInt.toZModPow (p := ℓ) n) M x i

  have hs6 : ∀ g : GL (Fin r) ℤ_[ℓ],
      ((wcLtcRho.{u} ℓ r n (wcLtcRed.{u} ℓ n r g) : GL (Fin r) (ZMod (ℓ ^ n))) :
        Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) =
      (g : Matrix (Fin r) (Fin r) ℤ_[ℓ]).map (PadicInt.toZModPow (p := ℓ) n) := by
    intro g
    ext i k
    rfl

  have hea : (a.left ≫ fr) ≫ q ≫ j = T.hom := by
    rw [Category.assoc, hf]; exact MorphismProperty.Over.w a
  have heb : (b.left ≫ fr) ≫ q ≫ j = T.hom := by
    rw [Category.assoc, hf]; exact MorphismProperty.Over.w b
  apply huniq (a.left ≫ fr) hea u₁ u₂
  intro t
  obtain ⟨T', o, t', hot, hr⟩ := hloc t
  have he'' : (o.left ≫ a.left ≫ fr) ≫ q ≫ j = T'.hom := by
    simp only [Category.assoc]
    rw [hf, MorphismProperty.Over.w a, MorphismProperty.Over.w o]
  have hb : wcLtcFrameVal u₂ (b.left ≫ fr) t = Matrix.vecMul (wcLtcFrameVal u₂ (a.left ≫ fr) t)
      (((wcLtcRho.{u} ℓ r n (wcLtcRed.{u} ℓ n r (N (wcLtcPair a b t))))⁻¹ :
        GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) := by
    have c1 := hnat T T' o u₂ _ heb t'
    have c2 := hnat T T' o u₂ _ hea t'
    rw [hot] at c1 c2
    rw [← c1, ← c2, hr]
    have c3 := hshift T' (((wcLtcTwPre (q ≫ j) Z (wcLtcGam.{u} ℓ r n) α hα ℓ n r
        (wcLtcRho.{u} ℓ r n)).map o.op).hom u₂) (o.left ≫ a.left ≫ fr) he''
      (wcLtcRed.{u} ℓ n r (N (wcLtcPair a b t))) t'
    simp only [Category.assoc] at c3
    exact c3
  have hinv : wcLtcFrameVal u₂ (a.left ≫ fr) t =
      Matrix.vecMul (wcLtcFrameVal u₂ (b.left ≫ fr) t)
        ((wcLtcRho.{u} ℓ r n (wcLtcRed.{u} ℓ n r (N (wcLtcPair a b t))) :
          GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) := by
    rw [hb, Matrix.vecMul_vecMul, Units.inv_mul, Matrix.vecMul_one]
  rw [hinv, h₂, h₁, hTR T a b s t, hred _ _ (hsb t), hs6]

theorem wc_ltc_pi_glue (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    (W : (wcP1Over K).left.ProEt) (r : ℕ)
    (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).over W)
    (hθ : ∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology (wcP1Over K).left).overPullback
          AddCommGrpCat.{u+1} W).map (σ c) ≫ θ.hom =
        θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over K).left).overPullback
          AddCommGrpCat.{u+1} W).map (wcConstScalar (wcP1Over K).left ℓ r c))
    (hWqc : QuasiCompact W.hom)
    (hWU : ∀ z : W.left, W.hom z ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K)))
    (hWs : ∀ p : (wcP1Over K).left, p ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K)) →
        ∃ z : W.left, W.hom z = p)
    (N : ↥(Limits.pullback W.hom W.hom) → GL (Fin r) ℤ_[ℓ])
    (hNlc : ∀ n : ℕ, IsLocallyConstant (fun x => wcLtcRed.{u} ℓ n r (N x)))
    (hTR : ∀ (T : (wcP1Over K).left.ProEt) (a b : T ⟶ W) (s : G.obj.obj (Opposite.op T))
          (z : T.left),
        wcLtcVal θ a s z = Matrix.vecMul (wcLtcVal θ b s z)
          ((N (wcLtcPair a b z) : Matrix (Fin r) (Fin r) ℤ_[ℓ]).map
            (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ]))))
    (hNdiag : ∀ (T : (wcP1Over K).left.ProEt) (a : T ⟶ W) (z : T.left), N (wcLtcPair a a z) = 1)
    (hNcoc : ∀ (T : (wcP1Over K).left.ProEt) (a b c : T ⟶ W) (z : T.left),
        N (wcLtcPair a c z) = N (wcLtcPair b c z) * N (wcLtcPair a b z))
    (V : ℕ → Scheme.{u}) (q : (n : ℕ) → V n ⟶ Uo.toScheme)
    (α : (n : ℕ) → wcLtcGam.{u} ℓ r n →* Aut (V n))
    (hα : ∀ n γ, (α n γ).hom ≫ q n ≫ Uo.ι = q n ≫ Uo.ι)
    (fr : (n : ℕ) → W.left ⟶ V n) (hf : ∀ n, fr n ≫ q n ≫ Uo.ι = W.hom)
    (hcov : ∀ n, 1 ≤ n → wcGalCover (q n) (wcLtcGam.{u} ℓ r n) (α n))
    (htrans : ∀ (n : ℕ) (T : (wcP1Over K).left.ProEt) (a b : T ⟶ W)
        (γ : wcLtcGam.{u} ℓ r n),
        (∀ z : T.left, wcLtcRed.{u} ℓ n r (N (wcLtcPair a b z)) = γ) →
        b.left ≫ fr n = a.left ≫ fr n ≫ (α n γ).hom)
    (n : ℕ) (hn : 1 ≤ n) :
    ∃ Pn : wcLtcLpre (Set.range (fun i => S i (IsLocalRing.closedPoint K))) θ ⟶
        (wcTwSh (q n ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
          (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).obj,
      ∀ (T T' : (wcP1Over K).left.ProEt) (c : T' ⟶ T) (b' : T' ⟶ W)
        (s : ↥(wcLtcA (Set.range (fun i => S i (IsLocalRing.closedPoint K))) θ T))
        (u : (wcLtcTwPre (q n ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
          (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).obj (Opposite.op T')),
        (∀ t, T.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K))) →
        (∀ t : T'.left, wcLtcFrameVal u (b'.left ≫ fr n) t =
          wcLtcRedVec ℓ n r (wcLtcVal θ b' ((G.obj.map c.op).hom s.1) t)) →
        ((wcTwSh (q n ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
          (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).obj.map c.op).hom
            ((Pn.app (Opposite.op T)).hom s) =
          ((toSheafify (Scheme.ProEt.topology (wcP1Over K).left)
            (wcLtcTwPre (q n ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
              (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n))).app
              (Opposite.op T')).hom u :=
by
  classical
  obtain ⟨hv1, -, -, -⟩ := wc_ltc_val_api (wcP1Over K).left ℓ r G σ W θ hθ
  generalize Set.range (fun i => S i (IsLocalRing.closedPoint K)) = Zr at hWU hWs ⊢
  have hℓpos : (0:ℝ) < ℓ := by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos
  have hℓ1 : (1:ℝ) ≤ ℓ := by exact_mod_cast (Fact.out : Nat.Prime ℓ).one_lt.le
  have hrad1 : (ℓ:ℝ) ^ (-(n:ℤ)) ≤ 1 := zpow_le_one_of_nonpos₀ hℓ1 (by omega)
  have hTo : ∀ {T T' : (wcP1Over K).left.ProEt} (k : T' ⟶ T),
      (∀ t, T.hom t ∉ Zr) → ∀ t, T'.hom t ∉ Zr := by
    intro T T' k h t
    rw [← MorphismProperty.Over.w k, Scheme.Hom.comp_apply]
    exact h _
  have memA : ∀ (T : (wcP1Over K).left.ProEt) (x : G.obj.obj (Opposite.op T)),
      x ∈ wcLtcA Zr θ T ↔
      (((∀ t, T.hom t ∉ Zr) →
        ∀ (T'' : (wcP1Over K).left.ProEt) (h : T'' ⟶ T) (b : T'' ⟶ W)
        (z : T''.left) (i : Fin r), ‖wcLtcVal θ b ((G.obj.map h.op).hom x) z i‖ ≤ 1) ∧
      ((¬ ∀ t, T.hom t ∉ Zr) → x = 0)) :=
    fun _ _ => Iff.rfl
  have hGc : ∀ (T T' T'' : (wcP1Over K).left.ProEt) (c : T' ⟶ T) (d : T'' ⟶ T')
      (x : G.obj.obj (Opposite.op T)),
      (G.obj.map (d ≫ c).op).hom x = (G.obj.map d.op).hom ((G.obj.map c.op).hom x) := by
    intro T T' T'' c d x
    rw [op_comp, Functor.map_comp]
    rfl
  have hv0 : ∀ (T : (wcP1Over K).left.ProEt) (b : T ⟶ W) (z : T.left),
      wcLtcVal θ b (0 : G.obj.obj (Opposite.op T)) z = 0 := by
    intro T b z
    have e2 : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom 0 = 0 := map_zero _
    exact congrArg (fun w => (show C(↥T.left, Fin r → ℚ_[ℓ]) from w.down) z) e2
  have hvadd : ∀ (T : (wcP1Over K).left.ProEt) (b : T ⟶ W) (x x' : G.obj.obj (Opposite.op T))
      (z : T.left), wcLtcVal θ b (x + x') z = wcLtcVal θ b x z + wcLtcVal θ b x' z := by
    intro T b x x' z
    have e2 : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom (x + x') =
        (θ.hom.hom.app (Opposite.op (Over.mk b))).hom x +
          (θ.hom.hom.app (Opposite.op (Over.mk b))).hom x' := map_add _ _ _
    exact congrArg (fun w => (show C(↥T.left, Fin r → ℚ_[ℓ]) from w.down) z) e2
  have hvcont : ∀ (T : (wcP1Over K).left.ProEt) (b : T ⟶ W) (x : G.obj.obj (Opposite.op T)),
      Continuous (wcLtcVal θ b x) :=
    fun T b x => (show C(↥T.left, Fin r → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down).continuous

  have hker : ∀ x : ℤ_[ℓ], ‖(x : ℚ_[ℓ])‖ ≤ (ℓ:ℝ) ^ (-(n:ℤ)) ↔ PadicInt.toZModPow n x = 0 := by
    intro x
    rw [← PadicInt.norm_def, ← RingHom.mem_ker, PadicInt.ker_toZModPow,
      PadicInt.norm_le_pow_iff_mem_span_pow]
  have hred : ∀ (v : Fin r → ℚ_[ℓ]) (i : Fin r) (h : ‖v i‖ ≤ 1),
      wcLtcRedVec ℓ n r v i = PadicInt.toZModPow n (⟨v i, h⟩ : ℤ_[ℓ]) := by
    intro v i h
    simp only [wcLtcRedVec, dif_pos h]
  have hr0 : wcLtcRedVec ℓ n r 0 = 0 := by
    funext i
    have h : ‖(0 : Fin r → ℚ_[ℓ]) i‖ ≤ 1 := by simp
    have e : @Eq ℤ_[ℓ] ⟨(0 : Fin r → ℚ_[ℓ]) i, h⟩ (0 : ℤ_[ℓ]) :=
      Subtype.ext (by first | exact (PadicInt.coe_zero).symm | simp | rfl)
    rw [hred _ i h]
    exact (congrArg (PadicInt.toZModPow n) e).trans (map_zero _)
  have hradd : ∀ v w : Fin r → ℚ_[ℓ], (∀ i, ‖v i‖ ≤ 1) → (∀ i, ‖w i‖ ≤ 1) →
      wcLtcRedVec ℓ n r (v + w) = wcLtcRedVec ℓ n r v + wcLtcRedVec ℓ n r w := by
    intro v w hv hw
    funext i
    have hvw : ‖(v + w) i‖ ≤ 1 := (Padic.nonarchimedean _ _).trans (max_le (hv i) (hw i))
    show wcLtcRedVec ℓ n r (v + w) i = wcLtcRedVec ℓ n r v i + wcLtcRedVec ℓ n r w i
    have e : @Eq ℤ_[ℓ] ⟨(v + w) i, hvw⟩
        (@HAdd.hAdd ℤ_[ℓ] ℤ_[ℓ] ℤ_[ℓ] _ ⟨v i, hv i⟩ ⟨w i, hw i⟩) := by
      apply Subtype.ext
      exact (PadicInt.coe_add (⟨v i, hv i⟩ : ℤ_[ℓ]) (⟨w i, hw i⟩ : ℤ_[ℓ])).symm
    rw [hred _ i hvw, hred _ i (hv i), hred _ i (hw i)]
    exact (congrArg (PadicInt.toZModPow n) e).trans (map_add _ _ _)
  have hr4 : Continuous (wcLtcRedVec ℓ n r) := by
    apply continuous_pi
    intro i
    apply IsLocallyConstant.continuous
    rw [IsLocallyConstant.iff_exists_open]
    intro v
    by_cases hv : ‖v i‖ ≤ 1
    · refine ⟨(fun w : Fin r → ℚ_[ℓ] => w i) ⁻¹' Metric.ball (v i) ((ℓ:ℝ) ^ (-(n:ℤ))),
        Metric.isOpen_ball.preimage (continuous_apply i),
        Metric.mem_ball_self (zpow_pos hℓpos _), fun w hw => ?_⟩
      have hw' : ‖w i - v i‖ < (ℓ:ℝ) ^ (-(n:ℤ)) := by
        have := Metric.mem_ball.mp hw
        rwa [dist_eq_norm] at this
      have hwi : ‖w i‖ ≤ 1 := by
        have e : w i = v i + (w i - v i) := by abel
        rw [e]
        exact (Padic.nonarchimedean _ _).trans (max_le hv (hw'.le.trans hrad1))
      rw [hred w i hwi, hred v i hv]
      have key : ∀ a b : ℤ_[ℓ], ‖(a : ℚ_[ℓ]) - b‖ ≤ (ℓ:ℝ) ^ (-(n:ℤ)) →
          PadicInt.toZModPow n a = PadicInt.toZModPow n b := by
        intro a b hab
        rw [← sub_eq_zero, ← map_sub]
        apply (hker _).1
        rw [PadicInt.coe_sub]
        exact hab
      exact key _ _ hw'.le
    · refine ⟨(fun w : Fin r → ℚ_[ℓ] => w i) ⁻¹' {c | 1 < ‖c‖},
        (isOpen_lt continuous_const continuous_norm).preimage (continuous_apply i),
        lt_of_not_ge hv, fun w hw => ?_⟩
      have hw' : ¬ ‖w i‖ ≤ 1 := not_le.mpr hw
      simp only [wcLtcRedVec, dif_neg hw', dif_neg hv]

  have hFV0 : ∀ (T : (wcP1Over K).left.ProEt) (e : T.left ⟶ V n) (t : T.left),
      wcLtcFrameVal (0 : (wcLtcTwPre (q n ≫ Uo.ι) Zr
        (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).obj (Opposite.op T)) e t = 0 := by
    intro T e t
    unfold wcLtcFrameVal
    split <;> rfl
  have hFVadd : ∀ (T : (wcP1Over K).left.ProEt)
      (u u' : (wcLtcTwPre (q n ≫ Uo.ι) Zr
        (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).obj (Opposite.op T))
      (e : T.left ⟶ V n) (t : T.left),
      wcLtcFrameVal (u + u') e t = wcLtcFrameVal u e t + wcLtcFrameVal u' e t := by
    intro T u u' e t
    unfold wcLtcFrameVal
    split
    · rfl
    · exact (add_zero 0).symm
  have hnatF : ∀ (T T' : (wcP1Over K).left.ProEt) (k : T' ⟶ T)
      (u : (wcLtcTwPre (q n ≫ Uo.ι) Zr
        (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).obj (Opposite.op T))
      (e : T.left ⟶ V n) (he : e ≫ q n ≫ Uo.ι = T.hom) (z : T'.left),
      wcLtcFrameVal (((wcLtcTwPre (q n ≫ Uo.ι) Zr
        (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).map k.op).hom u)
        (k.left ≫ e) z = wcLtcFrameVal u e (k.left z) := by
    intro T T' k u e he z
    have he' : (k.left ≫ e) ≫ q n ≫ Uo.ι = T'.hom := by
      rw [Category.assoc, he]; exact MorphismProperty.Over.w k
    have hmor : (Limits.pullback.lift (𝟙 T'.left) (k.left ≫ e) ((Category.id_comp _).trans he'.symm) :
          T'.left ⟶ (wcPbFun (q n ≫ Uo.ι)).obj T') ≫
        (wcPbFun (q n ≫ Uo.ι)).map k =
        k.left ≫ (Limits.pullback.lift (𝟙 T.left) e ((Category.id_comp _).trans he.symm) :
          T.left ⟶ (wcPbFun (q n ≫ Uo.ι)).obj T) := by
      apply Limits.pullback.hom_ext
      · simp only [wcPbFun, Functor.comp_map, Over.forget_map, Over.pullback_map_left]
        repeat (first | rw [Category.assoc] | erw [Limits.pullback.lift_fst_assoc] |
          erw [Limits.pullback.lift_fst] | rw [Category.id_comp] | rw [Category.comp_id])
        exact (Category.id_comp _).trans (Category.comp_id _).symm
      · simp only [wcPbFun, Functor.comp_map, Over.forget_map, Over.pullback_map_left]
        repeat (first | rw [Category.assoc] | erw [Limits.pullback.lift_snd_assoc] |
          erw [Limits.pullback.lift_snd])
    have hpt : (wcPbFun (q n ≫ Uo.ι)).map k
        ((Limits.pullback.lift (𝟙 T'.left) (k.left ≫ e) ((Category.id_comp _).trans he'.symm) :
          T'.left ⟶ (wcPbFun (q n ≫ Uo.ι)).obj T') z) =
        (Limits.pullback.lift (𝟙 T.left) e ((Category.id_comp _).trans he.symm) :
          T.left ⟶ (wcPbFun (q n ≫ Uo.ι)).obj T) (k.left z) := by
      have := congrArg (fun φ : T'.left ⟶ (wcPbFun (q n ≫ Uo.ι)).obj T => φ z) hmor
      exact (Scheme.Hom.comp_apply _ _ z).symm.trans (this.trans (Scheme.Hom.comp_apply _ _ z))
    unfold wcLtcFrameVal
    rw [dif_pos he', dif_pos he]
    exact congrArg (fun y => (show C(↥(Limits.pullback T.hom (q n ≫ Uo.ι)), Fin r → ZMod (ℓ ^ n))
      from u.1.1.down) y) hpt
  have hSnat : ∀ (T T' : (wcP1Over K).left.ProEt) (k : T' ⟶ T)
      (u : (wcLtcTwPre (q n ≫ Uo.ι) Zr
        (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).obj (Opposite.op T)),
      ((toSheafify (Scheme.ProEt.topology (wcP1Over K).left)
        (wcLtcTwPre (q n ≫ Uo.ι) Zr
          (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n))).app (Opposite.op T')).hom
        (((wcLtcTwPre (q n ≫ Uo.ι) Zr
          (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).map k.op).hom u) =
      ((wcTwSh (q n ≫ Uo.ι) Zr
        (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).obj.map k.op).hom
        (((toSheafify (Scheme.ProEt.topology (wcP1Over K).left)
          (wcLtcTwPre (q n ≫ Uo.ι) Zr
            (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n))).app (Opposite.op T)).hom u) :=
    fun T T' k u => congrArg (fun φ => φ.hom u)
      ((toSheafify (Scheme.ProEt.topology (wcP1Over K).left)
        (wcLtcTwPre (q n ≫ Uo.ι) Zr
          (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n))).naturality k.op)

  have hcomp : ∀ (T' : (wcP1Over K).left.ProEt) (a b : T' ⟶ W) (x : G.obj.obj (Opposite.op T')),
      (∀ z i, ‖wcLtcVal θ a x z i‖ ≤ 1) → (∀ z i, ‖wcLtcVal θ b x z i‖ ≤ 1) →
      ∀ u₁ u₂ : (wcLtcTwPre (q n ≫ Uo.ι) Zr
        (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).obj (Opposite.op T'),
      (∀ t, wcLtcFrameVal u₁ (a.left ≫ fr n) t = wcLtcRedVec ℓ n r (wcLtcVal θ a x t)) →
      (∀ t, wcLtcFrameVal u₂ (b.left ≫ fr n) t = wcLtcRedVec ℓ n r (wcLtcVal θ b x t)) →
      u₁ = u₂ :=
    fun T' a b x ha hb u₁ u₂ h₁ h₂ => wc_ltc_glue_compat Uo.ι (q n) Zr ℓ n r (α n) (hα n)
      (hcov n hn) G W θ N (hNlc n) hTR (fr n) (hf n) (htrans n) T' a b x ha hb u₁ u₂ h₁ h₂

  have H1 : ∀ (T : (wcP1Over K).left.ProEt) (s : ↥(wcLtcA Zr θ T)), ∃ R : Sieve T,
      R ∈ Scheme.ProEt.topology (wcP1Over K).left T ∧
        ∀ (T' : (wcP1Over K).left.ProEt) (c : T' ⟶ T), R.arrows c → ∃ y,
          wcLtcGlueRel Zr θ (q n ≫ Uo.ι) (wcLtcGam.{u} ℓ r n) (α n) (hα n) n
            (wcLtcRho.{u} ℓ r n) (fr n) T T' c s y := by
    intro T s
    by_cases hT : ∀ t, T.hom t ∉ Zr
    · obtain ⟨P, p, b, hcovP, -, -, -⟩ := wc_ltc_W_cover (wcP1Over K).left Zr W hWqc hWs T hT
      refine ⟨_, hcovP, fun T' c hc => ?_⟩
      obtain ⟨Y, h₀, g₀, hg₀, rfl⟩ := hc
      cases hg₀
      have hT' := hTo (h₀ ≫ p) hT
      have he : ((h₀ ≫ b).left ≫ fr n) ≫ q n ≫ Uo.ι = T'.hom := by
        rw [Category.assoc, hf n]; exact MorphismProperty.Over.w _
      obtain ⟨u, hu⟩ := wc_ltc_tw_frame_exists Uo.ι (q n) Zr (wcLtcGam.{u} ℓ r n) (α n) (hα n)
        (hcov n hn) ℓ n r (wcLtcRho.{u} ℓ r n) T' hT' ((h₀ ≫ b).left ≫ fr n) he
        ⟨fun t => wcLtcRedVec ℓ n r (wcLtcVal θ (h₀ ≫ b) ((G.obj.map (h₀ ≫ p).op).hom s.1) t),
          hr4.comp (hvcont T' (h₀ ≫ b) _)⟩
      exact ⟨_, Or.inr ⟨hT, h₀ ≫ b, u, fun t => hu t, rfl⟩⟩
    · exact ⟨⊤, (Scheme.ProEt.topology (wcP1Over K).left).top_mem T,
        fun T' c _ => ⟨0, Or.inl ⟨((memA T s.1).1 s.2).2 hT, rfl⟩⟩⟩

  have H2 : ∀ (T T' : (wcP1Over K).left.ProEt) (c : T' ⟶ T) (s : ↥(wcLtcA Zr θ T))
      (y y' : (wcTwSh (q n ≫ Uo.ι) Zr
        (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).obj.obj (Opposite.op T')),
      wcLtcGlueRel Zr θ (q n ≫ Uo.ι) (wcLtcGam.{u} ℓ r n) (α n) (hα n) n
        (wcLtcRho.{u} ℓ r n) (fr n) T T' c s y →
      wcLtcGlueRel Zr θ (q n ≫ Uo.ι) (wcLtcGam.{u} ℓ r n) (α n) (hα n) n
        (wcLtcRho.{u} ℓ r n) (fr n) T T' c s y' → y = y' := by
    intro T T' c s y y' hy hy'
    have hz : ∀ (b' : T' ⟶ W) (u : (wcLtcTwPre (q n ≫ Uo.ι) Zr
        (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).obj (Opposite.op T')),
        s.1 = 0 →
        (∀ t, wcLtcFrameVal u (b'.left ≫ fr n) t =
          wcLtcRedVec ℓ n r (wcLtcVal θ b' ((G.obj.map c.op).hom s.1) t)) → u = 0 := by
      intro b' u hs hu
      have h0 : ∀ t, wcLtcVal θ b' ((G.obj.map c.op).hom s.1) t = 0 := by
        intro t; rw [hs, map_zero]; exact hv0 T' b' t
      refine hcomp T' b' b' _ (fun z i => by rw [h0]; simp) (fun z i => by rw [h0]; simp)
        u 0 hu (fun t => ?_)
      rw [hFV0, h0, hr0]
    rcases hy with ⟨hs, rfl⟩ | ⟨hT, b₁, u₁, hu₁, rfl⟩ <;>
      rcases hy' with ⟨hs', rfl⟩ | ⟨hT', b₂, u₂, hu₂, rfl⟩
    · rfl
    · rw [hz b₂ u₂ hs hu₂, map_zero]; rfl
    · rw [hz b₁ u₁ hs' hu₁, map_zero]; rfl
    · have hint := ((memA T s.1).1 s.2).1 hT
      rw [hcomp T' b₁ b₂ _ (fun z i => hint T' c b₁ z i) (fun z i => hint T' c b₂ z i)
        u₁ u₂ hu₁ hu₂]

  have H3 : ∀ (T T' T'' : (wcP1Over K).left.ProEt) (c : T' ⟶ T) (d : T'' ⟶ T')
      (s : ↥(wcLtcA Zr θ T))
      (y : (wcTwSh (q n ≫ Uo.ι) Zr
        (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).obj.obj (Opposite.op T')),
      wcLtcGlueRel Zr θ (q n ≫ Uo.ι) (wcLtcGam.{u} ℓ r n) (α n) (hα n) n
        (wcLtcRho.{u} ℓ r n) (fr n) T T' c s y →
      wcLtcGlueRel Zr θ (q n ≫ Uo.ι) (wcLtcGam.{u} ℓ r n) (α n) (hα n) n
        (wcLtcRho.{u} ℓ r n) (fr n) T T'' (d ≫ c) s
        (((wcTwSh (q n ≫ Uo.ι) Zr
          (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).obj.map d.op).hom y) := by
    intro T T' T'' c d s y hy
    rcases hy with ⟨hs, rfl⟩ | ⟨hT, b', u, hu, rfl⟩
    · exact Or.inl ⟨hs, map_zero _⟩
    · refine Or.inr ⟨hT, d ≫ b', ((wcLtcTwPre (q n ≫ Uo.ι) Zr
          (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).map d.op).hom u,
          fun t => ?_, (hSnat T' T'' d u).symm⟩
      have he : (b'.left ≫ fr n) ≫ q n ≫ Uo.ι = T'.hom := by
        rw [Category.assoc, hf n]; exact MorphismProperty.Over.w b'
      have hl : (d ≫ b').left ≫ fr n = d.left ≫ (b'.left ≫ fr n) := by
        rw [← Category.assoc]; rfl
      rw [hl, hnatF T' T'' d u _ he t, hu, hGc, hv1]

  have H4 : ∀ (T T' : (wcP1Over K).left.ProEt) (c : T' ⟶ T) (s s' : ↥(wcLtcA Zr θ T))
      (y y' : (wcTwSh (q n ≫ Uo.ι) Zr
        (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).obj.obj (Opposite.op T')),
      wcLtcGlueRel Zr θ (q n ≫ Uo.ι) (wcLtcGam.{u} ℓ r n) (α n) (hα n) n
        (wcLtcRho.{u} ℓ r n) (fr n) T T' c s y →
      wcLtcGlueRel Zr θ (q n ≫ Uo.ι) (wcLtcGam.{u} ℓ r n) (α n) (hα n) n
        (wcLtcRho.{u} ℓ r n) (fr n) T T' c s' y' →
      wcLtcGlueRel Zr θ (q n ≫ Uo.ι) (wcLtcGam.{u} ℓ r n) (α n) (hα n) n
        (wcLtcRho.{u} ℓ r n) (fr n) T T' c (s + s') (y + y') := by
    intro T T' c s s' y y' hy hy'
    rcases hy' with ⟨hs', rfl⟩ | hy'
    · have h0 : s' = 0 := Subtype.ext hs'
      subst h0
      rw [add_zero, add_zero]
      exact hy
    rcases hy with ⟨hs, rfl⟩ | ⟨hT, b₁, u₁, hu₁, rfl⟩
    · have h0 : s = 0 := Subtype.ext hs
      subst h0
      rw [zero_add, zero_add]
      exact Or.inr hy'
    obtain ⟨-, b₂, u₂, hu₂, rfl⟩ := hy'
    have hint := ((memA T s.1).1 s.2).1 hT
    have hint' := ((memA T s'.1).1 s'.2).1 hT
    have hT' := hTo c hT
    have he₁ : (b₁.left ≫ fr n) ≫ q n ≫ Uo.ι = T'.hom := by
      rw [Category.assoc, hf n]; exact MorphismProperty.Over.w b₁
    obtain ⟨u₃, hu₃⟩ := wc_ltc_tw_frame_exists Uo.ι (q n) Zr (wcLtcGam.{u} ℓ r n) (α n) (hα n)
      (hcov n hn) ℓ n r (wcLtcRho.{u} ℓ r n) T' hT' (b₁.left ≫ fr n) he₁
      ⟨fun t => wcLtcRedVec ℓ n r (wcLtcVal θ b₁ ((G.obj.map c.op).hom s'.1) t),
        hr4.comp (hvcont T' b₁ _)⟩
    have hu₃' : ∀ t, wcLtcFrameVal u₃ (b₁.left ≫ fr n) t =
        wcLtcRedVec ℓ n r (wcLtcVal θ b₁ ((G.obj.map c.op).hom s'.1) t) := fun t => hu₃ t
    have h23 : u₂ = u₃ := hcomp T' b₂ b₁ _ (fun z i => hint' T' c b₂ z i)
      (fun z i => hint' T' c b₁ z i) u₂ u₃ hu₂ hu₃'
    subst h23
    refine Or.inr ⟨hT, b₁, u₁ + u₂, fun t => ?_, (map_add _ _ _).symm⟩
    rw [hFVadd, hu₁, hu₃', show (s + s').1 = s.1 + s'.1 from rfl, map_add, hvadd,
      hradd _ _ (fun i => hint T' c b₁ t i) (fun i => hint' T' c b₁ t i)]

  have H5 : ∀ (T T₂ T' : (wcP1Over K).left.ProEt) (g : T ⟶ T₂) (c : T' ⟶ T)
      (s : ↥(wcLtcA Zr θ T₂))
      (y : (wcTwSh (q n ≫ Uo.ι) Zr
        (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).obj.obj (Opposite.op T')),
      wcLtcGlueRel Zr θ (q n ≫ Uo.ι) (wcLtcGam.{u} ℓ r n) (α n) (hα n) n
        (wcLtcRho.{u} ℓ r n) (fr n) T₂ T' (c ≫ g) s y →
      wcLtcGlueRel Zr θ (q n ≫ Uo.ι) (wcLtcGam.{u} ℓ r n) (α n) (hα n) n
        (wcLtcRho.{u} ℓ r n) (fr n) T T' c (((wcLtcLpre Zr θ).map g.op).hom s) y := by
    intro T T₂ T' g c s y hy
    rcases hy with ⟨hs, rfl⟩ | ⟨hT, b', u, hu, rfl⟩
    · refine Or.inl ⟨?_, rfl⟩
      show (G.obj.map g.op).hom s.1 = 0
      rw [hs, map_zero]
    · refine Or.inr ⟨hTo g hT, b', u, fun t => ?_, rfl⟩
      rw [hu, hGc]
      rfl
  obtain ⟨Pn, hPn⟩ := wc_ltc_glue_package (wcP1Over K).left (wcLtcLpre Zr θ)
    (wcTwSh (q n ≫ Uo.ι) Zr (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n))
    (fun T T' c s y => wcLtcGlueRel Zr θ (q n ≫ Uo.ι) (wcLtcGam.{u} ℓ r n) (α n) (hα n) n
      (wcLtcRho.{u} ℓ r n) (fr n) T T' c s y) H1 H2 H3 H4 H5
  exact ⟨Pn, fun T T' c b' s u hT hfv => hPn T T' c s _ (Or.inr ⟨hT, b', u, hfv, rfl⟩)⟩

theorem wc_ltc_pi_exists (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    (W : (wcP1Over K).left.ProEt) (r : ℕ)
    (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).over W)
    (hθ : ∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology (wcP1Over K).left).overPullback
          AddCommGrpCat.{u+1} W).map (σ c) ≫ θ.hom =
        θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over K).left).overPullback
          AddCommGrpCat.{u+1} W).map (wcConstScalar (wcP1Over K).left ℓ r c))
    (hWqc : QuasiCompact W.hom)
    (hWU : ∀ z : W.left, W.hom z ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K)))
    (hWs : ∀ p : (wcP1Over K).left, p ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K)) →
        ∃ z : W.left, W.hom z = p)
    (N : ↥(Limits.pullback W.hom W.hom) → GL (Fin r) ℤ_[ℓ])
    (hNlc : ∀ n : ℕ, IsLocallyConstant (fun x => wcLtcRed.{u} ℓ n r (N x)))
    (hTR : ∀ (T : (wcP1Over K).left.ProEt) (a b : T ⟶ W) (s : G.obj.obj (Opposite.op T))
          (z : T.left),
        wcLtcVal θ a s z = Matrix.vecMul (wcLtcVal θ b s z)
          ((N (wcLtcPair a b z) : Matrix (Fin r) (Fin r) ℤ_[ℓ]).map
            (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ]))))
    (hNdiag : ∀ (T : (wcP1Over K).left.ProEt) (a : T ⟶ W) (z : T.left), N (wcLtcPair a a z) = 1)
    (hNcoc : ∀ (T : (wcP1Over K).left.ProEt) (a b c : T ⟶ W) (z : T.left),
        N (wcLtcPair a c z) = N (wcLtcPair b c z) * N (wcLtcPair a b z))
    (V : ℕ → Scheme.{u}) (q : (n : ℕ) → V n ⟶ Uo.toScheme)
    (α : (n : ℕ) → wcLtcGam.{u} ℓ r n →* Aut (V n))
    (hα : ∀ n γ, (α n γ).hom ≫ q n ≫ Uo.ι = q n ≫ Uo.ι)
    (fr : (n : ℕ) → W.left ⟶ V n) (hf : ∀ n, fr n ≫ q n ≫ Uo.ι = W.hom)
    (hcov : ∀ n, 1 ≤ n → wcGalCover (q n) (wcLtcGam.{u} ℓ r n) (α n))
    (htrans : ∀ (n : ℕ) (T : (wcP1Over K).left.ProEt) (a b : T ⟶ W)
        (γ : wcLtcGam.{u} ℓ r n),
        (∀ z : T.left, wcLtcRed.{u} ℓ n r (N (wcLtcPair a b z)) = γ) →
        b.left ≫ fr n = a.left ≫ fr n ≫ (α n γ).hom)
    (n : ℕ) (hn : 1 ≤ n) :
    ∃ Pn : wcLtcLpre (Set.range (fun i => S i (IsLocalRing.closedPoint K))) θ ⟶
        (wcTwSh (q n ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
          (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).obj,
      (∀ (T : (wcP1Over K).left.ProEt)
          (s s' : ↥(wcLtcA (Set.range (fun i => S i (IsLocalRing.closedPoint K))) θ T)),
          s'.1 = ((σ ((ℓ : ℚ_[ℓ]) ^ n)).hom.app (Opposite.op T)).hom s.1 →
          (Pn.app (Opposite.op T)).hom s' = 0) ∧
      (∀ (T : (wcP1Over K).left.ProEt)
          (s : ↥(wcLtcA (Set.range (fun i => S i (IsLocalRing.closedPoint K))) θ T)),
          (Pn.app (Opposite.op T)).hom s = 0 →
          ∃ s'' : ↥(wcLtcA (Set.range (fun i => S i (IsLocalRing.closedPoint K))) θ T),
            ((σ ((ℓ : ℚ_[ℓ]) ^ n)).hom.app (Opposite.op T)).hom s''.1 = s.1) ∧
      (∀ (T : (wcP1Over K).left.ProEt)
          (y : (wcTwSh (q n ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
            (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).obj.obj (Opposite.op T)),
          ∃ R : Sieve T, R ∈ Scheme.ProEt.topology (wcP1Over K).left T ∧
            ∀ (T' : (wcP1Over K).left.ProEt) (g : T' ⟶ T), R.arrows g →
              ∃ s, (Pn.app (Opposite.op T')).hom s =
                ((wcTwSh (q n ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
                  (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n)).obj.map g.op).hom y) :=
by
  classical
  haveI : NeZero (ℓ ^ n) := ⟨pow_ne_zero n (Fact.out : Nat.Prime ℓ).ne_zero⟩
  obtain ⟨hv1, hv2, -, hv4⟩ := wc_ltc_val_api (wcP1Over K).left ℓ r G σ W θ hθ
  have hcs := wc_proet_cover_surj_quotient (wcP1Over K).left
  obtain ⟨Pn, hχ⟩ := wc_ltc_pi_glue K hP ℓ m S hS G σ hσ1 hσadd hσmul Uo hUo W r θ hθ hWqc hWU hWs
    N hNlc hTR hNdiag hNcoc V q α hα fr hf hcov htrans n hn
  have hℓpos : (0:ℝ) < ℓ := by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos
  have hℓ1 : (1:ℝ) ≤ ℓ := by exact_mod_cast (Fact.out : Nat.Prime ℓ).one_lt.le
  have hrad1 : (ℓ:ℝ) ^ (-(n:ℤ)) ≤ 1 := zpow_le_one_of_nonpos₀ hℓ1 (by omega)

  have hnat : ∀ (c : ℚ_[ℓ]) (T T' : (wcP1Over K).left.ProEt) (h : T' ⟶ T)
      (x : G.obj.obj (Opposite.op T)),
      (G.obj.map h.op).hom (((σ c).hom.app (Opposite.op T)).hom x) =
        ((σ c).hom.app (Opposite.op T')).hom ((G.obj.map h.op).hom x) := by
    intro c T T' h x
    exact (congrArg (fun φ => φ.hom x) ((σ c).hom.naturality h.op)).symm
  have hσapp : ∀ (a b : ℚ_[ℓ]) (T : (wcP1Over K).left.ProEt) (x : G.obj.obj (Opposite.op T)),
      ((σ (a * b)).hom.app (Opposite.op T)).hom x =
        ((σ a).hom.app (Opposite.op T)).hom (((σ b).hom.app (Opposite.op T)).hom x) := by
    intro a b T x
    rw [hσmul] <;> rfl
  have hσ1app : ∀ (T : (wcP1Over K).left.ProEt) (x : G.obj.obj (Opposite.op T)),
      ((σ 1).hom.app (Opposite.op T)).hom x = x := by
    intro T x
    rw [hσ1] <;> rfl
  have hTo : ∀ {T T' : (wcP1Over K).left.ProEt} (k : T' ⟶ T),
      (∀ t, T.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K))) →
      ∀ t, T'.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K)) := by
    intro T T' k h t
    rw [← MorphismProperty.Over.w k, Scheme.Hom.comp_apply]
    exact h _
  have memA : ∀ (T : (wcP1Over K).left.ProEt) (x : G.obj.obj (Opposite.op T)),
      x ∈ wcLtcA (Set.range (fun i => S i (IsLocalRing.closedPoint K))) θ T ↔
      (((∀ t, T.hom t ∉ (Set.range (fun i => S i (IsLocalRing.closedPoint K)))) →
        ∀ (T'' : (wcP1Over K).left.ProEt) (h : T'' ⟶ T) (b : T'' ⟶ W)
        (z : T''.left) (i : Fin r), ‖wcLtcVal θ b ((G.obj.map h.op).hom x) z i‖ ≤ 1) ∧
      ((¬ ∀ t, T.hom t ∉ (Set.range (fun i => S i (IsLocalRing.closedPoint K)))) → x = 0)) :=
    fun _ _ => Iff.rfl
  have hA0 : ∀ (T : (wcP1Over K).left.ProEt),
      (¬ ∀ t, T.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K))) →
      ∀ s : ↥(wcLtcA (Set.range (fun i => S i (IsLocalRing.closedPoint K))) θ T), s = 0 :=
    fun T hT s => Subtype.ext (((memA T s.1).1 s.2).2 hT)
  have hE0 : ∀ (T : (wcP1Over K).left.ProEt),
