        H = (wcPbFun (q' ≫ ι)).map h := ⟨_, rfl⟩
    have hH1 : H ≫ Limits.pullback.fst ((wcEtToProEt X).obj V₁).hom (q' ≫ ι) =
        Limits.pullback.fst T.hom (q' ≫ ι) ≫ h.left := by
