        (yoneda.obj V' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op V)).hom
        e1).trans ((congrArg ((toSheafify (Scheme.ProEt.topology S)
        (yoneda.obj V' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op V)).hom
        e2.symm).trans h2))

  have hc_ex : ∀ V : Y'.ProEt, ∃ c : wcFreeSheaf Y' V ⟶
      (wcProEtPush ι).obj (wcFreeSheaf X' ((wcProEtPullback ι).obj V)),
