      rfl
    refine wc_cgev_coind_exact ℓ Γ N Rs _ act hact1 hactadd hactmul A π ?_ ?_ p y hy
    · intro a x
      show π (((lamP (MonoidAlgebra.single 1 a)).app (Opposite.op T)).hom x) = _
      rw [hPscal]
      exact hπs a x
    · have e : ∀ x (g : Γ), π (act (MonoidAlgebra.single g 1) x) =
