        (Functor.whiskerRight (yoneda.map f) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))
    have h2 := congrArg (fun φ => φ.hom
        (FreeAbelianGroup.of (ULift.up (𝟙 V')) : FreeAbelianGroup (ULift.{u+1} (V' ⟶ V'))))
