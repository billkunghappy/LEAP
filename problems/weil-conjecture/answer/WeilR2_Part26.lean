    obtain ⟨ι, hι⟩ := wc_P1bar_strict_local_lift F'' hP W w Nx.V g₀ Nx.A Nx.e hz
    obtain ⟨t, ht0, hts⟩ : ∃ t : ℕ → (wcGeomPoint F'' (wcP1Over F'') hP ⟶
