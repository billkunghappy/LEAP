      rw [hy]
      change (Limits.pullback.snd W.hom qb ≫ qb) (zb (IsLocalRing.closedPoint (AlgebraicClosure K))) = _
      rw [hzb2, ← Limits.pullback.condition]
      exact F4' z hz
    have hy6 := F6 y hi hiii
    have hy' : cbar ≫ W.hom = (wcFrE K e' ≫ y ≫ a) ≫ qb := by
      rw [F1, Category.assoc, Category.assoc, ha, hy6, ← Category.assoc, F5]
    have hk := key y zb (Limits.pullback.lift cbar _ hy') hzb1 hy.symm
      (Limits.pullback.lift_fst _ _ _) (by rw [Limits.pullback.lift_snd])
    rw [hzb2, hfix', ← hzb2] at hk
    have hz'zb := U _ _ (Limits.pullback.lift_fst _ _ _) hzb1 hk
    have hii : wcFrE K e' ≫ y ≫ a = y := by
      calc wcFrE K e' ≫ y ≫ a = Limits.pullback.lift cbar _ hy' ≫ Limits.pullback.snd W.hom qb :=
            (Limits.pullback.lift_snd _ _ _).symm
        _ = zb ≫ Limits.pullback.snd W.hom qb := by rw [hz'zb]
        _ = y := hy.symm
    refine ⟨⟨y, hi, hii, hiii⟩, ?_⟩
    have hl : Limits.pullback.lift cbar y (hyp ⟨y, hi, hii, hiii⟩) = zb :=
      Limits.pullback.hom_ext (by rw [Limits.pullback.lift_fst, hzb1])
        (by rw [Limits.pullback.lift_snd, hy])
    apply Subtype.ext
    apply Subtype.ext
    exact (congrArg (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure K))) hl).trans hzb2
  exact ⟨(Equiv.ofBijective β ⟨hinj, hsurj⟩).symm⟩

theorem wc_ratcoord_perm_trace (ℓ : ℕ) [Fact (Nat.Prime ℓ)] {M : Type (u+1)} [AddCommGroup M]
    (n : ℕ) (D : Fin n → Type u) [∀ j, Finite (D j)] (E : M ≃+ ((j : Fin n) → D j → ℤ_[ℓ]))
    (T : M → M) (π : ∀ j, D j → D j) (hT : ∀ x j d, E (T x) j d = E x j (π j d)) :
    ∃ (r₀ : ℕ) (ι₀ : M →+ (Fin r₀ → ℚ_[ℓ])) (A₀ : Matrix (Fin r₀) (Fin r₀) ℚ_[ℓ]),
      wcRatCoord ℓ ι₀ ∧ (∀ x, ι₀ (T x) = A₀.mulVec (ι₀ x)) ∧
      A₀.trace = ((∑ j, Nat.card {d : D j // π j d = d} : ℕ) : ℚ_[ℓ]) :=
by
  classical
  haveI : ∀ j, Fintype (D j) := fun j => Fintype.ofFinite _
  obtain ⟨r₀, ⟨ε⟩⟩ : ∃ r₀ : ℕ, Nonempty (((j : Fin n) × D j) ≃ Fin r₀) :=
    ⟨_, ⟨Finite.equivFin ((j : Fin n) × D j)⟩⟩

  let c : M → Fin r₀ → ℤ_[ℓ] := fun x k => E x (ε.symm k).1 (ε.symm k).2
  have hc_add : ∀ x y k, c (x + y) k = c x k + c y k := by
    intro x y k; simp [c, map_add]
  have hc_zero : ∀ x, (∀ k, c x k = 0) → x = 0 := by
    intro x hx
    apply E.injective
    rw [map_zero]
    funext j d
    have := hx (ε ⟨j, d⟩)
    simp only [c] at this
    rw [Equiv.symm_apply_apply] at this
    exact this
  have hc_surj : ∀ w : Fin r₀ → ℤ_[ℓ], ∃ x, ∀ k, c x k = w k := by
    intro w
    refine ⟨E.symm (fun j d => w (ε ⟨j, d⟩)), fun k => ?_⟩
    simp [c]
  have hℓpr : (ℓ).Prime := Fact.out
  have htf : ∀ x : M, ∀ k : ℕ, (ℓ ^ k : ℕ) • x = 0 → x = 0 := by
    intro x k hx
    apply hc_zero
    intro i
    have h1 : E ((ℓ ^ k : ℕ) • x) = 0 := by rw [hx, map_zero]
    rw [map_nsmul] at h1
    have h2 := congrFun (congrFun h1 (ε.symm i).1) (ε.symm i).2
    simp only [Pi.smul_apply, Pi.zero_apply, nsmul_eq_mul] at h2
    have hne : ((ℓ ^ k : ℕ) : ℤ_[ℓ]) ≠ 0 := by
      rw [Nat.cast_pow]
      exact pow_ne_zero _ (Nat.cast_ne_zero.mpr hℓpr.ne_zero)
    exact (mul_eq_zero.mp h2).resolve_left hne
  let ι₀ : M →+ (Fin r₀ → ℚ_[ℓ]) :=
    { toFun := fun x k => ((c x k : ℤ_[ℓ]) : ℚ_[ℓ])
      map_zero' := by funext k; simp [c]
      map_add' := by intro x y; funext k; simp [hc_add] }
  have hι : ∀ x k, ι₀ x k = ((c x k : ℤ_[ℓ]) : ℚ_[ℓ]) := fun _ _ => rfl
  have hℓ1 : (1 : ℝ) < ℓ := Nat.one_lt_cast.mpr hℓpr.one_lt
  have hℓpos : (0 : ℝ) < ℓ := by linarith
  have hnormℓ : ∀ k : ℕ, ‖((ℓ : ℚ_[ℓ]) ^ k)‖ = ((ℓ : ℝ)⁻¹) ^ k := by
    intro k; rw [norm_pow, Padic.norm_p]
  have hRat : wcRatCoord ℓ ι₀ := by
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro x
      constructor
      · intro hx
        refine ⟨0, ?_⟩
        have : x = 0 := by
          apply hc_zero
          intro k
          have := congrFun hx k
          rw [hι, Pi.zero_apply] at this
          exact PadicInt.coe_eq_zero.mp this
        simp [this]
      · rintro ⟨k, hk⟩
        rw [htf x k hk, map_zero]
    · intro v
      obtain ⟨K, hK⟩ := pow_unbounded_of_one_lt (∑ i, ‖v i‖) hℓ1
      have hbd : ∀ i, ‖((ℓ : ℚ_[ℓ]) ^ K) * v i‖ ≤ 1 := by
        intro i
        rw [norm_mul, hnormℓ]
        have hvi : ‖v i‖ ≤ ∑ i, ‖v i‖ :=
          Finset.single_le_sum (f := fun i => ‖v i‖) (fun i _ => norm_nonneg _) (Finset.mem_univ i)
        have hpos : (0 : ℝ) < (ℓ : ℝ) ^ K := pow_pos hℓpos K
        rw [inv_pow, inv_mul_le_iff₀ hpos, mul_one]
        linarith
      obtain ⟨x, hx⟩ := hc_surj (fun i => ⟨((ℓ : ℚ_[ℓ]) ^ K) * v i, hbd i⟩)
      refine ⟨K, x, ?_⟩
      funext i
      rw [hι, hx i]
      simp
    · intro x a
      obtain ⟨y, hy⟩ := hc_surj (fun k => a * c x k)
      refine ⟨y, ?_⟩
      funext k
      rw [hι, hy k]
      simp [hι]
    · intro x hx
      funext i
      by_contra hne
      have hpos : 0 < ‖ι₀ x i‖ := norm_pos_iff.mpr hne
      have hlt : (ℓ : ℝ)⁻¹ < 1 := inv_lt_one_of_one_lt₀ hℓ1
      obtain ⟨k, hk⟩ := exists_pow_lt_of_lt_one hpos hlt
      obtain ⟨y, hy⟩ := hx k
      have h1 : ι₀ x i = ((ℓ : ℚ_[ℓ]) ^ k) * ι₀ y i := by
        rw [hy]; rfl
      have h2 : ‖ι₀ x i‖ ≤ ((ℓ : ℝ)⁻¹) ^ k := by
        rw [h1, norm_mul, hnormℓ, hι]
        have : ‖((c y i : ℤ_[ℓ]) : ℚ_[ℓ])‖ ≤ 1 := by
          rw [← PadicInt.norm_def]; exact PadicInt.norm_le_one _
        exact mul_le_of_le_one_right (by positivity) this
      linarith

  let σ : Fin r₀ → Fin r₀ := fun k => ε ⟨(ε.symm k).1, π (ε.symm k).1 (ε.symm k).2⟩
  let A₀ : Matrix (Fin r₀) (Fin r₀) ℚ_[ℓ] := Matrix.of fun k k' => if k' = σ k then 1 else 0
  have hmul : ∀ v : Fin r₀ → ℚ_[ℓ], A₀.mulVec v = fun k => v (σ k) := by
    intro v
    funext k
    simp [A₀, Matrix.mulVec, dotProduct]
  refine ⟨r₀, ι₀, A₀, hRat, ?_, ?_⟩
  · intro x
    rw [hmul]
    funext k
    rw [hι, hι]
    simp only [c, σ, hT]
    rw [Equiv.symm_apply_apply]
  · rw [Matrix.trace]
    simp only [Matrix.diag, A₀, Matrix.of_apply]
    rw [← Equiv.sum_comp ε]
    have key : ∀ s : (j : Fin n) × D j, (if ε s = σ (ε s) then (1 : ℚ_[ℓ]) else 0) =
        if π s.1 s.2 = s.2 then 1 else 0 := by
      rintro ⟨j, d⟩
      have hσ : σ (ε ⟨j, d⟩) = ε ⟨j, π j d⟩ := by
        show ε ⟨(ε.symm (ε ⟨j, d⟩)).1, π (ε.symm (ε ⟨j, d⟩)).1 (ε.symm (ε ⟨j, d⟩)).2⟩ = _
        rw [Equiv.symm_apply_apply]
      simp only [hσ, EmbeddingLike.apply_eq_iff_eq, Sigma.mk.inj_iff, heq_eq_eq, true_and]
      by_cases h : π j d = d
      · simp [h]
      · have h' : d ≠ π j d := fun e => h e.symm
        simp [h, h']
    rw [Finset.sum_congr rfl (fun s _ => key s), Fintype.sum_sigma]
    push_cast
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype, Finset.sum_boole]

theorem wc_cover_boundary_count (K : Type u) [Field K] [Finite K] (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left)) (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V Y : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (qb : Y ⟶ (wcP1Over K).left) (jV : V ⟶ Y)
    (hpb : IsPullback jV q' qb Uo.ι) (a : Y ⟶ Y) (e : ℕ)
    (n : ℕ) (S' : Fin n → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hinj : Function.Injective (fun j => S' j (IsLocalRing.closedPoint K)))
    (hcov : ∀ i, ∃ j, S' j (IsLocalRing.closedPoint K) = S i (IsLocalRing.closedPoint K))
    (hS'S : ∀ j, ∃ i, S' j (IsLocalRing.closedPoint K) = S i (IsLocalRing.closedPoint K))
    (hfin : ∀ j, Finite {y : Spec (.of (AlgebraicClosure K)) ⟶ Y //
          y ≫ qb ≫ (wcP1Over K).hom = wcKbarPt K ∧ wcFrE K e ≫ y ≫ a = y ∧
          qb (y (IsLocalRing.closedPoint (AlgebraicClosure K))) = S' j (IsLocalRing.closedPoint K)}) :
    Nat.card {y : Spec (.of (AlgebraicClosure K)) ⟶ Y //
          y ≫ qb ≫ (wcP1Over K).hom = wcKbarPt K ∧ wcFrE K e ≫ y ≫ a = y ∧
          ¬ ∃ v : V, jV v = y (IsLocalRing.closedPoint (AlgebraicClosure K))} =
      ∑ j, Nat.card {y : Spec (.of (AlgebraicClosure K)) ⟶ Y //
          y ≫ qb ≫ (wcP1Over K).hom = wcKbarPt K ∧ wcFrE K e ≫ y ≫ a = y ∧
          qb (y (IsLocalRing.closedPoint (AlgebraicClosure K))) = S' j (IsLocalRing.closedPoint K)} :=
by
  classical
  have hR : Set.range jV = qb ⁻¹' (Uo : Set (wcP1Over K).left) := by
    have h := Scheme.image_preimage_eq_of_isPullback hpb.flip Set.univ
    rw [Set.preimage_univ, Set.image_univ, Set.image_univ, Scheme.Opens.range_ι] at h
    exact h
  have key : ∀ x : Y, (¬ ∃ v : V, jV v = x) ↔
      ∃ j, qb x = S' j (IsLocalRing.closedPoint K) := by
    intro x
    have h1 : (∃ v : V, jV v = x) ↔ qb x ∈ Uo := by
      have h2 : x ∈ Set.range jV ↔ x ∈ qb ⁻¹' (Uo : Set (wcP1Over K).left) := by rw [hR]
      rw [Set.mem_range, Set.mem_preimage, SetLike.mem_coe] at h2
      exact h2
    rw [h1, hUo]
    push_neg
    constructor
    · rintro ⟨i, hi⟩
      obtain ⟨j, hj⟩ := hcov i
      exact ⟨j, hi.trans hj.symm⟩
    · rintro ⟨j, hj⟩
      obtain ⟨i, hi⟩ := hS'S j
      exact ⟨i, hj.trans hi⟩
  let T : Fin n → Type u := fun j => {y : Spec (.of (AlgebraicClosure K)) ⟶ Y //
          y ≫ qb ≫ (wcP1Over K).hom = wcKbarPt K ∧ wcFrE K e ≫ y ≫ a = y ∧
          qb (y (IsLocalRing.closedPoint (AlgebraicClosure K))) = S' j (IsLocalRing.closedPoint K)}
  haveI hT : ∀ j, Finite (T j) := hfin
  let Φ : (Σ j, T j) → {y : Spec (.of (AlgebraicClosure K)) ⟶ Y //
          y ≫ qb ≫ (wcP1Over K).hom = wcKbarPt K ∧ wcFrE K e ≫ y ≫ a = y ∧
          ¬ ∃ v : V, jV v = y (IsLocalRing.closedPoint (AlgebraicClosure K))} :=
    fun p => ⟨p.2.1, p.2.2.1, p.2.2.2.1, (key _).mpr ⟨p.1, p.2.2.2.2⟩⟩
  have hΦi : Function.Injective Φ := by
    rintro ⟨j, y, h1, h2, h3⟩ ⟨j', y', h1', h2', h3'⟩ h
    have hy : y = y' := congrArg Subtype.val h
    subst hy
    have hj : j = j' := hinj (h3.symm.trans h3')
    subst hj
    rfl
  have hΦs : Function.Surjective Φ := by
    rintro ⟨y, h1, h2, h3⟩
    obtain ⟨j, hj⟩ := (key _).mp h3
    exact ⟨⟨j, y, h1, h2, hj⟩, rfl⟩
  have E := Equiv.ofBijective Φ ⟨hΦi, hΦs⟩
  calc Nat.card {y : Spec (.of (AlgebraicClosure K)) ⟶ Y //
          y ≫ qb ≫ (wcP1Over K).hom = wcKbarPt K ∧ wcFrE K e ≫ y ≫ a = y ∧
          ¬ ∃ v : V, jV v = y (IsLocalRing.closedPoint (AlgebraicClosure K))}
      = Nat.card (Σ j, T j) := (Nat.card_congr E).symm
    _ = ∑ j, Nat.card (T j) := Nat.card_sigma

theorem wc_cover_boundary_coh (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V Y : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (qb : Y ⟶ (wcP1Over K).left) (jV : V ⟶ Y)
    (hqb : IsFinite qb) (hjV : IsOpenImmersion jV) (hpb : IsPullback jV q' qb Uo.ι)
    (a : Y ⟶ Y) (ha : a ≫ qb = qb)
    (ιF : wcCoverSheaf (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ⟶
        wcCoverSheaf qb (∅ : Set (wcP1Over K).left) ℓ) (hmono : Mono ιF)
    (hsupp : ∀ W : (wcP1Over K).left.ProEt,
        (∀ (w : W.left) (i : Fin m), W.hom w ≠ S i (IsLocalRing.closedPoint K)) →
        ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left W) (Limits.cokernel ιF) 0, y = 0)
    (σD : Limits.cokernel ιF ⟶ Limits.cokernel ιF)
    (hσD : Limits.cokernel.π ιF ≫ σD =
      wcCoverAct qb (∅ : Set (wcP1Over K).left) ℓ a ha ≫ Limits.cokernel.π ιF)
    (e : ℕ) (he : 1 ≤ e) :
    (∀ y : wcCohG K (wcP1Over K) hP (Limits.cokernel ιF) 1, y = 0) ∧
    (∀ y : wcCohG K (wcP1Over K) hP (Limits.cokernel ιF) 2, y = 0) ∧
    ∃ (r₀ : ℕ) (ι₀ : wcCohG K (wcP1Over K) hP (Limits.cokernel ιF) 0 →+ (Fin r₀ → ℚ_[ℓ]))
      (A₀ : Matrix (Fin r₀) (Fin r₀) ℚ_[ℓ]), wcRatCoord ℓ ι₀ ∧
      (∀ x, ι₀ ((⇑(wcCohGFrob K (wcP1Over K) hP (Limits.cokernel ιF) 0))^[e]
          (wcCohGEnd K (wcP1Over K) hP (Limits.cokernel ιF) 0 σD x)) = A₀.mulVec (ι₀ x)) ∧
      A₀.trace = (Nat.card {y : Spec (.of (AlgebraicClosure K)) ⟶ Y //
          y ≫ qb ≫ (wcP1Over K).hom = wcKbarPt K ∧ wcFrE K e ≫ y ≫ a = y ∧
          ¬ ∃ v : V, jV v = y (IsLocalRing.closedPoint (AlgebraicClosure K))} : ℚ_[ℓ]) :=
by
  classical

  obtain ⟨ev, -, -⟩ := wc_free_ext0_eval (wcP1Over K).left
  have hK : ∀ (W : (wcP1Over K).left.ProEt),
      (∀ (w : W.left) (i : Fin m), W.hom w ≠ S i (IsLocalRing.closedPoint K)) →
      ∀ s : (Limits.cokernel ιF).obj.obj (Opposite.op W), s = 0 := by
    intro W hW s
    have h0 : (ev W (Limits.cokernel ιF)).symm s = 0 := hsupp W hW _
    rw [← (ev W (Limits.cokernel ιF)).apply_symm_apply s, h0, map_zero]
  have hE1 := wc_proet_P1_finite_supp_ext_vanish K hP m S hS (Limits.cokernel ιF) hK 1 le_rfl
  have hE2 := wc_proet_P1_finite_supp_ext_vanish K hP m S hS (Limits.cokernel ιF) hK 2
    (by norm_num)
  refine ⟨hE1, hE2, ?_⟩

  let L : Finset (wcP1Over K).left :=
    Finset.univ.image (fun i => S i (IsLocalRing.closedPoint K))
  have hpre : ∀ p : L, ∃ i, S i (IsLocalRing.closedPoint K) = p.1 := by
    intro p
    obtain ⟨i, -, hi⟩ := Finset.mem_image.mp p.2
    exact ⟨i, hi⟩
  choose f hf using hpre
  let S' : Fin L.card → (Spec (.of K) ⟶ (wcP1Over K).left) := fun j => S (f (L.equivFin.symm j))
  have hS'pt : ∀ j, S' j (IsLocalRing.closedPoint K) = (L.equivFin.symm j).1 := fun j => hf _
  have hS' : ∀ j, S' j ≫ (wcP1Over K).hom = 𝟙 _ := fun j => hS _
  have hSinj : Function.Injective (fun j => S' j (IsLocalRing.closedPoint K)) := by
    intro j j' h
    have h' : (L.equivFin.symm j).1 = (L.equivFin.symm j').1 := by
      rw [← hS'pt, ← hS'pt]; exact h
    exact L.equivFin.symm.injective (Subtype.ext h')
  have hcov : ∀ i, ∃ j, S' j (IsLocalRing.closedPoint K) = S i (IsLocalRing.closedPoint K) := by
    intro i
    refine ⟨L.equivFin ⟨S i (IsLocalRing.closedPoint K),
      Finset.mem_image_of_mem _ (Finset.mem_univ i)⟩, ?_⟩
    rw [hS'pt, Equiv.symm_apply_apply]
  have hS'S : ∀ j, ∃ i, S' j (IsLocalRing.closedPoint K) = S i (IsLocalRing.closedPoint K) :=
    fun j => ⟨f (L.equivFin.symm j), rfl⟩
  have hsupp' : ∀ W : (wcP1Over K).left.ProEt,
      (∀ (w : W.left) (j : Fin L.card), W.hom w ≠ S' j (IsLocalRing.closedPoint K)) →
      ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left W) (Limits.cokernel ιF) 0, y = 0 := by
    intro W hW
    apply hsupp W
    intro w i h
    obtain ⟨j, hj⟩ := hcov i
    exact hW w j (h.trans hj.symm)

  choose V₀ g₀ φ₀ A iR iH iS e₀ ε hx hφg hε hφε using
    fun j : Fin L.card => wc_P1bar_strict_local_nbhd K (S' j) (hS' j) hP

  obtain ⟨-, hQ0⟩ := wc_P1_punctual_coh K hP L.card S' hS' hSinj (Limits.cokernel ιF) hsupp'
  have hst := @hQ0 V₀ A iR iH iS e₀ hx g₀
  have hfun : ∀ {A₁ B₁ C₁ : (wcP1Over K).left.ProEt} (a₁ : A₁ ⟶ B₁) (b₁ : B₁ ⟶ C₁),
      wcFreeSheafMap (wcP1Over K).left a₁ ≫ wcFreeSheafMap (wcP1Over K).left b₁ =
        wcFreeSheafMap (wcP1Over K).left (a₁ ≫ b₁) := by
    intro A₁ B₁ C₁ a₁ b₁
    have e1 : Functor.whiskerRight (yoneda.map a₁) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerRight (yoneda.map b₁) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
        Functor.whiskerRight (yoneda.map (a₁ ≫ b₁))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
      rw [yoneda.map_comp, Functor.whiskerRight_comp]
    exact ((presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
      AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
      (congrArg (presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
        AddCommGrpCat.{u+1}).map e1)
  have hassoc : ∀ {X₁ X₂ X₃ X₄ : Sheaf (Scheme.ProEt.topology (wcP1Over K).left)
      AddCommGrpCat.{u+1}} (α : Abelian.Ext X₁ X₂ 0) (β : Abelian.Ext X₂ X₃ 0)
      (γ : Abelian.Ext X₃ X₄ 0),
      (α.comp β (add_zero 0)).comp γ (add_zero 0) = α.comp (β.comp γ (add_zero 0)) (add_zero 0) :=
    fun α β γ => Abelian.Ext.comp_assoc α β γ (add_zero 0) (add_zero 0) rfl
  have hmk : ∀ {X₁ X₂ X₃ : Sheaf (Scheme.ProEt.topology (wcP1Over K).left)
      AddCommGrpCat.{u+1}} (f₁ : X₁ ⟶ X₂) (g₁ : X₂ ⟶ X₃),
      (Abelian.Ext.mk₀ f₁).comp (Abelian.Ext.mk₀ g₁) (add_zero 0) = Abelian.Ext.mk₀ (f₁ ≫ g₁) :=
    fun f₁ g₁ => Abelian.Ext.mk₀_comp_mk₀ f₁ g₁
  let stH : wcCohG K (wcP1Over K) hP (Limits.cokernel ιF) 0 →+
      ((j : Fin L.card) → Abelian.Ext (wcFreeSheaf (wcP1Over K).left (V₀ j))
        (Limits.cokernel ιF) 0) :=
    Pi.addMonoidHom (fun j => (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (g₀ j))).precomp
      (Limits.cokernel ιF) (zero_add 0))
  have hstH : Function.Bijective stH := hst
  let τ := AddEquiv.ofBijective stH hstH
  let sW : ∀ j : Fin L.card,
      Abelian.Ext (wcFreeSheaf (wcP1Over K).left (V₀ j)) (Limits.cokernel ιF) 0 →+
        Abelian.Ext (wcFreeSheaf (wcP1Over K).left (V₀ j)) (Limits.cokernel ιF) 0 :=
    fun j => (Abelian.Ext.mk₀ σD).postcomp _ (add_zero 0)
  let ΦW : ∀ j : Fin L.card,
      Abelian.Ext (wcFreeSheaf (wcP1Over K).left (V₀ j)) (Limits.cokernel ιF) 0 →+
        Abelian.Ext (wcFreeSheaf (wcP1Over K).left (V₀ j)) (Limits.cokernel ιF) 0 :=
    fun j => (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (φ₀ j))).precomp _ (zero_add 0)
  have hτs : ∀ (v : wcCohG K (wcP1Over K) hP (Limits.cokernel ιF) 0) (j : Fin L.card),
      τ (wcCohGEnd K (wcP1Over K) hP (Limits.cokernel ιF) 0 σD v) j = sW j (τ v j) := by
    intro v j
    show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (g₀ j))).comp
        (v.comp (Abelian.Ext.mk₀ σD) (add_zero 0)) (zero_add 0) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (g₀ j))).comp v (zero_add 0)).comp
        (Abelian.Ext.mk₀ σD) (add_zero 0)
    rw [hassoc]
  have hτΦ : ∀ (v : wcCohG K (wcP1Over K) hP (Limits.cokernel ιF) 0) (j : Fin L.card),
      τ (wcCohGFrob K (wcP1Over K) hP (Limits.cokernel ιF) 0 v) j = ΦW j (τ v j) := by
    intro v j
    show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (g₀ j))).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP))).comp
          v (zero_add 0)) (zero_add 0) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (φ₀ j))).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (g₀ j))).comp v (zero_add 0))
        (zero_add 0)
    rw [← hassoc, ← hassoc, hmk, hmk, hfun, hfun, hφg j]
  have hτΦk : ∀ (k : ℕ) (v : wcCohG K (wcP1Over K) hP (Limits.cokernel ιF) 0) (j : Fin L.card),
      τ ((⇑(wcCohGFrob K (wcP1Over K) hP (Limits.cokernel ιF) 0))^[k] v) j =
        (⇑(ΦW j))^[k] (τ v j) := by
    intro k
    induction k with
    | zero => intro v j; rfl
    | succ k ih =>
      intro v j
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply', hτΦ, ih]

  let aQ : ∀ j : Fin L.card, Limits.pullback (V₀ j).hom qb ⟶ Limits.pullback (V₀ j).hom qb :=
    fun j => Limits.pullback.lift (Limits.pullback.fst (V₀ j).hom qb)
      (Limits.pullback.snd (V₀ j).hom qb ≫ a)
      (by rw [Category.assoc, ha, Limits.pullback.condition])
  have haQ1 : ∀ j, aQ j ≫ Limits.pullback.fst (V₀ j).hom qb = Limits.pullback.fst (V₀ j).hom qb :=
    fun j => Limits.pullback.lift_fst _ _ _
  have haQ2 : ∀ j, aQ j ≫ Limits.pullback.snd (V₀ j).hom qb =
      Limits.pullback.snd (V₀ j).hom qb ≫ a :=
    fun j => Limits.pullback.lift_snd _ _ _
  let φQ : ∀ j : Fin L.card, Limits.pullback (V₀ j).hom qb ⟶ Limits.pullback (V₀ j).hom qb :=
    fun j => Limits.pullback.lift (Limits.pullback.fst (V₀ j).hom qb ≫ (φ₀ j).left)
      (Limits.pullback.snd (V₀ j).hom qb)
      (by rw [Category.assoc, MorphismProperty.Over.w (φ₀ j), Limits.pullback.condition])
  have hφQ1 : ∀ j, φQ j ≫ Limits.pullback.fst (V₀ j).hom qb =
      Limits.pullback.fst (V₀ j).hom qb ≫ (φ₀ j).left :=
    fun j => Limits.pullback.lift_fst _ _ _
  have hφQ2 : ∀ j, φQ j ≫ Limits.pullback.snd (V₀ j).hom qb = Limits.pullback.snd (V₀ j).hom qb :=
    fun j => Limits.pullback.lift_snd _ _ _

  have hloc := fun j : Fin L.card => wc_cover_D_strict_eval K ℓ m S Uo q' qb a ha ιF hmono σD hσD
    (V₀ j) (A j) (instA := iR j) (henA := iH j) (sepA := iS j) (e₀ j)
    (f (L.equivFin.symm j)) (hx j) (aQ j) (haQ1 j) (haQ2 j) (φ₀ j) (φQ j) (hφQ1 j) (hφQ2 j)
  choose Ψ hΨs hΨΦ using hloc
  have hΨs' : ∀ (j : Fin L.card) y z, Ψ j (sW j y) z = Ψ j y (aQ j z) := hΨs
  have hΨΦ' : ∀ (j : Fin L.card) y z, Ψ j (ΦW j y) z = Ψ j y (φQ j z) := hΨΦ
  have hfib := fun j : Fin L.card => wc_strict_nbhd_fibre_perm K ℓ (S' j) (hS' j) (V₀ j) (A j)
    (instA := iR j) (henA := iH j) (sepA := iS j) (e₀ j) (ε j) (hx j) (hε j) (φ₀ j) (hφε j)
    qb hqb a ha (aQ j) (φQ j) (haQ1 j) (haQ2 j) (hφQ1 j) (hφQ2 j) e
  choose Dj hDfin ρ π hρ hFix using hfib
  haveI : ∀ j, Finite (Dj j) := hDfin
  have hΨk : ∀ (j : Fin L.card) (k : ℕ) y z,
      Ψ j ((⇑(ΦW j))^[k] y) z = Ψ j y ((fun p => φQ j p)^[k] z) := by
    intro j k
    induction k with
    | zero => intro y z; rfl
    | succ k ih =>
      intro y z
      rw [Function.iterate_succ_apply, ih, hΨΦ', Function.iterate_succ_apply']

  let Ecd : wcCohG K (wcP1Over K) hP (Limits.cokernel ιF) 0 ≃+
      ((j : Fin L.card) → Dj j → ℤ_[ℓ]) :=
    τ.trans (AddEquiv.piCongrRight (fun j => (Ψ j).trans (ρ j)))
  have hT : ∀ x (j : Fin L.card) (d : Dj j),
      Ecd ((⇑(wcCohGFrob K (wcP1Over K) hP (Limits.cokernel ιF) 0))^[e]
        (wcCohGEnd K (wcP1Over K) hP (Limits.cokernel ιF) 0 σD x)) j d = Ecd x j (π j d) := by
    intro x j d
    show ρ j (Ψ j (τ ((⇑(wcCohGFrob K (wcP1Over K) hP (Limits.cokernel ιF) 0))^[e]
        (wcCohGEnd K (wcP1Over K) hP (Limits.cokernel ιF) 0 σD x)) j)) d =
      ρ j (Ψ j (τ x j)) (π j d)
    apply hρ j
    intro z
    rw [hτΦk, hτs, hΨk, hΨs']
  obtain ⟨r₀, ι₀, A₀, hι₀, hA₀, htr⟩ := wc_ratcoord_perm_trace ℓ L.card Dj Ecd
    (fun x => (⇑(wcCohGFrob K (wcP1Over K) hP (Limits.cokernel ιF) 0))^[e]
      (wcCohGEnd K (wcP1Over K) hP (Limits.cokernel ιF) 0 σD x)) π hT
  refine ⟨r₀, ι₀, A₀, hι₀, hA₀, ?_⟩

  rw [htr, wc_cover_boundary_count K m S Uo hUo q' qb jV hpb a e L.card S' hSinj hcov hS'S
    (fun j => Finite.of_equiv _ (hFix j).some)]
  congr 1
  exact Finset.sum_congr rfl (fun j _ => Nat.card_congr (hFix j).some)

theorem wc_proet_push_finite_exact {X B : Scheme.{u}} (g : X ⟶ B) [IsFinite g]
    [LocallyOfFinitePresentation g] : Limits.PreservesFiniteColimits (wcProEtPush g) :=
by
  classical
  haveI hcont : (wcProEtBC g).IsContinuous (Scheme.ProEt.topology B) (Scheme.ProEt.topology X) :=
    (wc_proet_pullback_continuous_flat g).1

  have hsplit : ∀ (V : B.ProEt) (T : Sieve ((wcProEtBC g).obj V)),
      T ∈ Scheme.ProEt.topology X ((wcProEtBC g).obj V) →
      ∃ R : Presieve V, Sieve.generate R ∈ Scheme.ProEt.topology B V ∧
        ∀ ⦃W : B.ProEt⦄ (f : W ⟶ V), R f →
          ∃ (n : ℕ) (P : Fin n → X.ProEt) (ι : ∀ k, P k ⟶ (wcProEtBC g).obj W),
            (∀ k, IsOpenImmersion (ι k).left) ∧
            (∀ x : ((wcProEtBC g).obj W).left, ∃! k, x ∈ Set.range ⇑(ι k).left) ∧
            ∀ k, T (ι k ≫ (wcProEtBC g).map f) := by
    intro V T hT
    refine ⟨fun (W : B.ProEt) (_ : W ⟶ V) => IsAffine W.left ∧
        (IsClosed {x : W.left | IsClosed ({x} : Set W.left)} ∧
        (∀ x : W.left, ∃! y : W.left, IsClosed ({y} : Set W.left) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : W.left | IsClosed ({x} : Set W.left)} ∧
        (∀ x : W.left, IsClosed ({x} : Set W.left) →
          HenselianLocalRing (W.left.presheaf.stalk x) ∧ IsSepClosed (W.left.residueField x))),
      wc_proet_cover_of_affine_local (fun Δ => IsClosed {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, ∃! y : Δ, IsClosed ({y} : Set Δ) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, IsClosed ({x} : Set Δ) →
          HenselianLocalRing (Δ.presheaf.stalk x) ∧ IsSepClosed (Δ.residueField x)))
        (fun V₀ hV₀ => wc_exists_wcontractible_cover V₀ hV₀) V, ?_⟩
    intro W f hRf
    obtain ⟨hWa, q1, q2, q3, q4⟩ := hRf
    haveI : IsAffine W.left := hWa
    haveI : IsAffine ((𝟭 Scheme.{u}).obj W.left) := hWa
    have hUa : IsAffine (Limits.pullback W.hom g) :=
      isAffine_of_isAffineHom (Limits.pullback.fst W.hom g)
    obtain ⟨r1, r2, r3, r4⟩ :=
      wc_wlocal_strictHensel_finite_stable (Limits.pullback.fst W.hom g) hWa q1 q2 q3 q4
    have hRET := wc_wlocal_strictHensel_retraction (Limits.pullback W.hom g) hUa r1 r2 r3 r4
    have hT' : T.pullback ((wcProEtBC g).map f) ∈
        Scheme.ProEt.topology X ((wcProEtBC g).obj W) :=
      (Scheme.ProEt.topology X).pullback_stable _ hT
    obtain ⟨n, P, fk, hPa, hTfk, hsurj⟩ :=
      wc_proet_cover_affine_finite_refine ((wcProEtBC g).obj W) hUa _ hT'
    obtain ⟨m, Q, ι, hopen, huniq, hfac⟩ :=
      wc_ret_disjoint_open_refine ((wcProEtBC g).obj W) hUa hRET n P fk hPa hsurj
    refine ⟨m, Q, ι, hopen, huniq, fun j => ?_⟩
    obtain ⟨k, h, hh⟩ := hfac j
    have hj := (T.pullback ((wcProEtBC g).map f)).downward_closed (hTfk k) h
    rw [hh] at hj
    exact hj

  haveI hepi := wc_sheafPushforward_preservesEpi_of_split (wcProEtBC g) hsplit
  haveI hlim : Limits.PreservesFiniteLimits ((wcProEtBC g).sheafPushforwardContinuous
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology B) (Scheme.ProEt.topology X)) :=
    inferInstance
  haveI : ((wcProEtBC g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology B) (Scheme.ProEt.topology X)).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_preserves_terminal_object
  haveI : ((wcProEtBC g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology B) (Scheme.ProEt.topology X)).Additive :=
    Functor.additive_of_preserves_binary_products _
  haveI : ((wcProEtBC g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology B) (Scheme.ProEt.topology X)).PreservesHomology :=
    Functor.preservesHomology_of_preservesEpis_and_kernels _
  haveI hcolim : Limits.PreservesFiniteColimits ((wcProEtBC g).sheafPushforwardContinuous
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology B) (Scheme.ProEt.topology X)) :=
    Functor.preservesFiniteColimits_of_preservesHomology _

  let e : wcProEtPush g ≅ (wcProEtBC g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology B) (Scheme.ProEt.topology X) :=
    NatIso.ofComponents
      (fun F => (asIso (sheafificationAdjunction (Scheme.ProEt.topology B)
        AddCommGrpCat.{u+1}).counit).app (((wcProEtBC g).sheafPushforwardContinuous
          AddCommGrpCat.{u+1} (Scheme.ProEt.topology B) (Scheme.ProEt.topology X)).obj F))
      (fun φ => (sheafificationAdjunction (Scheme.ProEt.topology B)
        AddCommGrpCat.{u+1}).counit.naturality (((wcProEtBC g).sheafPushforwardContinuous
          AddCommGrpCat.{u+1} (Scheme.ProEt.topology B) (Scheme.ProEt.topology X)).map φ))

  exact Limits.preservesFiniteColimits_of_natIso e.symm

theorem wc_push_free_norm_exists {Y' X' : Scheme.{u}} (ι : X' ⟶ Y')
    (L : Sheaf (Scheme.ProEt.topology Y') AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology X') AddCommGrpCat.{u+1})
    (adj : L ⊣ wcProEtPush ι) :
    ∃ θ : ∀ V : Y'.ProEt, L.obj (wcFreeSheaf Y' V) ≅ wcFreeSheaf X' ((wcProEtPullback ι).obj V),
      wcPushThetaNorm ι L adj θ ∧
      ∀ {V V' : Y'.ProEt} (f : V ⟶ V'),
        L.map (wcFreeSheafMap Y' f) ≫ (θ V').hom =
          (θ V).hom ≫ wcFreeSheafMap X' ((wcProEtPullback ι).map f) :=
by
  classical

  have hEv : ∀ (S : Scheme.{u}) (W : S.ProEt) (Q : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
      Function.Bijective (fun g : wcFreeSheaf S W ⟶ Q => (g.hom.app (Opposite.op W)).hom (wcFreeGen S W)) := by
    intro S W Q
    let P : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
    let γ : FreeAbelianGroup (ULift.{u+1} (W ⟶ W)) := FreeAbelianGroup.of (ULift.up (𝟙 W))
    have hext : ∀ {α B : Type (u+1)} [AddCommGroup B] (φ ψ : FreeAbelianGroup α →+ B),
        (∀ a, φ (FreeAbelianGroup.of a) = ψ (FreeAbelianGroup.of a)) → φ = ψ := by
      intro α B _ φ ψ h
      apply AddMonoidHom.ext
      intro z
      induction z using FreeAbelianGroup.induction_on with
      | zero => rw [map_zero, map_zero]
      | of a => exact h a
      | neg a ih => rw [map_neg, map_neg, ih]
      | add a b iha ihb => rw [map_add, map_add, iha, ihb]
    have hmap : ∀ (V V' : (S.ProEt)ᵒᵖ) (h : V ⟶ V') (a : ULift.{u+1} (V.unop ⟶ W)),
        (P.map h).hom (FreeAbelianGroup.of a) =
          (FreeAbelianGroup.of (ULift.up (h.unop ≫ a.down) : ULift.{u+1} (V'.unop ⟶ W)) :
            FreeAbelianGroup (ULift.{u+1} (V'.unop ⟶ W))) := by
      intro V V' h a
      exact FreeAbelianGroup.map_of_apply
        (f := fun g : ULift.{u+1} (V.unop ⟶ W) =>
          (ULift.up (h.unop ≫ g.down) : ULift.{u+1} (V'.unop ⟶ W))) a
    have hK : ∀ (η : P ⟶ Q.obj) (V : (S.ProEt)ᵒᵖ) (f : V.unop ⟶ W),
        (η.app V).hom (FreeAbelianGroup.of (ULift.up f : ULift.{u+1} (V.unop ⟶ W))) =
          (Q.obj.map f.op).hom ((η.app (Opposite.op W)).hom γ) := by
      intro η V f
      have e1 : (P.map f.op).hom γ =
          (FreeAbelianGroup.of (ULift.up f : ULift.{u+1} (V.unop ⟶ W)) :
            FreeAbelianGroup (ULift.{u+1} (V.unop ⟶ W))) := by
        refine (hmap (Opposite.op W) V f.op (ULift.up (𝟙 W))).trans ?_
        exact congrArg (fun g : V.unop ⟶ W =>
          (FreeAbelianGroup.of (ULift.up g : ULift.{u+1} (V.unop ⟶ W)) :
            FreeAbelianGroup (ULift.{u+1} (V.unop ⟶ W)))) (Category.comp_id f)
      have e2 := congrArg (fun φ => φ.hom γ) (η.naturality f.op)
      calc (η.app V).hom (FreeAbelianGroup.of (ULift.up f : ULift.{u+1} (V.unop ⟶ W)))
          = (η.app V).hom ((P.map f.op).hom γ) := congrArg (η.app V).hom e1.symm
        _ = (P.map f.op ≫ η.app V).hom γ := rfl
        _ = (η.app (Opposite.op W) ≫ Q.obj.map f.op).hom γ := e2
        _ = (Q.obj.map f.op).hom ((η.app (Opposite.op W)).hom γ) := rfl
    have hev : Function.Bijective (fun η : P ⟶ Q.obj => (η.app (Opposite.op W)).hom γ) := by
      constructor
      · intro η η' h
        simp only at h
        apply NatTrans.ext
        funext V
        apply AddCommGrpCat.hom_ext
        refine hext (α := ULift.{u+1} (V.unop ⟶ W)) _ _ (fun a => ?_)
        exact (hK η V a.down).trans
          ((congrArg (Q.obj.map a.down.op).hom h).trans (hK η' V a.down).symm)
      · intro x
        let F : ∀ V : (S.ProEt)ᵒᵖ, ULift.{u+1} (V.unop ⟶ W) → Q.obj.obj V :=
          fun V f => (Q.obj.map f.down.op).hom x
        refine ⟨{ app := fun V => AddCommGrpCat.ofHom (FreeAbelianGroup.lift (F V))
                  naturality := ?_ }, ?_⟩
        · intro V V' h
          apply AddCommGrpCat.hom_ext
          refine hext (α := ULift.{u+1} (V.unop ⟶ W)) _ _ (fun a => ?_)
          calc (P.map h ≫ AddCommGrpCat.ofHom (FreeAbelianGroup.lift (F V'))).hom
                (FreeAbelianGroup.of a)
              = FreeAbelianGroup.lift (F V') ((P.map h).hom (FreeAbelianGroup.of a)) := rfl
            _ = FreeAbelianGroup.lift (F V')
                  (FreeAbelianGroup.of (ULift.up (h.unop ≫ a.down) : ULift.{u+1} (V'.unop ⟶ W))) :=
                congrArg (FreeAbelianGroup.lift (F V')) (hmap V V' h a)
            _ = (Q.obj.map (h.unop ≫ a.down).op).hom x := FreeAbelianGroup.lift_apply_of _ _
            _ = (Q.obj.map h).hom ((Q.obj.map a.down.op).hom x) := by
                rw [op_comp, Quiver.Hom.op_unop, Functor.map_comp]
                rfl
            _ = (Q.obj.map h).hom (FreeAbelianGroup.lift (F V) (FreeAbelianGroup.of a)) :=
                congrArg (Q.obj.map h).hom (FreeAbelianGroup.lift_apply_of (F V) a).symm
            _ = (AddCommGrpCat.ofHom (FreeAbelianGroup.lift (F V)) ≫ Q.obj.map h).hom
                  (FreeAbelianGroup.of a) := rfl
        · show FreeAbelianGroup.lift (F (Opposite.op W)) γ = x
          refine (FreeAbelianGroup.lift_apply_of (F (Opposite.op W)) (ULift.up (𝟙 W))).trans ?_
          show (Q.obj.map (𝟙 W).op).hom x = x
          rw [op_id, CategoryTheory.Functor.map_id]
          rfl
    let sadj := sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}
    have hfac : ∀ g : (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj P ⟶ Q,
        (g.hom.app (Opposite.op W)).hom
            (((toSheafify (Scheme.ProEt.topology S) P).app (Opposite.op W)).hom γ) =
          (((sadj.homEquiv P Q) g).app (Opposite.op W)).hom γ := by
      intro g
      rw [Adjunction.homEquiv_unit, sheafificationAdjunction_unit_app]
      rfl
    have e : (fun g : wcFreeSheaf S W ⟶ Q => (g.hom.app (Opposite.op W)).hom (wcFreeGen S W)) =
        (fun η : P ⟶ Q.obj => (η.app (Opposite.op W)).hom γ) ∘ (sadj.homEquiv P Q) := by
      funext g
      exact hfac g
    rw [e]
    exact hev.comp (sadj.homEquiv P Q).bijective

  have hcont : (wcProEtBaseChange ι).IsContinuous (Scheme.ProEt.topology Y')
      (Scheme.ProEt.topology X') := by
    have crit : ∀ (S : Scheme.{u}) (X : S.ProEt) (R : Sieve X),
        R ∈ Scheme.ProEt.topology S X ↔
          Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
            Scheme.proetaleTopology X.left := by
      intro S X R
      letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
      have h : Scheme.ProEt.topology S =
          (Scheme.ProEt.forget S).restrictedTopology (Scheme.proetaleTopology.over S) :=
        MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := S)
          (P := @WeaklyEtale) Scheme.proetalePrecoverage
          Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
      rw [h, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
        Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
      rfl
    have hpres : Limits.PreservesFiniteLimits (wcProEtPullback ι) := by
      let e : Scheme.ProEt.forget Y' ⋙ Over.pullback ι ≅
          wcProEtPullback ι ⋙ Scheme.ProEt.forget X' :=
        NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl)
      haveI : Limits.PreservesFiniteLimits (wcProEtPullback ι ⋙ Scheme.ProEt.forget X') :=
        Limits.preservesFiniteLimits_of_natIso e
      exact Limits.preservesFiniteLimits_of_reflects_of_preserves (wcProEtPullback ι)
        (Scheme.ProEt.forget X')
    haveI := hpres
    haveI hflat : RepresentablyFlat (wcProEtPullback ι) :=
      flat_of_preservesFiniteLimits (wcProEtPullback ι)
    have hle : ∀ (U : Y'.ProEt) (R : Sieve U),
        Sieve.pullback (Limits.pullback.fst U.hom ι)
          (Sieve.functorPushforward (Scheme.ProEt.forget Y' ⋙ Over.forget Y') R) ≤
        Sieve.functorPushforward (Scheme.ProEt.forget X' ⋙ Over.forget X')
          (Sieve.functorPushforward (wcProEtPullback ι) R) := by
      intro U R Z h hh
      obtain ⟨V, g, k, hg, hk⟩ := hh
      change h ≫ Limits.pullback.fst U.hom ι = k ≫ g.left at hk
      have hw : g.left ≫ U.hom = V.hom := MorphismProperty.Over.w g
      have w : k ≫ V.hom = (h ≫ Limits.pullback.snd U.hom ι) ≫ ι :=
        calc k ≫ V.hom = k ≫ (g.left ≫ U.hom) := congrArg (k ≫ ·) hw.symm
        _ = (k ≫ g.left) ≫ U.hom := (Category.assoc _ _ _).symm
        _ = (h ≫ Limits.pullback.fst U.hom ι) ≫ U.hom := congrArg (· ≫ U.hom) hk.symm
        _ = h ≫ (Limits.pullback.fst U.hom ι ≫ U.hom) := Category.assoc _ _ _
        _ = h ≫ (Limits.pullback.snd U.hom ι ≫ ι) := congrArg (h ≫ ·) Limits.pullback.condition
        _ = (h ≫ Limits.pullback.snd U.hom ι) ≫ ι := (Category.assoc _ _ _).symm
      refine ⟨(wcProEtPullback ι).obj V, (wcProEtPullback ι).map g,
        Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom ι) w,
        Sieve.image_mem_functorPushforward (wcProEtPullback ι) R hg, ?_⟩
      have hmap : ((wcProEtPullback ι).map g).left =
          Limits.pullback.lift (Limits.pullback.fst V.hom ι ≫ g.left) (Limits.pullback.snd V.hom ι)
            (by rw [Category.assoc, MorphismProperty.Over.w g]; exact Limits.pullback.condition) :=
        rfl
      change h = Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom ι) w ≫
        ((wcProEtPullback ι).map g).left
      rw [hmap]
      apply Limits.pullback.hom_ext
      · refine hk.trans ?_
        refine Eq.symm ((Category.assoc _ _ _).trans ?_)
        refine (congrArg (fun x => Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom ι) w ≫ x)
          (Limits.pullback.lift_fst _ _ _)).trans ?_
        refine (Category.assoc _ _ _).symm.trans ?_
        exact congrArg (fun x => x ≫ g.left) (Limits.pullback.lift_fst _ _ _)
      · refine Eq.symm ((Category.assoc _ _ _).trans ?_)
        refine (congrArg (fun x => Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom ι) w ≫ x)
          (Limits.pullback.lift_snd _ _ _)).trans ?_
        exact Limits.pullback.lift_snd _ _ _
    have hcov : CoverPreserving (Scheme.ProEt.topology Y') (Scheme.ProEt.topology X')
        (wcProEtPullback ι) := by
      refine ⟨fun {U} {R} hR => ?_⟩
      have hS := (crit Y' U R).1 hR
      have hP := Scheme.proetaleTopology.pullback_stable (Limits.pullback.fst U.hom ι) hS
      have hQ := Scheme.proetaleTopology.superset_covering (hle U R) hP
      exact (crit X' ((wcProEtPullback ι).obj U)
        (Sieve.functorPushforward (wcProEtPullback ι) R)).2 hQ
    have h0 : (wcProEtPullback ι).IsContinuous (Scheme.ProEt.topology Y')
        (Scheme.ProEt.topology X') :=
      Functor.isContinuous_of_coverPreserving
        (compatiblePreservingOfFlat (Scheme.ProEt.topology X') (wcProEtPullback ι)) hcov
    exact h0

  have hB : ∀ {G T : Sheaf (Scheme.ProEt.topology X') AddCommGrpCat.{u+1}} (x : G ⟶ T)
      (W : Y'.ProEt) (s : G.obj.obj (Opposite.op ((wcProEtBaseChange ι).obj W))),
      (((wcProEtPush ι).map x).hom.app (Opposite.op W)).hom
          (((toSheafify (Scheme.ProEt.topology Y') ((wcProEtBaseChange ι).op ⋙ G.obj)).app
            (Opposite.op W)).hom s) =
        ((toSheafify (Scheme.ProEt.topology Y') ((wcProEtBaseChange ι).op ⋙ T.obj)).app
            (Opposite.op W)).hom ((x.hom.app (Opposite.op ((wcProEtBaseChange ι).obj W))).hom s) := by
    intro G T x W s
    have h := congrArg (fun φ => (φ.app (Opposite.op W)).hom s)
      (toSheafify_naturality (Scheme.ProEt.topology Y')
        (Functor.whiskerLeft (wcProEtBaseChange ι).op x.hom))
    exact h.symm

  have hA : ∀ (S : Scheme.{u}) {V V' : S.ProEt} (f : V ⟶ V'),
      ((wcFreeSheafMap S f).hom.app (Opposite.op V)).hom (wcFreeGen S V) =
        ((wcFreeSheaf S V').obj.map f.op).hom (wcFreeGen S V') := by
    intro S V V' f
    have h1 := congrArg (fun φ => (φ.app (Opposite.op V)).hom
        (FreeAbelianGroup.of (ULift.up (𝟙 V)) : FreeAbelianGroup (ULift.{u+1} (V ⟶ V))))
