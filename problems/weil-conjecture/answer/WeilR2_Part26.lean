        (Abelian.Ext.mk₀ (ω.hom.app (SheafOfModules.unit (wcIntRingSheaf T ℓ)))) (add_zero j))
        (zero_add j) := by
    rw [Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp y ω.hom, s2, Iso.inv_hom_id_app,
      Abelian.Ext.mk₀_id_comp]
  have hL : wcIzRho T V ℓ j lam
      ((Abelian.Ext.mk₀ ((wcFreeSheafMap T (wcZmToTop T V)))).comp (wcIzCt T ℓ j ε κ y)
        (zero_add j)) =
      (Abelian.Ext.mk₀ (((wcLpscGen T V (Scheme.ProEt.mk (𝟙 V.left)) V (wcLpscBetaTop T V))) ≫
          (wcLpscG T V).map ((wcFreeSheafMap T (wcZmToTop T V))) ≫ (wcLpscG T V).map ε)).comp
        ((Abelian.Ext.mapExactFunctor ((SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf T ℓ)) ⋙
            (wcLpscG T V)) y).comp
          (Abelian.Ext.mk₀ ((wcLpscG T V).map κ.hom ≫ lam.hom)) (add_zero j)) (zero_add j) := by
    show ((Abelian.Ext.mk₀ ((wcLpscGen T V (Scheme.ProEt.mk (𝟙 V.left)) V
        (wcLpscBetaTop T V)))).comp (Abelian.Ext.mapExactFunctor (wcLpscG T V)
        ((Abelian.Ext.mk₀ ((wcFreeSheafMap T (wcZmToTop T V)))).comp
          (((Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor
              (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf T ℓ)) y) (zero_add j)).comp
            (Abelian.Ext.mk₀ κ.hom) (add_zero j)) (zero_add j))) (zero_add j)).comp
        (Abelian.Ext.mk₀ lam.hom) (add_zero j) = _
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor]
    simp only [s2, s3, s4, Category.assoc]
  have hR : wcIzCt V.left ℓ j ε' κ' (wcIntPull D j y) =
      (Abelian.Ext.mk₀ (ε' ≫ (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf V.left ℓ)).map c ≫
          ω.inv.app (SheafOfModules.unit (wcIntRingSheaf T ℓ)))).comp
        ((Abelian.Ext.mapExactFunctor ((SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf T ℓ)) ⋙
            (wcLpscG T V)) y).comp
          (Abelian.Ext.mk₀ (ω.hom.app (SheafOfModules.unit (wcIntRingSheaf T ℓ)) ≫
            (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf V.left ℓ)).map (inv c) ≫ κ'.hom))
          (add_zero j))
        (zero_add j) := by
    show ((Abelian.Ext.mk₀ ε').comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf V.left ℓ)) (wcIntPull D j y))
        (zero_add j)).comp (Abelian.Ext.mk₀ κ'.hom) (add_zero j) = _
    rw [hPull, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, hω]
    simp only [s2, s3, s4, Category.assoc]
  rw [hL, hR, hA, hB]

theorem wc_iz_pull_canonical_mu {S S' : Scheme.{u}} {f : S' ⟶ S} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (D : wcIntPullData f ℓ) (hD : wcIntPullCanonical D) :
    ∃ μ₀ : D.Φ.obj (SheafOfModules.unit (wcIntRingSheaf S ℓ)) ≅
        SheafOfModules.unit (wcIntRingSheaf S' ℓ),
      D.adj.homEquiv _ _ μ₀.hom =
        @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ :=
by
  classical
  letI := D.cont
  have hfun : wcIntFun S' ℓ 1 = 𝟙 _ ∧ ∀ r r' : C(↥S', ULift.{u+1} ℤ_[ℓ]),
      wcIntFun S' ℓ (r * r') = wcIntFun S' ℓ r ≫ wcIntFun S' ℓ r' := by
    refine ⟨?_, ?_⟩
    · apply (SheafOfModules.unitHomEquiv _).injective
      apply Subtype.ext
      funext V
      rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
      rw [← SheafOfModules.unitHomEquiv_apply_coe]
      simp only [wcIntFun, Equiv.apply_symm_apply]
      rfl
    · intro r r'
      apply (SheafOfModules.unitHomEquiv _).injective
      rw [SheafOfModules.unitHomEquiv_comp_apply]
      apply Subtype.ext
      funext V
      have hvalP : ∀ c : C(↥S', ULift.{u+1} ℤ_[ℓ]),
          ((SheafOfModules.unitHomEquiv _) (wcIntFun S' ℓ c)).1 V =
          (c.comp (Opposite.unop V).hom.base.hom :
            C(↥((Opposite.unop V).left), ULift.{u+1} ℤ_[ℓ])) := by
        intro c
        simp only [wcIntFun, Equiv.apply_symm_apply]
        rfl
      show _ = ((wcIntFun S' ℓ r').val.app V).hom
        (((SheafOfModules.unitHomEquiv _) (wcIntFun S' ℓ r)).1 V)
      rw [hvalP, hvalP]
      apply ContinuousMap.ext
      intro x
      rfl
  let ρ₀ := D.adj.homEquiv _ _ D.μ.hom
  let T : S.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : WeaklyEtale (𝟙 S))
  let lamf : S' ⟶ Limits.pullback (𝟙 S) f :=
    Limits.pullback.lift f (𝟙 S') ((Category.comp_id f).trans (Category.id_comp f).symm)
  let τ : C(↥S', ULift.{u+1} ℤ_[ℓ]) :=
    (((ρ₀.val.app (Opposite.op T)).hom (1 : C(↥S, ULift.{u+1} ℤ_[ℓ])) :
      C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℤ_[ℓ]))).comp lamf.base.hom
  have hisUnit : ∃ c' : C(↥S', ULift.{u+1} ℤ_[ℓ]), τ * c' = 1 := by
    let u := SheafOfModules.unitToPushforwardObjUnit D.φ
    let ψ₁ := (D.adj.homEquiv _ _).symm u
    let h : SheafOfModules.unit (wcIntRingSheaf S' ℓ) ⟶ SheafOfModules.unit (wcIntRingSheaf S' ℓ) :=
      D.μ.inv ≫ ψ₁
    have hfac : u = ρ₀ ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map h := by
      have e1 : D.μ.hom ≫ h = ψ₁ := Iso.hom_inv_id_assoc _ _
      calc u = D.adj.homEquiv _ _ ψ₁ := (Equiv.apply_symm_apply _ _).symm
        _ = D.adj.homEquiv _ _ (D.μ.hom ≫ h) := by rw [e1]
        _ = D.adj.homEquiv _ _ D.μ.hom ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map h :=
          Adjunction.homEquiv_naturality_right _ _ _
    let cT : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℤ_[ℓ]) :=
      (ρ₀.val.app (Opposite.op T)).hom (1 : C(↥S, ULift.{u+1} ℤ_[ℓ]))
    let a : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℤ_[ℓ]) :=
      (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom
        (1 : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℤ_[ℓ]))
    have hu1 : (u.val.app (Opposite.op T)).hom (1 : C(↥S, ULift.{u+1} ℤ_[ℓ])) =
        (1 : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℤ_[ℓ])) :=
      (D.φ.hom.app (Opposite.op T)).hom.map_one
    have hev : (u.val.app (Opposite.op T)).hom (1 : C(↥S, ULift.{u+1} ℤ_[ℓ])) =
        (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom cT := by
      rw [hfac]
      rfl
    have hlin : ∀ x : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℤ_[ℓ]),
        (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom x = x * a := by
      intro x
      have e := (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom.map_smul x
        (1 : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℤ_[ℓ]))
      have e2 : (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom x =
          (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom (x * 1) :=
        congrArg (fun y => (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom y) (mul_one x).symm
      exact e2.trans e
    have key : cT * a = 1 := by
      rw [← hlin cT, ← hev, hu1]
    refine ⟨a.comp lamf.base.hom, ?_⟩
    show cT.comp lamf.base.hom * a.comp lamf.base.hom = 1
    rw [← ContinuousMap.mul_comp, key, ContinuousMap.one_comp]
  have hfactor : ρ₀ =
      @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ ≫
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map
        (wcIntFun S' ℓ τ) := by
    have hlam1 : lamf ≫ Limits.pullback.fst (𝟙 S) f = f := Limits.pullback.lift_fst _ _ _
    have hlam2 : lamf ≫ Limits.pullback.snd (𝟙 S) f = 𝟙 S' := Limits.pullback.lift_snd _ _ _
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext X
    obtain ⟨V⟩ := X
    let e : V ⟶ T := MorphismProperty.Over.homMk V.hom (Category.comp_id V.hom) trivial
    let β : Limits.pullback V.hom f ⟶ Limits.pullback (𝟙 S) f := ((wcProEtBC f).map e).left
    have hβw : β ≫ Limits.pullback.snd (𝟙 S) f = Limits.pullback.snd V.hom f :=
      MorphismProperty.Over.w ((wcProEtBC f).map e)
    have hβ : β = Limits.pullback.snd V.hom f ≫ lamf := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hlam1, ← hβw, Category.assoc, ← Limits.pullback.condition,
          Category.comp_id]
      · rw [Category.assoc, hlam2, Category.comp_id, hβw]
    let m1 : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℤ_[ℓ]) :=
      (ρ₀.val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℤ_[ℓ]))
    let mT : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℤ_[ℓ]) :=
      (ρ₀.val.app (Opposite.op T)).hom (1 : C(↥S, ULift.{u+1} ℤ_[ℓ]))
    have e1 : m1 = mT.comp β.base.hom :=
      PresheafOfModules.naturality_apply ρ₀.val e.op (1 : C(↥S, ULift.{u+1} ℤ_[ℓ]))
    have e3 : mT.comp (Limits.pullback.snd V.hom f ≫ lamf).base.hom =
        τ.comp (Limits.pullback.snd V.hom f).base.hom :=
      ContinuousMap.ext fun _ => rfl
    have hL : m1 = τ.comp (Limits.pullback.snd V.hom f).base.hom := by
      rw [e1, hβ, e3]
    let h := wcIntFun S' ℓ τ
    let r1 : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℤ_[ℓ]) :=
      (h.val.app (Opposite.op ((wcProEtBC f).obj V))).hom
        (1 : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℤ_[ℓ]))
    have hR : r1 = τ.comp (Limits.pullback.snd V.hom f).base.hom := by
      have e4 : r1 = (SheafOfModules.unitHomEquiv _ h).1 (Opposite.op ((wcProEtBC f).obj V)) :=
        (SheafOfModules.unitHomEquiv_apply_coe _ _ _).symm
      rw [e4]
      simp only [h]
      unfold wcIntFun
      rw [Equiv.apply_symm_apply]
      rfl
    show m1 = (h.val.app (Opposite.op ((wcProEtBC f).obj V))).hom
      ((D.φ.hom.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℤ_[ℓ])))
    have key := congrArg (fun x => (h.val.app (Opposite.op ((wcProEtBC f).obj V))).hom x)
      ((D.φ.hom.app (Opposite.op V)).hom.map_one)
    exact hL.trans (hR.symm.trans key.symm)
  obtain ⟨c', hc'⟩ := hisUnit
  have hh1 : wcIntFun S' ℓ τ ≫ wcIntFun S' ℓ c' = 𝟙 _ := by
    rw [← hfun.2, hc', hfun.1]
  have hμ : D.μ.hom = (D.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ) ≫
      wcIntFun S' ℓ τ := by
    apply (D.adj.homEquiv _ _).injective
    rw [Adjunction.homEquiv_naturality_right, Equiv.apply_symm_apply]
    exact hfactor
  have hμ0 : (D.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ) =
      D.μ.hom ≫ wcIntFun S' ℓ c' := by
    rw [hμ, Category.assoc, hh1, Category.comp_id]
  refine ⟨⟨(D.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ),
    wcIntFun S' ℓ τ ≫ D.μ.inv, ?_, ?_⟩, ?_⟩
  · rw [← Category.assoc, ← hμ, Iso.hom_inv_id]
  · rw [hμ0]
    simp only [Category.assoc, Iso.inv_hom_id_assoc, hh1]
  · exact Equiv.apply_symm_apply _ _

theorem wc_iz_unit_pi_iso {S S' : Scheme.{u}} (f : S' ⟶ S) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    [(wcProEtBC f).IsContinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')]
    [RepresentablyFlat (wcProEtBC f)] :
    IsIso ((((wcProEtBC f).sheafAdjunctionContinuous AddCommGrpCat.{u+1} (Scheme.ProEt.topology S)
      (Scheme.ProEt.topology S')).homEquiv (wcIntSheaf S ℓ) (wcIntSheaf S' ℓ)).symm
        (wcIzCp f ℓ)) :=
by
  classical

  obtain ⟨P, p, hp, π, huniv, hσ⟩ := wc_profinite_universal_weaklyEtale S ℤ_[ℓ]
  have gsurj : ∀ (V' : S'.ProEt) (r' : C(↥V'.left, ℤ_[ℓ])),
      ∃ (V : S.ProEt) (a : V' ⟶ (wcProEtBC f).obj V) (r : C(↥V.left, ℤ_[ℓ])),
        r' = (r.comp (Limits.pullback.fst V.hom f).base.hom).comp a.left.base.hom := by
    intro V' r'
    obtain ⟨h, hhp, hhc⟩ := huniv V'.left (V'.hom ≫ f) r'
    haveI := hp
    let V : S.ProEt := Scheme.ProEt.mk p
    let aL : V'.left ⟶ Limits.pullback p f := Limits.pullback.lift h V'.hom hhp
    let a : V' ⟶ (wcProEtBC f).obj V :=
      MorphismProperty.Over.homMk aL (Limits.pullback.lift_snd _ _ _) trivial
    refine ⟨V, a, π, ?_⟩
    apply ContinuousMap.ext
    intro z
    have h1 : (Limits.pullback.fst p f).base (aL.base z) = h.base z :=
      congrArg (fun k : V'.left ⟶ P => k.base z) (Limits.pullback.lift_fst h V'.hom hhp)
    have h2 : π (h.base z) = r' z :=
      congrArg (fun ψ : C(_, ℤ_[ℓ]) => ψ z) hhc
    change r' z = π ((Limits.pullback.fst p f).base (aL.base z))
    rw [h1, h2]
  have ginj : ∀ (V' : S'.ProEt) (V : S.ProEt) (a : V' ⟶ (wcProEtBC f).obj V)
      (r : C(↥V.left, ℤ_[ℓ])),
      (r.comp (Limits.pullback.fst V.hom f).base.hom).comp a.left.base.hom = 0 →
      ∃ (W : S.ProEt) (b : W ⟶ V) (a' : V' ⟶ (wcProEtBC f).obj W),
        a' ≫ (wcProEtBC f).map b = a ∧ r.comp b.left.base.hom = 0 := by
    intro V' V a r hr
    obtain ⟨σ, hσW, -, hσπ, hσfac⟩ := hσ 0
    have ha : a.left ≫ Limits.pullback.snd V.hom f = V'.hom := Over.w a.toCommaMorphism
    have hGb1 : ∀ {W : S.ProEt} (b : W ⟶ V), ((wcProEtBC f).map b).left ≫
        Limits.pullback.fst V.hom f = Limits.pullback.fst W.hom f ≫ b.left := fun b =>
      Limits.pullback.lift_fst _ _ _
    have hGb2 : ∀ {W : S.ProEt} (b : W ⟶ V), ((wcProEtBC f).map b).left ≫
        Limits.pullback.snd V.hom f = Limits.pullback.snd W.hom f := fun b =>
      Limits.pullback.lift_snd _ _ _
    obtain ⟨h, -, hhc⟩ := huniv V.left V.hom r
    haveI := hσW
    haveI := hp
    haveI : WeaklyEtale V.hom := V.prop
    let W : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst h σ ≫ V.hom)
    let b : W ⟶ V := MorphismProperty.Over.homMk (Limits.pullback.fst h σ) rfl trivial
    have hb0 : r.comp b.left.base.hom = 0 := by
      apply ContinuousMap.ext
      intro w
      have e1 : h.base ((Limits.pullback.fst h σ).base w) =
          σ.base ((Limits.pullback.snd h σ).base w) :=
        congrArg (fun k : Limits.pullback h σ ⟶ P => k.base w)
          (Limits.pullback.condition (f := h) (g := σ))
      have e2 : π (h.base ((Limits.pullback.fst h σ).base w)) =
          r ((Limits.pullback.fst h σ).base w) :=
        congrArg (fun ψ : C(_, ℤ_[ℓ]) => ψ ((Limits.pullback.fst h σ).base w)) hhc
      rw [e1, hσπ] at e2
      exact e2.symm
    let φ : V'.left ⟶ V.left := a.left ≫ Limits.pullback.fst V.hom f
    have hπ : ∀ x, π ((φ ≫ h).base x) = 0 := by
      intro x
      have e1 : π (h.base (φ.base x)) = r (φ.base x) :=
        congrArg (fun ψ : C(_, ℤ_[ℓ]) => ψ (φ.base x)) hhc
      have e6 : r ((Limits.pullback.fst V.hom f).base (a.left.base x)) = 0 :=
        congrArg (fun ψ : C(_, ℤ_[ℓ]) => ψ x) hr
      show π (h.base (φ.base x)) = 0
      rw [e1]
      exact e6
    have hfac := hσfac V'.left (φ ≫ h) hπ
    let q : V'.left ⟶ Limits.pullback h σ := Limits.pullback.lift φ ((φ ≫ h) ≫ p) hfac
    have hq1 : q ≫ Limits.pullback.fst h σ = φ := Limits.pullback.lift_fst _ _ _
    have hcond : Limits.pullback.fst V.hom f ≫ V.hom = Limits.pullback.snd V.hom f ≫ f :=
      Limits.pullback.condition
    have hw : q ≫ (Limits.pullback.fst h σ ≫ V.hom) = V'.hom ≫ f :=
      calc q ≫ (Limits.pullback.fst h σ ≫ V.hom)
          = (q ≫ Limits.pullback.fst h σ) ≫ V.hom := (Category.assoc _ _ _).symm
        _ = φ ≫ V.hom := congrArg (fun k => k ≫ V.hom) hq1
        _ = a.left ≫ (Limits.pullback.fst V.hom f ≫ V.hom) := Category.assoc _ _ _
        _ = a.left ≫ (Limits.pullback.snd V.hom f ≫ f) :=
          congrArg (fun k => a.left ≫ k) hcond
        _ = (a.left ≫ Limits.pullback.snd V.hom f) ≫ f := (Category.assoc _ _ _).symm
        _ = V'.hom ≫ f := congrArg (fun k => k ≫ f) ha
    let aL' : V'.left ⟶ Limits.pullback (Limits.pullback.fst h σ ≫ V.hom) f :=
      Limits.pullback.lift q V'.hom hw
    let a' : V' ⟶ (wcProEtBC f).obj W :=
      MorphismProperty.Over.homMk aL' (Limits.pullback.lift_snd _ _ _) trivial
    refine ⟨W, b, a', ?_, hb0⟩
    apply MorphismProperty.Over.Hom.ext
    change aL' ≫ ((wcProEtBC f).map b).left = a.left
    have e1 : aL' ≫ Limits.pullback.fst W.hom f = q := Limits.pullback.lift_fst _ _ _
    have e2 : aL' ≫ Limits.pullback.snd W.hom f = V'.hom := Limits.pullback.lift_snd _ _ _
    refine Limits.pullback.hom_ext ?_ ?_
    · exact calc (aL' ≫ ((wcProEtBC f).map b).left) ≫ Limits.pullback.fst V.hom f
          = aL' ≫ (((wcProEtBC f).map b).left ≫ Limits.pullback.fst V.hom f) :=
            Category.assoc _ _ _
        _ = aL' ≫ (Limits.pullback.fst W.hom f ≫ b.left) := congrArg (fun k => aL' ≫ k) (hGb1 b)
        _ = (aL' ≫ Limits.pullback.fst W.hom f) ≫ b.left := (Category.assoc _ _ _).symm
        _ = q ≫ b.left := congrArg (fun k => k ≫ b.left) e1
        _ = q ≫ Limits.pullback.fst h σ := rfl
        _ = a.left ≫ Limits.pullback.fst V.hom f := hq1
    · exact calc (aL' ≫ ((wcProEtBC f).map b).left) ≫ Limits.pullback.snd V.hom f
          = aL' ≫ (((wcProEtBC f).map b).left ≫ Limits.pullback.snd V.hom f) :=
            Category.assoc _ _ _
        _ = aL' ≫ Limits.pullback.snd W.hom f := congrArg (fun k => aL' ≫ k) (hGb2 b)
        _ = V'.hom := e2
        _ = a.left ≫ Limits.pullback.snd V.hom f := ha.symm

  have crit : ∀ (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (H : Sheaf (Scheme.ProEt.topology S') AddCommGrpCat.{u+1})
      (θ : G ⟶ ((wcProEtBC f).sheafPushforwardContinuous AddCommGrpCat.{u+1}
