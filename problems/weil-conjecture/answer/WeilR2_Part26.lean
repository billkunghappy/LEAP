        hconj _ _ η.2, rfl, ?_⟩
      show ((η : Q) * P ^ d) ^ (-(-1 : ℤ)) =
        P ^ (-((-1 : ℤ) * d)) * (P ^ (-(d : ℤ)) * η * (P ^ (-(d : ℤ)))⁻¹)
      group
    obtain ⟨y, hy1, hy2⟩ : ∃ y : G,
        (y : Multiplicative (ZMod M) × Q).1 =
          Multiplicative.ofAdd ((((-1 : ℤ) * d : ℤ)) : ZMod M) ∧
        (y : Multiplicative (ZMod M) × Q).2 = ((η : Q) * P ^ d) ^ (-(-1 : ℤ)) :=
      ⟨⟨_, hyG⟩, rfl, rfl⟩
    refine ⟨y, hy1, hy2, ?_⟩
    have hαy : α y⁻¹ = -((d : ℕ) : ZMod M) := by
      rw [hα, Subgroup.coe_inv, Prod.fst_inv, hy1, toAdd_inv, toAdd_ofAdd]
      push_cast; ring
    have hpzd : pz (-((d : ℕ) : ZMod M)) = P ^ (-(d : ℤ)) := by
      have := hpz (-(d : ℤ))
      rw [Int.cast_neg, Int.cast_natCast] at this
      exact this
    have hκy : (κ 0 y⁻¹ : Q) = P ^ (-(d : ℤ)) * η * (P ^ (-(d : ℤ)))⁻¹ := by
      rw [hκ, hc, hαy, pz_zero, Subgroup.coe_inv, Prod.snd_inv, hy2, hpzd]
      group
    have R1 : ∀ (n : ℕ) (i : ZMod M), ι i ≫ (fun f : E'' ⟶ E'' => F'' ≫ f)^[n] (𝟙 E'') =
        (fun f : E ⟶ E => FH ≫ f)^[n] (𝟙 E) ≫ ι (i + n) := by
      intro n
      induction n with
      | zero => intro i; simp
      | succ n ih =>
        intro i
        simp only [Function.iterate_succ_apply']
        rw [reassoc_of% (hF'' i), ih (i + 1), Category.assoc]
        have e : i + 1 + (n : ZMod M) = i + ((n + 1 : ℕ) : ZMod M) := by push_cast; ring
        rw [e]
    have R2 : ∀ (n : ℕ) (η η' : H), (η' : Q) = P ^ n * η * (P ^ n)⁻¹ →
        τ η ≫ (fun f : E ⟶ E => FH ≫ f)^[n] (𝟙 E) =
          (fun f : E ⟶ E => FH ≫ f)^[n] (𝟙 E) ≫ τ η' := by
      intro n
      induction n with
      | zero =>
        intro η η' h
        have : η' = η := Subtype.ext (by rw [h]; simp)
        rw [this]; simp
      | succ n ih =>
        intro η η' h
        have hm : P * (η : Q) * P⁻¹ ∈ H := hN1 _ η.2
        simp only [Function.iterate_succ_apply']
        rw [reassoc_of% (hτFH η ⟨_, hm⟩ rfl), ih ⟨_, hm⟩ η' (by
          rw [h]
          show _ = P ^ n * (P * (η : Q) * P⁻¹) * (P ^ n)⁻¹
          group), Category.assoc]
    have hcond : (η : Q) = P ^ d * (κ 0 y⁻¹ : Q) * (P ^ d)⁻¹ := by
      rw [hκy]; group
    rw [reassoc_of% (hact' y⁻¹ 0), R1 d (0 + α y⁻¹), reassoc_of% (R2 d (κ 0 y⁻¹) η hcond), hαy]
    have e : (0 : ZMod M) + -((d : ℕ) : ZMod M) + (d : ZMod M) = 0 := by ring
    rw [e]

theorem wc_clc_torsor_descends : ∀ (U U' Y E : Scheme.{u}) (u : U' ⟶ U) (πY : Y ⟶ U) (πE : E ⟶ U')
    (j : E ⟶ Y), IsFinite πY → Etale πY → IsPullback j πE πY u → Surjective j →
    ∀ (G : Type) [Group G] (actY : G → (Y ⟶ Y)) (actE : G → (E ⟶ E)),
    (∀ g, actY g ≫ πY = πY) → (∀ g, actE g ≫ πE = πE) → (∀ g, actE g ≫ j = j ≫ actY g) →
    (∀ (T : Scheme.{u}), ConnectedSpace T → ∀ (a b : T ⟶ E), a ≫ πE = b ≫ πE →
      ∃! g, b = a ≫ actE g) →
    ∀ (T : Scheme.{u}), ConnectedSpace T → ∀ (a b : T ⟶ Y), a ≫ πY = b ≫ πY →
      ∃! g, b = a ≫ actY g :=
by
  intro U U' Y E u πY πE j hfin het hpb hsurj G _ actY actE hYπ hEπ hcomp hE T hT a b hab
  haveI := hfin
  haveI := het
  haveI := hsurj
  haveI := hT

  have rigid : ∀ (P : Scheme.{u}), Nonempty P → ∀ (f g : T ⟶ Y) (p : P ⟶ T),
      f ≫ πY = g ≫ πY → p ≫ f = p ≫ g → f = g := by
    intro P hP f g p hfg hp
    obtain ⟨φ, hφ1, hφ2⟩ : ∃ φ : T ⟶ Limits.pullback πY πY,
        φ ≫ Limits.pullback.fst πY πY = f ∧ φ ≫ Limits.pullback.snd πY πY = g :=
      ⟨Limits.pullback.lift f g hfg, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    have hR : IsClopen (Set.range (Limits.pullback.diagonal πY)) :=
      ⟨(Limits.pullback.diagonal πY).isClosedEmbedding.isClosed_range,
        IsOpenImmersion.isOpen_range (Limits.pullback.diagonal πY)⟩
    have hS : IsClopen (φ ⁻¹' Set.range (Limits.pullback.diagonal πY)) :=
      hR.preimage φ.continuous
    obtain ⟨s₀⟩ := hP
    have hpφ : p ≫ φ = (p ≫ f) ≫ Limits.pullback.diagonal πY := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hφ1, Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      · rw [Category.assoc, hφ2, Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
          hp]
    have hmem : p s₀ ∈ φ ⁻¹' Set.range (Limits.pullback.diagonal πY) := by
      show φ (p s₀) ∈ Set.range (Limits.pullback.diagonal πY)
      refine ⟨f (p s₀), ?_⟩
      have h1 : ((p ≫ f) ≫ Limits.pullback.diagonal πY) s₀ = (p ≫ φ) s₀ := by rw [hpφ]
      simpa only [Scheme.Hom.comp_apply] using h1
    have huniv : φ ⁻¹' Set.range (Limits.pullback.diagonal πY) = Set.univ :=
      hS.eq_univ ⟨_, hmem⟩
    have hsub : Set.range φ ⊆ Set.range (Limits.pullback.diagonal πY) := by
      rintro _ ⟨t, rfl⟩
      have : t ∈ φ ⁻¹' Set.range (Limits.pullback.diagonal πY) := by
        rw [huniv]; exact Set.mem_univ t
      exact this
    obtain ⟨c, hc⟩ : ∃ c : T ⟶ Y, c ≫ Limits.pullback.diagonal πY = φ :=
      ⟨_, IsOpenImmersion.lift_fac _ φ hsub⟩
    rw [← hφ1, ← hφ2, ← hc, Category.assoc, Category.assoc, Limits.pullback.diagonal_fst,
      Limits.pullback.diagonal_snd]

  obtain ⟨t₀⟩ := (inferInstance : Nonempty T)
  obtain ⟨z, -⟩ := (Limits.pullback.fst a j).surjective t₀
  obtain ⟨p, α, hα⟩ : ∃ (p : Spec ((Limits.pullback a j).residueField z) ⟶ T)
      (α : Spec ((Limits.pullback a j).residueField z) ⟶ E), α ≫ j = p ≫ a :=
    ⟨(Limits.pullback a j).fromSpecResidueField z ≫ Limits.pullback.fst a j,
      (Limits.pullback a j).fromSpecResidueField z ≫ Limits.pullback.snd a j,
      by rw [Category.assoc, Category.assoc, Limits.pullback.condition]⟩
  have hw : (p ≫ b) ≫ πY = (α ≫ πE) ≫ u := by
    rw [Category.assoc, Category.assoc, ← hab, ← hpb.w, ← Category.assoc α j πY, hα,
      Category.assoc]
  obtain ⟨β, hβj, hβE⟩ : ∃ β : Spec ((Limits.pullback a j).residueField z) ⟶ E,
      β ≫ j = p ≫ b ∧ β ≫ πE = α ≫ πE :=
    ⟨hpb.lift (p ≫ b) (α ≫ πE) hw, hpb.lift_fst _ _ _, hpb.lift_snd _ _ _⟩
  obtain ⟨h, hh, huniq⟩ := hE _ inferInstance α β hβE.symm
  have hpb' : p ≫ b = p ≫ (a ≫ actY h) := by
    rw [← hβj, hh, Category.assoc, hcomp, ← Category.assoc, hα, Category.assoc]
  refine ⟨h, rigid _ inferInstance b (a ≫ actY h) p
    (by rw [Category.assoc, hYπ, hab]) hpb', ?_⟩
  intro g' hg'
  apply huniq
  apply hpb.hom_ext
  · rw [hβj, Category.assoc, hcomp, ← Category.assoc, hα, Category.assoc, ← hg']
  · rw [hβE, Category.assoc, hEπ]

theorem wc_clc_frob_dictionary : ∀ (K : Type u) [Field K] [Finite K] (x : (wcP1Over K).left) (d : ℕ)
    (Nx : wcFrobNbhd K x d) (Z : Scheme.{u}) (σ σ' : Z ⟶ Z), σ ≫ σ' = 𝟙 Z → σ' ≫ σ = 𝟙 Z →
    ∀ f : Nx.V.left ⟶ Z, Nx.φ.left ≫ f = f ≫ σ →
    ∃ v : Nx.V.left, Nx.V.hom v = x ∧ wcIsFrobAt σ' (f v) (Nat.card K ^ d) :=
by
  intro K _ _ x d Nx Z σ σ' hσσ' hσ'σ f hf
  classical
  letI := Nx.ringA
  haveI := Nx.hensA

  have hloc : IsLocalHom Nx.ψ := by
    refine ⟨fun a ha => ?_⟩
    by_contra hna
    have hm : a ∈ IsLocalRing.maximalIdeal Nx.A :=
      (IsLocalRing.mem_maximalIdeal a).mpr (mem_nonunits_iff.mpr hna)
    have h2 : Nx.ψ a ^ (Nat.card K ^ d) ∈ IsLocalRing.maximalIdeal Nx.A := by
      have := Ideal.add_mem _ (Nx.hfrob a) hm
      rwa [sub_add_cancel] at this
    have h3 : Nx.ψ a ∈ IsLocalRing.maximalIdeal Nx.A :=
      (IsLocalRing.maximalIdeal.isMaximal Nx.A).isPrime.mem_of_pow_mem _ h2
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h3) ha

  obtain ⟨ψb, hψb⟩ : ∃ ψb : IsLocalRing.ResidueField Nx.A →+* IsLocalRing.ResidueField Nx.A,
      ψb = IsLocalRing.ResidueField.map Nx.ψ := ⟨_, rfl⟩
  have hres : ∀ a, ψb (IsLocalRing.residue Nx.A a) = IsLocalRing.residue Nx.A (Nx.ψ a) := by
    intro a
    rw [hψb]
    exact IsLocalRing.ResidueField.map_residue Nx.ψ a

  have H : ∀ c, ψb c ^ (Nat.card K ^ d) = c := by
    intro c
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective c
    rw [hres, ← map_pow, ← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
    exact Nx.hfrob a
  have H' : ∀ c, ψb (c ^ (Nat.card K ^ d)) = c := fun c => by rw [map_pow, H]
  have hinj : Function.Injective ψb := ψb.injective

  let φb : IsLocalRing.ResidueField Nx.A →+* IsLocalRing.ResidueField Nx.A :=
    { toFun := fun c => c ^ (Nat.card K ^ d)
      map_one' := one_pow _
      map_mul' := fun a b => mul_pow a b _
      map_zero' := hinj (by
        show ψb ((0 : IsLocalRing.ResidueField Nx.A) ^ (Nat.card K ^ d)) = ψb 0
        rw [H', map_zero])
      map_add' := fun a b => hinj (by
        show ψb ((a + b) ^ (Nat.card K ^ d)) = ψb (a ^ (Nat.card K ^ d) + b ^ (Nat.card K ^ d))
        rw [H', map_add, H', H']) }
  have hφψ : φb.comp ψb = RingHom.id _ := RingHom.ext fun c => H c

  obtain ⟨a, ha⟩ : ∃ a : Spec (.of (IsLocalRing.ResidueField Nx.A)) ⟶ Z,
      a = Spec.map (CommRingCat.ofHom (IsLocalRing.residue Nx.A)) ≫ Nx.e.inv ≫ f := ⟨_, rfl⟩
  have hring : (IsLocalRing.residue Nx.A).comp Nx.ψ = ψb.comp (IsLocalRing.residue Nx.A) :=
    RingHom.ext fun a => (hres a).symm
  have SQ1 : Spec.map (CommRingCat.ofHom (IsLocalRing.residue Nx.A)) ≫
      Spec.map (CommRingCat.ofHom Nx.ψ) =
      Spec.map (CommRingCat.ofHom ψb) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue Nx.A)) := by
    rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
      hring]
  have SQ2 : Spec.map (CommRingCat.ofHom Nx.ψ) ≫ Nx.e.inv = Nx.e.inv ≫ Nx.φ.left := by
    rw [← Nx.hψ]
    simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]
  have hsqψ : Spec.map (CommRingCat.ofHom ψb) ≫ a = a ≫ σ := by
    rw [ha]
    simp only [Category.assoc]
    rw [← reassoc_of% SQ1, reassoc_of% SQ2, hf]
  have INV : Spec.map (CommRingCat.ofHom φb) ≫ Spec.map (CommRingCat.ofHom ψb) = 𝟙 _ := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hφψ, CommRingCat.ofHom_id, Spec.map_id]
  have hsqφ : Spec.map (CommRingCat.ofHom φb) ≫ a = a ≫ σ' := by
    calc Spec.map (CommRingCat.ofHom φb) ≫ a
        = Spec.map (CommRingCat.ofHom φb) ≫ (a ≫ σ) ≫ σ' := by
          rw [Category.assoc, hσσ', Category.comp_id]
      _ = Spec.map (CommRingCat.ofHom φb) ≫ (Spec.map (CommRingCat.ofHom ψb) ≫ a) ≫ σ' := by
          rw [hsqψ]
      _ = (Spec.map (CommRingCat.ofHom φb) ≫ Spec.map (CommRingCat.ofHom ψb)) ≫ a ≫ σ' := by
          simp only [Category.assoc]
      _ = a ≫ σ' := by rw [INV, Category.id_comp]


  have crit : ∀ (Ω : Type u) [Field Ω] (Q : ℕ) (φ : Ω →+* Ω), (∀ c, φ c = c ^ Q) →
      ∀ (b : Spec (.of Ω) ⟶ Z), Spec.map (CommRingCat.ofHom φ) ≫ b = b ≫ σ' →
      ∀ p : ↥(Spec (.of Ω)), wcIsFrobAt σ' (b p) Q := by
    intro Ω _ Q φ hφ b h p
    have s1 : ∀ (x : Z) (ι₁ ι₂ : Z.residueField x ⟶ CommRingCat.of Ω),
        Spec.map ι₁ ≫ Z.fromSpecResidueField x = Spec.map ι₂ ≫ Z.fromSpecResidueField x →
          ι₁ = ι₂ := by
      intro x ι₁ ι₂ h
      have h' : (Scheme.SpecToEquivOfField Ω Z).symm ⟨x, ι₁⟩ =
          (Scheme.SpecToEquivOfField Ω Z).symm ⟨x, ι₂⟩ := by
        rw [Scheme.SpecToEquivOfField_symm_apply, Scheme.SpecToEquivOfField_symm_apply]
        exact h
      have h2 := (Scheme.SpecToEquivOfField Ω Z).symm.injective h'
      exact eq_of_heq (Sigma.mk.inj_iff.mp h2).2
    have s2 : ∀ (x : Z) (hx : σ' x = x),
        Spec.map ((Scheme.residueFieldCongr hx).inv ≫ σ'.residueFieldMap x) ≫
          Z.fromSpecResidueField x = Z.fromSpecResidueField x ≫ σ' := by
      intro x hx
      rw [Spec.map_comp, Category.assoc, Scheme.residueFieldCongr_inv,
        Scheme.residueFieldCongr_fromSpecResidueField,
        Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField]
    obtain ⟨⟨x, ι⟩, rfl⟩ : ∃ q, (Scheme.SpecToEquivOfField Ω Z).symm q = b :=
      ⟨_, Equiv.symm_apply_apply _ b⟩
    rw [Scheme.SpecToEquivOfField_symm_apply] at h ⊢
    have hpt : ∀ p : ↥(Spec (.of Ω)), (Spec.map ι ≫ Z.fromSpecResidueField x) p = x := by
      intro p
      rw [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
    rw [hpt p]
    have hx : σ' x = x := by
      have h1 := congrArg (fun g : Spec (.of Ω) ⟶ Z => g p) h
      simp only at h1
      simp only [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply] at h1
      exact h1.symm
    obtain ⟨Fr, hFrdef⟩ : ∃ Fr : Z.residueField x →+* Z.residueField x,
        Fr = ((Scheme.residueFieldCongr hx).inv ≫ σ'.residueFieldMap x).hom := ⟨_, rfl⟩
    have hS : Spec.map (CommRingCat.ofHom Fr) ≫ Z.fromSpecResidueField x =
        Z.fromSpecResidueField x ≫ σ' := by
      rw [hFrdef, CommRingCat.ofHom_hom]
      exact s2 x hx
    refine ⟨Fr, ?_, hS⟩
    have key : ι ≫ CommRingCat.ofHom φ = CommRingCat.ofHom Fr ≫ ι := by
      apply s1 x
      rw [Spec.map_comp, Spec.map_comp, Category.assoc, Category.assoc, hS, h, Category.assoc]
    intro c
    have e := congrArg (fun g => g.hom c) key
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at e
    rw [hφ, ← map_pow] at e
    exact (ι.hom.injective e).symm
  obtain ⟨p⟩ : Nonempty ↥(Spec (.of (IsLocalRing.ResidueField Nx.A))) :=
    ⟨IsLocalRing.closedPoint (IsLocalRing.ResidueField Nx.A)⟩
  have hcrit := crit (IsLocalRing.ResidueField Nx.A) (Nat.card K ^ d) φb (fun c => rfl) a hsqφ p
  have hpt : (Spec.map (CommRingCat.ofHom (IsLocalRing.residue Nx.A))) p =
      IsLocalRing.closedPoint Nx.A :=
    IsLocalRing.PrimeSpectrum.comap_residue _ _
  have hapt : a p = f (Nx.e.inv (IsLocalRing.closedPoint Nx.A)) := by
    rw [ha, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hpt]
  refine ⟨Nx.e.inv (IsLocalRing.closedPoint Nx.A), Nx.hx, ?_⟩
  rw [← hapt]
  exact hcrit

theorem wc_cheb_level_cover (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (φ : W ⟶ W) (hB : wcVQGalFrame D ℓ hP W w r θ φ)
    (Γ : Subgroup (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (Φ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (hΦ : wcVQFrame D ℓ hP W r θ φ (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
    (hΓ : ∀ h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ, h ∈ Γ ↔
      ∃ γ : W ⟶ W, γ ≫ w = w ∧ wcVQFrame D ℓ hP W r θ γ (h : Matrix (Fin r) (Fin r) ℚ_[ℓ])) :
    ∀ (t M : ℕ), 1 ≤ M →
      wcRedMat ℓ t ((Φ ^ M : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = 1 →
      ∃ (Uo : (wcP1Over F'').left.Opens) (Z : Scheme.{u}) (πZ : Z ⟶ Uo.toScheme)
        (G : Subgroup (Multiplicative (ZMod M) × (Matrix (Fin r) (Fin r) (ZMod (ℓ ^ t)))ˣ))
        (act : G → (Z ⟶ Z)) (e : ℤ), (e = 1 ∨ e = -1) ∧
        (∀ x : (wcP1Over F'').left, x ∈ Uo ↔ ∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) ∧
        IsFinite πZ ∧ Etale πZ ∧ ConnectedSpace Z ∧ act 1 = 𝟙 Z ∧
        (∀ g g', act (g * g') = act g ≫ act g') ∧ (∀ g, act g ≫ πZ = πZ) ∧
        (∀ (T : Scheme.{u}), ConnectedSpace T → ∀ (a b : T ⟶ Z), a ≫ πZ = b ≫ πZ →
          ∃! g, b = a ≫ act g) ∧
        (∀ y, y ∈ G ↔ ∃ (b : ℤ) (v : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ), v ∈ Γ ∧
          y.1 = Multiplicative.ofAdd (b : ZMod M) ∧
          (y.2 : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ t))) =
            wcRedMat ℓ t ((Φ ^ (-b) * v : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
              Matrix (Fin r) (Fin r) ℚ_[ℓ])) ∧
        ∀ (d : ℕ) (x : (wcP1Over F'').left), 1 ≤ d → x ∈ wcP1ClosedPt F'' d →
          (∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) →
          ∀ (Nx : wcFrobNbhd F'' x d) (ι : Nx.V ⟶ W) (δ : W ⟶ W)
            (u : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ), δ ≫ w = w → u ∈ Γ →
            wcVQFrame D ℓ hP W r θ ((fun γ : W ⟶ W => φ ≫ γ)^[d] (𝟙 W) ≫ δ)
              ((u * Φ ^ d : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) →
            Nx.φ ≫ ι = ι ≫ ((fun γ : W ⟶ W => φ ≫ γ)^[d] (𝟙 W) ≫ δ) →
            ∃ (z : Z) (y : G), Uo.ι (πZ z) = x ∧
              (y : Multiplicative (ZMod M) × (Matrix (Fin r) (Fin r) (ZMod (ℓ ^ t)))ˣ).1 =
                Multiplicative.ofAdd (((e * d : ℤ)) : ZMod M) ∧
              ((y : Multiplicative (ZMod M) × (Matrix (Fin r) (Fin r) (ZMod (ℓ ^ t)))ˣ).2 :
                  Matrix (Fin r) (Fin r) (ZMod (ℓ ^ t))) =
                wcRedMat ℓ t (((Φ ^ (-(d : ℤ)) * u⁻¹) ^ e : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
                  Matrix (Fin r) (Fin r) ℚ_[ℓ]) ∧
              wcIsFrobAt (act y) z (Nat.card F'' ^ d) :=
by
  classical
  intro t M hM hredM
  obtain ⟨hmul, hred1, -⟩ := wc_cheb_redMat_facts ℓ t r
  obtain ⟨hΓint, hΦint, hΦiint, hnorm⟩ :=
    wc_cheb_frame_group_facts F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ φ hB Γ Φ hΦ hΓ
