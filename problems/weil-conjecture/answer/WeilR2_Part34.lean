    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    (∀ (x : K) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d x → x ≠ 0 →
      ∃ (π : ↥W) (x' : K) (d' : A), π ≠ 0 ∧ d' ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d' x' ∧
        x = algebraMap A K (algebraMap ↥W A π) * x' ∧
        ∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' x') →
    (∀ (x y : K) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d y →
      (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' x) →
      (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' y) →
      ∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' (x * y)) →
    ∀ (f₁ r : K) (d₁ : A), d₁ ∉ 𝔭 → wcLlsKPLoc A K 0 d₁ r → f₁ - 1 = (ℓ : K) * r →
    ∀ β : ↥W, β ^ (ℓ - 1) = ((ℓ : ℕ) : ↥W) →
      (∃ h : K,
        (∃ (d : A) (b s : K), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d b ∧ wcLlsKPLoc A K 0 d s ∧
          (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) ∧ h * s = b) ∧
        (∃ (π : ↥W) (y' : K), π ∈ IsLocalRing.maximalIdeal ↥W ∧
          (∃ (d : A) (b s : K), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d b ∧ wcLlsKPLoc A K 0 d s ∧
