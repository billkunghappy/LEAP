      rintro y (⟨a, rfl⟩ | hy)
      · exact hrange a
      · rw [Set.mem_singleton_iff.mp hy]; exact hs_mem
    exact hcl hx'
  let j : ↥(Algebra.adjoin A {s}) →+* ↥(Algebra.adjoin A₃ {s₃}) :=
    { toFun := fun r => ⟨r.1, hle r.1 r.2⟩
      map_one' := Subtype.ext rfl
      map_mul' := fun _ _ => Subtype.ext rfl
      map_zero' := Subtype.ext rfl
      map_add' := fun _ _ => Subtype.ext rfl }
  have hcompL : (algebraMap ↥(Algebra.adjoin A₃ {s₃}) L).comp j =
      (RingHom.id L).comp (algebraMap ↥(Algebra.adjoin A {s}) L) :=
    RingHom.ext fun _ => rfl
  let J : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) →+*
      ↥(integralClosure ↥(Algebra.adjoin A₃ {s₃}) L) :=
    ((integralClosure ↥(Algebra.adjoin A {s}) L).val.toRingHom).codRestrict
      (integralClosure ↥(Algebra.adjoin A₃ {s₃}) L)
      (fun x => _root_.IsIntegral.map_of_comp_eq j (RingHom.id L) hcompL x.2)
  have hcomp : J.comp (algebraMap ↥(Algebra.adjoin A {s})
      ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) =
