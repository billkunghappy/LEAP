        by_contra hπ
        have hu := (IsLocalRing.notMem_maximalIdeal.mp hπ).pow n
        rw [hπn] at hu
        exact hwnu hu
      · exfalso
        have hz0 : z ≠ 0 := by
          rintro rfl
          exact hzW W.zero_mem
