      obtain ⟨g2, hg2⟩ := ihy
      refine ⟨g1 + g2, ?_⟩
      have e : (⟨x + y, Subalgebra.add_mem _ hx hy⟩ : ↥R) - Polynomial.eval₂ ι Sr (g1 + g2) =
