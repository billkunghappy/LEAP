  clear hlift hJp htJ hle hne heq hW

  have main : ∀ (s : K) (𝔮 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) [𝔮.IsPrime]
      (u0 s0 : T),
      (∀ a : A, a ∉ 𝔭 → algebraMap ↥(Algebra.adjoin A {s})
        ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
        (algebraMap A ↥(Algebra.adjoin A {s}) a) ∉ 𝔮) →
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W, algebraMap ↥(Algebra.adjoin A {s})
        ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
        (algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w)) ∈ 𝔮) →
      (∀ r : K, r ∈ Algebra.adjoin A {s} → ∃ y' : T, j y' = r) →
      (∀ y' : T, ∃ n : ℕ, j y' * algebraMap A K (h * d) ^ n ∈ Algebra.adjoin A {s}) →
      j u0 = algebraMap A K (t - algebraMap ↥W A c) → j s0 = s →
      algebraMap K L s = z' ^ ℓ * μ ^ α →
      (∃ a ∈ 𝔮, ∃ σ, σ ∉ 𝔮 ∧ (σ : L) * z = (a : L)) →
      (∃ a ∈ 𝔮, ∃ σ, σ ∉ 𝔮 ∧ (σ : L) * z' = (a : L)) →
      𝔮.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) =
        Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c),
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) →
      (∃ π' : ↥W, π' ∈ IsLocalRing.maximalIdeal ↥W ∧ ∃ x' : K,
        (∃ n : ℕ, algebraMap A K d ^ n * x' ∈ Algebra.adjoin A {s}) ∧
        x₁ = algebraMap A K (algebraMap ↥W A π') * x') →
      (∃ n : ℕ, algebraMap A K d ^ n * x₂ ∈ Algebra.adjoin A {s}) →
      (∃ n : ℕ, algebraMap A K d ^ n * x₃ ∈ Algebra.adjoin A {s}) →
      -F₁.coeff 0 / algebraMap A K (t - algebraMap ↥W A c) ^ m₀ - 1 =
        x₁ + algebraMap A K (t - algebraMap ↥W A c) * x₂ + s * x₃ →
      (∀ (𝔓 : Ideal (wcLlsKPbdsE T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀)) [𝔓.IsPrime],
        wcLlsKPbdsV T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀ 0 ∈ 𝔓 →
        wcLlsKPbdsV T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀ 1 ∈ 𝔓 →
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W
          (wcLlsKPbdsE T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀)) ≤ 𝔓 →
        wcLlsKPbdsNodeChart W (wcLlsKPbdsE T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀) ζ
          (wcLlsKPbdsV T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀ 0)
          (wcLlsKPbdsV T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀ 1) 𝔓) →
      ∃ 𝔓 : PrimeSpectrum (wcLlsKPbdsE T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀),
        wcLlsKPbdsV T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀ 0 ∈ 𝔓.asIdeal ∧
        wcLlsKPbdsV T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀ 1 ∈ 𝔓.asIdeal ∧
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W
          (wcLlsKPbdsE T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀)) ≤ 𝔓.asIdeal ∧
        Nonempty (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
            ↥(Algebra.adjoin A {s}) 𝔮 ≃+*
          wcLlsKPbdsFib W (wcLlsKPbdsE T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀) 𝔓.asIdeal) := by
    intro s 𝔮 _ u0 s0 hA hm hlift' hden hu0 hs0 hb2 hez hez' hq' hx₁ hx₂ hx₃ hUeq H4

    let jL : T →+* L := (algebraMap K L).comp j
    let θ₁ : MvPolynomial (Fin 4) T →+* L := MvPolynomial.eval₂Hom jL ![z, z', μ, ν]
    have hX0 : θ₁ (MvPolynomial.X 0) = z := MvPolynomial.eval₂Hom_X' _ _ _
    have hX1 : θ₁ (MvPolynomial.X 1) = z' := MvPolynomial.eval₂Hom_X' _ _ _
    have hX2 : θ₁ (MvPolynomial.X 2) = μ := MvPolynomial.eval₂Hom_X' _ _ _
    have hX3 : θ₁ (MvPolynomial.X 3) = ν := MvPolynomial.eval₂Hom_X' _ _ _
    have hC : ∀ y, θ₁ (MvPolynomial.C y) = jL y := fun y => MvPolynomial.eval₂Hom_C _ _ _
    have hjLW : ∀ w : ↥W, jL (algebraMap ↥W T w) = algebraMap A L (algebraMap ↥W A w) := by
      intro w
      simp only [jL, RingHom.comp_apply, hjW]
      rw [← IsScalarTower.algebraMap_apply]
    have e1 : jL (algebraMap ↥W T ζ) = z * z' := by rw [hjLW, ha1]
    have e3 : jL u0 = z ^ ℓ * ν ^ α := by
      simp only [jL, RingHom.comp_apply, hu0]
      rw [← IsScalarTower.algebraMap_apply, hb1]
    have e4 : jL s0 = z' ^ ℓ * μ ^ α := by
      simp only [jL, RingHom.comp_apply, hs0]
      exact hb2
    have e5 : jL UT = algebraMap K L (-F₁.coeff 0 / algebraMap A K (t - algebraMap ↥W A c) ^ m₀) := by
      simp only [jL, RingHom.comp_apply, hUT]
    have e6 : ∑ i ∈ Finset.Ico 1 ℓ, jL (xT i) * (z' ^ m₀ * μ ^ β) ^ (ℓ - i) =
        ∑ i ∈ Finset.Ico 1 ℓ, algebraMap K L (x i) * (z' ^ m₀ * μ ^ β) ^ (ℓ - i) := by
      refine Finset.sum_congr rfl (fun i hi => ?_)
      obtain ⟨hi1, hi2⟩ := Finset.mem_Ico.mp hi
      simp only [jL, RingHom.comp_apply, hxT i hi1 hi2]
    have hI : wcLlsKPbdsI T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀ ≤ RingHom.ker θ₁ := by
      unfold wcLlsKPbdsI
      rw [Ideal.span_le]
      intro p hp
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hp
      rw [SetLike.mem_coe, RingHom.mem_ker]
      rcases hp with rfl | rfl | rfl | rfl | rfl
      · simp only [map_sub, map_mul, hX0, hX1, hC]
        rw [e1, sub_self]
      · simp only [map_sub, map_mul, map_one, hX2, hX3]
        rw [ha2, sub_self]
      · simp only [map_sub, map_mul, map_pow, hX0, hX3, hC]
        rw [e3, sub_self]
      · simp only [map_sub, map_mul, map_pow, hX1, hX2, hC]
        rw [e4, sub_self]
      · simp only [map_sub, map_mul, map_add, map_one, map_sum, map_pow, hX1, hX2, hC]
        rw [e6, hcc, e5, sub_self]
    let θ : wcLlsKPbdsE T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀ →+* L :=
      Ideal.Quotient.lift _ θ₁ (fun a ha => RingHom.mem_ker.mp (hI ha))
    have hθC : ∀ y : T, θ (Ideal.Quotient.mk _ (MvPolynomial.C y)) = jL y := by
      intro y
      exact (Ideal.Quotient.lift_mk _ _ _).trans (hC y)
    have hθ0 : θ (wcLlsKPbdsV T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀ 0) = z :=
      (Ideal.Quotient.lift_mk _ _ _).trans hX0
    have hθ1 : θ (wcLlsKPbdsV T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀ 1) = z' :=
      (Ideal.Quotient.lift_mk _ _ _).trans hX1
    have hθ2 : θ (wcLlsKPbdsV T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀ 2) = μ :=
      (Ideal.Quotient.lift_mk _ _ _).trans hX2
    have hθ3 : θ (wcLlsKPbdsV T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀ 3) = ν :=
      (Ideal.Quotient.lift_mk _ _ _).trans hX3
    have hθW : ∀ w : ↥W, θ (algebraMap ↥W (wcLlsKPbdsE T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀) w) =
        algebraMap A L (algebraMap ↥W A w) := by
      intro w
      rw [← hjLW]
      exact hθC (algebraMap ↥W T w)

    have hu : ∀ y : 𝔮.primeCompl, IsUnit (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) L y) := by
      intro y
      rw [isUnit_iff_ne_zero]
      intro h0
      apply y.2
      have h0' : (y : ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) = 0 := Subtype.ext h0
      rw [h0']
      exact 𝔮.zero_mem
    let lam : Localization.AtPrime 𝔮 →+* L :=
      IsLocalization.lift (M := 𝔮.primeCompl) (S := Localization.AtPrime 𝔮) hu
    have hlamB : ∀ c' : ↥(integralClosure ↥(Algebra.adjoin A {s}) L),
        lam (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime 𝔮) c') =
          (c' : L) :=
      fun c' => IsLocalization.lift_eq hu c'
    have hlaminj : Function.Injective lam := by
      apply (IsLocalization.lift_injective_iff (M := 𝔮.primeCompl) (S := Localization.AtPrime 𝔮)
        hu).mpr
      intro x' y'
      constructor
      · intro h'
        have h1 := congrArg lam h'
        rw [hlamB, hlamB] at h1
        exact h1
      · intro h'
        have h1 : x' = y' := Subtype.ext h'
        rw [h1]
    have hlammk : ∀ (a : ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) (σ : 𝔮.primeCompl),
        lam (IsLocalization.mk' (Localization.AtPrime 𝔮) a σ) *
          ((σ : ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) : L) = (a : L) := by
      intro a σ
      have h1 := (IsLocalization.lift_mk'_spec (M := 𝔮.primeCompl) (S := Localization.AtPrime 𝔮)
        (g := algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) L) hu a
        (lam (IsLocalization.mk' (Localization.AtPrime 𝔮) a σ)) σ).mp rfl
      rw [mul_comm]
      exact h1.symm
    have hσ0 : ∀ σ : ↥(integralClosure ↥(Algebra.adjoin A {s}) L), σ ∉ 𝔮 → (σ : L) ≠ 0 := by
      intro σ hσ h0
      apply hσ
      have h0' : σ = 0 := Subtype.ext h0
      rw [h0']
      exact 𝔮.zero_mem
    have hrng : ∀ (l : L) (a σ : ↥(integralClosure ↥(Algebra.adjoin A {s}) L)), σ ∉ 𝔮 →
        (σ : L) * l = (a : L) → l ∈ (RingHom.range (R := Localization.AtPrime 𝔮) lam) := by
      intro l a σ hσ hsl
      refine ⟨IsLocalization.mk' (Localization.AtPrime 𝔮) a (⟨σ, hσ⟩ : 𝔮.primeCompl), ?_⟩
      have h1 := hlammk a ⟨σ, hσ⟩
      apply mul_right_cancel₀ (hσ0 σ hσ)
      rw [h1, mul_comm]
      exact hsl.symm
    have hTmem : ∀ y : T, θ (Ideal.Quotient.mk _ (MvPolynomial.C y)) ∈ (RingHom.range (R := Localization.AtPrime 𝔮) lam) := by
      intro y
      obtain ⟨n, hn⟩ := hden y
      refine hrng _ (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
          ⟨_, hn⟩)
        (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
          (algebraMap A ↥(Algebra.adjoin A {s}) ((h * d) ^ n))) (hA _ (hhdn n)) ?_
      rw [hθC]
      show algebraMap K L (algebraMap A K ((h * d) ^ n)) * algebraMap K L (j y) =
        algebraMap K L (j y * algebraMap A K (h * d) ^ n)
      rw [← map_mul, map_pow, mul_comm]


    have hunit1 : ∀ y mm : Localization.AtPrime 𝔮,
        mm ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) → y = 1 + mm → IsUnit y := by
      intro y mm hmm hy
      have hr : IsLocalRing.residue (Localization.AtPrime 𝔮) y ≠ 0 := by
        rw [hy, map_add, map_one, (IsLocalRing.residue_eq_zero_iff mm).mpr hmm, add_zero]
        exact one_ne_zero
      exact (IsLocalRing.residue_ne_zero_iff_isUnit y).mp hr
    have hmaxL : ∀ (l : L) (a σ : ↥(integralClosure ↥(Algebra.adjoin A {s}) L)), σ ∉ 𝔮 → a ∈ 𝔮 →
        (σ : L) * l = (a : L) →
        ∃ yb ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮), lam yb = l := by
      intro l a σ hσ ha hsl
      refine ⟨IsLocalization.mk' (Localization.AtPrime 𝔮) a (⟨σ, hσ⟩ : 𝔮.primeCompl), ?_, ?_⟩
      · by_contra hn
        have hu1 := IsLocalRing.notMem_maximalIdeal.mp hn
        have hu2 : IsUnit (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
            (Localization.AtPrime 𝔮) σ) :=
          (IsLocalization.AtPrime.isUnit_to_map_iff _ 𝔮 σ).mpr (Ideal.mem_primeCompl_iff.mpr hσ)
        have hin := (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔮) 𝔮 a).mpr ha
        rw [← IsLocalization.mk'_spec (Localization.AtPrime 𝔮) a (⟨σ, hσ⟩ : 𝔮.primeCompl)] at hin
        exact (IsLocalRing.notMem_maximalIdeal.mpr (hu1.mul hu2)) hin
      · have h1 := hlammk a ⟨σ, hσ⟩
        apply mul_right_cancel₀ (hσ0 σ hσ)
        rw [h1, mul_comm]
        exact hsl.symm
    have hmB : ∀ cc : ↥(integralClosure ↥(Algebra.adjoin A {s}) L), cc ∈ 𝔮 →
        algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime 𝔮) cc ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) :=
      fun cc hcc' =>
        (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔮) 𝔮 cc).mpr hcc'
    have hez'c := hez'
    obtain ⟨a', ha', σ', hσ', hz'σ⟩ := hez'c
    have hsC : algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∈ 𝔮 := by
      have h3 : (⟨s, Algebra.subset_adjoin (Set.mem_singleton _)⟩ : ↥(Algebra.adjoin A {s})) ∈
          𝔮.comap (algebraMap ↥(Algebra.adjoin A {s})
            ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) := by
        rw [hq']
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
      exact h3
    have huC : algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
        (algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c)) ∈ 𝔮 := by
      have h3 : algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c) ∈
          𝔮.comap (algebraMap ↥(Algebra.adjoin A {s})
            ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) := by
        rw [hq']
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
      exact h3
    obtain ⟨sC, hsC𝔮, hsCL⟩ : ∃ sC : ↥(integralClosure ↥(Algebra.adjoin A {s}) L),
        sC ∈ 𝔮 ∧ (sC : L) = algebraMap K L s := ⟨_, hsC, rfl⟩

    have hα1 : 1 ≤ α := by
      rcases Nat.eq_zero_or_pos α with h0 | h0
      · rw [h0, zero_mul] at hαβ; omega
      · exact h0
    have hYα : (z' ^ m₀ * μ ^ β) ^ α = z' * (algebraMap K L s) ^ β := by
      rw [hb2]
      have e : m₀ * α = 1 + ℓ * β := by rw [mul_comm m₀ α, mul_comm ℓ β]; exact hαβ
      calc (z' ^ m₀ * μ ^ β) ^ α = z' ^ (m₀ * α) * μ ^ (α * β) := by ring
        _ = z' ^ (1 + ℓ * β) * μ ^ (α * β) := by rw [e]
        _ = z' * (z' ^ ℓ * μ ^ α) ^ β := by ring
    have hwα : ((σ' : L) * (z' ^ m₀ * μ ^ β)) ^ α =
        ((σ' ^ (α - 1) * a' * sC ^ β : ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) : L) := by
      have hk : α = (α - 1) + 1 := by omega
      rw [mul_pow, hYα, ← hsCL, MulMemClass.coe_mul, MulMemClass.coe_mul, SubmonoidClass.coe_pow,
        SubmonoidClass.coe_pow, ← hz'σ]
      conv_lhs => rw [hk]
      ring
    have hwint : IsIntegral ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
        ((σ' : L) * (z' ^ m₀ * μ ^ β)) :=
      ⟨Polynomial.X ^ α - Polynomial.C (σ' ^ (α - 1) * a' * sC ^ β),
        Polynomial.monic_X_pow_sub_C _ (by omega), by
          rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hwα, sub_eq_zero]
          rfl⟩
    have hwR : IsIntegral ↥(Algebra.adjoin A {s}) ((σ' : L) * (z' ^ m₀ * μ ^ β)) :=
      isIntegral_trans _ hwint
    let wC : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) :=
      ⟨_, (mem_integralClosure_iff _ _).mpr hwR⟩
    have hwC𝔮 : wC ∈ 𝔮 := by
      apply (inferInstance : 𝔮.IsPrime).mem_of_pow_mem α
      have h3 : wC ^ α = σ' ^ (α - 1) * a' * sC ^ β :=
        Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hwα)
      rw [h3]
      exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ ha')
    obtain ⟨YB, hYBm, hYB⟩ := hmaxL (z' ^ m₀ * μ ^ β) wC σ' hσ' hwC𝔮 rfl

    have hxB : ∀ i, ∃ xb : Localization.AtPrime 𝔮, lam xb = jL (xT i) := by
      intro i
      have h3 := hTmem (xT i)
      rw [hθC] at h3
      exact RingHom.mem_range.mp h3
    choose xb hxb using hxB
    have hVmem : (∑ i ∈ Finset.Ico 1 ℓ, xb i * YB ^ (ℓ - i)) ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) :=
      Ideal.sum_mem _ (fun i hi => Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hYBm _
        (by have := (Finset.mem_Ico.mp hi).2; omega)))
    have hVu : IsUnit (1 + ∑ i ∈ Finset.Ico 1 ℓ, xb i * YB ^ (ℓ - i)) :=
      hunit1 _ _ hVmem rfl
    have hlamV : lam (1 + ∑ i ∈ Finset.Ico 1 ℓ, xb i * YB ^ (ℓ - i)) =
        1 + ∑ i ∈ Finset.Ico 1 ℓ, algebraMap K L (x i) * (z' ^ m₀ * μ ^ β) ^ (ℓ - i) := by
      rw [map_add, map_one, map_sum]
      congr 1
      refine Finset.sum_congr rfl (fun i hi => ?_)
      obtain ⟨hi1, hi2⟩ := Finset.mem_Ico.mp hi
      rw [map_mul, map_pow, hxb, hYB]
      simp only [jL, RingHom.comp_apply, hxT i hi1 hi2]

    obtain ⟨π', hπ', x', ⟨n₁, hn₁⟩, hx₁eq⟩ := hx₁
    obtain ⟨n₂, hn₂⟩ := hx₂
    obtain ⟨n₃, hn₃⟩ := hx₃
    have hlocB : ∀ (y : K) (n : ℕ), algebraMap A K d ^ n * y ∈ Algebra.adjoin A {s} →
        ∃ yb : Localization.AtPrime 𝔮, lam yb = algebraMap K L y := by
      intro y n hn
      refine RingHom.mem_range.mp (hrng _ (algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L) ⟨_, hn⟩)
        (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
          (algebraMap A ↥(Algebra.adjoin A {s}) (d ^ n))) (hA _ (hdn n)) ?_)
      show algebraMap K L (algebraMap A K (d ^ n)) * algebraMap K L y =
        algebraMap K L (algebraMap A K d ^ n * y)
      rw [← map_mul, map_pow]
    obtain ⟨x'B, hx'B⟩ := hlocB x' n₁ hn₁
    obtain ⟨x₂B, hx₂B⟩ := hlocB x₂ n₂ hn₂
    obtain ⟨x₃B, hx₃B⟩ := hlocB x₃ n₃ hn₃
    obtain ⟨UmB, hUmB, hlamUm⟩ : ∃ UmB ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮),
        lam UmB = algebraMap K L (x₁ + algebraMap A K (t - algebraMap ↥W A c) * x₂ + s * x₃) :=
      ⟨algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime 𝔮)
          (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
            (algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A π'))) * x'B +
        algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime 𝔮)
          (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
            (algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c))) * x₂B +
        algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime 𝔮) sC * x₃B,
        Ideal.add_mem _ (Ideal.add_mem _ (Ideal.mul_mem_right _ _ (hmB _ (hm π' hπ')))
          (Ideal.mul_mem_right _ _ (hmB _ huC))) (Ideal.mul_mem_right _ _ (hmB _ hsC𝔮)), by
        simp only [map_add, map_mul, hlamB, hx'B, hx₂B, hx₃B, hsCL, hx₁eq]
        all_goals rfl⟩
    have hUu : IsUnit (1 + UmB) := hunit1 _ _ hUmB rfl
    have hlamU : lam (1 + UmB) =
        algebraMap K L (-F₁.coeff 0 / algebraMap A K (t - algebraMap ↥W A c) ^ m₀) := by
      rw [map_add, map_one, hlamUm, ← hUeq, map_sub, map_one]
      ring
    have hμV : μ * lam (1 + ∑ i ∈ Finset.Ico 1 ℓ, xb i * YB ^ (ℓ - i)) = lam (1 + UmB) := by
      rw [hlamV, hlamU]
      exact hcc
    have hinvV : lam (1 + ∑ i ∈ Finset.Ico 1 ℓ, xb i * YB ^ (ℓ - i)) * lam (↑hVu.unit⁻¹) = 1 := by
      rw [← map_mul, hVu.mul_val_inv, map_one]
    have hinvU : lam (1 + UmB) * lam (↑hUu.unit⁻¹) = 1 := by
      rw [← map_mul, hUu.mul_val_inv, map_one]
    have hμr : μ ∈ (RingHom.range (R := Localization.AtPrime 𝔮) lam) :=
      ⟨(1 + UmB) * ↑hVu.unit⁻¹, by rw [map_mul, ← hμV, mul_assoc, hinvV, mul_one]⟩
    have hνr : ν ∈ (RingHom.range (R := Localization.AtPrime 𝔮) lam) := by
      refine ⟨(1 + ∑ i ∈ Finset.Ico 1 ℓ, xb i * YB ^ (ℓ - i)) * ↑hUu.unit⁻¹, ?_⟩
      rw [map_mul]
      calc lam (1 + ∑ i ∈ Finset.Ico 1 ℓ, xb i * YB ^ (ℓ - i)) * lam (↑hUu.unit⁻¹)
          = (μ * ν) * (lam (1 + ∑ i ∈ Finset.Ico 1 ℓ, xb i * YB ^ (ℓ - i)) *
              lam (↑hUu.unit⁻¹)) := by rw [ha2, one_mul]
        _ = ν * ((μ * lam (1 + ∑ i ∈ Finset.Ico 1 ℓ, xb i * YB ^ (ℓ - i))) *
              lam (↑hUu.unit⁻¹)) := by ring
        _ = ν := by rw [hμV, hinvU, mul_one]
    have hgen : ∀ i : Fin 4, θ (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ (RingHom.range (R := Localization.AtPrime 𝔮) lam) := by
      intro i
      fin_cases i
      · obtain ⟨a, -, σ, hσ, hs'⟩ := hez
        exact hrng _ a σ hσ (by convert hs' using 2 <;> exact hθ0)
      · obtain ⟨a, -, σ, hσ, hs'⟩ := hez'
        exact hrng _ a σ hσ (by convert hs' using 2 <;> exact hθ1)
      · show θ (Ideal.Quotient.mk _ (MvPolynomial.X 2)) ∈ _
        rw [hθ2]; exact hμr
      · show θ (Ideal.Quotient.mk _ (MvPolynomial.X 3)) ∈ _
        rw [hθ3]; exact hνr
    have hθrange : ∀ y, θ y ∈ (RingHom.range (R := Localization.AtPrime 𝔮) lam) := by
      intro y
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
      induction p using MvPolynomial.induction_on with
      | C a => exact hTmem a
      | add p q hp hq => rw [map_add, map_add]; exact (RingHom.range (R := Localization.AtPrime 𝔮) lam).add_mem hp hq
      | mul_X p n hp => rw [map_mul, map_mul]; exact (RingHom.range (R := Localization.AtPrime 𝔮) lam).mul_mem hp (hgen n)
    have hRinj : Function.Injective (RingHom.rangeRestrict (R := Localization.AtPrime 𝔮) lam) := by
      intro a b' hab
      apply hlaminj
      have h1 := congrArg Subtype.val hab
      simpa using h1
    let eR := RingEquiv.ofBijective (RingHom.rangeRestrict (R := Localization.AtPrime 𝔮) lam) ⟨hRinj, by rintro ⟨_, ⟨a, rfl⟩⟩; exact ⟨a, rfl⟩⟩
    let φ₀ : wcLlsKPbdsE T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀ →+* Localization.AtPrime 𝔮 :=
      (eR.symm : (RingHom.range (R := Localization.AtPrime 𝔮) lam) →+* Localization.AtPrime 𝔮).comp (θ.codRestrict (RingHom.range (R := Localization.AtPrime 𝔮) lam) hθrange)
    have hφ₀ : ∀ y, lam (φ₀ y) = θ y := by
      intro y
      have h1 : (RingHom.rangeRestrict (R := Localization.AtPrime 𝔮) lam) (φ₀ y) = θ.codRestrict (RingHom.range (R := Localization.AtPrime 𝔮) lam) hθrange y := by
        show eR (eR.symm _) = _
        exact eR.apply_symm_apply _
      have h2 := congrArg Subtype.val h1
      simpa using h2
    have hchar : ∀ (y) (a σ : ↥(integralClosure ↥(Algebra.adjoin A {s}) L)),
        (σ : L) * θ y = (a : L) →
        φ₀ y * algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime 𝔮) σ =
          algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime 𝔮) a := by
      intro y a σ hsl
      apply hlaminj
      rw [map_mul, hφ₀, hlamB, hlamB, mul_comm]
      exact hsl

    have hmaxmem : ∀ (y : Localization.AtPrime 𝔮) (a σ : ↥(integralClosure ↥(Algebra.adjoin A {s}) L)),
        σ ∉ 𝔮 → a ∈ 𝔮 →
        y * algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime 𝔮) σ =
          algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime 𝔮) a →
        y ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
      intro y a σ hσ ha hy
      by_contra hn
      have hu1 := IsLocalRing.notMem_maximalIdeal.mp hn
      have hu2 : IsUnit (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
          (Localization.AtPrime 𝔮) σ) :=
        (IsLocalization.AtPrime.isUnit_to_map_iff _ 𝔮 σ).mpr (Ideal.mem_primeCompl_iff.mpr hσ)
      have hin := (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔮) 𝔮 a).mpr ha
      rw [← hy] at hin
      exact (IsLocalRing.notMem_maximalIdeal.mpr (hu1.mul hu2)) hin
    have h1q : (1 : ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) ∉ 𝔮 :=
      fun h1 => (inferInstance : 𝔮.IsPrime).ne_top ((Ideal.eq_top_iff_one _).mpr h1)
    have hφ₀W : ∀ w : ↥W,
        φ₀ (algebraMap ↥W (wcLlsKPbdsE T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀) w) =
        algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime 𝔮)
          (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
            (algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w))) := by
      intro w
      have h1 := hchar (algebraMap ↥W (wcLlsKPbdsE T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀) w)
        (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
            (algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w))) 1 (by
          rw [hθW, OneMemClass.coe_one, one_mul]
          rw [IsScalarTower.algebraMap_apply A K L]
          rfl)
      rw [map_one, mul_one] at h1
      exact h1
    let 𝔓 : Ideal (wcLlsKPbdsE T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀) :=
      Ideal.comap φ₀ (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮))
    haveI h𝔓 : 𝔓.IsPrime := Ideal.comap_isPrime φ₀ _
    have hZ : wcLlsKPbdsV T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀ 0 ∈ 𝔓 := by
      obtain ⟨a, ha, σ, hσ, hs'⟩ := hez
      exact hmaxmem _ a σ hσ ha (hchar _ a σ (by rw [hθ0]; exact hs'))
    have hZ' : wcLlsKPbdsV T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀ 1 ∈ 𝔓 := by
      obtain ⟨a, ha, σ, hσ, hs'⟩ := hez'
      exact hmaxmem _ a σ hσ ha (hchar _ a σ (by rw [hθ1]; exact hs'))
    have h𝔪 : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W
        (wcLlsKPbdsE T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀)) ≤ 𝔓 := by
      rw [Ideal.map_le_iff_le_comap]
      intro w hw
      show φ₀ (algebraMap ↥W (wcLlsKPbdsE T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀) w) ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)
      rw [hφ₀W]
      exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔮) 𝔮 _).mpr
        (hm w hw)

    obtain ⟨hDD, hDI, gD, hgFU, hgEFT, hgC, hg0, -⟩ := s3 _ ζ _ _ 𝔓 hζ0 (H4 𝔓 hZ hZ' h𝔪)
    haveI := hDD
    haveI := hDI
    haveI : IsDomain (wcEbntN W ζ) := (wcNd_nodal_poly_normal Ω W ζ hζ0).1

    have hg2 : ∀ y : 𝔓.primeCompl, IsUnit (φ₀ y) :=
      fun y => IsLocalRing.notMem_maximalIdeal.mp y.2
    let φ : Localization.AtPrime 𝔓 →+* Localization.AtPrime 𝔮 :=
      IsLocalization.lift (M := 𝔓.primeCompl) (S := Localization.AtPrime 𝔓) hg2
    have hφ : ∀ y, φ (algebraMap _ (Localization.AtPrime 𝔓) y) = φ₀ y :=
      fun y => IsLocalization.lift_eq hg2 y
    have hloc : IsLocalHom φ := by
      refine ⟨fun a ha => ?_⟩
      obtain ⟨⟨x0, σ⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔓.primeCompl a
      have h1 := (IsLocalization.lift_mk'_spec (M := 𝔓.primeCompl) (S := Localization.AtPrime 𝔓)
        (g := φ₀) hg2 x0 (φ (IsLocalization.mk' (Localization.AtPrime 𝔓) x0 σ)) σ).mp rfl
      have hu' : IsUnit (φ₀ x0) := by
        rw [h1]
        exact (hg2 σ).mul ha
      have hx : x0 ∈ 𝔓.primeCompl := by
        intro hx𝔓
        exact (IsLocalRing.notMem_maximalIdeal.mpr hu') hx𝔓
      exact (IsLocalization.AtPrime.isUnit_mk'_iff (Localization.AtPrime 𝔓) 𝔓 x0 σ).mpr hx
    let jD : Localization.AtPrime 𝔓 →+* L := lam.comp φ
    have hjD : ∀ y, jD (algebraMap _ (Localization.AtPrime 𝔓) y) = θ y := by
      intro y
      show lam (φ (algebraMap _ (Localization.AtPrime 𝔓) y)) = θ y
      rw [hφ, hφ₀]

    have hjDinj : Function.Injective jD := by
      refine s4 (wcEbntN W ζ) (Localization.AtPrime 𝔓) L gD jD hgFU hgEFT ?_
      refine s2 L ((algebraMap A L).comp (algebraMap ↥W A)) ζ z z' hζ0 ha1 htr (jD.comp gD) ?_ ?_
      · refine RingHom.ext (fun w => ?_)
        have h1 := RingHom.congr_fun hgC w
        simp only [RingHom.comp_apply] at h1 ⊢
        rw [h1, hjD, hθW]
      · rw [RingHom.comp_apply, hg0, hjD, hθ0]

    have hR : ∀ r : ↥(Algebra.adjoin A {s}), ∃ x0 : Localization.AtPrime 𝔓,
        jD x0 = algebraMap ↥(Algebra.adjoin A {s}) L r := by
      intro r
      obtain ⟨y', hy'⟩ := hlift' (r : K) r.2
      refine ⟨algebraMap _ (Localization.AtPrime 𝔓) (Ideal.Quotient.mk
        (wcLlsKPbdsI T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀) (MvPolynomial.C y')), ?_⟩
      rw [hjD, hθC]
      show algebraMap K L (j y') = algebraMap K L (r : K)
      rw [hy']

    have hgen₁ := (wcLlsKPas_minpoly_dvd K L K (algebraMap K K).injective ℓ hℓ hdeg w₁ F₁ hw₁
      hmon hdeg₁ hroot).2.2
    have hG : ∀ l : L, ∃ x0 y0 : Localization.AtPrime 𝔓, jD y0 ≠ 0 ∧ l * jD y0 = jD x0 := by
      intro l
      letI : Algebra (Localization.AtPrime 𝔓) L := jD.toAlgebra
      obtain ⟨y, G, hy0, hyl⟩ := wcLlsKPas_generation A K L ↥(Algebra.adjoin A {s})
        (Localization.AtPrime 𝔓) (algebraMap A ↥(Algebra.adjoin A {s})) w₁ (fun a => rfl)
        hR hgen₁ l
      obtain ⟨y'', hy''⟩ := hR y
      have hWd : jD (algebraMap _ (Localization.AtPrime 𝔓)
          (wcLlsKPbdsV T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀ 0 ^ m₀ *
            wcLlsKPbdsV T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀ 3 ^ β)) = w₁ := by
        rw [hjD, map_mul, map_pow, map_pow, hθ0, hθ3, hdw]
      refine ⟨G.eval (algebraMap _ (Localization.AtPrime 𝔓)
          (wcLlsKPbdsV T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀ 0 ^ m₀ *
            wcLlsKPbdsV T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀ 3 ^ β)), y'', ?_, ?_⟩
      · rw [hy'']; exact hy0
      · rw [hy'', hyl, Polynomial.aeval_def, ← hWd]
        exact Polynomial.eval₂_at_apply jD _

    have hZc : ∀ x0 : Localization.AtPrime 𝔓, ∃ a σ : ↥(integralClosure ↥(Algebra.adjoin A {s}) L),
        σ ∉ 𝔮 ∧ φ x0 * algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
          (Localization.AtPrime 𝔮) σ =
          algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime 𝔮) a ∧
        jD x0 * (σ : L) = (a : L) := by
      intro x0
      obtain ⟨⟨a, σ⟩, hzs⟩ := IsLocalization.mk'_surjective 𝔮.primeCompl (φ x0)
      refine ⟨a, σ, σ.2, ?_, ?_⟩
      · rw [← hzs]
        exact IsLocalization.mk'_spec _ a σ
      · show lam (φ x0) * _ = _
        rw [← hzs]
        exact hlammk a σ
    have hbij := wcLlsKPas_local_model_bijective ↥(Algebra.adjoin A {s}) L 𝔮
      (Localization.AtPrime 𝔓) jD φ hjDinj hloc hG hR hZc

    refine ⟨⟨𝔓, h𝔓⟩, hZ, hZ', h𝔪, ?_⟩
    let Φ : Localization.AtPrime 𝔓 ≃+* Localization.AtPrime 𝔮 := RingEquiv.ofBijective φ hbij
    have hspan : Ideal.span {b' : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (b' : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} =
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
            ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) := by
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro b' ⟨w, hw', hb'⟩
        have hb'' : b' = ((algebraMap ↥(Algebra.adjoin A {s})
            ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
            ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) w := by
          apply Subtype.ext
          rw [hb']
          rfl
        rw [hb'']
        exact Ideal.mem_map_of_mem _ hw'
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw'
        exact Ideal.subset_span ⟨w, hw', rfl⟩
    have hJ : Ideal.map (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
          (Localization.AtPrime 𝔮))
        (Ideal.span {b' : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
            (b' : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}) =
        Ideal.map (Φ : Localization.AtPrime 𝔓 →+* Localization.AtPrime 𝔮)
          (((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W
            (wcLlsKPbdsE T u0 s0 (algebraMap ↥W T ζ) UT xT ℓ α β m₀))).map
            (algebraMap _ (Localization.AtPrime 𝔓))) := by
      rw [hspan, Ideal.map_map, Ideal.map_map, Ideal.map_map]
      congr 1
      refine RingHom.ext (fun w => ?_)
      simp only [RingHom.comp_apply]
      show _ = φ (algebraMap _ (Localization.AtPrime 𝔓) (algebraMap ↥W _ w))
      rw [hφ, hφ₀W]
    unfold wcLlsFS
    exact ⟨(Ideal.quotientEquiv _ _ Φ hJ).symm⟩
  exact main _ 𝔮 (π (wcEbntX W b 0)) (π (wcEbntX W b 1)) hA hWq
    hlift' hden hπ0 hπ1 hb2 hez hez' hq hx₁ hx₂ hx₃ hUeq H4

theorem wcLlsKP_bdatum_sep : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ (c b : ↥W) (d : A) (w₁ : L) (F₁ : Polynomial K) (m₀ : ℕ) (ω ζ : ↥W),
      c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
      wcLlsKPBoundaryCore W A K L ℓ 𝔭 t c b d w₁ F₁ m₀ ω ζ →
      wcLlsDiscSep W A K L t c b :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD hdeg c b d w₁ F₁ m₀
    ω ζ hc hb hb0 hB
  classical
  unfold wcLlsDiscSep wcLlsSepAt
  intro 𝔮 _ hq
  have hB' := hB
  unfold wcLlsKPBoundaryCore at hB'
  obtain ⟨hd, -, -, -, -, -, -, -, hζb, hxi, hndvd, hm₀, hUloc, -⟩ := hB'

  have hcop : m₀.Coprime ℓ := ((Nat.Prime.coprime_iff_not_dvd hℓ).mpr hndvd).symm
  obtain ⟨α, -, hα⟩ := Nat.exists_mul_mod_eq_one_of_coprime hcop hℓ.one_lt
  have hdm := Nat.div_add_mod (m₀ * α) ℓ
  rw [hα] at hdm
  have hαβ : α * m₀ = 1 + (m₀ * α / ℓ) * ℓ := by
    linarith [mul_comm α m₀, mul_comm (m₀ * α / ℓ) ℓ]

  have hζm : ζ ∈ IsLocalRing.maximalIdeal ↥W := by
    apply (IsLocalRing.maximalIdeal.isMaximal ↥W).isPrime.mem_of_pow_mem ℓ
    rw [hζb]; exact hb
  have hζ0 : ζ ≠ 0 := by
    rintro rfl
    apply hb0
    rw [← hζb, zero_pow hℓ.ne_zero]

  let x : ℕ → K := fun i =>
    if h : 1 ≤ i ∧ i < ℓ then Classical.choose (hxi i h.1 h.2) else 0
  have hx : ∀ i, 1 ≤ i → i < ℓ → wcLlsKPLoc A K (wcLlsScV W A K t c b) d (x i) ∧
      F₁.coeff i = algebraMap A K (algebraMap ↥W A ζ) ^ (m₀ * (ℓ - i)) * x i := by
    intro i h1 h2
    have hs := Classical.choose_spec (hxi i h1 h2)
    simp only [x, dite_cond_eq_true (eq_true (And.intro h1 h2))]
