  have hrigid : ∀ M : Ideal ↥(Algebra.adjoin A {s}), Nb ≤ M → M ≠ ⊤ → M = Nb := by
    intro M hNM' hMt'
    have hP : M.comap (algebraMap A ↥(Algebra.adjoin A {s})) = 𝔭 :=
      (Ideal.IsMaximal.eq_of_le h𝔭max (Ideal.comap_ne_top _ hMt')
