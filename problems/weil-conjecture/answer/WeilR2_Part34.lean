    intro k hk j hj
    rw [hT]
    split_ifs with hikj
    · have hk1 : 1 ≤ k := (Finset.mem_Ioo.mp hk).1
      obtain ⟨μ, hμ, -⟩ := hroot ℓ (β ^ (m₀ - j)) (w * y ^ k) _ (by omega)
        (pow_ne_zero _ hβ0) (hpowid k j hk1 hikj hj)
      exact ⟨(((ℓ.choose k / ℓ : ℕ) : ↥W)) * γ ^ (k - 1) * (H ^ (ℓ - k)).coeff (j - i * k) * μ,
        by linear_combination ((((ℓ.choose k / ℓ : ℕ) : ↥W)) * γ ^ (k - 1) *
          (H ^ (ℓ - k)).coeff (j - i * k)) * hμ⟩
    · exact dvd_zero _

  have hM : ∀ k j, T k j ∈ M := by
    intro k j
    rw [hT]
    split_ifs
    · have heq : (((ℓ.choose k / ℓ : ℕ) : ↥W)) * w * γ ^ (k - 1) * y ^ k * (H ^ (ℓ - k)).coeff (j - i * k)
          = w * ((((ℓ.choose k / ℓ : ℕ) : ↥W)) * γ ^ (k - 1) * y ^ k * (H ^ (ℓ - k)).coeff (j - i * k)) := by
        ring
      rw [heq]
      exact M.mul_mem_right _ hwM
    · exact M.zero_mem
  have hFl : G'.coeff (ℓ * i) = -∑ k ∈ Finset.Ioo 0 ℓ, T k (ℓ * i) := by
    rw [hF, if_pos rfl, ← hy]; ring
  have hFj : ∀ j, j ≠ ℓ * i → G'.coeff j - G.coeff j = -∑ k ∈ Finset.Ioo 0 ℓ, T k j := by
    intro j hj
    rw [hF, if_neg hj]; ring
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  ·
    intro j hj
    by_cases hji : j = ℓ * i
    · rw [hji, hFl]
      exact (dvd_neg).mpr (Finset.dvd_sum fun k hk => hB k hk _ hli.le)
    · rw [hF, if_neg hji, sub_zero]
      exact dvd_sub (hG j hj) (Finset.dvd_sum fun k hk => hB k hk j hj.le)
  ·
    rw [hFj m₀ hli.ne']
    exact neg_mem (Ideal.sum_mem _ fun k _ => hM k m₀)
  ·
    rw [hH', Polynomial.coeff_add, ← Polynomial.C_mul, Polynomial.coeff_C_mul_X_pow,
      if_neg (by omega), add_zero]
  ·
    have hT0 : ∀ k ∈ Finset.Ioo 0 ℓ, T k 0 = 0 := by
      intro k hk
      rw [hT, if_neg]
      have h1 := (Finset.mem_Ioo.mp hk).1
      have h2 := Nat.mul_pos (show 0 < i by omega) h1
      omega
    rw [hF 0, Finset.sum_eq_zero hT0, if_neg hli_pos.ne, sub_zero, sub_zero]
  ·
    rw [hF 1, if_neg (Nat.ne_of_lt (by linarith) : (1 : ℕ) ≠ ℓ * i), sub_zero]
    rcases Nat.lt_or_ge 1 i with hi2 | hi2
    · refine ⟨0, M.zero_mem, ?_⟩
      rw [Finset.sum_eq_zero, sub_zero, mul_zero, add_zero]
      intro k hk
      rw [hT, if_neg]
      have h1 := (Finset.mem_Ioo.mp hk).1
      have h3 : 1 < i * k := by nlinarith
      omega
    · obtain rfl : i = 1 := by omega
      rw [Finset.sum_eq_single 1 (fun k hk hk1 => by
          rw [hT, if_neg]; have := (Finset.mem_Ioo.mp hk).1; omega)
        (fun h => absurd (Finset.mem_Ioo.mpr ⟨by norm_num, by omega⟩) h)]
      rw [hT, if_pos (by norm_num)]
      have hm1 : 1 ≤ m₀ := by linarith
      obtain ⟨μ₀, hμ₀, hμ₀n⟩ := hroot ℓ (β ^ (m₀ - 1)) (w * y ^ 1) _ (by omega)
        (pow_ne_zero _ hβ0) (hpowid 1 1 le_rfl (by norm_num) hm1)
      have hμ₀M : μ₀ ∈ M := hMprime.mem_of_pow_mem ℓ (by
        rw [hμ₀n]; exact M.mul_mem_right _ (M.mul_mem_left _ hc))
      refine ⟨-((((ℓ.choose 1 / ℓ : ℕ) : ↥W)) * γ ^ (1 - 1) * (H ^ (ℓ - 1)).coeff (1 - 1 * 1) * μ₀),
        neg_mem (M.mul_mem_left _ hμ₀M), ?_⟩
      linear_combination (-((((ℓ.choose 1 / ℓ : ℕ) : ↥W)) * γ ^ (1 - 1) *
        (H ^ (ℓ - 1)).coeff (1 - 1 * 1))) * hμ₀
  ·
    intro j hj
    have h := hlevel (G'.coeff j - G.coeff j) (by
      rw [hFj j hj]; exact (dvd_neg).mpr (Finset.dvd_sum fun k hk => hD k hk j))
    rw [hy] at h
    exact h
  ·
    have h := hlevel (G'.coeff (ℓ * i)) (by
      rw [hFl]; exact (dvd_neg).mpr (Finset.dvd_sum fun k hk => hD k hk _))
    rw [hy] at h
    exact h

theorem wcLlsKP_gp_levels : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ν : Ω → ℝ), (∀ x y : Ω, x ≠ 0 → y ≠ 0 → x + y ≠ 0 → min (ν x) (ν y) ≤ ν (x + y)) → (∀ x : Ω, x ≠ 0 → (x ∈ W ↔ 0 ≤ ν x)) → ∀ (p q n : ℕ) (τ : ℝ) (a : ℕ → ℕ → ↥W), 2 ≤ p → 1 ≤ q → 0 ≤ τ → (∀ u, u < n * q → (a (u + 1) (u % q + 1) = 0 ∨ (a u (u % q + 1) ≠ 0 ∧ τ + ν ((a u (u % q + 1) : ↥W) : Ω) / (p : ℝ) ≤ ν ((a (u + 1) (u % q + 1) : ↥W) : Ω))) ∧ (∀ j, 1 ≤ j → j ≤ q → j ≠ u % q + 1 → a (u + 1) j - a u j = 0 ∨ (a u (u % q + 1) ≠ 0 ∧ τ + ν ((a u (u % q + 1) : ↥W) : Ω) / (p : ℝ) ≤ ν ((a (u + 1) j - a u j : ↥W) : Ω)))) → ∀ j, 1 ≤ j → j ≤ q → a (n * q) j = 0 ∨ (p : ℝ) * τ / ((p : ℝ) - 1) * (1 - (1 / (p : ℝ)) ^ n) ≤ ν ((a (n * q) j : ↥W) : Ω) :=
by
  intro Ω _ W ν hν2 hν3 p q n τ a hp hq hτ hstep
  obtain ⟨L, hLdef⟩ : ∃ L : ℕ → ℝ, ∀ k, L k = (p : ℝ) * τ / ((p : ℝ) - 1) * (1 - (1 / (p : ℝ)) ^ k) :=
    ⟨_, fun k => rfl⟩
  have hq0 : 0 < q := by omega
  have hpR : (2 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp
  have hp0 : (0 : ℝ) < (p : ℝ) := by linarith
  have hp1 : (0 : ℝ) < (p : ℝ) - 1 := by linarith
  have hpne : (p : ℝ) ≠ 0 := hp0.ne'
  have hp1ne : (p : ℝ) - 1 ≠ 0 := hp1.ne'
  have hL0 : L 0 = 0 := by rw [hLdef]; simp
  have hLstep : ∀ k, L (k + 1) = τ + L k / (p : ℝ) := by
    intro k
    rw [hLdef, hLdef, pow_succ]
    field_simp
    ring
  have hLmono : ∀ k, L k ≤ L (k + 1) := by
    intro k
    rw [hLdef, hLdef]
    apply mul_le_mul_of_nonneg_left
    · have h1 : (1 / (p : ℝ)) ^ (k + 1) ≤ (1 / (p : ℝ)) ^ k :=
        pow_le_pow_of_le_one (by positivity) (by rw [div_le_one hp0]; linarith) (by omega)
      linarith
    · exact div_nonneg (mul_nonneg hp0.le hτ) hp1.le
  have hcoe : ∀ x : ↥W, x ≠ 0 → (x : Ω) ≠ 0 := fun x hx h' => hx (Subtype.ext h')
  have hadd : ∀ (x d : ↥W) (ρ : ℝ), (x = 0 ∨ ρ ≤ ν (x : Ω)) → (d = 0 ∨ ρ ≤ ν (d : Ω)) →
      (x + d = 0 ∨ ρ ≤ ν ((x + d : ↥W) : Ω)) := by
    intro x d ρ hx hd
    by_cases hx0 : x = 0
    · rw [hx0, zero_add]; exact hd
    by_cases hd0 : d = 0
    · rw [hd0, add_zero]; exact hx
    by_cases hs : x + d = 0
    · left; exact hs
    right
    rcases hx with h | hx
    · exact absurd h hx0
    rcases hd with h | hd
    · exact absurd h hd0
    have h2 := hν2 (x : Ω) (d : Ω) (hcoe x hx0) (hcoe d hd0) (hcoe _ hs)
    calc ρ ≤ min (ν (x : Ω)) (ν (d : Ω)) := le_min hx hd
      _ ≤ ν ((x : Ω) + (d : Ω)) := h2
      _ = ν ((x + d : ↥W) : Ω) := rfl
  have inv : ∀ u, u ≤ n * q → ∀ j, 1 ≤ j → j ≤ q → a u j = 0 ∨
      (if j ≤ u % q then L (u / q + 1) else L (u / q)) ≤ ν ((a u j : ↥W) : Ω) := by
    intro u
    induction u with
    | zero =>
      intro _ j hj1 _
      simp only [Nat.zero_mod, Nat.zero_div]
      rw [if_neg (by omega), hL0]
      by_cases h : a 0 j = 0
      · left; exact h
      · right; exact (hν3 _ (hcoe _ h)).mp (a 0 j).2
    | succ u ih =>
      intro hu j hj1 hjq
      have hu' : u < n * q := by omega
      have IH := ih (by omega)
      have hPlt : u % q < q := Nat.mod_lt u hq0
      have hdm : u % q + q * (u / q) = u := Nat.mod_add_div u q
      have hold : a u (u % q + 1) = 0 ∨ L (u / q) ≤ ν ((a u (u % q + 1) : ↥W) : Ω) := by
        have := IH (u % q + 1) (by omega) (by omega)
        rwa [if_neg (by omega)] at this
      have key : a u (u % q + 1) ≠ 0 →
          L (u / q + 1) ≤ τ + ν ((a u (u % q + 1) : ↥W) : Ω) / (p : ℝ) := by
        intro hne
        rcases hold with h | h
        · exact absurd h hne
        rw [hLstep]
        have : L (u / q) / (p : ℝ) ≤ ν ((a u (u % q + 1) : ↥W) : Ω) / (p : ℝ) := by
          gcongr
        linarith

      have hlev : (∀ j, 1 ≤ j → j ≤ q → j = u % q + 1 →
            (if j ≤ (u + 1) % q then L ((u + 1) / q + 1) else L ((u + 1) / q)) = L (u / q + 1)) ∧
          (∀ j, 1 ≤ j → j ≤ q → j ≠ u % q + 1 →
            (if j ≤ (u + 1) % q then L ((u + 1) / q + 1) else L ((u + 1) / q)) =
              (if j ≤ u % q then L (u / q + 1) else L (u / q))) := by
        by_cases hA : u % q + 1 < q
        · have hdu : (u + 1) / q = u / q ∧ (u + 1) % q = u % q + 1 :=
            (Nat.div_mod_unique hq0).mpr ⟨by linarith, hA⟩
          rw [hdu.1, hdu.2]
          refine ⟨fun j _ _ hji => ?_, fun j _ _ hji => ?_⟩
          · rw [if_pos (by omega)]
          · by_cases hjP : j ≤ u % q
            · rw [if_pos (by omega), if_pos hjP]
            · rw [if_neg (by omega), if_neg hjP]
        · have hB : u % q + 1 = q := by omega
          have hdu : (u + 1) / q = u / q + 1 ∧ (u + 1) % q = 0 :=
            (Nat.div_mod_unique hq0).mpr ⟨by rw [mul_add, mul_one]; linarith, hq0⟩
          rw [hdu.1, hdu.2]
          refine ⟨fun j hj1 _ _ => ?_, fun j hj1 hjq hji => ?_⟩
          · rw [if_neg (by omega)]
          · rw [if_neg (by omega), if_pos (by omega)]
      by_cases hji : j = u % q + 1
      · rw [hlev.1 j hj1 hjq hji]
        subst hji
        rcases (hstep u hu').1 with h | ⟨hne, hb⟩
        · left; exact h
        · right; exact le_trans (key hne) hb
      · rw [hlev.2 j hj1 hjq hji]
        rcases (hstep u hu').2 j hj1 hjq hji with h | ⟨hne, hb⟩
        · have he : a (u + 1) j = a u j := sub_eq_zero.mp h
          rw [he]; exact IH j hj1 hjq
        · have holdle : (if j ≤ u % q then L (u / q + 1) else L (u / q)) ≤ L (u / q + 1) := by
            split_ifs
            · exact le_refl _
            · exact hLmono _
          have he : a (u + 1) j = a u j + (a (u + 1) j - a u j) := by abel
          rw [he]
          exact hadd _ _ _ (IH j hj1 hjq) (Or.inr (le_trans holdle (le_trans (key hne) hb)))
  intro j hj1 hjq
  have h := inv (n * q) le_rfl j hj1 hjq
  have h1 : n * q % q = 0 := Nat.mul_mod_left n q
  have h2 : n * q / q = n := Nat.mul_div_cancel n hq0
  rw [h1, h2, if_neg (by omega), hLdef] at h
  exact h

theorem wcLlsKP_gp_level_final : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ν : Ω → ℝ), (∀ x y : Ω, x ≠ 0 → y ≠ 0 → ν (x * y) = ν x + ν y) → (∀ x : Ω, x ≠ 0 → (x ∈ W ↔ 0 ≤ ν x)) → ∀ (p m₀ j : ℕ) (w x : ↥W), 2 ≤ p → 1 ≤ j → j ≤ m₀ → w ≠ 0 → (x = 0 ∨ (p : ℝ) * ν (w : Ω) / ((p : ℝ) - 1) * (1 - (1 / (p : ℝ)) ^ m₀) ≤ ν (x : Ω)) → ∃ π : ↥W, x ^ ((p - 1) * m₀) = w ^ (p * (m₀ - j)) * π :=
by
  intro Ω _ W ν hmul hmem p m₀ j w x hp hj hjm hw hx
  have hν1 : ν 1 = 0 := by
    have h := hmul 1 1 one_ne_zero one_ne_zero
    rw [mul_one] at h
    linarith
  have hpow : ∀ z : Ω, z ≠ 0 → ∀ n : ℕ, ν (z ^ n) = (n : ℝ) * ν z := by
    intro z hz n
    induction n with
    | zero => simp [hν1]
    | succ n ih =>
      rw [pow_succ, hmul _ _ (pow_ne_zero n hz) hz, ih]
      push_cast
      ring
  have hNpos : 0 < (p - 1) * m₀ := Nat.mul_pos (by omega) (by omega)
  rcases eq_or_ne x 0 with rfl | hx0
  · exact ⟨0, by rw [zero_pow hNpos.ne', mul_zero]⟩
  have hxA := hx.resolve_left hx0
  set N := (p - 1) * m₀ with hN
  set M := p * (m₀ - j) with hM
  have hx' : (x : Ω) ≠ 0 := fun h => hx0 (Subtype.ext h)
  have hw' : (w : Ω) ≠ 0 := fun h => hw (Subtype.ext h)
  have hτ : 0 ≤ ν (w : Ω) := (hmem _ hw').mp w.2
  set q : Ω := (x : Ω) ^ N / (w : Ω) ^ M with hq
  have hwM : (w : Ω) ^ M ≠ 0 := pow_ne_zero _ hw'
  have hq0 : q ≠ 0 := div_ne_zero (pow_ne_zero _ hx') hwM
  have hxq : (x : Ω) ^ N = (w : Ω) ^ M * q := by rw [hq, mul_div_cancel₀ _ hwM]
  have hνq : ν q = (N : ℝ) * ν (x : Ω) - (M : ℝ) * ν (w : Ω) := by
    have h := congrArg ν hxq
    rw [hmul _ _ hwM hq0, hpow _ hx', hpow _ hw'] at h
    linarith
  have hP : (2 : ℝ) ≤ p := by exact_mod_cast hp
  have hineq : (M : ℝ) * ν (w : Ω) ≤ (N : ℝ) * ((p : ℝ) * ν (w : Ω) / ((p : ℝ) - 1) *
      (1 - (1 / (p : ℝ)) ^ m₀)) := by
    have hP1 : (p : ℝ) - 1 ≠ 0 := by linarith
    have hcN : (N : ℝ) = ((p : ℝ) - 1) * m₀ := by
      rw [hN]; push_cast [Nat.cast_sub (by omega : 1 ≤ p)]; ring
    have hcM : (M : ℝ) = (p : ℝ) * ((m₀ : ℝ) - j) := by
      rw [hM]; push_cast [Nat.cast_sub hjm]; ring
    have hlt : (m₀ : ℝ) < (p : ℝ) ^ m₀ := by exact_mod_cast Nat.lt_pow_self (by omega : 1 < p)
    set r := (1 / (p : ℝ)) ^ m₀ with hr
    have hrP : r * (p : ℝ) ^ m₀ = 1 := by
      rw [hr, ← mul_pow, one_div, inv_mul_cancel₀ (by linarith), one_pow]
    have hr0 : 0 ≤ r := by positivity
    have hmr : (m₀ : ℝ) * r ≤ 1 := by nlinarith
    have hj1 : (1 : ℝ) ≤ j := by exact_mod_cast hj
    rw [hcN, hcM]
    have e : ((p : ℝ) - 1) * m₀ * ((p : ℝ) * ν (w : Ω) / ((p : ℝ) - 1) * (1 - r)) =
        (p : ℝ) * ν (w : Ω) * (m₀ - m₀ * r) := by
      field_simp
    rw [e]
    have hpτ : 0 ≤ (p : ℝ) * ν (w : Ω) := mul_nonneg (by linarith) hτ
    nlinarith [mul_le_mul_of_nonneg_left (show (m₀ : ℝ) * r ≤ j by linarith) hpτ]
  have hNA := mul_le_mul_of_nonneg_left hxA (Nat.cast_nonneg N : (0 : ℝ) ≤ N)
  have hqW : q ∈ W := (hmem q hq0).mpr (by rw [hνq]; linarith)
  refine ⟨⟨q, hqW⟩, ?_⟩
  apply Subtype.ext
  simp only [MulMemClass.coe_mul, SubmonoidClass.coe_pow]
  exact hxq

theorem wcLlsKP_gp_W_schedule : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ℓ : ℕ),
    ℓ.Prime → ∀ (ν : Ω → ℝ),
    (∀ x y : Ω, x ≠ 0 → y ≠ 0 → ν (x * y) = ν x + ν y) →
    (∀ x y : Ω, x ≠ 0 → y ≠ 0 → x + y ≠ 0 → min (ν x) (ν y) ≤ ν (x + y)) →
    (∀ x : Ω, x ≠ 0 → (x ∈ W ↔ 0 ≤ ν x)) →
    (∀ x : ↥W, x ≠ 0 → (x ∈ IsLocalRing.maximalIdeal ↥W ↔ 0 < ν (x : Ω))) →
    ∀ (h g : Polynomial ↥W) (γ w β c s : ↥W) (m₀ : ℕ), w ≠ 0 →
      ((ℓ : ℕ) : ↥W) = γ ^ (ℓ - 1) * w → IsUnit (h.coeff 0) → g.coeff m₀ = 1 → ℓ < m₀ →
      β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 → (∀ j, j < m₀ → β ^ (m₀ - j) ∣ g.coeff j) →
      w ^ ℓ = β ^ ((ℓ - 1) * m₀) * c → c ∈ IsLocalRing.maximalIdeal ↥W →
      ∀ (z : ℕ → ↥W) (Hq Gq : ℕ → Polynomial ↥W),
        Hq 0 = h.comp (Polynomial.X + Polynomial.C (β * s)) →
        Gq 0 = g.comp (Polynomial.X + Polynomial.C (β * s)) →
        (∀ t, t < (1 + m₀ * ((m₀ - 1) / ℓ)) →
          Hq (t + 1) = Hq t + Polynomial.C γ * Polynomial.C (z (t + 1)) *
            Polynomial.X ^ (if t = 0 then 0 else (t - 1) % ((m₀ - 1) / ℓ) + 1) ∧
          Gq (t + 1) = Gq t - (∑ k ∈ Finset.Ioo 0 ℓ,
            Polynomial.C ((((ℓ.choose k / ℓ : ℕ) : ↥W)) * w * γ ^ (k - 1)) *
              (Polynomial.C (z (t + 1)) *
                Polynomial.X ^ (if t = 0 then 0 else (t - 1) % ((m₀ - 1) / ℓ) + 1)) ^ k *
              Hq t ^ (ℓ - k)) -
            (Polynomial.C (z (t + 1)) *
              Polynomial.X ^ (if t = 0 then 0 else (t - 1) % ((m₀ - 1) / ℓ) + 1)) ^ ℓ) →
        z 1 ^ ℓ + (∑ k ∈ Finset.Ioo 0 ℓ,
          ((((ℓ.choose k / ℓ : ℕ) : ↥W)) * w * γ ^ (k - 1)) * ((Hq 0).coeff 0) ^ (ℓ - k) *
            z 1 ^ k) - (Gq 0).coeff 0 = 0 →
        (∀ t, 1 ≤ t → t < (1 + m₀ * ((m₀ - 1) / ℓ)) →
          z (t + 1) ^ ℓ = (Gq t).coeff (ℓ * ((t - 1) % ((m₀ - 1) / ℓ) + 1))) →
        (h ^ ℓ + Polynomial.C γ ^ ℓ * g).comp (Polynomial.X + Polynomial.C (β * s)) =
          Hq (1 + m₀ * ((m₀ - 1) / ℓ)) ^ ℓ +
            Polynomial.C γ ^ ℓ * Gq (1 + m₀ * ((m₀ - 1) / ℓ)) ∧
        IsUnit ((Hq (1 + m₀ * ((m₀ - 1) / ℓ))).coeff 0) ∧
        (Gq (1 + m₀ * ((m₀ - 1) / ℓ))).coeff 0 = 0 ∧
        (Gq (1 + m₀ * ((m₀ - 1) / ℓ))).coeff m₀ - 1 ∈ IsLocalRing.maximalIdeal ↥W ∧
        (∀ j, j < m₀ → β ^ (m₀ - j) ∣ (Gq (1 + m₀ * ((m₀ - 1) / ℓ))).coeff j) ∧
        (∀ j, 0 < j → j < m₀ → ℓ ∣ j → ∃ π : ↥W,
          ((Gq (1 + m₀ * ((m₀ - 1) / ℓ))).coeff j) ^ ((ℓ - 1) * m₀) =
            w ^ (ℓ * (m₀ - j)) * π) ∧
        ∃ μ : ↥W, μ ∈ IsLocalRing.maximalIdeal ↥W ∧
          (Gq (1 + m₀ * ((m₀ - 1) / ℓ))).coeff 1 =
            (Polynomial.derivative g).eval (β * s) + β ^ (m₀ - 1) * μ :=
by
  intro Ω _ W ℓ hℓ ν hν1 hν2 hν3 hν4 h g γ w β c s m₀ hw0 hpw hh0 hgm hlt hβm hβ0 hβlow hc hcm
    z Hq Gq hH0 hG0 hrec hr0 hrr
  have hℓ2 : 2 ≤ ℓ := hℓ.two_le
  set q := (m₀ - 1) / ℓ with hqdef
  have hq1 : 1 ≤ q := by
    rw [hqdef, Nat.le_div_iff_mul_le (by omega : 0 < ℓ)]; omega
  have hℓq : ℓ * q ≤ m₀ - 1 := by
    rw [hqdef, mul_comm]; exact Nat.div_mul_le_self _ _
  have hidx : ∀ t, 1 ≤ t → 1 ≤ (t - 1) % q + 1 ∧ ℓ * ((t - 1) % q + 1) < m₀ := by
    intro t _
    refine ⟨by omega, ?_⟩
    have h1 : (t - 1) % q < q := Nat.mod_lt _ (by omega)
    have h2 : ℓ * ((t - 1) % q + 1) ≤ ℓ * q := Nat.mul_le_mul_left _ (by omega)
    omega

  have hJ1 : ∀ t, t ≤ 1 + m₀ * q →
      (h ^ ℓ + Polynomial.C γ ^ ℓ * g).comp (Polynomial.X + Polynomial.C (β * s)) =
        Hq t ^ ℓ + Polynomial.C γ ^ ℓ * Gq t := by
    intro t
    induction t with
    | zero =>
      intro _
      rw [hH0, hG0]
      simp only [Polynomial.add_comp, Polynomial.mul_comp, Polynomial.pow_comp, Polynomial.C_comp]
    | succ t ih =>
      intro ht
      obtain ⟨e1, e2⟩ := hrec t (by omega)
      rw [ih (by omega), e1, e2, mul_assoc (Polynomial.C γ)]
      exact (wcLlsKP_gp_absorb_identity ↥W ℓ hℓ γ w (Hq t) (Gq t)
        (Polynomial.C (z (t + 1)) * Polynomial.X ^ (if t = 0 then 0 else (t - 1) % q + 1)) hpw).symm

  have hInv : ∀ t, 1 ≤ t → t ≤ 1 + m₀ * q →
      (∀ j, j < m₀ → β ^ (m₀ - j) ∣ (Gq t).coeff j) ∧
      (Gq t).coeff m₀ - 1 ∈ IsLocalRing.maximalIdeal ↥W ∧
      IsUnit ((Hq t).coeff 0) ∧ (Gq t).coeff 0 = 0 ∧
      ∃ μ : ↥W, μ ∈ IsLocalRing.maximalIdeal ↥W ∧
        (Gq t).coeff 1 = (Polynomial.derivative g).eval (β * s) + β ^ (m₀ - 1) * μ := by
    intro t ht1
    induction t, ht1 using Nat.le_induction with
    | base =>
      intro _
      obtain ⟨i1, i2, i3, i4⟩ := wcLlsKP_gp_initial Ω W h g β s m₀ hh0 hgm hβm hβlow
      rw [← hG0] at i1 i2 i4
      rw [← hH0] at i3
      obtain ⟨e1, e2⟩ := hrec 0 (by omega)
      rw [if_pos rfl] at e1 e2
      simp only [zero_add, pow_zero, mul_one] at e1 e2
      obtain ⟨a1, a2, a3, a4, μ, hμ, a5⟩ := wcLlsKP_gp_step_zero Ω W ℓ hℓ ν hν1 hν2 hν3 hν4
        γ w β c (z 1) m₀ (Hq 0) (Gq 0) (Hq 1) (Gq 1) hw0 hpw hlt hβm hβ0 hc hcm i3 i1 hr0 e1 e2
      refine ⟨a1, ?_, a3, a4, μ, hμ, ?_⟩
      · have := Ideal.add_mem _ a2 i2
        rwa [sub_add_sub_cancel] at this
      · rw [a5, i4]
    | succ t ht1 ih =>
      intro hle
      obtain ⟨b1, b2, b3, b4, μ₀, hμ₀, b5⟩ := ih (by omega)
      obtain ⟨e1, e2⟩ := hrec t (by omega)
      have ht0 : t ≠ 0 := by omega
      rw [if_neg ht0] at e1 e2
      obtain ⟨hi1, hi2⟩ := hidx t ht1
      obtain ⟨a1, a2, a3, a4, ⟨μ, hμ, a5⟩, -, -⟩ := wcLlsKP_gp_step_round Ω W ℓ hℓ ν hν1 hν2
        hν3 hν4 γ w β c (z (t + 1)) m₀ ((t - 1) % q + 1) (Hq t) (Gq t) (Hq (t + 1))
        (Gq (t + 1)) hw0 hβm hβ0 hc hcm hi1 hi2 b1 (hrr t ht1 (by omega)) e1 e2
      refine ⟨a1, ?_, by rw [a3]; exact b3, by rw [a4]; exact b4, μ₀ + μ,
        Ideal.add_mem _ hμ₀ hμ, ?_⟩
      · have := Ideal.add_mem _ a2 b2
        rwa [sub_add_sub_cancel] at this
      · rw [a5, b5]; ring

  have hτ : 0 ≤ ν (w : Ω) := by
    have hw' : (w : Ω) ≠ 0 := fun h0 => hw0 (Subtype.ext h0)
    exact (hν3 _ hw').mp w.2
  have hlev := wcLlsKP_gp_levels Ω W ν hν2 hν3 ℓ q m₀ (ν (w : Ω))
    (fun u j => (Gq (u + 1)).coeff (ℓ * j)) hℓ2 hq1 hτ (by
      intro u hu
      have ht1 : 1 ≤ u + 1 := by omega
      have hidxu : (u + 1 - 1) % q + 1 = u % q + 1 := by rw [Nat.add_sub_cancel]
      obtain ⟨b1, -, -, -, -⟩ := hInv (u + 1) ht1 (by omega)
      obtain ⟨e1, e2⟩ := hrec (u + 1) (by omega)
      have hu0 : u + 1 ≠ 0 := by omega
      rw [if_neg hu0, hidxu] at e1 e2
      obtain ⟨hi1, hi2⟩ := hidx (u + 1) ht1
      rw [hidxu] at hi1 hi2
      have hroot := hrr (u + 1) ht1 (by omega)
      rw [hidxu] at hroot
      obtain ⟨-, -, -, -, -, c6, c7⟩ := wcLlsKP_gp_step_round Ω W ℓ hℓ ν hν1 hν2 hν3 hν4
        γ w β c (z (u + 1 + 1)) m₀ (u % q + 1) (Hq (u + 1)) (Gq (u + 1)) (Hq (u + 1 + 1))
        (Gq (u + 1 + 1)) hw0 hβm hβ0 hc hcm hi1 hi2 b1 hroot e1 e2
      refine ⟨c7, ?_⟩
      intro j _ _ hji
      exact c6 (ℓ * j) (fun heq => hji (Nat.eq_of_mul_eq_mul_left (by omega) heq)))

  obtain ⟨f1, f2, f3, f4, f5⟩ := hInv (1 + m₀ * q) (by omega) le_rfl
  refine ⟨hJ1 _ le_rfl, f3, f4, f2, f1, ?_, f5⟩
  intro j hj0 hjm hdvd
  obtain ⟨j', rfl⟩ := hdvd
  have hj'1 : 1 ≤ j' := by
    rcases Nat.eq_zero_or_pos j' with h0 | h0
    · subst h0; simp at hj0
    · exact h0
  have hj'q : j' ≤ q := by
    rw [hqdef, Nat.le_div_iff_mul_le (by omega : 0 < ℓ), mul_comm]; omega
  rw [show 1 + m₀ * q = m₀ * q + 1 from Nat.add_comm _ _]
  exact wcLlsKP_gp_level_final Ω W ν hν1 hν3 ℓ m₀ (ℓ * j') w _ hℓ2 (by omega) (by omega) hw0
    (hlev j' hj'1 hj'q)

theorem wcLlsKP_gp_generic_tower : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ℓ : ℕ),
    ℓ.Prime → ∀ (h g : Polynomial ↥W) (γ w β : ↥W) (m₀ : ℕ),
    ∃ (Φ : ℕ → Polynomial (MvPolynomial ℕ Ω)) (Hs Gs : Polynomial (MvPolynomial ℕ Ω)),
      (∀ t, (Φ t).Monic ∧ (Φ t).natDegree = ℓ) ∧
      (∀ t (y y' : ℕ → Ω), (∀ i, i ≤ t → y i = y' i) →
        (Φ t).map (MvPolynomial.eval y) = (Φ t).map (MvPolynomial.eval y')) ∧
      ∀ (s : ↥W) (y : ℕ → Ω), y 0 = (s : Ω) →
        (∀ t, t < (1 + m₀ * ((m₀ - 1) / ℓ)) →
          ((Φ t).map (MvPolynomial.eval y)).eval (y (t + 1)) = 0) →
        ∃ (z : ℕ → ↥W) (Hq Gq : ℕ → Polynomial ↥W),
          Hq 0 = h.comp (Polynomial.X + Polynomial.C (β * s)) ∧
          Gq 0 = g.comp (Polynomial.X + Polynomial.C (β * s)) ∧
          (∀ t, t < (1 + m₀ * ((m₀ - 1) / ℓ)) →
            Hq (t + 1) = Hq t + Polynomial.C γ * Polynomial.C (z (t + 1)) *
              Polynomial.X ^ (if t = 0 then 0 else (t - 1) % ((m₀ - 1) / ℓ) + 1) ∧
            Gq (t + 1) = Gq t - (∑ k ∈ Finset.Ioo 0 ℓ,
              Polynomial.C ((((ℓ.choose k / ℓ : ℕ) : ↥W)) * w * γ ^ (k - 1)) *
                (Polynomial.C (z (t + 1)) *
                  Polynomial.X ^ (if t = 0 then 0 else (t - 1) % ((m₀ - 1) / ℓ) + 1)) ^ k *
                Hq t ^ (ℓ - k)) -
              (Polynomial.C (z (t + 1)) *
                Polynomial.X ^ (if t = 0 then 0 else (t - 1) % ((m₀ - 1) / ℓ) + 1)) ^ ℓ) ∧
          z 1 ^ ℓ + (∑ k ∈ Finset.Ioo 0 ℓ,
            ((((ℓ.choose k / ℓ : ℕ) : ↥W)) * w * γ ^ (k - 1)) * ((Hq 0).coeff 0) ^ (ℓ - k) *
              z 1 ^ k) - (Gq 0).coeff 0 = 0 ∧
          (∀ t, 1 ≤ t → t < (1 + m₀ * ((m₀ - 1) / ℓ)) →
            z (t + 1) ^ ℓ = (Gq t).coeff (ℓ * ((t - 1) % ((m₀ - 1) / ℓ) + 1))) ∧
          (Hq (1 + m₀ * ((m₀ - 1) / ℓ))).map (algebraMap ↥W Ω) = Hs.map (MvPolynomial.eval y) ∧
          (Gq (1 + m₀ * ((m₀ - 1) / ℓ))).map (algebraMap ↥W Ω) = Gs.map (MvPolynomial.eval y) :=
by
  intro Ω _ W ℓ hℓ h g γ w β m₀
  classical
  generalize hq : (m₀ - 1) / ℓ = q
  generalize hM : 1 + m₀ * q = MM
  have hMpos : 0 < MM := by omega

  have hgen : ∀ {T T' : Type u} [CommRing T] [CommRing T'] (ψ : T →+* T') (e : ℕ → ℕ)
      (γ₁ : T) (γ₂ : T') (c₁ x₁ : ℕ → T) (c₂ x₂ : ℕ → T') (H₁ G₁ : Polynomial T)
      (H₂ G₂ : Polynomial T') (n : ℕ),
      ψ γ₁ = γ₂ → (∀ k, ψ (c₁ k) = c₂ k) → (∀ i, 1 ≤ i → i ≤ n → ψ (x₁ i) = x₂ i) →
      H₁.map ψ = H₂ → G₁.map ψ = G₂ → ∀ t, t ≤ n →
      ((wcGtRec ℓ e γ₁ c₁ x₁ H₁ G₁ t).1.map ψ, (wcGtRec ℓ e γ₁ c₁ x₁ H₁ G₁ t).2.map ψ) =
        wcGtRec ℓ e γ₂ c₂ x₂ H₂ G₂ t := by
    intro T T' _ _ ψ e γ₁ γ₂ c₁ x₁ c₂ x₂ H₁ G₁ H₂ G₂ n hγ hc hx hH hG t
    induction t with
    | zero => intro _; simp only [wcGtRec, hH, hG]
    | succ t ih =>
      intro ht
      have ih' := ih (by omega)
      have ih1 : (wcGtRec ℓ e γ₁ c₁ x₁ H₁ G₁ t).1.map ψ = (wcGtRec ℓ e γ₂ c₂ x₂ H₂ G₂ t).1 :=
        congrArg Prod.fst ih'
      have ih2 : (wcGtRec ℓ e γ₁ c₁ x₁ H₁ G₁ t).2.map ψ = (wcGtRec ℓ e γ₂ c₂ x₂ H₂ G₂ t).2 :=
        congrArg Prod.snd ih'
      have hxt := hx (t + 1) (by omega) ht
      simp only [wcGtRec, Polynomial.map_add, Polynomial.map_sub, Polynomial.map_sum,
        Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_C, Polynomial.map_X, ih1, ih2, hc,
        hxt, hγ]

  have hphi : ∀ {T T' : Type u} [CommRing T] [CommRing T'] (ψ : T →+* T') (c : ℕ → T)
      (P : Polynomial T × Polynomial T) (t : ℕ),
      (wcGtPhi ℓ q c P t).map ψ = wcGtPhi ℓ q (fun k => ψ (c k)) (P.1.map ψ, P.2.map ψ) t := by
    intro T T' _ _ ψ c P t
    unfold wcGtPhi
    split_ifs <;> simp [Polynomial.map_sum, Polynomial.coeff_map]

  have hmon : ∀ {T : Type u} [CommRing T] [Nontrivial T] (c : ℕ → T)
      (P : Polynomial T × Polynomial T) (t : ℕ),
      (wcGtPhi ℓ q c P t).Monic ∧ (wcGtPhi ℓ q c P t).natDegree = ℓ := by
    intro T _ _ c P t
    unfold wcGtPhi
    split_ifs with ht
    · rw [add_sub_assoc]
      have hdeg : ((∑ k ∈ Finset.Ioo 0 ℓ, Polynomial.C (c k * P.1.coeff 0 ^ (ℓ - k)) *
          Polynomial.X ^ k) - Polynomial.C (P.2.coeff 0)).degree < (ℓ : WithBot ℕ) := by
        refine lt_of_le_of_lt (Polynomial.degree_sub_le _ _) (max_lt ?_ ?_)
        · refine lt_of_le_of_lt (Polynomial.degree_sum_le _ _) ?_
          refine (Finset.sup_lt_iff (WithBot.bot_lt_coe ℓ)).mpr ?_
          intro k hk
          exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_pow_le _ _)
            (WithBot.coe_lt_coe.mpr (Finset.mem_Ioo.mp hk).2)
        · exact lt_of_le_of_lt Polynomial.degree_C_le (by exact_mod_cast hℓ.pos)
      refine ⟨Polynomial.monic_X_pow_add hdeg, ?_⟩
      rw [Polynomial.natDegree_add_eq_left_of_degree_lt (by rwa [Polynomial.degree_X_pow]),
        Polynomial.natDegree_X_pow]
    · exact ⟨Polynomial.monic_X_pow_sub_C _ hℓ.ne_zero, Polynomial.natDegree_X_pow_sub_C⟩

  have hlift : ∀ (P : Polynomial W), P.Monic → ∀ y : Ω,
      (P.map (algebraMap W Ω)).eval y = 0 → ∃ a : W, algebraMap W Ω a = y := by
    intro P hP y hy
    have hint : IsIntegral W y := ⟨P, hP, by rw [Polynomial.eval₂_eq_eval_map]; exact hy⟩
    exact IsIntegrallyClosed.isIntegral_iff.mp hint

  obtain ⟨CK, hCK⟩ : ∃ CK : ℕ → W,
      CK = fun k => (((ℓ.choose k / ℓ : ℕ) : W)) * w * γ ^ (k - 1) := ⟨_, rfl⟩
  obtain ⟨e, he⟩ : ∃ e : ℕ → ℕ, e = fun t => if t = 0 then 0 else (t - 1) % q + 1 := ⟨_, rfl⟩
  obtain ⟨φ, hφ⟩ : ∃ φ : W →+* MvPolynomial ℕ Ω, φ = MvPolynomial.C.comp (algebraMap W Ω) :=
    ⟨_, rfl⟩
  have hφe : ∀ (y : ℕ → Ω) (a : W), MvPolynomial.eval y (φ a) = algebraMap W Ω a := by
    intro y a; rw [hφ, RingHom.comp_apply, MvPolynomial.eval_C]
  have hcomp : ∀ y : ℕ → Ω, (MvPolynomial.eval y).comp φ = algebraMap W Ω :=
    fun y => RingHom.ext (hφe y)
  obtain ⟨GH, hGH⟩ : ∃ GH : ℕ → Polynomial (MvPolynomial ℕ Ω) × Polynomial (MvPolynomial ℕ Ω),
      GH = wcGtRec ℓ e (φ γ) (fun k => φ (CK k)) (fun i => MvPolynomial.X i)
        ((h.map φ).comp (Polynomial.X + Polynomial.C (φ β * MvPolynomial.X 0)))
        ((g.map φ).comp (Polynomial.X + Polynomial.C (φ β * MvPolynomial.X 0))) := ⟨_, rfl⟩
  obtain ⟨GO, hGO⟩ : ∃ GO : Ω → (ℕ → Ω) → ℕ → Polynomial Ω × Polynomial Ω,
      GO = fun a x => wcGtRec ℓ e (algebraMap W Ω γ) (fun k => algebraMap W Ω (CK k)) x
        ((h.map (algebraMap W Ω)).comp (Polynomial.X + Polynomial.C (algebraMap W Ω β * a)))
        ((g.map (algebraMap W Ω)).comp (Polynomial.X + Polynomial.C (algebraMap W Ω β * a))) :=
    ⟨_, rfl⟩
  obtain ⟨GW, hGW⟩ : ∃ GW : W → (ℕ → W) → ℕ → Polynomial W × Polynomial W,
      GW = fun s z => wcGtRec ℓ e γ CK z (h.comp (Polynomial.X + Polynomial.C (β * s)))
        (g.comp (Polynomial.X + Polynomial.C (β * s))) := ⟨_, rfl⟩
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : ℕ → Polynomial (MvPolynomial ℕ Ω),
      Φ = fun t => wcGtPhi ℓ q (fun k => φ (CK k)) (GH t) t := ⟨_, rfl⟩

  have F1 : ∀ (y : ℕ → Ω) (t : ℕ),
      ((GH t).1.map (MvPolynomial.eval y), (GH t).2.map (MvPolynomial.eval y)) = GO (y 0) y t := by
    intro y t
    simp only [hGH, hGO]
    refine hgen (MvPolynomial.eval y) e (φ γ) (algebraMap W Ω γ) (fun k => φ (CK k))
      (fun i => MvPolynomial.X i) (fun k => algebraMap W Ω (CK k)) y
      ((h.map φ).comp (Polynomial.X + Polynomial.C (φ β * MvPolynomial.X 0)))
      ((g.map φ).comp (Polynomial.X + Polynomial.C (φ β * MvPolynomial.X 0)))
      ((h.map (algebraMap W Ω)).comp (Polynomial.X + Polynomial.C (algebraMap W Ω β * y 0)))
      ((g.map (algebraMap W Ω)).comp (Polynomial.X + Polynomial.C (algebraMap W Ω β * y 0)))
      t (hφe y γ) (fun k => hφe y (CK k)) (fun i _ _ => by simp) ?_ ?_ t le_rfl
    · rw [Polynomial.map_comp, Polynomial.map_map, hcomp]
      simp [hφe]
    · rw [Polynomial.map_comp, Polynomial.map_map, hcomp]
      simp [hφe]

  have F2 : ∀ (s : W) (z : ℕ → W) (t : ℕ),
      ((GW s z t).1.map (algebraMap W Ω), (GW s z t).2.map (algebraMap W Ω)) =
        GO (algebraMap W Ω s) (fun i => algebraMap W Ω (z i)) t := by
    intro s z t
    simp only [hGW, hGO]
    refine hgen (algebraMap W Ω) e γ (algebraMap W Ω γ) CK z (fun k => algebraMap W Ω (CK k))
      (fun i => algebraMap W Ω (z i))
      (h.comp (Polynomial.X + Polynomial.C (β * s))) (g.comp (Polynomial.X + Polynomial.C (β * s)))
      ((h.map (algebraMap W Ω)).comp
        (Polynomial.X + Polynomial.C (algebraMap W Ω β * algebraMap W Ω s)))
      ((g.map (algebraMap W Ω)).comp
        (Polynomial.X + Polynomial.C (algebraMap W Ω β * algebraMap W Ω s)))
      t rfl (fun _ => rfl) (fun _ _ _ => rfl) ?_ ?_ t le_rfl
    · rw [Polynomial.map_comp]
      simp
    · rw [Polynomial.map_comp]
      simp

  have F3 : ∀ (a : Ω) (x x' : ℕ → Ω) (n : ℕ), (∀ i, 1 ≤ i → i ≤ n → x i = x' i) →
      GO a x n = GO a x' n := by
    intro a x x' n hxx
    have key := hgen (RingHom.id Ω) e (algebraMap W Ω γ) (algebraMap W Ω γ)
      (fun k => algebraMap W Ω (CK k)) x (fun k => algebraMap W Ω (CK k)) x'
      ((h.map (algebraMap W Ω)).comp (Polynomial.X + Polynomial.C (algebraMap W Ω β * a)))
      ((g.map (algebraMap W Ω)).comp (Polynomial.X + Polynomial.C (algebraMap W Ω β * a)))
      ((h.map (algebraMap W Ω)).comp (Polynomial.X + Polynomial.C (algebraMap W Ω β * a)))
      ((g.map (algebraMap W Ω)).comp (Polynomial.X + Polynomial.C (algebraMap W Ω β * a)))
      n rfl (fun _ => rfl) (fun i h1 h2 => hxx i h1 h2) (Polynomial.map_id) (Polynomial.map_id)
      n le_rfl
    simp only [Polynomial.map_id] at key
    simp only [hGO]
    exact Prod.mk.eta.symm.trans key
  have hΦy : ∀ (y : ℕ → Ω) (t : ℕ), (Φ t).map (MvPolynomial.eval y) =
      wcGtPhi ℓ q (fun k => algebraMap W Ω (CK k)) (GO (y 0) y t) t := by
    intro y t
    simp only [hΦ]
    rw [hphi, ← F1 y t]
    congr 1
    funext k
    exact hφe y (CK k)
  refine ⟨Φ, (GH MM).1, (GH MM).2, fun t => by simp only [hΦ]; exact hmon _ _ _, ?_, ?_⟩
  · intro t y y' hyy
    rw [hΦy, hΦy, F3 (y 0) y y' t (fun i _ h2 => hyy i h2), hyy 0 (Nat.zero_le _)]
  intro s y hy0 hroot
  obtain ⟨z, hz⟩ : ∃ z : ℕ → W, ∀ i, (∃ a : W, algebraMap W Ω a = y i) →
      algebraMap W Ω (z i) = y i :=
    ⟨fun i => if hi : ∃ a : W, algebraMap W Ω a = y i then hi.choose else s,
      fun i hi => by simp only [dif_pos hi]; exact hi.choose_spec⟩
  have hpair : ∀ n, (∀ i, 1 ≤ i → i ≤ n → algebraMap W Ω (z i) = y i) →
      ((GW s z n).1.map (algebraMap W Ω), (GW s z n).2.map (algebraMap W Ω)) = GO (y 0) y n := by
    intro n hn
    rw [F2, F3 _ (fun i => algebraMap W Ω (z i)) y n hn, hy0]; rfl
  have hz' : ∀ n, n ≤ MM → ∀ i, 1 ≤ i → i ≤ n → algebraMap W Ω (z i) = y i := by
    intro n
    induction n with
    | zero => intro _ i h1 h2; omega
    | succ n ih =>
      intro hn i h1 h2
      rcases Nat.lt_or_ge i (n + 1) with hi | hi
      · exact ih (by omega) i h1 (by omega)
      · have hin : i = n + 1 := by omega
        subst hin
        apply hz
        have ih' := ih (by omega)
        refine hlift (wcGtPhi ℓ q CK (GW s z n) n) (hmon _ _ _).1 (y (n + 1)) ?_
        rw [hphi, hpair n ih', ← hΦy]
        exact hroot n (by omega)
  have hrootW : ∀ t, t < MM → (wcGtPhi ℓ q CK (GW s z t) t).eval (z (t + 1)) = 0 := by
    intro t ht
    apply IsFractionRing.injective W Ω
    rw [map_zero, ← Polynomial.eval₂_at_apply, ← Polynomial.eval_map, hphi,
      hpair t (fun i h1 h2 => hz' t ht.le i h1 h2), ← hΦy,
      hz' (t + 1) ht (t + 1) (by omega) le_rfl]
    exact hroot t ht
  refine ⟨z, fun t => (GW s z t).1, fun t => (GW s z t).2, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · subst hGW; rfl
  · subst hGW; rfl
  · intro t _
    subst hGW hCK he
    exact ⟨rfl, rfl⟩
  · have h0 := hrootW 0 hMpos
    rw [wcGtPhi, if_pos rfl] at h0
    simp only [Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_C, Polynomial.eval_finsetSum, Polynomial.eval_mul] at h0
    subst hCK
    exact h0
  · intro t h1 ht
    have h := hrootW t ht
    rw [wcGtPhi, if_neg (by omega)] at h
    simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_C] at h
    exact sub_eq_zero.mp h
  · exact congrArg Prod.fst ((hpair MM (hz' MM le_rfl)).trans (F1 y MM).symm)
  · exact congrArg Prod.snd ((hpair MM (hz' MM le_rfl)).trans (F1 y MM).symm)

theorem wcLlsKP_gce_generic_process : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (ℓ : ℕ), ℓ.Prime → ringChar Ω ≠ ℓ → ∀ (ν : Ω → ℝ),
    (∀ x y : Ω, x ≠ 0 → y ≠ 0 → ν (x * y) = ν x + ν y) →
    (∀ x y : Ω, x ≠ 0 → y ≠ 0 → x + y ≠ 0 → min (ν x) (ν y) ≤ ν (x + y)) →
    (∀ x : Ω, x ≠ 0 → (x ∈ W ↔ 0 ≤ ν x)) →
    (∀ x : ↥W, x ≠ 0 → (x ∈ IsLocalRing.maximalIdeal ↥W ↔ 0 < ν (x : Ω))) →
    ∀ (h g : Polynomial ↥W) (γ w β c : ↥W) (m₀ : ℕ), γ ≠ 0 →
      ((ℓ : ℕ) : ↥W) = γ ^ (ℓ - 1) * w → w ∈ IsLocalRing.maximalIdeal ↥W →
      IsUnit (h.coeff 0) → g.coeff 0 = 0 → g.coeff m₀ = 1 → ℓ < m₀ →
      β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 → (∀ j, j < m₀ → β ^ (m₀ - j) ∣ g.coeff j) →
      w ^ ℓ = β ^ ((ℓ - 1) * m₀) * c → c ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ (M : ℕ) (Φ : ℕ → Polynomial (MvPolynomial ℕ Ω)) (Hs Gs : Polynomial (MvPolynomial ℕ Ω)),
        (∀ t, (Φ t).Monic ∧ (Φ t).natDegree = ℓ) ∧
        (∀ t (y y' : ℕ → Ω), (∀ i, i ≤ t → y i = y' i) →
          (Φ t).map (MvPolynomial.eval y) = (Φ t).map (MvPolynomial.eval y')) ∧
        ∀ (s : ↥W) (y : ℕ → Ω), y 0 = (s : Ω) →
          (∀ t, t < M → ((Φ t).map (MvPolynomial.eval y)).eval (y (t + 1)) = 0) →
          ∃ (H G : Polynomial ↥W), H.map (algebraMap ↥W Ω) = Hs.map (MvPolynomial.eval y) ∧
            G.map (algebraMap ↥W Ω) = Gs.map (MvPolynomial.eval y) ∧
            (h ^ ℓ + Polynomial.C γ ^ ℓ * g).comp (Polynomial.X + Polynomial.C (β * s)) =
              H ^ ℓ + Polynomial.C γ ^ ℓ * G ∧
            IsUnit (H.coeff 0) ∧ G.coeff 0 = 0 ∧ G.coeff m₀ - 1 ∈ IsLocalRing.maximalIdeal ↥W ∧
            (∀ j, j < m₀ → β ^ (m₀ - j) ∣ G.coeff j) ∧
            (∀ j, 0 < j → j < m₀ → ℓ ∣ j →
              ∃ π : ↥W, (G.coeff j) ^ ((ℓ - 1) * m₀) = w ^ (ℓ * (m₀ - j)) * π) ∧
            ∃ μ : ↥W, μ ∈ IsLocalRing.maximalIdeal ↥W ∧
              G.coeff 1 = (Polynomial.derivative g).eval (β * s) + β ^ (m₀ - 1) * μ :=
by
  intro Ω _ _ W ℓ hℓ hΩ ν hν1 hν2 hν3 hν4 h g γ w β c m₀ hγ hpw hwm hh0 hg0 hgm hlt hβm hβ0
    hβlow hc hcm
  have hℓΩ : ((ℓ : ℕ) : Ω) ≠ 0 := by
    intro h0
    have hdvd : ringChar Ω ∣ ℓ := ringChar.dvd h0
    rcases hℓ.eq_one_or_self_of_dvd _ hdvd with h1 | h1
    · exact CharP.ringChar_ne_one h1
    · exact hΩ h1
  have hℓW : ((ℓ : ℕ) : ↥W) ≠ 0 := by
    intro h0
    apply hℓΩ
    have e2 := congrArg (algebraMap ↥W Ω) h0
    rwa [map_natCast, map_zero] at e2
  have hw0 : w ≠ 0 := by
    rintro rfl
    exact hℓW (by rw [hpw, mul_zero])
  obtain ⟨Φ, Hs, Gs, hmon, hdep, hbr⟩ := wcLlsKP_gp_generic_tower Ω W ℓ hℓ h g γ w β m₀
  refine ⟨1 + m₀ * ((m₀ - 1) / ℓ), Φ, Hs, Gs, hmon, hdep, ?_⟩
  intro s y hy0 hyt
  obtain ⟨z, Hq, Gq, hH0, hG0, hrec, hr0, hrr, hHm, hGm⟩ := hbr s y hy0 hyt
  obtain ⟨e1, e2, e3, e4, e5, e6, e7⟩ := wcLlsKP_gp_W_schedule Ω W ℓ hℓ ν hν1 hν2 hν3 hν4 h g
    γ w β c s m₀ hw0 hpw hh0 hgm hlt hβm hβ0 hβlow hc hcm z Hq Gq hH0 hG0 hrec hr0 hrr
  exact ⟨Hq _, Gq _, hHm, hGm, e1, e2, e3, e4, e5, e6, e7⟩

theorem wcLlsKP_gce_branch_zero : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (ℓ : ℕ), ℓ.Prime → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (g : Polynomial ↥W) (β : ↥W) (m₀ : ℕ), 2 ≤ m₀ → ¬ ℓ ∣ m₀ → g.coeff m₀ = 1 →
      β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 → (∀ j, j < m₀ → β ^ (m₀ - j) ∣ g.coeff j) →
      ∀ (M : ℕ) (Φ : ℕ → Polynomial (MvPolynomial ℕ Ω)) (A : MvPolynomial ℕ Ω),
        (∀ t, (Φ t).Monic ∧ (Φ t).natDegree = ℓ) →
        (∀ t (y y' : ℕ → Ω), (∀ i, i ≤ t → y i = y' i) →
          (Φ t).map (MvPolynomial.eval y) = (Φ t).map (MvPolynomial.eval y')) →
        (∀ (s : ↥W) (y : ℕ → Ω), y 0 = (s : Ω) →
          (∀ t, t < M → ((Φ t).map (MvPolynomial.eval y)).eval (y (t + 1)) = 0) →
          ∃ a μ : ↥W, μ ∈ IsLocalRing.maximalIdeal ↥W ∧ (a : Ω) = MvPolynomial.eval y A ∧
            a = (Polynomial.derivative g).eval (β * s) + β ^ (m₀ - 1) * μ) →
        ∃ (s : ↥W) (y : ℕ → Ω), y 0 = (s : Ω) ∧
          (∀ t, t < M → ((Φ t).map (MvPolynomial.eval y)).eval (y (t + 1)) = 0) ∧
          MvPolynomial.eval y A = 0 :=
by
  intro Ω _ _ W ℓ hℓ hκ g β m₀ h2 hℓm hg hβm hβ0 hβlow M Φ A hmon hdep hbr
  classical

  have hκac : IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
    refine IsAlgClosed.of_exists_root _ ?_
    intro p hpm hpirr
    have hlift : p ∈ Polynomial.lifts (IsLocalRing.residue ↥W) :=
      (Polynomial.mem_lifts p).mpr (Polynomial.map_surjective _ IsLocalRing.residue_surjective p)
    obtain ⟨q, hqmap, hqdeg, hqmon⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hpm
    have hpdeg : 0 < p.natDegree := Irreducible.natDegree_pos hpirr
    have hqm : (q.map (algebraMap ↥W Ω)).Monic := hqmon.map _
    have hqd : (q.map (algebraMap ↥W Ω)).natDegree = p.natDegree := by
      rw [hqmon.natDegree_map, hqdeg]
    obtain ⟨α, hα⟩ := IsAlgClosed.exists_root (q.map (algebraMap ↥W Ω)) (by
      rw [Polynomial.degree_eq_natDegree hqm.ne_zero, hqd]; exact_mod_cast hpdeg.ne')
    have hint : IsIntegral ↥W α := ⟨q, hqmon, by rw [← Polynomial.eval_map]; exact hα⟩
    obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    refine ⟨IsLocalRing.residue ↥W a, ?_⟩
    have h1 : q.eval a = 0 := by
      apply IsFractionRing.injective ↥W Ω
      rw [map_zero, ← Polynomial.eval₂_hom, ← Polynomial.eval_map, ha]
      exact hα
    rw [← hqmap, Polynomial.eval_map, Polynomial.eval₂_hom, h1, map_zero]

  obtain ⟨D, hD, hDu⟩ : ∃ D : Polynomial ↥W,
      (∀ s : ↥W, (Polynomial.derivative g).eval (β * s) = β ^ (m₀ - 1) * D.eval s) ∧
      IsUnit (D.coeff (m₀ - 1)) := by
    have hm1 : 1 ≤ m₀ := by omega
    have hEc : ∀ j, (g.comp (Polynomial.C β * Polynomial.X)).coeff j = g.coeff j * β ^ j :=
      fun j => Polynomial.comp_C_mul_X_coeff
    have hdvd : Polynomial.C (β ^ m₀) ∣ g.comp (Polynomial.C β * Polynomial.X) := by
      rw [Polynomial.C_dvd_iff_dvd_coeff]
      intro j
      rw [hEc]
      by_cases hj : j < m₀
      · obtain ⟨d, hd⟩ := hβlow j hj
        have e : β ^ m₀ = β ^ (m₀ - j) * β ^ j := by rw [← pow_add, Nat.sub_add_cancel hj.le]
        exact ⟨d, by rw [hd, e]; ring⟩
      · have e : β ^ j = β ^ m₀ * β ^ (j - m₀) := by
          rw [← pow_add, Nat.add_sub_cancel' (by omega)]
        exact ⟨g.coeff j * β ^ (j - m₀), by rw [e]; ring⟩
    obtain ⟨F, hF⟩ := hdvd
    refine ⟨Polynomial.derivative F, ?_, ?_⟩
    · intro s
      have h1 : Polynomial.derivative (g.comp (Polynomial.C β * Polynomial.X)) =
          Polynomial.C β * (Polynomial.derivative g).comp (Polynomial.C β * Polynomial.X) := by
        rw [Polynomial.derivative_comp, Polynomial.derivative_C_mul_X]
      have h2 : Polynomial.derivative (g.comp (Polynomial.C β * Polynomial.X)) =
          Polynomial.C (β ^ m₀) * Polynomial.derivative F := by
        rw [hF, Polynomial.derivative_C_mul]
      have h3 := congrArg (Polynomial.eval s) (h1.symm.trans h2)
      simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_comp,
        Polynomial.eval_X] at h3
      apply mul_left_cancel₀ hβ0
      rw [h3, ← mul_assoc, ← pow_succ', Nat.sub_add_cancel hm1]
    · have hFm : F.coeff m₀ = 1 := by
        have e1 := hEc m₀
        rw [hF, Polynomial.coeff_C_mul, hg, one_mul] at e1
        exact mul_left_cancel₀ (pow_ne_zero _ hβ0) (e1.trans (mul_one _).symm)
      rw [Polynomial.coeff_derivative, Nat.sub_add_cancel hm1, hFm, one_mul]
      have e : ((m₀ - 1 : ℕ) : ↥W) + 1 = (m₀ : ↥W) := by
        rw [← Nat.cast_add_one, Nat.sub_add_cancel hm1]
      rw [e, ← IsLocalRing.residue_ne_zero_iff_isUnit, map_natCast]
      intro h
      have := (ringChar.spec _ m₀).mp h
      rw [hκ] at this
      exact hℓm this

  obtain ⟨N, hN⟩ : ∃ N : Polynomial Ω, ∀ x : Ω, ∃ T : Multiset (ℕ → Ω),
      Multiset.card T = ℓ ^ M ∧
      (∀ y ∈ T, y 0 = x ∧ ∀ t, t < M → ((Φ t).map (MvPolynomial.eval y)).eval (y (t + 1)) = 0) ∧
      N.eval x = (T.map (fun y => MvPolynomial.eval y A)).prod := by
    let σ : ℕ → MvPolynomial ℕ Ω →+* Polynomial (MvPolynomial ℕ Ω) := fun k =>
      MvPolynomial.eval₂Hom (Polynomial.C.comp MvPolynomial.C)
        (fun i => if i = k then Polynomial.X else Polynomial.C (MvPolynomial.X i))
    have hsub : ∀ (k : ℕ) (Q : MvPolynomial ℕ Ω) (y : ℕ → Ω) (r : Ω),
        ((σ k Q).map (MvPolynomial.eval y)).eval r =
          MvPolynomial.eval (Function.update y k r) Q := by
      intro k Q y r
      have : (Polynomial.evalRingHom r).comp
          ((Polynomial.mapRingHom (MvPolynomial.eval y)).comp (σ k)) =
          MvPolynomial.eval (Function.update y k r) := by
        apply MvPolynomial.ringHom_ext
        · intro c
          simp [σ]
        · intro i
          by_cases hi : i = k
          · subst hi
            simp [σ]
          · simp [σ, hi]
      exact congrArg (fun φ => φ Q) this
    have key : ∀ k t, t + k = M → ∃ P : MvPolynomial ℕ Ω, ∀ y : ℕ → Ω,
        ∃ T : Multiset (ℕ → Ω), Multiset.card T = ℓ ^ k ∧
        (∀ y' ∈ T, (∀ i, i ≤ t → y' i = y i) ∧
          ∀ t', t ≤ t' → t' < M →
            ((Φ t').map (MvPolynomial.eval y')).eval (y' (t' + 1)) = 0) ∧
        MvPolynomial.eval y P = (T.map (fun y' => MvPolynomial.eval y' A)).prod := by
      intro k
      induction k with
      | zero =>
        intro t ht
        refine ⟨A, fun y => ⟨{y}, by simp, ?_, by simp⟩⟩
        intro y' hy'
        rw [Multiset.mem_singleton] at hy'
        subst hy'
        exact ⟨fun _ _ => rfl, fun t' h1 h2 => by omega⟩
      | succ k ih =>
        intro t ht
        obtain ⟨P, hP⟩ := ih (t + 1) (by omega)
        choose T hTcard hTmem hTprod using hP
        refine ⟨Polynomial.resultant (Φ t) (σ (t + 1) P) ℓ (σ (t + 1) P).natDegree, ?_⟩
        intro y
        have hfm : ((Φ t).map (MvPolynomial.eval y)).Monic := (hmon t).1.map _
        have hfd : ((Φ t).map (MvPolynomial.eval y)).natDegree = ℓ := by
          rw [(hmon t).1.natDegree_map, (hmon t).2]
        refine ⟨((Φ t).map (MvPolynomial.eval y)).roots.bind
          (fun r => T (Function.update y (t + 1) r)), ?_, ?_, ?_⟩
        · rw [Multiset.card_bind]
          have hcf : (Multiset.card ∘ fun r => T (Function.update y (t + 1) r)) =
              fun _ => ℓ ^ k := funext fun r => hTcard _
          rw [hcf]
          rw [Multiset.map_const', Multiset.sum_replicate, IsAlgClosed.card_roots_eq_natDegree, hfd,
            smul_eq_mul, pow_succ']
        · intro y' hy'
          rw [Multiset.mem_bind] at hy'
          obtain ⟨r, hr, hy'r⟩ := hy'
          obtain ⟨hagree, htow⟩ := hTmem _ y' hy'r
          have hag : ∀ i, i ≤ t → y' i = y i := by
            intro i hi
            rw [hagree i (by omega), Function.update_of_ne (by omega)]
          refine ⟨hag, ?_⟩
          intro t' h1 h2
          rcases Nat.eq_or_lt_of_le h1 with h | h
          · subst h
            rw [hdep t y' y hag, hagree (t + 1) le_rfl, Function.update_self]
            exact (Polynomial.mem_roots'.mp hr).2
          · exact htow t' h h2
        · have hres := Polynomial.resultant_eq_prod_eval ((Φ t).map (MvPolynomial.eval y))
            ((σ (t + 1) P).map (MvPolynomial.eval y)) (σ (t + 1) P).natDegree
            Polynomial.natDegree_map_le (IsAlgClosed.splits _)
          rw [hfd, hfm.leadingCoeff, one_pow, one_mul] at hres
          rw [← Polynomial.resultant_map_map, hres, Multiset.map_bind, Multiset.prod_bind]
          congr 1
          apply Multiset.map_congr rfl
          intro r _
          rw [hsub, hTprod]
    obtain ⟨P0, hP0⟩ := key M 0 (by omega)
    refine ⟨MvPolynomial.eval₂ Polynomial.C (fun _ => Polynomial.X) P0, ?_⟩
    intro x
    obtain ⟨T, hTc, hTm, hTp⟩ := hP0 (fun _ => x)
    refine ⟨T, hTc, ?_, ?_⟩
    · intro y hy
      obtain ⟨h1, h3⟩ := hTm y hy
      exact ⟨h1 0 le_rfl, fun t ht => h3 t (Nat.zero_le t) ht⟩
    · rw [← hTp]
      have : (Polynomial.evalRingHom x).comp
          (MvPolynomial.eval₂Hom Polynomial.C (fun _ : ℕ => Polynomial.X)) =
          MvPolynomial.eval (fun _ : ℕ => x) := by
        apply MvPolynomial.ringHom_ext <;> intros <;> simp
      exact congrArg (fun φ => φ P0) this

  have hprodc : ∀ (S : Multiset Ω) (b d : ↥W),
      (∀ z ∈ S, ∃ μ : ↥W, μ ∈ IsLocalRing.maximalIdeal ↥W ∧ z = ((b * (d + μ) : ↥W) : Ω)) →
      ∃ ν : ↥W, ν ∈ IsLocalRing.maximalIdeal ↥W ∧
        S.prod = ((b ^ Multiset.card S * (d ^ Multiset.card S + ν) : ↥W) : Ω) := by
    intro S b d
    induction S using Multiset.induction_on with
    | empty => intro _; exact ⟨0, Ideal.zero_mem _, by simp⟩
    | cons z S ih =>
      intro hS
      obtain ⟨μ, hμ, hz⟩ := hS z (by simp)
      obtain ⟨ν, hν, hSp⟩ := ih (fun z' hz' => hS z' (Multiset.mem_cons_of_mem hz'))
      refine ⟨d * ν + μ * d ^ Multiset.card S + μ * ν, ?_, ?_⟩
      · exact add_mem (add_mem (Ideal.mul_mem_left _ _ hν) (Ideal.mul_mem_right _ _ hμ))
          (Ideal.mul_mem_left _ _ hν)
      · rw [Multiset.prod_cons, Multiset.card_cons, hz, hSp, ← MulMemClass.coe_mul]
        congr 1
        ring

  have hroot : ∀ (N : Polynomial Ω) (D : Polynomial ↥W) (d e K : ℕ), 1 ≤ d → 1 ≤ K →
      IsUnit (D.coeff d) →
      (∀ s : ↥W, ∃ ν : ↥W, ν ∈ IsLocalRing.maximalIdeal ↥W ∧
        N.eval (s : Ω) = ((β ^ e * (D.eval s ^ K + ν) : ↥W) : Ω)) →
      ∃ s : ↥W, N.eval (s : Ω) = 0 := by
    intro N D d e K hd hK hDu hval
    by_contra H0
    push Not at H0
    have hN0 : N ≠ 0 := by
      rintro rfl
      exact H0 0 (by simp)
    have hfac : ∀ x : Ω, N.eval x = N.leadingCoeff * (N.roots.map (fun a => x - a)).prod := by
      intro x
      conv_lhs => rw [← Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C
        (IsAlgClosed.card_roots_eq_natDegree (p := N))]
      rw [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_multiset_prod, Multiset.map_map]
      congr 2
      apply Multiset.map_congr rfl
      intro a _
      simp
    have hroots : ∀ α ∈ N.roots, 1 < W.valuation α := by
      intro α hα
      by_contra hle
      push Not at hle
      have hαW : α ∈ W := (W.valuation_le_one_iff α).mp hle
      exact H0 ⟨α, hαW⟩ (Polynomial.mem_roots'.mp hα).2
    have hconst : ∀ s : ↥W, W.valuation (N.eval (s : Ω)) =
        W.valuation N.leadingCoeff * (N.roots.map W.valuation).prod := by
      intro s
      rw [hfac, map_mul, map_multiset_prod, Multiset.map_map]
      congr 2
      apply Multiset.map_congr rfl
      intro a ha
      exact W.valuation.map_sub_eq_of_lt_right
        (lt_of_le_of_lt (W.valuation_le_one s) (hroots a ha))
    have hDbd : (D.map (IsLocalRing.residue ↥W)).coeff d ≠ 0 := by
      rw [Polynomial.coeff_map]; exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hDu
    have hDb0 : D.map (IsLocalRing.residue ↥W) ≠ 0 := fun h => hDbd (by rw [h, Polynomial.coeff_zero])
    have hDbdeg : (D.map (IsLocalRing.residue ↥W)).degree ≠ 0 := by
      have h1 : d ≤ (D.map (IsLocalRing.residue ↥W)).natDegree :=
        Polynomial.le_natDegree_of_ne_zero hDbd
      rw [Polynomial.degree_eq_natDegree hDb0]
      exact_mod_cast (by omega : (D.map (IsLocalRing.residue ↥W)).natDegree ≠ 0)
    have hevr : ∀ s : ↥W, IsLocalRing.residue ↥W (D.eval s) =
        (D.map (IsLocalRing.residue ↥W)).eval (IsLocalRing.residue ↥W s) := by
      intro s; rw [Polynomial.eval_map, Polynomial.eval₂_hom]
    obtain ⟨r₁, hr₁⟩ := IsAlgClosed.exists_root _ hDbdeg
    obtain ⟨s₁, hs₁⟩ := IsLocalRing.residue_surjective r₁
    have hD1 : D.eval s₁ ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [← IsLocalRing.residue_eq_zero_iff, hevr, hs₁]; exact hr₁
    have hnr : ∃ r₂, ¬ (D.map (IsLocalRing.residue ↥W)).IsRoot r₂ := by
      by_contra hall
      push Not at hall
      apply hDb0
      apply Polynomial.eq_zero_of_infinite_isRoot
      have : {x | (D.map (IsLocalRing.residue ↥W)).IsRoot x} = Set.univ :=
        Set.eq_univ_of_forall hall
      rw [this]
      exact Set.infinite_univ
    obtain ⟨r₂, hr₂⟩ := hnr
    obtain ⟨s₂, hs₂⟩ := IsLocalRing.residue_surjective r₂
    have hD2 : IsUnit (D.eval s₂) := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hevr, hs₂]; exact hr₂
    obtain ⟨ν₁, hν₁, he₁⟩ := hval s₁
    obtain ⟨ν₂, hν₂, he₂⟩ := hval s₂
    have hx1 : W.valuation ((D.eval s₁ ^ K + ν₁ : ↥W) : Ω) < 1 := by
      rw [← W.valuation_lt_one_iff]
      exact add_mem (Ideal.pow_mem_of_mem _ hD1 K (by omega)) hν₁
    have hx2 : W.valuation ((D.eval s₂ ^ K + ν₂ : ↥W) : Ω) = 1 := by
      rw [← W.valuation_eq_one_iff, ← IsLocalRing.notMem_maximalIdeal]
      intro hm
      have hm' : D.eval s₂ ^ K ∈ IsLocalRing.maximalIdeal ↥W := by
        have := sub_mem hm hν₂
        simpa using this
      exact IsLocalRing.notMem_maximalIdeal.mpr (hD2.pow K) hm'
    have hbne : ((β ^ e : ↥W) : Ω) ≠ 0 := by
      intro h
      apply pow_ne_zero e hβ0
      exact_mod_cast h
    have hb : W.valuation ((β ^ e : ↥W) : Ω) ≠ 0 := (Valuation.ne_zero_iff _).mpr hbne
    have e1 := hconst s₁
    have e2 := hconst s₂
    rw [he₁, MulMemClass.coe_mul, map_mul] at e1
    rw [he₂, MulMemClass.coe_mul, map_mul] at e2
    have h12 := mul_left_cancel₀ hb (e1.trans e2.symm)
    rw [h12, hx2] at hx1
    exact lt_irrefl _ hx1

  have hK : 1 ≤ ℓ ^ M := Nat.one_le_pow _ _ hℓ.pos
  have hvalf : ∀ s : ↥W, ∃ ν : ↥W, ν ∈ IsLocalRing.maximalIdeal ↥W ∧
      N.eval (s : Ω) = ((β ^ ((m₀ - 1) * ℓ ^ M) * (D.eval s ^ (ℓ ^ M) + ν) : ↥W) : Ω) := by
    intro s
    obtain ⟨T, hTc, hTb, hTp⟩ := hN (s : Ω)
    obtain ⟨ν, hν, hprod⟩ := hprodc (T.map (fun y => MvPolynomial.eval y A)) (β ^ (m₀ - 1))
      (D.eval s) (by
        intro z hz
        rw [Multiset.mem_map] at hz
        obtain ⟨y, hy, rfl⟩ := hz
        obtain ⟨hy0, hyt⟩ := hTb y hy
        obtain ⟨a, μ, hμ, ha, ha'⟩ := hbr s y hy0 hyt
        refine ⟨μ, hμ, ?_⟩
        rw [← ha, ha', hD s]
        congr 1
        ring)
    refine ⟨ν, hν, ?_⟩
    rw [hTp, hprod, Multiset.card_map, hTc, ← pow_mul]
  obtain ⟨s₀, hs₀⟩ := hroot N D (m₀ - 1) ((m₀ - 1) * ℓ ^ M) (ℓ ^ M) (by omega) hK hDu hvalf
  obtain ⟨T, _, hTb, hTp⟩ := hN (s₀ : Ω)
  rw [hs₀] at hTp
  have h0 : (0 : Ω) ∈ T.map (fun y => MvPolynomial.eval y A) :=
    Multiset.prod_eq_zero_iff.mp hTp.symm
  rw [Multiset.mem_map] at h0
  obtain ⟨y, hy, hyA⟩ := h0
  obtain ⟨hy0, hyt⟩ := hTb y hy
  exact ⟨s₀, y, hy0, hyt, hyA⟩

theorem wcLlsKP_gcl_exact_centre : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (h g : Polynomial ↥W) (γ w β c : ↥W) (m₀ : ℕ), γ ≠ 0 →
      ((ℓ : ℕ) : ↥W) = γ ^ (ℓ - 1) * w → w ∈ IsLocalRing.maximalIdeal ↥W →
      IsUnit (h.coeff 0) → g.coeff 0 = 0 → g.coeff m₀ = 1 → 1 ≤ m₀ → ¬ ℓ ∣ m₀ → ℓ < m₀ →
      β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 → (∀ j, j < m₀ → β ^ (m₀ - j) ∣ g.coeff j) →
      w ^ ℓ = β ^ ((ℓ - 1) * m₀) * c → c ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ (ξ : ↥W) (H G : Polynomial ↥W), β ∣ ξ ∧
        (h ^ ℓ + Polynomial.C γ ^ ℓ * g).comp (Polynomial.X + Polynomial.C ξ) =
          H ^ ℓ + Polynomial.C γ ^ ℓ * G ∧
        IsUnit (H.coeff 0) ∧ G.coeff 0 = 0 ∧ G.coeff 1 = 0 ∧
        G.coeff m₀ - 1 ∈ IsLocalRing.maximalIdeal ↥W ∧
        (∀ j, j < m₀ → β ^ (m₀ - j) ∣ G.coeff j) ∧
        (∀ j, 0 < j → j < m₀ → ℓ ∣ j →
          ∃ π : ↥W, (G.coeff j) ^ ((ℓ - 1) * m₀) = w ^ (ℓ * (m₀ - j)) * π) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ h g γ w β c m₀ hγ hpw hwm hh0 hg0 hgm hm₀ hpm₀ hlt hβm hβ0
    hβlow hc hcm
  have hℓ2 : 2 ≤ ℓ := hℓ.two_le
  obtain ⟨ν, hν1, hν2, hν3, hν4⟩ := wcLlsKP_gce_real_val Ω W hW
  obtain ⟨M, Φ, Hs, Gs, hmon, hdep, hproc⟩ :=
    wcLlsKP_gce_generic_process Ω W ℓ hℓ hΩ ν hν1 hν2 hν3 hν4 h g γ w β c m₀ hγ hpw hwm hh0
      hg0 hgm hlt hβm hβ0 hβlow hc hcm
  have hbranch : ∀ (s : ↥W) (y : ℕ → Ω), y 0 = (s : Ω) →
      (∀ t, t < M → ((Φ t).map (MvPolynomial.eval y)).eval (y (t + 1)) = 0) →
      ∃ a μ : ↥W, μ ∈ IsLocalRing.maximalIdeal ↥W ∧
        (a : Ω) = MvPolynomial.eval y (Gs.coeff 1) ∧
        a = (Polynomial.derivative g).eval (β * s) + β ^ (m₀ - 1) * μ := by
    intro s y hy0 hyt
    obtain ⟨H, G, _, hGmap, _, _, _, _, _, _, μ, hμ, hG1⟩ := hproc s y hy0 hyt
    refine ⟨G.coeff 1, μ, hμ, ?_, hG1⟩
    have e := congrArg (fun P => Polynomial.coeff P 1) hGmap
    simp only [Polynomial.coeff_map] at e
    exact e
  obtain ⟨s₀, y, hy0, hyt, hA⟩ :=
    wcLlsKP_gce_branch_zero Ω W ℓ hℓ hκ g β m₀ (by omega) hpm₀ hgm hβm hβ0 hβlow M Φ
      (Gs.coeff 1) hmon hdep hbranch
  obtain ⟨H, G, _, hGmap, hcomp, hH0, hG0, hGm, hGlow, hGp, _⟩ := hproc s₀ y hy0 hyt
  have hG1 : G.coeff 1 = 0 := by
    have e := congrArg (fun P => Polynomial.coeff P 1) hGmap
    simp only [Polynomial.coeff_map] at e
    rw [hA] at e
    apply Subtype.val_injective
    exact e
  exact ⟨β * s₀, H, G, dvd_mul_right β s₀, hcomp, hH0, hG0, hG1, hGm, hGlow, hGp⟩

theorem wcLlsKP_gcl_finish : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (h g : Polynomial ↥W) (γ w β ξ : ↥W) (H G : Polynomial ↥W) (m₀ : ℕ), γ ≠ 0 →
      ((ℓ : ℕ) : ↥W) = γ ^ (ℓ - 1) * w → w ∈ IsLocalRing.maximalIdeal ↥W → w ≠ 0 →
      β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 → 2 ≤ m₀ → ¬ ℓ ∣ m₀ → β ∣ ξ →
      (h ^ ℓ + Polynomial.C γ ^ ℓ * g).comp (Polynomial.X + Polynomial.C ξ) =
        H ^ ℓ + Polynomial.C γ ^ ℓ * G →
      IsUnit (H.coeff 0) → G.coeff 0 = 0 → G.coeff 1 = 0 →
      G.coeff m₀ - 1 ∈ IsLocalRing.maximalIdeal ↥W →
      (∀ j, j < m₀ → β ^ (m₀ - j) ∣ G.coeff j) →
      (∀ j, 0 < j → j < m₀ → ℓ ∣ j →
        ∃ π : ↥W, (G.coeff j) ^ ((ℓ - 1) * m₀) = w ^ (ℓ * (m₀ - j)) * π) →
      ∃ (ξ' b ζ γ' : ↥W) (h' g' : Polynomial ↥W), β ∣ ξ' ∧ b ∈ IsLocalRing.maximalIdeal ↥W ∧
        b ≠ 0 ∧ ζ ^ ℓ = b ∧ γ' ≠ 0 ∧ (∃ υ : ↥W, IsUnit υ ∧ γ' = γ * υ) ∧
        IsUnit (h'.coeff 0) ∧ g'.coeff 0 = 0 ∧ g'.coeff m₀ = 1 ∧
        (∀ j, j < m₀ → b ^ (m₀ - j) ∣ g'.coeff j) ∧
        (h ^ ℓ + Polynomial.C γ ^ ℓ * g).comp (Polynomial.X + Polynomial.C ξ') =
          h' ^ ℓ + Polynomial.C γ' ^ ℓ * g' ∧
        ∃ ε₀ : ↥W, ((ℓ : ℕ) : ↥W) = (γ' * ζ ^ m₀) ^ (ℓ - 1) * ε₀ ∧
          (IsUnit ε₀ ∨ (ε₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ ∃ k : ℕ, 2 ≤ k ∧ k < m₀ ∧ ¬ ℓ ∣ k ∧
            (∃ e : ↥W, IsUnit e ∧ g'.coeff k = b ^ (m₀ - k) * e) ∧
            ∃ π : ↥W, π ∈ IsLocalRing.maximalIdeal ↥W ∧ g'.coeff 1 = b ^ (m₀ - 1) * π)) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ h g γ w β ξ H G m₀ hγ hpw hwm hw0 hβm hβ0 hm₀ hpm₀ hβξ
    hcomp hH0 hG0 hG1 hGm hGlow hGp
  classical
  have hℓ2 : 2 ≤ ℓ := hℓ.two_le
  have hℓpos : 0 < ℓ := by omega
  have hℓ0 : ℓ ≠ 0 := by omega
  have hNpos : 0 < (ℓ - 1) * m₀ := Nat.mul_pos (by omega) (by omega)
  have hN0 : (ℓ - 1) * m₀ ≠ 0 := hNpos.ne'

  have root : ∀ (x : ↥W) (n : ℕ), 0 < n → ∃ y : ↥W, y ^ n = x := by
    intro x n hn
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (algebraMap ↥W Ω x) hn
    have hint : IsIntegral ↥W z := by
      refine ⟨Polynomial.X ^ n - Polynomial.C x, Polynomial.monic_X_pow_sub_C _ hn.ne', ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hz, sub_self]
    obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥W) (K := Ω)).mp hint
    refine ⟨y, ?_⟩
    apply IsFractionRing.injective ↥W Ω
    rw [map_pow, hy, hz]

  have pdvd : ∀ (a c : ↥W) (n : ℕ), n ≠ 0 → a ^ n ∣ c ^ n → a ∣ c := fun a c n hn hd =>
    (IsIntegrallyClosed.pow_dvd_pow_iff hn).mp hd
  have notunit_mem : ∀ x : ↥W, ¬ IsUnit x → x ∈ IsLocalRing.maximalIdeal ↥W := fun x hx =>
    (IsLocalRing.mem_maximalIdeal _).mpr hx
  have mem_notunit : ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → ¬ IsUnit x := fun x hx =>
    (IsLocalRing.mem_maximalIdeal _).mp hx

  have hu : IsUnit (G.coeff m₀) := by
    by_contra hn
    have h1 : G.coeff m₀ - (G.coeff m₀ - 1) ∈ IsLocalRing.maximalIdeal ↥W :=
      Ideal.sub_mem _ (notunit_mem _ hn) hGm
    rw [sub_sub_cancel] at h1
    exact mem_notunit _ h1 isUnit_one
  obtain ⟨ui, hui⟩ := hu.exists_left_inv
  have huiu : IsUnit ui := isUnit_iff_exists_inv.mpr ⟨_, hui⟩
  obtain ⟨υ, hυ⟩ := root (G.coeff m₀) ℓ hℓpos
  have hυu : IsUnit υ := (isUnit_pow_iff hℓ0).mp (hυ ▸ hu)
  obtain ⟨υi, hυi⟩ := hυu.exists_left_inv
  have hυiu : IsUnit υi := isUnit_iff_exists_inv.mpr ⟨_, hυi⟩
  have hCυ : Polynomial.C υ ^ ℓ = Polynomial.C (G.coeff m₀) := by
    rw [← Polynomial.C_pow, hυ]
  have hCu : Polynomial.C (G.coeff m₀) * Polynomial.C ui = 1 := by
    rw [← Polynomial.C_mul, mul_comm, hui, Polynomial.C_1]
  have hcomp' : (h ^ ℓ + Polynomial.C γ ^ ℓ * g).comp (Polynomial.X + Polynomial.C ξ) =
      H ^ ℓ + Polynomial.C (γ * υ) ^ ℓ * (Polynomial.C ui * G) := by
    rw [hcomp, Polynomial.C_mul, mul_pow, hCυ]
    linear_combination (-(Polynomial.C γ ^ ℓ * G)) * hCu

  obtain ⟨bAS, hbAS⟩ := root (w ^ ℓ) ((ℓ - 1) * m₀) hNpos
  have hbAS0 : bAS ≠ 0 := by
    rintro rfl
    rw [zero_pow hN0] at hbAS
    exact pow_ne_zero ℓ hw0 hbAS.symm
  have hbASm : bAS ∈ IsLocalRing.maximalIdeal ↥W := by
    apply notunit_mem
    intro hu'
    have h1 : IsUnit (w ^ ℓ) := hbAS ▸ hu'.pow _
    exact mem_notunit _ hwm ((isUnit_pow_iff hℓ0).mp h1)

  have hbj_ex : ∀ j : ℕ, ∃ y : ↥W, j < m₀ → y ^ (m₀ - j) = G.coeff j := by
    intro j
    by_cases hj : j < m₀
    · obtain ⟨y, hy⟩ := root (G.coeff j) (m₀ - j) (by omega)
      exact ⟨y, fun _ => hy⟩
    · exact ⟨0, fun h' => absurd h' hj⟩
  choose bj hbj using hbj_ex

  have sel : ∀ n : ℕ, ∃ b : ↥W, b ∣ bAS ∧ (∀ j, j < n → 2 ≤ j → ¬ ℓ ∣ j → b ∣ bj j) ∧
      (b = bAS ∨ ∃ k, k < n ∧ 2 ≤ k ∧ ¬ ℓ ∣ k ∧ b = bj k) := by
    intro n
    induction n with
    | zero => exact ⟨bAS, dvd_refl _, fun j hj => absurd hj (Nat.not_lt_zero _), Or.inl rfl⟩
    | succ n ih =>
      obtain ⟨b, hb1, hb2, hb3⟩ := ih
      have hb3' : b = bAS ∨ ∃ k, k < n + 1 ∧ 2 ≤ k ∧ ¬ ℓ ∣ k ∧ b = bj k := by
        rcases hb3 with h0 | ⟨k, hk, hk'⟩
        · exact Or.inl h0
        · exact Or.inr ⟨k, by omega, hk'⟩
      by_cases hP : 2 ≤ n ∧ ¬ ℓ ∣ n
      · rcases ValuationRing.dvd_total b (bj n) with hd | hd
        · refine ⟨b, hb1, fun j hj h2 hl => ?_, hb3'⟩
          rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hj' | hj'
          · exact hb2 j hj' h2 hl
          · rw [hj']; exact hd
        · refine ⟨bj n, hd.trans hb1, fun j hj h2 hl => ?_,
            Or.inr ⟨n, by omega, hP.1, hP.2, rfl⟩⟩
          rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hj' | hj'
          · exact hd.trans (hb2 j hj' h2 hl)
          · rw [hj']
      · refine ⟨b, hb1, fun j hj h2 hl => ?_, hb3'⟩
        rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hj' | hj'
        · exact hb2 j hj' h2 hl
        · subst hj'; exact absurd ⟨h2, hl⟩ hP
  obtain ⟨b, hb, hbdiv, hprov⟩ := sel m₀
  have hb0 : b ≠ 0 := by
    rintro rfl
    exact hbAS0 (zero_dvd_iff.mp hb)
  obtain ⟨ζ, hζ⟩ := root b ℓ hℓpos
  have hbN : b ^ ((ℓ - 1) * m₀) ∣ w ^ ℓ := hbAS ▸ pow_dvd_pow_of_dvd hb _
  have hζN : (ζ ^ ((ℓ - 1) * m₀)) ^ ℓ = b ^ ((ℓ - 1) * m₀) := by
    rw [← pow_mul, mul_comm, pow_mul, hζ]
  obtain ⟨q, hq⟩ : ζ ^ ((ℓ - 1) * m₀) ∣ w := pdvd _ _ ℓ hℓ0 (hζN ▸ hbN)
  have hK : w ^ ℓ = b ^ ((ℓ - 1) * m₀) * q ^ ℓ := by rw [hq, mul_pow, hζN]

  have hdivG : ∀ j, j < m₀ → b ^ (m₀ - j) ∣ G.coeff j := by
    intro j hj
    rcases (by omega : j = 0 ∨ j = 1 ∨ 2 ≤ j) with h0 | h0 | h2
    · rw [h0, hG0]; exact dvd_zero _
    · rw [h0, hG1]; exact dvd_zero _
    · by_cases hlj : ℓ ∣ j
      · obtain ⟨π, hπ⟩ := hGp j (by omega) hj hlj
        apply pdvd _ _ ((ℓ - 1) * m₀) hN0
        calc (b ^ (m₀ - j)) ^ ((ℓ - 1) * m₀) = (b ^ ((ℓ - 1) * m₀)) ^ (m₀ - j) := by
              rw [← pow_mul, ← pow_mul, mul_comm]
          _ ∣ (w ^ ℓ) ^ (m₀ - j) := pow_dvd_pow_of_dvd hbN _
          _ = w ^ (ℓ * (m₀ - j)) := by rw [← pow_mul]
          _ ∣ (G.coeff j) ^ ((ℓ - 1) * m₀) := Dvd.intro π hπ.symm
      · rw [← hbj j hj]
        exact pow_dvd_pow_of_dvd (hbdiv j hj h2 hlj) _

  have hε : ((ℓ : ℕ) : ↥W) = (γ * υ * ζ ^ m₀) ^ (ℓ - 1) * (q * υi ^ (ℓ - 1)) := by
    have e1 : (γ * υ * ζ ^ m₀) ^ (ℓ - 1) * (q * υi ^ (ℓ - 1)) =
        γ ^ (ℓ - 1) * (ζ ^ ((ℓ - 1) * m₀) * q) * (υi * υ) ^ (ℓ - 1) := by
      rw [mul_comm (ℓ - 1) m₀, pow_mul]
      ring
    rw [e1, hυi, one_pow, mul_one, ← hq, hpw]

  have hbm : b ∈ IsLocalRing.maximalIdeal ↥W := by
    by_cases hAS : bAS ∣ b
    · obtain ⟨t, ht⟩ := hAS
      rw [ht]
      exact Ideal.mul_mem_right _ _ hbASm
    · rcases hprov with h0 | ⟨k, hk, hk2, hlk, hbk⟩
      · exact absurd (by rw [h0]) hAS
      · have hGk : G.coeff k = b ^ (m₀ - k) := by rw [hbk, hbj k hk]
        obtain ⟨t, ht⟩ := pdvd β b (m₀ - k) (by omega) (hGk ▸ hGlow k hk)
        rw [ht]
        exact Ideal.mul_mem_right _ _ hβm
  have hdis : IsUnit (q * υi ^ (ℓ - 1)) ∨ (q * υi ^ (ℓ - 1) ∈ IsLocalRing.maximalIdeal ↥W ∧
      ∃ k : ℕ, 2 ≤ k ∧ k < m₀ ∧ ¬ ℓ ∣ k ∧
        (∃ e : ↥W, IsUnit e ∧ (Polynomial.C ui * G).coeff k = b ^ (m₀ - k) * e) ∧
        ∃ π : ↥W, π ∈ IsLocalRing.maximalIdeal ↥W ∧
          (Polynomial.C ui * G).coeff 1 = b ^ (m₀ - 1) * π) := by
    by_cases hAS : bAS ∣ b
    · left
      have hqu : IsUnit q := by
        obtain ⟨t, ht⟩ := pow_dvd_pow_of_dvd hAS ((ℓ - 1) * m₀)
        rw [hbAS, hK] at ht
        have e2 : b ^ ((ℓ - 1) * m₀) * 1 = b ^ ((ℓ - 1) * m₀) * (q ^ ℓ * t) := by
          rw [mul_one]; rw [← mul_assoc]; exact ht
        have e3 := (mul_left_cancel₀ (pow_ne_zero _ hb0) e2).symm
        exact (isUnit_pow_iff hℓ0).mp (isUnit_iff_exists_inv.mpr ⟨_, e3⟩)
      exact hqu.mul (hυiu.pow _)
    · right
      have hqm : q ∈ IsLocalRing.maximalIdeal ↥W := by
        apply notunit_mem
        intro hqu
        obtain ⟨qi, hqi⟩ := hqu.exists_left_inv
        apply hAS
        apply pdvd _ _ ((ℓ - 1) * m₀) hN0
        refine ⟨qi ^ ℓ, ?_⟩
        rw [hbAS, hK]
        calc b ^ ((ℓ - 1) * m₀) = b ^ ((ℓ - 1) * m₀) * (qi * q) ^ ℓ := by
              rw [hqi, one_pow, mul_one]
          _ = b ^ ((ℓ - 1) * m₀) * q ^ ℓ * qi ^ ℓ := by ring
      refine ⟨Ideal.mul_mem_right _ _ hqm, ?_⟩
      rcases hprov with h0 | ⟨k, hk, hk2, hlk, hbk⟩
      · exact absurd (by rw [h0]) hAS
      · have hGk : G.coeff k = b ^ (m₀ - k) := by rw [hbk, hbj k hk]
        refine ⟨k, hk2, hk, hlk, ⟨ui, huiu, ?_⟩, ⟨0, Ideal.zero_mem _, ?_⟩⟩
        · rw [Polynomial.coeff_C_mul, hGk, mul_comm]
        · rw [Polynomial.coeff_C_mul, hG1, mul_zero, mul_zero]
  refine ⟨ξ, b, ζ, γ * υ, H, Polynomial.C ui * G, hβξ, hbm, hb0, hζ, mul_ne_zero hγ hυu.ne_zero,
    ⟨υ, hυu, rfl⟩, hH0, ?_, ?_, ?_, hcomp', q * υi ^ (ℓ - 1), hε, hdis⟩
  · rw [Polynomial.coeff_C_mul, hG0, mul_zero]
  · rw [Polynomial.coeff_C_mul, hui]
  · intro j hj
    rw [Polynomial.coeff_C_mul]
    exact Dvd.dvd.mul_left (hdivG j hj) _

theorem wcLlsKP_nfb_gc_large : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (h g : Polynomial ↥W) (γ w β : ↥W) (m₀ : ℕ), γ ≠ 0 →
      ((ℓ : ℕ) : ↥W) = γ ^ (ℓ - 1) * w → w ∈ IsLocalRing.maximalIdeal ↥W →
      IsUnit (h.coeff 0) → g.coeff 0 = 0 → g.coeff m₀ = 1 → 1 ≤ m₀ → ¬ ℓ ∣ m₀ → ℓ < m₀ →
      β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 → (∀ j, j < m₀ → β ^ (m₀ - j) ∣ g.coeff j) →
      β ^ ((ℓ - 1) * m₀) ∣ w ^ ℓ →
      ∃ (ξ b ζ γ' : ↥W) (h' g' : Polynomial ↥W), β ∣ ξ ∧ b ∈ IsLocalRing.maximalIdeal ↥W ∧
        b ≠ 0 ∧ ζ ^ ℓ = b ∧ γ' ≠ 0 ∧ (∃ υ : ↥W, IsUnit υ ∧ γ' = γ * υ) ∧
        IsUnit (h'.coeff 0) ∧ g'.coeff 0 = 0 ∧ g'.coeff m₀ = 1 ∧
        (∀ j, j < m₀ → b ^ (m₀ - j) ∣ g'.coeff j) ∧
        (h ^ ℓ + Polynomial.C γ ^ ℓ * g).comp (Polynomial.X + Polynomial.C ξ) =
