theorem wcLlsKPas_etale_fibre_normal : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (T : Type u) [CommRing T] (ψ : Polynomial ↥W →+* T), ψ.Etale →
    ∀ (Q : Ideal T) [Q.IsPrime], (∀ π ∈ IsLocalRing.maximalIdeal ↥W, ψ (Polynomial.C π) ∈ Q) →
    IsDomain (Localization.AtPrime Q) ∧ IsIntegrallyClosed (Localization.AtPrime Q) ∧
    IsDomain (Localization.AtPrime Q ⧸ (IsLocalRing.maximalIdeal ↥W).map
      ((algebraMap T (Localization.AtPrime Q)).comp (ψ.comp Polynomial.C))) ∧
    IsIntegrallyClosed (Localization.AtPrime Q ⧸ (IsLocalRing.maximalIdeal ↥W).map
      ((algebraMap T (Localization.AtPrime Q)).comp (ψ.comp Polynomial.C))) :=
by
  intro Ω _ W T _ ψ hψ Q _ hQ
  have hTQ : IsDomain (Localization.AtPrime Q) ∧ IsIntegrallyClosed (Localization.AtPrime Q) := by
    letI : Algebra (Polynomial ↥W) T := ψ.toAlgebra
    haveI : Algebra.Etale (Polynomial ↥W) T := hψ
    exact wc_pks_etale_localization_normal (Polynomial ↥W) T Q
  letI iWT : Algebra ↥W T := (ψ.comp Polynomial.C).toAlgebra
  have hWT : algebraMap ↥W T = ψ.comp Polynomial.C := RingHom.algebraMap_toAlgebra _
  have hm : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W T) ≤ Q := by
    rw [Ideal.map_le_iff_le_comap]
    intro π hπ
    rw [Ideal.mem_comap, hWT]
    exact hQ π hπ
  have hh : (1 : T) ∉ Q := fun h1 => (‹Q.IsPrime›.ne_top) ((Ideal.eq_top_iff_one Q).mpr h1)
  have h1et : RingHom.Etale (algebraMap T (Localization.Away (1 : T))) :=
    RingHom.etale_algebraMap.mpr inferInstance
  have het : RingHom.Etale ((algebraMap T (Localization.Away (1 : T))).comp ψ) :=
    RingHom.Etale.stableUnderComposition ψ (algebraMap T (Localization.Away (1 : T))) hψ h1et
  have hf : ((algebraMap T (Localization.Away (1 : T))).comp ψ).comp
      (algebraMap ↥W (Polynomial ↥W)) =
      (algebraMap T (Localization.Away (1 : T))).comp (algebraMap ↥W T) := by
    rw [Polynomial.algebraMap_eq, hWT, RingHom.comp_assoc]
  have hπ : Function.Surjective
      (Polynomial.mapRingHom (IsLocalRing.residue ↥W)) :=
    Polynomial.map_surjective _ IsLocalRing.residue_surjective
  have hker : RingHom.ker (Polynomial.mapRingHom (IsLocalRing.residue ↥W)) =
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W (Polynomial ↥W)) := by
    rw [Polynomial.ker_mapRingHom, IsLocalRing.ker_residue, Polynomial.algebraMap_eq]
  obtain ⟨E, _, fb, ρ, q, hq, hfbet, -, -, -, -, ⟨eB⟩⟩ :=
    wcpa_dj_llsm_tg_chart_basechange W T Q 1 (Polynomial ↥W)
      ((algebraMap T (Localization.Away (1 : T))).comp ψ)
      (Polynomial (IsLocalRing.ResidueField ↥W))
      (Polynomial.mapRingHom (IsLocalRing.residue ↥W)) hm hh hf het hπ hker
  have hEq : IsDomain (Localization.AtPrime q) ∧ IsIntegrallyClosed (Localization.AtPrime q) := by
    haveI := hq
    letI : Algebra (Polynomial (IsLocalRing.ResidueField ↥W)) E := fb.toAlgebra
    haveI : Algebra.Etale (Polynomial (IsLocalRing.ResidueField ↥W)) E := hfbet
    exact wc_pks_etale_localization_normal (Polynomial (IsLocalRing.ResidueField ↥W)) E q
  have hIJ : ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W T)).map
      (algebraMap T (Localization.AtPrime Q)) =
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap T (Localization.AtPrime Q)).comp (ψ.comp Polynomial.C)) := by
    rw [Ideal.map_map, hWT]
  let e := (Ideal.quotEquivOfEq hIJ.symm).trans eB
  haveI := hEq.1
  haveI := hEq.2
  refine ⟨hTQ.1, hTQ.2, ?_, ?_⟩
  · exact MulEquiv.isDomain (Localization.AtPrime q) e.toMulEquiv
  · exact IsIntegrallyClosed.of_equiv e.symm

theorem wcLlsKPas_prime_contract : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ (c b e : ↥W), c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → ∀ (𝔮 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)) [𝔮.IsPrime], 𝔮.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)) = Ideal.span {⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ - algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (algebraMap ↥W A e)} ⊔ (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A)) → (∀ a : A, a ∉ 𝔭 → algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L) (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) a) ∉ 𝔮) ∧ (∀ π ∈ IsLocalRing.maximalIdeal ↥W, algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L) (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (algebraMap ↥W A π)) ∈ 𝔮) :=
by
  intro Ω _ W A _ _ _ K _ _ _ L _ _ 𝔭 t hPD c b e hc hb hb0 𝔮 _ h𝔮
  obtain ⟨_, hNZ, _, hmax, _, _, hpeq, _⟩ := hPD
  haveI := hNZ

  have hW : ∀ π ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (algebraMap ↥W A π) ∈
        𝔮.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)) := by
    intro π hπ
    rw [h𝔮]
    exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hπ)

  have hJp : (𝔮.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L))).IsPrime :=
    Ideal.IsPrime.comap _

  have hb1 : algebraMap ↥W A b ≠ 0 := by
    rw [Algebra.algebraMap_eq_smul_one]
    intro h
    rcases smul_eq_zero.mp h with h | h
    · exact hb0 h
    · exact one_ne_zero h
  have hb2 : algebraMap A K (algebraMap ↥W A b) ≠ 0 := by
    intro h
    apply hb1
    exact (IsFractionRing.injective A K) (h.trans (map_zero _).symm)

  have hkey : algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (algebraMap ↥W A b) *
      (⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ :
        ↥(Algebra.adjoin A {wcLlsScS W A K t c b})) =
      algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (t - algebraMap ↥W A c) := by
    apply Subtype.ext
    show algebraMap A K (algebraMap ↥W A b) * wcLlsScS W A K t c b =
      algebraMap A K (t - algebraMap ↥W A c)
    unfold wcLlsScS
    exact mul_div_cancel₀ _ hb2

  have htJ : algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) t ∈
      𝔮.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)) := by
    have e : algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) t =
        algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (algebraMap ↥W A b) *
          (⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ :
            ↥(Algebra.adjoin A {wcLlsScS W A K t c b})) +
        algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (algebraMap ↥W A c) := by
      rw [hkey, ← map_add, sub_add_cancel]
    rw [e]
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (hW b hb)) (hW c hc)

  have hle : 𝔭 ≤ (𝔮.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L))).comap
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})) := by
    rw [hpeq]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact htJ
    · rw [Ideal.map_le_iff_le_comap]
      intro π hπ
      exact hW π hπ

  have hne : (𝔮.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L))).comap
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})) ≠ ⊤ := by
    intro h
    apply hJp.ne_top
    rw [Ideal.eq_top_iff_one]
    have h1 : (1 : A) ∈ (𝔮.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L))).comap
          (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})) := by
      rw [h]; exact Submodule.mem_top
    rw [Ideal.mem_comap, map_one] at h1
    exact h1
  have heq := hmax.eq_of_le hne hle

  refine ⟨fun a ha h => ha ?_, fun π hπ => hW π hπ⟩
  rw [heq]
  exact h

theorem wcLlsKPas_chart_etale : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ c b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → ∃ h : A, h ∉ 𝔭 ∧ ∃ ψ : Polynomial ↥W →+* Localization.Away (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) h), ψ.comp Polynomial.C = (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) _).comp ((algebraMap A _).comp (algebraMap ↥W A)) ∧ ψ Polynomial.X = algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) _ ⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∧ ψ.Etale :=
by
  intro Ω _ W A _ _ _ K _ _ _ 𝔭 t hPD c b hc hb hb0
  obtain ⟨-, -, -, -, -, -, -, h, hh, f, hfC, hfX, hfet⟩ := hPD
  refine ⟨h, hh, ?_⟩
  have h0 : h ≠ 0 := fun e => hh (e ▸ 𝔭.zero_mem)
  have hinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hK0 : ∀ n : ℕ, algebraMap A K h ^ n ≠ 0 := fun n =>
    pow_ne_zero n (fun e => h0 (hinj (e.trans (map_zero _).symm)))

  have hpow : Submonoid.powers h ≤ nonZeroDivisors A :=
    powers_le_nonZeroDivisors_of_noZeroDivisors h0
  haveI : IsDomain (Localization.Away h) := IsLocalization.isDomain_localization hpow
  have hunit : ∀ y : Submonoid.powers h, IsUnit (algebraMap A K y) := by
    rintro ⟨y, n, rfl⟩
    refine isUnit_iff_ne_zero.mpr ?_
    show algebraMap A K (h ^ n) ≠ 0
    rw [map_pow]
    exact hK0 n
  let ι : Localization.Away h →+* K := IsLocalization.lift (M := Submonoid.powers h) hunit
  have hιa : ∀ a : A, ι (algebraMap A (Localization.Away h) a) = algebraMap A K a :=
    fun a => IsLocalization.lift_eq hunit a
  have hιinj : Function.Injective ι := by
    show Function.Injective (IsLocalization.lift (M := Submonoid.powers h)
      (S := Localization.Away h) hunit)
    rw [IsLocalization.lift_injective_iff]
    intro x y
    rw [(IsLocalization.injective (Localization.Away h) hpow).eq_iff, hinj.eq_iff]
  letI : Algebra (Localization.Away h) K := ι.toAlgebra
  have hBK : algebraMap (Localization.Away h) K = ι := rfl

  have s2 : ∀ s : K, ∃ E : ↥(Algebra.adjoin (Localization.Away h) {s}) ≃+*
      Localization.Away (algebraMap A ↥(Algebra.adjoin A {s}) h),
      (∀ a : A, E (algebraMap (Localization.Away h) ↥(Algebra.adjoin (Localization.Away h) {s})
        (algebraMap A (Localization.Away h) a)) =
        algebraMap ↥(Algebra.adjoin A {s}) (Localization.Away (algebraMap A ↥(Algebra.adjoin A {s}) h))
          (algebraMap A ↥(Algebra.adjoin A {s}) a)) ∧
      E ⟨s, Algebra.subset_adjoin (Set.mem_singleton _)⟩ =
        algebraMap ↥(Algebra.adjoin A {s}) (Localization.Away (algebraMap A ↥(Algebra.adjoin A {s}) h))
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton _)⟩ := by
    intro s

    have hsub : ∀ x ∈ Algebra.adjoin A {s}, x ∈ Algebra.adjoin (Localization.Away h) {s} := by
      intro x hx
      induction hx using Algebra.adjoin_induction with
      | mem x hx => exact Algebra.subset_adjoin hx
      | algebraMap a =>
        rw [← hιa a]
        exact Subalgebra.algebraMap_mem _ _
      | add x y _ _ hx hy => exact Subalgebra.add_mem _ hx hy
      | mul x y _ _ hx hy => exact Subalgebra.mul_mem _ hx hy
    let incl : ↥(Algebra.adjoin A {s}) →+* ↥(Algebra.adjoin (Localization.Away h) {s}) :=
      { toFun := fun r => ⟨r.1, hsub r.1 r.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hinclinj : Function.Injective incl := fun x y e =>
      Subtype.ext (congrArg Subtype.val e : _)
    have hI1 : ∀ a : A, incl (algebraMap A ↥(Algebra.adjoin A {s}) a) =
        algebraMap (Localization.Away h) ↥(Algebra.adjoin (Localization.Away h) {s})
          (algebraMap A (Localization.Away h) a) := by
      intro a
      apply Subtype.ext
      show algebraMap A K a = ι (algebraMap A (Localization.Away h) a)
      rw [hιa]

    have hu : ∀ y : Submonoid.powers (algebraMap A ↥(Algebra.adjoin A {s}) h), IsUnit (incl y) := by
      rintro ⟨y, n, rfl⟩
      show IsUnit (incl (algebraMap A _ h ^ n))
      rw [map_pow, hI1]
      exact ((IsLocalization.Away.algebraMap_isUnit (S := Localization.Away h) h).map _).pow n
    let Φ : Localization.Away (algebraMap A ↥(Algebra.adjoin A {s}) h) →+*
        ↥(Algebra.adjoin (Localization.Away h) {s}) :=
      IsLocalization.lift (M := Submonoid.powers (algebraMap A ↥(Algebra.adjoin A {s}) h)) hu
    have hΦ : ∀ r, Φ (algebraMap _ _ r) = incl r := fun r => IsLocalization.lift_eq hu r

    have hR0 : algebraMap A ↥(Algebra.adjoin A {s}) h ≠ 0 := by
      intro e
      have e' : algebraMap A K h = 0 := congrArg Subtype.val e
      exact h0 (hinj (e'.trans (map_zero _).symm))
    have hΦinj : Function.Injective Φ := by
      show Function.Injective (IsLocalization.lift
        (M := Submonoid.powers (algebraMap A ↥(Algebra.adjoin A {s}) h))
        (S := Localization.Away (algebraMap A ↥(Algebra.adjoin A {s}) h)) hu)
      rw [IsLocalization.lift_injective_iff]
      intro x y
      rw [(IsLocalization.injective (Localization.Away (algebraMap A ↥(Algebra.adjoin A {s}) h))
        (powers_le_nonZeroDivisors_of_noZeroDivisors hR0)).eq_iff, hinclinj.eq_iff]

    have hD : ∀ y ∈ Algebra.adjoin (Localization.Away h) {s}, ∃ (n : ℕ)
        (r : ↥(Algebra.adjoin A {s})), algebraMap A K h ^ n * y = (r : K) := by
      intro y hy
      induction hy using Algebra.adjoin_induction with
      | mem x hx =>
        exact ⟨0, ⟨x, Algebra.subset_adjoin hx⟩, by rw [pow_zero, one_mul]⟩
      | algebraMap β =>
        obtain ⟨n, a, hna⟩ := IsLocalization.Away.surj h β
        refine ⟨n, algebraMap A _ a, ?_⟩
        have e := congrArg ι hna
        rw [map_mul, map_pow, hιa, hιa] at e
        show algebraMap A K h ^ n * ι β = algebraMap A K a
        rw [mul_comm]
        exact e
      | add x y _ _ hx hy =>
        obtain ⟨n, r, hr⟩ := hx
        obtain ⟨m, r', hr'⟩ := hy
        refine ⟨n + m, algebraMap A _ h ^ m * r + algebraMap A _ h ^ n * r', ?_⟩
        have e : ((algebraMap A ↥(Algebra.adjoin A {s}) h ^ m * r +
            algebraMap A ↥(Algebra.adjoin A {s}) h ^ n * r' : ↥(Algebra.adjoin A {s})) : K) =
            algebraMap A K h ^ m * (r : K) + algebraMap A K h ^ n * (r' : K) := rfl
        rw [e, pow_add, ← hr, ← hr']
        ring
      | mul x y _ _ hx hy =>
        obtain ⟨n, r, hr⟩ := hx
        obtain ⟨m, r', hr'⟩ := hy
        refine ⟨n + m, r * r', ?_⟩
        show algebraMap A K h ^ (n + m) * (x * y) = (r : K) * (r' : K)
        rw [pow_add, ← hr, ← hr']
        ring
    have hΦsurj : Function.Surjective Φ := by
      intro y
      obtain ⟨n, r, hr⟩ := hD y.1 y.2
      let σ : Submonoid.powers (algebraMap A ↥(Algebra.adjoin A {s}) h) :=
        ⟨algebraMap A _ h ^ n, n, rfl⟩
      refine ⟨IsLocalization.mk' (Localization.Away (algebraMap A ↥(Algebra.adjoin A {s}) h)) r σ,
        ?_⟩
      have hspec := IsLocalization.mk'_spec
        (Localization.Away (algebraMap A ↥(Algebra.adjoin A {s}) h)) r σ
      have e1 := congrArg Φ hspec
      rw [map_mul, hΦ, hΦ] at e1
      have e2 := congrArg Subtype.val e1
      have e4 : (((incl (σ : ↥(Algebra.adjoin A {s}))) :
          ↥(Algebra.adjoin (Localization.Away h) {s})) : K) = algebraMap A K h ^ n := by
        show (((algebraMap A ↥(Algebra.adjoin A {s}) h ^ n : ↥(Algebra.adjoin A {s}))) : K) = _
        rw [SubmonoidClass.coe_pow]
        rfl
      have e3 : ((Φ (IsLocalization.mk' (Localization.Away
          (algebraMap A ↥(Algebra.adjoin A {s}) h)) r σ) :
          ↥(Algebra.adjoin (Localization.Away h) {s})) : K) * algebraMap A K h ^ n = (r : K) := by
        rw [← e4, ← MulMemClass.coe_mul]
        exact e2
      apply Subtype.ext
      apply mul_right_cancel₀ (hK0 n)
      rw [e3, ← hr, mul_comm]

    have hbij : Function.Bijective Φ := ⟨hΦinj, hΦsurj⟩
    refine ⟨(RingEquiv.ofBijective Φ hbij).symm, ?_, ?_⟩
    · intro a
      rw [RingEquiv.symm_apply_eq, RingEquiv.ofBijective_apply, hΦ, hI1]
    · rw [RingEquiv.symm_apply_eq, RingEquiv.ofBijective_apply, hΦ]
      rfl

  have hfC' : f.comp Polynomial.C = algebraMap ↥W (Localization.Away h) := by
    rw [hfC, IsScalarTower.algebraMap_eq ↥W A (Localization.Away h)]
  obtain ⟨hbB, hreg⟩ :=
    wcpa_dj_llsm_brrc_regular_pair Ω W (Localization.Away h) f c b hfet hfC' hb0
  have hker := wcpa_dj_llsmacr_rees_kernel (Localization.Away h) K hιinj
    (algebraMap ↥W (Localization.Away h) b) (f Polynomial.X - algebraMap ↥W (Localization.Away h) c)
    hbB hreg
  have hs : algebraMap (Localization.Away h) K (f Polynomial.X - algebraMap ↥W (Localization.Away h) c) /
      algebraMap (Localization.Away h) K (algebraMap ↥W (Localization.Away h) b) =
      wcLlsScS W A K t c b := by
    rw [hfX, hBK, IsScalarTower.algebraMap_apply ↥W A (Localization.Away h) c,
      IsScalarTower.algebraMap_apply ↥W A (Localization.Away h) b, ← map_sub, hιa, hιa]
    rfl
  have hD' := wcpa_dj_llsm_brrc_disc_etale Ω W (Localization.Away h) K f c b hιinj hfet hfC' hbB
    hker.le
  rw [hs] at hD'
  obtain ⟨ψ₁, h1, h2, h3⟩ := hD'
  obtain ⟨E, hE1, hE2⟩ := s2 (wcLlsScS W A K t c b)
  refine ⟨E.toRingHom.comp ψ₁, ?_, ?_, RingHom.Etale.respectsIso.1 ψ₁ E h3⟩
  · apply RingHom.ext
    intro π
    show E (ψ₁ (Polynomial.C π)) = _
    rw [show ψ₁ (Polynomial.C π) = algebraMap (Localization.Away h) _
        (algebraMap ↥W (Localization.Away h) π) from RingHom.congr_fun h1 π,
      IsScalarTower.algebraMap_apply ↥W A (Localization.Away h) π, hE1]
    rfl
  · show E (ψ₁ Polynomial.X) = _
    rw [h2]
    exact hE2

theorem wcLlsKPas_chart_localize : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (R : Type u) [CommRing R] [IsDomain R] (K : Type u) [Field K] [Algebra R K] (L : Type u) [Field L] [Algebra K L] (h d : R), Function.Injective (algebraMap R K) → h ≠ 0 → d ≠ 0 → ∀ ψ₀ : Polynomial ↥W →+* Localization.Away h, ψ₀.Etale → ∃ (P : Type u) (_ : CommRing P) (_ : IsDomain P) (_ : Algebra P K) (_ : Algebra P L) (_ : IsScalarTower P K L) (ψP : Polynomial ↥W →+* P) (ι : Localization.Away h →+* P), ψP.Etale ∧ ψP = ι.comp ψ₀ ∧ Function.Injective (algebraMap P K) ∧ (∀ r : R, algebraMap P K (ι (algebraMap R (Localization.Away h) r)) = algebraMap R K r) ∧ (∀ x : P, ∃ (r : R) (n : ℕ), algebraMap P K x * algebraMap R K (h * d) ^ n = algebraMap R K r) ∧ (∀ (x : K) (n : ℕ), algebraMap R K d ^ n * x ∈ Set.range (algebraMap R K) → x ∈ Set.range (algebraMap P K)) :=
by
  intro Ω _ W R _ _ K _ _ L _ _ h d hinj hh hd ψ₀ hψ₀
  classical
  have hpow : Submonoid.powers h ≤ nonZeroDivisors R :=
    powers_le_nonZeroDivisors_of_noZeroDivisors hh
  haveI : IsDomain (Localization.Away h) := IsLocalization.isDomain_localization hpow
  have hjinj : Function.Injective (algebraMap R (Localization.Away h)) :=
    IsLocalization.injective _ hpow
  set d' := algebraMap R (Localization.Away h) d with hd'
  have hd'0 : d' ≠ 0 := (map_ne_zero_iff _ hjinj).mpr hd
  have hpow' : Submonoid.powers d' ≤ nonZeroDivisors (Localization.Away h) :=
    powers_le_nonZeroDivisors_of_noZeroDivisors hd'0
  haveI hPdom : IsDomain (Localization.Away d') := IsLocalization.isDomain_localization hpow'
  have hhK : algebraMap R K h ≠ 0 := (map_ne_zero_iff _ hinj).mpr hh
  have hdK : algebraMap R K d ≠ 0 := (map_ne_zero_iff _ hinj).mpr hd
  let lh : Localization.Away h →+* K := IsLocalization.Away.lift h (IsUnit.mk0 _ hhK)
  have lh_eq : ∀ a : R, lh (algebraMap R _ a) = algebraMap R K a := fun a =>
    IsLocalization.Away.lift_eq h _ a
  have hlhd : IsUnit (lh d') := by rw [hd', lh_eq]; exact IsUnit.mk0 _ hdK
  let lam : Localization.Away d' →+* K := IsLocalization.Away.lift d' hlhd
  have lam_eq : ∀ y, lam (algebraMap _ _ y) = lh y := fun y =>
    IsLocalization.Away.lift_eq d' hlhd y
  have star : ∀ a : R, lam (algebraMap (Localization.Away h) (Localization.Away d')
      (algebraMap R _ a)) = algebraMap R K a := fun a => by rw [lam_eq, lh_eq]
  have star' : ∀ a : R, lam (algebraMap R (Localization.Away d') a) = algebraMap R K a :=
    fun a => by
      rw [IsScalarTower.algebraMap_apply R (Localization.Away h) (Localization.Away d'), star]
  letI iPK : Algebra (Localization.Away d') K := lam.toAlgebra
  letI iPL : Algebra (Localization.Away d') L := ((algebraMap K L).comp lam).toAlgebra
  haveI tow : IsScalarTower (Localization.Away d') K L :=
    IsScalarTower.of_algebraMap_eq (fun x => rfl)
  have hιet : (algebraMap (Localization.Away h) (Localization.Away d')).Etale :=
    RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway d')
  haveI hmul : IsLocalization.Away (h * d) (Localization.Away d') :=
    IsLocalization.Away.mul' (Localization.Away h) (Localization.Away d') h d
  have c5 : ∀ x : Localization.Away d', ∃ (r : R) (n : ℕ),
      lam x * algebraMap R K (h * d) ^ n = algebraMap R K r := by
    intro x
    obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj (h * d) x
    refine ⟨a, n, ?_⟩
    have h1 := congrArg lam ha
    rw [map_mul, map_pow, star', star'] at h1
    exact h1
  have c3 : Function.Injective lam := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj (h * d) x
    have h1 := congrArg lam ha
    rw [map_mul, hx, zero_mul, star'] at h1
    have ha0 : a = 0 := hinj (by rw [← h1, map_zero])
    rw [ha0, map_zero] at ha
    have hu : IsUnit (algebraMap R (Localization.Away d') (h * d) ^ n) :=
      (IsLocalization.Away.algebraMap_isUnit (h * d)).pow n
    exact hu.mul_left_eq_zero.mp ha
  have c6 : ∀ (x : K) (n : ℕ), algebraMap R K d ^ n * x ∈ Set.range (algebraMap R K) →
      x ∈ Set.range lam := by
    rintro x n ⟨r, hr⟩
    refine ⟨algebraMap _ _ (algebraMap R (Localization.Away h) r) *
      IsLocalization.Away.invSelf (S := Localization.Away d') d' ^ n, ?_⟩
    have he : lam (IsLocalization.Away.invSelf (S := Localization.Away d') d') *
        algebraMap R K d = 1 := by
      have := congrArg lam (IsLocalization.Away.mul_invSelf (S := Localization.Away d') d')
      have hlh : lh d' = algebraMap R K d := lh_eq d
      rw [map_mul, map_one, lam_eq, hlh] at this
      rw [mul_comm]; exact this
    rw [map_mul, map_pow, star, hr]
    calc algebraMap R K d ^ n * x * lam (IsLocalization.Away.invSelf (S := Localization.Away d') d') ^ n
        = (lam (IsLocalization.Away.invSelf (S := Localization.Away d') d') *
            algebraMap R K d) ^ n * x := by ring
      _ = x := by rw [he, one_pow, one_mul]
  exact ⟨Localization.Away d', inferInstance, hPdom, iPK, iPL, tow,
    (algebraMap _ _).comp ψ₀, algebraMap _ _,
    RingHom.Etale.stableUnderComposition ψ₀ _ hψ₀ hιet, rfl, c3, star, c5, c6⟩

theorem wcLlsKPas_poly_lift : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (P : Type u) [CommRing P] (K : Type u) [Field K] [Algebra P K] (ψP : Polynomial ↥W →+* P) (ℓ : ℕ) (ε : ↥W) (F : Polynomial K), Function.Injective (algebraMap P K) → 2 ≤ ℓ → (ℓ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W → F.Monic → F.natDegree = ℓ → (∀ i, F.coeff i ∈ Set.range (algebraMap P K)) → (∀ i, 2 ≤ i → i < ℓ → ∃ π ∈ IsLocalRing.maximalIdeal ↥W, ∃ y : P, F.coeff i = algebraMap P K (ψP (Polynomial.C π) * y)) → (∃ π ∈ IsLocalRing.maximalIdeal ↥W, ∃ y : P, F.coeff 1 - algebraMap P K (ψP (Polynomial.C ε)) = algebraMap P K (ψP (Polynomial.C π) * y)) → ∃ FP : Polynomial P, FP.map (algebraMap P K) = F ∧ FP.Monic ∧ FP.natDegree = ℓ ∧ ∀ k : ℕ, ∃ π ∈ IsLocalRing.maximalIdeal ↥W, ∃ y : P, (Polynomial.derivative FP - Polynomial.C (ψP (Polynomial.C ε))).coeff k = ψP (Polynomial.C π) * y :=
by
  intro Ω _ W P _ K _ _ ψP ℓ ε F hinj hℓ hℓm hmon hdeg hlift hmid h1
  have hF : F ∈ Polynomial.lifts (algebraMap P K) := (Polynomial.lifts_iff_coeff_lifts F).2 hlift
  obtain ⟨FP, hmap, hFPdeg, hFPmon⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hF hmon
  rw [hdeg] at hFPdeg
  have hco : ∀ n, algebraMap P K (FP.coeff n) = F.coeff n := by
    intro n
    rw [← hmap, Polynomial.coeff_map]
  refine ⟨FP, hmap, hFPmon, hFPdeg, fun k => ?_⟩
  rw [Polynomial.coeff_sub, Polynomial.coeff_derivative, Polynomial.coeff_C]
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · obtain ⟨π, hπ, y, hy⟩ := h1
    refine ⟨π, hπ, y, ?_⟩
    simp only [↓reduceIte, Nat.cast_zero, zero_add, mul_one]
    apply hinj
    rw [map_sub, hco, hy]
  · rw [if_neg (show k ≠ 0 by omega), sub_zero]
    rcases lt_trichotomy (k + 1) ℓ with hlt | heq | hgt
    · obtain ⟨π, hπ, y, hy⟩ := hmid (k + 1) (by omega) hlt
      have hc : FP.coeff (k + 1) = ψP (Polynomial.C π) * y := hinj (by rw [hco, hy])
      exact ⟨π, hπ, y * ((k : P) + 1), by rw [hc, mul_assoc]⟩
    · refine ⟨(ℓ : W), hℓm, 1, ?_⟩
      have hc : FP.coeff (k + 1) = 1 := by
        rw [heq, ← hFPdeg]
        exact hFPmon.coeff_natDegree
      rw [hc, one_mul, mul_one, map_natCast, map_natCast, ← heq]
      push_cast
      ring
    · refine ⟨0, zero_mem _, 0, ?_⟩
      rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), zero_mul, mul_zero]

theorem wcLlsKPas_root_etale : ∀ (P : Type u) [CommRing P] [IsDomain P] (L : Type u) [Field L] [Algebra P L] (w : L) (F : Polynomial P), F.Monic → Polynomial.aeval w F = 0 → (∀ G : Polynomial P, Polynomial.aeval w G = 0 → F ∣ G) → ∀ (hu : Polynomial.aeval w (Polynomial.derivative F) ≠ 0), Algebra.Etale P (Localization.Away (⟨Polynomial.aeval w (Polynomial.derivative F), Polynomial.aeval_mem_adjoin_singleton P w⟩ : ↥(Algebra.adjoin P {w}))) :=
by
  intro P _ _ L _ _ w F hF hFw hdiv _
  let wC : Algebra.adjoin P {w} := ⟨w, Algebra.subset_adjoin (Set.mem_singleton w)⟩
  have hcoe : ∀ G : Polynomial P, ((Polynomial.aeval wC G : Algebra.adjoin P {w}) : L) =
      Polynomial.aeval w G := by
    intro G
    rw [Polynomial.aeval_subalgebra_coe]
  have hwC : Polynomial.aeval wC F = 0 := by
    apply Subtype.val_injective
    rw [hcoe, hFw]
    rfl
  let Φ : AdjoinRoot F →ₐ[P] Algebra.adjoin P {w} :=
    AdjoinRoot.liftAlgHom F (Algebra.ofId P _) wC (by rw [← hwC, Polynomial.aeval_def]; rfl)
  have hΦ : ∀ G : Polynomial P, ((Φ (AdjoinRoot.mk F G) : Algebra.adjoin P {w}) : L) =
      Polynomial.aeval w G := by
    intro G
    rw [← hcoe]
    simp only [Φ, AdjoinRoot.liftAlgHom_mk]
    rw [Polynomial.aeval_def]
    rfl
  have hinj : Function.Injective Φ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨G, rfl⟩ := AdjoinRoot.mk_surjective x
    rw [AdjoinRoot.mk_eq_zero]
    apply hdiv
    rw [← hΦ, hx]
    rfl
  have hsurj : Function.Surjective Φ := by
    intro c
    have hc : (c : L) ∈ (Polynomial.aeval (R := P) w).range := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval]
      exact c.2
    obtain ⟨G, hG⟩ := hc
    refine ⟨AdjoinRoot.mk F G, Subtype.ext ?_⟩
    rw [hΦ]
    exact hG
  let e : AdjoinRoot F ≃ₐ[P] Algebra.adjoin P {w} := AlgEquiv.ofBijective Φ ⟨hinj, hsurj⟩
  have he : e (AdjoinRoot.mk F (Polynomial.derivative F)) =
      (⟨Polynomial.aeval w (Polynomial.derivative F), Polynomial.aeval_mem_adjoin_singleton P w⟩ :
        ↥(Algebra.adjoin P {w})) := by
    apply Subtype.ext
    exact hΦ _
  let SP : StandardEtalePair P := ⟨F, hF, Polynomial.derivative F, ⟨1, 0, 1, by simp⟩⟩
  have : Algebra.Etale P (Localization.Away (AdjoinRoot.mk F (Polynomial.derivative F))) :=
    Algebra.Etale.of_equiv SP.equivAwayAdjoinRoot
  have hsub : Submonoid.map e (Submonoid.powers (AdjoinRoot.mk F (Polynomial.derivative F))) =
      Submonoid.powers (⟨Polynomial.aeval w (Polynomial.derivative F),
        Polynomial.aeval_mem_adjoin_singleton P w⟩ : ↥(Algebra.adjoin P {w})) := by
    rw [Submonoid.map_powers, he]
  exact Algebra.Etale.of_equiv
    (IsLocalization.algEquivOfAlgEquiv (Localization.Away (AdjoinRoot.mk F (Polynomial.derivative F)))
      (Localization.Away (⟨Polynomial.aeval w (Polynomial.derivative F),
        Polynomial.aeval_mem_adjoin_singleton P w⟩ : ↥(Algebra.adjoin P {w}))) e hsub)

theorem wcLlsKPas_scaled_integral : ∀ (R : Type u) [CommRing R] (P : Type u) [CommRing P] (L : Type u) [Field L] [Algebra R L] [Algebra P L] (g : R) (w : L) (FP : Polynomial P), FP.Monic → Polynomial.aeval w FP = 0 → (∀ x : P, ∃ (r : R) (n : ℕ), algebraMap P L x * algebraMap R L g ^ n = algebraMap R L r) → ∃ N : ℕ, IsIntegral R (algebraMap R L g ^ N * w) :=
by
  intro R _ P _ L _ _ _ g w FP hmon hw hfrac
  classical
  choose r n hrn using hfrac
  set M := ∑ i ∈ Finset.range FP.natDegree, n (FP.coeff i) with hM
  refine ⟨M, ?_⟩
  have hFmmon : (FP.map (algebraMap P L)).Monic := hmon.map _
  have hFmdeg : (FP.map (algebraMap P L)).natDegree = FP.natDegree := hmon.natDegree_map _
  have hFmw : Polynomial.eval₂ (RingHom.id L) w (FP.map (algebraMap P L)) = 0 := by
    rw [Polynomial.eval₂_id, Polynomial.eval_map, ← Polynomial.aeval_def, hw]
  have hHmon : ((FP.map (algebraMap P L)).scaleRoots (algebraMap R L g ^ M)).Monic :=
    (Polynomial.monic_scaleRoots_iff _).mpr hFmmon
  have hHroot : Polynomial.eval (algebraMap R L g ^ M * w)
      ((FP.map (algebraMap P L)).scaleRoots (algebraMap R L g ^ M)) = 0 := by
    have := Polynomial.scaleRoots_eval₂_eq_zero (RingHom.id L) (s := algebraMap R L g ^ M) hFmw
    rwa [Polynomial.eval₂_id, RingHom.id_apply] at this
  have hlift : (FP.map (algebraMap P L)).scaleRoots (algebraMap R L g ^ M) ∈
      Polynomial.lifts (algebraMap R L) := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro i
    rw [Polynomial.coeff_scaleRoots, hFmdeg, Polynomial.coeff_map]
    rcases lt_trichotomy i FP.natDegree with hi | hi | hi
    · have hle : n (FP.coeff i) ≤ M := by
        rw [hM]
        exact Finset.single_le_sum (f := fun j => n (FP.coeff j)) (fun j _ => Nat.zero_le _)
          (Finset.mem_range.mpr hi)
      have hle2 : M ≤ M * (FP.natDegree - i) := Nat.le_mul_of_pos_right M (by omega)
      refine ⟨r (FP.coeff i) * g ^ (M * (FP.natDegree - i) - n (FP.coeff i)), ?_⟩
      rw [map_mul, map_pow, ← hrn, mul_assoc, ← pow_add, ← pow_mul,
        Nat.add_sub_cancel' (hle.trans hle2)]
    · refine ⟨1, ?_⟩
      rw [hi, Nat.sub_self, pow_zero, mul_one, hmon.coeff_natDegree, map_one, map_one]
    · refine ⟨0, ?_⟩
      rw [Polynomial.coeff_eq_zero_of_natDegree_lt hi, map_zero, map_zero, zero_mul]
  obtain ⟨q, hqmap, -, hqmon⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hHmon
  exact ⟨q, hqmon, by rw [Polynomial.eval₂_eq_eval_map, hqmap]; exact hHroot⟩

theorem wcLlsKPas_model_localize : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (R : Type u) [CommRing R] (L : Type u) [Field L] [Algebra R L] (𝔮 : Ideal ↥(integralClosure R L)) [𝔮.IsPrime] (wR : ↥W →+* R) (T : Type u) [CommRing T] (ψ : Polynomial ↥W →+* T) (j₀ : T →+* L), Function.Injective j₀ → (∀ π ∈ IsLocalRing.maximalIdeal ↥W, algebraMap R ↥(integralClosure R L) (wR π) ∈ 𝔮) → (∀ π : ↥W, j₀ (ψ (Polynomial.C π)) = algebraMap R L (wR π)) → (∀ l : L, ∃ x y : T, j₀ y ≠ 0 ∧ l * j₀ y = j₀ x) → (∀ r : R, ∃ x : T, j₀ x = algebraMap R L r) → (∀ x : T, ∃ z s : ↥(integralClosure R L), s ∉ 𝔮 ∧ j₀ x * (s : L) = (z : L)) → ∃ (Q : Ideal T) (_ : Q.IsPrime) (j : Localization.AtPrime Q →+* L) (φ : Localization.AtPrime Q →+* Localization.AtPrime 𝔮), (∀ π ∈ IsLocalRing.maximalIdeal ↥W, ψ (Polynomial.C π) ∈ Q) ∧ Function.Injective j ∧ IsLocalHom φ ∧ (∀ π : ↥W, φ (algebraMap T (Localization.AtPrime Q) (ψ (Polynomial.C π))) = algebraMap ↥(integralClosure R L) (Localization.AtPrime 𝔮) (algebraMap R ↥(integralClosure R L) (wR π))) ∧ (∀ l : L, ∃ x y : Localization.AtPrime Q, j y ≠ 0 ∧ l * j y = j x) ∧ (∀ r : R, ∃ x : Localization.AtPrime Q, j x = algebraMap R L r) ∧ (∀ x : Localization.AtPrime Q, ∃ z s : ↥(integralClosure R L), s ∉ 𝔮 ∧ φ x * algebraMap ↥(integralClosure R L) (Localization.AtPrime 𝔮) s = algebraMap ↥(integralClosure R L) (Localization.AtPrime 𝔮) z ∧ j x * (s : L) = (z : L)) :=
by
  intro Ω _ W R _ L _ _ 𝔮 _ wR T _ ψ j₀ hj₀ H2 H3 H4 H5 H6
  classical

  have hg : ∀ y : 𝔮.primeCompl, IsUnit (algebraMap ↥(integralClosure R L) L y) := by
    intro y
    rw [isUnit_iff_ne_zero]
    intro h
    apply y.2
    have h0 : (y : ↥(integralClosure R L)) = 0 := Subtype.ext h
    rw [h0]
    exact 𝔮.zero_mem
  let ι : Localization.AtPrime 𝔮 →+* L :=
    IsLocalization.lift (M := 𝔮.primeCompl) (S := Localization.AtPrime 𝔮) hg
  have hιB : ∀ b : ↥(integralClosure R L),
      ι (algebraMap ↥(integralClosure R L) (Localization.AtPrime 𝔮) b) = (b : L) :=
    fun b => IsLocalization.lift_eq hg b
  have hιinj : Function.Injective ι := by
    apply (IsLocalization.lift_injective_iff (M := 𝔮.primeCompl) (S := Localization.AtPrime 𝔮)
      hg).mpr
    intro x y
    constructor
    · intro h
      have h1 := congrArg ι h
      rw [hιB, hιB] at h1
      exact h1
    · intro h
      have h1 : x = y := Subtype.ext h
      rw [h1]
  have hιmk : ∀ (z : ↥(integralClosure R L)) (s : 𝔮.primeCompl),
      ι (IsLocalization.mk' (Localization.AtPrime 𝔮) z s) * ((s : ↥(integralClosure R L)) : L) =
        (z : L) := by
    intro z s
    have h1 := (IsLocalization.lift_mk'_spec (M := 𝔮.primeCompl) (S := Localization.AtPrime 𝔮)
      (g := algebraMap ↥(integralClosure R L) L) hg z
      (ι (IsLocalization.mk' (Localization.AtPrime 𝔮) z s)) s).mp rfl
    rw [mul_comm]
    exact h1.symm

  have hrange : ∀ x : T, j₀ x ∈ ι.range := by
    intro x
    obtain ⟨z, s, hs, hzs⟩ := H6 x
    refine ⟨IsLocalization.mk' (Localization.AtPrime 𝔮) z (⟨s, hs⟩ : 𝔮.primeCompl), ?_⟩
    have h1 := hιmk z ⟨s, hs⟩
    have hs0 : (s : L) ≠ 0 := by
      intro h
      apply hs
      have h0 : s = 0 := Subtype.ext h
      rw [h0]
      exact 𝔮.zero_mem
    apply mul_right_cancel₀ hs0
    rw [hzs]
    exact h1
  have hRinj : Function.Injective ι.rangeRestrict := by
    intro a b h
    apply hιinj
    have h1 := congrArg Subtype.val h
    simpa using h1
  let e := RingEquiv.ofBijective ι.rangeRestrict ⟨hRinj, ι.rangeRestrict_surjective⟩
  let φ₀ : T →+* Localization.AtPrime 𝔮 :=
    (e.symm : ι.range →+* Localization.AtPrime 𝔮).comp (j₀.codRestrict ι.range hrange)
  have hφ₀ : ∀ x : T, ι (φ₀ x) = j₀ x := by
    intro x
    have h1 : ι.rangeRestrict (φ₀ x) = j₀.codRestrict ι.range hrange x := by
      show e (e.symm _) = _
      exact e.apply_symm_apply _
    have h2 := congrArg Subtype.val h1
    simpa using h2
  have hφ₀inj : Function.Injective φ₀ := by
    intro x y h
    apply hj₀
    rw [← hφ₀, ← hφ₀, h]

  have W0 : ∀ π : ↥W, φ₀ (ψ (Polynomial.C π)) =
      algebraMap ↥(integralClosure R L) (Localization.AtPrime 𝔮)
        (algebraMap R ↥(integralClosure R L) (wR π)) := by
    intro π
    apply hιinj
    rw [hφ₀, H3, hιB]
    rfl

  let Q : Ideal T := Ideal.comap φ₀ (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮))
  haveI hQ : Q.IsPrime := Ideal.comap_isPrime φ₀ _
  have hg2 : ∀ y : Q.primeCompl, IsUnit (φ₀ y) := by
    intro y
    exact IsLocalRing.notMem_maximalIdeal.mp y.2
  let φ : Localization.AtPrime Q →+* Localization.AtPrime 𝔮 :=
    IsLocalization.lift (M := Q.primeCompl) (S := Localization.AtPrime Q) hg2
  have hφ : ∀ t : T, φ (algebraMap T (Localization.AtPrime Q) t) = φ₀ t :=
    fun t => IsLocalization.lift_eq hg2 t
  have hφinj : Function.Injective φ := by
    apply (IsLocalization.lift_injective_iff (M := Q.primeCompl) (S := Localization.AtPrime Q)
      hg2).mpr
    intro x y
    constructor
    · intro h
      have h1 := congrArg φ h
      rw [hφ, hφ] at h1
      exact h1
    · intro h
      rw [hφ₀inj h]
  have hloc : IsLocalHom φ := by
    refine ⟨fun a ha => ?_⟩
    obtain ⟨⟨x, σ⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl a
    have h1 := (IsLocalization.lift_mk'_spec (M := Q.primeCompl) (S := Localization.AtPrime Q)
      (g := φ₀) hg2 x (φ (IsLocalization.mk' (Localization.AtPrime Q) x σ)) σ).mp rfl
    have hu : IsUnit (φ₀ x) := by
      rw [h1]
      exact (hg2 σ).mul ha
    have hx : x ∈ Q.primeCompl := by
      intro hxQ
      exact (IsLocalRing.notMem_maximalIdeal.mpr hu) hxQ
    exact (IsLocalization.AtPrime.isUnit_mk'_iff (Localization.AtPrime Q) Q x σ).mpr hx

  let j : Localization.AtPrime Q →+* L := ι.comp φ
  have hj : ∀ t : T, j (algebraMap T (Localization.AtPrime Q) t) = j₀ t := by
    intro t
    show ι (φ (algebraMap T (Localization.AtPrime Q) t)) = j₀ t
    rw [hφ, hφ₀]
  refine ⟨Q, hQ, j, φ, ?_, hιinj.comp hφinj, hloc, ?_, ?_, ?_, ?_⟩
  · intro π hπ
    show φ₀ (ψ (Polynomial.C π)) ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)
    rw [W0]
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔮) 𝔮 _).mpr
      (H2 π hπ)
  · intro π
    rw [hφ, W0]
  · intro l
    obtain ⟨x, y, hy, hxy⟩ := H4 l
    refine ⟨algebraMap T _ x, algebraMap T _ y, ?_, ?_⟩
    · rw [hj]; exact hy
    · rw [hj, hj]; exact hxy
  · intro r
    obtain ⟨x, hx⟩ := H5 r
    exact ⟨algebraMap T _ x, by rw [hj]; exact hx⟩
  · intro x
    obtain ⟨⟨z, s⟩, hzs⟩ := IsLocalization.mk'_surjective 𝔮.primeCompl (φ x)
    refine ⟨z, s, s.2, ?_, ?_⟩
    · rw [← hzs]
      exact IsLocalization.mk'_spec _ z s
    · show ι (φ x) * _ = _
      rw [← hzs]
      exact hιmk z s

theorem wcLlsKPas_model_ring : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (R : Type u) [CommRing R] (L : Type u) [Field L] [Algebra R L] (𝔮 : Ideal ↥(integralClosure R L)) [𝔮.IsPrime] (wR : ↥W →+* R) (P : Type u) [CommRing P] [Algebra P L] (ψP : Polynomial ↥W →+* P) (g : R) (w : L) (FP : Polynomial P) (ε : ↥W), ψP.Etale → Function.Injective (algebraMap P L) → (∀ π : ↥W, algebraMap P L (ψP (Polynomial.C π)) = algebraMap R L (wR π)) → (∀ π ∈ IsLocalRing.maximalIdeal ↥W, algebraMap R ↥(integralClosure R L) (wR π) ∈ 𝔮) → algebraMap R ↥(integralClosure R L) g ∉ 𝔮 → (∀ r : R, ∃ x : P, algebraMap P L x = algebraMap R L r) → (∀ x : P, ∃ (r : R) (n : ℕ), algebraMap P L x * algebraMap R L g ^ n = algebraMap R L r) → (∀ l : L, ∃ (y : R) (G : Polynomial P), algebraMap R L y ≠ 0 ∧ l * algebraMap R L y = Polynomial.aeval w G) → (∃ N : ℕ, IsIntegral R (algebraMap R L g ^ N * w)) → IsUnit ε → (∀ k : ℕ, ∃ π ∈ IsLocalRing.maximalIdeal ↥W, ∃ y : P, (Polynomial.derivative FP - Polynomial.C (ψP (Polynomial.C ε))).coeff k = ψP (Polynomial.C π) * y) → (Polynomial.aeval w (Polynomial.derivative FP) ≠ 0 → Algebra.Etale P (Localization.Away (⟨Polynomial.aeval w (Polynomial.derivative FP), Polynomial.aeval_mem_adjoin_singleton P w⟩ : ↥(Algebra.adjoin P {w})))) → ∃ (T : Type u) (_ : CommRing T) (ψ : Polynomial ↥W →+* T) (j₀ : T →+* L), ψ.Etale ∧ Function.Injective j₀ ∧ (∀ π : ↥W, j₀ (ψ (Polynomial.C π)) = algebraMap R L (wR π)) ∧ (∀ l : L, ∃ x y : T, j₀ y ≠ 0 ∧ l * j₀ y = j₀ x) ∧ (∀ r : R, ∃ x : T, j₀ x = algebraMap R L r) ∧ (∀ x : T, ∃ z s : ↥(integralClosure R L), s ∉ 𝔮 ∧ j₀ x * (s : L) = (z : L)) :=
by
  intro Ω _ W R _ L _ _ 𝔮 _ wR P _ _ ψP g w FP ε het _hinj hW hm hg hRP hfrac hgen hint hε hder het2
  classical
  have hprime : 𝔮.IsPrime := inferInstance
  have h1q : (1 : ↥(integralClosure R L)) ∉ 𝔮 := fun h =>
    hprime.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have hcoe : ∀ r : R, ((algebraMap R ↥(integralClosure R L) r : ↥(integralClosure R L)) : L) =
      algebraMap R L r := fun r => rfl

  let O : Subring L :=
    { carrier := {x | ∃ z s : ↥(integralClosure R L), s ∉ 𝔮 ∧ x * (s : L) = (z : L)}
      mul_mem' := by
        rintro a b ⟨z, s, hs, h⟩ ⟨z', s', hs', h'⟩
        refine ⟨z * z', s * s', hprime.mul_notMem hs hs', ?_⟩
        simp only [MulMemClass.coe_mul]
        linear_combination (b * (s' : L)) * h + (z : L) * h'
      one_mem' := ⟨1, 1, h1q, by simp⟩
      add_mem' := by
        rintro a b ⟨z, s, hs, h⟩ ⟨z', s', hs', h'⟩
        refine ⟨z * s' + z' * s, s * s', hprime.mul_notMem hs hs', ?_⟩
        simp only [MulMemClass.coe_mul, AddMemClass.coe_add]
        linear_combination (s' : L) * h + (s : L) * h'
      zero_mem' := ⟨0, 1, h1q, by simp⟩
      neg_mem' := by
        rintro a ⟨z, s, hs, h⟩
        refine ⟨-z, s, hs, ?_⟩
        simp only [NegMemClass.coe_neg]
        linear_combination -h }
  have hO : ∀ x : L, x ∈ O ↔
      ∃ z s : ↥(integralClosure R L), s ∉ 𝔮 ∧ x * (s : L) = (z : L) := fun x => Iff.rfl

  have hgpow : ∀ n : ℕ, algebraMap R ↥(integralClosure R L) (g ^ n) ∉ 𝔮 := by
    intro n h
    rw [map_pow] at h
    exact hg (hprime.mem_of_pow_mem n h)
  have hPO : ∀ p : P, algebraMap P L p ∈ O := by
    intro p
    obtain ⟨r, n, h⟩ := hfrac p
    refine (hO _).mpr ⟨algebraMap R _ r, algebraMap R _ (g ^ n), hgpow n, ?_⟩
    rw [hcoe, hcoe, map_pow]
    exact h
  have hwO : w ∈ O := by
    obtain ⟨N, hN⟩ := hint
    refine (hO _).mpr ⟨⟨algebraMap R L g ^ N * w, (mem_integralClosure_iff R L).mpr hN⟩,
      algebraMap R _ (g ^ N), hgpow N, ?_⟩
    change w * ((algebraMap R ↥(integralClosure R L) (g ^ N) : ↥(integralClosure R L)) : L) =
      algebraMap R L g ^ N * w
    rw [hcoe, map_pow]
    ring
  have hCO : ∀ x ∈ Algebra.adjoin P {w}, x ∈ O := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx => rw [Set.mem_singleton_iff.mp hx]; exact hwO
    | algebraMap p => exact hPO p
    | add x y _ _ hx hy => exact O.add_mem hx hy
    | mul x y _ _ hx hy => exact O.mul_mem hx hy

  choose π hπ y hy using hder
  have hu_eq : Polynomial.aeval w (Polynomial.derivative FP) = algebraMap R L (wR ε) +
      ∑ k ∈ Finset.range ((Polynomial.derivative FP -
        Polynomial.C (ψP (Polynomial.C ε))).natDegree + 1),
        algebraMap R L (wR (π k)) * (algebraMap P L (y k) * w ^ k) := by
    have e1 : Polynomial.aeval w (Polynomial.derivative FP) =
        Polynomial.aeval w (Polynomial.derivative FP - Polynomial.C (ψP (Polynomial.C ε))) +
          algebraMap P L (ψP (Polynomial.C ε)) := by
      rw [map_sub, Polynomial.aeval_C, sub_add_cancel]
    rw [e1, Polynomial.aeval_eq_sum_range, hW, add_comm]
    congr 1
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [Algebra.smul_def, hy k, map_mul, hW, mul_assoc]

  have hoO : ∀ k, algebraMap P L (y k) * w ^ k ∈ O := fun k =>
    O.mul_mem (hPO _) (O.pow_mem hwO k)
  have hmemq : ∀ k, algebraMap R ↥(integralClosure R L) (wR (π k)) ∈ 𝔮 := fun k =>
    hm _ (hπ k)
  have hcrit : ∀ n : ℕ, ∃ z s : ↥(integralClosure R L), z ∉ 𝔮 ∧ s ∉ 𝔮 ∧
      (algebraMap R L (wR ε) + ∑ k ∈ Finset.range n,
        algebraMap R L (wR (π k)) * (algebraMap P L (y k) * w ^ k)) * (s : L) = (z : L) := by
    intro n
    induction n with
    | zero =>
      refine ⟨algebraMap R _ (wR ε), 1, ?_, h1q, ?_⟩
      · intro h
        exact hprime.ne_top (Ideal.eq_top_of_isUnit_mem _ h ((hε.map wR).map (algebraMap R _)))
      · simp only [Finset.sum_range_zero, add_zero, OneMemClass.coe_one, mul_one, hcoe]
    | succ n ih =>
      obtain ⟨z, s, hz, hs, h⟩ := ih
      obtain ⟨z', s', hs', h'⟩ := (hO _).mp (hoO n)
      refine ⟨z * s' + algebraMap R _ (wR (π n)) * z' * s, s * s', ?_,
        hprime.mul_notMem hs hs', ?_⟩
      · intro hmem
        have h2 : algebraMap R _ (wR (π n)) * z' * s ∈ 𝔮 :=
          𝔮.mul_mem_right _ (𝔮.mul_mem_right _ (hmemq n))
        have h3 : z * s' ∈ 𝔮 := by
          have := 𝔮.sub_mem hmem h2
          rwa [add_sub_cancel_right] at this
        exact hprime.mul_notMem hz hs' h3
      · simp only [Finset.sum_range_succ, MulMemClass.coe_mul, AddMemClass.coe_add, hcoe]
        linear_combination (s' : L) * h + (algebraMap R L (wR (π n)) * (s : L)) * h'
  obtain ⟨zu, su, hzu, hsu, hu⟩ := hcrit ((Polynomial.derivative FP -
    Polynomial.C (ψP (Polynomial.C ε))).natDegree + 1)
  rw [← hu_eq] at hu

  have hzu0 : (zu : L) ≠ 0 := by
    intro h0
    apply hzu
    have : zu = 0 := Subtype.ext h0
    rw [this]
    exact 𝔮.zero_mem
  have hu0 : Polynomial.aeval w (Polynomial.derivative FP) ≠ 0 := by
    intro h0
    apply hzu0
    rw [← hu, h0, zero_mul]
  have huinvO : (Polynomial.aeval w (Polynomial.derivative FP))⁻¹ ∈ O := by
    refine (hO _).mpr ⟨su, zu, hzu, ?_⟩
    rw [← hu, ← mul_assoc, inv_mul_cancel₀ hu0, one_mul]

  let c : ↥(Algebra.adjoin P {w}) := ⟨Polynomial.aeval w (Polynomial.derivative FP),
    Polynomial.aeval_mem_adjoin_singleton P w⟩
  have hPT : Algebra.Etale P (Localization.Away c) := het2 hu0
  have hψ : ((algebraMap P (Localization.Away c)).comp ψP).Etale :=
    RingHom.Etale.stableUnderComposition ψP (algebraMap P (Localization.Away c)) het
      (RingHom.etale_algebraMap.mpr hPT)

  let ι : ↥(Algebra.adjoin P {w}) →+* L := (Algebra.adjoin P {w}).val.toRingHom
  have hιc : IsUnit (ι c) := IsUnit.mk0 (ι c) hu0
  let j₀ : Localization.Away c →+* L := IsLocalization.Away.lift c hιc
  have hj₀C : ∀ x : ↥(Algebra.adjoin P {w}),
      j₀ (algebraMap _ (Localization.Away c) x) = (x : L) := fun x =>
    IsLocalization.Away.lift_eq c hιc x
  have hj₀P : ∀ p : P, j₀ (algebraMap P (Localization.Away c) p) = algebraMap P L p := by
    intro p
    rw [IsScalarTower.algebraMap_apply P ↥(Algebra.adjoin P {w}) (Localization.Away c), hj₀C]
    rfl
  have hj₀inj : Function.Injective j₀ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj c x
    have h1 : ((a : ↥(Algebra.adjoin P {w})) : L) = 0 := by
      rw [← hj₀C a, ← ha, map_mul, hx, zero_mul]
    have h2 : a = 0 := Subtype.ext h1
    rw [h2, map_zero] at ha
    exact ((IsLocalization.Away.algebraMap_isUnit c).pow n).mul_left_eq_zero.mp ha

  refine ⟨Localization.Away c, inferInstance, (algebraMap P (Localization.Away c)).comp ψP, j₀,
    hψ, hj₀inj, ?_, ?_, ?_, ?_⟩
  · intro π'
    rw [RingHom.comp_apply, hj₀P, hW]
  · intro l
    obtain ⟨yR, G, hy0, hl⟩ := hgen l
    obtain ⟨p, hp⟩ := hRP yR
    refine ⟨algebraMap _ (Localization.Away c)
      (⟨Polynomial.aeval w G, Polynomial.aeval_mem_adjoin_singleton P w⟩ :
        ↥(Algebra.adjoin P {w})), algebraMap P (Localization.Away c) p, ?_, ?_⟩
    · rw [hj₀P, hp]
      exact hy0
    · rw [hj₀P, hp, hj₀C]
      exact hl
  · intro r
    obtain ⟨p, hp⟩ := hRP r
    exact ⟨algebraMap P _ p, by rw [hj₀P, hp]⟩
  · intro x
    obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj c x
    have h1 : j₀ x * ((c : ↥(Algebra.adjoin P {w})) : L) ^ n = (a : L) := by
      rw [← hj₀C a, ← ha, map_mul, map_pow, hj₀C]
    have h1' : j₀ x * (Polynomial.aeval w (Polynomial.derivative FP)) ^ n = (a : L) := h1
    have h2 : j₀ x = (a : L) * ((Polynomial.aeval w (Polynomial.derivative FP))⁻¹) ^ n := by
      rw [← h1', inv_pow, mul_assoc, mul_inv_cancel₀ (pow_ne_zero n hu0), mul_one]
    have h3 : j₀ x ∈ O := by
      rw [h2]
      exact O.mul_mem (hCO _ a.2) (O.pow_mem huinvO n)
    exact (hO _).mp h3

theorem wcLlsKPas_model_exists : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ (c b : ↥W) (d : A) (w : L) (F : Polynomial K) (ε : ↥W) (G : Polynomial ↥W) (ω : ↥W),
      c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
      wcLlsKPInnerCore W A K L ℓ 𝔭 t c b d w F ε G ω → IsUnit ε →
      ∀ (e : ↥W) (𝔮 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L))
        [𝔮.IsPrime],
      𝔮.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)) =
        Ideal.span {⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ -
          algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (algebraMap ↥W A e)} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A)) →
      ∃ (T : Type u) (_ : CommRing T) (ψ : Polynomial ↥W →+* T) (Q : Ideal T) (_ : Q.IsPrime)
        (j : Localization.AtPrime Q →+* L)
        (φ : Localization.AtPrime Q →+* Localization.AtPrime 𝔮),
        ψ.Etale ∧ (∀ π ∈ IsLocalRing.maximalIdeal ↥W, ψ (Polynomial.C π) ∈ Q) ∧
        Function.Injective j ∧ IsLocalHom φ ∧
        (∀ π : ↥W, φ (algebraMap T (Localization.AtPrime Q) (ψ (Polynomial.C π))) =
          algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)
            (Localization.AtPrime 𝔮)
            (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
              ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)
              (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (algebraMap ↥W A π)))) ∧
        (∀ l : L, ∃ x y : Localization.AtPrime Q, j y ≠ 0 ∧ l * j y = j x) ∧
        (∀ r : ↥(Algebra.adjoin A {wcLlsScS W A K t c b}), ∃ x : Localization.AtPrime Q,
          j x = algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L r) ∧
        (∀ x : Localization.AtPrime Q, ∃ z s :
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L), s ∉ 𝔮 ∧
          φ x * algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)
              (Localization.AtPrime 𝔮) s =
            algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)
              (Localization.AtPrime 𝔮) z ∧
          j x * (s : L) = (z : L)) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD hdeg c b d w F ε G ω
    hc hb hb0 hI hε e 𝔮 _ h𝔮

  obtain ⟨hA, hm⟩ := wcLlsKPas_prime_contract Ω W A K L 𝔭 t hPD c b e hc hb hb0 𝔮 h𝔮
  have hPD' := hPD
  obtain ⟨-, -, -, hmax, -⟩ := hPD'
  have hI' := hI
  obtain ⟨hd𝔭, -, hwK, hFmon, hFdeg, hFw, hFloc, -, hFmid, hF1, -⟩ := hI'

  obtain ⟨h, hh𝔭, ψ₀, hψ₀C, -, hψ₀et⟩ := wcLlsKPas_chart_etale Ω W A K 𝔭 t hPD c b hc hb hb0

  have hinjRK : Function.Injective
      (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) K) := Subtype.val_injective
  have hRK : ∀ a : A, algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) K
      (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) a) = algebraMap A K a :=
    fun a => rfl
  have hRL : ∀ r : ↥(Algebra.adjoin A {wcLlsScS W A K t c b}),
      algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L r =
        algebraMap K L (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) K r) :=
    fun r => rfl
  have hRne : ∀ a : A, a ∉ 𝔭 → algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) a ≠ 0 := by
    intro a ha h0
    apply ha
    have h1 : algebraMap A K a = 0 := by rw [← hRK, h0, map_zero]
    have h2 := (map_eq_zero_iff (algebraMap A K) (IsFractionRing.injective A K)).mp h1
    rw [h2]
    exact 𝔭.zero_mem

  obtain ⟨P, iP1, iP2, iP3, iP4, iP5, ψP, ι, hψPet, hψPeq, hPinj, hPR, hPfrac, hPloc⟩ :=
    wcLlsKPas_chart_localize Ω W ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) K L
      (algebraMap A _ h) (algebraMap A _ d) hinjRK (hRne h hh𝔭) (hRne d hd𝔭) ψ₀ hψ₀et

  have hψPK : ∀ π : ↥W, algebraMap P K (ψP (Polynomial.C π)) =
      algebraMap A K (algebraMap ↥W A π) := by
    intro π
    have e1 : ψ₀ (Polynomial.C π) =
        algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
          (Localization.Away (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) h))
          (algebraMap A _ (algebraMap ↥W A π)) := RingHom.congr_fun hψ₀C π
    rw [hψPeq, RingHom.comp_apply, e1, hPR, hRK]
  have hψPL : ∀ π : ↥W, algebraMap P L (ψP (Polynomial.C π)) =
      algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L
        (((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A)) π) := by
    intro π
    rw [IsScalarTower.algebraMap_apply P K L, hψPK, hRL, RingHom.comp_apply, hRK]

  have hloc : ∀ x : K, wcLlsKPLoc A K (wcLlsScS W A K t c b) d x →
      x ∈ Set.range (algebraMap P K) := by
    rintro x ⟨n, hn⟩
    apply hPloc x n
    rw [hRK]
    exact ⟨⟨_, hn⟩, rfl⟩
  have hmloc : ∀ x : K, wcLlsKPMLoc W A K (wcLlsScS W A K t c b) d x →
      ∃ π ∈ IsLocalRing.maximalIdeal ↥W, ∃ y : P, x = algebraMap P K (ψP (Polynomial.C π) * y) := by
    rintro x ⟨π, hπ, x', hx', rfl⟩
    obtain ⟨y, hy⟩ := hloc x' hx'
    exact ⟨π, hπ, y, by rw [map_mul, hψPK, hy]⟩

  have hℓm : ((ℓ : ℕ) : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [← IsLocalRing.residue_eq_zero_iff, map_natCast]
    have h1 := ringChar.spec (IsLocalRing.ResidueField ↥W) ℓ
    rw [hκ] at h1
    exact h1.mpr dvd_rfl

  obtain ⟨FP, hFPmap, hFPmon, hFPdeg, hFPder⟩ :=
    wcLlsKPas_poly_lift Ω W P K ψP ℓ ε F hPinj hℓ.two_le hℓm hFmon hFdeg
      (fun i => hloc _ (hFloc i)) (fun i hi1 hi2 => hmloc _ (hFmid i hi1 hi2))
      (by rw [hψPK ε]; exact hmloc _ hF1)

  have hFPw : Polynomial.aeval w FP = 0 := by
    rw [← Polynomial.aeval_map_algebraMap K w FP, hFPmap, hFw]

  obtain ⟨-, hdvd, hgen⟩ :=
    wcLlsKPas_minpoly_dvd K L P hPinj ℓ hℓ hdeg w FP hwK hFPmon hFPdeg hFPw

  have hRP : ∀ r : ↥(Algebra.adjoin A {wcLlsScS W A K t c b}), ∃ x : P,
      algebraMap P L x = algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L r := by
    intro r
    refine ⟨ι (algebraMap _ _ r), ?_⟩
    rw [IsScalarTower.algebraMap_apply P K L, hPR, hRL]
  have hgenR := wcLlsKPas_generation A K L ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) P
    (algebraMap A _) w (fun a => by rw [hRL, hRK]) hRP hgen

  have hfracL : ∀ x : P, ∃ (r : ↥(Algebra.adjoin A {wcLlsScS W A K t c b})) (n : ℕ),
      algebraMap P L x * algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L
        (algebraMap A _ h * algebraMap A _ d) ^ n =
      algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L r := by
    intro x
    obtain ⟨r, n, hr⟩ := hPfrac x
    refine ⟨r, n, ?_⟩
    rw [IsScalarTower.algebraMap_apply P K L, hRL, hRL, ← hr]
    simp only [map_mul, map_pow]
  have hint := wcLlsKPas_scaled_integral ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) P L
    (algebraMap A _ h * algebraMap A _ d) w FP hFPmon hFPw hfracL

  have hg𝔮 : algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)
      (algebraMap A _ h * algebraMap A _ d) ∉ 𝔮 := by
    rw [← map_mul]
    exact hA _ (hmax.isPrime.mul_notMem hh𝔭 hd𝔭)
  have hPLinj : Function.Injective (algebraMap P L) := by
    rw [IsScalarTower.algebraMap_eq P K L]
    exact (algebraMap K L).injective.comp hPinj

  obtain ⟨T, iT, ψ, j₀, hψet, hj₀inj, hj₀W, hj₀gen, hj₀R, hj₀B⟩ :=
    wcLlsKPas_model_ring Ω W ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L 𝔮
      ((algebraMap A _).comp (algebraMap ↥W A)) P ψP (algebraMap A _ h * algebraMap A _ d)
      w FP ε hψPet hPLinj hψPL hm hg𝔮 hRP hfracL hgenR hint hε hFPder
      (fun hu => wcLlsKPas_root_etale P L w FP hFPmon hFPw hdvd hu)

  obtain ⟨Q, hQ, j, φ, hQm, hj, hφ, hφW, hjgen, hjR, hjB⟩ :=
    wcLlsKPas_model_localize Ω W ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L 𝔮
      ((algebraMap A _).comp (algebraMap ↥W A)) T ψ j₀ hj₀inj hm hj₀W hj₀gen hj₀R hj₀B
  exact ⟨T, iT, ψ, Q, hQ, j, φ, hψet, hQm, hj, hφ, hφW, hjgen, hjR, hjB⟩

theorem wcLlsKP_idatum_as_smooth : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ (c b : ↥W) (d : A) (w : L) (F : Polynomial K) (ε : ↥W) (G : Polynomial ↥W) (ω : ↥W),
      c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
      wcLlsKPInnerCore W A K L ℓ 𝔭 t c b d w F ε G ω → IsUnit ε →
      ∀ e : ↥W, wcLlsInnerSmooth W A K L t c b e :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD hdeg c b d w F ε G ω
    hc hb hb0 hI hε e
  intro 𝔮 _ h𝔮

  have s11 : ∀ (B : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B],
      wcpaDjLkDelta B = 0 := by
    intro B _ _ _
    unfold wcpaDjLkDelta
    rw [Module.length_eq_zero_iff]
    have htop : LinearMap.range
        (Algebra.linearMap B ↥(integralClosure B (FractionRing B))) = ⊤ := by
      rw [eq_top_iff]
      rintro ⟨x, hx⟩ -
      obtain ⟨b, hb⟩ := IsIntegrallyClosed.isIntegral_iff.mp (show IsIntegral B x from hx)
      exact LinearMap.mem_range.mpr ⟨b, Subtype.ext hb⟩
    constructor
    intro a b
    induction a using Submodule.Quotient.induction_on with
    | _ a =>
    induction b using Submodule.Quotient.induction_on with
    | _ b =>
    rw [Submodule.Quotient.eq, htop]
    exact Submodule.mem_top

  obtain ⟨T, _, ψ, Q, _, j, φ, hψ, hψQ, hj, hφ, hWc, hfrac, hR, hzs⟩ :=
    wcLlsKPas_model_exists Ω W hW hWt ℓ hℓ hΩ hκ A K L 𝔭 t hPD hdeg c b d w F ε G ω
      hc hb hb0 hI hε e 𝔮 h𝔮

  obtain ⟨hD, hDn, hFd, hFn⟩ := wcLlsKPas_etale_fibre_normal Ω W T ψ hψ Q hψQ
  haveI := hD
  haveI := hDn

  have hbij := wcLlsKPas_local_model_bijective ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L 𝔮
    (Localization.AtPrime Q) j φ hj hφ hfrac hR hzs
  let Φ : Localization.AtPrime Q ≃+* Localization.AtPrime 𝔮 := RingEquiv.ofBijective φ hbij

  have hcomp : (Φ : Localization.AtPrime Q →+* Localization.AtPrime 𝔮).comp
      ((algebraMap T (Localization.AtPrime Q)).comp (ψ.comp Polynomial.C)) =
      (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)
          (Localization.AtPrime 𝔮)).comp
        ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp
            (algebraMap ↥W A))) := by
    ext π
    exact hWc π
  have hset : {z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (z : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} =
      ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp
            (algebraMap ↥W A))) '' (IsLocalRing.maximalIdeal ↥W : Set ↥W) := by
    ext z
    constructor
    · rintro ⟨π, hπ, hz⟩
      exact ⟨π, hπ, Subtype.ext hz.symm⟩
    · rintro ⟨π, hπ, rfl⟩
      exact ⟨π, hπ, rfl⟩
  have hIeq : (Ideal.span {z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (z : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}).map
        (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)
          (Localization.AtPrime 𝔮)) =
      ((IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap T (Localization.AtPrime Q)).comp (ψ.comp Polynomial.C))).map
        (Φ : Localization.AtPrime Q →+* Localization.AtPrime 𝔮) := by
    rw [Ideal.map_map, hcomp, ← Ideal.map_map, hset]
    rfl
  have hIeq' := hIeq
  let E := Ideal.quotientEquiv
    ((IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap T (Localization.AtPrime Q)).comp (ψ.comp Polynomial.C)))
    ((Ideal.span {z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (z : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}).map
        (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)
          (Localization.AtPrime 𝔮))) Φ hIeq'
  haveI := hFd
  haveI := hFn
  haveI : IsDomain (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) 𝔮) :=
    MulEquiv.isDomain _ E.symm.toMulEquiv
  haveI : IsIntegrallyClosed (wcLlsFS W
      ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) 𝔮) :=
    IsIntegrallyClosed.of_equiv E
  exact s11 _

theorem wcLlsKPms_chart_fibre : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    (∀ r : ↥(Algebra.adjoin A {wcLlsScS W A K t c b}), ∃ f : Polynomial ↥W,
      r - Polynomial.eval₂ ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp
          (algebraMap ↥W A))
        ⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ f ∈
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A))) ∧
    (∀ (a : A) (n : ℕ) (f : Polynomial ↥W), a ∉ 𝔭 →
      algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) a ^ n *
        Polynomial.eval₂ ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp
            (algebraMap ↥W A))
          ⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ f ∈
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A)) →
      ∀ i, f.coeff i ∈ IsLocalRing.maximalIdeal ↥W) ∧
    ∀ e : ↥W,
      (Ideal.span {⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ -
          algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (algebraMap ↥W A e)} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A))).IsMaximal ∧
      (Ideal.span {⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ -
          algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (algebraMap ↥W A e)} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A))).comap
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})) = 𝔭 :=
by
  intro Ω _ _ W A _ _ _ K _ _ _ 𝔭 t hPD c b hc hb hb0
  classical
  unfold wcLlsPD at hPD
  simp only at hPD
  obtain ⟨hFT, hNZ, -, h𝔭max, hmA, ht𝔭, h𝔭eq, h, hh, f, hfC, hfX, hfet⟩ := hPD
  haveI := hNZ
  haveI := h𝔭max
  letI : Field (A ⧸ 𝔭) := Ideal.Quotient.field 𝔭



  have transfer : ∀ (P S : Type u) [CommRing P] [CommRing S] [Algebra P S] [Module.Flat P S]
      (p r : P), (∀ y : P, r * y ∈ Ideal.span {p} → y ∈ Ideal.span {p}) →
      ∀ x : S, algebraMap P S r * x ∈ Ideal.span {algebraMap P S p} →
        x ∈ Ideal.span {algebraMap P S p} := by
    intro P S _ _ _ _ p r hreg x hx
    obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp hx
    let f : Fin 2 → P := ![r, p]
    let v : Fin 2 → S := ![x, -y]
    have hrel : ∑ i, f i • v i = 0 := by
      rw [Fin.sum_univ_two]
      show r • x + p • (-y) = 0
      rw [Algebra.smul_def, Algebra.smul_def, ← hy]; ring
    obtain ⟨k, A, z, hx', hA⟩ :=
      Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (R := P) (M := S) hrel
    have hx0 : x = ∑ j, A 0 j • z j := hx' 0
    have hdiv : ∀ j, A 0 j ∈ Ideal.span {p} := by
      intro j
      apply hreg
      have h3 : ∑ i, f i * A i j = 0 := hA j
      rw [Fin.sum_univ_two] at h3
      change r * A 0 j + p * A 1 j = 0 at h3
      rw [Ideal.mem_span_singleton']
      exact ⟨-A 1 j, by linear_combination -h3⟩
    choose s hs using fun j => Ideal.mem_span_singleton'.mp (hdiv j)
    rw [hx0, Ideal.mem_span_singleton']
    refine ⟨∑ j, algebraMap P S (s j) * z j, ?_⟩
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Algebra.smul_def, ← hs j, map_mul]
    ring
  have rees : ∀ (B : Type u) [CommRing B] [IsDomain B] (K : Type u)
      [Field K] [Algebra B K], Function.Injective (algebraMap B K) → ∀ (h a : B), h ≠ 0 →
      (∀ x : B, a * x ∈ Ideal.span {h} → x ∈ Ideal.span {h}) →
      RingHom.ker (Polynomial.aeval (R := B) (algebraMap B K a / algebraMap B K h)) =
        Ideal.span {Polynomial.C h * Polynomial.X - Polynomial.C a} := by
    intro B _ _ K _ _ hinj h a hh hreg
    have hιh : algebraMap B K h ≠ 0 := by
      intro h0
      apply hh
      apply hinj
      rw [h0, map_zero]
    have hhr : algebraMap B K h * (algebraMap B K a / algebraMap B K h) = algebraMap B K a :=
      mul_div_cancel₀ _ hιh
    have s1 : Ideal.span {Polynomial.C h * Polynomial.X - Polynomial.C a} ≤
        RingHom.ker (Polynomial.aeval (R := B) (algebraMap B K a / algebraMap B K h)) := by
      rw [Ideal.span_le, Set.singleton_subset_iff]
      show _ ∈ RingHom.ker _
      rw [RingHom.mem_ker, map_sub, map_mul, Polynomial.aeval_C, Polynomial.aeval_C,
        Polynomial.aeval_X, hhr, sub_self]
    have s2 : ∀ P : Polynomial B,
        Polynomial.aeval (algebraMap B K a / algebraMap B K h) P = 0 →
        h ∣ P.leadingCoeff * a ^ P.natDegree := by
      intro P hP
      have hev : Polynomial.eval a (P.scaleRoots h) = 0 := by
        apply hinj
        rw [map_zero, ← Polynomial.eval₂_at_apply, ← hhr, Polynomial.scaleRoots_eval₂_mul,
          ← Polynomial.aeval_def, hP, mul_zero]
      rw [Polynomial.eval_eq_sum_range, Polynomial.natDegree_scaleRoots, Finset.sum_range_succ]
        at hev
      simp only [Polynomial.coeff_scaleRoots, Nat.sub_self, pow_zero, mul_one] at hev
      have hS : h ∣ ∑ i ∈ Finset.range P.natDegree,
          P.coeff i * h ^ (P.natDegree - i) * a ^ i := by
        apply Finset.dvd_sum
        intro i hi
        have hi' := Finset.mem_range.mp hi
        apply Dvd.dvd.mul_right
        apply Dvd.dvd.mul_left
        exact dvd_pow_self h (by omega)
      have hlc : P.leadingCoeff * a ^ P.natDegree = -(∑ i ∈ Finset.range P.natDegree,
          P.coeff i * h ^ (P.natDegree - i) * a ^ i) := by
        rw [Polynomial.leadingCoeff]
        linear_combination hev
      rw [hlc]
      exact dvd_neg.mpr hS
    have s3 : ∀ (m : ℕ) (x : B), a ^ m * x ∈ Ideal.span {h} → x ∈ Ideal.span {h} := by
      intro m
      induction m with
      | zero => intro x hx; simpa using hx
      | succ m ih =>
        intro x hx
        apply ih
        apply hreg
        rw [← mul_assoc, ← pow_succ']
        exact hx
    have s4 : ∀ (P : Polynomial B) (q : B), 1 ≤ P.natDegree → P.leadingCoeff = h * q →
        (P - Polynomial.C q * Polynomial.X ^ (P.natDegree - 1) *
          (Polynomial.C h * Polynomial.X - Polynomial.C a)).natDegree < P.natDegree := by
      intro P q hn hq
      have hXn : (Polynomial.X : Polynomial B) ^ P.natDegree =
          Polynomial.X ^ (P.natDegree - 1) * Polynomial.X := by
        rw [← pow_succ]
        congr 1
        omega
      have hD : Polynomial.C q * Polynomial.X ^ (P.natDegree - 1) *
          (Polynomial.C h * Polynomial.X - Polynomial.C a) =
          Polynomial.C (q * h) * Polynomial.X ^ P.natDegree -
            Polynomial.C (q * a) * Polynomial.X ^ (P.natDegree - 1) := by
        rw [hXn, Polynomial.C_mul, Polynomial.C_mul]
        ring
      have hle : (P - Polynomial.C q * Polynomial.X ^ (P.natDegree - 1) *
          (Polynomial.C h * Polynomial.X - Polynomial.C a)).natDegree ≤ P.natDegree - 1 := by
        rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
        intro N hN
        rw [hD, Polynomial.coeff_sub, Polynomial.coeff_sub, Polynomial.coeff_C_mul_X_pow,
          Polynomial.coeff_C_mul_X_pow]
        have hN1 : N ≠ P.natDegree - 1 := by
          have : P.natDegree - 1 < N := by exact_mod_cast hN
          omega
        rw [if_neg hN1]
        by_cases hNn : N = P.natDegree
        · rw [if_pos hNn, hNn, Polynomial.coeff_natDegree, hq]
          ring
        · have : P.natDegree - 1 < N := by exact_mod_cast hN
          rw [if_neg hNn, Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)]
          ring
      omega
    have s5 : ∀ n : ℕ, ∀ P : Polynomial B, P.natDegree = n →
        Polynomial.aeval (algebraMap B K a / algebraMap B K h) P = 0 →
        P ∈ Ideal.span {Polynomial.C h * Polynomial.X - Polynomial.C a} := by
      intro n
      induction n using Nat.strong_induction_on with
      | _ n ih =>
        intro P hPn hP
        rcases Nat.eq_zero_or_pos n with h0 | hpos
        · have hPC := Polynomial.eq_C_of_natDegree_eq_zero (hPn.trans h0)
          rw [hPC, Polynomial.aeval_C] at hP
          have hc : P.coeff 0 = 0 := hinj (by rw [hP, map_zero])
          rw [hPC, hc, map_zero]
          exact Ideal.zero_mem _
        · subst hPn
          have hd := s2 P hP
          have hmem : a ^ P.natDegree * P.leadingCoeff ∈ Ideal.span {h} := by
            rw [Ideal.mem_span_singleton, mul_comm]
            exact hd
          obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp (s3 _ _ hmem)
