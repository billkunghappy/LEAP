theorem wcpa_dj_llsm_scrs_modelA_delta : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L]
    (𝔭 : Ideal A) (k : wcLlsKind W A), wcLlsPD W A 𝔭 k →
    ∀ (s : K) (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) [Q.IsPrime],
    (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) ≤
      Q.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) →
    (∃ (P₂ : Type u) (_ : CommRing P₂) (e₂ : Localization.AtPrime Q →+* P₂),
      wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) P₂ e₂ ∧
      wcNdModelA W P₂ (e₂.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
        (Localization.AtPrime Q)).comp ((algebraMap ↥(Algebra.adjoin A {s})
        ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)))))) →
    wcpaDjLkDelta (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥(Algebra.adjoin A {s}) Q) = 0 :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ 𝔭 k hPD s Q _ hH1 hH2
  classical

  have hcoe : ∀ w : ↥W,
      ((((algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) w :
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) : L) =
        ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w := fun w => rfl

  have hspan : Ideal.span {b : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} =
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro b ⟨w, hw, hb⟩
      have hb' : b = ((algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) w :=
        Subtype.ext (hb.trans (hcoe w).symm)
      rw [hb']
      exact Ideal.mem_map_of_mem _ hw
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      exact Ideal.subset_span ⟨w, hw, hcoe w⟩
  obtain ⟨J, hJdef⟩ : ∃ J : Ideal (Localization.AtPrime Q), J =
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Q)).comp
          ((algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)))) := ⟨_, rfl⟩
  obtain ⟨I, hIdef⟩ : ∃ I : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L), I =
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) := ⟨_, rfl⟩
  have hJI : J = I.map (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
