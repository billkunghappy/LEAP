  have hNM : Nb ≤ N₃.comap j := by
    rw [hNb]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      intro x hx
      rcases hx with rfl | hx
      · show j (algebraMap A ↥(Algebra.adjoin A {s}) u) ∈ N₃
