        have hc0 : c = 0 := Subtype.ext hc
        rw [hc0]
        exact zero_mem _
      obtain ⟨π, hπ, hπn⟩ := hroot w hw n hn
      have hπ0 : ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) π ≠ 0 := by
        intro h
        apply hw0
        have : π = 0 := hwLinj (h.trans (map_zero _).symm)
        rw [← hπn, this, zero_pow hn.ne']
      have hwL0 : ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w ≠ 0 := by
        intro h
        exact hw0 (hwLinj (h.trans (map_zero _).symm))
      have hξn : ((c : L) / ((algebraMap K L).comp ((algebraMap A K).comp
          (algebraMap ↥W A))) π) ^ n = (d : L) := by
        rw [div_pow, hd, ← map_pow, hπn]
        exact mul_div_cancel_left₀ _ hwL0
      have hξint : _root_.IsIntegral ↥(wcLlsASbS W A K u b)
          ((c : L) / ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) π) := by
        apply _root_.IsIntegral.of_pow hn
        rw [hξn]
        exact d.2
      have hg : (⟨_, hint π⟩ : ↥(integralClosure ↥(wcLlsASbS W A K u b) L)) ∈
          Ideal.span {c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L) |
            ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
              (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} :=
        Ideal.subset_span ⟨π, hπ, rfl⟩
      have hceq : c = (⟨_, hint π⟩ : ↥(integralClosure ↥(wcLlsASbS W A K u b) L)) *
          ⟨_, hξint⟩ := by
        apply Subtype.ext
        rw [MulMemClass.coe_mul]
        show (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) π *
          ((c : L) / ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) π)
        field_simp
      rw [hceq]
      exact Ideal.mul_mem_right _ _ hg
    exact hrad

  obtain ⟨Qo, 𝔷o, QI, 𝔷I, hQo, h𝔷o, hQI, h𝔷I, hQoy, hQIy, hQoN, hQIN, h𝔷oQ, h𝔷IQ, h𝔷om,
