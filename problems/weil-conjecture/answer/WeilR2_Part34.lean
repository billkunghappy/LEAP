          ∑ i : Fin ℓ, Φ (AdjoinRoot.of P (d i)) * Φ (AdjoinRoot.root P) ^ (i : ℕ) = 0 := by
        rw [hd, mul_zero]
      rw [Finset.mul_sum] at h2
      rw [← h2]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hρ, hρ, ← hΦr, ← hΦo, hda i, map_mul, map_mul, mul_assoc]
    have hX0 : ρ (∑ i : Fin ℓ, algebraMap A ↥(integralClosure A L) (a i) * θ ^ (i : ℕ)) = 0 := by
      rw [map_sum]
      simpa only [map_mul, map_pow] using hsum
    obtain ⟨s, e, c, hs, hc, hsX⟩ := hker _ hX0
