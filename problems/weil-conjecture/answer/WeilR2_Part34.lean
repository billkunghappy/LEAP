  have hf'O : f' ∈ O := (hOmem f').mpr ⟨a, s, hNBu s hs, hf⟩
  have hf'inv : f'⁻¹ ∈ O := (hOmem f'⁻¹).mpr ⟨s, a, hNBu a ha, by
    rw [← hf, ← mul_assoc, inv_mul_cancel₀ hf'0, one_mul]⟩

  obtain ⟨h, hh, hdisj⟩ := wcpa_dj_llsm_kpwulb_kummer_max K O ℓ hℓ hℓK0 _ hc₀O hc₀pow
