        show j ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ ∈ N₃
        have e : j ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ =
            ⟨s₃, Algebra.subset_adjoin (Set.mem_singleton s₃)⟩ := Subtype.ext hss.symm
        rw [e, hN₃]
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    · rw [Ideal.map_le_iff_le_comap]
      intro t ht
      show j (algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A t)) ∈ N₃
      have e : j (algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A t)) =
          ((algebraMap A₃ ↥(Algebra.adjoin A₃ {s₃})).comp (algebraMap ↥W A₃)) t := by
        apply Subtype.ext
        show algebraMap A K (algebraMap ↥W A t) = algebraMap A₃ K (algebraMap ↥W A₃ t)
        rw [hBr1]
      rw [e, hN₃]
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ ht)

  have h𝔭N : 𝔭 ≤ Nb.comap (algebraMap A ↥(Algebra.adjoin A {s})) := by
    rw [h𝔭eq]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      intro x hx
      rcases hx with rfl | hx
      · show algebraMap A ↥(Algebra.adjoin A {s}) x ∈ Nb
        rw [hNb]
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
      · rw [Set.mem_singleton_iff.mp hx]
        show algebraMap A ↥(Algebra.adjoin A {s}) v ∈ Nb
        have e : algebraMap A ↥(Algebra.adjoin A {s}) v =
            algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A k) *
