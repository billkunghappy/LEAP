      rw [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_X, Polynomial.eval_C, hG0]
    rw [hval]
    exact mul_ne_zero (pow_ne_zero _ hτ0) hz.ne_zero
  have hPrime : 𝔭.IsPrime := hPD.2.2.2.1.isPrime
  haveI := hPrime
  have hm𝔭 : Ideal.map (algebraMap ↥W A) (IsLocalRing.maximalIdeal ↥W) ≤ 𝔭 := hPD.2.2.2.2.1
  obtain ⟨_, h𝔭eq, h, hh, f₀, hC, hX, hEt⟩ := hPD.2.2.2.2.2
  obtain ⟨hDdom, hDVR, hirr⟩ := SDVR Ω W A 𝔭 t h f₀ hm𝔭 hh (by rw [← h𝔭eq]) hC hX hEt
  set I : Ideal (Localization.AtPrime 𝔭) := ((IsLocalRing.maximalIdeal ↥W).map
    (algebraMap ↥W A)).map (algebraMap A (Localization.AtPrime 𝔭)) with hI
  haveI := hDdom
  haveI := hDVR
  have hτ0 : Ideal.Quotient.mk I (algebraMap A (Localization.AtPrime 𝔭) t) ≠ 0 := hirr.ne_zero
  have hτu : ¬ IsUnit (Ideal.Quotient.mk I (algebraMap A (Localization.AtPrime 𝔭) t)) :=
    hirr.not_isUnit
  have hmA : ∀ x ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A),
      Ideal.Quotient.mk I (algebraMap A (Localization.AtPrime 𝔭) x) = 0 := by
    intro x hx
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_map_of_mem _ hx

  obtain ⟨π, y', hπ, hOk, heq⟩ := hOM
  obtain ⟨d, b, s, hd, hLb, hLs, hns, hys⟩ := hOk
  obtain ⟨n₁, ab, hab⟩ := (T0 d b).mp hLb
  obtain ⟨n₂, as, has⟩ := (T0 d s).mp hLs
  have hP : algebraMap A K (f.eval₂ (algebraMap ↥W A) t) =
      f.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K t) :=
    Polynomial.hom_eval₂ _ _ _ _
  have hEq : f.eval₂ (algebraMap ↥W A) t * as * d ^ n₁ = algebraMap ↥W A π * ab * d ^ n₂ := by
    apply IsFractionRing.injective A K
    simp only [map_mul, map_pow]
    rw [hP, has, hab, heq]
    linear_combination (algebraMap A K (algebraMap ↥W A π) * algebraMap A K d ^ n₁ *
      algebraMap A K d ^ n₂) * hys
  have hπmA : algebraMap ↥W A π ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) :=
    Ideal.mem_map_of_mem _ hπ
  have h0 : Ideal.Quotient.mk I (algebraMap A (Localization.AtPrime 𝔭) (f.eval₂ (algebraMap ↥W A) t)) *
      Ideal.Quotient.mk I (algebraMap A (Localization.AtPrime 𝔭) as) *
      Ideal.Quotient.mk I (algebraMap A (Localization.AtPrime 𝔭) d) ^ n₁ = 0 := by
    have := hmA _ (Ideal.mul_mem_right (d ^ n₂) _ (Ideal.mul_mem_right ab _ hπmA))
    rw [← hEq] at this
    simpa only [map_mul, map_pow] using this
  have hd' : d ∉ 𝔭 := hd
  rcases mul_eq_zero.mp h0 with h1 | h1
  · rcases mul_eq_zero.mp h1 with h2 | h2
    ·
      have hev : f.eval₂ (((Ideal.Quotient.mk I).comp (algebraMap A (Localization.AtPrime 𝔭))).comp
          (algebraMap ↥W A)) (Ideal.Quotient.mk I (algebraMap A (Localization.AtPrime 𝔭) t)) = 0 :=
        (Polynomial.hom_eval₂ f (algebraMap ↥W A)
          ((Ideal.Quotient.mk I).comp (algebraMap A (Localization.AtPrime 𝔭))) t).symm.trans h2
      exact NV _ _ (fun r hr => hmA _ (Ideal.mem_map_of_mem _ hr)) _ hτ0 hτu hev
    ·
      rw [Ideal.Quotient.eq_zero_iff_mem] at h2
      obtain ⟨e, he, hea⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff 𝔭.primeCompl
        (Localization.AtPrime 𝔭) _ as).mp h2
      have he' : e ∉ 𝔭 := he
      obtain ⟨π', hπ', a', hea'⟩ := mAform _ hea
      have hd0 : algebraMap A K d ≠ 0 := by
        intro h0'
        apply hd'
        rw [(IsFractionRing.injective A K) (h0'.trans (map_zero _).symm)]
        exact 𝔭.zero_mem
      have he0 : algebraMap A K e ≠ 0 := by
        intro h0'
        apply he'
        rw [(IsFractionRing.injective A K) (h0'.trans (map_zero _).symm)]
        exact 𝔭.zero_mem
      have hXne : algebraMap A K e * algebraMap A K d ^ n₂ ≠ 0 := mul_ne_zero he0 (pow_ne_zero _ hd0)
      have hk := congrArg (algebraMap A K) hea'
      simp only [map_mul] at hk
      rw [has] at hk
      apply hns (e * d) (fun hm => (hPrime.mem_or_mem hm).elim he' hd')
      refine ⟨π', hπ', algebraMap A K a' / (algebraMap A K e * algebraMap A K d ^ n₂),
        (T0 _ _).mpr ⟨n₂ + 1, e ^ n₂ * d * a', ?_⟩, ?_⟩
      · rw [eq_comm, mul_div_assoc', div_eq_iff hXne]
        simp only [map_mul, map_pow]
        ring
      · rw [← mul_div_assoc, eq_div_iff hXne, ← hk]
        ring
  ·
    have hu : IsUnit (algebraMap A (Localization.AtPrime 𝔭) d) :=
      (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime 𝔭) 𝔭 d).mpr hd'
    exact ((hu.map (Ideal.Quotient.mk I)).pow n₁).ne_zero h1

theorem wcLlsKPlb_residue_sep : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (O : ValuationSubring K), (∀ y : K, y ∈ O ↔ wcLlsKPOk W A K 𝔭 y) →
    (∀ y : K, wcLlsKPOM W A K 𝔭 y ↔ O.valuation y < 1) →
    ∀ (ψ : IsLocalRing.ResidueField ↥W →+* IsLocalRing.ResidueField ↥O)
      (xb : IsLocalRing.ResidueField ↥O),
    (∀ (w : ↥W) (z : ↥O), (z : K) = algebraMap A K (algebraMap ↥W A w) →
      ψ (IsLocalRing.residue ↥W w) = IsLocalRing.residue ↥O z) →
    (∀ z : ↥O, (z : K) = algebraMap A K t → xb = IsLocalRing.residue ↥O z) →
    (∀ p : Polynomial (IsLocalRing.ResidueField ↥W), p ≠ 0 → p.eval₂ ψ xb ≠ 0) →
    letI := ψ.toAlgebra
    FiniteDimensional ↥(IntermediateField.adjoin (IsLocalRing.ResidueField ↥W) {xb})
        (IsLocalRing.ResidueField ↥O) ∧
      Algebra.IsSeparable ↥(IntermediateField.adjoin (IsLocalRing.ResidueField ↥W) {xb})
        (IsLocalRing.ResidueField ↥O) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 t hPD O hO hOM ψ xb hψ hx _htr
  classical
  obtain ⟨-, -, -, h𝔭max, hm𝔭, -, -, h, hh, f₀, hC, hX, hEt⟩ := id hPD
  have hprime : 𝔭.IsPrime := h𝔭max.isPrime
  have h1 : (1 : A) ∉ 𝔭 := fun h' => hprime.ne_top ((Ideal.eq_top_iff_one _).mpr h')

  have hT0 : ∀ x : K, x ∈ Algebra.adjoin A {(0 : K)} → ∃ a : A, algebraMap A K a = x := by
    intro x hx
    have hle : Algebra.adjoin A {(0 : K)} ≤ ⊥ :=
      Algebra.adjoin_le (Set.singleton_subset_iff.mpr (Subalgebra.zero_mem _))
    obtain ⟨a, ha⟩ := Algebra.mem_bot.mp (hle hx)
    exact ⟨a, ha⟩
  have hLmono : ∀ (d e : A) (x : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 (d * e) x := by
    rintro d e x ⟨n, hn⟩
    unfold wcLlsKPLoc
    refine ⟨n, ?_⟩
    have e1 : algebraMap A K (d * e) ^ n * x = algebraMap A K (e ^ n) * (algebraMap A K d ^ n * x) := by
      rw [map_mul, map_pow, mul_pow]; ring
    rw [e1]
    exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) hn
  have Loc1 : ∀ a : A, wcLlsKPLoc A K 0 1 (algebraMap A K a) := by
    intro a
    unfold wcLlsKPLoc
    exact ⟨0, by rw [pow_zero, one_mul]; exact Subalgebra.algebraMap_mem _ a⟩
  have LocD1 : ∀ d : A, wcLlsKPLoc A K 0 d 1 := by
    intro d
    unfold wcLlsKPLoc
    exact ⟨0, by rw [pow_zero, one_mul]; exact Subalgebra.one_mem _⟩

  have hNM : ∀ a : A, a ∉ 𝔭 → ∀ d'' : A, d'' ∉ 𝔭 →
      ¬ wcLlsKPMLoc W A K 0 d'' (algebraMap A K a) := by
    rintro a ha d'' hd'' ⟨π, hπ, x', ⟨n, hn⟩, hax⟩
    obtain ⟨c, hc⟩ := hT0 _ hn
    have e1 : algebraMap A K (a * d'' ^ n) = algebraMap A K (algebraMap ↥W A π * c) := by
      rw [map_mul, map_mul, map_pow, hc, hax]; ring
    have e2 := IsFractionRing.injective A K e1
    have hmem : algebraMap ↥W A π * c ∈ 𝔭 := 𝔭.mul_mem_right c (hm𝔭 (Ideal.mem_map_of_mem _ hπ))
    rw [← e2] at hmem
    rcases hprime.mem_or_mem hmem with h' | h'
    · exact ha h'
    · exact hd'' (hprime.mem_of_pow_mem n h')
  have hNM1 : ∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' (1 : K) := by
    have := hNM 1 h1
    rwa [map_one] at this

  have hNO : ∀ (s : K) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d s →
      (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) → ¬ wcLlsKPOM W A K 𝔭 s := by
    rintro s d hd hLs hns ⟨π, y', hπ, ⟨d', b', s', hd', hLb', hLs', hns', hys'⟩, hs⟩
    have hD : d * d' ∉ 𝔭 := fun hm => (hprime.mem_or_mem hm).elim hd hd'
    have L1 := hLmono d d' s hLs
    have L2 : wcLlsKPLoc A K 0 (d * d') s' := by rw [mul_comm]; exact hLmono d' d s' hLs'
    have L3 : wcLlsKPLoc A K 0 (d * d') b' := by rw [mul_comm]; exact hLmono d' d b' hLb'
    apply wcLlsKP_bcB_mA_prime Ω W hW hWt A K 𝔭 t hPD s s' (d * d') hD L1 L2 hns hns' (d * d') hD
    unfold wcLlsKPMLoc
    exact ⟨π, hπ, b', L3, by rw [hs, ← hys']; ring⟩
  have hOkA : ∀ a : A, wcLlsKPOk W A K 𝔭 (algebraMap A K a) := by
    intro a
    unfold wcLlsKPOk
    exact ⟨1, algebraMap A K a, 1, h1, Loc1 a, LocD1 1, hNM1, mul_one _⟩
  have hAO : ∀ a : A, algebraMap A K a ∈ O := fun a => (hO _).mpr (hOkA a)
  let ι : A →+* ↥O := (algebraMap A K).codRestrict O hAO
  have RES : ∀ y : ↥O, IsLocalRing.residue ↥O y = 0 ↔ wcLlsKPOM W A K 𝔭 (y : K) := fun y => by
    rw [IsLocalRing.residue_eq_zero_iff, ValuationSubring.valuation_lt_one_iff, hOM]
  let ρA : A →+* IsLocalRing.ResidueField ↥O := (IsLocalRing.residue ↥O).comp ι
  have hρnz : ∀ a : A, a ∉ 𝔭 → ρA a ≠ 0 := fun a ha h0 =>
    hNO (algebraMap A K a) 1 h1 (Loc1 a) (hNM a ha) ((RES (ι a)).mp h0)

  have hfrac : ∀ z : IsLocalRing.ResidueField ↥O, ∃ a a' : A, ρA a' ≠ 0 ∧ z * ρA a' = ρA a := by
    intro z
    obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective z
    obtain ⟨d, b, s, hd, ⟨n1, hn1⟩, hLs, hns, hys⟩ := (hO y).mp y.2
    obtain ⟨n2, hn2⟩ := id hLs
    obtain ⟨ab, hab⟩ := hT0 _ hn1
    obtain ⟨as, has⟩ := hT0 _ hn2
    have hOks : wcLlsKPOk W A K 𝔭 s := by
      unfold wcLlsKPOk
      exact ⟨d, s, 1, hd, hLs, LocD1 d, hNM1, mul_one s⟩
    have hsO : s ∈ O := (hO s).mpr hOks
    refine ⟨ab * d ^ n2, as * d ^ n1, ?_, ?_⟩
    · have e : ι (as * d ^ n1) = (⟨s, hsO⟩ : ↥O) * ι d ^ (n1 + n2) := by
        apply Subtype.ext
        rw [MulMemClass.coe_mul, SubmonoidClass.coe_pow]
        show algebraMap A K (as * d ^ n1) = s * algebraMap A K d ^ (n1 + n2)
        rw [map_mul, map_pow, has, pow_add]; ring
      show IsLocalRing.residue ↥O (ι (as * d ^ n1)) ≠ 0
      rw [e, map_mul, map_pow]
      refine mul_ne_zero ?_ (pow_ne_zero _ ?_)
      · intro h0; exact hNO s d hd hLs hns ((RES _).mp h0)
      · intro h0; exact hNO (algebraMap A K d) 1 h1 (Loc1 d) (hNM d hd) ((RES _).mp h0)
    · show IsLocalRing.residue ↥O y * IsLocalRing.residue ↥O (ι (as * d ^ n1)) =
        IsLocalRing.residue ↥O (ι (ab * d ^ n2))
      rw [← map_mul]
      congr 1
      apply Subtype.ext
      rw [MulMemClass.coe_mul]
      show (y : K) * algebraMap A K (as * d ^ n1) = algebraMap A K (ab * d ^ n2)
      rw [map_mul, map_mul, map_pow, map_pow, has, hab, ← hys]; ring

  obtain ⟨ρh, hρh⟩ : ∃ ρh : Localization.Away h →+* IsLocalRing.ResidueField ↥O,
      ∀ a, ρh (algebraMap A (Localization.Away h) a) = ρA a :=
    ⟨IsLocalization.Away.lift h (hρnz h hh).isUnit, fun a => IsLocalization.Away.lift_eq h _ a⟩
  have hfr : ∀ z, ∃ b b' : Localization.Away h, z = ρh b / ρh b' := by
    intro z
    obtain ⟨a, a', hne, heq⟩ := hfrac z
    refine ⟨algebraMap A _ a, algebraMap A _ a', ?_⟩
    rw [hρh, hρh]
    exact (eq_div_iff hne).mpr heq

  haveI hFS : FaithfulSMul ↥ρh.range (IsLocalRing.ResidueField ↥O) :=
    ⟨fun {m₁ m₂} hm => Subtype.ext (by simpa [Subring.smul_def, smul_eq_mul] using hm 1)⟩
  haveI hS : IsFractionRing ↥ρh.range (IsLocalRing.ResidueField ↥O) :=
    IsFractionRing.of_field _ _ (fun z => by
      obtain ⟨b, b', hz⟩ := hfr z
      exact ⟨ρh.rangeRestrict b, ρh.rangeRestrict b', hz⟩)
  have u1 : (algebraMap ↥ρh.range (IsLocalRing.ResidueField ↥O)).FormallyUnramified :=
    RingHom.formallyUnramified_algebraMap.mpr
      (Algebra.FormallyUnramified.of_isLocalization (Rₘ := IsLocalRing.ResidueField ↥O)
        (nonZeroDivisors ↥ρh.range))
  have e1 : (algebraMap ↥ρh.range (IsLocalRing.ResidueField ↥O)).EssFiniteType :=
    RingHom.essFiniteType_algebraMap.mpr
      (Algebra.EssFiniteType.of_isLocalization (IsLocalRing.ResidueField ↥O)
        (nonZeroDivisors ↥ρh.range))
  have u2 : ρh.rangeRestrict.FormallyUnramified :=
    RingHom.FormallyUnramified.of_surjective ρh.rangeRestrict_surjective
  have e2 : ρh.rangeRestrict.EssFiniteType :=
    (RingHom.FiniteType.of_surjective _ ρh.rangeRestrict_surjective).essFiniteType
  have u0 : f₀.FormallyUnramified := RingHom.Etale.formallyUnramified f₀ hEt
  have e0 : f₀.EssFiniteType := by
    letI := f₀.toAlgebra
    haveI : Algebra.Etale (Polynomial ↥W) (Localization.Away h) := hEt
    exact (inferInstance : Algebra.EssFiniteType (Polynomial ↥W) (Localization.Away h))
  have hcompeq : (algebraMap ↥ρh.range (IsLocalRing.ResidueField ↥O)).comp
      (ρh.rangeRestrict.comp f₀) = ρh.comp f₀ := RingHom.ext fun _ => rfl
  have hΦU : (ρh.comp f₀).FormallyUnramified := by
    rw [← hcompeq]; exact (u0.comp u2).comp u1
  have hΦE : (ρh.comp f₀).EssFiniteType := by
    rw [← hcompeq]; exact (e0.comp e2).comp e1

  have hCΦ : ∀ w : ↥W, (ρh.comp f₀) (Polynomial.C w) = ψ (IsLocalRing.residue ↥W w) := by
    intro w
    have e := RingHom.congr_fun hC w
    simp only [RingHom.comp_apply] at e
    show ρh (f₀ (Polynomial.C w)) = _
    rw [e, hρh]
    exact (hψ w (ι (algebraMap ↥W A w)) rfl).symm
  have hXΦ : (ρh.comp f₀) Polynomial.X = xb := by
    show ρh (f₀ Polynomial.X) = xb
    rw [hX, hρh]
    exact (hx (ι t) rfl).symm

  letI : Algebra (IsLocalRing.ResidueField ↥W) (IsLocalRing.ResidueField ↥O) := ψ.toAlgebra
  let xE : ↥(IntermediateField.adjoin (IsLocalRing.ResidueField ↥W) {xb}) :=
    ⟨xb, IntermediateField.mem_adjoin_simple_self (IsLocalRing.ResidueField ↥W) xb⟩
  let g : Polynomial ↥W →+* ↥(IntermediateField.adjoin (IsLocalRing.ResidueField ↥W) {xb}) :=
    Polynomial.eval₂RingHom ((algebraMap (IsLocalRing.ResidueField ↥W)
      ↥(IntermediateField.adjoin (IsLocalRing.ResidueField ↥W) {xb})).comp
        (IsLocalRing.residue ↥W)) xE
  letI : Algebra (Polynomial ↥W) (IsLocalRing.ResidueField ↥O) := (ρh.comp f₀).toAlgebra
  letI : Algebra (Polynomial ↥W) ↥(IntermediateField.adjoin (IsLocalRing.ResidueField ↥W) {xb}) :=
    g.toAlgebra
  haveI : IsScalarTower (Polynomial ↥W)
      ↥(IntermediateField.adjoin (IsLocalRing.ResidueField ↥W) {xb})
      (IsLocalRing.ResidueField ↥O) := by
    apply IsScalarTower.of_algebraMap_eq'
    apply Polynomial.ringHom_ext
    · intro r
      show (ρh.comp f₀) (Polynomial.C r) = algebraMap
        ↥(IntermediateField.adjoin (IsLocalRing.ResidueField ↥W) {xb})
        (IsLocalRing.ResidueField ↥O) (Polynomial.eval₂ ((algebraMap (IsLocalRing.ResidueField ↥W)
          ↥(IntermediateField.adjoin (IsLocalRing.ResidueField ↥W) {xb})).comp
            (IsLocalRing.residue ↥W)) xE (Polynomial.C r))
      rw [Polynomial.eval₂_C]
      have hr := hCΦ r
      simp only [RingHom.comp_apply] at hr ⊢
      rw [hr]
      exact IsScalarTower.algebraMap_apply (IsLocalRing.ResidueField ↥W)
        ↥(IntermediateField.adjoin (IsLocalRing.ResidueField ↥W) {xb})
        (IsLocalRing.ResidueField ↥O) _
    · show (ρh.comp f₀) Polynomial.X = algebraMap
        ↥(IntermediateField.adjoin (IsLocalRing.ResidueField ↥W) {xb})
        (IsLocalRing.ResidueField ↥O) (Polynomial.eval₂ ((algebraMap (IsLocalRing.ResidueField ↥W)
          ↥(IntermediateField.adjoin (IsLocalRing.ResidueField ↥W) {xb})).comp
            (IsLocalRing.residue ↥W)) xE Polynomial.X)
      rw [Polynomial.eval₂_X, hXΦ]
      rfl
  haveI : Algebra.FormallyUnramified (Polynomial ↥W) (IsLocalRing.ResidueField ↥O) := hΦU
  haveI : Algebra.EssFiniteType (Polynomial ↥W) (IsLocalRing.ResidueField ↥O) := hΦE
  haveI := Algebra.FormallyUnramified.of_restrictScalars (Polynomial ↥W)
    ↥(IntermediateField.adjoin (IsLocalRing.ResidueField ↥W) {xb}) (IsLocalRing.ResidueField ↥O)
  haveI := Algebra.EssFiniteType.of_comp (Polynomial ↥W)
    ↥(IntermediateField.adjoin (IsLocalRing.ResidueField ↥W) {xb}) (IsLocalRing.ResidueField ↥O)
  haveI hsep : Algebra.IsSeparable ↥(IntermediateField.adjoin (IsLocalRing.ResidueField ↥W) {xb})
      (IsLocalRing.ResidueField ↥O) :=
    Algebra.FormallyUnramified.isSeparable _ _
  haveI := Algebra.IsSeparable.isAlgebraic
    ↥(IntermediateField.adjoin (IsLocalRing.ResidueField ↥W) {xb}) (IsLocalRing.ResidueField ↥O)
  exact ⟨Algebra.finite_of_essFiniteType_of_isAlgebraic, hsep⟩

theorem wcLlsKPlb_section_over_rat : ∀ (R L κ : Type u) [CommRing R] [Field L] [Field κ]
    (π : R →+* L), Function.Surjective π → (∀ r, π r = 0 → IsNilpotent r) →
    ∀ (τ₀ : κ →+* R) (T : R) (xb : L), π T = xb →
    letI := (π.comp τ₀).toAlgebra
    Transcendental κ xb → FiniteDimensional ↥(IntermediateField.adjoin κ {xb}) L →
    Algebra.IsSeparable ↥(IntermediateField.adjoin κ {xb}) L →
    ∃ σ : L →+* R, (∀ z, π (σ z) = z) ∧ σ xb = T ∧ ∀ a, σ (π (τ₀ a)) = τ₀ a :=
by
  intro R L κ _ _ _ π hsurj hnil τ₀ T xb hT
  letI : Algebra κ L := (π.comp τ₀).toAlgebra
  intro hTr hFD hSep

  have hunit : ∀ r : R, π r ≠ 0 → IsUnit r := by
    intro r hr
    obtain ⟨s, hs⟩ := hsurj (π r)⁻¹
    have hn : IsNilpotent (r * s - 1) :=
      hnil _ (by rw [map_sub, map_mul, hs, map_one, mul_inv_cancel₀ hr, sub_self])
    have hu : IsUnit (r * s) := by
      have := hn.isUnit_one_add
      rwa [add_sub_cancel] at this
    exact isUnit_of_mul_isUnit_left hu
  have hnilπ : ∀ r : R, IsNilpotent r → π r = 0 := fun r h => (h.map π).eq_zero

  have hs2 : ∀ (E : Type u) [Field E] [Algebra E L] [FiniteDimensional E L]
      [Algebra.IsSeparable E L] (σE : E →+* R), (∀ c, π (σE c) = algebraMap E L c) →
      ∃ σ : L →+* R, (∀ z, π (σ z) = z) ∧ ∀ c, σ (algebraMap E L c) = σE c := by
    intro E _ _ _ _ σE hσE
    letI : Algebra E R := σE.toAlgebra
    have hK : ∀ (P : Polynomial E) (y : R),
        π (Polynomial.aeval y P) = Polynomial.aeval (π y) P := by
      intro P y
      rw [Polynomial.aeval_def, Polynomial.hom_eval₂, Polynomial.aeval_def]
      congr 1
      exact RingHom.ext fun c => hσE c
    let pb := Field.powerBasisOfFiniteOfSeparable E L
    have hsepθ : (minpoly E pb.gen).Separable := Algebra.IsSeparable.isSeparable E pb.gen
    obtain ⟨y₀, hy₀⟩ := hsurj pb.gen
    have h1 : IsNilpotent (Polynomial.aeval y₀ (minpoly E pb.gen)) :=
      hnil _ (by rw [hK, hy₀, minpoly.aeval])
    have h2 : IsUnit (Polynomial.aeval y₀ (Polynomial.derivative (minpoly E pb.gen))) :=
      hunit _ (by rw [hK, hy₀]; exact hsepθ.aeval_derivative_ne_zero (minpoly.aeval E pb.gen))
    obtain ⟨r, ⟨hr1, hr2⟩, -⟩ := Polynomial.existsUnique_nilpotent_sub_and_aeval_eq_zero h1 h2
    have hπr : π r = pb.gen := by
      have := hnilπ _ hr1
      rw [map_sub, hy₀, sub_eq_zero] at this
      exact this.symm
    refine ⟨(pb.lift r hr2).toRingHom, ?_, ?_⟩
    · intro z
      obtain ⟨f, rfl⟩ := pb.exists_eq_aeval' z
      show π (pb.lift r hr2 (Polynomial.aeval pb.gen f)) = _
      rw [PowerBasis.lift_aeval, hK, hπr]
    · intro c
      exact (pb.lift r hr2).commutes c

  have hs1 : ∃ σE : ↥(IntermediateField.adjoin κ {xb}) →+* R, (∀ z, π (σE z) = (z : L)) ∧
      σE ⟨xb, IntermediateField.mem_adjoin_simple_self κ xb⟩ = T ∧
      ∀ a, σE (algebraMap κ ↥(IntermediateField.adjoin κ {xb}) a) = τ₀ a := by
    let g : Polynomial κ →+* R := Polynomial.eval₂RingHom τ₀ T
    have hg : ∀ p, π (g p) = Polynomial.aeval xb p := by
      intro p
      show π (Polynomial.eval₂ τ₀ T p) = _
      rw [Polynomial.hom_eval₂, hT, Polynomial.aeval_def]
      rfl
    have hinj : Function.Injective (Polynomial.aeval (R := κ) xb) :=
      (transcendental_iff_injective).mp hTr
    have hc : ∀ y : nonZeroDivisors (Polynomial κ), IsUnit (g y) := by
      intro y
      apply hunit
      rw [hg]
      intro h0
      exact nonZeroDivisors.ne_zero y.2 (hinj (h0.trans (map_zero _).symm))
    let ρ : RatFunc κ →+* R :=
      IsLocalization.lift (M := nonZeroDivisors (Polynomial κ)) (S := RatFunc κ) hc
    have hρ : ∀ p, ρ (algebraMap (Polynomial κ) (RatFunc κ) p) = g p := fun p =>
      IsLocalization.lift_eq _ _
    let φ : RatFunc κ →ₐ[κ] L :=
      IsFractionRing.liftAlgHom (K := RatFunc κ) (g := Polynomial.aeval xb) hinj
    have hφ : ∀ p, φ (algebraMap (Polynomial κ) (RatFunc κ) p) = Polynomial.aeval xb p := by
      intro p
      simp [φ, IsFractionRing.liftAlgHom_apply, IsFractionRing.lift_algebraMap]
    have hrange : φ.fieldRange = IntermediateField.adjoin κ {xb} := by
      apply IsFractionRing.liftAlgHom_fieldRange_eq_of_range_eq
      exact (Algebra.adjoin_singleton_eq_range_aeval κ xb).symm
    have hπρ : ∀ f, π (ρ f) = φ f := by
      have : π.comp ρ = φ.toRingHom := by
        apply IsLocalization.ringHom_ext (nonZeroDivisors (Polynomial κ))
        refine RingHom.ext fun p => ?_
        simp only [RingHom.comp_apply]
        rw [hρ, hg]
        exact (hφ p).symm
      exact fun f => RingHom.congr_fun this f
    let e : RatFunc κ ≃ₐ[κ] ↥(IntermediateField.adjoin κ {xb}) :=
      (AlgEquiv.ofInjectiveField φ).trans (IntermediateField.equivOfEq hrange)
    have he : ∀ f, ((e f : ↥(IntermediateField.adjoin κ {xb})) : L) = φ f := fun f => rfl
    refine ⟨ρ.comp (e.symm : ↥(IntermediateField.adjoin κ {xb}) →ₐ[κ] RatFunc κ).toRingHom,
      ?_, ?_, ?_⟩
    · intro z
      show π (ρ (e.symm z)) = _
      rw [hπρ, ← he, AlgEquiv.apply_symm_apply]
    · have hX : e.symm ⟨xb, IntermediateField.mem_adjoin_simple_self κ xb⟩ = RatFunc.X := by
        apply e.injective
        rw [AlgEquiv.apply_symm_apply]
        apply Subtype.ext
        rw [he, ← RatFunc.algebraMap_X, hφ, Polynomial.aeval_X]
      show ρ (e.symm _) = T
      rw [hX, ← RatFunc.algebraMap_X, hρ]
      exact Polynomial.eval₂_X τ₀ T
    · intro a
      show ρ (e.symm _) = _
      rw [AlgEquiv.commutes, IsScalarTower.algebraMap_apply κ (Polynomial κ) (RatFunc κ) a,
        hρ, Polynomial.algebraMap_apply]
      show Polynomial.eval₂ τ₀ T (Polynomial.C a) = τ₀ a
      exact Polynomial.eval₂_C τ₀ T
  obtain ⟨σE, h1, h2, h3⟩ := hs1
  obtain ⟨σ, hσ1, hσ2⟩ := hs2 _ σE h1
  refine ⟨σ, hσ1, ?_, ?_⟩
  · have := hσ2 ⟨xb, IntermediateField.mem_adjoin_simple_self κ xb⟩
    rw [h2] at this
    exact this
  · intro a
    have := hσ2 (algebraMap κ ↥(IntermediateField.adjoin κ {xb}) a)
    rw [h3] at this
    exact this

theorem wcLlsKPlb_residue_section : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ((ℓ : ℕ) : K) ≠ 0 →
    ∃ (ι : Type u) (u : ι → K), (∀ j, wcLlsKPOk W A K 𝔭 (u j)) ∧
      (∀ c : Option (ι × ℕ) →₀ ↥W, (∃ i, c i ∉ IsLocalRing.maximalIdeal ↥W) →
        ¬ wcLlsKPOM W A K 𝔭 (c.sum fun i a => algebraMap A K (algebraMap ↥W A a) *
          (Option.elim i 1 fun p => u p.1 ^ (ℓ ^ p.2)))) ∧
      (∀ c : ι →₀ ↥W, (∃ j, c j ∉ IsLocalRing.maximalIdeal ↥W) → ∀ y : K,
        wcLlsKPOk W A K 𝔭 y →
        ¬ wcLlsKPOM W A K 𝔭 ((c.sum fun j a => algebraMap A K (algebraMap ↥W A a) * u j) -
          y ^ ℓ)) ∧
      (∀ x : K, wcLlsKPOk W A K 𝔭 x → ∃ c : Option (ι × ℕ) →₀ ↥W,
        wcLlsKPOM W A K 𝔭 (x - c.sum fun i a => algebraMap A K (algebraMap ↥W A a) *
          (Option.elim i 1 fun p => u p.1 ^ (ℓ ^ p.2)))) ∧
      (∃ (c : Option (ι × ℕ) →₀ ↥W) (y : K), wcLlsKPOk W A K 𝔭 y ∧
        algebraMap A K t - (c.sum fun i a => algebraMap A K (algebraMap ↥W A a) *
          (Option.elim i 1 fun p => u p.1 ^ (ℓ ^ p.2))) = ((ℓ : ℕ) : K) * y) ∧
      ∀ c₁ c₂ : Option (ι × ℕ) →₀ ↥W, ∃ (c : Option (ι × ℕ) →₀ ↥W) (y : K),
        wcLlsKPOk W A K 𝔭 y ∧
        (c₁.sum fun i a => algebraMap A K (algebraMap ↥W A a) *
          (Option.elim i 1 fun p => u p.1 ^ (ℓ ^ p.2))) *
        (c₂.sum fun i a => algebraMap A K (algebraMap ↥W A a) *
          (Option.elim i 1 fun p => u p.1 ^ (ℓ ^ p.2))) -
        (c.sum fun i a => algebraMap A K (algebraMap ↥W A a) *
          (Option.elim i 1 fun p => u p.1 ^ (ℓ ^ p.2))) = ((ℓ : ℕ) : K) * y :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 t hPD ℓ hℓ hΩ hκ hℓK
  classical

  obtain ⟨O, hO, hOM, -, hwO, -, -⟩ := wcLlsKP_bcBf_valring Ω W hW hWt A K 𝔭 t hPD ℓ hℓ hκ hℓK
  obtain ⟨wO, hwO'⟩ : ∃ wO : ↥W →+* ↥O, ∀ w, ((wO w : ↥O) : K) = algebraMap A K (algebraMap ↥W A w) :=
    ⟨((algebraMap A K).comp (algebraMap ↥W A)).codRestrict O hwO, fun _ => rfl⟩
  have RES : ∀ y : ↥O, IsLocalRing.residue ↥O y = 0 ↔ wcLlsKPOM W A K 𝔭 (y : K) := fun y => by
    rw [IsLocalRing.residue_eq_zero_iff, ValuationSubring.valuation_lt_one_iff, hOM]

  have hℓW0 : ((ℓ : ℕ) : ↥W) ≠ 0 := by
    intro h
    apply hℓK
    rw [show ((ℓ : ℕ) : K) = algebraMap A K (algebraMap ↥W A ((ℓ : ℕ) : ↥W)) by
      rw [map_natCast, map_natCast], h, map_zero, map_zero]
  have hℓm : ((ℓ : ℕ) : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [← IsLocalRing.residue_eq_zero_iff, map_natCast]
    exact (ringChar.spec _ ℓ).mpr (by rw [hκ])
  have hOk1 : wcLlsKPOk W A K 𝔭 1 := (hO 1).mp O.one_mem

  have hAO : ∀ a : A, algebraMap A K a ∈ O := by
    intro a
    obtain ⟨d, b, s, hd, hb, hs, hns, hsb⟩ := hOk1
    rw [hO]
    unfold wcLlsKPOk
    refine ⟨d, algebraMap A K a * s, s, hd, ?_, hs, hns, rfl⟩
    unfold wcLlsKPLoc at hs ⊢
    obtain ⟨n, hn⟩ := hs
    exact ⟨n, by rw [mul_left_comm]; exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ a) hn⟩
  obtain ⟨tO, htOc⟩ : ∃ tO : ↥O, (tO : K) = algebraMap A K t := ⟨⟨_, hAO t⟩, rfl⟩

  set I : Ideal ↥O := Ideal.span {((ℓ : ℕ) : ↥O)} with hI
  have hIm : I ≤ IsLocalRing.maximalIdeal ↥O := by
    rw [hI, Ideal.span_singleton_le_iff_mem, ValuationSubring.valuation_lt_one_iff,
      SubringClass.coe_natCast, ← hOM]
    exact ⟨(ℓ : ℕ), 1, hℓm, hOk1, by rw [map_natCast, map_natCast, mul_one]⟩
  obtain ⟨π, hπmk⟩ : ∃ π : ↥O ⧸ I →+* IsLocalRing.ResidueField ↥O,
      ∀ y, π (Ideal.Quotient.mk I y) = IsLocalRing.residue ↥O y :=
    ⟨Ideal.Quotient.lift I (IsLocalRing.residue ↥O)
      (fun a ha => (IsLocalRing.residue_eq_zero_iff a).mpr (hIm ha)),
      fun y => Ideal.Quotient.lift_mk _ _ _⟩
  have hπs : Function.Surjective π := by
    intro z
    obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective z
    exact ⟨_, hπmk y⟩
  have hπn : ∀ r, π r = 0 → IsNilpotent r := by
    intro r hr
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective r
    rw [hπmk] at hr
    obtain ⟨p, y', hp, hy', hyeq⟩ := (RES y).mp hr
    obtain ⟨N, π', -, hpN⟩ := wcLlsKP_nfb_archimedean Ω W hW p _ hp hℓW0
    refine ⟨N, ?_⟩
    rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem, hI, Ideal.mem_span_singleton']
    refine ⟨wO π' * ⟨y', (hO y').mpr hy'⟩ ^ N, Subtype.ext ?_⟩
    simp only [MulMemClass.coe_mul, SubmonoidClass.coe_pow, SubringClass.coe_natCast, hwO']
    rw [hyeq, mul_pow, ← map_pow, ← map_pow, hpN, map_mul, map_mul, map_natCast, map_natCast]
    ring

  set I₀ : Ideal ↥W := Ideal.span {((ℓ : ℕ) : ↥W)} with hI₀
  obtain ⟨π₀, hπ₀mk⟩ : ∃ π₀ : ↥W ⧸ I₀ →+* IsLocalRing.ResidueField ↥W,
      ∀ w, π₀ (Ideal.Quotient.mk I₀ w) = IsLocalRing.residue ↥W w :=
    ⟨Ideal.Quotient.lift I₀ (IsLocalRing.residue ↥W)
      (fun a ha => (IsLocalRing.residue_eq_zero_iff a).mpr
        ((Ideal.span_singleton_le_iff_mem _).mpr hℓm ha)),
      fun w => Ideal.Quotient.lift_mk _ _ _⟩
  have hπ₀s : Function.Surjective π₀ := by
    intro z
    obtain ⟨w, rfl⟩ := IsLocalRing.residue_surjective z
    exact ⟨_, hπ₀mk w⟩
  have hπ₀n : ∀ r, π₀ r = 0 → IsNilpotent r := by
    intro r hr
    obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective r
    rw [hπ₀mk] at hr
    have hw := (IsLocalRing.residue_eq_zero_iff w).mp hr
    obtain ⟨N, π', -, hN⟩ := wcLlsKP_nfb_archimedean Ω W hW w _ hw hℓW0
    exact ⟨N, by
      rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem, hN]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)⟩
  have hℓR₀ : ((ℓ : ℕ) : ↥W ⧸ I₀) = 0 := by
    rw [← map_natCast (Ideal.Quotient.mk I₀), Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_span_singleton_self _
  have hroot : ∀ r : ↥W ⧸ I₀, ∃ y, y ^ ℓ = r := by
    intro r
    obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective r
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (w : Ω) hℓ.pos
    have hzW : z ∈ W := by
      apply ValuationSubring.mem_of_valuation_le_one
      have h1 : W.valuation z ^ ℓ ≤ 1 := by rw [← map_pow, hz]; exact W.valuation_le_one w
      exact (pow_le_one_iff hℓ.ne_zero).mp h1
    refine ⟨Ideal.Quotient.mk _ ⟨z, hzW⟩, ?_⟩
    rw [← map_pow]
    congr 1
    exact Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hz)

  haveI hκchar : CharP (IsLocalRing.ResidueField ↥W) ℓ := ringChar.of_eq hκ
  obtain ⟨τ, hτ⟩ := wcLlsKPlb_coeff_section (↥W ⧸ I₀) (IsLocalRing.ResidueField ↥W) ℓ hℓ hκchar
    hℓR₀ π₀ hπ₀s hπ₀n hroot
  obtain ⟨j, hjmk⟩ : ∃ j : ↥W ⧸ I₀ →+* ↥O ⧸ I,
      ∀ w, j (Ideal.Quotient.mk I₀ w) = Ideal.Quotient.mk I (wO w) :=
    ⟨Ideal.quotientMap I wO ((Ideal.span_singleton_le_iff_mem _).mpr (by
      rw [Ideal.mem_comap, map_natCast]; exact Ideal.mem_span_singleton_self _)),
      fun w => Ideal.quotientMap_mk⟩
  obtain ⟨τ₀, hτ₀⟩ : ∃ τ₀ : IsLocalRing.ResidueField ↥W →+* ↥O ⧸ I, ∀ a, τ₀ a = j (τ a) :=
    ⟨j.comp τ, fun _ => rfl⟩
  set ψ : IsLocalRing.ResidueField ↥W →+* IsLocalRing.ResidueField ↥O := π.comp τ₀ with hψ

  have hψres : ∀ w : ↥W, ψ (IsLocalRing.residue ↥W w) = IsLocalRing.residue ↥O (wO w) := by
    intro w
    have he : IsNilpotent (Ideal.Quotient.mk I₀ w - τ (IsLocalRing.residue ↥W w)) :=
      hπ₀n _ (by rw [map_sub, hτ, hπ₀mk, sub_self])
    have h3 := (IsNilpotent.map (IsNilpotent.map he j) π).eq_zero
    rw [map_sub, map_sub, hjmk, hπmk] at h3
    rw [hψ, RingHom.comp_apply, hτ₀]
    exact (sub_eq_zero.mp h3).symm

  have htr : ∀ p : Polynomial (IsLocalRing.ResidueField ↥W), p ≠ 0 →
      p.eval₂ ψ (IsLocalRing.residue ↥O tO) ≠ 0 := by
    have hcomp : ψ.comp (IsLocalRing.residue ↥W) = (IsLocalRing.residue ↥O).comp wO :=
      RingHom.ext hψres
    intro p hp hzero
    obtain ⟨f, rfl⟩ := Polynomial.map_surjective _ IsLocalRing.residue_surjective p
    rw [Polynomial.eval₂_map, hcomp, ← Polynomial.hom_eval₂] at hzero
    have hOM' := (RES _).mp hzero
    have hco : ((Polynomial.eval₂ wO tO f : ↥O) : K) =
        f.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K t) := by
      have h := Polynomial.hom_eval₂ f wO O.subtype tO
      have e1 : O.subtype.comp wO = (algebraMap A K).comp (algebraMap ↥W A) :=
        RingHom.ext fun w => hwO' w
      rw [e1] at h
      rw [← htOc]
      exact h
    obtain ⟨i, hi⟩ : ∃ i, f.coeff i ∉ IsLocalRing.maximalIdeal ↥W := by
      by_contra hcon
      push_neg at hcon
      apply hp
      ext i
      rw [Polynomial.coeff_map, Polynomial.coeff_zero]
      exact (IsLocalRing.residue_eq_zero_iff _).mpr (hcon i)
    exact wcLlsKPlb_residue_transc Ω W hW hWt A K 𝔭 t hPD f ⟨i, hi⟩ (hco ▸ hOM')

  obtain ⟨hfd, hsep⟩ := wcLlsKPlb_residue_sep Ω W hW hWt A K 𝔭 t hPD O hO hOM ψ
    (IsLocalRing.residue ↥O tO)
    (fun w z hz => by rw [hψres]; congr 1; exact Subtype.ext (by rw [hwO', hz]))
    (fun z hz => by congr 1; exact Subtype.ext (by rw [htOc, hz]))
    htr
  letI : Algebra (IsLocalRing.ResidueField ↥W) (IsLocalRing.ResidueField ↥O) := ψ.toAlgebra
  have htrans : Transcendental (IsLocalRing.ResidueField ↥W) (IsLocalRing.residue ↥O tO) := by
    rw [transcendental_iff_injective, injective_iff_map_eq_zero]
    intro p hp
    by_contra h
    exact htr p h (by rw [Polynomial.aeval_def] at hp; exact hp)

  obtain ⟨σ, hσπ, hσT, hστ⟩ := wcLlsKPlb_section_over_rat (↥O ⧸ I)
    (IsLocalRing.ResidueField ↥O) (IsLocalRing.ResidueField ↥W) π hπs hπn τ₀
    (Ideal.Quotient.mk I tO) (IsLocalRing.residue ↥O tO) (hπmk tO) htrans hfd hsep

  haveI hκac : IsAlgClosed (IsLocalRing.ResidueField ↥W) := wcpa_dj_nc_residue_algclosed Ω W
  obtain ⟨N, hN1, hN2, hN3, hN4⟩ := wcLlsKPlb_pole_norm (IsLocalRing.ResidueField ↥W)
    (IsLocalRing.ResidueField ↥O) (IsLocalRing.residue ↥O tO) htrans hfd hsep
  have hchar : CharP (IsLocalRing.ResidueField ↥O) ℓ := charP_of_injective_ringHom ψ.injective ℓ
  obtain ⟨ι, ut, hA, hB, hC⟩ := wcLlsKPlb_layered_from_norm (IsLocalRing.ResidueField ↥W)
    (IsLocalRing.ResidueField ↥O) ℓ hℓ hchar inferInstance N hN1 hN2 (fun f => hN3 f ℓ) hN4
  have hA' : ∀ c : Option (ι × ℕ) →₀ IsLocalRing.ResidueField ↥W,
      (c.sum fun i a => ψ a * Option.elim i 1 (fun p => ut p.1 ^ (ℓ ^ p.2))) = 0 → c = 0 := hA
  have hB' : ∀ f : IsLocalRing.ResidueField ↥O, ∃ c : Option (ι × ℕ) →₀ IsLocalRing.ResidueField ↥W,
      (c.sum fun i a => ψ a * Option.elim i 1 (fun p => ut p.1 ^ (ℓ ^ p.2))) = f := hB
  have hC' : ∀ c : ι →₀ IsLocalRing.ResidueField ↥W, c ≠ 0 → ∀ y : IsLocalRing.ResidueField ↥O,
      (c.sum fun j a => ψ a * ut j) ≠ y ^ ℓ := hC

  have hlift : ∀ i, ∃ y : ↥O, Ideal.Quotient.mk I y = σ (ut i) :=
    fun i => Ideal.Quotient.mk_surjective _
  choose u' hu' using hlift
  obtain ⟨u, hu⟩ : ∃ u : ι → K, ∀ i, u i = ((u' i : ↥O) : K) := ⟨_, fun _ => rfl⟩
  obtain ⟨bO, hbO⟩ : ∃ bO : Option (ι × ℕ) → ↥O,
      ∀ i, bO i = Option.elim i 1 fun p => u' p.1 ^ (ℓ ^ p.2) := ⟨_, fun _ => rfl⟩
  obtain ⟨BO, hBO⟩ : ∃ BO : (Option (ι × ℕ) →₀ ↥W) → ↥O,
      ∀ c, BO c = c.sum fun i a => wO a * bO i := ⟨_, fun _ => rfl⟩
  have hcoeSum : ∀ {X : Type u} (c : X →₀ ↥W) (f : X → ↥O),
      (((c.sum fun i a => wO a * f i) : ↥O) : K) =
        c.sum fun i a => algebraMap A K (algebraMap ↥W A a) * (f i : K) := by
    intro X c f
    unfold Finsupp.sum
    rw [AddSubmonoidClass.coe_finset_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [MulMemClass.coe_mul, hwO']
  have hresSum : ∀ {X : Type u} (c : X →₀ ↥W) (f : X → ↥O),
      IsLocalRing.residue ↥O (c.sum fun i a => wO a * f i) =
        (Finsupp.mapRange (IsLocalRing.residue ↥W) (map_zero _) c).sum
          fun i a => ψ a * IsLocalRing.residue ↥O (f i) := by
    intro X c f
    rw [Finsupp.sum_mapRange_index (fun _ => by simp), map_finsuppSum]
    exact Finsupp.sum_congr fun i _ => by rw [map_mul, hψres]
  have hbcoe : ∀ i, ((bO i : ↥O) : K) = Option.elim i 1 fun p => u p.1 ^ (ℓ ^ p.2) := by
    intro i
    rw [hbO]
    rcases i with _ | p <;> simp [hu]
  have hBcoe : ∀ c, ((BO c : ↥O) : K) = c.sum fun i a => algebraMap A K (algebraMap ↥W A a) *
      (Option.elim i 1 fun p => u p.1 ^ (ℓ ^ p.2)) := by
    intro c
    rw [hBO, hcoeSum]
    exact Finsupp.sum_congr fun i _ => by rw [hbcoe]
  have hmkb : ∀ i, Ideal.Quotient.mk I (bO i) =
      σ (Option.elim i 1 fun p => ut p.1 ^ (ℓ ^ p.2)) := by
    intro i
    rw [hbO]
    rcases i with _ | p
    · simp
    · simp [hu']
  have hbres : ∀ i, IsLocalRing.residue ↥O (bO i) = Option.elim i 1 fun p => ut p.1 ^ (ℓ ^ p.2) := by
    intro i
    rw [← hπmk, hmkb, hσπ]
  have hresu : ∀ i, IsLocalRing.residue ↥O (u' i) = ut i := by
    intro i
    rw [← hπmk, hu', hσπ]

  have hB0 : BO 0 = 0 := by rw [hBO, Finsupp.sum_zero_index]
  have hBadd : ∀ c c', BO (c + c') = BO c + BO c' := by
    intro c c'
    rw [hBO, hBO, hBO]
    exact Finsupp.sum_add_index' (fun _ => by simp) (fun _ _ _ => by simp [add_mul])
  have hBsmul : ∀ (r : ↥W) c, BO (r • c) = wO r * BO c := by
    intro r c
    rw [hBO, hBO, Finsupp.sum_smul_index' (fun _ => by simp), Finsupp.mul_sum]
    apply Finsupp.sum_congr
    intro i _
    simp only [smul_eq_mul, map_mul]
    ring
  have hmkBO : ∀ c, Ideal.Quotient.mk I (BO c) =
      c.sum fun i a => Ideal.Quotient.mk I (wO a) * Ideal.Quotient.mk I (bO i) := by
    intro c
    rw [hBO, map_finsuppSum]
    exact Finsupp.sum_congr fun i _ => map_mul _ _ _

  have hwlx : ∀ b : IsLocalRing.ResidueField ↥W, ∃ w : ↥W,
      Ideal.Quotient.mk I₀ w = τ b ∧ (b = 0 → w = 0) := by
    intro b
    by_cases hb : b = 0
    · exact ⟨0, by rw [hb, map_zero, map_zero], fun _ => rfl⟩
    · obtain ⟨w, hw⟩ := Ideal.Quotient.mk_surjective (τ b)
      exact ⟨w, hw, fun h => absurd h hb⟩
  choose wl hwl hwl0 using hwlx
  have hwlj : ∀ b, Ideal.Quotient.mk I (wO (wl b)) = σ (ψ b) := by
    intro b
    rw [← hjmk, hwl b, ← hτ₀]
    exact (hστ b).symm
  have SP : ∀ z, ∃ c, Ideal.Quotient.mk I (BO c) = σ z := by
    intro z
    obtain ⟨a, ha⟩ := hB' z
    refine ⟨Finsupp.mapRange wl (hwl0 0 rfl) a, ?_⟩
    rw [hmkBO, Finsupp.sum_mapRange_index (fun _ => by simp), ← ha, map_finsuppSum]
    apply Finsupp.sum_congr
    intro i _
    rw [map_mul, hmkb, hwlj]

  have hQadd : ∀ r r', (∃ c, Ideal.Quotient.mk I (BO c) = r) →
      (∃ c, Ideal.Quotient.mk I (BO c) = r') → ∃ c, Ideal.Quotient.mk I (BO c) = r + r' := by
    rintro r r' ⟨c, hc⟩ ⟨c', hc'⟩
    exact ⟨c + c', by rw [hBadd, map_add, hc, hc']⟩
  have hQ0 : ∃ c, Ideal.Quotient.mk I (BO c) = 0 := ⟨0, by rw [hB0, map_zero]⟩
  have hQsum : ∀ {X : Type u} (c : X →₀ ↥W) (g : X → ↥O ⧸ I),
      (∀ i, ∃ c', Ideal.Quotient.mk I (BO c') = g i) →
      ∃ c', Ideal.Quotient.mk I (BO c') = c.sum fun i a => Ideal.Quotient.mk I (wO a) * g i := by
    intro X c g hg
    unfold Finsupp.sum
    apply Finset.sum_induction _ (fun r => ∃ c', Ideal.Quotient.mk I (BO c') = r) hQadd hQ0
    intro i _
    obtain ⟨c', hc'⟩ := hg i
    exact ⟨c i • c', by rw [hBsmul, map_mul, hc']⟩

  refine ⟨ι, u, fun i => ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hu]; exact (hO _).mp (u' i).2
  ·
    rintro c ⟨i, hi⟩ hom
    rw [← hBcoe] at hom
    have h0 := (RES (BO c)).mpr hom
    rw [hBO, hresSum] at h0
    simp only [hbres] at h0
    have h1 := hA' _ h0
    have h2 := congrArg (fun f => f i) h1
    simp only [Finsupp.mapRange_apply, Finsupp.coe_zero, Pi.zero_apply] at h2
    exact hi ((IsLocalRing.residue_eq_zero_iff _).mp h2)
  ·
    rintro c ⟨i, hi⟩ y hy hom
    obtain ⟨yO, hyO⟩ : ∃ yO : ↥O, (yO : K) = y := ⟨⟨y, (hO y).mpr hy⟩, rfl⟩
    have hE : (((c.sum fun j a => wO a * u' j) - yO ^ ℓ : ↥O) : K) =
        (c.sum fun j a => algebraMap A K (algebraMap ↥W A a) * u j) - y ^ ℓ := by
      rw [AddSubgroupClass.coe_sub, hcoeSum, SubmonoidClass.coe_pow, hyO]
      simp only [hu]
    rw [← hE] at hom
    have h0 := (RES _).mpr hom
    rw [map_sub, map_pow, hresSum] at h0
    simp only [hresu] at h0
    refine hC' (Finsupp.mapRange _ (map_zero _) c) ?_ (IsLocalRing.residue ↥O yO)
      (sub_eq_zero.mp h0)
    intro h
    have h2 := congrArg (fun f => f i) h
    simp only [Finsupp.mapRange_apply, Finsupp.coe_zero, Pi.zero_apply] at h2
    exact hi ((IsLocalRing.residue_eq_zero_iff _).mp h2)
  ·
    intro x hx
    obtain ⟨xO, hxO⟩ : ∃ xO : ↥O, (xO : K) = x := ⟨⟨x, (hO x).mpr hx⟩, rfl⟩
    obtain ⟨a, ha⟩ := hB' (IsLocalRing.residue ↥O xO)
    have hsx : ∀ b : IsLocalRing.ResidueField ↥W, ∃ w : ↥W,
        IsLocalRing.residue ↥W w = b ∧ (b = 0 → w = 0) := by
      intro b
      by_cases hb : b = 0
      · exact ⟨0, by rw [hb, map_zero], fun _ => rfl⟩
      · obtain ⟨w, hw⟩ := IsLocalRing.residue_surjective b
        exact ⟨w, hw, fun h => absurd h hb⟩
    choose sres hsres hsres0 using hsx
    have hmapc : Finsupp.mapRange (IsLocalRing.residue ↥W) (map_zero _)
        (Finsupp.mapRange sres (hsres0 0 rfl) a) = a := by
      ext i
      simp [hsres]
    refine ⟨Finsupp.mapRange sres (hsres0 0 rfl) a, ?_⟩
    rw [← hBcoe, ← hxO, ← AddSubgroupClass.coe_sub]
    apply (RES _).mp
    rw [map_sub, hBO, hresSum, hmapc]
    simp only [hbres]
    rw [ha, sub_self]
  ·
    obtain ⟨c, hc⟩ := SP (IsLocalRing.residue ↥O tO)
    rw [hσT] at hc
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp (Ideal.Quotient.eq.mp hc.symm)
    refine ⟨c, (a : K), (hO _).mp a.2, ?_⟩
    rw [← hBcoe, ← htOc]
    have e := congrArg Subtype.val ha
    push_cast at e
    linear_combination (-1 : K) * e
  ·
    intro c₁ c₂
    have hQb : ∀ i i', ∃ c', Ideal.Quotient.mk I (BO c') =
        Ideal.Quotient.mk I (bO i) * Ideal.Quotient.mk I (bO i') := by
      intro i i'
      rw [hmkb, hmkb, ← map_mul]
      exact SP _
    have hQ : ∃ c', Ideal.Quotient.mk I (BO c') = Ideal.Quotient.mk I (BO c₁ * BO c₂) := by
      have e1 : Ideal.Quotient.mk I (BO c₁ * BO c₂) = c₁.sum fun i a =>
          Ideal.Quotient.mk I (wO a) * (Ideal.Quotient.mk I (bO i) * Ideal.Quotient.mk I (BO c₂)) := by
        rw [map_mul, hmkBO c₁, Finsupp.sum_mul]
        exact Finsupp.sum_congr fun i _ => by ring
      rw [e1]
      apply hQsum
      intro i
      have e2 : Ideal.Quotient.mk I (bO i) * Ideal.Quotient.mk I (BO c₂) = c₂.sum fun i' a =>
          Ideal.Quotient.mk I (wO a) * (Ideal.Quotient.mk I (bO i) * Ideal.Quotient.mk I (bO i')) := by
        rw [hmkBO c₂, Finsupp.mul_sum]
        exact Finsupp.sum_congr fun i' _ => by ring
      rw [e2]
      exact hQsum c₂ _ (fun i' => hQb i i')
    obtain ⟨c, hc⟩ := hQ
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp (Ideal.Quotient.eq.mp hc.symm)
    refine ⟨c, (a : K), (hO _).mp a.2, ?_⟩
    rw [← hBcoe, ← hBcoe, ← hBcoe]
    have e := congrArg Subtype.val ha
    push_cast at e
    linear_combination (-1 : K) * e

theorem wcLlsKPlb_saturation : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ((ℓ : ℕ) : K) ≠ 0 →
    ∀ S : K → Prop, (∀ x, S x → wcLlsKPOk W A K 𝔭 x) →
      (∀ y, wcLlsKPOk W A K 𝔭 y → S (((ℓ : ℕ) : K) * y)) →
      (∀ w : ↥W, S (algebraMap A K (algebraMap ↥W A w))) → S (algebraMap A K t) →
      (∀ x y, S x → S y → S (x + y)) → (∀ x y, S x → S y → S (x * y)) →
      (∀ x, wcLlsKPOk W A K 𝔭 x → ∃ s, S s ∧ wcLlsKPOM W A K 𝔭 (x - s)) →
      ∀ x, wcLlsKPOk W A K 𝔭 x → S x :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 t hPD ℓ hℓ hΩ hκ hℓK S hS1 hS2 hS3 hSt hSadd hSmul hS5
  classical

  have s5 : ∀ (P B R : Type u) [CommRing P] [CommRing B] [CommRing R] (f : P →+* B), f.Etale →
      ∀ (ψ : B →+* R) (T : Subring R), (∀ p, ψ (f p) ∈ T) →
      (∀ r : R, ∃ τ ∈ T, IsNilpotent (r - τ)) → ∀ b, ψ b ∈ T := by
    intro P B R _ _ _ f hf ψ T h1 h2
    letI : Algebra P B := f.toAlgebra
    haveI : Algebra.Etale P B := hf
    letI : Algebra P R := (ψ.comp f).toAlgebra
    let TA : Subalgebra P R :=
      { T with algebraMap_mem' := fun p => h1 p }
    let ψA : B →ₐ[P] R := { ψ with commutes' := fun p => rfl }
    obtain ⟨G, hG⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra P B).FG)
    choose τ hτT hτN using fun g : B => h2 (ψ g)
    let J : Ideal R := Ideal.span ((fun g : G => ψ g - τ g) '' Set.univ)
    have hJfg : J.FG := by
      refine Submodule.fg_span ?_
      exact Set.Finite.image _ Set.finite_univ
    have hJnil : IsNilpotent J := by
      rw [hJfg.isNilpotent_iff_le_nilradical]
      rw [Ideal.span_le]
      rintro x ⟨g, -, rfl⟩
      exact (mem_nilradical).mpr (hτN g)
    let q : R →ₐ[P] R ⧸ J := Ideal.Quotient.mkₐ P J
    let gT : TA →ₐ[P] R ⧸ J := q.comp TA.val
    let C := gT.range
    let g : TA →ₐ[P] C := gT.rangeRestrict
    have hgsurj : Function.Surjective g := AlgHom.rangeRestrict_surjective gT
    have hgnil : IsNilpotent (RingHom.ker g) := by
      obtain ⟨k, hk⟩ := hJnil
      refine ⟨k, ?_⟩
      have hle : RingHom.ker g ≤ J.comap (TA.val : TA →+* R) := by
        intro x hx
        rw [RingHom.mem_ker] at hx
        have hx' : ((g x : C) : R ⧸ J) = 0 := by rw [hx]; rfl
        change Ideal.Quotient.mk J (x : R) = 0 at hx'
        rw [Ideal.Quotient.eq_zero_iff_mem] at hx'
        exact hx'
      rw [Ideal.zero_eq_bot, ← le_bot_iff]
      calc RingHom.ker g ^ k ≤ (J.comap (TA.val : TA →+* R)) ^ k := Ideal.pow_right_mono hle k
        _ ≤ (J ^ k).comap (TA.val : TA →+* R) := Ideal.le_comap_pow _ k
        _ = ⊥ := by
          rw [hk, Ideal.zero_eq_bot]
          exact Ideal.comap_bot_of_injective _ Subtype.val_injective
    have hmemC : ∀ b, q (ψA b) ∈ C := by
      have hQ : (⊤ : Subalgebra P B) ≤ C.comap (q.comp ψA) := by
        rw [← hG, Algebra.adjoin_le_iff]
        intro x hx
        refine ⟨⟨τ x, hτT x⟩, ?_⟩
        change Ideal.Quotient.mk J (τ x) = Ideal.Quotient.mk J (ψ x)
        rw [Ideal.Quotient.eq]
        have : ψ x - τ x ∈ J := Ideal.subset_span ⟨⟨x, hx⟩, Set.mem_univ _, rfl⟩
        rw [← neg_sub]
        exact J.neg_mem this
      intro b
      exact hQ (Algebra.mem_top (x := b))
    let F : B →ₐ[P] C := (q.comp ψA).codRestrict C hmemC
    let lam : B →ₐ[P] TA := Algebra.FormallySmooth.liftOfSurjective F g hgsurj hgnil
    have hlam : ∀ b, g (lam b) = F b :=
      Algebra.FormallySmooth.liftOfSurjective_apply F g hgsurj hgnil
    have hJker : IsNilpotent (RingHom.ker (Ideal.Quotient.mk J)) := by
      rw [Ideal.mk_ker]; exact hJnil
    have heq : TA.val.comp lam = ψA := by
      refine Algebra.FormallyUnramified.ext' (Ideal.Quotient.mk J) hJker _ _ ?_
      intro x
      have := congrArg (fun c : C => (c : R ⧸ J)) (hlam x)
      exact this
    intro b
    have := congrArg (fun φ : B →ₐ[P] R => φ b) heq
    simp only [AlgHom.comp_apply] at this
    change ((lam b : TA) : R) = ψ b at this
    rw [← this]
    exact (lam b).2

  obtain ⟨O, hO, -, -, hwO, -, -⟩ := wcLlsKP_bcBf_valring Ω W hW hWt A K 𝔭 t hPD ℓ hℓ hκ hℓK
  obtain ⟨O', hO'⟩ : ∃ O' : Subring K, ∀ y, y ∈ O' ↔ wcLlsKPOk W A K 𝔭 y :=
    ⟨O.toSubring, fun y => hO y⟩
  have hwO' : ∀ w : ↥W, algebraMap A K (algebraMap ↥W A w) ∈ O' :=
    fun w => (hO' _).mpr ((hO _).mp (hwO w))

  have hε : ((ℓ : ℕ) : K) = algebraMap A K (algebraMap ↥W A ((ℓ : ℕ) : ↥W)) := by
    rw [map_natCast, map_natCast]
  have hS0 : S 0 := by simpa using hS3 0
  have hS1' : S 1 := by simpa using hS3 1
  have hSm1 : S (-1) := by simpa using hS3 (-1)
  have hSneg : ∀ x, S x → S (-x) := fun x hx => by simpa using hSmul _ _ hSm1 hx
  have hSsub : ∀ x y, S x → S y → S (x - y) := fun x y hx hy => by
    rw [sub_eq_add_neg]; exact hSadd _ _ hx (hSneg _ hy)
  have hSpow : ∀ x (n : ℕ), S x → S (x ^ n) := by
    intro x n hx
    induction n with
    | zero => rw [pow_zero]; exact hS1'
    | succ n ih => rw [pow_succ]; exact hSmul _ _ ih hx
  have hSO : ∀ x, S x → x ∈ O' := fun x hx => (hO' x).mpr (hS1 x hx)
  have hSε : ∀ y ∈ O', S (((ℓ : ℕ) : K) * y) := fun y hy => hS2 y ((hO' y).mp hy)

  have hℓW0 : ((ℓ : ℕ) : ↥W) ≠ 0 := by
    intro h0; apply hℓK; rw [hε, h0, map_zero, map_zero]
  have hnil : ∀ y, wcLlsKPOM W A K 𝔭 y →
      ∃ (N : ℕ) (z : K), z ∈ O' ∧ y ^ N = ((ℓ : ℕ) : K) * z := by
    rintro y ⟨π, y', hπ, hy', rfl⟩
    obtain ⟨N, π', -, hN⟩ := wcLlsKP_nfb_archimedean Ω W hW π _ hπ hℓW0
    refine ⟨N, algebraMap A K (algebraMap ↥W A π') * y' ^ N,
      mul_mem (hwO' π') (pow_mem ((hO' y').mpr hy') N), ?_⟩
    rw [mul_pow, ← map_pow, ← map_pow, hN, map_mul, map_mul, ← hε, mul_assoc]
  have habs : ∀ x y, wcLlsKPOM W A K 𝔭 x → y ∈ O' → wcLlsKPOM W A K 𝔭 (y * x) := by
    rintro x y ⟨π, x', hπ, hx', rfl⟩ hy
    exact ⟨π, y * x', hπ, (hO' _).mp (mul_mem hy ((hO' x').mpr hx')), by ring⟩

  have hinv : ∀ s, S s → s ≠ 0 → s⁻¹ ∈ O' → S s⁻¹ := by
    intro s hs hs0 hsi
    obtain ⟨s', hs', hM⟩ := hS5 s⁻¹ ((hO' _).mp hsi)
    have hnM : wcLlsKPOM W A K 𝔭 (1 - s * s') := by
      have h1 := habs _ s hM (hSO s hs)
      have e : s * (s⁻¹ - s') = 1 - s * s' := by rw [mul_sub, mul_inv_cancel₀ hs0]
      rwa [e] at h1
    have hnS : S (1 - s * s') := hSsub _ _ hS1' (hSmul _ _ hs hs')
    obtain ⟨N, z, hz, hnz⟩ := hnil _ hnM
    have hG : S (∑ i ∈ Finset.range N, (1 - s * s') ^ i) :=
      Finset.sum_induction _ S hSadd hS0 (fun i _ => hSpow _ i hnS)
    have h1 : (1 - (1 - s * s')) * (∑ i ∈ Finset.range N, (1 - s * s') ^ i) =
        1 - (1 - s * s') ^ N := mul_neg_geom_sum _ N
    rw [hnz] at h1
    have h3 : s⁻¹ * s = 1 := inv_mul_cancel₀ hs0
    have key : s⁻¹ = s' * (∑ i ∈ Finset.range N, (1 - s * s') ^ i) +
        ((ℓ : ℕ) : K) * (s⁻¹ * z) := by
      linear_combination (-s⁻¹) * h1 + s' * (∑ i ∈ Finset.range N, (1 - s * s') ^ i) * h3
    rw [key]
    exact hSadd _ _ (hSmul _ _ hs' hG) (hSε _ (mul_mem hsi hz))

  obtain ⟨-, -, -, h𝔭max, hm𝔭, hdisc⟩ := hPD
  obtain ⟨-, -, h, hh, f, hfC, hfX, hfet⟩ := hdisc
  have hPrime : 𝔭.IsPrime := h𝔭max.isPrime
  have T0 : ∀ (d : A) (x : K), wcLlsKPLoc A K 0 d x ↔
      ∃ (n : ℕ) (a : A), algebraMap A K a = algebraMap A K d ^ n * x := by
    intro d x
    have hbot : Algebra.adjoin A ({0} : Set K) = ⊥ := by
      apply le_antisymm
      · rw [Algebra.adjoin_le_iff]
        intro z hz
        rw [Set.mem_singleton_iff.mp hz]
        exact Subalgebra.zero_mem _
      · exact bot_le
    unfold wcLlsKPLoc
    rw [hbot]
    constructor
    · rintro ⟨n, hn⟩
      obtain ⟨a, ha⟩ := Algebra.mem_bot.mp hn
      exact ⟨n, a, ha⟩
    · rintro ⟨n, a, ha⟩
      exact ⟨n, Algebra.mem_bot.mpr ⟨a, ha⟩⟩
  have TP : ∀ (a : A) (n : ℕ), a ∉ 𝔭 → a ^ n ∉ 𝔭 := fun a n ha h =>
    ha (hPrime.mem_of_pow_mem n h)
  have NM1 : ∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' 1 := by
    rintro d'' hd'' ⟨π, hπ, x', hx', h1⟩
    obtain ⟨n, c, hc⟩ := (T0 d'' x').mp hx'
    have hπ𝔭 : algebraMap ↥W A π ∈ 𝔭 := hm𝔭 (Ideal.mem_map_of_mem _ hπ)
    have e : algebraMap A K (algebraMap ↥W A π * c) = algebraMap A K (d'' ^ n) := by
      rw [map_mul, hc, map_pow]
      linear_combination (-(algebraMap A K d'' ^ n)) * h1
    have e2 := IsFractionRing.injective A K e
    exact TP d'' n hd'' (e2 ▸ 𝔭.mul_mem_right _ hπ𝔭)
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h1 => hPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  have hLone : ∀ d : A, wcLlsKPLoc A K 0 d 1 := fun d =>
    (T0 _ _).mpr ⟨0, 1, by rw [map_one, pow_zero, one_mul]⟩
  have hOkA : ∀ a : A, wcLlsKPOk W A K 𝔭 (algebraMap A K a) := fun a =>
    ⟨1, algebraMap A K a, 1, h1𝔭, (T0 _ _).mpr ⟨0, a, by rw [pow_zero, one_mul]⟩, hLone 1, NM1,
      mul_one _⟩
  have hne : ∀ d : A, d ∉ 𝔭 → algebraMap A K d ≠ 0 := by
    intro d hd h0
    apply hd
    rw [IsFractionRing.injective A K (h0.trans (map_zero _).symm)]
    exact 𝔭.zero_mem
  have hOkInv : ∀ d : A, d ∉ 𝔭 → wcLlsKPOk W A K 𝔭 (algebraMap A K d)⁻¹ := fun d hd =>
    ⟨d, (algebraMap A K d)⁻¹, 1, hd,
      (T0 _ _).mpr ⟨1, 1, by rw [map_one, pow_one, mul_inv_cancel₀ (hne d hd)]⟩, hLone d, NM1,
      mul_one _⟩

  have hhK := hne h hh
  let φ : Localization.Away h →+* K :=
    IsLocalization.Away.lift h (g := algebraMap A K) (IsUnit.mk0 _ hhK)
  have hφ : ∀ a, φ (algebraMap A (Localization.Away h) a) = algebraMap A K a :=
    fun a => IsLocalization.Away.lift_eq h (IsUnit.mk0 _ hhK) a
  have hφO : ∀ b, φ b ∈ O' := by
    intro b
    obtain ⟨⟨a, y⟩, hb⟩ := IsLocalization.surj (Submonoid.powers h) b
    obtain ⟨k, hk⟩ := y.2
    change b * algebraMap A _ (y : A) = algebraMap A _ a at hb
    rw [← hk] at hb
    have e : φ b * algebraMap A K h ^ k = algebraMap A K a := by
      have := congrArg φ hb
      rwa [map_mul, hφ, hφ, map_pow] at this
    have e2 : φ b = algebraMap A K a * ((algebraMap A K h)⁻¹) ^ k := by
      rw [← e, inv_pow, mul_assoc, mul_inv_cancel₀ (pow_ne_zero _ hhK), mul_one]
    rw [e2]
    exact mul_mem ((hO' _).mpr (hOkA a)) (pow_mem ((hO' _).mpr (hOkInv h hh)) k)
  let φ' : Localization.Away h →+* O' := φ.codRestrict O' hφO
  let I₀ : Ideal O' := Ideal.span {((ℓ : ℕ) : O')}
  let SO : Subring O' :=
    { carrier := {x | S (x : K)}
      mul_mem' := fun {a b} ha hb => hSmul _ _ ha hb
      one_mem' := hS1'
      add_mem' := fun {a b} ha hb => hSadd _ _ ha hb
      zero_mem' := hS0
      neg_mem' := fun {a} ha => hSneg _ ha }
  have hfS : ∀ p : Polynomial ↥W, S (φ (f p)) := by
    intro p
    refine Polynomial.induction_on p ?_ ?_ ?_
    · intro a
      have e : f (Polynomial.C a) = algebraMap A _ (algebraMap ↥W A a) := by
        have := RingHom.congr_fun hfC a
        simp only [RingHom.comp_apply] at this
        exact this
      rw [e, hφ]; exact hS3 a
    · intro p q hp hq
      rw [map_add, map_add]; exact hSadd _ _ hp hq
    · intro n a ih
      rw [pow_succ, ← mul_assoc, map_mul, map_mul, hfX, hφ]
      exact hSmul _ _ ih hSt
  have hyp1 : ∀ p, ((Ideal.Quotient.mk I₀).comp φ') (f p) ∈ SO.map (Ideal.Quotient.mk I₀) :=
    fun p => Subring.mem_map.mpr ⟨φ' (f p), hfS p, rfl⟩
  have hyp2 : ∀ r : O' ⧸ I₀, ∃ τ ∈ SO.map (Ideal.Quotient.mk I₀), IsNilpotent (r - τ) := by
    intro r
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective r
    obtain ⟨s, hs, hM⟩ := hS5 x ((hO' x).mp x.2)
    obtain ⟨N, z, hz, hNz⟩ := hnil _ hM
    refine ⟨Ideal.Quotient.mk I₀ ⟨s, hSO s hs⟩,
      Subring.mem_map.mpr ⟨⟨s, hSO s hs⟩, hs, rfl⟩, N, ?_⟩
    rw [← map_sub, ← map_pow, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton']
    refine ⟨⟨z, hz⟩, Subtype.ext ?_⟩
    push_cast
    rw [hNz, mul_comm]
  have hall := s5 (Polynomial ↥W) (Localization.Away h) (O' ⧸ I₀) f hfet
    ((Ideal.Quotient.mk I₀).comp φ') (SO.map (Ideal.Quotient.mk I₀)) hyp1 hyp2
  have hAS : ∀ a : A, S (algebraMap A K a) := by
    intro a
    obtain ⟨σ, hσ, hσq⟩ := Subring.mem_map.mp (hall (algebraMap A _ a))
    rw [RingHom.comp_apply, Ideal.Quotient.eq, Ideal.mem_span_singleton'] at hσq
    obtain ⟨c, hc⟩ := hσq
    have hc' : (c : K) * ((ℓ : ℕ) : K) = (σ : K) - φ (algebraMap A _ a) :=
      congrArg Subtype.val hc
    rw [← hφ a]
    have e : φ (algebraMap A _ a) = (σ : K) + ((ℓ : ℕ) : K) * (-(c : K)) := by
      linear_combination hc'
    rw [e]
    exact hSadd _ _ hσ (hSε _ (neg_mem c.2))

  rintro x ⟨d, b, s, hd, hLb, hLs, hNM, hxs⟩
  obtain ⟨n, a, ha⟩ := (T0 d b).mp hLb
  obtain ⟨m, a', ha'⟩ := (T0 d s).mp hLs
  have hdK := hne d hd
  have hs0 : s ≠ 0 := by
    rintro rfl
    exact hNM d hd ⟨0, (IsLocalRing.maximalIdeal ↥W).zero_mem, 0,
      (T0 _ _).mpr ⟨0, 0, by simp⟩, by simp⟩
  have hsi : s⁻¹ ∈ O' := (hO' _).mpr ⟨d, 1, s, hd, hLone d, hLs, hNM, inv_mul_cancel₀ hs0⟩
  have hdi : S (algebraMap A K d)⁻¹ := hinv _ (hAS d) hdK ((hO' _).mpr (hOkInv d hd))
  have es : s = algebraMap A K a' * ((algebraMap A K d)⁻¹) ^ m := by
    rw [ha', inv_pow, mul_comm (algebraMap A K d ^ m) s, mul_assoc,
      mul_inv_cancel₀ (pow_ne_zero _ hdK), mul_one]
  have eb : b = algebraMap A K a * ((algebraMap A K d)⁻¹) ^ n := by
    rw [ha, inv_pow, mul_comm (algebraMap A K d ^ n) b, mul_assoc,
      mul_inv_cancel₀ (pow_ne_zero _ hdK), mul_one]
  have hsS : S s := by rw [es]; exact hSmul _ _ (hAS a') (hSpow _ m hdi)
  have hbS : S b := by rw [eb]; exact hSmul _ _ (hAS a) (hSpow _ n hdi)
  have ex : x = b * s⁻¹ := by rw [← hxs, mul_assoc, mul_inv_cancel₀ hs0, mul_one]
  rw [ex]
  exact hSmul _ _ hbS (hinv s hsS hs0 hsi)

theorem wcLlsKP_bcBf_layered_basis : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ((ℓ : ℕ) : K) ≠ 0 →
    ∃ (ι : Type u) (u : ι → K), (∀ j, wcLlsKPOk W A K 𝔭 (u j)) ∧
      (∀ c : Option (ι × ℕ) →₀ ↥W, (∃ i, c i ∉ IsLocalRing.maximalIdeal ↥W) →
        ¬ wcLlsKPOM W A K 𝔭 (c.sum fun i a => algebraMap A K (algebraMap ↥W A a) *
          (Option.elim i 1 fun p => u p.1 ^ (ℓ ^ p.2)))) ∧
      (∀ c : ι →₀ ↥W, (∃ j, c j ∉ IsLocalRing.maximalIdeal ↥W) → ∀ y : K,
        wcLlsKPOk W A K 𝔭 y →
        ¬ wcLlsKPOM W A K 𝔭 ((c.sum fun j a => algebraMap A K (algebraMap ↥W A a) * u j) -
          y ^ ℓ)) ∧
      ∀ x : K, wcLlsKPOk W A K 𝔭 x → ∀ ρ : ↥W, ρ ≠ 0 →
        ∃ (c : Option (ι × ℕ) →₀ ↥W) (y : K), wcLlsKPOk W A K 𝔭 y ∧
          x - (c.sum fun i a => algebraMap A K (algebraMap ↥W A a) *
            (Option.elim i 1 fun p => u p.1 ^ (ℓ ^ p.2))) =
            algebraMap A K (algebraMap ↥W A ρ) * y :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 t hPD ℓ hℓ hΩ hκ hℓK
  obtain ⟨O, hO, -, -, hwO, -, -⟩ := wcLlsKP_bcBf_valring Ω W hW hWt A K 𝔭 t hPD ℓ hℓ hκ hℓK
  obtain ⟨ι, u, hu, hDa, hDb, hX1, hX2, hX3⟩ :=
    wcLlsKPlb_residue_section Ω W hW hWt A K 𝔭 t hPD ℓ hℓ hΩ hκ hℓK
  refine ⟨ι, u, hu, hDa, hDb, ?_⟩
  obtain ⟨B, hBdef⟩ : ∃ B : (Option (ι × ℕ) →₀ ↥W) → K, ∀ c, B c =
      c.sum fun i a => algebraMap A K (algebraMap ↥W A a) *
        (Option.elim i 1 fun p => u p.1 ^ (ℓ ^ p.2)) := ⟨_, fun _ => rfl⟩
  simp only [← hBdef] at hX1 hX2 hX3 ⊢

  have hbO : ∀ i : Option (ι × ℕ), (Option.elim i 1 fun p => u p.1 ^ (ℓ ^ p.2) : K) ∈ O := by
    intro i
    cases i with
    | none => exact O.one_mem
    | some p => exact O.pow_mem ((hO _).mpr (hu p.1)) _
  have hBO : ∀ c, B c ∈ O := by
    intro c
    rw [hBdef]
    unfold Finsupp.sum
    exact sum_mem fun i _ => mul_mem (hwO _) (hbO i)
  have hBadd : ∀ c c', B (c + c') = B c + B c' := by
    intro c c'
    rw [hBdef, hBdef, hBdef]
    exact Finsupp.sum_add_index' (fun _ => by simp) (fun _ _ _ => by simp [add_mul])
  have hBsmul : ∀ (r : ↥W) c, B (r • c) = algebraMap A K (algebraMap ↥W A r) * B c := by
    intro r c
    rw [hBdef, hBdef, Finsupp.sum_smul_index' (fun _ => by simp), Finsupp.mul_sum]
    apply Finsupp.sum_congr
    intro i _
    simp only [smul_eq_mul, map_mul]
    ring
  have hB0 : B 0 = 0 := by rw [hBdef, Finsupp.sum_zero_index]
  have hBsingle : ∀ w : ↥W, B (Finsupp.single none w) = algebraMap A K (algebraMap ↥W A w) := by
    intro w
    rw [hBdef, Finsupp.sum_single_index (by simp)]
    exact mul_one _
  have hℓO : ((ℓ : ℕ) : K) ∈ O := by
    have := hwO ((ℓ : ℕ) : ↥W)
    rwa [map_natCast, map_natCast] at this

  have hall : ∀ x, wcLlsKPOk W A K 𝔭 x → ∃ c y, y ∈ O ∧ x - B c = ((ℓ : ℕ) : K) * y := by
    refine wcLlsKPlb_saturation Ω W hW hWt A K 𝔭 t hPD ℓ hℓ hΩ hκ hℓK
      (fun x => ∃ c y, y ∈ O ∧ x - B c = ((ℓ : ℕ) : K) * y) ?_ ?_ ?_ ?_ ?_ ?_ ?_
    · rintro x ⟨c, y, hy, hxy⟩
      rw [← hO]
      have ex : x = B c + ((ℓ : ℕ) : K) * y := by linear_combination hxy
      rw [ex]
      exact add_mem (hBO c) (mul_mem hℓO hy)
    · intro y hy
      exact ⟨0, y, (hO y).mpr hy, by rw [hB0, sub_zero]⟩
    · intro w
      exact ⟨Finsupp.single none w, 0, O.zero_mem, by rw [hBsingle, sub_self, mul_zero]⟩
    · obtain ⟨c, y, hy, h⟩ := hX2
      exact ⟨c, y, (hO y).mpr hy, h⟩
    · rintro x x' ⟨c, y, hy, h⟩ ⟨c', y', hy', h'⟩
      exact ⟨c + c', y + y', add_mem hy hy', by rw [hBadd]; linear_combination h + h'⟩
    · rintro x x' ⟨c, y, hy, h⟩ ⟨c', y', hy', h'⟩
      obtain ⟨c₃, y₃, hy₃, h₃⟩ := hX3 c c'
      refine ⟨c₃, y₃ + B c * y' + y * B c' + ((ℓ : ℕ) : K) * y * y', ?_, ?_⟩
      · exact add_mem (add_mem (add_mem ((hO _).mpr hy₃) (mul_mem (hBO c) hy'))
          (mul_mem hy (hBO c'))) (mul_mem (mul_mem hℓO hy) hy')
      · linear_combination h₃ + x' * h + (B c + ((ℓ : ℕ) : K) * y) * h'
    · intro x hx
      obtain ⟨c, hc⟩ := hX1 x hx
      exact ⟨B c, ⟨c, 0, O.zero_mem, by rw [sub_self, mul_zero]⟩, hc⟩

  have hpow : ∀ N : ℕ, ∀ x, wcLlsKPOk W A K 𝔭 x →
      ∃ c y, y ∈ O ∧ x - B c = ((ℓ : ℕ) : K) ^ N * y := by
    intro N
    induction N with
    | zero =>
      intro x hx
      exact ⟨0, x, (hO x).mpr hx, by rw [hB0, sub_zero, pow_zero, one_mul]⟩
    | succ N ih =>
      intro x hx
      obtain ⟨c, y, hy, h⟩ := ih x hx
      obtain ⟨c', y', hy', h'⟩ := hall y ((hO y).mp hy)
      refine ⟨c + ((ℓ : ℕ) : ↥W) ^ N • c', y', hy', ?_⟩
      rw [hBadd, hBsmul]
      have e : algebraMap A K (algebraMap ↥W A (((ℓ : ℕ) : ↥W) ^ N)) = ((ℓ : ℕ) : K) ^ N := by
        simp
      rw [e]
      linear_combination h + ((ℓ : ℕ) : K) ^ N * h'

  intro x hx ρ hρ
  have hℓm : ((ℓ : ℕ) : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [← IsLocalRing.residue_eq_zero_iff, map_natCast]
    exact (ringChar.spec _ ℓ).mpr (by rw [hκ])
  obtain ⟨N, π, -, hN⟩ := wcLlsKP_nfb_archimedean Ω W hW _ ρ hℓm hρ
  obtain ⟨c, y, hy, h⟩ := hpow N x hx
  refine ⟨c, algebraMap A K (algebraMap ↥W A π) * y, (hO _).mp (mul_mem (hwO π) hy), ?_⟩
  have e : ((ℓ : ℕ) : K) ^ N =
      algebraMap A K (algebraMap ↥W A ρ) * algebraMap A K (algebraMap ↥W A π) := by
    rw [← map_mul, ← map_mul, ← hN]
    simp
  rw [h, e]
  ring

theorem wcLlsKP_bcBf_normal_form : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    (∀ (x : K) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d x → x ≠ 0 →
      ∃ (π : ↥W) (x' : K) (d' : A), π ≠ 0 ∧ d' ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d' x' ∧
        x = algebraMap A K (algebraMap ↥W A π) * x' ∧
        ∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' x') →
    (∀ (x y : K) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d y →
      (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' x) →
      (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' y) →
      ∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' (x * y)) →
    (∃ O : ValuationSubring K, (∀ y : K, y ∈ O ↔ wcLlsKPOk W A K 𝔭 y) ∧
      (∀ y : K, wcLlsKPOM W A K 𝔭 y ↔ O.valuation y < 1) ∧
      (∀ π : ↥W, π ≠ 0 → algebraMap A K (algebraMap ↥W A π) ≠ 0) ∧
      (∀ π : ↥W, algebraMap A K (algebraMap ↥W A π) ∈ O) ∧
      (∀ π : ↥W, IsUnit π ↔ (algebraMap A K (algebraMap ↥W A π) ∈ O ∧
        (algebraMap A K (algebraMap ↥W A π))⁻¹ ∈ O ∧ π ≠ 0)) ∧
      ∀ x : K, x ≠ 0 → ∃ (π : ↥W) (u : K), π ≠ 0 ∧ u ∈ O ∧ u⁻¹ ∈ O ∧
        (x = algebraMap A K (algebraMap ↥W A π) * u ∨
          x * algebraMap A K (algebraMap ↥W A π) = u)) →
    (∃ (ι : Type u) (u : ι → K), (∀ j, wcLlsKPOk W A K 𝔭 (u j)) ∧
      (∀ c : Option (ι × ℕ) →₀ ↥W, (∃ i, c i ∉ IsLocalRing.maximalIdeal ↥W) →
        ¬ wcLlsKPOM W A K 𝔭 (c.sum fun i a => algebraMap A K (algebraMap ↥W A a) *
          (Option.elim i 1 fun p => u p.1 ^ (ℓ ^ p.2)))) ∧
      (∀ c : ι →₀ ↥W, (∃ j, c j ∉ IsLocalRing.maximalIdeal ↥W) → ∀ y : K,
        wcLlsKPOk W A K 𝔭 y →
        ¬ wcLlsKPOM W A K 𝔭 ((c.sum fun j a => algebraMap A K (algebraMap ↥W A a) * u j) -
          y ^ ℓ)) ∧
      ∀ x : K, wcLlsKPOk W A K 𝔭 x → ∀ ρ : ↥W, ρ ≠ 0 →
        ∃ (c : Option (ι × ℕ) →₀ ↥W) (y : K), wcLlsKPOk W A K 𝔭 y ∧
          x - (c.sum fun i a => algebraMap A K (algebraMap ↥W A a) *
            (Option.elim i 1 fun p => u p.1 ^ (ℓ ^ p.2))) =
            algebraMap A K (algebraMap ↥W A ρ) * y) →
    ((ℓ : ℕ) : K) ≠ 0 →
    ∀ (f₁ r : K) (d₁ : A), d₁ ∉ 𝔭 → wcLlsKPLoc A K 0 d₁ r → f₁ - 1 = (ℓ : K) * r →
    ∀ β : ↥W, β ^ (ℓ - 1) = ((ℓ : ℕ) : ↥W) →
      (∃ h : K,
        (∃ (d : A) (b s : K), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d b ∧ wcLlsKPLoc A K 0 d s ∧
          (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) ∧ h * s = b) ∧
        (∃ (π : ↥W) (y' : K), π ∈ IsLocalRing.maximalIdeal ↥W ∧
          (∃ (d : A) (b s : K), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d b ∧ wcLlsKPLoc A K 0 d s ∧
            (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) ∧ y' * s = b) ∧
          h - 1 = algebraMap A K (algebraMap ↥W A π) * y') ∧
        ∃ y : K,
          (∃ (d : A) (b s : K), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d b ∧ wcLlsKPLoc A K 0 d s ∧
            (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) ∧ y * s = b) ∧
          f₁ - h ^ ℓ = algebraMap A K (algebraMap ↥W A β) ^ ℓ * y) ∨
      ∃ (h : K) (γ : ↥W), γ ≠ 0 ∧
        (∃ (d : A) (b s : K), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d b ∧ wcLlsKPLoc A K 0 d s ∧
          (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) ∧ h * s = b) ∧
        (∃ (π : ↥W) (y' : K), π ∈ IsLocalRing.maximalIdeal ↥W ∧
          (∃ (d : A) (b s : K), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d b ∧ wcLlsKPLoc A K 0 d s ∧
            (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) ∧ y' * s = b) ∧
          h - 1 = algebraMap A K (algebraMap ↥W A π) * y') ∧
        (∃ y : K,
          (∃ (d : A) (b s : K), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d b ∧ wcLlsKPLoc A K 0 d s ∧
            (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) ∧ y * s = b) ∧
          f₁ - h ^ ℓ = algebraMap A K (algebraMap ↥W A γ) ^ ℓ * y) ∧
        ∀ h' : K,
          (∃ (d : A) (b s : K), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d b ∧ wcLlsKPLoc A K 0 d s ∧
            (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) ∧ h' * s = b) →
          ¬ ∃ (π : ↥W) (y : K), π ∈ IsLocalRing.maximalIdeal ↥W ∧
            (∃ (d : A) (b s : K), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d b ∧ wcLlsKPLoc A K 0 d s ∧
              (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) ∧ y * s = b) ∧
            f₁ - h' ^ ℓ = algebraMap A K (algebraMap ↥W A γ) ^ ℓ *
              algebraMap A K (algebraMap ↥W A π) * y :=
by
  have nf_root : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (a : ↥W) (n : ℕ), 0 < n → ∃ z : ↥W, z ^ n = a := by
    intro Ω _ _ W a n hn
    obtain ⟨x, hx⟩ := IsAlgClosed.exists_pow_nat_eq (a : Ω) hn
    rcases W.mem_or_inv_mem x with h | h
    · exact ⟨⟨x, h⟩, Subtype.ext (by simpa using hx)⟩
    · by_cases hx0 : x = 0
      · refine ⟨0, Subtype.ext ?_⟩
        rw [← hx, hx0, zero_pow hn.ne']
        simp [zero_pow hn.ne']
      · have hxW : x ∈ W := by
          have e : x = (a : Ω) * x⁻¹ ^ (n - 1) := by
            rw [← hx, ← pow_sub_one_mul hn.ne' x, inv_pow, mul_comm (x ^ (n - 1)) x, mul_assoc,
              mul_inv_cancel₀ (pow_ne_zero _ hx0), mul_one]
          rw [e]
          exact mul_mem a.2 (pow_mem h _)
        exact ⟨⟨x, hxW⟩, Subtype.ext (by simpa using hx)⟩
  have nf_factor : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ι : Type u) (d : ι →₀ ↥W), d ≠ 0 → ∃ (α : ↥W) (e : ι →₀ ↥W), α ≠ 0 ∧ (∃ j, e j ∉ IsLocalRing.maximalIdeal ↥W) ∧ d = α • e := by
    intro Ω _ W ι d hd
    classical
    have hne : d.support.Nonempty := Finsupp.support_nonempty_iff.mpr hd
    have key : ∀ s : Finset ι, s.Nonempty → ∃ j₀ ∈ s, ∀ j ∈ s, d j₀ ∣ d j := by
      intro s hs
      induction hs using Finset.Nonempty.cons_induction with
      | singleton a =>
        exact ⟨a, Finset.mem_singleton_self a, fun j hj => by rw [Finset.mem_singleton.mp hj]⟩
      | cons a s ha hs ih =>
        obtain ⟨j₁, hj₁, h₁⟩ := ih
        rcases ValuationRing.dvd_total (d a) (d j₁) with h | h
        · refine ⟨a, Finset.mem_cons_self a s, fun j hj => ?_⟩
          rcases Finset.mem_cons.mp hj with rfl | hj
          · exact dvd_rfl
          · exact h.trans (h₁ j hj)
        · refine ⟨j₁, Finset.mem_cons_of_mem hj₁, fun j hj => ?_⟩
          rcases Finset.mem_cons.mp hj with rfl | hj
          · exact h
          · exact h₁ j hj
    obtain ⟨j₀, hj₀, hdiv⟩ := key d.support hne
    have hα : d j₀ ≠ 0 := Finsupp.mem_support_iff.mp hj₀
    choose! e' he' using hdiv
    let e : ι →₀ ↥W := Finsupp.onFinset d.support (fun j => if j ∈ d.support then e' j else 0)
      (by intro j hj; by_contra h; exact hj (by simp [h]))
    refine ⟨d j₀, e, hα, ⟨j₀, ?_⟩, ?_⟩
    · have h1 : e j₀ = e' j₀ := by simp [e, Finsupp.onFinset_apply, hα]
      have h2 : d j₀ * e' j₀ = d j₀ * 1 := by rw [mul_one, ← he' j₀ hj₀]
      have h3 := mul_left_cancel₀ hα h2
      rw [h1, h3]
      exact fun h => (IsLocalRing.mem_maximalIdeal 1).mp h isUnit_one
    · refine Finsupp.ext fun j => ?_
      simp only [Finsupp.smul_apply, smul_eq_mul, e, Finsupp.onFinset_apply]
      split_ifs with hj
      · exact he' j hj
      · rw [mul_zero]; exact Finsupp.notMem_support_iff.mp hj
  have nf_max_core : ∀ (K : Type u) [Field K] (O : ValuationSubring K) (ℓ : ℕ), ℓ.Prime → ∀ (G S E g H : K), G ≠ 0 → H ∈ O → S ∈ O → O.valuation S < 1 → ((ℓ : ℕ) : K) = G ^ (ℓ - 1) * S ^ (ℓ - 1) → g ∈ O → O.valuation (g - E) < 1 → (∀ w : K, w ∈ O → ¬ O.valuation (E - w ^ ℓ) < 1) → ∀ (h' z : K), h' ∈ O → O.valuation z < 1 → h' ^ ℓ - H ^ ℓ ≠ G ^ ℓ * (g - z) := by
    intro K _ O ℓ hℓ G S E g H hG hH hS hSv hL hg hgE hE h' z hh' hz heq
    have hle : ∀ x : K, x ∈ O → O.valuation x ≤ 1 := fun x hx => (O.valuation_le_one_iff x).mpr hx
    have hsm : ∀ a b : K, O.valuation a < 1 → b ∈ O → O.valuation (a * b) < 1 := by
      intro a b ha hb
      rw [Valuation.map_mul]
      exact lt_of_le_of_lt (mul_le_of_le_one_right' (hle b hb)) ha
    have hzO : z ∈ O := (O.valuation_le_one_iff z).mp hz.le
    obtain ⟨m, hm⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, by have := hℓ.two_le; omega⟩
    have hm1 : m ≠ 0 := by have := hℓ.two_le; omega
    have hm' : ℓ - 1 = m := by omega
    rw [hm'] at hL
    obtain ⟨δ, hδ⟩ : ∃ δ, δ = h' - H := ⟨_, rfl⟩
    have hδO : δ ∈ O := by rw [hδ]; exact sub_mem hh' hH
    obtain ⟨U, hUO, hexp⟩ : ∃ U ∈ O, h' ^ ℓ = δ ^ ℓ + H ^ ℓ + ((ℓ : ℕ) : K) * δ * U := by
      refine ⟨H * ∑ k ∈ Finset.Ioo 0 ℓ, δ ^ (k - 1) * H ^ (ℓ - k - 1) * ((ℓ.choose k / ℓ : ℕ) : K),
        mul_mem hH (sum_mem fun k _ => mul_mem (mul_mem (pow_mem hδO _) (pow_mem hH _))
          (natCast_mem O _)), ?_⟩
      have := add_pow_prime_eq hℓ δ H
      rw [hδ, sub_add_cancel] at this
      rw [this, hδ]
      ring
    have hstar : δ ^ ℓ + ((ℓ : ℕ) : K) * δ * U = G ^ ℓ * (g - z) := by
      linear_combination heq - hexp
    have hLG : ((ℓ : ℕ) : K) * G = G ^ ℓ * S ^ m := by rw [hL, hm]; ring
    have hSm : O.valuation (S ^ m) < 1 := by
      rw [map_pow]; exact pow_lt_one₀ zero_le hSv hm1
    rw [hm] at hstar hLG
    by_cases hw : δ / G ∈ O
    ·
      have hδw : δ = G * (δ / G) := by field_simp
      set w := δ / G with hwdef
      have h1 : G ^ (m + 1) * (w ^ (m + 1) + S ^ m * w * U - (g - z)) = 0 := by
        rw [hδw] at hstar
        linear_combination hstar - w * U * hLG
      have h2 : w ^ (m + 1) + S ^ m * w * U - (g - z) = 0 :=
        (mul_eq_zero.mp h1).resolve_left (pow_ne_zero _ hG)
      apply hE w hw
      have e3 : E - w ^ ℓ = (-(g - E) + z) + S ^ m * (w * U) := by
        rw [hm]; linear_combination -h2
      rw [e3]
      refine Valuation.map_add_lt _ (Valuation.map_add_lt _ ?_ hz) (hsm _ _ hSm (mul_mem hw hUO))
      rw [Valuation.map_neg]; exact hgE
    ·
      have hδ0 : δ ≠ 0 := by
        rintro rfl; exact hw (by rw [zero_div]; exact O.zero_mem)
      have hτO : G / δ ∈ O := by
        rcases O.mem_or_inv_mem (δ / G) with h | h
        · exact (hw h).elim
        · rwa [inv_div] at h
      set τ := G / δ with hτdef
      have hτ : δ * τ = G := by rw [hτdef]; field_simp
      have hpow : (δ * τ) ^ (m + 1) = G ^ (m + 1) := by rw [hτ]
      have h1 : G ^ (m + 1) * (1 + S ^ m * τ ^ m * U - τ ^ (m + 1) * (g - z)) = 0 := by
        linear_combination τ ^ (m + 1) * hstar - hpow - τ ^ m * U * hLG -
          τ ^ m * U * (((m + 1 : ℕ) : K)) * hτ
      have h2 : 1 + S ^ m * (τ ^ m * U) = τ ^ (m + 1) * (g - z) := by
        have := (mul_eq_zero.mp h1).resolve_left (pow_ne_zero _ hG)
        linear_combination this
      have hv1 : O.valuation (1 + S ^ m * (τ ^ m * U)) = 1 :=
        Valuation.map_one_add_of_lt _ (hsm _ _ hSm (mul_mem (pow_mem hτO _) hUO))
      have hτv : ¬ O.valuation τ < 1 := by
        intro hlt
        have : O.valuation (τ ^ (m + 1) * (g - z)) < 1 := by
          apply hsm _ _ _ (sub_mem hg hzO)
          rw [map_pow]; exact pow_lt_one₀ zero_le hlt (Nat.succ_ne_zero m)
        rw [← h2, hv1] at this
        exact lt_irrefl _ this
      have hτ1 : O.valuation τ = 1 := le_antisymm (hle τ hτO) (not_lt.mp hτv)
      apply hw
      rw [← inv_div, ← hτdef]
      apply (O.valuation_le_one_iff _).mp
      rw [map_inv₀, hτ1, inv_one]
  have nf_step : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (K : Type u) [Field K] (O : ValuationSubring K) (φ : ↥W →+* K) (ℓ : ℕ), ℓ.Prime → (∀ a : ↥W, φ a ∈ O) → (∀ a : ↥W, ∃ z : ↥W, z ^ ℓ = a) → ∀ β : ↥W, β ^ (ℓ - 1) = ((ℓ : ℕ) : ↥W) → β ≠ 0 → ∀ (R w : K) (c : ↥W), R ∈ O → w ∈ O → ∃ (μ : ↥W) (H q Y : K), H ∈ O ∧ q ∈ O ∧ Y ∈ O ∧ H ^ ℓ = 1 + ((ℓ : ℕ) : K) * q ∧ 1 + ((ℓ : ℕ) : K) * (R + φ c * w ^ ℓ) = H ^ ℓ * (1 + ((ℓ : ℕ) : K) * (R + φ μ * w)) + φ β ^ ℓ * Y := by
    intro Ω _ W K _ O φ ℓ hℓ hφO hroot β hβ hβ0 R w c hR hw
    have h2 := hℓ.two_le
    obtain ⟨lam, hlam⟩ := hroot (((ℓ : ℕ) : ↥W) * c)
    have hexpW : (β ^ (ℓ - 1)) ^ 2 = β ^ ℓ * β ^ (ℓ - 2) := by
      rw [← pow_mul, ← pow_add]; congr 1; omega
    obtain ⟨e₀, he₀⟩ : β ∣ lam ^ 2 := by
      rcases ValuationRing.dvd_total β (lam ^ 2) with h | ⟨t, ht⟩
      · exact h
      · by_cases htu : IsUnit t
        · exact ⟨((htu.unit⁻¹ : (↥W)ˣ) : ↥W), by rw [ht, mul_assoc, htu.mul_val_inv, mul_one]⟩
        · exfalso
          have htm : t ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal t).mpr htu
          have h1 : β ^ ℓ = (lam ^ ℓ) ^ 2 * t ^ ℓ := by rw [ht]; ring
          rw [hlam, ← hβ] at h1
          have h3 : β ^ ℓ * (1 - β ^ (ℓ - 2) * c ^ 2 * t ^ ℓ) = 0 := by
            linear_combination h1 + c ^ 2 * t ^ ℓ * hexpW
          have h4 : 1 - β ^ (ℓ - 2) * c ^ 2 * t ^ ℓ = 0 :=
            (mul_eq_zero.mp h3).resolve_left (pow_ne_zero _ hβ0)
          have h5 : (1 : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
            rw [show (1 : ↥W) = β ^ (ℓ - 2) * c ^ 2 * t ^ ℓ by linear_combination h4]
            exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ htm ℓ hℓ.pos)
          exact (IsLocalRing.mem_maximalIdeal 1).mp h5 isUnit_one
    set L : K := ((ℓ : ℕ) : K) with hLdef
    set B : K := φ β with hBdef
    have hLB : L = B ^ (ℓ - 1) := by rw [hLdef, ← map_natCast φ ℓ, ← hβ, map_pow]
    have hLBl : L * B = B ^ ℓ := by rw [hLB, pow_sub_one_mul hℓ.ne_zero]
    have hL2 : L ^ 2 = B ^ ℓ * B ^ (ℓ - 2) := by
      rw [hLB, ← pow_mul, ← pow_add]; congr 1; omega
    obtain ⟨x, hx⟩ : ∃ x, x = φ lam * w := ⟨_, rfl⟩
    have hxO : x ∈ O := by rw [hx]; exact mul_mem (hφO _) hw
    have hxl : x ^ ℓ = L * φ c * w ^ ℓ := by
      rw [hx, mul_pow, ← map_pow, hlam, map_mul, map_natCast]
    have hLx2 : L * x ^ 2 = B ^ ℓ * φ e₀ * w ^ 2 := by
      rw [hx, mul_pow, ← map_pow, he₀, map_mul, ← hLBl]; ring
    obtain ⟨V, hV⟩ : ∃ V, V = ∑ k ∈ Finset.Ioo 1 ℓ, x ^ (k - 2) * ((ℓ.choose k / ℓ : ℕ) : K) :=
      ⟨_, rfl⟩
    have hVO : V ∈ O := by
      rw [hV]; exact sum_mem fun k _ => mul_mem (pow_mem hxO _) (natCast_mem O _)
    have hIoo : Finset.Ioo 0 ℓ = insert 1 (Finset.Ioo 1 ℓ) := by
      ext k; simp only [Finset.mem_Ioo, Finset.mem_insert]; omega
    have hU : ∑ k ∈ Finset.Ioo 0 ℓ, x ^ (k - 1) * 1 ^ (ℓ - k - 1) * ((ℓ.choose k / ℓ : ℕ) : K)
        = 1 + x * V := by
      rw [hIoo, Finset.sum_insert (by simp), hV]
      congr 1
      · simp [Nat.div_self hℓ.pos]
      · rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun k hk => ?_
        have hk2 : 2 ≤ k := by simp only [Finset.mem_Ioo] at hk; omega
        rw [one_pow, mul_one, show k - 1 = (k - 2) + 1 by omega, pow_succ]
        ring
    have hHexp : (1 + x) ^ ℓ = x ^ ℓ + 1 + L * x * (1 + x * V) := by
      rw [add_comm 1 x, add_pow_prime_eq hℓ x 1, hU]; ring
    obtain ⟨q, hq⟩ : ∃ q, q = φ c * w ^ ℓ + x + x ^ 2 * V := ⟨_, rfl⟩
    have hqO : q ∈ O := by
      rw [hq]; exact add_mem (add_mem (mul_mem (hφO _) (pow_mem hw _)) hxO)
        (mul_mem (pow_mem hxO _) hVO)
    have hHq : (1 + x) ^ ℓ = 1 + L * q := by rw [hHexp, hxl, hq]; ring
    refine ⟨-lam, 1 + x, q, -(φ e₀ * w ^ 2 * V + B ^ (ℓ - 2) * q * (R - x)),
      add_mem (one_mem _) hxO, hqO, ?_, hHq, ?_⟩
    · exact neg_mem (add_mem (mul_mem (mul_mem (hφO _) (pow_mem hw _)) hVO)
        (mul_mem (mul_mem (pow_mem (hφO _) _) hqO) (sub_mem hR hxO)))
    · have hμ : φ (-lam) * w = -x := by rw [map_neg, hx]; ring
      rw [hμ]
      linear_combination (-(1 + L * (R - x))) * hHq - L * hq - V * hLx2 - q * (R - x) * hL2
  have nf_reduce : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (K : Type u) [Field K] (O : ValuationSubring K) (φ : ↥W →+* K) (ℓ : ℕ), ℓ.Prime → (∀ a : ↥W, φ a ∈ O) → (∀ a : ↥W, ∃ z : ↥W, z ^ ℓ = a) → ∀ β : ↥W, β ^ (ℓ - 1) = ((ℓ : ℕ) : ↥W) → β ≠ 0 → (∀ (R w : K) (c : ↥W), R ∈ O → w ∈ O → ∃ (μ : ↥W) (H q Y : K), H ∈ O ∧ q ∈ O ∧ Y ∈ O ∧ H ^ ℓ = 1 + ((ℓ : ℕ) : K) * q ∧ 1 + ((ℓ : ℕ) : K) * (R + φ c * w ^ ℓ) = H ^ ℓ * (1 + ((ℓ : ℕ) : K) * (R + φ μ * w)) + φ β ^ ℓ * Y) → ∀ (ι : Type u) (u : ι → K), (∀ j, u j ∈ O) → (∀ x : K, x ∈ O → ∀ ρ : ↥W, ρ ≠ 0 → ∃ (c : Option (ι × ℕ) →₀ ↥W) (y : K), y ∈ O ∧ x - (c.sum fun i a => φ a * (Option.elim i 1 fun p => u p.1 ^ (ℓ ^ p.2))) = φ ρ * y) → ∀ r : K, r ∈ O → ∃ (H q Y : K) (d : ι →₀ ↥W), H ∈ O ∧ q ∈ O ∧ Y ∈ O ∧ H ^ ℓ = 1 + ((ℓ : ℕ) : K) * q ∧ 1 + ((ℓ : ℕ) : K) * r = H ^ ℓ * (1 + ((ℓ : ℕ) : K) * (d.sum fun j a => φ a * u j)) + φ β ^ ℓ * Y := by
    intro Ω _ W K _ O φ ℓ hℓ hφO hroot β hβ hβ0 hstep ι u hu hD r hr
    classical
    have h2 := hℓ.two_le
    set L : K := ((ℓ : ℕ) : K) with hLdef
    set B : K := φ β with hBdef
    have hLB : L = B ^ (ℓ - 1) := by rw [hLdef, ← map_natCast φ ℓ, ← hβ, map_pow]
    have hLBl : L * B = B ^ ℓ := by rw [hLB, pow_sub_one_mul hℓ.ne_zero]
    have hL2 : L ^ 2 = B ^ ℓ * B ^ (ℓ - 2) := by
      rw [hLB, ← pow_mul, ← pow_add]; congr 1; omega
    have hBO : B ∈ O := hφO β
    have Rrefl : ∀ N : K, wcLlsKPnfRel O ℓ B N N := fun N =>
      ⟨1, 0, 0, one_mem _, zero_mem _, zero_mem _, by simp, by simp⟩
    have Rtrans : ∀ N₁ N₂ N₃ : K, wcLlsKPnfRel O ℓ B N₁ N₂ → wcLlsKPnfRel O ℓ B N₂ N₃ →
        wcLlsKPnfRel O ℓ B N₁ N₃ := by
      rintro N₁ N₂ N₃ ⟨H₁, q₁, Y₁, hH₁, hq₁, hY₁, e₁, f₁⟩ ⟨H₂, q₂, Y₂, hH₂, hq₂, hY₂, e₂, f₂⟩
      refine ⟨H₁ * H₂, q₁ + q₂ + L * q₁ * q₂, H₁ ^ ℓ * Y₂ + Y₁, mul_mem hH₁ hH₂,
        add_mem (add_mem hq₁ hq₂) (mul_mem (mul_mem (natCast_mem O ℓ) hq₁) hq₂),
        add_mem (mul_mem (pow_mem hH₁ _) hY₂) hY₁, ?_, ?_⟩
      · rw [mul_pow]; linear_combination H₂ ^ ℓ * e₁ + (1 + L * q₁) * e₂
      · rw [mul_pow]; linear_combination f₁ + H₁ ^ ℓ * f₂
    have Radd : ∀ N N' M : K, wcLlsKPnfRel O ℓ B N N' → M ∈ O →
        wcLlsKPnfRel O ℓ B (N + M) (N' + M) := by
      rintro N N' M ⟨H, q, Y, hH, hq, hY, e, f⟩ hM
      refine ⟨H, q, Y - B ^ (ℓ - 2) * q * M, hH, hq,
        sub_mem hY (mul_mem (mul_mem (pow_mem hBO _) hq) hM), e, ?_⟩
      linear_combination f - L * M * e - q * M * hL2
    have Rabs : ∀ N N' y : K, y ∈ O → N - N' = B * y → wcLlsKPnfRel O ℓ B N N' := by
      intro N N' y hy h
      refine ⟨1, 0, y, one_mem _, zero_mem _, hy, by simp, ?_⟩
      rw [one_pow]
      linear_combination L * h + y * hLBl
    have Rconst : ∀ (a : ↥W) (D : K), D ∈ O → wcLlsKPnfRel O ℓ B (φ a + D) D := by
      intro a D hDO
      obtain ⟨z, hz⟩ := hroot (1 + ((ℓ : ℕ) : ↥W) * a)
      have hz' : φ z ^ ℓ = 1 + L * φ a := by
        rw [← map_pow, hz, map_add, map_one, map_mul, map_natCast]
      refine ⟨φ z, φ a, -(B ^ (ℓ - 2) * φ a * D), hφO z, hφO a,
        neg_mem (mul_mem (mul_mem (pow_mem hBO _) (hφO a)) hDO), hz', ?_⟩
      linear_combination (-(1 + L * D)) * hz' - φ a * D * hL2
    have Rlayer : ∀ (k : ℕ) (j : ι) (c : ↥W) (R₀ : K), R₀ ∈ O →
        ∃ c' : ↥W, wcLlsKPnfRel O ℓ B (R₀ + φ c * u j ^ (ℓ ^ k)) (R₀ + φ c' * u j) := by
      intro k j
      induction k with
      | zero =>
        intro c R₀ _
        refine ⟨c, ?_⟩
        rw [pow_zero, pow_one]
        exact Rrefl _
      | succ k ih =>
        intro c R₀ hR₀
        have hpow : u j ^ (ℓ ^ (k + 1)) = (u j ^ (ℓ ^ k)) ^ ℓ := by rw [pow_succ, pow_mul]
        obtain ⟨μ, H, q, Y, hH, hq, hY, e, f⟩ := hstep R₀ (u j ^ (ℓ ^ k)) c hR₀ (pow_mem (hu j) _)
        obtain ⟨c', hc'⟩ := ih μ R₀ hR₀
        refine ⟨c', Rtrans _ _ _ ?_ hc'⟩
        rw [hpow]
        exact ⟨H, q, Y, hH, hq, hY, e, f⟩
    have hUsumO : ∀ d : ι →₀ ↥W, (d.sum fun j a => φ a * u j) ∈ O := by
      intro d
      unfold Finsupp.sum
      exact sum_mem fun j _ => mul_mem (hφO _) (hu j)
    have NF : ∀ c : Option (ι × ℕ) →₀ ↥W, ∃ d : ι →₀ ↥W,
        wcLlsKPnfRel O ℓ B (c.sum fun i a => φ a * (Option.elim i 1 fun p => u p.1 ^ (ℓ ^ p.2)))
          (d.sum fun j a => φ a * u j) := by
      intro c
      induction c using Finsupp.induction with
      | zero =>
        refine ⟨0, ?_⟩
        rw [Finsupp.sum_zero_index, Finsupp.sum_zero_index]
        exact Rrefl 0
      | single_add i b f _ _ ih =>
        obtain ⟨df, hdf⟩ := ih
        rw [Finsupp.sum_add_index' (fun _ => by simp) (fun _ _ _ => by simp [add_mul]),
          Finsupp.sum_single_index (by simp)]
        have hM : φ b * (Option.elim i 1 fun p => u p.1 ^ (ℓ ^ p.2)) ∈ O := by
          refine mul_mem (hφO b) ?_
          cases i with
          | none => exact one_mem _
          | some p => exact pow_mem (hu p.1) _
        have h1 := Radd _ _ _ hdf hM
        rw [add_comm (φ b * _)]
        cases i with
        | none =>
          refine ⟨df, Rtrans _ _ _ h1 ?_⟩
          simp only [Option.elim, mul_one]
          rw [add_comm]
          exact Rconst b _ (hUsumO df)
        | some p =>
          obtain ⟨c', hc'⟩ := Rlayer p.2 p.1 b _ (hUsumO df)
