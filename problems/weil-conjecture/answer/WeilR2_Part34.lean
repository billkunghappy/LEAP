    fun f => LaurentPolynomial.invert.symm_apply_apply f
  have hker : ∀ z, θ z = 0 ↔ z ∈ E := by
    intro z
    rw [hθ, EmbeddingLike.map_eq_zero_iff, EmbeddingLike.map_eq_zero_iff,
      Ideal.Quotient.eq_zero_iff_mem, ← h𝔎I, Ideal.mem_comap]
  have hcst : ∀ w : ↥W, θ (wcIccCst W A K L (wcIcxRI W A K u a' b) w) =
