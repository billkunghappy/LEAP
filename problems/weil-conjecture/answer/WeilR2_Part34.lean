  have hnb := wcpa_dj_llsm_brsp_node_not_bad W _ 𝔓.asIdeal ζ _ _ e hζm he hPm f hfC hf0 hf1 hfet hmap

  have heq := wcpa_dj_lr1k_llfi_ringequiv _ _ Φ
  intro hbad
  apply hnb
  change ¬ (wcpaDjLkDelta (wcLlsKPbdsFib W _ 𝔓.asIdeal) = 0 ∨
    (wcpaDjLkDelta (wcLlsKPbdsFib W _ 𝔓.asIdeal) = 1 ∧
      wcpaDjLkBranches (wcLlsKPbdsFib W _ 𝔓.asIdeal) = 2))
