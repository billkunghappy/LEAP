  obtain ⟨φo, hφos, hφok, hφof⟩ := gen _ _ (wcIcxIncl L _ _ hRo) _ y₀ Qo 𝔷o hQoy h𝔷oQ hIo hcono
  obtain ⟨φI, hφIs, hφIk, hφIf⟩ := gen _ _ (wcIcxIncl L _ _ hRI) _ y₀ QI 𝔷I hQIy h𝔷IQ hII hconI
  have final : ∀ (B : Type u) [CommRing B] (y : Ideal B) [y.IsPrime] (I : Ideal B)
      (D₁ D₂ : Type u) [CommRing D₁] [IsDomain D₁] [IsDiscreteValuationRing D₁]
