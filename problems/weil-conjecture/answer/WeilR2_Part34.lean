      (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A] (𝔭 : Ideal A),
      Algebra.FiniteType ↥W A → 𝔭.IsMaximal →
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 →
      ∀ a : A, ∃ w : ↥W, a - algebraMap ↥W A w ∈ 𝔭 := by
    intro Ω _ _ W A _ _ 𝔭 hFT h𝔭 hm a
    have T1 : IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
      apply IsAlgClosed.of_exists_root
      intro p hpmon hpirr
      have hlift : p ∈ Polynomial.lifts (IsLocalRing.residue ↥W) := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro n
        exact IsLocalRing.residue_surjective _
      obtain ⟨q, hqmap, hqdeg, hqmon⟩ :=
        Polynomial.lifts_and_natDegree_eq_and_monic hlift hpmon
      have hpdeg : 0 < p.natDegree := hpirr.natDegree_pos
      set j : ↥W →+* Ω := algebraMap ↥W Ω with hj
      have hQmon : (q.map j).Monic := hqmon.map j
      have hQdeg : (q.map j).natDegree = q.natDegree := hqmon.natDegree_map j
      have hQd : (q.map j).degree ≠ 0 := by
        rw [Polynomial.degree_eq_natDegree hQmon.ne_zero, hQdeg, hqdeg]
        exact_mod_cast hpdeg.ne'
      obtain ⟨z, hz⟩ := IsAlgClosed.exists_root (q.map j) hQd
      have hzint : _root_.IsIntegral ↥W z := by
        refine ⟨q, hqmon, ?_⟩
        rw [Polynomial.IsRoot, Polynomial.eval_map] at hz
        exact hz
      obtain ⟨y, hy⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hzint
      have hqy : q.eval y = 0 := by
        apply (IsFractionRing.injective ↥W Ω)
        rw [map_zero, ← Polynomial.eval_map_apply]
        rw [hy]
        exact hz
      refine ⟨IsLocalRing.residue ↥W y, ?_⟩
      rw [← hqmap, Polynomial.eval_map_apply, hqy, map_zero]
    have T2 : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
        [IsAlgClosed (IsLocalRing.ResidueField R)] (k : Type u) [Field k] (ρ : R →+* k),
        IsLocalHom ρ → ρ.FiniteType → Function.Surjective ρ := by
      intro R _ _ _ k _ ρ hloc hρFT
      set ψ := IsLocalRing.ResidueField.lift ρ with hψ
      have hψr : ψ.comp (IsLocalRing.residue R) = ρ :=
        IsLocalRing.ResidueField.lift_comp_residue ρ
      have hψFT : ψ.FiniteType := by
        rw [← hψr] at hρFT
        exact RingHom.FiniteType.of_comp_finiteType hρFT
      have hψfin : ψ.Finite := (RingHom.finite_iff_finiteType_of_isJacobsonRing).mpr hψFT
      have hψsurj : Function.Surjective ψ :=
        (IsAlgClosed.ringHom_bijective_of_isIntegral ψ hψfin.to_isIntegral).2
      rw [← hψr]
      exact hψsurj.comp (IsLocalRing.residue_surjective)
    have := h𝔭
    letI : Field (A ⧸ 𝔭) := Ideal.Quotient.field 𝔭
    let ρ : ↥W →+* A ⧸ 𝔭 := (Ideal.Quotient.mk 𝔭).comp (algebraMap ↥W A)
    have hloc : IsLocalHom ρ := by
      refine ⟨fun x hx => ?_⟩
      by_contra hxu
      have hxm : x ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal x).mpr hxu
      have h1 : algebraMap ↥W A x ∈ 𝔭 := hm (Ideal.mem_map_of_mem _ hxm)
      have h2 : ρ x = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr h1
      rw [h2] at hx
      exact not_isUnit_zero hx
    have hρFT : ρ.FiniteType :=
      RingHom.FiniteType.comp_surjective (RingHom.finiteType_algebraMap.mpr hFT)
        Ideal.Quotient.mk_surjective
    obtain ⟨w, hw⟩ := T2 ↥W (A ⧸ 𝔭) ρ hloc hρFT (Ideal.Quotient.mk 𝔭 a)
    refine ⟨w, ?_⟩
    exact Ideal.Quotient.eq.mp hw.symm


  have LI : ∀ (κ : Type u) [Field κ] (f : LaurentPolynomial κ)
      (q : Polynomial (Polynomial κ)), q.Monic → (q.map Polynomial.toLaurent).eval f = 0 →
      ∃ p : Polynomial κ, Polynomial.toLaurent p = f := by
    intro κ _ f q hq hev
    have hE : ∑ i ∈ Finset.range (q.natDegree + 1),
        Polynomial.toLaurent (q.coeff i) * f ^ i = 0 := by
      rw [Polynomial.eval_map, Polynomial.eval₂_eq_sum_range] at hev
      exact hev
    have key : ∀ (n : ℕ) (f' : Polynomial κ), 1 ≤ n →
        Polynomial.toLaurent f' = f * LaurentPolynomial.T (n : ℤ) → f'.coeff 0 = 0 := by
      intro n f' hn hf'
      have htX : Polynomial.toLaurent ((Polynomial.X : Polynomial κ) ^ n) =
          LaurentPolynomial.T (n : ℤ) := Polynomial.toLaurent_X_pow n
      have hPL : Polynomial.toLaurent (∑ i ∈ Finset.range (q.natDegree + 1),
          q.coeff i * f' ^ i * ((Polynomial.X : Polynomial κ) ^ n) ^ (q.natDegree - i)) =
          LaurentPolynomial.T (n : ℤ) ^ q.natDegree * ∑ i ∈ Finset.range (q.natDegree + 1),
            Polynomial.toLaurent (q.coeff i) * f ^ i := by
        rw [map_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i hi => ?_)
        have hi' : i ≤ q.natDegree := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [map_mul, map_mul, map_pow, map_pow, htX, hf',
          ← pow_mul_pow_sub (LaurentPolynomial.T (n : ℤ)) hi']
        ring
      rw [hE, mul_zero] at hPL
      have hP0 : (∑ i ∈ Finset.range (q.natDegree + 1),
          q.coeff i * f' ^ i * ((Polynomial.X : Polynomial κ) ^ n) ^ (q.natDegree - i)) = 0 :=
        Polynomial.toLaurent_injective (by rw [hPL, map_zero])
      have hev0 := congrArg (Polynomial.eval (0 : κ)) hP0
      rw [Polynomial.eval_finsetSum, Finset.sum_range_succ, Finset.sum_eq_zero] at hev0
      · rw [Nat.sub_self, pow_zero, mul_one, hq.coeff_natDegree, one_mul, zero_add,
          Polynomial.eval_pow, Polynomial.eval_zero] at hev0
        rw [Polynomial.coeff_zero_eq_eval_zero]
        exact _root_.IsReduced.eq_zero _ ⟨q.natDegree, hev0⟩
      · intro i hi
        have hi' : i < q.natDegree := Finset.mem_range.mp hi
        have h1 : q.natDegree - i ≠ 0 := by omega
        have h2 : n ≠ 0 := by omega
        simp [Polynomial.eval_mul, Polynomial.eval_pow, h1, h2, zero_pow]
    have peel : ∀ (n : ℕ) (f' : Polynomial κ),
        Polynomial.toLaurent f' = f * LaurentPolynomial.T (n : ℤ) →
        ∃ p : Polynomial κ, Polynomial.toLaurent p = f := by
      intro n
      induction n with
      | zero => intro f' hf'; exact ⟨f', by simpa using hf'⟩
      | succ m ih =>
        intro f' hf'
        have h0 := key (m + 1) f' (by omega) hf'
        obtain ⟨g, hg⟩ := Polynomial.X_dvd_iff.mpr h0
        apply ih g
        have h1 : Polynomial.toLaurent g * LaurentPolynomial.T 1 =
            (f * LaurentPolynomial.T (m : ℤ)) * LaurentPolynomial.T 1 := by
          rw [mul_comm, ← Polynomial.toLaurent_X, ← map_mul, ← hg, hf', mul_assoc,
            Polynomial.toLaurent_X, ← LaurentPolynomial.T_add, Nat.cast_succ]
        exact (LaurentPolynomial.isUnit_T 1).mul_left_inj.mp h1
    obtain ⟨n, f', hf'⟩ := LaurentPolynomial.exists_T_pow f
    exact peel n f' hf'


  have SH : ∀ (A : Type u) [CommRing A] (K : Type u) [Field K] [Algebra A K] (L : Type u)
      [Field L] [Algebra K L] (y : K) (S R : Subalgebra A K), S ≤ R → y ∈ S →
      (∀ r ∈ R, ∃ m : ℕ, y ^ m * r ∈ S) →
      ∀ γ : L, IsIntegral R γ → ∃ n : ℕ, IsIntegral S (algebraMap K L y ^ n * γ) := by
    intro A _ K _ _ L _ _ y S R hSR hyS hcl γ hγ
    obtain ⟨p, hpm, hp⟩ := hγ
    choose m hm using fun i => hcl (p.coeff i : K) (p.coeff i).2
    obtain ⟨d, hd⟩ : ∃ d, d = p.natDegree := ⟨_, rfl⟩
    obtain ⟨M, hM⟩ : ∃ M, M = ∑ i ∈ Finset.range (d + 1), m i := ⟨_, rfl⟩
    let s : R := ⟨y ^ M, hSR (S.pow_mem hyS M)⟩
    let ι : S →+* R := (Subalgebra.inclusion hSR).toRingHom
    have hfι : (algebraMap R L).comp ι = algebraMap S L := RingHom.ext fun _ => rfl
    have hq0 : Polynomial.eval₂ (algebraMap R L) (algebraMap R L s * γ) (p.scaleRoots s) = 0 :=
      Polynomial.scaleRoots_eval₂_eq_zero _ hp
    have hlifts : p.scaleRoots s ∈ Polynomial.lifts ι := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [Polynomial.coeff_scaleRoots, ← hd]
      rcases lt_trichotomy i d with hi | hi | hi
      · have hmi : m i ≤ M := by
          rw [hM]
          exact Finset.single_le_sum (fun j _ => Nat.zero_le (m j))
            (Finset.mem_range.mpr (by omega))
        have hle : m i ≤ M * (d - i) := le_trans hmi (Nat.le_mul_of_pos_right M (by omega))
        refine ⟨⟨y ^ (M * (d - i) - m i) * (y ^ m i * (p.coeff i : K)),
          S.mul_mem (S.pow_mem hyS _) (hm i)⟩, ?_⟩
        apply Subtype.ext
        show y ^ (M * (d - i) - m i) * (y ^ m i * (p.coeff i : K)) =
          ((p.coeff i * s ^ (d - i) : R) : K)
        rw [Subalgebra.coe_mul, SubmonoidClass.coe_pow]
        show _ = (p.coeff i : K) * (y ^ M) ^ (d - i)
        rw [← pow_mul, ← mul_assoc, ← pow_add, Nat.sub_add_cancel hle]
        ring
      · rw [hi, Nat.sub_self, pow_zero, mul_one]
        have h1 : p.coeff d = 1 := by rw [hd]; exact hpm
        rw [h1]
        exact ⟨1, map_one ι⟩
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), zero_mul]
        exact ⟨0, map_zero ι⟩
    have hqm : (p.scaleRoots s).Monic := by
      unfold Polynomial.Monic
      rw [Polynomial.leadingCoeff_scaleRoots]
      exact hpm
    obtain ⟨Q, hQmap, -, hQm⟩ :=
      Polynomial.lifts_and_degree_eq_and_monic hlifts hqm
    refine ⟨M, Q, hQm, ?_⟩
    have hs : algebraMap R L s = algebraMap K L y ^ M := by
      rw [← map_pow]; rfl
    rw [← hfι, ← Polynomial.eval₂_map, hQmap, ← hs]
    exact hq0


  have CORE : ∀ (κ : Type u) [Field κ] (C : Type u) [CommRing C]
      (θ : C →+* LaurentPolynomial κ) (Qo Ps Pu : Ideal C) (yo : C) (c : κ) (k : ℕ),
      Qo.IsPrime → Pu ≤ Qo → Ps ≤ Qo → yo ∈ Ps → c ≠ 0 → 1 ≤ k →
      θ yo = LaurentPolynomial.C c * LaurentPolynomial.T (k : ℤ) →
      (∀ z : C, θ z = 0 ↔ z ∈ Pu) →
      (∀ z : C, ∃ q : Polynomial κ, θ z = Polynomial.toLaurent q) →
      (∀ f : LaurentPolynomial κ, ∃ (n : ℕ) (z : C),
        θ z = (LaurentPolynomial.C c * LaurentPolynomial.T (k : ℤ)) ^ n * f) →
      (∀ a : κ, ∃ e : C, θ e = LaurentPolynomial.C a) →
      (∀ M : Ideal C, M.IsMaximal → Pu ≤ M → yo ∈ M → M = Qo) →
      (∀ z ∈ Qo, ∃ σ ∉ Qo, ∃ a ∈ Pu, ∃ β ∈ Ps, σ * z = a + β) →
      (∀ (t d : C) (n : ℕ) (cs : ℕ → C), d ∉ Pu → 0 < n →
        t ^ n + ∑ i ∈ Finset.range n, cs i * t ^ i * d ^ (n - i) ∈ Pu →
        ∃ σ ∉ Qo, ∃ r, σ * t - r * d ∈ Pu) →
      ∃ η ∈ Ps, θ η = LaurentPolynomial.T 1 ∧
        ∀ z : C, ∃ (a : κ) (r : C), θ (z - η * r) = LaurentPolynomial.C a := by
    intro κ _ C _ θ Qo Ps Pu yo c k hQ hPuQ hPsQ hyo hc hk hθy hker h1 h2 h3 h5 hT hN
    have hCu : IsUnit (LaurentPolynomial.C c : LaurentPolynomial κ) :=
      (IsUnit.mk0 c hc).map LaurentPolynomial.C
    have hCinv : (LaurentPolynomial.C c⁻¹ : LaurentPolynomial κ) * LaurentPolynomial.C c = 1 := by
      rw [← map_mul, inv_mul_cancel₀ hc, map_one]
    have hT1k : (LaurentPolynomial.T 1 : LaurentPolynomial κ) ^ k =
        LaurentPolynomial.T (k : ℤ) := by
      rw [LaurentPolynomial.T_pow, mul_one]
    obtain ⟨e', he'⟩ := h3 c⁻¹
    obtain ⟨e, he⟩ := h3 c
    obtain ⟨U, hUdef⟩ : ∃ U : LaurentPolynomial κ,
        U = LaurentPolynomial.C c * LaurentPolynomial.T (k : ℤ) := ⟨_, rfl⟩
    have hU : IsUnit U := hUdef ▸ hCu.mul (LaurentPolynomial.isUnit_T _)
    rw [← hUdef] at hθy h2
    have hCU : (LaurentPolynomial.C c⁻¹ : LaurentPolynomial κ) * U =
        LaurentPolynomial.T (k : ℤ) := by
      rw [hUdef, ← mul_assoc, hCinv, one_mul]

    obtain ⟨n₀, t, ht⟩ := h2 (LaurentPolynomial.T 1)
    have hd : yo ^ n₀ ∉ Pu := by
      intro hd
      have h0 := (hker _).mpr hd
      rw [map_pow, hθy] at h0
      exact (hU.pow n₀).ne_zero h0
    have hsum : ∑ i ∈ Finset.range k,
        (fun i : ℕ => if i = 0 then -(e' * yo) else 0) i * t ^ i * (yo ^ n₀) ^ (k - i)
        = -(e' * yo) * (yo ^ n₀) ^ k := by
      rw [Finset.sum_eq_single 0]
      · simp
      · intro b _ hb
        simp [hb]
      · intro h
        exact absurd (Finset.mem_range.mpr (by omega)) h
    have hmem : t ^ k + ∑ i ∈ Finset.range k,
        (fun i : ℕ => if i = 0 then -(e' * yo) else 0) i * t ^ i * (yo ^ n₀) ^ (k - i) ∈ Pu := by
      rw [hsum]
      apply (hker _).mp
      rw [map_add, map_mul, map_neg, map_mul, map_pow, map_pow, map_pow, ht, he', hθy, mul_pow,
        hT1k, ← hCU]
      ring
    obtain ⟨σ, hσ, r, hr⟩ := hN t (yo ^ n₀) k _ hd (by omega) hmem
    have hσT : θ σ * LaurentPolynomial.T 1 = θ r := by
      have h0 := (hker _).mpr hr
      rw [map_sub, map_mul, map_mul, map_pow, ht, hθy, sub_eq_zero] at h0
      apply (hU.pow n₀).mul_left_inj.mp
      linear_combination h0
    let J : Ideal C :=
      { carrier := {z | ∃ r, θ z * LaurentPolynomial.T 1 = θ r}
        add_mem' := by
          rintro a b ⟨r1, hr1⟩ ⟨r2, hr2⟩
          exact ⟨r1 + r2, by rw [map_add, map_add, add_mul, hr1, hr2]⟩
        zero_mem' := ⟨0, by simp⟩
        smul_mem' := by
          rintro a b ⟨r, hr⟩
          exact ⟨a * r, by rw [smul_eq_mul, map_mul, map_mul, mul_assoc, hr]⟩ }
    have hJmem : ∀ z, z ∈ J ↔ ∃ r, θ z * LaurentPolynomial.T 1 = θ r := fun z => Iff.rfl
    have hJtop : J = ⊤ := by
      by_contra hne
      obtain ⟨M, hM, hJM⟩ := Ideal.exists_le_maximal J hne
      have hPuM : Pu ≤ M := by
        intro z hz
        apply hJM
        rw [hJmem]
        exact ⟨0, by rw [(hker z).mpr hz, zero_mul, map_zero]⟩
      have hyoM' : yo ^ n₀ ∈ M := hJM ((hJmem _).mpr ⟨t, by rw [map_pow, hθy, ht]⟩)
      have hyoM : yo ∈ M := hM.isPrime.mem_of_pow_mem n₀ hyoM'
      have hMQ := h5 M hM hPuM hyoM
      have hσM : σ ∈ M := hJM ((hJmem _).mpr ⟨r, hσT⟩)
      rw [hMQ] at hσM
      exact hσ hσM
    have h1J : (1 : C) ∈ J := by rw [hJtop]; exact Submodule.mem_top
    obtain ⟨t₁, ht₁'⟩ := (hJmem 1).mp h1J
    have ht₁ : θ t₁ = LaurentPolynomial.T 1 := by rw [← ht₁', map_one, one_mul]

    have onto : ∀ p : Polynomial κ, ∃ r : C, θ r = Polynomial.toLaurent p := by
      intro p
      refine Polynomial.induction_on' p ?_ ?_
      · rintro p q ⟨r1, hr1⟩ ⟨r2, hr2⟩
        exact ⟨r1 + r2, by rw [map_add, map_add, hr1, hr2]⟩
      · intro n a
        obtain ⟨ea, hea⟩ := h3 a
        refine ⟨ea * t₁ ^ n, ?_⟩
        rw [map_mul, map_pow, hea, ht₁, LaurentPolynomial.T_pow, mul_one,
          ← Polynomial.C_mul_X_pow_eq_monomial, Polynomial.toLaurent_C_mul_X_pow]

    have h0 : yo - e * t₁ ^ k ∈ Pu := (hker _).mp (by
      rw [map_sub, map_mul, map_pow, he, ht₁, hT1k, hθy, hUdef, sub_self])
    have h0' : e * t₁ ^ k ∈ Qo := by
      have := Qo.sub_mem (hPsQ hyo) (hPuQ h0)
      rwa [sub_sub_cancel] at this
    have heQ : e ∉ Qo := by
      intro heQ
      have h1' : e * e' - 1 ∈ Pu := (hker _).mp (by
        rw [map_sub, map_mul, he, he', map_one, ← map_mul, mul_inv_cancel₀ hc, map_one, sub_self])
      have := Qo.sub_mem (Qo.mul_mem_right e' heQ) (hPuQ h1')
      rw [sub_sub_cancel] at this
      exact hQ.ne_top ((Ideal.eq_top_iff_one _).mpr this)
    have ht1Q : t₁ ∈ Qo := hQ.mem_of_pow_mem k ((hQ.mem_or_mem h0').resolve_left heQ)
    obtain ⟨σ', hσ', a, ha, β, hβ, hσβ⟩ := hT t₁ ht1Q
    have hθβ : θ β = θ σ' * LaurentPolynomial.T 1 := by
      have := congrArg θ hσβ
      rw [map_mul, map_add, (hker a).mpr ha, zero_add, ht₁] at this
      exact this.symm
    obtain ⟨s, hs⟩ := h1 σ'
    have hXs : ¬ (Polynomial.X : Polynomial κ) ∣ s := by
      rintro ⟨s', rfl⟩
      obtain ⟨r', hr'⟩ := onto s'
      have hmem' : σ' - t₁ * r' ∈ Pu := (hker _).mp (by
        rw [map_sub, map_mul, hs, ht₁, hr', map_mul, Polynomial.toLaurent_X, sub_self])
      apply hσ'
      have := Qo.add_mem (hPuQ hmem') (Qo.mul_mem_right r' ht1Q)
      rwa [sub_add_cancel] at this
    have hcop : IsCoprime (Polynomial.X : Polynomial κ) s :=
      (Polynomial.irreducible_X.coprime_iff_not_dvd).mpr hXs
    obtain ⟨α, β', hαβ⟩ := hcop.pow_left (m := k - 1)
    obtain ⟨rα, hrα⟩ := onto α
    obtain ⟨rβ, hrβ⟩ := onto β'
    have hTk : (LaurentPolynomial.T (k : ℤ) : LaurentPolynomial κ) =
        Polynomial.toLaurent (Polynomial.X ^ (k - 1)) * LaurentPolynomial.T 1 := by
      have hk' : (k : ℤ) = ((k - 1 : ℕ) : ℤ) + 1 := by omega
      rw [hk', LaurentPolynomial.T_add, Polynomial.toLaurent_X_pow]
    have hαβL := congrArg Polynomial.toLaurent hαβ
    rw [map_add, map_mul, map_mul, map_one] at hαβL
    have hη : θ (rα * e' * yo + rβ * β) = LaurentPolynomial.T 1 := by
      rw [map_add, map_mul, map_mul, map_mul, hrα, he', hθy, hθβ, hs, hrβ, hUdef, hTk]
      linear_combination
        (Polynomial.toLaurent α * Polynomial.toLaurent (Polynomial.X ^ (k - 1)) *
          LaurentPolynomial.T 1) * hCinv + LaurentPolynomial.T 1 * hαβL
    refine ⟨rα * e' * yo + rβ * β, Ps.add_mem (Ps.mul_mem_left _ hyo) (Ps.mul_mem_left _ hβ),
      hη, ?_⟩
    intro z
    obtain ⟨q, hq⟩ := h1 z
    obtain ⟨rq, hrq⟩ := onto q.divX
    refine ⟨q.coeff 0, rq, ?_⟩
    have hq' := congrArg Polynomial.toLaurent (Polynomial.divX_mul_X_add q)
    rw [map_add, map_mul, Polynomial.toLaurent_X, Polynomial.toLaurent_C] at hq'
    rw [map_sub, map_mul, hη, hq, hrq]
    linear_combination -hq'


  have PD : ∀ (κ : Type u) [Field κ] (C : Type u) [CommRing C] (θ : C →+* LaurentPolynomial κ)
      (x : C) (c : κ) (k : ℕ), c ≠ 0 → 1 ≤ k →
      θ x = LaurentPolynomial.C c * LaurentPolynomial.T (k : ℤ) →
      (∀ a : κ, ∃ e : C, θ e = LaurentPolynomial.C a) →
      ∀ (z : C) (p : Polynomial κ), θ z = Polynomial.toLaurent (Polynomial.X * p) →
      ∃ (M : ℕ) (y : C), 0 < M ∧ θ z ^ M = θ x * θ y := by
    intro κ _ C _ θ x c k hc hk hθx h3 z p hz
    have hτ : (LaurentPolynomial.T (k : ℤ) : LaurentPolynomial κ) =
        LaurentPolynomial.C c⁻¹ * θ x := by
      rw [hθx, ← mul_assoc, ← map_mul, inv_mul_cancel₀ hc, map_one, one_mul]
    have hTmem : (LaurentPolynomial.T (k : ℤ) : LaurentPolynomial κ) ∈
        Algebra.adjoin κ {(LaurentPolynomial.T (k : ℤ) : LaurentPolynomial κ)} :=
      Algebra.subset_adjoin rfl
    have hT1 : IsIntegral (Algebra.adjoin κ {(LaurentPolynomial.T (k : ℤ) : LaurentPolynomial κ)})
        (LaurentPolynomial.T 1 : LaurentPolynomial κ) := by
      refine ⟨Polynomial.X ^ k - Polynomial.C ⟨LaurentPolynomial.T (k : ℤ), hTmem⟩,
        Polynomial.monic_X_pow_sub_C _ (by omega), ?_⟩
      simp [LaurentPolynomial.T_pow]
    have hCa : ∀ a : κ, IsIntegral
        (Algebra.adjoin κ {(LaurentPolynomial.T (k : ℤ) : LaurentPolynomial κ)})
        (LaurentPolynomial.C a : LaurentPolynomial κ) := fun a =>
      isIntegral_algebraMap (R := Algebra.adjoin κ
        {(LaurentPolynomial.T (k : ℤ) : LaurentPolynomial κ)})
        (A := LaurentPolynomial κ) (x := algebraMap κ _ a)
    have hpolyint : ∀ q : Polynomial κ, IsIntegral
        (Algebra.adjoin κ {(LaurentPolynomial.T (k : ℤ) : LaurentPolynomial κ)})
        (Polynomial.toLaurent q) := by
      intro q
      refine Polynomial.induction_on' q ?_ ?_
      · intro p q hp hq
        rw [map_add]
        exact hp.add hq
      · intro n a
        rw [← Polynomial.C_mul_X_pow_eq_monomial, Polynomial.toLaurent_C_mul_X_pow]
        have e : (LaurentPolynomial.T (n : ℤ) : LaurentPolynomial κ) =
            LaurentPolynomial.T 1 ^ n := by
          rw [LaurentPolynomial.T_pow, mul_one]
        rw [e]
        exact (hCa a).mul (hT1.pow n)
    have hBR : ∀ v ∈ Algebra.adjoin κ {(LaurentPolynomial.T (k : ℤ) : LaurentPolynomial κ)},
        v ∈ θ.range := by
      intro v hv
      induction hv using Algebra.adjoin_induction with
      | mem v hv =>
        rw [Set.mem_singleton_iff] at hv
        obtain ⟨e', he'⟩ := h3 c⁻¹
        exact RingHom.mem_range.mpr ⟨e' * x, by rw [map_mul, he', hv, hτ]⟩
      | algebraMap a =>
        obtain ⟨e, he⟩ := h3 a
        exact RingHom.mem_range.mpr ⟨e, he⟩
      | add v w _ _ hv hw => exact add_mem hv hw
      | mul v w _ _ hv hw => exact mul_mem hv hw
    obtain ⟨Q, hQm, hQ⟩ := hpolyint (p ^ k)
    have hsum := hQ
    rw [Polynomial.eval₂_eq_sum_range, Finset.sum_range_succ, hQm.coeff_natDegree, map_one,
      one_mul] at hsum
    have hm0 : Q.natDegree ≠ 0 := by
      intro h0
      rw [h0, Finset.sum_range_zero, pow_zero, zero_add] at hsum
      exact one_ne_zero hsum
    have hfk : θ z ^ k = LaurentPolynomial.T (k : ℤ) * Polynomial.toLaurent (p ^ k) := by
      rw [hz, map_mul, Polynomial.toLaurent_X, mul_pow, map_pow, LaurentPolynomial.T_pow, mul_one]
    have hhN : Polynomial.toLaurent (p ^ k) ^ Q.natDegree =
        -∑ i ∈ Finset.range Q.natDegree,
          algebraMap (Algebra.adjoin κ {(LaurentPolynomial.T (k : ℤ) : LaurentPolynomial κ)})
            (LaurentPolynomial κ) (Q.coeff i) * Polynomial.toLaurent (p ^ k) ^ i := by
      linear_combination hsum
    have key : θ z ^ (k * Q.natDegree) = LaurentPolynomial.T (k : ℤ) *
        (-∑ i ∈ Finset.range Q.natDegree,
          algebraMap (Algebra.adjoin κ {(LaurentPolynomial.T (k : ℤ) : LaurentPolynomial κ)})
            (LaurentPolynomial κ) (Q.coeff i) *
          LaurentPolynomial.T (k : ℤ) ^ (Q.natDegree - 1 - i) * (θ z ^ k) ^ i) := by
      rw [pow_mul, hfk, mul_pow, hhN, mul_neg, mul_neg, neg_inj, Finset.mul_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i hi => ?_)
      have hi' : i < Q.natDegree := Finset.mem_range.mp hi
      have e : (LaurentPolynomial.T (k : ℤ) : LaurentPolynomial κ) ^ Q.natDegree =
          LaurentPolynomial.T (k : ℤ) * LaurentPolynomial.T (k : ℤ) ^ (Q.natDegree - 1 - i) *
            LaurentPolynomial.T (k : ℤ) ^ i := by
        rw [← pow_succ', ← pow_add]
        congr 1
        omega
      rw [e, mul_pow]
      ring
    have hY : LaurentPolynomial.C c⁻¹ * (-∑ i ∈ Finset.range Q.natDegree,
        algebraMap (Algebra.adjoin κ {(LaurentPolynomial.T (k : ℤ) : LaurentPolynomial κ)})
          (LaurentPolynomial κ) (Q.coeff i) *
        LaurentPolynomial.T (k : ℤ) ^ (Q.natDegree - 1 - i) * (θ z ^ k) ^ i) ∈ θ.range := by
      obtain ⟨e', he'⟩ := h3 c⁻¹
      have hTr : (LaurentPolynomial.T (k : ℤ) : LaurentPolynomial κ) ∈ θ.range :=
        RingHom.mem_range.mpr ⟨e' * x, by rw [map_mul, he', hτ]⟩
      refine mul_mem (RingHom.mem_range.mpr ⟨e', he'⟩) (neg_mem (sum_mem fun i _ => ?_))
      refine mul_mem (mul_mem ?_ (pow_mem hTr _)) (pow_mem (pow_mem (RingHom.mem_range.mpr ⟨z, rfl⟩) _) _)
      exact hBR _ (Q.coeff i).2
    obtain ⟨y, hy⟩ := RingHom.mem_range.mp hY
    refine ⟨k * Q.natDegree, y, Nat.mul_pos (by omega) (Nat.pos_of_ne_zero hm0), ?_⟩
    have hτ' : ∀ S : LaurentPolynomial κ, LaurentPolynomial.T (k : ℤ) * S =
        θ x * (LaurentPolynomial.C c⁻¹ * S) := fun S => by rw [hτ]; ring
    rw [key, hy]
    exact hτ' _


  have CH : ∀ (κ : Type u) [Field κ] (C : Type u) [CommRing C] (θ : C →+* LaurentPolynomial κ)
      (E P : Ideal C) (x : C), P.IsPrime → E ≤ P → x ∈ P → (∀ z, θ z = 0 ↔ z ∈ E) →
      (∀ a : κ, ∃ e : C, θ e = LaurentPolynomial.C a) →
      (∀ (z : C) (p : Polynomial κ), θ z = Polynomial.toLaurent (Polynomial.X * p) →
        ∃ (M : ℕ) (y : C), 0 < M ∧ θ z ^ M = θ x * θ y) →
      ∀ (z : C) (q : Polynomial κ), θ z = Polynomial.toLaurent q → (z ∈ P ↔ q.coeff 0 = 0) := by
    intro κ _ C _ θ E P x hP hEP hxP hker h3 hpd
    have hzero : ∀ (z : C) (q : Polynomial κ), θ z = Polynomial.toLaurent q →
        q.coeff 0 = 0 → z ∈ P := by
      intro z q hz hq0
      have hq : q = Polynomial.X * q.divX := by
        have := Polynomial.X_mul_divX_add q
        rw [hq0, map_zero, add_zero] at this
        exact this.symm
      rw [hq] at hz
      obtain ⟨M, y, hM, hzy⟩ := hpd z q.divX hz
      have h1 : z ^ M - x * y ∈ E :=
        (hker _).mp (by rw [map_sub, map_pow, map_mul, hzy, sub_self])
      have h2 : z ^ M ∈ P := by
        have := P.add_mem (hEP h1) (P.mul_mem_right y hxP)
        rwa [sub_add_cancel] at this
      exact hP.mem_of_pow_mem M h2
    intro z q hz
    refine ⟨fun hzP => ?_, hzero z q hz⟩
    by_contra hq0
    obtain ⟨e, he⟩ := h3 (q.coeff 0)⁻¹
    have hw : z * e - 1 ∈ P := by
      apply hzero (z * e - 1) (q * Polynomial.C (q.coeff 0)⁻¹ - 1)
      · rw [map_sub, map_mul, map_one, hz, he, map_sub, map_mul, map_one, Polynomial.toLaurent_C]
      · rw [Polynomial.coeff_sub, Polynomial.coeff_mul_C, Polynomial.coeff_one_zero,
          mul_inv_cancel₀ hq0, sub_self]
    have h1P : (1 : C) ∈ P := by
      have := P.sub_mem (P.mul_mem_right e hzP) hw
      rwa [sub_sub_cancel] at this
    exact hP.ne_top ((Ideal.eq_top_iff_one _).mpr h1P)


  have hPD' := hPD
  obtain ⟨hFT, hNZ, _, h𝔭M, hm𝔭, _, hg0, huv, h𝔭eq, _⟩ := hPD'
  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
