      ∀ i, g.coeff i ∈ IsLocalRing.maximalIdeal ↥W := by
    intro a n g ha hmem i
    have h1 := hK0 hmem
    rw [RingHom.mem_ker, map_mul, map_pow, hχA, hK1] at h1
    have hCa : Polynomial.C (Ideal.Quotient.mk 𝔭 a) ^ n ≠ 0 := by
      refine pow_ne_zero _ ?_
      rw [Ne, Polynomial.C_eq_zero, Ideal.Quotient.eq_zero_iff_mem]
      exact ha
    have h2 := (mul_eq_zero.mp h1).resolve_left hCa
    apply hF1
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    have h3 := congrArg (fun p => Polynomial.coeff p i) h2
    simp only [Polynomial.coeff_map, Polynomial.coeff_zero, RingHom.comp_apply] at h3
    exact h3



  have hG3 : ∀ e : ↥W, (Ideal.span {Sr - algebraMap A ↥R (algebraMap ↥W A e)} ⊔ mR).IsMaximal ∧
      (Ideal.span {Sr - algebraMap A ↥R (algebraMap ↥W A e)} ⊔ mR).comap (algebraMap A ↥R) = 𝔭 := by
    intro e
    obtain ⟨χe, hχeA, hχeS, hχe0⟩ : ∃ χe : ↥R →+* A ⧸ 𝔭,
        (∀ a, χe (algebraMap A ↥R a) = Ideal.Quotient.mk 𝔭 a) ∧
        χe Sr = Ideal.Quotient.mk 𝔭 (algebraMap ↥W A e) ∧ ∀ r, χ r = 0 → χe r = 0 := by
      refine ⟨(Polynomial.evalRingHom (Ideal.Quotient.mk 𝔭 (algebraMap ↥W A e))).comp χ,
        fun a => ?_, ?_, fun r hr => ?_⟩
      · rw [RingHom.comp_apply, hχA, Polynomial.coe_evalRingHom, Polynomial.eval_C]
      · rw [RingHom.comp_apply, hχS, Polynomial.coe_evalRingHom, Polynomial.eval_X]
      · rw [RingHom.comp_apply, hr, map_zero]
    have hsurje : Function.Surjective χe := by
      intro x
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
      exact ⟨algebraMap A ↥R a, hχeA a⟩
    have hle1 : Ideal.span {Sr - algebraMap A ↥R (algebraMap ↥W A e)} ⊔ mR ≤
        RingHom.ker χe := by
      refine sup_le ?_ ?_
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        show χe (Sr - algebraMap A ↥R (algebraMap ↥W A e)) = 0
        rw [map_sub, hχeS, hχeA, sub_self]
      · intro r hr
        exact hχe0 r (hK0 hr)
    have hle2 : RingHom.ker χe ≤ Ideal.span {Sr - algebraMap A ↥R (algebraMap ↥W A e)} ⊔ mR := by
      intro r hr
      obtain ⟨g, hg⟩ := hG1 r
      have hdvd : Sr - ι e ∣ Polynomial.eval₂ ι Sr g - ι (g.eval e) := by
        have := Polynomial.sub_dvd_eval_sub Sr (ι e) (g.map ι)
        rwa [Polynomial.eval_map, Polynomial.eval_map, Polynomial.eval₂_at_apply] at this
      have hδ : Polynomial.eval₂ ι Sr g - ι (g.eval e) ∈
          Ideal.span {Sr - algebraMap A ↥R (algebraMap ↥W A e)} ⊔ mR :=
        Ideal.mem_sup_left (Ideal.mem_span_singleton.mpr hdvd)
      have hμ : r - Polynomial.eval₂ ι Sr g ∈
          Ideal.span {Sr - algebraMap A ↥R (algebraMap ↥W A e)} ⊔ mR := Ideal.mem_sup_right hg
      have hval : χe (ι (g.eval e)) = 0 := by
        have h1 : χe r = 0 := hr
        have h2 : χe (r - Polynomial.eval₂ ι Sr g) = 0 := hle1 hμ
        have h3 : χe (Polynomial.eval₂ ι Sr g - ι (g.eval e)) = 0 := hle1 hδ
        have e4 : ι (g.eval e) = r - (r - Polynomial.eval₂ ι Sr g) -
            (Polynomial.eval₂ ι Sr g - ι (g.eval e)) := by ring
        rw [e4, map_sub, map_sub, h1, h2, h3, sub_zero, sub_zero]
      have hgm : g.eval e ∈ IsLocalRing.maximalIdeal ↥W := by
        apply hF1
        rw [← Ideal.Quotient.eq_zero_iff_mem, ← hχeA]
        exact hval
      have hιm : ι (g.eval e) ∈ Ideal.span {Sr - algebraMap A ↥R (algebraMap ↥W A e)} ⊔ mR :=
        Ideal.mem_sup_right (hmR_mem _ hgm)
      have e5 : r = (r - Polynomial.eval₂ ι Sr g) + (Polynomial.eval₂ ι Sr g - ι (g.eval e)) +
          ι (g.eval e) := by ring
      rw [e5]
      exact Ideal.add_mem _ (Ideal.add_mem _ hμ hδ) hιm
    have heq : Ideal.span {Sr - algebraMap A ↥R (algebraMap ↥W A e)} ⊔ mR = RingHom.ker χe :=
      le_antisymm hle1 hle2
    refine ⟨?_, ?_⟩
    · rw [heq]; exact RingHom.ker_isMaximal_of_surjective χe hsurje
    · rw [heq, RingHom.comap_ker]
      have : χe.comp (algebraMap A ↥R) = Ideal.Quotient.mk 𝔭 := RingHom.ext hχeA
      rw [this, Ideal.mk_ker]
  exact ⟨hG1, hG2, hG3⟩

theorem wcLlsKPms_model : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ (c b : ↥W) (d : A) (w : L) (F : Polynomial K) (ε : ↥W) (G : Polynomial ↥W) (ω : ↥W),
      c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
      wcLlsKPInnerCore W A K L ℓ 𝔭 t c b d w F ε G ω → ε ∈ IsLocalRing.maximalIdeal ↥W →
      ∀ (e : ↥W) (𝔮 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L))
        [𝔮.IsPrime],
      𝔮.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)) =
        Ideal.span {⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ -
          algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (algebraMap ↥W A e)} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A)) →
      ∃ (P : Type u) (_ : CommRing P) (_ : IsDomain P) (ψ : Polynomial ↥W →+* P)
        (FP : Polynomial P) (Q : Ideal (AdjoinRoot FP)) (_ : Q.IsPrime)
        (j : Localization.AtPrime Q →+* L)
        (φ : Localization.AtPrime Q →+* Localization.AtPrime 𝔮),
        ψ.Etale ∧
        (∀ x : P, ∃ f : Polynomial ↥W,
          x - ψ f ∈ (IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C)) ∧
        (∀ f : Polynomial ↥W, ψ f ∈ (IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C) →
          ∀ i, f.coeff i ∈ IsLocalRing.maximalIdeal ↥W) ∧
        FP.Monic ∧ FP.natDegree = ℓ ∧
        (∀ i, 1 ≤ i → i < ℓ → FP.coeff i ∈ (IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C)) ∧
        FP.coeff 0 + ψ G ∈ (IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C) ∧
        (∃ U V : Polynomial P,
          U * FP + V * Polynomial.derivative FP = Polynomial.C (ψ (Polynomial.C ω))) ∧
        IsDomain (AdjoinRoot FP) ∧
        (IsLocalRing.maximalIdeal ↥W).map ((AdjoinRoot.of FP).comp (ψ.comp Polynomial.C)) ≤ Q ∧
        AdjoinRoot.of FP (ψ (Polynomial.X - Polynomial.C e)) ∈ Q ∧
        Function.Injective j ∧ IsLocalHom φ ∧
        (∀ π : ↥W, φ (algebraMap (AdjoinRoot FP) (Localization.AtPrime Q)
            (AdjoinRoot.of FP (ψ (Polynomial.C π)))) =
          algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)
            (Localization.AtPrime 𝔮)
            (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
              ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)
              (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (algebraMap ↥W A π)))) ∧
        (∀ l : L, ∃ x y : Localization.AtPrime Q, j y ≠ 0 ∧ l * j y = j x) ∧
        (∀ r : ↥(Algebra.adjoin A {wcLlsScS W A K t c b}), ∃ x : Localization.AtPrime Q,
          j x = algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L r) ∧
        (∀ x : Localization.AtPrime Q, ∃ z s :
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L), s ∉ 𝔮 ∧
          φ x * algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)
              (Localization.AtPrime 𝔮) s =
            algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)
              (Localization.AtPrime 𝔮) z ∧
          j x * (s : L) = (z : L)) :=
by
  have hS6 : ∀ (R : Type u) [CommRing R] (P : Type u) [CommRing P] (L : Type u) [Field L]
      [Algebra R L] [Algebra P L] (g : R) (w : L) (N : ℕ),
      (∀ x : P, ∃ (r : R) (n : ℕ), algebraMap P L x * algebraMap R L g ^ n = algebraMap R L r) →
      IsIntegral R (algebraMap R L g ^ N * w) →
      ∀ q : Polynomial P, ∃ M : ℕ, IsIntegral R (Polynomial.aeval w q * algebraMap R L g ^ M) := by
    intro R _ P _ L _ _ _ g w N hfr hN q
    induction q using Polynomial.induction_on with
    | C a =>
      obtain ⟨r, n, hr⟩ := hfr a
      exact ⟨n, by rw [Polynomial.aeval_C, hr]; exact isIntegral_algebraMap⟩
    | add p q hp hq =>
      obtain ⟨M1, h1⟩ := hp
      obtain ⟨M2, h2⟩ := hq
      refine ⟨M1 + M2, ?_⟩
      have e : Polynomial.aeval w (p + q) * algebraMap R L g ^ (M1 + M2) =
          (Polynomial.aeval w p * algebraMap R L g ^ M1) * algebraMap R L (g ^ M2) +
            (Polynomial.aeval w q * algebraMap R L g ^ M2) * algebraMap R L (g ^ M1) := by
        rw [map_add, map_pow, map_pow, pow_add]; ring
      rw [e]
      exact (h1.mul isIntegral_algebraMap).add (h2.mul isIntegral_algebraMap)
    | monomial n a ih =>
      obtain ⟨M, h⟩ := ih
      refine ⟨M + N, ?_⟩
      have e : Polynomial.aeval w (Polynomial.C a * Polynomial.X ^ (n + 1)) *
            algebraMap R L g ^ (M + N) =
          (Polynomial.aeval w (Polynomial.C a * Polynomial.X ^ n) * algebraMap R L g ^ M) *
            (algebraMap R L g ^ N * w) := by
        simp only [map_mul, Polynomial.aeval_C, Polynomial.aeval_X_pow]; ring
      rw [e]
      exact h.mul hN
  have hS5 : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (P : Type u) [CommRing P]
      (K : Type u) [Field K] [Algebra P K] (ψP : Polynomial ↥W →+* P) (ℓ : ℕ) (ε ω : ↥W)
      (G : Polynomial ↥W) (F U V : Polynomial K),
      Function.Injective (algebraMap P K) → ε ∈ IsLocalRing.maximalIdeal ↥W → F.Monic →
      F.natDegree = ℓ → (∀ i, F.coeff i ∈ Set.range (algebraMap P K)) →
      (∀ i, U.coeff i ∈ Set.range (algebraMap P K)) → (∀ i, V.coeff i ∈ Set.range (algebraMap P K)) →
      U * F + V * Polynomial.derivative F = Polynomial.C (algebraMap P K (ψP (Polynomial.C ω))) →
      (∀ i, 2 ≤ i → i < ℓ → ∃ π ∈ IsLocalRing.maximalIdeal ↥W, ∃ y : P,
        F.coeff i = algebraMap P K (ψP (Polynomial.C π) * y)) →
      (∃ π ∈ IsLocalRing.maximalIdeal ↥W, ∃ y : P,
        F.coeff 1 - algebraMap P K (ψP (Polynomial.C ε)) = algebraMap P K (ψP (Polynomial.C π) * y)) →
      (∃ π ∈ IsLocalRing.maximalIdeal ↥W, ∃ y : P,
        F.coeff 0 + algebraMap P K (ψP G) = algebraMap P K (ψP (Polynomial.C π) * y)) →
      ∃ FP : Polynomial P, FP.map (algebraMap P K) = F ∧ FP.Monic ∧ FP.natDegree = ℓ ∧
        (∀ i, 1 ≤ i → i < ℓ → FP.coeff i ∈ (IsLocalRing.maximalIdeal ↥W).map (ψP.comp Polynomial.C)) ∧
        FP.coeff 0 + ψP G ∈ (IsLocalRing.maximalIdeal ↥W).map (ψP.comp Polynomial.C) ∧
        ∃ UP VP : Polynomial P,
          UP * FP + VP * Polynomial.derivative FP = Polynomial.C (ψP (Polynomial.C ω)) := by
    intro Ω _ W P _ K _ _ ψP ℓ ε ω G F U V hinj hε hFm hFd hF hU hV hUV hmid h1 h0
    obtain ⟨FP, hFPmap, hFPdeg, hFPmon⟩ :=
      Polynomial.lifts_and_natDegree_eq_and_monic ((Polynomial.lifts_iff_coeff_lifts F).mpr hF) hFm
    obtain ⟨UP, hUP⟩ := (Polynomial.mem_lifts U).mp ((Polynomial.lifts_iff_coeff_lifts U).mpr hU)
    obtain ⟨VP, hVP⟩ := (Polynomial.mem_lifts V).mp ((Polynomial.lifts_iff_coeff_lifts V).mpr hV)
    have hc : ∀ i, algebraMap P K (FP.coeff i) = F.coeff i := by
      intro i; rw [← hFPmap, Polynomial.coeff_map]
    have hmem : ∀ π ∈ IsLocalRing.maximalIdeal ↥W, ∀ y : P,
        ψP (Polynomial.C π) * y ∈ (IsLocalRing.maximalIdeal ↥W).map (ψP.comp Polynomial.C) :=
      fun π hπ y => Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem (ψP.comp Polynomial.C) hπ)
    refine ⟨FP, hFPmap, hFPmon, hFPdeg.trans hFd, ?_, ?_, UP, VP, ?_⟩
    · intro i hi1 hi2
      rcases Nat.lt_or_ge i 2 with hlt | hge
      · have hi : i = 1 := by omega
        subst hi
        obtain ⟨π, hπ, y, hy⟩ := h1
        have e1 : FP.coeff 1 - ψP (Polynomial.C ε) = ψP (Polynomial.C π) * y := by
          apply hinj; rw [map_sub, hc]; exact hy
        have e2 : FP.coeff 1 = ψP (Polynomial.C ε) + ψP (Polynomial.C π) * y := by
          rw [← e1]; ring
        rw [e2]
        exact Ideal.add_mem _ (Ideal.mem_map_of_mem (ψP.comp Polynomial.C) hε) (hmem π hπ y)
      · obtain ⟨π, hπ, y, hy⟩ := hmid i hge hi2
        have e1 : FP.coeff i = ψP (Polynomial.C π) * y := by
          apply hinj; rw [hc]; exact hy
        rw [e1]; exact hmem π hπ y
    · obtain ⟨π, hπ, y, hy⟩ := h0
      have e1 : FP.coeff 0 + ψP G = ψP (Polynomial.C π) * y := by
        apply hinj; rw [map_add, hc]; exact hy
      rw [e1]; exact hmem π hπ y
    · apply Polynomial.map_injective (algebraMap P K) hinj
      rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, ← Polynomial.derivative_map,
        hFPmap, hUP, hVP, Polynomial.map_C]
      exact hUV
  have hS4 : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (R : Type u) [CommRing R]
      (P : Type u) [CommRing P] (wR : ↥W →+* R) (Sr : R) (ρ : R →+* P) (ψP : Polynomial ↥W →+* P)
      (g : R) (wg : ↥W), Function.Injective ρ → (∀ π : ↥W, ψP (Polynomial.C π) = ρ (wR π)) →
      ψP Polynomial.X = ρ Sr → IsUnit wg → g - wR wg ∈ (IsLocalRing.maximalIdeal ↥W).map wR →
      (∀ x : P, ∃ (r : R) (n : ℕ), x * ρ g ^ n = ρ r) →
      (∀ r : R, ∃ f : Polynomial ↥W,
        r - Polynomial.eval₂ wR Sr f ∈ (IsLocalRing.maximalIdeal ↥W).map wR) →
      (∀ (n : ℕ) (f : Polynomial ↥W), g ^ n * Polynomial.eval₂ wR Sr f ∈
        (IsLocalRing.maximalIdeal ↥W).map wR → ∀ i, f.coeff i ∈ IsLocalRing.maximalIdeal ↥W) →
      (∀ x : P, ∃ f : Polynomial ↥W,
        x - ψP f ∈ (IsLocalRing.maximalIdeal ↥W).map (ψP.comp Polynomial.C)) ∧
      (∀ f : Polynomial ↥W, ψP f ∈ (IsLocalRing.maximalIdeal ↥W).map (ψP.comp Polynomial.C) →
        ∀ i, f.coeff i ∈ IsLocalRing.maximalIdeal ↥W) := by
    intro Ω _ W R _ P _ wR Sr ρ ψP g wg hρ hC hX hwg hg hfr hR1 hR2
    have ha : ∀ f : Polynomial ↥W, ρ (Polynomial.eval₂ wR Sr f) = ψP f := by
      intro f
      have h : ρ.comp (Polynomial.eval₂RingHom wR Sr) = ψP := by
        apply Polynomial.ringHom_ext
        · intro π
          rw [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hC]
        · rw [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, hX]
      exact RingHom.congr_fun h f
    have hmapeq : (IsLocalRing.maximalIdeal ↥W).map (ψP.comp Polynomial.C) =
        ((IsLocalRing.maximalIdeal ↥W).map wR).map ρ := by
      rw [Ideal.map_map]
      congr 1
      ext π
      rw [RingHom.comp_apply, RingHom.comp_apply, hC]
    have hb : ∀ y ∈ (IsLocalRing.maximalIdeal ↥W).map wR,
        ρ y ∈ (IsLocalRing.maximalIdeal ↥W).map (ψP.comp Polynomial.C) := by
      intro y hy; rw [hmapeq]; exact Ideal.mem_map_of_mem ρ hy
    constructor
    · intro x
      obtain ⟨r, n, hr⟩ := hfr x
      obtain ⟨fr, hfr'⟩ := hR1 r
      obtain ⟨wi, hwi⟩ : ∃ wi : ↥W, wg * wi = 1 := hwg.exists_right_inv
      refine ⟨fr * Polynomial.C (wi ^ n), ?_⟩
      have hvv : ψP (Polynomial.C wg) * ψP (Polynomial.C wi) = 1 := by
        rw [← map_mul, ← Polynomial.C_mul, hwi, Polynomial.C_1, map_one]
      have hvn : (ψP (Polynomial.C wg) * ψP (Polynomial.C wi)) ^ n = 1 := by rw [hvv, one_pow]
      have hψ : ψP (fr * Polynomial.C (wi ^ n)) = ψP fr * ψP (Polynomial.C wi) ^ n := by
        rw [map_mul, Polynomial.C_pow, map_pow]
      have hid : x - ψP (fr * Polynomial.C (wi ^ n)) = ψP (Polynomial.C wi) ^ n *
          (x * (ψP (Polynomial.C wg) ^ n - ρ g ^ n) + (ρ r - ψP fr)) := by
        rw [hψ]
        linear_combination (-x) * hvn + ψP (Polynomial.C wi) ^ n * hr
      rw [hid]
      have hvu : ψP (Polynomial.C wg) - ρ g ∈
          (IsLocalRing.maximalIdeal ↥W).map (ψP.comp Polynomial.C) := by
        have e : ψP (Polynomial.C wg) - ρ g = -ρ (g - wR wg) := by rw [hC, map_sub]; ring
        rw [e]
        exact neg_mem (hb _ hg)
      have hvun : ψP (Polynomial.C wg) ^ n - ρ g ^ n ∈
          (IsLocalRing.maximalIdeal ↥W).map (ψP.comp Polynomial.C) := by
        obtain ⟨c, hc⟩ := sub_dvd_pow_sub_pow (ψP (Polynomial.C wg)) (ρ g) n
        rw [hc]
        exact Ideal.mul_mem_right _ _ hvu
      have hrf : ρ r - ψP fr ∈ (IsLocalRing.maximalIdeal ↥W).map (ψP.comp Polynomial.C) := by
        rw [← ha, ← map_sub]; exact hb _ hfr'
      exact Ideal.mul_mem_left _ _ (Ideal.add_mem _ (Ideal.mul_mem_left _ _ hvun) hrf)
    · have hd : ∀ y ∈ (IsLocalRing.maximalIdeal ↥W).map (ψP.comp Polynomial.C),
          ∃ (N : ℕ) (m' : R), m' ∈ (IsLocalRing.maximalIdeal ↥W).map wR ∧ y * ρ g ^ N = ρ m' := by
        intro y hy
        have hy' : y ∈ Ideal.span ((ψP.comp Polynomial.C) '' (IsLocalRing.maximalIdeal ↥W : Set ↥W)) :=
          hy
        clear hy
        induction hy' using Submodule.span_induction with
        | mem x hx =>
          obtain ⟨π, hπ, rfl⟩ := hx
          exact ⟨0, wR π, Ideal.mem_map_of_mem wR hπ, by
            rw [pow_zero, mul_one, RingHom.comp_apply, hC]⟩
        | zero => exact ⟨0, 0, Ideal.zero_mem _, by rw [zero_mul, map_zero]⟩
        | add x y _ _ hx hy =>
          obtain ⟨N1, m1, hm1, e1⟩ := hx
          obtain ⟨N2, m2, hm2, e2⟩ := hy
          refine ⟨N1 + N2, m1 * g ^ N2 + m2 * g ^ N1,
            Ideal.add_mem _ (Ideal.mul_mem_right _ _ hm1) (Ideal.mul_mem_right _ _ hm2), ?_⟩
          rw [map_add, map_mul, map_mul, map_pow, map_pow, ← e1, ← e2]
          ring
        | smul a x _ hx =>
          obtain ⟨N, m1, hm1, e1⟩ := hx
          obtain ⟨ra, na, ea⟩ := hfr a
          refine ⟨na + N, ra * m1, Ideal.mul_mem_left _ _ hm1, ?_⟩
          rw [smul_eq_mul, map_mul, ← ea, ← e1]
          ring
      intro f hf
      obtain ⟨N, m', hm', e⟩ := hd _ hf
      have h1 : g ^ N * Polynomial.eval₂ wR Sr f = m' := by
        apply hρ
