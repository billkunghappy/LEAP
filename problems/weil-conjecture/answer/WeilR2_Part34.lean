  have hιR : ∀ w : ↥W, algebraMap A K (algebraMap ↥W A w) ∈ Algebra.adjoin A {V} :=
    fun w => Subalgebra.algebraMap_mem _ _
  have huR : u ∈ Algebra.adjoin A {V} := Subalgebra.algebraMap_mem _ _
  have hVR : V ∈ Algebra.adjoin A {V} := Algebra.subset_adjoin (Set.mem_singleton _)
  have hgKR : gK ∈ Algebra.adjoin A {V} := hιR γ₁
  have hevR : ∀ P : Polynomial ↥W,
