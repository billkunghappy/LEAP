  have hPD' := hPD
  obtain ⟨hFT, hNZ, -, h𝔭max, hm𝔭, -, -, -, h𝔭eq, -⟩ := hPD'
  haveI := hNZ
  have h𝔭p : 𝔭.IsPrime := h𝔭max.isPrime
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h => h𝔭p.ne_top ((Ideal.eq_top_iff_one _).mpr h)
