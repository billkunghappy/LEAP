              (Polynomial.C h * Polynomial.X - Polynomial.C a) ∈
              Ideal.span {Polynomial.C h * Polynomial.X - Polynomial.C a} :=
            Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
          have hDk := RingHom.mem_ker.mp (s1 hDI)
          have hlt := s4 P q hpos hq
          have hP' := ih _ hlt _ rfl (by rw [map_sub, hP, hDk, sub_zero])
          have := Ideal.add_mem _ hP' hDI
          rwa [sub_add_cancel] at this
    exact le_antisymm (fun P hP => s5 _ P rfl (RingHom.mem_ker.mp hP)) s1
  have hres : ∀ a : A, ∃ w : ↥W, a - algebraMap ↥W A w ∈ 𝔭 := by
    have T1 : IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
      apply IsAlgClosed.of_exists_root
      intro p hpmon hpirr
      have hlift : p ∈ Polynomial.lifts (IsLocalRing.residue ↥W) := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro n
        exact IsLocalRing.residue_surjective _
      obtain ⟨q, hqmap, hqdeg, hqmon⟩ :=
        Polynomial.lifts_and_natDegree_eq_and_monic hlift hpmon
      have hpdeg : 0 < p.natDegree := hpirr.natDegree_pos
      set j : ↥W →+* Ω := algebraMap ↥W Ω with hj
      have hQmon : (q.map j).Monic := hqmon.map j
      have hQdeg : (q.map j).natDegree = q.natDegree := hqmon.natDegree_map j
      have hQd : (q.map j).degree ≠ 0 := by
        rw [Polynomial.degree_eq_natDegree hQmon.ne_zero, hQdeg, hqdeg]
        exact_mod_cast hpdeg.ne'
      obtain ⟨z, hz⟩ := IsAlgClosed.exists_root (q.map j) hQd
      have hzint : _root_.IsIntegral ↥W z := by
        refine ⟨q, hqmon, ?_⟩
        rw [Polynomial.IsRoot, Polynomial.eval_map] at hz
        exact hz
      obtain ⟨y, hy⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hzint
      have hqy : q.eval y = 0 := by
        apply (IsFractionRing.injective ↥W Ω)
        rw [map_zero, ← Polynomial.eval_map_apply]
        rw [hy]
        exact hz
      refine ⟨IsLocalRing.residue ↥W y, ?_⟩
      rw [← hqmap, Polynomial.eval_map_apply, hqy, map_zero]
    have T2 : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
        [IsAlgClosed (IsLocalRing.ResidueField R)] (k : Type u) [Field k] (ρ : R →+* k),
        IsLocalHom ρ → ρ.FiniteType → Function.Surjective ρ := by
      intro R _ _ _ k _ ρ hloc hρFT
      set ψ := IsLocalRing.ResidueField.lift ρ with hψ
      have hψr : ψ.comp (IsLocalRing.residue R) = ρ :=
        IsLocalRing.ResidueField.lift_comp_residue ρ
      have hψFT : ψ.FiniteType := by
        rw [← hψr] at hρFT
        exact RingHom.FiniteType.of_comp_finiteType hρFT
      have hψfin : ψ.Finite := (RingHom.finite_iff_finiteType_of_isJacobsonRing).mpr hψFT
      have hψsurj : Function.Surjective ψ :=
        (IsAlgClosed.ringHom_bijective_of_isIntegral ψ hψfin.to_isIntegral).2
      rw [← hψr]
      exact hψsurj.comp (IsLocalRing.residue_surjective)
    let ρ0 : ↥W →+* A ⧸ 𝔭 := (Ideal.Quotient.mk 𝔭).comp (algebraMap ↥W A)
    have hloc : IsLocalHom ρ0 := by
      refine ⟨fun x hx => ?_⟩
      by_contra hxu
      have hxm : x ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal x).mpr hxu
      have h1 : algebraMap ↥W A x ∈ 𝔭 := hmA (Ideal.mem_map_of_mem _ hxm)
      have h2 : ρ0 x = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr h1
      rw [h2] at hx
      exact not_isUnit_zero hx
    have hρFT : ρ0.FiniteType :=
      RingHom.FiniteType.comp_surjective (RingHom.finiteType_algebraMap.mpr hFT)
        Ideal.Quotient.mk_surjective
    intro a
    obtain ⟨w, hw⟩ := T2 ↥W (A ⧸ 𝔭) ρ0 hloc hρFT (Ideal.Quotient.mk 𝔭 a)
    refine ⟨w, ?_⟩
    exact Ideal.Quotient.eq.mp hw.symm



  have hF1 : ∀ w : ↥W, algebraMap ↥W A w ∈ 𝔭 → w ∈ IsLocalRing.maximalIdeal ↥W := by
    intro w hw
    by_contra hwm
    have hu : IsUnit w := by
      by_contra hnu
      exact hwm ((IsLocalRing.mem_maximalIdeal w).mpr hnu)
    exact h𝔭max.ne_top (Ideal.eq_top_of_isUnit_mem _ hw (hu.map _))
  have hF2 : ∀ π ∈ IsLocalRing.maximalIdeal ↥W, algebraMap ↥W A π ∈ 𝔭 :=
    fun π hπ => hmA (Ideal.mem_map_of_mem _ hπ)
  have hbA : algebraMap ↥W A b ≠ 0 := by
    intro h0
