    ha (hPrime.mem_of_pow_mem n h)
  have hm𝔭 : Ideal.map (algebraMap ↥W A) (IsLocalRing.maximalIdeal ↥W) ≤ 𝔭 := hPD.2.2.2.2.1
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h => hPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have NM1 : ∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' 1 := by
    rintro d'' hd'' ⟨π, hπ, x', hx', h1⟩
    obtain ⟨n, c, hc⟩ := (T0 d'' x').mp hx'
    have hπ𝔭 : algebraMap ↥W A π ∈ 𝔭 := hm𝔭 (Ideal.mem_map_of_mem _ hπ)
    have e : algebraMap A K (algebraMap ↥W A π * c) = algebraMap A K (d'' ^ n) := by
      rw [map_mul, hc, map_pow]
      linear_combination (-(algebraMap A K d'' ^ n)) * h1
    have e2 := IsFractionRing.injective A K e
    exact TP d'' n hd'' (e2 ▸ 𝔭.mul_mem_right _ hπ𝔭)
  have HC := wcLlsKP_bau_content Ω W hW hWt A K 𝔭 t hPD
  have HP := wcLlsKP_bcB_mA_prime Ω W hW hWt A K 𝔭 t hPD

  have Ok0 : wcLlsKPOk W A K 𝔭 0 := ⟨1, 0, 1, h1𝔭, Tzero 1, Tone 1, NM1, zero_mul 1⟩
  have Ok1 : wcLlsKPOk W A K 𝔭 1 := ⟨1, 1, 1, h1𝔭, Tone 1, Tone 1, NM1, one_mul 1⟩
  have OkW : ∀ π : ↥W, wcLlsKPOk W A K 𝔭 (algebraMap A K (algebraMap ↥W A π)) := fun π =>
    ⟨1, algebraMap A K (algebraMap ↥W A π), 1, h1𝔭, TC 1 _, Tone 1, NM1, mul_one _⟩
  have OkNeg : ∀ x : K, wcLlsKPOk W A K 𝔭 x → wcLlsKPOk W A K 𝔭 (-x) := by
    rintro x ⟨d, b, s, hd, hb, hs, hns, hxs⟩
    exact ⟨d, -b, s, hd, TNeg _ _ hb, hs, hns, by rw [neg_mul, hxs]⟩
  have OkAdd : ∀ x y : K, wcLlsKPOk W A K 𝔭 x → wcLlsKPOk W A K 𝔭 y →
      wcLlsKPOk W A K 𝔭 (x + y) := by
    rintro x y ⟨d, b, s, hd, hb, hs, hns, hxs⟩ ⟨d', b', s', hd', hb', hs', hns', hys⟩
    have hD := T5 _ _ hd hd'
    have hb1 := TD _ _ _ hb ⟨d', rfl⟩
    have hs1 := TD _ _ _ hs ⟨d', rfl⟩
    have hb2 : wcLlsKPLoc A K 0 (d * d') b' := TD _ _ _ hb' ⟨d, by ring⟩
    have hs2 : wcLlsKPLoc A K 0 (d * d') s' := TD _ _ _ hs' ⟨d, by ring⟩
    exact ⟨d * d', b * s' + b' * s, s * s', hD, TA _ _ _ (TMul _ _ _ hb1 hs2) (TMul _ _ _ hb2 hs1),
      TMul _ _ _ hs1 hs2, HP s s' (d * d') hD hs1 hs2 hns hns',
      by linear_combination s' * hxs + s * hys⟩
  have OkMul : ∀ x y : K, wcLlsKPOk W A K 𝔭 x → wcLlsKPOk W A K 𝔭 y →
      wcLlsKPOk W A K 𝔭 (x * y) := by
    rintro x y ⟨d, b, s, hd, hb, hs, hns, hxs⟩ ⟨d', b', s', hd', hb', hs', hns', hys⟩
    have hD := T5 _ _ hd hd'
    have hb1 := TD _ _ _ hb ⟨d', rfl⟩
    have hs1 := TD _ _ _ hs ⟨d', rfl⟩
    have hb2 : wcLlsKPLoc A K 0 (d * d') b' := TD _ _ _ hb' ⟨d, by ring⟩
    have hs2 : wcLlsKPLoc A K 0 (d * d') s' := TD _ _ _ hs' ⟨d, by ring⟩
    exact ⟨d * d', b * b', s * s', hD, TMul _ _ _ hb1 hb2,
      TMul _ _ _ hs1 hs2, HP s s' (d * d') hD hs1 hs2 hns hns',
      by linear_combination (y * s') * hxs + b * hys⟩

  have hS3 : ∀ (π : ↥W) (z : K), π ∈ IsLocalRing.maximalIdeal ↥W → wcLlsKPOk W A K 𝔭 z →
      algebraMap A K (algebraMap ↥W A π) * z ≠ 1 := by
    rintro π z hπ ⟨d, b, s, hd, hb, hs, hns, hzs⟩ h1
    exact hns d hd ⟨π, hπ, b, hb, by
      linear_combination (-s) * h1 + algebraMap A K (algebraMap ↥W A π) * hzs⟩

  have hinj : ∀ π : ↥W, π ≠ 0 → algebraMap A K (algebraMap ↥W A π) ≠ 0 := by
    intro π hπ h0
    haveI := hPD.2.1
    have h1 : algebraMap ↥W A π = 0 := IsFractionRing.injective A K (h0.trans (map_zero _).symm)
    rw [Algebra.algebraMap_eq_smul_one] at h1
    rcases smul_eq_zero.mp h1 with h | h
    · exact hπ h
    · exact one_ne_zero h
  have hinvR : ∀ (x : K) (π : ↥W) (u : K), π ≠ 0 → x * algebraMap A K (algebraMap ↥W A π) = u →
      x⁻¹ = algebraMap A K (algebraMap ↥W A π) * u⁻¹ := by
    intro x π u hπ h
    rw [← h, mul_inv, mul_comm x⁻¹, ← mul_assoc, mul_inv_cancel₀ (hinj π hπ), one_mul]

  have hsplit : ∀ x : K, x ≠ 0 → ∃ (π : ↥W) (u : K), π ≠ 0 ∧ wcLlsKPOk W A K 𝔭 u ∧
      wcLlsKPOk W A K 𝔭 u⁻¹ ∧ (x = algebraMap A K (algebraMap ↥W A π) * u ∨
        x * algebraMap A K (algebraMap ↥W A π) = u) := by
    intro x hx
    obtain ⟨a₁, a₂, ha₂, hx'⟩ := IsFractionRing.div_surjective (A := A) x
    have hX2 : algebraMap A K a₂ ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors ha₂
    have hX1 : algebraMap A K a₁ ≠ 0 := by
      intro h
      apply hx
      rw [← hx', h, zero_div]
    obtain ⟨π₁, x₁, d₁, hπ₁, hd₁, hL₁, he₁, hN₁⟩ := HC (algebraMap A K a₁) 1 h1𝔭 (TC 1 a₁) hX1
    obtain ⟨π₂, x₂, d₂, hπ₂, hd₂, hL₂, he₂, hN₂⟩ := HC (algebraMap A K a₂) 1 h1𝔭 (TC 1 a₂) hX2
    have hx₁0 : x₁ ≠ 0 := by
      intro h
      apply hX1
      rw [he₁, h, mul_zero]
    have hx₂0 : x₂ ≠ 0 := by
      intro h
      apply hX2
      rw [he₂, h, mul_zero]
    have hw₁ : algebraMap A K (algebraMap ↥W A π₁) ≠ 0 := hinj π₁ hπ₁
    have hw₂ : algebraMap A K (algebraMap ↥W A π₂) ≠ 0 := hinj π₂ hπ₂
    have hD := T5 _ _ hd₁ hd₂
    have hL₁' : wcLlsKPLoc A K 0 (d₁ * d₂) x₁ := TD _ _ _ hL₁ ⟨d₂, rfl⟩
    have hL₂' : wcLlsKPLoc A K 0 (d₁ * d₂) x₂ := TD _ _ _ hL₂ ⟨d₁, by ring⟩
    have hOku : wcLlsKPOk W A K 𝔭 (x₁ / x₂) :=
      ⟨d₁ * d₂, x₁, x₂, hD, hL₁', hL₂', hN₂, div_mul_cancel₀ x₁ hx₂0⟩
    have hOkui : wcLlsKPOk W A K 𝔭 (x₁ / x₂)⁻¹ :=
      ⟨d₁ * d₂, x₂, x₁, hD, hL₂', hL₁', hN₁, by rw [inv_div, div_mul_cancel₀ x₂ hx₁0]⟩
    rcases ValuationRing.dvd_total π₁ π₂ with ⟨c, hc⟩ | ⟨c, hc⟩
    · have hc0 : c ≠ 0 := by
        rintro rfl
        rw [mul_zero] at hc
        exact hπ₂ hc
      have hwc := hinj c hc0
      refine ⟨c, x₁ / x₂, hc0, hOku, hOkui, Or.inr ?_⟩
      rw [← hx', he₁, he₂, hc]
      simp only [map_mul]
      rw [div_mul_eq_mul_div, div_eq_div_iff (mul_ne_zero (mul_ne_zero hw₁ hwc) hx₂0) hx₂0]
      ring
    · have hc0 : c ≠ 0 := by
        rintro rfl
        rw [mul_zero] at hc
        exact hπ₁ hc
      refine ⟨c, x₁ / x₂, hc0, hOku, hOkui, Or.inl ?_⟩
      rw [← hx', he₁, he₂, hc]
      simp only [map_mul]
      rw [mul_div_assoc', div_eq_div_iff (mul_ne_zero hw₂ hx₂0) hx₂0]
      ring

  let O : ValuationSubring K :=
    { carrier := {y | wcLlsKPOk W A K 𝔭 y}
      zero_mem' := Ok0
      one_mem' := Ok1
      add_mem' := fun {x y} hx hy => OkAdd x y hx hy
      mul_mem' := fun {x y} hx hy => OkMul x y hx hy
      neg_mem' := fun {x} hx => OkNeg x hx
      mem_or_inv_mem' := by
        intro x
        by_cases hx : x = 0
        · left
          show wcLlsKPOk W A K 𝔭 x
          rw [hx]
          exact Ok0
        · obtain ⟨π, u, hπ, hu, hui, h | h⟩ := hsplit x hx
          · left
            show wcLlsKPOk W A K 𝔭 x
            rw [h]
            exact OkMul _ _ (OkW π) hu
          · right
            show wcLlsKPOk W A K 𝔭 x⁻¹
            rw [hinvR x π u hπ h]
            exact OkMul _ _ (OkW π) hui }
  have hmemO : ∀ y : K, y ∈ O ↔ wcLlsKPOk W A K 𝔭 y := fun y => Iff.rfl
  have V3 : ∀ y : K, y ≠ 0 → (O.valuation y < 1 ↔ ¬ wcLlsKPOk W A K 𝔭 y⁻¹) := by
    intro y hy
    have h := Valuation.one_lt_val_iff O.valuation (inv_ne_zero hy)
    rw [inv_inv] at h
    calc O.valuation y < 1 ↔ 1 < O.valuation y⁻¹ := h.symm
      _ ↔ ¬ O.valuation y⁻¹ ≤ 1 := not_le.symm
      _ ↔ ¬ wcLlsKPOk W A K 𝔭 y⁻¹ := not_congr ((O.valuation_le_one_iff _).trans (hmemO _))
  refine ⟨O, hmemO, ?_, hinj, fun π => OkW π, ?_, ?_⟩
  ·
    intro y
    constructor
    · rintro ⟨π, y', hπ, hy', rfl⟩
      by_cases hy : algebraMap A K (algebraMap ↥W A π) * y' = 0
      · rw [hy, map_zero]
        exact zero_lt_one
      · rw [V3 _ hy]
        intro hinv
        exact hS3 π _ hπ (OkMul _ _ hy' hinv) (by rw [← mul_assoc, mul_inv_cancel₀ hy])
    · intro hv
      by_cases hy : y = 0
      · exact ⟨0, 0, (IsLocalRing.maximalIdeal ↥W).zero_mem, Ok0, by rw [hy, mul_zero]⟩
      · have hni := (V3 y hy).mp hv
        obtain ⟨π, u, hπ0, hu, hui, h | h⟩ := hsplit y hy
        · by_cases hπm : π ∈ IsLocalRing.maximalIdeal ↥W
          · exact ⟨π, u, hπm, hu, h⟩
          · exfalso
            have hunit : IsUnit π := by
              by_contra h'
              exact hπm ((IsLocalRing.mem_maximalIdeal π).mpr h')
            have hπ' : π * ((hunit.unit⁻¹ : (↥W)ˣ) : ↥W) = 1 := hunit.mul_val_inv
            have e : algebraMap A K (algebraMap ↥W A π) *
                algebraMap A K (algebraMap ↥W A ((hunit.unit⁻¹ : (↥W)ˣ) : ↥W)) = 1 := by
              rw [← map_mul, ← map_mul, hπ', map_one, map_one]
            have hu0 : u ≠ 0 := by
              rintro rfl
              rw [mul_zero] at h
              exact hy h
            apply hni
            have hyi : y⁻¹ = u⁻¹ *
                algebraMap A K (algebraMap ↥W A ((hunit.unit⁻¹ : (↥W)ˣ) : ↥W)) := by
              apply inv_eq_of_mul_eq_one_right
              rw [h]
              calc algebraMap A K (algebraMap ↥W A π) * u * (u⁻¹ *
                    algebraMap A K (algebraMap ↥W A ((hunit.unit⁻¹ : (↥W)ˣ) : ↥W)))
                  = (algebraMap A K (algebraMap ↥W A π) *
                    algebraMap A K (algebraMap ↥W A ((hunit.unit⁻¹ : (↥W)ˣ) : ↥W))) *
                      (u * u⁻¹) := by ring
                _ = 1 := by rw [e, mul_inv_cancel₀ hu0, one_mul]
            rw [hyi]
            exact OkMul _ _ hui (OkW _)
        · exfalso
          apply hni
          rw [hinvR y π u hπ0 h]
          exact OkMul _ _ (OkW π) hui
  ·
    intro π
    constructor
    · intro hu
      have hπ' : π * ((hu.unit⁻¹ : (↥W)ˣ) : ↥W) = 1 := hu.mul_val_inv
      have e : algebraMap A K (algebraMap ↥W A π) *
          algebraMap A K (algebraMap ↥W A ((hu.unit⁻¹ : (↥W)ˣ) : ↥W)) = 1 := by
        rw [← map_mul, ← map_mul, hπ', map_one, map_one]
      refine ⟨OkW π, ?_, hu.ne_zero⟩
      show wcLlsKPOk W A K 𝔭 (algebraMap A K (algebraMap ↥W A π))⁻¹
      rw [inv_eq_of_mul_eq_one_right e]
      exact OkW _
    · rintro ⟨-, h2, h0⟩
      by_contra hnu
      have hm : π ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal π).mpr hnu
      exact hS3 π _ hm h2 (mul_inv_cancel₀ (hinj π h0))
  ·
    intro x hx
    obtain ⟨π, u, hπ, hu, hui, h⟩ := hsplit x hx
    exact ⟨π, u, hπ, hu, hui, h⟩

theorem wcLlsKPlb_coeff_section : ∀ (R k : Type u) [CommRing R] [Field k] (ℓ : ℕ), ℓ.Prime →
    CharP k ℓ → ((ℓ : ℕ) : R) = 0 → ∀ π : R →+* k, Function.Surjective π →
    (∀ r, π r = 0 → IsNilpotent r) → (∀ r : R, ∃ y, y ^ ℓ = r) →
    ∃ τ : k →+* R, ∀ a, π (τ a) = a :=
by
  intro R k _ _ ℓ hℓ hk hR π hsurj hnil hroot
  classical
  haveI := hk
  haveI : Fact ℓ.Prime := ⟨hℓ⟩

  have hunit : ∀ r : R, π r ≠ 0 → IsUnit r := by
    intro r hr
    obtain ⟨s, hs⟩ := hsurj (π r)⁻¹
    have h1 : IsNilpotent (r * s - 1) :=
      hnil _ (by rw [map_sub, map_mul, hs, map_one, mul_inv_cancel₀ hr, sub_self])
    have h2 : IsUnit (r * s) := by
      have := h1.isUnit_one_add
      rwa [add_sub_cancel] at this
    exact isUnit_of_mul_isUnit_left h2

  let S : Set (Subring (k × R)) :=
    {Γ | (∀ z ∈ Γ, π z.2 = z.1) ∧ (∀ z ∈ Γ, z.1 = 0 → z.2 = 0)}
  have hbot : (⊥ : Subring (k × R)) ∈ S := by
    refine ⟨fun z hz => ?_, fun z hz h0 => ?_⟩
    · obtain ⟨n, rfl⟩ := Subring.mem_bot.mp hz
      simp
    · obtain ⟨n, rfl⟩ := Subring.mem_bot.mp hz
      simp only [Prod.fst_intCast] at h0
      obtain ⟨m, rfl⟩ := (CharP.intCast_eq_zero_iff k ℓ n).mp h0
      simp [hR]
  obtain ⟨Γ, -, hΓmax⟩ := zorn_le_nonempty₀ S (by
    intro c hcS hc y hy
    refine ⟨sSup c, ?_, fun z hz => le_sSup hz⟩
    have hmem : ∀ x, x ∈ sSup c ↔ ∃ s ∈ c, x ∈ s := fun x =>
      Subring.mem_sSup_of_directedOn ⟨y, hy⟩ hc.directedOn
    refine ⟨fun z hz => ?_, fun z hz => ?_⟩
    · obtain ⟨s, hs, hzs⟩ := (hmem z).mp hz
      exact (hcS hs).1 z hzs
    · obtain ⟨s, hs, hzs⟩ := (hmem z).mp hz
      exact (hcS hs).2 z hzs) ⊥ hbot
  have hP1 : ∀ z ∈ Γ, π z.2 = z.1 := hΓmax.prop.1
  have hP2 : ∀ z ∈ Γ, z.1 = 0 → z.2 = 0 := hΓmax.prop.2

  have absorb : ∀ (A : Type u) [CommRing A] (j : A →+* k) (h : A →+* R),
      (∀ c, π (h c) = j c) → (∀ z ∈ Γ, ∃ c, j c = z.1 ∧ h c = z.2) →
      ∀ (a : k) (y : R), π y = a →
      (∀ p : Polynomial A, p.eval₂ j a = 0 → p.eval₂ h y = 0) → (a, y) ∈ Γ := by
    intro A _ j h hjh hcov a y hy hcompat
    let E : Polynomial A →+* k × R :=
      (Polynomial.eval₂RingHom j a).prod (Polynomial.eval₂RingHom h y)
    have hE : ∀ p : Polynomial A, E p = (p.eval₂ j a, p.eval₂ h y) := fun p => rfl
    have hle : Γ ≤ E.range := by
      intro z hz
      obtain ⟨c, h1, h2⟩ := hcov z hz
      refine ⟨Polynomial.C c, ?_⟩
      rw [hE, Polynomial.eval₂_C, Polynomial.eval₂_C, h1, h2]
    have hP1' : ∀ z ∈ E.range, π z.2 = z.1 := by
      rintro _ ⟨p, rfl⟩
      rw [hE, Polynomial.hom_eval₂, hy]
      congr 1
      exact RingHom.ext hjh
    have hP2' : ∀ z ∈ E.range, z.1 = 0 → z.2 = 0 := by
      rintro _ ⟨p, rfl⟩ h0
      rw [hE] at h0 ⊢
      exact hcompat p h0
    have hle' : E.range ≤ Γ := hΓmax.le_of_ge ⟨hP1', hP2'⟩ hle
    apply hle'
    refine ⟨Polynomial.X, ?_⟩
    rw [hE, Polynomial.eval₂_X, Polynomial.eval₂_X]

  have hinv : ∀ (a : k) (y : R), (a, y) ∈ Γ → ∃ y', (a⁻¹, y') ∈ Γ := by
    intro a y hay
    by_cases ha : a = 0
    · subst ha
      refine ⟨0, ?_⟩
      rw [inv_zero]
      exact Γ.zero_mem
    have hya : π y = a := hP1 _ hay
    obtain ⟨u, hu⟩ := hunit y (by rw [hya]; exact ha)
    refine ⟨((u⁻¹ : Rˣ) : R), absorb Γ ((RingHom.fst k R).comp Γ.subtype)
      ((RingHom.snd k R).comp Γ.subtype) (fun c => hP1 c.1 c.2)
      (fun z hz => ⟨⟨z, hz⟩, rfl, rfl⟩) a⁻¹ _ ?_ ?_⟩
    · have h1 : π y * π ((u⁻¹ : Rˣ) : R) = 1 := by
        rw [← map_mul, ← hu, Units.mul_inv, map_one]
      rw [hya] at h1
      exact eq_inv_of_mul_eq_one_right h1
    · intro p hp
      letI : Invertible a⁻¹ := invertibleOfNonzero (inv_ne_zero ha)
      have e1 := Polynomial.eval₂_reflect_mul_pow ((RingHom.fst k R).comp Γ.subtype) a⁻¹
        p.natDegree p le_rfl
      rw [invOf_eq_inv, inv_inv, hp] at e1
      have e2 : (p.reflect p.natDegree).eval₂ ((RingHom.fst k R).comp Γ.subtype) a = 0 :=
        (mul_eq_zero.mp e1).resolve_right (pow_ne_zero _ (inv_ne_zero ha))
      let z : Γ := ⟨(a, y), hay⟩
      have e3 : ((RingHom.fst k R).comp Γ.subtype) ((p.reflect p.natDegree).eval z) = 0 := by
        rw [← Polynomial.eval₂_hom]
        exact e2
      have e4 : ((RingHom.snd k R).comp Γ.subtype) ((p.reflect p.natDegree).eval z) = 0 :=
        hP2 _ ((p.reflect p.natDegree).eval z).2 e3
      rw [← Polynomial.eval₂_hom] at e4
      have e4' : (p.reflect p.natDegree).eval₂ ((RingHom.snd k R).comp Γ.subtype) y = 0 := e4
      letI : Invertible ((u⁻¹ : Rˣ) : R) :=
        { invOf := (u : R), invOf_mul_self := u.mul_inv, mul_invOf_self := u.inv_mul }
      have e5 := Polynomial.eval₂_reflect_mul_pow ((RingHom.snd k R).comp Γ.subtype)
        ((u⁻¹ : Rˣ) : R) p.natDegree p le_rfl
      rw [← e5]
      have e6 : ⅟((u⁻¹ : Rˣ) : R) = y := hu
      rw [e6, e4', zero_mul]

  obtain ⟨K0, hK0⟩ : ∃ K : Subfield k, ∀ a, a ∈ K ↔ ∃ y, (a, y) ∈ Γ :=
    ⟨{ carrier := {a | ∃ y, (a, y) ∈ Γ}
       zero_mem' := ⟨0, Γ.zero_mem⟩
       one_mem' := ⟨1, Γ.one_mem⟩
       add_mem' := fun {a b} ⟨y, hy⟩ ⟨y', hy'⟩ => ⟨y + y', Γ.add_mem hy hy'⟩
       neg_mem' := fun {a} ⟨y, hy⟩ => ⟨-y, Γ.neg_mem hy⟩
       mul_mem' := fun {a b} ⟨y, hy⟩ ⟨y', hy'⟩ => ⟨y * y', Γ.mul_mem hy hy'⟩
       inv_mem' := fun a ⟨y, hy⟩ => hinv a y hy }, fun a => Iff.rfl⟩
  have hfun : ∀ (a : k) (y y' : R), (a, y) ∈ Γ → (a, y') ∈ Γ → y = y' := by
    intro a y y' h h'
    have := hP2 _ (Γ.sub_mem h h') (by simp)
    simpa [sub_eq_zero] using this
  obtain ⟨f, hfΓ⟩ : ∃ f : K0 →+* R, ∀ x : K0, ((x : k), f x) ∈ Γ := by
    let g : Γ →+* K0 := ((RingHom.fst k R).comp Γ.subtype).codRestrict K0
      (fun z => (hK0 _).mpr ⟨(z : k × R).2, z.2⟩)
    have hg : Function.Bijective g := by
      constructor
      · rw [injective_iff_map_eq_zero]
        intro z hz
        have h1 : (z : k × R).1 = 0 := congrArg Subtype.val hz
        have h2 := hP2 _ z.2 h1
        exact Subtype.ext (Prod.ext h1 h2)
      · intro x
        obtain ⟨y, hy⟩ := (hK0 x).mp x.2
        exact ⟨⟨((x : k), y), hy⟩, rfl⟩
    let e := RingEquiv.ofBijective g hg
    refine ⟨((RingHom.snd k R).comp Γ.subtype).comp (e.symm : K0 →+* Γ), fun x => ?_⟩
    have h1 : g (e.symm x) = x := e.apply_symm_apply x
    have h2 : ((e.symm x : Γ) : k × R).1 = x := congrArg Subtype.val h1
    have h3 := (e.symm x).2
    have h4 : ((x : k), ((RingHom.snd k R).comp Γ.subtype).comp (e.symm : K0 →+* Γ) x) =
        ((e.symm x : Γ) : k × R) := Prod.ext h2.symm rfl
    rw [h4]
    exact h3
  have hf : ∀ x : K0, π (f x) = x := fun x => hP1 _ (hfΓ x)
  have absK : ∀ (a : k) (y : R), π y = a →
      (∀ p : Polynomial K0, Polynomial.aeval a p = 0 → p.eval₂ f y = 0) → a ∈ K0 := by
    intro a y hy hc
    have := absorb K0 K0.subtype f (fun c => hf c)
      (fun z hz => ⟨⟨z.1, (hK0 _).mpr ⟨z.2, hz⟩⟩, rfl,
        hfun z.1 _ z.2 (hfΓ ⟨z.1, (hK0 _).mpr ⟨z.2, hz⟩⟩) hz⟩) a y hy
      (fun p hp => hc p (by rw [Polynomial.aeval_def]; exact hp))
    exact (hK0 a).mpr ⟨y, this⟩

  have hsepstep : ∀ a : k, (minpoly K0 a).Separable → a ∈ K0 := by
    intro a hsep
    letI : Algebra K0 R := f.toAlgebra
    obtain ⟨y₀, hy₀⟩ := hsurj a
    have hπf : π.comp (algebraMap K0 R) = algebraMap K0 k := RingHom.ext fun x => hf x
    have key : ∀ (q : Polynomial K0) (r : R),
        π (Polynomial.aeval r q) = Polynomial.aeval (π r) q := by
      intro q r
      rw [Polynomial.aeval_def, Polynomial.aeval_def, Polynomial.hom_eval₂, hπf]
    have h1 : IsNilpotent (Polynomial.aeval y₀ (minpoly K0 a)) :=
      hnil _ (by rw [key, hy₀]; exact minpoly.aeval K0 a)
    have h2 : IsUnit (Polynomial.aeval y₀ (Polynomial.derivative (minpoly K0 a))) :=
      hunit _ (by rw [key, hy₀]; exact hsep.aeval_derivative_ne_zero (minpoly.aeval K0 a))
    obtain ⟨r, ⟨hr1, hr2⟩, -⟩ := Polynomial.existsUnique_nilpotent_sub_and_aeval_eq_zero h1 h2
    have hπr : π r = a := by
      have := (hr1.map π).eq_zero
      rw [map_sub, hy₀, sub_eq_zero] at this
      exact this.symm
    apply absK a r hπr
    intro p hp
    obtain ⟨q, rfl⟩ := minpoly.dvd K0 a hp
    rw [Polynomial.eval₂_mul]
    have : (minpoly K0 a).eval₂ f r = 0 := by
      rw [Polynomial.aeval_def] at hr2
      exact hr2
    rw [this, zero_mul]

  have frob_inj : ∀ x x' : k, x ^ ℓ = x' ^ ℓ → x = x' := by
    intro x x' h
    have : (x - x') ^ ℓ = 0 := by rw [sub_pow_char, h, sub_self]
    exact sub_eq_zero.mp ((pow_eq_zero_iff hℓ.ne_zero).mp this)
  have hrootstep : ∀ a : k, a ∉ K0 → a ^ ℓ ∈ K0 → a ∈ K0 := by
    intro a ha hb
    let b : K0 := ⟨a ^ ℓ, hb⟩
    obtain ⟨y, hy⟩ := hroot (f b)
    have hπy : π y = a := frob_inj _ _ (by rw [← map_pow, hy, hf])
    have hnoroot : ∀ c : K0, c ^ ℓ ≠ b := by
      intro c hc
      apply ha
      have : (c : k) = a := frob_inj _ _ (by
        have h := congrArg Subtype.val hc
        rw [SubmonoidClass.coe_pow] at h
        exact h)
      rw [← this]
      exact c.2
    have hirr := X_pow_sub_C_irreducible_of_prime hℓ hnoroot
    have hmin : Polynomial.X ^ ℓ - Polynomial.C b = minpoly K0 a :=
      minpoly.eq_of_irreducible_of_monic hirr
        (by
          rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
          exact sub_self _)
        (Polynomial.monic_X_pow_sub_C b hℓ.ne_zero)
    apply absK a y hπy
    intro p hp
    obtain ⟨q, rfl⟩ := minpoly.dvd K0 a hp
    rw [Polynomial.eval₂_mul, ← hmin]
    simp [hy]

  have hall : ∀ a : k, a ∈ K0 := by
    intro a
    by_cases hint : _root_.IsIntegral K0 a
    · obtain ⟨n, g, hg, hgeq⟩ :=
        Polynomial.exists_separable_of_irreducible ℓ (minpoly.irreducible hint) hℓ.ne_zero
      have hroot_g : Polynomial.aeval (a ^ (ℓ ^ n)) g = 0 := by
        rw [← Polynomial.expand_aeval, hgeq, minpoly.aeval]
      have h0 : a ^ (ℓ ^ n) ∈ K0 := hsepstep _ (hg.of_dvd (minpoly.dvd _ _ hroot_g))
      have hdesc : ∀ j, j ≤ n → a ^ (ℓ ^ (n - j)) ∈ K0 := by
        intro j
        induction j with
        | zero => intro _; simpa using h0
        | succ j ih =>
          intro hj
          have h1 := ih (by omega)
          have e : n - j = (n - (j + 1)) + 1 := by omega
          rw [e, pow_succ, pow_mul] at h1
          by_contra hc
          exact hc (hrootstep _ hc h1)
      simpa using hdesc n le_rfl
    · obtain ⟨y₀, hy₀⟩ := hsurj a
      apply absK a y₀ hy₀
      intro p hp
      by_cases hp0 : p = 0
      · rw [hp0, Polynomial.eval₂_zero]
      · exact absurd (IsAlgebraic.isIntegral ⟨p, hp0, hp⟩) hint
  exact ⟨f.comp ((RingHom.id k).codRestrict K0 hall), fun a => hf _⟩

theorem wcLlsKPlb_pole_norm : ∀ (κ F : Type u) [Field κ] [IsAlgClosed κ] [Field F] [Algebra κ F]
    (x : F), Transcendental κ x → FiniteDimensional ↥(IntermediateField.adjoin κ {x}) F →
    Algebra.IsSeparable ↥(IntermediateField.adjoin κ {x}) F →
    ∃ N : F → ℕ, (∀ f g, N (f + g) ≤ max (N f) (N g)) ∧
      (∀ (c : κ) f, c ≠ 0 → N (algebraMap κ F c * f) = N f) ∧
      (∀ f (n : ℕ), N (f ^ n) = n * N f) ∧
      (∀ f, N f = 0 ↔ f ∈ Set.range (algebraMap κ F)) :=
by
  intro κ F _ _ _ _ x _ hfd hsep
  classical

  have s2 : ∀ (D : Type u) [CommRing D] [IsDedekindDomain D] [Algebra D F] [IsFractionRing D F],
      ∃ P : F → ℕ, (∀ f g, P (f + g) ≤ max (P f) (P g)) ∧
        (∀ (d : D) (f : F), IsUnit d → P (algebraMap D F d * f) = P f) ∧
        (∀ (f : F) (n : ℕ), P (f ^ n) = n * P f) ∧
        (∀ f, P f = 0 ↔ f ∈ Set.range (algebraMap D F)) := by
    intro D _ _ _ _
    have hex : ∀ f : F, ∃ n : ℕ, ∀ v : IsDedekindDomain.HeightOneSpectrum D,
        v.valuation F f ≤ WithZero.exp (n : ℤ) := by
      intro f
      have hfin := IsDedekindDomain.HeightOneSpectrum.Support.finite D f
      refine ⟨∑ w ∈ hfin.toFinset, (WithZero.log (w.valuation F f)).toNat, ?_⟩
      intro v
      by_cases hv : v ∈ IsDedekindDomain.HeightOneSpectrum.Support D f
      · have h1 : (1 : WithZero (Multiplicative ℤ)) < v.valuation F f := hv
        have h0 : v.valuation F f ≠ 0 := ne_of_gt (lt_trans zero_lt_one h1)
        rw [← WithZero.exp_log h0, WithZero.exp_le_exp]
        have h2 : (WithZero.log (v.valuation F f)).toNat ≤
            ∑ w ∈ hfin.toFinset, (WithZero.log (w.valuation F f)).toNat :=
          Finset.single_le_sum (f := fun w => (WithZero.log (w.valuation F f)).toNat)
            (fun _ _ => Nat.zero_le _) (hfin.mem_toFinset.mpr hv)
        have h3 := Int.self_le_toNat (WithZero.log (v.valuation F f))
        exact h3.trans (by exact_mod_cast h2)
      · have h1 : ¬ (1 : WithZero (Multiplicative ℤ)) < v.valuation F f := hv
        have h1' : v.valuation F f ≤ 1 := le_of_not_gt h1
        refine h1'.trans ?_
        rw [← WithZero.exp_zero]
        exact WithZero.exp_le_exp.mpr (Int.natCast_nonneg _)
    have hstar : ∀ (f : F) (n : ℕ), Nat.find (hex f) ≤ n ↔
        ∀ v : IsDedekindDomain.HeightOneSpectrum D, v.valuation F f ≤ WithZero.exp (n : ℤ) := by
      intro f n
      constructor
      · intro h v
        refine (Nat.find_spec (hex f) v).trans ?_
        exact WithZero.exp_le_exp.mpr (by exact_mod_cast h)
      · intro h
        exact Nat.find_min' (hex f) h
    refine ⟨fun f => Nat.find (hex f), ?_, ?_, ?_, ?_⟩
    ·
      intro f g
      rw [hstar]
      intro v
      have hf := (hstar f _).mp le_rfl v
      have hg := (hstar g _).mp le_rfl v
      refine (Valuation.map_add _ _ _).trans (max_le ?_ ?_)
      · exact hf.trans (WithZero.exp_le_exp.mpr (by exact_mod_cast le_max_left _ _))
      · exact hg.trans (WithZero.exp_le_exp.mpr (by exact_mod_cast le_max_right _ _))
    ·
      intro d f hd
      obtain ⟨u, rfl⟩ := hd
      have hval : ∀ v : IsDedekindDomain.HeightOneSpectrum D,
          v.valuation F (algebraMap D F (u : D) * f) = v.valuation F f := by
        intro v
        have ha := IsDedekindDomain.HeightOneSpectrum.valuation_le_one (K := F) v (u : D)
        have hb := IsDedekindDomain.HeightOneSpectrum.valuation_le_one (K := F) v
          ((u⁻¹ : Dˣ) : D)
        have hab : v.valuation F (algebraMap D F (u : D)) *
            v.valuation F (algebraMap D F ((u⁻¹ : Dˣ) : D)) = 1 := by
          rw [← map_mul, ← map_mul, Units.mul_inv, map_one, map_one]
        have h1 : v.valuation F (algebraMap D F (u : D)) = 1 := by
          apply le_antisymm ha
          calc (1 : WithZero (Multiplicative ℤ)) = _ := hab.symm
            _ ≤ v.valuation F (algebraMap D F (u : D)) := mul_le_of_le_one_right' hb
        rw [map_mul, h1, one_mul]
      apply le_antisymm
      · rw [hstar]
        intro v
        rw [hval v]
        exact (hstar f _).mp le_rfl v
      · rw [hstar]
        intro v
        rw [← hval v]
        exact (hstar _ _).mp le_rfl v
    ·
      intro f n
      apply le_antisymm
      · rw [hstar]
        intro v
        rw [map_pow]
        calc v.valuation F f ^ n ≤ (WithZero.exp ((Nat.find (hex f) : ℕ) : ℤ)) ^ n :=
              pow_le_pow_left' ((hstar f _).mp le_rfl v) n
          _ = WithZero.exp (((n * Nat.find (hex f) : ℕ)) : ℤ) := by
              rw [← WithZero.exp_nsmul]
              congr 1
      · rcases Nat.eq_zero_or_pos n with hn | hn
        · subst hn
          simp
        · set m := Nat.find (hex (f ^ n)) with hm
          have hQ := (hstar (f ^ n) m).mp le_rfl
          have hle : Nat.find (hex f) ≤ m / n := by
            rw [hstar]
            intro v
            by_cases h0 : v.valuation F f = 0
            · rw [h0]
              exact zero_le'
            · have hv := hQ v
              rw [map_pow, ← WithZero.exp_log h0, ← WithZero.exp_nsmul,
                WithZero.exp_le_exp] at hv
              rw [← WithZero.exp_log h0, WithZero.exp_le_exp]
              rw [nsmul_eq_mul] at hv
              rw [Int.natCast_div, Int.le_ediv_iff_mul_le (by exact_mod_cast hn)]
              linarith
          calc n * Nat.find (hex f) ≤ n * (m / n) := Nat.mul_le_mul_left n hle
            _ ≤ m := Nat.mul_div_le m n
    ·
      intro f
      rw [← Nat.le_zero, hstar]
      constructor
      · intro h
        have h' : ∀ v : IsDedekindDomain.HeightOneSpectrum D, v.valuation F f ≤ 1 := by
          intro v
          have := h v
          rwa [Nat.cast_zero, WithZero.exp_zero] at this
        exact RingHom.mem_range.mp
          (IsDedekindDomain.HeightOneSpectrum.mem_integers_of_valuation_le_one F f h')
      · rintro ⟨r, rfl⟩ v
        rw [Nat.cast_zero, WithZero.exp_zero]
        exact IsDedekindDomain.HeightOneSpectrum.valuation_le_one v r

  have hmem : ∀ (A : Subalgebra κ F) (c : κ), algebraMap κ F c ∈ integralClosure A F := by
    intro A c
    have := (integralClosure A F).algebraMap_mem (algebraMap κ A c)
    rwa [← IsScalarTower.algebraMap_apply] at this

  have s3 : ∀ (y : F) (E : IntermediateField κ F), IntermediateField.adjoin κ {y} = E →
      FiniteDimensional E F → Algebra.IsSeparable E F →
      IsDedekindDomain (integralClosure (Algebra.adjoin κ {y}) F) ∧
        IsFractionRing (integralClosure (Algebra.adjoin κ {y}) F) F := by
    intro y E hE hfdE hsepE
    have hle : Algebra.adjoin κ {y} ≤ E.toSubalgebra := by
      rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff, ← hE]
      exact IntermediateField.mem_adjoin_simple_self κ y
    let ι : Algebra.adjoin κ {y} →+* E :=
      { toFun := fun a => ⟨a, hle a.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    letI : Algebra (Algebra.adjoin κ {y}) E := ι.toAlgebra
    haveI : IsScalarTower (Algebra.adjoin κ {y}) E F :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    set y' : Algebra.adjoin κ {y} := ⟨y, Algebra.self_mem_adjoin_singleton κ y⟩ with hy'
    have hcoe : ∀ p : Polynomial κ, ((Polynomial.aeval y' p : Algebra.adjoin κ {y}) : F) =
        Polynomial.aeval y p := by
      intro p
      rw [Polynomial.aeval_subalgebra_coe]
    have hsurj : Function.Surjective (Polynomial.aeval y' : Polynomial κ →ₐ[κ] _) := by
      intro a
      have ha : (a : F) ∈ (Polynomial.aeval y : Polynomial κ →ₐ[κ] F).range := by
        rw [← Algebra.adjoin_singleton_eq_range_aeval]
        exact a.2
      obtain ⟨p, hp⟩ := ha
      exact ⟨p, Subtype.ext ((hcoe p).trans hp)⟩
    haveI : IsPrincipalIdealRing (Algebra.adjoin κ {y}) :=
      IsPrincipalIdealRing.of_surjective _ hsurj
    haveI : IsDedekindDomain (Algebra.adjoin κ {y}) :=
      IsPrincipalIdealRing.isDedekindDomain _
    haveI : FaithfulSMul (Algebra.adjoin κ {y}) E := by
      rw [faithfulSMul_iff_algebraMap_injective]
      intro a b hab
      apply Subtype.ext
      have := congrArg (fun z : E => (z : F)) hab
      exact this
    haveI : IsFractionRing (Algebra.adjoin κ {y}) E := by
      apply IsFractionRing.of_field
      intro z
      have hz : (z : F) ∈ IntermediateField.adjoin κ {y} := by rw [hE]; exact z.2
      obtain ⟨r, s, hrs⟩ := (IntermediateField.mem_adjoin_simple_iff κ _).mp hz
      refine ⟨Polynomial.aeval y' r, Polynomial.aeval y' s, ?_⟩
      apply Subtype.ext
      rw [IntermediateField.coe_div]
      show (z : F) = ((Polynomial.aeval y' r : Algebra.adjoin κ {y}) : F) /
        ((Polynomial.aeval y' s : Algebra.adjoin κ {y}) : F)
      rw [hcoe, hcoe]
      exact hrs
    exact ⟨integralClosure.isDedekindDomain (Algebra.adjoin κ {y}) E F,
      integralClosure.isFractionRing_of_finite_extension E F⟩

  have s4 : ∀ (z f : F), _root_.IsIntegral (Algebra.adjoin κ {z}) f →
      _root_.IsIntegral (Algebra.adjoin κ {z⁻¹}) f → f ∈ Set.range (algebraMap κ F) := by
    intro z f h0 hinf
    by_contra hf
    have hf0 : f ≠ 0 := fun h => hf ⟨0, by rw [h, map_zero]⟩
    have hnint : ¬ _root_.IsIntegral κ f := by
      intro hi
      apply hf
      exact RingHom.mem_range.mp (minpoly.mem_range_of_degree_eq_one κ f
        (IsAlgClosed.degree_eq_one_of_irreducible κ (minpoly.irreducible hi)))
    have hfR : f ∉ (integralClosure (Algebra.adjoin κ {f⁻¹}) F).toSubring := by
      intro h
      exact hnint (isIntegral_of_isIntegral_adjoin_of_mul_eq_one f f⁻¹ (inv_mul_cancel₀ hf0) h)
    obtain ⟨V, hRV, hfV⟩ := Subring.exists_le_valuationSubring_of_isIntegrallyClosedIn hfR
    have hκV : ∀ c : κ, algebraMap κ F c ∈ V := fun c => hRV (hmem _ c)
    let Vκ : Subalgebra κ F := { V.toSubring with algebraMap_mem' := hκV }
    have hcase : ∀ y : F, y ∈ V → _root_.IsIntegral (Algebra.adjoin κ {y}) f → False := by
      intro y hy hint
      have hle : Algebra.adjoin κ {y} ≤ Vκ :=
        Algebra.adjoin_le (Set.singleton_subset_iff.mpr hy)
      let φ : Algebra.adjoin κ {y} →+* V :=
        { toFun := fun a => ⟨a, hle a.2⟩
          map_one' := rfl
          map_mul' := fun _ _ => rfl
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      have hV : _root_.IsIntegral V f :=
        _root_.IsIntegral.map_of_comp_eq φ (RingHom.id F) (RingHom.ext fun _ => rfl) hint
      obtain ⟨w, hw⟩ := IsIntegrallyClosed.isIntegral_iff.mp hV
      apply hfV
      rw [← hw]
      exact w.2
    rcases V.mem_or_inv_mem z with hz | hz
    · exact hcase z hz h0
    · exact hcase z⁻¹ hz hinf

  have s1 : IntermediateField.adjoin κ {x⁻¹} = IntermediateField.adjoin κ {x} := by
    apply le_antisymm
    · rw [IntermediateField.adjoin_simple_le_iff]
      exact IntermediateField.inv_mem _ (IntermediateField.mem_adjoin_simple_self κ x)
    · rw [IntermediateField.adjoin_simple_le_iff]
      have := IntermediateField.inv_mem _ (IntermediateField.mem_adjoin_simple_self κ x⁻¹)
      rwa [inv_inv] at this

  obtain ⟨hD0, hF0⟩ := s3 x _ rfl hfd hsep
  obtain ⟨hD1, hF1⟩ := s3 x⁻¹ _ s1 hfd hsep
  obtain ⟨P0, a0, b0, c0, d0⟩ := s2 (integralClosure (Algebra.adjoin κ {x}) F)
  obtain ⟨P1, a1, b1, c1, d1⟩ := s2 (integralClosure (Algebra.adjoin κ {x⁻¹}) F)
  have hunit : ∀ (A : Subalgebra κ F) (c : κ), c ≠ 0 →
      IsUnit (⟨algebraMap κ F c, hmem A c⟩ : integralClosure A F) := by
    intro A c hc
    refine isUnit_iff_exists_inv.mpr
      ⟨(⟨algebraMap κ F c⁻¹, hmem A c⁻¹⟩ : integralClosure A F), ?_⟩
    apply Subtype.ext
    show algebraMap κ F c * algebraMap κ F c⁻¹ = 1
    rw [← map_mul, mul_inv_cancel₀ hc, map_one]
  refine ⟨fun f => max (P0 f) (P1 f), ?_, ?_, ?_, ?_⟩
  · intro f g
    have h0 := a0 f g
    have h1 := a1 f g
    simp only
    omega
  · intro c f hc
    simp only
    have e0 : P0 (algebraMap κ F c * f) = P0 f := b0 ⟨algebraMap κ F c, hmem _ c⟩ f (hunit _ c hc)
    have e1 : P1 (algebraMap κ F c * f) = P1 f := b1 ⟨algebraMap κ F c, hmem _ c⟩ f (hunit _ c hc)
    rw [e0, e1]
  · intro f n
    simp only
    rw [c0, c1, Nat.mul_max_mul_left]
  · intro f
    simp only
    constructor
    · intro h
      have h0 : P0 f = 0 := by omega
      have h1 : P1 f = 0 := by omega
      obtain ⟨r0, hr0⟩ := (d0 f).mp h0
      obtain ⟨r1, hr1⟩ := (d1 f).mp h1
      apply s4 x f
      · rw [← hr0]
        exact (mem_integralClosure_iff _ _).mp r0.2
      · rw [← hr1]
        exact (mem_integralClosure_iff _ _).mp r1.2
    · rintro ⟨c, rfl⟩
      have h0 : P0 (algebraMap κ F c) = 0 := (d0 _).mpr ⟨⟨algebraMap κ F c, hmem _ c⟩, rfl⟩
      have h1 : P1 (algebraMap κ F c) = 0 := (d1 _).mpr ⟨⟨algebraMap κ F c, hmem _ c⟩, rfl⟩
      rw [h0, h1]
      rfl

theorem wcLlsKPlb_layered_from_norm : ∀ (κ F : Type u) [Field κ] [Field F] [Algebra κ F] (ℓ : ℕ),
    ℓ.Prime → CharP F ℓ → PerfectField κ → ∀ N : F → ℕ,
    (∀ f g, N (f + g) ≤ max (N f) (N g)) →
    (∀ (c : κ) f, c ≠ 0 → N (algebraMap κ F c * f) = N f) →
    (∀ f, N (f ^ ℓ) = ℓ * N f) →
    (∀ f, N f = 0 ↔ f ∈ Set.range (algebraMap κ F)) →
    ∃ (ι : Type u) (ut : ι → F),
      (∀ c : Option (ι × ℕ) →₀ κ, (c.sum fun i a => algebraMap κ F a *
        Option.elim i 1 (fun p => ut p.1 ^ (ℓ ^ p.2))) = 0 → c = 0) ∧
      (∀ f : F, ∃ c : Option (ι × ℕ) →₀ κ, (c.sum fun i a => algebraMap κ F a *
        Option.elim i 1 (fun p => ut p.1 ^ (ℓ ^ p.2))) = f) ∧
      (∀ c : ι →₀ κ, c ≠ 0 → ∀ y : F, (c.sum fun j a => algebraMap κ F a * ut j) ≠ y ^ ℓ) :=
by
  intro κ F _ _ _ ℓ hℓ hF hκ N hN1 hN2 hN3 hN4
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  have hinj : Function.Injective (algebraMap κ F) := (algebraMap κ F).injective
  haveI : CharP κ ℓ := (algebraMap κ F).charP hinj ℓ
  haveI : ExpChar κ ℓ := ExpChar.prime hℓ
  haveI : ExpChar F ℓ := ExpChar.prime hℓ
  haveI : PerfectRing κ ℓ := PerfectField.toPerfectRing ℓ
  obtain ⟨r, hr⟩ : ∃ r : κ → κ, ∀ a, r a ^ ℓ = a :=
    ⟨fun a => (frobeniusEquiv κ ℓ).symm a, fun a => frobeniusEquiv_symm_pow_p κ ℓ a⟩
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero
  have hN0 : N 0 = 0 := (hN4 0).mpr ⟨0, map_zero _⟩
  have hNneg : ∀ f, N (-f) = N f := by
    intro f
    have h := hN2 (-1) f (neg_ne_zero.mpr one_ne_zero)
    rwa [map_neg, map_one, neg_one_mul] at h
  have hNsmul : ∀ (c : κ) (f : F), c ≠ 0 → N (c • f) = N f := by
    intro c f hc; rw [Algebra.smul_def]; exact hN2 c f hc
  have hconv : ∀ {α : Type u} (v : α → F) (c : α →₀ κ),
      (c.sum fun i a => algebraMap κ F a * v i) = Finsupp.linearCombination κ v c := by
    intro α v c
    rw [Finsupp.linearCombination_apply]
    simp only [Algebra.smul_def]

  obtain ⟨P, hPmem⟩ : ∃ P : Submodule κ F, ∀ x, x ∈ P ↔ ∃ y : F, y ^ ℓ = x :=
    ⟨{ carrier := {x | ∃ y : F, y ^ ℓ = x}
       add_mem' := by
         rintro _ _ ⟨y, rfl⟩ ⟨z, rfl⟩
         exact ⟨y + z, add_pow_char y z ℓ⟩
       zero_mem' := ⟨0, zero_pow hℓ0⟩
       smul_mem' := by
         rintro a _ ⟨y, rfl⟩
         refine ⟨algebraMap κ F (r a) * y, ?_⟩
         rw [mul_pow, ← map_pow, hr, Algebra.smul_def] }, fun x => Iff.rfl⟩

  obtain ⟨Q, hQ⟩ : ∃ Q : ℕ → Set (F ⧸ P), ∀ n, Q n = P.mkQ '' {f | N f ≤ n} :=
    ⟨_, fun _ => rfl⟩
  have hQmono : ∀ m n, m ≤ n → Q m ⊆ Q n := by
    intro m n h
    rw [hQ, hQ]
    exact Set.image_mono (fun f (hf : N f ≤ m) => (le_trans hf h : N f ≤ n))
  obtain ⟨T, hTind, hTsucc, hTQ, hQT⟩ : ∃ T : ℕ → Set (F ⧸ P),
      (∀ n, LinearIndepOn κ id (T n)) ∧ (∀ n, T n ⊆ T (n + 1)) ∧ (∀ n, T n ⊆ Q n) ∧
      (∀ n, Q n ⊆ Submodule.span κ (T n)) := by
    let Tb : ℕ → {t : Set (F ⧸ P) // LinearIndepOn κ id t} := fun n =>
      Nat.rec (motive := fun _ => {t : Set (F ⧸ P) // LinearIndepOn κ id t})
        ⟨(linearIndepOn_empty κ id).extend (Set.empty_subset (Q 0)),
          (linearIndepOn_empty κ id).linearIndepOn_extend _⟩
        (fun n t => ⟨t.2.extend (Set.subset_union_left (t := Q (n + 1))),
          t.2.linearIndepOn_extend _⟩) n
    have h0 : Tb 0 = ⟨(linearIndepOn_empty κ id).extend (Set.empty_subset (Q 0)),
          (linearIndepOn_empty κ id).linearIndepOn_extend _⟩ := rfl
    have hs : ∀ n, Tb (n + 1) = ⟨(Tb n).2.extend (Set.subset_union_left (t := Q (n + 1))),
          (Tb n).2.linearIndepOn_extend _⟩ := fun n => rfl
    refine ⟨fun n => (Tb n).1, fun n => (Tb n).2, fun n => ?_, fun n => ?_, fun n => ?_⟩
    · show (Tb n).1 ⊆ (Tb (n + 1)).1
      rw [hs]
      exact (Tb n).2.subset_extend Set.subset_union_left
    · show (Tb n).1 ⊆ Q n
      induction n with
      | zero => rw [h0]; exact (linearIndepOn_empty κ id).extend_subset (Set.empty_subset (Q 0))
      | succ n ih =>
        rw [hs]
        exact ((Tb n).2.extend_subset (Set.subset_union_left (t := Q (n + 1)))).trans
          (Set.union_subset (ih.trans (hQmono n (n + 1) (Nat.le_succ n))) le_rfl)
    · show Q n ⊆ Submodule.span κ (Tb n).1
      cases n with
      | zero => rw [h0]; exact (linearIndepOn_empty κ id).subset_span_extend (Set.empty_subset (Q 0))
      | succ n =>
        rw [hs]
        exact Set.subset_union_right.trans ((Tb n).2.subset_span_extend (Set.subset_union_left (t := Q (n + 1))))
  have hTmono : Monotone T := monotone_nat_of_le_succ hTsucc
  set s : Set (F ⧸ P) := ⋃ n, T n with hs_def
  have hsind : LinearIndepOn κ id s := linearIndepOn_iUnion_of_directed hTmono.directed_le hTind
  have hex : ∀ i : s, ∃ n, (i : F ⧸ P) ∈ T n := fun i => Set.mem_iUnion.mp i.2
  have hrep : ∀ i : s, ∃ f : F, N f ≤ Nat.find (hex i) ∧ P.mkQ f = i := by
    intro i
    have h1 := hTQ _ (Nat.find_spec (hex i))
    rw [hQ] at h1
    obtain ⟨f, hf, hfi⟩ := h1
    exact ⟨f, hf, hfi⟩
  choose ut hutN hutq using hrep
  have hq_lc : ∀ c : s →₀ κ, P.mkQ (Finsupp.linearCombination κ ut c) =
      Finsupp.linearCombination κ (Subtype.val : s → F ⧸ P) c := by
    intro c
    rw [Finsupp.apply_linearCombination]
    have : (⇑P.mkQ ∘ ut) = Subtype.val := funext fun i => hutq i
    rw [this]
  have hInd : ∀ c : s →₀ κ, Finsupp.linearCombination κ ut c ∈ P → c = 0 := by
    intro c hc
    have h1 : Finsupp.linearCombination κ (Subtype.val : s → F ⧸ P) c = 0 := by
      rw [← hq_lc]; exact (Submodule.Quotient.mk_eq_zero P).mpr hc
    exact linearIndependent_iff.mp hsind.linearIndependent c h1
  have hApx : ∀ f : F, ∃ c : s →₀ κ, f - Finsupp.linearCombination κ ut c ∈ P ∧
      N (Finsupp.linearCombination κ ut c) ≤ N f := by
    intro f
    have h1 : P.mkQ f ∈ Submodule.span κ (T (N f)) :=
      hQT (N f) (show P.mkQ f ∈ Q (N f) by rw [hQ]; exact ⟨f, (le_rfl : N f ≤ N f), rfl⟩)
    have h2 : T (N f) = Subtype.val '' {i : s | (i : F ⧸ P) ∈ T (N f)} := by
      ext x
      constructor
      · intro hx
        exact ⟨⟨x, Set.mem_iUnion.mpr ⟨N f, hx⟩⟩, hx, rfl⟩
      · rintro ⟨i, hi, rfl⟩
        exact hi
    rw [h2, Finsupp.mem_span_image_iff_linearCombination] at h1
    obtain ⟨l, hl, hlf⟩ := h1
    refine ⟨l, ?_, ?_⟩
    · have h3 : P.mkQ (f - Finsupp.linearCombination κ ut l) = 0 := by
        rw [map_sub, hq_lc, hlf, sub_self]
      exact (Submodule.Quotient.mk_eq_zero P).mp h3
    · rw [Finsupp.linearCombination_apply]
      unfold Finsupp.sum
      apply Finset.sum_induction _ (fun x => N x ≤ N f)
      · intro a b ha hb; exact (hN1 a b).trans (max_le ha hb)
      · rw [hN0]; exact Nat.zero_le _
      · intro i hi
        have hli : l i ≠ 0 := Finsupp.mem_support_iff.mp hi
        have hiT : (i : F ⧸ P) ∈ T (N f) := (Finsupp.mem_supported κ l).mp hl hi
        rw [hNsmul _ _ hli]
        exact (hutN i).trans (Nat.find_min' (hex i) hiT)
  have hC : ∀ c : s →₀ κ, c ≠ 0 → ∀ y : F, Finsupp.linearCombination κ ut c ≠ y ^ ℓ := by
    intro c hc y h
    exact hc (hInd c ((hPmem _).mpr ⟨y, h.symm⟩))

  obtain ⟨b, hb⟩ : ∃ b : Option (s × ℕ) → F,
      b = fun i => Option.elim i 1 (fun p => ut p.1 ^ (ℓ ^ p.2)) := ⟨_, rfl⟩
  have hkey : ∀ c : Option (s × ℕ) →₀ κ, (c.sum fun i a => algebraMap κ F a *
      Option.elim i 1 (fun p => ut p.1 ^ (ℓ ^ p.2))) = Finsupp.linearCombination κ b c := by
    intro c; rw [hb]; exact hconv _ c
  have hb_none : b none = 1 := by rw [hb]; rfl
  have hb_some : ∀ j k, b (some (j, k)) = ut j ^ (ℓ ^ k) := by intro j k; rw [hb]; rfl
  obtain ⟨σ, hσ⟩ : ∃ σ : Option (s × ℕ) → Option (s × ℕ),
      σ = Option.map (fun p => (p.1, p.2 + 1)) := ⟨_, rfl⟩
  have hσ_none : σ none = none := by rw [hσ]; rfl
  have hσ_some : ∀ j k, σ (some (j, k)) = some (j, k + 1) := by intro j k; rw [hσ]; rfl
  have hbσ : ∀ i, b (σ i) = b i ^ ℓ := by
    intro i
    rcases i with _ | ⟨j, k⟩
    · rw [hσ_none, hb_none, one_pow]
    · rw [hσ_some, hb_some, hb_some, ← pow_mul, pow_succ]
  have hbι₀ : (b ∘ fun j : s => some (j, 0)) = ut := by
    funext j
    show b (some (j, 0)) = ut j
    rw [hb_some, pow_zero, pow_one]
  have hshift : ∀ d : Option (s × ℕ) →₀ κ,
      Finsupp.linearCombination κ b (d.sum fun i a => Finsupp.single (σ i) (a ^ ℓ)) =
        (Finsupp.linearCombination κ b d) ^ ℓ := by
    intro d
    rw [map_finsuppSum]
    simp only [Finsupp.linearCombination_single]
    conv_rhs => rw [Finsupp.linearCombination_apply]
    unfold Finsupp.sum
    rw [sum_pow_char]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    dsimp only
    rw [hbσ, Algebra.smul_def, Algebra.smul_def, mul_pow, map_pow]

  have hspan : ∀ n, ∀ f : F, N f = n → ∃ c, Finsupp.linearCombination κ b c = f := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro f hfn
      rcases Nat.eq_zero_or_pos n with h0 | hpos
      · obtain ⟨a, ha⟩ := (hN4 f).mp (hfn.trans h0)
        refine ⟨Finsupp.single none a, ?_⟩
        rw [Finsupp.linearCombination_single, hb_none, Algebra.smul_def, mul_one, ha]
      · obtain ⟨c0, hc0P, hc0N⟩ := hApx f
        obtain ⟨y, hy⟩ := (hPmem _).mp hc0P
        have h1 : N (y ^ ℓ) ≤ N f := by
          rw [hy, sub_eq_add_neg]
          exact (hN1 _ _).trans (max_le le_rfl (by rw [hNneg]; exact hc0N))
        rw [hN3, hfn] at h1
        have h2 := hℓ.two_le
        have hNy : N y < n := by nlinarith
        obtain ⟨d, hd⟩ := ih (N y) hNy y rfl
        refine ⟨Finsupp.mapDomain (fun j : s => some (j, 0)) c0 +
          (d.sum fun i a => Finsupp.single (σ i) (a ^ ℓ)), ?_⟩
        rw [map_add, hshift, hd, Finsupp.linearCombination_mapDomain, hbι₀, hy]
        abel

  have hD : ∀ c : Option (s × ℕ) →₀ κ, ∃ (a : s →₀ κ) (c' : Option (s × ℕ) →₀ κ),
      Finsupp.linearCombination κ b c =
        Finsupp.linearCombination κ ut a + (Finsupp.linearCombination κ b c') ^ ℓ ∧
      (∀ j, a j = c (some (j, 0))) ∧ (∀ i, c' i ^ ℓ = c (σ i)) := by
    intro c
    induction c using Finsupp.induction_linear
    next =>
      exact ⟨0, 0, by simp [zero_pow hℓ0], fun j => by simp, fun i => by simp [zero_pow hℓ0]⟩
    next c1 c2 h1 h2 =>
      obtain ⟨a1, d1, e1, f1, g1⟩ := h1
      obtain ⟨a2, d2, e2, f2, g2⟩ := h2
      refine ⟨a1 + a2, d1 + d2, ?_, fun j => ?_, fun i => ?_⟩
      · rw [map_add, map_add, map_add, e1, e2, add_pow_char]; ring
      · rw [Finsupp.add_apply, Finsupp.add_apply, f1, f2]
      · rw [Finsupp.add_apply, Finsupp.add_apply, add_pow_char, g1, g2]
    next i x =>
      rcases i with _ | ⟨j, _ | k⟩
      · refine ⟨0, Finsupp.single none (r x), ?_, fun j' => ?_, fun i' => ?_⟩
        · rw [map_zero, zero_add]
          simp only [Finsupp.linearCombination_single, hb_none, Algebra.smul_def, mul_one]
          rw [← map_pow, hr]
        · simp
        · rcases i' with _ | ⟨j', k'⟩
          · rw [hσ_none, Finsupp.single_eq_same, Finsupp.single_eq_same, hr]
          · rw [hσ_some]; simp [zero_pow hℓ0]
      · refine ⟨Finsupp.single j x, 0, ?_, fun j' => ?_, fun i' => ?_⟩
        · rw [map_zero, zero_pow hℓ0, add_zero]
          simp only [Finsupp.linearCombination_single, hb_some, pow_zero, pow_one]
        · simp [Finsupp.single_apply]
        · rcases i' with _ | ⟨j', k'⟩
          · rw [hσ_none]; simp [zero_pow hℓ0]
          · rw [hσ_some]; simp [zero_pow hℓ0]
      · refine ⟨0, Finsupp.single (some (j, k)) (r x), ?_, fun j' => ?_, fun i' => ?_⟩
        · rw [map_zero, zero_add]
          simp only [Finsupp.linearCombination_single, hb_some, Algebra.smul_def]
          rw [mul_pow, ← map_pow, hr, ← pow_mul, ← pow_succ]
        · simp
        · rcases i' with _ | ⟨j', k'⟩
          · rw [hσ_none]; simp [zero_pow hℓ0]
          · rw [hσ_some]
            simp only [Finsupp.single_apply, Option.some.injEq, Prod.mk.injEq,
              Nat.add_right_cancel_iff]
            split_ifs <;> simp [hr, zero_pow hℓ0]

  have hclaim : ∀ n, ∀ c : Option (s × ℕ) →₀ κ, (∀ j k, c (some (j, k)) ≠ 0 → k < n) →
      Finsupp.linearCombination κ b c = 0 → c = 0 := by
    intro n
    induction n with
    | zero =>
      intro c hc hE
      have hc' : c = Finsupp.single none (c none) := by
        ext i
        rcases i with _ | ⟨j, k⟩
        · simp
        · rw [Finsupp.single_apply, if_neg (Option.some_ne_none (j, k)).symm]
          by_contra h
          exact absurd (hc j k h) (Nat.not_lt_zero k)
      rw [hc', Finsupp.linearCombination_single, hb_none, Algebra.smul_def, mul_one] at hE
      have h0 : c none = 0 := hinj (by rw [hE, map_zero])
      rw [hc', h0, Finsupp.single_zero]
    | succ n ih =>
      intro c hc hE
      obtain ⟨a, c', e1, f1, g1⟩ := hD c
      have hneg : (-(Finsupp.linearCombination κ b c')) ^ ℓ =
          -(Finsupp.linearCombination κ b c') ^ ℓ := by
        rw [neg_pow, neg_one_pow_char, neg_one_mul]
      have ha : a = 0 := by
        by_contra hne
        exact hC a hne (-(Finsupp.linearCombination κ b c')) (by
          rw [hneg]; linear_combination hE - e1)
      rw [ha, map_zero, zero_add] at e1
      have hX : (Finsupp.linearCombination κ b c') ^ ℓ = 0 := e1 ▸ hE
      have hE' : Finsupp.linearCombination κ b c' = 0 := (pow_eq_zero_iff hℓ0).mp hX
      have hc'0 : c' = 0 := by
        refine ih c' (fun j k h => ?_) hE'
        have h1 : c (some (j, k + 1)) ≠ 0 := by
          rw [← hσ_some, ← g1]; exact pow_ne_zero _ h
        have := hc j (k + 1) h1
        omega
      ext i
      rcases i with _ | ⟨j, _ | k⟩
      · have h := g1 none
        rw [hσ_none, hc'0, Finsupp.zero_apply, zero_pow hℓ0] at h
        rw [Finsupp.zero_apply, ← h]
      · have h := f1 j
        rw [ha, Finsupp.zero_apply] at h
        rw [Finsupp.zero_apply, ← h]
      · have h := g1 (some (j, k))
        rw [hσ_some, hc'0, Finsupp.zero_apply, zero_pow hℓ0] at h
        rw [Finsupp.zero_apply, ← h]
  have hA : ∀ c : Option (s × ℕ) →₀ κ, Finsupp.linearCombination κ b c = 0 → c = 0 := by
    intro c hE
    refine hclaim (c.support.sup fun i => Option.elim i 0 (fun p => p.2 + 1)) c
      (fun j k h => ?_) hE
    have hmem : some (j, k) ∈ c.support := Finsupp.mem_support_iff.mpr h
    have := Finset.le_sup (f := fun i : Option (s × ℕ) => Option.elim i 0 (fun p => p.2 + 1)) hmem
    exact Nat.lt_of_lt_of_le (Nat.lt_succ_self k) this
  refine ⟨s, ut, fun c hc => hA c (by rw [← hkey]; exact hc), fun f => ?_, fun c hc y => ?_⟩
  · obtain ⟨c, hc⟩ := hspan _ f rfl
    exact ⟨c, by rw [hkey]; exact hc⟩
  · rw [hconv ut c]; exact hC c hc y

theorem wcLlsKPlb_residue_transc : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ f : Polynomial ↥W, (∃ i, f.coeff i ∉ IsLocalRing.maximalIdeal ↥W) →
      ¬ wcLlsKPOM W A K 𝔭 (f.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K t)) :=
by
  have SDVR : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A] (𝔭 : Ideal A) [𝔭.IsPrime] (t h : A) (f₀ : Polynomial ↥W →+* Localization.Away h), (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 → h ∉ 𝔭 → 𝔭.map (algebraMap A (Localization.Away h)) = (Ideal.span {t} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map (algebraMap A (Localization.Away h)) → f₀.comp Polynomial.C = (algebraMap A (Localization.Away h)).comp (algebraMap ↥W A) → f₀ Polynomial.X = algebraMap A (Localization.Away h) t → RingHom.Etale f₀ → ∃ _ : IsDomain (Localization.AtPrime 𝔭 ⧸ ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map (algebraMap A (Localization.AtPrime 𝔭))), IsDiscreteValuationRing (Localization.AtPrime 𝔭 ⧸ ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map (algebraMap A (Localization.AtPrime 𝔭))) ∧ Irreducible (Ideal.Quotient.mk (((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map (algebraMap A (Localization.AtPrime 𝔭))) (algebraMap A (Localization.AtPrime 𝔭) t)) := by
    have wcpa_dj_llsm_tg_chart_basechange : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
        (A : Type u) [CommRing A] [Algebra ↥W A] (𝔭 : Ideal A) [𝔭.IsPrime] (h : A)
        (S : Type u) [CommRing S] [Algebra ↥W S] (f₀ : S →+* Localization.Away h)
        (P : Type u) [CommRing P] (π : S →+* P)
        (hm : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭) (hh : h ∉ 𝔭)
        (hf : f₀.comp (algebraMap ↥W S) =
          (algebraMap A (Localization.Away h)).comp (algebraMap ↥W A))
        (het : RingHom.Etale f₀) (hπ : Function.Surjective π)
        (hker : RingHom.ker π = (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W S)),
        ∃ (E : Type u) (_ : CommRing E) (fb : P →+* E)
          (ρ : Localization.Away h →+* E) (q : Ideal E) (_ : q.IsPrime),
          RingHom.Etale fb ∧ Function.Surjective ρ ∧
          RingHom.ker ρ = ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
            (algebraMap A (Localization.Away h)) ∧
          (∀ s, fb (π s) = ρ (f₀ s)) ∧
          q = (𝔭.map (algebraMap A (Localization.Away h))).map ρ ∧
          Nonempty ((Localization.AtPrime 𝔭 ⧸
            ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
              (algebraMap A (Localization.AtPrime 𝔭))) ≃+* Localization.AtPrime q) := by
      intro Ω _ W A _ _ 𝔭 _ h S _ _ f₀ P _ π hm hh hf het hπ hker
      have hK : (RingHom.ker π).map f₀ = ((IsLocalRing.maximalIdeal ↥W).map
          (algebraMap ↥W A)).map (algebraMap A (Localization.Away h)) := by
        rw [hker, Ideal.map_map, hf, ← Ideal.map_map]
      have s1 : ∃ fb : P →+* Localization.Away h ⧸ ((IsLocalRing.maximalIdeal ↥W).map
            (algebraMap ↥W A)).map (algebraMap A (Localization.Away h)),
          RingHom.Etale fb ∧ ∀ s, fb (π s) = Ideal.Quotient.mk _ (f₀ s) := by
        generalize ((IsLocalRing.maximalIdeal ↥W).map
          (algebraMap ↥W A)).map (algebraMap A (Localization.Away h)) = K at hK ⊢
        letI := f₀.toAlgebra
        haveI : Algebra.Etale S (Localization.Away h) := het
        set J := RingHom.ker π with hJ
        have h1 : RingHom.Etale (algebraMap (S ⧸ J) (TensorProduct S (S ⧸ J) (Localization.Away h))) :=
          RingHom.etale_algebraMap.mpr inferInstance
        let e₁ : TensorProduct S (S ⧸ J) (Localization.Away h) ≃+*
            Localization.Away h ⧸ J.map (algebraMap S (Localization.Away h)) :=
          (Algebra.TensorProduct.comm S (S ⧸ J) (Localization.Away h)).toRingEquiv.trans
            (Algebra.TensorProduct.quotIdealMapEquivTensorQuot (Localization.Away h) J).symm.toRingEquiv
        let e₂ : Localization.Away h ⧸ J.map (algebraMap S (Localization.Away h)) ≃+*
            Localization.Away h ⧸ K := Ideal.quotEquivOfEq hK
        let e := e₁.trans e₂
        let g := e.toRingHom.comp (algebraMap (S ⧸ J) (TensorProduct S (S ⧸ J) (Localization.Away h)))
        have hg : RingHom.Etale g := RingHom.Etale.respectsIso.1 _ _ h1
