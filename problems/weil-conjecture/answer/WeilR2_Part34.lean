        have hwit : wcLlsAnnSep W A' K L u (b₀ * βs) := by rw [← hbseq]; exact hseps
        have hiff₃ := wcpa_dj_llsm_br_inner_sep_iff Ω W hW hWt A' K L 𝔭' u v g b₀ q βs y' A₃ u₃
          v₃ 𝔭₃ hPD hyp hyc hU hb₀m hb₀0 hqm hgq hA hβs hβs0 hβsq hwit hsub₃ hu₃ hv₃ hPD₃
        by_cases hex : ∃ y₃ : Ideal ↥(integralClosure A₃ L), y₃.IsPrime ∧
            y₃.comap (algebraMap A₃ ↥(integralClosure A₃ L)) = 𝔭₃ ∧ wcLlsDec A₃ K L y₃ = ⊤
        · obtain ⟨y₃, hy₃p, hy₃c, hTop₃⟩ := hex
          have hU₃ := (wcpa_dj_llsm_br_dec_top_iff A₃ K L hPD₃.2.2.1 𝔭₃ y₃ hy₃p hy₃c).mp hTop₃
          have hinj : Function.Injective (fun c : ↥W => b₀ * c) :=
            fun c c' h => mul_left_cancel₀ hb₀0 h
          have hsubset : (fun c : ↥W => b₀ * c) '' wcLlsBrSet W A₃ K L 𝔭₃ u₃ ⊆
              wcLlsBrSet W A' K L 𝔭' u := by
            rintro _ ⟨c, hc, rfl⟩
            exact hcm₃ c hc
          have hnot : ∃ x ∈ wcLlsBrSet W A' K L 𝔭' u,
              x ∉ (fun c : ↥W => b₀ * c) '' wcLlsBrSet W A₃ K L 𝔭₃ u₃ := by
            refine ⟨b₀, hb₀Br, ?_⟩
            rintro ⟨c, hc, hceq⟩
            have h1 : c = 1 := mul_left_cancel₀ hb₀0 (hceq.trans (mul_one b₀).symm)
            have h2 : c ∈ IsLocalRing.maximalIdeal ↥W := hc.1
            rw [h1] at h2
            exact notUnitM 1 h2 isUnit_one
          have hlt : (wcLlsBrSet W A₃ K L 𝔭₃ u₃).ncard < (wcLlsBrSet W A' K L 𝔭' u).ncard := by
            rw [← Set.ncard_image_of_injective _ hinj]
            exact Set.ncard_lt_ncard ((Set.ssubset_iff_of_subset hsubset).mpr hnot) hfin
          obtain ⟨β, hβm, hβ0, hβq, hAS₃, hmax₃⟩ :=
            ih _ (lt_of_lt_of_le hlt hn) A₃ 𝔭₃ u₃ v₃ q y₃ hPD₃ hy₃p hy₃c hU₃ le_rfl
          refine ⟨b₀ * β, Ideal.mul_mem_left _ b₀ hβm, mul_ne_zero hb₀0 hβ0, ?_,
            (hiff₃ β hβm hβ0 hβq).mp hAS₃, ?_⟩
          · rw [hgq]; exact mul_dvd_mul_left b₀ hβq
          · rintro b' hb'm hb'0 ⟨s, hs⟩ ⟨r, hr⟩ hAS'
            have hβ'm : β * r ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right r _ hβm
            have hβ'0 : β * r ≠ 0 := by
              intro h; exact hb'0 (by rw [hr, mul_assoc, h, mul_zero])
            have hβ'q : β * r ∣ q :=
              ⟨s, mul_left_cancel₀ hb₀0 (by linear_combination -hgq + hs + s * hr)⟩
            have h1 := (hiff₃ (β * r) hβ'm hβ'0 hβ'q).mpr (by rw [← mul_assoc, ← hr]; exact hAS')
            have h2 := hmax₃ (β * r) hβ'm hβ'0 hβ'q ⟨r, rfl⟩ h1
            rw [hr, mul_assoc]
            exact mul_dvd_mul_left b₀ h2
        · push_neg at hex
          have hall : ∀ y₃ : Ideal ↥(integralClosure A₃ L), y₃.IsPrime →
              y₃.comap (algebraMap A₃ ↥(integralClosure A₃ L)) = 𝔭₃ → ∀ (_ : y₃.IsPrime),
              ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap A₃ L).comp (algebraMap ↥W A₃)) A₃ y₃) := by
            intro y₃ hp hc hp'
            have hbot : wcLlsDec A₃ K L y₃ = ⊥ := (grpBT _).resolve_right (hex y₃ hp hc)
            exact wcpa_dj_llsm_br_split_point Ω W hW hWt A₃ K L 𝔭₃ u₃ v₃ q y₃ hPD₃ hp hc hbot hp'
          have hq3 := wcpa_dj_llsm_br_ann_node_sep Ω W hW hWt A₃ K L 𝔭₃ u₃ v₃ q hPD₃ hall
          have hg : wcLlsAnnSep W A' K L u g := by
            rw [hgq]; exact (hiff₃ q hqm hq0 dvd_rfl).mp hq3
          exact ⟨g, hgm, hg0, dvd_rfl, hg, fun b' _ _ hb'g _ _ => hb'g⟩
      ·
        obtain ⟨A₁, _, _, _, _, _, _, _, u', v', 𝔭₁, -, -, -, hPD₁, hiff₁, hbr₁, hbad₁⟩ :=
          wcpa_dj_llsm_br_boundary_chart Ω W hW hWt A' K L 𝔭' (.ann u v g) u b₀
            hPD (Or.inr ⟨v, g, rfl, ⟨q, hgq⟩⟩) hb₀m hb₀0
        have hBR₁ : wcLlsBR W A₁ K L 𝔭₁ (.ann u' v' b₀) := by
          apply hbr₁
          intro Q hQ hR
          obtain ⟨c, hcm, hcQ⟩ := hcen Q hQ hR
          exact ⟨c, hb₀min c ⟨hcm, Q, hQ, hcQ, hR⟩, hcQ⟩
        obtain ⟨y₁, hy₁p, hy₁c, hbad⟩ := hbad₁ hA
        have hTop₁ : wcLlsDec A₁ K L y₁ = ⊤ := by
          rcases grpBT (wcLlsDec A₁ K L y₁) with hbot | htop
          · exact absurd (hbad hy₁p) (wcpa_dj_llsm_br_split_point Ω W hW hWt A₁ K L 𝔭₁ u' v' b₀
              y₁ hPD₁ hy₁p hy₁c hbot hy₁p)
          · exact htop
        have hU₁ := (wcpa_dj_llsm_br_dec_top_iff A₁ K L hPD₁.2.2.1 𝔭₁ y₁ hy₁p hy₁c).mp hTop₁
        have hS₁ : wcLlsSolvPt W A₁ K L 𝔭₁ (.ann u' v' b₀) y₁ :=
          ⟨hy₁p, hy₁c, grpSolv _, fun _ t₁ h => by cases h⟩
        obtain ⟨b, hbm, hb0, hbb₀, hAS, hmax₁⟩ := hBR A₁ K L 𝔭₁ (.ann u' v' b₀) y₁ hPD₁ hS₁ hU₁
          hBR₁ (cardOf A₁ y₁ hTop₁)
        refine ⟨b, hbm, hb0, hbb₀.trans ⟨q, hgq⟩, (hiff₁ b hbm hb0 hbb₀).mpr hAS, ?_⟩
        intro b' hb'm hb'0 hb'g hbb' hAS'
        rcases ValuationRing.dvd_total b' b₀ with h | h
        · exact hmax₁ b' hb'm hb'0 h hbb' ((hiff₁ b' hb'm hb'0 h).mp hAS')
        · exact absurd (wcpa_dj_llsm_br_radial_mono Ω W hW hWt A' K L 𝔭' (.ann u v g) u b' b₀ hPD
            (Or.inr ⟨v, g, rfl, hb'g⟩) hb'm hb'0 hb₀m hb₀0 h hAS') hA
  cases k with
  | disc t =>
    exact discClaim _ A 𝔭 t y hPD hSolv.1 hSolv.2.1 hUniq (fun hp => hSolv.2.2.2 hp t rfl) le_rfl
  | ann u v g =>
    exact annClaim _ A 𝔭 u v g y hPD hSolv.1 hSolv.2.1 hUniq le_rfl

theorem wcpa_dj_llsm_kp_unit_split : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (ℓ : ℕ), ℓ.Prime → ringChar (IsLocalRing.ResidueField ↥W) ≠ ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
      [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (k : wcLlsKind W A),
    wcLlsPD W A 𝔭 k →
    ∀ (θ : L) (f : A), θ ∉ Set.range (algebraMap K L) → θ ^ ℓ = algebraMap A L f → f ∉ 𝔭 →
    ∃ y₁ y₂ : Ideal ↥(integralClosure A L), y₁.IsPrime ∧ y₂.IsPrime ∧
      y₁.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 ∧
      y₂.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 ∧ y₁ ≠ y₂ :=
by
  intro Ω _ _ W ℓ hℓ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 k hPD θ f hθ hθf hf
  classical
  obtain ⟨hFT, -, -, h𝔭max, hm, -⟩ := hPD
  have hℓpos : 0 < ℓ := hℓ.pos
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero
  have hinj : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)

  have hℓW : IsUnit (ℓ : ↥W) := by
    by_contra hnu
    have hmem : (ℓ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W :=
      (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu)
    have h0 : IsLocalRing.residue ↥W (ℓ : ↥W) = 0 := (IsLocalRing.residue_eq_zero_iff _).mpr hmem
    rw [map_natCast] at h0
    have hdvd : ringChar (IsLocalRing.ResidueField ↥W) ∣ ℓ := ringChar.dvd h0
    rcases hℓ.eq_one_or_self_of_dvd _ hdvd with h1 | h1
    · exact CharP.ringChar_ne_one h1
    · exact hκ h1

  have hκac : IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
    refine IsAlgClosed.of_exists_root _ (fun p hpm hpirr => ?_)
    obtain ⟨q0, hq0⟩ := Polynomial.map_surjective _ (IsLocalRing.residue_surjective (R := ↥W)) p
    obtain ⟨q, hqmap, hqdeg, hqmon⟩ :=
      Polynomial.lifts_and_natDegree_eq_and_monic ((Polynomial.mem_lifts p).mpr ⟨q0, hq0⟩) hpm
    have hpdeg : 0 < p.natDegree :=
      Polynomial.natDegree_pos_iff_degree_pos.mpr (Polynomial.degree_pos_of_irreducible hpirr)
    have hqm : (q.map (algebraMap ↥W Ω)).Monic := hqmon.map _
    have hdeg : (q.map (algebraMap ↥W Ω)).degree ≠ 0 := by
      rw [Polynomial.degree_eq_natDegree hqm.ne_zero, hqmon.natDegree_map, hqdeg]
      exact_mod_cast hpdeg.ne'
    obtain ⟨x, hx⟩ := IsAlgClosed.exists_root _ hdeg
    have hxint : IsIntegral ↥W x := ⟨q, hqmon, by rw [← Polynomial.eval_map]; exact hx⟩
    obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥W) (K := Ω)).mp hxint
    have hq0' : Polynomial.eval y q = 0 := by
      apply IsFractionRing.injective ↥W Ω
      rw [map_zero, ← Polynomial.eval₂_at_apply, ← Polynomial.eval_map, hy]
      exact hx
    refine ⟨IsLocalRing.residue ↥W y, ?_⟩
    rw [← hqmap, Polynomial.eval_map, Polynomial.eval₂_at_apply, hq0', map_zero]

  obtain ⟨σ, hσ⟩ : ∃ σ : L ≃ₐ[K] L, σ θ ≠ θ := by
    by_contra hcon
    push_neg at hcon
    apply hθ
    have hmem : θ ∈ IntermediateField.fixedField (⊤ : Subgroup (L ≃ₐ[K] L)) :=
      (IntermediateField.mem_fixedField_iff _ _).mpr (fun g _ => hcon g)
    rw [IsGalois.fixedField_top] at hmem
    exact IntermediateField.mem_bot.mp hmem
  have hθ0 : θ ≠ 0 := by
    rintro rfl
    rw [zero_pow hℓ0] at hθf
    have : f = 0 := hinj (by rw [← hθf, map_zero])
    exact hf (this ▸ 𝔭.zero_mem)
  have hσf : σ (algebraMap A L f) = algebraMap A L f := by
    rw [IsScalarTower.algebraMap_apply A K L, AlgEquiv.commutes]
  obtain ⟨ζ, hζdef⟩ : ∃ ζ : L, ζ = σ θ / θ := ⟨_, rfl⟩
  have hσθ : σ θ = ζ * θ := by rw [hζdef, div_mul_cancel₀ _ hθ0]
  have hζℓ : ζ ^ ℓ = 1 := by
    have h1 : (σ θ) ^ ℓ = θ ^ ℓ := by rw [← map_pow, hθf, hσf]
    rw [hζdef, div_pow, h1, div_self (pow_ne_zero _ hθ0)]
  have hζ1 : ζ ≠ 1 := by
    intro h; apply hσ; rw [hσθ, h, one_mul]
  have hζint : IsIntegral A ζ := IsIntegral.of_pow hℓpos (by rw [hζℓ]; exact isIntegral_one)
  have hθint : IsIntegral A θ :=
    IsIntegral.of_pow hℓpos (by rw [hθf]; exact isIntegral_algebraMap)
  let ζt : ↥(integralClosure A L) := ⟨ζ, (mem_integralClosure_iff A L).mpr hζint⟩
  let θt : ↥(integralClosure A L) := ⟨θ, (mem_integralClosure_iff A L).mpr hθint⟩
  have hζtℓ : ζt ^ ℓ = 1 := Subtype.ext (by show ζ ^ ℓ = 1; exact hζℓ)
  have hζt1 : ζt ≠ 1 := by
    intro h
    apply hζ1
    have h2 := congrArg Subtype.val h
    exact h2
  have hℓA : IsUnit (ℓ : ↥(integralClosure A L)) := by
    have := hℓW.map ((algebraMap A ↥(integralClosure A L)).comp (algebraMap ↥W A))
    rwa [map_natCast] at this

  have hunit : IsUnit (1 - ζt) := by
    have hS : ∑ i ∈ Finset.range ℓ, ζt ^ i = 0 := by
      have h := geom_sum_mul ζt ℓ
      rw [hζtℓ, sub_self] at h
      exact (mul_eq_zero.mp h).resolve_right (sub_ne_zero.mpr hζt1)
    have hT : (ℓ : ↥(integralClosure A L)) =
        (1 - ζt) * ∑ i ∈ Finset.range ℓ, ∑ j ∈ Finset.range i, ζt ^ j := by
      rw [Finset.mul_sum]
      simp_rw [mul_neg_geom_sum]
      rw [Finset.sum_sub_distrib, hS, sub_zero]
      simp
    rw [hT] at hℓA
    exact isUnit_of_mul_isUnit_left hℓA

  let τ : ↥(integralClosure A L) ≃ₐ[A] ↥(integralClosure A L) :=
    (σ.restrictScalars A).mapIntegralClosure
  have hτ : ∀ x : ↥(integralClosure A L), ((τ x : ↥(integralClosure A L)) : L) = σ (x : L) :=
    fun x => rfl
  have hτθ : τ θt = ζt * θt := Subtype.ext (by rw [hτ]; exact hσθ)

  haveI : 𝔭.IsPrime := h𝔭max.isPrime
  obtain ⟨Q, hQprime, hQ⟩ := Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain
      (S := ↥(integralClosure A L)) 𝔭 (by
    intro a ha
    rw [RingHom.mem_ker] at ha
    have h2 : algebraMap A L a = 0 := congrArg Subtype.val ha
    rw [hinj (h2.trans (map_zero _).symm)]
    exact 𝔭.zero_mem)
  have hQ' : Q.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 := hQ
  haveI := hQprime
  subst hQ'
  have hθtQ : θt ∉ Q := by
    intro h
    apply hf
    have h2 : θt ^ ℓ ∈ Q := Q.pow_mem_of_mem h ℓ hℓpos
    have h3 : θt ^ ℓ = algebraMap A ↥(integralClosure A L) f :=
      Subtype.ext (by show θ ^ ℓ = algebraMap A L f; exact hθf)
    rw [Ideal.mem_comap, ← h3]
    exact h2

  have hres : ∃ w : ↥W,
      θt - algebraMap A ↥(integralClosure A L) (algebraMap ↥W A w) ∈ Q := by
    have hle : IsLocalRing.maximalIdeal ↥W ≤
        (Q.comap (algebraMap A ↥(integralClosure A L))).comap (algebraMap ↥W A) :=
      Ideal.map_le_iff_le_comap.mp hm
    let α : IsLocalRing.ResidueField ↥W →+* A ⧸ Q.comap (algebraMap A ↥(integralClosure A L)) :=
      Ideal.quotientMap _ (algebraMap ↥W A) hle
    have hψ : ((Ideal.Quotient.mk (Q.comap (algebraMap A ↥(integralClosure A L)))).comp
        (algebraMap ↥W A)).FiniteType :=
      RingHom.FiniteType.comp (RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective)
        (RingHom.finiteType_algebraMap.mpr hFT)
    have hcomp : α.comp (IsLocalRing.residue ↥W) =
        (Ideal.Quotient.mk (Q.comap (algebraMap A ↥(integralClosure A L)))).comp
          (algebraMap ↥W A) := by
      ext w; rfl
    have hαFT : α.FiniteType := by
      rw [← hcomp] at hψ
      exact RingHom.FiniteType.of_comp_finiteType hψ
    have hαint : α.IsIntegral := by
      letI : Algebra (IsLocalRing.ResidueField ↥W)
          (A ⧸ Q.comap (algebraMap A ↥(integralClosure A L))) := α.toAlgebra
      haveI : Algebra.FiniteType (IsLocalRing.ResidueField ↥W)
          (A ⧸ Q.comap (algebraMap A ↥(integralClosure A L))) := hαFT
      letI : Field (A ⧸ Q.comap (algebraMap A ↥(integralClosure A L))) := Ideal.Quotient.field _
      have hαfin : α.Finite := finite_of_finite_type_of_isJacobsonRing _ _
      exact RingHom.IsIntegral.of_finite hαfin
    have hβint : (Ideal.quotientMap Q (algebraMap A ↥(integralClosure A L)) le_rfl).IsIntegral :=
      RingHom.IsIntegral.quotient _ (fun x => Algebra.IsIntegral.isIntegral x)
    have hcint := RingHom.IsIntegral.trans α _ hαint hβint
    have hbij := IsAlgClosed.ringHom_bijective_of_isIntegral _ hcint
    obtain ⟨c, hc⟩ := hbij.2 (Ideal.Quotient.mk Q θt)
    obtain ⟨w, rfl⟩ := IsLocalRing.residue_surjective c
    refine ⟨w, ?_⟩
    rw [← Ideal.Quotient.eq, ← hc]
    rfl
  obtain ⟨w, hw⟩ := hres
  refine ⟨Q, Q.comap τ.symm, hQprime, inferInstance, rfl, ?_, ?_⟩
  · ext a
    simp only [Ideal.mem_comap, AlgEquiv.commutes]
  · intro hEq
    have hτQ : ∀ v ∈ Q, τ v ∈ Q := by
      intro v hv
      rw [hEq, Ideal.mem_comap, AlgEquiv.symm_apply_apply]
      exact hv
    have hv := hτQ _ hw
    rw [map_sub, hτθ, AlgEquiv.commutes] at hv
    have h3 : (1 - ζt) * θt ∈ Q := by
      have h4 := Q.sub_mem hw hv
      have e : θt - algebraMap A ↥(integralClosure A L) (algebraMap ↥W A w) -
          (ζt * θt - algebraMap A ↥(integralClosure A L) (algebraMap ↥W A w)) =
          (1 - ζt) * θt := by ring
      rwa [e] at h4
    exact hθtQ ((Ideal.unit_mul_mem_iff_mem Q hunit).mp h3)

theorem wcpa_dj_llsm_kpd_kummer_generator : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (ℓ : ℕ), ℓ.Prime → ringChar (IsLocalRing.ResidueField ↥W) ≠ ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
      [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (y : Ideal ↥(integralClosure A L)),
    NoZeroSMulDivisors ↥W A → y.IsPrime → y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
    wcLlsUniq A L 𝔭 y → Nat.card ↥(wcLlsDec A K L y) = ℓ →
    Module.finrank K L = ℓ ∧ ∃ (θ : L) (f : A), f ≠ 0 ∧ θ ∉ Set.range (algebraMap K L) ∧
      θ ^ ℓ = algebraMap A L f :=
by
  intro Ω _ _ W ℓ hℓ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 y htf hy hcomap hU hD
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩

  have hmapint : ∀ (τ : L ≃ₐ[K] L) (x : L), x ∈ integralClosure A L →
      τ x ∈ integralClosure A L := by
    intro τ x hx
    rw [mem_integralClosure_iff] at hx ⊢
    exact hx.map τ
  let f : (L ≃ₐ[K] L) → (integralClosure A L →+* integralClosure A L) := fun τ =>
    { toFun := fun x => ⟨τ x, hmapint τ x x.2⟩
      map_one' := Subtype.ext (map_one τ)
      map_mul' := fun a b => Subtype.ext (map_mul τ (a : L) (b : L))
      map_zero' := Subtype.ext (map_zero τ)
      map_add' := fun a b => Subtype.ext (map_add τ (a : L) (b : L)) }
  have hf : ∀ τ (x : integralClosure A L), ((f τ x : integralClosure A L) : L) = τ x :=
    fun _ _ => rfl
  have hfA : ∀ τ, (f τ).comp (algebraMap A (integralClosure A L)) =
      algebraMap A (integralClosure A L) := by
    intro τ
    refine RingHom.ext fun a => Subtype.ext ?_
    rw [RingHom.comp_apply, hf]
    have e : ((algebraMap A (integralClosure A L) a : integralClosure A L) : L) =
        algebraMap K L (algebraMap A K a) := by
      rw [← IsScalarTower.algebraMap_apply]; rfl
    rw [e]
    exact τ.commutes _
  have hstab : ∀ τ (x : integralClosure A L), x ∈ y → f τ x ∈ y := by
    intro τ x hx
    have h1 : y.comap (f τ) = y := by
      apply hU
      · exact Ideal.comap_isPrime _ _
      · rw [Ideal.comap_comap, hfA, hcomap]
    have h2 : x ∈ y.comap (f τ) := by rw [h1]; exact hx
    exact h2
  have hDec : wcLlsDec A K L y = ⊤ := by
    rw [eq_top_iff]
    intro σ _
    open Pointwise in
    (rw [wcLlsDec, MulAction.mem_stabilizer_iff]
     ext z
     rw [Set.mem_smul_set]
     constructor
     · rintro ⟨w, ⟨x, hx, rfl⟩, rfl⟩
       exact ⟨f σ x, hstab σ x hx, rfl⟩
     · rintro ⟨x, hx, rfl⟩
       refine ⟨_, ⟨f σ⁻¹ x, hstab σ⁻¹ x hx, rfl⟩, ?_⟩
       rw [AlgEquiv.smul_def, hf, ← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply])
  have hcardG : Nat.card (L ≃ₐ[K] L) = ℓ := by rw [← hD, hDec, Subgroup.card_top]
  have hfr : Module.finrank K L = ℓ := by rw [← IsGalois.card_aut_eq_finrank, hcardG]
  refine ⟨hfr, ?_⟩

  have hℓΩ : ((ℓ : ℕ) : Ω) ≠ 0 := by
    intro h0
    have hW : ((ℓ : ℕ) : W) = 0 := by
      apply Subtype.ext
      have e : ((ℓ : W) : Ω) = (ℓ : Ω) := map_natCast W.subtype ℓ
      exact e.trans (h0.trans rfl)
    have hκ0 : ((ℓ : ℕ) : IsLocalRing.ResidueField W) = 0 := by
      rw [← map_natCast (IsLocalRing.residue W), hW, map_zero]
    have hdvd := ringChar.dvd hκ0
    rcases hℓ.eq_one_or_self_of_dvd _ hdvd with h1 | h1
    · exact CharP.ringChar_ne_one h1
    · exact hκ h1
  haveI : NeZero ((ℓ : ℕ) : Ω) := ⟨hℓΩ⟩
  obtain ⟨m, hm⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, by have := hℓ.pos; omega⟩
  obtain ⟨μ, hμ⟩ := IsAlgClosed.exists_root (Polynomial.cyclotomic ℓ Ω)
    (Polynomial.degree_cyclotomic_pos ℓ Ω hℓ.pos).ne'
  have hμp : IsPrimitiveRoot μ ℓ := Polynomial.isRoot_cyclotomic_iff.mp hμ
  have hμW : μ ∈ W := by
    rcases W.mem_or_inv_mem μ with h | h
    · exact h
    · have hμ1 : μ ^ (m + 1) = 1 := hm ▸ hμp.pow_eq_one
      have e : (μ⁻¹) ^ m = μ := by
        rw [inv_pow]
        exact inv_eq_of_mul_eq_one_right (by rw [← pow_succ]; exact hμ1)
      rw [← e]
      exact W.pow_mem h m
  have hζ : IsPrimitiveRoot (⟨μ, hμW⟩ : W) ℓ :=
    IsPrimitiveRoot.of_map_of_injective (f := W.subtype) hμp Subtype.val_injective
  have hWA : Function.Injective (algebraMap W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    rw [Algebra.algebraMap_eq_smul_one] at hw
    rcases smul_eq_zero.mp hw with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hinj : Function.Injective ((algebraMap A K).comp (algebraMap W A)) :=
    (IsFractionRing.injective A K).comp hWA
  have hζK := hζ.map_of_injective hinj
  have hprim : (primitiveRoots (Module.finrank K L) K).Nonempty := by
    rw [hfr]; exact ⟨_, (mem_primitiveRoots hℓ.pos).mpr hζK⟩

  haveI : IsCyclic (L ≃ₐ[K] L) := isCyclic_of_prime_card hcardG
  have htfae := (isCyclic_tfae K L hprim).out 1 3
  have hGC : IsGalois K L ∧ IsCyclic (L ≃ₐ[K] L) := ⟨inferInstance, inferInstance⟩
  obtain ⟨α, ⟨c, hc⟩, hαtop⟩ := htfae.mp hGC
  rw [hfr] at hc
  have hαK : α ∉ Set.range (algebraMap K L) := by
    intro hα
    have h1 : α ∈ (⊥ : IntermediateField K L) := IntermediateField.mem_bot.mpr hα
    rw [← IntermediateField.adjoin_simple_eq_bot_iff] at h1
    rw [h1] at hαtop
    have := IntermediateField.bot_eq_top_iff_finrank_eq_one.mp hαtop
    rw [hfr] at this
    exact hℓ.one_lt.ne' this
  obtain ⟨a, s, hsnz, hcs⟩ := IsFractionRing.div_surjective (A := A) c
  have hs0 : algebraMap A K s ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hsnz
  have hsL : algebraMap A L s ≠ 0 := by
    rw [IsScalarTower.algebraMap_apply A K L]; exact (map_ne_zero _).mpr hs0
  have hpow : (algebraMap A L s * α) ^ ℓ = algebraMap A L (a * s ^ m) := by
    rw [mul_pow, ← hc, ← hcs, map_div₀, ← IsScalarTower.algebraMap_apply,
      ← IsScalarTower.algebraMap_apply, hm, map_mul, map_pow]
    field_simp
    ring
  refine ⟨algebraMap A L s * α, a * s ^ m, ?_, ?_, hpow⟩
  · intro hf0
    rw [hf0, map_zero] at hpow
    have h1 := (pow_eq_zero_iff hℓ.ne_zero).mp hpow
    rcases mul_eq_zero.mp h1 with h2 | h2
    · exact hsL h2
    · exact hαK ⟨0, by rw [map_zero, h2]⟩
  · rintro ⟨k, hk⟩
    apply hαK
    refine ⟨k / algebraMap A K s, ?_⟩
    rw [map_div₀, hk, ← IsScalarTower.algebraMap_apply]
    exact mul_div_cancel_left₀ α hsL

theorem wcpa_dj_llsm_kpdf_section_prime : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) →
    ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → ∀ a b : A,
      a * b ∈ Ideal.span {t - algebraMap ↥W A c} →
      ∃ s : A, s ∉ 𝔭 ∧ (s * a ∈ Ideal.span {t - algebraMap ↥W A c} ∨
        s * b ∈ Ideal.span {t - algebraMap ↥W A c}) :=
by
  have wcpa_dj_lus_tbw_etale_loc_quot_prime : ∀ (N T : Type u) [CommRing N] [CommRing T]
      [Algebra N T] [Algebra.Etale N T] (q : Ideal T) [q.IsPrime] (f : N) (D : Type u)
      [CommRing D] [IsDomain D] [IsIntegrallyClosed D] (π : N →+* D), Function.Surjective π →
      RingHom.ker π = Ideal.span {f} → algebraMap N T f ∈ q →
      (Ideal.span {algebraMap T (Localization.AtPrime q) (algebraMap N T f)}).IsPrime := by
    have wc_ring_etale_localization_isDomain : ∀ (R T : Type u) [CommRing R] [IsDomain R]
        [IsIntegrallyClosed R] [CommRing T] [Algebra R T] [Algebra.Etale R T] (q : Ideal T)
        [q.IsPrime], IsDomain (Localization.AtPrime q) := by
      intro R T _ _ _ _ _ _ q _
      classical
      have s2 : ∀ (K A : Type u) [Field K] [CommRing A] [Algebra K A] [Algebra.Etale K A] (a b : A),
          a * b = 0 → ∃ ε : A, IsIdempotentElem ε ∧ ε * b = 0 ∧ (1 - ε) * a = 0 := by
        intro K A _ _ _ _ a b hab
        obtain ⟨I, _, Ai, hF, hA, e, -⟩ :=
          (Algebra.Etale.iff_exists_algEquiv_prod K A).mp inferInstance
        have hab' : ∀ i, e a i * e b i = 0 := by
          intro i
          have h := congrFun (congrArg e hab) i
          rw [map_mul, map_zero] at h
          exact h
        let ε' : (i : I) → Ai i := fun i => if e a i = 0 then 0 else 1
        have hε' : IsIdempotentElem ε' := by
          show ε' * ε' = ε'
          funext i
          simp only [Pi.mul_apply, ε']
          split_ifs <;> simp
        refine ⟨e.symm ε', hε'.map e.symm, ?_, ?_⟩
        · apply e.injective
          rw [map_mul, AlgEquiv.apply_symm_apply, map_zero]
          funext i
          simp only [Pi.mul_apply, Pi.zero_apply, ε']
          split_ifs with h
          · simp
          · rw [one_mul]
            exact (mul_eq_zero.mp (hab' i)).resolve_left h
        · apply e.injective
          rw [map_mul, map_sub, map_one, AlgEquiv.apply_symm_apply, map_zero]
          funext i
          simp only [Pi.mul_apply, Pi.sub_apply, Pi.one_apply, Pi.zero_apply, ε']
          split_ifs with h
          · rw [h, mul_zero]
          · simp
      let K := FractionRing R
      let S := TensorProduct R T K
      let j : T →ₐ[R] S := Algebra.TensorProduct.includeLeft
      have hj : ∀ t : T, j t = TensorProduct.tmul R t (1 : K) := fun t => rfl
      have hjinj : Function.Injective j :=
        Algebra.TensorProduct.includeLeft_injective (R := R) (S := R) (A := T) (B := K)
          (IsFractionRing.injective R K)
      have hsep : ∀ a b : S, a * b = 0 →
          ∃ ε : S, IsIdempotentElem ε ∧ ε * b = 0 ∧ (1 - ε) * a = 0 := by
        intro a b hab
        let c : S ≃ₐ[R] TensorProduct R K T := Algebra.TensorProduct.comm R T K
        obtain ⟨ε', hε', h1, h2⟩ := s2 K (TensorProduct R K T) (c a) (c b)
          (by rw [← map_mul, hab, map_zero])
        refine ⟨c.symm ε', hε'.map c.symm, ?_, ?_⟩
        · apply c.injective
          rw [map_mul, AlgEquiv.apply_symm_apply, map_zero]
          exact h1
        · apply c.injective
          rw [map_mul, map_sub, map_one, AlgEquiv.apply_symm_apply, map_zero]
          exact h2
      have hlift : ∀ ε : S, IsIdempotentElem ε → ∃ e : T, j e = ε := by
        intro ε hε
        have hint : IsIntegral T ε := by
          refine ⟨Polynomial.X ^ 2 - Polynomial.X,
            Polynomial.monic_X_pow_sub (Polynomial.degree_X_le.trans_lt (by norm_num)), ?_⟩
          rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_X, pow_two, hε.eq,
            sub_self]
        obtain ⟨w, hw⟩ := (TensorProduct.toIntegralClosure_bijective_of_smooth (R := R) (S := T)
          (B := K)).2 ⟨ε, (mem_integralClosure_iff T S).mpr hint⟩
        have hw' := congrArg Subtype.val hw
        simp only at hw'
        have key : ∀ w' : TensorProduct R T (integralClosure R K),
            ∃ t : T, ((TensorProduct.toIntegralClosure R T K w' : integralClosure T S) : S) = j t := by
          intro w'
          induction w' using TensorProduct.induction_on with
          | zero => exact ⟨0, by rw [map_zero, map_zero]; rfl⟩
          | tmul t c =>
            have hc : (c : K) ∈ (⊥ : Subalgebra R K) := by
              rw [← IsIntegrallyClosed.integralClosure_eq_bot R K]; exact c.2
            obtain ⟨r, hr⟩ := Algebra.mem_bot.mp hc
            refine ⟨r • t, ?_⟩
            rw [hj]
            change TensorProduct.tmul R t (c : K) = _
            rw [TensorProduct.smul_tmul, ← hr, Algebra.algebraMap_eq_smul_one]
          | add x y hx hy =>
            obtain ⟨t₁, h₁⟩ := hx
            obtain ⟨t₂, h₂⟩ := hy
            exact ⟨t₁ + t₂, by rw [map_add, Subalgebra.coe_add, h₁, h₂, map_add]⟩
        obtain ⟨t, ht⟩ := key w
        exact ⟨t, ht.symm.trans hw'⟩
      have hnzd : NoZeroDivisors (Localization.AtPrime q) := by
        refine ⟨fun {x y} hxy => ?_⟩
        obtain ⟨⟨s, u⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl x
        obtain ⟨⟨s', u'⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl y
        dsimp only at hxy ⊢
        rw [← IsLocalization.mk'_mul] at hxy
        obtain ⟨m, hm⟩ := (IsLocalization.mk'_eq_zero_iff _ _).mp hxy
        obtain ⟨ε, hε, h1, h2⟩ := hsep (j ((m : T) * s)) (j s')
          (by rw [← map_mul, mul_assoc, hm, map_zero])
        obtain ⟨e, rfl⟩ := hlift ε hε
        have he1 : e * s' = 0 := hjinj (by rw [map_mul, h1, map_zero])
        have he2 : (1 - e) * ((m : T) * s) = 0 :=
          hjinj (by rw [map_mul, map_sub, map_one, h2, map_zero])
        have he3 : e * e = e := hjinj (by rw [map_mul]; exact hε.eq)
        set π := algebraMap T (Localization.AtPrime q) with hπ
        have hē : π e * π e = π e := by rw [← map_mul, he3]
        rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (π e) with hu | hu
        · right
          have h1' : π e = 1 := hu.mul_left_cancel (by rw [hē, mul_one])
          have hs' : π s' = 0 := by
            have := congrArg π he1
            rwa [map_mul, h1', one_mul, map_zero] at this
          rw [IsLocalization.mk'_eq_mul_mk'_one, hs', zero_mul]
        · left
          have h0 : π e = 0 := (hu.mul_right_eq_zero).mp (by rw [sub_mul, one_mul, hē, sub_self])
          have hs : π s = 0 := by
            have := congrArg π he2
            rw [map_mul, map_sub, map_one, h0, sub_zero, one_mul, map_mul, map_zero] at this
            exact ((IsLocalization.map_units (Localization.AtPrime q) m).mul_right_eq_zero).mp this
          rw [IsLocalization.mk'_eq_mul_mk'_one, hs, zero_mul]
      exact NoZeroDivisors.to_isDomain _
    intro N T _ _ _ _ q _ f D _ _ _ π hπ hker hf
    set I : Ideal N := RingHom.ker π with hI
    set J : Ideal T := I.map (algebraMap N T) with hJ
    have hJspan : J = Ideal.span {algebraMap N T f} := by
      rw [hJ, hker, Ideal.map_span, Set.image_singleton]
    have hJq : J ≤ q := by
      rw [hJspan, Ideal.span_singleton_le_iff_mem]; exact hf
    let e : N ⧸ I ≃+* D := RingHom.quotientKerEquivOfSurjective hπ
    haveI : IsDomain (N ⧸ I) := MulEquiv.isDomain D e.toMulEquiv
    haveI : IsIntegrallyClosed (N ⧸ I) := IsIntegrallyClosed.of_equiv e.symm
    haveI hEt : Algebra.Etale (N ⧸ I) (T ⧸ J) := by
      haveI : Algebra.Etale (N ⧸ I) (TensorProduct N (N ⧸ I) T) := inferInstance
      let e₁ := Algebra.TensorProduct.comm N (N ⧸ I) T
      let e₂ := Algebra.TensorProduct.quotIdealMapEquivTensorQuot T I
      let eR : TensorProduct N (N ⧸ I) T ≃+* T ⧸ J := e₁.toRingEquiv.trans e₂.symm.toRingEquiv
      let eA : TensorProduct N (N ⧸ I) T ≃ₐ[N ⧸ I] T ⧸ J := AlgEquiv.ofRingEquiv (f := eR) (by
        intro x
        obtain ⟨n, rfl⟩ := Ideal.Quotient.mk_surjective x
        show e₂.symm (e₁ (algebraMap (N ⧸ I) (TensorProduct N (N ⧸ I) T) (Ideal.Quotient.mk I n))) = _
        rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
          Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul,
          Ideal.Quotient.algebraMap_quotient_map_quotient, Algebra.smul_def, mul_one]
        rfl)
      exact Algebra.Etale.of_equiv eA
    set q' : Ideal (T ⧸ J) := q.map (Ideal.Quotient.mk J) with hq'
    haveI hq'p : q'.IsPrime := Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
      (by rw [Ideal.mk_ker]; exact hJq)
    have hcomap : q'.comap (Ideal.Quotient.mk J) = q := by
      rw [hq', Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
      exact sup_eq_left.mpr hJq
    haveI hdom : IsDomain (Localization.AtPrime q') :=
      wc_ring_etale_localization_isDomain (N ⧸ I) (T ⧸ J) q'
    have hT : Submonoid.map (Ideal.Quotient.mk J) q.primeCompl = q'.primeCompl := by
      ext y
      simp only [Submonoid.mem_map, Ideal.mem_primeCompl_iff]
      constructor
      · rintro ⟨x, hx, rfl⟩ hy
        apply hx
        rw [← hcomap]; exact hy
      · intro hy
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
        refine ⟨x, ?_, rfl⟩
        intro hx
        apply hy
        rw [← hcomap] at hx
        exact hx
    have hk := IsLocalization.ker_map (S := Localization.AtPrime q) (Localization.AtPrime q')
      (Ideal.Quotient.mk J) hT
    rw [Ideal.mk_ker] at hk
    have hmap : J.map (algebraMap T (Localization.AtPrime q)) =
        Ideal.span {algebraMap T (Localization.AtPrime q) (algebraMap N T f)} := by
      rw [hJspan, Ideal.map_span, Set.image_singleton]
    rw [← hmap, ← hk]
    exact RingHom.ker_isPrime _
  intro Ω _ _ W _ _ A _ _ _ 𝔭 t hPD c hc a b hab
  classical
  obtain ⟨-, -, -, hmax, hmA, ht𝔭, -, h, hh, φ, hφC, hφX, hφet⟩ := hPD
  have h𝔭 : 𝔭.IsPrime := hmax.isPrime
  set T := Localization.Away h with hTdef
  set q : Ideal T := 𝔭.map (algebraMap A T) with hqdef
  have hdisj : Disjoint (Submonoid.powers h : Set A) 𝔭 :=
    (Ideal.disjoint_powers_iff_notMem h h𝔭.isRadical).mpr hh
  haveI hqprime : q.IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) T 𝔭 h𝔭 hdisj
  have hqcomap : Ideal.comap (algebraMap A T) q = 𝔭 :=
    IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers h) T h𝔭 hdisj
  set T0 : A := t - algebraMap ↥W A c with hT0
  have hT0mem : T0 ∈ 𝔭 :=
    𝔭.sub_mem ht𝔭 (hmA (Ideal.mem_map_of_mem _ hc))
  letI : Algebra (Polynomial ↥W) T := φ.toAlgebra
  haveI : Algebra.Etale (Polynomial ↥W) T := hφet
  have hφf : algebraMap (Polynomial ↥W) T (Polynomial.X - Polynomial.C c) =
      algebraMap A T T0 := by
    rw [RingHom.algebraMap_toAlgebra, map_sub, hφX, hT0, map_sub]
    congr 1
    have := congrArg (fun g => g c) hφC
    simpa using this
  have hfq : algebraMap (Polynomial ↥W) T (Polynomial.X - Polynomial.C c) ∈ q := by
    rw [hφf]; exact Ideal.mem_map_of_mem _ hT0mem
  have hsurj : Function.Surjective (Polynomial.evalRingHom c) := fun w =>
    ⟨Polynomial.C w, by simp⟩
  have hP := wcpa_dj_lus_tbw_etale_loc_quot_prime (Polynomial ↥W) T q
    (Polynomial.X - Polynomial.C c) ↥W (Polynomial.evalRingHom c) hsurj
    (Polynomial.ker_evalRingHom c) hfq
  rw [hφf] at hP
  set L := Localization.AtPrime q
  haveI hLloc : IsLocalization.AtPrime L (Ideal.comap (algebraMap A T) q) :=
    IsLocalization.isLocalization_isLocalization_atPrime_isLocalization (Submonoid.powers h) L q
  have hLloc' : IsLocalization (Ideal.comap (algebraMap A T) q).primeCompl L := hLloc
  have hJ : (Ideal.span {T0}).map (algebraMap A L) =
      Ideal.span {algebraMap T L (algebraMap A T T0)} := by
    rw [Ideal.map_span, Set.image_singleton, IsScalarTower.algebraMap_apply A T L]
  have hJp : ((Ideal.span {T0}).map (algebraMap A L)).IsPrime := by rw [hJ]; exact hP
  have hab' : algebraMap A L a * algebraMap A L b ∈ (Ideal.span {T0}).map (algebraMap A L) := by
    rw [← map_mul]; exact Ideal.mem_map_of_mem _ hab
  have hconv : ∀ m : A, m ∈ (Ideal.comap (algebraMap A T) q).primeCompl → m ∉ 𝔭 := by
    intro m hm hm𝔭
    apply hm
    show m ∈ Ideal.comap (algebraMap A T) q
    rw [hqcomap]; exact hm𝔭
  rcases hJp.mem_or_mem hab' with ha | hb
  · obtain ⟨m, hm, hma⟩ :=
      (IsLocalization.algebraMap_mem_map_algebraMap_iff
        (Ideal.comap (algebraMap A T) q).primeCompl L (Ideal.span {T0}) a).mp ha
    exact ⟨m, hconv m hm, Or.inl hma⟩
  · obtain ⟨m, hm, hmb⟩ :=
      (IsLocalization.algebraMap_mem_map_algebraMap_iff
        (Ideal.comap (algebraMap A T) q).primeCompl L (Ideal.span {T0}) b).mp hb
    exact ⟨m, hconv m hm, Or.inr hmb⟩

theorem wcpa_dj_llsm_kpdf_norm_divisor : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) →
    ∀ x : A, x ≠ 0 → ∃ (N : Polynomial ↥W) (g : A),
      Polynomial.aeval t N ≠ 0 ∧ x * g = Polynomial.aeval t N :=
by
  intro Ω _ _ W _ _ A _ _ _ 𝔭 t hPD x hx
  classical

  have s1 : ∀ (R S : Type u) [CommRing R] [IsDomain R] [CommRing S] [Nontrivial S]
      (f : R →+* S), f.Etale → Function.Injective f := by
    intro R S _ _ _ _ f hf
    letI : Algebra R S := f.toAlgebra
    haveI : Algebra.Etale R S := RingHom.Etale.toAlgebra hf
    haveI : Algebra.Smooth R S :=
      (Algebra.Etale.iff_formallyUnramified_and_smooth.mp ‹_›).2
    haveI : Module.Flat R S := Algebra.Smooth.flat R S
    rw [injective_iff_map_eq_zero]
    intro r hr
    by_contra hr0
    have hreg : IsSMulRegular S r :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hr0)
    have e : r • (1 : S) = r • (0 : S) := by
      rw [Algebra.smul_def, smul_zero, RingHom.algebraMap_toAlgebra, hr, zero_mul]
    exact one_ne_zero (hreg e)

  have s2 : ∀ (R S : Type u) [CommRing R] [IsDomain R] [CommRing S] [IsDomain S]
      (f : R →+* S), f.Etale → Function.Injective f →
      ∀ s : S, ∃ Q : Polynomial R, Q ≠ 0 ∧ Polynomial.eval₂ f s Q = 0 := by
    intro R S _ _ _ _ f hf hinj s
    letI : Algebra R S := f.toAlgebra
    haveI : Algebra.Etale R S := RingHom.Etale.toAlgebra hf
    haveI : Algebra.FormallyUnramified R S :=
      (Algebra.Etale.iff_formallyUnramified_and_smooth.mp ‹_›).1
    haveI : Algebra.FiniteType R S := Algebra.FiniteType.of_finitePresentation
    haveI : Algebra.EssFiniteType R S := Algebra.EssFiniteType.of_finiteType R S
    let M := nonZeroDivisors R
    let B := Localization (Algebra.algebraMapSubmonoid S M)
    haveI : IsLocalization (M.map (algebraMap R S)) B := Localization.isLocalization
    haveI : Algebra.FormallyUnramified (FractionRing R) B :=
      Algebra.FormallyUnramified.localization_map M (R := R) (S := S)
        (Rₘ := FractionRing R) (Sₘ := B)
    haveI : Algebra.EssFiniteType R B := Algebra.EssFiniteType.comp R S B
    haveI : Algebra.EssFiniteType (FractionRing R) B :=
      Algebra.EssFiniteType.of_comp R (FractionRing R) B
    haveI : Module.Free (FractionRing R) B := Module.Free.of_divisionRing _ _
    haveI : Module.Finite (FractionRing R) B :=
      Algebra.FormallyUnramified.finite_of_free _ _
    have halg : IsAlgebraic R (algebraMap S B s) :=
      (IsFractionRing.isAlgebraic_iff R (FractionRing R) B).mpr
        (IsAlgebraic.of_finite _ _)
    obtain ⟨Q, hQ0, hQ⟩ := halg
    refine ⟨Q, hQ0, ?_⟩
    have hle : M.map (algebraMap R S) ≤ nonZeroDivisors S := by
      rintro _ ⟨m, hm, rfl⟩
      apply mem_nonZeroDivisors_of_ne_zero
      rw [RingHom.algebraMap_toAlgebra]
      exact (map_ne_zero_iff f hinj).mpr (nonZeroDivisors.ne_zero hm)
    have hBinj : Function.Injective (algebraMap S B) := IsLocalization.injective B hle
    apply hBinj
    rw [map_zero, ← hQ, Polynomial.aeval_def, Polynomial.hom_eval₂,
      IsScalarTower.algebraMap_eq R S B, RingHom.algebraMap_toAlgebra]

  obtain ⟨-, -, -, -, -, -, -, h, hh, f, hfC, hfX, hfe⟩ := hPD
  have hh0 : h ≠ 0 := fun h0 => hh (h0 ▸ 𝔭.zero_mem)
  have P := powers_le_nonZeroDivisors_of_noZeroDivisors hh0
  haveI : IsDomain (Localization.Away h) := IsLocalization.isDomain_localization P
  have hι : Function.Injective (algebraMap A (Localization.Away h)) :=
    IsLocalization.injective _ P
  set ι := algebraMap A (Localization.Away h) with hιdef
  set φ : Polynomial ↥W →+* A := (Polynomial.aeval t).toRingHom with hφ
  have hfφ : f = ι.comp φ := by
    apply Polynomial.ringHom_ext
    · intro a
      have := RingHom.congr_fun hfC a
      simpa [hφ] using this
    · simpa [hφ] using hfX
  have hfinj : Function.Injective f := s1 _ _ f hfe
  obtain ⟨Q, hQ0, hQ⟩ := s2 _ _ f hfe hfinj (ι x)
  have hQ' : Q.eval₂ φ x = 0 := by
    apply hι
    rw [map_zero, ← hQ, hfφ, Polynomial.hom_eval₂]
  letI : Algebra (Polynomial ↥W) A := φ.toAlgebra
  have halg : IsAlgebraic (Polynomial ↥W) x :=
    ⟨Q, hQ0, by rw [Polynomial.aeval_def, RingHom.algebraMap_toAlgebra]; exact hQ'⟩
  obtain ⟨Q', hQ'0, hQ'x⟩ :=
    halg.exists_nonzero_coeff_and_aeval_eq_zero (mem_nonZeroDivisors_of_ne_zero hx)
  have e := congrArg (Polynomial.aeval x) (Polynomial.divX_mul_X_add Q')
  rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, hQ'x,
    RingHom.algebraMap_toAlgebra] at e
  have hφN : φ (Q'.coeff 0) = Polynomial.aeval t (Q'.coeff 0) := rfl
  refine ⟨Q'.coeff 0, -(Polynomial.aeval x Q'.divX), ?_, ?_⟩
  · intro h0
    apply hQ'0
    apply hfinj
    rw [map_zero f, hfφ, RingHom.comp_apply, hφN, h0, map_zero ι]
  · rw [← hφN]
    linear_combination -e

theorem wcpa_dj_llsm_kpdf_poly_factor : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (N : Polynomial ↥W), N ≠ 0 →
    ∃ (r : ℕ) (c : Fin r → ↥W) (n : Fin r → ℕ) (d : ↥W) (p : Polynomial ↥W),
      Function.Injective c ∧ (∀ i, c i ∈ IsLocalRing.maximalIdeal ↥W) ∧ d ≠ 0 ∧
      IsUnit (p.eval 0) ∧
      N = Polynomial.C d * p * ∏ i, (Polynomial.X - Polynomial.C (c i)) ^ (n i) :=
by
  intro Ω _ _ W N hN
  classical

  have hregroup : ∀ S : Multiset ↥W, ∃ (r : ℕ) (c : Fin r → ↥W) (n : Fin r → ℕ),
      Function.Injective c ∧ (∀ i, c i ∈ S) ∧
      (S.map (fun a => Polynomial.X - Polynomial.C a)).prod =
        ∏ i, (Polynomial.X - Polynomial.C (c i)) ^ (n i) := by
    intro S
    let φ := S.toFinset.equivFin
    refine ⟨S.toFinset.card, fun i => ((φ.symm i : S.toFinset) : ↥W),
      fun i => S.count ((φ.symm i : S.toFinset) : ↥W), ?_, ?_, ?_⟩
    · intro i j h
      exact φ.symm.injective (Subtype.val_injective h)
    · intro i
      exact Multiset.mem_toFinset.mp (φ.symm i).2
    · rw [Finset.prod_multiset_map_count, ← Finset.prod_coe_sort]
      exact Fintype.prod_equiv φ _ _ (fun x => by simp)

  have hunit : ∀ (p : Polynomial ↥W) (S : Multiset ↥W), p.eval 0 = 1 →
      (∀ c ∈ S, c ∈ IsLocalRing.maximalIdeal ↥W) →
      IsUnit ((p * (S.map (fun c => Polynomial.X - Polynomial.C c)).prod).coeff
        (Multiset.card S)) := by
    intro p S hp hS
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit, ← Polynomial.coeff_map]
    have h1 : ((S.map (fun c => Polynomial.X - Polynomial.C c)).prod).map
        (IsLocalRing.residue ↥W) = Polynomial.X ^ (Multiset.card S) := by
      rw [Polynomial.map_multiset_prod, Multiset.map_map]
      rw [Multiset.map_congr rfl (g := fun _ => Polynomial.X) ?_]
      · rw [Multiset.map_const', Multiset.prod_replicate]
      · intro c hc
        simp [(IsLocalRing.residue_eq_zero_iff c).mpr (hS c hc)]
    rw [Polynomial.map_mul, h1]
    have h2 := Polynomial.coeff_mul_X_pow (p.map (IsLocalRing.residue ↥W)) (Multiset.card S) 0
    rw [zero_add] at h2
    rw [h2, Polynomial.coeff_map, Polynomial.coeff_zero_eq_eval_zero, hp, map_one]
    exact one_ne_zero
  have hιinj : Function.Injective (algebraMap ↥W Ω) := Subtype.val_injective
  have hιv : ∀ w : ↥W, algebraMap ↥W Ω w = (w : Ω) := fun _ => rfl
  have hN'0 : N.map (algebraMap ↥W Ω) ≠ 0 := by
    intro h
    apply hN
    apply Polynomial.map_injective (algebraMap ↥W Ω) hιinj
    rw [Polynomial.map_zero]; exact h
  set Z := (N.map (algebraMap ↥W Ω)).roots with hZ
  set ℓ := (N.map (algebraMap ↥W Ω)).leadingCoeff with hℓdef
  have hℓ : ℓ ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hN'0
  have hsplit : Polynomial.C ℓ * (Z.map (fun r => Polynomial.X - Polynomial.C r)).prod =
      N.map (algebraMap ↥W Ω) :=
    Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C IsAlgClosed.card_roots_eq_natDegree
  let P : Ω → Prop := fun r => ∃ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W ∧ (w : Ω) = r
  have hnP : ∀ r, ¬ P r → r ≠ 0 ∧ r⁻¹ ∈ W := by
    intro r hr
    have hr0 : r ≠ 0 := by
      rintro rfl
      exact hr ⟨0, Ideal.zero_mem _, rfl⟩
    refine ⟨hr0, ?_⟩
    rcases W.mem_or_inv_mem r with h | h
    · have hw : (⟨r, h⟩ : ↥W) ∉ IsLocalRing.maximalIdeal ↥W := fun hm => hr ⟨⟨r, h⟩, hm, rfl⟩
      have hu : IsUnit (⟨r, h⟩ : ↥W) := by
        by_contra hu; exact hw ((IsLocalRing.mem_maximalIdeal _).mpr hu)
      obtain ⟨u, hu⟩ := hu
      have hinv : (((u⁻¹ : (↥W)ˣ) : ↥W) : Ω) = r⁻¹ := by
        have h1 : (((u⁻¹ : (↥W)ˣ) : ↥W) : Ω) * r = 1 := by
          have := congrArg Subtype.val (u.inv_mul)
          rw [hu] at this
          simpa using this
        exact eq_inv_of_mul_eq_one_left h1
      rw [← hinv]; exact Subtype.property _
    · exact h
  let a : Ω → ↥W := fun r => if h : P r then Classical.choose h else 0
  have ha : ∀ r, P r → a r ∈ IsLocalRing.maximalIdeal ↥W ∧ ((a r : ↥W) : Ω) = r := by
    intro r hr
    simp only [a, dif_pos hr]
    exact Classical.choose_spec hr
  let b : Ω → ↥W := fun r => if h : r⁻¹ ∈ W then ⟨r⁻¹, h⟩ else 0
  have hb : ∀ r, ¬ P r → ((b r : ↥W) : Ω) = r⁻¹ := by
    intro r hr
    simp only [b, dif_pos (hnP r hr).2]
  have hZsp : Z = Z.filter P + Z.filter (fun r => ¬ P r) := (Multiset.filter_add_not _ _).symm
  let S : Multiset ↥W := (Z.filter P).map a
  let p : Polynomial ↥W :=
    ((Z.filter (fun r => ¬ P r)).map (fun r => 1 - Polynomial.C (b r) * Polynomial.X)).prod
  let e : Ω := ℓ * ((Z.filter (fun r => ¬ P r)).map (fun r => -r)).prod
  have hSm : ∀ c ∈ S, c ∈ IsLocalRing.maximalIdeal ↥W := by
    intro c hc
    obtain ⟨r, hr, rfl⟩ := Multiset.mem_map.mp hc
    exact (ha r (Multiset.of_mem_filter hr)).1
  have hp0 : p.eval 0 = 1 := by
    simp [p, Polynomial.eval_multiset_prod]
  have he0 : e ≠ 0 := by
    refine mul_ne_zero hℓ ?_
    apply Multiset.prod_ne_zero
    intro h0
    obtain ⟨r, hr, hr0⟩ := Multiset.mem_map.mp h0
    exact (hnP r (Multiset.mem_filter.mp hr).2).1 (neg_eq_zero.mp hr0)
  have hPp : ((S.map (fun c => Polynomial.X - Polynomial.C c)).prod).map (algebraMap ↥W Ω) =
      ((Z.filter P).map (fun r => Polynomial.X - Polynomial.C r)).prod := by
    rw [Polynomial.map_multiset_prod, Multiset.map_map, Multiset.map_map]
    congr 1
    apply Multiset.map_congr rfl
    intro r hr
    simp [hιv, (ha r (Multiset.of_mem_filter hr)).2]
  have hpm : p.map (algebraMap ↥W Ω) =
      ((Z.filter (fun r => ¬ P r)).map (fun r => 1 - Polynomial.C r⁻¹ * Polynomial.X)).prod := by
    rw [Polynomial.map_multiset_prod, Multiset.map_map]
    congr 1
    apply Multiset.map_congr rfl
    intro r hr
    simp [hιv, hb r (Multiset.mem_filter.mp hr).2]
  have hZm : ((Z.filter (fun r => ¬ P r)).map (fun r => Polynomial.X - Polynomial.C r)).prod =
      Polynomial.C (((Z.filter (fun r => ¬ P r)).map (fun r => -r)).prod) *
        ((Z.filter (fun r => ¬ P r)).map (fun r => 1 - Polynomial.C r⁻¹ * Polynomial.X)).prod := by
    rw [Multiset.map_congr rfl
      (g := fun r => Polynomial.C (-r) * (1 - Polynomial.C r⁻¹ * Polynomial.X)) ?_]
    · rw [Multiset.prod_map_mul, map_multiset_prod, Multiset.map_map]
      rfl
    · intro r hr
      have hr0 := (hnP r (Multiset.mem_filter.mp hr).2).1
      have h1 : Polynomial.C (-r) * Polynomial.C r⁻¹ = (-1 : Polynomial Ω) := by
        rw [← Polynomial.C_mul, neg_mul, mul_inv_cancel₀ hr0, Polynomial.C_neg, Polynomial.C_1]
      have h2 : Polynomial.C (-r) = -Polynomial.C r := Polynomial.C_neg
      linear_combination Polynomial.X * h1 - h2
  have hkey : N.map (algebraMap ↥W Ω) = Polynomial.C e *
      (p * (S.map (fun c => Polynomial.X - Polynomial.C c)).prod).map (algebraMap ↥W Ω) := by
    rw [← hsplit, hZsp, Multiset.map_add, Multiset.prod_add, Polynomial.map_mul, hpm, hPp, hZm]
    simp only [e, Polynomial.C_mul]
    ring
  have hu := hunit p S hp0 hSm
  have hcoeff : algebraMap ↥W Ω (N.coeff (Multiset.card S)) =
      e * algebraMap ↥W Ω ((p * (S.map (fun c => Polynomial.X - Polynomial.C c)).prod).coeff
        (Multiset.card S)) := by
    rw [← Polynomial.coeff_map, hkey, Polynomial.coeff_C_mul, Polynomial.coeff_map]
  have hd : algebraMap ↥W Ω (N.coeff (Multiset.card S) * ↑(hu.unit⁻¹)) = e := by
    rw [map_mul, hcoeff, mul_assoc, ← map_mul, IsUnit.mul_val_inv, map_one, mul_one]
  have hd0 : N.coeff (Multiset.card S) * ↑(hu.unit⁻¹) ≠ 0 := by
    intro h
    rw [h, map_zero] at hd
    exact he0 hd.symm
  have hNeq : N = Polynomial.C (N.coeff (Multiset.card S) * ↑(hu.unit⁻¹)) *
      (p * (S.map (fun c => Polynomial.X - Polynomial.C c)).prod) := by
    apply Polynomial.map_injective (algebraMap ↥W Ω) hιinj
    rw [Polynomial.map_mul, Polynomial.map_C, hd, hkey]
  generalize N.coeff (Multiset.card S) * ↑(hu.unit⁻¹) = d at hd0 hNeq
  obtain ⟨r, c, n, hcinj, hcS, hprod⟩ := hregroup S
  refine ⟨r, c, n, d, p, hcinj, fun i => hSm _ (hcS i), hd0, by rw [hp0]; exact isUnit_one, ?_⟩
  rw [hNeq, hprod, mul_assoc]

theorem wcpa_dj_llsm_kpdf_fibre_nzd : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) →
    (∀ b : A, (∀ s : A, s ∉ 𝔭 → s * b ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) →
      ∃ (k : ℕ) (u s : A), u ∉ 𝔭 ∧ s ∉ 𝔭 ∧
        s * b - u * t ^ k ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) →
    ∀ (b y z : A) (w : ↥W), w ≠ 0 →
      (∀ s : A, s ∉ 𝔭 → s * b ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) →
      b * y = algebraMap ↥W A w * z →
      ∃ (s y' : A), s ∉ 𝔭 ∧ s * y = algebraMap ↥W A w * y' :=
by
  intro Ω _ _ W hW hWt A _ _ _ 𝔭 t hPD H3 b y z w hw hb hbyz
  classical
  unfold wcLlsPD at hPD
  simp only at hPD
  obtain ⟨_, _, _, hmax, _, _, _, h, hh, φ, hφC, hφX, hφet⟩ := hPD
  have h𝔭 : 𝔭.IsPrime := hmax.isPrime

  have s3 : ∀ e : A, e ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      ∃ (μ : ↥W) (r : A), μ ∈ IsLocalRing.maximalIdeal ↥W ∧ e = algebraMap ↥W A μ * r := by
    intro e he
    have he' : e ∈ Ideal.span (⇑(algebraMap ↥W A) '' (IsLocalRing.maximalIdeal ↥W : Set ↥W)) := he
    refine Submodule.span_induction (p := fun e _ => ∃ (μ : ↥W) (r : A),
      μ ∈ IsLocalRing.maximalIdeal ↥W ∧ e = algebraMap ↥W A μ * r) ?_ ?_ ?_ ?_ he'
    · rintro x ⟨μ, hμ, rfl⟩
      exact ⟨μ, 1, hμ, by rw [mul_one]⟩
    · exact ⟨0, 0, Ideal.zero_mem _, by simp⟩
    · rintro x₁ x₂ _ _ ⟨μ₁, r₁, hμ₁, rfl⟩ ⟨μ₂, r₂, hμ₂, rfl⟩
      rcases ValuationRing.dvd_total μ₁ μ₂ with ⟨c, hc⟩ | ⟨c, hc⟩
      · refine ⟨μ₁, r₁ + algebraMap ↥W A c * r₂, hμ₁, ?_⟩
        rw [hc, map_mul]; ring
      · refine ⟨μ₂, algebraMap ↥W A c * r₁ + r₂, hμ₂, ?_⟩
        rw [hc, map_mul]; ring
    · rintro a x _ ⟨μ, r, hμ, rfl⟩
      exact ⟨μ, a * r, hμ, by rw [smul_eq_mul]; ring⟩

  have s4 : ∀ μ : ↥W, μ ∈ IsLocalRing.maximalIdeal ↥W → ∃ (M : ℕ) (c : ↥W), μ ^ M = w * c := by
    intro μ hμ
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
    have hrad : μ ∈ (Ideal.span {w}).radical := by
      rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
      rintro J ⟨hJw, hJp⟩
      have hJ0 : J ≠ ⊥ := by
        intro hJ
        apply hw
        have hwJ : w ∈ J := hJw (Ideal.mem_span_singleton_self w)
        rw [hJ] at hwJ
        exact (Submodule.mem_bot _).mp hwJ
      have hJm : J.IsMaximal := Ideal.IsPrime.isMaximal_of_ne_bot hJp hJ0
      rw [IsLocalRing.eq_maximalIdeal hJm]
      exact hμ
    obtain ⟨M, hM⟩ := hrad
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hM
    exact ⟨M, c, hc⟩

  have hflat : φ.Flat :=
    RingHom.Smooth.flat ((RingHom.etale_iff_formallyUnramified_and_smooth φ).mp hφet).2
  have hwC : φ (Polynomial.C w) = algebraMap A (Localization.Away h) (algebraMap ↥W A w) := by
    have := RingHom.congr_fun hφC w
    simpa only [RingHom.comp_apply] using this
  letI := φ.toAlgebra
  haveI : Module.Flat (Polynomial ↥W) (Localization.Away h) := hflat
  have s2one : ∀ x z : A, t * x = algebraMap ↥W A w * z →
      ∃ (n : ℕ) (y' : A), h ^ n * x = algebraMap ↥W A w * y' := by
    intro x z hxz
    have hrel : ∑ i : Fin 2, (![Polynomial.X, -Polynomial.C w] i) •
        (![algebraMap A (Localization.Away h) x, algebraMap A (Localization.Away h) z] i) = 0 := by
      rw [Fin.sum_univ_two]
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Algebra.smul_def,
        RingHom.algebraMap_toAlgebra, map_neg, hφX, hwC]
      have e := congrArg (algebraMap A (Localization.Away h)) hxz
      rw [map_mul, map_mul] at e
      rw [e]; ring
    obtain ⟨K, a, yv, hx, ha⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
      (R := Polynomial ↥W) (M := Localization.Away h) (f := ![Polynomial.X, -Polynomial.C w])
      (x := ![algebraMap A (Localization.Away h) x, algebraMap A (Localization.Away h) z]) hrel
    have hdiv : ∀ j, Polynomial.C w ∣ a 0 j := by
      intro j
      have hj := ha j
      rw [Fin.sum_univ_two] at hj
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons] at hj
      rw [Polynomial.C_dvd_iff_dvd_coeff]
      intro n
      have h2 : Polynomial.X * a 0 j = Polynomial.C w * a 1 j := by linear_combination hj
      have h3 := congrArg (fun p => Polynomial.coeff p (n + 1)) h2
      simp only [Polynomial.coeff_X_mul, Polynomial.coeff_C_mul] at h3
      exact ⟨_, h3⟩
    choose bj hbj using hdiv
    have hx0 := hx 0
    simp only [Matrix.cons_val_zero] at hx0
    have hξ : algebraMap A (Localization.Away h) x = algebraMap A (Localization.Away h)
        (algebraMap ↥W A w) * ∑ j, φ (bj j) * yv j := by
      rw [hx0, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra, hbj j, map_mul, hwC]; ring
    obtain ⟨⟨a', m⟩, ham⟩ :=
      IsLocalization.mk'_surjective (Submonoid.powers h) (∑ j, φ (bj j) * yv j)
    simp only at ham
    obtain ⟨m', hm'⟩ := m.2
    have e1 : algebraMap A (Localization.Away h) ((m : A) * x) =
        algebraMap A (Localization.Away h) (algebraMap ↥W A w * a') := by
      rw [map_mul, map_mul, hξ, ← ham, ← IsLocalization.mk'_spec (Localization.Away h) a' m]
      ring
    obtain ⟨cc, hcc⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers h) _).mp e1
    obtain ⟨n₀, hn₀⟩ := cc.2
    refine ⟨n₀ + m', h ^ n₀ * a', ?_⟩
    rw [← hm', ← hn₀] at hcc
    rw [pow_add]
    linear_combination hcc
  have s2 : ∀ (N : ℕ) (x z : A), t ^ N * x = algebraMap ↥W A w * z →
      ∃ (n : ℕ) (y' : A), h ^ n * x = algebraMap ↥W A w * y' := by
    intro N
    induction N with
    | zero => intro x z hxz; exact ⟨0, z, by simpa using hxz⟩
    | succ N ih =>
      intro x z hxz
      obtain ⟨n₁, y₁, h₁⟩ := ih (t * x) z (by rw [← hxz]; ring)
      obtain ⟨n₂, y₂, h₂⟩ := s2one (h ^ n₁ * x) y₁ (by rw [← h₁]; ring)
      exact ⟨n₂ + n₁, y₂, by rw [pow_add, mul_assoc, h₂]⟩

  obtain ⟨k, u, s₀, hu, hs₀, he⟩ := H3 b hb
  obtain ⟨μ, r, hμ, hμr⟩ := s3 _ he
  obtain ⟨M, c, hc⟩ := s4 μ hμ
  have hsb : s₀ * b = u * t ^ k + algebraMap ↥W A μ * r := by linear_combination hμr
  have hνM : (algebraMap ↥W A μ * r) ^ M =
      algebraMap ↥W A w * (algebraMap ↥W A c * r ^ M) := by
    rw [mul_pow, ← map_pow, hc, map_mul]; ring
  have hgeom := geom_sum₂_mul (u * t ^ k) (-(algebraMap ↥W A μ * r)) M
  generalize hG : (∑ i ∈ Finset.range M,
    (u * t ^ k) ^ i * (-(algebraMap ↥W A μ * r)) ^ (M - 1 - i)) = G at hgeom
  have ee1 : (u * t ^ k) ^ M = t ^ (k * M) * u ^ M := by rw [mul_pow, ← pow_mul]; ring
  have ee2 : (-(algebraMap ↥W A μ * r)) ^ M =
      (-1) ^ M * (algebraMap ↥W A w * (algebraMap ↥W A c * r ^ M)) := by
    rw [neg_pow, hνM]
  have key : t ^ (k * M) * (u ^ M * y) = algebraMap ↥W A w *
      (G * s₀ * z + (-1) ^ M * (algebraMap ↥W A c * r ^ M) * y) := by
    linear_combination (-y) * ee1 + y * ee2 + (-y) * hgeom + (-y * G) * hsb + (G * s₀) * hbyz
  obtain ⟨n, y', hy'⟩ := s2 (k * M) (u ^ M * y) _ key
  refine ⟨h ^ n * u ^ M, y', ?_, by rw [mul_assoc, hy']⟩
  intro hmem
  rcases h𝔭.mem_or_mem hmem with h1 | h1
  · exact hh (h𝔭.mem_of_pow_mem _ h1)
  · exact hu (h𝔭.mem_of_pow_mem _ h1)

theorem wcpa_dj_llsm_kpdf_generic_valuation : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) →
    (∀ a b : A, a * b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      ∃ s : A, s ∉ 𝔭 ∧ (s * a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ∨
        s * b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A))) →
    (∀ s : A, s ∉ 𝔭 → s * t ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) →
    ∀ x : A, x ≠ 0 → ∃ (d : ↥W) (u b : A), d ≠ 0 ∧
      (∀ s : A, s ∉ 𝔭 → s * u ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧
      (∀ s : A, s ∉ 𝔭 → s * b ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧
      b * x = algebraMap ↥W A d * u :=
by
  intro Ω _ _ W _ _ A _ _ _ 𝔭 t hPD H1 H2 x hx
  classical
  obtain ⟨-, hnzd, hic, hmax, hmA, ht𝔭, -, h, hh, f, hfC, hfX, hfe⟩ := hPD
  haveI := hnzd
  haveI := hic
  have h𝔭p : 𝔭.IsPrime := hmax.isPrime
  have hnot : ∀ a b : A, a ∉ 𝔭 → b ∉ 𝔭 → a * b ∉ 𝔭 := fun a b ha hb hab =>
    (h𝔭p.mem_or_mem hab).elim ha hb
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h1 => h𝔭p.ne_top ((Ideal.eq_top_iff_one _).mpr h1)


  have root : ∀ (q : W) (m : ℕ), 0 < m → ∃ ρ : W, ρ ^ m = q := by
    intro q m hm
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (q : Ω) hm
    have hzW : z ∈ W := by
      rcases W.mem_or_inv_mem z with h | h
      · exact h
      · by_cases hz0 : z = 0
        · rw [hz0]; exact W.zero_mem
        · obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
          have e : z = z ^ (m' + 1) * (z⁻¹) ^ m' := by
            rw [pow_succ, mul_comm (z ^ m') z, mul_assoc, ← mul_pow, mul_inv_cancel₀ hz0,
              one_pow, mul_one]
          rw [e, hz]; exact mul_mem q.2 (pow_mem h _)
    exact ⟨⟨z, hzW⟩, Subtype.ext (by push_cast; exact hz)⟩

  have bmin : ∀ (g : ℕ → W) (n : ℕ), ∃ k ≤ n, ∀ j ≤ n, g k ∣ g j := by
    intro g n
    induction n with
    | zero => exact ⟨0, le_rfl, fun j hj => by rw [Nat.le_zero.mp hj]⟩
    | succ n ih =>
      obtain ⟨k, hk, hdiv⟩ := ih
      rcases ValuationRing.dvd_total (g k) (g (n+1)) with h | h
      · refine ⟨k, by omega, fun j hj => ?_⟩
        rcases Nat.lt_or_ge j (n+1) with hj' | hj'
        · exact hdiv j (by omega)
        · rw [show j = n+1 by omega]; exact h
      · refine ⟨n+1, le_rfl, fun j hj => ?_⟩
        rcases Nat.lt_or_ge j (n+1) with hj' | hj'
        · exact h.trans (hdiv j (by omega))
        · rw [show j = n+1 by omega]


  have descent : ∀ (V : Type u) [CommRing V] [IsDomain V] [IsLocalRing V] [IsIntegrallyClosed V]
      [Algebra W V], Function.Injective (algebraMap W V) →
      (∀ μ : W, μ ∈ IsLocalRing.maximalIdeal W →
        algebraMap W V μ ∈ IsLocalRing.maximalIdeal V) →
      (∀ y : V, y ∈ IsLocalRing.maximalIdeal V → ∃ (μ : W) (r : V),
        μ ∈ IsLocalRing.maximalIdeal W ∧ y = algebraMap W V μ * r) →
      ∀ (n : ℕ) (ε : ℕ → V), (∀ i, IsUnit (ε i)) →
      ∀ (c : ℕ → W) (y : V), c 0 ≠ 0 →
        ∑ j ∈ Finset.range (n + 1), algebraMap W V (c j) * ε j * y ^ j = 0 →
        ∃ (d : W) (υ : V), d ≠ 0 ∧ IsUnit υ ∧ y = algebraMap W V d * υ := by
    intro V _ _ _ _ _ hI hL hM n ε hε
    set alg := algebraMap W V with halg

    have s6 : ∀ (y r U : V) (k : ℕ) (b : ℕ → V), r ≠ 0 → IsUnit U →
        y ^ k * U + ∑ i ∈ Finset.range k, b i * r ^ (k - i) * y ^ i = 0 → ∃ z, y = r * z := by
      intro y r U k b hr hU h
      set j := algebraMap V (FractionRing V) with hjdef
      have hj : Function.Injective j := IsFractionRing.injective V (FractionRing V)
      have hjr : j r ≠ 0 := (map_ne_zero_iff j hj).mpr hr
      obtain ⟨u, rfl⟩ := hU
      set Z : FractionRing V := j y / j r with hZ
      have hZi : ∀ i : ℕ, Z ^ i * j r ^ i = j y ^ i := fun i => by
        rw [hZ, div_pow, div_mul_cancel₀ _ (pow_ne_zero _ hjr)]
      have hu : j ↑u * j ↑u⁻¹ = 1 := by rw [← map_mul, Units.mul_inv, map_one]
      set p : Polynomial V := Polynomial.X ^ k +
        ∑ i ∈ Finset.range k, Polynomial.C (↑u⁻¹ * b i) * Polynomial.X ^ i with hp
      have hpm : p.Monic := by
        apply Polynomial.monic_X_pow_add
        refine lt_of_le_of_lt (Polynomial.degree_sum_le _ _) ?_
        rw [Finset.sup_lt_iff (WithBot.bot_lt_coe _)]
        intro i hi
        exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_pow_le _ _)
          (by exact_mod_cast Finset.mem_range.mp hi)
      have key : j r ^ k * j ↑u * Polynomial.aeval Z p =
          j (y ^ k * ↑u + ∑ i ∈ Finset.range k, b i * r ^ (k - i) * y ^ i) := by
        rw [hp]
        simp only [map_add, map_sum, map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
        rw [mul_add, Finset.mul_sum]
        congr 1
        · calc j r ^ k * j ↑u * Z ^ k = j ↑u * (Z ^ k * j r ^ k) := by ring
            _ = _ := by rw [hZi]; ring
        · apply Finset.sum_congr rfl
          intro i hi
          have hik : i ≤ k := (Finset.mem_range.mp hi).le
          rw [show j r ^ k = j r ^ (k - i) * j r ^ i by rw [← pow_add, Nat.sub_add_cancel hik]]
          calc j r ^ (k - i) * j r ^ i * j ↑u * (j ↑u⁻¹ * j (b i) * Z ^ i)
              = (j ↑u * j ↑u⁻¹) * j (b i) * j r ^ (k - i) * (Z ^ i * j r ^ i) := by ring
            _ = _ := by rw [hu, hZi]; ring
      rw [h, map_zero] at key
      have hne : j r ^ k * j ↑u ≠ 0 :=
        mul_ne_zero (pow_ne_zero _ hjr) ((map_ne_zero_iff j hj).mpr u.ne_zero)
      have hev : Polynomial.aeval Z p = 0 := (mul_eq_zero.mp key).resolve_left hne
      have hint : IsIntegral V Z := ⟨p, hpm, by rwa [Polynomial.aeval_def] at hev⟩
      obtain ⟨z, hz⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
      refine ⟨z, hj ?_⟩
      rw [map_mul, hz, hZ, mul_div_cancel₀ _ hjr]

    have algne : ∀ w : W, w ≠ 0 → alg w ≠ 0 := fun w hw => (map_ne_zero_iff alg hI).mpr hw
    have yne : ∀ (c : ℕ → W) (y : V), c 0 ≠ 0 →
        ∑ j ∈ Finset.range (n + 1), alg (c j) * ε j * y ^ j = 0 → y ≠ 0 := by
      intro c y hc0 hrel hy
      rw [hy, Finset.sum_eq_single 0 (fun j _ hj => by rw [zero_pow hj, mul_zero])
        (fun h => absurd (Finset.mem_range.mpr (Nat.succ_pos n)) h), pow_zero, mul_one] at hrel
      exact mul_ne_zero (algne _ hc0) (hε 0).ne_zero hrel
    have subst : ∀ (c : ℕ → W) (μ : W) (r : V),
        ∑ j ∈ Finset.range (n + 1), alg (c j) * ε j * (alg μ * r) ^ j =
        ∑ j ∈ Finset.range (n + 1), alg (c j * μ ^ j) * ε j * r ^ j := by
      intro c μ r
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_mul, map_pow, mul_pow]; ring
    have topex : ∀ c : ℕ → W, ∃ k, k ≤ n ∧ (∀ j ≤ n, c k ∣ c j) ∧
        (∀ j, k < j → j ≤ n → ¬ c j ∣ c k) := by
      intro c
      set S := (Finset.range (n + 1)).filter (fun k => ∀ j ≤ n, c k ∣ c j) with hS
      obtain ⟨k₀, hk₀, hk₀d⟩ := bmin c n
      have hSne : S.Nonempty :=
        ⟨k₀, Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega), hk₀d⟩⟩
      have hmem := Finset.mem_filter.mp (Finset.max'_mem S hSne)
      have hmem1 := Finset.mem_range.mp hmem.1
      refine ⟨S.max' hSne, by omega, hmem.2, fun j hj hjn hdvd => ?_⟩
      have hjS : j ∈ S := by
        refine Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega), ?_⟩
        exact fun i hi => hdvd.trans (hmem.2 i hi)
      have := Finset.le_max' S j hjS
      omega
    have unit_of_mul : ∀ a b : W, a * b = 1 → IsUnit a := fun a b h =>
      isUnit_iff_exists_inv.mpr ⟨b, h⟩
    have notunit : ∀ μ : W, μ ∈ IsLocalRing.maximalIdeal W → ¬ IsUnit μ := fun μ h =>
      (IsLocalRing.mem_maximalIdeal μ).mp h

    have main : ∀ k, ∀ (c : ℕ → W) (y : V), c 0 ≠ 0 →
        ∑ j ∈ Finset.range (n + 1), alg (c j) * ε j * y ^ j = 0 →
        k ≤ n → (∀ j ≤ n, c k ∣ c j) → (∀ j, k < j → j ≤ n → ¬ c j ∣ c k) →
        ∃ (d : W) (υ : V), d ≠ 0 ∧ IsUnit υ ∧ y = alg d * υ := by
      intro k
      induction k using Nat.strong_induction_on with
      | _ k IH =>

      have tie : ∀ (c : ℕ → W) (z : V), c 0 ≠ 0 →
          ∑ j ∈ Finset.range (n + 1), alg (c j) * ε j * z ^ j = 0 →
          k ≤ n → (∀ j ≤ n, c k ∣ c j) → (∀ i₀, i₀ < k → c i₀ ∣ c k →
          ∃ (d : W) (υ : V), d ≠ 0 ∧ IsUnit υ ∧ z = alg d * υ) := by
        intro c z hc0 hrel hkn hdom i₀ hi₀ hi₀d
        by_cases hzu : IsUnit z
        · exact ⟨1, z, one_ne_zero, hzu, by rw [map_one, one_mul]⟩
        have hzm : z ∈ IsLocalRing.maximalIdeal V := (IsLocalRing.mem_maximalIdeal z).mpr hzu
        obtain ⟨μ, r, hμ, hzr⟩ := hM z hzm
        have hz0 := yne c z hc0 hrel
        have hμ0 : μ ≠ 0 := by rintro rfl; rw [map_zero, zero_mul] at hzr; exact hz0 hzr
        set c'' : ℕ → W := fun j => c j * μ ^ j with hc''
        have hrel'' : ∑ j ∈ Finset.range (n + 1), alg (c'' j) * ε j * r ^ j = 0 := by
          rw [hc'', ← subst, ← hzr]; exact hrel
        have hc''0 : c'' 0 ≠ 0 := by simp only [hc'', pow_zero, mul_one]; exact hc0
        obtain ⟨k', hk'n, hk'd, hk't⟩ := topex c''
        have hk'k : k' < k := by
          by_contra hge
          push_neg at hge
          obtain ⟨e, he⟩ := hi₀d.trans (hdom k' hk'n)
          obtain ⟨a, ha⟩ := hk'd i₀ (by omega)
          have hci₀ : c i₀ ≠ 0 := by
            intro h0; apply hc0
            obtain ⟨f, hf⟩ := hi₀d.trans (hdom 0 (Nat.zero_le _))
            rw [hf, h0, zero_mul]
          simp only [hc''] at ha
          rw [he] at ha
          have e2 : μ ^ i₀ * 1 = μ ^ i₀ * (μ * (e * μ ^ (k' - i₀ - 1) * a)) := by
            apply mul_left_cancel₀ hci₀
            calc c i₀ * (μ ^ i₀ * 1) = c i₀ * μ ^ i₀ := by ring
              _ = c i₀ * e * μ ^ k' * a := ha
              _ = c i₀ * (μ ^ i₀ * (μ * (e * μ ^ (k' - i₀ - 1) * a))) := by
                rw [show k' = i₀ + 1 + (k' - i₀ - 1) by omega]
                simp only [pow_add, pow_one]
                rw [show i₀ + 1 + (k' - i₀ - 1) - i₀ - 1 = k' - i₀ - 1 by omega]
                ring
          have e3 := mul_left_cancel₀ (pow_ne_zero i₀ hμ0) e2
          exact notunit μ hμ (unit_of_mul _ _ e3.symm)
        obtain ⟨d, υ, hd, hυ, hrd⟩ := IH k' hk'k c'' r hc''0 hrel'' hk'n hk'd hk't
        refine ⟨μ * d, υ, mul_ne_zero hμ0 hd, hυ, ?_⟩
        rw [hzr, hrd, map_mul]; ring

      intro c y hc0 hrel hkn hdom htop
      by_cases hyu : IsUnit y
      · exact ⟨1, y, one_ne_zero, hyu, by rw [map_one, one_mul]⟩
      have hy0 := yne c y hc0 hrel
      have hck0 : c k ≠ 0 := by
        intro h0; obtain ⟨f, hf⟩ := hdom 0 (Nat.zero_le _); exact hc0 (by rw [hf, h0, zero_mul])
      have hqex : ∀ j, ∃ qj : W, j ≤ n → c j = c k * qj := fun j =>
        if h : j ≤ n then (hdom j h).imp (fun _ h' _ => h') else ⟨0, fun h' => absurd h' h⟩
      choose q hq using hqex
      have hqk : q k = 1 := by
        have := hq k hkn
        have e : c k * 1 = c k * q k := by rw [mul_one]; exact this
        exact (mul_left_cancel₀ hck0 e).symm
      have hqm : ∀ j, k < j → j ≤ n → q j ∈ IsLocalRing.maximalIdeal W := by
        intro j hkj hjn
        refine (IsLocalRing.mem_maximalIdeal _).mpr (fun hu => htop j hkj hjn ?_)
        obtain ⟨u, hu⟩ := hu
        exact ⟨↑u⁻¹, by rw [hq j hjn, ← hu, mul_assoc, Units.mul_inv, mul_one]⟩
      have hrelq : ∑ j ∈ Finset.range (n + 1), alg (q j) * ε j * y ^ j = 0 := by
        have : alg (c k) * ∑ j ∈ Finset.range (n + 1), alg (q j) * ε j * y ^ j = 0 := by
          rw [Finset.mul_sum, ← hrel]
          refine Finset.sum_congr rfl (fun j hj => ?_)
          rw [hq j (by have := Finset.mem_range.mp hj; omega), map_mul]; ring
        exact (mul_eq_zero.mp this).resolve_left (algne _ hck0)
      set U : V := ε k + ∑ j ∈ Finset.Ico (k + 1) (n + 1), alg (q j) * ε j * y ^ (j - k)
        with hU
      have hUu : IsUnit U := by
        by_contra hnu
        have hUm : U ∈ IsLocalRing.maximalIdeal V := (IsLocalRing.mem_maximalIdeal _).mpr hnu
        have hsm : ∑ j ∈ Finset.Ico (k + 1) (n + 1), alg (q j) * ε j * y ^ (j - k) ∈
            IsLocalRing.maximalIdeal V := by
          refine Ideal.sum_mem _ (fun j hj => ?_)
          have hj' := Finset.mem_Ico.mp hj
          exact Ideal.mul_mem_right _ _
            (Ideal.mul_mem_right _ _ (hL _ (hqm j (by omega) (by omega))))
        have hεm : ε k ∈ IsLocalRing.maximalIdeal V := by
          have : ε k = U - ∑ j ∈ Finset.Ico (k + 1) (n + 1), alg (q j) * ε j * y ^ (j - k) := by
            rw [hU]; ring
          rw [this]; exact Ideal.sub_mem _ hUm hsm
        exact (IsLocalRing.mem_maximalIdeal _).mp hεm (hε k)
      have hsplit : ∑ i ∈ Finset.range k, alg (q i) * ε i * y ^ i + y ^ k * U = 0 := by
        rw [← hrelq, ← Finset.sum_range_add_sum_Ico _ (show k ≤ n + 1 by omega),
          Finset.sum_eq_sum_Ico_succ_bot (show k < n + 1 by omega), hqk, map_one, hU, mul_add,
          Finset.mul_sum]
        congr 1
        rw [one_mul, mul_comm]
        congr 1
        refine Finset.sum_congr rfl (fun j hj => ?_)
        have hj' := Finset.mem_Ico.mp hj
        rw [show y ^ j = y ^ k * y ^ (j - k) by rw [← pow_add, Nat.add_sub_cancel' (by omega)]]
        ring
      have hex : ∃ i₁, i₁ < k ∧ q i₁ ≠ 0 := by
        by_contra hcon
        push_neg at hcon
        rw [Finset.sum_eq_zero (fun i hi => by rw [hcon i (Finset.mem_range.mp hi), map_zero,
          zero_mul, zero_mul]), zero_add] at hsplit
        exact mul_ne_zero (pow_ne_zero k hy0) hUu.ne_zero hsplit
      obtain ⟨i₁, hi₁k, hqi₁⟩ := hex
      have hρex : ∀ i, ∃ ρ : W, i < k → ρ ^ (k - i) = q i := fun i =>
        if h : i < k then (root (q i) (k - i) (by omega)).imp (fun _ h' _ => h')
        else ⟨0, fun h' => absurd h' h⟩
      choose ρf hρf using hρex
      obtain ⟨i₀, hi₀n, hi₀d⟩ := bmin (fun i => if i < k then ρf i else 0) n
      have hρi₁ : ρf i₁ ≠ 0 := by
        intro h0; apply hqi₁; rw [← hρf i₁ hi₁k, h0, zero_pow (by omega)]
      have hdi₁ := hi₀d i₁ (by omega)
      simp only [if_pos hi₁k] at hdi₁
      have hi₀k : i₀ < k := by
        by_contra hge
        simp only [if_neg hge] at hdi₁
        exact hρi₁ (zero_dvd_iff.mp hdi₁)
      simp only [if_pos hi₀k] at hdi₁
      set ρ := ρf i₀ with hρdef
      have hρ0 : ρ ≠ 0 := by
        intro h0; rw [h0] at hdi₁; exact hρi₁ (zero_dvd_iff.mp hdi₁)
      have hσex : ∀ i, ∃ s : W, i < k → ρf i = ρ * s := fun i =>
        if h : i < k then by
          have := hi₀d i (by omega)
          simp only [if_pos h, if_pos hi₀k] at this
          exact this.imp (fun _ h' _ => h')
        else ⟨0, fun h' => absurd h' h⟩
      choose σ hσ using hσex
      have hqi : ∀ i, i < k → q i = ρ ^ (k - i) * σ i ^ (k - i) := by
        intro i hi; rw [← hρf i hi, hσ i hi, mul_pow]
      obtain ⟨z, hyz⟩ := s6 y (alg ρ) U k (fun i => alg (σ i ^ (k - i)) * ε i) (algne _ hρ0)
        hUu (by
          rw [add_comm, ← hsplit]
          congr 1
          refine Finset.sum_congr rfl (fun i hi => ?_)
          rw [hqi i (Finset.mem_range.mp hi), map_mul, map_pow, map_pow]; ring)
      set c' : ℕ → W := fun j => c j * ρ ^ j with hc'
      have hrel' : ∑ j ∈ Finset.range (n + 1), alg (c' j) * ε j * z ^ j = 0 := by
        rw [hc', ← subst, ← hyz]; exact hrel
      have hc'0 : c' 0 ≠ 0 := by simp only [hc', pow_zero, mul_one]; exact hc0
      have hlow : ∀ j, j < k → c' j = c' k * σ j ^ (k - j) := by
        intro j hj
        simp only [hc']
        rw [hq j (by omega), hqi j hj,
          show ρ ^ k = ρ ^ (k - j) * ρ ^ j by rw [← pow_add, Nat.sub_add_cancel hj.le]]
        ring
      have hhigh : ∀ j, k ≤ j → j ≤ n → c' j = c' k * (q j * ρ ^ (j - k)) := by
        intro j hj hjn
        simp only [hc']
        rw [hq j hjn, show ρ ^ j = ρ ^ k * ρ ^ (j - k) by rw [← pow_add, Nat.add_sub_cancel' hj]]
        ring
      have hdom' : ∀ j ≤ n, c' k ∣ c' j := by
        intro j hjn
        rcases Nat.lt_or_ge j k with hj | hj
        · exact ⟨_, hlow j hj⟩
        · exact ⟨_, hhigh j hj hjn⟩
      have hσi₀ : σ i₀ = 1 := by
        have := hσ i₀ hi₀k
        rw [← hρdef] at this
        have e : ρ * 1 = ρ * σ i₀ := by rw [mul_one]; exact this
        exact (mul_left_cancel₀ hρ0 e).symm
      have htie : c' i₀ ∣ c' k := ⟨1, by rw [hlow i₀ hi₀k, hσi₀, one_pow, mul_one, mul_one]⟩
      obtain ⟨d, υ, hd, hυ, hzd⟩ := tie c' z hc'0 hrel' hkn hdom' i₀ hi₀k htie
      refine ⟨ρ * d, υ, mul_ne_zero hρ0 hd, hυ, ?_⟩
      rw [hyz, hzd, map_mul]; ring
    intro c y hc0 hrel
    obtain ⟨k, hk1, hk2, hk3⟩ := topex c
    exact main k c y hc0 hrel hk1 hk2 hk3


  have hrelA : ∃ (N : ℕ) (a : ℕ → Polynomial W), Polynomial.aeval t (a 0) ≠ 0 ∧
      ∑ i ∈ Finset.range (N + 1), Polynomial.aeval t (a i) * x ^ i = 0 := by
    have s1 : ∀ (R S : Type u) [CommRing R] [IsDomain R] [CommRing S] [Nontrivial S]
        (f : R →+* S), f.Etale → Function.Injective f := by
      intro R S _ _ _ _ f hf
      letI : Algebra R S := f.toAlgebra
      haveI : Algebra.Etale R S := RingHom.Etale.toAlgebra hf
      haveI : Algebra.Smooth R S :=
        (Algebra.Etale.iff_formallyUnramified_and_smooth.mp ‹_›).2
      haveI : Module.Flat R S := Algebra.Smooth.flat R S
      rw [injective_iff_map_eq_zero]
      intro r hr
      by_contra hr0
      have hreg : IsSMulRegular S r :=
        Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hr0)
      have e : r • (1 : S) = r • (0 : S) := by
        rw [Algebra.smul_def, smul_zero, RingHom.algebraMap_toAlgebra, hr, zero_mul]
      exact one_ne_zero (hreg e)
    have s2 : ∀ (R S : Type u) [CommRing R] [IsDomain R] [CommRing S] [IsDomain S]
        (f : R →+* S), f.Etale → Function.Injective f →
        ∀ s : S, ∃ Q : Polynomial R, Q ≠ 0 ∧ Polynomial.eval₂ f s Q = 0 := by
      intro R S _ _ _ _ f hf hinj s
      letI : Algebra R S := f.toAlgebra
      haveI : Algebra.Etale R S := RingHom.Etale.toAlgebra hf
      haveI : Algebra.FormallyUnramified R S :=
        (Algebra.Etale.iff_formallyUnramified_and_smooth.mp ‹_›).1
      haveI : Algebra.FiniteType R S := Algebra.FiniteType.of_finitePresentation
      haveI : Algebra.EssFiniteType R S := Algebra.EssFiniteType.of_finiteType R S
      let M := nonZeroDivisors R
      let B := Localization (Algebra.algebraMapSubmonoid S M)
      haveI : IsLocalization (M.map (algebraMap R S)) B := Localization.isLocalization
      haveI : Algebra.FormallyUnramified (FractionRing R) B :=
        Algebra.FormallyUnramified.localization_map M (R := R) (S := S)
          (Rₘ := FractionRing R) (Sₘ := B)
      haveI : Algebra.EssFiniteType R B := Algebra.EssFiniteType.comp R S B
      haveI : Algebra.EssFiniteType (FractionRing R) B :=
        Algebra.EssFiniteType.of_comp R (FractionRing R) B
      haveI : Module.Free (FractionRing R) B := Module.Free.of_divisionRing _ _
      haveI : Module.Finite (FractionRing R) B :=
        Algebra.FormallyUnramified.finite_of_free _ _
      have halg : IsAlgebraic R (algebraMap S B s) :=
        (IsFractionRing.isAlgebraic_iff R (FractionRing R) B).mpr
          (IsAlgebraic.of_finite _ _)
      obtain ⟨Q, hQ0, hQ⟩ := halg
      refine ⟨Q, hQ0, ?_⟩
      have hle : M.map (algebraMap R S) ≤ nonZeroDivisors S := by
        rintro _ ⟨m, hm, rfl⟩
        apply mem_nonZeroDivisors_of_ne_zero
        rw [RingHom.algebraMap_toAlgebra]
        exact (map_ne_zero_iff f hinj).mpr (nonZeroDivisors.ne_zero hm)
      have hBinj : Function.Injective (algebraMap S B) := IsLocalization.injective B hle
      apply hBinj
      rw [map_zero, ← hQ, Polynomial.aeval_def, Polynomial.hom_eval₂,
        IsScalarTower.algebraMap_eq R S B, RingHom.algebraMap_toAlgebra]
    have hh0 : h ≠ 0 := fun h0 => hh (h0 ▸ 𝔭.zero_mem)
    have P := powers_le_nonZeroDivisors_of_noZeroDivisors hh0
    haveI : IsDomain (Localization.Away h) := IsLocalization.isDomain_localization P
    have hι : Function.Injective (algebraMap A (Localization.Away h)) :=
      IsLocalization.injective _ P
    set ι := algebraMap A (Localization.Away h) with hιdef
    set φ : Polynomial ↥W →+* A := (Polynomial.aeval t).toRingHom with hφ
    have hfφ : f = ι.comp φ := by
      apply Polynomial.ringHom_ext
      · intro a
        have := RingHom.congr_fun hfC a
        simpa [hφ] using this
      · simpa [hφ] using hfX
    have hfinj : Function.Injective f := s1 _ _ f hfe
    obtain ⟨Q, hQ0, hQ⟩ := s2 _ _ f hfe hfinj (ι x)
    have hQ' : Q.eval₂ φ x = 0 := by
      apply hι
      rw [map_zero, ← hQ, hfφ, Polynomial.hom_eval₂]
    letI : Algebra (Polynomial ↥W) A := φ.toAlgebra
    have halg : IsAlgebraic (Polynomial ↥W) x :=
      ⟨Q, hQ0, by rw [Polynomial.aeval_def, RingHom.algebraMap_toAlgebra]; exact hQ'⟩
    obtain ⟨Q', hQ'0, hQ'x⟩ :=
      halg.exists_nonzero_coeff_and_aeval_eq_zero (mem_nonZeroDivisors_of_ne_zero hx)
    have hφN : φ (Q'.coeff 0) = Polynomial.aeval t (Q'.coeff 0) := rfl
    refine ⟨Q'.natDegree, fun i => Q'.coeff i, ?_, ?_⟩
    · intro h0
      apply hQ'0
      apply hfinj
      rw [map_zero f, hfφ, RingHom.comp_apply, hφN, h0, map_zero ι]
    · have e := Polynomial.aeval_eq_sum_range (p := Q') x
      rw [hQ'x] at e
      simp only [Algebra.smul_def, RingHom.algebraMap_toAlgebra] at e
      exact e.symm
  obtain ⟨N, a, ha0, hrelx⟩ := hrelA


  have content : ∀ P : Polynomial W, ∃ (w : W) (P₀ : Polynomial W) (j : ℕ),
      P = Polynomial.C w * P₀ ∧ IsUnit (P₀.coeff j) := by
    intro P
    obtain ⟨k, hk, hkd⟩ := bmin (fun i => P.coeff i) P.natDegree
    have hall : ∀ i, P.coeff k ∣ P.coeff i := by
      intro i
      rcases Nat.lt_or_ge P.natDegree i with hi | hi
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hi]; exact dvd_zero _
      · exact hkd i hi
    by_cases hk0 : P.coeff k = 0
    · refine ⟨0, 1, 0, ?_, by rw [Polynomial.coeff_one_zero]; exact isUnit_one⟩
      rw [map_zero, zero_mul]
      refine Polynomial.ext (fun i => ?_)
      rw [Polynomial.coeff_zero]
      have := hall i
      rw [hk0] at this
      exact (zero_dvd_iff (a := P.coeff i)).mp this
    · obtain ⟨P₀, hP₀⟩ := (Polynomial.C_dvd_iff_dvd_coeff _ _).mpr hall
      refine ⟨P.coeff k, P₀, k, hP₀, ?_⟩
      have e : P.coeff k * 1 = P.coeff k * P₀.coeff k := by
        rw [mul_one]
        conv_lhs => rw [hP₀]
        rw [Polynomial.coeff_C_mul]
      rw [← mul_left_cancel₀ hk0 e]; exact isUnit_one
  choose w P j hwP hPj using content


  set mA := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) with hmAdef
  let 𝔓 : Ideal A :=
    { carrier := {y | ∃ s, s ∉ 𝔭 ∧ s * y ∈ mA}
      add_mem' := by
        rintro a b ⟨s₁, hs₁, h₁⟩ ⟨s₂, hs₂, h₂⟩
        refine ⟨s₁ * s₂, hnot _ _ hs₁ hs₂, ?_⟩
        have e : s₁ * s₂ * (a + b) = s₂ * (s₁ * a) + s₁ * (s₂ * b) := by ring
        rw [e]
        exact add_mem (Ideal.mul_mem_left _ _ h₁) (Ideal.mul_mem_left _ _ h₂)
      zero_mem' := ⟨1, h1𝔭, by rw [mul_zero]; exact zero_mem _⟩
      smul_mem' := by
        rintro c y ⟨s, hs, h⟩
        refine ⟨s, hs, ?_⟩
        rw [smul_eq_mul, show s * (c * y) = c * (s * y) by ring]
        exact Ideal.mul_mem_left _ _ h }
  have mem𝔓 : ∀ y, y ∈ 𝔓 ↔ ∃ s, s ∉ 𝔭 ∧ s * y ∈ mA := fun y => Iff.rfl
  have notin𝔓 : ∀ y, y ∉ 𝔓 ↔ ∀ s, s ∉ 𝔭 → s * y ∉ mA := by
    intro y; rw [mem𝔓]; push_neg; rfl
  have h𝔓le : ∀ y, y ∈ 𝔓 → y ∈ 𝔭 := by
    rintro y ⟨s, hs, h⟩
    exact ((h𝔭p.mem_or_mem (hmA h)).resolve_left hs)
  have hmA𝔓 : ∀ y, y ∈ mA → y ∈ 𝔓 := fun y hy => ⟨1, h1𝔭, by rw [one_mul]; exact hy⟩
  have h𝔓p : 𝔓.IsPrime := by
    refine ⟨?_, ?_⟩
    · intro htop
      have h1 : (1 : A) ∈ 𝔓 := by rw [htop]; exact Submodule.mem_top
      exact h1𝔭 (h𝔓le 1 h1)
    · rintro a b ⟨s, hs, h⟩
      obtain ⟨s', hs', h' | h'⟩ := H1 (s * a) b (by rw [← mul_assoc] at h; exact h)
      · exact Or.inl ⟨s' * s, hnot _ _ hs' hs, by rw [mul_assoc]; exact h'⟩
      · exact Or.inr ⟨s', hs', h'⟩
  have ht𝔓 : t ∉ 𝔓 := (notin𝔓 t).mpr H2


  have evalsplit : ∀ Q : Polynomial W, Polynomial.aeval t Q =
      Polynomial.aeval t Q.divX * t + algebraMap W A (Q.coeff 0) := by
    intro Q
    have e := congrArg (Polynomial.aeval t) (Polynomial.divX_mul_X_add Q)
    rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at e
    exact e.symm
  have c0 : ∀ Q : Polynomial W, IsUnit (Q.coeff 0) → Polynomial.aeval t Q ∉ 𝔓 := by
    intro Q hu hQ
    have hmem : algebraMap W A (Q.coeff 0) ∈ 𝔭 := by
      have e : algebraMap W A (Q.coeff 0) =
          Polynomial.aeval t Q - Polynomial.aeval t Q.divX * t := by
        rw [evalsplit Q]; ring
      rw [e]
      exact 𝔭.sub_mem (h𝔓le _ hQ) (Ideal.mul_mem_left _ _ ht𝔭)
    exact h𝔭p.ne_top (Ideal.eq_top_of_isUnit_mem _ hmem (hu.map _))
  have ucoef : ∀ (j : ℕ) (Q : Polynomial W), IsUnit (Q.coeff j) →
      Polynomial.aeval t Q ∉ 𝔓 := by
    intro j
    induction j with
    | zero => exact c0
    | succ j ih =>
      intro Q hu hQ
      by_cases hu0 : IsUnit (Q.coeff 0)
      · exact c0 Q hu0 hQ
      · have hm0 : algebraMap W A (Q.coeff 0) ∈ 𝔓 :=
          hmA𝔓 _ (Ideal.mem_map_of_mem _ ((IsLocalRing.mem_maximalIdeal _).mpr hu0))
        have hprod : Polynomial.aeval t Q.divX * t ∈ 𝔓 := by
          have e : Polynomial.aeval t Q.divX * t =
              Polynomial.aeval t Q - algebraMap W A (Q.coeff 0) := by
            rw [evalsplit Q]; ring
          rw [e]; exact 𝔓.sub_mem hQ hm0
        rcases h𝔓p.mem_or_mem hprod with h' | h'
        · exact ih Q.divX (by rw [Polynomial.coeff_divX]; exact hu) h'
        · exact ht𝔓 h'


  have maxmul : ∀ y : A, y ∈ mA → ∃ (μ : W) (r : A),
      μ ∈ IsLocalRing.maximalIdeal W ∧ y = algebraMap W A μ * r := by
    intro y hy
    change y ∈ Submodule.span A (algebraMap W A '' (IsLocalRing.maximalIdeal W : Set W)) at hy
    induction hy using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨μ, hμ, rfl⟩ := hx
      exact ⟨μ, 1, hμ, (mul_one _).symm⟩
    | zero => exact ⟨0, 0, zero_mem _, by rw [mul_zero]⟩
    | add x y _ _ hx hy =>
      obtain ⟨μ₁, r₁, h₁, rfl⟩ := hx
      obtain ⟨μ₂, r₂, h₂, rfl⟩ := hy
      rcases ValuationRing.dvd_total μ₁ μ₂ with ⟨c, rfl⟩ | ⟨c, rfl⟩
      · exact ⟨μ₁, r₁ + algebraMap W A c * r₂, h₁, by rw [map_mul]; ring⟩
      · exact ⟨μ₂, algebraMap W A c * r₁ + r₂, h₂, by rw [map_mul]; ring⟩
    | smul b x _ hx =>
      obtain ⟨μ, r, h, rfl⟩ := hx
      exact ⟨μ, b * r, h, by rw [smul_eq_mul]; ring⟩


  haveI := h𝔓p
  let V := Localization.AtPrime 𝔓
  have hle := Ideal.primeCompl_le_nonZeroDivisors 𝔓
  haveI : IsDomain V := IsLocalization.isDomain_localization hle
  haveI : IsIntegrallyClosed V := isIntegrallyClosed_of_isLocalization V 𝔓.primeCompl hle
  have hι : Function.Injective (algebraMap A V) := IsLocalization.injective V hle
  have hWA : Function.Injective (algebraMap W A) := by
    rw [injective_iff_map_eq_zero]
    intro d hd
    have h' : d • (1 : A) = 0 := by rw [← Algebra.algebraMap_eq_smul_one]; exact hd
    rcases smul_eq_zero.mp h' with h1 | h1
    · exact h1
    · exact absurd h1 one_ne_zero
  have halgV : ∀ w : W, algebraMap W V w = algebraMap A V (algebraMap W A w) :=
    fun w => IsScalarTower.algebraMap_apply W A V w
  have hI : Function.Injective (algebraMap W V) := by
    intro a b hab
    rw [halgV, halgV] at hab
    exact hWA (hι hab)
  have hL : ∀ μ : W, μ ∈ IsLocalRing.maximalIdeal W →
      algebraMap W V μ ∈ IsLocalRing.maximalIdeal V := by
    intro μ hμ
    rw [halgV]
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff V 𝔓 _).mpr
      (hmA𝔓 _ (Ideal.mem_map_of_mem _ hμ))
  have hM : ∀ y : V, y ∈ IsLocalRing.maximalIdeal V → ∃ (μ : W) (r : V),
      μ ∈ IsLocalRing.maximalIdeal W ∧ y = algebraMap W V μ * r := by
    intro y hy
    obtain ⟨⟨a', s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔓.primeCompl y
    have hnu : ¬ IsUnit (IsLocalization.mk' V a' s) := (IsLocalRing.mem_maximalIdeal _).mp hy
    have ha' : a' ∈ 𝔓 := by
      by_contra hna
      exact hnu ((IsLocalization.AtPrime.isUnit_mk'_iff V 𝔓 a' s).mpr hna)
    obtain ⟨s', hs', hsa⟩ := ha'
    obtain ⟨μ, r₀, hμ, hr₀⟩ := maxmul _ hsa
    have hs'P : s' ∈ 𝔓.primeCompl := fun h' => hs' (h𝔓le _ h')
    refine ⟨μ, IsLocalization.mk' V r₀ (s * ⟨s', hs'P⟩), hμ, ?_⟩
    rw [halgV, IsLocalization.mul_mk'_eq_mk'_of_mul, ← hr₀, IsLocalization.mk'_eq_iff_eq]
    congr 1
    simp only [Submonoid.coe_mul]
    ring


  set ε : ℕ → V := fun i => algebraMap A V (Polynomial.aeval t (P (a i))) with hεdef
  have hε : ∀ i, IsUnit (ε i) := fun i =>
    (IsLocalization.AtPrime.isUnit_to_map_iff V 𝔓 _).mpr
      (ucoef (j (a i)) (P (a i)) (hPj (a i)))
  have hw0 : w (a 0) ≠ 0 := by
    intro h0
    apply ha0
    have e := hwP (a 0)
    rw [h0, map_zero, zero_mul] at e
    rw [e, map_zero]
  have hrelV : ∑ i ∈ Finset.range (N + 1),
      algebraMap W V (w (a i)) * ε i * (algebraMap A V x) ^ i = 0 := by
    have e := congrArg (algebraMap A V) hrelx
    rw [map_zero, map_sum] at e
    rw [← e]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    have e' := hwP (a i)
    simp only [hεdef]
    conv_rhs => rw [e']
    simp only [map_mul, map_pow, Polynomial.aeval_C, halgV]
  obtain ⟨d, υ, hd, hυ, hxd⟩ :=
    descent V hI hL hM N ε hε (fun i => w (a i)) (algebraMap A V x) hw0 hrelV


  obtain ⟨⟨u, b⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔓.primeCompl υ
  have hu : u ∈ 𝔓.primeCompl := (IsLocalization.AtPrime.isUnit_mk'_iff V 𝔓 u b).mp hυ
  refine ⟨d, u, b, hd, (notin𝔓 u).mp hu, (notin𝔓 (b : A)).mp b.2, ?_⟩
  apply hι
  rw [map_mul, hxd, map_mul, ← halgV]
  calc algebraMap A V ↑b * (algebraMap W V d * IsLocalization.mk' V u b)
      = algebraMap W V d * (IsLocalization.mk' V u b * algebraMap A V ↑b) := by ring
    _ = algebraMap W V d * algebraMap A V u := by rw [IsLocalization.mk'_spec]

theorem wcpa_dj_llsm_kpd_disc_factorization : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) → ∀ f : A, f ≠ 0 →
    ∃ (r : ℕ) (c : Fin r → ↥W) (n : Fin r → ℕ) (d : ↥W) (a s : A), Function.Injective c ∧
      (∀ i, c i ∈ IsLocalRing.maximalIdeal ↥W) ∧ d ≠ 0 ∧ a ∉ 𝔭 ∧ s ∉ 𝔭 ∧
      s * f = algebraMap ↥W A d * a * ∏ i, (t - algebraMap ↥W A (c i)) ^ (n i) :=
by
  intro Ω _ _ W hW hWt A _ _ _ 𝔭 t hPD f hf
  classical
  have hPD' := hPD
  obtain ⟨_, hnzd, _, hmax, hmA, ht𝔭, -⟩ := hPD'
  have h𝔭p : 𝔭.IsPrime := hmax.isPrime
  have hnot : ∀ x y : A, x ∉ 𝔭 → y ∉ 𝔭 → x * y ∉ 𝔭 := fun x y hx hy h =>
    (h𝔭p.mem_or_mem h).elim hx hy
  have hW0 : ∀ d : ↥W, d ≠ 0 → algebraMap ↥W A d ≠ 0 := by
    intro d hd h
    have h' : d • (1 : A) = 0 := by rw [← Algebra.algebraMap_eq_smul_one]; exact h
    rcases smul_eq_zero.mp h' with h1 | h1
    · exact hd h1
    · exact one_ne_zero h1
  obtain ⟨hs1a, hs1b, hs1c⟩ := wcpa_dj_llsm_kpdf_special_fibre_dvr Ω W hW hWt A 𝔭 t hPD

  have notP_mul : ∀ a b : A,
      (∀ s : A, s ∉ 𝔭 → s * a ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) →
      (∀ s : A, s ∉ 𝔭 → s * b ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) →
      ∀ s : A, s ∉ 𝔭 → s * (a * b) ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
    intro a b ha hb s hs hab
    obtain ⟨s', hs', h | h⟩ := hs1a (s * a) b (by rwa [← mul_assoc] at hab)
    · exact ha (s' * s) (hnot _ _ hs' hs) (by rwa [mul_assoc])
    · exact hb s' hs' h

  have CL : ∀ x : A, x ≠ 0 → ∃ (s : A) (d : ↥W) (a : A), s ∉ 𝔭 ∧ d ≠ 0 ∧
      (∀ s' : A, s' ∉ 𝔭 → s' * a ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧
      s * x = algebraMap ↥W A d * a := by
    intro x hx
    obtain ⟨d, u, b, hd, hu, hb, hbx⟩ :=
      wcpa_dj_llsm_kpdf_generic_valuation Ω W hW hWt A 𝔭 t hPD hs1a hs1b x hx
    obtain ⟨s, a, hs, hsa⟩ :=
      wcpa_dj_llsm_kpdf_fibre_nzd Ω W hW hWt A 𝔭 t hPD hs1c b x u d hd hb hbx
    refine ⟨s, d, a, hs, hd, ?_, hsa⟩
    have hba : b * a = s * u := by
      apply mul_left_cancel₀ (hW0 d hd)
      calc algebraMap ↥W A d * (b * a) = b * (algebraMap ↥W A d * a) := by ring
        _ = b * (s * x) := by rw [hsa]
        _ = s * (b * x) := by ring
        _ = s * (algebraMap ↥W A d * u) := by rw [hbx]
        _ = algebraMap ↥W A d * (s * u) := by ring
    intro s' hs' hs'a
    apply hu (s' * s) (hnot _ _ hs' hs)
    have e : s' * s * u = b * (s' * a) := by
      rw [mul_assoc, ← hba]; ring
    rw [e]
    exact Ideal.mul_mem_left _ b hs'a

  have claim : ∀ (r : ℕ) (c : Fin r → ↥W), (∀ i, c i ∈ IsLocalRing.maximalIdeal ↥W) →
      ∀ K : ℕ, ∀ (k : Fin r → ℕ), ∑ i, k i = K → ∀ (f' g' : A) (d' : ↥W) (q : A),
      d' ≠ 0 → q ∉ 𝔭 →
      f' * g' = algebraMap ↥W A d' * q * ∏ i, (t - algebraMap ↥W A (c i)) ^ (k i) →
      ∃ (n : Fin r → ℕ) (d : ↥W) (a s : A), d ≠ 0 ∧ a ∉ 𝔭 ∧ s ∉ 𝔭 ∧
        s * f' = algebraMap ↥W A d * a * ∏ i, (t - algebraMap ↥W A (c i)) ^ (n i) := by
    intro r c hc K
    induction K with
    | zero =>
      intro k hk f' g' d' q hd' hq hfg
      have hk0 : ∀ i, k i = 0 := fun i =>
        (Finset.sum_eq_zero_iff.mp hk) i (Finset.mem_univ i)
      have hprod : ∏ i, (t - algebraMap ↥W A (c i)) ^ (k i) = 1 := by simp [hk0]
      rw [hprod, mul_one] at hfg
      have hq0 : q ≠ 0 := fun h => hq (h ▸ 𝔭.zero_mem)
      have hfg0 : f' * g' ≠ 0 := by rw [hfg]; exact mul_ne_zero (hW0 d' hd') hq0
      have hf' : f' ≠ 0 := left_ne_zero_of_mul hfg0
      have hg' : g' ≠ 0 := right_ne_zero_of_mul hfg0
      obtain ⟨s₁, d₁, a₁, hs₁, hd₁, ha₁, he₁⟩ := CL f' hf'
      obtain ⟨s₂, d₂, a₂, hs₂, hd₂, ha₂, he₂⟩ := CL g' hg'
      have key : algebraMap ↥W A (d₁ * d₂) * (a₁ * a₂) = algebraMap ↥W A d' * (s₁ * s₂ * q) := by
        calc algebraMap ↥W A (d₁ * d₂) * (a₁ * a₂)
            = (algebraMap ↥W A d₁ * a₁) * (algebraMap ↥W A d₂ * a₂) := by rw [map_mul]; ring
          _ = (s₁ * f') * (s₂ * g') := by rw [he₁, he₂]
          _ = s₁ * s₂ * (f' * g') := by ring
          _ = algebraMap ↥W A d' * (s₁ * s₂ * q) := by rw [hfg]; ring
      have hsq : s₁ * s₂ * q ∉ 𝔭 := hnot _ _ (hnot _ _ hs₁ hs₂) hq
      have hd12 : d₁ * d₂ ≠ 0 := mul_ne_zero hd₁ hd₂
      refine ⟨0, d₁, a₁, s₁, hd₁, ?_, hs₁, by simp [he₁]⟩
      intro ha₁𝔭
      rcases ValuationRing.dvd_total (d₁ * d₂) d' with ⟨e, he⟩ | ⟨e, he⟩
      ·
        have h2 : a₁ * a₂ = algebraMap ↥W A e * (s₁ * s₂ * q) := by
          apply mul_left_cancel₀ (hW0 _ hd12)
          rw [key, he, map_mul]; ring
        by_cases heu : IsUnit e
        · have hmem : algebraMap ↥W A e * (s₁ * s₂ * q) ∈ 𝔭 := by
            rw [← h2]; exact Ideal.mul_mem_right _ _ ha₁𝔭
          rcases h𝔭p.mem_or_mem hmem with h | h
          · exact h𝔭p.ne_top (Ideal.eq_top_of_isUnit_mem _ h (heu.map _))
          · exact hsq h
        · have he' : e ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal e).mpr heu
          have hmem : a₁ * a₂ ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
            rw [h2]; exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ he')
          exact notP_mul a₁ a₂ ha₁ ha₂ 1 (fun h => h𝔭p.ne_top ((Ideal.eq_top_iff_one _).mpr h))
            (by rwa [one_mul])
      ·
        have h2 : algebraMap ↥W A e * (a₁ * a₂) = s₁ * s₂ * q := by
          apply mul_left_cancel₀ (hW0 _ hd')
          rw [← key, he, map_mul]; ring
        apply hsq
        rw [← h2]
        exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_right _ _ ha₁𝔭)
    | succ K ih =>
      intro k hk f' g' d' q hd' hq hfg
      obtain ⟨i, hi⟩ : ∃ i, k i ≠ 0 := by
        by_contra hcon
        push_neg at hcon
        have : ∑ i, k i = 0 := Finset.sum_eq_zero (fun i _ => hcon i)
        omega
      set k' : Fin r → ℕ := k - Pi.single i 1 with hk'def
      have hkk : k = k' + (Pi.single i 1 : Fin r → ℕ) := by
        funext j
        by_cases hj : j = i
        · subst hj; simp [hk'def]; omega
        · simp [hk'def, hj]
      have hk' : ∑ j, k' j = K := by
        have : ∑ j, k j = ∑ j, k' j + 1 := by
          conv_lhs => rw [hkk]
          simp only [Pi.add_apply]
          rw [Finset.sum_add_distrib]
          simp
        omega
      have hprodS : ∀ m : Fin r → ℕ,
          ∏ j, (t - algebraMap ↥W A (c j)) ^ ((m + (Pi.single i 1 : Fin r → ℕ)) j) =
            (t - algebraMap ↥W A (c i)) * ∏ j, (t - algebraMap ↥W A (c j)) ^ (m j) := by
        intro m
        have hs : ∏ j, (t - algebraMap ↥W A (c j)) ^ ((Pi.single i 1 : Fin r → ℕ) j) =
            t - algebraMap ↥W A (c i) := by
          rw [Fintype.prod_eq_single i (fun j hj => by rw [Pi.single_eq_of_ne hj, pow_zero])]
          rw [Pi.single_eq_same, pow_one]
        simp only [Pi.add_apply, pow_add, Finset.prod_mul_distrib]
        rw [hs, mul_comm]
      have hX0 : t - algebraMap ↥W A (c i) ≠ 0 := by
        intro h
        have htm : t = algebraMap ↥W A (c i) := sub_eq_zero.mp h
        apply hs1b 1 (fun h => h𝔭p.ne_top ((Ideal.eq_top_iff_one _).mpr h))
        rw [one_mul, htm]
        exact Ideal.mem_map_of_mem _ (hc i)
      rw [hkk, hprodS] at hfg
      have hmem : f' * g' ∈ Ideal.span {t - algebraMap ↥W A (c i)} := by
        rw [hfg, Ideal.mem_span_singleton]
        exact ⟨algebraMap ↥W A d' * q * ∏ j, (t - algebraMap ↥W A (c j)) ^ (k' j), by ring⟩
      obtain ⟨s', hs', h1 | h1⟩ :=
        wcpa_dj_llsm_kpdf_section_prime Ω W hW hWt A 𝔭 t hPD (c i) (hc i) f' g' hmem
      · obtain ⟨f'', hf''⟩ := Ideal.mem_span_singleton'.mp h1
        have hfg' : f'' * g' = algebraMap ↥W A d' * (s' * q) *
            ∏ j, (t - algebraMap ↥W A (c j)) ^ (k' j) := by
          apply mul_left_cancel₀ hX0
          calc (t - algebraMap ↥W A (c i)) * (f'' * g') = (f'' * (t - algebraMap ↥W A (c i))) * g' := by ring
            _ = s' * (f' * g') := by rw [hf'']; ring
            _ = _ := by rw [hfg]; ring
        obtain ⟨n, d, a, s'', hd, ha, hs'', he⟩ := ih k' hk' f'' g' d' (s' * q) hd' (hnot _ _ hs' hq) hfg'
        refine ⟨n + Pi.single i 1, d, a, s'' * s', hd, ha, hnot _ _ hs'' hs', ?_⟩
        rw [hprodS]
        calc s'' * s' * f' = s'' * (s' * f') := by ring
          _ = (t - algebraMap ↥W A (c i)) * (s'' * f'') := by rw [← hf'']; ring
          _ = _ := by rw [he]; ring
      · obtain ⟨g'', hg''⟩ := Ideal.mem_span_singleton'.mp h1
        have hfg' : f' * g'' = algebraMap ↥W A d' * (s' * q) *
            ∏ j, (t - algebraMap ↥W A (c j)) ^ (k' j) := by
          apply mul_left_cancel₀ hX0
          calc (t - algebraMap ↥W A (c i)) * (f' * g'') = f' * (g'' * (t - algebraMap ↥W A (c i))) := by ring
            _ = s' * (f' * g') := by rw [hg'']; ring
            _ = _ := by rw [hfg]; ring
        exact ih k' hk' f' g'' d' (s' * q) hd' (hnot _ _ hs' hq) hfg'

  obtain ⟨N, g₀, hN0, hfg₀⟩ := wcpa_dj_llsm_kpdf_norm_divisor Ω W hW hWt A 𝔭 t hPD f hf
  have hN : N ≠ 0 := by rintro rfl; simp at hN0
  obtain ⟨r, c, n, d₀, p, hcinj, hcm, hd₀, hp0, hNeq⟩ := wcpa_dj_llsm_kpdf_poly_factor Ω W N hN
  have hfg : f * g₀ = algebraMap ↥W A d₀ * Polynomial.aeval t p *
      ∏ i, (t - algebraMap ↥W A (c i)) ^ (n i) := by
    rw [hfg₀, hNeq]
    simp [map_mul, map_prod, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
  have hq : Polynomial.aeval t p ∉ 𝔭 := by
    intro hp𝔭
    obtain ⟨h, hh⟩ := Polynomial.X_dvd_sub_C (p := p)
    have e1 : Polynomial.aeval t p - algebraMap ↥W A (p.coeff 0) = t * Polynomial.aeval t h := by
      have := congrArg (Polynomial.aeval t) hh
      simpa [map_sub, Polynomial.aeval_C, Polynomial.aeval_X] using this
    have hmem : algebraMap ↥W A (p.coeff 0) ∈ 𝔭 := by
      have : algebraMap ↥W A (p.coeff 0) =
          Polynomial.aeval t p - t * Polynomial.aeval t h := by rw [← e1]; ring
      rw [this]
      exact 𝔭.sub_mem hp𝔭 (Ideal.mul_mem_right _ _ ht𝔭)
    rw [Polynomial.coeff_zero_eq_eval_zero] at hmem
    exact h𝔭p.ne_top (Ideal.eq_top_of_isUnit_mem _ hmem (hp0.map _))
  obtain ⟨n', d, a, s, hd, ha, hs, he⟩ :=
    claim r c hcm (∑ i, n i) n rfl f g₀ d₀ (Polynomial.aeval t p) hd₀ hq hfg
  exact ⟨r, c, n', d, a, s, hcinj, hcm, hd, ha, hs, he⟩

theorem wcpa_dj_llsm_kprs_generic_prime : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) (t : A) (c : ↥W), wcLlsPD W A 𝔭 (.disc t) → c ∈ IsLocalRing.maximalIdeal ↥W → ∃ q : Ideal A, q.IsPrime ∧ q ≤ 𝔭 ∧ (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ q) ∧ t - algebraMap ↥W A c ∈ q ∧ t - algebraMap ↥W A c ≠ 0 :=
by
  intro Ω _ W A _ _ _ 𝔭 t c hPD hc
  classical
  obtain ⟨-, -, -, h𝔭max, hm𝔭, ht𝔭, -, h, hh, φ, hφC, hφX, hφet⟩ := hPD
  have h𝔭 : 𝔭.IsPrime := h𝔭max.isPrime
  set τ := t - algebraMap ↥W A c with hτdef
  set B := Localization.Away h
  set ι := algebraMap A B with hιdef

  have hτ𝔭 : τ ∈ 𝔭 := by
    have hc' : algebraMap ↥W A c ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) :=
      Ideal.mem_map_of_mem _ hc
    exact Ideal.sub_mem _ ht𝔭 (hm𝔭 hc')

  have hφCw : ∀ w : ↥W, φ (Polynomial.C w) = ι (algebraMap ↥W A w) := by
    intro w
    exact RingHom.congr_fun hφC w
  have hφτ : φ (Polynomial.X - Polynomial.C c) = ι τ := by
    rw [map_sub, hφX, hφCw, hτdef, map_sub]

  have hdisj : Disjoint ((Submonoid.powers h : Submonoid A) : Set A) (𝔭 : Set A) := by
    rw [Set.disjoint_left]
    intro x hx hx𝔭
    obtain ⟨n, rfl⟩ := Submonoid.mem_powers_iff _ _ |>.mp hx
    exact hh (h𝔭.mem_of_pow_mem n hx𝔭)
  set 𝔭' := 𝔭.map ι with h𝔭'def
  haveI h𝔭' : 𝔭'.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) B 𝔭 h𝔭 hdisj
  have hunder : 𝔭'.comap ι = 𝔭 :=
    IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers h) B h𝔭 hdisj

  letI : Algebra (Polynomial ↥W) B := φ.toAlgebra
  haveI : Algebra.Etale (Polynomial ↥W) B := hφet
  haveI : Algebra.HasGoingDown (Polynomial ↥W) B := Algebra.HasGoingDown.of_flat

  have halg : algebraMap (Polynomial ↥W) B = φ := rfl
  set q₁ := Ideal.under (Polynomial ↥W) 𝔭' with hq₁
  haveI : q₁.IsPrime := Ideal.IsPrime.under _ _
  haveI : 𝔭'.LiesOver q₁ := ⟨rfl⟩
  set P₀ : Ideal (Polynomial ↥W) := Ideal.span {Polynomial.X - Polynomial.C c} with hP₀
  haveI hP₀prime : P₀.IsPrime :=
    (Ideal.span_singleton_prime (Polynomial.X_sub_C_ne_zero c)).mpr (Polynomial.prime_X_sub_C c)
  haveI : (⊥ : Ideal (Polynomial ↥W)).IsPrime := Ideal.isPrime_bot
  have hP₀q₁ : P₀ ≤ q₁ := by
    rw [hP₀, Ideal.span_le, Set.singleton_subset_iff]
    show Polynomial.X - Polynomial.C c ∈ Ideal.comap (algebraMap (Polynomial ↥W) B) 𝔭'
    rw [Ideal.mem_comap, halg, hφτ]
    exact Ideal.mem_map_of_mem _ hτ𝔭

  obtain ⟨P, hP𝔭', hPprime, hPover⟩ := Ideal.exists_ideal_le_liesOver_of_le 𝔭' hP₀q₁
  obtain ⟨P', -, hP'prime, hP'over⟩ :=
    Ideal.exists_ideal_le_liesOver_of_le (p := (⊥ : Ideal (Polynomial ↥W))) (q := q₁) 𝔭' bot_le
  have hPeq : P₀ = P.comap φ := hPover.over
  have hP'eq : (⊥ : Ideal (Polynomial ↥W)) = P'.comap φ := hP'over.over

  refine ⟨P.comap ι, Ideal.IsPrime.comap ι, ?_, ?_, ?_, ?_⟩
  · intro x hx
    rw [← hunder]
    exact hP𝔭' hx
  · intro w hw hwq
    rw [Ideal.mem_comap, ← hφCw] at hwq
    have hmem : Polynomial.C w ∈ P₀ := by rw [hPeq]; exact hwq
    rw [hP₀, Ideal.mem_span_singleton, Polynomial.dvd_iff_isRoot] at hmem
    apply hw
    simpa [Polynomial.IsRoot] using hmem
  · rw [Ideal.mem_comap, ← hφτ]
    have hmem : Polynomial.X - Polynomial.C c ∈ P₀ := Ideal.mem_span_singleton_self _
    rw [hPeq] at hmem
    exact hmem
  · intro hτ0
    have hmem : Polynomial.X - Polynomial.C c ∈ P'.comap φ := by
      rw [Ideal.mem_comap, hφτ, hτ0, map_zero]
      exact P'.zero_mem
    rw [← hP'eq, Ideal.mem_bot] at hmem
    exact Polynomial.X_sub_C_ne_zero c hmem

theorem wcpa_dj_llsm_kprs_local_factor : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) (t : A) (c : ↥W) (q : Ideal A), wcLlsPD W A 𝔭 (.disc t) → q.IsPrime → q ≤ 𝔭 → (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ q) → t - algebraMap ↥W A c ∈ q → t - algebraMap ↥W A c ≠ 0 → ∀ a : A, a ≠ 0 → ∃ (k : ℕ) (u b : A), u ∉ q ∧ b ∉ q ∧ u * a = b * (t - algebraMap ↥W A c) ^ k :=
by

  have s4 : ∀ (S : Type u) [CommRing S] [IsLocalRing S] [IsNoetherianRing S] (τ : S),
      IsLocalRing.maximalIdeal S = Ideal.span {τ} → ∀ x : S, x ≠ 0 →
      ∃ (n : ℕ) (v : S), IsUnit v ∧ x = τ ^ n * v := by
    intro S _ _ _ τ hm x hx
    classical
    have hK := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal S)
      (IsLocalRing.maximalIdeal.isMaximal S).ne_top
    have hex : ∃ n, x ∉ Ideal.span {τ ^ n} := by
      by_contra hcon
      push_neg at hcon
      apply hx
      have : x ∈ ⨅ i, IsLocalRing.maximalIdeal S ^ i := by
        rw [Ideal.mem_iInf]
        intro i
        rw [hm, Ideal.span_singleton_pow]
        exact hcon i
      rw [hK] at this
      exact (Ideal.mem_bot.mp this)
    have hN : x ∉ Ideal.span {τ ^ Nat.find hex} := Nat.find_spec hex
    have hN0 : Nat.find hex ≠ 0 := by
      intro h0
      apply hN
      rw [h0, pow_zero, Ideal.span_singleton_one]
      exact Submodule.mem_top
    obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero hN0
    have hmin : x ∈ Ideal.span {τ ^ n} := by
      have := Nat.find_min hex (show n < Nat.find hex by omega)
      exact not_not.mp this
    obtain ⟨v, hv⟩ := Ideal.mem_span_singleton'.mp hmin
    refine ⟨n, v, ?_, by rw [← hv, mul_comm]⟩
    by_contra hvu
    have hvm : v ∈ IsLocalRing.maximalIdeal S := (IsLocalRing.mem_maximalIdeal v).mpr hvu
    rw [hm] at hvm
    obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hvm
    apply hN
    rw [hn, Ideal.mem_span_singleton']
    exact ⟨w, by rw [← hv, ← hw, pow_succ]; ring⟩

  have s5 : ∀ (A : Type u) [CommRing A] [IsDomain A] (q : Ideal A) [q.IsPrime] (T : Type u)
      [CommRing T] [Algebra A T] [IsLocalization.AtPrime T q] (τ a : A), a ≠ 0 →
      (∀ x : T, x ≠ 0 → ∃ (n : ℕ) (v : T), IsUnit v ∧ x = algebraMap A T τ ^ n * v) →
      ∃ (k : ℕ) (u b : A), u ∉ q ∧ b ∉ q ∧ u * a = b * τ ^ k := by
    intro A _ _ q _ T _ _ _ τ a ha H
    have hinj : Function.Injective (algebraMap A T) :=
      IsLocalization.injective T (Ideal.primeCompl_le_nonZeroDivisors q)
    have ha' : algebraMap A T a ≠ 0 := by
      rw [Ne, ← map_zero (algebraMap A T)]; exact fun h => ha (hinj h)
    obtain ⟨n, v, hv, hav⟩ := H _ ha'
    obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.mk'_surjective q.primeCompl v
    dsimp only at hbs
    subst hbs
    have hb : b ∉ q := (IsLocalization.AtPrime.isUnit_mk'_iff T q b s).mp hv
    have key : algebraMap A T (s * a) = algebraMap A T (b * τ ^ n) := by
      rw [map_mul, hav, map_mul, map_pow]
      have := IsLocalization.mk'_spec T b s
      calc (algebraMap A T s) * (algebraMap A T τ ^ n * IsLocalization.mk' T b s)
          = algebraMap A T τ ^ n * (IsLocalization.mk' T b s * algebraMap A T s) := by ring
        _ = _ := by rw [this]; ring
    obtain ⟨z, hz⟩ := (IsLocalization.eq_iff_exists q.primeCompl T).mp key
    refine ⟨n, z * s, z * b, ?_, ?_, ?_⟩
    · exact Ideal.IsPrime.mul_notMem ‹_› z.2 s.2
    · exact Ideal.IsPrime.mul_notMem ‹_› z.2 hb
    · calc (z : A) * s * a = z * (s * a) := by ring
        _ = z * (b * τ ^ n) := hz
        _ = _ := by ring

  have s1 : ∀ (D B : Type u) [CommRing D] [CommRing B] (φ : Polynomial D →+* B) (I : Ideal B)
      (c : D), φ (Polynomial.X - Polynomial.C c) ∈ I →
      (∀ d : D, φ (Polynomial.C d) ∈ I → d = 0) →
      I.comap φ = Ideal.span {Polynomial.X - Polynomial.C c} := by
    intro D B _ _ φ I c h1 h2
    apply le_antisymm
    · intro g hg
      rw [Ideal.mem_comap] at hg
      have hdec := Polynomial.modByMonic_add_div g (Polynomial.X - Polynomial.C c)
      rw [Polynomial.modByMonic_X_sub_C_eq_C_eval] at hdec
      have hφ := congrArg φ hdec
      rw [map_add, map_mul] at hφ
      have hC : φ (Polynomial.C (g.eval c)) ∈ I := by
        rw [eq_sub_of_add_eq hφ]
        exact I.sub_mem hg (I.mul_mem_right _ h1)
      have h0 := h2 _ hC
      rw [Ideal.mem_span_singleton]
      exact Polynomial.dvd_iff_isRoot.mpr h0
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact h1

  have s2 : ∀ (D : Type u) [CommRing D] [IsDomain D] (c : D) (P₀ : Ideal (Polynomial D))
      [P₀.IsPrime], P₀ = Ideal.span {Polynomial.X - Polynomial.C c} →
      IsNoetherianRing (Localization.AtPrime P₀) := by
    intro D _ _ c P₀ _ hP
    have hinj : Function.Injective (algebraMap (Polynomial D) (Localization.AtPrime P₀)) :=
      IsLocalization.injective (Localization.AtPrime P₀) (Ideal.primeCompl_le_nonZeroDivisors P₀)
    have hp0 : algebraMap (Polynomial D) (Localization.AtPrime P₀)
        (Polynomial.X - Polynomial.C c) ≠ 0 := by
      intro h
      rw [← map_zero (algebraMap (Polynomial D) (Localization.AtPrime P₀))] at h
      exact Polynomial.X_sub_C_ne_zero c (hinj h)
    have hspan : Ideal.span {algebraMap (Polynomial D) (Localization.AtPrime P₀)
        (Polynomial.X - Polynomial.C c)} = IsLocalRing.maximalIdeal (Localization.AtPrime P₀) := by
      rw [← Localization.AtPrime.map_eq_maximalIdeal]
      calc _ = Ideal.map (algebraMap (Polynomial D) (Localization.AtPrime P₀))
            (Ideal.span {Polynomial.X - Polynomial.C c}) := by
            rw [Ideal.map_span, Set.image_singleton]
        _ = _ := by rw [← hP]
    have hprime : Prime (algebraMap (Polynomial D) (Localization.AtPrime P₀)
        (Polynomial.X - Polynomial.C c)) := by
      rw [← Ideal.span_singleton_prime hp0, hspan]
      exact (IsLocalRing.maximalIdeal.isMaximal _).isPrime
    have hdvr : IsDiscreteValuationRing (Localization.AtPrime P₀) := by
      apply IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization
      refine ⟨_, hprime.irreducible, ?_⟩
      intro x hx
      obtain ⟨⟨g, s⟩, hgs⟩ := IsLocalization.mk'_surjective P₀.primeCompl x
      dsimp only at hgs
      subst hgs
      have hg : g ≠ 0 := by
        rintro rfl
        exact hx (IsLocalization.mk'_zero _)
      obtain ⟨r, hr, hndvd⟩ := Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd g hg c
      have hrP : r ∈ P₀.primeCompl := by
        intro hrm
        rw [hP] at hrm
        exact hndvd (Ideal.mem_span_singleton.mp hrm)
      have h1P : (1 : Polynomial D) ∈ P₀.primeCompl := fun h =>
        (‹P₀.IsPrime›).ne_top ((Ideal.eq_top_iff_one _).mpr h)
      have hu1 : IsUnit (algebraMap (Polynomial D) (Localization.AtPrime P₀) r) :=
        IsLocalization.map_units (Localization.AtPrime P₀) (⟨r, hrP⟩ : P₀.primeCompl)
      have hu2 := (IsLocalization.AtPrime.isUnit_mk'_iff (Localization.AtPrime P₀) P₀ 1 s).mpr h1P
      set m := g.rootMultiplicity c with hmdef
      refine ⟨m, hu1.unit * hu2.unit, ?_⟩
      rw [Units.val_mul, IsUnit.unit_spec, IsUnit.unit_spec]
      conv_rhs => rw [IsLocalization.mk'_eq_mul_mk'_one, hr, map_mul, map_pow]
      ring
    infer_instance

  have s3 : ∀ (D B : Type u) [CommRing D] [CommRing B] (φ : Polynomial D →+* B) (c : D)
      (P : Ideal B) [P.IsPrime], RingHom.Etale φ →
      P.comap φ = Ideal.span {Polynomial.X - Polynomial.C c} →
      IsNoetherianRing (Localization.AtPrime (P.comap φ)) →
      IsNoetherianRing (Localization.AtPrime P) ∧
        IsLocalRing.maximalIdeal (Localization.AtPrime P) =
          Ideal.span {algebraMap B (Localization.AtPrime P) (φ (Polynomial.X - Polynomial.C c))} := by
    intro D B _ _ φ c P _ hφ hP0 hR
    letI : Algebra (Polynomial D) B := φ.toAlgebra
    haveI : Algebra.Etale (Polynomial D) B := hφ
    let ψ : Localization.AtPrime (P.comap φ) →+* Localization.AtPrime P :=
      Localization.localRingHom (P.comap φ) P φ rfl
    letI : Algebra (Localization.AtPrime (P.comap φ)) (Localization.AtPrime P) := ψ.toAlgebra
    haveI : IsLocalHom (algebraMap (Localization.AtPrime (P.comap φ)) (Localization.AtPrime P)) :=
      Localization.isLocalHom_localRingHom _ _ _ rfl
    haveI : IsScalarTower (Polynomial D) (Localization.AtPrime (P.comap φ))
        (Localization.AtPrime P) :=
      IsScalarTower.of_algebraMap_eq (fun x => by
        rw [IsScalarTower.algebraMap_apply (Polynomial D) B (Localization.AtPrime P) x]
        exact (Localization.localRingHom_to_map _ _ _ rfl x).symm)
    haveI : Algebra.EssFiniteType B (Localization.AtPrime P) :=
      Algebra.EssFiniteType.of_isLocalization _ P.primeCompl
    haveI : Algebra.EssFiniteType (Polynomial D) (Localization.AtPrime P) :=
      Algebra.EssFiniteType.comp (Polynomial D) B (Localization.AtPrime P)
    haveI : Algebra.EssFiniteType (Localization.AtPrime (P.comap φ)) (Localization.AtPrime P) :=
      Algebra.EssFiniteType.of_comp (Polynomial D) _ _
    haveI : Algebra.FormallyUnramified B (Localization.AtPrime P) :=
      Algebra.FormallyUnramified.of_isLocalization P.primeCompl
    haveI : Algebra.FormallyUnramified (Polynomial D) (Localization.AtPrime P) :=
      Algebra.FormallyUnramified.comp (Polynomial D) B (Localization.AtPrime P)
    haveI : Algebra.FormallyUnramified (Localization.AtPrime (P.comap φ))
        (Localization.AtPrime P) :=
      Algebra.FormallyUnramified.of_restrictScalars (Polynomial D) _ _
    haveI := hR
    refine ⟨Algebra.EssFiniteType.isNoetherianRing (Localization.AtPrime (P.comap φ)) _, ?_⟩
    rw [← Algebra.FormallyUnramified.map_maximalIdeal
      (R := Localization.AtPrime (P.comap φ)) (S := Localization.AtPrime P),
      ← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_map,
      ← IsScalarTower.algebraMap_eq]
    calc _ = Ideal.map (algebraMap (Polynomial D) (Localization.AtPrime P))
          (Ideal.span {Polynomial.X - Polynomial.C c}) := by rw [← hP0]
      _ = _ := by
        rw [Ideal.map_span, Set.image_singleton,
          IsScalarTower.algebraMap_apply (Polynomial D) B (Localization.AtPrime P)]
        rfl

  intro Ω _ W A _ _ _ 𝔭 t c q hPD hq hq𝔭 hqW hτq _ a ha
  obtain ⟨-, -, -, -, -, -, -, h, hh𝔭, φ, hφC, hφX, hφet⟩ := hPD
  have hhq : h ∉ q := fun hh => hh𝔭 (hq𝔭 hh)
  have hdisj : Disjoint (Submonoid.powers h : Set A) (q : Set A) := by
    rw [Set.disjoint_left]
    rintro x ⟨n, rfl⟩ hx
    exact hhq (hq.mem_of_pow_mem n hx)
  haveI hP : (q.map (algebraMap A (Localization.Away h))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) _ q hq hdisj
  have hcomap : (q.map (algebraMap A (Localization.Away h))).comap
      (algebraMap A (Localization.Away h)) = q :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers h) _ hq hdisj
  have hφτ : φ (Polynomial.X - Polynomial.C c) =
      algebraMap A (Localization.Away h) (t - algebraMap ↥W A c) := by
    rw [map_sub, map_sub, hφX]
    congr 1
    exact RingHom.congr_fun hφC c
  have hP0 : (q.map (algebraMap A (Localization.Away h))).comap φ =
      Ideal.span {Polynomial.X - Polynomial.C c} := by
    apply s1 ↥W _ φ _ c
    · rw [hφτ]; exact Ideal.mem_map_of_mem _ hτq
    · intro d hd
      have h1 : algebraMap A (Localization.Away h) (algebraMap ↥W A d) ∈
          q.map (algebraMap A (Localization.Away h)) := by
        rw [← RingHom.comp_apply, ← hφC]; exact hd
      have hq' : algebraMap ↥W A d ∈ q := by
        rw [← hcomap]; exact h1
      by_contra hd0
      exact hqW d hd0 hq'
  have hR := s2 ↥W c _ hP0
  obtain ⟨hT, hm⟩ := s3 ↥W _ φ c _ hφet hP0 hR
  haveI := hT
  haveI hloc : IsLocalization.AtPrime
      (Localization.AtPrime (q.map (algebraMap A (Localization.Away h)))) q := by
    have h1 := IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
      (Submonoid.powers h)
      (Localization.AtPrime (q.map (algebraMap A (Localization.Away h))))
      (q.map (algebraMap A (Localization.Away h)))
    have h2 : IsLocalization ((q.map (algebraMap A (Localization.Away h))).comap
      (algebraMap A (Localization.Away h))).primeCompl
      (Localization.AtPrime (q.map (algebraMap A (Localization.Away h)))) := h1
    have heq : ((q.map (algebraMap A (Localization.Away h))).comap
        (algebraMap A (Localization.Away h))).primeCompl = q.primeCompl := by
      ext x
      rw [Ideal.mem_primeCompl_iff, Ideal.mem_primeCompl_iff, hcomap]
    rw [heq] at h2
    exact h2
  have hgen : algebraMap (Localization.Away h)
      (Localization.AtPrime (q.map (algebraMap A (Localization.Away h))))
      (φ (Polynomial.X - Polynomial.C c)) =
      algebraMap A (Localization.AtPrime (q.map (algebraMap A (Localization.Away h))))
        (t - algebraMap ↥W A c) := by
    rw [hφτ, ← IsScalarTower.algebraMap_apply]
  rw [hgen] at hm
  exact s5 A q _ (t - algebraMap ↥W A c) a ha (fun x hx => s4 _ _ hm x hx)

theorem wcpa_dj_llsm_kprs_dominating_valuation : ∀ (A : Type u) [CommRing A] (L : Type u) [Field L] [Algebra A L] (Q : Ideal ↥(integralClosure A L)), Q.IsPrime → ∃ V : ValuationSubring L, (∀ x : ↥(integralClosure A L), (x : L) ∈ V) ∧ ∀ x : ↥(integralClosure A L), x ∈ Q ↔ V.valuation (x : L) < 1 :=
by
  intro A _ L _ _ Q hQ
  let R : Subring L := (integralClosure A L).toSubring
  let φ : R →+* ↥(integralClosure A L) :=
    { toFun := fun x => ⟨(x : L), x.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let Q' : Ideal R := Q.comap φ
  have : Q'.IsPrime := Ideal.comap_isPrime φ Q
  let P := LocalSubring.ofPrime R Q'
  obtain ⟨B, hle⟩ := LocalSubring.exists_le_valuationSubring P
  obtain ⟨hPB, hloc⟩ := LocalSubring.le_def.mp hle
  refine ⟨B, ?_, ?_⟩
  · intro x
    exact hPB (LocalSubring.le_ofPrime R Q' x.2)
  · intro x
    let x' : R := ⟨(x : L), x.2⟩
    let y : P.toSubring := algebraMap R P.toSubring x'
    let z : B := Subring.inclusion hPB y
    have hz : (z : L) = (x : L) := rfl
    have h1 : x ∈ Q ↔ y ∈ IsLocalRing.maximalIdeal P.toSubring := by
      rw [IsLocalization.AtPrime.to_map_mem_maximal_iff P.toSubring Q' x']
      rfl
    have h2 : y ∈ IsLocalRing.maximalIdeal P.toSubring ↔ z ∈ IsLocalRing.maximalIdeal B := by
      rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
        mem_nonunits_iff]
      constructor
      · intro h hu
        exact h (hloc.map_nonunit y hu)
      · intro h hu
        exact h (hu.map (Subring.inclusion hPB))
    rw [h1, h2, B.valuation_lt_one_iff z, hz]

theorem wcpa_dj_llsm_kprs_kummer_inertia : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L] (ℓ : ℕ), ℓ.Prime → Module.finrank K L = ℓ → ∀ (V : ValuationSubring L) (π : L), π ≠ 0 → V.valuation π < 1 → π ^ ℓ ∈ Set.range (algebraMap K L) → (∀ a : K, a ≠ 0 → ∃ k : ℤ, V.valuation (algebraMap K L a) = V.valuation π ^ ((ℓ : ℤ) * k)) → ∃ g : L ≃ₐ[K] L, g ≠ 1 ∧ ∀ x : L, x ∈ V → V.valuation (g x - x) < 1 :=
by
  intro K L _ _ _ _ _ ℓ hℓ hdeg V π hπ0 hπ1 hπK hvals
  classical
  have hδ0 : V.valuation π ≠ 0 := (Valuation.ne_zero_iff _).mpr hπ0
  have hδ1 : V.valuation π ≠ 1 := ne_of_lt hπ1
  have hδpos : 0 < V.valuation π := zero_lt_iff.mpr hδ0

  have hexp : ∀ (k m : ℤ) (i j : ℕ), i < ℓ → j < ℓ →
      (ℓ : ℤ) * k + (i : ℤ) = (ℓ : ℤ) * m + (j : ℤ) → i = j := by
    intro k m i j hi hj h
    have hi' : (i : ℤ) < ℓ := by exact_mod_cast hi
    have hj' : (j : ℤ) < ℓ := by exact_mod_cast hj
    have hi0 : (0 : ℤ) ≤ i := Int.natCast_nonneg i
    have hj0 : (0 : ℤ) ≤ j := Int.natCast_nonneg j
    have e : (ℓ : ℤ) * (k - m) = (j : ℤ) - i := by linarith
    have hkm : k - m = 0 := by
      rcases lt_trichotomy (k - m) 0 with h' | h' | h'
      · have h'' : k - m ≤ -1 := by omega
        have : (ℓ : ℤ) * (k - m) ≤ (ℓ : ℤ) * (-1) :=
          mul_le_mul_of_nonneg_left h'' (Int.natCast_nonneg ℓ)
        linarith
      · exact h'
      · have h'' : 1 ≤ k - m := by omega
        have : (ℓ : ℤ) * 1 ≤ (ℓ : ℤ) * (k - m) :=
          mul_le_mul_of_nonneg_left h'' (Int.natCast_nonneg ℓ)
        linarith
    rw [hkm, mul_zero] at e
    omega

  have hval : ∀ (c : K) (i : ℕ), c ≠ 0 → ∃ k : ℤ,
      V.valuation (algebraMap K L c * π ^ i) = V.valuation π ^ ((ℓ : ℤ) * k + (i : ℤ)) := by
    intro c i hc
    obtain ⟨k, hk⟩ := hvals c hc
    refine ⟨k, ?_⟩
    rw [map_mul, map_pow, hk, zpow_add₀ hδ0, zpow_natCast]
  have hinj : ∀ a b : ℤ, V.valuation π ^ a = V.valuation π ^ b → a = b :=
    fun a b h => zpow_right_injective₀ hδpos hδ1 h
  have hsep : ∀ (c d : K) (i j : ℕ), c ≠ 0 → d ≠ 0 → i < ℓ → j < ℓ →
      V.valuation (algebraMap K L c * π ^ i) = V.valuation (algebraMap K L d * π ^ j) → i = j := by
    intro c d i j hc hd hi hj h
    obtain ⟨k, hk⟩ := hval c i hc
    obtain ⟨m, hm⟩ := hval d j hd
    rw [hk, hm] at h
    exact hexp k m i j hi hj (hinj _ _ h)
  have hone : ∀ (c : K) (i : ℕ), c ≠ 0 → i < ℓ →
      V.valuation (algebraMap K L c * π ^ i) = 1 → i = 0 := by
    intro c i hc hi h
    obtain ⟨k, hk⟩ := hval c i hc
    rw [hk, ← zpow_zero (V.valuation π)] at h
    have h2 := hinj _ _ h
    exact hexp k 0 i 0 hi hℓ.pos (by simp only [mul_zero, Nat.cast_zero, add_zero]; exact h2)

  have hkey : ∀ (c : Fin ℓ → K) (i₀ : Fin ℓ), c i₀ ≠ 0 → ∃ j : Fin ℓ, c j ≠ 0 ∧
      V.valuation (∑ i, algebraMap K L (c i) * π ^ (i : ℕ)) =
        V.valuation (algebraMap K L (c j) * π ^ (j : ℕ)) ∧
      ∀ i, c i ≠ 0 → V.valuation (algebraMap K L (c i) * π ^ (i : ℕ)) ≤
        V.valuation (algebraMap K L (c j) * π ^ (j : ℕ)) := by
    intro c i₀ hi₀
    set s := Finset.univ.filter (fun i : Fin ℓ => c i ≠ 0) with hs
    have hsum : ∑ i, algebraMap K L (c i) * π ^ (i : ℕ) =
        ∑ i ∈ s, algebraMap K L (c i) * π ^ (i : ℕ) := by
      rw [hs, Finset.sum_filter]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      by_cases h : c i = 0 <;> simp [h]
    have hne : s.Nonempty := ⟨i₀, by simp [hs, hi₀]⟩
    obtain ⟨j, hj, hjmax⟩ := Finset.exists_max_image s
      (fun i => V.valuation (algebraMap K L (c i) * π ^ (i : ℕ))) hne
    have hjc : c j ≠ 0 := by simpa [hs] using hj
    refine ⟨j, hjc, ?_, fun i hi => hjmax i (by simp [hs, hi])⟩
    rw [hsum]
    apply Valuation.map_sum_eq_of_lt _ hj
    intro i hi
    rw [Finset.mem_sdiff, Finset.mem_singleton] at hi
    have hic : c i ≠ 0 := by simpa [hs] using hi.1
    refine lt_of_le_of_ne (hjmax i hi.1) (fun h => hi.2 ?_)
    exact Fin.ext (hsep (c i) (c j) i j hic hjc i.2 j.2 h)

  have hli : LinearIndependent K (fun i : Fin ℓ => π ^ (i : ℕ)) := by
    rw [Fintype.linearIndependent_iff]
    intro c hc i₀
    by_contra hi₀
    obtain ⟨j, hj, hv, _⟩ := hkey c i₀ hi₀
    have h0 : ∑ i, algebraMap K L (c i) * π ^ (i : ℕ) = 0 := by
      simpa [Algebra.smul_def] using hc
    rw [h0, map_zero] at hv
    have hne : algebraMap K L (c j) * π ^ (j : ℕ) ≠ 0 :=
      mul_ne_zero ((map_ne_zero _).mpr hj) (pow_ne_zero _ hπ0)
    exact hne ((Valuation.zero_iff _).mp hv.symm)
  have hcard : Fintype.card (Fin ℓ) = Module.finrank K L := by simp [hdeg]
  haveI : Nonempty (Fin ℓ) := ⟨⟨0, hℓ.pos⟩⟩
  let B := basisOfLinearIndependentOfCardEqFinrank hli hcard
  have hB : ∀ i, B i = π ^ (i : ℕ) := fun i => by
    simp [B, coe_basisOfLinearIndependentOfCardEqFinrank]

  have hcardG : Nat.card (L ≃ₐ[K] L) = ℓ := by rw [IsGalois.card_aut_eq_finrank, hdeg]
  haveI : Nontrivial (L ≃ₐ[K] L) := by
    rw [← Finite.one_lt_card_iff_nontrivial, hcardG]; exact hℓ.one_lt
  obtain ⟨g, hg⟩ := exists_ne (1 : L ≃ₐ[K] L)
  obtain ⟨a₀, ha₀⟩ := hπK
  have hgπ : V.valuation (g π) = V.valuation π := by
    have h1 : (g π) ^ ℓ = π ^ ℓ := by rw [← map_pow, ← ha₀, AlgEquiv.commutes]
    have h2 : V.valuation (g π) ^ ℓ = V.valuation π ^ ℓ := by rw [← map_pow, h1, map_pow]
    exact (pow_left_inj₀ zero_le' zero_le' hℓ.ne_zero).mp h2
  refine ⟨g, hg, fun x hx => ?_⟩
  set c := B.repr x with hc
  have hx_eq : x = ∑ i, algebraMap K L (c i) * π ^ (i : ℕ) := by
    conv_lhs => rw [← B.sum_repr x]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hB, Algebra.smul_def]
  have hgx : g x - x = ∑ i, algebraMap K L (c i) * ((g π) ^ (i : ℕ) - π ^ (i : ℕ)) := by
    conv_lhs => rw [hx_eq]
    rw [map_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_mul, AlgEquiv.commutes, map_pow, mul_sub]
  have hx1 : V.valuation x ≤ 1 := (V.valuation_le_one_iff x).mpr hx
  have hle : ∀ i, c i ≠ 0 → V.valuation (algebraMap K L (c i) * π ^ (i : ℕ)) ≤ 1 := by
    intro i hi
    obtain ⟨j, _, hvj, hmax⟩ := hkey c i hi
    rw [← hx_eq] at hvj
    exact (hmax i hi).trans (hvj.symm.le.trans hx1)
  rw [hgx]
  apply Valuation.map_sum_lt _ one_ne_zero
  intro i _
  by_cases hci : c i = 0
  · simp [hci]
  by_cases hi0 : (i : ℕ) = 0
  · simp [hi0]
  have hlt : V.valuation (algebraMap K L (c i) * π ^ (i : ℕ)) < 1 :=
    lt_of_le_of_ne (hle i hci) (fun h => hi0 (hone (c i) i hci i.2 h))
  have hdiff : V.valuation ((g π) ^ (i : ℕ) - π ^ (i : ℕ)) ≤ V.valuation π ^ (i : ℕ) := by
    refine le_trans (Valuation.map_sub _ _ _) ?_
    rw [map_pow, map_pow, hgπ, max_self]
  calc V.valuation (algebraMap K L (c i) * ((g π) ^ (i : ℕ) - π ^ (i : ℕ)))
      = V.valuation (algebraMap K L (c i)) * V.valuation ((g π) ^ (i : ℕ) - π ^ (i : ℕ)) :=
        map_mul _ _ _
    _ ≤ V.valuation (algebraMap K L (c i)) * V.valuation π ^ (i : ℕ) :=
        by gcongr
    _ = V.valuation (algebraMap K L (c i) * π ^ (i : ℕ)) := by rw [map_mul, map_pow]
    _ < 1 := hlt

theorem wcpa_dj_llsm_kpd_ramified_section : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
      [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ (θ : L) (f s h : A) (c : ↥W) (n : ℕ), θ ^ ℓ = algebraMap A L f →
      c ∈ IsLocalRing.maximalIdeal ↥W → ¬ ℓ ∣ n →
      s * f = (t - algebraMap ↥W A c) ^ n * h →
      (∀ q : Ideal A, q.IsPrime → q ≤ 𝔭 → (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ q) →
        t - algebraMap ↥W A c ∈ q → h ∉ q ∧ s ∉ q) →
      ∃ Q, wcLlsGenPt W A L 𝔭 Q ∧
        t - algebraMap ↥W A c ∈ Q.comap (algebraMap A ↥(integralClosure A L)) ∧
        wcLlsRam A K L Q :=
by
  intro Ω _ _ W _ _ ℓ hℓ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD hfin θ f s h c n hθ hc hn hsf hside
  classical
  obtain ⟨q, hq, hq𝔭, hqW, hτq, hτ0⟩ := wcpa_dj_llsm_kprs_generic_prime Ω W A 𝔭 t c hPD hc
  obtain ⟨hhq, hsq⟩ := hside q hq hq𝔭 hqW hτq
  have hinjL : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)
  have hcoe : ∀ z : A, ((algebraMap A ↥(integralClosure A L) z : ↥(integralClosure A L)) : L) =
      algebraMap A L z := fun z => rfl
  haveI := hq
  obtain ⟨Q, hQ, hQq⟩ :=
    Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain (S := ↥(integralClosure A L)) q (by
      intro x hx
      rw [RingHom.mem_ker] at hx
      have h1 : algebraMap A L x = 0 := by rw [← hcoe, hx]; rfl
      rw [(map_eq_zero_iff _ hinjL).mp h1]
      exact q.zero_mem)
  obtain ⟨V, hVint, hVQ⟩ := wcpa_dj_llsm_kprs_dominating_valuation A L Q hQ
  have hmemq : ∀ z : A, z ∈ q ↔ algebraMap A ↥(integralClosure A L) z ∈ Q := by
    intro z
    rw [← hQq, Ideal.mem_comap]
  have hAle : ∀ z : A, V.valuation (algebraMap A L z) ≤ 1 := by
    intro z
    rw [← hcoe]
    exact (V.valuation_le_one_iff _).mpr (hVint _)
  have hAlt : ∀ z : A, V.valuation (algebraMap A L z) < 1 ↔ z ∈ q := by
    intro z
    rw [hmemq, hVQ, hcoe]
  have hAone : ∀ z : A, z ∉ q → V.valuation (algebraMap A L z) = 1 := by
    intro z hz
    exact le_antisymm (hAle z) (not_lt.mp (fun h' => hz ((hAlt z).mp h')))
  set τ := t - algebraMap ↥W A c with hτdef
  set γ := V.valuation (algebraMap A L τ) with hγdef
  have hγ0 : γ ≠ 0 := (Valuation.ne_zero_iff _).mpr ((map_ne_zero_iff _ hinjL).mpr hτ0)
  have hγ1 : γ < 1 := (hAlt τ).mpr hτq
  have hvA : ∀ x : A, x ≠ 0 → ∃ k : ℕ, V.valuation (algebraMap A L x) = γ ^ k := by
    intro x hx
    obtain ⟨k, u, b, hu, hb, hub⟩ :=
      wcpa_dj_llsm_kprs_local_factor Ω W A 𝔭 t c q hPD hq hq𝔭 hqW hτq hτ0 x hx
    refine ⟨k, ?_⟩
    have e := congrArg (fun z => V.valuation (algebraMap A L z)) hub
    simp only [map_mul, map_pow, hAone u hu, hAone b hb, one_mul] at e
    exact e
  have hvK : ∀ a : K, a ≠ 0 → ∃ k : ℤ, V.valuation (algebraMap K L a) = γ ^ k := by
    intro a ha
    obtain ⟨x, y, hy, rfl⟩ := IsFractionRing.div_surjective (A := A) a
    have hy0 : y ≠ 0 := nonZeroDivisors.ne_zero hy
    have hx0 : x ≠ 0 := by
      rintro rfl
      apply ha
      rw [map_zero, zero_div]
    obtain ⟨k₁, hk₁⟩ := hvA x hx0
    obtain ⟨k₂, hk₂⟩ := hvA y hy0
    refine ⟨(k₁ : ℤ) - k₂, ?_⟩
    rw [map_div₀, ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply, map_div₀,
      hk₁, hk₂, zpow_sub₀ hγ0, zpow_natCast, zpow_natCast]
  have hh0 : h ≠ 0 := fun h0 => hhq (h0 ▸ q.zero_mem)
  have hs0 : s ≠ 0 := fun h0 => hsq (h0 ▸ q.zero_mem)
  have hf0 : f ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hsf
    exact mul_ne_zero (pow_ne_zero _ hτ0) hh0 hsf.symm
  have hvf : V.valuation (algebraMap A L f) = γ ^ n := by
    have e := congrArg (fun z => V.valuation (algebraMap A L z)) hsf
    simp only [map_mul, map_pow, hAone s hsq, hAone h hhq, one_mul, mul_one] at e
    exact e
  have hθ0 : θ ≠ 0 := by
    rintro rfl
    rw [zero_pow hℓ.ne_zero, eq_comm, map_eq_zero_iff _ hinjL] at hθ
    exact hf0 hθ
  have hvθ : V.valuation θ ^ ℓ = γ ^ n := by
    rw [← map_pow, hθ, hvf]

  have hcop : Nat.Coprime ℓ n := (Nat.Prime.coprime_iff_not_dvd hℓ).mpr hn
  set β : ℤ := Nat.gcdA ℓ n with hβ
  set α : ℤ := Nat.gcdB ℓ n with hα
  have hbez : (ℓ : ℤ) * β + (n : ℤ) * α = 1 := by
    have := Nat.gcd_eq_gcd_ab ℓ n
    rw [hcop] at this
    rw [hβ, hα]
    exact_mod_cast this.symm
  set π : L := θ ^ α * (algebraMap A L τ) ^ β with hπ
  have hτL0 : algebraMap A L τ ≠ 0 := (map_ne_zero_iff _ hinjL).mpr hτ0
  have hπ0 : π ≠ 0 := mul_ne_zero (zpow_ne_zero _ hθ0) (zpow_ne_zero _ hτL0)
  have hvπ : V.valuation π ^ ℓ = γ := by
    rw [hπ, map_mul, map_zpow₀, map_zpow₀, ← hγdef, mul_pow, ← zpow_natCast, ← zpow_natCast,
      ← zpow_mul, ← zpow_mul, mul_comm α, mul_comm β, zpow_mul, zpow_natCast, hvθ, ← zpow_natCast,
      ← zpow_mul, ← zpow_add₀ hγ0, add_comm, hbez, zpow_one]
  have hπ1 : V.valuation π < 1 := by
    by_contra hcon
    push_neg at hcon
    have := one_le_pow₀ (n := ℓ) hcon
    rw [hvπ] at this
    exact absurd hγ1 (not_lt.mpr this)
  have hπK : π ^ ℓ ∈ Set.range (algebraMap K L) := by
    refine ⟨(algebraMap A K f) ^ α * ((algebraMap A K τ) ^ ℓ) ^ β, ?_⟩
    rw [map_mul, map_zpow₀, map_zpow₀, map_pow, ← IsScalarTower.algebraMap_apply,
      ← IsScalarTower.algebraMap_apply, ← hθ, hπ, mul_pow, ← zpow_natCast, ← zpow_natCast,
      ← zpow_natCast, ← zpow_natCast, ← zpow_mul, ← zpow_mul, ← zpow_mul, ← zpow_mul, mul_comm α,
      mul_comm β]
  have hvals : ∀ a : K, a ≠ 0 → ∃ k : ℤ,
      V.valuation (algebraMap K L a) = V.valuation π ^ ((ℓ : ℤ) * k) := by
    intro a ha
    obtain ⟨k, hk⟩ := hvK a ha
    refine ⟨k, ?_⟩
    rw [hk, zpow_mul, zpow_natCast, hvπ]
  obtain ⟨g, hg1, hgV⟩ :=
    wcpa_dj_llsm_kprs_kummer_inertia K L ℓ hℓ hfin V π hπ0 hπ1 hπK hvals
  have hQq' : Q.comap (algebraMap A ↥(integralClosure A L)) = q := hQq
  refine ⟨Q, ⟨hQ, hQq' ▸ hq𝔭, hQq' ▸ hqW⟩, hQq' ▸ hτq, g, hg1, fun x => ?_⟩
  have hxint : IsIntegral A (x : L) := x.2
  have hgint : IsIntegral A (g (x : L)) :=
    hxint.map ((g : L →ₐ[K] L).restrictScalars A)
  refine ⟨⟨g (x : L) - (x : L), hgint.sub hxint⟩, ?_, rfl⟩
  rw [hVQ]
  exact hgV _ (hVint x)

theorem wcpa_dj_llsm_kpde_radical : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) [𝔭.IsPrime] (t : A)
    (c : ↥W), wcLlsPD W A 𝔭 (.disc t) →
    algebraMap A (Localization.AtPrime 𝔭) (t - algebraMap ↥W A c) ≠ 0 ∧
    ∀ (x : Localization.AtPrime 𝔭) (N : ℕ),
      x ^ N ∈ Ideal.span {algebraMap A (Localization.AtPrime 𝔭) (t - algebraMap ↥W A c)} →
      x ∈ Ideal.span {algebraMap A (Localization.AtPrime 𝔭) (t - algebraMap ↥W A c)} :=
by
  intro Ω _ W A _ _ _ 𝔭 _ t c hPD
  obtain ⟨-, -, -, -, -, -, -, h, hh𝔭, f₀, hC, hX, hét⟩ := hPD
  set T₀ := t - algebraMap ↥W A c with hT₀
  have hp : Prime (Polynomial.X - Polynomial.C c) := Polynomial.prime_X_sub_C c
  have hf₀p : f₀ (Polynomial.X - Polynomial.C c) = algebraMap A (Localization.Away h) T₀ := by
    rw [map_sub, hX, map_sub]
    congr 1
    exact RingHom.congr_fun hC c
  obtain ⟨hnzd, hrad⟩ := wc_cgtnr_etale_prime_pullback_nzd_radical (Polynomial ↥W)
    (Localization.Away h) f₀ wc_cgtnr_etale_over_domain_reduced hét _ hp
  rw [hf₀p] at hnzd hrad
  have hU : ∀ a : A, a ∉ 𝔭 → IsUnit (algebraMap A (Localization.AtPrime 𝔭) a) := fun a ha =>
    (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime 𝔭) 𝔭 a).mpr ha
  have hhu : IsUnit (algebraMap A (Localization.AtPrime 𝔭) h) := hU h hh𝔭
  let j : Localization.Away h →+* Localization.AtPrime 𝔭 :=
    IsLocalization.Away.lift (S := Localization.Away h) h hhu
  have hj : ∀ a : A, j (algebraMap A (Localization.Away h) a) =
      algebraMap A (Localization.AtPrime 𝔭) a := fun a =>
    IsLocalization.Away.lift_eq (S := Localization.Away h) h hhu a
  have hT₀ne : T₀ ≠ 0 := by
    intro h0
    have h1 := hnzd 1 (by rw [h0, map_zero, zero_mul])
    have h2 := congrArg j h1
    rw [map_one, map_zero] at h2
    exact one_ne_zero h2
  have hinj : Function.Injective (algebraMap A (Localization.AtPrime 𝔭)) :=
    IsLocalization.injective (Localization.AtPrime 𝔭) (Ideal.primeCompl_le_nonZeroDivisors 𝔭)
  refine ⟨fun h0 => hT₀ne (hinj (h0.trans (map_zero _).symm)), ?_⟩
  have key : ∀ (b : A) (M : ℕ), algebraMap A (Localization.AtPrime 𝔭) (b ^ (M + 1)) ∈
      Ideal.span {algebraMap A (Localization.AtPrime 𝔭) T₀} →
      algebraMap A (Localization.AtPrime 𝔭) b ∈
        Ideal.span {algebraMap A (Localization.AtPrime 𝔭) T₀} := by
    intro b M hb
    obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp hb
    obtain ⟨⟨d, v⟩, hdv⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl y
    have hspec : algebraMap A (Localization.AtPrime 𝔭) d =
        algebraMap A (Localization.AtPrime 𝔭) (v : A) * y := by
      rw [← hdv]; exact (IsLocalization.mk'_spec' (Localization.AtPrime 𝔭) d v).symm
    have h1 : algebraMap A (Localization.AtPrime 𝔭) (d * T₀) =
        algebraMap A (Localization.AtPrime 𝔭) ((v : A) * b ^ (M + 1)) := by
      rw [map_mul, map_mul, hspec, ← hy]; ring
    obtain ⟨w, hw⟩ := (IsLocalization.eq_iff_exists 𝔭.primeCompl (Localization.AtPrime 𝔭)).mp h1
    have hz : ((w : A) * v * b) ^ (M + 1) = ((w : A) * v) ^ M * ((w : A) * d) * T₀ := by
      linear_combination ((w : A) * v) ^ M * hw.symm
    have hzmem : (algebraMap A (Localization.Away h) ((w : A) * v * b)) ^ (M + 1) ∈
        Ideal.span {algebraMap A (Localization.Away h) T₀} := by
      rw [← map_pow, hz, map_mul]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    obtain ⟨e', he'⟩ := Ideal.mem_span_singleton'.mp (hrad _ _ hzmem)
    have h3 := congrArg j he'
    rw [map_mul, hj, hj] at h3
    have h2 : algebraMap A (Localization.AtPrime 𝔭) ((w : A) * v) *
        algebraMap A (Localization.AtPrime 𝔭) b ∈
        Ideal.span {algebraMap A (Localization.AtPrime 𝔭) T₀} :=
      Ideal.mem_span_singleton'.mpr ⟨j e', by rw [h3, ← map_mul]⟩
    have hwv : ((w : A) * v) ∉ 𝔭 := 𝔭.primeCompl.mul_mem w.2 v.2
    exact (Ideal.unit_mul_mem_iff_mem _ (hU _ hwv)).mp h2
  intro x N hx
  rcases N with _ | M
  · rw [pow_zero] at hx
    rw [Ideal.eq_top_of_isUnit_mem _ hx isUnit_one]
    exact Submodule.mem_top
  · obtain ⟨⟨b, u⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl x
    have hspec : IsLocalization.mk' (Localization.AtPrime 𝔭) b u *
        algebraMap A (Localization.AtPrime 𝔭) (u : A) = algebraMap A (Localization.AtPrime 𝔭) b :=
      IsLocalization.mk'_spec (Localization.AtPrime 𝔭) b u
    have hb : algebraMap A (Localization.AtPrime 𝔭) (b ^ (M + 1)) ∈
        Ideal.span {algebraMap A (Localization.AtPrime 𝔭) T₀} := by
      rw [map_pow, ← hspec, mul_pow]
      exact Ideal.mul_mem_right _ _ hx
    have h4 := key b M hb
    rw [← hspec] at h4
    exact (Ideal.mul_unit_mem_iff_mem _ (hU _ u.2)).mp h4

theorem wcpa_dj_llsm_kpde_kummer_closure : ∀ (S K L : Type u) [CommRing S] [IsDomain S]
    [IsIntegrallyClosed S] [Field K] [Algebra S K] [IsFractionRing S K] [Field L] [Algebra K L]
    [Algebra S L] [IsScalarTower S K L] [FiniteDimensional K L] [IsGalois K L] (ℓ : ℕ),
    ℓ.Prime → Module.finrank K L = ℓ → IsUnit ((ℓ : ℕ) : S) →
    ∀ ζ : S, IsPrimitiveRoot (algebraMap S K ζ) ℓ → ∀ (g : S) (θ : L), g ≠ 0 →
    (∀ (x : S) (N : ℕ), x ^ N ∈ Ideal.span {g} → x ∈ Ideal.span {g}) →
    θ ∉ Set.range (algebraMap K L) → θ ^ ℓ = algebraMap S L g →
    (∀ s : Fin ℓ → S, ∑ i : Fin ℓ, algebraMap S L (s i) * θ ^ (i : ℕ) = 0 → ∀ i, s i = 0) ∧
    ∀ x : L, IsIntegral S x → ∃ s : Fin ℓ → S, x = ∑ i : Fin ℓ, algebraMap S L (s i) * θ ^ (i : ℕ) :=
by
  intro S K L _ _ _ _ _ _ _ _ _ _ _ _ ℓ hℓ hfr hunit ζ hζ g θ hg hrad hθK hθ
  classical
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero
  haveI : Nonempty (Fin ℓ) := ⟨⟨0, hℓ.pos⟩⟩

  have hbasis : ∀ (c : K) (φ : L), φ ∉ Set.range (algebraMap K L) → φ ^ ℓ = algebraMap K L c →
      minpoly K φ = Polynomial.X ^ ℓ - Polynomial.C c ∧
      LinearIndependent K (fun i : Fin ℓ => φ ^ (i : ℕ)) ∧
      ∀ x : L, ∃ k : Fin ℓ → K, x = ∑ i : Fin ℓ, algebraMap K L (k i) * φ ^ (i : ℕ) := by
    intro c φ hφ hpow
    have hint : IsIntegral K φ := IsIntegral.of_finite K φ
    have hdvd : (minpoly K φ).natDegree ∣ ℓ := hfr ▸ minpoly.degree_dvd hint
    have hd1 : (minpoly K φ).natDegree ≠ 1 := by
      intro h
      exact hφ (RingHom.mem_range.mp (minpoly.natDegree_eq_one_iff.mp h))
    have hd : (minpoly K φ).natDegree = ℓ := (hℓ.eq_one_or_self_of_dvd _ hdvd).resolve_left hd1
    have hmp : minpoly K φ = Polynomial.X ^ ℓ - Polynomial.C c := by
      have hmon : (Polynomial.X ^ ℓ - Polynomial.C c : Polynomial K).Monic :=
        Polynomial.monic_X_pow_sub_C c hℓ0
      have hroot : Polynomial.aeval φ (Polynomial.X ^ ℓ - Polynomial.C c) = 0 := by
        simp [hpow]
      have hdv := minpoly.dvd K φ hroot
      refine (Polynomial.eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hint) hmon hdv ?_).symm
      rw [Polynomial.natDegree_X_pow_sub_C, hd]
    have hli : LinearIndependent K (fun i : Fin ℓ => φ ^ (i : ℕ)) :=
      (linearIndependent_pow φ).comp (Fin.cast hd.symm) (Fin.cast_injective _)
    have hspan := hli.span_eq_top_of_card_eq_finrank (by simp [hfr])
    refine ⟨hmp, hli, fun x => ?_⟩
    have hx : x ∈ Submodule.span K (Set.range fun i : Fin ℓ => φ ^ (i : ℕ)) :=
      hspan ▸ Submodule.mem_top
    obtain ⟨k, hk⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp hx
    exact ⟨k, by rw [← hk]; simp [Algebra.smul_def]⟩

  have hθ' : θ ^ ℓ = algebraMap K L (algebraMap S K g) := by
    rw [hθ, IsScalarTower.algebraMap_apply S K L]
  obtain ⟨hmp1, hli, hrep⟩ := hbasis _ θ hθK hθ'
  have hιinj : Function.Injective (algebraMap S K) := IsFractionRing.injective S K

  refine ⟨fun s hs i => ?_, fun x hx => ?_⟩
  · have h2 : ∑ i : Fin ℓ, algebraMap S K (s i) • θ ^ (i : ℕ) = 0 := by
      simp only [IsScalarTower.algebraMap_apply S K L] at hs
      simpa [Algebra.smul_def] using hs
    have h3 := Fintype.linearIndependent_iff.mp hli (fun i => algebraMap S K (s i)) h2 i
    exact (injective_iff_map_eq_zero _).mp hιinj _ h3

  set η : L := algebraMap K L (algebraMap S K ζ) with hη
  have hηp : IsPrimitiveRoot η ℓ := hζ.map_of_injective (algebraMap K L).injective
  have hη0 : η ≠ 0 := hηp.ne_zero hℓ0
  have hηθpow : (η * θ) ^ ℓ = algebraMap K L (algebraMap S K g) := by
    rw [mul_pow, hηp.pow_eq_one, one_mul, hθ']
  have hηθK : η * θ ∉ Set.range (algebraMap K L) := by
    rintro ⟨k, hk⟩
    apply hθK
    refine ⟨(algebraMap S K ζ)⁻¹ * k, ?_⟩
    rw [map_mul, hk, map_inv₀, ← hη, ← mul_assoc, inv_mul_cancel₀ hη0, one_mul]
  obtain ⟨hmp2, -, -⟩ := hbasis _ (η * θ) hηθK hηθpow
  have horb : η * θ ∈ MulAction.orbit (L ≃ₐ[K] L) θ :=
    (Normal.minpoly_eq_iff_mem_orbit L).mp (hmp2.trans hmp1.symm)
  obtain ⟨σ, hσ⟩ := horb
  have hσ' : σ θ = η * θ := by rw [← AlgEquiv.smul_def]; exact hσ
  have hση : ∀ j : ℕ, (σ ^ j) η = η := fun j => AlgEquiv.commutes (σ ^ j) _
  have hσpow : ∀ j : ℕ, (σ ^ j) θ = η ^ j * θ := by
    intro j
    induction j with
    | zero => simp
    | succ j ih =>
      rw [pow_succ, AlgEquiv.mul_apply, hσ', map_mul, ih, hση, pow_succ]
      ring
  obtain ⟨k, hk⟩ := hrep x
  set z : Fin ℓ → L := fun m => algebraMap K L (k m) * θ ^ (m : ℕ) with hz
  have hσz : ∀ (j : ℕ) (m : Fin ℓ), (σ ^ j) (z m) = η ^ (j * (m : ℕ)) * z m := by
    intro j m
    simp only [hz]
    rw [map_mul, AlgEquiv.commutes, map_pow, hσpow, mul_pow, ← pow_mul]
    ring
  have hσx : ∀ j : ℕ, (σ ^ j) x = ∑ m : Fin ℓ, η ^ (j * (m : ℕ)) * z m := by
    intro j
    rw [hk, map_sum]
    exact Finset.sum_congr rfl (fun m _ => hσz j m)
  have hσxint : ∀ j : ℕ, IsIntegral S ((σ ^ j) x) := fun j =>
    hx.map ((σ ^ j).restrictScalars S)

  have hG : ∀ n : ℕ, ∑ j ∈ Finset.range ℓ, (η ^ n) ^ j = if ℓ ∣ n then (ℓ : L) else 0 := by
    intro n
    split_ifs with h
    · rw [(hηp.pow_eq_one_iff_dvd n).mpr h]
      simp
    · have hne : η ^ n ≠ 1 := fun h1 => h ((hηp.pow_eq_one_iff_dvd n).mp h1)
      rw [geom_sum_eq hne, ← pow_mul, mul_comm, pow_mul, hηp.pow_eq_one, one_pow, sub_self,
        zero_div]
  have hkey : ∀ i m : ℕ, i < ℓ → m < ℓ → (ℓ ∣ (ℓ - 1) * i + m ↔ m = i) := by
    intro i m hi hm
    constructor
    · intro h
      have h2 : (ℓ : ℤ) ∣ ((m : ℤ) - i) := by
        have e : (((ℓ - 1) * i + m : ℕ) : ℤ) = ℓ * i + ((m : ℤ) - i) := by
          push_cast [Nat.cast_sub hℓ.one_le]
          ring
        have h' := Int.natCast_dvd_natCast.mpr h
        rw [e] at h'
        exact (dvd_add_right (dvd_mul_right _ _)).mp h'
      have h3 := Int.eq_zero_of_abs_lt_dvd h2 (by rw [abs_lt]; constructor <;> omega)
      omega
    · rintro rfl
      refine ⟨m, ?_⟩
      zify [hℓ.one_le]
      ring

  have hzint : ∀ i : Fin ℓ, IsIntegral S (z i) := by
    intro i
    set y : L := ∑ j ∈ Finset.range ℓ, algebraMap S L (ζ ^ ((ℓ - 1) * (i : ℕ) * j)) * (σ ^ j) x
      with hy
    have hyint : IsIntegral S y :=
      IsIntegral.sum _ (fun j _ => isIntegral_algebraMap.mul (hσxint j))
    have e1 : ∀ j : ℕ, algebraMap S L (ζ ^ ((ℓ - 1) * (i : ℕ) * j)) * (σ ^ j) x =
        ∑ m : Fin ℓ, (η ^ ((ℓ - 1) * (i : ℕ) + m)) ^ j * z m := by
      intro j
      rw [hσx, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun m _ => ?_)
      have e2 : η ^ ((ℓ - 1) * (i : ℕ) * j) * η ^ (j * (m : ℕ)) =
          (η ^ ((ℓ - 1) * (i : ℕ) + m)) ^ j := by
        rw [← pow_mul, ← pow_add]
        congr 1
        ring
      rw [map_pow, IsScalarTower.algebraMap_apply S K L ζ, ← hη, ← mul_assoc, e2]
    have hyv : y = (ℓ : L) * z i := by
      rw [hy, Finset.sum_congr rfl (fun j _ => e1 j), Finset.sum_comm]
      simp_rw [← Finset.sum_mul]
      rw [Finset.sum_eq_single i]
      · rw [hG, if_pos ((hkey i i i.2 i.2).mpr rfl)]
      · intro m _ hmi
        rw [hG, if_neg, zero_mul]
        intro h
        exact hmi (Fin.ext ((hkey i m i.2 m.2).mp h))
      · intro h
        exact absurd (Finset.mem_univ i) h
    obtain ⟨μ, hμ⟩ := hunit.exists_left_inv
    have hzi : z i = algebraMap S L μ * y := by
      rw [hyv, ← mul_assoc, ← map_natCast (algebraMap S L) ℓ, ← map_mul, hμ, map_one, one_mul]
    rw [hzi]
    exact isIntegral_algebraMap.mul hyint

  have hdesc : ∀ i : Fin ℓ, ∃ r : S, algebraMap S K r = k i := by
    intro i
    have hzpow : z i ^ ℓ = algebraMap K L (k i ^ ℓ * algebraMap S K g ^ (i : ℕ)) := by
      simp only [hz]
      rw [mul_pow, ← pow_mul, mul_comm (i : ℕ) ℓ, pow_mul, hθ', map_mul, map_pow, map_pow]
    have h1 : IsIntegral S (algebraMap K L (k i ^ ℓ * algebraMap S K g ^ (i : ℕ))) := by
      rw [← hzpow]
      exact (hzint i).pow ℓ
    have h2 : IsIntegral S (k i ^ ℓ * algebraMap S K g ^ (i : ℕ)) :=
      (isIntegral_algHom_iff (IsScalarTower.toAlgHom S K L) (algebraMap K L).injective).mp h1
    obtain ⟨s, hs⟩ := IsIntegrallyClosed.isIntegral_iff.mp h2
    have hb : (k i * algebraMap S K g) ^ ℓ = algebraMap S K (s * g ^ (ℓ - (i : ℕ))) := by
      rw [mul_pow, map_mul, hs, map_pow, mul_assoc, ← pow_add, Nat.add_sub_of_le i.2.le]
    have hbint : IsIntegral S (k i * algebraMap S K g) :=
      IsIntegral.of_pow hℓ.pos (hb ▸ isIntegral_algebraMap)
    obtain ⟨s', hs'⟩ := IsIntegrallyClosed.isIntegral_iff.mp hbint
    have hs'pow : s' ^ ℓ = s * g ^ (ℓ - (i : ℕ)) := by
      apply hιinj
      rw [map_pow, hs', hb]
    have hmem : s' ^ ℓ ∈ Ideal.span {g} := by
      rw [hs'pow, Ideal.mem_span_singleton]
      exact Dvd.dvd.mul_left (dvd_pow_self g (by have := i.2; omega)) s
    obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp (hrad s' ℓ hmem)
    have hg0K : algebraMap S K g ≠ 0 := (map_ne_zero_iff _ hιinj).mpr hg
    refine ⟨r, mul_right_cancel₀ hg0K ?_⟩
    rw [← map_mul, hr, hs']
  choose r hr using hdesc
  refine ⟨r, ?_⟩
  rw [hk]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [IsScalarTower.algebraMap_apply S K L, hr]

theorem wcpa_dj_llsm_kpde_local_model : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (L : Type u) [Field L] [Algebra A L]
    (𝔭 : Ideal A) [𝔭.IsPrime] [Algebra (Localization.AtPrime 𝔭) L]
    [IsScalarTower A (Localization.AtPrime 𝔭) L] (ℓ : ℕ) (θ : L) (g : A),
    0 < ℓ → Function.Injective (algebraMap A L) →
    (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 → g ∈ 𝔭 →
    θ ^ ℓ = algebraMap A L g →
    (∀ s : Fin ℓ → Localization.AtPrime 𝔭,
      ∑ i : Fin ℓ, algebraMap (Localization.AtPrime 𝔭) L (s i) * θ ^ (i : ℕ) = 0 → ∀ i, s i = 0) →
    (∀ x : L, IsIntegral A x → ∃ s : Fin ℓ → Localization.AtPrime 𝔭,
      x = ∑ i : Fin ℓ, algebraMap (Localization.AtPrime 𝔭) L (s i) * θ ^ (i : ℕ)) →
    ∀ (y : Ideal ↥(integralClosure A L)) [y.IsPrime],
      y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
      Nonempty (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y ≃+*
        AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C (Ideal.Quotient.mk
          (((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
            (algebraMap A (Localization.AtPrime 𝔭))) (algebraMap A (Localization.AtPrime 𝔭) g)))) :=
by
  have t_repr : ∀ (R : Type u) [CommRing R] [Nontrivial R] (ℓ : ℕ) (c : R) (hℓ : 0 < ℓ)
    (t : AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C c)),
      ∃ s : Fin ℓ → R,
      t = ∑ i : Fin ℓ, AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C c) (s i) *
        AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C c) ^ (i : ℕ) := by
    intro R _ _ ℓ c hℓ t
    have hmon : (Polynomial.X ^ ℓ - Polynomial.C c).Monic := Polynomial.monic_X_pow_sub_C c hℓ.ne'
    have hdeg : (Polynomial.X ^ ℓ - Polynomial.C c).natDegree = ℓ := Polynomial.natDegree_X_pow_sub_C
    have hq1 : (Polynomial.X ^ ℓ - Polynomial.C c) ≠ 1 := by
      intro h; rw [h, Polynomial.natDegree_one] at hdeg; omega
    obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective t
    refine ⟨fun i => (p %ₘ (Polynomial.X ^ ℓ - Polynomial.C c)).coeff i, ?_⟩
    have h1 : AdjoinRoot.mk (Polynomial.X ^ ℓ - Polynomial.C c) p =
        AdjoinRoot.mk (Polynomial.X ^ ℓ - Polynomial.C c) (p %ₘ (Polynomial.X ^ ℓ - Polynomial.C c)) := by
      conv_lhs => rw [← Polynomial.modByMonic_add_div p (Polynomial.X ^ ℓ - Polynomial.C c)]
      rw [map_add, map_mul, AdjoinRoot.mk_self, zero_mul, add_zero]
    rw [h1]
    have hlt : (p %ₘ (Polynomial.X ^ ℓ - Polynomial.C c)).natDegree < ℓ := by
      have := Polynomial.natDegree_modByMonic_lt p hmon hq1
      rwa [hdeg] at this
    conv_lhs => rw [Polynomial.as_sum_range' (p %ₘ (Polynomial.X ^ ℓ - Polynomial.C c)) ℓ hlt]
    rw [map_sum, ← Fin.sum_univ_eq_sum_range]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, AdjoinRoot.mk_C, AdjoinRoot.mk_X]
  have t_unit : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (ℓ : ℕ) (c : R) (hℓ : 0 < ℓ)
    (hc : c ∈ IsLocalRing.maximalIdeal R) (s : Fin ℓ → R) (i₀ : Fin ℓ) (hi₀ : (i₀ : ℕ) = 0)
    (hs : IsUnit (s i₀)),
      IsUnit (∑ i : Fin ℓ, AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C c) (s i) *
        AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C c) ^ (i : ℕ)) := by
    intro R _ _ ℓ c hℓ hc s i₀ hi₀ hs
    have hmon : (Polynomial.X ^ ℓ - Polynomial.C c).Monic := Polynomial.monic_X_pow_sub_C c hℓ.ne'
    by_contra hv
    obtain ⟨M, hM, hvM⟩ := Ideal.exists_le_maximal _ (mt Ideal.span_singleton_eq_top.mp hv)
    have : Module.Finite R (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C c)) :=
      (AdjoinRoot.powerBasis' hmon).finite
    have : Algebra.IsIntegral R (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C c)) :=
      Algebra.IsIntegral.of_finite R _
    have hMc : (M.comap (algebraMap R (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C c)))).IsMaximal :=
      Ideal.IsMaximal.under R M
    have hcomap : M.comap (algebraMap R (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C c))) =
        IsLocalRing.maximalIdeal R := IsLocalRing.eq_maximalIdeal hMc
    have hρℓ : AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C c) ^ ℓ =
        AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C c) c := by
      have h0 : AdjoinRoot.mk (Polynomial.X ^ ℓ - Polynomial.C c)
          (Polynomial.X ^ ℓ - Polynomial.C c) = 0 := AdjoinRoot.mk_self
      rw [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h0
      exact h0
    have hof : ∀ r : R, r ∈ IsLocalRing.maximalIdeal R →
        AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C c) r ∈ M := by
      intro r hr
      rw [← hcomap, Ideal.mem_comap, AdjoinRoot.algebraMap_eq] at hr
      exact hr
    have hρM : AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C c) ∈ M := by
      apply hM.isPrime.mem_of_pow_mem ℓ
      rw [hρℓ]
      exact hof c hc
    have hvM' := hvM (Ideal.mem_span_singleton_self _)
    have hrest : ∑ i ∈ Finset.univ.erase i₀, AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C c) (s i) *
        AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C c) ^ (i : ℕ) ∈ M := by
      refine Ideal.sum_mem _ (fun i hi => Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hρM _ ?_))
      apply Nat.pos_of_ne_zero
      intro h
      exact (Finset.ne_of_mem_erase hi) (Fin.ext (h.trans hi₀.symm))
    have hs0 : AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C c) (s i₀) ∈ M := by
      have := M.sub_mem hvM' hrest
      rwa [← Finset.add_sum_erase _ _ (Finset.mem_univ i₀), hi₀, pow_zero, mul_one,
        add_sub_cancel_right] at this
    have hsm : s i₀ ∈ IsLocalRing.maximalIdeal R := by
      rw [← hcomap, Ideal.mem_comap, AdjoinRoot.algebraMap_eq]
      exact hs0
    exact (IsLocalRing.mem_maximalIdeal _).mp hsm hs
  have t_section : ∀ (A : Type u) [CommRing A] (L : Type u) [Field L] [Algebra A L] (T : Type u)
    [CommRing T] (Φ : T →+* L) (hΦ : Function.Injective Φ)
    (hsurj : ∀ x : ↥(integralClosure A L), ∃ t : T, Φ t = (x : L)),
      ∃ ψ : ↥(integralClosure A L) →+* T, ∀ x : ↥(integralClosure A L), Φ (ψ x) = (x : L) := by
    intro A _ L _ _ T _ Φ hΦ hsurj
    let E : T ≃+* Φ.range := RingEquiv.ofBijective Φ.rangeRestrict
      ⟨fun a b h => hΦ (congrArg Subtype.val h), Φ.rangeRestrict_surjective⟩
    let j : ↥(integralClosure A L) →+* Φ.range :=
      ((integralClosure A L).val : ↥(integralClosure A L) →+* L).codRestrict Φ.range
        (fun x => by obtain ⟨t, ht⟩ := hsurj x; exact RingHom.mem_range.mpr ⟨t, ht⟩)
    refine ⟨E.symm.toRingHom.comp j, fun x => ?_⟩
    have h2 := congrArg Subtype.val (E.apply_symm_apply (j x))
    exact h2
  have t_loc : ∀ (A : Type u) [CommRing A] (L : Type u) [Field L] [Algebra A L] (T : Type u)
    [CommRing T] (Φ : T →+* L) (ψ : ↥(integralClosure A L) →+* T)
    (hψ : ∀ x : ↥(integralClosure A L), Φ (ψ x) = (x : L))
    (y : Ideal ↥(integralClosure A L)) [y.IsPrime]
    (hunit : ∀ x : ↥(integralClosure A L), x ∉ y → IsUnit (ψ x))
    (hfrac : ∀ t : T, ∃ x s : ↥(integralClosure A L), s ∉ y ∧ ψ x = ψ s * t),
      ∃ e : Localization.AtPrime y ≃+* T, ∀ x : ↥(integralClosure A L),
      e (algebraMap ↥(integralClosure A L) (Localization.AtPrime y) x) = ψ x := by
    intro A _ L _ _ T _ Φ ψ hψ y _ hunit hfrac
    have hψinj : Function.Injective ψ := fun a b h => Subtype.ext (by rw [← hψ a, ← hψ b, h])
    have hM : ∀ m : y.primeCompl, IsUnit (ψ m) := fun m => hunit m m.2
    have hsurj : Function.Surjective (IsLocalization.lift (M := y.primeCompl)
        (S := Localization.AtPrime y) hM) := by
      intro t
      obtain ⟨x, s, hs, hxs⟩ := hfrac t
      refine ⟨IsLocalization.mk' (Localization.AtPrime y) x (⟨s, hs⟩ : y.primeCompl), ?_⟩
      rw [IsLocalization.lift_mk'_spec]
      exact hxs
    have hinj : Function.Injective (IsLocalization.lift (M := y.primeCompl)
        (S := Localization.AtPrime y) hM) := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨x, m⟩, rfl⟩ := IsLocalization.mk'_surjective y.primeCompl z
      rw [IsLocalization.lift_mk'_spec, mul_zero] at hz
      have : x = 0 := hψinj (by rw [hz, map_zero])
      change IsLocalization.mk' (Localization.AtPrime y) x m = 0
      rw [this, IsLocalization.mk'_zero]
    exact ⟨RingEquiv.ofBijective _ ⟨hinj, hsurj⟩, IsLocalization.lift_eq hM⟩
  intro Ω _ W A _ _ _ L _ _ 𝔭 _ _ _ ℓ θ g hℓ _ _ hg𝔭 hθ hlin hrep y _ hyc
  classical
  have h : Polynomial.eval₂ (algebraMap (Localization.AtPrime 𝔭) L) θ
      (Polynomial.X ^ ℓ - Polynomial.C (algebraMap A (Localization.AtPrime 𝔭) g)) = 0 := by
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C,
      ← IsScalarTower.algebraMap_apply, hθ, sub_self]
  have hΦsum : ∀ s : Fin ℓ → Localization.AtPrime 𝔭,
      AdjoinRoot.lift (algebraMap (Localization.AtPrime 𝔭) L) θ h
        (∑ i : Fin ℓ, AdjoinRoot.of (Polynomial.X ^ ℓ -
          Polynomial.C (algebraMap A (Localization.AtPrime 𝔭) g)) (s i) *
          AdjoinRoot.root (Polynomial.X ^ ℓ -
            Polynomial.C (algebraMap A (Localization.AtPrime 𝔭) g)) ^ (i : ℕ)) =
      ∑ i : Fin ℓ, algebraMap (Localization.AtPrime 𝔭) L (s i) * θ ^ (i : ℕ) := by
    intro s
    rw [map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_mul, map_pow, AdjoinRoot.lift_of, AdjoinRoot.lift_root]
  have hΦinj : Function.Injective (AdjoinRoot.lift (algebraMap (Localization.AtPrime 𝔭) L) θ h) := by
    rw [injective_iff_map_eq_zero]
    intro t ht
    obtain ⟨s, rfl⟩ := t_repr (Localization.AtPrime 𝔭) ℓ
      (algebraMap A (Localization.AtPrime 𝔭) g) hℓ t
    rw [hΦsum] at ht
    have hs0 := hlin s ht
    exact Finset.sum_eq_zero (fun i _ => by rw [hs0 i, map_zero, zero_mul])
  have hθint : IsIntegral A θ := IsIntegral.of_pow hℓ (by rw [hθ]; exact isIntegral_algebraMap)
  have hθpow : (⟨θ, hθint⟩ : ↥(integralClosure A L)) ^ ℓ =
      algebraMap A ↥(integralClosure A L) g := by
    apply Subtype.ext
    rw [SubmonoidClass.coe_pow]
    exact hθ
  have hθy : (⟨θ, hθint⟩ : ↥(integralClosure A L)) ∈ y := by
    apply Ideal.IsPrime.mem_of_pow_mem ‹_› ℓ
    rw [hθpow, ← Ideal.mem_comap, hyc]
    exact hg𝔭
  have hden : ∀ s : Fin ℓ → Localization.AtPrime 𝔭, ∃ b : A, b ∉ 𝔭 ∧ ∃ a : Fin ℓ → A,
      ∀ i, algebraMap A (Localization.AtPrime 𝔭) (a i) =
        algebraMap A (Localization.AtPrime 𝔭) b * s i := by
    intro s
    obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples 𝔭.primeCompl Finset.univ s
    choose a ha using fun i => hb i (Finset.mem_univ i)
    refine ⟨b, b.2, a, fun i => ?_⟩
    rw [ha i, Algebra.smul_def]
  have hxs : ∀ (b : A) (a : Fin ℓ → A) (s : Fin ℓ → Localization.AtPrime 𝔭),
      (∀ i, algebraMap A (Localization.AtPrime 𝔭) (a i) =
        algebraMap A (Localization.AtPrime 𝔭) b * s i) →
      ((∑ i : Fin ℓ, algebraMap A ↥(integralClosure A L) (a i) *
        (⟨θ, hθint⟩ : ↥(integralClosure A L)) ^ (i : ℕ) : ↥(integralClosure A L)) : L) =
        algebraMap A L b * ∑ i : Fin ℓ, algebraMap (Localization.AtPrime 𝔭) L (s i) * θ ^ (i : ℕ) := by
    intro b a s has
    rw [AddSubmonoidClass.coe_finsetSum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [MulMemClass.coe_mul, SubmonoidClass.coe_pow]
    show algebraMap A L (a i) * θ ^ (i : ℕ) = _
    rw [IsScalarTower.algebraMap_apply A (Localization.AtPrime 𝔭) L (a i), has i, map_mul,
      IsScalarTower.algebraMap_apply A (Localization.AtPrime 𝔭) L b, mul_assoc]

  obtain ⟨ψ, hψ⟩ := t_section A L (AdjoinRoot (Polynomial.X ^ ℓ -
      Polynomial.C (algebraMap A (Localization.AtPrime 𝔭) g)))
    (AdjoinRoot.lift (algebraMap (Localization.AtPrime 𝔭) L) θ h) hΦinj (fun x => by
      obtain ⟨s, hs⟩ := hrep x x.2
      exact ⟨_, (hΦsum s).trans hs.symm⟩)
  have hunit : ∀ x : ↥(integralClosure A L), x ∉ y → IsUnit (ψ x) := by
    intro x hx
    obtain ⟨s, hs⟩ := t_repr (Localization.AtPrime 𝔭) ℓ
      (algebraMap A (Localization.AtPrime 𝔭) g) hℓ (ψ x)
    have hxL : (x : L) = ∑ i : Fin ℓ, algebraMap (Localization.AtPrime 𝔭) L (s i) * θ ^ (i : ℕ) := by
      rw [← hψ x, hs, hΦsum]
    have hs0 : IsUnit (s ⟨0, hℓ⟩) := by
      by_contra hnu
      obtain ⟨b, hb, a, ha⟩ := hden s
      have ha0 : a ⟨0, hℓ⟩ ∈ 𝔭 := by
        by_contra h0
        apply hnu
        have h1 : IsUnit (algebraMap A (Localization.AtPrime 𝔭) (a ⟨0, hℓ⟩)) :=
          (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime 𝔭) 𝔭 _).mpr h0
        rw [ha] at h1
        exact isUnit_of_mul_isUnit_right h1
      have hbx : algebraMap A ↥(integralClosure A L) b * x = ∑ i : Fin ℓ,
          algebraMap A ↥(integralClosure A L) (a i) *
            (⟨θ, hθint⟩ : ↥(integralClosure A L)) ^ (i : ℕ) := by
        apply Subtype.ext
        rw [hxs b a s ha, MulMemClass.coe_mul, ← hxL]
        rfl
      have hmem : ∑ i : Fin ℓ, algebraMap A ↥(integralClosure A L) (a i) *
          (⟨θ, hθint⟩ : ↥(integralClosure A L)) ^ (i : ℕ) ∈ y := by
        refine Ideal.sum_mem _ (fun i _ => ?_)
        by_cases hi : (i : ℕ) = 0
        · have hi' : i = ⟨0, hℓ⟩ := Fin.ext hi
          rw [hi']
          refine Ideal.mul_mem_right _ _ ?_
          rw [← Ideal.mem_comap, hyc]
          exact ha0
        · exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hθy _ (Nat.pos_of_ne_zero hi))
      rw [← hbx] at hmem
      rcases Ideal.IsPrime.mem_or_mem ‹_› hmem with h2 | h2
      · rw [← Ideal.mem_comap, hyc] at h2
        exact hb h2
      · exact hx h2
    rw [hs]
    exact t_unit (Localization.AtPrime 𝔭) ℓ (algebraMap A (Localization.AtPrime 𝔭) g) hℓ
      ((IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔭) 𝔭 g).mpr hg𝔭)
      s ⟨0, hℓ⟩ rfl hs0
  have hfrac : ∀ t : AdjoinRoot (Polynomial.X ^ ℓ -
      Polynomial.C (algebraMap A (Localization.AtPrime 𝔭) g)),
      ∃ x s : ↥(integralClosure A L), s ∉ y ∧ ψ x = ψ s * t := by
    intro t
    obtain ⟨s, rfl⟩ := t_repr (Localization.AtPrime 𝔭) ℓ
      (algebraMap A (Localization.AtPrime 𝔭) g) hℓ t
    obtain ⟨b, hb, a, ha⟩ := hden s
    refine ⟨∑ i : Fin ℓ, algebraMap A ↥(integralClosure A L) (a i) *
        (⟨θ, hθint⟩ : ↥(integralClosure A L)) ^ (i : ℕ), algebraMap A ↥(integralClosure A L) b, ?_, ?_⟩
    · intro h2
      rw [← Ideal.mem_comap, hyc] at h2
      exact hb h2
    · apply hΦinj
      rw [hψ, map_mul, hψ, hxs b a s ha, hΦsum]
      rfl
  obtain ⟨e, he⟩ := t_loc A L _ _ ψ hψ y hunit hfrac
  have heΦ : ∀ x : ↥(integralClosure A L), AdjoinRoot.lift (algebraMap (Localization.AtPrime 𝔭) L) θ h
      (e (algebraMap ↥(integralClosure A L) (Localization.AtPrime y) x)) = (x : L) := by
    intro x
    rw [he, hψ]

  have hgen : ∀ (b : ↥(integralClosure A L)) (w : ↥W),
      (b : L) = algebraMap A L (algebraMap ↥W A w) →
      e (algebraMap ↥(integralClosure A L) (Localization.AtPrime y) b) =
        AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C (algebraMap A (Localization.AtPrime 𝔭) g))
          (algebraMap A (Localization.AtPrime 𝔭) (algebraMap ↥W A w)) := by
    intro b w hb
    apply hΦinj
    rw [heΦ b, AdjoinRoot.lift_of, ← IsScalarTower.algebraMap_apply, hb]
  have hkey : Ideal.map (AdjoinRoot.of (Polynomial.X ^ ℓ -
      Polynomial.C (algebraMap A (Localization.AtPrime 𝔭) g)))
      (((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
        (algebraMap A (Localization.AtPrime 𝔭))) =
      Ideal.map (e : Localization.AtPrime y →+* _)
        ((Ideal.span {b : ↥(integralClosure A L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
            (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w}).map
          (algebraMap ↥(integralClosure A L) (Localization.AtPrime y))) := by
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap]
      have hbG : algebraMap A ↥(integralClosure A L) (algebraMap ↥W A w) ∈
          {b : ↥(integralClosure A L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
            (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w} := ⟨w, hw, rfl⟩
      rw [← hgen (algebraMap A ↥(integralClosure A L) (algebraMap ↥W A w)) w rfl]
      exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ (Ideal.subset_span hbG))
    · rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap, Ideal.span_le]
      rintro b ⟨w, hw, hb⟩
      rw [SetLike.mem_coe, Ideal.mem_comap, Ideal.mem_comap]
      show e (algebraMap ↥(integralClosure A L) (Localization.AtPrime y) b) ∈ _
      rw [hgen b w hb]
      exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hw))
  have e1 : wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y ≃+*
      (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C (algebraMap A (Localization.AtPrime 𝔭) g)) ⧸
        Ideal.map (AdjoinRoot.of (Polynomial.X ^ ℓ -
          Polynomial.C (algebraMap A (Localization.AtPrime 𝔭) g)))
          (((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
            (algebraMap A (Localization.AtPrime 𝔭)))) :=
    Ideal.quotientEquiv _ _ e hkey
  have e2 := AdjoinRoot.quotAdjoinRootEquivQuotPolynomialQuot
    (((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
      (algebraMap A (Localization.AtPrime 𝔭)))
    (Polynomial.X ^ ℓ - Polynomial.C (algebraMap A (Localization.AtPrime 𝔭) g))
  have hpoly : Polynomial.map (Ideal.Quotient.mk (((IsLocalRing.maximalIdeal ↥W).map
      (algebraMap ↥W A)).map (algebraMap A (Localization.AtPrime 𝔭))))
      (Polynomial.X ^ ℓ - Polynomial.C (algebraMap A (Localization.AtPrime 𝔭) g)) =
      Polynomial.X ^ ℓ - Polynomial.C (Ideal.Quotient.mk
        (((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
          (algebraMap A (Localization.AtPrime 𝔭))) (algebraMap A (Localization.AtPrime 𝔭) g)) := by
    rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]
  rw [hpoly] at e2
  exact ⟨e1.trans e2⟩

theorem wcpa_dj_llsm_kpd_eisenstein_local : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar (IsLocalRing.ResidueField ↥W) ≠ ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
      [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
      (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ (θ : L) (a : A) (c : ↥W), c ∈ IsLocalRing.maximalIdeal ↥W → a ∉ 𝔭 →
