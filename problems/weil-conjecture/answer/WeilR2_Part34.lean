    obtain ⟨y, hy, v, hv, hyv⟩ := hw
    obtain ⟨x, rfl⟩ := Ideal.mem_span_singleton'.mp hy
    refine ⟨Polynomial.C w, ?_⟩
    rw [Polynomial.eval₂_C]
