  have s4 : ∀ (N D L : Type u) [CommRing N] [IsDomain N] [CommRing D] [IsDomain D] [Field L]
      (g : N →+* D) (j : D →+* L), g.FormallyUnramified → g.EssFiniteType →
      Function.Injective (j.comp g) → Function.Injective j := by
    intro N D L _ _ _ _ _ g j hfu hft hinj
    letI : Algebra N D := g.toAlgebra
    haveI : Algebra.FormallyUnramified N D := hfu
    haveI : Algebra.EssFiniteType N D := hft
    haveI hK : (RingHom.ker j).IsPrime := RingHom.ker_isPrime j
    haveI : Algebra.FormallyUnramified N (Localization.AtPrime (RingHom.ker j)) :=
      Algebra.FormallyUnramified.comp N D (Localization.AtPrime (RingHom.ker j))
    haveI : Algebra.EssFiniteType N (Localization.AtPrime (RingHom.ker j)) :=
      Algebra.EssFiniteType.comp N D (Localization.AtPrime (RingHom.ker j))
    have hunits : ∀ y : nonZeroDivisors N,
        IsUnit (algebraMap N (Localization.AtPrime (RingHom.ker j)) (y : N)) := by
      intro y
      rw [IsScalarTower.algebraMap_apply N D (Localization.AtPrime (RingHom.ker j)),
        IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime (RingHom.ker j))
          (RingHom.ker j),
        Ideal.mem_primeCompl_iff, RingHom.mem_ker]
      intro h0
      have hy : (y : N) ≠ 0 := nonZeroDivisors.coe_ne_zero y
      apply hy
      apply hinj
      rw [RingHom.comp_apply, map_zero]
      exact h0
    letI : Algebra (FractionRing N) (Localization.AtPrime (RingHom.ker j)) :=
      (IsLocalization.lift (M := nonZeroDivisors N) (S := FractionRing N) hunits).toAlgebra
    haveI : IsScalarTower N (FractionRing N) (Localization.AtPrime (RingHom.ker j)) :=
      IsScalarTower.of_algebraMap_eq (fun x => (IsLocalization.lift_eq hunits x).symm)
    haveI : Algebra.FormallyUnramified (FractionRing N) (Localization.AtPrime (RingHom.ker j)) :=
      Algebra.FormallyUnramified.localization_base (nonZeroDivisors N)
    haveI : Algebra.EssFiniteType (FractionRing N) (Localization.AtPrime (RingHom.ker j)) :=
      Algebra.EssFiniteType.of_comp N (FractionRing N) (Localization.AtPrime (RingHom.ker j))
    have hmax := Algebra.FormallyUnramified.map_maximalIdeal (R := FractionRing N)
      (S := Localization.AtPrime (RingHom.ker j))
    rw [IsLocalRing.maximalIdeal_eq_bot, Ideal.map_bot] at hmax
    have hinjD : Function.Injective (algebraMap D (Localization.AtPrime (RingHom.ker j))) :=
      IsLocalization.injective _ (le_nonZeroDivisors_of_noZeroDivisors
        (fun h0 => (Ideal.mem_primeCompl_iff.mp h0) (RingHom.ker j).zero_mem))
    refine (injective_iff_map_eq_zero j).mpr (fun k hk => ?_)
    have h1 : algebraMap D (Localization.AtPrime (RingHom.ker j)) k ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime (RingHom.ker j)) :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff _ (RingHom.ker j) k).mpr
        (RingHom.mem_ker.mpr hk)
    rw [← hmax, Ideal.mem_bot] at h1
    exact hinjD (h1.trans (map_zero _).symm)

  have s2 : ∀ (L : Type u) [Field L] (wL : ↥W →+* L) (ζ : ↥W) (z z' : L), ζ ≠ 0 →
      z * z' = wL ζ → (∀ P : Polynomial ↥W, P ≠ 0 → Polynomial.eval₂ wL z P ≠ 0) →
      ∀ g : wcEbntN W ζ →+* L, g.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = wL →
      g (wcEbntX W ζ 0) = z → Function.Injective g := by
    intro L _ wL ζ z z' hζ hzz htr g hgC hg0
    haveI : IsDomain (wcEbntN W ζ) := (wcNd_nodal_poly_normal Ω W ζ hζ).1
    have hgen : (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ζ :
        MvPolynomial (Fin 2) ↥W) ∈
        Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ζ :
          MvPolynomial (Fin 2) ↥W)} :=
      Ideal.subset_span (Set.mem_singleton _)
    have hnf : ∀ F : MvPolynomial (Fin 2) ↥W, ∃ (k : ℕ) (P : Polynomial ↥W),
        MvPolynomial.X 0 ^ k * F - Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) P ∈
          Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ζ :
            MvPolynomial (Fin 2) ↥W)} := by
      intro F
      induction F using MvPolynomial.induction_on with
      | C a => exact ⟨0, Polynomial.C a, by simp⟩
      | add p q hp hq =>
        obtain ⟨k₁, P₁, h₁⟩ := hp
        obtain ⟨k₂, P₂, h₂⟩ := hq
        refine ⟨k₁ + k₂, Polynomial.X ^ k₂ * P₁ + Polynomial.X ^ k₁ * P₂, ?_⟩
        have e : MvPolynomial.X 0 ^ (k₁ + k₂) * (p + q) -
            Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0)
              (Polynomial.X ^ k₂ * P₁ + Polynomial.X ^ k₁ * P₂) =
            MvPolynomial.X 0 ^ k₂ * (MvPolynomial.X 0 ^ k₁ * p -
              Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) P₁) +
            MvPolynomial.X 0 ^ k₁ * (MvPolynomial.X 0 ^ k₂ * q -
              Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) P₂) := by
          simp only [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X_pow]
          ring
        rw [e]
        exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ h₁) (Ideal.mul_mem_left _ _ h₂)
      | mul_X p n hp =>
        obtain ⟨k, P, hP⟩ := hp
        fin_cases n
        · refine ⟨k, Polynomial.X * P, ?_⟩
          have e : MvPolynomial.X 0 ^ k * (p * MvPolynomial.X 0) -
              Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) (Polynomial.X * P) =
              MvPolynomial.X 0 * (MvPolynomial.X 0 ^ k * p -
                Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) P) := by
            simp only [Polynomial.eval₂_mul, Polynomial.eval₂_X]
            ring
          simp only [Fin.zero_eta, Fin.isValue]
          rw [e]
          exact Ideal.mul_mem_left _ _ hP
        · refine ⟨k + 1, Polynomial.C ζ * P, ?_⟩
          have e : MvPolynomial.X 0 ^ (k + 1) * (p * MvPolynomial.X 1) -
              Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) (Polynomial.C ζ * P) =
              (MvPolynomial.X 0 ^ k * p) *
                (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ζ) +
              MvPolynomial.C ζ * (MvPolynomial.X 0 ^ k * p -
                Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) P) := by
            simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C]
            ring
          simp only [Fin.mk_one, Fin.isValue]
          rw [e]
          exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hgen) (Ideal.mul_mem_left _ _ hP)
    have hz0 : z ≠ 0 := by
      intro hz
      have h := htr (Polynomial.C ζ) (by rwa [Ne, Polynomial.C_eq_zero])
      rw [Polynomial.eval₂_C, ← hzz, hz, zero_mul] at h
      exact h rfl
    have hX0 : wcEbntX W ζ 0 ≠ 0 := by
      intro h
      apply hz0
      rw [← hg0, h, map_zero]
    refine (injective_iff_map_eq_zero g).mpr (fun n hn => ?_)
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective n
    obtain ⟨k, P, hP⟩ := hnf F
    have hq : Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C ζ : MvPolynomial (Fin 2) ↥W)}) (MvPolynomial.X 0 ^ k * F) =
        Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ζ : MvPolynomial (Fin 2) ↥W)})
          (Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) P) :=
      Ideal.Quotient.eq.mpr hP
    have hev : g (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C ζ : MvPolynomial (Fin 2) ↥W)})
        (Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) P)) = Polynomial.eval₂ wL z P := by
      have h1 := Polynomial.hom_eval₂ P MvPolynomial.C
        (g.comp (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ζ : MvPolynomial (Fin 2) ↥W)})))
        (MvPolynomial.X 0)
      rw [RingHom.comp_apply] at h1
      rw [h1]
      have h2 : (g.comp (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ζ : MvPolynomial (Fin 2) ↥W)}))).comp MvPolynomial.C = wL := by
        rw [RingHom.comp_assoc]; exact hgC
      have h3 : (g.comp (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ζ : MvPolynomial (Fin 2) ↥W)}))) (MvPolynomial.X 0) = z := hg0
      rw [h2, h3]
    have hP0 : P = 0 := by
      by_contra hne
      apply htr P hne
      rw [← hev, ← hq, map_mul, map_mul, hn, mul_zero]
    rw [hP0, Polynomial.eval₂_zero, map_zero, map_mul, map_pow] at hq
    exact (mul_eq_zero.mp hq).resolve_left (pow_ne_zero _ hX0)

  have s3 : ∀ (E : Type u) [CommRing E] [Algebra ↥W E] (ζ : ↥W) (Z Z' : E) (𝔓 : Ideal E)
