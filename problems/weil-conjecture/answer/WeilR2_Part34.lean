    · rintro x₁ x₂ h₁ h₂ ⟨q₁, hq₁⟩ ⟨q₂, hq₂⟩
      refine ⟨q₁ * q₂, ?_⟩
      show θ (algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
        ((⟨x₁, h₁⟩ : ↥(wcIcxRI W A K u a' b)) * ⟨x₂, h₂⟩)) = _
      rw [map_mul, map_mul, hq₁, hq₂, map_mul]

  have h1 : ∀ z : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L),
      ∃ q : Polynomial (IsLocalRing.ResidueField ↥W), θ z = Polynomial.toLaurent q := by
    intro z
    obtain ⟨p, hpm, hp⟩ := Algebra.IsIntegral.isIntegral (R := ↥(wcIcxRI W A K u a' b)) z
    have hlift : p.map (θ.comp (algebraMap ↥(wcIcxRI W A K u a' b)
        ↥(integralClosure ↥(wcIcxRI W A K u a' b) L))) ∈
        Polynomial.lifts Polynomial.toLaurent := by
      rw [Polynomial.lifts_iff_coeff_lifts]
