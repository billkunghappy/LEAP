  have hinj : Function.Injective Φ := by
    rw [injective_iff_map_eq_zero]
    intro ξ hξ
    obtain ⟨F, rfl⟩ := AdjoinRoot.mk_surjective ξ
    have hPm : P.Monic := Polynomial.monic_X_pow_sub_C _ hℓpos.ne'
    have hPdeg : P.natDegree = ℓ := Polynomial.natDegree_X_pow_sub_C
    have hP1 : P ≠ 1 := by
