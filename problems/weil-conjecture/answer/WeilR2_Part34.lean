        (by rw [← h𝔎oc]; exact Ideal.comap_mono hKj)
  have hKj0 : (RingHom.ker (θ j)).comap (wcIcxIncl L _ _ (hRo.trans hoC)) = y₀ := by
    apply (hmax j).eq_of_le hy₀.ne_top
    intro x hx
    rw [Ideal.mem_comap, ← hcompo] at hx
    have h1 : wcIcxIncl L _ _ hRo x ∈ Pu := by
      rw [← hKjo]
      exact hx
    rw [← hQoy]
    exact hPuQ h1

  have huniq : ∀ i, (RingHom.ker (θ i)).comap (wcIcxIncl L _ _ (hRo.trans hoC)) = y₀ →
      i = j := by
    intro i hi
    obtain ⟨c, k, hc, hk, hθy, hnu⟩ := wcpa_dj_llsm_isiccc_orientation Ω W hW hWt A K L 𝔭 u v
      g a' b hoC hPD ha'm ha'0 ⟨e, he⟩ hnba hbg (θ i) (hsurj i) (hθC i)
    have hyK : wcIccYC W A K L u a' ∉ RingHom.ker (θ i) := by
      intro h
      rw [RingHom.mem_ker, hθy] at h
      exact hCne c k hc h
    have hδK : ∀ δ : ↥(integralClosure ↥(wcLlsASbS W A K u a') L),
        wcIcxIncl L _ _ hoC δ * wcIccYC W A K L u a' - 1 ∉ RingHom.ker (θ i) := by
      intro δ h
      rw [RingHom.mem_ker, map_sub, map_mul, map_one, sub_eq_zero] at h
      exact hnu δ h
    have hPuK := wcpa_dj_llsm_isiccc_outer_match Ω W hW hWt A K L 𝔭 u v g a' b hRo hoC hPD ha'm
      ha'0 hbm hb0 ⟨e, he⟩ hnba hbg y₀ hy₀ hy₀c Qo Ps Pu hQo hQoy hQoN hPs hPu hPsQ hPuQ hyPs
      huPs huPu hyPu hbO huO (RingHom.ker (θ i)) (hKp i) hi (hcstK i) hyK hδK
    exact (F4 j i (hKj.trans (h𝔎omin _ (hKp i) hPuK))).symm

  obtain ⟨𝔈, h𝔈P, h𝔈c, -⟩ := locP _ _ (wcIcxIncl L _ _ hIC) (hinj _ _ hIC)
    (wcIccXI W A K L u a' b) (IsUnit.of_mul_eq_one (wcIccYC W A K L u a') (by rw [hιx]; exact hxyC))
    (fun d => by
      obtain ⟨-, ⟨m, δ, hδ⟩⟩ := wcpa_dj_llsm_isiccc_chart_clear Ω W hW hWt A K L 𝔭 u v g a' b
        hu0 ha0 d
      exact ⟨m, δ, Subtype.ext (by
        rw [MulMemClass.coe_mul, SubmonoidClass.coe_pow, hιx, hxCv]; exact hδ)⟩)
    E hE.1.1 hxE
  have hI𝔈 : wcIccM W (wcIccWL W A K L) ↥(wcLlsIsiCR W A K u a') ≤ 𝔈 := by
    rw [Ideal.span_le]
    rintro c ⟨w, hw, hc⟩
    rw [show c = wcIcxIncl L _ _ hIC (wcIccCst W A K L (wcIcxRI W A K u a' b) w) from
      Subtype.ext hc, SetLike.mem_coe, ← Ideal.mem_comap, h𝔈c]
    exact hE.1.2 (Ideal.subset_span ⟨w, hw, rfl⟩)
  obtain ⟨j', hKj'⟩ := F3 𝔈 h𝔈P hI𝔈
  have hKj'I : (RingHom.ker (θ j')).comap (wcIcxIncl L _ _ hIC) = E := by
    apply le_antisymm
    · rw [← h𝔈c]
      exact Ideal.comap_mono hKj'
    · exact hE.2 ⟨by haveI := hKp j'; infer_instance, hIcomap _ hIC _ (hIK j')⟩
        (by rw [← h𝔈c]; exact Ideal.comap_mono hKj')
  have hKj'0 : (RingHom.ker (θ j')).comap (wcIcxIncl L _ _ (hRo.trans hoC)) = y₀ := by
    apply (hmax j').eq_of_le hy₀.ne_top
    intro x hx
    rw [Ideal.mem_comap, ← hcompI] at hx
    have h1 : wcIcxIncl L _ _ hRI x ∈ E := by
      rw [← hKj'I]
      exact hx
    rw [← hQIy]
    exact hEQ h1
  have hjj : j' = j := huniq j' hKj'0
  rw [hjj] at hKj'I

  obtain ⟨ψ, c, k, hc, hk, hψW, hψy⟩ : ∃ (ψ : (↥(integralClosure ↥(wcLlsIsiCR W A K u a') L) ⧸
      RingHom.ker (θ j)) ≃+* LaurentPolynomial (IsLocalRing.ResidueField ↥W))
      (c : IsLocalRing.ResidueField ↥W) (k : ℕ), c ≠ 0 ∧ 1 ≤ k ∧
      (∀ w : ↥W, ψ (Ideal.Quotient.mk _ (wcIccCst W A K L (wcLlsIsiCR W A K u a') w)) =
        LaurentPolynomial.C (IsLocalRing.residue ↥W w)) ∧
      ψ (Ideal.Quotient.mk _ (wcIccYC W A K L u a')) =
        LaurentPolynomial.C c * LaurentPolynomial.T (k : ℤ) := by
    obtain ⟨c, k₀, hc, hk₀, hθy, -⟩ := wcpa_dj_llsm_isiccc_orientation Ω W hW hWt A K L 𝔭 u v
      g a' b hoC hPD ha'm ha'0 ⟨e, he⟩ hnba hbg (θ j) (hsurj j) (hθC j)
    rcases lt_or_gt_of_ne hk₀ with hneg | hpos
    · refine ⟨(RingHom.quotientKerEquivOfSurjective (hsurj j)).trans
        LaurentPolynomial.invert.toRingEquiv, c, (-k₀).toNat, hc, by omega, ?_, ?_⟩
      · intro w
        show LaurentPolynomial.invert (θ j (wcIccCst W A K L (wcLlsIsiCR W A K u a') w)) = _
        rw [hθC, LaurentPolynomial.invert_C]
      · show LaurentPolynomial.invert (θ j (wcIccYC W A K L u a')) = _
        rw [hθy, map_mul, LaurentPolynomial.invert_C, LaurentPolynomial.invert_T,
          Int.toNat_of_nonneg (by omega)]
    · refine ⟨RingHom.quotientKerEquivOfSurjective (hsurj j), c, k₀.toNat, hc, by omega, ?_, ?_⟩
      · intro w
        show θ j (wcIccCst W A K L (wcLlsIsiCR W A K u a') w) = _
        rw [hθC]
      · show θ j (wcIccYC W A K L u a') = _
        rw [hθy, Int.toNat_of_nonneg (by omega)]
  refine ⟨RingHom.ker (θ j), hKp j, ψ, c, k, hc, hk, hIK j, hKj0, hψW, hψy, ?_, hKjo, hKj'I⟩

  intro z hz
  have hρex : ∀ i, ∃ ρ : ↥(integralClosure ↥(wcLlsASbS W A K u b) L), ρ ∉ y₀ ∧
      ((RingHom.ker (θ i)).comap (wcIcxIncl L _ _ (hRo.trans hoC)) = y₀ ∨
        wcIcxIncl L _ _ (hRo.trans hoC) ρ ∈ RingHom.ker (θ i)) := by
    intro i
    by_cases h : (RingHom.ker (θ i)).comap (wcIcxIncl L _ _ (hRo.trans hoC)) = y₀
    · exact ⟨1, fun h1 => hy₀.ne_top ((Ideal.eq_top_iff_one _).mpr h1), Or.inl h⟩
    · have hnle : ¬ (RingHom.ker (θ i)).comap (wcIcxIncl L _ _ (hRo.trans hoC)) ≤ y₀ :=
        fun hle => h ((hmax i).eq_of_le hy₀.ne_top hle)
      obtain ⟨ρ, hρK, hρy⟩ := SetLike.not_le_iff_exists.mp hnle
      exact ⟨ρ, hρy, Or.inr hρK⟩
  choose ρ hρy hρK using hρex
  refine ⟨∏ i, ρ i, ?_, ?_⟩
  · intro h
    obtain ⟨i, -, hi⟩ := hy₀.prod_mem_iff.mp h
    exact hρy i hi
  have hJ : wcIcxIncl L _ _ (hRo.trans hoC) (∏ i, ρ i) * z ∈
      (wcIccM W (wcIccWL W A K L) ↥(wcLlsIsiCR W A K u a')).radical := by
    apply F2
    intro i
    rw [map_mul]
    rcases hρK i with h | h
    · have hij := huniq i h
      subst hij
      rw [RingHom.mem_ker.mp hz, mul_zero]
    · rw [map_prod, map_prod, Finset.prod_eq_zero (Finset.mem_univ i) (RingHom.mem_ker.mp h),
        zero_mul]
  obtain ⟨m, hm⟩ := hJ
  obtain ⟨w, hw, c', hc'⟩ := hform _ (hrad _ m hm)
  refine ⟨w, hw, c', ?_⟩
  rw [← hc', MulMemClass.coe_mul]
  rfl

theorem wcpa_dj_llsm_isicco_ro_poly : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] (𝔭 : Ideal A) (u v : A)
    (g a' b : ↥W), wcLlsPD W A 𝔭 (.ann u v g) →
    (∀ a : A, ∃ w : ↥W, a - algebraMap ↥W A w ∈ 𝔭) → a' ∣ b → ¬ b ∣ a' → b ∣ g →
    ∀ (φ : ↥(integralClosure ↥(wcLlsASbS W A K u a') L) →+*
        LaurentPolynomial (IsLocalRing.ResidueField ↥W))
      (c : IsLocalRing.ResidueField ↥W) (k : ℕ),
    (∀ w : ↥W, φ (wcIccCst W A K L (wcLlsASbS W A K u a') w) =
      LaurentPolynomial.C (IsLocalRing.residue ↥W w)) →
    φ (wcIccUo W A K L u a') = 0 →
    φ (wcIccYo W A K L u a') = LaurentPolynomial.C c * LaurentPolynomial.T (k : ℤ) →
    ∀ r : ↥(wcLlsASbS W A K u a'), ∃ q : Polynomial (IsLocalRing.ResidueField ↥W),
      φ (algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L) r) =
        Polynomial.toLaurent q :=
by
  intro Ω _ W A _ _ _ K _ _ _ L _ _ 𝔭 u v g a' b hPD hRT ha'b hnba hbg φ c k hφW hφu hφy r
  obtain ⟨_, hNZ, _, _, _, _, hg0, huv, h𝔭eq, _⟩ := hPD
  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    rw [Algebra.algebraMap_eq_smul_one] at hw
    rcases smul_eq_zero.mp hw with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hu0 : algebraMap A K u ≠ 0 := by
    intro h
    apply hg0
    apply hWA
    apply IsFractionRing.injective A K
    rw [map_zero, map_zero, ← huv, map_mul, h, zero_mul]

  obtain ⟨ε, hεm, hg⟩ : ∃ ε ∈ IsLocalRing.maximalIdeal ↥W, g = a' * ε := by
    obtain ⟨e, he⟩ := ha'b
    obtain ⟨h, hh⟩ := hbg
    have hem : e ∈ IsLocalRing.maximalIdeal ↥W := by
      by_contra hne
      have hu : IsUnit e := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hne
        exact hne
      apply hnba
      obtain ⟨eu, rfl⟩ := hu
      exact ⟨↑eu⁻¹, by rw [he, mul_assoc, Units.mul_inv, mul_one]⟩
    exact ⟨e * h, Ideal.mul_mem_right h _ hem, by rw [hh, he, mul_assoc]⟩
  have hres : IsLocalRing.residue ↥W ε = 0 := by
    rw [IsLocalRing.residue_eq_zero_iff]; exact hεm

  have hy : algebraMap A K (algebraMap ↥W A a') / algebraMap A K u ∈
      Algebra.adjoin A {algebraMap A K (algebraMap ↥W A a') / algebraMap A K u} :=
    Algebra.subset_adjoin (Set.mem_singleton _)
  have hvR : algebraMap A ↥(wcLlsASbS W A K u a') v =
      algebraMap A ↥(wcLlsASbS W A K u a') (algebraMap ↥W A ε) *
        (⟨algebraMap A K (algebraMap ↥W A a') / algebraMap A K u, hy⟩ :
          ↥(wcLlsASbS W A K u a')) := by
    apply Subtype.ext
    show algebraMap A K v = algebraMap A K (algebraMap ↥W A ε) *
      (algebraMap A K (algebraMap ↥W A a') / algebraMap A K u)
    have h1 := congrArg (algebraMap A K) huv
    simp only [hg, map_mul] at h1
    rw [mul_div_assoc', eq_div_iff hu0]
    linear_combination h1

  have hW' : ∀ w : ↥W, φ (algebraMap ↥(wcLlsASbS W A K u a')
      ↥(integralClosure ↥(wcLlsASbS W A K u a') L)
      (algebraMap A ↥(wcLlsASbS W A K u a') (algebraMap ↥W A w))) =
      LaurentPolynomial.C (IsLocalRing.residue ↥W w) := by
    intro w
    have e1 : algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)
        (algebraMap A ↥(wcLlsASbS W A K u a') (algebraMap ↥W A w)) =
        wcIccCst W A K L (wcLlsASbS W A K u a') w := Subtype.ext rfl
    rw [e1, hφW]
  obtain ⟨φA, hφA⟩ : ∃ f : A →+* LaurentPolynomial (IsLocalRing.ResidueField ↥W),
      ∀ a, f a = φ (algebraMap ↥(wcLlsASbS W A K u a')
        ↥(integralClosure ↥(wcLlsASbS W A K u a') L) (algebraMap A ↥(wcLlsASbS W A K u a') a)) :=
    ⟨(φ.comp (algebraMap _ _)).comp (algebraMap _ _), fun _ => rfl⟩
  have hAu : φA u = 0 := by rw [hφA]; exact hφu
  have hAv : φA v = 0 := by
    rw [hφA, hvR, map_mul, map_mul, hW', hres, map_zero, zero_mul]

  have h𝔭ker : 𝔭 ≤ RingHom.ker φA := by
    rw [h𝔭eq]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      intro x hx
      rcases Set.mem_insert_iff.mp hx with hx | hx
      · rw [hx, SetLike.mem_coe, RingHom.mem_ker]; exact hAu
      · rw [Set.mem_singleton_iff] at hx
        rw [hx, SetLike.mem_coe, RingHom.mem_ker]; exact hAv
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      have hw0 : IsLocalRing.residue ↥W w = 0 := by
        rw [IsLocalRing.residue_eq_zero_iff]; exact hw
      rw [Ideal.mem_comap, RingHom.mem_ker, hφA, hW', hw0, map_zero]

  have hAconst : ∀ a : A, ∃ q : Polynomial (IsLocalRing.ResidueField ↥W),
      φ (algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)
        (algebraMap A ↥(wcLlsASbS W A K u a') a)) = Polynomial.toLaurent q := by
    intro a
    obtain ⟨w, hw⟩ := hRT a
    have h0 := h𝔭ker hw
    rw [RingHom.mem_ker, map_sub, sub_eq_zero, hφA, hφA, hW'] at h0
    exact ⟨Polynomial.C (IsLocalRing.residue ↥W w), by rw [h0, Polynomial.toLaurent_C]⟩

  obtain ⟨x, hx⟩ := r
  refine Algebra.adjoin_induction
    (s := {algebraMap A K (algebraMap ↥W A a') / algebraMap A K u})
    (p := fun x hx => ∃ q : Polynomial (IsLocalRing.ResidueField ↥W),
      φ (algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)
        (⟨x, hx⟩ : ↥(wcLlsASbS W A K u a'))) = Polynomial.toLaurent q) ?_ ?_ ?_ ?_ hx
  · intro x hx'
    rw [Set.mem_singleton_iff] at hx'
    subst hx'
    exact ⟨Polynomial.C c * Polynomial.X ^ k, by rw [Polynomial.toLaurent_C_mul_X_pow]; exact hφy⟩
  · intro a
    exact hAconst a
  · rintro x₁ x₂ h₁ h₂ ⟨q₁, hq₁⟩ ⟨q₂, hq₂⟩
    refine ⟨q₁ + q₂, ?_⟩
    show φ (algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)
      ((⟨x₁, h₁⟩ : ↥(wcLlsASbS W A K u a')) + ⟨x₂, h₂⟩)) = _
    rw [map_add, map_add, hq₁, hq₂, map_add]
  · rintro x₁ x₂ h₁ h₂ ⟨q₁, hq₁⟩ ⟨q₂, hq₂⟩
    refine ⟨q₁ * q₂, ?_⟩
    show φ (algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)
      ((⟨x₁, h₁⟩ : ↥(wcLlsASbS W A K u a')) * ⟨x₂, h₂⟩)) = _
    rw [map_mul, map_mul, hq₁, hq₂, map_mul]

theorem wcpa_dj_llsm_isicco_laurent_integral : ∀ (κ : Type u) [Field κ] (f : LaurentPolynomial κ)
    (q : Polynomial (Polynomial κ)), q.Monic → (q.map Polynomial.toLaurent).eval f = 0 →
    ∃ p : Polynomial κ, Polynomial.toLaurent p = f :=
by
  intro κ _ f q hq hev
  classical
  have hE : ∑ i ∈ Finset.range (q.natDegree + 1),
      Polynomial.toLaurent (q.coeff i) * f ^ i = 0 := by
    rw [Polynomial.eval_map, Polynomial.eval₂_eq_sum_range] at hev
    exact hev
  have key : ∀ (n : ℕ) (f' : Polynomial κ), 1 ≤ n →
      Polynomial.toLaurent f' = f * LaurentPolynomial.T (n : ℤ) → f'.coeff 0 = 0 := by
    intro n f' hn hf'
    have htX : Polynomial.toLaurent ((Polynomial.X : Polynomial κ) ^ n) =
        LaurentPolynomial.T (n : ℤ) := Polynomial.toLaurent_X_pow n
    have hPL : Polynomial.toLaurent (∑ i ∈ Finset.range (q.natDegree + 1),
        q.coeff i * f' ^ i * ((Polynomial.X : Polynomial κ) ^ n) ^ (q.natDegree - i)) =
        LaurentPolynomial.T (n : ℤ) ^ q.natDegree * ∑ i ∈ Finset.range (q.natDegree + 1),
          Polynomial.toLaurent (q.coeff i) * f ^ i := by
      rw [map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i hi => ?_)
      have hi' : i ≤ q.natDegree := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      rw [map_mul, map_mul, map_pow, map_pow, htX, hf',
        ← pow_mul_pow_sub (LaurentPolynomial.T (n : ℤ)) hi']
      ring
    rw [hE, mul_zero] at hPL
    have hP0 : (∑ i ∈ Finset.range (q.natDegree + 1),
        q.coeff i * f' ^ i * ((Polynomial.X : Polynomial κ) ^ n) ^ (q.natDegree - i)) = 0 :=
      Polynomial.toLaurent_injective (by rw [hPL, map_zero])
    have hev0 := congrArg (Polynomial.eval (0 : κ)) hP0
    rw [Polynomial.eval_finsetSum, Finset.sum_range_succ, Finset.sum_eq_zero] at hev0
    · rw [Nat.sub_self, pow_zero, mul_one, hq.coeff_natDegree, one_mul, zero_add,
        Polynomial.eval_pow, Polynomial.eval_zero] at hev0
      rw [Polynomial.coeff_zero_eq_eval_zero]
      exact _root_.IsReduced.eq_zero _ ⟨q.natDegree, hev0⟩
    · intro i hi
      have hi' : i < q.natDegree := Finset.mem_range.mp hi
      have h1 : q.natDegree - i ≠ 0 := by omega
      have h2 : n ≠ 0 := by omega
      simp [Polynomial.eval_mul, Polynomial.eval_pow, h1, h2, zero_pow]
  have peel : ∀ (n : ℕ) (f' : Polynomial κ),
      Polynomial.toLaurent f' = f * LaurentPolynomial.T (n : ℤ) →
      ∃ p : Polynomial κ, Polynomial.toLaurent p = f := by
    intro n
    induction n with
    | zero => intro f' hf'; exact ⟨f', by simpa using hf'⟩
    | succ m ih =>
      intro f' hf'
      have h0 := key (m + 1) f' (by omega) hf'
      obtain ⟨g, hg⟩ := Polynomial.X_dvd_iff.mpr h0
      apply ih g
      have h1 : Polynomial.toLaurent g * LaurentPolynomial.T 1 =
          (f * LaurentPolynomial.T (m : ℤ)) * LaurentPolynomial.T 1 := by
        rw [mul_comm, ← Polynomial.toLaurent_X, ← map_mul, ← hg, hf', mul_assoc,
          Polynomial.toLaurent_X, ← LaurentPolynomial.T_add, Nat.cast_succ]
      exact (LaurentPolynomial.isUnit_T 1).mul_left_inj.mp h1
  obtain ⟨n, f', hf'⟩ := LaurentPolynomial.exists_T_pow f
  exact peel n f' hf'

theorem wcpa_dj_llsm_isicco_shift_integral : ∀ (A : Type u) [CommRing A] (K : Type u) [Field K]
    [Algebra A K] (L : Type u) [Field L] [Algebra K L] (x y : K), x * y = 1 →
    ∀ γ : L, IsIntegral ↥(Algebra.adjoin A {x, y}) γ →
    ∃ n : ℕ, IsIntegral ↥(Algebra.adjoin A {y}) (algebraMap K L y ^ n * γ) :=
by
  intro A _ K _ _ L _ _ x y hxy γ hγ
  classical
  have key : ∀ (S R : Subalgebra A K), S ≤ R → y ∈ S → (∀ r ∈ R, ∃ m : ℕ, y ^ m * r ∈ S) →
      ∀ γ : L, IsIntegral R γ → ∃ n : ℕ, IsIntegral S (algebraMap K L y ^ n * γ) := by
    intro S R hSR hyS hcl γ hγ
    obtain ⟨p, hpm, hp⟩ := hγ
    choose m hm using fun i => hcl (p.coeff i : K) (p.coeff i).2
    obtain ⟨d, hd⟩ : ∃ d, d = p.natDegree := ⟨_, rfl⟩
    obtain ⟨M, hM⟩ : ∃ M, M = ∑ i ∈ Finset.range (d + 1), m i := ⟨_, rfl⟩
    let s : R := ⟨y ^ M, hSR (S.pow_mem hyS M)⟩
    let ι : S →+* R := (Subalgebra.inclusion hSR).toRingHom
    have hfι : (algebraMap R L).comp ι = algebraMap S L := RingHom.ext fun _ => rfl
    have hq0 : Polynomial.eval₂ (algebraMap R L) (algebraMap R L s * γ) (p.scaleRoots s) = 0 :=
      Polynomial.scaleRoots_eval₂_eq_zero _ hp
    have hlifts : p.scaleRoots s ∈ Polynomial.lifts ι := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [Polynomial.coeff_scaleRoots, ← hd]
      rcases lt_trichotomy i d with hi | hi | hi
      · have hmi : m i ≤ M := by
          rw [hM]
          exact Finset.single_le_sum (fun j _ => Nat.zero_le (m j))
            (Finset.mem_range.mpr (by omega))
        have hle : m i ≤ M * (d - i) := le_trans hmi (Nat.le_mul_of_pos_right M (by omega))
        refine ⟨⟨y ^ (M * (d - i) - m i) * (y ^ m i * (p.coeff i : K)),
          S.mul_mem (S.pow_mem hyS _) (hm i)⟩, ?_⟩
        apply Subtype.ext
        show y ^ (M * (d - i) - m i) * (y ^ m i * (p.coeff i : K)) =
          ((p.coeff i * s ^ (d - i) : R) : K)
        rw [Subalgebra.coe_mul, SubmonoidClass.coe_pow]
        show _ = (p.coeff i : K) * (y ^ M) ^ (d - i)
        rw [← pow_mul, ← mul_assoc, ← pow_add, Nat.sub_add_cancel hle]
        ring
      · rw [hi, Nat.sub_self, pow_zero, mul_one]
        have h1 : p.coeff d = 1 := by rw [hd]; exact hpm
        rw [h1]
        exact ⟨1, map_one ι⟩
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), zero_mul]
        exact ⟨0, map_zero ι⟩
    have hqm : (p.scaleRoots s).Monic := by
      unfold Polynomial.Monic
      rw [Polynomial.leadingCoeff_scaleRoots]
      exact hpm
    obtain ⟨Q, hQmap, -, hQm⟩ :=
      Polynomial.lifts_and_degree_eq_and_monic hlifts hqm
    refine ⟨M, Q, hQm, ?_⟩
    have hs : algebraMap R L s = algebraMap K L y ^ M := by
      rw [← map_pow]; rfl
    rw [← hfι, ← Polynomial.eval₂_map, hQmap, ← hs]
    exact hq0
  have hSR : Algebra.adjoin A {y} ≤ Algebra.adjoin A ({x, y} : Set K) :=
    Algebra.adjoin_mono (Set.singleton_subset_iff.mpr (Set.mem_insert_of_mem _ rfl))
  have hyS : y ∈ Algebra.adjoin A {y} := Algebra.subset_adjoin (Set.mem_singleton y)
  have hclear : ∀ r ∈ Algebra.adjoin A ({x, y} : Set K), ∃ m : ℕ, y ^ m * r ∈ Algebra.adjoin A {y} := by
    intro r hr
    induction hr using Algebra.adjoin_induction with
    | mem z hz =>
      rcases hz with hz | hz
      · refine ⟨1, ?_⟩
        rw [hz, pow_one, mul_comm, hxy]
        exact Subalgebra.one_mem _
      · rw [Set.mem_singleton_iff] at hz
        refine ⟨0, ?_⟩
        rw [hz, pow_zero, one_mul]
        exact hyS
    | algebraMap a =>
      refine ⟨0, ?_⟩
      rw [pow_zero, one_mul]
      exact Subalgebra.algebraMap_mem _ a
    | add r₁ r₂ _ _ ih₁ ih₂ =>
      obtain ⟨m₁, h₁⟩ := ih₁
      obtain ⟨m₂, h₂⟩ := ih₂
      refine ⟨m₁ + m₂, ?_⟩
      have e : y ^ (m₁ + m₂) * (r₁ + r₂) = y ^ m₂ * (y ^ m₁ * r₁) + y ^ m₁ * (y ^ m₂ * r₂) := by
        ring
      rw [e]
      exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hyS _) h₁)
        (Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hyS _) h₂)
    | mul r₁ r₂ _ _ ih₁ ih₂ =>
      obtain ⟨m₁, h₁⟩ := ih₁
      obtain ⟨m₂, h₂⟩ := ih₂
      refine ⟨m₁ + m₂, ?_⟩
      have e : y ^ (m₁ + m₂) * (r₁ * r₂) = (y ^ m₁ * r₁) * (y ^ m₂ * r₂) := by ring
      rw [e]
      exact Subalgebra.mul_mem _ h₁ h₂
  exact key _ _ hSR hyS hclear γ hγ

theorem wcpa_dj_llsm_isicco_max_unique : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] (𝔭 : Ideal A) (u v : A)
    (g a' b : ↥W) (hRo : wcLlsASbS W A K u b ≤ wcLlsASbS W A K u a'),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    a' ∣ b → b ∣ g →
    ∀ (y₀ : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u b) L)), y₀.IsPrime →
    y₀.comap (algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)) =
      wcLlsASbN W A K u b →
    ∀ (Qo Pu : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u a') L)), Qo.IsPrime →
    Qo.comap (algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) =
      wcLlsASbN W A K u a' →
    (∀ Q : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u a') L), Q.IsPrime →
      Q.comap (wcIcxIncl L _ _ hRo) = y₀ →
      Q.comap (algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) =
        wcLlsASbN W A K u a' → Q = Qo) →
    y₀ ≤ Pu.comap (wcIcxIncl L _ _ hRo) →
    wcIccM W (wcIccWL W A K L) ↥(wcLlsASbS W A K u a') ≤ Pu →
    wcIccUo W A K L u a' ∈ Pu →
    ∀ M : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u a') L), M.IsMaximal → Pu ≤ M →
      wcIccYo W A K L u a' ∈ M → M = Qo :=
by
  have wcpa_dj_llsm_brrm_node_max : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
      ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (k : wcLlsKind W A) (z₀ : A) (b : ↥W),
      wcLlsPD W A 𝔭 k →
      ((∃ t c, k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧ z₀ = t - algebraMap ↥W A c) ∨
        (∃ v g, k = .ann z₀ v g ∧ b ∣ g)) →
      b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
      ∀ (s : K), s = algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀ →
      Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z₀,
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) ≠ ⊤ →
      (Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z₀,
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))).IsMaximal := by
    intro Ω _ _ W _ _ A _ _ _ K _ _ _ 𝔭 k z₀ b hPD hk _ _ s hs hNtop
    classical
    obtain ⟨N, hNdef⟩ : ∃ N : Ideal ↥(Algebra.adjoin A {s}),
        N = Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z₀,
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) := ⟨_, rfl⟩
    rw [← hNdef] at hNtop ⊢
    have hN1 : algebraMap A ↥(Algebra.adjoin A {s}) z₀ ∈ N := by
      rw [hNdef]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
    have hN2 : (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) ∈ N := by
      rw [hNdef]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    have hN3 : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
        algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w) ∈ N := by
      intro w hw
      rw [hNdef]
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) hw)
    have hrep : ∀ (x₀ : K) (hx₀ : x₀ ∈ Algebra.adjoin A {s}), ∃ a : A,
        (⟨x₀, hx₀⟩ : ↥(Algebra.adjoin A {s})) - algebraMap A _ a ∈ N := by
      intro x₀ hx₀
      induction hx₀ using Algebra.adjoin_induction with
      | mem x hx =>
        refine ⟨0, ?_⟩
        have e : (⟨x, Algebra.subset_adjoin hx⟩ : ↥(Algebra.adjoin A {s})) =
            ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ := Subtype.ext hx
        rw [map_zero, sub_zero, e]
        exact hN2
      | algebraMap r =>
        refine ⟨r, ?_⟩
        convert N.zero_mem using 1
        apply Subtype.ext
        simp
      | add x y hx hy ihx ihy =>
        obtain ⟨a, ha⟩ := ihx
        obtain ⟨a', ha'⟩ := ihy
        refine ⟨a + a', ?_⟩
        convert N.add_mem ha ha' using 1
        apply Subtype.ext
        simp only [Subalgebra.coe_sub, Subalgebra.coe_add, Subalgebra.coe_algebraMap, map_add]
        ring
      | mul x y hx hy ihx ihy =>
        obtain ⟨a, ha⟩ := ihx
        obtain ⟨a', ha'⟩ := ihy
        refine ⟨a * a', ?_⟩
        convert N.add_mem (N.mul_mem_right (⟨y, hy⟩ : ↥(Algebra.adjoin A {s})) ha)
          (N.mul_mem_left (algebraMap A ↥(Algebra.adjoin A {s}) a) ha') using 1
        apply Subtype.ext
        simp only [Subalgebra.coe_sub, Subalgebra.coe_add, Subalgebra.coe_mul,
          Subalgebra.coe_algebraMap, map_mul]
        ring
    have hm : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤
        N.comap (algebraMap A ↥(Algebra.adjoin A {s})) := by
      rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap]
      exact hN3 w hw
    obtain ⟨-, hnz, -, hmax, -, hcase⟩ := hPD
    haveI := hnz
    have hp : 𝔭 ≤ N.comap (algebraMap A ↥(Algebra.adjoin A {s})) := by
      rcases hk with ⟨t, c, rfl, hc, hz⟩ | ⟨v, g, rfl, hbg⟩
      · obtain ⟨-, h𝔭, -⟩ := hcase
        rw [h𝔭]
        refine sup_le ?_ hm
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
        have e : t = z₀ + algebraMap ↥W A c := by rw [hz]; ring
        rw [e, map_add]
        exact N.add_mem hN1 (hN3 c hc)
      · obtain ⟨-, hg0, huv, h𝔭, -⟩ := hcase
        obtain ⟨q, hgq⟩ := hbg
        have hz0 : algebraMap A K z₀ ≠ 0 := by
          intro h
          have hz : z₀ = 0 := (IsFractionRing.injective A K) (by rw [h, map_zero])
          rw [hz, zero_mul, Algebra.algebraMap_eq_smul_one] at huv
          rcases smul_eq_zero.mp huv.symm with h1 | h1
          · exact hg0 h1
          · exact one_ne_zero h1
        have hvK : algebraMap A K v = algebraMap A K (algebraMap ↥W A q) * s := by
          rw [hs]
          have e := congrArg (algebraMap A K) huv
          simp only [map_mul, hgq] at e
          rw [mul_div_assoc', eq_div_iff hz0]
          linear_combination e
        rw [h𝔭]
        refine sup_le ?_ hm
        rw [Ideal.span_le]
        intro x hx
        rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
        rw [SetLike.mem_coe, Ideal.mem_comap]
        rcases hx with hx | hx
        · rw [hx]; exact hN1
        · have e : algebraMap A ↥(Algebra.adjoin A {s}) v =
              algebraMap A _ (algebraMap ↥W A q) *
                ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ := by
            apply Subtype.ext
            simpa using hvK
          rw [hx, e]
          exact N.mul_mem_left _ hN2
    rw [Ideal.isMaximal_iff]
    refine ⟨fun h1 => hNtop ((Ideal.eq_top_iff_one N).mpr h1), ?_⟩
    intro J x hNJ hxN hxJ
    obtain ⟨a, ha⟩ := hrep x.1 x.2
    have ha' : x - algebraMap A _ a ∈ N := ha
    have ha𝔭 : a ∉ 𝔭 := by
      intro h
      apply hxN
      have := N.add_mem ha' (Ideal.mem_comap.mp (hp h))
      rwa [sub_add_cancel] at this
    obtain ⟨y, p', hp', hyp⟩ := hmax.exists_inv ha𝔭
    have e1 : (1 : ↥(Algebra.adjoin A {s})) = algebraMap A _ y * x -
        algebraMap A _ y * (x - algebraMap A _ a) + algebraMap A _ p' := by
      rw [← map_one (algebraMap A ↥(Algebra.adjoin A {s})), ← hyp, map_add, map_mul]; ring
    rw [e1]
    exact J.add_mem (J.sub_mem (J.mul_mem_left _ hxJ) (hNJ (N.mul_mem_left _ ha')))
      (hNJ (Ideal.mem_comap.mp (hp hp')))
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ 𝔭 u v g a' b hRo hPD ha'm ha'0 hbm hb0 ha'b hbg
    y₀ hy₀ hy₀c Qo Pu hQo hQoN huniq hy₀Pu hIPu huPu M hM hPuM hyM
  have hNo : (wcLlsASbN W A K u a').IsMaximal := by
    have h := wcpa_dj_llsm_brrm_node_max Ω W hW hWt A K 𝔭 (.ann u v g) u a' hPD
      (Or.inr ⟨v, g, rfl, dvd_trans ha'b hbg⟩) ha'm ha'0 _ rfl
    have hne : wcLlsASbN W A K u a' ≠ ⊤ := hQoN ▸ Ideal.comap_ne_top _ hQo.ne_top
    exact h hne
  have hN0 : (wcLlsASbN W A K u b).IsMaximal := by
    have h := wcpa_dj_llsm_brrm_node_max Ω W hW hWt A K 𝔭 (.ann u v g) u b hPD
      (Or.inr ⟨v, g, rfl, hbg⟩) hbm hb0 _ rfl
    have hne : wcLlsASbN W A K u b ≠ ⊤ := hy₀c ▸ Ideal.comap_ne_top _ hy₀.ne_top
    exact h hne
  have hle : wcLlsASbN W A K u a' ≤ M.comap (algebraMap ↥(wcLlsASbS W A K u a')
