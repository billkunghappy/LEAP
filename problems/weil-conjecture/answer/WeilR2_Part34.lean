    rintro rfl
    rw [map_zero, zero_div] at hx0
    exact hx0 rfl
  have hqK : algebraMap A K q ≠ 0 := (map_ne_zero_iff _ hinj).mpr hq0
  rw [div_eq_mul_inv]
  exact E_mul _ _ (hP_E p hp0) (E_inv _ hqK (hP_E q hq0))

theorem wcpa_dj_llsm_kpwic_pd_swap : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [Algebra ↥W A] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) → wcLlsPD W A 𝔭 (.ann v u g) :=
by
  intro Ω _ W A _ _ 𝔭 u v g hPD
  obtain ⟨hFT, hNZ, hIC, hmax, hle, hg, hg0, huv, h𝔭, h, hh, f, hfC, hf0, hf1, hfet⟩ := hPD
  refine ⟨hFT, hNZ, hIC, hmax, hle, hg, hg0, by rw [mul_comm]; exact huv,
    by rw [Set.pair_comm]; exact h𝔭, h, hh, ?_⟩
  let σ₀ : MvPolynomial (Fin 2) ↥W ≃+* MvPolynomial (Fin 2) ↥W :=
    (MvPolynomial.renameEquiv ↥W (Equiv.swap (0 : Fin 2) 1)).toRingEquiv
  have hσX0 : σ₀ (MvPolynomial.X 0) = MvPolynomial.X 1 := by
    simp [σ₀, MvPolynomial.renameEquiv_apply]
  have hσX1 : σ₀ (MvPolynomial.X 1) = MvPolynomial.X 0 := by
    simp [σ₀, MvPolynomial.renameEquiv_apply]
  have hσC : ∀ c, σ₀ (MvPolynomial.C c) = MvPolynomial.C c := by
    intro c
    simp [σ₀, MvPolynomial.renameEquiv_apply]
  have hI : Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} =
      Ideal.map σ₀ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} :
        Ideal (MvPolynomial (Fin 2) ↥W)) := by
    rw [Ideal.map_span, Set.image_singleton, map_sub, map_mul, hσX0, hσX1, hσC, mul_comm]
  let σ := Ideal.quotientEquiv _ _ σ₀ hI
  have hσmk : ∀ x, σ (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (σ₀ x) := fun x =>
    Ideal.quotientEquiv_mk _ _ σ₀ hI x
  refine ⟨f.comp σ.toRingHom, ?_, ?_, ?_, ?_⟩
  · refine RingHom.ext fun c => ?_
    have := RingHom.congr_fun hfC c
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom] at this ⊢
    rw [hσmk, hσC]
    exact this
  · simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]
    rw [hσmk, hσX0]
    exact hf1
  · simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]
    rw [hσmk, hσX1]
    exact hf0
  · have hσ : RingHom.Etale (R := MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
        (S := MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) σ.toRingHom :=
      RingHom.Etale.of_bijective σ.bijective
    exact RingHom.Etale.stableUnderComposition (R := MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
        (S := MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
        (T := Localization.Away h) σ.toRingHom f hσ hfet

theorem wcpa_dj_llsm_kpwul_bracket : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) → ∀ x : A, x ≠ 0 → ∃ (j k : ℕ) (σ ε r g' : A) (lam w : ↥W), σ ∉ 𝔭 ∧ ε ∉ 𝔭 ∧ lam ≠ 0 ∧ w ∈ IsLocalRing.maximalIdeal ↥W ∧ σ * u ^ j * x = algebraMap ↥W A lam * (u ^ k * ε + v * r + algebraMap ↥W A w * g') :=
by
  intro Ω _ _ W hdim hWt A _ _ _ 𝔭 u v g hPD x hx0
  classical
  have hPD' := hPD
  unfold wcLlsPD at hPD'
  obtain ⟨_hFT, hNZ, _hIC, hmax, hmA, hg𝔪, hg0, huv, hp, -⟩ := hPD'
  haveI := hNZ
  have hprime : 𝔭.IsPrime := hmax.isPrime
  obtain ⟨K, _, _, ⟨_⟩⟩ : ∃ (K : Type u) (_ : Field K) (_ : Algebra A K),
      Nonempty (IsFractionRing A K) :=
    ⟨FractionRing A, inferInstance, inferInstance, ⟨inferInstance⟩⟩
  have hφinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have haW : ∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ≠ 0 := by
    intro w hw
    rw [Algebra.algebraMap_eq_smul_one]
    exact smul_ne_zero hw one_ne_zero
  have hι : ∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0 := fun w hw h =>
    haW w hw (hφinj (h.trans (map_zero _).symm))
  have hu0 : u ≠ 0 := by
    intro h; apply haW g hg0; rw [← huv, h, zero_mul]
  have hv0 : v ≠ 0 := by
    intro h; apply haW g hg0; rw [← huv, h, mul_zero]
  have hφu : algebraMap A K u ≠ 0 := fun h => hu0 (hφinj (h.trans (map_zero _).symm))
  have hφv : algebraMap A K v ≠ 0 := fun h => hv0 (hφinj (h.trans (map_zero _).symm))
  have hnonunit : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → ¬ IsUnit w := fun w hw =>
    mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal w).mp hw)
  have hmA_mem : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → ∀ z : A,
      algebraMap ↥W A w * z ∈ 𝔭 := fun w hw z =>
    Ideal.mul_mem_right _ _ (hmA (Ideal.mem_map_of_mem _ hw))
  have hgval : algebraMap A K (algebraMap ↥W A g) = algebraMap A K u * algebraMap A K v := by
    rw [← huv, map_mul]

  have arch : ∀ a b : ↥W, a ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → ∃ N : ℕ, b ∣ a ^ N := by
    intro a b ha hb
    haveI : Ring.KrullDimLE 1 ↥W := ⟨hdim⟩
    haveI : (⊥ : Ideal ↥W).IsPrime := Ideal.isPrime_bot
    have hJ : ∀ J : Ideal ↥W, J.IsPrime → b ∈ J → J = IsLocalRing.maximalIdeal ↥W := by
      intro J hJp hbJ
      have hne : J ≠ ⊥ := fun h => hb (by rw [h] at hbJ; exact (Submodule.mem_bot _).mp hbJ)
      have hJm := (Ring.krullDimLE_one_iff_of_isPrime_bot.mp inferInstance) J hne hJp
      exact IsLocalRing.eq_maximalIdeal hJm
    have hrad : a ∈ (Ideal.span {b}).radical := by
      rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
      rintro J ⟨hJle, hJp⟩
      rw [hJ J hJp (hJle (Ideal.subset_span (Set.mem_singleton b)))]
      exact ha
    obtain ⟨N, hN⟩ := hrad
    exact ⟨N, Ideal.mem_span_singleton.mp hN⟩

  have geom : ∀ (T r d y U E ρ c : A) (N : ℕ), (T + r * d) * y = ρ * (U + r * E) →
      r ^ N = ρ * c → ∃ G : A, T ^ (N + 1) * y = ρ * (U * T ^ N + r * G) := by
    intro T r d y U E ρ c N h hr
    have key : ∀ n : ℕ, ∃ G : A,
        T ^ (n + 1) * y = ρ * (U * T ^ n + r * G) + (-(r * d)) ^ (n + 1) * y := by
      intro n
      induction n with
      | zero => exact ⟨E, by linear_combination h⟩
      | succ n ih =>
        obtain ⟨G, hG⟩ := ih
        exact ⟨T * G - (-(r * d)) ^ n * d * (U + r * E), by
          linear_combination T * hG + (-(r * d)) ^ (n + 1) * h⟩
    obtain ⟨G, hG⟩ := key N
    exact ⟨G + (-1) ^ (N + 1) * c * d ^ (N + 1) * y, by
      linear_combination hG + (-1) ^ (N + 1) * r * d ^ (N + 1) * y * hr⟩

  have pow_unit : ∀ b : A, b ∉ 𝔭 → ∀ (e : ℕ) (r : ↥W) (z : A), r ∈ IsLocalRing.maximalIdeal ↥W →
      u ^ e * b ≠ algebraMap ↥W A r * z := by
    intro b hb e r z hr h
    rcases Nat.eq_zero_or_pos e with he | he
    · subst he
      apply hb
      rw [pow_zero, one_mul] at h
      rw [h]
      exact hmA_mem r hr z
    by_cases hr0 : r = 0
    · rw [hr0, map_zero, zero_mul] at h
      exact mul_ne_zero (pow_ne_zero _ hu0) (fun h0 => hb (by rw [h0]; exact 𝔭.zero_mem)) h
    obtain ⟨μ, hμm, hμ0, hμr, hμg⟩ : ∃ μ : ↥W, μ ∈ IsLocalRing.maximalIdeal ↥W ∧ μ ≠ 0 ∧
        μ ∣ r ∧ μ ∣ g := by
      rcases ValuationRing.dvd_total r g with h1 | h1
      · exact ⟨r, hr, hr0, dvd_rfl, h1⟩
      · exact ⟨g, hg𝔪, hg0, h1, dvd_rfl⟩
    obtain ⟨c₂, hc₂e, hc₂m, hc₂0⟩ := wcpa_dj_lr1k_ebnt_dms_root Ω W μ e he
    obtain ⟨c₁, hc₁e, hc₁m, hc₁0⟩ := wcpa_dj_lr1k_ebnt_dms_root Ω W c₂ 2 (by norm_num)
    have hc₂m' := hc₂m hμm
    have hc₂0' := hc₂0 hμ0
    have hc₁m' := hc₁m hc₂m'
    have hc₁0' := hc₁0 hc₂0'
    have h12 : c₁ ∣ c₂ := ⟨c₁, by rw [← hc₁e, sq]⟩
    have h21 : ¬ c₂ ∣ c₁ := by
      rintro ⟨s, hs⟩
      have h3 : c₁ * (c₁ * s) = c₁ * 1 := by
        rw [← mul_assoc, ← sq, hc₁e, ← hs, mul_one]
      exact hnonunit c₁ hc₁m' (IsUnit.of_mul_eq_one _ (mul_left_cancel₀ hc₁0' h3))
    have hc₂g : c₂ ∣ g := by
      rw [← hc₂e] at hμg
      exact (dvd_pow_self c₂ he.ne').trans hμg
    obtain ⟨t, ht⟩ := hμr
    have hiu := wcpa_dj_llsm_kpwul_inner_unit Ω W hdim hWt A K 𝔭 u v g hPD c₁ c₂ hc₁m' hc₁0'
      hc₂m' hc₂0' h12 h21 hc₂g b hb 0 (Submodule.zero_mem _)
    rw [add_zero] at hiu
    apply hiu
    have hS2mem : wcLlsInnerS₂ W A K u c₂ ∈ wcLlsInnerCR W A K u c₁ c₂ :=
      Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
    have hS2N : (⟨_, hS2mem⟩ : ↥(wcLlsInnerCR W A K u c₁ c₂)) ∈ wcLlsInnerCN W A K u c₁ c₂ :=
      Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    have heq : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) b =
        (⟨_, hS2mem⟩ : ↥(wcLlsInnerCR W A K u c₁ c₂)) ^ e *
          algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A t * z) := by
      apply Subtype.ext
      rw [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap,
        Subalgebra.coe_algebraMap]
      show algebraMap A K b = (algebraMap A K (algebraMap ↥W A c₂) / algebraMap A K u) ^ e *
        algebraMap A K (algebraMap ↥W A t * z)
      have h' := congrArg (algebraMap A K) h
      rw [ht, ← hc₂e] at h'
      simp only [map_mul, map_pow] at h' ⊢
      rw [div_pow, div_mul_eq_mul_div, eq_div_iff (pow_ne_zero _ hφu)]
      linear_combination h'
    rw [heq]
    exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_of_mem _ hS2N e he)

  have cell_clear : ∀ c₁ τ₀ : ↥W, c₁ * τ₀ = g → ∀ z : ↥(wcLlsInnerCR W A K v c₁ g),
      z ∉ wcLlsInnerCN W A K v c₁ g → ∃ (m : ℕ) (a₀ D : A), a₀ ∉ 𝔭 ∧
        algebraMap A K u ^ m * (z : K) =
          algebraMap A K (u ^ m * a₀ + algebraMap ↥W A τ₀ * D) := by
    intro c₁ τ₀ hc z hz
    have hc0 : c₁ ≠ 0 := by
      intro h0; rw [h0, zero_mul] at hc; exact hg0 hc.symm
    have hιc : algebraMap A K (algebraMap ↥W A c₁) ≠ 0 := hι c₁ hc0
    have hguv : algebraMap A K u * algebraMap A K v =
        algebraMap A K (algebraMap ↥W A c₁) * algebraMap A K (algebraMap ↥W A τ₀) := by
      rw [← hgval, ← hc, map_mul, map_mul]
    have hS1val : wcLlsInnerS₁ W A K v c₁ =
        algebraMap A K v / algebraMap A K (algebraMap ↥W A c₁) := rfl
    have hS2val : wcLlsInnerS₂ W A K v g =
        algebraMap A K (algebraMap ↥W A g) / algebraMap A K v := rfl
    have hi : algebraMap A K u * wcLlsInnerS₁ W A K v c₁ =
        algebraMap A K (algebraMap ↥W A τ₀) := by
      rw [hS1val, mul_div_assoc', div_eq_iff hιc]
      linear_combination hguv
    have hii : wcLlsInnerS₂ W A K v g = algebraMap A K u := by
      rw [hS2val, div_eq_iff hφv]
      exact hgval
    have hS1mem : wcLlsInnerS₁ W A K v c₁ ∈ wcLlsInnerCR W A K v c₁ g :=
      Algebra.subset_adjoin (Set.mem_insert _ _)
    have hS2mem : wcLlsInnerS₂ W A K v g ∈ wcLlsInnerCR W A K v c₁ g :=
      Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
    have hS1N : (⟨_, hS1mem⟩ : ↥(wcLlsInnerCR W A K v c₁ g)) ∈ wcLlsInnerCN W A K v c₁ g :=
      Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
    have hS2N : (⟨_, hS2mem⟩ : ↥(wcLlsInnerCR W A K v c₁ g)) ∈ wcLlsInnerCN W A K v c₁ g :=
      Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    have key : ∀ (y : K) (hy : y ∈ wcLlsInnerCR W A K v c₁ g), ∃ (m : ℕ) (a₀ D : A),
        algebraMap A K u ^ m * y = algebraMap A K (u ^ m * a₀ + algebraMap ↥W A τ₀ * D) ∧
        (⟨y, hy⟩ : ↥(wcLlsInnerCR W A K v c₁ g)) -
          algebraMap A ↥(wcLlsInnerCR W A K v c₁ g) a₀ ∈ wcLlsInnerCN W A K v c₁ g := by
      intro y hy
      induction hy using Algebra.adjoin_induction with
      | mem y hy' =>
        rcases hy' with hy' | hy'
        · subst hy'
          refine ⟨1, 0, 1, ?_, ?_⟩
          · simp only [pow_one, mul_zero, zero_add, mul_one]; exact hi
          · rw [map_zero, sub_zero]; exact hS1N
        · rw [Set.mem_singleton_iff] at hy'
          subst hy'
          refine ⟨0, u, 0, ?_, ?_⟩
          · simp only [pow_zero, one_mul, mul_zero, add_zero]; exact hii
          · convert Submodule.zero_mem (wcLlsInnerCN W A K v c₁ g) using 1
            rw [sub_eq_zero]
            exact Subtype.ext hii
      | algebraMap a =>
        refine ⟨0, a, 0, by simp, ?_⟩
        convert Submodule.zero_mem (wcLlsInnerCN W A K v c₁ g) using 1
        rw [sub_eq_zero]
        rfl
      | add y y' hy hy' ih ih' =>
        obtain ⟨m, a, D, h1, h2⟩ := ih
        obtain ⟨m', a', D', h1', h2'⟩ := ih'
        refine ⟨m + m', a + a', u ^ m' * D + u ^ m * D', ?_, ?_⟩
        · simp only [map_add, map_mul, map_pow] at h1 h1' ⊢
          rw [pow_add]
          linear_combination (algebraMap A K u ^ m') * h1 + (algebraMap A K u ^ m) * h1'
        · convert Ideal.add_mem _ h2 h2' using 1
          apply Subtype.ext
          simp only [Subalgebra.coe_sub, Subalgebra.coe_add, Subalgebra.coe_algebraMap, map_add]
          ring
      | mul y y' hy hy' ih ih' =>
        obtain ⟨m, a, D, h1, h2⟩ := ih
        obtain ⟨m', a', D', h1', h2'⟩ := ih'
        refine ⟨m + m', a * a', u ^ m * a * D' + u ^ m' * a' * D +
          algebraMap ↥W A τ₀ * D * D', ?_, ?_⟩
        · simp only [map_add, map_mul, map_pow] at h1 h1' ⊢
          rw [pow_add]
          linear_combination (algebraMap A K u ^ m' * y') * h1 +
            (algebraMap A K u ^ m * algebraMap A K a +
              algebraMap A K (algebraMap ↥W A τ₀) * algebraMap A K D) * h1'
        · convert Ideal.add_mem _ (Ideal.mul_mem_right (⟨y', hy'⟩ : ↥(wcLlsInnerCR W A K v c₁ g)) _ h2)
            (Ideal.mul_mem_left _ (algebraMap A ↥(wcLlsInnerCR W A K v c₁ g) a) h2') using 1
          apply Subtype.ext
          simp only [Subalgebra.coe_sub, Subalgebra.coe_add, Subalgebra.coe_mul,
            Subalgebra.coe_algebraMap, map_mul]
          ring
    have hmap : 𝔭.map (algebraMap A ↥(wcLlsInnerCR W A K v c₁ g)) ≤
        wcLlsInnerCN W A K v c₁ g := by
      rw [hp, Ideal.map_sup, Ideal.map_span, Ideal.map_map]
      apply sup_le
      · rw [Ideal.span_le]
        rintro _ ⟨a, ha, rfl⟩
        rcases ha with ha | ha
        · rw [ha]
          have e1 : algebraMap A ↥(wcLlsInnerCR W A K v c₁ g) u = ⟨_, hS2mem⟩ :=
            Subtype.ext hii.symm
          rw [e1]
          exact hS2N
        · rw [Set.mem_singleton_iff] at ha
          rw [ha]
          have e1 : algebraMap A ↥(wcLlsInnerCR W A K v c₁ g) v =
              algebraMap A ↥(wcLlsInnerCR W A K v c₁ g) (algebraMap ↥W A c₁) * ⟨_, hS1mem⟩ := by
            apply Subtype.ext
            rw [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, Subalgebra.coe_algebraMap]
            show algebraMap A K v = algebraMap A K (algebraMap ↥W A c₁) * wcLlsInnerS₁ W A K v c₁
            rw [hS1val]
            field_simp
          rw [e1]
          exact Ideal.mul_mem_left _ _ hS1N
      · exact le_sup_right
    obtain ⟨zv, hzv⟩ := z
    obtain ⟨m, a₀, D, h1, h2⟩ := key zv hzv
    refine ⟨m, a₀, D, ?_, h1⟩
    intro ha₀
    apply hz
    have h3 := Ideal.add_mem _ h2 (hmap (Ideal.mem_map_of_mem _ ha₀))
    rwa [sub_add_cancel] at h3

  have hPDs := wcpa_dj_llsm_kpwic_pd_swap W A 𝔭 u v g hPD
  have hφx : algebraMap A K x ≠ 0 := fun h => hx0 (hφinj (h.trans (map_zero _).symm))
  obtain ⟨w₁, w₂, j, τ, hF⟩ :=
    wcpa_dj_llsm_kpwu_hc_germ_factor Ω W hdim hWt A K 𝔭 v u g hPDs (algebraMap A K x) hφx
  obtain ⟨hw₁, hw₂, hτm, hτ0, hτg, hcell⟩ := hF
  obtain ⟨τ₀, hτ₀e, hτ₀m, hτ₀0⟩ := wcpa_dj_lr1k_ebnt_dms_root Ω W τ 2 (by norm_num)
  have hτ₀m' := hτ₀m hτm
  obtain ⟨t₀, ht₀⟩ := hτg
  obtain ⟨c₁, hc₁def⟩ : ∃ c : ↥W, c = τ₀ * t₀ := ⟨_, rfl⟩
  have hc : c₁ * τ₀ = g := by rw [hc₁def, ht₀, ← hτ₀e]; ring
  have hc₁0 : c₁ ≠ 0 := by
    intro h0; rw [h0, zero_mul] at hc; exact hg0 hc.symm
  have hc₁m : c₁ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [hc₁def]; exact Ideal.mul_mem_right _ _ hτ₀m'
  have h1g : c₁ ∣ g := ⟨τ₀, hc.symm⟩
  have hg1 : ¬ g ∣ c₁ := by
    rintro ⟨s, hs⟩
    have h3 : c₁ * (τ₀ * s) = c₁ * 1 := by rw [mul_one, ← mul_assoc, hc, ← hs]
    exact hnonunit τ₀ hτ₀m' (IsUnit.of_mul_eq_one _ (mul_left_cancel₀ hc₁0 h3))
  have hgτ : g ∣ τ * c₁ := ⟨τ₀, by rw [← hτ₀e, ← hc]; ring⟩
  obtain ⟨d, e, hd, he, hde⟩ := hcell c₁ g hc₁m hc₁0 hg𝔪 hg0 h1g hg1 dvd_rfl hgτ
  obtain ⟨md, a₀, D, ha₀, hd'⟩ := cell_clear c₁ τ₀ hc d hd
  obtain ⟨me, b₀, E, hb₀, he'⟩ := cell_clear c₁ τ₀ hc e he
  simp only [map_add, map_mul, map_pow] at hd' he'
  have hpow : ∀ n : ℕ, algebraMap A K u ^ n * algebraMap A K v ^ n =
      algebraMap A K (algebraMap ↥W A g) ^ n := fun n => by rw [← mul_pow, hgval]

  have club : ∃ (α β : ↥W) (D₁ K₁ : ℕ) (D' E' : A), α ≠ 0 ∧ β ≠ 0 ∧
      algebraMap ↥W A α * ((u ^ D₁ * a₀ + algebraMap ↥W A τ₀ * D') * x) =
        algebraMap ↥W A β * (u ^ K₁ * b₀ + algebraMap ↥W A τ₀ * E') := by
    rcases Int.eq_nat_or_neg j with ⟨n, hn | hn⟩
    · rw [hn, zpow_natCast] at hde
      refine ⟨w₂, w₁ * g ^ n, me + n + md, md + me, u ^ (me + n) * D, u ^ md * E, hw₂,
        mul_ne_zero hw₁ (pow_ne_zero _ hg0), ?_⟩
      apply hφinj
      simp only [map_add, map_mul, map_pow]
      linear_combination (-(algebraMap A K (algebraMap ↥W A w₂) * algebraMap A K u ^ (me + n) *
          algebraMap A K x)) * hd' + algebraMap A K u ^ (me + n + md) * hde +
        (algebraMap A K (algebraMap ↥W A w₁) * algebraMap A K (algebraMap ↥W A g) ^ n *
          algebraMap A K u ^ md) * he' +
        (algebraMap A K (algebraMap ↥W A w₁) * algebraMap A K u ^ (me + md) * (e : K)) * hpow n
    · rw [hn, zpow_neg, zpow_natCast] at hde
      have hde2 : (d : K) * (algebraMap A K (algebraMap ↥W A w₂) * algebraMap A K x) *
          algebraMap A K v ^ n = algebraMap A K (algebraMap ↥W A w₁) * (e : K) := by
        rw [hde]; field_simp
      refine ⟨w₂ * g ^ n, w₁, me + md, n + md + me, u ^ me * D, u ^ (n + md) * E,
        mul_ne_zero hw₂ (pow_ne_zero _ hg0), hw₁, ?_⟩
      apply hφinj
      simp only [map_add, map_mul, map_pow]
      linear_combination (-(algebraMap A K (algebraMap ↥W A w₂) *
          algebraMap A K (algebraMap ↥W A g) ^ n * algebraMap A K u ^ me * algebraMap A K x)) * hd' -
        (algebraMap A K u ^ (me + md) * (d : K) * algebraMap A K (algebraMap ↥W A w₂) *
          algebraMap A K x) * hpow n +
        algebraMap A K u ^ (n + me + md) * hde2 +
        (algebraMap A K (algebraMap ↥W A w₁) * algebraMap A K u ^ (n + md)) * he'

  obtain ⟨α, β, D₁, K₁, D', E', hα, hβ, hcl⟩ := club
  have spade : ∃ ρ : ↥W, ρ ≠ 0 ∧ (u ^ D₁ * a₀ + algebraMap ↥W A τ₀ * D') * x =
      algebraMap ↥W A ρ * (u ^ K₁ * b₀ + algebraMap ↥W A τ₀ * E') := by
    rcases ValuationRing.dvd_total α β with ⟨ρ, hρ⟩ | ⟨y, hy⟩
    · refine ⟨ρ, ?_, ?_⟩
      · intro h0; rw [h0, mul_zero] at hρ; exact hβ hρ
      · apply mul_left_cancel₀ (haW α hα)
        rw [hcl, hρ, map_mul, mul_assoc]
    · have h2 : algebraMap ↥W A y * ((u ^ D₁ * a₀ + algebraMap ↥W A τ₀ * D') * x) =
          u ^ K₁ * b₀ + algebraMap ↥W A τ₀ * E' := by
        apply mul_left_cancel₀ (haW β hβ)
        rw [← hcl, hy, map_mul, mul_assoc]
      by_cases hyu : IsUnit y
      · obtain ⟨y', hy'⟩ := hyu.exists_right_inv
        refine ⟨y', ?_, ?_⟩
        · intro h0; rw [h0, mul_zero] at hy'; exact zero_ne_one hy'
        · rw [← h2, ← mul_assoc, ← map_mul, mul_comm y' y, hy', map_one, one_mul]
      · exfalso
        have hym : y ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal y).mpr hyu
        rcases ValuationRing.dvd_total y τ₀ with ⟨t, ht⟩ | ⟨t, ht⟩
        · have hτ' : algebraMap ↥W A τ₀ = algebraMap ↥W A y * algebraMap ↥W A t := by
            rw [ht, map_mul]
          exact pow_unit b₀ hb₀ K₁ y
            ((u ^ D₁ * a₀ + algebraMap ↥W A τ₀ * D') * x - algebraMap ↥W A t * E') hym
            (by linear_combination (-1 : A) * h2 - E' * hτ')
        · have hy' : algebraMap ↥W A y = algebraMap ↥W A τ₀ * algebraMap ↥W A t := by
            rw [ht, map_mul]
          exact pow_unit b₀ hb₀ K₁ τ₀
            (algebraMap ↥W A t * ((u ^ D₁ * a₀ + algebraMap ↥W A τ₀ * D') * x) - E') hτ₀m'
            (by linear_combination (-1 : A) * h2 +
              ((u ^ D₁ * a₀ + algebraMap ↥W A τ₀ * D') * x) * hy')

  obtain ⟨ρ, hρ0, hsp⟩ := spade
  obtain ⟨N, c, hNc⟩ := arch τ₀ ρ hτ₀m' hρ0
  obtain ⟨G, hG⟩ := geom (u ^ D₁ * a₀) (algebraMap ↥W A τ₀) D' x (u ^ K₁ * b₀) E'
    (algebraMap ↥W A ρ) (algebraMap ↥W A c) N hsp (by rw [← map_pow, hNc, map_mul])
  refine ⟨D₁ * (N + 1), K₁ + D₁ * N, a₀ ^ (N + 1), b₀ * a₀ ^ N, 0, G, ρ, τ₀, ?_, ?_, hρ0,
    hτ₀m', ?_⟩
  · exact fun h => ha₀ (hprime.mem_of_pow_mem _ h)
  · exact hprime.mul_notMem hb₀ (fun h => ha₀ (hprime.mem_of_pow_mem _ h))
  · rw [show u ^ (D₁ * (N + 1)) = (u ^ D₁) ^ (N + 1) from pow_mul u D₁ (N + 1),
      show u ^ (K₁ + D₁ * N) = u ^ K₁ * (u ^ D₁) ^ N by rw [pow_add, pow_mul]]
    linear_combination hG

theorem wcpa_dj_llsm_kpwulb_nf_bound : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ (F : K) (p q : A), q ∉ 𝔭 → F * algebraMap A K q = algebraMap A K p →
    ∀ (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A),
      (lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀ ∉ 𝔭 ∧ ε₁ ∉ 𝔭 ∧
        F * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) *
          algebraMap A K (algebraMap ↥W A lam₂) =
        algebraMap A K (algebraMap ↥W A lam₁) *
          algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀)) →
      lam₂ ∣ lam₁ ∧ (p ∈ 𝔭 → lam₁ ∣ lam₂ → n < k) :=
by
  intro Ω _ _ W _hW _hWt A _ _ _ K _ _ _ 𝔭 u v g hPD F p q hq hFq lam₁ lam₂ w n k
    ε₀ ε₁ r₀ r₁ g₀ g₁ hNF
  classical
  obtain ⟨hl1, hl2, hw, he0, he1, hE⟩ := hNF
  have hPD' := hPD
  obtain ⟨hFT, hNZ, -, hmax, h𝔪, hgm, hg0, huv, h𝔭eq, -⟩ := hPD'
  haveI := hNZ
  have h𝔪𝔭 : ∀ x ∈ IsLocalRing.maximalIdeal ↥W, algebraMap ↥W A x ∈ 𝔭 := fun x hx =>
    h𝔪 (Ideal.mem_map_of_mem _ hx)

  have EA : p * (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) * algebraMap ↥W A lam₂ =
      algebraMap ↥W A lam₁ * (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀) * q := by
    apply IsFractionRing.injective A K
    generalize u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁ = B₁ at hE ⊢
    generalize u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀ = B₀ at hE ⊢
    generalize algebraMap ↥W A lam₂ = L₂ at hE ⊢
    generalize algebraMap ↥W A lam₁ = L₁ at hE ⊢
    simp only [map_mul]
    linear_combination (-(algebraMap A K B₁ * algebraMap A K L₂)) * hFq + algebraMap A K q * hE

  have hsingle : ∀ x : A, x ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      ∃ (m : ↥W) (b : A), m ∈ IsLocalRing.maximalIdeal ↥W ∧ x = algebraMap ↥W A m * b := by
    intro x hx
    change x ∈ Submodule.span A (⇑(algebraMap ↥W A) '' ↑(IsLocalRing.maximalIdeal ↥W)) at hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨m, hm, rfl⟩ := hx
      exact ⟨m, 1, hm, (mul_one _).symm⟩
    | zero => exact ⟨0, 0, Ideal.zero_mem _, (mul_zero _).symm⟩
    | add x y _ _ hx hy =>
      obtain ⟨m₁, b₁, hm₁, rfl⟩ := hx
      obtain ⟨m₂, b₂, hm₂, rfl⟩ := hy
      rcases ValuationRing.dvd_total m₁ m₂ with ⟨c, rfl⟩ | ⟨c, rfl⟩
      · exact ⟨m₁, b₁ + algebraMap ↥W A c * b₂, hm₁, by rw [map_mul]; ring⟩
      · exact ⟨m₂, algebraMap ↥W A c * b₁ + b₂, hm₂, by rw [map_mul]; ring⟩
    | smul a x _ hx =>
      obtain ⟨m, b, hm, rfl⟩ := hx
      exact ⟨m, a * b, hm, by rw [smul_eq_mul]; ring⟩

  have hmin2 : ∀ a b : ↥W, a ∈ IsLocalRing.maximalIdeal ↥W → a ≠ 0 →
      b ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ z : ↥W, z ∈ IsLocalRing.maximalIdeal ↥W ∧ z ≠ 0 ∧ z ∣ a ∧ z ∣ b := by
    intro a b ha ha0 hb
    by_cases hb0 : b = 0
    · exact ⟨a, ha, ha0, dvd_rfl, by rw [hb0]; exact dvd_zero a⟩
    · rcases ValuationRing.dvd_total a b with h | h
      · exact ⟨a, ha, ha0, dvd_rfl, h⟩
      · exact ⟨b, hb, hb0, h, dvd_rfl⟩
  have hpick : ∀ x y : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → y ∈ IsLocalRing.maximalIdeal ↥W →
      ∀ M : ℕ, 0 < M → ∃ t : ↥W, t ∈ IsLocalRing.maximalIdeal ↥W ∧ t ≠ 0 ∧
        t ^ M ∣ g ∧ t ^ M ∣ x ∧ t ^ M ∣ y := by
    intro x y hx hy M hM
    obtain ⟨z₁, hz₁m, hz₁0, hz₁g, hz₁x⟩ := hmin2 g x hgm hg0 hx
    obtain ⟨z, hzm, hz0, hzz₁, hzy⟩ := hmin2 z₁ y hz₁m hz₁0 hy
    obtain ⟨t, htM, htm, ht0⟩ := wcpa_dj_lr1k_ebnt_dms_root Ω W z M hM
    refine ⟨t, htm hzm, ht0 hz0, ?_, ?_, ?_⟩ <;> rw [htM]
    · exact dvd_trans hzz₁ hz₁g
    · exact dvd_trans hzz₁ hz₁x
    · exact hzy

  have htest : ∀ t : ↥W, t ∈ IsLocalRing.maximalIdeal ↥W → t ≠ 0 →
      t ^ (n + k + 2) ∣ g → t ^ (n + k + 2) ∣ w →
      ∃ (E : Type u) (_ : Field E) (V : ValuationSubring E) (ψ : A →+* ↥V),
        (∀ a : A, IsUnit (ψ a) ↔ a ∉ 𝔭) ∧ (∀ γ : ↥W, γ ≠ 0 → ψ (algebraMap ↥W A γ) ≠ 0) ∧
        ψ (algebraMap ↥W A t) ∈ IsLocalRing.maximalIdeal ↥V ∧
        (∀ (j : ℕ) (ε r g' : A), j ≤ n + k → ε ∉ 𝔭 → ∃ η : ↥V, IsUnit η ∧
          ψ (u ^ j * ε + v * r + algebraMap ↥W A w * g') = ψ (algebraMap ↥W A t) ^ j * η) ∧
        (∀ a₁ a₂ : A, ∃ π : ↥V, ψ (a₁ * u + a₂ * v) = ψ (algebraMap ↥W A t) * π) := by
    intro t ht ht0 htg htw
    obtain ⟨g'', hg''⟩ := htg
    obtain ⟨w'', hw''⟩ := htw
    have hμ₁m : t ^ (n + k + 1) * g'' ∈ IsLocalRing.maximalIdeal ↥W :=
      Ideal.mul_mem_right _ _ (Ideal.pow_mem_of_mem _ ht _ (Nat.succ_pos _))
    have hprod : t * (t ^ (n + k + 1) * g'') = g := by rw [hg'']; ring
    obtain ⟨Q, _, φQ, hhens, -⟩ := wcpa_dj_llsm_kptf_hens_descent A 𝔭 hmax.isPrime
    have hunit : ∀ b : A, IsUnit (φQ b) ↔ b ∉ 𝔭 := hhens.2.1
    have hres := wcpa_dj_llsm_kptf_residue_trivial Ω W A 𝔭 hFT hmax h𝔪
    obtain ⟨fN, hpres, hfu, hfv⟩ :=
      wcpa_dj_llsm_kptf_hens_chart Ω W A 𝔭 u v g hPD hres Q φQ hhens
    obtain ⟨E, _, V, kk, hloc, hnz, -, ⟨e₀, e₁, he₀, he₁, hk0, hk1⟩, -⟩ :=
      wcpa_dj_lr1k_ebnt_dms_gauss_point Ω W Q (φQ.comp (algebraMap ↥W A)) g fN hpres
        t (t ^ (n + k + 1) * g'') ht hμ₁m hprod
    haveI := hloc
    have hU : ∀ a : A, IsUnit (kk (φQ a)) ↔ a ∉ 𝔭 := by
      intro a
      constructor
      · intro h; exact (hunit a).mp (isUnit_of_map_unit kk _ h)
      · intro h; exact ((hunit a).mpr h).map kk
    have hmaxV : ∀ b ∈ 𝔭, kk (φQ b) ∈ IsLocalRing.maximalIdeal ↥V := by
      intro b hb
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      exact ((hU b).mp hu) hb
    have hTm : kk (φQ (algebraMap ↥W A t)) ∈ IsLocalRing.maximalIdeal ↥V := hmaxV _ (h𝔪𝔭 t ht)
    have hk0' : kk (φQ u) = e₀ * kk (φQ (algebraMap ↥W A t)) := by
      rw [← hfu, hk0, RingHom.comp_apply]
    have hk1' : kk (φQ v) = e₁ * (kk (φQ (algebraMap ↥W A t)) ^ (n + k + 1) *
        kk (φQ (algebraMap ↥W A g''))) := by
      rw [← hfv, hk1]
      simp only [RingHom.comp_apply, map_mul, map_pow]
    have hT4 : ∀ a b : ↥V, IsUnit a → b ∈ IsLocalRing.maximalIdeal ↥V → IsUnit (a + b) := by
      intro a b ha hb
      by_contra h
      have h1 : a + b ∈ IsLocalRing.maximalIdeal ↥V := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact h
      have h2 := Ideal.sub_mem _ h1 hb
      rw [add_sub_cancel_right] at h2
      exact (IsLocalRing.notMem_maximalIdeal.mpr ha) h2
    refine ⟨E, inferInstance, V, kk.comp φQ, hU, fun γ hγ => hnz γ hγ, hTm, ?_, ?_⟩
    · intro j ε r g' hj hε
      obtain ⟨c, hc⟩ := Nat.exists_eq_add_of_le hj
      refine ⟨kk (φQ ε) * e₀ ^ j + kk (φQ (algebraMap ↥W A t)) *
          (e₁ * (kk (φQ (algebraMap ↥W A t)) ^ c * kk (φQ (algebraMap ↥W A g''))) * kk (φQ r) +
            kk (φQ (algebraMap ↥W A t)) ^ (c + 1) * kk (φQ (algebraMap ↥W A w'')) * kk (φQ g')),
          ?_, ?_⟩
      · exact hT4 _ _ (((hU ε).mpr hε).mul (he₀.pow j)) (Ideal.mul_mem_right _ _ hTm)
      · show kk (φQ (u ^ j * ε + v * r + algebraMap ↥W A w * g')) =
          kk (φQ (algebraMap ↥W A t)) ^ j * _
        rw [hw'']
        simp only [map_add, map_mul, map_pow]
        rw [hk0', hk1', hc]
        ring
    · intro a₁ a₂
      refine ⟨kk (φQ a₁) * e₀ + kk (φQ a₂) * e₁ * kk (φQ (algebraMap ↥W A t)) ^ (n + k) *
        kk (φQ (algebraMap ↥W A g'')), ?_⟩
      show kk (φQ (a₁ * u + a₂ * v)) = kk (φQ (algebraMap ↥W A t)) * _
      simp only [map_add, map_mul]
      rw [hk0', hk1']
      ring

  have P1 : lam₂ ∣ lam₁ := by
    by_contra hnd
    obtain ⟨y, hy⟩ : lam₁ ∣ lam₂ := (ValuationRing.dvd_total lam₁ lam₂).resolve_right hnd
    have hym : y ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hyu
      apply hnd
      exact ⟨↑hyu.unit⁻¹, by rw [hy, mul_assoc, IsUnit.mul_val_inv, mul_one]⟩
    obtain ⟨t, ht, ht0, htg, htw, hty⟩ := hpick w y hw hym (n + k + 2) (by omega)
    obtain ⟨E, _, V, ψ, hU, hnz, hTm, hbr, -⟩ := htest t ht ht0 htg htw
    obtain ⟨η₁, hη₁, hB₁⟩ := hbr n ε₁ r₁ g₁ (by omega) he1
    obtain ⟨η₀, hη₀, hB₀⟩ := hbr k ε₀ r₀ g₀ (by omega) he0
    obtain ⟨y', hy'⟩ := hty
    have h : ψ p * ψ (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) * ψ (algebraMap ↥W A lam₂) =
        ψ (algebraMap ↥W A lam₁) * ψ (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀) * ψ q := by
      rw [← map_mul, ← map_mul, ← map_mul, ← map_mul, EA]
    have hL2 : ψ (algebraMap ↥W A lam₂) = ψ (algebraMap ↥W A lam₁) *
        (ψ (algebraMap ↥W A t) ^ (n + k + 2) * ψ (algebraMap ↥W A y')) := by
      rw [hy, hy']
      simp only [map_mul, map_pow]
    rw [hB₁, hB₀, hL2] at h
    have hc0 : ψ (algebraMap ↥W A t) ^ k * ψ (algebraMap ↥W A lam₁) ≠ 0 :=
      mul_ne_zero (pow_ne_zero _ (hnz t ht0)) (hnz lam₁ hl1)
    have hX : ψ (algebraMap ↥W A t) * (ψ p * η₁ * ψ (algebraMap ↥W A y') *
        ψ (algebraMap ↥W A t) ^ (2 * n + 1)) = η₀ * ψ q := by
      apply mul_left_cancel₀ hc0
      linear_combination h
    have hmem : ψ (algebraMap ↥W A t) * (ψ p * η₁ * ψ (algebraMap ↥W A y') *
        ψ (algebraMap ↥W A t) ^ (2 * n + 1)) ∈ IsLocalRing.maximalIdeal ↥V :=
      Ideal.mul_mem_right _ _ hTm
    rw [hX] at hmem
    exact (IsLocalRing.notMem_maximalIdeal.mpr (hη₀.mul ((hU q).mpr hq))) hmem

  have P2 : p ∈ 𝔭 → lam₁ ∣ lam₂ → n < k := by
    rintro hp ⟨y, hy⟩
    by_contra hkn
    push_neg at hkn
    obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le hkn
    rw [h𝔭eq] at hp
    obtain ⟨y₁, hy₁, z, hz, hyz⟩ := Submodule.mem_sup.mp hp
    obtain ⟨a₁, a₂, ha⟩ := Ideal.mem_span_pair.mp hy₁
    obtain ⟨m, b, hm, hzb⟩ := hsingle z hz
    obtain ⟨t, ht, ht0, htg, htw, htm⟩ := hpick w m hw hm (n + k + 2) (by omega)
    obtain ⟨E, _, V, ψ, hU, hnz, hTm, hbr, hspan⟩ := htest t ht ht0 htg htw
    obtain ⟨η₁, hη₁, hB₁⟩ := hbr n ε₁ r₁ g₁ (by omega) he1
    obtain ⟨η₀, hη₀, hB₀⟩ := hbr k ε₀ r₀ g₀ (by omega) he0
    obtain ⟨π₀, hπ₀⟩ := hspan a₁ a₂
    obtain ⟨m', hm'⟩ := htm
    obtain ⟨pp, hpp⟩ : ∃ pp : ↥V, ψ p = ψ (algebraMap ↥W A t) * pp := by
      refine ⟨π₀ + ψ (algebraMap ↥W A t) ^ (n + k + 1) * ψ (algebraMap ↥W A m') * ψ b, ?_⟩
      rw [← hyz, ← ha, hzb, hm', map_add, hπ₀]
      simp only [map_mul, map_pow]
      ring
    have h : ψ p * ψ (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) * ψ (algebraMap ↥W A lam₂) =
        ψ (algebraMap ↥W A lam₁) * ψ (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀) * ψ q := by
      rw [← map_mul, ← map_mul, ← map_mul, ← map_mul, EA]
    have hL2 : ψ (algebraMap ↥W A lam₂) = ψ (algebraMap ↥W A lam₁) * ψ (algebraMap ↥W A y) := by
      rw [hy]
      simp only [map_mul]
    rw [hB₁, hB₀, hL2, hpp, hd] at h
    have hc0 : ψ (algebraMap ↥W A t) ^ k * ψ (algebraMap ↥W A lam₁) ≠ 0 :=
      mul_ne_zero (pow_ne_zero _ (hnz t ht0)) (hnz lam₁ hl1)
    have hX : ψ (algebraMap ↥W A t) * (ψ (algebraMap ↥W A t) ^ d * pp * η₁ *
        ψ (algebraMap ↥W A y)) = η₀ * ψ q := by
      apply mul_left_cancel₀ hc0
      linear_combination h
    have hmem : ψ (algebraMap ↥W A t) * (ψ (algebraMap ↥W A t) ^ d * pp * η₁ *
        ψ (algebraMap ↥W A y)) ∈ IsLocalRing.maximalIdeal ↥V :=
      Ideal.mul_mem_right _ _ hTm
    rw [hX] at hmem
    exact (IsLocalRing.notMem_maximalIdeal.mpr (hη₀.mul ((hU q).mpr hq))) hmem
  exact ⟨P1, P2⟩

theorem wcpa_dj_llsm_kpwulb_kummer_max : ∀ (K : Type u) [Field K] (O : ValuationSubring K) (ℓ : ℕ), ℓ.Prime → ((ℓ : ℕ) : K) ≠ 0 → ∀ c₀ : K, c₀ ∈ O → c₀ ^ (ℓ - 1) = ((ℓ : ℕ) : K) → (∀ x : K, x ≠ 0 → ∃ y : K, y ≠ 0 ∧ x / y ^ ℓ ∈ O ∧ y ^ ℓ / x ∈ O) → (∀ (L' : Type u) [Field L'] [Algebra K L'] [FiniteDimensional K L'] [Algebra.IsSeparable K L'], letI : Algebra ↥O L' := ((algebraMap K L').comp O.subtype).toAlgebra; Module.Finite ↥O ↥(integralClosure ↥O L')) → ∀ f : K, f ≠ 0 → f ∈ O → f⁻¹ ∈ O → ∃ h : K, h ≠ 0 ∧ ((f / h ^ ℓ - 1) / c₀ ^ ℓ ∈ O ∨ ∀ h' : K, h' ≠ 0 → f / h' ^ ℓ - 1 ≠ 0 → (f / h ^ ℓ - 1) / (f / h' ^ ℓ - 1) ∈ O) :=
by

  have s1 : ∀ (K : Type u) [Field K] (ℓ : ℕ), ℓ.Prime → ((ℓ : ℕ) : K) ≠ 0 → ∀ f : K, f ≠ 0 → (∀ b : K, b ^ ℓ ≠ f) → ∃ (L' : Type u) (_ : Field L') (_ : Algebra K L') (_ : FiniteDimensional K L') (_ : Algebra.IsSeparable K L') (θ : L'), θ ∉ Set.range (algebraMap K L') ∧ θ ^ ℓ = algebraMap K L' f := by
    intro K _ ℓ hℓ hℓK f hf hnp
    obtain ⟨θ₀, hθ₀⟩ := IsAlgClosed.exists_pow_nat_eq (algebraMap K (AlgebraicClosure K) f) hℓ.pos
    set P : Polynomial K := Polynomial.X ^ ℓ - Polynomial.C f with hP
    have hPm : P.Monic := Polynomial.monic_X_pow_sub_C f hℓ.ne_zero
    have hPα : Polynomial.aeval θ₀ P = 0 := by
      simp only [hP, map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, hθ₀, sub_self]
    have hint : IsIntegral K θ₀ := ⟨P, hPm, hPα⟩
    have hsepP : P.Separable := Polynomial.separable_X_pow_sub_C f hℓK hf
    have hsep : IsSeparable K θ₀ := hsepP.of_dvd (minpoly.dvd K θ₀ hPα)
    haveI : FiniteDimensional K (IntermediateField.adjoin K {θ₀}) :=
      IntermediateField.adjoin.finiteDimensional hint
    haveI : Algebra.IsSeparable K (IntermediateField.adjoin K {θ₀}) :=
      (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable K (AlgebraicClosure K)).mpr hsep
    refine ⟨IntermediateField.adjoin K {θ₀}, inferInstance, inferInstance, inferInstance,
      inferInstance, IntermediateField.AdjoinSimple.gen K θ₀, ?_, ?_⟩
    · rintro ⟨x, hx⟩
      apply hnp x
      have h1 : algebraMap K (AlgebraicClosure K) x = θ₀ := by
        simpa using congrArg Subtype.val hx
      apply (algebraMap K (AlgebraicClosure K)).injective
      rw [map_pow, h1, hθ₀]
    · apply Subtype.val_injective
      simp [hθ₀]

  have s2 : ∀ (K : Type u) [Field K] (O : ValuationSubring K) (L' : Type u) [Field L'] [Algebra K L'], letI : Algebra ↥O L' := ((algebraMap K L').comp O.subtype).toAlgebra; ∀ (ℓ : ℕ), ℓ.Prime → ∀ c₀ : K, c₀ ∈ O → c₀ ^ (ℓ - 1) = ((ℓ : ℕ) : K) → ∀ (β : L') (F z : K), (1 + β) ^ ℓ = 1 + algebraMap K L' F → z ≠ 0 → c₀ / z ∈ O → (IsIntegral ↥O (algebraMap K L' z⁻¹ * β) ↔ F / z ^ ℓ ∈ O) := by
    intro K _ O L' _ _
    letI : Algebra ↥O L' := ((algebraMap K L').comp O.subtype).toAlgebra
    intro ℓ hℓ c₀ hc₀ hc₀pow β F z hβ hz hc₀z
    haveI : IsScalarTower O K L' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    obtain ⟨n, rfl⟩ : ∃ n, ℓ = n + 2 := ⟨ℓ - 2, by have := hℓ.two_le; omega⟩
    have hc' : ((n + 2 : ℕ) : K) = c₀ ^ (n + 1) := by
      rw [← hc₀pow]
      exact congrArg (c₀ ^ ·) (by omega)
    obtain ⟨b, hb⟩ : ∃ b : ℕ → K, ∀ j, b j = ((n + 2).choose (j + 1) : K) * z⁻¹ ^ (n + 1 - j) :=
      ⟨_, fun _ => rfl⟩
    have hbO : ∀ j, b j ∈ O := by
      intro j
      by_cases hj : j < n + 1
      · obtain ⟨k, hk⟩ := hℓ.dvd_choose_self (Nat.succ_ne_zero j) (by omega)
        have hsplit : c₀ ^ (n + 1) = c₀ ^ j * c₀ ^ (n + 1 - j) := by
          rw [← pow_add]; congr 1; omega
        have e : b j = (k : K) * c₀ ^ j * (c₀ / z) ^ (n + 1 - j) := by
          rw [hb, hk, Nat.cast_mul, hc', hsplit, div_eq_mul_inv, mul_pow]
          ring
        rw [e]
        exact mul_mem (mul_mem (natCast_mem O k) (pow_mem hc₀ j)) (pow_mem hc₀z _)
      · have h0 : n + 1 - j = 0 := by omega
        rw [hb, h0, pow_zero, mul_one]
        exact natCast_mem O _
    have hexp : algebraMap K L' F = β ^ (n + 2) +
        ∑ j ∈ Finset.range (n + 1), β ^ (j + 1) * ((n + 2).choose (j + 1) : L') := by
      have h := hβ
      rw [add_comm, add_pow, Finset.sum_range_succ, Finset.sum_range_succ'] at h
      simp only [one_pow, mul_one, pow_zero, Nat.choose_zero_right, Nat.choose_self,
        Nat.cast_one] at h
      linear_combination -h
    have hI1 : algebraMap K L' (F / z ^ (n + 2)) = (algebraMap K L' z⁻¹ * β) ^ (n + 2) +
        ∑ j ∈ Finset.range (n + 1), algebraMap K L' (b j) * (algebraMap K L' z⁻¹ * β) ^ (j + 1) := by
      have e1 : algebraMap K L' (F / z ^ (n + 2)) = algebraMap K L' z⁻¹ ^ (n + 2) * algebraMap K L' F := by
        rw [div_eq_mul_inv, ← inv_pow, map_mul, map_pow, mul_comm]
      rw [e1, hexp, mul_add, Finset.mul_sum, mul_pow]
      congr 1
      refine Finset.sum_congr rfl (fun j hj => ?_)
      rw [Finset.mem_range] at hj
      have hp : algebraMap K L' z⁻¹ ^ (n + 2) =
          algebraMap K L' z⁻¹ ^ (n + 1 - j) * algebraMap K L' z⁻¹ ^ (j + 1) := by
        rw [← pow_add]; congr 1; omega
      rw [hb, map_mul, map_pow, map_natCast, hp, mul_pow]
      ring
    have hιO : ∀ (a : K) (ha : a ∈ O), algebraMap O L' ⟨a, ha⟩ = algebraMap K L' a :=
      fun _ _ => rfl
    constructor
    · intro hy
      have h1 : IsIntegral O (algebraMap K L' (F / z ^ (n + 2))) := by
        rw [hI1]
        refine (hy.pow _).add (IsIntegral.sum _ (fun j _ => ?_))
        rw [← hιO (b j) (hbO j)]
        exact isIntegral_algebraMap.mul (hy.pow _)
      have h2 : IsIntegral O (F / z ^ (n + 2)) := isIntegral_algebraMap_iff.mp h1
      obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp h2
      rw [← hy]
      exact y.2
    · intro hbF
      refine ⟨Polynomial.X ^ (n + 2) - (Polynomial.C (⟨F / z ^ (n + 2), hbF⟩ : O) -
        ∑ j ∈ Finset.range (n + 1), Polynomial.C (⟨b j, hbO j⟩ : O) * Polynomial.X ^ (j + 1)), ?_, ?_⟩
      · apply Polynomial.monic_X_pow_sub
        rw [← Polynomial.mem_degreeLT]
        refine Submodule.sub_mem _ ?_ (Submodule.sum_mem _ (fun j hj => ?_))
        · rw [Polynomial.mem_degreeLT]
          exact lt_of_le_of_lt Polynomial.degree_C_le (by exact_mod_cast (by omega : 0 < n + 2))
        · rw [Polynomial.mem_degreeLT]
          rw [Finset.mem_range] at hj
          exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_pow_le _ _)
            (by exact_mod_cast (by omega : j + 1 < n + 2))
      · rw [← Polynomial.aeval_def]
        simp only [map_sub, map_sum, map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, hιO]
        rw [hI1]
        ring

  have s3c : ∀ (K : Type u) [Field K] (O : ValuationSubring K) (V : Type u) [AddCommGroup V] [Module K V] (r : ℕ) (g : Fin r → V) (v : V), v ≠ 0 → (∃ c : Fin r → K, v = ∑ i, c i • g i) → ∃ z : K, z ≠ 0 ∧ (∃ c : Fin r → K, (∀ i, c i ∈ O) ∧ z⁻¹ • v = ∑ i, c i • g i) ∧ ∀ z' : K, z' ≠ 0 → (∃ c : Fin r → K, (∀ i, c i ∈ O) ∧ z'⁻¹ • v = ∑ i, c i • g i) → z / z' ∈ O := by
    intro K _ O V _ _ r
    have hdiv : ∀ a b : K, b ≠ 0 → O.valuation a ≤ O.valuation b → a / b ∈ O := by
      intro a b hb hab
      rw [← O.valuation_le_one_iff, map_div₀]
      exact div_le_one_of_le₀ hab zero_le'
    have hmax : ∀ {n : ℕ} (c : Fin n → K), (∃ i, c i ≠ 0) → ∃ i₀, c i₀ ≠ 0 ∧ ∀ i, c i / c i₀ ∈ O := by
      intro n c ⟨i₁, hi₁⟩
      obtain ⟨i₀, -, hi₀⟩ := Finset.exists_max_image Finset.univ (fun i => O.valuation (c i))
        ⟨i₁, Finset.mem_univ _⟩
      have h0 : c i₀ ≠ 0 := by
        intro h
        apply hi₁
        have := hi₀ i₁ (Finset.mem_univ _)
        rw [h, map_zero, le_zero_iff, Valuation.zero_iff] at this
        exact this
      exact ⟨i₀, h0, fun i => hdiv _ _ h0 (hi₀ i (Finset.mem_univ _))⟩
    induction r with
    | zero =>
      intro g v hv ⟨c, hc⟩
      exact absurd (by simpa using hc) hv
    | succ r ih =>
      intro g v hv hspan
      by_cases hli : LinearIndependent K g
      · obtain ⟨c, hc⟩ := hspan
        have hne : ∃ i, c i ≠ 0 := by
          by_contra h
          push_neg at h
          apply hv
          rw [hc]
          simp [h]
        obtain ⟨i₀, h0, hci⟩ := hmax c hne
        refine ⟨c i₀, h0, ⟨fun i => c i / c i₀, hci, ?_⟩, ?_⟩
        · rw [hc, Finset.smul_sum]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [smul_smul]
          simp only [div_eq_inv_mul]
        · rintro z' hz' ⟨d, hd, hdv⟩
          have hrel : ∑ i, (z' * d i - c i) • g i = 0 := by
            simp only [sub_smul, Finset.sum_sub_distrib, mul_smul]
            rw [← Finset.smul_sum, ← hdv, ← hc, smul_smul, mul_inv_cancel₀ hz', one_smul, sub_self]
          have := Fintype.linearIndependent_iff.mp hli _ hrel i₀
          have hc' : c i₀ = z' * d i₀ := (sub_eq_zero.mp this).symm
          rw [hc', mul_div_cancel_left₀ _ hz']
          exact hd i₀
      · rw [Fintype.linearIndependent_iff] at hli
        push_neg at hli
        obtain ⟨a, ha, hne⟩ := hli
        obtain ⟨j, hj0, haj⟩ := hmax a hne
        set ρ : Fin (r+1) → K := fun i => a i / a j with hρ
        have hρO : ∀ i, ρ i ∈ O := haj
        have hρj : ρ j = 1 := div_self hj0
        have hρrel : ∑ i, ρ i • g i = 0 := by
          have : ∑ i, ρ i • g i = (a j)⁻¹ • ∑ i, a i • g i := by
            rw [Finset.smul_sum]
            refine Finset.sum_congr rfl (fun i _ => ?_)
            rw [smul_smul, hρ]
            simp only [div_eq_inv_mul]
          rw [this, ha, smul_zero]
        set g' : Fin r → V := fun i' => g (j.succAbove i') with hg'
        have hgj : g j = -∑ i', ρ (j.succAbove i') • g' i' := by
          rw [Fin.sum_univ_succAbove _ j, hρj, one_smul] at hρrel
          exact eq_neg_of_add_eq_zero_left hρrel
        have key : ∀ (S : Subring K), (∀ i, ρ i ∈ S) → ∀ x : V,
            (∃ c : Fin (r+1) → K, (∀ i, c i ∈ S) ∧ x = ∑ i, c i • g i) ↔
            (∃ c : Fin r → K, (∀ i, c i ∈ S) ∧ x = ∑ i, c i • g' i) := by
          intro S hS x
          constructor
          · rintro ⟨c, hcS, hx⟩
            refine ⟨fun i' => c (j.succAbove i') - c j * ρ (j.succAbove i'),
              fun i' => S.sub_mem (hcS _) (S.mul_mem (hcS _) (hS _)), ?_⟩
            rw [hx, Fin.sum_univ_succAbove _ j, hgj, smul_neg, Finset.smul_sum]
            simp only [sub_smul, Finset.sum_sub_distrib, smul_smul]
            abel
          · rintro ⟨c, hcS, hx⟩
            refine ⟨Fin.insertNth j 0 c, ?_, ?_⟩
            · intro i
              by_cases hi : i = j
              · subst hi; simp [S.zero_mem]
              · obtain ⟨i', rfl⟩ := Fin.exists_succAbove_eq hi
                simpa using hcS i'
            · rw [hx, Fin.sum_univ_succAbove _ j]
              simp [hg']
        have keyO := key O.toSubring hρO
        have keyK := key ⊤ (fun _ => Subring.mem_top _)
        have hspan' : ∃ c : Fin r → K, v = ∑ i, c i • g' i := by
          obtain ⟨c, hc⟩ := hspan
          obtain ⟨c', -, hc'⟩ := (keyK v).mp ⟨c, fun _ => Subring.mem_top _, hc⟩
          exact ⟨c', hc'⟩
        obtain ⟨z, hz, hzmem, hzmax⟩ := ih g' v hv hspan'
        refine ⟨z, hz, ?_, ?_⟩
        · exact (keyO _).mpr hzmem
        · intro z' hz' hz'mem
          exact hzmax z' hz' ((keyO _).mp hz'mem)

  have s4c : ∀ (K : Type u) [Field K] (O : ValuationSubring K) (L' : Type u) [Field L'] [Algebra K L'] [FiniteDimensional K L'], letI : Algebra ↥O L' := ((algebraMap K L').comp O.subtype).toAlgebra; Module.Finite ↥O ↥(integralClosure ↥O L') → ∀ α' : L', ∃ (r : ℕ) (g : Fin r → L' ⧸ Submodule.span K {(1 : L')}), (∃ c : Fin r → K, (Submodule.Quotient.mk α' : L' ⧸ Submodule.span K {(1 : L')}) = ∑ i, c i • g i) ∧ ∀ z : K, z ≠ 0 → ((∃ c : Fin r → K, (∀ i, c i ∈ O) ∧ z⁻¹ • (Submodule.Quotient.mk α' : L' ⧸ Submodule.span K {(1 : L')}) = ∑ i, c i • g i) ↔ ∃ h : K, IsIntegral ↥O (algebraMap K L' z⁻¹ * (α' - algebraMap K L' h))) := by
    intro K _ O L' _ _ _
    letI : Algebra ↥O L' := ((algebraMap K L').comp O.subtype).toAlgebra
    intro hfin α'
    haveI : IsScalarTower O K L' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := O) (M := integralClosure O L')
    have hsmul : ∀ (e : O) (y : L'), e • y = (e : K) • y := fun e y => by
      rw [Algebra.smul_def, Algebra.smul_def]; rfl
    have hMsum : ∀ x : L', IsIntegral O x ↔ ∃ e : Fin n → O, x = ∑ i, (e i : K) • (s i : L') := by
      intro x
      constructor
      · intro hx
        have hmem : (⟨x, hx⟩ : integralClosure O L') ∈ Submodule.span O (Set.range s) := by
          rw [hs]; trivial
        obtain ⟨e, he⟩ := (Submodule.mem_span_range_iff_exists_fun O).mp hmem
        refine ⟨e, ?_⟩
        have hx' : x = ((∑ i, e i • s i : integralClosure O L') : L') := by rw [he]
        rw [hx']
        simp only [AddSubmonoidClass.coe_finset_sum, SetLike.val_smul, hsmul]
      · rintro ⟨e, rfl⟩
        refine IsIntegral.sum _ (fun i _ => ?_)
        rw [← hsmul, Algebra.smul_def]
        exact isIntegral_algebraMap.mul (s i).2
    set P := Submodule.span K {(1 : L')} with hP
    have hq1 : (Submodule.Quotient.mk (algebraMap K L' 1) : L' ⧸ P) = 0 := by
      rw [map_one, Submodule.Quotient.mk_eq_zero]
      exact Submodule.mem_span_singleton_self 1
    have hqι : ∀ a : K, (Submodule.Quotient.mk (algebraMap K L' a) : L' ⧸ P) = 0 := by
      intro a
      rw [Algebra.algebraMap_eq_smul_one, Submodule.Quotient.mk_smul, ← map_one (algebraMap K L'),
        hq1, smul_zero]
    have hqsum : ∀ (c : Fin n → K), (Submodule.Quotient.mk (∑ i, c i • (s i : L')) : L' ⧸ P)
        = ∑ i, c i • (Submodule.Quotient.mk (s i : L') : L' ⧸ P) := by
      intro c
      simp only [← Submodule.mkQ_apply, map_sum, map_smul]
    refine ⟨n, fun i => Submodule.Quotient.mk (s i : L'), ?_, ?_⟩
    · have halg : IsAlgebraic K α' := Algebra.IsAlgebraic.isAlgebraic α'
      have halgO : IsAlgebraic O α' := (IsFractionRing.isAlgebraic_iff O K L').mpr halg
      obtain ⟨y, hy0, hyint⟩ := halgO.exists_integral_multiple
      obtain ⟨e, he⟩ := (hMsum _).mp hyint
      have hyK : (y : K) ≠ 0 := fun h => hy0 (Subtype.ext h)
      refine ⟨fun i => (y : K)⁻¹ * e i, ?_⟩
      have h1 : (Submodule.Quotient.mk (y • α') : L' ⧸ P) = Submodule.Quotient.mk (∑ i, (e i : K) • (s i : L')) := by
        rw [he]
      rw [hsmul, Submodule.Quotient.mk_smul, hqsum] at h1
      have h2 := congrArg (fun w => (y : K)⁻¹ • w) h1
      simp only [smul_smul, inv_mul_cancel₀ hyK, one_smul, Finset.smul_sum] at h2
      rw [h2]
    · intro z hz
      constructor
      · rintro ⟨c, hcO, hc⟩
        set m : L' := ∑ i, c i • (s i : L') with hm
        have hmint : IsIntegral O m := (hMsum m).mpr ⟨fun i => ⟨c i, hcO i⟩, rfl⟩
        have hq0 : (Submodule.Quotient.mk (z⁻¹ • α' - m) : L' ⧸ P) = 0 := by
          rw [Submodule.Quotient.mk_sub, Submodule.Quotient.mk_smul, hc, hm, hqsum, sub_self]
        rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_span_singleton] at hq0
        obtain ⟨a, ha⟩ := hq0
        refine ⟨z * a, ?_⟩
        have e : algebraMap K L' z⁻¹ * (α' - algebraMap K L' (z * a)) = m := by
          have e1 : algebraMap K L' z⁻¹ * (α' - algebraMap K L' (z * a))
              = z⁻¹ • α' - a • (1 : L') := by
            rw [Algebra.smul_def, Algebra.smul_def, mul_one, mul_sub, ← map_mul, ← mul_assoc,
              inv_mul_cancel₀ hz, one_mul]
          rw [e1, ha]
          abel
        rw [e]; exact hmint
      · rintro ⟨h, hint⟩
        obtain ⟨e, he⟩ := (hMsum _).mp hint
        refine ⟨fun i => (e i : K), fun i => (e i).2, ?_⟩
        have h1 : (Submodule.Quotient.mk (algebraMap K L' z⁻¹ * (α' - algebraMap K L' h)) : L' ⧸ P)
            = Submodule.Quotient.mk (∑ i, (e i : K) • (s i : L')) := by
          rw [he]
        rw [hqsum] at h1
        rw [← h1]
        have e2 : algebraMap K L' z⁻¹ * (α' - algebraMap K L' h)
            = z⁻¹ • α' - algebraMap K L' (z⁻¹ * h) := by
          rw [Algebra.smul_def, mul_sub, map_mul]
        rw [e2, Submodule.Quotient.mk_sub, Submodule.Quotient.mk_smul, hqι, sub_zero]

  intro K _ O ℓ hℓ hℓK c₀ hc₀O hc₀pow hroot hfin f hf0 hfO hfinv

  have hid1 : ∀ (m : ℕ) (a b z y : K), z ≠ 0 → y ≠ 0 → b ≠ 0 →
      a / b = a / z ^ m * (z / y) ^ m * (y ^ m / b) := by
    intro m a b z y hz hy hb
    rw [div_pow]
    field_simp
  have hid2 : ∀ (m : ℕ) (a y c : K), y ≠ 0 → c ≠ 0 → a / c ^ m = a / y ^ m * (y / c) ^ m := by
    intro m a y c hy hc
    rw [div_pow]
    field_simp
  have hid3 : ∀ (Z h₁ y h' : K), h₁ ≠ 0 → y ≠ 0 → h' ≠ 0 →
      Z * h₁⁻¹ / y = Z / (y * h') * (h' * h₁⁻¹) := by
    intro Z h₁ y h' hh₁ hy hh'
    field_simp
  have hc₀0 : c₀ ≠ 0 := by
    intro h0
    apply hℓK
    rw [← hc₀pow, h0, zero_pow (by have := hℓ.two_le; omega)]
  have hc₀c₀ : c₀ / c₀ ∈ O := by rw [div_self hc₀0]; exact O.one_mem
  have hval1 : ∀ x : K, x ≠ 0 → x ∈ O → x⁻¹ ∈ O → O.valuation x = 1 := by
    intro x hx hxO hxi
    exact (O.valuation_eq_one_iff ⟨x, hxO⟩).mp
      ⟨⟨⟨x, hxO⟩, ⟨x⁻¹, hxi⟩, Subtype.ext (mul_inv_cancel₀ hx), Subtype.ext (inv_mul_cancel₀ hx)⟩, rfl⟩
  have hvf : O.valuation f = 1 := hval1 f hf0 hfO hfinv

  have hnonunit : ∀ h' : K, h' ≠ 0 → ¬ (h' ∈ O ∧ h'⁻¹ ∈ O) → (f / h' ^ ℓ - 1)⁻¹ ∈ O := by
    intro h' hh' hnu
    have hvh' : O.valuation h' ≠ 1 := fun heq => hnu ⟨(O.valuation_le_one_iff _).mp heq.le,
      by rw [← O.valuation_le_one_iff, map_inv₀, heq, inv_one]⟩
    have hpow : O.valuation h' ^ ℓ ≠ 1 := by
      rcases lt_trichotomy (O.valuation h') 1 with hlt | heq | hgt
      · exact (pow_lt_one₀ zero_le' hlt hℓ.ne_zero).ne
      · exact absurd heq hvh'
      · exact (one_lt_pow₀ hgt hℓ.ne_zero).ne'
    have hq : O.valuation (f / h' ^ ℓ) * O.valuation h' ^ ℓ = 1 := by
      rw [← map_pow, ← map_mul, div_mul_cancel₀ _ (pow_ne_zero _ hh'), hvf]
    have hq1 : O.valuation (f / h' ^ ℓ) ≠ 1 := fun heq => hpow (by rw [heq, one_mul] at hq; exact hq)
    have hge : 1 ≤ O.valuation (f / h' ^ ℓ - 1) := by
      rcases lt_or_gt_of_ne hq1 with hlt | hgt
      · exact ((Valuation.map_sub_eq_of_lt_right O.valuation (x := f / h' ^ ℓ) (y := 1)
          (by rw [map_one]; exact hlt)).trans (map_one _)).ge
      · rw [Valuation.map_sub_eq_of_lt_left O.valuation (x := f / h' ^ ℓ) (y := 1)
          (by rw [map_one]; exact hgt)]
        exact hgt.le
    have hne : f / h' ^ ℓ - 1 ≠ 0 := by
      intro h0
      rw [h0, map_zero] at hge
      exact absurd hge (not_le.mpr zero_lt_one)
    rw [← O.valuation_le_one_iff]
    calc O.valuation (f / h' ^ ℓ - 1)⁻¹
        ≤ O.valuation (f / h' ^ ℓ - 1)⁻¹ * O.valuation (f / h' ^ ℓ - 1) :=
          le_mul_of_one_le_right' hge
      _ = 1 := by rw [← map_mul, inv_mul_cancel₀ hne, map_one]

  by_cases hP : ∃ b : K, b ^ ℓ = f
  · obtain ⟨b, hb⟩ := hP
    have hb0 : b ≠ 0 := by
      rintro rfl
      apply hf0
      rw [← hb, zero_pow hℓ.ne_zero]
    refine ⟨b, hb0, Or.inl ?_⟩
    rw [hb, div_self hf0, sub_self, zero_div]
    exact O.zero_mem
  push_neg at hP

  obtain ⟨L', iL', iA, iFD, iSep, θ, hθ, hθf⟩ := s1 K ℓ hℓ hℓK f hf0 hP
  letI : Algebra O L' := ((algebraMap K L').comp O.subtype).toAlgebra
  haveI : IsScalarTower O K L' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hM := hfin L'
  obtain ⟨r, g, hspan, hiff⟩ := s4c K O L' hM θ
  set v := (Submodule.Quotient.mk θ : L' ⧸ Submodule.span K {(1 : L')}) with hv
  have hv0 : v ≠ 0 := by
    intro h0
    rw [hv, Submodule.Quotient.mk_eq_zero, Submodule.mem_span_singleton] at h0
    obtain ⟨a, ha⟩ := h0
    exact hθ ⟨a, by rw [Algebra.algebraMap_eq_smul_one]; exact ha⟩
  obtain ⟨Z, hZ0, hZmem, hZmax⟩ := s3c K O _ r g v hv0 hspan
  obtain ⟨h, hint⟩ := (hiff Z hZ0).mp hZmem
  have hmax : ∀ Z' h' : K, Z' ≠ 0 → IsIntegral O (algebraMap K L' Z'⁻¹ * (θ - algebraMap K L' h')) →
      Z / Z' ∈ O := fun Z' h' hZ' hi => hZmax Z' hZ' ((hiff Z' hZ').mpr ⟨h', hi⟩)
  have hιO : ∀ (a : K) (ha : a ∈ O), algebraMap O L' ⟨a, ha⟩ = algebraMap K L' a :=
    fun _ _ => rfl
  have hιint : ∀ a : K, a ∈ O → IsIntegral O (algebraMap K L' a) := by
    intro a ha
    rw [← hιO a ha]
    exact isIntegral_algebraMap
  have hintO : ∀ x : K, IsIntegral O (algebraMap K L' x) → x ∈ O := by
    intro x hx
    have h2 : IsIntegral O x := isIntegral_algebraMap_iff.mp hx
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp h2
    rw [← hy]
    exact y.2
  have hθint : IsIntegral O θ := by
    refine ⟨Polynomial.X ^ ℓ - Polynomial.C (⟨f, hfO⟩ : O),
      Polynomial.monic_X_pow_sub_C _ hℓ.ne_zero, ?_⟩
    rw [← Polynomial.aeval_def]
    simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, hιO]
    rw [hθf, sub_self]

  have hZO : Z ∈ O := by
    have h1 : IsIntegral O (algebraMap K L' (1 : K)⁻¹ * (θ - algebraMap K L' 0)) := by
      simpa using hθint
    simpa using hmax 1 0 one_ne_zero h1

  have hhO : h ∈ O := by
    have e : algebraMap K L' h =
        θ - algebraMap K L' Z * (algebraMap K L' Z⁻¹ * (θ - algebraMap K L' h)) := by
      rw [← mul_assoc, ← map_mul, mul_inv_cancel₀ hZ0, map_one, one_mul]
      ring
    exact hintO h (by rw [e]; exact hθint.sub ((hιint Z hZO).mul hint))

  obtain ⟨h₁, h₁0, h₁O, h₁inv, hint₁⟩ : ∃ h₁ : K, h₁ ≠ 0 ∧ h₁ ∈ O ∧ h₁⁻¹ ∈ O ∧
      IsIntegral O (algebraMap K L' Z⁻¹ * (θ - algebraMap K L' h₁)) := by
    by_cases hZi : Z⁻¹ ∈ O
    · refine ⟨1, one_ne_zero, O.one_mem, by rw [inv_one]; exact O.one_mem, ?_⟩
      exact (hιint _ hZi).mul (hθint.sub (by rw [map_one]; exact isIntegral_one))
    · have hvZ : O.valuation Z < 1 := lt_of_le_of_ne ((O.valuation_le_one_iff Z).mpr hZO)
        (fun heq => hZi (by rw [← O.valuation_le_one_iff, map_inv₀, heq, inv_one]))
      have e : algebraMap K L' ((f - h ^ ℓ) / Z) =
          (∑ i ∈ Finset.range ℓ, θ ^ i * algebraMap K L' h ^ (ℓ - 1 - i)) *
            (algebraMap K L' Z⁻¹ * (θ - algebraMap K L' h)) := by
        rw [div_eq_mul_inv, map_mul, map_sub, map_pow, ← hθf, ← geom_sum₂_mul]
        ring
      have hq : (f - h ^ ℓ) / Z ∈ O := hintO _ (by
        rw [e]
        exact (IsIntegral.sum _ (fun i _ => (hθint.pow _).mul ((hιint h hhO).pow _))).mul hint)
      have hlt : O.valuation (f - h ^ ℓ) < O.valuation f := by
        rw [← div_mul_cancel₀ (f - h ^ ℓ) hZ0, map_mul, hvf]
        calc O.valuation ((f - h ^ ℓ) / Z) * O.valuation Z ≤ O.valuation Z :=
              mul_le_of_le_one_left' ((O.valuation_le_one_iff _).mpr hq)
          _ < 1 := hvZ
      have hvhl : O.valuation h ^ ℓ = 1 := by
        rw [← map_pow, show h ^ ℓ = f - (f - h ^ ℓ) by ring,
          Valuation.map_sub_eq_of_lt_left _ hlt, hvf]
      have hvh : O.valuation h = 1 := by
        by_contra hne
        have hlt1 : O.valuation h < 1 := lt_of_le_of_ne ((O.valuation_le_one_iff h).mpr hhO) hne
        exact (pow_lt_one₀ zero_le' hlt1 hℓ.ne_zero).ne hvhl
      have hh0 : h ≠ 0 := by
        intro h0
        rw [h0, map_zero] at hvh
        exact zero_ne_one hvh
      exact ⟨h, hh0, hhO, by rw [← O.valuation_le_one_iff, map_inv₀, hvh, inv_one], hint⟩

  have hT : ∀ h' y : K, h' ≠ 0 → y ≠ 0 →
      algebraMap K L' y⁻¹ * (algebraMap K L' h'⁻¹ * θ - 1) =
        algebraMap K L' (y * h')⁻¹ * (θ - algebraMap K L' h') := by
    intro h' y hh' hy
    have hh : algebraMap K L' h'⁻¹ * algebraMap K L' h' = 1 := by
      rw [← map_mul, inv_mul_cancel₀ hh', map_one]
    rw [mul_inv, map_mul]
    linear_combination (algebraMap K L' y⁻¹) * hh
  have hPw : ∀ h' : K, h' ≠ 0 →
      (1 + (algebraMap K L' h'⁻¹ * θ - 1)) ^ ℓ = 1 + algebraMap K L' (f / h' ^ ℓ - 1) := by
    intro h' hh'
    rw [show (1 : L') + (algebraMap K L' h'⁻¹ * θ - 1) = algebraMap K L' h'⁻¹ * θ by ring,
      mul_pow, hθf, map_sub, map_one, div_eq_mul_inv, ← inv_pow, map_mul, map_pow]
    ring

  have hz0 : Z * h₁⁻¹ ≠ 0 := mul_ne_zero hZ0 (inv_ne_zero h₁0)
  have hzO : Z * h₁⁻¹ ∈ O := mul_mem hZO h₁inv
  have hintz : IsIntegral O (algebraMap K L' (Z * h₁⁻¹)⁻¹ * (algebraMap K L' h₁⁻¹ * θ - 1)) := by
    rw [hT h₁ (Z * h₁⁻¹) h₁0 hz0, inv_mul_cancel_right₀ h₁0 Z]
    exact hint₁
  refine ⟨h₁, h₁0, ?_⟩
  by_cases hzc : Z * h₁⁻¹ / c₀ ∈ O
  ·
    left
    have hintc : IsIntegral O (algebraMap K L' c₀⁻¹ * (algebraMap K L' h₁⁻¹ * θ - 1)) := by
      have e : algebraMap K L' c₀⁻¹ * (algebraMap K L' h₁⁻¹ * θ - 1) =
          algebraMap K L' (Z * h₁⁻¹ / c₀) *
            (algebraMap K L' (Z * h₁⁻¹)⁻¹ * (algebraMap K L' h₁⁻¹ * θ - 1)) := by
        rw [← mul_assoc, ← map_mul]
        congr 2
        field_simp
      rw [e]
      exact (hιint _ hzc).mul hintz
    exact (s2 K O L' ℓ hℓ c₀ hc₀O hc₀pow _ _ c₀ (hPw h₁ h₁0) hc₀0 hc₀c₀).mp hintc
  ·
    right
    have hcz : c₀ / (Z * h₁⁻¹) ∈ O := by
      have := (O.mem_or_inv_mem (Z * h₁⁻¹ / c₀)).resolve_left hzc
      rwa [inv_div] at this
    have hA₁ : (f / h₁ ^ ℓ - 1) / (Z * h₁⁻¹) ^ ℓ ∈ O :=
      (s2 K O L' ℓ hℓ c₀ hc₀O hc₀pow _ _ _ (hPw h₁ h₁0) hz0 hcz).mp hintz
    intro h' hh' hF'
    by_cases hu : h' ∈ O ∧ h'⁻¹ ∈ O
    · obtain ⟨y', hy0, hy1, hy2⟩ := hroot _ hF'
      by_cases hyc : c₀ / y' ∈ O
      · have hi : IsIntegral O (algebraMap K L' y'⁻¹ * (algebraMap K L' h'⁻¹ * θ - 1)) :=
          (s2 K O L' ℓ hℓ c₀ hc₀O hc₀pow _ _ y' (hPw h' hh') hy0 hyc).mpr hy1
        rw [hT h' y' hh' hy0] at hi
        have hm := hmax (y' * h') h' (mul_ne_zero hy0 hh') hi
        have hzy : Z * h₁⁻¹ / y' ∈ O := by
          rw [hid3 Z h₁ y' h' h₁0 hy0 hh']
          exact mul_mem hm (mul_mem hu.1 h₁inv)
        rw [hid1 ℓ _ _ (Z * h₁⁻¹) y' hz0 hy0 hF']
        exact mul_mem (mul_mem hA₁ (pow_mem hzy _)) hy2
      · have hyi : y' / c₀ ∈ O := by
          have := (O.mem_or_inv_mem (c₀ / y')).resolve_left hyc
          rwa [inv_div] at this
        have hFc : (f / h' ^ ℓ - 1) / c₀ ^ ℓ ∈ O := by
          rw [hid2 ℓ _ y' c₀ hy0 hc₀0]
          exact mul_mem hy1 (pow_mem hyi _)
        have hi : IsIntegral O (algebraMap K L' c₀⁻¹ * (algebraMap K L' h'⁻¹ * θ - 1)) :=
          (s2 K O L' ℓ hℓ c₀ hc₀O hc₀pow _ _ c₀ (hPw h' hh') hc₀0 hc₀c₀).mpr hFc
        rw [hT h' c₀ hh' hc₀0] at hi
        have hm := hmax (c₀ * h') h' (mul_ne_zero hc₀0 hh') hi
        exact absurd (by rw [hid3 Z h₁ c₀ h' h₁0 hc₀0 hh']; exact mul_mem hm (mul_mem hu.1 h₁inv)) hzc
    · have hF'inv := hnonunit h' hh' hu
      have hF₁O : f / h₁ ^ ℓ - 1 ∈ O := by
        rw [← div_mul_cancel₀ (f / h₁ ^ ℓ - 1) (pow_ne_zero ℓ hz0)]
        exact mul_mem hA₁ (pow_mem hzO _)
      rw [div_eq_mul_inv]
      exact mul_mem hF₁O hF'inv

theorem wcLlsASbb_fraction_form : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) → ∀ F : K, F ≠ 0 → ∃ (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A), lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀ ∉ 𝔭 ∧ ε₁ ∉ 𝔭 ∧ F * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) * algebraMap A K (algebraMap ↥W A lam₂) = algebraMap A K (algebraMap ↥W A lam₁) * algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 u v g hPD F hF
  classical
  have hPD' := hPD
  obtain ⟨-, -, -, h𝔭max, -⟩ := hPD'
  have h𝔭p : 𝔭.IsPrime := h𝔭max.isPrime
  obtain ⟨p, q, hq, hpq⟩ := IsFractionRing.div_surjective (A := A) F
  have hq0 : q ≠ 0 := nonZeroDivisors.ne_zero hq
  have hφq : algebraMap A K q ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hq
  have hFq : F * algebraMap A K q = algebraMap A K p := by
    rw [← hpq]; exact div_mul_cancel₀ _ hφq
  have hp0 : p ≠ 0 := by
    rintro rfl
    apply hF
    rw [← hpq, map_zero, zero_div]
  obtain ⟨j₁, k₁, σ₁, e₁, r₁', g₁', lp, w₁, hσ₁, he₁, hlp, hw₁, E1⟩ :=
    wcpa_dj_llsm_kpwul_bracket Ω W hW hWt A 𝔭 u v g hPD p hp0
  obtain ⟨j₂, k₂, σ₂, e₂, r₂', g₂', lq, w₂, hσ₂, he₂, hlq, hw₂, E2⟩ :=
    wcpa_dj_llsm_kpwul_bracket Ω W hW hWt A 𝔭 u v g hPD q hq0
  obtain ⟨w, d₁, d₂, hw, hd₁, hd₂⟩ : ∃ w d₁ d₂ : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W ∧
      w₁ = w * d₁ ∧ w₂ = w * d₂ := by
    rcases ValuationRing.dvd_total w₁ w₂ with ⟨d, hd⟩ | ⟨d, hd⟩
    · exact ⟨w₁, 1, d, hw₁, (mul_one _).symm, hd⟩
    · exact ⟨w₂, d, 1, hw₂, hd, (mul_one _).symm⟩
  refine ⟨lp, lq, w, k₂ + j₁, k₁ + j₂, σ₂ * e₁, σ₁ * e₂, σ₂ * u ^ j₂ * r₁', σ₁ * u ^ j₁ * r₂',
    algebraMap ↥W A d₁ * (σ₂ * u ^ j₂ * g₁'), algebraMap ↥W A d₂ * (σ₁ * u ^ j₁ * g₂'),
    hlp, hlq, hw, h𝔭p.mul_notMem hσ₂ he₁, h𝔭p.mul_notMem hσ₁ he₂, ?_⟩
  rw [hd₁] at E1
  rw [hd₂] at E2
  have E1' := congrArg (algebraMap A K) E1
  have E2' := congrArg (algebraMap A K) E2
  simp only [map_mul, map_add, map_pow] at E1' E2' ⊢
  linear_combination (-(F * algebraMap A K σ₁ * algebraMap A K u ^ j₁)) * E2' +
    (algebraMap A K σ₁ * algebraMap A K u ^ j₁ * algebraMap A K σ₂ * algebraMap A K u ^ j₂) * hFq +
    (algebraMap A K σ₂ * algebraMap A K u ^ j₂) * E1'

theorem wcpa_dj_llsm_kpwulbc_branch_upow : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) → ∀ (e : ℕ) (t : A), t ∉ 𝔭 → t * u ^ e ∉ Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) :=
by
  intro Ω _ W A _ _ _ 𝔭 u v g hPD e t ht hmem
  have hPD' := hPD
  obtain ⟨-, -, -, h𝔭max, -⟩ := hPD'
  haveI : 𝔭.IsPrime := h𝔭max.isPrime
  obtain ⟨⟨hdom, -, hirr⟩, -⟩ := wcpa_dj_llsm_kpkn_branch_dvrs Ω W A 𝔭 u v g hPD
  haveI := hdom
  have hle : Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤
      (wcKpknBrI W A 𝔭 v).comap (algebraMap A (Localization.AtPrime 𝔭)) := by
    apply sup_le
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      show algebraMap A (Localization.AtPrime 𝔭) v ∈ wcKpknBrI W A 𝔭 v
      exact Ideal.mem_sup_right (Ideal.subset_span (Set.mem_singleton _))
    · exact Ideal.map_le_iff_le_comap.mp le_sup_left
  have hι : algebraMap A (Localization.AtPrime 𝔭) (t * u ^ e) ∈ wcKpknBrI W A 𝔭 v := hle hmem
  have h0 := Ideal.Quotient.eq_zero_iff_mem.mpr hι
  rw [map_mul, map_pow, map_mul, map_pow] at h0
  have h4 : Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v) (algebraMap A (Localization.AtPrime 𝔭) t) ≠ 0 :=
    ((IsLocalization.map_units (Localization.AtPrime 𝔭)
      (⟨t, ht⟩ : 𝔭.primeCompl)).map _).ne_zero
  have h5 := pow_ne_zero e hirr.ne_zero
  exact mul_ne_zero h4 h5 h0

theorem wcpa_dj_llsm_kpwulbc_branch_dichotomy : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) → ∀ X : A, (∃ t : A, t ∉ 𝔭 ∧ t * X ∈ Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∨ ∃ (e : ℕ) (σ ε : A), σ ∉ 𝔭 ∧ ε ∉ 𝔭 ∧ σ * X - u ^ e * ε ∈ Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) :=
by
  intro Ω _ W A _ _ _ 𝔭 u v g hPD X
  have hPD' := hPD
  obtain ⟨-, -, -, h𝔭max, -, -, -, -, hpeq, -⟩ := hPD'
  haveI h𝔭p : 𝔭.IsPrime := h𝔭max.isPrime
  obtain ⟨⟨hdom, hdvr, hirr⟩, -⟩ := wcpa_dj_llsm_kpkn_branch_dvrs Ω W A 𝔭 u v g hPD
  haveI := hdom
  haveI := hdvr
  have hIle : wcKpknBrI W A 𝔭 v ≤
      (Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
        (algebraMap A (Localization.AtPrime 𝔭)) := by
    apply sup_le
    · exact Ideal.map_mono le_sup_right
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact Ideal.mem_map_of_mem _ (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton _)))
  have hinj : Function.Injective (algebraMap A (Localization.AtPrime 𝔭)) :=
    IsLocalization.injective (Localization.AtPrime 𝔭) (Ideal.primeCompl_le_nonZeroDivisors 𝔭)
  have pull : ∀ z : A, algebraMap A (Localization.AtPrime 𝔭) z ∈ wcKpknBrI W A 𝔭 v →
      ∃ s : A, s ∉ 𝔭 ∧ s * z ∈ Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
    intro z hz
    obtain ⟨⟨⟨a, ha⟩, ⟨s, hs⟩⟩, h⟩ :=
      (IsLocalization.mem_map_algebraMap_iff 𝔭.primeCompl (Localization.AtPrime 𝔭)).mp (hIle hz)
    refine ⟨s, hs, ?_⟩
    have hzs : z * s = a := hinj (by rw [map_mul]; exact h)
    rw [mul_comm, hzs]
    exact ha
  by_cases hX0 : Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v) (algebraMap A (Localization.AtPrime 𝔭) X) = 0
  · left
    exact pull X (Ideal.Quotient.eq_zero_iff_mem.mp hX0)
  · right
    obtain ⟨e, U, hU⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hX0 hirr
    obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (U : Localization.AtPrime 𝔭 ⧸ wcKpknBrI W A 𝔭 v)
    obtain ⟨⟨a, ⟨s, hs⟩⟩, hya⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl y
    have hspec : y * algebraMap A (Localization.AtPrime 𝔭) s =
        algebraMap A (Localization.AtPrime 𝔭) a := by
      rw [← hya]; exact IsLocalization.mk'_spec _ a ⟨s, hs⟩
    have hmka : Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v) (algebraMap A (Localization.AtPrime 𝔭) a) =
        (U : Localization.AtPrime 𝔭 ⧸ wcKpknBrI W A 𝔭 v) *
          Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v) (algebraMap A (Localization.AtPrime 𝔭) s) := by
      rw [← hspec, map_mul, hy]
    have hkey : Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v)
        (algebraMap A (Localization.AtPrime 𝔭) (s * X - u ^ e * a)) = 0 := by
      simp only [map_sub, map_mul, map_pow]
      rw [hU, hmka]
      ring
    obtain ⟨s', hs', hJ'⟩ := pull _ (Ideal.Quotient.eq_zero_iff_mem.mp hkey)
    have ha : a ∉ 𝔭 := by
      intro ha
      have hunit : IsUnit (Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v)
          (algebraMap A (Localization.AtPrime 𝔭) a)) := by
        rw [hmka]
        exact U.isUnit.mul ((IsLocalization.map_units (Localization.AtPrime 𝔭)
          (⟨s, hs⟩ : 𝔭.primeCompl)).map _)
      rw [hpeq] at ha
      obtain ⟨y1, hy1, y2, hy2, hsum⟩ := Submodule.mem_sup.mp ha
      obtain ⟨α, β, hαβ⟩ := Ideal.mem_span_pair.mp hy1
      have hv0 : Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v) (algebraMap A (Localization.AtPrime 𝔭) v) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr
          (Ideal.mem_sup_right (Ideal.subset_span (Set.mem_singleton _)))
      have hy20 : Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v) (algebraMap A (Localization.AtPrime 𝔭) y2) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_left (Ideal.mem_map_of_mem _ hy2))
      have hdiv : Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v) (algebraMap A (Localization.AtPrime 𝔭) u) ∣
          Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v) (algebraMap A (Localization.AtPrime 𝔭) a) := by
        refine ⟨Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v) (algebraMap A (Localization.AtPrime 𝔭) α), ?_⟩
        rw [← hsum, ← hαβ]
        simp only [map_add, map_mul, hv0, hy20]
        ring
      exact hirr.not_isUnit (isUnit_of_dvd_unit hdiv hunit)
    refine ⟨e, s' * s, s' * a, h𝔭p.mul_notMem hs' hs, h𝔭p.mul_notMem hs' ha, ?_⟩
    have hre : s' * s * X - u ^ e * (s' * a) = s' * (s * X - u ^ e * a) := by ring
    rw [hre]
    exact hJ'

theorem wcLlsASbba_nf_compare : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) → ∀ (F G : K) (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A) (lam₁' lam₂' w' : ↥W) (n' k' : ℕ) (ε₀' ε₁' r₀' r₁' g₀' g₁' : A) (a b : A), lam₁ ≠ 0 → lam₂ ≠ 0 → w ∈ IsLocalRing.maximalIdeal ↥W → ε₀ ∉ 𝔭 → ε₁ ∉ 𝔭 → F * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) * algebraMap A K (algebraMap ↥W A lam₂) = algebraMap A K (algebraMap ↥W A lam₁) * algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀) → lam₁' ≠ 0 → lam₂' ≠ 0 → w' ∈ IsLocalRing.maximalIdeal ↥W → ε₀' ∉ 𝔭 → ε₁' ∉ 𝔭 → G * algebraMap A K (u ^ n' * ε₁' + v * r₁' + algebraMap ↥W A w' * g₁') * algebraMap A K (algebraMap ↥W A lam₂') = algebraMap A K (algebraMap ↥W A lam₁') * algebraMap A K (u ^ k' * ε₀' + v * r₀' + algebraMap ↥W A w' * g₀') → (∀ s : A, s ∉ 𝔭 → s * b ∉ Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) → F * algebraMap A K b = G * algebraMap A K a → lam₁' * lam₂ ∣ lam₁ * lam₂' :=
by
  intro Ω _ _ W hdim hWtop A _ _ _ K _ _ _ 𝔭 u v g hPD F G lam₁ lam₂ w n k ε₀ ε₁ r₀ r₁ g₀ g₁
    lam₁' lam₂' w' n' k' ε₀' ε₁' r₀' r₁' g₀' g₁' a b h1 h2 h3 h4 h5 hEQ h1' h2' h3' h4' h5' hEQ'
    hb hab
  classical
  have hup := wcpa_dj_llsm_kpwulbc_branch_upow Ω W A 𝔭 u v g hPD
  have hdich := wcpa_dj_llsm_kpwulbc_branch_dichotomy Ω W A 𝔭 u v g hPD
  obtain ⟨-, hnzd, -, hmax, hmA𝔭, -⟩ := hPD
  have h𝔭 : 𝔭.IsPrime := hmax.isPrime
  set J := Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) with hJ
  have hJw : ∀ x ∈ IsLocalRing.maximalIdeal ↥W, ∀ y : A, algebraMap ↥W A x * y ∈ J :=
    fun x hx y => Ideal.mem_sup_right (Ideal.mul_mem_right y _ (Ideal.mem_map_of_mem _ hx))
  have hJv : ∀ r : A, v * r ∈ J :=
    fun r => Ideal.mem_sup_left (Ideal.mul_mem_right r _ (Ideal.mem_span_singleton_self v))
  set B₀ := u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀ with hB₀
  set B₁ := u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁ with hB₁
  set B₀' := u ^ k' * ε₀' + v * r₀' + algebraMap ↥W A w' * g₀' with hB₀'
  set B₁' := u ^ n' * ε₁' + v * r₁' + algebraMap ↥W A w' * g₁' with hB₁'

  have hXJ : B₀ * B₁' * b ∉ J := by
    rcases hdich b with ⟨t, ht, htb⟩ | ⟨e, σ, ε, hσ, hε, hσb⟩
    · exact absurd htb (hb t ht)
    · intro hX
      have hj₀J : v * r₀ + algebraMap ↥W A w * g₀ ∈ J := J.add_mem (hJv r₀) (hJw w h3 g₀)
      have hj₁J : v * r₁' + algebraMap ↥W A w' * g₁' ∈ J := J.add_mem (hJv r₁') (hJw w' h3' g₁')
      have key : (ε₀ * ε₁' * ε) * u ^ (k + n' + e) =
          σ * (B₀ * B₁' * b) - (v * r₀ + algebraMap ↥W A w * g₀) * B₁' * (σ * b)
            - u ^ k * ε₀ * (v * r₁' + algebraMap ↥W A w' * g₁') * (σ * b)
            - u ^ k * ε₀ * (u ^ n' * ε₁') * (σ * b - u ^ e * ε) := by
        rw [hB₀, hB₁']; ring
      have hmem : (ε₀ * ε₁' * ε) * u ^ (k + n' + e) ∈ J := by
        rw [key]
        refine J.sub_mem (J.sub_mem (J.sub_mem (J.mul_mem_left σ hX) ?_) ?_) ?_
        · exact J.mul_mem_right _ (J.mul_mem_right _ hj₀J)
        · exact J.mul_mem_right _ (J.mul_mem_left _ hj₁J)
        · exact J.mul_mem_left _ hσb
      have ht : ε₀ * ε₁' * ε ∉ 𝔭 := h𝔭.mul_notMem (h𝔭.mul_notMem h4 h5') hε
      exact hup (k + n' + e) _ ht hmem
  have hstar : algebraMap ↥W A (lam₁ * lam₂') * (B₀ * B₁' * b) =
      algebraMap ↥W A (lam₁' * lam₂) * (B₀' * a * B₁) := by
    apply IsFractionRing.injective A K
    simp only [map_mul]
    linear_combination (-(algebraMap A K (algebraMap ↥W A lam₂') * algebraMap A K B₁' *
        algebraMap A K b)) * hEQ +
      (algebraMap A K (algebraMap ↥W A lam₂) * algebraMap A K a * algebraMap A K B₁) * hEQ' +
      (algebraMap A K B₁ * algebraMap A K (algebraMap ↥W A lam₂) *
        algebraMap A K (algebraMap ↥W A lam₂') * algebraMap A K B₁') * hab
  rcases ValuationRing.dvd_total (lam₁' * lam₂) (lam₁ * lam₂') with h | ⟨ρ, hρ⟩
  · exact h
  by_cases hu : IsUnit ρ
  · obtain ⟨μ, rfl⟩ := hu
    refine ⟨↑μ⁻¹, ?_⟩
    rw [hρ, mul_assoc, Units.mul_inv, mul_one]
  · exfalso
    have hρm : ρ ∈ IsLocalRing.maximalIdeal ↥W :=
      (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hu)
    have hne : algebraMap ↥W A (lam₁ * lam₂') ≠ 0 := by
      intro h0
      have hl : lam₁ * lam₂' ≠ 0 := mul_ne_zero h1 h2'
      haveI := hnzd
      have e : (lam₁ * lam₂') • (1 : A) = 0 := by rw [Algebra.smul_def, mul_one, h0]
      rcases smul_eq_zero.mp e with h | h
      · exact hl h
      · exact one_ne_zero h
    have e2 : algebraMap ↥W A (lam₁ * lam₂') * (B₀ * B₁' * b) =
        algebraMap ↥W A (lam₁ * lam₂') * (algebraMap ↥W A ρ * (B₀' * a * B₁)) := by
      rw [hstar, hρ, map_mul]; ring
    have e3 := mul_left_cancel₀ hne e2
    apply hXJ
    rw [e3]
    exact hJw ρ hρm _

theorem wcLlsASbba_branch_valring : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) → ∃ O : ValuationSubring K, (∀ x : K, x ∈ O ↔ ∃ a b : A, (∀ s : A, s ∉ 𝔭 → s * b ∉ Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧ x * algebraMap A K b = algebraMap A K a) ∧ ∀ N : ℕ, 0 < N → ∀ x : K, x ≠ 0 → ∃ y : K, y ≠ 0 ∧ x / y ^ N ∈ O ∧ y ^ N / x ∈ O :=
by
  intro Ω _ _ W hdim hWtop A _ _ _ K _ _ _ 𝔭 u v g hPD
  classical
  have hPD' := hPD
  obtain ⟨-, hNZ, -, hmax, hm𝔭, -, -, -, h𝔭eq, -⟩ := hPD'
  haveI := hNZ
  have h𝔭p : 𝔭.IsPrime := hmax.isPrime
  have hv𝔭 : v ∈ 𝔭 := by
    rw [h𝔭eq]
    exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
  have hJ : Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 :=
    sup_le ((Ideal.span_singleton_le_iff_mem _).mpr hv𝔭) hm𝔭
  have hup := wcpa_dj_llsm_kpwulbc_branch_upow Ω W A 𝔭 u v g hPD
  have hdich := wcpa_dj_llsm_kpwulbc_branch_dichotomy Ω W A 𝔭 u v g hPD

  obtain ⟨Nu, hNu⟩ : ∃ Nu : A → Prop, ∀ b : A, Nu b ↔
      ∀ s : A, s ∉ 𝔭 → s * b ∉ Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) :=
    ⟨_, fun _ => Iff.rfl⟩
  have Nu1 : Nu 1 := by
    rw [hNu]
    intro s hs hm
    rw [mul_one] at hm
    exact hs (hJ hm)
  have hinj : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
    intro x hx h0
    have h1 : algebraMap ↥W A x = 0 :=
      (IsFractionRing.injective A K) (h0.trans (map_zero _).symm)
    have h2 : x • (1 : A) = 0 := by rw [Algebra.smul_def, mul_one]; exact h1
    exact hx ((smul_eq_zero.mp h2).resolve_right one_ne_zero)

  have Napprox : ∀ (x : A) (e : ℕ) (ε : A), ε ∉ 𝔭 →
      x - u ^ e * ε ∈ Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      Nu x := by
    intro x e ε hε hD
    rw [hNu]
    intro s hs hm
    have ht : s * ε ∉ 𝔭 := h𝔭p.mul_notMem hs hε
    apply hup e (s * ε) ht
    have key : s * ε * u ^ e = s * x - s * (x - u ^ e * ε) := by ring
    rw [key]
    exact Ideal.sub_mem _ hm (Ideal.mul_mem_left _ s hD)

  have Nmul : ∀ x y : A, Nu x → Nu y → Nu (x * y) := by
    intro x y hx hy
    rw [hNu] at hx hy ⊢
    obtain ⟨e, σ, ε, hσ, hε, hDx⟩ : ∃ (e : ℕ) (σ ε : A), σ ∉ 𝔭 ∧ ε ∉ 𝔭 ∧
        σ * x - u ^ e * ε ∈ Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
      rcases hdich x with ⟨t, ht, htx⟩ | h
      · exact absurd htx (hx t ht)
      · exact h
    obtain ⟨e', σ', ε', hσ', hε', hDy⟩ : ∃ (e : ℕ) (σ ε : A), σ ∉ 𝔭 ∧ ε ∉ 𝔭 ∧
        σ * y - u ^ e * ε ∈ Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
      rcases hdich y with ⟨t, ht, hty⟩ | h
      · exact absurd hty (hy t ht)
      · exact h
    intro s hs H
    have ht : s * ε * ε' ∉ 𝔭 := h𝔭p.mul_notMem (h𝔭p.mul_notMem hs hε) hε'
    apply hup (e + e') (s * ε * ε') ht
    have key : s * ε * ε' * u ^ (e + e') = σ * σ' * (s * (x * y)) -
        s * ((σ' * y) * (σ * x - u ^ e * ε) + (u ^ e * ε) * (σ' * y - u ^ e' * ε')) := by
      rw [pow_add]; ring
    rw [key]
    exact Ideal.sub_mem _ (Ideal.mul_mem_left _ _ H)
      (Ideal.mul_mem_left _ _ (Ideal.add_mem _ (Ideal.mul_mem_left _ _ hDx)
        (Ideal.mul_mem_left _ _ hDy)))

  have hGV : ∀ x : A, x ≠ 0 → ∃ (d : ↥W) (y b : A), d ≠ 0 ∧ Nu y ∧ Nu b ∧
      b * x = algebraMap ↥W A d * y := by
    intro x hx
    obtain ⟨j, k, σ, ε, r, g', lam, w, hσ, hε, hlam, hw, hE⟩ :=
      wcpa_dj_llsm_kpwul_bracket Ω W hdim hWtop A 𝔭 u v g hPD x hx
    refine ⟨lam, u ^ k * ε + v * r + algebraMap ↥W A w * g', σ * u ^ j, hlam, ?_, ?_, hE⟩
    · apply Napprox _ k ε hε
      have e1 : u ^ k * ε + v * r + algebraMap ↥W A w * g' - u ^ k * ε =
          v * r + algebraMap ↥W A w * g' := by ring
      rw [e1]
      exact Ideal.add_mem _
        (Ideal.mem_sup_left (Ideal.mul_mem_right r _ (Ideal.mem_span_singleton_self v)))
        (Ideal.mem_sup_right (Ideal.mul_mem_right g' _ (Ideal.mem_map_of_mem _ hw)))
    · apply Napprox _ j σ hσ
      have e1 : σ * u ^ j - u ^ j * σ = 0 := by ring
      rw [e1]
      exact Ideal.zero_mem _

  have hfac : ∀ x : K, x ≠ 0 → ∃ (d₁ d₂ : ↥W) (p q : A), d₁ ≠ 0 ∧ d₂ ≠ 0 ∧ Nu p ∧ Nu q ∧
      x * algebraMap A K (algebraMap ↥W A d₂) * algebraMap A K q =
        algebraMap A K (algebraMap ↥W A d₁) * algebraMap A K p := by
    intro x hx
    obtain ⟨a, e, he, rfl⟩ := IsFractionRing.div_surjective (A := A) x
    have hφe : algebraMap A K e ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors he
    have he0 : e ≠ 0 := nonZeroDivisors.ne_zero he
    have ha0 : a ≠ 0 := by
      rintro rfl
      apply hx
      rw [map_zero, zero_div]
    obtain ⟨da, ua, ba, hda, hua, hba, hEa⟩ := hGV a ha0
    obtain ⟨de, ue, be, hde, hue, hbe, hEe⟩ := hGV e he0
    refine ⟨da, de, ua * be, ba * ue, hda, hde, Nmul _ _ hua hbe, Nmul _ _ hba hue, ?_⟩
    have h1 := congrArg (algebraMap A K) hEa
    have h2 := congrArg (algebraMap A K) hEe
    simp only [map_mul] at h1 h2 ⊢
    rw [div_mul_eq_mul_div, div_mul_eq_mul_div, div_eq_iff hφe]
    linear_combination
      (algebraMap A K (algebraMap ↥W A de) * algebraMap A K ue) * h1 -
      (algebraMap A K (algebraMap ↥W A da) * algebraMap A K ua) * h2

  have rootW : ∀ N : ℕ, 0 < N → ∀ z : ↥W, ∃ r : ↥W, r ^ N = z := by
    intro N hN z
    obtain ⟨r, hr⟩ := IsAlgClosed.exists_pow_nat_eq (z : Ω) hN
    by_cases hrW : r ∈ W
    · refine ⟨⟨r, hrW⟩, Subtype.ext ?_⟩
      first
        | simpa using hr
        | exact hr
    · exfalso
      have hr0 : r ≠ 0 := fun h0 => hrW (h0 ▸ W.zero_mem)
      have hrinv : r⁻¹ ∈ W := (W.mem_or_inv_mem r).resolve_left hrW
      obtain ⟨N', rfl⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by omega⟩
      have h1 : r = (z : Ω) * r⁻¹ ^ N' := by
        rw [← hr, inv_pow, pow_succ, mul_assoc, mul_comm r, ← mul_assoc,
          mul_inv_cancel₀ (pow_ne_zero _ hr0), one_mul]
      apply hrW
      rw [h1]
      exact mul_mem z.2 (pow_mem hrinv N')

  obtain ⟨C, hC⟩ : ∃ C : K → Prop, ∀ x : K, C x ↔
      ∃ a b : A, Nu b ∧ x * algebraMap A K b = algebraMap A K a :=
    ⟨_, fun _ => Iff.rfl⟩
  have hCzero : C 0 := (hC 0).mpr ⟨0, 1, Nu1, by rw [zero_mul, map_zero]⟩
  have hCone : C 1 := (hC 1).mpr ⟨1, 1, Nu1, by rw [one_mul]⟩
  have hCmul : ∀ x x' : K, C x → C x' → C (x * x') := by
    intro x x' hx hx'
    obtain ⟨a, b, hb, h⟩ := (hC x).mp hx
    obtain ⟨a', b', hb', h'⟩ := (hC x').mp hx'
    refine (hC _).mpr ⟨a * a', b * b', Nmul _ _ hb hb', ?_⟩
    simp only [map_mul]
    linear_combination (x' * algebraMap A K b') * h + algebraMap A K a * h'
  have hCadd : ∀ x x' : K, C x → C x' → C (x + x') := by
    intro x x' hx hx'
    obtain ⟨a, b, hb, h⟩ := (hC x).mp hx
    obtain ⟨a', b', hb', h'⟩ := (hC x').mp hx'
    refine (hC _).mpr ⟨a * b' + a' * b, b * b', Nmul _ _ hb hb', ?_⟩
    simp only [map_mul, map_add]
    linear_combination algebraMap A K b' * h + algebraMap A K b * h'
  have hCneg : ∀ x : K, C x → C (-x) := by
    intro x hx
    obtain ⟨a, b, hb, h⟩ := (hC x).mp hx
    exact (hC _).mpr ⟨-a, b, hb, by rw [map_neg, neg_mul, h]⟩
  have hCinv : ∀ x : K, C x ∨ C x⁻¹ := by
    intro x
    by_cases hx : x = 0
    · left; rw [hx]; exact hCzero
    obtain ⟨d₁, d₂, p, q, hd₁, hd₂, hp, hq, hE⟩ := hfac x hx
    rcases ValuationRing.dvd_total d₁ d₂ with ⟨ρ, hρ⟩ | ⟨ρ, hρ⟩
    · right
      subst hρ
      simp only [map_mul] at hE
      have h' : x * (algebraMap A K (algebraMap ↥W A ρ) * algebraMap A K q) =
          algebraMap A K p :=
        mul_left_cancel₀ (hinj d₁ hd₁) (by linear_combination hE)
      refine (hC _).mpr ⟨algebraMap ↥W A ρ * q, p, hp, ?_⟩
      rw [map_mul, ← h', ← mul_assoc, inv_mul_cancel₀ hx, one_mul]
    · left
      subst hρ
      simp only [map_mul] at hE
      have h' : x * algebraMap A K q =
          algebraMap A K (algebraMap ↥W A ρ) * algebraMap A K p :=
        mul_left_cancel₀ (hinj d₂ hd₂) (by linear_combination hE)
      refine (hC _).mpr ⟨algebraMap ↥W A ρ * p, q, hq, ?_⟩
      rw [map_mul, h']
  obtain ⟨O, hO⟩ : ∃ O : ValuationSubring K, ∀ x : K, x ∈ O ↔ C x :=
    ⟨{ toSubring :=
        { carrier := setOf C
          mul_mem' := fun {x x'} hx hx' => hCmul x x' hx hx'
          one_mem' := hCone
          add_mem' := fun {x x'} hx hx' => hCadd x x' hx hx'
          zero_mem' := hCzero
          neg_mem' := fun {x} hx => hCneg x hx }
       mem_or_inv_mem' := hCinv }, fun x => Iff.rfl⟩
  refine ⟨O, ?_, ?_⟩
  · intro x
    rw [hO, hC]
    exact exists_congr fun a => exists_congr fun b => and_congr (hNu b) Iff.rfl
  · intro N hN x hx
    obtain ⟨d₁, d₂, p, q, hd₁, hd₂, hp, hq, hE⟩ := hfac x hx
    rcases ValuationRing.dvd_total d₁ d₂ with ⟨ρ, hρ⟩ | ⟨ρ, hρ⟩
    · subst hρ
      have hρ0 : ρ ≠ 0 := by
        rintro rfl
        exact hd₂ (mul_zero d₁)
      simp only [map_mul] at hE
      have h' : x * (algebraMap A K (algebraMap ↥W A ρ) * algebraMap A K q) =
          algebraMap A K p :=
        mul_left_cancel₀ (hinj d₁ hd₁) (by linear_combination hE)
      obtain ⟨r, hr⟩ := rootW N hN ρ
      have hr0 : r ≠ 0 := by
        rintro rfl
        exact hρ0 (by rw [← hr, zero_pow hN.ne'])
      have hrN : algebraMap A K (algebraMap ↥W A r) ^ N =
          algebraMap A K (algebraMap ↥W A ρ) := by
        rw [← map_pow, ← map_pow, hr]
      have hDρ := hinj ρ hρ0
      refine ⟨(algebraMap A K (algebraMap ↥W A r))⁻¹, inv_ne_zero (hinj r hr0), ?_, ?_⟩
      · rw [hO, hC]
        refine ⟨p, q, hq, ?_⟩
        rw [inv_pow, hrN, div_inv_eq_mul]
        linear_combination h'
      · rw [hO, hC]
        refine ⟨q, p, hp, ?_⟩
        rw [inv_pow, hrN, ← h']
        field_simp
    · subst hρ
      have hρ0 : ρ ≠ 0 := by
        rintro rfl
        exact hd₁ (mul_zero d₂)
      simp only [map_mul] at hE
      have h' : x * algebraMap A K q =
          algebraMap A K (algebraMap ↥W A ρ) * algebraMap A K p :=
        mul_left_cancel₀ (hinj d₂ hd₂) (by linear_combination hE)
      obtain ⟨r, hr⟩ := rootW N hN ρ
      have hr0 : r ≠ 0 := by
        rintro rfl
        exact hρ0 (by rw [← hr, zero_pow hN.ne'])
      have hrN : algebraMap A K (algebraMap ↥W A r) ^ N =
          algebraMap A K (algebraMap ↥W A ρ) := by
        rw [← map_pow, ← map_pow, hr]
      have hDρ := hinj ρ hρ0
      refine ⟨algebraMap A K (algebraMap ↥W A r), hinj r hr0, ?_, ?_⟩
      · rw [hO, hC]
        refine ⟨p, q, hq, ?_⟩
        rw [hrN, div_mul_eq_mul_div, div_eq_iff hDρ]
        linear_combination h'
      · rw [hO, hC]
        refine ⟨q, p, hp, ?_⟩
        rw [hrN, div_mul_eq_mul_div, div_eq_iff hx]
        linear_combination -h'

theorem wcLlsASbba_ratfunc_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) → ∃ ψ : RatFunc Ω →+* K, (∀ w : ↥W, ψ (algebraMap Ω (RatFunc Ω) (w : Ω)) = algebraMap A K (algebraMap ↥W A w)) ∧ ψ RatFunc.X = algebraMap A K u ∧ (letI : Algebra (RatFunc Ω) K := ψ.toAlgebra; FiniteDimensional (RatFunc Ω) K ∧ Algebra.IsSeparable (RatFunc Ω) K) :=
by
  intro Ω _ _ W _ _ A _ _ _ K _ _ _ 𝔭 u v g hPD
  classical

  have NF : ∀ (B : Type u) [CommRing B] (g : B)
      (r : MvPolynomial (Fin 2) B ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}),
      ∃ P Q : Polynomial B, r = Ideal.Quotient.mk
        (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} : Ideal (MvPolynomial (Fin 2) B))
        (Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0 : MvPolynomial (Fin 2) B) P +
          MvPolynomial.X 1 * Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 1 : MvPolynomial (Fin 2) B) Q) := by
    intro B _ g r
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective r
    induction p using MvPolynomial.induction_on with
    | C a =>
      refine ⟨Polynomial.C a, 0, ?_⟩
      simp
    | add p q hp hq =>
      obtain ⟨P1, Q1, h1⟩ := hp
      obtain ⟨P2, Q2, h2⟩ := hq
      refine ⟨P1 + P2, Q1 + Q2, ?_⟩
      rw [map_add, h1, h2, ← map_add]
      congr 1
      simp only [Polynomial.eval₂_add]
      ring
    | mul_X p n hp =>
      obtain ⟨P, Q, h1⟩ := hp
      suffices H : ∃ P' Q' : Polynomial B,
          Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} :
            Ideal (MvPolynomial (Fin 2) B))
            ((Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0 : MvPolynomial (Fin 2) B) P +
              MvPolynomial.X 1 * Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 1 : MvPolynomial (Fin 2) B) Q) *
              MvPolynomial.X n) =
          Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} :
            Ideal (MvPolynomial (Fin 2) B))
            (Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0 : MvPolynomial (Fin 2) B) P' +
              MvPolynomial.X 1 * Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 1 : MvPolynomial (Fin 2) B) Q') by
        obtain ⟨P', Q', h'⟩ := H
        exact ⟨P', Q', by rw [map_mul, h1, ← map_mul, h']⟩
      have hn : n = 0 ∨ n = 1 := by fin_cases n <;> simp
      rcases hn with rfl | rfl
      · refine ⟨P * Polynomial.X + Polynomial.C (g * Q.coeff 0), Polynomial.C g * Q.divX, ?_⟩
        apply Ideal.Quotient.eq.mpr
        rw [Ideal.mem_span_singleton']
        refine ⟨Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 1) Q, ?_⟩
        have hQ : Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 1 : MvPolynomial (Fin 2) B) Q =
            MvPolynomial.X 1 * Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 1) Q.divX +
              MvPolynomial.C (Q.coeff 0) := by
          conv_lhs => rw [← Polynomial.X_mul_divX_add Q]
          rw [Polynomial.eval₂_add, Polynomial.eval₂_X_mul, Polynomial.eval₂_C, mul_comm]
        have e1 : Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0 : MvPolynomial (Fin 2) B)
            (P * Polynomial.X + Polynomial.C (g * Q.coeff 0)) =
            Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) P * MvPolynomial.X 0 +
              MvPolynomial.C g * MvPolynomial.C (Q.coeff 0) := by
          rw [Polynomial.eval₂_add, Polynomial.eval₂_mul_X, Polynomial.eval₂_C, map_mul]
        have e2 : Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 1 : MvPolynomial (Fin 2) B)
            (Polynomial.C g * Q.divX) =
            MvPolynomial.C g * Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 1) Q.divX := by
          rw [Polynomial.eval₂_mul, Polynomial.eval₂_C]
        linear_combination e1 + MvPolynomial.X 1 * e2 - MvPolynomial.C g * hQ
      · refine ⟨Polynomial.C g * P.divX, Q * Polynomial.X + Polynomial.C (P.coeff 0), ?_⟩
        apply Ideal.Quotient.eq.mpr
        rw [Ideal.mem_span_singleton']
        refine ⟨Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) P.divX, ?_⟩
        have hP : Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0 : MvPolynomial (Fin 2) B) P =
            MvPolynomial.X 0 * Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) P.divX +
              MvPolynomial.C (P.coeff 0) := by
          conv_lhs => rw [← Polynomial.X_mul_divX_add P]
          rw [Polynomial.eval₂_add, Polynomial.eval₂_X_mul, Polynomial.eval₂_C, mul_comm]
        have e1 : Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0 : MvPolynomial (Fin 2) B)
            (Polynomial.C g * P.divX) =
            MvPolynomial.C g * Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) P.divX := by
          rw [Polynomial.eval₂_mul, Polynomial.eval₂_C]
        have e2 : Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 1 : MvPolynomial (Fin 2) B)
            (Q * Polynomial.X + Polynomial.C (P.coeff 0)) =
            Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 1) Q * MvPolynomial.X 1 +
              MvPolynomial.C (P.coeff 0) := by
          rw [Polynomial.eval₂_add, Polynomial.eval₂_mul_X, Polynomial.eval₂_C]
        linear_combination e1 + MvPolynomial.X 1 * e2 - MvPolynomial.X 1 * hP

  have hcomp : ∀ (B : Type u) [CommRing B] (R0 q : Polynomial B),
      Polynomial.toLaurent (q.comp R0) =
        Polynomial.eval₂ LaurentPolynomial.C (Polynomial.toLaurent R0) q := by
    intro B _ R0 q
    rw [Polynomial.comp, Polynomial.hom_eval₂]
    congr 1
    ext a
    simp

  have LI : ∀ (B : Type u) [CommRing B] [IsDomain B] (g : B), g ≠ 0 → ∀ P Q : Polynomial B,
      Polynomial.toLaurent P + LaurentPolynomial.C g * LaurentPolynomial.T (-1) *
        Polynomial.eval₂ LaurentPolynomial.C (LaurentPolynomial.C g * LaurentPolynomial.T (-1)) Q = 0 →
      P = 0 ∧ Q = 0 := by
    intro B _ _ g hg P Q hPQ
    have htr : ∀ Q : Polynomial B, LaurentPolynomial.trunc (LaurentPolynomial.C g * LaurentPolynomial.T (-1) *
        Polynomial.eval₂ LaurentPolynomial.C (LaurentPolynomial.C g * LaurentPolynomial.T (-1)) Q) = 0 := by
      intro Q
      refine Polynomial.induction_on' Q ?_ ?_
      · intro p q hp hq
        rw [Polynomial.eval₂_add, mul_add, map_add, hp, hq, add_zero]
      · intro n a
        rw [Polynomial.eval₂_monomial, mul_pow, LaurentPolynomial.T_pow,
          ← map_pow LaurentPolynomial.C g n]
        have e : LaurentPolynomial.C g * LaurentPolynomial.T (-1) * (LaurentPolynomial.C a *
            (LaurentPolynomial.C (g ^ n) * LaurentPolynomial.T ((n : ℤ) * -1))) =
            LaurentPolynomial.C (g * a * g ^ n) * LaurentPolynomial.T (-1 + (n : ℤ) * -1) := by
          rw [LaurentPolynomial.T_add, map_mul, map_mul]
          ring
        rw [e, LaurentPolynomial.trunc_C_mul_T, if_neg (by omega)]
    have hP : P = 0 := by
      have := congrArg LaurentPolynomial.trunc hPQ
      rwa [map_add, Polynomial.trunc_toLaurent, htr, add_zero, map_zero] at this
    subst hP
    refine ⟨rfl, ?_⟩
    rw [map_zero, zero_add] at hPQ
    have hCg : (LaurentPolynomial.C g : LaurentPolynomial B) ≠ 0 := by
      rw [← Polynomial.toLaurent_C]
      exact Polynomial.toLaurent_ne_zero.mpr (Polynomial.C_ne_zero.mpr hg)
    have hS : LaurentPolynomial.C g * LaurentPolynomial.T (-1) ≠ (0 : LaurentPolynomial B) :=
      mul_ne_zero hCg (LaurentPolynomial.isUnit_T (-1)).ne_zero
    have hQS := (mul_eq_zero.mp hPQ).resolve_left hS
    have e : (LaurentPolynomial.invert (R := B)).toAlgHom.toRingHom
        (Polynomial.eval₂ LaurentPolynomial.C (LaurentPolynomial.C g * LaurentPolynomial.T (-1)) Q) =
        Polynomial.toLaurent (Q.comp (Polynomial.C g * Polynomial.X)) := by
      have e' : ∀ x, (LaurentPolynomial.invert (R := B)).toAlgHom.toRingHom x =
          LaurentPolynomial.invert x := fun x => rfl
      rw [Polynomial.hom_eval₂, hcomp]
      congr 1
      · ext a
        rw [RingHom.comp_apply, e', LaurentPolynomial.invert_C]
      · rw [e', map_mul, LaurentPolynomial.invert_C, LaurentPolynomial.invert_T, map_mul,
          Polynomial.toLaurent_C, Polynomial.toLaurent_X]
        norm_num
    rw [hQS, map_zero] at e
    have hc : Q.comp (Polynomial.C g * Polynomial.X) = 0 :=
      Polynomial.toLaurent_injective (by rw [← e, map_zero])
    rcases Polynomial.comp_eq_zero_iff.mp hc with h | ⟨-, h⟩
    · exact h
    · exfalso
      have := congrArg (fun p => Polynomial.coeff p 1) h
      simp at this
      exact hg this

  have REG : ∀ (B : Type u) [CommRing B] [IsDomain B] (g : B), g ≠ 0 → ∀ q : Polynomial B, q ≠ 0 →
      ∀ r : MvPolynomial (Fin 2) B ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g},
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} :
        Ideal (MvPolynomial (Fin 2) B))
        (Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0 : MvPolynomial (Fin 2) B) q) * r = 0 → r = 0 := by
    intro B _ _ g hg q hq r hr
    obtain ⟨P, Q, rfl⟩ := NF B g r
    obtain ⟨ε0, hε0C, hε0X0, hε0X1⟩ : ∃ ε0 : MvPolynomial (Fin 2) B →+* LaurentPolynomial B,
        ε0.comp MvPolynomial.C = LaurentPolynomial.C ∧ ε0 (MvPolynomial.X 0) = LaurentPolynomial.T 1 ∧
        ε0 (MvPolynomial.X 1) = LaurentPolynomial.C g * LaurentPolynomial.T (-1) :=
      ⟨MvPolynomial.eval₂Hom LaurentPolynomial.C
        ![LaurentPolynomial.T 1, LaurentPolynomial.C g * LaurentPolynomial.T (-1)],
        MvPolynomial.eval₂Hom_comp_C _ _, by simp, by simp⟩
    have hker : ∀ a ∈ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} :
        Ideal (MvPolynomial (Fin 2) B)), ε0 a = 0 := by
      intro a ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      have h1 : ε0 (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g) = 0 := by
        rw [map_sub, map_mul, hε0X0, hε0X1, ← RingHom.comp_apply ε0 MvPolynomial.C, hε0C,
          mul_left_comm, ← LaurentPolynomial.T_add]
        norm_num
      rw [map_mul, h1, mul_zero]
    obtain ⟨ε, hε⟩ : ∃ ε : (MvPolynomial (Fin 2) B ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C g}) →+* LaurentPolynomial B, ∀ p, ε (Ideal.Quotient.mk _ p) = ε0 p :=
      ⟨Ideal.Quotient.lift _ ε0 hker, fun p => Ideal.Quotient.lift_mk _ _ _⟩
    have hE : ∀ (i : Fin 2) (Q : Polynomial B), ε0 (Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X i) Q) =
        Polynomial.eval₂ LaurentPolynomial.C (ε0 (MvPolynomial.X i)) Q := by
      intro i Q
      rw [Polynomial.hom_eval₂, hε0C]
    have hE0 : ∀ q : Polynomial B, ε0 (Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) q) =
        Polynomial.toLaurent q := by
      intro q
      have := hcomp B Polynomial.X q
      rw [Polynomial.comp_X, Polynomial.toLaurent_X] at this
      rw [hE, hε0X0, this]
    have h2 : Polynomial.toLaurent q * (Polynomial.toLaurent P + LaurentPolynomial.C g *
        LaurentPolynomial.T (-1) * Polynomial.eval₂ LaurentPolynomial.C
          (LaurentPolynomial.C g * LaurentPolynomial.T (-1)) Q) = 0 := by
      have := congrArg ε hr
      rw [map_mul, map_zero, hε, hε, map_add, map_mul, hE0, hE0, hE, hε0X1] at this
      exact this
    have h3 := (mul_eq_zero.mp h2).resolve_left (Polynomial.toLaurent_ne_zero.mpr hq)
    obtain ⟨rfl, rfl⟩ := LI B g hg P Q h3
    simp

  have hPD' := hPD
  obtain ⟨-, -, -, -, -, -, hg0, huv, -, h, hh𝔭, f, hfC, hfX0, hfX1, hfet⟩ := hPD'
  have hh0 : h ≠ 0 := by
    rintro rfl
    exact hh𝔭 (Ideal.zero_mem 𝔭)

  have htr : ∀ q : Polynomial ↥W, Polynomial.eval₂ (algebraMap ↥W A) u q = 0 → q = 0 := by
    intro q hq
    by_contra hq0
    have hfq : f (Ideal.Quotient.mk _ (Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) q)) = 0 := by
      have e1 : f (Ideal.Quotient.mk _ (Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) q)) =
          Polynomial.eval₂ (f.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C))
            (f (Ideal.Quotient.mk _ (MvPolynomial.X 0))) q := by
        have := Polynomial.hom_eval₂ q MvPolynomial.C (f.comp (Ideal.Quotient.mk _)) (MvPolynomial.X 0)
        simpa only [RingHom.comp_apply, RingHom.comp_assoc] using this
      rw [e1, hfC, hfX0, ← Polynomial.hom_eval₂, hq, map_zero]
    have FL : ∀ (P S : Type u) [CommRing P] [CommRing S] (f : P →+* S), f.Etale →
        ∀ x : P, (∀ a : P, x * a = 0 → a = 0) → f x = 0 → (1 : S) = 0 := by
      intro P S _ _ f hf x hx hfx
      letI : Algebra P S := f.toAlgebra
      haveI : Algebra.Etale P S := hf
      haveI : Module.Flat P S := Algebra.Smooth.flat P S
      have hreg0 : IsSMulRegular P x := by
        intro a b hab
        have hab' : x * (a - b) = 0 := by
          rw [mul_sub, sub_eq_zero]
          exact hab
        exact sub_eq_zero.mp (hx _ hab')
      have hreg := IsSMulRegular.of_flat (S := S) hreg0
      have hmap : algebraMap P S x = 0 := hfx
      rw [hmap] at hreg
      apply hreg
      simp
    have h10 : (1 : Localization.Away h) = 0 :=
      FL _ _ f hfet _ (fun a ha => REG ↥W g hg0 q hq0 a ha) hfq
    have hinj := IsLocalization.injective (Localization.Away h)
      (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
    exact one_ne_zero (hinj (by rw [map_one, map_zero]; exact h10))

  obtain ⟨ψ, hψW, hψX⟩ : ∃ ι : RatFunc Ω →+* K, (∀ a : ↥W, ι (algebraMap Ω (RatFunc Ω) (a : Ω)) =
      algebraMap A K (algebraMap ↥W A a)) ∧ ι RatFunc.X = algebraMap A K u := by
    have hW : ∀ w : ↥W, algebraMap ↥W A w = 0 → w = 0 := by
      intro w hw
      have := htr (Polynomial.C w) (by rw [Polynomial.eval₂_C]; exact hw)
      exact Polynomial.C_eq_zero.mp this
    have hg₀ : Function.Injective ((algebraMap A K).comp (algebraMap ↥W A)) := by
      rw [injective_iff_map_eq_zero]
      intro w hw
      apply hW
      apply IsFractionRing.injective A K
      rw [map_zero]
      exact hw
    let j₀ : Ω →+* K := IsFractionRing.lift (A := ↥W) (K := Ω) hg₀
    have hJ' : j₀.comp (algebraMap ↥W Ω) = (algebraMap A K).comp (algebraMap ↥W A) := by
      ext w
      exact IsFractionRing.lift_algebraMap hg₀ w
    have hJ : ∀ w : ↥W, j₀ (w : Ω) = algebraMap A K (algebraMap ↥W A w) := by
      intro w
      have := congrArg (fun f => f w) hJ'
      simpa using this
    let ψ₀ : Polynomial Ω →+* K := Polynomial.eval₂RingHom j₀ (algebraMap A K u)
    have hψ₀ : Function.Injective ψ₀ := by
      rw [injective_iff_map_eq_zero]
      intro p hp
      have hp' : Polynomial.eval₂ j₀ (algebraMap A K u) p = 0 := hp
      have h1 := IsLocalization.integerNormalization_eval₂_eq_zero (nonZeroDivisors ↥W) j₀ p hp'
      rw [hJ'] at h1
      have h2 : algebraMap A K (Polynomial.eval₂ (algebraMap ↥W A) u
          (IsLocalization.integerNormalization (nonZeroDivisors ↥W) p)) = 0 := by
        rw [Polynomial.hom_eval₂]
        exact h1
      have h3 := htr _ ((injective_iff_map_eq_zero (algebraMap A K)).mp
        (IsFractionRing.injective A K) _ h2)
      exact (IsFractionRing.integerNormalization_eq_zero_iff).mp h3
    let ι : RatFunc Ω →+* K := IsFractionRing.lift (A := Polynomial Ω) (K := RatFunc Ω) hψ₀
    refine ⟨ι, ?_, ?_⟩
    · intro a
      have e : algebraMap Ω (RatFunc Ω) (a : Ω) =
          algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C (a : Ω)) := by
        rw [RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
      rw [e]
      show IsFractionRing.lift hψ₀ (algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C (a : Ω))) = _
      rw [IsFractionRing.lift_algebraMap]
      show Polynomial.eval₂ j₀ (algebraMap A K u) (Polynomial.C (a : Ω)) = _
      rw [Polynomial.eval₂_C, hJ]
    · rw [← RatFunc.algebraMap_X]
      show IsFractionRing.lift hψ₀ (algebraMap (Polynomial Ω) (RatFunc Ω) Polynomial.X) = _
      rw [IsFractionRing.lift_algebraMap]
      show Polynomial.eval₂ j₀ (algebraMap A K u) Polynomial.X = _
      rw [Polynomial.eval₂_X]
  have hu0 : algebraMap A K u ≠ 0 := by
    intro h0
    have hu : u = 0 := IsFractionRing.injective A K (h0.trans (map_zero _).symm)
    have := htr Polynomial.X (by rw [Polynomial.eval₂_X, hu])
    exact Polynomial.X_ne_zero this

  have hu : IsUnit (algebraMap A K h) := by
    refine IsUnit.mk0 _ ?_
    intro h0
    exact hh0 ((IsFractionRing.injective A K) (h0.trans (map_zero _).symm))
  let σ : Localization.Away h →+* K := IsLocalization.Away.lift h hu
  have hσ : ∀ a : A, σ (algebraMap A (Localization.Away h) a) = algebraMap A K a :=
    fun a => IsLocalization.Away.lift_eq h hu a
  obtain ⟨κ0, hκ0C, hκ0X0, hκ0X1⟩ : ∃ κ0 : MvPolynomial (Fin 2) ↥W →+* RatFunc Ω,
      (∀ w : ↥W, κ0 (MvPolynomial.C w) = algebraMap Ω (RatFunc Ω) (w : Ω)) ∧
      κ0 (MvPolynomial.X 0) = RatFunc.X ∧
      κ0 (MvPolynomial.X 1) = algebraMap Ω (RatFunc Ω) (g : Ω) / RatFunc.X :=
    ⟨MvPolynomial.eval₂Hom ((algebraMap Ω (RatFunc Ω)).comp W.subtype)
      ![RatFunc.X, algebraMap Ω (RatFunc Ω) (g : Ω) / RatFunc.X], fun w => by simp, by simp, by simp⟩
  have hkerκ : ∀ a ∈ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} :
      Ideal (MvPolynomial (Fin 2) ↥W)), κ0 a = 0 := by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    have h1 : κ0 (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g) = 0 := by
      rw [map_sub, map_mul, hκ0X0, hκ0X1, hκ0C, mul_div_cancel₀ _ RatFunc.X_ne_zero, sub_self]
    rw [map_mul, h1, mul_zero]
  obtain ⟨κ, hκ⟩ : ∃ κ : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C g}) →+* RatFunc Ω, ∀ p, κ (Ideal.Quotient.mk _ p) = κ0 p :=
    ⟨Ideal.Quotient.lift _ κ0 hkerκ, fun p => Ideal.Quotient.lift_mk _ _ _⟩
  have hsq : σ.comp f = ψ.comp κ := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro w
      have e1 := RingHom.congr_fun hfC w
      simp only [RingHom.comp_apply] at e1 ⊢
      rw [e1, hσ, hκ, hκ0C, hψW]
    · intro i
      have hi : i = 0 ∨ i = 1 := by fin_cases i <;> simp
      rcases hi with rfl | rfl
      · simp only [RingHom.comp_apply]
        rw [hfX0, hσ, hκ, hκ0X0, hψX]
      · simp only [RingHom.comp_apply]
        rw [hfX1, hσ, hκ, hκ0X1, map_div₀, hψW, hψX, eq_div_iff hu0, ← map_mul, mul_comm, huv]

  have TR : ∀ (P S F K : Type u) [CommRing P] [CommRing S] [Field F] [Field K] (f : P →+* S)
      (σ : S →+* K) (κ : P →+* F) (ι : F →+* K), f.Etale →
      (letI : Algebra S K := σ.toAlgebra; IsFractionRing S K) → σ.comp f = ι.comp κ →
      letI : Algebra F K := ι.toAlgebra; FiniteDimensional F K ∧ Algebra.IsSeparable F K := by
    intro P S F K _ _ _ _ f σ κ ι hfet hfrac hsq
    letI : Algebra P S := f.toAlgebra
    letI : Algebra S K := σ.toAlgebra
    letI : Algebra P K := (σ.comp f).toAlgebra
    letI : Algebra P F := κ.toAlgebra
    letI : Algebra F K := ι.toAlgebra
    haveI : IsScalarTower P S K := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : IsScalarTower P F K := IsScalarTower.of_algebraMap_eq (fun x => RingHom.congr_fun hsq x)
    haveI : Algebra.Etale P S := hfet
    haveI : IsFractionRing S K := hfrac
    haveI : Algebra.FormallyUnramified S K :=
      Algebra.FormallyUnramified.of_isLocalization (nonZeroDivisors S)
    haveI : Algebra.EssFiniteType S K :=
      Algebra.EssFiniteType.of_isLocalization K (nonZeroDivisors S)
    haveI : Algebra.FiniteType P S := inferInstance
    haveI : Algebra.EssFiniteType P S := Algebra.EssFiniteType.of_finiteType P S
    haveI : Algebra.FormallyUnramified P K := Algebra.FormallyUnramified.comp P S K
    haveI : Algebra.EssFiniteType P K := Algebra.EssFiniteType.comp P S K
    haveI : Algebra.FormallyUnramified F K := Algebra.FormallyUnramified.of_restrictScalars P F K
    haveI : Algebra.EssFiniteType F K := Algebra.EssFiniteType.of_comp P F K
    exact ⟨Algebra.FormallyUnramified.finite_of_free F K, Algebra.FormallyUnramified.isSeparable F K⟩
  refine ⟨ψ, hψW, hψX, ?_⟩
  have hfrac : (letI : Algebra (Localization.Away h) K := σ.toAlgebra;
      IsFractionRing (Localization.Away h) K) := by
    letI : Algebra (Localization.Away h) K := σ.toAlgebra
    haveI : IsScalarTower A (Localization.Away h) K :=
      IsScalarTower.of_algebraMap_eq (fun a => (hσ a).symm)
    exact IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers h)
      (Localization.Away h) K
  exact TR (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
    MvPolynomial.C g}) (Localization.Away h) (RatFunc Ω) K f σ κ ψ hfet hfrac hsq

theorem wcLlsASbba_gauss_contract : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) → ∀ ψ : RatFunc Ω →+* K, (∀ w : ↥W, ψ (algebraMap Ω (RatFunc Ω) (w : Ω)) = algebraMap A K (algebraMap ↥W A w)) → ψ RatFunc.X = algebraMap A K u → ∀ O : ValuationSubring K, (∀ x : K, x ∈ O ↔ ∃ a b : A, (∀ s : A, s ∉ 𝔭 → s * b ∉ Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧ x * algebraMap A K b = algebraMap A K a) → ∀ f : RatFunc Ω, ψ f ∈ O ↔ f ∈ wcEbGauss W :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 u v g hPD ψ hψW hψX O hOmem
  classical
  have hPD' := hPD
  obtain ⟨hFT, hNZ, -, h𝔭max, hm𝔭, -, -, -, h𝔭eq, -⟩ := hPD'
  haveI := hNZ
  have h𝔭p : 𝔭.IsPrime := h𝔭max.isPrime
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h => h𝔭p.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have hu𝔭 : u ∈ 𝔭 := by
    rw [h𝔭eq]
    exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
  have hmJ : ∀ x ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A),
      x ∈ Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) :=
    fun x hx => Ideal.mem_sup_right hx
  have haW0 : ∀ c : ↥W, c ≠ 0 → algebraMap ↥W A c ≠ 0 := by
    intro c hc h0
    rw [Algebra.algebraMap_eq_smul_one] at h0
    rcases smul_eq_zero.mp h0 with h1 | h1
    · exact hc h1
    · exact one_ne_zero h1
  have hι0 : ∀ c : ↥W, c ≠ 0 → algebraMap A K (algebraMap ↥W A c) ≠ 0 := fun c hc h0 =>
    haW0 c hc (IsFractionRing.injective A K (by rw [h0, map_zero]))

  have Hdec : ∀ q : Polynomial ↥W, Polynomial.eval₂ (algebraMap ↥W A) u q =
      Polynomial.eval₂ (algebraMap ↥W A) u q.divX * u + algebraMap ↥W A (q.coeff 0) := by
    intro q
    conv_lhs => rw [← Polynomial.X_mul_divX_add q]
    rw [Polynomial.eval₂_add, Polynomial.eval₂_X_mul, Polynomial.eval₂_C]

  have HD : ∀ n : ℕ, ∀ q : Polynomial ↥W, IsUnit (q.coeff n) → ∃ (j : ℕ) (ε : A), ε ∉ 𝔭 ∧
      Polynomial.eval₂ (algebraMap ↥W A) u q - u ^ j * ε ∈
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
    have caseA : ∀ q : Polynomial ↥W, IsUnit (q.coeff 0) → ∃ (j : ℕ) (ε : A), ε ∉ 𝔭 ∧
        Polynomial.eval₂ (algebraMap ↥W A) u q - u ^ j * ε ∈
          (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
      intro q hq
      refine ⟨0, Polynomial.eval₂ (algebraMap ↥W A) u q, ?_, ?_⟩
      · intro hq𝔭
        apply h𝔭p.ne_top
        apply Ideal.eq_top_of_isUnit_mem _ _ (hq.map (algebraMap ↥W A))
        have e : algebraMap ↥W A (q.coeff 0) = Polynomial.eval₂ (algebraMap ↥W A) u q -
            Polynomial.eval₂ (algebraMap ↥W A) u q.divX * u := by
          rw [Hdec q]; ring
        rw [e]
        exact Ideal.sub_mem _ hq𝔭 (Ideal.mul_mem_left _ _ hu𝔭)
      · rw [pow_zero, one_mul, sub_self]
        exact Submodule.zero_mem _
    intro n
    induction n with
    | zero => exact caseA
    | succ j ih =>
      intro q hq
      by_cases h0 : IsUnit (q.coeff 0)
      · exact caseA q h0
      · have hm : q.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W :=
          (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr h0)
        have hdiv : IsUnit (q.divX.coeff j) := by rw [Polynomial.coeff_divX]; exact hq
        obtain ⟨j', ε', hε', hR⟩ := ih q.divX hdiv
        refine ⟨j' + 1, ε', hε', ?_⟩
        have e : Polynomial.eval₂ (algebraMap ↥W A) u q - u ^ (j' + 1) * ε' =
            (Polynomial.eval₂ (algebraMap ↥W A) u q.divX - u ^ j' * ε') * u +
              algebraMap ↥W A (q.coeff 0) := by
          rw [Hdec q]; ring
        rw [e]
        exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hR) (Ideal.mem_map_of_mem _ hm)

  have HNB : ∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) → ∀ s : A, s ∉ 𝔭 →
      s * Polynomial.eval₂ (algebraMap ↥W A) u q ∉
        Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
    rintro q ⟨i, hi⟩ s hs hJ
    obtain ⟨j, ε, hε, hR⟩ := HD i q hi
    apply wcpa_dj_llsm_kpwulbc_branch_upow Ω W A 𝔭 u v g hPD j (s * ε) (h𝔭p.mul_notMem hs hε)
    have e : s * ε * u ^ j = s * Polynomial.eval₂ (algebraMap ↥W A) u q -
        s * (Polynomial.eval₂ (algebraMap ↥W A) u q - u ^ j * ε) := by ring
    rw [e]
    exact Ideal.sub_mem _ hJ (hmJ _ (Ideal.mul_mem_left _ s hR))

  have Htr : ∀ r : Polynomial ↥W,
      ψ (algebraMap (Polynomial Ω) (RatFunc Ω) (r.map W.subtype)) =
        algebraMap A K (Polynomial.eval₂ (algebraMap ↥W A) u r) := by
    intro r
    have e : (ψ.comp (algebraMap (Polynomial Ω) (RatFunc Ω))).comp
        (Polynomial.mapRingHom W.subtype) =
        (algebraMap A K).comp (Polynomial.eval₂RingHom (algebraMap ↥W A) u) := by
      apply Polynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C,
          Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        rw [RatFunc.algebraMap_C, ← RatFunc.algebraMap_eq_C]
        exact hψW a
      · simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X,
          Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, RatFunc.algebraMap_X]
        exact hψX
    exact RingHom.congr_fun e r

  have Hle : ∀ f ∈ wcEbGauss W, ψ f ∈ O := by
    intro f hf
    have hle : wcEbGauss W ≤ O.toSubring.comap ψ := by
      unfold wcEbGauss
      rw [Subring.closure_le]
      rintro g' ⟨p, q, hunit, -, hgq⟩
      show ψ g' ∈ O
      have e := congrArg ψ hgq
      rw [map_mul, Htr, Htr] at e
      exact (hOmem (ψ g')).mpr ⟨_, _, HNB q hunit, e⟩
    exact hle hf

  obtain ⟨V, hV, hVW, -, hVdec⟩ := wcpa_dj_lr1k_gd_gauss_valuation Ω W
  have hVG : ∀ f : RatFunc Ω, f ∈ V ↔ f ∈ wcEbGauss W := by
    intro f
    rw [← hV]
    exact Iff.rfl
  refine fun f => ⟨fun hf => ?_, Hle f⟩
  rw [← hVG]
  by_contra hfV
  have hf0 : f ≠ 0 := by
    rintro rfl
    exact hfV (zero_mem V)
  obtain ⟨a, ha0, μ, hfa⟩ := hVdec f hf0
  have huu : ((μ : V) : RatFunc Ω) * (((μ⁻¹ : Vˣ) : V) : RatFunc Ω) = 1 :=
    congrArg Subtype.val μ.mul_inv
  have hcalg : algebraMap Ω (RatFunc Ω) a = f * (((μ⁻¹ : Vˣ) : V) : RatFunc Ω) := by
    rw [hfa, mul_assoc, huu, mul_one]
  have haV : algebraMap Ω (RatFunc Ω) a ∉ V := by
    intro h
    apply hfV
    rw [hfa]
    exact mul_mem h (μ : V).2
  have haW : a ∉ W := fun h => haV ((hVW a).mpr h)
  have hainvW : a⁻¹ ∈ W := (W.mem_or_inv_mem a).resolve_left haW
  set c : ↥W := ⟨a⁻¹, hainvW⟩ with hcdef
  have hcval : (c : Ω) = a⁻¹ := rfl
  have hc0 : c ≠ 0 := by
    intro h
    have : (c : Ω) = 0 := by rw [h]; rfl
    exact inv_ne_zero ha0 (hcval ▸ this)
  have hcm : c ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hnm
    have hcu : IsUnit c := by
      by_contra hnu
      exact hnm ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu))
    obtain ⟨d, hd⟩ := hcu.exists_right_inv
    have hd' : (c : Ω) * (d : Ω) = 1 := congrArg Subtype.val hd
    rw [hcval] at hd'
    have hda : (d : Ω) = a := by
      calc (d : Ω) = a * (a⁻¹ * (d : Ω)) := by rw [← mul_assoc, mul_inv_cancel₀ ha0, one_mul]
        _ = a := by rw [hd', mul_one]
    exact haW (hda ▸ d.2)
  have hψa_mem : ψ (algebraMap Ω (RatFunc Ω) a) ∈ O := by
    rw [hcalg, map_mul]
    exact mul_mem hf (Hle _ ((hVG _).mp ((μ⁻¹ : Vˣ) : V).2))
  have hψa : ψ (algebraMap Ω (RatFunc Ω) a) = (algebraMap A K (algebraMap ↥W A c))⁻¹ := by
    have e : a = ((c : Ω))⁻¹ := by rw [hcval, inv_inv]
    rw [e, map_inv₀, map_inv₀, hψW c]
  rw [hψa] at hψa_mem
  obtain ⟨a', b, hNB, hab⟩ := (hOmem _).mp hψa_mem
  have hb' : algebraMap A K b = algebraMap A K (algebraMap ↥W A c * a') := by
    rw [map_mul, ← hab, ← mul_assoc, mul_inv_cancel₀ (hι0 c hc0), one_mul]
  have hbeq := IsFractionRing.injective A K hb'
  apply hNB 1 h1𝔭
  rw [one_mul, hbeq]
  exact hmJ _ (Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hcm))

theorem wcLlsASbfd_bourbaki_integral : ∀ (R K : Type u) [CommRing R] [Field K] [Algebra R K] (n : ℕ) (b : ℕ → R) (x : K), (∑ i ∈ Finset.range (n + 1), algebraMap R K (b i) * x ^ i) = 0 → ∀ k : ℕ, IsIntegral R (∑ i ∈ Finset.Ioc k n, algebraMap R K (b i) * x ^ (i - k)) :=
by
  intro R K _ _ _ n b x hH k
  classical
  by_cases hkn : n ≤ k
  · rw [Finset.Ioc_eq_empty_of_le hkn, Finset.sum_empty]
    exact isIntegral_zero
  have hkn' : k < n := lt_of_not_ge hkn
  obtain ⟨y, hy⟩ : ∃ y : K, y = ∑ i ∈ Finset.Ioc k n, algebraMap R K (b i) * x ^ (i - k) :=
    ⟨_, rfl⟩
  rw [← hy]
  obtain ⟨N, hN⟩ : ∃ N : Submodule R K, N = Submodule.span R ((fun j : ℕ => x ^ j) '' Set.Iio n) :=
    ⟨_, rfl⟩
  have hmem : ∀ (r : R) (j : ℕ), j < n → algebraMap R K r * x ^ j ∈ N := by
    intro r j hj
    rw [← Algebra.smul_def, hN]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, Set.mem_Iio.mpr hj, rfl⟩)
  have htail : y * x ^ k = -∑ i ∈ Finset.range (k + 1), algebraMap R K (b i) * x ^ i := by
    have ha : y * x ^ k = ∑ i ∈ Finset.Ioc k n, algebraMap R K (b i) * x ^ i := by
      rw [hy, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun i hi => ?_)
      have hi' := (Finset.mem_Ioc.mp hi).1
      rw [mul_assoc, ← pow_add, Nat.sub_add_cancel hi'.le]
    have hb : ∑ i ∈ Finset.range (n + 1), algebraMap R K (b i) * x ^ i =
        ∑ i ∈ Finset.range (k + 1), algebraMap R K (b i) * x ^ i +
          ∑ i ∈ Finset.Ioc k n, algebraMap R K (b i) * x ^ i := by
      rw [← Finset.sum_range_add_sum_Ico _ (by omega : k + 1 ≤ n + 1)]
      congr 1
      apply Finset.sum_congr _ (fun _ _ => rfl)
      ext i
      simp only [Finset.mem_Ico, Finset.mem_Ioc]
      omega
    rw [ha]
    rw [hb] at hH
    linear_combination hH
  have hstab : ∀ e : ℕ, e < n → y * x ^ e ∈ N := by
    intro e he
    by_cases hek : e < k
    · have h1 : y * x ^ e = ∑ i ∈ Finset.Ioc k n, algebraMap R K (b i) * x ^ (i - k + e) := by
        rw [hy, Finset.sum_mul]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [mul_assoc, ← pow_add]
      rw [h1]
      refine Submodule.sum_mem _ (fun i hi => hmem _ _ ?_)
      have := Finset.mem_Ioc.mp hi
      omega
    · have hek' : k ≤ e := le_of_not_gt hek
      have h1 : y * x ^ e =
          -∑ i ∈ Finset.range (k + 1), algebraMap R K (b i) * x ^ (i + (e - k)) := by
        have hxe : x ^ e = x ^ k * x ^ (e - k) := by rw [← pow_add, Nat.add_sub_cancel' hek']
        rw [hxe, ← mul_assoc, htail, neg_mul, Finset.sum_mul]
        congr 1
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [mul_assoc, ← pow_add]
      rw [h1]
      refine Submodule.neg_mem _ (Submodule.sum_mem _ (fun i hi => hmem _ _ ?_))
      have := Finset.mem_range.mp hi
      omega
  have hfg : N.FG := by
    rw [hN]
    exact Submodule.fg_span ((Set.finite_Iio n).image _)
  have hne : N ≠ ⊥ := by
    rw [Submodule.ne_bot_iff]
    refine ⟨1, ?_, one_ne_zero⟩
    rw [← pow_zero x, hN]
    exact Submodule.subset_span ⟨0, Set.mem_Iio.mpr (by omega), rfl⟩
  refine isIntegral_of_smul_mem_submodule N hne hfg y ?_
  intro m hm
  rw [smul_eq_mul]
  rw [hN] at hm
  induction hm using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨j, hj, rfl⟩ := hz
    exact hstab j hj
  | zero => rw [mul_zero]; exact N.zero_mem
  | add a c _ _ ha hc => rw [mul_add]; exact N.add_mem ha hc
  | smul r a _ ha => rw [mul_smul_comm]; exact N.smul_mem r ha

theorem wcLlsASbfd_finite_transfer : ∀ (F K L : Type u) [Field F] [Field K] [Field L] [Algebra F K] [Algebra K L] [Algebra F L] [IsScalarTower F K L] (R₀ : Subring F) (O : ValuationSubring K), (∀ f ∈ R₀, algebraMap F K f ∈ O) → (letI : Algebra ↥R₀ K := ((algebraMap F K).comp R₀.subtype).toAlgebra; ∀ x ∈ O, ∃ s z : K, s ∈ O ∧ s ≠ 0 ∧ s⁻¹ ∈ O ∧ IsIntegral ↥R₀ s ∧ IsIntegral ↥R₀ z ∧ s * x = z) → (letI : Algebra ↥R₀ L := ((algebraMap F L).comp R₀.subtype).toAlgebra; Module.Finite ↥R₀ ↥(integralClosure ↥R₀ L)) → (letI : Algebra ↥O L := ((algebraMap K L).comp O.subtype).toAlgebra; Module.Finite ↥O ↥(integralClosure ↥O L)) :=
by
  classical
  intro F K L _ _ _ _ _ _ _ R₀ O hR₀ hU hD
  letI iRK : Algebra ↥R₀ K := ((algebraMap F K).comp R₀.subtype).toAlgebra
  letI iRL : Algebra ↥R₀ L := ((algebraMap F L).comp R₀.subtype).toAlgebra
  letI iOL : Algebra ↥O L := ((algebraMap K L).comp O.subtype).toAlgebra
  have hU' : ∀ x ∈ O, ∃ s z : K, s ∈ O ∧ s ≠ 0 ∧ s⁻¹ ∈ O ∧ IsIntegral ↥R₀ s ∧
      IsIntegral ↥R₀ z ∧ s * x = z := hU
  have hD' : Module.Finite ↥R₀ ↥(integralClosure ↥R₀ L) := hD
  show Module.Finite ↥O ↥(integralClosure ↥O L)

  have hRKL : ∀ r : ↥R₀, algebraMap K L (algebraMap ↥R₀ K r) = algebraMap ↥R₀ L r := by
    intro r
    show algebraMap K L (algebraMap F K (r : F)) = algebraMap F L (r : F)
    exact (IsScalarTower.algebraMap_apply F K L (r : F)).symm
  have hmapKL : ∀ a : K, IsIntegral ↥R₀ a → IsIntegral ↥R₀ (algebraMap K L a) := by
    intro a ha
    refine IsIntegral.map_of_comp_eq (RingHom.id ↥R₀) (algebraMap K L) ?_ ha
    refine RingHom.ext fun r => ?_
    show algebraMap ↥R₀ L r = algebraMap K L (algebraMap ↥R₀ K r)
    exact (hRKL r).symm
  let φ : ↥R₀ →+* ↥O := ((algebraMap F K).comp R₀.subtype).codRestrict O (fun r => hR₀ r r.2)
  have hφ : ∀ r : ↥R₀, algebraMap ↥O L (φ r) = algebraMap ↥R₀ L r := by
    intro r
    show algebraMap K L (algebraMap F K (r : F)) = algebraMap F L (r : F)
    exact (IsScalarTower.algebraMap_apply F K L (r : F)).symm
  have hO_int : ∀ c : L, IsIntegral ↥R₀ c → IsIntegral ↥O c := by
    intro c hc
    refine IsIntegral.map_of_comp_eq φ (RingHom.id L) ?_ hc
    exact RingHom.ext fun r => hφ r

  have hscale : ∀ y : L, IsIntegral ↥O y → ∃ s : K, s ∈ O ∧ s ≠ 0 ∧ s⁻¹ ∈ O ∧
      IsIntegral ↥R₀ (algebraMap K L s * y) := by
    intro y hy
    obtain ⟨p, hpm, hpy⟩ := hy
    have hA : ∀ T : Finset ℕ, ∃ s : K, s ∈ O ∧ s ≠ 0 ∧ s⁻¹ ∈ O ∧ IsIntegral ↥R₀ s ∧
        ∀ i ∈ T, IsIntegral ↥R₀ ((p.coeff i : K) * s) := by
      intro T
      refine Finset.induction_on T ?_ ?_
      · exact ⟨1, O.one_mem, one_ne_zero, by rw [inv_one]; exact O.one_mem, isIntegral_one,
          by simp⟩
      · intro j T _ ih
        obtain ⟨s', hs'O, hs'0, hs'inv, hs'int, hs'T⟩ := ih
        obtain ⟨t, z, htO, ht0, htinv, htint, hzint, htz⟩ := hU' (p.coeff j : K) (p.coeff j).2
        refine ⟨t * s', O.mul_mem _ _ htO hs'O, mul_ne_zero ht0 hs'0, ?_, htint.mul hs'int, ?_⟩
        · rw [mul_inv]; exact O.mul_mem _ _ htinv hs'inv
        · intro i hi
          rcases Finset.mem_insert.mp hi with h | hi
          · rw [h]
            have e : (p.coeff j : K) * (t * s') = z * s' := by rw [← htz]; ring
            rw [e]; exact hzint.mul hs'int
          · have e : (p.coeff i : K) * (t * s') = t * ((p.coeff i : K) * s') := by ring
            rw [e]; exact htint.mul (hs'T i hi)
    obtain ⟨s, hsO, hs0, hsinv, hsint, hsT⟩ := hA (Finset.range p.natDegree)
    refine ⟨s, hsO, hs0, hsinv, ?_⟩
    obtain ⟨s', hs'⟩ : ∃ s' : ↥O, (s' : K) = s := ⟨⟨s, hsO⟩, rfl⟩
    have hs'L : algebraMap ↥O L s' = algebraMap K L s := by
      show algebraMap K L (s' : K) = _
      rw [hs']
    have hroot : Polynomial.aeval (algebraMap ↥O L s' * y) (p.scaleRoots s') = 0 :=
      Polynomial.scaleRoots_aeval_eq_zero (by rw [Polynomial.aeval_def]; exact hpy)
    have hqm : (p.scaleRoots s').Monic := (Polynomial.monic_scaleRoots_iff s').mpr hpm
    have hqdeg : (p.scaleRoots s').natDegree = p.natDegree := Polynomial.natDegree_scaleRoots p s'
    have hcoeff : ∀ i, IsIntegral ↥R₀ (algebraMap ↥O L ((p.scaleRoots s').coeff i)) := by
      intro i
      rcases lt_trichotomy i p.natDegree with hi | hi | hi
      · rw [Polynomial.coeff_scaleRoots]
        obtain ⟨k, hk⟩ : ∃ k, p.natDegree - i = k + 1 := ⟨p.natDegree - i - 1, by omega⟩
        have e : algebraMap ↥O L (p.coeff i * s' ^ (p.natDegree - i)) =
            algebraMap K L (((p.coeff i : K) * s) * s ^ k) := by
          rw [hk]
          show algebraMap K L ((p.coeff i * s' ^ (k + 1) : ↥O) : K) = _
          push_cast
          rw [hs']
          ring_nf
        rw [e]
        exact hmapKL _ ((hsT i (Finset.mem_range.mpr hi)).mul (hsint.pow k))
      · rw [← hqdeg] at hi
        rw [hi, hqm.coeff_natDegree, map_one]
        exact isIntegral_one
      · rw [← hqdeg] at hi
        rw [Polynomial.coeff_eq_zero_of_natDegree_lt hi, map_zero]
        exact isIntegral_zero
    have hlifts : (p.scaleRoots s').map (algebraMap ↥O L) ∈
        Polynomial.lifts (algebraMap ↥(integralClosure ↥R₀ L) L) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [Polynomial.coeff_map]
      exact ⟨⟨_, (mem_integralClosure_iff _ _).mpr (hcoeff i)⟩, rfl⟩
    obtain ⟨q', hq'map, -, hq'm⟩ :=
      Polynomial.lifts_and_natDegree_eq_and_monic hlifts (hqm.map _)
    have hxC : IsIntegral ↥(integralClosure ↥R₀ L) (algebraMap ↥O L s' * y) := by
      refine ⟨q', hq'm, ?_⟩
      rw [Polynomial.eval₂_eq_eval_map, hq'map, Polynomial.eval_map, ← Polynomial.aeval_def]
      exact hroot
    have hfin := isIntegral_trans (R := ↥R₀) (A := ↥(integralClosure ↥R₀ L)) _ hxC
    rw [hs'L] at hfin
    exact hfin

  obtain ⟨G, hG⟩ := Module.finite_def.mp hD'
  have key : Subalgebra.toSubmodule (integralClosure ↥O L) =
      Submodule.span ↥O (Subtype.val '' (G : Set (integralClosure ↥R₀ L))) := by
    apply le_antisymm
    · intro y hy
      have hy' : IsIntegral ↥O y := hy
      obtain ⟨s, -, hs0, hsinv, hx⟩ := hscale y hy'
      have hxmem : (⟨_, (mem_integralClosure_iff _ _).mpr hx⟩ : integralClosure ↥R₀ L) ∈
          Submodule.span ↥R₀ (G : Set (integralClosure ↥R₀ L)) := by
        rw [hG]; trivial
      have hx2 : algebraMap K L s * y ∈
          Submodule.span ↥R₀ (Subtype.val '' (G : Set (integralClosure ↥R₀ L))) := by
        have := Submodule.mem_map_of_mem (f := (integralClosure ↥R₀ L).val.toLinearMap) hxmem
        rw [Submodule.map_span] at this
        exact this
      have hx3 : algebraMap K L s * y ∈
          Submodule.span ↥O (Subtype.val '' (G : Set (integralClosure ↥R₀ L))) := by
        refine Submodule.span_induction (p := fun z _ => z ∈ Submodule.span ↥O
          (Subtype.val '' (G : Set (integralClosure ↥R₀ L)))) ?_ ?_ ?_ ?_ hx2
        · intro z hz; exact Submodule.subset_span hz
        · exact Submodule.zero_mem _
        · intro a b _ _ ha hb; exact Submodule.add_mem _ ha hb
        · intro r z _ hz
          have e : r • z = φ r • z := by rw [Algebra.smul_def, Algebra.smul_def, hφ]
          rw [e]; exact Submodule.smul_mem _ _ hz
      have e : y = (⟨s⁻¹, hsinv⟩ : ↥O) • (algebraMap K L s * y) := by
        rw [Algebra.smul_def]
        show y = algebraMap K L s⁻¹ * (algebraMap K L s * y)
        rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ hs0, map_one, one_mul]
      rw [e]; exact Submodule.smul_mem _ _ hx3
    · rw [Submodule.span_le]
      rintro _ ⟨c, -, rfl⟩
      exact hO_int c.1 c.2
  have hfg : (Subalgebra.toSubmodule (integralClosure ↥O L)).FG := by
    rw [key]; exact Submodule.fg_span (G.finite_toSet.image _)
  exact Module.Finite.iff_fg.mpr hfg

theorem wcLlsASbfd_unit_fraction : ∀ (F K : Type u) [Field F] [Field K] [Algebra F K] [Algebra.IsAlgebraic F K] (V : ValuationSubring F) (R₀ : Subring F), V.toSubring = R₀ → ∀ O : ValuationSubring K, (∀ f ∈ V, algebraMap F K f ∈ O) → (∀ f ∈ V, f ≠ 0 → (algebraMap F K f)⁻¹ ∈ O → f⁻¹ ∈ V) → letI : Algebra ↥R₀ K := ((algebraMap F K).comp R₀.subtype).toAlgebra; (∀ (n : ℕ) (b : ℕ → ↥R₀) (x : K), (∑ i ∈ Finset.range (n + 1), algebraMap ↥R₀ K (b i) * x ^ i) = 0 → ∀ k : ℕ, IsIntegral ↥R₀ (∑ i ∈ Finset.Ioc k n, algebraMap ↥R₀ K (b i) * x ^ (i - k))) → ∀ x ∈ O, ∃ s z : K, s ∈ O ∧ s ≠ 0 ∧ s⁻¹ ∈ O ∧ IsIntegral ↥R₀ s ∧ IsIntegral ↥R₀ z ∧ s * x = z :=
by
  intro F K _ _ _ _ V R₀ hR O H1 H2 hB x hx
  letI : Algebra ↥R₀ K := ((algebraMap F K).comp R₀.subtype).toAlgebra
  classical

  have hα : ∀ f ∈ V, V.valuation f < 1 → O.valuation (algebraMap F K f) < 1 := by
    intro f hf hv
    have h1 : O.valuation (algebraMap F K f) ≤ 1 := (O.valuation_le_one_iff _).mpr (H1 f hf)
    refine lt_of_le_of_ne h1 (fun heq => ?_)
    have hf0 : f ≠ 0 := by
      rintro rfl
      rw [map_zero, Valuation.map_zero] at heq
      exact zero_ne_one heq
    have hinv : (algebraMap F K f)⁻¹ ∈ O := by
      rw [← O.valuation_le_one_iff, Valuation.map_inv, heq, inv_one]
    have h2 : V.valuation f⁻¹ ≤ 1 := (V.valuation_le_one_iff _).mpr (H2 f hf hf0 hinv)
    have h3 : 1 < V.valuation f⁻¹ :=
      (Valuation.one_lt_val_iff V.valuation (inv_ne_zero hf0)).mpr (by rw [inv_inv]; exact hv)
    exact absurd h2 (not_le.mpr h3)

  have hβ : ∀ f : F, V.valuation f = 1 → O.valuation (algebraMap F K f) = 1 := by
    intro f hv
    have hf0 : f ≠ 0 := by
      rintro rfl
      rw [Valuation.map_zero] at hv
      exact zero_ne_one hv
    have hfV : f ∈ V := (V.valuation_le_one_iff _).mp hv.le
    have hfiV : f⁻¹ ∈ V :=
      (V.valuation_le_one_iff _).mp (by rw [Valuation.map_inv, hv, inv_one])
    have h1 : O.valuation (algebraMap F K f) ≤ 1 := (O.valuation_le_one_iff _).mpr (H1 f hfV)
    have h2 : O.valuation (algebraMap F K f)⁻¹ ≤ 1 := by
      rw [← map_inv₀]
      exact (O.valuation_le_one_iff _).mpr (H1 _ hfiV)
    have hιf0 : algebraMap F K f ≠ 0 := (map_ne_zero _).mpr hf0
    refine le_antisymm h1 (not_lt.mp (fun hlt => ?_))
    have h3 : 1 < O.valuation (algebraMap F K f)⁻¹ :=
      (Valuation.one_lt_val_iff O.valuation (inv_ne_zero hιf0)).mpr (by rw [inv_inv]; exact hlt)
    exact absurd h2 (not_le.mpr h3)

  have hnorm : ∃ (n : ℕ) (b : ℕ → F), (∀ i, b i ∈ V) ∧ (∃ i ≤ n, b i = 1) ∧
      (∑ i ∈ Finset.range (n + 1), algebraMap F K (b i) * x ^ i) = 0 := by
    obtain ⟨p, hp0, hpx⟩ := Algebra.IsAlgebraic.isAlgebraic (R := F) x
    obtain ⟨i₀, hi₀, hmax⟩ := Finset.exists_max_image p.support
      (fun i => V.valuation (p.coeff i)) (Polynomial.support_nonempty.mpr hp0)
    have hc0 : p.coeff i₀ ≠ 0 := Polynomial.mem_support_iff.mp hi₀
    have hvc : V.valuation (p.coeff i₀) ≠ 0 := (Valuation.ne_zero_iff _).mpr hc0
    refine ⟨p.natDegree, fun i => p.coeff i / p.coeff i₀, ?_, ?_, ?_⟩
    · intro i
      rw [← V.valuation_le_one_iff]
      by_cases hi : i ∈ p.support
      · rw [Valuation.map_div]
        exact div_le_one_of_le₀ (hmax i hi) zero_le'
      · rw [Polynomial.notMem_support_iff] at hi
        simp [hi]
    · exact ⟨i₀, Polynomial.le_natDegree_of_mem_supp i₀ hi₀, div_self hc0⟩
    · rw [Polynomial.aeval_eq_sum_range] at hpx
      have e : ∑ i ∈ Finset.range (p.natDegree + 1),
          algebraMap F K (p.coeff i / p.coeff i₀) * x ^ i =
          (algebraMap F K (p.coeff i₀))⁻¹ *
            ∑ i ∈ Finset.range (p.natDegree + 1), p.coeff i • x ^ i := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [map_div₀, Algebra.smul_def, div_eq_mul_inv]
        ring
      rw [e, hpx, mul_zero]
  obtain ⟨n, b, hb, ⟨i₀, hi₀n, hbi₀⟩, hrel⟩ := hnorm

  have hmem : ∀ f ∈ V, f ∈ R₀ := fun f hf => by rw [← hR]; exact hf
  let b' : ℕ → R₀ := fun i => ⟨b i, hmem _ (hb i)⟩
  have hb' : ∀ i, algebraMap R₀ K (b' i) = algebraMap F K (b i) := fun i => rfl
  have hrel' : ∑ i ∈ Finset.range (n + 1), algebraMap R₀ K (b' i) * x ^ i = 0 := by
    simp only [hb']
    exact hrel
  have hBk := hB n b' x hrel'
  simp only [hb'] at hBk

  set U := (Finset.range (n + 1)).filter (fun i => V.valuation (b i) = 1) with hU
  have hi₀U : i₀ ∈ U := by
    rw [hU, Finset.mem_filter, Finset.mem_range, hbi₀, Valuation.map_one]
    exact ⟨by omega, rfl⟩
  obtain ⟨r, hrU, hrmax⟩ : ∃ r ∈ U, ∀ i ∈ U, i ≤ r :=
    ⟨U.max' ⟨i₀, hi₀U⟩, U.max'_mem _, fun i hi => U.le_max' i hi⟩
  rw [hU, Finset.mem_filter, Finset.mem_range] at hrU
  obtain ⟨hrn, hvr⟩ := hrU
  have hgt : ∀ i, r < i → i ≤ n → V.valuation (b i) < 1 := by
    intro i hri hin
    refine lt_of_le_of_ne ((V.valuation_le_one_iff _).mpr (hb i)) (fun h => ?_)
    have := hrmax i (by rw [hU, Finset.mem_filter, Finset.mem_range]; exact ⟨by omega, h⟩)
    omega
  have hxle : O.valuation x ≤ 1 := (O.valuation_le_one_iff _).mpr hx
  have hterm : ∀ i ∈ Finset.Ioc r n,
      O.valuation (algebraMap F K (b i) * x ^ (i - r)) < 1 := by
    intro i hi
    have hi' := Finset.mem_Ioc.mp hi
    rw [Valuation.map_mul, Valuation.map_pow]
    have h1 := hα (b i) (hb i) (hgt i hi'.1 hi'.2)
    have h2 : O.valuation x ^ (i - r) ≤ 1 := pow_le_one' hxle _
    exact lt_of_le_of_lt (mul_le_of_le_one_right' h2) h1
  obtain ⟨T, hTdef⟩ : ∃ T : K, T = ∑ i ∈ Finset.Ioc r n, algebraMap F K (b i) * x ^ (i - r) :=
    ⟨_, rfl⟩
  have hT : O.valuation T < 1 := by
    rw [hTdef]
    exact Valuation.map_sum_lt _ one_ne_zero hterm
  have hbr : O.valuation (algebraMap F K (b r)) = 1 := hβ _ hvr
  have hs1 : O.valuation (algebraMap F K (b r) + T) = 1 :=
    (O.valuation.map_add_eq_of_lt_left (by rw [hbr]; exact hT)).trans hbr

  have hr1 : 1 ≤ r := by
    by_contra hcon
    have hr0 : r = 0 := by omega
    subst hr0
    have hsplit : Finset.range (n + 1) = insert 0 (Finset.Ioc 0 n) := by
      ext i
      simp only [Finset.mem_range, Finset.mem_insert, Finset.mem_Ioc]
      omega
    rw [hsplit, Finset.sum_insert (by simp)] at hrel
    have h0 : algebraMap F K (b 0) + T = 0 := by
      rw [hTdef]
      simpa using hrel
    rw [h0, Valuation.map_zero] at hs1
    exact zero_ne_one hs1

  have hz : (algebraMap F K (b r) + T) * x =
      ∑ i ∈ Finset.Ioc (r - 1) n, algebraMap F K (b i) * x ^ (i - (r - 1)) := by
    have hsplit2 : Finset.Ioc (r - 1) n = insert r (Finset.Ioc r n) := by
      ext i
      simp only [Finset.mem_insert, Finset.mem_Ioc]
      omega
    rw [hsplit2, Finset.sum_insert (by simp), hTdef, add_mul, Finset.sum_mul]
    have e1 : r - (r - 1) = 1 := by omega
    rw [e1, pow_one]
    congr 1
    refine Finset.sum_congr rfl (fun i hi => ?_)
    have hi' := Finset.mem_Ioc.mp hi
    have e2 : i - (r - 1) = (i - r) + 1 := by omega
    rw [e2, pow_succ, mul_assoc]
  have hsint : IsIntegral R₀ (algebraMap F K (b r) + T) := by
    have h1 : IsIntegral R₀ (algebraMap R₀ K (b' r)) := isIntegral_algebraMap
    rw [hb'] at h1
    have h2 := hBk r
    rw [← hTdef] at h2
    exact h1.add h2
  refine ⟨algebraMap F K (b r) + T, _, (O.valuation_le_one_iff _).mp hs1.le, ?_, ?_, hsint,
    hBk (r - 1), hz⟩
  · intro h
    rw [h, Valuation.map_zero] at hs1
    exact zero_ne_one hs1
  · rw [← O.valuation_le_one_iff, Valuation.map_inv, hs1, inv_one]

theorem wcLlsASbba_defect_transfer : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (K : Type u) [Field K] [Algebra (RatFunc Ω) K] [FiniteDimensional (RatFunc Ω) K] [Algebra.IsSeparable (RatFunc Ω) K] (O : ValuationSubring K), (∀ f : RatFunc Ω, algebraMap (RatFunc Ω) K f ∈ O ↔ f ∈ wcEbGauss W) → ∀ (L' : Type u) [Field L'] [Algebra K L'] [FiniteDimensional K L'] [Algebra.IsSeparable K L'], letI : Algebra ↥O L' := ((algebraMap K L').comp O.subtype).toAlgebra; Module.Finite ↥O ↥(integralClosure ↥O L') :=
by
  intro Ω _ _ W hW hWt K _ _ _ _ O hc L' _ _ _ _
  obtain ⟨V, hV1, -, -, -⟩ := wcpa_dj_lr1k_gd_gauss_valuation Ω W
  have hR₀ : ∀ f ∈ wcEbGauss W, algebraMap (RatFunc Ω) K f ∈ O := fun f hf => (hc f).mpr hf
  have hV₀ : ∀ f ∈ V, algebraMap (RatFunc Ω) K f ∈ O := by
    intro f hf
    apply (hc f).mpr
    rw [← hV1]
    exact hf
  have hV₀' : ∀ f ∈ V, f ≠ 0 → (algebraMap (RatFunc Ω) K f)⁻¹ ∈ O → f⁻¹ ∈ V := by
    intro f _ _ hinv
    have h1 : algebraMap (RatFunc Ω) K f⁻¹ ∈ O := by
      rw [map_inv₀]
      exact hinv
    have h2 : f⁻¹ ∈ wcEbGauss W := (hc f⁻¹).mp h1
    rw [← hV1] at h2
    exact h2
  letI : Algebra (RatFunc Ω) L' := ((algebraMap K L').comp (algebraMap (RatFunc Ω) K)).toAlgebra
  haveI : IsScalarTower (RatFunc Ω) K L' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : FiniteDimensional (RatFunc Ω) L' := Module.Finite.trans K L'
  haveI : Algebra.IsSeparable (RatFunc Ω) L' := Algebra.IsSeparable.trans (RatFunc Ω) K L'
  have hD := wcpa_dj_lr1k_eb_gauss_defectless_r1 Ω W hW hWt L'
  haveI : Algebra.IsAlgebraic (RatFunc Ω) K := Algebra.IsAlgebraic.of_finite _ _
  letI : Algebra ↥(wcEbGauss W) K :=
    ((algebraMap (RatFunc Ω) K).comp (wcEbGauss W).subtype).toAlgebra
  have hU := wcLlsASbfd_unit_fraction (RatFunc Ω) K V (wcEbGauss W) hV1 O hV₀ hV₀'
    (fun n b x h k => wcLlsASbfd_bourbaki_integral ↥(wcEbGauss W) K n b x h k)
  exact wcLlsASbfd_finite_transfer (RatFunc Ω) K L' (wcEbGauss W) O hR₀ hU hD

theorem wcpa_dj_llsm_kpwulb_best_approx : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ (f' : K) (a s : A), a ∉ 𝔭 → s ∉ 𝔭 → f' * algebraMap A K s = algebraMap A K a →
    ∃ h : K, h ≠ 0 ∧ (f' / h ^ ℓ - 1 = 0 ∨
      ∃ (lam₁ lam₂ w : ↥W) (n k : ℕ) (ε₀ ε₁ r₀ r₁ g₀ g₁ : A),
        (lam₁ ≠ 0 ∧ lam₂ ≠ 0 ∧ w ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀ ∉ 𝔭 ∧ ε₁ ∉ 𝔭 ∧
          (f' / h ^ ℓ - 1) * algebraMap A K (u ^ n * ε₁ + v * r₁ + algebraMap ↥W A w * g₁) *
            algebraMap A K (algebraMap ↥W A lam₂) =
          algebraMap A K (algebraMap ↥W A lam₁) *
            algebraMap A K (u ^ k * ε₀ + v * r₀ + algebraMap ↥W A w * g₀)) ∧
        (lam₂ ^ (ℓ - 1) * ((ℓ : ℕ) : ↥W) ^ ℓ ∣ lam₁ ^ (ℓ - 1) ∨
          ∀ (h' : K) (lam₁' lam₂' w' : ↥W) (n' k' : ℕ) (ε₀' ε₁' r₀' r₁' g₀' g₁' : A), h' ≠ 0 →
            (lam₁' ≠ 0 ∧ lam₂' ≠ 0 ∧ w' ∈ IsLocalRing.maximalIdeal ↥W ∧ ε₀' ∉ 𝔭 ∧ ε₁' ∉ 𝔭 ∧
              (f' / h' ^ ℓ - 1) *
                  algebraMap A K (u ^ n' * ε₁' + v * r₁' + algebraMap ↥W A w' * g₁') *
                algebraMap A K (algebraMap ↥W A lam₂') =
              algebraMap A K (algebraMap ↥W A lam₁') *
