theorem wcLlsKP_gp_step_round : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ℓ : ℕ), ℓ.Prime → ∀ (ν : Ω → ℝ), (∀ x y : Ω, x ≠ 0 → y ≠ 0 → ν (x * y) = ν x + ν y) → (∀ x y : Ω, x ≠ 0 → y ≠ 0 → x + y ≠ 0 → min (ν x) (ν y) ≤ ν (x + y)) → (∀ x : Ω, x ≠ 0 → (x ∈ W ↔ 0 ≤ ν x)) → (∀ x : ↥W, x ≠ 0 → (x ∈ IsLocalRing.maximalIdeal ↥W ↔ 0 < ν (x : Ω))) → ∀ (γ w β c y : ↥W) (m₀ i : ℕ) (H G H' G' : Polynomial ↥W), w ≠ 0 → β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 → w ^ ℓ = β ^ ((ℓ - 1) * m₀) * c → c ∈ IsLocalRing.maximalIdeal ↥W → 1 ≤ i → ℓ * i < m₀ → (∀ j, j < m₀ → β ^ (m₀ - j) ∣ G.coeff j) → y ^ ℓ = G.coeff (ℓ * i) → H' = H + Polynomial.C γ * Polynomial.C y * Polynomial.X ^ i → G' = G - (∑ k ∈ Finset.Ioo 0 ℓ, Polynomial.C ((((ℓ.choose k / ℓ : ℕ) : ↥W)) * w * γ ^ (k - 1)) * (Polynomial.C y * Polynomial.X ^ i) ^ k * H ^ (ℓ - k)) - (Polynomial.C y * Polynomial.X ^ i) ^ ℓ → (∀ j, j < m₀ → β ^ (m₀ - j) ∣ G'.coeff j) ∧ G'.coeff m₀ - G.coeff m₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ H'.coeff 0 = H.coeff 0 ∧ G'.coeff 0 = G.coeff 0 ∧ (∃ μ : ↥W, μ ∈ IsLocalRing.maximalIdeal ↥W ∧ G'.coeff 1 = G.coeff 1 + β ^ (m₀ - 1) * μ) ∧ (∀ j, j ≠ ℓ * i → G'.coeff j - G.coeff j = 0 ∨ (G.coeff (ℓ * i) ≠ 0 ∧ ν (w : Ω) + ν ((G.coeff (ℓ * i) : ↥W) : Ω) / (ℓ : ℝ) ≤ ν ((G'.coeff j - G.coeff j : ↥W) : Ω))) ∧ (G'.coeff (ℓ * i) = 0 ∨ (G.coeff (ℓ * i) ≠ 0 ∧ ν (w : Ω) + ν ((G.coeff (ℓ * i) : ↥W) : Ω) / (ℓ : ℝ) ≤ ν ((G'.coeff (ℓ * i) : ↥W) : Ω))) :=
