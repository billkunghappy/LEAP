    exact hle ha
  have hII : ∀ a ∈ Ideal.span {c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w},
      wcIcxIncl L _ _ hRI a ∈ 𝔷I := by
    intro a ha
    have hle : Ideal.span {c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} ≤
        𝔷I.comap (wcIcxIncl L _ _ hRI) := by
