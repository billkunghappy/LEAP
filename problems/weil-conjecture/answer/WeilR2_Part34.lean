    exact wcpa_dj_llsm_isice_three_branches_bad W _ _ Q h1 h2 h3
  have hbI : ∀ (Q : Ideal ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)), Q.IsPrime →
      Q.comap (algebraMap ↥(wcIcxRI W A K u a' b)
        ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)) = wcIcxNI W A K u a' b →
      ∀ E₁ ∈ (wcIccM W (wcIccWL W A K L) ↥(wcIcxRI W A K u a' b)).minimalPrimes,
      ∀ E₂ ∈ (wcIccM W (wcIccWL W A K L) ↥(wcIcxRI W A K u a' b)).minimalPrimes,
      ∀ E₃ ∈ (wcIccM W (wcIccWL W A K L) ↥(wcIcxRI W A K u a' b)).minimalPrimes,
      E₁ ≤ Q → E₂ ≤ Q → E₃ ≤ Q → E₁ = E₂ ∨ E₁ = E₃ ∨ E₂ = E₃ := by
    intro Q hQ hQN
    haveI := hQ
    obtain ⟨h1, h2, h3⟩ := hlocI Q hQN
    exact wcpa_dj_llsm_isice_three_branches_bad W _ _ Q h1 h2 h3

  have hexO := fun (Q : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) (hQ : Q.IsPrime)
      (hQN : Q.comap (algebraMap ↥(wcLlsASbS W A K u a')
        ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) = wcLlsASbN W A K u a') =>
    wcpa_dj_llsm_isice_branch_exist Ω W hW hWt A K L 𝔭 u v g a' hPD ha'm ha'0
      (dvd_trans ⟨e, he⟩ hbg) Q hQ hQN
  have hexI := fun (Q : Ideal ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)) (hQ : Q.IsPrime)
      (hQN : Q.comap (algebraMap ↥(wcIcxRI W A K u a' b)
        ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)) = wcIcxNI W A K u a' b) =>
    wcpa_dj_llsm_isice_inner_branch_exist Ω W hW hWt A K L 𝔭 u v g a' b hPD ha'm ha'0 hbm hb0
      ⟨e, he⟩ hnba hbg Q hQ hQN
  have hconn := wcpa_dj_llsm_isice_fibre_connected Ω W hW hWt A K L 𝔭 u v g a' b hRo hRI hoC hIC
    hPD ha'm ha'0 hbm hb0 ⟨e, he⟩ hnba hbg y₀ hy₀ hy₀c
  obtain ⟨huniqO, huniqI⟩ := wcpa_dj_llsm_isice_chain_count Ω W hW hWt A K L 𝔭 u v g a' b
    hRo hRI hoC hIC hPD ha'm ha'0 hbm hb0 ⟨e, he⟩ hnba hbg hCirc y₀ hy₀ hy₀c hconn hbO hbI
    hexO hexI

  obtain ⟨Ps, Pu, hPs, hPu, hPsQ, hPuQ, hyPs, huPs, huPu, hyPu⟩ := hexO Qo inferInstance hQoN
  obtain ⟨E, E', hE, hE', hEQ, hE'Q, hsE, hxE, hxE', hsE'⟩ := hexI QI inferInstance hQIN
  have hneO : Pu ≠ Ps := fun h => huPs (h ▸ huPu)
  have hneI : E ≠ E' := fun h => hsE' (h ▸ hsE)

  obtain ⟨hnO, hrO, hbadO⟩ := hlocO Qo hQoN
  obtain ⟨hTo, hNo⟩ := wcpa_dj_llsm_isicc_node_two_branch W (wcIccWL W A K L) _ Qo hnO hrO hbadO
    Pu hPu Ps hPs hneO hPuQ hPsQ
  obtain ⟨hnI, hrI, hbadI⟩ := hlocI QI hQIN
  obtain ⟨hTI, hNI⟩ := wcpa_dj_llsm_isicc_node_two_branch W (wcIccWL W A K L) _ QI hnI hrI hbadI
    E hE E' hE' hneI hEQ hE'Q

  have huO : ∀ Q : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u a') L), Q.IsPrime →
      Q.comap (wcIcxIncl L _ _ hRo) = y₀ →
      Q.comap (algebraMap ↥(wcLlsASbS W A K u a')
        ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) = wcLlsASbN W A K u a' → Q = Qo :=
    fun Q hQ h1 h2 => huniqO Q Qo hQ inferInstance h1 hQoy h2 hQoN
  have huI : ∀ Q : Ideal ↥(integralClosure ↥(wcIcxRI W A K u a' b) L), Q.IsPrime →
      Q.comap (wcIcxIncl L _ _ hRI) = y₀ →
      Q.comap (algebraMap ↥(wcIcxRI W A K u a' b)
        ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)) = wcIcxNI W A K u a' b → Q = QI :=
    fun Q hQ h1 h2 => huniqI Q QI hQ inferInstance h1 hQIy h2 hQIN
  obtain ⟨𝔎, h𝔎, ψ, c0, k, hc0, hk, hI𝔎, h𝔎y, hψW, hψy, hrad, h𝔎o, h𝔎I⟩ :=
    wcpa_dj_llsm_isicc_circle_component Ω W hW hWt A K L 𝔭 u v g a' b hRo hRI hoC hIC hPD ha'm
      ha'0 hbm hb0 ⟨e, he⟩ hnba hbg hCirc y₀ hy₀ hy₀c Qo Ps Pu QI E inferInstance inferInstance
      hQoy hQIy hQoN hQIN hPs hPu hPsQ hPuQ hyPs huPs huPu hyPu (hbO Qo inferInstance hQoN) huO
      hE hEQ hsE hxE

  obtain ⟨ηo, hηoPs, hψηo, hrepo⟩ := wcpa_dj_llsm_isicc_outer_end Ω W hW hWt A K L 𝔭 u v g a' b
    hRo hoC hPD ha'm ha'0 hbm hb0 ⟨e, he⟩ hnba hbg y₀ hy₀ hy₀c Qo Ps Pu inferInstance hQoy hQoN
    hPs hPu hPsQ hPuQ hyPs huPs huPu hyPu huO 𝔎 h𝔎 ψ c0 k hc0 hk hI𝔎 h𝔎y hψW hψy h𝔎o hTo hNo
  obtain ⟨ηI, hηIE', hψηI, hrepI⟩ := wcpa_dj_llsm_isicc_inner_end Ω W hW hWt A K L 𝔭 u v g a' b
    hRI hIC hPD ha'm ha'0 hbm hb0 ⟨e, he⟩ hnba hbg y₀ hy₀ hy₀c QI E E' inferInstance hQIy hQIN
    hE hE' hEQ hE'Q hsE hxE hxE' hsE' huI 𝔎 h𝔎 ψ c0 k hc0 hk hI𝔎 h𝔎y hψW hψy h𝔎I hTI hNI

