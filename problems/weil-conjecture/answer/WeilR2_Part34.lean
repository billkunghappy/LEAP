    have hφd0 : algebraMap A K d ≠ 0 := fun h0 => hd0 (hφinj (by rw [h0, map_zero]))
    have hψEd0 : ((k (φQ d) : ↥V) : E) ≠ 0 := fun h0 => hψd0 (Subtype.ext h0)
    obtain ⟨θ, hθ⟩ : ∃ θ : Localization.Away d →+* K, ∀ b : A,
        θ (algebraMap A (Localization.Away d) b) = algebraMap A K b :=
      ⟨IsLocalization.Away.lift d (S := Localization.Away d) (g := algebraMap A K)
          (Ne.isUnit hφd0),
        fun b => IsLocalization.Away.lift_eq d (Ne.isUnit hφd0) b⟩
    obtain ⟨lam, hlam⟩ : ∃ lam : Localization.Away d →+* E, ∀ b : A,
        lam (algebraMap A (Localization.Away d) b) = ((k (φQ b) : ↥V) : E) :=
      ⟨IsLocalization.Away.lift d (S := Localization.Away d)
          (g := (algebraMap ↥V E).comp (k.comp φQ)) (Ne.isUnit hψEd0),
        fun b => IsLocalization.Away.lift_eq d (Ne.isUnit hψEd0) b⟩
    have hθinj : Function.Injective θ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨p, y⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers d) z
      have h1 : θ (IsLocalization.mk' (Localization.Away d) p y) *
          θ (algebraMap A (Localization.Away d) (y : A)) =
            θ (algebraMap A (Localization.Away d) p) := by
        rw [← map_mul, IsLocalization.mk'_spec]
      rw [hz, zero_mul, hθ] at h1
      have hp : p = 0 := hφinj (by rw [← h1, map_zero])
      rw [hp]
      exact IsLocalization.mk'_zero (S := Localization.Away d) y
    have hgen : ∀ s ∈ S, ∃ z : Localization.Away d, θ z = s ∧
        ∃ y : ↥V, y ∈ IsLocalRing.maximalIdeal ↥V ∧ lam z = (y : E) := by
      intro s hs
      obtain ⟨p, y, hsp, hym, hy⟩ := hS s hs
      have hspec := IsLocalization.mk'_spec (Localization.Away d) p
        (⟨d, Submonoid.mem_powers d⟩ : Submonoid.powers d)
      refine ⟨IsLocalization.mk' (Localization.Away d) p
        (⟨d, Submonoid.mem_powers d⟩ : Submonoid.powers d), ?_, y, hym, ?_⟩
      · have h1 := congrArg θ hspec
        rw [map_mul, hθ, hθ] at h1
        exact mul_right_cancel₀ hφd0 (h1.trans hsp.symm)
      · have h1 := congrArg lam hspec
        rw [map_mul, hlam, hlam, hy] at h1
        exact mul_right_cancel₀ hψEd0 h1
    have hR : ∀ t : K, t ∈ Algebra.adjoin A S → ∃ z : Localization.Away d, θ z = t := by
      intro t ht
      induction ht using Algebra.adjoin_induction with
      | mem t hts =>
        obtain ⟨z, hz, -⟩ := hgen t hts
        exact ⟨z, hz⟩
      | algebraMap b => exact ⟨algebraMap A _ b, hθ b⟩
      | add t t' _ _ h h' =>
        obtain ⟨z, hz⟩ := h
        obtain ⟨z', hz'⟩ := h'
        exact ⟨z + z', by rw [map_add, hz, hz']⟩
      | mul t t' _ _ h h' =>
        obtain ⟨z, hz⟩ := h
        obtain ⟨z', hz'⟩ := h'
        exact ⟨z * z', by rw [map_mul, hz, hz']⟩
    choose pre hpre using hR
    have hkey : ∀ (t : K) (ht : t ∈ Algebra.adjoin A S) (z : Localization.Away d), θ z = t →
        lam (pre t ht) = lam z := fun t ht z hz =>
      congrArg lam (hθinj ((hpre t ht).trans hz.symm))
    have hV' : ∀ (t : K) (ht : t ∈ Algebra.adjoin A S), lam (pre t ht) ∈ V := by
      intro t ht
      induction ht using Algebra.adjoin_induction with
      | mem t hts =>
        obtain ⟨z, hz, y, -, hy⟩ := hgen t hts
        rw [hkey t _ z hz, hy]
        exact y.2
      | algebraMap b =>
        rw [hkey _ _ (algebraMap A _ b) (hθ b), hlam]
        exact (k (φQ b)).2
      | add t t' ht ht' h h' =>
        rw [hkey (t + t') _ (pre t ht + pre t' ht') (by rw [map_add, hpre, hpre]), map_add]
        exact add_mem h h'
      | mul t t' ht ht' h h' =>
        rw [hkey (t * t') _ (pre t ht * pre t' ht') (by rw [map_mul, hpre, hpre]), map_mul]
        exact mul_mem h h'
    obtain ⟨Ψ₀, hΨ₀⟩ : ∃ Ψ₀ : ↥(Algebra.adjoin A S) →+* E, ∀ t, Ψ₀ t = lam (pre t.1 t.2) :=
      ⟨{ toFun := fun t => lam (pre t.1 t.2)
         map_one' := by
           show lam (pre _ _) = 1
           exact (hkey _ _ 1 (map_one θ)).trans (map_one lam)
         map_mul' := fun t t' => by
           show lam (pre _ _) = lam (pre _ _) * lam (pre _ _)
           rw [← map_mul]
           exact hkey _ _ _ (by rw [map_mul, hpre, hpre] <;> rfl)
         map_zero' := by
           show lam (pre _ _) = 0
           exact (hkey _ _ 0 (map_zero θ)).trans (map_zero lam)
         map_add' := fun t t' => by
           show lam (pre _ _) = lam (pre _ _) + lam (pre _ _)
           rw [← map_add]
           exact hkey _ _ _ (by rw [map_add, hpre, hpre] <;> rfl) }, fun t => rfl⟩
    have hΨV : ∀ t : ↥(Algebra.adjoin A S), Ψ₀ t ∈ V := fun t => by
      rw [hΨ₀]; exact hV' t.1 t.2
    refine ⟨Ψ₀.codRestrict V hΨV, ?_, ?_⟩
    · intro b
      apply Subtype.ext
      show Ψ₀ _ = _
      rw [hΨ₀]
      exact (hkey _ _ (algebraMap A _ b) (hθ b)).trans (hlam b)
    · intro s hs
      obtain ⟨z, hz, y, hym, hy⟩ := hgen s hs
      have h1 : Ψ₀.codRestrict V hΨV ⟨s, Algebra.subset_adjoin hs⟩ = y := by
        apply Subtype.ext
        show Ψ₀ _ = _
        rw [hΨ₀]
        exact (hkey s _ z hz).trans hy
      rw [h1]
      exact hym

  have hψd0 : k (φQ (algebraMap ↥W A c₁ * u)) ≠ 0 := by
    simp only [map_mul]
    rw [hk0']
    exact mul_ne_zero hCk0 (mul_ne_zero he₀0 (mul_ne_zero hCk0 hT0))
  have hSgen : ∀ s ∈ ({wcLlsInnerS₁ W A K u c₁, wcLlsInnerS₂ W A K u c₂} : Set K),
      ∃ (p : A) (y : ↥V), s * algebraMap A K (algebraMap ↥W A c₁ * u) = algebraMap A K p ∧
        y ∈ IsLocalRing.maximalIdeal ↥V ∧ k (φQ p) = y * k (φQ (algebraMap ↥W A c₁ * u)) := by
    intro s hs
    rcases hs with rfl | rfl
    · refine ⟨u * u, e₀ * k (φQ (algebraMap ↥W A τ)), ?_, Ideal.mul_mem_left _ _ hTm, ?_⟩
      · unfold wcLlsInnerS₁
        simp only [map_mul]
        rw [div_mul_eq_mul_div, div_eq_iff hC0]
        ring
      · simp only [map_mul]
        rw [hk0']
        ring
    · refine ⟨algebraMap ↥W A c₂ * algebraMap ↥W A c₁,
        k (φQ (algebraMap ↥W A τ)) * ↑he₀.unit⁻¹, ?_, Ideal.mul_mem_right _ _ hTm, ?_⟩
      · unfold wcLlsInnerS₂
        simp only [map_mul]
        rw [div_mul_eq_mul_div, div_eq_iff hU0]
        ring
      · rw [hr, ← hττ]
        simp only [map_mul]
        rw [hk0']
        linear_combination (-(k (φQ (algebraMap ↥W A c₁)) * k (φQ (algebraMap ↥W A c₁)) *
          k (φQ (algebraMap ↥W A τ)) * k (φQ (algebraMap ↥W A τ)))) * hinv
  obtain ⟨Ψ, hΨa, hΨs⟩ := hext (algebraMap ↥W A c₁ * u)
    ({wcLlsInnerS₁ W A K u c₁, wcLlsInnerS₂ W A K u c₂} : Set K) hψd0 hSgen

  have hN : wcLlsInnerCN W A K u c₁ c₂ ≤ (IsLocalRing.maximalIdeal ↥V).comap Ψ := by
    unfold wcLlsInnerCN
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      intro t ht
      rcases ht with rfl | rfl
      · exact hΨs _ (Set.mem_insert _ _)
      · exact hΨs _ (Set.mem_insert_of_mem _ rfl)
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap, RingHom.comp_apply, hΨa]
      exact hmaxV _ (h𝔪𝔭 w hw)

  have h1 := hN hax
  have h2 := hN hx
  rw [Ideal.mem_comap, map_add] at h1
  rw [Ideal.mem_comap] at h2
  have h3 := Ideal.sub_mem _ h1 h2
  rw [add_sub_cancel_right, hΨa] at h3
  exact (IsLocalRing.mem_maximalIdeal _).mp h3 (hunitV a ha)

theorem wcpa_dj_llsm_kpwu_hc_germ_factor : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ x : K, x ≠ 0 → ∃ (w₁ w₂ : ↥W) (j : ℤ) (τ : ↥W), wcHcFact W A K u g x w₁ w₂ j τ :=
by
  classical
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 u v g hPD
  have hPD' := hPD
  obtain ⟨hFT, htf, -, h𝔭max, hm𝔭, hg, hg0, huv, -⟩ := hPD'
  have h𝔭 : 𝔭.IsPrime := h𝔭max.isPrime
  have hinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hWinj : ∀ x : ↥W, x ≠ 0 → algebraMap ↥W A x ≠ 0 := by
    intro x hx h
    rw [Algebra.algebraMap_eq_smul_one] at h
    rcases smul_eq_zero.mp h with h | h
    · exact hx h
    · exact one_ne_zero h
  have hjW : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 :=
    fun x hx => (map_ne_zero_iff _ hinj).mpr (hWinj x hx)
  have hu0 : u ≠ 0 := by
    rintro rfl
    rw [zero_mul] at huv
    exact hWinj g hg0 huv.symm
  have huK : algebraMap A K u ≠ 0 := (map_ne_zero_iff _ hinj).mpr hu0
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h => h𝔭.ne_top ((Ideal.eq_top_iff_one 𝔭).mpr h)
  have hne𝔭 : ∀ s : A, s ∉ 𝔭 → algebraMap A K s ≠ 0 := by
    intro s hs h
    apply hs
    rw [hinj (h.trans (map_zero _).symm)]
    exact 𝔭.zero_mem



  have toFact : ∀ x : K, wcHcgE W A K 𝔭 u g x →
      ∃ (w₁ w₂ : ↥W) (j : ℤ) (τ : ↥W), wcHcFact W A K u g x w₁ w₂ j τ := by
    rintro x ⟨w₁, w₂, j, τ, hw₁, hw₂, hτm, hτ0, hτg, hx⟩
    refine ⟨w₁, w₂, j, τ, hw₁, hw₂, hτm, hτ0, hτg, ?_⟩
    intro c₁ c₂ hc₁m hc₁0 hc₂m hc₂0 h12 h21 h2g hgt
    obtain ⟨d, e, a, b, ha, hb, hda, heb, hde⟩ := hx c₁ c₂ hc₁0 hgt
    have key : ∀ (r : ↥(wcLlsInnerCR W A K u c₁ c₂)) (a : A), a ∉ 𝔭 →
        r - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a ∈ wcLlsInnerCN W A K u c₁ c₂ →
        r ∉ wcLlsInnerCN W A K u c₁ c₂ := by
      intro r a ha hra
      have h := wcpa_dj_llsm_kpwul_inner_unit Ω W hW hWt A K 𝔭 u v g hPD c₁ c₂ hc₁m hc₁0
        hc₂m hc₂0 h12 h21 h2g a ha _ hra
      have e : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a +
          (r - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a) = r := by ring
      rwa [e] at h
    exact ⟨d, e, key d a ha hda, key e b hb heb, hde⟩
  have E_mul : ∀ x y : K, wcHcgE W A K 𝔭 u g x → wcHcgE W A K 𝔭 u g y →
      wcHcgE W A K 𝔭 u g (x * y) := by
    rintro x y ⟨w₁, w₂, j, τ, hw₁, hw₂, hτm, hτ0, hτg, hx⟩
      ⟨w₁', w₂', j', τ', hw₁', hw₂', hτm', hτ0', hτg', hy⟩
    obtain ⟨τ'', hτ''m, hτ''0, hτ''g, h1, h2⟩ : ∃ τ'' : ↥W, τ'' ∈ IsLocalRing.maximalIdeal ↥W ∧
        τ'' ≠ 0 ∧ τ'' ∣ g ∧ τ'' ∣ τ ∧ τ'' ∣ τ' := by
      rcases ValuationRing.dvd_total τ τ' with h | h
      · exact ⟨τ, hτm, hτ0, hτg, dvd_rfl, h⟩
      · exact ⟨τ', hτm', hτ0', hτg', h, dvd_rfl⟩
    refine ⟨w₁ * w₁', w₂ * w₂', j + j', τ'', mul_ne_zero hw₁ hw₁', mul_ne_zero hw₂ hw₂',
      hτ''m, hτ''0, hτ''g, ?_⟩
    intro c₁ c₂ hc₁0 hgt
    obtain ⟨d, e, a, b, ha, hb, hda, heb, hde⟩ :=
      hx c₁ c₂ hc₁0 (dvd_trans hgt (mul_dvd_mul_right h1 c₁))
    obtain ⟨d', e', a', b', ha', hb', hda', heb', hde'⟩ :=
      hy c₁ c₂ hc₁0 (dvd_trans hgt (mul_dvd_mul_right h2 c₁))
    refine ⟨d * d', e * e', a * a', b * b', fun h => (h𝔭.mem_or_mem h).elim ha ha',
      fun h => (h𝔭.mem_or_mem h).elim hb hb', ?_, ?_, ?_⟩
    · have hh : d * d' - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (a * a') =
          (d - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a) * d' +
            algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a *
              (d' - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) a') := by
        rw [map_mul]; ring
      rw [hh]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hda) (Ideal.mul_mem_left _ _ hda')
    · have hh : e * e' - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (b * b') =
          (e - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) b) * e' +
            algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) b *
              (e' - algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) b') := by
        rw [map_mul]; ring
      rw [hh]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ heb) (Ideal.mul_mem_left _ _ heb')
    · simp only [Subalgebra.coe_mul, map_mul]
      rw [zpow_add₀ huK]
      linear_combination ((d' : K) * (algebraMap A K (algebraMap ↥W A w₂') * y)) * hde +
        (algebraMap A K (algebraMap ↥W A w₁) * algebraMap A K u ^ j * (e : K)) * hde'
  have E_inv : ∀ x : K, x ≠ 0 → wcHcgE W A K 𝔭 u g x → wcHcgE W A K 𝔭 u g x⁻¹ := by
    rintro x hx0 ⟨w₁, w₂, j, τ, hw₁, hw₂, hτm, hτ0, hτg, hx⟩
    refine ⟨w₂, w₁, -j, τ, hw₂, hw₁, hτm, hτ0, hτg, ?_⟩
    intro c₁ c₂ hc₁0 hgt
    obtain ⟨d, e, a, b, ha, hb, hda, heb, hde⟩ := hx c₁ c₂ hc₁0 hgt
    refine ⟨e, d, b, a, hb, ha, heb, hda, ?_⟩
    have hy : x * x⁻¹ = 1 := mul_inv_cancel₀ hx0
    have hP : algebraMap A K u ^ j * (algebraMap A K u ^ j)⁻¹ = 1 :=
      mul_inv_cancel₀ (zpow_ne_zero _ huK)
    rw [zpow_neg]
    linear_combination (-(x⁻¹ * (algebraMap A K u ^ j)⁻¹)) * hde +
      ((d : K) * algebraMap A K (algebraMap ↥W A w₂) * (algebraMap A K u ^ j)⁻¹) * hy -
      (algebraMap A K (algebraMap ↥W A w₁) * (e : K) * x⁻¹) * hP
  have E_const : ∀ w : ↥W, w ≠ 0 → wcHcgE W A K 𝔭 u g (algebraMap A K (algebraMap ↥W A w)) := by
    intro w hw
    refine ⟨w, 1, 0, g, hw, one_ne_zero, hg, hg0, dvd_rfl, ?_⟩
    intro c₁ c₂ _ _
    refine ⟨1, 1, 1, 1, h1𝔭, h1𝔭, ?_, ?_, ?_⟩
    · rw [map_one, sub_self]; exact Ideal.zero_mem _
    · rw [map_one, sub_self]; exact Ideal.zero_mem _
    · simp
  have E_one : wcHcgE W A K 𝔭 u g 1 := by
    have h := E_const 1 one_ne_zero
    rwa [map_one, map_one] at h
  have E_u : wcHcgE W A K 𝔭 u g (algebraMap A K u) := by
    refine ⟨1, 1, 1, g, one_ne_zero, one_ne_zero, hg, hg0, dvd_rfl, ?_⟩
    intro c₁ c₂ _ _
    refine ⟨1, 1, 1, 1, h1𝔭, h1𝔭, ?_, ?_, ?_⟩
    · rw [map_one, sub_self]; exact Ideal.zero_mem _
    · rw [map_one, sub_self]; exact Ideal.zero_mem _
    · simp
  have E_unit : ∀ a : A, a ∉ 𝔭 → wcHcgE W A K 𝔭 u g (algebraMap A K a) := by
    intro a ha
    refine ⟨1, 1, 0, g, one_ne_zero, one_ne_zero, hg, hg0, dvd_rfl, ?_⟩
    intro c₁ c₂ _ _
    refine ⟨1, algebraMap A _ a, 1, a, h1𝔭, ha, ?_, ?_, ?_⟩
    · rw [map_one, sub_self]; exact Ideal.zero_mem _
    · rw [sub_self]; exact Ideal.zero_mem _
    · simp [Subalgebra.coe_algebraMap]
  have E_v : wcHcgE W A K 𝔭 u g (algebraMap A K v) := by
    have hv : algebraMap A K v = algebraMap A K (algebraMap ↥W A g) * (algebraMap A K u)⁻¹ :=
      (eq_mul_inv_iff_mul_eq₀ huK).mpr (by rw [← map_mul, mul_comm, huv])
    rw [hv]
    exact E_mul _ _ (E_const g hg0) (E_inv _ huK E_u)
  have E_lin : ∀ c d₀ : ↥W, c * d₀ = g → d₀ ∈ IsLocalRing.maximalIdeal ↥W →
      wcHcgE W A K 𝔭 u g (algebraMap A K (u - algebraMap ↥W A c)) := by
    intro c d₀ hcd hd₀
    have hc0 : c ≠ 0 := by
      rintro rfl
      rw [zero_mul] at hcd
      exact hg0 hcd.symm
    have hd0 : d₀ ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hcd
      exact hg0 hcd.symm
    refine ⟨c, 1, 0, d₀, hc0, one_ne_zero, hd₀, hd0, Dvd.intro_left c hcd, ?_⟩
    intro c₁ c₂ hc₁0 hgt
    have hcc : c ∣ c₁ := by
      rw [← hcd, mul_comm d₀ c₁] at hgt
      exact (mul_dvd_mul_iff_right hd0).mp hgt
    obtain ⟨r, hr⟩ := hcc
    obtain ⟨S1, hS1v, hS1⟩ : ∃ S1 : ↥(wcLlsInnerCR W A K u c₁ c₂),
        (S1 : K) = wcLlsInnerS₁ W A K u c₁ ∧ S1 ∈ wcLlsInnerCN W A K u c₁ c₂ :=
      ⟨⟨wcLlsInnerS₁ W A K u c₁, Algebra.subset_adjoin (Set.mem_insert _ _)⟩, rfl, by
        unfold wcLlsInnerCN
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))⟩
    refine ⟨1, algebraMap A _ (algebraMap ↥W A r) * S1 - 1, 1, -1, h1𝔭,
      fun h => h1𝔭 (neg_mem_iff.mp h), ?_, ?_, ?_⟩
    · rw [map_one, sub_self]; exact Ideal.zero_mem _
    · have hh : algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A r) * S1 - 1 -
          algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (-1) =
            algebraMap A ↥(wcLlsInnerCR W A K u c₁ c₂) (algebraMap ↥W A r) * S1 := by
        rw [map_neg, map_one]; ring
      rw [hh]
      exact Ideal.mul_mem_left _ _ hS1
    · have hc₁K : algebraMap A K (algebraMap ↥W A c₁) ≠ 0 := hjW c₁ hc₁0
      have hinv : algebraMap A K (algebraMap ↥W A c₁) * (algebraMap A K (algebraMap ↥W A c₁))⁻¹
          = 1 := mul_inv_cancel₀ hc₁K
      have hr' : algebraMap A K (algebraMap ↥W A c₁) =
          algebraMap A K (algebraMap ↥W A c) * algebraMap A K (algebraMap ↥W A r) := by
        rw [hr, map_mul, map_mul]
      simp only [Subalgebra.coe_one, Subalgebra.coe_sub, Subalgebra.coe_mul,
        Subalgebra.coe_algebraMap, hS1v, map_one, zpow_zero, one_mul, mul_one, map_sub,
        wcLlsInnerS₁]
