  have hR : ∀ x, x ∈ Algebra.adjoin A {V} → wcLlsKPLoc A K V d x := fun x hx =>
    ⟨0, by rw [pow_zero, one_mul]; exact hx⟩
  have hL0 : ∀ x, wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K V d x := by
    rintro x ⟨n, hn⟩
