            · exact ⟨βs, hβs, h.trans hbseq⟩
            · exact ⟨_, hpm, h.trans hp⟩
          obtain ⟨qE, hqE, hbEeq⟩ := hbE
          have hEb₀ : bE ∣ b₀ := hbEmin b₀ (by simp)
          have hEbs : bE ∣ bs := hbEmin bs (by simp)
          have hEc : bE ∣ cs - c₁ := hbEmin (cs - c₁) (by simp)
          have hbE0 : bE ≠ 0 := by rintro rfl; exact hb₀0 (zero_dvd_iff.mp hEb₀)
