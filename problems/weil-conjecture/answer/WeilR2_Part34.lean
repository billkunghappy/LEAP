    exact wcLlsASbba_nf_compare Ω W hW hWt A K 𝔭 u v g hPD _ _ l1 l2 w n k e0 e1 r0 r1 g0 g1
      l1' l2' w' n' k' e0' e1' r0' r1' g0' g1' a₂ b₂ hl1 hl2 hw he0 he1 hE hl1' hl2' hw' he0'
