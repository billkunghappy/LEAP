    unfold wcLlsASbN
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      intro x hx
      rcases hx with rfl | rfl
      · exact Ideal.mem_comap.mpr (hPuM huPu)
      · exact Ideal.mem_comap.mpr hyM
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap]
      apply hPuM
      apply hIPu
      apply Ideal.subset_span
      exact ⟨w, hw, rfl⟩
  have hMo : M.comap (algebraMap ↥(wcLlsASbS W A K u a')
      ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) = wcLlsASbN W A K u a' :=
    (hNo.eq_of_le (Ideal.comap_ne_top _ hM.ne_top) hle).symm
  have hy₀max : y₀.IsMaximal := by
    haveI := hy₀
    apply Ideal.isMaximal_of_isIntegral_of_isMaximal_comap
      (algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L))
      (algebraMap_isIntegral_iff.mpr inferInstance)
    rw [hy₀c]
    exact hN0
  have hy₀M : M.comap (wcIcxIncl L _ _ hRo) = y₀ :=
    (hy₀max.eq_of_le (Ideal.comap_ne_top _ hM.ne_top) (hy₀Pu.trans (Ideal.comap_mono hPuM))).symm
  exact huniq M hM.isPrime hy₀M hMo

theorem wcpa_dj_llsm_isicco_core : ∀ (κ : Type u) [Field κ] (C : Type u) [CommRing C]
    (θ : C →+* LaurentPolynomial κ) (Qo Ps Pu : Ideal C) (yo : C) (c : κ) (k : ℕ),
    Qo.IsPrime → Pu ≤ Qo → Ps ≤ Qo → yo ∈ Ps → c ≠ 0 → 1 ≤ k →
    θ yo = LaurentPolynomial.C c * LaurentPolynomial.T (k : ℤ) →
    (∀ z : C, θ z = 0 ↔ z ∈ Pu) →
    (∀ z : C, ∃ q : Polynomial κ, θ z = Polynomial.toLaurent q) →
    (∀ f : LaurentPolynomial κ, ∃ (n : ℕ) (z : C),
      θ z = (LaurentPolynomial.C c * LaurentPolynomial.T (k : ℤ)) ^ n * f) →
    (∀ a : κ, ∃ e : C, θ e = LaurentPolynomial.C a) →
    (∀ M : Ideal C, M.IsMaximal → Pu ≤ M → yo ∈ M → M = Qo) →
    (∀ z ∈ Qo, ∃ σ ∉ Qo, ∃ a ∈ Pu, ∃ β ∈ Ps, σ * z = a + β) →
    (∀ (t d : C) (n : ℕ) (cs : ℕ → C), d ∉ Pu → 0 < n →
      t ^ n + ∑ i ∈ Finset.range n, cs i * t ^ i * d ^ (n - i) ∈ Pu →
      ∃ σ ∉ Qo, ∃ r, σ * t - r * d ∈ Pu) →
    ∃ η ∈ Ps, θ η = LaurentPolynomial.T 1 ∧
      ∀ z : C, ∃ (a : κ) (r : C), θ (z - η * r) = LaurentPolynomial.C a :=
by
  intro κ _ C _ θ Qo Ps Pu yo c k hQ hPuQ hPsQ hyo hc hk hθy hker h1 h2 h3 h5 hT hN
  classical

  have hCu : IsUnit (LaurentPolynomial.C c : LaurentPolynomial κ) :=
    (IsUnit.mk0 c hc).map LaurentPolynomial.C
  have hCinv : (LaurentPolynomial.C c⁻¹ : LaurentPolynomial κ) * LaurentPolynomial.C c = 1 := by
    rw [← map_mul, inv_mul_cancel₀ hc, map_one]
  have hT1k : (LaurentPolynomial.T 1 : LaurentPolynomial κ) ^ k = LaurentPolynomial.T (k : ℤ) := by
    rw [LaurentPolynomial.T_pow, mul_one]
  obtain ⟨e', he'⟩ := h3 c⁻¹
  obtain ⟨e, he⟩ := h3 c
  obtain ⟨U, hUdef⟩ : ∃ U : LaurentPolynomial κ,
      U = LaurentPolynomial.C c * LaurentPolynomial.T (k : ℤ) := ⟨_, rfl⟩
  have hU : IsUnit U := hUdef ▸ hCu.mul (LaurentPolynomial.isUnit_T _)
  rw [← hUdef] at hθy h2
  have hCU : (LaurentPolynomial.C c⁻¹ : LaurentPolynomial κ) * U = LaurentPolynomial.T (k : ℤ) := by
    rw [hUdef, ← mul_assoc, hCinv, one_mul]


  obtain ⟨n₀, t, ht⟩ := h2 (LaurentPolynomial.T 1)
  have hd : yo ^ n₀ ∉ Pu := by
    intro hd
    have h0 := (hker _).mpr hd
    rw [map_pow, hθy] at h0
    exact (hU.pow n₀).ne_zero h0
  have hsum : ∑ i ∈ Finset.range k,
      (fun i : ℕ => if i = 0 then -(e' * yo) else 0) i * t ^ i * (yo ^ n₀) ^ (k - i)
      = -(e' * yo) * (yo ^ n₀) ^ k := by
    rw [Finset.sum_eq_single 0]
    · simp
    · intro b _ hb
      simp [hb]
    · intro h
      exact absurd (Finset.mem_range.mpr (by omega)) h
  have hmem : t ^ k + ∑ i ∈ Finset.range k,
      (fun i : ℕ => if i = 0 then -(e' * yo) else 0) i * t ^ i * (yo ^ n₀) ^ (k - i) ∈ Pu := by
    rw [hsum]
    apply (hker _).mp
    rw [map_add, map_mul, map_neg, map_mul, map_pow, map_pow, map_pow, ht, he', hθy, mul_pow,
      hT1k, ← hCU]
    ring
  obtain ⟨σ, hσ, r, hr⟩ := hN t (yo ^ n₀) k _ hd (by omega) hmem
  have hσT : θ σ * LaurentPolynomial.T 1 = θ r := by
    have h0 := (hker _).mpr hr
    rw [map_sub, map_mul, map_mul, map_pow, ht, hθy, sub_eq_zero] at h0
    apply (hU.pow n₀).mul_left_inj.mp
    linear_combination h0
  let J : Ideal C :=
    { carrier := {z | ∃ r, θ z * LaurentPolynomial.T 1 = θ r}
      add_mem' := by
        rintro a b ⟨r1, hr1⟩ ⟨r2, hr2⟩
        exact ⟨r1 + r2, by rw [map_add, map_add, add_mul, hr1, hr2]⟩
      zero_mem' := ⟨0, by simp⟩
      smul_mem' := by
        rintro a b ⟨r, hr⟩
        exact ⟨a * r, by rw [smul_eq_mul, map_mul, map_mul, mul_assoc, hr]⟩ }
  have hJmem : ∀ z, z ∈ J ↔ ∃ r, θ z * LaurentPolynomial.T 1 = θ r := fun z => Iff.rfl
  have hJtop : J = ⊤ := by
    by_contra hne
    obtain ⟨M, hM, hJM⟩ := Ideal.exists_le_maximal J hne
    have hPuM : Pu ≤ M := by
      intro z hz
      apply hJM
      rw [hJmem]
      exact ⟨0, by rw [(hker z).mpr hz, zero_mul, map_zero]⟩
    have hyoM' : yo ^ n₀ ∈ M := hJM ((hJmem _).mpr ⟨t, by rw [map_pow, hθy, ht]⟩)
    have hyoM : yo ∈ M := hM.isPrime.mem_of_pow_mem n₀ hyoM'
    have hMQ := h5 M hM hPuM hyoM
    have hσM : σ ∈ M := hJM ((hJmem _).mpr ⟨r, hσT⟩)
    rw [hMQ] at hσM
    exact hσ hσM
  have h1J : (1 : C) ∈ J := by rw [hJtop]; exact Submodule.mem_top
  obtain ⟨t₁, ht₁'⟩ := (hJmem 1).mp h1J
  have ht₁ : θ t₁ = LaurentPolynomial.T 1 := by rw [← ht₁', map_one, one_mul]


