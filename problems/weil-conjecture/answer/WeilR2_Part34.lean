          apply Subtype.ext
          show algebraMap A K v = algebraMap A K (algebraMap ↥W A k) * s
          have h1 : algebraMap A K u * algebraMap A K v =
              algebraMap A K (algebraMap ↥W A a') * algebraMap A K (algebraMap ↥W A q') *
                algebraMap A K (algebraMap ↥W A k) := by
            rw [← map_mul (algebraMap A K) u v, huv, hg, hk]
            simp only [map_mul]
            ring
