    unfold wcLlsScS
    exact mul_div_cancel₀ _ hb0K



  have hh0 : h ≠ 0 := fun h0 => hh (h0 ▸ 𝔭.zero_mem)
  haveI : IsDomain (Localization.Away h) :=
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
  have hhu : IsUnit (algebraMap A K h) :=
    ((map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr hh0).isUnit
  obtain ⟨ℓ, hℓA⟩ : ∃ ℓ : Localization.Away h →+* K,
