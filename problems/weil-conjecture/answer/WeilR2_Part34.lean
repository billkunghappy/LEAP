    exact (wcpa_dj_lr1k_ebnb_hens_inj (Localization.AtPrime Qb) _ hmbp P e he).2 P₂ h hcomp
  have heφ : ∀ x, e₂ (φ x) = h (e x) := fun x => by
    rw [← RingHom.comp_apply e₂ φ, ← hhe, RingHom.comp_apply]
