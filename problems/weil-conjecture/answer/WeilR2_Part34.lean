    wcpa_dj_llsm_kpkn_rh_model_hom Ω W A L 𝔭 ℓ u v ε ε' θ ψ y hℓpos
      hθpow hψpow hε' hCD hyc hloc

  have hunitD : ∀ s : A, s ∉ 𝔭 → IsUnit (Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v)
      (algebraMap A (Localization.AtPrime 𝔭) s)) := fun s hs =>
    ((IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime 𝔭) 𝔭 s).mpr hs).map _

  let πF : Localization.AtPrime y →+* wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y :=
