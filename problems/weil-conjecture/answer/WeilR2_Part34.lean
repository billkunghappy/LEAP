        Ideal.span {wcKpknFSel W A L y ψ}) ∧
      Ideal.Quotient.mk (Ideal.span {wcKpknFSel W A L y ψ}) (wcKpknFSel W A L y θ) ≠ 0 :=
by
  intro Ω _ W A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 _ ℓ u v ε ε' δ ζ h θ ψ σ y _ hAic hℓ hfr hℓA hζ
    hθK hθpow hψpow hθψ hε hε' hδ hhm hh0 huv huv0 h𝔭eq hσ hcoord hCD hyc hloc hI2 hDv
  classical
  obtain ⟨hDdom, hDdvr, hDu⟩ := hDv
  haveI := hDdom
  haveI := hDdvr
  have hℓpos : 0 < ℓ := hℓ.pos
  set ϖ := Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v) (algebraMap A (Localization.AtPrime 𝔭) (u * ε))
    with hϖ
  set P := Polynomial.X ^ ℓ - Polynomial.C ϖ with hP
  obtain ⟨Φ, hΦs, hΦr, hΦo⟩ : ∃ Φ : AdjoinRoot P →+*
