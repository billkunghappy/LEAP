    rw [hJdef, hIdef, Ideal.map_map]
  have hFS : Ideal.map (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
      (Localization.AtPrime Q))
      (Ideal.span {b : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (b : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}) = J := by
    rw [hspan, ← hIdef, hJI]

  have hIQ : I ≤ Q := by
    rw [hIdef, ← Ideal.map_map]
    exact Ideal.map_le_iff_le_comap.mpr hH1
  have hJ : J ≤ IsLocalRing.maximalIdeal (Localization.AtPrime Q) := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal, hJI]
    exact Ideal.map_mono hIQ

  have hfin := wcpa_dj_llsm_sd_normalization_finite Ω W hW hWt A K L 𝔭 k hPD s
  have hσft : ((algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
      ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))).FiniteType :=
    RingHom.FiniteType.comp (RingHom.Finite.finiteType (RingHom.finite_algebraMap.mpr hfin))
      (RingHom.FiniteType.comp
        (RingHom.finiteType_algebraMap.mpr (Algebra.FiniteType.adjoin_of_finite
          (Set.finite_singleton s)))
        (RingHom.finiteType_algebraMap.mpr hPD.1))
  have genA : ∀ (C : Type u) [CommRing C] (σ : ↥W →+* C), σ.FiniteType →
      IsNoetherianRing (C ⧸ (IsLocalRing.maximalIdeal ↥W).map σ) := by
    intro C _ σ hσ
    let φ : IsLocalRing.ResidueField ↥W →+* C ⧸ (IsLocalRing.maximalIdeal ↥W).map σ :=
      Ideal.Quotient.lift _ ((Ideal.Quotient.mk _).comp σ)
        (fun a ha => Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ ha))
    letI : Algebra (IsLocalRing.ResidueField ↥W) (C ⧸ (IsLocalRing.maximalIdeal ↥W).map σ) :=
      φ.toAlgebra
    have hφft : φ.FiniteType := by
      apply RingHom.FiniteType.of_comp_finiteType (f := IsLocalRing.residue ↥W)
      have : φ.comp (IsLocalRing.residue ↥W) = (Ideal.Quotient.mk _).comp σ :=
        RingHom.ext fun _ => rfl
      rw [this]
      exact (RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective).comp hσ
    haveI : Algebra.FiniteType (IsLocalRing.ResidueField ↥W)
        (C ⧸ (IsLocalRing.maximalIdeal ↥W).map σ) := hφft
    exact Algebra.FiniteType.isNoetherianRing (IsLocalRing.ResidueField ↥W) _
  have genB : ∀ (C S : Type u) [CommRing C] [CommRing S] [Algebra C S] (M : Submonoid C)
      [IsLocalization M S] (I : Ideal C), IsNoetherianRing (C ⧸ I) →
      IsNoetherianRing (S ⧸ I.map (algebraMap C S)) := by
    intro C S _ _ _ M _ I hI
    letI : Algebra (C ⧸ I) (S ⧸ I.map (algebraMap C S)) :=
      (Ideal.quotientMap _ (algebraMap C S) Ideal.le_comap_map).toAlgebra
    haveI : IsLocalization (M.map (Ideal.Quotient.mk I)) (S ⧸ I.map (algebraMap C S)) :=
      IsLocalization.of_surjective M S (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
        (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
        (RingHom.ext fun x => rfl) (by rw [Ideal.mk_ker, Ideal.mk_ker])
    exact IsLocalization.isNoetherianRing (M.map (Ideal.Quotient.mk I)) _ hI
  have main : ∀ (C : Type u) [CommRing C] (Q : Ideal C) [Q.IsPrime] (σ : ↥W →+* C),
      σ.FiniteType → (IsLocalRing.maximalIdeal ↥W).map σ ≤ Q →
      (∃ (P₂ : Type u) (_ : CommRing P₂) (e₂ : Localization.AtPrime Q →+* P₂),
        wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) P₂ e₂ ∧
        wcNdModelA W P₂ (e₂.comp ((algebraMap C (Localization.AtPrime Q)).comp σ))) →
      wcpaDjLkDelta (Localization.AtPrime Q ⧸
        (IsLocalRing.maximalIdeal ↥W).map ((algebraMap C (Localization.AtPrime Q)).comp σ)) = 0 := by
    intro C _ Q _ σ hσ hIQ hH
    obtain ⟨J, hJdef⟩ : ∃ J : Ideal (Localization.AtPrime Q), J =
        (IsLocalRing.maximalIdeal ↥W).map ((algebraMap C (Localization.AtPrime Q)).comp σ) :=
      ⟨_, rfl⟩
    rw [← hJdef]
    have hJI : J = ((IsLocalRing.maximalIdeal ↥W).map σ).map
        (algebraMap C (Localization.AtPrime Q)) := by
      rw [hJdef, Ideal.map_map]
    have hJ : J ≤ IsLocalRing.maximalIdeal (Localization.AtPrime Q) := by
      rw [← Localization.AtPrime.map_eq_maximalIdeal, hJI]
      exact Ideal.map_mono hIQ
    haveI hSJ : IsNoetherianRing (Localization.AtPrime Q ⧸ J) := by
      rw [hJI]; exact genB _ _ Q.primeCompl _ (genA C σ hσ)
    haveI : Nontrivial (Localization.AtPrime Q ⧸ J) :=
      Ideal.Quotient.nontrivial_iff.mpr
        (ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal _).ne_top hJ)
    haveI : IsLocalRing (Localization.AtPrime Q ⧸ J) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
    obtain ⟨P₂, _, e₂, hHens, f, hfC, hfHens⟩ := hH
    obtain ⟨hnmax, ψ, -⟩ := wcpa_dj_lr1k_ndmf_modelA_levels Ω W
    have hmapeq : Ideal.map e₂ J = Ideal.map f
        (Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) := by
      rw [hJdef, Ideal.map_map, Ideal.map_map, hfC]
    obtain ⟨θ, -⟩ := wcpa_dj_lr1k_ndmf_hens_levels (Localization.AtPrime Q) (Polynomial ↥W) P₂
      (IsLocalRing.maximalIdeal (Localization.AtPrime Q))
      (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) e₂ f
      (IsLocalRing.maximalIdeal.isMaximal _) hnmax hHens hfHens J
      (Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) hJ le_sup_right hmapeq
    have hlev : ∀ n : ℕ, Nonempty (((Localization.AtPrime Q ⧸ J) ⧸
        IsLocalRing.maximalIdeal (Localization.AtPrime Q ⧸ J) ^ n) ≃+*
        (Polynomial (IsLocalRing.ResidueField ↥W) ⧸
          Ideal.span {(Polynomial.X ^ n : Polynomial (IsLocalRing.ResidueField ↥W))})) := by
      intro n
      have hmax : IsLocalRing.maximalIdeal (Localization.AtPrime Q ⧸ J) =
          (IsLocalRing.maximalIdeal (Localization.AtPrime Q)).map (Ideal.Quotient.mk J) :=
        (IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective).symm
      have hpow : IsLocalRing.maximalIdeal (Localization.AtPrime Q ⧸ J) ^ n =
          ((IsLocalRing.maximalIdeal (Localization.AtPrime Q)) ^ n).map (Ideal.Quotient.mk J) := by
        rw [hmax, Ideal.map_pow]
      exact ⟨(Ideal.quotEquivOfEq hpow).trans
        ((DoubleQuot.quotQuotEquivQuotSup J _).trans ((θ n).trans (ψ n)))⟩
    exact wcpa_dj_lr1k_ndmf_smooth_levels_delta (Localization.AtPrime Q ⧸ J)
      (IsLocalRing.ResidueField ↥W) hlev
  have hIQ : I ≤ Q := by
    rw [hIdef, ← Ideal.map_map]
    exact Ideal.map_le_iff_le_comap.mpr hH1
  have key := main _ Q _ hσft (hIdef ▸ hIQ) hH2
  rw [← hJdef] at key
  rw [← hFS] at key
  exact key

theorem wcpa_dj_llsm_sc_residue_smooth : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c c' b r q : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → c' ∈ IsLocalRing.maximalIdeal ↥W →
      r ≠ 0 → c' - c = r → q ∈ IsLocalRing.maximalIdeal ↥W → b = r * q → b ≠ 0 →
      wcLlsDiscSep W A K L t c b →
      ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) [Q.IsPrime],
        Q.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) =
          wcLlsScN W A K t c' r →
        wcpaDjLkDelta (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
          ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) Q) = 0 :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD c c' b r q hc hc' hr0 hcr hq hbrq hb0
    hsep Q _ hQ
  have hbm : b ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [hbrq]
    exact Ideal.mul_mem_left _ r hq

  obtain ⟨Qb, hQb, hQbc, hlink⟩ := wcpa_dj_llsm_scrs_contraction Ω W hW hWt A K L 𝔭 t hPD
    c c' b r q hc hc' hr0 hcr hq hbrq hb0 _ rfl Q hQ
  haveI := hQb

  obtain ⟨P, _, e, he⟩ := wcNd_hens_exists (Localization.AtPrime Qb)
    (IsLocalRing.maximalIdeal (Localization.AtPrime Qb)) inferInstance

  have hmod := wcpa_dj_llsm_sd_good_model Ω W hW hWt A K L 𝔭 (.disc t) hPD
    (t - algebraMap ↥W A c) b hbm hb0 (Or.inl ⟨t, c, rfl, hc, rfl⟩) _ rfl Qb hQbc
    (hsep Qb hQbc) P e he

  obtain ⟨hu, hv, huv, hbr⟩ := wcpa_dj_llsm_scrs_branch_condition Ω W hW hWt A K L 𝔭 t hPD
    c b hc hbm hb0 _ rfl Qb hQbc P e he

  obtain ⟨g, f, hf, n, ε, ω, hn, hε, hω, hgn, hform⟩ :=
    wcpa_dj_llsm_scrs_node_monomial Ω W hW hWt P _ hmod _ _ b hbm hb0 hu hv huv hbr

  have hA := wcpa_dj_llsm_scrs_circle_transport Ω W hW hWt A K L 𝔭 t hPD c c' b r q hc hc' hr0
    hcr hq hbrq hb0 _ rfl Q hQ Qb hQbc hlink P e he g f hf n ε ω hn hε hω hgn hform

  refine wcpa_dj_llsm_scrs_modelA_delta Ω W hW hWt A K L 𝔭 (.disc t) hPD _ Q ?_ hA
  rw [hQ]
  exact le_sup_right

theorem wcLls_inner_offclass_smooth : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y →
    ∀ c₀ b₀ c' b' e' : ↥W, c₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ∈ IsLocalRing.maximalIdeal ↥W →
      c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 → b' ≠ 0 →
      c' - c₀ = b₀ * e' → ¬ b' ∣ b₀ → wcLlsDiscSep W A K L t c' b' →
      ∀ e : ↥W, e - e' ∉ IsLocalRing.maximalIdeal ↥W → wcLlsInnerSmooth W A K L t c₀ b₀ e :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD _hSolv _hUniq c₀ b₀ c' b' e'
    hc₀ hb₀ hc' hb' hb₀0 hb'0 he' hnb hsep e he
  classical

  have hnz : NoZeroSMulDivisors ↥W A := hPD.2.1
  have hι : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    rw [Algebra.algebraMap_eq_smul_one] at hx
    rcases smul_eq_zero.mp hx with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hinj : ∀ x : ↥W, algebraMap A K (algebraMap ↥W A x) = 0 → x = 0 := by
    intro x hx
    apply hι
    apply hj
    rw [hx, map_zero, map_zero]

  obtain ⟨u, hu_def⟩ : ∃ u : ↥W, u = e - e' := ⟨_, rfl⟩
  have hu : IsUnit u := by
    by_contra h
    apply he
    rw [← hu_def]
    exact (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr h)
  obtain ⟨q₀, hq₀⟩ : b₀ ∣ b' := by
    rcases ValuationRing.dvd_total b' b₀ with h | h
    · exact absurd h hnb
    · exact h
  have hq₀m : q₀ ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra h
    have hq : IsUnit q₀ := by
      by_contra h'
      exact h ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr h'))
    apply hnb
    refine ⟨↑hq.unit⁻¹, ?_⟩
    rw [hq₀, mul_assoc, IsUnit.mul_val_inv, mul_one]
  have hr0 : u * b₀ ≠ 0 := mul_ne_zero hu.ne_zero hb₀0
  have hqm : (↑hu.unit⁻¹ * q₀ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W :=
    Ideal.mul_mem_left _ _ hq₀m
  have hb'eq : b' = u * b₀ * (↑hu.unit⁻¹ * q₀) := by
    rw [hq₀]
    calc b₀ * q₀ = (u * ↑hu.unit⁻¹) * (b₀ * q₀) := by rw [IsUnit.mul_val_inv, one_mul]
      _ = u * b₀ * (↑hu.unit⁻¹ * q₀) := by ring
  have hc''m : c₀ + e * b₀ ∈ IsLocalRing.maximalIdeal ↥W :=
    Ideal.add_mem _ hc₀ (Ideal.mul_mem_left _ _ hb₀)
  have hdiff : c₀ + e * b₀ - c' = u * b₀ := by
    rw [hu_def]
    linear_combination -he'

  have Hres := wcpa_dj_llsm_sc_residue_smooth Ω W hW hWt A K L 𝔭 t hPD c' (c₀ + e * b₀) b'
    (u * b₀) (↑hu.unit⁻¹ * q₀) hc' hc''m hr0 hdiff hqm hb'eq hb'0 hsep

  have hB : algebraMap A K (algebraMap ↥W A b₀) ≠ 0 := fun h => hb₀0 (hinj _ h)
  have hU : algebraMap A K (algebraMap ↥W A u) ≠ 0 := fun h => hu.ne_zero (hinj _ h)
  have hUinv : algebraMap A K (algebraMap ↥W A ↑hu.unit⁻¹) * algebraMap A K (algebraMap ↥W A u)
      = 1 := by
    rw [← map_mul, ← map_mul, IsUnit.val_inv_mul, map_one, map_one]
  have hS : wcLlsScS W A K t c₀ b₀ = algebraMap A K (algebraMap ↥W A u) *
      wcLlsScS W A K t (c₀ + e * b₀) (u * b₀) + algebraMap A K (algebraMap ↥W A e) := by
    simp only [wcLlsScS, map_sub, map_add, map_mul]
    field_simp
    ring
  have hS2 : wcLlsScS W A K t (c₀ + e * b₀) (u * b₀) =
      algebraMap A K (algebraMap ↥W A ↑hu.unit⁻¹) *
        (wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e)) := by
    rw [hS, add_sub_cancel_right, ← mul_assoc, hUinv, one_mul]
  have hmem2 : wcLlsScS W A K t (c₀ + e * b₀) (u * b₀) ∈
      Algebra.adjoin A {wcLlsScS W A K t c₀ b₀} := by
    rw [hS2]
    exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
      (Subalgebra.sub_mem _ (Algebra.subset_adjoin (Set.mem_singleton _))
        (Subalgebra.algebraMap_mem _ _))
  have hmem1 : wcLlsScS W A K t c₀ b₀ ∈
      Algebra.adjoin A {wcLlsScS W A K t (c₀ + e * b₀) (u * b₀)} := by
    rw [hS]
    exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
      (Algebra.subset_adjoin (Set.mem_singleton _))) (Subalgebra.algebraMap_mem _ _)
  have hEq : Algebra.adjoin A {wcLlsScS W A K t (c₀ + e * b₀) (u * b₀)} =
      Algebra.adjoin A {wcLlsScS W A K t c₀ b₀} :=
    le_antisymm (Algebra.adjoin_le (Set.singleton_subset_iff.mpr hmem2))
      (Algebra.adjoin_le (Set.singleton_subset_iff.mpr hmem1))

  have transport : ∀ (R₁ R₂ : Subalgebra A K) (_ : R₁ = R₂) (x₁ : ↥R₁) (x₂ : ↥R₂),
      (x₁ : K) = (x₂ : K) →
      (∀ (Q : Ideal ↥(integralClosure ↥R₁ L)) [Q.IsPrime],
        Q.comap (algebraMap ↥R₁ ↥(integralClosure ↥R₁ L)) = Ideal.span {x₁} ⊔
          (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥R₁).comp (algebraMap ↥W A)) →
        wcpaDjLkDelta (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
          (algebraMap ↥W A))) ↥R₁ Q) = 0) →
      (∀ (Q : Ideal ↥(integralClosure ↥R₂ L)) [Q.IsPrime],
        Q.comap (algebraMap ↥R₂ ↥(integralClosure ↥R₂ L)) = Ideal.span {x₂} ⊔
          (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥R₂).comp (algebraMap ↥W A)) →
        wcpaDjLkDelta (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
          (algebraMap ↥W A))) ↥R₂ Q) = 0) := by
    intro R₁ R₂ h x₁ x₂ hx H
    subst h
    have hx' : x₁ = x₂ := Subtype.ext hx
    subst hx'
    exact H
  have H2 := transport _ _ hEq ⟨_, Algebra.subset_adjoin (Set.mem_singleton _)⟩ ⟨_, hmem2⟩ rfl
    (fun Q _ hQ => Hres Q hQ)
  have hel : (⟨wcLlsScS W A K t c₀ b₀, Algebra.subset_adjoin (Set.mem_singleton _)⟩ -
      algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) (algebraMap ↥W A e) :
        ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})) =
      algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) (algebraMap ↥W A u) *
        ⟨_, hmem2⟩ := by
    apply Subtype.ext
    simp only [Subalgebra.coe_sub, Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
    linear_combination hS
  intro 𝔮 _ h𝔮
  refine H2 𝔮 ?_
  rw [h𝔮, hel, Ideal.span_singleton_mul_left_unit
    ((hu.map (algebraMap ↥W A)).map (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})))]

theorem wcLls_inner_class_singular : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y →
    ∀ c₀ b₀ c' b' e' : ↥W, c₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ∈ IsLocalRing.maximalIdeal ↥W →
      c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 → b' ≠ 0 →
      c' - c₀ = b₀ * e' → ¬ b' ∣ b₀ → wcLlsDiscSep W A K L t c' b' →
      ¬ wcLlsInnerSmooth W A K L t c₀ b₀ e' :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hSolv hUniq c₀ b₀ c' b' e' hc₀ hb₀
    hc' hb' hb₀0 hb'0 he' hnb hsep' hIS
  obtain ⟨hyP, hyc, -, hδ⟩ := hSolv

  obtain ⟨q', hq'⟩ : b₀ ∣ b' := by
    rcases ValuationRing.dvd_total b₀ b' with h | h
    · exact h
    · exact absurd h hnb
  have hq'm : q' ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hq
    have hu : IsUnit q' := IsLocalRing.notMem_maximalIdeal.mp hq
    apply hnb
    rw [hq']
    exact (IsUnit.mul_right_dvd hu).mpr dvd_rfl

  have hinjWA : Function.Injective (algebraMap ↥W A) := by
    haveI : NoZeroSMulDivisors ↥W A := hPD.2.1
    exact FaithfulSMul.algebraMap_injective ↥W A
  have hb₀K : algebraMap A K (algebraMap ↥W A b₀) ≠ 0 := by
    intro h
    apply hb₀0
    apply hinjWA
    apply IsFractionRing.injective A K
    rw [h, map_zero, map_zero]
  have hc'eq : c' = c₀ + b₀ * e' := by rw [← he']; ring
  have hS : wcLlsScS W A K t c₀ b₀ - algebraMap A K (algebraMap ↥W A e') =
      wcLlsScS W A K t c' b₀ := by
    unfold wcLlsScS
    rw [eq_div_iff hb₀K, sub_mul, div_mul_cancel₀ _ hb₀K, hc'eq]
    simp only [map_sub, map_add, map_mul]
    ring

  have hR : Algebra.adjoin A {wcLlsScS W A K t c₀ b₀} =
      Algebra.adjoin A {wcLlsScS W A K t c' b₀} := by
    apply le_antisymm
    · apply Algebra.adjoin_le
      rw [Set.singleton_subset_iff]
      have h1 : wcLlsScS W A K t c₀ b₀ =
          wcLlsScS W A K t c' b₀ + algebraMap A K (algebraMap ↥W A e') := by
        rw [← hS]; ring
      rw [h1]
      exact Subalgebra.add_mem _ (Algebra.subset_adjoin (Set.mem_singleton _))
        (Subalgebra.algebraMap_mem _ _)
    · apply Algebra.adjoin_le
      rw [Set.singleton_subset_iff, ← hS]
      exact Subalgebra.sub_mem _ (Algebra.subset_adjoin (Set.mem_singleton _))
        (Subalgebra.algebraMap_mem _ _)

  have T : ∀ (R₁ R₂ : Subalgebra A K) (_ : R₁ = R₂) (x₁ : ↥R₁) (x₂ : ↥R₂), (x₁ : K) = (x₂ : K) →
      (∀ (𝔮 : Ideal ↥(integralClosure ↥R₁ L)) [𝔮.IsPrime],
        𝔮.comap (algebraMap ↥R₁ ↥(integralClosure ↥R₁ L)) =
          Ideal.span {x₁} ⊔
            (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥R₁).comp (algebraMap ↥W A)) →
        wcpaDjLkDelta (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
          ↥R₁ 𝔮) = 0) →
      (∀ (𝔮 : Ideal ↥(integralClosure ↥R₂ L)) [𝔮.IsPrime],
        𝔮.comap (algebraMap ↥R₂ ↥(integralClosure ↥R₂ L)) =
          Ideal.span {x₂} ⊔
            (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥R₂).comp (algebraMap ↥W A)) →
        wcpaDjLkDelta (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
          ↥R₂ 𝔮) = 0) := by
    intro R₁ R₂ h x₁ x₂ hx H
    subst h
    obtain rfl : x₁ = x₂ := Subtype.ext hx
    exact H
  have hx : ((⟨wcLlsScS W A K t c₀ b₀, Algebra.subset_adjoin (Set.mem_singleton _)⟩ -
      algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀}) (algebraMap ↥W A e') :
        ↥(Algebra.adjoin A {wcLlsScS W A K t c₀ b₀})) : K) =
      ((⟨wcLlsScS W A K t c' b₀, Algebra.subset_adjoin (Set.mem_singleton _)⟩ :
        ↥(Algebra.adjoin A {wcLlsScS W A K t c' b₀})) : K) := by
    rw [Subalgebra.coe_sub, Subalgebra.coe_algebraMap]
    exact hS
  unfold wcLlsInnerSmooth at hIS
  have hIS' := T _ _ hR _ _ hx hIS

  obtain ⟨Q, hQP, hQc, hQu⟩ := wcpa_dj_llsm_sc_residue_uniq Ω W hW hWt A K L 𝔭 t y hPD hyP hyc
    hUniq c' b₀ b' q' hc' hb₀ hb₀0 hq'm hq' hb'0 hsep'
  haveI := hQP
  have hQc' := hQc
  unfold wcLlsScN at hQc'
  have hδQ := hIS' Q hQc'
  exact hδ hyP t rfl (wcpa_dj_llsm_sc_disc_criterion Ω W hW hWt A K L 𝔭 t y hPD hyP hyc hUniq
    c' b₀ b' q' hc' hb₀ hb₀0 hq'm hq' hb'0 hsep' Q hQc hQu hδQ)

theorem wcLls_disc_sep_enlarge : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
