    have hc'Q : wcIcxIncl L _ _ hRI c' ∉ QI := fun h => hc' (by rw [← hQIy]; exact h)
    exact ⟨ζ, h2, hirr _ QI 𝔷I a _ _ hairr hc'Q h1⟩

theorem wcpa_dj_llsm_isi_contract : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' b : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    a' ∣ b → ¬ b ∣ a' → b ∣ g →
    wcLlsAnnSep W A K L u a' → wcLlsIsiSep2 W A K L u a' b → wcLlsIsiCirc W A K L u a' →
    wcLlsAnnSep W A K L u b :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' b hPD ha'm ha'0 hbm hb0 ha'b
    hnba hbg hAo hIs hCirc
  classical

  have gen : ∀ (B C : Type u) [CommRing B] [CommRing C] (ι : B →+* C) (I y : Ideal B)
      [y.IsPrime] (Q 𝔷 : Ideal C) [Q.IsPrime] [𝔷.IsPrime], Q.comap ι = y → 𝔷 ≤ Q →
      (∀ a ∈ I, ι a ∈ 𝔷) → (∀ z : C, ∃ c c' : B, c' ∉ y ∧ ι c' * z - ι c ∈ 𝔷) →
      ∃ φ : (Localization.AtPrime y ⧸ I.map (algebraMap B (Localization.AtPrime y))) →+*
          wcLlsCasD C Q 𝔷,
        Function.Surjective φ ∧
        (∀ (a : B) (s : y.primeCompl),
          φ (Ideal.Quotient.mk _ (IsLocalization.mk' (Localization.AtPrime y) a s)) = 0 →
            ι a ∈ 𝔷) ∧
        (∀ a : B, φ (Ideal.Quotient.mk _ (algebraMap B (Localization.AtPrime y) a)) =
          Ideal.Quotient.mk _ (algebraMap C (Localization.AtPrime Q) (ι a))) := by
    intro B C _ _ ι I y hyP Q 𝔷 hQP h𝔷P hQy h𝔷Q hI hcon
    have hyQ : y = Q.comap ι := hQy.symm
    let φ0 : Localization.AtPrime y →+* Localization.AtPrime Q :=
      Localization.localRingHom y Q ι hyQ
    let ψ : Localization.AtPrime y →+* wcLlsCasD C Q 𝔷 := (Ideal.Quotient.mk _).comp φ0
    have hψ : ∀ a ∈ I.map (algebraMap B (Localization.AtPrime y)), ψ a = 0 := by
      intro a ha
      have hle : I.map (algebraMap B (Localization.AtPrime y)) ≤ RingHom.ker ψ := by
        rw [Ideal.map_le_iff_le_comap]
        intro c hc
        rw [Ideal.mem_comap, RingHom.mem_ker]
        show Ideal.Quotient.mk _ (φ0 (algebraMap _ _ c)) = 0
        rw [Localization.localRingHom_to_map, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.mem_map_of_mem _ (hI c hc)
      exact hle ha
    refine ⟨Ideal.Quotient.lift _ ψ hψ, ?_, ?_, ?_⟩
    · intro d
      obtain ⟨d', rfl⟩ := Ideal.Quotient.mk_surjective d
      obtain ⟨⟨z, s⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl d'
      obtain ⟨a1, a1', ha1', h1⟩ := hcon z
      obtain ⟨a2, a2', ha2', h2⟩ := hcon (s : C)
      have ha2 : a2 ∉ y := by
        intro ha2
        have hm : ι a2 ∈ Q := by
          have : a2 ∈ Q.comap ι := hyQ ▸ ha2
          exact this
        have h3 : ι a2' * (s : C) ∈ Q := by
          have := Q.add_mem (h𝔷Q h2) hm
          rwa [sub_add_cancel] at this
        rcases hQP.mem_or_mem h3 with h | h
        · exact ha2' (hyQ.symm ▸ (show a2' ∈ Q.comap ι from h))
        · exact s.2 h
      have hyden : a1' * a2 ∈ y.primeCompl := fun h => (hyP.mem_or_mem h).elim ha1' ha2
      have hden : ι (a1' * a2) ∈ Q.primeCompl := by
        intro h
        have h' : a1' * a2 ∈ y := by rw [hyQ]; exact h
        exact hyden h'
      refine ⟨Ideal.Quotient.mk _ (IsLocalization.mk' (Localization.AtPrime y) (a1 * a2')
        (⟨a1' * a2, hyden⟩ : y.primeCompl)), ?_⟩
      rw [Ideal.Quotient.lift_mk]
      show Ideal.Quotient.mk _ (φ0 (IsLocalization.mk' (Localization.AtPrime y) (a1 * a2')
        (⟨a1' * a2, hyden⟩ : y.primeCompl))) =
        Ideal.Quotient.mk _ (IsLocalization.mk' (Localization.AtPrime Q) z s)
      rw [Localization.localRingHom_mk', Ideal.Quotient.eq]
      have hmem : ι a1 * ι a2' * (s : C) - z * (ι a1' * ι a2) ∈ 𝔷 := by
        have key : ι a1 * ι a2' * (s : C) - z * (ι a1' * ι a2) =
            z * ι a1' * (ι a2' * (s : C) - ι a2) - ι a2' * (s : C) * (ι a1' * z - ι a1) := by
          ring
        rw [key]
        exact 𝔷.sub_mem (𝔷.mul_mem_left _ h2) (𝔷.mul_mem_left _ h1)
      have e := IsLocalization.mk'_sub (Localization.AtPrime Q) (ι (a1 * a2')) z
        (⟨ι (a1' * a2), hden⟩ : Q.primeCompl) s
      have hmem' : IsLocalization.mk' (Localization.AtPrime Q) (ι (a1 * a2'))
          (⟨ι (a1' * a2), hden⟩ : Q.primeCompl) -
          IsLocalization.mk' (Localization.AtPrime Q) z s ∈
          Ideal.map (algebraMap C (Localization.AtPrime Q)) 𝔷 := by
        rw [← e, IsLocalization.mk'_mem_map_algebraMap_iff]
        refine ⟨1, Q.primeCompl.one_mem, ?_⟩
        rw [one_mul]
        show ι (a1 * a2') * (s : C) - z * ι (a1' * a2) ∈ 𝔷
