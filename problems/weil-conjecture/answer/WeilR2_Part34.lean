  have hc₀O : algebraMap A K (algebraMap ↥W A c₀W) ∈ O :=
    (hOmem _).mpr ⟨algebraMap ↥W A c₀W, 1, hNBu 1 h1𝔭, by rw [map_one, mul_one]⟩
  have hc₀pow : (algebraMap A K (algebraMap ↥W A c₀W)) ^ (ℓ - 1) = ((ℓ : ℕ) : K) := by
    rw [← map_pow, ← map_pow, hc₀, map_natCast, map_natCast]
  have hℓK0 : ((ℓ : ℕ) : K) ≠ 0 := by
    have e : ((ℓ : ℕ) : K) = algebraMap A K (algebraMap ↥W A ((ℓ : ℕ) : ↥W)) := by
      rw [map_natCast, map_natCast]
    rw [e]
