          (Localization.AtPrime Q)).comp ((algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))))) g₀ f →
    ∀ (n : ℕ) (ε : P) (ω : ↥W), 1 ≤ n → IsUnit ε → IsUnit ω → g₀ ^ n = ω * (a' * q') →
      e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Q)
          (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
            ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩)) =
        ε * f (wcEbntX W g₀ 0) ^ n →
      (e.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
          (Localization.AtPrime Q)).comp ((algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))))) ω *
        e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Q)
          (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
            (algebraMap A ↥(Algebra.adjoin A {s}) u))) * ε =
        f (wcEbntX W g₀ 1) ^ n →
    ∀ μ g₁ : ↥W, μ ∈ IsLocalRing.maximalIdeal ↥W → μ ≠ 0 → μ ^ n = ω * a' → g₀ = μ * g₁ →
    ∀ Y' : FractionRing P,
      algebraMap P (FractionRing P) ((e.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
          (Localization.AtPrime Q)).comp ((algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))))) μ) * Y' =
