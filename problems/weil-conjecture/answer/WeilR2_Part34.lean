        rw [← map_pow, ← IsLocalization.mk'_pow, Ideal.Quotient.eq_zero_iff_mem,
          IsLocalization.mk'_mem_map_algebraMap_iff]
        exact ⟨σ, hσ, hn⟩
      exact IsReduced.eq_zero _ ⟨n, hpow⟩
    have hnode := wcpa_dj_llsm_isic_node_of_pair _ _ _ φ₁ φ₂ hs₁ hs₂ hjoint hx₁ hx₂
    exact fun h => h (Or.inr hnode)
  exact final _ y₀ _ _ _ φo φI hrad0 hφos hφIs
    (fun a s h1 h2 => hnil a (hφok a s h1) (hφIk a s h2))
    ⟨Ideal.Quotient.mk _ (algebraMap _ _ xo), by rw [hφof]; exact hxoirr,
      by rw [hφIf, Ideal.Quotient.eq_zero_iff_mem]; exact Ideal.mem_map_of_mem _ hxoI⟩
    ⟨Ideal.Quotient.mk _ (algebraMap _ _ xI),
      by rw [hφof, Ideal.Quotient.eq_zero_iff_mem]; exact Ideal.mem_map_of_mem _ hxIo,
      by rw [hφIf]; exact hxIirr⟩

theorem wcpa_dj_llsm_isi_overlap_glue : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' q' r : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → q' ∈ IsLocalRing.maximalIdeal ↥W → q' ≠ 0 →
    r ≠ 0 → a' * q' * r ∣ g →
    wcLlsAnnSep W A K L u (a' * q') → wcLlsIsiSep2 W A K L u a' (a' * q' * r) →
    wcLlsAnnSep W A K L u (a' * q' * r) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' q' r
    hPD ha'm ha'0 hq'm hq'0 hr0 hdvd hS1 hI
  have hb1m : a' * q' ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_left _ a' hq'm
  have hb10 : a' * q' ≠ 0 := mul_ne_zero ha'0 hq'0
  have hb1g : a' * q' ∣ g := dvd_trans (dvd_mul_right (a' * q') r) hdvd
  have hb2m : a' * q' * r ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right r _ hb1m
  have hb20 : a' * q' * r ≠ 0 := mul_ne_zero hb10 hr0
  have ha'b2 : a' ∣ a' * q' * r := ⟨q' * r, by ring⟩
  have hstrict : ¬ (a' * q' * r ∣ a') := by
    rintro ⟨t, ht⟩
    have h1 : a' * 1 = a' * (q' * (r * t)) := by
      calc a' * 1 = a' := mul_one a'
        _ = a' * q' * r * t := ht
        _ = a' * (q' * (r * t)) := by ring
    have h2 : (1 : ↥W) = q' * (r * t) := mul_left_cancel₀ ha'0 h1
    have hu : IsUnit q' := isUnit_iff_exists_inv.mpr ⟨r * t, h2.symm⟩
    exact (IsLocalRing.mem_maximalIdeal q').mp hq'm hu
  have hA' : wcLlsAnnSep W A K L u a' :=
    wcpa_dj_llsm_br_radial_mono Ω W hW hWt A K L 𝔭 (.ann u v g) u (a' * q') a' hPD
      (Or.inr ⟨v, g, rfl, hb1g⟩) hb1m hb10 ha'm ha'0 (dvd_mul_right a' q') hS1
  have hC : wcLlsIsiCirc W A K L u a' :=
    wcpa_dj_llsm_isi_circle_good Ω W hW hWt A K L 𝔭 u v g a' q' hPD ha'm ha'0 hq'm hq'0
      hb1g hS1
  exact wcpa_dj_llsm_isi_contract Ω W hW hWt A K L 𝔭 u v g a' (a' * q' * r) hPD ha'm ha'0
    hb2m hb20 ha'b2 hstrict hdvd hA' hI hC

theorem wcpa_dj_llsm_rsi_overlap_glue : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A) (c a' q r : ↥W),
    wcLlsPD W A 𝔭 (.disc t) →
    c ∈ IsLocalRing.maximalIdeal ↥W → a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 →
    q ∈ IsLocalRing.maximalIdeal ↥W → q ≠ 0 → r ≠ 0 →
    wcLlsDiscSep W A K L t c (a' * q) → wcLlsRsiSep2 W A K L t c a' (a' * q * r) →
    wcLlsDiscSep W A K L t c (a' * q * r) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t c a' q r hPD hc ha' ha'0 hq hq0 hr0
    hSep hMid

  have hbm : a' * q ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right q _ ha'
  have hb0 : a' * q ≠ 0 := mul_ne_zero ha'0 hq0
  have hb'm : a' * q * r ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right r _ hbm
  have hb'0 : a' * q * r ≠ 0 := mul_ne_zero hb0 hr0
  have hdvd2 : a' ∣ a' * q * r := ⟨q * r, by ring⟩
  have hstrict : ¬ (a' * q * r ∣ a') := by
    rintro ⟨s, hs⟩
    have h1 : a' * 1 = a' * (q * (r * s)) := by
      rw [mul_one]
      calc a' = a' * q * r * s := hs
        _ = a' * (q * (r * s)) := by ring
    have h2 : 1 = q * (r * s) := mul_left_cancel₀ ha'0 h1
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hq))
      (isUnit_iff_exists_inv.mpr ⟨r * s, h2.symm⟩)

  obtain ⟨A', _, _, _, _, _, _, _, u', v', 𝔭', hBr, hu', hv', hPD', hiff, -, -⟩ :=
    wcpa_dj_llsm_br_boundary_chart Ω W hW hWt A K L 𝔭 (.disc t) (t - algebraMap ↥W A c)
      (a' * q * r) hPD (Or.inl ⟨t, c, rfl, hc, rfl⟩) hb'm hb'0

  have hAnn : wcLlsAnnSep W A' K L u' (a' * q) := (hiff (a' * q) hbm hb0 ⟨r, rfl⟩).mp hSep

  have hIsi : wcLlsIsiSep2 W A' K L u' a' (a' * q * r) :=
    wcpa_dj_llsm_rsi_to_isi_sep Ω W hW hWt A K L A' 𝔭 𝔭' t u' v' c a' (a' * q * r) hPD hc ha'
      ha'0 hb'm hb'0 hdvd2 hstrict hBr hu' hv' hPD' hMid

  have hGlue : wcLlsAnnSep W A' K L u' (a' * q * r) :=
    wcpa_dj_llsm_isi_overlap_glue Ω W hW hWt A' K L 𝔭' u' v' (a' * q * r) a' q r hPD' ha' ha'0
      hq hq0 hr0 dvd_rfl hAnn hIsi

  exact (hiff (a' * q * r) hb'm hb'0 dvd_rfl).mpr hGlue

theorem wcpa_dj_llsm_br_residue_sep_iff : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A) (y : Ideal ↥(integralClosure A L))
    (c'' b₀ β : ↥W) (A'' : Type u) [CommRing A''] [IsDomain A''] [Algebra ↥W A''] [Algebra A'' K]
    [IsFractionRing A'' K] [Algebra A'' L] [IsScalarTower A'' K L] (t' : A'') (𝔭'' : Ideal A''),
    wcLlsPD W A 𝔭 (.disc t) → y.IsPrime → y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
    wcLlsUniq A L 𝔭 y →
    (∀ (_ : y.IsPrime),
      wcpaDjLkDelta (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) ≠ 0) →
    c'' ∈ IsLocalRing.maximalIdeal ↥W → b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 →
    wcLlsBrSub W A K A''
      (algebraMap A K (t - algebraMap ↥W A c'') / algebraMap A K (algebraMap ↥W A b₀))
      {algebraMap A K (t - algebraMap ↥W A c'') / algebraMap A K (algebraMap ↥W A b₀)} →
    algebraMap A'' K t' =
      algebraMap A K (t - algebraMap ↥W A c'') / algebraMap A K (algebraMap ↥W A b₀) →
    wcLlsPD W A'' 𝔭'' (.disc t') →
    β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 → wcLlsDiscSep W A K L t c'' (b₀ * β) →
    wcLlsDiscSep W A K L t c'' b₀ →
    ∀ e β' : ↥W, e ∈ IsLocalRing.maximalIdeal ↥W → β' ∈ IsLocalRing.maximalIdeal ↥W → β' ≠ 0 →
      (wcLlsDiscSep W A'' K L t' e β' ↔ wcLlsDiscSep W A K L t (c'' + b₀ * e) (b₀ * β')) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y c'' b₀ β A'' _ _ _ _ _ _ _ t' 𝔭''
    hPD _ _ _ _ hc'' hb₀m hb₀0 hBr ht' hPD'' hβm hβ0 hSepβ _ e β' hem hβ'm hβ'0
  have hcm : c'' + b₀ * e ∈ IsLocalRing.maximalIdeal ↥W :=
    Ideal.add_mem _ hc'' (Ideal.mul_mem_left _ b₀ hem)

  have hγ : ∃ γ : ↥W, γ ∈ IsLocalRing.maximalIdeal ↥W ∧ γ ≠ 0 ∧ γ ∣ e ∧
      wcLlsDiscSep W A K L t c'' (b₀ * γ) := by
    rcases ValuationRing.dvd_total β e with h | h
    · exact ⟨β, hβm, hβ0, h, hSepβ⟩
    · have he0 : e ≠ 0 := by
        rintro rfl
        exact hβ0 (zero_dvd_iff.mp h)
      refine ⟨e, hem, he0, dvd_rfl, ?_⟩
      exact wcpa_dj_llsm_br_radial_mono Ω W hW hWt A K L 𝔭 (.disc t) (t - algebraMap ↥W A c'')
        (b₀ * β) (b₀ * e) hPD (Or.inl ⟨t, c'', rfl, hc'', rfl⟩)
        (Ideal.mul_mem_left _ b₀ hβm) (mul_ne_zero hb₀0 hβ0)
        (Ideal.mul_mem_left _ b₀ hem) (mul_ne_zero hb₀0 he0)
        (mul_dvd_mul_left b₀ h) hSepβ
  obtain ⟨γ, hγm, hγ0, hγe, hG₀⟩ := hγ
  have hb₀γm : b₀ * γ ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_left _ b₀ hγm
  have hb₀γ0 : b₀ * γ ≠ 0 := mul_ne_zero hb₀0 hγ0

  have hG : wcLlsDiscSep W A K L t (c'' + b₀ * e) (b₀ * γ) := by
    refine (wcpa_dj_llsm_nss_recenter W A K L 𝔭 t hPD c'' (c'' + b₀ * e) (b₀ * γ) hc'' hcm
      hb₀γm hb₀γ0 ?_).mp hG₀
    have h1 : c'' - (c'' + b₀ * e) = -(b₀ * e) := by ring
    rw [h1, dvd_neg]
    exact mul_dvd_mul_left b₀ hγe
  have hb₀β'm : b₀ * β' ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_left _ b₀ hβ'm
  have hb₀β'0 : b₀ * β' ≠ 0 := mul_ne_zero hb₀0 hβ'0
  have hT := wcpa_dj_llsm_rsi_chart_transport Ω W hW hWt A K L 𝔭 t c'' b₀ e β' A'' t' 𝔭''
    hPD hc'' hb₀m hb₀0 hBr ht' hPD'' hem hβ'm hβ'0
  constructor
  · intro hA''
    have hH := hT.mp hA''
    rcases ValuationRing.dvd_total β' γ with h | ⟨r, hr⟩
    · exact wcpa_dj_llsm_br_radial_mono Ω W hW hWt A K L 𝔭 (.disc t)
        (t - algebraMap ↥W A (c'' + b₀ * e)) (b₀ * γ) (b₀ * β') hPD
        (Or.inl ⟨t, c'' + b₀ * e, rfl, hcm, rfl⟩) hb₀γm hb₀γ0 hb₀β'm hb₀β'0
        (mul_dvd_mul_left b₀ h) hG
    · have hr0 : r ≠ 0 := by
        rintro rfl
        exact hβ'0 (by rw [hr, mul_zero])
      have heq : b₀ * β' = b₀ * γ * r := by rw [hr, mul_assoc]
      rw [heq] at hH ⊢
      exact wcpa_dj_llsm_rsi_overlap_glue Ω W hW hWt A K L 𝔭 t (c'' + b₀ * e) b₀ γ r hPD hcm
        hb₀m hb₀0 hγm hγ0 hr0 hG hH
  · intro hA
    exact hT.mpr (wcpa_dj_llsm_rsi_outer_restrict Ω W hW hWt A K L 𝔭 t (c'' + b₀ * e) b₀ β'
      hPD hcm hb₀m hb₀0 hβ'm hβ'0 hA)

theorem wcpa_dj_llsm_isi_chart_transport : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] (𝔭 : Ideal A) (u v : A)
    (g b₀ q β' : ↥W) (A₃ : Type u) [CommRing A₃] [IsDomain A₃] [Algebra ↥W A₃] [Algebra A₃ K]
    [IsFractionRing A₃ K] (u₃ v₃ : A₃) (𝔭₃ : Ideal A₃),
    wcLlsPD W A 𝔭 (.ann u v g) →
    b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 → q ∈ IsLocalRing.maximalIdeal ↥W → g = b₀ * q →
    wcLlsBrSub W A K A₃ (algebraMap A K u / algebraMap A K (algebraMap ↥W A b₀))
      {algebraMap A K u / algebraMap A K (algebraMap ↥W A b₀), algebraMap A K v} →
    algebraMap A₃ K u₃ = algebraMap A K u / algebraMap A K (algebraMap ↥W A b₀) →
    algebraMap A₃ K v₃ = algebraMap A K v →
    wcLlsPD W A₃ 𝔭₃ (.ann u₃ v₃ q) →
    β' ∈ IsLocalRing.maximalIdeal ↥W → β' ≠ 0 → β' ∣ q →
    (wcLlsAnnSep W A₃ K L u₃ β' ↔ wcLlsIsiSep2 W A K L u b₀ (b₀ * β')) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ 𝔭 u v g b₀ q β' A₃ _ _ _ _ _ u₃ v₃ 𝔭₃
    hPD hb₀m hb₀0 hqm hgq hBr hu₃ hv₃ hPD₃ hβ'm hβ'0 hβ'q

  have s2 : ∀ (B : Type u) [CommRing B] [Algebra B K] (P : Ideal B) (G : Set K), P.IsMaximal →
      ∀ N J : Ideal ↥(Algebra.adjoin B G),
      (∀ y : ↥(Algebra.adjoin B G), (y : K) ∈ G → y ∈ N) →
      P ≤ N.comap (algebraMap B ↥(Algebra.adjoin B G)) → N ≤ J → J ≠ ⊤ → J = N := by
    intro B _ _ P G hP N J hG hPN hNJ hJ
    refine le_antisymm ?_ hNJ
    have nf : ∀ (x : K) (hx : x ∈ Algebra.adjoin B G), ∃ a : B,
        (⟨x, hx⟩ : ↥(Algebra.adjoin B G)) - algebraMap B _ a ∈ N := by
      intro x hx
      induction hx using Algebra.adjoin_induction with
      | mem x hx => exact ⟨0, by rw [map_zero, sub_zero]; exact hG ⟨x, Algebra.subset_adjoin hx⟩ hx⟩
      | algebraMap a =>
        refine ⟨a, ?_⟩
        have e : (⟨algebraMap B K a, Subalgebra.algebraMap_mem _ a⟩ : ↥(Algebra.adjoin B G)) =
            algebraMap B _ a := rfl
        rw [e, sub_self]; exact N.zero_mem
      | add x y hx hy ihx ihy =>
        obtain ⟨a, ha⟩ := ihx
        obtain ⟨b, hb⟩ := ihy
        refine ⟨a + b, ?_⟩
        have e : (⟨x + y, add_mem hx hy⟩ : ↥(Algebra.adjoin B G)) - algebraMap B _ (a + b) =
            ((⟨x, hx⟩ : ↥(Algebra.adjoin B G)) - algebraMap B _ a) +
            ((⟨y, hy⟩ : ↥(Algebra.adjoin B G)) - algebraMap B _ b) := by
          show ((⟨x, hx⟩ : ↥(Algebra.adjoin B G)) + ⟨y, hy⟩) - algebraMap B _ (a + b) = _
          rw [map_add]; ring
        rw [e]; exact add_mem ha hb
      | mul x y hx hy ihx ihy =>
        obtain ⟨a, ha⟩ := ihx
        obtain ⟨b, hb⟩ := ihy
        refine ⟨a * b, ?_⟩
        have e : (⟨x * y, mul_mem hx hy⟩ : ↥(Algebra.adjoin B G)) - algebraMap B _ (a * b) =
            ((⟨x, hx⟩ : ↥(Algebra.adjoin B G)) - algebraMap B _ a) * ⟨y, hy⟩ +
            algebraMap B _ a * ((⟨y, hy⟩ : ↥(Algebra.adjoin B G)) - algebraMap B _ b) := by
          show ((⟨x, hx⟩ : ↥(Algebra.adjoin B G)) * ⟨y, hy⟩) - algebraMap B _ (a * b) = _
          rw [map_mul]; ring
        rw [e]; exact add_mem (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_left _ _ hb)
    intro x hxJ
    obtain ⟨a, ha⟩ := nf x.1 x.2
    have hxa : x - algebraMap B _ a ∈ N := ha
    have haJ : algebraMap B ↥(Algebra.adjoin B G) a ∈ J := by
      have e : algebraMap B ↥(Algebra.adjoin B G) a = x - (x - algebraMap B _ a) := by ring
      rw [e]; exact sub_mem hxJ (hNJ hxa)
    by_cases hc : a ∈ P
    · have e : x = (x - algebraMap B _ a) + algebraMap B _ a := by ring
      rw [e]; exact add_mem hxa (hPN hc)
    · exfalso
      obtain ⟨β, i, hi, hβ⟩ := hP.exists_inv hc
      apply hJ
      rw [Ideal.eq_top_iff_one]
      have e1 : (1 : ↥(Algebra.adjoin B G)) =
          algebraMap B _ β * algebraMap B _ a + algebraMap B _ i := by
        rw [← map_mul, ← map_add, hβ, map_one]
      rw [e1]
      exact add_mem (Ideal.mul_mem_left _ _ haJ) (hNJ (hPN hi))

  have s3 : ∀ (B : Type u) [CommRing B] [Algebra B K] (s : K) (T : Subalgebra A K)
      (M : Submonoid K), (∀ k ∈ M, k ∈ T) → (∃ k ∈ M, k * s ∈ T) →
      (∀ a : B, ∃ k ∈ M, k * algebraMap B K a ∈ T) →
      ∀ r ∈ Algebra.adjoin B {s}, ∃ k ∈ M, k * r ∈ T := by
    intro B _ _ s T M hMT hs ha r hr
    induction hr using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact hs
    | algebraMap a => exact ha a
    | add x y _ _ hx hy =>
      obtain ⟨k₁, hk₁, h₁⟩ := hx
      obtain ⟨k₂, hk₂, h₂⟩ := hy
      refine ⟨k₁ * k₂, mul_mem hk₁ hk₂, ?_⟩
      have e : k₁ * k₂ * (x + y) = k₂ * (k₁ * x) + k₁ * (k₂ * y) := by ring
      rw [e]
      exact add_mem (mul_mem (hMT _ hk₂) h₁) (mul_mem (hMT _ hk₁) h₂)
    | mul x y _ _ hx hy =>
      obtain ⟨k₁, hk₁, h₁⟩ := hx
      obtain ⟨k₂, hk₂, h₂⟩ := hy
      refine ⟨k₁ * k₂, mul_mem hk₁ hk₂, ?_⟩
      have e : k₁ * k₂ * (x * y) = (k₁ * x) * (k₂ * y) := by ring
      rw [e]
      exact mul_mem h₁ h₂

  have s4 : ∀ (B B'' : Type u) [CommRing B] [CommRing B''] [Algebra B K] [Algebra B'' K]
      (R : Subalgebra B K) (R'' : Subalgebra B'' K) (M : Submonoid K),
      (∀ k ∈ M, k ∈ R) → (∀ r ∈ R'', ∃ k ∈ M, k * r ∈ R) →
      ∀ x : L, IsIntegral ↥R'' x → ∃ k ∈ M, IsIntegral ↥R (algebraMap K L k * x) := by
    intro B B'' _ _ _ _ R R'' M hMR hmul x hx
    classical
    obtain ⟨p, hpm, hp⟩ := hx
    choose! qf hqfM hqf using hmul
    set n := p.natDegree with hn
    set Q := ∏ i ∈ Finset.range (n + 1), qf ((p.coeff i : R'') : K) with hQ
    have hQM : Q ∈ M := prod_mem (fun i _ => hqfM _ (p.coeff i).2)
    have hQc : ∀ i ∈ Finset.range (n + 1), Q * ((p.coeff i : R'') : K) ∈ R := by
      intro i hi
      rw [hQ, ← Finset.prod_erase_mul _ _ hi, mul_assoc]
      exact mul_mem (prod_mem fun j _ => hMR _ (hqfM _ (p.coeff j).2)) (hqf _ (p.coeff i).2)
    set qq : Polynomial K := (p.map R''.val.toRingHom).scaleRoots Q with hqq
    have hpm' : (p.map R''.val.toRingHom).Monic := hpm.map _
    have hnd : (p.map R''.val.toRingHom).natDegree = n := hpm.natDegree_map _
    have hqm : qq.Monic := (Polynomial.monic_scaleRoots_iff _).mpr hpm'
    have hcoeff : ∀ i, qq.coeff i ∈ R := by
      intro i
      rw [hqq, Polynomial.coeff_scaleRoots, hnd, Polynomial.coeff_map]
      rcases lt_trichotomy i n with hi | hi | hi
      · show ((p.coeff i : R'') : K) * Q ^ (n - i) ∈ R
        obtain ⟨m, hm⟩ : ∃ m, n - i = m + 1 := ⟨n - i - 1, by omega⟩
        have e : ((p.coeff i : R'') : K) * Q ^ (n - i) =
            Q ^ m * (Q * ((p.coeff i : R'') : K)) := by
          rw [hm, pow_succ]; ring
        rw [e]
        exact mul_mem (pow_mem (hMR _ hQM) _) (hQc i (Finset.mem_range.mpr (by omega)))
      · subst hi
        show ((p.coeff p.natDegree : R'') : K) * Q ^ (p.natDegree - p.natDegree) ∈ R
        rw [hpm.coeff_natDegree, Nat.sub_self, pow_zero, mul_one]
        exact one_mem _
      · show ((p.coeff i : R'') : K) * Q ^ (n - i) ∈ R
        rw [Polynomial.coeff_eq_zero_of_natDegree_lt hi]
        simp
    have hqlift : qq ∈ Polynomial.lifts R.val.toRingHom := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      exact ⟨⟨qq.coeff i, hcoeff i⟩, rfl⟩
    obtain ⟨q', hq'map, _, hq'm⟩ := Polynomial.lifts_and_degree_eq_and_monic hqlift hqm
    refine ⟨Q, hQM, q', hq'm, ?_⟩
    have halg : algebraMap ↥R L = (algebraMap K L).comp R.val.toRingHom := rfl
    rw [halg, ← Polynomial.eval₂_map, hq'map, hqq]
    apply Polynomial.scaleRoots_eval₂_eq_zero
    rw [Polynomial.eval₂_map]
    exact hp

  have s5 : ∀ (C C'' : Type u) [CommRing C] [CommRing C''] (i : C →+* L) (i'' : C'' →+* L)
      (j : C →+* C''), Function.Injective i → i''.comp j = i →
      ∀ Q : Ideal C, Q.IsPrime → (∀ y : C'', ∃ d x : C, d ∉ Q ∧ i x = i d * i'' y) →
      ∃ Q'' : Ideal C'', Q''.IsPrime ∧ Q''.comap j = Q := by
    intro C C'' _ _ i i'' j hi hij Q hQ H
    have hij' : ∀ x, i'' (j x) = i x := fun x => RingHom.congr_fun hij x
    have hdd : ∀ d d' : C, d ∉ Q → d' ∉ Q → d * d' ∉ Q :=
      fun d d' hd hd' h => (hQ.mem_or_mem h).elim hd hd'
    have h1Q : (1 : C) ∉ Q := fun h => hQ.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    have indep : ∀ (y : C'') (d x d' x' : C), d ∉ Q → d' ∉ Q → i x = i d * i'' y →
        i x' = i d' * i'' y → x' ∈ Q → x ∈ Q := by
      intro y d x d' x' hd hd' h1 h2 hx'
      have e : d' * x = d * x' := hi (by rw [map_mul, map_mul, h1, h2]; ring)
      have h3 : d' * x ∈ Q := by rw [e]; exact Q.mul_mem_left _ hx'
      exact (hQ.mem_or_mem h3).resolve_left hd'
    let Q'' : Ideal C'' :=
      { carrier := {y | ∃ d x : C, d ∉ Q ∧ i x = i d * i'' y ∧ x ∈ Q}
        add_mem' := by
          rintro a b ⟨d₁, x₁, hd₁, h1, hx₁⟩ ⟨d₂, x₂, hd₂, h2, hx₂⟩
          refine ⟨d₁ * d₂, x₁ * d₂ + x₂ * d₁, hdd _ _ hd₁ hd₂, ?_,
            add_mem (Q.mul_mem_right _ hx₁) (Q.mul_mem_right _ hx₂)⟩
          rw [map_add, map_mul, map_mul, map_mul, map_add, h1, h2]; ring
        zero_mem' := ⟨1, 0, h1Q, by simp, Q.zero_mem⟩
        smul_mem' := by
          rintro c b ⟨d₁, x₁, hd₁, h1, hx₁⟩
          obtain ⟨dc, xc, hdc, hc⟩ := H c
          refine ⟨dc * d₁, xc * x₁, hdd _ _ hdc hd₁, ?_, Q.mul_mem_left _ hx₁⟩
          rw [smul_eq_mul, map_mul, map_mul, map_mul, hc, h1]; ring }
    have memQ : ∀ y, y ∈ Q'' ↔ ∃ d x : C, d ∉ Q ∧ i x = i d * i'' y ∧ x ∈ Q :=
      fun y => Iff.rfl
    refine ⟨Q'', ⟨?_, ?_⟩, ?_⟩
    · rw [Ne, Ideal.eq_top_iff_one, memQ]
      rintro ⟨d, x, hd, h, hx⟩
      have : x = d := hi (by rw [h, map_one, mul_one])
      exact hd (this ▸ hx)
    · intro a b hab
      obtain ⟨d, x, hd, h, hx⟩ := (memQ _).mp hab
      obtain ⟨d₁, x₁, hd₁, h1⟩ := H a
      obtain ⟨d₂, x₂, hd₂, h2⟩ := H b
      have h12 : i (x₁ * x₂) = i (d₁ * d₂) * i'' (a * b) := by
        rw [map_mul, map_mul, map_mul, h1, h2]; ring
      have hx12 := indep _ _ _ _ _ (hdd _ _ hd₁ hd₂) hd h12 h hx
      rcases hQ.mem_or_mem hx12 with h' | h'
      · exact Or.inl ((memQ _).mpr ⟨d₁, x₁, hd₁, h1, h'⟩)
      · exact Or.inr ((memQ _).mpr ⟨d₂, x₂, hd₂, h2, h'⟩)
    · ext x
      rw [Ideal.mem_comap, memQ]
      constructor
      · rintro ⟨d, x', hd, h, hx'⟩
        have e : x' = d * x := hi (by rw [h, hij', map_mul])
        rw [e] at hx'
        exact (hQ.mem_or_mem hx').resolve_left hd
      · intro hx
        exact ⟨1, x, h1Q, by rw [hij', map_one, one_mul], hx⟩

  have s6 : ∀ (C C'' : Type u) [CommRing C] [IsDomain C] [CommRing C''] [IsDomain C'']
      (i : C →+* L) (i'' : C'' →+* L) (j : C →+* C''),
      Function.Injective i → Function.Injective i'' → i''.comp j = i →
      ∀ (Q : Ideal C) [Q.IsPrime] (Q'' : Ideal C'') [Q''.IsPrime], Q''.comap j = Q →
      (∀ y : C'', ∃ d x : C, d ∉ Q ∧ i x = i d * i'' y) →
      ∃ e : Localization.AtPrime Q ≃+* Localization.AtPrime Q'',
        ∀ (x : C) (y : C''), i x = i'' y →
          e (algebraMap C (Localization.AtPrime Q) x) =
            algebraMap C'' (Localization.AtPrime Q'') y := by
    intro C C'' _ _ _ _ i i'' j hi hi'' hij Q hQ Q'' hQ'' hQQ H
    have hij' : ∀ x, i'' (j x) = i x := fun x => RingHom.congr_fun hij x
    have hne : ∀ d : C, d ∉ Q → i d ≠ 0 := by
      intro d hd h0
      apply hd
      have : d = 0 := hi (by rw [h0, map_zero])
      rw [this]; exact Q.zero_mem
    have hne'' : ∀ d : C'', d ∉ Q'' → i'' d ≠ 0 := by
      intro d hd h0
      apply hd
      have : d = 0 := hi'' (by rw [h0, map_zero])
      rw [this]; exact Q''.zero_mem
    have hjQ : ∀ d : C, d ∉ Q → j d ∉ Q'' := by
      intro d hd h
      apply hd
      rw [← hQQ]
      exact h
    have hu : ∀ d : Q.primeCompl, IsUnit (i d) := fun d => isUnit_iff_ne_zero.mpr (hne d d.2)
    have hu'' : ∀ d : Q''.primeCompl, IsUnit (i'' d) :=
      fun d => isUnit_iff_ne_zero.mpr (hne'' d d.2)
    obtain ⟨ι, hιa, hιm, hinj⟩ : ∃ ι : Localization.AtPrime Q →+* L,
        (∀ x, ι (algebraMap C _ x) = i x) ∧
        (∀ x (d : Q.primeCompl), i x = i d * ι (IsLocalization.mk' _ x d)) ∧
        Function.Injective ι := by
      refine ⟨IsLocalization.lift (M := Q.primeCompl) (S := Localization.AtPrime Q) hu,
        IsLocalization.lift_eq hu, fun x d => (IsLocalization.lift_mk'_spec hu x _ d).mp rfl, ?_⟩
      rw [IsLocalization.lift_injective_iff]
      intro x y
      constructor
      · intro h
        exact congrArg i (IsLocalization.injective (Localization.AtPrime Q)
          (Ideal.primeCompl_le_nonZeroDivisors Q) h)
      · intro h; rw [hi h]
    obtain ⟨ι'', hιa'', hιm'', hinj''⟩ : ∃ ι : Localization.AtPrime Q'' →+* L,
        (∀ x, ι (algebraMap C'' _ x) = i'' x) ∧
        (∀ x (d : Q''.primeCompl), i'' x = i'' d * ι (IsLocalization.mk' _ x d)) ∧
        Function.Injective ι := by
      refine ⟨IsLocalization.lift (M := Q''.primeCompl) (S := Localization.AtPrime Q'') hu'',
        IsLocalization.lift_eq hu'', fun x d => (IsLocalization.lift_mk'_spec hu'' x _ d).mp rfl,
        ?_⟩
      rw [IsLocalization.lift_injective_iff]
      intro x y
      constructor
      · intro h
        exact congrArg i'' (IsLocalization.injective (Localization.AtPrime Q'')
          (Ideal.primeCompl_le_nonZeroDivisors Q'') h)
      · intro h; rw [hi'' h]
    have hrange : ι.range = ι''.range := by
      apply le_antisymm
      · rintro _ ⟨z, rfl⟩
        obtain ⟨⟨x, d⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl z
        refine ⟨IsLocalization.mk' (Localization.AtPrime Q'') (j x) (⟨j d, hjQ d d.2⟩ : Q''.primeCompl), ?_⟩
        have hv := hιm x d
        have hv'' := hιm'' (j x) (⟨j d, hjQ d d.2⟩ : Q''.primeCompl)
        simp only [hij'] at hv''
        apply mul_left_cancel₀ (hne d d.2)
        rw [← hv, ← hv'']
      · rintro _ ⟨z, rfl⟩
        obtain ⟨⟨y, d''⟩, rfl⟩ := IsLocalization.mk'_surjective Q''.primeCompl z
        obtain ⟨d₁, x₁, hd₁, h1⟩ := H y
        obtain ⟨d₂, x₂, hd₂, h2⟩ := H d''
        have hx₂ : x₂ ∉ Q := by
          intro hx
          have e : j x₂ = j d₂ * d'' := hi'' (by rw [hij', map_mul, hij', h2])
          have : j d₂ * d'' ∈ Q'' := by rw [← e, ← Ideal.mem_comap, hQQ]; exact hx
          rcases hQ''.mem_or_mem this with h | h
          · exact hjQ d₂ hd₂ h
          · exact d''.2 h
        have hD : d₁ * x₂ ∈ Q.primeCompl := by
          intro h
          rcases hQ.mem_or_mem h with h | h
          · exact hd₁ h
          · exact hx₂ h
        refine ⟨IsLocalization.mk' (Localization.AtPrime Q) (x₁ * d₂) (⟨_, hD⟩ : Q.primeCompl), ?_⟩
        have hA := hιm (x₁ * d₂) (⟨_, hD⟩ : Q.primeCompl)
        have hB := hιm'' y d''
        simp only [map_mul] at hA
        have hX : i d₁ * i d₂ * i'' d'' ≠ 0 :=
          mul_ne_zero (mul_ne_zero (hne d₁ hd₁) (hne d₂ hd₂)) (hne'' d'' d''.2)
        apply mul_left_cancel₀ hX
        linear_combination (-1 : L) * hA + i d₂ * h1 -
          i d₁ * ι (IsLocalization.mk' (Localization.AtPrime Q) (x₁ * d₂) (⟨_, hD⟩ : Q.primeCompl)) * h2 +
          i d₁ * i d₂ * hB
    let e1 : Localization.AtPrime Q ≃+* ι.range :=
      RingEquiv.ofBijective ι.rangeRestrict
        ⟨fun a b h => hinj (congrArg Subtype.val h), RingHom.rangeRestrict_surjective ι⟩
    let e2 : Localization.AtPrime Q'' ≃+* ι''.range :=
      RingEquiv.ofBijective ι''.rangeRestrict
        ⟨fun a b h => hinj'' (congrArg Subtype.val h), RingHom.rangeRestrict_surjective ι''⟩
    let e : Localization.AtPrime Q ≃+* Localization.AtPrime Q'' :=
      e1.trans ((RingEquiv.subringCongr hrange).trans e2.symm)
    have hιe : ∀ z, ι'' (e z) = ι z := by
      intro z
      have := congrArg Subtype.val (e2.apply_symm_apply ((RingEquiv.subringCongr hrange) (e1 z)))
      exact this
    refine ⟨e, fun x y hxy => hinj'' ?_⟩
    rw [hιe, hιa, hιa'']
    exact hxy

  have hllfi : ∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) →
      wcpaDjLkDelta R = wcpaDjLkDelta S ∧ wcpaDjLkBranches R = wcpaDjLkBranches S := by
    intro R S _ _ e
    classical
    let eF : FractionRing R ≃+* FractionRing S := IsFractionRing.ringEquivOfRingEquiv e
    have H1 : ∀ r : R, eF (algebraMap R (FractionRing R) r) =
        algebraMap S (FractionRing S) (e r) :=
      fun r => IsFractionRing.ringEquivOfRingEquiv_algebraMap e r
    have H2 : ∀ s : S, eF.symm (algebraMap S (FractionRing S) s) =
        algebraMap R (FractionRing R) (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, H1, RingEquiv.apply_symm_apply]
    have C1 : (algebraMap S (FractionRing S)).comp (e : R →+* S) =
        (eF : FractionRing R →+* FractionRing S).comp (algebraMap R (FractionRing R)) := by
      ext r
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H1 r).symm
    have C2 : (algebraMap R (FractionRing R)).comp (e.symm : S →+* R) =
        (eF.symm : FractionRing S →+* FractionRing R).comp (algebraMap S (FractionRing S)) := by
      ext s
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H2 s).symm
    have I1 : ∀ x : FractionRing R, _root_.IsIntegral R x → _root_.IsIntegral S (eF x) :=
      fun x hx => hx.map_of_comp_eq (e : R →+* S) (eF : FractionRing R →+* FractionRing S) C1
    have I2 : ∀ y : FractionRing S, _root_.IsIntegral S y → _root_.IsIntegral R (eF.symm y) :=
      fun y hy => hy.map_of_comp_eq (e.symm : S →+* R)
        (eF.symm : FractionRing S →+* FractionRing R) C2
    let eI : ↥(integralClosure R (FractionRing R)) ≃+* ↥(integralClosure S (FractionRing S)) :=
      { toFun := fun x => ⟨eF x, I1 x x.2⟩
        invFun := fun y => ⟨eF.symm y, I2 y y.2⟩
        left_inv := fun x => Subtype.ext (eF.symm_apply_apply x)
        right_inv := fun y => Subtype.ext (eF.apply_symm_apply y)
        map_mul' := fun x y => Subtype.ext (map_mul eF (x : FractionRing R) y)
        map_add' := fun x y => Subtype.ext (map_add eF (x : FractionRing R) y) }
    have heI : ∀ r : R, eI (algebraMap R _ r) = algebraMap S _ (e r) :=
      fun r => Subtype.ext (H1 r)
    have heI' : ∀ s : S, eI.symm (algebraMap S _ s) = algebraMap R _ (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, heI, RingEquiv.apply_symm_apply]
    constructor
    · letI : RingHomInvPair (e : R →+* S) (e.symm : S →+* R) := RingHomInvPair.of_ringEquiv e
      letI : RingHomInvPair (e.symm : S →+* R) (e : R →+* S) := RingHomInvPair.symm _ _
      let LeI : ↥(integralClosure R (FractionRing R)) →ₛₗ[(e : R →+* S)]
          ↥(integralClosure S (FractionRing S)) :=
        { toFun := eI
          map_add' := map_add eI
          map_smul' := fun r a => by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI]
            rfl }
      let LeI' : ↥(integralClosure S (FractionRing S)) →ₛₗ[(e.symm : S →+* R)]
          ↥(integralClosure R (FractionRing R)) :=
        { toFun := eI.symm
          map_add' := map_add eI.symm
          map_smul' := fun s b => by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI']
            rfl }
      let p := LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))
      let q := LinearMap.range (Algebra.linearMap S ↥(integralClosure S (FractionRing S)))
      have h1 : p ≤ q.comap LeI := by
        rintro _ ⟨r, rfl⟩
        exact ⟨e r, (heI r).symm⟩
      have h2 : q ≤ p.comap LeI' := by
        rintro _ ⟨s, rfl⟩
        exact ⟨e.symm s, (heI' s).symm⟩
      let Φ := p.mapQ q LeI h1
      let Φ' := q.mapQ p LeI' h2
      let Φe : (↥(integralClosure R (FractionRing R)) ⧸ p) ≃ₛₗ[(e : R →+* S)]
          (↥(integralClosure S (FractionRing S)) ⧸ q) :=
        { Φ with
          invFun := Φ'
          left_inv := fun x => by
            induction x using Submodule.Quotient.induction_on with
            | H a =>
              show Φ' (Φ (Submodule.Quotient.mk a)) = Submodule.Quotient.mk a
              rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
              exact congrArg _ (eI.symm_apply_apply a)
          right_inv := fun x => by
            induction x using Submodule.Quotient.induction_on with
            | H b =>
              show Φ (Φ' (Submodule.Quotient.mk b)) = Submodule.Quotient.mk b
              rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
              exact congrArg _ (eI.apply_symm_apply b) }
      let O := Submodule.orderIsoMapComap Φe
      unfold wcpaDjLkDelta
      rw [Module.length_eq_height, Module.length_eq_height, ← Order.height_orderIso O ⊤,
        OrderIso.map_top]
    · unfold wcpaDjLkBranches
      apply ENat.card_congr
      exact
        { toFun := fun M => ⟨M.asIdeal.comap (eI.symm : _ →+* _), by
            haveI := M.isMaximal
            exact Ideal.comap_isMaximal_of_surjective _ eI.symm.surjective⟩
          invFun := fun N => ⟨N.asIdeal.comap (eI : _ →+* _), by
            haveI := N.isMaximal
            exact Ideal.comap_isMaximal_of_surjective _ eI.surjective⟩
          left_inv := fun M => by
            ext x
            show eI.symm (eI x) ∈ M.asIdeal ↔ x ∈ M.asIdeal
            rw [RingEquiv.symm_apply_apply]
          right_inv := fun N => by
            ext x
            show eI (eI.symm x) ∈ N.asIdeal ↔ x ∈ N.asIdeal
            rw [RingEquiv.apply_symm_apply] }

  have s7 : ∀ (wL : ↥W →+* L) (R R' : Type u) [CommRing R]
      [CommRing R'] [Algebra R L] [Algebra R' L]
      (Q : Ideal ↥(integralClosure R L)) [Q.IsPrime]
      (Q' : Ideal ↥(integralClosure R' L)) [Q'.IsPrime]
      (e : Localization.AtPrime Q ≃+* Localization.AtPrime Q'),
      (∀ (x : ↥(integralClosure R L)) (y : ↥(integralClosure R' L)), (x : L) = (y : L) →
        e (algebraMap _ _ x) = algebraMap _ _ y) →
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W,
        wL w ∈ integralClosure R L ∧ wL w ∈ integralClosure R' L) →
      (wcpaDjLkBad (wcLlsFS W wL R Q) ↔ wcpaDjLkBad (wcLlsFS W wL R' Q')) := by
    intro wL R R' _ _ _ _ Q _ Q' _ e he hw
    have hI : Ideal.map (e : Localization.AtPrime Q →+* Localization.AtPrime Q')
        ((Ideal.span {b : ↥(integralClosure R L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w}).map
            (algebraMap ↥(integralClosure R L) (Localization.AtPrime Q))) =
        (Ideal.span {b : ↥(integralClosure R' L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w}).map
            (algebraMap ↥(integralClosure R' L) (Localization.AtPrime Q')) := by
      rw [Ideal.map_map, Ideal.map_span, Ideal.map_span]
      congr 1
      ext z
      constructor
      · rintro ⟨b, ⟨w, hw', hb⟩, rfl⟩
        exact ⟨⟨wL w, (hw w hw').2⟩, ⟨w, hw', rfl⟩, (he b ⟨wL w, (hw w hw').2⟩ hb).symm⟩
      · rintro ⟨b', ⟨w, hw', hb'⟩, rfl⟩
        exact ⟨⟨wL w, (hw w hw').1⟩, ⟨w, hw', rfl⟩, he ⟨wL w, (hw w hw').1⟩ b' hb'.symm⟩
    have eq : wcLlsFS W wL R Q ≃+* wcLlsFS W wL R' Q' := Ideal.quotientEquiv _ _ e hI.symm
    obtain ⟨h1, h2⟩ := hllfi _ _ eq
    unfold wcpaDjLkBad
    rw [h1, h2]

  have T : ∀ (wL : ↥W →+* L) (R : Subalgebra A K) (R₃ : Subalgebra A₃ K)
      (hRR : ∀ x ∈ R, x ∈ R₃) (N : Ideal ↥R) (N₃ : Ideal ↥R₃),
      (∀ J : Ideal ↥R, N ≤ J → J ≠ ⊤ → J = N) →
      (∀ J : Ideal ↥R₃, N₃ ≤ J → J ≠ ⊤ → J = N₃) →
      (∀ r : ↥R, r ∈ N → (⟨r.1, hRR r.1 r.2⟩ : ↥R₃) ∈ N₃) →
      (∀ J : Ideal ↥R₃, (∀ r : ↥R, r ∈ N → (⟨r.1, hRR r.1 r.2⟩ : ↥R₃) ∈ J) → N₃ ≤ J) →
      (N.IsPrime → ∀ r₃ ∈ R₃, ∃ r : ↥R, r ∉ N ∧ (r : K) * r₃ ∈ R) →
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W, ∃ k ∈ R, wL w = algebraMap K L k) →
      ((∀ (Q₃ : Ideal ↥(integralClosure ↥R₃ L)) [Q₃.IsPrime],
          Q₃.comap (algebraMap ↥R₃ ↥(integralClosure ↥R₃ L)) = N₃ →
          ¬ wcpaDjLkBad (wcLlsFS W wL ↥R₃ Q₃)) ↔
        (∀ (Q : Ideal ↥(integralClosure ↥R L)) [Q.IsPrime],
          Q.comap (algebraMap ↥R ↥(integralClosure ↥R L)) = N →
          ¬ wcpaDjLkBad (wcLlsFS W wL ↥R Q))) := by
    intro wL R R₃ hRR N N₃ hmaxN hmaxN₃ hc1 hc2 hden hwL
    have hint : ∀ x : L, IsIntegral ↥R x → IsIntegral ↥R₃ x := by
      intro x hx
      obtain ⟨k, hk, hk'⟩ := s4 A₃ A R₃ R ⊥
        (fun k hk => by rw [Submonoid.mem_bot] at hk; rw [hk]; exact one_mem _)
        (fun r hr => ⟨1, Submonoid.one_mem _, by rw [one_mul]; exact hRR r hr⟩) x hx
      rw [Submonoid.mem_bot] at hk
      rw [hk, map_one, one_mul] at hk'
      exact hk'
    let j : ↥(integralClosure ↥R L) →+* ↥(integralClosure ↥R₃ L) :=
      { toFun := fun x => ⟨x.1, hint x.1 x.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let i : ↥(integralClosure ↥R L) →+* L := (integralClosure ↥R L).val.toRingHom
    let i₃ : ↥(integralClosure ↥R₃ L) →+* L := (integralClosure ↥R₃ L).val.toRingHom
    have hi : Function.Injective i := Subtype.val_injective
    have hi₃ : Function.Injective i₃ := Subtype.val_injective
    have hij : i₃.comp j = i := RingHom.ext fun _ => rfl
    have hjalg : ∀ r : ↥R, j (algebraMap ↥R _ r) = algebraMap ↥R₃ _ ⟨r.1, hRR r.1 r.2⟩ :=
      fun r => Subtype.ext rfl
    have hwint : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
        wL w ∈ integralClosure ↥R L ∧ wL w ∈ integralClosure ↥R₃ L := by
      intro w hw
      obtain ⟨k, hk, hkw⟩ := hwL w hw
      rw [hkw]
      exact ⟨Subalgebra.algebraMap_mem (integralClosure ↥R L) (⟨k, hk⟩ : ↥R),
