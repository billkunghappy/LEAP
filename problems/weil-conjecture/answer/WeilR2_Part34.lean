      (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) →
      (∃ (a : K) (d' : A), d' ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d' a ∧ b = a * s) ∨
      ∃ (a z : K) (π : ↥W) (d' : A), d' ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d' a ∧ wcLlsKPLoc A K 0 d' z ∧
