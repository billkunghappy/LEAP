by
  intro Ω _ _ W _ _ ℓ hℓ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hfr θ a c hc ha hθ hy hyc
  classical
  haveI h𝔭p : 𝔭.IsPrime := hPD.2.2.2.1.isPrime
  haveI := hy
  obtain ⟨-, htf, hAic, -, hm𝔭, ht𝔭, -, -⟩ := id hPD
  haveI := hAic

  haveI : IsDomain (Localization.AtPrime 𝔭) := IsLocalization.isDomain_of_atPrime _ 𝔭
  haveI : IsIntegrallyClosed (Localization.AtPrime 𝔭) :=
    isIntegrallyClosed_of_isLocalization _ 𝔭.primeCompl (Ideal.primeCompl_le_nonZeroDivisors 𝔭)
  set I : Ideal (Localization.AtPrime 𝔭) := ((IsLocalRing.maximalIdeal ↥W).map
    (algebraMap ↥W A)).map (algebraMap A (Localization.AtPrime 𝔭)) with hI
  set g : A := (t - algebraMap ↥W A c) * a with hg

  obtain ⟨hR₀dom, hR₀dvr, htirr⟩ := wcpa_dj_llsm_kpde_fibre_dvr Ω W A 𝔭 t hPD
  haveI := hR₀dom
  haveI := hR₀dvr
  have haS : IsUnit (algebraMap A (Localization.AtPrime 𝔭) a) :=
    (IsLocalization.AtPrime.isUnit_to_map_iff _ 𝔭 a).mpr ha
  have haR : IsUnit (Ideal.Quotient.mk I (algebraMap A (Localization.AtPrime 𝔭) a)) :=
    haS.map _
  have hcR : Ideal.Quotient.mk I (algebraMap A (Localization.AtPrime 𝔭) (algebraMap ↥W A c)) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hc))
  have hgR : Ideal.Quotient.mk I (algebraMap A (Localization.AtPrime 𝔭) g) =
      Ideal.Quotient.mk I (algebraMap A (Localization.AtPrime 𝔭) t) *
        Ideal.Quotient.mk I (algebraMap A (Localization.AtPrime 𝔭) a) := by
    rw [hg, map_mul, map_sub, map_mul, map_sub, hcR, sub_zero]
  have hgirr : Irreducible (Ideal.Quotient.mk I (algebraMap A (Localization.AtPrime 𝔭) g)) := by
    rw [hgR]
    exact (irreducible_mul_isUnit haR).mpr htirr

  have hℓκ : ((ℓ : ℕ) : IsLocalRing.ResidueField W) ≠ 0 := by
    intro h0
    have hdvd := ringChar.dvd h0
    rcases hℓ.eq_one_or_self_of_dvd _ hdvd with h1 | h1
    · exact CharP.ringChar_ne_one h1
    · exact hκ h1
  have hℓW : IsUnit ((ℓ : ℕ) : W) := by
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit, map_natCast]
    exact hℓκ
  have hℓS : IsUnit ((ℓ : ℕ) : Localization.AtPrime 𝔭) := by
    have := hℓW.map ((algebraMap A (Localization.AtPrime 𝔭)).comp (algebraMap ↥W A))
    rwa [map_natCast] at this
  have hℓΩ : ((ℓ : ℕ) : Ω) ≠ 0 := by
    have := hℓW.map W.subtype
    rw [map_natCast] at this
