    have TP : ∀ (a : A) (n : ℕ), a ∉ 𝔭 → a ^ n ∉ 𝔭 := fun a n ha h =>
      ha (hPrime.mem_of_pow_mem n h)
    have NM1 : ∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' 1 := by
      rintro d'' hd'' ⟨π, hπ, x', hx', h1⟩
      obtain ⟨n, c, hc⟩ := (T0 d'' x').mp hx'
      have hπ𝔭 : algebraMap ↥W A π ∈ 𝔭 := hm𝔭 (Ideal.mem_map_of_mem _ hπ)
      have e : algebraMap A K (algebraMap ↥W A π * c) = algebraMap A K (d'' ^ n) := by
        rw [map_mul, hc, map_pow]
        linear_combination (-(algebraMap A K d'' ^ n)) * h1
      have e2 := IsFractionRing.injective A K e
      exact TP d'' n hd'' (e2 ▸ 𝔭.mul_mem_right _ hπ𝔭)
    have Tone : wcLlsKPLoc A K 0 d₁ 1 := (T0 _ _).mpr ⟨0, 1, by rw [map_one, pow_zero, one_mul]⟩
    have Tzero : wcLlsKPLoc A K 0 d₁ 0 :=
      (T0 _ _).mpr ⟨0, 0, by rw [map_zero, pow_zero, one_mul]⟩
    refine ⟨1, ⟨d₁, 1, 1, hd₁, Tone, Tone, NM1, mul_one 1⟩,
      ⟨0, 0, (IsLocalRing.maximalIdeal ↥W).zero_mem,
        ⟨d₁, 0, 1, hd₁, Tzero, Tone, NM1, mul_one 0⟩, by simp⟩,
      0, ⟨d₁, 0, 1, hd₁, Tzero, Tone, NM1, mul_one 0⟩, by rw [hf1]; simp⟩
  ·
    exact wcLlsKP_bcBf_normal_form Ω W hW hWt A K 𝔭 t hPD ℓ hℓ hΩ hκ HC HP
      (wcLlsKP_bcBf_valring Ω W hW hWt A K 𝔭 t hPD ℓ hℓ hκ hℓK)
      (wcLlsKP_bcBf_layered_basis Ω W hW hWt A K 𝔭 t hPD ℓ hℓ hΩ hκ hℓK)
      hℓK f₁ r d₁ hd₁ hLr hfr β hβ

theorem wcLlsKP_bcB_transfer : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    (∀ (x : K) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d x → x ≠ 0 →
      ∃ (π : ↥W) (x' : K) (d' : A), π ≠ 0 ∧ d' ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d' x' ∧
        x = algebraMap A K (algebraMap ↥W A π) * x' ∧
        ∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' x') →
    (∀ (x y : K) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d y →
      (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' x) →
      (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' y) →
      ∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' (x * y)) →
    (∀ (n : ℕ) (b s g : K) (d : A), 1 ≤ n → d ∉ 𝔭 → wcLlsKPLoc A K 0 d b →
      wcLlsKPLoc A K 0 d s → wcLlsKPLoc A K 0 d g →
      (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) →
      (∃ d' : A, d' ∉ 𝔭 ∧ wcLlsKPMLoc W A K 0 d' (g * s ^ n - b ^ n)) →
      ∃ (r : K) (d' : A), d' ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d' r ∧
        wcLlsKPMLoc W A K 0 d' (b - r * s)) →
    (∀ (b s : K) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d b → wcLlsKPLoc A K 0 d s →
      (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) →
      (∃ (a : K) (d' : A), d' ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d' a ∧ b = a * s) ∨
      ∃ (a z : K) (π : ↥W) (d' : A), d' ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d' a ∧ wcLlsKPLoc A K 0 d' z ∧
        π ≠ 0 ∧ b - a * s = algebraMap A K (algebraMap ↥W A π) * z ∧
        ∀ (a' z' : K) (π' : ↥W) (d'' : A), d'' ∉ 𝔭 → wcLlsKPLoc A K 0 d'' a' →
          wcLlsKPLoc A K 0 d'' z' → b - a' * s = algebraMap A K (algebraMap ↥W A π') * z' →
          π' ∣ π) →
    ∀ (f₁ : K) (d₁ : A), d₁ ∉ 𝔭 → wcLlsKPLoc A K 0 d₁ f₁ →
    ∀ (h : K) (γ β : ↥W), β ^ (ℓ - 1) = ((ℓ : ℕ) : ↥W) → γ ≠ 0 →
      γ ∈ IsLocalRing.maximalIdeal ↥W → γ ∣ β →
      (∃ (d : A) (b s : K), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d b ∧ wcLlsKPLoc A K 0 d s ∧
        (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) ∧ h * s = b) →
      (∃ (π : ↥W) (y' : K), π ∈ IsLocalRing.maximalIdeal ↥W ∧
        (∃ (d : A) (b s : K), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d b ∧ wcLlsKPLoc A K 0 d s ∧
          (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) ∧ y' * s = b) ∧
        h - 1 = algebraMap A K (algebraMap ↥W A π) * y') →
      (∃ y : K,
        (∃ (d : A) (b s : K), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d b ∧ wcLlsKPLoc A K 0 d s ∧
          (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) ∧ y * s = b) ∧
        f₁ - h ^ ℓ = algebraMap A K (algebraMap ↥W A γ) ^ ℓ * y) →
      ∃ (a q : K) (d : A), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d a ∧ wcLlsKPLoc A K 0 d q ∧
        f₁ - a ^ ℓ = algebraMap A K (algebraMap ↥W A γ) ^ ℓ * q ∧
        ∃ (π : ↥W) (z : K), π ∈ IsLocalRing.maximalIdeal ↥W ∧ wcLlsKPLoc A K 0 d z ∧
          a - 1 = algebraMap A K (algebraMap ↥W A π) * z :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 t hPD ℓ hℓ hκ HC HP HN HL f₁ d₁ hd₁ hLf h γ β hβ hγ0
    hγm hγβ hOkh hOM hy

  have T0 : ∀ (d : A) (x : K), wcLlsKPLoc A K 0 d x ↔
      ∃ (n : ℕ) (a : A), algebraMap A K a = algebraMap A K d ^ n * x := by
    intro d x
    have hbot : Algebra.adjoin A ({0} : Set K) = ⊥ := by
      apply le_antisymm
      · rw [Algebra.adjoin_le_iff]
        intro z hz
        rw [Set.mem_singleton_iff.mp hz]
        exact Subalgebra.zero_mem _
      · exact bot_le
    unfold wcLlsKPLoc
    rw [hbot]
    constructor
    · rintro ⟨n, hn⟩
      obtain ⟨a, ha⟩ := Algebra.mem_bot.mp hn
      exact ⟨n, a, ha⟩
    · rintro ⟨n, a, ha⟩
      exact ⟨n, Algebra.mem_bot.mpr ⟨a, ha⟩⟩
  have T3 : ∀ (d e : A) (x : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 (e * d) x := by
    intro d e x hx
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    refine (T0 _ _).mpr ⟨n, e ^ n * a, ?_⟩
    simp only [map_mul, map_pow, ha]
    ring
  have TD : ∀ (d e : A) (x : K), wcLlsKPLoc A K 0 d x → d ∣ e → wcLlsKPLoc A K 0 e x := by
    intro d e x hx hde
    obtain ⟨c, rfl⟩ := hde
    have := T3 d c x hx
    rwa [mul_comm] at this
  have TMul : ∀ (d : A) (x y : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d y →
      wcLlsKPLoc A K 0 d (x * y) := by
    intro d x y hx hy
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    obtain ⟨n', a', ha'⟩ := (T0 d y).mp hy
    refine (T0 _ _).mpr ⟨n + n', a * a', ?_⟩
    simp only [map_mul, ha, ha']
    ring
  have TA : ∀ (d : A) (x y : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d y →
      wcLlsKPLoc A K 0 d (x + y) := by
    intro d x y hx hy
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    obtain ⟨n', a', ha'⟩ := (T0 d y).mp hy
    refine (T0 _ _).mpr ⟨n + n', a * d ^ n' + a' * d ^ n, ?_⟩
    simp only [map_add, map_mul, map_pow, ha, ha']
    ring
  have TNeg : ∀ (d : A) (x : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d (-x) := by
    intro d x hx
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    refine (T0 _ _).mpr ⟨n, -a, ?_⟩
    rw [map_neg, ha]
    ring
  have TSub : ∀ (d : A) (x y : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d y →
      wcLlsKPLoc A K 0 d (x - y) := by
    intro d x y hx hy
    rw [sub_eq_add_neg]
    exact TA _ _ _ hx (TNeg _ _ hy)
  have TC : ∀ (d a : A), wcLlsKPLoc A K 0 d (algebraMap A K a) := by
    intro d a
    exact (T0 _ _).mpr ⟨0, a, by rw [pow_zero, one_mul]⟩
  have Tone : ∀ d : A, wcLlsKPLoc A K 0 d 1 := by
    intro d
    have := TC d 1
    rwa [map_one] at this
  have Tzero : ∀ d : A, wcLlsKPLoc A K 0 d 0 := by
    intro d
    have := TC d 0
    rwa [map_zero] at this
  have TPow : ∀ (d : A) (x : K) (m : ℕ), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d (x ^ m) := by
    intro d x m hx
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    refine (T0 _ _).mpr ⟨n * m, a ^ m, ?_⟩
    rw [map_pow, ha, mul_pow, ← pow_mul]
  have hPrime : 𝔭.IsPrime := hPD.2.2.2.1.isPrime
  have T5 : ∀ a b : A, a ∉ 𝔭 → b ∉ 𝔭 → a * b ∉ 𝔭 := fun a b ha hb hab =>
    (hPrime.mem_or_mem hab).elim ha hb
  have TP : ∀ (a : A) (n : ℕ), a ∉ 𝔭 → a ^ n ∉ 𝔭 := fun a n ha h =>
    ha (hPrime.mem_of_pow_mem n h)
  have hm𝔭 : Ideal.map (algebraMap ↥W A) (IsLocalRing.maximalIdeal ↥W) ≤ 𝔭 := hPD.2.2.2.2.1
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h1 => hPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  have NM1 : ∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' 1 := by
    rintro d'' hd'' ⟨π, hπ, x', hx', h1⟩
    obtain ⟨n, c, hc⟩ := (T0 d'' x').mp hx'
    have hπ𝔭 : algebraMap ↥W A π ∈ 𝔭 := hm𝔭 (Ideal.mem_map_of_mem _ hπ)
    have e : algebraMap A K (algebraMap ↥W A π * c) = algebraMap A K (d'' ^ n) := by
      rw [map_mul, hc, map_pow]
      linear_combination (-(algebraMap A K d'' ^ n)) * h1
    have e2 := IsFractionRing.injective A K e
    exact TP d'' n hd'' (e2 ▸ 𝔭.mul_mem_right _ hπ𝔭)
  have NMne : ∀ s : K, (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) → s ≠ 0 := by
    intro s hs h0
    apply hs 1 h1𝔭
    exact ⟨0, Ideal.zero_mem _, 0, Tzero 1, by rw [h0, mul_zero]⟩

  have hNZ : NoZeroSMulDivisors ↥W A := hPD.2.1
  have wKne : ∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0 := by
    intro w hw h0
    have h1 : algebraMap ↥W A w = 0 :=
      IsFractionRing.injective A K (h0.trans (map_zero _).symm)
    rw [Algebra.algebraMap_eq_smul_one] at h1
    rcases smul_eq_zero.mp h1 with h2 | h2
    · exact hw h2
    · exact one_ne_zero h2

  obtain ⟨OK, hOK⟩ : ∃ OK : K → Prop, ∀ y : K, OK y ↔
      ∃ (d : A) (b s : K), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d b ∧ wcLlsKPLoc A K 0 d s ∧
        (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) ∧ y * s = b :=
    ⟨_, fun _ => Iff.rfl⟩
  have OkL : ∀ (d : A) (x : K), d ∉ 𝔭 → wcLlsKPLoc A K 0 d x → OK x := fun d x hd hx =>
    (hOK x).mpr ⟨d, x, 1, hd, hx, Tone d, NM1, mul_one x⟩
  have OkA : ∀ x y : K, OK x → OK y → OK (x + y) := by
    intro x y hx hy
    obtain ⟨c₁, b₁, s₁, hc₁, hb₁, hs₁, hn₁, e₁⟩ := (hOK x).mp hx
    obtain ⟨c₂, b₂, s₂, hc₂, hb₂, hs₂, hn₂, e₂⟩ := (hOK y).mp hy
    refine (hOK _).mpr ⟨c₁ * c₂, b₁ * s₂ + b₂ * s₁, s₁ * s₂, T5 _ _ hc₁ hc₂, ?_, ?_, ?_, ?_⟩
    · exact TA _ _ _ (TMul _ _ _ (TD _ _ _ hb₁ ⟨c₂, rfl⟩) (T3 _ _ _ hs₂))
        (TMul _ _ _ (T3 _ _ _ hb₂) (TD _ _ _ hs₁ ⟨c₂, rfl⟩))
    · exact TMul _ _ _ (TD _ _ _ hs₁ ⟨c₂, rfl⟩) (T3 _ _ _ hs₂)
    · exact HP s₁ s₂ (c₁ * c₂) (T5 _ _ hc₁ hc₂) (TD _ _ _ hs₁ ⟨c₂, rfl⟩) (T3 _ _ _ hs₂) hn₁ hn₂
    · linear_combination s₂ * e₁ + s₁ * e₂
  have OkM : ∀ x y : K, OK x → OK y → OK (x * y) := by
    intro x y hx hy
    obtain ⟨c₁, b₁, s₁, hc₁, hb₁, hs₁, hn₁, e₁⟩ := (hOK x).mp hx
    obtain ⟨c₂, b₂, s₂, hc₂, hb₂, hs₂, hn₂, e₂⟩ := (hOK y).mp hy
    refine (hOK _).mpr ⟨c₁ * c₂, b₁ * b₂, s₁ * s₂, T5 _ _ hc₁ hc₂, ?_, ?_, ?_, ?_⟩
    · exact TMul _ _ _ (TD _ _ _ hb₁ ⟨c₂, rfl⟩) (T3 _ _ _ hb₂)
    · exact TMul _ _ _ (TD _ _ _ hs₁ ⟨c₂, rfl⟩) (T3 _ _ _ hs₂)
    · exact HP s₁ s₂ (c₁ * c₂) (T5 _ _ hc₁ hc₂) (TD _ _ _ hs₁ ⟨c₂, rfl⟩) (T3 _ _ _ hs₂) hn₁ hn₂
    · linear_combination (y * s₂) * e₁ + b₁ * e₂
  have OkN : ∀ x : K, OK x → OK (-x) := by
    intro x hx
    obtain ⟨c₁, b₁, s₁, hc₁, hb₁, hs₁, hn₁, e₁⟩ := (hOK x).mp hx
    exact (hOK _).mpr ⟨c₁, -b₁, s₁, hc₁, TNeg _ _ hb₁, hs₁, hn₁, by linear_combination -e₁⟩
  have OkS : ∀ x y : K, OK x → OK y → OK (x - y) := fun x y hx hy => by
    rw [sub_eq_add_neg]; exact OkA _ _ hx (OkN _ hy)
  have Ok0 : OK 0 := OkL 1 0 h1𝔭 (Tzero 1)
  have OkP : ∀ (x : K) (n : ℕ), OK x → OK (x ^ n) := by
    intro x n hx
    induction n with
    | zero => rw [pow_zero]; exact OkL 1 1 h1𝔭 (Tone 1)
    | succ n ih => rw [pow_succ]; exact OkM _ _ ih hx
  have OkC : ∀ w : ↥W, OK (algebraMap A K (algebraMap ↥W A w)) := fun w =>
    OkL 1 _ h1𝔭 (TC 1 _)
  have OkNat : ∀ n : ℕ, OK ((n : ℕ) : K) := fun n => by
    have := TC 1 (n : A)
    rw [map_natCast] at this
    exact OkL 1 _ h1𝔭 this

  have DIV : ∀ (x y : K) (π : ↥W) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d x → π ≠ 0 → OK y →
      x = algebraMap A K (algebraMap ↥W A π) * y →
      ∃ d' : A, d' ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d' y := by
    intro x y π d hd hx hπ hy hxy
    obtain ⟨d₀, b, s, hd₀, hb, hs, hns, hys⟩ := (hOK y).mp hy
    by_cases hx0 : x = 0
    · refine ⟨d, hd, ?_⟩
      have hy0 : y = 0 := by
        rw [hx0] at hxy
        exact (mul_eq_zero.mp hxy.symm).resolve_left (wKne π hπ)
      rw [hy0]; exact Tzero d
    obtain ⟨πx, x', dx, hπx, hdx, hx', hxx', hnx'⟩ := HC x d hd hx hx0
    have key : (∃ c, πx = π * c) ∨ ∃ c, c ∈ IsLocalRing.maximalIdeal ↥W ∧ π = πx * c := by
      rcases ValuationRing.dvd_total π πx with ⟨c, hc⟩ | ⟨c, hc⟩
      · exact Or.inl ⟨c, hc⟩
      · by_cases hcm : c ∈ IsLocalRing.maximalIdeal ↥W
        · exact Or.inr ⟨c, hcm, hc⟩
        · left
          have hu : IsUnit c := by
            by_contra h'
            exact hcm ((IsLocalRing.mem_maximalIdeal c).mpr h')
          exact ⟨((hu.unit⁻¹ : (↥W)ˣ) : ↥W), by rw [hc, mul_assoc, hu.mul_val_inv, mul_one]⟩
    rcases key with ⟨c, hc⟩ | ⟨c, hcm, hc⟩
    · refine ⟨dx, hdx, ?_⟩
      have hpx : algebraMap A K (algebraMap ↥W A πx) =
          algebraMap A K (algebraMap ↥W A π) * algebraMap A K (algebraMap ↥W A c) := by
        rw [hc, map_mul, map_mul]
      have e : algebraMap A K (algebraMap ↥W A π) *
          (y - algebraMap A K (algebraMap ↥W A c) * x') = 0 := by
        linear_combination -hxy + hxx' + x' * hpx
      have hy' : y = algebraMap A K (algebraMap ↥W A c) * x' :=
        sub_eq_zero.mp ((mul_eq_zero.mp e).resolve_left (wKne π hπ))
      rw [hy']
      exact TMul _ _ _ (TC _ _) hx'
    · exfalso
      have hpx : algebraMap A K (algebraMap ↥W A π) =
          algebraMap A K (algebraMap ↥W A πx) * algebraMap A K (algebraMap ↥W A c) := by
        rw [hc, map_mul, map_mul]
      have e : algebraMap A K (algebraMap ↥W A πx) *
          (x' - algebraMap A K (algebraMap ↥W A c) * y) = 0 := by
        linear_combination hxy - hxx' + y * hpx
      have hx'e : x' = algebraMap A K (algebraMap ↥W A c) * y :=
        sub_eq_zero.mp ((mul_eq_zero.mp e).resolve_left (wKne πx hπx))
      apply HP x' s (dx * d₀) (T5 _ _ hdx hd₀) (TD _ _ _ hx' ⟨d₀, rfl⟩) (T3 _ _ _ hs) hnx' hns
        d₀ hd₀
      exact ⟨c, hcm, b, hb, by rw [hx'e, mul_assoc, hys]⟩

  have BIN : ∀ (a x P c : K), OK a → OK x → OK P → (ℓ : K) = P ^ (ℓ - 1) * c →
      ∃ S : K, OK S ∧ (a + P * x) ^ ℓ = a ^ ℓ + P ^ ℓ * (x ^ ℓ + c * a * x * S) := by
    intro a x P c ha hx hP hc
    refine ⟨∑ k ∈ Finset.Ioo 0 ℓ, a ^ (k - 1) * (P * x) ^ (ℓ - k - 1) *
      ((ℓ.choose k / ℓ : ℕ) : K), ?_, ?_⟩
    · apply Finset.sum_induction _ OK OkA Ok0
      intro k _
      exact OkM _ _ (OkM _ _ (OkP _ _ ha) (OkP _ _ (OkM _ _ hP hx))) (OkNat _)
    · have e1 := add_pow_prime_eq hℓ a (P * x)
      have hpow := pow_sub_one_mul hℓ.ne_zero P
      linear_combination e1 + (a * P * x * ∑ k ∈ Finset.Ioo 0 ℓ, a ^ (k - 1) *
        (P * x) ^ (ℓ - k - 1) * ((ℓ.choose k / ℓ : ℕ) : K)) * hc +
        (c * a * x * ∑ k ∈ Finset.Ioo 0 ℓ, a ^ (k - 1) * (P * x) ^ (ℓ - k - 1) *
          ((ℓ.choose k / ℓ : ℕ) : K)) * hpow

  obtain ⟨dh, bh, sh, hdh, hbh, hsh, hnsh, hhs⟩ := hOkh
  obtain ⟨πh, y', hπh, hy'ok, hhy'⟩ := hOM
  obtain ⟨y, hyok, hfy⟩ := hy
  have hy'OK : OK y' := (hOK y').mpr hy'ok
  have hyOK : OK y := (hOK y).mpr hyok
  have hsh0 : sh ≠ 0 := NMne sh hnsh
  obtain ⟨ρ', hρ'⟩ := hγβ
  have hℓK : (ℓ : K) = algebraMap A K (algebraMap ↥W A γ) ^ (ℓ - 1) *
      algebraMap A K (algebraMap ↥W A ρ') ^ (ℓ - 1) := by
    have h1 : ((ℓ : ℕ) : ↥W) = γ ^ (ℓ - 1) * ρ' ^ (ℓ - 1) := by rw [← hβ, hρ', mul_pow]
    have := congrArg (fun w : ↥W => algebraMap A K (algebraMap ↥W A w)) h1
    simpa only [map_natCast, map_mul, map_pow] using this

  have CASEA : ∀ (a₀ δ : K) (d₀ : A), d₀ ∉ 𝔭 → wcLlsKPLoc A K 0 d₀ a₀ → OK δ →
      h = a₀ + algebraMap A K (algebraMap ↥W A γ) * δ →
      ∃ (a q : K) (d : A), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d a ∧ wcLlsKPLoc A K 0 d q ∧
        f₁ - a ^ ℓ = algebraMap A K (algebraMap ↥W A γ) ^ ℓ * q ∧
        ∃ (π : ↥W) (z : K), π ∈ IsLocalRing.maximalIdeal ↥W ∧ wcLlsKPLoc A K 0 d z ∧
          a - 1 = algebraMap A K (algebraMap ↥W A π) * z := by
    intro a₀ δ d₀ hd₀ ha₀ hδ hh
    subst hh
    have ha₀OK : OK a₀ := OkL _ _ hd₀ ha₀
    obtain ⟨S, hS, hbin⟩ := BIN a₀ δ (algebraMap A K (algebraMap ↥W A γ))
      (algebraMap A K (algebraMap ↥W A ρ') ^ (ℓ - 1)) ha₀OK hδ (OkC γ) hℓK
    obtain ⟨Q, hQdef⟩ : ∃ Q : K, Q = y + δ ^ ℓ +
        algebraMap A K (algebraMap ↥W A ρ') ^ (ℓ - 1) * a₀ * δ * S := ⟨_, rfl⟩
    have hQ : f₁ - a₀ ^ ℓ = algebraMap A K (algebraMap ↥W A γ) ^ ℓ * Q := by
      rw [hbin] at hfy
      rw [hQdef]
      linear_combination hfy
    have hQOK : OK Q := by
      rw [hQdef]
      exact OkA _ _ (OkA _ _ hyOK (OkP _ _ hδ))
        (OkM _ _ (OkM _ _ (OkM _ _ (OkP _ _ (OkC ρ')) ha₀OK) hδ) hS)
    obtain ⟨dq, hdq, hLQ⟩ := DIV (f₁ - a₀ ^ ℓ) Q (γ ^ ℓ) (d₁ * d₀) (T5 _ _ hd₁ hd₀)
      (TSub _ _ _ (TD _ _ _ hLf ⟨d₀, rfl⟩) (TPow _ _ _ (T3 _ _ _ ha₀))) (pow_ne_zero _ hγ0) hQOK
      (by simp only [map_pow]; exact hQ)
    obtain ⟨π'', Y, hπ''m, hYok, hYeq⟩ : ∃ (π'' : ↥W) (Y : K),
        π'' ∈ IsLocalRing.maximalIdeal ↥W ∧ OK Y ∧
        a₀ - 1 = algebraMap A K (algebraMap ↥W A π'') * Y := by
      rcases ValuationRing.dvd_total πh γ with ⟨c₁, hc₁⟩ | ⟨c₁, hc₁⟩
      · refine ⟨πh, y' - algebraMap A K (algebraMap ↥W A c₁) * δ, hπh,
          OkS _ _ hy'OK (OkM _ _ (OkC c₁) hδ), ?_⟩
        have hγc : algebraMap A K (algebraMap ↥W A γ) =
            algebraMap A K (algebraMap ↥W A πh) * algebraMap A K (algebraMap ↥W A c₁) := by
          rw [hc₁, map_mul, map_mul]
        linear_combination hhy' - δ * hγc
      · refine ⟨γ, algebraMap A K (algebraMap ↥W A c₁) * y' - δ, hγm,
          OkS _ _ (OkM _ _ (OkC c₁) hy'OK) hδ, ?_⟩
        have hπc : algebraMap A K (algebraMap ↥W A πh) =
            algebraMap A K (algebraMap ↥W A γ) * algebraMap A K (algebraMap ↥W A c₁) := by
          rw [hc₁, map_mul, map_mul]
        linear_combination hhy' + y' * hπc
    obtain ⟨dz, Z, hdz, hLZ, hZeq⟩ : ∃ (dz : A) (Z : K), dz ∉ 𝔭 ∧ wcLlsKPLoc A K 0 dz Z ∧
        a₀ - 1 = algebraMap A K (algebraMap ↥W A π'') * Z := by
      by_cases h0 : π'' = 0
      · refine ⟨1, 0, h1𝔭, Tzero 1, ?_⟩
        rw [hYeq, h0]
        simp
      · obtain ⟨dz, hdz, hLZ⟩ := DIV (a₀ - 1) Y π'' d₀ hd₀ (TSub _ _ _ ha₀ (Tone d₀)) h0 hYok hYeq
        exact ⟨dz, Y, hdz, hLZ, hYeq⟩
    refine ⟨a₀, Q, d₀ * dq * dz, T5 _ _ (T5 _ _ hd₀ hdq) hdz,
      TD _ _ _ ha₀ ⟨dq * dz, by ring⟩, TD _ _ _ hLQ ⟨d₀ * dz, by ring⟩, hQ,
      π'', Z, hπ''m, TD _ _ _ hLZ ⟨d₀ * dq, by ring⟩, hZeq⟩

  rcases HL bh sh dh hdh hbh hsh hnsh with ⟨a, d', hd', ha, hba⟩ |
      ⟨a₀, z, π, d', hd', ha₀, hz, hπ0, hbz, hmax⟩
  · have hha : h = a := mul_right_cancel₀ hsh0 (hhs.trans hba)
    exact CASEA a 0 d' hd' ha Ok0 (by rw [mul_zero, add_zero]; exact hha)
  · obtain ⟨w, hw⟩ : ∃ w : K, w * sh = z := ⟨z * sh⁻¹, inv_mul_cancel_right₀ hsh0 z⟩
    have hhw : h = a₀ + algebraMap A K (algebraMap ↥W A π) * w := by
      apply mul_right_cancel₀ hsh0
      linear_combination hhs + hbz - algebraMap A K (algebraMap ↥W A π) * hw
    have hwOK : OK w := (hOK w).mpr ⟨dh * d', z, sh, T5 _ _ hdh hd', T3 _ _ _ hz,
      TD _ _ _ hsh ⟨d', rfl⟩, hnsh, hw⟩
    by_cases hγπ : γ ∣ π
    · obtain ⟨μ, hμ⟩ := hγπ
      apply CASEA a₀ (algebraMap A K (algebraMap ↥W A μ) * w) d' hd' ha₀ (OkM _ _ (OkC μ) hwOK)
      rw [hhw, hμ, map_mul, map_mul]
      ring
    · exfalso
      obtain ⟨ρ, hρ⟩ : π ∣ γ := by
        rcases ValuationRing.dvd_total π γ with h1 | h1
        · exact h1
        · exact (hγπ h1).elim
      have hρ0 : ρ ≠ 0 := fun h0 => hγ0 (by rw [hρ, h0, mul_zero])
      have hρm : ρ ∈ IsLocalRing.maximalIdeal ↥W := by
        by_contra hρm
        have hu : IsUnit ρ := by
          by_contra h'
          exact hρm ((IsLocalRing.mem_maximalIdeal ρ).mpr h')
        exact hγπ ⟨((hu.unit⁻¹ : (↥W)ˣ) : ↥W), by rw [hρ, mul_assoc, hu.mul_val_inv, mul_one]⟩
      have hγK : algebraMap A K (algebraMap ↥W A γ) =
          algebraMap A K (algebraMap ↥W A π) * algebraMap A K (algebraMap ↥W A ρ) := by
        rw [hρ, map_mul, map_mul]
      have hℓK' : (ℓ : K) = algebraMap A K (algebraMap ↥W A π) ^ (ℓ - 1) *
          (algebraMap A K (algebraMap ↥W A ρ) ^ (ℓ - 1) *
            algebraMap A K (algebraMap ↥W A ρ') ^ (ℓ - 1)) := by
        rw [hℓK, hγK, mul_pow]
        ring
      have ha₀OK : OK a₀ := OkL _ _ hd' ha₀
      set P : K := algebraMap A K (algebraMap ↥W A π) with hP
      set R : K := algebraMap A K (algebraMap ↥W A ρ) with hR
      set R' : K := algebraMap A K (algebraMap ↥W A ρ') with hR'
      obtain ⟨S, hS, hbin⟩ := BIN a₀ w P (R ^ (ℓ - 1) * R' ^ (ℓ - 1)) ha₀OK hwOK (OkC π) hℓK'
      have hγℓ : algebraMap A K (algebraMap ↥W A γ) ^ ℓ = P ^ ℓ * R ^ ℓ := by
        rw [hγK, mul_pow]
      have hfy' := hfy
      rw [hhw, hbin] at hfy'
      obtain ⟨g, hgdef⟩ : ∃ g : K, g = R ^ ℓ * y + w ^ ℓ +
          R ^ (ℓ - 1) * R' ^ (ℓ - 1) * a₀ * w * S := ⟨_, rfl⟩
      have hg : f₁ - a₀ ^ ℓ = algebraMap A K (algebraMap ↥W A (π ^ ℓ)) * g := by
        rw [map_pow, map_pow, ← hP, hgdef]
        linear_combination hfy' + y * hγℓ
      have hgOK : OK g := by
        rw [hgdef]
        exact OkA _ _ (OkA _ _ (OkM _ _ (OkP _ _ (OkC ρ)) hyOK) (OkP _ _ hwOK))
          (OkM _ _ (OkM _ _ (OkM _ _ (OkM _ _ (OkP _ _ (OkC ρ)) (OkP _ _ (OkC ρ'))) ha₀OK) hwOK) hS)
      obtain ⟨dg, hdg, hLg⟩ := DIV (f₁ - a₀ ^ ℓ) g (π ^ ℓ) (d₁ * d') (T5 _ _ hd₁ hd')
        (TSub _ _ _ (TD _ _ _ hLf ⟨d', rfl⟩) (TPow _ _ _ (T3 _ _ _ ha₀))) (pow_ne_zero _ hπ0) hgOK hg
      obtain ⟨E, hEdef⟩ : ∃ E : K, E = R ^ (ℓ - 1) * y +
          R ^ (ℓ - 1 - 1) * R' ^ (ℓ - 1) * a₀ * w * S := ⟨_, rfl⟩
      have r1 : R * R ^ (ℓ - 1) = R ^ ℓ := mul_pow_sub_one hℓ.ne_zero R
      have r2 : R * R ^ (ℓ - 1 - 1) = R ^ (ℓ - 1) := mul_pow_sub_one (by have := hℓ.two_le; omega) R
      have hEid : g * sh ^ ℓ - z ^ ℓ = R * (E * sh ^ ℓ) := by
        rw [← hw, hgdef, hEdef]
        linear_combination (-(sh ^ ℓ * y)) * r1 - (sh ^ ℓ * R' ^ (ℓ - 1) * a₀ * w * S) * r2
      have hEOK : OK (E * sh ^ ℓ) := by
        rw [hEdef]
        refine OkM _ _ (OkA _ _ (OkM _ _ (OkP _ _ (OkC ρ)) hyOK)
          (OkM _ _ (OkM _ _ (OkM _ _ (OkM _ _ (OkP _ _ (OkC ρ)) (OkP _ _ (OkC ρ'))) ha₀OK) hwOK) hS))
          (OkP _ _ (OkL _ _ hdh hsh))
      set D : A := dg * (dh * d') with hD
      have hD𝔭 : D ∉ 𝔭 := T5 _ _ hdg (T5 _ _ hdh hd')
      have hLgD : wcLlsKPLoc A K 0 D g := TD _ _ _ hLg ⟨dh * d', rfl⟩
      have hLshD : wcLlsKPLoc A K 0 D sh := TD _ _ _ hsh ⟨dg * d', by rw [hD]; ring⟩
      have hLzD : wcLlsKPLoc A K 0 D z := TD _ _ _ hz ⟨dg * dh, by rw [hD]; ring⟩
      obtain ⟨d3, hd3, hLE⟩ := DIV (g * sh ^ ℓ - z ^ ℓ) (E * sh ^ ℓ) ρ D hD𝔭
        (TSub _ _ _ (TMul _ _ _ hLgD (TPow _ _ _ hLshD)) (TPow _ _ _ hLzD)) hρ0 hEOK hEid
      obtain ⟨r, d4, hd4, hLr, hML⟩ := HN ℓ z sh g D hℓ.one_lt.le hD𝔭 hLzD hLshD hLgD hnsh
        ⟨d3, hd3, ⟨ρ, hρm, E * sh ^ ℓ, hLE, hEid⟩⟩
      obtain ⟨π₂, hπ₂, z₂, hLz₂, hzr⟩ := hML
      have hdvd := hmax (a₀ + P * r) z₂ (π * π₂) (d' * d4) (T5 _ _ hd' hd4)
        (TA _ _ _ (TD _ _ _ ha₀ ⟨d4, rfl⟩) (TMul _ _ _ (TC _ _) (T3 _ _ _ hLr)))
        (T3 _ _ _ hLz₂) (by
          rw [map_mul, map_mul, ← hP]
          linear_combination hbz + P * hzr)
      obtain ⟨k, hk⟩ := hdvd
      have hk1 : π₂ * k = 1 := by
        apply mul_left_cancel₀ hπ0
        rw [mul_one, ← mul_assoc]
        exact hk.symm
      exact ((IsLocalRing.mem_maximalIdeal π₂).mp hπ₂) (isUnit_of_dvd_one ⟨k, hk1.symm⟩)

theorem wcLlsKP_bau_caseB : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (f₁ : K) (d₁ : A), d₁ ∉ 𝔭 →
      (∃ r : K, wcLlsKPLoc A K 0 d₁ r ∧ f₁ - 1 = (ℓ : K) * r) → wcLlsKPLoc A K 0 d₁ f₁⁻¹ →
      (∀ (γ ε₀ : ↥W) (h' : K) (d : A), d ∉ 𝔭 → IsUnit ε₀ →
        ((ℓ : ℕ) : ↥W) = γ ^ (ℓ - 1) * ε₀ → wcLlsKPLoc A K 0 d h' →
        wcLlsKPLoc A K 0 d ((f₁ - h' ^ ℓ) / algebraMap A K (algebraMap ↥W A γ) ^ ℓ) → False) →
      ∃ (k q : K) (γ₁ : ↥W) (d : A), d ∉ 𝔭 ∧ k ≠ 0 ∧ γ₁ ≠ 0 ∧
        wcLlsKPLoc A K 0 d k ∧ wcLlsKPLoc A K 0 d k⁻¹ ∧ wcLlsKPLoc A K 0 d q ∧
        f₁ * k ^ ℓ - 1 = algebraMap A K (algebraMap ↥W A γ₁) ^ ℓ * q ∧
        (∃ x z : K, wcLlsKPLoc A K 0 d x ∧ wcLlsKPMLoc W A K 0 d z ∧
          f₁ * k ^ ℓ - 1 = algebraMap A K t * x + z) ∧
        ∀ (e : K) (d' : A), d' ∉ 𝔭 → wcLlsKPLoc A K 0 d' e →
          ¬ wcLlsKPMLoc W A K 0 d' (q - e ^ ℓ) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ 𝔭 t hPD f₁ d₁ hd₁ hr0 _hL2 hNoAS
  obtain ⟨r, hLr, hfr⟩ := hr0

  have T0 : ∀ (d : A) (x : K), wcLlsKPLoc A K 0 d x ↔
      ∃ (n : ℕ) (a : A), algebraMap A K a = algebraMap A K d ^ n * x := by
    intro d x
    have hbot : Algebra.adjoin A ({0} : Set K) = ⊥ := by
      apply le_antisymm
      · rw [Algebra.adjoin_le_iff]
        intro z hz
        rw [Set.mem_singleton_iff.mp hz]
        exact Subalgebra.zero_mem _
      · exact bot_le
    unfold wcLlsKPLoc
    rw [hbot]
    constructor
    · rintro ⟨n, hn⟩
      obtain ⟨a, ha⟩ := Algebra.mem_bot.mp hn
      exact ⟨n, a, ha⟩
    · rintro ⟨n, a, ha⟩
      exact ⟨n, Algebra.mem_bot.mpr ⟨a, ha⟩⟩
  have T3 : ∀ (d e : A) (x : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 (e * d) x := by
    intro d e x hx
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    refine (T0 _ _).mpr ⟨n, e ^ n * a, ?_⟩
    simp only [map_mul, map_pow, ha]
    ring
  have TD : ∀ (d e : A) (x : K), wcLlsKPLoc A K 0 d x → d ∣ e → wcLlsKPLoc A K 0 e x := by
    intro d e x hx hde
    obtain ⟨c, rfl⟩ := hde
    have := T3 d c x hx
    rwa [mul_comm] at this
  have TMul : ∀ (d : A) (x y : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d y →
      wcLlsKPLoc A K 0 d (x * y) := by
    intro d x y hx hy
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    obtain ⟨n', a', ha'⟩ := (T0 d y).mp hy
    refine (T0 _ _).mpr ⟨n + n', a * a', ?_⟩
    simp only [map_mul, ha, ha']
    ring
  have TA : ∀ (d : A) (x y : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d y →
      wcLlsKPLoc A K 0 d (x + y) := by
    intro d x y hx hy
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    obtain ⟨n', a', ha'⟩ := (T0 d y).mp hy
    refine (T0 _ _).mpr ⟨n + n', a * d ^ n' + a' * d ^ n, ?_⟩
    simp only [map_add, map_mul, map_pow, ha, ha']
    ring
  have TNeg : ∀ (d : A) (x : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d (-x) := by
    intro d x hx
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    refine (T0 _ _).mpr ⟨n, -a, ?_⟩
    rw [map_neg, ha]
    ring
  have TSub : ∀ (d : A) (x y : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d y →
      wcLlsKPLoc A K 0 d (x - y) := by
    intro d x y hx hy
    rw [sub_eq_add_neg]
    exact TA _ _ _ hx (TNeg _ _ hy)
  have TC : ∀ (d a : A), wcLlsKPLoc A K 0 d (algebraMap A K a) := by
    intro d a
    exact (T0 _ _).mpr ⟨0, a, by rw [pow_zero, one_mul]⟩
  have Tone : ∀ d : A, wcLlsKPLoc A K 0 d 1 := by
    intro d
    have := TC d 1
    rwa [map_one] at this
  have Tzero : ∀ d : A, wcLlsKPLoc A K 0 d 0 := by
    intro d
    have := TC d 0
    rwa [map_zero] at this
  have TPow : ∀ (d : A) (x : K) (m : ℕ), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d (x ^ m) := by
    intro d x m hx
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    refine (T0 _ _).mpr ⟨n * m, a ^ m, ?_⟩
    rw [map_pow, ha, mul_pow, ← pow_mul]
  have hPrime : 𝔭.IsPrime := hPD.2.2.2.1.isPrime
  have T5 : ∀ a b : A, a ∉ 𝔭 → b ∉ 𝔭 → a * b ∉ 𝔭 := fun a b ha hb hab =>
    (hPrime.mem_or_mem hab).elim ha hb
  have TP : ∀ (a : A) (n : ℕ), a ∉ 𝔭 → a ^ n ∉ 𝔭 := fun a n ha h =>
    ha (hPrime.mem_of_pow_mem n h)
  have hm𝔭 : Ideal.map (algebraMap ↥W A) (IsLocalRing.maximalIdeal ↥W) ≤ 𝔭 := hPD.2.2.2.2.1
  have hℓm : ((ℓ : ℕ) : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [← IsLocalRing.residue_eq_zero_iff, map_natCast]
    exact (ringChar.spec _ ℓ).mpr (by rw [hκ])
  have hmP : (IsLocalRing.maximalIdeal ↥W).IsPrime := (IsLocalRing.maximalIdeal.isMaximal ↥W).isPrime
  have hℓ2 := hℓ.two_le

  have NM1 : ∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' 1 := by
    rintro d'' hd'' ⟨π, hπ, x', hx', h1⟩
    obtain ⟨n, c, hc⟩ := (T0 d'' x').mp hx'
    have hπ𝔭 : algebraMap ↥W A π ∈ 𝔭 := hm𝔭 (Ideal.mem_map_of_mem _ hπ)
    have e : algebraMap A K (algebraMap ↥W A π * c) = algebraMap A K (d'' ^ n) := by
      rw [map_mul, hc, map_pow]
      linear_combination (-(algebraMap A K d'' ^ n)) * h1
    have e2 := IsFractionRing.injective A K e
    exact TP d'' n hd'' (e2 ▸ 𝔭.mul_mem_right _ hπ𝔭)
  have OkL : ∀ (d : A) (x : K), d ∉ 𝔭 → wcLlsKPLoc A K 0 d x →
      ∃ (d₀ : A) (b s : K), d₀ ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d₀ b ∧ wcLlsKPLoc A K 0 d₀ s ∧
        (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) ∧ x * s = b :=
    fun d x hd hx => ⟨d, x, 1, hd, hx, Tone d, NM1, mul_one x⟩
  have OkC : ∀ (a : A) (y : K),
      (∃ (d₀ : A) (b s : K), d₀ ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d₀ b ∧ wcLlsKPLoc A K 0 d₀ s ∧
        (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) ∧ y * s = b) →
      ∃ (d₀ : A) (b s : K), d₀ ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d₀ b ∧ wcLlsKPLoc A K 0 d₀ s ∧
        (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) ∧ algebraMap A K a * y * s = b := by
    rintro a y ⟨d, b, s, hd, hb, hs, hns, hys⟩
    exact ⟨d, algebraMap A K a * b, s, hd, TMul _ _ _ (TC _ _) hb, hs, hns, by rw [mul_assoc, hys]⟩

  obtain ⟨β, hβ, hβ0, hβm⟩ : ∃ β : ↥W, β ^ (ℓ - 1) = ((ℓ : ℕ) : ↥W) ∧ β ≠ 0 ∧
      β ∈ IsLocalRing.maximalIdeal ↥W := by
    have hℓΩ : ((ℓ : ℕ) : Ω) ≠ 0 := by
      intro h
      rcases hℓ.eq_one_or_self_of_dvd _ (ringChar.dvd h) with h1 | h1
      · exact CharP.ringChar_ne_one h1
      · exact hΩ h1
    obtain ⟨x0, hx0⟩ := IsAlgClosed.exists_pow_nat_eq ((ℓ : ℕ) : Ω) (n := ℓ - 1) (by omega)
    have hx00 : x0 ≠ 0 := by
      rintro rfl
      rw [zero_pow (by omega)] at hx0
      exact hℓΩ hx0.symm
    have hx0W : x0 ∈ W := by
      rcases W.mem_or_inv_mem x0 with h | h
      · exact h
      · exfalso
        have hunit : IsUnit ((ℓ : ℕ) : ↥W) := by
          have hmul : ((ℓ : ℕ) : ↥W) * (⟨x0⁻¹, h⟩ : ↥W) ^ (ℓ - 1) = 1 := by
            apply Subtype.ext
            push_cast
            rw [inv_pow, hx0, mul_inv_cancel₀ hℓΩ]
          exact ⟨⟨_, _, hmul, by rw [mul_comm]; exact hmul⟩, rfl⟩
        exact ((IsLocalRing.mem_maximalIdeal _).mp hℓm) hunit
    have hβ' : (⟨x0, hx0W⟩ : ↥W) ^ (ℓ - 1) = ((ℓ : ℕ) : ↥W) := by
      apply Subtype.ext
      push_cast
      exact hx0
    refine ⟨⟨x0, hx0W⟩, hβ', ?_, ?_⟩
    · intro h0
      apply hx00
      exact congrArg Subtype.val h0
    · apply hmP.mem_of_pow_mem (ℓ - 1)
      rw [hβ']
      exact hℓm

  have HC := wcLlsKP_bau_content Ω W hW hWt A K 𝔭 t hPD
  have HP := wcLlsKP_bcB_mA_prime Ω W hW hWt A K 𝔭 t hPD
  have HN := wcLlsKP_bcB_residue_normal Ω W hW hWt A K 𝔭 t hPD
  have HL := wcLlsKP_bcB_linear_best Ω W hW hWt A K 𝔭 t hPD HC HP
  have hLf : wcLlsKPLoc A K 0 d₁ f₁ := by
    have e : f₁ = 1 + algebraMap A K ((ℓ : ℕ) : A) * r := by
      rw [map_natCast]
      linear_combination hfr
    rw [e]
    exact TA _ _ _ (Tone d₁) (TMul _ _ _ (TC _ _) hLr)

  have hkill : ∀ h : K,
      (∃ (d₀ : A) (b s : K), d₀ ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d₀ b ∧ wcLlsKPLoc A K 0 d₀ s ∧
        (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) ∧ h * s = b) →
      (∃ (π : ↥W) (y' : K), π ∈ IsLocalRing.maximalIdeal ↥W ∧
        (∃ (d : A) (b s : K), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d b ∧ wcLlsKPLoc A K 0 d s ∧
          (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) ∧ y' * s = b) ∧
        h - 1 = algebraMap A K (algebraMap ↥W A π) * y') →
      (∃ y : K,
        (∃ (d : A) (b s : K), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d b ∧ wcLlsKPLoc A K 0 d s ∧
          (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) ∧ y * s = b) ∧
        f₁ - h ^ ℓ = algebraMap A K (algebraMap ↥W A β) ^ ℓ * y) → False := by
    intro h hOk hOM hy
    obtain ⟨a, q, d, hd, hLa, hLq, hq, -⟩ := wcLlsKP_bcB_transfer Ω W hW hWt A K 𝔭 t hPD ℓ hℓ hκ
      HC HP HN HL f₁ d₁ hd₁ hLf h β β hβ hβ0 hβm dvd_rfl hOk hOM hy
    apply hNoAS β 1 a d hd isUnit_one (by rw [mul_one, hβ]) hLa
    by_cases hz : algebraMap A K (algebraMap ↥W A β) ^ ℓ = 0
    · rw [hz, div_zero]
      exact Tzero d
    · rw [hq, mul_div_cancel_left₀ _ hz]
      exact hLq

  rcases wcLlsKP_bcB_field_attain Ω W hW hWt A K 𝔭 t hPD ℓ hℓ hΩ hκ HC HP f₁ r d₁ hd₁ hLr hfr β
      hβ with ⟨h, hOk, hOM, hy⟩ | ⟨h, γ, hγ0, hOk, hOM, ⟨y, hyOk, hy⟩, hmax⟩
  · exact (hkill h hOk hOM hy).elim

  have hγm : γ ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hγm
    have hu : IsUnit γ := by
      by_contra h'
      exact hγm ((IsLocalRing.mem_maximalIdeal γ).mpr h')
    set u' : ↥W := ((hu.unit⁻¹ : (↥W)ˣ) : ↥W) with hu'
    have hγu : γ * u' = 1 := hu.mul_val_inv
    apply hmax 1 (OkL d₁ 1 hd₁ (Tone d₁))
    refine ⟨((ℓ : ℕ) : ↥W) * u' ^ ℓ, r, Ideal.mul_mem_right _ _ hℓm, OkL d₁ r hd₁ hLr, ?_⟩
    have e1 : algebraMap A K (algebraMap ↥W A γ) * algebraMap A K (algebraMap ↥W A u') = 1 := by
      rw [← map_mul, ← map_mul, hγu, map_one, map_one]
    have e2 : algebraMap A K (algebraMap ↥W A γ) ^ ℓ *
        algebraMap A K (algebraMap ↥W A u') ^ ℓ = 1 := by
      rw [← mul_pow, e1, one_pow]
    simp only [map_mul, map_pow, map_natCast, one_pow]
    linear_combination hfr - (ℓ : K) * r * e2

  have hβγ : ¬ β ∣ γ := by
    rintro ⟨c, hc⟩
    apply hkill h hOk hOM
    have hO := OkC ((algebraMap ↥W A c) ^ ℓ) y hyOk
    rw [map_pow] at hO
    refine ⟨algebraMap A K (algebraMap ↥W A c) ^ ℓ * y, hO, ?_⟩
    rw [hy, hc]
    simp only [map_mul, mul_pow]
    ring
  obtain ⟨ρ, hρ⟩ : γ ∣ β := by
    rcases ValuationRing.dvd_total γ β with h1 | h1
    · exact h1
    · exact (hβγ h1).elim
  have hρm : ρ ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hρm
    have hu : IsUnit ρ := by
      by_contra h'
      exact hρm ((IsLocalRing.mem_maximalIdeal ρ).mpr h')
    apply hβγ
    refine ⟨((hu.unit⁻¹ : (↥W)ˣ) : ↥W), ?_⟩
    rw [hρ, mul_assoc, hu.mul_val_inv, mul_one]

  obtain ⟨a₀, q₀, d, hd, hLa, hLq, hfa, π, z, hπ, hLz, haz⟩ :=
    wcLlsKP_bcB_transfer Ω W hW hWt A K 𝔭 t hPD ℓ hℓ hκ HC HP HN HL f₁ d₁ hd₁ hLf h γ β hβ hγ0
      hγm ⟨ρ, hρ⟩ hOk hOM ⟨y, hyOk, hy⟩

  obtain ⟨N, c, hc⟩ := (T0 d z).mp hLz
  have hπ𝔭 : algebraMap ↥W A π ∈ 𝔭 := hm𝔭 (Ideal.mem_map_of_mem _ hπ)
  have hu𝔭 : d ^ N + algebraMap ↥W A π * c ∉ 𝔭 := by
    intro hu
    apply TP d N hd
    exact (Ideal.add_mem_iff_left 𝔭 (𝔭.mul_mem_right _ hπ𝔭)).mp hu
  have hua : algebraMap A K (d ^ N + algebraMap ↥W A π * c) = algebraMap A K d ^ N * a₀ := by
    simp only [map_add, map_mul, map_pow]
    linear_combination algebraMap A K (algebraMap ↥W A π) * hc - algebraMap A K d ^ N * haz
  have ha0 : a₀ ≠ 0 := by
    intro h0
    rw [h0, mul_zero] at hua
    have := IsFractionRing.injective A K (hua.trans (map_zero _).symm)
    exact hu𝔭 (this ▸ 𝔭.zero_mem)
  have hLai : wcLlsKPLoc A K 0 (d ^ N + algebraMap ↥W A π * c) a₀⁻¹ :=
    (T0 _ a₀⁻¹).mpr ⟨1, d ^ N, by rw [map_pow, pow_one, hua, mul_assoc, mul_inv_cancel₀ ha0,
      mul_one]⟩

  set u : A := d ^ N + algebraMap ↥W A π * c with hu
  have hD : d * u ∉ 𝔭 := T5 _ _ hd hu𝔭
  have hLk : wcLlsKPLoc A K 0 (d * u) a₀⁻¹ := TD _ _ _ hLai ⟨d, by ring⟩
  have hLki : wcLlsKPLoc A K 0 (d * u) a₀⁻¹⁻¹ := by
    rw [inv_inv]
    exact TD _ _ _ hLa ⟨u, rfl⟩
  have hLq' : wcLlsKPLoc A K 0 (d * u) ((a₀⁻¹) ^ ℓ * q₀) :=
    TMul _ _ _ (TPow _ _ ℓ hLk) (TD _ _ _ hLq ⟨u, rfl⟩)
  have hka : a₀ ^ ℓ * (a₀⁻¹) ^ ℓ = 1 := by rw [← mul_pow, mul_inv_cancel₀ ha0, one_pow]
  have hq' : f₁ * (a₀⁻¹) ^ ℓ - 1 =
      algebraMap A K (algebraMap ↥W A γ) ^ ℓ * ((a₀⁻¹) ^ ℓ * q₀) := by
    linear_combination (a₀⁻¹) ^ ℓ * hfa + hka
  refine ⟨a₀⁻¹, (a₀⁻¹) ^ ℓ * q₀, γ, d * u, hD, inv_ne_zero ha0, hγ0, hLk, hLki, hLq', hq', ?_, ?_⟩

  · refine ⟨0, algebraMap A K (algebraMap ↥W A γ) ^ ℓ * ((a₀⁻¹) ^ ℓ * q₀), Tzero _,
      ⟨γ ^ ℓ, Ideal.pow_mem_of_mem _ hγm ℓ hℓ.pos, (a₀⁻¹) ^ ℓ * q₀, hLq', by
        rw [map_pow, map_pow]⟩, ?_⟩
    rw [mul_zero, zero_add]
    exact hq'

  · rintro e d' hd' hLe ⟨π₁, hπ₁, x₁, hLx₁, hx₁⟩
    have hLGe : wcLlsKPLoc A K 0 d' (algebraMap A K (algebraMap ↥W A γ) * e) :=
      TMul _ _ _ (TC d' _) hLe
    obtain ⟨S, hS, hLS⟩ : ∃ S : K,
        (algebraMap A K (algebraMap ↥W A γ) * e + 1) ^ ℓ =
          (algebraMap A K (algebraMap ↥W A γ) * e) ^ ℓ + 1 +
            (ℓ : K) * (algebraMap A K (algebraMap ↥W A γ) * e) * S ∧
        wcLlsKPLoc A K 0 d' S := by
      refine ⟨∑ k ∈ Finset.Ioo 0 ℓ, (algebraMap A K (algebraMap ↥W A γ) * e) ^ (k - 1) *
        1 ^ (ℓ - k - 1) * ((ℓ.choose k / ℓ : ℕ) : K), ?_, ?_⟩
      · rw [add_pow_prime_eq hℓ]
        ring
      · apply Finset.sum_induction _ (fun x => wcLlsKPLoc A K 0 d' x)
          (fun a b ha hb => TA _ _ _ ha hb) (Tzero d')
        intro k _
        refine TMul _ _ _ (TMul _ _ _ (TPow _ _ _ hLGe) (by rw [one_pow]; exact Tone d')) ?_
        have := TC d' ((ℓ.choose k / ℓ : ℕ) : A)
        rwa [map_natCast] at this
    have E4 : (ℓ : K) * algebraMap A K (algebraMap ↥W A γ) =
        algebraMap A K (algebraMap ↥W A γ) ^ ℓ * algebraMap A K (algebraMap ↥W A ρ) ^ (ℓ - 1) := by
      have h1 : (ℓ : K) = algebraMap A K (algebraMap ↥W A γ) ^ (ℓ - 1) *
          algebraMap A K (algebraMap ↥W A ρ) ^ (ℓ - 1) := by
        have := congrArg (fun w : ↥W => algebraMap A K (algebraMap ↥W A w)) hβ
        simp only [map_pow, map_natCast, hρ, map_mul, mul_pow] at this
        exact this.symm
      rw [h1, ← pow_sub_one_mul hℓ.ne_zero (algebraMap A K (algebraMap ↥W A γ))]
      ring
    have key : f₁ - (a₀ * (algebraMap A K (algebraMap ↥W A γ) * e + 1)) ^ ℓ =
        a₀ ^ ℓ * algebraMap A K (algebraMap ↥W A γ) ^ ℓ *
          (algebraMap A K (algebraMap ↥W A π₁) * x₁ -
            algebraMap A K (algebraMap ↥W A ρ) ^ (ℓ - 1) * e * S) := by
      rw [mul_pow]
      linear_combination (-(a₀ ^ ℓ)) * hS - a₀ ^ ℓ * e * S * E4 +
        a₀ ^ ℓ * algebraMap A K (algebraMap ↥W A γ) ^ ℓ * hx₁ + a₀ ^ ℓ * hq' - f₁ * hka
    have hDD : d * d' ∉ 𝔭 := T5 _ _ hd hd'
    have hLa' : wcLlsKPLoc A K 0 (d * d') a₀ := TD _ _ _ hLa ⟨d', rfl⟩
    have hLe' : wcLlsKPLoc A K 0 (d * d') e := TD _ _ _ hLe ⟨d, by ring⟩
    have hLx' : wcLlsKPLoc A K 0 (d * d') x₁ := TD _ _ _ hLx₁ ⟨d, by ring⟩
    have hLS' : wcLlsKPLoc A K 0 (d * d') S := TD _ _ _ hLS ⟨d, by ring⟩
    have hOkh' := OkL (d * d') (a₀ * (algebraMap A K (algebraMap ↥W A γ) * e + 1)) hDD
      (TMul _ _ _ hLa' (TA _ _ _ (TMul _ _ _ (TC _ _) hLe') (Tone _)))
    apply hmax _ hOkh'
    rcases ValuationRing.dvd_total π₁ (ρ ^ (ℓ - 1)) with ⟨c', hc'⟩ | ⟨c', hc'⟩
    · refine ⟨π₁, a₀ ^ ℓ * (x₁ - algebraMap A K (algebraMap ↥W A c') * e * S), hπ₁,
        OkL (d * d') _ hDD (TMul _ _ _ (TPow _ _ _ hLa')
          (TSub _ _ _ hLx' (TMul _ _ _ (TMul _ _ _ (TC _ _) hLe') hLS'))), ?_⟩
      rw [key]
      have : algebraMap A K (algebraMap ↥W A ρ) ^ (ℓ - 1) =
          algebraMap A K (algebraMap ↥W A π₁) * algebraMap A K (algebraMap ↥W A c') := by
        rw [← map_pow, ← map_pow, hc', map_mul, map_mul]
      rw [this]
      ring
    · refine ⟨ρ ^ (ℓ - 1), a₀ ^ ℓ * (algebraMap A K (algebraMap ↥W A c') * x₁ - e * S),
        Ideal.pow_mem_of_mem _ hρm (ℓ - 1) (by omega),
        OkL (d * d') _ hDD (TMul _ _ _ (TPow _ _ _ hLa')
          (TSub _ _ _ (TMul _ _ _ (TC _ _) hLx') (TMul _ _ _ hLe' hLS'))), ?_⟩
      rw [key, hc']
      simp only [map_mul, map_pow]
      ring

theorem wcLlsKP_vde_best_approx_unit : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (f₁ : K) (d₁ : A), d₁ ∉ 𝔭 → wcLlsKPLoc A K 0 d₁ f₁ → wcLlsKPLoc A K 0 d₁ f₁⁻¹ →
      (∃ x z : K, wcLlsKPLoc A K 0 d₁ x ∧ wcLlsKPMLoc W A K 0 d₁ z ∧
        f₁ - 1 = algebraMap A K t * x + z) →
      (∀ (γ ε₀ : ↥W) (h' : K) (d : A), d ∉ 𝔭 → IsUnit ε₀ →
        ((ℓ : ℕ) : ↥W) = γ ^ (ℓ - 1) * ε₀ → wcLlsKPLoc A K 0 d h' →
        wcLlsKPLoc A K 0 d ((f₁ - h' ^ ℓ) / algebraMap A K (algebraMap ↥W A γ) ^ ℓ) → False) →
      ∃ (k q : K) (γ₁ : ↥W) (d : A), d ∉ 𝔭 ∧ k ≠ 0 ∧ γ₁ ≠ 0 ∧
        wcLlsKPLoc A K 0 d k ∧ wcLlsKPLoc A K 0 d k⁻¹ ∧ wcLlsKPLoc A K 0 d q ∧
        f₁ * k ^ ℓ - 1 = algebraMap A K (algebraMap ↥W A γ₁) ^ ℓ * q ∧
        (∃ x z : K, wcLlsKPLoc A K 0 d x ∧ wcLlsKPMLoc W A K 0 d z ∧
          f₁ * k ^ ℓ - 1 = algebraMap A K t * x + z) ∧
        ∀ (e : K) (d' : A), d' ∉ 𝔭 → wcLlsKPLoc A K 0 d' e →
          ¬ wcLlsKPMLoc W A K 0 d' (q - e ^ ℓ) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ 𝔭 t hPD f₁ d₁ hd₁ hL1 hL2 hPU hNoAS

  have T0 : ∀ (d : A) (x : K), wcLlsKPLoc A K 0 d x ↔
      ∃ (n : ℕ) (a : A), algebraMap A K a = algebraMap A K d ^ n * x := by
    intro d x
    have hbot : Algebra.adjoin A ({0} : Set K) = ⊥ := by
      apply le_antisymm
      · rw [Algebra.adjoin_le_iff]
        intro z hz
        rw [Set.mem_singleton_iff.mp hz]
        exact Subalgebra.zero_mem _
      · exact bot_le
    unfold wcLlsKPLoc
    rw [hbot]
    constructor
    · rintro ⟨n, hn⟩
      obtain ⟨a, ha⟩ := Algebra.mem_bot.mp hn
      exact ⟨n, a, ha⟩
    · rintro ⟨n, a, ha⟩
      exact ⟨n, Algebra.mem_bot.mpr ⟨a, ha⟩⟩
  have T2 : ∀ (d d' : A) (x z : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d' z →
      wcLlsKPLoc A K 0 (d * d') (x * z) := by
    intro d d' x z hx hz
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    obtain ⟨n', a', ha'⟩ := (T0 d' z).mp hz
    refine (T0 _ _).mpr ⟨n + n', a * a' * (d ^ n' * d' ^ n), ?_⟩
    simp only [map_mul, map_pow, ha, ha']
    ring
  have T3 : ∀ (d e : A) (x : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 (e * d) x := by
    intro d e x hx
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    refine (T0 _ _).mpr ⟨n, e ^ n * a, ?_⟩
    simp only [map_mul, map_pow, ha]
    ring
  have T4 : ∀ (d : A) (x : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d (x ^ ℓ) := by
    intro d x hx
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    refine (T0 _ _).mpr ⟨n * ℓ, a ^ ℓ, ?_⟩
    rw [map_pow, ha, mul_pow, ← pow_mul]
  have TM : ∀ (d e : A) (z : K), wcLlsKPMLoc W A K 0 d z → wcLlsKPMLoc W A K 0 (e * d) z := by
    intro d e z hz
    obtain ⟨π, hπ, z', hz', hzz⟩ := hz
    exact ⟨π, hπ, z', T3 d e z' hz', hzz⟩
  have TD : ∀ (d e : A) (x : K), wcLlsKPLoc A K 0 d x → d ∣ e → wcLlsKPLoc A K 0 e x := by
    intro d e x hx hde
    obtain ⟨c, rfl⟩ := hde
    have := T3 d c x hx
    rwa [mul_comm] at this
  have TMD : ∀ (d e : A) (z : K), wcLlsKPMLoc W A K 0 d z → d ∣ e →
      wcLlsKPMLoc W A K 0 e z := by
    intro d e z hz hde
    obtain ⟨c, rfl⟩ := hde
    have := TM d c z hz
    rwa [mul_comm] at this
  have hPrime : 𝔭.IsPrime := hPD.2.2.2.1.isPrime
  have T5 : ∀ a b : A, a ∉ 𝔭 → b ∉ 𝔭 → a * b ∉ 𝔭 := fun a b ha hb hab =>
    (hPrime.mem_or_mem hab).elim ha hb
  have TP : ∀ (a : A) (n : ℕ), a ∉ 𝔭 → a ^ n ∉ 𝔭 := fun a n ha h =>
    ha (hPrime.mem_of_pow_mem n h)
  have hm𝔭 : Ideal.map (algebraMap ↥W A) (IsLocalRing.maximalIdeal ↥W) ≤ 𝔭 := hPD.2.2.2.2.1
  have ht𝔭 : t ∈ 𝔭 := hPD.2.2.2.2.2.1
  have hℓm : ((ℓ : ℕ) : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [← IsLocalRing.residue_eq_zero_iff, map_natCast]
    exact (ringChar.spec _ ℓ).mpr (by rw [hκ])
  have hℓ𝔭 : ((ℓ : ℕ) : A) ∈ 𝔭 := by
    have := hm𝔭 (Ideal.mem_map_of_mem (algebraMap ↥W A) hℓm)
    rwa [map_natCast] at this

  by_cases hB : ∃ (s r : K) (d : A), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d s ∧ wcLlsKPLoc A K 0 d r ∧
      f₁ - s ^ ℓ = (ℓ : K) * r
  swap
  ·
    obtain ⟨h, D, hh, hD1, hD2, hD3, hD4, hD5⟩ := wcLlsKP_bau_deriv Ω W A K 𝔭 t hPD
    exact wcLlsKP_bau_caseA Ω W hW hWt ℓ hℓ hΩ hκ A K 𝔭 t hPD
      (wcLlsKP_bau_content Ω W hW hWt A K 𝔭 t hPD) h D hh hD1 hD2 hD3 hD4 hD5
      (wcLlsKP_bau_cartier Ω W hW hWt ℓ hℓ hκ A K 𝔭 t hPD h D hh hD1 hD2 hD3 hD4 hD5)
      f₁ d₁ hd₁ hL1 hL2 hPU hB hNoAS

  obtain ⟨s, r, d₀, hd₀, hLs, hLr, hsr⟩ := hB
  obtain ⟨n, a, ha⟩ := (T0 d₀ s).mp hLs
  obtain ⟨n₁, b, hb⟩ := (T0 d₀ r).mp hLr
  obtain ⟨x, z, hx, hz, hxz⟩ := hPU
  obtain ⟨n₂, ax, hax⟩ := (T0 d₁ x).mp hx
  obtain ⟨π, hπ, z', hz', hzz⟩ := hz
  obtain ⟨n₃, az, haz⟩ := (T0 d₁ z').mp hz'
  have hπ𝔭 : algebraMap ↥W A π ∈ 𝔭 := hm𝔭 (Ideal.mem_map_of_mem _ hπ)
  have hE : d₀ ^ n₁ * d₁ ^ n₂ * d₁ ^ n₃ ∉ 𝔭 :=
    T5 _ _ (T5 _ _ (TP _ _ hd₀) (TP _ _ hd₁)) (TP _ _ hd₁)
  have hEqA : a ^ ℓ * (d₀ ^ n₁ * d₁ ^ n₂ * d₁ ^ n₃) = (d₀ ^ n) ^ ℓ *
      (d₀ ^ n₁ * d₁ ^ n₂ * d₁ ^ n₃ + (t * ax * d₀ ^ n₁ * d₁ ^ n₃ +
        algebraMap ↥W A π * az * d₀ ^ n₁ * d₁ ^ n₂ - ((ℓ : ℕ) : A) * b * d₁ ^ n₂ * d₁ ^ n₃)) := by
    apply IsFractionRing.injective A K
    simp only [map_mul, map_pow, map_add, map_sub, map_natCast]
    rw [ha, hb, hax, haz]
    linear_combination ((algebraMap A K d₀) ^ n) ^ ℓ * (algebraMap A K d₀ ^ n₁ *
      algebraMap A K d₁ ^ n₂ * algebraMap A K d₁ ^ n₃) * (-hsr + hxz + hzz)
  have ha0 : a ∉ 𝔭 := by
    intro haP
    have h1 : a ^ ℓ * (d₀ ^ n₁ * d₁ ^ n₂ * d₁ ^ n₃) ∈ 𝔭 :=
      𝔭.mul_mem_right _ (Ideal.pow_mem_of_mem 𝔭 haP ℓ hℓ.pos)
    rw [hEqA] at h1
    rcases hPrime.mem_or_mem h1 with h2 | h2
    · exact TP _ _ (TP _ _ hd₀) h2
    · apply hE
      have hX : t * ax * d₀ ^ n₁ * d₁ ^ n₃ + algebraMap ↥W A π * az * d₀ ^ n₁ * d₁ ^ n₂ -
          ((ℓ : ℕ) : A) * b * d₁ ^ n₂ * d₁ ^ n₃ ∈ 𝔭 :=
        𝔭.sub_mem (𝔭.add_mem (𝔭.mul_mem_right _ (𝔭.mul_mem_right _ (𝔭.mul_mem_right _ ht𝔭)))
          (𝔭.mul_mem_right _ (𝔭.mul_mem_right _ (𝔭.mul_mem_right _ hπ𝔭))))
          (𝔭.mul_mem_right _ (𝔭.mul_mem_right _ (𝔭.mul_mem_right _ hℓ𝔭)))
      exact (Ideal.add_mem_iff_left 𝔭 hX).mp h2
  have hs0 : s ≠ 0 := by
    intro hs
    apply ha0
    have : algebraMap A K a = 0 := by rw [ha, hs, mul_zero]
    rw [(IsFractionRing.injective A K) (this.trans (map_zero _).symm)]
    exact 𝔭.zero_mem
  have hLsi : wcLlsKPLoc A K 0 a s⁻¹ :=
    (T0 a s⁻¹).mpr ⟨1, d₀ ^ n, by rw [map_pow, pow_one, ha, mul_assoc, mul_inv_cancel₀ hs0,
      mul_one]⟩
  have hss : s ^ ℓ * (s⁻¹) ^ ℓ = 1 := by rw [← mul_pow, mul_inv_cancel₀ hs0, one_pow]

  set D' : A := d₁ * (d₀ * a) with hD'
  have hD'𝔭 : D' ∉ 𝔭 := T5 _ _ hd₁ (T5 _ _ hd₀ ha0)
  have hr' : wcLlsKPLoc A K 0 D' (r * (s⁻¹) ^ ℓ) :=
    TD _ _ _ (T2 _ _ _ _ hLr (T4 _ _ hLsi)) ⟨d₁, by rw [hD']; ring⟩
  have hf' : f₁ * (s⁻¹) ^ ℓ - 1 = (ℓ : K) * (r * (s⁻¹) ^ ℓ) := by
    linear_combination (s⁻¹) ^ ℓ * hsr + hss
  have hLf'i : wcLlsKPLoc A K 0 D' (f₁ * (s⁻¹) ^ ℓ)⁻¹ := by
    have e : (f₁ * (s⁻¹) ^ ℓ)⁻¹ = f₁⁻¹ * s ^ ℓ := by rw [mul_inv, inv_pow, inv_inv]
    rw [e]
    exact TD _ _ _ (T2 _ _ _ _ hL2 (T4 _ _ hLs)) ⟨a, by rw [hD']; ring⟩
  have hNoAS' : ∀ (γ ε₀ : ↥W) (h' : K) (d : A), d ∉ 𝔭 → IsUnit ε₀ →
      ((ℓ : ℕ) : ↥W) = γ ^ (ℓ - 1) * ε₀ → wcLlsKPLoc A K 0 d h' →
      wcLlsKPLoc A K 0 d ((f₁ * (s⁻¹) ^ ℓ - h' ^ ℓ) / algebraMap A K (algebraMap ↥W A γ) ^ ℓ) →
      False := by
    intro γ ε₀ h' d hd hε hγ h1 h2
    apply hNoAS γ ε₀ (h' * s) (d * d₀) (T5 _ _ hd hd₀) hε hγ (T2 _ _ _ _ h1 hLs)
    have heq : (f₁ - (h' * s) ^ ℓ) / algebraMap A K (algebraMap ↥W A γ) ^ ℓ =
        ((f₁ * (s⁻¹) ^ ℓ - h' ^ ℓ) / algebraMap A K (algebraMap ↥W A γ) ^ ℓ) * s ^ ℓ := by
      rw [div_eq_mul_inv, div_eq_mul_inv, mul_pow]
      linear_combination (-(f₁ * (algebraMap A K (algebraMap ↥W A γ) ^ ℓ)⁻¹)) * hss
    rw [heq]
    exact T2 _ _ _ _ h2 (T4 _ _ hLs)
  obtain ⟨k', q, γ₁, d₃, hd₃, hk'0, hγ₁, hLk', hLk'i, hLq, hq, ⟨x', z'', hx', hz'', hxz'⟩, hnp⟩ :=
    wcLlsKP_bau_caseB Ω W hW hWt ℓ hℓ hΩ hκ A K 𝔭 t hPD (f₁ * (s⁻¹) ^ ℓ) D' hD'𝔭
      ⟨r * (s⁻¹) ^ ℓ, hr', hf'⟩ hLf'i hNoAS'

  have hfk : f₁ * (s⁻¹ * k') ^ ℓ = f₁ * (s⁻¹) ^ ℓ * k' ^ ℓ := by rw [mul_pow, mul_assoc]
  refine ⟨s⁻¹ * k', q, γ₁, d₀ * a * d₃, T5 _ _ (T5 _ _ hd₀ ha0) hd₃,
    mul_ne_zero (inv_ne_zero hs0) hk'0, hγ₁, ?_, ?_, ?_, ?_, ?_, hnp⟩
  · exact TD _ _ _ (T2 _ _ _ _ hLsi hLk') ⟨d₀, by ring⟩
  · have e : (s⁻¹ * k')⁻¹ = s * k'⁻¹ := by rw [mul_inv, inv_inv]
    rw [e]
    exact TD _ _ _ (T2 _ _ _ _ hLs hLk'i) ⟨a, by ring⟩
  · exact TD _ _ _ hLq ⟨d₀ * a, by ring⟩
  · rw [hfk]; exact hq
  · refine ⟨x', z'', TD _ _ _ hx' ⟨d₀ * a, by ring⟩, TMD _ _ _ hz'' ⟨d₀ * a, by ring⟩, ?_⟩
    rw [hfk]; exact hxz'

theorem wcLlsKP_nfb_residue_order : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (q : K) (d₂ : A), d₂ ∉ 𝔭 → wcLlsKPLoc A K 0 d₂ q →
      (∀ (e : K) (d' : A), d' ∉ 𝔭 → wcLlsKPLoc A K 0 d' e →
        ¬ wcLlsKPMLoc W A K 0 d' (q - e ^ ℓ)) →
      ∃ (P : Polynomial ↥W) (N : ℕ) (d' : A) (y : K) (j : ℕ), d' ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d' y ∧
        q = P.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K t) +
          algebraMap A K t ^ N * y ∧
        j < N ∧ ¬ ℓ ∣ j ∧ P.coeff j ∉ IsLocalRing.maximalIdeal ↥W :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ 𝔭 t hPD q d₂ hd₂ hLq hnp
  classical
  by_contra hcon
  have H : ∀ (P : Polynomial ↥W) (N : ℕ) (d' : A) (y : K), d' ∉ 𝔭 → wcLlsKPLoc A K 0 d' y →
      q = P.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K t) +
        algebraMap A K t ^ N * y →
      ∀ j, j < N → ¬ ℓ ∣ j → P.coeff j ∈ IsLocalRing.maximalIdeal ↥W := by
    intro P N d' y hd' hy hq j hj hpj
    by_contra hPj
    exact hcon ⟨P, N, d', y, j, hd', hy, hq, hj, hpj, hPj⟩
  haveI hfact : Fact ℓ.Prime := ⟨hℓ⟩
  have hp0 : ℓ ≠ 0 := hℓ.ne_zero
  have hPD' := hPD
  obtain ⟨hFT, -, -, h𝔭max, hmle, ht, -⟩ := hPD'
  haveI : 𝔭.IsPrime := h𝔭max.isPrime

  have T0 : ∀ (d : A) (x : K), wcLlsKPLoc A K 0 d x ↔
      ∃ (n : ℕ) (a : A), algebraMap A K a = algebraMap A K d ^ n * x := by
    intro d x
    have hbot : Algebra.adjoin A ({0} : Set K) = ⊥ := by
      apply le_antisymm
      · rw [Algebra.adjoin_le_iff]
        intro z hz
        rw [Set.mem_singleton_iff.mp hz]
        exact Subalgebra.zero_mem _
      · exact bot_le
    unfold wcLlsKPLoc
    rw [hbot]
    constructor
    · rintro ⟨n, hn⟩
      obtain ⟨a, ha⟩ := Algebra.mem_bot.mp hn
      exact ⟨n, a, ha⟩
    · rintro ⟨n, a, ha⟩
      exact ⟨n, Algebra.mem_bot.mpr ⟨a, ha⟩⟩
  have hne0 : ∀ a : A, a ∉ 𝔭 → algebraMap A K a ≠ 0 := by
    intro a ha h0
    apply ha
    have : a = 0 := IsFractionRing.injective A K (by rw [h0, map_zero])
    rw [this]
    exact Ideal.zero_mem _
  have hmul𝔭 : ∀ a b : A, a ∉ 𝔭 → b ∉ 𝔭 → a * b ∉ 𝔭 := fun a b ha hb hab =>
    ((inferInstance : 𝔭.IsPrime).mem_or_mem hab).elim ha hb

  have hroot : ∀ w : ↥W, ∃ w' : ↥W, w' ^ ℓ = w := by
    intro w
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq ((w : Ω)) hℓ.pos
    have hint : IsIntegral ↥W z := by
      refine ⟨Polynomial.X ^ ℓ - Polynomial.C w, Polynomial.monic_X_pow_sub_C _ hp0, ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
      exact sub_eq_zero.mpr hz
    obtain ⟨x, hx⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥W) (K := Ω)).mp hint
    refine ⟨x, ?_⟩
    apply IsFractionRing.injective ↥W Ω
    rw [map_pow, hx, hz]
    rfl

  have S1 : ∃ (R : Type u) (_ : CommRing R) (_ : IsLocalRing R) (_ : IsNoetherianRing R)
      (_ : CharP R ℓ) (_ : Algebra ↥W R) (φ : A →+* R) (T : Finset R),
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W, φ (algebraMap ↥W A w) = 0) ∧
      (∀ a ∈ 𝔭, φ a ∈ IsLocalRing.maximalIdeal R) ∧
      (∀ a : A, a ∉ 𝔭 → IsUnit (φ a)) ∧
      (∀ r : R, ∃ b s : A, s ∉ 𝔭 ∧ φ s * r = φ b) ∧
      (∀ a : A, φ a = 0 → ∃ u : A, u ∉ 𝔭 ∧
        u * a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧
      (∀ r : R, ∃ s : R, IsUnit s ∧ s ∈ Algebra.adjoin ↥W (T : Set R) ∧
        s * r ∈ Algebra.adjoin ↥W (T : Set R)) := by
    haveI := hFT
    let mk : A →+* A ⧸ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := Ideal.Quotient.mk _
    have hmk : Function.Surjective mk := Ideal.Quotient.mk_surjective
    have hker : RingHom.ker mk = (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) :=
      Ideal.mk_ker
    haveI h𝔭b : (𝔭.map mk).IsPrime :=
      Ideal.map_isPrime_of_surjective hmk (by rw [hker]; exact hmle)
    have hcomap : (𝔭.map mk).comap mk = 𝔭 := by
      rw [Ideal.comap_map_of_surjective' mk hmk, hker, sup_eq_left.mpr hmle]
    have hmem : ∀ a : A, mk a ∈ 𝔭.map mk ↔ a ∈ 𝔭 := by
      intro a
      constructor
      · intro h
        have : a ∈ (𝔭.map mk).comap mk := h
        rwa [hcomap] at this
      · intro h
        exact Ideal.mem_map_of_mem _ h
    letI : Field (↥W ⧸ IsLocalRing.maximalIdeal ↥W) :=
      Ideal.Quotient.field (IsLocalRing.maximalIdeal ↥W)
    haveI : Algebra.FiniteType (↥W ⧸ IsLocalRing.maximalIdeal ↥W)
        (A ⧸ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) :=
      Algebra.FiniteType.of_restrictScalars_finiteType ↥W _ _
    haveI : IsNoetherianRing (A ⧸ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) :=
      Algebra.FiniteType.isNoetherianRing (↥W ⧸ IsLocalRing.maximalIdeal ↥W) _
    let R := Localization.AtPrime (𝔭.map mk)
    let φ : A →+* R := (algebraMap _ R).comp mk
    letI alg : Algebra ↥W R := (φ.comp (algebraMap ↥W A)).toAlgebra
    have h0 : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, φ (algebraMap ↥W A w) = 0 := by
      intro w hw
      show algebraMap _ R (mk (algebraMap ↥W A w)) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hw), map_zero]
    have hchar : CharP R ℓ := by
      rw [CharP.charP_iff_prime_eq_zero hℓ]
      have h1 : ((ℓ : ℕ) : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
        rw [← IsLocalRing.residue_eq_zero_iff, map_natCast, ← hκ]
        exact ringChar.Nat.cast_ringChar
      have h2 := h0 _ h1
      rwa [map_natCast, map_natCast] at h2
    have hfrac : ∀ r : R, ∃ b s : A, s ∉ 𝔭 ∧ φ s * r = φ b := by
      intro r
      obtain ⟨⟨b', s'⟩, hbs⟩ := IsLocalization.mk'_surjective (𝔭.map mk).primeCompl r
      obtain ⟨b, rfl⟩ := hmk b'
      obtain ⟨s, hs⟩ := hmk s'.1
      refine ⟨b, s, fun h => s'.2 (by rw [← hs]; exact (hmem s).mpr h), ?_⟩
      have := IsLocalization.mk'_spec R (mk b) s'
      simp only at hbs
      rw [hbs] at this
      show algebraMap _ R (mk s) * r = algebraMap _ R (mk b)
      rw [hs, mul_comm]
      exact this
    refine ⟨R, inferInstance, inferInstance, inferInstance, hchar, alg, φ,
      (Classical.choose hFT.out).image φ, h0, ?_, ?_, hfrac, ?_, ?_⟩
    · intro a ha
      exact (IsLocalization.AtPrime.to_map_mem_maximal_iff R (𝔭.map mk) (mk a)).mpr
        ((hmem a).mpr ha)
    · intro a ha
      exact (IsLocalization.AtPrime.isUnit_to_map_iff R (𝔭.map mk) (mk a)).mpr
        (fun h => ha ((hmem a).mp h))
    · intro a ha
      obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff (𝔭.map mk).primeCompl R (mk a)).mp ha
      obtain ⟨u, hu⟩ := hmk m.1
      refine ⟨u, fun h => m.2 (by rw [← hu]; exact (hmem u).mpr h), ?_⟩
      rw [← hu, ← map_mul] at hm
      exact Ideal.Quotient.eq_zero_iff_mem.mp hm
    · let φA : A →ₐ[↥W] R := { φ with commutes' := fun w => rfl }
      have hφA : ∀ a : A, φ a ∈ Algebra.adjoin ↥W
          (((Classical.choose hFT.out).image φ : Finset R) : Set R) := by
        intro a
        have h1 : a ∈ Algebra.adjoin ↥W ((Classical.choose hFT.out : Finset A) : Set A) := by
          rw [Classical.choose_spec hFT.out]; exact Algebra.mem_top
        have h2 : φA a ∈ (Algebra.adjoin ↥W
            ((Classical.choose hFT.out : Finset A) : Set A)).map φA :=
          Subalgebra.mem_map.mpr ⟨a, h1, rfl⟩
        rw [AlgHom.map_adjoin] at h2
        rw [Finset.coe_image]
        exact h2
      intro r
      obtain ⟨b, s, hs, hbs⟩ := hfrac r
      refine ⟨φ s, (IsLocalization.AtPrime.isUnit_to_map_iff R (𝔭.map mk) (mk s)).mpr
        (fun h => hs ((hmem s).mp h)), hφA s, ?_⟩
      rw [hbs]
      exact hφA b
  obtain ⟨R, _, _, _, _, _, φ, T, hφ0, hφmax, hφunit, hφfrac, hφker, hT⟩ := S1

  have hfin : Module.Finite (frobenius R ℓ).range R := by
    have hint : ∀ x ∈ (T : Set R), IsIntegral (frobenius R ℓ).range x := by
      intro x _
      refine ⟨Polynomial.X ^ ℓ - Polynomial.C ⟨x ^ ℓ, x, frobenius_def ℓ x⟩,
        Polynomial.monic_X_pow_sub_C _ hp0, ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
      exact sub_self _
    have hfg := fg_adjoin_of_finite T.finite_toSet hint
    have hsub : ∀ x ∈ Algebra.adjoin ↥W (T : Set R),
        x ∈ Algebra.adjoin (frobenius R ℓ).range (T : Set R) := by
      intro x hx
      induction hx using Algebra.adjoin_induction with
      | mem x hx => exact Algebra.subset_adjoin hx
      | algebraMap w =>
        obtain ⟨w', hw'⟩ := hroot w
        have : algebraMap ↥W R w = algebraMap (frobenius R ℓ).range R
            ⟨algebraMap ↥W R w' ^ ℓ, algebraMap ↥W R w', frobenius_def ℓ _⟩ := by
          show algebraMap ↥W R w = algebraMap ↥W R w' ^ ℓ
          rw [← map_pow, hw']
        rw [this]
        exact Subalgebra.algebraMap_mem _ _
      | add x y _ _ hx hy => exact Subalgebra.add_mem _ hx hy
      | mul x y _ _ hx hy => exact Subalgebra.mul_mem _ hx hy
    have htop : ∀ r : R, r ∈ Algebra.adjoin (frobenius R ℓ).range (T : Set R) := by
      intro r
      obtain ⟨s, hs, h1, h2⟩ := hT r
      obtain ⟨v, hv⟩ := hs.exists_left_inv
      obtain ⟨p', hp'⟩ : ∃ p', ℓ = p' + 1 := ⟨ℓ - 1, by omega⟩
      have e : r = algebraMap (frobenius R ℓ).range R ⟨v ^ ℓ, v, frobenius_def ℓ v⟩ *
          (s ^ p' * (s * r)) := by
        show r = v ^ ℓ * (s ^ p' * (s * r))
        have : (v * s) ^ ℓ = 1 := by rw [hv, one_pow]
        rw [mul_pow, hp', pow_succ] at this
        rw [hp', pow_succ]
        linear_combination -this * r
      rw [e]
      refine Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
        (Subalgebra.mul_mem _ ?_ (hsub _ h2))
      exact Subalgebra.pow_mem _ (hsub _ h1) _
    rw [Module.finite_def]
    have : Subalgebra.toSubmodule (Algebra.adjoin (frobenius R ℓ).range (T : Set R)) = ⊤ := by
      rw [eq_top_iff]
      intro r _
      exact htop r
    rw [← this]
    exact hfg

  have krull : ∀ τ : R, τ ∈ IsLocalRing.maximalIdeal R → ∀ x : R,
      (∀ i : ℕ, ∃ σ z : R, x = σ ^ ℓ + τ ^ (ℓ * i) * z) → ∃ σ : R, x = σ ^ ℓ := by
    intro τ hτ x hx
    haveI : IsNoetherianRing (frobenius R ℓ).range :=
      isNoetherianRing_of_surjective R _ (frobenius R ℓ).rangeRestrict
        (frobenius R ℓ).rangeRestrict_surjective
    let N : Submodule (frobenius R ℓ).range R :=
      LinearMap.range (Algebra.linearMap (frobenius R ℓ).range R)
    let τp : (frobenius R ℓ).range := ⟨τ ^ ℓ, ⟨τ, frobenius_def ℓ τ⟩⟩
    let I : Ideal (frobenius R ℓ).range := Ideal.span {τp}
    have hmem : (Submodule.Quotient.mk x : R ⧸ N) ∈
        ⨅ i, I ^ i • (⊤ : Submodule (frobenius R ℓ).range (R ⧸ N)) := by
      rw [Submodule.mem_iInf]
      intro i
      obtain ⟨σ, z, hxz⟩ := hx i
      have h1 : (Submodule.Quotient.mk x : R ⧸ N) = (τp ^ i) • Submodule.Quotient.mk z := by
        rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.eq]
        refine ⟨⟨σ ^ ℓ, σ, frobenius_def ℓ σ⟩, ?_⟩
        show σ ^ ℓ = x - ((τp ^ i : (frobenius R ℓ).range) : R) * z
        rw [SubmonoidClass.coe_pow, hxz, pow_mul]
        ring
      rw [h1]
      exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self _) i)
        Submodule.mem_top
    obtain ⟨⟨r, hr⟩, hrx⟩ := (Ideal.mem_iInf_smul_pow_eq_bot_iff I _).mp hmem
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hr
    obtain ⟨c, hc⟩ := a.2
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.eq] at hrx
    obtain ⟨⟨y, s, hs⟩, hy⟩ := hrx
    have hy' : s ^ ℓ = ((a : R) * τ ^ ℓ) * x - x := by
      rw [← frobenius_def ℓ s, hs]
      exact hy
    have hcτ : c * τ ∈ IsLocalRing.maximalIdeal R := Ideal.mul_mem_left _ c hτ
    have hu : IsUnit (1 - c * τ) := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ hcτ
    obtain ⟨v, hv⟩ := hu.exists_left_inv
    refine ⟨v * (0 - s), ?_⟩
    have ha : (a : R) = c ^ ℓ := by rw [← hc, frobenius_def]
    rw [mul_pow, sub_pow_char, hy', ha, zero_pow hp0]
    have e : (v * (1 - c * τ)) ^ ℓ = 1 := by rw [hv, one_pow]
    rw [mul_pow, sub_pow_char, one_pow, mul_pow] at e
    linear_combination -e * x

  have trunc : ∀ (τ : R) (P : Polynomial ↥W) (N : ℕ),
      (∀ j, j < N → ¬ ℓ ∣ j → P.coeff j ∈ IsLocalRing.maximalIdeal ↥W) →
      ∃ σ z : R, P.eval₂ (φ.comp (algebraMap ↥W A)) τ = σ ^ ℓ + τ ^ N * z := by
    intro τ P N hP
    have hterm : ∀ i, ∃ σ z : R, (φ.comp (algebraMap ↥W A)) (P.coeff i) * τ ^ i =
        σ ^ ℓ + τ ^ N * z := by
      intro i
      by_cases hiN : N ≤ i
      · refine ⟨0, (φ.comp (algebraMap ↥W A)) (P.coeff i) * τ ^ (i - N), ?_⟩
        rw [zero_pow hp0, zero_add, ← mul_assoc, mul_comm (τ ^ N), mul_assoc, ← pow_add,
          Nat.add_sub_cancel' hiN]
      · have hiN' : i < N := by omega
        by_cases hpi : ℓ ∣ i
        · obtain ⟨k, rfl⟩ := hpi
          obtain ⟨w', hw'⟩ := hroot (P.coeff (ℓ * k))
          refine ⟨(φ.comp (algebraMap ↥W A)) w' * τ ^ k, 0, ?_⟩
          rw [mul_zero, add_zero, mul_pow, ← map_pow, hw', ← pow_mul, mul_comm k ℓ]
        · refine ⟨0, 0, ?_⟩
          rw [RingHom.comp_apply, hφ0 _ (hP i hiN' hpi), zero_mul, zero_pow hp0, mul_zero,
            add_zero]
    choose σ z hσz using hterm
    refine ⟨∑ i ∈ Finset.range (P.natDegree + 1), σ i,
      ∑ i ∈ Finset.range (P.natDegree + 1), z i, ?_⟩
    rw [Polynomial.eval₂_eq_sum_range, sum_pow_char, Finset.mul_sum, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun i _ => hσz i)

  have cdiv : ∀ x ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A),
      ∃ π ∈ IsLocalRing.maximalIdeal ↥W, ∃ a' : A, x = algebraMap ↥W A π * a' := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨w, hw, rfl⟩ := hx
      exact ⟨w, hw, 1, (mul_one _).symm⟩
    | zero => exact ⟨0, Ideal.zero_mem _, 0, (mul_zero _).symm⟩
    | add x y _ _ hx hy =>
      obtain ⟨π₁, h₁, a₁, rfl⟩ := hx
      obtain ⟨π₂, h₂, a₂, rfl⟩ := hy
      rcases ValuationRing.dvd_total π₁ π₂ with ⟨c, hc⟩ | ⟨c, hc⟩
      · refine ⟨π₁, h₁, a₁ + algebraMap ↥W A c * a₂, ?_⟩
        rw [hc, map_mul]; ring
      · refine ⟨π₂, h₂, algebraMap ↥W A c * a₁ + a₂, ?_⟩
        rw [hc, map_mul]; ring
    | smul a x _ hx =>
      obtain ⟨π, h, a', rfl⟩ := hx
      exact ⟨π, h, a * a', by rw [smul_eq_mul]; ring⟩

  obtain ⟨n, a₀, ha₀⟩ := (T0 d₂ q).mp hLq
  obtain ⟨u₂, hu₂⟩ := (hφunit d₂ hd₂).exists_left_inv
  have hτ : φ t ∈ IsLocalRing.maximalIdeal R := hφmax t ht
  have hx : ∀ i : ℕ, ∃ σ z : R, u₂ ^ n * φ a₀ = σ ^ ℓ + φ t ^ (ℓ * i) * z := by
    intro i
    obtain ⟨P, d', y, hd', hy, hq⟩ :=
      wcLlsKP_vde_taylor Ω W A K 𝔭 t hPD 0 (Ideal.zero_mem _) q d₂ hd₂ hLq (ℓ * i)
    rw [map_zero, sub_zero] at hq
    obtain ⟨k, ay, hay⟩ := (T0 d' y).mp hy
    obtain ⟨σ, z, hσz⟩ := trunc (φ t) P (ℓ * i) (H P (ℓ * i) d' y hd' hy hq)
    obtain ⟨v, hv⟩ := (hφunit d' hd').exists_left_inv
    have hPA := Polynomial.hom_eval₂ P (algebraMap ↥W A) (algebraMap A K) t
    have hPR := Polynomial.hom_eval₂ P (algebraMap ↥W A) φ t
    have hA : a₀ * d' ^ k = d₂ ^ n * (P.eval₂ (algebraMap ↥W A) t * d' ^ k + t ^ (ℓ * i) * ay) := by
      apply IsFractionRing.injective A K
      simp only [map_mul, map_pow, map_add]
      rw [hPA, hay, ha₀, hq]
      ring
    have hR := congrArg φ hA
    simp only [map_mul, map_pow, map_add] at hR
    rw [hPR, hσz] at hR
    refine ⟨σ, z + φ ay * v ^ k, ?_⟩
    have hv' : v ^ k * φ d' ^ k = 1 := by rw [← mul_pow, hv, one_pow]
    have hu' : u₂ ^ n * φ d₂ ^ n = 1 := by rw [← mul_pow, hu₂, one_pow]
    linear_combination (u₂ ^ n * v ^ k) * hR +
      ((σ ^ ℓ + φ t ^ (ℓ * i) * z) * (u₂ ^ n * φ d₂ ^ n) - u₂ ^ n * φ a₀) * hv' +
      ((σ ^ ℓ + φ t ^ (ℓ * i) * z) + v ^ k * (φ t ^ (ℓ * i) * φ ay)) * hu'
  obtain ⟨σ', hσ'⟩ := krull (φ t) hτ _ hx
  have hu' : u₂ ^ n * φ d₂ ^ n = 1 := by rw [← mul_pow, hu₂, one_pow]
  have hx' : φ a₀ = φ d₂ ^ n * σ' ^ ℓ := by
    linear_combination (-(φ a₀)) * hu' + φ d₂ ^ n * hσ'
  obtain ⟨b, s, hs, hbs⟩ := hφfrac σ'
  have hk : φ (s ^ ℓ * a₀ - d₂ ^ n * b ^ ℓ) = 0 := by
    simp only [map_sub, map_mul, map_pow]
    rw [← hbs, hx']
    ring
  obtain ⟨u, hu, hum⟩ := hφker _ hk
  obtain ⟨π, hπ, a', hrel⟩ := cdiv _ hum
  have hs0 := hne0 s hs
  have hu0 := hne0 u hu
  have hd0 := hne0 d₂ hd₂
  apply hnp (algebraMap A K b / algebraMap A K s) (u * s * d₂)
    (hmul𝔭 _ _ (hmul𝔭 _ _ hu hs) hd₂)
  · refine (T0 _ _).mpr ⟨1, u * d₂ * b, ?_⟩
    simp only [map_mul, pow_one]
    field_simp
  · refine ⟨π, hπ, algebraMap A K a' / (algebraMap A K u * algebraMap A K s ^ ℓ *
      algebraMap A K d₂ ^ n), ?_, ?_⟩
    · obtain ⟨ℓ', hℓ'⟩ : ∃ ℓ', ℓ = ℓ' + 1 := ⟨ℓ - 1, by omega⟩
      refine (T0 _ _).mpr ⟨n + ℓ, u ^ (n + ℓ') * s ^ n * d₂ ^ ℓ * a', ?_⟩
      have hD : algebraMap A K u * algebraMap A K s ^ ℓ * algebraMap A K d₂ ^ n ≠ 0 :=
        mul_ne_zero (mul_ne_zero hu0 (pow_ne_zero _ hs0)) (pow_ne_zero _ hd0)
      rw [mul_div_assoc', eq_div_iff hD]
      simp only [map_mul, map_pow]
      rw [hℓ']
      ring
    · have hD : algebraMap A K u * algebraMap A K s ^ ℓ * algebraMap A K d₂ ^ n ≠ 0 :=
        mul_ne_zero (mul_ne_zero hu0 (pow_ne_zero _ hs0)) (pow_ne_zero _ hd0)
      rw [mul_div_assoc', eq_div_iff hD]
      have hbs' : (algebraMap A K b / algebraMap A K s) ^ ℓ * algebraMap A K s ^ ℓ =
          algebraMap A K b ^ ℓ := by
        rw [← mul_pow, div_mul_cancel₀ _ hs0]
      have hrelK := congrArg (algebraMap A K) hrel
      simp only [map_mul, map_sub, map_pow] at hrelK
      linear_combination (-(algebraMap A K u * algebraMap A K s ^ ℓ)) * ha₀ -
        (algebraMap A K u * algebraMap A K d₂ ^ n) * hbs' + hrelK

theorem wcLlsKP_nfb_fixed_centre_low : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (f₂ q : K) (γ₁ w : ↥W) (d₂ : A), d₂ ∉ 𝔭 → γ₁ ≠ 0 →
      wcLlsKPLoc A K 0 d₂ f₂ → wcLlsKPLoc A K 0 d₂ f₂⁻¹ → wcLlsKPLoc A K 0 d₂ q →
      f₂ - 1 = algebraMap A K (algebraMap ↥W A γ₁) ^ ℓ * q →
      w ∈ IsLocalRing.maximalIdeal ↥W → w ≠ 0 → ((ℓ : ℕ) : ↥W) = γ₁ ^ (ℓ - 1) * w →
      ∀ (P : Polynomial ↥W) (N : ℕ) (d' : A) (y : K) (j : ℕ), d' ∉ 𝔭 → wcLlsKPLoc A K 0 d' y →
        q = P.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K t) +
          algebraMap A K t ^ N * y →
        j < N → ¬ ℓ ∣ j → P.coeff j ∉ IsLocalRing.maximalIdeal ↥W →
      ∃ (h g : Polynomial ↥W) (γ w' : ↥W) (m₀ : ℕ) (d : A) (y₁ : K), d ∉ 𝔭 ∧ γ ≠ 0 ∧
        w' ∈ IsLocalRing.maximalIdeal ↥W ∧ w' ≠ 0 ∧ ((ℓ : ℕ) : ↥W) = γ ^ (ℓ - 1) * w' ∧
        IsUnit (h.coeff 0) ∧ g.coeff 0 = 0 ∧ g.coeff m₀ = 1 ∧ 1 ≤ m₀ ∧ ¬ ℓ ∣ m₀ ∧
        (∀ j, j < m₀ → g.coeff j ∈ IsLocalRing.maximalIdeal ↥W) ∧ wcLlsKPLoc A K 0 d y₁ ∧
        f₂ - (h.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K t)) ^ ℓ =
          algebraMap A K (algebraMap ↥W A γ) ^ ℓ *
            (g.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K t) +
              algebraMap A K t ^ (m₀ + 1) * y₁) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ 𝔭 t hPD f₂ q γ₁ w d₂ hd₂ hγ₁ hLf hLfi hLq hq
    hwm hw0 hpw P N d' y j hd' hy hqP hjN hpj hPj
  classical

  open Polynomial in
  have NF : ∀ (p : ℕ), p.Prime → ringChar (IsLocalRing.ResidueField ↥W) = p →
      ∀ (γ₁ w : ↥W) (P : Polynomial ↥W) (j : ℕ), ((p : ℕ) : ↥W) = γ₁ ^ (p - 1) * w →
      w ∈ IsLocalRing.maximalIdeal ↥W → ¬ p ∣ j → P.coeff j ∉ IsLocalRing.maximalIdeal ↥W →
      IsUnit (1 + γ₁ ^ p * P.coeff 0) →
      ∃ (h g : Polynomial ↥W) (σ : ↥W) (m₀ : ℕ), IsUnit σ ∧ IsUnit (h.coeff 0) ∧ 1 ≤ m₀ ∧
        m₀ ≤ j ∧ ¬ p ∣ m₀ ∧ g.coeff 0 = 0 ∧ g.coeff m₀ = 1 ∧
        (∀ i, i < m₀ → g.coeff i ∈ IsLocalRing.maximalIdeal ↥W) ∧
        1 + Polynomial.C (γ₁ ^ p) * P = h ^ p + Polynomial.C ((γ₁ * σ) ^ p) * g := by
    intro p hp hκ γ₁ w P j hpw hwm hpj hPj hc₀
    have hroot : ∀ (a : ↥W) (n : ℕ), 0 < n → ∃ r : ↥W, r ^ n = a := by
      intro a n hn
      obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (algebraMap ↥W Ω a) hn
      have hint : IsIntegral ↥W z := by
        refine ⟨X ^ n - C a, monic_X_pow_sub_C _ hn.ne', ?_⟩
        rw [eval₂_sub, eval₂_X_pow, eval₂_C, hz, sub_self]
      obtain ⟨r, hr⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥W) (K := Ω)).mp hint
      exact ⟨r, IsFractionRing.injective ↥W Ω (by rw [map_pow, hr, hz])⟩
    obtain ⟨lam, hlam⟩ := hroot (1 + γ₁ ^ p * P.coeff 0) p hp.pos
    have hlamu : IsUnit lam := (isUnit_pow_iff hp.ne_zero).mp (hlam ▸ hc₀)
    have hex : ∃ i, ¬ p ∣ i ∧ P.coeff i ∉ IsLocalRing.maximalIdeal ↥W := ⟨j, hpj, hPj⟩
    set m₀ := Nat.find hex with hm₀def
    have hm₀spec : ¬ p ∣ m₀ ∧ P.coeff m₀ ∉ IsLocalRing.maximalIdeal ↥W := Nat.find_spec hex
    have hm₀j : m₀ ≤ j := Nat.find_min' hex ⟨hpj, hPj⟩
    have hm₀min : ∀ i, i < m₀ → ¬ p ∣ i → P.coeff i ∈ IsLocalRing.maximalIdeal ↥W := by
      intro i hi hpi
      by_contra hc
      exact Nat.find_min hex hi ⟨hpi, hc⟩
    have hm₀1 : 1 ≤ m₀ := by
      rcases Nat.eq_zero_or_pos m₀ with h0 | h0
      · exact absurd (h0 ▸ dvd_zero p) hm₀spec.1
      · exact h0
    choose ρ hρ using fun k : ℕ => hroot (P.coeff (p * k)) p hp.pos
    set e : Polynomial ↥W := ∑ k ∈ Finset.Ico 1 m₀, C (ρ k) * X ^ k with he
    have hecoeff : ∀ i, e.coeff i = if i ∈ Finset.Ico 1 m₀ then ρ i else 0 := by
      intro i
      rw [he, finsetSum_coeff]
      simp only [coeff_C_mul_X_pow]
      rw [Finset.sum_ite_eq]
    have he0 : e.coeff 0 = 0 := by
      rw [hecoeff]; simp
    have hev0 : e.eval 0 = 0 := by rw [← coeff_zero_eq_eval_zero, he0]
    obtain ⟨n, hn⟩ : ∃ n, p = n + 2 := ⟨p - 2, by have := hp.two_le; omega⟩
    set E : Polynomial ↥W := ∑ r ∈ Finset.range (n + 1),
      C (((p.choose (r + 1) / p : ℕ) : ↥W) * γ₁ ^ r * lam ^ (p - (r + 1))) * e ^ (r + 1) with hE
    have hbin : (C lam + C γ₁ * e) ^ p = C (lam ^ p) + C (γ₁ ^ p) * (e ^ p + C w * E) := by
      have hterm : ∀ m ∈ Finset.range (n + 1),
          (C γ₁ * e) ^ (m + 1) * C lam ^ (p - (m + 1)) * ((p.choose (m + 1) : ℕ) : Polynomial ↥W) =
            C (γ₁ ^ p) * (C w * (C (((p.choose (m + 1) / p : ℕ) : ↥W) * γ₁ ^ m *
              lam ^ (p - (m + 1))) * e ^ (m + 1))) := by
        intro m hm
        rw [Finset.mem_range] at hm
        have hdvd : p ∣ p.choose (m + 1) := hp.dvd_choose_self (by omega) (by omega)
        have hcast : ((p.choose (m + 1) : ℕ) : ↥W) =
            ((p.choose (m + 1) / p : ℕ) : ↥W) * γ₁ ^ (n + 1) * w := by
          rw [mul_assoc, ← (show p - 1 = n + 1 by omega), ← hpw, ← Nat.cast_mul,
            Nat.div_mul_cancel hdvd]
        have hc : ((p.choose (m + 1) : ℕ) : Polynomial ↥W) =
            C (((p.choose (m + 1) / p : ℕ) : ↥W) * γ₁ ^ (n + 1) * w) := by
          rw [← hcast, map_natCast]
        rw [hc, hn]
        simp only [map_mul, map_pow, mul_pow]
        ring
      have hsum : ∑ m ∈ Finset.range (n + 1),
          (C γ₁ * e) ^ (m + 1) * C lam ^ (p - (m + 1)) * ((p.choose (m + 1) : ℕ) : Polynomial ↥W) =
            C (γ₁ ^ p) * (C w * E) := by
        rw [Finset.sum_congr rfl hterm, ← Finset.mul_sum, ← Finset.mul_sum]
      rw [add_comm, add_pow, show p + 1 = n + 1 + 1 + 1 by omega, Finset.sum_range_succ,
        Finset.sum_range_succ', hsum, show n + 1 + 1 = p by omega, Nat.sub_self, Nat.choose_self,
        Nat.sub_zero, Nat.choose_zero_right]
      simp only [pow_zero, Nat.cast_one, mul_one, one_mul, mul_pow, map_pow]
      ring
    set G : Polynomial ↥W := P - C (P.coeff 0) - e ^ p - C w * E with hG
    have hId : 1 + C (γ₁ ^ p) * P = (C lam + C γ₁ * e) ^ p + C (γ₁ ^ p) * G := by
      rw [hbin, hlam, hG]
      simp only [map_add, map_one, map_mul, map_pow]
      ring
    haveI : Fact p.Prime := ⟨hp⟩
    haveI : CharP (IsLocalRing.ResidueField ↥W) p := ringChar.of_eq hκ
    have hfrob : ∀ (f : Polynomial ↥W) (i : ℕ), IsLocalRing.residue ↥W ((f ^ p).coeff i) =
        if p ∣ i then IsLocalRing.residue ↥W (f.coeff (i / p)) ^ p else 0 := by
      intro f i
      rw [← coeff_map, Polynomial.map_pow, ← map_frobenius_expand, coeff_map, coeff_expand hp.pos]
      split_ifs
      · rw [coeff_map, frobenius_def]
      · exact map_zero _
    have hEv0 : E.eval 0 = 0 := by
      rw [hE, eval_finset_sum]
      simp [hev0]
    have hG0 : G.coeff 0 = 0 := by
      rw [coeff_zero_eq_eval_zero, hG]
      simp only [eval_sub, eval_mul, eval_C, eval_pow, hev0, hEv0, ← coeff_zero_eq_eval_zero]
      simp [hp.ne_zero]
    have hres_w : IsLocalRing.residue ↥W w = 0 := (IsLocalRing.residue_eq_zero_iff w).mpr hwm
    have hGres : ∀ i, 1 ≤ i → IsLocalRing.residue ↥W (G.coeff i) =
        IsLocalRing.residue ↥W (P.coeff i) - IsLocalRing.residue ↥W ((e ^ p).coeff i) := by
      intro i hi
      rw [hG, coeff_sub, coeff_sub, coeff_sub, coeff_C_mul, coeff_C, if_neg (by omega)]
      simp only [map_sub, map_mul, hres_w, zero_mul, sub_zero]
    have hGlow : ∀ i, i < m₀ → G.coeff i ∈ IsLocalRing.maximalIdeal ↥W := by
      intro i hi
      rcases Nat.eq_zero_or_pos i with h0 | h0
      · rw [h0, hG0]; exact Ideal.zero_mem _
      rw [← IsLocalRing.residue_eq_zero_iff, hGres i h0, hfrob]
      split_ifs with hdvd
      · obtain ⟨k, hk⟩ := hdvd
        have hk1 : 1 ≤ k := by
          rcases Nat.eq_zero_or_pos k with h | h
          · rw [h, mul_zero] at hk; omega
          · exact h
        have hki : k ≤ i := by rw [hk]; exact Nat.le_mul_of_pos_left k hp.pos
        rw [hk, Nat.mul_div_cancel_left k hp.pos, hecoeff,
          if_pos (Finset.mem_Ico.mpr ⟨hk1, by omega⟩), ← map_pow, hρ, sub_self]
      · rw [sub_zero]
        exact (IsLocalRing.residue_eq_zero_iff _).mpr (hm₀min i hi hdvd)
    have hGm : IsUnit (G.coeff m₀) := by
      apply IsLocalRing.notMem_maximalIdeal.mp
      rw [← IsLocalRing.residue_eq_zero_iff, hGres m₀ hm₀1, hfrob, if_neg hm₀spec.1, sub_zero,
        IsLocalRing.residue_eq_zero_iff]
      exact hm₀spec.2
    obtain ⟨σ, hσ⟩ := hroot (G.coeff m₀) p hp.pos
    have hσu : IsUnit σ := (isUnit_pow_iff hp.ne_zero).mp (hσ ▸ hGm)
    set υ' : ↥W := ↑(hGm.unit⁻¹) with hυ'
    have hυυ' : υ' * G.coeff m₀ = 1 := hGm.val_inv_mul
    refine ⟨C lam + C γ₁ * e, C υ' * G, σ, m₀, hσu, ?_, hm₀1, hm₀j, hm₀spec.1, ?_, ?_, ?_, ?_⟩
    · rw [coeff_add, coeff_C_zero, coeff_C_mul, he0, mul_zero, add_zero]; exact hlamu
    · rw [coeff_C_mul, hG0, mul_zero]
    · rw [coeff_C_mul, hυυ']
    · intro i hi
      rw [coeff_C_mul]
      exact Ideal.mul_mem_left _ _ (hGlow i hi)
    · rw [hId, mul_pow, hσ]
      have : C (γ₁ ^ p * G.coeff m₀) * (C υ' * G) = C (γ₁ ^ p) * (C (υ' * G.coeff m₀)) * G := by
        simp only [map_mul]; ring
      rw [this, hυυ', map_one, mul_one]


  have SF : (∀ a b : A, a * b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      ∃ s : A, s ∉ 𝔭 ∧ (s * a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ∨
        s * b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A))) ∧
      (∀ s : A, s ∉ 𝔭 → s * t ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) := by
    have chart : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
        (A : Type u) [CommRing A] [Algebra ↥W A] (𝔭 : Ideal A) [𝔭.IsPrime] (h : A)
        (S : Type u) [CommRing S] [Algebra ↥W S] (f₀ : S →+* Localization.Away h)
        (P : Type u) [CommRing P] (π : S →+* P),
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 → h ∉ 𝔭 →
        f₀.comp (algebraMap ↥W S) =
          (algebraMap A (Localization.Away h)).comp (algebraMap ↥W A) →
        RingHom.Etale f₀ → Function.Surjective π →
        RingHom.ker π = (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W S) →
        ∃ (E : Type u) (_ : CommRing E) (fb : P →+* E)
          (ρ : Localization.Away h →+* E) (q : Ideal E) (_ : q.IsPrime),
          RingHom.Etale fb ∧ Function.Surjective ρ ∧
          RingHom.ker ρ = ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
            (algebraMap A (Localization.Away h)) ∧
          (∀ s, fb (π s) = ρ (f₀ s)) ∧
          q = (𝔭.map (algebraMap A (Localization.Away h))).map ρ ∧
