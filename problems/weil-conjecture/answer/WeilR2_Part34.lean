    intro y hy
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, he₂.2.1, not_not]; exact hy
  have hσQm : ∀ x ∈ IsLocalRing.maximalIdeal ↥W,
      σQ x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime Q) := by
    intro x hx
