      rw [eq_sub_of_add_eq hdec.symm]
      exact M.sub_mem hr (M.mul_mem_right _ (hNM' hsN))
    have hc' : p.coeff 0 ∈ 𝔭 := by rw [← hP]; exact hc
    rw [hdec]
    exact Nb.add_mem (h𝔭N hc') (Nb.mul_mem_right _ hsN)
  refine ⟨Ideal.comap J 𝔮, inferInstance, ?_, fun y => ⟨J y, rfl, Iff.rfl⟩⟩
  rw [hQM]
  exact hrigid _ hNM hMt

theorem wcpa_dj_llsm_isir_ann_branch_condition : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
