  have hRP : ∀ r : ↥(Algebra.adjoin A {wcLlsScS W A K t c b}), ∃ x : P, algebraMap P L x = algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L r :=
    fun r => ⟨ρ r, hρL r⟩
  have hgenR := wcLlsKPas_generation A K L ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) P (algebraMap A _) w (fun a => by rw [hRL, hRK])
    hRP hgen
  have H4 : ∀ l : L, ∃ x y : AdjoinRoot FP, j₀ y ≠ 0 ∧ l * j₀ y = j₀ x := by
    intro l
    obtain ⟨y, G', hy, hyG⟩ := hgenR l
    refine ⟨AdjoinRoot.mk FP G', AdjoinRoot.of FP (ρ y), ?_, ?_⟩
    · rw [hj₀of, hρL]; exact hy
    · rw [hj₀of, hρL, hj₀mk]; exact hyG
  have H5 : ∀ r : ↥(Algebra.adjoin A {wcLlsScS W A K t c b}), ∃ x : AdjoinRoot FP, j₀ x = algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L r :=
    fun r => ⟨AdjoinRoot.of FP (ρ r), by rw [hj₀of, hρL]⟩
  obtain ⟨N, hN⟩ := wcLlsKPas_scaled_integral ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) P L (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (h * d)) w FP hFPmon
    hFPw hT6L
  have hg𝔮 : algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L) (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (h * d)) ∉ 𝔮 := hA _ hhd
  have H6 : ∀ x : AdjoinRoot FP, ∃ z s : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L), s ∉ 𝔮 ∧ j₀ x * (s : L) = (z : L) := by
    intro x
    obtain ⟨q, rfl⟩ := AdjoinRoot.mk_surjective x
    obtain ⟨M, hM⟩ := hS6 ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) P L (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (h * d)) w N hT6L hN q
    refine ⟨⟨Polynomial.aeval w q * algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (h * d)) ^ M, hM⟩,
      algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L) (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (h * d)) ^ M, ?_, ?_⟩
    · intro hmem
      exact hg𝔮 ((inferInstance : 𝔮.IsPrime).mem_of_pow_mem M hmem)
    · rw [hj₀mk, SubmonoidClass.coe_pow]
      rfl

  obtain ⟨Q, hQ, j, φ, hQm, hQτ, hj, hφ, hφW, hjgen, hjR, hjB⟩ :=
    hS8 Ω W ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L 𝔮 ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A)) (AdjoinRoot FP) ((AdjoinRoot.of FP).comp ψP) j₀ hj₀inj hm H3 H4 H5 H6
  have hmC : (IsLocalRing.maximalIdeal ↥W).map ((AdjoinRoot.of FP).comp (ψP.comp Polynomial.C)) ≤ Q :=
    Ideal.map_le_iff_le_comap.mpr (fun π hπ => hQm π hπ)
  have hzz : algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L) ((⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ : ↥(Algebra.adjoin A {wcLlsScS W A K t c b})) - algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (algebraMap ↥W A e)) ∈ 𝔮 := by
    have h1 : (⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ : ↥(Algebra.adjoin A {wcLlsScS W A K t c b})) - algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (algebraMap ↥W A e) ∈ 𝔮.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)) := by
      rw [h𝔮]
      exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton _))
    exact h1
  have hXe : AdjoinRoot.of FP (ψP (Polynomial.X - Polynomial.C e)) ∈ Q := by
    apply hQτ _ _ hzz
    rw [hj₀of, map_sub, hT2X, hT2, ← map_sub, hρL]
    rfl
  exact ⟨P, iP1, iP2, ψP, FP, Q, hQ, j, φ, hψPet, hPF1, hPF2, hFPmon, hFPdeg, hFPmid, hFP0,
    hBez, hCdom, hmC, hXe, hj, hφ, hφW, hjgen, hjR, hjB⟩

theorem wcLlsKPan_fibre_prime : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (p : ℕ), p.Prime → ringChar (IsLocalRing.ResidueField ↥W) = p → ∀ (P : Type u) [CommRing P] (ψ : Polynomial ↥W →+* P), (∀ x : P, ∃ f : Polynomial ↥W, x - ψ f ∈ (IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C)) → (∀ f : Polynomial ↥W, ψ f ∈ (IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C) → ∀ i, f.coeff i ∈ IsLocalRing.maximalIdeal ↥W) → ∀ (FP : Polynomial P) (G : Polynomial ↥W), FP.Monic → FP.natDegree = p → (∀ i, 1 ≤ i → i < p → FP.coeff i ∈ (IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C)) → FP.coeff 0 + ψ G ∈ (IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C) → (∃ j, (Polynomial.derivative G).coeff j ∉ IsLocalRing.maximalIdeal ↥W) → ((IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C)).IsPrime ∧ ((IsLocalRing.maximalIdeal ↥W).map ((AdjoinRoot.of FP).comp (ψ.comp Polynomial.C))).IsPrime ∧ ∀ q : Polynomial P, (AdjoinRoot.mk FP q ∈ (IsLocalRing.maximalIdeal ↥W).map ((AdjoinRoot.of FP).comp (ψ.comp Polynomial.C)) ↔ ∀ i, (q %ₘ FP).coeff i ∈ (IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C)) :=
by

  have s1 : ∀ (k : Type u) [Field k] (p : ℕ), p.Prime → ringChar k = p → ∀ g : Polynomial k,
      Polynomial.derivative g ≠ 0 →
      Prime (Polynomial.X ^ p - Polynomial.C g : Polynomial (Polynomial k)) := by
    intro k _ p hp hk g hg
    classical
    haveI : CharP k p := ringChar.of_eq hk
    have hmon : (Polynomial.X ^ p - Polynomial.C g : Polynomial (Polynomial k)).Monic :=
      Polynomial.monic_X_pow_sub_C g hp.ne_zero
    rw [← UniqueFactorizationMonoid.irreducible_iff_prime]
    rw [hmon.irreducible_iff_irreducible_map_fraction_map (K := FractionRing (Polynomial k))]
    simp only [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]
    apply X_pow_sub_C_irreducible_of_prime hp
    intro b hb
    have hint : _root_.IsIntegral (Polynomial k) b := by
      refine ⟨Polynomial.X ^ p - Polynomial.C g, hmon, ?_⟩
      simp [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hb]
    obtain ⟨h, hh⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    have hhp : h ^ p = g := by
      apply IsFractionRing.injective (Polynomial k) (FractionRing (Polynomial k))
      rw [map_pow, hh, hb]
    apply hg
    rw [← hhp, Polynomial.derivative_pow]
    simp

  have s2 : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (P : Type u) [CommRing P]
      (ψ : Polynomial ↥W →+* P),
      (∀ x : P, ∃ f : Polynomial ↥W, x - ψ f ∈ (IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C)) →
      (∀ f : Polynomial ↥W, ψ f ∈ (IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C) →
        ∀ i, f.coeff i ∈ IsLocalRing.maximalIdeal ↥W) →
      ∃ θ : P →+* Polynomial (IsLocalRing.ResidueField ↥W),
        (∀ f : Polynomial ↥W, θ (ψ f) = f.map (IsLocalRing.residue ↥W)) ∧
        ∀ x : P, θ x = 0 ↔ x ∈ (IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C) := by
    intro Ω _ W P _ ψ hPF1 hPF2
    set mP := (IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C) with hmP
    set ρ : Polynomial ↥W →+* P ⧸ mP := (Ideal.Quotient.mk mP).comp ψ with hρ
    have hρs : Function.Surjective ρ := by
      intro y
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨f, hf⟩ := hPF1 x
      exact ⟨f, (Ideal.Quotient.eq.mpr hf).symm⟩
    set r : Polynomial ↥W →+* Polynomial (IsLocalRing.ResidueField ↥W) :=
      Polynomial.mapRingHom (IsLocalRing.residue ↥W) with hr
    have hrs : Function.Surjective r := Polynomial.map_surjective _ IsLocalRing.residue_surjective
    have hker : RingHom.ker ρ = RingHom.ker r := by
      ext f
      rw [RingHom.mem_ker, RingHom.mem_ker]
      constructor
      · intro hf
        have h1 : ψ f ∈ mP := Ideal.Quotient.eq_zero_iff_mem.mp hf
        have h2 := hPF2 f h1
        ext i
        simp [hr, Polynomial.coeff_map, IsLocalRing.residue_eq_zero_iff, h2 i]
      · intro hf
        have h2 : ∀ i, f.coeff i ∈ IsLocalRing.maximalIdeal ↥W := by
          intro i
          have := congrArg (fun q => Polynomial.coeff q i) hf
          simpa [hr, Polynomial.coeff_map, IsLocalRing.residue_eq_zero_iff] using this
        have h3 : f ∈ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :=
          Ideal.mem_map_C_iff.mpr h2
        have h4 := Ideal.mem_map_of_mem ψ h3
        rw [Ideal.map_map] at h4
        exact Ideal.Quotient.eq_zero_iff_mem.mpr h4
    let e : P ⧸ mP ≃+* Polynomial (IsLocalRing.ResidueField ↥W) :=
      ((RingHom.quotientKerEquivOfSurjective hρs).symm.trans (Ideal.quotEquivOfEq hker)).trans
        (RingHom.quotientKerEquivOfSurjective hrs)
    refine ⟨e.toRingHom.comp (Ideal.Quotient.mk mP), ?_, ?_⟩
    · intro f
      show (RingHom.quotientKerEquivOfSurjective hrs) ((Ideal.quotEquivOfEq hker)
        ((RingHom.quotientKerEquivOfSurjective hρs).symm (ρ f))) = r f
      have h1 : (RingHom.quotientKerEquivOfSurjective hρs).symm (ρ f) = Ideal.Quotient.mk _ f := by
        rw [RingEquiv.symm_apply_eq]; rfl
      rw [h1, Ideal.quotEquivOfEq_mk, RingHom.quotientKerEquivOfSurjective_apply_mk]
    · intro x
      show e (Ideal.Quotient.mk mP x) = 0 ↔ x ∈ mP
      rw [map_eq_zero_iff e e.injective, Ideal.Quotient.eq_zero_iff_mem]

  have s3 : ∀ (P : Type u) [CommRing P] (S : Type u) [CommRing S] (θ : P →+* S) (I : Ideal P)
      (FP : Polynomial P), FP.Monic → (∀ x : P, θ x = 0 ↔ x ∈ I) → Prime (FP.map θ) →
      (I.map (AdjoinRoot.of FP)).IsPrime ∧ ∀ q : Polynomial P,
        (AdjoinRoot.mk FP q ∈ I.map (AdjoinRoot.of FP) ↔ ∀ i, (q %ₘ FP).coeff i ∈ I) := by
    intro P _ S _ θ I FP hFP hθ hpr
    classical
    set Fb := FP.map θ with hFb
    have hFbm : Fb.Monic := hFP.map θ
    haveI : IsDomain (AdjoinRoot Fb) := AdjoinRoot.isDomain_of_prime hpr
    have hlift : Polynomial.eval₂ ((AdjoinRoot.of Fb).comp θ) (AdjoinRoot.root Fb) FP = 0 := by
      rw [← Polynomial.eval₂_map, AdjoinRoot.eval₂_root]
    set Θ : AdjoinRoot FP →+* AdjoinRoot Fb :=
      AdjoinRoot.lift ((AdjoinRoot.of Fb).comp θ) (AdjoinRoot.root Fb) hlift with hΘ
    have hstar : ∀ q : Polynomial P, Θ (AdjoinRoot.mk FP q) = AdjoinRoot.mk Fb (q.map θ) := by
      intro q
      rw [hΘ, AdjoinRoot.lift_mk, ← Polynomial.eval₂_map, ← AdjoinRoot.aeval_eq,
        Polynomial.aeval_def]
      rfl
    have hkey : ∀ q : Polynomial P, Θ (AdjoinRoot.mk FP q) = 0 ↔ ∀ i, (q %ₘ FP).coeff i ∈ I := by
      intro q
      rw [hstar, AdjoinRoot.mk_eq_zero, ← Polynomial.modByMonic_eq_zero_iff_dvd hFbm, hFb,
        ← Polynomial.map_modByMonic θ hFP, Polynomial.ext_iff]
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero]
      exact forall_congr' (fun i => hθ _)
    have hle : I.map (AdjoinRoot.of FP) ≤ RingHom.ker Θ := by
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, RingHom.mem_ker, hΘ, AdjoinRoot.lift_of, RingHom.comp_apply,
        (hθ x).mpr hx, map_zero]
    have hback : ∀ q : Polynomial P, (∀ i, (q %ₘ FP).coeff i ∈ I) →
        AdjoinRoot.mk FP q ∈ I.map (AdjoinRoot.of FP) := by
      intro q hq
      have h1 : AdjoinRoot.mk FP q = AdjoinRoot.mk FP (q %ₘ FP) := by
        rw [AdjoinRoot.mk_eq_mk]
        have h := Polynomial.modByMonic_add_div q FP
        exact ⟨q /ₘ FP, by linear_combination -h⟩
      rw [h1, (q %ₘ FP).as_sum_range_C_mul_X_pow, map_sum]
      refine Ideal.sum_mem _ (fun i _ => ?_)
      rw [map_mul, map_pow, AdjoinRoot.mk_C, AdjoinRoot.mk_X]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (hq i))
    have hcrit : ∀ q : Polynomial P,
        (AdjoinRoot.mk FP q ∈ I.map (AdjoinRoot.of FP) ↔ ∀ i, (q %ₘ FP).coeff i ∈ I) :=
      fun q => ⟨fun h => (hkey q).mp (hle h), hback q⟩
    refine ⟨?_, hcrit⟩
    have heq : I.map (AdjoinRoot.of FP) = RingHom.ker Θ := by
      refine le_antisymm hle (fun c hc => ?_)
      obtain ⟨q, rfl⟩ := AdjoinRoot.mk_surjective c
      exact hback q ((hkey q).mp hc)
    rw [heq]
    exact RingHom.ker_isPrime Θ

  intro Ω _ W p hp hκ P _ ψ hPF1 hPF2 FP G hmon hdeg hmid hc0 hG'
  obtain ⟨θ, hθψ, hθker⟩ := s2 Ω W P ψ hPF1 hPF2
  have hmP : ((IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C)).IsPrime := by
    have : (IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C) = RingHom.ker θ := by
      ext x; rw [RingHom.mem_ker, hθker]
    rw [this]; exact RingHom.ker_isPrime θ
  have hp2 := hp.two_le
  have hred : FP.map θ = Polynomial.X ^ p - Polynomial.C (G.map (IsLocalRing.residue ↥W)) := by
    refine Polynomial.ext (fun n => ?_)
    rw [Polynomial.coeff_map, Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C]
    rcases Nat.eq_zero_or_pos n with h0 | hpos
    · subst h0
      have h1 : θ (FP.coeff 0 + ψ G) = 0 := (hθker _).mpr hc0
      rw [map_add, hθψ] at h1
      rw [if_neg (by omega), if_pos rfl, zero_sub]
      exact eq_neg_of_add_eq_zero_left h1
    · rcases lt_trichotomy n p with hlt | heq | hgt
      · rw [(hθker _).mpr (hmid n hpos hlt), if_neg (by omega), if_neg (by omega), sub_zero]
      · have hc : FP.coeff n = 1 := by rw [heq, ← hdeg]; exact hmon.coeff_natDegree
        rw [hc, map_one, if_pos heq, if_neg (by omega), sub_zero]
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), map_zero, if_neg (by omega),
          if_neg (by omega), sub_zero]
  have hGb' : Polynomial.derivative (G.map (IsLocalRing.residue ↥W)) ≠ 0 := by
    obtain ⟨j, hj⟩ := hG'
    intro h
    apply hj
    have := congrArg (fun q => Polynomial.coeff q j) h
    simp only [Polynomial.derivative_map, Polynomial.coeff_map, Polynomial.coeff_zero] at this
    exact (IsLocalRing.residue_eq_zero_iff _).mp this
  have hprime : Prime (FP.map θ) := by
    rw [hred]; exact s1 _ p hp hκ _ hGb'
  obtain ⟨hJ, hcrit⟩ := s3 P _ θ _ FP hmon hθker hprime
  have hmapeq : ((IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C)).map (AdjoinRoot.of FP) =
      (IsLocalRing.maximalIdeal ↥W).map ((AdjoinRoot.of FP).comp (ψ.comp Polynomial.C)) :=
    Ideal.map_map _ _
  rw [hmapeq] at hJ hcrit
  exact ⟨hmP, hJ, hcrit⟩

theorem wcLlsKPan_base_regular : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (P : Type u) [CommRing P] [IsDomain P] (ψ : Polynomial ↥W →+* P), RingHom.Etale ψ → (∀ x : P, ∃ f : Polynomial ↥W, x - ψ f ∈ (IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C)) → (∀ f : Polynomial ↥W, ψ f ∈ (IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C) → ∀ i, f.coeff i ∈ IsLocalRing.maximalIdeal ↥W) → ∀ (s d e : P) (a : ↥W), s ∉ (IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C) → s * d = ψ (Polynomial.C a) * e → ∃ d' : P, d = ψ (Polynomial.C a) * d' :=
by
  intro Ω _ W hW P _ _ ψ hψ hPF1 _ s d e a hs hsde
  classical
  by_cases ha : a = 0
  · subst ha
    refine ⟨0, ?_⟩
    have hs0 : s ≠ 0 := fun h => hs (h ▸ Submodule.zero_mem _)
    rw [map_zero, map_zero, zero_mul] at hsde
    rw [mul_zero]
    exact (mul_eq_zero.mp hsde).resolve_left hs0

  have hrad : IsLocalRing.maximalIdeal ↥W ≤ (Ideal.span {a}).radical := by
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
    rw [Ideal.radical_eq_sInf]
    intro x hx
    rw [Submodule.mem_sInf]
    rintro J ⟨hJa, hJp⟩
    have hJne : J ≠ ⊥ := by
      intro h
      apply ha
      have h1 : a ∈ J := hJa (Ideal.subset_span rfl)
      rw [h] at h1
      exact Ideal.mem_bot.mp h1
    have hJmax := (Ring.krullDimLE_one_iff_of_isPrime_bot.mp inferInstance) J hJne hJp
    rw [IsLocalRing.eq_maximalIdeal hJmax]
    exact hx
  obtain ⟨f, hf⟩ := hPF1 s
  have hz : s - ψ f ∈ (Ideal.span {ψ (Polynomial.C a)}).radical := by
    have h1 : (IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C) ≤
        (Ideal.span {a}).radical.map (ψ.comp Polynomial.C) := Ideal.map_mono hrad
    have h2 := Ideal.map_radical_le (ψ.comp Polynomial.C) (I := Ideal.span {a})
    rw [Ideal.map_span, Set.image_singleton] at h2
    exact h2 (h1 hf)
  obtain ⟨M, hM⟩ := Ideal.mem_radical_iff.mp hz
  obtain ⟨w, hw⟩ := Ideal.mem_span_singleton.mp hM

  have hfunit : ∃ j, IsUnit (f.coeff j) := by
    by_contra hcon
    push_neg at hcon
    apply hs
    have hfm : f ∈ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :=
      Ideal.mem_map_C_iff.mpr (fun n => by
        by_contra hn
        exact hcon n (IsLocalRing.notMem_maximalIdeal.mp hn))
    have h1 : ψ f ∈ (IsLocalRing.maximalIdeal ↥W).map (ψ.comp Polynomial.C) := by
      have := Ideal.mem_map_of_mem ψ hfm
      rwa [Ideal.map_map] at this
    have h2 := Ideal.add_mem _ h1 hf
    have h3 : ψ f + (s - ψ f) = s := by ring
    rwa [h3] at h2
  obtain ⟨j₀, hj₀⟩ := hfunit

  obtain ⟨t, ht⟩ := sub_dvd_pow_sub_pow (ψ f) (-(s - ψ f)) M
  have hs' : ψ f - -(s - ψ f) = s := by ring
  rw [hs', neg_pow, hw] at ht
  have key : ψ (f ^ M) * d = ψ (Polynomial.C a) * (t * e + (-1) ^ M * w * d) := by
    rw [map_pow]
    linear_combination d * ht + t * hsde

  letI := ψ.toAlgebra
  haveI : Algebra.Etale (Polynomial ↥W) P := hψ
  have hrel : ∑ i, (![f ^ M, -Polynomial.C a] : Fin 2 → Polynomial ↥W) i •
      (![d, t * e + (-1) ^ M * w * d] : Fin 2 → P) i = 0 := by
    rw [Fin.sum_univ_two]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Algebra.smul_def,
      RingHom.algebraMap_toAlgebra, map_neg]
    rw [key]; ring
  haveI hflat : Module.Flat (Polynomial ↥W) P := inferInstance
  obtain ⟨k, A, y, hx, hA⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
    (R := Polynomial ↥W) (M := P) hrel

  set π := Ideal.Quotient.mk (Ideal.span {a}) with hπ
  have hnz : f.map π ∈ nonZeroDivisors (Polynomial (↥W ⧸ Ideal.span {a})) := by
    by_contra hcon
    obtain ⟨c, hc0, hc⟩ := Polynomial.notMem_nonZeroDivisors_iff.mp hcon
    apply hc0
    have h1 := congrArg (fun q => Polynomial.coeff q j₀) hc
    simp only [Polynomial.coeff_smul, Polynomial.coeff_map, smul_eq_mul,
      Polynomial.coeff_zero] at h1
    exact (IsUnit.mul_left_eq_zero (hj₀.map π)).mp h1
  have hnzM : (f ^ M).map π ∈ nonZeroDivisors (Polynomial (↥W ⧸ Ideal.span {a})) := by
    rw [Polynomial.map_pow]
    exact pow_mem hnz M
  have hdvd : ∀ j, Polynomial.C a ∣ A 0 j := by
    intro j
    have h1 := hA j
    rw [Fin.sum_univ_two] at h1
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at h1
    have h2 := congrArg (Polynomial.map π) h1
    rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_neg,
      Polynomial.map_C, Polynomial.map_zero] at h2
    have hπa : π a = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    rw [hπa, map_zero, neg_zero, zero_mul, add_zero, mul_comm] at h2
    have h3 : (A 0 j).map π = 0 := (mul_right_mem_nonZeroDivisors_eq_zero_iff hnzM).mp h2
    rw [Polynomial.C_dvd_iff_dvd_coeff]
    intro i
    have h4 := congrArg (fun q => Polynomial.coeff q i) h3
    simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h4
    exact Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp h4)
  choose b hb using hdvd
  refine ⟨∑ j, ψ (b j) * y j, ?_⟩
  have hd := hx 0
  simp only [Matrix.cons_val_zero, Algebra.smul_def, RingHom.algebraMap_toAlgebra] at hd
  rw [hd, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [hb j, map_mul, mul_assoc]

theorem wcLlsKPan_norm_regular : ∀ (P : Type u) [CommRing P] (FP : Polynomial P) (I : Ideal P), FP.Monic → I.IsPrime → (I.map (AdjoinRoot.of FP)).IsPrime → (∀ q : Polynomial P, (AdjoinRoot.mk FP q ∈ I.map (AdjoinRoot.of FP) ↔ ∀ i, (q %ₘ FP).coeff i ∈ I)) → ∀ a : P, (∀ s d e : P, s ∉ I → s * d = a * e → ∃ d' : P, d = a * d') → ∀ s d e : AdjoinRoot FP, s ∉ I.map (AdjoinRoot.of FP) → s * d = AdjoinRoot.of FP a * e → ∃ d' : AdjoinRoot FP, d = AdjoinRoot.of FP a * d' :=
by
  intro P _ FP I hmon hI hJ hcrit a ha s d e hs hsde
  classical
  have : I.IsPrime := hI
  have : Nontrivial P := by
    refine ⟨⟨0, 1, fun h => hI.ne_top ?_⟩⟩
    rw [Ideal.eq_top_iff_one, ← h]
    exact I.zero_mem

  have hcoord : ∀ y : AdjoinRoot FP, y ∈ I.map (AdjoinRoot.of FP) ↔
      ∀ i, (AdjoinRoot.powerBasisAux' hmon).repr y i ∈ I := by
    intro y
    obtain ⟨q, rfl⟩ := AdjoinRoot.mk_surjective y
    have hrep : ∀ i : Fin FP.natDegree,
        (AdjoinRoot.powerBasisAux' hmon).repr (AdjoinRoot.mk FP q) i = (q %ₘ FP).coeff i := by
      intro i
      rw [AdjoinRoot.powerBasisAux'_repr_apply_to_fun, AdjoinRoot.modByMonicHom_mk]
    rw [hcrit q]
    constructor
    · intro h i
      rw [hrep]
      exact h i
    · intro h j
      by_cases hj : j < FP.natDegree
      · have := h ⟨j, hj⟩
        rw [hrep] at this
        exact this
      · rw [Polynomial.coeff_eq_zero_of_degree_lt]
        · exact I.zero_mem
        · calc (q %ₘ FP).degree < FP.degree := Polynomial.degree_modByMonic_lt q hmon
            _ = (FP.natDegree : WithBot ℕ) := Polynomial.degree_eq_natDegree hmon.ne_zero
            _ ≤ (j : WithBot ℕ) := by exact_mod_cast not_lt.mp hj

  have hD : (Algebra.leftMulMatrix (AdjoinRoot.powerBasisAux' hmon) s).det ∉ I := by
    intro hdet
    have h0 : ((Algebra.leftMulMatrix (AdjoinRoot.powerBasisAux' hmon) s).map
        (Ideal.Quotient.mk I)).det = 0 := by
      rw [← RingHom.mapMatrix_apply, ← RingHom.map_det]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hdet
    obtain ⟨w, hw0, hw⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr h0
    let v : Fin FP.natDegree → P := fun i => Function.surjInv Ideal.Quotient.mk_surjective (w i)
    have hv : ∀ i, Ideal.Quotient.mk I (v i) = w i := fun i => Function.surjInv_eq _ _
    have hx : ⇑((AdjoinRoot.powerBasisAux' hmon).repr
        (∑ i, v i • (AdjoinRoot.powerBasisAux' hmon) i)) = v :=
      (AdjoinRoot.powerBasisAux' hmon).repr_sum_self v
    have hsx : s * (∑ i, v i • (AdjoinRoot.powerBasisAux' hmon) i) ∈ I.map (AdjoinRoot.of FP) := by
      rw [hcoord]
      intro i
      have e1 : ((AdjoinRoot.powerBasisAux' hmon).repr
          (s * ∑ i, v i • (AdjoinRoot.powerBasisAux' hmon) i)) i =
          Matrix.mulVec (Algebra.leftMulMatrix (AdjoinRoot.powerBasisAux' hmon) s) v i := by
        rw [← Algebra.leftMulMatrix_mulVec_repr, hx]
      rw [e1, ← Ideal.Quotient.eq_zero_iff_mem, RingHom.map_mulVec]
      have : (Ideal.Quotient.mk I ∘ v) = w := funext hv
      rw [this, hw]
      rfl
    have hxJ := (hJ.mem_or_mem hsx).resolve_left hs
    apply hw0
    funext i
    rw [← hv i, Pi.zero_apply, Ideal.Quotient.eq_zero_iff_mem, ← hx]
    exact (hcoord _).mp hxJ i

  have hMd : Matrix.mulVec (Algebra.leftMulMatrix (AdjoinRoot.powerBasisAux' hmon) s)
      ⇑((AdjoinRoot.powerBasisAux' hmon).repr d) =
      a • ⇑((AdjoinRoot.powerBasisAux' hmon).repr e) := by
    rw [Algebra.leftMulMatrix_mulVec_repr, hsde, ← AdjoinRoot.algebraMap_eq, ← Algebra.smul_def,
      LinearEquiv.map_smul, Finsupp.coe_smul]
  have hadj : ∀ i, (Algebra.leftMulMatrix (AdjoinRoot.powerBasisAux' hmon) s).det *
      (AdjoinRoot.powerBasisAux' hmon).repr d i =
      a * Matrix.mulVec (Algebra.leftMulMatrix (AdjoinRoot.powerBasisAux' hmon) s).adjugate
        ⇑((AdjoinRoot.powerBasisAux' hmon).repr e) i := by
    intro i
    have h1 : Matrix.mulVec (Algebra.leftMulMatrix (AdjoinRoot.powerBasisAux' hmon) s).adjugate
        (Matrix.mulVec (Algebra.leftMulMatrix (AdjoinRoot.powerBasisAux' hmon) s)
          ⇑((AdjoinRoot.powerBasisAux' hmon).repr d)) =
        (Algebra.leftMulMatrix (AdjoinRoot.powerBasisAux' hmon) s).det •
          ⇑((AdjoinRoot.powerBasisAux' hmon).repr d) := by
      rw [Matrix.mulVec_mulVec, Matrix.adjugate_mul, Matrix.smul_mulVec, Matrix.one_mulVec]
    rw [hMd, Matrix.mulVec_smul] at h1
    have h2 := congrFun h1 i
    simp only [Pi.smul_apply, smul_eq_mul] at h2
    exact h2.symm
  choose c hc using fun i => ha _ _ _ hD (hadj i)

  refine ⟨∑ i, c i • (AdjoinRoot.powerBasisAux' hmon) i, ?_⟩
  rw [← AdjoinRoot.algebraMap_eq, ← Algebra.smul_def, Finset.smul_sum]
  conv_lhs => rw [← (AdjoinRoot.powerBasisAux' hmon).sum_repr d]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [hc i, mul_smul]

theorem wcLlsKPan_content_lift : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (P : Type u) [CommRing P] (τ : ↥W →+* P) (FP : Polynomial P) (I : Ideal P), FP.Monic → 0 < FP.natDegree → I.IsPrime → (∀ q : Polynomial P, (AdjoinRoot.mk FP q ∈ I.map (AdjoinRoot.of FP) ↔ ∀ i, (q %ₘ FP).coeff i ∈ I)) → (∀ b : P, ∃ (a : ↥W) (s₁ s₂ : P), s₁ ∉ I ∧ s₂ ∉ I ∧ b * s₂ = τ a * s₁) → ∀ c : AdjoinRoot FP, ∃ (a : ↥W) (t₁ t₂ : AdjoinRoot FP), t₁ ∉ I.map (AdjoinRoot.of FP) ∧ t₂ ∉ I.map (AdjoinRoot.of FP) ∧ c * t₂ = AdjoinRoot.of FP (τ a) * t₁ :=
by
  intro Ω _ W P _ τ FP I hmon hdeg hI hcrit hcont c
  classical
  have hmul : ∀ x y : P, x ∉ I → y ∉ I → x * y ∉ I := fun x y hx hy h =>
    (hI.mem_or_mem h).elim hx hy

  have s1 : ∀ (s : Finset ℕ) (f : ℕ → P), s.Nonempty → ∃ (a : ↥W) (S : P) (g : ℕ → P),
      S ∉ I ∧ (∃ k ∈ s, g k ∉ I) ∧ ∀ i ∈ s, S * f i = τ a * g i := by
    intro s f hs
    induction hs using Finset.Nonempty.cons_induction with
    | singleton j =>
      obtain ⟨a, s₁, s₂, h1, h2, h⟩ := hcont (f j)
      refine ⟨a, s₂, fun _ => s₁, h2, ⟨j, Finset.mem_singleton_self j, h1⟩, ?_⟩
      intro i hi
      rw [Finset.mem_singleton.mp hi, mul_comm, h]
    | cons j s hjs hs ih =>
      obtain ⟨a', S', g', hS', ⟨k', hk', hgk'⟩, hid'⟩ := ih
      obtain ⟨a'', s₁, s₂, h1, h2, h⟩ := hcont (f j)
      rcases ValuationRing.dvd_total a' a'' with ⟨u, hu⟩ | ⟨u, hu⟩
      · refine ⟨a', S' * s₂, fun i => if i = j then τ u * S' * s₁ else s₂ * g' i,
          hmul _ _ hS' h2, ⟨k', Finset.mem_cons_of_mem hk', ?_⟩, ?_⟩
        · have hkj : k' ≠ j := fun e => hjs (e ▸ hk')
          show (if k' = j then τ u * S' * s₁ else s₂ * g' k') ∉ I
          rw [if_neg hkj]
          exact hmul _ _ h2 hgk'
        · intro i hi
          show S' * s₂ * f i = τ a' * (if i = j then τ u * S' * s₁ else s₂ * g' i)
          rcases Finset.mem_cons.mp hi with rfl | hi
          · rw [if_pos rfl]
            calc S' * s₂ * f i = S' * (f i * s₂) := by ring
              _ = S' * (τ a'' * s₁) := by rw [h]
              _ = τ a' * (τ u * S' * s₁) := by rw [hu, map_mul]; ring
          · have hij : i ≠ j := fun e => hjs (e ▸ hi)
            rw [if_neg hij]
            calc S' * s₂ * f i = s₂ * (S' * f i) := by ring
              _ = s₂ * (τ a' * g' i) := by rw [hid' i hi]
              _ = τ a' * (s₂ * g' i) := by ring
      · refine ⟨a'', S' * s₂, fun i => if i = j then S' * s₁ else τ u * s₂ * g' i,
          hmul _ _ hS' h2, ⟨j, Finset.mem_cons_self j s, ?_⟩, ?_⟩
        · show (if j = j then S' * s₁ else τ u * s₂ * g' j) ∉ I
          rw [if_pos rfl]
          exact hmul _ _ hS' h1
        · intro i hi
          show S' * s₂ * f i = τ a'' * (if i = j then S' * s₁ else τ u * s₂ * g' i)
          rcases Finset.mem_cons.mp hi with rfl | hi
          · rw [if_pos rfl]
            calc S' * s₂ * f i = S' * (f i * s₂) := by ring
              _ = S' * (τ a'' * s₁) := by rw [h]
              _ = τ a'' * (S' * s₁) := by ring
          · have hij : i ≠ j := fun e => hjs (e ▸ hi)
            rw [if_neg hij]
            calc S' * s₂ * f i = s₂ * (S' * f i) := by ring
              _ = s₂ * (τ a' * g' i) := by rw [hid' i hi]
              _ = τ a'' * (τ u * s₂ * g' i) := by rw [hu, map_mul]; ring

  haveI : Nontrivial P := nontrivial_of_ne 0 1 (fun h =>
    hI.ne_top ((Ideal.eq_top_iff_one I).mpr (h ▸ I.zero_mem)))

  have s2 : ∀ q : Polynomial P, q.degree < FP.degree → ∀ k : ℕ, q.coeff k ∉ I →
      AdjoinRoot.mk FP q ∉ I.map (AdjoinRoot.of FP) := by
    intro q hq k hk hmem
    have h1 := (hcrit q).mp hmem k
    rw [(Polynomial.modByMonic_eq_self_iff hmon).mpr hq] at h1
    exact hk h1

  have hFdeg : FP.degree = (FP.natDegree : WithBot ℕ) := Polynomial.degree_eq_natDegree hmon.ne_zero
  have hF1 : FP ≠ 1 := (Polynomial.Monic.natDegree_pos hmon).mp hdeg
  have hFpos : 0 < FP.degree := (Polynomial.Monic.degree_pos hmon).mpr hF1
  obtain ⟨q, rfl⟩ := AdjoinRoot.mk_surjective c
  have hqr : AdjoinRoot.mk FP q = AdjoinRoot.mk FP (q %ₘ FP) := by
    rw [AdjoinRoot.mk_eq_mk]
    refine ⟨q /ₘ FP, ?_⟩
    have : q %ₘ FP + FP * (q /ₘ FP) = q := Polynomial.modByMonic_add_div q FP
    linear_combination (-1 : Polynomial P) * this
  have hrdeg : (q %ₘ FP).degree < FP.degree := Polynomial.degree_modByMonic_lt q hmon
  have hrz : ∀ m, FP.natDegree ≤ m → (q %ₘ FP).coeff m = 0 := by
    intro m hm
    apply Polynomial.coeff_eq_zero_of_degree_lt
    rw [hFdeg] at hrdeg
    exact lt_of_lt_of_le hrdeg (by exact_mod_cast hm)
  obtain ⟨a, S, g, hS, ⟨k, hk, hgk⟩, hid⟩ := s1 (Finset.range FP.natDegree) (q %ₘ FP).coeff
    (Finset.nonempty_range_iff.mpr (by omega))
  have hq₁c : ∀ m, (∑ i ∈ Finset.range FP.natDegree, Polynomial.C (g i) * Polynomial.X ^ i).coeff m
      = if m ∈ Finset.range FP.natDegree then g m else 0 := by
    intro m
    rw [Polynomial.finsetSum_coeff]
    simp only [Polynomial.coeff_C_mul_X_pow]
    rw [Finset.sum_ite_eq]
  have hq₁deg : (∑ i ∈ Finset.range FP.natDegree, Polynomial.C (g i) * Polynomial.X ^ i).degree
      < FP.degree := by
    rw [hFdeg, Polynomial.degree_lt_iff_coeff_zero]
    intro m hm
    rw [hq₁c, if_neg (by simp only [Finset.mem_range]; omega)]
  have hpoly : Polynomial.C S * (q %ₘ FP) = Polynomial.C (τ a) *
      (∑ i ∈ Finset.range FP.natDegree, Polynomial.C (g i) * Polynomial.X ^ i) := by
    ext m
    rw [Polynomial.coeff_C_mul, Polynomial.coeff_C_mul, hq₁c]
    by_cases hm : m < FP.natDegree
    · rw [if_pos (Finset.mem_range.mpr hm)]
      exact hid m (Finset.mem_range.mpr hm)
    · rw [if_neg (by simp only [Finset.mem_range]; omega), hrz m (by omega)]
      simp
  refine ⟨a, AdjoinRoot.mk FP (∑ i ∈ Finset.range FP.natDegree, Polynomial.C (g i) * Polynomial.X ^ i),
    AdjoinRoot.of FP S, ?_, ?_, ?_⟩
  · apply s2 _ hq₁deg k
    rw [hq₁c, if_pos hk]
    exact hgk
  · rw [← AdjoinRoot.mk_C]
    apply s2 (Polynomial.C S) (lt_of_le_of_lt Polynomial.degree_C_le hFpos) 0
    rw [Polynomial.coeff_C_zero]
    exact hS
  · rw [hqr, ← AdjoinRoot.mk_C, ← AdjoinRoot.mk_C, ← map_mul, ← map_mul,
      mul_comm (q %ₘ FP) (Polynomial.C S), hpoly]

theorem wcLlsKPan_generic_conductor : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (P : Type u) [CommRing P] [IsDomain P] (ψ : Polynomial ↥W →+* P), RingHom.Etale ψ → ∀ (FP : Polynomial P) (ω : ↥W), FP.Monic → ω ≠ 0 → (∃ U V : Polynomial P, U * FP + V * Polynomial.derivative FP = Polynomial.C (ψ (Polynomial.C ω))) → IsDomain (AdjoinRoot FP) → AdjoinRoot.of FP (ψ (Polynomial.C ω)) ≠ 0 ∧ ∀ y : FractionRing (AdjoinRoot FP), IsIntegral (AdjoinRoot FP) y → ∃ (k : ℕ) (c : AdjoinRoot FP), algebraMap (AdjoinRoot FP) (FractionRing (AdjoinRoot FP)) c = algebraMap (AdjoinRoot FP) (FractionRing (AdjoinRoot FP)) (AdjoinRoot.of FP (ψ (Polynomial.C ω))) ^ k * y :=
by
  intro Ω _ W P _ _ ψ hψ FP ω hmon hω hBez hCdom
  haveI := hCdom
  letI := ψ.toAlgebra
  haveI : Algebra.Etale (Polynomial ↥W) P := hψ

  have ha : ψ (Polynomial.C ω) ≠ 0 := by
    have hCω : (Polynomial.C ω : Polynomial ↥W) ≠ 0 := Polynomial.C_ne_zero.mpr hω
    have hreg : IsSMulRegular P (Polynomial.C ω : Polynomial ↥W) :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hCω)
    intro h0
    have h1 : (Polynomial.C ω : Polynomial ↥W) • (1 : P) =
        (Polynomial.C ω : Polynomial ↥W) • (0 : P) := by
      rw [Algebra.smul_def, smul_zero, mul_one, RingHom.algebraMap_toAlgebra]; exact h0
    exact one_ne_zero (hreg h1)

  have hdeg : FP.degree ≠ 0 := by
    intro h
    have hnd : FP.natDegree = 0 :=
      Polynomial.natDegree_eq_zero_iff_degree_le_zero.mpr (le_of_eq h)
    have h1 : FP = 1 := Polynomial.eq_one_of_monic_natDegree_zero hmon hnd
    have h2 : (1 : AdjoinRoot FP) = 0 := by
      have h3 : AdjoinRoot.mk FP FP = 0 := AdjoinRoot.mk_self
      rw [← map_one (AdjoinRoot.mk FP)]
      conv_lhs => rw [← h1]
      exact h3
    exact one_ne_zero h2
  have hinj : Function.Injective (AdjoinRoot.of FP) :=
    AdjoinRoot.of.injective_of_degree_ne_zero hdeg
  have hx : AdjoinRoot.of FP (ψ (Polynomial.C ω)) ≠ 0 :=
    fun h => ha (hinj (h.trans (map_zero _).symm))
  refine ⟨hx, ?_⟩

  have hEt : Algebra.Etale (Polynomial ↥W)
      (Localization.Away (AdjoinRoot.of FP (ψ (Polynomial.C ω)))) := by
    obtain ⟨U, V, hUV⟩ := hBez
    let SP : StandardEtalePair P :=
      { f := FP, monic_f := hmon, g := Polynomial.C (ψ (Polynomial.C ω)),
        cond := ⟨V, U, 1, by rw [pow_one]; linear_combination hUV⟩ }
    haveI hEP : Algebra.Etale P (Localization.Away (AdjoinRoot.of FP (ψ (Polynomial.C ω)))) :=
      Algebra.Etale.of_equiv SP.equivAwayAdjoinRoot
    exact Algebra.Etale.comp (Polynomial ↥W) P _

  haveI hTdom : IsDomain (Localization.Away (AdjoinRoot.of FP (ψ (Polynomial.C ω)))) :=
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hx)

  have hT : IsIntegrallyClosed (Localization.Away (AdjoinRoot.of FP (ψ (Polynomial.C ω)))) := by
    apply IsIntegrallyClosed.of_localization_maximal
    intro p _ hpm
    haveI : p.IsPrime := Ideal.IsMaximal.isPrime hpm
    exact (wc_pks_etale_localization_normal (Polynomial ↥W)
      (Localization.Away (AdjoinRoot.of FP (ψ (Polynomial.C ω)))) p).2

  intro y hy
  set x := AdjoinRoot.of FP (ψ (Polynomial.C ω)) with hxdef
  have hu : IsUnit (algebraMap (AdjoinRoot FP) (FractionRing (AdjoinRoot FP)) x) :=
    isUnit_iff_ne_zero.mpr (fun h => hx (IsFractionRing.injective (AdjoinRoot FP)
      (FractionRing (AdjoinRoot FP)) (h.trans (map_zero _).symm)))
  letI : Algebra (Localization.Away x) (FractionRing (AdjoinRoot FP)) :=
    (IsLocalization.Away.lift x hu).toAlgebra
  haveI : IsScalarTower (AdjoinRoot FP) (Localization.Away x) (FractionRing (AdjoinRoot FP)) :=
    IsScalarTower.of_algebraMap_eq (fun c => (IsLocalization.Away.lift_eq x hu c).symm)
  haveI : IsFractionRing (Localization.Away x) (FractionRing (AdjoinRoot FP)) :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers x)
      (Localization.Away x) (FractionRing (AdjoinRoot FP))
  have hy' : IsIntegral (Localization.Away x) y := hy.tower_top
  obtain ⟨z, hz⟩ := (IsIntegrallyClosed.isIntegral_iff).mp hy'
  obtain ⟨n, a, hn⟩ := IsLocalization.Away.surj x z
  refine ⟨n, a, ?_⟩
  have h1 := congrArg (algebraMap (Localization.Away x) (FractionRing (AdjoinRoot FP))) hn
  rw [map_mul, map_pow, hz, ← IsScalarTower.algebraMap_apply,
    ← IsScalarTower.algebraMap_apply] at h1
  rw [← h1, mul_comm]

theorem wcLlsKPan_normal_crit : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (D : Type u) [CommRing D] [IsDomain D] (K : Type u) [Field K] [Algebra D K] [IsFractionRing D K] (σ : ↥W →+* D) (𝔓 : Ideal D), 𝔓.IsPrime → (∀ π ∈ IsLocalRing.maximalIdeal ↥W, σ π ∈ 𝔓) → (∀ d : D, ∃ (a : ↥W) (s₁ s₂ : D), s₁ ∉ 𝔓 ∧ s₂ ∉ 𝔓 ∧ d * s₂ = σ a * s₁) → (∀ (s d e : D) (a : ↥W), s ∉ 𝔓 → s * d = σ a * e → ∃ d' : D, d = σ a * d') → ∀ ω : ↥W, σ ω ≠ 0 → (∀ x : K, IsIntegral D x → ∃ (k : ℕ) (d : D), algebraMap D K d = algebraMap D K (σ ω) ^ k * x) → IsIntegrallyClosed D :=
by
  intro Ω _ W D _ _ K _ _ _ σ 𝔓 h𝔓 hM hV1 hV2 ω hω hV3
  have hι : Function.Injective (algebraMap D K) := IsFractionRing.injective D K

  have hSR : ∀ (x : K) (r s : D), IsIntegral D x → r ∈ 𝔓 →
      algebraMap D K r * x = algebraMap D K s → s ∈ 𝔓 := by
    intro x r s hx hr hrs
    obtain ⟨p, hpm, hp⟩ := hx
    have h1 : Polynomial.eval₂ (algebraMap D K) (algebraMap D K r * x) (p.scaleRoots r) = 0 := by
      rw [Polynomial.scaleRoots_eval₂_mul, hp, mul_zero]
    rw [hrs, Polynomial.eval₂_at_apply] at h1
