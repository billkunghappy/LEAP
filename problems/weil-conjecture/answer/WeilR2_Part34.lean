  have hHR : H ∈ Algebra.adjoin A {V} := hevR h
  have hGR : G ∈ Algebra.adjoin A {V} := hevR g
  have hDR : ∀ n : ℕ, algebraMap A K d ^ n ∈ Algebra.adjoin A {V} := fun n =>
