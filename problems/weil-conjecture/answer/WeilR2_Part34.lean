  have hrad0 : ∀ (c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L)) (n : ℕ),
      c ^ n ∈ Ideal.span {c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} →
      c ∈ Ideal.span {c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} := by
    obtain ⟨_, hNZ, _⟩ := hPD'
    have hWA : Function.Injective (algebraMap ↥W A) := by
      rw [injective_iff_map_eq_zero]
      intro w hw
      rw [Algebra.algebraMap_eq_smul_one] at hw
      rcases smul_eq_zero.mp hw with h | h
