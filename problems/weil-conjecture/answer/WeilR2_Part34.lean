    haveI : Nontrivial (Localization.AtPrime y ⧸
        I.map (algebraMap B (Localization.AtPrime y))) := φ₁.domain_nontrivial
    haveI : IsLocalRing (Localization.AtPrime y ⧸
        I.map (algebraMap B (Localization.AtPrime y))) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
