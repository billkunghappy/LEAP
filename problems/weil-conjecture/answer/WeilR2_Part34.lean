      · exact absurd h one_ne_zero
    have hwLinj : Function.Injective
        ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) :=
      (algebraMap K L).injective.comp ((IsFractionRing.injective A K).comp hWA)
    have hint : ∀ w : ↥W, _root_.IsIntegral ↥(wcLlsASbS W A K u b)
        (((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w) := fun w =>
      (_root_.isIntegral_algebraMap (R := ↥(wcLlsASbS W A K u b)) (A := L)
        (x := algebraMap A ↥(wcLlsASbS W A K u b) (algebraMap ↥W A w)))
    have hform : ∀ x ∈ Ideal.span {c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
            (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w},
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, ∃ c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L),
          (x : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w *
            (c : L) := by
      intro x hx
      induction hx using Submodule.span_induction with
      | mem c hc =>
        obtain ⟨w, hw, hc⟩ := hc
        exact ⟨w, hw, 1, by rw [hc, OneMemClass.coe_one, mul_one]⟩
      | zero => exact ⟨0, zero_mem _, 0, by rw [ZeroMemClass.coe_zero, mul_zero]⟩
      | add x z _ _ hx hz =>
        obtain ⟨w₁, hw₁, c₁, h₁⟩ := hx
        obtain ⟨w₂, hw₂, c₂, h₂⟩ := hz
        rcases ValuationRing.dvd_total w₁ w₂ with ⟨f, hf⟩ | ⟨f, hf⟩
        · refine ⟨w₁, hw₁, c₁ + ⟨_, hint f⟩ * c₂, ?_⟩
          rw [AddMemClass.coe_add, AddMemClass.coe_add, MulMemClass.coe_mul, h₁, h₂, hf,
            map_mul]
          ring
        · refine ⟨w₂, hw₂, ⟨_, hint f⟩ * c₁ + c₂, ?_⟩
          rw [AddMemClass.coe_add, AddMemClass.coe_add, MulMemClass.coe_mul, h₁, h₂, hf,
            map_mul]
          ring
      | smul a x _ hx =>
        obtain ⟨w, hw, c, h⟩ := hx
        refine ⟨w, hw, a * c, ?_⟩
        rw [smul_eq_mul, MulMemClass.coe_mul, MulMemClass.coe_mul, h]
        ring
    have hroot : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → ∀ n : ℕ, 0 < n →
        ∃ π : ↥W, π ∈ IsLocalRing.maximalIdeal ↥W ∧ π ^ n = w := by
      intro w hw n hn
      obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (w : Ω) hn
      have hwnu : ¬ IsUnit w := (IsLocalRing.mem_maximalIdeal _).mp hw
      by_cases hzW : z ∈ W
