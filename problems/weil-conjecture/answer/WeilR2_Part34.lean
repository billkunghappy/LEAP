      (Algebra.adjoin A {algebraMap A K u / algebraMap A K (algebraMap ↥W A a')}) a)
    rw [← ha₃]
    exact Subalgebra.algebraMap_mem _ a₃
  have hs_mem : s ∈ Algebra.adjoin A₃ {s₃} := hss ▸ Algebra.subset_adjoin (Set.mem_singleton s₃)
  have hle : ∀ x ∈ Algebra.adjoin A {s}, x ∈ Algebra.adjoin A₃ {s₃} := by
    intro x hx
    have hx' : x ∈ (Algebra.adjoin A {s}).toSubring := hx
    rw [Algebra.adjoin_eq_ring_closure] at hx'
    have hcl : Subring.closure (Set.range (algebraMap A K) ∪ {s}) ≤
        (Algebra.adjoin A₃ {s₃}).toSubring := by
