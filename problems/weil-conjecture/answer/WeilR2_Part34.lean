      rw [Polynomial.eval₂_map, hℓcomp, ← Polynomial.aeval_def, h1]
    obtain ⟨q, hq⟩ := hker _ h2
    have hρcomp : ρ.comp (algebraMap A (Localization.Away h)) = Ideal.Quotient.mk 𝔭 :=
