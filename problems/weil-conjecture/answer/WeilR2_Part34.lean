theorem wcpa_dj_llsm_kpkn_rh_coeff_vanish : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] (𝔭 : Ideal A) [𝔭.IsPrime] (ℓ : ℕ) (u v ε ε' δ : A) (h : ↥W) (θ ψ : ↥(integralClosure A L)) (a : Fin ℓ → A) (s₀ : A) (e₁ c₁ : ↥(integralClosure A L)), ℓ.Prime → Module.finrank K L = ℓ → ε ∉ 𝔭 → (θ : L) ^ ℓ = algebraMap A L (u * ε) → (ψ : L) ^ ℓ = algebraMap A L (v * ε') → (θ : L) * (ψ : L) = algebraMap A L (δ * algebraMap ↥W A h) → h ∈ IsLocalRing.maximalIdeal ↥W → u * v = algebraMap ↥W A (h ^ ℓ) → algebraMap ↥W A (h ^ ℓ) ≠ 0 → (∀ x : L, ∃ a : Fin ℓ → K, x = ∑ i, algebraMap K L (a i) * (θ : L) ^ (i : ℕ)) → (∀ x : L, IsIntegral A x → ∃ s : A, s ∉ 𝔭 ∧ algebraMap A L s * x ∈ Submodule.span A {z : L | ∃ i : ℕ, i < ℓ ∧ (z = (θ : L) ^ i ∨ z = (ψ : L) ^ i)}) → (∀ i : ℕ, 1 ≤ i → i < ℓ → ∀ a b c : A, b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) → algebraMap ↥W A (h ^ i) * a = algebraMap ↥W A (h ^ i) * b + v * c → ∃ s : A, s ∉ 𝔭 ∧ s * a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ⊔ Ideal.span {v}) → s₀ ∉ 𝔭 → c₁ ∈ Ideal.span {b : ↥(integralClosure A L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w} → algebraMap A L s₀ * ∑ i : Fin ℓ, algebraMap A L (a i) * (θ : L) ^ (i : ℕ) = (ψ : L) * (e₁ : L) + (c₁ : L) → ∀ i : Fin ℓ, ∃ s : A, s ∉ 𝔭 ∧ s * a i ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ⊔ Ideal.span {v} :=
by
