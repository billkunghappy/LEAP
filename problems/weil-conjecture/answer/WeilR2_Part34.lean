    intro X hX
    rw [hρ, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at hX
    obtain ⟨q, hq⟩ := hX
    obtain ⟨τ, rfl⟩ := hπFs q
    have h1 : algebraMap ↥(integralClosure A L) (Localization.AtPrime y) X -
