  obtain ⟨T, hT⟩ : ∃ T : ℕ → ℕ → ↥W, ∀ k j, T k j = if i * k ≤ j then
      (((ℓ.choose k / ℓ : ℕ) : ↥W)) * w * γ ^ (k - 1) * y ^ k * (H ^ (ℓ - k)).coeff (j - i * k)
