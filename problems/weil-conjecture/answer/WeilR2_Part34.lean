  have hu0 : u ≠ 0 := by rintro rfl; rw [zero_mul] at huv; exact hgA huv.symm
  have hε0 : ε ≠ 0 := fun h => hε (h ▸ 𝔭.zero_mem)
  have hu𝔭 : u ∈ 𝔭 := by
    rw [h𝔭eq]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert u {v}))
  have hv𝔭 : v ∈ 𝔭 := by
    rw [h𝔭eq]
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem u (Set.mem_singleton v)))
  have h𝔭eq' : 𝔭 = Ideal.span {v, u} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
    rw [Set.pair_comm]; exact h𝔭eq

  obtain ⟨hℓW, ⟨ζW, hζW⟩, h, hhg, hhm, hh0, hhdiv⟩ :=
    wcpa_dj_llsm_kpkn_constants Ω W ℓ hℓ hκ g hg hg0
  have hℓpos : 0 < ℓ := hℓ.pos
  have hℓA : IsUnit ((ℓ : ℕ) : A) := by
    have := hℓW.map (algebraMap ↥W A)
    rwa [map_natCast] at this
  have hζK : IsPrimitiveRoot (algebraMap A K (algebraMap ↥W A ζW)) ℓ :=
    hζW.map_of_injective (f := (algebraMap A K).comp (algebraMap ↥W A)) (hinjK.comp hWinj)

  have hθ0 : θ₂ ≠ 0 := fun h0 => hθ₂ ⟨0, by rw [map_zero, h0]⟩
  obtain ⟨ψ, hθψ⟩ : ∃ ψ : L, θ₂ * ψ = algebraMap A L (ε * algebraMap ↥W A h) :=
    ⟨algebraMap A L (ε * algebraMap ↥W A h) / θ₂, by field_simp⟩
  have hε'pow : ε ^ ℓ = ε * ε ^ (ℓ - 1) := by
    rw [← pow_succ']; congr 1; omega
  have huεL : algebraMap A L (u * ε) ≠ 0 :=
    (map_ne_zero_iff _ hinjL).mpr (mul_ne_zero hu0 hε0)
  have hψpow : ψ ^ ℓ = algebraMap A L (v * ε ^ (ℓ - 1)) := by
    apply mul_left_cancel₀ huεL
    have e1 : algebraMap A L (u * ε) * ψ ^ ℓ = (θ₂ * ψ) ^ ℓ := by rw [mul_pow, hθ₂pow]
    rw [e1, hθψ, ← map_pow, ← map_mul]
    congr 1
    rw [mul_pow, ← map_pow, hhg, ← huv, hε'pow]
    ring
  have hεhL : algebraMap A L (ε * algebraMap ↥W A h) ≠ 0 :=
    (map_ne_zero_iff _ hinjL).mpr (mul_ne_zero hε0 ((map_ne_zero_iff _ hWinj).mpr hh0))
  have hψ0 : ψ ≠ 0 := by intro h0; apply hεhL; rw [← hθψ, h0, mul_zero]
  have hψ : ψ ∉ Set.range (algebraMap K L) := by
    rintro ⟨c, hc⟩
    apply hθ₂
    refine ⟨algebraMap A K (ε * algebraMap ↥W A h) / c, ?_⟩
    rw [map_div₀, hc, ← hsc, ← hθψ]
    field_simp
  have hθint : IsIntegral A θ₂ :=
    IsIntegral.of_pow hℓpos (by rw [hθ₂pow]; exact isIntegral_algebraMap)
  have hψint : IsIntegral A ψ :=
    IsIntegral.of_pow hℓpos (by rw [hψpow]; exact isIntegral_algebraMap)
  obtain ⟨θ', rfl⟩ : ∃ t : ↥(integralClosure A L), (t : L) = θ₂ :=
    ⟨⟨θ₂, hθint⟩, rfl⟩
  obtain ⟨ψ', rfl⟩ : ∃ t : ↥(integralClosure A L), (t : L) = ψ :=
    ⟨⟨ψ, hψint⟩, rfl⟩

  obtain ⟨⟨σ, hσ⟩, -, hcoord⟩ := wcpa_dj_llsm_kpkn_kummer_basis K L ℓ hℓ hfr _ hζK
    (θ' : L) (algebraMap A K (u * ε)) hθ₂ (by rw [hθ₂pow, hsc])
  obtain ⟨⟨σ', hσ'⟩, -, hcoord'⟩ := wcpa_dj_llsm_kpkn_kummer_basis K L ℓ hℓ hfr _ hζK
    (ψ' : L) (algebraMap A K (v * ε ^ (ℓ - 1))) hψ (by rw [hψpow, hsc])
  have hσA : σ (θ' : L) = algebraMap A L (algebraMap ↥W A ζW) * (θ' : L) := by rw [hσ, hsc]
  have hσ'A : σ' (ψ' : L) = algebraMap A L (algebraMap ↥W A ζW) * (ψ' : L) := by rw [hσ', hsc]

  have hchart := fun (i : ℕ) (hi1 : 1 ≤ i) (hiℓ : i < ℓ) =>
    wcpa_dj_llsm_kpkn_chart_identities Ω W A 𝔭 u v g hPD (h ^ i) (pow_ne_zero _ hh0)
      (hhdiv i hi1 hiℓ).1 (hhdiv i hi1 hiℓ).2

  have hCD := wcpa_dj_llsm_kpkn_closure Ω W A K L 𝔭 ℓ u v ε (algebraMap ↥W A ζW) g h
    (θ' : L) (ψ' : L) σ hAic h𝔭 hℓ hfr hℓA hζK hθ₂ hθ₂pow hε hhg huv hgA hθψ hσA hcoord
    (fun i hi1 hiℓ => (hchart i hi1 hiℓ).1)
  have hset : {z : L | ∃ i : ℕ, i < ℓ ∧ (z = (ψ' : L) ^ i ∨ z = (θ' : L) ^ i)} =
      {z : L | ∃ i : ℕ, i < ℓ ∧ (z = (θ' : L) ^ i ∨ z = (ψ' : L) ^ i)} := by
    ext z; simp only [Set.mem_setOf_eq, or_comm]
  have hCD' : ∀ x : L, IsIntegral A x → ∃ s : A, s ∉ 𝔭 ∧ algebraMap A L s * x ∈
      Submodule.span A {z : L | ∃ i : ℕ, i < ℓ ∧ (z = (ψ' : L) ^ i ∨ z = (θ' : L) ^ i)} := by
    rw [hset]; exact hCD

  have hε'𝔭 : ε ^ (ℓ - 1) ∉ 𝔭 := fun h => hε (h𝔭.mem_of_pow_mem _ h)
  obtain ⟨hlocP, hyDec⟩ := wcpa_dj_llsm_kpkn_localization Ω W A K L 𝔭 ℓ u v ε (ε ^ (ℓ - 1))
    θ' ψ' y hAic h𝔭 hℓpos h𝔭eq hθ₂pow hψpow hε hε'𝔭 hCD hy hyc

  obtain ⟨hDv, hDu⟩ := wcpa_dj_llsm_kpkn_branch_dvrs Ω W A 𝔭 u v g hPD

  have hhℓ : u * v = algebraMap ↥W A (h ^ ℓ) := by rw [hhg]; exact huv
  have hhℓ0 : algebraMap ↥W A (h ^ ℓ) ≠ 0 := by rw [hhg]; exact hgA
  obtain ⟨hQz1, hQz2, hQz3⟩ := wcpa_dj_llsm_kpkn_residue_half Ω W A K L 𝔭 ℓ u v ε
    (ε ^ (ℓ - 1)) ε (algebraMap ↥W A ζW) h θ' ψ' σ y hAic hℓ hfr hℓA hζK hθ₂ hθ₂pow hψpow hθψ
    hε hε'𝔭 hε hhm hh0 hhℓ hhℓ0 h𝔭eq hσA hcoord hCD hyc hlocP
    (fun i hi1 hiℓ => (hchart i hi1 hiℓ).2.1) hDv
  obtain ⟨hQx1, hQx2, hQx3⟩ := wcpa_dj_llsm_kpkn_residue_half Ω W A K L 𝔭 ℓ v u
    (ε ^ (ℓ - 1)) ε ε (algebraMap ↥W A ζW) h ψ' θ' σ' y hAic hℓ hfr hℓA hζK hψ hψpow hθ₂pow
    (by rw [mul_comm]; exact hθψ) hε'𝔭 hε hε hhm hh0 (by rw [mul_comm]; exact hhℓ) hhℓ0 h𝔭eq'
    hσ'A hcoord' hCD' hyc hlocP (fun i hi1 hiℓ => (hchart i hi1 hiℓ).2.2) hDu

  have hJy : Ideal.span {b : ↥(integralClosure A L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
      (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w} ≤ y := by
    rw [Ideal.span_le]
    rintro b ⟨w, hw, hbw⟩
    have hb : b = algebraMap A ↥(integralClosure A L) (algebraMap ↥W A w) := Subtype.ext hbw
    rw [SetLike.mem_coe, hb, ← Ideal.mem_comap, hyc]
    exact hm𝔭 (Ideal.mem_map_of_mem _ hw)
  have hImax : Ideal.map (algebraMap ↥(integralClosure A L) (Localization.AtPrime y))
      (Ideal.span {b : ↥(integralClosure A L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w}) ≤
      IsLocalRing.maximalIdeal (Localization.AtPrime y) := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal]
    exact Ideal.map_mono hJy
  obtain ⟨π, hπs, hπker, hπsel⟩ : ∃ π : Localization.AtPrime y →+*
      wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y,
      Function.Surjective π ∧
      (∀ t, π t = 0 ↔ t ∈ Ideal.map (algebraMap ↥(integralClosure A L) (Localization.AtPrime y))
        (Ideal.span {b : ↥(integralClosure A L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w})) ∧
      ∀ b, wcKpknFSel W A L y b =
        π (algebraMap ↥(integralClosure A L) (Localization.AtPrime y) b) :=
    ⟨Ideal.Quotient.mk _, Ideal.Quotient.mk_surjective,
      fun t => Ideal.Quotient.eq_zero_iff_mem, fun b => rfl⟩
  haveI hnt : Nontrivial (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) := by
    refine ⟨⟨π 1, π 0, ?_⟩⟩
    intro h1
    rw [map_zero] at h1
    have := (hπker 1).mp h1
    exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top
      ((Ideal.eq_top_iff_one _).mpr (hImax this))
  haveI hloc : IsLocalRing (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) :=
    IsLocalRing.of_surjective' π hπs
  have hcomap : (IsLocalRing.maximalIdeal
      (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y)).comap π =
      IsLocalRing.maximalIdeal (Localization.AtPrime y) := by
    haveI := Ideal.comap_isMaximal_of_surjective π hπs
      (K := IsLocalRing.maximalIdeal (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y))
    exact IsLocalRing.eq_maximalIdeal this
  have hθy : θ' ∈ y := by
    apply hy.mem_of_pow_mem ℓ
    have e : θ' ^ ℓ = algebraMap A ↥(integralClosure A L) (u * ε) :=
      Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hθ₂pow)
    rw [e, ← Ideal.mem_comap, hyc]
    exact 𝔭.mul_mem_right ε hu𝔭
  have hψy : ψ' ∈ y := by
    apply hy.mem_of_pow_mem ℓ
    have e : ψ' ^ ℓ = algebraMap A ↥(integralClosure A L) (v * ε ^ (ℓ - 1)) :=
      Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hψpow)
    rw [e, ← Ideal.mem_comap, hyc]
    exact 𝔭.mul_mem_right _ hv𝔭
  have hselmax : ∀ b ∈ y, wcKpknFSel W A L y b ∈
      IsLocalRing.maximalIdeal (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) := by
    intro b hb
    rw [hπsel, ← Ideal.mem_comap, hcomap, ← Localization.AtPrime.map_eq_maximalIdeal]
    exact Ideal.mem_map_of_mem _ hb
  have hm : IsLocalRing.maximalIdeal
      (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) =
      Ideal.span {wcKpknFSel W A L y θ', wcKpknFSel W A L y ψ'} := by
    apply le_antisymm
    · intro q hq
      obtain ⟨t, rfl⟩ := hπs q
      have ht : t ∈ IsLocalRing.maximalIdeal (Localization.AtPrime y) := by
        rw [← hcomap]; exact hq
      rw [← Localization.AtPrime.map_eq_maximalIdeal] at ht
      have key : y ≤ (Ideal.span {wcKpknFSel W A L y θ', wcKpknFSel W A L y ψ'}).comap
          (π.comp (algebraMap ↥(integralClosure A L) (Localization.AtPrime y))) := by
        intro x hx
        obtain ⟨s, hs, hsx⟩ := hyDec x hx
        have h1 : algebraMap A ↥(integralClosure A L) s * x ∈
            (Ideal.span {wcKpknFSel W A L y θ', wcKpknFSel W A L y ψ'}).comap
              (π.comp (algebraMap ↥(integralClosure A L) (Localization.AtPrime y))) := by
          have hA : Ideal.span {θ', ψ'} ≤
              (Ideal.span {wcKpknFSel W A L y θ', wcKpknFSel W A L y ψ'}).comap
                (π.comp (algebraMap ↥(integralClosure A L) (Localization.AtPrime y))) := by
            rw [Ideal.span_le]
            rintro z (rfl | rfl)
            · rw [SetLike.mem_coe, Ideal.mem_comap, RingHom.comp_apply, ← hπsel]
              exact Ideal.subset_span (Set.mem_insert _ _)
            · rw [SetLike.mem_coe, Ideal.mem_comap, RingHom.comp_apply, ← hπsel]
              exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
          have hB : Ideal.span {b : ↥(integralClosure A L) |
                ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = algebraMap A L (algebraMap ↥W A w)} ≤
              (Ideal.span {wcKpknFSel W A L y θ', wcKpknFSel W A L y ψ'}).comap
                (π.comp (algebraMap ↥(integralClosure A L) (Localization.AtPrime y))) := by
            rw [Ideal.span_le]
            rintro b hb
            rw [SetLike.mem_coe, Ideal.mem_comap, RingHom.comp_apply,
              (hπker _).mpr (Ideal.mem_map_of_mem _ (Ideal.subset_span hb))]
            exact zero_mem _
          exact sup_le hA hB hsx
        rw [Ideal.mem_comap, map_mul] at h1
        have hunit : IsUnit ((π.comp (algebraMap ↥(integralClosure A L)
            (Localization.AtPrime y))) (algebraMap A ↥(integralClosure A L) s)) := by
          rw [RingHom.comp_apply]
          apply IsUnit.map π
          apply (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime y) y _).mpr
          show algebraMap A ↥(integralClosure A L) s ∉ y
          intro hmem
          apply hs
          rw [← hyc]
          exact hmem
        exact (Ideal.unit_mul_mem_iff_mem _ hunit).mp h1
      have hle := Ideal.map_le_iff_le_comap.mpr key
      rw [← Ideal.map_map] at hle
      exact hle (Ideal.mem_map_of_mem π ht)
    · rw [Ideal.span_le]
      rintro z (rfl | rfl)
      · exact hselmax θ' hθy
      · exact hselmax ψ' hψy
  have hxz : wcKpknFSel W A L y θ' * wcKpknFSel W A L y ψ' = 0 := by
    rw [hπsel, hπsel, ← map_mul, ← map_mul, hπker]
    apply Ideal.mem_map_of_mem
    have e : θ' * ψ' = algebraMap A ↥(integralClosure A L) ε *
        algebraMap A ↥(integralClosure A L) (algebraMap ↥W A h) := by
      apply Subtype.ext
      show (θ' : L) * (ψ' : L) = algebraMap A L ε * algebraMap A L (algebraMap ↥W A h)
      rw [hθψ, map_mul]
    rw [e]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨h, hhm, rfl⟩)
  obtain ⟨φ, hφ⟩ := wcpa_dj_llsm_tg_node_closure_prod
    (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y)
    (wcKpknFSel W A L y θ') (wcKpknFSel W A L y ψ') hxz hQx3 hQz3
  obtain ⟨hδ1, hbr⟩ := wcpa_dj_llsm_tg_node_delta_branches
    (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y)
    (wcKpknFSel W A L y θ') (wcKpknFSel W A L y ψ') hm φ hφ
  intro hbad
  exact hbad (Or.inr ⟨hδ1, hbr⟩)

theorem wcpa_dj_llsm_kp_tame_ann : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar (IsLocalRing.ResidueField ↥W) ≠ ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
      [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g : ↥W)
      (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.ann u v g) → y.IsPrime → y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
    wcLlsUniq A L 𝔭 y → wcLlsBR W A K L 𝔭 (.ann u v g) → Nat.card ↥(wcLlsDec A K L y) = ℓ →
    (∃ (θ : L) (f : A), θ ∉ Set.range (algebraMap K L) ∧ θ ^ ℓ = algebraMap A L f ∧ f ∉ 𝔭) ∨
      ∀ (_ : y.IsPrime),
        ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g y hPD hy hyc hUniq hBR hcard
  have hPD' := hPD
  obtain ⟨-, htf, -, h𝔭max, -, hg, hg0, huv, -⟩ := hPD'
  have h𝔭 : 𝔭.IsPrime := h𝔭max.isPrime
  have hBR' : ∀ Q, wcLlsGenPt W A L 𝔭 Q → ¬ wcLlsRam A K L Q := hBR
  have hu0 : u ≠ 0 := by
    rintro rfl
    rw [zero_mul, Algebra.algebraMap_eq_smul_one] at huv
    rcases smul_eq_zero.mp huv.symm with h | h
    · exact hg0 h
    · exact one_ne_zero h

  obtain ⟨hfin, θ, f, hf0, hθ, hθf⟩ :=
    wcpa_dj_llsm_kpta_kummer_setup Ω W ℓ hℓ hκ A K L 𝔭 y htf hy hyc hUniq hcard

  have htube : ∀ P : Ideal A, P.IsPrime → P ≠ ⊥ → P ≤ 𝔭 →
      (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) →
      ∃ (F : K) (a s : A), a ∉ P ∧ s ∉ P ∧
        algebraMap A K f * algebraMap A K s = F ^ ℓ * algebraMap A K a := by
    intro P hP hP0 hP𝔭 hPW
    by_contra hcon
    obtain ⟨Q, hQgen, hQram⟩ := wcpa_dj_llsm_kpta_kummer_ram Ω W hW hWt ℓ hℓ hκ A K L 𝔭
      (.ann u v g) hPD hfin θ f hf0 hθ hθf P hP hP0 hP𝔭 hPW hcon
    exact hBR' Q hQgen hQram
  obtain ⟨e, he, F, a, s, ha, hs, hfact⟩ :=
    wcpa_dj_llsm_kpta_tube_factor Ω W hW hWt A K 𝔭 u v g hPD ℓ hℓ f hf0 htube
  have hsc : ∀ x : A, algebraMap A L x = algebraMap K L (algebraMap A K x) :=
    fun x => IsScalarTower.algebraMap_apply A K L x
  have hinjK := IsFractionRing.injective A K
  have hinjL : Function.Injective (algebraMap A L) := by
    intro x y hxy
    rw [hsc, hsc] at hxy
    exact hinjK ((algebraMap K L).injective hxy)
  have hs0 : s ≠ 0 := fun h => hs (h ▸ 𝔭.zero_mem)
  have hsL : algebraMap A L s ≠ 0 := (map_ne_zero_iff _ hinjL).mpr hs0
  have huL : algebraMap A L u ≠ 0 := (map_ne_zero_iff _ hinjL).mpr hu0
  have hF0 : F ≠ 0 := by
    rintro rfl
    have h1 : algebraMap A K f * algebraMap A K s ≠ 0 :=
      mul_ne_zero ((map_ne_zero_iff _ hinjK).mpr hf0) ((map_ne_zero_iff _ hinjK).mpr hs0)
    apply h1
    rw [hfact, zero_pow hℓ.ne_zero]
    ring
  have hjF : algebraMap K L F ≠ 0 := (map_ne_zero_iff _ (algebraMap K L).injective).mpr hF0
  have hfactL : algebraMap A L f * algebraMap A L s =
      algebraMap A L u ^ e * (algebraMap K L F) ^ ℓ * algebraMap A L a := by
    have h := congrArg (algebraMap K L) hfact
    simp only [map_mul, map_pow] at h
    rw [hsc f, hsc s, hsc u, hsc a]
    exact h
  obtain ⟨m, rfl⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, by have := hℓ.pos; omega⟩
  set θ₀ : L := θ * algebraMap A L s / algebraMap K L F with hθ₀def
  set ε₀ : A := a * s ^ m with hε₀def
  have hθ₀pow : θ₀ ^ (m + 1) = algebraMap A L (u ^ e * ε₀) := by
    rw [hθ₀def, div_pow, mul_pow, hθf, div_eq_iff (pow_ne_zero _ hjF), hε₀def]
    simp only [map_mul, map_pow]
    linear_combination (algebraMap A L s ^ m) * hfactL
  have hθ₀ : θ₀ ∉ Set.range (algebraMap K L) := by
    rintro ⟨c, hc⟩
    apply hθ
    refine ⟨c * F / algebraMap A K s, ?_⟩
    rw [map_div₀, map_mul, hc, ← hsc, hθ₀def]
    field_simp
  have hε₀ : ε₀ ∉ 𝔭 := by
    intro h
    rcases h𝔭.mem_or_mem h with h | h
    · exact ha h
    · exact hs (h𝔭.mem_of_pow_mem _ h)
  rcases Nat.eq_zero_or_pos e with he0 | hepos
  ·
    left
    refine ⟨θ₀, ε₀, hθ₀, ?_, hε₀⟩
    rw [hθ₀pow, he0, pow_zero, one_mul]
  ·
    right
    have hcop : Nat.Coprime e (m + 1) := (Nat.coprime_of_lt_prime hepos.ne' he hℓ).symm
    have bez : ∀ n : ℕ, Nat.Coprime n (m + 1) → ∃ α k : ℕ, α * n = (m + 1) * k + 1 := by
      intro n hn
      have h1 : ((n * ((n : ZMod (m+1))⁻¹).val : ℕ) : ZMod (m+1)) = ((1 : ℕ) : ZMod (m+1)) := by
        have : NeZero (m + 1) := ⟨by omega⟩
        push_cast
        rw [ZMod.natCast_zmod_val]
        exact ZMod.coe_mul_inv_eq_one n hn
      rw [ZMod.natCast_eq_natCast_iff'] at h1
      refine ⟨((n : ZMod (m+1))⁻¹).val, n * ((n : ZMod (m+1))⁻¹).val / (m+1), ?_⟩
      have h2 := Nat.div_add_mod (n * ((n : ZMod (m+1))⁻¹).val) (m+1)
      have h3 : 1 % (m+1) = 1 := Nat.mod_eq_of_lt (by have := hℓ.two_le; omega)
      rw [h1, h3] at h2
      rw [mul_comm]
      linarith
    obtain ⟨α, k, hαk⟩ := bez e hcop
    have hαcop : Nat.Coprime α (m + 1) := by
      apply Nat.Coprime.symm
      rw [Nat.Prime.coprime_iff_not_dvd hℓ]
      intro hd
      have : (m+1) ∣ α * e := dvd_mul_of_dvd_left hd e
      rw [hαk] at this
      have h1 : (m+1) ∣ 1 := (Nat.dvd_add_right (dvd_mul_right _ _)).mp this
      exact hℓ.one_lt.ne' (Nat.dvd_one.mp h1)
    obtain ⟨α', k', hα'k⟩ := bez α hαcop
    set θ₂ : L := θ₀ ^ α / algebraMap A L u ^ k with hθ₂def
    have hθ₂ : θ₂ ∉ Set.range (algebraMap K L) := by
      rintro ⟨c, hc⟩
      have hθ₀ne : θ₀ ≠ 0 := fun h => hθ₀ ⟨0, by rw [map_zero, h]⟩
      have hα : θ₀ ^ α = algebraMap K L (c * algebraMap A K u ^ k) := by
        rw [map_mul, hc, map_pow, ← hsc, hθ₂def, div_mul_cancel₀ _ (pow_ne_zero _ huL)]
      have hid : (θ₀ ^ α) ^ α' = θ₀ * (θ₀ ^ (m + 1)) ^ k' := by
        rw [← pow_mul, ← pow_mul, mul_comm α α', hα'k]; ring
      have h2 : θ₀ = (θ₀ ^ α) ^ α' / (θ₀ ^ (m + 1)) ^ k' := by
        rw [hid, mul_div_assoc, div_self (pow_ne_zero _ (pow_ne_zero _ hθ₀ne)), mul_one]
      apply hθ₀
      refine ⟨(c * algebraMap A K u ^ k) ^ α' / (algebraMap A K (u ^ e * ε₀)) ^ k', ?_⟩
      rw [h2, map_div₀, map_pow, map_pow, ← hα, ← hsc, ← hθ₀pow]
    have hθ₂pow : θ₂ ^ (m + 1) = algebraMap A L (u * ε₀ ^ α) := by
      rw [hθ₂def, div_pow, ← pow_mul, mul_comm α (m + 1), pow_mul, hθ₀pow,
        div_eq_iff (pow_ne_zero _ (pow_ne_zero _ huL))]
      simp only [map_mul, map_pow]
      rw [mul_pow, ← pow_mul, ← pow_mul, mul_comm e α, hαk]
      ring
    exact fun hy' => wcpa_dj_llsm_kpta_kummer_node Ω W hW hWt (m + 1) hℓ hκ A K L 𝔭 u v g hPD
      hfin θ₂ (ε₀ ^ α) hθ₂ hθ₂pow (fun h => hε₀ (h𝔭.mem_of_pow_mem _ h)) y hyc hy'

theorem wcpa_dj_llsm_kp_ann_full_sep : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g : ↥W)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.ann u v g) → y.IsPrime → y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
    wcLlsUniq A L 𝔭 y →
    (∀ (_ : y.IsPrime),
      ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y)) →
    wcLlsAnnSep W A K L u g :=
by
  intro Ω _ W A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g y hPD hy hyc hUniq hgood
  classical


  have RE : ∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) →
      wcpaDjLkDelta R = wcpaDjLkDelta S ∧ wcpaDjLkBranches R = wcpaDjLkBranches S := by
    intro R S _ _ e
    let eF : FractionRing R ≃+* FractionRing S := IsFractionRing.ringEquivOfRingEquiv e
    have H1 : ∀ r : R, eF (algebraMap R (FractionRing R) r) = algebraMap S (FractionRing S) (e r) :=
      fun r => IsFractionRing.ringEquivOfRingEquiv_algebraMap e r
    have H2 : ∀ s : S, eF.symm (algebraMap S (FractionRing S) s) =
        algebraMap R (FractionRing R) (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, H1, RingEquiv.apply_symm_apply]
    have C1 : (algebraMap S (FractionRing S)).comp (e : R →+* S) =
        (eF : FractionRing R →+* FractionRing S).comp (algebraMap R (FractionRing R)) := by
      ext r
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H1 r).symm
    have C2 : (algebraMap R (FractionRing R)).comp (e.symm : S →+* R) =
        (eF.symm : FractionRing S →+* FractionRing R).comp (algebraMap S (FractionRing S)) := by
      ext s
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H2 s).symm
    have I1 : ∀ x : FractionRing R, _root_.IsIntegral R x → _root_.IsIntegral S (eF x) :=
      fun x hx => hx.map_of_comp_eq (e : R →+* S) (eF : FractionRing R →+* FractionRing S) C1
    have I2 : ∀ y : FractionRing S, _root_.IsIntegral S y → _root_.IsIntegral R (eF.symm y) :=
      fun y hy => hy.map_of_comp_eq (e.symm : S →+* R) (eF.symm : FractionRing S →+* FractionRing R) C2
    let eI : ↥(integralClosure R (FractionRing R)) ≃+* ↥(integralClosure S (FractionRing S)) :=
      { toFun := fun x => ⟨eF x, I1 x x.2⟩
        invFun := fun y => ⟨eF.symm y, I2 y y.2⟩
        left_inv := fun x => Subtype.ext (eF.symm_apply_apply x)
        right_inv := fun y => Subtype.ext (eF.apply_symm_apply y)
        map_mul' := fun x y => Subtype.ext (map_mul eF (x : FractionRing R) y)
        map_add' := fun x y => Subtype.ext (map_add eF (x : FractionRing R) y) }
    have heI : ∀ r : R, eI (algebraMap R _ r) = algebraMap S _ (e r) := fun r => Subtype.ext (H1 r)
    have heI' : ∀ s : S, eI.symm (algebraMap S _ s) = algebraMap R _ (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, heI, RingEquiv.apply_symm_apply]
    constructor
    · letI : RingHomInvPair (e : R →+* S) (e.symm : S →+* R) := RingHomInvPair.of_ringEquiv e
      letI : RingHomInvPair (e.symm : S →+* R) (e : R →+* S) := RingHomInvPair.symm _ _
      let LeI : ↥(integralClosure R (FractionRing R)) →ₛₗ[(e : R →+* S)]
          ↥(integralClosure S (FractionRing S)) :=
        { toFun := eI
          map_add' := map_add eI
          map_smul' := fun r a => by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI]
            rfl }
      let LeI' : ↥(integralClosure S (FractionRing S)) →ₛₗ[(e.symm : S →+* R)]
          ↥(integralClosure R (FractionRing R)) :=
        { toFun := eI.symm
          map_add' := map_add eI.symm
          map_smul' := fun s b => by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI']
            rfl }
      let p := LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))
      let q := LinearMap.range (Algebra.linearMap S ↥(integralClosure S (FractionRing S)))
      have h1 : p ≤ q.comap LeI := by
        rintro _ ⟨r, rfl⟩
        exact ⟨e r, (heI r).symm⟩
      have h2 : q ≤ p.comap LeI' := by
        rintro _ ⟨s, rfl⟩
        exact ⟨e.symm s, (heI' s).symm⟩
      let Φ := p.mapQ q LeI h1
      let Φ' := q.mapQ p LeI' h2
      let Φe : (↥(integralClosure R (FractionRing R)) ⧸ p) ≃ₛₗ[(e : R →+* S)]
          (↥(integralClosure S (FractionRing S)) ⧸ q) :=
        { Φ with
          invFun := Φ'
          left_inv := fun x => by
            induction x using Submodule.Quotient.induction_on with
            | H a =>
              show Φ' (Φ (Submodule.Quotient.mk a)) = Submodule.Quotient.mk a
              rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
              exact congrArg _ (eI.symm_apply_apply a)
          right_inv := fun x => by
            induction x using Submodule.Quotient.induction_on with
            | H b =>
              show Φ (Φ' (Submodule.Quotient.mk b)) = Submodule.Quotient.mk b
              rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
              exact congrArg _ (eI.apply_symm_apply b) }
      let O := Submodule.orderIsoMapComap Φe
      unfold wcpaDjLkDelta
      rw [Module.length_eq_height, Module.length_eq_height, ← Order.height_orderIso O ⊤,
        OrderIso.map_top]
    · unfold wcpaDjLkBranches
      apply ENat.card_congr
      exact
        { toFun := fun M => ⟨M.asIdeal.comap (eI.symm : _ →+* _), by
            haveI := M.isMaximal
            exact Ideal.comap_isMaximal_of_surjective _ eI.symm.surjective⟩
          invFun := fun N => ⟨N.asIdeal.comap (eI : _ →+* _), by
            haveI := N.isMaximal
            exact Ideal.comap_isMaximal_of_surjective _ eI.surjective⟩
          left_inv := fun M => by
            ext x
            show eI.symm (eI x) ∈ M.asIdeal ↔ x ∈ M.asIdeal
            rw [RingEquiv.symm_apply_apply]
          right_inv := fun N => by
            ext x
            show eI (eI.symm x) ∈ N.asIdeal ↔ x ∈ N.asIdeal
            rw [RingEquiv.apply_symm_apply] }

  have FSeq : ∀ (R₁ R₂ : Type u) [CommRing R₁] [CommRing R₂] [Algebra R₁ L] [Algebra R₂ L]
      (w₁ w₂ : ↥W →+* L), (∀ w : ↥W, w₁ w = w₂ w) →
      ∀ (ψ : ↥(integralClosure R₁ L) ≃+* ↥(integralClosure R₂ L)),
      (∀ x : ↥(integralClosure R₁ L), ((ψ x : ↥(integralClosure R₂ L)) : L) = (x : L)) →
      ∀ (y₁ : Ideal ↥(integralClosure R₁ L)) [y₁.IsPrime]
        (y₂ : Ideal ↥(integralClosure R₂ L)) [y₂.IsPrime],
      y₁ = Ideal.comap ψ y₂ → Nonempty (wcLlsFS W w₁ R₁ y₁ ≃+* wcLlsFS W w₂ R₂ y₂) := by
    intro R₁ R₂ _ _ _ _ w₁ w₂ hw ψ hψ y₁ _ y₂ _ hy12
    have hmem : ∀ x, x ∈ y₁ ↔ ψ x ∈ y₂ := by
      intro x
      rw [hy12, Ideal.mem_comap]
    have hsub : Submonoid.map ψ.toMonoidHom y₁.primeCompl = y₂.primeCompl := by
      ext z
      simp only [Submonoid.mem_map, Ideal.mem_primeCompl_iff]
      constructor
      · rintro ⟨x, hx, rfl⟩ h
        exact hx ((hmem x).mpr h)
      · intro hz
        refine ⟨ψ.symm z, fun h => hz ?_, ψ.apply_symm_apply z⟩
        have h1 := (hmem _).mp h
        rwa [ψ.apply_symm_apply] at h1
    let Φ : Localization.AtPrime y₁ ≃+* Localization.AtPrime y₂ :=
      IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime y₁) (Localization.AtPrime y₂) ψ hsub
    have hΦ : ∀ x, Φ (algebraMap _ (Localization.AtPrime y₁) x) =
        algebraMap _ (Localization.AtPrime y₂) (ψ x) := fun x =>
      IsLocalization.ringEquivOfRingEquiv_eq hsub x
    have hcomm : (algebraMap ↥(integralClosure R₂ L) (Localization.AtPrime y₂)).comp
          (ψ : ↥(integralClosure R₁ L) →+* ↥(integralClosure R₂ L)) =
        (Φ : Localization.AtPrime y₁ →+* Localization.AtPrime y₂).comp
          (algebraMap ↥(integralClosure R₁ L) (Localization.AtPrime y₁)) :=
      RingHom.ext fun x => (hΦ x).symm
    have hgen : (ψ : ↥(integralClosure R₁ L) →+* ↥(integralClosure R₂ L)) ''
          {b : ↥(integralClosure R₁ L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = w₁ w} =
        {b : ↥(integralClosure R₂ L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = w₂ w} := by
      ext z
      constructor
      · rintro ⟨b, ⟨w, hw1, hw2⟩, rfl⟩
        exact ⟨w, hw1, (hψ b).trans (hw2.trans (hw w))⟩
      · rintro ⟨w, hw1, hw2⟩
        refine ⟨ψ.symm z, ⟨w, hw1, ?_⟩, ψ.apply_symm_apply z⟩
        have h1 := hψ (ψ.symm z)
        rw [ψ.apply_symm_apply] at h1
        exact h1.symm.trans (hw2.trans (hw w).symm)
    show Nonempty ((Localization.AtPrime y₁ ⧸
        (Ideal.span {b : ↥(integralClosure R₁ L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = w₁ w}).map
          (algebraMap ↥(integralClosure R₁ L) (Localization.AtPrime y₁))) ≃+*
      (Localization.AtPrime y₂ ⧸
        (Ideal.span {b : ↥(integralClosure R₂ L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = w₂ w}).map
          (algebraMap ↥(integralClosure R₂ L) (Localization.AtPrime y₂))))
    refine ⟨Ideal.quotientEquiv _ _ Φ ?_⟩
    rw [← hgen, ← Ideal.map_span, Ideal.map_map, hcomm, ← Ideal.map_map]

  obtain ⟨_, hnzd, _, _, _, hgm, hg0, huv, h𝔭, _⟩ := hPD
  haveI := hnzd
  have hag : algebraMap ↥W A g ≠ 0 := by
    intro h
    rw [Algebra.algebraMap_eq_smul_one] at h
    rcases smul_eq_zero.mp h with h1 | h1
    · exact hg0 h1
    · exact one_ne_zero h1
  have hu : u ≠ 0 := fun h => hag (by rw [← huv, h, zero_mul])
  have hKu : algebraMap A K u ≠ 0 := fun h =>
    hu (IsFractionRing.injective A K (h.trans (map_zero _).symm))
  have hv0 : algebraMap A K v = algebraMap A K (algebraMap ↥W A g) / algebraMap A K u := by
    rw [← huv, map_mul, mul_div_cancel_left₀ _ hKu]
  have hw : ∀ w : ↥W, ((algebraMap A L).comp (algebraMap ↥W A)) w =
      ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w := fun w => by
    simp only [RingHom.comp_apply]
    exact IsScalarTower.algebraMap_apply A K L _
  suffices H : ∀ s : K, algebraMap A K v = s → wcLlsSepAt W A K L u s from H _ hv0
  intro s hv
  unfold wcLlsSepAt
  intro 𝔮 h𝔮P h𝔮

  have hSbot : Algebra.adjoin A {s} ≤ ⊥ :=
    Algebra.adjoin_le (Set.singleton_subset_iff.mpr (Algebra.mem_bot.mpr ⟨v, hv⟩))
  have hρsurj : Function.Surjective (algebraMap A ↥(Algebra.adjoin A {s})) := by
    intro r
    obtain ⟨a, ha⟩ := Algebra.mem_bot.mp (hSbot r.2)
    exact ⟨a, Subtype.ext ha⟩
  have hρinj : Function.Injective (algebraMap A ↥(Algebra.adjoin A {s})) := by
    intro a b h
    exact IsFractionRing.injective A K (congrArg Subtype.val h)
  have hval : ∀ a : A, algebraMap ↥(Algebra.adjoin A {s}) L (algebraMap A ↥(Algebra.adjoin A {s}) a) =
      algebraMap A L a := by
    intro a
    rw [IsScalarTower.algebraMap_apply A K L a]
    rfl
  letI : IsScalarTower A ↥(Algebra.adjoin A {s}) L :=
    IsScalarTower.of_algebraMap_eq (fun a => (hval a).symm)
  haveI : Algebra.IsIntegral A ↥(Algebra.adjoin A {s}) := ⟨fun r => by
    obtain ⟨a, rfl⟩ := hρsurj r
    exact isIntegral_algebraMap⟩

  let ψ : ↥(integralClosure A L) ≃+* ↥(integralClosure ↥(Algebra.adjoin A {s}) L) :=
    { toFun := fun x => ⟨x.1, show _root_.IsIntegral ↥(Algebra.adjoin A {s}) x.1 from
        (show _root_.IsIntegral A x.1 from x.2).tower_top⟩
      invFun := fun z => ⟨z.1, show _root_.IsIntegral A z.1 from
        isIntegral_trans z.1 (show _root_.IsIntegral ↥(Algebra.adjoin A {s}) z.1 from z.2)⟩
      left_inv := fun x => rfl
      right_inv := fun z => rfl
      map_mul' := fun x y => rfl
      map_add' := fun x y => rfl }
  have hψ : ∀ x : ↥(integralClosure A L),
      ((ψ x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) : L) = (x : L) := fun x => rfl
  have hsq : ∀ a : A, ψ (algebraMap A ↥(integralClosure A L) a) =
      algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
        (algebraMap A ↥(Algebra.adjoin A {s}) a) := by
    intro a
    apply Subtype.ext
    exact (hval a).symm

  have hsv : (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) =
      algebraMap A ↥(Algebra.adjoin A {s}) v := Subtype.ext hv.symm
  have hN : Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) u,
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) =
      𝔭.map (algebraMap A ↥(Algebra.adjoin A {s})) := by
    rw [hsv, h𝔭, Ideal.map_sup, Ideal.map_span, Set.image_pair, Ideal.map_map]
  have hcomap : (Ideal.comap ψ 𝔮).comap (algebraMap A ↥(integralClosure A L)) = 𝔭 := by
    ext a
    rw [Ideal.mem_comap, Ideal.mem_comap, hsq, ← Ideal.mem_comap, h𝔮, hN, ← Ideal.mem_comap,
      Ideal.comap_map_of_bijective _ ⟨hρinj, hρsurj⟩]
  have hyq : Ideal.comap ψ 𝔮 = y := hUniq _ (Ideal.comap_isPrime ψ 𝔮) hcomap
  obtain ⟨e⟩ := FSeq A ↥(Algebra.adjoin A {s}) _ _ hw ψ hψ y 𝔮 hyq.symm
  obtain ⟨hD, hB⟩ := RE _ _ e
  have h0 := hgood hy
  unfold wcpaDjLkBad at h0 ⊢
  rw [hD, hB] at h0
  exact h0

theorem wcLlsKP_wild_generator : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (ℓ : ℕ), ℓ.Prime → ringChar Ω ≠ ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → y.IsPrime → y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
    wcLlsUniq A L 𝔭 y → Nat.card ↥(wcLlsDec A K L y) = ℓ →
    Module.finrank K L = ℓ ∧ ∃ (θ : L) (f : A), θ ∉ Set.range (algebraMap K L) ∧
      θ ^ ℓ = algebraMap A L f :=
by
  intro Ω _ _ W ℓ hℓ hΩ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy hcomap hU hD
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩

  have hmapint : ∀ (τ : L ≃ₐ[K] L) (x : L), x ∈ integralClosure A L →
      τ x ∈ integralClosure A L := by
    intro τ x hx
    rw [mem_integralClosure_iff] at hx ⊢
    exact hx.map τ
  let f : (L ≃ₐ[K] L) → (integralClosure A L →+* integralClosure A L) := fun τ =>
    { toFun := fun x => ⟨τ x, hmapint τ x x.2⟩
      map_one' := Subtype.ext (map_one τ)
      map_mul' := fun a b => Subtype.ext (map_mul τ (a : L) (b : L))
      map_zero' := Subtype.ext (map_zero τ)
      map_add' := fun a b => Subtype.ext (map_add τ (a : L) (b : L)) }
  have hf : ∀ τ (x : integralClosure A L), ((f τ x : integralClosure A L) : L) = τ x :=
    fun _ _ => rfl
  have hfA : ∀ τ, (f τ).comp (algebraMap A (integralClosure A L)) =
      algebraMap A (integralClosure A L) := by
    intro τ
    refine RingHom.ext fun a => Subtype.ext ?_
    rw [RingHom.comp_apply, hf]
    have e : ((algebraMap A (integralClosure A L) a : integralClosure A L) : L) =
        algebraMap K L (algebraMap A K a) := by
      rw [← IsScalarTower.algebraMap_apply]; rfl
    rw [e]
    exact τ.commutes _
  have hstab : ∀ τ (x : integralClosure A L), x ∈ y → f τ x ∈ y := by
    intro τ x hx
    have h1 : y.comap (f τ) = y := by
      apply hU
      · exact Ideal.comap_isPrime _ _
      · rw [Ideal.comap_comap, hfA, hcomap]
    have h2 : x ∈ y.comap (f τ) := by rw [h1]; exact hx
    exact h2
  have hDec : wcLlsDec A K L y = ⊤ := by
    rw [eq_top_iff]
    intro σ _
    open Pointwise in
    (rw [wcLlsDec, MulAction.mem_stabilizer_iff]
     ext z
     rw [Set.mem_smul_set]
     constructor
     · rintro ⟨w, ⟨x, hx, rfl⟩, rfl⟩
       exact ⟨f σ x, hstab σ x hx, rfl⟩
     · rintro ⟨x, hx, rfl⟩
       refine ⟨_, ⟨f σ⁻¹ x, hstab σ⁻¹ x hx, rfl⟩, ?_⟩
       rw [AlgEquiv.smul_def, hf, ← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply])

  have hcardG : Nat.card (L ≃ₐ[K] L) = ℓ := by rw [← hD, hDec, Subgroup.card_top]
  have hfr : Module.finrank K L = ℓ := by rw [← IsGalois.card_aut_eq_finrank, hcardG]
  refine ⟨hfr, ?_⟩

  obtain ⟨-, hNZ, -⟩ := hPD
  have hΩℓ : (ℓ : Ω) ≠ 0 := by
    intro h0
    have hdvd : ringChar Ω ∣ ℓ := ringChar.dvd h0
    rcases hℓ.eq_one_or_self_of_dvd _ hdvd with h1 | h1
    · exact CharP.ringChar_ne_one h1
    · exact hΩ h1
  haveI : NeZero (ℓ : Ω) := ⟨hΩℓ⟩
  obtain ⟨ζ₀, hζ₀⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot Ω ℓ
  have hζ₀W : ζ₀ ∈ W := by
    rcases W.mem_or_inv_mem ζ₀ with h | h
    · exact h
    · have h1 : ζ₀ ^ (ℓ - 1) * ζ₀ = 1 := by
        rw [← pow_succ, Nat.sub_add_cancel hℓ.one_lt.le]; exact hζ₀.pow_eq_one
      have e : ζ₀ = (ζ₀⁻¹) ^ (ℓ - 1) := by
        rw [inv_pow, eq_inv_of_mul_eq_one_left h1, inv_inv]
      rw [e]; exact pow_mem h _
  have hw₀ : IsPrimitiveRoot (⟨ζ₀, hζ₀W⟩ : ↥W) ℓ :=
    IsPrimitiveRoot.of_map_of_injective (f := W.subtype) hζ₀ Subtype.val_injective
  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    rw [Algebra.algebraMap_eq_smul_one] at hw
    exact (smul_eq_zero.mp hw).resolve_right one_ne_zero
  have hφ : Function.Injective ((algebraMap A K).comp (algebraMap ↥W A)) :=
    (IsFractionRing.injective A K).comp hWA
  have hζ : IsPrimitiveRoot (((algebraMap A K).comp (algebraMap ↥W A)) ⟨ζ₀, hζ₀W⟩) ℓ :=
    hw₀.map_of_injective hφ

  have hcyc : IsCyclic (L ≃ₐ[K] L) := isCyclic_of_prime_card hcardG
  have hne : (primitiveRoots (Module.finrank K L) K).Nonempty := by
    rw [hfr]; exact ⟨_, (mem_primitiveRoots hℓ.pos).mpr hζ⟩
  obtain ⟨α, hαℓ, hαtop⟩ := ((isCyclic_tfae K L hne).out 1 3).mp
    (show IsGalois K L ∧ IsCyclic (L ≃ₐ[K] L) from ⟨inferInstance, hcyc⟩)
  rw [hfr] at hαℓ
  have hα : α ∉ Set.range (algebraMap K L) := by
    intro h
    have h1 : IntermediateField.adjoin K {α} = ⊥ :=
      IntermediateField.adjoin_simple_eq_bot_iff.mpr (IntermediateField.mem_bot.mpr h)
    rw [h1] at hαtop
    have h2 := IntermediateField.bot_eq_top_iff_finrank_eq_one.mp hαtop
    rw [hfr] at h2
    exact hℓ.one_lt.ne' h2

  obtain ⟨k, hk⟩ := hαℓ
  obtain ⟨a, s, hs, hask⟩ := IsFractionRing.div_surjective (A := A) k
  have hs0 : s ≠ 0 := nonZeroDivisors.ne_zero hs
  have hsK : algebraMap A K s ≠ 0 := by
    intro h; apply hs0; exact IsFractionRing.injective A K (by rw [h, map_zero])
  have hsL : algebraMap A L s ≠ 0 := by
    rw [IsScalarTower.algebraMap_apply A K L]; exact (map_ne_zero _).mpr hsK
  refine ⟨algebraMap A L s * α, a * s ^ (ℓ - 1), ?_, ?_⟩
  · rintro ⟨c, hc⟩
    apply hα
    refine ⟨c / algebraMap A K s, ?_⟩
    rw [map_div₀, hc, ← IsScalarTower.algebraMap_apply, mul_div_cancel_left₀ _ hsL]
  · rw [mul_pow, ← hk, ← hask, map_div₀, map_mul, map_pow,
      ← IsScalarTower.algebraMap_apply A K L a, ← IsScalarTower.algebraMap_apply A K L s]
    calc algebraMap A L s ^ ℓ * (algebraMap A L a / algebraMap A L s)
        = algebraMap A L s ^ (ℓ - 1) * algebraMap A L s *
            (algebraMap A L a / algebraMap A L s) := by
          rw [← pow_succ, Nat.sub_add_cancel hℓ.one_lt.le]
      _ = algebraMap A L a * algebraMap A L s ^ (ℓ - 1) := by
          rw [mul_assoc, mul_div_assoc', mul_div_cancel_left₀ _ hsL, mul_comm]

