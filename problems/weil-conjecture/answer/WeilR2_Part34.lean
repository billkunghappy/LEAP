  have hJ : Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 :=
    sup_le ((Ideal.span_singleton_le_iff_mem _).mpr hv𝔭) hm𝔭
  have hNBu : ∀ b : A, b ∉ 𝔭 → ∀ t : A, t ∉ 𝔭 →
      t * b ∉ Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) :=
