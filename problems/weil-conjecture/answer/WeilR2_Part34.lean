    obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples 𝔭.primeCompl Finset.univ x
    choose a ha using fun i => RingHom.mem_rangeS.mp (hb i (Finset.mem_univ i))
    have hbu := hunitD b b.2
    have hda : ∀ i, Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v)
        (algebraMap A (Localization.AtPrime 𝔭) (a i)) =
        Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v) (algebraMap A (Localization.AtPrime 𝔭) b) * d i := by
