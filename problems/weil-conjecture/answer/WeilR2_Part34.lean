theorem wcpa_dj_llsm_kpwulbc_residue_ring : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) → ∀ O : ValuationSubring K, (∀ x : K, x ∈ O ↔ ∃ a b : A, (∀ s : A, s ∉ 𝔭 → s * b ∉ Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧ x * algebraMap A K b = algebraMap A K a) → ∃ O₁ : ValuationSubring K, (∀ x : K, x ∈ O₁ ↔ ∃ a b : A, b ∉ 𝔭 ∧ O.valuation (x - algebraMap A K a / algebraMap A K b) < 1) ∧ O₁ ≤ O ∧ (∀ x : K, O.valuation x < 1 → x ∈ O₁) ∧ (∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → O.valuation (algebraMap A K (algebraMap ↥W A w)) < 1) ∧ algebraMap A K u ≠ 0 ∧ algebraMap A K u ∈ O₁ ∧ (algebraMap A K u)⁻¹ ∉ O₁ ∧ (algebraMap A K u)⁻¹ ∈ O ∧ ∀ (k : ℕ) (ε r g' : A) (w : ↥W), ε ∉ 𝔭 → w ∈ IsLocalRing.maximalIdeal ↥W → algebraMap A K (u ^ k * ε + v * r + algebraMap ↥W A w * g') ≠ 0 ∧ algebraMap A K (u ^ k * ε + v * r + algebraMap ↥W A w * g') / algebraMap A K u ^ k ∈ O₁ ∧ (algebraMap A K (u ^ k * ε + v * r + algebraMap ↥W A w * g') / algebraMap A K u ^ k)⁻¹ ∈ O₁ :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 u v g hPD O hO
  classical
  have hPD' := hPD
  obtain ⟨hFT, hNZ, -, h𝔭max, hm𝔭, -, -, -, h𝔭eq, -⟩ := hPD'
  have h𝔭 : 𝔭.IsPrime := h𝔭max.isPrime
  have hu𝔭 : u ∈ 𝔭 := by
    rw [h𝔭eq]
    exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
  have hv𝔭 : v ∈ 𝔭 := by
    rw [h𝔭eq]
    exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
  have hJ𝔭 : Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 :=
    sup_le ((Ideal.span_singleton_le_iff_mem _).mpr hv𝔭) hm𝔭
  have hD := wcpa_dj_llsm_kpwulbc_branch_dichotomy Ω W A 𝔭 u v g hPD
  have hNBu : ∀ s : A, s ∉ 𝔭 →
      s * u ∉ Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
    intro s hs
    have h := wcpa_dj_llsm_kpwulbc_branch_upow Ω W A 𝔭 u v g hPD 1 s hs
    rwa [pow_one] at h
  have hvI : ∀ (r g' : A) (w : ↥W), w ∈ IsLocalRing.maximalIdeal ↥W →
      v * r + algebraMap ↥W A w * g' ∈
        Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
    intro r g' w hw
    exact Ideal.add_mem _
      (Ideal.mem_sup_left (Ideal.mul_mem_right r _ (Ideal.mem_span_singleton_self v)))
      (Ideal.mem_sup_right (Ideal.mul_mem_right g' _ (Ideal.mem_map_of_mem _ hw)))
  have hwI : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W →
      algebraMap ↥W A w ∈
        Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) :=
    fun w hw => Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)
  generalize hIdef : Ideal.span {v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) = I
    at hO hD hNBu hJ𝔭 hvI hwI
  have hI : I ≤ 𝔭 := hJ𝔭
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h => h𝔭.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have hφinj : ∀ a b : A, algebraMap A K a = algebraMap A K b → a = b :=
    fun a b h => IsFractionRing.injective A K h

  have ha : ∀ a : A, algebraMap A K a ∈ O := by
    intro a
    rw [hO]
    refine ⟨a, 1, fun s hs hsI => hs (hI (by simpa using hsI)), by simp⟩

  have hb : ∀ b : A, (∀ s : A, s ∉ 𝔭 → s * b ∉ I) →
      algebraMap A K b ≠ 0 ∧ (algebraMap A K b)⁻¹ ∈ O := by
    intro b hNB
    have hb0 : b ≠ 0 := by
      rintro rfl
      exact hNB 1 h1𝔭 (by simp)
    have hφb : algebraMap A K b ≠ 0 := by
      intro h
      exact hb0 (hφinj b 0 (by rw [h, map_zero]))
    refine ⟨hφb, ?_⟩
    rw [hO]
    exact ⟨1, b, hNB, by rw [map_one, inv_mul_cancel₀ hφb]⟩

  have hc : ∀ y : A, y ∈ I → O.valuation (algebraMap A K y) < 1 := by
    intro y hy
    by_contra hlt
    push_neg at hlt
    have hle : O.valuation (algebraMap A K y) ≤ 1 := (O.valuation_le_one_iff _).mpr (ha y)
    have heq : O.valuation (algebraMap A K y) = 1 := le_antisymm hle hlt
    have hy0 : algebraMap A K y ≠ 0 := by
      intro h
      rw [h, Valuation.map_zero] at heq
      exact zero_ne_one heq
    have hinv : (algebraMap A K y)⁻¹ ∈ O := by
      rw [← O.valuation_le_one_iff, map_inv₀, heq, inv_one]
    obtain ⟨a, b, hNB, hab⟩ := (hO _).mp hinv
    have hbe : algebraMap A K b = algebraMap A K (a * y) := by
      rw [map_mul, ← hab]
      field_simp
    have hbay : b = a * y := hφinj _ _ hbe
    exact hNB 1 h1𝔭 (by rw [one_mul, hbay]; exact I.mul_mem_left a hy)

  have hNBt : ∀ t : A, t ∉ 𝔭 → ∀ s : A, s ∉ 𝔭 → s * t ∉ I := by
    intro t ht s hs hst
    exact (h𝔭.mul_mem_iff_mem_or_mem.mp (hI hst)).elim hs ht
  have hunit : ∀ b : A, (∀ s : A, s ∉ 𝔭 → s * b ∉ I) → O.valuation (algebraMap A K b) = 1 := by
    intro b hNB
    obtain ⟨h0, hinv⟩ := hb b hNB
    have h1 := (O.valuation_le_one_iff _).mpr (ha b)
    have h2 := (O.valuation_le_one_iff _).mpr hinv
    by_contra hne
    have hlt : O.valuation (algebraMap A K b) < 1 := lt_of_le_of_ne h1 hne
    have h3 : O.valuation (algebraMap A K b) * O.valuation (algebraMap A K b)⁻¹ < 1 :=
      lt_of_le_of_lt (mul_le_of_le_one_right' h2) hlt
    rw [← Valuation.map_mul, mul_inv_cancel₀ h0, Valuation.map_one] at h3
    exact lt_irrefl _ h3
  have hne0 : ∀ t : A, t ∉ 𝔭 → algebraMap A K t ≠ 0 := fun t ht => (hb t (hNBt t ht)).1
  have hP2 : ∀ a b : A, b ∉ 𝔭 → algebraMap A K a / algebraMap A K b ∈ O := by
    intro a b hb'
    rw [div_eq_mul_inv]
    exact mul_mem (ha a) (hb b (hNBt b hb')).2

  let C : Set K := {x | ∃ a b : A, b ∉ 𝔭 ∧
    O.valuation (x - algebraMap A K a / algebraMap A K b) < 1}
  have hCO : ∀ x ∈ C, x ∈ O := by
    rintro x ⟨a, b, hb', hlt⟩
    have h2 : x - algebraMap A K a / algebraMap A K b ∈ O := (O.valuation_le_one_iff _).mp hlt.le
    have h3 := add_mem (hP2 a b hb') h2
    convert h3 using 1
    ring
  have hmC : ∀ x : K, O.valuation x < 1 → x ∈ C := fun x hx => ⟨0, 1, h1𝔭, by simpa using hx⟩
  have hzero : (0 : K) ∈ C := ⟨0, 1, h1𝔭, by simp⟩
  have hone : (1 : K) ∈ C := ⟨1, 1, h1𝔭, by simp⟩
  have hadd : ∀ x y : K, x ∈ C → y ∈ C → x + y ∈ C := by
    rintro x y ⟨a, b, hb', hx⟩ ⟨c, d, hd', hy⟩
    have hb0 := hne0 b hb'
    have hd0 := hne0 d hd'
    refine ⟨a * d + b * c, b * d, fun h => (h𝔭.mul_mem_iff_mem_or_mem.mp h).elim hb' hd', ?_⟩
    have e : x + y - algebraMap A K (a * d + b * c) / algebraMap A K (b * d) =
        (x - algebraMap A K a / algebraMap A K b) + (y - algebraMap A K c / algebraMap A K d) := by
      simp only [map_add, map_mul]
      field_simp
      ring
    rw [e]
    exact lt_of_le_of_lt (Valuation.map_add _ _ _) (max_lt hx hy)
  have hneg : ∀ x : K, x ∈ C → -x ∈ C := by
    rintro x ⟨a, b, hb', hx⟩
    refine ⟨-a, b, hb', ?_⟩
    have e : -x - algebraMap A K (-a) / algebraMap A K b =
        -(x - algebraMap A K a / algebraMap A K b) := by
      rw [map_neg]
      ring
    rw [e, Valuation.map_neg]
    exact hx
  have hmul : ∀ x y : K, x ∈ C → y ∈ C → x * y ∈ C := by
    intro x y hxC hyC
    have hxO := hCO x hxC
    obtain ⟨a, b, hb', hx⟩ := hxC
    obtain ⟨c, d, hd', hy⟩ := hyC
    have hb0 := hne0 b hb'
    have hd0 := hne0 d hd'
    refine ⟨a * c, b * d, fun h => (h𝔭.mul_mem_iff_mem_or_mem.mp h).elim hb' hd', ?_⟩
    have e : x * y - algebraMap A K (a * c) / algebraMap A K (b * d) =
        x * (y - algebraMap A K c / algebraMap A K d) +
          (algebraMap A K c / algebraMap A K d) * (x - algebraMap A K a / algebraMap A K b) := by
      simp only [map_mul]
      field_simp
      ring
    rw [e]
    refine lt_of_le_of_lt (Valuation.map_add _ _ _) (max_lt ?_ ?_)
    · rw [Valuation.map_mul]
      exact lt_of_le_of_lt (mul_le_of_le_one_left' ((O.valuation_le_one_iff _).mpr hxO)) hy
    · rw [Valuation.map_mul]
      exact lt_of_le_of_lt
        (mul_le_of_le_one_left' ((O.valuation_le_one_iff _).mpr (hP2 c d hd'))) hx

  have hH : ∀ (X Y : A) (E E' : ℕ) (σ ε σ' ε' : A), σ ∉ 𝔭 → ε ∉ 𝔭 → σ' ∉ 𝔭 → ε' ∉ 𝔭 →
      σ * X - u ^ E * ε ∈ I → σ' * Y - u ^ E' * ε' ∈ I →
      O.valuation (algebraMap A K Y) = 1 → E' ≤ E →
      algebraMap A K X / algebraMap A K Y ∈ C := by
    intro X Y E E' σ ε σ' ε' hσ hε hσ' hε' hX hY hY1 hle
    have hY0 : algebraMap A K Y ≠ 0 := by
      intro h
      rw [h, Valuation.map_zero] at hY1
      exact zero_ne_one hY1
    have hb' : ε' * σ ∉ 𝔭 := fun h => (h𝔭.mul_mem_iff_mem_or_mem.mp h).elim hε' hσ
    have hσ0 := hne0 σ hσ
    have hε'0 := hne0 ε' hε'
    have hb1 := hunit _ (hNBt _ hb')
    refine ⟨u ^ (E - E') * ε * σ', ε' * σ, hb', ?_⟩
    have hNI : ε' * σ * X - u ^ (E - E') * ε * σ' * Y ∈ I := by
      have h := I.sub_mem (I.mul_mem_left ε' hX) (I.mul_mem_left (u ^ (E - E') * ε) hY)
      have hp : u ^ (E - E') * u ^ E' = u ^ E := by rw [← pow_add, Nat.sub_add_cancel hle]
      have heq : ε' * σ * X - u ^ (E - E') * ε * σ' * Y =
          ε' * (σ * X - u ^ E * ε) - u ^ (E - E') * ε * (σ' * Y - u ^ E' * ε') := by
        linear_combination (-(ε * ε')) * hp
      rw [heq]
      exact h
    have e : algebraMap A K X / algebraMap A K Y -
        algebraMap A K (u ^ (E - E') * ε * σ') / algebraMap A K (ε' * σ) =
        algebraMap A K (ε' * σ * X - u ^ (E - E') * ε * σ' * Y) /
          (algebraMap A K Y * algebraMap A K (ε' * σ)) := by
      simp only [map_sub, map_mul, map_pow]
      field_simp
    rw [e, map_div₀, Valuation.map_mul, hY1, hb1, one_mul, div_one]
    exact hc _ hNI

  have hval : ∀ x : K, x ∈ C ∨ x⁻¹ ∈ C := by
    intro x
    by_cases hxO : x ∈ O
    · by_cases hlt : O.valuation x < 1
      · exact Or.inl (hmC x hlt)
      have hx1 : O.valuation x = 1 :=
        le_antisymm ((O.valuation_le_one_iff _).mpr hxO) (not_lt.mp hlt)
      obtain ⟨a, b, hNBb, hab⟩ := (hO x).mp hxO
      have hb1 := hunit b hNBb
      have hb0 := (hb b hNBb).1
      have hxe : x = algebraMap A K a / algebraMap A K b := by
        rw [eq_div_iff hb0]
        exact hab
      have ha1 : O.valuation (algebraMap A K a) = 1 := by
        rw [← hab, Valuation.map_mul, hx1, hb1, one_mul]
      obtain ⟨eb, σb, εb, hσb, hεb, hIb⟩ :
          ∃ (e : ℕ) (σ ε : A), σ ∉ 𝔭 ∧ ε ∉ 𝔭 ∧ σ * b - u ^ e * ε ∈ I := by
        rcases hD b with ⟨t, ht, htb⟩ | h
        · exact absurd htb (hNBb t ht)
        · exact h
      obtain ⟨ea, σa, εa, hσa, hεa, hIa⟩ :
          ∃ (e : ℕ) (σ ε : A), σ ∉ 𝔭 ∧ ε ∉ 𝔭 ∧ σ * a - u ^ e * ε ∈ I := by
        rcases hD a with ⟨t, ht, hta⟩ | h
        · exfalso
          have h1 := hc _ hta
          rw [map_mul, Valuation.map_mul, hunit t (hNBt t ht), one_mul, ha1] at h1
          exact lt_irrefl _ h1
        · exact h
      rcases le_total eb ea with hle | hle
      · left
        rw [hxe]
        exact hH a b ea eb σa εa σb εb hσa hεa hσb hεb hIa hIb hb1 hle
      · right
        rw [hxe, inv_div]
        exact hH b a eb ea σb εb σa εa hσb hεb hσa hεa hIb hIa ha1 hle
    · have hxi : x⁻¹ ∈ O := (O.mem_or_inv_mem x).resolve_left hxO
      right
      apply hmC
      refine lt_of_le_of_ne ((O.valuation_le_one_iff _).mpr hxi) ?_
      intro h
      rw [map_inv₀, inv_eq_one] at h
      exact hxO ((O.valuation_le_one_iff _).mp h.le)
  let S : Subring K :=
    { carrier := C
      mul_mem' := fun {x y} hx hy => hmul x y hx hy
      one_mem' := hone
      add_mem' := fun {x y} hx hy => hadd x y hx hy
      zero_mem' := hzero
      neg_mem' := fun {x} hx => hneg x hx }
  let O₁ : ValuationSubring K := { toSubring := S, mem_or_inv_mem' := hval }
  have hmem : ∀ x : K, x ∈ O₁ ↔ x ∈ C := fun x => Iff.rfl

  have hu0 : algebraMap A K u ≠ 0 := (hb u hNBu).1
  have huinvO : (algebraMap A K u)⁻¹ ∈ O := (hb u hNBu).2
  have huC : algebraMap A K u ∈ C := ⟨u, 1, h1𝔭, by simp⟩
  have hNBc : ∀ z : A, O.valuation (algebraMap A K z) < 1 → ∃ t, t ∉ 𝔭 ∧ t * z ∈ I := by
    intro z hz
    by_contra hcon
    push_neg at hcon
    rw [hunit z hcon] at hz
    exact lt_irrefl _ hz
  have huinv : (algebraMap A K u)⁻¹ ∉ C := by
    rintro ⟨a, b, hb', hlt⟩
    have hb0 := hne0 b hb'
    have e : algebraMap A K (b - u * a) = algebraMap A K u * algebraMap A K b *
        ((algebraMap A K u)⁻¹ - algebraMap A K a / algebraMap A K b) := by
      rw [map_sub, map_mul]
      field_simp
    have hlt' : O.valuation (algebraMap A K (b - u * a)) < 1 := by
      rw [e, Valuation.map_mul]
      exact lt_of_le_of_lt (mul_le_of_le_one_left'
        ((O.valuation_le_one_iff _).mpr (mul_mem (ha u) (ha b)))) hlt
    obtain ⟨t, ht, htI⟩ := hNBc _ hlt'
    have h1 : b - u * a ∈ 𝔭 := (h𝔭.mul_mem_iff_mem_or_mem.mp (hI htI)).resolve_left ht
    have h2 : u * a ∈ 𝔭 := 𝔭.mul_mem_right a hu𝔭
    apply hb'
    have h3 := 𝔭.add_mem h1 h2
    rwa [sub_add_cancel] at h3
  have hbr : ∀ (k : ℕ) (ε j : A), ε ∉ 𝔭 → j ∈ I →
      algebraMap A K (u ^ k * ε + j) ≠ 0 ∧
      algebraMap A K (u ^ k * ε + j) / algebraMap A K u ^ k ∈ C ∧
      (algebraMap A K (u ^ k * ε + j) / algebraMap A K u ^ k)⁻¹ ∈ C := by
    intro k ε j hε hj
    have hε0 := hne0 ε hε
    have hε1 := hunit ε (hNBt ε hε)
    obtain ⟨m, hm⟩ : ∃ m : K, m = algebraMap A K j * ((algebraMap A K u)⁻¹) ^ k := ⟨_, rfl⟩
    have hm1 : O.valuation m < 1 := by
      rw [hm, Valuation.map_mul]
      exact lt_of_le_of_lt (mul_le_of_le_one_right'
        ((O.valuation_le_one_iff _).mpr (pow_mem huinvO k))) (hc j hj)
    have hQ : algebraMap A K (u ^ k * ε + j) / algebraMap A K u ^ k = algebraMap A K ε + m := by
      rw [hm, map_add, map_mul, map_pow, add_div, mul_div_cancel_left₀ _ (pow_ne_zero _ hu0),
        div_eq_mul_inv, inv_pow]
    have hQ1 : O.valuation (algebraMap A K ε + m) = 1 := by
      have hle : O.valuation (algebraMap A K ε + m) ≤ 1 :=
        le_trans (Valuation.map_add _ _ _) (max_le hε1.le hm1.le)
      refine le_antisymm hle ?_
      by_contra hlt
      push_neg at hlt
      have h2 : O.valuation (algebraMap A K ε) < 1 := by
        have e : algebraMap A K ε = (algebraMap A K ε + m) + (-m) := by ring
        rw [e]
        refine lt_of_le_of_lt (Valuation.map_add _ _ _) (max_lt hlt ?_)
        rw [Valuation.map_neg]
        exact hm1
      rw [hε1] at h2
      exact lt_irrefl _ h2
    have hQ0 : algebraMap A K ε + m ≠ 0 := by
      intro h
      rw [h, Valuation.map_zero] at hQ1
      exact zero_ne_one hQ1
    refine ⟨?_, ?_, ?_⟩
    · intro h
      apply hQ0
      rw [← hQ, h, zero_div]
    · rw [hQ]
      exact ⟨ε, 1, h1𝔭, by simpa using hm1⟩
    · rw [hQ]
      refine ⟨1, ε, hε, ?_⟩
      have e : (algebraMap A K ε + m)⁻¹ - algebraMap A K 1 / algebraMap A K ε =
          -m / ((algebraMap A K ε + m) * algebraMap A K ε) := by
        rw [map_one]
        field_simp
        ring
      rw [e, map_div₀, Valuation.map_neg, Valuation.map_mul, hQ1, hε1, one_mul, div_one]
      exact hm1

  refine ⟨O₁, hmem, fun x hx => hCO x hx, fun x hx => hmC x hx, fun w hw => hc _ (hwI w hw),
    hu0, huC, huinv, huinvO, ?_⟩
  intro k ε r g' w hε hw
  have e : u ^ k * ε + v * r + algebraMap ↥W A w * g' =
      u ^ k * ε + (v * r + algebraMap ↥W A w * g') := by ring
  rw [e]
  exact hbr k ε _ hε (hvI r g' w hw)

theorem wcpa_dj_llsm_kpwulbc_kr_transfer : ∀ (A : Type u) [CommRing A] [IsDomain A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 I : Ideal A) (u : A) (ℓ : ℕ), 0 < ℓ → 𝔭.IsPrime → I ≤ 𝔭 → ∀ O O₁ : ValuationSubring K, (∀ x : K, x ∈ O ↔ ∃ a b : A, (∀ s : A, s ∉ 𝔭 → s * b ∉ I) ∧ x * algebraMap A K b = algebraMap A K a) → (∀ x : K, x ∈ O₁ ↔ ∃ a b : A, b ∉ 𝔭 ∧ O.valuation (x - algebraMap A K a / algebraMap A K b) < 1) → (∀ a : A, (∀ M : ℕ, ∃ σ r s t : A, s ∉ 𝔭 ∧ t ∉ 𝔭 ∧ t * (s ^ ℓ * a - σ ^ ℓ - u ^ M * r) ∈ I) → ∃ σ s t : A, s ∉ 𝔭 ∧ t ∉ 𝔭 ∧ t * (s ^ ℓ * a - σ ^ ℓ) ∈ I) → ∀ x ∈ O₁, (∀ M : ℕ, ∃ σ ∈ O₁, ∃ r ∈ O₁, O.valuation (x - σ ^ ℓ - algebraMap A K u ^ M * r) < 1) → ∃ σ ∈ O₁, O.valuation (x - σ ^ ℓ) < 1 :=
by
  intro A _ _ K _ _ _ 𝔭 I u ℓ hℓ hp hI O O₁ hO hO₁ hA x hx hM
  obtain ⟨l, rfl⟩ : ∃ l, ℓ = l + 1 := ⟨ℓ - 1, by omega⟩
  have hinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hval1 : ∀ y : K, y ≠ 0 → y⁻¹ ∈ O → 1 ≤ O.valuation y := by
    intro y hy hyi
    have h1 : O.valuation y * O.valuation y⁻¹ = 1 := by
      rw [← map_mul, mul_inv_cancel₀ hy, map_one]
    have h2 : O.valuation y⁻¹ ≤ 1 := (O.valuation_le_one_iff _).mpr hyi
    calc (1 : _) = O.valuation y * O.valuation y⁻¹ := h1.symm
      _ ≤ O.valuation y := mul_le_of_le_one_right' h2
  have hval2 : ∀ y : K, y ≠ 0 → 1 ≤ O.valuation y → y⁻¹ ∈ O := by
    intro y hy h
    rw [← O.valuation_le_one_iff]
    have h1 : O.valuation y⁻¹ * O.valuation y = 1 := by
      rw [← map_mul, inv_mul_cancel₀ hy, map_one]
    calc O.valuation y⁻¹ ≤ O.valuation y⁻¹ * O.valuation y := le_mul_of_one_le_right' h
      _ = 1 := h1
  have h1p : (1 : A) ∉ 𝔭 := fun h => hp.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have hi : ∀ c : A, algebraMap A K c ∈ O := by
    intro c
    rw [hO]
    refine ⟨c, 1, ?_, by rw [map_one, mul_one]⟩
    intro s hs hsI
    rw [mul_one] at hsI
    exact hs (hI hsI)
  have hne : ∀ b : A, b ∉ 𝔭 → algebraMap A K b ≠ 0 := by
    intro b hb h
    apply hb
    have : b = 0 := hinj (by rw [h, map_zero])
    rw [this]; exact 𝔭.zero_mem
  have hNB : ∀ b : A, b ∉ 𝔭 → ∀ s : A, s ∉ 𝔭 → s * b ∉ I := by
    intro b hb s hs hsI
    rcases hp.mem_or_mem (hI hsI) with h | h
    · exact hs h
    · exact hb h
  have hii : ∀ b : A, b ∉ 𝔭 → O.valuation (algebraMap A K b) = 1 := by
    intro b hb
    apply le_antisymm ((O.valuation_le_one_iff _).mpr (hi b))
    apply hval1 _ (hne b hb)
    rw [hO]
    exact ⟨1, b, hNB b hb, by rw [inv_mul_cancel₀ (hne b hb), map_one]⟩
  have hiii : ∀ y : A, y ∈ I → O.valuation (algebraMap A K y) < 1 := by
    intro y hy
    by_contra hlt
    push_neg at hlt
    have hy0 : algebraMap A K y ≠ 0 := by
      intro h
      rw [h, map_zero] at hlt
      exact one_ne_zero (le_antisymm hlt zero_le')
    obtain ⟨a', b', hb', he⟩ := (hO _).mp (hval2 _ hy0 hlt)
    apply hb' 1 h1p
    have : b' = a' * y := by
      apply hinj
      rw [map_mul, ← he]
      field_simp
    rw [one_mul, this]
    exact I.mul_mem_left a' hy
  have hiv : ∀ z : A, O.valuation (algebraMap A K z) < 1 → ∃ t : A, t ∉ 𝔭 ∧ t * z ∈ I := by
    intro z hz
    by_contra hcon
    push_neg at hcon
    have hz0 : algebraMap A K z ≠ 0 := by
      intro h
      have : z = 0 := hinj (by rw [h, map_zero])
      exact hcon 1 h1p (by rw [this, mul_zero]; exact I.zero_mem)
    have hmem : (algebraMap A K z)⁻¹ ∈ O :=
      (hO _).mpr ⟨1, z, hcon, by rw [inv_mul_cancel₀ hz0, map_one]⟩
    exact absurd (hval1 _ hz0 hmem) (not_le.mpr hz)
  have hfrac : ∀ a b : A, b ∉ 𝔭 → algebraMap A K a / algebraMap A K b ∈ O := by
    intro a b hb
    rw [div_eq_mul_inv]
    exact mul_mem (hi a) (hval2 _ (hne b hb) (le_of_eq (hii b hb).symm))
  have hlt1 : ∀ y : K, O.valuation y < 1 → y ∈ O := fun y hy =>
    (O.valuation_le_one_iff y).mp hy.le
  have hO₁O : ∀ w ∈ O₁, w ∈ O := by
    intro w hw
    obtain ⟨a, b, hb, hv⟩ := (hO₁ w).mp hw
    have : w = (w - algebraMap A K a / algebraMap A K b) + algebraMap A K a / algebraMap A K b := by
      ring
    rw [this]
    exact add_mem (hlt1 _ hv) (hfrac a b hb)
  have hultra : ∀ (M : ℕ) (x y σ q r p ϖ : K), σ ∈ O → q ∈ O → ϖ ∈ O →
      O.valuation (x - σ ^ (l + 1) - ϖ ^ M * r) < 1 → O.valuation (x - y) < 1 →
      O.valuation (σ - q) < 1 → O.valuation (r - p) < 1 →
      O.valuation (y - q ^ (l + 1) - ϖ ^ M * p) < 1 := by
    intro M x y σ q r p ϖ hσ hq hϖ h1 h2 h3 h4
    have hGm : (∑ i ∈ Finset.range (l + 1), σ ^ i * q ^ (l + 1 - 1 - i)) * (σ - q) =
        σ ^ (l + 1) - q ^ (l + 1) := geom_sum₂_mul σ q (l + 1)
    have hGO : (∑ i ∈ Finset.range (l + 1), σ ^ i * q ^ (l + 1 - 1 - i)) ∈ O := by
      apply sum_mem
      intro i _
      exact mul_mem (pow_mem hσ _) (pow_mem hq _)
    have hid : y - q ^ (l + 1) - ϖ ^ M * p = (x - σ ^ (l + 1) - ϖ ^ M * r) + (-(x - y)) +
        (σ - q) * (∑ i ∈ Finset.range (l + 1), σ ^ i * q ^ (l + 1 - 1 - i)) +
        ϖ ^ M * (r - p) := by
      linear_combination (-1 : K) * hGm
    have hvG : O.valuation (∑ i ∈ Finset.range (l + 1), σ ^ i * q ^ (l + 1 - 1 - i)) ≤ 1 :=
      (O.valuation_le_one_iff _).mpr hGO
    have hvϖ : O.valuation (ϖ ^ M) ≤ 1 := (O.valuation_le_one_iff _).mpr (pow_mem hϖ M)
    rw [hid]
    refine Valuation.map_add_lt _ (Valuation.map_add_lt _ (Valuation.map_add_lt _ h1 ?_) ?_) ?_
    · rw [Valuation.map_neg]; exact h2
    · rw [Valuation.map_mul]
      exact mul_lt_one_of_lt_of_le h3 hvG
    · rw [Valuation.map_mul, mul_comm]
      exact mul_lt_one_of_lt_of_le h4 hvϖ
  obtain ⟨a, s, hs, hxs⟩ := (hO₁ x).mp hx
  have hprem : ∀ M : ℕ, ∃ σ r s' t : A, s' ∉ 𝔭 ∧ t ∉ 𝔭 ∧
      t * (s' ^ (l + 1) * (s ^ l * a) - σ ^ (l + 1) - u ^ M * r) ∈ I := by
    intro M
    obtain ⟨σM, hσM, rM, hrM, hvM⟩ := hM M
    obtain ⟨aM, sM, hsM, hσq⟩ := (hO₁ σM).mp hσM
    obtain ⟨bM, tM, htM, hrp⟩ := (hO₁ rM).mp hrM
    have hD := hultra M x (algebraMap A K a / algebraMap A K s) σM
      (algebraMap A K aM / algebraMap A K sM) rM (algebraMap A K bM / algebraMap A K tM)
      (algebraMap A K u) (hO₁O σM hσM) (hfrac aM sM hsM) (hi u) hvM hxs hσq hrp
    have hC4 : algebraMap A K ((sM * tM) ^ (l + 1) * (s ^ l * a) - (s * aM * tM) ^ (l + 1) -
        u ^ M * ((s * sM) ^ (l + 1) * tM ^ l * bM)) =
        (algebraMap A K s * algebraMap A K sM * algebraMap A K tM) ^ (l + 1) *
        (algebraMap A K a / algebraMap A K s - (algebraMap A K aM / algebraMap A K sM) ^ (l + 1) -
          algebraMap A K u ^ M * (algebraMap A K bM / algebraMap A K tM)) := by
      have h1 := hne s hs
      have h2 := hne sM hsM
      have h3 := hne tM htM
      simp only [map_sub, map_mul, map_pow]
      rw [div_pow]
      field_simp
      ring
    have hvz : O.valuation (algebraMap A K ((sM * tM) ^ (l + 1) * (s ^ l * a) -
        (s * aM * tM) ^ (l + 1) - u ^ M * ((s * sM) ^ (l + 1) * tM ^ l * bM))) < 1 := by
      rw [hC4, Valuation.map_mul, Valuation.map_pow, Valuation.map_mul, Valuation.map_mul,
        hii s hs, hii sM hsM, hii tM htM, one_mul, one_mul, one_pow, one_mul]
      exact hD
    obtain ⟨t, ht, htz⟩ := hiv _ hvz
    refine ⟨s * aM * tM, (s * sM) ^ (l + 1) * tM ^ l * bM, sM * tM, t, ?_, ht, htz⟩
    intro h
    rcases hp.mem_or_mem h with h' | h'
    · exact hsM h'
    · exact htM h'
  obtain ⟨σ, s'', t'', hs'', ht'', hY⟩ := hA (s ^ l * a) hprem
  have hvY : O.valuation (algebraMap A K (s'' ^ (l + 1) * (s ^ l * a) - σ ^ (l + 1))) < 1 := by
    have h := hiii _ hY
    rwa [map_mul (algebraMap A K), Valuation.map_mul, hii t'' ht'', one_mul] at h
  refine ⟨algebraMap A K σ / (algebraMap A K s * algebraMap A K s''), ?_, ?_⟩
  · rw [hO₁]
    refine ⟨σ, s * s'', ?_, ?_⟩
    · intro h
      rcases hp.mem_or_mem h with h' | h'
      · exact hs h'
      · exact hs'' h'
    · rw [map_mul (algebraMap A K), sub_self, Valuation.map_zero]
      exact zero_lt_one
  · have hD : algebraMap A K a / algebraMap A K s -
        (algebraMap A K σ / (algebraMap A K s * algebraMap A K s'')) ^ (l + 1) =
        algebraMap A K (s'' ^ (l + 1) * (s ^ l * a) - σ ^ (l + 1)) /
          (algebraMap A K s * algebraMap A K s'') ^ (l + 1) := by
      have h1 := hne s hs
      have h2 := hne s'' hs''
      simp only [map_sub, map_mul, map_pow]
      rw [div_pow, div_sub_div _ _ h1 (pow_ne_zero _ (mul_ne_zero h1 h2)),
        div_eq_div_iff (mul_ne_zero h1 (pow_ne_zero _ (mul_ne_zero h1 h2)))
          (pow_ne_zero _ (mul_ne_zero h1 h2))]
      ring
    have hsplit : x - (algebraMap A K σ / (algebraMap A K s * algebraMap A K s'')) ^ (l + 1) =
        (x - algebraMap A K a / algebraMap A K s) + (algebraMap A K a / algebraMap A K s -
          (algebraMap A K σ / (algebraMap A K s * algebraMap A K s'')) ^ (l + 1)) := by ring
    rw [hsplit]
    apply Valuation.map_add_lt _ hxs
    rw [hD, map_div₀, Valuation.map_pow, Valuation.map_mul, hii s hs, hii s'' hs'', one_mul,
      one_pow, div_one]
    exact hvY

theorem wcpa_dj_llsm_kpwulbc_krull_pth : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (ℓ : ℕ), ℓ.Prime → ringChar (IsLocalRing.ResidueField ↥W) = ℓ → ∀ (A : Type u) [CommRing A] [Algebra ↥W A] (𝔭 I : Ideal A) (u : A), Algebra.FiniteType ↥W A → 𝔭.IsPrime → (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ I → I ≤ 𝔭 → u ∈ 𝔭 → ∀ a : A, (∀ M : ℕ, ∃ σ r s t : A, s ∉ 𝔭 ∧ t ∉ 𝔭 ∧ t * (s ^ ℓ * a - σ ^ ℓ - u ^ M * r) ∈ I) → ∃ σ s t : A, s ∉ 𝔭 ∧ t ∉ 𝔭 ∧ t * (s ^ ℓ * a - σ ^ ℓ) ∈ I :=
by

  have hKrull : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (ℓ : ℕ) [Fact ℓ.Prime] [CharP R ℓ] (N : ℕ) (b : Fin N → R), (∀ x : R, ∃ c : Fin N → R, x = ∑ i, c i ^ ℓ * b i) → ∀ u' ∈ IsLocalRing.maximalIdeal R, ∀ a : R, (∀ M : ℕ, ∃ σ r : R, a = σ ^ ℓ + u' ^ M * r) → ∃ σ : R, a = σ ^ ℓ := by
    intro R _ _ _ ℓ hℓ _ N b hb u' hu' a ha
    set S : Subring R := (frobenius R ℓ).range with hS
    have hSmem : ∀ x : R, x ∈ S ↔ ∃ y, y ^ ℓ = x := by
      intro x
      simp [S, RingHom.mem_range, frobenius_def]
    haveI : IsNoetherianRing S := isNoetherianRing_range (frobenius R ℓ)
    haveI : Module.Finite S R := by
      classical
      refine ⟨⟨Finset.univ.image b, ?_⟩⟩
      rw [eq_top_iff]
      intro x _
      obtain ⟨c, rfl⟩ := hb x
      refine Submodule.sum_mem _ (fun i _ => ?_)
      have : c i ^ ℓ * b i = (⟨c i ^ ℓ, (hSmem _).2 ⟨c i, rfl⟩⟩ : S) • b i := rfl
      rw [this]
      exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))
    set P : Submodule S R := LinearMap.range (Algebra.linearMap S R) with hP
    have hPmem : ∀ x : R, x ∈ P ↔ x ∈ S := by
      intro x
      constructor
      · rintro ⟨y, rfl⟩
        exact y.2
      · intro hx
        exact ⟨⟨x, hx⟩, rfl⟩
    let v : S := ⟨u' ^ ℓ, (hSmem _).2 ⟨u', rfl⟩⟩
    set J : Ideal S := Ideal.span {v} with hJ
    have hmem : P.mkQ a ∈ ⨅ i : ℕ, J ^ i • (⊤ : Submodule S (R ⧸ P)) := by
      rw [Submodule.mem_iInf]
      intro i
      obtain ⟨σ, r, hσr⟩ := ha (ℓ * i)
      have h1 : P.mkQ a = (v ^ i) • P.mkQ r := by
        rw [← LinearMap.map_smul, Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq,
          hPmem]
        have : (v ^ i) • r = u' ^ (ℓ * i) * r := by
          show ((v ^ i : S) : R) * r = _
          rw [SubmonoidClass.coe_pow, pow_mul]
        rw [this, hσr, add_sub_cancel_right]
        exact (hSmem _).2 ⟨σ, rfl⟩
      rw [h1]
      exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self v) i)
        Submodule.mem_top
    obtain ⟨j, hj⟩ := (Ideal.mem_iInf_smul_pow_eq_bot_iff J (P.mkQ a)).mp hmem
    have hj' : (j : S) • a - a ∈ S := by
      have : P.mkQ ((j : S) • a - a) = 0 := by
        rw [map_sub, LinearMap.map_smul, hj, sub_self]
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, hPmem] at this
      exact this
    have hj'' : a - ((j : S) : R) * a ∈ S := by
      have := S.neg_mem hj'
      rw [neg_sub] at this
      exact this
    obtain ⟨ζ, hζ⟩ := (hSmem _).1 hj''
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp j.2
    obtain ⟨γc, hγc⟩ := (hSmem _).1 c.2
    have hjR : ((j : S) : R) = (γc * u') ^ ℓ := by
      rw [← hc]
      show (c : R) * (u' ^ ℓ) = _
      rw [← hγc, mul_pow]
    have hγm : γc * u' ∈ IsLocalRing.maximalIdeal R := Ideal.mul_mem_left _ _ hu'
    have hunit : IsUnit (1 - γc * u') :=
      IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ ((IsLocalRing.mem_maximalIdeal _).mp hγm)
    obtain ⟨δ, hδ⟩ := hunit.exists_left_inv
    refine ⟨δ * ζ, ?_⟩
    have hpow : (1 - γc * u') ^ ℓ = 1 - (γc * u') ^ ℓ := by rw [sub_pow_char, one_pow]
    calc a = (δ * (1 - γc * u')) ^ ℓ * a := by rw [hδ, one_pow, one_mul]
      _ = δ ^ ℓ * (a - ((j : S) : R) * a) := by rw [mul_pow, hpow, hjR]; ring
      _ = (δ * ζ) ^ ℓ := by rw [← hζ, mul_pow]

  have hClos : ∀ (R₀ R' B : Type u) [CommRing R₀] [CommRing R'] [CommRing B] [Algebra R₀ B]
      [Algebra R' B] (s : Finset B), Algebra.adjoin R₀ (s : Set B) = ⊤ →
      (∀ w : R₀, algebraMap R₀ B w ∈ Set.range (algebraMap R' B)) →
      Algebra.adjoin R' (s : Set B) = ⊤ := by
    intro R₀ R' B _ _ _ _ _ s hs h
    rw [eq_top_iff]
    intro y _
    have hy : y ∈ (Algebra.adjoin R₀ (s : Set B)).toSubring := by rw [hs]; trivial
    rw [Algebra.adjoin_eq_ring_closure] at hy
    have hle : Subring.closure (Set.range (algebraMap R₀ B) ∪ (s : Set B)) ≤
        (Algebra.adjoin R' (s : Set B)).toSubring := by
      rw [Subring.closure_le]
      refine Set.union_subset ?_ Algebra.subset_adjoin
      rintro _ ⟨w, rfl⟩
      obtain ⟨w', hw'⟩ := h w
      rw [← hw']
      exact Subalgebra.algebraMap_mem _ w'
    exact hle hy

  have hFrobGen : ∀ (R₀ B : Type u) [CommRing R₀] [CommRing B] [Algebra R₀ B] (ℓ : ℕ) [Fact ℓ.Prime] [CharP B ℓ], Algebra.FiniteType R₀ B → (∀ w : R₀, ∃ w' : R₀, w' ^ ℓ = w) → ∃ (N : ℕ) (b : Fin N → B), ∀ x : B, ∃ c : Fin N → B, x = ∑ i, c i ^ ℓ * b i := by
    intro R₀ B _ _ _ ℓ hℓ _ hFT hroot
    set S : Subring B := (frobenius B ℓ).range with hS
    have hSmem : ∀ x : B, x ∈ S ↔ ∃ y, y ^ ℓ = x := by
      intro x
      simp [S, RingHom.mem_range, frobenius_def]
    obtain ⟨s, hs⟩ := hFT.out
    haveI : Algebra.FiniteType S B := by
      refine ⟨⟨s, ?_⟩⟩
      refine hClos R₀ S B s hs ?_
      intro w
      obtain ⟨w', hw'⟩ := hroot w
      exact ⟨⟨algebraMap R₀ B w' ^ ℓ, (hSmem _).2 ⟨_, rfl⟩⟩, by rw [← hw', map_pow]; rfl⟩
    haveI : Algebra.IsIntegral S B := by
      constructor
      intro x
      refine ⟨Polynomial.X ^ ℓ - Polynomial.C ⟨x ^ ℓ, (hSmem _).2 ⟨x, rfl⟩⟩,
        Polynomial.monic_X_pow_sub_C _ hℓ.out.ne_zero, ?_⟩
      simp [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
      rw [sub_eq_zero]
      rfl
    haveI : Module.Finite S B := Algebra.IsIntegral.finite
    obtain ⟨N, b, hb⟩ := Module.Finite.exists_fin (R := S) (M := B)
    refine ⟨N, b, fun x => ?_⟩
    have hx : x ∈ Submodule.span S (Set.range b) := by
      rw [hb]; trivial
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun S).mp hx
    choose d hd using fun i => (hSmem _).1 (c i).2
    refine ⟨d, ?_⟩
    rw [← hc]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hd i]
    rfl

  have hNoeth : ∀ (W : Type u) [CommRing W] [IsLocalRing W] (B : Type u) [CommRing B] [Algebra W B], Algebra.FiniteType W B → (∀ w ∈ IsLocalRing.maximalIdeal W, algebraMap W B w = 0) → IsNoetherianRing B := by
    intro W _ _ B _ _ hFT hk
    let φ : IsLocalRing.ResidueField W →+* B :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal W) (algebraMap W B) hk
    letI : Algebra (IsLocalRing.ResidueField W) B := φ.toAlgebra
    obtain ⟨s, hs⟩ := hFT.out
    haveI : Algebra.FiniteType (IsLocalRing.ResidueField W) B := by
      refine ⟨⟨s, ?_⟩⟩
      refine hClos W _ B s hs ?_
      intro w
      exact ⟨IsLocalRing.residue W w, rfl⟩
    exact Algebra.FiniteType.isNoetherianRing (IsLocalRing.ResidueField W) B

  have hFrobLoc : ∀ (B : Type u) [CommRing B] (𝔮 : Ideal B) [𝔮.IsPrime] (ℓ : ℕ), 0 < ℓ → ∀ (N : ℕ) (b : Fin N → B), (∀ x : B, ∃ c : Fin N → B, x = ∑ i, c i ^ ℓ * b i) → ∀ y : Localization.AtPrime 𝔮, ∃ c : Fin N → Localization.AtPrime 𝔮, y = ∑ i, c i ^ ℓ * algebraMap B (Localization.AtPrime 𝔮) (b i) := by
    intro B _ 𝔮 _ ℓ hℓ N b hb y
    obtain ⟨⟨β, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔮.primeCompl y
    set z := IsLocalization.mk' (Localization.AtPrime 𝔮) (1 : B) s with hzdef
    have hz : z * algebraMap B (Localization.AtPrime 𝔮) (s : B) = 1 := by
      rw [hzdef, IsLocalization.mk'_spec, map_one]
    obtain ⟨m, rfl⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, by omega⟩
    obtain ⟨c, hc⟩ := hb (β * (s : B) ^ m)
    have e : algebraMap B (Localization.AtPrime 𝔮) β * z =
        algebraMap B (Localization.AtPrime 𝔮) (β * (s : B) ^ m) * z ^ (m + 1) := by
      rw [map_mul, map_pow]
      calc algebraMap B (Localization.AtPrime 𝔮) β * z
          = algebraMap B (Localization.AtPrime 𝔮) β * z *
            (z * algebraMap B (Localization.AtPrime 𝔮) (s : B)) ^ m := by rw [hz, one_pow, mul_one]
        _ = _ := by ring
    refine ⟨fun i => algebraMap B (Localization.AtPrime 𝔮) (c i) * z, ?_⟩
    show IsLocalization.mk' (Localization.AtPrime 𝔮) β s = _
    rw [IsLocalization.mk'_eq_mul_mk'_one, ← hzdef, e, hc, map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_mul, map_pow]
    ring

  have hLocHyp : ∀ (B : Type u) [CommRing B] (𝔮 : Ideal B) [𝔮.IsPrime] (ℓ M : ℕ) (a u σ r s t : B), s ∉ 𝔮 → t ∉ 𝔮 → t * (s ^ ℓ * a - σ ^ ℓ - u ^ M * r) = 0 → ∃ σ' r' : Localization.AtPrime 𝔮, algebraMap B (Localization.AtPrime 𝔮) a = σ' ^ ℓ + algebraMap B (Localization.AtPrime 𝔮) u ^ M * r' := by
    intro B _ 𝔮 _ ℓ M a u σ r s t hs ht h
    set ι := algebraMap B (Localization.AtPrime 𝔮)
    have hut : IsUnit (ι t) := IsLocalization.map_units (Localization.AtPrime 𝔮) (⟨t, ht⟩ : 𝔮.primeCompl)
    have hus : IsUnit (ι s) := IsLocalization.map_units (Localization.AtPrime 𝔮) (⟨s, hs⟩ : 𝔮.primeCompl)
    have h1 : ι t * (ι s ^ ℓ * ι a - ι σ ^ ℓ - ι u ^ M * ι r) = 0 := by
      have := congrArg ι h
      simpa [map_mul, map_sub, map_pow] using this
    have h2 : ι s ^ ℓ * ι a - ι σ ^ ℓ - ι u ^ M * ι r = 0 := hut.mul_right_eq_zero.mp h1
    obtain ⟨z, hz⟩ := hus.exists_left_inv
    have hz' : z ^ ℓ * ι s ^ ℓ = 1 := by rw [← mul_pow, hz, one_pow]
    refine ⟨ι σ * z, ι r * z ^ ℓ, ?_⟩
    linear_combination z ^ ℓ * h2 - ι a * hz'

  have hLocConcl : ∀ (B : Type u) [CommRing B] (𝔮 : Ideal B) [𝔮.IsPrime] (ℓ : ℕ) (a : B) (τ : Localization.AtPrime 𝔮), algebraMap B (Localization.AtPrime 𝔮) a = τ ^ ℓ → ∃ σ s t : B, s ∉ 𝔮 ∧ t ∉ 𝔮 ∧ t * (s ^ ℓ * a - σ ^ ℓ) = 0 := by
    intro B _ 𝔮 _ ℓ a τ hτ
    obtain ⟨⟨β, s₀⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔮.primeCompl τ
    have hspec := IsLocalization.mk'_spec (Localization.AtPrime 𝔮) β s₀
    have h0 : algebraMap B (Localization.AtPrime 𝔮) ((s₀ : B) ^ ℓ * a - β ^ ℓ) = 0 := by
      rw [map_sub, map_mul, map_pow, map_pow, hτ, ← hspec]
      ring
    obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff 𝔮.primeCompl _ _).mp h0
    exact ⟨β, s₀, m, s₀.2, m.2, hm⟩

  intro Ω _ _ W ℓ hℓ hκ A _ _ 𝔭 I u hFT h𝔭 hmI hI𝔭 hu a ha

  have hroot : ∀ w : ↥W, ∃ w' : ↥W, w' ^ ℓ = w := by
    intro x
    obtain ⟨y₀, hy₀⟩ := IsAlgClosed.exists_pow_nat_eq (x : Ω) hℓ.pos
    have hy₀W : y₀ ∈ W := by
      rcases W.mem_or_inv_mem y₀ with h1 | h1
      · exact h1
      · by_cases hy0 : y₀ = 0
        · rw [hy0]; exact W.toSubring.zero_mem
        · obtain ⟨M', hM'⟩ : ∃ M', ℓ = M' + 1 := ⟨ℓ - 1, by have := hℓ.pos; omega⟩
          rw [hM'] at hy₀
          have e : y₀ = (x : Ω) * (y₀⁻¹) ^ M' := by
            rw [← hy₀, pow_succ, mul_comm (y₀ ^ M') y₀, mul_assoc, ← mul_pow,
              mul_inv_cancel₀ hy0, one_pow, mul_one]
          rw [e]
          exact W.toSubring.mul_mem x.2 (W.toSubring.pow_mem h1 _)
    exact ⟨⟨y₀, hy₀W⟩, Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hy₀)⟩

  set B := A ⧸ I
  set mk := Ideal.Quotient.mk I
  haveI hFTB : Algebra.FiniteType ↥W B := by
    haveI := hFT
    exact Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ ↥W I) (Ideal.Quotient.mkₐ_surjective ↥W I)
  have hkill : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, algebraMap ↥W B w = 0 := by
    intro w hw
    have e : algebraMap ↥W B w = mk (algebraMap ↥W A w) := rfl
    rw [e, Ideal.Quotient.eq_zero_iff_mem]
    exact hmI (Ideal.mem_map_of_mem _ hw)
  have hℓWm : ((ℓ : ℕ) : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [← IsLocalRing.residue_eq_zero_iff, map_natCast]
    exact (ringChar.spec _ ℓ).mpr (by rw [hκ])
  have hℓB : ((ℓ : ℕ) : B) = 0 := by
    rw [← map_natCast (algebraMap ↥W B)]
    exact hkill _ hℓWm
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : Nontrivial B := Ideal.Quotient.nontrivial_iff.mpr (fun h => h𝔭.ne_top (top_le_iff.mp (h ▸ hI𝔭)))
  haveI : CharP B ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hℓB
  have hker : RingHom.ker mk ≤ 𝔭 := by rw [Ideal.mk_ker]; exact hI𝔭
  set 𝔮 : Ideal B := Ideal.map mk 𝔭
  haveI h𝔮 : 𝔮.IsPrime := Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker
  have h𝔮mem : ∀ x : A, mk x ∈ 𝔮 ↔ x ∈ 𝔭 := fun x => Ideal.mem_quotient_iff_mem hI𝔭

  haveI : IsNoetherianRing B := hNoeth ↥W B hFTB hkill
  obtain ⟨N, b, hb⟩ := hFrobGen ↥W B ℓ hFTB hroot

  set R := Localization.AtPrime 𝔮
  set ι := algebraMap B R
  haveI : CharP R ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr (by rw [← map_natCast ι, hℓB, map_zero])
  obtain hbR := hFrobLoc B 𝔮 ℓ hℓ.pos N b hb
  have hu' : ι (mk u) ∈ IsLocalRing.maximalIdeal R :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff R 𝔮 (mk u)).mpr ((h𝔮mem u).mpr hu)
  have hhyp : ∀ M : ℕ, ∃ σ r : R, ι (mk a) = σ ^ ℓ + ι (mk u) ^ M * r := by
    intro M
    obtain ⟨σ, r, s, t, hs, ht, hI⟩ := ha M
    have h0 : mk t * (mk s ^ ℓ * mk a - mk σ ^ ℓ - mk u ^ M * mk r) = 0 := by
      have := (Ideal.Quotient.eq_zero_iff_mem).mpr hI
      simpa [map_mul, map_sub, map_pow] using this
    exact hLocHyp B 𝔮 ℓ M (mk a) (mk u) (mk σ) (mk r) (mk s) (mk t)
      (fun h => hs ((h𝔮mem s).mp h)) (fun h => ht ((h𝔮mem t).mp h)) h0
  haveI hRnoeth : IsNoetherianRing R :=
    IsLocalization.isNoetherianRing 𝔮.primeCompl R (inferInstance : IsNoetherianRing B)
  haveI hRloc : IsLocalRing R := Localization.AtPrime.isLocalRing 𝔮
  obtain ⟨τ, hτ⟩ := @hKrull R _ hRloc hRnoeth ℓ _ _ N (fun i => ι (b i)) hbR (ι (mk u)) hu' (ι (mk a)) hhyp
  obtain ⟨σ₀, s₀, t₀, hs₀, ht₀, h0⟩ := hLocConcl B 𝔮 ℓ (mk a) τ hτ
  obtain ⟨σ, rfl⟩ := Ideal.Quotient.mk_surjective σ₀
  obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective s₀
  obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective t₀
  refine ⟨σ, s, t, fun h => hs₀ ((h𝔮mem s).mpr h), fun h => ht₀ ((h𝔮mem t).mpr h), ?_⟩
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  simpa [map_mul, map_sub, map_pow] using h0

