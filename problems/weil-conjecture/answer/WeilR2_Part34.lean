    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L]
    (𝔭 : Ideal A) (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ b : ↥W, b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → b ∣ g →
    ∀ (s : K), s = algebraMap A K (algebraMap ↥W A b) / algebraMap A K u →
    ∀ (Qb : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) [Qb.IsPrime],
      Qb.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) =
        Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) u,
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) →
    ∀ (P : Type u) [CommRing P] (e : Localization.AtPrime Qb →+* P),
      wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime Qb)) P e →
      ¬ IsUnit (e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)
          (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
            (algebraMap A ↥(Algebra.adjoin A {s}) u)))) ∧
      ¬ IsUnit (e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)
          (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
            ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩))) ∧
      e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)
          (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
            (algebraMap A ↥(Algebra.adjoin A {s}) u))) *
        e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)
          (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
            ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩)) =
        (e.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
          (Localization.AtPrime Qb)).comp ((algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))))) b ∧
      ∀ 𝔓 ∈ (Ideal.map (e.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
          (Localization.AtPrime Qb)).comp ((algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)))))
          (IsLocalRing.maximalIdeal ↥W)).minimalPrimes,
        ¬ (e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)
            (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
              (algebraMap A ↥(Algebra.adjoin A {s}) u))) ∈ 𝔓 ∧
          e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)
            (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
              ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩)) ∈ 𝔓) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ 𝔭 u v g hPD b hbm hb0 hbg s hs Qb _ hQb P _ e he
  classical
  obtain ⟨N, hNdef⟩ : ∃ N : Ideal ↥(Algebra.adjoin A {s}), N =
