  obtain ⟨O, hOmem, hroot'⟩ := wcLlsASbba_branch_valring Ω W hW hWt A K 𝔭 u v g hPD
  obtain ⟨ψ, hψW, hψX, hψfs⟩ := wcLlsASbba_ratfunc_chart Ω W hW hWt A K 𝔭 u v g hPD
  letI : Algebra (RatFunc Ω) K := ψ.toAlgebra
  obtain ⟨hfd, hsep⟩ := hψfs
  haveI := hfd
  haveI := hsep
  have hc := wcLlsASbba_gauss_contract Ω W hW hWt A K 𝔭 u v g hPD ψ hψW hψX O hOmem
  have hc' : ∀ f : RatFunc Ω, algebraMap (RatFunc Ω) K f ∈ O ↔ f ∈ wcEbGauss W := by
    intro f
