      IsDomain (Localization.AtPrime 𝔓) ∧ IsIntegrallyClosed (Localization.AtPrime 𝔓) ∧
      ∃ g : wcEbntN W ζ →+* Localization.AtPrime 𝔓,
        RingHom.FormallyUnramified (R := wcEbntN W ζ) (S := Localization.AtPrime 𝔓) g ∧
        RingHom.EssFiniteType (R := wcEbntN W ζ) (S := Localization.AtPrime 𝔓) g ∧
        g.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
          (algebraMap E (Localization.AtPrime 𝔓)).comp (algebraMap ↥W E) ∧
        g (wcEbntX W ζ 0) = algebraMap E (Localization.AtPrime 𝔓) Z ∧
        g (wcEbntX W ζ 1) = algebraMap E (Localization.AtPrime 𝔓) Z' := by
    intro E _ _ ζ Z Z' 𝔓 h𝔓 hζ hch
    obtain ⟨e, f, he, hfC, hf0, hf1, hfet, -⟩ := hch
    obtain ⟨hNd, hNic⟩ := wcNd_nodal_poly_normal Ω W ζ hζ
    letI : Algebra (wcEbntN W ζ) (Localization.Away e) := f.toAlgebra
    haveI : Algebra.Etale (wcEbntN W ζ) (Localization.Away e) := hfet
    have hdisj : Disjoint (↑(Submonoid.powers e) : Set E) (↑𝔓 : Set E) := by
      rw [Set.disjoint_left]
      rintro _ ⟨n, rfl⟩ hmem
      exact he (h𝔓.mem_of_pow_mem n hmem)
    haveI hP' : (𝔓.map (algebraMap E (Localization.Away e))).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers e) _ 𝔓 h𝔓 hdisj
    have hcomap : (𝔓.map (algebraMap E (Localization.Away e))).comap
        (algebraMap E (Localization.Away e)) = 𝔓 :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers e) _ h𝔓 hdisj
    obtain ⟨hD', hIC'⟩ := wc_pks_etale_localization_normal (wcEbntN W ζ) (Localization.Away e)
      (𝔓.map (algebraMap E (Localization.Away e)))
    haveI hloc : IsLocalization 𝔓.primeCompl
