theorem wcpa_dj_llsm_scrs_contraction : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L]
    (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c c' b r q : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → c' ∈ IsLocalRing.maximalIdeal ↥W →
      r ≠ 0 → c' - c = r → q ∈ IsLocalRing.maximalIdeal ↥W → b = r * q → b ≠ 0 →
    ∀ (s : K), s = algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c) →
    ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) [Q.IsPrime],
      Q.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) =
        wcLlsScN W A K t c' r →
    ∃ (Qb : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) (_ : Qb.IsPrime),
      Qb.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) =
        Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c),
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) ∧
      ∀ x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L),
        ∃ y d : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L),
          d ∉ Q ∧ (x : L) * (d : L) = (y : L) ∧ (x ∈ Qb ↔ y ∈ Q) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ 𝔭 t hPD c c' b r q hc hc' hr0 hcr hq hbrq hb0 s hs

  have s4 : ∀ (C₁ C₂ L : Type u) [CommRing C₁] [CommRing C₂] [CommRing L] (i₁ : C₁ →+* L)
      (i₂ : C₂ →+* L), Function.Injective i₂ → ∀ (Q : Ideal C₂), Q.IsPrime →
      (∀ x : C₁, ∃ y d : C₂, d ∉ Q ∧ i₁ x * i₂ d = i₂ y) →
      ∃ Qb : Ideal C₁, Qb.IsPrime ∧ ∀ (x : C₁) (y d : C₂), d ∉ Q → i₁ x * i₂ d = i₂ y →
        (x ∈ Qb ↔ y ∈ Q) := by
    intro C₁ C₂ L _ _ _ i₁ i₂ hi Q hQ hpres
    have h1Q : (1 : C₂) ∉ Q := fun h => hQ.ne_top ((Ideal.eq_top_iff_one Q).mpr h)
    have WD : ∀ (x : C₁) (y d y' d' : C₂), d ∉ Q → i₁ x * i₂ d = i₂ y → d' ∉ Q →
        i₁ x * i₂ d' = i₂ y' → y ∈ Q → y' ∈ Q := by
      intro x y d y' d' hd h hd' h' hy
      have e : y * d' = y' * d := hi (by rw [map_mul, map_mul, ← h, ← h']; ring)
      have hm : y' * d ∈ Q := e ▸ Q.mul_mem_right d' hy
      exact (hQ.mem_or_mem hm).resolve_right hd
    let Qb : Ideal C₁ :=
      { carrier := {x | ∃ y d : C₂, d ∉ Q ∧ i₁ x * i₂ d = i₂ y ∧ y ∈ Q}
        add_mem' := by
          rintro x₁ x₂ ⟨y₁, d₁, hd₁, h₁, hy₁⟩ ⟨y₂, d₂, hd₂, h₂, hy₂⟩
          refine ⟨y₁ * d₂ + y₂ * d₁, d₁ * d₂, fun h => (hQ.mem_or_mem h).elim hd₁ hd₂, ?_,
            Q.add_mem (Q.mul_mem_right _ hy₁) (Q.mul_mem_right _ hy₂)⟩
          rw [map_add, map_mul, map_add, map_mul, map_mul, ← h₁, ← h₂]
          ring
        zero_mem' := ⟨0, 1, h1Q, by simp, Q.zero_mem⟩
        smul_mem' := by
          rintro c x ⟨y, d, hd, h, hy⟩
          obtain ⟨w, e, he, hc⟩ := hpres c
          refine ⟨w * y, e * d, fun h' => (hQ.mem_or_mem h').elim he hd, ?_, Q.mul_mem_left _ hy⟩
          rw [smul_eq_mul, map_mul, map_mul, map_mul, ← hc, ← h]
          ring }
    have memQb : ∀ x, x ∈ Qb ↔ ∃ y d : C₂, d ∉ Q ∧ i₁ x * i₂ d = i₂ y ∧ y ∈ Q := fun x => Iff.rfl
    refine ⟨Qb, ⟨?_, ?_⟩, ?_⟩
    · intro htop
      have h1 : (1 : C₁) ∈ Qb := htop ▸ Submodule.mem_top
      obtain ⟨y, d, hd, h, hy⟩ := (memQb 1).mp h1
      exact h1Q (WD 1 y d 1 1 hd h h1Q (by simp) hy)
    · intro a b hab
      obtain ⟨y, d, hd, h, hy⟩ := (memQb _).mp hab
      obtain ⟨y₁, d₁, hd₁, h₁⟩ := hpres a
      obtain ⟨y₂, d₂, hd₂, h₂⟩ := hpres b
      have hy12 : y₁ * y₂ ∈ Q := WD (a * b) y d (y₁ * y₂) (d₁ * d₂) hd h
        (fun h' => (hQ.mem_or_mem h').elim hd₁ hd₂)
        (by rw [map_mul, map_mul, map_mul, ← h₁, ← h₂]; ring) hy
      rcases hQ.mem_or_mem hy12 with h' | h'
      · exact Or.inl ((memQb a).mpr ⟨y₁, d₁, hd₁, h₁, h'⟩)
      · exact Or.inr ((memQb b).mpr ⟨y₂, d₂, hd₂, h₂, h'⟩)
    · intro x y d hd h
      constructor
      · intro hx
        obtain ⟨y', d', hd', h', hy'⟩ := (memQb x).mp hx
        exact WD x y' d' y d hd' h' hd h hy'
      · intro hy
        exact (memQb x).mpr ⟨y, d, hd, h, hy⟩

  have s6 : ∀ (A : Type u) [CommRing A] (K : Type u) [CommRing K] [Algebra A K] (s : K)
      (𝔭 : Ideal A), 𝔭.IsMaximal → ∀ (I J : Ideal ↥(Algebra.adjoin A {s})),
      (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) ∈ I →
      𝔭.map (algebraMap A ↥(Algebra.adjoin A {s})) ≤ I → I ≤ J → J ≠ ⊤ → J = I := by
    intro A _ K _ _ s 𝔭 h𝔭 I J hs hpI hIJ hJ
    have claim : ∀ a : ↥(Algebra.adjoin A {s}), ∃ a₀ : A,
        a - algebraMap A ↥(Algebra.adjoin A {s}) a₀ ∈ I := by
      rintro ⟨a, ha⟩
      induction ha using Algebra.adjoin_induction with
      | mem x hx =>
        rw [Set.mem_singleton_iff] at hx
        subst hx
        exact ⟨0, by rw [map_zero, sub_zero]; exact hs⟩
      | algebraMap a =>
        refine ⟨a, ?_⟩
        have e : (⟨algebraMap A K a, Subalgebra.algebraMap_mem _ a⟩ : ↥(Algebra.adjoin A {s})) =
            algebraMap A ↥(Algebra.adjoin A {s}) a := rfl
        rw [e, sub_self]
        exact I.zero_mem
      | add x y hx hy ihx ihy =>
        obtain ⟨a, ha⟩ := ihx
        obtain ⟨b, hb⟩ := ihy
        refine ⟨a + b, ?_⟩
        have e : (⟨x + y, add_mem hx hy⟩ : ↥(Algebra.adjoin A {s})) = ⟨x, hx⟩ + ⟨y, hy⟩ := rfl
        rw [e, map_add]
        convert I.add_mem ha hb using 1
        ring
      | mul x y hx hy ihx ihy =>
        obtain ⟨a, ha⟩ := ihx
        obtain ⟨b, hb⟩ := ihy
        refine ⟨a * b, ?_⟩
        have e : (⟨x * y, mul_mem hx hy⟩ : ↥(Algebra.adjoin A {s})) = ⟨x, hx⟩ * ⟨y, hy⟩ := rfl
        rw [e, map_mul]
        convert I.add_mem (I.mul_mem_left ⟨x, hx⟩ hb)
          (I.mul_mem_left (algebraMap A ↥(Algebra.adjoin A {s}) b) ha) using 1
        ring
    refine le_antisymm ?_ hIJ
    intro a ha
    obtain ⟨a₀, h₀⟩ := claim a
    by_cases h : a₀ ∈ 𝔭
    · have h' : algebraMap A ↥(Algebra.adjoin A {s}) a₀ ∈ I := hpI (Ideal.mem_map_of_mem _ h)
      simpa using I.add_mem h₀ h'
    · exfalso
      obtain ⟨y, i, hi, hyi⟩ := h𝔭.exists_inv h
      apply hJ
      rw [Ideal.eq_top_iff_one]
      have h1 : algebraMap A ↥(Algebra.adjoin A {s}) a₀ ∈ J := by
        simpa using J.sub_mem ha (hIJ h₀)
      have h2 : algebraMap A ↥(Algebra.adjoin A {s}) i ∈ J :=
        hIJ (hpI (Ideal.mem_map_of_mem _ hi))
      have h3 := J.add_mem (J.mul_mem_left (algebraMap A ↥(Algebra.adjoin A {s}) y) h1) h2
      rwa [← map_mul, ← map_add, hyi, map_one] at h3

  have s5 : ∀ (A : Type u) [CommRing A] (K : Type u) [Field K] [Algebra A K] (L : Type u)
      [Field L] [Algebra K L] (R T : Subalgebra A K) (w : K), w ∈ R →
      (∀ a ∈ T, ∃ n : ℕ, a * w ^ n ∈ R) → ∀ x : L, IsIntegral ↥T x →
      ∃ N : ℕ, IsIntegral ↥R (x * algebraMap K L w ^ N) := by
    intro A _ K _ _ L _ _ R T w hw hT x hx
    obtain ⟨p, hpm, hpx⟩ := hx
    choose! n hn using hT
    have hnN : ∀ i < p.natDegree + 1, n (p.coeff i : K) ≤
        ∑ j ∈ Finset.range (p.natDegree + 1), n (p.coeff j : K) := fun i hi =>
      Finset.single_le_sum (f := fun j => n (p.coeff j : K)) (fun _ _ => Nat.zero_le _)
        (Finset.mem_range.mpr hi)
    generalize ∑ j ∈ Finset.range (p.natDegree + 1), n (p.coeff j : K) = N at hnN
    have hp'm : (p.map (algebraMap T K)).Monic := hpm.map _
    have hdeg : (p.map (algebraMap T K)).natDegree = p.natDegree := hpm.natDegree_map _
    have hq₀m : ((p.map (algebraMap T K)).scaleRoots (w ^ N)).Monic :=
      (Polynomial.monic_scaleRoots_iff _).mpr hp'm
    have hlift : (p.map (algebraMap T K)).scaleRoots (w ^ N) ∈
        Polynomial.lifts (algebraMap R K) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [Polynomial.coeff_scaleRoots, hdeg]
      have hmem : (p.map (algebraMap T K)).coeff i * (w ^ N) ^ (p.natDegree - i) ∈ R := by
        rcases lt_trichotomy i p.natDegree with hi | hi | hi
        · rw [Polynomial.coeff_map, show algebraMap T K (p.coeff i) = (p.coeff i : K) from rfl]
          have h1 := hn _ (p.coeff i).2
          have h2 : n (p.coeff i : K) ≤ N * (p.natDegree - i) :=
            le_trans (hnN i (by omega)) (Nat.le_mul_of_pos_right N (by omega))
          have e : (p.coeff i : K) * (w ^ N) ^ (p.natDegree - i) =
              ((p.coeff i : K) * w ^ n (p.coeff i : K)) *
                w ^ (N * (p.natDegree - i) - n (p.coeff i : K)) := by
            rw [← pow_mul, mul_assoc, ← pow_add, Nat.add_sub_cancel' h2]
          rw [e]
          exact R.mul_mem h1 (R.pow_mem hw _)
        · subst hi
          rw [Nat.sub_self, pow_zero, mul_one]
          have h1 := hp'm.coeff_natDegree
          rw [hdeg] at h1
          rw [h1]
          exact R.one_mem
        · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by rw [hdeg]; exact hi), zero_mul]
          exact R.zero_mem
      exact ⟨⟨_, hmem⟩, rfl⟩
    obtain ⟨P, hPmap, _, hPm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hq₀m
    refine ⟨N, P, hPm, ?_⟩
    have hRL : algebraMap R L = (algebraMap K L).comp (algebraMap R K) :=
      RingHom.ext fun _ => rfl
    have hTL : algebraMap T L = (algebraMap K L).comp (algebraMap T K) :=
      RingHom.ext fun _ => rfl
    rw [hRL, ← Polynomial.eval₂_map, hPmap]
    have e : x * algebraMap K L w ^ N = algebraMap K L (w ^ N) * x := by rw [map_pow, mul_comm]
    rw [e, Polynomial.scaleRoots_eval₂_mul, Polynomial.eval₂_map, ← hTL, hpx, mul_zero]

  obtain ⟨_, hNZ, _, h𝔭max, _, _, h𝔭eq, _⟩ := hPD
  have := hNZ
  have hrA : algebraMap (↥W) A r ≠ 0 := by
    intro h
    rw [Algebra.algebraMap_eq_smul_one] at h
    rcases smul_eq_zero.mp h with h1 | h1
    · exact hr0 h1
    · exact one_ne_zero h1
  have hrK : algebraMap A K (algebraMap (↥W) A r) ≠ 0 := fun h =>
    hrA ((IsFractionRing.injective A K) (by rw [h, map_zero]))
  have hrm : r ∈ IsLocalRing.maximalIdeal ↥W := hcr ▸ Ideal.sub_mem _ hc' hc

  suffices key : ∀ (S : K), S = algebraMap A K (t - algebraMap (↥W) A c') /
        algebraMap A K (algebraMap (↥W) A r) →
      ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {S}) L)), Q.IsPrime →
      Q.comap (algebraMap ↥(Algebra.adjoin A {S}) ↥(integralClosure ↥(Algebra.adjoin A {S}) L)) =
        Ideal.span {(⟨S, Algebra.subset_adjoin (Set.mem_singleton S)⟩ : ↥(Algebra.adjoin A {S}))} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {S})).comp (algebraMap (↥W) A)) →
      ∃ (Qb : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) (_ : Qb.IsPrime),
        Qb.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) =
          Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c),
            ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
          (IsLocalRing.maximalIdeal ↥W).map
            ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) ∧
        ∀ x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L),
          ∃ y d : ↥(integralClosure ↥(Algebra.adjoin A {S}) L),
            d ∉ Q ∧ (x : L) * (d : L) = (y : L) ∧ (x ∈ Qb ↔ y ∈ Q) by
    intro Q hQp hQ
    exact key _ rfl Q hQp hQ
  intro S hSval Q hQp hQ

  have I1 : algebraMap A K (algebraMap (↥W) A r) * (1 + S) =
      algebraMap A K (t - algebraMap (↥W) A c) := by
    have e1 : algebraMap A K (algebraMap (↥W) A r) * S = algebraMap A K (t - algebraMap (↥W) A c') := by
      rw [hSval]; field_simp
    have e2 : algebraMap A K (t - algebraMap (↥W) A c) =
        algebraMap A K (t - algebraMap (↥W) A c') + algebraMap A K (algebraMap (↥W) A r) := by
      rw [← hcr]; simp only [map_sub]; ring
    rw [e2, mul_add, mul_one, e1]; ring
  have hwR : (1 + S : K) ∈ Algebra.adjoin A {S} :=
    add_mem (Subalgebra.one_mem _) (Algebra.subset_adjoin (Set.mem_singleton S))
  have hcoe : ∀ z : ↥(Algebra.adjoin A {S}),
      ((algebraMap ↥(Algebra.adjoin A {S}) ↥(integralClosure ↥(Algebra.adjoin A {S}) L) z :
        ↥(integralClosure ↥(Algebra.adjoin A {S}) L)) : L) = algebraMap K L (z : K) := fun z => rfl
  have hN : ∀ z ∈ Ideal.span {(⟨S, Algebra.subset_adjoin (Set.mem_singleton S)⟩ :
        ↥(Algebra.adjoin A {S}))} ⊔ (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {S})).comp (algebraMap (↥W) A)),
      algebraMap ↥(Algebra.adjoin A {S}) ↥(integralClosure ↥(Algebra.adjoin A {S}) L) z ∈ Q := by
    intro z hz
    have hz' : z ∈ Q.comap (algebraMap ↥(Algebra.adjoin A {S})
        ↥(integralClosure ↥(Algebra.adjoin A {S}) L)) := by
      rw [hQ]; exact hz
    exact hz'
  have hSQ : algebraMap ↥(Algebra.adjoin A {S}) ↥(integralClosure ↥(Algebra.adjoin A {S}) L)
      ⟨S, Algebra.subset_adjoin (Set.mem_singleton S)⟩ ∈ Q :=
    hN _ (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton _)))
  have h1Q : (1 : ↥(integralClosure ↥(Algebra.adjoin A {S}) L)) ∉ Q := fun h =>
    hQp.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have hwQ : algebraMap ↥(Algebra.adjoin A {S}) ↥(integralClosure ↥(Algebra.adjoin A {S}) L)
      ⟨1 + S, hwR⟩ ∉ Q := by
    intro h
    have e : (⟨1 + S, hwR⟩ : ↥(Algebra.adjoin A {S})) =
        1 + ⟨S, Algebra.subset_adjoin (Set.mem_singleton S)⟩ := rfl
    rw [e, map_add, map_one] at h
    have h2 := Q.sub_mem h hSQ
    rw [add_sub_cancel_right] at h2
    exact h1Q h2
  have hw0 : (1 + S : K) ≠ 0 := by
    intro h
    apply hwQ
    have e : algebraMap ↥(Algebra.adjoin A {S}) ↥(integralClosure ↥(Algebra.adjoin A {S}) L)
        ⟨1 + S, hwR⟩ = 0 := by
      apply Subtype.ext
      rw [hcoe]
      show algebraMap K L (1 + S) = 0
      rw [h, map_zero]
    rw [e]
    exact Q.zero_mem
  have I2 : s * (1 + S) = algebraMap A K (algebraMap (↥W) A q) := by
    have hbK : algebraMap A K (algebraMap (↥W) A b) =
        algebraMap A K (algebraMap (↥W) A r) * algebraMap A K (algebraMap (↥W) A q) := by
      rw [hbrq, map_mul, map_mul]
    have hne : algebraMap A K (algebraMap (↥W) A r) * (1 + S) ≠ 0 := mul_ne_zero hrK hw0
    rw [hs, hbK, ← I1, div_mul_eq_mul_div, div_eq_iff hne]
    ring

  have clear : ∀ a ∈ Algebra.adjoin A {s}, ∃ n : ℕ, a * (1 + S) ^ n ∈ Algebra.adjoin A {S} := by
    intro a ha
    induction ha using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      rw [hx]
      exact ⟨1, by rw [pow_one, I2]; exact Subalgebra.algebraMap_mem _ _⟩
    | algebraMap a =>
      exact ⟨0, by rw [pow_zero, mul_one]; exact Subalgebra.algebraMap_mem _ _⟩
    | add x y hx hy ihx ihy =>
      obtain ⟨n, hn⟩ := ihx
      obtain ⟨m, hm⟩ := ihy
      refine ⟨n + m, ?_⟩
      have e : (x + y) * (1 + S) ^ (n + m) =
          x * (1 + S) ^ n * (1 + S) ^ m + y * (1 + S) ^ m * (1 + S) ^ n := by ring
      rw [e]
      exact add_mem (Subalgebra.mul_mem _ hn (Subalgebra.pow_mem _ hwR _))
        (Subalgebra.mul_mem _ hm (Subalgebra.pow_mem _ hwR _))
    | mul x y hx hy ihx ihy =>
      obtain ⟨n, hn⟩ := ihx
      obtain ⟨m, hm⟩ := ihy
      refine ⟨n + m, ?_⟩
      have e : (x * y) * (1 + S) ^ (n + m) = (x * (1 + S) ^ n) * (y * (1 + S) ^ m) := by ring
      rw [e]
      exact Subalgebra.mul_mem _ hn hm

  have pres : ∀ x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L),
      ∃ y d : ↥(integralClosure ↥(Algebra.adjoin A {S}) L), d ∉ Q ∧
        algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) L x *
          algebraMap ↥(integralClosure ↥(Algebra.adjoin A {S}) L) L d =
          algebraMap ↥(integralClosure ↥(Algebra.adjoin A {S}) L) L y := by
    intro x
    have hx : IsIntegral ↥(Algebra.adjoin A {s}) (x : L) := (mem_integralClosure_iff _ _).mp x.2
    obtain ⟨N, hN'⟩ := s5 A K L (Algebra.adjoin A {S}) (Algebra.adjoin A {s}) (1 + S) hwR clear
      (x : L) hx
    refine ⟨⟨(x : L) * algebraMap K L (1 + S) ^ N, (mem_integralClosure_iff _ _).mpr hN'⟩,
      (algebraMap ↥(Algebra.adjoin A {S}) ↥(integralClosure ↥(Algebra.adjoin A {S}) L)
        ⟨1 + S, hwR⟩) ^ N, fun h => hwQ (hQp.mem_of_pow_mem N h), ?_⟩
    show (x : L) * (((algebraMap ↥(Algebra.adjoin A {S})
      ↥(integralClosure ↥(Algebra.adjoin A {S}) L) ⟨1 + S, hwR⟩) ^ N :
        ↥(integralClosure ↥(Algebra.adjoin A {S}) L)) : L) = (x : L) * algebraMap K L (1 + S) ^ N
    rw [SubmonoidClass.coe_pow, hcoe]

  obtain ⟨Qb, hQb, hchar⟩ := s4 ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
    ↥(integralClosure ↥(Algebra.adjoin A {S}) L) L
    (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) L)
    (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {S}) L) L)
    (fun a b h => Subtype.ext h) Q hQp pres
  refine ⟨Qb, hQb, ?_, ?_⟩
  ·
    refine s6 A K s 𝔭 h𝔭max _ _ ?_ ?_ ?_ ?_
    · exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    · rw [h𝔭eq, Ideal.map_sup, Ideal.map_map]
      refine sup_le ?_ le_sup_right
      rw [Ideal.map_span, Set.image_singleton, Ideal.span_le, Set.singleton_subset_iff]
      have e : algebraMap A ↥(Algebra.adjoin A {s}) t =
          algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap (↥W) A c) +
            ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap (↥W) A)) c := by
        rw [RingHom.comp_apply, ← map_add, sub_add_cancel]
      rw [SetLike.mem_coe, e]
      exact add_mem (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc))
    ·
      refine sup_le ?_ ?_
      · rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
        constructor
        ·
          show _ ∈ Qb
          refine (hchar _ (algebraMap ↥(Algebra.adjoin A {S})
            ↥(integralClosure ↥(Algebra.adjoin A {S}) L)
            (algebraMap A ↥(Algebra.adjoin A {S}) (t - algebraMap (↥W) A c))) 1 h1Q ?_).mpr ?_
          · rw [map_one, mul_one]; rfl
          · apply hN
            have e : algebraMap A ↥(Algebra.adjoin A {S}) (t - algebraMap (↥W) A c) =
                ((algebraMap A ↥(Algebra.adjoin A {S})).comp (algebraMap (↥W) A)) r *
                  ⟨S, Algebra.subset_adjoin (Set.mem_singleton S)⟩ +
                ((algebraMap A ↥(Algebra.adjoin A {S})).comp (algebraMap (↥W) A)) r := by
              apply Subtype.ext
              show algebraMap A K (t - algebraMap (↥W) A c) =
                algebraMap A K (algebraMap (↥W) A r) * S + algebraMap A K (algebraMap (↥W) A r)
              rw [← I1]; ring
            rw [e]
            exact add_mem (Ideal.mem_sup_left (Ideal.mul_mem_left _ _
              (Ideal.subset_span (Set.mem_singleton _))))
              (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hrm))
        ·
          show _ ∈ Qb
          refine (hchar _ (algebraMap ↥(Algebra.adjoin A {S})
            ↥(integralClosure ↥(Algebra.adjoin A {S}) L)
            (algebraMap A ↥(Algebra.adjoin A {S}) (algebraMap (↥W) A q)))
            (algebraMap ↥(Algebra.adjoin A {S}) ↥(integralClosure ↥(Algebra.adjoin A {S}) L)
              ⟨1 + S, hwR⟩) hwQ ?_).mpr ?_
          · show algebraMap K L s * algebraMap K L (1 + S) =
              algebraMap K L (algebraMap A K (algebraMap (↥W) A q))
            rw [← map_mul, I2]
          · exact hN _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem
              ((algebraMap A ↥(Algebra.adjoin A {S})).comp (algebraMap (↥W) A)) hq))
      · rw [Ideal.map_le_iff_le_comap]
        intro a ha
        show _ ∈ Qb
        refine (hchar _ (algebraMap ↥(Algebra.adjoin A {S})
          ↥(integralClosure ↥(Algebra.adjoin A {S}) L)
          (algebraMap A ↥(Algebra.adjoin A {S}) (algebraMap (↥W) A a))) 1 h1Q ?_).mpr ?_
        · rw [map_one, mul_one]; rfl
        · exact hN _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem
            ((algebraMap A ↥(Algebra.adjoin A {S})).comp (algebraMap (↥W) A)) ha))
    · exact (Ideal.comap_isPrime _ Qb).ne_top
  ·
    intro x
    obtain ⟨y, d, hd, hxd⟩ := pres x
    exact ⟨y, d, hd, hxd, hchar x y d hd hxd⟩

theorem wcpa_dj_llsm_scrsct_root_split : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (n : ℕ) (g r q ω : ↥W), 1 ≤ n → r ∈ IsLocalRing.maximalIdeal ↥W →
    r ≠ 0 → q ∈ IsLocalRing.maximalIdeal ↥W → q ≠ 0 → IsUnit ω → g ^ n = ω * (r * q) →
    ∃ μ g' : ↥W, μ ∈ IsLocalRing.maximalIdeal ↥W ∧ μ ≠ 0 ∧ μ ^ n = q ∧
      g' ∈ IsLocalRing.maximalIdeal ↥W ∧ g = μ * g' :=
by
  intro Ω _ _ W n g r q ω hn hrm hr0 hqm hq0 hω hg
  have s1 : ∀ (x : Ω) (y : ↥W), y ∈ IsLocalRing.maximalIdeal ↥W → x ^ n = (y : Ω) →
      ∃ z : ↥W, (z : Ω) = x ∧ z ∈ IsLocalRing.maximalIdeal ↥W := by
    intro x y hy hxy
    have hy' : ¬ IsUnit y := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hy
      exact hy
    by_cases hx : x ∈ W
    · refine ⟨⟨x, hx⟩, rfl, ?_⟩
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have hzy : (⟨x, hx⟩ : ↥W) ^ n = y := by
        apply Subtype.ext
        rw [SubmonoidClass.coe_pow]
        exact hxy
      exact hy' (hzy ▸ hu.pow n)
    · exfalso
      have hxi : x⁻¹ ∈ W := (W.mem_or_inv_mem x).resolve_left hx
      have hx0 : x ≠ 0 := by
        rintro rfl
        exact hx W.zero_mem
      have h1 : y * (⟨x⁻¹, hxi⟩ : ↥W) ^ n = 1 := by
        apply Subtype.ext
        rw [MulMemClass.coe_mul, SubmonoidClass.coe_pow, OneMemClass.coe_one]
        show (y : Ω) * (x⁻¹) ^ n = 1
        rw [← hxy, inv_pow, mul_inv_cancel₀ (pow_ne_zero n hx0)]
      exact hy' (IsUnit.of_mul_eq_one _ h1)
  obtain ⟨μ₀, hμ₀⟩ := IsAlgClosed.exists_pow_nat_eq (q : Ω) (by omega : 0 < n)
  have hqΩ : (q : Ω) ≠ 0 := by
    intro h
    apply hq0
    apply Subtype.ext
    rw [h, ZeroMemClass.coe_zero]
  have hμ₀0 : μ₀ ≠ 0 := by
    rintro rfl
    exact hqΩ (by rw [← hμ₀, zero_pow (by omega)])
  obtain ⟨μ, hμc, hμm⟩ := s1 μ₀ q hqm hμ₀
  have hgΩ : (g : Ω) ^ n = (ω : Ω) * ((r : Ω) * (q : Ω)) := by
    have := congrArg (fun x : ↥W => (x : Ω)) hg
    simpa only [SubmonoidClass.coe_pow, MulMemClass.coe_mul] using this
  have hωr : ω * r ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_left _ ω hrm
  obtain ⟨g', hg'c, hg'm⟩ := s1 ((g : Ω) / μ₀) (ω * r) hωr (by
    rw [div_pow, hμ₀, hgΩ, MulMemClass.coe_mul, ← mul_assoc, mul_div_assoc, div_self hqΩ,
      mul_one])
  refine ⟨μ, g', hμm, ?_, ?_, hg'm, ?_⟩
  · intro h
    apply hμ₀0
    rw [← hμc, h, ZeroMemClass.coe_zero]
  · apply Subtype.ext
    rw [SubmonoidClass.coe_pow, hμc, hμ₀]
  · apply Subtype.ext
    rw [MulMemClass.coe_mul, hμc, hg'c, mul_div_cancel₀ _ hμ₀0]

theorem wcpa_dj_llsm_scrsct_unit_residue : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (P : Type u) [CommRing P] (σ : ↥W →+* P) (a : ↥W) (f : wcEbntN W a →+* P),
    wcEbntPres W σ a f → ∀ ε : P, IsUnit ε →
    ∃ ε₀ : ↥W, IsUnit ε₀ ∧ ¬ IsUnit (ε - σ ε₀) :=
by
  intro Ω _ W P _ σ a f hP ε hε


  have hres : ∀ (A P : Type u) [CommRing A] [CommRing P] (p : Ideal A) (e : A →+* P),
      wcNdIsHens p P e → ∀ x : P, ∃ a s : A, s ∉ p ∧ ¬ IsUnit (x * e s - e a) := by
    intro A P _ _ p e he x
    obtain ⟨hP, hu, huniv⟩ := he
    haveI : HenselianLocalRing P := hP
    have hm : ∀ c : P, c ∈ IsLocalRing.maximalIdeal P ↔ ¬ IsUnit c := fun c =>
      (IsLocalRing.mem_maximalIdeal c).trans mem_nonunits_iff
    have hmul : ∀ s t : A, s ∉ p → t ∉ p → s * t ∉ p := by
      intro s t hs ht
      rw [← hu, map_mul]
      exact ((hu s).2 hs).mul ((hu t).2 ht)
    have h1 : (1 : A) ∉ p := by
      rw [← hu, map_one]
      exact isUnit_one
    let M := IsLocalRing.maximalIdeal P
    let R : Subring P :=
      { carrier := {y | ∃ a s : A, s ∉ p ∧ y * e s - e a ∈ M}
        mul_mem' := by
          rintro x y ⟨a, s, hs, hx⟩ ⟨b, t, ht, hy⟩
          refine ⟨a * b, s * t, hmul s t hs ht, ?_⟩
          have : x * y * e (s * t) - e (a * b) =
              (y * e t) * (x * e s - e a) + e a * (y * e t - e b) := by
            rw [map_mul, map_mul]; ring
          rw [this]
          exact M.add_mem (M.mul_mem_left _ hx) (M.mul_mem_left _ hy)
        one_mem' := ⟨1, 1, h1, by simp⟩
        add_mem' := by
          rintro x y ⟨a, s, hs, hx⟩ ⟨b, t, ht, hy⟩
          refine ⟨a * t + b * s, s * t, hmul s t hs ht, ?_⟩
          have : (x + y) * e (s * t) - e (a * t + b * s) =
              e t * (x * e s - e a) + e s * (y * e t - e b) := by
            rw [map_mul, map_add, map_mul, map_mul]; ring
          rw [this]
          exact M.add_mem (M.mul_mem_left _ hx) (M.mul_mem_left _ hy)
        zero_mem' := ⟨0, 1, h1, by simp⟩
        neg_mem' := by
          rintro x ⟨a, s, hs, hx⟩
          refine ⟨-a, s, hs, ?_⟩
          have : -x * e s - e (-a) = -(x * e s - e a) := by rw [map_neg]; ring
          rw [this]
          exact M.neg_mem_iff.mpr hx }
    have hnon : ∀ c : P, ¬ IsUnit c → c ∈ R := by
      intro c hc
      refine ⟨0, 1, h1, ?_⟩
      rw [map_one, map_zero, mul_one, sub_zero]
      exact (hm c).2 hc
    have hinv : ∀ y ∈ R, ∀ z : P, y * z = 1 → z ∈ R := by
      rintro y ⟨a, s, hs, hy⟩ z hyz
      have ha : a ∉ p := by
        intro ha
        have hea : e a ∈ M := (hm _).2 (fun h => ((hu a).1 h) ha)
        have hys : y * e s ∈ M := by
          have := M.add_mem hy hea
          simpa using this
        exact (hm _).1 hys ((IsUnit.of_mul_eq_one z hyz).mul ((hu s).2 hs))
      refine ⟨s, a, ha, ?_⟩
      have : z * e a - e s = -(z * (y * e s - e a)) + e s * (z * y - 1) := by ring
      rw [this, mul_comm z y, hyz, sub_self, mul_zero, add_zero]
      exact M.neg_mem_iff.mpr (M.mul_mem_left _ hy)
    have hrange : ∀ a : A, e a ∈ R := fun a => ⟨a, 1, h1, by simp⟩
    have hRu : ∀ r : R, IsUnit r ↔ IsUnit (r : P) := by
      intro r
      constructor
      · intro h
        exact h.map R.subtype
      · intro h
        obtain ⟨z, hz⟩ := h.exists_right_inv
        have hzR : z ∈ R := hinv r r.2 z hz
        exact IsUnit.of_mul_eq_one (⟨z, hzR⟩ : R) (Subtype.ext hz)
    haveI : Nontrivial R := ⟨⟨0, 1, fun h => zero_ne_one (congrArg Subtype.val h)⟩⟩
    have hRloc : IsLocalRing R := IsLocalRing.of_nonunits_add (by
      intro a b ha hb
      have ha' : (a : P) ∈ nonunits P := fun h => ha ((hRu a).2 h)
      have hb' : (b : P) ∈ nonunits P := fun h => hb ((hRu b).2 h)
      have hab := IsLocalRing.nonunits_add ha' hb'
      exact fun h => hab ((hRu (a + b)).1 h))
    have hRh : HenselianLocalRing R := by
      refine { toIsLocalRing := hRloc, is_henselian := ?_ }
      intro f hf a₀ h₁ h₂
      have hFm : (f.map R.subtype).Monic := hf.map _
      have hFe : (f.map R.subtype).eval (R.subtype a₀) ∈ M := by
        rw [Polynomial.eval_map_apply, hm]
        intro h
        exact ((IsLocalRing.mem_maximalIdeal _).1 h₁) ((hRu _).2 h)
      have hFd : IsUnit ((f.map R.subtype).derivative.eval (R.subtype a₀)) := by
        rw [Polynomial.derivative_map, Polynomial.eval_map_apply]
        exact h₂.map R.subtype
      obtain ⟨b, hbroot, hbm⟩ :=
        HenselianLocalRing.is_henselian (f.map R.subtype) hFm (R.subtype a₀) hFe hFd
      have hbR : b ∈ R := by
        have h3 : b - R.subtype a₀ ∈ R := hnon _ ((hm _).1 hbm)
        have := R.add_mem h3 a₀.2
        simpa using this
      refine ⟨⟨b, hbR⟩, ?_, ?_⟩
      · have e1 := Polynomial.eval_map_apply (p := f) R.subtype (⟨b, hbR⟩ : R)
        have e2 : R.subtype (f.eval ⟨b, hbR⟩) = 0 := by
          rw [← e1]
          exact hbroot
        exact Subtype.ext e2
      · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hRu]
        exact (hm _).1 hbm
    let g : A →+* R := e.codRestrict R hrange
    have hg : ∀ a, IsUnit (g a) ↔ a ∉ p := fun a => (hRu (g a)).trans (hu a)
    obtain ⟨h, ⟨hhe, hhloc⟩, -⟩ := huniv R hRh g hg
    haveI : IsLocalHom R.subtype := ⟨fun r hr => (hRu r).2 hr⟩
    haveI := hhloc
    let k : P →+* P := R.subtype.comp h
    have hk : IsLocalHom k := RingHom.isLocalHom_comp _ _
    have hke : k.comp e = e := by
      ext a
      show ((h (e a) : R) : P) = e a
      rw [← RingHom.comp_apply, hhe]
      rfl
    have hkid : k = RingHom.id P :=
      ExistsUnique.unique (huniv P hP e hu) ⟨hke, hk⟩ ⟨RingHom.id_comp e, isLocalHom_id P⟩
    have hxR : x ∈ R := by
      have h0 : k x ∈ R := (h x).2
      have h0' : k x = x := by rw [hkid]; rfl
      rwa [h0'] at h0
    obtain ⟨a, s, hs, hxm⟩ := hxR
    exact ⟨a, s, hs, (hm _).1 hxm⟩

  have hconst : ∀ F : MvPolynomial (Fin 2) ↥W,
      F - MvPolynomial.C (MvPolynomial.constantCoeff F) ∈
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W)) := by
    intro F
    induction F using MvPolynomial.induction_on with
    | C r =>
      rw [MvPolynomial.constantCoeff_C, sub_self]
      exact Ideal.zero_mem _
    | add p q hp hq =>
      have : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
          (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
            (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
        rw [map_add, map_add]; ring
      rw [this]
      exact Ideal.add_mem _ hp hq
    | mul_X p n _ =>
      have : p * MvPolynomial.X n - MvPolynomial.C (MvPolynomial.constantCoeff (p * MvPolynomial.X n))
          = p * MvPolynomial.X n := by
        rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero, sub_zero]
      rw [this]
      apply Ideal.mul_mem_left
      apply Ideal.subset_span
      fin_cases n <;> simp
  obtain ⟨-, -, hfC, hH⟩ := hP
  obtain ⟨a', s', hs', hr⟩ := hres (wcEbntN W a) P _ f hH ε
  obtain ⟨hPh, hu, -⟩ := hH
  haveI : HenselianLocalRing P := hPh
  have hm : ∀ c : P, c ∈ IsLocalRing.maximalIdeal P ↔ ¬ IsUnit c := fun c =>
    (IsLocalRing.mem_maximalIdeal c).trans mem_nonunits_iff
  have hmW : ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W ↔ ¬ IsUnit c := fun c =>
    (IsLocalRing.mem_maximalIdeal c).trans mem_nonunits_iff
  have hσ : ∀ w : ↥W, σ w = f (Ideal.Quotient.mk _ (MvPolynomial.C w)) := fun w => by
    rw [← hfC]; rfl
  have hσm : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → σ w ∈ IsLocalRing.maximalIdeal P := by
    intro w hw
    rw [hm, hσ]
    intro hU
    exact (hu _).1 hU (Ideal.mem_map_of_mem _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)))
  have hred : ∀ z : wcEbntN W a, ∃ z0 : ↥W, f z - σ z0 ∈ IsLocalRing.maximalIdeal P := by
    intro z
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective z
    refine ⟨MvPolynomial.constantCoeff F, ?_⟩
    rw [hm, hσ, ← map_sub, ← map_sub]
    intro hU
    exact (hu _).1 hU (Ideal.mem_map_of_mem _ (Ideal.mem_sup_left (hconst F)))
  obtain ⟨s0, hs0⟩ := hred s'
  obtain ⟨a0, ha0⟩ := hred a'
  have hfs : IsUnit (f s') := (hu s').2 hs'
  have hs0u : IsUnit s0 := by
    by_contra h
    have h1 : σ s0 ∈ IsLocalRing.maximalIdeal P := hσm s0 ((hmW s0).2 h)
    have h2 : f s' ∈ IsLocalRing.maximalIdeal P := by
      have := Ideal.add_mem _ hs0 h1
      simpa using this
    exact (hm _).1 h2 hfs
  obtain ⟨u, rfl⟩ := hs0u
  have key : ε - σ (a0 * ↑u⁻¹) ∈ IsLocalRing.maximalIdeal P := by
    have e1 : σ (↑u : ↥W) * σ ↑u⁻¹ = 1 := by rw [← map_mul, Units.mul_inv, map_one]
    have hr' : ε * f s' - f a' ∈ IsLocalRing.maximalIdeal P := (hm _).2 hr
    have : ε - σ (a0 * ↑u⁻¹) =
        σ ↑u⁻¹ * ((ε * f s' - f a') - ε * (f s' - σ ↑u) + (f a' - σ a0)) := by
      rw [map_mul]; linear_combination (-ε) * e1
    rw [this]
    exact Ideal.mul_mem_left _ _ (Ideal.add_mem _ (Ideal.sub_mem _ hr'
      (Ideal.mul_mem_left _ _ hs0)) ha0)
  refine ⟨a0 * ↑u⁻¹, ?_, (hm _).1 key⟩
  by_contra h
  have h1 := hσm _ ((hmW _).2 h)
  have h2 : ε ∈ IsLocalRing.maximalIdeal P := by
    have := Ideal.add_mem _ key h1
    simpa using this
  exact (hm _).1 h2 hε

theorem wcpa_dj_llsm_scrsct_circle_coord : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (P₂ : Type u) [CommRing P₂] [IsLocalRing P₂] [IsDomain P₂]
    [IsIntegrallyClosed P₂] (σ₂ : ↥W →+* P₂), Function.Injective σ₂ →
    (∀ t ∈ IsLocalRing.maximalIdeal ↥W, σ₂ t ∈ IsLocalRing.maximalIdeal P₂) →
    ∀ (n : ℕ) (μ q ε₀ : ↥W) (X ε' D : P₂), 1 ≤ n → μ ≠ 0 → μ ^ n = q → IsUnit ε₀ →
    IsUnit ε' → ε' - σ₂ ε₀ ∈ IsLocalRing.maximalIdeal P₂ → D - 1 ∈ IsLocalRing.maximalIdeal P₂ →
    ε' * X ^ n * D = σ₂ q →
    ∃ (Z : P₂) (t₀ : ↥W), X = σ₂ μ * Z ∧ Z ^ n * ε' * D = 1 ∧ IsUnit t₀ ∧
      ¬ IsUnit (Z - σ₂ t₀) :=
by
  intro Ω _ _ W P₂ _ _ _ _ σ₂ hσinj hσm n μ q ε₀ X ε' D hn hμ hμq hε₀ hε' hεm hDm hEq
  classical
  have hMmax : (IsLocalRing.maximalIdeal P₂).IsMaximal := IsLocalRing.maximalIdeal.isMaximal P₂
  have hone : (1 : P₂) ∉ IsLocalRing.maximalIdeal P₂ := fun h =>
    hMmax.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have hDu : IsUnit D := by
    by_contra hD
    have h1 : D ∈ IsLocalRing.maximalIdeal P₂ := (IsLocalRing.mem_maximalIdeal D).mpr hD
    have h2 := (IsLocalRing.maximalIdeal P₂).sub_mem h1 hDm
    rw [sub_sub_cancel] at h2
    exact hone h2
  obtain ⟨v, hv⟩ := (hε'.mul hDu).exists_right_inv
  have hq' : σ₂ q = σ₂ μ ^ n := by rw [← hμq, map_pow]
  have hdvd : σ₂ μ ^ n ∣ X ^ n := by
    refine ⟨v, ?_⟩
    have h1 : X ^ n = (ε' * X ^ n * D) * v := by linear_combination (-(X ^ n)) * hv
    rw [h1, hEq, hq']
  have hn0 : n ≠ 0 := by omega
  obtain ⟨Z, hZ⟩ := (IsIntegrallyClosed.pow_dvd_pow_iff hn0).mp hdvd
  have ha0 : σ₂ μ ≠ 0 := by
    intro h
    apply hμ
    apply hσinj
    rw [h, map_zero]
  have hZn : Z ^ n * ε' * D = 1 := by
    have han : σ₂ μ ^ n ≠ 0 := pow_ne_zero _ ha0
    apply mul_left_cancel₀ han
    have h := hEq
    rw [hZ, mul_pow, hq'] at h
    linear_combination h
  have hZu : IsUnit Z := by
    obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
    exact isUnit_iff_exists_inv.mpr ⟨Z ^ k * ε' * D, by rw [← hZn]; ring⟩
  obtain ⟨η, hη⟩ := hε₀.exists_right_inv
  have hres : Z ^ n - σ₂ η ∈ IsLocalRing.maximalIdeal P₂ := by
    have h1 : σ₂ ε₀ - ε' ∈ IsLocalRing.maximalIdeal P₂ := by
      have := (IsLocalRing.maximalIdeal P₂).neg_mem hεm
      rwa [neg_sub] at this
    have h2 : 1 - D ∈ IsLocalRing.maximalIdeal P₂ := by
      have := (IsLocalRing.maximalIdeal P₂).neg_mem hDm
      rwa [neg_sub] at this
    have hσ : σ₂ ε₀ * σ₂ η = 1 := by rw [← map_mul, hη, map_one]
    have key : Z ^ n - σ₂ η =
        σ₂ η * (Z ^ n * (σ₂ ε₀ - ε') + Z ^ n * ε' * (1 - D)) := by
      linear_combination (-(Z ^ n)) * hσ + σ₂ η * hZn
    rw [key]
    exact (IsLocalRing.maximalIdeal P₂).mul_mem_left _
      ((IsLocalRing.maximalIdeal P₂).add_mem ((IsLocalRing.maximalIdeal P₂).mul_mem_left _ h1)
        ((IsLocalRing.maximalIdeal P₂).mul_mem_left _ h2))
  have hsplit : ∀ (P₀ : Polynomial ↥W), P₀.Monic →
      ∃ l : List ↥W, P₀ = (l.map (fun α => Polynomial.X - Polynomial.C α)).prod := by
    intro P₀ hP₀
    suffices H : ∀ m : ℕ, ∀ P : Polynomial ↥W, P.Monic → P.natDegree = m →
        ∃ l : List ↥W, P = (l.map (fun α => Polynomial.X - Polynomial.C α)).prod from
      H _ P₀ hP₀ rfl
    intro m
    induction m with
    | zero =>
      intro P hP hm
      refine ⟨[], ?_⟩
      rw [Polynomial.eq_one_of_monic_natDegree_zero hP hm]
      simp
    | succ m ih =>
      intro P hP hm
      have hQ : (P.map (algebraMap ↥W Ω)).Monic := hP.map _
      have hQd : (P.map (algebraMap ↥W Ω)).natDegree = m + 1 := by
        rw [hP.natDegree_map]; exact hm
      have hdeg : (P.map (algebraMap ↥W Ω)).degree ≠ 0 := by
        rw [Polynomial.degree_eq_natDegree hQ.ne_zero, hQd]
        exact_mod_cast (Nat.succ_ne_zero m)
      obtain ⟨x, hx⟩ := IsAlgClosed.exists_root _ hdeg
      have hx' : Polynomial.eval₂ (algebraMap ↥W Ω) x P = 0 := by
        rw [Polynomial.IsRoot, Polynomial.eval_map] at hx; exact hx
      have hint : IsIntegral ↥W x := ⟨P, hP, hx'⟩
      obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
      have hroot : P.IsRoot y := by
        apply IsFractionRing.injective ↥W Ω
        rw [map_zero, ← Polynomial.eval₂_at_apply, hy]
        exact hx'
      have hmul := Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hroot
      have hP' : (P /ₘ (Polynomial.X - Polynomial.C y)).Monic :=
        Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C y) (by rw [hmul]; exact hP)
      have hd' : (P /ₘ (Polynomial.X - Polynomial.C y)).natDegree = m := by
        have h1 := (Polynomial.monic_X_sub_C y).natDegree_mul hP'
        rw [hmul, hm, Polynomial.natDegree_X_sub_C] at h1
        omega
      obtain ⟨l', hl'⟩ := ih _ hP' hd'
      refine ⟨y :: l', ?_⟩
      rw [List.map_cons, List.prod_cons, ← hl', hmul]
  obtain ⟨l, hl⟩ := hsplit (Polynomial.X ^ n - Polynomial.C η)
    (Polynomial.monic_X_pow_sub_C η hn0)
  have hev : Polynomial.eval₂ σ₂ Z (Polynomial.X ^ n - Polynomial.C η) = Z ^ n - σ₂ η := by
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
  have hprod : ∀ l' : List ↥W, Polynomial.eval₂ σ₂ Z
      (l'.map (fun α => Polynomial.X - Polynomial.C α)).prod ∈ IsLocalRing.maximalIdeal P₂ →
      ∃ α ∈ l', Z - σ₂ α ∈ IsLocalRing.maximalIdeal P₂ := by
    intro l'
    induction l' with
    | nil =>
      intro h
      rw [List.map_nil, List.prod_nil, Polynomial.eval₂_one] at h
      exact absurd h hone
    | cons a l' ih =>
      intro h
      rw [List.map_cons, List.prod_cons, Polynomial.eval₂_mul] at h
      rcases hMmax.isPrime.mem_or_mem h with h1 | h1
      · refine ⟨a, List.mem_cons_self .., ?_⟩
        rw [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C] at h1
        exact h1
      · obtain ⟨α, hα, h2⟩ := ih h1
        exact ⟨α, List.mem_cons_of_mem _ hα, h2⟩
  have hin : Polynomial.eval₂ σ₂ Z
      (l.map (fun α => Polynomial.X - Polynomial.C α)).prod ∈ IsLocalRing.maximalIdeal P₂ := by
    rw [← hl, hev]
    exact hres
  obtain ⟨t₀, -, ht₀⟩ := hprod l hin
  refine ⟨Z, t₀, hZ, hZn, ?_, ?_⟩
  · by_contra ht
    have h1 : t₀ ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal t₀).mpr ht
    have h2 := (IsLocalRing.maximalIdeal P₂).add_mem ht₀ (hσm t₀ h1)
    rw [sub_add_cancel] at h2
    exact (IsLocalRing.mem_maximalIdeal Z).mp h2 hZu
  · exact (IsLocalRing.mem_maximalIdeal _).mp ht₀

theorem wcpa_dj_llsm_scrs_circle_transport : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L]
    (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c c' b r q : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → c' ∈ IsLocalRing.maximalIdeal ↥W →
      r ≠ 0 → c' - c = r → q ∈ IsLocalRing.maximalIdeal ↥W → b = r * q → b ≠ 0 →
    ∀ (s : K), s = algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c) →
    ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) [Q.IsPrime],
      Q.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) =
        wcLlsScN W A K t c' r →
    ∀ (Qb : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) [Qb.IsPrime],
      Qb.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) =
        Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c),
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) →
    (∀ x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L),
        ∃ y d : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L),
          d ∉ Q ∧ (x : L) * (d : L) = (y : L) ∧ (x ∈ Qb ↔ y ∈ Q)) →
    ∀ (P : Type u) [CommRing P] (e : Localization.AtPrime Qb →+* P),
      wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime Qb)) P e →
    ∀ (g : ↥W) (f : wcEbntN W g →+* P),
      wcEbntPres W (e.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
          (Localization.AtPrime Qb)).comp ((algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))))) g f →
    ∀ (n : ℕ) (ε : P) (ω : ↥W), 1 ≤ n → IsUnit ε → IsUnit ω → g ^ n = ω * b →
      ((e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)
            (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
              ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩)) =
          ε * f (wcEbntX W g 0) ^ n ∧
        (e.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
          (Localization.AtPrime Qb)).comp ((algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))))) ω *
          e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)
            (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
              (algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c)))) * ε =
          f (wcEbntX W g 1) ^ n) ∨
       (e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)
            (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
              ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩)) =
          ε * f (wcEbntX W g 1) ^ n ∧
        (e.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
          (Localization.AtPrime Qb)).comp ((algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))))) ω *
          e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)
            (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
              (algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c)))) * ε =
          f (wcEbntX W g 0) ^ n)) →
    ∃ (P₂ : Type u) (_ : CommRing P₂) (e₂ : Localization.AtPrime Q →+* P₂),
      wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) P₂ e₂ ∧
      wcNdModelA W P₂ (e₂.comp
        ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
          (Localization.AtPrime Q)).comp
        ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)).comp
        ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})).comp
          (algebraMap ↥W A))))) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ 𝔭 t hPD c c' b r q hc hc' hr0 hcr hq hbrq hb0 s hs
    Q _ hQ Qb _ hQb hlink P _ e he g f hf n ε ω hn hε hω hgn hform
  classical

  have hrm : r ∈ IsLocalRing.maximalIdeal ↥W := hcr ▸ Ideal.sub_mem _ hc' hc
  have hq0 : q ≠ 0 := by
    rintro rfl; exact hb0 (by rw [hbrq, mul_zero])
  obtain ⟨-, hNZ, -⟩ := hPD
  haveI := hNZ
  have hWA : Function.Injective (algebraMap ↥W A) := by
    intro x y hxy
    have h1 : (x - y) • (1 : A) = 0 := by
      rw [sub_smul, Algebra.smul_def, Algebra.smul_def, mul_one, mul_one, hxy, sub_self]
    rcases smul_eq_zero.mp h1 with h2 | h2
    · exact sub_eq_zero.mp h2
    · exact absurd h2 one_ne_zero
  have hAK : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hrK : algebraMap A K (algebraMap ↥W A r) ≠ 0 := by
    intro h0; apply hr0; apply hWA; apply hAK; rw [h0, map_zero, map_zero]
  have hSN : (⟨wcLlsScS W A K t c' r, Algebra.subset_adjoin (Set.mem_singleton _)⟩ :
      ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})) ∈ wcLlsScN W A K t c' r := by
    unfold wcLlsScN
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton _))
  have hmN : ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W →
      algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) (algebraMap ↥W A x) ∈
        wcLlsScN W A K t c' r := by
    intro x hx
    unfold wcLlsScN
    exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hx)
  have hSQ : algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
      ⟨wcLlsScS W A K t c' r, Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∈ Q := by
    rw [← Ideal.mem_comap, hQ]; exact hSN
  have hmQ : ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W →
      algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
      (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) (algebraMap ↥W A x)) ∈ Q := by
    intro x hx; rw [← Ideal.mem_comap, hQ]; exact hmN x hx
  have hwQ : algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
      (1 + ⟨wcLlsScS W A K t c' r, Algebra.subset_adjoin (Set.mem_singleton _)⟩) ∉ Q := by
    intro h0
    have h1 := Q.sub_mem h0 hSQ
    rw [map_add, map_one, add_sub_cancel_right] at h1
    exact (‹Q.IsPrime›).ne_top ((Ideal.eq_top_iff_one Q).mpr h1)
  have h1S : (1 + wcLlsScS W A K t c' r : K) ≠ 0 := by
    intro h0
    apply hwQ
    have h2 : (1 + ⟨wcLlsScS W A K t c' r, Algebra.subset_adjoin (Set.mem_singleton _)⟩ :
        ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})) = 0 := Subtype.ext h0
    rw [h2, map_zero]; exact Q.zero_mem
  have e1 : algebraMap A K (algebraMap ↥W A r) * wcLlsScS W A K t c' r =
      algebraMap A K (t - algebraMap ↥W A c') := by
    unfold wcLlsScS; field_simp
  have hu : algebraMap A K (t - algebraMap ↥W A c) =
      algebraMap A K (algebraMap ↥W A r) * (1 + wcLlsScS W A K t c' r) := by
    rw [mul_add, mul_one, e1, ← map_add, ← hcr, map_sub (algebraMap ↥W A)]
    congr 1; ring
  have hsq : s * (1 + wcLlsScS W A K t c' r) = algebraMap A K (algebraMap ↥W A q) := by
    rw [hs, hu, hbrq, map_mul, map_mul, div_mul_eq_mul_div, div_eq_iff (mul_ne_zero hrK h1S)]
    ring

  obtain ⟨ι, φ, hι, hιc, hφloc, hφinj, hιφ⟩ := wcpa_dj_llsm_scrsct_local_embed L
    ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
    ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
    (fun x y hxy => Subtype.ext hxy) (fun x y hxy => Subtype.ext hxy) Qb Q
    (fun x => by
      obtain ⟨y, d, h1, h2, h3⟩ := hlink x
      exact ⟨y, d, h1, h2, h3⟩)
  have hφA : ∀ a : A, φ (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
      (Localization.AtPrime Qb)
      (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
        (algebraMap A ↥(Algebra.adjoin A {s}) a))) =
      algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
        (Localization.AtPrime Q)
      (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) a)) := by
    intro a; apply hι; rw [hιφ, hιc]; rfl
  obtain ⟨σb, hσb⟩ : ∃ σ : ↥W →+* Localization.AtPrime Qb,
      σ = (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
          (Localization.AtPrime Qb)).comp ((algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) := ⟨_, rfl⟩
  obtain ⟨σQ, hσQ⟩ : ∃ σ : ↥W →+* Localization.AtPrime Q,
      σ = (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
          (Localization.AtPrime Q)).comp
        ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)).comp
        ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})).comp
