    unfold wcLlsIsiS1 wcLlsIsiS2
    field_simp
  have hS1mem : wcLlsIsiS1 W A K u a' ∈ wcIcxRI W A K u a' b :=
    Algebra.subset_adjoin (Set.mem_insert _ _)
  have hS2mem : wcLlsIsiS2 W A K u b ∈ wcIcxRI W A K u a' b :=
    Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))

  obtain ⟨θ, hθ⟩ : ∃ θ : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L) →+*
      LaurentPolynomial (IsLocalRing.ResidueField ↥W),
      ∀ z, θ z = LaurentPolynomial.invert (ψ (Ideal.Quotient.mk 𝔎 (wcIcxIncl L _ _ hIC z))) :=
    ⟨(LaurentPolynomial.invert.toRingEquiv.toRingHom).comp
      (ψ.toRingHom.comp ((Ideal.Quotient.mk 𝔎).comp (wcIcxIncl L _ _ hIC))), fun _ => rfl⟩
  have hinv : ∀ f : LaurentPolynomial (IsLocalRing.ResidueField ↥W),
