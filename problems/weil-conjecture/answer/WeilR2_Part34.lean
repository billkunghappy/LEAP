  choose g'' hg'' using hdiv
  obtain ⟨g', hg'⟩ : ∃ g' : ℕ → ↥W, ∀ j, j < m₀ → g.coeff j = b ^ (m₀ - j) * g' j :=
    ⟨fun j => if hj : j < m₀ then g'' j hj else 0, fun j hj => by
