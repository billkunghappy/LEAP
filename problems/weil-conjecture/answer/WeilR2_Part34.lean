        intro π hπ
        rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply, RingHom.comp_apply, hΛof, hθe,
          hθψ, Polynomial.map_C, Polynomial.eval_C, (IsLocalRing.residue_eq_zero_iff _).mpr hπ,
          map_zero]
      exact hle hz
    have hΛJ : ∀ z ∈ Ideal.span {AdjoinRoot.of FP (ψ (Polynomial.X - Polynomial.C e))} ⊔
        (IsLocalRing.maximalIdeal ↥W).map ((AdjoinRoot.of FP).comp (ψ.comp Polynomial.C)),
        Λ z = 0 := by
      intro z hz
      have hle : Ideal.span {AdjoinRoot.of FP (ψ (Polynomial.X - Polynomial.C e))} ⊔
          (IsLocalRing.maximalIdeal ↥W).map ((AdjoinRoot.of FP).comp (ψ.comp Polynomial.C)) ≤
          RingHom.ker Λ := by
        refine sup_le ?_ ?_
        · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
          exact hΛσ
        · intro z hz
          exact (RingHom.mem_ker).mpr (hΛmC z hz)
      exact hle hz
    have hzero : Λ ((c : AdjoinRoot FP) * (s₁ : AdjoinRoot FP)) *
        (AdjoinRoot.root (FP.map θe) - AdjoinRoot.of (FP.map θe) (IsLocalRing.residue ↥W γ)) ^
          (p - 1) = 0 := by
      have h := congrArg Λ hcx
      rw [map_mul, map_mul, map_pow, hΛy, map_mul, hΛJ _ a.2, mul_zero] at h
      rw [map_mul, ← h]
      ring

    have hyQ : AdjoinRoot.root FP - AdjoinRoot.of FP (ψ (Polynomial.C γ)) ∈ Q := by
      apply (inferInstance : Q.IsPrime).mem_of_pow_mem p
      have h1 := hmQ hclaim
      have h2 : (AdjoinRoot.of FP (ψ (Polynomial.X - Polynomial.C e))) ^ 2 *
          AdjoinRoot.of FP (ψ G₂) ∈ Q :=
        Ideal.mul_mem_right _ _ (Ideal.pow_mem_of_mem _ hσQ 2 two_pos)
      have := Ideal.add_mem _ h1 h2
      rwa [sub_add_cancel] at this
    obtain ⟨w, hw⟩ := c5 ((c : AdjoinRoot FP) * (s₁ : AdjoinRoot FP))
    have hIQ : (IsLocalRing.maximalIdeal ↥W).map ((AdjoinRoot.of FP).comp (ψ.comp Polynomial.C)) ⊔
        Ideal.span {AdjoinRoot.of FP (ψ (Polynomial.X - Polynomial.C e))} ⊔
        Ideal.span {AdjoinRoot.root FP - AdjoinRoot.of FP (ψ (Polynomial.C γ))} ≤ Q := by
      refine sup_le (sup_le hmQ ?_) ?_
      · rw [Ideal.span_le, Set.singleton_subset_iff]; exact hσQ
      · rw [Ideal.span_le, Set.singleton_subset_iff]; exact hyQ
    have hrw : IsLocalRing.residue ↥W w ≠ 0 := by
      intro h0
      have hwm : w ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.residue_eq_zero_iff _).mp h0
      have h1 : AdjoinRoot.of FP (ψ (Polynomial.C w)) ∈ Q := hmQ (Ideal.mem_map_of_mem _ hwm)
      apply hsQ
      have := Ideal.add_mem _ (hIQ hw) h1
      rwa [sub_add_cancel] at this
    have hΛI : ∀ z ∈ (IsLocalRing.maximalIdeal ↥W).map
          ((AdjoinRoot.of FP).comp (ψ.comp Polynomial.C)) ⊔
        Ideal.span {AdjoinRoot.of FP (ψ (Polynomial.X - Polynomial.C e))} ⊔
        Ideal.span {AdjoinRoot.root FP - AdjoinRoot.of FP (ψ (Polynomial.C γ))},
        Λ z ∈ Ideal.span {AdjoinRoot.root (FP.map θe) -
          AdjoinRoot.of (FP.map θe) (IsLocalRing.residue ↥W γ)} := by
      intro z hz
      have hle : (IsLocalRing.maximalIdeal ↥W).map
            ((AdjoinRoot.of FP).comp (ψ.comp Polynomial.C)) ⊔
          Ideal.span {AdjoinRoot.of FP (ψ (Polynomial.X - Polynomial.C e))} ⊔
          Ideal.span {AdjoinRoot.root FP - AdjoinRoot.of FP (ψ (Polynomial.C γ))} ≤
          (Ideal.span {AdjoinRoot.root (FP.map θe) -
            AdjoinRoot.of (FP.map θe) (IsLocalRing.residue ↥W γ)}).comap Λ := by
        refine sup_le (sup_le ?_ ?_) ?_
        · intro z hz
          rw [Ideal.mem_comap, hΛmC z hz]
          exact Ideal.zero_mem _
        · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap, hΛσ]
          exact Ideal.zero_mem _
        · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap, hΛy]
          exact Ideal.mem_span_singleton_self _
      exact hle hz
    obtain ⟨v, hv⟩ := Ideal.mem_span_singleton'.mp (hΛI _ hw)
    have hΛs : Λ ((c : AdjoinRoot FP) * (s₁ : AdjoinRoot FP)) =
        AdjoinRoot.of (FP.map θe) (IsLocalRing.residue ↥W w) +
        (AdjoinRoot.root (FP.map θe) - AdjoinRoot.of (FP.map θe) (IsLocalRing.residue ↥W γ)) * v := by
      have h1 : Λ (AdjoinRoot.of FP (ψ (Polynomial.C w))) =
          AdjoinRoot.of (FP.map θe) (IsLocalRing.residue ↥W w) := by
        rw [hΛof, hθe, hθψ, Polynomial.map_C, Polynomial.eval_C]
      rw [map_sub, h1] at hv
      linear_combination -hv
    exact c6 (FP.map θe) (IsLocalRing.residue ↥W γ) (IsLocalRing.residue ↥W w) hFe hrw v
      (by rw [← hΛs]; exact hzero)

theorem wcLlsKP_idatum_mult_singular : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ (c b : ↥W) (d : A) (w : L) (F : Polynomial K) (ε : ↥W) (G : Polynomial ↥W) (ω : ↥W),
      c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
      wcLlsKPInnerCore W A K L ℓ 𝔭 t c b d w F ε G ω → ε ∈ IsLocalRing.maximalIdeal ↥W →
      (∃ j, (Polynomial.derivative G).coeff j ∉ IsLocalRing.maximalIdeal ↥W) →
      ∀ e : ↥W, (Polynomial.derivative G).eval e ∈ IsLocalRing.maximalIdeal ↥W →
        ¬ wcLlsInnerSmooth W A K L t c b e :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD hdeg c b d w F ε G ω
    hc hb hb0 hI hεm hj e he hsm

  have s8 : ∀ (T : Type u) [CommRing T] [IsDomain T] (q : ℕ) (y σ H : T), σ ≠ 0 →
      y ^ (q + 2) = σ ^ 2 * H → ¬ σ ∣ y ^ (q + 1) → wcpaDjLkDelta T ≠ 0 := by
    intro T _ _ q y σ H hσ hyH hndvd hδ
    unfold wcpaDjLkDelta at hδ
    rw [Module.length_eq_zero_iff] at hδ
    have hinj := IsFractionRing.injective T (FractionRing T)
    have hσK : algebraMap T (FractionRing T) σ ≠ 0 := (map_ne_zero_iff _ hinj).mpr hσ
    obtain ⟨z, hzσ⟩ : ∃ z : FractionRing T,
        z * algebraMap T (FractionRing T) σ = algebraMap T (FractionRing T) (y ^ (q + 1)) :=
      ⟨algebraMap T (FractionRing T) (y ^ (q + 1)) / algebraMap T (FractionRing T) σ,
        div_mul_cancel₀ _ hσK⟩
    have hzp : z ^ (q + 2) = algebraMap T (FractionRing T) (σ ^ q * H ^ (q + 1)) := by
      have h1 : (z * algebraMap T (FractionRing T) σ) ^ (q + 2) =
          algebraMap T (FractionRing T) (σ ^ q * H ^ (q + 1)) *
            algebraMap T (FractionRing T) σ ^ (q + 2) := by
        rw [hzσ, ← map_pow, ← map_pow, ← map_mul]
        congr 1
        calc (y ^ (q + 1)) ^ (q + 2) = (y ^ (q + 2)) ^ (q + 1) := by
              rw [← pow_mul, ← pow_mul, mul_comm]
          _ = (σ ^ 2 * H) ^ (q + 1) := by rw [hyH]
          _ = σ ^ q * H ^ (q + 1) * σ ^ (q + 2) := by ring
      rw [mul_pow] at h1
      exact mul_right_cancel₀ (pow_ne_zero _ hσK) h1
    have hzint : IsIntegral T z := by
      refine ⟨Polynomial.X ^ (q + 2) - Polynomial.C (σ ^ q * H ^ (q + 1)),
        Polynomial.monic_X_pow_sub_C _ (by omega), ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hzp, sub_self]
    have hmem : (⟨z, hzint⟩ : ↥(integralClosure T (FractionRing T))) ∈
        LinearMap.range (Algebra.linearMap T ↥(integralClosure T (FractionRing T))) := by
      have := Subsingleton.elim
        (Submodule.Quotient.mk (p := LinearMap.range
          (Algebra.linearMap T ↥(integralClosure T (FractionRing T))))
          (⟨z, hzint⟩ : ↥(integralClosure T (FractionRing T)))) 0
      rwa [Submodule.Quotient.mk_eq_zero] at this
    obtain ⟨β, hβ⟩ := LinearMap.mem_range.mp hmem
    have hβ' : algebraMap T (FractionRing T) β = z := congrArg Subtype.val hβ
    apply hndvd
    refine ⟨β, ?_⟩
    apply hinj
    rw [map_mul, hβ', mul_comm, hzσ]

  obtain ⟨-, -, hR3⟩ := wcLlsKPms_chart_fibre Ω W A K 𝔭 t hPD c b hc hb hb0
  obtain ⟨hJmax, -⟩ := hR3 e
  haveI := hJmax.isPrime
  obtain ⟨𝔮, -, h𝔮p, h𝔮⟩ := Ideal.exists_ideal_over_prime_of_isIntegral
    (S := ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L))
    (Ideal.span {⟨wcLlsScS W A K t c b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ -
          algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) (algebraMap ↥W A e)} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp (algebraMap ↥W A)))
    ⊥ (by
      intro x hx
      simp only [Ideal.under, Ideal.mem_comap, Ideal.mem_bot] at hx
      have h1 : algebraMap K L (x : K) = 0 := congrArg Subtype.val hx
      have h2 : (x : K) = 0 := (map_eq_zero_iff _ (algebraMap K L).injective).mp h1
      have h3 : x = 0 := Subtype.ext h2
      rw [h3]
      exact Submodule.zero_mem _)
  haveI := h𝔮p
  unfold wcLlsInnerSmooth at hsm
  have hδ := hsm 𝔮 h𝔮

  obtain ⟨P, _, _, ψ, FP, Q, _, j, φ, hψ, hPF1, hPF2, hmon, hdegP, hmid, hcoeff0, hBez, hCdom,
      hmQ, hσQ, hjinj, hφ, hWc, hfrac, hR, hzs⟩ :=
    wcLlsKPms_model Ω W hW hWt ℓ hℓ hΩ hκ A K L 𝔭 t hPD hdeg c b d w F ε G ω hc hb hb0 hI hεm
      e 𝔮 h𝔮
  have hω0 : ω ≠ 0 := by
    have hI' := hI
    unfold wcLlsKPInnerCore at hI'
    exact hI'.2.1

  obtain ⟨γ₀, hγ₀⟩ := IsAlgClosed.exists_pow_nat_eq ((G.eval e : ↥W) : Ω) hℓ.pos
  have hγW : γ₀ ∈ W := by
    rcases W.mem_or_inv_mem γ₀ with h | h
    · exact h
    · by_cases h0 : γ₀ = 0
      · rw [h0]; exact W.zero_mem
      · obtain ⟨k, hk⟩ : ∃ k, ℓ = k + 1 := ⟨ℓ - 1, by have := hℓ.pos; omega⟩
        have hγe : γ₀ = γ₀ ^ ℓ * (γ₀⁻¹) ^ k := by
          rw [hk, pow_succ, inv_pow, mul_comm (γ₀ ^ k) γ₀, mul_assoc,
            mul_inv_cancel₀ (pow_ne_zero _ h0), mul_one]
        rw [hγe, hγ₀]
        exact mul_mem (G.eval e).2 (pow_mem h k)
  obtain ⟨γ, hγeq⟩ : ∃ γ : ↥W, γ ^ ℓ = G.eval e :=
    ⟨⟨γ₀, hγW⟩, Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hγ₀)⟩
  have hγ : γ ^ ℓ - G.eval e ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [hγeq, sub_self]; exact Ideal.zero_mem _

  haveI := hCdom
  haveI hDn : IsIntegrallyClosed (Localization.AtPrime Q) :=
    wcLlsKPms_adjroot_normal Ω W hW hWt ℓ hℓ hκ P ψ hψ hPF1 hPF2 FP G ω hmon hdegP hmid hcoeff0
      hj hω0 hBez hCdom Q hmQ
  have hbij := wcLlsKPas_local_model_bijective ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L 𝔮
    (Localization.AtPrime Q) j φ hjinj hφ hfrac hR hzs
  let Φ : Localization.AtPrime Q ≃+* Localization.AtPrime 𝔮 := RingEquiv.ofBijective φ hbij

  have hcomp : (Φ : Localization.AtPrime Q →+* Localization.AtPrime 𝔮).comp
      ((algebraMap (AdjoinRoot FP) (Localization.AtPrime Q)).comp
        ((AdjoinRoot.of FP).comp (ψ.comp Polynomial.C))) =
      (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)
          (Localization.AtPrime 𝔮)).comp
        ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp
            (algebraMap ↥W A))) := by
    ext π
    exact hWc π
  have hset : {z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (z : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} =
      ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c b})
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c b})).comp
            (algebraMap ↥W A))) '' (IsLocalRing.maximalIdeal ↥W : Set ↥W) := by
    ext z
    constructor
    · rintro ⟨π, hπ, hz⟩
      exact ⟨π, hπ, Subtype.ext hz.symm⟩
    · rintro ⟨π, hπ, rfl⟩
      exact ⟨π, hπ, rfl⟩
  have hIeq : (Ideal.span {z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (z : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}).map
        (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) L)
          (Localization.AtPrime 𝔮)) =
      ((IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap (AdjoinRoot FP) (Localization.AtPrime Q)).comp
          ((AdjoinRoot.of FP).comp (ψ.comp Polynomial.C)))).map
        (Φ : Localization.AtPrime Q →+* Localization.AtPrime 𝔮) := by
    rw [Ideal.map_map, hcomp, ← Ideal.map_map, hset]
    rfl
  let E : (Localization.AtPrime Q ⧸ (IsLocalRing.maximalIdeal ↥W).map
