            _ = ψ t * (ψ c * v) := by rw [map_add, map_mul, hi0]; ring
        rw [hz']
        exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
      · rw [Ideal.span_singleton_le_iff_mem, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        exact hN t ht𝔭
    refine ⟨fun a b hab => ?_, fun s hs hst => ?_⟩
    · have h0 : ψ a * ψ b = 0 := by
        rw [← map_mul]; exact (hT _).mpr ⟨1, h1𝔭, by rwa [one_mul]⟩
      rcases mul_eq_zero.mp h0 with h0 | h0
      · obtain ⟨s, hs, hsa⟩ := (hT a).mp h0
        exact ⟨s, hs, Or.inl hsa⟩
      · obtain ⟨s, hs, hsb⟩ := (hT b).mp h0
        exact ⟨s, hs, Or.inr hsb⟩
    · have h0 : ψ s * ψ t = 0 := by
        rw [← map_mul]; exact (hT _).mpr ⟨1, h1𝔭, by rwa [one_mul]⟩
      have ht0 : ψ t = 0 := (hU s hs).mul_right_eq_zero.mp h0
      have hsp : Ideal.span {(0 : Localization.AtPrime q)} = ⊥ := Ideal.span_singleton_eq_bot.mpr rfl
      rw [ht0, hsp] at hmax'
      exact IsDiscreteValuationRing.not_a_field _ hmax'
  obtain ⟨hC1, hC2⟩ := SF

  have hmax : 𝔭.IsMaximal := hPD.2.2.2.1
  have hPrime : 𝔭.IsPrime := hmax.isPrime
  have hI𝔭 : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 := hPD.2.2.2.2.1
  have ht𝔭 : t ∈ 𝔭 := hPD.2.2.2.2.2.1
  set I := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) with hIdef
  have h1𝔭 : (1 : A) ∉ 𝔭 := (Ideal.ne_top_iff_one 𝔭).mp hmax.ne_top
  have hnot : ∀ {x y : A}, x ∉ 𝔭 → y ∉ 𝔭 → x * y ∉ 𝔭 := fun hx hy hxy =>
    (hPrime.mem_or_mem hxy).elim hx hy
  have hnotpow : ∀ {x : A} (n : ℕ), x ∉ 𝔭 → x ^ n ∉ 𝔭 := fun n hx hxn =>
    hx (hPrime.mem_of_pow_mem n hxn)
  have hmem : ∀ r : ↥W, r ∈ IsLocalRing.maximalIdeal ↥W → algebraMap ↥W A r ∈ 𝔭 :=
    fun r hr => hI𝔭 (Ideal.mem_map_of_mem _ hr)
  have hunitnot : ∀ r : ↥W, r ∉ IsLocalRing.maximalIdeal ↥W → algebraMap ↥W A r ∉ 𝔭 := by
    intro r hr hr𝔭
    have hu : IsUnit (algebraMap ↥W A r) := (IsLocalRing.notMem_maximalIdeal.mp hr).map _
    exact hPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hr𝔭 hu)
  have hinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have T0 : ∀ (d : A) (x : K), wcLlsKPLoc A K 0 d x ↔
      ∃ (n : ℕ) (a : A), algebraMap A K a = algebraMap A K d ^ n * x := by
    intro d x
    have hbot : Algebra.adjoin A ({0} : Set K) = ⊥ := by
      apply le_antisymm
      · rw [Algebra.adjoin_le_iff]
        intro z hz
        rw [Set.mem_singleton_iff.mp hz]
        exact Subalgebra.zero_mem _
      · exact bot_le
    unfold wcLlsKPLoc
    rw [hbot]
    constructor
    · rintro ⟨n, hn⟩
      obtain ⟨a, ha⟩ := Algebra.mem_bot.mp hn
      exact ⟨n, a, ha⟩
    · rintro ⟨n, a, ha⟩
      exact ⟨n, Algebra.mem_bot.mpr ⟨a, ha⟩⟩

  have tcancel : ∀ (k : ℕ) (x : A), t ^ k * x ∈ I → ∃ s' : A, s' ∉ 𝔭 ∧ s' * x ∈ I := by
    intro k
    induction k with
    | zero => intro x hx; exact ⟨1, h1𝔭, by simpa using hx⟩
    | succ k ih =>
      intro x hx
      have hx' : t * (t ^ k * x) ∈ I := by
        rw [← mul_assoc, ← pow_succ']; exact hx
      obtain ⟨s₁, hs₁, hor⟩ := hC1 t (t ^ k * x) hx'
      rcases hor with h1 | h1
      · exact absurd h1 (hC2 s₁ hs₁)
      · have h2 : t ^ k * (s₁ * x) ∈ I := by rw [mul_left_comm]; exact h1
        obtain ⟨s₂, hs₂, h3⟩ := ih (s₁ * x) h2
        exact ⟨s₂ * s₁, hnot hs₂ hs₁, by rw [mul_assoc]; exact h3⟩
  have NT : ∀ (Q : Polynomial ↥W) (N j : ℕ) (s a : A), s ∉ 𝔭 → j < N →
      Q.coeff j ∉ IsLocalRing.maximalIdeal ↥W → s * Q.eval₂ (algebraMap ↥W A) t ≠ t ^ N * a := by
    intro Q N j s a hs hjN hQj heq
    have hex : ∃ i, Q.coeff i ∉ IsLocalRing.maximalIdeal ↥W := ⟨j, hQj⟩
    set j₀ := Nat.find hex with hj₀
    have hj₀spec : Q.coeff j₀ ∉ IsLocalRing.maximalIdeal ↥W := Nat.find_spec hex
    have hj₀j : j₀ ≤ j := Nat.find_min' hex hQj
    have hj₀min : ∀ i, i < j₀ → Q.coeff i ∈ IsLocalRing.maximalIdeal ↥W := by
      intro i hi; by_contra hc; exact Nat.find_min hex hi hc
    set L : Polynomial ↥W := ∑ i ∈ Finset.range j₀, Polynomial.C (Q.coeff i) * Polynomial.X ^ i
      with hL
    have hLcoeff : ∀ d, L.coeff d = if d ∈ Finset.range j₀ then Q.coeff d else 0 := by
      intro d
      rw [hL, Polynomial.finsetSum_coeff]
      simp only [Polynomial.coeff_C_mul_X_pow]
      rw [Finset.sum_ite_eq]
    have hdvd : Polynomial.X ^ j₀ ∣ Q - L := by
      rw [Polynomial.X_pow_dvd_iff]
      intro d hd
      rw [Polynomial.coeff_sub, hLcoeff, if_pos (Finset.mem_range.mpr hd), sub_self]
    obtain ⟨R, hR⟩ := hdvd
    have hR0 : R.coeff 0 = Q.coeff j₀ := by
      have h1 : (Q - L).coeff j₀ = (Polynomial.X ^ j₀ * R).coeff j₀ := by rw [hR]
      rw [Polynomial.coeff_sub, hLcoeff, if_neg (by simp), sub_zero, Polynomial.coeff_X_pow_mul',
        if_pos le_rfl, Nat.sub_self] at h1
      exact h1.symm
    have hQ : Q = L + Polynomial.X ^ j₀ * R := by rw [← hR]; ring
    have hLt : L.eval₂ (algebraMap ↥W A) t ∈ I := by
      rw [hL, Polynomial.eval₂_finset_sum]
      refine Ideal.sum_mem _ (fun i hi => ?_)
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (hj₀min i (Finset.mem_range.mp hi)))
    have hNj : j₀ + (N - j₀) = N := by omega
    have hkey : t ^ j₀ * (s * R.eval₂ (algebraMap ↥W A) t - t ^ (N - j₀) * a) ∈ I := by
      have e2 : Q.eval₂ (algebraMap ↥W A) t =
          L.eval₂ (algebraMap ↥W A) t + t ^ j₀ * R.eval₂ (algebraMap ↥W A) t := by
        conv_lhs => rw [hQ]
        rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X_pow]
      have e3 : t ^ N = t ^ j₀ * t ^ (N - j₀) := by rw [← pow_add, hNj]
      have e1 : t ^ j₀ * (s * R.eval₂ (algebraMap ↥W A) t - t ^ (N - j₀) * a) =
          -(s * L.eval₂ (algebraMap ↥W A) t) := by
        rw [e2, e3] at heq
        linear_combination heq
      rw [e1]
      exact I.neg_mem_iff.mpr (Ideal.mul_mem_left _ _ hLt)
    obtain ⟨s', hs', hs'mem⟩ := tcancel j₀ _ hkey
    have h1 : s * R.eval₂ (algebraMap ↥W A) t - t ^ (N - j₀) * a ∈ 𝔭 :=
      (hPrime.mem_or_mem (hI𝔭 hs'mem)).resolve_left hs'
    have h2 : t ^ (N - j₀) * a ∈ 𝔭 :=
      Ideal.mul_mem_right _ _ (Ideal.pow_mem_of_mem _ ht𝔭 _ (by omega))
    have h3 : R.eval₂ (algebraMap ↥W A) t ∈ 𝔭 := by
      have := Ideal.add_mem _ h1 h2
      rw [sub_add_cancel] at this
      exact (hPrime.mem_or_mem this).resolve_left hs
    have h4 : algebraMap ↥W A (R.coeff 0) ∈ 𝔭 := by
      have e : algebraMap ↥W A (R.coeff 0) = R.eval₂ (algebraMap ↥W A) t -
          (R.divX).eval₂ (algebraMap ↥W A) t * t := by
        have hRd := congrArg (Polynomial.eval₂ (algebraMap ↥W A) t) (Polynomial.divX_mul_X_add R)
        rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X,
          Polynomial.eval₂_C] at hRd
        linear_combination hRd
      rw [e]
      exact Ideal.sub_mem _ h3 (Ideal.mul_mem_left _ _ ht𝔭)
    rw [hR0] at h4
    exact hunitnot _ hj₀spec h4

  have hf0 : f₂ ≠ 0 := by
    intro hf
    have hGq : algebraMap A K (algebraMap ↥W A γ₁) ^ ℓ * q = -1 := by
      linear_combination hf - hq
    by_cases hγm : γ₁ ∈ IsLocalRing.maximalIdeal ↥W
    · obtain ⟨n, a, ha⟩ := (T0 d₂ q).mp hLq
      have e : algebraMap ↥W A γ₁ ^ ℓ * a = -(d₂ ^ n) := by
        apply hinj
        simp only [map_mul, map_pow, map_neg]
        rw [ha]
        linear_combination (algebraMap A K d₂ ^ n) * hGq
      have h1 : algebraMap ↥W A γ₁ ^ ℓ * a ∈ 𝔭 :=
        Ideal.mul_mem_right _ _ (Ideal.pow_mem_of_mem _ (hmem _ hγm) _ hℓ.pos)
      rw [e, Ideal.neg_mem_iff] at h1
      exact hnotpow n hd₂ h1
    · obtain ⟨ν, hν⟩ := (IsLocalRing.notMem_maximalIdeal.mp hγm).exists_right_inv
      have hGV : (algebraMap A K (algebraMap ↥W A γ₁) * algebraMap A K (algebraMap ↥W A ν)) ^ ℓ
          = 1 := by
        rw [← map_mul, ← map_mul, hν, map_one, map_one, one_pow]
      have hqν : q = -(algebraMap A K (algebraMap ↥W A ν)) ^ ℓ := by
        linear_combination (algebraMap A K (algebraMap ↥W A ν)) ^ ℓ * hGq - q * hGV
      obtain ⟨n, a, ha⟩ := (T0 d' y).mp hy
      have hQK : algebraMap A K ((P + Polynomial.C (ν ^ ℓ)).eval₂ (algebraMap ↥W A) t) =
          P.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K t) +
            algebraMap A K (algebraMap ↥W A ν) ^ ℓ := by
        rw [Polynomial.hom_eval₂]
        simp only [Polynomial.eval₂_add, Polynomial.eval₂_C, Polynomial.eval₂_pow,
          RingHom.comp_apply, map_pow]
      have e : d' ^ n * (P + Polynomial.C (ν ^ ℓ)).eval₂ (algebraMap ↥W A) t = t ^ N * (-a) := by
        apply hinj
        rw [map_mul, map_mul, map_neg, hQK, ha]
        simp only [map_pow]
        rw [hqν] at hqP
        linear_combination -(algebraMap A K d' ^ n) * hqP
      have hQj : (P + Polynomial.C (ν ^ ℓ)).coeff j ∉ IsLocalRing.maximalIdeal ↥W := by
        have hj0 : j ≠ 0 := by rintro rfl; exact hpj (dvd_zero ℓ)
        rw [Polynomial.coeff_add, Polynomial.coeff_C, if_neg hj0, add_zero]; exact hPj
      exact NT _ N j (d' ^ n) (-a) (hnotpow n hd') hjN hQj e

  have hc₀ : IsUnit (1 + γ₁ ^ ℓ * P.coeff 0) := by
    by_contra hc
    have hcm : 1 + γ₁ ^ ℓ * P.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W :=
      (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hc)
    obtain ⟨N', hN'⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by omega⟩
    rw [hN'] at hqP
    obtain ⟨n, a, ha⟩ := (T0 d' y).mp hy
    obtain ⟨k, b, hb⟩ := (T0 d₂ f₂⁻¹).mp hLfi
    have hPdiv : P.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K t) =
        (P.divX).eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K t) *
          algebraMap A K t + algebraMap A K (algebraMap ↥W A (P.coeff 0)) := by
      conv_lhs => rw [← Polynomial.divX_mul_X_add P]
      rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X, Polynomial.eval₂_C,
        RingHom.comp_apply]
    have hdivK := Polynomial.hom_eval₂ P.divX (algebraMap ↥W A) (algebraMap A K) t
    have hX'K : algebraMap A K (d' ^ n * algebraMap ↥W A (1 + γ₁ ^ ℓ * P.coeff 0) +
        t * (algebraMap ↥W A γ₁ ^ ℓ * (d' ^ n * (P.divX).eval₂ (algebraMap ↥W A) t +
          t ^ N' * a))) = algebraMap A K d' ^ n * f₂ := by
      have hf₂ : f₂ = 1 + algebraMap A K (algebraMap ↥W A γ₁) ^ ℓ * q := by
        linear_combination hq
      simp only [map_add, map_mul, map_pow, map_one]
      rw [hdivK, ha, hf₂, hqP, hPdiv]
      ring
    have hff : f₂ * f₂⁻¹ = 1 := mul_inv_cancel₀ hf0
    have e : d' ^ n * d₂ ^ k = (d' ^ n * algebraMap ↥W A (1 + γ₁ ^ ℓ * P.coeff 0) +
        t * (algebraMap ↥W A γ₁ ^ ℓ * (d' ^ n * (P.divX).eval₂ (algebraMap ↥W A) t +
          t ^ N' * a))) * b := by
      apply hinj
      rw [map_mul (algebraMap A K) _ b, hX'K, hb, map_mul, map_pow, map_pow]
      linear_combination -(algebraMap A K d' ^ n * algebraMap A K d₂ ^ k) * hff
    have hX'𝔭 : d' ^ n * algebraMap ↥W A (1 + γ₁ ^ ℓ * P.coeff 0) +
        t * (algebraMap ↥W A γ₁ ^ ℓ * (d' ^ n * (P.divX).eval₂ (algebraMap ↥W A) t +
          t ^ N' * a)) ∈ 𝔭 :=
      Ideal.add_mem _ (Ideal.mul_mem_left _ _ (hmem _ hcm)) (Ideal.mul_mem_right _ _ ht𝔭)
    have hin : d' ^ n * d₂ ^ k ∈ 𝔭 := by rw [e]; exact Ideal.mul_mem_right _ _ hX'𝔭
    exact hnot (hnotpow n hd') (hnotpow k hd₂) hin

  obtain ⟨hpoly, g, σ, m₀, hσu, hh0, hm₁, hm₀j, hpm₀, hg0, hgm, hglow, hId⟩ :=
    NF ℓ hℓ hκ γ₁ w P j hpw hwm hpj hPj hc₀

  obtain ⟨τ, hστ⟩ := hσu.exists_right_inv
  have hτ0 : τ ≠ 0 := by rintro rfl; rw [mul_zero] at hστ; exact zero_ne_one hστ
  obtain ⟨r, hr⟩ : ∃ r, N = m₀ + 1 + r := ⟨N - (m₀ + 1), by omega⟩
  obtain ⟨n, a, ha⟩ := (T0 d' y).mp hy
  refine ⟨hpoly, g, γ₁ * σ, w * τ ^ (ℓ - 1), m₀, d',
    algebraMap A K (algebraMap ↥W A τ) ^ ℓ * algebraMap A K t ^ r * y, hd',
    mul_ne_zero hγ₁ hσu.ne_zero, Ideal.mul_mem_right _ _ hwm, mul_ne_zero hw0 (pow_ne_zero _ hτ0),
    ?_, hh0, hg0, hgm, hm₁, hpm₀, hglow, ?_, ?_⟩
  · have h1 : (σ * τ) ^ (ℓ - 1) = 1 := by rw [hστ, one_pow]
    rw [hpw]
    linear_combination (-(γ₁ ^ (ℓ - 1) * w)) * h1
  · refine (T0 d' _).mpr ⟨n, algebraMap ↥W A τ ^ ℓ * t ^ r * a, ?_⟩
    simp only [map_mul, map_pow]
    rw [ha]
    ring
  · have hIdK := congrArg
      (Polynomial.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K t)) hId
    simp only [Polynomial.eval₂_add, Polynomial.eval₂_one, Polynomial.eval₂_mul,
      Polynomial.eval₂_C, Polynomial.eval₂_pow, RingHom.comp_apply, map_pow, map_mul] at hIdK
    have hST : (algebraMap A K (algebraMap ↥W A σ) * algebraMap A K (algebraMap ↥W A τ)) ^ ℓ
        = 1 := by
      rw [← map_mul, ← map_mul, hστ, map_one, map_one, one_pow]
    have hγσ : algebraMap A K (algebraMap ↥W A (γ₁ * σ)) =
        algebraMap A K (algebraMap ↥W A γ₁) * algebraMap A K (algebraMap ↥W A σ) := by
      rw [map_mul, map_mul]
    rw [hr, pow_add] at hqP
    rw [hγσ]
    linear_combination hq + (algebraMap A K (algebraMap ↥W A γ₁)) ^ ℓ * hqP + hIdK -
      (algebraMap A K (algebraMap ↥W A γ₁)) ^ ℓ * algebraMap A K t ^ (m₀ + 1) *
        algebraMap A K t ^ r * y * hST

theorem wcLlsKP_nfb_beta_exists : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (ℓ m₀ : ℕ) (g : Polynomial ↥W) (w : ↥W), 1 ≤ m₀ →
    w ∈ IsLocalRing.maximalIdeal ↥W → w ≠ 0 →
    (∀ j, j < m₀ → g.coeff j ∈ IsLocalRing.maximalIdeal ↥W) →
    ∃ β : ↥W, β ∈ IsLocalRing.maximalIdeal ↥W ∧ β ≠ 0 ∧
      (∀ j, j < m₀ → β ^ (m₀ - j) ∣ g.coeff j) ∧ β ^ ((ℓ - 1) * m₀) ∣ w ^ ℓ :=
by
  intro Ω _ _ W ℓ m₀ g w hm₀ hw hw0 hg

  have root : ∀ (a : ↥W) (n : ℕ), 0 < n → a ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ r : ↥W, r ∈ IsLocalRing.maximalIdeal ↥W ∧ r ^ n = a := by
    intro a n hn ha
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (a : Ω) hn
    have hzW : z ∈ W := by
      by_cases hz0 : z = 0
      · rw [hz0]; exact W.zero_mem
      rcases W.mem_or_inv_mem z with h | h
      · exact h
      · obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
        have e : z = z ^ (k + 1) * z⁻¹ ^ k := by
          symm
          rw [inv_pow, ← div_eq_mul_inv, div_eq_iff (pow_ne_zero k hz0), pow_succ, mul_comm]
        rw [e, hz]
        exact mul_mem a.2 (pow_mem h k)
    have hrn : (⟨z, hzW⟩ : ↥W) ^ n = a := Subtype.ext (by simpa using hz)
    refine ⟨⟨z, hzW⟩, ?_, hrn⟩
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have hau : IsUnit a := by rw [← hrn]; exact hu.pow n
    exact ((IsLocalRing.mem_maximalIdeal _).mp ha) hau

  have common : ∀ (r : ↥W) (f : ℕ → ↥W) (k : ℕ), r ∈ IsLocalRing.maximalIdeal ↥W → r ≠ 0 →
      (∀ j, j < k → f j ∈ IsLocalRing.maximalIdeal ↥W) →
      ∃ β : ↥W, β ∈ IsLocalRing.maximalIdeal ↥W ∧ β ≠ 0 ∧ β ∣ r ∧ ∀ j, j < k → β ∣ f j := by
    intro r f k hr hr0 hf
    induction k with
    | zero => exact ⟨r, hr, hr0, dvd_refl r, fun j hj => absurd hj (Nat.not_lt_zero j)⟩
    | succ k ih =>
      obtain ⟨β, hβ, hβ0, hβr, hβf⟩ := ih (fun j hj => hf j (by omega))
      rcases ValuationRing.dvd_total β (f k) with h | h
      · refine ⟨β, hβ, hβ0, hβr, fun j hj => ?_⟩
        rcases Nat.lt_succ_iff_lt_or_eq.mp hj with h' | h'
        · exact hβf j h'
        · rw [h']; exact h
      · refine ⟨f k, hf k (by omega), ?_, dvd_trans h hβr, fun j hj => ?_⟩
        · intro h0
          rw [h0, zero_dvd_iff] at h
          exact hβ0 h
        · rcases Nat.lt_succ_iff_lt_or_eq.mp hj with h' | h'
          · exact dvd_trans h (hβf j h')
          · rw [h']

  obtain ⟨r, hr, hr0, hrN⟩ : ∃ r : ↥W, r ∈ IsLocalRing.maximalIdeal ↥W ∧ r ≠ 0 ∧
      ((ℓ - 1) * m₀ ≠ 0 → r ^ ((ℓ - 1) * m₀) = w ^ ℓ) := by
    by_cases hN0 : (ℓ - 1) * m₀ = 0
    · exact ⟨w, hw, hw0, fun h => absurd hN0 h⟩
    · have hℓ : ℓ ≠ 0 := by
        intro h; apply hN0; simp [h]
      have hwl : w ^ ℓ ∈ IsLocalRing.maximalIdeal ↥W :=
        Ideal.pow_mem_of_mem _ hw ℓ (Nat.pos_of_ne_zero hℓ)
      obtain ⟨r, hr, hrN⟩ := root (w ^ ℓ) ((ℓ - 1) * m₀) (Nat.pos_of_ne_zero hN0) hwl
      refine ⟨r, hr, ?_, fun _ => hrN⟩
      intro h0
      rw [h0, zero_pow hN0] at hrN
      exact hw0 ((pow_eq_zero_iff hℓ).mp hrN.symm)

  have hex : ∀ j : ℕ, ∃ s : ↥W, j < m₀ →
      s ∈ IsLocalRing.maximalIdeal ↥W ∧ s ^ (m₀ - j) = g.coeff j := by
    intro j
    by_cases hj : j < m₀
    · obtain ⟨s, hs, hs'⟩ := root (g.coeff j) (m₀ - j) (by omega) (hg j hj)
      exact ⟨s, fun _ => ⟨hs, hs'⟩⟩
    · exact ⟨0, fun h => absurd h hj⟩
  choose f hf using hex

  obtain ⟨β, hβ, hβ0, hβr, hβf⟩ := common r f m₀ hr hr0 (fun j hj => (hf j hj).1)
  refine ⟨β, hβ, hβ0, fun j hj => ?_, ?_⟩
  · rw [← (hf j hj).2]
    exact pow_dvd_pow_of_dvd (hβf j hj) _
  · by_cases hN0 : (ℓ - 1) * m₀ = 0
    · rw [hN0, pow_zero]
      exact one_dvd _
    · rw [← hrN hN0]
      exact pow_dvd_pow_of_dvd hβr _

theorem wcLlsKP_nfb_gc_small : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (h g : Polynomial ↥W) (γ w β : ↥W) (m₀ : ℕ), γ ≠ 0 →
      ((ℓ : ℕ) : ↥W) = γ ^ (ℓ - 1) * w → w ∈ IsLocalRing.maximalIdeal ↥W →
      IsUnit (h.coeff 0) → g.coeff 0 = 0 → g.coeff m₀ = 1 → 1 ≤ m₀ → ¬ ℓ ∣ m₀ → m₀ < ℓ →
      β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 → (∀ j, j < m₀ → β ^ (m₀ - j) ∣ g.coeff j) →
      β ^ ((ℓ - 1) * m₀) ∣ w ^ ℓ →
      ∃ (ξ b ζ γ' : ↥W) (h' g' : Polynomial ↥W), β ∣ ξ ∧ b ∈ IsLocalRing.maximalIdeal ↥W ∧
        b ≠ 0 ∧ ζ ^ ℓ = b ∧ γ' ≠ 0 ∧ (∃ υ : ↥W, IsUnit υ ∧ γ' = γ * υ) ∧
        IsUnit (h'.coeff 0) ∧ g'.coeff 0 = 0 ∧ g'.coeff m₀ = 1 ∧
        (∀ j, j < m₀ → b ^ (m₀ - j) ∣ g'.coeff j) ∧
        (h ^ ℓ + Polynomial.C γ ^ ℓ * g).comp (Polynomial.X + Polynomial.C ξ) =
          h' ^ ℓ + Polynomial.C γ' ^ ℓ * g' ∧
        ∃ ε₀ : ↥W, ((ℓ : ℕ) : ↥W) = (γ' * ζ ^ m₀) ^ (ℓ - 1) * ε₀ ∧
          (IsUnit ε₀ ∨ (ε₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ ∃ k : ℕ, 2 ≤ k ∧ k < m₀ ∧ ¬ ℓ ∣ k ∧
            (∃ e : ↥W, IsUnit e ∧ g'.coeff k = b ^ (m₀ - k) * e) ∧
            ∃ π : ↥W, π ∈ IsLocalRing.maximalIdeal ↥W ∧ g'.coeff 1 = b ^ (m₀ - 1) * π)) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ h g γ w β m₀ hγ hpw hwm hh0 hg0 hgm hm₀ hpm₀ hlt hβm hβ0
    hβlow hβw
  classical

  have hroot : ∀ (x : ↥W) (n : ℕ), 0 < n → ∃ z : ↥W, z ^ n = x := by
    intro x n hn
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (x : Ω) hn
    have hzW : z ∈ W := by
      rcases W.mem_or_inv_mem z with h | h
      · exact h
      · by_cases hz0 : z = 0
        · rw [hz0]; exact W.zero_mem
        obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
        have : z = (x : Ω) * (z⁻¹) ^ k := by
          rw [← hz, pow_succ, inv_pow, mul_comm (z ^ k), mul_assoc,
            mul_inv_cancel₀ (pow_ne_zero _ hz0), mul_one]
        rw [this]
        exact mul_mem x.2 (pow_mem h k)
    exact ⟨⟨z, hzW⟩, Subtype.ext (by simp [hz])⟩

  have c2 : ∀ (Q : Polynomial ↥W) (n : ℕ), 1 ≤ n → IsUnit (Q.coeff n) → ∃ s : ↥W, Q.eval s = 0 := by
    intro Q n hn hu
    set f : ↥W →+* Ω := algebraMap ↥W Ω with hf
    set v := W.valuation with hv
    set q := Q.map f with hq
    have hfinj : Function.Injective f := Subtype.val_injective
    have hqc : ∀ k, q.coeff k = f (Q.coeff k) := fun k => Polynomial.coeff_map _ _
    have hq0 : q ≠ 0 := by
      intro h0
      have := hqc n
      rw [h0, Polynomial.coeff_zero] at this
      exact hu.ne_zero (hfinj (by rw [← this, map_zero]))
    by_contra hno
    push_neg at hno
    have hroots : ∀ α ∈ q.roots, 1 < v α := by
      intro α hα
      by_contra hle
      push_neg at hle
      have hαW : α ∈ W := (W.valuation_le_one_iff α).mp hle
      apply hno ⟨α, hαW⟩
      apply hfinj
      have h1 : q.eval α = 0 := (Polynomial.mem_roots hq0).mp hα
      rw [map_zero, ← h1, hq, Polynomial.eval_map, ← Polynomial.eval₂_at_apply]
      rfl
    have claim : ∀ R : Multiset Ω, (∀ α ∈ R, 1 < v α) → ∀ c : Ω, c ≠ 0 →
        (Polynomial.C c * (R.map fun a => Polynomial.X - Polynomial.C a).prod).coeff 0 ≠ 0 ∧
        ∀ k, 1 ≤ k → v ((Polynomial.C c * (R.map fun a => Polynomial.X - Polynomial.C a).prod).coeff k)
          < v ((Polynomial.C c * (R.map fun a => Polynomial.X - Polynomial.C a).prod).coeff 0) := by
      intro R
      induction R using Multiset.induction_on with
      | empty =>
        intro _ c hc
        refine ⟨by simpa using hc, fun k hk => ?_⟩
        simp only [Multiset.map_zero, Multiset.prod_zero, mul_one, Polynomial.coeff_C]
        rw [if_neg (by omega), map_zero]
        simp only [↓reduceIte]
        exact zero_lt_iff.mpr ((Valuation.ne_zero_iff v).mpr hc)
      | cons α R ih =>
        intro hR c hc
        obtain ⟨ih0, ihk⟩ := ih (fun a ha => hR a (Multiset.mem_cons_of_mem ha)) c hc
        have hα := hR α (Multiset.mem_cons_self α R)
        set P := Polynomial.C c * (R.map fun a => Polynomial.X - Polynomial.C a).prod with hP
        have heq : Polynomial.C c * ((α ::ₘ R).map fun a => Polynomial.X - Polynomial.C a).prod
            = P * (Polynomial.X - Polynomial.C α) := by
          rw [Multiset.map_cons, Multiset.prod_cons, hP]; ring
        rw [heq]
        have hc0 : (P * (Polynomial.X - Polynomial.C α)).coeff 0 = P.coeff 0 * (-α) := by
          rw [Polynomial.mul_coeff_zero]; simp
        have hα0 : α ≠ 0 := by
          rintro rfl; rw [map_zero] at hα; exact absurd hα (not_lt.mpr zero_le')
        have hvα0 : v α ≠ 0 := (Valuation.ne_zero_iff v).mpr hα0
        have hvP0 : v (P.coeff 0) ≠ 0 := (Valuation.ne_zero_iff v).mpr ih0
        refine ⟨by rw [hc0]; exact mul_ne_zero ih0 (neg_ne_zero.mpr hα0), fun k hk => ?_⟩
        obtain ⟨a, rfl⟩ : ∃ a, k = a + 1 := ⟨k - 1, by omega⟩
        rw [Polynomial.coeff_mul_X_sub_C, hc0, Valuation.map_mul, Valuation.map_neg]
        refine lt_of_le_of_lt (Valuation.map_sub v _ _) (max_lt ?_ ?_)
        · have h1 : v (P.coeff a) ≤ v (P.coeff 0) := by
            rcases Nat.eq_zero_or_pos a with ha | ha
            · rw [ha]
            · exact (ihk a ha).le
          refine lt_of_le_of_lt h1 ?_
          calc v (P.coeff 0) = v (P.coeff 0) * 1 := (mul_one _).symm
            _ < v (P.coeff 0) * v α := mul_lt_mul_of_pos_left hα (zero_lt_iff.mpr hvP0)
        · rw [Valuation.map_mul]
          exact mul_lt_mul_of_pos_right (ihk (a + 1) (by omega)) (zero_lt_iff.mpr hvα0)
    have hsplit : Polynomial.C q.leadingCoeff *
        (q.roots.map fun a => Polynomial.X - Polynomial.C a).prod = q :=
      Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C (IsAlgClosed.card_roots_eq_natDegree)
    obtain ⟨_, hlt⟩ := claim q.roots hroots q.leadingCoeff (Polynomial.leadingCoeff_ne_zero.mpr hq0)
    have hlt' := hlt n hn
    rw [hsplit, hqc, hqc] at hlt'
    have hle : v (f (Q.coeff 0)) ≤ 1 := W.valuation_le_one (Q.coeff 0)
    have hmem : Q.coeff n ∈ IsLocalRing.maximalIdeal ↥W :=
      (W.valuation_lt_one_iff (Q.coeff n)).mpr (lt_of_lt_of_le hlt' hle)
    exact (IsLocalRing.mem_maximalIdeal _).mp hmem hu

  have c3 : ∀ (h g : Polynomial ↥W) (β : ↥W) (m₀ : ℕ), IsUnit (h.coeff 0) → g.coeff m₀ = 1 →
      1 ≤ m₀ → ¬ ℓ ∣ m₀ → β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 →
      (∀ j, j < m₀ → β ^ (m₀ - j) ∣ g.coeff j) →
      ∃ Q : Polynomial ↥W, IsUnit (Q.coeff (m₀ - 1)) ∧ ∀ s : ↥W,
        (Polynomial.derivative g).eval (β * s) * h.eval (β * s) -
          ((ℓ : ℕ) : ↥W) * (Polynomial.derivative h).eval (β * s) * g.eval (β * s) =
          β ^ (m₀ - 1) * Q.eval s := by
    intro h g β m₀ hh0 hgm hm₀ hpm₀ hβm hβ0 hβlow
    have hcoefP : ∀ (p : Polynomial ↥W) j,
        (p.comp (Polynomial.C β * Polynomial.X)).coeff j = p.coeff j * β ^ j :=
      fun p j => Polynomial.comp_C_mul_X_coeff
    have hdiv : Polynomial.C (β ^ m₀) ∣ g.comp (Polynomial.C β * Polynomial.X) := by
      rw [Polynomial.C_dvd_iff_dvd_coeff]
      intro j
      rw [hcoefP]
      rcases lt_or_ge j m₀ with hj | hj
      · have := mul_dvd_mul (hβlow j hj) (dvd_refl (β ^ j))
        rwa [← pow_add, Nat.sub_add_cancel hj.le] at this
      · exact Dvd.dvd.mul_left (pow_dvd_pow β hj) _
    obtain ⟨G, hG⟩ := hdiv
    have hGm : G.coeff m₀ = 1 := by
      have := congrArg (fun p => Polynomial.coeff p m₀) hG
      simp only [hcoefP, Polynomial.coeff_C_mul, hgm, one_mul] at this
      exact mul_left_cancel₀ (pow_ne_zero m₀ hβ0) (this.symm.trans (mul_one _).symm)
    obtain ⟨k, rfl⟩ : ∃ k, m₀ = k + 1 := ⟨m₀ - 1, by omega⟩
    have hder : (Polynomial.derivative g).comp (Polynomial.C β * Polynomial.X) =
        Polynomial.C (β ^ k) * Polynomial.derivative G := by
      have h1 := congrArg Polynomial.derivative hG
      rw [Polynomial.derivative_comp, Polynomial.derivative_C_mul_X, Polynomial.derivative_C_mul,
        pow_succ', Polynomial.C_mul, mul_assoc] at h1
      exact mul_left_cancel₀ (Polynomial.C_ne_zero.mpr hβ0) h1
    rw [Nat.add_sub_cancel]
    refine ⟨Polynomial.derivative G * h.comp (Polynomial.C β * Polynomial.X) -
        Polynomial.C (((ℓ : ℕ) : ↥W) * β) *
          (Polynomial.derivative h).comp (Polynomial.C β * Polynomial.X) * G, ?_, ?_⟩
    · have hβr : IsLocalRing.residue ↥W β = 0 := (IsLocalRing.residue_eq_zero_iff β).mpr hβm
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit, ← Polynomial.coeff_map]
      simp only [Polynomial.map_sub, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_comp,
        Polynomial.map_X, hβr, map_mul, mul_zero, Polynomial.C_0, zero_mul, sub_zero,
        Polynomial.comp_zero, Polynomial.coeff_mul_C, ← Polynomial.derivative_map,
        Polynomial.coeff_derivative, Polynomial.coeff_map, hGm, map_one, one_mul,
        ← Polynomial.coeff_zero_eq_eval_zero]
      refine mul_ne_zero ?_ ((IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hh0)
      have : ((k + 1 : ℕ) : IsLocalRing.ResidueField ↥W) ≠ 0 := by
        rw [Ne, ringChar.spec, hκ]; exact hpm₀
      exact_mod_cast this
    · intro s
      have e1 : g.eval (β * s) = β ^ (k+1) * G.eval s := by
        have := congrArg (Polynomial.eval s) hG
        simpa only [Polynomial.eval_comp, Polynomial.eval_mul, Polynomial.eval_C,
          Polynomial.eval_X] using this
      have e2 : (Polynomial.derivative g).eval (β * s) =
          β ^ k * (Polynomial.derivative G).eval s := by
        have := congrArg (Polynomial.eval s) hder
        simpa only [Polynomial.eval_comp, Polynomial.eval_mul, Polynomial.eval_C,
          Polynomial.eval_X] using this
      simp only [Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_comp,
        Polynomial.eval_X, e1, e2]
      ring

  have c4 : ∀ (h g : Polynomial ↥W) (γ β ξ : ↥W) (m₀ : ℕ), IsUnit (h.coeff 0) →
      g.coeff m₀ = 1 → 2 ≤ m₀ → β ∈ IsLocalRing.maximalIdeal ↥W →
      (∀ j, j < m₀ → β ^ (m₀ - j) ∣ g.coeff j) → β ∣ ξ →
      (Polynomial.derivative g).eval ξ * h.eval ξ -
        ((ℓ : ℕ) : ↥W) * (Polynomial.derivative h).eval ξ * g.eval ξ = 0 →
      ∃ (υ : ↥W) (h' g' : Polynomial ↥W), IsUnit υ ∧ IsUnit (h'.coeff 0) ∧ g'.coeff 0 = 0 ∧
        g'.coeff 1 = 0 ∧ g'.coeff m₀ = 1 ∧ (∀ j, j < m₀ → β ^ (m₀ - j) ∣ g'.coeff j) ∧
        (h ^ ℓ + Polynomial.C γ ^ ℓ * g).comp (Polynomial.X + Polynomial.C ξ) =
          h' ^ ℓ + Polynomial.C (γ * υ) ^ ℓ * g' := by
    intro h g γ β ξ m₀ hh0 hgm hm₀ hβm hβlow hβξ hcrit
    have hℓ : 0 < ℓ := hℓ.pos
    obtain ⟨P, hP⟩ : ∃ P : Polynomial ↥W, P = Polynomial.X + Polynomial.C ξ := ⟨_, rfl⟩
    have hξm : ξ ∈ IsLocalRing.maximalIdeal ↥W := by
      obtain ⟨t, rfl⟩ := hβξ; exact Ideal.mul_mem_right _ _ hβm
    have hξr : IsLocalRing.residue ↥W ξ = 0 := (IsLocalRing.residue_eq_zero_iff ξ).mpr hξm
    have hres : ∀ (f : Polynomial ↥W) j, IsLocalRing.residue ↥W ((f.comp P).coeff j) =
        IsLocalRing.residue ↥W (f.coeff j) := by
      intro f j
      rw [hP, ← Polynomial.coeff_map, ← Polynomial.coeff_map, Polynomial.map_comp]
      simp [hξr]
    have hT : ∀ (f : Polynomial ↥W) j, (f.comp P).coeff j = (Polynomial.hasseDeriv j f).eval ξ := by
      intro f j; rw [hP, ← Polynomial.taylor_apply, Polynomial.taylor_coeff]
    have hT0 : ∀ (f : Polynomial ↥W), (f.comp P).coeff 0 = f.eval ξ := by
      intro f; rw [hP, ← Polynomial.taylor_apply, Polynomial.taylor_coeff_zero]
    have hT1 : ∀ (f : Polynomial ↥W), (f.comp P).coeff 1 = (Polynomial.derivative f).eval ξ := by
      intro f; rw [hP, ← Polynomial.taylor_apply, Polynomial.taylor_coeff_one]
    have hβall : ∀ i, β ^ (m₀ - i) ∣ g.coeff i := by
      intro i
      by_cases hi : i < m₀
      · exact hβlow i hi
      · rw [show m₀ - i = 0 by omega, pow_zero]; exact one_dvd _
    have hD : ∀ j, β ^ (m₀ - j) ∣ (g.comp P).coeff j := by
      intro j
      rw [hT, Polynomial.eval_eq_sum_range]
      apply Finset.dvd_sum
      intro n _
      rw [Polynomial.hasseDeriv_coeff]
      obtain ⟨t, ht⟩ := hβξ
      rw [ht, mul_pow]
      by_cases hnj : n + j < m₀
      · have e : β ^ (m₀ - j) = β ^ (m₀ - (n + j)) * β ^ n := by
          rw [← pow_add]; congr 1; omega
        rw [e]
        exact mul_dvd_mul ((hβall (n + j)).mul_left _) (dvd_mul_right _ _)
      · exact Dvd.dvd.mul_left (dvd_mul_of_dvd_left (pow_dvd_pow β (by omega)) _) _
    have hhξ : IsUnit (h.eval ξ) := by
      rw [← hT0 h, ← IsLocalRing.residue_ne_zero_iff_isUnit, hres h 0,
        IsLocalRing.residue_ne_zero_iff_isUnit]
      exact hh0
    obtain ⟨η, hη⟩ := hhξ.exists_right_inv
    have hβm0 : β ^ m₀ ∣ g.eval ξ := by
      have := hD 0; rwa [hT0, Nat.sub_zero] at this
    obtain ⟨u₀, hu₀⟩ : ∃ u : ↥W, u = g.eval ξ * η ^ ℓ := ⟨_, rfl⟩
    have hβu : β ^ m₀ ∣ u₀ := by rw [hu₀]; exact Dvd.dvd.mul_right hβm0 _
    have hu₀m : u₀ ∈ IsLocalRing.maximalIdeal ↥W := by
      obtain ⟨t, ht⟩ := hβu
      rw [ht]; exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_of_mem _ hβm m₀ (by omega))
    have hu₀r : IsLocalRing.residue ↥W u₀ = 0 := (IsLocalRing.residue_eq_zero_iff u₀).mpr hu₀m
    have h1x : IsUnit (1 + γ ^ ℓ * u₀) := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit, map_add, map_one, map_mul, hu₀r, mul_zero,
        add_zero]
      exact one_ne_zero
    obtain ⟨σ, hσ⟩ := hroot (1 + γ ^ ℓ * u₀) ℓ hℓ
    have hσu : IsUnit σ := (isUnit_pow_iff hℓ.ne').mp (hσ ▸ h1x)
    obtain ⟨g'', hg''⟩ : ∃ q : Polynomial ↥W, q = g.comp P - Polynomial.C u₀ * (h ^ ℓ).comp P :=
      ⟨_, rfl⟩
    have hcu : IsUnit (g''.coeff m₀) := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hg'', Polynomial.coeff_sub,
        Polynomial.coeff_C_mul, map_sub, map_mul, hu₀r, zero_mul, sub_zero, hres, hgm, map_one]
      exact one_ne_zero
    obtain ⟨υ, hυ⟩ := hroot (g''.coeff m₀) ℓ hℓ
    have hυu : IsUnit υ := (isUnit_pow_iff hℓ.ne').mp (hυ ▸ hcu)
    obtain ⟨ci, hci⟩ := hcu.exists_right_inv
    have hη1 : η ^ ℓ * (h.eval ξ) ^ ℓ = 1 := by rw [← mul_pow, mul_comm, hη, one_pow]
    have hpow : (h.eval ξ) ^ (ℓ - 1) * h.eval ξ = (h.eval ξ) ^ ℓ := by
      rw [← pow_succ, Nat.sub_add_cancel hℓ]
    refine ⟨υ, Polynomial.C σ * h.comp P, Polynomial.C ci * g'', hυu, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · rw [Polynomial.coeff_C_mul, hT0]; exact hσu.mul hhξ
    · rw [Polynomial.coeff_C_mul, hg'', Polynomial.coeff_sub, Polynomial.coeff_C_mul, hT0, hT0,
        Polynomial.eval_pow, hu₀]
      linear_combination (-(ci * g.eval ξ)) * hη1
    · rw [Polynomial.coeff_C_mul, hg'', Polynomial.coeff_sub, Polynomial.coeff_C_mul, hT1, hT1,
        Polynomial.derivative_pow, hu₀]
      simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow]
      linear_combination (ci * η) * hcrit
        - (ci * η * g.eval ξ * η ^ ℓ * ((ℓ : ℕ) : ↥W) * (Polynomial.derivative h).eval ξ) * hpow
        - (ci * η * ((ℓ : ℕ) : ↥W) * (Polynomial.derivative h).eval ξ * g.eval ξ) * hη1
        - (ci * ((Polynomial.derivative g).eval ξ - g.eval ξ * η ^ ℓ *
            (((ℓ : ℕ) : ↥W) * (h.eval ξ) ^ (ℓ - 1) * (Polynomial.derivative h).eval ξ))) * hη
    · rw [Polynomial.coeff_C_mul, mul_comm, hci]
    · intro j hj
      rw [Polynomial.coeff_C_mul, hg'', Polynomial.coeff_sub, Polynomial.coeff_C_mul]
      exact Dvd.dvd.mul_left (dvd_sub (hD j)
        (Dvd.dvd.mul_right ((pow_dvd_pow β (Nat.sub_le m₀ j)).trans hβu) _)) _
    · rw [← hP, hg'']
      simp only [Polynomial.add_comp, Polynomial.mul_comp, Polynomial.pow_comp, Polynomial.C_comp]
      have e1 : (Polynomial.C σ) ^ ℓ = 1 + (Polynomial.C γ) ^ ℓ * Polynomial.C u₀ := by
        rw [← map_pow, hσ, map_add, map_one, map_mul, map_pow]
      have e2 : (Polynomial.C υ) ^ ℓ * Polynomial.C ci = 1 := by
        rw [← map_pow, ← map_mul, hυ, hci, map_one]
      rw [Polynomial.C_mul]
      linear_combination (-(h.comp P) ^ ℓ) * e1
        - ((Polynomial.C γ) ^ ℓ * (g.comp P - Polynomial.C u₀ * (h.comp P) ^ ℓ)) * e2

  have c5 : ∀ (g' : Polynomial ↥W) (γ υ w β : ↥W) (m₀ : ℕ),
      ((ℓ : ℕ) : ↥W) = γ ^ (ℓ - 1) * w → w ∈ IsLocalRing.maximalIdeal ↥W → w ≠ 0 → IsUnit υ →
      1 ≤ m₀ → m₀ < ℓ → g'.coeff 0 = 0 → (2 ≤ m₀ → g'.coeff 1 = 0) →
      β ∈ IsLocalRing.maximalIdeal ↥W → (∀ j, j < m₀ → β ^ (m₀ - j) ∣ g'.coeff j) →
      ∃ (b ζ ε₀ : ↥W), b ∈ IsLocalRing.maximalIdeal ↥W ∧ b ≠ 0 ∧ ζ ^ ℓ = b ∧
        (∀ j, j < m₀ → b ^ (m₀ - j) ∣ g'.coeff j) ∧
        ((ℓ : ℕ) : ↥W) = (γ * υ * ζ ^ m₀) ^ (ℓ - 1) * ε₀ ∧
        (IsUnit ε₀ ∨ (ε₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ ∃ k : ℕ, 2 ≤ k ∧ k < m₀ ∧ ¬ ℓ ∣ k ∧
          (∃ e : ↥W, IsUnit e ∧ g'.coeff k = b ^ (m₀ - k) * e) ∧
          ∃ π : ↥W, π ∈ IsLocalRing.maximalIdeal ↥W ∧ g'.coeff 1 = b ^ (m₀ - 1) * π)) := by
    intro g' γ υ w β m₀ hpw hwm hw0 hυ hm₀ hlt hg0 hg1 hβm hβlow
    have hℓ2 := hℓ.two_le
    have hℓ0 : 0 < ℓ := by omega
    obtain ⟨υi, hυi⟩ := hυ.exists_right_inv
    have hN : 0 < (ℓ - 1) * m₀ := Nat.mul_pos (by omega) (by omega)
    obtain ⟨ζ₀, hζ₀⟩ := hroot (w * υi ^ (ℓ - 1)) _ hN
    have hu1 : υ ^ (ℓ - 1) * υi ^ (ℓ - 1) = 1 := by rw [← mul_pow, hυi, one_pow]
    have hAS : (γ * υ * ζ₀ ^ m₀) ^ (ℓ - 1) = ((ℓ : ℕ) : ↥W) := by
      rw [mul_pow, mul_pow, ← pow_mul, mul_comm m₀, hζ₀, hpw]
      linear_combination (γ ^ (ℓ - 1) * w) * hu1
    have hwz : w = ζ₀ ^ ((ℓ - 1) * m₀) * υ ^ (ℓ - 1) := by
      rw [hζ₀]; linear_combination (-w) * hu1
    have hζ₀0 : ζ₀ ≠ 0 := by
      rintro rfl; apply hw0; rw [hwz, zero_pow hN.ne', zero_mul]
    have hmax := (IsLocalRing.maximalIdeal.isMaximal ↥W).isPrime
    have hζ₀m : ζ₀ ∈ IsLocalRing.maximalIdeal ↥W := by
      apply hmax.mem_of_pow_mem ((ℓ - 1) * m₀)
      rw [hζ₀]; exact Ideal.mul_mem_right _ _ hwm
    have hb₀m : ζ₀ ^ ℓ ∈ IsLocalRing.maximalIdeal ↥W := Ideal.pow_mem_of_mem _ hζ₀m ℓ hℓ0
    have hb₀0 : ζ₀ ^ ℓ ≠ 0 := pow_ne_zero _ hζ₀0
    have hr : ∀ j, ∃ r : ↥W, j < m₀ → r ^ (m₀ - j) = g'.coeff j := by
      intro j
      by_cases hj : j < m₀
      · obtain ⟨r, hr⟩ := hroot (g'.coeff j) (m₀ - j) (by omega); exact ⟨r, fun _ => hr⟩
      · exact ⟨0, fun h => absurd h hj⟩
    choose r hr using hr
    have hlow01 : ∀ j, j < m₀ → j < 2 → ∀ x : ↥W, x ∣ g'.coeff j := by
      intro j hj hj2 x
      interval_cases j
      · rw [hg0]; exact dvd_zero _
      · rw [hg1 (by omega)]; exact dvd_zero _
    by_cases hA : ∀ j ∈ Finset.Ico 2 m₀, ζ₀ ^ ℓ ∣ r j
    · refine ⟨ζ₀ ^ ℓ, ζ₀, 1, hb₀m, hb₀0, rfl, ?_, by rw [mul_one, hAS], Or.inl isUnit_one⟩
      intro j hj
      by_cases hj2 : j < 2
      · exact hlow01 j hj hj2 _
      · rw [← hr j hj]; exact pow_dvd_pow_of_dvd (hA j (Finset.mem_Ico.mpr ⟨by omega, hj⟩)) _
    · push_neg at hA
      obtain ⟨j₁, hj₁, hnd₁⟩ := hA
      obtain ⟨k, hk, hkmax⟩ := Finset.exists_max_image (Finset.Ico 2 m₀)
        (fun j => W.valuation (r j : Ω)) ⟨j₁, hj₁⟩
      have hkdvd : ∀ j ∈ Finset.Ico 2 m₀, r k ∣ r j := by
        intro j hj
        obtain ⟨a, ha⟩ := (W.valuation_le_iff _ _).mp (hkmax j hj)
        exact ⟨a, Subtype.ext (by rw [MulMemClass.coe_mul, ← ha, mul_comm])⟩
      have hk' := Finset.mem_Ico.mp hk
      have hndk : ¬ ζ₀ ^ ℓ ∣ r k := fun h => hnd₁ (h.trans (hkdvd j₁ hj₁))
      have hb0 : r k ≠ 0 := by
        intro h0; apply hndk; rw [h0]; exact dvd_zero _
      have hbm : r k ∈ IsLocalRing.maximalIdeal ↥W := by
        apply hmax.mem_of_pow_mem (m₀ - k)
        rw [hr k hk'.2]
        obtain ⟨t, ht⟩ := hβlow k hk'.2
        rw [ht]; exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_of_mem _ hβm _ (by omega))
      obtain ⟨ζ, hζ⟩ := hroot (r k) ℓ hℓ0
      have hnd : ¬ ζ₀ ∣ ζ := by
        rintro ⟨δ', hδ'⟩
        apply hndk
        rw [← hζ, hδ', mul_pow]; exact dvd_mul_right _ _
      obtain ⟨δ, hδ⟩ : ζ ∣ ζ₀ := (ValuationRing.dvd_total ζ ζ₀).resolve_right hnd
      have hδm : δ ∈ IsLocalRing.maximalIdeal ↥W := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hδu
        apply hnd
        exact (hδu.dvd_mul_right).mp (by rw [← hδ])
      refine ⟨r k, ζ, δ ^ (m₀ * (ℓ - 1)), hbm, hb0, hζ, ?_, ?_,
        Or.inr ⟨Ideal.pow_mem_of_mem _ hδm _ (Nat.mul_pos (by omega) (by omega)), k, hk'.1, hk'.2,
          ?_, ⟨1, isUnit_one, by rw [mul_one, hr k hk'.2]⟩, 0, Ideal.zero_mem _,
          by rw [mul_zero, hg1 (by omega)]⟩⟩
      · intro j hj
        by_cases hj2 : j < 2
        · exact hlow01 j hj hj2 _
        · rw [← hr j hj]
          exact pow_dvd_pow_of_dvd (hkdvd j (Finset.mem_Ico.mpr ⟨by omega, hj⟩)) _
      · rw [← hAS, hδ]; ring
      · exact Nat.not_dvd_of_pos_of_lt (by omega) (by omega)

  have hw0 : w ≠ 0 := by
    intro hw
    have hℓW : ((ℓ : ℕ) : ↥W) = 0 := by rw [hpw, hw, mul_zero]
    have hℓΩ : ((ℓ : ℕ) : Ω) = 0 := by
      have := congrArg (algebraMap ↥W Ω) hℓW
      rwa [map_natCast, map_zero] at this
    have hdvd : ringChar Ω ∣ ℓ := ringChar.dvd hℓΩ
    rcases hℓ.eq_one_or_self_of_dvd _ hdvd with h1 | h1
    · exact CharP.ringChar_ne_one h1
    · exact hΩ h1
  rcases Nat.lt_or_ge m₀ 2 with hm1 | hm2
  · have hm : m₀ = 1 := by omega
    subst hm
    obtain ⟨b, ζ, ε₀, hbm, hb0, hζ, hblow, hε, hbr⟩ :=
      c5 g γ 1 w β 1 hpw hwm hw0 isUnit_one le_rfl hlt hg0
        (fun h2 => absurd h2 (by norm_num)) hβm hβlow
    refine ⟨0, b, ζ, γ, h, g, dvd_zero _, hbm, hb0, hζ, hγ, ⟨1, isUnit_one, (mul_one γ).symm⟩,
      hh0, hg0, hgm, hblow, ?_, ε₀, ?_, hbr⟩
    · rw [map_zero, add_zero, Polynomial.comp_X]
    · rw [mul_one] at hε; exact hε
  · obtain ⟨Q, hQu, hQ⟩ := c3 h g β m₀ hh0 hgm hm₀ hpm₀ hβm hβ0 hβlow
    obtain ⟨s₀, hs₀⟩ := c2 Q (m₀ - 1) (by omega) hQu
    have hcrit := hQ s₀
    rw [hs₀, mul_zero] at hcrit
    obtain ⟨υ, h', g', hυ, hh'0, hg'0, hg'1, hg'm, hg'low, hcomp⟩ :=
      c4 h g γ β (β * s₀) m₀ hh0 hgm hm2 hβm hβlow (dvd_mul_right β s₀) hcrit
    obtain ⟨b, ζ, ε₀, hbm, hb0, hζ, hblow, hε, hbr⟩ :=
      c5 g' γ υ w β m₀ hpw hwm hw0 hυ hm₀ hlt hg'0 (fun _ => hg'1) hβm hg'low
    exact ⟨β * s₀, b, ζ, γ * υ, h', g', dvd_mul_right β s₀, hbm, hb0, hζ,
      mul_ne_zero hγ hυ.ne_zero, ⟨υ, hυ, rfl⟩, hh'0, hg'0, hg'm, hblow, hcomp, ε₀, hε, hbr⟩

theorem wcLlsKP_gce_real_val : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∃ ν : Ω → ℝ, (∀ x y : Ω, x ≠ 0 → y ≠ 0 → ν (x * y) = ν x + ν y) ∧
      (∀ x y : Ω, x ≠ 0 → y ≠ 0 → x + y ≠ 0 → min (ν x) (ν y) ≤ ν (x + y)) ∧
      (∀ x : Ω, x ≠ 0 → (x ∈ W ↔ 0 ≤ ν x)) ∧
      (∀ x : ↥W, x ≠ 0 → (x ∈ IsLocalRing.maximalIdeal ↥W ↔ 0 < ν (x : Ω))) :=
by
  intro Ω _ W hW
  classical
  have wcLlsKP_nfb_archimedean : ∀ β x : ↥W, β ∈ IsLocalRing.maximalIdeal ↥W → x ≠ 0 →
      ∃ (N : ℕ) (π : ↥W), π ∈ IsLocalRing.maximalIdeal ↥W ∧ β ^ N = x * π := by
    intro β x hβ hx
    by_cases hβ0 : β = 0
    · exact ⟨1, 0, Ideal.zero_mem _, by rw [hβ0, pow_one, mul_zero]⟩
    haveI hdim : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
    have hmax : ∀ I : Ideal ↥W, I ≠ ⊥ → I.IsPrime → I.IsMaximal :=
      Ring.krullDimLE_one_iff_of_isPrime_bot.mp hdim
    have hy : x * β ≠ 0 := mul_ne_zero hx hβ0
    have hrad : β ∈ (Ideal.span {x * β}).radical := by
      rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
      rintro J ⟨hJle, hJp⟩
      have hyJ : x * β ∈ J := (Ideal.span_singleton_le_iff_mem J).mp hJle
      have hJne : J ≠ ⊥ := by
        intro h
        rw [h, Ideal.mem_bot] at hyJ
        exact hy hyJ
      rw [IsLocalRing.eq_maximalIdeal (hmax J hJne hJp)]
      exact hβ
    obtain ⟨n, hn⟩ := (Ideal.mem_radical_iff).mp hrad
    obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp hn
    refine ⟨n, β * r, Ideal.mul_mem_right r _ hβ, ?_⟩
    rw [← hr]
    ring

  have hArch : Archimedean (Additive (W.ValueGroup)ˣ) := by
    constructor
    intro b a ha
    have hA1 : (1 : (W.ValueGroup)ˣ) < Additive.toMul a := by
      have : Additive.ofMul (1 : (W.ValueGroup)ˣ) < a := ha
      exact this
    suffices h : ∃ n : ℕ, Additive.toMul b ≤ (Additive.toMul a) ^ n by
      obtain ⟨n, hn⟩ := h
      exact ⟨n, hn⟩
    rcases le_or_gt (Additive.toMul b) 1 with hB | hB
    · exact ⟨0, by rw [pow_zero]; exact hB⟩
    obtain ⟨α, hα⟩ := W.valuation_surjective ((Additive.toMul a : (W.ValueGroup)ˣ) : W.ValueGroup)
    obtain ⟨z, hz⟩ := W.valuation_surjective ((Additive.toMul b : (W.ValueGroup)ˣ) : W.ValueGroup)
    have hα0 : α ≠ 0 := by
      intro h; rw [h, map_zero] at hα; exact (Units.ne_zero _) hα.symm
    have hz0 : z ≠ 0 := by
      intro h; rw [h, map_zero] at hz; exact (Units.ne_zero _) hz.symm
    have hvαi : W.valuation α⁻¹ = (((Additive.toMul a)⁻¹ : (W.ValueGroup)ˣ) : W.ValueGroup) := by
      rw [map_inv₀, hα, Units.val_inv_eq_inv_val]
    have hvzi : W.valuation z⁻¹ = (((Additive.toMul b)⁻¹ : (W.ValueGroup)ˣ) : W.ValueGroup) := by
      rw [map_inv₀, hz, Units.val_inv_eq_inv_val]
    have hAi : ((Additive.toMul a)⁻¹ : (W.ValueGroup)ˣ) < 1 := inv_lt_one'.mpr hA1
    have hBi : ((Additive.toMul b)⁻¹ : (W.ValueGroup)ˣ) < 1 := inv_lt_one'.mpr hB
    have hαlt : W.valuation α⁻¹ < 1 := by
      rw [hvαi, ← Units.val_one, Units.val_lt_val]; exact hAi
    have hzlt : W.valuation z⁻¹ < 1 := by
      rw [hvzi, ← Units.val_one, Units.val_lt_val]; exact hBi
    have hαW : α⁻¹ ∈ W := (W.valuation_le_one_iff _).mp hαlt.le
    have hzW : z⁻¹ ∈ W := (W.valuation_le_one_iff _).mp hzlt.le
    have hβm : (⟨α⁻¹, hαW⟩ : W) ∈ IsLocalRing.maximalIdeal W :=
      (W.valuation_lt_one_iff _).mpr hαlt
    have hx0 : (⟨z⁻¹, hzW⟩ : W) ≠ 0 := by
      intro h
      have := congrArg (fun t : W => (t : Ω)) h
      simp only [ZeroMemClass.coe_zero] at this
      exact inv_ne_zero hz0 this
    obtain ⟨N, π, hπ, hN⟩ := wcLlsKP_nfb_archimedean _ _ hβm hx0
    have hNΩ : (α⁻¹) ^ N = z⁻¹ * (π : Ω) := by
      have := congrArg (fun t : W => (t : Ω)) hN
      simpa using this
    have hvπ : W.valuation (π : Ω) ≤ 1 := W.valuation_le_one π
    have hle : W.valuation ((α⁻¹) ^ N) ≤ W.valuation z⁻¹ := by
      rw [hNΩ, map_mul]
      exact mul_le_of_le_one_right' hvπ
    rw [map_pow, hvαi, hvzi, ← Units.val_pow_eq_pow_val, Units.val_le_val] at hle
    refine ⟨N, ?_⟩
    rw [inv_pow] at hle
    exact inv_le_inv_iff.mp hle

  obtain ⟨f, hfinj⟩ := Archimedean.exists_orderAddMonoidHom_real_injective (Additive (W.ValueGroup)ˣ)
  have hsm : StrictMono f := (OrderHomClass.mono f).strictMono_of_injective hfinj
  obtain ⟨U, hU⟩ : ∃ U : Ω → (W.ValueGroup)ˣ, ∀ x, x ≠ 0 → ((U x : (W.ValueGroup)ˣ) : W.ValueGroup) = W.valuation x :=
    ⟨fun x => if h : W.valuation x = 0 then 1 else Units.mk0 (W.valuation x) h, fun x hx => by
      have h : W.valuation x ≠ 0 := (Valuation.ne_zero_iff _).mpr hx
      simp only [h, dite_false, Units.val_mk0]⟩
  have hmul : ∀ x y : Ω, x ≠ 0 → y ≠ 0 → U (x * y) = U x * U y := by
    intro x y hx hy
    apply Units.ext
    rw [Units.val_mul, hU _ (mul_ne_zero hx hy), hU x hx, hU y hy, map_mul]
  have hone : U 1 = 1 := by
    apply Units.ext
    rw [hU 1 one_ne_zero, map_one, Units.val_one]
  have hf1 : f (Additive.ofMul (U 1)) = 0 := by
    rw [hone, ofMul_one, map_zero]
  have hle : ∀ x y : Ω, x ≠ 0 → y ≠ 0 →
      (f (Additive.ofMul (U x)) ≤ f (Additive.ofMul (U y)) ↔ W.valuation x ≤ W.valuation y) := by
    intro x y hx hy
    rw [hsm.le_iff_le, Additive.ofMul_le, ← Units.val_le_val, hU x hx, hU y hy]
  have hlt : ∀ x y : Ω, x ≠ 0 → y ≠ 0 →
      (f (Additive.ofMul (U x)) < f (Additive.ofMul (U y)) ↔ W.valuation x < W.valuation y) := by
    intro x y hx hy
    rw [hsm.lt_iff_lt, Additive.ofMul_lt, ← Units.val_lt_val, hU x hx, hU y hy]
  refine ⟨fun x => -(f (Additive.ofMul (U x))), ?_, ?_, ?_, ?_⟩
  · intro x y hx hy
    simp only
    rw [hmul x y hx hy, ofMul_mul, map_add]
    ring
  · intro x y hx hy hxy
    simp only
    have hadd := Valuation.map_add W.valuation x y
    rcases le_total (W.valuation x) (W.valuation y) with h | h
    · rw [max_eq_right h] at hadd
      have h1 := (hle _ _ hxy hy).mpr hadd
      exact min_le_iff.mpr (Or.inr (by linarith))
    · rw [max_eq_left h] at hadd
      have h1 := (hle _ _ hxy hx).mpr hadd
      exact min_le_iff.mpr (Or.inl (by linarith))
  · intro x hx
    simp only
    rw [← W.valuation_le_one_iff, ← map_one W.valuation, ← hle x 1 hx one_ne_zero, hf1]
    constructor <;> intro h <;> linarith
  · intro x hx
    simp only
    have hx' : (x : Ω) ≠ 0 := by
      intro h; apply hx; exact Subtype.ext h
    rw [W.valuation_lt_one_iff, ← map_one W.valuation, ← hlt (x : Ω) 1 hx' one_ne_zero, hf1]
    constructor <;> intro h <;> linarith

theorem wcLlsKP_gp_initial : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (h g : Polynomial ↥W) (β s : ↥W) (m₀ : ℕ), IsUnit (h.coeff 0) → g.coeff m₀ = 1 → β ∈ IsLocalRing.maximalIdeal ↥W → (∀ j, j < m₀ → β ^ (m₀ - j) ∣ g.coeff j) → (∀ j, j < m₀ → β ^ (m₀ - j) ∣ (g.comp (Polynomial.X + Polynomial.C (β * s))).coeff j) ∧ (g.comp (Polynomial.X + Polynomial.C (β * s))).coeff m₀ - 1 ∈ IsLocalRing.maximalIdeal ↥W ∧ IsUnit ((h.comp (Polynomial.X + Polynomial.C (β * s))).coeff 0) ∧ (g.comp (Polynomial.X + Polynomial.C (β * s))).coeff 1 = (Polynomial.derivative g).eval (β * s) :=
by
  intro Ω _ W h g β s m₀ hh hg hβ hdiv
  have hr : β * s ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right s _ hβ
  have key : ∀ (p : Polynomial ↥W) (n : ℕ),
      (p.comp (Polynomial.X + Polynomial.C (β * s))).coeff n - p.coeff n ∈
        IsLocalRing.maximalIdeal ↥W := by
    intro p n
    rw [← Ideal.Quotient.eq, ← Polynomial.taylor_apply]
    have hz : (Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥W)) (β * s) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hr
    rw [← Polynomial.coeff_map, Polynomial.map_taylor, hz, Polynomial.taylor_zero,
      Polynomial.coeff_map]
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro j hj
    rw [Polynomial.comp_eq_sum_left, Polynomial.sum_def, Polynomial.finsetSum_coeff]
    apply Finset.dvd_sum
    intro k _
    rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_add_C_pow, mul_pow]
    rcases lt_or_ge k j with hkj | hjk
    · rw [Nat.choose_eq_zero_of_lt hkj]
      simp
    · rcases lt_or_ge k m₀ with hkm | hmk
      · obtain ⟨a, ha⟩ := hdiv k hkm
        have he : m₀ - j = (m₀ - k) + (k - j) := by omega
        rw [ha, he, pow_add]
        exact ⟨a * s ^ (k - j) * (k.choose j : ↥W), by ring⟩
      · have h1 : β ^ (m₀ - j) ∣ β ^ (k - j) := pow_dvd_pow β (by omega)
        exact Dvd.dvd.mul_left (Dvd.dvd.mul_right (Dvd.dvd.mul_right h1 _) _) _
  · have := key g m₀
    rwa [hg] at this
  · have h1 := key h 0
    by_contra hn
    have h2 : (h.comp (Polynomial.X + Polynomial.C (β * s))).coeff 0 ∈
        IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal _).mpr hn
    have h3 : h.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W := by
      have := Ideal.sub_mem _ h2 h1
      rwa [sub_sub_cancel] at this
    exact ((IsLocalRing.mem_maximalIdeal _).mp h3) hh
  · rw [← Polynomial.taylor_apply, Polynomial.taylor_coeff_one]

theorem wcLlsKP_gp_absorb_identity : ∀ (T : Type u) [CommRing T] (ℓ : ℕ), ℓ.Prime → ∀ (γ w : T) (H G θ : Polynomial T), ((ℓ : ℕ) : T) = γ ^ (ℓ - 1) * w → (H + Polynomial.C γ * θ) ^ ℓ + Polynomial.C γ ^ ℓ * (G - (∑ k ∈ Finset.Ioo 0 ℓ, Polynomial.C ((((ℓ.choose k / ℓ : ℕ) : T)) * w * γ ^ (k - 1)) * θ ^ k * H ^ (ℓ - k)) - θ ^ ℓ) = H ^ ℓ + Polynomial.C γ ^ ℓ * G :=
by
  intro T _ ℓ hℓ γ w H G θ hpw
  have hℓ1 : 1 ≤ ℓ := hℓ.one_lt.le
  have h5 : (H + Polynomial.C γ * θ) ^ ℓ = H ^ ℓ +
      (∑ k ∈ Finset.Ioo 0 ℓ, (Polynomial.C γ * θ) ^ k * H ^ (ℓ - k) * (ℓ.choose k : Polynomial T)) +
      Polynomial.C γ ^ ℓ * θ ^ ℓ := by
    rw [add_comm H, add_pow, Finset.sum_range_succ, Finset.range_eq_Ico,
      Finset.sum_eq_sum_Ico_succ_bot (by omega : 0 < ℓ)]
    have hI : Finset.Ico (0 + 1) ℓ = Finset.Ioo 0 ℓ := by
      ext x; simp only [Finset.mem_Ico, Finset.mem_Ioo]; omega
    rw [hI]
    simp only [pow_zero, Nat.sub_zero, Nat.sub_self, Nat.choose_zero_right, Nat.choose_self,
      Nat.cast_one, mul_one, one_mul, mul_pow]
  have h6 : Polynomial.C γ ^ ℓ * (∑ k ∈ Finset.Ioo 0 ℓ, Polynomial.C ((((ℓ.choose k / ℓ : ℕ) : T)) * w * γ ^ (k - 1)) * θ ^ k * H ^ (ℓ - k)) =
      ∑ k ∈ Finset.Ioo 0 ℓ, (Polynomial.C γ * θ) ^ k * H ^ (ℓ - k) * (ℓ.choose k : Polynomial T) := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun k hk => ?_)
    obtain ⟨hk0, hkℓ⟩ := Finset.mem_Ioo.mp hk
    have hc : (ℓ.choose k / ℓ) * ℓ = ℓ.choose k :=
      Nat.div_mul_cancel (hℓ.dvd_choose_self (by omega) hkℓ)
