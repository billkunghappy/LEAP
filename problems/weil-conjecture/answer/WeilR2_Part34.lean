  obtain ⟨z, z', μ, ν, hE⟩ := wcLlsKP_bds_node_elements Ω W ℓ hℓ A K L 𝔭 t hPD hdeg c b d w₁
    F₁ m₀ ω ζ α (m₀ * α / ℓ) x hc hb hb0 hB hαβ hx 𝔮 hq

  obtain ⟨T, _, _, j, h, π, hj, hh, hjW, hπC, hπ0, hπ1, hπet, hlift, hden⟩ :=
    wcLlsKP_bds_chart_T Ω W A K 𝔭 t c b d hPD hc hb hb0 hd
  let xT : ℕ → T := fun i =>
    if h : 1 ≤ i ∧ i < ℓ then Classical.choose (hlift (x i) (hx i h.1 h.2).1) else 0
  have hxT : ∀ i, 1 ≤ i → i < ℓ → j (xT i) = x i := by
    intro i h1 h2
    simp only [xT, dite_cond_eq_true (eq_true (And.intro h1 h2))]
    exact Classical.choose_spec (hlift (x i) (hx i h1 h2).1)
  obtain ⟨UT, hUT⟩ := hlift _ hUloc

  obtain ⟨𝔓, hP0, hP1, hPm, ⟨Φ⟩⟩ := wcLlsKP_bds_model_iso Ω W ℓ hℓ A K L 𝔭 t hPD hdeg c b d
    w₁ F₁ m₀ ω ζ α (m₀ * α / ℓ) x hc hb hb0 hB hαβ hζm hζ0 𝔮 hq z z' μ ν hE T j h π hj hh hjW
    hπC hπ0 hπ1 hπet hlift hden xT UT hxT hUT
    (by
      intro 𝔓 _ h0 h1 hm
      exact wcLlsKP_bds_model_etale W T b ζ ℓ α (m₀ * α / ℓ) m₀ hℓ hm₀ hζb π hπC hπet xT UT
        𝔓 h0 h1 hm)

  obtain ⟨e, f, he, hfC, hf0, hf1, hfet, hmap⟩ :=
