by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD c b b' hc hb hb' hb0 hb'0 hdvd hsep
  exact wcpa_dj_llsm_br_radial_mono Ω W hW hWt A K L 𝔭 (.disc t) (t - algebraMap ↥W A c) b' b
    hPD (Or.inl ⟨t, c, rfl, hc, rfl⟩) hb' hb'0 hb hb0 hdvd hsep

theorem wcLlsKP_disc_radial_max : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y →
    Module.finrank K L = ℓ →
    ∀ (θ : L) (f : A), θ ∉ Set.range (algebraMap K L) → θ ^ ℓ = algebraMap A L f →
    (∀ Q : Ideal ↥(integralClosure A L), wcLlsGenPt W A L 𝔭 Q → ¬ wcLlsRam A K L Q) →
    ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W →
    ∃ b : ↥W, b ∈ IsLocalRing.maximalIdeal ↥W ∧ b ≠ 0 ∧ wcLlsDiscSep W A K L t c b ∧
      ∀ b' : ↥W, b' ∈ IsLocalRing.maximalIdeal ↥W → b' ≠ 0 →
        wcLlsDiscSep W A K L t c b' → b' ∣ b :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hSolv hUniq hdeg
    θ f hθ hθf hNB c hc
  obtain ⟨c₀, b₀, hc₀, hb₀, hb₀0, hsep₀, hvert⟩ :=
    wcLlsKP_dcc_vertex_disc Ω W hW hWt ℓ hℓ hΩ hκ A K L 𝔭 t y hPD hSolv hUniq hdeg θ f hθ hθf hNB
  by_cases hb : b₀ ∣ c - c₀
  · obtain ⟨e', he'⟩ := hb
    have hsep : wcLlsDiscSep W A K L t c b₀ :=
      wcLlsAS_disc_recentre Ω W A K L 𝔭 t hPD c₀ c b₀ hc₀ hc hb₀ hb₀0 ⟨e', he'⟩ hsep₀
    refine ⟨b₀, hb₀, hb₀0, hsep, ?_⟩
    intro b' hb' hb'0 hsep'
    by_contra hnd
    have H2 := wcLls_inner_offclass_smooth Ω W hW hWt A K L 𝔭 t y hPD hSolv hUniq
      c₀ b₀ c b' e' hc₀ hb₀ hc hb' hb₀0 hb'0 he' hnd hsep'
    have H3 := wcLls_inner_class_singular Ω W hW hWt A K L 𝔭 t y hPD hSolv hUniq
      c₀ b₀ c b' e' hc₀ hb₀ hc hb' hb₀0 hb'0 he' hnd hsep'
    rcases hvert e' with h | ⟨e, he, hns⟩
    · exact H3 h
    · exact hns (H2 e he)
  · have hb₃m : c - c₀ ∈ IsLocalRing.maximalIdeal ↥W := Ideal.sub_mem _ hc hc₀
    have hb₃0 : c - c₀ ≠ 0 := by
      intro h0
      apply hb
      rw [h0]
      exact dvd_zero _
    have hb₃b₀ : c - c₀ ∣ b₀ := (ValuationRing.dvd_total (c - c₀) b₀).resolve_right hb
    have hsep1 : wcLlsDiscSep W A K L t c₀ (c - c₀) :=
      wcLls_disc_sep_enlarge Ω W hW hWt A K L 𝔭 t hPD c₀ (c - c₀) b₀ hc₀ hb₃m hb₀ hb₃0 hb₀0
        hb₃b₀ hsep₀
    have hsep : wcLlsDiscSep W A K L t c (c - c₀) :=
      wcLlsAS_disc_recentre Ω W A K L 𝔭 t hPD c₀ c (c - c₀) hc₀ hc hb₃m hb₃0 (dvd_refl _) hsep1
    refine ⟨c - c₀, hb₃m, hb₃0, hsep, ?_⟩
    intro b' hb' hb'0 hsep'
    by_contra hnd
    have H2 := wcLls_inner_offclass_smooth Ω W hW hWt A K L 𝔭 t y hPD hSolv hUniq
      c₀ (c - c₀) c b' 1 hc₀ hb₃m hc hb' hb₃0 hb'0 (mul_one _).symm hnd hsep'
    have hunit : (0 : ↥W) - 1 ∉ IsLocalRing.maximalIdeal ↥W := by
      rw [zero_sub, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not]
      exact isUnit_one.neg
    have H2' := H2 0 hunit
    have H3 := wcLls_inner_class_singular Ω W hW hWt A K L 𝔭 t y hPD hSolv hUniq
      c₀ (c - c₀) c₀ b₀ 0 hc₀ hb₃m hc₀ hb₀ hb₃0 hb₀0 (by rw [sub_self, mul_zero]) hb hsep₀
    exact H3 H2'

theorem wcLlsKP_disc_common_centre : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y →
    Module.finrank K L = ℓ →
    ∀ (θ : L) (f : A), θ ∉ Set.range (algebraMap K L) → θ ^ ℓ = algebraMap A L f →
    (∀ Q : Ideal ↥(integralClosure A L), wcLlsGenPt W A L 𝔭 Q → ¬ wcLlsRam A K L Q) →
    ∃ c₀ : ↥W, c₀ ∈ IsLocalRing.maximalIdeal ↥W ∧
      ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
        b' ≠ 0 → wcLlsDiscSep W A K L t c' b' → b' ∣ c' - c₀ :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hSolv hUniq hdeg θ f
    hθ hθf hNB
  obtain ⟨c₀, b₀, hc₀, hb₀, hb₀0, hsep₀, hvert⟩ :=
    wcLlsKP_dcc_vertex_disc Ω W hW hWt ℓ hℓ hΩ hκ A K L 𝔭 t y hPD hSolv hUniq hdeg θ f hθ hθf hNB
  refine ⟨c₀, hc₀, ?_⟩
  intro c' b' hc' hb' hb'0 hsep'
  by_contra hnd
  by_cases hb : b₀ ∣ c' - c₀
  · obtain ⟨e', he'⟩ := hb
    have hnb : ¬ b' ∣ b₀ := fun h => hnd (h.trans ⟨e', he'⟩)
    have H2 := wcLls_inner_offclass_smooth Ω W hW hWt A K L 𝔭 t y hPD hSolv hUniq
      c₀ b₀ c' b' e' hc₀ hb₀ hc' hb' hb₀0 hb'0 he' hnb hsep'
    have H3 := wcLls_inner_class_singular Ω W hW hWt A K L 𝔭 t y hPD hSolv hUniq
      c₀ b₀ c' b' e' hc₀ hb₀ hc' hb' hb₀0 hb'0 he' hnb hsep'
    rcases hvert e' with h | ⟨e, he, hns⟩
    · exact H3 h
    · exact hns (H2 e he)
  · have hb₃m : c' - c₀ ∈ IsLocalRing.maximalIdeal ↥W := Ideal.sub_mem _ hc' hc₀
    have hb₃0 : c' - c₀ ≠ 0 := fun h => hnd (by rw [h]; exact dvd_zero b')
    have H2 := wcLls_inner_offclass_smooth Ω W hW hWt A K L 𝔭 t y hPD hSolv hUniq
      c₀ (c' - c₀) c' b' 1 hc₀ hb₃m hc' hb' hb₃0 hb'0 (mul_one _).symm hnd hsep'
    have hunit : (0 : ↥W) - 1 ∉ IsLocalRing.maximalIdeal ↥W := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not, zero_sub]
      exact isUnit_one.neg
    have H3 := wcLls_inner_class_singular Ω W hW hWt A K L 𝔭 t y hPD hSolv hUniq
      c₀ (c' - c₀) c₀ b₀ 0 hc₀ hb₃m hc₀ hb₀ hb₃0 hb₀0 (by rw [sub_self, mul_zero]) hb hsep₀
    exact H3 (H2 0 hunit)

theorem wcpa_dj_llsm_kp_wild_disc : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
      [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
      (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y →
    wcLlsBR W A K L 𝔭 (.disc t) → Nat.card ↥(wcLlsDec A K L y) = ℓ →
    wcLlsLocMax W A K L (.disc t) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hSolv hUniq hBR hcard

  obtain ⟨hdeg, θ, f, hθ, hθf⟩ :=
    wcLlsKP_wild_generator Ω W ℓ hℓ hΩ A K L 𝔭 t y hPD hSolv.1 hSolv.2.1 hUniq hcard

  have hNB := wcLlsKP_wild_no_branch Ω W hW hWt ℓ hℓ hΩ A K L 𝔭 t y hPD hSolv hUniq hBR hdeg
    θ f hθ hθf

  obtain ⟨c₀, hc₀, hcom⟩ := wcLlsKP_disc_common_centre Ω W hW hWt ℓ hℓ hΩ hκ A K L 𝔭 t y
    hPD hSolv hUniq hdeg θ f hθ hθf hNB

  obtain ⟨b, hb, hb0, hsep, hmax⟩ := wcLlsKP_disc_radial_max Ω W hW hWt ℓ hℓ hΩ hκ A K L 𝔭 t y
    hPD hSolv hUniq hdeg θ f hθ hθf hNB c₀ hc₀
  refine ⟨c₀, b, hc₀, hb, hb0, hsep, ?_⟩
  intro c' b' hc' hb' hb'0 hsep' _ _
  have hd : b' ∣ c' - c₀ := hcom c' b' hc' hb' hb'0 hsep'
  have hd' : b' ∣ c₀ - c' := by rw [← dvd_neg, neg_sub]; exact hd

  exact hmax b' hb' hb'0
    (wcLlsAS_disc_recentre Ω W A K L 𝔭 t hPD c' c₀ b' hc' hc₀ hb' hb'0 hd' hsep')

theorem wcpa_dj_llsm_kpwb_kummer_ram : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
      [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (k : wcLlsKind W A),
    wcLlsPD W A 𝔭 k → Module.finrank K L = ℓ →
    ∀ (θ : L) (f : A), f ≠ 0 → θ ∉ Set.range (algebraMap K L) → θ ^ ℓ = algebraMap A L f →
    ∀ P : Ideal A, P.IsPrime → P ≠ ⊥ → P ≤ 𝔭 → (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) →
    (¬ ∃ (F : K) (a s : A), a ∉ P ∧ s ∉ P ∧
        algebraMap A K f * algebraMap A K s = F ^ ℓ * algebraMap A K a) →
    ∃ Q : Ideal ↥(integralClosure A L), wcLlsGenPt W A L 𝔭 Q ∧ wcLlsRam A K L Q :=
by
  intro Ω _ _ W _hW _hWt ℓ hℓ hΩ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 k hPD hfr θ f hf0 hθ hθf P hP
    _hP0 hP𝔭 hPW hnot
  obtain ⟨-, hNZ, hIC, -⟩ := hPD
  haveI := hIC
  haveI := hNZ
  haveI := hP
  have hsc : ∀ x : A, algebraMap A L x = algebraMap K L (algebraMap A K x) :=
    fun x => IsScalarTower.algebraMap_apply A K L x
  have hinjK := IsFractionRing.injective A K
  have hinjL : Function.Injective (algebraMap A L) := by
    intro x y hxy
    rw [hsc, hsc] at hxy
    exact hinjK ((algebraMap K L).injective hxy)
  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    by_contra h
    rw [Algebra.algebraMap_eq_smul_one] at hw
    rcases smul_eq_zero.mp hw with h' | h'
    · exact h h'
    · exact one_ne_zero h'

  have hℓΩ : ((ℓ : ℕ) : Ω) ≠ 0 := by
    intro h
    have hd := ringChar.dvd h
    rcases (Nat.dvd_prime hℓ).mp hd with h1 | h1
    · exact CharP.ringChar_ne_one h1
    · exact hΩ h1
  have hℓW : ((ℓ : ℕ) : ↥W) ≠ 0 := by
    intro h
    apply hℓΩ
    have h2 := congrArg W.subtype h
    rwa [map_natCast, map_zero] at h2
  obtain ⟨ζW, hζW⟩ : ∃ ζ : ↥W, IsPrimitiveRoot ζ ℓ := by
    haveI : NeZero ((ℓ:ℕ) : Ω) := ⟨hℓΩ⟩
    obtain ⟨z, hz⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot Ω ℓ
    have hzW : z ∈ W := by
      rcases W.mem_or_inv_mem z with h | h
      · exact h
      · have : z = (z⁻¹) ^ (ℓ - 1) := by
          rw [inv_pow]
          refine eq_inv_of_mul_eq_one_left ?_
          rw [← pow_succ', Nat.sub_add_cancel hℓ.one_lt.le]
          exact hz.pow_eq_one
        rw [this]; exact W.pow_mem h _
    exact ⟨⟨z, hzW⟩, IsPrimitiveRoot.of_map_of_injective (f := W.subtype) hz Subtype.val_injective⟩
  have hζK : IsPrimitiveRoot (algebraMap A K (algebraMap ↥W A ζW)) ℓ :=
    (hζW.map_of_injective hWA).map_of_injective hinjK

  obtain ⟨σ, hσ1, hσℓ, hgen, η, hη, hσθ⟩ : ∃ σ : L ≃ₐ[K] L, σ ≠ 1 ∧ σ ^ ℓ = 1 ∧
      (∀ τ : L ≃ₐ[K] L, ∃ n : ℕ, σ ^ n = τ) ∧
      ∃ η : K, IsPrimitiveRoot η ℓ ∧ σ θ = algebraMap K L η * θ := by
    have hθc : θ ^ ℓ = algebraMap K L (algebraMap A K f) := by rw [hθf, hsc]
    have hcard : Nat.card (L ≃ₐ[K] L) = ℓ := by
      rw [← hfr]; exact IsGalois.card_aut_eq_finrank K L
    obtain ⟨σ, hσθ⟩ : ∃ σ : L ≃ₐ[K] L, σ θ ≠ θ := by
      by_contra h
      push_neg at h
      exact hθ ((IsGalois.mem_range_algebraMap_iff_fixed θ).mpr h)
    have hσ1 : σ ≠ 1 := by rintro rfl; exact hσθ rfl
    have hσℓ : σ ^ ℓ = 1 := by rw [← hcard]; exact pow_card_eq_one'
    have hgen : ∀ τ : L ≃ₐ[K] L, ∃ n : ℕ, σ ^ n = τ := by
      haveI : Fact ℓ.Prime := ⟨hℓ⟩
      have htop := powers_eq_top_of_prime_card hcard hσ1
      intro τ
      have hτ : τ ∈ Submonoid.powers σ := by rw [htop]; trivial
      exact (Submonoid.mem_powers_iff τ σ).mp hτ
    have hθ0 : θ ≠ 0 := by rintro rfl; exact hθ ⟨0, map_zero _⟩
    have hc0 : algebraMap K L (algebraMap A K f) ≠ 0 := by rw [← hθc]; exact pow_ne_zero _ hθ0
    obtain ⟨ξ, hξ⟩ : ∃ ξ, ξ = σ θ / θ := ⟨_, rfl⟩
    have hξℓ : ξ ^ ℓ = 1 := by
      rw [hξ, div_pow, ← map_pow, hθc, AlgEquiv.commutes, div_self hc0]
    have hζL : IsPrimitiveRoot (algebraMap K L (algebraMap A K (algebraMap ↥W A ζW))) ℓ :=
      hζK.map_of_injective (algebraMap K L).injective
    haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
    obtain ⟨i, hi, hiξ⟩ := hζL.eq_pow_of_pow_eq_one hξℓ
    have hi0 : i ≠ 0 := by
      rintro rfl
      rw [pow_zero, hξ, eq_comm, div_eq_one_iff_eq hθ0] at hiξ
      exact hσθ hiξ
    have hcop : i.Coprime ℓ := (Nat.coprime_of_lt_prime hi0 hi hℓ).symm
    refine ⟨σ, hσ1, hσℓ, hgen, (algebraMap A K (algebraMap ↥W A ζW)) ^ i,
      hζK.pow_of_coprime i hcop, ?_⟩
    rw [map_pow, hiξ, hξ, div_mul_cancel₀ _ hθ0]
  obtain ⟨ηL, hηLdef⟩ : ∃ z : L, z = algebraMap K L η := ⟨_, rfl⟩
  have hη0 : η ≠ 0 := hη.ne_zero hℓ.ne_zero
  have hηL0 : ηL ≠ 0 := by
    rw [hηLdef]; exact (map_ne_zero_iff _ (algebraMap K L).injective).mpr hη0
  have hηLprim : IsPrimitiveRoot ηL ℓ := by
    rw [hηLdef]; exact hη.map_of_injective (algebraMap K L).injective
  have hσηL : σ ηL = ηL := by rw [hηLdef]; exact σ.commutes η
  rw [← hηLdef] at hσθ

  have hweight : ∀ j : ℕ, 0 < j → j < ℓ → ∀ y : L, IsIntegral A y → σ y = ηL ^ j * y →
      ∃ a ∈ P, algebraMap A L a = y ^ ℓ := by
    intro j hj0 hjℓ y hy hσy
    have hfK : algebraMap A K f ≠ 0 := (map_ne_zero_iff _ hinjK).mpr hf0
    have hθ0 : θ ≠ 0 := by
      rintro rfl
      rw [zero_pow hℓ.ne_zero, hsc, eq_comm] at hθf
      exact hfK ((map_eq_zero_iff _ (algebraMap K L).injective).mp hθf)
    obtain ⟨d, hd⟩ : ∃ d, d = y / θ ^ j := ⟨_, rfl⟩
    have hσd : σ d = d := by
      rw [hd, map_div₀, map_pow, hσθ, hσy, mul_pow]
      field_simp
    have hfix : ∀ τ : L ≃ₐ[K] L, τ d = d := by
      intro τ
      obtain ⟨n, rfl⟩ := hgen τ
      induction n with
      | zero => simp
      | succ n ih => rw [pow_succ, AlgEquiv.mul_apply, hσd, ih]
    obtain ⟨d₀, hd₀⟩ := (IsGalois.mem_range_algebraMap_iff_fixed d).mpr hfix
    have hy_eq : y = algebraMap K L d₀ * θ ^ j := by
      rw [hd₀, hd, div_mul_cancel₀ _ (pow_ne_zero _ hθ0)]
    obtain ⟨c, hc⟩ : ∃ c : K, c = d₀ ^ ℓ * algebraMap A K f ^ j := ⟨_, rfl⟩
    have hcy : algebraMap K L c = y ^ ℓ := by
      rw [hc, map_mul, map_pow, map_pow, ← hsc, ← hθf, hy_eq]; ring
    have hcint : IsIntegral A c := by
      have h1 : IsIntegral A (algebraMap K L c) := by rw [hcy]; exact hy.pow ℓ
      exact (isIntegral_algHom_iff (IsScalarTower.toAlgHom A K L)
        (algebraMap K L).injective).mp h1
    obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp hcint
    refine ⟨a, ?_, by rw [hsc, ha, hcy]⟩
    by_contra haP
    have hd00 : d₀ ≠ 0 := by
      rintro rfl
      apply haP
      have : algebraMap A K a = 0 := by rw [ha, hc, zero_pow hℓ.ne_zero, zero_mul]
      rw [(map_eq_zero_iff _ hinjK).mp this]; exact P.zero_mem
    have hcop : j.Coprime ℓ := (Nat.coprime_of_lt_prime hj0.ne' hjℓ hℓ).symm
    obtain ⟨α, -, hα⟩ := Nat.exists_mul_mod_eq_one_of_coprime hcop hℓ.one_lt
    obtain ⟨β, hβ⟩ : ∃ β, β = j * α / ℓ := ⟨_, rfl⟩
    have hjα : j * α = ℓ * β + 1 := by
      have := Nat.div_add_mod (j * α) ℓ; rw [hα, ← hβ] at this; omega
    have hY : (d₀ ^ ℓ * algebraMap A K f ^ j) ^ α =
        (d₀ ^ α * algebraMap A K f ^ β) ^ ℓ * algebraMap A K f := by
      rw [mul_pow, mul_pow, ← pow_mul, ← pow_mul, ← pow_mul, ← pow_mul, hjα, mul_comm ℓ α,
        mul_comm β ℓ, pow_succ]
      ring
    have hX : d₀ ^ α * algebraMap A K f ^ β ≠ 0 :=
      mul_ne_zero (pow_ne_zero _ hd00) (pow_ne_zero _ hfK)
    apply hnot
    refine ⟨(d₀ ^ α * algebraMap A K f ^ β)⁻¹, a ^ α, 1, fun h => haP (hP.mem_of_pow_mem _ h),
      fun h => hP.ne_top ((Ideal.eq_top_iff_one P).mpr h), ?_⟩
    rw [map_one, mul_one, map_pow, ha, hc, hY, inv_pow, ← mul_assoc,
      inv_mul_cancel₀ (pow_ne_zero _ hX), one_mul]

  have heigen : ∀ x : L,
      (∀ j : ℕ, σ (∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x) =
        ηL ^ j * ∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x) ∧
      ∑ j ∈ Finset.range ℓ, (ηL ^ j - 1) * ∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x =
        (ℓ : L) * (σ x - x) := by
    intro x
    have hσw : σ ηL⁻¹ = ηL⁻¹ := by rw [map_inv₀, hσηL]
    have hσwp : ∀ n : ℕ, σ (ηL⁻¹ ^ n) = ηL⁻¹ ^ n := fun n => by rw [map_pow, hσw]
    have hwℓ : ηL⁻¹ ^ ℓ = 1 := by rw [inv_pow, hηLprim.pow_eq_one, inv_one]
    have hpowσ : ∀ m : ℕ, σ ((σ ^ m) x) = (σ ^ (m + 1)) x := fun m => by
      rw [pow_succ', AlgEquiv.mul_apply]
    have heig : ∀ j : ℕ, σ (∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x) =
        ηL ^ j * ∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x := by
      intro j
      have hηj : ηL ^ j * ηL⁻¹ ^ j = 1 := by rw [← mul_pow, mul_inv_cancel₀ hηL0, one_pow]
      let h : ℕ → L := fun m => ηL ^ j * (ηL⁻¹ ^ (j * m) * (σ ^ m) x)
      have hL : σ (∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x) =
          ∑ m ∈ Finset.range ℓ, h (m + 1) := by
        rw [map_sum]
        refine Finset.sum_congr rfl (fun m _ => ?_)
        rw [map_mul, hσwp, hpowσ]
        show ηL⁻¹ ^ (j * m) * (σ ^ (m + 1)) x =
          ηL ^ j * (ηL⁻¹ ^ (j * (m + 1)) * (σ ^ (m + 1)) x)
        generalize (σ ^ (m + 1)) x = z
        have e : ηL⁻¹ ^ (j * (m + 1)) = ηL⁻¹ ^ (j * m) * ηL⁻¹ ^ j := by
          rw [mul_add, mul_one, pow_add]
        rw [e]
        linear_combination (-(ηL⁻¹ ^ (j * m) * z)) * hηj
      have hR : ηL ^ j * ∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x =
          ∑ m ∈ Finset.range ℓ, h m := by
        rw [Finset.mul_sum]
      have hℓ0 : h ℓ = h 0 := by
        show ηL ^ j * (ηL⁻¹ ^ (j * ℓ) * (σ ^ ℓ) x) = ηL ^ j * (ηL⁻¹ ^ (j * 0) * (σ ^ 0) x)
        rw [hσℓ, mul_comm j ℓ, pow_mul, hwℓ, one_pow, mul_zero, pow_zero, pow_zero]
      have e1 := Finset.sum_range_succ' h ℓ
      have e2 := Finset.sum_range_succ h ℓ
      rw [hL, hR]
      have e3 := e1.symm.trans e2
      rw [hℓ0] at e3
      exact add_right_cancel e3
    have hsumY : ∑ j ∈ Finset.range ℓ, ∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x =
        (ℓ : L) * x := by
      rw [Finset.sum_comm, Finset.sum_eq_single 0]
      · simp
      · intro m hm hm0
        rw [← Finset.sum_mul]
        have hwm : ηL⁻¹ ^ m ≠ 1 := by
          intro h
          have hdvd := (hηLprim.inv.pow_eq_one_iff_dvd m).mp h
          exact hm0 (Nat.eq_zero_of_dvd_of_lt hdvd (Finset.mem_range.mp hm))
        have hgeom : ∑ j ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) = 0 := by
          have e : ∀ j, ηL⁻¹ ^ (j * m) = (ηL⁻¹ ^ m) ^ j := fun j => by rw [← pow_mul, mul_comm]
          simp_rw [e]
          have hg := geom_sum_mul (ηL⁻¹ ^ m) ℓ
          have hpm : (ηL⁻¹ ^ m) ^ ℓ = 1 := by rw [← pow_mul, mul_comm, pow_mul, hwℓ, one_pow]
          rw [hpm, sub_self] at hg
          exact (mul_eq_zero.mp hg).resolve_right (sub_ne_zero.mpr hwm)
        rw [hgeom, zero_mul]
      · intro h; exact absurd (Finset.mem_range.mpr hℓ.pos) h
    refine ⟨heig, ?_⟩
    have hdiff : ∑ j ∈ Finset.range ℓ, (ηL ^ j - 1) *
        ∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x =
        σ (∑ j ∈ Finset.range ℓ, ∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x) -
        ∑ j ∈ Finset.range ℓ, ∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x := by
      rw [map_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [heig j]; ring
    rw [hdiff, hsumY, map_mul, map_natCast]; ring

  have hker : RingHom.ker (algebraMap A ↥(integralClosure A L)) ≤ P := by
    intro a ha
    rw [RingHom.mem_ker] at ha
    have h2 : algebraMap A L a = 0 := congrArg Subtype.val ha
    rw [hinjL (h2.trans (map_zero _).symm)]
    exact P.zero_mem
  obtain ⟨Q, hQ, hQP⟩ := Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain P hker
  replace hQP : Ideal.comap (algebraMap A ↥(integralClosure A L)) Q = P := by
    rw [← Ideal.under_def]; exact hQP
  refine ⟨Q, ⟨hQ, by rw [hQP]; exact hP𝔭, fun w hw => by rw [hQP]; exact hPW w hw⟩,
    σ, hσ1, fun x => ?_⟩

  have hrootint : ∀ z : L, z ^ ℓ = 1 → IsIntegral A z := by
    intro z hz
    refine ⟨Polynomial.X ^ ℓ - Polynomial.C 1, Polynomial.monic_X_pow_sub_C 1 hℓ.ne_zero, ?_⟩
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, map_one, hz, sub_self]
  have hwint : IsIntegral A ηL⁻¹ :=
    hrootint _ (by rw [inv_pow, hηLprim.pow_eq_one, inv_one])
  have hηint : IsIntegral A ηL := hrootint _ hηLprim.pow_eq_one
  have hxint : IsIntegral A (x : L) := x.2
  have hYint : ∀ j : ℕ,
      IsIntegral A (∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) (x : L)) := fun j =>
    IsIntegral.sum _ (fun m _ => (hwint.pow _).mul (hxint.map (σ ^ m)))
  obtain ⟨heig, hid⟩ := heigen (x : L)
  obtain ⟨yh, hyh⟩ : ∃ yh : ℕ → ↥(integralClosure A L), ∀ j, (yh j : L) =
      ∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) (x : L) :=
    ⟨fun j => ⟨_, hYint j⟩, fun j => rfl⟩
  obtain ⟨eh, heh⟩ : ∃ eh : ℕ → ↥(integralClosure A L), ∀ j, (eh j : L) = ηL ^ j - 1 :=
    ⟨fun j => ⟨_, (hηint.pow j).sub isIntegral_one⟩, fun j => rfl⟩
  have hYQ : ∀ j, 0 < j → j < ℓ → yh j ∈ Q := by
    intro j hj0 hjℓ
    obtain ⟨a, haP, ha⟩ := hweight j hj0 hjℓ _ (hYint j) (heig j)
    apply hQ.mem_of_pow_mem ℓ
    have hpow : yh j ^ ℓ = algebraMap A ↥(integralClosure A L) a := by
      apply Subtype.ext
      rw [SubmonoidClass.coe_pow, hyh j]
      exact ha.symm
    rw [hpow]
    have hmem : a ∈ Q.comap (algebraMap A ↥(integralClosure A L)) := by rw [hQP]; exact haP
    exact hmem
  have hSQ : ∑ j ∈ Finset.range ℓ, eh j * yh j ∈ Q := by
    apply Ideal.sum_mem
    intro j hj
    by_cases hj0 : j = 0
    · have he0 : eh j = 0 := by
        apply Subtype.ext
        rw [heh j, hj0, pow_zero, sub_self]
        rfl
      rw [he0, zero_mul]
      exact Q.zero_mem
    · exact Ideal.mul_mem_left Q _ (hYQ j (Nat.pos_of_ne_zero hj0) (Finset.mem_range.mp hj))

  obtain ⟨q', hq'⟩ : ∃ q' : ↥(integralClosure A L), (q' : L) = σ (x : L) - (x : L) :=
    ⟨⟨_, (hxint.map σ).sub hxint⟩, rfl⟩
  have hℓA : ((ℓ : ℕ) : ↥(integralClosure A L)) =
      algebraMap A ↥(integralClosure A L) (algebraMap ↥W A ((ℓ : ℕ) : ↥W)) := by
    rw [map_natCast, map_natCast]
  have hℓL : (((ℓ : ℕ) : ↥(integralClosure A L)) : L) = (ℓ : L) := by
    rw [hℓA]
    change algebraMap A L (algebraMap ↥W A ((ℓ : ℕ) : ↥W)) = _
    rw [map_natCast, map_natCast]
  have hprod : ((ℓ : ℕ) : ↥(integralClosure A L)) * q' = ∑ j ∈ Finset.range ℓ, eh j * yh j := by
    apply Subtype.ext
    rw [MulMemClass.coe_mul, AddSubmonoidClass.coe_finsetSum]
    simp only [MulMemClass.coe_mul, heh, hyh]
    rw [hid, hq', hℓL]
  have hℓQ : ((ℓ : ℕ) : ↥(integralClosure A L)) ∉ Q := by
    intro h
    rw [hℓA] at h
    have hmem : algebraMap ↥W A ((ℓ : ℕ) : ↥W) ∈ Q.comap (algebraMap A ↥(integralClosure A L)) :=
      h
    rw [hQP] at hmem
    exact hPW _ hℓW hmem
  have hpq : ((ℓ : ℕ) : ↥(integralClosure A L)) * q' ∈ Q := by rw [hprod]; exact hSQ
  rcases hQ.mem_or_mem hpq with h | h
  · exact absurd h hℓQ
  · exact ⟨q', h, hq'⟩

theorem wcpa_dj_llsm_kpwm_tc_node_basics : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (g : ↥W), (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W)) * (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W)) = ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})).comp (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 2) ↥W)) g ∧ Function.Surjective (MvPolynomial.eval₂Hom ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})).comp (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 2) ↥W)) ![Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W)]) ∧ ∀ (T : Type u) [CommRing T] (α : ↥W →+* T) (t₀ t₁ : T), t₀ * t₁ = α g → ∃ μ : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+* T, μ.comp ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})).comp MvPolynomial.C) = α ∧ μ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = t₀ ∧ μ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = t₁ :=
by
  intro Ω _ W g
  refine ⟨?_, ?_, ?_⟩
  · rw [RingHom.comp_apply, ← map_mul, Ideal.Quotient.eq]
    exact Ideal.mem_span_singleton_self _
  · have h : MvPolynomial.eval₂Hom ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})).comp (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 2) ↥W)) ![Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W)] = Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      · intro i
        rw [MvPolynomial.eval₂Hom_X']
        fin_cases i <;> rfl
    rw [h]
    exact Ideal.Quotient.mk_surjective
  · intro T _ α t₀ t₁ hT
    have H : ∀ a ∈ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g},
        MvPolynomial.eval₂Hom α ![t₀, t₁] a = 0 := by
      intro a ha
      obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
        MvPolynomial.eval₂Hom_C]
      simp [hT]
    refine ⟨Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom α ![t₀, t₁]) H, ?_, ?_, ?_⟩
    · refine RingHom.ext fun w => ?_
      rw [RingHom.comp_apply, RingHom.comp_apply, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
    · rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
      rfl
    · rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
      rfl

theorem wcpa_dj_llsm_kpwm_tc_flatten : ∀ (S N : Type u) [CommRing S] [CommRing N] (ι : S →+* N) (c₀ c₁ : N) (n : ℕ), Function.Surjective (MvPolynomial.eval₂Hom ι ![c₀, c₁]) → Function.Surjective (MvPolynomial.eval₂Hom (MvPolynomial.C.comp ι) (Sum.elim ![MvPolynomial.C c₀, MvPolynomial.C c₁] MvPolynomial.X) : MvPolynomial (Fin 2 ⊕ Fin n) S →+* MvPolynomial (Fin n) N) ∧ (∀ (p : MvPolynomial (Fin 2 ⊕ Fin n) S) (j : Fin n), MvPolynomial.pderiv j (MvPolynomial.eval₂Hom (MvPolynomial.C.comp ι) (Sum.elim ![MvPolynomial.C c₀, MvPolynomial.C c₁] MvPolynomial.X) p) = MvPolynomial.eval₂Hom (MvPolynomial.C.comp ι) (Sum.elim ![MvPolynomial.C c₀, MvPolynomial.C c₁] MvPolynomial.X) (MvPolynomial.pderiv (Sum.inr j) p)) ∧ (∀ (T : Type u) [CommRing T] (μ : N →+* T) (w : Fin n → T) (p : MvPolynomial (Fin 2 ⊕ Fin n) S), MvPolynomial.eval₂ μ w (MvPolynomial.eval₂Hom (MvPolynomial.C.comp ι) (Sum.elim ![MvPolynomial.C c₀, MvPolynomial.C c₁] MvPolynomial.X) p) = MvPolynomial.eval₂ (μ.comp ι) (Sum.elim ![μ c₀, μ c₁] w) p) :=
by
  intro S N _ _ ι c₀ c₁ n hsurj
  set π : MvPolynomial (Fin 2 ⊕ Fin n) S →+* MvPolynomial (Fin n) N :=
    MvPolynomial.eval₂Hom (MvPolynomial.C.comp ι)
      (Sum.elim ![MvPolynomial.C c₀, MvPolynomial.C c₁] MvPolynomial.X) with hπ
  have hC : ∀ s, π (MvPolynomial.C s) = MvPolynomial.C (ι s) := fun s => by
    rw [hπ, MvPolynomial.eval₂Hom_C]; rfl
  have hX0 : π (MvPolynomial.X (Sum.inl 0)) = MvPolynomial.C c₀ := by
    rw [hπ, MvPolynomial.eval₂Hom_X']; rfl
  have hX1 : π (MvPolynomial.X (Sum.inl 1)) = MvPolynomial.C c₁ := by
    rw [hπ, MvPolynomial.eval₂Hom_X']; rfl
  have hXr : ∀ j, π (MvPolynomial.X (Sum.inr j)) = MvPolynomial.X j := fun j => by
    rw [hπ, MvPolynomial.eval₂Hom_X']; rfl
  have hXl : ∀ i : Fin 2, ∃ c, π (MvPolynomial.X (Sum.inl i)) = MvPolynomial.C c := by
    intro i
    fin_cases i
    · exact ⟨c₀, hX0⟩
    · exact ⟨c₁, hX1⟩
  refine ⟨?_, ?_, ?_⟩
  ·
    have key : π.comp (MvPolynomial.rename (R := S) (Sum.inl : Fin 2 → Fin 2 ⊕ Fin n)).toRingHom =
        MvPolynomial.C.comp (MvPolynomial.eval₂Hom ι ![c₀, c₁]) := by
      apply MvPolynomial.ringHom_ext
      · intro s
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPolynomial.rename_C, hC, MvPolynomial.eval₂Hom_C]
      · intro i
        match i with
        | 0 =>
          simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            MvPolynomial.rename_X, MvPolynomial.eval₂Hom_X']
          rw [hX0]; rfl
        | 1 =>
          simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            MvPolynomial.rename_X, MvPolynomial.eval₂Hom_X']
          rw [hX1]; rfl
    have hconst : ∀ c : N, ∃ r, π r = MvPolynomial.C c := by
      intro c
      obtain ⟨q, hq⟩ := hsurj c
      refine ⟨MvPolynomial.rename Sum.inl q, ?_⟩
      have h := RingHom.congr_fun key q
      rw [RingHom.comp_apply, RingHom.comp_apply, hq] at h
      exact h
    intro P
    induction P using MvPolynomial.induction_on with
    | C c => exact hconst c
    | add p q hp hq =>
      obtain ⟨a, ha⟩ := hp
      obtain ⟨b, hb⟩ := hq
      exact ⟨a + b, by rw [map_add, ha, hb]⟩
    | mul_X p j hp =>
      obtain ⟨a, ha⟩ := hp
      exact ⟨a * MvPolynomial.X (Sum.inr j), by rw [map_mul, ha, hXr]⟩
  ·
    intro p j
    have hstar : ∀ k : Fin 2 ⊕ Fin n, MvPolynomial.pderiv j (π (MvPolynomial.X k)) =
        π (MvPolynomial.pderiv (Sum.inr j) (MvPolynomial.X k)) := by
      intro k
      rcases k with i | i
      · obtain ⟨c, hc⟩ := hXl i
        rw [hc, MvPolynomial.pderiv_C, MvPolynomial.pderiv_X_of_ne Sum.inl_ne_inr, map_zero]
      · by_cases h : i = j
        · subst h
          rw [hXr, MvPolynomial.pderiv_X_self, MvPolynomial.pderiv_X_self, map_one]
        · rw [hXr, MvPolynomial.pderiv_X_of_ne h,
            MvPolynomial.pderiv_X_of_ne (fun e => h (Sum.inr_injective e)), map_zero]
    induction p using MvPolynomial.induction_on with
    | C a => rw [hC, MvPolynomial.pderiv_C, MvPolynomial.pderiv_C, map_zero]
    | add p q hp hq => simp only [map_add, hp, hq]
    | mul_X p k hp =>
      rw [map_mul, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_mul, map_add, map_mul, map_mul,
        hp, hstar k]
  ·
    intro T _ μ w p
    have key : (MvPolynomial.eval₂Hom μ w).comp π =
        MvPolynomial.eval₂Hom (μ.comp ι) (Sum.elim ![μ c₀, μ c₁] w) := by
      apply MvPolynomial.ringHom_ext
      · intro s
        rw [RingHom.comp_apply, hC, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
        rfl
      · intro k
        rcases k with i | i
        · match i with
          | 0 =>
            rw [RingHom.comp_apply, hX0, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
            rfl
          | 1 =>
            rw [RingHom.comp_apply, hX1, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
            rfl
        · rw [RingHom.comp_apply, hXr, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
          rfl
    exact RingHom.congr_fun key p

theorem wcpa_dj_llsm_kpwm_tc_twist_present : ∀ (S N B : Type u) [CommRing S] [CommRing N] [CommRing B] (σ : S →+* N) (g : S) (x₀ x₁ : N) (κ ψ : N →+* B) (ε : B) (n : ℕ) (F : Fin n → MvPolynomial (Fin n) N) (val : Fin n → B) (π : MvPolynomial (Fin 2 ⊕ Fin n) S →+* MvPolynomial (Fin n) N) (Fh : Fin n → MvPolynomial (Fin 2 ⊕ Fin n) S) (eh : MvPolynomial (Fin 2 ⊕ Fin n) S), x₀ * x₁ = σ g → Function.Surjective (MvPolynomial.eval₂Hom σ ![x₀, x₁]) → (∀ (T : Type u) [CommRing T] (α : S →+* T) (t₀ t₁ : T), t₀ * t₁ = α g → ∃ μ : N →+* T, μ.comp σ = α ∧ μ x₀ = t₀ ∧ μ x₁ = t₁) → Function.Surjective π → (∀ (T : Type u) [CommRing T] (μ : N →+* T) (w : Fin n → T) (p : MvPolynomial (Fin 2 ⊕ Fin n) S), MvPolynomial.eval₂ μ w (π p) = MvPolynomial.eval₂ (μ.comp σ) (Sum.elim ![μ x₀, μ x₁] w) p) → IsUnit ε → Function.Surjective (MvPolynomial.eval₂Hom κ val) → RingHom.ker (MvPolynomial.eval₂Hom κ val) = Ideal.span (Set.range F) → (∀ i, π (Fh i) = F i) → MvPolynomial.eval₂ κ val (π eh) = ε → ψ.comp σ = κ.comp σ → ψ x₀ = κ x₀ * ε → ψ x₁ * ε = κ x₁ → Function.Surjective (MvPolynomial.eval₂Hom ψ (Sum.elim ![κ x₀, κ x₁] val)) ∧ RingHom.ker (MvPolynomial.eval₂Hom ψ (Sum.elim ![κ x₀, κ x₁] val)) = Ideal.span (Set.range (Sum.elim ![MvPolynomial.X (Sum.inl 0) * MvPolynomial.map σ eh - MvPolynomial.C x₀, MvPolynomial.X (Sum.inl 1) - MvPolynomial.C x₁ * MvPolynomial.map σ eh] (fun i => MvPolynomial.map σ (Fh i)))) :=
by
  intro S N B _ _ _ σ g x₀ x₁ κ ψ ε n F val π Fh eh hx hsurjN hUP hπsurj hπev hε hsurj hker hFh
    heh hψσ hψ0 hψ1
  classical

  have key : ∀ p : MvPolynomial (Fin 2 ⊕ Fin n) S,
      MvPolynomial.eval₂Hom ψ (Sum.elim ![κ x₀, κ x₁] val) (MvPolynomial.map σ p) =
        MvPolynomial.eval₂ κ val (π p) := by
    intro p
    rw [hπev B κ val p, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_map, hψσ]

  have hsurjΦ : Function.Surjective (MvPolynomial.eval₂Hom ψ (Sum.elim ![κ x₀, κ x₁] val)) := by
    intro b
    obtain ⟨r, hr⟩ := hsurj b
    obtain ⟨p, hp⟩ := hπsurj r
    refine ⟨MvPolynomial.map σ p, ?_⟩
    rw [key, hp]
    exact hr
  have hΦe : MvPolynomial.eval₂Hom ψ (Sum.elim ![κ x₀, κ x₁] val) (MvPolynomial.map σ eh) = ε := by
    rw [key, heh]
  have hΦF : ∀ i, MvPolynomial.eval₂Hom ψ (Sum.elim ![κ x₀, κ x₁] val)
      (MvPolynomial.map σ (Fh i)) = 0 := by
    intro i
    rw [key, hFh]
    have hmem : F i ∈ RingHom.ker (MvPolynomial.eval₂Hom κ val) := by
      rw [hker]; exact Ideal.subset_span ⟨i, rfl⟩
    exact RingHom.mem_ker.mp hmem

  have hle : Ideal.span (Set.range (Sum.elim ![MvPolynomial.X (Sum.inl 0) * MvPolynomial.map σ eh -
      MvPolynomial.C x₀, MvPolynomial.X (Sum.inl 1) - MvPolynomial.C x₁ * MvPolynomial.map σ eh]
      (fun i => MvPolynomial.map σ (Fh i)))) ≤
      RingHom.ker (MvPolynomial.eval₂Hom ψ (Sum.elim ![κ x₀, κ x₁] val)) := by
    rw [Ideal.span_le]
    rintro _ ⟨a, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    revert a
    rw [Sum.forall, Fin.forall_fin_two]
    refine ⟨⟨?_, ?_⟩, fun i => ?_⟩
    · show MvPolynomial.eval₂Hom ψ (Sum.elim ![κ x₀, κ x₁] val)
        (MvPolynomial.X (Sum.inl 0) * MvPolynomial.map σ eh - MvPolynomial.C x₀) = 0
      rw [map_sub, map_mul, hΦe, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C, hψ0]
      simp
    · show MvPolynomial.eval₂Hom ψ (Sum.elim ![κ x₀, κ x₁] val)
        (MvPolynomial.X (Sum.inl 1) - MvPolynomial.C x₁ * MvPolynomial.map σ eh) = 0
      rw [map_sub, map_mul, hΦe, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C, hψ1]
      simp
    · exact hΦF i

  set e : MvPolynomial (Fin 2 ⊕ Fin n) N := MvPolynomial.map σ eh with he
  set J := Ideal.span (Set.range (Sum.elim ![MvPolynomial.X (Sum.inl 0) * e -
      MvPolynomial.C x₀, MvPolynomial.X (Sum.inl 1) - MvPolynomial.C x₁ * e]
      (fun i => MvPolynomial.map σ (Fh i)))) with hJ
  set q : MvPolynomial (Fin 2 ⊕ Fin n) N →+* (MvPolynomial (Fin 2 ⊕ Fin n) N ⧸ J) :=
    Ideal.Quotient.mk J with hq
  have hqrel : ∀ a, q (Sum.elim ![MvPolynomial.X (Sum.inl 0) * e -
      MvPolynomial.C x₀, MvPolynomial.X (Sum.inl 1) - MvPolynomial.C x₁ * e]
      (fun i => MvPolynomial.map σ (Fh i)) a) = 0 := fun a =>
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨a, rfl⟩)
  have hq0 : q (MvPolynomial.X (Sum.inl 0)) * q e = q (MvPolynomial.C x₀) := by
    have h := hqrel (Sum.inl 0)
    rw [← map_mul, ← sub_eq_zero, ← map_sub]
    exact h
  have hq1 : q (MvPolynomial.X (Sum.inl 1)) = q (MvPolynomial.C x₁) * q e := by
    have h := hqrel (Sum.inl 1)
    rw [← map_mul, ← sub_eq_zero, ← map_sub]
    exact h
  have hqF : ∀ i, q (MvPolynomial.map σ (Fh i)) = 0 := fun i => hqrel (Sum.inr i)

  obtain ⟨Λ₀, hΛσ, hΛ0, hΛ1⟩ := hUP (MvPolynomial (Fin 2 ⊕ Fin n) N ⧸ J)
    (q.comp (MvPolynomial.C.comp σ)) (q (MvPolynomial.X (Sum.inl 0)))
    (q (MvPolynomial.X (Sum.inl 1))) (by
      rw [hq1, RingHom.comp_apply, RingHom.comp_apply, ← hx, MvPolynomial.C_mul, map_mul, ← hq0]
      ring)

  set Λ : MvPolynomial (Fin n) N →+* (MvPolynomial (Fin 2 ⊕ Fin n) N ⧸ J) :=
    MvPolynomial.eval₂Hom Λ₀ (fun j => q (MvPolynomial.X (Sum.inr j))) with hΛdef
  have hΛπ : ∀ p, Λ (π p) = q (MvPolynomial.map σ p) := by
    intro p
    have h1 : Λ (π p) = MvPolynomial.eval₂Hom (Λ₀.comp σ)
        (Sum.elim ![Λ₀ x₀, Λ₀ x₁] (fun j => q (MvPolynomial.X (Sum.inr j)))) p :=
      hπev _ Λ₀ _ p
    rw [h1]
    have h2 : MvPolynomial.eval₂Hom (Λ₀.comp σ)
        (Sum.elim ![Λ₀ x₀, Λ₀ x₁] (fun j => q (MvPolynomial.X (Sum.inr j)))) =
        q.comp (MvPolynomial.map σ) := by
      apply MvPolynomial.ringHom_ext
      · intro s
        rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply, RingHom.comp_apply, MvPolynomial.map_C]
        exact RingHom.congr_fun hΛσ s
      · rw [Sum.forall, Fin.forall_fin_two]
        refine ⟨⟨?_, ?_⟩, fun j => ?_⟩ <;>
          rw [MvPolynomial.eval₂Hom_X', RingHom.comp_apply, MvPolynomial.map_X]
        · exact hΛ0
        · exact hΛ1
        · rfl
    rw [h2, RingHom.comp_apply]
  have hΛF : ∀ i, Λ (F i) = 0 := fun i => by rw [← hFh i, hΛπ, hqF]

  have hkerle : RingHom.ker (MvPolynomial.eval₂Hom κ val) ≤ RingHom.ker Λ := by
    rw [hker, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact RingHom.mem_ker.mpr (hΛF i)
  set Ψ := RingHom.liftOfSurjective (MvPolynomial.eval₂Hom κ val) hsurj ⟨Λ, hkerle⟩ with hΨdef
  have hΨ : ∀ r, Ψ (MvPolynomial.eval₂Hom κ val r) = Λ r := fun r =>
    RingHom.liftOfSurjective_comp_apply _ hsurj ⟨Λ, hkerle⟩ r
  have hΨε : Ψ ε = q e := by
    rw [← heh]
    exact (hΨ (π eh)).trans (hΛπ eh)
  have hΨκ : ∀ c, Ψ (κ c) = Λ₀ c := by
    intro c
    have h := hΨ (MvPolynomial.C c)
    rw [MvPolynomial.eval₂Hom_C] at h
    rw [h, hΛdef, MvPolynomial.eval₂Hom_C]
  have hΨval : ∀ j, Ψ (val j) = q (MvPolynomial.X (Sum.inr j)) := by
    intro j
    have h := hΨ (MvPolynomial.X j)
    rw [MvPolynomial.eval₂Hom_X'] at h
    rw [h, hΛdef, MvPolynomial.eval₂Hom_X']

  have hNext : ∀ α β : N →+* (MvPolynomial (Fin 2 ⊕ Fin n) N ⧸ J), α.comp σ = β.comp σ →
      α x₀ = β x₀ → α x₁ = β x₁ → α = β := by
    intro α β hσ h0 h1
    have hc : α.comp (MvPolynomial.eval₂Hom σ ![x₀, x₁]) =
        β.comp (MvPolynomial.eval₂Hom σ ![x₀, x₁]) := by
      apply MvPolynomial.ringHom_ext
      · intro s
        rw [RingHom.comp_apply, RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
        exact RingHom.congr_fun hσ s
      · rw [Fin.forall_fin_two]
        refine ⟨?_, ?_⟩ <;>
          rw [RingHom.comp_apply, RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
        · exact h0
        · exact h1
    ext c
    obtain ⟨p, rfl⟩ := hsurjN c
    exact RingHom.congr_fun hc p
  have hΨψ : Ψ.comp ψ = q.comp MvPolynomial.C := by
    apply hNext
    · ext s
      have h := RingHom.congr_fun hψσ s
      simp only [RingHom.comp_apply] at h ⊢
      rw [h, hΨκ]
      exact RingHom.congr_fun hΛσ s
    · rw [RingHom.comp_apply, RingHom.comp_apply, hψ0, map_mul, hΨκ, hΨε, hΛ0, hq0]
    · rw [RingHom.comp_apply, RingHom.comp_apply]
      have hu : IsUnit (q e) := hΨε ▸ hε.map Ψ
      apply hu.mul_right_cancel
      calc Ψ (ψ x₁) * q e = Ψ (ψ x₁) * Ψ ε := by rw [hΨε]
        _ = Ψ (ψ x₁ * ε) := (map_mul Ψ _ _).symm
        _ = q (MvPolynomial.C x₁) * q e := by rw [hψ1, hΨκ, hΛ1, hq1]
  have hcomp : Ψ.comp (MvPolynomial.eval₂Hom ψ (Sum.elim ![κ x₀, κ x₁] val)) = q := by
    apply MvPolynomial.ringHom_ext
    · intro c
      rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
      exact RingHom.congr_fun hΨψ c
    · rw [Sum.forall, Fin.forall_fin_two]
      refine ⟨⟨?_, ?_⟩, fun j => ?_⟩ <;> rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
      · exact (hΨκ x₀).trans hΛ0
      · exact (hΨκ x₁).trans hΛ1
      · exact hΨval j
  refine ⟨hsurjΦ, le_antisymm ?_ hle⟩
  intro p hp
  rw [RingHom.mem_ker] at hp
  have h : q p = 0 := by rw [← hcomp, RingHom.comp_apply, hp, map_zero]
  exact Ideal.Quotient.eq_zero_iff_mem.mp h

theorem wcpa_dj_llsm_kpwm_tc_jac_lift_unit : ∀ (S N B : Type u) [CommRing S] [CommRing N] [CommRing B] (σ : S →+* N) (x₀ x₁ : N) (κ ψ : N →+* B) (n : ℕ) (F : Fin n → MvPolynomial (Fin n) N) (val : Fin n → B) (π : MvPolynomial (Fin 2 ⊕ Fin n) S →+* MvPolynomial (Fin n) N) (Fh : Fin n → MvPolynomial (Fin 2 ⊕ Fin n) S) (Gs : MvPolynomial (Fin n) N), (∀ (p : MvPolynomial (Fin 2 ⊕ Fin n) S) (j : Fin n), MvPolynomial.pderiv j (π p) = π (MvPolynomial.pderiv (Sum.inr j) p)) → (∀ p : MvPolynomial (Fin 2 ⊕ Fin n) S, MvPolynomial.eval₂ κ val (π p) = MvPolynomial.eval₂ (κ.comp σ) (Sum.elim ![κ x₀, κ x₁] val) p) → ψ.comp σ = κ.comp σ → (∀ i, π (Fh i) = F i) → RingHom.ker (MvPolynomial.eval₂Hom κ val) = Ideal.span (Set.range F) → Gs * (Matrix.of fun a b => MvPolynomial.pderiv a (F b)).det - 1 ∈ Ideal.span (Set.range F) → IsUnit (Matrix.of fun (j i : Fin n) => MvPolynomial.eval₂ ψ (Sum.elim ![κ x₀, κ x₁] val) (MvPolynomial.pderiv (Sum.inr j) (MvPolynomial.map σ (Fh i)))).det :=
by
  intro S N B _ _ _ σ x₀ x₁ κ ψ n F val π Fh Gs H1 H2 H3 H4 H5 H6
  have hM : (Matrix.of fun (j i : Fin n) => MvPolynomial.eval₂ ψ (Sum.elim ![κ x₀, κ x₁] val)
      (MvPolynomial.pderiv (Sum.inr j) (MvPolynomial.map σ (Fh i)))) =
      (MvPolynomial.eval₂Hom κ val).mapMatrix
        (Matrix.of fun a b => MvPolynomial.pderiv a (F b)) := by
    ext j i
    rw [Matrix.of_apply, RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply,
      MvPolynomial.pderiv_map, MvPolynomial.eval₂_map, H3, ← H2, ← H1, H4,
      MvPolynomial.coe_eval₂Hom]
  rw [hM, ← RingHom.map_det]
  rw [← H5] at H6
  have h0 := (RingHom.mem_ker).mp H6
  rw [map_sub, map_mul, map_one, sub_eq_zero] at h0
  exact ⟨⟨_, _, by rw [mul_comm]; exact h0, h0⟩, rfl⟩

theorem wcpa_dj_llsm_kpwm_tc_jac_mod_prime : ∀ (R B : Type u) [CommRing R] [CommRing B] (ψ : R →+* B) (n : ℕ) (e : MvPolynomial (Fin 2 ⊕ Fin n) R) (c₀ c₁ : R) (G : Fin n → MvPolynomial (Fin 2 ⊕ Fin n) R) (y : Fin 2 ⊕ Fin n → B) (𝔓 : Ideal B), 𝔓.IsPrime → y (Sum.inl 0) ∈ 𝔓 → ψ c₁ ∈ 𝔓 → MvPolynomial.eval₂ ψ y e ∉ 𝔓 → (Matrix.of fun (j i : Fin n) => MvPolynomial.eval₂ ψ y (MvPolynomial.pderiv (Sum.inr j) (G i))).det ∉ 𝔓 → MvPolynomial.eval₂ ψ y (Matrix.of fun a b : Fin 2 ⊕ Fin n => MvPolynomial.pderiv a (Sum.elim ![MvPolynomial.X (Sum.inl 0) * e - MvPolynomial.C c₀, MvPolynomial.X (Sum.inl 1) - MvPolynomial.C c₁ * e] G b)).det ∉ 𝔓 :=
by
  intro R B _ _ ψ n e c₀ c₁ G y 𝔓 h𝔓 hy0 hc1 he hN
  classical
  obtain ⟨χ, hχ⟩ : ∃ χ : MvPolynomial (Fin 2 ⊕ Fin n) R →+* B ⧸ 𝔓,
      χ = (Ideal.Quotient.mk 𝔓).comp (MvPolynomial.eval₂Hom ψ y) := ⟨_, rfl⟩
  have hχapp : ∀ p, χ p = Ideal.Quotient.mk 𝔓 (MvPolynomial.eval₂ ψ y p) := by
    intro p; rw [hχ]; rfl
  have hX0 : χ (MvPolynomial.X (Sum.inl 0)) = 0 := by
    rw [hχapp, MvPolynomial.eval₂_X, Ideal.Quotient.eq_zero_iff_mem]; exact hy0
  have hC1 : χ (MvPolynomial.C c₁) = 0 := by
    rw [hχapp, MvPolynomial.eval₂_C, Ideal.Quotient.eq_zero_iff_mem]; exact hc1
  have hE : χ e ≠ 0 := by
    rw [hχapp, Ne, Ideal.Quotient.eq_zero_iff_mem]; exact he
  have hNd : (Matrix.of fun (j i : Fin n) =>
      χ (MvPolynomial.pderiv (Sum.inr j) (G i))).det ≠ 0 := by
    have hmat : (Matrix.of fun (j i : Fin n) => χ (MvPolynomial.pderiv (Sum.inr j) (G i))) =
        (Ideal.Quotient.mk 𝔓).mapMatrix (Matrix.of fun (j i : Fin n) =>
          MvPolynomial.eval₂ ψ y (MvPolynomial.pderiv (Sum.inr j) (G i))) := by
      ext j i
      simp only [hχapp, Matrix.of_apply, RingHom.mapMatrix_apply, Matrix.map_apply]
    rw [hmat, ← RingHom.map_det, Ne, Ideal.Quotient.eq_zero_iff_mem]; exact hN
  rw [← Ideal.Quotient.eq_zero_iff_mem, ← hχapp, RingHom.map_det]
  set M' := χ.mapMatrix (Matrix.of fun a b : Fin 2 ⊕ Fin n => MvPolynomial.pderiv a
    (Sum.elim ![MvPolynomial.X (Sum.inl 0) * e - MvPolynomial.C c₀,
      MvPolynomial.X (Sum.inl 1) - MvPolynomial.C c₁ * e] G b)) with hM'
  have h21 : M'.toBlocks₂₁ = 0 := by
    ext j k
    fin_cases k <;> simp [hM', Matrix.toBlocks₂₁, MvPolynomial.pderiv_X, hX0, hC1]
  have h11 : M'.toBlocks₁₁ = !![χ e, 0; 0, 1] := by
    ext k l
    fin_cases k <;> fin_cases l <;>
      simp [hM', Matrix.toBlocks₁₁, MvPolynomial.pderiv_X, hX0, hC1]
  have h22 : M'.toBlocks₂₂ =
      Matrix.of fun (j i : Fin n) => χ (MvPolynomial.pderiv (Sum.inr j) (G i)) := by
    ext j i
    simp [hM', Matrix.toBlocks₂₂]
  rw [← Matrix.fromBlocks_toBlocks M', h21, Matrix.det_fromBlocks_zero₂₁, h11, h22,
    Matrix.det_fin_two_of]
  simp only [mul_one, mul_zero, sub_zero]
  exact mul_ne_zero hE hNd

theorem wcpa_dj_llsm_kpwm_tc_loc_std_etale : ∀ (R : Type u) [CommRing R] {ι : Type} [Fintype ι] [DecidableEq ι] (rel : ι → MvPolynomial ι R), RingHom.Etale ((algebraMap (MvPolynomial ι R ⧸ Ideal.span (Set.range rel)) (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range rel)) (Matrix.of fun a b => MvPolynomial.pderiv a (rel b)).det))).comp ((Ideal.Quotient.mk (Ideal.span (Set.range rel))).comp MvPolynomial.C)) :=
by
  intro R _ ι _ _ rel
  classical
  set J : Matrix ι ι (MvPolynomial ι R) := Matrix.of fun a b => MvPolynomial.pderiv a (rel b)
    with hJ
  set D := J.det with hD
  set I := Ideal.span (Set.range rel) with hI
  set ρ : MvPolynomial ι R →ₐ[R] MvPolynomial (Option ι) R := MvPolynomial.rename Option.some
    with hρ
  set rel' : Option ι → MvPolynomial (Option ι) R :=
    fun t => Option.elim t (MvPolynomial.X none * ρ D - 1) (fun j => ρ (rel j)) with hrel'
  set I' := Ideal.span (Set.range rel') with hI'

  have hvan : ∀ p : MvPolynomial ι R, MvPolynomial.pderiv none (ρ p) = 0 := by
    intro p
    apply MvPolynomial.pderiv_eq_zero_of_notMem_vars
    intro h
    have := MvPolynomial.vars_rename Option.some p h
    simp at this

  have hjac : (Matrix.of fun a b : Option ι => MvPolynomial.pderiv a (rel' b)).det = ρ D * ρ D := by
    set M' := (Matrix.of fun a b : Option ι => MvPolynomial.pderiv a (rel' b)) with hM'
    let e : ι ⊕ PUnit.{1} ≃ Option ι := (Equiv.optionEquivSumPUnit ι).symm
    rw [← Matrix.det_submatrix_equiv_self e M', ← Matrix.fromBlocks_toBlocks (M'.submatrix e e)]
    have h21 : (M'.submatrix e e).toBlocks₂₁ = 0 := by
      ext i j
      simp [Matrix.toBlocks₂₁, e, M', rel', hvan]
    have h11 : (M'.submatrix e e).toBlocks₁₁ = ρ.mapMatrix J := by
      ext i j
      simp [Matrix.toBlocks₁₁, e, M', rel', J, ρ,
        MvPolynomial.pderiv_rename (Option.some_injective ι)]
    have h22 : (M'.submatrix e e).toBlocks₂₂ PUnit.unit PUnit.unit = ρ D := by
      simp [Matrix.toBlocks₂₂, e, M', rel', hvan]
    rw [h21, Matrix.det_fromBlocks_zero₂₁, h11, ← AlgHom.map_det,
      Matrix.det_unique (M'.submatrix e e).toBlocks₂₂]
    rw [show (default : PUnit.{1}) = PUnit.unit from rfl, h22]

  have hmem : (MvPolynomial.X none ^ 2) *
      (Matrix.of fun i j : Option ι => MvPolynomial.pderiv (id i) (rel' j)).det - 1 ∈ I' := by
    have e1 : (Matrix.of fun i j : Option ι => MvPolynomial.pderiv (id i) (rel' j)) =
        Matrix.of fun a b : Option ι => MvPolynomial.pderiv a (rel' b) := rfl
    rw [e1, hjac]
    have h1 : rel' none ∈ I' := Ideal.subset_span ⟨none, rfl⟩
    have e2 : MvPolynomial.X none ^ 2 * (ρ D * ρ D) - 1 =
        rel' none * (MvPolynomial.X none * ρ D + 1) := by
      simp only [rel', Option.elim]; ring
    rw [e2]
    exact Ideal.mul_mem_right _ _ h1
  have het : Algebra.Etale R (MvPolynomial (Option ι) R ⧸ I') := by
    have hstd : ∀ (A : Type u) [CommRing A] {ι σ : Type} [Fintype ι] [Fintype σ] [DecidableEq σ]
        (mp : σ → ι), Function.Bijective mp → ∀ (f : σ → MvPolynomial ι A) (g : MvPolynomial ι A),
        g * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j)).det - 1 ∈
          Ideal.span (Set.range f) →
        Algebra.Etale A (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) := by
      intro A _ ι σ _ _ _ mp hbij f g hg
      let P : Algebra.PreSubmersivePresentation A (MvPolynomial ι A ⧸ Ideal.span (Set.range f))
          ι σ :=
        { Algebra.Presentation.naive (v := f) with map := mp, map_inj := hbij.1 }
      have hJ : P.jacobiMatrix = Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j) := by
        ext i j
        rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
        rfl
      have halg : ∀ x : MvPolynomial ι A,
          algebraMap P.Ring (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) x =
            Ideal.Quotient.mk (Ideal.span (Set.range f)) x := fun x => rfl
      have hunit : IsUnit P.jacobian := by
        rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, hJ, halg]
        have h1 : Ideal.Quotient.mk (Ideal.span (Set.range f))
            (g * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j)).det) = 1 := by
          rw [← map_one (Ideal.Quotient.mk (Ideal.span (Set.range f))), Ideal.Quotient.eq]
          exact hg
        rw [map_mul, mul_comm] at h1
        exact IsUnit.of_mul_eq_one _ h1
      let Q : Algebra.SubmersivePresentation A (MvPolynomial ι A ⧸ Ideal.span (Set.range f))
          ι σ :=
        { P with jacobian_isUnit := hunit }
      have hdim : Q.dimension = 0 := by
        show Nat.card ι - Nat.card σ = 0
        rw [Nat.card_eq_of_bijective mp hbij, Nat.sub_self]
      haveI := Q.isStandardSmoothOfRelativeDimension hdim
      infer_instance
    exact hstd R id Function.bijective_id rel' (MvPolynomial.X none ^ 2) hmem
  have het' : RingHom.Etale ((Ideal.Quotient.mk I').comp MvPolynomial.C) := by
    have e3 : (Ideal.Quotient.mk I').comp MvPolynomial.C =
        algebraMap R (MvPolynomial (Option ι) R ⧸ I') := RingHom.ext fun _ => rfl
    rw [e3]
    exact RingHom.etale_algebraMap.mpr het

  set mk := Ideal.Quotient.mk I with hmk
  set mk' := Ideal.Quotient.mk I' with hmk'
  set Dbar := mk D with hDbar
  set alg := algebraMap (MvPolynomial ι R ⧸ I) (Localization.Away Dbar) with halg
  have hu : IsUnit (alg Dbar) := IsLocalization.Away.algebraMap_isUnit Dbar
  set w : Localization.Away Dbar := ↑(hu.unit⁻¹) with hwdef
  have hw : w * alg Dbar = 1 := hu.val_inv_mul
  let Φ₀ : MvPolynomial (Option ι) R →+* Localization.Away Dbar :=
    MvPolynomial.eval₂Hom (alg.comp (mk.comp MvPolynomial.C))
      (fun t => Option.elim t w (fun j => alg (mk (MvPolynomial.X j))))
  have hΦ₀C : ∀ a, Φ₀ (MvPolynomial.C a) = alg (mk (MvPolynomial.C a)) := fun a =>
    MvPolynomial.eval₂Hom_C _ _ _
  have hΦ₀X : ∀ t, Φ₀ (MvPolynomial.X t) = Option.elim t w (fun j => alg (mk (MvPolynomial.X j))) :=
    fun t => MvPolynomial.eval₂Hom_X' _ _ _
  have hF1 : Φ₀.comp ρ.toRingHom = alg.comp mk := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      rw [hρ, MvPolynomial.rename_C, hΦ₀C]
    · intro j
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      rw [hρ, MvPolynomial.rename_X, hΦ₀X]
      rfl
  have hF1' : ∀ p, Φ₀ (ρ p) = alg (mk p) := fun p => RingHom.congr_fun hF1 p
  have hF2 : I' ≤ RingHom.ker Φ₀ := by
    rw [hI', Ideal.span_le]
    rintro _ ⟨t, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    cases t with
    | none =>
      show Φ₀ (MvPolynomial.X none * ρ D - 1) = 0
      rw [map_sub, map_mul, hF1', map_one, hΦ₀X]
      show w * alg Dbar - 1 = 0
      rw [hw, sub_self]
    | some j =>
      show Φ₀ (ρ (rel j)) = 0
      have hj : rel j ∈ I := Ideal.subset_span ⟨j, rfl⟩
      rw [hF1', Ideal.Quotient.eq_zero_iff_mem.mpr hj, map_zero]
  let Φ : (MvPolynomial (Option ι) R ⧸ I') →+* Localization.Away Dbar :=
    Ideal.Quotient.lift I' Φ₀ (fun a ha => hF2 ha)
  have hΦ : ∀ p, Φ (mk' p) = Φ₀ p := fun p => Ideal.Quotient.lift_mk _ _ _
  have hH2 : I ≤ RingHom.ker (mk'.comp ρ.toRingHom) := by
    rw [hI, Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨some j, rfl⟩)
  let ψ₀ : (MvPolynomial ι R ⧸ I) →+* (MvPolynomial (Option ι) R ⧸ I') :=
    Ideal.Quotient.lift I (mk'.comp ρ.toRingHom) (fun a ha => hH2 ha)
  have hψ₀ : ∀ p, ψ₀ (mk p) = mk' (ρ p) := fun p => Ideal.Quotient.lift_mk _ _ _
  have hstar : mk' (MvPolynomial.X none) * mk' (ρ D) = 1 := by
    rw [← map_mul, ← sub_eq_zero, ← map_one mk', ← map_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨none, rfl⟩)
  have hv : IsUnit (ψ₀ Dbar) := by
    rw [hDbar, hψ₀]
    exact IsUnit.of_mul_eq_one _ (by rw [mul_comm]; exact hstar)
  let Ψ : Localization.Away Dbar →+* (MvPolynomial (Option ι) R ⧸ I') :=
    IsLocalization.Away.lift Dbar hv
  have hΨ : ∀ q, Ψ (alg q) = ψ₀ q := fun q => IsLocalization.Away.lift_eq Dbar hv q
  have hC1 : Φ.comp Ψ = RingHom.id _ := by
    apply IsLocalization.ringHom_ext (Submonoid.powers Dbar)
    apply Ideal.Quotient.ringHom_ext
    apply RingHom.ext
    intro p
    simp only [RingHom.comp_apply, RingHom.id_apply]
    rw [hΨ, hψ₀, hΦ, hF1']
  have hΨw : Ψ w = mk' (MvPolynomial.X none) := by
    have h1 : Ψ w * mk' (ρ D) = 1 := by
      rw [← hψ₀, ← hΨ, ← map_mul, hw, map_one]
    calc Ψ w = Ψ w * (mk' (ρ D) * mk' (MvPolynomial.X none)) := by
          rw [mul_comm (mk' (ρ D)), hstar, mul_one]
      _ = mk' (MvPolynomial.X none) := by rw [← mul_assoc, h1, one_mul]
  have hC2 : Ψ.comp Φ = RingHom.id _ := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro a
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hΦ, hΦ₀C, hΨ, hψ₀, hρ, MvPolynomial.rename_C]
    · intro t
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hΦ, hΦ₀X]
      cases t with
      | none => exact hΨw
      | some j =>
        show Ψ (alg (mk (MvPolynomial.X j))) = _
        rw [hΨ, hψ₀, hρ, MvPolynomial.rename_X]
  let E : (MvPolynomial (Option ι) R ⧸ I') ≃+* Localization.Away Dbar :=
    RingEquiv.ofRingHom Φ Ψ hC1 hC2
  have hE : E.toRingHom.comp ((Ideal.Quotient.mk I').comp MvPolynomial.C) =
      alg.comp (mk.comp MvPolynomial.C) := by
    apply RingHom.ext
    intro a
    show Φ (mk' (MvPolynomial.C a)) = _
    rw [hΦ, hΦ₀C]
    rfl
  have hfin := RingHom.Etale.respectsIso.1 _ E het'
  rw [hE] at hfin
  exact hfin

theorem wcpa_dj_llsm_kpwm_tc_away_transport : ∀ (A Q : Type u) [CommRing A] [CommRing Q] (x : A) (ρ : Q ≃+* Localization.Away x) (q : Q), ∃ (d : A) (k : ℕ), ρ q * algebraMap A (Localization.Away x) (x ^ k) = algebraMap A (Localization.Away x) d ∧ ∃ (ι : Localization.Away x →+* Localization.Away (d * x)) (Θ : Localization.Away q ≃+* Localization.Away (d * x)), ι.comp (algebraMap A (Localization.Away x)) = algebraMap A (Localization.Away (d * x)) ∧ ∀ z : Q, Θ (algebraMap Q (Localization.Away q) z) = ι (ρ z) :=
by
  intro A Q _ _ x ρ q
  obtain ⟨k, d, hkd⟩ := IsLocalization.Away.surj x (ρ q)
  refine ⟨d, k, by rw [map_pow]; exact hkd, ?_⟩
  have hu : IsUnit ((algebraMap A (Localization.Away x) x) ^ k) :=
    (IsLocalization.Away.algebraMap_isUnit x).pow k
  have hassoc : Associated (ρ q) (algebraMap A (Localization.Away x) d) :=
    ⟨hu.unit, by rw [IsUnit.unit_spec]; exact hkd⟩
  haveI h1 : IsLocalization.Away (algebraMap A (Localization.Away x) d)
      (Localization.Away (ρ q)) := IsLocalization.Away.of_associated hassoc
  haveI h2 : IsLocalization.Away (d * x) (Localization.Away (ρ q)) :=
    IsLocalization.Away.mul (Localization.Away x) (Localization.Away (ρ q)) x d
  let e₁ : Localization.Away (ρ q) ≃ₐ[A] Localization.Away (d * x) :=
    IsLocalization.algEquiv (Submonoid.powers (d * x)) (Localization.Away (ρ q))
      (Localization.Away (d * x))
  let e₀ : Localization.Away q ≃+* Localization.Away (ρ q) :=
    IsLocalization.ringEquivOfRingEquiv (M := Submonoid.powers q)
      (T := Submonoid.powers (ρ q)) (Localization.Away q) (Localization.Away (ρ q)) ρ
      (Submonoid.map_powers ρ.toMonoidHom q)
  refine ⟨e₁.toRingEquiv.toRingHom.comp (algebraMap (Localization.Away x) (Localization.Away (ρ q))),
    e₀.trans e₁.toRingEquiv, ?_, ?_⟩
  · ext a
    simp only [RingHom.comp_apply]
    show e₁ (algebraMap (Localization.Away x) (Localization.Away (ρ q))
      (algebraMap A (Localization.Away x) a)) = _
    rw [← IsScalarTower.algebraMap_apply A (Localization.Away x) (Localization.Away (ρ q)) a]
    exact e₁.commutes a
  · intro z
    rw [RingEquiv.trans_apply]
    show e₁ (e₀ (algebraMap Q (Localization.Away q) z)) = _
    have he₀ : e₀ (algebraMap Q (Localization.Away q) z) =
        algebraMap (Localization.Away x) (Localization.Away (ρ q)) (ρ z) :=
      IsLocalization.ringEquivOfRingEquiv_eq _ z
    rw [he₀]
    rfl

theorem wcpa_dj_llsm_kpwm_twist_chart : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [Algebra ↥W A] (g : ↥W) (h ε u v : A) (P : Ideal A) [P.IsPrime]
    (f : (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+* Localization.Away h),
    h ∉ P → ε ∉ P → u ∈ P → v ∈ P →
    f.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
      (algebraMap A (Localization.Away h)).comp (algebraMap ↥W A) →
    f (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = algebraMap A (Localization.Away h) u →
    f (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = algebraMap A (Localization.Away h) v →
    RingHom.Etale (R := MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
      (S := Localization.Away h) f →
    ∃ h' : A, h' ∉ P ∧ IsUnit (algebraMap A (Localization.Away h') ε) ∧
      ∃ f' : (MvPolynomial (Fin 2) ↥W ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+*
          Localization.Away h',
        f'.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
          (algebraMap A (Localization.Away h')).comp (algebraMap ↥W A) ∧
        f' (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = algebraMap A (Localization.Away h') (u * ε) ∧
        f' (Ideal.Quotient.mk _ (MvPolynomial.X 1)) * algebraMap A (Localization.Away h') ε =
          algebraMap A (Localization.Away h') v ∧
        RingHom.Etale (R := MvPolynomial (Fin 2) ↥W ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
          (S := Localization.Away h') f' :=
by
  intro Ω _ W A _ _ g h ε u v P _ f₀ hh hε hu hv hfC₀ hfu₀ hfv₀ hfet₀
  suffices key : ∀ (N : Type u) [CommRing N] (σ : ↥W →+* N) (x₀ x₁ : N)
      (f : N →+* Localization.Away h),
      x₀ * x₁ = σ g → Function.Surjective (MvPolynomial.eval₂Hom σ ![x₀, x₁]) →
      (∀ (T : Type u) [CommRing T] (α : ↥W →+* T) (t₀ t₁ : T), t₀ * t₁ = α g →
        ∃ μ : N →+* T, μ.comp σ = α ∧ μ x₀ = t₀ ∧ μ x₁ = t₁) →
      f.comp σ = (algebraMap A (Localization.Away h)).comp (algebraMap ↥W A) →
      f x₀ = algebraMap A (Localization.Away h) u →
      f x₁ = algebraMap A (Localization.Away h) v → RingHom.Etale f →
      ∃ h' : A, h' ∉ P ∧ IsUnit (algebraMap A (Localization.Away h') ε) ∧
        ∃ f' : N →+* Localization.Away h',
          f'.comp σ = (algebraMap A (Localization.Away h')).comp (algebraMap ↥W A) ∧
          f' x₀ = algebraMap A (Localization.Away h') (u * ε) ∧
          f' x₁ * algebraMap A (Localization.Away h') ε = algebraMap A (Localization.Away h') v ∧
          RingHom.Etale f' by
    obtain ⟨hx, hsurjN, hUP⟩ := wcpa_dj_llsm_kpwm_tc_node_basics W g
    exact key (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
      ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})).comp
        (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 2) ↥W))
      (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
        (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W))
      (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
        (MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W))
      f₀ hx hsurjN hUP hfC₀ hfu₀ hfv₀ hfet₀
  clear hfC₀ hfu₀ hfv₀ hfet₀ f₀
  intro N _ σ x₀ x₁ f hx' hsurjN' hUP' hfC hfu hfv hfet

  obtain ⟨φ, hφ, hκet⟩ := wcpa_dj_llsm_brsp_chart_compose A A N (RingHom.id A) h ε f
      hfet (by
    rw [RingHom.comp_id]
    exact RingHom.etale_algebraMap.mpr
      (Algebra.Etale.of_isLocalizationAway ((RingHom.id A) h * ε)))
  generalize hxdef : (RingHom.id A) h * ε = x at φ hφ hκet
  have hxP : x ∉ P := by
    rw [← hxdef]
    exact (inferInstance : P.IsPrime).mul_notMem hh hε
  set κ := φ.comp f with hκdef
  have hκC : κ.comp σ = (algebraMap A (Localization.Away x)).comp (algebraMap ↥W A) := by
    have e : κ.comp σ = φ.comp (f.comp σ) := rfl
    rw [e, hfC, ← RingHom.comp_assoc, hφ, RingHom.comp_id]
  have hκ0 : κ x₀ = algebraMap A (Localization.Away x) u :=
    (congrArg φ hfu).trans (RingHom.congr_fun hφ u)
  have hκ1 : κ x₁ = algebraMap A (Localization.Away x) v :=
    (congrArg φ hfv).trans (RingHom.congr_fun hφ v)
  have hεB : IsUnit (algebraMap A (Localization.Away x) ε) := by
    refine isUnit_of_dvd_unit (map_dvd _ ⟨(RingHom.id A) h, ?_⟩)
      (IsLocalization.Away.algebraMap_isUnit x)
    rw [← hxdef]; ring

  have h𝔓 : (P.map (algebraMap A (Localization.Away x))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers x) _ P inferInstance
      ((Ideal.disjoint_powers_iff_notMem x (Ideal.IsPrime.isRadical inferInstance)).mpr hxP)
  have hε𝔓 : algebraMap A (Localization.Away x) ε ∉ P.map (algebraMap A (Localization.Away x)) :=
    fun hm => h𝔓.ne_top (Ideal.eq_top_of_isUnit_mem _ hm hεB)

  letI iκ : Algebra N (Localization.Away x) :=
    RingHom.toAlgebra (R := N) (S := Localization.Away x) κ
  obtain ⟨n, F, val, hsurj', hker', Gs, hGs⟩ := wc_sh_standard_presentation_fin
    N (Localization.Away x) hκet
  have hsurj : Function.Surjective (MvPolynomial.eval₂Hom (R := N) κ val) := hsurj'
  have hker : RingHom.ker (MvPolynomial.eval₂Hom κ val) = Ideal.span (Set.range F) := by
    rw [← hker']
    ext p
    exact Iff.rfl
  clear hsurj' hker' iκ

  obtain ⟨hπsurj, hπder, hπev⟩ := wcpa_dj_llsm_kpwm_tc_flatten ↥W _ σ x₀ x₁ n hsurjN'
  generalize hπdef : (MvPolynomial.eval₂Hom (MvPolynomial.C.comp σ)
      (Sum.elim ![MvPolynomial.C x₀, MvPolynomial.C x₁] MvPolynomial.X) :
      MvPolynomial (Fin 2 ⊕ Fin n) ↥W →+* MvPolynomial (Fin n) N) = π
    at hπsurj hπder hπev
  obtain ⟨pe, hpe⟩ := hsurj (algebraMap A (Localization.Away x) ε)
  obtain ⟨eh, heh⟩ := hπsurj pe
  choose Fh hFh using fun i => hπsurj (F i)
  have hehv : MvPolynomial.eval₂ κ val (π eh) = algebraMap A (Localization.Away x) ε := by
    rw [heh]; exact hpe

  obtain ⟨ψ, hψσ, hψ0, hψ1'⟩ := hUP' (Localization.Away x) (κ.comp σ)
    (κ x₀ * algebraMap A (Localization.Away x) ε) (κ x₁ * ↑hεB.unit⁻¹) (by
      have h1 : algebraMap A (Localization.Away x) ε * ↑hεB.unit⁻¹ = 1 := hεB.mul_val_inv
      calc κ x₀ * algebraMap A (Localization.Away x) ε * (κ x₁ * ↑hεB.unit⁻¹)
          = κ x₀ * κ x₁ * (algebraMap A (Localization.Away x) ε * ↑hεB.unit⁻¹) := by ring
        _ = κ (x₀ * x₁) := by rw [h1, mul_one, map_mul]
        _ = (κ.comp σ) g := congrArg κ hx')
  have hψ1 : ψ x₁ * algebraMap A (Localization.Away x) ε = κ x₁ := by
    rw [hψ1', mul_assoc, hεB.val_inv_mul, mul_one]

  obtain ⟨hΦsurj, hΦker⟩ := wcpa_dj_llsm_kpwm_tc_twist_present ↥W _ (Localization.Away x) σ g
    x₀ x₁ κ ψ (algebraMap A (Localization.Away x) ε) n F val π Fh eh hx' hsurjN' hUP' hπsurj
    hπev hεB hsurj hker hFh hehv hψσ hψ0 hψ1
  set rel : Fin 2 ⊕ Fin n → MvPolynomial (Fin 2 ⊕ Fin n) N :=
    Sum.elim ![MvPolynomial.X (Sum.inl 0) * MvPolynomial.map σ eh - MvPolynomial.C x₀,
      MvPolynomial.X (Sum.inl 1) - MvPolynomial.C x₁ * MvPolynomial.map σ eh]
      (fun i => MvPolynomial.map σ (Fh i)) with hrel
  set ρ := (Ideal.quotEquivOfEq hΦker.symm).trans (RingHom.quotientKerEquivOfSurjective hΦsurj)
    with hρdef
  have hρ : ∀ p, ρ (Ideal.Quotient.mk _ p) =
      MvPolynomial.eval₂Hom ψ (Sum.elim ![κ x₀, κ x₁] val) p := by
    intro p
    rw [hρdef, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
      RingHom.quotientKerEquivOfSurjective_apply_mk]

  have hJT := wcpa_dj_llsm_kpwm_tc_jac_lift_unit ↥W _ (Localization.Away x) σ x₀ x₁ κ ψ n F val
    π Fh Gs hπder (fun p => hπev (Localization.Away x) κ val p) hψσ hFh hker hGs
  have hJT𝔓 := fun hm => h𝔓.ne_top (Ideal.eq_top_of_isUnit_mem _ hm hJT)
  have he𝔓 : MvPolynomial.eval₂ ψ (Sum.elim ![κ x₀, κ x₁] val) (MvPolynomial.map σ eh) ∉
      P.map (algebraMap A (Localization.Away x)) := by
    rw [MvPolynomial.eval₂_map, hψσ, ← hπev (Localization.Away x) κ val eh, hehv]
    exact hε𝔓
  have hy0 : (Sum.elim ![κ x₀, κ x₁] val : Fin 2 ⊕ Fin n → Localization.Away x) (Sum.inl 0) ∈
      P.map (algebraMap A (Localization.Away x)) := by
    simp only [Sum.elim_inl, Matrix.cons_val_zero]
    rw [hκ0]
    exact Ideal.mem_map_of_mem _ hu
  have hψc₁ : ψ x₁ ∈ P.map (algebraMap A (Localization.Away x)) := by
    refine (h𝔓.mem_or_mem ?_).resolve_right hε𝔓
    rw [hψ1, hκ1]
    exact Ideal.mem_map_of_mem _ hv
  have hD := wcpa_dj_llsm_kpwm_tc_jac_mod_prime _ (Localization.Away x) ψ n
    (MvPolynomial.map σ eh) x₀ x₁ (fun i => MvPolynomial.map σ (Fh i))
    (Sum.elim ![κ x₀, κ x₁] val) _ h𝔓 hy0 hψc₁ he𝔓 hJT𝔓
  have hq𝔓 : ρ (Ideal.Quotient.mk (Ideal.span (Set.range rel))
      (Matrix.of fun a b => MvPolynomial.pderiv a (rel b)).det) ∉
      P.map (algebraMap A (Localization.Away x)) := by
    rw [hρ]
    exact hD

  obtain ⟨d, k, hdk, ι, Θ, hι, hΘ⟩ := wcpa_dj_llsm_kpwm_tc_away_transport A _ x ρ
    (Ideal.Quotient.mk (Ideal.span (Set.range rel))
      (Matrix.of fun a b => MvPolynomial.pderiv a (rel b)).det)
  have hdP : d ∉ P := by
    intro hdP
    have hm : algebraMap A (Localization.Away x) d ∈ P.map (algebraMap A (Localization.Away x)) :=
      Ideal.mem_map_of_mem _ hdP
    rw [← hdk] at hm
    rcases h𝔓.mem_or_mem hm with h1 | h1
    · exact hq𝔓 h1
    · refine h𝔓.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 ?_)
      rw [map_pow]
      exact (IsLocalization.Away.algebraMap_isUnit x).pow k
  have hh'P : d * x ∉ P := (inferInstance : P.IsPrime).mul_notMem hdP hxP

  have hf'c : ∀ c, (Θ.toRingHom.comp ((algebraMap _ (Localization.Away
      (Ideal.Quotient.mk (Ideal.span (Set.range rel))
        (Matrix.of fun a b => MvPolynomial.pderiv a (rel b)).det))).comp
      ((Ideal.Quotient.mk (Ideal.span (Set.range rel))).comp MvPolynomial.C))) c = ι (ψ c) := by
    intro c
    rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe,
      RingEquiv.coe_toRingHom, hΘ, hρ, MvPolynomial.eval₂Hom_C]
  have hunit : IsUnit (algebraMap A (Localization.Away (d * x)) ε) := by
    refine isUnit_of_dvd_unit (map_dvd _ ⟨d * (RingHom.id A) h, ?_⟩)
      (IsLocalization.Away.algebraMap_isUnit (d * x))
    rw [← hxdef]; ring
  refine ⟨d * x, hh'P, hunit, Θ.toRingHom.comp ((algebraMap _ (Localization.Away
      (Ideal.Quotient.mk (Ideal.span (Set.range rel))
        (Matrix.of fun a b => MvPolynomial.pderiv a (rel b)).det))).comp
      ((Ideal.Quotient.mk (Ideal.span (Set.range rel))).comp MvPolynomial.C)), ?_, ?_, ?_, ?_⟩
  · refine RingHom.ext fun w => ?_
    rw [RingHom.comp_apply, hf'c]
    have e1 := RingHom.congr_fun hψσ w
    have e2 := RingHom.congr_fun hκC w
    have e3 := RingHom.congr_fun hι (algebraMap ↥W A w)
    simp only [RingHom.comp_apply] at e1 e2 e3 ⊢
    rw [e1, e2, e3]
  · rw [hf'c, hψ0, hκ0, ← map_mul]
    exact RingHom.congr_fun hι (u * ε)
  · have e := RingHom.congr_fun hι ε
    have e' := RingHom.congr_fun hι v
    simp only [RingHom.comp_apply] at e e'
    rw [hf'c, ← e, ← e', ← map_mul, hψ1, hκ1]
  · exact RingHom.Etale.respectsIso.1 _ Θ (wcpa_dj_llsm_kpwm_tc_loc_std_etale _ rel)

theorem wcpa_dj_llsm_kpwm_kummer_points : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [Algebra ↥W A] (L : Type u) [Field L] [Algebra A L]
    (𝔭 : Ideal A) (u v ε : A) (g r : ↥W) (ℓ : ℕ) (θ : L)
    (y : Ideal ↥(integralClosure A L)) [y.IsPrime], 0 < ℓ → θ ≠ 0 →
    u ∈ 𝔭 → v ∈ 𝔭 → ε ∉ 𝔭 → u * v = algebraMap ↥W A g → r ^ ℓ = g →
    θ ^ ℓ = algebraMap A L (u * ε) →
    y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
    ∃ (t : ↥(integralClosure A L)) (x1 : Localization.AtPrime y),
      (t : L) = θ ∧ t ∈ y ∧ x1 ∈ IsLocalRing.maximalIdeal (Localization.AtPrime y) ∧
      algebraMap ↥(integralClosure A L) (Localization.AtPrime y) t * x1 =
        algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
          (algebraMap A ↥(integralClosure A L) (algebraMap ↥W A r)) ∧
      algebraMap ↥(integralClosure A L) (Localization.AtPrime y) t ^ ℓ =
        algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
          (algebraMap A ↥(integralClosure A L) (u * ε)) ∧
      x1 ^ ℓ * algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
          (algebraMap A ↥(integralClosure A L) ε) =
        algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
          (algebraMap A ↥(integralClosure A L) v) :=
by
  intro Ω _ W A _ _ L _ _ 𝔭 u v ε g r ℓ θ y hyP hℓ hθ hu hv hε huv hrg hθℓ hy
  obtain ⟨m, rfl⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, by omega⟩
  have hmem : ∀ a : A, algebraMap A ↥(integralClosure A L) a ∈ y ↔ a ∈ 𝔭 := by
    intro a
    rw [← hy, Ideal.mem_comap]
  have hcoe : ∀ a : A, ((algebraMap A ↥(integralClosure A L) a : ↥(integralClosure A L)) : L) =
      algebraMap A L a := fun a => rfl

  have hθint : IsIntegral A θ := by
    apply IsIntegral.of_pow (Nat.succ_pos m)
    rw [hθℓ]
    exact isIntegral_algebraMap
  let t : ↥(integralClosure A L) := ⟨θ, hθint⟩
  have ht : t ^ (m + 1) = algebraMap A ↥(integralClosure A L) (u * ε) := by
    apply Subtype.ext
    rw [SubmonoidClass.coe_pow, hcoe]
    exact hθℓ

  have hr : algebraMap A L (algebraMap ↥W A r) ^ (m + 1) =
      algebraMap A L u * algebraMap A L v := by
    rw [← map_pow, ← map_pow, hrg, ← huv, map_mul]
  set w : L := algebraMap A L ε * algebraMap A L (algebraMap ↥W A r) / θ with hwdef
  have hI1 : θ * w = algebraMap A L ε * algebraMap A L (algebraMap ↥W A r) := by
    rw [hwdef]
    field_simp
  have hI2 : w ^ (m + 1) = algebraMap A L (ε ^ m * v) := by
    have h1 : w ^ (m + 1) * θ ^ (m + 1) =
        (algebraMap A L ε ^ m * algebraMap A L v) * θ ^ (m + 1) := by
      rw [← mul_pow, mul_comm w θ, hI1, mul_pow, hr, hθℓ, map_mul]
      ring
    rw [map_mul, map_pow]
    exact mul_right_cancel₀ (pow_ne_zero _ hθ) h1
  have hwint : IsIntegral A w := by
    apply IsIntegral.of_pow (Nat.succ_pos m)
    rw [hI2]
    exact isIntegral_algebraMap
  let s : ↥(integralClosure A L) := ⟨w, hwint⟩
  have hJ1 : t * s = algebraMap A ↥(integralClosure A L) (ε * algebraMap ↥W A r) := by
    apply Subtype.ext
    rw [MulMemClass.coe_mul, hcoe, map_mul]
    exact hI1
  have hJ2 : s ^ (m + 1) = algebraMap A ↥(integralClosure A L) (ε ^ m * v) := by
    apply Subtype.ext
    rw [SubmonoidClass.coe_pow, hcoe]
    exact hI2

  have hty : t ∈ y := by
    apply hyP.mem_of_pow_mem (m + 1)
    rw [ht]
    exact (hmem _).2 (Ideal.mul_mem_right _ _ hu)
  have hsy : s ∈ y := by
    apply hyP.mem_of_pow_mem (m + 1)
    rw [hJ2]
    exact (hmem _).2 (Ideal.mul_mem_left _ _ hv)
  have hεy : algebraMap A ↥(integralClosure A L) ε ∉ y := fun h => hε ((hmem ε).1 h)
  have hunit : IsUnit (algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
      (algebraMap A ↥(integralClosure A L) ε)) :=
    IsLocalization.map_units (Localization.AtPrime y)
      (⟨algebraMap A ↥(integralClosure A L) ε, hεy⟩ : y.primeCompl)
  obtain ⟨c, hc⟩ := hunit.exists_right_inv
  have hsmax : algebraMap ↥(integralClosure A L) (Localization.AtPrime y) s ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime y) :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime y) y s).2 hsy
  refine ⟨t, algebraMap ↥(integralClosure A L) (Localization.AtPrime y) s * c, rfl, hty,
    Ideal.mul_mem_right _ _ hsmax, ?_, ?_, ?_⟩
  · have hkey : algebraMap ↥(integralClosure A L) (Localization.AtPrime y) s * c *
        algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
          (algebraMap A ↥(integralClosure A L) ε) =
        algebraMap ↥(integralClosure A L) (Localization.AtPrime y) s := by
      rw [mul_assoc, mul_comm c, hc, mul_one]
    apply hunit.mul_right_cancel
    rw [mul_assoc, hkey, ← map_mul, hJ1, map_mul, map_mul, mul_comm]
  · rw [← map_pow, ht]
  · have hkey : algebraMap ↥(integralClosure A L) (Localization.AtPrime y) s * c *
        algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
          (algebraMap A ↥(integralClosure A L) ε) =
        algebraMap ↥(integralClosure A L) (Localization.AtPrime y) s := by
      rw [mul_assoc, mul_comm c, hc, mul_one]
    apply (hunit.pow m).mul_right_cancel
    have e1 : (algebraMap ↥(integralClosure A L) (Localization.AtPrime y) s * c) ^ (m + 1) *
        algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
          (algebraMap A ↥(integralClosure A L) ε) *
        algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
          (algebraMap A ↥(integralClosure A L) ε) ^ m =
        (algebraMap ↥(integralClosure A L) (Localization.AtPrime y) s * c *
        algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
          (algebraMap A ↥(integralClosure A L) ε)) ^ (m + 1) := by ring
    rw [e1, hkey, ← map_pow, hJ2, map_mul, map_mul, map_pow, map_pow, mul_comm]

theorem wcpa_dj_llsm_kpwm_pushout_chart : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (g r : ↥W) (ℓ : ℕ) (B P : Type u) [CommRing B] [CommRing P]
    (f' : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+* B) (φB : B →+* P) (x0 x1 : P), r ^ ℓ = g →
    RingHom.Etale (R := (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})) (S := B) f' →
    x0 * x1 = φB (f' (((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})).comp MvPolynomial.C) r)) →
    x0 ^ ℓ = φB (f' (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.X 0))) →
    x1 ^ ℓ = φB (f' (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.X 1))) →
    ∃ (R : Type u) (_ : CommRing R) (_ : Algebra (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r} : Set (MvPolynomial (Fin 2) ↥W))) R)
      (iB : B →+* R) (γ : R →+* P),
      Algebra.Etale (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r} : Set (MvPolynomial (Fin 2) ↥W))) R ∧ γ.comp iB = φB ∧
      γ ((algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) R : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) →+* R) (Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r} : Set (MvPolynomial (Fin 2) ↥W))) (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W))) = x0 ∧
      γ ((algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) R : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) →+* R) (Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r} : Set (MvPolynomial (Fin 2) ↥W))) (MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W))) = x1 ∧
      (∀ w : ↥W, (algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) R : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) →+* R) (Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r} : Set (MvPolynomial (Fin 2) ↥W))) (MvPolynomial.C w)) = iB (f' (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.C w)))) ∧
      (algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) R : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) →+* R) (Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r} : Set (MvPolynomial (Fin 2) ↥W))) (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W)) ^ ℓ = iB (f' (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.X 0))) ∧
      (algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) R : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) →+* R) (Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r} : Set (MvPolynomial (Fin 2) ↥W))) (MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W)) ^ ℓ = iB (f' (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.X 1))) ∧
      ∀ z : R, ∃ (n : ℕ) (mm : Fin n → (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r} : Set (MvPolynomial (Fin 2) ↥W)))) (b : Fin n → B),
        z = Finset.sum Finset.univ (fun i => (algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) R : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) →+* R) (mm i) * iB (b i)) :=
by
  intro Ω _ W g r ℓ B P _ _ f' φB x0 x1 hrg hfet hx01 hx0 hx1
  classical

  have lift : ∀ (c : ↥W) (S : Type u) [CommRing S] (σ : ↥W →+* S) (a b : S), a * b = σ c →
      ∃ φ : (MvPolynomial (Fin 2) ↥W ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}) →+* S,
        (∀ w, φ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C c}) (MvPolynomial.C w)) = σ w) ∧
        φ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C c}) (MvPolynomial.X 0)) = a ∧
        φ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C c}) (MvPolynomial.X 1)) = b := by
    intro c S _ σ a b hab
    have hE : ∀ p ∈ Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c :
        MvPolynomial (Fin 2) ↥W)}, MvPolynomial.eval₂Hom σ ![a, b] p = 0 := by
      intro p hp
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp hp
      simp [hab]
    refine ⟨Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom σ ![a, b]) hE, ?_, ?_, ?_⟩
    · intro w; simp
    · simp
    · simp

  have ext : ∀ (c : ↥W) (S : Type u) [CommRing S] (φ ψ : (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}) →+* S),
      (∀ w, φ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C c}) (MvPolynomial.C w)) = ψ (Ideal.Quotient.mk (Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}) (MvPolynomial.C w))) →
      φ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C c}) (MvPolynomial.X 0)) = ψ (Ideal.Quotient.mk (Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}) (MvPolynomial.X 0)) →
      φ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C c}) (MvPolynomial.X 1)) = ψ (Ideal.Quotient.mk (Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}) (MvPolynomial.X 1)) →
      φ = ψ := by
    intro c S _ φ ψ hC h0 h1
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro w; exact hC w
    · intro i
      fin_cases i
      · exact h0
      · exact h1

  have hXr : (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C r}) (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W)) *
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r})
        (MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W) =
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r})
        (MvPolynomial.C r) := by
    rw [← map_mul, Ideal.Quotient.eq]
    exact Ideal.subset_span rfl

  obtain ⟨ι, hιC, hι0, hι1⟩ := lift g (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r})
    ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C r})).comp MvPolynomial.C)
    (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r})
      (MvPolynomial.X 0) ^ ℓ)
    (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r})
      (MvPolynomial.X 1) ^ ℓ)
    (by rw [RingHom.comp_apply, ← hrg, map_pow, map_pow, ← hXr]; ring)

  obtain ⟨φN, hφC, hφ0, hφ1⟩ := lift r P
    ((φB.comp f').comp ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C g})).comp MvPolynomial.C)) x0 x1 hx01
  simp only [RingHom.comp_apply] at hιC hφC
  have hcomp : φN.comp ι = φB.comp f' := by
    apply ext g P
    · intro w
      rw [RingHom.comp_apply, hιC, hφC, RingHom.comp_apply]
    · rw [RingHom.comp_apply, hι0, map_pow, hφ0, hx0, RingHom.comp_apply]
    · rw [RingHom.comp_apply, hι1, map_pow, hφ1, hx1, RingHom.comp_apply]

  have gen : ∀ (Ng Nr B' P' : Type u) [CommRing Ng] [CommRing Nr] [CommRing B'] [CommRing P']
      (ι' : Ng →+* Nr) (f : Ng →+* B') (ψN : Nr →+* P') (ψB : B' →+* P'), f.Etale →
      ψN.comp ι' = ψB.comp f →
      ∃ (R : Type u) (_ : CommRing R) (_ : Algebra Nr R) (iB : B' →+* R) (γ : R →+* P'),
        Algebra.Etale Nr R ∧ γ.comp iB = ψB ∧ (∀ a, γ (algebraMap Nr R a) = ψN a) ∧
        (∀ c, algebraMap Nr R (ι' c) = iB (f c)) ∧
        ∀ z : R, ∃ (n : ℕ) (mm : Fin n → Nr) (b : Fin n → B'),
          z = ∑ i, algebraMap Nr R (mm i) * iB (b i) := by
    intro Ng Nr B' P' _ _ _ _ ι' f ψN ψB hf hc
    letI : Algebra Ng Nr := ι'.toAlgebra
    letI : Algebra Ng B' := f.toAlgebra
    letI : Algebra Ng P' := (ψB.comp f).toAlgebra
    haveI : Algebra.Etale Ng B' := hf
    let ψN' : Nr →ₐ[Ng] P' := { ψN with commutes' := fun c => RingHom.congr_fun hc c }
    let ψB' : B' →ₐ[Ng] P' := { ψB with commutes' := fun c => rfl }
    have hal : ∀ a : Nr, algebraMap Nr (TensorProduct Ng Nr B') a = a ⊗ₜ (1 : B') := by
      intro a
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
    refine ⟨TensorProduct Ng Nr B', inferInstance, inferInstance,
      (Algebra.TensorProduct.includeRight).toRingHom,
      (Algebra.TensorProduct.productMap ψN' ψB').toRingHom,
      Algebra.Etale.baseChange _ _ _, ?_, ?_, ?_, ?_⟩
    · refine RingHom.ext fun b => ?_
      change Algebra.TensorProduct.productMap ψN' ψB' (1 ⊗ₜ b) = ψB b
      rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
      rfl
    · intro a
      change Algebra.TensorProduct.productMap ψN' ψB' (algebraMap _ _ _) = ψN a
      rw [hal, Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
      rfl
    · intro c
      change algebraMap _ _ _ = Algebra.TensorProduct.includeRight _
      rw [hal, Algebra.TensorProduct.includeRight_apply]
      exact Algebra.TensorProduct.tmul_one_eq_one_tmul c
    · intro z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨0, Fin.elim0, Fin.elim0, by simp⟩
      | tmul a b =>
        refine ⟨1, ![a], ![b], ?_⟩
        rw [Fin.sum_univ_one]
        change _ = algebraMap _ _ a * Algebra.TensorProduct.includeRight b
        rw [hal, Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.tmul_mul_tmul,
          mul_one, one_mul]
      | add x y hx hy =>
        obtain ⟨n1, a1, b1, h1⟩ := hx
        obtain ⟨n2, a2, b2, h2⟩ := hy
        refine ⟨n1 + n2, Fin.append a1 a2, Fin.append b1 b2, ?_⟩
        rw [Fin.sum_univ_add]
        simp only [Fin.append_left, Fin.append_right]
        rw [← h1, ← h2]
  obtain ⟨R, hR, hA, iB, γ, het, hγ, hγa, hι, hspan⟩ := gen _ _ B P ι f' φN φB hfet hcomp
  refine ⟨R, hR, hA, iB, γ, het, hγ, ?_, ?_, ?_, ?_, ?_, hspan⟩
  · exact (hγa _).trans hφ0
  · exact (hγa _).trans hφ1
  · intro w
    rw [← hιC w]
    exact hι _
  · rw [← map_pow, ← hι0]
    exact hι _
  · rw [← map_pow, ← hι1]
    exact hι _

theorem wcpa_dj_llsm_kpwm_cover_integral : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (r : ↥W) (ℓ : ℕ) (R B : Type u) [CommRing R] [CommRing B]
    (iN : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) →+* R) (iB : B →+* R) (wB : ↥W →+* B) (bu bv : B), 0 < ℓ →
    iN.comp ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r})).comp MvPolynomial.C) = iB.comp wB →
    iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W)) ^ ℓ = iB bu →
    iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) (MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W)) ^ ℓ = iB bv →
    (∀ z : R, ∃ (n : ℕ) (mm : Fin n → (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r})) (b : Fin n → B),
      z = ∑ i, iN (mm i) * iB (b i)) →
    ∀ z : R, ∃ p : Polynomial B, p.Monic ∧ p.eval₂ iB z = 0 :=
by
  intro Ω _ W r ℓ R B _ _ iN iB wB bu bv hℓ hC h0 h1 hspan
  letI : Algebra B R := iB.toAlgebra
  have hroot : ∀ (x : R) (c : B), x ^ ℓ = iB c → IsIntegral B x := by
    intro x c hx
    refine ⟨Polynomial.X ^ ℓ - Polynomial.C c, Polynomial.monic_X_pow_sub_C c hℓ.ne', ?_⟩
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
    show x ^ ℓ - iB c = 0
    rw [hx, sub_self]
  have hX : ∀ n : Fin 2, IsIntegral B
      (iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r})
        (MvPolynomial.X n : MvPolynomial (Fin 2) ↥W))) := by
    intro n
    fin_cases n
    · exact hroot _ bu h0
    · exact hroot _ bv h1
  have hP : ∀ P : MvPolynomial (Fin 2) ↥W, IsIntegral B
      (iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r})
        P)) := by
    intro P
    induction P using MvPolynomial.induction_on with
    | C a =>
      have e := RingHom.congr_fun hC a
      simp only [RingHom.comp_apply] at e
      rw [e]
      exact isIntegral_algebraMap (x := wB a)
    | add p q hp hq =>
      rw [map_add, map_add]
      exact hp.add hq
    | mul_X p n hp =>
      rw [map_mul, map_mul]
      exact hp.mul (hX n)
  have hall : ∀ m, IsIntegral B (iN m) := by
    intro m
    obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective m
    exact hP P
  intro z
  have hz : IsIntegral B z := by
    obtain ⟨n, mm, b, rfl⟩ := hspan z
    refine IsIntegral.sum _ (fun i _ => ?_)
    exact (hall (mm i)).mul (isIntegral_algebraMap (x := b i))
  obtain ⟨p, hpm, hpe⟩ := hz
  exact ⟨p, hpm, hpe⟩

theorem wcpa_dj_llsm_kpwm_local_identify : ∀ (A D : Type u) [CommRing A] [CommRing D] [IsDomain D]
    [Algebra A D] [Algebra.IsIntegral A D] (y : Ideal D) [y.IsPrime] (R : Type u) [CommRing R]
    (γ : R →+* Localization.AtPrime y) (Q : Ideal R) [Q.IsPrime] (A' : Type u) [CommRing A']
    [IsDomain A'] (j : A' →+* R) (jA : A →+* R),
    (∀ z : R, z ∈ Q ↔ γ z ∈ IsLocalRing.maximalIdeal (Localization.AtPrime y)) →
    Function.Injective (γ.comp j) →
    (∀ z : R, ∃ p : Polynomial A', p.Monic ∧ p.eval₂ j z = 0) →
    γ.comp jA = (algebraMap D (Localization.AtPrime y)).comp (algebraMap A D) →
    IsDomain (Localization.AtPrime Q) → IsIntegrallyClosed (Localization.AtPrime Q) →
    (∀ x : D, ∃ z s : R, γ s ≠ 0 ∧ γ s * algebraMap D (Localization.AtPrime y) x = γ z) →
    ∃ e : Localization.AtPrime Q ≃+* Localization.AtPrime y,
      ∀ z : R, e (algebraMap R (Localization.AtPrime Q) z) = γ z :=
by
  intro A D _ _ _ _ _ y _ R _ γ Q _ A' _ _ j jA hQ hinj hint hjA hdom hic hden
  classical
  haveI := hdom
  haveI := hic
  haveI hDy : IsDomain (Localization.AtPrime y) :=
    IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors y)
  have hunit : ∀ s : R, s ∉ Q → IsUnit (γ s) := fun s hs =>
    IsLocalRing.notMem_maximalIdeal.mp (fun h => hs ((hQ s).mpr h))
  have hM : ∀ s : Q.primeCompl, IsUnit (γ s) := fun s => hunit s s.2
  let γ' : Localization.AtPrime Q →+* Localization.AtPrime y :=
    IsLocalization.lift (M := Q.primeCompl) (S := Localization.AtPrime Q) hM
  have hγ' : ∀ z : R, γ' (algebraMap R (Localization.AtPrime Q) z) = γ z := fun z =>
    IsLocalization.lift_eq hM z
  have hmk : ∀ ρ : Localization.AtPrime Q, ∃ (z : R) (s : Q.primeCompl),
      ρ * algebraMap R (Localization.AtPrime Q) (s : R) = algebraMap R (Localization.AtPrime Q) z := by
    intro ρ
    obtain ⟨⟨z, s⟩, h⟩ := IsLocalization.surj Q.primeCompl ρ
    exact ⟨z, s, h⟩

  have hrefl : ∀ ρ : Localization.AtPrime Q, IsUnit (γ' ρ) → IsUnit ρ := by
    intro ρ hρ
    obtain ⟨z, s, hzs⟩ := hmk ρ
    have h1 : γ' ρ * γ s = γ z := by rw [← hγ' (s : R), ← hγ' z, ← map_mul, hzs]
    have h2 : IsUnit (γ z) := h1 ▸ hρ.mul (hM s)
    have h3 : z ∉ Q := fun hz => (IsLocalRing.notMem_maximalIdeal.mpr h2) ((hQ z).mp hz)
    have h4 : IsUnit (algebraMap R (Localization.AtPrime Q) z) :=
      (IsLocalization.AtPrime.isUnit_to_map_iff _ Q z).mpr h3
    rw [← hzs] at h4
    exact isUnit_of_mul_isUnit_left h4

  letI : Algebra A' R := j.toAlgebra
  have hinjγ' : Function.Injective γ' := by
    rw [injective_iff_map_eq_zero]
    intro ρ hρ
    by_contra hne
    obtain ⟨z, s, hzs⟩ := hmk ρ
    have hz0 : γ z = 0 := by rw [← hγ' z, ← hzs, map_mul, hρ, zero_mul]
    have hzne : algebraMap R (Localization.AtPrime Q) z ≠ 0 := by
      rw [← hzs]; exact mul_ne_zero hne (IsLocalization.map_units _ s).ne_zero
    obtain ⟨p, hpm, hp⟩ := hint z
    have halg : IsAlgebraic A' (algebraMap R (Localization.AtPrime Q) z) := by
      refine ⟨p, hpm.ne_zero, ?_⟩
      rw [Polynomial.aeval_algebraMap_apply, Polynomial.aeval_def]
      rw [show Polynomial.eval₂ (algebraMap A' R) z p = 0 from hp, map_zero]
    obtain ⟨r, hr0, c, hc⟩ := halg.exists_nonzero_dvd (mem_nonZeroDivisors_of_ne_zero hzne)
    have h1 : γ (j r) = 0 := by
      have h2 : algebraMap A' (Localization.AtPrime Q) r =
          algebraMap R (Localization.AtPrime Q) (j r) :=
        IsScalarTower.algebraMap_apply A' R (Localization.AtPrime Q) r
      rw [← hγ', ← h2, hc, map_mul, hγ', hz0, zero_mul]
    exact hr0 (hinj (by rw [RingHom.comp_apply, h1, RingHom.comp_apply, map_zero, map_zero]))

  have hcomp : γ'.comp ((algebraMap R (Localization.AtPrime Q)).comp jA) =
      (algebraMap D (Localization.AtPrime y)).comp (algebraMap A D) := by
    rw [← hjA]; ext a; simp only [RingHom.comp_apply, hγ']
  have hcrux : ∀ x : D, ∃ ρ, γ' ρ = algebraMap D (Localization.AtPrime y) x := by
    intro x
    obtain ⟨z, s, hs0, hsx⟩ := hden x
    have hσ : γ' (algebraMap R (Localization.AtPrime Q) s) = γ s := hγ' s
    have hζ : γ' (algebraMap R (Localization.AtPrime Q) z) = γ z := hγ' z
    obtain ⟨p, hpm, hp⟩ := Algebra.IsIntegral.isIntegral (R := A) x
    have hqm : (p.map ((algebraMap R (Localization.AtPrime Q)).comp jA)).Monic := hpm.map _
    have hpx := Polynomial.hom_eval₂ p (algebraMap A D) (algebraMap D (Localization.AtPrime y)) x
    rw [hp, map_zero] at hpx
    have hT : Polynomial.eval₂ (RingHom.id _) (algebraMap R (Localization.AtPrime Q) z)
        ((p.map ((algebraMap R (Localization.AtPrime Q)).comp jA)).scaleRoots
          (algebraMap R (Localization.AtPrime Q) s)) = 0 := by
      apply hinjγ'
      rw [map_zero, Polynomial.hom_eval₂, RingHom.comp_id, hζ, ← hsx, ← hσ,
        Polynomial.scaleRoots_eval₂_mul, Polynomial.eval₂_map, hcomp, ← hpx, mul_zero]
    have hσ0 : algebraMap R (Localization.AtPrime Q) s ≠ 0 := fun h => hs0 (by rw [← hσ, h, map_zero])
    have hfσ : algebraMap (Localization.AtPrime Q) (FractionRing (Localization.AtPrime Q))
        (algebraMap R (Localization.AtPrime Q) s) ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective _ _)).mpr hσ0
    set κ := algebraMap (Localization.AtPrime Q) (FractionRing (Localization.AtPrime Q))
        (algebraMap R (Localization.AtPrime Q) z) /
      algebraMap (Localization.AtPrime Q) (FractionRing (Localization.AtPrime Q))
        (algebraMap R (Localization.AtPrime Q) s) with hκdef
    have hκ : algebraMap (Localization.AtPrime Q) (FractionRing (Localization.AtPrime Q))
        (algebraMap R (Localization.AtPrime Q) s) * κ =
        algebraMap (Localization.AtPrime Q) (FractionRing (Localization.AtPrime Q))
        (algebraMap R (Localization.AtPrime Q) z) := by
      rw [hκdef]; field_simp
    have hκint : IsIntegral (Localization.AtPrime Q) κ := by
      refine ⟨_, hqm, ?_⟩
      have h1 := congrArg (algebraMap (Localization.AtPrime Q)
        (FractionRing (Localization.AtPrime Q))) hT
      rw [map_zero, Polynomial.hom_eval₂, RingHom.comp_id, ← hκ,
        Polynomial.scaleRoots_eval₂_mul] at h1
      exact (mul_eq_zero.mp h1).resolve_left (pow_ne_zero _ hfσ)
    obtain ⟨ρ, hρ⟩ := IsIntegrallyClosed.isIntegral_iff.mp hκint
    have hρσ : ρ * algebraMap R (Localization.AtPrime Q) s = algebraMap R (Localization.AtPrime Q) z :=
      IsFractionRing.injective (Localization.AtPrime Q) (FractionRing (Localization.AtPrime Q))
        (by rw [map_mul, hρ, mul_comm, hκ])
    refine ⟨ρ, ?_⟩
    have h2 : γ' ρ * γ' (algebraMap R (Localization.AtPrime Q) s) =
        algebraMap D (Localization.AtPrime y) x * γ' (algebraMap R (Localization.AtPrime Q) s) := by
      rw [← map_mul, hρσ, hζ, hσ, ← hsx, mul_comm]
    exact mul_right_cancel₀ (by rw [hσ]; exact hs0) h2

  have hsurj : Function.Surjective γ' := by
    intro w
    obtain ⟨⟨x, t⟩, hw⟩ := IsLocalization.surj y.primeCompl w
    dsimp only at hw
    obtain ⟨ρx, hρx⟩ := hcrux x
    obtain ⟨ρt, hρt⟩ := hcrux (t : D)
    have hut : IsUnit (γ' ρt) := by rw [hρt]; exact IsLocalization.map_units _ t
    obtain ⟨v, hv⟩ := (hrefl ρt hut).exists_right_inv
    refine ⟨ρx * v, ?_⟩
    have h1 : γ' ρt * γ' v = 1 := by rw [← map_mul, hv, map_one]
    rw [map_mul, hρx, ← hw, ← hρt, mul_assoc, h1, mul_one]
  exact ⟨RingEquiv.ofBijective γ' ⟨hinjγ', hsurj⟩, fun z => hγ' z⟩

theorem wcpa_dj_llsm_kpwm_node_ideal : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (r : ↥W) (ℓ : ℕ) (R B : Type u) [CommRing R] [CommRing B] [Algebra ↥W R]
    (iN : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) →+* R) (iB : B →+* R) (wB : ↥W →+* B) (bu bv ε : B) (Q : Ideal R), 0 < ℓ →
    iN.comp ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r})).comp MvPolynomial.C) = algebraMap ↥W R →
    iB.comp wB = algebraMap ↥W R →
    (∀ z : R, ∃ (n : ℕ) (mm : Fin n → (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r})) (b : Fin n → B),
      z = ∑ i, iN (mm i) * iB (b i)) →
    IsUnit ε →
    iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W)) ^ ℓ = iB (bu * ε) →
    iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) (MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W)) ^ ℓ * iB ε = iB bv →
    iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W)) ∈ Q →
    iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) (MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W)) ∈ Q →
    (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R) ≤ Q →
    Q.comap iB ≤ Ideal.span {bu, bv} ⊔ (IsLocalRing.maximalIdeal ↥W).map wB →
    Q = Ideal.span {iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W)),
        iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) (MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W))} ⊔
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R) :=
by
  intro Ω _ W r ℓ R B _ _ _ iN iB wB bu bv ε Q hℓ hN hB hspan hε h0 h1 hx0 hx1 hmQ hcomap
  set x0 := iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W)) with hx0def
  set x1 := iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) (MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W)) with hx1def
  set S : Ideal R := Ideal.span {x0, x1} with hS
  set mR : Ideal R := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R) with hmR
  have hxS0 : x0 ∈ S := Ideal.subset_span (Set.mem_insert _ _)
  have hxS1 : x1 ∈ S := Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  have hNc : ∀ a : ↥W, iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) (MvPolynomial.C a)) = algebraMap ↥W R a :=
    fun a => RingHom.congr_fun hN a
  have hBc : ∀ a : ↥W, iB (wB a) = algebraMap ↥W R a := fun a => RingHom.congr_fun hB a
  have hX : ∀ n : Fin 2, iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) (MvPolynomial.X n)) ∈ S :=
    Fin.forall_fin_two.mpr ⟨hxS0, hxS1⟩

  have key : ∀ P : MvPolynomial (Fin 2) ↥W,
      iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) P) - algebraMap ↥W R (MvPolynomial.constantCoeff P) ∈ S := by
    intro P
    induction P using MvPolynomial.induction_on with
    | C a =>
      rw [MvPolynomial.constantCoeff_C, hNc, sub_self]
      exact S.zero_mem
    | add p q hp hq =>
      have := S.add_mem hp hq
      rw [map_add, map_add, map_add, map_add]
      convert this using 1
      ring
    | mul_X p n hp =>
      have hcc : MvPolynomial.constantCoeff (p * MvPolynomial.X n) = 0 := by
        rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero]
      rw [hcc, map_zero, sub_zero, map_mul, map_mul]
      exact S.mul_mem_left _ (hX n)
  have hsplit : ∀ m : MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}, ∃ c : ↥W, iN m - algebraMap ↥W R c ∈ S := by
    intro m
    obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective m
    exact ⟨_, key P⟩
  have hIQ : S ⊔ mR ≤ Q := by
    refine sup_le (Ideal.span_le.mpr ?_) hmQ
    rintro x (rfl | rfl)
    · exact hx0
    · exact hx1
  have hbu : iB bu ∈ S := by
    obtain ⟨e, he⟩ := hε
    have : iB bu = x0 ^ ℓ * iB (↑e⁻¹ : B) := by
      rw [h0, ← map_mul, ← he, mul_assoc, Units.mul_inv, mul_one]
    rw [this]
    exact S.mul_mem_right _ (S.pow_mem_of_mem hxS0 ℓ hℓ)
  have hbv : iB bv ∈ S := by
    rw [← h1]
    exact S.mul_mem_right _ (S.pow_mem_of_mem hxS1 ℓ hℓ)
  refine le_antisymm ?_ hIQ
  intro z hz
  obtain ⟨n, mm, b, rfl⟩ := hspan z
  choose c hc using fun i => hsplit (mm i)
  have hdiff : (∑ i, iN (mm i) * iB (b i)) - iB (∑ i, wB (c i) * b i) ∈ S := by
    have : (∑ i, iN (mm i) * iB (b i)) - iB (∑ i, wB (c i) * b i) =
        ∑ i, (iN (mm i) - algebraMap ↥W R (c i)) * iB (b i) := by
      rw [map_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, sub_mul, hBc]
    rw [this]
    exact Ideal.sum_mem _ (fun i _ => S.mul_mem_right _ (hc i))
  have hdQ : (∑ i, iN (mm i) * iB (b i)) - iB (∑ i, wB (c i) * b i) ∈ Q :=
    hIQ (Ideal.mem_sup_left hdiff)
  have hb0Q : iB (∑ i, wB (c i) * b i) ∈ Q := by
    have := Q.sub_mem hz hdQ
    rwa [sub_sub_cancel] at this
  have hb0' : (∑ i, wB (c i) * b i) ∈
      Ideal.span {bu, bv} ⊔ (IsLocalRing.maximalIdeal ↥W).map wB :=
    hcomap (Ideal.mem_comap.mpr hb0Q)
  have hmap : iB (∑ i, wB (c i) * b i) ∈ S ⊔ mR := by
    have h2 : (Ideal.span {bu, bv} ⊔ (IsLocalRing.maximalIdeal ↥W).map wB).map iB ≤ S ⊔ mR := by
      rw [Ideal.map_sup, Ideal.map_span, Ideal.map_map, hB]
      refine sup_le_sup_right (Ideal.span_le.mpr ?_) _
      rintro x ⟨y, hy, rfl⟩
      rcases hy with rfl | rfl
      · exact hbu
      · exact hbv
    exact h2 (Ideal.mem_map_of_mem _ hb0')
  have := (S ⊔ mR).add_mem (Ideal.mem_sup_left hdiff) hmap
  rwa [sub_add_cancel] at this

theorem wcpa_dj_llsm_kpwm_kummer_denominators : ∀ (A : Type u) [CommRing A] [IsDomain A]
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L]
    [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] (ℓ : ℕ), ℓ.Prime →
    Module.finrank K L = ℓ → ∀ θ : L, θ ∉ Set.range (algebraMap K L) → ∀ x : L,
    ∃ (n : ℕ) (b : A) (a : ℕ → A), b ≠ 0 ∧
      algebraMap A L b * x = ∑ i ∈ Finset.range n, algebraMap A L (a i) * θ ^ i :=
by
  intro A _ _ K _ _ _ L _ _ _ _ _ ℓ hℓ hfin θ hθK x
  classical
  have hθ : IsIntegral K θ := IsIntegral.of_finite K θ
  have hdvd : (minpoly K θ).natDegree ∣ ℓ := hfin ▸ minpoly.degree_dvd hθ
  have hadj : Module.finrank K (IntermediateField.adjoin K {θ}) = (minpoly K θ).natDegree :=
    IntermediateField.adjoin.finrank hθ
  have hd : (minpoly K θ).natDegree = ℓ := by
    rcases hℓ.eq_one_or_self_of_dvd _ hdvd with h | h
    · exfalso
      apply hθK
      have h1 : IntermediateField.adjoin K {θ} = ⊥ :=
        IntermediateField.finrank_eq_one_iff.mp (hadj.trans h)
      exact IntermediateField.mem_bot.mp (IntermediateField.adjoin_simple_eq_bot_iff.mp h1)
    · exact h
  have htop : IntermediateField.adjoin K {θ} = ⊤ := by
    apply IntermediateField.eq_of_le_of_finrank_eq le_top
    rw [IntermediateField.finrank_top', hadj, hd, hfin]
  have hx : x ∈ IntermediateField.adjoin K {θ} := htop ▸ IntermediateField.mem_top
  obtain ⟨f, -, hf⟩ := (IntermediateField.adjoin.powerBasis hθ).exists_eq_aeval ⟨x, hx⟩
  have hxf : x = Polynomial.aeval θ f := by
    have := congrArg (algebraMap (IntermediateField.adjoin K {θ}) L) hf
    rw [IntermediateField.adjoin.powerBasis_gen, ← Polynomial.aeval_algebraMap_apply,
      IntermediateField.AdjoinSimple.algebraMap_gen] at this
    exact this
  obtain ⟨b, hb, hbf⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors A) f
  set f₀ := IsLocalization.integerNormalization (nonZeroDivisors A) f with hf₀
  refine ⟨f₀.natDegree + 1, b, fun i => f₀.coeff i, nonZeroDivisors.ne_zero hb, ?_⟩
  have hsm : b • f = Polynomial.C (algebraMap A K b) * f := by
    rw [← Polynomial.smul_eq_C_mul, algebraMap_smul]
  have h1 : Polynomial.aeval θ f₀ = algebraMap A L b * x := by
    rw [← Polynomial.aeval_map_algebraMap K θ f₀, hbf, hsm, map_mul, Polynomial.aeval_C,
      ← IsScalarTower.algebraMap_apply, ← hxf]
  rw [← h1, Polynomial.aeval_eq_sum_range]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [Algebra.smul_def]

theorem wcpa_dj_llsm_kpwm_etale_node_not_bad : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (r : ↥W) (R : Type u) [CommRing R] [Algebra (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r} : Set (MvPolynomial (Fin 2) ↥W))) R]
    [Algebra ↥W R] (Q : Ideal R) [Q.IsPrime], r ∈ IsLocalRing.maximalIdeal ↥W →
    Algebra.Etale (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r} : Set (MvPolynomial (Fin 2) ↥W))) R →
    (∀ w : ↥W, algebraMap ↥W R w = (algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) R : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) →+* R) (Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r} : Set (MvPolynomial (Fin 2) ↥W))) (MvPolynomial.C w))) →
    Q = Ideal.span {(algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) R : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) →+* R) (Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r} : Set (MvPolynomial (Fin 2) ↥W))) (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W)),
        (algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) R : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) →+* R) (Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r} : Set (MvPolynomial (Fin 2) ↥W))) (MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W))} ⊔
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R) →
    ¬ wcpaDjLkBad (Localization.AtPrime Q ⧸ ((IsLocalRing.maximalIdeal ↥W).map
      (algebraMap ↥W R)).map (algebraMap R (Localization.AtPrime Q))) :=
by
  intro Ω _ W r R _ _ _ Q _ hr het hW hQ
  have h1Q : (1 : R) ∉ Q := fun h => (Ideal.IsPrime.ne_top ‹Q.IsPrime›)
    (Ideal.eq_top_of_isUnit_mem Q h isUnit_one)
  have hmQ : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R) ≤ Q := by
    rw [hQ]; exact le_sup_right
  let iN : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C r}) →+* R :=
    (algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C r}) R : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 *
      MvPolynomial.X 1 - MvPolynomial.C r}) →+* R)
  have hf2 : RingHom.Etale (algebraMap R (Localization.Away (1 : R))) :=
    RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway (1 : R))
  have hf := RingHom.Etale.stableUnderComposition _ _ (RingHom.etale_algebraMap.mpr het) hf2
  refine wcpa_dj_llsm_brsp_node_not_bad W R Q r
    (iN (Ideal.Quotient.mk _ (MvPolynomial.X 0)))
    (iN (Ideal.Quotient.mk _ (MvPolynomial.X 1)))
    (1 : R) hr h1Q hmQ
    ((algebraMap R (Localization.Away (1 : R))).comp iN)
    (RingHom.ext fun w => by
      simp only [RingHom.comp_apply]
      rw [hW w])
    rfl rfl ?_
    (by rw [hQ, Ideal.map_sup, Ideal.map_span, Set.image_pair])
  exact hf

theorem wcpa_dj_llsm_kpwm_fs_transport : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [Algebra ↥W A] (L : Type u) [Field L] [Algebra A L]
    (y : Ideal ↥(integralClosure A L)) [y.IsPrime] (R : Type u) [CommRing R] [Algebra ↥W R]
    (Q : Ideal R) [Q.IsPrime] (e : Localization.AtPrime Q ≃+* Localization.AtPrime y)
    (γ : R →+* Localization.AtPrime y),
    (∀ z : R, e (algebraMap R (Localization.AtPrime Q) z) = γ z) →
    γ.comp (algebraMap ↥W R) = (algebraMap ↥(integralClosure A L) (Localization.AtPrime y)).comp
      ((algebraMap A ↥(integralClosure A L)).comp (algebraMap ↥W A)) →
    ¬ wcpaDjLkBad (Localization.AtPrime Q ⧸ ((IsLocalRing.maximalIdeal ↥W).map
      (algebraMap ↥W R)).map (algebraMap R (Localization.AtPrime Q))) →
    ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) :=
by
  intro Ω _ W A _ _ L _ _ y _ R _ _ Q _ e γ he hF5 hnb
  set μ : ↥W →+* ↥(integralClosure A L) :=
    (algebraMap A ↥(integralClosure A L)).comp (algebraMap ↥W A) with hμ
  have s1 : ∀ w : ↥W, ((μ w : ↥(integralClosure A L)) : L) =
      ((algebraMap A L).comp (algebraMap ↥W A)) w := fun w => rfl
  have s2 : Ideal.span {b : ↥(integralClosure A L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w} =
      (IsLocalRing.maximalIdeal ↥W).map μ := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro b ⟨w, hw, hb⟩
      have hbw : b = μ w := Subtype.ext (hb.trans (s1 w).symm)
      rw [hbw]
      exact Ideal.mem_map_of_mem μ hw
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap]
      exact Ideal.subset_span ⟨w, hw, s1 w⟩
  have hγ : γ = (e : Localization.AtPrime Q →+* Localization.AtPrime y).comp
      (algebraMap R (Localization.AtPrime Q)) :=
    RingHom.ext fun z => (he z).symm
  have s3 : (Ideal.span {b : ↥(integralClosure A L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w}).map
      (algebraMap ↥(integralClosure A L) (Localization.AtPrime y)) =
      Ideal.map (e : Localization.AtPrime Q →+* Localization.AtPrime y)
        (((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R)).map
          (algebraMap R (Localization.AtPrime Q))) := by
    rw [s2, Ideal.map_map, ← hF5, hγ, Ideal.map_map, Ideal.map_map]
  let E : (Localization.AtPrime Q ⧸ ((IsLocalRing.maximalIdeal ↥W).map
      (algebraMap ↥W R)).map (algebraMap R (Localization.AtPrime Q))) ≃+*
      wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y :=
    Ideal.quotientEquiv _ _ e s3
  have hRE : ∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) →
      wcpaDjLkDelta R = wcpaDjLkDelta S ∧ wcpaDjLkBranches R = wcpaDjLkBranches S := by
    intro R S _ _ e
    classical
    let eF : FractionRing R ≃+* FractionRing S := IsFractionRing.ringEquivOfRingEquiv e
    have H1 : ∀ r : R, eF (algebraMap R (FractionRing R) r) = algebraMap S (FractionRing S) (e r) :=
      fun r => IsFractionRing.ringEquivOfRingEquiv_algebraMap e r
    have H2 : ∀ s : S, eF.symm (algebraMap S (FractionRing S) s) =
        algebraMap R (FractionRing R) (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, H1, RingEquiv.apply_symm_apply]
    have C1 : (algebraMap S (FractionRing S)).comp (e : R →+* S) =
        (eF : FractionRing R →+* FractionRing S).comp (algebraMap R (FractionRing R)) := by
      ext r
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H1 r).symm
    have C2 : (algebraMap R (FractionRing R)).comp (e.symm : S →+* R) =
        (eF.symm : FractionRing S →+* FractionRing R).comp (algebraMap S (FractionRing S)) := by
      ext s
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H2 s).symm
    have I1 : ∀ x : FractionRing R, _root_.IsIntegral R x → _root_.IsIntegral S (eF x) :=
      fun x hx => hx.map_of_comp_eq (e : R →+* S) (eF : FractionRing R →+* FractionRing S) C1
    have I2 : ∀ y : FractionRing S, _root_.IsIntegral S y → _root_.IsIntegral R (eF.symm y) :=
      fun y hy =>
        hy.map_of_comp_eq (e.symm : S →+* R) (eF.symm : FractionRing S →+* FractionRing R) C2
    let eI : ↥(integralClosure R (FractionRing R)) ≃+* ↥(integralClosure S (FractionRing S)) :=
      { toFun := fun x => ⟨eF x, I1 x x.2⟩
        invFun := fun y => ⟨eF.symm y, I2 y y.2⟩
        left_inv := fun x => Subtype.ext (eF.symm_apply_apply x)
        right_inv := fun y => Subtype.ext (eF.apply_symm_apply y)
        map_mul' := fun x y => Subtype.ext (map_mul eF (x : FractionRing R) y)
        map_add' := fun x y => Subtype.ext (map_add eF (x : FractionRing R) y) }
    have heI : ∀ r : R, eI (algebraMap R _ r) = algebraMap S _ (e r) :=
      fun r => Subtype.ext (H1 r)
    have heI' : ∀ s : S, eI.symm (algebraMap S _ s) = algebraMap R _ (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, heI, RingEquiv.apply_symm_apply]
    constructor
    · letI : RingHomInvPair (e : R →+* S) (e.symm : S →+* R) := RingHomInvPair.of_ringEquiv e
      letI : RingHomInvPair (e.symm : S →+* R) (e : R →+* S) := RingHomInvPair.symm _ _
      let LeI : ↥(integralClosure R (FractionRing R)) →ₛₗ[(e : R →+* S)]
          ↥(integralClosure S (FractionRing S)) :=
        { toFun := eI
          map_add' := map_add eI
          map_smul' := fun r a => by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI]
            rfl }
      let LeI' : ↥(integralClosure S (FractionRing S)) →ₛₗ[(e.symm : S →+* R)]
          ↥(integralClosure R (FractionRing R)) :=
        { toFun := eI.symm
          map_add' := map_add eI.symm
          map_smul' := fun s b => by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI']
            rfl }
      let p := LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))
      let q := LinearMap.range (Algebra.linearMap S ↥(integralClosure S (FractionRing S)))
      have h1 : p ≤ q.comap LeI := by
        rintro _ ⟨r, rfl⟩
        exact ⟨e r, (heI r).symm⟩
      have h2 : q ≤ p.comap LeI' := by
        rintro _ ⟨s, rfl⟩
        exact ⟨e.symm s, (heI' s).symm⟩
      let Φ := p.mapQ q LeI h1
      let Φ' := q.mapQ p LeI' h2
      let Φe : (↥(integralClosure R (FractionRing R)) ⧸ p) ≃ₛₗ[(e : R →+* S)]
          (↥(integralClosure S (FractionRing S)) ⧸ q) :=
        { Φ with
          invFun := Φ'
          left_inv := fun x => by
            induction x using Submodule.Quotient.induction_on with
            | H a =>
              show Φ' (Φ (Submodule.Quotient.mk a)) = Submodule.Quotient.mk a
              rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
              exact congrArg _ (eI.symm_apply_apply a)
          right_inv := fun x => by
            induction x using Submodule.Quotient.induction_on with
            | H b =>
              show Φ (Φ' (Submodule.Quotient.mk b)) = Submodule.Quotient.mk b
              rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
              exact congrArg _ (eI.apply_symm_apply b) }
      let O := Submodule.orderIsoMapComap Φe
      unfold wcpaDjLkDelta
      rw [Module.length_eq_height, Module.length_eq_height, ← Order.height_orderIso O ⊤,
        OrderIso.map_top]
    · unfold wcpaDjLkBranches
      apply ENat.card_congr
      exact
        { toFun := fun M => ⟨M.asIdeal.comap (eI.symm : _ →+* _), by
            haveI := M.isMaximal
            exact Ideal.comap_isMaximal_of_surjective _ eI.symm.surjective⟩
          invFun := fun N => ⟨N.asIdeal.comap (eI : _ →+* _), by
            haveI := N.isMaximal
            exact Ideal.comap_isMaximal_of_surjective _ eI.surjective⟩
          left_inv := fun M => by
            ext x
            show eI.symm (eI x) ∈ M.asIdeal ↔ x ∈ M.asIdeal
            rw [RingEquiv.symm_apply_apply]
          right_inv := fun N => by
            ext x
            show eI (eI.symm x) ∈ N.asIdeal ↔ x ∈ N.asIdeal
            rw [RingEquiv.apply_symm_apply] }
  obtain ⟨hδ, hbr⟩ := hRE _ _ E
  intro hbad
  apply hnb
  show ¬ (_ ∨ (_ ∧ _))
  rw [hδ, hbr]
  exact hbad

theorem wcpa_dj_llsm_kpwm_cover_point : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g : ↥W) (ℓ : ℕ), ℓ.Prime →
    wcLlsPD W A 𝔭 (.ann u v g) → Module.finrank K L = ℓ →
    ∀ (θ : L) (ε : A), θ ∉ Set.range (algebraMap K L) → θ ^ ℓ = algebraMap A L (u * ε) → ε ∉ 𝔭 →
    ∀ h' : A, h' ∉ 𝔭 → IsUnit (algebraMap A (Localization.Away h') ε) →
    ∀ f' : (MvPolynomial (Fin 2) ↥W ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+*
          Localization.Away h',
    f'.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
      (algebraMap A (Localization.Away h')).comp (algebraMap ↥W A) →
    f' (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = algebraMap A (Localization.Away h') (u * ε) →
    f' (Ideal.Quotient.mk _ (MvPolynomial.X 1)) * algebraMap A (Localization.Away h') ε =
      algebraMap A (Localization.Away h') v →
    RingHom.Etale (R := MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
      (S := Localization.Away h') f' →
    ∀ r : ↥W, r ^ ℓ = g → r ≠ 0 →
    ∀ y : Ideal ↥(integralClosure A L),
      y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → ∀ (_ : y.IsPrime),
      ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) :=
by
  intro Ω _ W A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g ℓ hℓ hPD hfr θ ε hθK hθℓ hε𝔭 h' hh' hεu f'
    hfTC hfT0 hfT1 hfTet r hr hr0 y hy hyP
  classical
  haveI := hyP

  obtain ⟨-, -, -, hmax, hm𝔭, hgm, hg0, huv, h𝔭eq, -⟩ := id hPD
  haveI h𝔭P : 𝔭.IsPrime := hmax.isPrime
  have hu𝔭 : u ∈ 𝔭 := by
    rw [h𝔭eq]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hv𝔭 : v ∈ 𝔭 := by
    rw [h𝔭eq]
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
  have hℓ0 : 0 < ℓ := hℓ.pos
  have hrm : r ∈ IsLocalRing.maximalIdeal ↥W :=
    (IsLocalRing.maximalIdeal.isMaximal ↥W).isPrime.mem_of_pow_mem ℓ (by rw [hr]; exact hgm)
  have hθ0 : θ ≠ 0 := fun h => hθK ⟨0, by rw [h, map_zero]⟩
  have hh'0 : h' ≠ 0 := fun h => hh' (h ▸ 𝔭.zero_mem)

  obtain ⟨κ, hκ⟩ : ∃ κ : A →+* Localization.AtPrime y,
      κ = (algebraMap ↥(integralClosure A L) (Localization.AtPrime y)).comp
        (algebraMap A ↥(integralClosure A L)) := ⟨_, rfl⟩
  have hκapp : ∀ a : A, κ a = algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
      (algebraMap A ↥(integralClosure A L) a) := fun a => by rw [hκ]; rfl
  have hF1 : ∀ a : A, κ a ∈ IsLocalRing.maximalIdeal (Localization.AtPrime y) ↔ a ∈ 𝔭 := by
    intro a
    rw [hκapp, IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime y) y,
      ← Ideal.mem_comap, hy]
  have hιinj : Function.Injective (algebraMap A ↥(integralClosure A L)) := by
    intro a b hab
    have h1 : algebraMap A L a = algebraMap A L b := congrArg Subtype.val hab
    rw [IsScalarTower.algebraMap_apply A K L a, IsScalarTower.algebraMap_apply A K L b] at h1
    exact IsFractionRing.injective A K ((algebraMap K L).injective h1)
  have hlocinj : Function.Injective
      (algebraMap ↥(integralClosure A L) (Localization.AtPrime y)) :=
    IsLocalization.injective (Localization.AtPrime y) (Ideal.primeCompl_le_nonZeroDivisors y)
  have hκinj : Function.Injective κ := by
    intro a b hab
    rw [hκapp, hκapp] at hab
    exact hιinj (hlocinj hab)
  have hunit : ∀ a : A, a ∉ 𝔭 → IsUnit (κ a) := fun a ha =>
    IsLocalRing.notMem_maximalIdeal.mp (fun h => ha ((hF1 a).mp h))

  obtain ⟨t, x1, ht, hty, hx1, hprod, hp0, hp1⟩ :=
    wcpa_dj_llsm_kpwm_kummer_points W A L 𝔭 u v ε g r ℓ θ y hℓ0 hθ0 hu𝔭 hv𝔭 hε𝔭 huv hr hθℓ hy
  have hx0 : algebraMap ↥(integralClosure A L) (Localization.AtPrime y) t ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime y) :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime y) y t).mpr hty

  obtain ⟨φB, hφBdef⟩ : ∃ φ : Localization.Away h' →+* Localization.AtPrime y,
      φ = IsLocalization.Away.lift (S := Localization.Away h') h' (hunit h' hh') := ⟨_, rfl⟩
  have hφB : ∀ a : A, φB (algebraMap A (Localization.Away h') a) = κ a := by
    intro a; rw [hφBdef]; exact IsLocalization.Away.lift_eq h' _ a
  have e1 : algebraMap ↥(integralClosure A L) (Localization.AtPrime y) t * x1 =
      φB (f' (((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C g})).comp MvPolynomial.C) r)) := by
    have h1 : f' (((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C g})).comp MvPolynomial.C) r) =
        algebraMap A (Localization.Away h') (algebraMap ↥W A r) := RingHom.congr_fun hfTC r
    rw [h1, hφB, hκapp]; exact hprod
  have e2 : algebraMap ↥(integralClosure A L) (Localization.AtPrime y) t ^ ℓ =
      φB (f' (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C g}) (MvPolynomial.X 0))) := by
    rw [hfT0, hφB, hκapp]; exact hp0
  have e3 : x1 ^ ℓ = φB (f' (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C g}) (MvPolynomial.X 1))) := by
    have h2 : φB (f' (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C g}) (MvPolynomial.X 1))) * κ ε = κ v := by
      rw [← hφB ε, ← map_mul, hfT1, hφB]
    have h3 : x1 ^ ℓ * κ ε = κ v := by rw [hκapp, hκapp]; exact hp1
    exact (hunit ε hε𝔭).mul_right_cancel (h3.trans h2.symm)

  obtain ⟨R, iR, iRA, iB, γ, het, hγB, hγ0, hγ1, hC, hX0p, hX1p, hspan⟩ :=
    wcpa_dj_llsm_kpwm_pushout_chart W g r ℓ (Localization.Away h') (Localization.AtPrime y) f' φB
      (algebraMap ↥(integralClosure A L) (Localization.AtPrime y) t) x1 hr hfTet e1 e2 e3
  letI := iR
  letI := iRA
  set iN : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C r}) →+* R :=
    (algebraMap (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C r}) R : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 *
      MvPolynomial.X 1 - MvPolynomial.C r}) →+* R) with hiN
  letI iWR : Algebra ↥W R :=
    (iN.comp ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C r})).comp MvPolynomial.C)).toAlgebra
  have hWR : ∀ w : ↥W, algebraMap ↥W R w =
      iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C r}) (MvPolynomial.C w)) := fun w => rfl
  have hγiB : ∀ b, γ (iB b) = φB b := fun b => by rw [← hγB]; rfl
  have hCpt : ∀ w : ↥W, iN (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C r}) (MvPolynomial.C w)) =
