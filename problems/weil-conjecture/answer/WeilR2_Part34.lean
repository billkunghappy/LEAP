    have hΛmC : ∀ z ∈ (IsLocalRing.maximalIdeal ↥W).map
        ((AdjoinRoot.of FP).comp (ψ.comp Polynomial.C)), Λ z = 0 := by
      intro z hz
      have hle : (IsLocalRing.maximalIdeal ↥W).map
          ((AdjoinRoot.of FP).comp (ψ.comp Polynomial.C)) ≤ RingHom.ker Λ := by
