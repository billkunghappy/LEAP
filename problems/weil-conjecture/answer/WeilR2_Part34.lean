    ha'0 hbm hb0 ⟨e, he⟩ hnba hbg hAo hIs
  obtain ⟨hDodom, hDodvr⟩ := hdvro Qo 𝔷o hQoN h𝔷oQ h𝔷om hstro.1 hstro.2
  obtain ⟨hDIdom, hDIdvr⟩ := hdvrI QI 𝔷I hQIN h𝔷IQ h𝔷Im hstrI.1 hstrI.2
  haveI := hDodom
