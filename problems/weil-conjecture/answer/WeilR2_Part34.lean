        (IsScalarTower.toAlgHom R E (Localization.Away g)), fun y => ?_⟩
      have h1 := congrArg (fun φ => φ (e.symm (algebraMap E (Localization.Away g) y))) hcomp
      simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, AlgEquiv.apply_symm_apply,
        Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at h1
      rw [AlgHom.comp_apply, AlgHom.comp_apply, IsScalarTower.coe_toAlgHom',
        AlgEquiv.coe_toAlgHom, h1, hσg_apply]

    have hker : ∀ (R : Type u) [CommRing R] (E : Type u) [CommRing E] [Algebra R E]
        [Algebra.FormallyUnramified R E]
        [Algebra.FinitePresentation R E] (τ : E →ₐ[R] R),
        ∃ e : E, IsIdempotentElem e ∧ RingHom.ker τ = Ideal.span {e} := by
      intro R _ E _ _ _ _ τ
      have hsurj : Function.Surjective τ := fun r => ⟨algebraMap R E r, by simp⟩
      have hFG : (RingHom.ker τ).FG := by
        have := Algebra.FinitePresentation.ker_fG_of_surjective τ hsurj
        exact this
      have hsplit : ∀ x : E, x - algebraMap R E (τ x) ∈ RingHom.ker τ := by
        intro x
        rw [RingHom.mem_ker, map_sub, AlgHom.commutes]
        simp
      have hKK : RingHom.ker τ ≤ RingHom.ker τ ^ 2 := by
        have hN2 : IsNilpotent ((RingHom.ker τ).map (Ideal.Quotient.mk (RingHom.ker τ ^ 2))) := by
          refine ⟨2, ?_⟩
          rw [← Ideal.map_pow, Ideal.map_quotient_self]
          rfl
        let g₁ : E →ₐ[R] E ⧸ RingHom.ker τ ^ 2 := Ideal.Quotient.mkₐ R (RingHom.ker τ ^ 2)
        let g₂ : E →ₐ[R] E ⧸ RingHom.ker τ ^ 2 := (Algebra.ofId R (E ⧸ RingHom.ker τ ^ 2)).comp τ
        have hg : g₁ = g₂ := by
          apply Algebra.FormallyUnramified.ext _ hN2
          intro x
          rw [Ideal.Quotient.eq]
          have : g₁ x - g₂ x = Ideal.Quotient.mk (RingHom.ker τ ^ 2) (x - algebraMap R E (τ x)) := by
            show Ideal.Quotient.mkₐ R (RingHom.ker τ ^ 2) x -
              (Algebra.ofId R (E ⧸ RingHom.ker τ ^ 2)) (τ x) = _
            rw [map_sub, Ideal.Quotient.mk_algebraMap, Ideal.Quotient.mkₐ_eq_mk, Algebra.ofId_apply]
          rw [this]
          exact Ideal.mem_map_of_mem _ (hsplit x)
        intro x hx
        have h1 := congrArg (fun φ => φ x) hg
        simp only [g₁, g₂, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, Algebra.ofId_apply] at h1
        rw [RingHom.mem_ker.mp hx, map_zero] at h1
        exact Ideal.Quotient.eq_zero_iff_mem.mp h1
      have hidem : IsIdempotentElem (RingHom.ker τ) := by
        show RingHom.ker τ * RingHom.ker τ = RingHom.ker τ
        apply le_antisymm Ideal.mul_le_right
        rw [← pow_two]
        exact hKK
      obtain ⟨e, he, hKe⟩ := (Ideal.isIdempotentElem_iff_of_fg _ hFG).mp hidem
      exact ⟨e, he, hKe⟩

    have hstep : ∀ (R : Type u) [CommRing R] [HenselianLocalRing R] (B : Type u) [CommRing B]
        (φ : Polynomial R →+* B), φ.Etale → ∀ (c : R) (Q : Ideal B), Q.IsPrime →
        Q.comap (φ.comp Polynomial.C) = IsLocalRing.maximalIdeal R →
        φ Polynomial.X - φ (Polynomial.C c) ∈ Q → (∀ b : B, ∃ r : R, b - φ (Polynomial.C r) ∈ Q) →
        ∀ b : B, ∃ (r : R) (s b' : B), s ∉ Q ∧
          s * (b - φ (Polynomial.C r)) = (φ Polynomial.X - φ (Polynomial.C c)) * b' := by
      intro R _ _ B _ φ hφ c Q hQP hQ hx₀ hresB b
      letI : Algebra R B := (φ.comp Polynomial.C).toAlgebra
      set x₀ : B := φ Polynomial.X - φ (Polynomial.C c) with hx₀def
      have hquot : Algebra.Etale R (B ⧸ Ideal.span {x₀}) := by
        letI : Algebra (Polynomial R) B := φ.toAlgebra
        haveI hPB : Algebra.Etale (Polynomial R) B := RingHom.etale_algebraMap.mp hφ
        haveI : IsScalarTower R (Polynomial R) B := IsScalarTower.of_algebraMap_eq
          (fun r => by rw [Polynomial.algebraMap_eq]; rfl)
        have hXB : algebraMap (Polynomial R) B (Polynomial.X - Polynomial.C c) = x₀ := by
          rw [map_sub]; rfl
        haveI : Algebra.FinitePresentation R (Polynomial R) :=
          Algebra.FinitePresentation.polynomial R R
        haveI : Algebra.FinitePresentation R B :=
          Algebra.FinitePresentation.trans R (Polynomial R) B
        haveI : Algebra.FinitePresentation R (B ⧸ Ideal.span {x₀}) :=
          Algebra.FinitePresentation.quotient (Submodule.fg_span (Set.toFinite _))
        have hmk : Ideal.Quotient.mk (Ideal.span {x₀}) x₀ = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
        have upgrade : ∀ (T : Type u) [CommRing T] [Algebra R T] [Algebra (Polynomial R) T]
            [IsScalarTower R (Polynomial R) T],
            algebraMap (Polynomial R) T Polynomial.X = algebraMap R T c →
            ∀ ψ : B →ₐ[R] T, ψ x₀ = 0 →
            ∃ ψ' : B →ₐ[Polynomial R] T, ∀ b, ψ' b = ψ b := by
          intro T _ _ _ _ hT ψ h1
          have hψX : ψ (φ Polynomial.X) = algebraMap R T c := by
            have e1 : φ Polynomial.X = x₀ + algebraMap R B c := by
              rw [hx₀def]; exact (sub_add_cancel _ _).symm
            rw [e1, map_add, h1, zero_add, AlgHom.commutes]
          have hc : ψ.comp (IsScalarTower.toAlgHom R (Polynomial R) B) =
              IsScalarTower.toAlgHom R (Polynomial R) T := by
            apply Polynomial.algHom_ext
            rw [AlgHom.comp_apply, IsScalarTower.coe_toAlgHom', IsScalarTower.coe_toAlgHom', hT]
            exact hψX
          exact ⟨{ toRingHom := (ψ : B →+* T), commutes' := fun p => congrArg (fun f => f p) hc },
            fun b => rfl⟩
        haveI : Algebra.FormallyEtale R (B ⧸ Ideal.span {x₀}) := by
          rw [Algebra.FormallyEtale.iff_comp_bijective]
          intro A _ _ J hJ
          letI : Algebra (Polynomial R) A :=
            (Polynomial.aeval (algebraMap R A c)).toRingHom.toAlgebra
          haveI : IsScalarTower R (Polynomial R) A := IsScalarTower.of_algebraMap_eq
            (fun r => ((Polynomial.aeval (algebraMap R A c)).commutes r).symm)
          have hA : algebraMap (Polynomial R) A Polynomial.X = algebraMap R A c :=
            Polynomial.aeval_X (algebraMap R A c)
          have hAC : algebraMap (Polynomial R) A (Polynomial.X - Polynomial.C c) = 0 := by
            show Polynomial.aeval (algebraMap R A c) (Polynomial.X - Polynomial.C c) = 0
            simp
          have hAJ : algebraMap (Polynomial R) (A ⧸ J) Polynomial.X = algebraMap R (A ⧸ J) c := by
            rw [IsScalarTower.algebraMap_apply (Polynomial R) A (A ⧸ J), hA,
              ← IsScalarTower.algebraMap_apply]
          have hJn : IsNilpotent J := ⟨2, by rw [hJ]; rfl⟩
          refine ⟨fun G₁ G₂ hG => ?_, fun f => ?_⟩
          · obtain ⟨ψ₁, hψ₁⟩ := upgrade A hA (G₁.comp (Ideal.Quotient.mkₐ R _))
              (by rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, hmk, map_zero])
            obtain ⟨ψ₂, hψ₂⟩ := upgrade A hA (G₂.comp (Ideal.Quotient.mkₐ R _))
              (by rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, hmk, map_zero])
            have h12 : ψ₁ = ψ₂ := by
              apply Algebra.FormallyUnramified.ext J hJn
              intro b
              rw [hψ₁, hψ₂]
              have := congrArg (fun F => F (Ideal.Quotient.mk (Ideal.span {x₀}) b)) hG
              simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at this ⊢
              exact this
            ext y
            obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
            have := congrArg (fun F => F b) h12
            simp only [hψ₁, hψ₂, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at this
            exact this
          · obtain ⟨ψ, hψ⟩ := upgrade (A ⧸ J) hAJ (f.comp (Ideal.Quotient.mkₐ R _))
              (by rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, hmk, map_zero])
            let F₀ : B →ₐ[Polynomial R] A := Algebra.FormallySmooth.lift J hJn ψ
            have hF₀ : ∀ b, Ideal.Quotient.mk J (F₀ b) = ψ b :=
              Algebra.FormallySmooth.mk_lift J hJn ψ
            have hFx : ∀ y ∈ Ideal.span {x₀}, (F₀.restrictScalars R) y = 0 := by
              intro y hy
              have hle : Ideal.span {x₀} ≤ RingHom.ker (F₀.restrictScalars R) := by
                rw [Ideal.span_le, Set.singleton_subset_iff]
                show F₀ x₀ = 0
                rw [← hXB, F₀.commutes, hAC]
              exact hle hy
            refine ⟨Ideal.Quotient.liftₐ _ (F₀.restrictScalars R) hFx, ?_⟩
            ext y
            obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
            show Ideal.Quotient.mk J (F₀ b) = f (Ideal.Quotient.mk _ b)
            rw [hF₀, hψ]
            rfl
        exact ⟨inferInstance, inferInstance⟩
      haveI := hquot
      have hIQ : Ideal.span {x₀} ≤ Q := by
        rw [Ideal.span_le, Set.singleton_subset_iff]
        exact hx₀
      have hfs : Function.Surjective (Algebra.ofId R (B ⧸ Q)) := by
        intro y
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
        obtain ⟨r, hr⟩ := hresB b
        refine ⟨r, ?_⟩
        rw [Algebra.ofId_apply, ← Ideal.Quotient.mk_algebraMap]
        exact (Ideal.Quotient.eq.mpr hr).symm
      have hkf : IsLocalRing.maximalIdeal R = RingHom.ker (Algebra.ofId R (B ⧸ Q)) := by
        ext r
        rw [RingHom.mem_ker, Algebra.ofId_apply, ← Ideal.Quotient.mk_algebraMap,
          Ideal.Quotient.eq_zero_iff_mem, ← Ideal.mem_comap, ← hQ]
        rfl
      let eQ : IsLocalRing.ResidueField R ≃ₐ[R] B ⧸ Q :=
        (Ideal.quotientEquivAlgOfEq R hkf).trans (Ideal.quotientKerAlgEquivOfSurjective hfs)
      let σ₀ : B →ₐ[R] IsLocalRing.ResidueField R :=
        (eQ.symm : B ⧸ Q →ₐ[R] IsLocalRing.ResidueField R).comp (Ideal.Quotient.mkₐ R Q)
      have hσ₀ : ∀ b, σ₀ b = 0 ↔ b ∈ Q := by
        intro b
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        show eQ.symm (Ideal.Quotient.mk Q b) = 0 ↔ _
        exact map_eq_zero_iff _ eQ.symm.injective
      let σ : (B ⧸ Ideal.span {x₀}) →ₐ[R] IsLocalRing.ResidueField R :=
        Ideal.Quotient.liftₐ _ σ₀ (fun a ha => (hσ₀ a).mpr (hIQ ha))
      have hσmk : ∀ b, σ (Ideal.Quotient.mk _ b) = σ₀ b := fun b => rfl
      obtain ⟨τ, hτ⟩ := hetale R _ σ
      obtain ⟨e, he, hke⟩ := hker R _ τ
      obtain ⟨e', he'⟩ := Ideal.Quotient.mk_surjective e
      have hτe : τ e = 0 := by
        have : e ∈ RingHom.ker τ := by
          rw [hke]
          exact Ideal.mem_span_singleton_self e
        exact RingHom.mem_ker.mp this
      have he'Q : e' ∈ Q := by
        rw [← hσ₀, ← hσmk, he', ← hτ, hτe, map_zero]
      have hsQ : 1 - e' ∉ Q := by
        intro hmem
        apply hQP.ne_top
        rw [Ideal.eq_top_iff_one]
        have := Q.add_mem hmem he'Q
        rwa [sub_add_cancel] at this
      set r := τ (Ideal.Quotient.mk (Ideal.span {x₀}) b) with hr
      have hy : Ideal.Quotient.mk (Ideal.span {x₀}) (b - algebraMap R B r) ∈ RingHom.ker τ := by
        rw [RingHom.mem_ker, map_sub, Ideal.Quotient.mk_algebraMap, map_sub, AlgHom.commutes, hr]
        simp
      rw [hke] at hy
      obtain ⟨c', hc'⟩ := Ideal.mem_span_singleton'.mp hy
      have hmem : (1 - e') * (b - algebraMap R B r) ∈ Ideal.span {x₀} := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, map_sub, map_one, he', ← hc']
        have he2 : e * e = e := he
        calc (1 - e) * (c' * e) = c' * (e - e * e) := by ring
          _ = 0 := by rw [he2, sub_self, mul_zero]
      obtain ⟨b'', hb''⟩ := Ideal.mem_span_singleton'.mp hmem
      refine ⟨r, 1 - e', b'', hsQ, ?_⟩
      show (1 - e') * (b - algebraMap R B r) = x₀ * b''
      rw [← hb'', mul_comm]

    set ι := algebraMap A (Localization.Away h) with hι
    set Q : Ideal (Localization.Away h) := 𝔭.map ι with hQdef
    have hdisj : Disjoint (Submonoid.powers h : Set A) (𝔭 : Set A) :=
      (Ideal.disjoint_powers_iff_notMem h hP.isRadical).mpr hh
    have hQP : Q.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) _ 𝔭 hP hdisj
    have hQcomap : Q.comap ι = 𝔭 :=
      IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers h) _ hP hdisj
    have hfCr : ∀ r : ↥W, f (Polynomial.C r) = ι (algebraMap ↥W A r) := fun r =>
      RingHom.congr_fun hfC r
    have hfx0 : f Polynomial.X - f (Polynomial.C c) = ι (t - algebraMap ↥W A c) := by
      rw [hfX, hfCr, map_sub]
    have hQW : Q.comap (f.comp Polynomial.C) = IsLocalRing.maximalIdeal ↥W := by
      rw [hfC, ← Ideal.comap_comap, hQcomap]
      ext w
      constructor
      · intro hw
        by_contra hnm
        have hu : IsUnit w := by
          by_contra hnu
          exact hnm ((IsLocalRing.mem_maximalIdeal w).mpr hnu)
        exact hP.ne_top (Ideal.eq_top_of_isUnit_mem _ hw (hu.map (algebraMap ↥W A)))
      · intro hw
        exact hm𝔭 w hw
    have hx0Q : f Polynomial.X - f (Polynomial.C c) ∈ Q := by
      rw [hfx0]
      exact Ideal.mem_map_of_mem _ (Ideal.sub_mem _ ht (hm𝔭 c hc))
    have hnotQ : ∀ a : A, a ∉ 𝔭 → ι a ∉ Q := by
      intro a ha hq
      apply ha
      rw [← hQcomap]
      exact hq
    have hresB : ∀ b : Localization.Away h, ∃ r : ↥W, b - f (Polynomial.C r) ∈ Q := by
      intro b
      obtain ⟨n, a, hb⟩ := IsLocalization.Away.surj h b
      obtain ⟨w₁, hw₁⟩ := hres h
      obtain ⟨w₂, hw₂⟩ := hres a
      have hw₁u : IsUnit w₁ := by
        by_contra hn
        apply hh
        have hm' : w₁ ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal w₁).mpr hn
        have := Ideal.add_mem _ hw₁ (hm𝔭 w₁ hm')
        rwa [sub_add_cancel] at this
      obtain ⟨v, hv⟩ := hw₁u.exists_right_inv
      refine ⟨w₂ * v ^ n, ?_⟩
      have hRW : algebraMap ↥W A (w₂ * v ^ n) * (algebraMap ↥W A w₁) ^ n = algebraMap ↥W A w₂ := by
        rw [← map_pow, ← map_mul]
        congr 1
        calc w₂ * v ^ n * w₁ ^ n = w₂ * (w₁ * v) ^ n := by ring
          _ = w₂ := by rw [hv, one_pow, mul_one]
      have hdiv : (algebraMap ↥W A w₁) ^ n - h ^ n ∈ 𝔭 := by
        obtain ⟨q, hq⟩ := sub_dvd_pow_sub_pow (algebraMap ↥W A w₁) h n
        rw [hq]
        apply Ideal.mul_mem_right
        rw [← neg_sub]
        exact 𝔭.neg_mem hw₁
      have hA' : a - algebraMap ↥W A (w₂ * v ^ n) * h ^ n ∈ 𝔭 := by
        have e1 : a - algebraMap ↥W A (w₂ * v ^ n) * h ^ n =
            (a - algebraMap ↥W A w₂) +
              algebraMap ↥W A (w₂ * v ^ n) * ((algebraMap ↥W A w₁) ^ n - h ^ n) := by
          linear_combination (-1 : A) * hRW
        rw [e1]
        exact Ideal.add_mem _ hw₂ (Ideal.mul_mem_left _ _ hdiv)
      have hprod : (b - f (Polynomial.C (w₂ * v ^ n))) * ι h ^ n =
          ι (a - algebraMap ↥W A (w₂ * v ^ n) * h ^ n) := by
        rw [hfCr, map_sub, ← hb]
        simp only [map_mul, map_pow]
        ring
      have hmemQ : (b - f (Polynomial.C (w₂ * v ^ n))) * ι h ^ n ∈ Q := by
        rw [hprod]
        exact Ideal.mem_map_of_mem _ hA'
      rcases hQP.mem_or_mem hmemQ with h1 | h1
      · exact h1
      · exfalso
        rw [← map_pow] at h1
        exact hnotQ _ (hpow h n hh) h1

    set u := t - algebraMap ↥W A c with hu_def
    have hu𝔭 : u ∈ 𝔭 := Ideal.sub_mem _ ht (hm𝔭 c hc)
    have hSTEP : ∀ a : A, ∃ (w : ↥W) (s a' : A), s ∉ 𝔭 ∧ s * (a - algebraMap ↥W A w) = u * a' := by
      intro a
      obtain ⟨r, s₀, b₀, hs₀, heq⟩ := hstep ↥W _ f hfet c Q hQP hQW hx0Q hresB (ι a)
      rw [hfCr, hfx0] at heq
      obtain ⟨i, s₁, hs₁⟩ := IsLocalization.Away.surj h s₀
      obtain ⟨j, b₁, hb₁⟩ := IsLocalization.Away.surj h b₀
      have hs₁𝔭 : s₁ ∉ 𝔭 := by
        intro hs
        have h1 : ι s₁ ∈ Q := Ideal.mem_map_of_mem _ hs
        rw [← hs₁] at h1
        rcases hQP.mem_or_mem h1 with h2 | h2
        · exact hs₀ h2
        · rw [← map_pow] at h2
          exact hnotQ _ (hpow h i hh) h2
      have hιeq : ι (s₁ * h ^ j * (a - algebraMap ↥W A r)) = ι (u * b₁ * h ^ i) := by
        rw [map_mul, map_mul, map_sub, map_pow, map_mul, map_mul, map_pow, ← hs₁, ← hb₁]
        linear_combination (ι h ^ i * ι h ^ j) * heq
      obtain ⟨⟨m, hm⟩, hcm⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers h) _).mp hιeq
      obtain ⟨k, rfl⟩ := Submonoid.mem_powers_iff _ _ |>.mp hm
      refine ⟨r, h ^ k * s₁ * h ^ j, h ^ k * b₁ * h ^ i, ?_, ?_⟩
      · exact hmul _ _ (hmul _ _ (hpow h k hh) hs₁𝔭) (hpow h j hh)
      · simp only at hcm
        linear_combination hcm

    have hLoc : ∀ (d₀ : A) (y : K), wcLlsKPLoc A K 0 d₀ y ↔
        ∃ (n : ℕ) (a : A), algebraMap A K d₀ ^ n * y = algebraMap A K a := by
      intro d₀ y
      simp only [wcLlsKPLoc, Algebra.adjoin_singleton_zero, Algebra.mem_bot, Set.mem_range]
      exact exists_congr fun n => ⟨fun ⟨a, ha⟩ => ⟨a, ha.symm⟩, fun ⟨a, ha⟩ => ⟨a, ha.symm⟩⟩
    have hinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
    have hne : ∀ a : A, a ∉ 𝔭 → algebraMap A K a ≠ 0 := by
      intro a ha h0
      apply ha
      rw [← map_zero (algebraMap A K)] at h0
      rw [hinj h0]
      exact 𝔭.zero_mem

    induction N with
    | zero => exact ⟨0, d, x, hd, hx, by simp⟩
    | succ N ih =>
      obtain ⟨P, d', y, hd', hy, hxeq⟩ := ih
      obtain ⟨n, a, hya⟩ := (hLoc d' y).mp hy
      have he : d' ^ n ∉ 𝔭 := hpow d' n hd'
      have hya' : algebraMap A K (d' ^ n) * y = algebraMap A K a := by
        rw [map_pow]; exact hya
      obtain ⟨wa, s₁, a₁, hs₁, h1⟩ := hSTEP a
      obtain ⟨we, s₂, e₁, hs₂, h2⟩ := hSTEP (d' ^ n)
      have hweu : IsUnit we := by
        by_contra hn
        have hm' : we ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal we).mpr hn
        apply hmul s₂ (d' ^ n) hs₂ he
        have e1 : s₂ * d' ^ n = s₂ * (d' ^ n - algebraMap ↥W A we) + s₂ * algebraMap ↥W A we := by
          ring
        rw [e1, h2]
        exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hu𝔭) (Ideal.mul_mem_left _ _ (hm𝔭 we hm'))
      obtain ⟨v, hv⟩ := hweu.exists_right_inv
      have hww : algebraMap ↥W A (wa * v) * algebraMap ↥W A we = algebraMap ↥W A wa := by
        rw [← map_mul]
        congr 1
        calc wa * v * we = wa * (we * v) := by ring
          _ = wa := by rw [hv, mul_one]
      have hkey : s₁ * s₂ * (a - algebraMap ↥W A (wa * v) * d' ^ n) =
          u * (s₂ * a₁ - algebraMap ↥W A (wa * v) * s₁ * e₁) := by
        linear_combination s₂ * h1 - algebraMap ↥W A (wa * v) * s₁ * h2 - s₁ * s₂ * hww
      have hd'' : s₁ * s₂ * d' ^ n ∉ 𝔭 := hmul _ _ (hmul _ _ hs₁ hs₂) he
      have hd''K := hne _ hd''
      refine ⟨P + Polynomial.C (wa * v) * Polynomial.X ^ N, s₁ * s₂ * d' ^ n,
        algebraMap A K (s₂ * a₁ - algebraMap ↥W A (wa * v) * s₁ * e₁) /
          algebraMap A K (s₁ * s₂ * d' ^ n), hd'', ?_, ?_⟩
      · refine (hLoc _ _).mpr ⟨1, s₂ * a₁ - algebraMap ↥W A (wa * v) * s₁ * e₁, ?_⟩
        rw [pow_one]
        field_simp
      · have hy' : y = algebraMap A K (algebraMap ↥W A (wa * v)) + algebraMap A K u *
            (algebraMap A K (s₂ * a₁ - algebraMap ↥W A (wa * v) * s₁ * e₁) /
              algebraMap A K (s₁ * s₂ * d' ^ n)) := by
          apply mul_left_cancel₀ hd''K
          have hL : algebraMap A K (s₁ * s₂ * d' ^ n) * y = algebraMap A K (s₁ * s₂ * a) := by
            rw [map_mul, mul_assoc, hya', ← map_mul]
          have hc' : algebraMap A K (s₁ * s₂ * d' ^ n) *
              (algebraMap A K (s₂ * a₁ - algebraMap ↥W A (wa * v) * s₁ * e₁) /
                algebraMap A K (s₁ * s₂ * d' ^ n)) =
              algebraMap A K (s₂ * a₁ - algebraMap ↥W A (wa * v) * s₁ * e₁) := by
            field_simp
          rw [hL, mul_add, mul_left_comm, hc', ← map_mul, ← map_mul, ← map_add]
          congr 1
          linear_combination hkey
        rw [hxeq, hy']
        simp only [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C,
          Polynomial.eval₂_X_pow, RingHom.comp_apply]
        ring
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ 𝔭 t hPD f₂ d₂ hd₂ hLf hLfi h g γ w β π₀ m₀ N
    d₃ y₂ hd₃ hy₂ hγ hw0 hpw hβm hπ₀ hβN hm₀ hpm₀ heq ξ b ζ γ' h' g' hβξ hbm hb0 hζ hγ' hυ
    hh'0 hg'0 hg'm hg'low hcomp hε

  have hℓ2 : 2 ≤ ℓ := hℓ.two_le
  have hℓpos : 0 < ℓ := hℓ.pos
  have hPrime : 𝔭.IsPrime := hPD.2.2.2.1.isPrime
  have hroot : ∀ (x : ↥W) (n : ℕ), 0 < n → ∃ z : ↥W, z ^ n = x := by
    intro x n hn
    obtain ⟨z₀, hz₀⟩ := IsAlgClosed.exists_pow_nat_eq (algebraMap ↥W Ω x) hn
    have hint : IsIntegral ↥W z₀ := by
      refine ⟨Polynomial.X ^ n - Polynomial.C x, Polynomial.monic_X_pow_sub_C _ hn.ne', ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hz₀, sub_self]
    obtain ⟨z, hz⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥W) (K := Ω)).mp hint
    refine ⟨z, ?_⟩
    apply IsFractionRing.injective ↥W Ω
    rw [map_pow, hz, hz₀]
  have hunit_add : ∀ x y : ↥W, IsUnit x → y ∈ IsLocalRing.maximalIdeal ↥W → IsUnit (x + y) := by
    intro x y hx hy
    by_contra hn
    have h1 : x + y ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal _).mpr hn
    have h2 : x ∈ IsLocalRing.maximalIdeal ↥W := by
      have h3 := Ideal.sub_mem _ h1 hy
      rwa [add_sub_cancel_right] at h3
    exact (IsLocalRing.mem_maximalIdeal x).mp h2 hx
  have hLoc : ∀ (d₀ : A) (y : K), wcLlsKPLoc A K 0 d₀ y ↔
      ∃ (n : ℕ) (a : A), algebraMap A K d₀ ^ n * y = algebraMap A K a := by
    intro d₀ y
    simp only [wcLlsKPLoc, Algebra.adjoin_singleton_zero, Algebra.mem_bot, Set.mem_range]
    exact exists_congr fun n => ⟨fun ⟨a, ha⟩ => ⟨a, ha.symm⟩, fun ⟨a, ha⟩ => ⟨a, ha.symm⟩⟩
  have hLocW : ∀ (d₀ e₀ : A) (y : K), wcLlsKPLoc A K 0 d₀ y → wcLlsKPLoc A K 0 (d₀ * e₀) y := by
    intro d₀ e₀ y hy
    obtain ⟨n, a₀, ha₀⟩ := (hLoc d₀ y).mp hy
    refine (hLoc _ _).mpr ⟨n, e₀ ^ n * a₀, ?_⟩
    simp only [map_mul, map_pow]
    rw [← ha₀]
    ring

  have key : ∀ (f H Gv H' G' Pu y₂ y₃ T U Γ Γ' n l r a' Ê σ' τ' g2 g3 q : K),
      f - H ^ ℓ = Γ ^ ℓ * (Gv + T ^ (m₀ + 1 + N) * y₂) →
      H ^ ℓ + Γ ^ ℓ * Gv = H' ^ ℓ + Γ' ^ ℓ * G' →
      y₂ = Pu + U ^ (m₀ + 1 + N) * y₃ →
      Γ = Γ' * n →
      l ^ ℓ = 1 + Γ' ^ ℓ * r * a' ^ ℓ →
      g2 = Ê * (G' + n ^ ℓ * T ^ (m₀ + 1 + N) * Pu - r * a' ^ ℓ * H' ^ ℓ) →
      Ê * σ' ^ ℓ = 1 → σ' * τ' = 1 →
      g2 = g3 + U ^ (m₀ + 1 + N) * q →
      f - (l * H') ^ ℓ = (Γ' * σ') ^ ℓ *
        (g3 + U ^ (m₀ + 1 + N) * (q + (n * τ') ^ ℓ * T ^ (m₀ + 1 + N) * y₃)) := by
    intro f H Gv H' G' Pu y₂ y₃ T U Γ Γ' n l r a' Ê σ' τ' g2 g3 q h1 h2 h3 h4 h5 h6 h7 h8 h9
    have h4' : Γ ^ ℓ = Γ' ^ ℓ * n ^ ℓ := by rw [h4, mul_pow]
    have h8' : σ' ^ ℓ * τ' ^ ℓ = 1 := by rw [← mul_pow, h8, one_pow]
    linear_combination h1 + h2 + Γ ^ ℓ * T ^ (m₀ + 1 + N) * h3 +
      T ^ (m₀ + 1 + N) * (Pu + U ^ (m₀ + 1 + N) * y₃) * h4' - H' ^ ℓ * h5 -
      Γ' ^ ℓ * n ^ ℓ * T ^ (m₀ + 1 + N) * U ^ (m₀ + 1 + N) * y₃ * h8' +
      Γ' ^ ℓ * σ' ^ ℓ * h9 - Γ' ^ ℓ * σ' ^ ℓ * h6 -
      Γ' ^ ℓ * (G' + n ^ ℓ * T ^ (m₀ + 1 + N) * Pu - r * a' ^ ℓ * H' ^ ℓ) * h7

  obtain ⟨υ, hυu, hγ'eq⟩ := hυ
  obtain ⟨ν, hυν⟩ := hυu.exists_right_inv
  obtain ⟨ε₀, hε₀eq, hεcase⟩ := hε

  have hγpow : γ ^ (ℓ - 1) ≠ 0 := pow_ne_zero _ hγ
  have hwfac : w = (υ * ζ ^ m₀) ^ (ℓ - 1) * ε₀ := by
    apply mul_left_cancel₀ hγpow
    rw [← hpw, hε₀eq, hγ'eq]
    ring
  obtain ⟨s, hs⟩ := hβξ
  obtain ⟨e, he⟩ : ∃ e : ℕ, ℓ = e + 2 := ⟨ℓ - 2, by omega⟩
  have hℓ1 : ℓ - 1 = e + 1 := by omega
  obtain ⟨κ, hκm, hξpow⟩ : ∃ κ : ↥W, κ ∈ IsLocalRing.maximalIdeal ↥W ∧
      ξ ^ (N + 1) = b ^ m₀ * κ := by
    refine ⟨υ ^ ((e + 1) * (e + 2)) * b ^ (m₀ * e) * ε₀ ^ (e + 2) * π₀ * β * s ^ (N + 1),
      Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ hπ₀)), ?_⟩
    have h1 : ξ ^ (N + 1) = β ^ N * β * s ^ (N + 1) := by rw [hs]; ring
    rw [h1, hβN, hwfac, hℓ1, ← hζ, he]
    ring
  have hξm : ξ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [hs]; exact Ideal.mul_mem_right _ _ hβm

  obtain ⟨P, d₄, y₃, hd₄, hy₃, hy₂eq⟩ :=
    hTay Ω W A K 𝔭 t hPD ξ hξm y₂ d₃ hd₃ hy₂ (m₀ + 1 + N)

  obtain ⟨R, hRdef⟩ : ∃ R : Polynomial ↥W, R = Polynomial.C (ν ^ ℓ) *
      (Polynomial.X + Polynomial.C ξ) ^ (m₀ + 1 + N) * P := ⟨_, rfl⟩
  have hRcoeff : ∀ j, j ≤ m₀ → ∃ π : ↥W, π ∈ IsLocalRing.maximalIdeal ↥W ∧
      R.coeff j = b ^ (m₀ - j) * π := by
    intro j hj
    have hdvd : ξ ^ (N + 1) ∣ R.coeff j := by
      rw [hRdef, mul_assoc, Polynomial.coeff_C_mul, Polynomial.coeff_mul]
      apply dvd_mul_of_dvd_right
      apply Finset.dvd_sum
      intro x hx
      have hx' : x.1 + x.2 = j := by simpa using hx
      rw [Polynomial.coeff_X_add_C_pow]
      apply Dvd.dvd.mul_right
      apply Dvd.dvd.mul_right
      apply pow_dvd_pow
      omega
    obtain ⟨c, hc⟩ := hdvd
    refine ⟨b ^ j * κ * c, Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ hκm), ?_⟩
    rw [hc, hξpow, ← pow_sub_mul_pow b hj]
    ring

  obtain ⟨a, ha⟩ := hh'0.exists_left_inv
  obtain ⟨π0, hπ0m, hR0⟩ := hRcoeff 0 (Nat.zero_le _)
  have hr₀m : R.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [hR0]; exact Ideal.mul_mem_left _ _ hπ0m
  have hc₀u : IsUnit (1 + γ' ^ ℓ * R.coeff 0 * a ^ ℓ) :=
    hunit_add 1 _ isUnit_one (Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ hr₀m))
  obtain ⟨lam, hlam⟩ := hroot (1 + γ' ^ ℓ * R.coeff 0 * a ^ ℓ) ℓ hℓpos
  have hlamu : IsUnit lam := (isUnit_pow_iff hℓpos.ne').mp (by rw [hlam]; exact hc₀u)
  obtain ⟨G₂, hG₂⟩ : ∃ G₂ : Polynomial ↥W,
      G₂ = g' + R - Polynomial.C (R.coeff 0 * a ^ ℓ) * h' ^ ℓ := ⟨_, rfl⟩
  have hh'pow0 : (h' ^ ℓ).coeff 0 = (h'.coeff 0) ^ ℓ := by
    rw [Polynomial.coeff_zero_eq_eval_zero, Polynomial.coeff_zero_eq_eval_zero,
      Polynomial.eval_pow]
  have hah : a ^ ℓ * h'.coeff 0 ^ ℓ = 1 := by rw [← mul_pow, ha, one_pow]
  have hG₂0 : G₂.coeff 0 = 0 := by
    rw [hG₂, Polynomial.coeff_sub, Polynomial.coeff_add, Polynomial.coeff_C_mul, hh'pow0, hg'0]
    linear_combination (-(R.coeff 0)) * hah
  have hG₂j : ∀ j, j ≤ m₀ → ∃ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W ∧
      G₂.coeff j = g'.coeff j + b ^ (m₀ - j) * ρ := by
    intro j hj
    obtain ⟨πj, hπj, hRj⟩ := hRcoeff j hj
    refine ⟨πj - b ^ j * π0 * a ^ ℓ * (h' ^ ℓ).coeff j, ?_, ?_⟩
    · exact Ideal.sub_mem _ hπj
        (Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ hπ0m)))
    · rw [hG₂, Polynomial.coeff_sub, Polynomial.coeff_add, Polynomial.coeff_C_mul, hRj, hR0,
        Nat.sub_zero, ← pow_sub_mul_pow b hj]
      ring
  obtain ⟨ρm, hρm, hGm⟩ := hG₂j m₀ le_rfl
  have heu : IsUnit (G₂.coeff m₀) := by
    rw [hGm, hg'm, Nat.sub_self, pow_zero, one_mul]
    exact hunit_add 1 ρm isUnit_one hρm
  obtain ⟨σ, hσ⟩ := hroot (G₂.coeff m₀) ℓ hℓpos
  have hσu : IsUnit σ := (isUnit_pow_iff hℓpos.ne').mp (by rw [hσ]; exact heu)
  obtain ⟨τ, hστ⟩ := hσu.exists_right_inv
  have hτu : IsUnit τ := ⟨⟨τ, σ, by rw [mul_comm]; exact hστ, hστ⟩, rfl⟩
  obtain ⟨ê, hê⟩ := heu.exists_left_inv
  have hêu : IsUnit ê := ⟨⟨ê, G₂.coeff m₀, hê, by rw [mul_comm]; exact hê⟩, rfl⟩
  obtain ⟨g₂, hg₂⟩ : ∃ g₂ : Polynomial ↥W, g₂ = Polynomial.C ê * G₂ := ⟨_, rfl⟩

  obtain ⟨g₃, hg₃⟩ : ∃ g₃ : Polynomial ↥W, g₃ = g₂ %ₘ Polynomial.X ^ (m₀ + 1 + N) := ⟨_, rfl⟩
  obtain ⟨Q, hQ⟩ : ∃ Q : Polynomial ↥W, Q = g₂ /ₘ Polynomial.X ^ (m₀ + 1 + N) := ⟨_, rfl⟩
  have hdecomp : g₃ + Polynomial.X ^ (m₀ + 1 + N) * Q = g₂ := by
    rw [hg₃, hQ]; exact Polynomial.modByMonic_add_div g₂ _
  have hg₃c : ∀ j, j < m₀ + 1 + N → g₃.coeff j = g₂.coeff j := by
    intro j hj
    have h1 := congrArg (fun p => Polynomial.coeff p j) hdecomp
    simp only [Polynomial.coeff_add, Polynomial.coeff_X_pow_mul',
      if_neg (show ¬ (m₀ + 1 + N ≤ j) by omega), add_zero] at h1
    exact h1
  have hXM1 : (Polynomial.X ^ (m₀ + 1 + N) : Polynomial ↥W) ≠ 1 := by
    intro h1
    have h2 := congrArg Polynomial.natDegree h1
    rw [Polynomial.natDegree_X_pow, Polynomial.natDegree_one] at h2
    omega
  have hg₃deg : g₃.natDegree < m₀ + 1 + N := by
    have h1 := Polynomial.natDegree_modByMonic_lt g₂ (Polynomial.monic_X_pow (m₀ + 1 + N)) hXM1
    rw [Polynomial.natDegree_X_pow] at h1
    rw [hg₃]; exact h1
  have hg₃low : ∀ j, j ≤ m₀ → ∃ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W ∧
      g₃.coeff j = ê * (g'.coeff j + b ^ (m₀ - j) * ρ) := by
    intro j hj
    obtain ⟨ρ, hρ, hGj⟩ := hG₂j j hj
    exact ⟨ρ, hρ, by rw [hg₃c j (by omega), hg₂, Polynomial.coeff_C_mul, hGj]⟩

  obtain ⟨φ, hφ⟩ : ∃ φ : ↥W →+* K, φ = (algebraMap A K).comp (algebraMap ↥W A) := ⟨_, rfl⟩
  have hφa : ∀ x : ↥W, algebraMap A K (algebraMap ↥W A x) = φ x := by
    intro x; rw [hφ]; rfl
  obtain ⟨U, hU⟩ : ∃ U : K, U = algebraMap A K (t - algebraMap ↥W A ξ) := ⟨_, rfl⟩
  have hTU : algebraMap A K t = U + φ ξ := by
    rw [hU, map_sub, hφa, sub_add_cancel]
  rw [← hφ, hφa] at heq
  rw [← hφ, ← hU] at hy₂eq
  have E1 : (h.eval₂ φ (algebraMap A K t)) ^ ℓ + φ γ ^ ℓ * g.eval₂ φ (algebraMap A K t) =
      (h'.eval₂ φ U) ^ ℓ + φ γ' ^ ℓ * g'.eval₂ φ U := by
    have h1 := congrArg (Polynomial.eval₂ φ U) hcomp
    simp only [Polynomial.eval₂_comp, Polynomial.eval₂_add, Polynomial.eval₂_mul,
      Polynomial.eval₂_pow, Polynomial.eval₂_C, Polynomial.eval₂_X] at h1
    rw [hTU]
    exact h1
  have hRev : R.eval₂ φ U = φ ν ^ ℓ * algebraMap A K t ^ (m₀ + 1 + N) * P.eval₂ φ U := by
    rw [hRdef, hTU]
    simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_pow,
      Polynomial.eval₂_add, Polynomial.eval₂_X, map_pow]
  have h6 : g₂.eval₂ φ U = φ ê * (g'.eval₂ φ U + φ ν ^ ℓ * algebraMap A K t ^ (m₀ + 1 + N) *
      P.eval₂ φ U - φ (R.coeff 0) * φ a ^ ℓ * (h'.eval₂ φ U) ^ ℓ) := by
    rw [hg₂, hG₂]
    simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_sub,
      Polynomial.eval₂_add, Polynomial.eval₂_pow, map_mul, map_pow, hRev]
  have h9 : g₂.eval₂ φ U = g₃.eval₂ φ U + U ^ (m₀ + 1 + N) * Q.eval₂ φ U := by
    rw [← hdecomp, Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X_pow]
  have h4 : φ γ = φ γ' * φ ν := by rw [← map_mul, hγ'eq, mul_assoc, hυν, mul_one]
  have h5 : φ lam ^ ℓ = 1 + φ γ' ^ ℓ * φ (R.coeff 0) * φ a ^ ℓ := by
    rw [← map_pow, hlam]
    simp only [map_add, map_one, map_mul, map_pow]
  have h7 : φ ê * φ σ ^ ℓ = 1 := by rw [← map_pow, ← map_mul, hσ, hê, map_one]
  have h8 : φ σ * φ τ = 1 := by rw [← map_mul, hστ, map_one]
  have hfinal := key f₂ (h.eval₂ φ (algebraMap A K t)) (g.eval₂ φ (algebraMap A K t))
    (h'.eval₂ φ U) (g'.eval₂ φ U) (P.eval₂ φ U) y₂ y₃ (algebraMap A K t) U (φ γ) (φ γ') (φ ν)
    (φ lam) (φ (R.coeff 0)) (φ a) (φ ê) (φ σ) (φ τ) (g₂.eval₂ φ U) (g₃.eval₂ φ U)
    (Q.eval₂ φ U) heq E1 hy₂eq h4 h5 h6 h7 h8 h9

  obtain ⟨n₃, a₃, ha₃⟩ := (hLoc d₄ y₃).mp hy₃
  have hQev : Q.eval₂ φ U =
      algebraMap A K (Q.eval₂ (algebraMap ↥W A) (t - algebraMap ↥W A ξ)) := by
    rw [Polynomial.hom_eval₂, hφ, hU]
  have hLocy : wcLlsKPLoc A K 0 (d₂ * d₄)
      (Q.eval₂ φ U + (φ ν * φ τ) ^ ℓ * algebraMap A K t ^ (m₀ + 1 + N) * y₃) := by
    refine (hLoc _ _).mpr ⟨n₃, (d₂ * d₄) ^ n₃ * Q.eval₂ (algebraMap ↥W A) (t - algebraMap ↥W A ξ) +
      d₂ ^ n₃ * algebraMap ↥W A ((ν * τ) ^ ℓ) * t ^ (m₀ + 1 + N) * a₃, ?_⟩
    rw [hQev]
    simp only [map_add, map_mul, map_pow, hφa]
    rw [← ha₃]
    ring
  have hd : d₂ * d₄ ∉ 𝔭 := fun hmem => (hPrime.mem_or_mem hmem).elim hd₂ hd₄

  refine ⟨b, ζ, γ' * σ, d₂ * d₄, Polynomial.C lam * h', g₃, m₀ + 1 + N, ?_⟩
  unfold wcLlsKPNewton
  refine ⟨hd, hξm, hbm, hb0, hζ, mul_ne_zero hγ' hσu.ne_zero, ?_, ?_, ?_, hg₃deg, by omega, hm₀,
    hpm₀, ?_, hLocW _ _ _ hLf, hLocW _ _ _ hLfi, ?_, ε₀ * τ ^ (ℓ - 1), ?_, ?_⟩
  · rw [Polynomial.coeff_C_mul]; exact hlamu.mul hh'0
  · rw [hg₃c 0 (by omega), hg₂, Polynomial.coeff_C_mul, hG₂0, mul_zero]
  · rw [hg₃c m₀ (by omega), hg₂, Polynomial.coeff_C_mul, hê]
  · intro j hj
    obtain ⟨ρ, _, hj'⟩ := hg₃low j hj.le
    rw [hj']
    exact dvd_mul_of_dvd_right (dvd_add (hg'low j hj) (dvd_mul_right _ _)) _
  · refine ⟨_, hLocy, ?_⟩
    rw [← hφ, ← hU, hφa, map_mul φ γ', Polynomial.eval₂_mul, Polynomial.eval₂_C]
    exact hfinal
  · have h1 : (γ' * σ * ζ ^ m₀) ^ (ℓ - 1) * (ε₀ * τ ^ (ℓ - 1)) =
        (γ' * ζ ^ m₀) ^ (ℓ - 1) * ε₀ * (σ * τ) ^ (ℓ - 1) := by ring
    rw [h1, hστ, one_pow, mul_one, ← hε₀eq]
  · rcases hεcase with hεu | ⟨hεm, k, hk2, hkm, hpk, ⟨ek, heku, hgk⟩, πg, hπg, hg1⟩
    · exact Or.inl (hεu.mul (hτu.pow _))
    · right
      refine ⟨Ideal.mul_mem_right _ _ hεm, k, hk2, hkm, hpk, ?_, ?_⟩
      · obtain ⟨ρ, hρ, hk⟩ := hg₃low k hkm.le
        refine ⟨ê * (ek + ρ), hêu.mul (hunit_add ek ρ heku hρ), ?_⟩
        rw [hk, hgk]; ring
      · obtain ⟨ρ, hρ, h1⟩ := hg₃low 1 hm₀
        refine ⟨ê * (πg + ρ), Ideal.mul_mem_left _ _ (Ideal.add_mem _ hπg hρ), ?_⟩
        rw [h1, hg1]; ring

theorem wcLlsKP_vde_newton_from_best : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (f₂ q : K) (γ₁ : ↥W) (d₂ : A), d₂ ∉ 𝔭 → γ₁ ≠ 0 →
      wcLlsKPLoc A K 0 d₂ f₂ → wcLlsKPLoc A K 0 d₂ f₂⁻¹ → wcLlsKPLoc A K 0 d₂ q →
      f₂ - 1 = algebraMap A K (algebraMap ↥W A γ₁) ^ ℓ * q →
      (∃ x z : K, wcLlsKPLoc A K 0 d₂ x ∧ wcLlsKPMLoc W A K 0 d₂ z ∧
        f₂ - 1 = algebraMap A K t * x + z) →
      (∀ (e : K) (d' : A), d' ∉ 𝔭 → wcLlsKPLoc A K 0 d' e →
        ¬ wcLlsKPMLoc W A K 0 d' (q - e ^ ℓ)) →
      (∀ (γ ε₀ : ↥W) (h' : K) (d : A), d ∉ 𝔭 → IsUnit ε₀ →
        ((ℓ : ℕ) : ↥W) = γ ^ (ℓ - 1) * ε₀ → wcLlsKPLoc A K 0 d h' →
        wcLlsKPLoc A K 0 d ((f₂ - h' ^ ℓ) / algebraMap A K (algebraMap ↥W A γ) ^ ℓ) → False) →
      (∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → ∀ (x : K) (d : A), d ∉ 𝔭 →
        wcLlsKPLoc A K 0 d x → ∀ N : ℕ, ∃ (P : Polynomial ↥W) (d' : A) (y : K),
          d' ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d' y ∧
          x = P.eval₂ ((algebraMap A K).comp (algebraMap ↥W A))
              (algebraMap A K (t - algebraMap ↥W A c)) +
            algebraMap A K (t - algebraMap ↥W A c) ^ N * y) →
      ∃ (k : K) (c b ζ γ : ↥W) (d : A) (h g : Polynomial ↥W) (M m₀ : ℕ),
        k ≠ 0 ∧ wcLlsKPNewton W A K ℓ 𝔭 t (f₂ * k ^ ℓ) c b ζ γ d h g M m₀ :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ 𝔭 t hPD f₂ q γ₁ d₂ hd₂ hγ₁ hLf hLfi hLq hq
    hPU hnp hNoAS hTay

  have hℓ2 : 2 ≤ ℓ := hℓ.two_le
  have hn : 0 < ℓ - 1 := by omega
  obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq ((ℓ : ℕ) : Ω) hn
  have hint : IsIntegral ↥W z := by
    refine ⟨Polynomial.X ^ (ℓ - 1) - Polynomial.C ((ℓ : ℕ) : ↥W),
      Polynomial.monic_X_pow_sub_C _ hn.ne', ?_⟩
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, map_natCast, hz,
      sub_self]
  obtain ⟨x, hx⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥W) (K := Ω)).mp hint
  have hxp : x ^ (ℓ - 1) = ((ℓ : ℕ) : ↥W) := by
    apply IsFractionRing.injective ↥W Ω
    rw [map_pow, hx, hz, map_natCast]
  have hℓΩ : ((ℓ : ℕ) : Ω) ≠ 0 := by
    intro h0
    have hdvd : ringChar Ω ∣ ℓ := ringChar.dvd h0
    rcases hℓ.eq_one_or_self_of_dvd _ hdvd with h1 | h1
    · exact CharP.ringChar_ne_one h1
    · exact hΩ h1
  have hx0 : x ≠ 0 := by
    intro h0
    apply hℓΩ
    have e1 : ((ℓ : ℕ) : ↥W) = 0 := by rw [← hxp, h0, zero_pow hn.ne']
    have e2 := congrArg (algebraMap ↥W Ω) e1
    rwa [map_natCast, map_zero] at e2
  have hinjWA : Function.Injective (algebraMap ↥W A) := by
    haveI := hPD.2.1
    refine (injective_iff_map_eq_zero _).mpr (fun a ha => ?_)
    have h1 : a • (1 : A) = 0 := by rw [Algebra.smul_def, mul_one]; exact ha
    rcases smul_eq_zero.mp h1 with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hwK0 : ∀ a : ↥W, a ≠ 0 → algebraMap A K (algebraMap ↥W A a) ≠ 0 := by
    intro a ha h0
    apply ha
    apply hinjWA
    rw [map_zero]
    apply IsFractionRing.injective A K
    rw [map_zero, h0]
  have hLoc1 : wcLlsKPLoc A K 0 d₂ 1 := by
    unfold wcLlsKPLoc
    exact ⟨0, by rw [pow_zero, mul_one]; exact Subalgebra.one_mem _⟩
  have hxg : ¬ x ∣ γ₁ := by
    rintro ⟨s, hs⟩
    apply hNoAS x 1 1 d₂ hd₂ isUnit_one (by rw [mul_one, hxp]) hLoc1
    have hLq' := hLq
    unfold wcLlsKPLoc at hLq' ⊢
    obtain ⟨n, hn'⟩ := hLq'
    refine ⟨n, ?_⟩
    have e : (f₂ - 1 ^ ℓ) / algebraMap A K (algebraMap ↥W A x) ^ ℓ =
        algebraMap A K (algebraMap ↥W A s ^ ℓ) * q := by
      rw [div_eq_iff (pow_ne_zero _ (hwK0 x hx0)), one_pow, hq, hs]
      simp only [map_mul, map_pow]
      ring
    rw [e, mul_left_comm]
    exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) hn'
  obtain ⟨s, hs⟩ : γ₁ ∣ x := (ValuationRing.dvd_total x γ₁).resolve_left hxg
  have hsu : ¬ IsUnit s := by
    intro hu
    apply hxg
    rw [hs]
    exact (IsUnit.mul_right_dvd hu).mpr dvd_rfl
  have hs0 : s ≠ 0 := by
    rintro rfl
    exact hx0 (by rw [hs, mul_zero])
  have hwm : s ^ (ℓ - 1) ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_pow_iff hn.ne']
    exact hsu
  have hw0 : s ^ (ℓ - 1) ≠ 0 := pow_ne_zero _ hs0
  have hpw : ((ℓ : ℕ) : ↥W) = γ₁ ^ (ℓ - 1) * s ^ (ℓ - 1) := by
    rw [← hxp, hs, mul_pow]

  obtain ⟨P, N, d', y, j, hd', hy, hqP, hjN, hpj, hPj⟩ :=
    wcLlsKP_nfb_residue_order Ω W hW hWt ℓ hℓ hΩ hκ A K 𝔭 t hPD q d₂ hd₂ hLq hnp

  obtain ⟨h, g, γ, w', m₀, d, y₁, hd, hγ, hw'm, hw'0, hpw', hh0, hg0, hgm, hm₀, hpm₀, hglow,
      hy₁, heq⟩ :=
    wcLlsKP_nfb_fixed_centre_low Ω W hW hWt ℓ hℓ hΩ hκ A K 𝔭 t hPD f₂ q γ₁ (s ^ (ℓ - 1)) d₂
      hd₂ hγ₁ hLf hLfi hLq hq hwm hw0 hpw P N d' y j hd' hy hqP hjN hpj hPj

  obtain ⟨β, hβm, hβ0, hβlow, hβw⟩ :=
    wcLlsKP_nfb_beta_exists Ω W ℓ m₀ g w' hm₀ hw'm hw'0 hglow

  obtain ⟨N₁, π₀, hπ₀, hβN⟩ :=
    wcLlsKP_nfb_archimedean Ω W hW β (w' ^ ℓ) hβm (pow_ne_zero _ hw'0)

  obtain ⟨P₂, d₃, y₂, hd₃, hy₂, hy₁eq⟩ :=
    hTay 0 (Ideal.zero_mem _) y₁ d hd hy₁ N₁
  rw [map_zero, sub_zero] at hy₁eq
  have hcoef : ∀ i, i ≤ m₀ → (g + Polynomial.X ^ (m₀ + 1) * P₂).coeff i = g.coeff i := by
    intro i hi
    rw [Polynomial.coeff_add, Polynomial.coeff_X_pow_mul', if_neg (by omega), add_zero]
  have heqp : f₂ - (h.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K t)) ^ ℓ =
      algebraMap A K (algebraMap ↥W A γ) ^ ℓ *
        ((g + Polynomial.X ^ (m₀ + 1) * P₂).eval₂ ((algebraMap A K).comp (algebraMap ↥W A))
            (algebraMap A K t) +
          algebraMap A K t ^ (m₀ + 1 + N₁) * y₂) := by
    rw [heq, hy₁eq, Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X_pow]
    ring

  obtain ⟨ξ, b, ζ, γ', h', g', hβξ, hbm, hb0, hζ, hγ', hυ, hh'0, hg'0, hg'm, hg'low, hcomp,
      hε⟩ :=
    wcLlsKP_nfb_good_centre_in_disc Ω W hW hWt ℓ hℓ hΩ hκ h (g + Polynomial.X ^ (m₀ + 1) * P₂)
      γ w' β m₀ hγ hpw' hw'm hh0
      (by rw [hcoef 0 (Nat.zero_le _)]; exact hg0) (by rw [hcoef m₀ le_rfl]; exact hgm)
      hm₀ hpm₀ hβm hβ0 (fun j hj => by rw [hcoef j hj.le]; exact hβlow j hj) hβw

  obtain ⟨b'', ζ'', γ'', d'', h'', g'', M'', hN⟩ :=
    wcLlsKP_nfb_transfer_beta Ω W hW hWt ℓ hℓ hΩ hκ A K 𝔭 t hPD f₂ d₂ hd₂ hLf hLfi h
      (g + Polynomial.X ^ (m₀ + 1) * P₂) γ w' β π₀ m₀ N₁ d₃ y₂ hd₃ hy₂ hγ hw'0 hpw' hβm hπ₀ hβN
      hm₀ hpm₀ heqp ξ b ζ γ' h' g' hβξ hbm hb0 hζ hγ' hυ hh'0 hg'0 hg'm hg'low hcomp hε
  refine ⟨1, ξ, b'', ζ'', γ'', d'', h'', g'', M'', m₀, one_ne_zero, ?_⟩
  rwa [one_pow, mul_one]

theorem wcLlsKP_vde_inner_from_newton : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    IsAlgClosed (IsLocalRing.ResidueField ↥W) →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ (θ' : L) (f₁ : K), θ' ∉ Set.range (algebraMap K L) → θ' ^ ℓ = algebraMap K L f₁ →
    ∀ (c b ζ γ₁ : ↥W) (d : A) (h g : Polynomial ↥W) (M m₀ : ℕ),
      wcLlsKPNewton W A K ℓ 𝔭 t f₁ c b ζ γ₁ d h g M m₀ →
      ∃ (w : L) (F : Polynomial K) (ε : ↥W) (G : Polynomial ↥W) (ω : ↥W),
        wcLlsKPInnerCore W A K L ℓ 𝔭 t c b d w F ε G ω ∧
        (IsUnit ε ∨ (ε ∈ IsLocalRing.maximalIdeal ↥W ∧ ∃ τ : ↥W,
          τ ∉ IsLocalRing.maximalIdeal ↥W ∧
          (Polynomial.derivative G).eval 0 ∈ IsLocalRing.maximalIdeal ↥W ∧
          (Polynomial.derivative G).eval τ ∈ IsLocalRing.maximalIdeal ↥W ∧
          ∃ j, (Polynomial.derivative G).coeff j ∉ IsLocalRing.maximalIdeal ↥W)) :=
by
  classical

  have s2 : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] (p : ℕ), p.Prime →
      ∀ (γ H f₁ e : K) (θ' : L), γ ≠ 0 → f₁ ≠ 0 → (p : K) = γ ^ (p - 1) * e →
      θ' ∉ Set.range (algebraMap K L) → θ' ^ p = algebraMap K L f₁ →
      ∃ (w : L) (F : Polynomial K), F.Monic ∧ F.natDegree = p ∧ Polynomial.aeval w F = 0 ∧
        w ∉ Set.range (algebraMap K L) ∧ F.coeff 0 = (H ^ p - f₁) / γ ^ p ∧ F.coeff p = 1 ∧
        (∀ i, p < i → F.coeff i = 0) ∧
        (∀ i, 1 ≤ i → i < p →
          F.coeff i = ((p.choose i / p : ℕ) : K) * e * γ ^ (i - 1) * H ^ (p - i)) ∧
        Polynomial.C (-(p : K) * γ ^ p * f₁⁻¹) * F + (Polynomial.C (γ ^ p * f₁⁻¹) * Polynomial.X +
          Polynomial.C (γ ^ (p - 1) * H * f₁⁻¹)) * Polynomial.derivative F =
            Polynomial.C (p : K) := by
    intro K L _ _ _ p hp γ H f₁ e θ' hγ hf he hθ hθf
    have hp2 := hp.two_le
    obtain ⟨a, ha⟩ : ∃ a : K, a = H / γ := ⟨_, rfl⟩
    obtain ⟨F, hF⟩ : ∃ F : Polynomial K,
        F = (Polynomial.X + Polynomial.C a) ^ p - Polynomial.C (f₁ / γ ^ p) := ⟨_, rfl⟩
    have hdegY : ((Polynomial.X + Polynomial.C a) ^ p).natDegree = p :=
      Polynomial.natDegree_pow_X_add_C p a
    have hcoeff : ∀ i, F.coeff i = a ^ (p - i) * (p.choose i : K) -
        (if i = 0 then f₁ / γ ^ p else 0) := by
      intro i
      rw [hF, Polynomial.coeff_sub, Polynomial.coeff_X_add_C_pow, Polynomial.coeff_C]
    have hγL : algebraMap K L γ ≠ 0 := (map_ne_zero _).mpr hγ
    refine ⟨(θ' - algebraMap K L H) / algebraMap K L γ, F, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · rw [hF]
      apply Polynomial.Monic.sub_of_left ((Polynomial.monic_X_add_C a).pow p)
      apply Polynomial.degree_lt_degree
      rw [Polynomial.natDegree_C, hdegY]
      omega
    · rw [hF, Polynomial.natDegree_sub_C, hdegY]
    · have h1 : (θ' - algebraMap K L H) / algebraMap K L γ + algebraMap K L a =
          θ' / algebraMap K L γ := by
        rw [ha, map_div₀]
        field_simp
        ring
      rw [hF]
      simp only [map_sub, map_pow, map_add, Polynomial.aeval_X, Polynomial.aeval_C]
      rw [h1, map_div₀, map_pow, div_pow, hθf, sub_self]
    · rintro ⟨k, hk⟩
      apply hθ
      refine ⟨γ * k + H, ?_⟩
      rw [map_add, map_mul, hk]
      field_simp
      ring
    · rw [hcoeff, if_pos rfl, Nat.choose_zero_right, Nat.cast_one, mul_one, Nat.sub_zero, ha,
        div_pow, sub_div]
    · rw [hcoeff, if_neg (by omega), Nat.choose_self, Nat.sub_self, pow_zero]
      simp
    · intro i hi
      rw [hcoeff, if_neg (by omega), Nat.choose_eq_zero_of_lt hi]
      simp
    · intro i hi1 hip
      rw [hcoeff, if_neg (by omega), sub_zero]
      have hdvd : p ∣ p.choose i := hp.dvd_choose_self (by omega) hip
      have hc : (p.choose i : K) = ((p.choose i / p : ℕ) : K) * (p : K) := by
        rw [← Nat.cast_mul, Nat.div_mul_cancel hdvd]
      have hγi : γ ^ (p - 1) = γ ^ (i - 1) * γ ^ (p - i) := by
        rw [← pow_add]
        congr 1
        omega
      rw [hc, he, ha, div_pow, hγi]
      have hγpi : γ ^ (p - i) ≠ 0 := pow_ne_zero _ hγ
      field_simp
    · have hD : Polynomial.derivative F =
          Polynomial.C (p : K) * (Polynomial.X + Polynomial.C a) ^ (p - 1) := by
        rw [hF, Polynomial.derivative_sub, Polynomial.derivative_C, sub_zero,
          Polynomial.derivative_X_add_C_pow]
      have hγp : γ ^ p = γ ^ (p - 1) * γ := by
        rw [← pow_succ]
        congr 1
        omega
      have hV : Polynomial.C (γ ^ p * f₁⁻¹) * Polynomial.X +
          Polynomial.C (γ ^ (p - 1) * H * f₁⁻¹) =
          Polynomial.C (γ ^ p * f₁⁻¹) * (Polynomial.X + Polynomial.C a) := by
        rw [mul_add, ← Polynomial.C_mul]
        congr 2
        rw [ha, hγp]
        field_simp
      have hU : Polynomial.C (-(p : K) * γ ^ p * f₁⁻¹) =
          -Polynomial.C (p : K) * Polynomial.C (γ ^ p * f₁⁻¹) := by
        rw [← Polynomial.C_neg, ← Polynomial.C_mul]
        congr 1
        ring
      have hk1 : γ ^ p * f₁⁻¹ * (f₁ / γ ^ p) = 1 := by
        field_simp
      have hk : Polynomial.C (γ ^ p * f₁⁻¹) * Polynomial.C (f₁ / γ ^ p) = 1 := by
        rw [← Polynomial.C_mul, hk1, Polynomial.C_1]
      have hY : (Polynomial.X + Polynomial.C a) ^ p =
          (Polynomial.X + Polynomial.C a) * (Polynomial.X + Polynomial.C a) ^ (p - 1) := by
        rw [← pow_succ']
        congr 1
        omega
      rw [hU, hD, hV, hF, hY]
      linear_combination (Polynomial.C (p : K)) * hk

  have s3 : ∀ (R : Type u) [CommRing R] (K : Type u) [CommRing K] (φ : R →+* K)
      (g : Polynomial R) (b : R) (m₀ M : ℕ), g.natDegree < M →
      (∀ j, j < m₀ → b ^ (m₀ - j) ∣ g.coeff j) →
      ∃ G : Polynomial R, (∀ j, b ^ m₀ * G.coeff j = b ^ j * g.coeff j) ∧
        ∀ x : K, φ b ^ m₀ * G.eval₂ φ x = g.eval₂ φ (φ b * x) := by
    intro R _ K _ φ g b m₀ M hgM hdiv
    choose q hq using hdiv
    obtain ⟨Gc, hGcdef⟩ : ∃ Gc : ℕ → R,
        Gc = fun j => if h : j < m₀ then q j h else g.coeff j * b ^ (j - m₀) := ⟨_, rfl⟩
    have hGc : ∀ j, b ^ m₀ * Gc j = b ^ j * g.coeff j := by
      intro j
      by_cases h : j < m₀
      · rw [hGcdef]
        simp only [dif_pos h]
        rw [hq j h, ← mul_assoc, ← pow_add, show j + (m₀ - j) = m₀ by omega]
      · rw [hGcdef]
        simp only [dif_neg h]
        rw [mul_comm (g.coeff j), ← mul_assoc, ← pow_add, show m₀ + (j - m₀) = j by omega]
    obtain ⟨G, hGdef⟩ : ∃ G : Polynomial R,
        G = ∑ j ∈ Finset.range M, Polynomial.monomial j (Gc j) := ⟨_, rfl⟩
    have hGcoeff : ∀ n, G.coeff n = if n < M then Gc n else 0 := by
      intro n
      rw [hGdef, Polynomial.finset_sum_coeff]
      simp only [Polynomial.coeff_monomial, Finset.sum_ite_eq', Finset.mem_range]
    refine ⟨G, ?_, ?_⟩
    · intro j
      rw [hGcoeff]
      split_ifs with h
      · exact hGc j
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), mul_zero, mul_zero]
    · intro x
      rw [Polynomial.eval₂_eq_sum_range' φ hgM, hGdef, Polynomial.eval₂_finset_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [Polynomial.eval₂_monomial, ← mul_assoc, ← map_pow, ← map_mul, hGc, map_mul, map_pow,
        mul_pow]
      ring

  have s4 : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω),
      IsAlgClosed (IsLocalRing.ResidueField ↥W) → ∀ ℓ : ℕ,
      ringChar (IsLocalRing.ResidueField ↥W) = ℓ → ∀ (G : Polynomial ↥W) (k m₀ : ℕ) (e π : ↥W),
      2 ≤ k → k < m₀ → ¬ ℓ ∣ k → ¬ ℓ ∣ m₀ → IsUnit e → π ∈ IsLocalRing.maximalIdeal ↥W →
      G.coeff 1 = π → G.coeff k = e → G.coeff m₀ = 1 →
      ∃ τ : ↥W, τ ∉ IsLocalRing.maximalIdeal ↥W ∧
        (Polynomial.derivative G).eval 0 ∈ IsLocalRing.maximalIdeal ↥W ∧
        (Polynomial.derivative G).eval τ ∈ IsLocalRing.maximalIdeal ↥W ∧
        ∃ j, (Polynomial.derivative G).coeff j ∉ IsLocalRing.maximalIdeal ↥W := by
    intro Ω _ W hres ℓ hκ G k m₀ e π hk2 hkm hℓk hℓm he hπ hG1 hGk hGm
    haveI := hres
    have hcast : ∀ n : ℕ, ¬ ℓ ∣ n → ((n : ↥W)) ∉ IsLocalRing.maximalIdeal ↥W := by
      intro n hn hmem
      have h0 : IsLocalRing.residue ↥W (n : ↥W) = 0 :=
        (IsLocalRing.residue_eq_zero_iff _).mpr hmem
      rw [map_natCast] at h0
      have := (ringChar.spec (IsLocalRing.ResidueField ↥W) n).mp h0
      rw [hκ] at this
      exact hn this
    have hcoef : ∀ n, (Polynomial.derivative G).coeff n = G.coeff (n + 1) * ((n : ↥W) + 1) :=
      fun n => Polynomial.coeff_derivative G n
    have hm1 : (Polynomial.derivative G).coeff (m₀ - 1) = (m₀ : ↥W) := by
      rw [hcoef, ← Nat.cast_add_one, show m₀ - 1 + 1 = m₀ by omega, hGm, one_mul]
    have hk1 : (Polynomial.derivative G).coeff (k - 1) = e * (k : ↥W) := by
      rw [hcoef, ← Nat.cast_add_one, show k - 1 + 1 = k by omega, hGk]
    have hev0 : (Polynomial.derivative G).eval 0 ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [← Polynomial.coeff_zero_eq_eval_zero, hcoef, zero_add, Nat.cast_zero, zero_add, mul_one,
        hG1]
      exact hπ
    obtain ⟨P, hP⟩ : ∃ P : Polynomial (IsLocalRing.ResidueField ↥W),
        P = (Polynomial.derivative G).map (IsLocalRing.residue ↥W) := ⟨_, rfl⟩
    have hPc : ∀ n, P.coeff n = IsLocalRing.residue ↥W ((Polynomial.derivative G).coeff n) := by
      intro n
      rw [hP, Polynomial.coeff_map]
    have hres0 : ∀ x : ↥W, x ∉ IsLocalRing.maximalIdeal ↥W → IsLocalRing.residue ↥W x ≠ 0 :=
      fun x hx h => hx ((IsLocalRing.residue_eq_zero_iff _).mp h)
    have hPk : P.coeff (k - 1) ≠ 0 := by
      rw [hPc, hk1, map_mul]
      exact mul_ne_zero (he.map (IsLocalRing.residue ↥W)).ne_zero (hres0 _ (hcast k hℓk))
    have hPm : P.coeff (m₀ - 1) ≠ 0 := by
      rw [hPc, hm1]
      exact hres0 _ (hcast m₀ hℓm)
    have hP0 : P ≠ 0 := fun h => hPk (by rw [h, Polynomial.coeff_zero])
    obtain ⟨Q, hPQ, hndvd⟩ := Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd P hP0 0
    simp only [map_zero, sub_zero] at hPQ hndvd
    have hQ0 : Q.coeff 0 ≠ 0 := fun h => hndvd (Polynomial.X_dvd_iff.mpr h)
    have hρ : P.rootMultiplicity 0 ≤ k - 1 := by
      by_contra h
      apply hPk
      rw [hPQ, Polynomial.coeff_X_pow_mul', if_neg h]
    have hQm : Q.coeff (m₀ - 1 - P.rootMultiplicity 0) ≠ 0 := by
      have := hPm
      rwa [hPQ, Polynomial.coeff_X_pow_mul', if_pos (by omega)] at this
    have hQdeg : 0 < Q.natDegree :=
      lt_of_lt_of_le (by omega) (Polynomial.le_natDegree_of_ne_zero hQm)
    obtain ⟨τb, hτb⟩ := IsAlgClosed.exists_root Q
      (Polynomial.natDegree_pos_iff_degree_pos.mp hQdeg).ne'
    have hτb0 : τb ≠ 0 := by
      intro h
      apply hQ0
      rw [Polynomial.coeff_zero_eq_eval_zero]
      subst h
      exact hτb
    have hPev : P.eval τb = 0 := by
      rw [hPQ, Polynomial.eval_mul, hτb.eq_zero, mul_zero]
    obtain ⟨τ, hτ⟩ := IsLocalRing.residue_surjective τb
    refine ⟨τ, ?_, hev0, ?_, m₀ - 1, ?_⟩
    · intro h
      apply hτb0
      rw [← hτ]
      exact (IsLocalRing.residue_eq_zero_iff _).mpr h
    · apply (IsLocalRing.residue_eq_zero_iff _).mp
      rw [← Polynomial.eval₂_at_apply, ← Polynomial.eval_map, ← hP, hτ, hPev]
    · rw [hm1]
      exact hcast m₀ hℓm

  intro Ω _ _ W _ _ ℓ hℓ hΩ hκ hres A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD _ θ' f₁ hθ' hθ'f
    c b ζ γ₁ d h g M m₀ hN
  obtain ⟨hd, _, hb, hb0, hζ, hγ₁, hh0, _, hgm, hgM, hmM, hm1, hℓm, hdiv, _, hf1i,
    ⟨y, hy, hE0⟩, ε₀, hε₀, hcase⟩ := hN
  obtain ⟨-, hNZ, -⟩ := hPD
  set ι : ↥W →+* K := (algebraMap A K).comp (algebraMap ↥W A) with hιdef
  set S : K := wcLlsScS W A K t c b with hSdef

  have hιinj : ∀ w : ↥W, w ≠ 0 → ι w ≠ 0 := by
    intro w hw h0
    have h1 : algebraMap ↥W A w = 0 := by
      apply IsFractionRing.injective A K
      rw [map_zero]
      exact h0
    have h2 : w • (1 : A) = 0 := by rw [Algebra.smul_def, h1, zero_mul]
    rcases smul_eq_zero.mp h2 with h3 | h3
    · exact hw h3
    · exact one_ne_zero h3

  have hζ0 : ζ ≠ 0 := by
    rintro rfl
    apply hb0
    rw [← hζ, zero_pow hℓ.ne_zero]
  have hζm : ζ ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hz
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hz
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hb
    exact hb (hζ ▸ hz.pow ℓ)
  have hγ₂m : γ₁ * ζ ^ m₀ ∈ IsLocalRing.maximalIdeal ↥W :=
    Ideal.mul_mem_left _ γ₁ (Ideal.pow_mem_of_mem _ hζm m₀ (by omega))
  have hγ0 : ι (γ₁ * ζ ^ m₀) ≠ 0 := hιinj _ (mul_ne_zero hγ₁ (pow_ne_zero _ hζ0))
  have hιb0 : ι b ≠ 0 := hιinj b hb0

  have huS : algebraMap A K (t - algebraMap ↥W A c) = ι b * S := by
    have : S = algebraMap A K (t - algebraMap ↥W A c) / ι b := rfl
    rw [this]
    field_simp

  obtain ⟨H, hHdef⟩ : ∃ H : K, H = h.eval₂ ι (algebraMap A K (t - algebraMap ↥W A c)) :=
    ⟨_, rfl⟩
  rw [← hHdef] at hE0
  have hHa : algebraMap A K (h.eval₂ (algebraMap ↥W A) (t - algebraMap ↥W A c)) = H := by
    rw [hHdef]
    exact Polynomial.hom_eval₂ h (algebraMap ↥W A) (algebraMap A K) _

  have he : (ℓ : K) = ι (γ₁ * ζ ^ m₀) ^ (ℓ - 1) * ι ε₀ := by
    rw [← map_natCast ι ℓ, hε₀, map_mul, map_pow]

  have hf0 : f₁ ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hθ'f
    have := (pow_eq_zero_iff hℓ.ne_zero).mp hθ'f
    exact hθ' ⟨0, by rw [map_zero, this]⟩

  obtain ⟨G, hG, hGev⟩ := s3 (↥W) K ι g b m₀ M hgM hdiv

  have hWeq : (γ₁ * ζ ^ m₀) ^ ℓ = γ₁ ^ ℓ * b ^ m₀ := by
    rw [mul_pow, ← pow_mul, mul_comm m₀ ℓ, pow_mul, hζ]
  have hγp : ι (γ₁ * ζ ^ m₀) ^ ℓ = ι γ₁ ^ ℓ * ι b ^ m₀ := by
    rw [← map_pow ι (γ₁ * ζ ^ m₀) ℓ, hWeq, map_mul, map_pow, map_pow]
  have hE0' : f₁ - H ^ ℓ = ι γ₁ ^ ℓ * (g.eval₂ ι (algebraMap A K (t - algebraMap ↥W A c)) +
      algebraMap A K (t - algebraMap ↥W A c) ^ M * y) := hE0
  have hMsplit : (ι b * S) ^ M = ι b ^ m₀ * (ι b ^ (M - m₀) * S ^ M) := by
    rw [mul_pow, ← mul_assoc, ← pow_add, Nat.add_sub_cancel' hmM.le]
  have hEq : f₁ - H ^ ℓ = ι (γ₁ * ζ ^ m₀) ^ ℓ * (G.eval₂ ι S + ι b ^ (M - m₀) * S ^ M * y) := by
    rw [hE0', hγp, huS, ← hGev S, hMsplit]
    ring

  obtain ⟨w, F, hFm, hFd, hFr, hw, hF0, hFp, hFgt, hFmid, hBez⟩ :=
    s2 K L ℓ hℓ (ι (γ₁ * ζ ^ m₀)) H f₁ (ι ε₀) θ' hγ0 hf0 he hθ' hθ'f
  have hF0' : (H ^ ℓ - f₁) / ι (γ₁ * ζ ^ m₀) ^ ℓ =
      -(G.eval₂ ι S + ι b ^ (M - m₀) * S ^ M * y) := by
    rw [div_eq_iff (pow_ne_zero _ hγ0)]
    linear_combination (-1 : K) * hEq

  have hδ : ∀ k : ℕ, algebraMap A K d ^ k ∈ Algebra.adjoin A {S} := by
    intro k
    rw [← map_pow]
    exact Subalgebra.algebraMap_mem _ _
  have hLalg : ∀ a : A, wcLlsKPLoc A K S d (algebraMap A K a) := fun a =>
    ⟨0, by rw [pow_zero, one_mul]; exact Subalgebra.algebraMap_mem _ a⟩
  have hLι : ∀ x : ↥W, wcLlsKPLoc A K S d (ι x) := fun x => hLalg (algebraMap ↥W A x)
  have hLS : wcLlsKPLoc A K S d S :=
    ⟨0, by rw [pow_zero, one_mul]; exact Algebra.subset_adjoin (Set.mem_singleton _)⟩
  have hLzero : wcLlsKPLoc A K S d 0 := ⟨0, by rw [mul_zero]; exact zero_mem _⟩
  have hLone : wcLlsKPLoc A K S d 1 := ⟨0, by rw [pow_zero, one_mul]; exact one_mem _⟩
  have hL0 : ∀ x : K, wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K S d x := by
    rintro x ⟨n, hn⟩
    exact ⟨n, Algebra.adjoin_le (Set.singleton_subset_iff.mpr (zero_mem _)) hn⟩
  have hLadd : ∀ x y : K, wcLlsKPLoc A K S d x → wcLlsKPLoc A K S d y →
      wcLlsKPLoc A K S d (x + y) := by
    rintro x y ⟨n, hn⟩ ⟨m, hm⟩
    refine ⟨n + m, ?_⟩
    have e : algebraMap A K d ^ (n + m) * (x + y) = algebraMap A K d ^ m *
        (algebraMap A K d ^ n * x) + algebraMap A K d ^ n * (algebraMap A K d ^ m * y) := by ring
    rw [e]
    exact add_mem (mul_mem (hδ m) hn) (mul_mem (hδ n) hm)
  have hLmul : ∀ x y : K, wcLlsKPLoc A K S d x → wcLlsKPLoc A K S d y →
      wcLlsKPLoc A K S d (x * y) := by
    rintro x y ⟨n, hn⟩ ⟨m, hm⟩
    refine ⟨n + m, ?_⟩
    have e : algebraMap A K d ^ (n + m) * (x * y) =
        (algebraMap A K d ^ n * x) * (algebraMap A K d ^ m * y) := by ring
    rw [e]
    exact mul_mem hn hm
  have hLneg : ∀ x : K, wcLlsKPLoc A K S d x → wcLlsKPLoc A K S d (-x) := by
    rintro x ⟨n, hn⟩
    refine ⟨n, ?_⟩
    rw [mul_neg]
    exact neg_mem hn
  have hLpow : ∀ (x : K) (n : ℕ), wcLlsKPLoc A K S d x → wcLlsKPLoc A K S d (x ^ n) := by
    intro x n hx
    induction n with
    | zero => rw [pow_zero]; exact hLone
    | succ n ih => rw [pow_succ]; exact hLmul _ _ ih hx
  have hLnat : ∀ n : ℕ, wcLlsKPLoc A K S d (n : K) := by
    intro n
    have := hLalg (n : A)
    rwa [map_natCast] at this
  have hLH : wcLlsKPLoc A K S d H := by
    rw [← hHa]
    exact hLalg _
  have hLy : wcLlsKPLoc A K S d y := hL0 y hy
  have hLf1i : wcLlsKPLoc A K S d f₁⁻¹ := hL0 _ hf1i
  have hLGS : wcLlsKPLoc A K S d (G.eval₂ ι S) := by
    refine ⟨0, ?_⟩
    rw [pow_zero, one_mul]
    have : G.eval₂ ι S = Polynomial.aeval S (G.map (algebraMap ↥W A)) := by
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
    rw [this]
    exact Polynomial.aeval_mem_adjoin_singleton A S

  have hω : ((ℓ : ℕ) : ↥W) ≠ 0 := by
    intro h0
    have h1 : (ℓ : Ω) = 0 := by rw [← map_natCast (algebraMap ↥W Ω), h0, map_zero]
    have h2 := ringChar.dvd h1
    rcases hℓ.eq_one_or_self_of_dvd _ h2 with h3 | h3
    · exact CharP.ringChar_ne_one h3
    · exact hΩ h3

  have hDa := congrArg (Polynomial.eval₂ (algebraMap ↥W A) (t - algebraMap ↥W A c))
    (Polynomial.divX_mul_X_add h)
  simp only [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X,
    Polynomial.eval₂_C] at hDa
  obtain ⟨ra, hra⟩ := sub_dvd_pow_sub_pow (h.eval₂ (algebraMap ↥W A) (t - algebraMap ↥W A c))
    (algebraMap ↥W A (h.coeff 0)) (ℓ - 1)
  have hraK : H ^ (ℓ - 1) - ι (h.coeff 0) ^ (ℓ - 1) = (H - ι (h.coeff 0)) * algebraMap A K ra := by
    have := congrArg (algebraMap A K) hra
    simp only [map_sub, map_pow, map_mul, hHa] at this
    exact this
  have hDaK : algebraMap A K (h.divX.eval₂ (algebraMap ↥W A) (t - algebraMap ↥W A c)) *
      (ι b * S) + ι (h.coeff 0) = H := by
    have := congrArg (algebraMap A K) hDa
    rw [map_add, map_mul, hHa, huS] at this
    exact this
  have hF1 : F.coeff 1 = ι ε₀ * H ^ (ℓ - 1) := by
    rw [hFmid 1 le_rfl hℓ.one_lt, Nat.choose_one_right, Nat.div_self hℓ.pos, Nat.cast_one,
      one_mul, Nat.sub_self, pow_zero, mul_one]
  refine ⟨w, F, ε₀ * h.coeff 0 ^ (ℓ - 1), G, (ℓ : ↥W),
    ⟨hd, hω, hw, hFm, hFd, hFr, ?_, ?_, ?_, ?_, ?_⟩, ?_⟩
  ·
    intro i
    rcases Nat.lt_or_ge ℓ i with hi | hi
    · rw [hFgt i hi]; exact hLzero
    rcases Nat.eq_or_lt_of_le hi with hi' | hi'
    · rw [hi', hFp]; exact hLone
    rcases Nat.eq_zero_or_pos i with hi0 | hi0
    · rw [hi0, hF0, hF0']
      exact hLneg _ (hLadd _ _ hLGS (hLmul _ _ (hLmul _ _ (hLpow _ _ (hLι b)) (hLpow _ _ hLS)) hLy))
    · rw [hFmid i hi0 hi']
      exact hLmul _ _ (hLmul _ _ (hLmul _ _ (hLnat _) (hLι _)) (hLpow _ _ (hLι _)))
        (hLpow _ _ hLH)
  ·
    refine ⟨Polynomial.C (-(ℓ : K) * ι (γ₁ * ζ ^ m₀) ^ ℓ * f₁⁻¹),
      Polynomial.C (ι (γ₁ * ζ ^ m₀) ^ ℓ * f₁⁻¹) * Polynomial.X +
        Polynomial.C (ι (γ₁ * ζ ^ m₀) ^ (ℓ - 1) * H * f₁⁻¹), ?_, ?_, ?_⟩
    · intro i
      rw [Polynomial.coeff_C]
      split_ifs
      · exact hLmul _ _ (hLmul _ _ (hLneg _ (hLnat ℓ)) (hLpow _ _ (hLι _))) hLf1i
      · exact hLzero
    · intro i
      rw [Polynomial.coeff_add]
      apply hLadd
      · rw [Polynomial.coeff_C_mul_X]
        split_ifs
        · exact hLmul _ _ (hLpow _ _ (hLι _)) hLf1i
        · exact hLzero
      · rw [Polynomial.coeff_C]
        split_ifs
        · exact hLmul _ _ (hLmul _ _ (hLpow _ _ (hLι _)) hLH) hLf1i
        · exact hLzero
    · rw [hBez]
      simp only [map_natCast]
  ·
    intro i hi2 hiℓ
    refine ⟨γ₁ * ζ ^ m₀, hγ₂m,
      ((ℓ.choose i / ℓ : ℕ) : K) * ι ε₀ * ι (γ₁ * ζ ^ m₀) ^ (i - 2) * H ^ (ℓ - i), ?_, ?_⟩
    · exact hLmul _ _ (hLmul _ _ (hLmul _ _ (hLnat _) (hLι _)) (hLpow _ _ (hLι _)))
        (hLpow _ _ hLH)
    · show F.coeff i = ι (γ₁ * ζ ^ m₀) * _
      rw [hFmid i (by omega) hiℓ]
      have e : ι (γ₁ * ζ ^ m₀) ^ (i - 1) = ι (γ₁ * ζ ^ m₀) * ι (γ₁ * ζ ^ m₀) ^ (i - 2) := by
        rw [← pow_succ']
        congr 1
        omega
      rw [e]
      ring
  ·
    refine ⟨b, hb, ι ε₀ * S *
      algebraMap A K (h.divX.eval₂ (algebraMap ↥W A) (t - algebraMap ↥W A c)) *
      algebraMap A K ra, ?_, ?_⟩
    · exact hLmul _ _ (hLmul _ _ (hLmul _ _ (hLι _) hLS) (hLalg _)) (hLalg _)
    · show F.coeff 1 - ι (ε₀ * h.coeff 0 ^ (ℓ - 1)) = ι b * _
      rw [hF1, map_mul, map_pow]
      linear_combination (ι ε₀) * hraK - (ι ε₀ * algebraMap A K ra) * hDaK
  ·
    refine ⟨b, hb, -(ι b ^ (M - m₀ - 1) * S ^ M * y), ?_, ?_⟩
    · exact hLneg _ (hLmul _ _ (hLmul _ _ (hLpow _ _ (hLι b)) (hLpow _ _ hLS)) hLy)
    · show F.coeff 0 + G.eval₂ ι S = ι b * _
      rw [hF0, hF0']
      have e : ι b ^ (M - m₀) = ι b * ι b ^ (M - m₀ - 1) := by
        rw [← pow_succ']
        congr 1
        omega
      rw [e]
      ring
  ·
    rcases hcase with hu | ⟨hε₀m, k, hk2, hkm, hℓk, ⟨e, heu, hgk⟩, π, hπ, hg1⟩
    · left
      exact hu.mul (hh0.pow _)
    · right
      refine ⟨Ideal.mul_mem_right _ _ hε₀m, ?_⟩
      have hbm0 : b ^ m₀ ≠ 0 := pow_ne_zero _ hb0
      have hG1 : G.coeff 1 = π := by
        apply mul_left_cancel₀ hbm0
        rw [hG 1, hg1, pow_one, ← mul_assoc, ← pow_succ', Nat.sub_add_cancel hm1]
      have hGk : G.coeff k = e := by
        apply mul_left_cancel₀ hbm0
        rw [hG k, hgk, ← mul_assoc, ← pow_add, Nat.add_sub_cancel' hkm.le]
      have hGm : G.coeff m₀ = 1 := by
        apply mul_left_cancel₀ hbm0
        rw [hG m₀, hgm]
      exact s4 Ω W hres ℓ hκ G k m₀ e π hk2 hkm hℓk hℓm heu hπ hG1 hGk hGm

theorem wcLlsKP_vde_boundary_from_newton : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ (θ' : L) (f₁ : K), θ' ∉ Set.range (algebraMap K L) → θ' ^ ℓ = algebraMap K L f₁ →
    ∀ (c b ζ γ₁ : ↥W) (d : A) (h g : Polynomial ↥W) (M m₀ : ℕ),
      wcLlsKPNewton W A K ℓ 𝔭 t f₁ c b ζ γ₁ d h g M m₀ →
      ∃ (w₁ : L) (F₁ : Polynomial K) (ω' : ↥W),
        wcLlsKPBoundaryCore W A K L ℓ 𝔭 t c b d w₁ F₁ m₀ ω' ζ :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD hdeg θ' f₁ hθ' hθ'f
    c b ζ γ₁ d h g M m₀ hN
  obtain ⟨hd, hc, hb, hb0, hζ, hγ0, -, -, hgm, hgM, hmM, hm1, hpm, hdiv, hf₁, hf₁i,
    ⟨y, hy, hid⟩, ε₀, hε, -⟩ := hN
  obtain ⟨_, hNZ, _, _, _, _, _, hh0, hh𝔭, f, hfC, hfX, hfet⟩ := hPD
  haveI : NoZeroSMulDivisors ↥W A := hNZ
  have hℓ1 : 1 ≤ ℓ := hℓ.one_lt.le


  have hKum : ∀ (r a : K), a ≠ 0 → ∀ F : Polynomial K,
      F = (Polynomial.X + Polynomial.C r) ^ ℓ - Polynomial.C a →
      F.Monic ∧ F.natDegree = ℓ ∧
      (∀ i : ℕ, F.coeff i = r ^ (ℓ - i) * (ℓ.choose i : K) - (if i = 0 then a else 0)) ∧
      Polynomial.C (-(ℓ : K) * a⁻¹) * F +
        Polynomial.C a⁻¹ * (Polynomial.X + Polynomial.C r) * Polynomial.derivative F =
        Polynomial.C (ℓ : K) := by
    intro r a ha F hF
    subst hF
    have hZm : ((Polynomial.X + Polynomial.C r) ^ ℓ).Monic := (Polynomial.monic_X_add_C r).pow ℓ
    have hZ : ((Polynomial.X + Polynomial.C r) ^ ℓ).natDegree = ℓ := by
      rw [(Polynomial.monic_X_add_C r).natDegree_pow, Polynomial.natDegree_X_add_C, mul_one]
    refine ⟨?_, ?_, ?_, ?_⟩
    · apply hZm.sub_of_left
      rw [Polynomial.degree_eq_natDegree hZm.ne_zero, hZ]
      exact lt_of_le_of_lt Polynomial.degree_C_le (by exact_mod_cast hℓ1)
    · rw [Polynomial.natDegree_sub_C, hZ]
    · intro i
      rw [Polynomial.coeff_sub, Polynomial.coeff_X_add_C_pow, Polynomial.coeff_C]
    · obtain ⟨k, hk⟩ : ∃ k, ℓ = k + 1 := ⟨ℓ - 1, by omega⟩
      rw [hk, Polynomial.derivative_sub, Polynomial.derivative_C, sub_zero,
        Polynomial.derivative_X_add_C_pow, Nat.add_sub_cancel]
      have key : Polynomial.C a⁻¹ * Polynomial.C a = (1 : Polynomial K) := by
        rw [← Polynomial.C_mul, inv_mul_cancel₀ ha, Polynomial.C_1]
      rw [Polynomial.C_mul, Polynomial.C_neg]
      linear_combination (Polynomial.C ((k + 1 : ℕ) : K)) * key

  have hL3 : ∀ (φ : ↥W →+* K) (β : ↥W) (g' : ℕ → ↥W),
      (∀ j, j < m₀ → g.coeff j = β ^ (m₀ - j) * g' j) → ∀ (u' y' : K), u' ≠ 0 →
      (g.eval₂ φ u' + u' ^ M * y') / u' ^ m₀ - 1 =
        u' * (∑ j ∈ Finset.Ico (m₀ + 1) M, φ (g.coeff j) * u' ^ (j - m₀ - 1) +
          u' ^ (M - m₀ - 1) * y') +
        φ β / u' * ∑ j ∈ Finset.range m₀, φ (g' j) * (φ β / u') ^ (m₀ - j - 1) := by
    intro φ β g' hg' u' y' hu
    rw [div_sub_one (pow_ne_zero _ hu), div_eq_iff (pow_ne_zero _ hu),
      Polynomial.eval₂_eq_sum_range' φ hgM,
      ← Finset.sum_range_add_sum_Ico _ (show m₀ + 1 ≤ M by omega),
      Finset.sum_range_succ, hgm, map_one, one_mul]
    have hA : ∑ j ∈ Finset.range m₀, φ (g.coeff j) * u' ^ j =
        φ β / u' * (∑ j ∈ Finset.range m₀, φ (g' j) * (φ β / u') ^ (m₀ - j - 1)) * u' ^ m₀ := by
      rw [Finset.mul_sum, Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro j hj
      have hj' : j < m₀ := Finset.mem_range.mp hj
      obtain ⟨k, hk⟩ : ∃ k, m₀ = j + k + 1 := ⟨m₀ - j - 1, by omega⟩
      rw [hg' j hj', map_mul, map_pow, show m₀ - j - 1 = k by omega,
        show m₀ - j = k + 1 by omega, hk]
      rw [show φ β / u' * (φ (g' j) * (φ β / u') ^ k) * u' ^ (j + k + 1) =
          φ β ^ (k + 1) * φ (g' j) * u' ^ j * ((u' * u' ^ k) * (u' * u' ^ k)⁻¹) by
            rw [div_pow]; ring,
