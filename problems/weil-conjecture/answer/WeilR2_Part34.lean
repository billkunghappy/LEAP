theorem wcpa_dj_llsm_isir_contraction : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L]
    (𝔭 : Ideal A) (u v : A) (g a' q'' q' : ↥W)
    (A₃ : Type u) [CommRing A₃] [IsDomain A₃] [Algebra ↥W A₃] [Algebra A₃ K]
    [IsFractionRing A₃ K] (u₃ v₃ : A₃) (𝔭₃ : Ideal A₃),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → q'' ∈ IsLocalRing.maximalIdeal ↥W →
    g = a' * q'' → q' ∈ IsLocalRing.maximalIdeal ↥W → q' ≠ 0 → q' ∣ q'' →
    wcLlsBrSub W A K A₃ (algebraMap A K u / algebraMap A K (algebraMap ↥W A a'))
      {algebraMap A K u / algebraMap A K (algebraMap ↥W A a'), algebraMap A K v} →
    algebraMap A₃ K u₃ = algebraMap A K u / algebraMap A K (algebraMap ↥W A a') →
    algebraMap A₃ K v₃ = algebraMap A K v →
    wcLlsPD W A₃ 𝔭₃ (.ann u₃ v₃ q'') →
    ∀ (s : K), s = algebraMap A K (algebraMap ↥W A (a' * q')) / algebraMap A K u →
    ∀ (s₃ : K), s₃ = algebraMap A₃ K (algebraMap ↥W A₃ q') / algebraMap A₃ K u₃ →
    ∀ (𝔮 : Ideal ↥(integralClosure ↥(Algebra.adjoin A₃ {s₃}) L)) [𝔮.IsPrime],
    𝔮.comap (algebraMap ↥(Algebra.adjoin A₃ {s₃}) ↥(integralClosure ↥(Algebra.adjoin A₃ {s₃}) L)) =
      Ideal.span {algebraMap A₃ ↥(Algebra.adjoin A₃ {s₃}) u₃,
        ⟨s₃, Algebra.subset_adjoin (Set.mem_singleton s₃)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A₃ ↥(Algebra.adjoin A₃ {s₃})).comp (algebraMap ↥W A₃)) →
    ∃ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) (_ : Q.IsPrime),
      Q.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) =
        Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) u,
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) ∧
      ∀ y : ↥(integralClosure ↥(Algebra.adjoin A {s}) L),
        ∃ z : ↥(integralClosure ↥(Algebra.adjoin A₃ {s₃}) L),
          (z : L) = (y : L) ∧ (y ∈ Q ↔ z ∈ 𝔮) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ 𝔭 u v g a' q'' q' A₃ _ _ _ _ _ u₃ v₃ 𝔭₃ hPD ha'm
    ha'0 hq''m hg hq'm hq'0 hq'q'' hBr hu₃ hv₃ hPD₃ s hs s₃ hs₃ 𝔮 _ h𝔮
  classical
  obtain ⟨-, hNZ, -, h𝔭max, -, -, hg0, huv, h𝔭eq, -⟩ := hPD
  haveI := hNZ
  obtain ⟨hBr1, hBr2, -⟩ := hBr

  have hιinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hιW0 : ∀ t : ↥W, t ≠ 0 → algebraMap A K (algebraMap ↥W A t) ≠ 0 := by
    intro t ht h
    have h1 : algebraMap ↥W A t = 0 := hιinj (by rw [h, map_zero])
    rw [Algebra.algebraMap_eq_smul_one] at h1
    rcases smul_eq_zero.mp h1 with h2 | h2
