  have nf_split : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (K : Type u) [Field K] (O : ValuationSubring K) (φ : ↥W →+* K) (ℓ : ℕ), ℓ.Prime → (∀ a : ↥W, φ a ∈ O) → (∀ a : ↥W, a ∈ IsLocalRing.maximalIdeal ↥W → O.valuation (φ a) < 1) → (∀ a : ↥W, ∃ z : ↥W, z ^ ℓ = a) → ∀ β : ↥W, β ^ (ℓ - 1) = ((ℓ : ℕ) : ↥W) → β ≠ 0 → ((ℓ : ℕ) : ↥W) ∈ IsLocalRing.maximalIdeal ↥W → ∀ (ι : Type u) (u : ι → K), (∀ j, u j ∈ O) → (∀ d : ι →₀ ↥W, d ≠ 0 → ∃ (α : ↥W) (e : ι →₀ ↥W), α ≠ 0 ∧ (∃ j, e j ∉ IsLocalRing.maximalIdeal ↥W) ∧ d = α • e) → ∀ (f₁ H q Y : K) (d : ι →₀ ↥W), H ∈ O → q ∈ O → Y ∈ O → H ^ ℓ = 1 + ((ℓ : ℕ) : K) * q → f₁ = H ^ ℓ * (1 + ((ℓ : ℕ) : K) * (d.sum fun j a => φ a * u j)) + φ β ^ ℓ * Y → O.valuation (H - 1) < 1 ∧ ((∃ y : K, y ∈ O ∧ f₁ - H ^ ℓ = φ β ^ ℓ * y) ∨ ∃ (γ σ : ↥W) (e : ι →₀ ↥W) (g : K), γ ≠ 0 ∧ σ ∈ IsLocalRing.maximalIdeal ↥W ∧ (∃ j, e j ∉ IsLocalRing.maximalIdeal ↥W) ∧ β = γ * σ ∧ g ∈ O ∧ f₁ - H ^ ℓ = φ γ ^ ℓ * g ∧ O.valuation (g - (e.sum fun j a => φ a * u j)) < 1) := by
