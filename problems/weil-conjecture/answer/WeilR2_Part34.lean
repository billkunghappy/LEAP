  have hχA : ∀ a : A, χ (algebraMap A ↥R a) = Polynomial.C (Ideal.Quotient.mk 𝔭 a) := by
    intro a
    have := key (Polynomial.C a)
    rwa [Polynomial.aeval_C, Polynomial.map_C] at this



  set mR := (IsLocalRing.maximalIdeal ↥W).map ι with hmR



  have hmR_mem : ∀ π ∈ IsLocalRing.maximalIdeal ↥W, ι π ∈ mR :=
    fun π hπ => Ideal.mem_map_of_mem _ hπ
  have htR : algebraMap A ↥R t = ι c + ι b * Sr := by
    apply Subtype.ext
