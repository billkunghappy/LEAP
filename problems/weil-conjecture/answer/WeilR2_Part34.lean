  rw [← hσb] at hf
  have hφσ : φ.comp σb = σQ := by
    rw [hσb, hσQ]; ext x; simp only [RingHom.comp_apply]; exact hφA _
  obtain ⟨w2, hw2⟩ : ∃ w : Localization.AtPrime Q,
      w = algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
        (Localization.AtPrime Q)
      (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
        (1 + ⟨wcLlsScS W A K t c' r, Algebra.subset_adjoin (Set.mem_singleton _)⟩)) :=
    ⟨_, rfl⟩
  have hφsw : φ (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)
        (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩)) * w2 = σQ q := by
    apply hι
    rw [hw2, map_mul, hιφ, hιc, hσQ]
    simp only [RingHom.comp_apply]
    rw [hιc]
    show algebraMap K L s * algebraMap K L (1 + wcLlsScS W A K t c' r) =
      algebraMap K L (algebraMap A K (algebraMap ↥W A q))
    rw [← map_mul, hsq]

  haveI hCbic : IsIntegrallyClosed ↥(integralClosure ↥(Algebra.adjoin A {s}) L) :=
    integralClosure.isIntegrallyClosedOfFiniteExtension K
  haveI hC2ic : IsIntegrallyClosed
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L) :=
    integralClosure.isIntegrallyClosedOfFiniteExtension K
  haveI hObic : IsIntegrallyClosed (Localization.AtPrime Qb) :=
    isIntegrallyClosed_of_isLocalization _ Qb.primeCompl (Ideal.primeCompl_le_nonZeroDivisors Qb)
  haveI hOQic : IsIntegrallyClosed (Localization.AtPrime Q) :=
    isIntegrallyClosed_of_isLocalization _ Q.primeCompl (Ideal.primeCompl_le_nonZeroDivisors Q)
  have hmQp : (IsLocalRing.maximalIdeal (Localization.AtPrime Q)).IsPrime :=
    (IsLocalRing.maximalIdeal.isMaximal _).isPrime
  have hmbp : (IsLocalRing.maximalIdeal (Localization.AtPrime Qb)).IsPrime :=
    (IsLocalRing.maximalIdeal.isMaximal _).isPrime
  obtain ⟨P₂, _, e₂, he₂⟩ := wcNd_hens_exists (Localization.AtPrime Q) _ hmQp
  obtain ⟨hP₂dom, hP₂ic⟩ := wcNd_hens_normal_domain (Localization.AtPrime Q) _ hmQp P₂ e₂ he₂
  haveI := hP₂dom
  haveI := hP₂ic
  haveI hP₂h : HenselianLocalRing P₂ := he₂.1
  have he₂inj : Function.Injective e₂ := (wcpa_dj_lr1k_ebnb_hens_inj _ _ hmQp P₂ e₂ he₂).1
  have hunit : ∀ a, IsUnit ((e₂.comp φ) a) ↔
