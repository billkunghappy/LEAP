    exact le_trans h𝔭₀le h𝔭N)

  have hNmax := wcpa_dj_llsm_brrm_node_max Ω W hW hWt A K 𝔭 (.ann u v g) u b
    hPD (Or.inr ⟨v, g, rfl, hbg⟩) hbm hb0 s hs
    (by rw [← hNdef, ← hQb]; exact (Ideal.comap_isPrime _ Qb).ne_top)
  haveI hNm : N.IsMaximal := by rw [hNdef]; exact hNmax
  have hRN : IsIntegrallyClosed (Localization.AtPrime N) :=
    (wcpa_dj_llsm_brrm_node_pres Ω W hW hWt A K 𝔭 (.ann u v g) u b
      hPD (Or.inr ⟨v, g, rfl, hbg⟩) hbm hb0 s hs N hNdef).2.1

  have hinj : Function.Injective
      (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) := by
    intro x y hxy
    have h1 := congrArg (fun z : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) => (z : L)) hxy
    have h2 : algebraMap K L (x : K) = algebraMap K L (y : K) := h1
    exact Subtype.ext ((algebraMap K L).injective h2)
  obtain ⟨𝔮₁, h𝔮₁p, h𝔮₁le, h𝔮₁c⟩ := wcpa_dj_llsm_scbc_normal_going_down _ _ hinj N hRN Qb
    inferInstance hQb 𝔫₁ h𝔫₁p h𝔫₁N

  have hdisj : Disjoint (Qb.primeCompl : Set ↥(integralClosure ↥(Algebra.adjoin A {s}) L))
      (𝔮₁ : Set ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) := by
    rw [Set.disjoint_left]
    intro x hx hx'
    exact hx (h𝔮₁le hx')
  have h𝔮₁'p : (𝔮₁.map (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
      (Localization.AtPrime Qb))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint Qb.primeCompl (Localization.AtPrime Qb) 𝔮₁
      h𝔮₁p hdisj
  have h𝔮₁'c : (𝔮₁.map (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
      (Localization.AtPrime Qb))).comap (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
      (Localization.AtPrime Qb)) = 𝔮₁ :=
    IsLocalization.under_map_of_isPrime_disjoint Qb.primeCompl (Localization.AtPrime Qb)
      h𝔮₁p hdisj

  have h𝔮₁'le : 𝔮₁.map (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
      (Localization.AtPrime Qb)) ≤ 𝔓.comap e := by
    rw [h𝔮max]
    exact IsLocalRing.le_maximalIdeal h𝔮₁'p.ne_top
  obtain ⟨𝔓₁, h𝔓₁p, h𝔓₁le, h𝔓₁c⟩ :=
    wcpa_dj_llsm_scbc_hens_going_down (Localization.AtPrime Qb) P e he
      (𝔮₁.map (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
        (Localization.AtPrime Qb))) 𝔓 h𝔮₁'p h𝔓p h𝔮₁'le

  have hm𝔓₁ : Ideal.map (e.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
          (Localization.AtPrime Qb)).comp ((algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)))))
          (IsLocalRing.maximalIdeal ↥W) ≤ 𝔓₁ := by
    rw [Ideal.map_le_iff_le_comap]
    intro w hw
    have h1 : algebraMap ↥W A w ∈ 𝔭₀ := h𝔭₀m (Ideal.mem_map_of_mem _ hw)
    have h2 : algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w) ∈ 𝔫₁ := by
      rw [← h𝔫₁c] at h1; exact h1
    have h3 : algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
        (algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w)) ∈ 𝔮₁ := by
      rw [← h𝔮₁c] at h2; exact h2
    have h4 := Ideal.mem_map_of_mem
      (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)) h3
    rw [← h𝔓₁c] at h4
    exact h4

  have h𝔓le : 𝔓 ≤ 𝔓₁ := h𝔓min ⟨h𝔓₁p, hm𝔓₁⟩ h𝔓₁le
  have h5 : algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)
      (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
        (algebraMap A ↥(Algebra.adjoin A {s}) u)) ∈
      𝔮₁.map (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
        (Localization.AtPrime Qb)) := by
    rw [← h𝔓₁c]; exact h𝔓le hu𝔓
  have h6 : algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
      (algebraMap A ↥(Algebra.adjoin A {s}) u) ∈ 𝔮₁ := by
    rw [← h𝔮₁'c]; exact h5
  have h7 : algebraMap A ↥(Algebra.adjoin A {s}) u ∈ 𝔫₁ := by
    rw [← h𝔮₁c]; exact h6
  exact hu𝔭₀ (by rw [← h𝔫₁c]; exact h7)

theorem wcpa_dj_llsm_isirnd_flat_extend : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (μ g₁ : ↥W), μ ≠ 0 → g₁ ≠ 0 → ∀ (ι₀ : wcEbntN W (μ * g₁) →+* wcEbntN W g₁), ι₀.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = (Ideal.Quotient.mk _).comp MvPolynomial.C → ι₀ (wcEbntX W (μ * g₁) 1) = Ideal.Quotient.mk _ (MvPolynomial.C μ) * wcEbntX W g₁ 1 → ∀ (P : Type u) [CommRing P] (f : wcEbntN W (μ * g₁) →+* P), @RingHom.Flat (wcEbntN W (μ * g₁)) P _ _ f → ∀ (q : Polynomial P), Polynomial.eval (f (wcEbntX W (μ * g₁) 1)) (q.scaleRoots (f (Ideal.Quotient.mk _ (MvPolynomial.C μ)))) = 0 → ∀ (B : Type u) [CommRing B] (k : P →+* B) (g : wcEbntN W g₁ →+* B), k.comp f = g.comp ι₀ → Polynomial.eval₂ k (g (wcEbntX W g₁ 1)) q = 0 :=
by
  intro Ω _ W μ g₁ hμ hg ι₀ hC h1 P _ f hflat q hq B _ k g hkg

  have generic : ∀ (N₀ N₁ P B : Type u) [CommRing N₀] [CommRing N₁] [IsDomain N₁] [CommRing P]
      [CommRing B] (ι₀ : N₀ →+* N₁) (m₀ x₀ : N₀) (m₁ x₁ : N₁), m₁ ≠ 0 → ι₀ m₀ = m₁ →
      ι₀ x₀ = m₁ * x₁ → ∀ (f : N₀ →+* P), @RingHom.Flat N₀ P _ _ f → ∀ (q : Polynomial P),
      Polynomial.eval (f x₀) (q.scaleRoots (f m₀)) = 0 → ∀ (k : P →+* B) (g : N₁ →+* B),
      k.comp f = g.comp ι₀ → Polynomial.eval₂ k (g x₁) q = 0 := by
    intro N₀ N₁ P B _ _ _ _ _ ι₀ m₀ x₀ m₁ x₁ hne hιm h1 f hflat q hq k g hkg
    set n := q.natDegree with hn
    let a : Fin (n + 1) → N₀ := fun i => m₀ ^ (n - (i : ℕ)) * x₀ ^ (i : ℕ)
    have hR : ∑ i, f (a i) * q.coeff (i : ℕ) = 0 := by
      rw [← hq, Polynomial.eval_eq_sum_range, Polynomial.natDegree_scaleRoots,
        ← Fin.sum_univ_eq_sum_range]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp only [a, map_mul, map_pow, Polynomial.coeff_scaleRoots]
      ring
    letI : Algebra N₀ P := f.toAlgebra
    haveI : Module.Flat N₀ P := hflat
    have hR' : ∑ i, a i • q.coeff (i : ℕ) = 0 := by
      rw [← hR]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Algebra.smul_def]
      rfl
    obtain ⟨k₀, c, y, hc1, hc2⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (R := N₀)
      (M := P) (f := a) (x := fun i : Fin (n + 1) => q.coeff (i : ℕ)) hR'
    have hιa : ∀ i : Fin (n + 1), ι₀ (a i) = m₁ ^ n * x₁ ^ (i : ℕ) := by
      intro i
      have hi : (i : ℕ) ≤ n := Nat.lt_succ_iff.mp i.isLt
      simp only [a, map_mul, map_pow, hιm, h1, mul_pow]
      rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hi]
    have hZ : ∀ j, ∑ i : Fin (n + 1), x₁ ^ (i : ℕ) * ι₀ (c i j) = 0 := by
      intro j
      have e := congrArg ι₀ (hc2 j)
      rw [map_sum, map_zero] at e
      have e2 : m₁ ^ n * ∑ i : Fin (n + 1), x₁ ^ (i : ℕ) * ι₀ (c i j) = 0 := by
        rw [Finset.mul_sum, ← e]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [map_mul, hιa]
        ring
      exact (mul_eq_zero.mp e2).resolve_left (pow_ne_zero _ hne)
    rw [Polynomial.eval₂_eq_sum_range, ← Fin.sum_univ_eq_sum_range]
    have hterm : ∀ i : Fin (n + 1), k (q.coeff (i : ℕ)) * g x₁ ^ (i : ℕ) =
        ∑ j, k (y j) * g (x₁ ^ (i : ℕ) * ι₀ (c i j)) := by
      intro i
      rw [show q.coeff (i : ℕ) = ∑ j, c i j • y j from hc1 i, map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [Algebra.smul_def, map_mul, RingHom.algebraMap_toAlgebra, ← RingHom.comp_apply k f, hkg,
        RingHom.comp_apply, map_mul, map_pow]
      ring
    rw [Finset.sum_congr rfl (fun i _ => hterm i), Finset.sum_comm]
    refine Finset.sum_eq_zero (fun j _ => ?_)
    rw [← Finset.mul_sum, ← map_sum, hZ j, map_zero, mul_zero]

  have hne : (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C g₁} : Ideal (MvPolynomial (Fin 2) ↥W)) (MvPolynomial.C μ)) ≠ 0 := by
    intro h0
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at h0
    obtain ⟨r, hr⟩ := h0
    have e := congrArg (MvPolynomial.eval₂Hom (RingHom.id ↥W) ![g₁, 1]) hr
    rw [map_mul, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
      MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C] at e
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, mul_one, sub_self,
      mul_zero, RingHom.id_apply] at e
    exact hμ e.symm
  haveI : IsDomain (wcEbntN W g₁) := (wcNd_nodal_poly_normal Ω W g₁ hg).1
  exact generic (wcEbntN W (μ * g₁)) (wcEbntN W g₁) P B ι₀
    (Ideal.Quotient.mk _ (MvPolynomial.C μ)) (wcEbntX W (μ * g₁) 1)
    (Ideal.Quotient.mk _ (MvPolynomial.C μ)) (wcEbntX W g₁ 1) hne (RingHom.congr_fun hC μ) h1
    f hflat q hq k g hkg

theorem wcpa_dj_llsm_isirnd_hens_max : ∀ (A : Type u) [CommRing A] (p : Ideal A), p.IsMaximal → ∀ (P : Type u) [CommRing P] (e : A →+* P), wcNdIsHens p P e → ∀ x : P, ¬ IsUnit x → x ∈ p.map e :=
by
  intro A _ p hp P _ e hH x hx
  obtain ⟨hP, hunit, hUP⟩ := hH
  haveI := hP
  haveI := hp

  have s1 : ∀ (I : Ideal P), I ≠ ⊤ → HenselianLocalRing (P ⧸ I) := by
    intro I hI
    haveI : Nontrivial (P ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
    haveI : IsLocalRing (P ⧸ I) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    haveI : IsLocalHom (Ideal.Quotient.mk I) :=
      IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
    have hmem : ∀ y : P, Ideal.Quotient.mk I y ∈ IsLocalRing.maximalIdeal (P ⧸ I) ↔
        y ∈ IsLocalRing.maximalIdeal P := by
      intro y
      rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
        mem_nonunits_iff]
      exact not_congr ⟨fun h => IsUnit.of_map _ _ h, fun h => h.map _⟩
    have e1 : ∀ (q : Polynomial P) (y : P), Ideal.Quotient.mk I (q.eval y) =
        (q.map (Ideal.Quotient.mk I)).eval (Ideal.Quotient.mk I y) := by
      intro q y
      rw [Polynomial.eval_map, Polynomial.eval₂_at_apply]
    refine { is_henselian := ?_ }
    intro f hf a₀ h₁ h₂
    have hl : f ∈ Polynomial.lifts (Ideal.Quotient.mk I) :=
      Polynomial.map_surjective _ Ideal.Quotient.mk_surjective f
    obtain ⟨g, hgf, -, hgm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hl hf
    obtain ⟨b₀, rfl⟩ := Ideal.Quotient.mk_surjective a₀
    rw [← hgf, ← e1] at h₁
    rw [← hgf, Polynomial.derivative_map, ← e1] at h₂
    obtain ⟨a, ha, haa⟩ :=
      HenselianLocalRing.is_henselian g hgm b₀ ((hmem _).mp h₁) (IsUnit.of_map _ _ h₂)
    refine ⟨Ideal.Quotient.mk I a, ?_, ?_⟩
    · show f.eval (Ideal.Quotient.mk I a) = 0
      rw [← hgf, ← e1, ha.eq_zero, map_zero]
    · rw [← map_sub]
      exact (hmem _).mpr haa

  have hIm : p.map e ≤ IsLocalRing.maximalIdeal P := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    exact (hunit a).mp hu ha
  have hIne : p.map e ≠ ⊤ := fun h =>
    (IsLocalRing.maximalIdeal.isMaximal P).ne_top (top_le_iff.mp (h ▸ hIm))
  haveI : Nontrivial (P ⧸ p.map e) := Ideal.Quotient.nontrivial_iff.mpr hIne

  letI : Field (A ⧸ p) := Ideal.Quotient.field p
  have hκ : ∀ a, IsUnit (Ideal.Quotient.mk p a) ↔ a ∉ p := by
    intro a
    rw [isUnit_iff_ne_zero, Ne, Ideal.Quotient.eq_zero_iff_mem]
  obtain ⟨h, ⟨hhe, hhl⟩, -⟩ := hUP (A ⧸ p) inferInstance (Ideal.Quotient.mk p) hκ
  haveI := hhl

  have H : ∀ a ∈ p, (Ideal.Quotient.mk (p.map e)).comp e a = 0 := fun a ha =>
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem e ha)
  let gb : A ⧸ p →+* P ⧸ p.map e := Ideal.Quotient.lift p ((Ideal.Quotient.mk (p.map e)).comp e) H
  have hgb : gb.comp (Ideal.Quotient.mk p) = (Ideal.Quotient.mk (p.map e)).comp e := by
    ext a
    rfl
  haveI : IsLocalHom gb := ⟨fun c hc => by
    rw [isUnit_iff_ne_zero]
    rintro rfl
    rw [map_zero] at hc
    exact not_isUnit_zero hc⟩

  have hg : ∀ a, IsUnit ((Ideal.Quotient.mk (p.map e)).comp e a) ↔ a ∉ p := by
    intro a
    constructor
    · intro hu ha
      rw [H a ha] at hu
      exact not_isUnit_zero hu
    · intro ha
      exact ((hunit a).mpr ha).map (Ideal.Quotient.mk (p.map e))
  obtain ⟨k, -, hk⟩ := hUP (P ⧸ p.map e) (s1 _ hIne) _ hg
  have hπ := hk (Ideal.Quotient.mk (p.map e))
    ⟨rfl, IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective⟩
  have hgh := hk (gb.comp h) ⟨by rw [RingHom.comp_assoc, hhe, hgb], inferInstance⟩
  have heq : Ideal.Quotient.mk (p.map e) = gb.comp h := hπ.trans hgh.symm

  have hx0 : h x = 0 := by
    by_contra hne
    exact hx (IsUnit.of_map h x (isUnit_iff_ne_zero.mpr hne))
  have h0 : Ideal.Quotient.mk (p.map e) x = 0 := by
    rw [heq, RingHom.comp_apply, hx0, map_zero]
  exact Ideal.Quotient.eq_zero_iff_mem.mp h0

theorem wcpa_dj_llsm_isirnd_adjoin_lift : ∀ (P K B : Type u) [CommRing P] [CommRing K] [Algebra P K] [CommRing B] (Y' : K) (k : P →+* B) (b : B), (∀ q : Polynomial P, Polynomial.aeval Y' q = 0 → Polynomial.eval₂ k b q = 0) → ∃ k' : ↥(Algebra.adjoin P {Y'}) →+* B, k'.comp (algebraMap P ↥(Algebra.adjoin P {Y'})) = k ∧ k' ⟨Y', Algebra.subset_adjoin (Set.mem_singleton Y')⟩ = b :=
by
  intro P K B _ _ _ _ Y' k b hq
  let π : Polynomial P →+* ↥(Algebra.adjoin P {Y'}) :=
    (Polynomial.aeval (⟨Y', Algebra.subset_adjoin (Set.mem_singleton Y')⟩ :
      ↥(Algebra.adjoin P {Y'}))).toRingHom
  have hcoe : ∀ q : Polynomial P, ((π q : ↥(Algebra.adjoin P {Y'})) : K) =
      Polynomial.aeval Y' q := by
    intro q
    exact Polynomial.aeval_subalgebra_coe q (Algebra.adjoin P {Y'})
      ⟨Y', Algebra.subset_adjoin (Set.mem_singleton Y')⟩
  have hsurj : Function.Surjective π := by
    rintro ⟨x, hx⟩
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hx
    obtain ⟨q, hqx⟩ := hx
    exact ⟨q, Subtype.ext ((hcoe q).trans hqx)⟩
  have hker : RingHom.ker π ≤ RingHom.ker (Polynomial.eval₂RingHom k b) := by
    intro q hq0
    rw [RingHom.mem_ker] at hq0 ⊢
    rw [Polynomial.coe_eval₂RingHom]
    apply hq
    rw [← hcoe q, hq0]
    simp
  refine ⟨π.liftOfSurjective hsurj ⟨Polynomial.eval₂RingHom k b, hker⟩, ?_, ?_⟩
  · ext p
    have h1 : algebraMap P ↥(Algebra.adjoin P {Y'}) p = π (Polynomial.C p) := by
      simp [π]
    rw [RingHom.comp_apply, h1, RingHom.liftOfSurjective_comp_apply]
    simp
  · have h2 : (⟨Y', Algebra.subset_adjoin (Set.mem_singleton Y')⟩ :
        ↥(Algebra.adjoin P {Y'})) = π Polynomial.X := by
      simp [π]
    rw [h2, RingHom.liftOfSurjective_comp_apply]
    simp

theorem wcpa_dj_llsm_isirnd_hens_transfer : ∀ (N₀ N₁ P D P' : Type u) [CommRing N₀] [CommRing N₁] [CommRing P] [CommRing D] [CommRing P'] (𝔪₀ : Ideal N₀) (𝔪₁ : Ideal N₁) (𝔐 : Ideal D) (f : N₀ →+* P) (ι₀ : N₀ →+* N₁) (j : P →+* D) (ψ : N₁ →+* D) (e' : D →+* P'), wcNdIsHens 𝔪₀ P f → wcNdIsHens 𝔐 P' e' → j.comp f = ψ.comp ι₀ → 𝔐.comap ψ = 𝔪₁ → 𝔪₁.comap ι₀ = 𝔪₀ → (∀ p : P, j p ∈ 𝔐 ↔ ¬ IsUnit p) → (∀ (B : Type u) [CommRing B] (h₁ h₂ : D →+* B), h₁.comp j = h₂.comp j → h₁.comp ψ = h₂.comp ψ → h₁ = h₂) → (∀ (B : Type u) [CommRing B] (k : P →+* B) (g : N₁ →+* B), k.comp f = g.comp ι₀ → ∃ k' : D →+* B, k'.comp j = k ∧ k'.comp ψ = g) → (∀ 𝔔 : Ideal D, 𝔔.IsPrime → (∀ p : P, ¬ IsUnit p → j p ∈ 𝔔) → (∀ t ∈ 𝔪₁, ψ t ∈ 𝔔) → 𝔔 = 𝔐) → wcNdIsHens 𝔪₁ P' (e'.comp ψ) :=
by
  intro N₀ N₁ P D P' _ _ _ _ _ 𝔪₀ 𝔪₁ 𝔐 f ι₀ j ψ e' h1 h2 h3 h4 h5 h6 h7 h8 h9
  obtain ⟨_H1, _H2, H3⟩ := h1
  obtain ⟨E1, E2, E3⟩ := h2
  refine ⟨E1, ?_, ?_⟩
  · intro t
    rw [RingHom.comp_apply, E2, ← h4, Ideal.mem_comap]
  · intro B _ hB g hg
    haveI : IsLocalRing B := hB.toIsLocalRing
    have hmem : ∀ x : B, x ∈ IsLocalRing.maximalIdeal B ↔ ¬ IsUnit x := fun x =>
      IsLocalRing.mem_maximalIdeal x
    have hg0 : ∀ a, IsUnit ((g.comp ι₀) a) ↔ a ∉ 𝔪₀ := by
      intro a
      rw [RingHom.comp_apply, hg, ← h5, Ideal.mem_comap]
    obtain ⟨k, ⟨hk, hkl⟩, huniqk⟩ := H3 B hB (g.comp ι₀) hg0
    obtain ⟨kt, hktj, hktψ⟩ := h8 B k g hk
    have hQ : (IsLocalRing.maximalIdeal B).comap kt = 𝔐 := by
      haveI : (IsLocalRing.maximalIdeal B).IsPrime := (IsLocalRing.maximalIdeal.isMaximal B).isPrime
      apply h9
      · exact Ideal.comap_isPrime kt (IsLocalRing.maximalIdeal B)
      · intro p hp
        have e1 : kt (j p) = k p := RingHom.congr_fun hktj p
        rw [Ideal.mem_comap, e1, hmem]
        intro hu
        haveI := hkl
        exact hp (isUnit_of_map_unit k p hu)
      · intro t ht
        have e1 : kt (ψ t) = g t := RingHom.congr_fun hktψ t
        rw [Ideal.mem_comap, e1, hmem, hg, not_not]
        exact ht
    have hkt : ∀ d, IsUnit (kt d) ↔ d ∉ 𝔐 := by
      intro d
      rw [← hQ, Ideal.mem_comap, hmem, not_not]
    obtain ⟨h, ⟨hh, hhl⟩, huniqh⟩ := E3 B hB kt hkt
    refine ⟨h, ⟨?_, hhl⟩, ?_⟩
    · rw [← RingHom.comp_assoc, hh, hktψ]
    · rintro h' ⟨hh', hh'l⟩
      have hk'f : ((h'.comp e').comp j).comp f = g.comp ι₀ := by
        ext x
        have e1 : j (f x) = ψ (ι₀ x) := RingHom.congr_fun h3 x
        have e2 : h' (e' (ψ (ι₀ x))) = g (ι₀ x) := RingHom.congr_fun hh' (ι₀ x)
        simp only [RingHom.comp_apply]
        rw [e1, e2]
      have hk'l : IsLocalHom ((h'.comp e').comp j) := by
        constructor
        intro p hp
        simp only [RingHom.comp_apply] at hp
        haveI := hh'l
        have hu := isUnit_of_map_unit h' _ hp
        rw [E2] at hu
        by_contra hn
        exact hu ((h6 p).mpr hn)
      have hk' : (h'.comp e').comp j = k := huniqk _ ⟨hk'f, hk'l⟩
      have hb : h'.comp e' = kt := by
        apply h7 B
        · rw [hk', hktj]
        · rw [RingHom.comp_assoc, hh', hktψ]
      exact huniqh h' ⟨hb, hh'l⟩

theorem wcpa_dj_llsm_isir_node_dilatation : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (P : Type u) [CommRing P] (σ : ↥W →+* P) (g₀ : ↥W) (f : wcEbntN W g₀ →+* P),
    wcEbntPres W σ g₀ f →
    ∀ μ g₁ : ↥W, μ ∈ IsLocalRing.maximalIdeal ↥W → μ ≠ 0 → g₁ ∈ IsLocalRing.maximalIdeal ↥W →
    g₁ ≠ 0 → g₀ = μ * g₁ →
    ∃ Y' : FractionRing P,
      algebraMap P (FractionRing P) (σ μ) * Y' = algebraMap P (FractionRing P) (f (wcEbntX W g₀ 1)) ∧
      IsDomain ↥(Algebra.adjoin P {Y'}) ∧ IsIntegrallyClosed ↥(Algebra.adjoin P {Y'}) ∧
      ∀ (𝔐 : Ideal ↥(Algebra.adjoin P {Y'})) [𝔐.IsPrime],
        algebraMap P ↥(Algebra.adjoin P {Y'}) (f (wcEbntX W g₀ 0)) ∈ 𝔐 →
        (⟨Y', Algebra.subset_adjoin (Set.mem_singleton Y')⟩ : ↥(Algebra.adjoin P {Y'})) ∈ 𝔐 →
        (IsLocalRing.maximalIdeal ↥W).map ((algebraMap P ↥(Algebra.adjoin P {Y'})).comp σ) ≤ 𝔐 →
        ∀ (P' : Type u) [CommRing P'] (e' : ↥(Algebra.adjoin P {Y'}) →+* P'),
          wcNdIsHens 𝔐 P' e' →
          wcNdModelB W P' (e'.comp ((algebraMap P ↥(Algebra.adjoin P {Y'})).comp σ)) :=
by
  intro Ω _ _ W hW hWt P _ σ g₀ f hf μ g₁ hμm hμ0 hg₁m hg₁0 hg₀
  subst hg₀
  classical
  have hf' := hf
  obtain ⟨hgm, hg0, hfC, hH⟩ := hf'

  have hmax₀ := (wcpa_dj_lr1k_ndmf_modelB_levels Ω W (μ * g₁) hgm (wcEbntN W (μ * g₁))
    (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective Ideal.mk_ker).1
  have hmax₁ := (wcpa_dj_lr1k_ndmf_modelB_levels Ω W g₁ hg₁m (wcEbntN W g₁)
    (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective Ideal.mk_ker).1

  obtain ⟨hN₀d, hN₀i⟩ := wcNd_nodal_poly_normal Ω W (μ * g₁) hg0
  obtain ⟨hN₁d, hN₁i⟩ := wcNd_nodal_poly_normal Ω W g₁ hg₁0
  haveI := hN₀d; haveI := hN₀i; haveI := hN₁d; haveI := hN₁i
  obtain ⟨hPd, hPi⟩ := wcNd_hens_normal_domain (wcEbntN W (μ * g₁)) _ hmax₀.isPrime P f hH
  haveI := hPd

  have hσinj := wcpa_dj_lr1k_ebnt_pres_sigma_injective Ω W P σ (μ * g₁) f hf
  have hιinj : Function.Injective (algebraMap P (FractionRing P)) := IsFractionRing.injective P _
  have hσμ0 : algebraMap P (FractionRing P) (σ μ) ≠ 0 := by
    rw [map_ne_zero_iff _ hιinj, map_ne_zero_iff _ hσinj]; exact hμ0
  have hfc : ∀ c : ↥W, f (Ideal.Quotient.mk _ (MvPolynomial.C c)) = σ c := by
    intro c; rw [← hfC]; rfl

  have hrel : f (wcEbntX W (μ * g₁) 0) * f (wcEbntX W (μ * g₁) 1) = σ μ * σ g₁ := by
    have h1 : wcEbntX W (μ * g₁) 0 * wcEbntX W (μ * g₁) 1 =
        Ideal.Quotient.mk _ (MvPolynomial.C (μ * g₁)) := by
      simp only [wcEbntX, ← map_mul]
      exact Ideal.Quotient.eq.mpr (Ideal.subset_span rfl)
    rw [← map_mul, h1, hfc, map_mul]

  obtain ⟨Y', hY'def⟩ : ∃ Y' : FractionRing P, Y' = algebraMap P (FractionRing P)
      (f (wcEbntX W (μ * g₁) 1)) / algebraMap P (FractionRing P) (σ μ) := ⟨_, rfl⟩
  have hY' : algebraMap P (FractionRing P) (σ μ) * Y' =
      algebraMap P (FractionRing P) (f (wcEbntX W (μ * g₁) 1)) := by
    rw [hY'def, mul_div_cancel₀ _ hσμ0]
  have hXY' : algebraMap P (FractionRing P) (f (wcEbntX W (μ * g₁) 0)) * Y' =
      algebraMap P (FractionRing P) (σ g₁) := by
    apply mul_left_cancel₀ hσμ0
    rw [mul_left_comm, hY', ← map_mul (algebraMap P (FractionRing P)) (f _) (f _), hrel, map_mul]
  refine ⟨Y', hY', inferInstance, ?_⟩
  set Yh : ↥(Algebra.adjoin P {Y'}) := ⟨Y', Algebra.subset_adjoin (Set.mem_singleton Y')⟩ with hYh
  have hjinj : Function.Injective (algebraMap P ↥(Algebra.adjoin P {Y'})) := by
    intro a b h
    apply hιinj
    exact congrArg Subtype.val h
  have hgen : ∀ d : ↥(Algebra.adjoin P {Y'}), ∃ q : Polynomial P, d = Polynomial.aeval Yh q := by
    intro d
    have hd : (d : FractionRing P) ∈ (Polynomial.aeval (R := P) Y').range := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval]; exact d.2
    obtain ⟨q, hq⟩ := hd
    refine ⟨q, ?_⟩
    apply Subtype.val_injective
    rw [← hq]
    exact Polynomial.aeval_algHom_apply (Algebra.adjoin P {Y'}).val Yh q

  have hι : ∀ a ∈ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (μ * g₁)} :
      Ideal (MvPolynomial (Fin 2) ↥W)),
      ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g₁} :
        Ideal (MvPolynomial (Fin 2) ↥W))).comp
        (MvPolynomial.eval₂Hom MvPolynomial.C
          ![MvPolynomial.X 0, MvPolynomial.C μ * MvPolynomial.X 1])) a = 0 := by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul]
    have e : (MvPolynomial.eval₂Hom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 2) ↥W)
        ![MvPolynomial.X 0, MvPolynomial.C μ * MvPolynomial.X 1])
        (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (μ * g₁) : MvPolynomial (Fin 2) ↥W) =
        MvPolynomial.C μ * (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g₁) := by
      rw [map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
        MvPolynomial.eval₂Hom_C]
      show MvPolynomial.X 0 * (MvPolynomial.C μ * MvPolynomial.X 1) - MvPolynomial.C (μ * g₁) = _
      rw [map_mul]; ring
    have e2 : ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C g₁} : Ideal (MvPolynomial (Fin 2) ↥W))).comp
        (MvPolynomial.eval₂Hom MvPolynomial.C
          ![MvPolynomial.X 0, MvPolynomial.C μ * MvPolynomial.X 1]))
        (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (μ * g₁)) = 0 := by
      rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
      convert Ideal.mul_mem_left _ (MvPolynomial.C μ)
        (Ideal.subset_span rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g₁ :
          MvPolynomial (Fin 2) ↥W) ∈ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
            MvPolynomial.C g₁}) using 1
    rw [e2, mul_zero]
  obtain ⟨ι₀, hι₀⟩ : ∃ ι₀ : wcEbntN W (μ * g₁) →+* wcEbntN W g₁,
      ι₀ = Ideal.Quotient.lift _ _ hι := ⟨_, rfl⟩
  have hιC : ∀ c : ↥W, ι₀ (Ideal.Quotient.mk _ (MvPolynomial.C c)) =
      Ideal.Quotient.mk _ (MvPolynomial.C c) := by
    intro c
    rw [hι₀, Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
  have hι0 : ι₀ (wcEbntX W (μ * g₁) 0) = wcEbntX W g₁ 0 := by
    rw [hι₀]
    exact (Ideal.Quotient.lift_mk _ _ _).trans
      (congrArg (Ideal.Quotient.mk _) (MvPolynomial.eval₂Hom_X' _ _ _))
  have hι1 : ι₀ (wcEbntX W (μ * g₁) 1) =
      Ideal.Quotient.mk _ (MvPolynomial.C μ) * wcEbntX W g₁ 1 := by
    rw [hι₀]
    show Ideal.Quotient.lift _ _ hι (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = _
    rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
    exact map_mul (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C g₁} : Ideal (MvPolynomial (Fin 2) ↥W))) _ _
  have hψker : ∀ a ∈ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g₁} :
      Ideal (MvPolynomial (Fin 2) ↥W)),
      (MvPolynomial.eval₂Hom ((algebraMap P ↥(Algebra.adjoin P {Y'})).comp σ)
        ![algebraMap P ↥(Algebra.adjoin P {Y'}) (f (wcEbntX W (μ * g₁) 0)), Yh]) a = 0 := by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul]
    have e : (MvPolynomial.eval₂Hom ((algebraMap P ↥(Algebra.adjoin P {Y'})).comp σ)
        ![algebraMap P ↥(Algebra.adjoin P {Y'}) (f (wcEbntX W (μ * g₁) 0)), Yh])
        (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g₁) = 0 := by
      rw [map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
        MvPolynomial.eval₂Hom_C, sub_eq_zero]
      apply Subtype.ext
      show algebraMap P (FractionRing P) (f (wcEbntX W (μ * g₁) 0)) * Y' =
        algebraMap P (FractionRing P) (σ g₁)
      exact hXY'
    rw [e, mul_zero]
  obtain ⟨ψ, hψdef⟩ : ∃ ψ : wcEbntN W g₁ →+* ↥(Algebra.adjoin P {Y'}),
      ψ = Ideal.Quotient.lift _ _ hψker := ⟨_, rfl⟩
  have hψC : ∀ c : ↥W, ψ (Ideal.Quotient.mk _ (MvPolynomial.C c)) =
      algebraMap P ↥(Algebra.adjoin P {Y'}) (σ c) := by
    intro c
    rw [hψdef, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
  have hψ0 : ψ (wcEbntX W g₁ 0) = algebraMap P ↥(Algebra.adjoin P {Y'}) (f (wcEbntX W (μ * g₁) 0)) := by
    rw [hψdef]
    exact (Ideal.Quotient.lift_mk _ _ _).trans (MvPolynomial.eval₂Hom_X' _ _ _)
  have hψ1 : ψ (wcEbntX W g₁ 1) = Yh := by
    rw [hψdef]
    exact (Ideal.Quotient.lift_mk _ _ _).trans (MvPolynomial.eval₂Hom_X' _ _ _)
  have h3 : (algebraMap P ↥(Algebra.adjoin P {Y'})).comp f = ψ.comp ι₀ := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro c
      simp only [RingHom.comp_apply]
      rw [hfc, hιC, hψC]
    · intro i
      obtain rfl | rfl : i = 0 ∨ i = 1 := by fin_cases i <;> simp
      · simp only [RingHom.comp_apply]
        rw [hι0, hψ0]
      · show algebraMap P ↥(Algebra.adjoin P {Y'}) (f (wcEbntX W (μ * g₁) 1)) =
          ψ (ι₀ (wcEbntX W (μ * g₁) 1))
        rw [hι1, map_mul ψ, hψ1, hψC]
        apply Subtype.ext
        show algebraMap P (FractionRing P) (f (wcEbntX W (μ * g₁) 1)) =
          algebraMap P (FractionRing P) (σ μ) * Y'
        exact hY'.symm
  have hψinj : Function.Injective ψ := by
    apply wcpa_dj_lr1k_ebnt_node_map_injective Ω W g₁ hg₁0 _ ψ
    intro p hp
    have hc : ψ.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
        (algebraMap P ↥(Algebra.adjoin P {Y'})).comp σ := RingHom.ext fun c => hψC c
    rw [hc, hψ0, ← Polynomial.hom_eval₂] at hp
    apply wcpa_dj_lr1k_ebnt_coord_transcendental Ω W hW hWt P σ (μ * g₁) f hf p
    apply hjinj
    rw [hp, map_zero]
  refine ⟨?_, ?_⟩
  ·
    refine wcpa_dj_llsm_isirnd_normal_of_etale_approx (wcEbntN W (μ * g₁)) (wcEbntN W g₁) P
      ↥(Algebra.adjoin P {Y'}) ι₀ f (algebraMap P _) ψ h3.symm hψinj
      (wcNd_hne_etale_approx (wcEbntN W (μ * g₁)) _ P f hH) ?_
    intro d
    obtain ⟨q, hq⟩ := hgen d
    refine ⟨q.natDegree + 1, fun i => q.coeff i, fun i => wcEbntX W g₁ 1 ^ (i : ℕ), ?_⟩
    rw [hq, Polynomial.aeval_eq_sum_range,
      ← Fin.sum_univ_eq_sum_range (fun i => q.coeff i • Yh ^ i)]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_pow, hψ1, Algebra.smul_def]
  ·
    intro 𝔐 h𝔐 hX hY hm P' _ e' he'
    set 𝔪₀ : Ideal (wcEbntN W (μ * g₁)) := (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
      (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map (Ideal.Quotient.mk _) with h𝔪₀
    set 𝔪₁ : Ideal (wcEbntN W g₁) := (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
      (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map (Ideal.Quotient.mk _) with h𝔪₁
    have hX0mem : wcEbntX W g₁ 0 ∈ 𝔪₁ :=
      Ideal.mem_map_of_mem _ (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
    have hX1mem : wcEbntX W g₁ 1 ∈ 𝔪₁ :=
      Ideal.mem_map_of_mem _ (Ideal.mem_sup_left (Ideal.subset_span
        (Set.mem_insert_of_mem _ rfl)))
    have h4 : 𝔐.comap ψ = 𝔪₁ := by
      refine (hmax₁.eq_of_le (Ideal.comap_ne_top _ h𝔐.ne_top) ?_).symm
      rw [h𝔪₁, Ideal.map_le_iff_le_comap, Ideal.comap_comap]
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro x hx
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
        rcases hx with rfl | rfl
        · rw [SetLike.mem_coe, Ideal.mem_comap, RingHom.comp_apply]
          exact (congrArg (· ∈ 𝔐) hψ0).mpr hX
        · rw [SetLike.mem_coe, Ideal.mem_comap, RingHom.comp_apply]
          exact (congrArg (· ∈ 𝔐) hψ1).mpr hY
      · rw [Ideal.map_le_iff_le_comap]
        intro c hc
        try simp only [Ideal.mem_comap, RingHom.comp_apply]
        rw [hψC]
        exact hm (Ideal.mem_map_of_mem _ hc)
    have h5 : 𝔪₁.comap ι₀ = 𝔪₀ := by
      refine (hmax₀.eq_of_le (Ideal.comap_ne_top _ hmax₁.ne_top) ?_).symm
      rw [h𝔪₀, Ideal.map_le_iff_le_comap, Ideal.comap_comap]
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro x hx
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
        rcases hx with rfl | rfl
        · rw [SetLike.mem_coe, Ideal.mem_comap, RingHom.comp_apply]
          exact (congrArg (· ∈ 𝔪₁) hι0).mpr hX0mem
        · rw [SetLike.mem_coe, Ideal.mem_comap, RingHom.comp_apply]
          exact (congrArg (· ∈ 𝔪₁) hι1).mpr (Ideal.mul_mem_left _ _ hX1mem)
      · rw [Ideal.map_le_iff_le_comap]
        intro c hc
        try simp only [Ideal.mem_comap, RingHom.comp_apply]
        rw [hιC]
        exact Ideal.mem_map_of_mem _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc))
    have h6 : ∀ p : P, algebraMap P ↥(Algebra.adjoin P {Y'}) p ∈ 𝔐 ↔ ¬ IsUnit p := by
      intro p
      constructor
      · intro hp hu
        exact h𝔐.ne_top (Ideal.eq_top_of_isUnit_mem _ hp (hu.map _))
      · intro hp
        have h1 := wcpa_dj_llsm_isirnd_hens_max (wcEbntN W (μ * g₁)) 𝔪₀ hmax₀ P f hH p hp
        have h2 : 𝔪₀ ≤ 𝔐.comap ((algebraMap P ↥(Algebra.adjoin P {Y'})).comp f) := by
          rw [h3, ← Ideal.comap_comap, h4, h5]
        have h2' : 𝔪₀.map f ≤ 𝔐.comap (algebraMap P ↥(Algebra.adjoin P {Y'})) := by
          rw [Ideal.map_le_iff_le_comap, Ideal.comap_comap]; exact h2
        exact h2' h1
    have h7 : ∀ (B : Type u) [CommRing B] (h₁ h₂ : ↥(Algebra.adjoin P {Y'}) →+* B),
        h₁.comp (algebraMap P _) = h₂.comp (algebraMap P _) → h₁.comp ψ = h₂.comp ψ → h₁ = h₂ := by
      intro B _ h₁ h₂ hj hψ'
      have hYeq : h₁ Yh = h₂ Yh := by rw [← hψ1]; exact RingHom.congr_fun hψ' _
      ext d
      obtain ⟨q, rfl⟩ := hgen d
      rw [Polynomial.aeval_eq_sum_range, map_sum, map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Algebra.smul_def, map_mul, map_mul, map_pow, map_pow, hYeq,
        show h₁ (algebraMap P _ (q.coeff i)) = h₂ (algebraMap P _ (q.coeff i)) from
          RingHom.congr_fun hj _]
    have h8 : ∀ (B : Type u) [CommRing B] (k : P →+* B) (g : wcEbntN W g₁ →+* B),
        k.comp f = g.comp ι₀ → ∃ k' : ↥(Algebra.adjoin P {Y'}) →+* B,
          k'.comp (algebraMap P _) = k ∧ k'.comp ψ = g := by
      intro B _ k g hkg
      obtain ⟨k', hk'j, hk'Y⟩ := wcpa_dj_llsm_isirnd_adjoin_lift P (FractionRing P) B Y' k
        (g (wcEbntX W g₁ 1)) (by
          intro q hq
          refine wcpa_dj_llsm_isirnd_flat_extend Ω W μ g₁ hμ0 hg₁0 ι₀ (RingHom.ext fun c => hιC c)
            hι1 P f (wcpa_dj_lr1k_ebnt_dmne_pres_flat Ω W hW hWt P σ _ f hf) q ?_ B k g hkg
          apply hιinj
          rw [map_zero, ← Polynomial.eval₂_at_apply, hfc μ, ← hY',
            Polynomial.scaleRoots_eval₂_mul, ← Polynomial.aeval_def, hq, mul_zero])
      refine ⟨k', hk'j, ?_⟩
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro c
        simp only [RingHom.comp_apply]
        rw [hψC, ← RingHom.comp_apply k' (algebraMap P _), hk'j, ← hfc c,
          ← RingHom.comp_apply k f, hkg, RingHom.comp_apply, hιC]
      · intro i
        obtain rfl | rfl : i = 0 ∨ i = 1 := by fin_cases i <;> simp
        · show k' (ψ (wcEbntX W g₁ 0)) = g (wcEbntX W g₁ 0)
          rw [hψ0, ← RingHom.comp_apply k' (algebraMap P _), hk'j,
            ← RingHom.comp_apply k f, hkg, RingHom.comp_apply, hι0]
        · show k' (ψ (wcEbntX W g₁ 1)) = g (wcEbntX W g₁ 1)
          rw [hψ1]; exact hk'Y
    have crit : ∀ 𝔔 : Ideal ↥(Algebra.adjoin P {Y'}), 𝔔.IsPrime →
        (∀ p : P, ¬ IsUnit p → algebraMap P _ p ∈ 𝔔) → Yh ∈ 𝔔 →
        ∀ q : Polynomial P, (Polynomial.aeval Yh q ∈ 𝔔 ↔ ¬ IsUnit (q.coeff 0)) := by
      intro 𝔔 h𝔔 hnu hY𝔔 q
      have hdec : Polynomial.aeval Yh q =
          Yh * Polynomial.aeval Yh q.divX + algebraMap P _ (q.coeff 0) := by
        conv_lhs => rw [← Polynomial.X_mul_divX_add q]
        rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
      rw [hdec]
      have hmem : Yh * Polynomial.aeval Yh q.divX ∈ 𝔔 := Ideal.mul_mem_right _ _ hY𝔔
      constructor
      · intro h hu
        exact h𝔔.ne_top (Ideal.eq_top_of_isUnit_mem _ ((Ideal.add_mem_iff_right _ hmem).mp h)
          (hu.map _))
      · intro h
        exact Ideal.add_mem _ hmem (hnu _ h)
    have h9 : ∀ 𝔔 : Ideal ↥(Algebra.adjoin P {Y'}), 𝔔.IsPrime →
        (∀ p : P, ¬ IsUnit p → algebraMap P _ p ∈ 𝔔) → (∀ t ∈ 𝔪₁, ψ t ∈ 𝔔) → 𝔔 = 𝔐 := by
      intro 𝔔 h𝔔 hnu ht
      have hY𝔔 : Yh ∈ 𝔔 := by rw [← hψ1]; exact ht _ hX1mem
      ext d
      obtain ⟨q, rfl⟩ := hgen d
      rw [crit 𝔔 h𝔔 hnu hY𝔔 q, crit 𝔐 h𝔐 (fun p hp => (h6 p).mpr hp) hY q]
    refine ⟨g₁, hg₁m, hg₁0, e'.comp ψ, ?_, ?_⟩
    · refine RingHom.ext fun c => ?_
      simp only [RingHom.comp_apply]
      rw [hψC]
    · exact wcpa_dj_llsm_isirnd_hens_transfer (wcEbntN W (μ * g₁)) (wcEbntN W g₁) P _ P'
        𝔪₀ 𝔪₁ 𝔐 f ι₀ (algebraMap P _) ψ e' hH he' h3 h4 h5 h6 h7 h8 h9

theorem wcpa_dj_llsm_scrsct_local_embed : ∀ (L : Type u) [Field L] (B C : Type u) [CommRing B]
    [CommRing C] [Algebra B L] [Algebra C L], Function.Injective (algebraMap B L) →
    Function.Injective (algebraMap C L) →
    ∀ (𝔮 : Ideal B) [𝔮.IsPrime] (Q : Ideal C) [Q.IsPrime],
    (∀ x : B, ∃ y d : C, d ∉ Q ∧ algebraMap B L x * algebraMap C L d = algebraMap C L y ∧
      (x ∈ 𝔮 ↔ y ∈ Q)) →
    ∃ (ι : Localization.AtPrime Q →+* L) (φ : Localization.AtPrime 𝔮 →+* Localization.AtPrime Q),
      Function.Injective ι ∧
      (∀ c : C, ι (algebraMap C (Localization.AtPrime Q) c) = algebraMap C L c) ∧
      IsLocalHom φ ∧ Function.Injective φ ∧
      ∀ x : B, ι (φ (algebraMap B (Localization.AtPrime 𝔮) x)) = algebraMap B L x :=
by
  intro L _ B C _ _ _ _ hB hC 𝔮 _ Q _ H
  classical
  have hunit : ∀ s : Q.primeCompl, IsUnit (algebraMap C L s) := by
    intro s
    apply Ne.isUnit
    intro h0
    apply s.2
    have hs : (s : C) = 0 := hC (by rw [h0, map_zero])
    rw [hs]
    exact Q.zero_mem
  let ι : Localization.AtPrime Q →+* L :=
    IsLocalization.lift (M := Q.primeCompl) (S := Localization.AtPrime Q) hunit
  have hιc : ∀ c : C, ι (algebraMap C (Localization.AtPrime Q) c) = algebraMap C L c :=
    fun c => IsLocalization.lift_eq hunit c
  have hι : Function.Injective ι := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    obtain ⟨⟨c, s⟩, hcs⟩ := IsLocalization.mk'_surjective Q.primeCompl a
    have h1 : a * algebraMap C (Localization.AtPrime Q) s = algebraMap C (Localization.AtPrime Q) c := by
      rw [← hcs]; exact IsLocalization.mk'_spec (Localization.AtPrime Q) c s
    have h2 := congrArg ι h1
    rw [map_mul, ha, zero_mul, hιc] at h2
    have hc : c = 0 := hC (by rw [← h2, map_zero])
    rw [hc, map_zero] at h1
    exact (IsLocalization.map_units (Localization.AtPrime Q) s).mul_left_eq_zero.mp h1
  have hrange : ∀ x : B, algebraMap B L x ∈ ι.range := by
    intro x
    obtain ⟨y, d, hd, hxy, -⟩ := H x
    refine ⟨IsLocalization.mk' (Localization.AtPrime Q) y (⟨d, hd⟩ : Q.primeCompl), ?_⟩
    have h1 := IsLocalization.mk'_spec (Localization.AtPrime Q) y (⟨d, hd⟩ : Q.primeCompl)
    have h2 := congrArg ι h1
    rw [map_mul, hιc, hιc] at h2
    have hd0 : algebraMap C L d ≠ 0 := (hunit ⟨d, hd⟩).ne_zero
    exact mul_right_cancel₀ hd0 (h2.trans hxy.symm)
  let e : Localization.AtPrime Q ≃+* ι.range :=
    RingEquiv.ofBijective ι.rangeRestrict
      ⟨fun a b hab => hι (congrArg Subtype.val hab), ι.rangeRestrict_surjective⟩
  let g₀ : B →+* Localization.AtPrime Q :=
    (e.symm : ι.range →+* Localization.AtPrime Q).comp
      ((algebraMap B L).codRestrict ι.range hrange)
  have hg₀ : ∀ x, ι (g₀ x) = algebraMap B L x := by
    intro x
    have h1 : e (g₀ x) = (algebraMap B L).codRestrict ι.range hrange x := e.apply_symm_apply _
    exact congrArg Subtype.val h1
  have hkey : ∀ x : B, ∀ y d : C, algebraMap B L x * algebraMap C L d = algebraMap C L y →
      g₀ x * algebraMap C (Localization.AtPrime Q) d = algebraMap C (Localization.AtPrime Q) y := by
    intro x y d h
    apply hι
    rw [map_mul, hg₀, hιc, hιc, h]
  have hcrit : ∀ x : B, IsUnit (g₀ x) ↔ x ∉ 𝔮 := by
    intro x
    obtain ⟨y, d, hd, hxy, hiff⟩ := H x
    have hk := hkey x y d hxy
    have hdu : IsUnit (algebraMap C (Localization.AtPrime Q) d) :=
      (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime Q) Q d).mpr hd
    constructor
    · intro hu hx
      have hyu : IsUnit (algebraMap C (Localization.AtPrime Q) y) := by
        rw [← hk]; exact hu.mul hdu
      rw [IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime Q) Q y] at hyu
      exact hyu (hiff.mp hx)
    · intro hx
      have hy : y ∉ Q := fun hy => hx (hiff.mpr hy)
      have hm : IsUnit (g₀ x * algebraMap C (Localization.AtPrime Q) d) := by
        rw [hk]; exact (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime Q) Q y).mpr hy
      exact isUnit_of_mul_isUnit_left hm
  have hgu : ∀ s : 𝔮.primeCompl, IsUnit (g₀ s) := fun s => (hcrit s).mpr s.2
  let φ : Localization.AtPrime 𝔮 →+* Localization.AtPrime Q :=
    IsLocalization.lift (M := 𝔮.primeCompl) (S := Localization.AtPrime 𝔮) hgu
  have hφ : ∀ x : B, φ (algebraMap B (Localization.AtPrime 𝔮) x) = g₀ x :=
    fun x => IsLocalization.lift_eq hgu x
  have hrep : ∀ a : Localization.AtPrime 𝔮, ∃ (x : B) (s : 𝔮.primeCompl),
      a * algebraMap B (Localization.AtPrime 𝔮) s = algebraMap B (Localization.AtPrime 𝔮) x ∧
      φ a * g₀ s = g₀ x := by
    intro a
    obtain ⟨⟨x, s⟩, hxs⟩ := IsLocalization.mk'_surjective 𝔮.primeCompl a
    have h1 : a * algebraMap B (Localization.AtPrime 𝔮) s = algebraMap B (Localization.AtPrime 𝔮) x := by
      rw [← hxs]; exact IsLocalization.mk'_spec (Localization.AtPrime 𝔮) x s
    refine ⟨x, s, h1, ?_⟩
    have h2 := congrArg φ h1
    rwa [map_mul, hφ, hφ] at h2
  refine ⟨ι, φ, hι, hιc, ?_, ?_, ?_⟩
  · constructor
    intro a ha
    obtain ⟨x, s, h1, h2⟩ := hrep a
    have hx : x ∉ 𝔮 := (hcrit x).mp (by rw [← h2]; exact ha.mul (hgu s))
    have hm : IsUnit (a * algebraMap B (Localization.AtPrime 𝔮) s) := by
      rw [h1]; exact (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime 𝔮) 𝔮 x).mpr hx
    exact isUnit_of_mul_isUnit_left hm
  · rw [injective_iff_map_eq_zero]
    intro a ha
    obtain ⟨x, s, h1, h2⟩ := hrep a
    rw [ha, zero_mul] at h2
    have hx : x = 0 := hB (by rw [map_zero, ← hg₀, ← h2, map_zero])
    rw [hx, map_zero] at h1
    exact (IsLocalization.map_units (Localization.AtPrime 𝔮) s).mul_left_eq_zero.mp h1
  · intro x
    rw [hφ, hg₀]

theorem wcpa_dj_llsm_scrsct_range_integral : ∀ (R P₂ : Type u) [CommRing R] [IsDomain R]
    [IsIntegrallyClosed R] [CommRing P₂] [IsDomain P₂] (ρ : R →+* P₂), Function.Injective ρ →
    ∀ (x : P₂) (p : Polynomial P₂), p.Monic → (∀ i, p.coeff i ∈ ρ.range) → p.eval x = 0 →
    ∀ (r₁ r₂ : R), r₂ ≠ 0 → x * ρ r₂ = ρ r₁ → x ∈ ρ.range :=
by
  intro R P₂ _ _ _ _ _ ρ hρ x p hpm hpc hpx r₁ r₂ hr₂ hrel
  classical
  have hlift : p ∈ Polynomial.lifts ρ := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro n
    obtain ⟨a, ha⟩ := RingHom.mem_range.mp (hpc n)
    exact ⟨a, ha⟩
  obtain ⟨q, hqmap, -, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hpm
  have hc : Polynomial.eval r₁ (q.scaleRoots r₂) = 0 := by
    apply hρ
    rw [map_zero, ← Polynomial.eval₂_hom, ← hrel, mul_comm x, Polynomial.scaleRoots_eval₂_mul,
      ← Polynomial.eval_map, hqmap, hpx, mul_zero]
  have hf : Function.Injective (algebraMap R (FractionRing R)) :=
    IsFractionRing.injective R (FractionRing R)
  have hf2 : algebraMap R (FractionRing R) r₂ ≠ 0 := fun h =>
    hr₂ (hf (h.trans (map_zero _).symm))
  have hy : algebraMap R (FractionRing R) r₂ *
      (algebraMap R (FractionRing R) r₁ / algebraMap R (FractionRing R) r₂) =
      algebraMap R (FractionRing R) r₁ := mul_div_cancel₀ _ hf2
  have hint : IsIntegral R
      (algebraMap R (FractionRing R) r₁ / algebraMap R (FractionRing R) r₂) := by
    refine ⟨q, hqm, ?_⟩
    have h1 := Polynomial.scaleRoots_eval₂_mul (p := q) (algebraMap R (FractionRing R))
      (algebraMap R (FractionRing R) r₁ / algebraMap R (FractionRing R) r₂) r₂
    rw [hy, Polynomial.eval₂_hom, hc, map_zero] at h1
    exact (mul_eq_zero.mp h1.symm).resolve_left (pow_ne_zero _ hf2)
  obtain ⟨a, ha⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hint
  have har : a * r₂ = r₁ := by
    apply hf
    rw [map_mul, ha, mul_comm, hy]
  have hρ2 : ρ r₂ ≠ 0 := fun h => hr₂ (hρ (h.trans (map_zero _).symm))
  refine RingHom.mem_range.mpr ⟨a, ?_⟩
  apply mul_right_cancel₀ hρ2
  rw [← map_mul, har, hrel]

theorem wcpa_dj_llsm_scrsct_hens_range_surj : ∀ (C : Type u) [CommRing C] (Q : Ideal C) [Q.IsPrime]
    (P₂ R : Type u) [CommRing P₂] [CommRing R] [HenselianLocalRing R]
    (e₂ : Localization.AtPrime Q →+* P₂),
    wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) P₂ e₂ →
    ∀ (ρ : R →+* P₂), IsLocalHom ρ → Function.Injective ρ →
    (∀ c : C, e₂ (algebraMap C (Localization.AtPrime Q) c) ∈ ρ.range) →
    Function.Surjective ρ :=
by
  intro C _ Q _ P₂ R _ _ _ e₂ he₂ ρ hρloc hρinj hC
  obtain ⟨hHens, hUnit, hUP⟩ := he₂
  haveI : IsLocalHom ρ := hρloc

  have hinj' : Function.Injective ρ.rangeRestrict := by
    intro x y hxy
    apply hρinj
    have := congrArg Subtype.val hxy
    simpa [RingHom.coe_rangeRestrict] using this
  let eqv : R ≃+* ρ.range :=
    RingEquiv.ofBijective ρ.rangeRestrict ⟨hinj', RingHom.rangeRestrict_surjective ρ⟩
  have hkey : ∀ z : ρ.range, ρ (eqv.symm z) = (z : P₂) := by
    intro z
    have h1 : ρ (eqv.symm z) = ((ρ.rangeRestrict (eqv.symm z) : ρ.range) : P₂) := by
      rw [RingHom.coe_rangeRestrict]
    rw [h1]
    have h2 : ρ.rangeRestrict (eqv.symm z) = eqv (eqv.symm z) := rfl
    rw [h2, RingEquiv.apply_symm_apply]

  let g₀ : C →+* R := (eqv.symm : ρ.range →+* R).comp
    (RingHom.codRestrict (e₂.comp (algebraMap C (Localization.AtPrime Q))) ρ.range hC)
  have hg₀ : ∀ c : C, ρ (g₀ c) = e₂ (algebraMap C (Localization.AtPrime Q) c) := by
    intro c
    show ρ (eqv.symm _) = _
    rw [hkey]
    rfl

  have hunit₀ : ∀ y : Q.primeCompl, IsUnit (g₀ (y : C)) := by
    intro y
    have h1 : IsUnit (algebraMap C (Localization.AtPrime Q) (y : C)) :=
      IsLocalization.map_units (Localization.AtPrime Q) y
    have h2 : IsUnit (ρ (g₀ (y : C))) := by
      rw [hg₀]; exact h1.map e₂
    exact isUnit_of_map_unit ρ _ h2

  let g : Localization.AtPrime Q →+* R :=
    IsLocalization.lift (M := Q.primeCompl) (S := Localization.AtPrime Q) hunit₀
  have hρg : ρ.comp g = e₂ := by
    apply IsLocalization.ringHom_ext Q.primeCompl
    ext c
    show ρ (g (algebraMap C (Localization.AtPrime Q) c)) = e₂ (algebraMap C _ c)
    rw [IsLocalization.lift_eq, hg₀]
  have hρg' : ∀ a, ρ (g a) = e₂ a := fun a => RingHom.congr_fun hρg a

  have hgU : ∀ a, IsUnit (g a) ↔ a ∉ IsLocalRing.maximalIdeal (Localization.AtPrime Q) := by
    intro a
    rw [← hUnit a, ← hρg' a]
    exact (isUnit_map_iff ρ (g a)).symm

  obtain ⟨h, ⟨hhe, hhloc⟩, -⟩ := hUP R inferInstance g hgU
  haveI : IsLocalHom h := hhloc

  have hid : ρ.comp h = RingHom.id P₂ := by
    have U := hUP P₂ hHens e₂ hUnit
    refine U.unique ⟨?_, ?_⟩ ⟨RingHom.id_comp e₂, isLocalHom_id P₂⟩
    · rw [RingHom.comp_assoc, hhe, hρg]
    · exact RingHom.isLocalHom_comp ρ h

  intro y
  exact ⟨h y, RingHom.congr_fun hid y⟩

theorem wcpa_dj_llsm_scrsct_frac_multiple : ∀ (A : Type u) [CommRing A] [IsDomain A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] (s : K) (z : L),
    ∃ x₁ x₂ : ↥(integralClosure ↥(Algebra.adjoin A {s}) L), x₂ ≠ 0 ∧ (x₂ : L) * z = (x₁ : L) :=
by
  intro A _ _ K _ _ _ L _ _ _ s z
  haveI : IsFractionRing ↥(Algebra.adjoin A {s}) K :=
    Localization.subalgebra.instIsFractionRingSubtypeMemSubalgebra K (Algebra.adjoin A {s})
  obtain ⟨y, hy, hint⟩ := ((IsFractionRing.isAlgebraic_iff (Algebra.adjoin A {s}) K L).mpr
    (IsAlgebraic.of_finite K z)).exists_integral_multiple
  refine ⟨⟨y • z, hint⟩, algebraMap _ _ y, ?_, ?_⟩
  · intro h0
    have h1 : algebraMap (Algebra.adjoin A {s}) L y = 0 := by
      have := congrArg (fun x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) => (x : L)) h0
      simpa using this
    rw [IsScalarTower.algebraMap_apply (Algebra.adjoin A {s}) K L] at h1
    have h2 : algebraMap (Algebra.adjoin A {s}) K y = 0 :=
      (algebraMap K L).injective (h1.trans (map_zero _).symm)
    exact hy (IsFractionRing.injective (Algebra.adjoin A {s}) K (h2.trans (map_zero _).symm))
  · show algebraMap (Algebra.adjoin A {s}) L y * z = y • z
    rw [Algebra.smul_def]

theorem wcpa_dj_llsm_isirht_brsub_denom : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g a' : ↥W) (A₃ : Type u) [CommRing A₃] [IsDomain A₃] [Algebra ↥W A₃] [Algebra A₃ K] [IsFractionRing A₃ K] (u₃ v₃ : A₃) (𝔓 : Ideal A₃), wcLlsPD W A 𝔭 (.ann u v g) → a' ≠ 0 → wcLlsBrSub W A K A₃ (algebraMap A K u / algebraMap A K (algebraMap ↥W A a')) {algebraMap A K u / algebraMap A K (algebraMap ↥W A a'), algebraMap A K v} → algebraMap A₃ K u₃ = algebraMap A K u / algebraMap A K (algebraMap ↥W A a') → algebraMap A₃ K v₃ = algebraMap A K v → 𝔓.IsPrime → u₃ ∈ 𝔓 → v₃ ∈ 𝔓 → (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A₃) ≤ 𝔓 → ∀ a₃ : A₃, ∃ p d : A₃, d ∉ 𝔓 ∧ a₃ * d = p ∧ algebraMap A₃ K p ∈ Algebra.adjoin A {algebraMap A K u / algebraMap A K (algebraMap ↥W A a')} ∧ algebraMap A₃ K d ∈ Algebra.adjoin A {algebraMap A K u / algebraMap A K (algebraMap ↥W A a')} :=
by
  intro Ω _ W A _ _ _ K _ _ _ 𝔭 u v g a' A₃ _ _ _ _ _ u₃ v₃ 𝔓 hPD ha'0 hBr hu₃ hv₃ h𝔓 hu₃𝔓
    hv₃𝔓 hm𝔓 a₃
  classical
  obtain ⟨-, hNZ, -, hmax, -, -, -, -, h𝔭eq, -⟩ := hPD
  obtain ⟨hW, hsub, hden⟩ := hBr
  haveI := hNZ
  have hWA : Function.Injective (algebraMap ↥W A) := by
    intro x y hxy
    have h1 : (x - y) • (1 : A) = 0 := by
      rw [sub_smul, Algebra.smul_def, Algebra.smul_def, mul_one, mul_one, hxy, sub_self]
    rcases smul_eq_zero.mp h1 with h2 | h2
    · exact sub_eq_zero.mp h2
    · exact absurd h2 one_ne_zero
  have hAK : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hA3K : Function.Injective (algebraMap A₃ K) := IsFractionRing.injective A₃ K
  have ha'K : algebraMap A K (algebraMap ↥W A a') ≠ 0 := fun h0 =>
    ha'0 (hWA (hAK (by rw [h0, map_zero, map_zero])))
  set x : K := algebraMap A K u / algebraMap A K (algebraMap ↥W A a') with hxdef
  have hux : algebraMap A K u = algebraMap A K (algebraMap ↥W A a') * x := by
    rw [hxdef, mul_div_cancel₀ _ ha'K]

  have hpre : ∀ y : ↥(Algebra.adjoin A {x}), ∃ a : A₃, algebraMap A₃ K a = (y : K) :=
    fun y => hsub y.2
  choose ψf hψf using hpre
  let ψ : ↥(Algebra.adjoin A {x}) →+* A₃ :=
    { toFun := ψf
      map_one' := hA3K (by simp [hψf])
      map_mul' := fun a b => hA3K (by simp [hψf])
      map_zero' := hA3K (by simp [hψf])
      map_add' := fun a b => hA3K (by simp [hψf]) }
  have hψ : ∀ y : ↥(Algebra.adjoin A {x}), algebraMap A₃ K (ψ y) = (y : K) := hψf
  let xh : ↥(Algebra.adjoin A {x}) := ⟨x, Algebra.subset_adjoin (Set.mem_singleton x)⟩
  let J : Ideal ↥(Algebra.adjoin A {x}) := Ideal.span (Subtype.val ⁻¹'
    (({x, algebraMap A K v} : Set K) ∪
      (fun w => algebraMap A K (algebraMap ↥W A w)) '' ↑(IsLocalRing.maximalIdeal ↥W)))
  have hxJ : xh ∈ J := Ideal.subset_span (Or.inl (Or.inl rfl))

  have h𝔭J : 𝔭.map (algebraMap A ↥(Algebra.adjoin A {x})) ≤ J := by
    rw [h𝔭eq, Ideal.map_le_iff_le_comap, sup_le_iff]
    constructor
    · rw [Ideal.span_le]
      intro t ht
      rw [SetLike.mem_coe, Ideal.mem_comap]
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ht
      rcases ht with h | h
      · rw [h]
        have e : algebraMap A ↥(Algebra.adjoin A {x}) u =
            algebraMap A ↥(Algebra.adjoin A {x}) (algebraMap ↥W A a') * xh :=
          Subtype.ext (by
            show algebraMap A K u = algebraMap A K (algebraMap ↥W A a') * x
            exact hux)
        rw [e]
        exact J.mul_mem_left _ hxJ
      · rw [h]
        exact Ideal.subset_span (Or.inl (Or.inr rfl))
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap]
      exact Ideal.subset_span (Or.inr ⟨w, hw, rfl⟩)

  have hJ𝔓 : ∀ y ∈ J, ψ y ∈ 𝔓 := by
    intro y hy
    have hle : J ≤ 𝔓.comap ψ := by
      rw [Ideal.span_le]
      intro z hz
      simp only [Set.mem_preimage, Set.mem_union, Set.mem_insert_iff, Set.mem_singleton_iff,
        Set.mem_image] at hz
      rcases hz with (hz | hz) | ⟨w, hw, hwz⟩
      · have e : ψ z = u₃ := hA3K (by rw [hψ, hz, hu₃])
        show ψ z ∈ 𝔓
        rw [e]; exact hu₃𝔓
      · have e : ψ z = v₃ := hA3K (by rw [hψ, hv₃]; exact hz)
        show ψ z ∈ 𝔓
        rw [e]; exact hv₃𝔓
      · have e : ψ z = algebraMap ↥W A₃ w := hA3K (by rw [hψ, hW]; exact hwz.symm)
        show ψ z ∈ 𝔓
        rw [e]; exact hm𝔓 (Ideal.mem_map_of_mem _ hw)
    exact hle hy

  have hnf : ∀ y : ↥(Algebra.adjoin A {x}), ∃ (c : A) (r : ↥(Algebra.adjoin A {x})),
      y = algebraMap A ↥(Algebra.adjoin A {x}) c + xh * r := by
    intro y
    obtain ⟨P, hP⟩ := Algebra.adjoin_eq_exists_aeval A x y
    refine ⟨P.coeff 0, ⟨Polynomial.aeval x P.divX, Polynomial.aeval_mem_adjoin_singleton A x⟩, ?_⟩
    apply Subtype.ext
    show (y : K) = algebraMap A K (P.coeff 0) + x * Polynomial.aeval x P.divX
    have hP' : Polynomial.aeval x P = (y : K) := hP
    rw [← hP']
    conv_lhs => rw [← Polynomial.X_mul_divX_add P]
    rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
    ring

  have key : ∀ y : ↥(Algebra.adjoin A {x}), y ∉ J → ψ y ∉ 𝔓 := by
    intro y hyJ hy𝔓
    obtain ⟨c, r, hcr⟩ := hnf y
    by_cases hc : c ∈ 𝔭
    · apply hyJ
      rw [hcr]
      exact J.add_mem (h𝔭J (Ideal.mem_map_of_mem _ hc)) (J.mul_mem_right _ hxJ)
    · obtain ⟨b, i, hi, hbi⟩ := hmax.exists_inv hc
      have hb := congrArg (algebraMap A ↥(Algebra.adjoin A {x})) hbi
      rw [map_add, map_mul, map_one] at hb
      have h1 : (1 : ↥(Algebra.adjoin A {x})) =
          algebraMap A ↥(Algebra.adjoin A {x}) b * y -
            algebraMap A ↥(Algebra.adjoin A {x}) b * xh * r +
            algebraMap A ↥(Algebra.adjoin A {x}) i := by
        rw [hcr]
        linear_combination -hb
      have h1𝔓 : ψ 1 ∈ 𝔓 := by
        rw [h1]
        simp only [map_add, map_sub, map_mul]
        refine 𝔓.add_mem (𝔓.sub_mem (𝔓.mul_mem_left _ hy𝔓) ?_) ?_
        · exact 𝔓.mul_mem_right _ (𝔓.mul_mem_left _ (hJ𝔓 xh hxJ))
        · exact hJ𝔓 _ (h𝔭J (Ideal.mem_map_of_mem _ hi))
      rw [map_one] at h1𝔓
      exact h𝔓.ne_top ((Ideal.eq_top_iff_one _).mpr h1𝔓)

  obtain ⟨p', q', hq'J, hpq⟩ := hden (algebraMap A₃ K a₃) ⟨a₃, rfl⟩
  refine ⟨ψ p', ψ q', key q' hq'J, hA3K ?_, ?_, ?_⟩
  · rw [map_mul, hψ, hψ]; exact hpq
  · rw [hψ]; exact p'.2
  · rw [hψ]; exact q'.2

theorem wcpa_dj_llsm_isirht_frac_extend : ∀ (P P₃ : Type u) [CommRing P] [CommRing P₃] [IsDomain P₃] (h : P →+* P₃), IsDomain P → Function.Injective h → ∀ (Y' : FractionRing P) (a b : P) (Z : P₃), algebraMap P (FractionRing P) a * Y' = algebraMap P (FractionRing P) b → h a ≠ 0 → h b = h a * Z → ∃ e' : ↥(Algebra.adjoin P {Y'}) →+* P₃, Function.Injective e' ∧ (∀ p : P, e' (algebraMap P ↥(Algebra.adjoin P {Y'}) p) = h p) ∧ e' ⟨Y', Algebra.subset_adjoin (Set.mem_singleton Y')⟩ = Z :=
by
  intro P P₃ _ _ _ h hPdom hinj Y' a b Z hab ha hb
  haveI := hPdom
  classical
  have hι : Function.Injective (algebraMap P₃ (FractionRing P₃)) :=
    IsFractionRing.injective P₃ (FractionRing P₃)
  have hg : Function.Injective ((algebraMap P₃ (FractionRing P₃)).comp h) := hι.comp hinj
  let φ : FractionRing P →+* FractionRing P₃ := IsFractionRing.lift hg
  have hφ : ∀ p : P, φ (algebraMap P (FractionRing P) p) = algebraMap P₃ (FractionRing P₃) (h p) :=
    fun p => IsFractionRing.lift_algebraMap hg p
  have hφinj : Function.Injective φ := φ.injective
  have hY : φ Y' = algebraMap P₃ (FractionRing P₃) Z := by
    have h1 := congrArg φ hab
    rw [map_mul, hφ, hφ, hb, map_mul] at h1
    have hne : algebraMap P₃ (FractionRing P₃) (h a) ≠ 0 :=
      (map_ne_zero_iff _ hι).mpr ha
    exact mul_left_cancel₀ hne h1
  have hrange : ∀ x ∈ Algebra.adjoin P {Y'}, φ x ∈ (algebraMap P₃ (FractionRing P₃)).range := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx => rw [Set.mem_singleton_iff.mp hx, hY]; exact ⟨Z, rfl⟩
    | algebraMap p => rw [hφ]; exact ⟨h p, rfl⟩
    | add x y _ _ hx hy => rw [map_add]; exact Subring.add_mem _ hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact Subring.mul_mem _ hx hy
  let ψ : ↥(Algebra.adjoin P {Y'}) →+* FractionRing P₃ :=
    φ.comp ((Algebra.adjoin P {Y'}).val : ↥(Algebra.adjoin P {Y'}) →ₐ[P] FractionRing P).toRingHom
  have hψ : ∀ r : ↥(Algebra.adjoin P {Y'}), ψ r ∈ (algebraMap P₃ (FractionRing P₃)).range :=
    fun r => hrange r.1 r.2
  let E : P₃ ≃+* (algebraMap P₃ (FractionRing P₃)).range :=
    RingEquiv.ofBijective (algebraMap P₃ (FractionRing P₃)).rangeRestrict
      ⟨fun x y hxy => hι (congrArg Subtype.val hxy),
        RingHom.rangeRestrict_surjective _⟩
  have hE : ∀ z : (algebraMap P₃ (FractionRing P₃)).range,
      algebraMap P₃ (FractionRing P₃) (E.symm z) = (z : FractionRing P₃) :=
    fun z => congrArg Subtype.val (E.apply_symm_apply z)
  let e' : ↥(Algebra.adjoin P {Y'}) →+* P₃ :=
    (E.symm : (algebraMap P₃ (FractionRing P₃)).range →+* P₃).comp (ψ.codRestrict _ hψ)
  have K1 : ∀ r : ↥(Algebra.adjoin P {Y'}),
      algebraMap P₃ (FractionRing P₃) (e' r) = φ (r : FractionRing P) := fun r => hE _
  refine ⟨e', ?_, ?_, ?_⟩
  · intro r₁ r₂ hr
    have := congrArg (algebraMap P₃ (FractionRing P₃)) hr
    rw [K1, K1] at this
    exact Subtype.ext (hφinj this)
  · intro p
    apply hι
    rw [K1]
    exact hφ p
  · apply hι
    rw [K1]
    exact hY

theorem wcpa_dj_llsm_isir_hens_transport : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
