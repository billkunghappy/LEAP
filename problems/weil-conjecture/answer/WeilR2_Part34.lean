    obtain ⟨Q, hQ, _, hQm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift (hpm.map _)
    have hev : (Q.map Polynomial.toLaurent).eval (θ z) = 0 := by
      rw [hQ, Polynomial.eval_map, ← Polynomial.hom_eval₂, hp, map_zero]
    obtain ⟨P, hP⟩ := LI _ (θ z) Q hQm hev
    exact ⟨P, hP.symm⟩

  have h2 : ∀ f : LaurentPolynomial (IsLocalRing.ResidueField ↥W), ∃ (n : ℕ)
      (z : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)),
      θ z = (LaurentPolynomial.C c⁻¹ * LaurentPolynomial.T (k : ℤ)) ^ n * f := by
    intro f
    obtain ⟨γq, hγq⟩ := ψ.surjective (LaurentPolynomial.invert f)
    obtain ⟨γ, rfl⟩ := Ideal.Quotient.mk_surjective γq
    have hcl : ∀ r ∈ wcLlsIsiCR W A K u a', ∃ m : ℕ,
        wcLlsIsiS1 W A K u a' ^ m * r ∈ wcIcxRI W A K u a' b := by
      intro r hr
      unfold wcLlsIsiCR at hr
      induction hr using Algebra.adjoin_induction with
      | mem z hz =>
        rcases hz with hz | hz
        · refine ⟨0, ?_⟩
          rw [hz, pow_zero, one_mul]
          exact hS1mem
        · rw [Set.mem_singleton_iff] at hz
          refine ⟨1, ?_⟩
          rw [hz, pow_one, hxy]
          exact Subalgebra.one_mem _
      | algebraMap a =>
        refine ⟨0, ?_⟩
        rw [pow_zero, one_mul]
        exact Subalgebra.algebraMap_mem _ a
      | add r₁ r₂ _ _ ih₁ ih₂ =>
        obtain ⟨m₁, h₁⟩ := ih₁
        obtain ⟨m₂, h₂⟩ := ih₂
        refine ⟨m₁ + m₂, ?_⟩
        have e : wcLlsIsiS1 W A K u a' ^ (m₁ + m₂) * (r₁ + r₂) =
            wcLlsIsiS1 W A K u a' ^ m₂ * (wcLlsIsiS1 W A K u a' ^ m₁ * r₁) +
              wcLlsIsiS1 W A K u a' ^ m₁ * (wcLlsIsiS1 W A K u a' ^ m₂ * r₂) := by
          ring
        rw [e]
        exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hS1mem _) h₁)
          (Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hS1mem _) h₂)
      | mul r₁ r₂ _ _ ih₁ ih₂ =>
        obtain ⟨m₁, h₁⟩ := ih₁
        obtain ⟨m₂, h₂⟩ := ih₂
        refine ⟨m₁ + m₂, ?_⟩
        have e : wcLlsIsiS1 W A K u a' ^ (m₁ + m₂) * (r₁ * r₂) =
            (wcLlsIsiS1 W A K u a' ^ m₁ * r₁) * (wcLlsIsiS1 W A K u a' ^ m₂ * r₂) := by ring
        rw [e]
        exact Subalgebra.mul_mem _ h₁ h₂
    obtain ⟨n, hn⟩ := SH A K L (wcLlsIsiS1 W A K u a') (wcIcxRI W A K u a' b)
      (wcLlsIsiCR W A K u a') hIC hS1mem hcl (γ : L) γ.2
    refine ⟨n, ⟨_, hn⟩, ?_⟩
    have e : wcIcxIncl L _ _ hIC ⟨_, hn⟩ =
        wcIcxIncl L _ _ hIC (wcIccXI W A K L u a' b) ^ n * γ := by
      apply Subtype.ext
      rw [MulMemClass.coe_mul, SubmonoidClass.coe_pow]
      rfl
    rw [hθ, e, map_mul, map_mul, map_mul, map_pow, map_pow, map_pow, hγq, hinv, ← hθ, hθx]

  have hpd := PD _ _ θ (wcIccXI W A K L u a' b) c⁻¹ k (inv_ne_zero hc) hk hθx h3
  have hxQ : wcIccXI W A K L u a' b ∈ QI := hE'Q hxE'
  have h5 : ∀ M : Ideal ↥(integralClosure ↥(wcIcxRI W A K u a' b) L), M.IsMaximal → E ≤ M →
      wcIccXI W A K L u a' b ∈ M → M = QI := by
    intro M hM hEM hxM
    ext z
    obtain ⟨q, hq⟩ := h1 z
    rw [CH _ _ θ E M _ hM.isPrime hEM hxM hker h3 hpd z q hq,
      CH _ _ θ E QI _ hQI hEQ hxQ hker h3 hpd z q hq]

  obtain ⟨η, hηE', hθη, hrep⟩ := CORE _ _ θ QI E' E (wcIccXI W A K L u a' b) c⁻¹ k hQI hEQ hE'Q
    hxE' (inv_ne_zero hc) hk hθx hker h1 h2 h3 h5 hT hN
  refine ⟨η, hηE', ?_, fun z => ?_⟩
  · have e := congrArg LaurentPolynomial.invert hθη
    rw [hθ, hinv, LaurentPolynomial.invert_T] at e
    exact e
  · obtain ⟨a, r, hr⟩ := hrep z
    obtain ⟨w₀, rfl⟩ := IsLocalRing.residue_surjective a
    refine ⟨w₀, r, ?_⟩
    have hmem : z - wcIccCst W A K L (wcIcxRI W A K u a' b) w₀ - η * r ∈ E := by
      rw [← hker, show z - wcIccCst W A K L (wcIcxRI W A K u a' b) w₀ - η * r =
          (z - η * r) - wcIccCst W A K L (wcIcxRI W A K u a' b) w₀ by ring, map_sub, hr, hcst,
        sub_self]
    rw [← h𝔎I] at hmem
    exact hmem

theorem wcpa_dj_llsm_isic_contraction : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' b : ↥W)
    (hRo : wcLlsASbS W A K u b ≤ wcLlsASbS W A K u a')
    (hRI : wcLlsASbS W A K u b ≤ wcIcxRI W A K u a' b),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    a' ∣ b → ¬ b ∣ a' → b ∣ g →
    wcLlsAnnSep W A K L u a' → wcLlsIsiSep2 W A K L u a' b → wcLlsIsiCirc W A K L u a' →
    ∀ (y₀ : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u b) L)), y₀.IsPrime →
    y₀.comap (algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)) =
      wcLlsASbN W A K u b →
    ∀ (Qo 𝔷o : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u a') L))
      (QI 𝔷I : Ideal ↥(integralClosure ↥(wcIcxRI W A K u a' b) L))
      [Qo.IsPrime] [𝔷o.IsPrime] [QI.IsPrime] [𝔷I.IsPrime],
      Qo.comap (wcIcxIncl L _ _ hRo) = y₀ → QI.comap (wcIcxIncl L _ _ hRI) = y₀ →
      Qo.comap (algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) =
        wcLlsASbN W A K u a' →
      QI.comap (algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)) =
        wcIcxNI W A K u a' b →
      𝔷o ≤ Qo → 𝔷I ≤ QI →
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W, ∀ c : ↥(integralClosure ↥(wcLlsASbS W A K u a') L),
        (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w → c ∈ 𝔷o) →
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W, ∀ c : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L),
        (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w → c ∈ 𝔷I) →
      (algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)
          ⟨algebraMap A K (algebraMap ↥W A a') / algebraMap A K u,
            Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∈ 𝔷o ∧
        algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)
          (algebraMap A ↥(wcLlsASbS W A K u a') u) ∉ 𝔷o) →
      (algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
          ⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_insert _ _)⟩ ∈ 𝔷I ∧
        algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
          ⟨wcLlsIsiS2 W A K u b,
            Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ ∉ 𝔷I) →
      (∀ z : ↥(integralClosure ↥(wcLlsASbS W A K u a') L),
        ∃ c c' : ↥(integralClosure ↥(wcLlsASbS W A K u b) L), c' ∉ y₀ ∧
          wcIcxIncl L _ _ hRo c' * z - wcIcxIncl L _ _ hRo c ∈ 𝔷o) ∧
      (∀ z : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L),
        ∃ c c' : ↥(integralClosure ↥(wcLlsASbS W A K u b) L), c' ∉ y₀ ∧
          wcIcxIncl L _ _ hRI c' * z - wcIcxIncl L _ _ hRI c ∈ 𝔷I) ∧
      (∃ x : ↥(integralClosure ↥(wcLlsASbS W A K u b) L), wcIcxIncl L _ _ hRI x ∈ 𝔷I ∧
        Irreducible (Ideal.Quotient.mk (Ideal.map (algebraMap
            ↥(integralClosure ↥(wcLlsASbS W A K u a') L) (Localization.AtPrime Qo)) 𝔷o)
          (algebraMap ↥(integralClosure ↥(wcLlsASbS W A K u a') L) (Localization.AtPrime Qo)
            (wcIcxIncl L _ _ hRo x)))) ∧
      (∃ x : ↥(integralClosure ↥(wcLlsASbS W A K u b) L), wcIcxIncl L _ _ hRo x ∈ 𝔷o ∧
        Irreducible (Ideal.Quotient.mk (Ideal.map (algebraMap
            ↥(integralClosure ↥(wcIcxRI W A K u a' b) L) (Localization.AtPrime QI)) 𝔷I)
          (algebraMap ↥(integralClosure ↥(wcIcxRI W A K u a' b) L) (Localization.AtPrime QI)
            (wcIcxIncl L _ _ hRI x)))) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' b hRo hRI hPD ha'm ha'0 hbm hb0
    ha'b hnba hbg hAo hIs hCirc y₀ hy₀ hy₀c Qo 𝔷o QI 𝔷I _ _ _ _ hQoy hQIy hQoN hQIN h𝔷oQ h𝔷IQ
    h𝔷om h𝔷Im hstro hstrI
  classical
  obtain ⟨e, he⟩ := ha'b
  have hPD' := hPD
  obtain ⟨_, hNZ, _, _, _, _, hg0, huv, _⟩ := hPD'

  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    rw [Algebra.algebraMap_eq_smul_one] at hw
    rcases smul_eq_zero.mp hw with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hu0 : algebraMap A K u ≠ 0 := by
    intro h
    apply hg0
    apply hWA
    apply IsFractionRing.injective A K
    rw [map_zero, map_zero, ← huv, map_mul, h, zero_mul]
  have ha0 : algebraMap A K (algebraMap ↥W A a') ≠ 0 := by
    intro h
    apply ha'0
    apply hWA
    apply IsFractionRing.injective A K
    rw [map_zero, map_zero, h]
  have hem : e ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra h
    have hu := IsLocalRing.notMem_maximalIdeal.mp h
    exact hnba ⟨↑hu.unit⁻¹, by rw [he, mul_assoc, IsUnit.mul_val_inv, mul_one]⟩

  have hinc : ∀ (S T : Subalgebra A K) (h : S ≤ T) (x : ↥(integralClosure ↥S L)),
      ((wcIcxIncl L S T h x : ↥(integralClosure ↥T L)) : L) = (x : L) := fun _ _ _ _ => rfl
  have hcstc : ∀ (R : Subalgebra A K) (w : ↥W),
      ((wcIccCst W A K L R w : ↥(integralClosure ↥R L)) : L) = wcIccWL W A K L w :=
    fun _ _ => rfl

  have hoC : wcLlsASbS W A K u a' ≤ wcLlsIsiCR W A K u a' := by
    apply Algebra.adjoin_le
    rw [Set.singleton_subset_iff]
    exact Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  have hIC : wcIcxRI W A K u a' b ≤ wcLlsIsiCR W A K u a' := by
    apply Algebra.adjoin_le
    intro z hz
    rcases hz with rfl | hz
    · exact Algebra.subset_adjoin (Set.mem_insert _ _)
    · rw [Set.mem_singleton_iff] at hz
      subst hz
      have hs : wcLlsIsiS2 W A K u b =
          algebraMap A K (algebraMap ↥W A e) * wcLlsIsiS2 W A K u a' := by
        unfold wcLlsIsiS2
        rw [he, map_mul, map_mul]
        ring
      rw [SetLike.mem_coe, hs]
      exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
        (Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
  have hcstO : ∀ w : ↥W, wcIcxIncl L _ _ hoC (wcIccCst W A K L (wcLlsASbS W A K u a') w) =
      wcIccCst W A K L (wcLlsIsiCR W A K u a') w := fun _ => Subtype.ext rfl
  have hcstI : ∀ w : ↥W, wcIcxIncl L _ _ hIC (wcIccCst W A K L (wcIcxRI W A K u a' b) w) =
      wcIccCst W A K L (wcLlsIsiCR W A K u a') w := fun _ => Subtype.ext rfl

  have hAo' := hAo
  unfold wcLlsAnnSep wcLlsSepAt at hAo'
  have hIs' := hIs
  unfold wcLlsIsiSep2 at hIs'
  have hfgO : (wcLlsASbS W A K u a').FG :=
    ⟨{algebraMap A K (algebraMap ↥W A a') / algebraMap A K u}, by
      rw [Finset.coe_singleton]⟩
  have hfgI : (wcIcxRI W A K u a' b).FG :=
    ⟨{wcLlsIsiS1 W A K u a', wcLlsIsiS2 W A K u b}, by
      rw [Finset.coe_insert, Finset.coe_singleton]⟩
  have hlocO : ∀ (Q : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) [Q.IsPrime],
      Q.comap (algebraMap ↥(wcLlsASbS W A K u a')
        ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) = wcLlsASbN W A K u a' →
      IsNoetherianRing (wcLlsFS W (wcIccWL W A K L) ↥(wcLlsASbS W A K u a') Q) ∧
      IsReduced (wcLlsFS W (wcIccWL W A K L) ↥(wcLlsASbS W A K u a') Q) ∧
      ¬ wcpaDjLkBad (wcLlsFS W (wcIccWL W A K L) ↥(wcLlsASbS W A K u a') Q) := by
    intro Q _ hQN
    obtain ⟨hred, hnoeth⟩ := wcpa_dj_llsm_isice_fs_reduced_noetherian Ω W hW hWt A K L 𝔭
      (.ann u v g) hPD (wcLlsASbS W A K u a') hfgO Q
    exact ⟨hnoeth, hred, hAo' Q hQN⟩
  have hlocI : ∀ (Q : Ideal ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)) [Q.IsPrime],
      Q.comap (algebraMap ↥(wcIcxRI W A K u a' b)
        ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)) = wcIcxNI W A K u a' b →
      IsNoetherianRing (wcLlsFS W (wcIccWL W A K L) ↥(wcIcxRI W A K u a' b) Q) ∧
      IsReduced (wcLlsFS W (wcIccWL W A K L) ↥(wcIcxRI W A K u a' b) Q) ∧
      ¬ wcpaDjLkBad (wcLlsFS W (wcIccWL W A K L) ↥(wcIcxRI W A K u a' b) Q) := by
    intro Q _ hQN
    obtain ⟨hred, hnoeth⟩ := wcpa_dj_llsm_isice_fs_reduced_noetherian Ω W hW hWt A K L 𝔭
      (.ann u v g) hPD (wcIcxRI W A K u a' b) hfgI Q
    exact ⟨hnoeth, hred, hIs' Q hQN⟩
  have hbO : ∀ (Q : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u a') L)), Q.IsPrime →
      Q.comap (algebraMap ↥(wcLlsASbS W A K u a')
        ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) = wcLlsASbN W A K u a' →
      ∀ E₁ ∈ (wcIccM W (wcIccWL W A K L) ↥(wcLlsASbS W A K u a')).minimalPrimes,
      ∀ E₂ ∈ (wcIccM W (wcIccWL W A K L) ↥(wcLlsASbS W A K u a')).minimalPrimes,
      ∀ E₃ ∈ (wcIccM W (wcIccWL W A K L) ↥(wcLlsASbS W A K u a')).minimalPrimes,
