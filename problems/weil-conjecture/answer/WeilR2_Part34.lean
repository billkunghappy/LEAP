        apply hwnu
        refine IsUnit.of_mul_eq_one ((⟨z⁻¹, hzi⟩ : ↥W) ^ n) ?_
        apply Subtype.ext
        rw [MulMemClass.coe_mul, SubmonoidClass.coe_pow, OneMemClass.coe_one]
        show (w : Ω) * (z⁻¹) ^ n = 1
        rw [← hz, ← mul_pow, mul_inv_cancel₀ hz0, one_pow]
    have hrad : ∀ (c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L)) (n : ℕ),
        c ^ n ∈ Ideal.span {c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
            (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} →
        c ∈ Ideal.span {c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
            (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} := by
      intro c n hcn
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · rw [pow_zero] at hcn
        have := Ideal.mul_mem_left _ c hcn
        rwa [mul_one] at this
      obtain ⟨w, hw, d, hd⟩ := hform _ hcn
      rw [SubmonoidClass.coe_pow] at hd
      by_cases hw0 : w = 0
      · have hc : (c : L) = 0 := by
          rw [hw0, map_zero, zero_mul] at hd
