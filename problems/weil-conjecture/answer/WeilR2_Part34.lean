        ↥(integralClosure ↥(Algebra.adjoin A {sK}) L)) : L) = uL := by
    rw [hκ, Subalgebra.coe_algebraMap]
    exact hιA _
  have hEq := hcontr (d ^ M) hdM



  obtain ⟨hzloc, hz'loc⟩ := t_loc ↥(Algebra.adjoin A {sK}) L 𝔮 ℓ m₀ α
    (fun i => algebraMap K L (x i)) (algebraMap K L (-F₁.coeff 0 / uK ^ m₀))
    (algebraMap K L sK) uL (ζL ^ m₀ / w₁) (w₁ ^ ℓ / uL ^ m₀) (uL ^ m₀ / w₁ ^ ℓ)
    (w₁ ^ α / uL ^ β) (ζL * uL ^ β / w₁ ^ α) (algebraMap K L eK) _ _ _ _ Xc hp0 hm₀
    hE hS hsC huC hXc hEq hS0 hsq huq
    (by rw [hUL, hsL]; exact f8) (by rw [hUL]; exact f6) f2 f3 (by rw [hsL]; exact f4)
  have h1q : (1 : ↥(integralClosure ↥(Algebra.adjoin A {sK}) L)) ∉ 𝔮 := fun h =>
    (inferInstance : 𝔮.IsPrime).ne_top ((Ideal.eq_top_iff_one _).mpr h)



  refine ⟨w₁ ^ α / uL ^ β, ζL * uL ^ β / w₁ ^ α, w₁ ^ ℓ / uL ^ m₀, uL ^ m₀ / w₁ ^ ℓ, ?_⟩
  unfold wcLlsKPbdsElems
  refine ⟨f1, f2, f3, hsL.trans f4, ?_, f7, hzloc, hz'loc,
    ⟨w₁ ^ ℓ / uL ^ m₀, 1, h1q, by simp⟩, ⟨uL ^ m₀ / w₁ ^ ℓ, 1, h1q, by simp⟩, htrans⟩
  rw [f5, huKdef]
  exact f6.trans hUL.symm

theorem wcLlsKP_bds_chart_T : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A) (c b : ↥W) (d : A),
    wcLlsPD W A 𝔭 (.disc t) → c ∈ IsLocalRing.maximalIdeal ↥W →
    b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → d ∉ 𝔭 →
    ∃ (T : Type u) (_ : CommRing T) (_ : Algebra ↥W T) (j : T →+* K) (h : A)
      (π : wcEbntN W b →+* T),
      Function.Injective j ∧ h ∉ 𝔭 ∧
      (∀ w : ↥W, j (algebraMap ↥W T w) = algebraMap A K (algebraMap ↥W A w)) ∧
      π.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = algebraMap ↥W T ∧
      j (π (wcEbntX W b 0)) = algebraMap A K (t - algebraMap ↥W A c) ∧
      j (π (wcEbntX W b 1)) =
        algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c) ∧
      RingHom.Etale (R := wcEbntN W b) (S := T) π ∧
      (∀ y : K, wcLlsKPLoc A K (wcLlsScV W A K t c b) d y → ∃ y' : T, j y' = y) ∧
      (∀ y' : T, ∃ n : ℕ, j y' * algebraMap A K (h * d) ^ n ∈
        Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)}) :=
by
  intro Ω _ W A _ _ _ K _ _ _ 𝔭 t c b d hPD hc hb hb0 hd
  classical
  unfold wcLlsPD at hPD
  obtain ⟨_, _, _, _, _, _, _, h, hh, f, hfC, hfX, hfet⟩ := hPD

  have hh0 : h ≠ 0 := fun e => hh (e ▸ 𝔭.zero_mem)
  haveI hBdom : IsDomain (Localization.Away h) :=
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
  have hu : IsUnit (algebraMap A K h) :=
    isUnit_iff_ne_zero.mpr ((map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr hh0)
  letI : Algebra (Localization.Away h) K := (IsLocalization.Away.lift h hu).toAlgebra
  haveI : IsScalarTower A (Localization.Away h) K :=
    IsScalarTower.of_algebraMap_eq (fun a => (IsLocalization.Away.lift_eq h hu a).symm)
  haveI : IsFractionRing (Localization.Away h) K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers h)
      (Localization.Away h) K
  have hinj : Function.Injective (algebraMap (Localization.Away h) K) :=
    IsFractionRing.injective (Localization.Away h) K

  obtain ⟨g, hgdef⟩ : ∃ g : MvPolynomial (Fin 1) ↥W →+* Localization.Away h,
      g = f.comp (MvPolynomial.uniqueAlgEquiv ↥W (Fin 1)).toRingEquiv.toRingHom := ⟨_, rfl⟩
  have hg : g.Etale := by
    rw [hgdef]
    exact RingHom.Etale.respectsIso.2 _ _ hfet
  have hgC : g.comp MvPolynomial.C = algebraMap ↥W (Localization.Away h) := by
    refine RingHom.ext fun w => ?_
    have e1 : (MvPolynomial.uniqueAlgEquiv ↥W (Fin 1)) (MvPolynomial.C w) = Polynomial.C w := by
      rw [MvPolynomial.uniqueAlgEquiv_apply, MvPolynomial.eval₂_C]
    have e2 := RingHom.congr_fun hfC w
    simp only [RingHom.comp_apply] at e2
    rw [hgdef]
    show f ((MvPolynomial.uniqueAlgEquiv ↥W (Fin 1)) (MvPolynomial.C w)) = _
    rw [e1, e2, ← IsScalarTower.algebraMap_apply]
  have hgX : g (MvPolynomial.X 0) = algebraMap A (Localization.Away h) t := by
    rw [hgdef]
    show f ((MvPolynomial.uniqueAlgEquiv ↥W (Fin 1)) (MvPolynomial.X 0)) = _
    rw [MvPolynomial.uniqueAlgEquiv_apply, MvPolynomial.eval₂_X, hfX]

  have hV : wcLlsaS W K (g (MvPolynomial.X 0)) c b = wcLlsScV W A K t c b := by
    rw [hgX]
    show algebraMap (Localization.Away h) K (algebraMap ↥W (Localization.Away h) b) /
        algebraMap (Localization.Away h) K
          (algebraMap A (Localization.Away h) t - algebraMap ↥W (Localization.Away h) c) =
      algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)
    rw [IsScalarTower.algebraMap_apply ↥W A (Localization.Away h) b,
      IsScalarTower.algebraMap_apply ↥W A (Localization.Away h) c, ← map_sub,
      ← IsScalarTower.algebraMap_apply A (Localization.Away h) K,
      ← IsScalarTower.algebraMap_apply A (Localization.Away h) K]

  have hreg := wcpa_dj_llsmacr_regular_pair Ω W (Localization.Away h) g c b hg hgC hb0
  have hker := wcpa_dj_llsmacr_rees_kernel (Localization.Away h) K hinj
    (g (MvPolynomial.X 0) - algebraMap ↥W (Localization.Away h) c)
    (algebraMap ↥W (Localization.Away h) b) hreg.1 hreg.2
  obtain ⟨ψ, hψC, hψ0, hψ1, hψet⟩ := wcpa_dj_llsmacr_annulus_etale Ω W (Localization.Away h) K
    g c b hinj hg hgC hreg.1 hker.le

  have hclear : ∀ y ∈ Algebra.adjoin (Localization.Away h) {wcLlsScV W A K t c b},
      ∃ n : ℕ, algebraMap A K h ^ n * y ∈ Algebra.adjoin A {wcLlsScV W A K t c b} := by
    have hη : algebraMap A K h ∈ Algebra.adjoin A {wcLlsScV W A K t c b} :=
      Subalgebra.algebraMap_mem _ h
    intro y hy
    induction hy using Algebra.adjoin_induction with
    | mem x hx =>
      refine ⟨0, ?_⟩
      rw [Set.mem_singleton_iff.mp hx, pow_zero, one_mul]
      exact Algebra.subset_adjoin (Set.mem_singleton _)
    | algebraMap b =>
      obtain ⟨n, a, hb⟩ := IsLocalization.Away.surj h b
      refine ⟨n, ?_⟩
      have e : algebraMap A K h ^ n * algebraMap (Localization.Away h) K b = algebraMap A K a := by
        have e3 := congrArg (algebraMap (Localization.Away h) K) hb
        rw [map_mul, map_pow, ← IsScalarTower.algebraMap_apply A (Localization.Away h) K,
          ← IsScalarTower.algebraMap_apply A (Localization.Away h) K] at e3
        rw [mul_comm]
        exact e3
      rw [e]
      exact Subalgebra.algebraMap_mem _ a
    | add x y _ _ hx hy =>
      obtain ⟨n₁, h₁⟩ := hx
      obtain ⟨n₂, h₂⟩ := hy
      refine ⟨n₁ + n₂, ?_⟩
      have e : algebraMap A K h ^ (n₁ + n₂) * (x + y) =
          algebraMap A K h ^ n₂ * (algebraMap A K h ^ n₁ * x) +
            algebraMap A K h ^ n₁ * (algebraMap A K h ^ n₂ * y) := by ring
      rw [e]
      exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hη _) h₁)
        (Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hη _) h₂)
    | mul x y _ _ hx hy =>
      obtain ⟨n₁, h₁⟩ := hx
      obtain ⟨n₂, h₂⟩ := hy
      refine ⟨n₁ + n₂, ?_⟩
      have e : algebraMap A K h ^ (n₁ + n₂) * (x * y) =
          (algebraMap A K h ^ n₁ * x) * (algebraMap A K h ^ n₂ * y) := by ring
      rw [e]
      exact Subalgebra.mul_mem _ h₁ h₂
  have hle : Algebra.adjoin A {wcLlsScV W A K t c b} ≤
      (Algebra.adjoin (Localization.Away h) {wcLlsScV W A K t c b}).restrictScalars A :=
    Algebra.adjoin_le (Set.singleton_subset_iff.mpr (Algebra.subset_adjoin (Set.mem_singleton _)))

  let ι : wcLlsaA W K (g (MvPolynomial.X 0)) c b →+* K :=
    (Algebra.adjoin (Localization.Away h) {wcLlsaS W K (g (MvPolynomial.X 0)) c b}).val.toRingHom
  have hιinj : Function.Injective ι := Subtype.val_injective
  let dS : wcLlsaA W K (g (MvPolynomial.X 0)) c b :=
    algebraMap (Localization.Away h) _ (algebraMap A (Localization.Away h) d)
  have hd0 : d ≠ 0 := fun e => hd (e ▸ 𝔭.zero_mem)
  have hdK0 : algebraMap A K d ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr hd0
  have hιd : ι dS = algebraMap A K d := by
    show algebraMap (Localization.Away h) K (algebraMap A (Localization.Away h) d) = _
    rw [← IsScalarTower.algebraMap_apply]
  have hunit : IsUnit (ι dS) := isUnit_iff_ne_zero.mpr (by rw [hιd]; exact hdK0)
  let j : Localization.Away dS →+* K := IsLocalization.Away.lift dS hunit
  have hjS : ∀ x, j (algebraMap _ (Localization.Away dS) x) = ι x :=
    fun x => IsLocalization.Away.lift_eq dS hunit x
  have hjinj : Function.Injective j := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj dS z
    have h1 : ι a = 0 := by
      rw [← hjS, ← ha, map_mul, hz, zero_mul]
    have h2 : a = 0 := hιinj (by rw [h1, map_zero])
    rw [h2, map_zero] at ha
    exact ((IsLocalization.Away.algebraMap_isUnit dS).pow n).mul_left_eq_zero.mp ha
  have hlift0 : ∀ (y : K) (n : ℕ) (x : wcLlsaA W K (g (MvPolynomial.X 0)) c b),
      ι x = ι dS ^ n * y → ∃ y' : Localization.Away dS, j y' = y := by
    intro y n x hx
    obtain ⟨v, hv⟩ := (IsLocalization.Away.algebraMap_isUnit dS
      (S := Localization.Away dS)).exists_right_inv
    refine ⟨algebraMap _ _ x * v ^ n, ?_⟩
    have hjv : ι dS * j v = 1 := by rw [← hjS, ← map_mul, hv, map_one]
    rw [map_mul, map_pow, hjS, hx]
    calc ι dS ^ n * y * j v ^ n = (ι dS * j v) ^ n * y := by ring
      _ = y := by rw [hjv, one_pow, one_mul]

  refine ⟨Localization.Away dS, inferInstance,
    ((algebraMap (wcLlsaA W K (g (MvPolynomial.X 0)) c b) (Localization.Away dS)).comp
      ((algebraMap (Localization.Away h) (wcLlsaA W K (g (MvPolynomial.X 0)) c b)).comp
        (algebraMap ↥W (Localization.Away h)))).toAlgebra,
    j, h, (algebraMap (wcLlsaA W K (g (MvPolynomial.X 0)) c b) (Localization.Away dS)).comp ψ,
    hjinj, hh, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  ·
    intro w
    rw [RingHom.algebraMap_toAlgebra, RingHom.comp_apply, hjS]
    show algebraMap (Localization.Away h) K (algebraMap ↥W (Localization.Away h) w) = _
    rw [IsScalarTower.algebraMap_apply ↥W A (Localization.Away h) w,
      ← IsScalarTower.algebraMap_apply A (Localization.Away h) K]
  ·
    rw [RingHom.comp_assoc, hψC]
    rfl
  ·
    show j (algebraMap _ _ (ψ (Ideal.Quotient.mk _ (MvPolynomial.X 0)))) = _
    rw [hjS, hψ0]
    show algebraMap (Localization.Away h) K
      (g (MvPolynomial.X 0) - algebraMap ↥W (Localization.Away h) c) = _
    rw [hgX, IsScalarTower.algebraMap_apply ↥W A (Localization.Away h) c, ← map_sub,
      ← IsScalarTower.algebraMap_apply A (Localization.Away h) K]
  ·
    show j (algebraMap _ _ (ψ (Ideal.Quotient.mk _ (MvPolynomial.X 1)))) = _
    rw [hjS, hψ1]
    show wcLlsaS W K (g (MvPolynomial.X 0)) c b = _
    rw [hV]
    rfl
  ·
    exact RingHom.Etale.stableUnderComposition _ _ hψet
      (RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway dS))
  ·
    intro y hy
    unfold wcLlsKPLoc at hy
    obtain ⟨n, hn⟩ := hy
    have hmemB : algebraMap A K d ^ n * y ∈
        Algebra.adjoin (Localization.Away h) {wcLlsaS W K (g (MvPolynomial.X 0)) c b} := by
      rw [hV]
      exact hle hn
    exact hlift0 y n ⟨_, hmemB⟩ (by rw [hιd]; rfl)
  ·
    intro y'
    obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj dS y'
    have e1 : j y' * algebraMap A K d ^ n = (a : K) := by
      have e2 := congrArg j ha
      rw [map_mul, map_pow, hjS, hjS, hιd] at e2
      exact e2
    have ha2 : (a : K) ∈ Algebra.adjoin (Localization.Away h) {wcLlsScV W A K t c b} := by
      rw [← hV]
      exact a.2
    obtain ⟨k, hk⟩ := hclear _ ha2
    refine ⟨n + k, ?_⟩
    have e3 : j y' * algebraMap A K (h * d) ^ (n + k) =
        (algebraMap A K h ^ k * (a : K)) * algebraMap A K (h ^ n * d ^ k) := by
      rw [← e1, map_mul, map_mul, map_pow, map_pow]
      ring
    rw [e3]
    show _ ∈ Algebra.adjoin A {wcLlsScV W A K t c b}
    exact Subalgebra.mul_mem _ hk (Subalgebra.algebraMap_mem _ _)

theorem wcLlsKP_bdsm_presentation_iso : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (T : Type u) [CommRing T] [Algebra ↥W T] (b ζ : ↥W) (p α β m₀ : ℕ), ζ ^ p = b →
    ∀ (π : wcEbntN W b →+* T),
    π.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = algebraMap ↥W T →
    ∀ (x : ℕ → T) (U : T) (n : ℕ) (R : Fin n → MvPolynomial (Fin n) (wcEbntN W b))
      (ψ : MvPolynomial (Fin n) (wcEbntN W b) →+* T),
    ψ.comp MvPolynomial.C = π → Function.Surjective ψ → RingHom.ker ψ = Ideal.span (Set.range R) →
    ∀ (Rt : Fin n → MvPolynomial (Fin n) (MvPolynomial (Fin 2) ↥W))
      (a : ℕ → MvPolynomial (Fin n) (MvPolynomial (Fin 2) ↥W))
      (c : MvPolynomial (Fin n) (MvPolynomial (Fin 2) ↥W)),
    (∀ j, MvPolynomial.map (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C b})) (Rt j) = R j) →
    (∀ i, ψ (MvPolynomial.map (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C b})) (a i)) = x i) →
    ψ (MvPolynomial.map (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C b})) c) = U →
    ∃ φ : MvPolynomial (Fin n ⊕ Fin 2) (wcEbntN W ζ) →+*
        wcLlsKPbdsE T (π (wcEbntX W b 0)) (π (wcEbntX W b 1)) (algebraMap ↥W T ζ) U x p α β m₀,
      Function.Surjective φ ∧
      RingHom.ker φ = Ideal.span (Set.range (wcLlsKPbdsEqs
        ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ζ})).comp MvPolynomial.C) (wcEbntX W ζ 0) (wcEbntX W ζ 1)
        n p α β m₀ Rt a c)) ∧
      (∀ w : ↥W, φ (MvPolynomial.C (Ideal.Quotient.mk _ (MvPolynomial.C w))) =
        algebraMap ↥W (wcLlsKPbdsE T (π (wcEbntX W b 0)) (π (wcEbntX W b 1))
          (algebraMap ↥W T ζ) U x p α β m₀) w) ∧
      φ (MvPolynomial.C (wcEbntX W ζ 0)) =
        wcLlsKPbdsV T (π (wcEbntX W b 0)) (π (wcEbntX W b 1)) (algebraMap ↥W T ζ) U x p α β m₀ 0 ∧
      φ (MvPolynomial.C (wcEbntX W ζ 1)) =
        wcLlsKPbdsV T (π (wcEbntX W b 0)) (π (wcEbntX W b 1)) (algebraMap ↥W T ζ) U x p α β m₀ 1 ∧
      φ (MvPolynomial.X (Sum.inr 0)) =
        wcLlsKPbdsV T (π (wcEbntX W b 0)) (π (wcEbntX W b 1)) (algebraMap ↥W T ζ) U x p α β m₀ 2 ∧
      ∀ q : MvPolynomial (Fin n) (MvPolynomial (Fin 2) ↥W),
        φ (wcLlsKPbdsSubst ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ζ})).comp MvPolynomial.C) (wcEbntX W ζ 0) (wcEbntX W ζ 1) n p α q) =
        algebraMap T (wcLlsKPbdsE T (π (wcEbntX W b 0)) (π (wcEbntX W b 1))
          (algebraMap ↥W T ζ) U x p α β m₀)
          (ψ (MvPolynomial.map (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
            MvPolynomial.C b})) q)) :=
by
  intro Ω _ W T _ _ b ζ p α β m₀ hζb π hπC x U n R ψ hψC hψs hψk Rt a c hRt ha hc
  classical
  letI iNb : CommRing (wcEbntN W b) := Ideal.Quotient.commRing _
  letI iNζ : CommRing (wcEbntN W ζ) := Ideal.Quotient.commRing _
  set mb : MvPolynomial (Fin 2) ↥W →+* wcEbntN W b :=
    Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b}) with hmb
  set γ : ↥W →+* wcEbntN W ζ :=
    (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ζ})).comp
      MvPolynomial.C with hγ
  set a0 : wcEbntN W ζ := wcEbntX W ζ 0 with ha0
  set a1 : wcEbntN W ζ := wcEbntX W ζ 1 with ha1
  set Φ := wcLlsKPbdsSubst γ a0 a1 n p α with hΦ
  set F := wcLlsKPbdsEqs γ a0 a1 n p α β m₀ Rt a c with hF
  set mkI : MvPolynomial (Fin 4) T →+* wcLlsKPbdsE T (π (wcEbntX W b 0)) (π (wcEbntX W b 1))
      (algebraMap ↥W T ζ) U x p α β m₀ :=
    Ideal.Quotient.mk (wcLlsKPbdsI T (π (wcEbntX W b 0)) (π (wcEbntX W b 1))
      (algebraMap ↥W T ζ) U x p α β m₀) with hmkI
  have hRt' : ∀ j, MvPolynomial.map mb (Rt j) = R j := hRt
  have ha' : ∀ i, ψ (MvPolynomial.map mb (a i)) = x i := ha
  have hc' : ψ (MvPolynomial.map mb c) = U := hc
  have hψC' : ∀ r, ψ (MvPolynomial.C r) = π r := fun r => RingHom.congr_fun hψC r
  have hπC' : ∀ w, π (mb (MvPolynomial.C w)) = algebraMap ↥W T w := fun w => RingHom.congr_fun hπC w
  have hψmbC : ∀ r, ψ (MvPolynomial.map mb (MvPolynomial.C r)) = π (mb r) := fun r => by
    rw [MvPolynomial.map_C, hψC']

  have hAW : ∀ w : ↥W, algebraMap ↥W (wcLlsKPbdsE T (π (wcEbntX W b 0)) (π (wcEbntX W b 1))
      (algebraMap ↥W T ζ) U x p α β m₀) w = mkI (MvPolynomial.C (algebraMap ↥W T w)) := by
    intro w
    rw [hmkI, ← MvPolynomial.algebraMap_apply, Ideal.Quotient.mk_algebraMap]
  have hAT : ∀ t : T, algebraMap T (wcLlsKPbdsE T (π (wcEbntX W b 0)) (π (wcEbntX W b 1))
      (algebraMap ↥W T ζ) U x p α β m₀) t = mkI (MvPolynomial.C t) := by
    intro t
    rfl

  have e1 : mkI (MvPolynomial.X 0) * mkI (MvPolynomial.X 1) =
      mkI (MvPolynomial.C (algebraMap ↥W T ζ)) := by
    rw [← map_mul, ← sub_eq_zero, ← map_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_insert _ _))
  have e2 : mkI (MvPolynomial.X 2) * mkI (MvPolynomial.X 3) = 1 := by
    rw [← map_mul, ← sub_eq_zero, ← map_one mkI, ← map_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr
      (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert _ _)))
  have e3 : mkI (MvPolynomial.C (π (mb (MvPolynomial.X 0)))) =
      mkI (MvPolynomial.X 0) ^ p * mkI (MvPolynomial.X 3) ^ α := by
    rw [← map_pow, ← map_pow, ← map_mul, ← sub_eq_zero, ← map_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr
      (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_insert _ _))))
  have e4 : mkI (MvPolynomial.C (π (mb (MvPolynomial.X 1)))) =
      mkI (MvPolynomial.X 1) ^ p * mkI (MvPolynomial.X 2) ^ α := by
    rw [← map_pow, ← map_pow, ← map_mul, ← sub_eq_zero, ← map_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr
      (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _
        (Set.mem_insert_of_mem _ (Set.mem_insert _ _)))))
  have e5 : mkI (MvPolynomial.X 2) * (1 + ∑ i ∈ Finset.Ico 1 p, mkI (MvPolynomial.C (x i)) *
      (mkI (MvPolynomial.X 1) ^ m₀ * mkI (MvPolynomial.X 2) ^ β) ^ (p - i)) =
      mkI (MvPolynomial.C U) := by
    rw [← sub_eq_zero]
    have h : mkI (MvPolynomial.X 2 * (1 + ∑ i ∈ Finset.Ico 1 p, MvPolynomial.C (x i) *
        (MvPolynomial.X 1 ^ m₀ * MvPolynomial.X 2 ^ β) ^ (p - i)) - MvPolynomial.C U) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr
        (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _
          (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_singleton _))))))
    simpa only [map_sub, map_mul, map_add, map_one, map_sum, map_pow] using h

  have hΦCC : ∀ w, Φ (MvPolynomial.C (MvPolynomial.C w)) = MvPolynomial.C (γ w) := by
    intro w
    simp only [hΦ, wcLlsKPbdsSubst, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
  have hΦCX0 : Φ (MvPolynomial.C (MvPolynomial.X 0)) =
      MvPolynomial.C a0 ^ p * MvPolynomial.X (Sum.inr 1) ^ α := by
    simp only [hΦ, wcLlsKPbdsSubst, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
      Matrix.cons_val_zero]
  have hΦCX1 : Φ (MvPolynomial.C (MvPolynomial.X 1)) =
      MvPolynomial.C a1 ^ p * MvPolynomial.X (Sum.inr 0) ^ α := by
    rw [hΦ, wcLlsKPbdsSubst, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
    rfl
  have hΦX : ∀ i, Φ (MvPolynomial.X i) = MvPolynomial.X (Sum.inl i) := by
    intro i
    simp only [hΦ, wcLlsKPbdsSubst, MvPolynomial.eval₂Hom_X']
  have hFl : ∀ j, F (Sum.inl j) = Φ (Rt j) := by
    intro j
    simp only [hF, hΦ, wcLlsKPbdsEqs, Sum.elim_inl]
  have hF0 : F (Sum.inr 0) = MvPolynomial.X (Sum.inr 0) * MvPolynomial.X (Sum.inr 1) - 1 := by
    simp only [hF, wcLlsKPbdsEqs, Sum.elim_inr, Matrix.cons_val_zero]
  have hF1 : F (Sum.inr 1) = MvPolynomial.X (Sum.inr 0) * (1 + ∑ i ∈ Finset.Ico 1 p, Φ (a i) *
      (MvPolynomial.C a1 ^ m₀ * MvPolynomial.X (Sum.inr 0) ^ β) ^ (p - i)) - Φ c := by
    rfl
  have ha01 : a0 * a1 = γ ζ := by
    show (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C ζ}) : MvPolynomial (Fin 2) ↥W →+* wcEbntN W ζ) (MvPolynomial.X 0) *
      (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C ζ}) : MvPolynomial (Fin 2) ↥W →+* wcEbntN W ζ) (MvPolynomial.X 1) =
      (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C ζ}) : MvPolynomial (Fin 2) ↥W →+* wcEbntN W ζ) (MvPolynomial.C ζ)
    rw [← map_mul]
    exact Ideal.Quotient.eq.mpr (Ideal.mem_span_singleton_self _)

  obtain ⟨ν₀, hν₀C, hν₀X0, hν₀X1⟩ : ∃ g : MvPolynomial (Fin 2) ↥W →+* wcLlsKPbdsE T
      (π (wcEbntX W b 0)) (π (wcEbntX W b 1)) (algebraMap ↥W T ζ) U x p α β m₀,
      (∀ w, g (MvPolynomial.C w) = algebraMap ↥W (wcLlsKPbdsE T (π (wcEbntX W b 0))
        (π (wcEbntX W b 1)) (algebraMap ↥W T ζ) U x p α β m₀) w) ∧
      g (MvPolynomial.X 0) = mkI (MvPolynomial.X 0) ∧ g (MvPolynomial.X 1) = mkI (MvPolynomial.X 1) :=
    ⟨MvPolynomial.eval₂Hom (algebraMap ↥W _) ![mkI (MvPolynomial.X 0), mkI (MvPolynomial.X 1)],
      fun w => MvPolynomial.eval₂Hom_C _ _ _, (MvPolynomial.eval₂Hom_X' _ _ _).trans rfl,
      (MvPolynomial.eval₂Hom_X' _ _ _).trans rfl⟩
  have hν₀ : ∀ y ∈ Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ζ :
      MvPolynomial (Fin 2) ↥W)}, ν₀ y = 0 := by
    intro y hy
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hy
    rw [map_mul, map_sub, map_mul, hν₀X0, hν₀X1, hν₀C, hAW, e1, sub_self, mul_zero]
  obtain ⟨ν, hνmk⟩ : ∃ g : wcEbntN W ζ →+* wcLlsKPbdsE T
      (π (wcEbntX W b 0)) (π (wcEbntX W b 1)) (algebraMap ↥W T ζ) U x p α β m₀,
      ∀ y, g (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C ζ}) y) = ν₀ y :=
    ⟨Ideal.Quotient.lift _ ν₀ hν₀, fun y => Ideal.Quotient.lift_mk _ _ _⟩
  have hνγ : ∀ w, ν (γ w) = algebraMap ↥W (wcLlsKPbdsE T (π (wcEbntX W b 0))
      (π (wcEbntX W b 1)) (algebraMap ↥W T ζ) U x p α β m₀) w :=
    fun w => (hνmk _).trans (hν₀C w)
  obtain ⟨φ, hφC, hφXl, hφX2, hφX3⟩ : ∃ g : MvPolynomial (Fin n ⊕ Fin 2) (wcEbntN W ζ) →+*
      wcLlsKPbdsE T (π (wcEbntX W b 0)) (π (wcEbntX W b 1)) (algebraMap ↥W T ζ) U x p α β m₀,
      (∀ y, g (MvPolynomial.C y) = ν y) ∧
      (∀ i, g (MvPolynomial.X (Sum.inl i)) = mkI (MvPolynomial.C (ψ (MvPolynomial.X i)))) ∧
      g (MvPolynomial.X (Sum.inr 0)) = mkI (MvPolynomial.X 2) ∧
      g (MvPolynomial.X (Sum.inr 1)) = mkI (MvPolynomial.X 3) :=
    ⟨MvPolynomial.eval₂Hom ν (Sum.elim (fun i => mkI (MvPolynomial.C (ψ (MvPolynomial.X i))))
        ![mkI (MvPolynomial.X 2), mkI (MvPolynomial.X 3)]),
      fun y => MvPolynomial.eval₂Hom_C _ _ _, fun i => (MvPolynomial.eval₂Hom_X' _ _ _).trans rfl,
      (MvPolynomial.eval₂Hom_X' _ _ _).trans rfl, (MvPolynomial.eval₂Hom_X' _ _ _).trans rfl⟩
  have hφa0 : φ (MvPolynomial.C a0) = mkI (MvPolynomial.X 0) :=
    (hφC _).trans ((hνmk (MvPolynomial.X 0)).trans hν₀X0)
  have hφa1 : φ (MvPolynomial.C a1) = mkI (MvPolynomial.X 1) :=
    (hφC _).trans ((hνmk (MvPolynomial.X 1)).trans hν₀X1)

  have hK : ∀ q, φ (Φ q) = mkI (MvPolynomial.C (ψ (MvPolynomial.map mb q))) := by
    have H : φ.comp Φ = mkI.comp (MvPolynomial.C.comp (ψ.comp (MvPolynomial.map mb))) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        have H2 : (φ.comp Φ).comp MvPolynomial.C =
            (mkI.comp (MvPolynomial.C.comp (ψ.comp (MvPolynomial.map mb)))).comp MvPolynomial.C := by
          apply MvPolynomial.ringHom_ext
          · intro w
            simp only [RingHom.comp_apply]
            rw [hΦCC, hφC, hνγ, hAW, hψmbC, hπC']
          · refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
            · simp only [RingHom.comp_apply]
              rw [hΦCX0, map_mul, map_pow, map_pow, hφa0, hφX3, hψmbC, e3]
            · simp only [RingHom.comp_apply]
              rw [hΦCX1, map_mul, map_pow, map_pow, hφa1, hφX2, hψmbC, e4]
        exact RingHom.congr_fun H2 r
      · intro i
        simp only [RingHom.comp_apply]
        rw [hΦX, hφXl, MvPolynomial.map_X]
    exact fun q => RingHom.congr_fun H q

  have hφF : ∀ l, φ (F l) = 0 := by
    rintro (j | r)
    · have hj : R j ∈ RingHom.ker ψ := by
        rw [hψk]; exact Ideal.subset_span ⟨j, rfl⟩
      rw [hFl, hK, hRt', (RingHom.mem_ker).mp hj, map_zero, map_zero]
    · revert r
      refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
      · rw [hF0, map_sub, map_mul, map_one, hφX2, hφX3, e2, sub_self]
      · rw [hF1]
        simp only [map_sub, map_mul, map_add, map_one, map_sum, map_pow, hK, ha', hc', hφa1, hφX2]
        rw [e5, sub_self]

  have hV : ∀ j : Fin 4, mkI (MvPolynomial.X j) ∈ φ.range := by
    intro j
    fin_cases j
    · exact RingHom.mem_range.mpr ⟨_, hφa0⟩
    · exact RingHom.mem_range.mpr ⟨_, hφa1⟩
    · exact RingHom.mem_range.mpr ⟨_, hφX2⟩
    · exact RingHom.mem_range.mpr ⟨_, hφX3⟩
  have hrange : ∀ f, mkI f ∈ φ.range := by
    intro f
    induction f using MvPolynomial.induction_on with
    | C t =>
      obtain ⟨y, rfl⟩ := hψs t
      obtain ⟨q, rfl⟩ := MvPolynomial.map_surjective mb Ideal.Quotient.mk_surjective y
      exact RingHom.mem_range.mpr ⟨Φ q, hK q⟩
    | add f g hf hg =>
      rw [map_add]
      exact add_mem hf hg
    | mul_X f j hf =>
      rw [map_mul]
      exact mul_mem hf (hV j)
  have hsurj : Function.Surjective φ := by
    intro e
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective e
    exact RingHom.mem_range.mp (hrange f)

  have hker : RingHom.ker φ = Ideal.span (Set.range F) := by
    apply le_antisymm
    · intro f hf
      rw [RingHom.mem_ker] at hf
      set μ : MvPolynomial (Fin n ⊕ Fin 2) (wcEbntN W ζ) →+*
          (MvPolynomial (Fin n ⊕ Fin 2) (wcEbntN W ζ) ⧸ Ideal.span (Set.range F)) :=
        Ideal.Quotient.mk _ with hμdef
      have hμ : ∀ l, μ (F l) = 0 := fun l =>
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨l, rfl⟩)
      have hMN : μ (MvPolynomial.X (Sum.inr 0)) * μ (MvPolynomial.X (Sum.inr 1)) = 1 := by
        have h := hμ (Sum.inr 0)
        rw [hF0, map_sub, map_mul, map_one, sub_eq_zero] at h
        exact h
      have hb' : μ (MvPolynomial.C (γ b)) = (μ (MvPolynomial.C a0) * μ (MvPolynomial.C a1)) ^ p := by
        rw [← hζb, map_pow, map_pow, map_pow, ← map_mul, ← map_mul, ha01]
      have hκ₀ : ∀ y ∈ Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b :
          MvPolynomial (Fin 2) ↥W)}, μ (Φ (MvPolynomial.C y)) = 0 := by
        intro y hy
        obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hy
        have h0 : μ (Φ (MvPolynomial.C (MvPolynomial.X 0 * MvPolynomial.X 1 -
            MvPolynomial.C b))) = 0 := by
          simp only [map_sub, map_mul, map_pow, hΦCX0, hΦCX1, hΦCC]
          rw [hb', show μ (MvPolynomial.C a0) ^ p * μ (MvPolynomial.X (Sum.inr 1)) ^ α *
              (μ (MvPolynomial.C a1) ^ p * μ (MvPolynomial.X (Sum.inr 0)) ^ α) =
              (μ (MvPolynomial.C a0) * μ (MvPolynomial.C a1)) ^ p *
              (μ (MvPolynomial.X (Sum.inr 0)) * μ (MvPolynomial.X (Sum.inr 1))) ^ α by ring,
            hMN, one_pow, mul_one, sub_self]
        rw [map_mul, map_mul, map_mul, h0, mul_zero]
      obtain ⟨κ, hκ⟩ : ∃ g : wcEbntN W b →+*
          (MvPolynomial (Fin n ⊕ Fin 2) (wcEbntN W ζ) ⧸ Ideal.span (Set.range F)),
          ∀ y, g (mb y) = μ (Φ (MvPolynomial.C y)) :=
        ⟨Ideal.Quotient.lift _ ((μ.comp Φ).comp MvPolynomial.C) hκ₀,
          fun y => Ideal.Quotient.lift_mk _ _ _⟩
      obtain ⟨lam, hlamC, hlamX⟩ : ∃ g : MvPolynomial (Fin n) (wcEbntN W b) →+*
          (MvPolynomial (Fin n ⊕ Fin 2) (wcEbntN W ζ) ⧸ Ideal.span (Set.range F)),
          (∀ r, g (MvPolynomial.C r) = κ r) ∧
          ∀ i, g (MvPolynomial.X i) = μ (MvPolynomial.X (Sum.inl i)) :=
        ⟨MvPolynomial.eval₂Hom κ (fun i => μ (MvPolynomial.X (Sum.inl i))),
          fun r => MvPolynomial.eval₂Hom_C _ _ _, fun i => MvPolynomial.eval₂Hom_X' _ _ _⟩
      have hL : ∀ q, lam (MvPolynomial.map mb q) = μ (Φ q) := by
        have H : lam.comp (MvPolynomial.map mb) = μ.comp Φ := by
          apply MvPolynomial.ringHom_ext
          · intro r
            simp only [RingHom.comp_apply]
            rw [MvPolynomial.map_C, hlamC, hκ]
          · intro i
            simp only [RingHom.comp_apply]
            rw [MvPolynomial.map_X, hlamX, hΦX]
        exact fun q => RingHom.congr_fun H q
      have hlamker : RingHom.ker ψ ≤ RingHom.ker lam := by
        rw [hψk, Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker, ← hRt', hL, ← hFl, hμ]
      obtain ⟨τ, hτ⟩ : ∃ g : T →+*
          (MvPolynomial (Fin n ⊕ Fin 2) (wcEbntN W ζ) ⧸ Ideal.span (Set.range F)),
          ∀ y, g (ψ y) = lam y :=
        ⟨ψ.liftOfRightInverse (Function.surjInv hψs) (Function.rightInverse_surjInv hψs)
          ⟨lam, hlamker⟩, fun y => RingHom.liftOfRightInverse_comp_apply _ _ _ _ y⟩
      have hτΦ : ∀ q, τ (ψ (MvPolynomial.map mb q)) = μ (Φ q) := fun q => (hτ _).trans (hL q)
      have τw : ∀ w, τ (algebraMap ↥W T w) = μ (MvPolynomial.C (γ w)) := by
        intro w
        rw [← hπC' w, ← hψmbC, hτΦ, hΦCC]
      have τu : τ (π (wcEbntX W b 0)) =
          μ (MvPolynomial.C a0) ^ p * μ (MvPolynomial.X (Sum.inr 1)) ^ α := by
        rw [show π (wcEbntX W b 0) = π (mb (MvPolynomial.X 0)) from rfl, ← hψmbC, hτΦ, hΦCX0,
          map_mul, map_pow, map_pow]
      have τs : τ (π (wcEbntX W b 1)) =
          μ (MvPolynomial.C a1) ^ p * μ (MvPolynomial.X (Sum.inr 0)) ^ α := by
        rw [show π (wcEbntX W b 1) = π (mb (MvPolynomial.X 1)) from rfl, ← hψmbC, hτΦ, hΦCX1,
          map_mul, map_pow, map_pow]
      have τx : ∀ i, τ (x i) = μ (Φ (a i)) := fun i => by rw [← ha' i, hτΦ]
      have τU : τ U = μ (Φ c) := by rw [← hc', hτΦ]
      have τψX : ∀ i, τ (ψ (MvPolynomial.X i)) = μ (MvPolynomial.X (Sum.inl i)) := fun i => by
        rw [hτ, hlamX]
      obtain ⟨Λ₀, hΛ₀C, hΛ₀0, hΛ₀1, hΛ₀2, hΛ₀3⟩ : ∃ g : MvPolynomial (Fin 4) T →+*
          (MvPolynomial (Fin n ⊕ Fin 2) (wcEbntN W ζ) ⧸ Ideal.span (Set.range F)),
          (∀ t, g (MvPolynomial.C t) = τ t) ∧
          g (MvPolynomial.X 0) = μ (MvPolynomial.C a0) ∧
          g (MvPolynomial.X 1) = μ (MvPolynomial.C a1) ∧
          g (MvPolynomial.X 2) = μ (MvPolynomial.X (Sum.inr 0)) ∧
          g (MvPolynomial.X 3) = μ (MvPolynomial.X (Sum.inr 1)) :=
        ⟨MvPolynomial.eval₂Hom τ ![μ (MvPolynomial.C a0), μ (MvPolynomial.C a1),
            μ (MvPolynomial.X (Sum.inr 0)), μ (MvPolynomial.X (Sum.inr 1))],
          fun t => MvPolynomial.eval₂Hom_C _ _ _, (MvPolynomial.eval₂Hom_X' _ _ _).trans rfl,
          (MvPolynomial.eval₂Hom_X' _ _ _).trans rfl, (MvPolynomial.eval₂Hom_X' _ _ _).trans rfl,
          (MvPolynomial.eval₂Hom_X' _ _ _).trans rfl⟩
      have hIle : wcLlsKPbdsI T (π (wcEbntX W b 0)) (π (wcEbntX W b 1))
          (algebraMap ↥W T ζ) U x p α β m₀ ≤ RingHom.ker Λ₀ := by
        unfold wcLlsKPbdsI
        rw [Ideal.span_le]
        intro g hg
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
        rw [SetLike.mem_coe, RingHom.mem_ker]
        rcases hg with rfl | rfl | rfl | rfl | rfl
        · rw [map_sub, map_mul, hΛ₀0, hΛ₀1, hΛ₀C, τw, ← map_mul, ← map_mul, ha01, sub_self]
        · rw [map_sub, map_mul, hΛ₀2, hΛ₀3, map_one, hMN, sub_self]
        · rw [map_sub, map_mul, map_pow, map_pow, hΛ₀0, hΛ₀3, hΛ₀C, τu, sub_self]
        · rw [map_sub, map_mul, map_pow, map_pow, hΛ₀1, hΛ₀2, hΛ₀C, τs, sub_self]
        · have h := hμ (Sum.inr 1)
          rw [hF1] at h
          simp only [map_sub, map_mul, map_add, map_one, map_sum, map_pow, hΛ₀C, hΛ₀1, hΛ₀2,
            τx, τU] at h ⊢
          exact h
      obtain ⟨Λ, hΛ⟩ : ∃ g : wcLlsKPbdsE T (π (wcEbntX W b 0)) (π (wcEbntX W b 1))
          (algebraMap ↥W T ζ) U x p α β m₀ →+*
          (MvPolynomial (Fin n ⊕ Fin 2) (wcEbntN W ζ) ⧸ Ideal.span (Set.range F)),
          ∀ f, g (mkI f) = Λ₀ f :=
        ⟨Ideal.Quotient.lift _ Λ₀ (fun g hg => (RingHom.mem_ker).mp (hIle hg)),
          fun f => Ideal.Quotient.lift_mk _ _ _⟩
      have H3 : Λ.comp ν = μ.comp MvPolynomial.C := by
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro w
          simp only [RingHom.comp_apply]
          rw [hνmk, hν₀C, hAW, hΛ, hΛ₀C]
          exact τw w
        · refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
          · simp only [RingHom.comp_apply]
            rw [hνmk, hν₀X0, hΛ, hΛ₀0]
          · simp only [RingHom.comp_apply]
            rw [hνmk, hν₀X1, hΛ, hΛ₀1]
      have HΛ : Λ.comp φ = μ := by
        apply MvPolynomial.ringHom_ext
        · intro y
          have h := RingHom.congr_fun H3 y
          simp only [RingHom.comp_apply] at h ⊢
          rw [hφC]
          exact h
        · rintro (i | r)
          · simp only [RingHom.comp_apply]
            rw [hφXl, hΛ, hΛ₀C, τψX]
          · revert r
            refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
            · simp only [RingHom.comp_apply]
              rw [hφX2, hΛ, hΛ₀2]
            · simp only [RingHom.comp_apply]
              rw [hφX3, hΛ, hΛ₀3]
      have hμf : μ f = 0 := by
        rw [← HΛ, RingHom.comp_apply, hf, map_zero]
      exact Ideal.Quotient.eq_zero_iff_mem.mp hμf
    · rw [Ideal.span_le]
      rintro _ ⟨l, rfl⟩
      exact (RingHom.mem_ker).mpr (hφF l)
  exact ⟨φ, hsurj, hker, fun w => (hφC _).trans ((hνmk _).trans (hν₀C w)), hφa0, hφa1, hφX2,
    fun q => (hK q).trans (hAT _).symm⟩

theorem wcLlsKP_bdsm_jacobian_congr : ∀ {S₀ N : Type u} [CommRing S₀] [CommRing N] (γ : S₀ →+* N)
    (a0 a1 : N) (n p α β m₀ : ℕ)
    (Rt : Fin n → MvPolynomial (Fin n) (MvPolynomial (Fin 2) S₀))
    (a : ℕ → MvPolynomial (Fin n) (MvPolynomial (Fin 2) S₀))
    (c : MvPolynomial (Fin n) (MvPolynomial (Fin 2) S₀)),
    1 ≤ p → 1 ≤ m₀ →
    (Matrix.of fun k l => MvPolynomial.pderiv k (wcLlsKPbdsEqs γ a0 a1 n p α β m₀ Rt a c l)).det +
      MvPolynomial.X (Sum.inr 0) * wcLlsKPbdsSubst γ a0 a1 n p α
        (Matrix.of fun j i => MvPolynomial.pderiv i (Rt j)).det ∈
      Ideal.span {MvPolynomial.C a0, MvPolynomial.C a1} :=
by
  intro S₀ N _ _ γ a0 a1 n p α β m₀ Rt a c hp hm₀
  classical
  set J : Ideal (MvPolynomial (Fin n ⊕ Fin 2) N) :=
    Ideal.span {MvPolynomial.C a0, MvPolynomial.C a1} with hJ
  have ha0 : (MvPolynomial.C a0 : MvPolynomial (Fin n ⊕ Fin 2) N) ∈ J :=
    Ideal.subset_span (Set.mem_insert _ _)
  have ha1 : (MvPolynomial.C a1 : MvPolynomial (Fin n ⊕ Fin 2) N) ∈ J :=
    Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))

  have hCmul : ∀ (b : N) (v : Fin n ⊕ Fin 2) (y : MvPolynomial (Fin n ⊕ Fin 2) N),
      MvPolynomial.C b ∈ J → MvPolynomial.pderiv v (MvPolynomial.C b * y) ∈ J := by
    intro b v y hb
    rw [MvPolynomial.pderiv_C_mul]
    exact J.mul_mem_right _ hb
  set g : MvPolynomial (Fin 2) S₀ →+* MvPolynomial (Fin n ⊕ Fin 2) N :=
    MvPolynomial.eval₂Hom (MvPolynomial.C.comp γ)
      ![MvPolynomial.C a0 ^ p * MvPolynomial.X (Sum.inr 1) ^ α,
        MvPolynomial.C a1 ^ p * MvPolynomial.X (Sum.inr 0) ^ α] with hg
  have hgC : ∀ t : S₀, g (MvPolynomial.C t) = MvPolynomial.C (γ t) := by
    intro t
    rw [hg, MvPolynomial.eval₂Hom_C]
    rfl
  have hgX : ∀ j : Fin 2, ∃ (b : N) (r : Fin 2), MvPolynomial.C b ∈ J ∧
      g (MvPolynomial.X j) = MvPolynomial.C b * MvPolynomial.X (Sum.inr r) ^ α := by
    intro j
    fin_cases j
    · refine ⟨a0 ^ p, 1, ?_, ?_⟩
      · rw [map_pow]; exact J.pow_mem_of_mem ha0 _ (by omega)
      · rw [hg, MvPolynomial.eval₂Hom_X', map_pow]; rfl
    · refine ⟨a1 ^ p, 0, ?_, ?_⟩
      · rw [map_pow]; exact J.pow_mem_of_mem ha1 _ (by omega)
      · rw [hg, MvPolynomial.eval₂Hom_X', map_pow]; rfl
  have hSC : ∀ s, wcLlsKPbdsSubst γ a0 a1 n p α (MvPolynomial.C s) = g s := by
    intro s
    rw [wcLlsKPbdsSubst, MvPolynomial.eval₂Hom_C]
  have hSX : ∀ i, wcLlsKPbdsSubst γ a0 a1 n p α (MvPolynomial.X i) = MvPolynomial.X (Sum.inl i) := by
    intro i
    rw [wcLlsKPbdsSubst, MvPolynomial.eval₂Hom_X']

  have hg_inl : ∀ (k : Fin n) (s : MvPolynomial (Fin 2) S₀),
      MvPolynomial.pderiv (Sum.inl k) (g s) = 0 := by
    intro k s
    induction s using MvPolynomial.induction_on with
    | C t =>
      rw [hgC, MvPolynomial.pderiv_C]
    | add s1 s2 h1 h2 =>
      rw [map_add, map_add, h1, h2, add_zero]
    | mul_X s j h =>
      obtain ⟨b, r, -, he⟩ := hgX j
      rw [map_mul, Derivation.leibniz, h, he, MvPolynomial.pderiv_C_mul, Derivation.leibniz_pow,
        MvPolynomial.pderiv_X_of_ne (by simp)]
      simp

  have hg_inr : ∀ (r : Fin 2) (s : MvPolynomial (Fin 2) S₀),
      MvPolynomial.pderiv (Sum.inr r) (g s) ∈ J := by
    intro r s
    induction s using MvPolynomial.induction_on with
    | C t =>
      rw [hgC, MvPolynomial.pderiv_C]
      exact J.zero_mem
    | add s1 s2 h1 h2 =>
      rw [map_add, map_add]
      exact J.add_mem h1 h2
    | mul_X s j h =>
      obtain ⟨b, r', hb, he⟩ := hgX j
      rw [map_mul, Derivation.leibniz, smul_eq_mul, smul_eq_mul]
      refine J.add_mem (J.mul_mem_left _ ?_) (J.mul_mem_left _ h)
      rw [he]
      exact hCmul b _ _ hb

  have hs1 : ∀ (k : Fin n) (q : MvPolynomial (Fin n) (MvPolynomial (Fin 2) S₀)),
      MvPolynomial.pderiv (Sum.inl k) (wcLlsKPbdsSubst γ a0 a1 n p α q) =
        wcLlsKPbdsSubst γ a0 a1 n p α (MvPolynomial.pderiv k q) := by
    intro k q
    induction q using MvPolynomial.induction_on with
    | C s =>
      rw [hSC, hg_inl, MvPolynomial.pderiv_C, map_zero]
    | add q1 q2 h1 h2 =>
      simp only [map_add, h1, h2]
    | mul_X q i h =>
      have hXX : MvPolynomial.pderiv (Sum.inl k)
          (MvPolynomial.X (Sum.inl i) : MvPolynomial (Fin n ⊕ Fin 2) N) =
          wcLlsKPbdsSubst γ a0 a1 n p α (MvPolynomial.pderiv k (MvPolynomial.X i)) := by
        rw [MvPolynomial.pderiv_X, MvPolynomial.pderiv_X]
        by_cases hik : i = k
        · subst hik
          simp
        · simp [hik]
      rw [map_mul, Derivation.leibniz, Derivation.leibniz]
      simp only [smul_eq_mul]
      rw [map_add, map_mul, map_mul, h, hSX, hXX]

  have hs2 : ∀ (r : Fin 2) (q : MvPolynomial (Fin n) (MvPolynomial (Fin 2) S₀)),
      MvPolynomial.pderiv (Sum.inr r) (wcLlsKPbdsSubst γ a0 a1 n p α q) ∈ J := by
    intro r q
    induction q using MvPolynomial.induction_on with
    | C s =>
      rw [hSC]
      exact hg_inr r s
    | add q1 q2 h1 h2 =>
      rw [map_add, map_add]
      exact J.add_mem h1 h2
    | mul_X q i h =>
      rw [map_mul, Derivation.leibniz, hSX, MvPolynomial.pderiv_X_of_ne (by simp), smul_zero,
        zero_add, smul_eq_mul]
      exact J.mul_mem_left _ h

  have hblock : ∀ B : Matrix (Fin n ⊕ Fin 2) (Fin n ⊕ Fin 2) (MvPolynomial (Fin n ⊕ Fin 2) N),
      (∀ (r : Fin 2) (i : Fin n), B (Sum.inr r) (Sum.inl i) ∈ J) →
      B (Sum.inr 0) (Sum.inr 1) - 1 ∈ J → B (Sum.inr 1) (Sum.inr 1) ∈ J →
      B.det + B (Sum.inr 1) (Sum.inr 0) * B.toBlocks₁₁.det ∈ J := by
    intro B h21 h01 h11
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_add, map_mul, RingHom.map_det, RingHom.map_det,
      RingHom.mapMatrix_apply, RingHom.mapMatrix_apply,
      ← Matrix.fromBlocks_toBlocks (B.map (Ideal.Quotient.mk J))]
    have hz : (B.map (Ideal.Quotient.mk J)).toBlocks₂₁ = 0 := by
      ext r i
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (h21 r i)
    have e1 : (B.map (Ideal.Quotient.mk J)).toBlocks₂₂ 0 1 = 1 := by
      show Ideal.Quotient.mk J (B (Sum.inr 0) (Sum.inr 1)) = 1
      rw [← map_one (Ideal.Quotient.mk J)]
      exact Ideal.Quotient.eq.mpr h01
    have e2 : (B.map (Ideal.Quotient.mk J)).toBlocks₂₂ 1 1 = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr h11
    have e3 : (B.map (Ideal.Quotient.mk J)).toBlocks₂₂ 1 0 =
        Ideal.Quotient.mk J (B (Sum.inr 1) (Sum.inr 0)) := rfl
    have e4 : (B.map (Ideal.Quotient.mk J)).toBlocks₁₁ =
        B.toBlocks₁₁.map (Ideal.Quotient.mk J) := rfl
    rw [hz, Matrix.det_fromBlocks_zero₂₁, Matrix.det_fin_two, e1, e2, e3, e4]
    ring

  set w : MvPolynomial (Fin n ⊕ Fin 2) N :=
    MvPolynomial.C a1 ^ m₀ * MvPolynomial.X (Sum.inr 0) ^ β with hw
  have hwJ : w ∈ J := J.mul_mem_right _ (J.pow_mem_of_mem ha1 _ (by omega))
  have hDw : ∀ v, MvPolynomial.pderiv v w ∈ J := by
    intro v
    rw [hw, ← map_pow]
    exact hCmul _ _ _ (by rw [map_pow]; exact J.pow_mem_of_mem ha1 _ (by omega))
  set S : MvPolynomial (Fin n ⊕ Fin 2) N :=
    ∑ i ∈ Finset.Ico 1 p, wcLlsKPbdsSubst γ a0 a1 n p α (a i) * w ^ (p - i) with hS
  have hSJ : S ∈ J := by
    refine J.sum_mem fun i hi => J.mul_mem_left _ (J.pow_mem_of_mem hwJ _ ?_)
    rw [Finset.mem_Ico] at hi
    omega
  have hDS : ∀ r : Fin 2, MvPolynomial.pderiv (Sum.inr r) S ∈ J := by
    intro r
    rw [hS, map_sum]
    refine J.sum_mem fun i _ => ?_
    rw [Derivation.leibniz, Derivation.leibniz_pow, smul_eq_mul, smul_eq_mul, smul_eq_mul,
      nsmul_eq_mul]
    exact J.add_mem (J.mul_mem_left _ (J.mul_mem_left _ (J.mul_mem_left _ (hDw _))))
      (J.mul_mem_left _ (hs2 r (a i)))
  set F := wcLlsKPbdsEqs γ a0 a1 n p α β m₀ Rt a c with hF
  have hF1 : F (Sum.inr 1) = MvPolynomial.X (Sum.inr 0) * (1 + S) -
      wcLlsKPbdsSubst γ a0 a1 n p α c := rfl
  have hF0 : F (Sum.inr 0) = MvPolynomial.X (Sum.inr 0) * MvPolynomial.X (Sum.inr 1) - 1 := rfl
  have hG : ∀ r : Fin 2, MvPolynomial.pderiv (Sum.inr r) (F (Sum.inr 1)) -
      MvPolynomial.pderiv (Sum.inr r) (MvPolynomial.X (Sum.inr 0)) ∈ J := by
    intro r
    rw [hF1, map_sub, Derivation.leibniz, map_add, Derivation.map_one_eq_zero, zero_add,
      smul_eq_mul, smul_eq_mul]
    have key : ∀ x y z u : MvPolynomial (Fin n ⊕ Fin 2) N,
        x * y + (1 + S) * z - u - z = x * y + S * z - u := by
      intros; ring
    rw [key]
    exact J.sub_mem (J.add_mem (J.mul_mem_left _ (hDS r)) (J.mul_mem_right _ hSJ)) (hs2 r c)
  set A : Matrix (Fin n ⊕ Fin 2) (Fin n ⊕ Fin 2) (MvPolynomial (Fin n ⊕ Fin 2) N) :=
    Matrix.of fun k l => MvPolynomial.pderiv k (F l) with hA
  have h01 : A (Sum.inr 0) (Sum.inr 1) - 1 ∈ J := by
    have h := hG 0
    rw [MvPolynomial.pderiv_X_self] at h
    exact h
  have h11 : A (Sum.inr 1) (Sum.inr 1) ∈ J := by
    have h := hG 1
    rw [MvPolynomial.pderiv_X_of_ne (by simp), sub_zero] at h
    exact h
  have h10 : A (Sum.inr 1) (Sum.inr 0) = MvPolynomial.X (Sum.inr 0) := by
    show MvPolynomial.pderiv (Sum.inr 1) (F (Sum.inr 0)) = _
    rw [hF0, map_sub, Derivation.leibniz, Derivation.map_one_eq_zero, MvPolynomial.pderiv_X_self,
      MvPolynomial.pderiv_X_of_ne (by simp), smul_zero, smul_eq_mul, mul_one, add_zero, sub_zero]
  have hblk : A.toBlocks₁₁ = ((Matrix.of fun j i => MvPolynomial.pderiv i (Rt j)).map
      (wcLlsKPbdsSubst γ a0 a1 n p α)).transpose := by
    refine Matrix.ext fun k j => ?_
    show MvPolynomial.pderiv (Sum.inl k) (wcLlsKPbdsSubst γ a0 a1 n p α (Rt j)) = _
    rw [hs1]
    rfl
  have hdet : A.toBlocks₁₁.det = wcLlsKPbdsSubst γ a0 a1 n p α
      (Matrix.of fun j i => MvPolynomial.pderiv i (Rt j)).det := by
    rw [hblk, Matrix.det_transpose, RingHom.map_det, RingHom.mapMatrix_apply]
  have hfin := hblock A (fun r i => hs2 r (Rt i)) h01 h11
  rw [h10, hdet] at hfin
  exact hfin

theorem wcLlsKP_bdsm_jacobian_away_etale : ∀ (A : Type u) [CommRing A] {ι : Type} [Fintype ι]
    [DecidableEq ι] (f : ι → MvPolynomial ι A),
    RingHom.Etale ((algebraMap (MvPolynomial ι A ⧸ Ideal.span (Set.range f))
      (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range f))
        (Matrix.of fun i j => MvPolynomial.pderiv i (f j)).det))).comp
      (algebraMap A (MvPolynomial ι A ⧸ Ideal.span (Set.range f)))) :=
by
  intro A _ ι _ _ f
  classical

  have hiso : ∀ d : MvPolynomial ι A,
      Nonempty ((MvPolynomial (Option ι) A ⧸ Ideal.span (Set.range fun o : Option ι =>
        Option.elim o (MvPolynomial.X none * MvPolynomial.rename some d - 1)
          (fun j => MvPolynomial.rename some (f j)))) ≃ₐ[A]
        Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range f)) d)) := by
    intro d
    set I := Ideal.span (Set.range f) with hI
    set r : MvPolynomial ι A →ₐ[A] MvPolynomial (Option ι) A := MvPolynomial.rename some with hr
    set F' : Option ι → MvPolynomial (Option ι) A :=
      fun o => Option.elim o (MvPolynomial.X none * r d - 1) (fun j => r (f j)) with hF'
    set I' := Ideal.span (Set.range F') with hI'
    set Q := MvPolynomial ι A ⧸ I
    set db : Q := Ideal.Quotient.mk I d with hdb
    set L := Localization.Away db
    let v : Option ι → L := fun o =>
      Option.elim o (IsLocalization.Away.invSelf db)
        (fun i => algebraMap Q L (Ideal.Quotient.mk I (MvPolynomial.X i)))
    let Φ0 : MvPolynomial (Option ι) A →ₐ[A] L := MvPolynomial.aeval v
    have hK1' : Φ0.comp r = (IsScalarTower.toAlgHom A Q L).comp (Ideal.Quotient.mkₐ A I) := by
      apply MvPolynomial.algHom_ext
      intro i
      simp only [AlgHom.comp_apply, Φ0, hr, MvPolynomial.rename_X, MvPolynomial.aeval_X, v,
        Option.elim, IsScalarTower.coe_toAlgHom']
      rfl
    have hK1 : ∀ p, Φ0 (r p) = algebraMap Q L (Ideal.Quotient.mk I p) := by
      intro p
      exact AlgHom.congr_fun hK1' p
    have hker : I' ≤ RingHom.ker (Φ0 : MvPolynomial (Option ι) A →+* L) := by
      rw [hI', Ideal.span_le]
      rintro _ ⟨o, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker]
      cases o with
      | none =>
        show Φ0 (MvPolynomial.X none * r d - 1) = 0
        rw [map_sub, map_mul, hK1, map_one]
        simp only [Φ0, MvPolynomial.aeval_X, v, Option.elim]
        rw [mul_comm, IsLocalization.Away.mul_invSelf, sub_self]
      | some j =>
        show Φ0 (r (f j)) = 0
        have hfj : f j ∈ I := Ideal.subset_span ⟨j, rfl⟩
        rw [hK1, Ideal.Quotient.eq_zero_iff_mem.mpr hfj, map_zero]
    let Φ : (MvPolynomial (Option ι) A ⧸ I') →ₐ[A] L :=
      Ideal.Quotient.liftₐ I' Φ0 (fun a ha => hker ha)
    have hΦmk : ∀ x, Φ (Ideal.Quotient.mk I' x) = Φ0 x := fun x => rfl
    have hI0 : I ≤ RingHom.ker ((Ideal.Quotient.mk I').comp (r : MvPolynomial ι A →+* _)) := by
      rw [hI, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨some j, rfl⟩)
    let ψ0 : Q →+* (MvPolynomial (Option ι) A ⧸ I') :=
      Ideal.Quotient.lift I ((Ideal.Quotient.mk I').comp (r : MvPolynomial ι A →+* _))
        (fun a ha => RingHom.mem_ker.mp (hI0 ha))
    have hψ0 : ∀ p, ψ0 (Ideal.Quotient.mk I p) = Ideal.Quotient.mk I' (r p) := fun p => rfl
    have hxr : Ideal.Quotient.mk I' (r d) * Ideal.Quotient.mk I' (MvPolynomial.X none) = 1 := by
      have h : Ideal.Quotient.mk I' (MvPolynomial.X none * r d - 1) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨none, rfl⟩)
      rw [map_sub, map_mul, map_one, sub_eq_zero] at h
      rw [mul_comm]; exact h
    have hunit : IsUnit (ψ0 db) := by
      rw [hdb, hψ0]
      exact IsUnit.of_mul_eq_one _ hxr
    let Ψ : L →+* (MvPolynomial (Option ι) A ⧸ I') := IsLocalization.Away.lift db hunit
    have hΨ : ∀ q, Ψ (algebraMap Q L q) = ψ0 q := fun q => IsLocalization.Away.lift_eq db hunit q
    have h1 : (Φ : (MvPolynomial (Option ι) A ⧸ I') →+* L).comp Ψ = RingHom.id L := by
      apply IsLocalization.ringHom_ext (Submonoid.powers db)
      apply Ideal.Quotient.ringHom_ext
      refine RingHom.ext fun p => ?_
      simp only [RingHom.comp_apply, RingHom.id_apply, RingHom.coe_coe]
      rw [hΨ, hψ0, hΦmk, hK1]
    have hround : ∀ p, Ψ (Φ (Ideal.Quotient.mk I' (r p))) = Ideal.Quotient.mk I' (r p) := by
      intro p
      rw [hΦmk, hK1, hΨ, hψ0]
    have h2 : Ψ.comp (Φ : (MvPolynomial (Option ι) A ⧸ I') →+* L) = RingHom.id _ := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, RingHom.id_apply, RingHom.coe_coe]
        have : (MvPolynomial.C a : MvPolynomial (Option ι) A) = r (MvPolynomial.C a) := by
          rw [hr, MvPolynomial.rename_C]
        rw [this, hround]
      · intro o
        simp only [RingHom.comp_apply, RingHom.id_apply, RingHom.coe_coe]
        cases o with
        | none =>
          rw [hΦmk]
          simp only [Φ0, MvPolynomial.aeval_X, v, Option.elim]
          have hy : Ψ (IsLocalization.Away.invSelf db) * Ideal.Quotient.mk I' (r d) = 1 := by
            rw [← hψ0, ← hΨ, ← map_mul, mul_comm, IsLocalization.Away.mul_invSelf, map_one]
          calc Ψ (IsLocalization.Away.invSelf db)
              = Ψ (IsLocalization.Away.invSelf db) *
                  (Ideal.Quotient.mk I' (r d) * Ideal.Quotient.mk I' (MvPolynomial.X none)) := by
                rw [hxr, mul_one]
            _ = (Ψ (IsLocalization.Away.invSelf db) * Ideal.Quotient.mk I' (r d)) *
                  Ideal.Quotient.mk I' (MvPolynomial.X none) := by ring
            _ = Ideal.Quotient.mk I' (MvPolynomial.X none) := by rw [hy, one_mul]
        | some i =>
          have : (MvPolynomial.X (some i) : MvPolynomial (Option ι) A) = r (MvPolynomial.X i) := by
            rw [hr, MvPolynomial.rename_X]
          rw [this, hround]
    refine ⟨AlgEquiv.ofBijective Φ ?_⟩
    refine Function.bijective_iff_has_inverse.mpr ⟨Ψ, fun x => ?_, fun y => ?_⟩
    · exact RingHom.congr_fun h2 x
    · exact RingHom.congr_fun h1 y
  obtain ⟨e⟩ := hiso (Matrix.of fun i j => MvPolynomial.pderiv i (f j)).det
  set d := (Matrix.of fun i j => MvPolynomial.pderiv i (f j)).det with hd
  set r : MvPolynomial ι A →ₐ[A] MvPolynomial (Option ι) A := MvPolynomial.rename some with hr
  set F' : Option ι → MvPolynomial (Option ι) A :=
    fun o => Option.elim o (MvPolynomial.X none * r d - 1) (fun j => r (f j)) with hF'
  set I' := Ideal.span (Set.range F') with hI'

  have hr0 : ∀ p : MvPolynomial ι A, MvPolynomial.pderiv none (r p) = 0 := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a => simp [hr]
    | add p q hp hq => rw [map_add, map_add, hp, hq, add_zero]
    | mul_X p n hp =>
      rw [map_mul, Derivation.leibniz, hp]
      simp [hr, MvPolynomial.pderiv_X]
  have hrs : ∀ (k : ι) (p : MvPolynomial ι A),
      MvPolynomial.pderiv (some k) (r p) = r (MvPolynomial.pderiv k p) :=
    fun k p => MvPolynomial.pderiv_rename (Option.some_injective ι) k p

  have hdet : (Matrix.of fun i j => MvPolynomial.pderiv i (F' j)).det = r d * r d := by
    rw [← Matrix.det_reindex_self (Equiv.optionEquivSumPUnit.{0} ι)]
    have hblk : Matrix.reindex (Equiv.optionEquivSumPUnit.{0} ι) (Equiv.optionEquivSumPUnit.{0} ι)
        (Matrix.of fun i j => MvPolynomial.pderiv i (F' j)) =
        Matrix.fromBlocks ((r : MvPolynomial ι A →+* MvPolynomial (Option ι) A).mapMatrix
            (Matrix.of fun i j => MvPolynomial.pderiv i (f j)))
          (Matrix.of fun k (_ : PUnit.{1}) => MvPolynomial.pderiv (some k) (F' none)) 0
          (Matrix.of fun (_ _ : PUnit.{1}) => r d) := by
      ext (a|a) (b|b)
      · simp [hF', hrs]
      · simp
      · simp [hF', hr0]
      · simp [hF', hr0, MvPolynomial.pderiv_X]
    rw [hblk, Matrix.det_fromBlocks_zero₂₁, ← RingHom.map_det,
      Matrix.det_unique (Matrix.of fun (_ _ : PUnit.{1}) => r d)]
    rfl

  have hcert : MvPolynomial.X none ^ 2 *
      (Matrix.of fun i j => MvPolynomial.pderiv (id i) (F' j)).det - 1 ∈ I' := by
    have h1 : MvPolynomial.X none ^ 2 *
        (Matrix.of fun i j => MvPolynomial.pderiv (id i) (F' j)).det - 1 =
        F' none * (F' none + 2) := by
      simp only [id]
      rw [hdet]
      simp only [hF', Option.elim]
      ring
    rw [h1]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨none, rfl⟩)

  have hQ' : Algebra.Etale A (MvPolynomial (Option ι) A ⧸ I') := by
    let P : Algebra.PreSubmersivePresentation A (MvPolynomial (Option ι) A ⧸ I')
        (Option ι) (Option ι) :=
      { Algebra.Presentation.naive (v := F') with map := id, map_inj := Function.injective_id }
    have hJ : P.jacobiMatrix = Matrix.of fun i j => MvPolynomial.pderiv (id i) (F' j) := by
      ext i j
      rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      rfl
    have halg : ∀ x : MvPolynomial (Option ι) A,
        algebraMap P.Ring (MvPolynomial (Option ι) A ⧸ I') x = Ideal.Quotient.mk I' x :=
      fun x => rfl
    have hunit : IsUnit P.jacobian := by
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, hJ, halg]
      have h1 : Ideal.Quotient.mk I' (MvPolynomial.X none ^ 2 *
          (Matrix.of fun i j => MvPolynomial.pderiv (id i) (F' j)).det) = 1 := by
        rw [← map_one (Ideal.Quotient.mk I'), Ideal.Quotient.eq]
        exact hcert
      rw [map_mul, mul_comm] at h1
      exact IsUnit.of_mul_eq_one _ h1
    let Qp : Algebra.SubmersivePresentation A (MvPolynomial (Option ι) A ⧸ I')
        (Option ι) (Option ι) :=
      { P with jacobian_isUnit := hunit }
    have hdim : Qp.dimension = 0 := by
      show Nat.card (Option ι) - Nat.card (Option ι) = 0
      rw [Nat.sub_self]
    have := Qp.isStandardSmoothOfRelativeDimension hdim
    infer_instance

  have hL : Algebra.Etale A (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range f)) d)) :=
    Algebra.Etale.of_equiv e
  rw [← IsScalarTower.algebraMap_eq]
  exact RingHom.etale_algebraMap.mpr hL

theorem wcLlsKP_bdsm_origin_maximal : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (ζ : ↥W),
    ζ ∈ IsLocalRing.maximalIdeal ↥W →
    (Ideal.span {wcEbntX W ζ 0, wcEbntX W ζ 1} ⊔ (IsLocalRing.maximalIdeal ↥W).map
      ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C ζ})).comp MvPolynomial.C)).IsMaximal :=
by
  intro Ω _ W ζ hζ
  classical
  let I : Ideal (MvPolynomial (Fin 2) ↥W) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ζ}
  let Φ : MvPolynomial (Fin 2) ↥W →+* IsLocalRing.ResidueField ↥W :=
    (IsLocalRing.residue ↥W).comp MvPolynomial.constantCoeff
  have hΦ : ∀ a ∈ I, Φ a = 0 := by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    have hg : Φ (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ζ) = 0 := by
      simp only [Φ, RingHom.comp_apply, map_sub, map_mul, MvPolynomial.constantCoeff_X,
        MvPolynomial.constantCoeff_C, map_zero, zero_mul, zero_sub, map_neg, neg_eq_zero]
      exact (IsLocalRing.residue_eq_zero_iff ζ).mpr hζ
    rw [map_mul, hg, mul_zero]
  let φ : (MvPolynomial (Fin 2) ↥W ⧸ I) →+* IsLocalRing.ResidueField ↥W :=
    Ideal.Quotient.lift I Φ hΦ
  have hφmk : ∀ p, φ (Ideal.Quotient.mk I p) =
      IsLocalRing.residue ↥W (MvPolynomial.constantCoeff p) :=
    fun p => (Ideal.Quotient.lift_mk I Φ hΦ).trans rfl
  have hφs : Function.Surjective φ := by
    intro t
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective t
    exact ⟨Ideal.Quotient.mk I (MvPolynomial.C a), by rw [hφmk, MvPolynomial.constantCoeff_C]⟩
  have hmax : (RingHom.ker φ).IsMaximal := RingHom.ker_isMaximal_of_surjective φ hφs
  have hx0 : Ideal.Quotient.mk I (MvPolynomial.X 0) ∈
      Ideal.span ({wcEbntX W ζ 0, wcEbntX W ζ 1} : Set (MvPolynomial (Fin 2) ↥W ⧸ I)) :=
    Ideal.subset_span (Set.mem_insert _ _)
  have hx1 : Ideal.Quotient.mk I (MvPolynomial.X 1) ∈
      Ideal.span ({wcEbntX W ζ 0, wcEbntX W ζ 1} : Set (MvPolynomial (Fin 2) ↥W ⧸ I)) :=
    Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  have hx : ∀ n : Fin 2, Ideal.Quotient.mk I (MvPolynomial.X n) ∈
      Ideal.span ({wcEbntX W ζ 0, wcEbntX W ζ 1} : Set (MvPolynomial (Fin 2) ↥W ⧸ I)) := by
    intro n
    fin_cases n
    · exact hx0
    · exact hx1
  have hs5 : ∀ p : MvPolynomial (Fin 2) ↥W, Ideal.Quotient.mk I p -
      Ideal.Quotient.mk I (MvPolynomial.C (MvPolynomial.constantCoeff p)) ∈
      Ideal.span ({wcEbntX W ζ 0, wcEbntX W ζ 1} : Set (MvPolynomial (Fin 2) ↥W ⧸ I)) := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a =>
      rw [MvPolynomial.constantCoeff_C, sub_self]
      exact Ideal.zero_mem _
    | add p q hp hq =>
      have e : Ideal.Quotient.mk I (p + q) -
          Ideal.Quotient.mk I (MvPolynomial.C (MvPolynomial.constantCoeff (p + q))) =
          (Ideal.Quotient.mk I p - Ideal.Quotient.mk I (MvPolynomial.C (MvPolynomial.constantCoeff p))) +
          (Ideal.Quotient.mk I q - Ideal.Quotient.mk I (MvPolynomial.C (MvPolynomial.constantCoeff q))) := by
        rw [map_add, map_add, map_add, map_add]
        ring
      rw [e]
      exact Ideal.add_mem _ hp hq
    | mul_X p n _ =>
      rw [map_mul MvPolynomial.constantCoeff p (MvPolynomial.X n), MvPolynomial.constantCoeff_X,
        mul_zero, map_zero, map_zero, sub_zero, map_mul]
      exact Ideal.mul_mem_left _ _ (hx n)
  convert hmax using 1
  apply le_antisymm
  · apply sup_le
    · rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
      refine ⟨?_, ?_⟩
      · show φ (Ideal.Quotient.mk I (MvPolynomial.X 0)) = 0
        rw [hφmk, MvPolynomial.constantCoeff_X, map_zero]
      · show φ (Ideal.Quotient.mk I (MvPolynomial.X 1)) = 0
        rw [hφmk, MvPolynomial.constantCoeff_X, map_zero]
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply, hφmk, MvPolynomial.constantCoeff_C]
      exact (IsLocalRing.residue_eq_zero_iff a).mpr ha
  · intro y hy
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [RingHom.mem_ker, hφmk] at hy
    have hc := (IsLocalRing.residue_eq_zero_iff _).mp hy
    have e : Ideal.Quotient.mk I p = (Ideal.Quotient.mk I p -
        Ideal.Quotient.mk I (MvPolynomial.C (MvPolynomial.constantCoeff p))) +
        ((Ideal.Quotient.mk I).comp MvPolynomial.C) (MvPolynomial.constantCoeff p) := by
      rw [RingHom.comp_apply]
      ring
    rw [e]
    exact Ideal.add_mem _ (Ideal.mem_sup_left (hs5 p))
      (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc))

theorem wcLlsKP_bdsm_etale_fibre_idem : ∀ (A B : Type u) [CommRing A] [CommRing B] (φ : A →+* B),
    RingHom.Etale φ → ∀ (𝔞 : Ideal A) [𝔞.IsMaximal] (Q : Ideal B) [Q.IsPrime], 𝔞.map φ ≤ Q →
    ∃ ε : B, ε ∉ Q ∧ ∀ y ∈ Q, ε * y ∈ 𝔞.map φ :=
by
  intro A B _ _ φ hφ 𝔞 _ Q _ hle
  letI : Algebra A B := φ.toAlgebra
  haveI : Algebra.Etale A B := hφ
  have hφeq : algebraMap A B = φ := rfl
  rw [← hφeq] at hle ⊢
  set I : Ideal B := 𝔞.map (algebraMap A B) with hI
  letI : Field (A ⧸ 𝔞) := Ideal.Quotient.field 𝔞
  haveI : Algebra.FormallyUnramified A (B ⧸ I) := inferInstance
  haveI : Algebra.FiniteType A (B ⧸ I) := inferInstance
  haveI : Algebra.FormallyUnramified (A ⧸ 𝔞) (B ⧸ I) :=
    Algebra.FormallyUnramified.of_restrictScalars A (A ⧸ 𝔞) (B ⧸ I)
  haveI : Algebra.FiniteType (A ⧸ 𝔞) (B ⧸ I) :=
    Algebra.FiniteType.of_restrictScalars_finiteType A (A ⧸ 𝔞) (B ⧸ I)
  haveI : Algebra.EssFiniteType (A ⧸ 𝔞) (B ⧸ I) := Algebra.EssFiniteType.of_finiteType _ _
  haveI : Module.Finite (A ⧸ 𝔞) (B ⧸ I) :=
    Algebra.FormallyUnramified.finite_of_free (A ⧸ 𝔞) (B ⧸ I)
  haveI : IsArtinianRing (B ⧸ I) := IsArtinianRing.of_finite (A ⧸ 𝔞) (B ⧸ I)
  haveI : _root_.IsReduced (B ⧸ I) :=
    Algebra.FormallyUnramified.isReduced_of_field (A ⧸ 𝔞) (B ⧸ I)
  haveI : IsSemisimpleRing (B ⧸ I) := IsArtinianRing.isSemisimpleRing_of_isReduced (B ⧸ I)
  obtain ⟨e, he, hQe⟩ := IsSemisimpleRing.ideal_eq_span_idempotent (Q.map (Ideal.Quotient.mk I))
  obtain ⟨ε, hε⟩ := Ideal.Quotient.mk_surjective (I := I) (1 - e)
  refine ⟨ε, ?_, ?_⟩
  · intro hεQ
    have h1 : Ideal.Quotient.mk I ε ∈ Q.map (Ideal.Quotient.mk I) := Ideal.mem_map_of_mem _ hεQ
    have h2 : e ∈ Q.map (Ideal.Quotient.mk I) := by
      rw [hQe]; exact Ideal.mem_span_singleton_self e
    have h3 : Ideal.Quotient.mk I 1 ∈ Q.map (Ideal.Quotient.mk I) := by
      rw [map_one]
      have := Ideal.add_mem _ h1 h2
      rwa [hε, sub_add_cancel] at this
    rw [Ideal.mem_quotient_iff_mem_sup, sup_eq_left.mpr hle] at h3
    exact (inferInstance : Q.IsPrime).ne_top ((Ideal.eq_top_iff_one _).mpr h3)
  · intro y hy
    have h1 : Ideal.Quotient.mk I y ∈ Q.map (Ideal.Quotient.mk I) := Ideal.mem_map_of_mem _ hy
    rw [hQe, Ideal.mem_span_singleton'] at h1
    obtain ⟨r, hr⟩ := h1
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, hε, ← hr]
    have he' : e * e = e := he
    calc (1 - e) * (r * e) = r * (e - e * e) := by ring
      _ = 0 := by rw [he', sub_self, mul_zero]

theorem wcLlsKP_bdsm_localize_twice : ∀ (N Q : Type u) [CommRing N] [CommRing Q] (γ : N →+* Q)
    (𝔞 : Ideal N) (𝔔 : Ideal Q) [𝔔.IsPrime] (Δ : Q), Δ ∉ 𝔔 → 𝔞.map γ ≤ 𝔔 →
    RingHom.Etale ((algebraMap Q (Localization.Away Δ)).comp γ) →
    ∀ ε : Localization.Away Δ, ε ∉ 𝔔.map (algebraMap Q (Localization.Away Δ)) →
    (∀ y ∈ 𝔔.map (algebraMap Q (Localization.Away Δ)),
      ε * y ∈ 𝔞.map ((algebraMap Q (Localization.Away Δ)).comp γ)) →
    ∃ e : Q, e ∉ 𝔔 ∧ RingHom.Etale ((algebraMap Q (Localization.Away e)).comp γ) ∧
      𝔔.map (algebraMap Q (Localization.Away e)) =
        (𝔞.map γ).map (algebraMap Q (Localization.Away e)) :=
by
  intro N Q _ _ γ 𝔞 𝔔 _ Δ hΔ h𝔞 het ε hε hεy
  obtain ⟨k, h, hk⟩ := IsLocalization.Away.surj Δ ε
  have huΔ : IsUnit (algebraMap Q (Localization.Away Δ) Δ ^ k) :=
    (IsLocalization.Away.algebraMap_isUnit Δ).pow k
  have hh : h ∉ 𝔔 := by
    intro hh
    apply hε
    have h1 : algebraMap Q (Localization.Away Δ) h ∈ 𝔔.map (algebraMap Q (Localization.Away Δ)) :=
      Ideal.mem_map_of_mem _ hh
    obtain ⟨u, hu⟩ := huΔ
    have h2 : ε = algebraMap Q (Localization.Away Δ) h * ↑u⁻¹ := by
      rw [← hk, ← hu, mul_assoc, Units.mul_inv, mul_one]
    rw [h2]
    exact Ideal.mul_mem_right _ _ h1
  have he : Δ * h ∉ 𝔔 := fun hm =>
    ((inferInstance : 𝔔.IsPrime).mem_or_mem hm).elim hΔ hh
  let L := Localization.Away (algebraMap Q (Localization.Away Δ) h)
  let Φ : L ≃ₐ[Q] Localization.Away (Δ * h) :=
    IsLocalization.algEquiv (Submonoid.powers (Δ * h)) L (Localization.Away (Δ * h))
  let G : Localization.Away Δ →+* Localization.Away (Δ * h) :=
    Φ.toRingEquiv.toRingHom.comp (algebraMap (Localization.Away Δ) L)
  have hG : ∀ q, G (algebraMap Q (Localization.Away Δ) q) =
      algebraMap Q (Localization.Away (Δ * h)) q := by
    intro q
    show Φ (algebraMap (Localization.Away Δ) L (algebraMap Q _ q)) = _
    rw [← IsScalarTower.algebraMap_apply Q (Localization.Away Δ) L q]
    exact Φ.commutes q
  have hGc : G.comp (algebraMap Q (Localization.Away Δ)) =
      algebraMap Q (Localization.Away (Δ * h)) := RingHom.ext hG
  refine ⟨Δ * h, he, ?_, ?_⟩
  · have h1 : RingHom.Etale (algebraMap (Localization.Away Δ) L) := by
      rw [RingHom.etale_algebraMap]
      exact Algebra.Etale.of_isLocalizationAway (algebraMap Q (Localization.Away Δ) h)
    have h2 := RingHom.Etale.stableUnderComposition _ _ het h1
    have h3 := RingHom.Etale.stableUnderComposition _ _ h2
      (RingHom.Etale.of_bijective (f := Φ.toRingEquiv.toRingHom) Φ.bijective)
    convert h3 using 1
    exact RingHom.ext fun x => (hG (γ x)).symm
  · apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro y hy
      rw [Ideal.mem_comap, Ideal.map_map]
      have h1 := hεy (algebraMap Q (Localization.Away Δ) y) (Ideal.mem_map_of_mem _ hy)
      have h2 := Ideal.mem_map_of_mem G h1
      rw [Ideal.map_map, ← RingHom.comp_assoc, hGc, map_mul, hG] at h2
      have hk' := congrArg G hk
      rw [map_mul, map_pow, hG, hG] at hk'
      have hue : IsUnit (algebraMap Q (Localization.Away (Δ * h)) (Δ * h)) :=
        IsLocalization.Away.algebraMap_isUnit (Δ * h)
      rw [map_mul] at hue
      have huh : IsUnit (algebraMap Q (Localization.Away (Δ * h)) h) :=
        isUnit_of_mul_isUnit_right hue
      rw [← hk'] at huh
      obtain ⟨w, hw⟩ := isUnit_of_mul_isUnit_left huh
      rw [← hw] at h2
      have h3 := Ideal.mul_mem_left _ (↑w⁻¹ : Localization.Away (Δ * h)) h2
      rwa [Units.inv_mul_cancel_left] at h3
    · exact Ideal.map_mono h𝔞

theorem wcLlsKP_bds_model_etale : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (T : Type u) [CommRing T] [Algebra ↥W T] (b ζ : ↥W) (p α β m₀ : ℕ),
    p.Prime → 1 ≤ m₀ → ζ ^ p = b →
    ∀ (π : wcEbntN W b →+* T),
    π.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = algebraMap ↥W T → RingHom.Etale (R := wcEbntN W b) (S := T) π →
    ∀ (x : ℕ → T) (U : T)
      (𝔓 : Ideal (wcLlsKPbdsE T (π (wcEbntX W b 0)) (π (wcEbntX W b 1)) (algebraMap ↥W T ζ)
        U x p α β m₀)) [𝔓.IsPrime],
      wcLlsKPbdsV T (π (wcEbntX W b 0)) (π (wcEbntX W b 1)) (algebraMap ↥W T ζ)
        U x p α β m₀ 0 ∈ 𝔓 →
      wcLlsKPbdsV T (π (wcEbntX W b 0)) (π (wcEbntX W b 1)) (algebraMap ↥W T ζ)
        U x p α β m₀ 1 ∈ 𝔓 →
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W (wcLlsKPbdsE T (π (wcEbntX W b 0))
        (π (wcEbntX W b 1)) (algebraMap ↥W T ζ) U x p α β m₀)) ≤ 𝔓 →
      wcLlsKPbdsNodeChart W (wcLlsKPbdsE T (π (wcEbntX W b 0)) (π (wcEbntX W b 1))
          (algebraMap ↥W T ζ) U x p α β m₀) ζ
        (wcLlsKPbdsV T (π (wcEbntX W b 0)) (π (wcEbntX W b 1)) (algebraMap ↥W T ζ)
          U x p α β m₀ 0)
        (wcLlsKPbdsV T (π (wcEbntX W b 0)) (π (wcEbntX W b 1)) (algebraMap ↥W T ζ)
          U x p α β m₀ 1) 𝔓 :=
by
  intro Ω _ W T _ _ b ζ p α β m₀ hp hm₀ hζb π hπC hπet x U 𝔓 _ h0 h1 hm
  classical
  letI iNb : CommRing (wcEbntN W b) := Ideal.Quotient.commRing _
  letI iNζ : CommRing (wcEbntN W ζ) := Ideal.Quotient.commRing _

  letI : Algebra (wcEbntN W b) T := π.toAlgebra
  haveI : Algebra.Etale (wcEbntN W b) T := hπet
  obtain ⟨n, R, ψ', hψs, hψk, hψu⟩ := wc_rescale_etale_presentation (wcEbntN W b) T
  have hψC : (ψ' : MvPolynomial (Fin n) (wcEbntN W b) →+* T).comp MvPolynomial.C = π := by
    refine RingHom.ext fun r => ?_
    have h := ψ'.commutes r
    rw [MvPolynomial.algebraMap_eq] at h
    exact h

  have hms : Function.Surjective (MvPolynomial.map (σ := Fin n)
      (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b})) :
        MvPolynomial (Fin n) (MvPolynomial (Fin 2) ↥W) → MvPolynomial (Fin n) (wcEbntN W b)) := by
    apply MvPolynomial.map_surjective
    exact Ideal.Quotient.mk_surjective
  choose Rt hRt using fun j => hms (R j)
  choose a ha using fun i => (hψs.comp hms) (x i)
  obtain ⟨c, hc⟩ := (hψs.comp hms) U

  obtain ⟨φ, hφs, hφk, hφW, hφ0, hφ1, hφ2, hφS⟩ := wcLlsKP_bdsm_presentation_iso W T b ζ p α β m₀
    hζb π hπC x U n R (ψ' : MvPolynomial (Fin n) (wcEbntN W b) →+* T) hψC hψs hψk Rt a c hRt
    (fun i => ha i) hc
  rw [← hφ0] at h0
  rw [← hφ1] at h1
  rw [← hφ0, ← hφ1]
  set F := wcLlsKPbdsEqs ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ζ})).comp MvPolynomial.C) (wcEbntX W ζ 0) (wcEbntX W ζ 1)
        n p α β m₀ Rt a c with hF
  have hker : ∀ l, φ (F l) = 0 := by
    intro l
    rw [← RingHom.mem_ker, hφk]
    exact Ideal.subset_span ⟨l, rfl⟩
  have hMN : φ (MvPolynomial.X (Sum.inr 0)) * φ (MvPolynomial.X (Sum.inr 1)) = 1 := by
    have h := hker (Sum.inr 0)
    simp only [hF, wcLlsKPbdsEqs, Sum.elim_inr, Matrix.cons_val_zero, map_sub, map_mul,
      map_one] at h
    exact sub_eq_zero.mp h
  have hMu : IsUnit (φ (MvPolynomial.X (Sum.inr 0))) :=
    ⟨⟨_, _, hMN, (mul_comm _ _).trans hMN⟩, rfl⟩
  obtain ⟨ψ₀, hψ₀⟩ : ∃ g : wcEbntN W ζ →+* wcLlsKPbdsE T (π (wcEbntX W b 0)) (π (wcEbntX W b 1))
      (algebraMap ↥W T ζ) U x p α β m₀, ∀ y, g y = φ (MvPolynomial.C y) :=
    ⟨φ.comp MvPolynomial.C, fun _ => rfl⟩
  have hψ₀γ : ψ₀.comp ((Ideal.Quotient.mk (Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ζ})).comp MvPolynomial.C) =
      algebraMap ↥W (wcLlsKPbdsE T (π (wcEbntX W b 0)) (π (wcEbntX W b 1)) (algebraMap ↥W T ζ)
        U x p α β m₀) :=
    RingHom.ext fun w => (hψ₀ _).trans (hφW w)

  have hζm : ζ ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hζ
    have hu : IsUnit ζ := IsLocalRing.notMem_maximalIdeal.mp hζ
    have hprod : φ (MvPolynomial.C (wcEbntX W ζ 0)) * φ (MvPolynomial.C (wcEbntX W ζ 1)) =
        algebraMap ↥W (wcLlsKPbdsE T (π (wcEbntX W b 0)) (π (wcEbntX W b 1))
          (algebraMap ↥W T ζ) U x p α β m₀) ζ := by
      rw [← hφW, ← map_mul, ← map_mul]
      congr 2
      show Ideal.Quotient.mk _ (MvPolynomial.X 0) * Ideal.Quotient.mk _ (MvPolynomial.X 1) = _
      rw [← map_mul]
      exact Ideal.Quotient.eq.mpr (Ideal.mem_span_singleton_self _)
    apply (inferInstance : 𝔓.IsPrime).ne_top
    apply Ideal.eq_top_of_isUnit_mem 𝔓 _ (hu.map (algebraMap ↥W _))
    rw [← hprod]
    exact Ideal.mul_mem_right _ _ h0
  have hspanP : Ideal.span {φ (MvPolynomial.C (wcEbntX W ζ 0)),
      φ (MvPolynomial.C (wcEbntX W ζ 1))} ≤ 𝔓 := by
    rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨h0, h1⟩

  have hs2 := wcLlsKP_bdsm_jacobian_congr ((Ideal.Quotient.mk (Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ζ})).comp MvPolynomial.C)
    (wcEbntX W ζ 0) (wcEbntX W ζ 1) n p α β m₀ Rt a c hp.one_lt.le hm₀
  rw [← hF] at hs2
  set D := (Matrix.of fun k l => MvPolynomial.pderiv k (F l)).det with hD
  have hmem := Ideal.mem_map_of_mem φ hs2
  rw [Ideal.map_span, Set.image_pair, map_add, map_mul, hφS] at hmem
  have hdetmap : MvPolynomial.map (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 *
      MvPolynomial.X 1 - MvPolynomial.C b} : Ideal (MvPolynomial (Fin 2) ↥W)))
      (Matrix.of fun j i => MvPolynomial.pderiv i (Rt j)).det =
      (Matrix.of fun j i => MvPolynomial.pderiv i (R j)).det := by
    have hmd := RingHom.map_det (MvPolynomial.map (σ := Fin n) (Ideal.Quotient.mk
      (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b} :
        Ideal (MvPolynomial (Fin 2) ↥W)))) (Matrix.of fun j i => MvPolynomial.pderiv i (Rt j))
    refine hmd.trans ?_
    rw [RingHom.mapMatrix_apply]
    congr 1
    refine Matrix.ext fun j i => ?_
    rw [Matrix.map_apply, Matrix.of_apply, Matrix.of_apply, ← MvPolynomial.pderiv_map, hRt]
  rw [hdetmap] at hmem
  have hu2 : IsUnit (φ (MvPolynomial.X (Sum.inr 0)) *
      algebraMap T _ ((ψ' : MvPolynomial (Fin n) (wcEbntN W b) →+* T)
        (Matrix.of fun j i => MvPolynomial.pderiv i (R j)).det)) :=
    hMu.mul (hψu.map _)
  have hΔ : φ D ∉ 𝔓 := by
    intro hDm
    have h3 := Ideal.sub_mem 𝔓 (hspanP hmem) hDm
    rw [add_sub_cancel_left] at h3
    exact (inferInstance : 𝔓.IsPrime).ne_top (Ideal.eq_top_of_isUnit_mem _ h3 hu2)

  set Θ := (Ideal.quotEquivOfEq hφk.symm).trans (RingHom.quotientKerEquivOfSurjective hφs)
    with hΘ
  have hΘmk : ∀ q, Θ (Ideal.Quotient.mk (Ideal.span (Set.range F)) q) = φ q := by
    intro q
    rw [hΘ, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
      RingHom.quotientKerEquivOfSurjective_apply_mk]
  have hs4 := wcLlsKP_bdsm_jacobian_away_etale (wcEbntN W ζ) F
  obtain ⟨Λ, hΛ⟩ : ∃ Λ : Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range F)) D) ≃+*
      Localization.Away (φ D), ∀ q, Λ (algebraMap _ _ q) =
        algebraMap _ (Localization.Away (φ D)) (Θ q) := by
    have H : Submonoid.map Θ.toMonoidHom
        (Submonoid.powers (Ideal.Quotient.mk (Ideal.span (Set.range F)) D)) =
        Submonoid.powers (φ D) := by
      rw [Submonoid.map_powers]
      exact congrArg Submonoid.powers (hΘmk D)
    exact ⟨IsLocalization.ringEquivOfRingEquiv _ _ Θ H,
      fun q => IsLocalization.ringEquivOfRingEquiv_eq H q⟩
  have hg := RingHom.Etale.stableUnderComposition _ _ hs4
      (RingHom.Etale.of_bijective (f := Λ.toRingHom) Λ.bijective)
  have hetΔ : RingHom.Etale ((algebraMap (wcLlsKPbdsE T (π (wcEbntX W b 0)) (π (wcEbntX W b 1))
      (algebraMap ↥W T ζ) U x p α β m₀) (Localization.Away (φ D))).comp ψ₀) := by
    convert hg using 1
    refine RingHom.ext fun y => ?_
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]
    have hy : algebraMap (wcEbntN W ζ)
        (MvPolynomial (Fin n ⊕ Fin 2) (wcEbntN W ζ) ⧸ Ideal.span (Set.range F)) y =
        Ideal.Quotient.mk (Ideal.span (Set.range F)) (MvPolynomial.C y) := rfl
    rw [hΛ, hy, hΘmk, hψ₀]

  set 𝔞 := Ideal.span {wcEbntX W ζ 0, wcEbntX W ζ 1} ⊔ (IsLocalRing.maximalIdeal ↥W).map
      ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C ζ})).comp MvPolynomial.C) with h𝔞
  haveI h𝔞max : 𝔞.IsMaximal := wcLlsKP_bdsm_origin_maximal W ζ hζm
  have h𝔞map : 𝔞.map ψ₀ =
      Ideal.span {φ (MvPolynomial.C (wcEbntX W ζ 0)), φ (MvPolynomial.C (wcEbntX W ζ 1))} ⊔
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W (wcLlsKPbdsE T (π (wcEbntX W b 0))
          (π (wcEbntX W b 1)) (algebraMap ↥W T ζ) U x p α β m₀)) := by
    rw [h𝔞, Ideal.map_sup, Ideal.map_span, Set.image_pair, Ideal.map_map, hψ₀γ, hψ₀, hψ₀]
  have h𝔞le : 𝔞.map ψ₀ ≤ 𝔓 := by
    rw [h𝔞map]
    exact sup_le hspanP hm

  haveI hQprime : (𝔓.map (algebraMap _ (Localization.Away (φ D)))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers (φ D)) _ 𝔓 inferInstance
      (Set.disjoint_left.mpr fun y hy hyP => by
        obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hy
        exact hΔ ((inferInstance : 𝔓.IsPrime).mem_of_pow_mem k hyP))
  obtain ⟨ε, hε, hεy⟩ := wcLlsKP_bdsm_etale_fibre_idem _ _ _ hetΔ 𝔞
    (𝔓.map (algebraMap _ (Localization.Away (φ D))))
    (by rw [← Ideal.map_map]; exact Ideal.map_mono h𝔞le)

  obtain ⟨e, he, het, hmap⟩ := wcLlsKP_bdsm_localize_twice _ _ ψ₀ 𝔞 𝔓
    (φ D) hΔ h𝔞le hetΔ ε hε hεy
  refine ⟨e, (algebraMap _ (Localization.Away e)).comp ψ₀, he, ?_, ?_,
    ?_, het, ?_⟩
  · rw [RingHom.comp_assoc, hψ₀γ]
  · rw [RingHom.comp_apply, hψ₀]
  · rw [RingHom.comp_apply, hψ₀]
  · rw [hmap, h𝔞map, Ideal.map_sup, Ideal.map_span, Set.image_pair]

theorem wcLlsKPas_minpoly_dvd : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] [FiniteDimensional K L] (P : Type u) [CommRing P] [IsDomain P] [Algebra P K] [Algebra P L] [IsScalarTower P K L], Function.Injective (algebraMap P K) → ∀ (ℓ : ℕ), ℓ.Prime → Module.finrank K L = ℓ → ∀ (w : L) (F : Polynomial P), w ∉ Set.range (algebraMap K L) → F.Monic → F.natDegree = ℓ → Polynomial.aeval w F = 0 → (Polynomial.map (algebraMap P K) F = minpoly K w) ∧ (∀ G : Polynomial P, Polynomial.aeval w G = 0 → F ∣ G) ∧ (∀ x : L, ∃ (Gx : Polynomial K), x = Polynomial.aeval w Gx) :=
by
  intro K L _ _ _ _ P _ _ _ _ _ hinj ℓ hℓ hrank w F hw hFmon hFdeg hFw
  have hint : IsIntegral K w := IsIntegral.of_finite K w
  have hdeg_min : (minpoly K w).natDegree = ℓ := by
    have h1 : (minpoly K w).natDegree ∣ ℓ := by
      rw [← hrank]; exact minpoly.degree_dvd hint
    rcases hℓ.eq_one_or_self_of_dvd _ h1 with h | h
    · exfalso
      apply hw
      obtain ⟨y, hy⟩ := (minpoly.natDegree_eq_one_iff.mp h)
      exact ⟨y, hy⟩
    · exact h
  have hFK0 : Polynomial.aeval w (F.map (algebraMap P K)) = 0 := by
    rw [Polynomial.aeval_map_algebraMap]; exact hFw
  have hFKmon : (F.map (algebraMap P K)).Monic := hFmon.map _
  have hFKdeg : (F.map (algebraMap P K)).natDegree = ℓ := by
    rw [Polynomial.natDegree_map_eq_of_injective hinj F, hFdeg]
  have hEq : F.map (algebraMap P K) = minpoly K w := by
    exact Polynomial.eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hint) hFKmon
      (minpoly.dvd K w hFK0) (le_of_eq (hFKdeg.trans hdeg_min.symm))
  refine ⟨hEq, ?_, ?_⟩
  · intro G hG
    have hG' : Polynomial.aeval w (G.map (algebraMap P K)) = 0 := by
      rw [Polynomial.aeval_map_algebraMap]; exact hG
    have hd := minpoly.dvd K w hG'
    rw [← hEq] at hd
    exact (Polynomial.map_dvd_map (algebraMap P K) hinj hFmon).mp hd
  · intro x
    have htop : IntermediateField.adjoin K {w} = ⊤ := by
      apply IntermediateField.eq_of_le_of_finrank_eq le_top
      rw [IntermediateField.adjoin.finrank hint, hdeg_min, IntermediateField.finrank_top', hrank]
    have hx : x ∈ (IntermediateField.adjoin K {w}).toSubalgebra := by
      rw [htop]; exact IntermediateField.mem_top
    rw [IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hint.isAlgebraic,
      Algebra.adjoin_singleton_eq_range_aeval] at hx
    obtain ⟨Gx, hGx⟩ := hx
    exact ⟨Gx, hGx.symm⟩

theorem wcLlsKPas_generation : ∀ (A : Type u) [CommRing A] [IsDomain A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] (R : Type u) [CommRing R] [Algebra R L] (P : Type u) [CommRing P] [Algebra P L] (aR : A →+* R) (w : L), (∀ a : A, algebraMap R L (aR a) = algebraMap K L (algebraMap A K a)) → (∀ r : R, ∃ x : P, algebraMap P L x = algebraMap R L r) → (∀ x : L, ∃ Gx : Polynomial K, x = Polynomial.aeval w Gx) → ∀ l : L, ∃ (y : R) (G : Polynomial P), algebraMap R L y ≠ 0 ∧ l * algebraMap R L y = Polynomial.aeval w G :=
by
  intro A _ _ K _ _ _ L _ _ R _ _ P _ _ aR w hA hRP hgen l
  obtain ⟨Gx, hl⟩ := hgen l
  obtain ⟨b, hbM, hH⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors A) Gx
  have hb0 : algebraMap K L (algebraMap A K b) ≠ 0 := by
    rw [map_ne_zero]
    exact IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hbM
  choose s hs using hRP
  refine ⟨aR b, ∑ i ∈ Finset.range
      ((IsLocalization.integerNormalization (nonZeroDivisors A) Gx).natDegree + 1),
      Polynomial.monomial i
        (s (aR ((IsLocalization.integerNormalization (nonZeroDivisors A) Gx).coeff i))), ?_, ?_⟩
  · rw [hA]; exact hb0
  · have h1 : Polynomial.aeval w (∑ i ∈ Finset.range
          ((IsLocalization.integerNormalization (nonZeroDivisors A) Gx).natDegree + 1),
          Polynomial.monomial i
            (s (aR ((IsLocalization.integerNormalization (nonZeroDivisors A) Gx).coeff i))))
        = ∑ i ∈ Finset.range
          ((IsLocalization.integerNormalization (nonZeroDivisors A) Gx).natDegree + 1),
          algebraMap K L (algebraMap A K
            ((IsLocalization.integerNormalization (nonZeroDivisors A) Gx).coeff i)) * w ^ i := by
      rw [map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Polynomial.aeval_monomial, hs, hA]
    have h2 : Polynomial.aeval w (Polynomial.map (algebraMap A K)
          (IsLocalization.integerNormalization (nonZeroDivisors A) Gx))
        = ∑ i ∈ Finset.range
          ((IsLocalization.integerNormalization (nonZeroDivisors A) Gx).natDegree + 1),
          algebraMap K L (algebraMap A K
            ((IsLocalization.integerNormalization (nonZeroDivisors A) Gx).coeff i)) * w ^ i := by
      rw [Polynomial.aeval_def, Polynomial.eval₂_map, Polynomial.eval₂_eq_sum_range]
      rfl
    have h3 : Polynomial.aeval w (b • Gx) = algebraMap K L (algebraMap A K b) * l := by
      rw [Algebra.smul_def, Polynomial.algebraMap_apply, map_mul, Polynomial.aeval_C, hl]
    rw [h1, ← h2, hH, h3, hA, mul_comm]

theorem wcLlsKPas_local_model_bijective : ∀ (R : Type u) [CommRing R] [IsDomain R] (L : Type u)
    [Field L] [Algebra R L] (𝔮 : Ideal ↥(integralClosure R L)) [𝔮.IsPrime]
    (D : Type u) [CommRing D] [IsDomain D] [IsIntegrallyClosed D] (j : D →+* L)
    (φ : D →+* Localization.AtPrime 𝔮), Function.Injective j → IsLocalHom φ →
    (∀ l : L, ∃ x y : D, j y ≠ 0 ∧ l * j y = j x) →
    (∀ r : R, ∃ x : D, j x = algebraMap R L r) →
    (∀ x : D, ∃ z s : ↥(integralClosure R L), s ∉ 𝔮 ∧
      φ x * algebraMap ↥(integralClosure R L) (Localization.AtPrime 𝔮) s =
        algebraMap ↥(integralClosure R L) (Localization.AtPrime 𝔮) z ∧
      j x * (s : L) = (z : L)) →
    Function.Bijective φ :=
by
  intro R _ _ L _ _ 𝔮 _ D _ _ _ j φ hj hφ h2 h3 h4
  classical
  haveI := hφ
  letI : Algebra D L := j.toAlgebra
  have hjD : algebraMap D L = j := rfl
  haveI : IsFractionRing D L := by
    refine ⟨?_, ?_, ?_⟩
    · intro y
      have hy : (y : D) ≠ 0 := nonZeroDivisors.ne_zero y.2
      have : j y ≠ 0 := fun h => hy (hj (h.trans (map_zero j).symm))
      exact this.isUnit
    · intro l
      obtain ⟨x, y, hy, hxy⟩ := h2 l
      have hy0 : y ≠ 0 := fun h => hy (by rw [h, map_zero])
      exact ⟨⟨x, ⟨y, mem_nonZeroDivisors_of_ne_zero hy0⟩⟩, hxy⟩
    · intro x y hxy
      exact ⟨1, by rw [hj hxy]⟩
  choose σf hσf using h3
  let σ : R →+* D :=
    { toFun := σf
      map_one' := hj (by rw [hσf, map_one, map_one])
      map_mul' := fun a b => hj (by rw [hσf, map_mul, map_mul, hσf, hσf])
      map_zero' := hj (by rw [hσf, map_zero, map_zero])
      map_add' := fun a b => hj (by rw [hσf, map_add, map_add, hσf, hσf]) }
  have hσ : j.comp σ = algebraMap R L := RingHom.ext hσf
  have s3 : ∀ b : integralClosure R L, ∃ x : D, j x = (b : L) := by
    intro b
    obtain ⟨p, hpm, hp⟩ := (mem_integralClosure_iff R L).mp b.2
    have hint : _root_.IsIntegral D (b : L) := by
      refine ⟨p.map σ, hpm.map σ, ?_⟩
      rw [Polynomial.eval₂_map, hjD, hσ]
      exact hp
    obtain ⟨x, hx⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    exact ⟨x, hx⟩
  have hunit : ∀ s : integralClosure R L, s ∉ 𝔮 →
      IsUnit (algebraMap (integralClosure R L) (Localization.AtPrime 𝔮) s) :=
    fun s hs => IsLocalization.map_units (Localization.AtPrime 𝔮) (⟨s, hs⟩ : 𝔮.primeCompl)
  have s4 : ∀ (x : D) (b : integralClosure R L), j x = (b : L) →
      φ x = algebraMap (integralClosure R L) (Localization.AtPrime 𝔮) b := by
    intro x b hx
    obtain ⟨z, s, hs, h1, h2⟩ := h4 x
    have hbz : b * s = z := Subtype.ext (by
      show (b : L) * (s : L) = (z : L)
      rw [← hx, h2])
    apply (hunit s hs).mul_right_cancel
    rw [h1, ← map_mul, hbz]
  have s5 : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨z, s, hs, h1, h2⟩ := h4 x
    rw [hx, zero_mul] at h1
    obtain ⟨m, hm⟩ :=
      (IsLocalization.map_eq_zero_iff 𝔮.primeCompl (Localization.AtPrime 𝔮) z).mp h1.symm
    have hm0 : (m : integralClosure R L) ≠ 0 := by
      intro h
      apply m.2
      rw [h]
      exact 𝔮.zero_mem
    have hz : z = 0 := (mul_eq_zero.mp hm).resolve_left hm0
    have hs0 : (s : L) ≠ 0 := by
      intro h
      apply hs
      have : s = 0 := Subtype.ext h
      rw [this]
      exact 𝔮.zero_mem
    have h2' : j x * (s : L) = 0 := by rw [h2, hz]; rfl
    have : j x = 0 := (mul_eq_zero.mp h2').resolve_right hs0
    exact hj (this.trans (map_zero j).symm)
  have s6 : Function.Surjective φ := by
    intro w
    obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔮.primeCompl w
    obtain ⟨xb, hxb⟩ := s3 b
    obtain ⟨xs, hxs⟩ := s3 (s : integralClosure R L)
    have e1 := s4 xb b hxb
    have e2 := s4 xs s hxs
    have hu : IsUnit (φ xs) := by rw [e2]; exact hunit s s.2
    obtain ⟨u, hu'⟩ := isUnit_of_map_unit φ xs hu
    refine ⟨xb * ↑u⁻¹, ?_⟩
    rw [IsLocalization.eq_mk'_iff_mul_eq, map_mul, ← e2, ← hu', mul_assoc, ← map_mul,
      Units.inv_mul, map_one, mul_one, e1]
  exact ⟨s5, s6⟩

theorem wcLlsKP_bds_model_iso : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (ℓ : ℕ), ℓ.Prime →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ (c b : ↥W) (d : A) (w₁ : L) (F₁ : Polynomial K) (m₀ : ℕ) (ω ζ : ↥W) (α β : ℕ)
      (x : ℕ → K),
      c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
      wcLlsKPBoundaryCore W A K L ℓ 𝔭 t c b d w₁ F₁ m₀ ω ζ →
      α * m₀ = 1 + β * ℓ → ζ ∈ IsLocalRing.maximalIdeal ↥W → ζ ≠ 0 →
      ∀ (𝔮 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)}) L)) [𝔮.IsPrime],
      𝔮.comap (algebraMap ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)})
          ↥(integralClosure ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
            algebraMap A K (t - algebraMap ↥W A c)}) L)) =
        Ideal.span {algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
            algebraMap A K (t - algebraMap ↥W A c)}) (t - algebraMap ↥W A c),
          ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c),
            Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
            algebraMap A K (t - algebraMap ↥W A c)})).comp (algebraMap ↥W A)) →
      ∀ (z z' μ ν : L), wcLlsKPbdsElems W A K L t c b ζ w₁ F₁ ℓ m₀ α β x 𝔮 z z' μ ν →
      ∀ (T : Type u) [CommRing T] [Algebra ↥W T] (j : T →+* K) (h : A)
        (π : wcEbntN W b →+* T),
      Function.Injective j → h ∉ 𝔭 →
      (∀ w : ↥W, j (algebraMap ↥W T w) = algebraMap A K (algebraMap ↥W A w)) →
      π.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = algebraMap ↥W T →
      j (π (wcEbntX W b 0)) = algebraMap A K (t - algebraMap ↥W A c) →
      j (π (wcEbntX W b 1)) =
        algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c) →
      RingHom.Etale (R := wcEbntN W b) (S := T) π →
      (∀ y : K, wcLlsKPLoc A K (wcLlsScV W A K t c b) d y → ∃ y' : T, j y' = y) →
      (∀ y' : T, ∃ n : ℕ, j y' * algebraMap A K (h * d) ^ n ∈
        Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)}) →
      ∀ (xT : ℕ → T) (UT : T), (∀ i, 1 ≤ i → i < ℓ → j (xT i) = x i) →
      j UT = -F₁.coeff 0 / algebraMap A K (t - algebraMap ↥W A c) ^ m₀ →
      (∀ (𝔓 : Ideal (wcLlsKPbdsE T (π (wcEbntX W b 0)) (π (wcEbntX W b 1))
          (algebraMap ↥W T ζ) UT xT ℓ α β m₀)) [𝔓.IsPrime],
        wcLlsKPbdsV T (π (wcEbntX W b 0)) (π (wcEbntX W b 1)) (algebraMap ↥W T ζ)
          UT xT ℓ α β m₀ 0 ∈ 𝔓 →
        wcLlsKPbdsV T (π (wcEbntX W b 0)) (π (wcEbntX W b 1)) (algebraMap ↥W T ζ)
          UT xT ℓ α β m₀ 1 ∈ 𝔓 →
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W (wcLlsKPbdsE T (π (wcEbntX W b 0))
          (π (wcEbntX W b 1)) (algebraMap ↥W T ζ) UT xT ℓ α β m₀)) ≤ 𝔓 →
        wcLlsKPbdsNodeChart W (wcLlsKPbdsE T (π (wcEbntX W b 0)) (π (wcEbntX W b 1))
            (algebraMap ↥W T ζ) UT xT ℓ α β m₀) ζ
          (wcLlsKPbdsV T (π (wcEbntX W b 0)) (π (wcEbntX W b 1)) (algebraMap ↥W T ζ)
            UT xT ℓ α β m₀ 0)
          (wcLlsKPbdsV T (π (wcEbntX W b 0)) (π (wcEbntX W b 1)) (algebraMap ↥W T ζ)
            UT xT ℓ α β m₀ 1) 𝔓) →
      ∃ 𝔓 : PrimeSpectrum (wcLlsKPbdsE T (π (wcEbntX W b 0)) (π (wcEbntX W b 1))
          (algebraMap ↥W T ζ) UT xT ℓ α β m₀),
