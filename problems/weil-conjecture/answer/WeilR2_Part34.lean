    intro w hw
    rw [Algebra.algebraMap_eq_smul_one] at hw
    rcases smul_eq_zero.mp hw with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hinjWK : Function.Injective ((algebraMap A K).comp (algebraMap W A)) :=
    (IsFractionRing.injective A K).comp hWA

  letI : Algebra (Localization.AtPrime 𝔭) K :=
    IsLocalization.localizationAlgebraOfSubmonoidLe _ K 𝔭.primeCompl (nonZeroDivisors A)
      (Ideal.primeCompl_le_nonZeroDivisors 𝔭)
  haveI : IsScalarTower A (Localization.AtPrime 𝔭) K :=
    IsLocalization.localization_isScalarTower_of_submonoid_le _ K 𝔭.primeCompl (nonZeroDivisors A)
      (Ideal.primeCompl_le_nonZeroDivisors 𝔭)
  haveI : IsFractionRing (Localization.AtPrime 𝔭) K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization 𝔭.primeCompl _ K
  letI : Algebra (Localization.AtPrime 𝔭) L :=
    ((algebraMap K L).comp (algebraMap (Localization.AtPrime 𝔭) K)).toAlgebra
  haveI : IsScalarTower (Localization.AtPrime 𝔭) K L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : IsScalarTower A (Localization.AtPrime 𝔭) L := IsScalarTower.of_algebraMap_eq (fun x => by
    show algebraMap A L x = algebraMap K L (algebraMap (Localization.AtPrime 𝔭) K
      (algebraMap A (Localization.AtPrime 𝔭) x))
    rw [← IsScalarTower.algebraMap_apply A (Localization.AtPrime 𝔭) K,
      ← IsScalarTower.algebraMap_apply A K L])
  have hζK : IsPrimitiveRoot (algebraMap (Localization.AtPrime 𝔭) K
      (algebraMap A (Localization.AtPrime 𝔭) (algebraMap W A ⟨μ, hμW⟩))) ℓ := by
    rw [← IsScalarTower.algebraMap_apply]
    exact hζ.map_of_injective hinjWK

  obtain ⟨htc0, hrad⟩ := wcpa_dj_llsm_kpde_radical Ω W A 𝔭 t c hPD
  have hgS : algebraMap A (Localization.AtPrime 𝔭) g =
      algebraMap A (Localization.AtPrime 𝔭) (t - algebraMap ↥W A c) *
        algebraMap A (Localization.AtPrime 𝔭) a := map_mul _ _ _
  have hspan : Ideal.span {algebraMap A (Localization.AtPrime 𝔭) g} =
      Ideal.span {algebraMap A (Localization.AtPrime 𝔭) (t - algebraMap ↥W A c)} := by
    rw [hgS]
    exact Ideal.span_singleton_mul_right_unit haS _
  have hg0 : algebraMap A (Localization.AtPrime 𝔭) g ≠ 0 := by
    rw [hgS]
    exact mul_ne_zero htc0 haS.ne_zero
  have hgrad : ∀ (x : Localization.AtPrime 𝔭) (N : ℕ),
      x ^ N ∈ Ideal.span {algebraMap A (Localization.AtPrime 𝔭) g} →
      x ∈ Ideal.span {algebraMap A (Localization.AtPrime 𝔭) g} := by
    rw [hspan]
    exact hrad

  have hθK : θ ∉ Set.range (algebraMap K L) := by
    rintro ⟨k, hk⟩
    have hkpow : k ^ ℓ = algebraMap A K g := by
      apply (algebraMap K L).injective
      rw [map_pow, hk, hθ, IsScalarTower.algebraMap_apply A K L]
    have hkint : IsIntegral A k := by
      apply IsIntegral.of_pow hℓ.pos
      rw [hkpow]
      exact isIntegral_algebraMap
    obtain ⟨a', ha'⟩ := IsIntegrallyClosed.isIntegral_iff.mp hkint
    have ha'pow : a' ^ ℓ = g := by
      apply IsFractionRing.injective A K
      rw [map_pow, ha', hkpow]
    have hpow : Ideal.Quotient.mk I (algebraMap A (Localization.AtPrime 𝔭) a') ^ ℓ =
        Ideal.Quotient.mk I (algebraMap A (Localization.AtPrime 𝔭) g) := by
      rw [← map_pow, ← map_pow, ha'pow]
    rw [← hpow] at hgirr
    exact not_irreducible_pow hℓ.one_lt.ne' hgirr

  have hθS : θ ^ ℓ = algebraMap (Localization.AtPrime 𝔭) L (algebraMap A (Localization.AtPrime 𝔭) g) := by
    rw [← IsScalarTower.algebraMap_apply]
    exact hθ
  obtain ⟨hlin, hrep⟩ := wcpa_dj_llsm_kpde_kummer_closure (Localization.AtPrime 𝔭) K L ℓ hℓ hfr
    hℓS _ hζK (algebraMap A (Localization.AtPrime 𝔭) g) θ hg0 hgrad hθK hθS

  have hinjAL : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)
  have hg𝔭 : g ∈ 𝔭 :=
    Ideal.mul_mem_right _ _ (𝔭.sub_mem ht𝔭 (hm𝔭 (Ideal.mem_map_of_mem _ hc)))
  have hrepA : ∀ x : L, IsIntegral A x → ∃ s : Fin ℓ → Localization.AtPrime 𝔭,
      x = ∑ i : Fin ℓ, algebraMap (Localization.AtPrime 𝔭) L (s i) * θ ^ (i : ℕ) :=
    fun x hx => hrep x hx.tower_top
  obtain ⟨e⟩ := wcpa_dj_llsm_kpde_local_model Ω W A L 𝔭 ℓ θ g hℓ.pos hinjAL hm𝔭 hg𝔭 hθ hlin
    hrepA y hyc

  obtain ⟨hTdom, hTdvr, -⟩ := wc_pas_dks_kummer_dvr _
    (Ideal.Quotient.mk I (algebraMap A (Localization.AtPrime 𝔭) g)) hgirr ℓ hℓ.pos
  haveI := hTdom
  haveI := hTdvr
  have hδT : wcpaDjLkDelta (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C
      (Ideal.Quotient.mk I (algebraMap A (Localization.AtPrime 𝔭) g)))) = 0 := by
    unfold wcpaDjLkDelta
    rw [Module.length_eq_zero_iff, Submodule.Quotient.subsingleton_iff, eq_top_iff]
    rintro x -
    obtain ⟨r, hr⟩ := IsIntegrallyClosed.isIntegral_iff.mp x.2
    exact LinearMap.mem_range.mpr ⟨r, Subtype.ext hr⟩
  rw [(wcpa_dj_lr1k_llfi_ringequiv _ _ e).1]
  exact hδT

theorem wcpa_dj_llsm_kp_tame_disc : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar (IsLocalRing.ResidueField ↥W) ≠ ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
      [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
      (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → y.IsPrime → y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
    wcLlsUniq A L 𝔭 y → wcLlsBR W A K L 𝔭 (.disc t) → Nat.card ↥(wcLlsDec A K L y) = ℓ →
    (∃ (θ : L) (f : A), θ ∉ Set.range (algebraMap K L) ∧ θ ^ ℓ = algebraMap A L f ∧ f ∉ 𝔭) ∨
      ∀ (_ : y.IsPrime),
        wcpaDjLkDelta (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) = 0 :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy hyc hUniq hBR hcard
  classical
  haveI h𝔭p : 𝔭.IsPrime := hPD.2.2.2.1.isPrime
  have hℓpos : 0 < ℓ := hℓ.pos

  obtain ⟨hfr, θ, f, hf0, hθK, hθf⟩ :=
    wcpa_dj_llsm_kpd_kummer_generator Ω W ℓ hℓ hκ A K L 𝔭 y hPD.2.1 hy hyc hUniq hcard

  obtain ⟨r, c, n, d, a, s, hcinj, hcm, hd0, ha𝔭, hs𝔭, hsf⟩ :=
    wcpa_dj_llsm_kpd_disc_factorization Ω W hW hWt A 𝔭 t hPD f hf0

  have hTT : ∀ q : Ideal A, (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ q) → ∀ i j,
      t - algebraMap ↥W A (c i) ∈ q → t - algebraMap ↥W A (c j) ∈ q → i = j := by
    intro q hq i j hi hj
    by_contra hne
    have hc : c j - c i ≠ 0 := sub_ne_zero.mpr (fun h => hne (hcinj h).symm)
    apply hq _ hc
    have h1 := q.sub_mem hi hj
    rw [map_sub]
    convert h1 using 1
    ring

  have hram : ∀ i, ¬ ℓ ∣ n i → ∃ Q, wcLlsGenPt W A L 𝔭 Q ∧
      t - algebraMap ↥W A (c i) ∈ Q.comap (algebraMap A ↥(integralClosure A L)) ∧
      wcLlsRam A K L Q := by
    intro i hi
    refine wcpa_dj_llsm_kpd_ramified_section Ω W hW hWt ℓ hℓ A K L 𝔭 t hPD hfr θ f s
      (algebraMap ↥W A d * a * ∏ j ∈ Finset.univ.erase i, (t - algebraMap ↥W A (c j)) ^ (n j))
      (c i) (n i) hθf (hcm i) hi ?_ ?_
    · rw [hsf, ← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ i)]
      ring
    · intro q hq hq𝔭 hqW hTi
      refine ⟨?_, fun h => hs𝔭 (hq𝔭 h)⟩
      intro hmem
      rcases hq.mem_or_mem hmem with h1 | h1
      · rcases hq.mem_or_mem h1 with h2 | h2
        · exact hqW d hd0 h2
        · exact ha𝔭 (hq𝔭 h2)
      · obtain ⟨j, hj, hjq⟩ := (hq.prod_mem_iff).mp h1
        have hj' := hq.mem_of_pow_mem _ hjq
        exact (Finset.mem_erase.mp hj).1 (hTT q hqW j i hj' hTi)

  have hBR' : ∀ c c' : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → c' ∈ IsLocalRing.maximalIdeal ↥W →
      (∃ Q, wcLlsGenPt W A L 𝔭 Q ∧
        t - algebraMap ↥W A c ∈ Q.comap (algebraMap A ↥(integralClosure A L)) ∧
        wcLlsRam A K L Q) →
      (∃ Q, wcLlsGenPt W A L 𝔭 Q ∧
        t - algebraMap ↥W A c' ∈ Q.comap (algebraMap A ↥(integralClosure A L)) ∧
        wcLlsRam A K L Q) → c = c' := hBR

  obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq ((d : Ω)) hℓpos
  have hdΩ : (d : Ω) ≠ 0 := fun h => hd0 (Subtype.ext h)
  have hz0 : z ≠ 0 := by
    rintro rfl
    exact hdΩ (by rw [← hz, zero_pow hℓpos.ne'])
  have hzW : z ∈ W := by
    rcases W.mem_or_inv_mem z with h | h
    · exact h
    · have e : z = z ^ ℓ * z⁻¹ ^ (ℓ - 1) := by
        obtain ⟨m, hm⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, by omega⟩
        rw [hm, Nat.add_sub_cancel, pow_succ, mul_comm (z ^ m) z, mul_assoc, ← mul_pow,
          mul_inv_cancel₀ hz0, one_pow, mul_one]
      rw [e, hz]
      exact mul_mem d.2 (pow_mem h _)
  obtain ⟨δ₀, hδ⟩ : ∃ δ₀ : ↥W, δ₀ ^ ℓ = d :=
    ⟨⟨z, hzW⟩, Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hz)⟩

  obtain ⟨H, hH⟩ : ∃ H : A,
      H = algebraMap ↥W A δ₀ * ∏ i, (t - algebraMap ↥W A (c i)) ^ (n i / ℓ) := ⟨_, rfl⟩
  obtain ⟨R, hR⟩ : ∃ R : A, R = ∏ i, (t - algebraMap ↥W A (c i)) ^ (n i % ℓ) := ⟨_, rfl⟩
  have hsplit : s * f = H ^ ℓ * a * R := by
    rw [hsf, hH, hR, ← hδ, map_pow]
    have e : ∏ i, (t - algebraMap ↥W A (c i)) ^ (n i) =
        (∏ i, (t - algebraMap ↥W A (c i)) ^ (n i / ℓ)) ^ ℓ *
          ∏ i, (t - algebraMap ↥W A (c i)) ^ (n i % ℓ) := by
      rw [← Finset.prod_pow, ← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [← pow_mul, ← pow_add, mul_comm (n i / ℓ) ℓ, Nat.div_add_mod]
    rw [e, mul_pow]
    ring
  have hinj : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)
  have hsA : s ≠ 0 := by
    intro h
    apply hs𝔭
    rw [h]
    exact 𝔭.zero_mem
  have hsf0 : s * f ≠ 0 := mul_ne_zero hsA hf0
  have hHA : H ≠ 0 := by
    intro h
    apply hsf0
    rw [hsplit, h, zero_pow hℓpos.ne']
    ring
  have hRA : R ≠ 0 := by
    intro h
    apply hsf0
    rw [hsplit, h]
    ring
  have hH0 : algebraMap A L H ≠ 0 := (map_ne_zero_iff _ hinj).mpr hHA
  have hs0 : algebraMap A L s ≠ 0 := (map_ne_zero_iff _ hinj).mpr hsA

  have hθ'pow : (algebraMap A L s * θ / algebraMap A L H) ^ ℓ =
      algebraMap A L (s ^ (ℓ - 1) * a * R) := by
    rw [div_pow, div_eq_iff (pow_ne_zero _ hH0), mul_pow, hθf]
    have e0 : s ^ ℓ * f = s ^ (ℓ - 1) * (s * f) := by
      conv_lhs => rw [← Nat.sub_add_cancel hℓ.one_le]
      ring
    rw [← map_pow, ← map_mul, e0, hsplit]
    simp only [map_mul, map_pow]
    ring
  have hθ'K : algebraMap A L s * θ / algebraMap A L H ∉ Set.range (algebraMap K L) := by
    rintro ⟨k, hk⟩
    apply hθK
    refine ⟨algebraMap A K H * k / algebraMap A K s, ?_⟩
    rw [map_div₀, map_mul, ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply, hk,
      div_eq_iff hs0, mul_div_assoc', div_eq_iff hH0]
    ring
  have hunit : ∀ m : ℕ, (s ^ (ℓ - 1) * a) ^ m ∉ 𝔭 := by
    intro m hm
    rcases h𝔭p.mem_or_mem (h𝔭p.mem_of_pow_mem _ hm) with h | h
    · exact hs𝔭 (h𝔭p.mem_of_pow_mem _ h)
    · exact ha𝔭 h
  by_cases hall : ∀ i, ℓ ∣ n i
  ·
    left
    have hz' : ∀ i, n i % ℓ = 0 := fun i => Nat.mod_eq_zero_of_dvd (hall i)
    have hR1 : R = 1 := by
      rw [hR]
      simp [hz']
    refine ⟨algebraMap A L s * θ / algebraMap A L H, s ^ (ℓ - 1) * a, hθ'K, ?_, ?_⟩
    · rw [hθ'pow, hR1, mul_one]
    · have := hunit 1
      rwa [pow_one] at this
  ·
    right
    push_neg at hall
    obtain ⟨i₀, hi₀⟩ := hall
    have huniq : ∀ j, ¬ ℓ ∣ n j → j = i₀ := fun j hj =>
      hcinj (hBR' (c j) (c i₀) (hcm j) (hcm i₀) (hram j hj) (hram i₀ hi₀))
    obtain ⟨e, he⟩ : ∃ e : ℕ, e = n i₀ % ℓ := ⟨_, rfl⟩
    have hRe : R = (t - algebraMap ↥W A (c i₀)) ^ e := by
      rw [hR, he]
      refine Finset.prod_eq_single i₀ (fun j _ hj => ?_) (fun h => absurd (Finset.mem_univ _) h)
      have h0 : n j % ℓ = 0 := Nat.mod_eq_zero_of_dvd (by
        by_contra h
        exact hj (huniq j h))
      rw [h0, pow_zero]
    haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
    haveI : Fact ℓ.Prime := ⟨hℓ⟩
    have he0 : ((e : ℕ) : ZMod ℓ) ≠ 0 := by
      rw [Ne, ZMod.natCast_eq_zero_iff, he]
      intro hdvd
      exact hi₀ ((Nat.dvd_mod_iff dvd_rfl).mp hdvd)
    have hepos : e ≠ 0 := fun h => he0 (by rw [h, Nat.cast_zero])
    obtain ⟨α, β, hαβ⟩ : ∃ α β : ℕ, α * e = ℓ * β + 1 := by
      refine ⟨((e : ZMod ℓ)⁻¹).val, ((e : ZMod ℓ)⁻¹).val * e / ℓ, ?_⟩
      have h1 : ((((e : ZMod ℓ)⁻¹).val * e : ℕ) : ZMod ℓ) = ((1 : ℕ) : ZMod ℓ) := by
        rw [Nat.cast_mul, ZMod.natCast_zmod_val, Nat.cast_one, inv_mul_cancel₀ he0]
      rw [ZMod.natCast_eq_natCast_iff'] at h1
      rw [Nat.mod_eq_of_lt hℓ.one_lt] at h1
      conv_lhs => rw [← Nat.div_add_mod (((e : ZMod ℓ)⁻¹).val * e) ℓ, h1]
    have hT0 : algebraMap A L (t - algebraMap ↥W A (c i₀)) ≠ 0 := by
      rw [map_ne_zero_iff _ hinj]
      intro h
      apply hRA
      rw [hRe, h, zero_pow hepos]
    have hθ₂ : ((algebraMap A L s * θ / algebraMap A L H) ^ α /
        algebraMap A L (t - algebraMap ↥W A (c i₀)) ^ β) ^ ℓ =
        algebraMap A L ((t - algebraMap ↥W A (c i₀)) * (s ^ (ℓ - 1) * a) ^ α) := by
      rw [div_pow, ← pow_mul, mul_comm α ℓ, pow_mul, hθ'pow, hRe,
        div_eq_iff (pow_ne_zero _ (pow_ne_zero _ hT0))]
      simp only [map_mul, map_pow]
      rw [mul_pow, ← pow_mul _ e α, mul_comm e α, hαβ]
      ring
    intro hy'
    exact wcpa_dj_llsm_kpd_eisenstein_local Ω W hW hWt ℓ hℓ hκ A K L 𝔭 t y hPD hfr
      _ ((s ^ (ℓ - 1) * a) ^ α) (c i₀) (hcm i₀) (hunit α) hθ₂ hy' hyc

theorem wcpa_dj_llsm_kpta_kummer_setup : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (ℓ : ℕ), ℓ.Prime → ringChar (IsLocalRing.ResidueField ↥W) ≠ ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
      [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (y : Ideal ↥(integralClosure A L)),
    NoZeroSMulDivisors ↥W A → y.IsPrime → y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
    wcLlsUniq A L 𝔭 y → Nat.card ↥(wcLlsDec A K L y) = ℓ →
    Module.finrank K L = ℓ ∧ ∃ (θ : L) (f : A), f ≠ 0 ∧ θ ∉ Set.range (algebraMap K L) ∧
      θ ^ ℓ = algebraMap A L f :=
by
  intro Ω _ _ W ℓ hℓ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 y htf hy hcomap hU hD
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩

  have hmapint : ∀ (τ : L ≃ₐ[K] L) (x : L), x ∈ integralClosure A L →
      τ x ∈ integralClosure A L := by
    intro τ x hx
    rw [mem_integralClosure_iff] at hx ⊢
    exact hx.map τ
  let f : (L ≃ₐ[K] L) → (integralClosure A L →+* integralClosure A L) := fun τ =>
    { toFun := fun x => ⟨τ x, hmapint τ x x.2⟩
      map_one' := Subtype.ext (map_one τ)
      map_mul' := fun a b => Subtype.ext (map_mul τ (a : L) (b : L))
      map_zero' := Subtype.ext (map_zero τ)
      map_add' := fun a b => Subtype.ext (map_add τ (a : L) (b : L)) }
  have hf : ∀ τ (x : integralClosure A L), ((f τ x : integralClosure A L) : L) = τ x :=
    fun _ _ => rfl
  have hfA : ∀ τ, (f τ).comp (algebraMap A (integralClosure A L)) =
      algebraMap A (integralClosure A L) := by
    intro τ
    refine RingHom.ext fun a => Subtype.ext ?_
    rw [RingHom.comp_apply, hf]
    have e : ((algebraMap A (integralClosure A L) a : integralClosure A L) : L) =
        algebraMap K L (algebraMap A K a) := by
      rw [← IsScalarTower.algebraMap_apply]; rfl
    rw [e]
    exact τ.commutes _
  have hstab : ∀ τ (x : integralClosure A L), x ∈ y → f τ x ∈ y := by
    intro τ x hx
    have h1 : y.comap (f τ) = y := by
      apply hU
      · exact Ideal.comap_isPrime _ _
      · rw [Ideal.comap_comap, hfA, hcomap]
    have h2 : x ∈ y.comap (f τ) := by rw [h1]; exact hx
    exact h2
  have hDec : wcLlsDec A K L y = ⊤ := by
    rw [eq_top_iff]
    intro σ _
    open Pointwise in
    (rw [wcLlsDec, MulAction.mem_stabilizer_iff]
     ext z
     rw [Set.mem_smul_set]
     constructor
     · rintro ⟨w, ⟨x, hx, rfl⟩, rfl⟩
       exact ⟨f σ x, hstab σ x hx, rfl⟩
     · rintro ⟨x, hx, rfl⟩
       refine ⟨_, ⟨f σ⁻¹ x, hstab σ⁻¹ x hx, rfl⟩, ?_⟩
       rw [AlgEquiv.smul_def, hf, ← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply])
  have hcardG : Nat.card (L ≃ₐ[K] L) = ℓ := by rw [← hD, hDec, Subgroup.card_top]
  have hfr : Module.finrank K L = ℓ := by rw [← IsGalois.card_aut_eq_finrank, hcardG]
  refine ⟨hfr, ?_⟩

  have hℓΩ : ((ℓ : ℕ) : Ω) ≠ 0 := by
    intro h0
    have hW : ((ℓ : ℕ) : W) = 0 := by
      apply Subtype.ext
      have e : ((ℓ : W) : Ω) = (ℓ : Ω) := map_natCast W.subtype ℓ
      exact e.trans (h0.trans rfl)
    have hκ0 : ((ℓ : ℕ) : IsLocalRing.ResidueField W) = 0 := by
      rw [← map_natCast (IsLocalRing.residue W), hW, map_zero]
    have hdvd := ringChar.dvd hκ0
    rcases hℓ.eq_one_or_self_of_dvd _ hdvd with h1 | h1
    · exact CharP.ringChar_ne_one h1
    · exact hκ h1
  haveI : NeZero ((ℓ : ℕ) : Ω) := ⟨hℓΩ⟩
  obtain ⟨m, hm⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, by have := hℓ.pos; omega⟩
  obtain ⟨μ, hμ⟩ := IsAlgClosed.exists_root (Polynomial.cyclotomic ℓ Ω)
    (Polynomial.degree_cyclotomic_pos ℓ Ω hℓ.pos).ne'
  have hμp : IsPrimitiveRoot μ ℓ := Polynomial.isRoot_cyclotomic_iff.mp hμ
  have hμW : μ ∈ W := by
    rcases W.mem_or_inv_mem μ with h | h
    · exact h
    · have hμ1 : μ ^ (m + 1) = 1 := hm ▸ hμp.pow_eq_one
      have e : (μ⁻¹) ^ m = μ := by
        rw [inv_pow]
        exact inv_eq_of_mul_eq_one_right (by rw [← pow_succ]; exact hμ1)
      rw [← e]
      exact W.pow_mem h m
  have hζ : IsPrimitiveRoot (⟨μ, hμW⟩ : W) ℓ :=
    IsPrimitiveRoot.of_map_of_injective (f := W.subtype) hμp Subtype.val_injective
  have hWA : Function.Injective (algebraMap W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    rw [Algebra.algebraMap_eq_smul_one] at hw
    rcases smul_eq_zero.mp hw with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hinj : Function.Injective ((algebraMap A K).comp (algebraMap W A)) :=
    (IsFractionRing.injective A K).comp hWA
  have hζK := hζ.map_of_injective hinj
  have hprim : (primitiveRoots (Module.finrank K L) K).Nonempty := by
    rw [hfr]; exact ⟨_, (mem_primitiveRoots hℓ.pos).mpr hζK⟩

  haveI : IsCyclic (L ≃ₐ[K] L) := isCyclic_of_prime_card hcardG
  have htfae := (isCyclic_tfae K L hprim).out 1 3
  have hGC : IsGalois K L ∧ IsCyclic (L ≃ₐ[K] L) := ⟨inferInstance, inferInstance⟩
  obtain ⟨α, ⟨c, hc⟩, hαtop⟩ := htfae.mp hGC
  rw [hfr] at hc
  have hαK : α ∉ Set.range (algebraMap K L) := by
    intro hα
    have h1 : α ∈ (⊥ : IntermediateField K L) := IntermediateField.mem_bot.mpr hα
    rw [← IntermediateField.adjoin_simple_eq_bot_iff] at h1
    rw [h1] at hαtop
    have := IntermediateField.bot_eq_top_iff_finrank_eq_one.mp hαtop
    rw [hfr] at this
    exact hℓ.one_lt.ne' this
  obtain ⟨a, s, hsnz, hcs⟩ := IsFractionRing.div_surjective (A := A) c
  have hs0 : algebraMap A K s ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hsnz
  have hsL : algebraMap A L s ≠ 0 := by
    rw [IsScalarTower.algebraMap_apply A K L]; exact (map_ne_zero _).mpr hs0
  have hpow : (algebraMap A L s * α) ^ ℓ = algebraMap A L (a * s ^ m) := by
    rw [mul_pow, ← hc, ← hcs, map_div₀, ← IsScalarTower.algebraMap_apply,
      ← IsScalarTower.algebraMap_apply, hm, map_mul, map_pow]
    field_simp
    ring
  refine ⟨algebraMap A L s * α, a * s ^ m, ?_, ?_, hpow⟩
  · intro hf0
    rw [hf0, map_zero] at hpow
    have h1 := (pow_eq_zero_iff hℓ.ne_zero).mp hpow
    rcases mul_eq_zero.mp h1 with h2 | h2
    · exact hsL h2
    · exact hαK ⟨0, by rw [map_zero, h2]⟩
  · rintro ⟨k, hk⟩
    apply hαK
    refine ⟨k / algebraMap A K s, ?_⟩
    rw [map_div₀, hk, ← IsScalarTower.algebraMap_apply]
    exact mul_div_cancel_left₀ α hsL

theorem wcpa_dj_llsm_kpta_kummer_ram : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar (IsLocalRing.ResidueField ↥W) ≠ ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
      [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (k : wcLlsKind W A),
    wcLlsPD W A 𝔭 k → Module.finrank K L = ℓ →
    ∀ (θ : L) (f : A), f ≠ 0 → θ ∉ Set.range (algebraMap K L) → θ ^ ℓ = algebraMap A L f →
    ∀ P : Ideal A, P.IsPrime → P ≠ ⊥ → P ≤ 𝔭 →
      (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) →
      (¬ ∃ (F : K) (a s : A), a ∉ P ∧ s ∉ P ∧
        algebraMap A K f * algebraMap A K s = F ^ ℓ * algebraMap A K a) →
      ∃ Q : Ideal ↥(integralClosure A L), wcLlsGenPt W A L 𝔭 Q ∧ wcLlsRam A K L Q :=
by
  intro Ω _ _ W _hW _hWt ℓ hℓ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 k hPD hfr θ f hf0 hθ hθf P hP
    _hP0 hP𝔭 hPW hnot
  obtain ⟨-, hNZ, hIC, -⟩ := hPD
  haveI := hIC
  haveI := hNZ
  haveI := hP
  have hsc : ∀ x : A, algebraMap A L x = algebraMap K L (algebraMap A K x) :=
    fun x => IsScalarTower.algebraMap_apply A K L x
  have hinjK := IsFractionRing.injective A K
  have hinjL : Function.Injective (algebraMap A L) := by
    intro x y hxy
    rw [hsc, hsc] at hxy
    exact hinjK ((algebraMap K L).injective hxy)
  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    by_contra h
    rw [Algebra.algebraMap_eq_smul_one] at hw
    rcases smul_eq_zero.mp hw with h' | h'
    · exact h h'
    · exact one_ne_zero h'

  have hu : IsUnit ((ℓ : ℕ) : ↥W) := by
    by_contra h
    have hm : ((ℓ:ℕ) : W) ∈ IsLocalRing.maximalIdeal W := (IsLocalRing.mem_maximalIdeal _).mpr h
    have h0 : IsLocalRing.residue W (ℓ : W) = 0 := (IsLocalRing.residue_eq_zero_iff _).mpr hm
    rw [map_natCast] at h0
    have hd := ringChar.dvd h0
    rcases (Nat.dvd_prime hℓ).mp hd with h1 | h1
    · exact CharP.ringChar_ne_one h1
    · exact hκ h1
  obtain ⟨ζW, hζW⟩ : ∃ ζ : ↥W, IsPrimitiveRoot ζ ℓ := by
    have hΩ : ((ℓ : ℕ) : Ω) ≠ 0 := by
      intro h
      have : ((ℓ:ℕ) : W) = 0 := by
        apply Subtype.val_injective
        simpa using h
      exact hu.ne_zero this
    haveI : NeZero ((ℓ:ℕ) : Ω) := ⟨hΩ⟩
    obtain ⟨z, hz⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot Ω ℓ
    have hzW : z ∈ W := by
      rcases W.mem_or_inv_mem z with h | h
      · exact h
      · have : z = (z⁻¹) ^ (ℓ - 1) := by
          rw [inv_pow]
          refine eq_inv_of_mul_eq_one_left ?_
          rw [← pow_succ', Nat.sub_add_cancel hℓ.one_lt.le]
          exact hz.pow_eq_one
        rw [this]; exact W.pow_mem h _
    exact ⟨⟨z, hzW⟩, IsPrimitiveRoot.of_map_of_injective (f := W.subtype) hz Subtype.val_injective⟩
  have hζK : IsPrimitiveRoot (algebraMap A K (algebraMap ↥W A ζW)) ℓ :=
    (hζW.map_of_injective hWA).map_of_injective hinjK

  obtain ⟨σ, hσ1, hσℓ, hgen, η, hη, hσθ⟩ : ∃ σ : L ≃ₐ[K] L, σ ≠ 1 ∧ σ ^ ℓ = 1 ∧
      (∀ τ : L ≃ₐ[K] L, ∃ n : ℕ, σ ^ n = τ) ∧
      ∃ η : K, IsPrimitiveRoot η ℓ ∧ σ θ = algebraMap K L η * θ := by
    have hθc : θ ^ ℓ = algebraMap K L (algebraMap A K f) := by rw [hθf, hsc]
    have hcard : Nat.card (L ≃ₐ[K] L) = ℓ := by
      rw [← hfr]; exact IsGalois.card_aut_eq_finrank K L
    obtain ⟨σ, hσθ⟩ : ∃ σ : L ≃ₐ[K] L, σ θ ≠ θ := by
      by_contra h
      push_neg at h
      exact hθ ((IsGalois.mem_range_algebraMap_iff_fixed θ).mpr h)
    have hσ1 : σ ≠ 1 := by rintro rfl; exact hσθ rfl
    have hσℓ : σ ^ ℓ = 1 := by rw [← hcard]; exact pow_card_eq_one'
    have hgen : ∀ τ : L ≃ₐ[K] L, ∃ n : ℕ, σ ^ n = τ := by
      haveI : Fact ℓ.Prime := ⟨hℓ⟩
      have htop := powers_eq_top_of_prime_card hcard hσ1
      intro τ
      have hτ : τ ∈ Submonoid.powers σ := by rw [htop]; trivial
      exact (Submonoid.mem_powers_iff τ σ).mp hτ
    have hθ0 : θ ≠ 0 := by rintro rfl; exact hθ ⟨0, map_zero _⟩
    have hc0 : algebraMap K L (algebraMap A K f) ≠ 0 := by rw [← hθc]; exact pow_ne_zero _ hθ0
    obtain ⟨ξ, hξ⟩ : ∃ ξ, ξ = σ θ / θ := ⟨_, rfl⟩
    have hξℓ : ξ ^ ℓ = 1 := by
      rw [hξ, div_pow, ← map_pow, hθc, AlgEquiv.commutes, div_self hc0]
    have hζL : IsPrimitiveRoot (algebraMap K L (algebraMap A K (algebraMap ↥W A ζW))) ℓ :=
      hζK.map_of_injective (algebraMap K L).injective
    haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
    obtain ⟨i, hi, hiξ⟩ := hζL.eq_pow_of_pow_eq_one hξℓ
    have hi0 : i ≠ 0 := by
      rintro rfl
      rw [pow_zero, hξ, eq_comm, div_eq_one_iff_eq hθ0] at hiξ
      exact hσθ hiξ
    have hcop : i.Coprime ℓ := (Nat.coprime_of_lt_prime hi0 hi hℓ).symm
    refine ⟨σ, hσ1, hσℓ, hgen, (algebraMap A K (algebraMap ↥W A ζW)) ^ i,
      hζK.pow_of_coprime i hcop, ?_⟩
    rw [map_pow, hiξ, hξ, div_mul_cancel₀ _ hθ0]
  obtain ⟨ηL, hηLdef⟩ : ∃ z : L, z = algebraMap K L η := ⟨_, rfl⟩
  have hη0 : η ≠ 0 := hη.ne_zero hℓ.ne_zero
  have hηL0 : ηL ≠ 0 := by
    rw [hηLdef]; exact (map_ne_zero_iff _ (algebraMap K L).injective).mpr hη0
  have hηLprim : IsPrimitiveRoot ηL ℓ := by
    rw [hηLdef]; exact hη.map_of_injective (algebraMap K L).injective
  have hσηL : σ ηL = ηL := by rw [hηLdef]; exact σ.commutes η
  rw [← hηLdef] at hσθ

  have hweight : ∀ j : ℕ, 0 < j → j < ℓ → ∀ y : L, IsIntegral A y → σ y = ηL ^ j * y →
      ∃ a ∈ P, algebraMap A L a = y ^ ℓ := by
    intro j hj0 hjℓ y hy hσy
    have hfK : algebraMap A K f ≠ 0 := (map_ne_zero_iff _ hinjK).mpr hf0
    have hθ0 : θ ≠ 0 := by
      rintro rfl
      rw [zero_pow hℓ.ne_zero, hsc, eq_comm] at hθf
      exact hfK ((map_eq_zero_iff _ (algebraMap K L).injective).mp hθf)
    obtain ⟨d, hd⟩ : ∃ d, d = y / θ ^ j := ⟨_, rfl⟩
    have hσd : σ d = d := by
      rw [hd, map_div₀, map_pow, hσθ, hσy, mul_pow]
      field_simp
    have hfix : ∀ τ : L ≃ₐ[K] L, τ d = d := by
      intro τ
      obtain ⟨n, rfl⟩ := hgen τ
      induction n with
      | zero => simp
      | succ n ih => rw [pow_succ, AlgEquiv.mul_apply, hσd, ih]
    obtain ⟨d₀, hd₀⟩ := (IsGalois.mem_range_algebraMap_iff_fixed d).mpr hfix
    have hy_eq : y = algebraMap K L d₀ * θ ^ j := by
      rw [hd₀, hd, div_mul_cancel₀ _ (pow_ne_zero _ hθ0)]
    obtain ⟨c, hc⟩ : ∃ c : K, c = d₀ ^ ℓ * algebraMap A K f ^ j := ⟨_, rfl⟩
    have hcy : algebraMap K L c = y ^ ℓ := by
      rw [hc, map_mul, map_pow, map_pow, ← hsc, ← hθf, hy_eq]; ring
    have hcint : IsIntegral A c := by
      have h1 : IsIntegral A (algebraMap K L c) := by rw [hcy]; exact hy.pow ℓ
      exact (isIntegral_algHom_iff (IsScalarTower.toAlgHom A K L)
        (algebraMap K L).injective).mp h1
    obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp hcint
    refine ⟨a, ?_, by rw [hsc, ha, hcy]⟩
    by_contra haP
    have hd00 : d₀ ≠ 0 := by
      rintro rfl
      apply haP
      have : algebraMap A K a = 0 := by rw [ha, hc, zero_pow hℓ.ne_zero, zero_mul]
      rw [(map_eq_zero_iff _ hinjK).mp this]; exact P.zero_mem
    have hcop : j.Coprime ℓ := (Nat.coprime_of_lt_prime hj0.ne' hjℓ hℓ).symm
    obtain ⟨α, -, hα⟩ := Nat.exists_mul_mod_eq_one_of_coprime hcop hℓ.one_lt
    obtain ⟨β, hβ⟩ : ∃ β, β = j * α / ℓ := ⟨_, rfl⟩
    have hjα : j * α = ℓ * β + 1 := by
      have := Nat.div_add_mod (j * α) ℓ; rw [hα, ← hβ] at this; omega
    have hY : (d₀ ^ ℓ * algebraMap A K f ^ j) ^ α =
        (d₀ ^ α * algebraMap A K f ^ β) ^ ℓ * algebraMap A K f := by
      rw [mul_pow, mul_pow, ← pow_mul, ← pow_mul, ← pow_mul, ← pow_mul, hjα, mul_comm ℓ α,
        mul_comm β ℓ, pow_succ]
      ring
    have hX : d₀ ^ α * algebraMap A K f ^ β ≠ 0 :=
      mul_ne_zero (pow_ne_zero _ hd00) (pow_ne_zero _ hfK)
    apply hnot
    refine ⟨(d₀ ^ α * algebraMap A K f ^ β)⁻¹, a ^ α, 1, fun h => haP (hP.mem_of_pow_mem _ h),
      fun h => hP.ne_top ((Ideal.eq_top_iff_one P).mpr h), ?_⟩
    rw [map_one, mul_one, map_pow, ha, hc, hY, inv_pow, ← mul_assoc,
      inv_mul_cancel₀ (pow_ne_zero _ hX), one_mul]

  have heigen : ∀ x : L,
      (∀ j : ℕ, σ (∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x) =
        ηL ^ j * ∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x) ∧
      ∑ j ∈ Finset.range ℓ, (ηL ^ j - 1) * ∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x =
        (ℓ : L) * (σ x - x) := by
    intro x
    have hσw : σ ηL⁻¹ = ηL⁻¹ := by rw [map_inv₀, hσηL]
    have hσwp : ∀ n : ℕ, σ (ηL⁻¹ ^ n) = ηL⁻¹ ^ n := fun n => by rw [map_pow, hσw]
    have hwℓ : ηL⁻¹ ^ ℓ = 1 := by rw [inv_pow, hηLprim.pow_eq_one, inv_one]
    have hpowσ : ∀ m : ℕ, σ ((σ ^ m) x) = (σ ^ (m + 1)) x := fun m => by
      rw [pow_succ', AlgEquiv.mul_apply]
    have heig : ∀ j : ℕ, σ (∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x) =
        ηL ^ j * ∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x := by
      intro j
      have hηj : ηL ^ j * ηL⁻¹ ^ j = 1 := by rw [← mul_pow, mul_inv_cancel₀ hηL0, one_pow]
      let h : ℕ → L := fun m => ηL ^ j * (ηL⁻¹ ^ (j * m) * (σ ^ m) x)
      have hL : σ (∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x) =
          ∑ m ∈ Finset.range ℓ, h (m + 1) := by
        rw [map_sum]
        refine Finset.sum_congr rfl (fun m _ => ?_)
        rw [map_mul, hσwp, hpowσ]
        show ηL⁻¹ ^ (j * m) * (σ ^ (m + 1)) x =
          ηL ^ j * (ηL⁻¹ ^ (j * (m + 1)) * (σ ^ (m + 1)) x)
        generalize (σ ^ (m + 1)) x = z
        have e : ηL⁻¹ ^ (j * (m + 1)) = ηL⁻¹ ^ (j * m) * ηL⁻¹ ^ j := by
          rw [mul_add, mul_one, pow_add]
        rw [e]
        linear_combination (-(ηL⁻¹ ^ (j * m) * z)) * hηj
      have hR : ηL ^ j * ∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x =
          ∑ m ∈ Finset.range ℓ, h m := by
        rw [Finset.mul_sum]
      have hℓ0 : h ℓ = h 0 := by
        show ηL ^ j * (ηL⁻¹ ^ (j * ℓ) * (σ ^ ℓ) x) = ηL ^ j * (ηL⁻¹ ^ (j * 0) * (σ ^ 0) x)
        rw [hσℓ, mul_comm j ℓ, pow_mul, hwℓ, one_pow, mul_zero, pow_zero, pow_zero]
      have e1 := Finset.sum_range_succ' h ℓ
      have e2 := Finset.sum_range_succ h ℓ
      rw [hL, hR]
      have e3 := e1.symm.trans e2
      rw [hℓ0] at e3
      exact add_right_cancel e3
    have hsumY : ∑ j ∈ Finset.range ℓ, ∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x =
        (ℓ : L) * x := by
      rw [Finset.sum_comm, Finset.sum_eq_single 0]
      · simp
      · intro m hm hm0
        rw [← Finset.sum_mul]
        have hwm : ηL⁻¹ ^ m ≠ 1 := by
          intro h
          have hdvd := (hηLprim.inv.pow_eq_one_iff_dvd m).mp h
          exact hm0 (Nat.eq_zero_of_dvd_of_lt hdvd (Finset.mem_range.mp hm))
        have hgeom : ∑ j ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) = 0 := by
          have e : ∀ j, ηL⁻¹ ^ (j * m) = (ηL⁻¹ ^ m) ^ j := fun j => by rw [← pow_mul, mul_comm]
          simp_rw [e]
          have hg := geom_sum_mul (ηL⁻¹ ^ m) ℓ
          have hpm : (ηL⁻¹ ^ m) ^ ℓ = 1 := by rw [← pow_mul, mul_comm, pow_mul, hwℓ, one_pow]
          rw [hpm, sub_self] at hg
          exact (mul_eq_zero.mp hg).resolve_right (sub_ne_zero.mpr hwm)
        rw [hgeom, zero_mul]
      · intro h; exact absurd (Finset.mem_range.mpr hℓ.pos) h
    refine ⟨heig, ?_⟩
    have hdiff : ∑ j ∈ Finset.range ℓ, (ηL ^ j - 1) *
        ∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x =
        σ (∑ j ∈ Finset.range ℓ, ∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x) -
        ∑ j ∈ Finset.range ℓ, ∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) x := by
      rw [map_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [heig j]; ring
    rw [hdiff, hsumY, map_mul, map_natCast]; ring

  have hker : RingHom.ker (algebraMap A ↥(integralClosure A L)) ≤ P := by
    intro a ha
    rw [RingHom.mem_ker] at ha
    have h2 : algebraMap A L a = 0 := congrArg Subtype.val ha
    rw [hinjL (h2.trans (map_zero _).symm)]
    exact P.zero_mem
  obtain ⟨Q, hQ, hQP0⟩ := Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain P hker
  have hQP : Q.comap (algebraMap A ↥(integralClosure A L)) = P := by
    first | exact hQP0 | (rw [← Ideal.under_def]; exact hQP0)
  refine ⟨Q, ⟨hQ, by rw [hQP]; exact hP𝔭, fun w hw => by rw [hQP]; exact hPW w hw⟩,
    σ, hσ1, fun x => ?_⟩
  have hrootint : ∀ z : L, z ^ ℓ = 1 → IsIntegral A z := by
    intro z hz
    refine ⟨Polynomial.X ^ ℓ - Polynomial.C 1, Polynomial.monic_X_pow_sub_C 1 hℓ.ne_zero, ?_⟩
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, map_one, hz, sub_self]
  have hwint : IsIntegral A ηL⁻¹ :=
    hrootint _ (by rw [inv_pow, hηLprim.pow_eq_one, inv_one])
  have hηint : IsIntegral A ηL := hrootint _ hηLprim.pow_eq_one
  have hxint : IsIntegral A (x : L) := x.2
  have hYint : ∀ j : ℕ,
      IsIntegral A (∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) (x : L)) := fun j =>
    IsIntegral.sum _ (fun m _ => (hwint.pow _).mul (hxint.map (σ ^ m)))
  obtain ⟨heig, hid⟩ := heigen (x : L)
  obtain ⟨yh, hyh⟩ : ∃ yh : ℕ → ↥(integralClosure A L), ∀ j, (yh j : L) =
      ∑ m ∈ Finset.range ℓ, ηL⁻¹ ^ (j * m) * (σ ^ m) (x : L) :=
    ⟨fun j => ⟨_, hYint j⟩, fun j => rfl⟩
  obtain ⟨eh, heh⟩ : ∃ eh : ℕ → ↥(integralClosure A L), ∀ j, (eh j : L) = ηL ^ j - 1 :=
    ⟨fun j => ⟨_, (hηint.pow j).sub isIntegral_one⟩, fun j => rfl⟩
  have hYQ : ∀ j, 0 < j → j < ℓ → yh j ∈ Q := by
    intro j hj0 hjℓ
    obtain ⟨a, haP, ha⟩ := hweight j hj0 hjℓ _ (hYint j) (heig j)
    apply hQ.mem_of_pow_mem ℓ
    have hpow : yh j ^ ℓ = algebraMap A ↥(integralClosure A L) a := by
      apply Subtype.ext
      rw [SubmonoidClass.coe_pow, hyh j]
      exact ha.symm
    rw [hpow]
    have hmem : a ∈ Q.comap (algebraMap A ↥(integralClosure A L)) := by rw [hQP]; exact haP
    exact hmem
  have hul : algebraMap A L (algebraMap ↥W A (↑hu.unit⁻¹ : ↥W)) * (ℓ : L) = 1 := by
    have h1 : (ℓ : L) = algebraMap A L (algebraMap ↥W A ((ℓ : ℕ) : ↥W)) := by
      rw [map_natCast, map_natCast]
    rw [h1, ← map_mul, ← map_mul, hu.val_inv_mul, map_one, map_one]
  refine ⟨algebraMap A ↥(integralClosure A L) (algebraMap ↥W A (↑hu.unit⁻¹ : ↥W)) *
      ∑ j ∈ Finset.range ℓ, eh j * yh j, ?_, ?_⟩
  · apply Ideal.mul_mem_left
    apply Ideal.sum_mem
    intro j hj
    by_cases hj0 : j = 0
    · have he0 : eh j = 0 := by
        apply Subtype.ext
        rw [heh j, hj0, pow_zero, sub_self]
        rfl
      rw [he0, zero_mul]
      exact Q.zero_mem
    · exact Ideal.mul_mem_left Q _ (hYQ j (Nat.pos_of_ne_zero hj0) (Finset.mem_range.mp hj))
  · rw [MulMemClass.coe_mul, AddSubmonoidClass.coe_finsetSum]
    simp only [MulMemClass.coe_mul, heh, hyh]
    change algebraMap A L (algebraMap ↥W A (↑hu.unit⁻¹ : ↥W)) * _ = _
    rw [hid, ← mul_assoc, hul, one_mul]

theorem wcpa_dj_llsm_kptf_tube_center : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ P : Ideal A, P.IsPrime → P ≠ ⊥ → P ≤ 𝔭 → (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) →
    ∃ c d : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W ∧ d ∈ IsLocalRing.maximalIdeal ↥W ∧ c * d = g ∧
      u - algebraMap ↥W A c ∈ P ∧ v - algebraMap ↥W A d ∈ P :=
by
  classical
  intro Ω _ _ W _hW _hWt A _ _ _ K _ _ _ 𝔭 u v g hPD P hP hP0 hP𝔭 hPW
  obtain ⟨-, hnz, -, h𝔭max, -, -, hg0, huv, h𝔭eq, h, hh, χ, hχC, hχ0, -, hχet⟩ := hPD
  haveI := hnz
  have h𝔭top := h𝔭max.ne_top
  have hu𝔭 : u ∈ 𝔭 := by
    rw [h𝔭eq]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert u {v}))
  have hv𝔭 : v ∈ 𝔭 := by
    rw [h𝔭eq]
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem u (Set.mem_singleton v)))
  set J : Ideal (MvPolynomial (Fin 2) ↥W) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} with hJ
  haveI hNdom : IsDomain (MvPolynomial (Fin 2) ↥W ⧸ J) := (wcNd_nodal_poly_normal Ω W g hg0).1

  have hh0 : h ≠ 0 := fun e => hh (e ▸ 𝔭.zero_mem)
  have hhP : h ∉ P := fun e => hh (hP𝔭 e)
  have hle : Submonoid.powers h ≤ nonZeroDivisors A :=
    powers_le_nonZeroDivisors_of_noZeroDivisors hh0
  have hLinj : Function.Injective (algebraMap A (Localization.Away h)) :=
    IsLocalization.injective (Localization.Away h) hle
  haveI : IsDomain (Localization.Away h) :=
    IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.Away h) hle

  have hu0 : u ≠ 0 := by
    rintro rfl
    rw [zero_mul] at huv
    have h1 : g • (1 : A) = 0 := by rw [← Algebra.algebraMap_eq_smul_one]; exact huv.symm
    rcases smul_eq_zero.mp h1 with h2 | h2
    · exact hg0 h2
    · exact one_ne_zero h2

  have hrel : Ideal.Quotient.mk J (MvPolynomial.X 0) * Ideal.Quotient.mk J (MvPolynomial.X 1) =
      Ideal.Quotient.mk J (MvPolynomial.C g) := by
    rw [← map_mul, Ideal.Quotient.eq]
    exact Ideal.subset_span (Set.mem_singleton _)
  have hnf : ∀ F : MvPolynomial (Fin 2) ↥W, ∃ (M : ℕ) (q : Polynomial ↥W),
      Ideal.Quotient.mk J (MvPolynomial.X 0) ^ M * Ideal.Quotient.mk J F =
        Polynomial.eval₂RingHom ((Ideal.Quotient.mk J).comp MvPolynomial.C)
          (Ideal.Quotient.mk J (MvPolynomial.X 0)) q := by
    intro F
    induction F using MvPolynomial.induction_on with
    | C a =>
      refine ⟨0, Polynomial.C a, ?_⟩
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, pow_zero, one_mul, RingHom.comp_apply]
    | add p p' hp hp' =>
      obtain ⟨M1, q1, h1⟩ := hp
      obtain ⟨M2, q2, h2⟩ := hp'
      refine ⟨M1 + M2, Polynomial.X ^ M2 * q1 + Polynomial.X ^ M1 * q2, ?_⟩
      simp only [map_add, map_mul, map_pow]
      rw [← h1, ← h2, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      ring
    | mul_X p n hp =>
      obtain ⟨M, q, hq⟩ := hp
      obtain rfl | rfl : n = 0 ∨ n = 1 := by fin_cases n <;> simp
      · refine ⟨M, q * Polynomial.X, ?_⟩
        simp only [map_mul]
        rw [← hq, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
        ring
      · refine ⟨M + 1, Polynomial.C g * q, ?_⟩
        simp only [map_mul]
        rw [← hq, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, RingHom.comp_apply, ← hrel]
        ring

  obtain ⟨y0, hy0P, hy00⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hP0
  letI : Algebra (MvPolynomial (Fin 2) ↥W ⧸ J) (Localization.Away h) := χ.toAlgebra
  haveI : Algebra.Etale (MvPolynomial (Fin 2) ↥W ⧸ J) (Localization.Away h) := hχet
  set y := algebraMap A (Localization.Away h) y0 with hy
  have hy0' : y ≠ 0 := fun e => hy00 (hLinj (e.trans (map_zero _).symm))
  obtain ⟨c, hc0, hcev⟩ := wcNd_hne_etale_algebraic (MvPolynomial (Fin 2) ↥W ⧸ J) (Localization.Away h) y
  have hcev' : Polynomial.eval₂ χ y c = 0 := by
    rw [Polynomial.aeval_def] at hcev; exact hcev
  obtain ⟨c', hcc', hndvd⟩ := Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd c hc0 0
  rw [map_zero, sub_zero] at hcc' hndvd
  have hc'0 : c'.coeff 0 ≠ 0 := fun e => hndvd (Polynomial.X_dvd_iff.mpr e)
  have hc'ev : Polynomial.eval₂ χ y c' = 0 := by
    rw [hcc', Polynomial.eval₂_mul, Polynomial.eval₂_X_pow] at hcev'
    exact (mul_eq_zero.mp hcev').resolve_left (pow_ne_zero _ hy0')
  have hχc0 : χ (c'.coeff 0) = -(Polynomial.eval₂ χ y c'.divX * y) := by
    have e := congrArg (Polynomial.eval₂ χ y) (Polynomial.divX_mul_X_add c')
    rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X, Polynomial.eval₂_C,
      hc'ev] at e
    linear_combination e
  obtain ⟨F0, hF0⟩ := Ideal.Quotient.mk_surjective (c'.coeff 0)
  obtain ⟨M, q, hq⟩ := hnf F0
  rw [hF0, Polynomial.coe_eval₂RingHom] at hq
  have hq0 : q ≠ 0 := by
    rintro rfl
    rw [Polynomial.eval₂_zero] at hq
    rcases mul_eq_zero.mp hq with h1 | h1
    · have hx := eq_zero_of_pow_eq_zero h1
      apply hu0
      apply hLinj
      rw [map_zero, ← hχ0, hx, map_zero]
    · exact hc'0 h1
  have hχq := congrArg χ hq
  rw [map_mul, map_pow, hχ0, hχc0, Polynomial.hom_eval₂, hχ0, hχC] at hχq
  have hhom : Polynomial.eval₂ ((algebraMap A (Localization.Away h)).comp (algebraMap ↥W A))
      (algebraMap A (Localization.Away h) u) q =
      algebraMap A (Localization.Away h) (Polynomial.eval₂ (algebraMap ↥W A) u q) :=
    (Polynomial.hom_eval₂ _ _ _ _).symm
  rw [hhom] at hχq
  obtain ⟨⟨a, s⟩, hzs⟩ := IsLocalization.surj (Submonoid.powers h)
    (Polynomial.eval₂ χ y c'.divX)
  simp only at hzs
  have key : algebraMap A (Localization.Away h) ((s : A) * Polynomial.eval₂ (algebraMap ↥W A) u q) =
      algebraMap A (Localization.Away h) (-(u ^ M * a * y0)) := by
    simp only [map_mul, map_neg, map_pow]
    rw [← hy]
    linear_combination (-(algebraMap A (Localization.Away h) (s : A))) * hχq -
      (algebraMap A (Localization.Away h) u ^ M * y) * hzs
  have hsP : (s : A) ∉ P := by
    obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp s.2
    rw [← hn]
    exact fun e => hhP (hP.mem_of_pow_mem n e)
  have hmem : (s : A) * Polynomial.eval₂ (algebraMap ↥W A) u q ∈ P := by
    rw [hLinj key]
    exact neg_mem (P.mul_mem_left _ hy0P)
  have hquP := (hP.mem_or_mem hmem).resolve_left hsP

  have hroot : ∃ c : ↥W, u - algebraMap ↥W A c ∈ P := by
    haveI : P.IsPrime := hP
    let β : A ⧸ P →+* FractionRing (A ⧸ P) := algebraMap _ _
    have hβ : Function.Injective β := IsFractionRing.injective _ _
    let κ : ↥W →+* FractionRing (A ⧸ P) := β.comp ((Ideal.Quotient.mk P).comp (algebraMap ↥W A))
    have hκ : Function.Injective κ := by
      rw [injective_iff_map_eq_zero]
      intro w hw
      by_contra hw0
      apply hPW w hw0
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      apply hβ
      rw [map_zero]; exact hw
    let j : Ω →+* FractionRing (A ⧸ P) := IsFractionRing.lift hκ
    have hj : ∀ w : ↥W, j (w : Ω) = κ w := fun w => by
      rw [← ValuationSubring.algebraMap_apply]; exact IsFractionRing.lift_algebraMap hκ w
    have hjc : j.comp (algebraMap ↥W Ω) = κ := by
      ext w; rw [RingHom.comp_apply, ValuationSubring.algebraMap_apply]; exact hj w
    have hevκ : Polynomial.eval₂ κ (β (Ideal.Quotient.mk P u)) q = 0 := by
      have h1 : β (Ideal.Quotient.mk P (Polynomial.eval₂ (algebraMap ↥W A) u q)) = 0 := by
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hquP, map_zero]
      rw [Polynomial.hom_eval₂, Polynomial.hom_eval₂] at h1
      exact h1
    have hqΩ0 : q.map (algebraMap ↥W Ω) ≠ 0 :=
      (Polynomial.map_ne_zero_iff (IsFractionRing.injective ↥W Ω)).mpr hq0
    have hevj : Polynomial.eval₂ j (β (Ideal.Quotient.mk P u)) (q.map (algebraMap ↥W Ω)) = 0 := by
      rw [Polynomial.eval₂_map, hjc]; exact hevκ
    have hsplit := Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C
      (IsAlgClosed.card_roots_eq_natDegree (p := q.map (algebraMap ↥W Ω)))
    rw [← hsplit, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_multiset_prod,
      Multiset.map_map] at hevj
    have hlc : j (q.map (algebraMap ↥W Ω)).leadingCoeff ≠ 0 :=
      (map_ne_zero j).mpr (Polynomial.leadingCoeff_ne_zero.mpr hqΩ0)
    have hprod := (mul_eq_zero.mp hevj).resolve_left hlc
    rw [Multiset.prod_eq_zero_iff, Multiset.mem_map] at hprod
    obtain ⟨r, -, hr0⟩ := hprod
    simp only [Function.comp_apply, Polynomial.eval₂_sub, Polynomial.eval₂_X,
      Polynomial.eval₂_C] at hr0
    have hxr : β (Ideal.Quotient.mk P u) = j r := sub_eq_zero.mp hr0
    by_cases hrW : r ∈ W
    · refine ⟨⟨r, hrW⟩, ?_⟩
      rw [← Ideal.Quotient.eq]
      apply hβ
      rw [hxr]
      exact hj ⟨r, hrW⟩
    · have hrinv : r⁻¹ ∈ W := (W.mem_or_inv_mem r).resolve_left hrW
      have hr0' : r ≠ 0 := fun e => hrW (e ▸ W.zero_mem)
      exfalso
      apply h𝔭top
      have h1 : u * algebraMap ↥W A ⟨r⁻¹, hrinv⟩ - 1 ∈ P := by
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        apply hβ
        have hjr : β (Ideal.Quotient.mk P (algebraMap ↥W A ⟨r⁻¹, hrinv⟩)) = j r⁻¹ :=
          (hj ⟨r⁻¹, hrinv⟩).symm
        simp only [map_zero, map_sub, map_one, map_mul]
        rw [hjr, hxr, ← map_mul, mul_inv_cancel₀ hr0', map_one, sub_self]
      rw [Ideal.eq_top_iff_one]
      have h2 := 𝔭.sub_mem (𝔭.mul_mem_right (algebraMap ↥W A ⟨r⁻¹, hrinv⟩) hu𝔭) (hP𝔭 h1)
      rwa [sub_sub_cancel] at h2

  obtain ⟨c, hc⟩ := hroot
  have hιc𝔭 : algebraMap ↥W A c ∈ 𝔭 := by
    have h1 := 𝔭.sub_mem hu𝔭 (hP𝔭 hc); rwa [sub_sub_cancel] at h1
  have hm_of : ∀ w : ↥W, algebraMap ↥W A w ∈ 𝔭 → w ∈ IsLocalRing.maximalIdeal ↥W := by
    intro w hw
    by_contra hwm
    exact h𝔭top (Ideal.eq_top_of_isUnit_mem _ hw ((IsLocalRing.notMem_maximalIdeal.mp hwm).map _))
  have hcm := hm_of c hιc𝔭
  have hc0 : c ≠ 0 := by
    rintro rfl
    rw [map_zero, sub_zero] at hc
    exact hPW g hg0 (by rw [← huv]; exact P.mul_mem_right v hc)
  have hE0 : algebraMap ↥W A c * v - algebraMap ↥W A g ∈ P := by
    have e : algebraMap ↥W A c * v - algebraMap ↥W A g =
        -((u - algebraMap ↥W A c) * v) + (u * v - algebraMap ↥W A g) := by ring
    rw [e, huv, sub_self, add_zero]
    exact neg_mem (P.mul_mem_right v hc)
  rcases ValuationRing.dvd_total c g with ⟨d, hd⟩ | ⟨t, ht⟩
  · have hv : v - algebraMap ↥W A d ∈ P := by
      have e : algebraMap ↥W A c * v - algebraMap ↥W A g =
          algebraMap ↥W A c * (v - algebraMap ↥W A d) := by
        rw [hd, map_mul]; ring
      rw [e] at hE0
      exact (hP.mem_or_mem hE0).resolve_left (hPW c hc0)
    have hd𝔭 : algebraMap ↥W A d ∈ 𝔭 := by
      have h1 := 𝔭.sub_mem hv𝔭 (hP𝔭 hv); rwa [sub_sub_cancel] at h1
    exact ⟨c, d, hcm, hm_of d hd𝔭, hd.symm, hc, hv⟩
  · exfalso
    have e : algebraMap ↥W A c * v - algebraMap ↥W A g =
        algebraMap ↥W A g * (algebraMap ↥W A t * v - 1) := by
      rw [ht, map_mul]; ring
    rw [e] at hE0
    have h1 := (hP.mem_or_mem hE0).resolve_left (hPW g hg0)
    apply h𝔭top
    rw [Ideal.eq_top_iff_one]
    have h2 := 𝔭.sub_mem (𝔭.mul_mem_left (algebraMap ↥W A t) hv𝔭) (hP𝔭 h1)
    rwa [sub_sub_cancel] at h2

theorem wcpa_dj_llsm_kptf_tube_dvr : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ P : Ideal A, P.IsPrime → P ≠ ⊥ → P ≤ 𝔭 → (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) →
    ∀ c d : ↥W, c * d = g → u - algebraMap ↥W A c ∈ P → v - algebraMap ↥W A d ∈ P →
    ∀ x : K, x ≠ 0 → ∃ (n : ℤ) (a s : A), a ∉ P ∧ s ∉ P ∧
      x * algebraMap A K s = algebraMap A K (u - algebraMap ↥W A c) ^ n * algebraMap A K a :=
by
  intro Ω _ _ W _ _ A _ _ _ K _ _ _ 𝔭 u v g hPD P hP _ hP𝔭 hPW c d hcd hcu hdv x hx

  have T6 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (t : R),
      IsLocalRing.maximalIdeal R = Ideal.span {t} → ∀ y : R, y ≠ 0 →
      ∃ (n : ℕ) (ε : R), IsUnit ε ∧ y = ε * t ^ n := by
    intro R _ _ _ t ht y hy
    classical
    have hK := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal R)
      (Ideal.IsMaximal.ne_top inferInstance)
    have hex : ∃ k, y ∉ Ideal.span {t ^ k} := by
      by_contra h
      push_neg at h
      apply hy
      have : y ∈ ⨅ i, (IsLocalRing.maximalIdeal R) ^ i := by
        rw [Submodule.mem_iInf]
        intro i
        rw [ht, Ideal.span_singleton_pow]
        exact h i
      rw [hK] at this
      exact (Submodule.mem_bot R).mp this
    have hk : y ∉ Ideal.span {t ^ Nat.find hex} := Nat.find_spec hex
    have hk0 : Nat.find hex ≠ 0 := by
      intro h0
      apply hk
      rw [h0, pow_zero, Ideal.span_singleton_one]
      exact Submodule.mem_top
    obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero hk0
    have hyn : y ∈ Ideal.span {t ^ n} := by
      have := Nat.find_min hex (show n < Nat.find hex by omega)
      simpa using this
    obtain ⟨ε, hε⟩ := Ideal.mem_span_singleton'.mp hyn
    refine ⟨n, ε, ?_, hε.symm⟩
    by_contra hεu
    have hεm : ε ∈ IsLocalRing.maximalIdeal R := (IsLocalRing.mem_maximalIdeal _).mpr hεu
    rw [ht] at hεm
    obtain ⟨e, he⟩ := Ideal.mem_span_singleton'.mp hεm
    apply hk
    rw [hn]
    refine Ideal.mem_span_singleton'.mpr ⟨e, ?_⟩
    rw [← hε, ← he, pow_succ]
    ring

  have T7 : ∀ (P : Ideal A) [hP : P.IsPrime] (Rp : Type u) [CommRing Rp] [Algebra A Rp]
      [IsLocalization.AtPrime Rp P] (t : A),
      (∀ y : Rp, y ≠ 0 → ∃ (n : ℕ) (ε : Rp), IsUnit ε ∧ y = ε * algebraMap A Rp t ^ n) →
      ∀ x : K, x ≠ 0 → ∃ (n : ℤ) (a s : A), a ∉ P ∧ s ∉ P ∧
        x * algebraMap A K s = algebraMap A K t ^ n * algebraMap A K a := by
    intro P hP Rp _ _ _ t H x hx
    have hinj : Function.Injective (algebraMap A Rp) :=
      IsLocalization.injective Rp (Ideal.primeCompl_le_nonZeroDivisors P)
    have fac : ∀ p0 : A, p0 ≠ 0 → ∃ (n : ℕ) (a s : A), a ∉ P ∧ s ∉ P ∧ p0 * s = a * t ^ n := by
      intro p0 hp0
      obtain ⟨n, ε, hε, he⟩ := H (algebraMap A Rp p0) ((map_ne_zero_iff _ hinj).mpr hp0)
      obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl ε
      have ha : a ∈ P.primeCompl := (IsLocalization.AtPrime.isUnit_mk'_iff Rp P a s).mp hε
      refine ⟨n, a, s, ha, s.2, hinj ?_⟩
      rw [map_mul, map_mul, he, map_pow, mul_right_comm, IsLocalization.mk'_spec]
    obtain ⟨p0, q0, hq0, hxq⟩ := IsFractionRing.div_surjective A x
    have hq0' : q0 ≠ 0 := nonZeroDivisors.ne_zero hq0
    have hiK : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
    have hp0 : p0 ≠ 0 := by
      rintro rfl
      apply hx
      rw [← hxq, map_zero, zero_div]
    obtain ⟨n1, a1, s1, ha1, hs1, e1⟩ := fac p0 hp0
    obtain ⟨n2, a2, s2, ha2, hs2, e2⟩ := fac q0 hq0'
    refine ⟨(n1 : ℤ) - n2, a1 * s2, s1 * a2, ?_, ?_, ?_⟩
    · exact fun h => (hP.mem_or_mem h).elim ha1 hs2
    · exact fun h => (hP.mem_or_mem h).elim hs1 ha2
    · have e1K : algebraMap A K p0 * algebraMap A K s1 =
          algebraMap A K a1 * algebraMap A K t ^ n1 := by
        rw [← map_mul, e1, map_mul, map_pow]
      have e2K : algebraMap A K q0 * algebraMap A K s2 =
          algebraMap A K a2 * algebraMap A K t ^ n2 := by
        rw [← map_mul, e2, map_mul, map_pow]
      have hqK : algebraMap A K q0 ≠ 0 := (map_ne_zero_iff _ hiK).mpr hq0'
      have hs20 : s2 ≠ 0 := fun h => hs2 (h ▸ P.zero_mem)
      have hs2K : algebraMap A K s2 ≠ 0 := (map_ne_zero_iff _ hiK).mpr hs20
      have hxq' : x * algebraMap A K q0 = algebraMap A K p0 := by
        rw [← hxq, div_mul_cancel₀ _ hqK]
      generalize algebraMap A K t = T at e1K e2K ⊢
      have hTn2 : T ^ n2 ≠ 0 := by
        intro h
        rw [h, mul_zero] at e2K
        exact mul_ne_zero hqK hs2K e2K
      have hz : T ^ ((n1 : ℤ) - n2) * T ^ n2 = T ^ n1 := by
        by_cases hT : T = 0
        · have h2 : n2 = 0 := by
            by_contra hn
            exact hTn2 (by rw [hT]; exact zero_pow hn)
          subst h2
          simp
        · rw [zpow_sub₀ hT, zpow_natCast, zpow_natCast, div_mul_cancel₀ _ (pow_ne_zero _ hT)]
      generalize T ^ ((n1 : ℤ) - n2) = Z at hz ⊢
      apply mul_right_cancel₀ (mul_ne_zero hqK hTn2)
      rw [map_mul, map_mul]
      linear_combination (algebraMap A K s1 * algebraMap A K a2 * T ^ n2) * hxq' -
        (Z * algebraMap A K a1 * T ^ n2) * e2K + (algebraMap A K a2 * T ^ n2) * e1K -
        (algebraMap A K a1 * algebraMap A K a2 * T ^ n2) * hz

  have T5 : Algebra.FiniteType ↥W A → ∀ (P : Ideal A) [P.IsPrime],
      (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) →
      ∀ (Rp : Type u) [CommRing Rp] [Algebra A Rp] [IsLocalization.AtPrime Rp P],
      IsNoetherianRing Rp := by
    intro hFT P _ hPW Rp _ _ _
    set M : Submonoid ↥W := nonZeroDivisors ↥W
    set S' := Localization (Submonoid.map (algebraMap ↥W A) M)
    have hft : (algebraMap ↥W A).FiniteType := RingHom.finiteType_algebraMap.mpr hFT
    have hft' := RingHom.finiteType_localizationPreserves (algebraMap ↥W A) M
      (FractionRing ↥W) S' hft
    letI := (IsLocalization.map S' (algebraMap ↥W A) (Submonoid.le_comap_map M) :
      FractionRing ↥W →+* S').toAlgebra
    haveI : Algebra.FiniteType (FractionRing ↥W) S' := hft'
    have hS' : IsNoetherianRing S' := Algebra.FiniteType.isNoetherianRing (FractionRing ↥W) S'
    have hle : Submonoid.map (algebraMap ↥W A) M ≤ P.primeCompl := by
      rintro _ ⟨w, hw, rfl⟩
      exact hPW w (nonZeroDivisors.ne_zero hw)
    letI : Algebra S' Rp := IsLocalization.localizationAlgebraOfSubmonoidLe S' Rp _ _ hle
    haveI : IsScalarTower A S' Rp :=
      IsLocalization.localization_isScalarTower_of_submonoid_le S' Rp _ _ hle
    haveI := IsLocalization.isLocalization_of_submonoid_le S' Rp _ _ hle
    exact IsLocalization.isNoetherianRing (Submonoid.map (algebraMap A S') P.primeCompl) Rp hS'

  have T1 : ∀ (N B : Type u) [CommRing N] [CommRing B]
      (mk : MvPolynomial (Fin 2) ↥W →+* N), Function.Surjective mk → ∀ (χ : N →+* B)
      (j : A →+* B) (Q : Ideal B),
      (∀ z : A, j z ∈ Q → z ∈ P) → (∀ z ∈ P, j z ∈ Q) →
      (∀ w : ↥W, χ (mk (MvPolynomial.C w)) = j (algebraMap ↥W A w)) →
      χ (mk (MvPolynomial.X 0)) = j u → χ (mk (MvPolynomial.X 1)) = j v →
      Q.comap χ = Ideal.span {mk (MvPolynomial.X 0) - mk (MvPolynomial.C c),
        mk (MvPolynomial.X 1) - mk (MvPolynomial.C d)} ∧
      ∀ w : ↥W, w ≠ 0 → mk (MvPolynomial.C w) ∉ Q.comap χ := by
    intro N B _ _ mk hmk χ j Q hpull hpush hχC hχ0 hχ1
    have hconst : ∀ w : ↥W, w ≠ 0 → mk (MvPolynomial.C w) ∉ Q.comap χ := by
      intro w hw hmem
      rw [Ideal.mem_comap, hχC] at hmem
      exact hPW w hw (hpull _ hmem)
    refine ⟨?_, hconst⟩
    have hIp : Ideal.span {mk (MvPolynomial.X 0) - mk (MvPolynomial.C c),
        mk (MvPolynomial.X 1) - mk (MvPolynomial.C d)} ≤ Q.comap χ := by
      rw [Ideal.span_le]
      intro z hz
      rcases hz with rfl | hz
      · show χ (mk (MvPolynomial.X 0) - mk (MvPolynomial.C c)) ∈ Q
        rw [map_sub, hχ0, hχC, ← map_sub]
        exact hpush _ hcu
      · rw [Set.mem_singleton_iff] at hz
        subst hz
        show χ (mk (MvPolynomial.X 1) - mk (MvPolynomial.C d)) ∈ Q
        rw [map_sub, hχ1, hχC, ← map_sub]
        exact hpush _ hdv
    set I := Ideal.span {mk (MvPolynomial.X 0) - mk (MvPolynomial.C c),
        mk (MvPolynomial.X 1) - mk (MvPolynomial.C d)} with hIdef
    have hX : ∀ n : Fin 2, ∃ e : ↥W, mk (MvPolynomial.X n) - mk (MvPolynomial.C e) ∈ I := by
      intro n
      fin_cases n
      · exact ⟨c, Ideal.subset_span (Set.mem_insert _ _)⟩
      · exact ⟨d, Ideal.subset_span (Set.mem_insert_of_mem _ rfl)⟩
    have hdec : ∀ F : MvPolynomial (Fin 2) ↥W, ∃ w : ↥W, mk F - mk (MvPolynomial.C w) ∈ I := by
      intro F
      induction F using MvPolynomial.induction_on with
      | C a => exact ⟨a, by rw [sub_self]; exact I.zero_mem⟩
      | add p₁ p₂ h₁ h₂ =>
        obtain ⟨w₁, hw₁⟩ := h₁
        obtain ⟨w₂, hw₂⟩ := h₂
        refine ⟨w₁ + w₂, ?_⟩
        have : mk (p₁ + p₂) - mk (MvPolynomial.C (w₁ + w₂)) =
            (mk p₁ - mk (MvPolynomial.C w₁)) + (mk p₂ - mk (MvPolynomial.C w₂)) := by
          rw [map_add, map_add, map_add]; ring
        rw [this]
        exact I.add_mem hw₁ hw₂
      | mul_X p₁ n h₁ =>
        obtain ⟨w₁, hw₁⟩ := h₁
        obtain ⟨e, he⟩ := hX n
        refine ⟨w₁ * e, ?_⟩
        have : mk (p₁ * MvPolynomial.X n) - mk (MvPolynomial.C (w₁ * e)) =
            (mk p₁ - mk (MvPolynomial.C w₁)) * mk (MvPolynomial.X n) +
              mk (MvPolynomial.C w₁) * (mk (MvPolynomial.X n) - mk (MvPolynomial.C e)) := by
          rw [map_mul, map_mul, map_mul]; ring
        rw [this]
        exact I.add_mem (Ideal.mul_mem_right _ I hw₁) (Ideal.mul_mem_left I _ he)
    apply le_antisymm _ hIp
    intro F' hF'
    obtain ⟨F, rfl⟩ := hmk F'
    obtain ⟨w, hw⟩ := hdec F
    by_cases hw0 : w = 0
    · rw [hw0, map_zero, map_zero, sub_zero] at hw
      exact hw
    · exfalso
      apply hconst w hw0
      have : mk (MvPolynomial.C w) = mk F - (mk F - mk (MvPolynomial.C w)) := by ring
      rw [this]
      exact (Q.comap χ).sub_mem hF' (hIp hw)

  have T2 : ∀ (N : Type u) [CommRing N] (C : ↥W →+* N) (x₀ x₁ : N),
      x₀ * x₁ = C g → ∀ (p : Ideal N) [p.IsPrime],
      p = Ideal.span {x₀ - C c, x₁ - C d} → C c ∉ p →
      IsLocalRing.maximalIdeal (Localization.AtPrime p) =
        Ideal.span {algebraMap N (Localization.AtPrime p) (x₀ - C c)} := by
    intro N _ C x₀ x₁ hx p _ hp hc
    rw [← @Localization.AtPrime.map_eq_maximalIdeal _ _ p]
    apply le_antisymm
    · have hsub : Ideal.span {x₀ - C c, x₁ - C d} ≤
          Ideal.comap (algebraMap N (Localization.AtPrime p))
          (Ideal.span {algebraMap N (Localization.AtPrime p) (x₀ - C c)}) := by
        rw [Ideal.span_le]
        intro z hz
        rcases hz with rfl | hz
        · exact Ideal.subset_span rfl
        · rw [Set.mem_singleton_iff] at hz
          subst hz
          have hu : IsUnit (algebraMap N (Localization.AtPrime p) (C c)) :=
            (IsLocalization.AtPrime.isUnit_to_map_iff _ p _).mpr hc
          obtain ⟨μ, hμ⟩ := hu
          have hid : C c * (x₁ - C d) = (-x₁) * (x₀ - C c) := by
            have h' : C g = C c * C d := by rw [← hcd, map_mul]
            linear_combination hx + h'
          have h2 : algebraMap N (Localization.AtPrime p) (C c) *
              algebraMap N (Localization.AtPrime p) (x₁ - C d) =
              algebraMap N (Localization.AtPrime p) (-x₁) *
                algebraMap N (Localization.AtPrime p) (x₀ - C c) := by
            rw [← map_mul, ← map_mul, hid]
          rw [← hμ] at h2
          rw [SetLike.mem_coe, Ideal.mem_comap]
          refine Ideal.mem_span_singleton'.mpr ⟨(↑μ⁻¹ : Localization.AtPrime p) *
            algebraMap N (Localization.AtPrime p) (-x₁), ?_⟩
          calc (↑μ⁻¹ : Localization.AtPrime p) * algebraMap N (Localization.AtPrime p) (-x₁) *
                algebraMap N (Localization.AtPrime p) (x₀ - C c)
              = ↑μ⁻¹ * (↑μ * algebraMap N (Localization.AtPrime p) (x₁ - C d)) := by
                rw [h2]; ring
            _ = algebraMap N (Localization.AtPrime p) (x₁ - C d) := by
                rw [← mul_assoc, Units.inv_mul, one_mul]
      rw [Ideal.map_le_iff_le_comap]
      intro z hz
      rw [hp] at hz
      exact hsub hz
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      apply Ideal.mem_map_of_mem
      rw [hp]
      exact Ideal.subset_span (Set.mem_insert _ _)

  have T3 : ∀ (R S : Type u) [CommRing R] [CommRing S] (f : R →+* S), f.Etale →
      ∀ (q : Ideal S) [q.IsPrime] (p : Ideal R) [p.IsPrime] (hpq : p = Ideal.comap f q) (r₀ : R),
      IsLocalRing.maximalIdeal (Localization.AtPrime p) =
        Ideal.span {algebraMap R (Localization.AtPrime p) r₀} →
      IsLocalRing.maximalIdeal (Localization.AtPrime q) =
        Ideal.span {algebraMap S (Localization.AtPrime q) (f r₀)} := by
    intro R S _ _ f hf q _ p _ hpq r₀ hm
    letI : Algebra R S := f.toAlgebra
    haveI : Algebra.Etale R S := hf.toAlgebra
    letI : Algebra (Localization.AtPrime p) (Localization.AtPrime q) :=
      (Localization.localRingHom p q f hpq).toAlgebra
    haveI : IsLocalHom (algebraMap (Localization.AtPrime p) (Localization.AtPrime q)) :=
      Localization.isLocalHom_localRingHom p q f hpq
    haveI : IsScalarTower R (Localization.AtPrime p) (Localization.AtPrime q) :=
      IsScalarTower.of_algebraMap_eq (fun x => by
        show algebraMap R (Localization.AtPrime q) x =
          Localization.localRingHom p q f hpq (algebraMap R _ x)
        rw [Localization.localRingHom_to_map]
        rfl)
    haveI : Algebra.FormallyUnramified S (Localization.AtPrime q) :=
      Algebra.FormallyUnramified.of_isLocalization q.primeCompl
    haveI : Algebra.FormallyUnramified R (Localization.AtPrime q) :=
      Algebra.FormallyUnramified.comp R S _
    haveI : Algebra.FormallyUnramified (Localization.AtPrime p) (Localization.AtPrime q) :=
      Algebra.FormallyUnramified.of_restrictScalars R _ _
    haveI : Algebra.EssFiniteType R S := Algebra.EssFiniteType.of_finiteType R S
    haveI : Algebra.EssFiniteType S (Localization.AtPrime q) :=
      Algebra.EssFiniteType.of_isLocalization _ q.primeCompl
    haveI : Algebra.EssFiniteType R (Localization.AtPrime q) := Algebra.EssFiniteType.comp R S _
    haveI : Algebra.EssFiniteType (Localization.AtPrime p) (Localization.AtPrime q) :=
      Algebra.EssFiniteType.of_comp R _ _
    rw [← Algebra.FormallyUnramified.map_maximalIdeal (R := Localization.AtPrime p)
      (S := Localization.AtPrime q), hm, Ideal.map_span, Set.image_singleton]
    congr 2
    exact Localization.localRingHom_to_map p q f hpq r₀

  obtain ⟨hFT, -, -, -, -, -, hg0, -, -, h₀, hh₀, χ, hχC, hχ0, hχ1, hχet⟩ := hPD
  have hh₀P : h₀ ∉ P := fun h => hh₀ (hP𝔭 h)
  have hc0 : c ≠ 0 := by
    rintro rfl
    exact hg0 (by rw [← hcd, zero_mul])
  have hdisj : Disjoint (↑(Submonoid.powers h₀) : Set A) ↑P := by
    rw [Set.disjoint_left]
    rintro _ ⟨n, rfl⟩ hn
    exact hh₀P (hP.mem_of_pow_mem n hn)
  haveI hQ : (P.map (algebraMap A (Localization.Away h₀))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h₀) _ P hP hdisj
  have hQP : (P.map (algebraMap A (Localization.Away h₀))).comap
      (algebraMap A (Localization.Away h₀)) = P :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers h₀) _ hP hdisj
  have hpull : ∀ z : A, algebraMap A (Localization.Away h₀) z ∈
      P.map (algebraMap A (Localization.Away h₀)) → z ∈ P := by
    intro z hz
    have h1 : z ∈ (P.map (algebraMap A (Localization.Away h₀))).comap
      (algebraMap A (Localization.Away h₀)) := hz
    rwa [hQP] at h1
  haveI hloc : IsLocalization.AtPrime
      (Localization.AtPrime (P.map (algebraMap A (Localization.Away h₀)))) P := by
    have h := IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
      (Submonoid.powers h₀) (Localization.AtPrime (P.map (algebraMap A (Localization.Away h₀))))
      (P.map (algebraMap A (Localization.Away h₀)))
    have key : ∀ (I J : Ideal A) (hI : I.IsPrime) (hJ : J.IsPrime) (R : Type u) [CommRing R]
        [Algebra A R], I = J → @IsLocalization A _ (@Ideal.primeCompl A _ I hI) R _ _ →
        @IsLocalization A _ (@Ideal.primeCompl A _ J hJ) R _ _ := by
      intro I J hI hJ R _ _ hIJ h
      subst hIJ
      exact h
    exact key _ P _ hP _ hQP h
  haveI := T5 hFT P hPW
    (Localization.AtPrime (P.map (algebraMap A (Localization.Away h₀))))

  have G : ∀ (N : Type u) [CommRing N] (mk : MvPolynomial (Fin 2) ↥W →+* N),
      Function.Surjective mk →
      mk (MvPolynomial.X 0) * mk (MvPolynomial.X 1) = mk (MvPolynomial.C g) →
      ∀ ψ : N →+* Localization.Away h₀,
      (∀ w : ↥W, ψ (mk (MvPolynomial.C w)) =
        algebraMap A (Localization.Away h₀) (algebraMap ↥W A w)) →
      ψ (mk (MvPolynomial.X 0)) = algebraMap A (Localization.Away h₀) u →
      ψ (mk (MvPolynomial.X 1)) = algebraMap A (Localization.Away h₀) v → ψ.Etale →
      IsLocalRing.maximalIdeal
          (Localization.AtPrime (P.map (algebraMap A (Localization.Away h₀)))) =
        Ideal.span {algebraMap A
          (Localization.AtPrime (P.map (algebraMap A (Localization.Away h₀))))
          (u - algebraMap ↥W A c)} := by
    intro N _ mk hmk hxx ψ hψC hψ0 hψ1 hψet
    obtain ⟨hpI, hconst⟩ := T1 N (Localization.Away h₀) mk hmk ψ
      (algebraMap A (Localization.Away h₀))
      (P.map (algebraMap A (Localization.Away h₀))) hpull
      (fun z hz => Ideal.mem_map_of_mem _ hz) hψC hψ0 hψ1
    haveI hpP : ((P.map (algebraMap A (Localization.Away h₀))).comap ψ).IsPrime :=
      Ideal.comap_isPrime ψ _
    have hxx' : mk (MvPolynomial.X 0) * mk (MvPolynomial.X 1) =
        (mk.comp MvPolynomial.C) g := hxx
    have hpI' : (P.map (algebraMap A (Localization.Away h₀))).comap ψ =
        Ideal.span {mk (MvPolynomial.X 0) - (mk.comp MvPolynomial.C) c,
          mk (MvPolynomial.X 1) - (mk.comp MvPolynomial.C) d} := hpI
    have hc' : (mk.comp MvPolynomial.C) c ∉
        (P.map (algebraMap A (Localization.Away h₀))).comap ψ := hconst c hc0
    have hmaxN := T2 N (mk.comp MvPolynomial.C) (mk (MvPolynomial.X 0))
      (mk (MvPolynomial.X 1)) hxx' ((P.map (algebraMap A (Localization.Away h₀))).comap ψ)
      hpI' hc'
    have hmaxB := T3 N (Localization.Away h₀) ψ hψet
      (P.map (algebraMap A (Localization.Away h₀)))
      ((P.map (algebraMap A (Localization.Away h₀))).comap ψ) rfl _ hmaxN
    have hψt : ψ (mk (MvPolynomial.X 0) - (mk.comp MvPolynomial.C) c) =
        algebraMap A (Localization.Away h₀) (u - algebraMap ↥W A c) := by
      rw [map_sub, hψ0, RingHom.comp_apply, hψC, ← map_sub]
    rw [hψt, ← IsScalarTower.algebraMap_apply] at hmaxB
    exact hmaxB
  have hmax := G (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
    (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}))
    Ideal.Quotient.mk_surjective (by
      rw [← map_mul]
      exact Ideal.Quotient.eq.mpr (Ideal.subset_span (Set.mem_singleton _))) χ
    (fun w => RingHom.congr_fun hχC w) hχ0 hχ1 hχet
  exact T7 P (Localization.AtPrime (P.map (algebraMap A (Localization.Away h₀))))
    (u - algebraMap ↥W A c) (fun y hy => T6 _ _ hmax y hy) x hx

theorem wcpa_dj_llsm_kptf_tube_unique : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ P P' : Ideal A, P.IsPrime → P'.IsPrime → P ≤ 𝔭 → P' ≤ 𝔭 →
    (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) → (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P') →
    ∀ c d : ↥W, c * d = g → u - algebraMap ↥W A c ∈ P → v - algebraMap ↥W A d ∈ P →
    u - algebraMap ↥W A c ∈ P' → v - algebraMap ↥W A d ∈ P' → P = P' :=
by

  have s3 : ∀ (P E B : Type u) [CommRing P] [CommRing E] [CommRing B] [HenselianLocalRing B]
      (χ : P →+* E) (γ : P →+* B) (ϱ : E →+* IsLocalRing.ResidueField B), χ.Etale →
      ϱ.comp χ = (IsLocalRing.residue B).comp γ →
      ∃ τ : E →+* B, τ.comp χ = γ ∧ ∀ x, IsLocalRing.residue B (τ x) = ϱ x := by
    intro P E B _ _ _ _ χ γ ϱ hχ hσ
    letI : Algebra P E := χ.toAlgebra
    letI : Algebra P B := γ.toAlgebra
    haveI : Algebra.Etale P E := hχ
    obtain ⟨τ, hτ⟩ := wc_hnas_hs_etale_section_over_base P B
      (fun E'' _ _ _ σ'' => wc_hnas_smooth_section_henselian B E'' σ'') E ϱ hσ
    exact ⟨τ, RingHom.ext fun t => τ.commutes t, hτ⟩

  have s4 : ∀ (P E B : Type u) [CommRing P] [CommRing E] [CommRing B] [IsLocalRing B]
      (χ : P →+* E) (τ τ' : E →+* B), χ.Etale → τ.comp χ = τ'.comp χ →
      (∀ x, IsLocalRing.residue B (τ x) = IsLocalRing.residue B (τ' x)) → τ = τ' := by
    intro P E B _ _ _ _ χ τ τ' hχ hcomp hres
    letI : Algebra P E := χ.toAlgebra
    letI : Algebra P B := (τ.comp χ).toAlgebra
    haveI : Algebra.Etale P E := hχ
    let t1 : E →ₐ[P] B := ⟨τ, fun r => rfl⟩
    let t2 : E →ₐ[P] B := ⟨τ', fun r => (RingHom.congr_fun hcomp r).symm⟩
    have := wc_hnas_hs_etale_hom_unique_residue P E B t1 t2 hres
    exact RingHom.ext fun x => congrArg (fun f : E →ₐ[P] B => f x) this
  intro Ω _ _ W _ _ A _ _ _ K _ _ _ 𝔭 u v g hPD P P' hP hP' hP𝔭 hP'𝔭 hPW hP'W c d hcd hcP hdP
    hcP' hdP'
  obtain ⟨hFT, -, -, h𝔭max, hm𝔭, hg, hg0, huv, h𝔭eq, h₀, hh₀, χ, hχC, hχu, hχv, hχet⟩ := hPD

  haveI hHens : HenselianLocalRing ↥W := by
    have key : ∀ n : ℕ, ∀ f : Polynomial ↥W, f.Monic → f.natDegree = n → ∀ a₀ : ↥W,
        f.eval a₀ ∈ IsLocalRing.maximalIdeal ↥W →
        ∃ a, f.IsRoot a ∧ a - a₀ ∈ IsLocalRing.maximalIdeal ↥W := by
      intro n
      induction n with
      | zero =>
        intro f hf hd a₀ ha
        rw [Polynomial.eq_one_of_monic_natDegree_zero hf hd, Polynomial.eval_one] at ha
        exact absurd ha ((Ideal.ne_top_iff_one _).mp (IsLocalRing.maximalIdeal.isMaximal ↥W).ne_top)
      | succ n ih =>
        intro f hf hd a₀ ha
        have hdeg : (f.map (algebraMap ↥W Ω)).degree ≠ 0 := by
          rw [Polynomial.degree_eq_natDegree (hf.map _).ne_zero, hf.natDegree_map, hd]
          exact_mod_cast Nat.succ_ne_zero n
        obtain ⟨r, hr⟩ := IsAlgClosed.exists_root _ hdeg
        have hint : IsIntegral ↥W r := ⟨f, hf, by rwa [Polynomial.IsRoot, Polynomial.eval_map] at hr⟩
        obtain ⟨s, hs⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
        have hfs : f.IsRoot s := by
          apply IsFractionRing.injective ↥W Ω
          rw [map_zero, ← Polynomial.eval₂_hom, hs, ← Polynomial.eval_map]
          exact hr
        have hfq : (Polynomial.X - Polynomial.C s) * (f /ₘ (Polynomial.X - Polynomial.C s)) = f :=
          Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hfs
        have hqm : (f /ₘ (Polynomial.X - Polynomial.C s)).Monic := by
          apply Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C s)
          rw [hfq]; exact hf
        have hqd : (f /ₘ (Polynomial.X - Polynomial.C s)).natDegree = n := by
          rw [Polynomial.natDegree_divByMonic _ (Polynomial.monic_X_sub_C s),
            Polynomial.natDegree_X_sub_C, hd]
          omega
        have hev : f.eval a₀ = (a₀ - s) * (f /ₘ (Polynomial.X - Polynomial.C s)).eval a₀ := by
          conv_lhs => rw [← hfq]
          rw [Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
        rw [hev] at ha
        rcases (IsLocalRing.maximalIdeal.isMaximal ↥W).isPrime.mem_or_mem ha with h | h
        · refine ⟨s, hfs, ?_⟩
          rw [← neg_sub]; exact neg_mem h
        · obtain ⟨a, ha', hm⟩ := ih _ hqm hqd a₀ h
          refine ⟨a, ?_, hm⟩
          rw [Polynomial.IsRoot, ← hfq, Polynomial.eval_mul, ha'.eq_zero, mul_zero]
    exact HenselianLocalRing.mk (fun f hf a₀ ha₀ _ => key _ f hf rfl a₀ ha₀)
  have hu𝔭 : u ∈ 𝔭 := by
    rw [h𝔭eq]; exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
  have hv𝔭 : v ∈ 𝔭 := by
    rw [h𝔭eq]; exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
  have h𝔭top : 𝔭 ≠ ⊤ := h𝔭max.ne_top
  have hunitW : ∀ w : ↥W, algebraMap ↥W A w ∈ 𝔭 → w ∈ IsLocalRing.maximalIdeal ↥W := by
    intro w hw
    by_contra hc
    exact h𝔭top (Ideal.eq_top_of_isUnit_mem _ hw ((IsLocalRing.notMem_maximalIdeal.mp hc).map _))
  have hc : c ∈ IsLocalRing.maximalIdeal ↥W := by
    apply hunitW
    have := 𝔭.sub_mem hu𝔭 (hP𝔭 hcP)
    rwa [sub_sub_cancel] at this
  have hd : d ∈ IsLocalRing.maximalIdeal ↥W := by
    apply hunitW
    have := 𝔭.sub_mem hv𝔭 (hP𝔭 hdP)
    rwa [sub_sub_cancel] at this

  have hker : ∀ a ∈ Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g :
      MvPolynomial (Fin 2) ↥W)}, MvPolynomial.eval₂Hom (RingHom.id ↥W) ![c, d] a = 0 := by
    intro a ha
    obtain ⟨z, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    simp [hcd]
  obtain ⟨e, he⟩ : ∃ e : wcEbntN W g →+* ↥W, e = Ideal.Quotient.lift _
      (MvPolynomial.eval₂Hom (RingHom.id ↥W) ![c, d]) hker := ⟨_, rfl⟩
  have heC : ∀ w : ↥W, e (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)}) (MvPolynomial.C w)) = w := by
    intro w; rw [he, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C, RingHom.id_apply]
  have heX : ∀ i : Fin 2, e (wcEbntX W g i) = ![c, d] i := by
    intro i; rw [he]
    exact (Ideal.Quotient.lift_mk _ _ _).trans (MvPolynomial.eval₂Hom_X' _ _ _)
  have he0 : e (wcEbntX W g 0) = c := (heX 0).trans (by simp)
  have he1 : e (wcEbntX W g 1) = d := (heX 1).trans (by simp)

  have hres := wcpa_dj_llsm_kptf_residue_trivial Ω W A 𝔭 hFT h𝔭max hm𝔭
  let κ : ↥W →+* A ⧸ 𝔭 := (Ideal.Quotient.mk 𝔭).comp (algebraMap ↥W A)
  have hκ : Function.Surjective κ := by
    intro x
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨w, hw⟩ := hres a
    exact ⟨w, (Ideal.Quotient.eq.mpr hw).symm⟩
  have hθκ : ∀ w ∈ RingHom.ker κ, IsLocalRing.residue ↥W w = 0 := by
    intro w hw
    have h1 : algebraMap ↥W A w ∈ 𝔭 := Ideal.Quotient.eq_zero_iff_mem.mp (RingHom.mem_ker.mp hw)
    rw [IsLocalRing.residue_eq_zero_iff]
    exact hunitW w h1
  let eK := RingHom.quotientKerEquivOfSurjective hκ
  let θb : ↥W ⧸ RingHom.ker κ →+* IsLocalRing.ResidueField ↥W :=
    Ideal.Quotient.lift (RingHom.ker κ) (IsLocalRing.residue ↥W) hθκ
  let ρ : A →+* IsLocalRing.ResidueField ↥W :=
    θb.comp (eK.symm.toRingHom.comp (Ideal.Quotient.mk 𝔭))
  have hρι : ∀ w : ↥W, ρ (algebraMap ↥W A w) = IsLocalRing.residue ↥W w := by
    intro w
    have h1 : eK.symm (Ideal.Quotient.mk 𝔭 (algebraMap ↥W A w)) = Ideal.Quotient.mk _ w := by
      rw [RingEquiv.symm_apply_eq]
      exact (RingHom.quotientKerEquivOfSurjective_apply_mk hκ w).symm
    show θb (eK.symm (Ideal.Quotient.mk 𝔭 (algebraMap ↥W A w))) = _
    rw [h1]
    exact Ideal.Quotient.lift_mk _ _ _
  have hr0 : ∀ a ∈ 𝔭, ρ a = 0 := by
    intro a ha
    show θb (eK.symm (Ideal.Quotient.mk 𝔭 a)) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha, map_zero, map_zero]
  have hr : ∀ a : A, ρ a = 0 ↔ a ∈ 𝔭 := by
    intro a
    refine ⟨fun h => ?_, hr0 a⟩
    by_contra ha
    obtain ⟨y, i, hi, hyi⟩ := h𝔭max.exists_inv ha
    have := congrArg ρ hyi
    rw [map_add, map_mul, h, mul_zero, hr0 i hi, zero_add, map_one] at this
    exact zero_ne_one this

  have hrh : IsUnit (ρ h₀) := IsUnit.mk0 _ (fun h => hh₀ ((hr h₀).mp h))
  let ϱ : Localization.Away h₀ →+* IsLocalRing.ResidueField ↥W :=
    IsLocalization.Away.lift h₀ hrh
  have hϱ : ∀ a : A, ϱ (algebraMap A (Localization.Away h₀) a) = ρ a := fun a =>
    IsLocalization.Away.lift_eq h₀ hrh a
  have hχC' : ∀ w : ↥W, χ (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)}) (MvPolynomial.C w)) =
      algebraMap A (Localization.Away h₀) (algebraMap ↥W A w) := fun w =>
    RingHom.congr_fun hχC w
  have hrc : IsLocalRing.residue ↥W c = 0 := by rw [IsLocalRing.residue_eq_zero_iff]; exact hc
  have hrd : IsLocalRing.residue ↥W d = 0 := by rw [IsLocalRing.residue_eq_zero_iff]; exact hd
  have hσ : ϱ.comp χ = (IsLocalRing.residue ↥W).comp e := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro w
      simp only [RingHom.comp_apply]
      rw [heC, hχC', hϱ, hρι]
    · refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
      · show ϱ (χ (wcEbntX W g 0)) = IsLocalRing.residue ↥W (e (wcEbntX W g 0))
        rw [hχu, hϱ, hr0 u hu𝔭, he0, hrc]
      · show ϱ (χ (wcEbntX W g 1)) = IsLocalRing.residue ↥W (e (wcEbntX W g 1))
        rw [hχv, hϱ, hr0 v hv𝔭, he1, hrd]

  obtain ⟨τ, hτχ, hτ⟩ := @s3 (wcEbntN W g) (Localization.Away h₀) ↥W inferInstance
    inferInstance inferInstance inferInstance χ e ϱ hχet hσ
  have hτχ' : ∀ x, τ (χ x) = e x := fun x => RingHom.congr_fun hτχ x
  have hx𝔭 : ∀ a : A, a - algebraMap ↥W A (τ (algebraMap A (Localization.Away h₀) a)) ∈ 𝔭 := by
    intro a
    rw [← hr, map_sub, hρι, hτ, hϱ, sub_self]

  have hkerQ : ∀ Q : Ideal A, Q.IsPrime → Q ≤ 𝔭 → u - algebraMap ↥W A c ∈ Q →
      v - algebraMap ↥W A d ∈ Q →
      ∀ a : A, a - algebraMap ↥W A (τ (algebraMap A (Localization.Away h₀) a)) ∈ Q := by
    intro Q hQ hQ𝔭 hcQ hdQ
    haveI := hQ
    have hqs : Function.Surjective (Ideal.Quotient.mk Q) := Ideal.Quotient.mk_surjective
    obtain ⟨𝔭b, h𝔭bdef⟩ : ∃ I : Ideal (A ⧸ Q), I = 𝔭.map (Ideal.Quotient.mk Q) := ⟨_, rfl⟩
    haveI h𝔭b : 𝔭b.IsPrime := by
      rw [h𝔭bdef]
      haveI := h𝔭max.isPrime
      exact Ideal.map_isPrime_of_surjective hqs (by rw [Ideal.mk_ker]; exact hQ𝔭)
    have hcomap : 𝔭b.comap (Ideal.Quotient.mk Q) = 𝔭 := by
      rw [h𝔭bdef, Ideal.comap_map_of_surjective' _ hqs, Ideal.mk_ker]
      exact sup_eq_left.mpr hQ𝔭
    have hj : Function.Injective (algebraMap (A ⧸ Q) (Localization.AtPrime 𝔭b)) :=
      IsLocalization.injective (Localization.AtPrime 𝔭b)
        (Ideal.primeCompl_le_nonZeroDivisors 𝔭b)
    let π₀ : A →+* Localization.AtPrime 𝔭b :=
      (algebraMap (A ⧸ Q) (Localization.AtPrime 𝔭b)).comp (Ideal.Quotient.mk Q)
    have hb : IsUnit (π₀ h₀) := by
      apply (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime 𝔭b) 𝔭b
        (Ideal.Quotient.mk Q h₀)).mpr
      intro hm
      apply hh₀
      rw [← hcomap]
      exact hm
    have hmax : ∀ x ∈ 𝔭, π₀ x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭b) := by
      intro x hx
      exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔭b) 𝔭b
        (Ideal.Quotient.mk Q x)).mpr (by rw [h𝔭bdef]; exact Ideal.mem_map_of_mem _ hx)
    let α : Localization.Away h₀ →+* Localization.AtPrime 𝔭b := IsLocalization.Away.lift h₀ hb
    have hα : ∀ a : A, α (algebraMap A (Localization.Away h₀) a) = π₀ a := fun a =>
      IsLocalization.Away.lift_eq h₀ hb a
    let β : Localization.Away h₀ →+* Localization.AtPrime 𝔭b :=
      (π₀.comp (algebraMap ↥W A)).comp τ
    have hπc : π₀ u = π₀ (algebraMap ↥W A c) := by
      show algebraMap (A ⧸ Q) _ (Ideal.Quotient.mk Q u) =
        algebraMap (A ⧸ Q) _ (Ideal.Quotient.mk Q (algebraMap ↥W A c))
      rw [Ideal.Quotient.eq.mpr hcQ]
    have hπd : π₀ v = π₀ (algebraMap ↥W A d) := by
      show algebraMap (A ⧸ Q) _ (Ideal.Quotient.mk Q v) =
        algebraMap (A ⧸ Q) _ (Ideal.Quotient.mk Q (algebraMap ↥W A d))
      rw [Ideal.Quotient.eq.mpr hdQ]
    have hαβχ : α.comp χ = β.comp χ := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro w
        show α (χ (Ideal.Quotient.mk _ (MvPolynomial.C w))) =
          π₀ (algebraMap ↥W A (τ (χ (Ideal.Quotient.mk _ (MvPolynomial.C w)))))
        rw [hτχ', heC, hχC', hα]
      · refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
        · show α (χ (wcEbntX W g 0)) = π₀ (algebraMap ↥W A (τ (χ (wcEbntX W g 0))))
          rw [hτχ', he0, hχu, hα, hπc]
        · show α (χ (wcEbntX W g 1)) = π₀ (algebraMap ↥W A (τ (χ (wcEbntX W g 1))))
          rw [hτχ', he1, hχv, hα, hπd]
    have hres2 : (IsLocalRing.residue (Localization.AtPrime 𝔭b)).comp α =
        (IsLocalRing.residue (Localization.AtPrime 𝔭b)).comp β := by
      apply IsLocalization.ringHom_ext (Submonoid.powers h₀)
      refine RingHom.ext fun a => ?_
      have h1 := hmax _ (hx𝔭 a)
      rw [← IsLocalRing.residue_eq_zero_iff, map_sub, map_sub, sub_eq_zero] at h1
      show IsLocalRing.residue _ (α (algebraMap A (Localization.Away h₀) a)) =
        IsLocalRing.residue _ (π₀ (algebraMap ↥W A (τ (algebraMap A (Localization.Away h₀) a))))
      rw [hα]
      exact h1
    have hαβ : α = β := @s4 (wcEbntN W g) (Localization.Away h₀) (Localization.AtPrime 𝔭b)
      inferInstance inferInstance inferInstance inferInstance χ α β hχet hαβχ
      (fun x => RingHom.congr_fun hres2 x)
    intro a
    have h1 : π₀ a = π₀ (algebraMap ↥W A (τ (algebraMap A (Localization.Away h₀) a))) := by
      rw [← hα]
      exact RingHom.congr_fun hαβ _
    have h2 : Ideal.Quotient.mk Q
        (a - algebraMap ↥W A (τ (algebraMap A (Localization.Away h₀) a))) = 0 := by
      apply hj
      rw [map_zero, map_sub, map_sub]
      exact sub_eq_zero.mpr h1
    exact Ideal.Quotient.eq_zero_iff_mem.mp h2

  have hmemiff : ∀ Q : Ideal A, Q.IsPrime → Q ≤ 𝔭 →
      (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ Q) →
      u - algebraMap ↥W A c ∈ Q → v - algebraMap ↥W A d ∈ Q →
      ∀ a : A, a ∈ Q ↔ τ (algebraMap A (Localization.Away h₀) a) = 0 := by
    intro Q hQ hQ𝔭 hQW hcQ hdQ a
    have hk := hkerQ Q hQ hQ𝔭 hcQ hdQ a
    constructor
    · intro ha
      by_contra hne
      apply hQW _ hne
      have := Q.sub_mem ha hk
      rwa [sub_sub_cancel] at this
    · intro h0
      rw [h0, map_zero, sub_zero] at hk
      exact hk
  ext a
  rw [hmemiff P hP hP𝔭 hPW hcP hdP a, hmemiff P' hP' hP'𝔭 hP'W hcP' hdP' a]

theorem wcpa_dj_llsm_kptf_tube_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ f : A, f ≠ 0 → (∀ P : Ideal A, P.IsPrime → P ≠ ⊥ → P ≤ 𝔭 →
      (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) →
      ∀ Q : Ideal A, Q.IsPrime → Q ≠ ⊥ → Q ≤ P → Q = P) →
    {P : Ideal A | P.IsPrime ∧ P ≠ ⊥ ∧ P ≤ 𝔭 ∧ (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) ∧
      f ∈ P}.Finite :=
by
  intro Ω _ _ W hdim hWt A _ _ _ K _ _ _ 𝔭 u v g hPD f hf0 hCH
  classical
  have hfin : Algebra.FiniteType ↥W A := hPD.1

  obtain ⟨z, hz⟩ : ∃ z : Ω, z ∉ W := by
    by_contra h
    push_neg at h
    exact hWt (eq_top_iff.mpr fun x _ => h x)
  have hz0 : z ≠ 0 := fun h => hz (h ▸ W.zero_mem)
  have hzi : z⁻¹ ∈ W := (W.mem_or_inv_mem z).resolve_left hz
  set ϖ : ↥W := ⟨z⁻¹, hzi⟩ with hϖdef
  have hϖ0 : ϖ ≠ 0 := fun h => inv_ne_zero hz0 (congrArg Subtype.val h)
  have hϖm : ϖ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    rintro ⟨μ, hμ⟩
    apply hz
    have h1 : (ϖ : Ω) * (((μ⁻¹ : (↥W)ˣ) : ↥W) : Ω) = 1 := by
      rw [← hμ]
      exact_mod_cast congrArg Subtype.val μ.mul_inv
    have h2 : z = (((μ⁻¹ : (↥W)ˣ) : ↥W) : Ω) := by
      calc z = z * ((ϖ : Ω) * (((μ⁻¹ : (↥W)ˣ) : ↥W) : Ω)) := by rw [h1, mul_one]
        _ = (((μ⁻¹ : (↥W)ˣ) : ↥W) : Ω) := by
          rw [← mul_assoc]
          show z * z⁻¹ * _ = _
          rw [mul_inv_cancel₀ hz0, one_mul]
    rw [h2]
    exact SetLike.coe_mem _

  have hKdim : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hdim
  have hdvd : ∀ w : ↥W, w ≠ 0 → ∃ k : ℕ, ∃ t : ↥W, ϖ ^ k = w * t := by
    intro w hw
    have hrad : ϖ ∈ (Ideal.span {w}).radical := by
      rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
      rintro J ⟨hwJ, hJ⟩
      have hJm : J = IsLocalRing.maximalIdeal ↥W := by
        rcases Ring.krullDimLE_one_iff.mp hKdim J hJ with h | h
        · rw [IsDomain.minimalPrimes_eq_singleton_bot] at h
          rw [Set.mem_singleton_iff] at h
          exfalso
          apply hw
          rw [h] at hwJ
          exact (Ideal.mem_bot).mp ((Ideal.span_singleton_le_iff_mem _).mp hwJ)
        · exact IsLocalRing.eq_maximalIdeal h
      rw [hJm]; exact hϖm
    obtain ⟨k, hk⟩ := hrad
    obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp hk
    exact ⟨k, t, by rw [← ht, mul_comm]⟩

  set x : A := algebraMap ↥W A ϖ with hx
  have hunit : ∀ w : nonZeroDivisors ↥W, IsUnit (algebraMap ↥W (Localization.Away x) w) := by
    intro w
    obtain ⟨k, t, hk⟩ := hdvd w (nonZeroDivisors.ne_zero w.2)
    have h1 : IsUnit (algebraMap ↥W (Localization.Away x) ϖ ^ k) := by
      rw [IsScalarTower.algebraMap_apply ↥W A (Localization.Away x)]
      exact (IsLocalization.Away.algebraMap_isUnit x).pow k
    rw [← map_pow, hk, map_mul] at h1
    exact isUnit_of_mul_isUnit_left h1
  letI : Algebra Ω (Localization.Away x) :=
    (IsLocalization.lift (M := nonZeroDivisors ↥W) (S := Ω) hunit).toAlgebra
  have : IsScalarTower ↥W Ω (Localization.Away x) :=
    IsScalarTower.of_algebraMap_eq (fun w => (IsLocalization.lift_eq hunit w).symm)
  have : Algebra.FiniteType ↥W (Localization.Away x) := Algebra.FiniteType.trans hfin inferInstance
  have : Algebra.FiniteType Ω (Localization.Away x) :=
    Algebra.FiniteType.of_restrictScalars_finiteType ↥W Ω (Localization.Away x)
  have : IsNoetherianRing (Localization.Away x) :=
    Algebra.FiniteType.isNoetherianRing Ω (Localization.Away x)

  have hM : (Ideal.map (algebraMap A (Localization.Away x)) (Ideal.span {f})).minimalPrimes.Finite :=
    Ideal.finite_minimalPrimes_of_isNoetherianRing _ _
  refine (hM.image (Ideal.comap (algebraMap A (Localization.Away x)))).subset ?_
  rintro P ⟨hP, hP0, hP𝔭, hPW, hfP⟩
  have hdisj : Disjoint (Submonoid.powers x : Set A) (P : Set A) := by
    rw [Set.disjoint_left]
    rintro y ⟨n, rfl⟩ hy
    exact hPW ϖ hϖ0 (hP.mem_of_pow_mem n hy)
  have hcm : Ideal.comap (algebraMap A (Localization.Away x))
      (Ideal.map (algebraMap A (Localization.Away x)) P) = P :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers x)
      (Localization.Away x) hP hdisj
  refine ⟨Ideal.map (algebraMap A (Localization.Away x)) P, ?_, hcm⟩
  rw [IsLocalization.minimalPrimes_map (Submonoid.powers x) (Localization.Away x)]
  change Ideal.comap _ (Ideal.map _ P) ∈ (Ideal.span {f}).minimalPrimes
  rw [hcm]
  refine ⟨⟨hP, (Ideal.span_singleton_le_iff_mem P).mpr hfP⟩, ?_⟩
  rintro q ⟨hq, hfq⟩ hqP
  have hq0 : q ≠ ⊥ := by
    intro h
    apply hf0
    rw [h] at hfq
    exact (Ideal.mem_bot).mp ((Ideal.span_singleton_le_iff_mem _).mp hfq)
  exact (hCH P hP hP0 hP𝔭 hPW q hq hq0 hqP).ge

theorem wcpa_dj_llsm_kptf_local_global_unit : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ x : K, x ≠ 0 → (∀ P : Ideal A, P.IsPrime → P ≠ ⊥ → P ≤ 𝔭 →
      (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) →
      ∃ a s : A, a ∉ P ∧ s ∉ P ∧ x * algebraMap A K s = algebraMap A K a) →
    ∃ (a s a' s' : A) (w w' : ↥W), w ≠ 0 ∧ w' ≠ 0 ∧ s ∉ 𝔭 ∧ s' ∉ 𝔭 ∧
      x * algebraMap A K s * algebraMap A K (algebraMap ↥W A w) = algebraMap A K a ∧
      a * a' = algebraMap ↥W A w' * s' :=
by
  intro Ω _ _ W _ _ A _ _ _ K _ _ _ 𝔭 u v g hPD x hx0 hx
  obtain ⟨-, -, -, h𝔭max, -⟩ := hPD
  have h𝔭 : 𝔭.IsPrime := h𝔭max.isPrime
  have hinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h => h𝔭.ne_top ((Ideal.eq_top_iff_one 𝔭).mpr h)
  let S : Submonoid A :=
    { carrier := {z : A | ∃ (s : A) (w : ↥W), s ∉ 𝔭 ∧ w ≠ 0 ∧ z = s * algebraMap ↥W A w}
      one_mem' := ⟨1, 1, h1𝔭, one_ne_zero, by simp⟩
      mul_mem' := by
        rintro _ _ ⟨s₁, w₁, hs₁, hw₁, rfl⟩ ⟨s₂, w₂, hs₂, hw₂, rfl⟩
        refine ⟨s₁ * s₂, w₁ * w₂, fun h => (h𝔭.mem_or_mem h).elim hs₁ hs₂,
          mul_ne_zero hw₁ hw₂, ?_⟩
        rw [map_mul]; ring }
  have hSmem : ∀ (s : A) (w : ↥W), s ∉ 𝔭 → w ≠ 0 → s * algebraMap ↥W A w ∈ (S : Set A) :=
    fun s w hs hw => ⟨s, w, hs, hw, rfl⟩
  have key : ∀ y : K, (∀ P : Ideal A, P.IsPrime → P ≠ ⊥ → P ≤ 𝔭 →
      (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) →
      ∃ a s : A, a ∉ P ∧ s ∉ P ∧ y * algebraMap A K s = algebraMap A K a) →
      ∃ (s : A) (w : ↥W) (a : A), s ∉ 𝔭 ∧ w ≠ 0 ∧
        y * algebraMap A K s * algebraMap A K (algebraMap ↥W A w) = algebraMap A K a := by
    intro y hy
    let D : Ideal A :=
      { carrier := {d : A | ∃ a : A, y * algebraMap A K d = algebraMap A K a}
        zero_mem' := ⟨0, by simp⟩
        add_mem' := by
          rintro d₁ d₂ ⟨a₁, h₁⟩ ⟨a₂, h₂⟩
          exact ⟨a₁ + a₂, by rw [map_add, mul_add, h₁, h₂, map_add]⟩
        smul_mem' := by
          rintro c d ⟨a, h⟩
          refine ⟨c * a, ?_⟩
          rw [smul_eq_mul, map_mul, map_mul, ← h]; ring }
    have hDmem : ∀ d a : A, y * algebraMap A K d = algebraMap A K a → d ∈ D :=
      fun d a h => ⟨a, h⟩
    obtain ⟨n, d, hdmem, hd⟩ := IsFractionRing.div_surjective (A := A) y
    have hdK : algebraMap A K d ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hdmem
    have hdD : d ∈ D := hDmem d n (by rw [← hd, div_mul_cancel₀ _ hdK])
    by_cases hdisj : Disjoint (D : Set A) (S : Set A)
    · exfalso
      obtain ⟨P, hP, hDP, hPS⟩ := Ideal.exists_le_prime_disjoint D S hdisj
      have hPbot : P ≠ ⊥ := by
        intro h
        have hdP : d ∈ P := hDP hdD
        rw [h, Ideal.mem_bot] at hdP
        exact nonZeroDivisors.ne_zero hdmem hdP
      have hP𝔭 : P ≤ 𝔭 := by
        intro t ht
        by_contra htp
        have htS := hSmem t 1 htp one_ne_zero
        rw [map_one, mul_one] at htS
        exact Set.disjoint_left.mp hPS ht htS
      have hPW : ∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P := by
        intro w hw hwP
        have hwS := hSmem 1 w h1𝔭 hw
        rw [one_mul] at hwS
        exact Set.disjoint_left.mp hPS hwP hwS
      obtain ⟨a, s, -, hs, hys⟩ := hy P hP hPbot hP𝔭 hPW
      exact hs (hDP (hDmem s a hys))
    · rw [Set.not_disjoint_iff] at hdisj
      obtain ⟨z, ⟨a, hza⟩, ⟨s, w, hs, hw, rfl⟩⟩ := hdisj
      refine ⟨s, w, a, hs, hw, ?_⟩
      rw [mul_assoc, ← map_mul]
      exact hza
  obtain ⟨s₁, w₁, a₁, hs₁, hw₁, h₁⟩ := key x hx
  have hinv : ∀ P : Ideal A, P.IsPrime → P ≠ ⊥ → P ≤ 𝔭 →
      (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) →
      ∃ a s : A, a ∉ P ∧ s ∉ P ∧ x⁻¹ * algebraMap A K s = algebraMap A K a := by
    intro P hP hP0 hP𝔭 hPW
    obtain ⟨a, s, ha, hs, h⟩ := hx P hP hP0 hP𝔭 hPW
    exact ⟨s, a, hs, ha, by rw [← h, ← mul_assoc, inv_mul_cancel₀ hx0, one_mul]⟩
  obtain ⟨s₂, w₂, a₂, hs₂, hw₂, h₂⟩ := key x⁻¹ hinv
  refine ⟨a₁, s₁, a₂, s₁ * s₂, w₁, w₁ * w₂, hw₁, mul_ne_zero hw₁ hw₂, hs₁,
    fun h => (h𝔭.mem_or_mem h).elim hs₁ hs₂, h₁, ?_⟩
  apply hinj
  have hxx : x * x⁻¹ = 1 := mul_inv_cancel₀ hx0
  simp only [map_mul]
  rw [← h₁, ← h₂]
  linear_combination (algebraMap A K s₁ * algebraMap A K s₂ *
    algebraMap A K (algebraMap ↥W A w₁) * algebraMap A K (algebraMap ↥W A w₂)) * hxx

theorem wcpa_dj_llsm_kptf_hens_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A)
    (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) →
    (∀ a : A, ∃ w : ↥W, a - algebraMap ↥W A w ∈ 𝔭) →
    ∀ (Q : Type u) [CommRing Q] (φ : A →+* Q), wcNdIsHens 𝔭 Q φ →
    ∃ fN : wcEbntN W g →+* Q, wcEbntPres W (φ.comp (algebraMap ↥W A)) g fN ∧
      fN (wcEbntX W g 0) = φ u ∧ fN (wcEbntX W g 1) = φ v :=
by

  have s3 : ∀ (P E B : Type u) [CommRing P] [CommRing E] [CommRing B] [HenselianLocalRing B]
      (χ : P →+* E) (γ : P →+* B) (ϱ : E →+* IsLocalRing.ResidueField B), χ.Etale →
      ϱ.comp χ = (IsLocalRing.residue B).comp γ →
      ∃ τ : E →+* B, τ.comp χ = γ ∧ ∀ x, IsLocalRing.residue B (τ x) = ϱ x := by
    intro P E B _ _ _ _ χ γ ϱ hχ hσ
    letI : Algebra P E := χ.toAlgebra
    letI : Algebra P B := γ.toAlgebra
    haveI : Algebra.Etale P E := hχ
    obtain ⟨τ, hτ⟩ := wc_hnas_hs_etale_section_over_base P B
      (fun E'' _ _ _ σ'' => wc_hnas_smooth_section_henselian B E'' σ'') E ϱ hσ
    exact ⟨τ, RingHom.ext fun t => τ.commutes t, hτ⟩

  have s4 : ∀ (P E B : Type u) [CommRing P] [CommRing E] [CommRing B] [IsLocalRing B]
      (χ : P →+* E) (τ τ' : E →+* B), χ.Etale → τ.comp χ = τ'.comp χ →
      (∀ x, IsLocalRing.residue B (τ x) = IsLocalRing.residue B (τ' x)) → τ = τ' := by
    intro P E B _ _ _ _ χ τ τ' hχ hcomp hres
    letI : Algebra P E := χ.toAlgebra
    letI : Algebra P B := (τ.comp χ).toAlgebra
    haveI : Algebra.Etale P E := hχ
    let t1 : E →ₐ[P] B := ⟨τ, fun r => rfl⟩
    let t2 : E →ₐ[P] B := ⟨τ', fun r => (RingHom.congr_fun hcomp r).symm⟩
    have := wc_hnas_hs_etale_hom_unique_residue P E B t1 t2 hres
    exact RingHom.ext fun x => congrArg (fun f : E →ₐ[P] B => f x) this
  intro Ω _ _ W A _ _ _ 𝔭 u v g hPD hres Q _ φ hφ
  obtain ⟨-, -, -, h𝔭max, hm𝔭, hg, hg0, huv, h𝔭eq, h₀, hh₀, χ, hχC, hχu, hχv, hχet⟩ := hPD
  obtain ⟨hH1, hH2, hH3⟩ := hφ
  have hu𝔭 : u ∈ 𝔭 := by
    rw [h𝔭eq]; exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
  have hv𝔭 : v ∈ 𝔭 := by
    rw [h𝔭eq]; exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
  have h𝔭top : 𝔭 ≠ ⊤ := h𝔭max.ne_top
  have hunitW : ∀ w : ↥W, algebraMap ↥W A w ∈ 𝔭 → w ∈ IsLocalRing.maximalIdeal ↥W := by
    intro w hw
    by_contra hc
    exact h𝔭top (Ideal.eq_top_of_isUnit_mem _ hw ((IsLocalRing.notMem_maximalIdeal.mp hc).map _))

  have hker : ∀ a ∈ Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g :
      MvPolynomial (Fin 2) ↥W)}, MvPolynomial.eval₂Hom (algebraMap ↥W A) ![u, v] a = 0 := by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    simp [huv]
  obtain ⟨ψ, hψdef⟩ : ∃ ψ : wcEbntN W g →+* A, ψ = Ideal.Quotient.lift _
      (MvPolynomial.eval₂Hom (algebraMap ↥W A) ![u, v]) hker := ⟨_, rfl⟩
  have hψC : ∀ w : ↥W, ψ (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)}) (MvPolynomial.C w)) = algebraMap ↥W A w := by
    intro w; rw [hψdef, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
  have hψX : ∀ i : Fin 2, ψ (wcEbntX W g i) = ![u, v] i := by
    intro i; rw [hψdef]
    exact (Ideal.Quotient.lift_mk _ _ _).trans (MvPolynomial.eval₂Hom_X' _ _ _)
  have hψ0 : ψ (wcEbntX W g 0) = u := (hψX 0).trans (by simp)
  have hψ1 : ψ (wcEbntX W g 1) = v := (hψX 1).trans (by simp)

  have hχψ : χ = (algebraMap A (Localization.Away h₀)).comp ψ := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro w
      simp only [RingHom.comp_apply]
      rw [hψC]
      exact RingHom.congr_fun hχC w
    · refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
      · show χ (wcEbntX W g 0) = algebraMap A (Localization.Away h₀) (ψ (wcEbntX W g 0))
        rw [hψ0]; exact hχu
      · show χ (wcEbntX W g 1) = algebraMap A (Localization.Away h₀) (ψ (wcEbntX W g 1))
        rw [hψ1]; exact hχv

  have hJ : ∀ t ∈ Ideal.map (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)}))
      ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W)) ⊔
        Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)), ψ t ∈ 𝔭 := by
    intro t ht
    have hle : (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W)) ⊔
        Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W) ≤
        Ideal.comap (ψ.comp (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)}))) 𝔭 := by
      apply sup_le
      · rw [Ideal.span_le]
        intro x hx
        rcases hx with rfl | rfl
        · show ψ (wcEbntX W g 0) ∈ 𝔭
          rw [hψ0]; exact hu𝔭
        · show ψ (wcEbntX W g 1) ∈ 𝔭
          rw [hψ1]; exact hv𝔭
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        show ψ (Ideal.Quotient.mk _ (MvPolynomial.C w)) ∈ 𝔭
        rw [hψC]; exact hm𝔭 (Ideal.mem_map_of_mem _ hw)
    have h2 : Ideal.map (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)}))
        ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W)) ⊔
          Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) ≤ Ideal.comap ψ 𝔭 :=
      Ideal.map_le_iff_le_comap.mpr (by rw [Ideal.comap_comap]; exact hle)
    exact h2 ht
  have hD : ∀ p : MvPolynomial (Fin 2) ↥W, p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈
      (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W)) := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a => simp
    | add p q hp hq =>
      have e : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
          (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
            (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
        rw [map_add, map_add]; ring
      rw [e]; exact Ideal.add_mem _ hp hq
    | mul_X p i _ =>
      rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero, sub_zero]
      apply Ideal.mul_mem_left
      apply Ideal.subset_span
      fin_cases i <;> simp
  have hs1 : ∀ t : wcEbntN W g, ψ t ∈ 𝔭 ↔ t ∈ Ideal.map (Ideal.Quotient.mk
      (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g :
        MvPolynomial (Fin 2) ↥W)}))
      ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W)) ⊔
        Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) := by
    intro t
    refine ⟨fun ht => ?_, hJ t⟩
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective t
    have h1 : Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)})
        (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) ∈ Ideal.map (Ideal.Quotient.mk
        (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g :
          MvPolynomial (Fin 2) ↥W)}))
        ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W)) ⊔
          Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) :=
      Ideal.mem_map_of_mem _ (Ideal.mem_sup_left (hD p))
    have h2 : algebraMap ↥W A (MvPolynomial.constantCoeff p) ∈ 𝔭 := by
      rw [← hψC]
      have := 𝔭.sub_mem ht (hJ _ h1)
      rwa [← map_sub, ← map_sub, sub_sub_cancel] at this
    have h3 : Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)})
        (MvPolynomial.C (MvPolynomial.constantCoeff p)) ∈ Ideal.map (Ideal.Quotient.mk
        (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g :
          MvPolynomial (Fin 2) ↥W)}))
        ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W)) ⊔
          Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) :=
      Ideal.mem_map_of_mem _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ (hunitW _ h2)))
    have := Ideal.add_mem _ h1 h3
    rwa [← map_add, sub_add_cancel] at this
  have hN10 : (wcEbntX W g 0 : wcEbntN W g) ∈ Ideal.map (Ideal.Quotient.mk
      (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g :
        MvPolynomial (Fin 2) ↥W)}))
      ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W)) ⊔
        Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) :=
    Ideal.mem_map_of_mem _ (Ideal.mem_sup_left (Ideal.subset_span (by simp)))
  have hN11 : (wcEbntX W g 1 : wcEbntN W g) ∈ Ideal.map (Ideal.Quotient.mk
      (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g :
        MvPolynomial (Fin 2) ↥W)}))
      ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W)) ⊔
        Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) :=
    Ideal.mem_map_of_mem _ (Ideal.mem_sup_left (Ideal.subset_span (by simp)))
  have hN2 : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, Ideal.Quotient.mk
      (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g :
        MvPolynomial (Fin 2) ↥W)}) (MvPolynomial.C w) ∈ Ideal.map (Ideal.Quotient.mk
      (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g :
        MvPolynomial (Fin 2) ↥W)}))
      ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W)) ⊔
        Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) := fun w hw =>
    Ideal.mem_map_of_mem _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw))

  refine ⟨φ.comp ψ, ?_, by rw [RingHom.comp_apply, hψ0], by rw [RingHom.comp_apply, hψ1]⟩
  obtain ⟨nI, hnI⟩ : ∃ nI : Ideal (wcEbntN W g), nI = Ideal.map (Ideal.Quotient.mk
      (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g :
        MvPolynomial (Fin 2) ↥W)}))
      ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W)) ⊔
        Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) := ⟨_, rfl⟩
  rw [← hnI] at hs1 hN10 hN11 hN2
  have key : @wcNdIsHens (wcEbntN W g) _ nI Q _ (φ.comp ψ) := by
    unfold wcNdIsHens
    refine ⟨hH1, fun t => ?_, ?_⟩
    · rw [RingHom.comp_apply, hH2, hs1]
    intro B _ hB γ hγ
    haveI := hB
    have hL : ∀ t ∈ nI, IsLocalRing.residue B (γ t) = 0 := by
      intro t ht
      rw [IsLocalRing.residue_eq_zero_iff]
      exact (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr fun hu => (hγ t).mp hu ht)

    let θ : ↥W →+* IsLocalRing.ResidueField B := (IsLocalRing.residue B).comp
      (γ.comp ((Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)})).comp MvPolynomial.C))
    let κ : ↥W →+* A ⧸ 𝔭 := (Ideal.Quotient.mk 𝔭).comp (algebraMap ↥W A)
    have hκ : Function.Surjective κ := by
      intro x
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨w, hw⟩ := hres a
      exact ⟨w, (Ideal.Quotient.eq.mpr hw).symm⟩
    have hθκ : ∀ w ∈ RingHom.ker κ, θ w = 0 := by
      intro w hw
      have h1 : algebraMap ↥W A w ∈ 𝔭 := Ideal.Quotient.eq_zero_iff_mem.mp (RingHom.mem_ker.mp hw)
      exact hL _ (hN2 w (hunitW w h1))
    let e := RingHom.quotientKerEquivOfSurjective hκ
    let θb : ↥W ⧸ RingHom.ker κ →+* IsLocalRing.ResidueField B :=
      Ideal.Quotient.lift (RingHom.ker κ) θ hθκ
    let r : A →+* IsLocalRing.ResidueField B :=
      θb.comp (e.symm.toRingHom.comp (Ideal.Quotient.mk 𝔭))
    have hrι : ∀ w : ↥W, r (algebraMap ↥W A w) = θ w := by
      intro w
      have h1 : e.symm (Ideal.Quotient.mk 𝔭 (algebraMap ↥W A w)) = Ideal.Quotient.mk _ w := by
        rw [RingEquiv.symm_apply_eq]
        exact (RingHom.quotientKerEquivOfSurjective_apply_mk hκ w).symm
      show θb (e.symm (Ideal.Quotient.mk 𝔭 (algebraMap ↥W A w))) = θ w
      rw [h1]
      exact Ideal.Quotient.lift_mk _ _ _
    have hr0 : ∀ a ∈ 𝔭, r a = 0 := by
      intro a ha
      show θb (e.symm (Ideal.Quotient.mk 𝔭 a)) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha, map_zero, map_zero]
    have hr : ∀ a : A, r a = 0 ↔ a ∈ 𝔭 := by
      intro a
      refine ⟨fun h => ?_, hr0 a⟩
      by_contra ha
      obtain ⟨y, i, hi, hyi⟩ := h𝔭max.exists_inv ha
      have := congrArg r hyi
      rw [map_add, map_mul, h, mul_zero, hr0 i hi, zero_add, map_one] at this
      exact zero_ne_one this
    have hrψ : r.comp ψ = (IsLocalRing.residue B).comp γ := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro w
        simp only [RingHom.comp_apply]
        rw [hψC, hrι]
        rfl
      · refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
        · show r (ψ (wcEbntX W g 0)) = IsLocalRing.residue B (γ (wcEbntX W g 0))
          rw [hψ0, hr0 u hu𝔭, hL _ hN10]
        · show r (ψ (wcEbntX W g 1)) = IsLocalRing.residue B (γ (wcEbntX W g 1))
          rw [hψ1, hr0 v hv𝔭, hL _ hN11]

    have hrh : IsUnit (r h₀) := IsUnit.mk0 _ (fun h => hh₀ ((hr h₀).mp h))
    let ϱ : Localization.Away h₀ →+* IsLocalRing.ResidueField B :=
      IsLocalization.Away.lift h₀ hrh
    have hϱ : ∀ a : A, ϱ (algebraMap A (Localization.Away h₀) a) = r a := fun a =>
      IsLocalization.Away.lift_eq h₀ hrh a
    have hσ : ϱ.comp χ = (IsLocalRing.residue B).comp γ := by
      refine RingHom.ext fun t => ?_
      show ϱ (χ t) = IsLocalRing.residue B (γ t)
      rw [hχψ, RingHom.comp_apply, hϱ]
      exact RingHom.congr_fun hrψ t
    obtain ⟨τ, hτχ, hτ⟩ := @s3 (wcEbntN W g) (Localization.Away h₀) B inferInstance
      inferInstance inferInstance inferInstance χ γ ϱ hχet hσ
    let gA : A →+* B := τ.comp (algebraMap A (Localization.Away h₀))
    have hgAψ : gA.comp ψ = γ := by
      refine RingHom.ext fun t => ?_
      show τ (algebraMap A (Localization.Away h₀) (ψ t)) = γ t
      rw [← RingHom.comp_apply (algebraMap A (Localization.Away h₀)) ψ, ← hχψ]
      exact RingHom.congr_fun hτχ t
    have hgAu : ∀ a : A, IsUnit (gA a) ↔ a ∉ 𝔭 := by
      intro a
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
      show IsLocalRing.residue B (τ (algebraMap A (Localization.Away h₀) a)) ≠ 0 ↔ _
      rw [hτ, hϱ]
      exact (hr a).not
    obtain ⟨h, ⟨hhφ, hloc⟩, hhuniq⟩ := hH3 B hB gA hgAu
    refine ⟨h, ⟨?_, hloc⟩, ?_⟩
    · rw [← RingHom.comp_assoc, hhφ, hgAψ]

    rintro h' ⟨hh', hl'⟩
    haveI := hl'
    apply hhuniq h'
    refine ⟨?_, hl'⟩
    have hg1ψ : (h'.comp φ).comp ψ = γ := by rw [RingHom.comp_assoc]; exact hh'
    have hg1u : ∀ a, IsUnit ((h'.comp φ) a) ↔ a ∉ 𝔭 := fun a => by
      rw [RingHom.comp_apply, isUnit_map_iff]; exact hH2 a
    have hresid : ∀ g' : A →+* B, g'.comp ψ = γ → (∀ a, IsUnit (g' a) ↔ a ∉ 𝔭) →
        ∀ (a : A) (w : ↥W), a - algebraMap ↥W A w ∈ 𝔭 →
        IsLocalRing.residue B (g' a) = IsLocalRing.residue B (γ (Ideal.Quotient.mk
          (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g :
            MvPolynomial (Fin 2) ↥W)}) (MvPolynomial.C w))) := by
      intro g' hg' hu a w hw
      have h1 : IsLocalRing.residue B (g' (a - algebraMap ↥W A w)) = 0 := by
        rw [IsLocalRing.residue_eq_zero_iff]
        exact (IsLocalRing.mem_maximalIdeal _).mpr
          (mem_nonunits_iff.mpr fun hh => (hu _).mp hh hw)
      rw [map_sub, map_sub, sub_eq_zero, ← hψC, ← RingHom.comp_apply g' ψ, hg'] at h1
      exact h1
    have hu1 : IsUnit ((h'.comp φ) h₀) := (hg1u h₀).mpr hh₀
    let τ1' : Localization.Away h₀ →+* B := IsLocalization.Away.lift h₀ hu1
    have hτ1' : ∀ a : A, τ1' (algebraMap A (Localization.Away h₀) a) = (h'.comp φ) a :=
      fun a => IsLocalization.Away.lift_eq h₀ hu1 a
    have hτ1χ : τ1'.comp χ = τ.comp χ := by
      rw [hτχ]
      refine RingHom.ext fun t => ?_
      show τ1' (χ t) = γ t
      rw [hχψ, RingHom.comp_apply, hτ1']
      exact RingHom.congr_fun hg1ψ t
    have hres2 : (IsLocalRing.residue B).comp τ1' =
        (IsLocalRing.residue B).comp τ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers h₀)
      refine RingHom.ext fun a => ?_
      obtain ⟨w, hw⟩ := hres a
      show IsLocalRing.residue B (τ1' (algebraMap A (Localization.Away h₀) a)) =
        IsLocalRing.residue B (gA a)
      rw [hτ1', hresid _ hg1ψ hg1u a w hw, hresid gA hgAψ hgAu a w hw]
    have heq : τ1' = τ := @s4 (wcEbntN W g) (Localization.Away h₀) B inferInstance
      inferInstance inferInstance inferInstance χ τ1' τ hχet hτ1χ
      (fun x => RingHom.congr_fun hres2 x)
    refine RingHom.ext fun a => ?_
    calc (h'.comp φ) a = τ1' (algebraMap A (Localization.Away h₀) a) := (hτ1' a).symm
      _ = τ (algebraMap A (Localization.Away h₀) a) := by rw [heq]
  rw [hnI] at key
  unfold wcEbntPres
  refine ⟨hg, hg0, ?_, key⟩
  refine RingHom.ext fun w => ?_
  simp only [RingHom.comp_apply]
  rw [hψC]

theorem wcpa_dj_llsm_kpta_tube_factor : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) → ∀ ℓ : ℕ, ℓ.Prime → ∀ f : A, f ≠ 0 →
    (∀ P : Ideal A, P.IsPrime → P ≠ ⊥ → P ≤ 𝔭 → (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) →
      ∃ (F : K) (a s : A), a ∉ P ∧ s ∉ P ∧
        algebraMap A K f * algebraMap A K s = F ^ ℓ * algebraMap A K a) →
    ∃ e : ℕ, e < ℓ ∧ ∃ (F : K) (a s : A), a ∉ 𝔭 ∧ s ∉ 𝔭 ∧
      algebraMap A K f * algebraMap A K s = algebraMap A K u ^ e * F ^ ℓ * algebraMap A K a :=
by
  classical
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 u v g hPD ℓ hℓ f hf0 hH
  have hPD' := hPD
  obtain ⟨hFT, htf, -, h𝔭max, hm𝔭, hg, hg0, huv, -⟩ := hPD'
  have h𝔭 : 𝔭.IsPrime := h𝔭max.isPrime
  have hinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hWinj : ∀ x : ↥W, x ≠ 0 → algebraMap ↥W A x ≠ 0 := by
    intro x hx h
    rw [Algebra.algebraMap_eq_smul_one] at h
    rcases smul_eq_zero.mp h with h | h
    · exact hx h
    · exact one_ne_zero h
  have hjW : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 :=
    fun x hx => (map_ne_zero_iff _ hinj).mpr (hWinj x hx)
  have hu0 : u ≠ 0 := by
    rintro rfl
    rw [zero_mul] at huv
    exact hWinj g hg0 huv.symm
  have huK : algebraMap A K u ≠ 0 := (map_ne_zero_iff _ hinj).mpr hu0
  have hfK : algebraMap A K f ≠ 0 := (map_ne_zero_iff _ hinj).mpr hf0

  have U_of : ∀ P : Ideal A, P.IsPrime → ∀ t : A, t ∉ P →
      ∃ a s : A, a ∉ P ∧ s ∉ P ∧ algebraMap A K t * algebraMap A K s = algebraMap A K a := by
    intro P hP t ht
    refine ⟨t, 1, ht, fun h => hP.ne_top ((Ideal.eq_top_iff_one P).mpr h), ?_⟩
    rw [map_one, mul_one]
  have U_mul : ∀ P : Ideal A, P.IsPrime → ∀ x y : K,
      (∃ a s : A, a ∉ P ∧ s ∉ P ∧ x * algebraMap A K s = algebraMap A K a) →
      (∃ a s : A, a ∉ P ∧ s ∉ P ∧ y * algebraMap A K s = algebraMap A K a) →
      ∃ a s : A, a ∉ P ∧ s ∉ P ∧ (x * y) * algebraMap A K s = algebraMap A K a := by
    intro P hP x y ⟨a, s, ha, hs, hx⟩ ⟨a', s', ha', hs', hy⟩
    refine ⟨a * a', s * s', fun h => (hP.mem_or_mem h).elim ha ha',
      fun h => (hP.mem_or_mem h).elim hs hs', ?_⟩
    rw [map_mul, map_mul, ← hx, ← hy]; ring
  have U_inv : ∀ P : Ideal A, P.IsPrime → ∀ x : K,
      (∃ a s : A, a ∉ P ∧ s ∉ P ∧ x * algebraMap A K s = algebraMap A K a) →
      ∃ a s : A, a ∉ P ∧ s ∉ P ∧ x⁻¹ * algebraMap A K s = algebraMap A K a := by
    intro P hP x ⟨a, s, ha, hs, hx⟩
    have hx0 : x ≠ 0 := by
      rintro rfl
      rw [zero_mul] at hx
      exact ha (by rw [hinj (hx.symm.trans (map_zero _).symm)]; exact P.zero_mem)
    refine ⟨s, a, hs, ha, ?_⟩
    rw [← hx, ← mul_assoc, inv_mul_cancel₀ hx0, one_mul]
  have U_one : ∀ P : Ideal A, P.IsPrime →
      ∃ a s : A, a ∉ P ∧ s ∉ P ∧ (1 : K) * algebraMap A K s = algebraMap A K a := by
    intro P hP
    obtain ⟨a, s, ha, hs, h⟩ := U_of P hP 1 (fun h => hP.ne_top ((Ideal.eq_top_iff_one P).mpr h))
    exact ⟨a, s, ha, hs, by rw [map_one] at h; exact h⟩
  have U_pow : ∀ P : Ideal A, P.IsPrime → ∀ x : K,
      (∃ a s : A, a ∉ P ∧ s ∉ P ∧ x * algebraMap A K s = algebraMap A K a) →
      ∀ n : ℕ, ∃ a s : A, a ∉ P ∧ s ∉ P ∧ x ^ n * algebraMap A K s = algebraMap A K a := by
    intro P hP x hx n
    induction n with
    | zero => rw [pow_zero]; exact U_one P hP
    | succ n ih =>
      rw [pow_succ]
      exact U_mul P hP _ _ ih hx
  have U_zpow : ∀ P : Ideal A, P.IsPrime → ∀ x : K,
      (∃ a s : A, a ∉ P ∧ s ∉ P ∧ x * algebraMap A K s = algebraMap A K a) →
      ∀ n : ℤ, ∃ a s : A, a ∉ P ∧ s ∉ P ∧ x ^ n * algebraMap A K s = algebraMap A K a := by
    intro P hP x hx n
    obtain ⟨m, rfl | rfl⟩ := Int.eq_nat_or_neg n
    · rw [zpow_natCast]; exact U_pow P hP x hx m
    · rw [zpow_neg, zpow_natCast]; exact U_inv P hP _ (U_pow P hP x hx m)

  have hpos : ∀ P : Ideal A, P.IsPrime → P ≠ ⊥ → P ≤ 𝔭 →
      (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) →
      ∀ c d : ↥W, c * d = g → u - algebraMap ↥W A c ∈ P → v - algebraMap ↥W A d ∈ P →
      ∀ y ∈ P, y ≠ 0 → ∃ (k : ℕ) (a s : A), a ∉ P ∧ s ∉ P ∧
        y * s = (u - algebraMap ↥W A c) ^ (k + 1) * a := by
    intro P hP hP0 hP𝔭 hPW c d hcd hc hd y hy hy0
    have hyK : algebraMap A K y ≠ 0 := (map_ne_zero_iff _ hinj).mpr hy0
    obtain ⟨n, a, s, ha, hs, he⟩ := wcpa_dj_llsm_kptf_tube_dvr Ω W hW hWt A K 𝔭 u v g hPD
      P hP hP0 hP𝔭 hPW c d hcd hc hd (algebraMap A K y) hyK
    have hs0 : s ≠ 0 := fun h => hs (h ▸ P.zero_mem)
    have hsK : algebraMap A K s ≠ 0 := (map_ne_zero_iff _ hinj).mpr hs0
    have hnat : ∀ m : ℕ, algebraMap A K y * algebraMap A K s =
        algebraMap A K (u - algebraMap ↥W A c) ^ m * algebraMap A K a →
        ∃ (k : ℕ) (a s : A), a ∉ P ∧ s ∉ P ∧ y * s = (u - algebraMap ↥W A c) ^ (k + 1) * a := by
      intro m hm
      have he' : y * s = (u - algebraMap ↥W A c) ^ m * a := by
        apply hinj; rw [map_mul, map_mul, map_pow]; exact hm
      rcases m with _ | k
      · rw [pow_zero, one_mul] at he'
        exact (ha (by rw [← he']; exact P.mul_mem_right s hy)).elim
      · exact ⟨k, a, s, ha, hs, he'⟩
    obtain ⟨m, rfl | rfl⟩ := Int.eq_nat_or_neg n
    · rw [zpow_natCast] at he; exact hnat m he
    · rcases m with _ | k
      · rw [Nat.cast_zero, neg_zero, zpow_zero] at he
        exact hnat 0 (by rw [pow_zero]; exact he)
      · exfalso
        by_cases ht : algebraMap A K (u - algebraMap ↥W A c) = 0
        · rw [ht, zero_zpow _ (by omega), zero_mul] at he
          exact mul_ne_zero hyK hsK he
        · have h2 : algebraMap A K (y * s * (u - algebraMap ↥W A c) ^ (k + 1)) =
              algebraMap A K a := by
            rw [map_mul, map_mul, map_pow, he, zpow_neg, zpow_natCast, mul_comm, ← mul_assoc,
              mul_inv_cancel₀ (pow_ne_zero _ ht), one_mul]
          rw [← hinj h2] at ha
          exact ha (P.mul_mem_right _ (P.mul_mem_right _ hy))

  have hsep : ∀ P P0 : Ideal A, P.IsPrime → P ≠ ⊥ → P ≤ 𝔭 →
      (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) →
      P0.IsPrime → P0 ≤ 𝔭 → (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P0) →
      ∀ c0 d0 : ↥W, c0 * d0 = g → u - algebraMap ↥W A c0 ∈ P0 → v - algebraMap ↥W A d0 ∈ P0 →
      u - algebraMap ↥W A c0 ∈ P → P = P0 := by
    intro P P0 hP hP0 hP𝔭 hPW hQ hQ𝔭 hQW c0 d0 hcd0 hcu0 hdv0 hc0P
    obtain ⟨c, d, -, -, hcd, hc, hd⟩ := wcpa_dj_llsm_kptf_tube_center Ω W hW hWt A K 𝔭 u v g hPD
      P hP hP0 hP𝔭 hPW
    have hcc : c = c0 := by
      by_contra hne
      apply hPW (c0 - c) (sub_ne_zero.mpr (Ne.symm hne))
      have : algebraMap ↥W A (c0 - c) = (u - algebraMap ↥W A c) - (u - algebraMap ↥W A c0) := by
        rw [map_sub]; ring
      rw [this]
      exact P.sub_mem hc hc0P
    have hc0 : c0 ≠ 0 := by
      rintro rfl
      rw [zero_mul] at hcd0
      exact hg0 hcd0.symm
    rw [hcc] at hcd hc
    have hdd : d = d0 := mul_left_cancel₀ hc0 (hcd.trans hcd0.symm)
    rw [hdd] at hd
    exact wcpa_dj_llsm_kptf_tube_unique Ω W hW hWt A K 𝔭 u v g hPD P P0 hP hQ hP𝔭 hQ𝔭 hPW hQW
      c0 d0 hcd0 hc hd hcu0 hdv0

  have htne : ∀ P : Ideal A, P.IsPrime → P ≠ ⊥ → P ≤ 𝔭 →
      (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) →
      ∀ c d : ↥W, c * d = g → u - algebraMap ↥W A c ∈ P → v - algebraMap ↥W A d ∈ P →
      algebraMap A K (u - algebraMap ↥W A c) ≠ 0 := by
    intro P hP hP0 hP𝔭 hPW c d hcd hc hd ht
    obtain ⟨z, hz, hz0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hP0
    obtain ⟨k, a, s, ha, hs, he⟩ := hpos P hP hP0 hP𝔭 hPW c d hcd hc hd z hz hz0
    have ht' : u - algebraMap ↥W A c = 0 := hinj (ht.trans (map_zero _).symm)
    rw [ht', zero_pow (Nat.succ_ne_zero k), zero_mul] at he
    have hs0 : s ≠ 0 := fun h => hs (h ▸ P.zero_mem)
    exact mul_ne_zero hz0 hs0 he

  have hchain : ∀ P : Ideal A, P.IsPrime → P ≠ ⊥ → P ≤ 𝔭 →
      (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) →
      ∀ Q : Ideal A, Q.IsPrime → Q ≠ ⊥ → Q ≤ P → Q = P := by
    intro P hP hP0 hP𝔭 hPW Q hQ hQ0 hQP
    obtain ⟨c, d, -, -, hcd, hc, hd⟩ := wcpa_dj_llsm_kptf_tube_center Ω W hW hWt A K 𝔭 u v g hPD
      P hP hP0 hP𝔭 hPW
    obtain ⟨y, hy, hy0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hQ0
    obtain ⟨k, a, s, ha, hs, he⟩ := hpos P hP hP0 hP𝔭 hPW c d hcd hc hd y (hQP hy) hy0
    have htQ : u - algebraMap ↥W A c ∈ Q := by
      have h1 : (u - algebraMap ↥W A c) ^ (k + 1) * a ∈ Q := by
        rw [← he]; exact Q.mul_mem_right s hy
      rcases hQ.mem_or_mem h1 with h | h
      · exact hQ.mem_of_pow_mem _ h
      · exact absurd (hQP h) ha
    apply le_antisymm hQP
    intro z hz
    by_cases hz0 : z = 0
    · rw [hz0]; exact Q.zero_mem
    obtain ⟨k', a', s', ha', hs', he'⟩ := hpos P hP hP0 hP𝔭 hPW c d hcd hc hd z hz hz0
    have h1 : z * s' ∈ Q := by
      rw [he']; exact Q.mul_mem_right a' (Q.pow_mem_of_mem htQ _ (Nat.succ_pos k'))
    rcases hQ.mem_or_mem h1 with h | h
    · exact h
    · exact absurd (hQP h) hs'
  have hfin := wcpa_dj_llsm_kptf_tube_finite Ω W hW hWt A K 𝔭 u v g hPD f hf0 hchain

  have hind : ∀ S : Finset (Ideal A), (∀ P ∈ S, P.IsPrime ∧ P ≠ ⊥ ∧ P ≤ 𝔭 ∧
      (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) ∧ f ∈ P) →
      ∃ G : K, G ≠ 0 ∧
        (∀ P ∈ S, ∃ a s : A, a ∉ P ∧ s ∉ P ∧
          algebraMap A K f / G ^ ℓ * algebraMap A K s = algebraMap A K a) ∧
        ∀ P : Ideal A, P.IsPrime → P ≠ ⊥ → P ≤ 𝔭 → (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) →
          P ∉ S → ∃ a s : A, a ∉ P ∧ s ∉ P ∧ G * algebraMap A K s = algebraMap A K a := by
    intro S
    induction S using Finset.induction_on with
    | empty =>
      intro _
      refine ⟨1, one_ne_zero, fun P hP => by simp at hP, ?_⟩
      intro P hP _ _ _ _
      exact U_one P hP
    | insert P0 S hP0S ih =>
      intro hS
      obtain ⟨G, hG0, hGS, hGout⟩ := ih (fun P hP => hS P (Finset.mem_insert_of_mem hP))
      obtain ⟨hP0, hP00, hP0𝔭, hP0W, -⟩ := hS P0 (Finset.mem_insert_self P0 S)
      obtain ⟨c0, d0, -, -, hcd0, hcu0, hdv0⟩ :=
        wcpa_dj_llsm_kptf_tube_center Ω W hW hWt A K 𝔭 u v g hPD P0 hP0 hP00 hP0𝔭 hP0W
      have ht0 := htne P0 hP0 hP00 hP0𝔭 hP0W c0 d0 hcd0 hcu0 hdv0
      obtain ⟨F, a, s, ha, hs, hfe⟩ := hH P0 hP0 hP00 hP0𝔭 hP0W
      have hs0 : s ≠ 0 := fun h => hs (h ▸ P0.zero_mem)
      have hF0 : F ≠ 0 := by
        rintro rfl
        rw [zero_pow hℓ.ne_zero, zero_mul] at hfe
        exact mul_ne_zero hfK ((map_ne_zero_iff _ hinj).mpr hs0) hfe
      obtain ⟨n, a', s', ha', hs', hye⟩ := wcpa_dj_llsm_kptf_tube_dvr Ω W hW hWt A K 𝔭 u v g hPD
        P0 hP0 hP00 hP0𝔭 hP0W c0 d0 hcd0 hcu0 hdv0 (F / G) (div_ne_zero hF0 hG0)
      have htn0 : algebraMap A K (u - algebraMap ↥W A c0) ^ n ≠ 0 := zpow_ne_zero _ ht0
      have htP : ∀ P : Ideal A, P.IsPrime → P ≠ ⊥ → P ≤ 𝔭 →
          (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) → P ≠ P0 →
          ∃ a s : A, a ∉ P ∧ s ∉ P ∧
            algebraMap A K (u - algebraMap ↥W A c0) ^ n * algebraMap A K s = algebraMap A K a := by
        intro P hP hP0' hP𝔭 hPW hne
        apply U_zpow P hP
        apply U_of P hP
        intro hmem
        exact hne (hsep P P0 hP hP0' hP𝔭 hPW hP0 hP0𝔭 hP0W c0 d0 hcd0 hcu0 hdv0 hmem)
      refine ⟨G * algebraMap A K (u - algebraMap ↥W A c0) ^ n, mul_ne_zero hG0 htn0, ?_, ?_⟩
      · intro P hP
        rcases Finset.mem_insert.mp hP with hPe | hPS
        · rw [hPe]
          have h1 : ∃ a s : A, a ∉ P0 ∧ s ∉ P0 ∧
              algebraMap A K f / F ^ ℓ * algebraMap A K s = algebraMap A K a :=
            ⟨a, s, ha, hs, by
              rw [div_mul_eq_mul_div, hfe, mul_div_cancel_left₀ _ (pow_ne_zero _ hF0)]⟩
          have h2 : ∃ a s : A, a ∉ P0 ∧ s ∉ P0 ∧
              F / G / algebraMap A K (u - algebraMap ↥W A c0) ^ n * algebraMap A K s =
                algebraMap A K a :=
            ⟨a', s', ha', hs', by rw [div_mul_eq_mul_div, hye, mul_div_cancel_left₀ _ htn0]⟩
          obtain ⟨a'', s'', h1', h2', h3'⟩ := U_mul P0 hP0 _ _ h1 (U_pow P0 hP0 _ h2 ℓ)
          refine ⟨a'', s'', h1', h2', ?_⟩
          rw [← h3']
          congr 1
          rw [div_div, div_pow, div_mul_div_comm, mul_comm (F ^ ℓ), mul_div_mul_right _ _
            (pow_ne_zero _ hF0)]
        · obtain ⟨hP', hP0', hP𝔭', hPW', -⟩ := hS P (Finset.mem_insert_of_mem hPS)
          have hne : P ≠ P0 := fun h => hP0S (h ▸ hPS)
          obtain ⟨a'', s'', h1', h2', h3'⟩ := U_mul P hP' _ _ (hGS P hPS)
            (U_inv P hP' _ (U_pow P hP' _ (htP P hP' hP0' hP𝔭' hPW' hne) ℓ))
          refine ⟨a'', s'', h1', h2', ?_⟩
          rw [← h3']
          congr 1
          rw [mul_pow, ← div_div, div_eq_mul_inv _ (_ ^ ℓ)]
      · intro P hP hP0' hP𝔭 hPW hPn
        have hne : P ≠ P0 := fun h => hPn (h ▸ Finset.mem_insert_self P0 S)
        have hPS : P ∉ S := fun h => hPn (Finset.mem_insert_of_mem h)
        exact U_mul P hP _ _ (hGout P hP hP0' hP𝔭 hPW hPS) (htP P hP hP0' hP𝔭 hPW hne)
  obtain ⟨G, hG0, hGT, hGout⟩ := hind hfin.toFinset (fun P hP => hfin.mem_toFinset.mp hP)
  have hx : ∀ P : Ideal A, P.IsPrime → P ≠ ⊥ → P ≤ 𝔭 →
      (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) →
      ∃ a s : A, a ∉ P ∧ s ∉ P ∧
        algebraMap A K f / G ^ ℓ * algebraMap A K s = algebraMap A K a := by
    intro P hP hP0 hP𝔭 hPW
    by_cases hPT : P ∈ hfin.toFinset
    · exact hGT P hPT
    · have hfP : f ∉ P := by
        intro h
        apply hPT
        rw [Set.Finite.mem_toFinset, Set.mem_setOf_eq]
        exact ⟨hP, hP0, hP𝔭, hPW, h⟩
      have := U_mul P hP _ _ (U_of P hP f hfP)
        (U_inv P hP _ (U_pow P hP _ (hGout P hP hP0 hP𝔭 hPW hPT) ℓ))
      simpa only [div_eq_mul_inv] using this
  have hx0 : algebraMap A K f / G ^ ℓ ≠ 0 := div_ne_zero hfK (pow_ne_zero _ hG0)
  obtain ⟨a, s, a', s', w, w', hw, hw', hs, hs', hxa, haa'⟩ :=
    wcpa_dj_llsm_kptf_local_global_unit Ω W hW hWt A K 𝔭 u v g hPD _ hx0 hx
  have hs'0 : s' ≠ 0 := fun h => hs' (h ▸ 𝔭.zero_mem)
  have ha0 : a ≠ 0 := by
    rintro rfl
    rw [zero_mul] at haa'
    exact mul_ne_zero (hWinj w' hw') hs'0 haa'.symm
  have hres := wcpa_dj_llsm_kptf_residue_trivial Ω W A 𝔭 hFT h𝔭max hm𝔭
  obtain ⟨Q, _, φ, hφ, hdesc⟩ := wcpa_dj_llsm_kptf_hens_descent A 𝔭 h𝔭
  obtain ⟨fN, hPres, hfu, hfv⟩ := wcpa_dj_llsm_kptf_hens_chart Ω W A 𝔭 u v g hPD hres Q φ hφ
  have hφ' := hφ
  obtain ⟨-, hφunit, -⟩ := hφ'
  obtain ⟨μ, hμ⟩ := (hφunit s').mpr hs'
  have hprod : φ a * (φ a' * ↑μ⁻¹) = (φ.comp (algebraMap ↥W A)) w' := by
    rw [RingHom.comp_apply]
    calc φ a * (φ a' * ↑μ⁻¹) = φ (a * a') * ↑μ⁻¹ := by rw [map_mul]; ring
      _ = φ (algebraMap ↥W A w') * (↑μ * ↑μ⁻¹) := by rw [haa', map_mul, hμ]; ring
      _ = φ (algebraMap ↥W A w') := by rw [Units.mul_inv, mul_one]
  obtain ⟨α, n, η, hα0, hη, hcase⟩ := wcpa_dj_lr1k_ebnt_dominant_monomial Ω W hW hWt Q
    (φ.comp (algebraMap ↥W A)) g fN hPres (φ a) (φ a' * ↑μ⁻¹) w' hw' hprod
  rw [hfu, hfv, RingHom.comp_apply] at hcase

  have hdesc2 : ∀ z : A, φ a = η * φ (algebraMap ↥W A α) * φ z ^ n →
      ∃ a1 s1 : A, a1 ∉ 𝔭 ∧ s1 ∉ 𝔭 ∧ a * s1 = (algebraMap ↥W A α * z ^ n) * a1 := by
    intro z hz
    obtain ⟨η', hη'⟩ := hη
    have hq : φ (algebraMap ↥W A α * z ^ n) = φ (algebraMap ↥W A α) * φ z ^ n := by
      rw [map_mul, map_pow]
    have m1 : φ a ∈ Ideal.span {φ (algebraMap ↥W A α * z ^ n)} :=
      Ideal.mem_span_singleton'.mpr ⟨η, by rw [hq, hz]; ring⟩
    have m2 : φ (algebraMap ↥W A α * z ^ n) ∈ Ideal.span {φ a} :=
      Ideal.mem_span_singleton'.mpr ⟨↑η'⁻¹, by
        rw [hq, hz, ← hη', mul_assoc, ← mul_assoc, Units.inv_mul, one_mul]⟩
    obtain ⟨b1, s1, hs1, e1⟩ := hdesc a _ m1
    obtain ⟨b2, s2, hs2, e2⟩ := hdesc _ a m2
    have hkey : a * (s1 * s2 - b1 * b2) = 0 := by linear_combination s2 * e1 + b1 * e2
    have h12 : s1 * s2 = b1 * b2 := sub_eq_zero.mp ((mul_eq_zero.mp hkey).resolve_left ha0)
    refine ⟨b1, s1, fun hb => ?_, hs1, e1⟩
    have : s1 * s2 ∈ 𝔭 := by rw [h12]; exact 𝔭.mul_mem_right b2 hb
    exact (h𝔭.mem_or_mem this).elim hs1 hs2

  have hroot : ∀ x : ↥W, ∃ r : ↥W, r ^ ℓ = x := by
    intro x
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (x : Ω) hℓ.pos
    have hzW : z ∈ W := by
      rcases W.mem_or_inv_mem z with h | h
      · exact h
      · by_cases hz0 : z = 0
        · rw [hz0]; exact zero_mem W
        · obtain ⟨m, hm⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, by have := hℓ.pos; omega⟩
          have hz' : z = (x : Ω) * z⁻¹ ^ m := by
            rw [← hz, hm, pow_succ, inv_pow, mul_comm (z ^ m), mul_assoc,
              mul_inv_cancel₀ (pow_ne_zero _ hz0), mul_one]
          rw [hz']
          exact mul_mem x.2 (pow_mem h m)
    exact ⟨⟨z, hzW⟩, Subtype.ext (by simp [hz])⟩
  obtain ⟨ω, hωw⟩ := hroot w
  obtain ⟨β, hβα⟩ := hroot α
  obtain ⟨γ, hγg⟩ := hroot g
  have hω : algebraMap A K (algebraMap ↥W A ω) ^ ℓ = algebraMap A K (algebraMap ↥W A w) := by
    rw [← map_pow, ← map_pow, hωw]
  have hβ : algebraMap A K (algebraMap ↥W A β) ^ ℓ = algebraMap A K (algebraMap ↥W A α) := by
    rw [← map_pow, ← map_pow, hβα]
  have hγ : algebraMap A K (algebraMap ↥W A γ) ^ ℓ = algebraMap A K (algebraMap ↥W A g) := by
    rw [← map_pow, ← map_pow, hγg]
  have hω0 : algebraMap A K (algebraMap ↥W A ω) ≠ 0 :=
    hjW ω (fun h => hw (by rw [← hωw, h, zero_pow hℓ.ne_zero]))
  have hw0 := hjW w hw
  have huvK : algebraMap A K u * algebraMap A K v = algebraMap A K (algebraMap ↥W A g) := by
    rw [← map_mul, huv]
  have hxa' : algebraMap A K f * algebraMap A K s * algebraMap A K (algebraMap ↥W A w) =
      G ^ ℓ * algebraMap A K a := by
    rw [← hxa, div_mul_eq_mul_div, div_mul_eq_mul_div, mul_div_assoc',
      mul_div_cancel_left₀ _ (pow_ne_zero _ hG0)]
  have hEgen : ∀ (z a1 s1 : A), a * s1 = (algebraMap ↥W A α * z ^ n) * a1 →
      algebraMap A K f * algebraMap A K s * algebraMap A K s1 *
          algebraMap A K (algebraMap ↥W A w) =
        G ^ ℓ * algebraMap A K (algebraMap ↥W A α) * algebraMap A K z ^ n *
          algebraMap A K a1 := by
    intro z a1 s1 e1
    have e1K := congrArg (algebraMap A K) e1
    simp only [map_mul, map_pow] at e1K
    linear_combination algebraMap A K s1 * hxa' + G ^ ℓ * e1K
  have hss : ∀ s1 : A, s1 ∉ 𝔭 → s * s1 ∉ 𝔭 := fun s1 hs1 h => (h𝔭.mem_or_mem h).elim hs hs1
  rcases hcase with hU | hV
  ·
    obtain ⟨a1, s1, ha1, hs1, e1⟩ := hdesc2 u hU
    have E := hEgen u a1 s1 e1
    refine ⟨n % ℓ, Nat.mod_lt _ hℓ.pos,
      G * algebraMap A K (algebraMap ↥W A β) * algebraMap A K u ^ (n / ℓ) /
        algebraMap A K (algebraMap ↥W A ω),
      a1, s * s1, ha1, hss s1 hs1, ?_⟩
    have hF : (G * algebraMap A K (algebraMap ↥W A β) * algebraMap A K u ^ (n / ℓ) /
        algebraMap A K (algebraMap ↥W A ω)) ^ ℓ * algebraMap A K (algebraMap ↥W A w) =
        G ^ ℓ * algebraMap A K (algebraMap ↥W A α) * (algebraMap A K u ^ (n / ℓ)) ^ ℓ := by
      rw [← hω, ← hβ, div_pow, div_mul_cancel₀ _ (pow_ne_zero _ hω0)]
      ring
    have hun : algebraMap A K u ^ n =
        algebraMap A K u ^ (n % ℓ) * (algebraMap A K u ^ (n / ℓ)) ^ ℓ := by
      rw [← pow_mul, ← pow_add, mul_comm (n / ℓ), Nat.mod_add_div]
    apply mul_right_cancel₀ hw0
    rw [map_mul]
    linear_combination E - (algebraMap A K u ^ (n % ℓ) * algebraMap A K a1) * hF +
      (G ^ ℓ * algebraMap A K (algebraMap ↥W A α) * algebraMap A K a1) * hun
  ·
    obtain ⟨a1, s1, ha1, hs1, e1⟩ := hdesc2 v hV
    have E := hEgen v a1 s1 e1
    obtain ⟨e, m, he, hem⟩ : ∃ e m : ℕ, e < ℓ ∧ n + e = ℓ * m := by
      have hr := Nat.mod_lt n hℓ.pos
      have hdm := Nat.div_add_mod n ℓ
      generalize n % ℓ = r at hr hdm
      generalize n / ℓ = k at hdm
      by_cases hr0 : r = 0
      · refine ⟨0, k, hℓ.pos, ?_⟩
        rw [← hdm, hr0]; ring
      · refine ⟨ℓ - r, k + 1, by omega, ?_⟩
        have h1 : r + (ℓ - r) = ℓ := by omega
        rw [← hdm, add_assoc, h1]; ring
    refine ⟨e, he, G * algebraMap A K (algebraMap ↥W A β) * algebraMap A K (algebraMap ↥W A γ) ^ n /
      (algebraMap A K (algebraMap ↥W A ω) * algebraMap A K u ^ m), a1, s * s1, ha1, hss s1 hs1, ?_⟩
    have hD : algebraMap A K (algebraMap ↥W A ω) * algebraMap A K u ^ m ≠ 0 :=
      mul_ne_zero hω0 (pow_ne_zero _ huK)
    have hF : (G * algebraMap A K (algebraMap ↥W A β) * algebraMap A K (algebraMap ↥W A γ) ^ n /
        (algebraMap A K (algebraMap ↥W A ω) * algebraMap A K u ^ m)) ^ ℓ *
        algebraMap A K (algebraMap ↥W A w) * (algebraMap A K u ^ m) ^ ℓ =
        G ^ ℓ * algebraMap A K (algebraMap ↥W A α) * algebraMap A K (algebraMap ↥W A g) ^ n := by
      rw [← hω, ← hβ, ← hγ, div_pow, div_mul_eq_mul_div, div_mul_eq_mul_div,
        div_eq_iff (pow_ne_zero _ hD)]
      ring
    have hpowu : (algebraMap A K u ^ m) ^ ℓ = algebraMap A K u ^ n * algebraMap A K u ^ e := by
      rw [← pow_mul, mul_comm m ℓ, ← hem, pow_add]
    have hgn : algebraMap A K (algebraMap ↥W A g) ^ n =
        algebraMap A K u ^ n * algebraMap A K v ^ n := by
      rw [← huvK, mul_pow]
    apply mul_right_cancel₀ (mul_ne_zero hw0 (pow_ne_zero ℓ (pow_ne_zero m huK)))
    rw [map_mul]
    linear_combination (algebraMap A K u ^ m) ^ ℓ * E -
      (algebraMap A K u ^ e * algebraMap A K a1) * hF +
      (G ^ ℓ * algebraMap A K (algebraMap ↥W A α) * algebraMap A K v ^ n * algebraMap A K a1) *
        hpowu -
      (algebraMap A K u ^ e * algebraMap A K a1 * G ^ ℓ * algebraMap A K (algebraMap ↥W A α)) *
        hgn

theorem wcpa_dj_llsm_kpkn_constants : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (ℓ : ℕ), ℓ.Prime → ringChar (IsLocalRing.ResidueField ↥W) ≠ ℓ →
    ∀ g : ↥W, g ∈ IsLocalRing.maximalIdeal ↥W → g ≠ 0 →
    IsUnit ((ℓ : ℕ) : ↥W) ∧ (∃ ζ : ↥W, IsPrimitiveRoot ζ ℓ) ∧
    ∃ h : ↥W, h ^ ℓ = g ∧ h ∈ IsLocalRing.maximalIdeal ↥W ∧ h ≠ 0 ∧
      ∀ i : ℕ, 1 ≤ i → i < ℓ → h ^ i ∣ g ∧ ¬ g ∣ h ^ i :=
by
  intro Ω _ _ W ℓ hℓ hchar g hgm hg0
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero
  have hℓpos : 0 < ℓ := hℓ.pos
  have s1 : IsUnit ((ℓ : ℕ) : ↥W) := by
    rw [← IsLocalRing.notMem_maximalIdeal]
    intro hmem
    have h1 : (IsLocalRing.residue ↥W) ((ℓ : ℕ) : ↥W) = 0 :=
      (IsLocalRing.residue_eq_zero_iff _).mpr hmem
    rw [map_natCast] at h1
    have h2 : ringChar (IsLocalRing.ResidueField ↥W) ∣ ℓ := ringChar.dvd h1
    rcases (Nat.Prime.eq_one_or_self_of_dvd hℓ _ h2) with h3 | h3
    · exact CharP.ringChar_ne_one h3
    · exact hchar h3
  have V2 : ∀ (x : Ω) (n : ℕ), 0 < n → ∀ w : ↥W, x ^ n = (w : Ω) → x ∈ W := by
    intro x n hn w hx
    rcases W.mem_or_inv_mem x with h | h
    · exact h
    · by_cases hx0 : x = 0
      · rw [hx0]; exact W.zero_mem
      · obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
        have e : x = (w : Ω) * (x⁻¹) ^ k := by
          rw [← hx, pow_succ, mul_comm (x ^ k) x, mul_assoc, ← mul_pow, mul_inv_cancel₀ hx0,
            one_pow, mul_one]
        rw [e]
        exact mul_mem w.2 (pow_mem h _)
  have s2 : ((ℓ : ℕ) : Ω) ≠ 0 := by
    intro h
    apply s1.ne_zero
    apply Subtype.ext
    simpa using h
  have : NeZero ((ℓ : ℕ) : Ω) := ⟨s2⟩
  have : NeZero ℓ := ⟨hℓ0⟩
  obtain ⟨ζ₀, hζ₀⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot Ω ℓ
  have hζmem : ζ₀ ∈ W := V2 ζ₀ ℓ hℓpos 1 (by rw [hζ₀.pow_eq_one]; simp)
  have s5 : ∃ ζ : ↥W, IsPrimitiveRoot ζ ℓ :=
    ⟨⟨ζ₀, hζmem⟩, IsPrimitiveRoot.of_map_of_injective (f := W.subtype)
      (hζ₀ : IsPrimitiveRoot (W.subtype ⟨ζ₀, hζmem⟩) ℓ) Subtype.val_injective⟩
  obtain ⟨h₀, hh₀⟩ := IsAlgClosed.exists_pow_nat_eq (g : Ω) hℓpos
  have hh₀mem : h₀ ∈ W := V2 h₀ ℓ hℓpos g hh₀
  obtain ⟨h, hhdef⟩ : ∃ h : ↥W, (h : Ω) = h₀ := ⟨⟨h₀, hh₀mem⟩, rfl⟩
  have hhg : h ^ ℓ = g := by
    apply Subtype.ext
    rw [SubmonoidClass.coe_pow, hhdef, hh₀]
  have hhm : h ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hc
    rw [IsLocalRing.notMem_maximalIdeal] at hc
    have : IsUnit g := hhg ▸ hc.pow ℓ
    exact (IsLocalRing.notMem_maximalIdeal.mpr this) hgm
  have hh0 : h ≠ 0 := by
    intro hc
    apply hg0
    rw [← hhg, hc, zero_pow hℓ0]
  refine ⟨s1, s5, h, hhg, hhm, hh0, fun i _ hil => ⟨?_, ?_⟩⟩
  · rw [← hhg]; exact pow_dvd_pow h hil.le
  · rintro ⟨t, ht⟩
    have e : h ^ i * 1 = h ^ i * (h ^ (ℓ - i) * t) := by
      rw [mul_one, ← mul_assoc, ← pow_add, Nat.add_sub_cancel' hil.le, hhg]
      exact ht
    have e2 := mul_left_cancel₀ (pow_ne_zero i hh0) e
    have hu : IsUnit (h ^ (ℓ - i)) := isUnit_of_dvd_one ⟨t, e2⟩
    rw [isUnit_pow_iff (by omega)] at hu
    exact (IsLocalRing.notMem_maximalIdeal.mpr hu) hhm

theorem wcpa_dj_llsm_kpkn_kummer_basis : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] (ℓ : ℕ), ℓ.Prime → Module.finrank K L = ℓ →
    ∀ (ζ : K), IsPrimitiveRoot ζ ℓ → ∀ (θ : L) (c : K), θ ∉ Set.range (algebraMap K L) →
    θ ^ ℓ = algebraMap K L c →
    (∃ σ : L ≃ₐ[K] L, σ θ = algebraMap K L ζ * θ) ∧
    LinearIndependent K (fun i : Fin ℓ => θ ^ (i : ℕ)) ∧
    ∀ x : L, ∃ a : Fin ℓ → K, x = ∑ i, algebraMap K L (a i) * θ ^ (i : ℕ) :=
by
  intro K L _ _ _ _ _ ℓ hℓ hfin ζ hζ θ c hθK hθc
  have hint : IsIntegral K θ := IsIntegral.of_finite K θ
  have hd : (minpoly K θ).natDegree ∣ Module.finrank K L := minpoly.degree_dvd hint
  rw [hfin] at hd
  have hdeg : (minpoly K θ).natDegree = ℓ := by
    rcases hℓ.eq_one_or_self_of_dvd _ hd with h | h
    · exfalso
      obtain ⟨y, hy⟩ := minpoly.natDegree_eq_one_iff.mp h
      exact hθK ⟨y, hy⟩
    · exact h
  have h0 : Polynomial.aeval θ (Polynomial.X ^ ℓ - Polynomial.C c) = 0 := by
    rw [Polynomial.aeval_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C, hθc, sub_self]
  have hdvd : minpoly K θ ∣ Polynomial.X ^ ℓ - Polynomial.C c := minpoly.dvd K θ h0
  have hmin : minpoly K θ = Polynomial.X ^ ℓ - Polynomial.C c := by
    refine (Polynomial.eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hint)
      (Polynomial.monic_X_pow_sub_C c hℓ.ne_zero) hdvd ?_).symm
    rw [Polynomial.natDegree_X_pow_sub_C, hdeg]
  refine ⟨?_, ?_, ?_⟩
  · have hirr : Irreducible (Polynomial.X ^ ℓ - Polynomial.C c) := hmin ▸ minpoly.irreducible hint
    have hmon : (Polynomial.X ^ ℓ - Polynomial.C c).Monic :=
      Polynomial.monic_X_pow_sub_C c hℓ.ne_zero
    have hroot : Polynomial.aeval (algebraMap K L ζ * θ) (Polynomial.X ^ ℓ - Polynomial.C c) = 0 := by
      rw [Polynomial.aeval_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C, mul_pow, ← map_pow,
        hζ.pow_eq_one, map_one, one_mul, hθc, sub_self]
    have heq : minpoly K (algebraMap K L ζ * θ) = minpoly K θ :=
      (minpoly.eq_of_irreducible_of_monic hirr hroot hmon).symm.trans hmin.symm
    have horb := (Normal.minpoly_eq_iff_mem_orbit L).mp heq
    obtain ⟨σ, hσ⟩ := MulAction.mem_orbit_iff.mp horb
    exact ⟨σ, by rw [← AlgEquiv.smul_def]; exact hσ⟩
  · have hli := linearIndependent_pow (K := K) θ
    rw [hdeg] at hli
    exact hli
  · have hli := linearIndependent_pow (K := K) θ
    rw [hdeg] at hli
    have : Nonempty (Fin ℓ) := ⟨⟨0, hℓ.pos⟩⟩
    have hspan := hli.span_eq_top_of_card_eq_finrank (by rw [Fintype.card_fin, hfin])
    intro x
    have hx : x ∈ Submodule.span K (Set.range fun i : Fin ℓ => θ ^ (i : ℕ)) := by
      rw [hspan]; exact Submodule.mem_top
    obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp hx
    refine ⟨a, ?_⟩
    rw [← ha]
    simp only [Algebra.smul_def]

theorem wcpa_dj_llsm_kpkn_chart_identities : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) → ∀ r : ↥W, r ≠ 0 → r ∣ g → ¬ g ∣ r →
    (∀ x y : A, u * x = algebraMap ↥W A r * y →
      ∃ s p q : A, s ∉ 𝔭 ∧ s * x = algebraMap ↥W A r * p + v * q) ∧
    (∀ a b c : A, b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      algebraMap ↥W A r * a = algebraMap ↥W A r * b + v * c →
      ∃ s : A, s ∉ 𝔭 ∧
        s * a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ⊔ Ideal.span {v}) ∧
    (∀ a b c : A, b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      algebraMap ↥W A r * a = algebraMap ↥W A r * b + u * c →
      ∃ s : A, s ∉ 𝔭 ∧
        s * a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ⊔ Ideal.span {u}) :=
by
  intro Ω _ W A _ _ _ 𝔭 u v g hPD r hr0 hrg hgr
  have t1 : ∀ (N S : Type u) [CommRing N] [CommRing S] (φ : N →+* S) (hφ : φ.Flat) (P : Ideal N)
      (x j : N) (hP : ∀ a b : N, x * a = j * b → a ∈ P) (s t : S) (hst : φ x * s = φ j * t),
      s ∈ P.map φ := by
    intro N S _ _ φ hφ P x j hP s t hst
    algebraize [φ]
    have hfl : Module.Flat N S := hφ
    have hsmul : ∀ (n : N) (z : S), n • z = φ n * z := fun n z => Algebra.smul_def n z
    let fc : Fin 2 → N := fun i => if i = 0 then x else -j
    let mc : Fin 2 → S := fun i => if i = 0 then s else t
    have hsum : ∑ i : Fin 2, fc i • mc i = 0 := by
      rw [Fin.sum_univ_two]
      have e0 : fc 0 = x := rfl
      have e1 : fc 1 = -j := by simp [fc]
      have e2 : mc 0 = s := rfl
      have e3 : mc 1 = t := by simp [mc]
      rw [e0, e1, e2, e3, hsmul, hsmul, map_neg, hst]
      ring
    obtain ⟨k, a, y, hy, ha⟩ :=
      @Module.Flat.isTrivialRelation_of_sum_smul_eq_zero N S _ _ _ hfl (Fin 2) _ fc mc hsum
    have h0 : s = ∑ l, a 0 l • y l := hy 0
    rw [h0]
    refine Ideal.sum_mem _ (fun l _ => ?_)
    rw [hsmul]
    refine Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ ?_)
    apply hP _ (a 1 l)
    have h1 := ha l
    rw [Fin.sum_univ_two] at h1
    have e0 : fc 0 = x := rfl
    have e1 : fc 1 = -j := by simp [fc]
    rw [e0, e1] at h1
    linear_combination h1
  have t2 : ∀ (R : Type u) [CommRing R] (g w : R) (hwg : w ∣ g) (i j : Fin 2) (hij : i ≠ j)
      (I : Ideal (MvPolynomial (Fin 2) R))
      (hI : I = Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
      (a b : MvPolynomial (Fin 2) R ⧸ I)
      (hab : Ideal.Quotient.mk I (MvPolynomial.X i) * a = Ideal.Quotient.mk I (MvPolynomial.C w) * b),
      a ∈ Ideal.span {Ideal.Quotient.mk I (MvPolynomial.C w), Ideal.Quotient.mk I (MvPolynomial.X j)} := by
    intro R _ g w hwg i j hij I hI a b hab
    classical
    have hXX : (MvPolynomial.X i * MvPolynomial.X j : MvPolynomial (Fin 2) R) =
        MvPolynomial.X 0 * MvPolynomial.X 1 := by
      fin_cases i <;> fin_cases j <;> simp_all [mul_comm]
    have hqg : Ideal.Quotient.mk (Ideal.span {w}) g = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr hwg)
    have hqw : Ideal.Quotient.mk (Ideal.span {w}) w = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self w)
    let P0 : MvPolynomial (Fin 2) R →+* Polynomial (R ⧸ Ideal.span {w}) :=
      MvPolynomial.eval₂Hom (Polynomial.C.comp (Ideal.Quotient.mk (Ideal.span {w})))
        (fun k => if k = i then Polynomial.X else 0)
    have hPC : ∀ c, P0 (MvPolynomial.C c) = Polynomial.C (Ideal.Quotient.mk (Ideal.span {w}) c) :=
      fun c => MvPolynomial.eval₂Hom_C _ _ _
    have hPi : P0 (MvPolynomial.X i) = Polynomial.X := by simp [P0]
    have hPj : P0 (MvPolynomial.X j) = 0 := by simp [P0, hij.symm]
    have hPI : ∀ z ∈ I, P0 z = 0 := by
      intro z hz
      rw [hI] at hz
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hz
      rw [map_mul, ← hXX, map_sub, map_mul, hPi, hPj, hPC, hqg]
      simp
    let p0 := Ideal.Quotient.lift I P0 hPI
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective a
    obtain ⟨b', rfl⟩ := Ideal.Quotient.mk_surjective b
    have hsplit : ∀ F : MvPolynomial (Fin 2) R, ∃ (P : Polynomial R) (B : MvPolynomial (Fin 2) R),
        F = P.eval₂ MvPolynomial.C (MvPolynomial.X i) + MvPolynomial.X j * B := by
      intro F
      induction F using MvPolynomial.induction_on with
      | C c => exact ⟨Polynomial.C c, 0, by simp⟩
      | add p r hp hr =>
        obtain ⟨P1, B1, h1⟩ := hp
        obtain ⟨P2, B2, h2⟩ := hr
        exact ⟨P1 + P2, B1 + B2, by rw [h1, h2, Polynomial.eval₂_add]; ring⟩
      | mul_X p n hp =>
        obtain ⟨P1, B1, h1⟩ := hp
        by_cases hn : n = i
        · subst hn
          exact ⟨P1 * Polynomial.X, B1 * MvPolynomial.X n,
            by rw [h1, Polynomial.eval₂_mul_X]; ring⟩
        · have hnj : n = j := by
            fin_cases i <;> fin_cases j <;> fin_cases n <;> simp_all
          subst hnj
          exact ⟨0, p, by simp [mul_comm]⟩
    obtain ⟨P, B, hF⟩ := hsplit F
    have h1 : Polynomial.X * P0 F = 0 := by
      have := congrArg p0 hab
      rw [map_mul, map_mul] at this
      change P0 (MvPolynomial.X i) * P0 F = P0 (MvPolynomial.C w) * P0 b' at this
      rw [hPi, hPC, hqw, map_zero, zero_mul] at this
      exact this
    have h2 : P0 F = 0 := by
      ext n
      have := congrArg (fun p => Polynomial.coeff p (n+1)) h1
      simpa [Polynomial.coeff_X_mul] using this
    have h3 : Polynomial.map (Ideal.Quotient.mk (Ideal.span {w})) P = 0 := by
      have e : P0 (P.eval₂ MvPolynomial.C (MvPolynomial.X i)) =
          Polynomial.map (Ideal.Quotient.mk (Ideal.span {w})) P := by
        rw [Polynomial.hom_eval₂, hPi]
        have e' : P0.comp MvPolynomial.C = Polynomial.C.comp (Ideal.Quotient.mk (Ideal.span {w})) :=
          RingHom.ext hPC
        rw [e']; rfl
      rw [← e]
      have := h2
      rw [hF, map_add, map_mul, hPj, zero_mul, add_zero] at this
      exact this
    have hP : P ∈ (Ideal.span {w}).map (Polynomial.C) := by
      rw [Ideal.mem_map_C_iff]
      intro n
      have := congrArg (fun p => Polynomial.coeff p n) h3
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at this
      exact Ideal.Quotient.eq_zero_iff_mem.mp this
    have hCw : MvPolynomial.C w ∈ (Ideal.span {Ideal.Quotient.mk I (MvPolynomial.C w),
        Ideal.Quotient.mk I (MvPolynomial.X j)}).comap (Ideal.Quotient.mk I) :=
      Ideal.subset_span (Set.mem_insert _ _)
    have hXj : MvPolynomial.X j ∈ (Ideal.span {Ideal.Quotient.mk I (MvPolynomial.C w),
        Ideal.Quotient.mk I (MvPolynomial.X j)}).comap (Ideal.Quotient.mk I) :=
      Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
    have hev : P.eval₂ MvPolynomial.C (MvPolynomial.X i) ∈ (Ideal.span {Ideal.Quotient.mk I
        (MvPolynomial.C w), Ideal.Quotient.mk I (MvPolynomial.X j)}).comap (Ideal.Quotient.mk I) := by
      have hle : ((Ideal.span {w}).map (Polynomial.C)).map
          (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X i)) ≤
          (Ideal.span {Ideal.Quotient.mk I (MvPolynomial.C w),
            Ideal.Quotient.mk I (MvPolynomial.X j)}).comap (Ideal.Quotient.mk I) := by
        rw [Ideal.map_map, Ideal.map_span, Ideal.span_le]
        rintro z ⟨c, hc, rfl⟩
        rw [Set.mem_singleton_iff] at hc
        subst hc
        simpa using hCw
      exact hle (Ideal.mem_map_of_mem _ hP)
    have hmem : F ∈ (Ideal.span {Ideal.Quotient.mk I (MvPolynomial.C w),
        Ideal.Quotient.mk I (MvPolynomial.X j)}).comap (Ideal.Quotient.mk I) := by
      rw [hF]
      exact Ideal.add_mem _ hev (Ideal.mul_mem_right _ _ hXj)
    exact Ideal.mem_comap.mp hmem
  obtain ⟨_, htf, _, h𝔭max, _, hg, hg0, huv, _, h₀, hh₀, f, hfC, hfu, hfv, het⟩ := hPD
  haveI := htf
  haveI hprime : 𝔭.IsPrime := h𝔭max.isPrime
  have hflat : @RingHom.Flat (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
      (Localization.Away h₀) _ _ f :=
    ((RingHom.etale_iff_formallyUnramified_and_smooth (R := MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
      (S := Localization.Away h₀) f).mp het).2.flat
  have hfCw : ∀ w : ↥W, f (Ideal.Quotient.mk _ (MvPolynomial.C w)) =
      algebraMap A (Localization.Away h₀) (algebraMap ↥W A w) := by
    intro w
    have := RingHom.congr_fun hfC w
    simpa only [RingHom.comp_apply] using this
  have chart : ∀ w : ↥W, w ∣ g → ∀ (i k : Fin 2), i ≠ k → ∀ (e e' : A),
      f (Ideal.Quotient.mk _ (MvPolynomial.X i)) = algebraMap A (Localization.Away h₀) e →
      f (Ideal.Quotient.mk _ (MvPolynomial.X k)) = algebraMap A (Localization.Away h₀) e' →
      ∀ x y : A, e * x = algebraMap ↥W A w * y →
      ∃ s : A, s ∉ 𝔭 ∧ s * x ∈ Ideal.span {algebraMap ↥W A w, e'} := by
    intro w hw i k hik e e' hei hek x y hxy
    have hjx := t1 _ _ f hflat _ _ _ (fun a b hab => t2 ↥W g w hw i k hik _ rfl a b hab)
      (algebraMap A (Localization.Away h₀) x) (algebraMap A (Localization.Away h₀) y)
      (by rw [hei, hfCw, ← map_mul, ← map_mul, hxy])
    rw [Ideal.map_span, Set.image_pair, hfCw, hek, ← Set.image_pair, ← Ideal.map_span] at hjx
    obtain ⟨⟨⟨z, hz⟩, ⟨m, hm⟩⟩, hzm⟩ :=
      (IsLocalization.mem_map_algebraMap_iff (Submonoid.powers h₀) _).mp hjx
    simp only at hzm
    rw [← map_mul] at hzm
    obtain ⟨⟨c, hc⟩, hcx⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers h₀) _).mp hzm
    simp only at hcx
    refine ⟨c * m, ?_, ?_⟩
    · obtain ⟨k1, rfl⟩ := Submonoid.mem_powers_iff _ _ |>.mp hc
      obtain ⟨k2, rfl⟩ := Submonoid.mem_powers_iff _ _ |>.mp hm
      rw [← pow_add]
      intro hmem
      exact hh₀ (hprime.mem_of_pow_mem _ hmem)
    · have : c * m * x = c * z := by rw [← hcx]; ring
      rw [this]
      exact Ideal.mul_mem_left _ _ hz
  have hWinj : ∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ≠ 0 := by
    intro w hw h
    rw [Algebra.algebraMap_eq_smul_one] at h
    rcases smul_eq_zero.mp h with h | h
    · exact hw h
    · exact one_ne_zero h
  obtain ⟨t, ht⟩ := hrg
  have htm : t ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra htm
    have hu : IsUnit t := IsLocalRing.notMem_maximalIdeal.mp htm
    obtain ⟨t', ht'⟩ := hu.exists_right_inv
    exact hgr ⟨t', by rw [ht, mul_assoc, ht', mul_one]⟩
  have htg : t ∣ g := ⟨r, by rw [ht, mul_comm]⟩
  have hιg : algebraMap ↥W A g = algebraMap ↥W A r * algebraMap ↥W A t := by
    rw [ht, map_mul]
  have hιt : algebraMap ↥W A t ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) :=
    Ideal.mem_map_of_mem _ htm
  have hr' := hWinj r hr0
  refine ⟨?_, ?_, ?_⟩
  · intro x y hxy
    obtain ⟨s, hs, hsx⟩ := chart r ⟨t, ht⟩ 0 1 (by decide) u v hfu hfv x y hxy
    obtain ⟨p, q, hpq⟩ := Ideal.mem_span_pair.mp hsx
    exact ⟨s, p, q, hs, by rw [← hpq]; ring⟩
  · intro a b c hb habc
    have e : u * (a - b) = algebraMap ↥W A t * c := by
      apply mul_left_cancel₀ hr'
      linear_combination u * habc + c * hιg + c * huv
    obtain ⟨s, hs, hsx⟩ := chart t htg 0 1 (by decide) u v hfu hfv (a - b) c e
    refine ⟨s, hs, ?_⟩
    have hle : Ideal.span {algebraMap ↥W A t, v} ≤
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ⊔ Ideal.span {v} := by
      rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
      exact ⟨Ideal.mem_sup_left hιt, Ideal.mem_sup_right (Ideal.mem_span_singleton_self v)⟩
    have : s * a = s * (a - b) + s * b := by ring
    rw [this]
    exact Ideal.add_mem _ (hle hsx) (Ideal.mem_sup_left (Ideal.mul_mem_left _ _ hb))
  · intro a b c hb habc
    have e : v * (a - b) = algebraMap ↥W A t * c := by
      apply mul_left_cancel₀ hr'
      linear_combination v * habc + c * hιg + c * huv
    obtain ⟨s, hs, hsx⟩ := chart t htg 1 0 (by decide) v u hfv hfu (a - b) c e
    refine ⟨s, hs, ?_⟩
    have hle : Ideal.span {algebraMap ↥W A t, u} ≤
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ⊔ Ideal.span {u} := by
      rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
      exact ⟨Ideal.mem_sup_left hιt, Ideal.mem_sup_right (Ideal.mem_span_singleton_self u)⟩
    have : s * a = s * (a - b) + s * b := by ring
    rw [this]
    exact Ideal.add_mem _ (hle hsx) (Ideal.mem_sup_left (Ideal.mul_mem_left _ _ hb))

theorem wcpa_dj_llsm_kpkn_closure : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (ℓ : ℕ) (u v ε ζ : A) (g h : ↥W)
    (θ ψ : L) (σ : L ≃ₐ[K] L),
    IsIntegrallyClosed A → 𝔭.IsPrime → ℓ.Prime → Module.finrank K L = ℓ →
    IsUnit ((ℓ : ℕ) : A) → IsPrimitiveRoot (algebraMap A K ζ) ℓ →
    θ ∉ Set.range (algebraMap K L) → θ ^ ℓ = algebraMap A L (u * ε) → ε ∉ 𝔭 →
    h ^ ℓ = g → u * v = algebraMap ↥W A g → algebraMap ↥W A g ≠ 0 →
    θ * ψ = algebraMap A L (ε * algebraMap ↥W A h) → σ θ = algebraMap A L ζ * θ →
    (∀ x : L, ∃ a : Fin ℓ → K, x = ∑ i, algebraMap K L (a i) * θ ^ (i : ℕ)) →
    (∀ i : ℕ, 1 ≤ i → i < ℓ → ∀ x y : A, u * x = algebraMap ↥W A (h ^ i) * y →
      ∃ s p q : A, s ∉ 𝔭 ∧ s * x = algebraMap ↥W A (h ^ i) * p + v * q) →
    ∀ x : L, IsIntegral A x → ∃ s : A, s ∉ 𝔭 ∧ algebraMap A L s * x ∈
      Submodule.span A {z : L | ∃ i : ℕ, i < ℓ ∧ (z = θ ^ i ∨ z = ψ ^ i)} :=
by
  intro Ω _ W A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 ℓ u v ε ζ g h θ ψ σ hAic h𝔭 hℓ hfin hℓu hζ hθ
    hθℓ hε hhg huv hg0 hθψ hσ hcoord hI1 x hx
  classical
  have := hAic
  have := h𝔭

  have hιL : ∀ a : A, algebraMap A L a = algebraMap K L (algebraMap A K a) :=
    fun a => IsScalarTower.algebraMap_apply A K L a
  have hinj : Function.Injective (algebraMap A L) := by
    intro a b hab
    apply IsFractionRing.injective A K
    apply (algebraMap K L).injective
    rw [← hιL, ← hιL]; exact hab
  have hℓpos : 0 < ℓ := hℓ.pos
  have hθ0 : θ ≠ 0 := by
    rintro rfl; exact hθ ⟨0, map_zero _⟩
  have hu0 : u ≠ 0 := by
    rintro rfl; apply hg0; rw [← huv, zero_mul]
  have hH0 : algebraMap W A h ≠ 0 := by
    intro h0; apply hg0; rw [← hhg, map_pow, h0, zero_pow hℓpos.ne']
  have hU0 : algebraMap A L u ≠ 0 := fun h0 => hu0 (hinj (h0.trans (map_zero _).symm))
  have hHl0 : algebraMap A L (algebraMap W A h) ≠ 0 :=
    fun h0 => hH0 (hinj (h0.trans (map_zero _).symm))
  have hθℓL : θ ^ ℓ = algebraMap A L u * algebraMap A L ε := by rw [hθℓ, map_mul]
  have hHℓL : (algebraMap A L (algebraMap W A h)) ^ ℓ = algebraMap A L u * algebraMap A L v := by
    rw [← map_pow, ← map_pow, hhg, ← map_mul, huv]
  have hθψL : θ * ψ = algebraMap A L ε * algebraMap A L (algebraMap W A h) := by
    rw [hθψ, map_mul]

  have hdesc : ∀ c : K, _root_.IsIntegral A (algebraMap K L c) →
      ∃ c0 : A, algebraMap A K c0 = c := by
    intro c hc
    have hc' : _root_.IsIntegral A c :=
      (isIntegral_algHom_iff (IsScalarTower.toAlgHom A K L) (algebraMap K L).injective).mp hc
    exact IsIntegrallyClosed.isIntegral_iff.mp hc'

  obtain ⟨z, hzdef⟩ : ∃ z : L, algebraMap A L ζ = z := ⟨_, rfl⟩
  rw [hzdef] at hσ
  have hzK : z = algebraMap K L (algebraMap A K ζ) := by rw [← hzdef, hιL]
  have hzprim : IsPrimitiveRoot z ℓ := by
    rw [hzK]; exact hζ.map_of_injective (algebraMap K L).injective
  have hz1 : z ^ ℓ = 1 := hzprim.pow_eq_one
  have hσz : ∀ τ : L ≃ₐ[K] L, τ z = z := by
    intro τ; rw [hzK]; exact τ.commutes _
  have hσjθ : ∀ j : ℕ, (σ ^ j) θ = z ^ j * θ := by
    intro j
    induction j with
    | zero => simp
    | succ j ih => rw [pow_succ, AlgEquiv.mul_apply, hσ, map_mul, hσz, ih]; ring
  obtain ⟨⟨a₀, ℓ', haℓ, _⟩, ha₀⟩ := hℓu
  have hℓℓ' : ((ℓ : ℕ) : A) * ℓ' = 1 := by rw [← ha₀]; exact haℓ
  have hCℓ : (ℓ : L) * algebraMap A L ℓ' = 1 := by
    rw [← map_natCast (algebraMap A L) ℓ, ← map_mul, hℓℓ', map_one]
  have hzw' : z * algebraMap A L (ζ ^ (ℓ - 1)) = 1 := by
    rw [map_pow, hzdef, ← pow_succ', Nat.sub_add_cancel hℓpos, hz1]
  obtain ⟨w, hwdef⟩ : ∃ w : L, algebraMap A L (ζ ^ (ℓ - 1)) = w := ⟨_, rfl⟩
  rw [hwdef] at hzw'
  have hzw : z * w = 1 := hzw'
  have hw1 : w ^ ℓ = 1 := by
    have := congrArg (· ^ ℓ) hzw
    simpa [mul_pow, hz1] using this
  have hproj : ∀ b : Fin ℓ → K, _root_.IsIntegral A (∑ k, algebraMap K L (b k) * θ ^ (k : ℕ)) →
      ∀ i : Fin ℓ, _root_.IsIntegral A (algebraMap K L (b i) * θ ^ (i : ℕ)) := by
    intro b hxb i
    have hσj : ∀ j : ℕ, (σ ^ j) (∑ k, algebraMap K L (b k) * θ ^ (k : ℕ)) =
        ∑ k : Fin ℓ, algebraMap K L (b k) * (z ^ j) ^ (k : ℕ) * θ ^ (k : ℕ) := by
      intro j
      rw [map_sum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [map_mul, map_pow, AlgEquiv.commutes, hσjθ j, mul_pow]
      ring
    have hint : _root_.IsIntegral A (∑ j ∈ Finset.range ℓ,
        algebraMap A L (ℓ' * (ζ ^ (ℓ - 1)) ^ ((i : ℕ) * j)) *
          (σ ^ j) (∑ k, algebraMap K L (b k) * θ ^ (k : ℕ))) := by
      apply _root_.IsIntegral.sum
      intro j _
      exact isIntegral_algebraMap.mul (hxb.map ((σ ^ j).restrictScalars A))
    convert hint using 1
    have e1 : ∀ j ∈ Finset.range ℓ,
        algebraMap A L (ℓ' * (ζ ^ (ℓ - 1)) ^ ((i : ℕ) * j)) *
          (σ ^ j) (∑ k, algebraMap K L (b k) * θ ^ (k : ℕ)) =
        ∑ k : Fin ℓ, (algebraMap A L ℓ' * algebraMap K L (b k) * θ ^ (k : ℕ)) *
          (z ^ (k : ℕ) * w ^ (i : ℕ)) ^ j := by
      intro j _
      rw [hσj j, map_mul, map_pow (algebraMap A L) (ζ ^ (ℓ - 1)), hwdef, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      ring
    rw [Finset.sum_congr rfl e1, Finset.sum_comm]
    simp_rw [← Finset.mul_sum]
    rw [Finset.sum_eq_single i]
    · have hzwi : z ^ (i : ℕ) * w ^ (i : ℕ) = 1 := by rw [← mul_pow, hzw, one_pow]
      rw [hzwi]
      simp only [one_pow, Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one]
      linear_combination (-(algebraMap K L (b i) * θ ^ (i : ℕ))) * hCℓ
    · intro k _ hki
      have hρ1 : z ^ (k : ℕ) * w ^ (i : ℕ) ≠ 1 := by
        intro hρ
        apply hki
        apply Fin.ext
        apply hzprim.pow_inj k.isLt i.isLt
        calc z ^ (k : ℕ) = z ^ (k : ℕ) * (z ^ (i : ℕ) * w ^ (i : ℕ)) := by
              rw [← mul_pow, hzw, one_pow, mul_one]
          _ = z ^ (i : ℕ) * (z ^ (k : ℕ) * w ^ (i : ℕ)) := by ring
          _ = z ^ (i : ℕ) := by rw [hρ, mul_one]
      have hρℓ : (z ^ (k : ℕ) * w ^ (i : ℕ)) ^ ℓ = 1 := by
        calc (z ^ (k : ℕ) * w ^ (i : ℕ)) ^ ℓ = (z ^ ℓ) ^ (k : ℕ) * (w ^ ℓ) ^ (i : ℕ) := by ring
          _ = 1 := by rw [hz1, hw1, one_pow, one_pow, one_mul]
      have hgeom := mul_geom_sum (z ^ (k : ℕ) * w ^ (i : ℕ)) ℓ
      rw [hρℓ, sub_self] at hgeom
      have h0 : ∑ j ∈ Finset.range ℓ, (z ^ (k : ℕ) * w ^ (i : ℕ)) ^ j = 0 :=
        (mul_eq_zero.mp hgeom).resolve_left (sub_ne_zero.mpr hρ1)
      rw [h0, mul_zero]
    · intro hi; exact absurd (Finset.mem_univ i) hi

  have hid : ∀ (n m : ℕ) (t ψ E H U V s p q a : L), t ≠ 0 → U ≠ 0 → H ≠ 0 → t * ψ = E * H →
      t ^ (n + m + 1) = U * E → H ^ (n + m + 1) = U * V →
      s * (E * H ^ n * a) = H ^ n * p + V * q →
      s * E ^ (n + m + 1) * (a * t ^ n) = p * E ^ (n + m) * t ^ n + q * E ^ n * ψ ^ (m + 1) := by
    intro n m t ψ E H U V s p q a ht hU hH h1 h2 h3 hs
    have h1' : (t * ψ) ^ (m + 1) = (E * H) ^ (m + 1) := by rw [h1]
    have K1 : E ^ (n + m) * t ^ n * V = E ^ n * ψ ^ (m + 1) * H ^ n := by
      apply mul_right_cancel₀ (pow_ne_zero (m + 1) ht)
      linear_combination (E ^ (n + m) * V) * h2 - (E ^ n * H ^ n) * h1' - E ^ (n + m + 1) * h3
    apply mul_right_cancel₀ (mul_ne_zero hU (pow_ne_zero n hH))
    linear_combination (E ^ (n + m) * t ^ n * U) * hs + (q * U) * K1

  have hpow : ∀ (n m : ℕ) (t E H U V a : L), t ^ (n + m + 1) = U * E → H ^ (n + m + 1) = U * V →
      (U * E * a) ^ (n + m + 1) = (U * E) ^ (m + 1) * (a * t ^ n) ^ (n + m + 1) ∧
      (E * H ^ n * a) ^ (n + m + 1) = E ^ (m + 1) * V ^ n * (a * t ^ n) ^ (n + m + 1) := by
    intro n m t E H U V a h1 h2
    have e1 : (a * t ^ n) ^ (n + m + 1) = a ^ (n + m + 1) * (t ^ (n + m + 1)) ^ n := by ring
    have e2 : (E * H ^ n * a) ^ (n + m + 1) =
        E ^ (n + m + 1) * (H ^ (n + m + 1)) ^ n * a ^ (n + m + 1) := by ring
    rw [e1, e2, h1, h2]
    constructor <;> ring

  have hterm : ∀ (n : ℕ) (c : K), n < ℓ → _root_.IsIntegral A (algebraMap K L c * θ ^ n) →
      ∃ s : A, s ∉ 𝔭 ∧ algebraMap A L s * (algebraMap K L c * θ ^ n) ∈
        Submodule.span A {z : L | ∃ i : ℕ, i < ℓ ∧ (z = θ ^ i ∨ z = ψ ^ i)} := by
    intro n c hnℓ hT
    rcases Nat.eq_zero_or_pos n with hn0 | hn1
    · subst hn0
      obtain ⟨c0, hc0⟩ := hdesc c (by simpa using hT)
      refine ⟨1, fun h1 => h𝔭.ne_top ((Ideal.eq_top_iff_one _).mpr h1), ?_⟩
      have e : algebraMap A L 1 * (algebraMap K L c * θ ^ 0) = c0 • θ ^ 0 := by
        rw [Algebra.smul_def, map_one, one_mul, hιL, hc0]
      rw [e]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨0, hℓpos, Or.inl rfl⟩)
    · obtain ⟨m, hm⟩ : ∃ m, ℓ = n + m + 1 := ⟨ℓ - n - 1, by omega⟩
      have hθN : θ ^ (n + m + 1) = algebraMap A L u * algebraMap A L ε := by
        rw [← hm]; exact hθℓL
      have hHN : (algebraMap A L (algebraMap W A h)) ^ (n + m + 1) =
          algebraMap A L u * algebraMap A L v := by
        rw [← hm]; exact hHℓL
      obtain ⟨py, px⟩ := hpow n m θ (algebraMap A L ε) (algebraMap A L (algebraMap W A h))
        (algebraMap A L u) (algebraMap A L v) (algebraMap K L c) hθN hHN
      have hyI : _root_.IsIntegral A
          (algebraMap A L u * algebraMap A L ε * algebraMap K L c) := by
        refine _root_.IsIntegral.of_pow (by omega : 0 < n + m + 1) ?_
        rw [py]
        exact ((isIntegral_algebraMap.mul isIntegral_algebraMap).pow _).mul (hT.pow _)
      have hxI : _root_.IsIntegral A
          (algebraMap A L ε * algebraMap A L (algebraMap W A h) ^ n * algebraMap K L c) := by
        refine _root_.IsIntegral.of_pow (by omega : 0 < n + m + 1) ?_
        rw [px]
        exact ((isIntegral_algebraMap.pow _).mul (isIntegral_algebraMap.pow _)).mul (hT.pow _)
      obtain ⟨y, hy⟩ := hdesc (algebraMap A K (u * ε) * c) (by
        simp only [map_mul, ← hιL]; exact hyI)
      obtain ⟨x', hx'⟩ := hdesc (algebraMap A K (ε * algebraMap W A h ^ n) * c) (by
        simp only [map_mul, map_pow, ← hιL]; exact hxI)
      have huxy : u * x' = algebraMap W A (h ^ n) * y := by
        apply IsFractionRing.injective A K
        rw [map_mul, map_mul, hx', hy]
        simp only [map_mul, map_pow]
        ring
      obtain ⟨s', p, q, hs', hsx⟩ := hI1 n (by omega) hnℓ x' y huxy
      have hx'L : algebraMap A L x' =
          algebraMap A L ε * algebraMap A L (algebraMap W A h) ^ n * algebraMap K L c := by
        rw [hιL x', hx']
        simp only [map_mul, map_pow, ← hιL]
      have hsL : algebraMap A L s' *
          (algebraMap A L ε * algebraMap A L (algebraMap W A h) ^ n * algebraMap K L c) =
          algebraMap A L (algebraMap W A h) ^ n * algebraMap A L p +
            algebraMap A L v * algebraMap A L q := by
        rw [← hx'L]
        have e := congrArg (algebraMap A L) hsx
        simpa only [map_mul, map_add, map_pow] using e
      have key := hid n m θ ψ (algebraMap A L ε) (algebraMap A L (algebraMap W A h))
        (algebraMap A L u) (algebraMap A L v) (algebraMap A L s') (algebraMap A L p)
        (algebraMap A L q) (algebraMap K L c) hθ0 hU0 hHl0 hθψL hθN hHN hsL
      refine ⟨s' * ε ^ ℓ, ?_, ?_⟩
      · intro hmem
        rcases h𝔭.mem_or_mem hmem with h1 | h1
        · exact hs' h1
        · exact hε (h𝔭.mem_of_pow_mem _ h1)
      · have e : algebraMap A L (s' * ε ^ ℓ) * (algebraMap K L c * θ ^ n) =
            (p * ε ^ (n + m)) • θ ^ n + (q * ε ^ n) • ψ ^ (m + 1) := by
          simp only [Algebra.smul_def, map_mul, map_pow]
          rw [hm]
          linear_combination key
        rw [e]
        exact Submodule.add_mem _
          (Submodule.smul_mem _ _ (Submodule.subset_span ⟨n, hnℓ, Or.inl rfl⟩))
          (Submodule.smul_mem _ _ (Submodule.subset_span ⟨m + 1, by omega, Or.inr rfl⟩))

  obtain ⟨b, hb⟩ := hcoord x
  have hxb : _root_.IsIntegral A (∑ k, algebraMap K L (b k) * θ ^ (k : ℕ)) := by
    rw [← hb]; exact hx
  have hTi := hproj b hxb
  have hsi : ∀ i : Fin ℓ, ∃ s : A, s ∉ 𝔭 ∧
      algebraMap A L s * (algebraMap K L (b i) * θ ^ (i : ℕ)) ∈
        Submodule.span A {z : L | ∃ i : ℕ, i < ℓ ∧ (z = θ ^ i ∨ z = ψ ^ i)} :=
    fun i => hterm i (b i) i.isLt (hTi i)
  choose s hs hmem using hsi
  refine ⟨∏ i, s i, ?_, ?_⟩
  · intro hS
    obtain ⟨i, _, hi⟩ := Ideal.IsPrime.prod_mem_iff.mp hS
    exact hs i hi
  · rw [hb, Finset.mul_sum]
    apply Submodule.sum_mem
    intro i _
    have e : algebraMap A L (∏ j, s j) * (algebraMap K L (b i) * θ ^ (i : ℕ)) =
        (∏ j ∈ Finset.univ.erase i, s j) •
          (algebraMap A L (s i) * (algebraMap K L (b i) * θ ^ (i : ℕ))) := by
      rw [Algebra.smul_def, ← Finset.prod_erase_mul _ _ (Finset.mem_univ i), map_mul]
      ring
    rw [e]
    exact Submodule.smul_mem _ _ (hmem i)

theorem wcpa_dj_llsm_kpkn_localization : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (ℓ : ℕ) (u v ε ε' : A)
    (θ ψ : ↥(integralClosure A L)) (y : Ideal ↥(integralClosure A L)),
    IsIntegrallyClosed A → 𝔭.IsPrime → 0 < ℓ →
    𝔭 = Ideal.span {u, v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
    (θ : L) ^ ℓ = algebraMap A L (u * ε) → (ψ : L) ^ ℓ = algebraMap A L (v * ε') →
    ε ∉ 𝔭 → ε' ∉ 𝔭 →
    (∀ x : L, IsIntegral A x → ∃ s : A, s ∉ 𝔭 ∧ algebraMap A L s * x ∈
      Submodule.span A {z : L | ∃ i : ℕ, i < ℓ ∧ (z = (θ : L) ^ i ∨ z = (ψ : L) ^ i)}) →
    y.IsPrime → y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
    (∀ t : ↥(integralClosure A L), t ∉ y → ∃ (b : ↥(integralClosure A L)) (s : A),
      s ∉ 𝔭 ∧ t * b = algebraMap A ↥(integralClosure A L) s) ∧
    (∀ x ∈ y, ∃ s : A, s ∉ 𝔭 ∧ algebraMap A ↥(integralClosure A L) s * x ∈
      Ideal.span {θ, ψ} ⊔ Ideal.span {b : ↥(integralClosure A L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = algebraMap A L (algebraMap ↥W A w)}) :=
by
  intro Ω _ W A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 ℓ u v ε ε' θ ψ y hAic h𝔭 hℓ h𝔭eq hθ hψ hε hε'
    hCD hy hyc
  classical
  obtain ⟨n, rfl⟩ : ∃ n, ℓ = n + 1 := ⟨ℓ - 1, by omega⟩
  have hjc : ∀ c : A, ((algebraMap A ↥(integralClosure A L) c : ↥(integralClosure A L)) : L) =
      algebraMap A L c := fun _ => rfl
  have hu𝔭 : u ∈ 𝔭 := by
    rw [h𝔭eq]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert u {v}))
  have hv𝔭 : v ∈ 𝔭 := by
    rw [h𝔭eq]
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem u (Set.mem_singleton v)))
  have hm𝔭 : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 := by
    rw [h𝔭eq]; exact le_sup_right
  have hθpow : θ ^ (n + 1) = algebraMap A ↥(integralClosure A L) (u * ε) :=
    Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hθ)
  have hψpow : ψ ^ (n + 1) = algebraMap A ↥(integralClosure A L) (v * ε') :=
    Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hψ)

  have hmemθ : ∀ y' : Ideal ↥(integralClosure A L), y'.IsPrime →
      y'.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → θ ∈ y' ∧ ψ ∈ y' := by
    intro y' hy' hy'c
    constructor
    · apply hy'.mem_of_pow_mem (n + 1)
      rw [hθpow, ← Ideal.mem_comap, hy'c]
      exact 𝔭.mul_mem_right ε hu𝔭
    · apply hy'.mem_of_pow_mem (n + 1)
      rw [hψpow, ← Ideal.mem_comap, hy'c]
      exact 𝔭.mul_mem_right ε' hv𝔭

  have hsplit : ∀ z ∈ Submodule.span A
      {z : L | ∃ i : ℕ, i < n + 1 ∧ (z = (θ : L) ^ i ∨ z = (ψ : L) ^ i)},
      ∃ (a : A) (P Q : ↥(integralClosure A L)),
        z = algebraMap A L a + (θ : L) * (P : L) + (ψ : L) * (Q : L) := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨i, -, hi | hi⟩ := hz
      · rcases i with _ | k
        · exact ⟨1, 0, 0, by rw [hi, map_one, ZeroMemClass.coe_zero]; ring⟩
        · exact ⟨0, θ ^ k, 0, by
            rw [hi, map_zero, SubmonoidClass.coe_pow, ZeroMemClass.coe_zero]; ring⟩
      · rcases i with _ | k
        · exact ⟨1, 0, 0, by rw [hi, map_one, ZeroMemClass.coe_zero]; ring⟩
        · exact ⟨0, 0, ψ ^ k, by
            rw [hi, map_zero, SubmonoidClass.coe_pow, ZeroMemClass.coe_zero]; ring⟩
    | zero => exact ⟨0, 0, 0, by rw [map_zero, ZeroMemClass.coe_zero]; ring⟩
    | add z₁ z₂ _ _ h₁ h₂ =>
      obtain ⟨a, P, Q, rfl⟩ := h₁
      obtain ⟨a', P', Q', rfl⟩ := h₂
      exact ⟨a + a', P + P', Q + Q', by rw [map_add, AddMemClass.coe_add, AddMemClass.coe_add]; ring⟩
    | smul c z₁ _ h₁ =>
      obtain ⟨a, P, Q, rfl⟩ := h₁
      refine ⟨c * a, algebraMap A ↥(integralClosure A L) c * P,
        algebraMap A ↥(integralClosure A L) c * Q, ?_⟩
      rw [Algebra.smul_def, MulMemClass.coe_mul, MulMemClass.coe_mul, hjc, map_mul]
      ring

  have hJ : ∀ μ ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A),
      algebraMap A ↥(integralClosure A L) μ ∈ Ideal.span {b : ↥(integralClosure A L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = algebraMap A L (algebraMap ↥W A w)} := by
    have hle' : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤
        (Ideal.span {b : ↥(integralClosure A L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = algebraMap A L (algebraMap ↥W A w)}).comap
          (algebraMap A ↥(integralClosure A L)) := by
      rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap]
      exact Ideal.subset_span ⟨w, hw, rfl⟩
    exact fun μ hμ => hle' hμ

  have hDec : ∀ y' : Ideal ↥(integralClosure A L), y'.IsPrime →
      y'.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
      ∀ x ∈ y', ∃ s : A, s ∉ 𝔭 ∧ algebraMap A ↥(integralClosure A L) s * x ∈
        Ideal.span {θ, ψ} ⊔ Ideal.span {b : ↥(integralClosure A L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = algebraMap A L (algebraMap ↥W A w)} := by
    intro y' hy' hy'c x hx
    obtain ⟨hθy', hψy'⟩ := hmemθ y' hy' hy'c
    obtain ⟨s₀, hs₀, hmem⟩ := hCD (x : L) x.2
    obtain ⟨a, P, Q, hsp⟩ := hsplit _ hmem
    have hja : algebraMap A ↥(integralClosure A L) a =
        algebraMap A ↥(integralClosure A L) s₀ * x - θ * P - ψ * Q := by
      apply Subtype.ext
      rw [AddSubgroupClass.coe_sub, AddSubgroupClass.coe_sub, MulMemClass.coe_mul,
        MulMemClass.coe_mul, MulMemClass.coe_mul, hjc, hjc, hsp]
      ring
    have ha : a ∈ 𝔭 := by
      rw [← hy'c, Ideal.mem_comap, hja]
      exact y'.sub_mem (y'.sub_mem (y'.mul_mem_left _ hx) (y'.mul_mem_right _ hθy'))
        (y'.mul_mem_right _ hψy')
    rw [h𝔭eq, Submodule.mem_sup] at ha
    obtain ⟨a₁, ha₁, μ, hμ, rfl⟩ := ha
    obtain ⟨α, β, rfl⟩ := Ideal.mem_span_pair.mp ha₁
    refine ⟨ε * ε' * s₀, ?_, ?_⟩
    · intro hmem'
      rcases h𝔭.mem_or_mem hmem' with h1 | h1
      · rcases h𝔭.mem_or_mem h1 with h2 | h2
        · exact hε h2
        · exact hε' h2
      · exact hs₀ h1
    · have key : algebraMap A ↥(integralClosure A L) (ε * ε' * s₀) * x =
          (algebraMap A ↥(integralClosure A L) (α * ε') * θ ^ n +
              algebraMap A ↥(integralClosure A L) (ε * ε') * P) * θ +
            (algebraMap A ↥(integralClosure A L) (β * ε) * ψ ^ n +
              algebraMap A ↥(integralClosure A L) (ε * ε') * Q) * ψ +
            algebraMap A ↥(integralClosure A L) (ε * ε') * algebraMap A ↥(integralClosure A L) μ := by
        apply Subtype.ext
        simp only [MulMemClass.coe_mul, AddMemClass.coe_add, SubmonoidClass.coe_pow, hjc, map_mul,
          map_add] at hsp ⊢
        rw [map_mul] at hθ hψ
        linear_combination (algebraMap A L ε * algebraMap A L ε') * hsp
          - algebraMap A L α * algebraMap A L ε' * hθ - algebraMap A L β * algebraMap A L ε * hψ
      rw [key]
      refine Ideal.add_mem _ (Ideal.mem_sup_left ?_) (Ideal.mem_sup_right ?_)
      · exact Ideal.mem_span_pair.mpr ⟨_, _, rfl⟩
      · exact Ideal.mul_mem_left _ _ (hJ μ hμ)

  obtain ⟨hθy, hψy⟩ := hmemθ y hy hyc
  have hIy : Ideal.span {θ, ψ} ⊔ Ideal.span {b : ↥(integralClosure A L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = algebraMap A L (algebraMap ↥W A w)} ≤ y := by
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      rintro z (rfl | rfl)
      · exact hθy
      · exact hψy
    · rw [Ideal.span_le]
      rintro b ⟨w, hw, hbw⟩
      have hb : b = algebraMap A ↥(integralClosure A L) (algebraMap ↥W A w) := Subtype.ext hbw
      rw [SetLike.mem_coe, hb, ← Ideal.mem_comap, hyc]
      exact hm𝔭 (Ideal.mem_map_of_mem _ hw)

  have hle : ∀ y' : Ideal ↥(integralClosure A L), y'.IsPrime →
      y'.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → y' ≤ y := by
    intro y' hy' hy'c x hx
    obtain ⟨s, hs, hsx⟩ := hDec y' hy' hy'c x hx
    rcases hy.mem_or_mem (hIy hsx) with h | h
    · exact absurd (by rw [← hyc]; exact h) hs
    · exact h

  have hstab : ∀ (σ : L ≃ₐ[K] L) (t : ↥(integralClosure A L)), t ∉ y →
      ∀ z : ↥(integralClosure A L), (z : L) = σ (t : L) → z ∉ y := by
    intro σ t ht z hz hzy
    let τ : ↥(integralClosure A L) →ₐ[A] ↥(integralClosure A L) :=
      ((σ.restrictScalars A : L ≃ₐ[A] L) : L →ₐ[A] L).mapIntegralClosure
    have hτ : τ t = z := by
      apply Subtype.ext
      rw [hz]
      rfl
    have hc : (y.comap τ).comap (algebraMap A ↥(integralClosure A L)) = 𝔭 := by
      ext a
      rw [Ideal.mem_comap, Ideal.mem_comap, AlgHom.commutes, ← Ideal.mem_comap, hyc]
    haveI : (y.comap τ).IsPrime := Ideal.comap_isPrime τ y
    apply ht
    apply hle _ inferInstance hc
    rw [Ideal.mem_comap, hτ]
    exact hzy

  have hLoc : ∀ t : ↥(integralClosure A L), t ∉ y → ∃ (b : ↥(integralClosure A L)) (s : A),
      s ∉ 𝔭 ∧ t * b = algebraMap A ↥(integralClosure A L) s := by
    intro t ht
    have ht' : IsIntegral A (t : L) := t.2
    have hσint : ∀ σ : L ≃ₐ[K] L, IsIntegral A (σ (t : L)) := fun σ =>
      ht'.map (((σ : L →ₐ[K] L)).restrictScalars A)
    let st : (L ≃ₐ[K] L) → ↥(integralClosure A L) := fun σ => ⟨σ (t : L), hσint σ⟩
    have hN : IsIntegral A (Algebra.norm K (t : L)) := Algebra.isIntegral_norm K ht'
    haveI := hAic
    obtain ⟨s, hs⟩ := IsIntegrallyClosed.isIntegral_iff.mp hN
    have hprod : t * ∏ σ ∈ Finset.univ.erase (1 : L ≃ₐ[K] L), st σ =
        algebraMap A ↥(integralClosure A L) s := by
      apply Subtype.ext
      calc ((t * ∏ σ ∈ Finset.univ.erase (1 : L ≃ₐ[K] L), st σ : ↥(integralClosure A L)) : L)
          = (t : L) * ∏ σ ∈ Finset.univ.erase (1 : L ≃ₐ[K] L), σ (t : L) := by
            rw [MulMemClass.coe_mul, SubmonoidClass.coe_finsetProd]
        _ = ∏ σ : L ≃ₐ[K] L, σ (t : L) := by
            rw [← Finset.mul_prod_erase Finset.univ (fun σ : L ≃ₐ[K] L => σ (t : L))
              (Finset.mem_univ (1 : L ≃ₐ[K] L)), AlgEquiv.one_apply]
        _ = algebraMap K L (Algebra.norm K (t : L)) :=
            (Algebra.norm_eq_prod_automorphisms K (t : L)).symm
        _ = algebraMap A L s := by rw [← hs, ← IsScalarTower.algebraMap_apply]
        _ = _ := (hjc s).symm
    refine ⟨∏ σ ∈ Finset.univ.erase (1 : L ≃ₐ[K] L), st σ, s, ?_, hprod⟩
    intro hs𝔭
    have h1 : t * ∏ σ ∈ Finset.univ.erase (1 : L ≃ₐ[K] L), st σ ∈ y := by
      rw [hprod, ← Ideal.mem_comap, hyc]; exact hs𝔭
    rcases hy.mem_or_mem h1 with h2 | h2
    · exact ht h2
    · haveI := hy
      obtain ⟨σ, -, hσ⟩ := Ideal.IsPrime.prod_mem_iff.mp h2
      exact hstab σ t ht (st σ) rfl hσ
  exact ⟨hLoc, hDec y hy hyc⟩

theorem wcpa_dj_llsm_kpkn_branch_dvrs : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) [𝔭.IsPrime]
    (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) →
    (∃ _ : IsDomain (Localization.AtPrime 𝔭 ⧸ wcKpknBrI W A 𝔭 v),
      IsDiscreteValuationRing (Localization.AtPrime 𝔭 ⧸ wcKpknBrI W A 𝔭 v) ∧
      Irreducible (Ideal.Quotient.mk (wcKpknBrI W A 𝔭 v) (algebraMap A (Localization.AtPrime 𝔭) u))) ∧
    (∃ _ : IsDomain (Localization.AtPrime 𝔭 ⧸ wcKpknBrI W A 𝔭 u),
      IsDiscreteValuationRing (Localization.AtPrime 𝔭 ⧸ wcKpknBrI W A 𝔭 u) ∧
      Irreducible (Ideal.Quotient.mk (wcKpknBrI W A 𝔭 u) (algebraMap A (Localization.AtPrime 𝔭) v))) :=
by
  intro Ω _ W A _ _ _ 𝔭 _ u v g hPD
  obtain ⟨-, -, -, -, hm𝔭, hg, hg0, huv, h𝔭eq, h, hh, f₀, hfC, hfu, hfv, hfet⟩ := hPD

  have branch : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (a b : B)
      [IsDomain (B ⧸ Ideal.span {b})], IsLocalRing.maximalIdeal B = Ideal.span {a, b} →
      Ideal.Quotient.mk (Ideal.span {b}) a ≠ 0 →
      IsDiscreteValuationRing (B ⧸ Ideal.span {b}) ∧
        Irreducible (Ideal.Quotient.mk (Ideal.span {b}) a) := by
    intro B _ _ _ a b _ hmB hne
    have hmk : Function.Surjective (Ideal.Quotient.mk (Ideal.span {b})) :=
      Ideal.Quotient.mk_surjective
    haveI : IsLocalRing (B ⧸ Ideal.span {b}) := IsLocalRing.of_surjective' _ hmk
    have hM : (IsLocalRing.maximalIdeal (B ⧸ Ideal.span {b})).comap
        (Ideal.Quotient.mk (Ideal.span {b})) = IsLocalRing.maximalIdeal B := by
      haveI := Ideal.comap_isMaximal_of_surjective (Ideal.Quotient.mk (Ideal.span {b})) hmk
        (K := IsLocalRing.maximalIdeal (B ⧸ Ideal.span {b}))
      exact IsLocalRing.eq_maximalIdeal this
    have hb0 : Ideal.Quotient.mk (Ideal.span {b}) b = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self b)
    have hmax : IsLocalRing.maximalIdeal (B ⧸ Ideal.span {b}) =
        Ideal.span {Ideal.Quotient.mk (Ideal.span {b}) a} := by
      rw [← Ideal.map_comap_of_surjective _ hmk (IsLocalRing.maximalIdeal (B ⧸ Ideal.span {b})),
        hM, hmB, Ideal.map_span, Set.image_pair, hb0, Set.pair_comm, Ideal.span_insert_zero]
    have hnf : ¬ IsField (B ⧸ Ideal.span {b}) := by
      rw [IsLocalRing.isField_iff_maximalIdeal_eq, hmax, Ideal.span_singleton_eq_bot]
      exact hne
    haveI hdvr : IsDiscreteValuationRing (B ⧸ Ideal.span {b}) :=
      ((IsDiscreteValuationRing.TFAE (B ⧸ Ideal.span {b}) hnf).out 1 5).mpr
        (⟨⟨Ideal.Quotient.mk (Ideal.span {b}) a, hmax⟩⟩ :
          Submodule.IsPrincipal (IsLocalRing.maximalIdeal (B ⧸ Ideal.span {b})))
    exact ⟨hdvr, (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr hmax⟩

  have chart : ∀ (S : Type u) [CommRing S] [Algebra ↥W S] (f₀ : S →+* Localization.Away h)
      (P : Type u) [CommRing P] (π : S →+* P),
      f₀.comp (algebraMap ↥W S) =
        (algebraMap A (Localization.Away h)).comp (algebraMap ↥W A) →
      RingHom.Etale f₀ → Function.Surjective π →
      RingHom.ker π = (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W S) →
      ∃ (E : Type u) (_ : CommRing E) (fb : P →+* E)
        (ρ : Localization.Away h →+* E) (q : Ideal E) (_ : q.IsPrime),
        RingHom.Etale fb ∧
        RingHom.ker ρ = ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
          (algebraMap A (Localization.Away h)) ∧
        (∀ s, fb (π s) = ρ (f₀ s)) ∧
        q = (𝔭.map (algebraMap A (Localization.Away h))).map ρ ∧
        ∃ e : (Localization.AtPrime 𝔭 ⧸
          ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
            (algebraMap A (Localization.AtPrime 𝔭))) ≃+* Localization.AtPrime q,
          ∀ a : A, e (Ideal.Quotient.mk _ (algebraMap A (Localization.AtPrime 𝔭) a)) =
            algebraMap E (Localization.AtPrime q) (ρ (algebraMap A (Localization.Away h) a)) := by
    intro S _ _ f₀ P _ π hf het hπ hker
    have hK : (RingHom.ker π).map f₀ = ((IsLocalRing.maximalIdeal ↥W).map
        (algebraMap ↥W A)).map (algebraMap A (Localization.Away h)) := by
      rw [hker, Ideal.map_map, hf, ← Ideal.map_map]
    have s1 : ∃ fb : P →+* Localization.Away h ⧸ ((IsLocalRing.maximalIdeal ↥W).map
          (algebraMap ↥W A)).map (algebraMap A (Localization.Away h)),
        RingHom.Etale fb ∧ ∀ s, fb (π s) = Ideal.Quotient.mk _ (f₀ s) := by
      generalize ((IsLocalRing.maximalIdeal ↥W).map
        (algebraMap ↥W A)).map (algebraMap A (Localization.Away h)) = K at hK ⊢
      letI := f₀.toAlgebra
      haveI : Algebra.Etale S (Localization.Away h) := het
      set J := RingHom.ker π with hJ
      have h1 : RingHom.Etale (algebraMap (S ⧸ J) (TensorProduct S (S ⧸ J) (Localization.Away h))) :=
        RingHom.etale_algebraMap.mpr inferInstance
      let e₁ : TensorProduct S (S ⧸ J) (Localization.Away h) ≃+*
          Localization.Away h ⧸ J.map (algebraMap S (Localization.Away h)) :=
        (Algebra.TensorProduct.comm S (S ⧸ J) (Localization.Away h)).toRingEquiv.trans
          (Algebra.TensorProduct.quotIdealMapEquivTensorQuot (Localization.Away h) J).symm.toRingEquiv
      let e₂ : Localization.Away h ⧸ J.map (algebraMap S (Localization.Away h)) ≃+*
          Localization.Away h ⧸ K := Ideal.quotEquivOfEq hK
      let e := e₁.trans e₂
      let g := e.toRingHom.comp (algebraMap (S ⧸ J) (TensorProduct S (S ⧸ J) (Localization.Away h)))
      have hg : RingHom.Etale g := RingHom.Etale.respectsIso.1 _ _ h1
      let fb := g.comp (RingHom.quotientKerEquivOfSurjective hπ).symm.toRingHom
      have hfb : RingHom.Etale fb := RingHom.Etale.respectsIso.2 _ _ hg
      refine ⟨fb, hfb, fun s => ?_⟩
      have hs : (RingHom.quotientKerEquivOfSurjective hπ).symm (π s) = Ideal.Quotient.mk J s :=
        RingHom.quotientKerEquivOfSurjective_symm_apply hπ s
      show e₂ (e₁ (algebraMap (S ⧸ J) (TensorProduct S (S ⧸ J) (Localization.Away h))
        ((RingHom.quotientKerEquivOfSurjective hπ).symm (π s)))) = _
      rw [hs, Algebra.TensorProduct.algebraMap_apply]
      show e₂ ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot (Localization.Away h) J).symm
        ((Algebra.TensorProduct.comm S (S ⧸ J) (Localization.Away h))
          (_ ⊗ₜ[S] (1 : Localization.Away h)))) = _
      rw [Algebra.TensorProduct.comm_tmul, Algebra.algebraMap_self, RingHom.id_apply,
        Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul]
      rw [Algebra.smul_def, mul_one]
      rfl
    set 𝔞 : Ideal A := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) with h𝔞d
    have h𝔞 : 𝔞 ≤ 𝔭 := hm𝔭
    have hdisj : Disjoint (Submonoid.powers h : Set A) 𝔭 := by
      rw [Set.disjoint_left]
      rintro x ⟨n, rfl⟩ hx
      exact hh (Ideal.IsPrime.mem_of_pow_mem ‹_› n hx)
    have hhn : ∀ n : ℕ, h ^ n ∉ 𝔭 := fun n hn => hh (Ideal.IsPrime.mem_of_pow_mem ‹_› n hn)
    have hQp : (𝔭.map (algebraMap A (Localization.Away h))).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) _ 𝔭 ‹_› hdisj
    have hq : ((𝔭.map (algebraMap A (Localization.Away h))).map
        (Ideal.Quotient.mk (𝔞.map (algebraMap A (Localization.Away h))))).IsPrime := by
      apply Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
      rw [Ideal.mk_ker]
      exact Ideal.map_mono h𝔞
    have s3 : ∃ e : (Localization.AtPrime 𝔭 ⧸ 𝔞.map (algebraMap A (Localization.AtPrime 𝔭))) ≃+*
        Localization.AtPrime ((𝔭.map (algebraMap A (Localization.Away h))).map
          (Ideal.Quotient.mk (𝔞.map (algebraMap A (Localization.Away h))))),
        ∀ a : A, e (Ideal.Quotient.mk _ (algebraMap A (Localization.AtPrime 𝔭) a)) =
          algebraMap (Localization.Away h ⧸ 𝔞.map (algebraMap A (Localization.Away h)))
            (Localization.AtPrime ((𝔭.map (algebraMap A (Localization.Away h))).map
              (Ideal.Quotient.mk (𝔞.map (algebraMap A (Localization.Away h))))))
            (Ideal.Quotient.mk (𝔞.map (algebraMap A (Localization.Away h)))
              (algebraMap A (Localization.Away h) a)) := by
      have hQc : (𝔭.map (algebraMap A (Localization.Away h))).comap
          (algebraMap A (Localization.Away h)) = 𝔭 :=
        IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers h) _ ‹_› hdisj
      set I : Ideal (Localization.Away h) := 𝔞.map (algebraMap A (Localization.Away h)) with hI
      set Q : Ideal (Localization.Away h) := 𝔭.map (algebraMap A (Localization.Away h)) with hQ
      set q : Ideal (Localization.Away h ⧸ I) := Q.map (Ideal.Quotient.mk I) with hqdef
      have hIQ : I ≤ Q := Ideal.map_mono h𝔞
      have hK1 : q.comap (Ideal.Quotient.mk I) = Q := by
        rw [hqdef, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
          ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
        exact sup_eq_left.mpr hIQ
      have hK2 : ∀ a : A, Ideal.Quotient.mk I (algebraMap A (Localization.Away h) a) ∈ q ↔ a ∈ 𝔭 := by
        intro a
        rw [← Ideal.mem_comap, hK1, ← Ideal.mem_comap, hQc]
      have hunit : ∀ y : 𝔭.primeCompl, IsUnit (((algebraMap (Localization.Away h ⧸ I)
          (Localization.AtPrime q)).comp ((Ideal.Quotient.mk I).comp
            (algebraMap A (Localization.Away h)))) y) := by
        intro y
        exact (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime q) q _).mpr
          (fun hm => y.2 ((hK2 y).mp hm))
      have hK3 : ∀ t : Localization.Away h ⧸ I, t ∉ q → ∃ (y : Localization.Away h) (m : ℕ) (b : A),
          Ideal.Quotient.mk I y = t ∧
          y * algebraMap A (Localization.Away h) h ^ m = algebraMap A (Localization.Away h) b ∧
          b ∉ 𝔭 := by
        intro t ht
        obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective t
        obtain ⟨m, b, hb⟩ := IsLocalization.Away.surj h y
        refine ⟨y, m, b, rfl, hb, ?_⟩
        intro hb𝔭
        have h1 : algebraMap A (Localization.Away h) b ∈ Q := Ideal.mem_map_of_mem _ hb𝔭
        rw [← hb] at h1
        rcases hQp.mem_or_mem h1 with h2 | h2
        · exact ht (Ideal.mem_map_of_mem _ h2)
        · rw [← map_pow, ← Ideal.mem_comap, hQc] at h2
          exact hhn m h2
      let θ := IsLocalization.lift (M := 𝔭.primeCompl) (S := Localization.AtPrime 𝔭) hunit
      have hsurj : Function.Surjective θ := by
        intro z
        obtain ⟨⟨e, t⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl z
        obtain ⟨y, m, b, hy, hyb, hb⟩ := hK3 t t.2
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective e
        obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj h x
        have hs0 : b * h ^ n ∈ 𝔭.primeCompl := fun hm =>
          (Ideal.IsPrime.mem_or_mem ‹_› hm).elim hb (hhn n)
        refine ⟨IsLocalization.mk' (Localization.AtPrime 𝔭) (a * h ^ m) ⟨b * h ^ n, hs0⟩, ?_⟩
        rw [IsLocalization.lift_mk'_spec]
        have hZ := IsLocalization.mk'_spec (Localization.AtPrime q) (Ideal.Quotient.mk I x) t
        rw [← hy] at hZ
        simp only [RingHom.comp_apply, map_mul, map_pow]
        rw [← ha, ← hyb]
        simp only [map_mul, map_pow]
        rw [← hZ]
        ring
      have hkerθ : RingHom.ker θ = 𝔞.map (algebraMap A (Localization.AtPrime 𝔭)) := by
        apply le_antisymm
        · intro w hw
          rw [RingHom.mem_ker] at hw
          obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl w
          rw [IsLocalization.lift_mk'_spec, mul_zero] at hw
          obtain ⟨t, ht⟩ := (IsLocalization.map_eq_zero_iff q.primeCompl (Localization.AtPrime q)
            (Ideal.Quotient.mk I (algebraMap A (Localization.Away h) a))).mp hw
          obtain ⟨y, m, b, hy, hyb, hb⟩ := hK3 t t.2
