        obtain ⟨y'', hy''p, hy''c, hU'', hδ''⟩ := wcpa_dj_llsm_br_residue_point Ω W hW hWt A' K L
          𝔭' t y' cs bb βs A'' t' 𝔭'' hPD hyp hyc hU hδ hcs hbb hbb0 hsub'' ht' hPD'' hβs hβs0 hwit
        have hTop'' : wcLlsDec A'' K L y'' = ⊤ :=
