      (e'' (algebraMap P ↥(Algebra.adjoin P {Y'}) (e (algebraMap
        ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Q) x₁)))) _ hr₂ ?_
    · intro i; rw [Polynomial.coeff_map]; exact hR3r _
    · rw [Polynomial.eval_map]
      have h1 := Polynomial.hom_eval₂ p₀ (algebraMap ↥(Algebra.adjoin A₃ {s₃})
        ↥(integralClosure ↥(Algebra.adjoin A₃ {s₃}) L))
        (e₃.comp (algebraMap ↥(integralClosure ↥(Algebra.adjoin A₃ {s₃}) L)
          (Localization.AtPrime 𝔮))) c₀
      rw [hp₀e, map_zero, RingHom.comp_assoc] at h1
      exact h1.symm
    · rw [hke', hke', he₃'P, he₃'P, ← heφ, ← heφ, ← hrel, map_mul, mul_comm]

  have hsurj := wcpa_dj_llsm_scrsct_hens_range_surj
    ↥(integralClosure ↥(Algebra.adjoin A₃ {s₃}) L) 𝔮 P₃ P' e₃ he₃ k hkloc hkinj hall
  have htr := wcpa_dj_lr1k_ebnt_hens_transport _ P' P₃ 𝔐 e'' k he'' ⟨hkinj, hsurj⟩
  rw [hke] at htr
  refine ⟨𝔐, h𝔐p, hX𝔐, hY𝔐, hm𝔐, P₃, inferInstance, e₃, e₃', he₃, htr, ?_⟩
  ext t
  simp only [RingHom.comp_apply]
  rw [he₃'P]
  exact hhσ t

theorem wcpa_dj_llsm_isi_outer_restrict : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' q' : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → q' ∈ IsLocalRing.maximalIdeal ↥W → q' ≠ 0 →
    a' * q' ∣ g →
    wcLlsAnnSep W A K L u (a' * q') → wcLlsIsiSep2 W A K L u a' (a' * q') :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' q' hPD ha'm ha'0 hq'm hq'0 hdvd
    hsep
  have notUnitM : ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → ¬ IsUnit x :=
    fun x hx => mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal x).mp hx)
  have mkM : ∀ x : ↥W, ¬ IsUnit x → x ∈ IsLocalRing.maximalIdeal ↥W :=
    fun x hx => (IsLocalRing.mem_maximalIdeal x).mpr (mem_nonunits_iff.mpr hx)

  obtain ⟨w, hw⟩ := hdvd
  have hg : g = a' * (q' * w) := by rw [hw]; ring
  have hq''m : q' * w ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right w _ hq'm
  have hq'q'' : q' ∣ q' * w := dvd_mul_right q' w
  have hbm : a' * q' ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_left _ a' hq'm
  have hb0 : a' * q' ≠ 0 := mul_ne_zero ha'0 hq'0
  have hbg : a' * q' ∣ g := ⟨w, hw⟩

  obtain ⟨A₃, _, _, _, _, _, _, _, u₃, v₃, 𝔭₃, hBr, hu₃, hv₃, hPD₃, -⟩ :=
    wcpa_dj_llsm_br_inner_chart Ω W hW hWt A K L 𝔭 u v g a' (q' * w) hPD ha'm ha'0 hq''m hg

  refine (wcpa_dj_llsm_isi_chart_transport Ω W hW hWt A K L 𝔭 u v g a' (q' * w) q' A₃ u₃ v₃ 𝔭₃
    hPD ha'm ha'0 hq''m hg hBr hu₃ hv₃ hPD₃ hq'm hq'0 hq'q'').mp ?_

  obtain ⟨sA, hsA⟩ : ∃ sA : K,
      sA = algebraMap A K (algebraMap ↥W A (a' * q')) / algebraMap A K u := ⟨_, rfl⟩
  have hsep' : wcLlsSepAt W A K L u sA := by rw [hsA]; exact hsep
  obtain ⟨s₃, hs₃⟩ : ∃ s₃ : K,
      s₃ = algebraMap A₃ K (algebraMap ↥W A₃ q') / algebraMap A₃ K u₃ := ⟨_, rfl⟩
  show wcLlsSepAt W A₃ K L u₃ (algebraMap A₃ K (algebraMap ↥W A₃ q') / algebraMap A₃ K u₃)
  rw [← hs₃]

  intro 𝔮 _ h𝔮

  obtain ⟨Q, hQp, hQ, hlink⟩ := wcpa_dj_llsm_isir_contraction Ω W hW hWt A K L 𝔭 u v g a'
    (q' * w) q' A₃ u₃ v₃ 𝔭₃ hPD ha'm ha'0 hq''m hg hq'm hq'0 hq'q'' hBr hu₃ hv₃ hPD₃ sA hsA
    s₃ hs₃ 𝔮 h𝔮
  have := hQp

  obtain ⟨P, _, e, he⟩ := wcNd_hens_exists (Localization.AtPrime Q)
    (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) inferInstance

  have hmod := wcpa_dj_llsm_sd_good_model Ω W hW hWt A K L 𝔭 (.ann u v g) hPD u (a' * q') hbm hb0
    (Or.inr ⟨u, v, g, rfl, hbg, rfl⟩) sA hsA Q hQ (hsep' Q hQ) P e he

  obtain ⟨hu, hv, huv, hbr⟩ := wcpa_dj_llsm_isir_ann_branch_condition Ω W hW hWt A K L 𝔭 u v g
    hPD (a' * q') hbm hb0 hbg sA hsA Q hQ P e he

  obtain ⟨g₀, f₀, hf₀, n, ε, ω, hn, hε, hω, hgn, hform⟩ :=
    wcpa_dj_llsm_scrs_node_monomial Ω W hW hWt P _ hmod _ _ (a' * q') hbm hb0 hu hv huv hbr

  obtain ⟨f, hf, hsf, huf⟩ : ∃ f : wcEbntN W g₀ →+* P,
      wcEbntPres W (e.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {sA}) L)
          (Localization.AtPrime Q)).comp ((algebraMap ↥(Algebra.adjoin A {sA})
          ↥(integralClosure ↥(Algebra.adjoin A {sA}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {sA})).comp (algebraMap ↥W A))))) g₀ f ∧
      e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {sA}) L) (Localization.AtPrime Q)
          (algebraMap ↥(Algebra.adjoin A {sA}) ↥(integralClosure ↥(Algebra.adjoin A {sA}) L)
            ⟨sA, Algebra.subset_adjoin (Set.mem_singleton sA)⟩)) =
        ε * f (wcEbntX W g₀ 0) ^ n ∧
      (e.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {sA}) L)
          (Localization.AtPrime Q)).comp ((algebraMap ↥(Algebra.adjoin A {sA})
          ↥(integralClosure ↥(Algebra.adjoin A {sA}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {sA})).comp (algebraMap ↥W A))))) ω *
        e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {sA}) L) (Localization.AtPrime Q)
          (algebraMap ↥(Algebra.adjoin A {sA}) ↥(integralClosure ↥(Algebra.adjoin A {sA}) L)
            (algebraMap A ↥(Algebra.adjoin A {sA}) u))) * ε =
        f (wcEbntX W g₀ 1) ^ n := by
    rcases hform with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact ⟨f₀, hf₀, h1, h2⟩
    · obtain ⟨f', hf', h0', h1'⟩ := wcpa_dj_lr1k_ebnt_pres_swap Ω W P _ g₀ f₀ hf₀
      exact ⟨f', hf', by rw [h0']; exact h1, by rw [h1']; exact h2⟩

  have hωa : IsUnit (ω * a') → False := fun h => notUnitM a' ha'm (isUnit_of_mul_isUnit_right h)
  have hωa0 : ω * a' ≠ 0 := mul_ne_zero hω.ne_zero ha'0
  obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (((ω * a' : ↥W)) : Ω) (by omega : 0 < n)
  have hzW : z ∈ W := by
    by_contra hzW
    rcases ValuationSubring.mem_or_inv_mem W z with h | h
    · exact hzW h
    · have hz0 : z ≠ 0 := fun h0 => hzW (by rw [h0]; exact W.zero_mem)
      apply hωa
      refine IsUnit.of_mul_eq_one (⟨z⁻¹, h⟩ ^ n) ?_
      apply Subtype.ext
      have e1 : ((ω * a' * (⟨z⁻¹, h⟩ : ↥W) ^ n : ↥W) : Ω) =
          ((ω * a' : ↥W) : Ω) * z⁻¹ ^ n := rfl
      rw [e1, ← hz, ← mul_pow, mul_inv_cancel₀ hz0, one_pow, OneMemClass.coe_one]
  obtain ⟨μ, hμz⟩ : ∃ μ : ↥W, (μ : Ω) = z := ⟨⟨z, hzW⟩, rfl⟩
  have hμn : μ ^ n = ω * a' := Subtype.ext (by
    show ((μ : Ω)) ^ n = ((ω * a' : ↥W) : Ω)
    rw [hμz]; exact hz)
  have hμ0 : μ ≠ 0 := by
    intro h
    apply hωa0
    rw [← hμn, h, zero_pow (by omega : n ≠ 0)]
  have hμm : μ ∈ IsLocalRing.maximalIdeal ↥W :=
    mkM μ (fun hu => hωa (by rw [← hμn]; exact hu.pow n))
  obtain ⟨g₁, hg₁⟩ : μ ∣ g₀ := by
    rcases ValuationRing.dvd_total μ g₀ with h | ⟨r, hr⟩
    · exact h
    · exfalso
      apply notUnitM q' hq'm
      have h2 : μ ^ n = (g₀ * r) ^ n := by rw [← hr]
      rw [hμn, mul_pow, hgn] at h2
      have h1 : ω * a' * (q' * r ^ n) = ω * a' * 1 := by linear_combination -h2
      exact IsUnit.of_mul_eq_one _ (mul_left_cancel₀ hωa0 h1)
  have hg1n : g₁ ^ n = q' := by
    have h2 : (μ * g₁) ^ n = ω * (a' * q') := by rw [← hg₁]; exact hgn
    rw [mul_pow, hμn] at h2
    have h3 : ω * a' * g₁ ^ n = ω * a' * q' := by linear_combination h2
    exact mul_left_cancel₀ hωa0 h3
  have hg₁m : g₁ ∈ IsLocalRing.maximalIdeal ↥W :=
    mkM g₁ (fun hu => notUnitM q' hq'm (by rw [← hg1n]; exact hu.pow n))
  have hg₁0 : g₁ ≠ 0 := by
    intro h0
    apply hq'0
    rw [← hg1n, h0, zero_pow (by omega : n ≠ 0)]

  obtain ⟨Y', hY', hDdom, hDint, hModelB⟩ :=
    wcpa_dj_llsm_isir_node_dilatation Ω W hW hWt P _ g₀ f hf μ g₁ hμm hμ0 hg₁m hg₁0 hg₁

  obtain ⟨𝔐, h𝔐p, hX𝔐, hY𝔐, hm𝔐, P₃, _, e₃, e₃', he₃, he₃', hcomp⟩ :=
    wcpa_dj_llsm_isir_hens_transport Ω W hW hWt A K L 𝔭 u v g a' (q' * w) q' A₃ u₃ v₃ 𝔭₃ hPD
      ha'm ha'0 hq''m hg hq'm hq'0 hq'q'' hBr hu₃ hv₃ hPD₃ sA hsA s₃ hs₃ 𝔮 h𝔮 Q hQ hlink P e he
      g₀ f hf n ε ω hn hε hω hgn hsf huf μ g₁ hμm hμ0 hμn hg₁ Y' hY' hDdom hDint
  have := h𝔐p
  have hB := hModelB 𝔐 hX𝔐 hY𝔐 hm𝔐 P₃ e₃' he₃'
  rw [hcomp] at hB

  exact wcpa_dj_llsm_sd_model_good Ω W hW hWt A₃ K L 𝔭₃ (.ann u₃ v₃ (q' * w)) hPD₃ u₃ q' hq'm
    hq'0 (Or.inr ⟨u₃, v₃, q' * w, rfl, hq'q'', rfl⟩) s₃ hs₃ 𝔮 h𝔮 P₃ e₃ he₃ (Or.inr hB)

theorem wcpa_dj_llsm_br_inner_sep_iff : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g b₀ q β : ↥W)
    (y : Ideal ↥(integralClosure A L))
    (A₃ : Type u) [CommRing A₃] [IsDomain A₃] [Algebra ↥W A₃] [Algebra A₃ K]
    [IsFractionRing A₃ K] [Algebra A₃ L] [IsScalarTower A₃ K L] (u₃ v₃ : A₃) (𝔭₃ : Ideal A₃),
    wcLlsPD W A 𝔭 (.ann u v g) → y.IsPrime → y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
    wcLlsUniq A L 𝔭 y →
    b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 → q ∈ IsLocalRing.maximalIdeal ↥W → g = b₀ * q →
    wcLlsAnnSep W A K L u b₀ →
    β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 → β ∣ q → wcLlsAnnSep W A K L u (b₀ * β) →
    wcLlsBrSub W A K A₃ (algebraMap A K u / algebraMap A K (algebraMap ↥W A b₀))
      {algebraMap A K u / algebraMap A K (algebraMap ↥W A b₀), algebraMap A K v} →
    algebraMap A₃ K u₃ = algebraMap A K u / algebraMap A K (algebraMap ↥W A b₀) →
    algebraMap A₃ K v₃ = algebraMap A K v →
    wcLlsPD W A₃ 𝔭₃ (.ann u₃ v₃ q) →
    ∀ β' : ↥W, β' ∈ IsLocalRing.maximalIdeal ↥W → β' ≠ 0 → β' ∣ q →
      (wcLlsAnnSep W A₃ K L u₃ β' ↔ wcLlsAnnSep W A K L u (b₀ * β')) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g b₀ q β y A₃ _ _ _ _ _ _ _ u₃ v₃ 𝔭₃
    hPD _ _ _ hb₀m hb₀0 hqm hgq _ hβm hβ0 hβq hwit hBr hu₃ hv₃ hPD₃ β' hβ'm hβ'0 hβ'q
  have hb₀β'g : b₀ * β' ∣ g := by rw [hgq]; exact mul_dvd_mul_left b₀ hβ'q
  have hb₀βg : b₀ * β ∣ g := by rw [hgq]; exact mul_dvd_mul_left b₀ hβq
  have hb₀β'm : b₀ * β' ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_left _ b₀ hβ'm
  have hb₀β'0 : b₀ * β' ≠ 0 := mul_ne_zero hb₀0 hβ'0
  have hb₀βm : b₀ * β ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_left _ b₀ hβm
  have hb₀β0 : b₀ * β ≠ 0 := mul_ne_zero hb₀0 hβ0
  have hT := wcpa_dj_llsm_isi_chart_transport Ω W hW hWt A K L 𝔭 u v g b₀ q β' A₃ u₃ v₃ 𝔭₃
    hPD hb₀m hb₀0 hqm hgq hBr hu₃ hv₃ hPD₃ hβ'm hβ'0 hβ'q
  constructor
  · intro h3
    have H := hT.mp h3
    rcases ValuationRing.dvd_total β' β with hd | ⟨r, hr⟩
    · exact wcpa_dj_llsm_br_radial_mono Ω W hW hWt A K L 𝔭 (.ann u v g) u (b₀ * β) (b₀ * β')
        hPD (Or.inr ⟨v, g, rfl, hb₀βg⟩) hb₀βm hb₀β0 hb₀β'm hb₀β'0 (mul_dvd_mul_left b₀ hd) hwit
    · have hr0 : r ≠ 0 := by
        rintro rfl
        exact hβ'0 (by rw [hr, mul_zero])
      have e : b₀ * β' = b₀ * β * r := by rw [hr, mul_assoc]
      rw [e] at H hb₀β'g ⊢
      exact wcpa_dj_llsm_isi_overlap_glue Ω W hW hWt A K L 𝔭 u v g b₀ β r hPD hb₀m hb₀0 hβm hβ0
        hr0 hb₀β'g hwit H
  · intro h
    exact hT.mpr (wcpa_dj_llsm_isi_outer_restrict Ω W hW hWt A K L 𝔭 u v g b₀ β' hPD hb₀m hb₀0
      hβ'm hβ'0 hb₀β'g h)

theorem wcpa_dj_llsm_branch_reduction : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → wcLlsLocThm W (· ≤ 1) → wcLlsLocThmBR W (· = ℓ) →
    wcLlsLocThm W (· = ℓ) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ _hbase hBR
  classical
  intro A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 k y hPD hSolv hUniq hcard

  have hG : Nat.card (L ≃ₐ[K] L) = ℓ := by
    have hc : Nat.card ↥(wcLlsDec A K L y) = ℓ := hcard
    rw [(wcpa_dj_llsm_br_dec_top_iff A K L hPD.2.2.1 𝔭 y hSolv.1 hSolv.2.1).mpr hUniq,
      Subgroup.card_top] at hc
    exact hc
  haveI : Finite (L ≃ₐ[K] L) := Nat.finite_of_card_ne_zero (by rw [hG]; exact hℓ.ne_zero)
  haveI : Fact (Nat.card (L ≃ₐ[K] L)).Prime := ⟨by rw [hG]; exact hℓ⟩
  have grpBT : ∀ H : Subgroup (L ≃ₐ[K] L), H = ⊥ ∨ H = ⊤ :=
    fun H => Subgroup.eq_bot_or_eq_top_of_prime_card H
  haveI : IsCyclic (L ≃ₐ[K] L) := isCyclic_of_prime_card rfl
  have grpSolv : ∀ H : Subgroup (L ≃ₐ[K] L), Group.IsSolvable H := fun H =>
    Group.isSolvable_of_comm (fun a b => Subtype.ext (mul_comm' (a : L ≃ₐ[K] L) b))
  have cardOf : ∀ (A' : Type u) [CommRing A'] [Algebra A' L] (y' : Ideal ↥(integralClosure A' L)),
      wcLlsDec A' K L y' = ⊤ → Nat.card ↥(wcLlsDec A' K L y') = ℓ := by
    intro A' _ _ y' h
    rw [h, Subgroup.card_top]
    exact hG

  have notUnitM : ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → ¬ IsUnit x :=
    fun x hx => (IsLocalRing.mem_maximalIdeal x).mp hx
  have strictOf : ∀ b b' : ↥W, b ∣ b' → ¬ b' ∣ b →
      ∃ q : ↥W, q ∈ IsLocalRing.maximalIdeal ↥W ∧ b' = b * q := by
    rintro b b' ⟨q, hq⟩ hn
    refine ⟨q, ?_, hq⟩
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    rintro ⟨v, rfl⟩
    exact hn ⟨↑v⁻¹, by rw [hq, mul_assoc, Units.mul_inv, mul_one]⟩
  have noDvdStrict : ∀ b q : ↥W, b ≠ 0 → q ∈ IsLocalRing.maximalIdeal ↥W → ¬ (b * q ∣ b) := by
    rintro b q hb hq ⟨s, hs⟩
    have h1 : b * (q * s) = b * 1 := by rw [mul_one, ← mul_assoc]; exact hs.symm
    have h2 : q * s = 1 := mul_left_cancel₀ hb h1
    exact notUnitM q hq ⟨⟨q, s, h2, by rw [mul_comm]; exact h2⟩, rfl⟩
  have minDvd : ∀ S : Finset ↥W, S.Nonempty → ∃ b ∈ S, ∀ d ∈ S, b ∣ d := by
    intro S
    induction S using Finset.induction_on with
    | empty => intro h; exact absurd h Finset.not_nonempty_empty
    | insert a S haS ih =>
      intro _
      rcases S.eq_empty_or_nonempty with hS | hS
      · refine ⟨a, Finset.mem_insert_self _ _, ?_⟩
        intro d hd
        rw [hS] at hd
        simp only [Finset.mem_insert, Finset.notMem_empty, or_false] at hd
        rw [hd]
      · obtain ⟨b, hb, hbd⟩ := ih hS
        rcases ValuationRing.dvd_total a b with hab | hba
        · refine ⟨a, Finset.mem_insert_self _ _, ?_⟩
          intro d hd
          rcases Finset.mem_insert.mp hd with h | h
          · rw [h]
          · exact hab.trans (hbd d h)
        · refine ⟨b, Finset.mem_insert_of_mem hb, ?_⟩
          intro d hd
          rcases Finset.mem_insert.mp hd with h | h
          · rw [h]; exact hba
          · exact hbd d h

  have finishD : ∀ (S'' S : ↥W → ↥W → Prop) (c b : ↥W), c ∈ IsLocalRing.maximalIdeal ↥W →
      b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
      (∀ e β : ↥W, e ∈ IsLocalRing.maximalIdeal ↥W → β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 →
        (S'' e β ↔ S (c + b * e) (b * β))) →
      (∃ e β : ↥W, e ∈ IsLocalRing.maximalIdeal ↥W ∧ β ∈ IsLocalRing.maximalIdeal ↥W ∧ β ≠ 0 ∧
        S'' e β ∧ ∀ e' β' : ↥W, e' ∈ IsLocalRing.maximalIdeal ↥W →
          β' ∈ IsLocalRing.maximalIdeal ↥W → β' ≠ 0 → S'' e' β' → β ∣ β' → β ∣ e' - e → β' ∣ β) →
      (∃ c₀ b₀ : ↥W, c₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ b₀ ∈ IsLocalRing.maximalIdeal ↥W ∧
        b₀ ≠ 0 ∧ S c₀ b₀ ∧ ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W →
