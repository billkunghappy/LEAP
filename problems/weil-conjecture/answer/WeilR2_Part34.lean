      show θ (algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
        ((⟨x₁, h₁⟩ : ↥(wcIcxRI W A K u a' b)) + ⟨x₂, h₂⟩)) = _
