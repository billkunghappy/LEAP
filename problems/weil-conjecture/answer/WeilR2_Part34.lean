import WeilR2_Part33
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wcpa_dj_llsm_isiccc_outer_match : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' b : ↥W)
    (hRo : wcLlsASbS W A K u b ≤ wcLlsASbS W A K u a')
    (hoC : wcLlsASbS W A K u a' ≤ wcLlsIsiCR W A K u a'),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    a' ∣ b → ¬ b ∣ a' → b ∣ g →
    ∀ (y₀ : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u b) L)), y₀.IsPrime →
    y₀.comap (algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)) =
      wcLlsASbN W A K u b →
    ∀ (Qo Ps Pu : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u a') L)), Qo.IsPrime →
    Qo.comap (wcIcxIncl L _ _ hRo) = y₀ →
    Qo.comap (algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) =
      wcLlsASbN W A K u a' →
    Ps ∈ (wcIccM W (wcIccWL W A K L) ↥(wcLlsASbS W A K u a')).minimalPrimes →
    Pu ∈ (wcIccM W (wcIccWL W A K L) ↥(wcLlsASbS W A K u a')).minimalPrimes →
    Ps ≤ Qo → Pu ≤ Qo → wcIccYo W A K L u a' ∈ Ps → wcIccUo W A K L u a' ∉ Ps →
    wcIccUo W A K L u a' ∈ Pu → wcIccYo W A K L u a' ∉ Pu →
    (∀ E₁ ∈ (wcIccM W (wcIccWL W A K L) ↥(wcLlsASbS W A K u a')).minimalPrimes,
      ∀ E₂ ∈ (wcIccM W (wcIccWL W A K L) ↥(wcLlsASbS W A K u a')).minimalPrimes,
      ∀ E₃ ∈ (wcIccM W (wcIccWL W A K L) ↥(wcLlsASbS W A K u a')).minimalPrimes,
      E₁ ≤ Qo → E₂ ≤ Qo → E₃ ≤ Qo → E₁ = E₂ ∨ E₁ = E₃ ∨ E₂ = E₃) →
    (∀ Q : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u a') L), Q.IsPrime →
      Q.comap (wcIcxIncl L _ _ hRo) = y₀ →
      Q.comap (algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) =
        wcLlsASbN W A K u a' → Q = Qo) →
    ∀ (𝔎 : Ideal ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)), 𝔎.IsPrime →
    𝔎.comap (wcIcxIncl L _ _ (hRo.trans hoC)) = y₀ →
    (∀ w ∈ IsLocalRing.maximalIdeal ↥W, wcIccCst W A K L (wcLlsIsiCR W A K u a') w ∈ 𝔎) →
    wcIccYC W A K L u a' ∉ 𝔎 →
    (∀ δ : ↥(integralClosure ↥(wcLlsASbS W A K u a') L),
      wcIcxIncl L _ _ hoC δ * wcIccYC W A K L u a' - 1 ∉ 𝔎) →
    Pu ≤ 𝔎.comap (wcIcxIncl L _ _ hoC) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' b hRo hoC hPD ha'm ha'0
    hbm hb0 ha'b hnba hbg y₀ hy₀ hy₀c Qo Ps Pu hQo hQoy hQoN hPs hPu hPsQ hPuQ hyPs huPs
    huPu hyPu hbound huniq 𝔎 h𝔎 h𝔎y h𝔎m hyK hδK
  classical
  haveI := hy₀
  haveI := hQo
  haveI := h𝔎
  have hPD' := hPD
  obtain ⟨_, hNZ, _, _, _, _, hg0, huv, _⟩ := hPD'

  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    rw [Algebra.algebraMap_eq_smul_one] at hw
    rcases smul_eq_zero.mp hw with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hu0 : algebraMap A K u ≠ 0 := by
    intro h
    apply hg0
    apply hWA
    apply IsFractionRing.injective A K
    rw [map_zero, map_zero, ← huv, map_mul, h, zero_mul]

  have hN₀max : (wcLlsASbN W A K u b).IsMaximal := by
    have hne : wcLlsASbN W A K u b ≠ ⊤ := by
      rw [← hy₀c]; exact Ideal.comap_ne_top _ hy₀.ne_top
    exact wcpa_dj_llsm_brrm_node_max Ω W hW hWt A K 𝔭 (.ann u v g) u b hPD
      (Or.inr ⟨v, g, rfl, hbg⟩) hbm hb0 _ rfl hne
  have hNomax : (wcLlsASbN W A K u a').IsMaximal := by
    have hne : wcLlsASbN W A K u a' ≠ ⊤ := by
      rw [← hQoN]; exact Ideal.comap_ne_top _ hQo.ne_top
    exact wcpa_dj_llsm_brrm_node_max Ω W hW hWt A K 𝔭 (.ann u v g) u a' hPD
      (Or.inr ⟨v, g, rfl, dvd_trans ha'b hbg⟩) ha'm ha'0 _ rfl hne

  have hy₀max : y₀.IsMaximal := by
    apply Ideal.isMaximal_of_isIntegral_of_isMaximal_comap
      (algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L))
      (algebraMap_isIntegral_iff.mpr inferInstance) y₀
    rw [hy₀c]; exact hN₀max

  have hιy : wcIcxIncl L _ _ hoC (wcIccYo W A K L u a') = wcIccYC W A K L u a' :=
    Subtype.ext rfl
  have hcomp : ∀ x : ↥(integralClosure ↥(wcLlsASbS W A K u b) L),
      wcIcxIncl L _ _ hoC (wcIcxIncl L _ _ hRo x) = wcIcxIncl L _ _ (hRo.trans hoC) x :=
    fun _ => Subtype.ext rfl
  have hyu : wcIccYo W A K L u a' * wcIccUo W A K L u a' =
      wcIccCst W A K L (wcLlsASbS W A K u a') a' := by
    apply Subtype.ext
    rw [MulMemClass.coe_mul]
    show algebraMap K L (algebraMap A K (algebraMap ↥W A a') / algebraMap A K u) *
        algebraMap K L (algebraMap A K u) = algebraMap K L (algebraMap A K (algebraMap ↥W A a'))
    rw [← map_mul, div_mul_cancel₀ _ hu0]

  have hKoP : (𝔎.comap (wcIcxIncl L _ _ hoC)).IsPrime := Ideal.comap_isPrime _ _
  have hIK : wcIccM W (wcIccWL W A K L) ↥(wcLlsASbS W A K u a') ≤
      𝔎.comap (wcIcxIncl L _ _ hoC) := by
    rw [Ideal.span_le]
    rintro c ⟨w, hw, hc⟩
    rw [SetLike.mem_coe, Ideal.mem_comap]
    have : wcIcxIncl L _ _ hoC c = wcIccCst W A K L (wcLlsIsiCR W A K u a') w := Subtype.ext hc
    rw [this]
    exact h𝔎m w hw
  have hcstKo : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      wcIccCst W A K L (wcLlsASbS W A K u a') w ∈ 𝔎.comap (wcIcxIncl L _ _ hoC) :=
    fun w hw => hIK (Ideal.subset_span ⟨w, hw, rfl⟩)
  have hyKo : wcIccYo W A K L u a' ∉ 𝔎.comap (wcIcxIncl L _ _ hoC) := by
    rw [Ideal.mem_comap, hιy]; exact hyK
  have huKo : wcIccUo W A K L u a' ∈ 𝔎.comap (wcIcxIncl L _ _ hoC) := by
    have h := hcstKo a' ha'm
    rw [← hyu] at h
    exact (hKoP.mem_or_mem h).resolve_left hyKo
  have hy₀Ko : ∀ z ∈ y₀, wcIcxIncl L _ _ hRo z ∈ 𝔎.comap (wcIcxIncl L _ _ hoC) := by
    intro z hz
    rw [Ideal.mem_comap, hcomp, ← Ideal.mem_comap, h𝔎y]
    exact hz

  have hJ : 𝔎.comap (wcIcxIncl L _ _ hoC) ⊔ Ideal.span {wcIccYo W A K L u a'} ≠ ⊤ := by
    intro hJ
    rw [Ideal.eq_top_iff_one, Submodule.mem_sup] at hJ
    obtain ⟨κ, hκ, z, hz, hsum⟩ := hJ
    obtain ⟨δ, rfl⟩ := Ideal.mem_span_singleton'.mp hz
    apply hδK δ
    have h1 : wcIcxIncl L _ _ hoC κ + wcIcxIncl L _ _ hoC δ * wcIccYC W A K L u a' = 1 := by
      rw [← hιy, ← map_mul, ← map_add, hsum, map_one]
    have h2 : wcIcxIncl L _ _ hoC δ * wcIccYC W A K L u a' - 1 =
        -(wcIcxIncl L _ _ hoC κ) := by
      rw [← h1]; ring
    rw [h2]
    exact neg_mem (Ideal.mem_comap.mp hκ)

  obtain ⟨P, hPmax, hJP⟩ := Ideal.exists_le_maximal _ hJ
  have hKoP' : 𝔎.comap (wcIcxIncl L _ _ hoC) ≤ P := le_sup_left.trans hJP
  have hyP : wcIccYo W A K L u a' ∈ P :=
    hJP (Ideal.mem_sup_right (Ideal.mem_span_singleton_self _))
  have hPN : P.comap (algebraMap ↥(wcLlsASbS W A K u a')
      ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) = wcLlsASbN W A K u a' := by
    symm
    apply hNomax.eq_of_le (Ideal.comap_ne_top _ hPmax.ne_top)
    unfold wcLlsASbN
    apply sup_le
    · rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
      exact ⟨hKoP' huKo, hyP⟩
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      have hc : algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)
          (((algebraMap A ↥(wcLlsASbS W A K u a')).comp (algebraMap ↥W A)) w) =
          wcIccCst W A K L (wcLlsASbS W A K u a') w := Subtype.ext rfl
      show algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)
          (((algebraMap A ↥(wcLlsASbS W A K u a')).comp (algebraMap ↥W A)) w) ∈ P
      rw [hc]
      exact hKoP' (hcstKo w hw)
  have hPy : P.comap (wcIcxIncl L _ _ hRo) = y₀ := by
    symm
    apply hy₀max.eq_of_le (Ideal.comap_ne_top _ hPmax.ne_top)
    intro z hz
    exact hKoP' (hy₀Ko z hz)
  have hPQ : P = Qo := huniq P hPmax.isPrime hPy hPN
  have hKoQ : 𝔎.comap (wcIcxIncl L _ _ hoC) ≤ Qo := hPQ ▸ hKoP'

  obtain ⟨P', hP', hP'K⟩ := Ideal.exists_minimalPrimes_le hIK
  have hP'prime : P'.IsPrime := hP'.1.1
  have hyP' : wcIccYo W A K L u a' ∉ P' := fun h => hyKo (hP'K h)
  have huP' : wcIccUo W A K L u a' ∈ P' := by
    have h : wcIccYo W A K L u a' * wcIccUo W A K L u a' ∈ P' := by
      rw [hyu]; exact hP'.1.2 (Ideal.subset_span ⟨a', ha'm, rfl⟩)
    exact (hP'prime.mem_or_mem h).resolve_left hyP'
  rcases hbound P' hP' Ps hPs Pu hPu (hP'K.trans hKoQ) hPsQ hPuQ with h | h | h
  · exact absurd (h ▸ huP') huPs
  · rw [← h]; exact hP'K
  · exact absurd (h ▸ hyPs) hyPu

theorem wcpa_dj_llsm_isiccc_base_maximal : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' b : ↥W)
    (hRo : wcLlsASbS W A K u b ≤ wcLlsASbS W A K u a')
    (hoC : wcLlsASbS W A K u a' ≤ wcLlsIsiCR W A K u a'),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    a' ∣ b → ¬ b ∣ a' → b ∣ g →
    ∀ (𝔎 : Ideal ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)), 𝔎.IsPrime →
    (∀ w ∈ IsLocalRing.maximalIdeal ↥W, wcIccCst W A K L (wcLlsIsiCR W A K u a') w ∈ 𝔎) →
    (𝔎.comap (wcIcxIncl L _ _ (hRo.trans hoC))).IsMaximal :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' b hRo hoC hPD ha'm ha'0
    hbm hb0 ha'b hnba hbg 𝔎 h𝔎 hK
  classical
  haveI := h𝔎
  obtain ⟨e, he⟩ := ha'b
  have hPD' := hPD
  obtain ⟨_, hNZ, _, _, _, _, hg0, huv, _⟩ := hPD'
  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    rw [Algebra.algebraMap_eq_smul_one] at hw
    rcases smul_eq_zero.mp hw with h | h
    · exact h
    · exact absurd h one_ne_zero
  have ha0 : algebraMap A K (algebraMap ↥W A a') ≠ 0 := by
    intro h
    apply ha'0
    apply hWA
    apply IsFractionRing.injective A K
    rw [map_zero, map_zero, h]
  have hem : e ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hne
    have hU : IsUnit e := by
      by_contra h
      exact hne ((IsLocalRing.mem_maximalIdeal e).mpr h)
    apply hnba
    refine ⟨↑hU.unit⁻¹, ?_⟩
    rw [he, mul_assoc, IsUnit.mul_val_inv, mul_one]
  set ι := wcIcxIncl L _ _ (hRo.trans hoC) with hι

  have hu : ι (algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
      (algebraMap A ↥(wcLlsASbS W A K u b) u)) =
      wcIccCst W A K L (wcLlsIsiCR W A K u a') a' *
        algebraMap ↥(wcLlsIsiCR W A K u a') ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)
          ⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_insert _ _)⟩ := by
    apply Subtype.ext
    show algebraMap K L (algebraMap A K u) =
      algebraMap K L (algebraMap A K (algebraMap ↥W A a')) * algebraMap K L (wcLlsIsiS1 W A K u a')
    rw [← map_mul]
    congr 1
    unfold wcLlsIsiS1
    field_simp
  have hs : ι (algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
      ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K u,
        Algebra.subset_adjoin (Set.mem_singleton _)⟩) =
      wcIccCst W A K L (wcLlsIsiCR W A K u a') e * wcIccYC W A K L u a' := by
    apply Subtype.ext
    show algebraMap K L (algebraMap A K (algebraMap ↥W A b) / algebraMap A K u) =
      algebraMap K L (algebraMap A K (algebraMap ↥W A e)) * algebraMap K L (wcLlsIsiS2 W A K u a')
    rw [← map_mul]
    congr 1
    unfold wcLlsIsiS2
    rw [he, map_mul, map_mul]
    ring
  have hw : ∀ w : ↥W, ι (algebraMap ↥(wcLlsASbS W A K u b)
      ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
      (((algebraMap A ↥(wcLlsASbS W A K u b)).comp (algebraMap ↥W A)) w)) =
      wcIccCst W A K L (wcLlsIsiCR W A K u a') w := fun w => Subtype.ext rfl
  set Q₀ : Ideal ↥(wcLlsASbS W A K u b) := (𝔎.comap ι).comap
    (algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)) with hQ₀
  have hle : wcLlsASbN W A K u b ≤ Q₀ := by
    unfold wcLlsASbN
    apply sup_le
    · rw [Ideal.span_le]
      intro z hz
      rcases Set.mem_insert_iff.mp hz with h | h
      · rw [h]
        show ι _ ∈ 𝔎
        rw [hu]
        exact 𝔎.mul_mem_right _ (hK a' ha'm)
      · rw [Set.mem_singleton_iff.mp h]
        show ι _ ∈ 𝔎
        rw [hs]
        exact 𝔎.mul_mem_right _ (hK e hem)
    · rw [Ideal.map_le_iff_le_comap]
      intro w hwm
      show ι _ ∈ 𝔎
      rw [hw]
      exact hK w hwm
  haveI hQprime : (𝔎.comap ι).IsPrime := Ideal.comap_isPrime ι 𝔎
  haveI hQ₀prime : Q₀.IsPrime := Ideal.comap_isPrime _ _
  have hQ₀ne : Q₀ ≠ ⊤ := hQ₀prime.ne_top
  have hNne : wcLlsASbN W A K u b ≠ ⊤ := fun h => hQ₀ne (top_le_iff.mp (h ▸ hle))
  have hmax := wcpa_dj_llsm_brrm_node_max Ω W hW hWt A K 𝔭 (.ann u v g) u b hPD
    (Or.inr ⟨v, g, rfl, hbg⟩) hbm hb0 _ rfl hNne
  have hmax' : (wcLlsASbN W A K u b).IsMaximal := hmax
  have hEq : wcLlsASbN W A K u b = Q₀ := hmax'.eq_of_le hQ₀ne hle
  have hQ₀max : Q₀.IsMaximal := hEq ▸ hmax'
  exact Ideal.isMaximal_of_isIntegral_of_isMaximal_comap
    (algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L))
    (algebraMap_isIntegral_iff.mpr inferInstance) (𝔎.comap ι) hQ₀max

theorem wcpa_dj_llsm_isicc_circle_component : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' b : ↥W)
    (hRo : wcLlsASbS W A K u b ≤ wcLlsASbS W A K u a')
    (hRI : wcLlsASbS W A K u b ≤ wcIcxRI W A K u a' b)
    (hoC : wcLlsASbS W A K u a' ≤ wcLlsIsiCR W A K u a')
    (hIC : wcIcxRI W A K u a' b ≤ wcLlsIsiCR W A K u a'),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    a' ∣ b → ¬ b ∣ a' → b ∣ g → wcLlsIsiCirc W A K L u a' →
    ∀ (y₀ : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u b) L)), y₀.IsPrime →
    y₀.comap (algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)) =
      wcLlsASbN W A K u b →
    ∀ (Qo Ps Pu : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u a') L))
      (QI E : Ideal ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)),
    Qo.IsPrime → QI.IsPrime →
    Qo.comap (wcIcxIncl L _ _ hRo) = y₀ → QI.comap (wcIcxIncl L _ _ hRI) = y₀ →
    Qo.comap (algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) =
      wcLlsASbN W A K u a' →
    QI.comap (algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)) =
      wcIcxNI W A K u a' b →
    Ps ∈ (wcIccM W (wcIccWL W A K L) ↥(wcLlsASbS W A K u a')).minimalPrimes →
    Pu ∈ (wcIccM W (wcIccWL W A K L) ↥(wcLlsASbS W A K u a')).minimalPrimes →
    Ps ≤ Qo → Pu ≤ Qo → wcIccYo W A K L u a' ∈ Ps → wcIccUo W A K L u a' ∉ Ps →
    wcIccUo W A K L u a' ∈ Pu → wcIccYo W A K L u a' ∉ Pu →
    (∀ E₁ ∈ (wcIccM W (wcIccWL W A K L) ↥(wcLlsASbS W A K u a')).minimalPrimes,
      ∀ E₂ ∈ (wcIccM W (wcIccWL W A K L) ↥(wcLlsASbS W A K u a')).minimalPrimes,
      ∀ E₃ ∈ (wcIccM W (wcIccWL W A K L) ↥(wcLlsASbS W A K u a')).minimalPrimes,
      E₁ ≤ Qo → E₂ ≤ Qo → E₃ ≤ Qo → E₁ = E₂ ∨ E₁ = E₃ ∨ E₂ = E₃) →
    (∀ Q : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u a') L), Q.IsPrime →
      Q.comap (wcIcxIncl L _ _ hRo) = y₀ →
      Q.comap (algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) =
