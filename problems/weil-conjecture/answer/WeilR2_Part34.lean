  refine ⟨rα * e' * yo + rβ * β, Ps.add_mem (Ps.mul_mem_left _ hyo) (Ps.mul_mem_left _ hβ),
    hη, ?_⟩


  intro z
  obtain ⟨q, hq⟩ := h1 z
  obtain ⟨rq, hrq⟩ := onto q.divX
  refine ⟨q.coeff 0, rq, ?_⟩
  have hq' := congrArg Polynomial.toLaurent (Polynomial.divX_mul_X_add q)
  rw [map_add, map_mul, Polynomial.toLaurent_X, Polynomial.toLaurent_C] at hq'
  rw [map_sub, map_mul, hη, hq, hrq]
  linear_combination -hq'

theorem wcpa_dj_llsm_isicc_outer_end : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
