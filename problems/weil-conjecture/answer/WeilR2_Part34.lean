        wcIccCst W A K L (wcLlsIsiCR W A K u a') w := Subtype.ext rfl
    rw [hθ, e, hψW, LaurentPolynomial.invert_C]
  have hCC : (LaurentPolynomial.C c : LaurentPolynomial (IsLocalRing.ResidueField ↥W)) *
      LaurentPolynomial.C c⁻¹ = 1 := by
    rw [← map_mul, mul_inv_cancel₀ hc, map_one]
  have hTT : (LaurentPolynomial.T (-(k : ℤ)) : LaurentPolynomial (IsLocalRing.ResidueField ↥W)) *
      LaurentPolynomial.T (k : ℤ) = 1 := by
    rw [← LaurentPolynomial.T_add, neg_add_cancel, LaurentPolynomial.T_zero]
  have hθx : θ (wcIccXI W A K L u a' b) =
      LaurentPolynomial.C c⁻¹ * LaurentPolynomial.T (k : ℤ) := by
    have e1 : wcIcxIncl L _ _ hIC (wcIccXI W A K L u a' b) * wcIccYC W A K L u a' = 1 := by
      apply Subtype.ext
      rw [MulMemClass.coe_mul, OneMemClass.coe_one]
      show algebraMap K L (wcLlsIsiS1 W A K u a') * algebraMap K L (wcLlsIsiS2 W A K u a') = 1
      rw [← map_mul, hxy, map_one]
    have e2 : θ (wcIccXI W A K L u a' b) *
        (LaurentPolynomial.C c * LaurentPolynomial.T (-(k : ℤ))) = 1 := by
      have e3 := congrArg (fun t => LaurentPolynomial.invert (ψ (Ideal.Quotient.mk 𝔎 t))) e1
      simp only [map_mul, map_one, hψy, LaurentPolynomial.invert_C,
        LaurentPolynomial.invert_T] at e3
      rw [hθ]
      exact e3
    linear_combination (LaurentPolynomial.C c⁻¹ * LaurentPolynomial.T (k : ℤ)) * e2 -
      θ (wcIccXI W A K L u a' b) * (LaurentPolynomial.T (-(k : ℤ)) *
        LaurentPolynomial.T (k : ℤ)) * hCC - θ (wcIccXI W A K L u a' b) * hTT
  have hθs : θ (wcIccSI W A K L u a' b) = 0 := (hker _).mpr hsE
  have h3 : ∀ a : IsLocalRing.ResidueField ↥W,
      ∃ e : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L), θ e = LaurentPolynomial.C a := by
    intro a
    obtain ⟨w, rfl⟩ := IsLocalRing.residue_surjective a
    exact ⟨_, hcst w⟩

  have hRT := RT Ω W A 𝔭 hFT h𝔭M hm𝔭
  obtain ⟨h', hh'⟩ := hbg
  have hvR : algebraMap A ↥(wcIcxRI W A K u a' b) v =
      algebraMap A ↥(wcIcxRI W A K u a' b) (algebraMap ↥W A h') *
        (⟨wcLlsIsiS2 W A K u b, hS2mem⟩ : ↥(wcIcxRI W A K u a' b)) := by
    apply Subtype.ext
    show algebraMap A K v = algebraMap A K (algebraMap ↥W A h') *
      (algebraMap A K (algebraMap ↥W A b) / algebraMap A K u)
    have h1 := congrArg (algebraMap A K) huv
    simp only [hh', map_mul] at h1
    rw [mul_div_assoc', eq_div_iff hu0]
    linear_combination h1
  have huR : algebraMap A ↥(wcIcxRI W A K u a' b) u =
      algebraMap A ↥(wcIcxRI W A K u a' b) (algebraMap ↥W A a') *
        (⟨wcLlsIsiS1 W A K u a', hS1mem⟩ : ↥(wcIcxRI W A K u a' b)) := by
    apply Subtype.ext
    show algebraMap A K u = algebraMap A K (algebraMap ↥W A a') *
      (algebraMap A K u / algebraMap A K (algebraMap ↥W A a'))
    rw [mul_div_assoc', eq_div_iff ha0]
    ring
  have hW' : ∀ w : ↥W, θ (algebraMap ↥(wcIcxRI W A K u a' b)
      ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
      (algebraMap A ↥(wcIcxRI W A K u a' b) (algebraMap ↥W A w))) =
      LaurentPolynomial.C (IsLocalRing.residue ↥W w) := by
    intro w
    have e1 : algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
        (algebraMap A ↥(wcIcxRI W A K u a' b) (algebraMap ↥W A w)) =
        wcIccCst W A K L (wcIcxRI W A K u a' b) w := Subtype.ext rfl
    rw [e1, hcst]
  obtain ⟨φA, hφA⟩ : ∃ f : A →+* LaurentPolynomial (IsLocalRing.ResidueField ↥W),
      ∀ a, f a = θ (algebraMap ↥(wcIcxRI W A K u a' b)
        ↥(integralClosure ↥(wcIcxRI W A K u a' b) L) (algebraMap A ↥(wcIcxRI W A K u a' b) a)) :=
    ⟨(θ.comp (algebraMap _ _)).comp (algebraMap _ _), fun _ => rfl⟩
  have hXI : algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
      ⟨wcLlsIsiS1 W A K u a', hS1mem⟩ = wcIccXI W A K L u a' b := rfl
  have hSI : algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
      ⟨wcLlsIsiS2 W A K u b, hS2mem⟩ = wcIccSI W A K L u a' b := rfl
  have hresa : IsLocalRing.residue ↥W a' = 0 := by
    rw [IsLocalRing.residue_eq_zero_iff]; exact ha'm
  have hAu : φA u = 0 := by
    rw [hφA, huR, map_mul, map_mul, hW', hXI, hθx, hresa, map_zero, zero_mul]
  have hAv : φA v = 0 := by
    rw [hφA, hvR, map_mul, map_mul, hSI, hθs, mul_zero]
  have h𝔭ker : 𝔭 ≤ RingHom.ker φA := by
    rw [h𝔭eq]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      intro x hx
      rcases Set.mem_insert_iff.mp hx with hx | hx
      · rw [hx, SetLike.mem_coe, RingHom.mem_ker]; exact hAu
      · rw [Set.mem_singleton_iff] at hx
        rw [hx, SetLike.mem_coe, RingHom.mem_ker]; exact hAv
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      have hw0 : IsLocalRing.residue ↥W w = 0 := by
        rw [IsLocalRing.residue_eq_zero_iff]; exact hw
      rw [Ideal.mem_comap, RingHom.mem_ker, hφA, hW', hw0, map_zero]
  have hAconst : ∀ a : A, ∃ q : Polynomial (IsLocalRing.ResidueField ↥W),
      θ (algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
        (algebraMap A ↥(wcIcxRI W A K u a' b) a)) = Polynomial.toLaurent q := by
    intro a
    obtain ⟨w, hw⟩ := hRT a
    have h0 := h𝔭ker hw
    rw [RingHom.mem_ker, map_sub, sub_eq_zero, hφA, hφA, hW'] at h0
    exact ⟨Polynomial.C (IsLocalRing.residue ↥W w), by rw [h0, Polynomial.toLaurent_C]⟩
  have hR : ∀ r : ↥(wcIcxRI W A K u a' b), ∃ q : Polynomial (IsLocalRing.ResidueField ↥W),
      θ (algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L) r) =
        Polynomial.toLaurent q := by
    rintro ⟨x, hx⟩
    refine Algebra.adjoin_induction
      (s := {wcLlsIsiS1 W A K u a', wcLlsIsiS2 W A K u b})
      (p := fun x hx => ∃ q : Polynomial (IsLocalRing.ResidueField ↥W),
