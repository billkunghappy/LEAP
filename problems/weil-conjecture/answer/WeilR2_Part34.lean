      have h0 := IsLocalization.isLocalization_atPrime_localization_atPrime (Submonoid.powers e)
        (𝔓.map (algebraMap E (Localization.Away e)))
      convert h0 using 2
      rw [hcomap]
    let ι : Localization.AtPrime 𝔓 ≃ₐ[E]
        Localization.AtPrime (𝔓.map (algebraMap E (Localization.Away e))) :=
      IsLocalization.algEquiv 𝔓.primeCompl _ _
    haveI hDD : IsDomain (Localization.AtPrime 𝔓) :=
      MulEquiv.isDomain _ ι.toRingEquiv.toMulEquiv
    haveI hDI : IsIntegrallyClosed (Localization.AtPrime 𝔓) :=
      IsIntegrallyClosed.of_equiv ι.symm.toRingEquiv
    refine ⟨hDD, hDI, (ι.symm.toRingEquiv.toRingHom).comp
      ((algebraMap (Localization.Away e)
        (Localization.AtPrime (𝔓.map (algebraMap E (Localization.Away e))))).comp f),
      ?_, ?_, ?_, ?_, ?_⟩
    · refine RingHom.FormallyUnramified.comp (RingHom.FormallyUnramified.comp ?_ ?_) ?_
      · exact (RingHom.formallyUnramified_algebraMap (R := wcEbntN W ζ)
          (S := Localization.Away e)).mpr inferInstance
      · exact RingHom.formallyUnramified_algebraMap.mpr
          (Algebra.FormallyUnramified.of_isLocalization
            (𝔓.map (algebraMap E (Localization.Away e))).primeCompl)
      · exact RingHom.FormallyUnramified.of_surjective ι.symm.surjective
    · refine RingHom.EssFiniteType.comp (RingHom.EssFiniteType.comp ?_ ?_) ?_
      · have hgen : ∀ (R S : Type u) [CommRing R] [CommRing S] (f' : R →+* S),
            f'.Etale → f'.EssFiniteType := by
          intro R S _ _ f' hf'
          letI : Algebra R S := f'.toAlgebra
          haveI : Algebra.Etale R S := hf'
          haveI : Algebra.FinitePresentation R S := inferInstance
          haveI : Algebra.FiniteType R S := inferInstance
          exact RingHom.essFiniteType_algebraMap.mpr inferInstance
        exact @hgen (wcEbntN W ζ) (Localization.Away e) _ _ f hfet
      · exact RingHom.essFiniteType_algebraMap.mpr
          (Algebra.EssFiniteType.of_isLocalization _
            (𝔓.map (algebraMap E (Localization.Away e))).primeCompl)
      · exact RingHom.FiniteType.essFiniteType
          (RingHom.FiniteType.of_surjective _ ι.symm.surjective)
    · refine RingHom.ext (fun w => ?_)
      have h1 := RingHom.congr_fun hfC w
      simp only [RingHom.comp_apply] at h1 ⊢
      rw [h1, ← IsScalarTower.algebraMap_apply]
      exact ι.symm.commutes _
    · simp only [RingHom.comp_apply]
      rw [hf0, ← IsScalarTower.algebraMap_apply]
      exact ι.symm.commutes _
    · simp only [RingHom.comp_apply]
      rw [hf1, ← IsScalarTower.algebraMap_apply]
      exact ι.symm.commutes _
  intro ℓ hℓ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD hdeg c b d w₁ F₁ m₀ ω ζ α β x hc hb hb0 hB
    hαβ hζm hζ0 𝔮 _ hq z z' μ ν hE T _ _ j h π hj hh hjW hπC hπ0 hπ1 hπet hlift hden xT UT hxT
    hUT H4
  unfold wcLlsKPBoundaryCore at hB
  obtain ⟨hd, -, hw₁, hmon, hdeg₁, hroot, -, -, -, -, -, -, -, x₁, x₂, x₃, hx₁, hx₂, hx₃, hUeq⟩ := hB
  unfold wcLlsKPbdsElems at hE
  obtain ⟨ha1, ha2, hb1, hb2, hcc, hdw, hez, hez', -, -, htr⟩ := hE
  obtain ⟨-, hNZ, -, hmax, -, -, hpeq, -⟩ := hPD
  haveI := hNZ

  have hW : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)}) (algebraMap ↥W A w) ∈
        𝔮.comap (algebraMap ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)})
          ↥(integralClosure ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
            algebraMap A K (t - algebraMap ↥W A c)}) L)) := by
    intro w hw
    rw [hq]
    exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)
  have hJp : (𝔮.comap (algebraMap ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)})
          ↥(integralClosure ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
            algebraMap A K (t - algebraMap ↥W A c)}) L))).IsPrime :=
    Ideal.IsPrime.comap _
  have htJ : algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)}) t ∈
        𝔮.comap (algebraMap ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)})
          ↥(integralClosure ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
            algebraMap A K (t - algebraMap ↥W A c)}) L)) := by
    have e : algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)}) t =
        algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)}) (t - algebraMap ↥W A c) +
        algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)}) (algebraMap ↥W A c) := by
      rw [← map_add, sub_add_cancel]
    rw [e]
    refine Ideal.add_mem _ ?_ (hW c hc)
    rw [hq]
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hle : 𝔭 ≤ (𝔮.comap (algebraMap ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)})
          ↥(integralClosure ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
            algebraMap A K (t - algebraMap ↥W A c)}) L))).comap
        (algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)})) := by
    rw [hpeq]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact htJ
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      exact hW w hw
  have hne : (𝔮.comap (algebraMap ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)})
          ↥(integralClosure ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
            algebraMap A K (t - algebraMap ↥W A c)}) L))).comap
        (algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)})) ≠ ⊤ := by
    intro htop
    apply hJp.ne_top
    rw [Ideal.eq_top_iff_one]
    have h1 : (1 : A) ∈ (𝔮.comap (algebraMap ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
