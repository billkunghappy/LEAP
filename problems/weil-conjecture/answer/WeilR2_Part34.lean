    rw [← RingHom.comp_assoc, hhe, RingHom.comp_assoc, hφσ]
  have hσ₂x : ∀ x, (e₂.comp σQ) x = h ((e.comp σb) x) := fun x => by rw [← hσ₂]; rfl
  have hσPinj := wcpa_dj_lr1k_ebnt_pres_sigma_injective Ω W P (e.comp σb) g f hf
  have hσ₂inj : Function.Injective (e₂.comp σQ) := by rw [← hσ₂]; exact hhinj.comp hσPinj
  have he₂m : ∀ y, y ∈ IsLocalRing.maximalIdeal (Localization.AtPrime Q) →
