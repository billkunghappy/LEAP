  obtain ⟨r, hr⟩ : ∃ r : K, r = H / gK := ⟨_, rfl⟩
  obtain ⟨a, ha⟩ : ∃ a : K, a = f₁ / gK ^ ℓ := ⟨_, rfl⟩
  have ha0 : a ≠ 0 := by rw [ha]; exact div_ne_zero hf0 (pow_ne_zero _ hgK0)
  obtain ⟨w₁, hw₁⟩ : ∃ w : L, w = (θ' - algebraMap K L H) / algebraMap K L gK := ⟨_, rfl⟩
  obtain ⟨F₁, hF₁⟩ : ∃ F : Polynomial K,
      F = (Polynomial.X + Polynomial.C r) ^ ℓ - Polynomial.C a := ⟨_, rfl⟩
  obtain ⟨hMon, hDeg, hCo, hBez⟩ := hKum r a ha0 F₁ hF₁
  have hainv : a⁻¹ = gK ^ ℓ * f₁⁻¹ := by rw [ha, inv_div, div_eq_mul_inv]
