            Polynomial.eval₂ ι Sr g1 * ((⟨y, hy⟩ : ↥R) - Polynomial.eval₂ ι Sr g2) := by
        rw [Polynomial.eval₂_mul]
        have : (⟨x * y, Subalgebra.mul_mem _ hx hy⟩ : ↥R) = ⟨x, hx⟩ * ⟨y, hy⟩ := rfl
        rw [this]; ring
      rw [e]; exact mR.add_mem (mR.mul_mem_right _ hg1) (mR.mul_mem_left _ hg2)



  have hχι : ∀ w : ↥W, χ (ι w) = Polynomial.C (Ideal.Quotient.mk 𝔭 (algebraMap ↥W A w)) :=
    fun w => hχA _
  have hK0 : mR ≤ RingHom.ker χ := by
