  have hM0 : wcLlsKPMLoc W A K V d 0 :=
    ⟨0, Ideal.zero_mem _, 0, hR _ (Subalgebra.zero_mem _), by rw [mul_zero]⟩
  exact ⟨w₁, F₁, ((ℓ : ℕ) : ↥W), hd, hℓW, hw₁nr, hMon, hDeg, hAev, hG7, hG8, hζ, hG10, hpm, hm1,
    hG12, ⟨0, x₂, x₃, hM0, hx₂, hx₃, hident⟩⟩

theorem wcLlsKP_vtx_data_exist : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y →
    Module.finrank K L = ℓ →
    ∀ (θ : L) (f : A), θ ∉ Set.range (algebraMap K L) → θ ^ ℓ = algebraMap A L f →
    (∀ Q : Ideal ↥(integralClosure A L), wcLlsGenPt W A L 𝔭 Q → ¬ wcLlsRam A K L Q) →
    ∃ (c₀ b₀ : ↥W) (d d' : A) (w w₁ : L) (F F₁ : Polynomial K) (ε : ↥W) (G : Polynomial ↥W)
      (ω ω' : ↥W) (m₀ : ℕ) (ζ : ↥W),
      c₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ b₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ b₀ ≠ 0 ∧
      wcLlsKPBoundaryCore W A K L ℓ 𝔭 t c₀ b₀ d' w₁ F₁ m₀ ω' ζ ∧
      wcLlsKPInnerCore W A K L ℓ 𝔭 t c₀ b₀ d w F ε G ω ∧
      (IsUnit ε ∨ (ε ∈ IsLocalRing.maximalIdeal ↥W ∧ ∃ τ : ↥W, τ ∉ IsLocalRing.maximalIdeal ↥W ∧
        (Polynomial.derivative G).eval 0 ∈ IsLocalRing.maximalIdeal ↥W ∧
        (Polynomial.derivative G).eval τ ∈ IsLocalRing.maximalIdeal ↥W ∧
        ∃ j, (Polynomial.derivative G).coeff j ∉ IsLocalRing.maximalIdeal ↥W)) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hSolv hUniq hdeg θ f
    hθ hθf hNB

  have hres : IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
    apply IsAlgClosed.of_exists_root
    intro p hmon hirr
    obtain ⟨P, hPmap, hPdeg, hPmon⟩ := Polynomial.lifts_and_degree_eq_and_monic
      (Polynomial.map_surjective (IsLocalRing.residue ↥W) IsLocalRing.residue_surjective p) hmon
    have hdeg0 : (P.map (algebraMap ↥W Ω)).degree ≠ 0 := by
      rw [Polynomial.degree_map_eq_of_injective (IsFractionRing.injective ↥W Ω), hPdeg]
      exact (Polynomial.degree_pos_of_irreducible hirr).ne'
    obtain ⟨α, hα⟩ := IsAlgClosed.exists_root _ hdeg0
    have hα' : Polynomial.eval₂ (algebraMap ↥W Ω) α P = 0 := by
      rwa [Polynomial.IsRoot, Polynomial.eval_map] at hα
    have hint : IsIntegral ↥W α := ⟨P, hPmon, hα'⟩
    obtain ⟨a, ha⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥W) (K := Ω)).mp hint
    refine ⟨IsLocalRing.residue ↥W a, ?_⟩
    have h0 : P.eval a = 0 := by
      apply IsFractionRing.injective ↥W Ω
      rw [map_zero, ← Polynomial.eval₂_at_apply, ha]
      exact hα'
    rw [← hPmap, Polynomial.eval_map, Polynomial.eval₂_at_apply, h0, map_zero]

  have T0 : ∀ (d : A) (x : K), wcLlsKPLoc A K 0 d x ↔
      ∃ (n : ℕ) (a : A), algebraMap A K a = algebraMap A K d ^ n * x := by
    intro d x
    have hbot : Algebra.adjoin A ({0} : Set K) = ⊥ := by
      apply le_antisymm
      · rw [Algebra.adjoin_le_iff]
        intro z hz
        rw [Set.mem_singleton_iff.mp hz]
        exact Subalgebra.zero_mem _
      · exact bot_le
    unfold wcLlsKPLoc
    rw [hbot]
    constructor
    · rintro ⟨n, hn⟩
      obtain ⟨a, ha⟩ := Algebra.mem_bot.mp hn
      exact ⟨n, a, ha⟩
    · rintro ⟨n, a, ha⟩
      exact ⟨n, Algebra.mem_bot.mpr ⟨a, ha⟩⟩
  have T2 : ∀ (d d' : A) (x z : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d' z →
      wcLlsKPLoc A K 0 (d * d') (x * z) := by
    intro d d' x z hx hz
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    obtain ⟨n', a', ha'⟩ := (T0 d' z).mp hz
    refine (T0 _ _).mpr ⟨n + n', a * a' * (d ^ n' * d' ^ n), ?_⟩
    simp only [map_mul, map_pow, ha, ha']
    ring
  have T3 : ∀ (d e : A) (x : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 (e * d) x := by
    intro d e x hx
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    refine (T0 _ _).mpr ⟨n, e ^ n * a, ?_⟩
    simp only [map_mul, map_pow, ha]
    ring
  have T4 : ∀ (d : A) (x : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d (x ^ ℓ) := by
    intro d x hx
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    refine (T0 _ _).mpr ⟨n * ℓ, a ^ ℓ, ?_⟩
    rw [map_pow, ha, mul_pow, ← pow_mul]
  have TM : ∀ (d e : A) (z : K), wcLlsKPMLoc W A K 0 d z → wcLlsKPMLoc W A K 0 (e * d) z := by
    intro d e z hz
    obtain ⟨π, hπ, z', hz', hzz⟩ := hz
    exact ⟨π, hπ, z', T3 d e z' hz', hzz⟩
  have hPrime : 𝔭.IsPrime := hPD.2.2.2.1.isPrime
  have T5 : ∀ a b : A, a ∉ 𝔭 → b ∉ 𝔭 → a * b ∉ 𝔭 := fun a b ha hb hab =>
    (hPrime.mem_or_mem hab).elim ha hb

  obtain ⟨θ', f₁, d₁, hd₁, hθ', hθ'f, hL1, hL2, hPU⟩ :=
    wcLlsKP_vde_principal_unit Ω W hW hWt ℓ hℓ hΩ hκ A K L 𝔭 t y hPD hSolv hUniq hdeg θ f hθ hθf
      hNB
  have hNoAS₁ := wcLlsKP_vde_no_as_split Ω W hW hWt ℓ hℓ hΩ hκ A K L 𝔭 t y hPD hSolv hUniq hdeg
    θ' f₁ d₁ hd₁ hθ' hθ'f hL1 hL2 hPU

  obtain ⟨k, q, γ₁, d, hd, hk0, hγ₁, hLk, hLki, hLq, hq, ⟨x, z, hx, hz, hxz⟩, hnp⟩ :=
    wcLlsKP_vde_best_approx_unit Ω W hW hWt ℓ hℓ hΩ hκ A K 𝔭 t hPD f₁ d₁ hd₁ hL1 hL2 hPU hNoAS₁
  have hd₂ : d₁ * d ∉ 𝔭 := T5 _ _ hd₁ hd
  have hLf₂ : wcLlsKPLoc A K 0 (d₁ * d) (f₁ * k ^ ℓ) := T2 _ _ _ _ hL1 (T4 _ _ hLk)
  have hLf₂i : wcLlsKPLoc A K 0 (d₁ * d) (f₁ * k ^ ℓ)⁻¹ := by
    have e : (f₁ * k ^ ℓ)⁻¹ = f₁⁻¹ * (k⁻¹) ^ ℓ := by rw [mul_inv, inv_pow]
    rw [e]
    exact T2 _ _ _ _ hL2 (T4 _ _ hLki)
  have hLq₂ : wcLlsKPLoc A K 0 (d₁ * d) q := T3 _ _ _ hLq
  have hPU₂ : ∃ x z : K, wcLlsKPLoc A K 0 (d₁ * d) x ∧ wcLlsKPMLoc W A K 0 (d₁ * d) z ∧
      f₁ * k ^ ℓ - 1 = algebraMap A K t * x + z :=
    ⟨x, z, T3 _ _ _ hx, TM _ _ _ hz, hxz⟩
  have hkk : k ^ ℓ * (k⁻¹) ^ ℓ = 1 := by rw [← mul_pow, mul_inv_cancel₀ hk0, one_pow]
  have hNoAS₂ : ∀ (γ ε₀ : ↥W) (h' : K) (d' : A), d' ∉ 𝔭 → IsUnit ε₀ →
      ((ℓ : ℕ) : ↥W) = γ ^ (ℓ - 1) * ε₀ → wcLlsKPLoc A K 0 d' h' →
      wcLlsKPLoc A K 0 d' ((f₁ * k ^ ℓ - h' ^ ℓ) / algebraMap A K (algebraMap ↥W A γ) ^ ℓ) →
      False := by
    intro γ ε₀ h' d' hd' hε hγ h1 h2
    apply hNoAS₁ γ ε₀ (h' * k⁻¹) (d' * d) (T5 _ _ hd' hd) hε hγ (T2 _ _ _ _ h1 hLki)
    have heq : (f₁ - (h' * k⁻¹) ^ ℓ) / algebraMap A K (algebraMap ↥W A γ) ^ ℓ =
        ((f₁ * k ^ ℓ - h' ^ ℓ) / algebraMap A K (algebraMap ↥W A γ) ^ ℓ) * (k⁻¹) ^ ℓ := by
      rw [div_eq_mul_inv, div_eq_mul_inv, mul_pow]
      linear_combination (-(f₁ * (algebraMap A K (algebraMap ↥W A γ) ^ ℓ)⁻¹)) * hkk
    rw [heq]
    exact T2 _ _ _ _ h2 (T4 _ _ hLki)

  have hTay := wcLlsKP_vde_taylor Ω W A K 𝔭 t hPD
  obtain ⟨k₂, c, b, ζ, γ, d₃, h, g, M, m₀, hk₂, hN⟩ :=
    wcLlsKP_vde_newton_from_best Ω W hW hWt ℓ hℓ hΩ hκ A K 𝔭 t hPD (f₁ * k ^ ℓ) q γ₁ (d₁ * d)
      hd₂ hγ₁ hLf₂ hLf₂i hLq₂ hq hPU₂ hnp hNoAS₂ hTay

  have hkk₂ : k * k₂ ≠ 0 := mul_ne_zero hk0 hk₂
  have hθ''f : (θ' * algebraMap K L (k * k₂)) ^ ℓ = algebraMap K L (f₁ * k ^ ℓ * k₂ ^ ℓ) := by
    simp only [mul_pow, map_mul, map_pow, hθ'f]
    ring
  have hθ''r : θ' * algebraMap K L (k * k₂) ∉ Set.range (algebraMap K L) := by
    rintro ⟨a, ha⟩
    apply hθ'
    refine ⟨a * (k * k₂)⁻¹, ?_⟩
    rw [map_mul, ha, map_inv₀, mul_assoc,
      mul_inv_cancel₀ ((map_ne_zero (algebraMap K L)).mpr hkk₂), mul_one]

  obtain ⟨w, F, ε, G, ω, hI, hcase⟩ :=
    wcLlsKP_vde_inner_from_newton Ω W hW hWt ℓ hℓ hΩ hκ hres A K L 𝔭 t hPD hdeg
      (θ' * algebraMap K L (k * k₂)) (f₁ * k ^ ℓ * k₂ ^ ℓ) hθ''r hθ''f c b ζ γ d₃ h g M m₀ hN
  obtain ⟨w₁, F₁, ω', hB⟩ :=
    wcLlsKP_vde_boundary_from_newton Ω W hW hWt ℓ hℓ hΩ hκ A K L 𝔭 t hPD hdeg
      (θ' * algebraMap K L (k * k₂)) (f₁ * k ^ ℓ * k₂ ^ ℓ) hθ''r hθ''f c b ζ γ d₃ h g M m₀ hN
  exact ⟨c, b, d₃, d₃, w, w₁, F, F₁, ε, G, ω, ω', m₀, ζ, hN.2.1, hN.2.2.1, hN.2.2.2.1, hB, hI,
    hcase⟩

theorem wcLlsKP_bds_node_elements : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (ℓ : ℕ), ℓ.Prime →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ (c b : ↥W) (d : A) (w₁ : L) (F₁ : Polynomial K) (m₀ : ℕ) (ω ζ : ↥W) (α β : ℕ)
      (x : ℕ → K),
      c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
      wcLlsKPBoundaryCore W A K L ℓ 𝔭 t c b d w₁ F₁ m₀ ω ζ →
      α * m₀ = 1 + β * ℓ →
      (∀ i, 1 ≤ i → i < ℓ → wcLlsKPLoc A K (wcLlsScV W A K t c b) d (x i) ∧
        F₁.coeff i = algebraMap A K (algebraMap ↥W A ζ) ^ (m₀ * (ℓ - i)) * x i) →
      ∀ (𝔮 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)}) L)) [𝔮.IsPrime],
      𝔮.comap (algebraMap ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)})
          ↥(integralClosure ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
            algebraMap A K (t - algebraMap ↥W A c)}) L)) =
        Ideal.span {algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
            algebraMap A K (t - algebraMap ↥W A c)}) (t - algebraMap ↥W A c),
          ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c),
            Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
            algebraMap A K (t - algebraMap ↥W A c)})).comp (algebraMap ↥W A)) →
      ∃ z z' μ ν : L, wcLlsKPbdsElems W A K L t c b ζ w₁ F₁ ℓ m₀ α β x 𝔮 z z' μ ν :=
by
  intro Ω _ _ W ℓ hℓ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD hdeg c b d w₁ F₁ m₀ ω ζ α β x
    hc hb hb0 hB hαβ hx 𝔮 _ hq
  classical



  have t_intpow : ∀ (R₀ : Type u) [CommRing R₀] (B₀ : Type u) [CommRing B₀] [Algebra R₀ B₀]
      (y : B₀) (n : ℕ) (s : Finset ℕ) (k : ℕ → ℕ) (a : ℕ → R₀) (a₀ : R₀), 0 < n →
      (∀ i ∈ s, k i < n) →
      y ^ n = ∑ i ∈ s, algebraMap R₀ B₀ (a i) * y ^ (k i) + algebraMap R₀ B₀ a₀ →
      IsIntegral R₀ y := by
    intro R₀ _ B₀ _ _ y n s k a a₀ hn hk h
    set q : Polynomial R₀ :=
      ∑ i ∈ s, Polynomial.C (a i) * Polynomial.X ^ (k i) + Polynomial.C a₀ with hqdef
    have hqd : q.degree < n := by
      refine lt_of_le_of_lt (Polynomial.degree_add_le _ _) (max_lt ?_ ?_)
      · refine lt_of_le_of_lt (Polynomial.degree_sum_le _ _) ?_
        refine (Finset.sup_lt_iff (WithBot.bot_lt_coe n)).mpr ?_
        intro i hi
        exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_pow_le _ _)
          (WithBot.coe_lt_coe.mpr (hk i hi))
      · exact lt_of_le_of_lt Polynomial.degree_C_le (WithBot.coe_lt_coe.mpr hn)
    refine ⟨Polynomial.X ^ n - q, Polynomial.monic_X_pow_sub hqd, ?_⟩
    simp [q, Polynomial.eval₂_finsetSum, h]



  have t_fid : ∀ (L₀ : Type u) [Field L₀] (p m₀ α β : ℕ) (w u ζ c₀ : L₀) (x : ℕ → L₀),
      w ≠ 0 → u ≠ 0 → α * m₀ = 1 + β * p →
      w ^ p + ∑ i ∈ Finset.Ico 1 p, ζ ^ (m₀ * (p - i)) * x i * w ^ i + c₀ = 0 →
      (w ^ α / u ^ β) * (ζ * u ^ β / w ^ α) = ζ ∧
      (w ^ p / u ^ m₀) * (u ^ m₀ / w ^ p) = 1 ∧
      u = (w ^ α / u ^ β) ^ p * (u ^ m₀ / w ^ p) ^ α ∧
      ζ ^ p / u = (ζ * u ^ β / w ^ α) ^ p * (w ^ p / u ^ m₀) ^ α ∧
      (ζ * u ^ β / w ^ α) ^ m₀ * (w ^ p / u ^ m₀) ^ β = ζ ^ m₀ / w ∧
      (w ^ p / u ^ m₀) * (1 + ∑ i ∈ Finset.Ico 1 p, x i * (ζ ^ m₀ / w) ^ (p - i)) =
        -c₀ / u ^ m₀ ∧
      w = (w ^ α / u ^ β) ^ m₀ * (u ^ m₀ / w ^ p) ^ β ∧
      (ζ ^ m₀ / w) ^ p * (-c₀ / u ^ m₀) =
        (ζ ^ p / u) ^ m₀ * (1 + ∑ i ∈ Finset.Ico 1 p, x i * (ζ ^ m₀ / w) ^ (p - i)) := by
    intro L₀ _ p m₀ α β w u ζ c₀ x hw hu hK hroot
    have ku : (u ^ m₀) ^ α = u * (u ^ β) ^ p := by
      rw [← pow_mul, ← pow_mul, mul_comm m₀ α, hK, pow_add, pow_one]
    have kw : (w ^ α) ^ m₀ = w * (w ^ p) ^ β := by
      rw [← pow_mul, ← pow_mul, hK, pow_add, pow_one, mul_comm p β]
    have hterm : ∀ i ∈ Finset.Ico 1 p, (w ^ p / u ^ m₀) * (x i * (ζ ^ m₀ / w) ^ (p - i)) =
        ζ ^ (m₀ * (p - i)) * x i * w ^ i / u ^ m₀ := by
      intro i hi
      have hip : i ≤ p := le_of_lt (Finset.mem_Ico.mp hi).2
      have hwp : w ^ p = w ^ i * w ^ (p - i) := by rw [← pow_add, Nat.add_sub_cancel' hip]
      rw [hwp, div_pow, ← pow_mul]
      field_simp
    have h6 : (w ^ p / u ^ m₀) * (1 + ∑ i ∈ Finset.Ico 1 p, x i * (ζ ^ m₀ / w) ^ (p - i)) =
        -c₀ / u ^ m₀ := by
      rw [mul_add, mul_one, Finset.mul_sum, Finset.sum_congr rfl hterm, ← Finset.sum_div]
      have : c₀ = -(w ^ p + ∑ i ∈ Finset.Ico 1 p, ζ ^ (m₀ * (p - i)) * x i * w ^ i) := by
        linear_combination hroot
      rw [this]
      field_simp
    have hH : (1 + ∑ i ∈ Finset.Ico 1 p, x i * (ζ ^ m₀ / w) ^ (p - i)) = -c₀ / w ^ p := by
      rw [eq_div_iff (pow_ne_zero _ hw)]
      calc (1 + ∑ i ∈ Finset.Ico 1 p, x i * (ζ ^ m₀ / w) ^ (p - i)) * w ^ p
          = (w ^ p / u ^ m₀ * (1 + ∑ i ∈ Finset.Ico 1 p, x i * (ζ ^ m₀ / w) ^ (p - i))) *
              u ^ m₀ := by
            field_simp
        _ = -c₀ / u ^ m₀ * u ^ m₀ := by rw [h6]
        _ = -c₀ := by field_simp
    refine ⟨?_, ?_, ?_, ?_, ?_, h6, ?_, ?_⟩
    · field_simp
    · field_simp
    · simp only [div_pow]
      rw [ku]
      field_simp
      ring
    · simp only [div_pow, mul_pow]
      rw [ku]
      field_simp
      ring
    · simp only [div_pow, mul_pow]
      rw [kw]
      field_simp
      ring
    · simp only [div_pow]
      rw [kw]
      field_simp
      ring
    · rw [hH, div_pow, div_pow, ← pow_mul, ← pow_mul, mul_comm p m₀]
      ring



  have t_loc : ∀ (R₀ : Type u) [CommRing R₀] (L₀ : Type u) [Field L₀] [Algebra R₀ L₀]
      (𝔮₀ : Ideal ↥(integralClosure R₀ L₀)) [𝔮₀.IsPrime] (p m₀ α : ℕ) (x : ℕ → L₀)
      (U s u ρ μ ν z z' e : L₀) (E S₀ sC uC : ↥(integralClosure R₀ L₀))
      (Xc : ℕ → ↥(integralClosure R₀ L₀)), 0 < p → 1 ≤ m₀ →
      (E : L₀) = e → (S₀ : L₀) = e * U → (sC : L₀) = s → (uC : L₀) = u →
      (∀ i ∈ Finset.Ico 1 p, (Xc i : L₀) = e * x i) →
      E ∉ 𝔮₀ → S₀ ∉ 𝔮₀ → sC ∈ 𝔮₀ → uC ∈ 𝔮₀ →
      ρ ^ p * U = s ^ m₀ * (1 + ∑ i ∈ Finset.Ico 1 p, x i * ρ ^ (p - i)) →
      μ * (1 + ∑ i ∈ Finset.Ico 1 p, x i * ρ ^ (p - i)) = U → μ * ν = 1 →
      u = z ^ p * ν ^ α → s = z' ^ p * μ ^ α →
      (∃ a ∈ 𝔮₀, ∃ σ, σ ∉ 𝔮₀ ∧ (σ : L₀) * z = (a : L₀)) ∧
      (∃ a ∈ 𝔮₀, ∃ σ, σ ∉ 𝔮₀ ∧ (σ : L₀) * z' = (a : L₀)) := by
    intro R₀ _ L₀ _ _ 𝔮₀ h𝔮 p m₀ α x U s u ρ μ ν z z' e E S₀ sC uC Xc hp hm₀ hE hS hsC huC
      hX hEq hSq hsq huq hkey hμH hμν hu hs
    obtain ⟨q, rfl⟩ : ∃ q, p = q + 1 := ⟨p - 1, by omega⟩
    obtain ⟨HL, hHL⟩ : ∃ HL, 1 + ∑ i ∈ Finset.Ico 1 (q + 1), x i * ρ ^ (q + 1 - i) = HL :=
      ⟨_, rfl⟩
    rw [hHL] at hkey hμH
    obtain ⟨V, hV⟩ : ∃ V, e * U = V := ⟨_, rfl⟩
    rw [hV] at hS
    obtain ⟨y, hy⟩ : ∃ y : L₀, V * ρ = y := ⟨_, rfl⟩
    have hterm : ∀ i ∈ Finset.Ico 1 (q + 1),
        V ^ (i - 1) * y ^ (q + 1 - i) = V ^ q * ρ ^ (q + 1 - i) := by
      intro i hi
      have hi' := Finset.mem_Ico.mp hi
      have : q = (i - 1) + (q + 1 - i) := by omega
      rw [← hy, mul_pow, ← mul_assoc, ← pow_add, ← this]
    have hsum : ∀ (cc : ℕ → L₀), (∀ i ∈ Finset.Ico 1 (q + 1), cc i = e * x i) →
        ∑ i ∈ Finset.Ico 1 (q + 1), cc i * V ^ (i - 1) * y ^ (q + 1 - i) + e * V ^ q =
          e * V ^ q * HL := by
      intro cc hcc
      rw [← hHL, mul_add, mul_one, Finset.mul_sum, add_comm (e * V ^ q)]
      congr 1
      refine Finset.sum_congr rfl (fun i hi => ?_)
      rw [hcc i hi, mul_assoc, hterm i hi]
      ring
    have hyp : y ^ (q + 1) = s ^ m₀ * (e * V ^ q * HL) := by
      rw [← hy, mul_pow, pow_succ V q]
      calc V ^ q * V * ρ ^ (q + 1) = V ^ q * e * (ρ ^ (q + 1) * U) := by rw [← hV]; ring
        _ = _ := by rw [hkey]; ring
    have hyint : IsIntegral (↥(integralClosure R₀ L₀)) y := by
      refine t_intpow (↥(integralClosure R₀ L₀)) L₀ y (q + 1) (Finset.Ico 1 (q + 1))
        (fun i => q + 1 - i) (fun i => sC ^ m₀ * Xc i * S₀ ^ (i - 1)) (sC ^ m₀ * E * S₀ ^ q)
        (by omega) (fun i hi => by have := Finset.mem_Ico.mp hi; omega) ?_
      rw [hyp, ← hsum (fun i => (Xc i : L₀)) hX]
      simp only [map_mul, map_pow]
      show _ = ∑ i ∈ Finset.Ico 1 (q + 1),
          (sC : L₀) ^ m₀ * (Xc i : L₀) * (S₀ : L₀) ^ (i - 1) * y ^ (q + 1 - i)
        + (sC : L₀) ^ m₀ * (E : L₀) * (S₀ : L₀) ^ q
      rw [hsC, hE, hS, mul_add, Finset.mul_sum]
      congr 1
      · refine Finset.sum_congr rfl (fun i _ => ?_)
        ring
      · ring
    have hyC : y ∈ integralClosure R₀ L₀ := isIntegral_trans (R := R₀) y hyint
    set yC : ↥(integralClosure R₀ L₀) := ⟨y, hyC⟩ with hyCdef
    set H' : ↥(integralClosure R₀ L₀) :=
      ∑ i ∈ Finset.Ico 1 (q + 1), Xc i * S₀ ^ (i - 1) * yC ^ (q + 1 - i) + E * S₀ ^ q with hH'
    have hH'L : (H' : L₀) = e * V ^ q * HL := by
      rw [← hsum (fun i => (Xc i : L₀)) hX, hH']
      push_cast
      rw [hE, hS]
    have hyCp : yC ^ (q + 1) = sC ^ m₀ * H' := by
      apply Subtype.ext
      push_cast
      rw [hH'L, hsC]
      exact hyp
    have hyq : yC ∈ 𝔮₀ := by
      apply h𝔮.mem_of_pow_mem (q + 1)
      rw [hyCp]
      exact 𝔮₀.mul_mem_right _ (𝔮₀.pow_mem_of_mem hsq _ (by omega))
    have hH'q : H' ∉ 𝔮₀ := by
      intro hmem
      have h1 : ∑ i ∈ Finset.Ico 1 (q + 1), Xc i * S₀ ^ (i - 1) * yC ^ (q + 1 - i) ∈ 𝔮₀ := by
        refine 𝔮₀.sum_mem (fun i hi => ?_)
        have := Finset.mem_Ico.mp hi
        exact 𝔮₀.mul_mem_left _ (𝔮₀.pow_mem_of_mem hyq _ (by omega))
      have h2 : E * S₀ ^ q ∈ 𝔮₀ := by
        have := 𝔮₀.sub_mem hmem h1
        rwa [hH', add_sub_cancel_left] at this
      rcases h𝔮.mem_or_mem h2 with h | h
      · exact hEq h
      · exact hSq (h𝔮.mem_of_pow_mem q h)
    have hPμ : (H' : L₀) * μ = (S₀ : L₀) ^ (q + 1) := by
      rw [hH'L, hS, mul_assoc, mul_assoc, mul_comm HL μ, hμH, pow_succ, ← hV]
      ring
    have hzp : z ^ (q + 1) = u * μ ^ α := by
      rw [hu, mul_assoc, ← mul_pow, mul_comm ν μ, hμν, one_pow, mul_one]
    have hz'p : z' ^ (q + 1) = s * ν ^ α := by
      rw [hs, mul_assoc, ← mul_pow, hμν, one_pow, mul_one]
    have hSν : (S₀ : L₀) ^ (q + 1) * ν = (H' : L₀) := by
      rw [← hPμ, mul_assoc, hμν, mul_one]
    have hnotpow : ∀ (cc : ↥(integralClosure R₀ L₀)) (n : ℕ), cc ∉ 𝔮₀ → cc ^ n ∉ 𝔮₀ :=
      fun cc n hcc h => hcc (h𝔮.mem_of_pow_mem n h)
    constructor
    · set c₁ : ↥(integralClosure R₀ L₀) := uC * (H' ^ α) ^ q * (S₀ ^ (q + 1)) ^ α with hc₁
      have ht : ((H' : L₀) ^ α * z) ^ (q + 1) = (c₁ : L₀) := by
        rw [hc₁]
        push_cast
        rw [← hPμ, huC, mul_pow, hzp, mul_pow]
        ring
      have hint : IsIntegral R₀ ((H' : L₀) ^ α * z) :=
        IsIntegral.of_pow (by omega) (ht ▸ c₁.2)
      refine ⟨⟨_, hint⟩, ?_, H' ^ α, hnotpow _ _ hH'q, by push_cast; rfl⟩
      apply h𝔮.mem_of_pow_mem (q + 1)
      have : (⟨_, hint⟩ : ↥(integralClosure R₀ L₀)) ^ (q + 1) = c₁ :=
