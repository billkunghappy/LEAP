      (∀ (a : B) (s : y.primeCompl),
        φ₁ (Ideal.Quotient.mk _ (IsLocalization.mk' (Localization.AtPrime y) a s)) = 0 →
        φ₂ (Ideal.Quotient.mk _ (IsLocalization.mk' (Localization.AtPrime y) a s)) = 0 →
        ∃ σ : B, σ ∉ y ∧ ∃ n : ℕ, σ * a ^ n ∈ I) →
      (∃ x, Irreducible (φ₁ x) ∧ φ₂ x = 0) → (∃ x, φ₁ x = 0 ∧ Irreducible (φ₂ x)) →
      ¬ wcpaDjLkBad (Localization.AtPrime y ⧸ I.map (algebraMap B (Localization.AtPrime y))) := by
    intro B _ y hyP I D₁ D₂ _ _ _ _ _ _ φ₁ φ₂ hrad hs₁ hs₂ hnil' hx₁ hx₂
    haveI hred : IsReduced (Localization.AtPrime y ⧸
        I.map (algebraMap B (Localization.AtPrime y))) := by
      refine ⟨fun x hx => ?_⟩
      obtain ⟨n, hxn⟩ := hx
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨⟨a, s⟩, hz⟩ := IsLocalization.mk'_surjective y.primeCompl x
      dsimp only at hz
      subst hz
      rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem, ← IsLocalization.mk'_pow,
        IsLocalization.mk'_mem_map_algebraMap_iff] at hxn
      obtain ⟨s', hs', hs'a⟩ := hxn
      rw [Ideal.Quotient.eq_zero_iff_mem, IsLocalization.mk'_mem_map_algebraMap_iff]
      refine ⟨s', hs', hrad _ (n + 1) ?_⟩
      have e : (s' * a) ^ (n + 1) = (s' ^ n * a) * (s' * a ^ n) := by ring
      rw [e]
