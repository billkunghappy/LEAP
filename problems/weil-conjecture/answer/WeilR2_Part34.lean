      rw [← hπF, map_sub, map_mul, sub_eq_zero]
      exact hq.symm
    obtain ⟨x1, hs1⟩ := IsLocalization.surj y.primeCompl τ
    obtain ⟨x0, hs0⟩ := (IsLocalization.mem_map_algebraMap_iff y.primeCompl
      (Localization.AtPrime y)).mp h1
    have hinjT : Function.Injective
        (algebraMap ↥(integralClosure A L) (Localization.AtPrime y)) :=
      IsLocalization.injective (Localization.AtPrime y) (Ideal.primeCompl_le_nonZeroDivisors y)
    have hkey : X * ((x0.2 : ↥(integralClosure A L)) * x1.2) =
        x1.1 * ψ * x0.2 + (x0.1 : ↥(integralClosure A L)) * x1.2 := by
      apply hinjT
      simp only [map_mul, map_add]
      linear_combination
        (algebraMap _ (Localization.AtPrime y) (x1.2 : ↥(integralClosure A L))) * hs0 +
        (algebraMap _ (Localization.AtPrime y) ψ *
          algebraMap _ (Localization.AtPrime y) (x0.2 : ↥(integralClosure A L))) * hs1
    have hr : ((x0.2 : ↥(integralClosure A L)) * x1.2) ∉ y := by
      intro hm
      rcases Ideal.IsPrime.mem_or_mem ‹y.IsPrime› hm with h2 | h2
      · exact x0.2.2 h2
      · exact x1.2.2 h2
    obtain ⟨bb, s, hs, hbb⟩ := hloc _ hr
    refine ⟨s, x1.1 * x0.2 * bb, x0.1 * x1.2 * bb, hs, ?_, ?_⟩
    · exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _ x0.1.2)
    · rw [← hbb]
      linear_combination bb * hkey

  have hcoef : ∀ d : Fin ℓ → (Localization.AtPrime 𝔭 ⧸ wcKpknBrI W A 𝔭 v),
      ∑ i : Fin ℓ, Φ (AdjoinRoot.of P (d i)) * Φ (AdjoinRoot.root P) ^ (i : ℕ) = 0 →
      ∀ i, d i = 0 := by
    intro d hd
