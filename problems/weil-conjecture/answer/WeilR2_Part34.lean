    (θ : L) ∉ Set.range (algebraMap K L) → (θ : L) ^ ℓ = algebraMap A L (u * ε) →
    (ψ : L) ^ ℓ = algebraMap A L (v * ε') →
    (θ : L) * (ψ : L) = algebraMap A L (δ * algebraMap ↥W A h) →
    ε ∉ 𝔭 → ε' ∉ 𝔭 → δ ∉ 𝔭 → h ∈ IsLocalRing.maximalIdeal ↥W → h ≠ 0 →
    u * v = algebraMap ↥W A (h ^ ℓ) → algebraMap ↥W A (h ^ ℓ) ≠ 0 →
    𝔭 = Ideal.span {u, v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
    σ (θ : L) = algebraMap A L ζ * (θ : L) →
    (∀ x : L, ∃ a : Fin ℓ → K, x = ∑ i, algebraMap K L (a i) * (θ : L) ^ (i : ℕ)) →
    (∀ x : L, IsIntegral A x → ∃ s : A, s ∉ 𝔭 ∧ algebraMap A L s * x ∈
      Submodule.span A {z : L | ∃ i : ℕ, i < ℓ ∧ (z = (θ : L) ^ i ∨ z = (ψ : L) ^ i)}) →
    y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
    (∀ t : ↥(integralClosure A L), t ∉ y → ∃ (b : ↥(integralClosure A L)) (s : A),
      s ∉ 𝔭 ∧ t * b = algebraMap A ↥(integralClosure A L) s) →
    (∀ i : ℕ, 1 ≤ i → i < ℓ → ∀ a b c : A,
      b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      algebraMap ↥W A (h ^ i) * a = algebraMap ↥W A (h ^ i) * b + v * c →
      ∃ s : A, s ∉ 𝔭 ∧
