          Ideal.map_span, Set.image_singleton, Set.image_singleton]

theorem wcLlsKP_ed_recoordinate : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A] (𝔭 : Ideal A) [𝔭.IsPrime] (t h a : A) (c : ↥W) (f₀ : Polynomial ↥W →+* Localization.Away h), (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 → t ∈ 𝔭 → h ∉ 𝔭 → a ∉ 𝔭 → c ∈ IsLocalRing.maximalIdeal ↥W → f₀.comp Polynomial.C = (algebraMap A (Localization.Away h)).comp (algebraMap ↥W A) → f₀ Polynomial.X = algebraMap A (Localization.Away h) t → RingHom.Etale f₀ → ∃ h' : A, h' ∉ 𝔭 ∧ IsUnit (algebraMap A (Localization.Away h') a) ∧ ∃ φ : Polynomial ↥W →+* Localization.Away h', φ.comp Polynomial.C = (algebraMap A (Localization.Away h')).comp (algebraMap ↥W A) ∧ φ Polynomial.X = algebraMap A (Localization.Away h') ((t - algebraMap ↥W A c) * a) ∧ RingHom.Etale φ :=
by
  have s2 : ∀ (R T : Type u) [CommRing R] [CommRing T] [Algebra R T] (f : Polynomial R →+* T) (hfC : f.comp Polynomial.C = algebraMap R T) (hf : RingHom.Etale f), Submodule.span T {KaehlerDifferential.D R T (f Polynomial.X)} = ⊤ := by
    intro R T _ _ _ f hfC hf
    letI := f.toAlgebra
    haveI : IsScalarTower R (Polynomial R) T := IsScalarTower.of_algebraMap_eq' (by
      rw [← hfC, Polynomial.algebraMap_eq]; rfl)
    haveI : Algebra.Etale (Polynomial R) T := hf.toAlgebra
    rw [eq_top_iff]
    rintro ω -
    obtain ⟨z, rfl⟩ :=
      (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale R (Polynomial R) T).surjective ω
    rw [KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply]
    induction z using TensorProduct.induction_on with
    | zero => rw [map_zero]; exact zero_mem _
    | tmul y w =>
      rw [KaehlerDifferential.mapBaseChange_tmul]
      have hw : w = (KaehlerDifferential.polynomialEquiv R w) •
          KaehlerDifferential.D R (Polynomial R) Polynomial.X := by
        rw [← KaehlerDifferential.polynomialEquiv_symm, LinearEquiv.symm_apply_apply]
      rw [hw, LinearMap.map_smul, KaehlerDifferential.map_D]
      apply Submodule.smul_mem
      rw [← algebraMap_smul T (KaehlerDifferential.polynomialEquiv R w)]
      apply Submodule.smul_mem
      exact Submodule.mem_span_singleton_self _
    | add z w hz hw => rw [map_add]; exact add_mem hz hw
  have s3 : ∀ (R T : Type u) [CommRing R] [CommRing T] [Algebra R T] (x : T) (q : Ideal T) [q.IsPrime] (c : R) (a : T) (hspan : Submodule.span T {KaehlerDifferential.D R T x} = ⊤) (hx : x - algebraMap R T c ∈ q) (ha : a ∉ q), Submodule.span q.ResidueField (Set.range (fun j : Fin 1 => (1 : q.ResidueField) ⊗ₜ[T] KaehlerDifferential.D R T (![(x - algebraMap R T c) * a] j))) = ⊤ := by
    intro R T _ _ _ x q _ c a hspan hx ha
    rw [Set.range_unique]
    simp only [Fin.default_eq_zero, Matrix.cons_val_zero]
    have key : ∀ (r : T) (m : Ω[T⁄R]), (1 : q.ResidueField) ⊗ₜ[T] (r • m) =
        (algebraMap T q.ResidueField r) • ((1 : q.ResidueField) ⊗ₜ[T] m) := by
      intro r m
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one, ← TensorProduct.smul_tmul,
        Algebra.smul_def, mul_one]
    have hD : KaehlerDifferential.D R T ((x - algebraMap R T c) * a) =
        (x - algebraMap R T c) • KaehlerDifferential.D R T a + a • KaehlerDifferential.D R T x := by
      rw [Derivation.leibniz, Derivation.map_sub, Derivation.map_algebraMap, sub_zero]
    have hx0 : algebraMap T q.ResidueField (x - algebraMap R T c) = 0 :=
      Ideal.algebraMap_residueField_eq_zero.mpr hx
    have ha0 : algebraMap T q.ResidueField a ≠ 0 :=
      fun h0 => ha (Ideal.algebraMap_residueField_eq_zero.mp h0)
    have hG : (1 : q.ResidueField) ⊗ₜ[T] KaehlerDifferential.D R T ((x - algebraMap R T c) * a) =
        algebraMap T q.ResidueField a • ((1 : q.ResidueField) ⊗ₜ[T] KaehlerDifferential.D R T x) := by
      rw [hD, TensorProduct.tmul_add, key, key, hx0, zero_smul, zero_add]
    have hDx : (1 : q.ResidueField) ⊗ₜ[T] KaehlerDifferential.D R T x ∈
        Submodule.span q.ResidueField
          {(1 : q.ResidueField) ⊗ₜ[T] KaehlerDifferential.D R T ((x - algebraMap R T c) * a)} := by
      have e : (1 : q.ResidueField) ⊗ₜ[T] KaehlerDifferential.D R T x =
          (algebraMap T q.ResidueField a)⁻¹ •
            ((1 : q.ResidueField) ⊗ₜ[T] KaehlerDifferential.D R T ((x - algebraMap R T c) * a)) := by
        rw [hG, smul_smul, inv_mul_cancel₀ ha0, one_smul]
      rw [e]
      exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)
    rw [eq_top_iff]
    rintro z -
    induction z using TensorProduct.induction_on with
    | zero => exact zero_mem _
    | tmul k ω =>
      have hω : ω ∈ Submodule.span T {KaehlerDifferential.D R T x} := by rw [hspan]; trivial
      obtain ⟨y, rfl⟩ := Submodule.mem_span_singleton.mp hω
      have e : k ⊗ₜ[T] (y • KaehlerDifferential.D R T x) =
          (k * algebraMap T q.ResidueField y) •
            ((1 : q.ResidueField) ⊗ₜ[T] KaehlerDifferential.D R T x) := by
        rw [mul_smul, ← key, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [e]
      exact Submodule.smul_mem _ _ hDx
    | add z w hz hw => exact add_mem hz hw
  have s4 : ∀ (R T : Type u) [CommRing R] [CommRing T] [Algebra R T] (f : Polynomial R →+* T) (hfC : f.comp Polynomial.C = algebraMap R T) (hf : RingHom.Etale f), RingHom.IsStandardSmoothOfRelativeDimension 1 (algebraMap R T) := by
    intro R T _ _ _ f hfC hf
    let e : MvPolynomial (Fin 1) R →+* Polynomial R :=
      (MvPolynomial.uniqueAlgEquiv R (Fin 1)).toRingEquiv.toRingHom
    have h1 : RingHom.IsStandardSmoothOfRelativeDimension 1 (algebraMap R (MvPolynomial (Fin 1) R)) :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr inferInstance
    have h2 : RingHom.IsStandardSmoothOfRelativeDimension 0 e :=
      RingHom.etale_iff_isStandardSmoothOfRelativeDimension_zero.mp
        (RingHom.Etale.of_bijective (MvPolynomial.uniqueAlgEquiv R (Fin 1)).bijective)
    have h3 := RingHom.etale_iff_isStandardSmoothOfRelativeDimension_zero.mp hf
    have h4 := h3.comp (h2.comp h1)
    have heq : f.comp (e.comp (algebraMap R (MvPolynomial (Fin 1) R))) = algebraMap R T := by
      rw [← hfC]
      congr 1
      apply RingHom.ext
      intro r
      have := (MvPolynomial.uniqueAlgEquiv R (Fin 1)).commutes r
      rw [Polynomial.algebraMap_eq] at this
      exact this
    rw [heq] at h4
    simpa using h4
  have s6 : ∀ (A : Type u) [CommRing A] (𝔭 : Ideal A) [𝔭.IsPrime] (h a : A) (s : Localization.Away h) (hh : h ∉ 𝔭) (ha : a ∉ 𝔭) (hs : s ∉ 𝔭.map (algebraMap A (Localization.Away h))), ∃ h' : A, h' ∉ 𝔭 ∧ IsUnit (algebraMap A (Localization.Away h') a) ∧ ∃ ψ : Localization.Away s →+* Localization.Away h', ψ.comp ((algebraMap (Localization.Away h) (Localization.Away s)).comp (algebraMap A (Localization.Away h))) = algebraMap A (Localization.Away h') ∧ RingHom.Etale ψ := by
    intro A _ 𝔭 _ h a s hh ha hs
    obtain ⟨n, s₀, hs₀⟩ := IsLocalization.Away.surj h s
    obtain ⟨v, hv⟩ : IsUnit (algebraMap A (Localization.Away h) h ^ n) :=
      (IsLocalization.Away.algebraMap_isUnit h).pow n
    have hs₀𝔭 : s₀ ∉ 𝔭 := by
      intro hm
      apply hs
      have h1 : algebraMap A (Localization.Away h) s₀ ∈ 𝔭.map (algebraMap A (Localization.Away h)) :=
        Ideal.mem_map_of_mem _ hm
      rw [← hs₀, ← hv] at h1
      have h2 := Ideal.mul_mem_right (↑v⁻¹ : Localization.Away h) _ h1
      rwa [mul_assoc, Units.mul_inv, mul_one] at h2
    have hassoc : Associated s (algebraMap A (Localization.Away h) s₀) := ⟨v, by rw [hv, hs₀]⟩
    haveI : IsLocalization.Away (algebraMap A (Localization.Away h) s₀) (Localization.Away s) :=
      IsLocalization.Away.of_associated hassoc
    haveI : IsLocalization.Away (h * s₀) (Localization.Away s) :=
      IsLocalization.Away.mul' (Localization.Away h) (Localization.Away s) h s₀
    haveI : IsLocalization.Away (h * s₀ * a)
        (Localization.Away (algebraMap A (Localization.Away s) a)) :=
      IsLocalization.Away.instHMulAwayCoeRingHomAlgebraMap_1 (Localization.Away s) (h * s₀) a
    let e : Localization.Away (h * s₀ * a) ≃ₐ[A]
        Localization.Away (algebraMap A (Localization.Away s) a) :=
      IsLocalization.algEquiv (Submonoid.powers (h * s₀ * a)) (Localization.Away (h * s₀ * a))
        (Localization.Away (algebraMap A (Localization.Away s) a))
    refine ⟨h * s₀ * a, ?_, ?_, e.symm.toRingEquiv.toRingHom.comp
      (algebraMap (Localization.Away s) (Localization.Away (algebraMap A (Localization.Away s) a))),
      ?_, ?_⟩
    · exact Ideal.IsPrime.mul_notMem ‹_› (Ideal.IsPrime.mul_notMem ‹_› hh hs₀𝔭) ha
    · have h1 : IsUnit (algebraMap A (Localization.Away (h * s₀ * a)) (h * s₀ * a)) :=
        IsLocalization.Away.algebraMap_isUnit (h * s₀ * a)
      rw [map_mul] at h1
      exact isUnit_of_mul_isUnit_right h1
    · apply RingHom.ext
      intro x
      simp only [RingHom.comp_apply]
      rw [← IsScalarTower.algebraMap_apply A (Localization.Away h) (Localization.Away s),
        ← IsScalarTower.algebraMap_apply A (Localization.Away s)]
      exact e.symm.commutes x
    · refine RingHom.Etale.stableUnderComposition
        (algebraMap (Localization.Away s) (Localization.Away (algebraMap A (Localization.Away s) a)))
        e.symm.toRingEquiv.toRingHom ?_ ?_
      · exact RingHom.etale_algebraMap.mpr
          (Algebra.Etale.of_isLocalizationAway (algebraMap A (Localization.Away s) a))
      · exact RingHom.Etale.of_bijective e.symm.bijective
  intro Ω _ W A _ _ 𝔭 _ t h a c f₀ hm𝔭 ht hh ha hc hfC hfX hfet
  classical
  have hdisj : Disjoint (↑(Submonoid.powers h) : Set A) ↑𝔭 :=
    (Ideal.disjoint_powers_iff_notMem h (Ideal.IsPrime.isRadical ‹_›)).mpr hh
  haveI hq : (𝔭.map (algebraMap A (Localization.Away h))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) _ 𝔭 ‹_› hdisj
  have hcomap : Ideal.under A (𝔭.map (algebraMap A (Localization.Away h))) = 𝔭 :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers h) _ ‹_› hdisj
  have haq : algebraMap A (Localization.Away h) a ∉ 𝔭.map (algebraMap A (Localization.Away h)) := by
    intro hm
    apply ha
    rw [← hcomap]
    exact Ideal.mem_comap.mpr hm
  have hcA : algebraMap ↥W A c ∈ 𝔭 := hm𝔭 (Ideal.mem_map_of_mem _ hc)
  have hxq : algebraMap A (Localization.Away h) t - algebraMap ↥W (Localization.Away h) c ∈
      𝔭.map (algebraMap A (Localization.Away h)) := by
    rw [IsScalarTower.algebraMap_apply ↥W A (Localization.Away h), ← map_sub]
    exact Ideal.mem_map_of_mem _ (𝔭.sub_mem ht hcA)
  have hG : (algebraMap A (Localization.Away h) t - algebraMap ↥W (Localization.Away h) c) *
      algebraMap A (Localization.Away h) a =
      algebraMap A (Localization.Away h) ((t - algebraMap ↥W A c) * a) := by
    rw [IsScalarTower.algebraMap_apply ↥W A (Localization.Away h), map_mul, map_sub]
  have hfC' : f₀.comp Polynomial.C = algebraMap ↥W (Localization.Away h) := by
    rw [hfC, ← IsScalarTower.algebraMap_eq]
  have hspan := s2 ↥W (Localization.Away h) f₀ hfC' hfet
  rw [hfX] at hspan
  have hres := s3 ↥W (Localization.Away h) (algebraMap A (Localization.Away h) t)
    (𝔭.map (algebraMap A (Localization.Away h))) c (algebraMap A (Localization.Away h) a)
    hspan hxq haq
  have hsm := s4 ↥W (Localization.Away h) f₀ hfC' hfet
  obtain ⟨s, hs, hset⟩ := wc_tube_jacobian_etale ↥W (Localization.Away h) 1 (Fin 1)
    ![(algebraMap A (Localization.Away h) t - algebraMap ↥W (Localization.Away h) c) *
      algebraMap A (Localization.Away h) a] hsm (Fintype.card_fin 1) _ hres
  have hθ := hset (Localization.Away s)
  obtain ⟨h', hh', ha', ψ, hψ, hψet⟩ := s6 A 𝔭 h a s hh ha hs
  let θ₁ := (algebraMap (Localization.Away h) (Localization.Away s)).comp
    (MvPolynomial.eval₂Hom (algebraMap ↥W (Localization.Away h))
      ![(algebraMap A (Localization.Away h) t - algebraMap ↥W (Localization.Away h) c) *
        algebraMap A (Localization.Away h) a])
  let ε : Polynomial ↥W →+* MvPolynomial (Fin 1) ↥W :=
    (MvPolynomial.uniqueAlgEquiv ↥W (Fin 1)).symm.toRingEquiv.toRingHom
  have hεC : ∀ w : ↥W, ε (Polynomial.C w) = MvPolynomial.C w := by
    intro w
    show (MvPolynomial.uniqueAlgEquiv ↥W (Fin 1)).symm (Polynomial.C w) = _
    rw [MvPolynomial.uniqueAlgEquiv_symm_apply, Polynomial.eval₂_C]
  have hεX : ε Polynomial.X = MvPolynomial.X 0 := by
    show (MvPolynomial.uniqueAlgEquiv ↥W (Fin 1)).symm Polynomial.X = _
    rw [MvPolynomial.uniqueAlgEquiv_symm_apply, Polynomial.eval₂_X, Fin.default_eq_zero]
  refine ⟨h', hh', ha', ψ.comp (θ₁.comp ε), ?_, ?_, ?_⟩
  · apply RingHom.ext
    intro w
    have e2 := congrArg (fun F => F (algebraMap ↥W A w)) hψ
    simp only [RingHom.comp_apply] at e2 ⊢
    rw [hεC]
    simp only [θ₁, RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
    rw [IsScalarTower.algebraMap_apply ↥W A (Localization.Away h)]
    exact e2
  · have e2 := congrArg (fun F => F ((t - algebraMap ↥W A c) * a)) hψ
    simp only [RingHom.comp_apply] at e2 ⊢
    rw [hεX]
    simp only [θ₁, RingHom.comp_apply, MvPolynomial.eval₂Hom_X', Matrix.cons_val_zero]
    rw [hG]
    exact e2
  · exact RingHom.Etale.stableUnderComposition (θ₁.comp ε) ψ
      (RingHom.Etale.stableUnderComposition ε θ₁
        (RingHom.Etale.of_bijective (MvPolynomial.uniqueAlgEquiv ↥W (Fin 1)).symm.bijective) hθ)
      hψet

theorem wcLlsKP_ed_kummer_basechange_etale : ∀ (R0 A : Type u) [CommRing R0] [CommRing A] (ι0 : R0 →+* A) (s G : A) (ℓ : ℕ) (φ : Polynomial R0 →+* Localization.Away s), φ.comp Polynomial.C = (algebraMap A (Localization.Away s)).comp ι0 → φ Polynomial.X = algebraMap A (Localization.Away s) G → RingHom.Etale φ → ∃ f : Polynomial R0 →+* Localization.Away (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C G) s), f.comp Polynomial.C = (algebraMap (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C G)) (Localization.Away (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C G) s))).comp ((AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C G)).comp ι0) ∧ f Polynomial.X = algebraMap (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C G)) (Localization.Away (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C G) s)) (AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C G)) ∧ RingHom.Etale f :=
by
  intro R0 A _ _ ι0 s G ℓ φ hC hX hφ

  have s2 : ∀ (R S T C : Type u) [CommRing R] [CommRing S] [CommRing T] [CommRing C]
      (φ : R →+* S) (β : R →+* T) (u : T →+* C) (v : S →+* C), RingHom.Etale φ →
      u.comp β = v.comp φ →
      (∀ (D : Type u) [CommRing D] (u' : T →+* D) (v' : S →+* D), u'.comp β = v'.comp φ →
        ∃ w : C →+* D, w.comp u = u' ∧ w.comp v = v') →
      (∀ (D : Type u) [CommRing D] (w₁ w₂ : C →+* D), w₁.comp u = w₂.comp u →
        w₁.comp v = w₂.comp v → w₁ = w₂) →
      RingHom.Etale u := by
    intro R S T C _ _ _ _ φ β u v hφ hsq hex huniq
    letI : Algebra R S := φ.toAlgebra
    letI : Algebra R T := β.toAlgebra
    letI : Algebra R C := (u.comp β).toAlgebra
    haveI : Algebra.Etale R S := hφ.toAlgebra
    have hbc : (algebraMap T (TensorProduct R T S)).Etale := by
      rw [RingHom.etale_algebraMap]; infer_instance
    let uA : T →ₐ[R] C := { u with commutes' := fun r => rfl }
    let vA : S →ₐ[R] C := { v with commutes' := fun r => (congrArg (· r) hsq).symm }
    let Θ : TensorProduct R T S →+* C := (Algebra.TensorProduct.productMap uA vA).toRingHom
    have hΘ : ∀ t x, Θ (t ⊗ₜ x) = u t * v x := fun t x =>
      Algebra.TensorProduct.productMap_apply_tmul uA vA t x
    obtain ⟨Ψ, hΨu, hΨv⟩ := hex (TensorProduct R T S) Algebra.TensorProduct.includeLeftRingHom
      Algebra.TensorProduct.includeRight.toRingHom (RingHom.ext fun r =>
        Algebra.TensorProduct.tmul_one_eq_one_tmul (R := R) (A := T) (B := S) r)
    have hΨu' : ∀ t, Ψ (u t) = t ⊗ₜ (1 : S) := fun t => congrArg (· t) hΨu
    have hΨv' : ∀ x, Ψ (v x) = (1 : T) ⊗ₜ x := fun x => congrArg (· x) hΨv
    have h1 : Θ.comp Ψ = RingHom.id C := by
      apply huniq C
      · apply RingHom.ext; intro t
        show Θ (Ψ (u t)) = u t
        rw [hΨu', hΘ, map_one, mul_one]
      · apply RingHom.ext; intro x
        show Θ (Ψ (v x)) = v x
        rw [hΨv', hΘ, map_one, one_mul]
    have h2 : ∀ z, Ψ (Θ z) = z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => rw [map_zero, map_zero]
      | tmul t x =>
        rw [hΘ, map_mul, hΨu', hΨv', Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      | add a b ha hb => rw [map_add, map_add, ha, hb]
    have hbij : Function.Bijective Θ := by
      rw [Function.bijective_iff_has_inverse]
      exact ⟨Ψ, h2, fun c => congrArg (· c) h1⟩
    have hΘet : Θ.Etale := RingHom.Etale.of_bijective hbij
    have hfac : u = Θ.comp (algebraMap T (TensorProduct R T S)) := by
      apply RingHom.ext; intro t
      show u t = Θ (t ⊗ₜ 1)
      rw [hΘ, map_one, mul_one]
    rw [hfac]
    exact RingHom.Etale.stableUnderComposition _ _ hbc hΘet

  set F : Polynomial A := Polynomial.X ^ ℓ - Polynomial.C G with hFdef
  set α : AdjoinRoot F →+* Localization.Away (AdjoinRoot.of F s) :=
    algebraMap (AdjoinRoot F) (Localization.Away (AdjoinRoot.of F s)) with hαdef
  set ιs : A →+* Localization.Away s := algebraMap A (Localization.Away s) with hιs

  let f : Polynomial R0 →+* Localization.Away (AdjoinRoot.of F s) :=
    Polynomial.eval₂RingHom (α.comp ((AdjoinRoot.of F).comp ι0)) (α (AdjoinRoot.root F))
  have hfC : f.comp Polynomial.C = α.comp ((AdjoinRoot.of F).comp ι0) :=
    RingHom.ext fun r => Polynomial.eval₂_C _ _
  have hfX : f Polynomial.X = α (AdjoinRoot.root F) := Polynomial.eval₂_X _ _
  have hu : IsUnit (α (AdjoinRoot.of F s)) :=
    IsLocalization.Away.algebraMap_isUnit (AdjoinRoot.of F s)
  let v : Localization.Away s →+* Localization.Away (AdjoinRoot.of F s) :=
    IsLocalization.Away.lift (S := Localization.Away s) s (g := α.comp (AdjoinRoot.of F)) hu
  have hv : ∀ a, v (ιs a) = α (AdjoinRoot.of F a) := fun a =>
    IsLocalization.Away.lift_eq s hu a
  have hroot : (AdjoinRoot.root F) ^ ℓ = AdjoinRoot.of F G := by
    have h := AdjoinRoot.mk_self (f := F)
    rw [hFdef, map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h
    exact h
  refine ⟨f, hfC, hfX, ?_⟩

  have hsq : f.comp (Polynomial.expand R0 ℓ).toRingHom = v.comp φ := by
    apply Polynomial.ringHom_ext
    · intro c
      show f (Polynomial.expand R0 ℓ (Polynomial.C c)) = v (φ (Polynomial.C c))
      rw [Polynomial.expand_C, ← RingHom.comp_apply φ, hC, RingHom.comp_apply, hv]
      exact congrArg (· c) hfC
    · show f (Polynomial.expand R0 ℓ Polynomial.X) = v (φ Polynomial.X)
      rw [Polynomial.expand_X, map_pow, hfX, ← map_pow, hroot, hX, hv]
  apply s2 _ _ _ _ φ (Polynomial.expand R0 ℓ).toRingHom f v hφ hsq
  ·
    intro D _ u' v' h
    have hx0 : Polynomial.eval₂ (v'.comp ιs) (u' Polynomial.X) F = 0 := by
      rw [hFdef, Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, sub_eq_zero,
        ← map_pow]
      have := congrArg (· Polynomial.X) h
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        Polynomial.expand_X] at this
      rw [this, hX]
      rfl
    let w0 : AdjoinRoot F →+* D := AdjoinRoot.lift (v'.comp ιs) (u' Polynomial.X) hx0
    have hw0of : ∀ a, w0 (AdjoinRoot.of F a) = v' (ιs a) := fun a => AdjoinRoot.lift_of hx0
    have hw0r : w0 (AdjoinRoot.root F) = u' Polynomial.X := AdjoinRoot.lift_root hx0
    have hunit : IsUnit (w0 (AdjoinRoot.of F s)) := by
      rw [hw0of]; exact (IsLocalization.Away.algebraMap_isUnit s).map v'
    let w : Localization.Away (AdjoinRoot.of F s) →+* D :=
      IsLocalization.Away.lift (AdjoinRoot.of F s) hunit
    have hw : ∀ b, w (α b) = w0 b := fun b => IsLocalization.Away.lift_eq _ hunit b
    refine ⟨w, ?_, ?_⟩
    · apply Polynomial.ringHom_ext
      · intro c
        have e1 : f (Polynomial.C c) = α (AdjoinRoot.of F (ι0 c)) := congrArg (· c) hfC
        have e2 := congrArg (· (Polynomial.C c)) h
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          Polynomial.expand_C] at e2
        have e3 : φ (Polynomial.C c) = ιs (ι0 c) := congrArg (· c) hC
        rw [RingHom.comp_apply, e1, hw, hw0of, e2, e3]
      · rw [RingHom.comp_apply, hfX, hw, hw0r]
    · apply IsLocalization.ringHom_ext (Submonoid.powers s)
      apply RingHom.ext; intro a
      simp only [RingHom.comp_apply]
      rw [← hιs, hv, hw, hw0of]
  ·
    intro D _ w₁ w₂ h₁ h₂
    apply IsLocalization.ringHom_ext (Submonoid.powers (AdjoinRoot.of F s))
    apply AdjoinRoot.ringHom_ext
    · apply RingHom.ext; intro a
      simp only [RingHom.comp_apply]
      rw [← hαdef, ← hv]
      exact congrArg (· (ιs a)) h₂
    · simp only [RingHom.comp_apply]
      rw [← hαdef, ← hfX]
      exact congrArg (· Polynomial.X) h₁

theorem wcLlsKP_ed_kummer_point : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A] (𝔭 : Ideal A) (t s a : A) (c : ↥W) (ℓ : ℕ), 𝔭.IsMaximal → 𝔭 = Ideal.span {t} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) → c ∈ IsLocalRing.maximalIdeal ↥W → s ∉ 𝔭 → IsUnit (algebraMap A (Localization.Away s) a) → 0 < ℓ → (Ideal.span {AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a))} ⊔ 𝔭.map (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a)))).IsMaximal ∧ AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a)) s ∉ (Ideal.span {AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a))} ⊔ 𝔭.map (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a)))) ∧ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a)))) ≤ (Ideal.span {AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a))} ⊔ 𝔭.map (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a)))) ∧ (Ideal.span {AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a))} ⊔ 𝔭.map (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a)))).map (algebraMap (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a))) (Localization.Away (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a)) s))) = (Ideal.span {AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a))} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a))))).map (algebraMap (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a))) (Localization.Away (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a)) s))) :=
by
  intro Ω _ W A _ _ 𝔭 t s a c ℓ hmax h𝔭eq hc hs ha hℓ
  have ht : t ∈ 𝔭 := by
    rw [h𝔭eq]; exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self t)
  have hmA : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 := by
    rw [h𝔭eq]; exact le_sup_right
  have hc' : algebraMap ↥W A c ∈ 𝔭 := hmA (Ideal.mem_map_of_mem _ hc)
  have hG' : (t - algebraMap ↥W A c) * a ∈ 𝔭 := 𝔭.mul_mem_right a (𝔭.sub_mem ht hc')
  set G := (t - algebraMap ↥W A c) * a with hGdef
  set F := Polynomial.X ^ ℓ - Polynomial.C G with hF

  let _ : Field (A ⧸ 𝔭) := Ideal.Quotient.field 𝔭
  have hF0 : Polynomial.eval₂ (Ideal.Quotient.mk 𝔭) (0 : A ⧸ 𝔭) F = 0 := by
    rw [hF, Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C,
      zero_pow hℓ.ne', Ideal.Quotient.eq_zero_iff_mem.mpr hG', sub_zero]
  have hevof : ∀ x : A, AdjoinRoot.lift (Ideal.Quotient.mk 𝔭) (0 : A ⧸ 𝔭) hF0
      (AdjoinRoot.of F x) = Ideal.Quotient.mk 𝔭 x := fun x => AdjoinRoot.lift_of hF0
  have hevroot : AdjoinRoot.lift (Ideal.Quotient.mk 𝔭) (0 : A ⧸ 𝔭) hF0
      (AdjoinRoot.root F) = 0 := AdjoinRoot.lift_root hF0
  have hsurj : Function.Surjective (AdjoinRoot.lift (Ideal.Quotient.mk 𝔭) (0 : A ⧸ 𝔭) hF0) := by
    intro z
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
    exact ⟨_, hevof x⟩
  have hker : RingHom.ker (AdjoinRoot.lift (Ideal.Quotient.mk 𝔭) (0 : A ⧸ 𝔭) hF0) =
      Ideal.span {AdjoinRoot.root F} ⊔ 𝔭.map (AdjoinRoot.of F) := by
    apply le_antisymm
    · intro b hb
      rw [RingHom.mem_ker] at hb
      obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective b
      have hp : AdjoinRoot.mk F p = AdjoinRoot.root F * AdjoinRoot.mk F p.divX +
          AdjoinRoot.of F (p.coeff 0) := by
        conv_lhs => rw [← Polynomial.X_mul_divX_add p]
        rw [map_add, map_mul, AdjoinRoot.mk_X, AdjoinRoot.mk_C]
      rw [hp] at hb ⊢
      rw [map_add, map_mul, hevroot, zero_mul, zero_add, hevof,
        Ideal.Quotient.eq_zero_iff_mem] at hb
      exact Ideal.add_mem _
        (Ideal.mem_sup_left (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)))
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hb))
    · apply sup_le
      · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
        exact hevroot
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap, RingHom.mem_ker, hevof, Ideal.Quotient.eq_zero_iff_mem]
        exact hx

  have hmB : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W (AdjoinRoot F)) =
      ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map (AdjoinRoot.of F) := by
    rw [AdjoinRoot.algebraMap_eq', ← Ideal.map_map]

  have hroot : AdjoinRoot.root F ^ ℓ = AdjoinRoot.of F G := by
    have h : AdjoinRoot.mk F (Polynomial.X ^ ℓ - Polynomial.C G) = 0 :=
      AdjoinRoot.mk_self
    rw [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h
    exact h
  have hct : AdjoinRoot.of F (algebraMap ↥W A c) = algebraMap ↥W (AdjoinRoot F) c := by
    rw [AdjoinRoot.algebraMap_eq', RingHom.comp_apply]
  have hpmap : 𝔭.map (AdjoinRoot.of F) = Ideal.span {AdjoinRoot.of F t} ⊔
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W (AdjoinRoot F)) := by
    rw [hmB]
    conv_lhs => rw [h𝔭eq]
    rw [Ideal.map_sup, Ideal.map_span, Set.image_singleton]
  set ι := algebraMap (AdjoinRoot F) (Localization.Away (AdjoinRoot.of F s)) with hι
  have hgs : IsUnit ((ι.comp (AdjoinRoot.of F)) s) :=
    IsLocalization.Away.algebraMap_isUnit (AdjoinRoot.of F s)
  have hu : IsUnit (ι (AdjoinRoot.of F a)) := by
    have := ha.map (IsLocalization.Away.lift (S := Localization.Away s) s hgs)
    rwa [IsLocalization.Away.lift_eq] at this
  obtain ⟨v, hv⟩ := hu.exists_left_inv
  have hofG : ι (AdjoinRoot.of F G) =
      (ι (AdjoinRoot.of F t) - ι (algebraMap ↥W (AdjoinRoot F) c)) * ι (AdjoinRoot.of F a) := by
    rw [hGdef, map_mul, map_sub, hct, map_mul, map_sub]
  have hmem : ι (AdjoinRoot.of F t) ∈ (Ideal.span {AdjoinRoot.root F}).map ι ⊔
      ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W (AdjoinRoot F))).map ι := by
    have e : ι (AdjoinRoot.of F t) =
        ι (algebraMap ↥W (AdjoinRoot F) c) + v * ι (AdjoinRoot.root F ^ ℓ) := by
      rw [hroot, hofG]
      linear_combination (ι (algebraMap ↥W (AdjoinRoot F) c) - ι (AdjoinRoot.of F t)) * hv
    rw [e]
    refine Ideal.add_mem _
      (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hc)))
      (Ideal.mem_sup_left ?_)
    exact Ideal.mul_mem_left _ v (Ideal.mem_map_of_mem _
      (Ideal.pow_mem_of_mem _ (Ideal.mem_span_singleton_self _) ℓ hℓ))
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [← hker]
    exact RingHom.ker_isMaximal_of_surjective _ hsurj
  · intro h
    rw [← hker, RingHom.mem_ker, hevof, Ideal.Quotient.eq_zero_iff_mem] at h
    exact hs h
  · rw [hmB]
    exact (Ideal.map_mono hmA).trans le_sup_right
  · rw [Ideal.map_sup, Ideal.map_sup]
    apply le_antisymm
    · refine sup_le le_sup_left ?_
      rw [hpmap, Ideal.map_sup, Ideal.map_span, Set.image_singleton]
      refine sup_le ?_ le_sup_right
      rw [Ideal.span_le, Set.singleton_subset_iff]
      exact hmem
    · apply sup_le_sup_left
      apply Ideal.map_mono
      rw [hpmap]
      exact le_sup_right

theorem wcLlsKP_ed_etale_point_normal : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (R : Type u) [CommRing R] (h : R) (P : Ideal R) [P.IsPrime] (f : Polynomial ↥W →+* Localization.Away h), h ∉ P → RingHom.Etale f → IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P) :=
by
  intro Ω _ W R _ h P _ f hhP hf
  have hdisj : Disjoint ((Submonoid.powers h : Submonoid R) : Set R) (P : Set R) :=
    (Ideal.disjoint_powers_iff_notMem (y := h) (Ideal.IsPrime.isRadical ‹P.IsPrime›)).mpr hhP
  set q : Ideal (Localization.Away h) := Ideal.map (algebraMap R (Localization.Away h)) P with hqdef
  haveI hq : q.IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) (Localization.Away h) P
      ‹P.IsPrime› hdisj
  have hcomap : Ideal.comap (algebraMap R (Localization.Away h)) q = P :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers h) (Localization.Away h)
      ‹P.IsPrime› hdisj
  have hQ : IsDomain (Localization.AtPrime q) ∧ IsIntegrallyClosed (Localization.AtPrime q) := by
    letI : Algebra (Polynomial ↥W) (Localization.Away h) := f.toAlgebra
    haveI : Algebra.Etale (Polynomial ↥W) (Localization.Away h) := hf
    exact wc_pks_etale_localization_normal (Polynomial ↥W) (Localization.Away h) q
  have hloc0 := IsLocalization.isLocalization_atPrime_localization_atPrime
    (Submonoid.powers h) q
  have hsub : (Ideal.comap (algebraMap R (Localization.Away h)) q).primeCompl = P.primeCompl := by
    ext x
    rw [Ideal.mem_primeCompl_iff, Ideal.mem_primeCompl_iff, hcomap]
  have hloc : IsLocalization P.primeCompl (Localization.AtPrime q) := by
    have h1 : IsLocalization (Ideal.comap (algebraMap R (Localization.Away h)) q).primeCompl
        (Localization.AtPrime q) := hloc0
    rw [hsub] at h1
    exact h1
  let e : Localization.AtPrime P ≃ₐ[R] Localization.AtPrime q :=
    IsLocalization.algEquiv P.primeCompl (Localization.AtPrime P) (Localization.AtPrime q)
  haveI := hQ.1
  haveI := hQ.2
  refine ⟨MulEquiv.isDomain (Localization.AtPrime q) e.toRingEquiv.toMulEquiv, ?_⟩
  exact IsIntegrallyClosed.of_equiv e.toRingEquiv.symm

theorem wcLlsKP_ed_kummer_order_frac : ∀ (A : Type u) [CommRing A] [IsDomain A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] (ℓ : ℕ), ℓ.Prime → Module.finrank K L = ℓ → ∀ (θ : L) (g : A), θ ∉ Set.range (algebraMap K L) → θ ^ ℓ = algebraMap A L g → ∀ j : AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C g) →+* L, j (AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C g)) = θ → j.comp (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C g)) = algebraMap A L → Function.Injective j ∧ ∀ l : L, ∃ r r' : AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C g), j r' ≠ 0 ∧ j r' * l = j r :=
by
  intro A _ _ K _ _ _ L _ _ _ _ _ ℓ hℓ hrank θ g hθK hθ j hjroot hjof
  classical
  have hint : IsIntegral K θ := IsIntegral.of_finite K θ

  have hdeg : (minpoly K θ).natDegree = ℓ := by
    have hdvd : (minpoly K θ).natDegree ∣ ℓ := by
      rw [← hrank]
      exact minpoly.degree_dvd hint
    rcases hℓ.eq_one_or_self_of_dvd _ hdvd with h1 | h1
    · exfalso
      exact hθK ((minpoly.natDegree_eq_one_iff).mp h1)
    · exact h1
  have hθc : θ ^ ℓ = algebraMap K L (algebraMap A K g) := by
    rw [hθ, ← IsScalarTower.algebraMap_apply]
  have hPm : (Polynomial.X ^ ℓ - Polynomial.C g : Polynomial A).Monic :=
    Polynomial.monic_X_pow_sub_C g hℓ.ne_zero
  have hPdeg : (Polynomial.X ^ ℓ - Polynomial.C g : Polynomial A).natDegree = ℓ :=
    Polynomial.natDegree_X_pow_sub_C
  have hAKinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hPθ : Polynomial.aeval θ (Polynomial.X ^ ℓ - Polynomial.C g : Polynomial A) = 0 := by
    rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, hθ, sub_self]

  have hintdvd : ∀ q : Polynomial A, Polynomial.aeval θ q = 0 →
      (Polynomial.X ^ ℓ - Polynomial.C g : Polynomial A) ∣ q := by
    intro q hq
    have hρ : Polynomial.aeval θ (q %ₘ (Polynomial.X ^ ℓ - Polynomial.C g)) = 0 := by
      have e := Polynomial.modByMonic_add_div q (Polynomial.X ^ ℓ - Polynomial.C g)
      have e2 : Polynomial.aeval θ (q %ₘ (Polynomial.X ^ ℓ - Polynomial.C g) +
          (Polynomial.X ^ ℓ - Polynomial.C g) * (q /ₘ (Polynomial.X ^ ℓ - Polynomial.C g))) =
          Polynomial.aeval θ q := by rw [e]
      rw [map_add, map_mul, hPθ, zero_mul, add_zero, hq] at e2
      exact e2
    have hρK : Polynomial.aeval θ
        ((q %ₘ (Polynomial.X ^ ℓ - Polynomial.C g)).map (algebraMap A K)) = 0 := by
      rw [Polynomial.aeval_map_algebraMap]; exact hρ
    have hdvdK := minpoly.dvd K θ hρK
    have hlt : (q %ₘ (Polynomial.X ^ ℓ - Polynomial.C g)).natDegree < ℓ := by
      have := Polynomial.natDegree_modByMonic_lt q hPm (by
        intro h1
        have h2 := congrArg Polynomial.natDegree h1
        rw [hPdeg, Polynomial.natDegree_one] at h2
        exact hℓ.ne_zero h2)
      rwa [hPdeg] at this
    have hz : (q %ₘ (Polynomial.X ^ ℓ - Polynomial.C g)).map (algebraMap A K) = 0 := by
      by_contra hne
      have := Polynomial.natDegree_le_of_dvd hdvdK hne
      rw [hdeg, Polynomial.natDegree_map_eq_of_injective hAKinj] at this
      omega
    have hz' : q %ₘ (Polynomial.X ^ ℓ - Polynomial.C g) = 0 := by
      apply Polynomial.map_injective _ hAKinj
      rw [hz, Polynomial.map_zero]
    exact (Polynomial.modByMonic_eq_zero_iff_dvd hPm).mp hz'
  have hjofa : ∀ a : A, j (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C g) a) = algebraMap A L a :=
    fun a => RingHom.congr_fun hjof a

  have hjmk : ∀ q : Polynomial A,
      j (AdjoinRoot.mk (Polynomial.X ^ ℓ - Polynomial.C g) q) = Polynomial.aeval θ q := by
    have : j.comp (AdjoinRoot.mk (Polynomial.X ^ ℓ - Polynomial.C g)) =
        (Polynomial.aeval θ : Polynomial A →ₐ[A] L).toRingHom := by
      apply Polynomial.ringHom_ext
      · intro a
        rw [RingHom.comp_apply, AdjoinRoot.mk_C, hjofa]
        simp
      · rw [RingHom.comp_apply, AdjoinRoot.mk_X, hjroot]
        simp
    intro q
    exact RingHom.congr_fun this q
  have hALinj : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp hAKinj
  refine ⟨?_, ?_⟩
  · rw [injective_iff_map_eq_zero]
    intro r hr
    obtain ⟨q, rfl⟩ := AdjoinRoot.mk_surjective r
    rw [hjmk] at hr
    exact AdjoinRoot.mk_eq_zero.mpr (hintdvd q hr)
  · intro l
    have htop : IntermediateField.adjoin K {θ} = ⊤ := by
      apply IntermediateField.eq_of_le_of_finrank_eq le_top
      rw [IntermediateField.adjoin.finrank hint, hdeg, IntermediateField.finrank_top', hrank]
    have hl : l ∈ (IntermediateField.adjoin K {θ}).toSubalgebra := by
      rw [htop]; exact IntermediateField.mem_top
    rw [IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hint.isAlgebraic,
      Algebra.adjoin_singleton_eq_range_aeval] at hl
    obtain ⟨p, hp⟩ := hl
    have hp' : Polynomial.aeval θ p = l := hp
    obtain ⟨b, hb, hbq⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors A) p
    refine ⟨AdjoinRoot.mk (Polynomial.X ^ ℓ - Polynomial.C g)
        (IsLocalization.integerNormalization (nonZeroDivisors A) p),
      AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C g) b, ?_, ?_⟩
    · rw [hjofa]
      intro h0
      apply nonZeroDivisors.ne_zero hb
      exact hALinj (h0.trans (map_zero _).symm)
    · rw [hjofa, hjmk, ← Polynomial.aeval_map_algebraMap K, hbq]
      rw [← algebraMap_smul K b p, map_smul, hp', Algebra.smul_def,
        ← IsScalarTower.algebraMap_apply]

theorem wcLlsKP_ed_fs_transport : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (L : Type u) [Field L] [Algebra A L] (R : Type u) [CommRing R] [Algebra ↥W R] (κ : R →+* ↥(integralClosure A L)) (P : Ideal R) [P.IsPrime] (y : Ideal ↥(integralClosure A L)) [y.IsPrime], Function.Injective κ → (∀ a : A, ∃ r : R, κ r = algebraMap A ↥(integralClosure A L) a) → (∀ w : ↥W, κ (algebraMap ↥W R w) = algebraMap A ↥(integralClosure A L) (algebraMap ↥W A w)) → (∀ l : L, ∃ r r' : R, ((κ r' : ↥(integralClosure A L)) : L) ≠ 0 ∧ (κ r' : L) * l = κ r) → IsDomain (Localization.AtPrime P) → IsIntegrallyClosed (Localization.AtPrime P) → y.comap κ = P → Nonempty (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y ≃+* (Localization.AtPrime P ⧸ ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R)).map (algebraMap R (Localization.AtPrime P)))) :=
by
  intro Ω _ W A _ _ _ L _ _ R _ _ κ P _ y _ hinj hA hW hfrac hdom hnorm hyP
  classical
  haveI := hdom

  have hden : ∀ x : ↥(integralClosure A L), ∃ b s : R, s ∉ P ∧ κ s * x = κ b := by
    intro x
    let κ' : R →+* L := (algebraMap ↥(integralClosure A L) L).comp κ
    have hκ'inj : Function.Injective κ' := fun a b h => hinj (Subtype.ext h)
    have hκ'ne : ∀ s : P.primeCompl, κ' s ≠ 0 := by
      intro s hs
      have h0 : (s : R) = 0 := hκ'inj (by rw [hs, map_zero])
      exact s.2 (by rw [h0]; exact P.zero_mem)
    let ψ : Localization.AtPrime P →+* L :=
      IsLocalization.lift (M := P.primeCompl) (g := κ') (fun s => isUnit_iff_ne_zero.mpr (hκ'ne s))
    have hψ : ∀ r, ψ (algebraMap R (Localization.AtPrime P) r) = κ' r := fun r =>
      IsLocalization.lift_eq _ r
    have hψinj : Function.Injective ψ := by
      rw [injective_iff_map_eq_zero]
      intro u hu
      obtain ⟨⟨r, s⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl u
      rw [IsLocalization.lift_mk'_spec, mul_zero] at hu
      have hr : r = 0 := hκ'inj (by rw [hu, map_zero])
      subst hr
      exact IsLocalization.mk'_zero s
    let F := FractionRing (Localization.AtPrime P)
    let Ψ : F →+* L := IsFractionRing.lift (K := F) hψinj
    have hΨ : ∀ u, Ψ (algebraMap (Localization.AtPrime P) F u) = ψ u := fun u =>
      IsFractionRing.lift_algebraMap hψinj u
    have hΨinj : Function.Injective Ψ := Ψ.injective
    have hΨcomp : (Ψ.comp (algebraMap (Localization.AtPrime P) F)).comp
        (algebraMap R (Localization.AtPrime P)) = κ' :=
      RingHom.ext fun r => by
        rw [RingHom.comp_apply, RingHom.comp_apply, hΨ, hψ]
    obtain ⟨r, r', hr'0, hrr⟩ := hfrac (x : L)
    let z : F := algebraMap (Localization.AtPrime P) F (algebraMap R _ r) /
      algebraMap (Localization.AtPrime P) F (algebraMap R _ r')
    have hz : Ψ z = x := by
      show Ψ (algebraMap (Localization.AtPrime P) F (algebraMap R _ r) /
        algebraMap (Localization.AtPrime P) F (algebraMap R _ r')) = x
      rw [map_div₀, hΨ, hΨ, hψ, hψ, div_eq_iff (show κ' r' ≠ 0 from hr'0), mul_comm]
      exact hrr.symm
    have hxint : IsIntegral A (x : L) := x.2
    obtain ⟨p, hpm, hpx⟩ := hxint
    have hlifts : p.map (algebraMap A L) ∈ Polynomial.lifts κ' := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      rw [Polynomial.coeff_map]
      obtain ⟨rn, hrn⟩ := hA (p.coeff n)
      exact ⟨rn, congrArg Subtype.val hrn⟩
    obtain ⟨q, hqmap, -, hqm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlifts (hpm.map _)
    have hq : Polynomial.eval₂ κ' (x : L) q = 0 := by
      rw [← Polynomial.eval_map, hqmap, Polynomial.eval_map]
      exact hpx
    have hzint : IsIntegral (Localization.AtPrime P) z := by
      refine ⟨q.map (algebraMap R (Localization.AtPrime P)), hqm.map _, ?_⟩
      apply hΨinj
      rw [map_zero, Polynomial.hom_eval₂, Polynomial.eval₂_map, hz, hΨcomp]
      exact hq
    obtain ⟨u, hu⟩ := IsIntegrallyClosed.isIntegral_iff.mp hzint
    obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl u
    refine ⟨b, s, s.2, ?_⟩
    apply Subtype.ext
    have h1 : ψ (IsLocalization.mk' (Localization.AtPrime P) b s) = x := by
      rw [← hΨ, hu, hz]
    rw [IsLocalization.lift_mk'_spec] at h1
    exact h1.symm

  let algS := algebraMap ↥(integralClosure A L) (Localization.AtPrime y)
  have hg : ∀ s : P.primeCompl, IsUnit ((algS.comp κ) s) := by
    intro s
    apply (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime y) y (κ s)).mpr
    intro hs
    have hs' : (s : R) ∈ y.comap κ := hs
    rw [hyP] at hs'
    exact s.2 hs'
  let φ : Localization.AtPrime P →+* Localization.AtPrime y :=
    IsLocalization.lift (M := P.primeCompl) hg
  have hφ : ∀ r, φ (algebraMap R (Localization.AtPrime P) r) = algS (κ r) := fun r =>
    IsLocalization.lift_eq hg r
  have halgSinj : Function.Injective algS :=
    IsLocalization.injective _ (Ideal.primeCompl_le_nonZeroDivisors y)
  have hφinj : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro u hu
    obtain ⟨⟨r, s⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl u
    rw [IsLocalization.lift_mk'_spec, mul_zero] at hu
    have hr : r = 0 := hinj (halgSinj (show algS (κ r) = algS (κ 0) by
      rw [map_zero, map_zero]; exact hu))
    subst hr
    exact IsLocalization.mk'_zero s
  have hφsurj : Function.Surjective φ := by
    intro v
    obtain ⟨⟨x, u⟩, rfl⟩ := IsLocalization.mk'_surjective y.primeCompl v
    obtain ⟨b₁, s₁, hs₁, h₁⟩ := hden x
    obtain ⟨b₂, s₂, hs₂, h₂⟩ := hden (u : ↥(integralClosure A L))
    have hb₂ : b₂ ∉ P := by
      intro hb
      rw [← hyP, Ideal.mem_comap, ← h₂] at hb
      rcases Ideal.IsPrime.mem_or_mem ‹y.IsPrime› hb with h | h
      · exact hs₂ (by rw [← hyP]; exact h)
      · exact u.2 h
    have hsb : s₁ * b₂ ∈ P.primeCompl := by
      intro h
      rcases Ideal.IsPrime.mem_or_mem ‹P.IsPrime› h with h | h
      · exact hs₁ h
      · exact hb₂ h
    refine ⟨IsLocalization.mk' (Localization.AtPrime P) (b₁ * s₂) ⟨s₁ * b₂, hsb⟩, ?_⟩
    rw [IsLocalization.lift_mk'_spec]
    have hspec : algS u * IsLocalization.mk' (Localization.AtPrime y) x u = algS x :=
      IsLocalization.mk'_spec' _ x u
    show algS (κ (b₁ * s₂)) = algS (κ (s₁ * b₂)) * _
    rw [map_mul κ, map_mul κ, ← h₁, ← h₂, map_mul, map_mul, map_mul, map_mul, ← hspec]
    ring
  let e : Localization.AtPrime P ≃+* Localization.AtPrime y :=
    RingEquiv.ofBijective φ ⟨hφinj, hφsurj⟩

  have he' : (e : Localization.AtPrime P →+* Localization.AtPrime y).comp
      (algebraMap R (Localization.AtPrime P)) = algS.comp κ :=
    RingHom.ext fun r => hφ r
  have hW' : κ.comp (algebraMap ↥W R) =
      (algebraMap A ↥(integralClosure A L)).comp (algebraMap ↥W A) := RingHom.ext hW
  have hspan : Ideal.span {b : ↥(integralClosure A L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w} =
      ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
        (algebraMap A ↥(integralClosure A L)) := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro b ⟨w, hw', hb⟩
      have hb' : b = algebraMap A ↥(integralClosure A L) (algebraMap ↥W A w) := Subtype.ext hb
      rw [hb']
      exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hw')
    · rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
      intro w hw'
      exact Ideal.subset_span ⟨w, hw', rfl⟩
  have hJ : (Ideal.span {b : ↥(integralClosure A L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w}).map
        algS =
      Ideal.map (e : Localization.AtPrime P →+* Localization.AtPrime y)
        (((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R)).map
          (algebraMap R (Localization.AtPrime P))) := by
    rw [hspan, Ideal.map_map, Ideal.map_map, Ideal.map_map, Ideal.map_map]
    congr 1
    rw [he']
    simp only [RingHom.comp_assoc, hW']
  exact ⟨(Ideal.quotientEquiv _ _ e hJ).symm⟩

theorem wcLlsKP_eisenstein_delta_zero : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
      [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
      (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ (θ : L) (a : A) (c : ↥W), c ∈ IsLocalRing.maximalIdeal ↥W → a ∉ 𝔭 →
      θ ^ ℓ = algebraMap A L ((t - algebraMap ↥W A c) * a) →
      ∀ (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
      wcpaDjLkDelta (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) = 0 :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hfr θ a c hc ha hθ hy hyc
  classical
  obtain ⟨-, -, hic, hmax, hm𝔭, ht, h𝔭eq, h, hh, f₀, hfC, hfX, hfet⟩ := hPD
  haveI : 𝔭.IsPrime := hmax.isPrime
  haveI := hic
  have hcm : algebraMap ↥W A c ∈ 𝔭 := hm𝔭 (Ideal.mem_map_of_mem _ hc)
  have hg𝔭 : (t - algebraMap ↥W A c) * a ∈ 𝔭 := 𝔭.mul_mem_right a (𝔭.sub_mem ht hcm)

  have s11 : ∀ (B : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B],
      wcpaDjLkDelta B = 0 := by
    intro B _ _ _
    unfold wcpaDjLkDelta
    rw [Module.length_eq_zero_iff]
    have htop : LinearMap.range
        (Algebra.linearMap B ↥(integralClosure B (FractionRing B))) = ⊤ := by
      rw [eq_top_iff]
      rintro ⟨x, hx⟩ -
      obtain ⟨b, hb⟩ := IsIntegrallyClosed.isIntegral_iff.mp (show IsIntegral B x from hx)
      exact LinearMap.mem_range.mpr ⟨b, Subtype.ext hb⟩
    constructor
    intro a b
    induction a using Submodule.Quotient.induction_on with
    | _ a =>
    induction b using Submodule.Quotient.induction_on with
    | _ b =>
    rw [Submodule.Quotient.eq, htop]
    exact Submodule.mem_top

  have hθK : θ ∉ Set.range (algebraMap K L) := by
    rintro ⟨k, hk⟩
    obtain ⟨_, -, hτ⟩ := wcLlsKP_ed_chart_special_dvr Ω W A 𝔭 t h f₀ hm𝔭 hh
      (congrArg (Ideal.map (algebraMap A (Localization.Away h))) h𝔭eq) hfC hfX hfet
    have hkpow : k ^ ℓ = algebraMap A K ((t - algebraMap ↥W A c) * a) := by
      apply (algebraMap K L).injective
      rw [map_pow, hk, hθ, IsScalarTower.algebraMap_apply A K L]
    have hkint : IsIntegral A k :=
      ⟨Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a),
        Polynomial.monic_X_pow_sub_C _ hℓ.ne_zero, by simp [hkpow]⟩
    obtain ⟨a', ha'⟩ := IsIntegrallyClosed.isIntegral_iff.mp hkint
    have ha'pow : a' ^ ℓ = (t - algebraMap ↥W A c) * a := by
      apply IsFractionRing.injective A K
      rw [map_pow, ha', hkpow]
    let I : Ideal (Localization.AtPrime 𝔭) :=
      ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
        (algebraMap A (Localization.AtPrime 𝔭))
    let π : A →+* (Localization.AtPrime 𝔭 ⧸ I) :=
      (Ideal.Quotient.mk I).comp (algebraMap A (Localization.AtPrime 𝔭))
    have hπc : π (algebraMap ↥W A c) = 0 := by
      show Ideal.Quotient.mk I _ = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hc)
    have hπa : IsUnit (π a) :=
      ((IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime 𝔭) 𝔭 a).mpr ha).map
        (Ideal.Quotient.mk I)
    have hrel : π a' ^ ℓ = π t * π a := by
      rw [← map_pow, ha'pow, map_mul, map_sub, hπc, sub_zero]
    have hτ' : Irreducible (π t) := hτ
    have hirr : Irreducible (π a' ^ ℓ) := by
      rw [hrel]; exact (irreducible_mul_isUnit hπa).mpr hτ'
    obtain ⟨m, hm⟩ : ∃ m, ℓ = m + 2 := ⟨ℓ - 2, by have := hℓ.two_le; omega⟩
    have hxu : IsUnit (π a') := by
      have h2 := hirr
      rw [hm, pow_succ'] at h2
      rcases h2.isUnit_or_isUnit rfl with h3 | h3
      · exact h3
      · exact (isUnit_pow_iff (Nat.succ_ne_zero m)).mp h3
    exact hirr.not_isUnit (hxu.pow ℓ)

  have hθint : IsIntegral A θ :=
    ⟨Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a),
      Polynomial.monic_X_pow_sub_C _ hℓ.ne_zero, by simp [hθ]⟩
  let θ' : ↥(integralClosure A L) := ⟨θ, hθint⟩
  have hθ'pow : θ' ^ ℓ =
      algebraMap A ↥(integralClosure A L) ((t - algebraMap ↥W A c) * a) :=
    Subtype.ext (by show θ ^ ℓ = algebraMap A L _; exact hθ)
  have hev : Polynomial.eval₂ (algebraMap A ↥(integralClosure A L)) θ'
      (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a)) = 0 := by
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hθ'pow, sub_self]
  let κ : AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a)) →+*
      ↥(integralClosure A L) := AdjoinRoot.lift (algebraMap A ↥(integralClosure A L)) θ' hev
  have hκroot : κ (AdjoinRoot.root
      (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a))) = θ' :=
    AdjoinRoot.lift_root hev
  have hκof : ∀ x : A, κ (AdjoinRoot.of
      (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a)) x) =
      algebraMap A ↥(integralClosure A L) x := fun x => AdjoinRoot.lift_of hev

  obtain ⟨h', hh'𝔭, haU, φ, hφC, hφX, hφet⟩ :=
    wcLlsKP_ed_recoordinate Ω W A 𝔭 t h a c f₀ hm𝔭 ht hh ha hc hfC hfX hfet
  obtain ⟨fB, hfBC, hfBX, hfBet⟩ := wcLlsKP_ed_kummer_basechange_etale ↥W A (algebraMap ↥W A) h'
    ((t - algebraMap ↥W A c) * a) ℓ φ hφC hφX hφet
  obtain ⟨hPmax, hsP, hmP, hPeq⟩ :=
    wcLlsKP_ed_kummer_point Ω W A 𝔭 t h' a c ℓ hmax h𝔭eq hc hh'𝔭 haU hℓ.pos
  haveI := hPmax.isPrime
  have hfBC' : fB.comp Polynomial.C =
      (algebraMap (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a)))
        (Localization.Away (AdjoinRoot.of
          (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a)) h'))).comp
      (algebraMap ↥W
        (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a)))) := by
    rw [hfBC, AdjoinRoot.algebraMap_eq']

  obtain ⟨_, hDVR, -⟩ := wcLlsKP_ed_chart_special_dvr Ω W
    (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a)))
    (Ideal.span {AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a))} ⊔
      𝔭.map (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a))))
    (AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a)))
    (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a)) h')
    fB hmP hsP hPeq hfBC' hfBX hfBet

  obtain ⟨hdom, hnorm⟩ := wcLlsKP_ed_etale_point_normal Ω W
    (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a)))
    (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a)) h')
    (Ideal.span {AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a))} ⊔
      𝔭.map (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a))))
    fB hsP hfBet

  obtain ⟨hjinj, hfrac⟩ := wcLlsKP_ed_kummer_order_frac A K L ℓ hℓ hfr θ
    ((t - algebraMap ↥W A c) * a) hθK hθ ((algebraMap ↥(integralClosure A L) L).comp κ)
    (by rw [RingHom.comp_apply, hκroot]; rfl)
    (RingHom.ext fun x => by rw [RingHom.comp_apply, RingHom.comp_apply, hκof]; rfl)
  have hκinj : Function.Injective κ := fun r r' hrr =>
    hjinj (by rw [RingHom.comp_apply, RingHom.comp_apply, hrr])

  have hyP : y.comap κ =
      (Ideal.span {AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a))} ⊔
        𝔭.map (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a)))) := by
    symm
    apply hPmax.eq_of_le (Ideal.comap_ne_top κ hy.ne_top)
    apply sup_le
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      show κ (AdjoinRoot.root _) ∈ y
      rw [hκroot]
      apply hy.mem_of_pow_mem ℓ
      rw [hθ'pow]
      have h1 : (t - algebraMap ↥W A c) * a ∈
          y.comap (algebraMap A ↥(integralClosure A L)) := by rw [hyc]; exact hg𝔭
      exact h1
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      show κ (AdjoinRoot.of _ x) ∈ y
      rw [hκof]
      have h1 : x ∈ y.comap (algebraMap A ↥(integralClosure A L)) := by rw [hyc]; exact hx
      exact h1

  obtain ⟨eFS⟩ := wcLlsKP_ed_fs_transport Ω W A L
    (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a))) κ
    (Ideal.span {AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a))} ⊔
      𝔭.map (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C ((t - algebraMap ↥W A c) * a))))
    y hκinj (fun x => ⟨_, hκof x⟩)
    (fun w => by rw [AdjoinRoot.algebraMap_eq', RingHom.comp_apply, hκof])
    hfrac hdom hnorm hyP

  haveI : IsDomain (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) :=
    MulEquiv.isDomain _ eFS.toMulEquiv
  haveI : IsIntegrallyClosed (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) :=
    IsIntegrallyClosed.of_equiv eFS.symm
  exact s11 _

theorem wcLlsKP_wild_no_branch : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y →
    wcLlsBR W A K L 𝔭 (.disc t) → Module.finrank K L = ℓ →
    ∀ (θ : L) (f : A), θ ∉ Set.range (algebraMap K L) → θ ^ ℓ = algebraMap A L f →
    ∀ Q : Ideal ↥(integralClosure A L), wcLlsGenPt W A L 𝔭 Q → ¬ wcLlsRam A K L Q :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hSolv _hUniq hBR hfr
    θ f hθK hθf Q hQ hRam
  classical
  haveI h𝔭p : 𝔭.IsPrime := hPD.2.2.2.1.isPrime
  have hℓpos : 0 < ℓ := hℓ.pos
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero
  have hinj : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)

  haveI hQp : Q.IsPrime := hQ.1
  have hqp : (Q.comap (algebraMap A ↥(integralClosure A L))).IsPrime := Ideal.IsPrime.comap _
  have hq𝔭 : Q.comap (algebraMap A ↥(integralClosure A L)) ≤ 𝔭 := hQ.2.1
  have hqW : ∀ w : ↥W, w ≠ 0 →
      algebraMap ↥W A w ∉ Q.comap (algebraMap A ↥(integralClosure A L)) := hQ.2.2
  obtain ⟨σ, hσ1, hσQ⟩ := hRam

  have hKU : ∀ (φ : L) (g : A), φ ∉ Set.range (algebraMap K L) → φ ^ ℓ = algebraMap A L g →
      g ∉ Q.comap (algebraMap A ↥(integralClosure A L)) → False := by
    intro φ g hφK hφg hgq

    have hσφ : σ φ ≠ φ := by
      intro hfix
      let H : Subgroup (L ≃ₐ[K] L) := MulAction.stabilizer (L ≃ₐ[K] L) φ
      have hσH : σ ∈ H := hfix
      have hcard : Nat.card (L ≃ₐ[K] L) = ℓ := by
        rw [← hfr]; exact IsGalois.card_aut_eq_finrank K L
      haveI : Fact (Nat.card (L ≃ₐ[K] L)).Prime := ⟨hcard ▸ hℓ⟩
      have hH : H = ⊤ := by
        rcases Subgroup.eq_bot_or_eq_top_of_prime_card H with h | h
        · exfalso
          apply hσ1
          have : σ ∈ (⊥ : Subgroup (L ≃ₐ[K] L)) := h ▸ hσH
          exact (Subgroup.mem_bot.mp this)
        · exact h
      apply hφK
      have hmem : φ ∈ IntermediateField.fixedField (⊤ : Subgroup (L ≃ₐ[K] L)) := by
        refine (IntermediateField.mem_fixedField_iff _ _).mpr (fun g _ => ?_)
        have hg : g ∈ H := hH ▸ Subgroup.mem_top g
        exact hg
      rw [IsGalois.fixedField_top] at hmem
      exact IntermediateField.mem_bot.mp hmem
    have hφ0 : φ ≠ 0 := by
      rintro rfl
      exact hφK ⟨0, map_zero _⟩
    have hσg : σ (algebraMap A L g) = algebraMap A L g := by
      rw [IsScalarTower.algebraMap_apply A K L, AlgEquiv.commutes]
    obtain ⟨ζ, hζdef⟩ : ∃ ζ : L, ζ = σ φ / φ := ⟨_, rfl⟩
    have hσφ' : σ φ = ζ * φ := by rw [hζdef, div_mul_cancel₀ _ hφ0]
    have hζℓ : ζ ^ ℓ = 1 := by
      have h1 : (σ φ) ^ ℓ = φ ^ ℓ := by rw [← map_pow, hφg, hσg]
      rw [hζdef, div_pow, h1, div_self (pow_ne_zero _ hφ0)]
    have hζ1 : ζ ≠ 1 := by
      intro h; apply hσφ; rw [hσφ', h, one_mul]
    have hζint : IsIntegral A ζ := IsIntegral.of_pow hℓpos (by rw [hζℓ]; exact isIntegral_one)
    have hφint : IsIntegral A φ :=
      IsIntegral.of_pow hℓpos (by rw [hφg]; exact isIntegral_algebraMap)
    let ζt : ↥(integralClosure A L) := ⟨ζ, (mem_integralClosure_iff A L).mpr hζint⟩
    let φt : ↥(integralClosure A L) := ⟨φ, (mem_integralClosure_iff A L).mpr hφint⟩
    have hζtℓ : ζt ^ ℓ = 1 := Subtype.ext (by show ζ ^ ℓ = 1; exact hζℓ)
    have hζt1 : ζt ≠ 1 := by
      intro h
      apply hζ1
      have h2 := congrArg Subtype.val h
      exact h2
    have hS : ∑ i ∈ Finset.range ℓ, ζt ^ i = 0 := by
      have h := geom_sum_mul ζt ℓ
      rw [hζtℓ, sub_self] at h
      exact (mul_eq_zero.mp h).resolve_right (sub_ne_zero.mpr hζt1)
    have hT : (ℓ : ↥(integralClosure A L)) =
        (1 - ζt) * ∑ i ∈ Finset.range ℓ, ∑ j ∈ Finset.range i, ζt ^ j := by
      rw [Finset.mul_sum]
      simp_rw [mul_neg_geom_sum]
      rw [Finset.sum_sub_distrib, hS, sub_zero]
      simp

    obtain ⟨q₁, hq₁Q, hq₁⟩ := hσQ φt
    have hq₁' : q₁ = (ζt - 1) * φt := Subtype.ext (by
      rw [hq₁]
      show σ φ - φ = (ζ - 1) * φ
      rw [hσφ']; ring)
    have hmem : (ℓ : ↥(integralClosure A L)) * φt ∈ Q := by
      have e : (ℓ : ↥(integralClosure A L)) * φt =
          -(∑ i ∈ Finset.range ℓ, ∑ j ∈ Finset.range i, ζt ^ j) * q₁ := by
        rw [hq₁', hT]; ring
      rw [e]
      exact Q.mul_mem_left _ hq₁Q
    rcases hQp.mem_or_mem hmem with h | h
    ·
      have hℓΩ : (ℓ : Ω) ≠ 0 := by
        intro h0
        have hdvd : ringChar Ω ∣ ℓ := ringChar.dvd h0
        rcases hℓ.eq_one_or_self_of_dvd _ hdvd with h1 | h1
        · exact CharP.ringChar_ne_one h1
        · exact hΩ h1
      have hℓW : (ℓ : ↥W) ≠ 0 := by
        intro h0
        apply hℓΩ
        have := congrArg (fun x : ↥W => (x : Ω)) h0
        simpa using this
      apply hqW _ hℓW
      rw [Ideal.mem_comap, map_natCast, map_natCast]
      exact h
    · apply hgq
      have h2 : φt ^ ℓ ∈ Q := Q.pow_mem_of_mem h ℓ hℓpos
      have h3 : φt ^ ℓ = algebraMap A ↥(integralClosure A L) g :=
        Subtype.ext (by show φ ^ ℓ = algebraMap A L g; exact hφg)
      rw [Ideal.mem_comap, ← h3]
      exact h2

  have hf0 : f ≠ 0 := by
    rintro rfl
    rw [map_zero] at hθf
    have : θ = 0 := pow_eq_zero_iff hℓ0 |>.mp hθf
    exact hθK ⟨0, by rw [this, map_zero]⟩

  obtain ⟨r, c, n, d, a, s, hcinj, hcm, hd0, ha𝔭, hs𝔭, hsf⟩ :=
    wcpa_dj_llsm_kpd_disc_factorization Ω W hW hWt A 𝔭 t hPD f hf0

  have hTT : ∀ q : Ideal A, (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ q) → ∀ i j,
      t - algebraMap ↥W A (c i) ∈ q → t - algebraMap ↥W A (c j) ∈ q → i = j := by
    intro q hq i j hi hj
    by_contra hne
    have hc : c j - c i ≠ 0 := sub_ne_zero.mpr (fun h => hne (hcinj h).symm)
    apply hq _ hc
    have h1 := q.sub_mem hi hj
    rw [map_sub]
    convert h1 using 1
    ring

  have hram : ∀ i, ¬ ℓ ∣ n i → ∃ Q, wcLlsGenPt W A L 𝔭 Q ∧
      t - algebraMap ↥W A (c i) ∈ Q.comap (algebraMap A ↥(integralClosure A L)) ∧
      wcLlsRam A K L Q := by
    intro i hi
    refine wcpa_dj_llsm_kpd_ramified_section Ω W hW hWt ℓ hℓ A K L 𝔭 t hPD hfr θ f s
      (algebraMap ↥W A d * a * ∏ j ∈ Finset.univ.erase i, (t - algebraMap ↥W A (c j)) ^ (n j))
      (c i) (n i) hθf (hcm i) hi ?_ ?_
    · rw [hsf, ← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ i)]
      ring
    · intro q hq hq𝔭' hqW' hTi
      refine ⟨?_, fun h => hs𝔭 (hq𝔭' h)⟩
      intro hmem
      rcases hq.mem_or_mem hmem with h1 | h1
      · rcases hq.mem_or_mem h1 with h2 | h2
        · exact hqW' d hd0 h2
        · exact ha𝔭 (hq𝔭' h2)
      · obtain ⟨j, hj, hjq⟩ := (hq.prod_mem_iff).mp h1
        have hj' := hq.mem_of_pow_mem _ hjq
        exact (Finset.mem_erase.mp hj).1 (hTT q hqW' j i hj' hTi)
  have hBR' : ∀ c c' : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → c' ∈ IsLocalRing.maximalIdeal ↥W →
      (∃ Q, wcLlsGenPt W A L 𝔭 Q ∧
        t - algebraMap ↥W A c ∈ Q.comap (algebraMap A ↥(integralClosure A L)) ∧
        wcLlsRam A K L Q) →
      (∃ Q, wcLlsGenPt W A L 𝔭 Q ∧
        t - algebraMap ↥W A c' ∈ Q.comap (algebraMap A ↥(integralClosure A L)) ∧
        wcLlsRam A K L Q) → c = c' := hBR

  obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq ((d : Ω)) hℓpos
  have hdΩ : (d : Ω) ≠ 0 := fun h => hd0 (Subtype.ext h)
  have hz0 : z ≠ 0 := by
    rintro rfl
    exact hdΩ (by rw [← hz, zero_pow hℓpos.ne'])
  have hzW : z ∈ W := by
    rcases W.mem_or_inv_mem z with h | h
    · exact h
    · have e : z = z ^ ℓ * z⁻¹ ^ (ℓ - 1) := by
        obtain ⟨m, hm⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, by omega⟩
        rw [hm, Nat.add_sub_cancel, pow_succ, mul_comm (z ^ m) z, mul_assoc, ← mul_pow,
          mul_inv_cancel₀ hz0, one_pow, mul_one]
      rw [e, hz]
      exact mul_mem d.2 (pow_mem h _)
  obtain ⟨δ₀, hδ⟩ : ∃ δ₀ : ↥W, δ₀ ^ ℓ = d :=
    ⟨⟨z, hzW⟩, Subtype.ext (by rw [SubmonoidClass.coe_pow]; exact hz)⟩

  obtain ⟨H, hH⟩ : ∃ H : A,
      H = algebraMap ↥W A δ₀ * ∏ i, (t - algebraMap ↥W A (c i)) ^ (n i / ℓ) := ⟨_, rfl⟩
  obtain ⟨R, hR⟩ : ∃ R : A, R = ∏ i, (t - algebraMap ↥W A (c i)) ^ (n i % ℓ) := ⟨_, rfl⟩
  have hsplit : s * f = H ^ ℓ * a * R := by
    rw [hsf, hH, hR, ← hδ, map_pow]
    have e : ∏ i, (t - algebraMap ↥W A (c i)) ^ (n i) =
        (∏ i, (t - algebraMap ↥W A (c i)) ^ (n i / ℓ)) ^ ℓ *
          ∏ i, (t - algebraMap ↥W A (c i)) ^ (n i % ℓ) := by
      rw [← Finset.prod_pow, ← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [← pow_mul, ← pow_add, mul_comm (n i / ℓ) ℓ, Nat.div_add_mod]
    rw [e, mul_pow]
    ring
  have hsA : s ≠ 0 := by
    intro h
    apply hs𝔭
    rw [h]
    exact 𝔭.zero_mem
  have hsf0 : s * f ≠ 0 := mul_ne_zero hsA hf0
  have hHA : H ≠ 0 := by
    intro h
    apply hsf0
    rw [hsplit, h, zero_pow hℓpos.ne']
    ring
  have hRA : R ≠ 0 := by
    intro h
    apply hsf0
    rw [hsplit, h]
    ring
  have hH0 : algebraMap A L H ≠ 0 := (map_ne_zero_iff _ hinj).mpr hHA
  have hs0 : algebraMap A L s ≠ 0 := (map_ne_zero_iff _ hinj).mpr hsA
  have hθ'pow : (algebraMap A L s * θ / algebraMap A L H) ^ ℓ =
      algebraMap A L (s ^ (ℓ - 1) * a * R) := by
    rw [div_pow, div_eq_iff (pow_ne_zero _ hH0), mul_pow, hθf]
    have e0 : s ^ ℓ * f = s ^ (ℓ - 1) * (s * f) := by
      conv_lhs => rw [← Nat.sub_add_cancel hℓ.one_le]
      ring
    rw [← map_pow, ← map_mul, e0, hsplit]
    simp only [map_mul, map_pow]
    ring
  have hθ'K : algebraMap A L s * θ / algebraMap A L H ∉ Set.range (algebraMap K L) := by
    rintro ⟨k, hk⟩
    apply hθK
    refine ⟨algebraMap A K H * k / algebraMap A K s, ?_⟩
    rw [map_div₀, map_mul, ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply, hk,
      div_eq_iff hs0, mul_div_assoc', div_eq_iff hH0]
    ring
  have hunit : ∀ m : ℕ, (s ^ (ℓ - 1) * a) ^ m ∉ 𝔭 := by
    intro m hm
    rcases h𝔭p.mem_or_mem (h𝔭p.mem_of_pow_mem _ hm) with h | h
    · exact hs𝔭 (h𝔭p.mem_of_pow_mem _ h)
    · exact ha𝔭 h

  obtain ⟨i₀, hTq, hi₀⟩ : ∃ i₀, t - algebraMap ↥W A (c i₀) ∈
      Q.comap (algebraMap A ↥(integralClosure A L)) ∧ ¬ ℓ ∣ n i₀ := by
    by_contra hnone
    push_neg at hnone
    have hRq : R ∉ Q.comap (algebraMap A ↥(integralClosure A L)) := by
      intro hRmem
      rw [hR] at hRmem
      obtain ⟨i, -, hiq⟩ := (hqp.prod_mem_iff).mp hRmem
      by_cases hz : n i % ℓ = 0
      · rw [hz, pow_zero] at hiq
        exact hqp.ne_top ((Ideal.eq_top_iff_one _).mpr hiq)
      · have hTi := hqp.mem_of_pow_mem _ hiq
        exact hz (Nat.mod_eq_zero_of_dvd (hnone i hTi))
    have hgq : s ^ (ℓ - 1) * a * R ∉ Q.comap (algebraMap A ↥(integralClosure A L)) := by
      intro hmem
      rcases hqp.mem_or_mem hmem with h1 | h1
      · rcases hqp.mem_or_mem h1 with h2 | h2
        · exact hs𝔭 (hq𝔭 (hqp.mem_of_pow_mem _ h2))
        · exact ha𝔭 (hq𝔭 h2)
      · exact hRq h1
    exact hKU _ _ hθ'K hθ'pow hgq

  have huniq : ∀ j, ¬ ℓ ∣ n j → j = i₀ := fun j hj =>
    hcinj (hBR' (c j) (c i₀) (hcm j) (hcm i₀) (hram j hj) ⟨Q, hQ, hTq, σ, hσ1, hσQ⟩)
  obtain ⟨e, he⟩ : ∃ e : ℕ, e = n i₀ % ℓ := ⟨_, rfl⟩
  have hRe : R = (t - algebraMap ↥W A (c i₀)) ^ e := by
    rw [hR, he]
    refine Finset.prod_eq_single i₀ (fun j _ hj => ?_) (fun h => absurd (Finset.mem_univ _) h)
    have h0 : n j % ℓ = 0 := Nat.mod_eq_zero_of_dvd (by
      by_contra h
      exact hj (huniq j h))
    rw [h0, pow_zero]
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  have he0 : ((e : ℕ) : ZMod ℓ) ≠ 0 := by
    rw [Ne, ZMod.natCast_eq_zero_iff, he]
    intro hdvd
    exact hi₀ ((Nat.dvd_mod_iff dvd_rfl).mp hdvd)
  have hepos : e ≠ 0 := fun h => he0 (by rw [h, Nat.cast_zero])
  obtain ⟨α, β, hαβ⟩ : ∃ α β : ℕ, α * e = ℓ * β + 1 := by
    refine ⟨((e : ZMod ℓ)⁻¹).val, ((e : ZMod ℓ)⁻¹).val * e / ℓ, ?_⟩
    have h1 : ((((e : ZMod ℓ)⁻¹).val * e : ℕ) : ZMod ℓ) = ((1 : ℕ) : ZMod ℓ) := by
      rw [Nat.cast_mul, ZMod.natCast_zmod_val, Nat.cast_one, inv_mul_cancel₀ he0]
    rw [ZMod.natCast_eq_natCast_iff'] at h1
    rw [Nat.mod_eq_of_lt hℓ.one_lt] at h1
    conv_lhs => rw [← Nat.div_add_mod (((e : ZMod ℓ)⁻¹).val * e) ℓ, h1]
  have hT0 : algebraMap A L (t - algebraMap ↥W A (c i₀)) ≠ 0 := by
    rw [map_ne_zero_iff _ hinj]
    intro h
    apply hRA
    rw [hRe, h, zero_pow hepos]
  have hθ₂ : ((algebraMap A L s * θ / algebraMap A L H) ^ α /
      algebraMap A L (t - algebraMap ↥W A (c i₀)) ^ β) ^ ℓ =
      algebraMap A L ((t - algebraMap ↥W A (c i₀)) * (s ^ (ℓ - 1) * a) ^ α) := by
    rw [div_pow, ← pow_mul, mul_comm α ℓ, pow_mul, hθ'pow, hRe,
      div_eq_iff (pow_ne_zero _ (pow_ne_zero _ hT0))]
    simp only [map_mul, map_pow]
    rw [mul_pow, ← pow_mul _ e α, mul_comm e α, hαβ]
    ring
  have hδ0 := wcLlsKP_eisenstein_delta_zero Ω W hW hWt ℓ hℓ hΩ A K L 𝔭 t y hPD hfr
    _ ((s ^ (ℓ - 1) * a) ^ α) (c i₀) (hcm i₀) (hunit α) hθ₂ hSolv.1 hSolv.2.1
  exact hSolv.2.2.2 hSolv.1 t rfl hδ0

theorem wcLlsAS_disc_recentre : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c c' b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → c' ∈ IsLocalRing.maximalIdeal ↥W →
      b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → b ∣ c' - c →
      wcLlsDiscSep W A K L t c b → wcLlsDiscSep W A K L t c' b :=
by
  intro Ω _ W A _ _ _ K _ _ _ L _ _ instAL instST 𝔭 t hPD
  clear instST instAL

  have s4 : ∀ (A : Type u) [CommRing A] (K : Type u) [Field K]
      [Algebra A K] (L : Type u) [Field L] [Algebra K L] (R R' : Subalgebra A K) (υ : K),
      υ ∈ R' → (∀ r ∈ R, ∃ k : ℕ, υ ^ k * r ∈ R') →
      ∀ x : L, IsIntegral ↥R x → ∃ k : ℕ, IsIntegral ↥R' (algebraMap K L (υ ^ k) * x) := by
    intro A _ K _ _ L _ _ R R' υ hυ hmul x hx
    classical
    obtain ⟨p, hpm, hp⟩ := hx
    choose! kf hkf using hmul
    set n := p.natDegree with hn
    set κ := ∑ i ∈ Finset.range (n + 1), kf ((p.coeff i : R) : K) with hκ
    set q : Polynomial K := (p.map R.val.toRingHom).scaleRoots (υ ^ κ) with hq
    have hpm' : (p.map R.val.toRingHom).Monic := hpm.map _
    have hnd : (p.map R.val.toRingHom).natDegree = n := hpm.natDegree_map _
    have hqm : q.Monic := (Polynomial.monic_scaleRoots_iff _).mpr hpm'
    have hcoeff : ∀ i, q.coeff i ∈ R' := by
      intro i
      rw [hq, Polynomial.coeff_scaleRoots, hnd, Polynomial.coeff_map]
      rcases lt_trichotomy i n with hi | hi | hi
      · have h1 : kf ((p.coeff i : R) : K) ≤ κ :=
          Finset.single_le_sum (f := fun j => kf ((p.coeff j : R) : K))
            (fun _ _ => Nat.zero_le _) (Finset.mem_range.mpr (by omega))
        have h2 : κ ≤ κ * (n - i) := Nat.le_mul_of_pos_right _ (by omega)
        have e : (υ ^ κ) ^ (n - i) = υ ^ (κ * (n - i) - kf ((p.coeff i : R) : K)) *
            υ ^ kf ((p.coeff i : R) : K) := by
          rw [← pow_mul, ← pow_add, Nat.sub_add_cancel (h1.trans h2)]
        show ((p.coeff i : R) : K) * (υ ^ κ) ^ (n - i) ∈ R'
        rw [e, mul_comm, mul_assoc]
        exact mul_mem (pow_mem hυ _) (hkf _ (p.coeff i).2)
      · subst hi
        show ((p.coeff p.natDegree : R) : K) * (υ ^ κ) ^ (p.natDegree - p.natDegree) ∈ R'
        rw [hpm.coeff_natDegree, Nat.sub_self, pow_zero, mul_one]
        exact one_mem _
      · show ((p.coeff i : R) : K) * (υ ^ κ) ^ (n - i) ∈ R'
        rw [Polynomial.coeff_eq_zero_of_natDegree_lt hi]
        simp
    have hqlift : q ∈ Polynomial.lifts R'.val.toRingHom := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      exact ⟨⟨q.coeff i, hcoeff i⟩, rfl⟩
    obtain ⟨q', hq'map, _, hq'm⟩ := Polynomial.lifts_and_degree_eq_and_monic hqlift hqm
    refine ⟨κ, q', hq'm, ?_⟩
    have halg : algebraMap ↥R' L = (algebraMap K L).comp R'.val.toRingHom := rfl
    rw [halg, ← Polynomial.eval₂_map, hq'map, hq]
    apply Polynomial.scaleRoots_eval₂_eq_zero
    rw [Polynomial.eval₂_map]
    exact hp

  have s5 : ∀ (C C' L : Type u) [CommRing C] [CommRing C'] [Field L]
      (i : C →+* L) (i' : C' →+* L), Function.Injective i' → ∀ υ' : C',
      (∀ x : C, ∃ (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x) →
      ∀ Q' : Ideal C', Q'.IsPrime → υ' ∉ Q' →
      ∃ Q : Ideal C, Q.IsPrime ∧
        ∀ (x : C) (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x → (x ∈ Q ↔ y ∈ Q') := by
    intro C C' L _ _ _ i i' hi' υ' H Q' hQ' hυ'
    have hpow : ∀ k : ℕ, υ' ^ k ∉ Q' := fun k h => hυ' (hQ'.mem_of_pow_mem k h)
    have indep : ∀ (x : C) (k₁ k₂ : ℕ) (y₁ y₂ : C'), i' y₁ = i' υ' ^ k₁ * i x →
        i' y₂ = i' υ' ^ k₂ * i x → y₁ ∈ Q' → y₂ ∈ Q' := by
      intro x k₁ k₂ y₁ y₂ h1 h2 hy1
      have e : υ' ^ k₁ * y₂ = υ' ^ k₂ * y₁ :=
        hi' (by rw [map_mul, map_mul, map_pow, map_pow, h1, h2]; ring)
      have : υ' ^ k₁ * y₂ ∈ Q' := by rw [e]; exact Q'.mul_mem_left _ hy1
      exact (hQ'.mem_or_mem this).resolve_left (hpow k₁)
    let Q : Ideal C :=
      { carrier := {x | ∃ (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x ∧ y ∈ Q'}
        add_mem' := by
          rintro a b ⟨k₁, y₁, h1, hy1⟩ ⟨k₂, y₂, h2, hy2⟩
          refine ⟨k₁ + k₂, υ' ^ k₂ * y₁ + υ' ^ k₁ * y₂, ?_,
            add_mem (Q'.mul_mem_left _ hy1) (Q'.mul_mem_left _ hy2)⟩
          rw [map_add, map_mul, map_mul, map_pow, map_pow, h1, h2, map_add]; ring
        zero_mem' := ⟨0, 0, by simp, Q'.zero_mem⟩
        smul_mem' := by
          rintro a b ⟨k₁, y₁, h1, hy1⟩
          obtain ⟨j, ya, ha⟩ := H a
          refine ⟨j + k₁, ya * y₁, ?_, Q'.mul_mem_left _ hy1⟩
          rw [smul_eq_mul, map_mul, map_mul, ha, h1]; ring }
    have memQ : ∀ x, x ∈ Q ↔ ∃ (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x ∧ y ∈ Q' :=
      fun x => Iff.rfl
    have HQ : ∀ (x : C) (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x → (x ∈ Q ↔ y ∈ Q') := by
      intro x k y hy
      rw [memQ]
      constructor
      · rintro ⟨k₂, y₂, h2, hy2⟩
        exact indep x k₂ k y₂ y h2 hy hy2
      · intro hyQ
        exact ⟨k, y, hy, hyQ⟩
    refine ⟨Q, ⟨?_, ?_⟩, HQ⟩
    · rw [Ne, Ideal.eq_top_iff_one, memQ]
      rintro ⟨k, y, h, hy⟩
      have : y = υ' ^ k := hi' (by rw [h, map_one, mul_one, map_pow])
      exact hpow k (this ▸ hy)
    · intro a b hab
      obtain ⟨k₁, y₁, h1⟩ := H a
      obtain ⟨k₂, y₂, h2⟩ := H b
      have h12 : i' (y₁ * y₂) = i' υ' ^ (k₁ + k₂) * i (a * b) := by
        rw [map_mul, map_mul, h1, h2]; ring
      have := (HQ _ _ _ h12).mp hab
      rcases hQ'.mem_or_mem this with h | h
      · exact Or.inl ((HQ _ _ _ h1).mpr h)
      · exact Or.inr ((HQ _ _ _ h2).mpr h)

  have s6 : ∀ (C C' L : Type u) [CommRing C] [IsDomain C] [CommRing C']
      [IsDomain C'] [Field L] (i : C →+* L) (i' : C' →+* L), Function.Injective i →
      Function.Injective i' → ∀ (υ : C) (υ' : C'), i υ * i' υ' = 1 →
      (∀ x : C, ∃ (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x) →
      (∀ x' : C', ∃ (k : ℕ) (y : C), i y = i υ ^ k * i' x') →
      ∀ (Q : Ideal C) [Q.IsPrime] (Q' : Ideal C') [Q'.IsPrime], υ' ∉ Q' →
      (∀ (x : C) (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x → (x ∈ Q ↔ y ∈ Q')) →
      ∃ e : Localization.AtPrime Q ≃+* Localization.AtPrime Q',
        ∀ (x : C) (y : C'), i x = i' y →
          e (algebraMap C (Localization.AtPrime Q) x) =
            algebraMap C' (Localization.AtPrime Q') y := by
    intro C C' L _ _ _ _ _ i i' hi hi' υ υ' hυυ' H H' Q hQ Q' hQ' hυ' HQ
    have HQr : ∀ (x' : C') (k : ℕ) (y : C), i y = i υ ^ k * i' x' → (y ∈ Q ↔ x' ∈ Q') := by
      intro x' k y hy
      apply HQ y k x'
      rw [hy, ← mul_assoc, ← mul_pow, mul_comm (i' υ'), hυυ', one_pow, one_mul]
    have hυ : υ ∉ Q := by
      intro h
      have h1 : i' 1 = i' υ' ^ 1 * i υ := by rw [pow_one, mul_comm, hυυ', map_one]
      exact hQ'.ne_top ((Ideal.eq_top_iff_one _).mpr ((HQ υ 1 1 h1).mp h))
    have hne : ∀ d : C, d ∉ Q → i d ≠ 0 := by
      intro d hd h0
      apply hd
      have : d = 0 := hi (by rw [h0, map_zero])
      rw [this]; exact Q.zero_mem
    have hne' : ∀ d : C', d ∉ Q' → i' d ≠ 0 := by
      intro d hd h0
      apply hd
      have : d = 0 := hi' (by rw [h0, map_zero])
      rw [this]; exact Q'.zero_mem
    have hu : ∀ d : Q.primeCompl, IsUnit (i d) := fun d => isUnit_iff_ne_zero.mpr (hne d d.2)
    have hu' : ∀ d : Q'.primeCompl, IsUnit (i' d) :=
      fun d => isUnit_iff_ne_zero.mpr (hne' d d.2)
    obtain ⟨ι, hιa, hιm, hinj⟩ : ∃ ι : Localization.AtPrime Q →+* L,
        (∀ x, ι (algebraMap C _ x) = i x) ∧
        (∀ x (d : Q.primeCompl), i x = i d * ι (IsLocalization.mk' _ x d)) ∧
        Function.Injective ι := by
      refine ⟨IsLocalization.lift (M := Q.primeCompl) (S := Localization.AtPrime Q) hu,
        IsLocalization.lift_eq hu, fun x d => (IsLocalization.lift_mk'_spec hu x _ d).mp rfl, ?_⟩
      rw [IsLocalization.lift_injective_iff]
      intro x y
      constructor
      · intro h
        exact congrArg i (IsLocalization.injective (Localization.AtPrime Q)
          (Ideal.primeCompl_le_nonZeroDivisors Q) h)
      · intro h; rw [hi h]
    obtain ⟨ι', hιa', hιm', hinj'⟩ : ∃ ι : Localization.AtPrime Q' →+* L,
        (∀ x, ι (algebraMap C' _ x) = i' x) ∧
        (∀ x (d : Q'.primeCompl), i' x = i' d * ι (IsLocalization.mk' _ x d)) ∧
        Function.Injective ι := by
      refine ⟨IsLocalization.lift (M := Q'.primeCompl) (S := Localization.AtPrime Q') hu',
        IsLocalization.lift_eq hu', fun x d => (IsLocalization.lift_mk'_spec hu' x _ d).mp rfl, ?_⟩
      rw [IsLocalization.lift_injective_iff]
      intro x y
      constructor
      · intro h
        exact congrArg i' (IsLocalization.injective (Localization.AtPrime Q')
          (Ideal.primeCompl_le_nonZeroDivisors Q') h)
      · intro h; rw [hi' h]
    have hrange : ι.range = ι'.range := by
      apply le_antisymm
      · rintro _ ⟨z, rfl⟩
        obtain ⟨⟨x, d⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl z
        obtain ⟨k₁, y₁, h1⟩ := H x
        obtain ⟨k₂, y₂, h2⟩ := H d
        have hy₂ : y₂ ∉ Q' := fun h => d.2 ((HQ _ _ _ h2).mpr h)
        have hD : y₂ * υ' ^ k₁ ∈ Q'.primeCompl := by
          intro h
          rcases hQ'.mem_or_mem h with h | h
          · exact hy₂ h
          · exact hυ' (hQ'.mem_of_pow_mem _ h)
        refine ⟨IsLocalization.mk' (Localization.AtPrime Q') (y₁ * υ' ^ k₂) ⟨_, hD⟩, ?_⟩
        apply mul_left_cancel₀ (hne' _ hD)
        have hv := hιm x d
        have hv' := hιm' (y₁ * υ' ^ k₂) ⟨_, hD⟩
        simp only at hv'
        rw [← hv']
        have hd0 : i d ≠ 0 := hne d d.2
        apply mul_left_cancel₀ hd0
        rw [map_mul, map_mul, map_pow, map_pow, h1, h2]
        calc i d * (i' υ' ^ k₁ * i x * i' υ' ^ k₂)
            = i' υ' ^ k₁ * i' υ' ^ k₂ * i d * i x := by ring
          _ = i' υ' ^ k₁ * i' υ' ^ k₂ * i d * (i d * ι (IsLocalization.mk' _ x d)) := by
              rw [← hv]
          _ = i d * (i' υ' ^ k₂ * i d * i' υ' ^ k₁ * ι (IsLocalization.mk' _ x d)) := by ring
      · rintro _ ⟨z, rfl⟩
        obtain ⟨⟨x, d⟩, rfl⟩ := IsLocalization.mk'_surjective Q'.primeCompl z
        obtain ⟨k₁, y₁, h1⟩ := H' x
        obtain ⟨k₂, y₂, h2⟩ := H' d
        have hy₂ : y₂ ∉ Q := fun h => d.2 ((HQr _ _ _ h2).mp h)
        have hD : y₂ * υ ^ k₁ ∈ Q.primeCompl := by
          intro h
          rcases hQ.mem_or_mem h with h | h
          · exact hy₂ h
          · exact hυ (hQ.mem_of_pow_mem _ h)
        refine ⟨IsLocalization.mk' (Localization.AtPrime Q) (y₁ * υ ^ k₂) ⟨_, hD⟩, ?_⟩
        apply mul_left_cancel₀ (hne _ hD)
        have hv := hιm' x d
        have hv' := hιm (y₁ * υ ^ k₂) ⟨_, hD⟩
        simp only at hv'
        rw [← hv']
        have hd0 : i' d ≠ 0 := hne' d d.2
        apply mul_left_cancel₀ hd0
        rw [map_mul, map_mul, map_pow, map_pow, h1, h2]
        calc i' d * (i υ ^ k₁ * i' x * i υ ^ k₂)
            = i υ ^ k₁ * i υ ^ k₂ * i' d * i' x := by ring
          _ = i υ ^ k₁ * i υ ^ k₂ * i' d * (i' d * ι' (IsLocalization.mk' _ x d)) := by
              rw [← hv]
          _ = i' d * (i υ ^ k₂ * i' d * i υ ^ k₁ * ι' (IsLocalization.mk' _ x d)) := by ring
    let e1 : Localization.AtPrime Q ≃+* ι.range :=
      RingEquiv.ofBijective ι.rangeRestrict
        ⟨fun a b h => hinj (congrArg Subtype.val h), RingHom.rangeRestrict_surjective ι⟩
    let e2 : Localization.AtPrime Q' ≃+* ι'.range :=
      RingEquiv.ofBijective ι'.rangeRestrict
        ⟨fun a b h => hinj' (congrArg Subtype.val h), RingHom.rangeRestrict_surjective ι'⟩
    let e : Localization.AtPrime Q ≃+* Localization.AtPrime Q' :=
      e1.trans ((RingEquiv.subringCongr hrange).trans e2.symm)
    have hιe : ∀ z, ι' (e z) = ι z := by
      intro z
      have := congrArg Subtype.val (e2.apply_symm_apply ((RingEquiv.subringCongr hrange) (e1 z)))
      exact this
    refine ⟨e, fun x y hxy => hinj' ?_⟩
    rw [hιe, hιa, hιa']
    exact hxy

  have hllfi : ∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) →
      wcpaDjLkDelta R = wcpaDjLkDelta S ∧ wcpaDjLkBranches R = wcpaDjLkBranches S := by
    intro R S _ _ e
    classical
    let eF : FractionRing R ≃+* FractionRing S := IsFractionRing.ringEquivOfRingEquiv e
    have H1 : ∀ r : R, eF (algebraMap R (FractionRing R) r) =
        algebraMap S (FractionRing S) (e r) :=
      fun r => IsFractionRing.ringEquivOfRingEquiv_algebraMap e r
    have H2 : ∀ s : S, eF.symm (algebraMap S (FractionRing S) s) =
        algebraMap R (FractionRing R) (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, H1, RingEquiv.apply_symm_apply]
    have C1 : (algebraMap S (FractionRing S)).comp (e : R →+* S) =
        (eF : FractionRing R →+* FractionRing S).comp (algebraMap R (FractionRing R)) := by
      ext r
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H1 r).symm
    have C2 : (algebraMap R (FractionRing R)).comp (e.symm : S →+* R) =
        (eF.symm : FractionRing S →+* FractionRing R).comp (algebraMap S (FractionRing S)) := by
      ext s
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H2 s).symm
    have I1 : ∀ x : FractionRing R, _root_.IsIntegral R x → _root_.IsIntegral S (eF x) :=
      fun x hx => hx.map_of_comp_eq (e : R →+* S) (eF : FractionRing R →+* FractionRing S) C1
    have I2 : ∀ y : FractionRing S, _root_.IsIntegral S y → _root_.IsIntegral R (eF.symm y) :=
      fun y hy => hy.map_of_comp_eq (e.symm : S →+* R)
        (eF.symm : FractionRing S →+* FractionRing R) C2
    let eI : ↥(integralClosure R (FractionRing R)) ≃+* ↥(integralClosure S (FractionRing S)) :=
      { toFun := fun x => ⟨eF x, I1 x x.2⟩
        invFun := fun y => ⟨eF.symm y, I2 y y.2⟩
        left_inv := fun x => Subtype.ext (eF.symm_apply_apply x)
        right_inv := fun y => Subtype.ext (eF.apply_symm_apply y)
        map_mul' := fun x y => Subtype.ext (map_mul eF (x : FractionRing R) y)
        map_add' := fun x y => Subtype.ext (map_add eF (x : FractionRing R) y) }
    have heI : ∀ r : R, eI (algebraMap R _ r) = algebraMap S _ (e r) :=
      fun r => Subtype.ext (H1 r)
    have heI' : ∀ s : S, eI.symm (algebraMap S _ s) = algebraMap R _ (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, heI, RingEquiv.apply_symm_apply]
    constructor
    · letI : RingHomInvPair (e : R →+* S) (e.symm : S →+* R) := RingHomInvPair.of_ringEquiv e
      letI : RingHomInvPair (e.symm : S →+* R) (e : R →+* S) := RingHomInvPair.symm _ _
      let LeI : ↥(integralClosure R (FractionRing R)) →ₛₗ[(e : R →+* S)]
          ↥(integralClosure S (FractionRing S)) :=
        { toFun := eI
          map_add' := map_add eI
          map_smul' := fun r a => by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI]
            rfl }
      let LeI' : ↥(integralClosure S (FractionRing S)) →ₛₗ[(e.symm : S →+* R)]
          ↥(integralClosure R (FractionRing R)) :=
        { toFun := eI.symm
          map_add' := map_add eI.symm
          map_smul' := fun s b => by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI']
            rfl }
      let p := LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))
      let q := LinearMap.range (Algebra.linearMap S ↥(integralClosure S (FractionRing S)))
      have h1 : p ≤ q.comap LeI := by
        rintro _ ⟨r, rfl⟩
        exact ⟨e r, (heI r).symm⟩
      have h2 : q ≤ p.comap LeI' := by
        rintro _ ⟨s, rfl⟩
        exact ⟨e.symm s, (heI' s).symm⟩
      let Φ := p.mapQ q LeI h1
      let Φ' := q.mapQ p LeI' h2
      let Φe : (↥(integralClosure R (FractionRing R)) ⧸ p) ≃ₛₗ[(e : R →+* S)]
          (↥(integralClosure S (FractionRing S)) ⧸ q) :=
        { Φ with
          invFun := Φ'
          left_inv := fun x => by
            induction x using Submodule.Quotient.induction_on with
            | H a =>
              show Φ' (Φ (Submodule.Quotient.mk a)) = Submodule.Quotient.mk a
              rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
              exact congrArg _ (eI.symm_apply_apply a)
          right_inv := fun x => by
            induction x using Submodule.Quotient.induction_on with
            | H b =>
              show Φ (Φ' (Submodule.Quotient.mk b)) = Submodule.Quotient.mk b
              rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
              exact congrArg _ (eI.apply_symm_apply b) }
      let O := Submodule.orderIsoMapComap Φe
      unfold wcpaDjLkDelta
      rw [Module.length_eq_height, Module.length_eq_height, ← Order.height_orderIso O ⊤,
        OrderIso.map_top]
    · unfold wcpaDjLkBranches
      apply ENat.card_congr
      exact
        { toFun := fun M => ⟨M.asIdeal.comap (eI.symm : _ →+* _), by
            haveI := M.isMaximal
            exact Ideal.comap_isMaximal_of_surjective _ eI.symm.surjective⟩
          invFun := fun N => ⟨N.asIdeal.comap (eI : _ →+* _), by
            haveI := N.isMaximal
            exact Ideal.comap_isMaximal_of_surjective _ eI.surjective⟩
          left_inv := fun M => by
            ext x
            show eI.symm (eI x) ∈ M.asIdeal ↔ x ∈ M.asIdeal
            rw [RingEquiv.symm_apply_apply]
          right_inv := fun N => by
            ext x
            show eI (eI.symm x) ∈ N.asIdeal ↔ x ∈ N.asIdeal
            rw [RingEquiv.apply_symm_apply] }

  have s7 : ∀ (L : Type u) [Field L] (wL : ↥W →+* L) (R R' : Type u) [CommRing R]
      [CommRing R'] [Algebra R L] [Algebra R' L]
      (Q : Ideal ↥(integralClosure R L)) [Q.IsPrime]
      (Q' : Ideal ↥(integralClosure R' L)) [Q'.IsPrime]
      (e : Localization.AtPrime Q ≃+* Localization.AtPrime Q'),
      (∀ (x : ↥(integralClosure R L)) (y : ↥(integralClosure R' L)), (x : L) = (y : L) →
        e (algebraMap _ _ x) = algebraMap _ _ y) →
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W,
        wL w ∈ integralClosure R L ∧ wL w ∈ integralClosure R' L) →
      (wcpaDjLkBad (wcLlsFS W wL R Q) ↔ wcpaDjLkBad (wcLlsFS W wL R' Q')) := by
    intro L _ wL R R' _ _ _ _ Q _ Q' _ e he hw
    have hI : Ideal.map (e : Localization.AtPrime Q →+* Localization.AtPrime Q')
        ((Ideal.span {b : ↥(integralClosure R L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w}).map
            (algebraMap ↥(integralClosure R L) (Localization.AtPrime Q))) =
        (Ideal.span {b : ↥(integralClosure R' L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w}).map
            (algebraMap ↥(integralClosure R' L) (Localization.AtPrime Q')) := by
      rw [Ideal.map_map, Ideal.map_span, Ideal.map_span]
      congr 1
      ext z
      constructor
      · rintro ⟨b, ⟨w, hw', hb⟩, rfl⟩
        exact ⟨⟨wL w, (hw w hw').2⟩, ⟨w, hw', rfl⟩, (he b ⟨wL w, (hw w hw').2⟩ hb).symm⟩
      · rintro ⟨b', ⟨w, hw', hb'⟩, rfl⟩
        exact ⟨⟨wL w, (hw w hw').1⟩, ⟨w, hw', rfl⟩, he ⟨wL w, (hw w hw').1⟩ b' hb'.symm⟩
    have eq : wcLlsFS W wL R Q ≃+* wcLlsFS W wL R' Q' := Ideal.quotientEquiv _ _ e hI.symm
    obtain ⟨h1, h2⟩ := hllfi _ _ eq
    unfold wcpaDjLkBad
    rw [h1, h2]

  have s1 : ∀ c : ↥W, t - algebraMap ↥W A c ≠ 0 := by
    intro c h0
    obtain ⟨_, _, _, _, _, _, _, h, hh, f, hfC, hfX, hfet⟩ := hPD
    letI := f.toAlgebra
    have hflat : f.Flat := ((RingHom.etale_iff_formallyUnramified_and_smooth f).mp hfet).2.flat
    haveI : Module.Flat (Polynomial ↥W) (Localization.Away h) := hflat
    have hP : (Polynomial.X - Polynomial.C c) ∈ nonZeroDivisors (Polynomial ↥W) :=
      (Polynomial.monic_X_sub_C c).mem_nonZeroDivisors
    have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := Localization.Away h) hP
    have hfP : f (Polynomial.X - Polynomial.C c) = 0 := by
      rw [map_sub, hfX]
      have e1 : f (Polynomial.C c) = algebraMap A (Localization.Away h) (algebraMap ↥W A c) := by
        rw [← RingHom.comp_apply, hfC]; rfl
      rw [e1, ← map_sub, h0, map_zero]
    have h10 : (1 : Localization.Away h) = 0 := by
      apply hreg
      show (Polynomial.X - Polynomial.C c) • (1 : Localization.Away h) =
        (Polynomial.X - Polynomial.C c) • (0 : Localization.Away h)
      rw [smul_zero, Algebra.smul_def, RingHom.algebraMap_toAlgebra, hfP, zero_mul]
    have hh0 : h ≠ 0 := fun e => hh (e ▸ Ideal.zero_mem _)
    have hinj : Function.Injective (algebraMap A (Localization.Away h)) :=
      IsLocalization.injective _ (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
    exact one_ne_zero (hinj (by rw [map_one, map_zero]; exact h10))
  obtain ⟨_, _, _, hmax, _, _, h𝔭, _⟩ := hPD

  have s2 : ∀ (s : K) (N J : Ideal ↥(Algebra.adjoin A {s})),
      (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) ∈ N →
      𝔭 ≤ N.comap (algebraMap A ↥(Algebra.adjoin A {s})) → N ≤ J → J ≠ ⊤ → J = N := by
    intro s N J hsN hpN hNJ hJ
    refine le_antisymm ?_ hNJ
    intro x hxJ
    obtain ⟨p, hp⟩ : ∃ p : Polynomial A, Polynomial.aeval s p = (x : K) := by
      have gen : ∀ y ∈ Algebra.adjoin A {s}, ∃ p : Polynomial A, Polynomial.aeval s p = y := by
        intro y hy
        rw [Algebra.adjoin_singleton_eq_range_aeval] at hy
        obtain ⟨p, hp⟩ := hy
        exact ⟨p, hp⟩
      exact gen (x : K) x.2
    have hx : x = algebraMap A _ (p.coeff 0) +
        (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) *
        ⟨Polynomial.aeval s p.divX, Polynomial.aeval_mem_adjoin_singleton A s⟩ := by
      apply Subtype.ext
      have e := congrArg (Polynomial.aeval s) (Polynomial.X_mul_divX_add p)
      rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at e
      rw [Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_algebraMap, ← hp, ← e]
      exact add_comm _ _
    have hsy : (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) *
        ⟨Polynomial.aeval s p.divX, Polynomial.aeval_mem_adjoin_singleton A s⟩ ∈ N :=
      Ideal.mul_mem_right _ _ hsN
    have haJ : algebraMap A ↥(Algebra.adjoin A {s}) (p.coeff 0) ∈ J := by
      have h1 : algebraMap A ↥(Algebra.adjoin A {s}) (p.coeff 0) = x -
          (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) *
          ⟨Polynomial.aeval s p.divX, Polynomial.aeval_mem_adjoin_singleton A s⟩ := by
        rw [hx]; ring
      rw [h1]
      exact sub_mem hxJ (hNJ hsy)
    by_cases hc0 : p.coeff 0 ∈ 𝔭
    · rw [hx]
      exact add_mem (hpN hc0) hsy
    · exfalso
      obtain ⟨β, i, hi, hβ⟩ := hmax.exists_inv hc0
      apply hJ
      rw [Ideal.eq_top_iff_one]
      have e1 : (1 : ↥(Algebra.adjoin A {s})) =
          algebraMap A _ β * algebraMap A _ (p.coeff 0) + algebraMap A _ i := by
        rw [← map_mul, ← map_add, hβ, map_one]
      rw [e1]
      exact add_mem (Ideal.mul_mem_left _ _ haJ) (hNJ (hpN hi))

  have s3 : ∀ (s₁ s₂ υ : K), υ ∈ Algebra.adjoin A {s₂} → υ * s₁ ∈ Algebra.adjoin A {s₂} →
      ∀ r ∈ Algebra.adjoin A {s₁}, ∃ k : ℕ, υ ^ k * r ∈ Algebra.adjoin A {s₂} := by
    intro s₁ s₂ υ hυ hυs r hr
    induction hr using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact ⟨1, by rwa [pow_one]⟩
    | algebraMap a => exact ⟨0, by rw [pow_zero, one_mul]; exact Subalgebra.algebraMap_mem _ a⟩
    | add x y _ _ hx hy =>
      obtain ⟨k₁, h₁⟩ := hx
      obtain ⟨k₂, h₂⟩ := hy
      refine ⟨k₁ + k₂, ?_⟩
      have e : υ ^ (k₁ + k₂) * (x + y) = υ ^ k₂ * (υ ^ k₁ * x) + υ ^ k₁ * (υ ^ k₂ * y) := by ring
      rw [e]
      exact add_mem (mul_mem (pow_mem hυ _) h₁) (mul_mem (pow_mem hυ _) h₂)
    | mul x y _ _ hx hy =>
      obtain ⟨k₁, h₁⟩ := hx
      obtain ⟨k₂, h₂⟩ := hy
      refine ⟨k₁ + k₂, ?_⟩
      have e : υ ^ (k₁ + k₂) * (x * y) = (υ ^ k₁ * x) * (υ ^ k₂ * y) := by ring
      rw [e]
      exact mul_mem h₁ h₂

  have key : ∀ c c' b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → c' ∈ IsLocalRing.maximalIdeal ↥W →
      b ∣ c - c' → wcLlsDiscSep W A K L t c b → wcLlsDiscSep W A K L t c' b := by
    intro c c' b hc hc' hdvd hsep
    obtain ⟨w, hw⟩ := hdvd
    have hZ : algebraMap A K (t - algebraMap ↥W A c) ≠ 0 := fun h =>
      s1 c ((IsFractionRing.injective A K) (h.trans (map_zero _).symm))
    have hZ' : algebraMap A K (t - algebraMap ↥W A c') ≠ 0 := fun h =>
      s1 c' ((IsFractionRing.injective A K) (h.trans (map_zero _).symm))
    have I1 : algebraMap A K (t - algebraMap ↥W A c') = algebraMap A K (t - algebraMap ↥W A c) +
        algebraMap A K (algebraMap ↥W A b) * algebraMap A K (algebraMap ↥W A w) := by
      have e : algebraMap ↥W A c = algebraMap ↥W A c' + algebraMap ↥W A b * algebraMap ↥W A w := by
        rw [← map_mul, ← map_add, ← hw]; congr 1; ring
      rw [← map_mul, ← map_add, e]; congr 1; ring
    unfold wcLlsDiscSep wcLlsSepAt at hsep ⊢
    set Z := algebraMap A K (t - algebraMap ↥W A c) with hZdef
    set Z' := algebraMap A K (t - algebraMap ↥W A c') with hZ'def
    set B := algebraMap A K (algebraMap ↥W A b) with hBdef
    set ω := algebraMap A K (algebraMap ↥W A w) with hωdef
    set s := B / Z with hsdef
    set s' := B / Z' with hs'def
    have hZB : Z + B * ω ≠ 0 := by rw [← I1]; exact hZ'
    have hs'2 : s' = B / (Z + B * ω) := by rw [hs'def, I1]
    have alg : ∀ (Z P B ω : K), Z ≠ 0 → P ≠ 0 → P = Z + B * ω →
        (1 + ω * (B / Z)) * (1 - ω * (B / P)) = 1 ∧
        (1 + ω * (B / Z)) * (B / P) = B / Z ∧
        (1 - ω * (B / P)) * (B / Z) = B / P := by
      intro Z P B ω h1 h2 hP
      have ea : 1 + ω * (B / Z) = P / Z := by
        rw [eq_div_iff h1, add_mul, mul_assoc, div_mul_cancel₀ B h1, hP]; ring
      have eb : 1 - ω * (B / P) = Z / P := by
        rw [eq_div_iff h2, sub_mul, mul_assoc, div_mul_cancel₀ B h2, hP]; ring
      rw [ea, eb]
      refine ⟨?_, ?_, ?_⟩
      · rw [div_mul_div_comm, mul_comm P Z, div_self (mul_ne_zero h1 h2)]
      · rw [div_mul_div_comm, mul_comm P B, mul_div_mul_right B Z h2]
      · rw [div_mul_div_comm, mul_comm Z B, mul_div_mul_right B P h1]
    obtain ⟨I4, I5, I6⟩ : (1 + ω * s) * (1 - ω * s') = 1 ∧ (1 + ω * s) * s' = s ∧
        (1 - ω * s') * s = s' := alg Z Z' B ω hZ hZ' I1

    have hsR : s ∈ Algebra.adjoin A {s} := Algebra.subset_adjoin (Set.mem_singleton s)
    have hs'R : s' ∈ Algebra.adjoin A {s'} := Algebra.subset_adjoin (Set.mem_singleton s')
    have hu : 1 + ω * s ∈ Algebra.adjoin A {s} :=
      add_mem (one_mem _) (mul_mem (Subalgebra.algebraMap_mem _ _) hsR)
    have hu' : 1 - ω * s' ∈ Algebra.adjoin A {s'} :=
      sub_mem (one_mem _) (mul_mem (Subalgebra.algebraMap_mem _ _) hs'R)
    have hus' : (1 + ω * s) * s' ∈ Algebra.adjoin A {s} := by rw [I5]; exact hsR
    have hu's : (1 - ω * s') * s ∈ Algebra.adjoin A {s'} := by rw [I6]; exact hs'R
    have M1 := s3 s s' (1 - ω * s') hu' hu's
    have M2 := s3 s' s (1 + ω * s) hu hus'
    have Hc := s4 A K L (Algebra.adjoin A {s}) (Algebra.adjoin A {s'})
      (1 - ω * s') hu' M1
    have Hc' := s4 A K L (Algebra.adjoin A {s'}) (Algebra.adjoin A {s})
      (1 + ω * s) hu M2
    let i : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) →+* L :=
      (integralClosure ↥(Algebra.adjoin A {s}) L).val.toRingHom
    let i' : ↥(integralClosure ↥(Algebra.adjoin A {s'}) L) →+* L :=
      (integralClosure ↥(Algebra.adjoin A {s'}) L).val.toRingHom
    have hi : Function.Injective i := Subtype.val_injective
    have hi' : Function.Injective i' := Subtype.val_injective
    let υ : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) :=
      algebraMap ↥(Algebra.adjoin A {s}) _ ⟨1 + ω * s, hu⟩
    let υ' : ↥(integralClosure ↥(Algebra.adjoin A {s'}) L) :=
      algebraMap ↥(Algebra.adjoin A {s'}) _ ⟨1 - ω * s', hu'⟩
    have hiυ : i υ = algebraMap K L (1 + ω * s) := rfl
    have hiυ' : i' υ' = algebraMap K L (1 - ω * s') := rfl
    have hυυ' : i υ * i' υ' = 1 := by rw [hiυ, hiυ', ← map_mul, I4, map_one]
    have H : ∀ x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L),
        ∃ (k : ℕ) (y : ↥(integralClosure ↥(Algebra.adjoin A {s'}) L)),
          i' y = i' υ' ^ k * i x := by
      intro x
      obtain ⟨k, hk⟩ := Hc (x : L) x.2
      refine ⟨k, ⟨_, hk⟩, ?_⟩
      show algebraMap K L ((1 - ω * s') ^ k) * (x : L) = i' υ' ^ k * (x : L)
      rw [hiυ', map_pow]
    have H' : ∀ x' : ↥(integralClosure ↥(Algebra.adjoin A {s'}) L),
        ∃ (k : ℕ) (y : ↥(integralClosure ↥(Algebra.adjoin A {s}) L)),
          i y = i υ ^ k * i' x' := by
      intro x
      obtain ⟨k, hk⟩ := Hc' (x : L) x.2
      refine ⟨k, ⟨_, hk⟩, ?_⟩
      show algebraMap K L ((1 + ω * s) ^ k) * (x : L) = i υ ^ k * (x : L)
      rw [hiυ, map_pow]
    intro Q' hQ' hQ'N

    have hs'N : (⟨s', hs'R⟩ : ↥(Algebra.adjoin A {s'})) ∈
        Ideal.span {algebraMap A ↥(Algebra.adjoin A {s'}) (t - algebraMap ↥W A c'),
          (⟨s', hs'R⟩ : ↥(Algebra.adjoin A {s'}))} ⊔ (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s'})).comp (algebraMap ↥W A)) :=
      Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    have hυ' : υ' ∉ Q' := by
      intro hmem
      have h1 : (⟨1 - ω * s', hu'⟩ : ↥(Algebra.adjoin A {s'})) ∈
          Q'.comap (algebraMap ↥(Algebra.adjoin A {s'}) _) := hmem
      have h2 : (⟨s', hs'R⟩ : ↥(Algebra.adjoin A {s'})) ∈
          Q'.comap (algebraMap ↥(Algebra.adjoin A {s'}) _) := by rw [hQ'N]; exact hs'N
      have h3 : (1 : ↥(Algebra.adjoin A {s'})) = ⟨1 - ω * s', hu'⟩ +
          algebraMap A ↥(Algebra.adjoin A {s'}) (algebraMap ↥W A w) * ⟨s', hs'R⟩ := by
        apply Subtype.ext
        show (1 : K) = (1 - ω * s') + ω * s'
        ring
      apply hQ'.ne_top
      rw [Ideal.eq_top_iff_one]
      have h4 : (1 : ↥(Algebra.adjoin A {s'})) ∈
          Q'.comap (algebraMap ↥(Algebra.adjoin A {s'}) _) := by
        rw [h3]; exact add_mem h1 (Ideal.mul_mem_left _ _ h2)
      rw [Ideal.mem_comap, map_one] at h4
      exact h4
    obtain ⟨Q, hQ, HQ⟩ := s5 _ _ L i i' hi' υ' H Q' hQ' hυ'
    haveI := hQ
    obtain ⟨e, he⟩ := s6 _ _ L i i' hi hi' υ υ' hυυ' H H' Q Q' hυ' HQ

    have memJ : ∀ (r : ↥(Algebra.adjoin A {s})) (k : ℕ) (r' : ↥(Algebra.adjoin A {s'})),
        algebraMap K L (r' : K) = algebraMap K L (1 - ω * s') ^ k * algebraMap K L (r : K) →
        r' ∈ Ideal.span {algebraMap A ↥(Algebra.adjoin A {s'}) (t - algebraMap ↥W A c'),
          (⟨s', hs'R⟩ : ↥(Algebra.adjoin A {s'}))} ⊔
          (IsLocalRing.maximalIdeal ↥W).map
            ((algebraMap A ↥(Algebra.adjoin A {s'})).comp (algebraMap ↥W A)) →
        r ∈ Q.comap (algebraMap ↥(Algebra.adjoin A {s}) _) := by
      intro r k r' hr hr'
      rw [Ideal.mem_comap]
      apply (HQ (algebraMap _ _ r) k (algebraMap _ _ r') hr).mpr
      rw [← Ideal.mem_comap, hQ'N]
      exact hr'
    have hsN : (⟨s, hsR⟩ : ↥(Algebra.adjoin A {s})) ∈
        Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c),
          (⟨s, hsR⟩ : ↥(Algebra.adjoin A {s}))} ⊔ (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) :=
      Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    have hpN : 𝔭 ≤ (Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c),
          (⟨s, hsR⟩ : ↥(Algebra.adjoin A {s}))} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))).comap
          (algebraMap A ↥(Algebra.adjoin A {s})) := by
      rw [h𝔭]
      apply sup_le
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        rw [SetLike.mem_coe, Ideal.mem_comap]
        have e1 : algebraMap A ↥(Algebra.adjoin A {s}) t =
            algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c) +
            ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) c := by
          rw [RingHom.comp_apply, ← map_add, sub_add_cancel]
        rw [e1]
        exact add_mem (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
          (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc))
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap, Ideal.mem_comap]
        exact Ideal.mem_sup_right
          (Ideal.mem_map_of_mem ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) hx)
    have hNJ : Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c),
          (⟨s, hsR⟩ : ↥(Algebra.adjoin A {s}))} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) ≤
        Q.comap (algebraMap ↥(Algebra.adjoin A {s}) _) := by
      apply sup_le
      · rw [Ideal.span_le]
        intro x hx
        rcases hx with hx | hx
        · rw [hx]
          refine memJ _ 0 (algebraMap A ↥(Algebra.adjoin A {s'}) (t - algebraMap ↥W A c))
            (by rw [pow_zero, one_mul]; rfl) ?_
          have e1 : algebraMap A ↥(Algebra.adjoin A {s'}) (t - algebraMap ↥W A c) =
              algebraMap A ↥(Algebra.adjoin A {s'}) (t - algebraMap ↥W A c') +
              ((algebraMap A ↥(Algebra.adjoin A {s'})).comp (algebraMap ↥W A)) (c' - c) := by
            rw [RingHom.comp_apply, ← map_add]; congr 1; rw [map_sub]; ring
          rw [e1]
          exact add_mem (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
            (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ (sub_mem hc' hc)))
        · rw [Set.mem_singleton_iff] at hx
          rw [hx]
          refine memJ _ 1 ⟨s', hs'R⟩ ?_ hs'N
          show algebraMap K L s' = algebraMap K L (1 - ω * s') ^ 1 * algebraMap K L s
          rw [pow_one, ← map_mul, I6]
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap]
        refine memJ _ 0 (algebraMap A ↥(Algebra.adjoin A {s'}) (algebraMap ↥W A x))
          (by rw [pow_zero, one_mul]; rfl) ?_
        exact Ideal.mem_sup_right
          (Ideal.mem_map_of_mem ((algebraMap A ↥(Algebra.adjoin A {s'})).comp (algebraMap ↥W A)) hx)
    have hJ : Q.comap (algebraMap ↥(Algebra.adjoin A {s}) _) ≠ ⊤ := Ideal.comap_ne_top _ hQ.ne_top
    have hQN := s2 s _ _ hsN hpN hNJ hJ
    have hnb := hsep Q hQN
    intro hb
    apply hnb
    refine (s7 L
      ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥(Algebra.adjoin A {s}) ↥(Algebra.adjoin A {s'}) Q Q' e ?_ ?_).mpr hb
    · intro x y hxy
      exact he x y hxy
    · intro x _
      exact ⟨Subalgebra.algebraMap_mem (integralClosure ↥(Algebra.adjoin A {s}) L)
          (algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A x)),
        Subalgebra.algebraMap_mem (integralClosure ↥(Algebra.adjoin A {s'}) L)
          (algebraMap A ↥(Algebra.adjoin A {s'}) (algebraMap ↥W A x))⟩
  intro c c' b hc hc' _ _ hdvd
  exact key c c' b hc hc' (dvd_sub_comm.mp hdvd)

theorem wcLlsKP_vde_principal_unit : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y →
    Module.finrank K L = ℓ →
    ∀ (θ : L) (f : A), θ ∉ Set.range (algebraMap K L) → θ ^ ℓ = algebraMap A L f →
    (∀ Q : Ideal ↥(integralClosure A L), wcLlsGenPt W A L 𝔭 Q → ¬ wcLlsRam A K L Q) →
    ∃ (θ' : L) (f₁ : K) (d₁ : A), d₁ ∉ 𝔭 ∧ θ' ∉ Set.range (algebraMap K L) ∧
      θ' ^ ℓ = algebraMap K L f₁ ∧ wcLlsKPLoc A K 0 d₁ f₁ ∧ wcLlsKPLoc A K 0 d₁ f₁⁻¹ ∧
      ∃ x z : K, wcLlsKPLoc A K 0 d₁ x ∧ wcLlsKPMLoc W A K 0 d₁ z ∧
        f₁ - 1 = algebraMap A K t * x + z :=
by
  classical
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hSolv hUniq hdeg θ f
    hθ hθf hNB

  have hPD' := hPD
  unfold wcLlsPD at hPD'
  try simp only at hPD'
  obtain ⟨hFT, -, -, hmax, hmA, -, hpeq, -⟩ := hPD'
  haveI h𝔭prime : 𝔭.IsPrime := hmax.isPrime
  have hinjL : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L, RingHom.coe_comp]
    exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)
  have hf0 : f ≠ 0 := by
    rintro rfl
    apply hθ
    refine ⟨0, ?_⟩
    rw [map_zero] at hθf
    rw [map_zero]
    exact ((pow_eq_zero_iff hℓ.ne_zero).mp hθf).symm

  obtain ⟨r, c, n, d, a, s, hcinj, hcm, hd0, ha, hs, hfac⟩ :=
    wcpa_dj_llsm_kpd_disc_factorization Ω W hW hWt A 𝔭 t hPD f hf0

  have hdvd : ∀ i, ℓ ∣ n i := by
    intro i₀
    by_contra hnd
    obtain ⟨h, hh⟩ : ∃ h : A, h = algebraMap ↥W A d * a *
        ∏ j ∈ Finset.univ.erase i₀, (t - algebraMap ↥W A (c j)) ^ (n j) := ⟨_, rfl⟩
    have hfac' : s * f = (t - algebraMap ↥W A (c i₀)) ^ (n i₀) * h := by
      rw [hfac, ← Finset.mul_prod_erase Finset.univ
        (fun j => (t - algebraMap ↥W A (c j)) ^ (n j)) (Finset.mem_univ i₀), hh]
      ring
    have hside : ∀ q : Ideal A, q.IsPrime → q ≤ 𝔭 →
        (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ q) →
        t - algebraMap ↥W A (c i₀) ∈ q → h ∉ q ∧ s ∉ q := by
      intro q hq hq𝔭 hqW htq
      refine ⟨?_, fun h' => hs (hq𝔭 h')⟩
      rw [hh]
      intro hmem
      rcases hq.mem_or_mem hmem with h1 | h1
      · rcases hq.mem_or_mem h1 with h2 | h2
        · exact hqW d hd0 h2
        · exact ha (hq𝔭 h2)
      · obtain ⟨j, hj, hjq⟩ := (Ideal.IsPrime.prod_mem_iff (hp := hq)).mp h1
        have hjq' := hq.mem_of_pow_mem _ hjq
        have hne : j ≠ i₀ := Finset.ne_of_mem_erase hj
        apply hqW (c i₀ - c j) (sub_ne_zero.mpr (fun e => hne (hcinj e).symm))
        have e2 : algebraMap ↥W A (c i₀ - c j) =
            (t - algebraMap ↥W A (c j)) - (t - algebraMap ↥W A (c i₀)) := by
          rw [map_sub]; ring
        rw [e2]
        exact q.sub_mem hjq' htq
    obtain ⟨Q, hQ1, -, hQ3⟩ := wcpa_dj_llsm_kpd_ramified_section Ω W hW hWt ℓ hℓ A K L 𝔭 t hPD
      hdeg θ f s h (c i₀) (n i₀) hθf (hcm i₀) hnd hfac' hside
    exact hNB Q hQ1 hQ3
  choose k hk using hdvd

  have hroot : ∀ x : ↥W, ∃ z : ↥W, z ^ ℓ = x := by
    intro x
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (x : Ω) hℓ.pos
    have hint : IsIntegral ↥W z := ⟨Polynomial.X ^ ℓ - Polynomial.C x,
      Polynomial.monic_X_pow_sub_C x hℓ.ne_zero, by
        rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
        exact sub_eq_zero.mpr (hz.trans rfl)⟩
    obtain ⟨z', hz'⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥W) (K := Ω)).mp hint
    refine ⟨z', ?_⟩
    apply IsFractionRing.injective ↥W Ω
    rw [map_pow, hz']
    exact hz.trans rfl

  obtain ⟨δ, hδ⟩ := hroot d
  obtain ⟨H, hH⟩ : ∃ H : A, H = algebraMap ↥W A δ * ∏ i, (t - algebraMap ↥W A (c i)) ^ (k i) :=
    ⟨_, rfl⟩
  have hE1 : s * f = a * H ^ ℓ := by
    have hpw : ∀ i, (t - algebraMap ↥W A (c i)) ^ (n i) =
        ((t - algebraMap ↥W A (c i)) ^ (k i)) ^ ℓ := by
      intro i; rw [← pow_mul, hk i, mul_comm]
    rw [hfac, hH, mul_pow, ← Finset.prod_pow, ← map_pow (algebraMap ↥W A) δ ℓ, hδ,
      Finset.prod_congr rfl (fun i _ => hpw i)]
    ring
  obtain ⟨m, hm⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, by have := hℓ.pos; omega⟩
  obtain ⟨g, hg⟩ : ∃ g : A, g = s ^ m * a := ⟨_, rfl⟩
  have hg𝔭 : g ∉ 𝔭 := by
    rw [hg]; intro hmem
    rcases h𝔭prime.mem_or_mem hmem with h1 | h1
    · exact hs (h𝔭prime.mem_of_pow_mem _ h1)
    · exact ha h1
  have hs0 : s ≠ 0 := fun e => hs (e ▸ 𝔭.zero_mem)
  have hg0 : g ≠ 0 := fun e => hg𝔭 (e ▸ 𝔭.zero_mem)
  have hH0 : H ≠ 0 := by
    intro e
    have h1 : s * f = 0 := by rw [hE1, e, zero_pow hℓ.ne_zero, mul_zero]
    exact mul_ne_zero hs0 hf0 h1

  obtain ⟨w, hw⟩ := wcpa_dj_llsm_kptf_residue_trivial Ω W A 𝔭 hFT hmax hmA g
  have hwu : IsUnit w := by
    rw [← IsLocalRing.notMem_maximalIdeal]
    intro hwm
    apply hg𝔭
    have h1 : algebraMap ↥W A w ∈ 𝔭 := hmA (Ideal.mem_map_of_mem _ hwm)
    have h2 := 𝔭.add_mem hw h1
    rwa [sub_add_cancel] at h2
  obtain ⟨lam, hlam⟩ := hroot w
  have hlamu : IsUnit lam := (isUnit_pow_iff hℓ.ne_zero).mp (by rw [hlam]; exact hwu)
  obtain ⟨U, hU⟩ := hlamu
  obtain ⟨μ, hμlam, hμunit⟩ : ∃ μ : ↥W, μ * lam = 1 ∧ IsUnit μ :=
    ⟨↑U⁻¹, by rw [← hU]; exact U.inv_mul, (U⁻¹).isUnit⟩
  have huw : μ ^ ℓ * w = 1 := by rw [← hlam, ← mul_pow, hμlam, one_pow]
  have hμA0 : algebraMap ↥W A μ ≠ 0 := (hμunit.map (algebraMap ↥W A)).ne_zero
  have hμsA : algebraMap ↥W A μ * s ≠ 0 := mul_ne_zero hμA0 hs0
  have hμsL : algebraMap A L (algebraMap ↥W A μ * s) ≠ 0 := (map_ne_zero_iff _ hinjL).mpr hμsA
  have hHL0 : algebraMap A L H ≠ 0 := (map_ne_zero_iff _ hinjL).mpr hH0
  have hgK : algebraMap A K g ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr hg0

  have hkey : (algebraMap ↥W A μ * s) ^ ℓ * f = algebraMap ↥W A (μ ^ ℓ) * g * H ^ ℓ := by
    have hsℓ : s ^ ℓ = s ^ m * s := by rw [hm, pow_succ]
    rw [mul_pow, map_pow]
    linear_combination (algebraMap ↥W A μ ^ ℓ * f) * hsℓ - (algebraMap ↥W A μ ^ ℓ * H ^ ℓ) * hg
      + (algebraMap ↥W A μ ^ ℓ * s ^ m) * hE1

  obtain ⟨θ', hθ'def⟩ : ∃ θ' : L,
      θ' = algebraMap A L (algebraMap ↥W A μ * s) * θ / algebraMap A L H := ⟨_, rfl⟩
  obtain ⟨f₁, hf₁def⟩ : ∃ f₁ : K, f₁ = algebraMap A K (algebraMap ↥W A (μ ^ ℓ) * g) :=
    ⟨_, rfl⟩
  have hLocA : ∀ x : A, wcLlsKPLoc A K 0 g (algebraMap A K x) := by
    intro x
    unfold wcLlsKPLoc
    exact ⟨0, by rw [pow_zero, one_mul]; exact Subalgebra.algebraMap_mem _ x⟩

  have hθ'f : θ' ^ ℓ = algebraMap K L f₁ := by
    have e := congrArg (algebraMap A L) hkey
    simp only [map_mul, map_pow] at e
    rw [hθ'def, hf₁def, ← IsScalarTower.algebraMap_apply A K L, div_pow, mul_pow, hθf,
      div_eq_iff (pow_ne_zero _ hHL0)]
    simp only [map_mul, map_pow]
    linear_combination e

  have hθ' : θ' ∉ Set.range (algebraMap K L) := by
    rintro ⟨k₀, hk₀⟩
    apply hθ
    refine ⟨algebraMap A K H * k₀ / algebraMap A K (algebraMap ↥W A μ * s), ?_⟩
    rw [map_div₀, map_mul, hk₀, ← IsScalarTower.algebraMap_apply A K L,
      ← IsScalarTower.algebraMap_apply A K L, hθ'def, div_eq_iff hμsL, mul_div_assoc',
      div_eq_iff hHL0]
    ring

  have hL1 : wcLlsKPLoc A K 0 g f₁ := by rw [hf₁def]; exact hLocA _

  have huw' : algebraMap A K (algebraMap ↥W A (μ ^ ℓ)) * algebraMap A K (algebraMap ↥W A w) = 1 := by
    rw [← map_mul, ← map_mul, huw, map_one, map_one]
  have hL2 : wcLlsKPLoc A K 0 g f₁⁻¹ := by
    unfold wcLlsKPLoc
    refine ⟨1, ?_⟩
    have e : algebraMap A K g ^ 1 * f₁⁻¹ = algebraMap A K (algebraMap ↥W A w) := by
      rw [hf₁def, map_mul, pow_one, mul_inv, ← mul_assoc, mul_comm (algebraMap A K g),
        mul_assoc, mul_inv_cancel₀ hgK, mul_one]
      exact inv_eq_of_mul_eq_one_right huw'
    rw [e]
    exact Subalgebra.algebraMap_mem _ _

  have hmapmax : ∀ z ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A),
      ∃ π ∈ IsLocalRing.maximalIdeal ↥W, ∃ a' : A, z = algebraMap ↥W A π * a' := by
    intro z hz
    have hz' : z ∈ Submodule.span A
        (algebraMap ↥W A '' (IsLocalRing.maximalIdeal ↥W : Set ↥W)) := hz
    clear hz
    induction hz' using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨π, hπ, rfl⟩ := hx
      exact ⟨π, hπ, 1, (mul_one _).symm⟩
    | zero => exact ⟨0, Ideal.zero_mem _, 0, (mul_zero _).symm⟩
    | add x₁ x₂ _ _ hx₁ hx₂ =>
      obtain ⟨π₁, hπ₁, a₁, rfl⟩ := hx₁
      obtain ⟨π₂, hπ₂, a₂, rfl⟩ := hx₂
      rcases ValuationRing.dvd_total π₁ π₂ with ⟨e, rfl⟩ | ⟨e, rfl⟩
      · exact ⟨π₁, hπ₁, a₁ + algebraMap ↥W A e * a₂, by rw [map_mul]; ring⟩
      · exact ⟨π₂, hπ₂, algebraMap ↥W A e * a₁ + a₂, by rw [map_mul]; ring⟩
    | smul r x _ hx =>
      obtain ⟨π, hπ, a', rfl⟩ := hx
      exact ⟨π, hπ, r * a', by rw [smul_eq_mul]; ring⟩
  rw [hpeq] at hw
  obtain ⟨y₀, hy₀, z₀, hz₀, hyz⟩ := Submodule.mem_sup.mp hw
  obtain ⟨x₀, rfl⟩ := Ideal.mem_span_singleton.mp hy₀
  obtain ⟨π, hπ, a', hz₀eq⟩ := hmapmax z₀ hz₀
  have huwA : algebraMap ↥W A (μ ^ ℓ) * algebraMap ↥W A w = 1 := by
    rw [← map_mul, huw, map_one]
  have hA : algebraMap ↥W A (μ ^ ℓ) * g - 1 =
      t * (algebraMap ↥W A (μ ^ ℓ) * x₀) + algebraMap ↥W A π * (algebraMap ↥W A (μ ^ ℓ) * a') := by
    linear_combination (-algebraMap ↥W A (μ ^ ℓ)) * hyz + algebraMap ↥W A (μ ^ ℓ) * hz₀eq + huwA
  have heq : f₁ - 1 = algebraMap A K t * algebraMap A K (algebraMap ↥W A (μ ^ ℓ) * x₀) +
      algebraMap A K (algebraMap ↥W A π) * algebraMap A K (algebraMap ↥W A (μ ^ ℓ) * a') := by
    have e := congrArg (algebraMap A K) hA
    simp only [map_sub, map_one, map_mul, map_add] at e
    rw [hf₁def]
    simp only [map_mul]
    linear_combination e
  have hz : wcLlsKPMLoc W A K 0 g
      (algebraMap A K (algebraMap ↥W A π) * algebraMap A K (algebraMap ↥W A (μ ^ ℓ) * a')) := by
    unfold wcLlsKPMLoc
    exact ⟨π, hπ, _, hLocA _, rfl⟩
  exact ⟨θ', f₁, g, hg𝔭, hθ', hθ'f, hL1, hL2, _, _, hLocA _, hz, heq⟩

theorem wcLlsKP_vde_no_as_split : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y →
    Module.finrank K L = ℓ →
    ∀ (θ' : L) (f₁ : K) (d₁ : A), d₁ ∉ 𝔭 → θ' ∉ Set.range (algebraMap K L) →
      θ' ^ ℓ = algebraMap K L f₁ → wcLlsKPLoc A K 0 d₁ f₁ → wcLlsKPLoc A K 0 d₁ f₁⁻¹ →
      (∃ x z : K, wcLlsKPLoc A K 0 d₁ x ∧ wcLlsKPMLoc W A K 0 d₁ z ∧
        f₁ - 1 = algebraMap A K t * x + z) →
    ∀ (γ ε₀ : ↥W) (h' : K) (d : A), d ∉ 𝔭 → IsUnit ε₀ → ((ℓ : ℕ) : ↥W) = γ ^ (ℓ - 1) * ε₀ →
      wcLlsKPLoc A K 0 d h' →
      wcLlsKPLoc A K 0 d ((f₁ - h' ^ ℓ) / algebraMap A K (algebraMap ↥W A γ) ^ ℓ) → False :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hSolv hUniq hdeg
    θ' f₁ d₁ hd₁ hθ' hθf hL1 hL2 _hPU γ ε₀ h' d hd hε hγ hh hg
  classical
  obtain ⟨hFT, hNZ, -, h𝔭max, hmW, -⟩ := hPD
  obtain ⟨hyP, hy𝔭, -⟩ := hSolv
  subst hy𝔭
  haveI := hyP
  have hℓpos : 0 < ℓ := hℓ.pos
  obtain ⟨m, hm2⟩ : ∃ m, ℓ = m + 1 + 1 := ⟨ℓ - 2, by have := hℓ.two_le; omega⟩
  have hinjAK : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hinj : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp hinjAK
  have hinjW : Function.Injective (algebraMap ↥W A) := by
    haveI := hNZ
    intro a b hab
    have h1 : (a - b) • (1 : A) = 0 := by
      rw [sub_smul, ← Algebra.algebraMap_eq_smul_one, ← Algebra.algebraMap_eq_smul_one, hab,
        sub_self]
    rcases smul_eq_zero.mp h1 with h | h
    · exact sub_eq_zero.mp h
    · exact absurd h one_ne_zero

  have hγ0 : γ ≠ 0 := by
    intro h0
    rw [h0, zero_pow (by omega : ℓ - 1 ≠ 0), zero_mul] at hγ
    have h1 : ((ℓ : ℕ) : Ω) = 0 := by
      have := congrArg W.subtype hγ
      rwa [map_natCast, map_zero] at this
    have hdvd : ringChar Ω ∣ ℓ := ringChar.dvd h1
    rcases hℓ.eq_one_or_self_of_dvd _ hdvd with h2 | h2
    · exact CharP.ringChar_ne_one h2
    · exact hΩ h2
  obtain ⟨γL, hγLdef⟩ : ∃ z : L, algebraMap A L (algebraMap ↥W A γ) = z := ⟨_, rfl⟩
  obtain ⟨εL, hεLdef⟩ : ∃ z : L, algebraMap A L (algebraMap ↥W A ε₀) = z := ⟨_, rfl⟩
  have hγL0 : γL ≠ 0 := by
    rw [← hγLdef]
    intro h
    apply hγ0
    apply hinjW
    apply hinj
    rw [h, map_zero, map_zero]
  have hγL' : ((ℓ : ℕ) : L) = γL ^ (ℓ - 1) * εL := by
    have := congrArg (fun z => algebraMap A L (algebraMap ↥W A z)) hγ
    simp only [map_natCast, map_mul, map_pow, hγLdef, hεLdef] at this
    exact this
  let cf : ℕ → A := fun i => algebraMap ↥W A (((ℓ.choose i / ℓ : ℕ) : ↥W) * ε₀ * γ ^ (i - 1))
  have hcf : ∀ i, algebraMap A L (cf i) = ((ℓ.choose i / ℓ : ℕ) : L) * εL * γL ^ (i - 1) := by
    intro i
    simp only [cf, map_mul, map_pow, map_natCast, hγLdef, hεLdef]

  have hbin : ∀ a X : L, (a + γL * X) ^ ℓ = a ^ ℓ + γL ^ ℓ * (X ^ ℓ + ∑ i ∈ Finset.range ℓ,
      algebraMap A L (cf i) * a ^ (ℓ - i) * X ^ i) := by
    intro a X
    simp only [hcf]
    rw [add_comm a, add_pow, Finset.sum_range_succ, Nat.sub_self, pow_zero, mul_one,
      Nat.choose_self, Nat.cast_one, mul_one]
    have hterm : ∀ i ∈ Finset.range ℓ, (γL * X) ^ i * a ^ (ℓ - i) * (ℓ.choose i : L) =
        (if i = 0 then a ^ ℓ else 0) + γL ^ ℓ * (((ℓ.choose i / ℓ : ℕ) : L) * εL * γL ^ (i - 1) *
          a ^ (ℓ - i) * X ^ i) := by
      intro i hi
      have hi' : i < ℓ := Finset.mem_range.mp hi
      rcases Nat.eq_zero_or_pos i with h0 | hpos
      · subst h0
        have e1 : ℓ.choose 0 / ℓ = 0 := by
          rw [Nat.choose_zero_right]; exact Nat.div_eq_of_lt hℓ.one_lt
        rw [e1, if_pos rfl, Nat.choose_zero_right]
        simp
      · rw [if_neg hpos.ne']
        have hdvd : ℓ ∣ ℓ.choose i := hℓ.dvd_choose_self hpos.ne' hi'
        have hc : (ℓ.choose i : L) = ((ℓ.choose i / ℓ : ℕ) : L) * (ℓ : L) := by
          rw [← Nat.cast_mul, Nat.div_mul_cancel hdvd]
        have hp : γL ^ i * γL ^ (ℓ - 1) = γL ^ ℓ * γL ^ (i - 1) := by
          rw [← pow_add, ← pow_add]; congr 1; omega
        rw [hc, hγL', mul_pow]
        linear_combination (X ^ i * a ^ (ℓ - i) * ((ℓ.choose i / ℓ : ℕ) : L) * εL) * hp
    rw [Finset.sum_congr rfl hterm, Finset.sum_add_distrib, ← Finset.mul_sum]
    simp only [Finset.sum_ite_eq', Finset.mem_range, hℓpos, if_true]
    ring

  have hint : ∀ (n : ℕ), 0 < n → ∀ (a : ℕ → A) (b : A) (z : L),
      z ^ n + ∑ i ∈ Finset.range n, algebraMap A L (a i) * z ^ i + algebraMap A L b = 0 →
      z ∈ integralClosure A L := by
    intro n hn a b z hz
    rw [mem_integralClosure_iff]
    refine ⟨Polynomial.X ^ n + (∑ i ∈ Finset.range n, Polynomial.C (a i) * Polynomial.X ^ i +
      Polynomial.C b), ?_, ?_⟩
    · apply Polynomial.monic_X_pow_add
      refine lt_of_le_of_lt (Polynomial.degree_add_le _ _) (max_lt ?_ ?_)
      · refine lt_of_le_of_lt (Polynomial.degree_sum_le _ _) ?_
        refine (Finset.sup_lt_iff (WithBot.bot_lt_coe n)).mpr (fun i hi => ?_)
        exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_pow_le _ _)
          (WithBot.coe_lt_coe.mpr (Finset.mem_range.mp hi))
      · refine lt_of_le_of_lt Polynomial.degree_C_le ?_
        exact WithBot.coe_lt_coe.mpr hn
    · simp only [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finset_sum,
        Polynomial.eval₂_mul, Polynomial.eval₂_C]
      rw [← add_assoc]; exact hz

  have hsplit : ∀ (f : ℕ → L) (k : ℕ), ∑ i ∈ Finset.range (k + 1 + 1), f i =
      ∑ i ∈ Finset.range k, f (i + 1 + 1) + f 1 + f 0 := by
    intro f k; rw [Finset.sum_range_succ', Finset.sum_range_succ']
  have hs4 : ∀ (n k : ℕ), n = k + 1 + 1 → ∀ (c : ℕ → L) (z : L), z ≠ 0 →
      z ^ n + ∑ i ∈ Finset.range n, c i * z ^ i = 0 → c 0 = 0 → c 1 = εL →
      z * (z ^ k + ∑ i ∈ Finset.range k, c (i + 1 + 1) * z ^ i) = -εL := by
    intro n k hn c z hz h h0 h1
    subst hn
    rw [hsplit, h0, h1] at h
    have hs : ∑ i ∈ Finset.range k, c (i + 1 + 1) * z ^ (i + 1 + 1) =
        z ^ 2 * ∑ i ∈ Finset.range k, c (i + 1 + 1) * z ^ i := by
      rw [Finset.mul_sum]; exact Finset.sum_congr rfl (fun i _ => by ring)
    rw [hs] at h
    have h2 : z * (z * (z ^ k + ∑ i ∈ Finset.range k, c (i + 1 + 1) * z ^ i) + εL) = 0 := by
      linear_combination h
    have h3 := (mul_eq_zero.mp h2).resolve_left hz
    linear_combination h3

  have hLoc : ∀ (e : A) (z : K), wcLlsKPLoc A K 0 e z →
      ∃ (n : ℕ) (b : A), algebraMap A L e ^ n * algebraMap K L z = algebraMap A L b := by
    rintro e z ⟨n, hn⟩
    rw [Algebra.adjoin_singleton_zero, Algebra.mem_bot] at hn
    obtain ⟨b, hb⟩ := hn
    refine ⟨n, b, ?_⟩
    rw [IsScalarTower.algebraMap_apply A K L e, IsScalarTower.algebraMap_apply A K L b, ← map_pow,
      ← map_mul, hb]
  obtain ⟨n₁, b₁, hb₁⟩ := hLoc _ _ hL1
  obtain ⟨n₂, b₂, hb₂⟩ := hLoc _ _ hL2
  obtain ⟨n₃, b₃, hb₃⟩ := hLoc _ _ hh
  obtain ⟨n₄, b₄, hb₄⟩ := hLoc _ _ hg
  rw [map_inv₀] at hb₂
  have hγKL : algebraMap K L (algebraMap A K (algebraMap ↥W A γ)) = γL := by
    rw [← IsScalarTower.algebraMap_apply A K L, hγLdef]
  obtain ⟨F, hFdef⟩ : ∃ z : L, algebraMap K L f₁ = z := ⟨_, rfl⟩
  obtain ⟨H, hHdef⟩ : ∃ z : L, algebraMap K L h' = z := ⟨_, rfl⟩
  rw [map_div₀, map_sub, map_pow, map_pow, hγKL, hFdef, hHdef] at hb₄
  rw [hFdef] at hb₁ hb₂ hθf
  rw [hHdef] at hb₃
  obtain ⟨G, hGdef⟩ : ∃ z : L, (F - H ^ ℓ) / γL ^ ℓ = z := ⟨_, rfl⟩
  rw [hGdef] at hb₄
  have hGF : F = H ^ ℓ + γL ^ ℓ * G := by
    rw [← hGdef, mul_comm (γL ^ ℓ), div_mul_cancel₀ _ (pow_ne_zero ℓ hγL0)]; ring
  obtain ⟨D, hDdef⟩ : ∃ D : A, D = d ^ (n₃ + n₄) := ⟨_, rfl⟩
  obtain ⟨B₃, hB₃⟩ : ∃ B : A, B = d ^ n₄ * b₃ := ⟨_, rfl⟩
  obtain ⟨B₄, hB₄⟩ : ∃ B : A, B = d ^ n₃ * b₄ := ⟨_, rfl⟩
  have hDH : algebraMap A L D * H = algebraMap A L B₃ := by
    rw [hDdef, hB₃, map_mul, map_pow, map_pow, ← hb₃, pow_add]; ring
  have hDG : algebraMap A L D * G = algebraMap A L B₄ := by
    rw [hDdef, hB₄, map_mul, map_pow, map_pow, ← hb₄, pow_add]; ring
  obtain ⟨DL, hDLdef⟩ : ∃ z : L, algebraMap A L D = z := ⟨_, rfl⟩
  rw [hDLdef] at hDH hDG

  obtain ⟨σ, hσ⟩ : ∃ σ : L ≃ₐ[K] L, σ θ' ≠ θ' := by
    by_contra hcon
    push_neg at hcon
    apply hθ'
    have hmem : θ' ∈ IntermediateField.fixedField (⊤ : Subgroup (L ≃ₐ[K] L)) :=
      (IntermediateField.mem_fixedField_iff _ _).mpr (fun g _ => hcon g)
    rw [IsGalois.fixedField_top] at hmem
    exact IntermediateField.mem_bot.mp hmem
  have hθ0 : θ' ≠ 0 := by
    rintro rfl
    exact hθ' ⟨0, map_zero _⟩
  have hF0 : F ≠ 0 := by rw [← hθf]; exact pow_ne_zero _ hθ0
  have hσA : ∀ a : A, σ (algebraMap A L a) = algebraMap A L a := by
    intro a; rw [IsScalarTower.algebraMap_apply A K L, AlgEquiv.commutes]
  have hσF : σ F = F := by rw [← hFdef]; exact σ.commutes f₁
  have hσH : σ H = H := by rw [← hHdef]; exact σ.commutes h'
  have hσγ : σ γL = γL := by rw [← hγLdef]; exact hσA _
  have hσD : σ DL = DL := by rw [← hDLdef]; exact hσA D
  obtain ⟨ζ, hζdef⟩ : ∃ ζ : L, ζ = σ θ' / θ' := ⟨_, rfl⟩
  have hσθ : σ θ' = ζ * θ' := by rw [hζdef, div_mul_cancel₀ _ hθ0]
  have hζℓ : ζ ^ ℓ = 1 := by
    have h1 : (σ θ') ^ ℓ = θ' ^ ℓ := by rw [← map_pow, hθf, hσF]
    rw [hζdef, div_pow, h1, div_self (pow_ne_zero _ hθ0)]
  have hζ1 : ζ ≠ 1 := by
    intro h; apply hσ; rw [hσθ, h, one_mul]

  obtain ⟨r, hrdef⟩ : ∃ r : L, r = (ζ - 1) / γL := ⟨_, rfl⟩
  have hr0 : r ≠ 0 := by rw [hrdef]; exact div_ne_zero (sub_ne_zero.mpr hζ1) hγL0
  have hγr : 1 + γL * r = ζ := by
    rw [hrdef, mul_comm γL, div_mul_cancel₀ _ hγL0]; ring
  have hPr : r ^ ℓ + ∑ i ∈ Finset.range ℓ, algebraMap A L (cf i) * r ^ i = 0 := by
    have h1 := hbin 1 r
    rw [hγr, hζℓ] at h1
    simp only [one_pow, mul_one] at h1
    have h2 : γL ^ ℓ * (r ^ ℓ + ∑ i ∈ Finset.range ℓ, algebraMap A L (cf i) * r ^ i) = 0 := by
      linear_combination -h1
    exact (mul_eq_zero.mp h2).resolve_left (pow_ne_zero _ hγL0)
  have hc0 : algebraMap A L (cf 0) = 0 := by
    rw [hcf, Nat.choose_zero_right, Nat.div_eq_of_lt hℓ.one_lt, Nat.cast_zero, zero_mul, zero_mul]
  have hc1 : algebraMap A L (cf 1) = εL := by
    rw [hcf, Nat.choose_one_right, Nat.div_self hℓpos, Nat.cast_one, one_mul, Nat.sub_self,
      pow_zero, mul_one]
  have hrI : r ∈ integralClosure A L :=
    hint ℓ hℓpos cf 0 r (by rw [map_zero, add_zero]; exact hPr)
  obtain ⟨T, hTdef⟩ : ∃ T : L,
      T = r ^ m + ∑ i ∈ Finset.range m, algebraMap A L (cf (i + 1 + 1)) * r ^ i := ⟨_, rfl⟩
  have hTr : r * T = -εL := by
    rw [hTdef]
    exact hs4 ℓ m hm2 (fun i => algebraMap A L (cf i)) r hr0 hPr hc0 hc1
  have hTI : T ∈ integralClosure A L := by
    rw [hTdef]
    exact Subalgebra.add_mem _ (Subalgebra.pow_mem _ hrI _)
      (Subalgebra.sum_mem _ fun i _ => Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
        (Subalgebra.pow_mem _ hrI _))

  obtain ⟨w, hwdef⟩ : ∃ w : L, w = (θ' - H) / γL := ⟨_, rfl⟩
  have hw : H + γL * w = θ' := by
    rw [hwdef, mul_comm γL, div_mul_cancel₀ _ hγL0]; ring
  have hQ : w ^ ℓ + ∑ i ∈ Finset.range ℓ, algebraMap A L (cf i) * H ^ (ℓ - i) * w ^ i = G := by
    have h1 := hbin H w
    rw [hw, hθf, hGF] at h1
    have h2 : γL ^ ℓ * ((w ^ ℓ + ∑ i ∈ Finset.range ℓ, algebraMap A L (cf i) * H ^ (ℓ - i) *
        w ^ i) - G) = 0 := by
      linear_combination -h1
    exact sub_eq_zero.mp ((mul_eq_zero.mp h2).resolve_left (pow_ne_zero _ hγL0))
  obtain ⟨x, hxdef⟩ : ∃ x : L, x = DL * w := ⟨_, rfl⟩
  have hxrel : x ^ ℓ + ∑ i ∈ Finset.range ℓ, algebraMap A L (cf i * B₃ ^ (ℓ - i)) * x ^ i +
      algebraMap A L (-(D ^ (ℓ - 1) * B₄)) = 0 := by
    have hsum : ∑ i ∈ Finset.range ℓ, algebraMap A L (cf i * B₃ ^ (ℓ - i)) * (DL * w) ^ i =
        DL ^ ℓ * ∑ i ∈ Finset.range ℓ, algebraMap A L (cf i) * H ^ (ℓ - i) * w ^ i := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i hi => ?_)
      have hi' := Finset.mem_range.mp hi
      have e : DL ^ ℓ = DL ^ (ℓ - i) * DL ^ i := by rw [← pow_add]; congr 1; omega
      rw [map_mul, map_pow, ← hDH, e, mul_pow, mul_pow]; ring
    have e2 : algebraMap A L (-(D ^ (ℓ - 1) * B₄)) = -(DL ^ ℓ * G) := by
      rw [map_neg, map_mul, map_pow, hDLdef, ← hDG, ← mul_assoc, ← pow_succ,
        Nat.sub_add_cancel hℓpos]
    rw [hxdef, hsum, e2, mul_pow, ← hQ]; ring
  have hxI : x ∈ integralClosure A L :=
    hint ℓ hℓpos (fun i => cf i * B₃ ^ (ℓ - i)) (-(D ^ (ℓ - 1) * B₄)) x hxrel

  have hΘ : DL * θ' = γL * x + DL * H := by
    rw [hxdef, ← hw]; ring
  have hγI : γL ∈ integralClosure A L := by
    rw [← hγLdef]; exact Subalgebra.algebraMap_mem _ _
  have hΘI : DL * θ' ∈ integralClosure A L := by
    rw [hΘ, hDH]
    exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ hγI hxI) (Subalgebra.algebraMap_mem _ _)

  have hσx : σ x - x = r * (DL * θ') := by
    rw [hxdef, hwdef, map_mul, map_div₀, map_sub, hσD, hσH, hσγ, hσθ, hrdef]
    field_simp
    ring

  let xt : ↥(integralClosure A L) := ⟨x, hxI⟩
  let rt : ↥(integralClosure A L) := ⟨r, hrI⟩
  let Tt : ↥(integralClosure A L) := ⟨T, hTI⟩
  let Θt : ↥(integralClosure A L) := ⟨DL * θ', hΘI⟩
  let τ : ↥(integralClosure A L) ≃ₐ[A] ↥(integralClosure A L) :=
    (σ.restrictScalars A).mapIntegralClosure
  have hτx : τ xt - xt = rt * Θt := Subtype.ext (by show σ x - x = r * (DL * θ'); exact hσx)
  have hTrt : Tt * rt = -(algebraMap A ↥(integralClosure A L) (algebraMap ↥W A ε₀)) :=
    Subtype.ext (by
      show T * r = -(algebraMap A L (algebraMap ↥W A ε₀))
      rw [hεLdef, mul_comm]; exact hTr)
  have hyτ : ∀ v ∈ y, τ v ∈ y := by
    have hEq : y.comap τ.symm = y := hUniq _ inferInstance (by
      ext a
      simp only [Ideal.mem_comap, AlgEquiv.commutes])
    intro v hv
    rw [← hEq, Ideal.mem_comap, AlgEquiv.symm_apply_apply]
    exact hv

  have hκac : IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
    refine IsAlgClosed.of_exists_root _ (fun p hpm hpirr => ?_)
    obtain ⟨q0, hq0⟩ := Polynomial.map_surjective _ (IsLocalRing.residue_surjective (R := ↥W)) p
    obtain ⟨q, hqmap, hqdeg, hqmon⟩ :=
      Polynomial.lifts_and_natDegree_eq_and_monic ((Polynomial.mem_lifts p).mpr ⟨q0, hq0⟩) hpm
    have hpdeg : 0 < p.natDegree :=
      Polynomial.natDegree_pos_iff_degree_pos.mpr (Polynomial.degree_pos_of_irreducible hpirr)
    have hqm : (q.map (algebraMap ↥W Ω)).Monic := hqmon.map _
    have hdeg : (q.map (algebraMap ↥W Ω)).degree ≠ 0 := by
      rw [Polynomial.degree_eq_natDegree hqm.ne_zero, hqmon.natDegree_map, hqdeg]
      exact_mod_cast hpdeg.ne'
    obtain ⟨x, hx⟩ := IsAlgClosed.exists_root _ hdeg
    have hxint : IsIntegral ↥W x := ⟨q, hqmon, by rw [← Polynomial.eval_map]; exact hx⟩
    obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥W) (K := Ω)).mp hxint
    have hq0' : Polynomial.eval y q = 0 := by
      apply IsFractionRing.injective ↥W Ω
      rw [map_zero, ← Polynomial.eval₂_at_apply, ← Polynomial.eval_map, hy]
      exact hx
    refine ⟨IsLocalRing.residue ↥W y, ?_⟩
    rw [← hqmap, Polynomial.eval_map, Polynomial.eval₂_at_apply, hq0', map_zero]
  have hres : ∃ w : ↥W,
      xt - algebraMap A ↥(integralClosure A L) (algebraMap ↥W A w) ∈ y := by
    have hle : IsLocalRing.maximalIdeal ↥W ≤
        (y.comap (algebraMap A ↥(integralClosure A L))).comap (algebraMap ↥W A) :=
      Ideal.map_le_iff_le_comap.mp hmW
    let α : IsLocalRing.ResidueField ↥W →+* A ⧸ y.comap (algebraMap A ↥(integralClosure A L)) :=
      Ideal.quotientMap _ (algebraMap ↥W A) hle
    have hψ : ((Ideal.Quotient.mk (y.comap (algebraMap A ↥(integralClosure A L)))).comp
        (algebraMap ↥W A)).FiniteType :=
      RingHom.FiniteType.comp (RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective)
        (RingHom.finiteType_algebraMap.mpr hFT)
    have hcomp : α.comp (IsLocalRing.residue ↥W) =
        (Ideal.Quotient.mk (y.comap (algebraMap A ↥(integralClosure A L)))).comp
          (algebraMap ↥W A) := by
      ext w; rfl
    have hαFT : α.FiniteType := by
      rw [← hcomp] at hψ
      exact RingHom.FiniteType.of_comp_finiteType hψ
    have hαint : α.IsIntegral := by
      letI : Algebra (IsLocalRing.ResidueField ↥W)
          (A ⧸ y.comap (algebraMap A ↥(integralClosure A L))) := α.toAlgebra
      haveI : Algebra.FiniteType (IsLocalRing.ResidueField ↥W)
          (A ⧸ y.comap (algebraMap A ↥(integralClosure A L))) := hαFT
      letI : Field (A ⧸ y.comap (algebraMap A ↥(integralClosure A L))) := Ideal.Quotient.field _
      have hαfin : α.Finite := finite_of_finite_type_of_isJacobsonRing _ _
      exact RingHom.IsIntegral.of_finite hαfin
    have hβint : (Ideal.quotientMap y (algebraMap A ↥(integralClosure A L)) le_rfl).IsIntegral :=
      RingHom.IsIntegral.quotient _ (fun x => Algebra.IsIntegral.isIntegral x)
    have hcint := RingHom.IsIntegral.trans α _ hαint hβint
    have hbij := IsAlgClosed.ringHom_bijective_of_isIntegral _ hcint
    obtain ⟨c, hc⟩ := hbij.2 (Ideal.Quotient.mk y xt)
    obtain ⟨w, rfl⟩ := IsLocalRing.residue_surjective c
    refine ⟨w, ?_⟩
    rw [← Ideal.Quotient.eq, ← hc]
    rfl

  obtain ⟨w₀, hw₀⟩ := hres
  have hv := hyτ _ hw₀
  rw [map_sub, AlgEquiv.commutes] at hv
  have h4 := y.sub_mem hv hw₀
  have e4 : τ xt - algebraMap A ↥(integralClosure A L) (algebraMap ↥W A w₀) -
      (xt - algebraMap A ↥(integralClosure A L) (algebraMap ↥W A w₀)) = rt * Θt := by
    rw [← hτx]; ring
  rw [e4] at h4
  have h5 : Tt * (rt * Θt) ∈ y := y.mul_mem_left Tt h4
  rw [← mul_assoc, hTrt] at h5
  have hεu : IsUnit (-(algebraMap A ↥(integralClosure A L) (algebraMap ↥W A ε₀))) :=
    (hε.map ((algebraMap A ↥(integralClosure A L)).comp (algebraMap ↥W A))).neg
  have hΘy : Θt ∈ y := (Ideal.unit_mul_mem_iff_mem y hεu).mp h5

  have hΘℓ : Θt ^ ℓ ∈ y := y.pow_mem_of_mem hΘy ℓ hℓpos
  have h6 : algebraMap A ↥(integralClosure A L) (d₁ ^ n₁) * Θt ^ ℓ =
      algebraMap A ↥(integralClosure A L) (D ^ ℓ * b₁) := Subtype.ext (by
    show algebraMap A L (d₁ ^ n₁) * (DL * θ') ^ ℓ = algebraMap A L (D ^ ℓ * b₁)
    rw [map_mul, map_pow, map_pow, hDLdef, ← hb₁, mul_pow, hθf]; ring)
  have h7 : algebraMap A ↥(integralClosure A L) (D ^ ℓ * b₁) ∈ y := by
    rw [← h6]; exact y.mul_mem_left _ hΘℓ
  have h8 : D ^ ℓ * b₁ ∈ y.comap (algebraMap A ↥(integralClosure A L)) := h7
  have hP : (y.comap (algebraMap A ↥(integralClosure A L))).IsPrime := h𝔭max.isPrime
  have hD : D ∉ y.comap (algebraMap A ↥(integralClosure A L)) := by
    rw [hDdef]; intro h; exact hd (hP.mem_of_pow_mem _ h)
  have hb₁m : b₁ ∈ y.comap (algebraMap A ↥(integralClosure A L)) := by
    rcases hP.mem_or_mem h8 with h | h
    · exact absurd (hP.mem_of_pow_mem _ h) hD
    · exact h
  have hbb : b₁ * b₂ = d₁ ^ (n₁ + n₂) := by
    apply hinj
    rw [map_mul, map_pow, ← hb₁, ← hb₂, pow_add, mul_mul_mul_comm, mul_inv_cancel₀ hF0, mul_one]
  have h9 : d₁ ^ (n₁ + n₂) ∈ y.comap (algebraMap A ↥(integralClosure A L)) := by
    rw [← hbb]; exact Ideal.mul_mem_right _ _ hb₁m
  exact hd₁ (hP.mem_of_pow_mem _ h9)

theorem wcLlsKP_vde_taylor : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → ∀ (x : K) (d : A), d ∉ 𝔭 →
      wcLlsKPLoc A K 0 d x → ∀ N : ℕ, ∃ (P : Polynomial ↥W) (d' : A) (y : K),
        d' ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d' y ∧
        x = P.eval₂ ((algebraMap A K).comp (algebraMap ↥W A))
            (algebraMap A K (t - algebraMap ↥W A c)) +
          algebraMap A K (t - algebraMap ↥W A c) ^ N * y :=
by
  classical
  intro Ω _ _ W A _ _ _ K _ _ _ 𝔭 t hPD c hc x d hd hx N
  obtain ⟨hFT, -, -, hmax, hmA, ht, -, h, hh, f, hfC, hfX, hfet⟩ := hPD
  have hP : 𝔭.IsPrime := hmax.isPrime
  have hmul : ∀ a b : A, a ∉ 𝔭 → b ∉ 𝔭 → a * b ∉ 𝔭 := fun a b ha hb hab =>
    (hP.mem_or_mem hab).elim ha hb
  have hpow : ∀ (a : A) (n : ℕ), a ∉ 𝔭 → a ^ n ∉ 𝔭 := fun a n ha hn =>
    ha (hP.mem_of_pow_mem n hn)
  have hm𝔭 : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → algebraMap ↥W A w ∈ 𝔭 :=
    fun w hw => hmA (Ideal.mem_map_of_mem _ hw)

  haveI hHW : HenselianLocalRing ↥W := by
    refine ⟨fun f hf a₀ h₁ _ => ?_⟩
    have h2 : W.valuation (algebraMap W Ω (f.eval a₀)) < 1 := (W.valuation_lt_one_iff _).mp h₁
    have hsplit := IsAlgClosed.splits (f.map (algebraMap W Ω))
    have h3 := Polynomial.Splits.aeval_eq_prod_aroots_of_monic hsplit hf (algebraMap W Ω a₀)
    rw [Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval] at h3
    rw [h3] at h2
    have h4 : ∃ α ∈ f.aroots Ω, W.valuation (algebraMap W Ω a₀ - α) < 1 := by
      by_contra hcon
      push_neg at hcon
      rw [map_multiset_prod, Multiset.map_map] at h2
      have : 1 ≤ ((f.aroots Ω).map (W.valuation ∘ fun α => algebraMap W Ω a₀ - α)).prod := by
        apply Multiset.one_le_prod
        intro x hx
        obtain ⟨α, hα, rfl⟩ := Multiset.mem_map.mp hx
        exact hcon α hα
      exact absurd h2 (not_lt.mpr this)
    obtain ⟨α, hα, hv⟩ := h4
    have hα' := (Polynomial.mem_aroots.mp hα).2
    have hint : _root_.IsIntegral W α := ⟨f, hf, by rwa [← Polynomial.aeval_def]⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    refine ⟨y, ?_, ?_⟩
    · show Polynomial.eval y f = 0
      apply FaithfulSMul.algebraMap_injective W Ω
      rw [map_zero, ← Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval, hy]
      exact hα'
    · rw [W.valuation_lt_one_iff]
      have e : ((y - a₀ : W) : Ω) = algebraMap W Ω y - algebraMap W Ω a₀ := by
        simp only [ValuationSubring.algebraMap_apply]; push_cast; rfl
      rw [e, hy, Valuation.map_sub_swap]
      exact hv

  have hres : ∀ a : A, ∃ w : ↥W, a - algebraMap ↥W A w ∈ 𝔭 := by
    intro a
    have T1 : IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
      apply IsAlgClosed.of_exists_root
      intro p hpmon hpirr
      have hlift : p ∈ Polynomial.lifts (IsLocalRing.residue ↥W) := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro n
        exact IsLocalRing.residue_surjective _
      obtain ⟨q, hqmap, hqdeg, hqmon⟩ :=
        Polynomial.lifts_and_natDegree_eq_and_monic hlift hpmon
      have hpdeg : 0 < p.natDegree := hpirr.natDegree_pos
      set j : ↥W →+* Ω := algebraMap ↥W Ω with hj
      have hQmon : (q.map j).Monic := hqmon.map j
      have hQdeg : (q.map j).natDegree = q.natDegree := hqmon.natDegree_map j
      have hQd : (q.map j).degree ≠ 0 := by
        rw [Polynomial.degree_eq_natDegree hQmon.ne_zero, hQdeg, hqdeg]
        exact_mod_cast hpdeg.ne'
      obtain ⟨z, hz⟩ := IsAlgClosed.exists_root (q.map j) hQd
      have hzint : _root_.IsIntegral ↥W z := by
        refine ⟨q, hqmon, ?_⟩
        rw [Polynomial.IsRoot, Polynomial.eval_map] at hz
        exact hz
      obtain ⟨y, hy⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hzint
      have hqy : q.eval y = 0 := by
        apply (IsFractionRing.injective ↥W Ω)
        rw [map_zero, ← Polynomial.eval_map_apply]
        rw [hy]
        exact hz
      refine ⟨IsLocalRing.residue ↥W y, ?_⟩
      rw [← hqmap, Polynomial.eval_map_apply, hqy, map_zero]
    have T2 : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
        [IsAlgClosed (IsLocalRing.ResidueField R)] (k : Type u) [Field k] (ρ : R →+* k),
        IsLocalHom ρ → ρ.FiniteType → Function.Surjective ρ := by
      intro R _ _ _ k _ ρ hloc hρFT
      set ψ := IsLocalRing.ResidueField.lift ρ with hψ
      have hψr : ψ.comp (IsLocalRing.residue R) = ρ :=
        IsLocalRing.ResidueField.lift_comp_residue ρ
      have hψFT : ψ.FiniteType := by
        rw [← hψr] at hρFT
        exact RingHom.FiniteType.of_comp_finiteType hρFT
      have hψfin : ψ.Finite := (RingHom.finite_iff_finiteType_of_isJacobsonRing).mpr hψFT
      have hψsurj : Function.Surjective ψ :=
        (IsAlgClosed.ringHom_bijective_of_isIntegral ψ hψfin.to_isIntegral).2
      rw [← hψr]
      exact hψsurj.comp (IsLocalRing.residue_surjective)
    have := hmax
    letI : Field (A ⧸ 𝔭) := Ideal.Quotient.field 𝔭
    let ρ : ↥W →+* A ⧸ 𝔭 := (Ideal.Quotient.mk 𝔭).comp (algebraMap ↥W A)
    have hloc : IsLocalHom ρ := by
      refine ⟨fun x hx => ?_⟩
      by_contra hxu
      have hxm : x ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal x).mpr hxu
      have h1 : algebraMap ↥W A x ∈ 𝔭 := hmA (Ideal.mem_map_of_mem _ hxm)
      have h2 : ρ x = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr h1
      rw [h2] at hx
      exact not_isUnit_zero hx
    have hρFT : ρ.FiniteType :=
      RingHom.FiniteType.comp_surjective (RingHom.finiteType_algebraMap.mpr hFT)
        Ideal.Quotient.mk_surjective
    obtain ⟨w, hw⟩ := T2 ↥W (A ⧸ 𝔭) ρ hloc hρFT (Ideal.Quotient.mk 𝔭 a)
    refine ⟨w, ?_⟩
    exact Ideal.Quotient.eq.mp hw.symm

  have hetale : ∀ (R : Type u) [CommRing R] [HenselianLocalRing R]
      (E : Type u) [CommRing E] [Algebra R E] [Algebra.Etale R E]
      (σ : E →ₐ[R] IsLocalRing.ResidueField R), ∃ τ : E →ₐ[R] R,
        ∀ x : E, IsLocalRing.residue R (τ x) = σ x := by
    intro R _ _ E _ _ _ σ
    haveI hq : (RingHom.ker σ).IsPrime := RingHom.ker_isPrime σ
    haveI : Algebra.FormallyEtale E (Localization.AtPrime (RingHom.ker σ)) :=
      Algebra.FormallyEtale.of_isLocalization (RingHom.ker σ).primeCompl
    haveI : Algebra.IsEtaleAt R (RingHom.ker σ) :=
      Algebra.FormallyEtale.comp R E (Localization.AtPrime (RingHom.ker σ))
    obtain ⟨g, hg, hstd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := R) (RingHom.ker σ)
    have hσg : IsUnit (σ g) := isUnit_iff_ne_zero.mpr (fun h => hg (RingHom.mem_ker.mpr h))
    let σg : Localization.Away g →ₐ[R] IsLocalRing.ResidueField R :=
      IsLocalization.Away.liftAlgHom g hσg
    have hσg_apply : ∀ y : E, σg (algebraMap E (Localization.Away g) y) = σ y := by
      intro y
      rw [IsLocalization.Away.liftAlgHom_apply, IsLocalization.Away.lift_eq]
      rfl
    obtain ⟨Q⟩ := hstd.nonempty_standardEtalePresentation
    let e : Q.Ring ≃ₐ[R] Localization.Away g :=
      AlgEquiv.ofBijective (Q.lift Q.x Q.hasMap) Q.lift_bijective
    have heX : e Q.X = Q.x := by
      rw [AlgEquiv.ofBijective_apply]
      exact Q.lift_X _ _
    set a₀ := σg Q.x with ha₀
    have hf0 : Polynomial.aeval a₀ Q.f = 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply, Q.hasMap.1, map_zero]
    have hf' : Polynomial.aeval a₀ (Polynomial.derivative Q.f) ≠ 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply]
      exact ((StandardEtalePair.HasMap.isUnit_derivative_f Q.P Q.hasMap).map σg).ne_zero
    have hg0 : Polynomial.aeval a₀ Q.g ≠ 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply]
      exact (Q.hasMap.2.map σg).ne_zero
    have hHen := ((HenselianLocalRing.TFAE R).out 1 2).mp (inferInstance : HenselianLocalRing R)
    obtain ⟨a, hroot, hres⟩ := hHen Q.f Q.monic_f a₀ hf0 hf'
    have hres' : ∀ p : Polynomial R,
        IsLocalRing.residue R (Polynomial.aeval a p) = Polynomial.aeval a₀ p := by
      intro p
      rw [← hres, ← IsLocalRing.ResidueField.algebraMap_eq, ← Algebra.ofId_apply,
        ← Algebra.ofId_apply, ← Polynomial.aeval_algHom_apply]
    have hHas : Q.HasMap a := by
      refine ⟨?_, ?_⟩
      · rw [Polynomial.coe_aeval_eq_eval]
        exact hroot
      · rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hres']
        exact hg0
    have hcomp : (Algebra.ofId R (IsLocalRing.ResidueField R)).comp (Q.lift a hHas) =
        σg.comp (e : Q.Ring →ₐ[R] Localization.Away g) := by
      apply StandardEtalePair.hom_ext
      rw [AlgHom.comp_apply, AlgHom.comp_apply, Q.lift_X, AlgEquiv.coe_toAlgHom, heX,
        Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq, hres]
    refine ⟨((Q.lift a hHas).comp (e.symm : Localization.Away g →ₐ[R] Q.Ring)).comp
      (IsScalarTower.toAlgHom R E (Localization.Away g)), fun y => ?_⟩
    have h1 := congrArg (fun φ => φ (e.symm (algebraMap E (Localization.Away g) y))) hcomp
    simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, AlgEquiv.apply_symm_apply,
      Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at h1
    rw [AlgHom.comp_apply, AlgHom.comp_apply, IsScalarTower.coe_toAlgHom',
      AlgEquiv.coe_toAlgHom, h1, hσg_apply]

  have hker : ∀ (R : Type u) [CommRing R] (E : Type u) [CommRing E] [Algebra R E]
      [Algebra.FormallyUnramified R E]
      [Algebra.FinitePresentation R E] (τ : E →ₐ[R] R),
      ∃ e : E, IsIdempotentElem e ∧ RingHom.ker τ = Ideal.span {e} := by
    intro R _ E _ _ _ _ τ
    have hsurj : Function.Surjective τ := fun r => ⟨algebraMap R E r, by simp⟩
    have hFG : (RingHom.ker τ).FG := by
      have := Algebra.FinitePresentation.ker_fG_of_surjective τ hsurj
      exact this
    have hsplit : ∀ x : E, x - algebraMap R E (τ x) ∈ RingHom.ker τ := by
      intro x
      rw [RingHom.mem_ker, map_sub, AlgHom.commutes]
      simp
    have hKK : RingHom.ker τ ≤ RingHom.ker τ ^ 2 := by
      have hN2 : IsNilpotent ((RingHom.ker τ).map (Ideal.Quotient.mk (RingHom.ker τ ^ 2))) := by
        refine ⟨2, ?_⟩
        rw [← Ideal.map_pow, Ideal.map_quotient_self]
        rfl
      let g₁ : E →ₐ[R] E ⧸ RingHom.ker τ ^ 2 := Ideal.Quotient.mkₐ R (RingHom.ker τ ^ 2)
      let g₂ : E →ₐ[R] E ⧸ RingHom.ker τ ^ 2 := (Algebra.ofId R (E ⧸ RingHom.ker τ ^ 2)).comp τ
      have hg : g₁ = g₂ := by
        apply Algebra.FormallyUnramified.ext _ hN2
        intro x
        rw [Ideal.Quotient.eq]
        have : g₁ x - g₂ x = Ideal.Quotient.mk (RingHom.ker τ ^ 2) (x - algebraMap R E (τ x)) := by
          show Ideal.Quotient.mkₐ R (RingHom.ker τ ^ 2) x -
            (Algebra.ofId R (E ⧸ RingHom.ker τ ^ 2)) (τ x) = _
          rw [map_sub, Ideal.Quotient.mk_algebraMap, Ideal.Quotient.mkₐ_eq_mk, Algebra.ofId_apply]
        rw [this]
        exact Ideal.mem_map_of_mem _ (hsplit x)
      intro x hx
      have h1 := congrArg (fun φ => φ x) hg
      simp only [g₁, g₂, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, Algebra.ofId_apply] at h1
      rw [RingHom.mem_ker.mp hx, map_zero] at h1
      exact Ideal.Quotient.eq_zero_iff_mem.mp h1
    have hidem : IsIdempotentElem (RingHom.ker τ) := by
      show RingHom.ker τ * RingHom.ker τ = RingHom.ker τ
      apply le_antisymm Ideal.mul_le_right
      rw [← pow_two]
      exact hKK
    obtain ⟨e, he, hKe⟩ := (Ideal.isIdempotentElem_iff_of_fg _ hFG).mp hidem
    exact ⟨e, he, hKe⟩

  have hstep : ∀ (R : Type u) [CommRing R] [HenselianLocalRing R] (B : Type u) [CommRing B]
      (φ : Polynomial R →+* B), φ.Etale → ∀ (c : R) (Q : Ideal B), Q.IsPrime →
      Q.comap (φ.comp Polynomial.C) = IsLocalRing.maximalIdeal R →
      φ Polynomial.X - φ (Polynomial.C c) ∈ Q → (∀ b : B, ∃ r : R, b - φ (Polynomial.C r) ∈ Q) →
      ∀ b : B, ∃ (r : R) (s b' : B), s ∉ Q ∧
        s * (b - φ (Polynomial.C r)) = (φ Polynomial.X - φ (Polynomial.C c)) * b' := by
    intro R _ _ B _ φ hφ c Q hQP hQ hx₀ hresB b
    letI : Algebra R B := (φ.comp Polynomial.C).toAlgebra
    set x₀ : B := φ Polynomial.X - φ (Polynomial.C c) with hx₀def
    have hquot : Algebra.Etale R (B ⧸ Ideal.span {x₀}) := by
      letI : Algebra (Polynomial R) B := φ.toAlgebra
      haveI hPB : Algebra.Etale (Polynomial R) B := RingHom.etale_algebraMap.mp hφ
      haveI : IsScalarTower R (Polynomial R) B := IsScalarTower.of_algebraMap_eq
        (fun r => by rw [Polynomial.algebraMap_eq]; rfl)
      have hXB : algebraMap (Polynomial R) B (Polynomial.X - Polynomial.C c) = x₀ := by
        rw [map_sub]; rfl
      haveI : Algebra.FinitePresentation R (Polynomial R) :=
        Algebra.FinitePresentation.polynomial R R
      haveI : Algebra.FinitePresentation R B :=
        Algebra.FinitePresentation.trans R (Polynomial R) B
      haveI : Algebra.FinitePresentation R (B ⧸ Ideal.span {x₀}) :=
        Algebra.FinitePresentation.quotient (Submodule.fg_span (Set.toFinite _))
      have hmk : Ideal.Quotient.mk (Ideal.span {x₀}) x₀ = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
      have upgrade : ∀ (T : Type u) [CommRing T] [Algebra R T] [Algebra (Polynomial R) T]
          [IsScalarTower R (Polynomial R) T],
          algebraMap (Polynomial R) T Polynomial.X = algebraMap R T c →
          ∀ ψ : B →ₐ[R] T, ψ x₀ = 0 →
          ∃ ψ' : B →ₐ[Polynomial R] T, ∀ b, ψ' b = ψ b := by
        intro T _ _ _ _ hT ψ h1
        have hψX : ψ (φ Polynomial.X) = algebraMap R T c := by
          have e1 : φ Polynomial.X = x₀ + algebraMap R B c := by
            rw [hx₀def]; exact (sub_add_cancel _ _).symm
          rw [e1, map_add, h1, zero_add, AlgHom.commutes]
        have hc : ψ.comp (IsScalarTower.toAlgHom R (Polynomial R) B) =
            IsScalarTower.toAlgHom R (Polynomial R) T := by
          apply Polynomial.algHom_ext
          rw [AlgHom.comp_apply, IsScalarTower.coe_toAlgHom', IsScalarTower.coe_toAlgHom', hT]
          exact hψX
        exact ⟨{ toRingHom := (ψ : B →+* T), commutes' := fun p => congrArg (fun f => f p) hc },
          fun b => rfl⟩
      haveI : Algebra.FormallyEtale R (B ⧸ Ideal.span {x₀}) := by
        rw [Algebra.FormallyEtale.iff_comp_bijective]
        intro A _ _ J hJ
        letI : Algebra (Polynomial R) A :=
          (Polynomial.aeval (algebraMap R A c)).toRingHom.toAlgebra
        haveI : IsScalarTower R (Polynomial R) A := IsScalarTower.of_algebraMap_eq
          (fun r => ((Polynomial.aeval (algebraMap R A c)).commutes r).symm)
        have hA : algebraMap (Polynomial R) A Polynomial.X = algebraMap R A c :=
          Polynomial.aeval_X (algebraMap R A c)
        have hAC : algebraMap (Polynomial R) A (Polynomial.X - Polynomial.C c) = 0 := by
          show Polynomial.aeval (algebraMap R A c) (Polynomial.X - Polynomial.C c) = 0
          simp
        have hAJ : algebraMap (Polynomial R) (A ⧸ J) Polynomial.X = algebraMap R (A ⧸ J) c := by
          rw [IsScalarTower.algebraMap_apply (Polynomial R) A (A ⧸ J), hA,
            ← IsScalarTower.algebraMap_apply]
        have hJn : IsNilpotent J := ⟨2, by rw [hJ]; rfl⟩
        refine ⟨fun G₁ G₂ hG => ?_, fun f => ?_⟩
        · obtain ⟨ψ₁, hψ₁⟩ := upgrade A hA (G₁.comp (Ideal.Quotient.mkₐ R _))
            (by rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, hmk, map_zero])
          obtain ⟨ψ₂, hψ₂⟩ := upgrade A hA (G₂.comp (Ideal.Quotient.mkₐ R _))
            (by rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, hmk, map_zero])
          have h12 : ψ₁ = ψ₂ := by
            apply Algebra.FormallyUnramified.ext J hJn
            intro b
            rw [hψ₁, hψ₂]
            have := congrArg (fun F => F (Ideal.Quotient.mk (Ideal.span {x₀}) b)) hG
            simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at this ⊢
            exact this
          ext y
          obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
          have := congrArg (fun F => F b) h12
          simp only [hψ₁, hψ₂, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at this
          exact this
        · obtain ⟨ψ, hψ⟩ := upgrade (A ⧸ J) hAJ (f.comp (Ideal.Quotient.mkₐ R _))
            (by rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, hmk, map_zero])
          let F₀ : B →ₐ[Polynomial R] A := Algebra.FormallySmooth.lift J hJn ψ
          have hF₀ : ∀ b, Ideal.Quotient.mk J (F₀ b) = ψ b :=
            Algebra.FormallySmooth.mk_lift J hJn ψ
          have hFx : ∀ y ∈ Ideal.span {x₀}, (F₀.restrictScalars R) y = 0 := by
            intro y hy
            have hle : Ideal.span {x₀} ≤ RingHom.ker (F₀.restrictScalars R) := by
              rw [Ideal.span_le, Set.singleton_subset_iff]
              show F₀ x₀ = 0
              rw [← hXB, F₀.commutes, hAC]
            exact hle hy
          refine ⟨Ideal.Quotient.liftₐ _ (F₀.restrictScalars R) hFx, ?_⟩
          ext y
          obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
          show Ideal.Quotient.mk J (F₀ b) = f (Ideal.Quotient.mk _ b)
          rw [hF₀, hψ]
          rfl
      exact ⟨inferInstance, inferInstance⟩
    haveI := hquot
    have hIQ : Ideal.span {x₀} ≤ Q := by
      rw [Ideal.span_le, Set.singleton_subset_iff]
      exact hx₀
    have hfs : Function.Surjective (Algebra.ofId R (B ⧸ Q)) := by
      intro y
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨r, hr⟩ := hresB b
      refine ⟨r, ?_⟩
      rw [Algebra.ofId_apply, ← Ideal.Quotient.mk_algebraMap]
      exact (Ideal.Quotient.eq.mpr hr).symm
    have hkf : IsLocalRing.maximalIdeal R = RingHom.ker (Algebra.ofId R (B ⧸ Q)) := by
      ext r
      rw [RingHom.mem_ker, Algebra.ofId_apply, ← Ideal.Quotient.mk_algebraMap,
        Ideal.Quotient.eq_zero_iff_mem, ← Ideal.mem_comap, ← hQ]
      rfl
    let eQ : IsLocalRing.ResidueField R ≃ₐ[R] B ⧸ Q :=
      (Ideal.quotientEquivAlgOfEq R hkf).trans (Ideal.quotientKerAlgEquivOfSurjective hfs)
    let σ₀ : B →ₐ[R] IsLocalRing.ResidueField R :=
      (eQ.symm : B ⧸ Q →ₐ[R] IsLocalRing.ResidueField R).comp (Ideal.Quotient.mkₐ R Q)
    have hσ₀ : ∀ b, σ₀ b = 0 ↔ b ∈ Q := by
      intro b
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      show eQ.symm (Ideal.Quotient.mk Q b) = 0 ↔ _
      exact map_eq_zero_iff _ eQ.symm.injective
    let σ : (B ⧸ Ideal.span {x₀}) →ₐ[R] IsLocalRing.ResidueField R :=
      Ideal.Quotient.liftₐ _ σ₀ (fun a ha => (hσ₀ a).mpr (hIQ ha))
    have hσmk : ∀ b, σ (Ideal.Quotient.mk _ b) = σ₀ b := fun b => rfl
    obtain ⟨τ, hτ⟩ := hetale R _ σ
    obtain ⟨e, he, hke⟩ := hker R _ τ
    obtain ⟨e', he'⟩ := Ideal.Quotient.mk_surjective e
    have hτe : τ e = 0 := by
      have : e ∈ RingHom.ker τ := by
        rw [hke]
        exact Ideal.mem_span_singleton_self e
      exact RingHom.mem_ker.mp this
    have he'Q : e' ∈ Q := by
      rw [← hσ₀, ← hσmk, he', ← hτ, hτe, map_zero]
    have hsQ : 1 - e' ∉ Q := by
      intro hmem
      apply hQP.ne_top
      rw [Ideal.eq_top_iff_one]
      have := Q.add_mem hmem he'Q
      rwa [sub_add_cancel] at this
    set r := τ (Ideal.Quotient.mk (Ideal.span {x₀}) b) with hr
    have hy : Ideal.Quotient.mk (Ideal.span {x₀}) (b - algebraMap R B r) ∈ RingHom.ker τ := by
      rw [RingHom.mem_ker, map_sub, Ideal.Quotient.mk_algebraMap, map_sub, AlgHom.commutes, hr]
      simp
    rw [hke] at hy
    obtain ⟨c', hc'⟩ := Ideal.mem_span_singleton'.mp hy
    have hmem : (1 - e') * (b - algebraMap R B r) ∈ Ideal.span {x₀} := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, map_sub, map_one, he', ← hc']
      have he2 : e * e = e := he
      calc (1 - e) * (c' * e) = c' * (e - e * e) := by ring
        _ = 0 := by rw [he2, sub_self, mul_zero]
    obtain ⟨b'', hb''⟩ := Ideal.mem_span_singleton'.mp hmem
    refine ⟨r, 1 - e', b'', hsQ, ?_⟩
    show (1 - e') * (b - algebraMap R B r) = x₀ * b''
    rw [← hb'', mul_comm]

  set ι := algebraMap A (Localization.Away h) with hι
  set Q : Ideal (Localization.Away h) := 𝔭.map ι with hQdef
  have hdisj : Disjoint (Submonoid.powers h : Set A) (𝔭 : Set A) :=
    (Ideal.disjoint_powers_iff_notMem h hP.isRadical).mpr hh
  have hQP : Q.IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) _ 𝔭 hP hdisj
  have hQcomap : Q.comap ι = 𝔭 :=
    IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers h) _ hP hdisj
  have hfCr : ∀ r : ↥W, f (Polynomial.C r) = ι (algebraMap ↥W A r) := fun r =>
    RingHom.congr_fun hfC r
  have hfx0 : f Polynomial.X - f (Polynomial.C c) = ι (t - algebraMap ↥W A c) := by
    rw [hfX, hfCr, map_sub]
  have hQW : Q.comap (f.comp Polynomial.C) = IsLocalRing.maximalIdeal ↥W := by
    rw [hfC, ← Ideal.comap_comap, hQcomap]
    ext w
    constructor
    · intro hw
      by_contra hnm
      have hu : IsUnit w := by
        by_contra hnu
        exact hnm ((IsLocalRing.mem_maximalIdeal w).mpr hnu)
      exact hP.ne_top (Ideal.eq_top_of_isUnit_mem _ hw (hu.map (algebraMap ↥W A)))
    · intro hw
      exact hm𝔭 w hw
  have hx0Q : f Polynomial.X - f (Polynomial.C c) ∈ Q := by
    rw [hfx0]
    exact Ideal.mem_map_of_mem _ (Ideal.sub_mem _ ht (hm𝔭 c hc))
  have hnotQ : ∀ a : A, a ∉ 𝔭 → ι a ∉ Q := by
    intro a ha hq
    apply ha
    rw [← hQcomap]
    exact hq
  have hresB : ∀ b : Localization.Away h, ∃ r : ↥W, b - f (Polynomial.C r) ∈ Q := by
    intro b
    obtain ⟨n, a, hb⟩ := IsLocalization.Away.surj h b
    obtain ⟨w₁, hw₁⟩ := hres h
    obtain ⟨w₂, hw₂⟩ := hres a
    have hw₁u : IsUnit w₁ := by
      by_contra hn
      apply hh
      have hm' : w₁ ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal w₁).mpr hn
      have := Ideal.add_mem _ hw₁ (hm𝔭 w₁ hm')
      rwa [sub_add_cancel] at this
    obtain ⟨v, hv⟩ := hw₁u.exists_right_inv
    refine ⟨w₂ * v ^ n, ?_⟩
    have hRW : algebraMap ↥W A (w₂ * v ^ n) * (algebraMap ↥W A w₁) ^ n = algebraMap ↥W A w₂ := by
      rw [← map_pow, ← map_mul]
      congr 1
      calc w₂ * v ^ n * w₁ ^ n = w₂ * (w₁ * v) ^ n := by ring
        _ = w₂ := by rw [hv, one_pow, mul_one]
    have hdiv : (algebraMap ↥W A w₁) ^ n - h ^ n ∈ 𝔭 := by
      obtain ⟨q, hq⟩ := sub_dvd_pow_sub_pow (algebraMap ↥W A w₁) h n
      rw [hq]
      apply Ideal.mul_mem_right
      rw [← neg_sub]
      exact 𝔭.neg_mem hw₁
    have hA' : a - algebraMap ↥W A (w₂ * v ^ n) * h ^ n ∈ 𝔭 := by
      have e1 : a - algebraMap ↥W A (w₂ * v ^ n) * h ^ n =
          (a - algebraMap ↥W A w₂) +
            algebraMap ↥W A (w₂ * v ^ n) * ((algebraMap ↥W A w₁) ^ n - h ^ n) := by
        linear_combination (-1 : A) * hRW
      rw [e1]
      exact Ideal.add_mem _ hw₂ (Ideal.mul_mem_left _ _ hdiv)
    have hprod : (b - f (Polynomial.C (w₂ * v ^ n))) * ι h ^ n =
        ι (a - algebraMap ↥W A (w₂ * v ^ n) * h ^ n) := by
      rw [hfCr, map_sub, ← hb]
      simp only [map_mul, map_pow]
      ring
    have hmemQ : (b - f (Polynomial.C (w₂ * v ^ n))) * ι h ^ n ∈ Q := by
      rw [hprod]
      exact Ideal.mem_map_of_mem _ hA'
    rcases hQP.mem_or_mem hmemQ with h1 | h1
    · exact h1
    · exfalso
      rw [← map_pow] at h1
      exact hnotQ _ (hpow h n hh) h1

  set u := t - algebraMap ↥W A c with hu_def
  have hu𝔭 : u ∈ 𝔭 := Ideal.sub_mem _ ht (hm𝔭 c hc)
  have hSTEP : ∀ a : A, ∃ (w : ↥W) (s a' : A), s ∉ 𝔭 ∧ s * (a - algebraMap ↥W A w) = u * a' := by
    intro a
    obtain ⟨r, s₀, b₀, hs₀, heq⟩ := hstep ↥W _ f hfet c Q hQP hQW hx0Q hresB (ι a)
    rw [hfCr, hfx0] at heq
    obtain ⟨i, s₁, hs₁⟩ := IsLocalization.Away.surj h s₀
    obtain ⟨j, b₁, hb₁⟩ := IsLocalization.Away.surj h b₀
    have hs₁𝔭 : s₁ ∉ 𝔭 := by
      intro hs
      have h1 : ι s₁ ∈ Q := Ideal.mem_map_of_mem _ hs
      rw [← hs₁] at h1
      rcases hQP.mem_or_mem h1 with h2 | h2
      · exact hs₀ h2
      · rw [← map_pow] at h2
        exact hnotQ _ (hpow h i hh) h2
    have hιeq : ι (s₁ * h ^ j * (a - algebraMap ↥W A r)) = ι (u * b₁ * h ^ i) := by
      rw [map_mul, map_mul, map_sub, map_pow, map_mul, map_mul, map_pow, ← hs₁, ← hb₁]
      linear_combination (ι h ^ i * ι h ^ j) * heq
    obtain ⟨⟨m, hm⟩, hcm⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers h) _).mp hιeq
    obtain ⟨k, rfl⟩ := Submonoid.mem_powers_iff _ _ |>.mp hm
    refine ⟨r, h ^ k * s₁ * h ^ j, h ^ k * b₁ * h ^ i, ?_, ?_⟩
    · exact hmul _ _ (hmul _ _ (hpow h k hh) hs₁𝔭) (hpow h j hh)
    · simp only at hcm
      linear_combination hcm

  have hLoc : ∀ (d₀ : A) (y : K), wcLlsKPLoc A K 0 d₀ y ↔
      ∃ (n : ℕ) (a : A), algebraMap A K d₀ ^ n * y = algebraMap A K a := by
    intro d₀ y
    simp only [wcLlsKPLoc, Algebra.adjoin_singleton_zero, Algebra.mem_bot, Set.mem_range]
    exact exists_congr fun n => ⟨fun ⟨a, ha⟩ => ⟨a, ha.symm⟩, fun ⟨a, ha⟩ => ⟨a, ha.symm⟩⟩
  have hinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hne : ∀ a : A, a ∉ 𝔭 → algebraMap A K a ≠ 0 := by
    intro a ha h0
    apply ha
    rw [← map_zero (algebraMap A K)] at h0
    rw [hinj h0]
    exact 𝔭.zero_mem

  induction N with
  | zero => exact ⟨0, d, x, hd, hx, by simp⟩
  | succ N ih =>
    obtain ⟨P, d', y, hd', hy, hxeq⟩ := ih
    obtain ⟨n, a, hya⟩ := (hLoc d' y).mp hy
    have he : d' ^ n ∉ 𝔭 := hpow d' n hd'
    have hya' : algebraMap A K (d' ^ n) * y = algebraMap A K a := by
      rw [map_pow]; exact hya
    obtain ⟨wa, s₁, a₁, hs₁, h1⟩ := hSTEP a
    obtain ⟨we, s₂, e₁, hs₂, h2⟩ := hSTEP (d' ^ n)
    have hweu : IsUnit we := by
      by_contra hn
      have hm' : we ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal we).mpr hn
      apply hmul s₂ (d' ^ n) hs₂ he
      have e1 : s₂ * d' ^ n = s₂ * (d' ^ n - algebraMap ↥W A we) + s₂ * algebraMap ↥W A we := by
        ring
      rw [e1, h2]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hu𝔭) (Ideal.mul_mem_left _ _ (hm𝔭 we hm'))
    obtain ⟨v, hv⟩ := hweu.exists_right_inv
    have hww : algebraMap ↥W A (wa * v) * algebraMap ↥W A we = algebraMap ↥W A wa := by
      rw [← map_mul]
      congr 1
      calc wa * v * we = wa * (we * v) := by ring
        _ = wa := by rw [hv, mul_one]
    have hkey : s₁ * s₂ * (a - algebraMap ↥W A (wa * v) * d' ^ n) =
        u * (s₂ * a₁ - algebraMap ↥W A (wa * v) * s₁ * e₁) := by
      linear_combination s₂ * h1 - algebraMap ↥W A (wa * v) * s₁ * h2 - s₁ * s₂ * hww
    have hd'' : s₁ * s₂ * d' ^ n ∉ 𝔭 := hmul _ _ (hmul _ _ hs₁ hs₂) he
    have hd''K := hne _ hd''
    refine ⟨P + Polynomial.C (wa * v) * Polynomial.X ^ N, s₁ * s₂ * d' ^ n,
      algebraMap A K (s₂ * a₁ - algebraMap ↥W A (wa * v) * s₁ * e₁) /
        algebraMap A K (s₁ * s₂ * d' ^ n), hd'', ?_, ?_⟩
    · refine (hLoc _ _).mpr ⟨1, s₂ * a₁ - algebraMap ↥W A (wa * v) * s₁ * e₁, ?_⟩
      rw [pow_one]
      field_simp
    · have hy' : y = algebraMap A K (algebraMap ↥W A (wa * v)) + algebraMap A K u *
          (algebraMap A K (s₂ * a₁ - algebraMap ↥W A (wa * v) * s₁ * e₁) /
            algebraMap A K (s₁ * s₂ * d' ^ n)) := by
        apply mul_left_cancel₀ hd''K
        have hL : algebraMap A K (s₁ * s₂ * d' ^ n) * y = algebraMap A K (s₁ * s₂ * a) := by
          rw [map_mul, mul_assoc, hya', ← map_mul]
        have hc' : algebraMap A K (s₁ * s₂ * d' ^ n) *
            (algebraMap A K (s₂ * a₁ - algebraMap ↥W A (wa * v) * s₁ * e₁) /
              algebraMap A K (s₁ * s₂ * d' ^ n)) =
            algebraMap A K (s₂ * a₁ - algebraMap ↥W A (wa * v) * s₁ * e₁) := by
          field_simp
        rw [hL, mul_add, mul_left_comm, hc', ← map_mul, ← map_mul, ← map_add]
        congr 1
        linear_combination hkey
      rw [hxeq, hy']
      simp only [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C,
        Polynomial.eval₂_X_pow, RingHom.comp_apply]
      ring

theorem wcLlsKP_nfb_archimedean : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ β x : ↥W, β ∈ IsLocalRing.maximalIdeal ↥W → x ≠ 0 →
      ∃ (N : ℕ) (π : ↥W), π ∈ IsLocalRing.maximalIdeal ↥W ∧ β ^ N = x * π :=
by
  intro Ω _ W hW β x hβ hx
  by_cases hβ0 : β = 0
  · exact ⟨1, 0, Ideal.zero_mem _, by rw [hβ0, pow_one, mul_zero]⟩
  haveI hdim : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
  have hmax : ∀ I : Ideal ↥W, I ≠ ⊥ → I.IsPrime → I.IsMaximal :=
    Ring.krullDimLE_one_iff_of_isPrime_bot.mp hdim
  have hy : x * β ≠ 0 := mul_ne_zero hx hβ0
  have hrad : β ∈ (Ideal.span {x * β}).radical := by
    rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
    rintro J ⟨hJle, hJp⟩
    have hyJ : x * β ∈ J := (Ideal.span_singleton_le_iff_mem J).mp hJle
    have hJne : J ≠ ⊥ := by
      intro h
      rw [h, Ideal.mem_bot] at hyJ
      exact hy hyJ
    rw [IsLocalRing.eq_maximalIdeal (hmax J hJne hJp)]
    exact hβ
  obtain ⟨n, hn⟩ := (Ideal.mem_radical_iff).mp hrad
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp hn
  refine ⟨n, β * r, Ideal.mul_mem_right r _ hβ, ?_⟩
  rw [← hr]
  ring

theorem wcLlsKP_bau_content : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (x : K) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d x → x ≠ 0 →
      ∃ (π : ↥W) (x' : K) (d' : A), π ≠ 0 ∧ d' ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d' x' ∧
        x = algebraMap A K (algebraMap ↥W A π) * x' ∧
        ∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' x' :=
by
  intro Ω _ _ W hW _hWt A _ _ _ K _ _ _ 𝔭 t hPD x d hd hx hx0
  obtain ⟨_, _, _, hMax, hm𝔭, _ht𝔭, hPeq, h, hh, f, hfC, hfX, hfEt⟩ := hPD
  haveI hPrime : 𝔭.IsPrime := hMax.isPrime
  have T5 : ∀ a b : A, a ∉ 𝔭 → b ∉ 𝔭 → a * b ∉ 𝔭 := fun a b ha hb hab =>
    (hPrime.mem_or_mem hab).elim ha hb
  have TP : ∀ (a : A) (n : ℕ), a ∉ 𝔭 → a ^ n ∉ 𝔭 := fun a n ha hc =>
    ha (hPrime.mem_of_pow_mem n hc)
  have hpc : ∀ σ : 𝔭.primeCompl, (σ : A) ∉ 𝔭 := fun σ => σ.2

  have nzd : ∀ (R : Type u) [CommRing R] (ι : ↥W →+* R) (τ : R) (a : ↥W), a ≠ 0 →
      (∀ z : R, τ * z ∈ Ideal.span {ι a} → z ∈ Ideal.span {ι a}) →
      ∀ (k : ℕ) (u : R) (π : ↥W) (e y : R), IsUnit u → π ∈ IsLocalRing.maximalIdeal ↥W →
      (u * τ ^ k + ι π * e) * y ∈ Ideal.span {ι a} → y ∈ Ideal.span {ι a} := by
    intro R _ ι τ a ha hτ k u π e y hu hπ hy
    obtain ⟨N, π₁, -, hN⟩ := wcLlsKP_nfb_archimedean Ω W hW π a hπ ha
    have key : ∀ n : ℕ, (u * τ ^ k) ^ n * y - (-(ι π * e)) ^ n * y ∈ Ideal.span {ι a} := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        have e1 : (u * τ ^ k) ^ (n + 1) * y - (-(ι π * e)) ^ (n + 1) * y =
            (u * τ ^ k) * ((u * τ ^ k) ^ n * y - (-(ι π * e)) ^ n * y) +
              (-(ι π * e)) ^ n * ((u * τ ^ k + ι π * e) * y) := by ring
        rw [e1]
        exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ ih) (Ideal.mul_mem_left _ _ hy)
    have hεN : (-(ι π * e)) ^ N * y ∈ Ideal.span {ι a} := by
      have e2 : (-(ι π * e)) ^ N * y = ι a * ((-1) ^ N * ι π₁ * e ^ N * y) := by
        rw [neg_pow, mul_pow, ← map_pow, hN, map_mul]; ring
      rw [e2]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
    have h1 : (u * τ ^ k) ^ N * y ∈ Ideal.span {ι a} := by
      have h3 := Ideal.add_mem _ (key N) hεN
      rwa [sub_add_cancel] at h3
    obtain ⟨v, hv⟩ := hu.exists_left_inv
    have h2 : τ ^ (k * N) * y ∈ Ideal.span {ι a} := by
      have e3 : τ ^ (k * N) * y = v ^ N * ((u * τ ^ k) ^ N * y) := by
        calc τ ^ (k * N) * y = (v * u) ^ N * τ ^ (k * N) * y := by rw [hv]; ring
          _ = v ^ N * ((u * τ ^ k) ^ N * y) := by ring
      rw [e3]
      exact Ideal.mul_mem_left _ _ h1
    have h4 : ∀ m : ℕ, τ ^ m * y ∈ Ideal.span {ι a} → y ∈ Ideal.span {ι a} := by
      intro m
      induction m with
      | zero => intro hm; simpa using hm
      | succ m ih =>
        intro hm
        apply ih
        apply hτ
        rw [← mul_assoc, ← pow_succ']
        exact hm
    exact h4 _ h2

  have polyCore : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R] (g : ↥W →+* R) (ϖ : R),
      (∀ c ∈ IsLocalRing.maximalIdeal ↥W, g c = 0) → ϖ ≠ 0 → ϖ ∈ IsLocalRing.maximalIdeal R →
      ∀ (n : ℕ) (P : Polynomial ↥W), P.eval₂ g ϖ = 0 → P.coeff n ∈ IsLocalRing.maximalIdeal ↥W := by
    intro R _ _ _ g ϖ hg hϖ0 hϖm
    have hdec : ∀ P : Polynomial ↥W, P.eval₂ g ϖ = P.divX.eval₂ g ϖ * ϖ + g (P.coeff 0) := by
      intro P
      conv_lhs => rw [← Polynomial.divX_mul_X_add P]
      rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X, Polynomial.eval₂_C]
    have h0 : ∀ P : Polynomial ↥W, P.eval₂ g ϖ = 0 → P.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W := by
      intro P hP
      by_contra hc
      have hu : IsUnit (g (P.coeff 0)) := (IsLocalRing.notMem_maximalIdeal.mp hc).map g
      have hmem : g (P.coeff 0) ∈ IsLocalRing.maximalIdeal R := by
        have e1 : g (P.coeff 0) = -(P.divX.eval₂ g ϖ * ϖ) := by
          rw [hdec P] at hP; linear_combination hP
        rw [e1]
        exact neg_mem (Ideal.mul_mem_left _ _ hϖm)
      exact (IsLocalRing.notMem_maximalIdeal.mpr hu) hmem
    intro n
    induction n with
    | zero => exact h0
    | succ n ih =>
      intro P hP
      have hc0 := h0 P hP
      rw [hdec P, hg _ hc0, add_zero] at hP
      have hdiv : P.divX.eval₂ g ϖ = 0 := (mul_eq_zero.mp hP).resolve_right hϖ0
      rw [← Polynomial.coeff_divX]
      exact ih _ hdiv

  have hPmap : 𝔭.map (algebraMap A (Localization.Away h)) =
      (Ideal.span {t} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
        (algebraMap A (Localization.Away h)) := congrArg _ hPeq
  obtain ⟨instD, hdvr, hirr⟩ :=
    wcLlsKP_ed_chart_special_dvr Ω W A 𝔭 t h f hm𝔭 hh hPmap hfC hfX hfEt
  haveI := instD
  haveI := hdvr
  set ιB : ↥W →+* Localization.AtPrime 𝔭 :=
    (algebraMap A (Localization.AtPrime 𝔭)).comp (algebraMap ↥W A) with hιB
  set mB : Ideal (Localization.AtPrime 𝔭) :=
    ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
      (algebraMap A (Localization.AtPrime 𝔭)) with hmBdef
  have hprime : mB.IsPrime := (Ideal.Quotient.isDomain_iff_prime mB).mp instD
  haveI := hprime
  have hmBtop : mB ≠ ⊤ := hprime.ne_top
  have hmBmax : mB ≤ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) :=
    IsLocalRing.le_maximalIdeal hmBtop
  have hle : 𝔭.primeCompl ≤ nonZeroDivisors A :=
    le_nonZeroDivisors_of_noZeroDivisors (fun h0 => h0 𝔭.zero_mem)
  have hunit : ∀ σ : A, σ ∉ 𝔭 → IsUnit (algebraMap A (Localization.AtPrime 𝔭) σ) :=
    fun σ hσ => IsLocalization.map_units (Localization.AtPrime 𝔭) (⟨σ, hσ⟩ : 𝔭.primeCompl)
  have hιm : ∀ c ∈ IsLocalRing.maximalIdeal ↥W, ιB c ∈ mB := fun c hc =>
    Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hc)
  have hmBmap : mB = Ideal.map ιB (IsLocalRing.maximalIdeal ↥W) := Ideal.map_map _ _

  have hϖ0 : Ideal.Quotient.mk mB (algebraMap A (Localization.AtPrime 𝔭) t) ≠ 0 := hirr.ne_zero
  have hϖm : Ideal.Quotient.mk mB (algebraMap A (Localization.AtPrime 𝔭) t) ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭 ⧸ mB) :=
    (IsLocalRing.mem_maximalIdeal _).mpr hirr.not_isUnit
  have hPF : ∀ P : Polynomial ↥W, P.eval₂ ιB (algebraMap A (Localization.AtPrime 𝔭) t) ∈ mB →
      ∀ n, P.coeff n ∈ IsLocalRing.maximalIdeal ↥W := by
    intro P hP n
    apply polyCore (Localization.AtPrime 𝔭 ⧸ mB) ((Ideal.Quotient.mk mB).comp ιB) _
      (fun c hc => by
        rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]; exact hιm c hc) hϖ0 hϖm n P
    rw [← Polynomial.hom_eval₂, Ideal.Quotient.eq_zero_iff_mem]; exact hP

  have rep : ∀ z ∈ mB, ∃ π ∈ IsLocalRing.maximalIdeal ↥W, ∃ e, z = ιB π * e := by
    intro z hz
    rw [hmBmap] at hz
    change z ∈ Submodule.span (Localization.AtPrime 𝔭)
      (⇑ιB '' (IsLocalRing.maximalIdeal ↥W : Set ↥W)) at hz
    induction hz using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨π, hπ, rfl⟩ := hy
      exact ⟨π, hπ, 1, by ring⟩
    | zero => exact ⟨0, Ideal.zero_mem _, 0, by simp⟩
    | add y₁ y₂ _ _ h₁ h₂ =>
      obtain ⟨π₁, hπ₁, e₁, rfl⟩ := h₁
      obtain ⟨π₂, hπ₂, e₂, rfl⟩ := h₂
      rcases ValuationRing.dvd_total π₁ π₂ with ⟨c, rfl⟩ | ⟨c, rfl⟩
      · exact ⟨π₁, hπ₁, e₁ + ιB c * e₂, by rw [map_mul]; ring⟩
      · exact ⟨π₂, hπ₂, ιB c * e₁ + e₂, by rw [map_mul]; ring⟩
    | smul r y _ hy =>
      obtain ⟨π, hπ, e, rfl⟩ := hy
      exact ⟨π, hπ, r * e, by rw [smul_eq_mul]; ring⟩

  have decomp : ∀ s, s ∉ mB → ∃ (k : ℕ) (u : Localization.AtPrime 𝔭) (π : ↥W)
      (e : Localization.AtPrime 𝔭), IsUnit u ∧ π ∈ IsLocalRing.maximalIdeal ↥W ∧
      s = u * algebraMap A (Localization.AtPrime 𝔭) t ^ k + ιB π * e := by
    intro s hs
    have hs0 : Ideal.Quotient.mk mB s ≠ 0 := fun h0 => hs (Ideal.Quotient.eq_zero_iff_mem.mp h0)
    obtain ⟨k, ū, hk⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hs0 hirr
    obtain ⟨u, hu⟩ := Ideal.Quotient.mk_surjective (ū : Localization.AtPrime 𝔭 ⧸ mB)
    have huU : IsUnit u := by
      by_contra hnu
      have hum : u ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) :=
        (IsLocalRing.mem_maximalIdeal _).mpr hnu
      obtain ⟨v, hv⟩ := Ideal.Quotient.mk_surjective ((ū⁻¹ : (Localization.AtPrime 𝔭 ⧸ mB)ˣ) :
        Localization.AtPrime 𝔭 ⧸ mB)
      have h1 : u * v - 1 ∈ mB := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, map_one, hu, hv, Units.mul_inv,
          sub_self]
      have h2 : (1 : Localization.AtPrime 𝔭) ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) := by
        have h3 := Ideal.sub_mem _ (Ideal.mul_mem_right v _ hum) (hmBmax h1)
        rwa [sub_sub_cancel] at h3
      exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top
        (Ideal.eq_top_of_isUnit_mem _ h2 isUnit_one)
    have hε : s - u * algebraMap A (Localization.AtPrime 𝔭) t ^ k ∈ mB := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, map_pow, hu, ← hk, sub_self]
    obtain ⟨π, hπ, e, he⟩ := rep _ hε
    exact ⟨k, u, π, e, huU, hπ, by rw [← he]; ring⟩

  have hh0 : h ≠ 0 := fun h0 => hh (h0 ▸ 𝔭.zero_mem)
  haveI : IsDomain (Localization.Away h) :=
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
  have hfC' : f.comp Polynomial.C = algebraMap ↥W (Localization.Away h) := by
    rw [hfC, IsScalarTower.algebraMap_eq ↥W A (Localization.Away h)]
  set lam : Localization.Away h →+* Localization.AtPrime 𝔭 :=
    IsLocalization.Away.lift h (hunit h hh) with hlam
  have hlamA : ∀ y : A, lam (algebraMap A (Localization.Away h) y) =
      algebraMap A (Localization.AtPrime 𝔭) y := fun y =>
    IsLocalization.Away.lift_eq h (hunit h hh) y
  have hlamW : ∀ w : ↥W, lam (algebraMap ↥W (Localization.Away h) w) = ιB w := by
    intro w
    rw [IsScalarTower.algebraMap_apply ↥W A (Localization.Away h), hlamA]
    rfl
  have treg : ∀ a : ↥W, a ≠ 0 → ∀ z : Localization.AtPrime 𝔭,
      algebraMap A (Localization.AtPrime 𝔭) t * z ∈ Ideal.span {ιB a} →
      z ∈ Ideal.span {ιB a} := by
    intro a ha z hz
    obtain ⟨-, hR⟩ := wcpa_dj_llsm_brrc_regular_pair Ω W (Localization.Away h) f 0 a hfEt hfC' ha
    obtain ⟨pz, hzσ⟩ := IsLocalization.surj 𝔭.primeCompl z
    obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hz
    obtain ⟨pw, hwσ⟩ := IsLocalization.surj 𝔭.primeCompl w
    have hιa : ιB a = algebraMap A (Localization.AtPrime 𝔭) (algebraMap ↥W A a) := rfl
    rw [hιa] at hw
    have hA : algebraMap A (Localization.AtPrime 𝔭) (t * pz.1 * (pw.2 : A)) =
        algebraMap A (Localization.AtPrime 𝔭) (algebraMap ↥W A a * pw.1 * (pz.2 : A)) := by
      simp only [map_mul]
      rw [← hzσ, ← hwσ]
      linear_combination (-(algebraMap A (Localization.AtPrime 𝔭) (pz.2 : A) *
        algebraMap A (Localization.AtPrime 𝔭) (pw.2 : A))) * hw
    obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists 𝔭.primeCompl (Localization.AtPrime 𝔭)).mp hA
    have hAh : (f Polynomial.X - algebraMap ↥W (Localization.Away h) 0) *
        algebraMap A (Localization.Away h) ((c : A) * pz.1 * (pw.2 : A)) ∈
        Ideal.span {algebraMap ↥W (Localization.Away h) a} := by
      rw [map_zero, sub_zero, hfX, ← map_mul]
      have e : t * ((c : A) * pz.1 * (pw.2 : A)) = algebraMap ↥W A a * ((c : A) * pw.1 * (pz.2 : A)) := by
        linear_combination hc
      rw [e, map_mul, ← IsScalarTower.algebraMap_apply ↥W A (Localization.Away h)]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
    obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp (hR _ hAh)
    have hB1 : z * algebraMap A (Localization.AtPrime 𝔭) ((c : A) * (pz.2 : A) * (pw.2 : A)) =
        lam g * ιB a := by
      rw [← hlamW, ← map_mul lam, hg, hlamA]
      simp only [map_mul]
      rw [← hzσ]
      ring
    have hu : IsUnit (algebraMap A (Localization.AtPrime 𝔭) ((c : A) * (pz.2 : A) * (pw.2 : A))) :=
      hunit _ (T5 _ _ (T5 _ _ (hpc c) (hpc pz.2)) (hpc pw.2))
    rw [← Ideal.mul_unit_mem_iff_mem _ hu, hB1]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)

  letI algP : Algebra (Polynomial ↥W) (Localization.Away h) := f.toAlgebra
  haveI : Algebra.Etale (Polynomial ↥W) (Localization.Away h) := hfEt
  have hlamf : lam.comp f = Polynomial.eval₂RingHom ιB (algebraMap A (Localization.AtPrime 𝔭) t) := by
    apply Polynomial.ringHom_ext
    · intro w
      rw [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      have e : f (Polynomial.C w) = algebraMap A (Localization.Away h) (algebraMap ↥W A w) := by
        rw [← RingHom.comp_apply f Polynomial.C, hfC, RingHom.comp_apply]
      rw [e, hlamA]
      rfl
    · rw [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, hfX, hlamA]
  haveI hqP : (Ideal.comap lam mB).IsPrime := Ideal.comap_isPrime lam mB
  have hq : Ideal.comap (algebraMap (Polynomial ↥W) (Localization.Away h)) (Ideal.comap lam mB) =
      Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) := by
    rw [Ideal.comap_comap]
    have e : lam.comp (algebraMap (Polynomial ↥W) (Localization.Away h)) = lam.comp f := rfl
    rw [e, hlamf]
    ext P
    rw [Ideal.mem_comap, Polynomial.coe_eval₂RingHom, Ideal.mem_map_C_iff]
    constructor
    · exact hPF P
    · intro hc
      rw [Polynomial.eval₂_eq_sum, Polynomial.sum_def]
      exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_right _ _ (hιm _ (hc i)))

  have content : ∀ b : Localization.AtPrime 𝔭, b ≠ 0 →
      ∃ a : ↥W, a ≠ 0 ∧ ∃ b' : Localization.AtPrime 𝔭, b' ∉ mB ∧ b = ιB a * b' := by
    intro b hb
    obtain ⟨pb, hbσ⟩ := IsLocalization.surj 𝔭.primeCompl b
    obtain ⟨a, s₁', s₂', hs₁', hs₂', hG⟩ := wcpa_dj_lr1k_ebc_dlc_etale_gauss Ω W
      (Localization.Away h) (Ideal.comap lam mB) hqP hq (algebraMap A (Localization.Away h) pb.1)
    have e2 : lam (algebraMap (Polynomial ↥W) (Localization.Away h) (Polynomial.C a)) = ιB a := by
      show (lam.comp f) (Polynomial.C a) = ιB a
      rw [hlamf, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
    have hG' : b * (algebraMap A (Localization.AtPrime 𝔭) (pb.2 : A) * lam s₂') = ιB a * lam s₁' := by
      have h1 := congrArg lam hG
      rw [map_mul, map_mul, hlamA, e2, ← hbσ] at h1
      rw [← h1]; ring
    have hs₂m : algebraMap A (Localization.AtPrime 𝔭) (pb.2 : A) * lam s₂' ∉ mB := by
      intro hm
      rcases hprime.mem_or_mem hm with h1 | h1
      · exact hmBtop (Ideal.eq_top_of_isUnit_mem _ h1 (hunit _ (hpc pb.2)))
      · exact hs₂' h1
    have hs₁m : lam s₁' ∉ mB := hs₁'
    obtain ⟨k, u, π, e, hu, hπ, hdec⟩ := decomp _ hs₂m
    have hιa0 : ιB a ≠ 0 := by
      intro h0
      rw [h0, zero_mul] at hG'
      rcases mul_eq_zero.mp hG' with h1 | h1
      · exact hb h1
      · exact hs₂m (by rw [h1]; exact Ideal.zero_mem _)
    have ha0 : a ≠ 0 := by
      rintro rfl
      exact hιa0 (map_zero _)
    have hbmem : b ∈ Ideal.span {ιB a} := by
      apply nzd _ ιB (algebraMap A (Localization.AtPrime 𝔭) t) a ha0 (treg a ha0) k u π e b hu hπ
      rw [← hdec, mul_comm _ b, hG']
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
    obtain ⟨b', hb'⟩ := Ideal.mem_span_singleton'.mp hbmem
    refine ⟨a, ha0, b', ?_, by rw [← hb', mul_comm]⟩
    intro hb'm
    apply hs₁m
    have h1 : ιB a * (b' * (algebraMap A (Localization.AtPrime 𝔭) (pb.2 : A) * lam s₂')) =
        ιB a * lam s₁' := by
      rw [← hG', ← hb']; ring
    rw [← mul_left_cancel₀ hιa0 h1]
    exact Ideal.mul_mem_right _ _ hb'm

  have T0 : ∀ (d : A) (x : K), wcLlsKPLoc A K 0 d x ↔
      ∃ (n : ℕ) (a : A), algebraMap A K a = algebraMap A K d ^ n * x := by
    intro d x
    have hbot : Algebra.adjoin A ({0} : Set K) = ⊥ := by
      apply le_antisymm
      · rw [Algebra.adjoin_le_iff]
        intro z hz
        rw [Set.mem_singleton_iff.mp hz]
        exact Subalgebra.zero_mem _
      · exact bot_le
    unfold wcLlsKPLoc
    rw [hbot]
    constructor
    · rintro ⟨n, hn⟩
      obtain ⟨a, ha⟩ := Algebra.mem_bot.mp hn
      exact ⟨n, a, ha⟩
    · rintro ⟨n, a, ha⟩
      exact ⟨n, Algebra.mem_bot.mpr ⟨a, ha⟩⟩
  have hσK : ∀ σ : 𝔭.primeCompl, algebraMap A K (σ : A) ≠ 0 := by
    intro σ h0
    apply hpc σ
    rw [IsFractionRing.injective A K (h0.trans (map_zero _).symm)]
    exact 𝔭.zero_mem
  have hgK : ∀ y : 𝔭.primeCompl, IsUnit (algebraMap A K (y : A)) := fun y => (hσK y).isUnit
  set j : Localization.AtPrime 𝔭 →+* K := IsLocalization.lift hgK with hj
  have hjA : ∀ y : A, j (algebraMap A (Localization.AtPrime 𝔭) y) = algebraMap A K y :=
    IsLocalization.lift_eq hgK
  have hjinj : Function.Injective j := by
    rw [hj, IsLocalization.lift_injective_iff]
    intro y z
    rw [(IsLocalization.injective (Localization.AtPrime 𝔭) hle).eq_iff,
      (IsFractionRing.injective A K).eq_iff]
  have hjmk : ∀ (e : A) (σ : 𝔭.primeCompl) (y : K), algebraMap A K e = algebraMap A K (σ : A) * y →
      j (IsLocalization.mk' (Localization.AtPrime 𝔭) e σ) = y := by
    intro e σ y he
    have h1 : j (IsLocalization.mk' (Localization.AtPrime 𝔭) e σ) * algebraMap A K (σ : A) =
        algebraMap A K e := by
      rw [← hjA, ← map_mul, IsLocalization.mk'_spec, hjA]
    exact mul_right_cancel₀ (hσK σ) (h1.trans (he.trans (mul_comm _ _)))
  obtain ⟨n, a₀, ha₀⟩ := (T0 d x).mp hx
  have hjb : j (IsLocalization.mk' (Localization.AtPrime 𝔭) a₀
      (⟨d ^ n, TP d n hd⟩ : 𝔭.primeCompl)) = x :=
    hjmk _ _ _ (by show _ = algebraMap A K (d ^ n) * x; rw [ha₀, map_pow])
  have hb0 : IsLocalization.mk' (Localization.AtPrime 𝔭) a₀
      (⟨d ^ n, TP d n hd⟩ : 𝔭.primeCompl) ≠ 0 := by
    intro h0
    apply hx0
    rw [← hjb, h0, map_zero]
  obtain ⟨a, ha0, b', hb'm, hbb'⟩ := content _ hb0
  obtain ⟨pb', hσ'⟩ := IsLocalization.surj 𝔭.primeCompl b'
  refine ⟨a, j b', (pb'.2 : A), ha0, hpc pb'.2, ?_, ?_, ?_⟩
  · refine (T0 _ _).mpr ⟨1, pb'.1, ?_⟩
    rw [pow_one, ← hjA, ← hσ', map_mul, hjA, mul_comm]
  · rw [← hjb, hbb', map_mul]
    exact congrArg (· * j b') (hjA (algebraMap ↥W A a))
  · rintro d'' hd'' ⟨π', hπ', x'', hx'', hxx⟩
    obtain ⟨k, e, he⟩ := (T0 d'' x'').mp hx''
    have hc : j (IsLocalization.mk' (Localization.AtPrime 𝔭) e
        (⟨d'' ^ k, TP d'' k hd''⟩ : 𝔭.primeCompl)) = x'' :=
      hjmk _ _ _ (by show _ = algebraMap A K (d'' ^ k) * x''; rw [he, map_pow])
    apply hb'm
    have hb'eq : b' = ιB π' * IsLocalization.mk' (Localization.AtPrime 𝔭) e
        (⟨d'' ^ k, TP d'' k hd''⟩ : 𝔭.primeCompl) := by
      apply hjinj
      rw [hxx, map_mul, hc]
      exact congrArg (· * x'') (hjA (algebraMap ↥W A π')).symm
    rw [hb'eq]
    exact Ideal.mul_mem_right _ _ (hιm _ hπ')

theorem wcLlsKP_bau_deriv : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∃ (h : A) (D : K → K), h ∉ 𝔭 ∧ (∀ x y, D (x + y) = D x + D y) ∧
      (∀ x y, D (x * y) = x * D y + y * D x) ∧
      (∀ w : ↥W, D (algebraMap A K (algebraMap ↥W A w)) = 0) ∧ D (algebraMap A K t) = 1 ∧
      ∀ (x : K) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 (h * d) (D x) :=
by
  intro Ω _ W A _ _ _ K _ _ _ 𝔭 t hPD
  classical

  have T0 : ∀ (d : A) (x : K), wcLlsKPLoc A K 0 d x ↔
      ∃ (n : ℕ) (a : A), algebraMap A K a = algebraMap A K d ^ n * x := by
    intro d x
    have hbot : Algebra.adjoin A ({0} : Set K) = ⊥ := by
      apply le_antisymm
      · rw [Algebra.adjoin_le_iff]
        intro z hz
        rw [Set.mem_singleton_iff.mp hz]
        exact Subalgebra.zero_mem _
      · exact bot_le
    unfold wcLlsKPLoc
    rw [hbot]
    constructor
    · rintro ⟨n, hn⟩
      obtain ⟨a, ha⟩ := Algebra.mem_bot.mp hn
      exact ⟨n, a, ha⟩
    · rintro ⟨n, a, ha⟩
      exact ⟨n, Algebra.mem_bot.mpr ⟨a, ha⟩⟩

  have s1 : ∀ (R B : Type u) [CommRing R] [CommRing B] (ψ : Polynomial R →+* B), ψ.Etale →
      ∃ δ : B → B, (∀ x y, δ (x + y) = δ x + δ y) ∧ (∀ x y, δ (x * y) = x * δ y + y * δ x) ∧
        ∀ P : Polynomial R, δ (ψ P) = ψ (Polynomial.derivative P) := by
    intro R B _ _ ψ hψ
    letI : Algebra (Polynomial R) B := ψ.toAlgebra
    haveI : Algebra.Etale (Polynomial R) B := hψ
    haveI : Algebra.FormallySmooth (Polynomial R) B := inferInstance
    let σ₀ : Polynomial R →+* TrivSqZeroExt B B :=
      { toFun := fun P => TrivSqZeroExt.inl (ψ P) + TrivSqZeroExt.inr (ψ (Polynomial.derivative P))
        map_one' := by ext <;> simp
        map_mul' := by
          intro P Q
          ext <;> simp [Polynomial.derivative_mul, smul_eq_mul, op_smul_eq_mul] <;> ring
        map_zero' := by ext <;> simp
        map_add' := by
          intro P Q
          ext <;> simp <;> ring }
    have hσ₀ : ∀ P, σ₀ P = TrivSqZeroExt.inl (ψ P) + TrivSqZeroExt.inr (ψ (Polynomial.derivative P)) :=
      fun P => rfl
    letI : Algebra (Polynomial R) (TrivSqZeroExt B B) := σ₀.toAlgebra
    let π : TrivSqZeroExt B B →ₐ[Polynomial R] B :=
      { toFun := fun x => x.fst
        map_one' := TrivSqZeroExt.fst_one
        map_mul' := fun x y => TrivSqZeroExt.fst_mul x y
        map_zero' := TrivSqZeroExt.fst_zero
        map_add' := fun x y => TrivSqZeroExt.fst_add x y
        commutes' := fun P => by
          show (σ₀ P).fst = ψ P
          simp [hσ₀] }
    have hπ : ∀ x, π x = x.fst := fun x => rfl
    have hsurj : Function.Surjective π := fun b => ⟨TrivSqZeroExt.inl b, by rw [hπ]; simp⟩
    have hnil : IsNilpotent (RingHom.ker (π : TrivSqZeroExt B B →+* B)) := by
      refine ⟨2, ?_⟩
      rw [Ideal.zero_eq_bot, eq_bot_iff]
      refine (pow_two (RingHom.ker (π : TrivSqZeroExt B B →+* B))).le.trans ?_
      rw [Ideal.mul_le]
      intro r hr s hs
      rw [Ideal.mem_bot]
      have hr' : r.fst = 0 := RingHom.mem_ker.mp hr
      have hs' : s.fst = 0 := RingHom.mem_ker.mp hs
      ext <;> simp [hr', hs']
    let L := Algebra.FormallySmooth.liftOfSurjective (AlgHom.id (Polynomial R) B) π hsurj hnil
    have hL : ∀ b, (L b).fst = b := fun b =>
      Algebra.FormallySmooth.liftOfSurjective_apply (AlgHom.id (Polynomial R) B) π hsurj hnil b
    refine ⟨fun b => (L b).snd, ?_, ?_, ?_⟩
    · intro x y
      show (L (x + y)).snd = (L x).snd + (L y).snd
      rw [map_add]
      rfl
    · intro x y
      show (L (x * y)).snd = x * (L y).snd + y * (L x).snd
      rw [map_mul, TrivSqZeroExt.snd_mul, hL, hL, smul_eq_mul, op_smul_eq_mul]
      ring
    · intro P
      have e : L (ψ P) = σ₀ P := L.commutes P
      show (L (ψ P)).snd = _
      rw [e, hσ₀]
      simp

  obtain ⟨-, -, -, -, -, -, -, h, hh, ψ, hψC, hψX, hψet⟩ := hPD
  have hh0 : h ≠ 0 := fun e => hh (e ▸ 𝔭.zero_mem)
  have hu : IsUnit (algebraMap A K h) :=
    isUnit_iff_ne_zero.mpr ((map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr hh0)
  let j : Localization.Away h →+* K := IsLocalization.Away.lift h hu
  have hj : ∀ a : A, j (algebraMap A (Localization.Away h) a) = algebraMap A K a :=
    fun a => IsLocalization.Away.lift_eq h hu a
  obtain ⟨δ, hδadd, hδmul, hδψ⟩ := s1 (↥W) (Localization.Away h) ψ hψet
  have hδ0 : δ 0 = 0 := by
    have e := hδadd 0 0
    rw [add_zero] at e
    linear_combination -e
  have hδ1 : δ 1 = 0 := by
    have e := hδmul 1 1
    rw [mul_one] at e
    linear_combination -e

  let Φ₀ : A →+* TrivSqZeroExt K K :=
    { toFun := fun a => TrivSqZeroExt.inl (algebraMap A K a) +
        TrivSqZeroExt.inr (j (δ (algebraMap A (Localization.Away h) a)))
      map_one' := by ext <;> simp [hδ1]
      map_mul' := by
        intro a b
        ext <;> simp [hδmul, hj, smul_eq_mul, op_smul_eq_mul] <;> ring
      map_zero' := by ext <;> simp [hδ0]
      map_add' := by
        intro a b
        ext <;> simp [hδadd] <;> ring }
  have hΦ₀ : ∀ a, Φ₀ a = TrivSqZeroExt.inl (algebraMap A K a) +
      TrivSqZeroExt.inr (j (δ (algebraMap A (Localization.Away h) a))) := fun a => rfl
  have hunits : ∀ y : nonZeroDivisors A, IsUnit (Φ₀ y) := by
    intro y
    apply TrivSqZeroExt.isUnit_iff_isUnit_fst.mpr
    rw [hΦ₀]
    simp only [TrivSqZeroExt.fst_add, TrivSqZeroExt.fst_inl, TrivSqZeroExt.fst_inr, add_zero]
    exact isUnit_iff_ne_zero.mpr (IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors y.2)
  let Φ : K →+* TrivSqZeroExt K K := IsLocalization.lift (M := nonZeroDivisors A) (S := K) hunits
  have hΦ : ∀ a, Φ (algebraMap A K a) = Φ₀ a := fun a => IsLocalization.lift_eq hunits a
  have hΦfst : ∀ x : K, (Φ x).fst = x := by
    have e : ((TrivSqZeroExt.fstHom K K K).toRingHom.comp Φ) = RingHom.id K :=
      IsLocalization.ringHom_ext (nonZeroDivisors A) (RingHom.ext fun a => by
        show (Φ (algebraMap A K a)).fst = algebraMap A K a
        rw [hΦ, hΦ₀]
        simp)
    intro x
    exact RingHom.congr_fun e x
  let D : K → K := fun x => (Φ x).snd
  have hDadd : ∀ x y, D (x + y) = D x + D y := by
    intro x y
    show (Φ (x + y)).snd = (Φ x).snd + (Φ y).snd
    rw [map_add]
    rfl
  have hDmul : ∀ x y, D (x * y) = x * D y + y * D x := by
    intro x y
    show (Φ (x * y)).snd = x * (Φ y).snd + y * (Φ x).snd
    rw [map_mul, TrivSqZeroExt.snd_mul, hΦfst, hΦfst, smul_eq_mul, op_smul_eq_mul]
    ring
  have hDA : ∀ a : A, D (algebraMap A K a) = j (δ (algebraMap A (Localization.Away h) a)) := by
    intro a
    show (Φ (algebraMap A K a)).snd = _
    rw [hΦ, hΦ₀]
    simp

  have hW : ∀ w : ↥W, D (algebraMap A K (algebraMap ↥W A w)) = 0 := by
    intro w
    have e : algebraMap A (Localization.Away h) (algebraMap ↥W A w) = ψ (Polynomial.C w) :=
      (RingHom.congr_fun hψC w).symm
    rw [hDA, e, hδψ, Polynomial.derivative_C, map_zero, map_zero]
  have ht : D (algebraMap A K t) = 1 := by
    rw [hDA, ← hψX, hδψ, Polynomial.derivative_X, map_one, map_one]

  have K1 : ∀ a : A, ∃ (M : ℕ) (b : A),
      algebraMap A K h ^ M * D (algebraMap A K a) = algebraMap A K b := by
    intro a
    obtain ⟨m, a', ha'⟩ := IsLocalization.Away.surj h (δ (algebraMap A (Localization.Away h) a))
    have e := congrArg j ha'
    rw [map_mul, map_pow, hj, hj] at e
    exact ⟨m, a', by rw [hDA, mul_comm]; exact e⟩

  have hLoc : ∀ (x : K) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d x →
      wcLlsKPLoc A K 0 (h * d) (D x) := by
    intro x d _ hx
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    obtain ⟨M₁, a₁, e1⟩ := K1 a
    obtain ⟨M₂, a₂, e2⟩ := K1 (d ^ n)
    rw [map_pow] at e2
    have e4 : D (algebraMap A K a) = algebraMap A K d ^ n * D x +
        x * D (algebraMap A K d ^ n) := by
      rw [ha, hDmul]
    refine (T0 _ _).mpr ⟨2 * n + M₁ + M₂,
      h ^ (2 * n) * d ^ (M₁ + M₂) * (d ^ n * h ^ M₂ * a₁ - a * h ^ M₁ * a₂), ?_⟩
    simp only [map_mul, map_pow, map_sub]
    linear_combination
      (-(algebraMap A K h ^ (2 * n) * algebraMap A K d ^ (M₁ + M₂) * algebraMap A K d ^ n *
          algebraMap A K h ^ M₂)) * e1 +
      (algebraMap A K h ^ (2 * n) * algebraMap A K d ^ (M₁ + M₂) * algebraMap A K h ^ M₁ *
          algebraMap A K a) * e2 +
      (-(algebraMap A K h ^ (2 * n) * algebraMap A K d ^ (M₁ + M₂) * algebraMap A K h ^ M₁ *
          algebraMap A K h ^ M₂ * D (algebraMap A K d ^ n))) * ha +
      (algebraMap A K h ^ (2 * n + M₁ + M₂) * algebraMap A K d ^ (M₁ + M₂ + n)) * e4
  exact ⟨h, D, hh, hDadd, hDmul, hW, ht, hLoc⟩

theorem wcLlsKP_bauc_frob_span : ∀ (p : ℕ), p.Prime → ∀ (R S : Type u) [CommRing R] [CommRing S]
    (φ : R →+* S), φ.FormallyUnramified → φ.FiniteType → ((p : ℕ) : S) = 0 →
    ∀ s : S, s ∈ Subring.closure (Set.range φ ∪ Set.range (fun x : S => x ^ p)) :=
by
  intro p hp R S _ _ φ hFU hFT hp0 s
  set S' := Subring.closure (Set.range φ ∪ Set.range (fun x : S => x ^ p)) with hS'
  have hφS' : ∀ x, φ x ∈ S' := fun x => Subring.subset_closure (Or.inl ⟨x, rfl⟩)
  have hpow : ∀ x : S, x ^ p ∈ S' := fun x => Subring.subset_closure (Or.inr ⟨x, rfl⟩)
  letI : Algebra R S := φ.toAlgebra
  letI : Algebra R S' := (φ.codRestrict S' hφS').toAlgebra
  haveI : IsScalarTower R S' S := IsScalarTower.of_algebraMap_eq (fun x => rfl)
  haveI : Algebra.FormallyUnramified R S := hFU
  haveI : Algebra.FiniteType R S := hFT
  haveI : Algebra.FormallyUnramified S' S := Algebra.FormallyUnramified.of_restrictScalars R S' S
  haveI : Algebra.FiniteType S' S := Algebra.FiniteType.of_restrictScalars_finiteType R S' S
  haveI : Algebra.IsIntegral S' S := by
    constructor
    intro x
    refine ⟨Polynomial.X ^ p - Polynomial.C ⟨x ^ p, hpow x⟩,
      Polynomial.monic_X_pow_sub_C _ hp.ne_zero, ?_⟩
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
    show x ^ p - x ^ p = 0
    exact sub_self _
  haveI : Module.Finite S' S := Algebra.IsIntegral.finite
  haveI : Algebra.EssFiniteType S' S := Algebra.EssFiniteType.of_finiteType S' S

  have hpT : ((p : ℕ) : TensorProduct S' S S) = 0 := by
    have := map_natCast (algebraMap S (TensorProduct S' S S)) p
    rw [← this, hp0, map_zero]
  have hfrob : ∀ a b : TensorProduct S' S S, (a + b) ^ p = a ^ p + b ^ p := by
    intro a b
    obtain ⟨r, hr⟩ := exists_add_pow_prime_eq hp a b
    rw [hr, hpT]; ring
  have hfrob' : ∀ a b : TensorProduct S' S S, (a - b) ^ p = a ^ p - b ^ p := by
    intro a b
    have := hfrob (a - b) b
    rw [sub_add_cancel] at this
    rw [this]; ring
  have hnil : ∀ x : S,
      (TensorProduct.tmul S' (1 : S) x - TensorProduct.tmul S' x (1 : S)) ^ p = 0 := by
    intro x
    rw [hfrob', Algebra.TensorProduct.tmul_pow, Algebra.TensorProduct.tmul_pow, one_pow]
    have h1 : x ^ p = algebraMap S' S ⟨x ^ p, hpow x⟩ := rfl
    rw [h1, Algebra.TensorProduct.tmul_one_eq_one_tmul, sub_self]

  have hepi : Algebra.IsEpi S' S := by
    obtain ⟨e, he1, he2⟩ :=
      (Algebra.FormallyUnramified.iff_exists_tensorProduct (R := S') (S := S)).mp inferInstance
    have hle : KaehlerDifferential.ideal S' S ≤ nilradical (TensorProduct S' S S) := by
      rw [← KaehlerDifferential.span_range_eq_ideal, Ideal.span_le]
      rintro _ ⟨x, rfl⟩
      exact mem_nilradical.mpr ⟨p, hnil x⟩
    have hmem : 1 - e ∈ KaehlerDifferential.ideal S' S := by
      rw [KaehlerDifferential.ideal, RingHom.mem_ker, map_sub, map_one, he2, sub_self]
    have hunit : IsUnit e := by
      have := IsNilpotent.isUnit_one_sub (mem_nilradical.mp (hle hmem))
      rwa [sub_sub_cancel] at this
    rw [Algebra.isEpi_iff_forall_one_tmul_eq]
    intro x
    have h := he1 x
    rw [hunit.mul_left_eq_zero, sub_eq_zero] at h
    exact h
  haveI : CategoryTheory.Epi (CommRingCat.ofHom (algebraMap S' S)) :=
    CommRingCat.epi_iff_epi.mpr hepi
  have hfin : (CommRingCat.Hom.hom (CommRingCat.ofHom (algebraMap S' S))).Finite := by
    rw [CommRingCat.hom_ofHom]
    exact RingHom.finite_algebraMap.mpr inferInstance
  obtain ⟨r, hr⟩ := RingHom.surjective_of_epi_of_finite (CommRingCat.ofHom (algebraMap S' S)) hfin s
  have hr' : (r : S) = s := hr
  rw [← hr']
  exact r.2

theorem wcLlsKP_bauc_pbasis : ∀ (p : ℕ), p.Prime → ∀ (R S : Type u) [CommRing R] [CommRing S]
    (φ : Polynomial R →+* S), ((p : ℕ) : S) = 0 → (∀ a : R, ∃ b : R, b ^ p = a) →
    ∀ s : S, s ∈ Subring.closure (Set.range φ ∪ Set.range (fun x : S => x ^ p)) →
    ∃ c : ℕ → S, s = ∑ i ∈ Finset.range p, c i ^ p * φ Polynomial.X ^ i :=
by
  intro p hp R S _ _ φ hpS hroot s hs
  classical
  have hadd : ∀ a b : S, (a + b) ^ p = a ^ p + b ^ p := by
    intro a b
    obtain ⟨r, hr⟩ := exists_add_pow_prime_eq hp a b
    rw [hr, hpS]; ring
  have hneg : ∀ a : S, (-a) ^ p = -(a ^ p) := by
    intro a
    have h := hadd a (-a)
    rw [add_neg_cancel, zero_pow hp.ne_zero] at h
    linear_combination -h
  let M : AddSubgroup S :=
    { carrier := {x | ∃ c : ℕ → S, x = ∑ i ∈ Finset.range p, c i ^ p * φ Polynomial.X ^ i}
      zero_mem' := ⟨0, by simp [zero_pow hp.ne_zero]⟩
      add_mem' := by
        intro x y hx hy
        obtain ⟨c, hc⟩ := hx
        obtain ⟨c', hc'⟩ := hy
        refine ⟨fun i => c i + c' i, ?_⟩
        rw [hc, hc']
        simp only [hadd, add_mul, Finset.sum_add_distrib]
      neg_mem' := by
        intro x hx
        obtain ⟨c, hc⟩ := hx
        refine ⟨fun i => -c i, ?_⟩
        rw [hc]
        simp only [hneg, neg_mul, Finset.sum_neg_distrib] }
  have hmono : ∀ (a : S) (k : ℕ), a ^ p * φ Polynomial.X ^ k ∈ M := by
    intro a k
    show ∃ c : ℕ → S, _ = _
    refine ⟨fun i => if i = k % p then a * φ Polynomial.X ^ (k / p) else 0, ?_⟩
    have hk : k % p ∈ Finset.range p := Finset.mem_range.mpr (Nat.mod_lt k hp.pos)
    rw [Finset.sum_eq_single_of_mem (k % p) hk]
    · simp only [↓reduceIte]
      rw [mul_pow, ← pow_mul, mul_assoc, ← pow_add, Nat.div_add_mod']
    · intro b _ hb
      simp only [hb, ↓reduceIte, zero_pow hp.ne_zero, zero_mul]
  have hmul : ∀ x y, x ∈ M → y ∈ M → x * y ∈ M := by
    intro x y hx hy
    obtain ⟨c, hc⟩ := hx
    obtain ⟨c', hc'⟩ := hy
    rw [hc, hc', Finset.sum_mul_sum]
    refine M.sum_mem (fun i _ => M.sum_mem (fun j _ => ?_))
    have e : c i ^ p * φ Polynomial.X ^ i * (c' j ^ p * φ Polynomial.X ^ j)
        = (c i * c' j) ^ p * φ Polynomial.X ^ (i + j) := by ring
    rw [e]
    exact hmono _ _
  have key : s ∈ M := by
    induction hs using Subring.closure_induction with
    | mem x hx =>
      rcases hx with ⟨P, rfl⟩ | ⟨y, rfl⟩
      · induction P using Polynomial.induction_on' with
        | add P Q hP hQ => rw [map_add]; exact M.add_mem hP hQ
        | monomial n a =>
          obtain ⟨b, rfl⟩ := hroot a
          rw [← Polynomial.C_mul_X_pow_eq_monomial, Polynomial.C_pow, map_mul, map_pow, map_pow]
          exact hmono _ _
      · simpa using hmono y 0
    | zero => exact M.zero_mem
    | one => simpa using hmono 1 0
    | add x y _ _ hx hy => exact M.add_mem hx hy
    | neg x _ hx => exact M.neg_mem hx
    | mul x y _ _ hx hy => exact hmul x y hx hy
  obtain ⟨c, hc⟩ := key
  exact ⟨c, hc⟩

theorem wcLlsKP_bauc_desc : ∀ (p : ℕ), p.Prime → ∀ (R : Type u) [CommRing R] (B : Subring R)
    (D : R → R), (∀ x y, D (x + y) = D x + D y) → (∀ x y, D (x * y) = x * D y + y * D x) →
    (∀ x ∈ B, D x ∈ B) → ∀ (τ π w : R), τ ∈ B → D τ = 1 → π ∈ B → D π = 0 → w ∈ B →
    ((p : ℕ) : R) = π * w → ∀ (c : ℕ → R) (e y z : R), (∀ i, c i ∈ B) → e ∈ B → y ∈ B →
    z = ∑ i ∈ Finset.range p, c i ^ p * τ ^ i + π * e → D z = π * y →
    ∃ e' ∈ B, z - c 0 ^ p = π * e' :=
by
  intro p hp R _ B D hadd hleib hDB τ π w hτ hDτ hπ hDπ hw hpw c e y z hc he hy hz hDz
  classical

  have hD0 : D 0 = 0 := by
    have h := hadd 0 0
    simp only [add_zero] at h
    linear_combination -h
  have hD1 : D 1 = 0 := by
    have h := hleib 1 1
    simp only [one_mul, mul_one] at h
    linear_combination -h
  have hsub : ∀ a b, D (a - b) = D a - D b := by
    intro a b
    have h := hadd (a - b) b
    rw [sub_add_cancel] at h
    linear_combination -h
  have hsum : ∀ (s : Finset ℕ) (f : ℕ → R), D (∑ j ∈ s, f j) = ∑ j ∈ s, D (f j) := by
    intro s f
    induction s using Finset.induction_on with
    | empty => simp [hD0]
    | insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, hadd, ih]
  have hnat : ∀ (m : ℕ) (x : R), D ((m : R) * x) = (m : R) * D x := by
    intro m x
    induction m with
    | zero => simp [hD0]
    | succ m ih => rw [Nat.cast_succ, add_mul, one_mul, hadd, ih, add_mul, one_mul]
  have hpow : ∀ (u : R) (k : ℕ), D (u ^ (k + 1)) = ((k + 1 : ℕ) : R) * u ^ k * D u := by
    intro u k
    induction k with
    | zero => simp
    | succ k ih =>
      rw [pow_succ, hleib, ih]
      push_cast
      ring

  have Nadd : ∀ x x' : R, (∃ b ∈ B, x = π * b) → (∃ b ∈ B, x' = π * b) →
      ∃ b ∈ B, x + x' = π * b := by
    rintro x x' ⟨b, hb, rfl⟩ ⟨b', hb', rfl⟩
    exact ⟨b + b', add_mem hb hb', by ring⟩
  have Nsum : ∀ (s : Finset ℕ) (f : ℕ → R), (∀ j ∈ s, ∃ b ∈ B, f j = π * b) →
      ∃ b ∈ B, ∑ j ∈ s, f j = π * b := by
    intro s f
    induction s using Finset.induction_on with
    | empty => intro _; exact ⟨0, zero_mem _, by simp⟩
    | insert a s ha ih =>
      intro hf
      rw [Finset.sum_insert ha]
      exact Nadd _ _ (hf a (Finset.mem_insert_self a s))
        (ih (fun j hj => hf j (Finset.mem_insert_of_mem hj)))

  have hτpow : ∀ j : ℕ, D (τ ^ (j + 1)) = ((j + 1 : ℕ) : R) * τ ^ j := by
    intro j; rw [hpow, hDτ, mul_one]
  have hshift : ∀ (n : ℕ) (b : ℕ → R), D (∑ j ∈ Finset.range (n + 1), b j * τ ^ j) =
      ∑ j ∈ Finset.range (n + 1), D (b j) * τ ^ j +
        ∑ k ∈ Finset.range n, ((k + 1 : ℕ) : R) * b (k + 1) * τ ^ k := by
    intro n b
    rw [hsum]
    have e1 : ∀ j, D (b j * τ ^ j) = D (b j) * τ ^ j + b j * D (τ ^ j) := by
      intro j; rw [hleib]; ring
    simp only [e1, Finset.sum_add_distrib]
    congr 1
    rw [Finset.sum_range_succ']
    simp only [pow_zero, hD1, mul_zero, add_zero, hτpow]
    exact Finset.sum_congr rfl (fun k _ => by ring)

  have hcancel : ∀ m : ℕ, 0 < m → m < p → ∀ x ∈ B, (∃ b ∈ B, (m : R) * x = π * b) →
      ∃ b ∈ B, x = π * b := by
    rintro m hm0 hmp x hx ⟨b, hb, hmb⟩
    have hndvd : ¬ p ∣ m := fun h => absurd (Nat.le_of_dvd hm0 h) (by omega)
    have hcop : Nat.Coprime p m := (Nat.Prime.coprime_iff_not_dvd hp).mpr hndvd
    obtain ⟨a, a', haa⟩ := Nat.Coprime.isCoprime hcop
    have hR : (a : R) * (p : R) + (a' : R) * (m : R) = 1 := by
      have := congrArg (Int.cast : ℤ → R) haa
      push_cast at this
      exact this
    refine ⟨(a : R) * w * x + (a' : R) * b,
      add_mem (mul_mem (mul_mem (intCast_mem B a) hw) hx) (mul_mem (intCast_mem B a') hb), ?_⟩
    rw [hpw] at hR
    linear_combination (-x) * hR + (a' : R) * hmb

  have hDN : ∀ b ∈ B, ∃ b' ∈ B, D (π * b) = π * b' := by
    intro b hb
    exact ⟨D b, hDB b hb, by rw [hleib, hDπ, mul_zero, add_zero]⟩

  have core : ∀ n : ℕ, n < p → ∀ b : ℕ → R, (∀ j, b j ∈ B) →
      (∀ j, ∃ b' ∈ B, D (b j) = π * b') →
      (∃ y ∈ B, D (∑ j ∈ Finset.range (n + 1), b j * τ ^ j) = π * y) →
      ∀ j, 1 ≤ j → j ≤ n → ∃ b' ∈ B, b j = π * b' := by
    intro n
    induction n with
    | zero => intro _ b _ _ _ j h1 h2; omega
    | succ n ih =>
      intro hnp b hb hDb hDS
      obtain ⟨y₀, hy₀, hy₀eq⟩ := hDS
      choose β hβ hβeq using hDb
      have hU : ∃ u ∈ B, ∑ j ∈ Finset.range (n + 1 + 1), D (b j) * τ ^ j = π * u :=
        Nsum _ _ (fun j _ => by
          rw [hβeq j]
          exact ⟨β j * τ ^ j, mul_mem (hβ j) (pow_mem hτ j), by ring⟩)
      obtain ⟨u, hu, hueq⟩ := hU
      have hT : ∑ k ∈ Finset.range (n + 1), ((k + 1 : ℕ) : R) * b (k + 1) * τ ^ k =
          π * (y₀ - u) := by
        have h := hshift (n + 1) b
        rw [hy₀eq, hueq] at h
        linear_combination -h
      have ih' := ih (by omega) (fun k => ((k + 1 : ℕ) : R) * b (k + 1))
        (fun k => mul_mem (natCast_mem B (k + 1)) (hb (k + 1)))
        (fun k => ⟨((k + 1 : ℕ) : R) * β (k + 1), mul_mem (natCast_mem B (k + 1)) (hβ (k + 1)), by
            show D (((k + 1 : ℕ) : R) * b (k + 1)) = _
            rw [hnat, hβeq]; ring⟩)
        (by
          obtain ⟨b'', hb'', hD''⟩ := hDN (y₀ - u) (sub_mem hy₀ hu)
          exact ⟨b'', hb'', (congrArg D hT).trans hD''⟩)
      have hT0 : ∃ b0 ∈ B, ((0 + 1 : ℕ) : R) * b (0 + 1) = π * b0 := by
        have hsplit := hT
        rw [Finset.sum_range_succ'] at hsplit
        have hS : ∃ s ∈ B, ∑ k ∈ Finset.range n,
            ((k + 1 + 1 : ℕ) : R) * b (k + 1 + 1) * τ ^ (k + 1) = π * s :=
          Nsum _ _ (fun k hk => by
            obtain ⟨q, hq, hqeq⟩ := ih' (k + 1) (by omega)
              (by have := Finset.mem_range.mp hk; omega)
            refine ⟨q * τ ^ (k + 1), mul_mem hq (pow_mem hτ _), ?_⟩
            have hqeq' : ((k + 1 + 1 : ℕ) : R) * b (k + 1 + 1) = π * q := hqeq
            rw [hqeq']; ring)
        obtain ⟨s, hs, hseq⟩ := hS
        refine ⟨(y₀ - u) - s, sub_mem (sub_mem hy₀ hu) hs, ?_⟩
        rw [pow_zero, mul_one] at hsplit
        linear_combination hsplit - hseq
      have hall : ∀ k, k ≤ n → ∃ q ∈ B, ((k + 1 : ℕ) : R) * b (k + 1) = π * q := by
        intro k hk
        rcases Nat.eq_zero_or_pos k with rfl | hkpos
        · exact hT0
        · exact ih' k (by omega) hk
      intro j hj1 hjn
      obtain ⟨k, rfl⟩ : ∃ k, j = k + 1 := ⟨j - 1, by omega⟩
      exact hcancel (k + 1) (by omega) (by omega) (b (k + 1)) (hb (k + 1)) (hall k (by omega))

  obtain ⟨n, rfl⟩ : ∃ n, p = n + 1 := ⟨p - 1, by have := hp.two_le; omega⟩
  have hbB : ∀ j, c j ^ (n + 1) ∈ B := fun j => pow_mem (hc j) _
  have hDb : ∀ j, ∃ b' ∈ B, D (c j ^ (n + 1)) = π * b' := by
    intro j
    refine ⟨w * c j ^ n * D (c j), mul_mem (mul_mem hw (pow_mem (hc j) n)) (hDB _ (hc j)), ?_⟩
    rw [hpow, hpw]; ring
  have hDS : ∃ y' ∈ B, D (∑ j ∈ Finset.range (n + 1), c j ^ (n + 1) * τ ^ j) = π * y' := by
    refine ⟨y - D e, sub_mem hy (hDB e he), ?_⟩
    have hS : ∑ j ∈ Finset.range (n + 1), c j ^ (n + 1) * τ ^ j = z - π * e := by
      rw [hz]; ring
    rw [hS, hsub, hDz, hleib, hDπ]; ring
  have hcore := core n (by omega) (fun j => c j ^ (n + 1)) hbB hDb hDS
  have hcj : ∀ k ∈ Finset.range n, ∃ q ∈ B, c (k + 1) ^ (n + 1) * τ ^ (k + 1) = π * q := by
    intro k hk
    have hk' := Finset.mem_range.mp hk
    obtain ⟨q, hq, hqeq⟩ := hcore (k + 1) (by omega) (by omega)
    refine ⟨q * τ ^ (k + 1), mul_mem hq (pow_mem hτ _), ?_⟩
    have hqeq' : c (k + 1) ^ (n + 1) = π * q := hqeq
    rw [hqeq']; ring
  have hS2 : ∃ s ∈ B, ∑ k ∈ Finset.range n, c (k + 1) ^ (n + 1) * τ ^ (k + 1) = π * s :=
    Nsum _ _ hcj
  obtain ⟨s, hs, hseq⟩ := hS2
  refine ⟨s + e, add_mem hs he, ?_⟩
  rw [hz, Finset.sum_range_succ', pow_zero, mul_one]
  linear_combination hseq

theorem wcLlsKP_bauc_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω)
    (ℓ : ℕ), ℓ.Prime → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u)
    [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) →
    (∀ (R S : Type u) [CommRing R] [CommRing S] (φ : R →+* S), φ.FormallyUnramified →
      φ.FiniteType → ((ℓ : ℕ) : S) = 0 →
      ∀ s : S, s ∈ Subring.closure (Set.range φ ∪ Set.range (fun x : S => x ^ ℓ))) →
    (∀ (R S : Type u) [CommRing R] [CommRing S] (φ : Polynomial R →+* S), ((ℓ : ℕ) : S) = 0 →
      (∀ a : R, ∃ b : R, b ^ ℓ = a) →
      ∀ s : S, s ∈ Subring.closure (Set.range φ ∪ Set.range (fun x : S => x ^ ℓ)) →
      ∃ c : ℕ → S, s = ∑ i ∈ Finset.range ℓ, c i ^ ℓ * φ Polynomial.X ^ i) →
    ∀ (x : K) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d x → ∀ ρ : ↥W, ρ ∣ ((ℓ : ℕ) : ↥W) →
    ∃ (g : A) (c : ℕ → K) (e : K), g ∉ 𝔭 ∧ d ∣ g ∧ (∀ i, wcLlsKPLoc A K 0 g (c i)) ∧
      wcLlsKPLoc A K 0 g e ∧
      x = ∑ i ∈ Finset.range ℓ, c i ^ ℓ * algebraMap A K t ^ i +
        algebraMap A K (algebraMap ↥W A ρ) * e :=
by
  intro Ω _ _ W ℓ hℓ A _ _ _ K _ _ _ 𝔭 t hPD hFS hPB x d hd hLx ρ hρℓ
  classical
  have T0 : ∀ (d : A) (x : K), wcLlsKPLoc A K 0 d x ↔
      ∃ (n : ℕ) (a : A), algebraMap A K a = algebraMap A K d ^ n * x := by
    intro d x
    have hbot : Algebra.adjoin A ({0} : Set K) = ⊥ := by
      apply le_antisymm
      · rw [Algebra.adjoin_le_iff]
        intro z hz
        rw [Set.mem_singleton_iff.mp hz]
        exact Subalgebra.zero_mem _
      · exact bot_le
    unfold wcLlsKPLoc
    rw [hbot]
    constructor
    · rintro ⟨n, hn⟩
      obtain ⟨a, ha⟩ := Algebra.mem_bot.mp hn
      exact ⟨n, a, ha⟩
    · rintro ⟨n, a, ha⟩
      exact ⟨n, Algebra.mem_bot.mpr ⟨a, ha⟩⟩

  obtain ⟨_, _, _, h𝔭max, _, _, _, h₀, hh₀, f, _, hfX, hfet⟩ := hPD
  have hPrime : 𝔭.IsPrime := h𝔭max.isPrime
  have hg : h₀ * d ∉ 𝔭 := fun hm => (hPrime.mem_or_mem hm).elim hh₀ hd
  have hg0 : h₀ * d ≠ 0 := fun h0 => hg (h0 ▸ 𝔭.zero_mem)

  have hperf : ∀ a : ↥W, ∃ b : ↥W, b ^ ℓ = a := by
    intro a
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (a : Ω) hℓ.pos
    have hint : IsIntegral ↥W z := by
      apply IsIntegral.of_pow hℓ.pos
      rw [hz, ← ValuationSubring.algebraMap_apply]
      exact isIntegral_algebraMap
    obtain ⟨b, hb⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    refine ⟨b, IsFractionRing.injective (↥W) Ω ?_⟩
    rw [map_pow, hb, hz, ValuationSubring.algebraMap_apply]

  obtain ⟨ψ, hψ⟩ : ∃ ψ : Localization.Away h₀ →+* Localization.Away (h₀ * d),
      ∀ a : A, ψ (algebraMap A (Localization.Away h₀) a) =
        algebraMap A (Localization.Away (h₀ * d)) a :=
    ⟨IsLocalization.Away.awayToAwayRight (S := Localization.Away h₀)
      (P := Localization.Away (h₀ * d)) h₀ d,
      fun a => IsLocalization.Away.awayToAwayRight_eq h₀ d a⟩
  have hψcomp : ψ.comp (algebraMap A (Localization.Away h₀)) =
      algebraMap A (Localization.Away (h₀ * d)) := RingHom.ext hψ
  have hψFU : ψ.FormallyUnramified := by
    have h1 : (ψ.comp (algebraMap A (Localization.Away h₀))).FormallyUnramified := by
      rw [hψcomp]
      exact RingHom.formallyUnramified_algebraMap.mpr
        (Algebra.FormallyUnramified.of_isLocalization (Submonoid.powers (h₀ * d)))
    exact RingHom.FormallyUnramified.of_comp h1
  have hψFT : ψ.FiniteType := by
    apply RingHom.FiniteType.of_comp_finiteType (f := algebraMap A (Localization.Away h₀))
    rw [hψcomp]
    exact RingHom.finiteType_algebraMap.mpr inferInstance
  have hfFU : f.FormallyUnramified := hfet.formallyUnramified
  have hfFT : f.FiniteType := by
    letI := f.toAlgebra
    haveI : Algebra.Etale (Polynomial ↥W) (Localization.Away h₀) := hfet
    exact (inferInstance : Algebra.FiniteType (Polynomial ↥W) (Localization.Away h₀))

  obtain ⟨ρ₁, hρ₁⟩ : ∃ ρ₁ : Localization.Away (h₀ * d),
      ρ₁ = algebraMap A (Localization.Away (h₀ * d)) (algebraMap ↥W A ρ) := ⟨_, rfl⟩
  have hqFU : (Ideal.Quotient.mk (Ideal.span {ρ₁})).FormallyUnramified :=
    RingHom.FormallyUnramified.of_surjective Ideal.Quotient.mk_surjective
  have hqFT : (Ideal.Quotient.mk (Ideal.span {ρ₁})).FiniteType :=
    RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective
  have hΦFU : ((Ideal.Quotient.mk (Ideal.span {ρ₁})).comp (ψ.comp f)).FormallyUnramified :=
    RingHom.FormallyUnramified.comp (RingHom.FormallyUnramified.comp hfFU hψFU) hqFU
  have hΦFT : ((Ideal.Quotient.mk (Ideal.span {ρ₁})).comp (ψ.comp f)).FiniteType :=
    RingHom.FiniteType.comp hqFT (RingHom.FiniteType.comp hψFT hfFT)
  have hqρ : Ideal.Quotient.mk (Ideal.span {ρ₁}) ρ₁ = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self ρ₁)
  obtain ⟨ρ', hρ'⟩ := hρℓ
  have hℓS : ((ℓ : ℕ) : Localization.Away (h₀ * d) ⧸ Ideal.span {ρ₁}) = 0 := by
    have e1 : ((ℓ : ℕ) : Localization.Away (h₀ * d) ⧸ Ideal.span {ρ₁}) =
        Ideal.Quotient.mk (Ideal.span {ρ₁})
          (algebraMap A (Localization.Away (h₀ * d)) (algebraMap ↥W A ((ℓ : ℕ) : ↥W))) := by
      simp only [map_natCast]
    rw [e1, hρ', map_mul, map_mul, map_mul, ← hρ₁, hqρ, zero_mul]
  have hΦX : ((Ideal.Quotient.mk (Ideal.span {ρ₁})).comp (ψ.comp f)) Polynomial.X =
      Ideal.Quotient.mk (Ideal.span {ρ₁}) (algebraMap A (Localization.Away (h₀ * d)) t) := by
    simp only [RingHom.comp_apply, hfX, hψ]

  have hιg : IsUnit (algebraMap A K (h₀ * d)) := by
    apply isUnit_iff_ne_zero.mpr
    intro h0
    apply hg0
    exact IsFractionRing.injective A K (h0.trans (map_zero _).symm)
  obtain ⟨ι₁, hι₁⟩ : ∃ ι₁ : Localization.Away (h₀ * d) →+* K,
      ∀ a : A, ι₁ (algebraMap A (Localization.Away (h₀ * d)) a) = algebraMap A K a :=
    ⟨IsLocalization.Away.lift (h₀ * d) hιg, fun a => IsLocalization.Away.lift_eq (h₀ * d) hιg a⟩
  have hLoc : ∀ z : Localization.Away (h₀ * d), wcLlsKPLoc A K 0 (h₀ * d) (ι₁ z) := by
    intro z
    obtain ⟨n, a, hz⟩ := IsLocalization.Away.surj (h₀ * d) z
    refine (T0 _ _).mpr ⟨n, a, ?_⟩
    have h2 := congrArg ι₁ hz
    rw [map_mul, map_pow, hι₁, hι₁] at h2
    rw [← h2, mul_comm]

  obtain ⟨n, a, ha⟩ := (T0 d x).mp hLx
  obtain ⟨x₁, hx₁⟩ : ∃ x₁ : Localization.Away (h₀ * d), ι₁ x₁ = x := by
    refine ⟨IsLocalization.mk' (Localization.Away (h₀ * d)) (h₀ ^ n * a)
      (⟨(h₀ * d) ^ n, n, rfl⟩ : Submonoid.powers (h₀ * d)), ?_⟩
    have hs := IsLocalization.mk'_spec (Localization.Away (h₀ * d)) (h₀ ^ n * a)
      (⟨(h₀ * d) ^ n, n, rfl⟩ : Submonoid.powers (h₀ * d))
    have h2 : ι₁ (IsLocalization.mk' (Localization.Away (h₀ * d)) (h₀ ^ n * a)
        (⟨(h₀ * d) ^ n, n, rfl⟩ : Submonoid.powers (h₀ * d))) * algebraMap A K ((h₀ * d) ^ n) =
        algebraMap A K (h₀ ^ n * a) := by
      rw [← hι₁, ← hι₁, ← map_mul]
      exact congrArg ι₁ hs
    have hne : algebraMap A K ((h₀ * d) ^ n) ≠ 0 := by
      rw [map_pow]; exact pow_ne_zero _ hιg.ne_zero
    apply mul_right_cancel₀ hne
    rw [h2]
    simp only [map_mul, map_pow]
    rw [ha]
    ring

  have hmem := hFS (Polynomial ↥W) (Localization.Away (h₀ * d) ⧸ Ideal.span {ρ₁})
    ((Ideal.Quotient.mk (Ideal.span {ρ₁})).comp (ψ.comp f)) hΦFU hΦFT hℓS
    (Ideal.Quotient.mk (Ideal.span {ρ₁}) x₁)
  obtain ⟨cb, hcb⟩ := hPB (↥W) (Localization.Away (h₀ * d) ⧸ Ideal.span {ρ₁})
    ((Ideal.Quotient.mk (Ideal.span {ρ₁})).comp (ψ.comp f)) hℓS hperf
    (Ideal.Quotient.mk (Ideal.span {ρ₁}) x₁) hmem
  choose c₁ hc₁ using fun i => Ideal.Quotient.mk_surjective (I := Ideal.span {ρ₁}) (cb i)
  have hr : Ideal.Quotient.mk (Ideal.span {ρ₁})
      (x₁ - ∑ i ∈ Finset.range ℓ, c₁ i ^ ℓ * algebraMap A (Localization.Away (h₀ * d)) t ^ i) =
      0 := by
    rw [map_sub, map_sum, hcb, sub_eq_zero]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    simp only [hΦX, map_mul, map_pow, hc₁]
  obtain ⟨e₁, he₁⟩ := Ideal.mem_span_singleton'.mp (Ideal.Quotient.eq_zero_iff_mem.mp hr)
  have hx₁' : x₁ = ∑ i ∈ Finset.range ℓ,
      c₁ i ^ ℓ * algebraMap A (Localization.Away (h₀ * d)) t ^ i + e₁ * ρ₁ := by
    rw [he₁]; ring
  refine ⟨h₀ * d, fun i => ι₁ (c₁ i), ι₁ e₁, hg, ⟨h₀, by ring⟩, fun i => hLoc _, hLoc _, ?_⟩
  rw [← hx₁, hx₁']
  simp only [map_add, map_sum, map_mul, map_pow, hρ₁, hι₁]
  ring

theorem wcLlsKP_bau_cartier : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (h : A) (D : K → K), h ∉ 𝔭 → (∀ x y, D (x + y) = D x + D y) →
      (∀ x y, D (x * y) = x * D y + y * D x) →
      (∀ w : ↥W, D (algebraMap A K (algebraMap ↥W A w)) = 0) → D (algebraMap A K t) = 1 →
      (∀ (x : K) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 (h * d) (D x)) →
      ∀ (x : K) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d x →
      ∀ ρ : ↥W, ρ ≠ 0 → ρ ∣ ((ℓ : ℕ) : ↥W) →
      (∃ (d₁ : A) (y : K), d₁ ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d₁ y ∧
        D x = algebraMap A K (algebraMap ↥W A ρ) * y) →
      ∃ (s e : K) (d₂ : A), d₂ ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d₂ s ∧ wcLlsKPLoc A K 0 d₂ e ∧
        x - s ^ ℓ = algebraMap A K (algebraMap ↥W A ρ) * e :=
by
  intro Ω _ _ W _ _ ℓ hℓ _ A _ _ _ K _ _ _ 𝔭 t hPD h D hh hD1 hD2 hD3 hD4 hD5 x d hd hLx ρ _
    hρℓ hDx
  have T0 : ∀ (d : A) (x : K), wcLlsKPLoc A K 0 d x ↔
      ∃ (n : ℕ) (a : A), algebraMap A K a = algebraMap A K d ^ n * x := by
    intro d x
    have hbot : Algebra.adjoin A ({0} : Set K) = ⊥ := by
      apply le_antisymm
      · rw [Algebra.adjoin_le_iff]
        intro z hz
        rw [Set.mem_singleton_iff.mp hz]
        exact Subalgebra.zero_mem _
      · exact bot_le
    unfold wcLlsKPLoc
    rw [hbot]
    constructor
    · rintro ⟨n, hn⟩
      obtain ⟨a, ha⟩ := Algebra.mem_bot.mp hn
      exact ⟨n, a, ha⟩
    · rintro ⟨n, a, ha⟩
      exact ⟨n, Algebra.mem_bot.mpr ⟨a, ha⟩⟩
  have TD : ∀ (d e : A) (x : K), wcLlsKPLoc A K 0 d x → d ∣ e → wcLlsKPLoc A K 0 e x := by
    intro d e x hx hde
    obtain ⟨c, rfl⟩ := hde
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    refine (T0 _ _).mpr ⟨n, c ^ n * a, ?_⟩
    simp only [map_mul, map_pow, ha]
    ring
  have hPrime : 𝔭.IsPrime := hPD.2.2.2.1.isPrime
  have T5 : ∀ a b : A, a ∉ 𝔭 → b ∉ 𝔭 → a * b ∉ 𝔭 := fun a b ha hb hab =>
    (hPrime.mem_or_mem hab).elim ha hb

  obtain ⟨g, c, e, hg, _, hc, he, hx⟩ := wcLlsKP_bauc_chart Ω W ℓ hℓ A K 𝔭 t hPD
    (wcLlsKP_bauc_frob_span ℓ hℓ) (wcLlsKP_bauc_pbasis ℓ hℓ) x d hd hLx ρ hρℓ
  obtain ⟨d₁, y, hd₁, hLy, hDxy⟩ := hDx
  have hG : h * g * d₁ ∉ 𝔭 := T5 _ _ (T5 _ _ hh hg) hd₁

  let B : Subring K :=
    { carrier := {z | ∃ (n : ℕ) (a : A),
        algebraMap A K a = algebraMap A K (h * g * d₁) ^ n * z}
      zero_mem' := ⟨0, 0, by simp⟩
      one_mem' := ⟨0, 1, by simp⟩
      add_mem' := by
        rintro z₁ z₂ ⟨n, a, ha⟩ ⟨m, b, hb⟩
        refine ⟨n + m, (h * g * d₁) ^ m * a + (h * g * d₁) ^ n * b, ?_⟩
        simp only [map_add, map_mul, map_pow] at ha hb ⊢
        rw [ha, hb]
        ring
      mul_mem' := by
        rintro z₁ z₂ ⟨n, a, ha⟩ ⟨m, b, hb⟩
        refine ⟨n + m, a * b, ?_⟩
        rw [map_mul, ha, hb]
        ring
      neg_mem' := by
        rintro z ⟨n, a, ha⟩
        refine ⟨n, -a, ?_⟩
        rw [map_neg, ha]
        ring }
  have hB : ∀ z : K, z ∈ B ↔ wcLlsKPLoc A K 0 (h * g * d₁) z := fun z => (T0 _ z).symm
  have hBA : ∀ a : A, algebraMap A K a ∈ B := fun a => ⟨0, a, by simp⟩
  have hDB : ∀ z ∈ B, D z ∈ B := by
    intro z hz
    have h1 := hD5 z (h * g * d₁) hG ((hB z).mp hz)
    obtain ⟨n, a, ha⟩ := (T0 _ _).mp h1
    refine ⟨2 * n, (g * d₁) ^ n * a, ?_⟩
    simp only [map_mul, map_pow] at ha ⊢
    rw [ha]
    ring
  obtain ⟨ρ', hρ'⟩ := hρℓ
  have hℓK : ((ℓ : ℕ) : K) = algebraMap A K (algebraMap ↥W A ρ) *
      algebraMap A K (algebraMap ↥W A ρ') := by
    rw [← map_mul, ← map_mul, ← hρ', map_natCast, map_natCast]
  obtain ⟨e', he', hfin⟩ := wcLlsKP_bauc_desc ℓ hℓ K B D hD1 hD2 hDB (algebraMap A K t)
    (algebraMap A K (algebraMap ↥W A ρ)) (algebraMap A K (algebraMap ↥W A ρ')) (hBA t) hD4
    (hBA _) (hD3 ρ) (hBA _) hℓK c e y x
    (fun i => (hB _).mpr (TD _ _ _ (hc i) ⟨h * d₁, by ring⟩))
    ((hB _).mpr (TD _ _ _ he ⟨h * d₁, by ring⟩))
    ((hB _).mpr (TD _ _ _ hLy ⟨h * g, by ring⟩)) hx hDxy
  exact ⟨c 0, e', h * g * d₁, hG, TD _ _ _ (hc 0) ⟨h * d₁, by ring⟩, (hB _).mp he', hfin⟩

theorem wcLlsKP_bau_caseA : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω ≠ ℓ → ringChar (IsLocalRing.ResidueField ↥W) = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    (∀ (x : K) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d x → x ≠ 0 →
      ∃ (π : ↥W) (x' : K) (d' : A), π ≠ 0 ∧ d' ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d' x' ∧
        x = algebraMap A K (algebraMap ↥W A π) * x' ∧
        ∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' x') →
    ∀ (h : A) (D : K → K), h ∉ 𝔭 → (∀ x y, D (x + y) = D x + D y) →
      (∀ x y, D (x * y) = x * D y + y * D x) →
      (∀ w : ↥W, D (algebraMap A K (algebraMap ↥W A w)) = 0) → D (algebraMap A K t) = 1 →
      (∀ (x : K) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 (h * d) (D x)) →
      (∀ (x : K) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d x →
        ∀ ρ : ↥W, ρ ≠ 0 → ρ ∣ ((ℓ : ℕ) : ↥W) →
        (∃ (d₁ : A) (y : K), d₁ ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d₁ y ∧
          D x = algebraMap A K (algebraMap ↥W A ρ) * y) →
        ∃ (s e : K) (d₂ : A), d₂ ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d₂ s ∧ wcLlsKPLoc A K 0 d₂ e ∧
          x - s ^ ℓ = algebraMap A K (algebraMap ↥W A ρ) * e) →
    ∀ (f₁ : K) (d₁ : A), d₁ ∉ 𝔭 → wcLlsKPLoc A K 0 d₁ f₁ → wcLlsKPLoc A K 0 d₁ f₁⁻¹ →
      (∃ x z : K, wcLlsKPLoc A K 0 d₁ x ∧ wcLlsKPMLoc W A K 0 d₁ z ∧
        f₁ - 1 = algebraMap A K t * x + z) →
      (¬ ∃ (s r : K) (d : A), d ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d s ∧ wcLlsKPLoc A K 0 d r ∧
        f₁ - s ^ ℓ = (ℓ : K) * r) →
      (∀ (γ ε₀ : ↥W) (h' : K) (d : A), d ∉ 𝔭 → IsUnit ε₀ →
        ((ℓ : ℕ) : ↥W) = γ ^ (ℓ - 1) * ε₀ → wcLlsKPLoc A K 0 d h' →
        wcLlsKPLoc A K 0 d ((f₁ - h' ^ ℓ) / algebraMap A K (algebraMap ↥W A γ) ^ ℓ) → False) →
      ∃ (k q : K) (γ₁ : ↥W) (d : A), d ∉ 𝔭 ∧ k ≠ 0 ∧ γ₁ ≠ 0 ∧
        wcLlsKPLoc A K 0 d k ∧ wcLlsKPLoc A K 0 d k⁻¹ ∧ wcLlsKPLoc A K 0 d q ∧
        f₁ * k ^ ℓ - 1 = algebraMap A K (algebraMap ↥W A γ₁) ^ ℓ * q ∧
        (∃ x z : K, wcLlsKPLoc A K 0 d x ∧ wcLlsKPMLoc W A K 0 d z ∧
          f₁ * k ^ ℓ - 1 = algebraMap A K t * x + z) ∧
        ∀ (e : K) (d' : A), d' ∉ 𝔭 → wcLlsKPLoc A K 0 d' e →
          ¬ wcLlsKPMLoc W A K 0 d' (q - e ^ ℓ) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hΩ hκ A _ _ _ K _ _ _ 𝔭 t hPD hcont h D hh hD1 hD2 hD3 hD4 hD5
    hcart f₁ d₁ hd₁ hL1 hL2 hPU hA hNoAS

  have T0 : ∀ (d : A) (x : K), wcLlsKPLoc A K 0 d x ↔
      ∃ (n : ℕ) (a : A), algebraMap A K a = algebraMap A K d ^ n * x := by
    intro d x
    have hbot : Algebra.adjoin A ({0} : Set K) = ⊥ := by
      apply le_antisymm
      · rw [Algebra.adjoin_le_iff]
        intro z hz
        rw [Set.mem_singleton_iff.mp hz]
        exact Subalgebra.zero_mem _
      · exact bot_le
    unfold wcLlsKPLoc
    rw [hbot]
    constructor
    · rintro ⟨n, hn⟩
      obtain ⟨a, ha⟩ := Algebra.mem_bot.mp hn
      exact ⟨n, a, ha⟩
    · rintro ⟨n, a, ha⟩
      exact ⟨n, Algebra.mem_bot.mpr ⟨a, ha⟩⟩
  have T2 : ∀ (d d' : A) (x z : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d' z →
      wcLlsKPLoc A K 0 (d * d') (x * z) := by
    intro d d' x z hx hz
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    obtain ⟨n', a', ha'⟩ := (T0 d' z).mp hz
    refine (T0 _ _).mpr ⟨n + n', a * a' * (d ^ n' * d' ^ n), ?_⟩
    simp only [map_mul, map_pow, ha, ha']
    ring
  have T3 : ∀ (d e : A) (x : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 (e * d) x := by
    intro d e x hx
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    refine (T0 _ _).mpr ⟨n, e ^ n * a, ?_⟩
    simp only [map_mul, map_pow, ha]
    ring
  have T4 : ∀ (d : A) (x : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d (x ^ ℓ) := by
    intro d x hx
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    refine (T0 _ _).mpr ⟨n * ℓ, a ^ ℓ, ?_⟩
    rw [map_pow, ha, mul_pow, ← pow_mul]
  have TD : ∀ (d e : A) (x : K), wcLlsKPLoc A K 0 d x → d ∣ e → wcLlsKPLoc A K 0 e x := by
    intro d e x hx hde
    obtain ⟨c, rfl⟩ := hde
    have := T3 d c x hx
    rwa [mul_comm] at this
  have hPrime : 𝔭.IsPrime := hPD.2.2.2.1.isPrime
  have T5 : ∀ a b : A, a ∉ 𝔭 → b ∉ 𝔭 → a * b ∉ 𝔭 := fun a b ha hb hab =>
    (hPrime.mem_or_mem hab).elim ha hb
  have TP : ∀ (a : A) (n : ℕ), a ∉ 𝔭 → a ^ n ∉ 𝔭 := fun a n ha h =>
    ha (hPrime.mem_of_pow_mem n h)
  have hm𝔭 : Ideal.map (algebraMap ↥W A) (IsLocalRing.maximalIdeal ↥W) ≤ 𝔭 := hPD.2.2.2.2.1
  have ht𝔭 : t ∈ 𝔭 := hPD.2.2.2.2.2.1
  have hℓm : ((ℓ : ℕ) : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [← IsLocalRing.residue_eq_zero_iff, map_natCast]
    exact (ringChar.spec _ ℓ).mpr (by rw [hκ])
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h1 => hPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  have hℓ1 : 1 ≤ ℓ := hℓ.one_lt.le

  have LA : ∀ (d : A) (x y : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d y →
      wcLlsKPLoc A K 0 d (x + y) := by
    intro d x y hx hy
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    obtain ⟨m, b, hb⟩ := (T0 d y).mp hy
    refine (T0 _ _).mpr ⟨n + m, a * d ^ m + b * d ^ n, ?_⟩
    simp only [map_add, map_mul, map_pow, ha, hb]
    ring
  have LN : ∀ (d : A) (x : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d (-x) := by
    intro d x hx
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    exact (T0 _ _).mpr ⟨n, -a, by rw [map_neg, ha]; ring⟩
  have LS : ∀ (d : A) (x y : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d y →
      wcLlsKPLoc A K 0 d (x - y) := by
    intro d x y hx hy
    rw [sub_eq_add_neg]
    exact LA _ _ _ hx (LN _ _ hy)
  have LM : ∀ (d : A) (x y : K), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d y →
      wcLlsKPLoc A K 0 d (x * y) := by
    intro d x y hx hy
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    obtain ⟨m, b, hb⟩ := (T0 d y).mp hy
    refine (T0 _ _).mpr ⟨n + m, a * b, ?_⟩
    simp only [map_mul, ha, hb]
    ring
  have LP : ∀ (d : A) (x : K) (j : ℕ), wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d (x ^ j) := by
    intro d x j hx
    obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
    exact (T0 _ _).mpr ⟨n * j, a ^ j, by rw [map_pow, ha, mul_pow, ← pow_mul]⟩
  have LC : ∀ (d a : A), wcLlsKPLoc A K 0 d (algebraMap A K a) := by
    intro d a
    exact (T0 _ _).mpr ⟨0, a, by rw [pow_zero, one_mul]⟩

  have MA : ∀ (d : A) (π₁ π₂ : ↥W) (a b : K), π₁ ∈ IsLocalRing.maximalIdeal ↥W →
      π₂ ∈ IsLocalRing.maximalIdeal ↥W → wcLlsKPLoc A K 0 d a → wcLlsKPLoc A K 0 d b →
      wcLlsKPMLoc W A K 0 d (algebraMap A K (algebraMap ↥W A π₁) * a +
        algebraMap A K (algebraMap ↥W A π₂) * b) := by
    intro d π₁ π₂ a b h₁ h₂ ha hb
    rcases ValuationRing.dvd_total π₁ π₂ with ⟨c, hc⟩ | ⟨c, hc⟩
    · refine ⟨π₁, h₁, a + algebraMap A K (algebraMap ↥W A c) * b,
        LA _ _ _ ha (LM _ _ _ (LC _ _) hb), ?_⟩
      rw [hc]
      simp only [map_mul]
      ring
    · refine ⟨π₂, h₂, algebraMap A K (algebraMap ↥W A c) * a + b,
        LA _ _ _ (LM _ _ _ (LC _ _) ha) hb, ?_⟩
      rw [hc]
      simp only [map_mul]
      ring

  have D1 : D 1 = 0 := by
    have := hD3 1
    rwa [map_one, map_one] at this
  have Dsub : ∀ x y, D (x - y) = D x - D y := by
    intro x y
    have := hD1 (x - y) y
    rw [sub_add_cancel] at this
    linear_combination -this
  have DwK : ∀ (c : ↥W) (x : K), D (algebraMap A K (algebraMap ↥W A c) * x) =
      algebraMap A K (algebraMap ↥W A c) * D x := by
    intro c x
    rw [hD2, hD3, mul_zero, add_zero]
  have Dpow : ∀ (n : ℕ) (x : K), D (x ^ (n + 1)) = ((n + 1 : ℕ) : K) * x ^ n * D x := by
    intro n x
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ, hD2, ih]
      push_cast
      ring
  have DpowL : ∀ x : K, D (x ^ ℓ) = (ℓ : K) * x ^ (ℓ - 1) * D x := by
    intro x
    have := Dpow (ℓ - 1) x
    rwa [Nat.sub_add_cancel hℓ1] at this
  have NC : algebraMap A K (algebraMap ↥W A ((ℓ : ℕ) : ↥W)) = ((ℓ : ℕ) : K) := by
    rw [map_natCast, map_natCast]
  have hℓ0 : ((ℓ : ℕ) : ↥W) ≠ 0 := by
    intro h0
    have h1 : ((ℓ : ℕ) : Ω) = 0 := by
      have := congrArg (algebraMap ↥W Ω) h0
      rwa [map_natCast, map_zero] at this
    have h2 : ringChar Ω ∣ ℓ := ringChar.dvd h1
    rcases Nat.Prime.eq_one_or_self_of_dvd hℓ _ h2 with h3 | h3
    · exact CharP.ringChar_ne_one h3
    · exact hΩ h3

  have dtest : ∀ q : K, (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' (D q)) →
      ∀ (e : K) (d' : A), d' ∉ 𝔭 → wcLlsKPLoc A K 0 d' e →
        ¬ wcLlsKPMLoc W A K 0 d' (q - e ^ ℓ) := by
    intro q hq e d' hd' he hM
    obtain ⟨π, hπ, x'', hx'', hxx⟩ := hM
    apply hq (h * d') (T5 _ _ hh hd')
    have hDq : D q = algebraMap A K (algebraMap ↥W A ((ℓ : ℕ) : ↥W)) * (e ^ (ℓ - 1) * D e) +
        algebraMap A K (algebraMap ↥W A π) * D x'' := by
      have e1 : D q = D (q - e ^ ℓ) + D (e ^ ℓ) := by rw [← hD1, sub_add_cancel]
      rw [e1, hxx, DwK, DpowL, NC]
      ring
    rw [hDq]
    exact MA _ _ _ _ _ hℓm hπ (LM _ _ _ (LP _ _ _ (T3 d' h e he)) (hD5 e d' hd' he))
      (hD5 x'' d' hd' hx'')

  have G2 : ∀ (y : K) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d y →
      D f₁ ≠ algebraMap A K (algebraMap ↥W A ((ℓ : ℕ) : ↥W)) * y := by
    intro y d hd hy heq
    obtain ⟨s, e, d₂, hd₂, hs, he, hse⟩ :=
      hcart f₁ d₁ hd₁ hL1 ((ℓ : ℕ) : ↥W) hℓ0 (dvd_refl _) ⟨d, y, hd, hy, heq⟩
    exact hA ⟨s, e, d₂, hd₂, hs, he, by rw [hse, NC]⟩
  have G3 : D f₁ ≠ 0 := by
    intro h0
    have hL0 : wcLlsKPLoc A K 0 1 (0 : K) := by
      have := LC 1 0
      rwa [map_zero] at this
    exact G2 0 1 h1𝔭 hL0 (by rw [h0, mul_zero])
  obtain ⟨ρ₀, y₀, d₀, hρ₀, hd₀, hLy₀, hDf, hy₀⟩ :=
    hcont (D f₁) (h * d₁) (T5 _ _ hh hd₁) (hD5 f₁ d₁ hd₁ hL1) G3
  have hR : algebraMap A K (algebraMap ↥W A ρ₀) ≠ 0 := by
    intro h0
    apply G3
    rw [hDf, h0, zero_mul]
  have G2' : ∀ c : ↥W, ρ₀ ≠ ((ℓ : ℕ) : ↥W) * c := by
    intro c hc
    apply G2 (algebraMap A K (algebraMap ↥W A c) * y₀) d₀ hd₀ (LM _ _ _ (LC _ _) hLy₀)
    rw [hDf, hc]
    simp only [map_mul]
    ring
  by_cases hρm : ρ₀ ∈ IsLocalRing.maximalIdeal ↥W
  ·
    rcases ValuationRing.dvd_total ((ℓ : ℕ) : ↥W) ρ₀ with ⟨c, hc⟩ | ⟨μ, hμ⟩
    · exact absurd hc (G2' c)
    have hμm : μ ∈ IsLocalRing.maximalIdeal ↥W := by
      by_contra hμn
      obtain ⟨w, hw⟩ := (IsLocalRing.notMem_maximalIdeal.mp hμn).exists_right_inv
      apply G2' w
      calc ρ₀ = ρ₀ * μ * w := by rw [mul_assoc, hw, mul_one]
        _ = ((ℓ : ℕ) : ↥W) * w := by rw [← hμ]
    obtain ⟨s, e, d₂, hd₂, hLs, hLe, hse⟩ :=
      hcart f₁ d₁ hd₁ hL1 ρ₀ hρ₀ ⟨μ, hμ⟩ ⟨d₀, y₀, hd₀, hLy₀, hDf⟩

    obtain ⟨n, a, ha⟩ := (T0 d₂ s).mp hLs
    obtain ⟨n₁, b, hb⟩ := (T0 d₂ e).mp hLe
    obtain ⟨x, z, hx, hz, hxz⟩ := hPU
    obtain ⟨n₂, ax, hax⟩ := (T0 d₁ x).mp hx
    obtain ⟨π, hπ, z', hz', hzz⟩ := hz
    obtain ⟨n₃, az, haz⟩ := (T0 d₁ z').mp hz'
    have hπ𝔭 : algebraMap ↥W A π ∈ 𝔭 := hm𝔭 (Ideal.mem_map_of_mem _ hπ)
    have hρ𝔭 : algebraMap ↥W A ρ₀ ∈ 𝔭 := hm𝔭 (Ideal.mem_map_of_mem _ hρm)
    have hE : d₂ ^ n₁ * d₁ ^ n₂ * d₁ ^ n₃ ∉ 𝔭 :=
      T5 _ _ (T5 _ _ (TP _ _ hd₂) (TP _ _ hd₁)) (TP _ _ hd₁)
    have hEqA : a ^ ℓ * (d₂ ^ n₁ * d₁ ^ n₂ * d₁ ^ n₃) = (d₂ ^ n) ^ ℓ *
        (d₂ ^ n₁ * d₁ ^ n₂ * d₁ ^ n₃ + (t * ax * d₂ ^ n₁ * d₁ ^ n₃ +
          algebraMap ↥W A π * az * d₂ ^ n₁ * d₁ ^ n₂ -
            algebraMap ↥W A ρ₀ * b * d₁ ^ n₂ * d₁ ^ n₃)) := by
      apply IsFractionRing.injective A K
      simp only [map_mul, map_pow, map_add, map_sub]
      rw [ha, hb, hax, haz]
      linear_combination ((algebraMap A K d₂) ^ n) ^ ℓ * (algebraMap A K d₂ ^ n₁ *
        algebraMap A K d₁ ^ n₂ * algebraMap A K d₁ ^ n₃) * (-hse + hxz + hzz)
    have ha0 : a ∉ 𝔭 := by
      intro haP
      have h1 : a ^ ℓ * (d₂ ^ n₁ * d₁ ^ n₂ * d₁ ^ n₃) ∈ 𝔭 :=
        𝔭.mul_mem_right _ (Ideal.pow_mem_of_mem 𝔭 haP ℓ hℓ.pos)
      rw [hEqA] at h1
      rcases hPrime.mem_or_mem h1 with h2 | h2
      · exact TP _ _ (TP _ _ hd₂) h2
      · apply hE
        have hX : t * ax * d₂ ^ n₁ * d₁ ^ n₃ + algebraMap ↥W A π * az * d₂ ^ n₁ * d₁ ^ n₂ -
            algebraMap ↥W A ρ₀ * b * d₁ ^ n₂ * d₁ ^ n₃ ∈ 𝔭 :=
          𝔭.sub_mem (𝔭.add_mem (𝔭.mul_mem_right _ (𝔭.mul_mem_right _ (𝔭.mul_mem_right _ ht𝔭)))
            (𝔭.mul_mem_right _ (𝔭.mul_mem_right _ (𝔭.mul_mem_right _ hπ𝔭))))
            (𝔭.mul_mem_right _ (𝔭.mul_mem_right _ (𝔭.mul_mem_right _ hρ𝔭)))
        exact (Ideal.add_mem_iff_left 𝔭 hX).mp h2
    have hs0 : s ≠ 0 := by
      intro hs
      apply ha0
      have : algebraMap A K a = 0 := by rw [ha, hs, mul_zero]
      rw [(IsFractionRing.injective A K) (this.trans (map_zero _).symm)]
      exact 𝔭.zero_mem
    have hLsi : wcLlsKPLoc A K 0 a s⁻¹ :=
      (T0 a s⁻¹).mpr ⟨1, d₂ ^ n, by rw [map_pow, pow_one, ha, mul_assoc, mul_inv_cancel₀ hs0,
        mul_one]⟩
    have hss : s ^ ℓ * (s⁻¹) ^ ℓ = 1 := by rw [← mul_pow, mul_inv_cancel₀ hs0, one_pow]

    obtain ⟨z0, hz0⟩ := IsAlgClosed.exists_pow_nat_eq (ρ₀ : Ω) hℓ.pos
    have hint : IsIntegral ↥W z0 := by
      refine ⟨Polynomial.X ^ ℓ - Polynomial.C ρ₀, Polynomial.monic_X_pow_sub_C _ hℓ.ne_zero, ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hz0]
      exact sub_self _
    obtain ⟨γ₁, hγ₁⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    have hγρ : γ₁ ^ ℓ = ρ₀ := by
      apply IsFractionRing.injective ↥W Ω
      rw [map_pow, hγ₁, hz0]
      rfl
    have hγ0 : γ₁ ≠ 0 := by
      rintro rfl
      apply hρ₀
      rw [← hγρ, zero_pow hℓ.ne_zero]
    have hRγ : algebraMap A K (algebraMap ↥W A γ₁) ^ ℓ = algebraMap A K (algebraMap ↥W A ρ₀) := by
      rw [← map_pow, ← map_pow, hγρ]
    have hd : d₂ * a ∉ 𝔭 := T5 _ _ hd₂ ha0
    have hLk : wcLlsKPLoc A K 0 (d₂ * a) s⁻¹ := T3 a d₂ _ hLsi
    have hLq : wcLlsKPLoc A K 0 (d₂ * a) (e * (s⁻¹) ^ ℓ) := T2 d₂ a e _ hLe (T4 a _ hLsi)
    have hEq : f₁ * (s⁻¹) ^ ℓ - 1 =
        algebraMap A K (algebraMap ↥W A γ₁) ^ ℓ * (e * (s⁻¹) ^ ℓ) := by
      rw [hRγ]
      linear_combination (s⁻¹) ^ ℓ * hse + hss
    have hRq : algebraMap A K (algebraMap ↥W A ρ₀) * (e * (s⁻¹) ^ ℓ) = f₁ * (s⁻¹) ^ ℓ - 1 := by
      rw [hEq, hRγ]

    have hℓR : ((ℓ : ℕ) : K) = algebraMap A K (algebraMap ↥W A ρ₀) *
        algebraMap A K (algebraMap ↥W A μ) := by
      rw [← NC, hμ, map_mul, map_mul]
    have hDRq : algebraMap A K (algebraMap ↥W A ρ₀) * D (e * (s⁻¹) ^ ℓ) =
        f₁ * ((ℓ : K) * (s⁻¹) ^ (ℓ - 1) * D s⁻¹) +
          (s⁻¹) ^ ℓ * (algebraMap A K (algebraMap ↥W A ρ₀) * y₀) := by
      rw [← DwK, hRq, Dsub, D1, sub_zero, hD2, DpowL, hDf]
    have hstar : D (e * (s⁻¹) ^ ℓ) = (s⁻¹) ^ ℓ * y₀ +
        algebraMap A K (algebraMap ↥W A μ) * (f₁ * (s⁻¹) ^ (ℓ - 1) * D s⁻¹) := by
      apply mul_left_cancel₀ hR
      rw [hDRq, hℓR]
      ring
    have hnr : ∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' (D (e * (s⁻¹) ^ ℓ)) := by
      rintro d'' hd'' ⟨π', hπ', w, hw, hDw⟩
      apply hy₀ (h * (d₂ * a) * d'' * d₁) (T5 _ _ (T5 _ _ (T5 _ _ hh hd) hd'') hd₁)
      have hy : y₀ = algebraMap A K (algebraMap ↥W A π') * (s ^ ℓ * w) +
          algebraMap A K (algebraMap ↥W A μ) * (-(s ^ ℓ * (f₁ * (s⁻¹) ^ (ℓ - 1) * D s⁻¹))) := by
        linear_combination (-y₀) * hss + s ^ ℓ * hDw - s ^ ℓ * hstar
      have hLs' : wcLlsKPLoc A K 0 (h * (d₂ * a) * d'' * d₁) s :=
        TD d₂ _ s hLs ⟨h * a * d'' * d₁, by ring⟩
      rw [hy]
      refine MA _ π' μ _ _ hπ' hμm ?_ ?_
      · exact LM _ _ _ (LP _ _ _ hLs') (TD d'' _ w hw ⟨h * (d₂ * a) * d₁, by ring⟩)
      · exact LN _ _ (LM _ _ _ (LP _ _ _ hLs')
          (LM _ _ _ (LM _ _ _ (TD d₁ _ f₁ hL1 ⟨h * (d₂ * a) * d'', by ring⟩)
            (LP _ _ _ (TD a _ _ hLsi ⟨h * d₂ * d'' * d₁, by ring⟩)))
            (TD _ _ _ (hD5 _ _ hd hLk) ⟨d'' * d₁, by ring⟩)))
    refine ⟨s⁻¹, e * (s⁻¹) ^ ℓ, γ₁, d₂ * a, hd, inv_ne_zero hs0, hγ0, hLk, ?_, hLq, hEq, ?_,
      dtest _ hnr⟩
    · rw [inv_inv]
      exact TD d₂ _ s hLs (dvd_mul_right d₂ a)
    · have hL0 : wcLlsKPLoc A K 0 (d₂ * a) (0 : K) := by
        have := LC (d₂ * a) 0
        rwa [map_zero] at this
      refine ⟨0, algebraMap A K (algebraMap ↥W A ρ₀) * (e * (s⁻¹) ^ ℓ), hL0,
        ⟨ρ₀, hρm, _, hLq, rfl⟩, ?_⟩
      rw [mul_zero, zero_add, hRq]
  ·
    obtain ⟨v, hv⟩ := (IsLocalRing.notMem_maximalIdeal.mp hρm).exists_right_inv
    have L1 : wcLlsKPLoc A K 0 d₁ (1 : K) := by
      have := LC d₁ 1
      rwa [map_one] at this
    refine ⟨1, f₁ - 1, 1, d₁, hd₁, one_ne_zero, one_ne_zero, L1, by rw [inv_one]; exact L1,
      LS _ _ _ hL1 L1, by simp, ?_, ?_⟩
    · obtain ⟨x, z, hx, hz, hxz⟩ := hPU
      exact ⟨x, z, hx, hz, by rw [one_pow, mul_one]; exact hxz⟩
    · apply dtest
      rintro d'' hd'' ⟨π, hπ, w, hw, hDw⟩
      rw [Dsub, D1, sub_zero] at hDw
      apply hy₀ d'' hd''
      refine ⟨v * π, Ideal.mul_mem_left _ v hπ, w, hw, ?_⟩
      have hv' : algebraMap A K (algebraMap ↥W A ρ₀) * algebraMap A K (algebraMap ↥W A v) = 1 := by
        rw [← map_mul, ← map_mul, hv, map_one, map_one]
      simp only [map_mul]
      linear_combination (-y₀) * hv' + algebraMap A K (algebraMap ↥W A v) * hDw -
        algebraMap A K (algebraMap ↥W A v) * hDf

theorem wcLlsKP_bcB_mA_prime : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (x y : K) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d x → wcLlsKPLoc A K 0 d y →
      (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' x) →
      (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' y) →
      ∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' (x * y) :=
by
  intro Ω _ _ W _hW _hWt A _ _ _ K _ _ _ 𝔭 t hPD x y d hd hx hy hNx hNy d'' hd'' hM
  classical
  have T0 : ∀ (d : A) (x : K), wcLlsKPLoc A K 0 d x ↔
      ∃ (n : ℕ) (a : A), algebraMap A K a = algebraMap A K d ^ n * x := by
    intro d x
    have hbot : Algebra.adjoin A ({0} : Set K) = ⊥ := by
      apply le_antisymm
      · rw [Algebra.adjoin_le_iff]
        intro z hz
        rw [Set.mem_singleton_iff.mp hz]
        exact Subalgebra.zero_mem _
      · exact bot_le
    unfold wcLlsKPLoc
    rw [hbot]
    constructor
    · rintro ⟨n, hn⟩
      obtain ⟨a, ha⟩ := Algebra.mem_bot.mp hn
      exact ⟨n, a, ha⟩
    · rintro ⟨n, a, ha⟩
      exact ⟨n, Algebra.mem_bot.mpr ⟨a, ha⟩⟩
  haveI hPrime : 𝔭.IsPrime := hPD.2.2.2.1.isPrime
  have T5 : ∀ a b : A, a ∉ 𝔭 → b ∉ 𝔭 → a * b ∉ 𝔭 := fun a b ha hb hab =>
    (hPrime.mem_or_mem hab).elim ha hb
  have TP : ∀ (a : A) (n : ℕ), a ∉ 𝔭 → a ^ n ∉ 𝔭 := fun a n ha h =>
    ha (hPrime.mem_of_pow_mem n h)
  have hne : ∀ e : A, e ∉ 𝔭 → algebraMap A K e ≠ 0 := by
    intro e he h0
    apply he
    have : e = 0 := IsFractionRing.injective A K (h0.trans (map_zero _).symm)
    rw [this]
    exact 𝔭.zero_mem
  have hm𝔭 : Ideal.map (algebraMap ↥W A) (IsLocalRing.maximalIdeal ↥W) ≤ 𝔭 := hPD.2.2.2.2.1
  obtain ⟨-, h𝔭eq, h, hh, f₀, hC, hX, hEt⟩ := hPD.2.2.2.2.2

  obtain ⟨hdom, -⟩ := wcLlsKP_ed_chart_special_dvr Ω W A 𝔭 t h f₀ hm𝔭 hh
    (by rw [← h𝔭eq]) hC hX hEt
  have hJ : (Ideal.map (algebraMap A (Localization.AtPrime 𝔭))
      (Ideal.map (algebraMap ↥W A) (IsLocalRing.maximalIdeal ↥W))).IsPrime :=
    (Ideal.Quotient.isDomain_iff_prime _).mp hdom

  have s2 : ∀ z ∈ Ideal.map (algebraMap ↥W A) (IsLocalRing.maximalIdeal ↥W),
      ∃ π ∈ IsLocalRing.maximalIdeal ↥W, ∃ c : A, z = algebraMap ↥W A π * c := by
    intro z hz
    have hz' : z ∈ Submodule.span A
        (⇑(algebraMap ↥W A) '' (IsLocalRing.maximalIdeal ↥W : Set ↥W)) := hz
    clear hz
    induction hz' using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨π, hπ, rfl⟩ := hz
      exact ⟨π, hπ, 1, (mul_one _).symm⟩
    | zero => exact ⟨0, Ideal.zero_mem _, 0, by simp⟩
    | add z₁ z₂ _ _ ih₁ ih₂ =>
      obtain ⟨π₁, hπ₁, c₁, rfl⟩ := ih₁
      obtain ⟨π₂, hπ₂, c₂, rfl⟩ := ih₂
      rcases ValuationRing.dvd_total π₁ π₂ with ⟨μ, hμ⟩ | ⟨μ, hμ⟩
      · refine ⟨π₁, hπ₁, c₁ + algebraMap ↥W A μ * c₂, ?_⟩
        rw [hμ, map_mul]
        ring
      · refine ⟨π₂, hπ₂, algebraMap ↥W A μ * c₁ + c₂, ?_⟩
        rw [hμ, map_mul]
        ring
    | smul a z' _ ih =>
      obtain ⟨π, hπ, c, rfl⟩ := ih
      exact ⟨π, hπ, a * c, by rw [smul_eq_mul]; ring⟩

  have s3 : ∀ a : A, algebraMap A (Localization.AtPrime 𝔭) a ∈
      Ideal.map (algebraMap A (Localization.AtPrime 𝔭))
        (Ideal.map (algebraMap ↥W A) (IsLocalRing.maximalIdeal ↥W)) →
      ∃ (s : A) (π : ↥W) (c : A), s ∉ 𝔭 ∧ π ∈ IsLocalRing.maximalIdeal ↥W ∧
        s * a = algebraMap ↥W A π * c := by
    intro a ha
    obtain ⟨⟨⟨i, hi⟩, ⟨s₀, hs₀⟩⟩, hxs⟩ :=
      (IsLocalization.mem_map_algebraMap_iff 𝔭.primeCompl (Localization.AtPrime 𝔭)).mp ha
    simp only at hxs
    rw [← map_mul] at hxs
    obtain ⟨⟨u, hu⟩, hu'⟩ :=
      (IsLocalization.eq_iff_exists 𝔭.primeCompl (Localization.AtPrime 𝔭)).mp hxs
    simp only at hu'
    obtain ⟨π, hπ, c₀, rfl⟩ := s2 i hi
    refine ⟨u * s₀, π, u * c₀, T5 _ _ (Ideal.mem_primeCompl_iff.mp hu)
      (Ideal.mem_primeCompl_iff.mp hs₀), hπ, ?_⟩
    linear_combination hu'

  have s4 : ∀ (z : K) (n : ℕ) (a s c : A) (π : ↥W),
      algebraMap A K a = algebraMap A K d ^ n * z →
      s ∉ 𝔭 → π ∈ IsLocalRing.maximalIdeal ↥W → s * a = algebraMap ↥W A π * c →
      wcLlsKPMLoc W A K 0 (d * s) z := by
    intro z n a s c π ha hs hπ hsa
    have hs0 := hne s hs
    have hdn0 : algebraMap A K d ^ n ≠ 0 := pow_ne_zero _ (hne d hd)
    have e1 : algebraMap A K s * (algebraMap A K d ^ n * z) =
        algebraMap A K (algebraMap ↥W A π) * algebraMap A K c := by
      rw [← ha, ← map_mul, hsa, map_mul]
    have k1 : algebraMap A K s * (algebraMap A K s)⁻¹ = 1 := mul_inv_cancel₀ hs0
    have k2 : algebraMap A K d ^ n * (algebraMap A K d ^ n)⁻¹ = 1 := mul_inv_cancel₀ hdn0
    refine ⟨π, hπ, algebraMap A K c * (algebraMap A K s)⁻¹ * (algebraMap A K d ^ n)⁻¹, ?_, ?_⟩
    · refine (T0 _ _).mpr ⟨n + 1, d * s ^ n * c, ?_⟩
      simp only [map_mul, map_pow]
      linear_combination
        (-(algebraMap A K d * algebraMap A K s ^ n * algebraMap A K c *
          (algebraMap A K d ^ n * (algebraMap A K d ^ n)⁻¹))) * k1 -
        (algebraMap A K d * algebraMap A K s ^ n * algebraMap A K c) * k2
    · linear_combination (algebraMap A K s)⁻¹ * (algebraMap A K d ^ n)⁻¹ * e1 -
        z * (algebraMap A K d ^ n * (algebraMap A K d ^ n)⁻¹) * k1 - z * k2

  obtain ⟨π, hπ, x', hx', hxy⟩ := hM
  obtain ⟨n, a, ha⟩ := (T0 d x).mp hx
  obtain ⟨k, b, hb⟩ := (T0 d y).mp hy
  obtain ⟨N, c, hc⟩ := (T0 d'' x').mp hx'
  have key : a * b * d'' ^ N = algebraMap ↥W A π * (d ^ (n + k) * c) := by
    apply IsFractionRing.injective A K
    simp only [map_mul, map_pow]
    rw [ha, hb, hc]
    linear_combination
      (algebraMap A K d ^ n * algebraMap A K d ^ k * algebraMap A K d'' ^ N) * hxy
  have hmem : algebraMap A (Localization.AtPrime 𝔭) (a * b * d'' ^ N) ∈
      Ideal.map (algebraMap A (Localization.AtPrime 𝔭))
        (Ideal.map (algebraMap ↥W A) (IsLocalRing.maximalIdeal ↥W)) := by
    apply Ideal.mem_map_of_mem
    rw [key]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hπ)
  rw [map_mul, map_mul] at hmem
  have hunit : IsUnit (algebraMap A (Localization.AtPrime 𝔭) (d'' ^ N)) :=
    IsLocalization.map_units (Localization.AtPrime 𝔭)
      (⟨d'' ^ N, Ideal.mem_primeCompl_iff.mpr (TP d'' N hd'')⟩ : 𝔭.primeCompl)
  rcases hJ.mem_or_mem hmem with hab | hdN
  · rcases hJ.mem_or_mem hab with ha' | hb'
    · obtain ⟨s, π₁, c₁, hs, hπ₁, hsa⟩ := s3 a ha'
      exact hNx (d * s) (T5 _ _ hd hs) (s4 x n a s c₁ π₁ ha hs hπ₁ hsa)
    · obtain ⟨s, π₁, c₁, hs, hπ₁, hsa⟩ := s3 b hb'
      exact hNy (d * s) (T5 _ _ hd hs) (s4 y k b s c₁ π₁ hb hs hπ₁ hsa)
  · exact hJ.ne_top (Ideal.eq_top_of_isUnit_mem _ hdN hunit)

theorem wcLlsKP_bcB_residue_normal : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (n : ℕ) (b s g : K) (d : A), 1 ≤ n → d ∉ 𝔭 → wcLlsKPLoc A K 0 d b →
      wcLlsKPLoc A K 0 d s → wcLlsKPLoc A K 0 d g →
      (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) →
      (∃ d' : A, d' ∉ 𝔭 ∧ wcLlsKPMLoc W A K 0 d' (g * s ^ n - b ^ n)) →
      ∃ (r : K) (d' : A), d' ∉ 𝔭 ∧ wcLlsKPLoc A K 0 d' r ∧
        wcLlsKPMLoc W A K 0 d' (b - r * s) :=
by
  intro Ω _ _ W _hW _hWt A _ _ _ K _ _ _ 𝔭 t hPD n b s g d hn hd hb hs hg _hNM hM
  have T0 : ∀ (d : A) (x : K), wcLlsKPLoc A K 0 d x ↔
      ∃ (n : ℕ) (a : A), algebraMap A K a = algebraMap A K d ^ n * x := by
    intro d x
    have hbot : Algebra.adjoin A ({0} : Set K) = ⊥ := by
      apply le_antisymm
      · rw [Algebra.adjoin_le_iff]
        intro z hz
        rw [Set.mem_singleton_iff.mp hz]
        exact Subalgebra.zero_mem _
      · exact bot_le
    unfold wcLlsKPLoc
    rw [hbot]
    constructor
    · rintro ⟨n, hn⟩
      obtain ⟨a, ha⟩ := Algebra.mem_bot.mp hn
      exact ⟨n, a, ha⟩
    · rintro ⟨n, a, ha⟩
      exact ⟨n, Algebra.mem_bot.mpr ⟨a, ha⟩⟩
  unfold wcLlsPD at hPD
  simp only at hPD
  obtain ⟨_, _, _, hmax, hmA, _, hspan, h, hh, f, hfC, hfX, hfE⟩ := hPD
  haveI hpr : 𝔭.IsPrime := hmax.isPrime
  have T5 : ∀ a b : A, a ∉ 𝔭 → b ∉ 𝔭 → a * b ∉ 𝔭 := fun a b ha hb hab =>
    (hpr.mem_or_mem hab).elim ha hb
  have TP : ∀ (a : A) (n : ℕ), a ∉ 𝔭 → a ^ n ∉ 𝔭 := fun a n ha h =>
    ha (hpr.mem_of_pow_mem n h)
  have hinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hne : ∀ u : A, u ∉ 𝔭 → algebraMap A K u ≠ 0 := by
    intro u hu h0
    apply hu
    rw [hinj (h0.trans (map_zero _).symm)]
    exact 𝔭.zero_mem

  have s1 : ∀ x : A, x ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      ∃ (π : ↥W) (a : A), π ∈ IsLocalRing.maximalIdeal ↥W ∧ x = algebraMap ↥W A π * a := by
    intro x hx
    have hx' : x ∈ Submodule.span A
        (⇑(algebraMap ↥W A) '' ↑(IsLocalRing.maximalIdeal ↥W)) := hx
    clear hx
    induction hx' using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨π, hπ, rfl⟩ := hy
      exact ⟨π, 1, hπ, (mul_one _).symm⟩
    | zero => exact ⟨0, 0, Ideal.zero_mem _, by simp⟩
    | add y z _ _ ihy ihz =>
      obtain ⟨π, a, hπ, rfl⟩ := ihy
      obtain ⟨π', a', hπ', rfl⟩ := ihz
      rcases ValuationRing.dvd_total π π' with ⟨w, rfl⟩ | ⟨w, rfl⟩
      · exact ⟨π, a + algebraMap ↥W A w * a', hπ, by rw [map_mul]; ring⟩
      · exact ⟨π', algebraMap ↥W A w * a + a', hπ', by rw [map_mul]; ring⟩
    | smul c y _ ih =>
      obtain ⟨π, a, hπ, rfl⟩ := ih
      exact ⟨π, c * a, hπ, by rw [smul_eq_mul]; ring⟩

  have hres := wcLlsKP_ed_chart_special_dvr Ω W A 𝔭 t h f hmA hh
    (congrArg (Ideal.map (algebraMap A (Localization.Away h))) hspan) hfC hfX hfE
  generalize hJ : (((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
    (algebraMap A (Localization.AtPrime 𝔭)) : Ideal (Localization.AtPrime 𝔭)) = J at hres
  obtain ⟨hdom, hdvr, -⟩ := hres

  have s2 : ∀ x : A, algebraMap A (Localization.AtPrime 𝔭) x ∈ J →
      ∃ (v : A) (π : ↥W) (a : A), v ∉ 𝔭 ∧ π ∈ IsLocalRing.maximalIdeal ↥W ∧
        v * x = algebraMap ↥W A π * a := by
    intro x hx
    rw [← hJ] at hx
    obtain ⟨⟨⟨y, hy⟩, ⟨w, hw⟩⟩, e1⟩ :=
      (IsLocalization.mem_map_algebraMap_iff 𝔭.primeCompl (Localization.AtPrime 𝔭)).mp hx
    have e1' : algebraMap A (Localization.AtPrime 𝔭) (x * w) =
        algebraMap A (Localization.AtPrime 𝔭) y := by
      rw [map_mul]; exact e1
    obtain ⟨⟨c, hc⟩, e2⟩ :=
      (IsLocalization.eq_iff_exists 𝔭.primeCompl (Localization.AtPrime 𝔭)).mp e1'
    have hc' : c ∉ 𝔭 := hc
    have hw' : w ∉ 𝔭 := hw
    obtain ⟨π, a, hπ, rfl⟩ := s1 y hy
    have e3 : c * (x * w) = c * (algebraMap ↥W A π * a) := e2
    refine ⟨c * w, π, c * a, T5 _ _ hc' hw', hπ, ?_⟩
    linear_combination e3
  obtain ⟨ρ, hρ⟩ : ∃ ρ : A →+* Localization.AtPrime 𝔭 ⧸ J,
      ρ = (Ideal.Quotient.mk J).comp (algebraMap A (Localization.AtPrime 𝔭)) := ⟨_, rfl⟩
  have hU : ∀ u : A, u ∉ 𝔭 → IsUnit (ρ u) := by
    intro u hu
    rw [hρ, RingHom.comp_apply]
    exact (IsLocalization.map_units (Localization.AtPrime 𝔭)
      (⟨u, hu⟩ : 𝔭.primeCompl)).map (Ideal.Quotient.mk J)
  have hV : ∀ π : ↥W, π ∈ IsLocalRing.maximalIdeal ↥W → ∀ a : A,
      ρ (algebraMap ↥W A π * a) = 0 := by
    intro π hπ a
    rw [hρ, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, map_mul, ← hJ]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hπ))
  have hZ : ∀ x : A, ρ x = 0 → algebraMap A (Localization.AtPrime 𝔭) x ∈ J := by
    intro x hx
    rw [hρ, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem] at hx
    exact hx

  obtain ⟨n1, a1, ha1⟩ := (T0 d b).mp hb
  obtain ⟨n2, a2, ha2⟩ := (T0 d s).mp hs
  obtain ⟨n3, a3, ha3⟩ := (T0 d g).mp hg
  obtain ⟨D, ab, as, ag, hD𝔭, hab, has, hag⟩ : ∃ D ab as ag : A, D ∉ 𝔭 ∧
      algebraMap A K ab = algebraMap A K D * b ∧ algebraMap A K as = algebraMap A K D * s ∧
      algebraMap A K ag = algebraMap A K D * g :=
    ⟨d ^ (n1 + n2 + n3), a1 * d ^ (n2 + n3), a2 * d ^ (n1 + n3), a3 * d ^ (n1 + n2),
      TP d _ hd,
      by simp only [map_mul, map_pow]; rw [ha1]; ring,
      by simp only [map_mul, map_pow]; rw [ha2]; ring,
      by simp only [map_mul, map_pow]; rw [ha3]; ring⟩

  obtain ⟨d0, hd0, π0, hπ0, x0, hx0, hgx⟩ := hM
  obtain ⟨M, c0, hc0⟩ := (T0 d0 x0).mp hx0
  have eqA : d0 ^ M * (ag * as ^ n - D * ab ^ n) = algebraMap ↥W A π0 * (D ^ (n + 1) * c0) := by
    apply hinj
    simp only [map_mul, map_sub, map_pow]
    rw [hab, has, hag]
    linear_combination (algebraMap A K d0 ^ M * algebraMap A K D ^ (n + 1)) * hgx -
      (algebraMap A K (algebraMap ↥W A π0) * algebraMap A K D ^ (n + 1)) * hc0
  have hR : ρ ag * ρ as ^ n = ρ D * ρ ab ^ n := by
    have e := congrArg ρ eqA
    rw [hV π0 hπ0, map_mul] at e
    have e2 := ((hU _ (TP d0 M hd0)).mul_right_eq_zero).mp e
    simp only [map_sub, map_mul, map_pow] at e2
    exact sub_eq_zero.mp e2
  have hδ := hU D hD𝔭
  have hinv : (↑hδ.unit⁻¹ : Localization.AtPrime 𝔭 ⧸ J) * ρ D = 1 := hδ.val_inv_mul
  have hdiv : ρ as ^ n ∣ ρ ab ^ n := ⟨(↑hδ.unit⁻¹ : Localization.AtPrime 𝔭 ⧸ J) * ρ ag, by
    linear_combination (-(↑hδ.unit⁻¹ : Localization.AtPrime 𝔭 ⧸ J)) * hR - ρ ab ^ n * hinv⟩
  obtain ⟨θ, hθ⟩ := (IsIntegrallyClosed.pow_dvd_pow_iff (by omega : n ≠ 0)).mp hdiv

  obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective θ
  obtain ⟨⟨ar, ⟨yr, hyr⟩⟩, hz⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl
    (S := Localization.AtPrime 𝔭) z
  have hyr' : yr ∉ 𝔭 := hyr
  have hz' : z * algebraMap A (Localization.AtPrime 𝔭) yr =
      algebraMap A (Localization.AtPrime 𝔭) ar := by
    rw [← hz]
    exact IsLocalization.mk'_spec (Localization.AtPrime 𝔭) ar ⟨yr, hyr⟩
  have hρar : Ideal.Quotient.mk J z * ρ yr = ρ ar := by
    rw [hρ, RingHom.comp_apply, RingHom.comp_apply, ← map_mul, hz']
  have hρe : ρ (ab * yr - as * ar) = 0 := by
    rw [map_sub, map_mul, map_mul, hθ, ← hρar]
    ring
  obtain ⟨v, π1, a', hv, hπ1, hve⟩ := s2 _ (hZ _ hρe)

  have hd' : v * yr * D ∉ 𝔭 := T5 _ _ (T5 _ _ hv hyr') hD𝔭
  have hyrne := hne yr hyr'
  have hvne := hne v hv
  have hDne := hne D hD𝔭
  have hd'ne : algebraMap A K v * algebraMap A K yr * algebraMap A K D ≠ 0 :=
    mul_ne_zero (mul_ne_zero hvne hyrne) hDne
  have hve' : algebraMap A K v * (algebraMap A K ab * algebraMap A K yr -
      algebraMap A K as * algebraMap A K ar) =
      algebraMap A K (algebraMap ↥W A π1) * algebraMap A K a' := by
    have := congrArg (algebraMap A K) hve
    simpa only [map_mul, map_sub] using this
  have hdv : algebraMap A K ar / algebraMap A K yr * algebraMap A K yr = algebraMap A K ar :=
    div_mul_cancel₀ _ hyrne
  refine ⟨algebraMap A K ar / algebraMap A K yr, v * yr * D, hd', ?_, ?_⟩
  · refine (T0 _ _).mpr ⟨1, v * D * ar, ?_⟩
    simp only [map_mul, pow_one]
    field_simp
  · refine ⟨π1, hπ1, algebraMap A K a' / algebraMap A K (v * yr * D),
      (T0 _ _).mpr ⟨1, a', ?_⟩, ?_⟩
    · simp only [map_mul, pow_one]
      field_simp
    · have key : (b - algebraMap A K ar / algebraMap A K yr * s) *
          (algebraMap A K v * algebraMap A K yr * algebraMap A K D) =
          algebraMap A K (algebraMap ↥W A π1) * algebraMap A K a' := by
        linear_combination (-(algebraMap A K v * algebraMap A K yr)) * hab -
          (algebraMap A K v * algebraMap A K D * s) * hdv +
          (algebraMap A K v * algebraMap A K ar) * has + hve'
      simp only [map_mul]
      rw [mul_div_assoc', eq_div_iff hd'ne]
      exact key

theorem wcLlsKPlb_best_pi : ∀ (R₀ : Type u) [CommRing R₀] [IsDomain R₀] [ValuationRing R₀]
    (K : Type u) [CommRing K] (φ : R₀ →+* K) (R N : K → Prop), R 0 →
    (∀ x y, R x → R y → R (x + y)) → (∀ (w : R₀) (x : K), R x → R (φ w * x)) → N 0 →
    (∀ x y, N x → N y → N (x - y)) → (∀ (w : R₀) (x : K), N x → N (φ w * x)) →
    (∀ (π : R₀) (x : K), π ≠ 0 → R x → N (φ π * x) → N x) →
    ∀ (k : ℕ) (g : Fin k → K), (∀ i, R (g i)) →
      (∀ x, R x → ∃ w : Fin k → R₀, N (x - ∑ i, φ (w i) * g i)) →
      ∀ x, R x → ¬ N x → ∃ (π : R₀) (z : K), π ≠ 0 ∧ R z ∧ N (x - φ π * z) ∧
        ∀ (π' : R₀) (z' : K), R z' → N (x - φ π' * z') → π' ∣ π :=
by
  intro R₀ _ _ _ K _ φ R N hR0 hRadd hRsmul hN0 hNsub hNsmul hTor k g hgR hgen x hxR hxN
  classical
  have hNadd : ∀ a b, N a → N b → N (a + b) := by
    intro a b ha hb
    have h1 : N (φ (-1) * b) := hNsmul (-1) b hb
    have h2 := hNsub a _ ha h1
    have e : a - φ (-1) * b = a + b := by rw [map_neg, map_one]; ring
    rwa [e] at h2
  have dvdmin : ∀ (n : ℕ) (w : Fin (n + 1) → R₀), ∃ j, ∀ i, w j ∣ w i := by
    intro n
    induction n with
    | zero => intro w; exact ⟨0, fun i => by rw [Fin.fin_one_eq_zero i]⟩
    | succ n ih =>
      intro w
      obtain ⟨j₀, hj₀⟩ := ih (fun i => w (Fin.castSucc i))
      rcases ValuationRing.dvd_total (w (Fin.castSucc j₀)) (w (Fin.last _)) with h | h
      · refine ⟨Fin.castSucc j₀, fun i => ?_⟩
        refine Fin.lastCases ?_ (fun i' => ?_) i
        · exact h
        · exact hj₀ i'
      · refine ⟨Fin.last _, fun i => ?_⟩
        refine Fin.lastCases ?_ (fun i' => ?_) i
        · exact dvd_refl _
        · exact dvd_trans h (hj₀ i')
  have factor : ∀ (n : ℕ) (w : Fin n → R₀) (j : Fin n), (∀ i, w j ∣ w i) →
      ∃ c : Fin n → R₀, c j = 1 ∧ ∀ i, w i = w j * c i := by
    intro n w j hj
    refine ⟨fun i => if i = j then 1 else Classical.choose (hj i), by simp, fun i => ?_⟩
    by_cases hij : i = j
    · subst hij; simp
    · simp only [hij, if_false]; exact Classical.choose_spec (hj i)
  have scale : ∀ (n : ℕ) (g : Fin n → K) (w c : Fin n → R₀) (π : R₀), (∀ i, w i = π * c i) →
      φ π * ∑ i, φ (c i) * g i = ∑ i, φ (w i) * g i := by
    intro n g w c π h
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [h i, map_mul, mul_assoc]
  have summem : ∀ (n : ℕ) (g : Fin n → K) (c : Fin n → R₀), (∀ i, R (g i)) →
      R (∑ i, φ (c i) * g i) := by
    intro n g c hg
    exact Finset.sum_induction _ R hRadd hR0 (fun i _ => hRsmul _ _ (hg i))
  let P : ℕ → Prop := fun n => ∃ g' : Fin n → K, (∀ i, R (g' i)) ∧
    ∀ x, R x → ∃ w : Fin n → R₀, N (x - ∑ i, φ (w i) * g' i)
  have hP : ∃ n, P n := ⟨k, g, hgR, hgen⟩
  have main : ∀ (k₀ : ℕ) (g₀ : Fin k₀ → K), (∀ i, R (g₀ i)) →
      (∀ x, R x → ∃ w : Fin k₀ → R₀, N (x - ∑ i, φ (w i) * g₀ i)) →
      (∀ m < k₀, ¬ P m) →
      ∃ (π : R₀) (z : K), π ≠ 0 ∧ R z ∧ N (x - φ π * z) ∧
        ∀ (π' : R₀) (z' : K), R z' → N (x - φ π' * z') → π' ∣ π := by
    intro k₀ g₀ hg₀R hg₀gen hmin
    cases k₀ with
    | zero =>
      exfalso
      obtain ⟨w, hw⟩ := hg₀gen x hxR
      rw [Finset.univ_eq_empty, Finset.sum_empty, sub_zero] at hw
      exact hxN hw
    | succ n =>
      have indep : ∀ w : Fin (n + 1) → R₀, N (∑ i, φ (w i) * g₀ i) → ∀ i, w i = 0 := by
        intro w hw i₀
        by_contra hne
        obtain ⟨j, hj⟩ := dvdmin n w
        have hπ0 : w j ≠ 0 := fun h => hne (by
          have := hj i₀
          rw [h] at this
          exact zero_dvd_iff.mp this)
        obtain ⟨c, hcj, hc⟩ := factor _ w j hj
        have hy : N (∑ i, φ (c i) * g₀ i) :=
          hTor (w j) _ hπ0 (summem _ _ _ hg₀R) (by rw [scale _ _ w c (w j) hc]; exact hw)
        apply hmin n (Nat.lt_succ_self n)
        refine ⟨fun i' => g₀ (j.succAbove i'), fun i' => hg₀R _, fun x' hx' => ?_⟩
        obtain ⟨v, hv⟩ := hg₀gen x' hx'
        refine ⟨fun i' => v (j.succAbove i') - v j * c (j.succAbove i'), ?_⟩
        have e0 : ∑ i' : Fin n, φ (v (j.succAbove i') - v j * c (j.succAbove i')) *
              g₀ (j.succAbove i') =
            ∑ i' : Fin n, φ (v (j.succAbove i')) * g₀ (j.succAbove i') -
              φ (v j) * ∑ i' : Fin n, φ (c (j.succAbove i')) * g₀ (j.succAbove i') := by
          rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [map_sub, map_mul]
          ring
        have e : x' - ∑ i' : Fin n, φ (v (j.succAbove i') - v j * c (j.succAbove i')) *
              g₀ (j.succAbove i') =
            (x' - ∑ i, φ (v i) * g₀ i) + φ (v j) * ∑ i, φ (c i) * g₀ i := by
          rw [e0, Fin.sum_univ_succAbove (fun i => φ (v i) * g₀ i) j,
            Fin.sum_univ_succAbove (fun i => φ (c i) * g₀ i) j, hcj, map_one]
          ring
        show N (x' - ∑ i' : Fin n, φ (v (j.succAbove i') - v j * c (j.succAbove i')) *
              g₀ (j.succAbove i'))
        rw [e]
        exact hNadd _ _ hv (hNsmul _ _ hy)
      obtain ⟨w, hw⟩ := hg₀gen x hxR
      by_cases hall : ∀ i, w i = 0
      · exfalso
        apply hxN
        have hs : ∑ i, φ (w i) * g₀ i = 0 :=
          Finset.sum_eq_zero (fun i _ => by rw [hall i, map_zero, zero_mul])
        rw [hs, sub_zero] at hw
        exact hw
      push_neg at hall
      obtain ⟨i₀, hi₀⟩ := hall
      obtain ⟨j, hj⟩ := dvdmin n w
      have hπ0 : w j ≠ 0 := fun h => hi₀ (by
        have := hj i₀
        rw [h] at this
        exact zero_dvd_iff.mp this)
      obtain ⟨c, _, hc⟩ := factor _ w j hj
      refine ⟨w j, ∑ i, φ (c i) * g₀ i, hπ0, summem _ _ _ hg₀R,
        by rw [scale _ _ w c (w j) hc]; exact hw, ?_⟩
      intro π' z' hz' hN'
      obtain ⟨e, he⟩ := hg₀gen z' hz'
      have hsum : N (∑ i, φ (π' * e i - w i) * g₀ i) := by
        have e1 : ∑ i, φ (π' * e i - w i) * g₀ i =
            φ π' * ∑ i, φ (e i) * g₀ i - ∑ i, φ (w i) * g₀ i := by
          rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [map_sub, map_mul]
          ring
        have e2 : ∑ i, φ (π' * e i - w i) * g₀ i =
            (x - ∑ i, φ (w i) * g₀ i) - (x - φ π' * z') -
              φ π' * (z' - ∑ i, φ (e i) * g₀ i) := by
          rw [e1]; ring
        rw [e2]
        exact hNsub _ _ (hNsub _ _ hw hN') (hNsmul _ _ he)
      have h := indep _ hsum j
      exact Dvd.intro (e j) (sub_eq_zero.mp h)
  obtain ⟨g₀, hg₀R, hg₀gen⟩ := Nat.find_spec hP
  exact main (Nat.find hP) g₀ hg₀R hg₀gen (fun m hm => Nat.find_min hP hm)

theorem wcLlsKPlb_fin_gen : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (s : K) (d : A), d ∉ 𝔭 → wcLlsKPLoc A K 0 d s →
      (∀ d'' : A, d'' ∉ 𝔭 → ¬ wcLlsKPMLoc W A K 0 d'' s) →
