    ε ∉ 𝔭 →
    ∀ (y : Ideal ↥(integralClosure A L)), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
    ∀ (_ : y.IsPrime), ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hκ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g hPD hfr θ₂ ε hθ₂ hθ₂pow
    hε y hyc hy
  have hPD' := hPD
  obtain ⟨-, htf, hAic, h𝔭max, hm𝔭, hg, hg0, huv, h𝔭eq, -⟩ := hPD'
  haveI h𝔭 : 𝔭.IsPrime := h𝔭max.isPrime

  have hWinj : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    rw [Algebra.algebraMap_eq_smul_one] at hw
    rcases smul_eq_zero.mp hw with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hinjK : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hsc : ∀ x : A, algebraMap A L x = algebraMap K L (algebraMap A K x) :=
    fun x => IsScalarTower.algebraMap_apply A K L x
  have hinjL : Function.Injective (algebraMap A L) := by
    intro x y hxy
    rw [hsc, hsc] at hxy
    exact hinjK ((algebraMap K L).injective hxy)
