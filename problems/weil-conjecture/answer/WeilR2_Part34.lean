          have h3 := (hiff₁ bE hbEm hbE0 hEb₀).mp h2
          have h4 : bE ∣ b := hmax₁ bE hbEm hbE0 hEb₀ ⟨qE, hbEeq⟩ h3
          rw [hbEeq] at h4
          exact noDvdStrict b qE hb0 hqE h4
        have hsepcs : wcLlsDiscSep W A' K L t cs b :=
          (wcpa_dj_llsm_nss_recenter W A' K L 𝔭' t hPD c₁ cs b hc₁m hcs hbm hb0
            (dvd_sub_comm.mp hdvdc)).mp hsepb
        have hwit : wcLlsDiscSep W A' K L t cs (b * βs) := by rw [← hbseq]; exact hseps
        refine recurse cs b βs hcs hbm hb0 hβs hβs0 hsepcs hwit ?_
        intro A'' _ _ _ _ _ _ _ t' 𝔭'' y'' hPD'' hcm hS'' hU'' hc''
        refine hBR A'' K L 𝔭'' (.disc t') y'' hPD'' hS'' hU'' ?_ hc''
