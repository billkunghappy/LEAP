    Ideal.quotientEquiv _ _ Φ hIeq

  obtain ⟨hmDp, hσD, ⟨H, hH⟩, hyD⟩ := wcLlsKPms_cusp_data Ω W ℓ hℓ hκ P ψ hPF1 hPF2 FP G hmon
    hdegP hmid hcoeff0 hj e γ he hγ Q hmQ hσQ
  haveI := hmDp
  haveI : IsDomain (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥(Algebra.adjoin A {wcLlsScS W A K t c b}) 𝔮) :=
    MulEquiv.isDomain _ E.symm.toMulEquiv
  obtain ⟨q, hq⟩ : ∃ q, ℓ = q + 2 := ⟨ℓ - 2, by have := hℓ.two_le; omega⟩
  have hq1 : ℓ - 1 = q + 1 := by omega
  rw [hq] at hH
  rw [hq1] at hyD
  refine s8 _ q (E (Ideal.Quotient.mk _ (algebraMap (AdjoinRoot FP) (Localization.AtPrime Q)
      (AdjoinRoot.root FP - AdjoinRoot.of FP (ψ (Polynomial.C γ))))))
    (E (Ideal.Quotient.mk _ (algebraMap (AdjoinRoot FP) (Localization.AtPrime Q)
      (AdjoinRoot.of FP (ψ (Polynomial.X - Polynomial.C e))))))
    (E (Ideal.Quotient.mk _ H)) ?_ ?_ ?_ hδ
  · rw [ne_eq, map_eq_zero_iff _ E.injective, Ideal.Quotient.eq_zero_iff_mem]
    exact hσD
  · have h2 := congrArg E (Ideal.Quotient.eq.mpr hH)
    simpa only [map_pow, map_mul] using h2
  · rintro ⟨β, hβ⟩
    obtain ⟨β₀, hβ₀⟩ := Ideal.Quotient.mk_surjective (E.symm β)
    apply hyD
    rw [Ideal.mem_span_singleton_sup]
    refine ⟨β₀, _, ?_, add_sub_cancel _ _⟩
    rw [← Ideal.Quotient.eq]
    apply E.injective
    simp only [map_pow, map_mul]
