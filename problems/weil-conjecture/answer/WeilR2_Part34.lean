        exact hmem
      exact hmem'
    · intro a s h
      rw [Ideal.Quotient.lift_mk] at h
      have h1 : ψ (IsLocalization.mk' (Localization.AtPrime y) a s) = 0 := h
      simp only [ψ, φ0, RingHom.comp_apply, Localization.localRingHom_mk',
        Ideal.Quotient.eq_zero_iff_mem] at h1
      rw [IsLocalization.mk'_mem_map_algebraMap_iff] at h1
      obtain ⟨s', hs', hs'a⟩ := h1
      rcases h𝔷P.mem_or_mem hs'a with h | h
      · exact absurd (h𝔷Q h) hs'
      · exact h
    · intro a
      rw [Ideal.Quotient.lift_mk]
      show Ideal.Quotient.mk _ (φ0 (algebraMap _ _ a)) = _
      rw [Localization.localRingHom_to_map]

  have hPD' := hPD
  obtain ⟨e, he⟩ := ha'b
  have hRo : wcLlsASbS W A K u b ≤ wcLlsASbS W A K u a' := by
