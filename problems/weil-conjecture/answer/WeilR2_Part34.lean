    have hC : u' ^ M = u' * u' ^ (M - m₀ - 1) * u' ^ m₀ := by
      rw [show u' ^ M = u' ^ (1 + (M - m₀ - 1) + m₀) by congr 1; omega, pow_add, pow_add, pow_one]
    linear_combination hA + hB + y' * hC


  have hinjWA : Function.Injective (algebraMap ↥W A) := by
