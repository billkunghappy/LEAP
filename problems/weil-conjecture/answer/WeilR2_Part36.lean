    have hφ2 := hvu u₂ hu₂
    have ha₁ : A.valuation (φ μ₁) ≠ 0 := (Valuation.ne_zero_iff _).mpr ((map_ne_zero φ).mpr hμ₁)
    have ha₂ : A.valuation (φ μ₂) ≠ 0 := (Valuation.ne_zero_iff _).mpr ((map_ne_zero φ).mpr hμ₂)
    have he : A.valuation ε ≠ 0 := (Valuation.ne_zero_iff _).mpr hε
    have hy₁ : A.valuation (φ μ₁ * ε ^ k₁ * u₁) = A.valuation (φ μ₁) * A.valuation ε ^ k₁ := by
      rw [map_mul, map_mul, map_pow, hφ1, mul_one]
    have hy₂ : A.valuation (φ μ₂ * ε ^ k₂ * u₂) = A.valuation (φ μ₂) * A.valuation ε ^ k₂ := by
      rw [map_mul, map_mul, map_pow, hφ2, mul_one]
