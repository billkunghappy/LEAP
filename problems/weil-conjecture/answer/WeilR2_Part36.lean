    congr 1
    apply List.map_congr_left
    intro r _
    exact factor γ (x - r)
  have hvP : ∀ l : List ↥W, v (((l.map (fun r => x - r)).prod : ↥W) : Ω) = (l.map d).prod := by
    intro l
    rw [vprod, List.map_map]
    rfl
  have hvne : ∀ p : ↥W, p ≠ 0 → v ((p : ↥W) : Ω) ≠ 0 := by
    intro p hp h
    apply hp
    exact Subtype.ext (by simpa using ((Valuation.zero_iff v).mp h))
  have hB0 : v ((b : ↥W) : Ω) ≠ 0 := hvne b hb0
  have he0 : 0 < v ((β : ↥W) : Ω) := zero_lt_iff.mpr (hvne β hβ0)
  have he1 : v ((β : ↥W) : Ω) < 1 := (ValuationSubring.valuation_lt_one_iff W β).mp hβm
  have g2 : (R.map d).prod ≤ v ((b : ↥W) : Ω) := by
    rw [← hvP R]; exact (s0 b _).mp H1
