  have hfin := wcpa_dj_llsm_sd_normalization_finite Ω W hW hWt A K M 𝔭 k hPD s
  obtain ⟨-, -, hjinj, hCIC⟩ := wcpa_dj_llsm_sdg_chart_ring Ω W hW hWt A K M 𝔭 k hPD s hfin
  haveI := hCIC
  have hred := wcpa_dj_llsm_sdg_reduced_quotient Ω W _ (wcSdgJ W A K M s) hjinj
  have hJrad : J.IsRadical := by
    rw [hJ]; exact (Ideal.isRadical_iff_quotient_reduced _).mpr hred

  have L12 : ∀ (C : Type u) [CommRing C] (Q : Ideal C) [Q.IsPrime] (J : Ideal C), J ≤ Q →
      J.IsRadical → ∀ (x0 y0 : C), x0 * y0 ∈ J →
      (∀ 𝔠 : Ideal C, 𝔠.IsPrime → J ≤ 𝔠 → 𝔠 ≤ Q → x0 ∈ 𝔠 → y0 ∈ 𝔠 → 𝔠 = Q) →
      ∀ (𝔠₀ 𝔠₁ : Ideal C), 𝔠₀.IsPrime → 𝔠₁.IsPrime → J ≤ 𝔠₀ → J ≤ 𝔠₁ → 𝔠₀ ≤ Q → 𝔠₁ ≤ Q →
      x0 ∉ 𝔠₀ → y0 ∉ 𝔠₁ →
      wcpaDjLkDelta (Localization.AtPrime Q ⧸ J.map (algebraMap C (Localization.AtPrime Q))) ≠ 0 := by
    intro C _ Q _ J hJQ hJrad x0 y0 hxy hcl 𝔠₀ 𝔠₁ h0p h1p hJ0 hJ1 h0Q h1Q hx0 hy1
    obtain ⟨hloc, hredF, himg, hcomap⟩ := L2 C Q J hJQ
    haveI := hloc
    haveI := hredF hJrad
    obtain ⟨p, hp, hpmem⟩ := himg 𝔠₀ h0p hJ0 h0Q
    obtain ⟨q, hq, hqmem⟩ := himg 𝔠₁ h1p hJ1 h1Q
    refine L1 _ (Ideal.Quotient.mk _ (algebraMap C (Localization.AtPrime Q) x0))
      (Ideal.Quotient.mk _ (algebraMap C (Localization.AtPrime Q) y0)) ?_ ?_ p q hp hq
      (fun h => hx0 ((hpmem _).mp h)) (fun h => hy1 ((hqmem _).mp h))
    · rw [← map_mul, ← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_map_of_mem _ hxy
    · intro 𝔓 h𝔓 hx𝔓 hy𝔓
      obtain ⟨hle, hmaxc⟩ := hcomap 𝔓 h𝔓
      apply hmaxc
      apply hcl _ (Ideal.comap_isPrime _ _) _ hle hx𝔓 hy𝔓
      intro j hj
      rw [Ideal.mem_comap, RingHom.comp_apply,
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hj)]
      exact Ideal.zero_mem _
  have hcl : ∀ 𝔠 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) M), 𝔠.IsPrime → J ≤ 𝔠 →
      𝔠 ≤ Q →
      algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ ∈ 𝔠 →
      algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
        (algebraMap A ↥(Algebra.adjoin A {s}) z0) ∈ 𝔠 → 𝔠 = Q := by
    intro 𝔠 h𝔠 hJc hle hx𝔠 hy𝔠
    haveI := h𝔠
    have hNc : N₁ ≤ 𝔠.comap (algebraMap ↥(Algebra.adjoin A {s})
        ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) := by
      rw [hN₁]
      apply sup_le
      · rw [Ideal.span_le]
        intro a ha
        rcases Set.mem_insert_iff.mp ha with rfl | ha
        · exact hy𝔠
        · rw [Set.mem_singleton_iff] at ha
          subst ha
          exact hx𝔠
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        have hwJ : ((algebraMap ↥(Algebra.adjoin A {s})
            ↥(integralClosure ↥(Algebra.adjoin A {s}) M)).comp
            ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) w ∈ J := by
          rw [hJ]; exact Ideal.mem_map_of_mem _ hw
        exact hJc hwJ
    have heq : 𝔠.comap (algebraMap ↥(Algebra.adjoin A {s})
        ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) = N₁ :=
      (hNmax.eq_of_le (Ideal.comap_isPrime _ _).ne_top hNc).symm
    by_contra hne
    obtain ⟨q0, hq0Q, hq0c⟩ := SetLike.exists_of_lt (lt_of_le_of_ne hle hne)
    have hlt : 𝔠.comap (algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) <
        Q.comap (algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) :=
      Ideal.under_lt_under_of_integral_mem_sdiff (R := ↥(Algebra.adjoin A {s})) hle
        ⟨hq0Q, hq0c⟩ (Algebra.IsIntegral.isIntegral q0)
    rw [heq, hQ] at hlt
    exact lt_irrefl _ hlt
  have hxyJ : algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ *
      algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
        (algebraMap A ↥(Algebra.adjoin A {s}) z0) ∈ J := by
    rw [← map_mul, mul_comm, hA1eq, hJ]
    exact Ideal.mem_map_of_mem
      ((algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)).comp
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) hb₁m
  have hδ' := L12 _ Q J hJQ hJrad _ _ hxyJ hcl 𝔠₀ 𝔠₁ h0p h1p (by rw [hJ]; exact h0m)
    (by rw [hJ]; exact h1m) h0Q h1Q hsc0 hz0c1
  have hδ : wcpaDjLkDelta (wcLlsFS W ((algebraMap K M).comp ((algebraMap A K).comp
      (algebraMap ↥W A))) ↥(Algebra.adjoin A {s}) Q) ≠ 0 := by
    subst hJdef
    exact hδ'
  exact ⟨hδ, 𝔠₀, 𝔠₁, h0p, h1p, h0Q, h1Q, h0m, h1m, hz0c0, hsc0, hsc1, hz0c1⟩

theorem wcpa_dj_llsm_nrc_affine_chart : ∀ (S R C : Type u) [CommRing S] [CommRing R] [CommRing C] [Algebra S R] [Algebra S C] (𝔓 : Ideal C) [𝔓.IsPrime] (𝔭 : Ideal R), wcLfChart (S := S) (Q := R) (Spec.map (CommRingCat.ofHom (algebraMap S C))) (wcSdgPt C 𝔓) 𝔭 → ∃ (T : Type u) (_ : CommRing T) (ι₀ : C →+* T) (μ₀ : R →+* T) (q : Ideal T), q.IsPrime ∧ ι₀.Etale ∧ μ₀.Etale ∧ μ₀.comp (algebraMap S R) = ι₀.comp (algebraMap S C) ∧ q.comap ι₀ = 𝔓 ∧ q.comap μ₀ = 𝔭 :=
by
  intro S R C _ _ _ _ _ 𝔓 _ 𝔭 hchart
  obtain ⟨U, e, m, x, he_et, hm_et, hcomm, hex, hmx, -, -⟩ := hchart
  haveI := he_et
  haveI := hm_et
  obtain ⟨T₀, f, hf, ⟨x', hx'⟩, -⟩ :=
    Scheme.exists_affine_mem_range_and_range_subset (X := U) (x := x) (U := ⊤) trivial
  haveI := hf
  have hι : Spec.map (Spec.preimage (f ≫ e)) = f ≫ e := Spec.map_preimage _
  have hμ : Spec.map (Spec.preimage (f ≫ m)) = f ≫ m := Spec.map_preimage _
  have hιet : (Spec.preimage (f ≫ e)).hom.Etale := by
    have : Etale (Spec.map (Spec.preimage (f ≫ e))) := by rw [hι]; infer_instance
    exact HasRingHomProperty.Spec_iff.mp this
  have hμet : (Spec.preimage (f ≫ m)).hom.Etale := by
    have : Etale (Spec.map (Spec.preimage (f ≫ m))) := by rw [hμ]; infer_instance
    exact HasRingHomProperty.Spec_iff.mp this
  have hcat : CommRingCat.ofHom (algebraMap S R) ≫ Spec.preimage (f ≫ m) =
      CommRingCat.ofHom (algebraMap S C) ≫ Spec.preimage (f ≫ e) := by
    apply Spec.map_injective
    rw [Spec.map_comp, Spec.map_comp, hι, hμ, Category.assoc, Category.assoc, hcomm]
  have hcompat : (Spec.preimage (f ≫ m)).hom.comp (algebraMap S R) =
      (Spec.preimage (f ≫ e)).hom.comp (algebraMap S C) := by
    have := congrArg CommRingCat.Hom.hom hcat
    simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom] using this
  have hptι : (Spec.map (Spec.preimage (f ≫ e))) x' = wcSdgPt C 𝔓 := by
    rw [hι, Scheme.Hom.comp_apply, hx', hex]
  have hptμ : (Spec.map (Spec.preimage (f ≫ m))) x' = m x := by
    rw [hμ, Scheme.Hom.comp_apply, hx']
  refine ⟨T₀, inferInstance, (Spec.preimage (f ≫ e)).hom, (Spec.preimage (f ≫ m)).hom,
    x'.asIdeal, x'.isPrime, hιet, hμet, hcompat, ?_, ?_⟩
  · have := congrArg PrimeSpectrum.asIdeal hptι
    exact this
  · have := congrArg PrimeSpectrum.asIdeal hptμ
    exact this.trans hmx

theorem wcpa_dj_llsm_nrc_generic_primes : ∀ (C T : Type u) [CommRing C] [IsDomain C] [CommRing T] [Algebra C T], Algebra.Etale C T → ∃ (r : ℕ) (P : Fin r → Ideal T), (∀ i, (P i).IsPrime) ∧ (∀ x : T, (∀ i, x ∈ P i) → x = 0) ∧ ∀ i, ∃ b : T, b ∉ P i ∧ ∀ j, j ≠ i → b ∈ P j :=
by
  intro C T _ _ _ _ hEt
  classical
  haveI := hEt

  have hclear : ∀ z : TensorProduct C (FractionRing C) T, ∃ d : C, d ≠ 0 ∧ ∃ b : T,
      (1 : FractionRing C) ⊗ₜ[C] b =
        (algebraMap C (FractionRing C) d ⊗ₜ[C] (1 : T)) * z := by
    have key : ∀ (c : C) (x : T), (1 : FractionRing C) ⊗ₜ[C] (c • x) =
        (algebraMap C (FractionRing C) c ⊗ₜ[C] (1 : T)) * ((1 : FractionRing C) ⊗ₜ[C] x) := by
      intro c x
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, Algebra.algebraMap_eq_smul_one,
        TensorProduct.smul_tmul]
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨1, one_ne_zero, 0, by simp⟩
    | tmul f t =>
      obtain ⟨⟨a, d⟩, hfd⟩ := IsLocalization.surj (nonZeroDivisors C) f
      refine ⟨d, nonZeroDivisors.ne_zero d.2, a • t, ?_⟩
      simp only at hfd
      rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_comm, hfd,
        Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
    | add x y hx hy =>
      obtain ⟨d₁, hd₁, b₁, h₁⟩ := hx
      obtain ⟨d₂, hd₂, b₂, h₂⟩ := hy
      refine ⟨d₁ * d₂, mul_ne_zero hd₁ hd₂, d₂ • b₁ + d₁ • b₂, ?_⟩
      have hm : algebraMap C (FractionRing C) (d₁ * d₂) ⊗ₜ[C] (1 : T) =
          (algebraMap C (FractionRing C) d₁ ⊗ₜ[C] (1 : T)) *
            (algebraMap C (FractionRing C) d₂ ⊗ₜ[C] (1 : T)) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, map_mul]
      rw [TensorProduct.tmul_add, key, key, h₁, h₂, hm]
      ring
  haveI : Algebra.Etale (FractionRing C) (TensorProduct C (FractionRing C) T) :=
    Algebra.Etale.baseChange C T (FractionRing C)
  obtain ⟨I, hI, A, hAf, hAa, e, -⟩ :=
    (Algebra.Etale.iff_exists_algEquiv_prod (FractionRing C)
      (TensorProduct C (FractionRing C) T)).mp inferInstance
  have hι : Function.Injective
      (Algebra.TensorProduct.includeRight : T →ₐ[C] TensorProduct C (FractionRing C) T) :=
    Algebra.TensorProduct.includeRight_injective (IsFractionRing.injective C (FractionRing C))
  let φ : ∀ i : I, T →+* A i := fun i => (Pi.evalRingHom A i).comp
    (e.toRingHom.comp
      (Algebra.TensorProduct.includeRight : T →ₐ[C] TensorProduct C (FractionRing C) T).toRingHom)
  have hφ : ∀ i (x : T), φ i x = e ((1 : FractionRing C) ⊗ₜ[C] x) i := fun i x => rfl
  let σ := Finite.equivFin I
  refine ⟨Nat.card I, fun k => RingHom.ker (φ (σ.symm k)), ?_, ?_, ?_⟩
  · intro k
    exact RingHom.ker_isPrime _
  · intro x hx
    apply hι
    rw [map_zero]
    apply e.injective
    rw [map_zero]
    funext i
    have h : φ (σ.symm (σ i)) x = 0 := RingHom.mem_ker.mp (hx (σ i))
    rw [Equiv.symm_apply_apply] at h
    exact h
  · intro k
    obtain ⟨d, hd, b, hb⟩ := hclear (e.symm (Pi.single (σ.symm k) 1))
    have hD : algebraMap C (FractionRing C) d ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective C (FractionRing C))).mpr hd
    have hφb : ∀ i, φ i b = algebraMap (FractionRing C) (A i) (algebraMap C (FractionRing C) d) *
        (Pi.single (σ.symm k) 1 : ∀ i, A i) i := by
      intro i
      rw [hφ, hb]
      have h2 : (algebraMap C (FractionRing C) d ⊗ₜ[C] (1 : T)) =
          algebraMap (FractionRing C) (TensorProduct C (FractionRing C) T)
            (algebraMap C (FractionRing C) d) := rfl
      rw [h2, map_mul, AlgEquiv.commutes, AlgEquiv.apply_symm_apply]
      rfl
    refine ⟨b, ?_, ?_⟩
    · rw [RingHom.mem_ker, hφb, Pi.single_eq_same, mul_one]
      exact (map_ne_zero_iff _ (algebraMap (FractionRing C) _).injective).mpr hD
    · intro j hj
      rw [RingHom.mem_ker, hφb, Pi.single_eq_of_ne (fun h => hj (σ.symm.injective h)), mul_zero]

theorem wcpa_dj_llsm_nrc_domain_kill : ∀ (T : Type u) [CommRing T] (q : Ideal T) [q.IsPrime], IsDomain (Localization.AtPrime q) → ∀ (r : ℕ) (P : Fin r → Ideal T), (∀ i, (P i).IsPrime) → (∀ x : T, (∀ i, x ∈ P i) → x = 0) → (∀ i, ∃ b : T, b ∉ P i ∧ ∀ j, j ≠ i → b ∈ P j) → ∃ (P₀ : Ideal T) (h : T), P₀.IsPrime ∧ P₀ ≤ q ∧ h ∉ q ∧ ∀ x ∈ P₀, h * x = 0 :=
by
  classical
  intro T _ q _ hdom r P hP h0 hb
  haveI := hdom
  have hq1 : (1 : T) ∉ q := fun h =>
    (Ideal.IsPrime.ne_top ‹q.IsPrime›) ((Ideal.eq_top_iff_one q).mpr h)
  have huniq : ∀ i j, i ≠ j → P i ≤ q → P j ≤ q → False := by
    intro i j hij hi hj
    obtain ⟨bi, hbi, hbi'⟩ := hb i
    obtain ⟨bj, hbj, hbj'⟩ := hb j
    have hprod : bi * bj = 0 := by
      apply h0
      intro k
      by_cases hk : k = i
      · rw [hk]
        exact Ideal.mul_mem_left _ _ (hbj' i hij)
      · exact Ideal.mul_mem_right _ _ (hbi' k hk)
    have himg : algebraMap T (Localization.AtPrime q) bi *
        algebraMap T (Localization.AtPrime q) bj = 0 := by
      rw [← map_mul, hprod, map_zero]
    have key : ∀ (b : T) (k : Fin r), b ∉ P k → P k ≤ q →
        algebraMap T (Localization.AtPrime q) b = 0 → False := by
      intro b k hbk hk hzero
      obtain ⟨m, hm⟩ :=
        (IsLocalization.map_eq_zero_iff q.primeCompl (Localization.AtPrime q) b).mp hzero
      have hmem : (m : T) * b ∈ P k := by rw [hm]; exact (P k).zero_mem
      rcases (hP k).mem_or_mem hmem with h | h
      · exact m.2 (hk h)
      · exact hbk h
    rcases mul_eq_zero.mp himg with h | h
    · exact key bi i hbi hi h
    · exact key bj j hbj hj h
  have hex : ∃ i₀, P i₀ ≤ q := by
    by_contra hne
    push_neg at hne
    have hc : ∀ i, ∃ x ∈ P i, x ∉ q := fun i => SetLike.not_le_iff_exists.mp (hne i)
    choose x hxP hxq using hc
    have hy : ∏ i, x i = 0 := by
      apply h0
      intro k
      exact Ideal.mem_of_dvd _ (Finset.dvd_prod_of_mem x (Finset.mem_univ k)) (hxP k)
    have hmem : ∏ i, x i ∈ q := by rw [hy]; exact q.zero_mem
    obtain ⟨i, _, hi⟩ := Ideal.IsPrime.prod_mem_iff.mp hmem
    exact hxq i hi
  obtain ⟨i₀, hi₀⟩ := hex
  have hw : ∀ j, ∃ x : T, x ∉ q ∧ (¬ P j ≤ q → x ∈ P j) := by
    intro j
    by_cases hj : P j ≤ q
    · exact ⟨1, hq1, fun h => absurd hj h⟩
    · obtain ⟨x, hxP, hxq⟩ := SetLike.not_le_iff_exists.mp hj
      exact ⟨x, hxq, fun _ => hxP⟩
  choose x hxq hxP using hw
  refine ⟨P i₀, ∏ j, x j, hP i₀, hi₀, ?_, ?_⟩
  · intro hmem
    obtain ⟨i, _, hi⟩ := Ideal.IsPrime.prod_mem_iff.mp hmem
    exact hxq i hi
  · intro z hz
    apply h0
    intro k
    by_cases hk : k = i₀
    · rw [hk]
      exact Ideal.mul_mem_left _ _ hz
    · have hnk : ¬ P k ≤ q := fun h => huniq i₀ k (Ne.symm hk) hi₀ h
      exact Ideal.mul_mem_right _ _
        (Ideal.mem_of_dvd _ (Finset.dvd_prod_of_mem x (Finset.mem_univ k)) (hxP k hnk))

theorem wcpa_dj_llsm_nrc_fibre_idempotent : ∀ (N T : Type u) [CommRing N] [CommRing T] (μ : N →+* T), μ.Etale → ∀ (𝔭 : Ideal N), 𝔭.IsMaximal → ∀ (q : Ideal T) [q.IsPrime], q.comap μ = 𝔭 → q.IsMaximal ∧ ∃ h : T, h ∉ q ∧ ∀ x ∈ q, x * h ∈ 𝔭.map μ :=
by
  intro N T _ _ μ hμ 𝔭 h𝔭 q _ hq
  classical
  letI : Algebra N T := μ.toAlgebra
  haveI : Algebra.Etale N T := RingHom.Etale.toAlgebra hμ
  letI : Field (N ⧸ 𝔭) := Ideal.Quotient.field 𝔭
  set I : Ideal T := 𝔭.map (algebraMap N T) with hI

  haveI : Algebra.FormallyUnramified N (T ⧸ I) := Algebra.FormallyUnramified.quotient I
  haveI : Algebra.FormallyUnramified (N ⧸ 𝔭) (T ⧸ I) :=
    Algebra.FormallyUnramified.of_restrictScalars N (N ⧸ 𝔭) (T ⧸ I)
  haveI : Algebra.FiniteType N (T ⧸ I) := Algebra.FiniteType.quotient N I
  haveI : Algebra.FiniteType (N ⧸ 𝔭) (T ⧸ I) :=
    Algebra.FiniteType.of_restrictScalars_finiteType N (N ⧸ 𝔭) (T ⧸ I)
  haveI : Algebra.EssFiniteType (N ⧸ 𝔭) (T ⧸ I) := Algebra.EssFiniteType.of_finiteType _ _
  haveI hred : _root_.IsReduced (T ⧸ I) :=
    Algebra.FormallyUnramified.isReduced_of_field (N ⧸ 𝔭) (T ⧸ I)
  haveI : Module.Free (N ⧸ 𝔭) (T ⧸ I) := Module.Free.of_divisionRing _ _
  haveI : Module.Finite (N ⧸ 𝔭) (T ⧸ I) :=
    Algebra.FormallyUnramified.finite_of_free (N ⧸ 𝔭) (T ⧸ I)
  haveI hart : IsArtinianRing (T ⧸ I) := IsArtinianRing.of_finite (N ⧸ 𝔭) (T ⧸ I)

  have hann : ∀ (P : Ideal (T ⧸ I)), P.IsPrime → ∃ a : T ⧸ I, a ∉ P ∧ ∀ x ∈ P, x * a = 0 := by
    intro P hP
    have hS := IsArtinianRing.setOfPred_isPrime_finite (T ⧸ I)
    set S' := hS.toFinset.erase P with hS'
    have hc : ∀ Q : Ideal (T ⧸ I), ∃ c : T ⧸ I, Q ∈ S' → c ∈ Q ∧ c ∉ P := by
      intro Q
      by_cases hQ : Q ∈ S'
      · have hQne : Q ≠ P := (Finset.mem_erase.mp hQ).1
        have hQp : Q.IsPrime := by
          have := (Finset.mem_erase.mp hQ).2
          simpa using this
        have hQm : Q.IsMaximal := IsArtinianRing.isMaximal_of_isPrime Q
        have hnle : ¬ Q ≤ P := fun hle => hQne (hQm.eq_of_le hP.ne_top hle)
        obtain ⟨c, hcQ, hcP⟩ := Set.not_subset.mp hnle
        exact ⟨c, fun _ => ⟨hcQ, hcP⟩⟩
      · exact ⟨1, fun h => absurd h hQ⟩
    choose c hc using hc
    refine ⟨∏ Q ∈ S', c Q, ?_, ?_⟩
    · intro hmem
      obtain ⟨Q, hQ, hcQ⟩ := (hP.prod_mem_iff).mp hmem
      exact (hc Q hQ).2 hcQ
    · intro x hx
      have hnil : x * ∏ Q ∈ S', c Q ∈ nilradical (T ⧸ I) := by
        rw [nilradical_eq_sInf, Submodule.mem_sInf]
        intro J hJ
        by_cases hJP : J = P
        · subst hJP
          exact Ideal.mul_mem_right _ _ hx
        · have hJS : J ∈ S' := by
            rw [Finset.mem_erase]
            exact ⟨hJP, by simpa using hJ⟩
          apply Ideal.mul_mem_left
          exact Ideal.mem_of_dvd _ (Finset.dvd_prod_of_mem c hJS) (hc J hJS).1
      exact IsNilpotent.eq_zero (mem_nilradical.mp hnil)

  set π : T →+* T ⧸ I := Ideal.Quotient.mk I with hπ
  have hsurj : Function.Surjective π := Ideal.Quotient.mk_surjective
  have hle : I ≤ q := by
    rw [hI, Ideal.map_le_iff_le_comap]
    exact le_of_eq hq.symm
  have hker : RingHom.ker π = I := Ideal.mk_ker
  have hqbar : (q.map π).IsPrime :=
    Ideal.map_isPrime_of_surjective hsurj (by rw [hker]; exact hle)
  have hcomap : (q.map π).comap π = q := by
    rw [Ideal.comap_map_of_surjective' π hsurj, hker]
    exact sup_eq_left.mpr hle
  refine ⟨?_, ?_⟩
  · have hm : (q.map π).IsMaximal := IsArtinianRing.isMaximal_of_isPrime _
    rw [← hcomap]
    exact Ideal.comap_isMaximal_of_surjective π hsurj
  · obtain ⟨a, haP, hax⟩ := hann (q.map π) hqbar
    obtain ⟨h, rfl⟩ := hsurj a
    refine ⟨h, fun hh => haP (Ideal.mem_map_of_mem π hh), ?_⟩
    intro x hx
    have h0 : π (x * h) = 0 := by
      rw [map_mul]
      exact hax _ (Ideal.mem_map_of_mem π hx)
    have : x * h ∈ I := by
      rw [← hker]
      exact h0
    exact this

theorem wcpa_dj_llsm_nrc_localize_props : ∀ (C T : Type u) [CommRing C] [IsDomain C] [IsIntegrallyClosed C] [CommRing T] (ι₀ : C →+* T), ι₀.Etale → ∀ (q : Ideal T), q.IsMaximal → ∀ (P₀ : Ideal T) (h : T), P₀.IsPrime → P₀ ≤ q → h ∉ q → (∀ x ∈ P₀, h * x = 0) → IsDomain (Localization.Away h) ∧ IsIntegrallyClosed (Localization.Away h) ∧ ((algebraMap T (Localization.Away h)).comp ι₀).Etale ∧ Function.Injective ((algebraMap T (Localization.Away h)).comp ι₀) ∧ (q.map (algebraMap T (Localization.Away h))).IsMaximal ∧ (q.map (algebraMap T (Localization.Away h))).comap (algebraMap T (Localization.Away h)) = q :=
by
  intro C T _ _ _ _ ι₀ hι₀ q hq P₀ h hP₀ hP₀q hhq hkill
  have hqP : q.IsPrime := hq.isPrime
  have hhP₀ : h ∉ P₀ := fun hm => hhq (hP₀q hm)
  have hdq : Disjoint (Submonoid.powers h : Set T) (q : Set T) :=
    (Ideal.disjoint_powers_iff_notMem h hqP.isRadical).mpr hhq
  have hdP : Disjoint (Submonoid.powers h : Set T) (P₀ : Set T) :=
    (Ideal.disjoint_powers_iff_notMem h hP₀.isRadical).mpr hhP₀
  have hcomap : (q.map (algebraMap T (Localization.Away h))).comap
      (algebraMap T (Localization.Away h)) = q :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers h) (Localization.Away h)
      hqP hdq
  have hmax : (q.map (algebraMap T (Localization.Away h))).IsMaximal := by
    haveI : (Ideal.under T (q.map (algebraMap T (Localization.Away h)))).IsMaximal := by
      rw [Ideal.under_def, hcomap]; exact hq
    exact IsLocalization.isMaximal_of_isMaximal_under (Submonoid.powers h) _ _
  have hbot : P₀.map (algebraMap T (Localization.Away h)) = ⊥ := by
    rw [eq_bot_iff, Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap, Ideal.mem_bot, IsLocalization.map_eq_zero_iff (Submonoid.powers h)]
    exact ⟨⟨h, Submonoid.mem_powers h⟩, hkill x hx⟩
  have hPrime : (P₀.map (algebraMap T (Localization.Away h))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) _ P₀ hP₀ hdP
  haveI : (⊥ : Ideal (Localization.Away h)).IsPrime := hbot ▸ hPrime
  haveI hdom : IsDomain (Localization.Away h) := IsDomain.of_bot_isPrime _
  have hα : (algebraMap T (Localization.Away h)).Etale := RingHom.etale_algebraMap.mpr inferInstance
  have het : ((algebraMap T (Localization.Away h)).comp ι₀).Etale :=
    RingHom.Etale.stableUnderComposition ι₀ _ hι₀ hα
  letI : Algebra C (Localization.Away h) := ((algebraMap T (Localization.Away h)).comp ι₀).toAlgebra
  haveI : Algebra.Etale C (Localization.Away h) := het
  have hinj : Function.Injective ((algebraMap T (Localization.Away h)).comp ι₀) := by
    rw [injective_iff_map_eq_zero]
    intro c hc
    by_contra hc0
    have hreg : IsSMulRegular (Localization.Away h) c :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hc0)
    apply one_ne_zero (α := Localization.Away h)
    apply hreg
    show c • (1 : Localization.Away h) = c • 0
    rw [smul_zero, Algebra.smul_def, mul_one]
    exact hc
  have hic : IsIntegrallyClosed (Localization.Away h) := by
    apply IsIntegrallyClosed.of_localization_maximal
    intro p _ _
    exact (wc_pks_etale_localization_normal C (Localization.Away h) p).2
  exact ⟨hdom, hic, het, hinj, hmax, hcomap⟩

theorem wcpa_dj_llsm_nrc_pd_assembly : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (C : Type u) [CommRing C] (jW : ↥W →+* C), Function.Injective jW → jW.FiniteType → ∀ (a : ↥W), a ∈ IsLocalRing.maximalIdeal ↥W → a ≠ 0 → ∀ (T : Type u) [CommRing T] (ι₀ : C →+* T) (μ₀ : wcNcRing W a →+* T), RingHom.Etale (R := wcNcRing W a) (S := T) μ₀ → μ₀.comp (algebraMap ↥W (wcNcRing W a)) = ι₀.comp jW → ∀ (q : Ideal T), q.comap μ₀ = Ideal.map (Ideal.Quotient.mk (wcNcIdeal W a)) (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔ Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) → ∀ h : T, (∀ x ∈ q, x * h ∈ (Ideal.map (Ideal.Quotient.mk (wcNcIdeal W a)) (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔ Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W))).map μ₀) → IsDomain (Localization.Away h) → IsIntegrallyClosed (Localization.Away h) → ((algebraMap T (Localization.Away h)).comp ι₀).Etale → Function.Injective ((algebraMap T (Localization.Away h)).comp ι₀) → (q.map (algebraMap T (Localization.Away h))).IsMaximal → ∀ (Q : Ideal C), (q.map (algebraMap T (Localization.Away h))).comap ((algebraMap T (Localization.Away h)).comp ι₀) = Q → ∃ (B : Type u) (_ : CommRing B) (_ : IsDomain B) (_ : Algebra ↥W B) (ι : C →+* B) (𝔮 : Ideal B) (u' v' : B) (g' : ↥W), ι.Etale ∧ Function.Injective ι ∧ ι.comp jW = algebraMap ↥W B ∧ 𝔮.comap ι = Q ∧ wcLlsPD W B 𝔮 (.ann u' v' g') ∧ ∀ 𝔠 : Ideal C, 𝔠.IsPrime → 𝔠 ≤ Q → ∃ 𝔠' : Ideal B, 𝔠'.IsPrime ∧ 𝔠' ≤ 𝔮 ∧ 𝔠'.comap ι = 𝔠 :=
by
  intro Ω _ W C _ jW hjW hjFT a ham ha T _ ι₀ μ₀ hμ₀ hcomp q hq h hfib hdom hic het hinj hmax Q hQ
  classical

  obtain ⟨P, hP⟩ : ∃ P : Ideal (wcNcRing W a), P = Ideal.map (Ideal.Quotient.mk (wcNcIdeal W a))
      (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
        Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) := ⟨_, rfl⟩
  rw [← hP] at hq hfib
  set α := algebraMap T (Localization.Away h) with hα
  set ι : C →+* Localization.Away h := α.comp ι₀ with hι
  set φ : wcNcRing W a →+* Localization.Away h := α.comp μ₀ with hφ

  have hH : ∀ w : ↥W, φ (Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C w)) = ι (jW w) := by
    intro w
    exact congrArg (fun z => α z) (RingHom.congr_fun hcomp w)

  have huv : φ (Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 0)) *
      φ (Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 1)) = ι (jW a) := by
    rw [← map_mul, ← map_mul, ← hH a]
    congr 1
    apply Ideal.Quotient.eq.mpr
    exact Ideal.subset_span (Set.mem_singleton _)

  have hαet : α.Etale :=
    RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway (A := Localization.Away h) h)
  have hφet : RingHom.Etale (R := wcNcRing W a) (S := Localization.Away h) φ := by
    have := RingHom.Etale.stableUnderComposition (R := wcNcRing W a) (S := T)
      (T := Localization.Away h) μ₀ α hμ₀ hαet
    exact this

  have hιFT : ι.FiniteType := by
    letI := ι.toAlgebra
    haveI : Algebra.Etale C (Localization.Away h) := RingHom.Etale.toAlgebra het
    exact RingHom.finiteType_algebraMap.mpr inferInstance

  have hJq : P.map μ₀ ≤ q := Ideal.map_le_iff_le_comap.mpr (le_of_eq hq.symm)
  have hqJ : q.map α = (P.map μ₀).map α := by
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap]
      have h1 : α x * α h ∈ (P.map μ₀).map α := by
        rw [← map_mul]; exact Ideal.mem_map_of_mem _ (hfib x hx)
      exact (Ideal.mul_unit_mem_iff_mem _ (IsLocalization.Away.algebraMap_isUnit h)).mp h1
    · exact Ideal.map_mono hJq

  have hGD : ∀ 𝔠 : Ideal C, 𝔠.IsPrime → 𝔠 ≤ Q → ∃ 𝔠' : Ideal (Localization.Away h),
      𝔠'.IsPrime ∧ 𝔠' ≤ q.map α ∧ 𝔠'.comap ι = 𝔠 := by
    intro 𝔠 h𝔠 h𝔠Q
    letI := ι.toAlgebra
    haveI : Algebra.Etale C (Localization.Away h) := RingHom.Etale.toAlgebra het
    haveI : (q.map α).IsPrime := hmax.isPrime
    haveI : Q.IsPrime := by rw [← hQ]; exact Ideal.comap_isPrime _ _
    haveI : (q.map α).LiesOver Q := ⟨hQ.symm⟩
    obtain ⟨P', hP'le, hP'p, hP'o⟩ := Ideal.exists_ideal_le_liesOver_of_le (q.map α) h𝔠Q
    exact ⟨P', hP'p, hP'le, (Ideal.over_def P' 𝔠).symm⟩
  letI iWB : Algebra ↥W (Localization.Away h) := (ι.comp jW).toAlgebra
  have hHring : ((φ.comp (Ideal.Quotient.mk (wcNcIdeal W a))).comp MvPolynomial.C) =
      algebraMap ↥W (Localization.Away h) := RingHom.ext fun w => hH w
  have hqeq : q.map α = Ideal.span {φ (Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 0)),
      φ (Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 1))} ⊔
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W (Localization.Away h)) := by
    rw [hqJ, Ideal.map_map, hP, Ideal.map_map, Ideal.map_sup, Ideal.map_span, Set.image_pair,
      Ideal.map_map, ← hφ, hHring]
    rfl
  have hFT : Algebra.FiniteType ↥W (Localization.Away h) :=
    RingHom.finiteType_algebraMap.mp (hιFT.comp hjFT)
  have hNZ : NoZeroSMulDivisors ↥W (Localization.Away h) := by
    refine ⟨fun {c x} hcx => ?_⟩
    rw [Algebra.smul_def] at hcx
    rcases mul_eq_zero.mp hcx with h1 | h1
    · left
      apply hjW
      apply hinj
      rw [map_zero, map_zero]
      exact h1
    · right; exact h1
  have h1q : (1 : Localization.Away h) ∉ q.map α := fun h1 =>
    hmax.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  have hfet : RingHom.Etale (R := MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})
      (S := Localization.Away (1 : Localization.Away h))
      ((algebraMap (Localization.Away h) (Localization.Away (1 : Localization.Away h))).comp φ) := by
    have h1et : (algebraMap (Localization.Away h)
        (Localization.Away (1 : Localization.Away h))).Etale :=
      RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway
        (A := Localization.Away (1 : Localization.Away h)) (1 : Localization.Away h))
    have := RingHom.Etale.stableUnderComposition (R := wcNcRing W a) (S := Localization.Away h)
      (T := Localization.Away (1 : Localization.Away h)) φ _ hφet h1et
    exact this
  have hPD : wcLlsPD W (Localization.Away h) (q.map α)
      (.ann (φ (Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 0)))
        (φ (Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 1))) a) := by
    unfold wcLlsPD
    refine ⟨hFT, hNZ, hic, hmax, ?_, ham, ha, huv, hqeq, 1, h1q,
      (algebraMap (Localization.Away h) (Localization.Away (1 : Localization.Away h))).comp φ,
      ?_, rfl, rfl, hfet⟩
    · rw [hqeq]; exact le_sup_right
    · apply RingHom.ext
      intro w
      show algebraMap (Localization.Away h) (Localization.Away (1 : Localization.Away h))
          (φ (Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C w))) =
        algebraMap (Localization.Away h) (Localization.Away (1 : Localization.Away h)) (ι (jW w))
      rw [hH]
  exact ⟨Localization.Away h, inferInstance, hdom, iWB, ι, q.map α, _, _, a, het, hinj, rfl, hQ,
    hPD, hGD⟩

theorem wcpa_dj_llsm_neat_ring_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (k : wcLlsKind W A), wcLlsPD W A 𝔭 k →
    ∀ (z0 : A) (b₁ : ↥W), b₁ ∈ IsLocalRing.maximalIdeal ↥W → b₁ ≠ 0 →
    ((∃ (t : A) (c : ↥W), k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧
        z0 = t - algebraMap ↥W A c) ∨
      (∃ (u v : A) (g : ↥W), k = .ann u v g ∧ b₁ ∣ g ∧ z0 = u)) →
    ∀ (s : K), s = algebraMap A K (algebraMap ↥W A b₁) / algebraMap A K z0 →
    ∀ (M : Type u) [Field M] [Algebra K M] [FiniteDimensional K M]
      (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) [Q.IsPrime],
    Q.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) =
      Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z0,
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) →
    wcpaDjLkDelta (wcLlsFS W ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A)))
        ↥(Algebra.adjoin A {s}) Q) = 1 →
    wcpaDjLkBranches (wcLlsFS W ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A)))
        ↥(Algebra.adjoin A {s}) Q) = 2 →
    ∃ (B : Type u) (_ : CommRing B) (_ : IsDomain B) (_ : Algebra ↥W B)
      (ι : ↥(integralClosure ↥(Algebra.adjoin A {s}) M) →+* B) (𝔮 : Ideal B) (u' v' : B)
      (g' : ↥W),
      ι.Etale ∧ Function.Injective ι ∧
      ι.comp ((algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)).comp
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) = algebraMap ↥W B ∧
      𝔮.comap ι = Q ∧ wcLlsPD W B 𝔮 (.ann u' v' g') ∧
      ∀ 𝔠 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) M), 𝔠.IsPrime → 𝔠 ≤ Q →
        ∃ 𝔠' : Ideal B, 𝔠'.IsPrime ∧ 𝔠' ≤ 𝔮 ∧ 𝔠'.comap ι = 𝔠 :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 k hPD z0 b₁ hb₁m hb₁0 hshape s hs M _ _ _ Q _ hQ hδ1 hbr2
  classical

  have hfin := wcpa_dj_llsm_sd_normalization_finite Ω W hW hWt A K M 𝔭 k hPD s
  obtain ⟨hFT, hFl, hj, hnorm⟩ :=
    wcpa_dj_llsm_sdg_chart_ring Ω W hW hWt A K M 𝔭 k hPD s hfin
  obtain ⟨hQmax, hQW, hdle⟩ :=
    wcpa_dj_llsm_sdg_fibre_dim Ω W hW hWt A K M 𝔭 k hPD z0 b₁ hb₁m hb₁0 hshape s hs Q hQ hfin
  haveI : IsIntegrallyClosed ↥(integralClosure ↥(Algebra.adjoin A {s}) M) := hnorm
  haveI : Q.IsMaximal := hQmax
  letI : Algebra ↥W ↥(integralClosure ↥(Algebra.adjoin A {s}) M) := (wcSdgJ W A K M s).toAlgebra

  haveI hLFT : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W ↥(integralClosure ↥(Algebra.adjoin A {s}) M)))) :=
    HasRingHomProperty.Spec_iff.mpr hFT
  have hFlat : Flat (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W ↥(integralClosure ↥(Algebra.adjoin A {s}) M)))) :=
    HasRingHomProperty.Spec_iff.mpr hFl

  obtain ⟨w, hw, hwcl, ⟨ψ₀⟩⟩ :=
    wcpa_dj_llsm_sdg_affine_fibre_point ↥W ↥(integralClosure ↥(Algebra.adjoin A {s}) M) Q hQW
  have hS : {x : ↥(integralClosure ↥(Algebra.adjoin A {s}) M) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (x : M) = ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} =
      (wcSdgJ W A K M s) '' (IsLocalRing.maximalIdeal ↥W : Set ↥W) := by
    ext x
    constructor
    · rintro ⟨w, hw, hx⟩
      exact ⟨w, hw, Subtype.ext (by rw [hx]; rfl)⟩
    · rintro ⟨w, hw, rfl⟩
      exact ⟨w, hw, rfl⟩
  have hI : (Ideal.span {x : ↥(integralClosure ↥(Algebra.adjoin A {s}) M) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (x : M) = ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}).map
        (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) M) (Localization.AtPrime Q)) =
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) M) (Localization.AtPrime Q)).comp
          (algebraMap ↥W ↥(integralClosure ↥(Algebra.adjoin A {s}) M))) := by
    rw [hS, ← Ideal.map_map]
    rfl
  let ψ := ψ₀.trans (Ideal.quotEquivOfEq hI).symm

  haveI hCQn : IsIntegrallyClosed (Localization.AtPrime Q) :=
    isIntegrallyClosed_of_isLocalization (Localization.AtPrime Q) Q.primeCompl
      (Ideal.primeCompl_le_nonZeroDivisors Q)
  have hinj : Function.Injective
      ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) M) (Localization.AtPrime Q)).comp
        (algebraMap ↥W ↥(integralClosure ↥(Algebra.adjoin A {s}) M))) :=
    (IsLocalization.injective (Localization.AtPrime Q)
      (Ideal.primeCompl_le_nonZeroDivisors Q)).comp hj
  haveI hred0 := wcpa_dj_llsm_sdg_reduced_quotient Ω W (Localization.AtPrime Q) _ hinj
  have hred : _root_.IsReduced ↑((Limits.pullback (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W ↥(integralClosure ↥(Algebra.adjoin A {s}) M))))
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk
        w) :=
    isReduced_of_injective ψ₀ ψ₀.injective
  have hdim := ringKrullDim_eq_of_ringEquiv ψ
  have hdle' := hdim.trans_le hdle

  obtain ⟨hδ, hbr⟩ := wcpa_dj_lr1k_llfi_ringequiv _ _ ψ

  obtain ⟨a, ham, hch⟩ := wcpa_dj_llsm_sdg_node_chart Ω W _ _ hFlat w hwcl hred hdle'
    (hδ.trans hδ1) (hbr.trans hbr2)
  rw [hw] at hch

  obtain ⟨P, _, e, he⟩ := wcNd_hens_exists (Localization.AtPrime Q)
    (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) inferInstance
  obtain ⟨e', he', -⟩ :=
    wcpa_dj_llsm_sdg_hens_bridge ↥W ↥(integralClosure ↥(Algebra.adjoin A {s}) M) Q P e he
  haveI hPdom : IsDomain P :=
    (wcNd_hens_normal_domain (Localization.AtPrime Q) (IsLocalRing.maximalIdeal _)
      inferInstance P e he).1
  obtain ⟨φ, -, hhens⟩ := wcpa_dj_lr1k_lf_chart_transfer _ _ _ _ _ _ hch P e' he'
  have ha : a ≠ 0 := by
    rintro rfl
    exact wcpa_dj_llsm_sdg_node_a_ne_zero Ω W hWt P φ hhens

  obtain ⟨T, _, ι₀, μ₀, q₀, hq₀, hι₀, hμ₀, hcomp, hq₀ι, hq₀μ⟩ :=
    wcpa_dj_llsm_nrc_affine_chart ↥W (wcNcRing W a) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
      Q _ hch
  haveI : q₀.IsPrime := hq₀

  letI : Algebra ↥(integralClosure ↥(Algebra.adjoin A {s}) M) T := ι₀.toAlgebra
  haveI hCTet : Algebra.Etale ↥(integralClosure ↥(Algebra.adjoin A {s}) M) T := hι₀
  have hdomT := (wc_pks_etale_localization_normal ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
    T q₀).1

  obtain ⟨r, P', hP', hP0, hPb⟩ :=
    wcpa_dj_llsm_nrc_generic_primes ↥(integralClosure ↥(Algebra.adjoin A {s}) M) T hCTet
  obtain ⟨P₀, h₁, hP₀, hP₀q, hh₁q, hkill⟩ :=
    wcpa_dj_llsm_nrc_domain_kill T q₀ hdomT r P' hP' hP0 hPb

  have hmax : (Ideal.map (Ideal.Quotient.mk (wcNcIdeal W a))
      (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
        Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W))).IsMaximal := by
    have h := wcLlsKP_bdsm_origin_maximal W a ham
    rw [Ideal.map_sup, Ideal.map_span, Set.image_pair, Ideal.map_map]
    exact h

  obtain ⟨hq₀max, h₂, hh₂q, hfib⟩ :=
    wcpa_dj_llsm_nrc_fibre_idempotent (wcNcRing W a) T μ₀ hμ₀ _ hmax q₀ hq₀μ

  have hhq : h₁ * h₂ ∉ q₀ := fun hm => (hq₀.mem_or_mem hm).elim hh₁q hh₂q
  have hkill' : ∀ x ∈ P₀, h₁ * h₂ * x = 0 := by
    intro x hx
    rw [mul_comm h₁ h₂, mul_assoc, hkill x hx, mul_zero]
  have hfib' : ∀ x ∈ q₀, x * (h₁ * h₂) ∈ (Ideal.map (Ideal.Quotient.mk (wcNcIdeal W a))
      (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
        Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W))).map μ₀ := by
    intro x hx
    rw [mul_comm h₁ h₂, ← mul_assoc]
    exact Ideal.mul_mem_right _ _ (hfib x hx)

  obtain ⟨hdom, hic, het, hinjι, hmaxB, hcomapB⟩ :=
    wcpa_dj_llsm_nrc_localize_props ↥(integralClosure ↥(Algebra.adjoin A {s}) M) T ι₀ hι₀ q₀
      hq₀max P₀ (h₁ * h₂) hP₀ hP₀q hhq hkill'

  have hQB : (q₀.map (algebraMap T (Localization.Away (h₁ * h₂)))).comap
      ((algebraMap T (Localization.Away (h₁ * h₂))).comp ι₀) = Q := by
    rw [← Ideal.comap_comap, hcomapB, hq₀ι]
  exact wcpa_dj_llsm_nrc_pd_assembly W ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
    (wcSdgJ W A K M s) hj hFT a ham ha T ι₀ μ₀ hμ₀ hcomp q₀ hq₀μ (h₁ * h₂) hfib' hdom hic het
    hinjι hmaxB Q hQB

theorem wcpa_dj_llsm_neat_monomial : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] (𝔮 : Ideal B) (u' v' : B) (g' : ↥W),
    wcLlsPD W B 𝔮 (.ann u' v' g') →
    ∀ (F G : B) (b₁ : ↥W), b₁ ≠ 0 → F * G = algebraMap ↥W B b₁ → F ∈ 𝔮 → G ∈ 𝔮 →
    ∀ (𝔠₀ 𝔠₁ : Ideal B), 𝔠₀.IsPrime → 𝔠₁.IsPrime → 𝔠₀ ≤ 𝔮 → 𝔠₁ ≤ 𝔮 →
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) ≤ 𝔠₀ →
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) ≤ 𝔠₁ → G ∉ 𝔠₀ → F ∉ 𝔠₁ →
    ∃ (e : ℕ) (h a a' : B), 0 < e ∧ h ∉ 𝔮 ∧
      ((F * h = a * u' ^ e ∧ u' ^ e * h = a' * F) ∨ (F * h = a * v' ^ e ∧ v' ^ e * h = a' * F)) ∧
      g' ^ e ∣ b₁ ∧ b₁ ∣ g' ^ e :=
by
  intro Ω _ _ W hW hWt B _ _ _ 𝔮 u' v' g' hPD F G b₁ hb₁0 hFG hF𝔮 hG𝔮 𝔠₀ 𝔠₁ h𝔠₀ h𝔠₁
    h𝔠₀q h𝔠₁q hm𝔠₀ hm𝔠₁ hG𝔠₀ hF𝔠₁
  classical
  obtain ⟨hFT, -, hIC, hmax, hm𝔮, -, hg'0, -, -, -⟩ := id hPD
  have h𝔮p : 𝔮.IsPrime := hmax.isPrime

  obtain ⟨P, _, φ, hHens, hDesc⟩ := wcpa_dj_llsm_kptf_hens_descent B 𝔮 h𝔮p

  have hres := wcpa_dj_llsm_kptf_residue_trivial Ω W B 𝔮 hFT hmax hm𝔮
  obtain ⟨fN, hPres, hX0, hX1⟩ :=
    wcpa_dj_llsm_kptf_hens_chart Ω W B 𝔮 u' v' g' hPD hres P φ hHens

  haveI : IsIntegrallyClosed B := hIC
  obtain ⟨hPdom, -⟩ := wcNd_hens_normal_domain B 𝔮 h𝔮p P φ hHens
  haveI := hPdom
  obtain ⟨σ, hσ⟩ : ∃ σ : ↥W →+* P, σ = φ.comp (algebraMap ↥W B) := ⟨_, rfl⟩
  rw [← hσ] at hPres
  have hσa : ∀ w : ↥W, σ w = φ (algebraMap ↥W B w) := fun w => by rw [hσ]; rfl
  have hσinj : Function.Injective σ :=
    wcpa_dj_lr1k_ebnt_pres_sigma_injective Ω W P σ g' fN hPres

  obtain ⟨hBy, hX0nBy, -⟩ := wcpa_dj_lr1k_ebnt_pres_branch Ω W hW hWt P σ g' fN hPres
  obtain ⟨f', hPres', hf'0, hf'1⟩ := wcpa_dj_lr1k_ebnt_pres_swap Ω W P σ g' fN hPres
  obtain ⟨hBx, hX1nBx, -⟩ := wcpa_dj_lr1k_ebnt_pres_branch Ω W hW hWt P σ g' f' hPres'
  rw [hf'1] at hBx
  rw [hf'1, hf'0] at hX1nBx

  have e1 : wcEbntX W g' 0 * wcEbntX W g' 1 =
      (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g' :
        MvPolynomial (Fin 2) ↥W)})) (MvPolynomial.C g') := by
    simp only [wcEbntX, ← map_mul]
    rw [Ideal.Quotient.eq]
    exact Ideal.subset_span (Set.mem_singleton _)
  have hnode : fN (wcEbntX W g' 0) * fN (wcEbntX W g' 1) = σ g' := by
    rw [← map_mul, e1]
    exact RingHom.congr_fun hPres.2.2.1 g'

  have hprod : φ F * φ G = σ b₁ := by rw [hσa, ← hFG, map_mul]

  obtain ⟨α, n, η, -, hη, hFform⟩ := wcpa_dj_lr1k_ebnt_dominant_monomial Ω W hW hWt P σ g' fN
    hPres (φ F) (φ G) b₁ hb₁0 hprod
  obtain ⟨α', n', η', -, hη', hGform⟩ := wcpa_dj_lr1k_ebnt_dominant_monomial Ω W hW hWt P σ g' fN
    hPres (φ G) (φ F) b₁ hb₁0 (by rw [mul_comm]; exact hprod)

  obtain ⟨x0, hx0def⟩ : ∃ x : P, x = fN (wcEbntX W g' 0) := ⟨_, rfl⟩
  obtain ⟨x1, hx1def⟩ : ∃ x : P, x = fN (wcEbntX W g' 1) := ⟨_, rfl⟩
  rw [← hx0def] at hX0 hBx hX1nBx hX0nBy hnode hFform hGform
  rw [← hx1def] at hX1 hBy hX1nBx hX0nBy hnode hFform hGform
  obtain ⟨𝔅x, h𝔅x⟩ : ∃ I : Ideal P,
      I = Ideal.span {x0} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ := ⟨_, rfl⟩
  obtain ⟨𝔅y, h𝔅y⟩ : ∃ I : Ideal P,
      I = Ideal.span {x1} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ := ⟨_, rfl⟩
  have hx0Bx : x0 ∈ 𝔅x := by
    rw [h𝔅x]; exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self x0)
  have hx1By : x1 ∈ 𝔅y := by
    rw [h𝔅y]; exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self x1)
  have hσBx : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, σ w ∈ 𝔅x := fun w hw => by
    rw [h𝔅x]; exact Ideal.mem_sup_right (Ideal.mem_map_of_mem σ hw)
  have hσBy : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, σ w ∈ 𝔅y := fun w hw => by
    rw [h𝔅y]; exact Ideal.mem_sup_right (Ideal.mem_map_of_mem σ hw)
  rw [← h𝔅x] at hBx hX1nBx
  rw [← h𝔅y] at hBy hX0nBy
  have hx0nu : ¬ IsUnit x0 := fun hu => hBx.ne_top (Ideal.eq_top_of_isUnit_mem _ hx0Bx hu)
  have hx1nu : ¬ IsUnit x1 := fun hu => hBy.ne_top (Ideal.eq_top_of_isUnit_mem _ hx1By hu)

  have H1 : ∀ (p : P) (𝔄 : Ideal P), 𝔄.IsPrime → p ∉ 𝔄 → ¬ IsUnit p →
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W, σ w ∈ 𝔄) →
      ∀ (ε : P) (c : ↥W) (k : ℕ), IsUnit ε → 1 ≤ k → ε * p ^ k ≠ σ c := by
    intro p 𝔄 h𝔄 hp𝔄 hpu hσ𝔄 ε c k hε hk heq
    by_cases hc : c ∈ IsLocalRing.maximalIdeal ↥W
    · have h1 : ε * p ^ k ∈ 𝔄 := by rw [heq]; exact hσ𝔄 c hc
      rcases h𝔄.mem_or_mem h1 with h | h
      · exact h𝔄.ne_top (Ideal.eq_top_of_isUnit_mem _ h hε)
      · exact hp𝔄 (h𝔄.mem_of_pow_mem k h)
    · have hcu : IsUnit c := IsLocalRing.notMem_maximalIdeal.mp hc
      have h2 : IsUnit (ε * p ^ k) := by rw [heq]; exact hcu.map σ
      exact hpu ((isUnit_pow_iff (by omega)).mp (isUnit_of_mul_isUnit_right h2))
  have HC : ∀ (p : P) (𝔄 : Ideal P), 𝔄.IsPrime → p ∉ 𝔄 → ¬ IsUnit p →
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W, σ w ∈ 𝔄) →
      ∀ (ε : P) (d b : ↥W) (k : ℕ), IsUnit ε → 1 ≤ k → d ≠ 0 → b ≠ 0 →
        ε * σ d * p ^ k ≠ σ b := by
    intro p 𝔄 h𝔄 hp𝔄 hpu hσ𝔄 ε d b k hε hk hd hb heq
    have hσd : σ d ≠ 0 := fun h => hd (hσinj (h.trans (map_zero σ).symm))
    have hσb : σ b ≠ 0 := fun h => hb (hσinj (h.trans (map_zero σ).symm))
    rcases ValuationRing.dvd_total d b with ⟨c, hc⟩ | ⟨c, hc⟩
    · apply H1 p 𝔄 h𝔄 hp𝔄 hpu hσ𝔄 ε c k hε hk
      apply mul_left_cancel₀ hσd
      calc σ d * (ε * p ^ k) = ε * σ d * p ^ k := by ring
        _ = σ b := heq
        _ = σ d * σ c := by rw [hc, map_mul]
    · have h1 : σ b * (ε * σ c * p ^ k) = σ b * 1 := by
        calc σ b * (ε * σ c * p ^ k) = ε * σ (b * c) * p ^ k := by rw [map_mul]; ring
          _ = ε * σ d * p ^ k := by rw [hc]
          _ = σ b := heq
          _ = σ b * 1 := (mul_one _).symm
      have h2 := mul_left_cancel₀ hσb h1
      have h3 : IsUnit (ε * σ c * p ^ k) := by rw [h2]; exact isUnit_one
      exact hpu ((isUnit_pow_iff (by omega)).mp (isUnit_of_mul_isUnit_right h3))
  have Hσunit : ∀ c : ↥W, IsUnit (σ c) → IsUnit c := by
    intro c hc
    by_contra hcu
    have hcm : c ∈ IsLocalRing.maximalIdeal ↥W := by
      by_contra h; exact hcu (IsLocalRing.notMem_maximalIdeal.mp h)
    exact hBx.ne_top (Ideal.eq_top_of_isUnit_mem _ (hσBx c hcm) hc)
  have HE : ∀ (ε : P) (d b : ↥W), IsUnit ε → ε * σ d = σ b → d ≠ 0 → b ≠ 0 →
      d ∣ b ∧ b ∣ d := by
    intro ε d b hε heq hd hb
    have hσd : σ d ≠ 0 := fun h => hd (hσinj (h.trans (map_zero σ).symm))
    have hσb : σ b ≠ 0 := fun h => hb (hσinj (h.trans (map_zero σ).symm))
    rcases ValuationRing.dvd_total d b with ⟨c, hc⟩ | ⟨c, hc⟩
    · have h1 : σ d * ε = σ d * σ c := by
        calc σ d * ε = ε * σ d := mul_comm _ _
          _ = σ b := heq
          _ = σ d * σ c := by rw [hc, map_mul]
      have h2 : ε = σ c := mul_left_cancel₀ hσd h1
      have hcu : IsUnit c := Hσunit c (by rw [← h2]; exact hε)
      exact ⟨⟨c, hc⟩, ⟨↑hcu.unit⁻¹, by rw [hc, mul_assoc, IsUnit.mul_val_inv, mul_one]⟩⟩
    · have h1 : σ b * (ε * σ c) = σ b * 1 := by
        calc σ b * (ε * σ c) = ε * σ (b * c) := by rw [map_mul]; ring
          _ = ε * σ d := by rw [hc]
          _ = σ b := heq
          _ = σ b * 1 := (mul_one _).symm
      have h2 := mul_left_cancel₀ hσb h1
      have h3 : IsUnit (ε * σ c) := by rw [h2]; exact isUnit_one
      have hcu : IsUnit c := Hσunit c (isUnit_of_mul_isUnit_right h3)
      exact ⟨⟨↑hcu.unit⁻¹, by rw [hc, mul_assoc, IsUnit.mul_val_inv, mul_one]⟩, ⟨c, hc⟩⟩
  have HB : ∀ (ε : P) (n n' : ℕ), IsUnit ε → 1 ≤ n → 1 ≤ n' →
      ε * x0 ^ n * x1 ^ n' = σ b₁ → n = n' ∧ g' ^ n ∣ b₁ ∧ b₁ ∣ g' ^ n := by
    intro ε n n' hε hn hn' heq
    rcases lt_trichotomy n n' with hlt | hnn | hgt
    · exfalso
      obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_lt hlt
      apply HC x1 𝔅x hBx hX1nBx hx1nu hσBx ε (g' ^ n) b₁ (k + 1) hε (by omega)
        (pow_ne_zero _ hg'0) hb₁0
      rw [← heq, map_pow, ← hnode]; ring
    · refine ⟨hnn, ?_⟩
      subst hnn
      have h1 : ε * σ (g' ^ n) = σ b₁ := by rw [← heq, map_pow, ← hnode]; ring
      exact HE ε (g' ^ n) b₁ hε h1 (pow_ne_zero _ hg'0) hb₁0
    · exfalso
      obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_lt hgt
      apply HC x0 𝔅y hBy hX0nBy hx0nu hσBy ε (g' ^ n') b₁ (k + 1) hε (by omega)
        (pow_ne_zero _ hg'0) hb₁0
      rw [← heq, map_pow, ← hnode]; ring

  have S7 : ∀ (z : B) (θ : P), IsUnit θ → φ F = θ * φ z →
      ∃ h a a' : B, h ∉ 𝔮 ∧ F * h = a * z ∧ z * h = a' * F := by
    intro z θ hθ hFz
    obtain ⟨a₁, s₁, hs₁, h₁⟩ := hDesc F z (Ideal.mem_span_singleton'.mpr ⟨θ, hFz.symm⟩)
    obtain ⟨a₂, s₂, hs₂, h₂⟩ := hDesc z F (Ideal.mem_span_singleton'.mpr
      ⟨↑hθ.unit⁻¹, by rw [hFz, ← mul_assoc, IsUnit.val_inv_mul, one_mul]⟩)
    refine ⟨s₁ * s₂, a₁ * s₂, a₂ * s₁, fun hm => (h𝔮p.mem_or_mem hm).elim hs₁ hs₂, ?_, ?_⟩
    · linear_combination s₂ * h₁
    · linear_combination s₁ * h₂

  have Hunit : ∀ (H : B) (𝔠 : Ideal B), 𝔠.IsPrime → 𝔠 ≤ 𝔮 →
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) ≤ 𝔠 → H ∉ 𝔠 →
      ∀ (a : ↥W) (r : P), φ H = σ a * r → IsUnit a := by
    intro H 𝔠 h𝔠 h𝔠q hm𝔠 hH a r hr
    by_contra hau
    have ham : a ∈ IsLocalRing.maximalIdeal ↥W := by
      by_contra h; exact hau (IsLocalRing.notMem_maximalIdeal.mp h)
    have hmem : φ H ∈ Ideal.span {φ (algebraMap ↥W B a)} :=
      Ideal.mem_span_singleton'.mpr ⟨r, by rw [hr, hσa, mul_comm]⟩
    obtain ⟨c, s, hs, hHs⟩ := hDesc H (algebraMap ↥W B a) hmem
    have h1 : H * s ∈ 𝔠 := by
      rw [hHs]; exact Ideal.mul_mem_right _ _ (hm𝔠 (Ideal.mem_map_of_mem _ ham))
    rcases h𝔠.mem_or_mem h1 with h | h
    · exact hH h
    · exact hs (h𝔠q h)
  have hαu : IsUnit α := by
    rcases hFform with h | h
    · exact Hunit F 𝔠₁ h𝔠₁ h𝔠₁q hm𝔠₁ hF𝔠₁ α (η * x0 ^ n) (by rw [h]; ring)
    · exact Hunit F 𝔠₁ h𝔠₁ h𝔠₁q hm𝔠₁ hF𝔠₁ α (η * x1 ^ n) (by rw [h]; ring)
  have hα'u : IsUnit α' := by
    rcases hGform with h | h
    · exact Hunit G 𝔠₀ h𝔠₀ h𝔠₀q hm𝔠₀ hG𝔠₀ α' (η' * x0 ^ n') (by rw [h]; ring)
    · exact Hunit G 𝔠₀ h𝔠₀ h𝔠₀q hm𝔠₀ hG𝔠₀ α' (η' * x1 ^ n') (by rw [h]; ring)
  have hη₁ : IsUnit (η * σ α) := hη.mul (hαu.map σ)
  have hη₁' : IsUnit (η' * σ α') := hη'.mul (hα'u.map σ)

  have hFnu : ¬ IsUnit (φ F) := fun hu => (hHens.2.1 F).mp hu hF𝔮
  have hGnu : ¬ IsUnit (φ G) := fun hu => (hHens.2.1 G).mp hu hG𝔮
  have hn : 1 ≤ n := by
    rcases Nat.eq_zero_or_pos n with h0 | h0
    · exfalso; apply hFnu
      rcases hFform with h | h <;> (rw [h, h0, pow_zero, mul_one]; exact hη₁)
    · exact h0
  have hn' : 1 ≤ n' := by
    rcases Nat.eq_zero_or_pos n' with h0 | h0
    · exfalso; apply hGnu
      rcases hGform with h | h <;> (rw [h, h0, pow_zero, mul_one]; exact hη₁')
    · exact h0

  rcases hFform with hF0 | hF1 <;> rcases hGform with hG0 | hG1
  · exfalso
    apply H1 x0 𝔅y hBy hX0nBy hx0nu hσBy (η * σ α * (η' * σ α')) b₁ (n + n')
      (hη₁.mul hη₁') (by omega)
    rw [← hprod, hF0, hG0]; ring
  · obtain ⟨-, hd1, hd2⟩ := HB (η * σ α * (η' * σ α')) n n' (hη₁.mul hη₁') hn hn'
      (by rw [← hprod, hF0, hG1]; ring)
    obtain ⟨h, a, a', hh, e2, e3⟩ := S7 (u' ^ n) (η * σ α) hη₁ (by rw [hF0, map_pow, ← hX0])
    exact ⟨n, h, a, a', hn, hh, Or.inl ⟨e2, e3⟩, hd1, hd2⟩
  · obtain ⟨hnn, hd1, hd2⟩ := HB (η * σ α * (η' * σ α')) n' n (hη₁.mul hη₁') hn' hn
      (by rw [← hprod, hF1, hG0]; ring)
    rw [hnn] at hd1 hd2
    obtain ⟨h, a, a', hh, e2, e3⟩ := S7 (v' ^ n) (η * σ α) hη₁ (by rw [hF1, map_pow, ← hX1])
    exact ⟨n, h, a, a', hn, hh, Or.inr ⟨e2, e3⟩, hd1, hd2⟩
  · exfalso
    apply H1 x1 𝔅x hBx hX1nBx hx1nu hσBx (η * σ α * (η' * σ α')) b₁ (n + n')
      (hη₁.mul hη₁') (by omega)
    rw [← hprod, hF1, hG1]; ring

theorem wcpa_dj_llsm_neat_pd_localize_swap : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] (𝔮 : Ideal B) (u v : B) (g : ↥W),
    wcLlsPD W B 𝔮 (.ann u v g) →
    wcLlsPD W B 𝔮 (.ann v u g) ∧
    ∀ h : B, h ∉ 𝔮 → IsDomain (Localization.Away h) ∧
      wcLlsPD W (Localization.Away h) (𝔮.map (algebraMap B (Localization.Away h)))
        (.ann (algebraMap B (Localization.Away h) u) (algebraMap B (Localization.Away h) v) g) ∧
      (𝔮.map (algebraMap B (Localization.Away h))).comap (algebraMap B (Localization.Away h)) =
        𝔮 :=
by
  intro Ω _ W B _ _ _ 𝔮 u v g hPD
  obtain ⟨P1, P2, P3, P4, P5, P6, P7, P8, P9, h₀, hh₀, f, C1, C2, C3, C4⟩ := hPD

  have hswap : ∃ τ : (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+*
      (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}),
      τ.Etale ∧ (∀ a : ↥W, τ (Ideal.Quotient.mk _ (MvPolynomial.C a)) =
        Ideal.Quotient.mk _ (MvPolynomial.C a)) ∧
      τ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = Ideal.Quotient.mk _ (MvPolynomial.X 1) ∧
      τ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = Ideal.Quotient.mk _ (MvPolynomial.X 0) := by
    let ρ : MvPolynomial (Fin 2) ↥W →+* MvPolynomial (Fin 2) ↥W :=
      (MvPolynomial.rename (Equiv.swap (0 : Fin 2) 1)).toRingHom
    have hρX0 : ρ (MvPolynomial.X 0) = MvPolynomial.X 1 := by
      simp [ρ]
    have hρX1 : ρ (MvPolynomial.X 1) = MvPolynomial.X 0 := by
      simp [ρ]
    have hρC : ∀ a : ↥W, ρ (MvPolynomial.C a) = MvPolynomial.C a := by
      intro a; simp [ρ]
    have hIle : Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g :
        MvPolynomial (Fin 2) ↥W)} ≤ (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)}).comap ρ := by
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
      rw [map_sub, map_mul, hρX0, hρX1, hρC, mul_comm]
      exact Ideal.subset_span rfl
    let τ : (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+*
        (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) :=
      Ideal.quotientMap _ ρ hIle
    have hτ : ∀ p, τ (Ideal.Quotient.mk _ p) = Ideal.Quotient.mk _ (ρ p) :=
      fun p => Ideal.quotientMap_mk
    have hρρ : ∀ p, ρ (ρ p) = p := by
      have : ρ.comp ρ = RingHom.id _ := by
        apply MvPolynomial.ringHom_ext
        · intro a; simp only [RingHom.comp_apply, hρC, RingHom.id_apply]
        · intro i; fin_cases i
          · simp only [RingHom.comp_apply, Fin.zero_eta, hρX0, hρX1, RingHom.id_apply]
          · simp only [RingHom.comp_apply, Fin.mk_one, hρX0, hρX1, RingHom.id_apply]
      intro p
      exact RingHom.congr_fun this p
    have hττ : Function.Involutive τ := by
      intro x
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [hτ, hτ, hρρ]
    refine ⟨τ, RingHom.Etale.of_bijective hττ.bijective, fun a => ?_, ?_, ?_⟩
    · rw [hτ, hρC]
    · rw [hτ, hρX0]
    · rw [hτ, hρX1]
  obtain ⟨τ, hτet, hτC, hτX0, hτX1⟩ := hswap
  have hfτ : (f.comp τ).Etale := RingHom.Etale.stableUnderComposition τ f hτet C4
  refine ⟨⟨P1, P2, P3, P4, P5, P6, P7, by rw [mul_comm]; exact P8,
    by rw [P9, Set.pair_comm], h₀, hh₀, f.comp τ, ?_, ?_, ?_, hfτ⟩, ?_⟩
  · apply RingHom.ext; intro a
    have h1 := RingHom.congr_fun C1 a
    simp only [RingHom.comp_apply] at h1 ⊢
    rw [hτC, h1]
  · rw [RingHom.comp_apply, hτX0]; exact C3
  · rw [RingHom.comp_apply, hτX1]; exact C2

  intro h hh
  have hne : h ≠ 0 := by
    rintro rfl; exact hh (Submodule.zero_mem _)
  have hS : Submonoid.powers h ≤ nonZeroDivisors B :=
    powers_le_nonZeroDivisors_of_noZeroDivisors hne
  have hdom : IsDomain (Localization.Away h) := IsLocalization.isDomain_localization hS
  have hinj : Function.Injective (algebraMap B (Localization.Away h)) :=
    IsLocalization.injective (M := Submonoid.powers h) (Localization.Away h) hS
  have hdisj : Disjoint (Submonoid.powers h : Set B) (𝔮 : Set B) :=
    (Ideal.disjoint_powers_iff_notMem h P4.isPrime.isRadical).mpr hh
  have hb3 : (𝔮.map (algebraMap B (Localization.Away h))).comap
      (algebraMap B (Localization.Away h)) = 𝔮 :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers h) (Localization.Away h)
      P4.isPrime hdisj
  have hWB' : algebraMap ↥W (Localization.Away h) =
      (algebraMap B (Localization.Away h)).comp (algebraMap ↥W B) :=
    IsScalarTower.algebraMap_eq _ _ _
  refine ⟨hdom, ?_, hb3⟩

  have P1' : Algebra.FiniteType ↥W (Localization.Away h) :=
    Algebra.FiniteType.trans P1 inferInstance
  have P2' : NoZeroSMulDivisors ↥W (Localization.Away h) := by
    refine ⟨fun {c x} hcx => ?_⟩
    rw [Algebra.smul_def, hWB', RingHom.comp_apply] at hcx
    rcases mul_eq_zero.mp hcx with h1 | h1
    · left
      have h2 : algebraMap ↥W B c = 0 := hinj (h1.trans (map_zero _).symm)
      have h3 : c • (1 : B) = 0 := by rw [Algebra.smul_def, mul_one]; exact h2
      exact (smul_eq_zero.mp h3).resolve_right one_ne_zero
    · right; exact h1
  have P3' : IsIntegrallyClosed (Localization.Away h) :=
    isIntegrallyClosed_of_isLocalization (Localization.Away h) (Submonoid.powers h) hS
  have P4' : (𝔮.map (algebraMap B (Localization.Away h))).IsMaximal := by
    haveI := P4
    exact IsLocalization.isMaximal_of_isMaximal_disjoint (Submonoid.powers h)
      (Localization.Away h) 𝔮 hdisj
  have P5' : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W (Localization.Away h)) ≤
      𝔮.map (algebraMap B (Localization.Away h)) := by
    rw [hWB', ← Ideal.map_map]
    exact Ideal.map_mono P5
  have P8' : algebraMap B (Localization.Away h) u * algebraMap B (Localization.Away h) v =
      algebraMap ↥W (Localization.Away h) g := by
    rw [← map_mul, P8, hWB', RingHom.comp_apply]
  have P9' : 𝔮.map (algebraMap B (Localization.Away h)) =
      Ideal.span {algebraMap B (Localization.Away h) u, algebraMap B (Localization.Away h) v} ⊔
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W (Localization.Away h)) := by
    conv_lhs => rw [P9]
    rw [Ideal.map_sup, Ideal.map_span, Set.image_pair, Ideal.map_map, ← hWB']

  have hkappa : ∃ κ : Localization.Away h₀ →+*
      Localization.Away (algebraMap B (Localization.Away h) h₀),
      κ.comp (algebraMap B (Localization.Away h₀)) =
        algebraMap B (Localization.Away (algebraMap B (Localization.Away h) h₀)) ∧ κ.Etale := by
    let T := Localization.Away (algebraMap B (Localization.Away h) h₀)
    have hunit : IsUnit (algebraMap B T h₀) := by
      rw [IsScalarTower.algebraMap_apply B (Localization.Away h) T]
      exact IsLocalization.Away.algebraMap_isUnit _
    let κ : Localization.Away h₀ →+* T := IsLocalization.Away.lift h₀ hunit
    have hκ : κ.comp (algebraMap B (Localization.Away h₀)) = algebraMap B T :=
      IsLocalization.Away.lift_comp h₀ hunit
    letI : Algebra (Localization.Away h₀) T := κ.toAlgebra
    haveI : IsScalarTower B (Localization.Away h₀) T := IsScalarTower.of_algebraMap_eq' hκ.symm
    haveI : IsLocalization.Away (h * h₀) T := inferInstance
    haveI : Algebra.Etale B T := Algebra.Etale.of_isLocalizationAway (h * h₀)
    haveI : Algebra.FormallyEtale (Localization.Away h₀) T :=
      Algebra.FormallyEtale.of_restrictScalars (R := B)
    haveI : Algebra.FinitePresentation (Localization.Away h₀) T :=
      Algebra.FinitePresentation.of_restrict_scalars_finitePresentation B _ T
    have hEt : Algebra.Etale (Localization.Away h₀) T :=
      Algebra.Etale.mk inferInstance inferInstance
    exact ⟨κ, hκ, RingHom.etale_algebraMap.mpr hEt⟩
  obtain ⟨κ, hκ, hκet⟩ := hkappa
  have hh' : algebraMap B (Localization.Away h) h₀ ∉
      𝔮.map (algebraMap B (Localization.Away h)) := by
    intro hm
    have := Ideal.mem_comap.mpr hm
    rw [hb3] at this
    exact hh₀ this
  have hcomp := @RingHom.Etale.stableUnderComposition (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (Localization.Away h₀)
      (Localization.Away (algebraMap B (Localization.Away h) h₀)) _ _ _ f κ C4 hκet
  have hT : algebraMap B (Localization.Away (algebraMap B (Localization.Away h) h₀)) =
      (algebraMap (Localization.Away h)
        (Localization.Away (algebraMap B (Localization.Away h) h₀))).comp
        (algebraMap B (Localization.Away h)) := IsScalarTower.algebraMap_eq _ _ _
  refine ⟨P1', P2', P3', P4', P5', P6, P7, P8', P9', algebraMap B (Localization.Away h) h₀, hh',
    κ.comp f, ?_, ?_, ?_, hcomp⟩
  · apply RingHom.ext; intro a
    have h1 := RingHom.congr_fun C1 a
    have h2 := RingHom.congr_fun hκ (algebraMap ↥W B a)
    have h3 := RingHom.congr_fun hT (algebraMap ↥W B a)
    simp only [RingHom.comp_apply] at h1 h2 h3 ⊢
    rw [h1, h2, h3, hWB', RingHom.comp_apply]
  · have h2 := RingHom.congr_fun hκ u
    have h3 := RingHom.congr_fun hT u
    simp only [RingHom.comp_apply] at h2 h3 ⊢
    rw [C2, h2, h3]
  · have h2 := RingHom.congr_fun hκ v
    have h3 := RingHom.congr_fun hT v
    simp only [RingHom.comp_apply] at h2 h3 ⊢
    rw [C3, h2, h3]

theorem wcpa_dj_llsm_neat_top_field : ∀ (K M L : Type u) [Field K] [Field M] [Field L]
    [Algebra K M] [Algebra M L] [Algebra K L] [IsScalarTower K M L] [FiniteDimensional K L]
    [IsGalois K L] (M' : Type u) [Field M'] [Algebra M M'],
    ∃ (L' : Type u) (_ : Field L') (_ : Algebra M' L') (lam : L →+* L')
      (ρ : (L' ≃ₐ[M'] L') →* (L ≃ₐ[M] L)),
      lam.comp (algebraMap M L) = (algebraMap M' L').comp (algebraMap M M') ∧
      FiniteDimensional M' L' ∧ IsGalois M' L' ∧ Function.Injective ρ ∧
      Algebra.adjoin M' (Set.range lam) = ⊤ :=
by
  intro K M L _ _ _ _ _ _ _ _ _ M' _ _
  classical
  haveI hFD : FiniteDimensional M L := Module.Finite.of_restrictScalars_finite K M L
  haveI hGal : IsGalois M L := IsGalois.tower_top_of_isGalois K M L
  haveI hNorm : Normal M L := IsGalois.to_normal
  obtain ⟨p, hp, hpsplit⟩ := IsGalois.is_separable_splitting_field M L
  haveI := hpsplit
  set g : Polynomial M' := p.map (algebraMap M M') with hgdef
  have hg : g.Separable := hp.map
  haveI hGal' : IsGalois M' g.SplittingField := IsGalois.of_separable_splitting_field hg
  have h4 : (p.map (algebraMap M g.SplittingField)).Splits := by
    rw [IsScalarTower.algebraMap_eq M M' g.SplittingField, ← Polynomial.map_map]
    exact Polynomial.SplittingField.splits g
  set φ : L →ₐ[M] g.SplittingField := Polynomial.IsSplittingField.lift L p h4 with hφ
  have h6 : (φ : L →+* g.SplittingField).comp (algebraMap M L) =
      (algebraMap M' g.SplittingField).comp (algebraMap M M') := by
    ext x
    simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.coe_toRingHom, AlgHom.commutes]
    exact IsScalarTower.algebraMap_apply M M' g.SplittingField x
  have hr : g.rootSet g.SplittingField = p.rootSet g.SplittingField := by
    show (p.map (algebraMap M M')).rootSet g.SplittingField = p.rootSet g.SplittingField
    exact Polynomial.rootSet_map ..
  have h7 : Algebra.adjoin M' (Set.range (φ : L →+* g.SplittingField)) = ⊤ := by
    apply top_unique
    rw [← Polynomial.IsSplittingField.adjoin_rootSet g.SplittingField g]
    apply Algebra.adjoin_mono
    rw [hr, ← Polynomial.Splits.image_rootSet (Polynomial.IsSplittingField.splits L p) φ]
    intro y hy
    obtain ⟨x, _, rfl⟩ := hy
    exact ⟨x, rfl⟩
  letI : Algebra L g.SplittingField := (φ : L →+* g.SplittingField).toAlgebra
  haveI : IsScalarTower M L g.SplittingField :=
    IsScalarTower.of_algebraMap_eq (fun x => (φ.commutes x).symm)
  refine ⟨g.SplittingField, inferInstance, inferInstance, (φ : L →+* g.SplittingField),
    (AlgEquiv.restrictNormalHom L).comp (AlgEquiv.restrictScalarsHom M), h6, inferInstance,
    hGal', ?_, h7⟩
  rw [injective_iff_map_eq_one]
  intro σ hσ
  have hfix : ∀ x : L, σ (φ x) = φ x := by
    intro x
    have h1 := AlgEquiv.restrictNormal_commutes (σ.restrictScalars M) L x
    have h2 : (σ.restrictScalars M).restrictNormal L = 1 := hσ
    rw [h2, AlgEquiv.one_apply, AlgEquiv.restrictScalars_apply] at h1
    exact h1.symm
  have hext : (σ : g.SplittingField →ₐ[M'] g.SplittingField) = AlgHom.id M' g.SplittingField := by
    apply AlgHom.ext_of_adjoin_eq_top h7
    rintro _ ⟨x, rfl⟩
    exact hfix x
  ext y
  exact congrArg (fun f => f y) hext

theorem wcpa_dj_llsm_nrt_te_intcl_etale : ∀ (R R' : Type u) [CommRing R] [CommRing R'] (j : R →+* R'), j.Etale → ∀ (L L' F' : Type u) [Field L] [Field L'] [Field F'] [Algebra R L] [Algebra R' L'] [Algebra R' F'] [IsFractionRing R' F'] [Algebra F' L'] [IsScalarTower R' F' L'] (lam : L →+* L'), lam.comp (algebraMap R L) = (algebraMap R' L').comp j → Algebra.adjoin F' (Set.range lam) = ⊤ → ∃ τ : ↥(integralClosure R L) →+* ↥(integralClosure R' L'), τ.Etale ∧ ∀ y : ↥(integralClosure R L), (τ y : L') = lam (y : L) :=
by
  classical

  have s1 : ∀ (L E L' : Type u) [Field L] [CommRing E] [Field L'] (θ : L →+* E), θ.Etale →
      ∀ (π : E →+* L'), ∃ ε : E, IsIdempotentElem ε ∧ RingHom.ker π = Ideal.span {1 - ε} ∧
        ∀ t : E, π t ≠ 0 → ∃ t' : E, π t * π t' = 1 := by
    intro L E L' _ _ _ θ hθ π
    letI := θ.toAlgebra
    haveI : Algebra.Etale L E := RingHom.Etale.toAlgebra hθ
    obtain ⟨I, hI, A, hA1, hA2, e, -⟩ := (Algebra.Etale.iff_exists_algEquiv_prod L E).mp inferInstance
    haveI := Fintype.ofFinite I
    let ρ : ((i : I) → A i) →+* L' := π.comp (e.symm : ((i : I) → A i) →+* E)
    let δ : I → ((i : I) → A i) := fun i => Pi.single i 1
    have hsum : ∑ i, δ i = 1 := Finset.univ_sum_single (fun i => (1 : A i))
    have hρsum : ∑ i, ρ (δ i) = 1 := by rw [← map_sum, hsum, map_one]
    obtain ⟨i₀, -, hi₀⟩ : ∃ i ∈ Finset.univ, ρ (δ i) ≠ 0 :=
      Finset.exists_ne_zero_of_sum_ne_zero (by rw [hρsum]; exact one_ne_zero)
    have hδidem : δ i₀ * δ i₀ = δ i₀ := by simp only [δ, ← Pi.single_mul, mul_one]
    have hρδ : ρ (δ i₀) = 1 := by
      have h : ρ (δ i₀) * (ρ (δ i₀) - 1) = 0 := by
        rw [mul_sub, ← map_mul, hδidem, mul_one, sub_self]
      exact sub_eq_zero.mp ((mul_eq_zero.mp h).resolve_left hi₀)
    have hρe : ∀ t : E, ρ (e t) = π t := fun t => by
      show π (e.symm (e t)) = π t
      rw [AlgEquiv.symm_apply_apply]
    have key1 : ∀ u : (i : I) → A i, u i₀ ≠ 0 → ρ u * ρ (Pi.single i₀ (u i₀)⁻¹) = 1 := by
      intro u hu
      have hm : u * Pi.single i₀ (u i₀)⁻¹ = δ i₀ := by
        funext i
        by_cases h : i = i₀
        · subst h; simp [δ, hu]
        · simp [δ, h]
      rw [← map_mul, hm, hρδ]
    have key0 : ∀ u : (i : I) → A i, u i₀ = 0 → u * (1 - δ i₀) = u := by
      intro u hu
      funext i
      by_cases h : i = i₀
      · subst h; simp [δ, hu]
      · simp [δ, h]
    have hπε : π (e.symm (δ i₀)) = 1 := hρδ
    have hz : ∀ t : E, (e t) i₀ = 0 → t * (1 - e.symm (δ i₀)) = t := by
      intro t hu
      apply e.injective
      rw [map_mul, map_sub, map_one, AlgEquiv.apply_symm_apply]
      exact key0 (e t) hu
    have hz' : ∀ t : E, (e t) i₀ = 0 → π t = 0 := by
      intro t hu
      rw [← hz t hu, map_mul, map_sub, map_one, hπε, sub_self, mul_zero]
    refine ⟨e.symm (δ i₀), ?_, ?_, ?_⟩
    · show e.symm (δ i₀) * e.symm (δ i₀) = e.symm (δ i₀)
      rw [← map_mul, hδidem]
    · ext t
      rw [RingHom.mem_ker, Ideal.mem_span_singleton']
      constructor
      · intro ht
        refine ⟨t, hz t ?_⟩
        by_contra hne
        have h1 := key1 (e t) hne
        rw [hρe, ht, zero_mul] at h1
        exact zero_ne_one h1
      · rintro ⟨a, rfl⟩
        rw [map_mul, map_sub, map_one, hπε, sub_self, mul_zero]
    · intro t ht
      have hu : (e t) i₀ ≠ 0 := fun h0 => ht (hz' t h0)
      refine ⟨e.symm (Pi.single i₀ ((e t) i₀)⁻¹), ?_⟩
      have h1 := key1 (e t) hu
      rw [hρe] at h1
      exact h1

  have s2 : ∀ (R' E L' : Type u) [CommRing R'] [CommRing E] [CommRing L'] [Algebra R' E]
      [Algebra R' L'] (π : E →ₐ[R'] L'), Function.Surjective π → ∀ ε : E, IsIdempotentElem ε →
      RingHom.ker π = Ideal.span {1 - ε} →
      ∃ πb : ↥(integralClosure R' E) →+* ↥(integralClosure R' L'), πb.Etale ∧
        ∀ t : ↥(integralClosure R' E), (πb t : L') = π (t : E) := by
    intro R' E L' _ _ _ _ _ π hπ ε hε hker
    let πb : ↥(integralClosure R' E) →+* ↥(integralClosure R' L') :=
      ((π.comp (integralClosure R' E).val).codRestrict (integralClosure R' L')
        (fun t => _root_.IsIntegral.map π t.2)).toRingHom
    have hπb : ∀ t, (πb t : L') = π (t : E) := fun t => rfl
    have hπε : π ε = 1 := by
      have h1 : (1 - ε) ∈ RingHom.ker π := by rw [hker]; exact Ideal.subset_span rfl
      rw [RingHom.mem_ker, map_sub, map_one, sub_eq_zero] at h1
      exact h1.symm
    have hεint : _root_.IsIntegral R' ε := by
      refine ⟨Polynomial.X * (Polynomial.X - Polynomial.C 1),
        Polynomial.monic_X.mul (Polynomial.monic_X_sub_C 1), ?_⟩
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_X, Polynomial.eval₂_sub, Polynomial.eval₂_X,
        Polynomial.eval₂_C, map_one, mul_sub, mul_one, hε.eq, sub_self]
    let εb : ↥(integralClosure R' E) := ⟨ε, hεint⟩
    have hεb : IsIdempotentElem εb := Subtype.ext hε.eq
    have hkerE : ∀ t : E, π t = 0 → t * (1 - ε) = t := by
      intro t ht
      have : t ∈ Ideal.span {1 - ε} := by rw [← hker]; exact ht
      obtain ⟨w, rfl⟩ := Ideal.mem_span_singleton'.mp this
      rw [mul_assoc, hε.one_sub.eq]
    have hsurj : Function.Surjective πb := by
      rintro ⟨y, hy⟩
      obtain ⟨p, hp, hpy⟩ := hy
      obtain ⟨t, rfl⟩ := hπ y
      have hεt : π (ε * t) = π t := by rw [map_mul, hπε, one_mul]
      have h0 : π (Polynomial.aeval (ε * t) p) = 0 := by
        rw [← Polynomial.aeval_algHom_apply, hεt, Polynomial.aeval_def]; exact hpy
      have h1 : ε * Polynomial.aeval (ε * t) p = 0 := by
        have h2 := hkerE _ h0
        calc ε * Polynomial.aeval (ε * t) p
            = ε * (Polynomial.aeval (ε * t) p * (1 - ε)) := by rw [h2]
          _ = Polynomial.aeval (ε * t) p * (ε - ε * ε) := by ring
          _ = 0 := by rw [hε.eq, sub_self, mul_zero]
      have hint : _root_.IsIntegral R' (ε * t) := by
        refine ⟨Polynomial.X * p, Polynomial.monic_X.mul hp, ?_⟩
        rw [← Polynomial.aeval_def, map_mul, Polynomial.aeval_X]
        calc ε * t * Polynomial.aeval (ε * t) p = t * (ε * Polynomial.aeval (ε * t) p) := by ring
          _ = 0 := by rw [h1, mul_zero]
      exact ⟨⟨ε * t, hint⟩, Subtype.ext hεt⟩
    have hkerb : RingHom.ker πb = Ideal.span {1 - εb} := by
      ext t
      rw [RingHom.mem_ker, Ideal.mem_span_singleton']
      constructor
      · intro ht
        refine ⟨t, Subtype.ext ?_⟩
        have h3 : π (t : E) = 0 := congrArg Subtype.val ht
        exact hkerE _ h3
      · rintro ⟨a, rfl⟩
        apply Subtype.ext
        show π ((a : E) * (1 - ε)) = 0
        rw [map_mul, map_sub, map_one, hπε, sub_self, mul_zero]
    letI := πb.toAlgebra
    haveI : IsLocalization.Away εb (integralClosure R' L') :=
      IsLocalization.away_of_isIdempotentElem hεb hkerb hsurj
    haveI : Algebra.Etale (integralClosure R' E) (integralClosure R' L') :=
      Algebra.Etale.of_isLocalizationAway εb
    exact ⟨πb, RingHom.etale_algebraMap.mpr this, hπb⟩

  have s3 : ∀ (R' E L' F' : Type u) [CommRing R'] [CommRing E] [Field L'] [Field F'] [Algebra R' E]
      [Algebra R' L'] [Algebra R' F'] [IsFractionRing R' F'] [Algebra F' L'] [IsScalarTower R' F' L']
      (π : E →ₐ[R'] L') (S : Set L'), S ⊆ Set.range π → Algebra.adjoin F' S = ⊤ →
      (∀ t : E, π t ≠ 0 → ∃ t' : E, π t * π t' = 1) → Function.Surjective π := by
    intro R' E L' F' _ _ _ _ _ _ _ _ _ _ π S hS hadj hinv
    haveI : Nontrivial R' := RingHom.domain_nontrivial (algebraMap R' F')
    have hF : ∀ f : F', algebraMap F' L' f ∈ Set.range π := by
      intro f
      obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective R' f
      have hb0 : algebraMap R' F' b ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hb
      have hβ : algebraMap R' L' b ≠ 0 := by
        rw [IsScalarTower.algebraMap_apply R' F' L']; exact (map_ne_zero _).mpr hb0
      obtain ⟨t', ht'⟩ := hinv (algebraMap R' E b) (by rw [AlgHom.commutes]; exact hβ)
      rw [AlgHom.commutes] at ht'
      refine ⟨algebraMap R' E a * t', ?_⟩
      rw [map_mul, AlgHom.commutes, map_div₀, ← IsScalarTower.algebraMap_apply R' F' L',
        ← IsScalarTower.algebraMap_apply R' F' L', eq_inv_of_mul_eq_one_right ht', div_eq_mul_inv]
    have hmem : ∀ x : L', x ∈ Algebra.adjoin F' S → x ∈ Set.range π := by
      intro x hx
      induction hx using Algebra.adjoin_induction with
      | mem x hx => exact hS hx
      | algebraMap r => exact hF r
      | add x y _ _ hx hy =>
        obtain ⟨a, rfl⟩ := hx
        obtain ⟨b, rfl⟩ := hy
        exact ⟨a + b, map_add _ _ _⟩
      | mul x y _ _ hx hy =>
        obtain ⟨a, rfl⟩ := hx
        obtain ⟨b, rfl⟩ := hy
        exact ⟨a * b, map_mul _ _ _⟩
    intro x
    have hx : x ∈ Algebra.adjoin F' S := by rw [hadj]; exact Algebra.mem_top
    exact hmem x hx

  have s4 : ∀ (R R' L : Type u) [CommRing R] [CommRing R'] [CommRing L] [Algebra R R'] [Algebra R L]
      [Algebra.Etale R R'], ∃ β : ↥(integralClosure R L) →+* ↥(integralClosure R' (TensorProduct R R' L)),
      β.Etale ∧ ∀ y : ↥(integralClosure R L), (β y : TensorProduct R R' L) = TensorProduct.tmul R (1 : R') (y : L) := by
    intro R R' L _ _ _ _ _ _
    have h1 : (algebraMap (integralClosure R L) (TensorProduct R (integralClosure R L) R')).Etale :=
      RingHom.etale_algebraMap.mpr (Algebra.Etale.baseChange R R' (integralClosure R L))
    have h2 : ((Algebra.TensorProduct.comm R (integralClosure R L) R' :
        TensorProduct R (integralClosure R L) R' →+* TensorProduct R R' (integralClosure R L))).Etale :=
      RingHom.Etale.of_bijective (Algebra.TensorProduct.comm R (integralClosure R L) R').bijective
    have h3 : ((TensorProduct.toIntegralClosure R R' L :
        TensorProduct R R' (integralClosure R L) →+* integralClosure R' (TensorProduct R R' L))).Etale :=
      RingHom.Etale.of_bijective TensorProduct.toIntegralClosure_bijective_of_smooth
    refine ⟨((TensorProduct.toIntegralClosure R R' L :
        TensorProduct R R' (integralClosure R L) →+* integralClosure R' (TensorProduct R R' L))).comp
        (((Algebra.TensorProduct.comm R (integralClosure R L) R' :
        TensorProduct R (integralClosure R L) R' →+* TensorProduct R R' (integralClosure R L))).comp
        (algebraMap (integralClosure R L) (TensorProduct R (integralClosure R L) R'))),
      RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.stableUnderComposition _ _ h1 h2) h3, ?_⟩
    intro y
    simp [Algebra.TensorProduct.algebraMap_apply, TensorProduct.toIntegralClosure]

  intro R R' _ _ j hj L L' F' _ _ _ _ _ _ _ _ _ lam hcomp hadj
  letI : Algebra R R' := j.toAlgebra
  haveI : Algebra.Etale R R' := RingHom.Etale.toAlgebra hj
  letI : Algebra R L' := ((algebraMap R' L').comp j).toAlgebra
  haveI : IsScalarTower R R' L' := IsScalarTower.of_algebraMap_eq' rfl
  let lamR : L →ₐ[R] L' := { lam with commutes' := fun r => RingHom.congr_fun hcomp r }
  let π : TensorProduct R R' L →ₐ[R'] L' :=
    Algebra.TensorProduct.lift (Algebra.ofId R' L') lamR (fun _ _ => Commute.all _ _)
  have hπ1 : ∀ x : L, π (TensorProduct.tmul R (1 : R') x) = lam x := by
    intro x
    rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
    rfl
  let θ : L →+* TensorProduct R R' L :=
    (Algebra.TensorProduct.comm R L R' : TensorProduct R L R' →+* TensorProduct R R' L).comp
      (algebraMap L (TensorProduct R L R'))
  have hθ : θ.Etale :=
    RingHom.Etale.stableUnderComposition _ _
      (RingHom.etale_algebraMap.mpr (Algebra.Etale.baseChange R R' L))
      (RingHom.Etale.of_bijective (Algebra.TensorProduct.comm R L R').bijective)
  obtain ⟨ε, hε, hker, hinv⟩ := s1 L (TensorProduct R R' L) L' θ hθ (π : TensorProduct R R' L →+* L')
  have hsurj : Function.Surjective π :=
    s3 R' (TensorProduct R R' L) L' F' π (Set.range lam)
      (by rintro _ ⟨x, rfl⟩; exact ⟨_, hπ1 x⟩) hadj hinv
  obtain ⟨πb, hπb, hπbv⟩ := s2 R' (TensorProduct R R' L) L' π hsurj ε hε hker
  obtain ⟨β, hβ, hβv⟩ := s4 R R' L
  refine ⟨πb.comp β, RingHom.Etale.stableUnderComposition _ _ hβ hπb, fun y => ?_⟩
  rw [RingHom.comp_apply, hπbv, hβv, hπ1]

theorem wcpa_dj_llsm_nrt_te_adjoin_etale : ∀ (C : Type u) [CommRing C] [IsDomain C] (B : Type u) [CommRing B] [IsDomain B] (ι : C →+* B), ι.Etale → Function.Injective ι → ∀ (M M' : Type u) [Field M] [Field M'] [Algebra C M] [IsFractionRing C M] [Algebra B M'] [IsFractionRing B M'] [Algebra M M'], (∀ c : C, algebraMap M M' (algebraMap C M c) = algebraMap B M' (ι c)) → ∀ x : M, ∃ φ : ↥(Algebra.adjoin C {x}) →+* ↥(Algebra.adjoin B {algebraMap M M' x}), φ.Etale ∧ ∀ y : ↥(Algebra.adjoin C {x}), (φ y : M') = algebraMap M M' (y : M) :=
by
  intro C _ _ B _ _ ι hι _ M M' _ _ _ _ _ _ _ hc x
  classical
  letI : Algebra C B := ι.toAlgebra
  haveI : Algebra.Etale C B := hι.toAlgebra
  haveI : Module.Flat C B := inferInstance

  have s1 : ∀ w : TensorProduct C M B, ∃ c : C, c ≠ 0 ∧ ∃ b : B,
      w = (algebraMap C M c)⁻¹ ⊗ₜ[C] b := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => exact ⟨1, one_ne_zero, 0, by rw [TensorProduct.tmul_zero]⟩
    | tmul m b =>
      obtain ⟨a, d, hd, rfl⟩ := IsFractionRing.div_surjective (A := C) m
      have hd0 : d ≠ 0 := nonZeroDivisors.ne_zero hd
      refine ⟨d, hd0, a • b, ?_⟩
      rw [← TensorProduct.smul_tmul, Algebra.smul_def, div_eq_mul_inv]
    | add w₁ w₂ h₁ h₂ =>
      obtain ⟨c₁, hc₁, b₁, rfl⟩ := h₁
      obtain ⟨c₂, hc₂, b₂, rfl⟩ := h₂
      have hc₁' : algebraMap C M c₁ ≠ 0 :=
        (map_ne_zero_iff _ (IsFractionRing.injective C M)).mpr hc₁
      have hc₂' : algebraMap C M c₂ ≠ 0 :=
        (map_ne_zero_iff _ (IsFractionRing.injective C M)).mpr hc₂
      have e1 : (algebraMap C M c₁)⁻¹ = c₂ • (algebraMap C M (c₁ * c₂))⁻¹ := by
        rw [Algebra.smul_def, map_mul]; field_simp
      have e2 : (algebraMap C M c₂)⁻¹ = c₁ • (algebraMap C M (c₁ * c₂))⁻¹ := by
        rw [Algebra.smul_def, map_mul]; field_simp
      refine ⟨c₁ * c₂, mul_ne_zero hc₁ hc₂, c₂ • b₁ + c₁ • b₂, ?_⟩
      rw [TensorProduct.tmul_add, ← TensorProduct.smul_tmul, ← TensorProduct.smul_tmul, ← e1, ← e2]

  have s2 : ∀ (R : Subalgebra C M) (Ψ : TensorProduct C R B →+ M'),
      (∀ (y : R) (b : B), Ψ (y ⊗ₜ[C] b) = algebraMap M M' (y : M) * algebraMap B M' b) →
      Function.Injective Ψ := by
    intro R Ψ hΨ
    letI : Algebra C M' := ((algebraMap B M').comp ι).toAlgebra
    haveI : IsScalarTower C B M' := IsScalarTower.of_algebraMap_eq' rfl
    let νC : M →ₐ[C] M' := { algebraMap M M' with commutes' := fun c => hc c }
    let gC : B →ₐ[C] M' := IsScalarTower.toAlgHom C B M'
    let Θ : TensorProduct C M B →ₐ[C] M' := Algebra.TensorProduct.productMap νC gC
    have hΘ : Function.Injective Θ := by
      refine (injective_iff_map_eq_zero Θ).mpr ?_
      intro w hw
      obtain ⟨c, hc0, b, rfl⟩ := s1 w
      rw [Algebra.TensorProduct.productMap_apply_tmul] at hw
      have hc' : algebraMap C M c ≠ 0 :=
        (map_ne_zero_iff _ (IsFractionRing.injective C M)).mpr hc0
      have hν : νC (algebraMap C M c)⁻¹ ≠ 0 := (map_ne_zero νC).mpr (inv_ne_zero hc')
      have hb : gC b = 0 := (mul_eq_zero.mp hw).resolve_left hν
      have hb' : b = 0 := by
        apply IsFractionRing.injective B M'
        rw [map_zero]
        exact hb
      rw [hb', TensorProduct.tmul_zero]
    let j : TensorProduct C R B →ₗ[C] TensorProduct C M B := LinearMap.rTensor B R.val.toLinearMap
    have hj : Function.Injective j :=
      Module.Flat.rTensor_preserves_injective_linearMap _ Subtype.val_injective
    have key : ∀ w, Ψ w = Θ (j w) := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => rw [map_zero, map_zero, map_zero]
      | tmul y b =>
        rw [hΨ, LinearMap.rTensor_tmul, Algebra.TensorProduct.productMap_apply_tmul]
        rfl
      | add w₁ w₂ h₁ h₂ => rw [map_add, map_add, map_add, h₁, h₂]
    intro w₁ w₂ h
    apply hj
    apply hΘ
    rw [← key, ← key, h]

  letI : Algebra C ↥(Algebra.adjoin B {algebraMap M M' x}) :=
    ((algebraMap B ↥(Algebra.adjoin B {algebraMap M M' x})).comp ι).toAlgebra
  haveI : IsScalarTower C B ↥(Algebra.adjoin B {algebraMap M M' x}) :=
    IsScalarTower.of_algebraMap_eq' rfl
  have hmem : ∀ y ∈ Algebra.adjoin C {x},
      algebraMap M M' y ∈ Algebra.adjoin B {algebraMap M M' x} := by
    intro y hy
    induction hy using Algebra.adjoin_induction with
    | mem y hy => rw [Set.mem_singleton_iff.mp hy]; exact Algebra.subset_adjoin rfl
    | algebraMap c => rw [hc]; exact Subalgebra.algebraMap_mem _ _
    | add y z _ _ hy hz => rw [map_add]; exact add_mem hy hz
    | mul y z _ _ hy hz => rw [map_mul]; exact mul_mem hy hz
  let f : ↥(Algebra.adjoin C {x}) →ₐ[C] ↥(Algebra.adjoin B {algebraMap M M' x}) :=
    { toFun := fun y => ⟨algebraMap M M' y, hmem y y.2⟩
      map_one' := Subtype.ext (map_one (algebraMap M M'))
      map_mul' := fun a b => Subtype.ext (map_mul (algebraMap M M') (a : M) (b : M))
      map_zero' := Subtype.ext (map_zero (algebraMap M M'))
      map_add' := fun a b => Subtype.ext (map_add (algebraMap M M') (a : M) (b : M))
      commutes' := fun c => Subtype.ext (hc c) }
  let g : B →ₐ[C] ↥(Algebra.adjoin B {algebraMap M M' x}) :=
    IsScalarTower.toAlgHom C B ↥(Algebra.adjoin B {algebraMap M M' x})
  let Φ : TensorProduct C ↥(Algebra.adjoin C {x}) B →ₐ[C]
      ↥(Algebra.adjoin B {algebraMap M M' x}) := Algebra.TensorProduct.productMap f g
  have hinj : Function.Injective Φ := by
    have h := s2 (Algebra.adjoin C {x})
      (((Algebra.adjoin B {algebraMap M M' x}).val.toRingHom.comp Φ.toRingHom).toAddMonoidHom)
      (fun y b => by
        show ((Φ (y ⊗ₜ[C] b) : ↥(Algebra.adjoin B {algebraMap M M' x})) : M') = _
        rw [Algebra.TensorProduct.productMap_apply_tmul]
        rfl)
    intro a b hab
    apply h
    show ((Φ a : ↥(Algebra.adjoin B {algebraMap M M' x})) : M') = Φ b
    rw [hab]
  have hsurj : Function.Surjective Φ := by
    rintro ⟨z, hz⟩
    induction hz using Algebra.adjoin_induction with
    | mem v hv =>
      refine ⟨(⟨x, Algebra.subset_adjoin rfl⟩ : ↥(Algebra.adjoin C {x})) ⊗ₜ[C] (1 : B), ?_⟩
      rw [Algebra.TensorProduct.productMap_left_apply]
      apply Subtype.ext
      exact (Set.mem_singleton_iff.mp hv).symm
    | algebraMap b =>
      refine ⟨(1 : ↥(Algebra.adjoin C {x})) ⊗ₜ[C] b, ?_⟩
      rw [Algebra.TensorProduct.productMap_right_apply]
      rfl
    | add v w _ _ hv hw =>
      obtain ⟨p, hp⟩ := hv
      obtain ⟨q, hq⟩ := hw
      exact ⟨p + q, by rw [map_add, hp, hq]; rfl⟩
    | mul v w _ _ hv hw =>
      obtain ⟨p, hp⟩ := hv
      obtain ⟨q, hq⟩ := hw
      exact ⟨p * q, by rw [map_mul, hp, hq]; rfl⟩
  haveI : Algebra.Etale ↥(Algebra.adjoin C {x}) (TensorProduct C ↥(Algebra.adjoin C {x}) B) :=
    Algebra.Etale.baseChange C B ↥(Algebra.adjoin C {x})
  have h₁ : (algebraMap ↥(Algebra.adjoin C {x})
      (TensorProduct C ↥(Algebra.adjoin C {x}) B)).Etale :=
    RingHom.etale_algebraMap.mpr inferInstance
  have h₂ : Φ.toRingHom.Etale := RingHom.Etale.of_bijective ⟨hinj, hsurj⟩
  refine ⟨Φ.toRingHom.comp (algebraMap ↥(Algebra.adjoin C {x})
      (TensorProduct C ↥(Algebra.adjoin C {x}) B)),
    RingHom.Etale.stableUnderComposition _ _ h₁ h₂, fun y => ?_⟩
  show ((Φ (algebraMap ↥(Algebra.adjoin C {x}) (TensorProduct C ↥(Algebra.adjoin C {x}) B) y)
    : ↥(Algebra.adjoin B {algebraMap M M' x})) : M') = _
  rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self_apply,
    Algebra.TensorProduct.productMap_left_apply]
  rfl

theorem wcpa_dj_llsm_nrt_tau_etale : ∀ (A : Type u) [CommRing A] [IsDomain A] (K : Type u) [Field K]
    [Algebra A K] [IsFractionRing A K] (M L : Type u) [Field M] [Field L] [Algebra K M] [Algebra M L]
    [Algebra K L] [IsScalarTower K M L] [FiniteDimensional K L] [IsGalois K L] [FiniteDimensional K M]
    (s : K) (B : Type u) [CommRing B] [IsDomain B]
    (ι : ↥(integralClosure ↥(Algebra.adjoin A {s}) M) →+* B), ι.Etale → Function.Injective ι →
    ∀ (M' : Type u) [Field M'] [Algebra B M'] [IsFractionRing B M'] [Algebra M M'],
    (∀ c : ↥(integralClosure ↥(Algebra.adjoin A {s}) M),
      algebraMap M M' (c : M) = algebraMap B M' (ι c)) →
    ∀ (L' : Type u) [Field L'] [Algebra M' L'] [FiniteDimensional M' L'] [IsGalois M' L']
      (lam : L →+* L'),
    lam.comp (algebraMap M L) = (algebraMap M' L').comp (algebraMap M M') →
    Algebra.adjoin M' (Set.range lam) = ⊤ →
    ∀ (sb : K) (s' : M') (c : A) (η η' : B) (e : ℕ), 0 < e →
    s = algebraMap A K c * sb →
    s' ^ e = algebraMap B M' η * algebraMap M M' (algebraMap K M sb) →
    algebraMap M M' (algebraMap K M sb) = algebraMap B M' η' * s' ^ e →
    ∃ τ : ↥(integralClosure ↥(Algebra.adjoin A {sb}) L) →+*
        ↥(integralClosure ↥(Algebra.adjoin B {s'}) L'),
      τ.Etale ∧ ∀ y : ↥(integralClosure ↥(Algebra.adjoin A {sb}) L), (τ y : L') = lam (y : L) :=
by
  intro A _ _ K _ _ _ M L _ _ _ _ _ _ _ _ _ s B _ _ ι hιet hιinj M' _ _ _ _ hlift L' _ _ _ _ lam
    hlam hadj sb s' c η η' e he hs hs' hψ
  classical

  haveI hAsfr : IsFractionRing ↥(Algebra.adjoin A {s}) K :=
    Localization.subalgebra.instIsFractionRingSubtypeMemSubalgebra K _
  haveI hCfr : IsFractionRing ↥(integralClosure ↥(Algebra.adjoin A {s}) M) M :=
    integralClosure.isFractionRing_of_finite_extension K M

  obtain ⟨φ, hφet, hφ⟩ := wcpa_dj_llsm_nrt_te_adjoin_etale
    ↥(integralClosure ↥(Algebra.adjoin A {s}) M) B ι hιet hιinj M M' (fun c => hlift c)
    (algebraMap K M sb)
  have hcompat : lam.comp (algebraMap ↥(Algebra.adjoin ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
      {algebraMap K M sb}) L) =
      (algebraMap ↥(Algebra.adjoin B {algebraMap M M' (algebraMap K M sb)}) L').comp φ := by
    ext y
    have h1 := RingHom.congr_fun hlam (y : M)
    simp only [RingHom.comp_apply] at h1
    change lam (algebraMap M L (y : M)) = algebraMap M' L' ((φ y : M'))
    rw [hφ y]
    exact h1
  obtain ⟨τ₁, hτ₁et, hτ₁⟩ := wcpa_dj_llsm_nrt_te_intcl_etale
    ↥(Algebra.adjoin ↥(integralClosure ↥(Algebra.adjoin A {s}) M) {algebraMap K M sb})
    ↥(Algebra.adjoin B {algebraMap M M' (algebraMap K M sb)}) φ hφet L L' M' lam hcompat hadj

  have hmemCx : ∀ k : K, k ∈ Algebra.adjoin A {sb} →
      algebraMap K M k ∈ Algebra.adjoin ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
        {algebraMap K M sb} := by
    intro k hk
    induction hk using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff.mp hx]
      exact Algebra.subset_adjoin (Set.mem_singleton _)
    | algebraMap r =>
      have hmC : algebraMap K M (algebraMap A K r) ∈ integralClosure ↥(Algebra.adjoin A {s}) M :=
        Subalgebra.algebraMap_mem _ (algebraMap A ↥(Algebra.adjoin A {s}) r)
      exact Subalgebra.algebraMap_mem _ (⟨_, hmC⟩ : ↥(integralClosure ↥(Algebra.adjoin A {s}) M))
    | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
  let f₁ : ↥(Algebra.adjoin A {sb}) →+* ↥(Algebra.adjoin ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
      {algebraMap K M sb}) :=
    RingHom.codRestrict ((algebraMap K M).comp (Algebra.adjoin A {sb}).val.toRingHom) _
      (fun d => hmemCx d d.2)
  have hcompatA : (algebraMap ↥(Algebra.adjoin ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
      {algebraMap K M sb}) L).comp f₁ = algebraMap ↥(Algebra.adjoin A {sb}) L := by
    ext d
    show algebraMap M L (algebraMap K M (d : K)) = algebraMap K L (d : K)
    exact (IsScalarTower.algebraMap_apply K M L _).symm
  letI : Algebra ↥(Algebra.adjoin A {sb}) ↥(Algebra.adjoin ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
      {algebraMap K M sb}) := f₁.toAlgebra
  haveI : IsScalarTower ↥(Algebra.adjoin A {sb}) ↥(Algebra.adjoin ↥(integralClosure
      ↥(Algebra.adjoin A {s}) M) {algebraMap K M sb}) L :=
    IsScalarTower.of_algebraMap_eq' hcompatA.symm
  have hle : Algebra.adjoin A {s} ≤ Algebra.adjoin A {sb} := by
    apply Algebra.adjoin_le
    rw [Set.singleton_subset_iff, hs]
    exact mul_mem (Subalgebra.algebraMap_mem _ c) (Algebra.subset_adjoin (Set.mem_singleton _))
  haveI hCxint : Algebra.IsIntegral ↥(Algebra.adjoin A {sb}) ↥(Algebra.adjoin ↥(integralClosure
      ↥(Algebra.adjoin A {s}) M) {algebraMap K M sb}) := by
    have hM : ∀ x : M, x ∈ Algebra.adjoin ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
        {algebraMap K M sb} → IsIntegral ↥(Algebra.adjoin A {sb}) x := by
      intro x hx
      induction hx using Algebra.adjoin_induction with
      | mem x hx =>
        rw [Set.mem_singleton_iff.mp hx]
        exact isIntegral_algebraMap (x := (⟨sb, Algebra.subset_adjoin (Set.mem_singleton _)⟩ :
          ↥(Algebra.adjoin A {sb})))
      | algebraMap r =>
        have hint : IsIntegral ↥(Algebra.adjoin A {s}) (r : M) := r.2
        exact IsIntegral.map_of_comp_eq (Subalgebra.inclusion hle).toRingHom (RingHom.id M)
          (by ext r; rfl) hint
      | add x y _ _ hx hy => exact hx.add hy
      | mul x y _ _ hx hy => exact hx.mul hy
    let g : ↥(Algebra.adjoin ↥(integralClosure ↥(Algebra.adjoin A {s}) M) {algebraMap K M sb})
        →ₐ[↥(Algebra.adjoin A {sb})] M :=
      { (Algebra.adjoin ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
          {algebraMap K M sb}).val.toRingHom with
        commutes' := fun _ => rfl }
    refine ⟨fun y => ?_⟩
    exact (isIntegral_algHom_iff g Subtype.val_injective).mp (hM (y : M) y.2)
  let eS : ↥(integralClosure ↥(Algebra.adjoin A {sb}) L) ≃+*
      ↥(integralClosure ↥(Algebra.adjoin ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
        {algebraMap K M sb}) L) :=
    { toFun := fun y => ⟨y, IsIntegral.tower_top y.2⟩
      invFun := fun y => ⟨y, isIntegral_trans _ y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl }

  have hle' : Algebra.adjoin B {algebraMap M M' (algebraMap K M sb)} ≤ Algebra.adjoin B {s'} := by
    apply Algebra.adjoin_le
    rw [Set.singleton_subset_iff, hψ]
    exact mul_mem (Subalgebra.algebraMap_mem _ η')
      (pow_mem (Algebra.subset_adjoin (Set.mem_singleton _)) e)
  letI : Algebra ↥(Algebra.adjoin B {algebraMap M M' (algebraMap K M sb)}) ↥(Algebra.adjoin B {s'}) :=
    (Subalgebra.inclusion hle').toRingHom.toAlgebra
  haveI : IsScalarTower ↥(Algebra.adjoin B {algebraMap M M' (algebraMap K M sb)})
      ↥(Algebra.adjoin B {s'}) L' :=
    IsScalarTower.of_algebraMap_eq' (by ext; rfl)
  haveI hD'int : Algebra.IsIntegral ↥(Algebra.adjoin B {algebraMap M M' (algebraMap K M sb)})
      ↥(Algebra.adjoin B {s'}) := by
    have hM : ∀ x : M', x ∈ Algebra.adjoin B {s'} →
        IsIntegral ↥(Algebra.adjoin B {algebraMap M M' (algebraMap K M sb)}) x := by
      intro x hx
      induction hx using Algebra.adjoin_induction with
      | mem x hx =>
        rw [Set.mem_singleton_iff.mp hx]
        let a : ↥(Algebra.adjoin B {algebraMap M M' (algebraMap K M sb)}) :=
          ⟨algebraMap B M' η * algebraMap M M' (algebraMap K M sb),
            mul_mem (Subalgebra.algebraMap_mem _ η) (Algebra.subset_adjoin (Set.mem_singleton _))⟩
        refine ⟨Polynomial.X ^ e - Polynomial.C a, Polynomial.monic_X_pow_sub_C a he.ne', ?_⟩
        rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, sub_eq_zero]
        exact hs'
      | algebraMap r =>
        exact isIntegral_algebraMap (x := (algebraMap B
          ↥(Algebra.adjoin B {algebraMap M M' (algebraMap K M sb)}) r))
      | add x y _ _ hx hy => exact hx.add hy
      | mul x y _ _ hx hy => exact hx.mul hy
    let g : ↥(Algebra.adjoin B {s'})
        →ₐ[↥(Algebra.adjoin B {algebraMap M M' (algebraMap K M sb)})] M' :=
      { (Algebra.adjoin B {s'}).val.toRingHom with
        commutes' := fun _ => rfl }
    refine ⟨fun y => ?_⟩
    exact (isIntegral_algHom_iff g Subtype.val_injective).mp (hM (y : M') y.2)
  let eS' : ↥(integralClosure ↥(Algebra.adjoin B {algebraMap M M' (algebraMap K M sb)}) L') ≃+*
      ↥(integralClosure ↥(Algebra.adjoin B {s'}) L') :=
    { toFun := fun y => ⟨y, IsIntegral.tower_top y.2⟩
      invFun := fun y => ⟨y, isIntegral_trans _ y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl }

  have comp3 : ∀ {S T : Type u} {iS : CommRing S} {iT : CommRing T} {g : S →+* T}, g.Etale →
      ∀ {R U : Type u} [CommRing R] [CommRing U] (f : R ≃+* S) (h : T ≃+* U),
      ∃ τ : R →+* U, τ.Etale ∧ ∀ y, τ y = h (g (f y)) := by
    intro S T _ _ g hg R U _ _ f h
    have hf : f.toRingHom.Etale := RingHom.Etale.of_bijective f.bijective
    have hh : h.toRingHom.Etale := RingHom.Etale.of_bijective h.bijective
    exact ⟨h.toRingHom.comp (g.comp f.toRingHom), RingHom.Etale.stableUnderComposition _ _
      (RingHom.Etale.stableUnderComposition _ _ hf hg) hh, fun _ => rfl⟩
  obtain ⟨τ, hτet, hτv⟩ := comp3 hτ₁et eS eS'
  refine ⟨τ, hτet, fun y => ?_⟩
  rw [hτv]
  exact hτ₁ (eS y)

theorem wcpa_dj_llsm_nrt_hens_etale_transfer : ∀ (T T' : Type u) [CommRing T] [CommRing T']
    (τ : T →+* T'), τ.Etale → ∀ (Q' : Ideal T') [Q'.IsMaximal] (Q : Ideal T) [Q.IsPrime]
    (hQ : Q = Q'.comap τ), (∀ x' : T', ∃ x : T, τ x - x' ∈ Q') →
    ∀ (P : Type u) [CommRing P] (e' : Localization.AtPrime Q' →+* P),
    wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime Q')) P e' →
    wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) P
      (e'.comp (Localization.localRingHom Q Q' τ hQ)) :=
by
  intro T T' _ _ τ hτ Q' _ Q _ hQ hres P _ e' he'
  obtain ⟨H1, H2, H3⟩ := he'
  letI : Algebra T T' := τ.toAlgebra
  haveI : Algebra.Etale T T' := hτ
  have hOunit : ∀ y : Localization.AtPrime Q', IsUnit (e' y) ↔ IsUnit y := fun y => by
    rw [H2, IsLocalRing.notMem_maximalIdeal]
  have hℓ : ∀ t : T, Localization.localRingHom Q Q' τ hQ
      (algebraMap T (Localization.AtPrime Q) t) =
      algebraMap T' (Localization.AtPrime Q') (τ t) := fun t =>
    Localization.localRingHom_to_map Q Q' τ hQ t
  unfold wcNdIsHens
  refine ⟨H1, fun a => ?_, ?_⟩
  · rw [RingHom.comp_apply, hOunit, IsLocalRing.notMem_maximalIdeal]
    exact ⟨fun h => isUnit_of_map_unit _ _ h, fun h => h.map _⟩
  intro B _ hB g hg
  haveI := hB
  let g₀ : T →+* B := g.comp (algebraMap T (Localization.AtPrime Q))
  letI : Algebra T B := g₀.toAlgebra
  have F1 : ∀ x : T, IsUnit (g₀ x) ↔ x ∉ Q := by
    intro x
    show IsUnit (g (algebraMap T (Localization.AtPrime Q) x)) ↔ x ∉ Q
    rw [hg, IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q) Q]
  let gbar : T ⧸ Q →+* IsLocalRing.ResidueField B :=
    Ideal.Quotient.lift Q ((IsLocalRing.residue B).comp g₀) (fun a ha => by
      rw [RingHom.comp_apply, IsLocalRing.residue_eq_zero_iff, IsLocalRing.mem_maximalIdeal,
        mem_nonunits_iff]
      exact fun hu => (F1 a).mp hu ha)
  have hgbar : ∀ t : T, gbar (Ideal.Quotient.mk Q t) = IsLocalRing.residue B (g₀ t) :=
    fun t => Ideal.Quotient.lift_mk _ _ _
  have hgbar_inj : Function.Injective gbar := by
    rw [injective_iff_map_eq_zero]
    intro y hy
    obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [hgbar, IsLocalRing.residue_eq_zero_iff, IsLocalRing.mem_maximalIdeal,
      mem_nonunits_iff] at hy
    rw [Ideal.Quotient.eq_zero_iff_mem]
    by_contra hn
    exact hy ((F1 t).mpr hn)
  let ψbar : T ⧸ Q →+* T' ⧸ Q' := Ideal.quotientMap Q' τ (le_of_eq hQ)
  have hψbar_bij : Function.Bijective ψbar := by
    refine ⟨Ideal.quotientMap_injective' (le_of_eq hQ.symm), ?_⟩
    intro y
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨t, ht⟩ := hres x
    refine ⟨Ideal.Quotient.mk Q t, ?_⟩
    rw [Ideal.quotientMap_mk, Ideal.Quotient.eq]
    exact ht
  let eqv := RingEquiv.ofBijective ψbar hψbar_bij
  let σ : T' →+* IsLocalRing.ResidueField B :=
    gbar.comp (eqv.symm.toRingHom.comp (Ideal.Quotient.mk Q'))
  have hσψ : ∀ t : T, σ (τ t) = IsLocalRing.residue B (g₀ t) := by
    intro t
    show gbar (eqv.symm (Ideal.Quotient.mk Q' (τ t))) = _
    have h1 : eqv.symm (Ideal.Quotient.mk Q' (τ t)) = Ideal.Quotient.mk Q t := by
      rw [RingEquiv.symm_apply_eq]
      change Ideal.Quotient.mk Q' (τ t) = ψbar (Ideal.Quotient.mk Q t)
      rw [Ideal.quotientMap_mk]
    rw [h1, hgbar]
  have hσ0 : ∀ x : T', σ x = 0 ↔ x ∈ Q' := by
    intro x
    show gbar (eqv.symm (Ideal.Quotient.mk Q' x)) = 0 ↔ _
    rw [map_eq_zero_iff gbar hgbar_inj, map_eq_zero_iff _ eqv.symm.injective,
      Ideal.Quotient.eq_zero_iff_mem]
  have hσ : σ.comp (algebraMap T T') = (IsLocalRing.residue B).comp (algebraMap T B) :=
    RingHom.ext fun t => hσψ t
  obtain ⟨φ, hφ⟩ := wc_hnas_hs_etale_section_over_base T B
    (fun E'' _ _ _ σ'' => wc_hnas_smooth_section_henselian B E'' σ'') T' σ hσ
  have hunit : ∀ x : T', IsUnit (φ x) ↔ x ∉ Q' := by
    intro x
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hφ, Ne, hσ0]
  have hMq : ∀ y : Q'.primeCompl, IsUnit ((φ : T' →+* B) y) :=
    fun y => (hunit y).mpr (Ideal.mem_primeCompl_iff.mp y.2)
  let k : Localization.AtPrime Q' →+* B :=
    IsLocalization.lift (M := Q'.primeCompl) (S := Localization.AtPrime Q') hMq
  have hkE : ∀ x : T', k (algebraMap T' (Localization.AtPrime Q') x) = φ x :=
    fun x => IsLocalization.lift_eq hMq x
  have hkloc : ∀ o : Localization.AtPrime Q', IsUnit (k o) → IsUnit o := by
    intro o ho
    obtain ⟨⟨x, y⟩, hxy⟩ := IsLocalization.surj Q'.primeCompl o
    have e2 : k o * φ y = φ x := by rw [← hkE, ← hkE, ← map_mul, hxy]
    have hx : IsUnit (φ x) := by
      rw [← e2]
      exact ho.mul ((hunit y).mpr (Ideal.mem_primeCompl_iff.mp y.2))
    have hx' : IsUnit (algebraMap T' (Localization.AtPrime Q') x) :=
      (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime Q') Q' x).mpr
        (Ideal.mem_primeCompl_iff.mpr ((hunit x).mp hx))
    rw [← hxy] at hx'
    exact isUnit_of_mul_isUnit_left hx'
  have hkunit : ∀ o : Localization.AtPrime Q', IsUnit (k o) ↔
      o ∉ IsLocalRing.maximalIdeal (Localization.AtPrime Q') := fun o =>
    ⟨fun h => IsLocalRing.notMem_maximalIdeal.mpr (hkloc o h),
      fun h => (IsLocalRing.notMem_maximalIdeal.mp h).map k⟩
  obtain ⟨η, ⟨hηe, hηl⟩, hηu⟩ := H3 B hB k hkunit
  refine ⟨η, ⟨?_, hηl⟩, ?_⟩
  · apply IsLocalization.ringHom_ext Q.primeCompl
    apply RingHom.ext
    intro t
    show η (e' (Localization.localRingHom Q Q' τ hQ (algebraMap T (Localization.AtPrime Q) t))) =
      g (algebraMap T (Localization.AtPrime Q) t)
    rw [hℓ, ← RingHom.comp_apply η e', hηe, hkE]
    exact φ.commutes t
  rintro η' ⟨hη', hη'l⟩
  haveI := hη'l
  haveI : IsLocalHom e' := ⟨fun y hy => (hOunit y).mp hy⟩
  have hη'T : ∀ t : T, η' (e' (algebraMap T' (Localization.AtPrime Q') (τ t))) = g₀ t := by
    intro t
    rw [← hℓ]
    exact RingHom.congr_fun hη' (algebraMap T (Localization.AtPrime Q) t)
  let τ'' : T' →ₐ[T] B := ⟨(η'.comp e').comp (algebraMap T' (Localization.AtPrime Q')),
    fun t => by
      show η' (e' (algebraMap T' (Localization.AtPrime Q') (τ t))) = g₀ t
      exact hη'T t⟩
  have hres' : ∀ x : T', IsLocalRing.residue B (τ'' x) = IsLocalRing.residue B (φ x) := by
    intro x
    obtain ⟨t, ht⟩ := hres x
    have ht' : x - τ t ∈ Q' := by
      rw [← neg_sub]
      exact Q'.neg_mem ht
    have h1 : algebraMap T' (Localization.AtPrime Q') (x - τ t) ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime Q') :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q') Q' _).mpr ht'
    have h2 : ¬ IsUnit (η' (e' (algebraMap T' (Localization.AtPrime Q') (x - τ t)))) := fun hu =>
      mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h1)
        (isUnit_of_map_unit e' _ (isUnit_of_map_unit η' _ hu))
    have e3 : τ'' x - g₀ t = η' (e' (algebraMap T' (Localization.AtPrime Q') (x - τ t))) := by
      rw [map_sub, map_sub, map_sub, hη'T t]
      rfl
    have h3 : IsLocalRing.residue B (τ'' x) = IsLocalRing.residue B (g₀ t) := by
      rw [← sub_eq_zero, ← map_sub, e3, IsLocalRing.residue_eq_zero_iff,
        IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      exact h2
    have hgt : g₀ t = φ (τ t) := (φ.commutes t).symm
    have h4 : IsLocalRing.residue B (φ x) = IsLocalRing.residue B (g₀ t) := by
      rw [hgt, ← sub_eq_zero, ← map_sub, ← map_sub, hφ, hσ0]
      exact ht'
    exact h3.trans h4.symm
  have heq : τ'' = φ := wc_hnas_hs_etale_hom_unique_residue T T' B τ'' φ hres'
  have hk' : η'.comp e' = k := IsLocalization.ringHom_ext Q'.primeCompl
    (RingHom.ext fun x => by
      show η' (e' (algebraMap T' (Localization.AtPrime Q') x)) =
        k (algebraMap T' (Localization.AtPrime Q') x)
      rw [hkE]
      exact congrArg (fun F : T' →ₐ[T] B => F x) heq)
  exact hηu η' ⟨hk', hη'l⟩

theorem wcpa_dj_llsm_nrt_galois_spread : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (𝔭 : Ideal A) (k : wcLlsKind W A), wcLlsPD W A 𝔭 k →
    ∀ (z0 : A) (b : ↥W), b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    ((∃ (t : A) (c : ↥W), k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧
        z0 = t - algebraMap ↥W A c) ∨
      (∃ (u v : A) (g : ↥W), k = .ann u v g ∧ b ∣ g ∧ z0 = u)) →
    ∀ (s : K), s = algebraMap A K (algebraMap ↥W A b) / algebraMap A K z0 →
    ∀ (Q₀ : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) [Q₀.IsPrime],
    Q₀.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) =
      Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z0,
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) →
    ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥(Algebra.adjoin A {s}) Q₀) →
    wcLlsSepAt W A K L z0 s :=
by
  classical
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ 𝔭 k hPD z0 b hbm hb0 hshape s hs Q₀ _ hQ₀ hgood

  obtain ⟨_, hNmax⟩ :=
    wcpa_dj_llsm_neat_node_proper Ω W hW hWt A K 𝔭 k hPD z0 b hbm hb0 hshape s hs
  obtain ⟨N, hN⟩ : ∃ N : Ideal ↥(Algebra.adjoin A {s}), N =
      Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z0,
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) := ⟨_, rfl⟩
  haveI hNmaxI : N.IsMaximal := by rw [hN]; exact hNmax

  have hshape' : (∃ t c, k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧
        z0 = t - algebraMap ↥W A c) ∨ (∃ v g, k = .ann z0 v g ∧ b ∣ g) := by
    rcases hshape with ⟨t, c, hk, hc, hz⟩ | ⟨u, v, g, hk, hg, hz⟩
    · exact Or.inl ⟨t, c, hk, hc, hz⟩
    · rw [← hz] at hk
      exact Or.inr ⟨v, g, hk, hg⟩
  obtain ⟨_, hNint, -⟩ :=
    wcpa_dj_llsm_brrm_node_pres Ω W hW hWt A K 𝔭 k z0 b hPD hshape' hbm hb0 s hs N hN

  have hfin := wcpa_dj_llsm_sd_normalization_finite Ω W hW hWt A K K 𝔭 k hPD s

  haveI hDK : IsFractionRing ↥(Algebra.adjoin A {s}) K := by
    refine IsFractionRing.of_field _ K (fun z => ?_)
    obtain ⟨p, q, -, hpq⟩ := IsFractionRing.div_surjective (A := A) z
    exact ⟨algebraMap A _ p, algebraMap A _ q, hpq.symm⟩

  have conductor : ∀ (R : Type u) [CommRing R] [IsDomain R] [Algebra R K] [IsFractionRing R K]
      (N : Ideal R) [N.IsPrime], Module.Finite R ↥(integralClosure R K) →
      IsIntegrallyClosed (Localization.AtPrime N) →
      ∃ h : R, h ∉ N ∧ ∀ z : K, IsIntegral R z → ∃ r : R, algebraMap R K r = algebraMap R K h * z := by
    intro R _ _ _ _ N _ hfin hint
    have hunits : ∀ y : N.primeCompl, IsUnit (algebraMap R K y) := by
      intro y
      apply IsUnit.mk0
      intro h0
      have hy : (y : R) ∉ N := y.2
      apply hy
      have : (y : R) = 0 := IsFractionRing.injective R K (h0.trans (map_zero _).symm)
      rw [this]
      exact N.zero_mem
    letI : Algebra (Localization.AtPrime N) K :=
      (IsLocalization.lift (S := Localization.AtPrime N) hunits).toAlgebra
    haveI : IsScalarTower R (Localization.AtPrime N) K :=
      IsScalarTower.of_algebraMap_eq
        (fun x => (IsLocalization.lift_eq (S := Localization.AtPrime N) hunits x).symm)
    haveI : IsFractionRing (Localization.AtPrime N) K :=
      IsFractionRing.isFractionRing_of_isDomain_of_isLocalization N.primeCompl _ K
    haveI := hint
    haveI := hfin
    have hloc : ∀ x : ↥(integralClosure R K), ∃ d : R, ∃ t : R, t ∉ N ∧
        algebraMap R K d = algebraMap R K t * (x : K) := by
      intro x
      have hx : IsIntegral (Localization.AtPrime N) (x : K) :=
        (show IsIntegral R (x : K) from x.2).tower_top
      obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hx
      obtain ⟨⟨d, t⟩, rfl⟩ := IsLocalization.mk'_surjective N.primeCompl y
      refine ⟨d, t, t.2, ?_⟩
      have h1 := IsLocalization.mk'_spec (Localization.AtPrime N) d t
      have h2 := congrArg (algebraMap (Localization.AtPrime N) K) h1
      rw [map_mul, ← IsScalarTower.algebraMap_apply R (Localization.AtPrime N) K,
        ← IsScalarTower.algebraMap_apply R (Localization.AtPrime N) K, hy] at h2
      rw [← h2, mul_comm]
    obtain ⟨G, hG⟩ := (Module.Finite.fg_top : (⊤ : Submodule R ↥(integralClosure R K)).FG)
    choose d t ht hdt using hloc
    refine ⟨∏ g ∈ G, t g, ?_, ?_⟩
    · intro hmem
      obtain ⟨g, -, hg⟩ := (Ideal.IsPrime.prod_mem_iff (p := N)).mp hmem
      exact ht g hg
    · intro z hz
      have hzmem : (⟨z, hz⟩ : ↥(integralClosure R K)) ∈
          Submodule.span R (G : Set ↥(integralClosure R K)) := by
        rw [hG]; trivial
      have key : ∀ x ∈ Submodule.span R (G : Set ↥(integralClosure R K)),
          ∃ r : R, algebraMap R K r = algebraMap R K (∏ g ∈ G, t g) * (x : K) := by
        intro x hx
        induction hx using Submodule.span_induction with
        | mem x hx =>
          refine ⟨(∏ g ∈ G.erase x, t g) * d x, ?_⟩
          rw [map_mul, hdt x, ← Finset.mul_prod_erase G t (Finset.mem_coe.mp hx), map_mul]
          ring
        | zero => exact ⟨0, by simp⟩
        | add x y _ _ hx hy =>
          obtain ⟨r1, h1⟩ := hx
          obtain ⟨r2, h2⟩ := hy
          refine ⟨r1 + r2, ?_⟩
          rw [map_add, h1, h2, ← mul_add]
          rfl
        | smul a x _ hx =>
          obtain ⟨r1, h1⟩ := hx
          refine ⟨a * r1, ?_⟩
          rw [map_mul, h1, show ((a • x : ↥(integralClosure R K)) : K) = algebraMap R K a * (x : K)
            from Algebra.smul_def a (x : K)]
          ring
      exact key _ hzmem

  have transport : ∀ (R : Type u) [CommRing R] [Algebra R K] [Algebra R L] [IsScalarTower R K L]
      (σ : L ≃ₐ[K] L) (P P' : Ideal ↥(integralClosure R L)) [P.IsPrime] [P'.IsPrime],
      (∀ x y : ↥(integralClosure R L), (y : L) = σ (x : L) → (x ∈ P ↔ y ∈ P')) →
      Nonempty (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) R P ≃+*
        wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) R P') := by
    intro R _ _ _ _ σ P P' _ _ hσ
    let σR : L ≃ₐ[R] L := AlgEquiv.restrictScalars R σ
    let σR' : L ≃ₐ[R] L := AlgEquiv.restrictScalars R σ.symm
    have hi1 : ∀ x : ↥(integralClosure R L), σ (x : L) ∈ integralClosure R L :=
      fun x => (show IsIntegral R (x : L) from x.2).map σR
    have hi2 : ∀ x : ↥(integralClosure R L), σ.symm (x : L) ∈ integralClosure R L :=
      fun x => (show IsIntegral R (x : L) from x.2).map σR'
    let σS : ↥(integralClosure R L) ≃+* ↥(integralClosure R L) :=
      { toFun := fun x => ⟨σ x, hi1 x⟩
        invFun := fun x => ⟨σ.symm x, hi2 x⟩
        left_inv := fun x => Subtype.ext (σ.symm_apply_apply (x : L))
        right_inv := fun x => Subtype.ext (σ.apply_symm_apply (x : L))
        map_mul' := fun x y => Subtype.ext (map_mul σ (x : L) (y : L))
        map_add' := fun x y => Subtype.ext (map_add σ (x : L) (y : L)) }
    have hcompl : Submonoid.map σS.toMonoidHom P.primeCompl = P'.primeCompl := by
      ext y
      simp only [Submonoid.mem_map, Ideal.mem_primeCompl_iff]
      constructor
      · rintro ⟨x, hx, rfl⟩
        exact fun hy => hx ((hσ x (σS.toMonoidHom x) rfl).mpr hy)
      · intro hy
        refine ⟨σS.symm y, fun hx => hy ((hσ (σS.symm y) y
          (σ.apply_symm_apply (y : L)).symm).mp hx), ?_⟩
        exact σS.apply_symm_apply y
    let eloc : Localization.AtPrime P ≃+* Localization.AtPrime P' :=
      IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime P) (Localization.AtPrime P') σS hcompl
    have hfix : ∀ x ∈ {b : ↥(integralClosure R L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w},
        (σS : ↥(integralClosure R L) →+* ↥(integralClosure R L)) x = x := by
      rintro x ⟨w, -, hw⟩
      apply Subtype.ext
      show σ (x : L) = (x : L)
      rw [hw, RingHom.comp_apply, AlgEquiv.commutes]
    have hI : Ideal.map (σS : ↥(integralClosure R L) →+* ↥(integralClosure R L))
        (Ideal.span {b : ↥(integralClosure R L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (b : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}) =
        Ideal.span {b : ↥(integralClosure R L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (b : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} := by
      rw [Ideal.map_span]
      congr 1
      ext y
      constructor
      · rintro ⟨x, hx, rfl⟩
        rw [hfix x hx]
        exact hx
      · intro hy
        exact ⟨y, hy, hfix y hy⟩
    have hcomp : (eloc : Localization.AtPrime P →+* Localization.AtPrime P').comp
        (algebraMap ↥(integralClosure R L) (Localization.AtPrime P)) =
        (algebraMap ↥(integralClosure R L) (Localization.AtPrime P')).comp
          (σS : ↥(integralClosure R L) →+* ↥(integralClosure R L)) := by
      refine RingHom.ext fun x => ?_
      simp only [RingHom.comp_apply, RingEquiv.coe_toRingHom]
      exact IsLocalization.ringEquivOfRingEquiv_eq hcompl x
    unfold wcLlsFS
    refine ⟨Ideal.quotientEquiv _ _ eloc ?_⟩
    rw [Ideal.map_map, hcomp, ← Ideal.map_map, hI]

  obtain ⟨h, hhN, hcl⟩ := conductor ↥(Algebra.adjoin A {s}) N hfin hNint

  unfold wcLlsSepAt
  intro Q _ hQ
  obtain ⟨σ, hσ⟩ := wcpa_dj_llsm_fcw_galois_transitive ↥(Algebra.adjoin A {s}) K L N h hhN
    (fun z hz => by
      obtain ⟨r, hr⟩ := hcl z hz
      exact ⟨1, r, by rw [pow_one]; exact hr⟩)
    Q₀ Q inferInstance inferInstance (hQ₀.trans hN.symm) (hQ.trans hN.symm)

  obtain ⟨eFS⟩ := transport ↥(Algebra.adjoin A {s}) σ Q₀ Q hσ
  obtain ⟨hd, hbr⟩ := wcpa_dj_lr1k_llfi_ringequiv _ _ eFS
  unfold wcpaDjLkBad at hgood ⊢
  rw [← hd, ← hbr]
  exact hgood

theorem wcpa_dj_llsm_neat_radius_transfer : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M L : Type u) [Field M] [Field L] [Algebra K M] [Algebra M L]
    [Algebra K L] [IsScalarTower K M L] [FiniteDimensional K L] [IsGalois K L]
    [FiniteDimensional K M]
    (𝔭 : Ideal A) (k : wcLlsKind W A), wcLlsPD W A 𝔭 k →
    ∀ (z0 : A) (b₁ : ↥W), b₁ ∈ IsLocalRing.maximalIdeal ↥W → b₁ ≠ 0 →
    ((∃ (t : A) (c : ↥W), k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧
        z0 = t - algebraMap ↥W A c) ∨
      (∃ (u v : A) (g : ↥W), k = .ann u v g ∧ b₁ ∣ g ∧ z0 = u)) →
    ∀ (s : K), s = algebraMap A K (algebraMap ↥W A b₁) / algebraMap A K z0 →
    ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) [Q.IsPrime],
    Q.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) =
      Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z0,
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) →
    ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B]
      (ι : ↥(integralClosure ↥(Algebra.adjoin A {s}) M) →+* B) (𝔮 : Ideal B) (u' v' : B)
      (g' : ↥W),
    ι.Etale → Function.Injective ι →
    ι.comp ((algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)).comp
      ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) = algebraMap ↥W B →
    𝔮.comap ι = Q → wcLlsPD W B 𝔮 (.ann u' v' g') →
    ∀ (e : ℕ) (η η' : B), 0 < e → η * η' = 1 →
    ι (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
      (algebraMap A ↥(Algebra.adjoin A {s}) z0)) = η * u' ^ e →
    g' ^ e ∣ b₁ → b₁ ∣ g' ^ e →
    ∀ (M' : Type u) [Field M'] [Algebra B M'] [IsFractionRing B M'] [Algebra M M'],
    (∀ c : ↥(integralClosure ↥(Algebra.adjoin A {s}) M),
      algebraMap M M' (c : M) = algebraMap B M' (ι c)) →
    ∀ (L' : Type u) [Field L'] [Algebra M' L'] [Algebra B L'] [IsScalarTower B M' L']
      [FiniteDimensional M' L'] [IsGalois M' L'] (lam : L →+* L'),
    lam.comp (algebraMap M L) = (algebraMap M' L').comp (algebraMap M M') →
    Algebra.adjoin M' (Set.range lam) = ⊤ →
    ∀ b' : ↥W, b' ∈ IsLocalRing.maximalIdeal ↥W → b' ≠ 0 → b' ^ e ∣ b₁ →
      (wcLlsSepAt W A K L z0 (algebraMap A K (algebraMap ↥W A (b' ^ e)) / algebraMap A K z0) ↔
        wcLlsAnnSep W B M' L' u' b') :=
by
  classical
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M L _ _ _ _ _ _ _ _ _ 𝔭 k hPD z0 b₁ hb₁m hb₁0 hshape s hs
    Q _ hQ B _ _ _ ι 𝔮 u' v' g' hιet hιinj hιW h𝔮Q hPDB e η η' he hηη hιz hgb hbg M' _ _ _ _
    hlift L' _ _ _ _ _ _ lam hlam hadj b' hb'm hb'0 hb'b

  have hbm : b' ^ e ∈ IsLocalRing.maximalIdeal ↥W := Ideal.pow_mem_of_mem _ hb'm e he
  have hb0 : b' ^ e ≠ 0 := pow_ne_zero e hb'0
  have hb'g : b' ∣ g' := (IsIntegrallyClosed.pow_dvd_pow_iff he.ne').mp (hb'b.trans hbg)
  have hshapeb : (∃ (t : A) (c : ↥W), k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧
        z0 = t - algebraMap ↥W A c) ∨
      (∃ (u v : A) (g : ↥W), k = .ann u v g ∧ b' ^ e ∣ g ∧ z0 = u) := by
    rcases hshape with ⟨t, c, hk, hc, hz⟩ | ⟨u, v, g, hk, hg, hz⟩
    · exact Or.inl ⟨t, c, hk, hc, hz⟩
    · exact Or.inr ⟨u, v, g, hk, hb'b.trans hg, hz⟩
  have hshapeB : (∃ (t : B) (c : ↥W), (wcLlsKind.ann u' v' g' : wcLlsKind W B) = .disc t ∧
        c ∈ IsLocalRing.maximalIdeal ↥W ∧ u' = t - algebraMap ↥W B c) ∨
      (∃ (u v : B) (g : ↥W), (wcLlsKind.ann u' v' g' : wcLlsKind W B) = .ann u v g ∧
        b' ∣ g ∧ u' = u) :=
    Or.inr ⟨u', v', g', rfl, hb'g, rfl⟩
  obtain ⟨sb, hsb⟩ : ∃ x : K, x = algebraMap A K (algebraMap ↥W A (b' ^ e)) / algebraMap A K z0 :=
    ⟨_, rfl⟩
  obtain ⟨s', hs'⟩ : ∃ x : M', x = algebraMap B M' (algebraMap ↥W B b') / algebraMap B M' u' :=
    ⟨_, rfl⟩
  rw [← hsb]
  show wcLlsSepAt W A K L z0 sb ↔
    wcLlsSepAt W B M' L' u' (algebraMap B M' (algebraMap ↥W B b') / algebraMap B M' u')
  rw [← hs']
  obtain ⟨_hz0K, hNbmax⟩ :=
    wcpa_dj_llsm_neat_node_proper Ω W hW hWt A K 𝔭 k hPD z0 (b' ^ e) hbm hb0 hshapeb sb hsb
  obtain ⟨hu'M, hN'max⟩ :=
    wcpa_dj_llsm_neat_node_proper Ω W hW hWt B M' 𝔮 (.ann u' v' g') hPDB u' b' hb'm hb'0
      hshapeB s' hs'

  have hψW : ∀ w : ↥W, algebraMap M M' (algebraMap K M (algebraMap A K (algebraMap ↥W A w))) =
      algebraMap B M' (algebraMap ↥W B w) := by
    intro w
    have h1 := hlift (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
      (algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w)))
    have h2 := RingHom.congr_fun hιW w
    simp only [RingHom.comp_apply] at h2
    rw [h2] at h1
    exact h1
  have hψz : algebraMap M M' (algebraMap K M (algebraMap A K z0)) =
      algebraMap B M' η * algebraMap B M' u' ^ e := by
    have h1 := hlift (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
      (algebraMap A ↥(Algebra.adjoin A {s}) z0))
    rw [hιz, map_mul, map_pow] at h1
    exact h1
  have hηM : algebraMap B M' η * algebraMap B M' η' = 1 := by rw [← map_mul, hηη, map_one]
  have hη'inv : algebraMap B M' η' = (algebraMap B M' η)⁻¹ := eq_inv_of_mul_eq_one_right hηM
  have hηne : algebraMap B M' η ≠ 0 := left_ne_zero_of_mul_eq_one hηM
  have hψsb : algebraMap M M' (algebraMap K M sb) = algebraMap B M' η' * s' ^ e := by
    rw [hsb, map_div₀, map_div₀, hψW, hψz, hs', hη'inv]
    simp only [map_pow, div_pow]
    field_simp
  have hs'pow : s' ^ e = algebraMap B M' η * algebraMap M M' (algebraMap K M sb) := by
    rw [hψsb, ← mul_assoc, hηM, one_mul]
  obtain ⟨c, hc⟩ := hb'b
  have hcA : s = algebraMap A K (algebraMap ↥W A c) * sb := by
    rw [hs, hsb, hc, map_mul, map_mul]
    ring

  obtain ⟨τ, hτet, hτ⟩ := wcpa_dj_llsm_nrt_tau_etale A K M L s B ι hιet hιinj M' hlift L' lam hlam
    hadj sb s' (algebraMap ↥W A c) η η' e he hcA hs'pow hψsb
  have hlamK : ∀ x : K, lam (algebraMap K L x) =
      algebraMap M' L' (algebraMap M M' (algebraMap K M x)) := by
    intro x
    rw [IsScalarTower.algebraMap_apply K M L]
    exact RingHom.congr_fun hlam _
  have hτW : ∀ w : ↥W, τ (algebraMap ↥(Algebra.adjoin A {sb})
      ↥(integralClosure ↥(Algebra.adjoin A {sb}) L)
      (algebraMap A ↥(Algebra.adjoin A {sb}) (algebraMap ↥W A w))) =
      algebraMap ↥(Algebra.adjoin B {s'}) ↥(integralClosure ↥(Algebra.adjoin B {s'}) L')
        (algebraMap B ↥(Algebra.adjoin B {s'}) (algebraMap ↥W B w)) := by
    intro w
    apply Subtype.ext
    rw [hτ]
    show lam (algebraMap K L (algebraMap A K (algebraMap ↥W A w))) =
      algebraMap M' L' (algebraMap B M' (algebraMap ↥W B w))
    rw [hlamK, hψW]
  have hτz : τ (algebraMap ↥(Algebra.adjoin A {sb}) ↥(integralClosure ↥(Algebra.adjoin A {sb}) L)
      (algebraMap A ↥(Algebra.adjoin A {sb}) z0)) =
      algebraMap ↥(Algebra.adjoin B {s'}) ↥(integralClosure ↥(Algebra.adjoin B {s'}) L')
        (algebraMap B ↥(Algebra.adjoin B {s'}) η) *
      algebraMap ↥(Algebra.adjoin B {s'}) ↥(integralClosure ↥(Algebra.adjoin B {s'}) L')
        (algebraMap B ↥(Algebra.adjoin B {s'}) u') ^ e := by
    apply Subtype.ext
    rw [hτ, MulMemClass.coe_mul, SubmonoidClass.coe_pow]
    show lam (algebraMap K L (algebraMap A K z0)) =
      algebraMap M' L' (algebraMap B M' η) * algebraMap M' L' (algebraMap B M' u') ^ e
    rw [hlamK, hψz, map_mul, map_pow]
  have hτs : τ (algebraMap ↥(Algebra.adjoin A {sb}) ↥(integralClosure ↥(Algebra.adjoin A {sb}) L)
      ⟨sb, Algebra.subset_adjoin (Set.mem_singleton sb)⟩) =
      algebraMap ↥(Algebra.adjoin B {s'}) ↥(integralClosure ↥(Algebra.adjoin B {s'}) L')
        (algebraMap B ↥(Algebra.adjoin B {s'}) η') *
      algebraMap ↥(Algebra.adjoin B {s'}) ↥(integralClosure ↥(Algebra.adjoin B {s'}) L')
        ⟨s', Algebra.subset_adjoin (Set.mem_singleton s')⟩ ^ e := by
    apply Subtype.ext
    rw [hτ, MulMemClass.coe_mul, SubmonoidClass.coe_pow]
    show lam (algebraMap K L sb) =
      algebraMap M' L' (algebraMap B M' η') * algebraMap M' L' s' ^ e
    rw [hlamK, hψsb, map_mul, map_pow]

  have hu'N : algebraMap B ↥(Algebra.adjoin B {s'}) u' ∈
      Ideal.span {algebraMap B ↥(Algebra.adjoin B {s'}) u',
        ⟨s', Algebra.subset_adjoin (Set.mem_singleton s')⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap B ↥(Algebra.adjoin B {s'})).comp (algebraMap ↥W B)) :=
    Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hs'N : (⟨s', Algebra.subset_adjoin (Set.mem_singleton s')⟩ : ↥(Algebra.adjoin B {s'})) ∈
      Ideal.span {algebraMap B ↥(Algebra.adjoin B {s'}) u',
        ⟨s', Algebra.subset_adjoin (Set.mem_singleton s')⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap B ↥(Algebra.adjoin B {s'})).comp (algebraMap ↥W B)) :=
    Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
  have hmN : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W →
      algebraMap B ↥(Algebra.adjoin B {s'}) (algebraMap ↥W B w) ∈
      Ideal.span {algebraMap B ↥(Algebra.adjoin B {s'}) u',
        ⟨s', Algebra.subset_adjoin (Set.mem_singleton s')⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap B ↥(Algebra.adjoin B {s'})).comp (algebraMap ↥W B)) := fun w hw =>
    Ideal.mem_sup_right (Ideal.mem_map_of_mem ((algebraMap B ↥(Algebra.adjoin B {s'})).comp
      (algebraMap ↥W B)) hw)

  have hcomapL : ∀ (Q'' : Ideal ↥(integralClosure ↥(Algebra.adjoin B {s'}) L')) [Q''.IsPrime],
      Q''.comap (algebraMap ↥(Algebra.adjoin B {s'}) ↥(integralClosure ↥(Algebra.adjoin B {s'}) L')) =
        Ideal.span {algebraMap B ↥(Algebra.adjoin B {s'}) u',
          ⟨s', Algebra.subset_adjoin (Set.mem_singleton s')⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap B ↥(Algebra.adjoin B {s'})).comp (algebraMap ↥W B)) →
      (Q''.comap τ).comap
          (algebraMap ↥(Algebra.adjoin A {sb}) ↥(integralClosure ↥(Algebra.adjoin A {sb}) L)) =
        Ideal.span {algebraMap A ↥(Algebra.adjoin A {sb}) z0,
          ⟨sb, Algebra.subset_adjoin (Set.mem_singleton sb)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {sb})).comp (algebraMap ↥W A)) := by
    intro Q'' _ hQ''
    have hmem : ∀ y : ↥(Algebra.adjoin B {s'}),
        y ∈ Ideal.span {algebraMap B ↥(Algebra.adjoin B {s'}) u',
          ⟨s', Algebra.subset_adjoin (Set.mem_singleton s')⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap B ↥(Algebra.adjoin B {s'})).comp (algebraMap ↥W B)) →
        algebraMap ↥(Algebra.adjoin B {s'}) ↥(integralClosure ↥(Algebra.adjoin B {s'}) L') y ∈ Q'' :=
      fun y hy => by rw [← Ideal.mem_comap, hQ'']; exact hy
    symm
    apply Ideal.IsMaximal.eq_of_le hNbmax (Ideal.IsPrime.ne_top inferInstance)
    apply sup_le
    · rw [Ideal.span_le]
      intro x hx
      rcases (Set.mem_insert_iff.mp hx) with rfl | hx'
      · show _ ∈ (Q''.comap τ).comap _
        rw [Ideal.mem_comap, Ideal.mem_comap, hτz]
        exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ (hmem _ hu'N) e he)
      · rw [Set.mem_singleton_iff] at hx'
        subst hx'
        show _ ∈ (Q''.comap τ).comap _
        rw [Ideal.mem_comap, Ideal.mem_comap, hτs]
        exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ (hmem _ hs'N) e he)
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, RingHom.comp_apply, Ideal.mem_comap, Ideal.mem_comap, hτW]
      exact hmem _ (hmN w hw)

  have hFT : Algebra.FiniteType B ↥(Algebra.adjoin B {s'}) := by
    have hfg : (Algebra.adjoin B ({s'} : Set M')).FG := ⟨{s'}, by rw [Finset.coe_singleton]⟩
    exact (Subalgebra.fg_iff_finiteType _).mp hfg
  have star : ∀ (Q'' : Ideal ↥(integralClosure ↥(Algebra.adjoin B {s'}) L')) [Q''.IsPrime],
      Q''.comap (algebraMap ↥(Algebra.adjoin B {s'}) ↥(integralClosure ↥(Algebra.adjoin B {s'}) L')) =
        Ideal.span {algebraMap B ↥(Algebra.adjoin B {s'}) u',
          ⟨s', Algebra.subset_adjoin (Set.mem_singleton s')⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap B ↥(Algebra.adjoin B {s'})).comp (algebraMap ↥W B)) →
      (¬ wcpaDjLkBad (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
          ↥(Algebra.adjoin A {sb}) (Q''.comap τ)) ↔
        ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap M' L').comp ((algebraMap B M').comp (algebraMap ↥W B)))
          ↥(Algebra.adjoin B {s'}) Q'')) := by
    intro Q'' _ hQ''
    have hcL := hcomapL Q'' hQ''
    have hQ''max : Q''.IsMaximal :=
      Ideal.isMaximal_of_isIntegral_of_isMaximal_comap
        (algebraMap ↥(Algebra.adjoin B {s'}) ↥(integralClosure ↥(Algebra.adjoin B {s'}) L'))
        (fun x => Algebra.IsIntegral.isIntegral x) Q'' (by rw [hQ'']; exact hN'max)
    have hres : ∀ x' : ↥(integralClosure ↥(Algebra.adjoin B {s'}) L'),
        ∃ x : ↥(integralClosure ↥(Algebra.adjoin A {sb}) L), τ x - x' ∈ Q'' := by
      intro x'
      obtain ⟨w, hw⟩ := wcpa_dj_llsm_nrt_residue_surj Ω W B hPDB.1 ↥(Algebra.adjoin B {s'}) hFT _
        hN'max le_sup_right ↥(integralClosure ↥(Algebra.adjoin B {s'}) L') Q'' inferInstance hQ'' x'
      refine ⟨algebraMap ↥(Algebra.adjoin A {sb}) ↥(integralClosure ↥(Algebra.adjoin A {sb}) L)
        (algebraMap A ↥(Algebra.adjoin A {sb}) (algebraMap ↥W A w)), ?_⟩
      rw [hτW, ← neg_sub]
      exact (neg_mem_iff).mpr hw
    obtain ⟨P, _, e', he'⟩ := wcNd_hens_exists (Localization.AtPrime Q'')
      (IsLocalRing.maximalIdeal _) inferInstance
    have heA := wcpa_dj_llsm_nrt_hens_etale_transfer _ _ τ hτet Q'' (Q''.comap τ) rfl hres P e' he'
    have hσ : (e'.comp (Localization.localRingHom (Q''.comap τ) Q'' τ rfl)).comp
        ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {sb}) L)
          (Localization.AtPrime (Q''.comap τ))).comp
        ((algebraMap ↥(Algebra.adjoin A {sb}) ↥(integralClosure ↥(Algebra.adjoin A {sb}) L)).comp
        ((algebraMap A ↥(Algebra.adjoin A {sb})).comp (algebraMap ↥W A)))) =
        e'.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin B {s'}) L')
          (Localization.AtPrime Q'')).comp
        ((algebraMap ↥(Algebra.adjoin B {s'}) ↥(integralClosure ↥(Algebra.adjoin B {s'}) L')).comp
        ((algebraMap B ↥(Algebra.adjoin B {s'})).comp (algebraMap ↥W B)))) := by
      ext w
      simp only [RingHom.comp_apply]
      rw [Localization.localRingHom_to_map, hτW]
    constructor
    · intro hA
      apply wcpa_dj_llsm_sd_model_good Ω W hW hWt B M' L' 𝔮 (.ann u' v' g') hPDB u' b' hb'm hb'0
        hshapeB s' hs' Q'' hQ'' P e' he'
      rw [← hσ]
      exact wcpa_dj_llsm_sd_good_model Ω W hW hWt A K L 𝔭 k hPD z0 (b' ^ e) hbm hb0 hshapeb sb hsb
        (Q''.comap τ) hcL hA P _ heA
    · intro hB
      apply wcpa_dj_llsm_sd_model_good Ω W hW hWt A K L 𝔭 k hPD z0 (b' ^ e) hbm hb0 hshapeb sb hsb
        (Q''.comap τ) hcL P _ heA
      rw [hσ]
      exact wcpa_dj_llsm_sd_good_model Ω W hW hWt B M' L' 𝔮 (.ann u' v' g') hPDB u' b' hb'm hb'0
        hshapeB s' hs' Q'' hQ'' hB P e' he'

  constructor
  · intro hsepA Q'' _ hQ''
    exact (star Q'' hQ'').mp (hsepA (Q''.comap τ) (hcomapL Q'' hQ''))
  · intro hann
    haveI := hN'max.isPrime
    have hinj' : Function.Injective (algebraMap ↥(Algebra.adjoin B {s'})
        ↥(integralClosure ↥(Algebra.adjoin B {s'}) L')) := by
      intro p q hpq
      apply Subtype.ext
      apply (algebraMap M' L').injective
      exact congrArg (fun c : ↥(integralClosure ↥(Algebra.adjoin B {s'}) L') => (c : L')) hpq
    obtain ⟨Q₀, -, hQ₀p, hQ₀⟩ := Ideal.exists_ideal_over_prime_of_isIntegral
      (S := ↥(integralClosure ↥(Algebra.adjoin B {s'}) L'))
      (Ideal.span {algebraMap B ↥(Algebra.adjoin B {s'}) u',
          ⟨s', Algebra.subset_adjoin (Set.mem_singleton s')⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap B ↥(Algebra.adjoin B {s'})).comp (algebraMap ↥W B))) ⊥ (by
        intro p hp
        have hp' : algebraMap ↥(Algebra.adjoin B {s'})
            ↥(integralClosure ↥(Algebra.adjoin B {s'}) L') p
            ∈ (⊥ : Ideal ↥(integralClosure ↥(Algebra.adjoin B {s'}) L')) := hp
        rw [(injective_iff_map_eq_zero _).mp hinj' p (Ideal.mem_bot.mp hp')]
        exact Submodule.zero_mem _)
    haveI := hQ₀p
    have hQ₀' : Q₀.comap (algebraMap ↥(Algebra.adjoin B {s'})
        ↥(integralClosure ↥(Algebra.adjoin B {s'}) L')) =
        Ideal.span {algebraMap B ↥(Algebra.adjoin B {s'}) u',
          ⟨s', Algebra.subset_adjoin (Set.mem_singleton s')⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap B ↥(Algebra.adjoin B {s'})).comp (algebraMap ↥W B)) := hQ₀
    have hgood := (star Q₀ hQ₀').mpr (hann Q₀ hQ₀')
    exact wcpa_dj_llsm_nrt_galois_spread Ω W hW hWt A K L 𝔭 k hPD z0 (b' ^ e) hbm hb0 hshapeb sb
      hsb (Q₀.comap τ) (hcomapL Q₀ hQ₀') hgood

theorem wcpa_dj_llsm_nss_etale_annulus_transfer : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M L : Type u) [Field M] [Field L] [Algebra K M] [Algebra M L]
    [Algebra K L] [Algebra A M] [Algebra A L] [IsScalarTower A K M] [IsScalarTower K M L]
    [IsScalarTower A K L] [IsScalarTower A M L] [FiniteDimensional K L] [IsGalois K L]
    [FiniteDimensional K M] [IsGalois K M]
    (𝔭 : Ideal A) (k : wcLlsKind W A) (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 k →
    ∀ (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → wcLlsUniq A L 𝔭 y →
    Group.IsSolvable (L ≃ₐ[K] L) →
    ∀ (z0 : A) (b₁ : ↥W), b₁ ∈ IsLocalRing.maximalIdeal ↥W → b₁ ≠ 0 →
    ((∃ (t : A) (c : ↥W), k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧
        z0 = t - algebraMap ↥W A c) ∨
      (∃ (u v : A) (g : ↥W), k = .ann u v g ∧ b₁ ∣ g ∧ z0 = u)) →
    wcLlsSepAt W A K M z0 (algebraMap A K (algebraMap ↥W A b₁) / algebraMap A K z0) →
    ∃ (B : Type u) (_ : CommRing B) (_ : IsDomain B) (_ : Algebra ↥W B)
      (M' : Type u) (_ : Field M') (_ : Algebra B M') (_ : IsFractionRing B M')
      (L' : Type u) (_ : Field L') (_ : Algebra M' L') (_ : Algebra B L')
      (_ : IsScalarTower B M' L') (_ : FiniteDimensional M' L') (_ : IsGalois M' L')
      (𝔮 : Ideal B) (u' v' : B) (g' : ↥W) (y₁ : Ideal ↥(integralClosure B L')) (e : ℕ),
      0 < e ∧ wcLlsPD W B 𝔮 (.ann u' v' g') ∧ wcLlsSolvPt W B M' L' 𝔮 (.ann u' v' g') y₁ ∧
      Nat.card ↥(wcLlsDec B M' L' y₁) ≤ Nat.card (L ≃ₐ[M] L) ∧ g' ^ e ∣ b₁ ∧ b₁ ∣ g' ^ e ∧
      ∀ b' : ↥W, b' ∈ IsLocalRing.maximalIdeal ↥W → b' ≠ 0 → b' ^ e ∣ b₁ →
        (wcLlsSepAt W A K L z0 (algebraMap A K (algebraMap ↥W A (b' ^ e)) / algebraMap A K z0) ↔
          wcLlsAnnSep W B M' L' u' b') :=
by
  classical
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M L _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ 𝔭 k y hPD _hy _hyc _hUniq
    hGsolv z0 b₁ hb₁m hb₁0 hshape hsepM
  haveI := hGsolv
  haveI : FiniteDimensional M L := Module.Finite.of_restrictScalars_finite K M L

  obtain ⟨s, hs⟩ : ∃ s : K, s = algebraMap A K (algebraMap ↥W A b₁) / algebraMap A K z0 :=
    ⟨_, rfl⟩
  rw [← hs] at hsepM

  obtain ⟨hz0, hN⟩ :=
    wcpa_dj_llsm_neat_node_proper Ω W hW hWt A K 𝔭 k hPD z0 b₁ hb₁m hb₁0 hshape s hs
  haveI := hN.isPrime

  have hinjAC : Function.Injective (algebraMap ↥(Algebra.adjoin A {s})
      ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) := by
    intro p q hpq
    apply Subtype.ext
    apply (algebraMap K M).injective
    exact congrArg (fun c : ↥(integralClosure ↥(Algebra.adjoin A {s}) M) => (c : M)) hpq
  obtain ⟨Q, -, hQp, hQ⟩ := Ideal.exists_ideal_over_prime_of_isIntegral
    (S := ↥(integralClosure ↥(Algebra.adjoin A {s}) M))
    (Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z0,
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) ⊥ (by
      intro p hp
      have hp' : algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M) p
