    · rw [ValuationSubring.valuation_le_one_iff, ValuationSubring.mem_comap, Hβ hy s,
        ← ValuationSubring.valuation_le_one_iff]
      exact d1 _
    · have hs' : β s ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk y) := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hs ⊢
        exact fun hu => hs (isUnit_of_map_unit β s hu)
      rw [Hlt, Hβ hy s]
      exact d2 _ hs'

  have Hfix : ∀ {X₁ : Scheme.{u}} (ι₁ : wcProjK Ω 1 ⟶ X₁) (y : X₁)
      (hy : (γ ≫ ι₁) (genericPoint C) ⤳ y) (a : X₁.presheaf.stalk y),
      ψ ((wcLr1uGerm (γ ≫ ι₁) y hy).hom a) = (wcLr1uGerm (γ ≫ ι₁) y hy).hom a := by
    intro X₁ ι₁ y hy a
    have ef : g.hom ≫ (γ ≫ ι₁) = γ ≫ ι₁ := by rw [← Category.assoc, hγ]
    have hy' : (g.hom ≫ (γ ≫ ι₁)) (genericPoint C) ⤳ y := by rw [ef]; exact hy
    have key := Hpre g.hom h₀ (γ ≫ ι₁) y hy hy'
    rw [Hcongr _ _ ef y hy' hy] at key
    rw [hψ]
    exact congrArg (fun φ => φ.hom a) key

  have hLA' : wcNsrNlbLim W γ uX ι x (A.comap ψ) := by
    intro σ a σ' a' hP hP' hE hE' hle hnle X₁ r₁ ι₁ hbl hι hM σ₁ hσ₁
    exact Htr (γ ≫ ι₁) _ (RingHom.id _) (isLocalHom_id _)
      (fun hy s => Hfix ι₁ _ hy s)
      (hL σ a σ' a' hP hP' hE hE' hle hnle X₁ r₁ ι₁ hbl hι hM σ₁ hσ₁)

  obtain ⟨hc, e1, e2⟩ := hD
  have hn : g' (wcNdPt W (γ ≫ ι) uX y₀) ⤳ wcNdPt W (γ ≫ ι) uX y₀ := by
    rw [hg'3]
  have h' : ((γ ≫ ι).toNormalization ≫ g') (genericPoint C) ⤳ wcNdPt W (γ ≫ ι) uX y₀ := by
    rw [Scheme.Hom.comp_apply]
    exact (hc.map g'.continuous).trans hn
  have h'' : (g.hom ≫ (γ ≫ ι).toNormalization) (genericPoint C) ⤳
      wcNdPt W (γ ≫ ι) uX y₀ := by
    rw [← hg'1]; exact h'
  haveI : IsLocalHom ((γ ≫ ι).normalization.presheaf.stalkSpecializes hn).hom :=
    Hloc _ _ hn hg'3
  have hβloc : IsLocalHom (((γ ≫ ι).normalization.presheaf.stalkSpecializes hn ≫
      g'.stalkMap (wcNdPt W (γ ≫ ι) uX y₀)).hom) := by
    rw [CommRingCat.hom_comp]
    infer_instance
  have Hβ : ∀ a, ψ ((wcLr1uGerm (γ ≫ ι).toNormalization (wcNdPt W (γ ≫ ι) uX y₀) hc).hom a) =
      (wcLr1uGerm (γ ≫ ι).toNormalization (wcNdPt W (γ ≫ ι) uX y₀) hc).hom
        (((γ ≫ ι).normalization.presheaf.stalkSpecializes hn ≫
          g'.stalkMap (wcNdPt W (γ ≫ ι) uX y₀)).hom a) := by
    intro a
    have key := Hpre g.hom h₀ (γ ≫ ι).toNormalization _ hc h''
    rw [Hcongr _ _ hg'1.symm _ h'' h', Hpost _ g' _ hc h' hn] at key
    rw [hψ]
    exact congrArg (fun φ => φ.hom a) key
  have hDA' : wcNsrNaDom (A.comap ψ) (γ ≫ ι).toNormalization (wcNdPt W (γ ≫ ι) uX y₀) :=
    Htr _ _ _ hβloc (fun hy s => Hβ s) ⟨hc, e1, e2⟩

  have hAeq : A.comap ψ = A := hU _ hLA' hDA'

  have hfin : (C.presheaf.germ (g.hom ⁻¹ᵁ V) (genericPoint C) hV').hom ((g.hom.app V).hom t) =
      ψ ((C.presheaf.germ V (genericPoint C) hV).hom t) := by
    rw [hψ]
    exact (congrArg (fun φ => φ.hom t) (Hopen g.hom h₀ V hV hV')).symm
  rw [hfin, ValuationSubring.valuation_le_one_iff, ValuationSubring.valuation_le_one_iff,
    ← ValuationSubring.mem_comap (f := ψ), hAeq]

