    have hcoeff : q.coeff k = IsLocalRing.residue ↥W (θ 0 (a k)) := by
      simp only [q, Polynomial.finset_sum_coeff, Polynomial.coeff_C_mul_X_pow]
      rw [Finset.sum_eq_single k]
      · rw [if_pos rfl]
      · intro j _ hjk
        rw [if_neg (Ne.symm hjk)]
      · intro hk'
        exact absurd (Finset.mem_range.mpr (Nat.lt_succ_of_le hk)) hk'
    rw [hq0, Polynomial.coeff_zero, eq_comm, IsLocalRing.residue_eq_zero_iff] at hcoeff
    rw [← hθc 0]
