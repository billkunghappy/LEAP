    wcFrfCp_taylor Ω W hW hWt B (FractionRing B) 𝔮 t' x hPD hx a 1 h1 J
  refine ⟨∑ j ∈ Finset.range J, Polynomial.C (w j) * Polynomial.X ^ j, s, a', hs, ?_⟩
  have hE1 : (∑ j ∈ Finset.range J, Polynomial.C (w j) * Polynomial.X ^ j).eval₂
      (algebraMap ↥W B) (t' - algebraMap ↥W B x)
      = ∑ j ∈ Finset.range J, algebraMap ↥W B (w j) * (t' - algebraMap ↥W B x) ^ j := by
    rw [Polynomial.eval₂_finset_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
  rw [hE1]
  have hinj : Function.Injective (algebraMap B (FractionRing B)) :=
    IsFractionRing.injective B (FractionRing B)
  have hs0 : algebraMap B (FractionRing B) s ≠ 0 := by
    intro h
    apply hs
    have : s = 0 := hinj (by rw [h, map_zero])
    rw [this]; exact 𝔮.zero_mem
  apply hinj
  rw [map_one, div_one] at heq
  rw [map_mul, map_sub, map_mul, map_sum, heq]
  simp only [map_mul, map_pow]
  field_simp
  ring

theorem wcpa_dj_llsm_smpcgbtige_gauss_point : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] (M : Type u) [Field M] [Algebra B M] [IsFractionRing B M] (𝔮 : Ideal B) (t' : B), wcLlsPD W B 𝔮 (.disc t') → ∀ x γ : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → γ ∈ IsLocalRing.maximalIdeal ↥W → γ ≠ 0 → ∃ V : ValuationSubring M, (∀ b' : B, algebraMap B M b' ∈ V) ∧ (∀ b' : B, V.valuation (algebraMap B M b') < 1 ↔ b' ∈ 𝔮) ∧ ∀ p : Polynomial ↥W, (∃ i, p.coeff i ∉ IsLocalRing.maximalIdeal ↥W) → V.valuation (p.eval₂ ((algebraMap B M).comp (algebraMap ↥W B)) ((algebraMap B M t' - algebraMap B M (algebraMap ↥W B x)) / algebraMap B M (algebraMap ↥W B γ))) = 1 :=
