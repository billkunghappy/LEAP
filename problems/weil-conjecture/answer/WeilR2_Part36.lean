theorem wcpa_dj_lr1k_nsr_ubc_local_eqn : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X),
    wcpaDjLkModel W uX ι →
    ∀ p : ↥(Limits.pullback uX
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
      wcpaDjLkSmAt W uX p →
    ∀ σ₀ : Spec (.of ↥W) ⟶ X, σ₀ ≫ uX = 𝟙 _ →
      σ₀ (IsLocalRing.closedPoint ↥W) = Limits.pullback.fst uX
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) p →
    ∃ (U : X.Opens) (hU : IsAffineOpen U) (g : Γ(X, U)),
      Limits.pullback.fst uX
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) p ∈ U ∧
      (σ₀.app U).hom g = 0 ∧
      (∀ a : ↥W, (σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX a).ideal ⟨U, hU⟩ =
        Ideal.span {g, wcGcfStr uX U a}) ∧
      ∀ (η : ↥X) (hη : η ∈ U), η ⤳ Limits.pullback.fst uX
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) p →
        η ≠ Limits.pullback.fst uX
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) p →
        uX η = IsLocalRing.closedPoint ↥W →
        IsUnit ((X.presheaf.germ U η hη).hom g) :=
by
  classical

  have L5 : ∀ {A B : Type u} [CommRing A] [CommRing B] (θ : A →+* B) (φ : B →+* A) (g : A),
      (∀ b : B, θ (φ b) = b) → RingHom.ker θ = Ideal.span {g} → ∀ a : B,
      Ideal.comap θ (Ideal.span {a}) = Ideal.span {g, φ a} := by
    intro A B _ _ θ φ g hθφ hker a
    apply le_antisymm
    · intro y hy
      rw [Ideal.mem_comap, Ideal.mem_span_singleton'] at hy
      obtain ⟨w, hw⟩ := hy
      have h1 : y - φ w * φ a ∈ RingHom.ker θ := by
        rw [RingHom.mem_ker, map_sub, map_mul, hθφ, hθφ, hw, sub_self]
      rw [hker, Ideal.mem_span_singleton'] at h1
      obtain ⟨c, hc⟩ := h1
      rw [Ideal.mem_span_pair]
      exact ⟨c, φ w, by rw [hc]; ring⟩
    · rw [Ideal.span_le]
      intro z hz
      rcases hz with rfl | rfl
      · have hz : z ∈ RingHom.ker θ := by rw [hker]; exact Ideal.mem_span_singleton_self z
        rw [RingHom.mem_ker] at hz
        show θ z ∈ Ideal.span {a}
        rw [hz]; exact Ideal.zero_mem _
      · show θ (φ a) ∈ Ideal.span {a}
        rw [hθφ]; exact Ideal.mem_span_singleton_self a

  have L2 : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
      (P : PrimeSpectrum (MvPolynomial (Fin 1) R)), MvPolynomial.X 0 ∈ P.asIdeal →
      PrimeSpectrum.comap MvPolynomial.C P = IsLocalRing.closedPoint R →
      P = PrimeSpectrum.comap (MvPolynomial.eval (fun _ : Fin 1 => (0 : R)))
        (IsLocalRing.closedPoint R) := by
    intro R _ _ P hX hC
    set ε := MvPolynomial.eval (fun _ : Fin 1 => (0 : R)) with hε
    have hsub : ∀ f : MvPolynomial (Fin 1) R,
        f - MvPolynomial.C (ε f) ∈ Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) R)} := by
      intro f
      induction f using MvPolynomial.induction_on with
      | C a => simp [ε]
      | add p q hp hq =>
        have e : p + q - MvPolynomial.C (ε (p + q)) =
            (p - MvPolynomial.C (ε p)) + (q - MvPolynomial.C (ε q)) := by
          rw [map_add, map_add]; ring
        rw [e]; exact add_mem hp hq
      | mul_X p n _ =>
        have hn : n = 0 := Subsingleton.elim _ _
        subst hn
        have e : ε (p * MvPolynomial.X 0) = 0 := by simp [ε]
        rw [e, map_zero, sub_zero]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    have hspan : Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) R)} ≤ P.asIdeal := by
      rw [Ideal.span_le, Set.singleton_subset_iff]; exact hX
    have hCm : ∀ r : R, MvPolynomial.C r ∈ P.asIdeal ↔ r ∈ IsLocalRing.maximalIdeal R := by
      intro r
      have := congrArg PrimeSpectrum.asIdeal hC
      rw [PrimeSpectrum.comap_asIdeal] at this
      rw [← Ideal.mem_comap, this]
      rfl
    ext f
    rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
    show f ∈ P.asIdeal ↔ ε f ∈ IsLocalRing.maximalIdeal R
    rw [← hCm]
    constructor
    · intro hf
      have := P.asIdeal.sub_mem hf (hspan (hsub f))
      rwa [sub_sub_cancel] at this
    · intro hf
      have := P.asIdeal.add_mem (hspan (hsub f)) hf
      rwa [sub_add_cancel] at this

  have L1 : ∀ {Y Z : Scheme.{u}} (m : Y ⟶ Z), Etale m → ∀ (y₁ y₂ : ↥Y), y₁ ⤳ y₂ →
      m y₁ = m y₂ → y₁ = y₂ := by
    intro Y Z m hm y₁ y₂ h he
    obtain ⟨V, hV, hyV, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens)
      (show m y₂ ∈ (⊤ : Z.Opens) from trivial)
    obtain ⟨V', hV', hyV', hV'le⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      Y.isBasis_affineOpens) (show y₂ ∈ m ⁻¹ᵁ V from hyV)
    have hy1 : y₁ ∈ V' := h.mem_open V'.isOpen hyV'
    have hφ := HasRingHomProperty.appLE @Etale m hm ⟨V, hV⟩ ⟨V', hV'⟩ hV'le
    letI := (m.appLE V V' hV'le).hom.toAlgebra
    haveI : Algebra.Etale Γ(Z, V) Γ(Y, V') := RingHom.Etale.toAlgebra hφ
    haveI : Algebra.QuasiFinite Γ(Z, V) Γ(Y, V') := inferInstance
    have hVa : IsAffineOpen V := hV
    have hV'a : IsAffineOpen V' := hV'
    haveI := hVa.isOpenImmersion_fromSpec
    haveI := hV'a.isOpenImmersion_fromSpec
    obtain ⟨q₁, hq₁⟩ : y₁ ∈ Set.range hV'a.fromSpec := by rw [hV'a.range_fromSpec]; exact hy1
    obtain ⟨q₂, hq₂⟩ : y₂ ∈ Set.range hV'a.fromSpec := by rw [hV'a.range_fromSpec]; exact hyV'
    have hsp : q₁ ⤳ q₂ := by
      rw [← hV'a.fromSpec.isOpenEmbedding.isInducing.specializes_iff, hq₁, hq₂]; exact h
    have hsq := IsAffineOpen.SpecMap_appLE_fromSpec m hVa hV'a hV'le
    have key : ∀ q, hVa.fromSpec (Spec.map (m.appLE V V' hV'le) q) = m (hV'a.fromSpec q) := by
      intro q
      rw [← Scheme.Hom.comp_apply, hsq, Scheme.Hom.comp_apply]
    have himg : Spec.map (m.appLE V V' hV'le) q₁ = Spec.map (m.appLE V V' hV'le) q₂ := by
      apply hVa.fromSpec.isOpenEmbedding.injective
      rw [key, key, hq₁, hq₂, he]
    have hD := Algebra.QuasiFinite.isDiscrete_comap_preimage_singleton (R := Γ(Z, V))
      (S := Γ(Y, V')) (PrimeSpectrum.comap (m.appLE V V' hV'le).hom q₂)
    haveI := hD.to_subtype
    have hm₁ : q₁ ∈ PrimeSpectrum.comap (algebraMap Γ(Z, V) Γ(Y, V')) ⁻¹'
        {PrimeSpectrum.comap (m.appLE V V' hV'le).hom q₂} := himg
    have hm₂ : q₂ ∈ PrimeSpectrum.comap (algebraMap Γ(Z, V) Γ(Y, V')) ⁻¹'
        {PrimeSpectrum.comap (m.appLE V V' hV'le).hom q₂} := rfl
    have hsp' : (⟨q₁, hm₁⟩ : ↥(PrimeSpectrum.comap (algebraMap Γ(Z, V) Γ(Y, V')) ⁻¹'
