    have e : A'' = A := hcmp V A'' A b b' hbm hbd hbn hbm' hbd' hbn' hA'' hA hSV hS'
    rw [e] at hqA''
    exact ⟨b, hbm, hbd, hbn, Xb, rb, ιb, inferInstance, inferInstance, hblb, hιb, hMb, q, hqV',
      hqA''⟩

theorem wcpa_dj_lr1k_nsr_gub_affinoid_model : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1),
      wcpaDjLkCov Ω γ →
    ∀ (X' : Scheme.{u}) (u' : X' ⟶ Spec (.of ↥W)) (ι' : wcProjK Ω 1 ⟶ X')
      [QuasiCompact (γ ≫ ι')] [QuasiSeparated (γ ≫ ι')],
      wcpaDjLkModel W u' ι' →
    ∀ (n : ↥(γ ≫ ι').normalization) (f : Fin 2 → ((γ ≫ ι').normalization).presheaf.stalk n),
      wcTcRad W ((γ ≫ ι').fromNormalization ≫ u') n f →
      (∃ V : ValuationSubring C.functionField, wcUbRigid W (γ ≫ wcProjKStr Ω 1) V ∧
        wcNsrCentred (γ ≫ ι').toNormalization n V) →
    ∃ (A : Type u) (_ : CommRing A) (_ : Algebra ↥W A) (ϖ : ↥W) (𝔪 : Ideal A) (g : Fin 2 → A)
      (φ : A →+* ((γ ≫ ι').normalization).presheaf.stalk n),
      wcGubAdm W A ϖ 𝔪 g ∧ wcGubChart W ((γ ≫ ι').fromNormalization ≫ u') n f A 𝔪 g φ :=
by
  intro Ω _ _ W hW hWt C _ γ hcov X' u' ι' _ _ hM n f hRad hV
  classical

  have wcpa_dj_lr1k_nsr_gam_function_field_trdeg : ∀ (C : Scheme.{u})
      [AlgebraicGeometry.IsIntegral C] (s : C ⟶ Spec (.of Ω)), SmoothOfRelativeDimension 1 s →
      (letI : Algebra Ω C.functionField := (wcLr1uConst s).toAlgebra;
        Algebra.trdeg Ω C.functionField ≤ 1) := by
    intro C _ s hsm
    obtain ⟨U, -, V, hV, hηV, e, hstd⟩ :=
      (smoothOfRelativeDimension_iff 1 s).mp hsm (genericPoint C)
    haveI : Nonempty (V : C.Opens) := ⟨⟨_, hηV⟩⟩
    have hUtop : U = ⊤ := by
      rw [eq_top_iff]
      intro x _
      have hx : x = s (genericPoint C) := Subsingleton.elim _ _
      rw [hx]
      exact e hηV
    subst hUtop
    set φ : Ω →+* Γ(C, V) := ((Scheme.ΓSpecIso (.of Ω)).inv ≫ s.appLE ⊤ V e).hom with hφ
    have hstd' : RingHom.IsStandardSmoothOfRelativeDimension 1 φ := by
      have h0 : RingHom.IsStandardSmoothOfRelativeDimension 0
          ((Scheme.ΓSpecIso (.of Ω)).inv).hom := by
        letI := ((Scheme.ΓSpecIso (.of Ω)).inv).hom.toAlgebra
        exact (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 0).mpr
          (Algebra.IsStandardSmoothOfRelativeDimension.of_algebraMap_bijective
            (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of Ω)).inv))
      have := hstd.comp h0
      rw [hφ, CommRingCat.hom_comp]
      exact this
    letI algV : Algebra Ω Γ(C, V) := φ.toAlgebra
    haveI : Algebra.IsStandardSmoothOfRelativeDimension 1 Ω Γ(C, V) :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mp hstd'
    have htrV : Algebra.trdeg Ω Γ(C, V) = 1 := by
      have := wcpa_sde_trdeg_standard_smooth Ω Γ(C, V) 1
      simpa using this
    letI : Algebra Ω C.functionField := (wcLr1uConst s).toAlgebra
    haveI : IsFractionRing Γ(C, V) C.functionField :=
      functionField_isFractionRing_of_isAffineOpen C V hV
    haveI : IsScalarTower Ω Γ(C, V) C.functionField := by
      refine IsScalarTower.of_algebraMap_eq fun a => ?_
      show wcLr1uConst s a = algebraMap Γ(C, V) C.functionField (φ a)
      show _ = (C.presheaf.germ V (genericPoint C) hηV).hom
        ((s.appLE ⊤ V e).hom ((Scheme.ΓSpecIso (.of Ω)).inv.hom a))
      rw [Scheme.Hom.appLE, CommRingCat.hom_comp, RingHom.comp_apply,
        TopCat.Presheaf.germ_res_apply]
      rfl
    haveI : FaithfulSMul Ω Γ(C, V) :=
      (faithfulSMul_iff_algebraMap_injective Ω Γ(C, V)).mpr φ.injective
    haveI : FaithfulSMul Γ(C, V) C.functionField :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr (IsFractionRing.injective _ _)
    haveI : Algebra.IsAlgebraic Γ(C, V) C.functionField :=
      IsLocalization.isAlgebraic _ (nonZeroDivisors Γ(C, V))
    have hadd := lift_trdeg_add_eq Ω Γ(C, V) C.functionField
    rw [Cardinal.lift_id, Cardinal.lift_id, Cardinal.lift_id, htrV,
      trdeg_eq_zero (R := Γ(C, V)) (A := C.functionField), add_zero] at hadd
    rw [← hadd]
  obtain ⟨V, hVr, hVc⟩ := hV
  obtain ⟨hRad1, hRad2⟩ := hRad

  have wcpa_dj_lr1k_nsr_gam_residue_maximal : ∀ (R A B : Type u) [CommRing R] [IsLocalRing R]
      [CommRing A] [Algebra R A] [CommRing B] [IsLocalRing B] (φ : A →+* B),
      (∀ w ∈ IsLocalRing.maximalIdeal R, φ (algebraMap R A w) ∈ IsLocalRing.maximalIdeal B) →
      (∀ a : A, ∃ c : R, φ a - φ (algebraMap R A c) ∈ IsLocalRing.maximalIdeal B) →
      (Ideal.comap φ (IsLocalRing.maximalIdeal B)).IsMaximal := by
    intro R A B _ _ _ _ _ _ φ h1 h2
    rw [Ideal.isMaximal_iff]
    refine ⟨fun h => ?_, ?_⟩
    · rw [Ideal.mem_comap, map_one] at h
      exact IsLocalRing.notMem_maximalIdeal.mpr isUnit_one h
    · intro J x hle hx hxJ
      obtain ⟨c, hc⟩ := h2 x
      have hcm : c ∉ IsLocalRing.maximalIdeal R := by
        intro hcm
        apply hx
        rw [Ideal.mem_comap]
        have := Ideal.add_mem _ hc (h1 c hcm)
        simpa using this
      obtain ⟨d, hd⟩ := (IsLocalRing.notMem_maximalIdeal.mp hcm).exists_left_inv
      have hxc : x - algebraMap R A c ∈ J := hle (by rw [Ideal.mem_comap, map_sub]; exact hc)
      have e1 : (1 : A) = algebraMap R A d * x - algebraMap R A d * (x - algebraMap R A c) := by
        rw [mul_sub, sub_sub_cancel, ← map_mul, hd, map_one]
      rw [e1]
      exact J.sub_mem (J.mul_mem_left _ hxJ) (J.mul_mem_left _ hxc)

  have wcpa_dj_lr1k_nsr_gam_away_transfer : ∀ (R A₂ B : Type u) [CommRing R] [CommRing A₂]
      [Algebra R A₂] [IsDomain A₂] [IsIntegrallyClosed A₂] [Algebra.FinitePresentation R A₂]
      [CommRing B] [IsLocalRing B] (φ₂ : A₂ →+* B) (e : A₂), Function.Injective φ₂ →
      φ₂ e ∉ IsLocalRing.maximalIdeal B →
      Algebra.FinitePresentation R (Localization.Away e) ∧ IsDomain (Localization.Away e) ∧
      IsIntegrallyClosed (Localization.Away e) ∧
      ∃ φ : Localization.Away e →+* B, Function.Injective φ ∧
        φ.comp (algebraMap A₂ (Localization.Away e)) = φ₂ := by
    intro R A₂ B _ _ _ _ _ _ _ _ φ₂ e hinj he
    have he0 : e ≠ 0 := by
      rintro rfl
      rw [map_zero] at he
      exact he (Ideal.zero_mem _)
    have hpow : Submonoid.powers e ≤ nonZeroDivisors A₂ :=
      powers_le_nonZeroDivisors_of_noZeroDivisors he0
    haveI : Algebra.FinitePresentation A₂ (Localization.Away e) :=
      IsLocalization.Away.finitePresentation e
    haveI : IsDomain (Localization.Away e) := IsLocalization.isDomain_localization hpow
    refine ⟨Algebra.FinitePresentation.trans R A₂ _, inferInstance,
      isIntegrallyClosed_of_isLocalization _ _ hpow, ?_⟩
    have hu : IsUnit (φ₂ e) := IsLocalRing.notMem_maximalIdeal.mp he
    refine ⟨IsLocalization.Away.lift e hu, ?_,
      RingHom.ext fun a => IsLocalization.Away.lift_eq e hu a⟩
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers e) z
    have hspec := IsLocalization.mk'_spec (Localization.Away e) a s
    have h1 := congrArg (IsLocalization.Away.lift e hu) hspec
    rw [map_mul, hz, zero_mul, IsLocalization.Away.lift_eq] at h1
    have ha : a = 0 := hinj (by rw [← h1, map_zero])
    rw [ha]
    exact IsLocalization.mk'_zero _

  have wcpa_dj_lr1k_nsr_gam_n1 : ∀ (A : Type u) [CommRing A] [IsDomain A]
      [IsIntegrallyClosed A] [Algebra ↥W A],
      (∀ (w : ↥W) (a : A), w ≠ 0 → algebraMap ↥W A w * a = 0 → a = 0) →
      ∀ (a : A) (j : ℕ), a ^ j ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
        a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
    intro A _ _ _ _ htf a j ha
    have rep : ∀ x ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A),
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, ∃ b : A, x = algebraMap ↥W A w * b := by
      intro x hx
      have hx' : x ∈ Submodule.span A (algebraMap ↥W A '' (IsLocalRing.maximalIdeal ↥W)) := hx
      clear hx
      induction hx' using Submodule.span_induction with
      | mem y hy =>
        obtain ⟨w, hw, rfl⟩ := hy
        exact ⟨w, hw, 1, (mul_one _).symm⟩
      | zero => exact ⟨0, Ideal.zero_mem _, 0, (mul_zero _).symm⟩
      | add y z _ _ hy hz =>
        obtain ⟨w₁, hw₁, b₁, rfl⟩ := hy
        obtain ⟨w₂, hw₂, b₂, rfl⟩ := hz
        rcases ValuationRing.dvd_total w₁ w₂ with ⟨r, rfl⟩ | ⟨r, rfl⟩
        · exact ⟨w₁, hw₁, b₁ + algebraMap ↥W A r * b₂, by rw [map_mul]; ring⟩
        · exact ⟨w₂, hw₂, algebraMap ↥W A r * b₁ + b₂, by rw [map_mul]; ring⟩
      | smul r y _ hy =>
        obtain ⟨w, hw, b, rfl⟩ := hy
        exact ⟨w, hw, r * b, by rw [smul_eq_mul]; ring⟩
    rcases Nat.eq_zero_or_pos j with hj | hj
    · subst hj
      rw [pow_zero] at ha
      simpa using Ideal.mul_mem_left _ a ha
    obtain ⟨w, hw, b, hwb⟩ := rep _ ha
    by_cases hw0 : w = 0
    · rw [hw0, map_zero, zero_mul, pow_eq_zero_iff hj.ne'] at hwb
      rw [hwb]
      exact Ideal.zero_mem _
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (w : Ω) hj
    have hz0 : z ≠ 0 := by
      rintro rfl
      rw [zero_pow hj.ne'] at hz
      exact hw0 (Subtype.ext hz.symm)
    have hzW : z ∈ W := by
      rcases W.mem_or_inv_mem z with h | h
      · exact h
      · have hzz : z = (w : Ω) * z⁻¹ ^ (j - 1) := by
          rw [← hz, inv_pow, ← div_eq_mul_inv, eq_div_iff (pow_ne_zero _ hz0), ← pow_succ']
          congr 1
          omega
        rw [hzz]
        exact mul_mem w.2 (pow_mem h _)
    have hγ : (⟨z, hzW⟩ : ↥W) ^ j = w := Subtype.ext (by simp [hz])
    have hγm : (⟨z, hzW⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
      by_contra hγm
      have hu : IsUnit (⟨z, hzW⟩ : ↥W) := IsLocalRing.notMem_maximalIdeal.mp hγm
      exact (IsLocalRing.mem_maximalIdeal _).mp hw (hγ ▸ hu.pow j)
    have hc0 : algebraMap ↥W A ⟨z, hzW⟩ ≠ 0 := by
      intro h0
      have hne : (⟨z, hzW⟩ : ↥W) ≠ 0 := fun h => hz0 (congrArg Subtype.val h)
      exact one_ne_zero (htf _ 1 hne (by rw [mul_one]; exact h0))
    have hcK : algebraMap A (FractionRing A) (algebraMap ↥W A ⟨z, hzW⟩) ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective A (FractionRing A))).mpr hc0
    have hτ : (algebraMap A (FractionRing A) a / algebraMap A (FractionRing A)
        (algebraMap ↥W A ⟨z, hzW⟩)) ^ j = algebraMap A (FractionRing A) b := by
      rw [div_pow, div_eq_iff (pow_ne_zero _ hcK), ← map_pow, ← map_pow, ← map_mul]
      congr 1
      rw [hwb, ← hγ, map_pow, mul_comm]
    have hint : IsIntegral A (algebraMap A (FractionRing A) a / algebraMap A (FractionRing A)
        (algebraMap ↥W A ⟨z, hzW⟩)) := by
      refine ⟨Polynomial.X ^ j - Polynomial.C b, Polynomial.monic_X_pow_sub_C b hj.ne', ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hτ, sub_self]
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    have hay : a = algebraMap ↥W A ⟨z, hzW⟩ * y := by
      apply IsFractionRing.injective A (FractionRing A)
      rw [map_mul, hy, mul_div_assoc', mul_div_cancel_left₀ _ hcK]
    rw [hay]
    exact Ideal.mul_mem_right y _ (Ideal.mem_map_of_mem _ hγm)

  have wcpa_dj_lr1k_nsr_gam_isolate : ∀ (R A₂ B : Type u) [CommRing R] [IsLocalRing R]
      [CommRing A₂] [Algebra R A₂] [Algebra.FiniteType R A₂] [CommRing B] [IsLocalRing B]
      (φ₂ : A₂ →+* B) (g : Fin 2 → A₂) (ϖ : R), Function.Injective φ₂ →
      (Ideal.comap φ₂ (IsLocalRing.maximalIdeal B)).IsMaximal →
      (∀ s : B, ∃ a b : A₂, φ₂ b ∉ IsLocalRing.maximalIdeal B ∧ φ₂ b * s = φ₂ a) →
      (∀ w ∈ IsLocalRing.maximalIdeal R, φ₂ (algebraMap R A₂ w) ∈ IsLocalRing.maximalIdeal B) →
      (∀ i, φ₂ (g i) ∈ IsLocalRing.maximalIdeal B) → ϖ ∈ IsLocalRing.maximalIdeal R →
      (∀ y ∈ IsLocalRing.maximalIdeal B, ∃ k : ℕ,
        y ^ k ∈ Ideal.span {φ₂ (g 0), φ₂ (g 1), φ₂ (algebraMap R A₂ ϖ)}) →
      ∃ e : A₂, φ₂ e ∉ IsLocalRing.maximalIdeal B ∧ ∀ P : Ideal A₂, P.IsPrime →
        Ideal.span (Set.range g) ⊔ (IsLocalRing.maximalIdeal R).map (algebraMap R A₂) ≤ P →
        e ∉ P → P = Ideal.comap φ₂ (IsLocalRing.maximalIdeal B) := by
    intro R A₂ B _ _ _ _ _ _ _ φ₂ g ϖ hinj hmax hloc hR hg hϖ hrad
    set M := Ideal.comap φ₂ (IsLocalRing.maximalIdeal B) with hMdef
    set J := Ideal.span (Set.range g) ⊔ (IsLocalRing.maximalIdeal R).map (algebraMap R A₂)
      with hJdef
    haveI hMp : M.IsPrime := hmax.isPrime
    have hg0 : g 0 ∈ J := Ideal.mem_sup_left (Ideal.subset_span ⟨0, rfl⟩)
    have hg1 : g 1 ∈ J := Ideal.mem_sup_left (Ideal.subset_span ⟨1, rfl⟩)
    have hϖJ : algebraMap R A₂ ϖ ∈ J := Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hϖ)

    have step1 : ∀ P : Ideal A₂, P.IsPrime → J ≤ P → P ≤ M → P = M := by
      intro P hP hJP hPM
      refine le_antisymm hPM (fun x hx => ?_)
      obtain ⟨k, hk⟩ := hrad (φ₂ x) hx
      obtain ⟨β₀, z, hz, hk'⟩ := Ideal.mem_span_insert.mp hk
      obtain ⟨β₁, z', hz', hz2⟩ := Ideal.mem_span_insert.mp hz
      obtain ⟨β₂, hβ₂⟩ := Ideal.mem_span_singleton'.mp hz'
      obtain ⟨a₀, d₀, hd₀, he₀⟩ := hloc β₀
      obtain ⟨a₁, d₁, hd₁, he₁⟩ := hloc β₁
      obtain ⟨a₂, d₂, hd₂, he₂⟩ := hloc β₂
      have key : d₀ * d₁ * d₂ * x ^ k = a₀ * d₁ * d₂ * g 0 + d₀ * a₁ * d₂ * g 1 +
          d₀ * d₁ * a₂ * algebraMap R A₂ ϖ := by
        apply hinj
        simp only [map_mul, map_add, map_pow]
        rw [hk', hz2, ← hβ₂, ← he₀, ← he₁, ← he₂]
        ring
      have hmem : d₀ * d₁ * d₂ * x ^ k ∈ P := by
        rw [key]
        exact P.add_mem (P.add_mem (P.mul_mem_left _ (hJP hg0)) (P.mul_mem_left _ (hJP hg1)))
          (P.mul_mem_left _ (hJP hϖJ))
      have hD : d₀ * d₁ * d₂ ∉ P := by
        intro hD
        rcases hMp.mem_or_mem (hPM hD) with h | h
        · rcases hMp.mem_or_mem h with h | h
          · exact hd₀ h
          · exact hd₁ h
        · exact hd₂ h
      exact hP.mem_of_pow_mem k ((hP.mem_or_mem hmem).resolve_left hD)

    have hmJ : IsLocalRing.maximalIdeal R ≤ Ideal.comap (algebraMap R A₂) J := by
      rw [← Ideal.map_le_iff_le_comap]
      exact le_sup_right
    letI : Field (R ⧸ IsLocalRing.maximalIdeal R) := Ideal.Quotient.field _
    letI : Algebra (R ⧸ IsLocalRing.maximalIdeal R) (A₂ ⧸ J) :=
      Ideal.Quotient.algebraQuotientOfLEComap hmJ
    haveI : IsScalarTower R (R ⧸ IsLocalRing.maximalIdeal R) (A₂ ⧸ J) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : Algebra.FiniteType R (A₂ ⧸ J) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ R J)
        (Ideal.Quotient.mkₐ_surjective R J)
    haveI : Algebra.FiniteType (R ⧸ IsLocalRing.maximalIdeal R) (A₂ ⧸ J) :=
      Algebra.FiniteType.of_restrictScalars_finiteType R _ _
    haveI : IsNoetherianRing (A₂ ⧸ J) :=
      Algebra.FiniteType.isNoetherianRing (R ⧸ IsLocalRing.maximalIdeal R) _

    have hfin : J.minimalPrimes.Finite := by
      rw [Ideal.minimalPrimes_eq_comap]
      exact (minimalPrimes.finite_of_isNoetherianRing (A₂ ⧸ J)).image _
    set S' := hfin.toFinset.filter (fun Q => Q ≠ M) with hS'
    have hex : ∀ Q, Q ∈ S' → ∃ y : A₂, y ∈ Q ∧ y ∉ M := by
      intro Q hQ
      obtain ⟨hQmin, hQM⟩ := Finset.mem_filter.mp hQ
      have hQmin' := hfin.mem_toFinset.mp hQmin
      by_contra hcon
      push Not at hcon
      exact hQM (step1 Q hQmin'.1.1 hQmin'.1.2 hcon)
    choose! ε hεQ hεM using hex
    refine ⟨∏ Q ∈ S', ε Q, ?_, ?_⟩
    · intro he
      obtain ⟨Q, hQ, hQM⟩ := (Ideal.IsPrime.prod_mem_iff (p := M)).mp he
      exact hεM Q hQ hQM
    · intro P hP hJP heP
      haveI := hP
      obtain ⟨Q, hQ, hQP⟩ := Ideal.exists_minimalPrimes_le hJP
      by_cases hQM : Q = M
      · rw [hQM] at hQP
        exact (hmax.eq_of_le hP.ne_top hQP).symm
      · exfalso
        apply heP
        exact (Ideal.IsPrime.prod_mem_iff (p := P)).mpr
          ⟨Q, Finset.mem_filter.mpr ⟨hfin.mem_toFinset.mpr hQ, hQM⟩,
            hQP (hεQ Q (Finset.mem_filter.mpr ⟨hfin.mem_toFinset.mpr hQ, hQM⟩))⟩
  have hpb : IsPullback ι' (wcProjKStr Ω 1) u'
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) := hM.2.2
  set σn : ↥W →+* ((γ ≫ ι').normalization).presheaf.stalk n :=
    ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ ((γ ≫ ι').fromNormalization ≫ u').appTop ≫
      ((γ ≫ ι').normalization).presheaf.germ ⊤ n trivial).hom with hσn

  obtain ⟨x, hx⟩ : ∃ x : Ω, x ∉ W := by
    by_contra hcon
    push Not at hcon
    exact hWt (eq_top_iff.mpr fun y _ => hcon y)
  have hx0 : x ≠ 0 := fun h0 => hx (h0 ▸ W.zero_mem)
  have hxi : x⁻¹ ∈ W := (W.mem_or_inv_mem x).resolve_left hx
  set ϖ : ↥W := ⟨x⁻¹, hxi⟩ with hϖdef
  have hϖ0 : ϖ ≠ 0 := by
    intro h0
    have h1 : x⁻¹ = 0 := congrArg Subtype.val h0
    exact hx0 (inv_eq_zero.mp h1)
  have hϖm : ϖ ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    obtain ⟨b, hb⟩ := hu.exists_right_inv
    have h1 : x⁻¹ * (b : Ω) = 1 := congrArg Subtype.val hb
    have h2 : (b : Ω) = x := by rw [eq_inv_of_mul_eq_one_right h1, inv_inv]
    exact hx (h2 ▸ b.2)

  obtain ⟨h, hDom⟩ := hVc
  have keyc : ∀ (R S : CommRingCat.{u}) (φ : R ⟶ S) (C N : Scheme.{u}) [IsIntegral C]
      (t : C ⟶ N) (s : N ⟶ Spec R) (q : C ⟶ Spec S), t ≫ s = q ≫ Spec.map φ →
      ∀ (n : N) (h : t (genericPoint C) ⤳ n) (r : R),
