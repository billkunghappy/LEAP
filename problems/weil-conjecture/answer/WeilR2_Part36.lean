  obtain ⟨X₁, r₁, hbl, ⟨ι₁, hι₁, hM₁⟩, -⟩ :=
    wcpa_dj_lr1k_imp_blowup_model Ω W hW hWt X uX ι hM σ hP.1 (wcpaDjLkPi W (γ ≫ ι) uX y₀)
      hP.2.1.symm hSm a hP.2.2.1 hP.2.2.2

  obtain ⟨σ₁, hσ₁⟩ := wcpa_dj_lr1k_nsr_nlb_er_lift Ω W hW X uX ι hM _ τ hτ σ a σ' a' hP hP'
    hle' X₁ r₁ hbl

  obtain ⟨hy, hle1, hlt1⟩ := hA σ a σ' a' hP hP' hEx hEx' hle' hnot X₁ r₁ ι₁ hbl hι₁ hM₁ σ₁ hσ₁
  have E1 : (γ ≫ ι₁) ≫ (r₁ ≫ uX) =
      γ ≫ wcProjKStr Ω 1 ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) := by
