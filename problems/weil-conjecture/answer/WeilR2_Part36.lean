      have := (mul_eq_zero.mp h1.symm).resolve_left hπ
      exact (sub_eq_zero.mp this).symm
    have dec : ∀ x : R, ∃ w : W, ∃ y : R, x = σ₀ w + π * y := by
      intro x
      obtain ⟨w, hw⟩ := hres x
      obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp hw
      exact ⟨w, y, by linear_combination -hy⟩
    choose wf yf hf using dec
    have key : ∀ x w y, x = σ₀ w + π * y → yf x = y := fun x w y h =>
      uniq _ _ _ _ ((hf x).symm.trans h)
    have hmkπ : Ideal.Quotient.mk (Ideal.span {π}) π = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self π)
    have hmkx : ∀ x, Ideal.Quotient.mk (Ideal.span {π}) x =
        Ideal.Quotient.mk (Ideal.span {π}) (σ₀ (wf x)) := by
      intro x
      have e := congrArg (Ideal.Quotient.mk (Ideal.span {π})) (hf x)
      rw [e, map_add, map_mul, hmkπ, zero_mul, add_zero]
    refine ⟨AddMonoidHom.mk' (fun x => Ideal.Quotient.mk (Ideal.span {π}) (yf x)) ?_, ?_, ?_, ?_⟩
    · intro x x'
      show Ideal.Quotient.mk (Ideal.span {π}) (yf (x + x')) =
        Ideal.Quotient.mk (Ideal.span {π}) (yf x) + Ideal.Quotient.mk (Ideal.span {π}) (yf x')
      rw [key (x + x') (wf x + wf x') (yf x + yf x')
        (by rw [map_add]; linear_combination hf x + hf x'), map_add]
    · intro x x'
      show Ideal.Quotient.mk (Ideal.span {π}) (yf (x * x')) =
        Ideal.Quotient.mk (Ideal.span {π}) x * Ideal.Quotient.mk (Ideal.span {π}) (yf x') +
        Ideal.Quotient.mk (Ideal.span {π}) x' * Ideal.Quotient.mk (Ideal.span {π}) (yf x)
      rw [key (x * x') (wf x * wf x') (σ₀ (wf x) * yf x' + σ₀ (wf x') * yf x + π * yf x * yf x')
        (by rw [map_mul]; linear_combination (hf x) * x' + (σ₀ (wf x) + π * yf x) * hf x')]
      rw [hmkx x, hmkx x']
      simp only [map_add, map_mul, hmkπ]
      ring
    · intro w
      show Ideal.Quotient.mk (Ideal.span {π}) (yf (σ₀ w)) = 0
      rw [key (σ₀ w) w 0 (by ring), map_zero]
    · show Ideal.Quotient.mk (Ideal.span {π}) (yf π) = 1
      rw [key π 0 1 (by rw [map_zero]; ring), map_one]
  have s2 : ∀ (W B : Type u) [CommRing W] [IsLocalRing W] [CommRing B] [Algebra W B]
      (Q : Ideal B) [Q.IsPrime],
      Ideal.map (algebraMap W B) (IsLocalRing.maximalIdeal W) ≤ Q →
      (∀ x : B, ∃ w : W, x - algebraMap W B w ∈ Q) →
      ∀ y : Localization.AtPrime Q, ∃ w : W, y - algebraMap B (Localization.AtPrime Q)
        (algebraMap W B w) ∈ IsLocalRing.maximalIdeal (Localization.AtPrime Q) := by
    intro W B _ _ _ _ Q _ hI hres y
    obtain ⟨⟨c, s⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl y
    obtain ⟨w₁, hw₁⟩ := hres c
    obtain ⟨w₂, hw₂⟩ := hres (s : B)
    have hu : IsUnit w₂ := by
      by_contra h
      have hm : w₂ ∈ IsLocalRing.maximalIdeal W := (IsLocalRing.mem_maximalIdeal _).mpr h
      have h3 : algebraMap W B w₂ ∈ Q := hI (Ideal.mem_map_of_mem _ hm)
      have h4 := Q.add_mem hw₂ h3
      rw [sub_add_cancel] at h4
      exact s.2 h4
    obtain ⟨u, rfl⟩ := hu
    refine ⟨w₁ * ((u⁻¹ : Wˣ) : W), ?_⟩
    have hs : IsUnit (algebraMap B (Localization.AtPrime Q) s) :=
      IsLocalization.map_units (Localization.AtPrime Q) s
    have hdiff : c - algebraMap W B (w₁ * ((u⁻¹ : Wˣ) : W)) * s ∈ Q := by
      have hh : algebraMap W B (w₁ * ((u⁻¹ : Wˣ) : W)) * algebraMap W B (u : W) =
          algebraMap W B w₁ := by
        rw [← map_mul, mul_assoc, Units.inv_mul, mul_one]
      have e : c - algebraMap W B (w₁ * ((u⁻¹ : Wˣ) : W)) * s = (c - algebraMap W B w₁) -
          algebraMap W B (w₁ * ((u⁻¹ : Wˣ) : W)) * (s - algebraMap W B (u : W)) := by
        linear_combination -hh
      rw [e]
      exact Q.sub_mem hw₁ (Q.mul_mem_left _ hw₂)
    have h2 : (IsLocalization.mk' (Localization.AtPrime Q) c s -
        algebraMap B (Localization.AtPrime Q) (algebraMap W B (w₁ * ((u⁻¹ : Wˣ) : W)))) *
        algebraMap B (Localization.AtPrime Q) s =
        algebraMap B (Localization.AtPrime Q) (c - algebraMap W B (w₁ * ((u⁻¹ : Wˣ) : W)) * s) := by
      rw [sub_mul, IsLocalization.mk'_spec, ← map_mul, ← map_sub]
    rw [← Ideal.mul_unit_mem_iff_mem _ hs, h2]
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q) Q _).mpr hdiff
  have s3 : ∀ (W R : Type u) [CommRing W] [IsLocalRing W] [CommRing R] [IsLocalRing R]
      (σ : W →+* R) (J : Ideal R) (t : R),
      J ≤ IsLocalRing.maximalIdeal R → (∀ w ∈ IsLocalRing.maximalIdeal W, σ w ∈ J) →
      (∀ y : R, ∃ w : W, y - σ w ∈ IsLocalRing.maximalIdeal R) →
      ¬ IsUnit (Ideal.Quotient.mk J t) →
      (∀ x : R ⧸ J, ¬ IsUnit x → Ideal.Quotient.mk J t ∣ x) →
      (Ideal.span {Ideal.Quotient.mk J t}).IsMaximal ∧
      (∀ z : R, Ideal.Quotient.mk J z ∈ Ideal.span {Ideal.Quotient.mk J t} ↔
        z ∈ IsLocalRing.maximalIdeal R) ∧
      (∀ x : R ⧸ J, ∃ w : W, x - Ideal.Quotient.mk J (σ w) ∈ Ideal.span {Ideal.Quotient.mk J t}) ∧
      (∀ w : W, Ideal.Quotient.mk J (σ w) ∈ Ideal.span {Ideal.Quotient.mk J t} →
        Ideal.Quotient.mk J (σ w) = 0) := by
    intro W R _ _ _ _ σ J t hJ hσ hres hnu hdiv
    have factB : ∀ z ∈ IsLocalRing.maximalIdeal R, ¬ IsUnit (Ideal.Quotient.mk J z) := by
      intro z hz hu
      obtain ⟨v, hv⟩ := hu.exists_right_inv
      obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective v
      have h1 : 1 - z * u ∈ J := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, map_mul, hv, sub_self]
      have h2 : z * u ∈ IsLocalRing.maximalIdeal R := Ideal.mul_mem_right _ _ hz
      have h3 := Ideal.add_mem _ (hJ h1) h2
      rw [sub_add_cancel] at h3
      exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr h3)
    have hmax : (Ideal.span {Ideal.Quotient.mk J t}).IsMaximal := by
      rw [Ideal.isMaximal_iff]
      refine ⟨?_, ?_⟩
      · intro h1
        exact hnu (isUnit_of_dvd_one (Ideal.mem_span_singleton.mp h1))
      · intro J₂ x _ hxP hxJ
        by_cases hx : IsUnit x
        · obtain ⟨v, hv⟩ := hx.exists_left_inv
          have := J₂.mul_mem_left v hxJ
          rwa [hv] at this
        · exact absurd (Ideal.mem_span_singleton.mpr (hdiv x hx)) hxP
    have hii : ∀ z : R, Ideal.Quotient.mk J z ∈ Ideal.span {Ideal.Quotient.mk J t} ↔
        z ∈ IsLocalRing.maximalIdeal R := by
      intro z
      constructor
      · intro hz
        by_contra hzm
        have hu : IsUnit z := by
          by_contra h
          exact hzm ((IsLocalRing.mem_maximalIdeal _).mpr h)
        exact hmax.ne_top (Ideal.eq_top_of_isUnit_mem _ hz (hu.map (Ideal.Quotient.mk J)))
      · intro hz
        exact Ideal.mem_span_singleton.mpr (hdiv _ (factB z hz))
    refine ⟨hmax, hii, ?_, ?_⟩
    · intro x
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨w, hw⟩ := hres y
      exact ⟨w, by rw [← map_sub]; exact (hii _).mpr hw⟩
    · intro w hw
      have hσm := (hii _).mp hw
      by_cases hwm : w ∈ IsLocalRing.maximalIdeal W
      · exact Ideal.Quotient.eq_zero_iff_mem.mpr (hσ w hwm)
      · exfalso
        have hu : IsUnit w := by
          by_contra h
          exact hwm ((IsLocalRing.mem_maximalIdeal _).mpr h)
        exact ((IsLocalRing.mem_maximalIdeal _).mp hσm) (hu.map σ)
  have s4 : ∀ (B : Type u) [CommRing B] (Q : Ideal B) [Q.IsPrime] (b : B), b ∉ Q →
      ∀ (q : Ideal (Localization.Away b)) [q.IsPrime],
      q.comap (algebraMap B (Localization.Away b)) = Q →
      ∃ β : Localization.Away b →+* Localization.AtPrime Q,
        (∀ c : B, β (algebraMap B (Localization.Away b) c) =
          algebraMap B (Localization.AtPrime Q) c) ∧
        ∀ a : Localization.Away b,
          β a ∈ IsLocalRing.maximalIdeal (Localization.AtPrime Q) ↔ a ∈ q := by
    intro B _ Q _ b hb q _ hq
    have hbu : IsUnit (algebraMap B (Localization.AtPrime Q) b) :=
      IsLocalization.map_units (Localization.AtPrime Q) (⟨b, hb⟩ : Q.primeCompl)
    refine ⟨IsLocalization.Away.lift b hbu, fun c => IsLocalization.Away.lift_eq b hbu c, ?_⟩
    intro a
    obtain ⟨n, c, hcn⟩ := IsLocalization.Away.surj b a
    have h1 : IsLocalization.Away.lift b hbu a * (algebraMap B (Localization.AtPrime Q) b) ^ n =
        algebraMap B (Localization.AtPrime Q) c := by
      have := congrArg (IsLocalization.Away.lift b hbu) hcn
      rwa [map_mul, map_pow, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq] at this
    have hu1 : IsUnit ((algebraMap B (Localization.AtPrime Q) b) ^ n) := hbu.pow n
    have hu2 : IsUnit ((algebraMap B (Localization.Away b) b) ^ n) :=
      (IsLocalization.Away.algebraMap_isUnit b).pow n
    rw [← Ideal.mul_unit_mem_iff_mem _ hu1, h1,
      IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q) Q,
      ← Ideal.mul_unit_mem_iff_mem q hu2, hcn, ← Ideal.mem_comap, hq]
  intro W B _ _ _ _ Q _ τ b hI hres hdom hπ0 hπnu hπdiv hb q _ hq
  set ι := algebraMap B (Localization.AtPrime Q) with hι
  set J' := (Ideal.map (algebraMap W B) (IsLocalRing.maximalIdeal W)).map ι with hJ'
  have hJle : J' ≤ IsLocalRing.maximalIdeal (Localization.AtPrime Q) := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal]
    exact Ideal.map_mono hI
  have hσJ : ∀ w ∈ IsLocalRing.maximalIdeal W, (ι.comp (algebraMap W B)) w ∈ J' := by
    intro w hw
    exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hw)
  obtain ⟨hPmax, hPii, hPres, hPvan⟩ := s3 W (Localization.AtPrime Q) (ι.comp (algebraMap W B)) J'
    (ι τ) hJle hσJ (s2 W B Q hI hres) hπnu hπdiv
  obtain ⟨DF, hDFl, hDFw, hDFπ⟩ := s1 W (Localization.AtPrime Q ⧸ J')
    ((Ideal.Quotient.mk J').comp (ι.comp (algebraMap W B))) (Ideal.Quotient.mk J' (ι τ)) hπ0
    hPres hPvan
  obtain ⟨β, hβ, hβm⟩ := s4 B Q b hb q hq
  letI : Field ((Localization.AtPrime Q ⧸ J') ⧸ Ideal.span {Ideal.Quotient.mk J' (ι τ)}) :=
    Ideal.Quotient.field _
  refine ⟨(Localization.AtPrime Q ⧸ J') ⧸ Ideal.span {Ideal.Quotient.mk J' (ι τ)},
    Ideal.Quotient.field _,
    (Ideal.Quotient.mk (Ideal.span {Ideal.Quotient.mk J' (ι τ)})).comp
      ((Ideal.Quotient.mk J').comp β),
    DF.comp ((Ideal.Quotient.mk J').comp β).toAddMonoidHom, ?_, ?_, ?_, ?_⟩
  · intro a
    show Ideal.Quotient.mk (Ideal.span {Ideal.Quotient.mk J' (ι τ)})
      (Ideal.Quotient.mk J' (β a)) = 0 ↔ a ∈ q
    rw [Ideal.Quotient.eq_zero_iff_mem, hPii, hβm]
  · intro x y
    show DF (Ideal.Quotient.mk J' (β (x * y))) =
      Ideal.Quotient.mk (Ideal.span {Ideal.Quotient.mk J' (ι τ)}) (Ideal.Quotient.mk J' (β x)) *
      DF (Ideal.Quotient.mk J' (β y)) +
      Ideal.Quotient.mk (Ideal.span {Ideal.Quotient.mk J' (ι τ)}) (Ideal.Quotient.mk J' (β y)) *
      DF (Ideal.Quotient.mk J' (β x))
    rw [map_mul, map_mul, hDFl]
  · intro w
    show DF (Ideal.Quotient.mk J' (β (algebraMap W (Localization.Away b) w))) = 0
    rw [IsScalarTower.algebraMap_apply W B (Localization.Away b), hβ]
    exact hDFw w
  · show DF (Ideal.Quotient.mk J' (β (algebraMap B (Localization.Away b) τ))) ≠ 0
    rw [hβ]
    change DF (Ideal.Quotient.mk J' (ι τ)) ≠ 0
    rw [hDFπ]
    exact one_ne_zero

theorem wcpa_dj_llsm_smcu_coord_chart : ∀ (W B : Type u) [CommRing W] [CommRing B] [Algebra W B] (Q : Ideal B) [Q.IsPrime] (b τ : B), b ∉ Q → Algebra.IsStandardSmoothOfRelativeDimension 1 W (Localization.Away b) → ∀ (q : Ideal (Localization.Away b)) [q.IsPrime], q.comap (algebraMap B (Localization.Away b)) = Q → (1 : q.ResidueField) ⊗ₜ[Localization.Away b] KaehlerDifferential.D W (Localization.Away b) (algebraMap B (Localization.Away b) τ) ≠ 0 → ∃ g : B, g ∉ Q ∧ ∃ φ : Polynomial W →+* Localization.Away g, φ.comp Polynomial.C = (algebraMap B (Localization.Away g)).comp (algebraMap W B) ∧ φ Polynomial.X = algebraMap B (Localization.Away g) τ ∧ RingHom.Etale (R := Polynomial W) (S := Localization.Away g) φ :=
by
  have wc_tube_jacobian_etale : ∀ (R A : Type u) [CommRing R] [CommRing A] [Algebra R A] (n : ℕ) (ι : Type) [Fintype ι] (a : ι → A), RingHom.IsStandardSmoothOfRelativeDimension n (algebraMap R A) → Fintype.card ι = n → ∀ (q : Ideal A) [q.IsPrime], Submodule.span q.ResidueField (Set.range (fun j => (1 : q.ResidueField) ⊗ₜ[A] KaehlerDifferential.D R A (a j))) = ⊤ → ∃ s : A, s ∉ q ∧ ∀ (A' : Type u) [CommRing A'] [Algebra A A'] [IsLocalization.Away s A'], RingHom.Etale ((algebraMap A A').comp (MvPolynomial.eval₂Hom (algebraMap R A) a)) := by
    classical
    have s5 : ∀ (R S T : Type u) [CommRing R] [CommRing S] [CommRing T] [Algebra R S]
        [Algebra R T] [Algebra S T] [IsScalarTower R S T], Algebra.FormallySmooth R T →
        Algebra.FinitePresentation R T → Algebra.FiniteType R S →
        Function.Bijective (KaehlerDifferential.mapBaseChange R S T) → Algebra.Etale S T := by
      intro R S T _ _ _ _ _ _ _ h1 h2 h3 hb
      have hH : Subsingleton (Algebra.H1Cotangent S T) := by
        have hx0 : ∀ x : Algebra.H1Cotangent S T, x = 0 := by
          intro x
          have hδ : Algebra.H1Cotangent.δ R S T x = 0 := by
            apply hb.1
            rw [map_zero]
            exact (Algebra.H1Cotangent.exact_δ_mapBaseChange R S T).apply_apply_eq_zero x
          obtain ⟨y, rfl⟩ := (Algebra.H1Cotangent.exact_map_δ R S T x).mp hδ
          rw [Subsingleton.elim y 0, map_zero]
        exact ⟨fun a b => (hx0 a).trans (hx0 b).symm⟩
      have hΩ : Subsingleton Ω[T⁄S] := by
        have hw0 : ∀ w : Ω[T⁄S], w = 0 := by
          intro w
          obtain ⟨z, rfl⟩ := KaehlerDifferential.map_surjective R S T w
          obtain ⟨y, rfl⟩ := hb.2 z
          exact (KaehlerDifferential.exact_mapBaseChange_map R S T).apply_apply_eq_zero y
        exact ⟨fun a b => (hw0 a).trans (hw0 b).symm⟩
      haveI : Algebra.FormallyEtale S T := Algebra.FormallyEtale.mk hΩ hH
      haveI : Algebra.FinitePresentation S T :=
        Algebra.FinitePresentation.of_restrict_scalars_finitePresentation R S T
      exact ⟨inferInstance, inferInstance⟩
    have s2 : ∀ (A M : Type u) [CommRing A] [AddCommGroup M] [Module A M] [Module.Finite A M]
        (ι : Type) (v : ι → M) (q : Ideal A) [q.IsPrime],
        Submodule.span q.ResidueField (Set.range (fun j => (1 : q.ResidueField) ⊗ₜ[A] v j)) = ⊤ →
        ∃ s : A, s ∉ q ∧ ∀ m : M, s • m ∈ Submodule.span A (Set.range v) := by
      intro A M _ _ _ _ ι v q _ h
      set N := Submodule.span A (Set.range v) with hN
      have hsub : Subsingleton (TensorProduct A q.ResidueField (M ⧸ N)) := by
        let πκ := LinearMap.baseChange q.ResidueField N.mkQ
        have hs : Function.Surjective πκ :=
          LinearMap.baseChange_surjective _ (Submodule.mkQ_surjective N)
        have hr : LinearMap.range πκ = ⊥ := by
          rw [LinearMap.range_eq_map, ← h, Submodule.map_span, Submodule.span_eq_bot]
          rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
          simp only [πκ, LinearMap.baseChange_tmul, Submodule.mkQ_apply]
          rw [(Submodule.Quotient.mk_eq_zero N).mpr (Submodule.subset_span ⟨j, rfl⟩),
            TensorProduct.tmul_zero]
        have h0 : ∀ x : TensorProduct A q.ResidueField (M ⧸ N), x = 0 := by
          intro x
          obtain ⟨x', rfl⟩ := hs x
          have hx : πκ x' ∈ LinearMap.range πκ := ⟨x', rfl⟩
          rw [hr] at hx
          exact hx
        exact ⟨fun a b => (h0 a).trans (h0 b).symm⟩
      let p : PrimeSpectrum A := ⟨q, inferInstance⟩
      have hnot : p ∉ Module.support A (M ⧸ N) := fun hp =>
        not_nontrivial_iff_subsingleton.mpr hsub
          ((Module.mem_support_iff_nontrivial_residueField_tensorProduct p).mp hp)
      rw [Module.mem_support_iff_of_finite] at hnot
      obtain ⟨s, hs, hsq⟩ := SetLike.not_le_iff_exists.mp hnot
      refine ⟨s, hsq, fun m => ?_⟩
      have := Module.mem_annihilator.mp hs (Submodule.Quotient.mk m)
      rw [← Submodule.Quotient.mk_smul] at this
      exact (Submodule.Quotient.mk_eq_zero N).mp this
    have s3 : ∀ (R A A' : Type u) [CommRing R] [CommRing A] [CommRing A'] [Algebra R A]
        [Algebra A A'] [Algebra R A'] [IsScalarTower R A A'] (ι : Type) [Fintype ι] (a : ι → A)
        (s : A) [IsLocalization.Away s A'] [Algebra (MvPolynomial ι R) A']
        [IsScalarTower R (MvPolynomial ι R) A'],
        (∀ j, algebraMap (MvPolynomial ι R) A' (MvPolynomial.X j) = algebraMap A A' (a j)) →
        (∀ ω : Ω[A⁄R], s • ω ∈
          Submodule.span A (Set.range (fun j => KaehlerDifferential.D R A (a j)))) →
        Function.Surjective (KaehlerDifferential.mapBaseChange R (MvPolynomial ι R) A') := by
      intro R A A' _ _ _ _ _ _ _ ι _ a s _ _ _ hX hs
      haveI : Algebra.FormallyEtale A A' :=
        Algebra.FormallyEtale.of_isLocalization (Submonoid.powers s)
      have hbc := KaehlerDifferential.isBaseChange_of_formallyEtale R A A'
      rw [← LinearMap.range_eq_top, eq_top_iff]
      intro y _
      set Im := LinearMap.range (KaehlerDifferential.mapBaseChange R (MvPolynomial ι R) A')
        with hIm
      have hgen : ∀ j, KaehlerDifferential.map R R A A' (KaehlerDifferential.D R A (a j)) ∈ Im := by
        intro j
        refine ⟨1 ⊗ₜ KaehlerDifferential.D R _ (MvPolynomial.X j), ?_⟩
        simp only [KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D, hX]
      have hle : Submodule.span A (Set.range (fun j => KaehlerDifferential.D R A (a j))) ≤
          (Im.restrictScalars A).comap (KaehlerDifferential.map R R A A') := by
        rw [Submodule.span_le]
        rintro _ ⟨j, rfl⟩
        exact hgen j
      have hall : ∀ ω, KaehlerDifferential.map R R A A' ω ∈ Im := by
        intro ω
        have h1 := hle (hs ω)
        rw [Submodule.mem_comap, Submodule.restrictScalars_mem, LinearMap.map_smul,
          ← algebraMap_smul A' s] at h1
        obtain ⟨u, hu⟩ := IsLocalization.Away.algebraMap_isUnit (S := A') s
        have e : KaehlerDifferential.map R R A A' ω =
            (↑u⁻¹ : A') • (algebraMap A A' s • KaehlerDifferential.map R R A A' ω) := by
          rw [← hu, smul_smul, Units.inv_mul, one_smul]
        rw [e]
        exact Im.smul_mem _ h1
      exact hbc.inductionOn y hall (fun c n hn => Im.smul_mem c hn)
        (fun _ _ h1 h2 => Im.add_mem h1 h2)
    have s4 : ∀ (R T : Type u) [CommRing R] [CommRing T] (ι : Type) [Fintype ι] [Algebra R T]
        [Algebra (MvPolynomial ι R) T] [IsScalarTower R (MvPolynomial ι R) T] (n : ℕ),
        Algebra.IsStandardSmoothOfRelativeDimension n R T → Fintype.card ι = n →
        Function.Surjective (KaehlerDifferential.mapBaseChange R (MvPolynomial ι R) T) →
        Function.Bijective (KaehlerDifferential.mapBaseChange R (MvPolynomial ι R) T) := by
      intro R T _ _ ι _ _ _ _ n hT hc hs
      refine ⟨?_, hs⟩
      rcases subsingleton_or_nontrivial T with hT0 | hT0
      · haveI := Module.subsingleton T
          (TensorProduct (MvPolynomial ι R) T Ω[MvPolynomial ι R⁄R])
        intro x y _
        exact Subsingleton.elim x y
      · haveI := hT
        haveI : Algebra.IsStandardSmooth R T :=
          Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n
        haveI : Algebra.FinitePresentation R T := Algebra.IsStandardSmooth.finitePresentation
        haveI : Algebra.FiniteType R T := Algebra.FiniteType.of_finitePresentation
        haveI : Module.Finite T Ω[T⁄R] := KaehlerDifferential.finite R T
        haveI : Module.Free T Ω[T⁄R] := Algebra.IsStandardSmooth.free_kaehlerDifferential
        haveI : StrongRankCondition T := commRing_strongRankCondition T
        have hfr : Module.finrank T Ω[T⁄R] = n := Module.finrank_eq_of_rank_eq
          (Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential n)
        let bT := Module.finBasisOfFinrankEq T Ω[T⁄R] hfr
        let bS := ((KaehlerDifferential.mvPolynomialBasis R ι).baseChange T).reindex
          (Fintype.equivFinOfCardEq hc)
        let E := bS.equiv bT (Equiv.refl _)
        haveI : Module.Finite T (TensorProduct (MvPolynomial ι R) T Ω[MvPolynomial ι R⁄R]) :=
          Module.Finite.of_basis bS
        let f := E.symm.toLinearMap ∘ₗ KaehlerDifferential.mapBaseChange R (MvPolynomial ι R) T
        have hf : Function.Surjective f := E.symm.surjective.comp hs
        have hfi := OrzechProperty.injective_of_surjective_endomorphism f hf
        intro x y hxy
        apply hfi
        simp only [f, LinearMap.coe_comp, Function.comp_apply, hxy]
    intro R A _ _ _ n ι _ a hstd hcard q _ hspan
    haveI hA : Algebra.IsStandardSmoothOfRelativeDimension n R A :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap n).mp hstd
    haveI : Algebra.IsStandardSmooth R A :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n
    haveI : Algebra.FinitePresentation R A := Algebra.IsStandardSmooth.finitePresentation
    haveI : Algebra.FiniteType R A := Algebra.FiniteType.of_finitePresentation
    haveI : Module.Finite A Ω[A⁄R] := KaehlerDifferential.finite R A
    obtain ⟨s, hsq, hs⟩ := s2 A Ω[A⁄R] ι (fun j => KaehlerDifferential.D R A (a j)) q hspan
    refine ⟨s, hsq, fun A' _ _ _ => ?_⟩
    letI : Algebra R A' := ((algebraMap A A').comp (algebraMap R A)).toAlgebra
    haveI : IsScalarTower R A A' := IsScalarTower.of_algebraMap_eq' rfl
    letI : Algebra (MvPolynomial ι R) A' :=
      ((algebraMap A A').comp (MvPolynomial.eval₂Hom (algebraMap R A) a)).toAlgebra
    haveI : IsScalarTower R (MvPolynomial ι R) A' := IsScalarTower.of_algebraMap_eq (fun r => by
      rw [MvPolynomial.algebraMap_eq]
      exact (congrArg (algebraMap A A') (MvPolynomial.eval₂Hom_C (algebraMap R A) a r)).symm)
    show RingHom.Etale (algebraMap (MvPolynomial ι R) A')
    rw [RingHom.etale_algebraMap]
    haveI : Algebra.IsStandardSmoothOfRelativeDimension 0 A A' :=
      Algebra.IsStandardSmoothOfRelativeDimension.localization_away s
    have hstd' : Algebra.IsStandardSmoothOfRelativeDimension n R A' := by
      have h := Algebra.IsStandardSmoothOfRelativeDimension.trans n 0 R A A'
      rwa [zero_add] at h
    haveI := hstd'
    haveI : Algebra.IsStandardSmooth R A' :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n
    haveI hsmA' : Algebra.Smooth R A' := Algebra.instSmoothOfIsStandardSmooth
    have hfsA' : Algebra.FormallySmooth R A' := hsmA'.formallySmooth
    have hfpA' : Algebra.FinitePresentation R A' := Algebra.IsStandardSmooth.finitePresentation
    have hftP : Algebra.FiniteType R (MvPolynomial ι R) :=
      @Algebra.FiniteType.of_finitePresentation R (MvPolynomial ι R) _ _ _
        (Algebra.FinitePresentation.mvPolynomial R R ι)
    have hsurj := s3 R A A' ι a s (fun j => by
      change algebraMap A A' (MvPolynomial.eval₂Hom (algebraMap R A) a (MvPolynomial.X j)) = _
      rw [MvPolynomial.eval₂Hom_X']) hs
    have hbij := s4 R A' ι n hstd' hcard hsurj
    exact s5 R (MvPolynomial ι R) A' hfsA' hfpA' hftP hbij
  intro W B _ _ _ Q hQ b τ hb hsm q hq hqc hd
  classical
  set A := Localization.Away b
  set j := algebraMap B A with hjdef
  set κ := q.ResidueField
  set D := KaehlerDifferential.D W A

  have hspan : Submodule.span κ {(1 : κ) ⊗ₜ[A] D (j τ)} = ⊤ := by
    haveI : Nontrivial A := by
      refine ⟨⟨0, 1, fun h => ?_⟩⟩
      apply hq.ne_top
      rw [Ideal.eq_top_iff_one, ← h]
      exact q.zero_mem
    haveI := hsm
    haveI := Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1 (R := W) (S := A)
    haveI : Module.Free A Ω[A⁄W] := Algebra.IsStandardSmooth.free_kaehlerDifferential
    have hrank : Module.rank A Ω[A⁄W] = 1 := by
      rw [Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential 1]; simp
    have hfr : Module.finrank A Ω[A⁄W] = 1 := Module.finrank_eq_of_rank_eq (by rw [hrank]; simp)
    have hV : Module.finrank κ (TensorProduct A κ Ω[A⁄W]) = 1 := by
      rw [Module.finrank_baseChange, hfr]
    haveI : FiniteDimensional κ (TensorProduct A κ Ω[A⁄W]) :=
      Module.finite_of_finrank_pos (by rw [hV]; norm_num)
    apply Submodule.eq_top_of_finrank_eq
    rw [finrank_span_singleton hd, hV]

  obtain ⟨s, hs, het⟩ := wc_tube_jacobian_etale W A 1 (Fin 1) (fun _ => j τ)
    ((RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr hsm) (Fintype.card_fin 1)
    q (by
      show Submodule.span κ (Set.range (fun _ : Fin 1 => (1 : κ) ⊗ₜ[A] D (j τ))) = ⊤
      rw [Set.range_const]
      exact hspan)
  set ψ : MvPolynomial (Fin 1) W →+* A := MvPolynomial.eval₂Hom (algebraMap W A) (fun _ => j τ)
    with hψdef

  obtain ⟨⟨s', ⟨_, n, rfl⟩⟩, hs'⟩ := IsLocalization.surj (Submonoid.powers b) s
  simp only at hs'
  have hs'Q : s' ∉ Q := by
    intro h
    have h1 : s * j (b ^ n) ∈ q := by
      rw [hs']
      have : s' ∈ q.comap j := by rw [hqc]; exact h
      exact this
    rcases hq.mem_or_mem h1 with h2 | h2
    · exact hs h2
    · have : b ^ n ∈ Q := by rw [← hqc]; exact h2
      exact hb (hQ.mem_of_pow_mem n this)
  have hgQ : b * s' ∉ Q := fun h => (hQ.mem_or_mem h).elim hb hs'Q
  have hu : IsUnit (j (b ^ n)) :=
    IsLocalization.map_units A (⟨b ^ n, n, rfl⟩ : Submonoid.powers b)
  have hassoc : Associated (j s') s := by
    obtain ⟨u, hu'⟩ := hu
    refine ⟨u⁻¹, ?_⟩
    rw [← hs', ← hu', mul_assoc, Units.mul_inv, mul_one]
  haveI : IsLocalization.Away s (Localization.Away (j s')) :=
    IsLocalization.Away.of_associated hassoc
  have hT := het (Localization.Away (j s'))
  haveI : IsLocalization.Away (b * s') (Localization.Away (j s')) :=
    IsLocalization.Away.mul' A (Localization.Away (j s')) b s'
  let iso : Localization.Away (j s') ≃ₐ[B] Localization.Away (b * s') :=
    IsLocalization.algEquiv (Submonoid.powers (b * s')) (Localization.Away (j s'))
      (Localization.Away (b * s'))
  set e : A →+* Localization.Away (b * s') :=
    (iso : Localization.Away (j s') →+* Localization.Away (b * s')).comp
      (algebraMap A (Localization.Away (j s'))) with hedef
  have he : ∀ x : B, e (j x) = algebraMap B (Localization.Away (b * s')) x := by
    intro x
    rw [hedef, RingHom.comp_apply, ← IsScalarTower.algebraMap_apply B A]
    exact iso.commutes x
  have heψ : (e.comp ψ).Etale := by
    rw [hedef, RingHom.comp_assoc]
    exact RingHom.Etale.stableUnderComposition _ _ hT (RingHom.Etale.of_bijective iso.bijective)

  let ι : Polynomial W →+* MvPolynomial (Fin 1) W :=
    Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0)
  let κ' : MvPolynomial (Fin 1) W →+* Polynomial W :=
    MvPolynomial.eval₂Hom Polynomial.C (fun _ => Polynomial.X)
  have h1 : κ'.comp ι = RingHom.id _ := by
    apply Polynomial.ringHom_ext
    · intro a; simp [ι, κ']
    · simp [ι, κ']
  have h2 : ι.comp κ' = RingHom.id _ := by
    apply MvPolynomial.ringHom_ext
    · intro a; simp [ι, κ']
    · intro i; rw [Subsingleton.elim i 0]; simp [ι, κ']
  have hbij : Function.Bijective ι := by
    refine Function.bijective_iff_has_inverse.mpr ⟨κ', fun x => ?_, fun x => ?_⟩
    · exact RingHom.congr_fun h1 x
    · exact RingHom.congr_fun h2 x

  refine ⟨b * s', hgQ, (e.comp ψ).comp ι, ?_, ?_, ?_⟩
  · ext a
    simp only [RingHom.comp_apply, ι, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hψdef,
      MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_C]
    rw [IsScalarTower.algebraMap_apply W B A, ← hjdef, he]
  · simp only [RingHom.comp_apply, ι, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, hψdef,
      MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X]
    exact he τ
  · exact RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective hbij) heψ

theorem wcpa_dj_llsm_smcu_isolate : ∀ (W B : Type u) [CommRing W] [IsLocalRing W] [CommRing B] [Algebra W B] [Algebra.FiniteType W B] (Q : Ideal B) [Q.IsPrime] (τ : B), Ideal.map (algebraMap W B) (IsLocalRing.maximalIdeal W) ≤ Q → (∀ x : Localization.AtPrime Q ⧸ (Ideal.map (algebraMap W B) (IsLocalRing.maximalIdeal W)).map (algebraMap B (Localization.AtPrime Q)), ¬ IsUnit x → Ideal.Quotient.mk ((Ideal.map (algebraMap W B) (IsLocalRing.maximalIdeal W)).map (algebraMap B (Localization.AtPrime Q))) (algebraMap B (Localization.AtPrime Q) τ) ∣ x) → ∃ g : B, g ∉ Q ∧ ∀ x ∈ Q, g * x ∈ Ideal.span {τ} ⊔ Ideal.map (algebraMap W B) (IsLocalRing.maximalIdeal W) :=
by
  intro W B _ _ _ _ _ Q hQ τ hIQ H2
  classical
  set I : Ideal B := Ideal.map (algebraMap W B) (IsLocalRing.maximalIdeal W) with hI

  have s2 : ∀ q ∈ Q, ∃ g : B, g ∉ Q ∧ g * q ∈ Ideal.span {τ} ⊔ I := by
    intro q hq
    set ι := algebraMap B (Localization.AtPrime Q) with hι
    set Iₗ := I.map ι with hIₗ
    have hIₗM : Iₗ ≤ IsLocalRing.maximalIdeal (Localization.AtPrime Q) := by
      rw [← Localization.AtPrime.map_eq_maximalIdeal]
      exact Ideal.map_mono hIQ
    have hqM : ι q ∈ IsLocalRing.maximalIdeal (Localization.AtPrime Q) := by
      rw [IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q) Q]
      exact hq
    have hnu : ¬ IsUnit (Ideal.Quotient.mk Iₗ (ι q)) := by
      rintro ⟨u, hu⟩
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (↑u⁻¹ : Localization.AtPrime Q ⧸ Iₗ)
      have h1 : Ideal.Quotient.mk Iₗ (ι q * y - 1) = 0 := by
        rw [map_sub, map_mul, map_one, hy, ← hu, Units.mul_inv, sub_self]
      rw [Ideal.Quotient.eq_zero_iff_mem] at h1
      have h2 : ι q * y - 1 ∈ IsLocalRing.maximalIdeal (Localization.AtPrime Q) := hIₗM h1
      have h3 : ι q * y ∈ IsLocalRing.maximalIdeal (Localization.AtPrime Q) :=
        Ideal.mul_mem_right _ _ hqM
      have h4 : (1 : Localization.AtPrime Q) ∈ IsLocalRing.maximalIdeal (Localization.AtPrime Q) := by
        have := Ideal.sub_mem _ h3 h2
        simpa using this
      exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top ((Ideal.eq_top_iff_one _).mpr h4)
    obtain ⟨y', hy'⟩ := H2 _ hnu
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y'
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl y
    have hspec := IsLocalization.mk'_spec (Localization.AtPrime Q) a s
    rw [← map_mul, Ideal.Quotient.eq] at hy'
    have h5 : ι (s * q - τ * a) ∈ Iₗ := by
      have e : ι (s * q - τ * a) =
          (ι q - ι τ * IsLocalization.mk' (Localization.AtPrime Q) a s) * ι s := by
        rw [map_sub, map_mul, map_mul, sub_mul, mul_assoc, hspec]; ring
      rw [e]
      exact Ideal.mul_mem_right _ _ hy'
    rw [hIₗ, IsLocalization.mem_map_algebraMap_iff Q.primeCompl] at h5
    obtain ⟨⟨w, t⟩, hwt⟩ := h5
    rw [← map_mul, IsLocalization.eq_iff_exists Q.primeCompl] at hwt
    obtain ⟨c, hc⟩ := hwt
    refine ⟨c * t * s, ?_, ?_⟩
    · intro hmem
      rcases hQ.mem_or_mem hmem with h | h
      · rcases hQ.mem_or_mem h with h' | h'
        · exact c.2 h'
        · exact t.2 h'
      · exact s.2 h
    · have e2 : (c : B) * t * s * q = τ * (c * t * a) + c * w := by
        linear_combination hc
      rw [e2]
      exact Ideal.add_mem _
        (Ideal.mem_sup_left (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self τ)))
        (Ideal.mem_sup_right (Ideal.mul_mem_left _ _ w.2))

  have s1 : ∃ (n : ℕ) (q : Fin n → B), (∀ i, q i ∈ Q) ∧
      ∀ x ∈ Q, ∃ d : Fin n → B, x - ∑ i, d i * q i ∈ I := by
    haveI hN : IsNoetherianRing (B ⧸ I) :=
      @Algebra.FiniteType.isNoetherianRing (W ⧸ IsLocalRing.maximalIdeal W) (B ⧸ I) _ _ _
        (@Algebra.FiniteType.of_restrictScalars_finiteType W (W ⧸ IsLocalRing.maximalIdeal W)
          (B ⧸ I) _ _ _ _ _ _ _
          (Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ W I)
            (Ideal.Quotient.mkₐ_surjective W I)))
        ((inferInstance : IsNoetherianRing (IsLocalRing.ResidueField W)) :
          IsNoetherianRing (W ⧸ IsLocalRing.maximalIdeal W))
    have hfg : (Q.map (Ideal.Quotient.mk I)).FG := IsNoetherian.noetherian _
    obtain ⟨n, s, hs⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
    have hcomap : (Q.map (Ideal.Quotient.mk I)).comap (Ideal.Quotient.mk I) = Q := by
      rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
        ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
      exact sup_eq_left.mpr hIQ
    choose q hq using fun i => Ideal.Quotient.mk_surjective (s i)
    refine ⟨n, q, fun i => ?_, fun x hx => ?_⟩
    · rw [← hcomap, Ideal.mem_comap, hq i, ← hs]
      exact Submodule.subset_span ⟨i, rfl⟩
    · have hx' : Ideal.Quotient.mk I x ∈ Q.map (Ideal.Quotient.mk I) := Ideal.mem_map_of_mem _ hx
      rw [← hs] at hx'
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hx'
      choose d hd using fun i => Ideal.Quotient.mk_surjective (c i)
      refine ⟨d, ?_⟩
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_sum]
      simp only [map_mul, hd, hq, ← hc, smul_eq_mul, sub_self]

  obtain ⟨n, q, hqQ, hgen⟩ := s1
  choose g hgQ hgJ using fun i => s2 (q i) (hqQ i)
  refine ⟨∏ i, g i, ?_, ?_⟩
  · intro hmem
    obtain ⟨i, _, hi⟩ := (Ideal.IsPrime.prod_mem_iff (hp := hQ)).mp hmem
    exact hgQ i hi
  · intro x hx
    obtain ⟨d, hd⟩ := hgen x hx
    have hx' : x = ∑ i, d i * q i + (x - ∑ i, d i * q i) := by ring
    rw [hx', mul_add, Finset.mul_sum]
    refine Ideal.add_mem _ (Ideal.sum_mem _ fun i _ => ?_)
      (Ideal.mem_sup_right (Ideal.mul_mem_left _ _ hd))
    obtain ⟨k, hk⟩ := Finset.dvd_prod_of_mem g (Finset.mem_univ i)
    rw [hk]
    have e3 : g i * k * (d i * q i) = (k * d i) * (g i * q i) := by ring
    rw [e3]
    exact Ideal.mul_mem_left _ _ (hgJ i)

theorem wcpa_dj_llsm_smcu_unique_denominator : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Algebra.IsIntegral R S] (P : Ideal R) [P.IsPrime] (Q : Ideal S), (∀ Q' : Ideal S, Q'.IsPrime → Q'.comap (algebraMap R S) = P → Q' = Q) → ∀ x : S, x ∉ Q → ∃ e : R, e ∉ P ∧ x ∣ algebraMap R S e :=
by
  intro R S _ _ _ _ P _ Q hU x hx
  by_contra hne
  push_neg at hne
  set T : Submonoid S := Submonoid.map (algebraMap R S) P.primeCompl with hT
  have hdisj : Disjoint (↑(Ideal.span {x}) : Set S) (↑T) := by
    rw [Set.disjoint_left]
    intro y hy hyT
    rw [SetLike.mem_coe, Ideal.mem_span_singleton] at hy
    obtain ⟨e, he, rfl⟩ := Submonoid.mem_map.mp hyT
    exact hne e he hy
  obtain ⟨Q₀, hQ₀, hxQ₀, hQ₀T⟩ := Ideal.exists_le_prime_disjoint _ _ hdisj
  have hle : Ideal.under R Q₀ ≤ P := by
    intro r hr
    rw [Ideal.under_def, Ideal.mem_comap] at hr
    by_contra hrP
    have hrT : algebraMap R S r ∈ T := Submonoid.mem_map.mpr ⟨r, hrP, rfl⟩
    exact Set.disjoint_left.mp hQ₀T hr hrT
  obtain ⟨Q', hQ'ge, hQ'p, hQ'under⟩ := Ideal.exists_ideal_over_prime_of_isIntegral P Q₀ hle
  have hQ'eq : Q' = Q := hU Q' hQ'p (by rw [← Ideal.under_def]; exact hQ'under)
  apply hx
  rw [← hQ'eq]
  exact hQ'ge (hxQ₀ (Ideal.mem_span_singleton_self x))

theorem wcpa_dj_llsm_smcu_chart_transfer : ∀ (W C : Type u) [CommRing W] [CommRing C] (σW : W →+* C) (g τ σ : C) (φ : Polynomial W →+* Localization.Away g), g ∣ σ → φ.comp Polynomial.C = (algebraMap C (Localization.Away g)).comp σW → φ Polynomial.X = algebraMap C (Localization.Away g) τ → RingHom.Etale (R := Polynomial W) (S := Localization.Away g) φ → ∃ f : Polynomial W →+* Localization.Away (1 : Localization.Away σ), f.comp Polynomial.C = (algebraMap (Localization.Away σ) (Localization.Away (1 : Localization.Away σ))).comp ((algebraMap C (Localization.Away σ)).comp σW) ∧ f Polynomial.X = algebraMap (Localization.Away σ) (Localization.Away (1 : Localization.Away σ)) (algebraMap C (Localization.Away σ) τ) ∧ RingHom.Etale (R := Polynomial W) (S := Localization.Away (1 : Localization.Away σ)) f :=
by
  intro W C _ _ σW g τ σ φ hdvd hC hX hφ
  obtain ⟨c, rfl⟩ := hdvd
  have : IsLocalization.Away (g * c)
      (Localization.Away (algebraMap C (Localization.Away g) c)) :=
    IsLocalization.Away.mul' (Localization.Away g)
      (Localization.Away (algebraMap C (Localization.Away g) c)) g c
  let e := IsLocalization.algEquiv (Submonoid.powers (g * c))
    (Localization.Away (algebraMap C (Localization.Away g) c)) (Localization.Away (g * c))
  have h4b : (algebraMap (Localization.Away g)
      (Localization.Away (algebraMap C (Localization.Away g) c))).Etale :=
    RingHom.etale_algebraMap.mpr
      (Algebra.Etale.of_isLocalizationAway (algebraMap C (Localization.Away g) c))
  have h4c : (e : Localization.Away (algebraMap C (Localization.Away g) c) →+*
      Localization.Away (g * c)).Etale :=
    RingHom.Etale.of_bijective e.bijective
  have h4d : (algebraMap (Localization.Away (g * c))
      (Localization.Away (1 : Localization.Away (g * c)))).Etale :=
    RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway 1)
  have key : ∀ x : C, (e : Localization.Away (algebraMap C (Localization.Away g) c) →+*
      Localization.Away (g * c)) (algebraMap (Localization.Away g)
      (Localization.Away (algebraMap C (Localization.Away g) c)) (algebraMap C _ x)) =
      algebraMap C (Localization.Away (g * c)) x := by
    intro x
    rw [← IsScalarTower.algebraMap_apply]
    exact e.commutes x
  refine ⟨(algebraMap (Localization.Away (g * c))
      (Localization.Away (1 : Localization.Away (g * c)))).comp
      ((e : Localization.Away (algebraMap C (Localization.Away g) c) →+*
        Localization.Away (g * c)).comp ((algebraMap (Localization.Away g)
      (Localization.Away (algebraMap C (Localization.Away g) c))).comp φ)), ?_, ?_, ?_⟩
  · refine RingHom.ext fun w => ?_
    simp only [RingHom.comp_apply]
    rw [show φ (Polynomial.C w) = _ from RingHom.congr_fun hC w, RingHom.comp_apply, key]
  · simp only [RingHom.comp_apply]
    rw [hX, key]
  · exact RingHom.Etale.stableUnderComposition _ _
      (RingHom.Etale.stableUnderComposition _ _
        (RingHom.Etale.stableUnderComposition _ _ hφ h4b) h4c) h4d

theorem wcpa_dj_llsm_sm_chart_of_uniformizer : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (𝔭 : Ideal A) (t : A) (z : Ideal ↥(integralClosure A M)),
    wcLlsPD W A 𝔭 (.disc t) →
    ∀ (_ : z.IsPrime), z.comap (algebraMap A ↥(integralClosure A M)) = 𝔭 → wcLlsUniq A M 𝔭 z →
