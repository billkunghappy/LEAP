  cases k with
  | disc t =>
    obtain ⟨c₀, hc₀, hcom⟩ := wcLlsAS_disc_common_centre Ω W hW hWt ℓ hℓ hchar A K L 𝔭 t y
      hPD hSolv hUniq hBR hdeg α hα1 hα2
    obtain ⟨b, hb, hb0, hsep, hmax⟩ := wcLlsAS_disc_radial_max Ω W hW hWt ℓ hℓ hchar A K L 𝔭 t y
      hPD hSolv hUniq hBR hdeg α hα1 hα2 c₀ hc₀
    refine ⟨c₀, b, hc₀, hb, hb0, hsep, ?_⟩
    intro c' b' hc' hb' hb'0 hsep' _ _
    have hd : b' ∣ c' - c₀ := hcom c' b' hc' hb' hb'0 hsep'
    have hd' : b' ∣ c₀ - c' := by rw [← dvd_neg, neg_sub]; exact hd
    exact hmax b' hb' hb'0
      (wcLlsAS_disc_recentre Ω W A K L 𝔭 t hPD c' c₀ b' hc' hc₀ hb' hb'0 hd' hsep')
  | ann u v g =>
    obtain ⟨b, hb, hb0, hbg, hsep, hmax⟩ := wcLlsAS_ann_radial_max Ω W hW hWt ℓ hℓ hchar A K L 𝔭
      u v g y hPD hSolv hUniq hBR hdeg α hα1 hα2
    exact ⟨b, hb, hb0, hbg, hsep, fun b' hb' hb'0 hb'g _ hsep' => hmax b' hb' hb'0 hb'g hsep'⟩

theorem wcpa_dj_llsm_nss_middle_field : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (k : wcLlsKind W A)
    (y : Ideal ↥(integralClosure A L)) (n : ℕ), 1 < n → ¬ n.Prime →
    wcLlsSolvPt W A K L 𝔭 k y → wcLlsUniq A L 𝔭 y → Nat.card ↥(wcLlsDec A K L y) = n →
    Group.IsSolvable (L ≃ₐ[K] L) ∧
    ∃ (M : Type u) (_ : Field M) (_ : Algebra K M) (_ : Algebra M L) (_ : Algebra A M)
      (_ : IsScalarTower A K M) (_ : IsScalarTower K M L) (_ : IsScalarTower A M L)
      (_ : FiniteDimensional K M) (_ : IsGalois K M),
      ∃ z : Ideal ↥(integralClosure A M), z.IsPrime ∧
        z.comap (algebraMap A ↥(integralClosure A M)) = 𝔭 ∧ wcLlsUniq A M 𝔭 z ∧
        Group.IsSolvable ↥(wcLlsDec A K M z) ∧ (Nat.card ↥(wcLlsDec A K M z)).Prime ∧
        Nat.card (L ≃ₐ[M] L) < n :=
by

  have hdec : ∀ (A : Type u) [CommRing A] (K L : Type u) [Field K] [Field L] [Algebra A K]
      [Algebra K L] [Algebra A L] [IsScalarTower A K L] (y : Ideal ↥(integralClosure A L)),
      y.IsPrime → wcLlsUniq A L (y.comap (algebraMap A ↥(integralClosure A L))) y →
      wcLlsDec A K L y = ⊤ := by
    intro A _ K L _ _ _ _ _ _ y hy hU
    have key : ∀ τ : L ≃ₐ[K] L, ∀ x : integralClosure A L,
        x ∈ y ↔ (τ.toAlgHom.restrictScalars A).mapIntegralClosure x ∈ y := by
      intro τ x
      have h1 : y.comap (τ.toAlgHom.restrictScalars A).mapIntegralClosure = y := by
        apply hU
        · exact Ideal.IsPrime.comap _
        · ext a
          rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, AlgHom.commutes]
      rw [← Ideal.mem_comap, h1]
    unfold wcLlsDec
    rw [eq_top_iff]
    intro σ _
    open Pointwise in (
      rw [MulAction.mem_stabilizer_iff]
      ext w
      rw [Set.mem_smul_set]
      constructor
      · rintro ⟨v, ⟨x, hx, rfl⟩, rfl⟩
        exact ⟨(σ.toAlgHom.restrictScalars A).mapIntegralClosure x, (key σ x).mp hx, rfl⟩
      · rintro ⟨x, hx, rfl⟩
        refine ⟨σ⁻¹ • (x : L),
          ⟨(σ⁻¹.toAlgHom.restrictScalars A).mapIntegralClosure x, (key σ⁻¹ x).mp hx, rfl⟩, ?_⟩
        rw [smul_inv_smul])

  have hpi : ∀ (G : Type u) [Group G] [Finite G], Group.IsSolvable G → 1 < Nat.card G →
      ∃ H : Subgroup G, H.Normal ∧ H.index.Prime ∧ Nat.card H < Nat.card G := by
    intro G _ _ hsolv hcard
    have hS : ({N : Subgroup G | N.Normal ∧ N ≠ ⊤} : Set (Subgroup G)).Finite := Set.toFinite _
    have hbot : (⊥ : Subgroup G) ∈ ({N : Subgroup G | N.Normal ∧ N ≠ ⊤} : Set (Subgroup G)) := by
      refine ⟨inferInstance, ?_⟩
      intro h
      have : Nat.card (⊥ : Subgroup G) = Nat.card (⊤ : Subgroup G) := by rw [h]
      rw [Subgroup.card_bot, Subgroup.card_top] at this
      omega
    obtain ⟨N, hNmax⟩ := hS.exists_maximal ⟨⊥, hbot⟩
    obtain ⟨hNn, hNt⟩ := hNmax.prop
    have := hNn
    have hQnt : Nontrivial (G ⧸ N) := by
      rw [← Finite.one_lt_card_iff_nontrivial]
      have h1 : N.index ≠ 1 := by rwa [Ne, Subgroup.index_eq_one]
      have h0 : N.index ≠ 0 := Subgroup.index_ne_zero_of_finite
      rw [Subgroup.index_eq_card] at h1 h0
      omega
    have hsimple : IsSimpleGroup (G ⧸ N) := by
      refine @IsSimpleGroup.mk _ _ hQnt ?_
      intro K' hK'
      have hπs : Function.Surjective (QuotientGroup.mk' N) := QuotientGroup.mk'_surjective N
      have hN' : (K'.comap (QuotientGroup.mk' N)).Normal := hK'.comap _
      have hNle : N ≤ K'.comap (QuotientGroup.mk' N) := by
        intro g hg
        rw [Subgroup.mem_comap]
        have : QuotientGroup.mk' N g = 1 := (QuotientGroup.eq_one_iff g).mpr hg
        rw [this]
        exact K'.one_mem
      by_cases htop : K'.comap (QuotientGroup.mk' N) = ⊤
      · right
        rw [← Subgroup.map_comap_eq_self_of_surjective hπs K', htop,
          Subgroup.map_top_of_surjective _ hπs]
      · left
        have hle : K'.comap (QuotientGroup.mk' N) ≤ N := hNmax.2 ⟨hN', htop⟩ hNle
        rw [← Subgroup.map_comap_eq_self_of_surjective hπs K', Subgroup.map_eq_bot_iff,
          QuotientGroup.ker_mk']
        exact hle
    have hQsolv : Group.IsSolvable (G ⧸ N) :=
      Group.isSolvable_of_surjective (QuotientGroup.mk'_surjective N)
    have hcomm : ∀ a b : G ⧸ N, a * b = b * a := IsSimpleGroup.comm_iff_isSolvable.mpr hQsolv
    have hQ1 : Nat.card (G ⧸ N) ≠ 1 := (Finite.one_lt_card (α := G ⧸ N)).ne'
    obtain ⟨p, hp, hpd⟩ := Nat.exists_prime_and_dvd hQ1
    have := Fact.mk hp
    obtain ⟨g, hg⟩ := exists_prime_orderOf_dvd_card' p hpd
    have hzn : (Subgroup.zpowers g).Normal := ⟨fun a ha b => by
      rw [hcomm b a, mul_assoc, mul_inv_cancel, mul_one]; exact ha⟩
    have hzt : Subgroup.zpowers g = ⊤ := by
      rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal _ hzn with h | h
      · exfalso
        rw [Subgroup.zpowers_eq_bot] at h
        rw [h, orderOf_one] at hg
        exact hp.one_lt.ne hg
      · exact h
    have hQcard : Nat.card (G ⧸ N) = p := by
      rw [← hg, ← Nat.card_zpowers, hzt, Subgroup.card_top]
    have hidx : N.index = p := by rw [Subgroup.index_eq_card]; exact hQcard
    refine ⟨N, hNn, hidx ▸ hp, ?_⟩
    have h3 := Subgroup.card_mul_index N
    rw [hidx] at h3
    have h2 := hp.two_le
    have h1 : 0 < Nat.card N := Nat.card_pos
    nlinarith
  intro Ω _ W A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 k y n hn1 hnp hSolv hUniq hcard
  unfold wcLlsSolvPt at hSolv
  obtain ⟨hyP, hyc, hDs, -⟩ := hSolv

  have hdesc : ∀ (M : Type u) [Field M] [Algebra A M] [Algebra M L] [IsScalarTower A M L],
      ∃ z : Ideal ↥(integralClosure A M), z.IsPrime ∧
        z.comap (algebraMap A ↥(integralClosure A M)) = 𝔭 ∧ wcLlsUniq A M 𝔭 z := by
    intro M _ _ _ _
    let ι : integralClosure A M →ₐ[A] integralClosure A L :=
      (IsScalarTower.toAlgHom A M L).mapIntegralClosure
    have hι : Function.Injective ι := by
      intro a b hab
      apply Subtype.ext
      apply (algebraMap M L).injective
      exact congrArg Subtype.val hab
    refine ⟨y.comap ι, Ideal.IsPrime.comap ι, ?_, ?_⟩
    · rw [← hyc]
      ext a
      rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, AlgHom.commutes]
    · intro z' hz' hz'c
      have := hz'
      letI : Algebra (integralClosure A M) (integralClosure A L) := ι.toRingHom.toAlgebra
      have : IsScalarTower A (integralClosure A M) (integralClosure A L) :=
        IsScalarTower.of_algebraMap_eq (fun a => (ι.commutes a).symm)
      have : Algebra.IsIntegral (integralClosure A M) (integralClosure A L) :=
        Algebra.IsIntegral.tower_top A
      have hker : RingHom.ker (algebraMap (integralClosure A M) (integralClosure A L)) ≤ z' := by
        intro x hx
        rw [RingHom.mem_ker] at hx
        have : x = 0 := hι (by rw [map_zero]; exact hx)
        rw [this]
        exact z'.zero_mem
      obtain ⟨Q, hQ, hQz⟩ := Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain z' hker
      have hQy : Q = y := by
        apply hUniq Q hQ
        rw [← hz'c, ← hQz]
        ext a
        change algebraMap A _ a ∈ Q ↔
          algebraMap (integralClosure A M) (integralClosure A L) (algebraMap A _ a) ∈ Q
        rw [← IsScalarTower.algebraMap_apply]
      rw [← hQz, hQy]
      rfl
  have hdecTop : wcLlsDec A K L y = ⊤ := hdec A K L y hyP (by rw [hyc]; exact hUniq)
  have hGs : Group.IsSolvable (L ≃ₐ[K] L) := by
    rw [hdecTop] at hDs
    exact Group.isSolvable_of_surjective
      (f := (Subgroup.topEquiv (G := L ≃ₐ[K] L)).toMonoidHom)
      (Subgroup.topEquiv (G := L ≃ₐ[K] L)).surjective
  have hGc : Nat.card (L ≃ₐ[K] L) = n := by rw [← hcard, hdecTop, Subgroup.card_top]
  obtain ⟨H, hHn, hHp, hHlt⟩ := hpi _ hGs (by rw [hGc]; exact hn1)
  have := hHn
  have hAML : IsScalarTower A (IntermediateField.fixedField H) L :=
    IsScalarTower.of_algebraMap_eq (fun a => rfl)
  have : IsGalois K (IntermediateField.fixedField H) :=
    IsGalois.of_fixedField_normal_subgroup H
  have : IsGalois (IntermediateField.fixedField H) L :=
    IsGalois.tower_top_of_isGalois K (IntermediateField.fixedField H) L
  obtain ⟨z, hzP, hzc, hzU⟩ := hdesc (IntermediateField.fixedField H)
  have hdz : wcLlsDec A K (IntermediateField.fixedField H) z = ⊤ :=
    hdec A K _ z hzP (by rw [hzc]; exact hzU)
  have hzcard : Nat.card ↥(wcLlsDec A K (IntermediateField.fixedField H) z) = H.index := by
    rw [hdz, Subgroup.card_top,
      ← Nat.card_congr (IsGalois.normalAutEquivQuotient H).toEquiv, ← Subgroup.index_eq_card]
  have := Fact.mk hHp
  have : IsCyclic ↥(wcLlsDec A K (IntermediateField.fixedField H) z) :=
    isCyclic_of_prime_card hzcard
  refine ⟨hGs, IntermediateField.fixedField H, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, hAML, inferInstance, inferInstance,
    z, hzP, hzc, hzU, ?_, hzcard ▸ hHp, ?_⟩
  · exact Group.isSolvable_of_comm (fun a b => IsCyclic.commGroup.mul_comm a b)
  · rw [IsGalois.card_aut_eq_finrank, IntermediateField.finrank_fixedField_eq_card, ← hGc]
    exact hHlt

theorem wcpa_dj_lr1k_ndgq_local_invariants : ∀ (A₀ B₀ : Type u) [CommRing A₀] [CommRing B₀]
    (i : A₀ →+* B₀), Function.Injective i → i.Finite →
    ∀ (H₀ : Subgroup (B₀ ≃+* B₀)), Finite ↥H₀ → (∀ h ∈ H₀, ∀ a, h (i a) = i a) →
    (∀ b, (∀ h ∈ H₀, h b = b) → ∃ a, i a = b) →
    ∀ (p : Ideal A₀) (hp : p.IsPrime) (OA : Type u) [CommRing OA] (eA : A₀ →+* OA),
    @IsLocalization A₀ _ (@Ideal.primeCompl A₀ _ p hp) OA _ eA.toAlgebra →
    ∃ (B' : Type u) (_ : CommRing B') (α : OA →+* B') (H : Subgroup (B' ≃+* B')),
      α.Finite ∧ Function.Injective α ∧ Finite ↥H ∧ (∀ h ∈ H, ∀ a, h (α a) = α a) ∧
      (∀ b, (∀ h ∈ H, h b = b) → ∃ a, α a = b) ∧
      (∀ n n' : Ideal B', n.IsMaximal → n'.IsMaximal → ∃ h ∈ H, Ideal.comap h n = n') ∧
      ∀ (n : Ideal B') (hn : n.IsMaximal), ∃ (q : Ideal B₀) (hq : q.IsPrime), q.comap i = p ∧
        ∀ (OB : Type u) [CommRing OB] (eB : B₀ →+* OB),
          @IsLocalization B₀ _ (@Ideal.primeCompl B₀ _ q hq) OB _ eB.toAlgebra →
          ∃ β : B' →+* OB, @IsLocalization B' _ (@Ideal.primeCompl B' _ n hn.isPrime) _ _
              β.toAlgebra ∧ ∀ a, β (α (eA a)) = eB (i a) :=
by
  intro A₀ B₀ _ _ i hi hif H₀ hH₀f hH₀i hH₀inv p hp OA _ eA hloc
  classical
  letI : Algebra A₀ OA := eA.toAlgebra
  haveI : IsLocalization p.primeCompl OA := hloc
  haveI : Finite ↥H₀ := hH₀f
  obtain ⟨B', _, _, _⟩ : ∃ (B' : Type u) (_ : CommRing B') (_ : Algebra B₀ B'),
      IsLocalization (Submonoid.map i p.primeCompl) B' :=
    ⟨Localization (Submonoid.map i p.primeCompl), inferInstance, inferInstance, inferInstance⟩

  obtain ⟨α, hαdef⟩ : ∃ α : OA →+* B',
      α = IsLocalization.map B' i (Submonoid.le_comap_map p.primeCompl) := ⟨_, rfl⟩
  have hα : ∀ a, α (eA a) = algebraMap B₀ B' (i a) := by
    intro a; rw [hαdef]; exact IsLocalization.map_eq _ a
  have hαinj : Function.Injective α := by
    rw [hαdef]; exact IsLocalization.map_injective_of_injective p.primeCompl OA B' hi
  have hαfin : α.Finite := by
    rw [hαdef]; exact RingHom.finite_localizationPreserves i p.primeCompl OA B' hif

  have hTpres : ∀ h : ↥H₀, Submonoid.map (h : B₀ ≃+* B₀).toMonoidHom
      (Submonoid.map i p.primeCompl) = Submonoid.map i p.primeCompl := by
    intro h
    ext x
    simp only [Submonoid.mem_map]
    constructor
    · rintro ⟨y, ⟨a, ha, rfl⟩, rfl⟩
      exact ⟨a, ha, (hH₀i _ h.2 a).symm⟩
    · rintro ⟨a, ha, rfl⟩
      exact ⟨i a, ⟨a, ha, rfl⟩, hH₀i _ h.2 a⟩
  have hkey : ∀ f g : B' ≃+* B',
      (∀ b, f (algebraMap B₀ B' b) = g (algebraMap B₀ B' b)) → f = g := by
    intro f g hfg
    have : (f : B' →+* B') = g :=
      IsLocalization.ringHom_ext (Submonoid.map i p.primeCompl) (RingHom.ext fun b => hfg b)
    exact RingEquiv.ext fun x => DFunLike.congr_fun this x

  obtain ⟨Φ, hΦ⟩ : ∃ Φ : ↥H₀ →* (B' ≃+* B'), ∀ (h : ↥H₀) (b : B₀),
      Φ h (algebraMap B₀ B' b) = algebraMap B₀ B' ((h : B₀ ≃+* B₀) b) := by
    have e : ∀ (h : ↥H₀) (b : B₀),
        IsLocalization.ringEquivOfRingEquiv B' B' (h : B₀ ≃+* B₀) (hTpres h)
          (algebraMap B₀ B' b) = algebraMap B₀ B' ((h : B₀ ≃+* B₀) b) :=
      fun h b => IsLocalization.ringEquivOfRingEquiv_eq _ b
    refine ⟨MonoidHom.mk' (fun h =>
      IsLocalization.ringEquivOfRingEquiv B' B' (h : B₀ ≃+* B₀) (hTpres h)) ?_, e⟩
    intro h₁ h₂
    apply hkey
    intro b
    show IsLocalization.ringEquivOfRingEquiv B' B' ((h₁ * h₂ : ↥H₀) : B₀ ≃+* B₀)
        (hTpres (h₁ * h₂)) (algebraMap B₀ B' b) =
      IsLocalization.ringEquivOfRingEquiv B' B' (h₁ : B₀ ≃+* B₀) (hTpres h₁)
        (IsLocalization.ringEquivOfRingEquiv B' B' (h₂ : B₀ ≃+* B₀) (hTpres h₂)
          (algebraMap B₀ B' b))
    rw [e, e, e]
    rfl
  have hHfin : Finite ↥Φ.range := Finite.of_surjective Φ.rangeRestrict Φ.rangeRestrict_surjective
  have hmemH : ∀ h : ↥H₀, Φ h ∈ Φ.range := fun h => MonoidHom.mem_range.mpr ⟨h, rfl⟩
  have hfix : ∀ g ∈ Φ.range, ∀ a, g (α a) = α a := by
    intro g hg
    obtain ⟨h, rfl⟩ := MonoidHom.mem_range.mp hg
    have : ((Φ h : B' →+* B').comp α) = α := by
      apply IsLocalization.ringHom_ext p.primeCompl
      ext a
      show Φ h (α (eA a)) = α (eA a)
      rw [hα, hΦ, hH₀i _ h.2]
    intro a
    exact DFunLike.congr_fun this a

  have hinv : ∀ y : B', (∀ g ∈ Φ.range, g y = y) → ∃ x, α x = y := by
    intro y hy
    obtain ⟨⟨b, t⟩, hbt⟩ := IsLocalization.surj (Submonoid.map i p.primeCompl) y
    have hbt' : y * algebraMap B₀ B' (t : B₀) = algebraMap B₀ B' b := hbt
    obtain ⟨s, hs, hst⟩ := Submonoid.mem_map.mp t.2
    have hyfix : ∀ h : ↥H₀,
        algebraMap B₀ B' ((h : B₀ ≃+* B₀) b) = algebraMap B₀ B' b := by
      intro h
      have e := congrArg (Φ h) hbt'
      rw [map_mul, hy _ (hmemH h), hΦ, hΦ, ← hst, hH₀i _ h.2] at e
      rw [← e, ← hbt', ← hst]
    have hw : ∀ h : ↥H₀, ∃ u ∈ p.primeCompl, i u * (h : B₀ ≃+* B₀) b = i u * b := by
      intro h
      obtain ⟨c, hc⟩ :=
        (IsLocalization.eq_iff_exists (Submonoid.map i p.primeCompl) B').mp (hyfix h)
      obtain ⟨u, hu, huc⟩ := Submonoid.mem_map.mp c.2
      exact ⟨u, hu, by rw [huc]; exact hc⟩
    choose u hu hub using hw
    haveI : Fintype ↥H₀ := Fintype.ofFinite _
    have hU : (∏ h : ↥H₀, u h) ∈ p.primeCompl := Submonoid.prod_mem _ (fun h _ => hu h)
    have hUb : ∀ h : ↥H₀,
        i (∏ h : ↥H₀, u h) * (h : B₀ ≃+* B₀) b = i (∏ h : ↥H₀, u h) * b := by
      intro h
      rw [← Finset.mul_prod_erase Finset.univ u (Finset.mem_univ h), map_mul,
        mul_comm (i (u h)), mul_assoc, mul_assoc, hub h]
    obtain ⟨a, ha⟩ := hH₀inv (i (∏ h : ↥H₀, u h) * b) (fun h hh => by
      rw [map_mul, hH₀i h hh]; exact hUb ⟨h, hh⟩)
    refine ⟨IsLocalization.mk' OA a ⟨(∏ h : ↥H₀, u h) * s, p.primeCompl.mul_mem hU hs⟩, ?_⟩
    rw [hαdef, IsLocalization.map_mk', IsLocalization.mk'_eq_iff_eq_mul]
    show algebraMap B₀ B' (i a) = y * algebraMap B₀ B' (i ((∏ h : ↥H₀, u h) * s))
    rw [ha]
    simp only [map_mul]
    rw [hst, ← hbt']
    ring

  haveI : IsLocalRing OA := IsLocalization.AtPrime.isLocalRing OA p
  letI : Algebra OA B' := α.toAlgebra
  haveI : Finite ↥Φ.range := hHfin
  haveI : Algebra.IsInvariant OA B' ↥Φ.range :=
    Algebra.IsInvariant.mk fun b hb => hinv b fun g hg => hb ⟨g, hg⟩
  haveI : SMulCommClass ↥Φ.range OA B' := ⟨fun g x b => by
    show (g : B' ≃+* B') (α x * b) = α x * (g : B' ≃+* B') b
    rw [map_mul, hfix _ g.2]⟩
  haveI : Algebra.IsIntegral OA B' := Algebra.IsInvariant.isIntegral OA B' ↥Φ.range
  have hmax : ∀ n : Ideal B', n.IsMaximal → Ideal.comap α n = IsLocalRing.maximalIdeal OA := by
    intro n hn
    exact IsLocalRing.eq_maximalIdeal (Ideal.IsMaximal.under OA n)
  have htrans : ∀ n n' : Ideal B', n.IsMaximal → n'.IsMaximal →
      ∃ h ∈ Φ.range, Ideal.comap h n = n' := by
    intro n n' hn hn'
    haveI := hn.isPrime
    haveI := hn'.isPrime
    obtain ⟨g, hg⟩ := Algebra.IsInvariant.exists_smul_of_under_eq OA B' ↥Φ.range n n'
      ((hmax n hn).trans (hmax n' hn').symm)
    refine ⟨((g⁻¹ : ↥Φ.range) : B' ≃+* B'), (g⁻¹).2, ?_⟩
    rw [hg, Ideal.pointwise_smul_def]
    show Ideal.comap ((g : B' ≃+* B').symm) n = _
    rw [Ideal.comap_symm]
    rfl
  refine ⟨B', inferInstance, α, Φ.range, hαfin, hαinj, hHfin, hfix, hinv, htrans, ?_⟩

  intro n hn
  haveI := hn.isPrime
  refine ⟨Ideal.comap (algebraMap B₀ B') n, Ideal.comap_isPrime _ n, ?_, ?_⟩
  · rw [Ideal.comap_comap]
    have e : (algebraMap B₀ B').comp i = α.comp eA := RingHom.ext fun a => (hα a).symm
    rw [e, ← Ideal.comap_comap, hmax n hn]
    exact IsLocalization.AtPrime.under_maximalIdeal OA p
  · intro OB _ eB hlocB
    letI : Algebra B₀ OB := eB.toAlgebra
    haveI : IsLocalization (Ideal.comap (algebraMap B₀ B') n).primeCompl OB := hlocB
    have hTq : Submonoid.map i p.primeCompl ≤
        (Ideal.comap (algebraMap B₀ B') n).primeCompl := by
      intro t ht
      rw [Ideal.mem_primeCompl_iff, Ideal.mem_comap]
      intro hmem
      exact hn.ne_top (Ideal.eq_top_of_isUnit_mem _ hmem
        (IsLocalization.map_units B' (⟨t, ht⟩ : Submonoid.map i p.primeCompl)))
    have hu : ∀ t : Submonoid.map i p.primeCompl, IsUnit (eB t) := fun t =>
      IsLocalization.map_units OB
        (⟨t, hTq t.2⟩ : (Ideal.comap (algebraMap B₀ B') n).primeCompl)
    obtain ⟨β, hβ⟩ : ∃ β : B' →+* OB, ∀ b, β (algebraMap B₀ B' b) = eB b :=
      ⟨IsLocalization.lift hu, IsLocalization.lift_eq hu⟩
    refine ⟨β, ?_, fun a => by rw [hα, hβ]⟩
    letI : Algebra B' OB := β.toAlgebra
    haveI : IsScalarTower B₀ B' OB := IsScalarTower.of_algebraMap_eq (fun b => (hβ b).symm)
    haveI := IsLocalization.isLocalization_of_submonoid_le B' OB (Submonoid.map i p.primeCompl)
      (Ideal.comap (algebraMap B₀ B') n).primeCompl hTq
    refine IsLocalization.isLocalization_of_is_exists_mul_mem OB
      (Submonoid.map (algebraMap B₀ B') (Ideal.comap (algebraMap B₀ B') n).primeCompl)
      n.primeCompl ?_ ?_
    · rintro _ ⟨x, hx, rfl⟩
      exact hx
    · rintro ⟨y, hy⟩
      obtain ⟨⟨b, t⟩, hbt⟩ := IsLocalization.surj (Submonoid.map i p.primeCompl) y
      have hbt' : y * algebraMap B₀ B' (t : B₀) = algebraMap B₀ B' b := hbt
      have htu : IsUnit (algebraMap B₀ B' (t : B₀)) := IsLocalization.map_units B' t
      refine ⟨algebraMap B₀ B' (t : B₀), Submonoid.mem_map.mpr ⟨b, ?_, ?_⟩⟩
      · rw [Ideal.mem_primeCompl_iff, Ideal.mem_comap, ← hbt']
        intro hmem
        rcases hn.isPrime.mem_or_mem hmem with h1 | h1
        · exact (Ideal.mem_primeCompl_iff.mp hy) h1
        · exact hn.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 htu)
      · rw [mul_comm]; exact hbt'.symm

theorem wcNd_hi_tensor_action : ∀ (A R B' : Type u) [CommRing A] [CommRing R] [CommRing B']
    [Algebra A R] [Algebra A B'] (H : Subgroup (B' ≃+* B')),
    Module.Flat A R → Function.Injective (algebraMap A B') → Finite ↥H →
    (∀ h ∈ H, ∀ a, h (algebraMap A B' a) = algebraMap A B' a) →
    (∀ b, (∀ h ∈ H, h b = b) → ∃ a, algebraMap A B' a = b) →
    ∃ G : Subgroup (TensorProduct A R B' ≃+* TensorProduct A R B'), Finite ↥G ∧
      (∀ g ∈ G, ∀ r : R, g (TensorProduct.tmul A r (1 : B')) = TensorProduct.tmul A r (1 : B')) ∧
      (∀ h ∈ H, ∃ g ∈ G, ∀ b : B', g (TensorProduct.tmul A (1 : R) b) =
        TensorProduct.tmul A (1 : R) (h b)) ∧
      (∀ t : TensorProduct A R B', (∀ g ∈ G, g t = t) →
        ∃ r : R, TensorProduct.tmul A r (1 : B') = t) ∧
      Function.Injective (fun r : R => TensorProduct.tmul A r (1 : B')) :=
by
  intro A R B' _ _ _ _ _ H hflat hinj hHf hHα hinv
  classical
  haveI := hflat
  haveI := hHf
  letI : Fintype ↥H := Fintype.ofFinite _
  let σ : ↥H → (B' →ₐ[A] B') := fun h =>
    (AlgEquiv.ofRingEquiv (f := (h : B' ≃+* B')) (hHα h h.2)).toAlgHom
  let Ψ : ↥H → (TensorProduct A R B' ≃+* TensorProduct A R B') := fun h =>
    (Algebra.TensorProduct.congr (AlgEquiv.refl : R ≃ₐ[A] R)
      (AlgEquiv.ofRingEquiv (f := (h : B' ≃+* B')) (hHα h h.2))).toRingEquiv
  have hΨ : ∀ (h : ↥H) (r : R) (b : B'),
      Ψ h (TensorProduct.tmul A r b) = TensorProduct.tmul A r ((h : B' ≃+* B') b) := by
    intro h r b
    show (Algebra.TensorProduct.congr (AlgEquiv.refl : R ≃ₐ[A] R)
      (AlgEquiv.ofRingEquiv (f := (h : B' ≃+* B')) (hHα h h.2))) (TensorProduct.tmul A r b) = _
    rw [Algebra.TensorProduct.congr_apply, Algebra.TensorProduct.map_tmul]
    rfl
  have hmul : ∀ h₁ h₂ : ↥H, Ψ (h₁ * h₂) = Ψ h₁ * Ψ h₂ := by
    intro h₁ h₂
    apply RingEquiv.ext
    intro t
    induction t using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul r b =>
      show Ψ (h₁ * h₂) (TensorProduct.tmul A r b) = Ψ h₁ (Ψ h₂ (TensorProduct.tmul A r b))
      rw [hΨ, hΨ, hΨ]
      rfl
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  let φ : ↥H →* (TensorProduct A R B' ≃+* TensorProduct A R B') := MonoidHom.mk' Ψ hmul
  have hφ : ∀ h, φ h = Ψ h := fun h => rfl

  have hiv : Function.Injective (fun r : R => TensorProduct.tmul A r (1 : B')) := by
    have h1 : Function.Injective (LinearMap.lTensor R (Algebra.linearMap A B')) :=
      Module.Flat.lTensor_preserves_injective_linearMap (Algebra.linearMap A B') hinj
    have e : (fun r : R => TensorProduct.tmul A r (1 : B')) =
        (LinearMap.lTensor R (Algebra.linearMap A B')) ∘ (TensorProduct.rid A R).symm := by
      funext r
      simp [TensorProduct.rid_symm_apply]
    rw [e]
    exact h1.comp (TensorProduct.rid A R).symm.injective

  have hiii : ∀ t : TensorProduct A R B', (∀ g ∈ φ.range, g t = t) →
      ∃ r : R, TensorProduct.tmul A r (1 : B') = t := by
    intro t ht
    let ιA : A →ₗ[A] B' := Algebra.linearMap A B'
    let δ : B' →ₗ[A] (↥H → B') := LinearMap.pi (fun h => (σ h).toLinearMap - LinearMap.id)
    have hδ : ∀ b h, δ b h = (h : B' ≃+* B') b - b := fun b h => rfl
    have hex : Function.Exact ιA δ := by
      intro y
      constructor
      · intro hy
        have hfix : ∀ h ∈ H, h y = y := by
          intro h hh
          have := congrFun hy ⟨h, hh⟩
          rw [hδ] at this
          exact sub_eq_zero.mp this
        obtain ⟨a, ha⟩ := hinv y hfix
        exact ⟨a, ha⟩
      · rintro ⟨a, rfl⟩
        funext h
        rw [hδ]
        show (h : B' ≃+* B') (algebraMap A B' a) - algebraMap A B' a = 0
        rw [hHα h h.2, sub_self]
    have hex' := Module.Flat.lTensor_exact R hex
    let Φ := TensorProduct.piRight A A R (fun _ : ↥H => B')
    have hΦ : ∀ x, Φ (LinearMap.lTensor R δ x) =
        fun h => LinearMap.lTensor R (σ h).toLinearMap x - x := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => funext h; simp
      | tmul r b =>
        funext h
        rw [LinearMap.lTensor_tmul, LinearMap.lTensor_tmul]
        simp only [Φ, TensorProduct.piRight_apply, TensorProduct.piRightHom_tmul]
        rw [hδ, TensorProduct.tmul_sub]
        rfl
      | add x y hx hy =>
        rw [map_add, map_add, hx, hy]
        funext h
        simp only [Pi.add_apply, map_add]
        abel
    have hlt : ∀ h : ↥H, LinearMap.lTensor R (σ h).toLinearMap t = t := by
      intro h
      have e : ∀ x, LinearMap.lTensor R (σ h).toLinearMap x = Ψ h x := by
        intro x
        induction x using TensorProduct.induction_on with
        | zero => simp only [map_zero]
        | tmul r b => rw [LinearMap.lTensor_tmul, hΨ]; rfl
        | add x y hx hy => rw [map_add, map_add, hx, hy]
      rw [e]
      exact ht (φ h) (MonoidHom.mem_range.mpr ⟨h, rfl⟩)
    have h0 : LinearMap.lTensor R δ t = 0 := by
      apply Φ.injective
      rw [hΦ, map_zero]
      funext h
      rw [hlt h, sub_self]
      rfl
    obtain ⟨s, hs⟩ := (hex' t).mp h0
    refine ⟨TensorProduct.rid A R s, ?_⟩
    rw [← hs]
    clear hs
    induction s using TensorProduct.induction_on with
    | zero => simp
    | tmul r a =>
      rw [TensorProduct.rid_tmul, LinearMap.lTensor_tmul, TensorProduct.smul_tmul]
      show TensorProduct.tmul A r (a • (1 : B')) = TensorProduct.tmul A r (algebraMap A B' a)
      rw [Algebra.algebraMap_eq_smul_one]
    | add x y hx hy => rw [map_add, map_add, TensorProduct.add_tmul, hx, hy]
  refine ⟨φ.range, ?_, ?_, ?_, hiii, hiv⟩
  · exact Finite.of_surjective φ.rangeRestrict φ.rangeRestrict_surjective
  · intro g hg r
    obtain ⟨h, rfl⟩ := MonoidHom.mem_range.mp hg
    rw [hφ, hΨ, map_one]
  · intro h hh
    exact ⟨φ ⟨h, hh⟩, MonoidHom.mem_range.mpr ⟨_, rfl⟩, fun b => hΨ ⟨h, hh⟩ 1 b⟩

theorem wcNd_hi_orbit_complete : ∀ (A R B' : Type u) [CommRing A] [IsLocalRing A] [CommRing R]
    [CommRing B'] [Algebra A R] [Algebra A B'] (H : Subgroup (B' ≃+* B'))
    (G : Subgroup (TensorProduct A R B' ≃+* TensorProduct A R B')) (ε : TensorProduct A R B'),
    wcNdIsHens (IsLocalRing.maximalIdeal A) R (algebraMap A R) →
    (∀ x : R, ∃ a : A, ¬ IsUnit (x - algebraMap A R a)) → Module.Finite A B' → Finite ↥G →
    (∀ g ∈ G, ∀ r : R, g (TensorProduct.tmul A r (1 : B')) = TensorProduct.tmul A r (1 : B')) →
    (∀ h ∈ H, ∃ g ∈ G, ∀ b : B', g (TensorProduct.tmul A (1 : R) b) =
      TensorProduct.tmul A (1 : R) (h b)) →
    (∀ n n' : Ideal B', n.IsMaximal → n'.IsMaximal → ∃ h ∈ H, Ideal.comap h n = n') →
    IsIdempotentElem ε → IsLocalRing (Localization.Away ε) →
    ∃ E : Finset (TensorProduct A R B'), (∀ f, f ∈ E ↔ ∃ g ∈ G, g ε = f) ∧
      (∀ f ∈ E, ∀ f' ∈ E, f ≠ f' → f * f' = 0) ∧ ∑ f ∈ E, f = 1 :=
by
  intro A R B' _ _ _ _ _ _ H G ε hR hres hfin hGf hGR hGH htrans hε hloc
  classical
  haveI hRl : IsLocalRing R := hR.1.toIsLocalRing
  have hRu : ∀ a, IsUnit (algebraMap A R a) ↔ a ∉ IsLocalRing.maximalIdeal A := hR.2.1

  have hε0 : ε ≠ 0 := by
    intro h0
    have hu : IsUnit (algebraMap (TensorProduct A R B') (Localization.Away ε) ε) :=
      IsLocalization.Away.algebraMap_isUnit ε
    have h1 : algebraMap (TensorProduct A R B') (Localization.Away ε) ε = 0 :=
      (congrArg (algebraMap (TensorProduct A R B') (Localization.Away ε)) h0).trans (map_zero _)
    rw [h1] at hu
    exact not_isUnit_zero hu

  have hzero : ∀ y : TensorProduct A R B',
      algebraMap (TensorProduct A R B') (Localization.Away ε) y = 0 → ε * y = 0 := by
    intro y hy
    obtain ⟨⟨m, hm⟩, hmy⟩ :=
      (IsLocalization.map_eq_zero_iff (Submonoid.powers ε) (Localization.Away ε) y).mp hy
    obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hm
    cases k with
    | zero =>
      simp only [pow_zero, one_mul] at hmy
      rw [hmy, mul_zero]
    | succ k =>
      simp only [hε.pow_succ_eq] at hmy
      exact hmy

  have hdich : ∀ x : TensorProduct A R B', IsIdempotentElem x → ε * x = 0 ∨ ε * x = ε := by
    intro x hx
    have hpx : IsIdempotentElem (algebraMap (TensorProduct A R B') (Localization.Away ε) x) :=
      hx.map _
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self
      (algebraMap (TensorProduct A R B') (Localization.Away ε) x) with hu | hu
    · right
      have h1 : algebraMap (TensorProduct A R B') (Localization.Away ε) (1 - x) = 0 := by
        rw [map_sub, map_one]
        apply hu.mul_left_cancel
        rw [mul_sub, mul_one, hpx.eq, sub_self, mul_zero]
      have h2 := hzero _ h1
      rw [mul_sub, mul_one, sub_eq_zero] at h2
      exact h2.symm
    · left
      apply hzero
      apply hu.mul_left_cancel
      rw [sub_mul, one_mul, hpx.eq, sub_self, mul_zero]

  have horth : ∀ σ : TensorProduct A R B' ≃+* TensorProduct A R B', σ ε ≠ ε → ε * σ ε = 0 := by
    intro σ hσ
    have h1 := hdich (σ ε) (hε.map σ)
    have h2 := hdich (σ.symm ε) (hε.map σ.symm)
    have h2' : σ ε * ε = 0 ∨ σ ε * ε = σ ε := by
      rcases h2 with h | h
      · left
        have h3 := congrArg σ h
        rwa [map_mul, map_zero, RingEquiv.apply_symm_apply] at h3
      · right
        have h3 := congrArg σ h
        rwa [map_mul, RingEquiv.apply_symm_apply] at h3
    rcases h1 with h | h
    · exact h
    · rcases h2' with h' | h'
      · exfalso; apply hε0; rw [← h, mul_comm, h']
      · exfalso; apply hσ; rw [← h', mul_comm, h]

  have hdec : ∀ t : TensorProduct A R B', ∃ b : B', t - TensorProduct.tmul A (1 : R) b ∈
      Ideal.map (algebraMap R (TensorProduct A R B')) (IsLocalRing.maximalIdeal R) := by
    intro t
    induction t using TensorProduct.induction_on with
    | zero => exact ⟨0, by simp⟩
    | tmul r b₀ =>
      obtain ⟨a, ha⟩ := hres r
      refine ⟨a • b₀, ?_⟩
      have e1 : TensorProduct.tmul A r b₀ - TensorProduct.tmul A (1 : R) (a • b₀) =
          algebraMap R (TensorProduct A R B') (r - algebraMap A R a) *
            TensorProduct.tmul A (1 : R) b₀ := by
        show _ = TensorProduct.tmul A (r - algebraMap A R a) (1 : B') *
          TensorProduct.tmul A (1 : R) b₀
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, TensorProduct.sub_tmul,
          ← TensorProduct.smul_tmul, Algebra.algebraMap_eq_smul_one]
      rw [e1]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _
        ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr ha)))
    | add x y hx hy =>
      obtain ⟨b₁, h₁⟩ := hx
      obtain ⟨b₂, h₂⟩ := hy
      refine ⟨b₁ + b₂, ?_⟩
      have e2 : x + y - TensorProduct.tmul A (1 : R) (b₁ + b₂) =
          (x - TensorProduct.tmul A (1 : R) b₁) + (y - TensorProduct.tmul A (1 : R) b₂) := by
        rw [TensorProduct.tmul_add]; abel
      rw [e2]
      exact Ideal.add_mem _ h₁ h₂

  haveI : Module.Finite A B' := hfin
  have hcR : ∀ M : Ideal (TensorProduct A R B'), M.IsMaximal →
      Ideal.comap (algebraMap R (TensorProduct A R B')) M = IsLocalRing.maximalIdeal R := by
    intro M hM
    haveI := hM
    haveI : (Ideal.comap (algebraMap R (TensorProduct A R B')) M).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap R (TensorProduct A R B'))
        (fun x => Algebra.IsIntegral.isIntegral (R := R) x) M
    exact IsLocalRing.eq_maximalIdeal this
  have hcB : ∀ M : Ideal (TensorProduct A R B'), M.IsMaximal →
      (Ideal.comap (Algebra.TensorProduct.includeRight : B' →ₐ[A] TensorProduct A R B') M).IsMaximal := by
    intro M hM
    haveI hP : (Ideal.comap (Algebra.TensorProduct.includeRight : B' →ₐ[A] TensorProduct A R B')
      M).IsPrime := Ideal.comap_isPrime _ M
    have hA : Ideal.comap (algebraMap A B')
        (Ideal.comap (Algebra.TensorProduct.includeRight : B' →ₐ[A] TensorProduct A R B') M) =
        IsLocalRing.maximalIdeal A := by
      ext a
      rw [Ideal.mem_comap, Ideal.mem_comap]
      have e : (Algebra.TensorProduct.includeRight : B' →ₐ[A] TensorProduct A R B')
          (algebraMap A B' a) = algebraMap R (TensorProduct A R B') (algebraMap A R a) := by
        rw [AlgHom.commutes, Algebra.TensorProduct.algebraMap_apply]
        rfl
      rw [e, ← Ideal.mem_comap, hcR M hM, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hRu,
        not_not]
    haveI : Algebra.IsIntegral A B' := Algebra.IsIntegral.of_finite A B'
    refine Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap A B')
      (fun x => Algebra.IsIntegral.isIntegral (R := A) x) _ ?_
    rw [hA]
    exact IsLocalRing.maximalIdeal.isMaximal A

  haveI := hGf
  let o : G → TensorProduct A R B' := fun g => (g : TensorProduct A R B' ≃+* TensorProduct A R B') ε
  let E : Finset (TensorProduct A R B') := (Set.finite_range o).toFinset
  have hmem : ∀ f, f ∈ E ↔ ∃ g ∈ G, g ε = f := by
    intro f
    rw [Set.Finite.mem_toFinset, Set.mem_range]
    constructor
    · rintro ⟨g, rfl⟩; exact ⟨g, g.2, rfl⟩
    · rintro ⟨g, hg, rfl⟩; exact ⟨⟨g, hg⟩, rfl⟩
  have hE2 : ∀ f ∈ E, ∀ f' ∈ E, f ≠ f' → f * f' = 0 := by
    intro f hf f' hf' hne
    obtain ⟨g₁, -, rfl⟩ := (hmem f).mp hf
    obtain ⟨g₂, -, rfl⟩ := (hmem f').mp hf'
    have hσ : (g₂.trans g₁.symm) ε ≠ ε := by
      intro h
      apply hne
      rw [RingEquiv.trans_apply] at h
      have h3 := congrArg g₁ h
      rw [RingEquiv.apply_symm_apply] at h3
      exact h3.symm
    have h0 := horth _ hσ
    have h3 := congrArg g₁ h0
    rwa [map_mul, map_zero, RingEquiv.trans_apply, RingEquiv.apply_symm_apply] at h3
  refine ⟨E, hmem, hE2, ?_⟩
  obtain ⟨s, hs⟩ : ∃ s, s = ∑ f ∈ E, f := ⟨_, rfl⟩
  rw [← hs]
  have hfs : ∀ f ∈ E, f * s = f := by
    intro f hf
    rw [hs, Finset.mul_sum, Finset.sum_eq_single_of_mem f hf]
    · obtain ⟨g, -, rfl⟩ := (hmem f).mp hf
      exact (hε.map g).eq
    · intro f' hf' hne
      exact hE2 f hf f' hf' hne.symm
  have hss : s * s = s := by
    calc s * s = ∑ f ∈ E, f * s := by rw [hs, Finset.sum_mul]
      _ = ∑ f ∈ E, f := Finset.sum_congr rfl hfs
      _ = s := hs.symm

  have hne1 : ¬ IsUnit (1 - ε) := by
    intro hu
    apply hε0
    have h4 : ε * (1 - ε) = 0 := by rw [mul_sub, mul_one, hε.eq, sub_self]
    exact hu.mul_left_eq_zero.mp h4
  obtain ⟨N, hN, hN1⟩ := exists_max_ideal_of_mem_nonunits (mem_nonunits_iff.mpr hne1)
  have hεN : ε ∉ N := by
    intro h
    apply hN.ne_top
    rw [Ideal.eq_top_iff_one]
    have h5 := N.add_mem h hN1
    rwa [add_sub_cancel] at h5
  have hkey : ∀ M : Ideal (TensorProduct A R B'), M.IsMaximal → ∃ f ∈ E, f ∉ M := by
    intro M hM
    obtain ⟨h, hH, hh⟩ := htrans _ _ (hcB M hM) (hcB N hN)
    obtain ⟨g, hg, hgb⟩ := hGH h hH
    refine ⟨g ε, (hmem _).mpr ⟨g, hg, rfl⟩, ?_⟩
    intro hgM
    obtain ⟨b, hb⟩ := hdec ε
    have hyN : ε - TensorProduct.tmul A (1 : R) b ∈ N := by
      have hle : Ideal.map (algebraMap R (TensorProduct A R B')) (IsLocalRing.maximalIdeal R) ≤ N := by
        rw [Ideal.map_le_iff_le_comap, hcR N hN]
      exact hle hb
    have hyM : g (ε - TensorProduct.tmul A (1 : R) b) ∈ M := by
      have hle : Ideal.map (algebraMap R (TensorProduct A R B')) (IsLocalRing.maximalIdeal R) ≤
          M.comap g := by
        rw [Ideal.map_le_iff_le_comap]
        intro r hr
        rw [Ideal.mem_comap, Ideal.mem_comap]
        have hgr : g (algebraMap R (TensorProduct A R B') r) =
            algebraMap R (TensorProduct A R B') r := hGR g hg r
        rw [hgr, ← Ideal.mem_comap, hcR M hM]
        exact hr
      exact hle hb
    have h1 : TensorProduct.tmul A (1 : R) (h b) ∈ M := by
      rw [← hgb]
      have h6 := M.sub_mem hgM hyM
      rwa [map_sub, sub_sub_cancel] at h6
    have h2 : b ∈ Ideal.comap h
        (Ideal.comap (Algebra.TensorProduct.includeRight : B' →ₐ[A] TensorProduct A R B') M) := by
      rw [Ideal.mem_comap, Ideal.mem_comap]
      exact h1
    rw [hh, Ideal.mem_comap, Algebra.TensorProduct.includeRight_apply] at h2
    apply hεN
    have h7 := N.add_mem hyN h2
    rwa [sub_add_cancel] at h7
  have hsu : IsUnit s := by
    by_contra hns
    obtain ⟨M, hM, hsM⟩ := exists_max_ideal_of_mem_nonunits (mem_nonunits_iff.mpr hns)
    obtain ⟨f, hf, hfM⟩ := hkey M hM
    apply hfM
    rw [← hfs f hf]
    exact M.mul_mem_left f hsM
  have h8 : s * (1 - s) = 0 := by rw [mul_sub, mul_one, hss, sub_self]
  exact (sub_eq_zero.mp (hsu.mul_right_eq_zero.mp h8)).symm

theorem wcNd_hi_orbit_descent : ∀ (R T : Type u) [CommRing R] [CommRing T] (j : R →+* T)
    (G : Subgroup (T ≃+* T)) (ε : T),
    Function.Injective j → Finite ↥G → (∀ g ∈ G, ∀ r, g (j r) = j r) →
    (∀ t, (∀ g ∈ G, g t = t) → ∃ r, j r = t) → IsIdempotentElem ε →
    (∃ E : Finset T, (∀ f, f ∈ E ↔ ∃ g ∈ G, g ε = f) ∧
      (∀ f ∈ E, ∀ f' ∈ E, f ≠ f' → f * f' = 0) ∧ ∑ f ∈ E, f = 1) →
    ∃ (I : Subgroup (Localization.Away ε ≃+* Localization.Away ε))
      (hI : ∀ r, ((algebraMap T (Localization.Away ε)).comp j) r ∈ wcNdFix I),
      Finite ↥I ∧
      Function.Bijective (((algebraMap T (Localization.Away ε)).comp j).codRestrict (wcNdFix I) hI) :=
by
  classical
  intro R T _ _ j G ε hinj hGf hfix hinv hε hEx
  obtain ⟨E, hE1, hE2, hE3⟩ := hEx
  haveI := hGf

  have hker : ∀ x : T, algebraMap T (Localization.Away ε) x = 0 ↔ ε * x = 0 := by
    intro x
    rw [IsLocalization.map_eq_zero_iff (Submonoid.powers ε) (Localization.Away ε) x]
    constructor
    · rintro ⟨⟨m, hm⟩, hmx⟩
      simp only at hmx
      obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hm
      cases n with
      | zero => rw [pow_zero, one_mul] at hmx; rw [hmx, mul_zero]
      | succ k => rw [hε.pow_succ_eq k] at hmx; exact hmx
    · intro h
      exact ⟨⟨ε, Submonoid.mem_powers ε⟩, h⟩
  have hπε : algebraMap T (Localization.Away ε) ε = 1 :=
    (IsIdempotentElem.iff_eq_one_of_isUnit (IsLocalization.Away.algebraMap_isUnit ε)).mp
      (hε.map (algebraMap T (Localization.Away ε)))
  have hsurj : Function.Surjective (algebraMap T (Localization.Away ε)) := by
    intro z
    obtain ⟨n, a, h⟩ := IsLocalization.Away.surj ε z
    refine ⟨a, ?_⟩
    rw [← h, hπε, one_pow, mul_one]

  let I : Subgroup (Localization.Away ε ≃+* Localization.Away ε) :=
    { carrier := {τ | ∃ d ∈ G, d ε = ε ∧ ∀ x, τ (algebraMap T (Localization.Away ε) x) =
          algebraMap T (Localization.Away ε) (d x)}
      one_mem' := ⟨1, G.one_mem, rfl, fun x => rfl⟩
      mul_mem' := by
        rintro τ₁ τ₂ ⟨d₁, hd₁, he₁, h₁⟩ ⟨d₂, hd₂, he₂, h₂⟩
        refine ⟨d₁ * d₂, G.mul_mem hd₁ hd₂, ?_, ?_⟩
        · rw [RingAut.mul_apply, he₂, he₁]
        · intro x
          rw [RingAut.mul_apply, RingAut.mul_apply, h₂, h₁]
      inv_mem' := by
        rintro τ ⟨d, hd, he, h⟩
        refine ⟨d⁻¹, G.inv_mem hd, ?_, ?_⟩
        · rw [RingAut.inv_apply]
          exact (RingEquiv.symm_apply_eq d).mpr he.symm
        · intro x
          rw [RingAut.inv_apply, RingAut.inv_apply]
          apply τ.injective
          rw [RingEquiv.apply_symm_apply, h, RingEquiv.apply_symm_apply] }
  have hImem : ∀ τ, τ ∈ I ↔ ∃ d ∈ G, d ε = ε ∧ ∀ x, τ (algebraMap T (Localization.Away ε) x) =
      algebraMap T (Localization.Away ε) (d x) := fun τ => Iff.rfl
  have hIf : Finite ↥I := by
    refine Finite.of_injective (β := ↥G)
      (fun τ : ↥I => ⟨Classical.choose ((hImem τ.1).mp τ.2),
        (Classical.choose_spec ((hImem τ.1).mp τ.2)).1⟩) ?_
    intro τ₁ τ₂ h
    have h' := congrArg Subtype.val h
    simp only at h'
    apply Subtype.ext
    apply RingEquiv.ext
    intro z
    obtain ⟨t, rfl⟩ := hsurj z
    rw [(Classical.choose_spec ((hImem τ₁.1).mp τ₁.2)).2.2 t,
      (Classical.choose_spec ((hImem τ₂.1).mp τ₂.2)).2.2 t, h']
  have hlift : ∀ d ∈ G, d ε = ε → ∃ τ ∈ I, ∀ x, τ (algebraMap T (Localization.Away ε) x) =
      algebraMap T (Localization.Away ε) (d x) := by
    intro d hd hdε
    have H : Submonoid.map d.toMonoidHom (Submonoid.powers ε) = Submonoid.powers ε := by
      rw [Submonoid.map_powers]
      show Submonoid.powers (d ε) = Submonoid.powers ε
      rw [hdε]
    have hτ := IsLocalization.ringEquivOfRingEquiv_eq (S := Localization.Away ε)
      (Q := Localization.Away ε) H
    exact ⟨_, (hImem _).mpr ⟨d, hd, hdε, hτ⟩, hτ⟩

  have hkill : ∀ x : T, (∀ g ∈ G, g x = x) → ε * x = 0 → x = 0 := by
    intro x hx hεx
    have hf : ∀ f ∈ E, f * x = 0 := by
      intro f hf
      obtain ⟨g, hg, rfl⟩ := (hE1 f).mp hf
      rw [← hx g hg, ← map_mul, hεx, map_zero]
    calc x = (∑ f ∈ E, f) * x := by rw [hE3, one_mul]
      _ = ∑ f ∈ E, f * x := Finset.sum_mul _ _ _
      _ = 0 := Finset.sum_eq_zero hf

  have hεE : ε ∈ E := (hE1 ε).mpr ⟨1, G.one_mem, rfl⟩
  have hcoset : ∀ s : T, ε * s = s → (∀ d ∈ G, d ε = ε → d s = s) →
      ∃ x : T, (∀ g ∈ G, g x = x) ∧ ε * x = s := by
    intro s hs hD
    have hch : ∀ f ∈ E, ∃ g ∈ G, g ε = f := fun f hf => (hE1 f).mp hf
    let h : T → (T ≃+* T) := fun f => if hf : f ∈ E then Classical.choose (hch f hf) else 1
    have hh : ∀ f ∈ E, h f ∈ G ∧ h f ε = f := by
      intro f hf
      simp only [h, dif_pos hf]
      exact Classical.choose_spec (hch f hf)
    have key : ∀ g ∈ G, ∀ f ∈ E, g ε = f → g s = h f s := by
      intro g hg f hf hgf
      obtain ⟨hhG, hhε⟩ := hh f hf
      have hd : ((h f)⁻¹ * g) ε = ε := by
        rw [RingAut.mul_apply, hgf, RingAut.inv_apply, RingEquiv.symm_apply_eq, hhε]
      have := hD _ (G.mul_mem (G.inv_mem hhG) hg) hd
      rw [RingAut.mul_apply, RingAut.inv_apply, RingEquiv.symm_apply_eq] at this
      exact this
    have hgE : ∀ g ∈ G, ∀ f ∈ E, g f ∈ E := by
      intro g hg f hf
      obtain ⟨hhG, hhε⟩ := hh f hf
      exact (hE1 _).mpr ⟨g * h f, G.mul_mem hg hhG, by rw [RingAut.mul_apply, hhε]⟩
    refine ⟨∑ f ∈ E, h f s, ?_, ?_⟩
    · intro g hg
      rw [map_sum]
      refine Finset.sum_nbij' (fun f => g f) (fun f => g.symm f) ?_ ?_ ?_ ?_ ?_
      · intro f hf
        exact hgE g hg f hf
      · intro f hf
        have := hgE g⁻¹ (G.inv_mem hg) f hf
        rw [RingAut.inv_apply] at this
        exact this
      · intro f _
        exact g.symm_apply_apply f
      · intro f _
        exact g.apply_symm_apply f
      · intro f hf
        obtain ⟨hhG, hhε⟩ := hh f hf
        show g (h f s) = h (g f) s
        exact (RingAut.mul_apply g (h f) s).symm.trans
          (key _ (G.mul_mem hg hhG) _ (hgE g hg f hf) (by rw [RingAut.mul_apply, hhε]))
    · rw [Finset.mul_sum, Finset.sum_eq_single_of_mem ε hεE]
      · obtain ⟨hhG, hhε⟩ := hh ε hεE
        rw [hD _ hhG hhε, hs]
      · intro f hf hfε
        obtain ⟨hhG, hhε⟩ := hh f hf
        have hfs : h f s = f * h f s := by
          conv_lhs => rw [← hs]
          rw [map_mul, hhε]
        rw [hfs, ← mul_assoc, hE2 ε hεE f hf (Ne.symm hfε), zero_mul]

  have hI : ∀ r, ((algebraMap T (Localization.Away ε)).comp j) r ∈ wcNdFix I := by
    intro r τ hτ
    obtain ⟨d, hd, -, hτd⟩ := (hImem τ).mp hτ
    rw [RingHom.comp_apply, hτd, hfix d hd]
  refine ⟨I, hI, hIf, ?_, ?_⟩
  · rw [injective_iff_map_eq_zero]
    intro r hr
    have h1 : algebraMap T (Localization.Away ε) (j r) = 0 := by
      have := congrArg Subtype.val hr
      exact this
    have h2 := hkill (j r) (fun g hg => hfix g hg r) ((hker _).mp h1)
    exact hinj (h2.trans (map_zero j).symm)
  · rintro ⟨y, hy⟩
    obtain ⟨t, rfl⟩ := hsurj y
    have hsD : ∀ d ∈ G, d ε = ε → d (ε * t) = ε * t := by
      intro d hd hdε
      obtain ⟨τ, hτI, hτ⟩ := hlift d hd hdε
      have h1 : τ (algebraMap T (Localization.Away ε) t) = algebraMap T (Localization.Away ε) t :=
        hy τ hτI
      rw [hτ] at h1
      have h2 : ε * (d t - t) = 0 := (hker _).mp (by rw [map_sub, h1, sub_self])
      rw [mul_sub, sub_eq_zero] at h2
      rw [map_mul, hdε, h2]
    obtain ⟨x, hxG, hεx⟩ := hcoset (ε * t) (by rw [← mul_assoc, hε.eq]) hsD
    obtain ⟨r, rfl⟩ := hinv x hxG
    refine ⟨r, Subtype.ext ?_⟩
    show algebraMap T (Localization.Away ε) (j r) = algebraMap T (Localization.Away ε) t
    rw [← sub_eq_zero, ← map_sub, hker, mul_sub, hεx, sub_self]

theorem wcpa_dj_lr1k_nd_henselization_invariants : ∀ (A B' L : Type u) [CommRing A]
    [IsLocalRing A] [CommRing B'] [CommRing L] [IsLocalRing L] (α : A →+* B')
    (H : Subgroup (B' ≃+* B')),
    α.Finite → Function.Injective α → Finite ↥H → (∀ h ∈ H, ∀ a, h (α a) = α a) →
    (∀ b, (∀ h ∈ H, h b = b) → ∃ a, α a = b) →
    (∀ n n' : Ideal B', n.IsMaximal → n'.IsMaximal → ∃ h ∈ H, Ideal.comap h n = n') →
    ∀ (n : Ideal B') (hn : n.IsMaximal) (β : B' →+* L),
    @IsLocalization B' _ (@Ideal.primeCompl B' _ n hn.isPrime) L _ β.toAlgebra →
    ∃ (P : Type u) (_ : CommRing P) (e : L →+* P), wcNdIsHens (IsLocalRing.maximalIdeal L) P e ∧
      ∃ (I : Subgroup (P ≃+* P)) (hI : ∀ a, e (β (α a)) ∈ wcNdFix I), Finite ↥I ∧
        wcNdIsHens (IsLocalRing.maximalIdeal A) ↥(wcNdFix I)
          ((e.comp (β.comp α)).codRestrict (wcNdFix I) hI) :=
by
  intro A B' L _ _ _ _ _ α H hfin hinj hHf hHα hinv htrans n hn β hloc
  obtain ⟨R, _, _, hR, hflat, hres⟩ := wcNd_hi_hens_exists_flat A
  letI : Algebra A B' := α.toAlgebra
  have hfinmod : Module.Finite A B' := hfin

  have transport : ∀ (S : Type u) [CommRing S] (ψ : R ≃+* S),
      wcNdIsHens (IsLocalRing.maximalIdeal A) S ((ψ : R →+* S).comp (algebraMap A R)) := by
    intro S _ ψ
    obtain ⟨hRh, hRu, hRuniv⟩ := hR
    haveI : IsLocalRing R := hRh.toIsLocalRing
    haveI : IsLocalRing S := ψ.isLocalRing
    have hS : HenselianLocalRing S := by
      refine HenselianLocalRing.mk ?_
      intro f hf a₀ h1 h2
      have hmapback : Polynomial.map (ψ : R →+* S) (Polynomial.map (ψ.symm : S →+* R) f) = f := by
        rw [Polynomial.map_map]
        have hid : (ψ : R →+* S).comp (ψ.symm : S →+* R) = RingHom.id S := by
          ext x
          simp
        rw [hid, Polynomial.map_id]
      have hg : (Polynomial.map (ψ.symm : S →+* R) f).Monic := hf.map _
      have e1 : Polynomial.eval (ψ.symm a₀) (Polynomial.map (ψ.symm : S →+* R) f) =
          ψ.symm (Polynomial.eval a₀ f) := by
        rw [Polynomial.eval_map]
        exact Polynomial.eval₂_at_apply (ψ.symm : S →+* R) a₀
      have e2 : Polynomial.eval (ψ.symm a₀)
          (Polynomial.derivative (Polynomial.map (ψ.symm : S →+* R) f)) =
          ψ.symm (Polynomial.eval a₀ (Polynomial.derivative f)) := by
        rw [Polynomial.derivative_map, Polynomial.eval_map]
        exact Polynomial.eval₂_at_apply (ψ.symm : S →+* R) a₀
      have h1' : Polynomial.eval (ψ.symm a₀) (Polynomial.map (ψ.symm : S →+* R) f) ∈
          IsLocalRing.maximalIdeal R := by
        rw [e1, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_map_iff ψ.symm]
        exact (IsLocalRing.mem_maximalIdeal _).mp h1
      have h2' : IsUnit (Polynomial.eval (ψ.symm a₀)
          (Polynomial.derivative (Polynomial.map (ψ.symm : S →+* R) f))) := by
        rw [e2, isUnit_map_iff ψ.symm]
        exact h2
      obtain ⟨a, ha, ham⟩ := hRh.is_henselian _ hg _ h1' h2'
      refine ⟨ψ a, ?_, ?_⟩
      · have e3 : Polynomial.eval (ψ a) f =
            ψ (Polynomial.eval a (Polynomial.map (ψ.symm : S →+* R) f)) := by
          conv_lhs => rw [← hmapback]
          rw [Polynomial.eval_map]
          exact Polynomial.eval₂_at_apply (ψ : R →+* S) a
        show Polynomial.eval (ψ a) f = 0
        rw [e3, ha.eq_zero, map_zero]
      · have e4 : ψ a - a₀ = ψ (a - ψ.symm a₀) := by
          rw [map_sub, RingEquiv.apply_symm_apply]
        rw [e4, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_map_iff ψ]
        exact (IsLocalRing.mem_maximalIdeal _).mp ham
    unfold wcNdIsHens
    refine ⟨hS, ?_, ?_⟩
    · intro a
      show IsUnit (ψ (algebraMap A R a)) ↔ _
      rw [isUnit_map_iff ψ]
      exact hRu a
    · intro B _ hB g hg
      obtain ⟨h₀, ⟨hh₀, hloc₀⟩, huniq⟩ := hRuniv B hB g hg
      refine ⟨h₀.comp (ψ.symm : S →+* R), ⟨?_, ?_⟩, ?_⟩
      · rw [← hh₀]
        ext a
        simp
      · haveI := hloc₀
        infer_instance
      · rintro h' ⟨hh', hloc'⟩
        haveI := hloc'
        have hcomp' : h'.comp (ψ : R →+* S) = h₀ := by
          apply huniq
          refine ⟨?_, inferInstance⟩
          rw [RingHom.comp_assoc]
          exact hh'
        ext x
        rw [← hcomp']
        simp
  obtain ⟨G, hGf, hGR, hGH, hGinv, hjinj⟩ :=
    wcNd_hi_tensor_action A R B' H hflat hinj hHf hHα hinv
  obtain ⟨ε, e, hε, he, heβ⟩ := wcNd_hi_factor_hens A R B' L hR hres hfinmod n hn β hloc
  have hPh : HenselianLocalRing (Localization.Away ε) := he.1
  haveI : IsLocalRing (Localization.Away ε) := hPh.toIsLocalRing
  obtain ⟨E, hE1, hE2, hE3⟩ := wcNd_hi_orbit_complete A R B' H G ε hR hres hfinmod hGf hGR hGH
    htrans hε inferInstance
  obtain ⟨I, hI, hIf, hbij⟩ := wcNd_hi_orbit_descent R (TensorProduct A R B')
    Algebra.TensorProduct.includeLeftRingHom G ε hjinj hGf (fun g hg r => hGR g hg r)
    hGinv hε ⟨E, hE1, hE2, hE3⟩
  have key : ∀ a : A, e (β (α a)) =
      ((algebraMap (TensorProduct A R B') (Localization.Away ε)).comp
        Algebra.TensorProduct.includeLeftRingHom) (algebraMap A R a) := by
    intro a
    rw [heβ (α a), RingHom.comp_apply]
    congr 1
    show TensorProduct.tmul A (1 : R) (α a) = TensorProduct.tmul A (algebraMap A R a) (1 : B')
    have h1 : TensorProduct.tmul A (algebraMap A R a) (1 : B') =
        TensorProduct.tmul A (1 : R) (algebraMap A B' a) := by
      rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
    rw [h1]
    rfl
  have hI' : ∀ a, e (β (α a)) ∈ wcNdFix I := by
    intro a
    rw [key a]
    exact hI _
  let ψ : R ≃+* ↥(wcNdFix I) := RingEquiv.ofBijective
    (((algebraMap (TensorProduct A R B') (Localization.Away ε)).comp
      Algebra.TensorProduct.includeLeftRingHom).codRestrict (wcNdFix I) hI) hbij
  have hcomp : (e.comp (β.comp α)).codRestrict (wcNdFix I) hI' =
      (ψ : R →+* ↥(wcNdFix I)).comp (algebraMap A R) := by
    apply RingHom.ext
    intro a
    apply Subtype.ext
    exact key a
  refine ⟨Localization.Away ε, inferInstance, e, he, I, hI', hIf, ?_⟩
  rw [hcomp]
  exact transport _ ψ

theorem wcNd_galois_normal_criterion : ∀ (P Q : Type u) [CommRing P] [IsDomain P] [CommRing Q]
    [IsDomain Q] [IsIntegrallyClosed Q] (I : Subgroup (P ≃+* P)) [Fintype ↥I] (θ : Q →+* P),
    Function.Injective θ → (∀ a, θ a ∈ wcNdFix I) → θ.IsIntegral →
    (∀ p : Fin (Fintype.card ↥I + 1) → P, ∃ c : Fin (Fintype.card ↥I + 1) → Q, c ≠ 0 ∧
      ∑ i, θ (c i) * p i = 0) →
    ∀ z ∈ wcNdFix I, ∃ a, θ a = z :=
by
  intro P Q _ _ _ _ _ I _ θ hθ hθI hint hdep z hzI
  classical
  have hfix : ∀ a, ∀ τ ∈ I, τ (θ a) = θ a := fun a => by
    have h := hθI a
    exact h
  have hz : ∀ τ ∈ I, τ z = z := by
    have h := hzI
    exact h

  obtain ⟨m, p', hmn, -, hspan⟩ : ∃ (m : ℕ) (p' : Fin m → P), m ≤ Fintype.card ↥I ∧
      (∀ c : Fin m → Q, ∑ l, θ (c l) * p' l = 0 → c = 0) ∧
      ∀ y : P, ∃ (b : Q) (a : Fin m → Q), b ≠ 0 ∧ θ b * y = ∑ l, θ (a l) * p' l := by
    let Ind : ℕ → Prop := fun k =>
      ∃ p : Fin k → P, ∀ c : Fin k → Q, ∑ i, θ (c i) * p i = 0 → c = 0
    have h0 : Ind 0 := ⟨Fin.elim0, fun c _ => funext (fun i => Fin.elim0 i)⟩
    have hIm : Ind (Nat.findGreatest Ind (Fintype.card ↥I)) :=
      Nat.findGreatest_spec (Nat.zero_le _) h0
    have hmn : Nat.findGreatest Ind (Fintype.card ↥I) ≤ Fintype.card ↥I := Nat.findGreatest_le _
    have hnot : ¬ Ind (Nat.findGreatest Ind (Fintype.card ↥I) + 1) := by
      intro h
      rcases Nat.lt_or_ge (Nat.findGreatest Ind (Fintype.card ↥I)) (Fintype.card ↥I) with
        hlt | hge
      · exact Nat.findGreatest_is_greatest (Nat.lt_succ_self _) hlt h
      · have hmn' : Nat.findGreatest Ind (Fintype.card ↥I) = Fintype.card ↥I :=
          le_antisymm hmn hge
        rw [hmn'] at h
        obtain ⟨p, hp⟩ := h
        obtain ⟨c, hc0, hc⟩ := hdep p
        exact hc0 (hp c hc)
    generalize Nat.findGreatest Ind (Fintype.card ↥I) = m at hIm hmn hnot
    obtain ⟨p', hp'⟩ := hIm
    refine ⟨m, p', hmn, hp', fun y => ?_⟩
    have hdep' : ¬ ∀ c : Fin (m + 1) → Q,
        ∑ i, θ (c i) * (Fin.snoc (α := fun _ => P) p' y) i = 0 → c = 0 :=
      fun h => hnot ⟨_, h⟩
    push_neg at hdep'
    obtain ⟨c, hc, hc0⟩ := hdep'
    rw [Fin.sum_univ_castSucc] at hc
    simp only [Fin.snoc_castSucc, Fin.snoc_last] at hc
    have hlast : c (Fin.last m) ≠ 0 := by
      intro hl
      rw [hl, map_zero, zero_mul, add_zero] at hc
      have h1 := hp' (fun l => c l.castSucc) hc
      apply hc0
      funext i
      refine Fin.lastCases ?_ (fun l => ?_) i
      · exact hl
      · exact congrFun h1 l
    refine ⟨c (Fin.last m), fun l => - c l.castSucc, hlast, ?_⟩
    simp only [map_neg, neg_mul, Finset.sum_neg_distrib]
    linear_combination hc

  let M : Matrix (Fin m) ↥I P := Matrix.of fun l τ => (τ : P ≃+* P) (p' l)

  have hcol : ∀ v : ↥I → P, M.mulVec v = 0 → v = 0 := by
    intro v hMv
    have hv : ∀ l, ∑ τ : ↥I, (τ : P ≃+* P) (p' l) * v τ = 0 := by
      intro l
      have h := congrFun hMv l
      simpa [M, Matrix.mulVec, dotProduct] using h
    have ha : ∀ y : P, ∑ τ : ↥I, v τ * (τ : P ≃+* P) y = 0 := by
      intro y
      obtain ⟨b, a, hb, hy⟩ := hspan y
      have hθb : θ b ≠ 0 := (map_ne_zero_iff θ hθ).mpr hb
      have key : θ b * ∑ τ : ↥I, v τ * (τ : P ≃+* P) y = 0 := by
        calc θ b * ∑ τ : ↥I, v τ * (τ : P ≃+* P) y
            = ∑ τ : ↥I, v τ * (τ : P ≃+* P) (θ b * y) := by
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl (fun τ _ => ?_)
              rw [map_mul, hfix b τ τ.2]
              ring
          _ = ∑ τ : ↥I, v τ * ∑ l, θ (a l) * (τ : P ≃+* P) (p' l) := by
              refine Finset.sum_congr rfl (fun τ _ => ?_)
              rw [hy, map_sum]
              congr 1
              refine Finset.sum_congr rfl (fun l _ => ?_)
              rw [map_mul, hfix (a l) τ τ.2]
          _ = ∑ l, θ (a l) * ∑ τ : ↥I, (τ : P ≃+* P) (p' l) * v τ := by
              simp only [Finset.mul_sum]
              rw [Finset.sum_comm]
              refine Finset.sum_congr rfl (fun l _ => Finset.sum_congr rfl (fun τ _ => by ring))
          _ = 0 := by simp [hv]
      exact (mul_eq_zero.mp key).resolve_left hθb
    have hli := (linearIndependent_monoidHom P P).comp
      (fun τ : ↥I => (τ : P ≃+* P).toMonoidHom) (by
        intro τ₁ τ₂ h
        apply Subtype.ext
        apply RingEquiv.ext
        intro x
        exact DFunLike.congr_fun h x)
    rw [Fintype.linearIndependent_iff] at hli
    funext τ
    apply hli v
    funext y
    simpa using ha y

  have hrowM : ∀ w : Fin m → P, Matrix.vecMul w M = 0 → w = 0 := by
    intro w hw
    have hinj : Function.Injective M.mulVecLin := by
      intro a b h
      have h2 : M.mulVec (a - b) = 0 := by
        rw [Matrix.mulVec_sub, sub_eq_zero]
        simpa using h
      exact sub_eq_zero.mp (hcol _ h2)
    have hle := LinearMap.finrank_le_finrank_of_injective hinj
    rw [Module.finrank_fintype_fun_eq_card, Module.finrank_fintype_fun_eq_card,
      Fintype.card_fin] at hle
    have hcard : Fintype.card ↥I = Fintype.card (Fin m) := by rw [Fintype.card_fin]; omega
    let e : ↥I ≃ Fin m := Fintype.equivOfCardEq hcard
    let N : Matrix ↥I ↥I P := M.submatrix e id
    have hN : ∀ v, N.mulVec v = 0 → v = 0 := by
      intro v hv
      apply hcol
      funext l
      have h3 := congrFun hv (e.symm l)
      simp only [N, Matrix.mulVec, dotProduct, Matrix.submatrix_apply, id,
        Equiv.apply_symm_apply, Pi.zero_apply] at h3 ⊢
      exact h3
    have hdet : N.det ≠ 0 := by
      intro h
      obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr h
      exact hv0 (hN v hv)
    have hw' : Matrix.vecMul (w ∘ e) N = 0 := by
      funext j
      have h4 := congrFun hw j
      simp only [N, Matrix.vecMul, dotProduct, Matrix.submatrix_apply, Function.comp_apply, id,
        Pi.zero_apply] at h4 ⊢
      rw [← h4]
      exact Equiv.sum_comp e (fun l => w l * M l j)
    have hwe : w ∘ e = 0 := by
      by_contra hne
      exact hdet (Matrix.exists_vecMul_eq_zero_iff.mp ⟨_, hne, hw'⟩)
    funext l
    have h5 := congrFun hwe (e.symm l)
    simpa using h5
  have hrow : ∀ w : Fin m → P, (∀ τ : ↥I, ∑ l, w l * (τ : P ≃+* P) (p' l) = 0) → w = 0 := by
    intro w hw
    apply hrowM
    funext τ
    simpa [M, Matrix.vecMul, dotProduct] using hw τ

  obtain ⟨r, s, hs, hrs⟩ : ∃ r s : Q, s ≠ 0 ∧ θ s * z = θ r := by
    obtain ⟨b₀, a₀, hb₀, h₀⟩ := hspan 1
    obtain ⟨b₁, a₁, hb₁, h₁⟩ := hspan z
    have hsum : ∑ l, (θ b₀ * θ (a₁ l) - θ b₁ * z * θ (a₀ l)) * p' l = 0 := by
      simp only [sub_mul, Finset.sum_sub_distrib]
      have e1 : ∑ l, θ b₀ * θ (a₁ l) * p' l = θ b₀ * (θ b₁ * z) := by
        rw [h₁, Finset.mul_sum]
        exact Finset.sum_congr rfl (fun l _ => by ring)
      have e2 : ∑ l, θ b₁ * z * θ (a₀ l) * p' l = θ b₁ * z * (θ b₀ * 1) := by
        rw [h₀, Finset.mul_sum]
        exact Finset.sum_congr rfl (fun l _ => by ring)
      rw [e1, e2]
      ring
    have hw0 : (fun l => θ b₀ * θ (a₁ l) - θ b₁ * z * θ (a₀ l)) = 0 := by
      apply hrow
      intro τ
      have h2 := congrArg (τ : P ≃+* P) hsum
      rw [map_sum, map_zero] at h2
      rw [← h2]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [map_mul, map_sub, map_mul, map_mul, map_mul, hfix _ τ τ.2, hfix _ τ τ.2, hfix _ τ τ.2,
        hfix _ τ τ.2, hz τ τ.2]
    have ha₀ : a₀ ≠ 0 := by
      intro h
      apply hb₀
      apply hθ
      rw [mul_one] at h₀
      rw [h₀, map_zero]
      simp [h]
    obtain ⟨l, hl⟩ := Function.ne_iff.mp ha₀
    refine ⟨b₀ * a₁ l, b₁ * a₀ l, mul_ne_zero hb₁ hl, ?_⟩
    have h3 := congrFun hw0 l
    simp only [Pi.zero_apply, sub_eq_zero] at h3
    rw [map_mul, map_mul]
    linear_combination -h3

  obtain ⟨f, hfm, hf⟩ := hint z
  have hg : (f.scaleRoots s).eval r = 0 := by
    apply hθ
    rw [map_zero, ← Polynomial.eval₂_hom, ← hrs, Polynomial.scaleRoots_eval₂_mul, hf, mul_zero]
  have hφs : algebraMap Q (FractionRing Q) s ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective Q (FractionRing Q))).mpr hs
  have hx : _root_.IsIntegral Q
      (algebraMap Q (FractionRing Q) r / algebraMap Q (FractionRing Q) s) := by
    refine ⟨f, hfm, ?_⟩
    have e1 := Polynomial.scaleRoots_eval₂_mul (p := f) (algebraMap Q (FractionRing Q))
      (algebraMap Q (FractionRing Q) r / algebraMap Q (FractionRing Q) s) s
    rw [mul_div_cancel₀ _ hφs, Polynomial.eval₂_hom, hg, map_zero] at e1
    exact (mul_eq_zero.mp e1.symm).resolve_left (pow_ne_zero _ hφs)
  obtain ⟨q, hq⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hx
  have hqs : q * s = r := by
    apply IsFractionRing.injective Q (FractionRing Q)
    rw [map_mul, hq, div_mul_cancel₀ _ hφs]
  refine ⟨q, ?_⟩
  have hθs : θ s ≠ 0 := (map_ne_zero_iff θ hθ).mpr hs
  apply mul_left_cancel₀ hθs
  rw [hrs, ← hqs, map_mul, mul_comm]

theorem wcNd_typeA_hens_chart : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (P : Type u) [CommRing P] [HenselianLocalRing P] (f : Polynomial ↥W →+* P), wcNdIsHens (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C) P f → ∀ (Q : Type u) [CommRing Q] (q : Polynomial ↥W →+* Q), wcNdIsHens (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C) Q q → ∀ θ : Q →+* P, IsLocalHom θ → (∀ c, θ (q (Polynomial.C c)) = f (Polynomial.C c)) → ∃ (S : Type u) (_ : CommRing S) (_ : Algebra Q S) (_ : Algebra.FiniteType Q S) (jS : S →+* P), jS.comp (algebraMap Q S) = θ ∧ wcNdIsHens (Ideal.comap jS (IsLocalRing.maximalIdeal P)) P jS :=
by
  intro Ω _ W P _ _ f hf Q _ q hQ θ hθl hθC
  classical
  haveI : HenselianLocalRing Q := hQ.1

  have hpA : (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C :
      Ideal (Polynomial ↥W)).IsPrime := by
    have hp : (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C :
        Ideal (Polynomial ↥W)) = Ideal.comap f (IsLocalRing.maximalIdeal P) := by
      ext a
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hf.2.1 a, not_not]
    rw [hp]
    exact Ideal.comap_isPrime _ _

  obtain ⟨E, _, _, _, j, hj, hF, hE⟩ := wcNd_hens_etale_chart (Polynomial ↥W) _ hpA P f hf
    {θ (q Polynomial.X)}
  obtain ⟨ξ, hξ⟩ := hF _ (Finset.mem_singleton_self _)
  have hjA : ∀ a, j (algebraMap (Polynomial ↥W) E a) = f a := fun a => RingHom.congr_fun hj a

  haveI : Algebra.FinitePresentation (Polynomial ↥W) E := Algebra.Etale.finitePresentation
  haveI : Algebra.FiniteType (Polynomial ↥W) E := Algebra.FiniteType.of_finitePresentation
  obtain ⟨s₀, hs₀⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra (Polynomial ↥W) E).FG)

  letI : Algebra Q P := θ.toAlgebra
  have hM1 : ∀ a : Q, θ a ∈ Algebra.adjoin Q
      (((insert (algebraMap (Polynomial ↥W) E Polynomial.X) s₀).image j : Finset P) : Set P) :=
    fun a => Subalgebra.algebraMap_mem _ a
  have hM2 : ∀ e ∈ insert (algebraMap (Polynomial ↥W) E Polynomial.X) s₀, j e ∈ Algebra.adjoin Q
      (((insert (algebraMap (Polynomial ↥W) E Polynomial.X) s₀).image j : Finset P) : Set P) :=
    fun e he => Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_image_of_mem j he))
  have hFT : Algebra.FiniteType Q ↥(Algebra.adjoin Q
      (((insert (algebraMap (Polynomial ↥W) E Polynomial.X) s₀).image j : Finset P) : Set P)) :=
    (Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_adjoin_finset _)

  have hu : f Polynomial.X ∈ Algebra.adjoin Q
      (((insert (algebraMap (Polynomial ↥W) E Polynomial.X) s₀).image j : Finset P) : Set P) := by
    rw [← hjA]
    exact hM2 _ (Finset.mem_insert_self _ _)
  have hfA : ∀ a : Polynomial ↥W, f a ∈ Algebra.adjoin Q
      (((insert (algebraMap (Polynomial ↥W) E Polynomial.X) s₀).image j : Finset P) : Set P) := by
    intro a
    refine Polynomial.induction_on a ?_ ?_ ?_
    · intro c
      rw [← hθC]
      exact hM1 _
    · intro p p' hp hp'
      rw [map_add]
      exact Subalgebra.add_mem _ hp hp'
    · intro n c ih
      rw [pow_succ, ← mul_assoc, map_mul]
      exact Subalgebra.mul_mem _ ih hu
  have hjE : ∀ e : E, j e ∈ Algebra.adjoin Q
      (((insert (algebraMap (Polynomial ↥W) E Polynomial.X) s₀).image j : Finset P) : Set P) := by
    intro e
    have he : e ∈ Algebra.adjoin (Polynomial ↥W) (s₀ : Set E) := by
      rw [hs₀]; exact Algebra.mem_top
    induction he using Algebra.adjoin_induction with
    | mem x hx => exact hM2 _ (Finset.mem_insert_of_mem (Finset.mem_coe.mp hx))
    | algebraMap a => rw [hjA]; exact hfA a
    | add x y _ _ hx hy => rw [map_add]; exact Subalgebra.add_mem _ hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact Subalgebra.mul_mem _ hx hy
  set S₀ : Subalgebra Q P := Algebra.adjoin Q
      (((insert (algebraMap (Polynomial ↥W) E Polynomial.X) s₀).image j : Finset P) : Set P)
    with hS₀
  let jS : S₀ →+* P := S₀.val.toRingHom
  have hcomp : jS.comp (algebraMap Q S₀) = θ := RingHom.ext fun a => rfl
  let ι : E →+* S₀ := j.codRestrict S₀ hjE

  have hunitS : ∀ s : S₀, IsUnit (jS s) ↔ s ∉ Ideal.comap jS (IsLocalRing.maximalIdeal P) := by
    intro s
    rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not]
  refine ⟨S₀, inferInstance, inferInstance, hFT, jS, hcomp, ?_⟩
  unfold wcNdIsHens
  refine ⟨inferInstance, hunitS, ?_⟩

  intro B _ hB g hg
  haveI := hB
  have hg' : ∀ s, IsUnit (g s) ↔ IsUnit (jS s) := fun s => (hg s).trans (hunitS s).symm
  have hgE : ∀ e : E, IsUnit ((g.comp ι) e) ↔ e ∉ Ideal.comap j (IsLocalRing.maximalIdeal P) := by
    intro e
    have := hg' (ι e)
    rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not]
    exact this
  obtain ⟨h, ⟨hhj, hloc⟩, huniqE⟩ := hE.2.2 B hB (g.comp ι) hgE
  have hhj' : ∀ e, h (j e) = g (ι e) := fun e => RingHom.congr_fun hhj e
  haveI : IsLocalHom h := hloc
  have hU := hQ.2.2 B hB ((h.comp θ).comp q) (by
    intro a
    rw [RingHom.comp_apply, RingHom.comp_apply, isUnit_map_iff h, isUnit_map_iff θ]
    exact hQ.2.1 a)
  have hy₂loc : IsLocalHom (g.comp (algebraMap Q S₀)) := by
    refine ⟨fun a ha => ?_⟩
    rw [RingHom.comp_apply, hg'] at ha
    have hθa : IsUnit (θ a) := ha
    exact isUnit_of_map_unit θ a hθa
  have hy₂q : (g.comp (algebraMap Q S₀)).comp q = (h.comp θ).comp q := by
    apply Polynomial.ringHom_ext
    · intro c
      have e1 : algebraMap Q S₀ (q (Polynomial.C c)) =
          ι (algebraMap (Polynomial ↥W) E (Polynomial.C c)) := by
        apply Subtype.ext
        show θ (q (Polynomial.C c)) = j (algebraMap (Polynomial ↥W) E (Polynomial.C c))
        rw [hθC, hjA]
      simp only [RingHom.comp_apply]
      rw [e1, ← hhj', hjA, ← hθC]
    · have e1 : algebraMap Q S₀ (q Polynomial.X) = ι ξ := by
        apply Subtype.ext
        show θ (q Polynomial.X) = j ξ
        exact hξ.symm
      simp only [RingHom.comp_apply]
      rw [e1, ← hhj', hξ]
  have hθQ : h.comp θ = g.comp (algebraMap Q S₀) :=
    hU.unique ⟨rfl, inferInstance⟩ ⟨hy₂q, hy₂loc⟩
  have key : ∀ (x : P) (hx : x ∈ Algebra.adjoin Q
      (((insert (algebraMap (Polynomial ↥W) E Polynomial.X) s₀).image j : Finset P) : Set P)),
      h x = g ⟨x, hx⟩ := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨e, -, rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hx)
      exact hhj' e
    | algebraMap a =>
      exact RingHom.congr_fun hθQ a
    | add x y hx hy ihx ihy =>
      rw [map_add, ihx, ihy, ← map_add]
      rfl
    | mul x y hx hy ihx ihy =>
      rw [map_mul, ihx, ihy, ← map_mul]
      rfl
  have hhS : h.comp jS = g := by
    ext ⟨x, hx⟩
    exact key x hx

  refine ⟨h, ⟨hhS, hloc⟩, ?_⟩
  rintro h' ⟨hh', hloc'⟩
  apply huniqE h'
  refine ⟨?_, hloc'⟩
  rw [← hh']
  exact RingHom.ext fun e => rfl

theorem wcNd_typeA_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (P : Type u) [CommRing P] (f : Polynomial ↥W →+* P), wcNdIsHens (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C) P f → ∀ (Q : Type u) [CommRing Q] (q : Polynomial ↥W →+* Q), wcNdIsHens (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C) Q q → ∀ θ : Q →+* P, IsLocalHom θ → (∀ c, θ (q (Polynomial.C c)) = f (Polynomial.C c)) → ∀ n : ℕ, f Polynomial.X ^ n ∈ (IsLocalRing.maximalIdeal ↥W).map (f.comp Polynomial.C) ⊔ Ideal.span {θ (q Polynomial.X)} → θ.Finite :=
by
  intro Ω _ _ W _ _ P _ f hf Q _ q hQ θ hθl hθC n hud
  haveI : HenselianLocalRing P := hf.1
  haveI : HenselianLocalRing Q := hQ.1
  have charA : ∀ a : Polynomial ↥W,
      a ∈ (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C) ↔
        a.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W := by
    intro a
    constructor
    · intro ha
      have hle : (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map
          (Polynomial.C : ↥W →+* Polynomial ↥W)) ≤
          Ideal.comap Polynomial.constantCoeff (IsLocalRing.maximalIdeal ↥W) := by
        refine sup_le ?_ ?_
        · rw [Ideal.span_le, Set.singleton_subset_iff]
          show Polynomial.constantCoeff Polynomial.X ∈ IsLocalRing.maximalIdeal ↥W
          rw [Polynomial.constantCoeff_apply, Polynomial.coeff_X_zero]
          exact Ideal.zero_mem _
        · rw [Ideal.map_le_iff_le_comap]
          intro c hc
          rw [Ideal.mem_comap, Ideal.mem_comap, Polynomial.constantCoeff_apply,
            Polynomial.coeff_C_zero]
          exact hc
      have := hle ha
      rwa [Ideal.mem_comap, Polynomial.constantCoeff_apply] at this
    · intro ha
      rw [← Polynomial.X_mul_divX_add a]
      exact Ideal.add_mem _
        (Ideal.mem_sup_left (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)))
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ ha))
  have hqX : q Polynomial.X ∈ IsLocalRing.maximalIdeal Q := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hQ.2.1, not_not, charA,
      Polynomial.coeff_X_zero]
    exact Ideal.zero_mem _
  obtain ⟨hPbdom, hDVR, hirr, hres⟩ := wcNd_typeA_special_fibre Ω W P f hf
  obtain ⟨S, _, _, _, jS, hcomp, hS⟩ := wcNd_typeA_hens_chart Ω W P f hf Q q hQ θ hθl hθC
  have hfin := wcNd_hens_zmt_finite Q S P jS hS ?_ ?_ ?_
  · rw [hcomp] at hfin
    exact hfin
  · rw [hcomp]
    exact hθl
  · intro z
    obtain ⟨c, hc⟩ := hres z
    refine ⟨q (Polynomial.C c), ?_⟩
    have e : jS (algebraMap Q S (q (Polynomial.C c))) = f (Polynomial.C c) := by
      rw [← RingHom.comp_apply, hcomp, hθC]
    rw [e, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact hc
  · intro 𝔓 h𝔓 hle
    rw [hcomp] at hle
    have hM : (IsLocalRing.maximalIdeal ↥W).map (f.comp Polynomial.C) ≤ 𝔓 := by
      rw [Ideal.map_le_iff_le_comap]
      intro c hc
      rw [Ideal.mem_comap, RingHom.comp_apply, ← hθC]
      apply hle
      apply Ideal.mem_map_of_mem
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hQ.2.1, not_not, charA,
        Polynomial.coeff_C_zero]
      exact hc
    have hx : θ (q Polynomial.X) ∈ 𝔓 := hle (Ideal.mem_map_of_mem _ hqX)
    have hsup : (IsLocalRing.maximalIdeal ↥W).map (f.comp Polynomial.C) ⊔
        Ideal.span {θ (q Polynomial.X)} ≤ 𝔓 := by
      refine sup_le hM ?_
      rw [Ideal.span_le, Set.singleton_subset_iff]
      exact hx
    have hu : f Polynomial.X ∈ 𝔓 := h𝔓.mem_of_pow_mem n (hsup hud)
    set M : Ideal P := (IsLocalRing.maximalIdeal ↥W).map (f.comp Polynomial.C) with hMdef
    haveI := hPbdom
    haveI := hDVR
    have hMle : M ≤ IsLocalRing.maximalIdeal P := by
      rw [hMdef, Ideal.map_le_iff_le_comap]
      intro c hc
      rw [Ideal.mem_comap, RingHom.comp_apply, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
        hf.2.1, not_not, charA, Polynomial.coeff_C_zero]
      exact hc
    have hmkmax : ∀ y ∈ IsLocalRing.maximalIdeal P, ¬ IsUnit (Ideal.Quotient.mk M y) := by
      intro y hy hu'
      obtain ⟨z', hz'⟩ := hu'.exists_right_inv
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z'
      have h0 : y * z - 1 ∈ M := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, hz', map_one, sub_self]
      have h1 : y * z - 1 ∈ IsLocalRing.maximalIdeal P := hMle h0
      have h2 : y * z ∈ IsLocalRing.maximalIdeal P := Ideal.mul_mem_right z _ hy
      have h3 : (1 : P) ∈ IsLocalRing.maximalIdeal P := by
        have := Ideal.sub_mem _ h2 h1
        simpa using this
      exact (IsLocalRing.maximalIdeal.isMaximal P).ne_top ((Ideal.eq_top_iff_one _).mpr h3)
    have hmax : IsLocalRing.maximalIdeal (P ⧸ M) =
        Ideal.span {Ideal.Quotient.mk M (f Polynomial.X)} :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hirr
    have hF1 : ∀ y ∈ IsLocalRing.maximalIdeal P, ∃ r : P, y - r * f Polynomial.X ∈ M := by
      intro y hy
      have h1 : Ideal.Quotient.mk M y ∈ IsLocalRing.maximalIdeal (P ⧸ M) := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        exact hmkmax y hy
      rw [hmax, Ideal.mem_span_singleton'] at h1
      obtain ⟨r', hr'⟩ := h1
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r'
      refine ⟨r, ?_⟩
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, hr', sub_self]
    refine le_antisymm (IsLocalRing.le_maximalIdeal h𝔓.ne_top) ?_
    intro y hy
    obtain ⟨r, hr⟩ := hF1 y hy
    have := Ideal.add_mem _ (hM hr) (Ideal.mul_mem_left 𝔓 r hu)
    simpa using this

theorem wcNd_normA_core : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (P : Type u) [CommRing P] (σ : ↥W →+* P) (f : Polynomial ↥W →+* P), f.comp Polynomial.C = σ →
    wcNdIsHens (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C) P f →
    ∀ (I : Subgroup (P ≃+* P)) [Fintype ↥I], (∀ c, σ c ∈ wcNdFix I) →
    ∀ (Q : Type u) [CommRing Q] (q : Polynomial ↥W →+* Q),
    wcNdIsHens (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C) Q q →
    ∀ θ : Q →+* P, IsLocalHom θ → (∀ c, θ (q (Polynomial.C c)) = σ c) →
    θ (q Polynomial.X) = ∏ τ : ↥I, (τ : P ≃+* P) (f Polynomial.X) →
    Function.Injective θ ∧ θ.IsIntegral ∧
      ∀ p : Fin (Fintype.card ↥I + 1) → P, ∃ c : Fin (Fintype.card ↥I + 1) → Q, c ≠ 0 ∧
        ∑ i, θ (c i) * p i = 0 :=
by
  intro Ω _ _ W hW hWt P _ σ f hfC hf I _ hI Q _ q hQ θ hθl hθC hθX
  classical
  subst hfC
  haveI : HenselianLocalRing P := hf.1
  haveI : HenselianLocalRing Q := hQ.1
  haveI := hθl
  have hIc : ∀ c, ∀ τ ∈ I, τ ((f.comp Polynomial.C) c) = (f.comp Polynomial.C) c := fun c => hI c

  have charA : ∀ a : Polynomial ↥W,
      a ∈ (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C) ↔
        a.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W := by
    intro a
    constructor
    · intro ha
      have hle : (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map
          (Polynomial.C : ↥W →+* Polynomial ↥W)) ≤
          Ideal.comap Polynomial.constantCoeff (IsLocalRing.maximalIdeal ↥W) := by
        refine sup_le ?_ ?_
        · rw [Ideal.span_le, Set.singleton_subset_iff]
          show Polynomial.constantCoeff Polynomial.X ∈ IsLocalRing.maximalIdeal ↥W
          rw [Polynomial.constantCoeff_apply, Polynomial.coeff_X_zero]
          exact Ideal.zero_mem _
        · rw [Ideal.map_le_iff_le_comap]
          intro c hc
          rw [Ideal.mem_comap, Ideal.mem_comap, Polynomial.constantCoeff_apply,
            Polynomial.coeff_C_zero]
          exact hc
      have := hle ha
      rwa [Ideal.mem_comap, Polynomial.constantCoeff_apply] at this
    · intro ha
      rw [← Polynomial.X_mul_divX_add a]
      exact Ideal.add_mem _
        (Ideal.mem_sup_left (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)))
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ ha))
  have hpA : (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C :
      Ideal (Polynomial ↥W)).IsPrime := by
    have hp : (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C :
        Ideal (Polynomial ↥W)) = Ideal.comap f (IsLocalRing.maximalIdeal P) := by
      ext a
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hf.2.1 a, not_not]
    rw [hp]
    exact Ideal.comap_isPrime _ _
  obtain ⟨hPdom, -⟩ := wcNd_hens_normal_domain (Polynomial ↥W) _ hpA P f hf
  obtain ⟨hQdom, -⟩ := wcNd_hens_normal_domain (Polynomial ↥W) _ hpA Q q hQ
  haveI := hPdom
  haveI := hQdom

  have hσinj : ∀ c : ↥W, f (Polynomial.C c) = 0 → c = 0 := by
    haveI := wcpa_dj_lmga_valuation_henselian Ω W
    have hg : ∀ a : Polynomial ↥W, IsUnit (Polynomial.constantCoeff a) ↔
        a ∉ (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C) := by
      intro a
      rw [charA, Polynomial.constantCoeff_apply, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
        not_not]
    obtain ⟨h, ⟨hh, _⟩, _⟩ := hf.2.2 ↥W inferInstance Polynomial.constantCoeff hg
    intro c hc
    have e := RingHom.congr_fun hh (Polynomial.C c)
    rw [RingHom.comp_apply, hc, map_zero, Polynomial.constantCoeff_apply,
      Polynomial.coeff_C_zero] at e
    exact e.symm
  have hqX : q Polynomial.X ∈ IsLocalRing.maximalIdeal Q := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hQ.2.1, not_not, charA,
      Polynomial.coeff_X_zero]
    exact Ideal.zero_mem _
  have hxmax : θ (q Polynomial.X) ∈ IsLocalRing.maximalIdeal P := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hqX))
      (isUnit_of_map_unit θ _ hu)
  have hσm : ∀ c ∈ IsLocalRing.maximalIdeal ↥W,
      (f.comp Polynomial.C) c ∈ IsLocalRing.maximalIdeal P := by
    intro c hc
    rw [RingHom.comp_apply, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hf.2.1, not_not,
      charA, Polynomial.coeff_C_zero]
    exact hc

  obtain ⟨hPbdom, hDVR, hirr, hres⟩ := wcNd_typeA_special_fibre Ω W P f hf
  set M : Ideal P := (IsLocalRing.maximalIdeal ↥W).map (f.comp Polynomial.C) with hMdef
  haveI := hPbdom
  haveI := hDVR
  have hMle : M ≤ IsLocalRing.maximalIdeal P := by
    rw [hMdef, Ideal.map_le_iff_le_comap]
    intro c hc
    exact hσm c hc
  have hmkmax : ∀ y ∈ IsLocalRing.maximalIdeal P, ¬ IsUnit (Ideal.Quotient.mk M y) := by
    intro y hy hu
    obtain ⟨z', hz'⟩ := hu.exists_right_inv
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z'
    have h0 : y * z - 1 ∈ M := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, hz', map_one, sub_self]
    have h1 : y * z - 1 ∈ IsLocalRing.maximalIdeal P := hMle h0
    have h2 : y * z ∈ IsLocalRing.maximalIdeal P := Ideal.mul_mem_right z _ hy
    have h3 : (1 : P) ∈ IsLocalRing.maximalIdeal P := by
      have := Ideal.sub_mem _ h2 h1
      simpa using this
    exact (IsLocalRing.maximalIdeal.isMaximal P).ne_top ((Ideal.eq_top_iff_one _).mpr h3)
  have hmax : IsLocalRing.maximalIdeal (P ⧸ M) =
      Ideal.span {Ideal.Quotient.mk M (f Polynomial.X)} :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hirr
  have hF1 : ∀ y ∈ IsLocalRing.maximalIdeal P, ∃ r : P, y - r * f Polynomial.X ∈ M := by
    intro y hy
    have h1 : Ideal.Quotient.mk M y ∈ IsLocalRing.maximalIdeal (P ⧸ M) := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      exact hmkmax y hy
    rw [hmax, Ideal.mem_span_singleton'] at h1
    obtain ⟨r', hr'⟩ := h1
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r'
    refine ⟨r, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, hr', sub_self]

  have hassoc : Associated (Ideal.Quotient.mk M (f Polynomial.X) ^ Fintype.card ↥I)
      (Ideal.Quotient.mk M (θ (q Polynomial.X))) := by
    rw [hθX, map_prod]
    have e0 : Ideal.Quotient.mk M (f Polynomial.X) ^ Fintype.card ↥I =
        ∏ _τ : ↥I, Ideal.Quotient.mk M (f Polynomial.X) := by
      rw [Finset.prod_const, Finset.card_univ]
    rw [e0]
    apply Associated.prod
    intro τ _
    have e : ((τ : P ≃+* P) : P →+* P).comp (f.comp Polynomial.C) = f.comp Polynomial.C :=
      RingHom.ext fun c => hIc c τ τ.2
    have hMM : M = Ideal.map ((τ : P ≃+* P) : P →+* P) M := by
      rw [hMdef, Ideal.map_map, e]
    have h1 : Ideal.quotientEquiv M M (τ : P ≃+* P) hMM (Ideal.Quotient.mk M (f Polynomial.X)) =
        Ideal.Quotient.mk M ((τ : P ≃+* P) (f Polynomial.X)) :=
      Ideal.quotientEquiv_mk _ _ _ _ _
    rw [← h1]
    exact IsDiscreteValuationRing.associated_of_irreducible _ hirr (hirr.map _)
  obtain ⟨v, hv⟩ := hassoc
  have hx0 : Ideal.Quotient.mk M (θ (q Polynomial.X)) ≠ 0 := by
    rw [← hv]
    exact mul_ne_zero (pow_ne_zero _ hirr.ne_zero) v.ne_zero
  have hud : f Polynomial.X ^ Fintype.card ↥I ∈ M ⊔ Ideal.span {θ (q Polynomial.X)} := by
    obtain ⟨w, hw⟩ := Ideal.Quotient.mk_surjective (↑v⁻¹ : P ⧸ M)
    have h1 : f Polynomial.X ^ Fintype.card ↥I - θ (q Polynomial.X) * w ∈ M := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, map_pow, hw, ← hv, mul_assoc,
        Units.mul_inv, mul_one, sub_self]
    have e : f Polynomial.X ^ Fintype.card ↥I =
        (f Polynomial.X ^ Fintype.card ↥I - θ (q Polynomial.X) * w) + θ (q Polynomial.X) * w := by
      ring
    rw [e]
    exact Ideal.add_mem _ (Ideal.mem_sup_left h1)
      (Ideal.mem_sup_right (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)))

  have hfin : θ.Finite :=
    wcNd_typeA_finite Ω W hW hWt P f hf Q q hQ θ hθl (fun c => hθC c) (Fintype.card ↥I) hud
  have hint : θ.IsIntegral := RingHom.IsIntegral.of_finite hfin

  have hφ : ∀ a : Polynomial ↥W,
      θ (q a) = Polynomial.eval₂ (f.comp Polynomial.C) (θ (q Polynomial.X)) a := by
    intro a
    have e : θ.comp q = Polynomial.eval₂RingHom (f.comp Polynomial.C) (θ (q Polynomial.X)) := by
      apply Polynomial.ringHom_ext
      · intro c
        simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hθC]
      · simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
    exact RingHom.congr_fun e a
  have hsplit : ∀ {R : Type u} [CommRing R] (p : Polynomial R), p ≠ 0 →
      ∃ g : Polynomial R, p = Polynomial.X ^ p.natTrailingDegree * g ∧ g.coeff 0 ≠ 0 := by
    intro R _ p hp
    obtain ⟨g, hg⟩ : Polynomial.X ^ p.natTrailingDegree ∣ p :=
      Polynomial.X_pow_dvd_iff.mpr (fun d hd => Polynomial.coeff_eq_zero_of_lt_natTrailingDegree hd)
    refine ⟨g, hg, ?_⟩
    have h1 : (Polynomial.X ^ p.natTrailingDegree * g).coeff p.natTrailingDegree = g.coeff 0 := by
      rw [Polynomial.coeff_X_pow_mul']
      simp
    have h2 : p.coeff p.natTrailingDegree = g.coeff 0 := by
      rw [← h1, ← hg]
    rw [← h2]
    exact Polynomial.trailingCoeff_nonzero_iff_nonzero.mpr hp
  have hcont : ∀ a : Polynomial ↥W, a ≠ 0 →
      ∃ i0, a.coeff i0 ≠ 0 ∧ ∀ i, a.coeff i0 ∣ a.coeff i := by
    intro a ha
    have key : ∀ s : Finset ℕ, s.Nonempty → ∃ i0 ∈ s, ∀ i ∈ s, a.coeff i0 ∣ a.coeff i := by
      intro s hs
      refine Finset.Nonempty.cons_induction
        (motive := fun s _ => ∃ i0 ∈ s, ∀ i ∈ s, a.coeff i0 ∣ a.coeff i) ?_ ?_ hs
      · intro j
        exact ⟨j, Finset.mem_singleton_self j, fun i hi => by rw [Finset.mem_singleton.mp hi]⟩
      · intro j s hjs _ ih
        obtain ⟨i0, hi0, hdiv⟩ := ih
        rcases ValuationRing.dvd_total (a.coeff j) (a.coeff i0) with h | h
        · refine ⟨j, Finset.mem_cons_self j s, fun i hi => ?_⟩
          rcases Finset.mem_cons.mp hi with rfl | hi
          · exact dvd_rfl
          · exact h.trans (hdiv i hi)
        · refine ⟨i0, Finset.mem_cons_of_mem hi0, fun i hi => ?_⟩
          rcases Finset.mem_cons.mp hi with rfl | hi
          · exact h
          · exact hdiv i hi
    obtain ⟨i0, hi0, hdiv⟩ := key a.support (Polynomial.support_nonempty.mpr ha)
    refine ⟨i0, Polynomial.mem_support_iff.mp hi0, fun i => ?_⟩
    by_cases hi : i ∈ a.support
    · exact hdiv i hi
    · rw [Polynomial.notMem_support_iff.mp hi]
      exact dvd_zero _
  have hinjφ : ∀ a : Polynomial ↥W, θ (q a) = 0 → a = 0 := by
    intro a ha
    by_contra ha0
    obtain ⟨i0, hc0, hdiv⟩ := hcont a ha0
    obtain ⟨a₁, ha₁⟩ := (Polynomial.C_dvd_iff_dvd_coeff _ _).mpr hdiv
    have h1 : a₁.coeff i0 = 1 := by
      have e : a.coeff i0 = a.coeff i0 * a₁.coeff i0 := by
        conv_lhs => rw [ha₁]
        rw [Polynomial.coeff_C_mul]
      exact mul_left_cancel₀ hc0 (by rw [mul_one]; exact e.symm)
    have h2 : θ (q a₁) = 0 := by
      have e : θ (q a) = (f.comp Polynomial.C) (a.coeff i0) * θ (q a₁) := by
        conv_lhs => rw [ha₁]
        rw [map_mul, map_mul, hθC]
      rw [e] at ha
      exact (mul_eq_zero.mp ha).resolve_left (fun h => hc0 (hσinj _ h))
    haveI : (IsLocalRing.maximalIdeal ↥W).IsMaximal := IsLocalRing.maximalIdeal.isMaximal _
    let ρ : (↥W ⧸ IsLocalRing.maximalIdeal ↥W) →+* P ⧸ M :=
      Ideal.Quotient.lift _ ((Ideal.Quotient.mk M).comp (f.comp Polynomial.C)) (fun c hc => by
        rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.mem_map_of_mem _ hc)
    have hρ : ∀ c : ↥W, ρ (Ideal.Quotient.mk _ c) = Ideal.Quotient.mk M (f (Polynomial.C c)) :=
      fun c => Ideal.Quotient.lift_mk _ _ _
    obtain ⟨ā, hā⟩ : ∃ ā, ā = a₁.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥W)) :=
      ⟨_, rfl⟩
    have hā0 : ā ≠ 0 := by
      intro h0
      have e := congrArg (fun p => Polynomial.coeff p i0) h0
      simp only [hā, Polynomial.coeff_map, h1, map_one, Polynomial.coeff_zero] at e
      exact one_ne_zero e
    have h3 : Polynomial.eval₂ ρ (Ideal.Quotient.mk M (θ (q Polynomial.X))) ā = 0 := by
      have e1 : ρ.comp (Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥W)) =
          (Ideal.Quotient.mk M).comp (f.comp Polynomial.C) := by
        apply RingHom.ext
        intro c
        exact hρ c
      rw [hā, Polynomial.eval₂_map, e1, ← Polynomial.hom_eval₂, ← hφ, h2, map_zero]
    obtain ⟨g, hg, hg0⟩ := hsplit ā hā0
    rw [hg, Polynomial.eval₂_mul, Polynomial.eval₂_X_pow] at h3
    have h4 : Polynomial.eval₂ ρ (Ideal.Quotient.mk M (θ (q Polynomial.X))) g = 0 :=
      (mul_eq_zero.mp h3).resolve_left (pow_ne_zero _ hx0)
    rw [← Polynomial.X_mul_divX_add g, Polynomial.eval₂_add, Polynomial.eval₂_mul,
      Polynomial.eval₂_X, Polynomial.eval₂_C] at h4
    obtain ⟨w, hw⟩ := Ideal.Quotient.mk_surjective (g.coeff 0)
    have hwu : IsUnit (f (Polynomial.C w)) := by
      rw [hf.2.1, charA, Polynomial.coeff_C_zero]
      intro hwm
      apply hg0
      rw [← hw, Ideal.Quotient.eq_zero_iff_mem]
      exact hwm
    have hρu : IsUnit (ρ (g.coeff 0)) := by
      rw [← hw, hρ]
      exact hwu.map _
    have h5 : IsUnit (Ideal.Quotient.mk M (θ (q Polynomial.X)) *
        (-(Polynomial.eval₂ ρ (Ideal.Quotient.mk M (θ (q Polynomial.X))) g.divX))) := by
      have e : Ideal.Quotient.mk M (θ (q Polynomial.X)) *
          (-(Polynomial.eval₂ ρ (Ideal.Quotient.mk M (θ (q Polynomial.X))) g.divX)) =
          ρ (g.coeff 0) := by
        linear_combination (-1 : P ⧸ M) * h4
      rw [e]
      exact hρu
    exact hmkmax _ hxmax (isUnit_of_mul_isUnit_left h5)

  have hinj : Function.Injective θ := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    by_contra hz0
    obtain ⟨h, hh0, hhz⟩ := wcNd_hens_algebraic (Polynomial ↥W) _ Q q hQ z
    obtain ⟨g, hg, hg0⟩ := hsplit h hh0
    rw [hg, Polynomial.eval₂_mul, Polynomial.eval₂_X_pow] at hhz
    have h1 : Polynomial.eval₂ q z g = 0 :=
      (mul_eq_zero.mp hhz).resolve_left (pow_ne_zero _ hz0)
    have h2 : θ (q (g.coeff 0)) = 0 := by
      have e := congrArg θ h1
      rw [Polynomial.hom_eval₂, hz, Polynomial.eval₂_at_zero, RingHom.comp_apply,
        RingHom.map_zero] at e
      exact e
    exact hg0 (hinjφ _ h2)
  refine ⟨hinj, hint, ?_⟩

  letI : Algebra Q P := θ.toAlgebra
  haveI : Module.Finite Q P := hfin
  have hJ : ∀ y : P, y ∈ Ideal.map θ (IsLocalRing.maximalIdeal Q) →
      y ∈ (IsLocalRing.maximalIdeal Q) • (⊤ : Submodule Q P) := by
    intro y hy
    rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem, RingHom.algebraMap_toAlgebra]
    exact hy
  have hMJ : M ≤ Ideal.map θ (IsLocalRing.maximalIdeal Q) := by
    rw [hMdef, Ideal.map_le_iff_le_comap]
    intro c hc
    rw [Ideal.mem_comap, ← hθC]
    apply Ideal.mem_map_of_mem
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hQ.2.1, not_not, charA,
      Polynomial.coeff_C_zero]
    exact hc
  have hexp : ∀ k, k ≤ Fintype.card ↥I → ∀ z : P,
      ∃ n ∈ Submodule.span Q (Set.range (fun j : Fin (Fintype.card ↥I) =>
        f Polynomial.X ^ (j : ℕ))), ∃ w : P,
        z - n - f Polynomial.X ^ k * w ∈ Ideal.map θ (IsLocalRing.maximalIdeal Q) := by
    intro k
    induction k with
    | zero =>
      intro _ z
      exact ⟨0, Submodule.zero_mem _, z, by simp⟩
    | succ k ih =>
      intro hk z
      obtain ⟨n, hn, w, hw⟩ := ih (Nat.le_of_succ_le hk) z
      obtain ⟨c, hc⟩ := hres w
      have hcm : w - f (Polynomial.C c) ∈ IsLocalRing.maximalIdeal P := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        exact hc
      obtain ⟨r, hr⟩ := hF1 _ hcm
      refine ⟨n + q (Polynomial.C c) • f Polynomial.X ^ k,
        Submodule.add_mem _ hn (Submodule.smul_mem _ _
          (Submodule.subset_span ⟨⟨k, hk⟩, rfl⟩)), r, ?_⟩
      have e : z - (n + q (Polynomial.C c) • f Polynomial.X ^ k) -
          f Polynomial.X ^ (k + 1) * r = (z - n - f Polynomial.X ^ k * w) +
          f Polynomial.X ^ k * (w - f (Polynomial.C c) - r * f Polynomial.X) := by
        rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra, hθC, RingHom.comp_apply]
        ring
      rw [e]
      exact Ideal.add_mem _ hw (Ideal.mul_mem_left _ _ (hMJ hr))
  have htop : (⊤ : Submodule Q P) ≤ Submodule.span Q (Set.range (fun j : Fin (Fintype.card ↥I) =>
        f Polynomial.X ^ (j : ℕ))) ⊔ (IsLocalRing.maximalIdeal Q) • ⊤ := by
    intro z _
    obtain ⟨n, hn, w, hw⟩ := hexp _ le_rfl z
    have hud' : f Polynomial.X ^ Fintype.card ↥I * w ∈
        Ideal.map θ (IsLocalRing.maximalIdeal Q) := by
      apply Ideal.mul_mem_right
      have hle : M ⊔ Ideal.span {θ (q Polynomial.X)} ≤
          Ideal.map θ (IsLocalRing.maximalIdeal Q) := by
        refine sup_le hMJ ?_
        rw [Ideal.span_le, Set.singleton_subset_iff]
        exact Ideal.mem_map_of_mem _ hqX
      exact hle hud
    have hzn : z - n ∈ Ideal.map θ (IsLocalRing.maximalIdeal Q) := by
      have := Ideal.add_mem _ hw hud'
      simpa using this
    have := Submodule.add_mem_sup hn (hJ _ hzn)
    simpa using this
  have hspan : (⊤ : Submodule Q P) ≤ Submodule.span Q (Set.range
      (fun j : Fin (Fintype.card ↥I) => f Polynomial.X ^ (j : ℕ))) :=
    Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top
      (IsLocalRing.maximalIdeal_le_jacobson _) htop

  intro p
  have hpN : ∀ i, ∃ a : Fin (Fintype.card ↥I) → Q,
      ∑ j, a j • f Polynomial.X ^ (j : ℕ) = p i := by
    intro i
    exact (Submodule.mem_span_range_iff_exists_fun Q).mp (hspan Submodule.mem_top)
  choose A hA using hpN
  let Mx : Matrix (Fin (Fintype.card ↥I + 1)) (Fin (Fintype.card ↥I + 1)) Q :=
    Matrix.of fun j i => if h : (j : ℕ) < Fintype.card ↥I then A i (Fin.castLT j h) else 0
  have hdet : Mx.det = 0 := by
    apply Matrix.det_eq_zero_of_row_eq_zero (Fin.last _)
    intro i
    simp [Mx]
  obtain ⟨v, hv0, hMv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
  have hrow : ∀ j : Fin (Fintype.card ↥I), ∑ i, A i j * v i = 0 := by
    intro j
    have := congrFun hMv (Fin.castSucc j)
    simpa [Mx, Matrix.mulVec, dotProduct] using this
  refine ⟨v, hv0, ?_⟩
  calc ∑ i, θ (v i) * p i = ∑ i, θ (v i) * ∑ j, θ (A i j) * f Polynomial.X ^ (j : ℕ) := by
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [← hA i]
        rfl
    _ = ∑ j, θ (∑ i, A i j * v i) * f Polynomial.X ^ (j : ℕ) := by
        simp only [Finset.mul_sum, map_sum, Finset.sum_mul, map_mul]
        rw [Finset.sum_comm]
        exact Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun i _ => by ring))
    _ = 0 := by simp [hrow]

theorem wcNd_hens_tensor_chart : ∀ (R₀ Q E P : Type u) [CommRing R₀] [CommRing Q] [CommRing E] [CommRing P] [HenselianLocalRing P] (q₀ : R₀ →+* Q) (ρ : R₀ →+* E) (θ : Q →+* P) (j : E →+* P), (∀ (B : Type u) [CommRing B], HenselianLocalRing B → ∀ h h' : Q →+* B, IsLocalHom h → IsLocalHom h' → h.comp q₀ = h'.comp q₀ → h = h') → wcNdIsHens (Ideal.comap j (IsLocalRing.maximalIdeal P)) P j → IsLocalHom θ → j.comp ρ = θ.comp q₀ → @Algebra.FiniteType R₀ E _ _ ρ.toAlgebra → ∃ (S : Type u) (_ : CommRing S) (_ : Algebra Q S) (_ : Algebra.FiniteType Q S) (jS : S →+* P), jS.comp (algebraMap Q S) = θ ∧ wcNdIsHens (Ideal.comap jS (IsLocalRing.maximalIdeal P)) P jS :=
by
  intro R₀ Q E P _ _ _ _ _ q₀ ρ θ j huniq hj hθ hρ hft
  letI iQ : Algebra R₀ Q := q₀.toAlgebra
  letI iE : Algebra R₀ E := ρ.toAlgebra
  letI iP : Algebra R₀ P := (θ.comp q₀).toAlgebra
  haveI : Algebra.FiniteType R₀ E := hft
  let θ' : Q →ₐ[R₀] P := { θ with commutes' := fun r => rfl }
  let j' : E →ₐ[R₀] P := { j with commutes' := fun r => by exact RingHom.congr_fun hρ r }
  let jS : TensorProduct R₀ Q E →+* P := (Algebra.TensorProduct.productMap θ' j').toRingHom
  have hJ : ∀ (a : Q) (b : E), jS (a ⊗ₜ[R₀] b) = θ a * j b := fun a b =>
    Algebra.TensorProduct.productMap_apply_tmul θ' j' a b
  have hJ1 : ∀ a : Q, jS (a ⊗ₜ[R₀] (1 : E)) = θ a := fun a => by rw [hJ, map_one, mul_one]
  have hJ2 : ∀ b : E, jS ((1 : Q) ⊗ₜ[R₀] b) = j b := fun b => by rw [hJ, map_one, one_mul]
  have hunit : ∀ s, IsUnit (jS s) ↔ s ∉ Ideal.comap jS (IsLocalRing.maximalIdeal P) := by
    intro s
    rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not]
  refine ⟨TensorProduct R₀ Q E, inferInstance, inferInstance, Algebra.FiniteType.baseChange Q,
    jS, ?_, ?_⟩
  · ext a
    show jS (algebraMap Q (TensorProduct R₀ Q E) a) = θ a
    rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply, hJ1]
  · obtain ⟨hPH, -, hjUP⟩ := hj
    refine ⟨hPH, hunit, ?_⟩
    intro B _ hB g hg
    let iL : Q →+* TensorProduct R₀ Q E := Algebra.TensorProduct.includeLeftRingHom
    let iR : E →+* TensorProduct R₀ Q E :=
      (Algebra.TensorProduct.includeRight : E →ₐ[R₀] TensorProduct R₀ Q E).toRingHom
    have hiL : ∀ a, iL a = a ⊗ₜ[R₀] (1 : E) := fun a => rfl
    have hiR : ∀ b, iR b = (1 : Q) ⊗ₜ[R₀] b := fun b => rfl
    have hEc : ∀ b, IsUnit ((g.comp iR) b) ↔ b ∉ Ideal.comap j (IsLocalRing.maximalIdeal P) := by
      intro b
      rw [RingHom.comp_apply, hg, hiR, Ideal.mem_comap, Ideal.mem_comap, hJ2]
    obtain ⟨k, ⟨hkj, hkl⟩, hk⟩ := hjUP B hB (g.comp iR) hEc
    have hQl : IsLocalHom (g.comp iL) := by
      refine ⟨fun a ha => ?_⟩
      rw [RingHom.comp_apply, hg, hiL, Ideal.mem_comap, hJ1, IsLocalRing.mem_maximalIdeal,
        mem_nonunits_iff, not_not] at ha
      exact isUnit_of_map_unit θ a ha
    haveI := hkl
    have hkθl : IsLocalHom (k.comp θ) := RingHom.isLocalHom_comp k θ
    have hcomp : (k.comp θ).comp q₀ = (g.comp iL).comp q₀ := by
      ext r
      show k (θ (q₀ r)) = g (iL (q₀ r))
      have e1 : θ (q₀ r) = j (ρ r) := (RingHom.congr_fun hρ r).symm
      have e2 : k (j (ρ r)) = g (iR (ρ r)) := RingHom.congr_fun hkj (ρ r)
      have e3 : iL (q₀ r) = iR (ρ r) := Algebra.TensorProduct.tmul_one_eq_one_tmul r
      rw [e1, e2, e3]
    have hkθ : k.comp θ = g.comp iL := huniq B hB _ _ hkθl hQl hcomp
    refine ⟨k, ⟨?_, hkl⟩, ?_⟩
    · refine RingHom.ext fun s => ?_
      induction s using TensorProduct.induction_on with
      | zero => simp
      | tmul a b =>
        show k (jS (a ⊗ₜ[R₀] b)) = g (a ⊗ₜ[R₀] b)
        rw [hJ, map_mul, ← RingHom.comp_apply k θ, hkθ, ← RingHom.comp_apply k j, hkj,
          RingHom.comp_apply, RingHom.comp_apply, hiL, hiR, ← map_mul,
          Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    · rintro k' ⟨hk'j, hk'l⟩
      apply hk k'
      refine ⟨?_, hk'l⟩
      refine RingHom.ext fun b => ?_
      rw [RingHom.comp_apply, ← hJ2, ← RingHom.comp_apply k' jS, hk'j]
      rfl

theorem wcNd_hens_generic_fibre : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] (p : Ideal A), p.IsPrime → ∀ (Q : Type u) [CommRing Q] (q : A →+* Q), wcNdIsHens p Q q → ∀ 𝔔 : Ideal Q, 𝔔.IsPrime → Ideal.comap q 𝔔 = ⊥ → 𝔔 = ⊥ :=
by
  intro A _ _ _ p hp Q _ q hq 𝔔 _ hc
  haveI : IsDomain Q := (wcNd_hens_normal_domain A p hp Q q hq).1
  rw [Submodule.eq_bot_iff]
  intro z hz
  by_contra hz0
  have claim : ∀ n : ℕ, ∀ h : Polynomial A, h.natDegree = n → h ≠ 0 →
      Polynomial.eval₂ q z h = 0 → False := by
    intro n
    refine Nat.strong_induction_on n ?_
    intro n ih h hn hne hev
    have hdec : Polynomial.eval₂ q z h.divX * z + q (h.coeff 0) = 0 := by
      have h1 := congrArg (Polynomial.eval₂ q z) (Polynomial.divX_mul_X_add h)
      rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X,
        Polynomial.eval₂_C] at h1
      rw [h1, hev]
    have hc0mem : q (h.coeff 0) ∈ 𝔔 := by
      have h2 : q (h.coeff 0) = -(Polynomial.eval₂ q z h.divX * z) := by
        linear_combination hdec
      rw [h2]
      exact 𝔔.neg_mem (𝔔.mul_mem_left _ hz)
    have hc0 : h.coeff 0 = 0 := by
      have h3 : h.coeff 0 ∈ Ideal.comap q 𝔔 := Ideal.mem_comap.mpr hc0mem
      rw [hc] at h3
      exact (Ideal.mem_bot).mp h3
    have he : Polynomial.eval₂ q z h.divX = 0 := by
      rw [hc0, map_zero, add_zero] at hdec
      exact (mul_eq_zero.mp hdec).resolve_right hz0
    have hdne : h.divX ≠ 0 := by
      intro h0
      apply hne
      rw [← Polynomial.divX_mul_X_add h, h0, hc0]
      simp
    have hn0 : n ≠ 0 := by
      intro h0
      apply hne
      rw [Polynomial.eq_C_of_natDegree_eq_zero (hn.trans h0), hc0, map_zero]
    exact ih (n - 1) (by omega) h.divX
      (by rw [Polynomial.natDegree_divX_eq_natDegree_tsub_one, hn]) hdne he
  obtain ⟨h, hne, hev⟩ := wcNd_hens_algebraic A p Q q hq z
  exact claim _ h rfl hne hev

theorem wcNd_rank_le_of_fibre_span : ∀ (Q P : Type u) [CommRing Q] [IsDomain Q] [CommRing P] (θ : Q →+* P), θ.Finite → ∀ (𝔭 : Ideal Q), 𝔭.IsPrime → ∀ (n : ℕ) (e : Fin n → P) (s : Q), s ∉ 𝔭 → (∀ z : P, ∃ a : Fin n → Q, θ s * z - ∑ i, θ (a i) * e i ∈ Ideal.map θ 𝔭) → ∀ p : Fin (n + 1) → P, ∃ c : Fin (n + 1) → Q, c ≠ 0 ∧ ∑ i, θ (c i) * p i = 0 :=
by
  intro Q P _ _ _ θ hfin 𝔭 h𝔭 n e s hs H p
  classical
  letI := θ.toAlgebra
  haveI : Module.Finite Q P := hfin
  have hsmul : ∀ (x : Q) (y : P), x • y = θ x * y := fun x y => by
    rw [Algebra.smul_def]; rfl
  set N : Submodule Q P := Submodule.span Q (Set.range e) with hN
  set f : Module.End Q (P ⧸ N) := algebraMap Q (Module.End Q (P ⧸ N)) s with hf
  have hrange : LinearMap.range f ≤ 𝔭 • ⊤ := by
    rintro _ ⟨m, rfl⟩
    obtain ⟨z, rfl⟩ := N.mkQ_surjective m
    obtain ⟨a, ha⟩ := H z
    have hsum : ∑ i, θ (a i) * e i ∈ N := by
      refine Submodule.sum_mem _ (fun i _ => ?_)
      rw [← hsmul]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
    have hw : θ s * z - ∑ i, θ (a i) * e i ∈ (𝔭 • ⊤ : Submodule Q P) := by
      rw [Ideal.smul_top_eq_map]
      exact ha
    have h0 : N.mkQ (∑ i, θ (a i) * e i) = 0 := by
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]; exact hsum
    have e1 : f (N.mkQ z) = N.mkQ (θ s * z - ∑ i, θ (a i) * e i) := by
      rw [hf, Module.algebraMap_end_apply, map_sub, h0, sub_zero, ← hsmul, map_smul]
    rw [e1]
    have h2 := Submodule.mem_map_of_mem (f := N.mkQ) hw
    rw [Submodule.map_smul''] at h2
    exact Submodule.smul_mono le_rfl le_top h2
  obtain ⟨F, hFmon, -, hFcoeff, hFf⟩ :=
    LinearMap.exists_monic_and_natDegree_eq_and_coeff_mem_pow_and_aeval_eq_zero Q f 𝔭 hrange
  have ht : ∀ m : P ⧸ N, F.eval s • m = 0 := by
    intro m
    rw [hf, Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval] at hFf
    have := LinearMap.congr_fun hFf m
    rwa [Module.algebraMap_end_apply] at this
  have htp : F.eval s ∉ 𝔭 := by
    intro hmem
    apply hs
    apply h𝔭.mem_of_pow_mem F.natDegree
    have hS : ∑ k ∈ Finset.range F.natDegree, F.coeff k * s ^ k ∈ 𝔭 := by
      refine Ideal.sum_mem _ (fun k hk => Ideal.mul_mem_right _ _ ?_)
      have hk' : F.natDegree - k ≠ 0 := by
        have := Finset.mem_range.mp hk; omega
      exact Ideal.pow_le_self hk' (hFcoeff k)
    have heval : F.eval s =
        ∑ k ∈ Finset.range F.natDegree, F.coeff k * s ^ k + s ^ F.natDegree := by
      rw [Polynomial.eval_eq_sum_range, Finset.sum_range_succ, hFmon.coeff_natDegree, one_mul]
    have e2 : s ^ F.natDegree = F.eval s - ∑ k ∈ Finset.range F.natDegree, F.coeff k * s ^ k := by
      rw [heval]; ring
    rw [e2]
    exact Ideal.sub_mem _ hmem hS
  have hspan : ∀ z : P, ∃ b : Fin n → Q, θ (F.eval s) * z = ∑ i, θ (b i) * e i := by
    intro z
    have hz : F.eval s • z ∈ N := by
      rw [← Submodule.Quotient.mk_eq_zero, Submodule.Quotient.mk_smul]; exact ht _
    obtain ⟨b, hb⟩ := (Submodule.mem_span_range_iff_exists_fun Q).mp hz
    refine ⟨b, ?_⟩
    rw [← hsmul, ← hb]
    simp only [hsmul]
  choose b hb using fun j => hspan (p j)
  have hnli : ¬ LinearIndependent Q b := by
    intro hli
    have := hli.fintype_card_le_finrank
    simp at this
  obtain ⟨g, hg, j₀, hj₀⟩ := Fintype.not_linearIndependent_iff.mp hnli
  have ht0 : F.eval s ≠ 0 := fun h => htp (h ▸ 𝔭.zero_mem)
  refine ⟨fun j => g j * F.eval s, ?_, ?_⟩
  · intro hc
    exact mul_ne_zero hj₀ ht0 (congrFun hc j₀)
  · have hgi : ∀ i, ∑ j, g j * b j i = 0 := by
      intro i
      have := congrFun hg i
      simpa [Finset.sum_apply] using this
    calc ∑ j, θ (g j * F.eval s) * p j = ∑ j, θ (g j) * (θ (F.eval s) * p j) := by
          refine Finset.sum_congr rfl (fun j _ => ?_); rw [map_mul]; ring
      _ = ∑ j, θ (g j) * ∑ i, θ (b j i) * e i := by
          refine Finset.sum_congr rfl (fun j _ => ?_); rw [hb j]
      _ = ∑ i, θ (∑ j, g j * b j i) * e i := by
          simp only [Finset.mul_sum, map_sum, Finset.sum_mul, map_mul]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => by ring))
      _ = 0 := by simp [hgi]

theorem wcNd_finite_span_pow : ∀ (D D' : Type u) [CommRing D] [IsLocalRing D] [CommRing D'] (φ : D →+* D'), φ.Finite → ∀ (x : D), x ∈ IsLocalRing.maximalIdeal D → ∀ (π w : D') (n : ℕ), IsUnit w → φ x = w * π ^ n → (∀ z : D', ∃ a : D, z - φ a ∈ Ideal.span {π}) → ∀ z : D', ∃ a : Fin n → D, z = ∑ i, φ (a i) * π ^ (i : ℕ) :=
by
  intro D D' _ _ _ φ hfin x hx π w n hw hφx hres
  have hexp : ∀ (k : ℕ) (z : D'), ∃ (a : Fin k → D) (r : D'),
      z = ∑ i, φ (a i) * π ^ (i : ℕ) + r * π ^ k := by
    intro k
    induction k with
    | zero => intro z; exact ⟨Fin.elim0, z, by simp⟩
    | succ k ih =>
      intro z
      obtain ⟨a, r, hz⟩ := ih z
      obtain ⟨b, hb⟩ := hres r
      obtain ⟨s, hs⟩ := Ideal.mem_span_singleton'.mp hb
      refine ⟨Fin.snoc (α := fun _ => D) a b, s, ?_⟩
      rw [Fin.sum_univ_castSucc]
      simp only [Fin.snoc_castSucc, Fin.snoc_last, Fin.val_castSucc, Fin.val_last]
      linear_combination hz - π ^ k * hs
  letI : Algebra D D' := φ.toAlgebra
  haveI : Module.Finite D D' := hfin
  have hsmul : ∀ (c : D) (y : D'), c • y = φ c * y := fun c y => by
    rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra]
  obtain ⟨u, rfl⟩ := hw
  have hle : (⊤ : Submodule D D') ≤
      Submodule.span D (Set.range (fun i : Fin n => π ^ (i : ℕ))) ⊔
        IsLocalRing.maximalIdeal D • ⊤ := by
    intro z _
    obtain ⟨a, r, hz⟩ := hexp n z
    rw [Submodule.mem_sup]
    refine ⟨∑ i, φ (a i) * π ^ (i : ℕ), ?_, x • (r * ↑u⁻¹),
      Submodule.smul_mem_smul hx Submodule.mem_top, ?_⟩
    · refine Submodule.sum_mem _ (fun i _ => ?_)
      rw [← hsmul]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
    · rw [hsmul, hφx, hz]
      have h1 : (u : D') * ↑u⁻¹ = 1 := u.mul_inv
      linear_combination (r * π ^ n) * h1
  have htop := Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top
    (IsLocalRing.maximalIdeal_le_jacobson ⊥) hle
  intro z
  have hzN := htop (Submodule.mem_top (x := z))
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun D).mp hzN
  refine ⟨c, ?_⟩
  rw [← hc]
  exact Finset.sum_congr rfl (fun i _ => hsmul _ _)

theorem wcNd_W_prime_dichotomy : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ 𝔮 : Ideal ↥W, 𝔮.IsPrime → 𝔮 = ⊥ ∨ 𝔮 = IsLocalRing.maximalIdeal ↥W :=
by
  intro Ω _ W h 𝔮 h𝔮
  haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr h
  haveI : (⊥ : Ideal ↥W).IsPrime := Ideal.isPrime_bot
  by_cases h0 : 𝔮 = ⊥
  · exact Or.inl h0
  · right
    have hmax : 𝔮.IsMaximal := Ring.krullDimLE_one_iff_of_isPrime_bot.mp inferInstance 𝔮 h0 h𝔮
    exact IsLocalRing.eq_maximalIdeal hmax

theorem wcNd_normB1_core : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (P : Type u) [CommRing P] (σ : ↥W →+* P) (g : ↥W), g ∈ IsLocalRing.maximalIdeal ↥W → g ≠ 0 →
    ∀ (f : (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+* P),
    f.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = σ →
    wcNdIsHens ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
        (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map (Ideal.Quotient.mk _)) P f →
    ∀ (I : Subgroup (P ≃+* P)) [Fintype ↥I], (∀ c, σ c ∈ wcNdFix I) →
    (∀ τ ∈ I, Ideal.map τ ((IsLocalRing.maximalIdeal ↥W).map σ ⊔
        Ideal.span {f (Ideal.Quotient.mk _ (MvPolynomial.X 1))}) =
      (IsLocalRing.maximalIdeal ↥W).map σ ⊔ Ideal.span {f (Ideal.Quotient.mk _ (MvPolynomial.X 1))}) →
    ∀ (Q : Type u) [CommRing Q] (q : (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C (g ^ Fintype.card ↥I)}) →+* Q),
    wcNdIsHens ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
        (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map (Ideal.Quotient.mk _)) Q q →
    ∀ θ : Q →+* P, IsLocalHom θ →
    (∀ c, θ (q (Ideal.Quotient.mk _ (MvPolynomial.C c))) = σ c) →
    θ (q (Ideal.Quotient.mk _ (MvPolynomial.X 0))) =
      ∏ τ : ↥I, (τ : P ≃+* P) (f (Ideal.Quotient.mk _ (MvPolynomial.X 0))) →
    θ (q (Ideal.Quotient.mk _ (MvPolynomial.X 1))) =
      ∏ τ : ↥I, (τ : P ≃+* P) (f (Ideal.Quotient.mk _ (MvPolynomial.X 1))) →
    Function.Injective θ ∧ θ.IsIntegral ∧
      ∀ p : Fin (Fintype.card ↥I + 1) → P, ∃ c : Fin (Fintype.card ↥I + 1) → Q, c ≠ 0 ∧
        ∑ i, θ (c i) * p i = 0 :=
by
  intro Ω _ _ W hW hWt P _ σ g hgm hg0 f hfC hf I _ hI hJ Q _ q hq θ hθl hθC hθX0 hθX1
  classical
  haveI : HenselianLocalRing P := hf.1
  haveI : HenselianLocalRing Q := hq.1

  have Hprime : ∀ {A : Type u} [CommRing A] (p : Ideal A) (R : Type u) [CommRing R] [IsLocalRing R]
      (e : A →+* R), (∀ a, IsUnit (e a) ↔ a ∉ p) → p.IsPrime := by
    intro A _ p R _ _ e he
    have hp : p = Ideal.comap e (IsLocalRing.maximalIdeal R) := by
      ext a
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, he a, not_not]
    rw [hp]; exact Ideal.comap_isPrime _ _
  have Dich : ∀ (J : Ideal P) [J.IsPrime] [IsDomain (P ⧸ J)] [IsDiscreteValuationRing (P ⧸ J)]
      (𝔓 : Ideal P), 𝔓.IsPrime → J ≤ 𝔓 → 𝔓 = J ∨ 𝔓 = IsLocalRing.maximalIdeal P := by
    intro J _ _ _ 𝔓 h𝔓 hJ𝔓
    have hker : RingHom.ker (Ideal.Quotient.mk J) ≤ 𝔓 := by rw [Ideal.mk_ker]; exact hJ𝔓
    haveI := h𝔓
    have hpr : (𝔓.map (Ideal.Quotient.mk J)).IsPrime :=
