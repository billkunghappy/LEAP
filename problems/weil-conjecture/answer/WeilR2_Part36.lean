          rw [← hx, inv_pow, ← div_eq_mul_inv, eq_div_iff (pow_ne_zero _ hx0), ← pow_succ',
            Nat.sub_add_cancel hℓ.one_le]
        rw [e1]
        exact W.mul_mem _ _ δ.2 (W.pow_mem h1 _)
    refine ⟨⟨x, hxW⟩, fun h0 => hx0 (congrArg Subtype.val h0), ?_⟩
    apply Subtype.ext
    rw [SubmonoidClass.coe_pow]
    exact hx

  have hcongr : ∀ (S T : Subalgebra A K) (hST : S = T) (I : Ideal ↥S) (J : Ideal ↥T),
      I ≤ J.comap (Subalgebra.equivOfEq S T hST) →
      J ≤ I.comap (Subalgebra.equivOfEq T S hST.symm) →
      (∀ (𝔮 : Ideal ↥(integralClosure ↥T L)) [𝔮.IsPrime],
        𝔮.comap (algebraMap ↥T ↥(integralClosure ↥T L)) = J →
