theorem wcpa_dj_lr1k_nsr_nlb_ue_ur_dp_eval : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (X : Scheme.{u}) (uX : X ⟶ Spec (.of R)) (x : ↥X) (V : X.Opens) (hxV : x ∈ V) (σ : Spec (.of R) ⟶ X), σ ≫ uX = 𝟙 _ → σ (IsLocalRing.closedPoint R) = x → ∃ ε : ↥(X.presheaf.stalk x) →+* R, IsLocalHom ε ∧ (∀ w : R, ε (wcNdSig uX x w) = w) ∧ ∀ (e' : ⊤ ≤ σ ⁻¹ᵁ V) (h : Γ(X, V)), ε ((X.presheaf.germ V x hxV).hom h) = (Scheme.ΓSpecIso (.of R)).hom.hom ((σ.appLE V ⊤ e').hom h) :=
