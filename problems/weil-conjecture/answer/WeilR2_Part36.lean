  have hcomp : ∀ (V : ((γ ≫ ι).normalization).Opens)
      (Φ₁ Φ₂ : (γ ≫ ι).normalization ⟶ (γ ≫ ι).normalization)
      (h₁ : V ≤ Φ₁ ⁻¹ᵁ V) (h₂ : V ≤ Φ₂ ⁻¹ᵁ V) (h₃ : V ≤ (Φ₂ ≫ Φ₁) ⁻¹ᵁ V)
