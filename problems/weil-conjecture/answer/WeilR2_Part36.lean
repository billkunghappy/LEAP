        (wcLr1uGerm (γ ≫ ι₁).toNormalization (wcNdPt W (γ ≫ ι₁) (r₁ ≫ uX) ζ) hζ).hom s' +
        (wcLr1uGerm (γ ≫ ι₁).toNormalization (wcNdPt W (γ ≫ ι₁) (r₁ ≫ uX) ζ) hζ).hom (s - s') := by
      rw [map_sub]; ring
    rw [e]
