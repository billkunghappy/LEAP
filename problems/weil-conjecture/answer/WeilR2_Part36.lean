theorem wcpa_dj_lr1k_nsr_gub_itmp_si_den_fiber_bound : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W), ϖ ≠ 0 → (∀ (m : ℕ) (a : Fin m → Polynomial Ω), ∃ e : ℕ, ∀ i, ∃ A : Polynomial ↥W, A.map (algebraMap (↥W) Ω) = Polynomial.C ((ϖ : Ω) ^ e) * a i) → ∀ (C : Type u) [CommRing C] [Algebra ↥W C] (D : Type u) [CommRing D] [Algebra C D] [Algebra Ω D], Function.Injective (algebraMap C D) → (∀ w : ↥W, algebraMap Ω D (w : Ω) = algebraMap C D (algebraMap (↥W) C w)) → ∀ (τ : C) (n : ℕ) (b : Fin n → C), (∀ d : D, ∃ a : Fin n → Polynomial Ω, d = ∑ l, Polynomial.aeval (algebraMap C D τ) (a l) * algebraMap C D (b l)) → ∀ (t : ↥W) (S : Finset (C →+* Ω)), (∀ P ∈ S, (∀ w : ↥W, P (algebraMap (↥W) C w) = (w : Ω)) ∧ P τ = (t : Ω)) → S.card ≤ n :=
