  have hθC : ∀ w : ↥W, θ₀ (MvPolynomial.C w) = Ideal.Quotient.mk I (MvPolynomial.C w) :=
    fun w => by simp [θ₀]
  have hθX : θ₀ (MvPolynomial.X 0) = Ideal.Quotient.mk I (MvPolynomial.X 0) := by simp [θ₀]
  let θc : CommRingCat.of (MvPolynomial (Fin 1) ↥W) ⟶
      CommRingCat.of (MvPolynomial (Fin 2) ↥W ⧸ I) :=
    CommRingCat.ofHom θ₀
  let h : Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ I)) ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W)) :=
    Spec.map θc
  have hnat : ∀ z, h.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom z) =
      (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom (θ₀ z) := by
    intro z
