  rw [hJ] at hrM

  obtain ⟨U, t, hU⟩ := wc_bp_blowup_charts _ rM hrM

  have hgermc : ∀ {A B Z : Scheme.{u}} (f : A ⟶ B) (k : B ⟶ Z) (O : Z.Opens) (s : Γ(Z, O))
      (a : ↥A) (ha : f a ∈ k ⁻¹ᵁ O) (ha' : a ∈ (f ≫ k) ⁻¹ᵁ O),
      (f.stalkMap a).hom ((B.presheaf.germ (k ⁻¹ᵁ O) (f a) ha).hom ((k.app O).hom s)) =
        (A.presheaf.germ ((f ≫ k) ⁻¹ᵁ O) a ha').hom (((f ≫ k).app O).hom s) := by
    intro A B Z f k O s a ha ha'
    rw [Scheme.Hom.germ_stalkMap_apply]
