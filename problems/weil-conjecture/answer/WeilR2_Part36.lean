  set φW := (wcLr1uConst (γ ≫ wcProjKStr Ω 1)).comp W.subtype with hφW
  set κ := wcNdSig uX x with hκ
  have hGκ : ∀ w : ↥W, G (κ w) = φW w := fun w => hGκ0 w

  have htrW : ∀ P : Polynomial ↥W, P.eval₂ φW t = 0 → P = 0 := by
    intro P hP
    have h1 : (P.map W.subtype).eval₂ (wcLr1uConst (γ ≫ wcProjKStr Ω 1)) t = 0 := by
      rw [Polynomial.eval₂_map]; exact hP
    have h2 := htr _ h1
    exact Polynomial.map_injective _ (fun a b h => Subtype.ext h)
      (by rw [h2, Polynomial.map_zero])

  have KF : ∀ ε : ↥(X.presheaf.stalk x) →+* ↥W, (∀ w, ε (κ w) = w) →
      ∀ (s : ↥(X.presheaf.stalk x)) (p q : Polynomial ↥W), G s * q.eval₂ φW t = p.eval₂ φW t →
      ε s * q.eval (ε s₀) = p.eval (ε s₀) := by
