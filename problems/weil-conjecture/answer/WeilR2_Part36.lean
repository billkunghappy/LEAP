theorem wcpa_dj_lr1k_nsr_nlb_invariance : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1)
    (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
    [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)] (x : ↥X)
    (y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX)) (A : ValuationSubring C.functionField),
    wcNsrNlbLim W γ uX ι x A →
    wcNsrNaDom A (γ ≫ ι).toNormalization (wcNdPt W (γ ≫ ι) uX y₀) →
    (∀ A' : ValuationSubring C.functionField, wcNsrNlbLim W γ uX ι x A' →
      wcNsrNaDom A' (γ ≫ ι).toNormalization (wcNdPt W (γ ≫ ι) uX y₀) → A' = A) →
    ∀ g : Aut C, wcpaDjLlFixes W γ ι uX y₀ g →
    ∀ (V : C.Opens) (t : Γ(C, V)) (hV : genericPoint ↥C ∈ V)
      (hV' : genericPoint ↥C ∈ g.hom ⁻¹ᵁ V),
      (A.valuation ((C.presheaf.germ V (genericPoint ↥C) hV).hom t) ≤ 1 ↔
        A.valuation ((C.presheaf.germ (g.hom ⁻¹ᵁ V) (genericPoint ↥C) hV').hom
          ((g.hom.app V).hom t)) ≤ 1) :=
by
  intro Ω _ W C _ γ X uX ι _ _ x y₀ A hL hD hU g hF V t hV hV'
  classical

  have Hpre : ∀ (g1 : C ⟶ C) (h₀ : g1 (genericPoint C) ⤳ genericPoint C) {N : Scheme.{u}}
      (t1 : C ⟶ N) (n : N) (h : t1 (genericPoint C) ⤳ n) (h' : (g1 ≫ t1) (genericPoint C) ⤳ n),
      wcLr1uGerm t1 n h ≫ wcLr1uGerm g1 (genericPoint C) h₀ = wcLr1uGerm (g1 ≫ t1) n h' := by
    intro g1 h₀ N t1 n h h'
    unfold wcLr1uGerm
    rw [Scheme.Hom.stalkMap_comp]
    simp only [Category.assoc]
    rw [← Scheme.Hom.stalkSpecializes_stalkMap_assoc, TopCat.Presheaf.stalkSpecializes_comp_assoc]
    rfl

  have Hopen : ∀ (g1 : C ⟶ C) (h₀ : g1 (genericPoint C) ⤳ genericPoint C) (V : C.Opens)
      (hV : genericPoint C ∈ V) (hV' : genericPoint C ∈ g1 ⁻¹ᵁ V),
      C.presheaf.germ V (genericPoint C) hV ≫ wcLr1uGerm g1 (genericPoint C) h₀ =
        g1.app V ≫ C.presheaf.germ (g1 ⁻¹ᵁ V) (genericPoint C) hV' := by
    intro g1 h₀ V hV hV'
    unfold wcLr1uGerm
    rw [TopCat.Presheaf.germ_stalkSpecializes_assoc, Scheme.Hom.germ_stalkMap]

  have Hpost : ∀ {N : Scheme.{u}} (t1 : C ⟶ N) (g' : N ⟶ N) (n : N)
      (h : t1 (genericPoint C) ⤳ n) (h' : (t1 ≫ g') (genericPoint C) ⤳ n) (hn : g' n ⤳ n),
      wcLr1uGerm (t1 ≫ g') n h' =
        (N.presheaf.stalkSpecializes hn ≫ g'.stalkMap n) ≫ wcLr1uGerm t1 n h := by
    intro N t1 g' n h h' hn
    unfold wcLr1uGerm
    rw [Scheme.Hom.stalkMap_comp]
    simp only [Category.assoc]
    rw [← Scheme.Hom.stalkSpecializes_stalkMap_assoc, TopCat.Presheaf.stalkSpecializes_comp_assoc]
    rfl

  have Hloc : ∀ {N : Scheme.{u}} (m n : N) (hm : m ⤳ n), m = n →
      IsLocalHom (N.presheaf.stalkSpecializes hm).hom := by
    intro N m n hm e
    subst e
    rw [TopCat.Presheaf.stalkSpecializes_refl]
    exact isLocalHom_id _

  have Hcongr : ∀ {N : Scheme.{u}} (t1 t2 : C ⟶ N), t1 = t2 → ∀ (n : N)
      (h1 : t1 (genericPoint C) ⤳ n) (h2 : t2 (genericPoint C) ⤳ n),
