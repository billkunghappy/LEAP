  have Hfix : ∀ {X₁ : Scheme.{u}} (ι₁ : wcProjK Ω 1 ⟶ X₁) (y : X₁)
      (hy : (γ ≫ ι₁) (genericPoint C) ⤳ y) (a : X₁.presheaf.stalk y),
