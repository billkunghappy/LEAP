by
  intro Ω _ _ W _ hWt C _ γ _ X' u' ι' _ _ _ n f hRad V hRig hCen
  classical
  have core : ∀ (N : Scheme.{u}) (sC : C ⟶ Spec (.of Ω)) (t : C ⟶ N) (n : N)
      (f : Fin 2 → N.presheaf.stalk n),
      (∀ i, f i ∈ IsLocalRing.maximalIdeal (N.presheaf.stalk n)) →
      wcUbRigid W sC V → wcNsrCentred t n V →
      ∃ c : ↥W, c ≠ 0 ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧ wcTcBox sC t n f (c : Ω) V := by
    intro N sC t n f hf hRig hCen
    obtain ⟨P, -, hV⟩ := hRig
    unfold wcNsrCentred wcLr1uDom at hCen
    obtain ⟨hn, hD1, hD2⟩ := hCen
    set sp : C.presheaf.stalk P →+* C.functionField :=
      (C.presheaf.stalkSpecializes (genericPoint_specializes P)).hom with hsp
    set κP : Ω →+* C.presheaf.stalk P :=
      ((Scheme.ΓSpecIso (.of Ω)).inv ≫ sC.appTop ≫ C.presheaf.germ ⊤ P trivial).hom with hκP
    set germ : N.presheaf.stalk n →+* C.functionField := (wcLr1uGerm t n hn).hom with hgerm

    have hK0 : ∀ x : Ω, sp (κP x) = wcLr1uConst sC x := by
      intro x
