theorem wcpa_dj_lr1k_nsr_gub_itmp_si_den_root_approx : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (ϖ : ↥W), ϖ ≠ 0 → ∀ (p : Polynomial ↥W), p.Monic → 0 < p.natDegree → ∀ (β : ↥W) (M : ℕ), ϖ ^ (p.natDegree * M) ∣ p.eval β → ∃ μ : ↥W, p.eval μ = 0 ∧ ϖ ^ M ∣ β - μ :=
