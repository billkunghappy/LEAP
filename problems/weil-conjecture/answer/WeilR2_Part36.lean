theorem wcpa_dj_llsm_smpcgbtige_disc_factors : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (R : List ↥W) (x γ : ↥W), γ ≠ 0 → (∀ α : ↥W, (∀ r ∈ R, γ ∣ x - r → x + γ * α - r ∣ γ) → ((R.map (fun r => @ite _ (γ ∣ x - r) (Classical.propDecidable _) γ (x - r))).prod ∣ (R.map (fun r => x + γ * α - r)).prod ∧ (R.map (fun r => x + γ * α - r)).prod ∣ (R.map (fun r => @ite _ (γ ∣ x - r) (Classical.propDecidable _) γ (x - r))).prod)) ∧ ∃ D : Polynomial (IsLocalRing.ResidueField ↥W), D ≠ 0 ∧ ∀ α : ↥W, D.eval (IsLocalRing.residue ↥W α) ≠ 0 → ∀ r ∈ R, γ ∣ x - r → x + γ * α - r ∣ γ :=
by
  intro Ω _ W R x γ _hγ
  have hlist : ∀ (L : List ↥W) (g f : ↥W → ↥W), (∀ r ∈ L, g r ∣ f r ∧ f r ∣ g r) →
      (L.map g).prod ∣ (L.map f).prod ∧ (L.map f).prod ∣ (L.map g).prod := by
    intro L g f h
    induction L with
    | nil => simp
    | cons a L ih =>
      have ha := h a List.mem_cons_self
      have ih' := ih (fun r hr => h r (List.mem_cons_of_mem a hr))
      simp only [List.map_cons, List.prod_cons]
      exact ⟨mul_dvd_mul ha.1 ih'.1, mul_dvd_mul ha.2 ih'.2⟩
  refine ⟨fun α hα => ?_, ?_⟩
  · refine hlist R _ _ (fun r hr => ?_)
    by_cases h : γ ∣ x - r
    · rw [if_pos h]
      refine ⟨?_, hα r hr h⟩
      have e : x + γ * α - r = (x - r) + γ * α := by ring
      rw [e]
      exact dvd_add h (dvd_mul_right γ α)
    · rw [if_neg h]
      obtain ⟨k, hk⟩ := (ValuationRing.dvd_total γ (x - r)).resolve_left h
      have e2 : x - r = (x + γ * α - r) - γ * α := by ring
      refine ⟨⟨1 + k * α, ?_⟩, ?_⟩
      · rw [hk]; ring
      · rcases ValuationRing.dvd_total (x + γ * α - r) γ with h1 | h1
        · rw [e2]
          exact dvd_sub (dvd_refl _) (h1.mul_right α)
        · exfalso
          apply h
          rw [e2]
          exact dvd_sub h1 (dvd_mul_right γ α)
  · have hex : ∀ r : ↥W, ∃ v : ↥W, γ ∣ x - r → x - r = γ * v := by
      intro r
      by_cases h : γ ∣ x - r
      · obtain ⟨v, hv⟩ := h
        exact ⟨v, fun _ => hv⟩
      · exact ⟨0, fun h' => absurd h' h⟩
    choose u hu using hex
    refine ⟨(R.map (fun r => Polynomial.X + Polynomial.C (IsLocalRing.residue ↥W (u r)))).prod,
      ?_, ?_⟩
    · apply List.prod_ne_zero
      intro h0
      obtain ⟨r, _, hr⟩ := List.mem_map.mp h0
      exact Polynomial.X_add_C_ne_zero _ hr
    · intro α hD r hr h
      have hne : Polynomial.eval (IsLocalRing.residue ↥W α)
          (Polynomial.X + Polynomial.C (IsLocalRing.residue ↥W (u r))) ≠ 0 := by
        intro h0
        apply hD
        rw [Polynomial.eval_list_prod]
        apply List.prod_eq_zero
        exact List.mem_map.mpr ⟨_, List.mem_map.mpr ⟨r, hr, rfl⟩, h0⟩
      rw [Polynomial.eval_add, Polynomial.eval_X, Polynomial.eval_C, ← map_add] at hne
      have hunit : IsUnit (α + u r) := (IsLocalRing.residue_ne_zero_iff_isUnit _).mp hne
      obtain ⟨w', hw'⟩ := hunit.exists_right_inv
      have e := hu r h
      refine ⟨w', ?_⟩
      have e3 : x + γ * α - r = γ * (α + u r) := by linear_combination e
      rw [e3, mul_assoc, hw', mul_one]

theorem wcpa_dj_llsm_smpcgbtige_poly_compare : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (Pt : Polynomial ↥W) (G ε : ↥W) (D : Polynomial (IsLocalRing.ResidueField ↥W)), G ≠ 0 → G ∣ ε → ¬ ε ∣ G → D ≠ 0 → (∀ α : ↥W, D.eval (IsLocalRing.residue ↥W α) ≠ 0 → ∃ z : ↥W, G ∣ z ∧ z ∣ G ∧ ε ∣ z - Pt.eval α) → (∃ α₀ : ↥W, ε ∣ Pt.eval α₀) → ∃ Kt : Polynomial ↥W, Pt = Polynomial.C G * Kt ∧ (∃ i, Kt.coeff i ∉ IsLocalRing.maximalIdeal ↥W) ∧ 0 < (Kt.map (IsLocalRing.residue ↥W)).natDegree :=
by
  intro Ω _ _ W Pt G ε D hG0 hGε hεG hD0 H1 H2
  classical

  have hk : IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
    refine IsAlgClosed.of_exists_root _ ?_
    intro p hpm hpirr
    have hlift : p ∈ Polynomial.lifts (IsLocalRing.residue ↥W) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      exact IsLocalRing.residue_surjective _
    obtain ⟨q, hqmap, hqdeg, hqm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hpm
    have hpdeg : 0 < p.degree := Polynomial.degree_pos_of_irreducible hpirr
    obtain ⟨x, hx⟩ := IsAlgClosed.exists_root (q.map (algebraMap ↥W Ω)) (by
      rw [hqm.degree_map, hqdeg]; exact ne_of_gt hpdeg)
    have hxint : _root_.IsIntegral ↥W x := ⟨q, hqm, by
      rw [Polynomial.IsRoot, Polynomial.eval_map] at hx; exact hx⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hxint
    have hqy : q.eval y = 0 := by
