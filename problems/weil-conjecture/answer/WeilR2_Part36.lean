        ∃ (e' : T.basicOpen f ≤ h ⁻¹ᵁ U') (r : Γ(T, V) →+* Γ(T, T.basicOpen f)),
          r ε ∈ nonZeroDivisors Γ(T, T.basicOpen f) ∧ IsUnit (r f) ∧
          Ideal.map (h.appLE U' (T.basicOpen f) e').hom J = Ideal.span {r ε} ∧
          ∀ x : Γ(X, U'), (h.appLE U' (T.basicOpen f) e').hom x = r ((h.appLE U' V e).hom x) := by
      intro U' V hV e J ε f hε hJ
      have e' : T.basicOpen f ≤ h ⁻¹ᵁ U' := (T.basicOpen_le f).trans e
      have hform : ∀ x : Γ(X, U'), (h.appLE U' (T.basicOpen f) e').hom x =
          (T.presheaf.map (homOfLE (T.basicOpen_le f)).op).hom ((h.appLE U' V e).hom x) := by
        intro x
        rw [← Scheme.Hom.appLE_map h e (homOfLE (T.basicOpen_le f)).op]
        rfl
      refine ⟨e', (T.presheaf.map (homOfLE (T.basicOpen_le f)).op).hom, ?_, ?_, ?_, hform⟩
      · exact @IsLocalization.map_nonZeroDivisors_le _ _ (Submonoid.powers f) _ _ _
          (hV.isLocalization_basicOpen f) _ (Submonoid.mem_map_of_mem _ hε)
      · exact @IsLocalization.Away.algebraMap_isUnit _ _ _ _ _ f (hV.isLocalization_basicOpen f)
      · have hcomp : (h.appLE U' (T.basicOpen f) e').hom =
            (T.presheaf.map (homOfLE (T.basicOpen_le f)).op).hom.comp (h.appLE U' V e).hom :=
          RingHom.ext hform
        rw [hcomp, ← Ideal.map_map, hJ, Ideal.map_span, Set.image_singleton]

    have LD : ∀ (U₀ D : X.affineOpens) (W : T.Opens) (eU : W ≤ h ⁻¹ᵁ U₀.1) (eD : W ≤ h ⁻¹ᵁ D.1),
        D ≤ U₀ → Ideal.map (h.appLE U₀.1 W eU).hom (I.ideal U₀) =
          Ideal.map (h.appLE D.1 W eD).hom (I.ideal D) := by
      intro U₀ D W eU eD hDU
      rw [← I.map_ideal hDU, Ideal.map_map]
      congr 1
      rw [← CommRingCat.hom_comp, Scheme.Hom.map_appLE]

    obtain ⟨U₁, V₁, e₁, a₁, htV₁, -, hε₁, hJ₁⟩ := hP t
    have hU₁ : h t ∈ U₁.1 := e₁ htV₁
    obtain ⟨D₀, hD₀, hxD₀, hD₀sub⟩ :=
      exists_isAffineOpen_mem_and_subset (x := h t) (U := U.1 ⊓ U₁.1) ⟨hU, hU₁⟩
    let D : X.affineOpens := ⟨D₀, hD₀⟩
    have hDU : D ≤ U := show D₀ ≤ U.1 from fun x hx => (hD₀sub hx).1
    have hDU₁ : D ≤ U₁ := show D₀ ≤ U₁.1 from fun x hx => (hD₀sub hx).2
    have htVD : t ∈ V₁.1 ⊓ h ⁻¹ᵁ D.1 := ⟨htV₁, hxD₀⟩
    obtain ⟨f, hf, htf⟩ := V₁.2.exists_basicOpen_le (V := V₁.1 ⊓ h ⁻¹ᵁ D.1) ⟨t, htVD⟩ htV₁
    have htf' : t ∈ T.basicOpen f := htf
    have hV₂ : IsAffineOpen (T.basicOpen f) := V₁.2.basicOpen f
    have eD : T.basicOpen f ≤ h ⁻¹ᵁ D.1 := hf.trans inf_le_right
    have eU : T.basicOpen f ≤ h ⁻¹ᵁ U.1 := fun x hx => hDU (eD hx)
    obtain ⟨eU₁, r₁, hε₂, -, hJ₂, -⟩ := LC U₁.1 V₁.1 V₁.2 e₁ (I.ideal U₁) _ f hε₁ hJ₁
    generalize r₁ ((h.appLE U₁.1 V₁.1 e₁).hom a₁) = ε₂ at hε₂ hJ₂
    have hJ : Ideal.map (h.appLE U.1 (T.basicOpen f) eU).hom (I.ideal U) = Ideal.span {ε₂} := by
      rw [LD U D _ eU eD hDU, ← LD U₁ D _ eU₁ eD hDU₁, hJ₂]

    have hJb : Ideal.span (Set.range (fun j => (h.appLE U.1 (T.basicOpen f) eU).hom (b j))) =
        Ideal.span {ε₂} := by
      rw [← hJ, ← hb, Ideal.map_span, ← Set.range_comp]
      rfl
    have hy : ∀ j, ∃ y, y * ε₂ = (h.appLE U.1 (T.basicOpen f) eU).hom (b j) := by
      intro j
      apply Ideal.mem_span_singleton'.mp
      rw [← hJb]
      exact Ideal.subset_span ⟨j, rfl⟩
    choose y hy using hy
    have hεmem : ε₂ ∈ Ideal.span (Set.range (fun j => (h.appLE U.1 (T.basicOpen f) eU).hom (b j))) := by
      rw [hJb]; exact Ideal.mem_span_singleton_self ε₂
    obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hεmem
    have hcy : ∑ j, c j * y j = 1 := by
      have h1 : (∑ j, c j * y j) * ε₂ = ε₂ := by
        rw [Finset.sum_mul]
        simp_rw [mul_assoc, hy]
        exact hc
