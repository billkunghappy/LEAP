theorem wcpa_dj_lr1k_nsr_gub_itmp_si_den_omega_alg : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W), ϖ ≠ 0 → (∀ c : ↥W, c ≠ 0 → ∃ n : ℕ, c ∣ ϖ ^ n) → ∀ (C : Type u) [CommRing C] [Algebra ↥W C], Algebra.FiniteType ↥W C → ∀ (D : Type u) [CommRing D] [Algebra C D], IsUnit (algebraMap C D (algebraMap (↥W) C ϖ)) → (∀ b : D, ∃ n : ℕ, ∃ a : C, algebraMap C D (algebraMap (↥W) C ϖ) ^ n * b = algebraMap C D a) → ∃ (_ : Algebra Ω D), (∀ w : ↥W, algebraMap Ω D (w : Ω) = algebraMap C D (algebraMap (↥W) C w)) ∧ Algebra.FiniteType Ω D :=
by
  intro Ω _ W ϖ hϖ0 hdiv C _ _ hft D _ _ hunit hgen
  classical
  let f : ↥W →+* D := (algebraMap C D).comp (algebraMap (↥W) C)
  have hW : ∀ y : nonZeroDivisors ↥W, IsUnit (f y) := by
    intro y
    obtain ⟨n, w', hw'⟩ := hdiv (y : ↥W) (nonZeroDivisors.ne_zero y.2)
    have h1 : f (y : ↥W) * f w' = (algebraMap C D (algebraMap (↥W) C ϖ)) ^ n := by
      rw [← map_mul, ← hw', map_pow]
      rfl
    have h2 : IsUnit (f (y : ↥W) * f w') := by
      rw [h1]
      exact hunit.pow n
    exact isUnit_of_mul_isUnit_left h2
  letI inst : Algebra Ω D :=
    (IsLocalization.lift (M := nonZeroDivisors ↥W) (S := Ω) hW).toAlgebra
  have hc : ∀ w : ↥W, algebraMap Ω D (w : Ω) = algebraMap C D (algebraMap (↥W) C w) :=
    fun w => IsLocalization.lift_eq hW w
  refine ⟨inst, hc, ?_⟩
  obtain ⟨s, hs⟩ := hft.out
  refine ⟨⟨s.image (algebraMap C D), ?_⟩⟩
  have hA : ∀ a : C, algebraMap C D a ∈ Algebra.adjoin Ω
      ((s.image (algebraMap C D) : Finset D) : Set D) := by
    intro a
    have ha : a ∈ Algebra.adjoin ↥W (s : Set C) := by rw [hs]; exact Algebra.mem_top
    induction ha using Algebra.adjoin_induction with
    | mem x hx =>
      exact Algebra.subset_adjoin
        (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ (Finset.mem_coe.mp hx)))
    | algebraMap r =>
      rw [← hc r]
      exact Subalgebra.algebraMap_mem _ _
    | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
  have hϖΩ : (ϖ : Ω) ≠ 0 := fun h => hϖ0 (Subtype.ext h)
  rw [eq_top_iff]
  intro z _
  obtain ⟨n, a, ha⟩ := hgen z
  have hz : z = algebraMap Ω D (((ϖ : Ω) ^ n)⁻¹) * algebraMap C D a := by
    rw [← ha, ← hc ϖ, ← map_pow, ← mul_assoc, ← map_mul,
      inv_mul_cancel₀ (pow_ne_zero n hϖΩ), map_one, one_mul]
  rw [hz]
  exact mul_mem (Subalgebra.algebraMap_mem _ _) (hA a)

theorem wcpa_dj_lr1k_nsr_gub_itmp_si_den_nn_dim : ∀ (K : Type u) [Field K] (s : ℕ) (D : Type u) [CommRing D] [IsDomain D] [Algebra K D] (g : MvPolynomial (Fin s) K →ₐ[K] D), Function.Injective g → g.Finite → ringKrullDim D ≤ 1 → s ≤ 1 :=
by
  intro K _ s D _ _ _ g hinj hfin hdim
  by_contra hs
  push_neg at hs
  have hA : ringKrullDim (MvPolynomial (Fin s) K) = ((s : ℕ∞) : WithBot ℕ∞) := by
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
      ENat.card_eq_coe_fintype_card, Fintype.card_fin, zero_add]
  have h2A : ((2 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (MvPolynomial (Fin s) K) := by
    rw [hA]
    have hs2 : 2 ≤ s := hs
    show (((2 : ℕ) : ℕ∞) : WithBot ℕ∞) ≤ ((s : ℕ∞) : WithBot ℕ∞)
    exact WithBot.coe_le_coe.mpr (by exact_mod_cast hs2)
  letI : Algebra (MvPolynomial (Fin s) K) D := (g : MvPolynomial (Fin s) K →+* D).toAlgebra
  haveI : Algebra.IsIntegral (MvPolynomial (Fin s) K) D := ⟨RingHom.Finite.to_isIntegral hfin⟩
  obtain ⟨l, hl⟩ := (Order.le_krullDim_iff).mp h2A
  set P0 := (l ⟨0, by omega⟩).asIdeal with hP0
  set P1 := (l ⟨1, by omega⟩).asIdeal with hP1
  set P2 := (l ⟨2, by omega⟩).asIdeal with hP2
  have h01 : P0 < P1 := l.strictMono (show (⟨0, by omega⟩ : Fin (l.length + 1)) < ⟨1, by omega⟩ from
    Fin.mk_lt_mk.mpr (by omega))
  have h12 : P1 < P2 := l.strictMono (show (⟨1, by omega⟩ : Fin (l.length + 1)) < ⟨2, by omega⟩ from
    Fin.mk_lt_mk.mpr (by omega))
  have hbot : Ideal.under (MvPolynomial (Fin s) K) (⊥ : Ideal D) ≤ P0 := by
    rw [Ideal.under, Ideal.comap_bot_of_injective (algebraMap (MvPolynomial (Fin s) K) D) hinj]
    exact bot_le
  obtain ⟨Q0, -, hQ0p, hQ0u⟩ := Ideal.exists_ideal_over_prime_of_isIntegral P0 ⊥ hbot
  obtain ⟨Q1, hQ01, hQ1p, hQ1u⟩ :=
    Ideal.exists_ideal_over_prime_of_isIntegral P1 Q0 (hQ0u ▸ h01.le)
  obtain ⟨Q2, hQ12, hQ2p, hQ2u⟩ :=
    Ideal.exists_ideal_over_prime_of_isIntegral P2 Q1 (hQ1u ▸ h12.le)
  have hlt01 : Q0 < Q1 := by
    refine lt_of_le_of_ne hQ01 ?_
    intro h
    apply h01.ne
    rw [← hQ0u, ← hQ1u, h]
  have hlt12 : Q1 < Q2 := by
    refine lt_of_le_of_ne hQ12 ?_
    intro h
    apply h12.ne
    rw [← hQ1u, ← hQ2u, h]
  let q : Fin 3 → PrimeSpectrum D := ![⟨Q0, hQ0p⟩, ⟨Q1, hQ1p⟩, ⟨Q2, hQ2p⟩]
  have hq : StrictMono q := by
    rw [Fin.strictMono_iff_lt_succ]
    intro i
    fin_cases i
    · exact hlt01
    · exact hlt12
  have h2D : ((2 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim D :=
    Order.le_krullDim_iff.mpr ⟨LTSeries.mk 2 q hq, rfl⟩
  have h21 := h2D.trans hdim
  exact absurd h21 (by decide)

theorem wcpa_dj_lr1k_nsr_gub_itmp_si_den_nn_dichotomy : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (D : Type u) [CommRing D] [IsDomain D] [Algebra Ω D] (s : ℕ) (g : MvPolynomial (Fin s) Ω →ₐ[Ω] D), Function.Injective g → g.Finite → s ≤ 1 → Function.Bijective (algebraMap Ω D) ∨ ∃ τ₀ : D, Function.Injective (Polynomial.aeval (R := Ω) τ₀) ∧ (Polynomial.aeval (R := Ω) τ₀).Finite :=
by
  intro Ω _ _ D _ _ _ s g hg hgfin hs
  have hs' : s = 0 ∨ s = 1 := by omega
  rcases hs' with rfl | rfl
  · left
    have hC : (algebraMap Ω (MvPolynomial (Fin 0) Ω)).Finite := by
      rw [MvPolynomial.algebraMap_eq]
      exact RingHom.Finite.of_surjective _ (MvPolynomial.C_surjective (Fin 0))
    have hgfin' : (g : MvPolynomial (Fin 0) Ω →+* D).Finite := hgfin
    have hfin : (algebraMap Ω D).Finite := by
      rw [← AlgHom.comp_algebraMap g]
      exact RingHom.Finite.comp hgfin' hC
    exact IsAlgClosed.ringHom_bijective_of_isIntegral _ hfin.to_isIntegral
  · right
    let φ : Polynomial Ω →ₐ[Ω] MvPolynomial (Fin 1) Ω := Polynomial.aeval (MvPolynomial.X 0)
    let ψ : MvPolynomial (Fin 1) Ω →ₐ[Ω] Polynomial Ω :=
      MvPolynomial.aeval (fun _ => Polynomial.X)
    have h1 : ψ.comp φ = AlgHom.id Ω _ := by
      apply Polynomial.algHom_ext
      simp [φ, ψ]
    have h2 : φ.comp ψ = AlgHom.id Ω _ := by
      apply MvPolynomial.algHom_ext
      intro i
      rw [Fin.fin_one_eq_zero i]
      simp [φ, ψ]
    have hφinj : Function.Injective φ := by
      intro a b hab
      have ha := AlgHom.congr_fun h1 a
      have hb := AlgHom.congr_fun h1 b
      simp only [AlgHom.comp_apply, AlgHom.id_apply] at ha hb
      rw [← ha, ← hb, hab]
    have hφsurj : Function.Surjective φ := by
      intro p
      refine ⟨ψ p, ?_⟩
      have := AlgHom.congr_fun h2 p
      simpa only [AlgHom.comp_apply, AlgHom.id_apply] using this
    have hφfin : φ.Finite := AlgHom.Finite.of_surjective φ hφsurj
    have hc : Polynomial.aeval (R := Ω) (g (MvPolynomial.X 0)) = g.comp φ := by
      apply Polynomial.algHom_ext
      simp [φ]
    refine ⟨g (MvPolynomial.X 0), ?_, ?_⟩
    · rw [hc]
      exact hg.comp hφinj
    · rw [hc]
      exact AlgHom.Finite.comp hgfin hφfin

theorem wcpa_dj_lr1k_nsr_gub_itmp_si_den_point_case : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W), ϖ ≠ 0 → (∀ c : ↥W, c ≠ 0 → ∃ n : ℕ, c ∣ ϖ ^ n) → ∀ (C : Type u) [CommRing C] [Algebra ↥W C] (D : Type u) [CommRing D] [Algebra C D] [Algebra Ω D], Function.Injective (algebraMap C D) → (∀ w : ↥W, algebraMap Ω D (w : Ω) = algebraMap C D (algebraMap (↥W) C w)) → Function.Bijective (algebraMap Ω D) → ∀ χ₁ : C →+* AdicCompletion (Ideal.span {ϖ}) ↥W, (∀ w : ↥W, χ₁ (algebraMap (↥W) C w) = algebraMap (↥W) (AdicCompletion (Ideal.span {ϖ}) ↥W) w) → ∃ θ : C →+* ↥W, (∀ w : ↥W, θ (algebraMap (↥W) C w) = w) ∧ ∀ r : C, algebraMap (↥W) (AdicCompletion (Ideal.span {ϖ}) ↥W) (θ r) = χ₁ r :=
by
  intro Ω _ W ϖ hϖ0 hdiv C _ _ D _ _ _ hinj hcompat hbij χ₁ hχ₁
  classical
  have hW0 : ∀ z : ↥W, ϖ * z = 0 → z = 0 := fun z hz => (mul_eq_zero.mp hz).resolve_left hϖ0
  have hbasics : ∀ (C : Type u) [CommRing C] (p : C), (∀ x : C, p * x = 0 → x = 0) →
      (∀ y : AdicCompletion (Ideal.span {p}) C,
        algebraMap C (AdicCompletion (Ideal.span {p}) C) p * y = 0 → y = 0) ∧
      (∀ (n : ℕ) (c : C) (y : AdicCompletion (Ideal.span {p}) C),
        algebraMap C (AdicCompletion (Ideal.span {p}) C) c =
          algebraMap C (AdicCompletion (Ideal.span {p}) C) p ^ n * y → ∃ c' : C, c = p ^ n * c') := by
    intro C _ p hp
    have hev : ∀ (k : ℕ) (c : C), AdicCompletion.evalₐ (Ideal.span {p}) k
        (algebraMap C (AdicCompletion (Ideal.span {p}) C) c) =
        Ideal.Quotient.mk (Ideal.span {p} ^ k) c := by
      intro k c
      rw [AlgHom.commutes]
      rfl
    have hmem : ∀ (k : ℕ) (x : C), Ideal.Quotient.mk (Ideal.span {p} ^ k) x = 0 ↔ p ^ k ∣ x := by
      intro k x
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    have hD : ∀ (a : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C) (m k : ℕ), m ≤ k →
        p ^ m ∣ a k - a m := by
      intro a m k hmk
      rw [← hmem, map_sub, sub_eq_zero]
      exact AdicCompletion.Ideal.mk_eq_mk (Ideal.span {p}) hmk a
    have hN : ∀ (n : ℕ) (x : C), p ^ n * x = 0 → x = 0 := by
      intro n
      induction n with
      | zero => intro x h; simpa using h
      | succ n ih =>
        intro x h
        apply ih
        apply hp
        rw [← mul_assoc, ← pow_succ']
        exact h
    have hNc : ∀ (n : ℕ) (u v : C), p ^ n * u = p ^ n * v → u = v := by
      intro n u v h
      rw [← sub_eq_zero]
      apply hN n
      rw [mul_sub, h, sub_self]
    refine ⟨?_, ?_⟩
    · intro y hy
      obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
      apply AdicCompletion.ext_evalₐ
      intro k
      rw [map_zero, AdicCompletion.evalₐ_mk, hmem]
      have h1 := congrArg (AdicCompletion.evalₐ (Ideal.span {p}) (k + 1)) hy
      rw [map_mul, map_zero, hev, AdicCompletion.evalₐ_mk, ← map_mul, hmem] at h1
      obtain ⟨t, ht⟩ := h1
      have h2 : a (k + 1) = p ^ k * t := by
        apply hNc 1
        rw [pow_one, ht]
        ring
      obtain ⟨s, hs⟩ := hD a k (k + 1) (by omega)
      exact ⟨t - s, by linear_combination h2 - hs⟩
    · intro n c y h
      obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
      have h1 := congrArg (AdicCompletion.evalₐ (Ideal.span {p}) n) h
      rw [map_mul, map_pow, hev, hev, AdicCompletion.evalₐ_mk, ← map_pow, ← map_mul,
        ← sub_eq_zero, ← map_sub, hmem] at h1
      obtain ⟨t, ht⟩ := h1
      exact ⟨a n + t, by linear_combination ht⟩
  obtain ⟨hB1, hB2⟩ := hbasics (↥W) ϖ hW0
  have hcancel : ∀ (n : ℕ) (z : AdicCompletion (Ideal.span {ϖ}) ↥W),
      algebraMap (↥W) (AdicCompletion (Ideal.span {ϖ}) ↥W) ϖ ^ n * z = 0 → z = 0 := by
    intro n
    induction n with
    | zero => intro z hz; simpa using hz
    | succ n ih =>
      intro z hz
      apply hB1
      apply ih
      rw [← mul_assoc, ← pow_succ]
