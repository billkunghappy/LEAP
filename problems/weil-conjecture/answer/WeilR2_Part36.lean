    obtain ⟨y₀, i, hi, hyi⟩ := hmax.exists_inv ha𝔭
    refine ⟨algebraMap A ↥(wcLlsASmS W A K u β (β * t)) y₀, ?_⟩
    have h2 : algebraMap A ↥(wcLlsASmS W A K u β (β * t)) y₀ *
        algebraMap A ↥(wcLlsASmS W A K u β (β * t)) a +
        algebraMap A ↥(wcLlsASmS W A K u β (β * t)) i = 1 := by
      rw [← map_mul, ← map_add, hyi, map_one]
    have e : x * algebraMap A ↥(wcLlsASmS W A K u β (β * t)) y₀ - 1 =
        (x - algebraMap A ↥(wcLlsASmS W A K u β (β * t)) a) *
          algebraMap A ↥(wcLlsASmS W A K u β (β * t)) y₀ -
        algebraMap A ↥(wcLlsASmS W A K u β (β * t)) i := by
      linear_combination h2
    rw [e]
    exact Ideal.sub_mem _ (Ideal.mul_mem_right _ _ ha) (hover (Ideal.mem_map_of_mem _ hi))

  have hs₂ : algebraMap A K (algebraMap ↥W A (β * t)) / algebraMap A K u =
      algebraMap A₃ K (algebraMap ↥W A₃ t) / algebraMap A₃ K u₃ := by
    rw [hu₃, hBrW t, map_mul, map_mul, div_div_eq_mul_div, mul_comm (algebraMap A K _)]
  have hsub : ∀ z ∈ wcLlsASmS W A K u β (β * t), z ∈ wcLlsASbS W A₃ K u₃ t := by
    intro z hz
    induction hz using Algebra.adjoin_induction with
    | mem z hz =>
      rcases hz with rfl | hz
      · rw [← hu₃]
        exact Subalgebra.algebraMap_mem _ u₃
      · rw [Set.mem_singleton_iff] at hz
        rw [hz, hs₂]
        exact Algebra.subset_adjoin (Set.mem_singleton _)
    | algebraMap a =>
      obtain ⟨a₃, ha₃⟩ := hBrR (Subalgebra.algebraMap_mem
        (Algebra.adjoin A {algebraMap A K u / algebraMap A K (algebraMap ↥W A β)}) a)
      rw [← ha₃]
      exact Subalgebra.algebraMap_mem _ a₃
    | add x y _ _ hx hy => exact add_mem hx hy
    | mul x y _ _ hx hy => exact mul_mem hx hy
  let ι : ↥(wcLlsASmS W A K u β (β * t)) →+* ↥(wcLlsASbS W A₃ K u₃ t) :=
    { toFun := fun x => ⟨x.1, hsub x.1 x.2⟩
      map_one' := Subtype.ext rfl
      map_mul' := fun _ _ => Subtype.ext rfl
      map_zero' := Subtype.ext rfl
      map_add' := fun _ _ => Subtype.ext rfl }
  have hιN : wcLlsASmN W A K u β (β * t) ≤ (wcLlsASbN W A₃ K u₃ t).comap ι := by
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      intro x hx
      rw [SetLike.mem_coe, Ideal.mem_comap]
      rcases hx with rfl | hx
      · have e : ι ⟨algebraMap A K u / algebraMap A K (algebraMap ↥W A β),
            Algebra.subset_adjoin (Set.mem_insert _ _)⟩ =
            algebraMap A₃ ↥(wcLlsASbS W A₃ K u₃ t) u₃ := Subtype.ext hu₃.symm
        rw [e]
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
      · rw [Set.mem_singleton_iff] at hx
        rw [hx]
        have e : ι ⟨algebraMap A K (algebraMap ↥W A (β * t)) / algebraMap A K u,
            Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ =
            ⟨algebraMap A₃ K (algebraMap ↥W A₃ t) / algebraMap A₃ K u₃,
              Algebra.subset_adjoin (Set.mem_singleton _)⟩ := Subtype.ext hs₂
        rw [e]
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap, RingHom.comp_apply]
      have e : ι (algebraMap A ↥(wcLlsASmS W A K u β (β * t)) (algebraMap ↥W A w)) =
          algebraMap A₃ ↥(wcLlsASbS W A₃ K u₃ t) (algebraMap ↥W A₃ w) :=
        Subtype.ext (hBrW w).symm
      rw [e]
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem
        ((algebraMap A₃ ↥(wcLlsASbS W A₃ K u₃ t)).comp (algebraMap ↥W A₃)) hw)

  obtain ⟨y, hy⟩ := hres d hd
  have hιd : ι d ∉ wcLlsASbN W A₃ K u₃ t := by
    intro hιd
    apply hN
    rw [Ideal.eq_top_iff_one]
    have h1 : ι (d * y - 1) ∈ wcLlsASbN W A₃ K u₃ t := hιN hy
    rw [map_sub, map_mul, map_one] at h1
    have h2 := Ideal.mul_mem_right (ι y) _ hιd
    have h3 := Ideal.sub_mem _ h2 h1
    rwa [sub_sub_cancel] at h3

  exact wcLlsASb_integral_node Ω W hW hWt ℓ hℓ A₃ K L 𝔭₃ u₃ v₃ (t * r) t hPD₃ htm ht0 htq hK
    hfin α f₀ h hα1 hf₀ ⟨ι d, ι e, hιd, hde⟩

theorem wcLlsASm_insep_node : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g β b : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    β ∣ b → ¬ b ∣ β → b ∣ g → ((ℓ : ℕ) : K) = 0 → Module.finrank K L = ℓ →
    ∀ (α : L) (f₀ h : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α →
    ∀ (c γ : ↥W) (m : ℤ) (d e : ↥(wcLlsASmS W A K u β b)),
      c ≠ 0 → γ ≠ 0 → ¬ (ℓ : ℤ) ∣ m → d ∉ wcLlsASmN W A K u β b →
      e ∈ wcLlsASmN W A K u β b →
      (0 < m → γ * b ^ m.toNat ∣ c ^ ℓ) → (m < 0 → γ ∣ c ^ ℓ * β ^ (-m).toNat) →
      (d : K) * (algebraMap A K (algebraMap ↥W A c) ^ ℓ * (f₀ - (h ^ ℓ - h))) =
        algebraMap A K (algebraMap ↥W A γ) * algebraMap A K u ^ m * ((d : K) + (e : K)) →
      wcLlsAnnMidSep W A K L u β b :=
by
  intro Ω _ _ W hW hWt ℓ hℓ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g β b hPD hβm hβ0 hbm hb0
    hβb hbβ hbg hK hfin α f₀ h hα1 hf₀ c γ m d e hc hγ hm hd he hp hn heq
  obtain ⟨_, hNZ, _, _, _, _, hg0, huv, _, _⟩ := id hPD

  have hWK : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
    intro x hx h0
    have h1 : algebraMap ↥W A x = 0 :=
      (IsFractionRing.injective A K) (h0.trans (map_zero _).symm)
    rw [Algebra.algebraMap_eq_smul_one] at h1
    rcases smul_eq_zero.mp h1 with h2 | h2
    · exact hx h2
    · exact one_ne_zero h2

  have hroot : ∀ δ : ↥W, δ ≠ 0 → ∃ c' : ↥W, c' ≠ 0 ∧ c' ^ ℓ = δ := by
    intro δ hδ
    obtain ⟨x, hx⟩ := IsAlgClosed.exists_pow_nat_eq ((δ : ↥W) : Ω) hℓ.pos
    have hδΩ : ((δ : ↥W) : Ω) ≠ 0 := fun h0 => hδ (Subtype.ext h0)
    have hx0 : x ≠ 0 := by
      rintro rfl
      apply hδΩ
      rw [← hx, zero_pow hℓ.ne_zero]
