        ((IsLocalization.Away.invSelf p : Localization.Away p) ^ n)
      · calc L ((IsLocalization.Away.invSelf p : Localization.Away p) ^ n) * lam p ^ n
            = L ((IsLocalization.Away.invSelf p : Localization.Away p) ^ n *
                algebraMap T (Localization.Away p) p ^ n) := by
              rw [map_mul, map_pow L (algebraMap T (Localization.Away p) p), hLeq]
          _ = 1 := by
              rw [← mul_pow, mul_comm, IsLocalization.Away.mul_invSelf, one_pow, map_one]
      · rw [mul_comm, hc]
        exact hρ

  have s2 : ∀ (T T' F Ch : Type u) [CommRing T] [CommRing T'] [CommRing F] [IsDomain F] [CommRing Ch]
