    rw [Ideal.mem_map_C_iff]
    intro k
    by_cases hk : k ≤ F.natDegree
    swap
    · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (not_le.mp hk)]
      exact 𝔮.zero_mem
    apply hpts F.coeff F.natDegree _ k hk
    apply hιinj
    rw [map_zero, map_sum]
