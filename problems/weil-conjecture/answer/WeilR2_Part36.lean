  obtain ⟨p', rfl⟩ := hpre p hpV
  have hp' : p' ∈ ⨆ l, U' l := by rw [H1]; trivial
  obtain ⟨l, hl⟩ := TopologicalSpace.Opens.mem_iSup.mp hp'

  obtain ⟨c1, c2, c3⟩ := alg (f₁.appIso (U' l)).hom.hom (f₁.appIso (U' l)).inv.hom
    (fun c => by simp) (fun b => by simp) (r₁.appLE V (f₁ ''ᵁ U' l) (eU l)).hom
    (V.ι.appLE V ⊤ hle).hom (r.appLE ⊤ (U' l) (by simp)).hom hρbij.2
    (transport (U' l) (eU l)) g₀ l (t l) (H3 l) (H5 l)
