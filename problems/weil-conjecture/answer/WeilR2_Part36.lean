  ∀ (Y : Scheme.{u}) (uY : Y ⟶ Spec (.of ↥W)) (ιY : wcProjK Ω 1 ⟶ Y)
    [QuasiCompact (γ ≫ ιY)] [QuasiSeparated (γ ≫ ιY)], wcpaDjLkModel W uY ιY →
