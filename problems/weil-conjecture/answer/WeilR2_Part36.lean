        rw [RingHom.mem_ker, map_sub, map_mul, hθφ, hθφ, hc, sub_self]
      have h2 : ((uX.appLE ⊤ V hle).hom.comp (Scheme.ΓSpecIso (.of ↥W)).inv.hom) c *
