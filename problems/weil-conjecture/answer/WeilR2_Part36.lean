      have hspecsurj : ∀ (x y : N) (h : x ⤳ y), x = y →
          Function.Surjective (N.presheaf.stalkSpecializes h).hom := by
        rintro x y h rfl
        rw [TopCat.Presheaf.stalkSpecializes_refl]
        intro z; exact ⟨z, rfl⟩
      have star : ∀ (s : Spec (N.presheaf.stalk n)) (hs : N.fromSpecStalk n s ⤳ n)
