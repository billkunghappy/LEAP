    exact lt_irrefl _ hpos_as
  have hva'lt : A.valuation (wcNlbConst W (γ ≫ ι) uX a') <
      A.valuation (wcNlbConst W (γ ≫ ι) uX a) := by
    rw [hz, cmul, Valuation.map_mul]
    exact mul_lt_of_lt_one_right (zero_lt_iff.mpr hva0) hvz
  have hvas_le : A.valuation (wcNlbConst W (γ ≫ ι) uX as) ≤
