  have hfu : IsUnit (f r0) :=
    isUnit_of_dvd_unit (Multiset.dvd_prod (Multiset.mem_map_of_mem f hr0)) hFu
  apply hcon r0
  · rw [hRe r0]
    exact Multiset.prod_eq_zero (Multiset.mem_map.mpr ⟨r0, hr0, sub_self r0⟩)
  · rw [← hfu.dvd_mul_right, ← hf r0 hr0]

