  obtain ⟨⟨a, m⟩, hm⟩ :=
    IsLocalization.mk'_surjective (S := F.presheaf.stalk ζ) (hU.primeIdealOf x).asIdeal.primeCompl t
  have hspec := IsLocalization.mk'_spec (F.presheaf.stalk (x : F)) a m
  have hunit := IsLocalization.map_units (F.presheaf.stalk (x : F)) m
  have hm' : IsLocalization.mk' (F.presheaf.stalk ζ) a m = t := hm
  rw [hm'] at hspec
  rw [TopCat.Presheaf.stalk_open_algebraMap] at hspec hunit
  have key : ∀ c : Γ(F, U), wcNsrEbRho F h ((F.presheaf.germ U w hwU).hom c)
      = (F.residue ζ).hom ((F.presheaf.germ U ζ hζ).hom c) := by
    intro c
    unfold wcNsrEbRho
    rw [← TopCat.Presheaf.germ_stalkSpecializes F.presheaf hwU h]
    rfl
  refine ⟨(F.presheaf.germ U w hwU).hom a, (F.presheaf.germ U w hwU).hom m, ?_, ?_⟩
  · rw [key]
    exact (hunit.map (F.residue ζ).hom).ne_zero
  · have hs : (F.residue ζ).hom ((F.presheaf.germ U ζ hζ).hom m) ≠ 0 :=
      (hunit.map (F.residue ζ).hom).ne_zero
    rw [key, key, eq_div_iff hs, ← ht, ← map_mul]
    exact congrArg (F.residue ζ).hom hspec

theorem wcpa_dj_lr1k_nsr_esp_fibre_residue : ∀ (C N F : Scheme.{u}) [AlgebraicGeometry.IsIntegral C]
    (t : C ⟶ N) (j : F ⟶ N) [IsClosedImmersion j] {ζ w : F} (h : ζ ⤳ w)
    (A ν : ValuationSubring C.functionField), A ≤ ν → wcNsrCentred t (j w) A →
    ∀ (hζ : t (genericPoint ↥C) ⤳ j ζ),
      wcLr1uDom (wcLr1uGerm t (j ζ) hζ).hom (ν : Set C.functionField) →
      ∃ V : ValuationSubring (F.residueField ζ), wcNsrEbDom F h V ∧
        ∀ g : F.residueField ζ, g ∈ V ↔ ∃ s : N.presheaf.stalk (j ζ),
          (wcLr1uGerm t (j ζ) hζ).hom s ∈ A ∧ (N.residue (j ζ) ≫ j.residueFieldMap ζ).hom s = g :=
by
  intro C N F _ t j _ ζ w h A ν hAν hcent hζ hdom
  classical
  haveI : SurjectiveOnStalks j := IsClosedImmersion.toSurjectiveOnStalks
  obtain ⟨hw, hAw⟩ := hcent
  obtain ⟨hAw1, hAw2⟩ := hAw
  obtain ⟨hd1, hd2⟩ := hdom

  set φ : N.presheaf.stalk (j ζ) →+* C.functionField := (wcLr1uGerm t (j ζ) hζ).hom with hφ
  set ψ : N.presheaf.stalk (j ζ) →+* F.residueField ζ :=
    (N.residue (j ζ) ≫ j.residueFieldMap ζ).hom with hψ

  have hsurj : Function.Surjective ψ := by
    intro g
    obtain ⟨r, hr⟩ := F.residue_surjective ζ g
    obtain ⟨s, hs⟩ := SurjectiveOnStalks.stalkMap_surjective j ζ r
    refine ⟨s, ?_⟩
    rw [hψ, Scheme.residue_residueFieldMap, CommRingCat.hom_comp, RingHom.comp_apply, hs, hr]

  have hker : ∀ s, ψ s = 0 ↔ s ∈ IsLocalRing.maximalIdeal (N.presheaf.stalk (j ζ)) := by
    intro s
    rw [hψ, CommRingCat.hom_comp, RingHom.comp_apply]
    constructor
    · intro h0
      have h1 : (N.residue (j ζ)).hom s = 0 :=
        (RingHom.injective (j.residueFieldMap ζ).hom) (h0.trans (map_zero _).symm)
      exact (IsLocalRing.residue_eq_zero_iff _).mp h1
    · intro hm
      have h1 : (N.residue (j ζ)).hom s = 0 := (IsLocalRing.residue_eq_zero_iff _).mpr hm
      rw [h1, map_zero]

  have hK2 : ∀ s, s ∈ IsLocalRing.maximalIdeal (N.presheaf.stalk (j ζ)) →
      A.valuation (φ s) < 1 := by
    intro s hs
    have hnu : φ s ∈ ν.nonunits := by
      rw [ValuationSubring.mem_nonunits_iff]
      refine lt_of_le_of_ne ((ν.valuation_le_one_iff _).mpr (hd1 s)) ?_
      intro h1
      have h0 : φ s ≠ 0 := by
        intro h0
        rw [h0, map_zero] at h1
        exact zero_ne_one h1
      have hinv : (φ s)⁻¹ ∈ ν := by
        rw [← ν.valuation_le_one_iff, map_inv₀, h1, inv_one]
      exact (IsLocalRing.mem_maximalIdeal s).mp hs (hd2 s _ hinv (mul_inv_cancel₀ h0))
    exact (A.mem_nonunits_iff).mp ((ValuationSubring.nonunits_le_nonunits.mpr hAν) hnu)

  let V0 : Subring (F.residueField ζ) := Subring.map ψ (Subring.comap φ A.toSubring)
