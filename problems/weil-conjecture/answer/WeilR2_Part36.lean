  have G : ∀ (p : ↥X₁) (hp : (γ ≫ ι₁) (genericPoint ↥C) ⤳ p) (c : ↥W),
      (wcLr1uGerm (γ ≫ ι₁) p hp).hom
      ((X₁.presheaf.germ ⊤ p trivial).hom
        ((r₁ ≫ uX).appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom c))) =
