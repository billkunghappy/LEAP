      Spec.map (CommRingCat.ofHom ψ) ≫ T.isoSpec.inv = g' := by
    have e1 : CommRingCat.ofHom ψ ≫ val = ψ₀ := by
      ext y; rfl
    rw [← Category.assoc (Spec.map _), ← Spec.map_comp, e1]
    simp only [ψ₀, Scheme.Opens.toSpecΓ, Spec.map_comp, Category.assoc]
    rw [← Category.assoc (Spec.map (f ⁻¹ᵁ U).topIso.inv), ← Spec.map_comp, Iso.hom_inv_id,
      Spec.map_id, Category.id_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality,
      Category.assoc, Scheme.toSpecΓ_isoSpec_inv, Category.comp_id]
  rw [← Category.assoc, hA]
  simp only [Category.assoc]
  rw [reassoc_of% hB, hg's, ← Category.assoc, hk]

theorem wcpa_dj_lr1k_nsr_ubn_generic_invpull : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X), wcpaDjLkModel W uX ι → ∀ (σ : Spec (.of ↥W) ⟶ X) (c : ↥W), c ≠ 0 → ∀ (T : Scheme.{u}) (h₀ : T ⟶ wcProjK Ω 1), wcCsdInvPull (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX c) (h₀ ≫ ι) :=
by
  intro Ω _ W X uX ι hM σ c hc T h₀
  unfold wcCsdInvPull wcNcPrincipal
  intro t

  obtain ⟨U₀, hU₀, hxU, -⟩ :=
    exists_isAffineOpen_mem_and_subset (x := (h₀ ≫ ι) t) (U := ⊤) trivial
  have ht : t ∈ (h₀ ≫ ι) ⁻¹ᵁ U₀ := hxU
  obtain ⟨V₀, hV₀, htV, hVsub⟩ := exists_isAffineOpen_mem_and_subset ht
  have hVU : V₀ ≤ (h₀ ≫ ι) ⁻¹ᵁ U₀ := hVsub

  set i : Opposite.op (⊤ : X.Opens) ⟶ Opposite.op U₀ := (homOfLE (le_top : U₀ ≤ ⊤)).op with hi
  set g : Γ(X, ⊤) := uX.appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom c) with hg
  set a : Γ(X, U₀) := (X.presheaf.map i).hom g with ha_def
  have ha : a ∈ (σ.ker ⊔ Scheme.IdealSheafData.ofIdealTop (Ideal.span {g})).ideal ⟨U₀, hU₀⟩ := by
    rw [Scheme.IdealSheafData.ideal_sup]
    apply Ideal.mem_sup_right
    rw [Scheme.IdealSheafData.ofIdealTop_ideal]
    exact Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self g)

  set φ : CommRingCat.of ↥W ⟶ CommRingCat.of Ω := CommRingCat.ofHom (algebraMap ↥W Ω) with hφ
  set k : T ⟶ Spec (.of Ω) := h₀ ≫ wcProjKStr Ω 1 with hk
  have hEq : (h₀ ≫ ι) ≫ uX = k ≫ Spec.map φ := by
    rw [Category.assoc, hM.2.2.w, ← Category.assoc]
  have hmor : ∀ (m₁ m₂ : T ⟶ Spec (.of ↥W)), m₁ = m₂ → ∀ (e₁ : V₀ ≤ m₁ ⁻¹ᵁ ⊤)
      (e₂ : V₀ ≤ m₂ ⁻¹ᵁ ⊤), m₁.appLE ⊤ V₀ e₁ = m₂.appLE ⊤ V₀ e₂ := by
    rintro _ _ rfl _ _; rfl
  have e1 : V₀ ≤ (h₀ ≫ ι) ⁻¹ᵁ ⊤ := fun _ _ => trivial
  have e2 : V₀ ≤ ((h₀ ≫ ι) ≫ uX) ⁻¹ᵁ ⊤ := fun _ _ => trivial
  have e3 : V₀ ≤ (k ≫ Spec.map φ) ⁻¹ᵁ ⊤ := fun _ _ => trivial
  have hcomp : (Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫ X.presheaf.map i ≫
      (h₀ ≫ ι).appLE U₀ V₀ hVU =
      φ ≫ (Scheme.ΓSpecIso (.of Ω)).inv ≫ k.appLE ((Spec.map φ) ⁻¹ᵁ ⊤) V₀ e3 := by
    rw [Scheme.Hom.map_appLE]
    have s1 : uX.appTop ≫ (h₀ ≫ ι).appLE ⊤ V₀ e1 = ((h₀ ≫ ι) ≫ uX).appLE ⊤ V₀ e2 := by
      rw [Scheme.Hom.comp_appLE]; rfl
    have s2 := Scheme.Hom.comp_appLE k (Spec.map φ) ⊤ V₀ e3
    have s3 := Scheme.ΓSpecIso_inv_naturality φ
    rw [s1, hmor _ _ hEq e2 e3, s2]
    exact ((reassoc_of% s3) (Scheme.Hom.appLE k (Spec.map φ ⁻¹ᵁ ⊤) V₀ e3)).symm
  have hunit : IsUnit ((Scheme.Hom.appLE (h₀ ≫ ι) U₀ V₀ hVU).hom a) := by
    have h1 : (Scheme.Hom.appLE (h₀ ≫ ι) U₀ V₀ hVU).hom a =
        ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫ X.presheaf.map i ≫
          (h₀ ≫ ι).appLE U₀ V₀ hVU).hom c := rfl
    rw [h1, hcomp]
    have hc' : (algebraMap ↥W Ω c) ≠ 0 := by
      intro h0
      apply hc
      exact Subtype.ext h0
    exact (hc'.isUnit).map ((Scheme.ΓSpecIso (.of Ω)).inv ≫ k.appLE ((Spec.map φ) ⁻¹ᵁ ⊤) V₀ e3).hom
  refine ⟨⟨U₀, hU₀⟩, ⟨V₀, hV₀⟩, hVU, a, htV, ha, hunit.mem_nonZeroDivisors, ?_⟩
  rw [Ideal.span_singleton_eq_top.mpr hunit]
  exact Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ ha) hunit

