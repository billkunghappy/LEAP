      sh * algebraMap A _ (e * S) * algebraMap A _ (algebraMap ↥W A w) *
        algebraMap A _ (algebraMap ↥W A (yW i)) +
      (1 - algebraMap A _ (algebraMap ↥W A κ) * sh) * algebraMap A _ (xA i) :=
    ⟨_, fun _ => rfl⟩
  have hH0 : H 0 ∉ wcLlsASbN W A K Z b := by
    rw [hH 0, hy0, hx0, map_zero, map_zero, mul_zero, zero_add]
    intro hmem
    rcases hNAp.mem_or_mem hmem with h1 | h1
    · apply hNA
      rw [Ideal.eq_top_iff_one]
      have e1 : (1 : ↥(wcLlsASbS W A K Z b)) =
          (1 - algebraMap A _ (algebraMap ↥W A κ) * sh) +
            algebraMap A _ (algebraMap ↥W A κ) * sh := by ring
      rw [e1]
      exact add_mem h1 (Ideal.mul_mem_left _ _ hshN)
    · apply hSn
      rw [← hcontrA]; exact h1
  have hHi : ∀ i, 1 ≤ i → i ≤ ℓ → H i ∈ wcLlsASbN W A K Z b := by
    intro i hi1 hiℓ
    rw [hH i]
    refine add_mem (Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _
      (Ideal.mul_mem_right _ _ hshN))) ?_
    by_cases hiℓ' : i = ℓ
    · rw [hiℓ', hxℓ, map_zero, mul_zero]; exact Ideal.zero_mem _
    · rw [hxm i hiℓ' (by omega), map_mul]
      exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _
        (hWmA _ (Ideal.pow_mem_of_mem _ hb₃ i (by omega))))
  have hHsum : ∑ i ∈ Finset.range (ℓ + 1), φ (H i) * σ ^ (ℓ - i) = 0 := by
    have e1 : ∑ i ∈ Finset.range (ℓ + 1), φ (H i) * σ ^ (ℓ - i) =
        (algebraMap A M (algebraMap ↥W A b) / algebraMap A M Z) *
          (algebraMap A M e * algebraMap A M S * algebraMap A M (algebraMap ↥W A w)) * Y +
        (1 - algebraMap A M (algebraMap ↥W A κ) *
          (algebraMap A M (algebraMap ↥W A b) / algebraMap A M Z)) * X := by
      rw [hY, hX, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hH i]
      simp only [map_add, map_mul, map_sub, map_one, hφA, hφs]
      ring
    rw [e1, div_eq_mul_inv]
    linear_combination (algebraMap A M Z)⁻¹ * hKEY - X * hZinv
  obtain ⟨g, hg1, hg2, hg3⟩ := s3 _ φ _ ℓ H σ hH0 hHi hHsum
  refine ⟨g, hg1, hg2, ?_⟩
  rw [← hσ, ← hφ]
  exact hg3

theorem wcpa_dj_llsm_smni_local_integrality : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    (𝔭 : Ideal A) (t : A) (h : A) (𝔮 : Ideal B) (t' : B),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    ∀ c b c₃ b₃ : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W →
      b ≠ 0 → c₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ≠ 0 →
      wcLlsASbN W A K (t - algebraMap ↥W A c) b ≠ ⊤ →
      wcLlsASbN W B M (t' - algebraMap ↥W B c₃) b₃ ≠ ⊤ →
      (∃ g : Polynomial ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b),
        g.leadingCoeff ∉ wcLlsASbN W A K (t - algebraMap ↥W A c) b ∧
        (∀ j < g.natDegree, g.coeff j ∈ wcLlsASbN W A K (t - algebraMap ↥W A c) b) ∧
        Polynomial.eval₂ ((algebraMap K M).comp
            (algebraMap ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b) K))
          (algebraMap B M (algebraMap ↥W B b₃) / algebraMap B M (t' - algebraMap ↥W B c₃)) g = 0) →
      ∀ x q : ↥(wcLlsASbS W B M (t' - algebraMap ↥W B c₃) b₃),
        q ∉ wcLlsASbN W B M (t' - algebraMap ↥W B c₃) b₃ →
        ∃ g : Polynomial ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b),
          g.leadingCoeff ∉ wcLlsASbN W A K (t - algebraMap ↥W A c) b ∧
          Polynomial.eval₂ ((algebraMap K M).comp
              (algebraMap ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b) K))
            (algebraMap ↥(wcLlsASbS W B M (t' - algebraMap ↥W B c₃) b₃) M x /
              algebraMap ↥(wcLlsASbS W B M (t' - algebraMap ↥W B c₃) b₃) M q) g = 0 :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M _ _ _ _ _ _ B _ _ _ _ _ _ _ _
    𝔭 t h 𝔮 t' hPD hSmc c b c₃ b₃ hc hb hb0 hc₃ hb₃ hb₃0 hNA hNB hEis x q hq
  classical

  have clearDen : ∀ (R : Type u) [CommRing R] (L : Type u) [Field L] [Algebra R L] (N : Ideal R)
      [N.IsPrime] (O : Type u) [CommRing O] [Algebra R O] [IsLocalization.AtPrime O N]
      [Algebra O L] [IsScalarTower R O L] (y : L), IsIntegral O y →
      ∃ g : Polynomial R, g.leadingCoeff ∉ N ∧ Polynomial.aeval y g = 0 := by
    intro R _ L _ _ N hN O _ _ _ _ _ y hy
    obtain ⟨⟨m, hm⟩, p, hpm, hp⟩ :=
      IsIntegral.exists_multiple_integral_of_isLocalization N.primeCompl y hy
    have hmy : ((⟨m, hm⟩ : N.primeCompl) • y) = algebraMap R L m * y := by
      rw [Submonoid.smul_def, Algebra.smul_def]
    rw [hmy] at hp
    have hmN : m ∉ N := hm
    have hmd : m ^ p.natDegree ∉ N := fun h => hmN (hN.mem_of_pow_mem _ h)
    let g : Polynomial R := ∑ i ∈ Finset.range (p.natDegree + 1),
      Polynomial.C (p.coeff i * m ^ i) * Polynomial.X ^ i
    have hgc : ∀ n, g.coeff n =
        if n ∈ Finset.range (p.natDegree + 1) then p.coeff n * m ^ n else 0 := by
      intro n
      simp only [g, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul_X_pow]
      exact Finset.sum_ite_eq _ _ _
    have hgd : g.coeff p.natDegree = m ^ p.natDegree := by
      rw [hgc, if_pos (Finset.mem_range.mpr (Nat.lt_succ_self _)), hpm.coeff_natDegree, one_mul]
    have hdeg : g.natDegree = p.natDegree := by
      apply Polynomial.natDegree_eq_of_le_of_coeff_ne_zero
      · rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
        intro n hn
        rw [hgc, if_neg]
        rw [Finset.mem_range]
        exact fun h => absurd hn (not_lt.mpr (Nat.lt_succ_iff.mp h))
      · rw [hgd]; intro h0; exact hmd (h0 ▸ N.zero_mem)
    refine ⟨g, ?_, ?_⟩
    · rw [Polynomial.leadingCoeff, hdeg, hgd]; exact hmd
    · rw [Polynomial.aeval_eq_sum_range' (n := p.natDegree + 1)
        (by rw [hdeg]; exact Nat.lt_succ_self _)]
      rw [Polynomial.eval₂_eq_sum_range] at hp
      rw [← hp]
      apply Finset.sum_congr rfl
      intro i hi
      rw [hgc, if_pos hi, Algebra.smul_def, map_mul, map_pow]
      ring

  have crux : ∀ (L : Type u) [Field L] (R : Type u) [CommRing R] [Algebra R L] (N : Ideal R)
      [N.IsPrime] (O : Type u) [CommRing O] [Algebra R O] [IsLocalization.AtPrime O N]
      [Algebra O L] [IsScalarTower R O L] (B : Type u) [CommRing B] [Algebra B L] (𝔮 : Ideal B)
      (s : L) (N' : Ideal ↥(Algebra.adjoin B {s})),
      (∀ β : B, ∃ u : R, u ∉ N ∧ IsIntegral R (algebraMap R L u * algebraMap B L β)) →
      (∃ g : Polynomial R, g.leadingCoeff ∉ N ∧ (∀ j < g.natDegree, g.coeff j ∈ N) ∧
        Polynomial.aeval s g = 0) →
      (∀ J : Ideal B, J.IsPrime →
        (∀ (β : B) (r : R), algebraMap B L β = algebraMap R L r → (β ∈ J ↔ r ∈ N)) → J ≤ 𝔮) →
      (∀ β ∈ 𝔮, algebraMap B ↥(Algebra.adjoin B {s}) β ∈ N') →
      (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin B {s})) ∈ N' →
      ∀ x q : ↥(Algebra.adjoin B {s}), q ∉ N' → IsIntegral O ((x : L) / (q : L)) := by
    intro L _ R _ _ N hN O _ _ _ _ _ B _ _ 𝔮 s N' h1 h2 h3 h4 h5 x q hq
    haveI : IsLocalRing O := IsLocalization.AtPrime.isLocalRing O N
    have hunit : ∀ u : R, u ∉ N → ∃ v : O, algebraMap O L v * algebraMap R L u = 1 := by
      intro u hu
      have hU : IsUnit (algebraMap R O u) :=
        (IsLocalization.AtPrime.isUnit_to_map_iff O N u).mpr hu
      obtain ⟨w, hw⟩ := hU.exists_left_inv
      refine ⟨w, ?_⟩
      rw [IsScalarTower.algebraMap_apply R O L, ← map_mul, hw, map_one]
    have intO : ∀ (u : R) (y : L), u ∉ N → IsIntegral R (algebraMap R L u * y) →
        IsIntegral O y := by
      intro u y hu hy
      obtain ⟨v, hv⟩ := hunit u hu
      have hy' : IsIntegral O (y * algebraMap R L u) := by
        rw [mul_comm]; exact hy.tower_top
      exact IsIntegral.of_mul_unit hv hy'
    obtain ⟨g, hglc, hgco, hgs⟩ := h2
    have hsO : IsIntegral O s := by
      apply intO g.leadingCoeff s hglc
      have := isIntegral_leadingCoeff_smul g s hgs
      rwa [Algebra.smul_def] at this
    have hBO : ∀ β : B, IsIntegral O (algebraMap B L β) := fun β => by
      obtain ⟨u, hu, hi⟩ := h1 β
      exact intO u _ hu hi
    have hadj : ∀ y ∈ Algebra.adjoin B {s}, IsIntegral O y := by
      intro y hy
      induction hy using Algebra.adjoin_induction with
      | mem x hx => rw [Set.mem_singleton_iff.mp hx]; exact hsO
      | algebraMap β => exact hBO β
      | add x y _ _ hx hy => exact hx.add hy
      | mul x y _ _ hx hy => exact hx.mul hy
    have hs : s ∈ Algebra.adjoin B {s} := Algebra.subset_adjoin (Set.mem_singleton s)
    have hdec : ∀ y ∈ Algebra.adjoin B {s}, ∃ (β : B) (r : L), r ∈ Algebra.adjoin B {s} ∧
        y = algebraMap B L β + s * r := by
      intro y hy
      induction hy using Algebra.adjoin_induction with
      | mem x hx =>
        exact ⟨0, 1, Subalgebra.one_mem _,
          by rw [Set.mem_singleton_iff.mp hx, map_zero, zero_add, mul_one]⟩
      | algebraMap β => exact ⟨β, 0, Subalgebra.zero_mem _, by rw [mul_zero, add_zero]⟩
      | add x y _ _ hx hy =>
        obtain ⟨β₁, r₁, hr₁, e₁⟩ := hx
        obtain ⟨β₂, r₂, hr₂, e₂⟩ := hy
        exact ⟨β₁ + β₂, r₁ + r₂, add_mem hr₁ hr₂, by rw [e₁, e₂, map_add]; ring⟩
      | mul x y _ _ hx hy =>
        obtain ⟨β₁, r₁, hr₁, e₁⟩ := hx
        obtain ⟨β₂, r₂, hr₂, e₂⟩ := hy
        refine ⟨β₁ * β₂, algebraMap B L β₁ * r₂ + algebraMap B L β₂ * r₁ + s * r₁ * r₂, ?_,
          by rw [e₁, e₂, map_mul]; ring⟩
        exact add_mem (add_mem (mul_mem (Subalgebra.algebraMap_mem _ _) hr₂)
          (mul_mem (Subalgebra.algebraMap_mem _ _) hr₁)) (mul_mem (mul_mem hs hr₁) hr₂)
    let D := integralClosure O L
    let qD : D := ⟨q, (hadj q q.2 : _)⟩
    let sD : D := ⟨s, hsO⟩
    have hunitq : IsUnit qD := by
      by_contra hnu
      obtain ⟨P, hPmax, hqP⟩ := exists_max_ideal_of_mem_nonunits (mem_nonunits_iff.mpr hnu)
      haveI := hPmax
      have hPc : P.comap (algebraMap O D) = IsLocalRing.maximalIdeal O :=
        IsLocalRing.eq_maximalIdeal (Ideal.IsMaximal.under O P)
      have hρ : ∀ r : R, algebraMap O D (algebraMap R O r) ∈ P ↔ r ∈ N := by
        intro r
        rw [← Ideal.mem_comap, hPc]
        exact IsLocalization.AtPrime.to_map_mem_maximal_iff O N r
      have hcoe : ∀ r : R, ((algebraMap O D (algebraMap R O r) : D) : L) = algebraMap R L r := by
        intro r
        rw [IsScalarTower.algebraMap_apply R O L]
        rfl
      have hsD : (sD : L) = s := rfl
      have hE : ∑ i ∈ Finset.range (g.natDegree + 1),
          algebraMap O D (algebraMap R O (g.coeff i)) * sD ^ i = 0 := by
        apply Subtype.ext
        have := hgs
        rw [Polynomial.aeval_def, Polynomial.eval₂_eq_sum_range] at this
        simp only [AddSubmonoidClass.coe_finsetSum, Subalgebra.coe_mul, Subalgebra.coe_pow,
          ZeroMemClass.coe_zero, hcoe, hsD]
        exact this
      have hsP : sD ∈ P := by
        rw [Finset.sum_range_succ] at hE
        have hrest : ∑ i ∈ Finset.range g.natDegree,
            algebraMap O D (algebraMap R O (g.coeff i)) * sD ^ i ∈ P :=
          Ideal.sum_mem _ (fun i hi => Ideal.mul_mem_right _ _
            ((hρ _).mpr (hgco i (Finset.mem_range.mp hi))))
        have hlast : algebraMap O D (algebraMap R O (g.coeff g.natDegree)) * sD ^ g.natDegree
            ∈ P := by
          have e := eq_neg_of_add_eq_zero_right hE
          rw [e]; exact neg_mem hrest
        rcases hPmax.isPrime.mem_or_mem hlast with h | h
        · exact absurd ((hρ _).mp h) hglc
        · exact hPmax.isPrime.mem_of_pow_mem _ h
      let ιB : B →+* D := (algebraMap B L).codRestrict D (fun β => (hBO β : _))
      haveI : P.IsPrime := hPmax.isPrime
      have hJ := h3 (P.comap ιB) inferInstance (by
        intro β r hβr
        rw [Ideal.mem_comap, ← hρ r]
        have : ιB β = algebraMap O D (algebraMap R O r) := by
          apply Subtype.ext
          rw [hcoe]
          exact hβr
        rw [this])
      obtain ⟨β, r', hr', e⟩ := hdec q q.2
      have hqe : qD = ιB β + sD * ⟨r', (hadj r' hr' : _)⟩ := Subtype.ext e
      have hβP : ιB β ∈ P := by
        have : ιB β = qD - sD * ⟨r', (hadj r' hr' : _)⟩ := by
          rw [hqe]; ring
        rw [this]
        exact sub_mem hqP (Ideal.mul_mem_right _ _ hsP)
      have hβ𝔮 : β ∈ 𝔮 := hJ hβP
      apply hq
      have hq' : q = algebraMap B ↥(Algebra.adjoin B {s}) β +
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ * ⟨r', hr'⟩ := Subtype.ext e
      rw [hq']
      exact add_mem (h4 β hβ𝔮) (Ideal.mul_mem_right _ _ h5)
    obtain ⟨w, hw⟩ := hunitq.exists_right_inv
    have hw' : (q : L) * (w : L) = 1 := congrArg Subtype.val hw
    rw [div_eq_mul_inv, inv_eq_of_mul_eq_one_right hw']
    exact (hadj x x.2).mul w.2

  have nodeMax : ∀ (D : Type u) [CommRing D] (P : Ideal D), P.IsMaximal →
      ∀ (T : Type u) [CommRing T] [Algebra D T] (s : T) (N : Ideal ↥(Algebra.adjoin D {s})),
      (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin D {s})) ∈ N →
      P ≤ N.comap (algebraMap D ↥(Algebra.adjoin D {s})) → N ≠ ⊤ → N.IsMaximal := by
    intro D _ P hP T _ _ s N hsN hPN hNt
    have span : ∀ (x : T) (hx : x ∈ Algebra.adjoin D {s}), ∃ a : D,
        (⟨x, hx⟩ : ↥(Algebra.adjoin D {s})) - algebraMap D ↥(Algebra.adjoin D {s}) a ∈ N := by
      intro x hx
      induction hx using Algebra.adjoin_induction with
      | mem x hx =>
        refine ⟨0, ?_⟩
        rw [map_zero, sub_zero]
        have e : (⟨x, Algebra.subset_adjoin hx⟩ : ↥(Algebra.adjoin D {s})) =
            ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ := Subtype.ext hx
        rw [e]; exact hsN
      | algebraMap d =>
        refine ⟨d, ?_⟩
        convert N.zero_mem using 1
        exact sub_eq_zero.mpr (Subtype.ext rfl)
      | add x y hx hy ihx ihy =>
        obtain ⟨a, ha⟩ := ihx
        obtain ⟨a', ha'⟩ := ihy
        refine ⟨a + a', ?_⟩
        have e : (⟨x + y, add_mem hx hy⟩ : ↥(Algebra.adjoin D {s})) -
            algebraMap D ↥(Algebra.adjoin D {s}) (a + a') =
            ((⟨x, hx⟩ : ↥(Algebra.adjoin D {s})) - algebraMap D ↥(Algebra.adjoin D {s}) a) +
            ((⟨y, hy⟩ : ↥(Algebra.adjoin D {s})) - algebraMap D ↥(Algebra.adjoin D {s}) a') := by
          have e1 : (⟨x + y, add_mem hx hy⟩ : ↥(Algebra.adjoin D {s})) =
              (⟨x, hx⟩ : ↥(Algebra.adjoin D {s})) + ⟨y, hy⟩ := rfl
          rw [e1, map_add]; ring
        rw [e]; exact add_mem ha ha'
      | mul x y hx hy ihx ihy =>
        obtain ⟨a, ha⟩ := ihx
        obtain ⟨a', ha'⟩ := ihy
        refine ⟨a * a', ?_⟩
        have e : (⟨x * y, mul_mem hx hy⟩ : ↥(Algebra.adjoin D {s})) -
            algebraMap D ↥(Algebra.adjoin D {s}) (a * a') =
            ((⟨x, hx⟩ : ↥(Algebra.adjoin D {s})) - algebraMap D ↥(Algebra.adjoin D {s}) a) *
              ⟨y, hy⟩ + algebraMap D ↥(Algebra.adjoin D {s}) a *
            ((⟨y, hy⟩ : ↥(Algebra.adjoin D {s})) - algebraMap D ↥(Algebra.adjoin D {s}) a') := by
          have e1 : (⟨x * y, mul_mem hx hy⟩ : ↥(Algebra.adjoin D {s})) =
              (⟨x, hx⟩ : ↥(Algebra.adjoin D {s})) * ⟨y, hy⟩ := rfl
          rw [e1, map_mul]; ring
        rw [e]; exact add_mem (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_left _ _ ha')
    obtain ⟨J, hJ, hNJ⟩ := Ideal.exists_le_maximal N hNt
    have hJN : J ≤ N := by
      intro x hxJ
      obtain ⟨a, ha⟩ := span x.1 x.2
      have haJ : algebraMap D ↥(Algebra.adjoin D {s}) a ∈ J := by
        have e : algebraMap D ↥(Algebra.adjoin D {s}) a =
            x - (x - algebraMap D ↥(Algebra.adjoin D {s}) a) := by ring
        rw [e]; exact sub_mem hxJ (hNJ ha)
      by_cases hc0 : a ∈ P
      · have e : x = (x - algebraMap D ↥(Algebra.adjoin D {s}) a) +
            algebraMap D ↥(Algebra.adjoin D {s}) a := by ring
        rw [e]; exact add_mem ha (hPN hc0)
      · exfalso
        obtain ⟨β, i, hi, hβ⟩ := hP.exists_inv hc0
        apply hJ.ne_top
        rw [Ideal.eq_top_iff_one]
        have e1 : (1 : ↥(Algebra.adjoin D {s})) = algebraMap D _ β * algebraMap D _ a +
            algebraMap D _ i := by rw [← map_mul, ← map_add, hβ, map_one]
        rw [e1]
        exact add_mem (Ideal.mul_mem_left _ _ haJ) (hNJ (hPN hi))
    have hNJe : N = J := le_antisymm hNJ hJN
    rw [hNJe]; exact hJ
  have nodeFacts : ∀ (D : Type u) [CommRing D] [Algebra ↥W D] (T : Type u) [Field T]
      [Algebra D T] (P : Ideal D) (τ : D) (c' b' : ↥W), wcLlsPD W D P (.disc τ) →
      c' ∈ IsLocalRing.maximalIdeal ↥W → wcLlsASbN W D T (τ - algebraMap ↥W D c') b' ≠ ⊤ →
      (wcLlsASbN W D T (τ - algebraMap ↥W D c') b').IsMaximal ∧
      (wcLlsASbN W D T (τ - algebraMap ↥W D c') b').comap
        (algebraMap D ↥(wcLlsASbS W D T (τ - algebraMap ↥W D c') b')) = P := by
    intro D _ _ T _ _ P τ c' b' hP hc' hNt
    obtain ⟨-, -, -, hPmax, -, -, hPeq, -⟩ := hP
    have hsN : (⟨algebraMap D T (algebraMap ↥W D b') / algebraMap D T (τ - algebraMap ↥W D c'),
        Algebra.subset_adjoin (Set.mem_singleton _)⟩ :
          ↥(wcLlsASbS W D T (τ - algebraMap ↥W D c') b')) ∈
        wcLlsASbN W D T (τ - algebraMap ↥W D c') b' := by
      unfold wcLlsASbN
      exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    have hle : P ≤ (wcLlsASbN W D T (τ - algebraMap ↥W D c') b').comap
        (algebraMap D ↥(wcLlsASbS W D T (τ - algebraMap ↥W D c') b')) := by
      rw [hPeq]
      unfold wcLlsASbN
      apply sup_le
      · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
        have e1 : algebraMap D ↥(wcLlsASbS W D T (τ - algebraMap ↥W D c') b') τ =
            algebraMap D _ (τ - algebraMap ↥W D c') +
              ((algebraMap D ↥(wcLlsASbS W D T (τ - algebraMap ↥W D c') b')).comp
                (algebraMap ↥W D)) c' := by
          rw [RingHom.comp_apply, ← map_add, sub_add_cancel]
        rw [e1]
        exact add_mem (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
          (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc'))
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [Ideal.mem_comap, Ideal.mem_comap]
        exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)
    have hmax := nodeMax D P hPmax T _ _ hsN hle hNt
    refine ⟨hmax, ?_⟩
    have hne : (wcLlsASbN W D T (τ - algebraMap ↥W D c') b').comap
        (algebraMap D ↥(wcLlsASbS W D T (τ - algebraMap ↥W D c') b')) ≠ ⊤ := by
      intro hT
      apply hNt
      have h1 : (1 : D) ∈ (wcLlsASbN W D T (τ - algebraMap ↥W D c') b').comap
          (algebraMap D ↥(wcLlsASbS W D T (τ - algebraMap ↥W D c') b')) := by
        rw [hT]; trivial
      rw [Ideal.mem_comap, map_one] at h1
      exact (Ideal.eq_top_iff_one _).mpr h1
    exact (hPmax.eq_of_le hne hle).symm

  obtain ⟨hhP, hSmc2, hPDB, -, hS5⟩ := hSmc
  obtain ⟨hNAmax, hcA⟩ := nodeFacts A K 𝔭 t c b hPD hc hNA
  obtain ⟨-, hcB⟩ := nodeFacts B M 𝔮 t' c₃ b₃ hPDB hc₃ hNB
  haveI hNAp : (wcLlsASbN W A K (t - algebraMap ↥W A c) b).IsPrime := hNAmax.isPrime
  have hRAM : ∀ a : A, algebraMap ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b) M
      (algebraMap A ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b) a) = algebraMap A M a := by
    intro a
    show algebraMap K M (algebraMap A K a) = algebraMap A M a
    rw [← IsScalarTower.algebraMap_apply A K M]
  have hinj : Function.Injective
      (algebraMap ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b) M) := by
    show Function.Injective (fun x : ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b) =>
      algebraMap K M (x : K))
    exact (algebraMap K M).injective.comp Subtype.val_injective
  have hunits : ∀ y : (wcLlsASbN W A K (t - algebraMap ↥W A c) b).primeCompl,
      IsUnit (algebraMap ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b) M y) := by
    intro y
    apply isUnit_iff_ne_zero.mpr
    intro h0
    apply y.2
    have e : (y : ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b)) = 0 :=
      hinj (h0.trans (map_zero _).symm)
    rw [e]; exact Ideal.zero_mem _
  letI : Algebra (Localization.AtPrime (wcLlsASbN W A K (t - algebraMap ↥W A c) b)) M :=
    (IsLocalization.lift hunits).toAlgebra
  haveI : IsScalarTower ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b)
      (Localization.AtPrime (wcLlsASbN W A K (t - algebraMap ↥W A c) b)) M :=
    IsScalarTower.of_algebraMap_eq (fun r => (IsLocalization.lift_eq hunits r).symm)

  have hint := crux M ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b)
    (wcLlsASbN W A K (t - algebraMap ↥W A c) b)
    (Localization.AtPrime (wcLlsASbN W A K (t - algebraMap ↥W A c) b)) B 𝔮 _
    (wcLlsASbN W B M (t' - algebraMap ↥W B c₃) b₃)
    (by
      intro β
      obtain ⟨k, hk⟩ := (hSmc2 (algebraMap B M β)).mp ⟨β, rfl⟩
      refine ⟨(algebraMap A ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b) h) ^ k, ?_, ?_⟩
      · intro hmem
        apply hhP
        have hh := hNAp.mem_of_pow_mem _ hmem
        rw [← hcA]; exact hh
      · rw [map_pow, hRAM]
        obtain ⟨p, hpm, hp⟩ := hk
        refine ⟨p.map (algebraMap A ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b)),
          hpm.map _, ?_⟩
        rw [Polynomial.eval₂_map]
        have e : (algebraMap ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b) M).comp
            (algebraMap A ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b)) = algebraMap A M := by
          ext a; exact hRAM a
        rw [e]; exact hp)
    (by
      obtain ⟨g, hg1, hg2, hg3⟩ := hEis
      exact ⟨g, hg1, hg2, hg3⟩)
    (by
      intro J hJ hcomp
      have hJc : J.comap (algebraMap A B) = 𝔭 := by
        ext a
        rw [Ideal.mem_comap, ← hcA, Ideal.mem_comap]
        apply hcomp
        rw [← IsScalarTower.algebraMap_apply A B M, hRAM]
      exact le_of_eq (hS5 J hJ hJc))
    (by
      intro β hβ
      rw [← hcB] at hβ
      exact hβ)
    (by
      unfold wcLlsASbN
      exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)))
    x q hq

  obtain ⟨g, hg1, hg2⟩ := clearDen ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b) M
    (wcLlsASbN W A K (t - algebraMap ↥W A c) b)
    (Localization.AtPrime (wcLlsASbN W A K (t - algebraMap ↥W A c) b)) _ hint
  exact ⟨g, hg1, hg2⟩

theorem wcpa_dj_llsm_smst_node_integrality : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    (𝔭 : Ideal A) (t : A) (h : A) (𝔮 : Ideal B) (t' : B),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    ∀ c b c₃ b₃ : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W →
      b ≠ 0 → c₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ≠ 0 →
      wcLlsSmPre W A B 𝔮 t t' c b c₃ b₃ →
      (∃ p q : ↥(wcLlsASbS W B M (t' - algebraMap ↥W B c₃) b₃),
        q ∉ wcLlsASbN W B M (t' - algebraMap ↥W B c₃) b₃ ∧
        p ∈ wcLlsASbN W B M (t' - algebraMap ↥W B c₃) b₃ ∧
        algebraMap ↥(wcLlsASbS W B M (t' - algebraMap ↥W B c₃) b₃) M q *
            algebraMap K M (algebraMap A K (algebraMap ↥W A b) /
              algebraMap A K (t - algebraMap ↥W A c)) =
          algebraMap ↥(wcLlsASbS W B M (t' - algebraMap ↥W B c₃) b₃) M p) ∧
      (∀ x q : ↥(wcLlsASbS W B M (t' - algebraMap ↥W B c₃) b₃),
        q ∉ wcLlsASbN W B M (t' - algebraMap ↥W B c₃) b₃ →
        ∃ g : Polynomial ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b),
          g.leadingCoeff ∉ wcLlsASbN W A K (t - algebraMap ↥W A c) b ∧
          Polynomial.eval₂ ((algebraMap K M).comp
              (algebraMap ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b) K))
            (algebraMap ↥(wcLlsASbS W B M (t' - algebraMap ↥W B c₃) b₃) M x /
              algebraMap ↥(wcLlsASbS W B M (t' - algebraMap ↥W B c₃) b₃) M q) g = 0) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M _ _ _ _ _ _ B _ _ _ _ _ _ _ _
    𝔭 t h 𝔮 t' hPD hSmc c b c₃ b₃ hc hb hb0 hc₃ hb₃ hb₃0 hPre
  obtain ⟨z₀, hz₀, hbz₀, e, n, he, hrel⟩ := wcpa_dj_llsm_smni_norm_section Ω W hW hWt A K M B
    𝔭 t h 𝔮 t' hPD hSmc c b c₃ b₃ hc hb hb0 hc₃ hb₃ hb₃0 hPre
  have hn : n ∉ 𝔭 := wcpa_dj_llsm_smni_norm_order_one Ω W hW hWt A K M B
    𝔭 t h 𝔮 t' hPD hSmc c b c₃ b₃ hc hb hb0 hc₃ hb₃ hb₃0 hPre z₀ e n hz₀ he hrel
  obtain ⟨hv1, hv2⟩ := wcpa_dj_llsm_smni_valuation_match Ω W hW hWt A K M B
    𝔭 t h 𝔮 t' hPD hSmc c b c₃ b₃ hc hb hb0 hc₃ hb₃ hb₃0 hPre z₀ e n hz₀ hbz₀ he hn hrel
  have hexp := wcpa_dj_llsm_smni_coeff_expansion Ω W hW hWt A K M B
    𝔭 t h 𝔮 t' hPD hSmc c b c₃ b₃ hc hb hb0 hc₃ hb₃ hb₃0 hPre z₀ hz₀ hbz₀
  obtain ⟨hNA, hNB, hZ, hT⟩ := wcpa_dj_llsm_smni_nodes_proper Ω W hW hWt A K M B
    𝔭 t h 𝔮 t' hPD hSmc c b c₃ b₃ hc hb hb0 hc₃ hb₃ hb₃0 hPre
  obtain ⟨ha, hEis⟩ := wcpa_dj_llsm_smni_assembly Ω W hW hWt A K M B
    𝔭 t h 𝔮 t' hPD hSmc c b c₃ b₃ hc hb hb0 hc₃ hb₃ hb₃0 hNA hNB hZ hT z₀ e n hz₀ hbz₀ he hn
    hrel hv1 hv2 hexp
  exact ⟨ha, wcpa_dj_llsm_smni_local_integrality Ω W hW hWt A K M B
    𝔭 t h 𝔮 t' hPD hSmc c b c₃ b₃ hc hb hb0 hc₃ hb₃ hb₃0 hNA hNB hEis⟩

theorem wcpa_dj_llsm_smst_lt_clear_fwd : ∀ (L : Type u) [Field L] (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R L] [Algebra R' L] (N' : Ideal R'), N'.IsPrime → (∀ r : R, ∃ p q : R', q ∉ N' ∧ algebraMap R' L q * algebraMap R L r = algebraMap R' L p) → ∀ x ∈ integralClosure R L, ∃ d : R', d ∉ N' ∧ algebraMap R' L d * x ∈ integralClosure R' L :=
by
  intro L _ R R' _ _ _ _ N' hN' H1 x hx
  classical
  have := hN'
  obtain ⟨f, hf, hfx⟩ := (mem_integralClosure_iff R L).mp hx
  choose pp qq hq hpq using H1
  obtain ⟨D, hDdef⟩ : ∃ D : R', D = ∏ i ∈ Finset.range f.natDegree, qq (f.coeff i) := ⟨_, rfl⟩
  have hD : D ∉ N' := by
    intro h
    rw [hDdef] at h
    obtain ⟨i, _, hi⟩ := (hN'.prod_mem_iff).mp h
    exact hq _ hi
  refine ⟨D, hD, ?_⟩
  have hpm : (f.map (algebraMap R L)).Monic := hf.map (algebraMap R L)
  have hpn : (f.map (algebraMap R L)).natDegree = f.natDegree := hf.natDegree_map (algebraMap R L)
  have hPm : ((f.map (algebraMap R L)).scaleRoots (algebraMap R' L D)).Monic :=
    (Polynomial.monic_scaleRoots_iff (algebraMap R' L D)).mpr hpm
  have hstar : Polynomial.eval₂ (RingHom.id L) (algebraMap R' L D * x)
      ((f.map (algebraMap R L)).scaleRoots (algebraMap R' L D)) = 0 := by
    have := Polynomial.scaleRoots_eval₂_mul (p := f.map (algebraMap R L)) (RingHom.id L) x
      (algebraMap R' L D)
    simp only [RingHom.id_apply] at this
    rw [this, Polynomial.eval₂_map, RingHom.id_comp, hfx, mul_zero]
  have hcoeff : ∀ i, ((f.map (algebraMap R L)).scaleRoots (algebraMap R' L D)).coeff i ∈
      Set.range (algebraMap R' L) := by
    intro i
    rw [Polynomial.coeff_scaleRoots, hpn, Polynomial.coeff_map]
    rcases lt_trichotomy i f.natDegree with h | h | h
    · have hi : i ∈ Finset.range f.natDegree := Finset.mem_range.mpr h
      have hprod := Finset.mul_prod_erase (Finset.range f.natDegree) (fun j => qq (f.coeff j)) hi
      rw [← hDdef] at hprod
      have key : algebraMap R L (f.coeff i) * algebraMap R' L D =
          algebraMap R' L (pp (f.coeff i)) *
            algebraMap R' L (∏ j ∈ (Finset.range f.natDegree).erase i, qq (f.coeff j)) := by
        rw [← hprod, map_mul, ← hpq]
        ring
      obtain ⟨k, hk⟩ : ∃ k, f.natDegree - i = k + 1 := ⟨f.natDegree - i - 1, by omega⟩
      refine ⟨pp (f.coeff i) * (∏ j ∈ (Finset.range f.natDegree).erase i, qq (f.coeff j)) *
        D ^ k, ?_⟩
      rw [hk, pow_succ, map_mul, map_mul, map_pow, ← key]
      ring
    · subst h
      rw [hf.coeff_natDegree, Nat.sub_self]
      exact ⟨1, by simp⟩
    · rw [Polynomial.coeff_eq_zero_of_natDegree_lt h]
      exact ⟨0, by simp⟩
  have hlift : (f.map (algebraMap R L)).scaleRoots (algebraMap R' L D) ∈
      Polynomial.lifts (algebraMap R' L) :=
    (Polynomial.lifts_iff_coeff_lifts _).mpr hcoeff
  obtain ⟨g, hgP, _, hgm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hPm
  refine (mem_integralClosure_iff R' L).mpr ⟨g, hgm, ?_⟩
  have h2 := Polynomial.eval₂_map (p := g) (algebraMap R' L) (RingHom.id L) (algebraMap R' L D * x)
  rw [hgP, RingHom.id_comp] at h2
  rw [← h2]
  exact hstar

theorem wcpa_dj_llsm_smst_lt_clear_bwd : ∀ (L : Type u) [Field L] (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R L] [Algebra R' L] (N : Ideal R), N.IsPrime → (∀ x : R', ∃ g : Polynomial R, g.leadingCoeff ∉ N ∧ Polynomial.eval₂ (algebraMap R L) (algebraMap R' L x) g = 0) → ∀ y ∈ integralClosure R' L, ∃ e : R, e ∉ N ∧ algebraMap R L e * y ∈ integralClosure R L :=
by
  intro L _ R R' _ _ _ _ N hN H y hy
  classical
  rw [mem_integralClosure_iff] at hy
  obtain ⟨f, hf, hfy⟩ := hy
  choose g hg1 hg2 using H
  have hZ : ∀ x : R', algebraMap R L (g x).leadingCoeff * algebraMap R' L x ∈
      integralClosure R L := by
    intro x
    rw [mem_integralClosure_iff]
    have := isIntegral_leadingCoeff_smul (g x) (algebraMap R' L x)
      (by rw [Polynomial.aeval_def]; exact hg2 x)
    rwa [Algebra.smul_def] at this
  obtain ⟨E, hE⟩ : ∃ E : R, E = ∏ i ∈ Finset.range f.natDegree, (g (f.coeff i)).leadingCoeff :=
    ⟨_, rfl⟩
  have hEN : E ∉ N := by
    rw [hE]
    intro hmem
    obtain ⟨i, _, hi⟩ := (Ideal.IsPrime.prod_mem_iff (hp := hN)).mp hmem
    exact hg1 _ hi
  refine ⟨E, hEN, ?_⟩
  have hFm : (f.map (algebraMap R' L)).Monic := hf.map _
  have hFn : (f.map (algebraMap R' L)).natDegree = f.natDegree := hf.natDegree_map _
  have hFy : Polynomial.eval₂ (RingHom.id L) y (f.map (algebraMap R' L)) = 0 := by
    rw [Polynomial.eval₂_map]
    exact hfy
  have hPm : ((f.map (algebraMap R' L)).scaleRoots (algebraMap R L E)).Monic :=
    (Polynomial.monic_scaleRoots_iff _).mpr hFm
  have hProot : Polynomial.eval₂ (RingHom.id L) (algebraMap R L E * y)
      ((f.map (algebraMap R' L)).scaleRoots (algebraMap R L E)) = 0 :=
    Polynomial.scaleRoots_eval₂_eq_zero (RingHom.id L) hFy
  have hcoeff : ∀ i, ((f.map (algebraMap R' L)).scaleRoots (algebraMap R L E)).coeff i ∈
      integralClosure R L := by
    intro i
    rw [Polynomial.coeff_scaleRoots, hFn, Polynomial.coeff_map]
    rcases lt_trichotomy i f.natDegree with h | h | h
    · have hmem : i ∈ Finset.range f.natDegree := Finset.mem_range.mpr h
      obtain ⟨k, hk⟩ : (g (f.coeff i)).leadingCoeff ∣ E := by
        rw [hE]; exact Finset.dvd_prod_of_mem _ hmem
      have hEk : algebraMap R L E =
          algebraMap R L (g (f.coeff i)).leadingCoeff * algebraMap R L k := by
        rw [hk, map_mul]
      obtain ⟨m, hm⟩ : ∃ m, f.natDegree - i = m + 1 := ⟨f.natDegree - i - 1, by omega⟩
      have key : algebraMap R' L (f.coeff i) * algebraMap R L E ^ (f.natDegree - i) =
          algebraMap R L E ^ m * algebraMap R L k *
            (algebraMap R L (g (f.coeff i)).leadingCoeff * algebraMap R' L (f.coeff i)) := by
        rw [hm, pow_succ]
        linear_combination (algebraMap R L E ^ m * algebraMap R' L (f.coeff i)) * hEk
      rw [key]
      refine Subalgebra.mul_mem _ (Subalgebra.mul_mem _ ?_ ?_) (hZ _)
      · exact Subalgebra.pow_mem _ (Subalgebra.algebraMap_mem _ _) _
      · exact Subalgebra.algebraMap_mem _ _
    · subst h
      rw [hf.coeff_natDegree, Nat.sub_self, pow_zero, map_one, one_mul]
      exact Subalgebra.one_mem _
    · rw [Polynomial.coeff_eq_zero_of_natDegree_lt h, map_zero, zero_mul]
      exact Subalgebra.zero_mem _
  have hlift : (f.map (algebraMap R' L)).scaleRoots (algebraMap R L E) ∈
      Polynomial.lifts (algebraMap (integralClosure R L) L) := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro i
    exact ⟨⟨_, hcoeff i⟩, rfl⟩
  obtain ⟨q, hq, -, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hPm
  have hint : _root_.IsIntegral (integralClosure R L) (algebraMap R L E * y) := by
    refine ⟨q, hqm, ?_⟩
    rw [← Polynomial.eval_map, hq, ← Polynomial.eval₂_id]
    exact hProot
  rw [mem_integralClosure_iff]
  exact isIntegral_trans _ hint

theorem wcpa_dj_llsm_smst_lt_fs_equiv : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (L : Type u) [Field L] (wL : ↥W →+* L) (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R L] [Algebra R' L] (Q : Ideal ↥(integralClosure R L)) [Q.IsPrime] (Q' : Ideal ↥(integralClosure R' L)) [Q'.IsPrime], (∀ c s : ↥(integralClosure R L), s ∉ Q → ∃ a d : ↥(integralClosure R' L), d ∉ Q' ∧ (d : L) * (c : L) = (a : L) * (s : L)) → (∀ c s : ↥(integralClosure R' L), s ∉ Q' → ∃ a d : ↥(integralClosure R L), d ∉ Q ∧ (d : L) * (c : L) = (a : L) * (s : L)) → (∀ w ∈ IsLocalRing.maximalIdeal ↥W, wL w ∈ integralClosure R L) → (∀ w ∈ IsLocalRing.maximalIdeal ↥W, wL w ∈ integralClosure R' L) → Nonempty (wcLlsFS W wL R Q ≃+* wcLlsFS W wL R' Q') :=
by
  intro Ω _ W L _ wL R R' _ _ _ _ Q _ Q' _ h1 h2 hwA hwB

  have embed : ∀ (S : Type u) [CommRing S] [Algebra S L] (P : Ideal ↥(integralClosure S L))
      [P.IsPrime], ∃ ι : Localization.AtPrime P →+* L, Function.Injective ι ∧
        (∀ c : ↥(integralClosure S L),
          ι (algebraMap ↥(integralClosure S L) (Localization.AtPrime P) c) = (c : L)) ∧
        (∀ x : Localization.AtPrime P, ∃ c s : ↥(integralClosure S L), s ∉ P ∧
          ι x * (s : L) = (c : L)) := by
    intro S _ _ P _
    let g : ↥(integralClosure S L) →+* L := (integralClosure S L).val.toRingHom
    have hg : ∀ y : P.primeCompl, IsUnit (g y) := by
      intro y
      apply isUnit_iff_ne_zero.mpr
      intro h0
      apply y.2
      have hy : (y : ↥(integralClosure S L)) = 0 := Subtype.ext h0
      rw [hy]
      exact P.zero_mem
    refine ⟨IsLocalization.lift (M := P.primeCompl) (S := Localization.AtPrime P) hg, ?_, ?_, ?_⟩
    · rw [IsLocalization.lift_injective_iff]
      intro x y
      constructor
      · intro h
        rw [IsLocalization.injective (Localization.AtPrime P)
          (Ideal.primeCompl_le_nonZeroDivisors P) h]
      · intro h
        rw [Subtype.ext h]
    · intro c
      exact IsLocalization.lift_eq hg c
    · intro x
      obtain ⟨⟨c, s⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl x
      refine ⟨c, s, s.2, ?_⟩
      have h3 := congrArg (IsLocalization.lift (M := P.primeCompl)
        (S := Localization.AtPrime P) hg) (IsLocalization.mk'_spec (Localization.AtPrime P) c s)
      rw [map_mul, IsLocalization.lift_eq, IsLocalization.lift_eq] at h3
      exact h3
  obtain ⟨ι, hιi, hιc, hιx⟩ := embed R Q
  obtain ⟨ι', hι'i, hι'c, hι'x⟩ := embed R' Q'

  have hfwd : ∀ x : Localization.AtPrime Q, ∃ x' : Localization.AtPrime Q', ι' x' = ι x := by
    intro x
    obtain ⟨c, s, hs, hx⟩ := hιx x
    obtain ⟨a, d, hd, had⟩ := h1 c s hs
    refine ⟨IsLocalization.mk' (Localization.AtPrime Q') a (⟨d, hd⟩ : Q'.primeCompl), ?_⟩
    have h3 := congrArg ι'
      (IsLocalization.mk'_spec (Localization.AtPrime Q') a (⟨d, hd⟩ : Q'.primeCompl))
    rw [map_mul, hι'c, hι'c] at h3
    have h3' : ι' (IsLocalization.mk' (Localization.AtPrime Q') a (⟨d, hd⟩ : Q'.primeCompl))
        * (d : L) = (a : L) := h3
    have hd0 : (d : L) ≠ 0 := fun h0 => hd (by
      rw [show d = 0 from Subtype.ext h0]; exact Q'.zero_mem)
    have hs0 : (s : L) ≠ 0 := fun h0 => hs (by
      rw [show s = 0 from Subtype.ext h0]; exact Q.zero_mem)
    apply mul_right_cancel₀ (mul_ne_zero hd0 hs0)
    calc ι' (IsLocalization.mk' (Localization.AtPrime Q') a (⟨d, hd⟩ : Q'.primeCompl))
          * ((d : L) * (s : L))
        = (ι' (IsLocalization.mk' (Localization.AtPrime Q') a (⟨d, hd⟩ : Q'.primeCompl))
          * (d : L)) * (s : L) := by ring
      _ = (a : L) * (s : L) := by rw [h3']
      _ = (d : L) * (c : L) := had.symm
      _ = (d : L) * (ι x * (s : L)) := by rw [hx]
      _ = ι x * ((d : L) * (s : L)) := by ring
  have hbwd : ∀ x' : Localization.AtPrime Q', ∃ x : Localization.AtPrime Q, ι x = ι' x' := by
    intro x
    obtain ⟨c, s, hs, hx⟩ := hι'x x
    obtain ⟨a, d, hd, had⟩ := h2 c s hs
    refine ⟨IsLocalization.mk' (Localization.AtPrime Q) a (⟨d, hd⟩ : Q.primeCompl), ?_⟩
    have h3 := congrArg ι
      (IsLocalization.mk'_spec (Localization.AtPrime Q) a (⟨d, hd⟩ : Q.primeCompl))
    rw [map_mul, hιc, hιc] at h3
    have h3' : ι (IsLocalization.mk' (Localization.AtPrime Q) a (⟨d, hd⟩ : Q.primeCompl))
        * (d : L) = (a : L) := h3
    have hd0 : (d : L) ≠ 0 := fun h0 => hd (by
      rw [show d = 0 from Subtype.ext h0]; exact Q.zero_mem)
    have hs0 : (s : L) ≠ 0 := fun h0 => hs (by
      rw [show s = 0 from Subtype.ext h0]; exact Q'.zero_mem)
    apply mul_right_cancel₀ (mul_ne_zero hd0 hs0)
    calc ι (IsLocalization.mk' (Localization.AtPrime Q) a (⟨d, hd⟩ : Q.primeCompl))
          * ((d : L) * (s : L))
        = (ι (IsLocalization.mk' (Localization.AtPrime Q) a (⟨d, hd⟩ : Q.primeCompl))
          * (d : L)) * (s : L) := by ring
      _ = (a : L) * (s : L) := by rw [h3']
      _ = (d : L) * (c : L) := had.symm
      _ = (d : L) * (ι' x * (s : L)) := by rw [hx]
      _ = ι' x * ((d : L) * (s : L)) := by ring

  have hr : ι.range = ι'.range := by
    ext z
    simp only [RingHom.mem_range]
    constructor
    · rintro ⟨x, rfl⟩
      exact hfwd x
    · rintro ⟨x', rfl⟩
      exact hbwd x'
  let e1 : Localization.AtPrime Q ≃+* ι.range :=
    RingEquiv.ofBijective ι.rangeRestrict
      ⟨fun x y h => hιi (congrArg Subtype.val h), ι.rangeRestrict_surjective⟩
  let e3 : Localization.AtPrime Q' ≃+* ι'.range :=
    RingEquiv.ofBijective ι'.rangeRestrict
      ⟨fun x y h => hι'i (congrArg Subtype.val h), ι'.rangeRestrict_surjective⟩
  let e : Localization.AtPrime Q ≃+* Localization.AtPrime Q' :=
    e1.trans ((RingEquiv.subringCongr hr).trans e3.symm)
  have he : ∀ x, ι' (e x) = ι x := by
    intro x
    have h4 : e3 (e x) = RingEquiv.subringCongr hr (e1 x) := e3.apply_symm_apply _
    exact congrArg Subtype.val h4

  have key : ∀ (b : ↥(integralClosure R L)) (b' : ↥(integralClosure R' L)), (b : L) = (b' : L) →
      e (algebraMap ↥(integralClosure R L) (Localization.AtPrime Q) b) =
        algebraMap ↥(integralClosure R' L) (Localization.AtPrime Q') b' := by
    intro b b' h
    apply hι'i
    rw [he, hιc, hι'c, h]
  have hJ : (Ideal.span {b : ↥(integralClosure R' L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w}).map
        (algebraMap ↥(integralClosure R' L) (Localization.AtPrime Q')) =
      Ideal.map (e : Localization.AtPrime Q →+* Localization.AtPrime Q')
        ((Ideal.span {b : ↥(integralClosure R L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w}).map
          (algebraMap ↥(integralClosure R L) (Localization.AtPrime Q))) := by
    rw [Ideal.map_map, Ideal.map_span, Ideal.map_span]
    congr 1
    ext z
    simp only [Set.mem_image, Set.mem_setOf_eq, RingHom.coe_comp, Function.comp_apply]
    constructor
    · rintro ⟨b', ⟨w, hw, hb'⟩, rfl⟩
      exact ⟨⟨wL w, hwA w hw⟩, ⟨w, hw, rfl⟩, key _ _ hb'.symm⟩
    · rintro ⟨b, ⟨w, hw, hb⟩, rfl⟩
      exact ⟨⟨wL w, hwB w hw⟩, ⟨w, hw, rfl⟩, (key _ _ hb).symm⟩
  exact ⟨Ideal.quotientEquiv _ _ e hJ⟩

theorem wcpa_dj_llsm_smst_lt_match_fwd : ∀ (L : Type u) [Field L] (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R L] [Algebra R' L] (N : Ideal R) (N' : Ideal R'), N.IsMaximal → (∀ r ∈ N, ∃ p q : R', q ∉ N' ∧ p ∈ N' ∧ algebraMap R' L q * algebraMap R L r = algebraMap R' L p) → (∀ x ∈ integralClosure R L, ∃ d : R', d ∉ N' ∧ algebraMap R' L d * x ∈ integralClosure R' L) → (∀ y ∈ integralClosure R' L, ∃ e : R, e ∉ N ∧ algebraMap R L e * y ∈ integralClosure R L) → (∀ r : R, r ∉ N → ∃ p q : R', q ∉ N' ∧ p ∉ N' ∧ algebraMap R' L q * algebraMap R L r = algebraMap R' L p) → ∀ (Q' : Ideal ↥(integralClosure R' L)) [Q'.IsPrime], Q'.comap (algebraMap R' ↥(integralClosure R' L)) = N' → ∃ (Q : Ideal ↥(integralClosure R L)) (_ : Q.IsPrime), Q.comap (algebraMap R ↥(integralClosure R L)) = N ∧ (∀ c s : ↥(integralClosure R L), s ∉ Q → ∃ a d : ↥(integralClosure R' L), d ∉ Q' ∧ (d : L) * (c : L) = (a : L) * (s : L)) ∧ (∀ c s : ↥(integralClosure R' L), s ∉ Q' → ∃ a d : ↥(integralClosure R L), d ∉ Q ∧ (d : L) * (c : L) = (a : L) * (s : L)) :=
by
  intro L _ R R' _ _ _ _ N N' hNmax hdom hK1 hK2 hK3 Q' hQ'p hQ'
  classical
  have F0 : ∀ x : R', x ∉ N' → algebraMap R' (integralClosure R' L) x ∉ Q' := by
    intro x hx h
    apply hx
    rw [← hQ']
    exact h
  have F0' : ∀ x : R', x ∈ N' → algebraMap R' (integralClosure R' L) x ∈ Q' := by
    intro x hx
    rw [← hQ'] at hx
    exact hx
  have hone : (1 : integralClosure R' L) ∉ Q' := (Ideal.ne_top_iff_one Q').mp hQ'p.ne_top
  have star : ∀ c : integralClosure R L, ∃ a d : integralClosure R' L,
      d ∉ Q' ∧ (d : L) * (c : L) = (a : L) := by
    intro c
    obtain ⟨d₀, hd₀, h⟩ := hK1 (c : L) c.2
    refine ⟨⟨_, h⟩, algebraMap R' _ d₀, F0 d₀ hd₀, ?_⟩
    simp only [Subalgebra.coe_algebraMap]
  let Q : Ideal (integralClosure R L) :=
    { carrier := {c | ∃ a d : integralClosure R' L, d ∉ Q' ∧ a ∈ Q' ∧ (d : L) * (c : L) = (a : L)}
      add_mem' := by
        rintro c₁ c₂ ⟨a₁, d₁, hd₁, ha₁, h₁⟩ ⟨a₂, d₂, hd₂, ha₂, h₂⟩
        refine ⟨d₂ * a₁ + d₁ * a₂, d₁ * d₂, hQ'p.mul_notMem hd₁ hd₂,
          Q'.add_mem (Q'.mul_mem_left _ ha₁) (Q'.mul_mem_left _ ha₂), ?_⟩
        push_cast
        rw [← h₁, ← h₂]
        ring
      zero_mem' := ⟨0, 1, hone, Q'.zero_mem, by simp⟩
      smul_mem' := by
        rintro x c ⟨a, d, hd, ha, h⟩
        obtain ⟨ax, dx, hdx, hx⟩ := star x
        refine ⟨ax * a, dx * d, hQ'p.mul_notMem hdx hd, Q'.mul_mem_left _ ha, ?_⟩
        simp only [smul_eq_mul]
        push_cast
        rw [← hx, ← h]
        ring }
  have hmem : ∀ c, c ∈ Q ↔ ∃ a d : integralClosure R' L, d ∉ Q' ∧ a ∈ Q' ∧
      (d : L) * (c : L) = (a : L) := fun c => Iff.rfl
  have hQp : Q.IsPrime := by
    refine Ideal.isPrime_iff.mpr ⟨?_, ?_⟩
    · rw [Ideal.ne_top_iff_one, hmem]
      rintro ⟨a, d, hd, ha, h⟩
      apply hd
      have : d = a := Subtype.ext (by simpa using h)
      rw [this]
      exact ha
    · intro c₁ c₂ hc
      obtain ⟨a, d, hd, ha, h⟩ := (hmem _).mp hc
      obtain ⟨a₁, d₁, hd₁, h₁⟩ := star c₁
      obtain ⟨a₂, d₂, hd₂, h₂⟩ := star c₂
      have h' : (d : L) * (c₁ : L) * (c₂ : L) = (a : L) := by
        rw [← h]
        push_cast
        ring
      have key : d * (a₁ * a₂) = d₁ * d₂ * a := by
        apply Subtype.ext
        push_cast
        rw [← h₁, ← h₂, ← h']
        ring
      have hm : d * (a₁ * a₂) ∈ Q' := by
        rw [key]
        exact Q'.mul_mem_left _ ha
      rcases hQ'p.mem_or_mem hm with h3 | h3
      · exact absurd h3 hd
      · rcases hQ'p.mem_or_mem h3 with h4 | h4
        · exact Or.inl ((hmem _).mpr ⟨a₁, d₁, hd₁, h4, h₁⟩)
        · exact Or.inr ((hmem _).mpr ⟨a₂, d₂, hd₂, h4, h₂⟩)
  have hle : N ≤ Q.comap (algebraMap R (integralClosure R L)) := by
    intro r hr
    obtain ⟨p, q, hq, hp, h⟩ := hdom r hr
    rw [Ideal.mem_comap, hmem]
    refine ⟨algebraMap R' _ p, algebraMap R' _ q, F0 q hq, F0' p hp, ?_⟩
    simp only [Subalgebra.coe_algebraMap]
    exact h
  have hG1 : Q.comap (algebraMap R (integralClosure R L)) = N :=
    (hNmax.eq_of_le (Ideal.comap_ne_top _ hQp.ne_top) hle).symm
  have hG2 : ∀ c s : integralClosure R L, s ∉ Q → ∃ a d : integralClosure R' L,
      d ∉ Q' ∧ (d : L) * (c : L) = (a : L) * (s : L) := by
    intro c s hs
    obtain ⟨ac, dc, hdc, hc⟩ := star c
    obtain ⟨as, ds, hds, hs'⟩ := star s
    have has : as ∉ Q' := fun h => hs ((hmem s).mpr ⟨as, ds, hds, h, hs'⟩)
    refine ⟨ac * ds, dc * as, hQ'p.mul_notMem hdc has, ?_⟩
    push_cast
    rw [← hc, ← hs']
    ring
  have hG3 : ∀ c s : integralClosure R' L, s ∉ Q' → ∃ a d : integralClosure R L,
      d ∉ Q ∧ (d : L) * (c : L) = (a : L) * (s : L) := by
    intro c s hs
    obtain ⟨e₁, he₁, h₁⟩ := hK2 (c : L) c.2
    obtain ⟨e₂, he₂, h₂⟩ := hK2 (s : L) s.2
    refine ⟨⟨_, h₁⟩ * algebraMap R (integralClosure R L) e₂,
      algebraMap R (integralClosure R L) e₁ * ⟨_, h₂⟩, ?_, ?_⟩
    · intro hd
      obtain ⟨α, δ, hδ, hα, h⟩ := (hmem _).mp hd
      obtain ⟨p₁, q₁, hq₁, hp₁, k₁⟩ := hK3 e₁ he₁
      obtain ⟨p₂, q₂, hq₂, hp₂, k₂⟩ := hK3 e₂ he₂
      have h' : (δ : L) * (algebraMap R L e₁ * (algebraMap R L e₂ * (s : L))) = (α : L) := by
        rw [← h]
        push_cast [Subalgebra.coe_algebraMap]
        rfl
      have key : δ * algebraMap R' (integralClosure R' L) p₁ *
          algebraMap R' (integralClosure R' L) p₂ * s =
          algebraMap R' (integralClosure R' L) q₁ * algebraMap R' (integralClosure R' L) q₂ * α := by
        apply Subtype.ext
        push_cast [Subalgebra.coe_algebraMap]
        linear_combination (-(δ : L) * algebraMap R' L p₂ * (s : L)) * k₁
          - ((δ : L) * algebraMap R' L q₁ * algebraMap R L e₁ * (s : L)) * k₂
          + (algebraMap R' L q₁ * algebraMap R' L q₂) * h'
      have h1 : δ * algebraMap R' (integralClosure R' L) p₁ *
          algebraMap R' (integralClosure R' L) p₂ * s ∉ Q' :=
        hQ'p.mul_notMem (hQ'p.mul_notMem (hQ'p.mul_notMem hδ (F0 _ hp₁)) (F0 _ hp₂)) hs
      apply h1
      rw [key]
      exact Q'.mul_mem_left _ hα
    · push_cast [Subalgebra.coe_algebraMap]
      ring
  exact ⟨Q, hQp, hG1, hG2, hG3⟩

theorem wcpa_dj_llsm_smst_lt_match_bwd : ∀ (L : Type u) [Field L] (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R L] [Algebra R' L] (N : Ideal R) (N' : Ideal R'), Function.Injective (algebraMap R L) → Function.Injective (algebraMap R' L) → N.IsMaximal → N'.IsMaximal → (∀ r : R, ∃ p q : R', q ∉ N' ∧ algebraMap R' L q * algebraMap R L r = algebraMap R' L p) → (∀ x q : R', q ∉ N' → ∃ g : Polynomial R, g.leadingCoeff ∉ N ∧ Polynomial.eval₂ (algebraMap R L) (algebraMap R' L x / algebraMap R' L q) g = 0) → (∀ x ∈ integralClosure R L, ∃ d : R', d ∉ N' ∧ algebraMap R' L d * x ∈ integralClosure R' L) → (∀ y ∈ integralClosure R' L, ∃ e : R, e ∉ N ∧ algebraMap R L e * y ∈ integralClosure R L) → (∀ r : R, r ∉ N → ∃ p q : R', q ∉ N' ∧ p ∉ N' ∧ algebraMap R' L q * algebraMap R L r = algebraMap R' L p) → ∀ (Q : Ideal ↥(integralClosure R L)) [Q.IsPrime], Q.comap (algebraMap R ↥(integralClosure R L)) = N → ∃ (Q' : Ideal ↥(integralClosure R' L)) (_ : Q'.IsPrime), Q'.comap (algebraMap R' ↥(integralClosure R' L)) = N' ∧ (∀ c s : ↥(integralClosure R L), s ∉ Q → ∃ a d : ↥(integralClosure R' L), d ∉ Q' ∧ (d : L) * (c : L) = (a : L) * (s : L)) ∧ (∀ c s : ↥(integralClosure R' L), s ∉ Q' → ∃ a d : ↥(integralClosure R L), d ∉ Q ∧ (d : L) * (c : L) = (a : L) * (s : L)) :=
by
  intro L _ R R' _ _ _ _ N N' injA injB hNmax hN'max H1 H2 hK1 hK2 hK3 Q hQp hQ
  classical
  have hNp : N.IsPrime := hNmax.isPrime
  have hN'p : N'.IsPrime := hN'max.isPrime
  have h1N : (1 : R) ∉ N := fun h => hNp.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have h1N' : (1 : R') ∉ N' := fun h => hN'p.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have hQ1 : (1 : ↥(integralClosure R L)) ∉ Q := fun h => hQp.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have hmul : ∀ a b : ↥(integralClosure R L), a ∉ Q → b ∉ Q → a * b ∉ Q :=
    fun a b ha hb h => (hQp.mem_or_mem h).elim ha hb
  have hQe : ∀ e : R, e ∉ N → algebraMap R ↥(integralClosure R L) e ∉ Q := by
    intro e he h
    apply he
    rw [← hQ, Ideal.mem_comap]
    exact h
  have hQr : ∀ r : R, r ∈ N → algebraMap R ↥(integralClosure R L) r ∈ Q := by
    intro r hr
    rw [← hQ, Ideal.mem_comap] at hr
    exact hr
  have hq0 : ∀ q : R', q ∉ N' → algebraMap R' L q ≠ 0 := by
    intro q hq h
    apply hq
    have : q = 0 := injB (by rw [h, map_zero])
    rw [this]
    exact N'.zero_mem
  have hr0 : ∀ r : R, r ∉ N → algebraMap R L r ≠ 0 := by
    intro r hr h
    apply hr
    have : r = 0 := injA (by rw [h, map_zero])
    rw [this]
    exact N.zero_mem

  have K4 : ∀ q : R', q ∉ N' → ∃ e : R, e ∉ N ∧ ∃ x ∈ integralClosure R L,
      x * algebraMap R' L q = algebraMap R L e := by
    intro q hq
    obtain ⟨g, hg1, hg2⟩ := H2 1 q hq
    have hint := RingHom.isIntegralElem_leadingCoeff_mul (algebraMap R L) g _ hg2
    refine ⟨g.leadingCoeff, hg1, _, (mem_integralClosure_iff R L).mpr hint, ?_⟩
    rw [map_one, mul_assoc, one_div, inv_mul_cancel₀ (hq0 q hq), mul_one]

  have hNM : ∀ d : R', d ∉ N' → ∀ s δ α : ↥(integralClosure R L), s ∉ Q → δ ∉ Q → α ∈ Q →
      (δ : L) * (algebraMap R' L d * (s : L)) ≠ (α : L) := by
    intro d hd s δ α hs hδ hα heq
    obtain ⟨e, he, x, hx, hxe⟩ := K4 d hd
    have h1 : (⟨x, hx⟩ : ↥(integralClosure R L)) * α =
        δ * s * algebraMap R ↥(integralClosure R L) e := by
      apply Subtype.ext
      show x * (α : L) = (δ : L) * (s : L) * algebraMap R L e
      rw [← heq, ← hxe]
      ring
    apply hmul _ _ (hmul _ _ hδ hs) (hQe e he)
    rw [← h1]
    exact Q.mul_mem_left _ hα

  have hsat : ∀ (T : Type u) [CommRing T] (φ : T →+* L),
      (∀ t : T, ∃ δ x : ↥(integralClosure R L), δ ∉ Q ∧ (δ : L) * φ t = (x : L)) →
      ∃ I : Ideal T, I.IsPrime ∧ ∀ t : T, t ∈ I ↔
        ∃ α δ : ↥(integralClosure R L), δ ∉ Q ∧ α ∈ Q ∧ (δ : L) * φ t = (α : L) := by
    intro T _ φ hstar
    let I : Ideal T :=
      { carrier := {t | ∃ α δ : ↥(integralClosure R L), δ ∉ Q ∧ α ∈ Q ∧ (δ : L) * φ t = (α : L)}
        add_mem' := fun {a b} ha hb => by
          obtain ⟨α₁, δ₁, hδ₁, hα₁, e₁⟩ := ha
          obtain ⟨α₂, δ₂, hδ₂, hα₂, e₂⟩ := hb
          refine ⟨δ₂ * α₁ + δ₁ * α₂, δ₁ * δ₂, hmul _ _ hδ₁ hδ₂,
            add_mem (Q.mul_mem_left _ hα₁) (Q.mul_mem_left _ hα₂), ?_⟩
          show (δ₁ : L) * δ₂ * φ (a + b) = δ₂ * α₁ + δ₁ * α₂
          rw [← e₁, ← e₂, map_add]
          ring
        zero_mem' := ⟨0, 1, hQ1, Q.zero_mem, by simp⟩
        smul_mem' := fun c t ht => by
          obtain ⟨α, δ, hδ, hα, e⟩ := ht
          obtain ⟨δ', x, hδ', ex⟩ := hstar c
          refine ⟨x * α, δ' * δ, hmul _ _ hδ' hδ, Q.mul_mem_left _ hα, ?_⟩
          show (δ' : L) * δ * φ (c * t) = x * α
          rw [← e, ← ex, map_mul]
          ring }
    refine ⟨I, ⟨?_, ?_⟩, fun t => Iff.rfl⟩
    · intro hT
      have h1 : (1 : T) ∈ I := by rw [hT]; exact Submodule.mem_top
      obtain ⟨α, δ, hδ, hα, e⟩ := h1
      rw [map_one, mul_one] at e
      have : δ = α := Subtype.ext e
      exact hδ (this ▸ hα)
    · intro a b hab
      obtain ⟨α, δ, hδ, hα, e⟩ := hab
      obtain ⟨δa, xa, hδa, ea⟩ := hstar a
      obtain ⟨δb, xb, hδb, eb⟩ := hstar b
      have h1 : δ * (xa * xb) = δa * δb * α := by
        apply Subtype.ext
        show (δ : L) * (xa * xb) = δa * δb * α
        rw [← e, ← ea, ← eb, map_mul]
        ring
      have h2 : δ * (xa * xb) ∈ Q := by rw [h1]; exact Q.mul_mem_left _ hα
      rcases hQp.mem_or_mem h2 with h | h
      · exact absurd h hδ
      · rcases hQp.mem_or_mem h with h | h
        · exact Or.inl ⟨xa, δa, hδa, h, ea⟩
        · exact Or.inr ⟨xb, δb, hδb, h, eb⟩

  obtain ⟨Q', hQ'p, hchar⟩ := hsat ↥(integralClosure R' L)
    (algebraMap ↥(integralClosure R' L) L) (by
      intro y
      obtain ⟨e, he, hx⟩ := hK2 y y.2
      exact ⟨algebraMap R _ e, ⟨_, hx⟩, hQe e he, rfl⟩)
  have hmul' : ∀ a b : ↥(integralClosure R' L), a ∉ Q' → b ∉ Q' → a * b ∉ Q' :=
    fun a b ha hb h => (hQ'p.mem_or_mem h).elim ha hb

  have hsub : ∀ (A : Type u) [CommRing A] [Algebra A L] (P : Ideal A), P.IsPrime →
      ∃ O : Subring L, ∀ z : L, z ∈ O ↔
        ∃ r s : A, s ∉ P ∧ algebraMap A L s * z = algebraMap A L r := by
    intro A _ _ P hP
    have h1 : (1 : A) ∉ P := fun h => hP.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    refine ⟨{ carrier := {z | ∃ r s : A, s ∉ P ∧ algebraMap A L s * z = algebraMap A L r}
              one_mem' := ⟨1, 1, h1, by simp⟩
              mul_mem' := fun {a b} ha hb => by
                obtain ⟨r₁, s₁, hs₁, e₁⟩ := ha
                obtain ⟨r₂, s₂, hs₂, e₂⟩ := hb
                refine ⟨r₁ * r₂, s₁ * s₂, fun h => (hP.mem_or_mem h).elim hs₁ hs₂, ?_⟩
                rw [map_mul, map_mul, ← e₁, ← e₂]
                ring
              zero_mem' := ⟨0, 1, h1, by simp⟩
              add_mem' := fun {a b} ha hb => by
                obtain ⟨r₁, s₁, hs₁, e₁⟩ := ha
                obtain ⟨r₂, s₂, hs₂, e₂⟩ := hb
                refine ⟨s₂ * r₁ + s₁ * r₂, s₁ * s₂, fun h => (hP.mem_or_mem h).elim hs₁ hs₂, ?_⟩
                rw [map_add, map_mul, map_mul, map_mul, ← e₁, ← e₂]
                ring
              neg_mem' := fun {a} ha => by
                obtain ⟨r, s, hs, e⟩ := ha
                refine ⟨-r, s, hs, ?_⟩
                rw [map_neg, ← e]
                ring }, fun z => Iff.rfl⟩
  obtain ⟨O, hO⟩ := hsub R N hNp
  obtain ⟨O', hO'⟩ := hsub R' N' hN'p
  have hle : O ≤ O' := by
    intro z hz
    obtain ⟨r, s, hs, e⟩ := (hO z).1 hz
    obtain ⟨p, q, hq, hp, e1⟩ := hK3 s hs
    obtain ⟨p₂, q₂, hq₂, e2⟩ := H1 r
    refine (hO' z).2 ⟨q * p₂, q₂ * p, fun h => (hN'p.mem_or_mem h).elim hq₂ hp, ?_⟩
    rw [map_mul, map_mul, ← e1, ← e2, ← e]
    ring

  have hint : (Subring.inclusion hle).IsIntegral := by
    intro z
    let ρ : R →+* ↥O := (algebraMap R L).codRestrict O (fun r => (hO _).2 ⟨r, 1, h1N, by simp⟩)
    obtain ⟨p, q, hq, e⟩ := (hO' z).1 z.2
    have hz : (z : L) = algebraMap R' L p / algebraMap R' L q :=
      eq_div_of_mul_eq (hq0 q hq) (by rw [mul_comm]; exact e)
    obtain ⟨g, hg1, hg2⟩ := H2 p q hq
    have h2 : O'.subtype.comp ((Subring.inclusion hle).comp ρ) = algebraMap R L :=
      RingHom.ext fun r => rfl
    have hev : Polynomial.eval₂ ((Subring.inclusion hle).comp ρ) z g = 0 := by
      apply Subtype.val_injective
      change O'.subtype (Polynomial.eval₂ ((Subring.inclusion hle).comp ρ) z g) = 0
      rw [Polynomial.hom_eval₂, h2]
      show Polynomial.eval₂ (algebraMap R L) (z : L) g = 0
      rw [hz]
      exact hg2
    have hi1 := RingHom.isIntegralElem_leadingCoeff_mul _ g z hev
    have hi2 : (Subring.inclusion hle).IsIntegralElem
        ((Subring.inclusion hle) (ρ g.leadingCoeff) * z) := by
      obtain ⟨P, hPm, hP⟩ := hi1
      exact ⟨P.map ρ, hPm.map ρ, by rw [Polynomial.eval₂_map]; exact hP⟩
    have hu : 1 / algebraMap R L g.leadingCoeff ∈ O :=
      (hO _).2 ⟨1, g.leadingCoeff, hg1, by rw [map_one, mul_one_div_cancel (hr0 _ hg1)]⟩
    have hi3 := RingHom.IsIntegralElem.mul (Subring.inclusion hle)
      (RingHom.isIntegralElem_map (f := Subring.inclusion hle) (x := ⟨_, hu⟩)) hi2
    have heq : (Subring.inclusion hle) ⟨_, hu⟩ *
        ((Subring.inclusion hle) (ρ g.leadingCoeff) * z) = z := by
      apply Subtype.ext
      show 1 / algebraMap R L g.leadingCoeff * (algebraMap R L g.leadingCoeff * (z : L)) = z
      rw [← mul_assoc, one_div, inv_mul_cancel₀ (hr0 _ hg1), one_mul]
    rw [heq] at hi3
    exact hi3

  obtain ⟨I, hIp, hImem⟩ := hsat ↥O' O'.subtype (by
    intro w
    obtain ⟨p, q, hq, e⟩ := (hO' w).1 w.2
    obtain ⟨ep, hep, hxp⟩ := hK2 _ (Subalgebra.algebraMap_mem (integralClosure R' L) p)
    obtain ⟨eq', heq', xq, hxq, exq⟩ := K4 q hq
    refine ⟨algebraMap R _ ep * algebraMap R _ eq', ⟨xq, hxq⟩ * ⟨_, hxp⟩,
      hmul _ _ (hQe _ hep) (hQe _ heq'), ?_⟩
    show algebraMap R L ep * algebraMap R L eq' * (w : L) =
      xq * (algebraMap R L ep * algebraMap R' L p)
    rw [← exq, ← e]
    ring)
  haveI := hIp
  have hcm : (I.comap (Subring.inclusion hle)).IsMaximal := by
    rw [Ideal.isMaximal_iff]
    refine ⟨fun h => hIp.ne_top ((Ideal.eq_top_iff_one _).mpr (by
      rw [Ideal.mem_comap, map_one] at h; exact h)), ?_⟩
    intro J x hJ hx hxJ
    obtain ⟨r, s, hs, e⟩ := (hO x).1 x.2
    by_cases hr : r ∈ N
    · exfalso
      apply hx
      rw [Ideal.mem_comap, hImem]
      exact ⟨algebraMap R _ r, algebraMap R _ s, hQe s hs, hQr r hr, e⟩
    · have hu : algebraMap R L s / algebraMap R L r ∈ O :=
        (hO _).2 ⟨s, r, hr, by rw [mul_div_assoc', mul_comm, mul_div_assoc, div_self (hr0 r hr),
          mul_one]⟩
      have h1 : (⟨_, hu⟩ : ↥O) * x = 1 := by
        apply Subtype.ext
        show algebraMap R L s / algebraMap R L r * (x : L) = 1
        rw [div_mul_eq_mul_div, e, div_self (hr0 r hr)]
      rw [← h1]
      exact J.mul_mem_left _ hxJ
  have hImax : I.IsMaximal :=
    Ideal.isMaximal_of_isIntegral_of_isMaximal_comap' (Subring.inclusion hle) hint I hcm

  have hcrux : ∀ n' ∈ N', ∃ α δ : ↥(integralClosure R L), δ ∉ Q ∧ α ∈ Q ∧
      (δ : L) * algebraMap R' L n' = (α : L) := by
    intro n' hn'
    have hw : algebraMap R' L n' ∈ O' := (hO' _).2 ⟨n', 1, h1N', by simp⟩
    have hwI : (⟨_, hw⟩ : ↥O') ∈ I := by
      by_contra hwI
      obtain ⟨y, i, hi, hyi⟩ := hImax.exists_inv hwI
      obtain ⟨p, q, hq, e⟩ := (hO' y).1 y.2
      have ht : q - p * n' ∉ N' := fun h => hq (by
        have h3 : q = (q - p * n') + p * n' := by ring
        rw [h3]
        exact N'.add_mem h (N'.mul_mem_left _ hn'))
      have h1 : (y : L) * algebraMap R' L n' + (i : L) = 1 := congrArg Subtype.val hyi
      have hiL : algebraMap R' L q * (i : L) = algebraMap R' L (q - p * n') := by
        rw [map_sub, map_mul, ← e]
        linear_combination (algebraMap R' L q) * h1
      have hv : algebraMap R' L q / algebraMap R' L (q - p * n') ∈ O' :=
        (hO' _).2 ⟨q, q - p * n', ht, by rw [mul_div_assoc', mul_comm, mul_div_assoc,
          div_self (hq0 _ ht), mul_one]⟩
      have h4 : (⟨_, hv⟩ : ↥O') * i = 1 := by
        apply Subtype.ext
        show algebraMap R' L q / algebraMap R' L (q - p * n') * (i : L) = 1
        rw [div_mul_eq_mul_div, hiL, div_self (hq0 _ ht)]
      apply hIp.ne_top
      rw [Ideal.eq_top_iff_one, ← h4]
      exact I.mul_mem_left _ hi
    obtain ⟨α, δ, hδ, hα, e⟩ := (hImem _).1 hwI
    exact ⟨α, δ, hδ, hα, e⟩

  have hQ'c : Q'.comap (algebraMap R' ↥(integralClosure R' L)) = N' := by
    ext r'
    rw [Ideal.mem_comap, hchar]
    constructor
    · rintro ⟨α, δ, hδ, hα, e⟩
      by_contra hr
      apply hNM r' hr 1 δ α hQ1 hδ hα
      show (δ : L) * (algebraMap R' L r' * 1) = α
      rw [mul_one]
      exact e
    · intro hr
      exact hcrux r' hr
  refine ⟨Q', hQ'p, hQ'c, ?_, ?_⟩
  · intro c s hs
    obtain ⟨dc, hdc, hac⟩ := hK1 c c.2
    obtain ⟨ds, hds, has⟩ := hK1 s s.2
    have hasQ : (⟨_, has⟩ : ↥(integralClosure R' L)) ∉ Q' := by
      rw [hchar]
      rintro ⟨α, δ, hδ, hα, e⟩
      exact hNM ds hds s δ α hs hδ hα e
    have hdcQ : algebraMap R' ↥(integralClosure R' L) dc ∉ Q' := fun h => hdc (by
      rw [← hQ'c]
      exact h)
    refine ⟨⟨_, hac⟩ * algebraMap R' _ ds, algebraMap R' _ dc * ⟨_, has⟩, hmul' _ _ hdcQ hasQ, ?_⟩
    show algebraMap R' L dc * (algebraMap R' L ds * s) * c =
      algebraMap R' L dc * c * algebraMap R' L ds * s
    ring
  · intro c s hs
    obtain ⟨e1, he1, hx1⟩ := hK2 c c.2
    obtain ⟨e2, he2, hx2⟩ := hK2 s s.2
    have hx2Q : (⟨_, hx2⟩ : ↥(integralClosure R L)) ∉ Q := fun h =>
      hs ((hchar s).2 ⟨_, algebraMap R _ e2, hQe e2 he2, h, rfl⟩)
    refine ⟨⟨_, hx1⟩ * algebraMap R _ e2, algebraMap R _ e1 * ⟨_, hx2⟩,
      hmul _ _ (hQe e1 he1) hx2Q, ?_⟩
    show algebraMap R L e1 * (algebraMap R L e2 * s) * c =
      algebraMap R L e1 * c * algebraMap R L e2 * s
    ring

theorem wcpa_dj_llsm_smst_local_transfer : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (L : Type u) [Field L] (wL : ↥W →+* L) (R R' : Type u) [CommRing R] [CommRing R']
    [Algebra R L] [Algebra R' L] (N : Ideal R) (N' : Ideal R'),
    Function.Injective (algebraMap R L) → Function.Injective (algebraMap R' L) →
    N.IsMaximal → N'.IsMaximal →
    (∀ r : R, ∃ p q : R', q ∉ N' ∧ algebraMap R' L q * algebraMap R L r = algebraMap R' L p) →
    (∀ r ∈ N, ∃ p q : R', q ∉ N' ∧ p ∈ N' ∧
      algebraMap R' L q * algebraMap R L r = algebraMap R' L p) →
    (∀ x q : R', q ∉ N' → ∃ g : Polynomial R, g.leadingCoeff ∉ N ∧
      Polynomial.eval₂ (algebraMap R L) (algebraMap R' L x / algebraMap R' L q) g = 0) →
    (∀ w ∈ IsLocalRing.maximalIdeal ↥W, wL w ∈ integralClosure R L) →
    (∀ w ∈ IsLocalRing.maximalIdeal ↥W, wL w ∈ integralClosure R' L) →
    ((∀ (Q : Ideal ↥(integralClosure R L)) [Q.IsPrime],
        Q.comap (algebraMap R ↥(integralClosure R L)) = N → ¬ wcpaDjLkBad (wcLlsFS W wL R Q)) ↔
      (∀ (Q' : Ideal ↥(integralClosure R' L)) [Q'.IsPrime],
        Q'.comap (algebraMap R' ↥(integralClosure R' L)) = N' →
          ¬ wcpaDjLkBad (wcLlsFS W wL R' Q'))) :=
by
  intro Ω _ W L _ wL R R' _ _ _ _ N N' injA injB hNmax hN'max H1 Hdom H2 hwA hwB
  have hN'p : N'.IsPrime := hN'max.isPrime
  have hNp : N.IsPrime := hNmax.isPrime
  have h1N' : (1 : R') ∉ N' := fun h => hN'max.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have hK1 := wcpa_dj_llsm_smst_lt_clear_fwd L R R' N' hN'p H1
  have hH2₁ : ∀ x : R', ∃ g : Polynomial R, g.leadingCoeff ∉ N ∧
      Polynomial.eval₂ (algebraMap R L) (algebraMap R' L x) g = 0 := by
    intro x
    obtain ⟨g, hg1, hg2⟩ := H2 x 1 h1N'
    refine ⟨g, hg1, ?_⟩
    rw [map_one, div_one] at hg2
    exact hg2
  have hK2 := wcpa_dj_llsm_smst_lt_clear_bwd L R R' N hNp hH2₁

  have hK3 : ∀ r : R, r ∉ N → ∃ p q : R', q ∉ N' ∧ p ∉ N' ∧
      algebraMap R' L q * algebraMap R L r = algebraMap R' L p := by
    let I : Ideal R :=
      { carrier := {r | ∃ p q : R', q ∉ N' ∧ p ∈ N' ∧
          algebraMap R' L q * algebraMap R L r = algebraMap R' L p}
        add_mem' := fun {x y} hx hy => by
          obtain ⟨p₁, q₁, hq₁, hp₁, h₁⟩ := hx
          obtain ⟨p₂, q₂, hq₂, hp₂, h₂⟩ := hy
          refine ⟨q₂ * p₁ + q₁ * p₂, q₁ * q₂, fun hm => (hN'p.mem_or_mem hm).elim hq₁ hq₂,
            add_mem (Ideal.mul_mem_left _ _ hp₁) (Ideal.mul_mem_left _ _ hp₂), ?_⟩
          rw [map_add, map_add, map_mul, map_mul, map_mul, ← h₁, ← h₂]; ring
        zero_mem' := ⟨0, 1, h1N', N'.zero_mem, by simp⟩
        smul_mem' := fun x y hy => by
          obtain ⟨p₂, q₂, hq₂, hp₂, h₂⟩ := hy
          obtain ⟨p₁, q₁, hq₁, h₁⟩ := H1 x
          refine ⟨p₁ * p₂, q₁ * q₂, fun hm => (hN'p.mem_or_mem hm).elim hq₁ hq₂,
            Ideal.mul_mem_left _ _ hp₂, ?_⟩
          rw [smul_eq_mul, map_mul, map_mul, map_mul, ← h₁, ← h₂]; ring }
    have hNI : N ≤ I := fun r hr => Hdom r hr
    have hIt : I ≠ ⊤ := by
      intro hT
      have h1 : (1 : R) ∈ I := by rw [hT]; exact Submodule.mem_top
      obtain ⟨p, q, hq, hp, e⟩ := h1
      rw [map_one, mul_one] at e
      rw [injB e] at hq
      exact hq hp
    have hNIe : N = I := hNmax.eq_of_le hIt hNI
    intro r hr
    obtain ⟨p, q, hq, e⟩ := H1 r
    refine ⟨p, q, hq, fun hp => hr ?_, e⟩
    rw [hNIe]
    exact ⟨p, q, hq, hp, e⟩
  constructor
  · intro hA Q' _ hQ' hbad
    obtain ⟨Q, hQp, hQ, h1, h2⟩ :=
      wcpa_dj_llsm_smst_lt_match_fwd L R R' N N' hNmax Hdom hK1 hK2 hK3 Q' hQ'
    haveI := hQp
    obtain ⟨e⟩ := wcpa_dj_llsm_smst_lt_fs_equiv W L wL R R' Q Q' h1 h2 hwA hwB
    obtain ⟨hD, hBr⟩ := wcpa_dj_lr1k_llfi_ringequiv _ _ e
    apply hA Q hQ
    unfold wcpaDjLkBad at hbad ⊢
    rw [hD, hBr]
    exact hbad
  · intro hB Q _ hQ hbad
    obtain ⟨Q', hQ'p, hQ', h1, h2⟩ :=
      wcpa_dj_llsm_smst_lt_match_bwd L R R' N N' injA injB hNmax hN'max H1 H2 hK1 hK2 hK3 Q hQ
    haveI := hQ'p
    obtain ⟨e⟩ := wcpa_dj_llsm_smst_lt_fs_equiv W L wL R R' Q Q' h1 h2 hwA hwB
    obtain ⟨hD, hBr⟩ := wcpa_dj_lr1k_llfi_ringequiv _ _ e
    apply hB Q' hQ'
    unfold wcpaDjLkBad at hbad ⊢
    rw [← hD, ← hBr]
    exact hbad

theorem wcpa_dj_llsm_sm_sep_transfer : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M L : Type u) [Field M] [Field L] [Algebra K M] [Algebra M L]
    [Algebra K L] [Algebra A M] [Algebra A L] [IsScalarTower A K M] [IsScalarTower K M L]
    [IsScalarTower A K L] [IsScalarTower A M L] [FiniteDimensional K L] [IsGalois K L]
    [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    (𝔭 : Ideal A) (t : A) (h : A) (𝔮 : Ideal B) (t' : B),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    ∀ c b c₃ b₃ : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W →
      b ≠ 0 → c₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ≠ 0 →
      wcLlsSmPre W A B 𝔮 t t' c b c₃ b₃ →
      (wcLlsDiscSep W A K L t c b ↔ wcLlsDiscSep W B M L t' c₃ b₃) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M L _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ B _ _ _ _ _ _ _ _
    𝔭 t h 𝔮 t' hPD hSmc c b c₃ b₃ hc hb hb0 hc₃ hb₃ hb₃0 hPre
  classical
  obtain ⟨⟨p, q, hqN, hpN, hpq⟩, hb'⟩ := wcpa_dj_llsm_smst_node_integrality Ω W hW hWt A K M B
    𝔭 t h 𝔮 t' hPD hSmc c b c₃ b₃ hc hb hb0 hc₃ hb₃ hb₃0 hPre
  obtain ⟨-, -, -, h𝔭max, hm𝔭, ht𝔭, h𝔭eq, -⟩ := hPD
  obtain ⟨-, -, hPDB, h𝔮c, -⟩ := hSmc
  obtain ⟨-, -, -, h𝔮max, hm𝔮, -, h𝔮eq, -⟩ := hPDB
  have tAL : ∀ a : A, algebraMap K L (algebraMap A K a) =
      algebraMap M L (algebraMap B M (algebraMap A B a)) := by
    intro a
    rw [← IsScalarTower.algebraMap_apply A K L, ← IsScalarTower.algebraMap_apply A B M,
      ← IsScalarTower.algebraMap_apply A M L]
  have tWB : ∀ w : ↥W, algebraMap ↥W B w = algebraMap A B (algebraMap ↥W A w) := fun w =>
    IsScalarTower.algebraMap_apply ↥W A B w
  have tKL : ∀ x : K, algebraMap K L x = algebraMap M L (algebraMap K M x) := fun x =>
    IsScalarTower.algebraMap_apply K M L x
  have nodeMax : ∀ (D : Type u) [CommRing D] (P : Ideal D), P.IsMaximal →
      ∀ (T : Type u) [CommRing T] [Algebra D T] (s : T) (N : Ideal ↥(Algebra.adjoin D {s})),
      (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin D {s})) ∈ N →
      P ≤ N.comap (algebraMap D ↥(Algebra.adjoin D {s})) → N ≠ ⊤ → N.IsMaximal := by
    intro D _ P hP T _ _ s N hsN hPN hNt
    have span : ∀ (x : T) (hx : x ∈ Algebra.adjoin D {s}), ∃ a : D,
        (⟨x, hx⟩ : ↥(Algebra.adjoin D {s})) - algebraMap D ↥(Algebra.adjoin D {s}) a ∈ N := by
      intro x hx
      induction hx using Algebra.adjoin_induction with
      | mem x hx =>
        refine ⟨0, ?_⟩
        rw [map_zero, sub_zero]
        have e : (⟨x, Algebra.subset_adjoin hx⟩ : ↥(Algebra.adjoin D {s})) =
            ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ := Subtype.ext hx
        rw [e]; exact hsN
      | algebraMap d =>
        refine ⟨d, ?_⟩
        convert N.zero_mem using 1
        exact sub_eq_zero.mpr (Subtype.ext rfl)
      | add x y hx hy ihx ihy =>
        obtain ⟨a, ha⟩ := ihx
        obtain ⟨a', ha'⟩ := ihy
        refine ⟨a + a', ?_⟩
        have e : (⟨x + y, add_mem hx hy⟩ : ↥(Algebra.adjoin D {s})) -
            algebraMap D ↥(Algebra.adjoin D {s}) (a + a') =
            ((⟨x, hx⟩ : ↥(Algebra.adjoin D {s})) - algebraMap D ↥(Algebra.adjoin D {s}) a) +
            ((⟨y, hy⟩ : ↥(Algebra.adjoin D {s})) - algebraMap D ↥(Algebra.adjoin D {s}) a') := by
          have e1 : (⟨x + y, add_mem hx hy⟩ : ↥(Algebra.adjoin D {s})) =
              (⟨x, hx⟩ : ↥(Algebra.adjoin D {s})) + ⟨y, hy⟩ := rfl
          rw [e1, map_add]; ring
        rw [e]; exact add_mem ha ha'
      | mul x y hx hy ihx ihy =>
        obtain ⟨a, ha⟩ := ihx
        obtain ⟨a', ha'⟩ := ihy
        refine ⟨a * a', ?_⟩
        have e : (⟨x * y, mul_mem hx hy⟩ : ↥(Algebra.adjoin D {s})) -
