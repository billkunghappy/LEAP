      (∀ (a : C ≅ C) (h : a.hom ≫ γ = γ), (a.hom.appLE ((γ ≫ ιY) ⁻¹ᵁ U) ((γ ≫ ιY) ⁻¹ᵁ U)
        (by rw [← Scheme.Hom.comp_preimage, ← Category.assoc, h])).hom s = s) →
      ∃ r : Γ(Y, U), ((γ ≫ ιY).app U).hom r = s := by
