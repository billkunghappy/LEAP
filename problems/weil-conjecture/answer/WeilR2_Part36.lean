          obtain ⟨a, ha⟩ := ihx
          obtain ⟨a', ha'⟩ := ihy
          refine ⟨a * a', ?_⟩
          have e1 : (⟨x * y, mul_mem hx hy⟩ : ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t))) -
              algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) (a * a') =
              ((⟨x, hx⟩ : ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t))) -
                algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) a) * ⟨y, hy⟩ +
              algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) a *
                ((⟨y, hy⟩ : ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t))) -
                  algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) a') := by
            apply Subtype.ext
            show x * y - algebraMap A K (a * a') =
              (x - algebraMap A K a) * y + algebraMap A K a * (y - algebraMap A K a')
            rw [map_mul]
            ring
          rw [e1]
          exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_left _ _ ha')
      have hres : ∀ x : ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)), x ∉ wcLlsASmN W A K u₁ β₁ (β₁ * t) →
          ∃ y : ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)),
            x * y - 1 ∈ wcLlsASmN W A K u₁ β₁ (β₁ * t) := by
        intro x hx
        obtain ⟨a, ha⟩ := hcong x
        have ha𝔭 : a ∉ 𝔭 := by
          intro ha𝔭
          apply hx
          have h1 : algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) a ∈
              wcLlsASmN W A K u₁ β₁ (β₁ * t) :=
            hover (Ideal.mem_map_of_mem _ ha𝔭)
          have h2 := Ideal.add_mem _ ha h1
          rwa [sub_add_cancel] at h2
        obtain ⟨y₀, i, hi, hyi⟩ := hmax.exists_inv ha𝔭
        refine ⟨algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) y₀, ?_⟩
        have h2 : algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) y₀ *
            algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) a +
            algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) i = 1 := by
          rw [← map_mul, ← map_add, hyi, map_one]
        have e1 : x * algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) y₀ - 1 =
            (x - algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) a) *
              algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) y₀ -
            algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) i := by
          linear_combination h2
        rw [e1]
        exact Ideal.sub_mem _ (Ideal.mul_mem_right _ _ ha) (hover (Ideal.mem_map_of_mem _ hi))
