    exact int_trans _ _ _ ψ f.kerLift hψfin.to_isIntegral (ρ c) h1

theorem wcpa_dj_lr1k_nsr_gub_itmp_si_md_amp : ∀ (T F V Ch : Type u) [CommRing T] [IsDomain T] [IsIntegrallyClosed T] [CommRing F] [IsDomain F] [CommRing V] [IsDomain V] [CommRing Ch] [IsAlgClosed (FractionRing V)] (p : T) (π : V) (pC : Ch), π ≠ 0 → (∀ v : V, v ≠ 0 → ∃ n : ℕ, v ∣ π ^ n) → (∀ (t : T) (k : ℕ), (¬ ∃ y : T, t = p ^ k * y) → ∃ ev : T →+* V, Function.Surjective ev ∧ ev p = π ∧ ¬ ∃ v : V, ev t = π ^ k * v) → ∀ (lam : T →+* F) (ρ : Ch →+* F), Function.Injective lam → IsUnit (lam p) → ρ pC = lam p → (∀ t : T, ∃ c : Ch, ρ c = lam t) → (∀ c : Ch, lam.IsIntegralElem (ρ c)) → (∀ f : F, ∃ (n : ℕ) (c : Ch), lam p ^ n * f = ρ c) → ∀ xb : F, ¬ ρ.IsIntegralElem xb → ∃ g : F →+* FractionRing V, Function.Surjective g ∧ (∀ v : V, ∃ c : Ch, g (ρ c) = algebraMap V (FractionRing V) v) ∧ g (ρ pC) = algebraMap V (FractionRing V) π ∧ g xb ∉ Set.range (algebraMap V (FractionRing V)) :=
by

  have s1 : ∀ (T F Ch : Type u) [CommRing T] [IsDomain T] [CommRing F] [IsDomain F] [CommRing Ch]
      (p : T) (lam : T →+* F) (ρ : Ch →+* F), Function.Injective lam → IsUnit (lam p) →
      (∀ c : Ch, lam.IsIntegralElem (ρ c)) → (∀ f : F, ∃ (n : ℕ) (c : Ch), lam p ^ n * f = ρ c) →
