    ext w
    rw [RingHom.comp_apply, RingHom.comp_apply, ValuationSubring.algebraMap_apply, hc]
  have hjA : ∀ B : Polynomial W, algebraMap C D (Polynomial.aeval τ B) =
      Polynomial.aeval (algebraMap C D τ) (B.map (algebraMap W Ω)) := by
    intro B
    rw [Polynomial.aeval_def, Polynomial.aeval_def, Polynomial.hom_eval₂, Polynomial.eval₂_map,
      hcomp]
