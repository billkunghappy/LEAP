      obtain ⟨c, hc⟩ := hy
      have h1 : y - ((uX.appLE ⊤ V hle).hom.comp (Scheme.ΓSpecIso (.of ↥W)).inv.hom) c *
          ((uX.appLE ⊤ V hle).hom.comp (Scheme.ΓSpecIso (.of ↥W)).inv.hom) b ∈
