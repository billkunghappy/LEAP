  have Hlt : ∀ (ψ : C.functionField →+* C.functionField) (z : C.functionField),
      (A.comap ψ).valuation z < 1 ↔ A.valuation (ψ z) < 1 := by
    intro ψ z
    by_cases hz : z = 0
    · subst hz; simp
