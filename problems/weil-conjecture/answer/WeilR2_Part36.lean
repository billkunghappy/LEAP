theorem wcpa_dj_lr1k_ll_db_components_minimal_primes : ∀ (Z : Scheme.{u}) (z : ↥Z) (k : ℕ)
    (E : Fin k → Set ↥Z), Function.Injective E → (∀ i, E i ∈ irreducibleComponents ↥Z) →
    (∀ i, z ∈ E i) →
    ∃ P : Fin k → Ideal ↥(Z.presheaf.stalk z), Function.Injective P ∧
      ∀ i, P i ∈ minimalPrimes ↥(Z.presheaf.stalk z) :=
by
  intro Z z k E hEinj hE hz
  classical
  have hmax : ∀ i, Maximal IsIrreducible (E i) := fun i => hE i
  have hcl : ∀ i, IsClosed (E i) := fun i => isClosed_of_mem_irreducibleComponents (E i) (hE i)
  have hgen : ∀ i, IsGenericPoint ((hmax i).prop.genericPoint) (E i) := fun i =>
    (hmax i).prop.isGenericPoint_genericPoint (hcl i)
  have hemb : Topology.IsEmbedding ⇑(Z.fromSpecStalk z) := Scheme.Hom.isEmbedding _
  have hrange : ∀ i, ∃ p : PrimeSpectrum ↥(Z.presheaf.stalk z),
      Z.fromSpecStalk z p = (hmax i).prop.genericPoint := by
    intro i
    have h1 : (hmax i).prop.genericPoint ⤳ z := (hgen i).specializes (hz i)
    have h2 : (hmax i).prop.genericPoint ∈ Set.range ⇑(Z.fromSpecStalk z) := by
      rw [Scheme.range_fromSpecStalk]; exact h1
    obtain ⟨p, hp⟩ := h2
    exact ⟨p, hp⟩
  choose p hp using hrange
  refine ⟨fun i => (p i).asIdeal, ?_, ?_⟩
  · intro i j hij
    have hpij : p i = p j := PrimeSpectrum.ext hij
    apply hEinj
    rw [← (hgen i).def, ← (hgen j).def, ← hp i, ← hp j, hpij]
  · intro i
    rw [minimalPrimes_eq_minimals]
    refine ⟨(p i).isPrime, ?_⟩
    intro J hJ hJle
    let q : PrimeSpectrum ↥(Z.presheaf.stalk z) := ⟨J, hJ⟩
    have hqle : q ≤ p i := hJle
    have h1 : q ⤳ p i := (PrimeSpectrum.le_iff_specializes q (p i)).mp hqle
    have h2 : Z.fromSpecStalk z q ⤳ (hmax i).prop.genericPoint := by
      rw [← hp i]; exact h1.map (Z.fromSpecStalk z).continuous
