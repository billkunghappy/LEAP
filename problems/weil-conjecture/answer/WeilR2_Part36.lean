theorem wcpa_dj_lr1k_nsr_eb_bc_ker_minimal : ∀ (F : Scheme.{u}) (w : F) (q : PrimeSpectrum ↥(F.presheaf.stalk w)), closure {F.fromSpecStalk w q} ∈ irreducibleComponents F → q.asIdeal ∈ minimalPrimes ↥(F.presheaf.stalk w) :=
by
  intro F w q hC
  have hC' : Maximal IsIrreducible (closure {F.fromSpecStalk w q}) := hC
  rw [minimalPrimes_eq_minimals]
  show Minimal Ideal.IsPrime q.asIdeal
  refine ⟨q.isPrime, ?_⟩
  intro Q hQ hle
  let Q' : PrimeSpectrum ↥(F.presheaf.stalk w) := ⟨Q, hQ⟩
  have hsp : Q' ⤳ q := (PrimeSpectrum.le_iff_specializes Q' q).mp hle
  have h3 : F.fromSpecStalk w Q' ⤳ F.fromSpecStalk w q :=
    hsp.map (F.fromSpecStalk w).continuous
  have h4 : closure {F.fromSpecStalk w q} ⊆ closure {F.fromSpecStalk w Q'} :=
    specializes_iff_closure_subset.mp h3
  have h5 : closure {F.fromSpecStalk w q} = closure {F.fromSpecStalk w Q'} :=
    Maximal.eq_of_le hC' isIrreducible_singleton.closure h4
  have h6 : F.fromSpecStalk w Q' = F.fromSpecStalk w q :=
    (inseparable_iff_closure_eq.mpr h5.symm).eq
  have h7 : Q' = q := (Scheme.Hom.isEmbedding (F.fromSpecStalk w)).injective h6
  have h8 : Q = q.asIdeal := congrArg PrimeSpectrum.asIdeal h7
  exact h8.ge

theorem wcpa_dj_lr1k_nsr_eb_bc_frac_extend : ∀ (R : Type u) [CommRing R] (κ : Type v) [Field κ] (ρ : R →+* κ), RingHom.ker ρ ∈ minimalPrimes R → ∀ V : ValuationSubring κ, (∀ r : R, ρ r ∈ V) → ∃ ψ : FractionRing R →+* κ, ψ.comp (algebraMap R (FractionRing R)) = ρ ∧ ∀ y : FractionRing R, IsIntegral R y → ψ y ∈ V :=
by
  intro R _ κ _ ρ hmin V hV
  have hunit : ∀ y : nonZeroDivisors R, IsUnit (ρ y) := fun y =>
    IsUnit.mk0 _ (fun h => Set.disjoint_left.mp
      (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes hmin)
      (RingHom.mem_ker.mpr h) y.2)
  let ψ : FractionRing R →+* κ :=
    IsLocalization.lift (M := nonZeroDivisors R) (S := FractionRing R) hunit
  have hψ : ψ.comp (algebraMap R (FractionRing R)) = ρ := IsLocalization.lift_comp hunit
  refine ⟨ψ, hψ, fun y hy => ?_⟩
  have hc : (algebraMap V κ).comp (ρ.codRestrict V hV) =
      ψ.comp (algebraMap R (FractionRing R)) := by
    rw [hψ]
    ext r
    rfl
  obtain ⟨v, hv⟩ := IsIntegrallyClosed.isIntegral_iff.mp
    (IsIntegral.map_of_comp_eq (ρ.codRestrict V hV) ψ hc hy)
  rw [← hv, ValuationSubring.algebraMap_apply]
  exact v.2

theorem wcpa_dj_lr1k_nsr_eb_bc_branch_ideal : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (κ : Type v) [Field κ] (ψ : FractionRing R →+* κ) (V : ValuationSubring κ), (∀ y : FractionRing R, IsIntegral R y → ψ y ∈ V) → (∀ r ∈ IsLocalRing.maximalIdeal R, V.valuation (ψ (algebraMap R (FractionRing R) r)) < 1) → ∃ M : Ideal ↥(integralClosure R (FractionRing R)), M.IsMaximal ∧ ∀ y : ↥(integralClosure R (FractionRing R)), y ∈ M ↔ V.valuation (ψ y) < 1 :=
by
  intro R _ _ κ _ ψ V hint hmax
  set S := integralClosure R (FractionRing R) with hS
  let φ : ↥S →+* ↥V :=
    { toFun := fun y => ⟨ψ (y : FractionRing R), hint _ y.2⟩
      map_one' := Subtype.ext (by simp)
      map_mul' := fun a b => Subtype.ext (by simp)
      map_zero' := Subtype.ext (by simp)
      map_add' := fun a b => Subtype.ext (by simp) }
  have hφ : ∀ y : ↥S, ((φ y : ↥V) : κ) = ψ (y : FractionRing R) := fun y => rfl
  let M : Ideal ↥S := Ideal.comap φ (IsLocalRing.maximalIdeal ↥V)
  have hM : ∀ y : ↥S, y ∈ M ↔ V.valuation (ψ (y : FractionRing R)) < 1 := by
    intro y
    rw [Ideal.mem_comap, ValuationSubring.valuation_lt_one_iff, hφ]
  have hMp : M.IsPrime := Ideal.comap_isPrime φ (IsLocalRing.maximalIdeal ↥V)
  have hN : Ideal.comap (algebraMap R ↥S) M = IsLocalRing.maximalIdeal R := by
    have hle : IsLocalRing.maximalIdeal R ≤ Ideal.comap (algebraMap R ↥S) M := by
      intro r hr
      rw [Ideal.mem_comap, hM]
      exact hmax r hr
    exact ((IsLocalRing.maximalIdeal.isMaximal R).eq_of_le
      (Ideal.comap_isPrime (algebraMap R ↥S) M).ne_top hle).symm
  refine ⟨M, ?_, hM⟩
  have hNm : (Ideal.comap (algebraMap R ↥S) M).IsMaximal := by
    rw [hN]
    exact IsLocalRing.maximalIdeal.isMaximal R
  exact Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap R ↥S)
    (algebraMap_isIntegral_iff.mpr inferInstance) M hNm

theorem wcpa_dj_lr1k_nsr_eb_bc_lift_integral : ∀ (R : Type u) [CommRing R] [_root_.IsReduced R] [IsNoetherianRing R] (P : Ideal R), P ∈ minimalPrimes R → ∀ (a b : R) (p : Polynomial R), b ∉ P → p.Monic → ∑ k ∈ Finset.range (p.natDegree + 1), p.coeff k * a ^ k * b ^ (p.natDegree - k) ∈ P → ∃ (c : R) (t : nonZeroDivisors R), c ∉ P ∧ (∀ Q ∈ minimalPrimes R, Q ≠ P → c ∈ Q) ∧ (t : R) - b * c ∈ P ∧ IsIntegral R (IsLocalization.mk' (FractionRing R) (a * c) t) :=
by
  intro R _ _ _ P hP a b p hb hp hH
  classical
  have hPp : P.IsPrime := Ideal.minimalPrimes_isPrime hP
  have hmin : ∀ Q : Ideal R, Q ∈ minimalPrimes R → Minimal (fun q : Ideal R => q.IsPrime ∧ ⊥ ≤ q) Q := by
    intro Q hQ
    first
      | exact hQ
      | simpa [minimalPrimes, Ideal.minimalPrimes] using hQ
  have hPm := hmin P hP
  have hfin : (minimalPrimes R).Finite := minimalPrimes.finite_of_isNoetherianRing R
  set S : Finset (Ideal R) := hfin.toFinset.erase P with hS
  have hmemS : ∀ Q, Q ∈ S ↔ Q ≠ P ∧ Q ∈ minimalPrimes R := by
    intro Q; rw [hS, Finset.mem_erase, Set.Finite.mem_toFinset]

  obtain ⟨c, hcI, hc⟩ : ∃ c ∈ S.inf id, c ∉ P := by
    by_contra hcon
    push_neg at hcon
    obtain ⟨Q, hQS, hQP⟩ := (hPp.inf_le' (s := S) (f := id)).mp (fun x hx => hcon x hx)
    obtain ⟨hQne, hQmin⟩ := (hmemS Q).mp hQS
    exact hQne (Minimal.eq_of_le hPm ⟨Ideal.minimalPrimes_isPrime hQmin, bot_le⟩ hQP)
  have hcQ : ∀ Q ∈ minimalPrimes R, Q ≠ P → c ∈ Q := by
    intro Q hQ hne
    exact Finset.inf_le (f := id) ((hmemS Q).mpr ⟨hne, hQ⟩) hcI

  obtain ⟨d, hd, hdQ⟩ : ∃ d ∈ P, ∀ Q ∈ minimalPrimes R, Q ≠ P → d ∉ Q := by
    by_contra hcon
    push_neg at hcon
    have hsub : (P : Set R) ⊆ ⋃ i ∈ (S : Set (Ideal R)), ((id i : Ideal R) : Set R) := by
      intro x hx
      obtain ⟨Q, hQ, hne, hxQ⟩ := hcon x hx
      exact Set.mem_biUnion (x := Q) (by simpa using (hmemS Q).mpr ⟨hne, hQ⟩) hxQ
    obtain ⟨Q, hQS, hPQ⟩ := (Ideal.subset_union_prime (s := S) (f := id) P P
      (fun i hi _ _ => Ideal.minimalPrimes_isPrime ((hmemS i).mp hi).2)).mp hsub
    obtain ⟨hQne, hQmin⟩ := (hmemS Q).mp hQS
    exact hQne (Minimal.eq_of_le (hmin Q hQmin) ⟨hPp, bot_le⟩ hPQ).symm

  have hvan : ∀ u : R, (∀ Q ∈ minimalPrimes R, u ∈ Q) → u = 0 := by
    intro u hu
    have h1 : u ∈ sInf (minimalPrimes R) := Ideal.mem_sInf.mpr (fun {Q} hQ => hu Q hQ)
    have h2 : u ∈ (⊥ : Ideal R).radical := by
      rw [← Ideal.sInf_minimalPrimes]; exact h1
    obtain ⟨n, hn⟩ := h2
    exact IsNilpotent.eq_zero ⟨n, by simpa using hn⟩
  set t₀ : R := b * c + d with ht₀def
  have ht₀Q : ∀ Q ∈ minimalPrimes R, t₀ ∉ Q := by
    intro Q hQ htQ
    by_cases hQP : Q = P
    · subst hQP
      have hbc : b * c ∈ Q := by
        have := Q.sub_mem htQ hd
        simpa [ht₀def] using this
      rcases hPp.mem_or_mem hbc with h | h
      · exact hb h
      · exact hc h
    · have hbc : b * c ∈ Q := Q.mul_mem_left b (hcQ Q hQ hQP)
      have := Q.sub_mem htQ hbc
      exact hdQ Q hQ hQP (by simpa [ht₀def] using this)
  have hkey : ∀ u : R, u * t₀ = 0 → u = 0 := by
    intro u hu
    apply hvan
    intro Q hQ
    have h0 : u * t₀ ∈ Q := by rw [hu]; exact Q.zero_mem
    rcases (Ideal.minimalPrimes_isPrime hQ).mem_or_mem h0 with h | h
    · exact h
    · exact absurd h (ht₀Q Q hQ)
  have ht₀nzd : t₀ ∈ nonZeroDivisors R := by
    rw [mem_nonZeroDivisors_iff]
    first
      | exact hkey
      | exact ⟨hkey, fun u hu => hkey u (by rw [mul_comm]; exact hu)⟩
      | exact ⟨fun u hu => hkey u (by rw [mul_comm]; exact hu), hkey⟩
  set t : nonZeroDivisors R := ⟨t₀, ht₀nzd⟩ with htdef
  set n := p.natDegree with hn
  set N₀ : R := ∑ k ∈ Finset.range (n + 1), p.coeff k * (a * c) ^ k * t₀ ^ (n - k) with hN₀
  have hN : N₀ ∈ P := by
    rw [← Ideal.Quotient.eq_zero_iff_mem] at hH ⊢
    have ht : Ideal.Quotient.mk P t₀ = Ideal.Quotient.mk P b * Ideal.Quotient.mk P c := by
      rw [← map_mul, Ideal.Quotient.eq]
      simpa [ht₀def] using hd
    have hrel : Ideal.Quotient.mk P N₀ = Ideal.Quotient.mk P c ^ n *
        Ideal.Quotient.mk P (∑ k ∈ Finset.range (n + 1), p.coeff k * a ^ k * b ^ (n - k)) := by
      rw [hN₀, map_sum, map_sum, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k hk
      have hk' : k ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
      simp only [map_mul, map_pow, ht]
      rw [← pow_mul_pow_sub (Ideal.Quotient.mk P c) hk']
      ring
    rw [hrel, hH, mul_zero]
  have hacN : a * c * N₀ = 0 := by
    apply hvan
    intro Q hQ
    by_cases hQP : Q = P
    · subst hQP; exact Q.mul_mem_left _ hN
    · exact Q.mul_mem_right _ (Q.mul_mem_left a (hcQ Q hQ hQP))
  refine ⟨c, t, hc, hcQ, ?_, ?_⟩
  · show t₀ - b * c ∈ P
    simpa [ht₀def] using hd
  · set K := FractionRing R
    set z : K := IsLocalization.mk' K (a * c) t with hz
    have hspec : z * algebraMap R K t₀ = algebraMap R K (a * c) := IsLocalization.mk'_spec K (a * c) t
    have hc1 : (algebraMap R K t₀) ^ n * Polynomial.aeval z p = algebraMap R K N₀ := by
      rw [Polynomial.aeval_eq_sum_range, Finset.mul_sum, hN₀, map_sum]
      apply Finset.sum_congr rfl
      intro k hk
      have hk' : k ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
