        ValuationSubring.mem_comap, map_inv₀]

  obtain ⟨hγ, g', hg'1, -, hg'3⟩ := hF
  have hgen : genericPoint C ⤳ g.inv (genericPoint C) :=
    (genericPoint_spec C).specializes trivial
  have hginv : g.hom (g.inv (genericPoint C)) = genericPoint C := by
    have e : g.inv ≫ g.hom = 𝟙 C := Iso.inv_hom_id (g : C ≅ C)
    rw [← Scheme.Hom.comp_apply, e]
    rfl
  have h₀ : g.hom (genericPoint C) ⤳ genericPoint C := by
    have := hgen.map g.hom.continuous
    rw [hginv] at this
    exact this
  obtain ⟨ψ, hψ⟩ : ∃ ψ : C.functionField →+* C.functionField,
      ψ = (wcLr1uGerm g.hom (genericPoint C) h₀).hom := ⟨_, rfl⟩

  have Htr : ∀ {Y : Scheme.{u}} (h : C ⟶ Y) (y : Y)
      (β : Y.presheaf.stalk y →+* Y.presheaf.stalk y), IsLocalHom β →
      (∀ (hy : h (genericPoint C) ⤳ y) (s : Y.presheaf.stalk y),
        ψ ((wcLr1uGerm h y hy).hom s) = (wcLr1uGerm h y hy).hom (β s)) →
      wcNsrNaDom A h y → wcNsrNaDom (A.comap ψ) h y := by
    intro Y h y β hβl Hβ hd
