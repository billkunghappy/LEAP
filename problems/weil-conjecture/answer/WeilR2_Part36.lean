      · exact Or.inl h
      · refine Or.inr (hδ'min _ (Finset.mem_insert_of_mem (Finset.mem_filter.mpr ⟨?_, h⟩)))
        exact List.mem_toFinset.mpr (List.mem_map.mpr ⟨i, hi, rfl⟩)
    · by_contra hle
      rw [not_lt] at hle
      rcases hcases with h | ⟨hmem, hlt⟩
