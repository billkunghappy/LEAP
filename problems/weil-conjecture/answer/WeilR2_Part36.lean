  refine ⟨?_, ?_⟩
  · have hcl : IsClosed ((fun t : ↥(⇑(wcUePi γ ι ι₁ r₁ hι) ⁻¹' {wcNdPt W (γ ≫ ι) uX y₀}) =>
        (γ ≫ ι₁).fromNormalization t.1) ⁻¹' (O : Set X₁)ᶜ) :=
      hO.isClosed_compl.preimage
        ((γ ≫ ι₁).fromNormalization.continuous.comp continuous_subtype_val)
    convert hcl using 1
    ext t
    exact not_congr (hSmIff t)

  intro t ht
  obtain ⟨Z, hZ, htZ⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible {t}
    isIrreducible_singleton
  refine ⟨Z, ⟨hZ, htZ rfl⟩, ?_⟩
  rintro Z' ⟨hZ', htZ'⟩
  by_contra hne

  have key : ∀ Z₀ ∈ irreducibleComponents
      ↥(⇑(wcUePi γ ι ι₁ r₁ hι) ⁻¹' {wcNdPt W (γ ≫ ι) uX y₀}),
      ∃ ζ, wcUePi γ ι ι₁ r₁ hι ζ = wcNdPt W (γ ≫ ι) uX y₀ ∧ Z₀ = {s | ζ ⤳ s.1} := by
    intro Z₀ hZ₀
    have hZirr : IsIrreducible Z₀ := hZ₀.prop
    have hI : IsIrreducible (Subtype.val '' Z₀) :=
      hZirr.image _ continuous_subtype_val.continuousOn
    obtain ⟨ζ, hgen⟩ := QuasiSober.sober hI.closure isClosed_closure
    have hspec : ∀ s ∈ Z₀, ζ ⤳ s.1 := fun s hs => hgen.specializes (subset_closure ⟨s, hs, rfl⟩)
    obtain ⟨s₀, hs₀⟩ := hZirr.nonempty
    have h1 : wcUePi γ ι ι₁ r₁ hι ζ ⤳ wcNdPt W (γ ≫ ι) uX y₀ := by
      have := (hspec s₀ hs₀).map (wcUePi γ ι ι₁ r₁ hι).continuous
      rwa [show wcUePi γ ι ι₁ r₁ hι s₀.1 = wcNdPt W (γ ≫ ι) uX y₀ from s₀.2] at this
    have h2 : wcNdPt W (γ ≫ ι) uX y₀ ⤳ wcUePi γ ι ι₁ r₁ hι ζ := by
      rw [specializes_iff_mem_closure]
      apply map_mem_closure (wcUePi γ ι ι₁ r₁ hι).continuous hgen.mem
      rintro _ ⟨s, _, rfl⟩
      exact s.2
    have hpζ : wcUePi γ ι ι₁ r₁ hι ζ = wcNdPt W (γ ≫ ι) uX y₀ := (h1.antisymm h2).eq
    refine ⟨ζ, hpζ, ?_⟩
    let ζ' : ↥(⇑(wcUePi γ ι ι₁ r₁ hι) ⁻¹' {wcNdPt W (γ ≫ ι) uX y₀}) := ⟨ζ, hpζ⟩
    have hK : {s : ↥(⇑(wcUePi γ ι ι₁ r₁ hι) ⁻¹' {wcNdPt W (γ ≫ ι) uX y₀}) | ζ ⤳ s.1} =
        closure {ζ'} := by
      ext s
      rw [Set.mem_setOf_eq, ← specializes_iff_mem_closure, subtype_specializes_iff]
    refine hZ₀.eq_of_le ?_ hspec
    rw [hK]
    exact isIrreducible_singleton.closure
  obtain ⟨ζ₁, hζ₁, hZ'eq⟩ := key Z' hZ'
  obtain ⟨ζ₂, hζ₂, hZeq⟩ := key Z hZ
  have hζ₁t : ζ₁ ⤳ t.1 := by rw [hZ'eq] at htZ'; exact htZ'
  have hζ₂t : ζ₂ ⤳ t.1 := by have h := htZ rfl; rw [hZeq] at h; exact h
  have hζ₁₂ : ζ₁ ≠ ζ₂ := by
    intro h
    apply hne
    rw [hZ'eq, hZeq, h]

  have hnt : ∀ (Z₁ Z₂ : Set ↥(⇑(wcUePi γ ι ι₁ r₁ hι) ⁻¹' {wcNdPt W (γ ≫ ι) uX y₀})),
