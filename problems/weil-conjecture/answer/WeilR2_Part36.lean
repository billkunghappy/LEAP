  by_contra hcon
  push Not at hcon
  have hnd : ∀ r ∈ R, (β - r) ∣ ϖ ^ M := by
    intro r hr
    rcases ValuationRing.dvd_total (β - r) (ϖ ^ M) with h | h
    · exact h
    · exfalso
      refine hcon r ?_ h
      rw [hRe r]
      exact Multiset.prod_eq_zero (Multiset.mem_map.mpr ⟨r, hr, sub_self r⟩)
  choose! f hf using hnd
  have hprod : (R.map (fun r => β - r)).prod * (R.map f).prod = ϖ ^ (p.natDegree * M) := by
    rw [← Multiset.prod_map_mul]
