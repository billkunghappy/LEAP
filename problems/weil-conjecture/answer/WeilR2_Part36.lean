    have hq : q₁ = q₂ := congrArg Subtype.val hsp'.eq
    rw [← hq₁, ← hq₂, hq]

  have L4 : ∀ (R : CommRingCat.{u}) (X : Scheme.{u}) (U : X.Opens) (σ : Spec R ⟶ X)
      (ΔU : Spec R ⟶ U.toScheme) (T : Γ(U.toScheme, ⊤)), ΔU ≫ U.ι = σ →
      RingHom.ker ΔU.appTop.hom = Ideal.span {T} → ∀ e : ⊤ ≤ σ ⁻¹ᵁ U,
      ∃ g : Γ(X, U), (U.ι.appLE U ⊤ (Scheme.Opens.ι_preimage_self U).ge).hom g = T ∧
        RingHom.ker (((Scheme.ΓSpecIso R).hom.hom).comp (σ.appLE U ⊤ e).hom) =
          Ideal.span {g} ∧ (σ.app U).hom g = 0 := by
    intro R X U σ ΔU T hΔ hker e
    set ρ := U.ι.appLE U ⊤ (Scheme.Opens.ι_preimage_self U).ge with hρ
    have hbij : Function.Bijective ρ.hom := ConcreteCategory.bijective_of_isIso ρ
    let E := RingEquiv.ofBijective ρ.hom hbij
    have hE : ∀ y, E y = ρ.hom y := fun y => rfl
    have htop : ΔU.appLE ⊤ ⊤ (le_of_eq (Scheme.Hom.preimage_top ΔU).symm) = ΔU.appTop := by
      rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
      rfl
    have hfac : σ.appLE U ⊤ e = ρ ≫ ΔU.appTop := by
      subst hΔ
      rw [hρ, ← htop, Scheme.Hom.appLE_comp_appLE]
    have hfac' : ∀ y, (σ.appLE U ⊤ e).hom y = ΔU.appTop.hom (ρ.hom y) := by
      intro y; rw [hfac]; rfl
    have hT : ΔU.appTop.hom T = 0 := by
      have : T ∈ RingHom.ker ΔU.appTop.hom := by
        rw [hker]; exact Ideal.mem_span_singleton_self T
      exact this
    have hgT : ρ.hom (E.symm T) = T := by rw [← hE]; exact E.apply_symm_apply T
    refine ⟨E.symm T, hgT, ?_, ?_⟩
    · have hinj : Function.Injective (Scheme.ΓSpecIso R).hom.hom :=
        (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso R).hom).1
      rw [RingHom.ker_comp_of_injective _ hinj]
      ext y
      rw [RingHom.mem_ker, hfac', Ideal.mem_span_singleton']
      constructor
      · intro hy
        have hy' : ρ.hom y ∈ RingHom.ker ΔU.appTop.hom := hy
        rw [hker, Ideal.mem_span_singleton'] at hy'
        obtain ⟨c, hc⟩ := hy'
        refine ⟨E.symm c, ?_⟩
        apply E.injective
        rw [map_mul, E.apply_symm_apply, E.apply_symm_apply, hE, hc]
      · rintro ⟨c, rfl⟩
        rw [map_mul, hgT, map_mul, hT, mul_zero]
    · have h1 : (σ.appLE U ⊤ e).hom (E.symm T) = 0 := by rw [hfac', hgT, hT]
      have hap : σ.appLE U ⊤ e = σ.app U ≫ (Spec R).presheaf.map (homOfLE e).op := rfl
      rw [hap, CommRingCat.comp_apply] at h1
      have h4 := congrArg ((Spec R).presheaf.map (homOfLE (le_top : σ ⁻¹ᵁ U ≤ ⊤)).op).hom h1
      rw [map_zero, ← CommRingCat.comp_apply, ← Functor.map_comp] at h4
      have : (homOfLE e).op ≫ (homOfLE (le_top : σ ⁻¹ᵁ U ≤ ⊤)).op = 𝟙 _ :=
        Subsingleton.elim _ _
      rw [this, CategoryTheory.Functor.map_id, CommRingCat.id_apply] at h4
      exact h4

  intro Ω _ _ W hW hWt X uX ι hM p hSm σ₀ hσ hσx
  haveI : Flat uX := hM.1.1
  haveI : IsProper uX := hM.1.2.1
  haveI : LocallyOfFinitePresentation uX :=
    wcpa_dj_mn_flat_fp (Spec (.of ↥W)) X uX inferInstance inferInstance
  obtain ⟨W₁, hxW₁, hsm⟩ := wcpa_dj_bsc_smooth_descend (Spec (.of ↥W)) X uX
    (IsLocalRing.ResidueField ↥W)
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) p
    inferInstance inferInstance hSm
  obtain ⟨U, m, ΔU, hU, hm, hmC, hΔι, hΔm, hker⟩ :=
    wcpa_dj_lr1k_nsr_gcn_section_chart Ω W X uX σ₀ inferInstance hσ
