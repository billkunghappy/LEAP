    obtain ⟨r, hr⟩ :=
      wcpa_dj_lr1k_llfi_generic_integral Ω W hW hWt X uX ι hXint hXnorm hpb U hU t htint
    refine ⟨r, ?_⟩
    rw [Scheme.Hom.comp_app]
    show (γ.app (ι ⁻¹ᵁ U)).hom ((ι.app U).hom r) = s
    rw [hr, ht]
  have hmove : ∀ z z' : ↥(γ ≫ ι).normalization,
      (γ ≫ ι).fromNormalization z = (γ ≫ ι).fromNormalization z' →
      ∃ (g : C ≅ C) (Ψ : (γ ≫ ι).normalization ⟶ (γ ≫ ι).normalization),
        g.hom ≫ γ = γ ∧ (γ ≫ ι).toNormalization ≫ Ψ = g.hom ≫ (γ ≫ ι).toNormalization ∧
        Ψ z = z' := by
    intro z z' hzz
    have hG := hGfin

    have s1 : ∀ (A B G : Type u) [CommRing A] [CommRing B] [Group G] [Finite G] (φ : A →+* B)
        (ψ : G → B →+* B), (∀ b, ψ 1 b = b) → (∀ g h b, ψ (g * h) b = ψ h (ψ g b)) →
        (∀ g a, ψ g (φ a) = φ a) → (∀ b, (∀ g, ψ g b = b) → ∃ a, φ a = b) →
        ∀ P P' : Ideal B, P.IsPrime → P'.IsPrime → P.comap φ = P'.comap φ →
        ∃ g, P' = P.comap (ψ g) := by
      intro A B G _ _ _ _ φ ψ h1 h2 h3 h4 P P' hP hP' hc
      letI : Algebra A B := φ.toAlgebra
      letI : MulSemiringAction G B :=
        { smul := fun g b => ψ g⁻¹ b
          one_smul := fun b => by show ψ 1⁻¹ b = b; rw [inv_one, h1]
          mul_smul := fun g h b => by
            show ψ (g * h)⁻¹ b = ψ g⁻¹ (ψ h⁻¹ b); rw [mul_inv_rev, h2]
          smul_zero := fun g => map_zero (ψ g⁻¹)
          smul_add := fun g x y => map_add (ψ g⁻¹) x y
          smul_one := fun g => map_one (ψ g⁻¹)
          smul_mul := fun g x y => map_mul (ψ g⁻¹) x y }
      haveI : SMulCommClass G A B := ⟨fun g a b => by
        show ψ g⁻¹ (φ a * b) = φ a * ψ g⁻¹ b
        rw [map_mul, h3]⟩
      haveI : Algebra.IsInvariant A B G := ⟨fun b hb => by
        obtain ⟨a, ha⟩ := h4 b (fun g => by
          have := hb g⁻¹
          change ψ g⁻¹⁻¹ b = b at this
          rwa [inv_inv] at this)
        exact ⟨a, ha⟩⟩
      obtain ⟨g, hg⟩ := Algebra.IsInvariant.exists_smul_of_under_eq A B G P P' (by
        rw [Ideal.under_def, Ideal.under_def]; exact hc)
      refine ⟨g, ?_⟩
      rw [hg]
      ext x
      rw [Ideal.mem_pointwise_smul_iff_inv_smul_mem, Ideal.mem_comap]
      change ψ g⁻¹⁻¹ x ∈ P ↔ _
      rw [inv_inv]

    have hcongr : ∀ {A B : Scheme.{u}} (φ φ' : A ⟶ B) (U : B.Opens) (V : A.Opens)
        (e : V ≤ φ ⁻¹ᵁ U) (e' : V ≤ φ' ⁻¹ᵁ U), φ = φ' → φ.appLE U V e = φ'.appLE U V e' := by
      intro A B φ φ' U V e e' h
      subst h
      rfl
    have hid : ∀ (V : ((γ ≫ ι).normalization).Opens)
        (h : V ≤ (𝟙 (γ ≫ ι).normalization : (γ ≫ ι).normalization ⟶ _) ⁻¹ᵁ V)
        (b : Γ((γ ≫ ι).normalization, V)),
        (Scheme.Hom.appLE (𝟙 (γ ≫ ι).normalization) V V h).hom b = b := by
      intro V h b
      rw [Scheme.Hom.appLE, Scheme.Hom.id_app]
      change (((γ ≫ ι).normalization).presheaf.map (𝟙 (Opposite.op V))).hom b = b
      rw [((γ ≫ ι).normalization).presheaf.map_id]
      rfl
    have hgen : ∀ (Z Y : Scheme.{u}) (g : Z ⟶ Y) (V : Y.Opens) (hV : IsAffineOpen V)
        (W : Z.Opens) (hW : IsAffineOpen W) (i : W ≤ g ⁻¹ᵁ V) (w : Z) (hw : w ∈ W),
        hV.fromSpec ((Spec.map (g.appLE V W i)) (hW.primeIdealOf ⟨w, hw⟩)) = g w := by
      intro Z Y g V hV W hW i w hw
      have sq := IsAffineOpen.SpecMap_appLE_fromSpec g hV hW i
      exact (Scheme.Hom.comp_apply _ _ _).symm.trans
        ((congrArg (fun k => k (hW.primeIdealOf ⟨w, hw⟩)) sq).trans
          ((Scheme.Hom.comp_apply _ _ _).trans (congrArg g (hW.fromSpec_primeIdealOf ⟨w, hw⟩))))
    have htinj : ∀ (C X : Scheme.{u}) (f : C ⟶ X) [QuasiCompact f] [QuasiSeparated f]
        (U : X.Opens) (hU : IsAffineOpen U)
        (e : f ⁻¹ᵁ U ≤ f.toNormalization ⁻¹ᵁ (f.fromNormalization ⁻¹ᵁ U)),
        Function.Injective (f.toNormalization.appLE (f.fromNormalization ⁻¹ᵁ U) (f ⁻¹ᵁ U) e).hom := by
      intro C X f _ _ U hU e
      have hiso : ∀ (W W' : C.Opens) (i : Opposite.op W ⟶ Opposite.op W'), W = W' →
