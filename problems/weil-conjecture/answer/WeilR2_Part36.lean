        have e1 : Subalgebra.equivOfEq S S rfl x = x := Subtype.ext rfl
        rwa [e1] at h3
      · intro x hx
        have h3 := Ideal.mem_comap.mp (h2 hx)
        have e1 : Subalgebra.equivOfEq S S rfl x = x := Subtype.ext rfl
        rwa [e1] at h3
    subst hIJ
    exact hJ

  have core : ∀ (u₁ v₁ : A) (g₁ β₁ b₁ : ↥W), wcLlsPD W A 𝔭 (.ann u₁ v₁ g₁) → β₁ ≠ 0 →
      b₁ ∈ IsLocalRing.maximalIdeal ↥W → b₁ ≠ 0 → β₁ ∣ b₁ → ¬ b₁ ∣ β₁ → b₁ ∣ g₁ →
      ∀ (c₁ : ↥W) (m₁ : ℤ) (d₁ e₁ : ↥(wcLlsASmS W A K u₁ β₁ b₁)), c₁ ≠ 0 →
      ¬ (ℓ : ℤ) ∣ m₁ → m₁ < 0 →
      d₁ ∉ wcLlsASmN W A K u₁ β₁ b₁ → e₁ ∈ wcLlsASmN W A K u₁ β₁ b₁ →
      (d₁ : K) * (algebraMap A K (algebraMap ↥W A c₁) ^ ℓ * (f₀ - (h ^ ℓ - h))) =
        (algebraMap A K u₁ / algebraMap A K (algebraMap ↥W A β₁)) ^ m₁ *
          ((d₁ : K) + (e₁ : K)) →
      wcLlsAnnMidSep W A K L u₁ β₁ b₁ := by
    intro u₁ v₁ g₁ β₁ b₁ hPD₁ hβ0₁ hbm₁ hb0₁ hβb₁ hbβ₁ hbg₁ c₁ m₁ d₁ e₁ hc₁ hm₁ hneg₁ hd₁ he₁
      heq₁
    obtain ⟨_, _, _, hmax, _, _, hg0₁, huv₁, h𝔭₁, _⟩ := id hPD₁
    by_cases hβm₁ : β₁ ∈ IsLocalRing.maximalIdeal ↥W
    ·
      obtain ⟨t, rfl⟩ := hβb₁
      obtain ⟨r, hr⟩ := hbg₁
      have ht0 : t ≠ 0 := by
        rintro rfl
        exact hb0₁ (mul_zero β₁)
      have htm : t ∈ IsLocalRing.maximalIdeal ↥W := by
        by_contra hcon
        have hu : IsUnit t := (IsLocalRing.notMem_maximalIdeal).mp hcon
        obtain ⟨t', ht'⟩ := hu.exists_right_inv
        exact hbβ₁ ⟨t', by rw [mul_assoc, ht', mul_one]⟩
      have hqm : t * r ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right r _ htm
      have hgq : g₁ = β₁ * (t * r) := hr.trans (mul_assoc β₁ t r)
      have htq : t ∣ t * r := dvd_mul_right t r
      obtain ⟨A₃, _, _, _, _, _, _, _, u₃, v₃, 𝔭₃, hBr, hu₃, hv₃, hPD₃, -⟩ :=
        wcpa_dj_llsm_br_inner_chart Ω W hW hWt A K L 𝔭 u₁ v₁ g₁ β₁ (t * r) hPD₁ hβm₁ hβ0₁ hqm hgq
      have hiff := wcpa_dj_llsm_isi_chart_transport Ω W hW hWt A K L 𝔭 u₁ v₁ g₁ β₁ (t * r) t A₃
        u₃ v₃ 𝔭₃ hPD₁ hβm₁ hβ0₁ hqm hgq hBr hu₃ hv₃ hPD₃ htm ht0 htq
      obtain ⟨hBrW, hBrR, -⟩ := id hBr
      suffices hgoal : wcLlsAnnSep W A₃ K L u₃ t from hiff.mp hgoal
      by_cases hN : wcLlsASbN W A₃ K u₃ t = ⊤
      · delta wcLlsAnnSep wcLlsSepAt
        intro 𝔮 _ h𝔮
        have h1 := h𝔮.trans hN
        exact absurd h1 (Ideal.IsPrime.ne_top inferInstance)
      have huK : algebraMap A K u₁ ≠ 0 := by
        intro h0
        have hu0 : u₁ = 0 := (IsFractionRing.injective A K) (h0.trans (map_zero _).symm)
        apply hWK g₁ hg0₁
        rw [← huv₁, hu0, zero_mul, map_zero]
      have hN1 : (⟨algebraMap A K u₁ / algebraMap A K (algebraMap ↥W A β₁),
          Algebra.subset_adjoin (Set.mem_insert _ _)⟩ : ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t))) ∈
          wcLlsASmN W A K u₁ β₁ (β₁ * t) :=
        Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
      have hN2 : (⟨algebraMap A K (algebraMap ↥W A (β₁ * t)) / algebraMap A K u₁,
          Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ :
            ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t))) ∈ wcLlsASmN W A K u₁ β₁ (β₁ * t) :=
        Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
      have hρu : algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) u₁ ∈
          wcLlsASmN W A K u₁ β₁ (β₁ * t) := by
        have e1 : algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) u₁ =
            algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) (algebraMap ↥W A β₁) *
              ⟨algebraMap A K u₁ / algebraMap A K (algebraMap ↥W A β₁),
                Algebra.subset_adjoin (Set.mem_insert _ _)⟩ := by
          apply Subtype.ext
          show algebraMap A K u₁ = algebraMap A K (algebraMap ↥W A β₁) *
            (algebraMap A K u₁ / algebraMap A K (algebraMap ↥W A β₁))
          rw [mul_div_cancel₀ _ (hWK β₁ hβ0₁)]
        rw [e1]
        exact Ideal.mul_mem_left _ _ hN1
      have hρv : algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) v₁ ∈
          wcLlsASmN W A K u₁ β₁ (β₁ * t) := by
        have key : algebraMap A K u₁ * algebraMap A K v₁ =
            algebraMap A K (algebraMap ↥W A (β₁ * t)) * algebraMap A K (algebraMap ↥W A r) := by
          rw [← map_mul, ← map_mul, ← map_mul, huv₁, hr]
        have e1 : algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) v₁ =
            algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) (algebraMap ↥W A r) *
              ⟨algebraMap A K (algebraMap ↥W A (β₁ * t)) / algebraMap A K u₁,
                Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ := by
          apply Subtype.ext
          show algebraMap A K v₁ = algebraMap A K (algebraMap ↥W A r) *
            (algebraMap A K (algebraMap ↥W A (β₁ * t)) / algebraMap A K u₁)
          rw [mul_div_assoc', eq_div_iff huK]
          linear_combination key
        rw [e1]
        exact Ideal.mul_mem_left _ _ hN2
      have hover : 𝔭.map (algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t))) ≤
          wcLlsASmN W A K u₁ β₁ (β₁ * t) := by
        rw [h𝔭₁, Ideal.map_sup, Ideal.map_span, Ideal.map_map]
        refine sup_le ?_ le_sup_right
        rw [Ideal.span_le]
        rintro x ⟨y, hy, rfl⟩
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
        rcases hy with hy | hy
        · rw [hy]; exact hρu
        · rw [hy]; exact hρv
      have hcong : ∀ x : ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)), ∃ a : A,
          x - algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) a ∈
            wcLlsASmN W A K u₁ β₁ (β₁ * t) := by
        rintro ⟨x, hx⟩
        induction hx using Algebra.adjoin_induction with
        | mem z hz =>
          refine ⟨0, ?_⟩
          rw [map_zero, sub_zero]
          rcases hz with rfl | hz
          · exact hN1
          · rw [Set.mem_singleton_iff] at hz
            subst hz
            exact hN2
        | algebraMap a =>
          refine ⟨a, ?_⟩
          have e1 : (⟨algebraMap A K a, Subalgebra.algebraMap_mem _ a⟩ :
              ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t))) =
              algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) a :=
            Subtype.ext rfl
          rw [e1, sub_self]
