  have hk : k ≫ (f ⁻¹ᵁ U).ι = (f.toNormalization ⁻¹ᵁ (f.fromNormalization ⁻¹ᵁ U)).ι :=
    Scheme.homOfLE_ι _ _
  have hA : (f.toNormalization ∣_ (f.fromNormalization ⁻¹ᵁ U)) ≫ σ =
      k ≫ (f ⁻¹ᵁ U).toSpecΓ ≫ Spec.map val := by
    apply (cancel_mono j).1
    simp only [Category.assoc]
    rw [hσ, morphismRestrict_ι, ← hιt, ← Category.assoc, hk]
