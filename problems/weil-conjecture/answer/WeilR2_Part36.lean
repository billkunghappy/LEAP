    (IsFractionRing.injective (Localization.Away w) M').comp hιwinj
  letI algMM' : Algebra M M' := (IsFractionRing.lift (K := M) hinj').toAlgebra
  have hlift : ∀ c : ↥(integralClosure ↥(Algebra.adjoin A {s}) M),
