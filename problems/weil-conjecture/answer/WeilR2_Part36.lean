  haveI : Flat uX := hM.1.1
  haveI : IsProper uX := hM.1.2.1
  have hLFP : LocallyOfFinitePresentation uX :=
    wcpa_dj_mn_flat_fp _ X uX inferInstance inferInstance
  obtain ⟨-, hsupp, -⟩ := wcpa_dj_nc_centre_props Ω W hW X uX σ a hLFP inferInstance hσ ha0 ham
  haveI : IsClosedImmersion (σ ≫ uX) := by rw [hσ]; infer_instance
