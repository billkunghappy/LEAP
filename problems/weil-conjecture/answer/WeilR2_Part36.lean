  obtain ⟨y', hy'⟩ := hliftF t.1 t.2
  obtain ⟨ξ₁, hξ₁⟩ := hliftF ζ₁ hζ₁
  obtain ⟨ξ₂, hξ₂⟩ := hliftF ζ₂ hζ₂
