        (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))) (IsLocalRing.closedPoint ↥W) := by
      have e2 : (ΔU ≫ m) (IsLocalRing.closedPoint ↥W) = (Spec.map (CommRingCat.ofHom
          (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))) (IsLocalRing.closedPoint ↥W) := by
        rw [hΔm]
      exact e2
    have h8 := L1 m hm η' _ hsp (h6.trans h7.symm)
    apply hne
    rw [← hη'eq, h8, hx'eq]

theorem wcpa_dj_lr1k_nsr_ubc_scale : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X),
    wcpaDjLkModel W uX ι →
    ∀ (x : ↥X) (σ₀ : Spec (.of ↥W) ⟶ X) (a₀ : ↥W), wcpaDjLlPair W uX x σ₀ a₀ →
    ∀ (X₀ : Scheme.{u}) (r₀ : X₀ ⟶ X) (ι₀ : wcProjK Ω 1 ⟶ X₀),
      wcCsdIsBlowup (σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX a₀) r₀ → ι₀ ≫ r₀ = ι →
      wcpaDjLkModel W (r₀ ≫ uX) ι₀ →
    ∀ (U : X.Opens) (hU : IsAffineOpen U) (g : Γ(X, U)), x ∈ U → (σ₀.app U).hom g = 0 →
      (∀ a : ↥W, (σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX a).ideal ⟨U, hU⟩ =
        Ideal.span {g, wcGcfStr uX U a}) →
      (∀ (η : ↥X) (hη : η ∈ U), η ⤳ x → η ≠ x → uX η = IsLocalRing.closedPoint ↥W →
        IsUnit ((X.presheaf.germ U η hη).hom g)) →
    ∀ z₀ : ↥X₀, r₀ z₀ = x →
    ∀ (hgen : genericPoint C ∈ (γ ≫ ι) ⁻¹ᵁ U) (A V : ValuationSubring C.functionField),
      wcNsrBdry W (γ ≫ ι) uX x A → wcNsrCentred (γ ≫ ι₀) z₀ A →
      wcUbRigid W (γ ≫ wcProjKStr Ω 1) V → wcNsrCentred (γ ≫ ι₀) z₀ V →
