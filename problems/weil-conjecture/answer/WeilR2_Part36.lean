              ((⟨y, hy⟩ : ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t))) -
                algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) a') := by
            apply Subtype.ext
            show x + y - algebraMap A K (a + a') =
