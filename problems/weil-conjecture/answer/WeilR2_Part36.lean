  obtain ⟨r, s, hs0, hg⟩ := wcpa_dj_lr1k_nsr_esp_residue_frac _ h' x₀⁻¹
  refine ⟨r, s, hs0, hs0, ?_⟩
  rw [← hg, hval V, hval V']
  exact fun hiff => hx₀ (not_iff_not.mp hiff)

theorem wcpa_dj_lr1k_nsr_eb_bc_ker_point : ∀ (F : Scheme.{u}) {ζ w : F} (h : ζ ⤳ w), ∃ q : PrimeSpectrum ↥(F.presheaf.stalk w), q.asIdeal = RingHom.ker (wcNsrEbRho F h) ∧ F.fromSpecStalk w q = ζ :=
by
  intro F ζ w h
  refine ⟨(Spec.map (F.presheaf.stalkSpecializes h))
    (IsLocalRing.closedPoint ↥(F.presheaf.stalk ζ)), ?_, ?_⟩
  · have e : ((Spec.map (F.presheaf.stalkSpecializes h))
        (IsLocalRing.closedPoint ↥(F.presheaf.stalk ζ))).asIdeal =
        Ideal.comap (F.presheaf.stalkSpecializes h).hom
          (IsLocalRing.maximalIdeal ↥(F.presheaf.stalk ζ)) := by
      rfl
