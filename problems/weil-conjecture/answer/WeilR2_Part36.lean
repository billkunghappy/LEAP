    rcases hcase with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact ⟨u', v', hPDB, h1, h2⟩
    · exact ⟨v', u', (wcpa_dj_llsm_neat_pd_localize_swap W B 𝔮 u' v' g' hPDB).1, h1, h2⟩

