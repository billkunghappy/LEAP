    intro Z₁ Z₂ hZ₁ hZ₂ htZ₂ hne' hZ₁eq
    apply hne'
    refine hZ₁.eq_of_le hZ₂.prop ?_
    rw [hZ₁eq]
    intro s hs
    exact ((subtype_specializes_iff t s).mpr hs).mem_closed
      (isClosed_of_mem_irreducibleComponents Z₂ hZ₂) htZ₂
  have hζ₁ne : ζ₁ ≠ t.1 := by
    intro h
    rw [h] at hZ'eq
    exact hnt Z' Z hZ' hZ (htZ rfl) (fun h' => hne h') hZ'eq
  have hζ₂ne : ζ₂ ≠ t.1 := by
    intro h
    rw [h] at hZeq
    exact hnt Z Z' hZ hZ' htZ' (fun h' => hne h'.symm) hZeq

  have hembF : Topology.IsEmbedding (Limits.pullback.fst ((γ ≫ ι₁).fromNormalization ≫ r₁ ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    (Scheme.Hom.isClosedEmbedding (Limits.pullback.fst ((γ ≫ ι₁).fromNormalization ≫ r₁ ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))).isEmbedding
  have hliftF : ∀ q, wcUePi γ ι ι₁ r₁ hι q = wcNdPt W (γ ≫ ι) uX y₀ →
