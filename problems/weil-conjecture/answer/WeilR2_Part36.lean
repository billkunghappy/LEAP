  obtain ⟨ρ, hρ1, hρ2⟩ := Scheme.exists_preimage_of_isPullback (IsPullback.of_hasPullback rb U.ι)
    y (σU (IsLocalRing.closedPoint ↥W)) (by rw [hy, ← hσx, ← hσU]; rfl)
  obtain ⟨ρ', hρ1', hρ2'⟩ := Scheme.exists_preimage_of_isPullback
