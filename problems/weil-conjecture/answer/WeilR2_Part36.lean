        apply mul_left_cancel₀ (hne' _ hD)
        have hv := hιm x d
        have hv' := hιm' (y₁ * υ' ^ k₂) ⟨_, hD⟩
        simp only at hv'
        rw [← hv']
        have hd0 : i d ≠ 0 := hne d d.2
        apply mul_left_cancel₀ hd0
        rw [map_mul, map_mul, map_pow, map_pow, h1, h2]
        calc i d * (i' υ' ^ k₁ * i x * i' υ' ^ k₂)
            = i' υ' ^ k₁ * i' υ' ^ k₂ * i d * i x := by ring
          _ = i' υ' ^ k₁ * i' υ' ^ k₂ * i d * (i d * ι (IsLocalization.mk' _ x d)) := by
              rw [← hv]
          _ = i d * (i' υ' ^ k₂ * i d * i' υ' ^ k₁ * ι (IsLocalization.mk' _ x d)) := by ring
      · rintro _ ⟨z, rfl⟩
        obtain ⟨⟨x, d⟩, rfl⟩ := IsLocalization.mk'_surjective Q'.primeCompl z
        obtain ⟨k₁, y₁, h1⟩ := H' x
        obtain ⟨k₂, y₂, h2⟩ := H' d
        have hy₂ : y₂ ∉ Q := fun h => d.2 ((HQr _ _ _ h2).mp h)
        have hD : y₂ * υ ^ k₁ ∈ Q.primeCompl := by
          intro h
          rcases hQ.mem_or_mem h with h | h
          · exact hy₂ h
          · exact hυ (hQ.mem_of_pow_mem _ h)
        refine ⟨IsLocalization.mk' (Localization.AtPrime Q) (y₁ * υ ^ k₂) ⟨_, hD⟩, ?_⟩
        apply mul_left_cancel₀ (hne _ hD)
        have hv := hιm' x d
        have hv' := hιm (y₁ * υ ^ k₂) ⟨_, hD⟩
        simp only at hv'
        rw [← hv']
        have hd0 : i' d ≠ 0 := hne' d d.2
        apply mul_left_cancel₀ hd0
        rw [map_mul, map_mul, map_pow, map_pow, h1, h2]
        calc i' d * (i υ ^ k₁ * i' x * i υ ^ k₂)
            = i υ ^ k₁ * i υ ^ k₂ * i' d * i' x := by ring
          _ = i υ ^ k₁ * i υ ^ k₂ * i' d * (i' d * ι' (IsLocalization.mk' _ x d)) := by
              rw [← hv]
          _ = i' d * (i υ ^ k₂ * i' d * i υ ^ k₁ * ι' (IsLocalization.mk' _ x d)) := by ring
    let e1 : Localization.AtPrime Q ≃+* ι.range :=
      RingEquiv.ofBijective ι.rangeRestrict
        ⟨fun a b h => hinj (congrArg Subtype.val h), RingHom.rangeRestrict_surjective ι⟩
    let e2 : Localization.AtPrime Q' ≃+* ι'.range :=
      RingEquiv.ofBijective ι'.rangeRestrict
        ⟨fun a b h => hinj' (congrArg Subtype.val h), RingHom.rangeRestrict_surjective ι'⟩
    let e : Localization.AtPrime Q ≃+* Localization.AtPrime Q' :=
      e1.trans ((RingEquiv.subringCongr hrange).trans e2.symm)
    have hιe : ∀ z, ι' (e z) = ι z := by
      intro z
      have := congrArg Subtype.val (e2.apply_symm_apply ((RingEquiv.subringCongr hrange) (e1 z)))
      exact this
    refine ⟨e, fun x y hxy => hinj' ?_⟩
    rw [hιe, hιa, hιa']
    exact hxy

  have hllfi : ∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) →
      wcpaDjLkDelta R = wcpaDjLkDelta S ∧ wcpaDjLkBranches R = wcpaDjLkBranches S := by
    intro R S _ _ e
    classical
    let eF : FractionRing R ≃+* FractionRing S := IsFractionRing.ringEquivOfRingEquiv e
    have H1 : ∀ r : R, eF (algebraMap R (FractionRing R) r) =
        algebraMap S (FractionRing S) (e r) :=
      fun r => IsFractionRing.ringEquivOfRingEquiv_algebraMap e r
    have H2 : ∀ s : S, eF.symm (algebraMap S (FractionRing S) s) =
        algebraMap R (FractionRing R) (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, H1, RingEquiv.apply_symm_apply]
    have C1 : (algebraMap S (FractionRing S)).comp (e : R →+* S) =
        (eF : FractionRing R →+* FractionRing S).comp (algebraMap R (FractionRing R)) := by
      ext r
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H1 r).symm
    have C2 : (algebraMap R (FractionRing R)).comp (e.symm : S →+* R) =
        (eF.symm : FractionRing S →+* FractionRing R).comp (algebraMap S (FractionRing S)) := by
      ext s
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H2 s).symm
    have I1 : ∀ x : FractionRing R, _root_.IsIntegral R x → _root_.IsIntegral S (eF x) :=
      fun x hx => hx.map_of_comp_eq (e : R →+* S) (eF : FractionRing R →+* FractionRing S) C1
    have I2 : ∀ y : FractionRing S, _root_.IsIntegral S y → _root_.IsIntegral R (eF.symm y) :=
      fun y hy => hy.map_of_comp_eq (e.symm : S →+* R)
        (eF.symm : FractionRing S →+* FractionRing R) C2
    let eI : ↥(integralClosure R (FractionRing R)) ≃+* ↥(integralClosure S (FractionRing S)) :=
      { toFun := fun x => ⟨eF x, I1 x x.2⟩
        invFun := fun y => ⟨eF.symm y, I2 y y.2⟩
        left_inv := fun x => Subtype.ext (eF.symm_apply_apply x)
        right_inv := fun y => Subtype.ext (eF.apply_symm_apply y)
        map_mul' := fun x y => Subtype.ext (map_mul eF (x : FractionRing R) y)
        map_add' := fun x y => Subtype.ext (map_add eF (x : FractionRing R) y) }
    have heI : ∀ r : R, eI (algebraMap R _ r) = algebraMap S _ (e r) :=
      fun r => Subtype.ext (H1 r)
    have heI' : ∀ s : S, eI.symm (algebraMap S _ s) = algebraMap R _ (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, heI, RingEquiv.apply_symm_apply]
    constructor
    · letI : RingHomInvPair (e : R →+* S) (e.symm : S →+* R) := RingHomInvPair.of_ringEquiv e
      letI : RingHomInvPair (e.symm : S →+* R) (e : R →+* S) := RingHomInvPair.symm _ _
      let LeI : ↥(integralClosure R (FractionRing R)) →ₛₗ[(e : R →+* S)]
          ↥(integralClosure S (FractionRing S)) :=
        { toFun := eI
          map_add' := map_add eI
          map_smul' := fun r a => by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI]
            rfl }
      let LeI' : ↥(integralClosure S (FractionRing S)) →ₛₗ[(e.symm : S →+* R)]
          ↥(integralClosure R (FractionRing R)) :=
        { toFun := eI.symm
          map_add' := map_add eI.symm
          map_smul' := fun s b => by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI']
            rfl }
      let p := LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))
      let q := LinearMap.range (Algebra.linearMap S ↥(integralClosure S (FractionRing S)))
      have h1 : p ≤ q.comap LeI := by
        rintro _ ⟨r, rfl⟩
        exact ⟨e r, (heI r).symm⟩
      have h2 : q ≤ p.comap LeI' := by
        rintro _ ⟨s, rfl⟩
        exact ⟨e.symm s, (heI' s).symm⟩
      let Φ := p.mapQ q LeI h1
      let Φ' := q.mapQ p LeI' h2
      let Φe : (↥(integralClosure R (FractionRing R)) ⧸ p) ≃ₛₗ[(e : R →+* S)]
          (↥(integralClosure S (FractionRing S)) ⧸ q) :=
        { Φ with
          invFun := Φ'
          left_inv := fun x => by
            induction x using Submodule.Quotient.induction_on with
            | H a =>
              show Φ' (Φ (Submodule.Quotient.mk a)) = Submodule.Quotient.mk a
              rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
              exact congrArg _ (eI.symm_apply_apply a)
          right_inv := fun x => by
            induction x using Submodule.Quotient.induction_on with
            | H b =>
              show Φ (Φ' (Submodule.Quotient.mk b)) = Submodule.Quotient.mk b
              rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
              exact congrArg _ (eI.apply_symm_apply b) }
      let O := Submodule.orderIsoMapComap Φe
      unfold wcpaDjLkDelta
      rw [Module.length_eq_height, Module.length_eq_height, ← Order.height_orderIso O ⊤,
        OrderIso.map_top]
    · unfold wcpaDjLkBranches
      apply ENat.card_congr
      exact
        { toFun := fun M => ⟨M.asIdeal.comap (eI.symm : _ →+* _), by
            haveI := M.isMaximal
            exact Ideal.comap_isMaximal_of_surjective _ eI.symm.surjective⟩
          invFun := fun N => ⟨N.asIdeal.comap (eI : _ →+* _), by
            haveI := N.isMaximal
            exact Ideal.comap_isMaximal_of_surjective _ eI.surjective⟩
          left_inv := fun M => by
            ext x
            show eI.symm (eI x) ∈ M.asIdeal ↔ x ∈ M.asIdeal
            rw [RingEquiv.symm_apply_apply]
          right_inv := fun N => by
            ext x
            show eI (eI.symm x) ∈ N.asIdeal ↔ x ∈ N.asIdeal
            rw [RingEquiv.apply_symm_apply] }

  have s7 : ∀ (L : Type u) [Field L] (wL : ↥W →+* L) (R R' : Type u) [CommRing R]
      [CommRing R'] [Algebra R L] [Algebra R' L]
      (Q : Ideal ↥(integralClosure R L)) [Q.IsPrime]
      (Q' : Ideal ↥(integralClosure R' L)) [Q'.IsPrime]
      (e : Localization.AtPrime Q ≃+* Localization.AtPrime Q'),
      (∀ (x : ↥(integralClosure R L)) (y : ↥(integralClosure R' L)), (x : L) = (y : L) →
        e (algebraMap _ _ x) = algebraMap _ _ y) →
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W,
        wL w ∈ integralClosure R L ∧ wL w ∈ integralClosure R' L) →
      (wcpaDjLkBad (wcLlsFS W wL R Q) ↔ wcpaDjLkBad (wcLlsFS W wL R' Q')) := by
    intro L _ wL R R' _ _ _ _ Q _ Q' _ e he hw
    have hI : Ideal.map (e : Localization.AtPrime Q →+* Localization.AtPrime Q')
        ((Ideal.span {b : ↥(integralClosure R L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w}).map
            (algebraMap ↥(integralClosure R L) (Localization.AtPrime Q))) =
        (Ideal.span {b : ↥(integralClosure R' L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w}).map
            (algebraMap ↥(integralClosure R' L) (Localization.AtPrime Q')) := by
      rw [Ideal.map_map, Ideal.map_span, Ideal.map_span]
      congr 1
      ext z
      constructor
      · rintro ⟨b, ⟨w, hw', hb⟩, rfl⟩
        exact ⟨⟨wL w, (hw w hw').2⟩, ⟨w, hw', rfl⟩, (he b ⟨wL w, (hw w hw').2⟩ hb).symm⟩
      · rintro ⟨b', ⟨w, hw', hb'⟩, rfl⟩
        exact ⟨⟨wL w, (hw w hw').1⟩, ⟨w, hw', rfl⟩, he ⟨wL w, (hw w hw').1⟩ b' hb'.symm⟩
    have eq : wcLlsFS W wL R Q ≃+* wcLlsFS W wL R' Q' := Ideal.quotientEquiv _ _ e hI.symm
    obtain ⟨h1, h2⟩ := hllfi _ _ eq
    unfold wcpaDjLkBad
    rw [h1, h2]
  obtain ⟨_, _, _, hmax, hmle, hx𝔮, h𝔮, _⟩ := hPD
  obtain ⟨_, _, _, _, _, _, h𝔮', _⟩ := hPD'

  have s2 : ∀ (s : M) (N J : Ideal ↥(Algebra.adjoin B {s})),
      (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin B {s})) ∈ N →
      𝔮 ≤ N.comap (algebraMap B ↥(Algebra.adjoin B {s})) → N ≤ J → J ≠ ⊤ → J = N := by
    intro s N J hsN hpN hNJ hJ
    refine le_antisymm ?_ hNJ
    intro y hyJ
    obtain ⟨p, hp⟩ : ∃ p : Polynomial B, Polynomial.aeval s p = (y : M) := by
      have gen : ∀ z ∈ Algebra.adjoin B {s}, ∃ p : Polynomial B, Polynomial.aeval s p = z := by
        intro z hz
        rw [Algebra.adjoin_singleton_eq_range_aeval] at hz
        obtain ⟨p, hp⟩ := hz
        exact ⟨p, hp⟩
      exact gen (y : M) y.2
    have hy : y = algebraMap B _ (p.coeff 0) +
        (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin B {s})) *
        ⟨Polynomial.aeval s p.divX, Polynomial.aeval_mem_adjoin_singleton B s⟩ := by
      apply Subtype.ext
      have e := congrArg (Polynomial.aeval s) (Polynomial.X_mul_divX_add p)
      rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at e
      rw [Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_algebraMap, ← hp, ← e]
      exact add_comm _ _
    have hsy : (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin B {s})) *
        ⟨Polynomial.aeval s p.divX, Polynomial.aeval_mem_adjoin_singleton B s⟩ ∈ N :=
      Ideal.mul_mem_right _ _ hsN
    have haJ : algebraMap B ↥(Algebra.adjoin B {s}) (p.coeff 0) ∈ J := by
      have h1 : algebraMap B ↥(Algebra.adjoin B {s}) (p.coeff 0) = y -
          (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin B {s})) *
          ⟨Polynomial.aeval s p.divX, Polynomial.aeval_mem_adjoin_singleton B s⟩ := by
        rw [hy]; ring
      rw [h1]
      exact sub_mem hyJ (hNJ hsy)
    by_cases hc0 : p.coeff 0 ∈ 𝔮
    · rw [hy]
      exact add_mem (hpN hc0) hsy
    · exfalso
      obtain ⟨β, i, hi, hβ⟩ := hmax.exists_inv hc0
      apply hJ
      rw [Ideal.eq_top_iff_one]
      have e1 : (1 : ↥(Algebra.adjoin B {s})) =
          algebraMap B _ β * algebraMap B _ (p.coeff 0) + algebraMap B _ i := by
        rw [← map_mul, ← map_add, hβ, map_one]
      rw [e1]
      exact add_mem (Ideal.mul_mem_left _ _ haJ) (hNJ (hpN hi))

  have s3 : ∀ (s₁ s₂ υ : M), υ ∈ Algebra.adjoin B {s₂} → υ * s₁ ∈ Algebra.adjoin B {s₂} →
      ∀ r ∈ Algebra.adjoin B {s₁}, ∃ k : ℕ, υ ^ k * r ∈ Algebra.adjoin B {s₂} := by
    intro s₁ s₂ υ hυ hυs r hr
    induction hr using Algebra.adjoin_induction with
    | mem y hy =>
      rw [Set.mem_singleton_iff] at hy
      subst hy
      exact ⟨1, by rwa [pow_one]⟩
    | algebraMap a => exact ⟨0, by rw [pow_zero, one_mul]; exact Subalgebra.algebraMap_mem _ a⟩
    | add y z _ _ hy hz =>
      obtain ⟨k₁, h₁⟩ := hy
      obtain ⟨k₂, h₂⟩ := hz
      refine ⟨k₁ + k₂, ?_⟩
      have e : υ ^ (k₁ + k₂) * (y + z) = υ ^ k₂ * (υ ^ k₁ * y) + υ ^ k₁ * (υ ^ k₂ * z) := by ring
      rw [e]
      exact add_mem (mul_mem (pow_mem hυ _) h₁) (mul_mem (pow_mem hυ _) h₂)
    | mul y z _ _ hy hz =>
      obtain ⟨k₁, h₁⟩ := hy
      obtain ⟨k₂, h₂⟩ := hz
      refine ⟨k₁ + k₂, ?_⟩
      have e : υ ^ (k₁ + k₂) * (y * z) = (υ ^ k₁ * y) * (υ ^ k₂ * z) := by ring
      rw [e]
      exact mul_mem h₁ h₂

  have hZ : algebraMap B M (x - algebraMap ↥W B c) ≠ 0 := fun h =>
    hZne ((IsFractionRing.injective B M) (h.trans (map_zero _).symm))
  have hZ' : algebraMap B M (x' - algebraMap ↥W B c') ≠ 0 := fun h =>
    hZ'ne ((IsFractionRing.injective B M) (h.trans (map_zero _).symm))
  have I0 : algebraMap B M σ * algebraMap B M (x - algebraMap ↥W B c) =
      algebraMap B M ε * algebraMap B M (x' - algebraMap ↥W B c') := by
    rw [← map_mul, ← map_mul, hstar]
  have hμ : algebraMap B M (σ * ε) = algebraMap B M σ * algebraMap B M ε := map_mul _ _ _
  have hxc : x - algebraMap ↥W B c ∈ 𝔮 := sub_mem hx𝔮 (hmle (Ideal.mem_map_of_mem _ hc))
  unfold wcLlsDiscSep wcLlsSepAt at hsep ⊢
  set Z := algebraMap B M (x - algebraMap ↥W B c) with hZdef
  set Z' := algebraMap B M (x' - algebraMap ↥W B c') with hZ'def
  set β := algebraMap B M (algebraMap ↥W B b) with hβdef
  set S := algebraMap B M σ with hSdef
  set E := algebraMap B M ε with hEdef
  set s := β / Z with hsdef
  set s' := β / Z' with hs'def
  have I2 : S * E * s = S ^ 2 * s' := by
    rw [hsdef, hs'def, mul_div_assoc', mul_div_assoc', div_eq_div_iff hZ hZ']
    linear_combination (-(S * β)) * I0
  have I3 : S * E * s' = E ^ 2 * s := by
    rw [hsdef, hs'def, mul_div_assoc', mul_div_assoc', div_eq_div_iff hZ' hZ]
    linear_combination (E * β) * I0

  have hsR : s ∈ Algebra.adjoin B {s} := Algebra.subset_adjoin (Set.mem_singleton s)
  have hs'R : s' ∈ Algebra.adjoin B {s'} := Algebra.subset_adjoin (Set.mem_singleton s')
  have hμR : S * E ∈ Algebra.adjoin B {s} := by
    rw [← hμ]; exact Subalgebra.algebraMap_mem _ _
  have hμR' : S * E ∈ Algebra.adjoin B {s'} := by
    rw [← hμ]; exact Subalgebra.algebraMap_mem _ _
  have hS2 : S ^ 2 * s' ∈ Algebra.adjoin B {s'} :=
    mul_mem (pow_mem (Subalgebra.algebraMap_mem _ σ) 2) hs'R
  have hE2 : E ^ 2 * s ∈ Algebra.adjoin B {s} :=
    mul_mem (pow_mem (Subalgebra.algebraMap_mem _ ε) 2) hsR
  have hμs : S * E * s ∈ Algebra.adjoin B {s'} := by rw [I2]; exact hS2
  have hμs' : S * E * s' ∈ Algebra.adjoin B {s} := by rw [I3]; exact hE2
  have M1 := s3 s s' (S * E) hμR' hμs
  have M2 := s3 s' s (S * E) hμR hμs'
  have Hc := s4 B M L (Algebra.adjoin B {s}) (Algebra.adjoin B {s'}) (S * E) hμR' M1
  have Hc' := s4 B M L (Algebra.adjoin B {s'}) (Algebra.adjoin B {s}) (S * E) hμR M2
  let i : ↥(integralClosure ↥(Algebra.adjoin B {s}) L) →+* L :=
    (integralClosure ↥(Algebra.adjoin B {s}) L).val.toRingHom
  let i' : ↥(integralClosure ↥(Algebra.adjoin B {s'}) L) →+* L :=
    (integralClosure ↥(Algebra.adjoin B {s'}) L).val.toRingHom
  have hi : Function.Injective i := Subtype.val_injective
  have hi' : Function.Injective i' := Subtype.val_injective
  let υ : ↥(integralClosure ↥(Algebra.adjoin B {s}) L) :=
    algebraMap ↥(Algebra.adjoin B {s}) _ ⟨S * E, hμR⟩
  let υ' : ↥(integralClosure ↥(Algebra.adjoin B {s'}) L) :=
    algebraMap ↥(Algebra.adjoin B {s'}) _ ⟨S * E, hμR'⟩
  have hiυ : i υ = algebraMap M L (S * E) := rfl
  have hiυ' : i' υ' = algebraMap M L (S * E) := rfl
  have hυυ' : i υ = i' υ' := by rw [hiυ, hiυ']
  have H : ∀ y : ↥(integralClosure ↥(Algebra.adjoin B {s}) L),
      ∃ (k : ℕ) (z : ↥(integralClosure ↥(Algebra.adjoin B {s'}) L)),
        i' z = i' υ' ^ k * i y := by
    intro y
    obtain ⟨k, hk⟩ := Hc (y : L) y.2
    refine ⟨k, ⟨_, hk⟩, ?_⟩
    show algebraMap M L ((S * E) ^ k) * (y : L) = i' υ' ^ k * (y : L)
    rw [hiυ', map_pow]
  have H' : ∀ y' : ↥(integralClosure ↥(Algebra.adjoin B {s'}) L),
      ∃ (k : ℕ) (z : ↥(integralClosure ↥(Algebra.adjoin B {s}) L)),
        i z = i υ ^ k * i' y' := by
    intro y
    obtain ⟨k, hk⟩ := Hc' (y : L) y.2
    refine ⟨k, ⟨_, hk⟩, ?_⟩
    show algebraMap M L ((S * E) ^ k) * (y : L) = i υ ^ k * (y : L)
    rw [hiυ, map_pow]
  intro Q' hQ' hQ'N
  have hs'N : (⟨s', hs'R⟩ : ↥(Algebra.adjoin B {s'})) ∈
      Ideal.span {algebraMap B ↥(Algebra.adjoin B {s'}) (x' - algebraMap ↥W B c'),
        (⟨s', hs'R⟩ : ↥(Algebra.adjoin B {s'}))} ⊔ (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap B ↥(Algebra.adjoin B {s'})).comp (algebraMap ↥W B)) :=
    Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))

  have h𝔮J : 𝔮 ≤ (Q'.comap (algebraMap ↥(Algebra.adjoin B {s'})
      ↥(integralClosure ↥(Algebra.adjoin B {s'}) L))).comap
      (algebraMap B ↥(Algebra.adjoin B {s'})) := by
    rw [hQ'N, h𝔮']
    apply sup_le
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      rw [SetLike.mem_coe, Ideal.mem_comap]
      have e1 : algebraMap B ↥(Algebra.adjoin B {s'}) x' =
          algebraMap B ↥(Algebra.adjoin B {s'}) (x' - algebraMap ↥W B c') +
          ((algebraMap B ↥(Algebra.adjoin B {s'})).comp (algebraMap ↥W B)) c' := by
        rw [RingHom.comp_apply, ← map_add, sub_add_cancel]
      rw [e1]
      exact add_mem (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc'))
    · rw [Ideal.map_le_iff_le_comap]
      intro y hy
      rw [Ideal.mem_comap, Ideal.mem_comap]
      exact Ideal.mem_sup_right
        (Ideal.mem_map_of_mem ((algebraMap B ↥(Algebra.adjoin B {s'})).comp (algebraMap ↥W B)) hy)
  have hJ'top : (Q'.comap (algebraMap ↥(Algebra.adjoin B {s'})
      ↥(integralClosure ↥(Algebra.adjoin B {s'}) L))).comap
      (algebraMap B ↥(Algebra.adjoin B {s'})) ≠ ⊤ :=
    Ideal.comap_ne_top _ (Ideal.comap_ne_top _ hQ'.ne_top)
  have hJ'eq : (Q'.comap (algebraMap ↥(Algebra.adjoin B {s'})
      ↥(integralClosure ↥(Algebra.adjoin B {s'}) L))).comap
      (algebraMap B ↥(Algebra.adjoin B {s'})) = 𝔮 := (hmax.eq_of_le hJ'top h𝔮J).symm
  have hυ' : υ' ∉ Q' := by
    intro hmem
    have h1 : σ * ε ∈ (Q'.comap (algebraMap ↥(Algebra.adjoin B {s'})
        ↥(integralClosure ↥(Algebra.adjoin B {s'}) L))).comap
        (algebraMap B ↥(Algebra.adjoin B {s'})) := by
      rw [Ideal.mem_comap, Ideal.mem_comap]
      have e2 : algebraMap ↥(Algebra.adjoin B {s'}) ↥(integralClosure ↥(Algebra.adjoin B {s'}) L)
          (algebraMap B ↥(Algebra.adjoin B {s'}) (σ * ε)) =
          algebraMap ↥(Algebra.adjoin B {s'}) ↥(integralClosure ↥(Algebra.adjoin B {s'}) L)
          ⟨S * E, hμR'⟩ := by
        congr 1
        apply Subtype.ext
        rw [Subalgebra.coe_algebraMap]
        exact hμ
      rw [e2]
      exact hmem
    rw [hJ'eq] at h1
    rcases hmax.isPrime.mem_or_mem h1 with h | h
    · exact hσ h
    · exact hε h
  obtain ⟨Q, hQ, HQ⟩ := s5 _ _ L i i' hi' υ' H Q' hQ' hυ'
  haveI := hQ
  obtain ⟨e, he⟩ := s6 _ _ L i i' hi hi' υ υ' hυυ' H H' Q Q' hυ' HQ

  have memJ : ∀ (r : ↥(Algebra.adjoin B {s})) (k : ℕ) (r' : ↥(Algebra.adjoin B {s'})),
      algebraMap M L (r' : M) = algebraMap M L (S * E) ^ k * algebraMap M L (r : M) →
      r' ∈ Q'.comap (algebraMap ↥(Algebra.adjoin B {s'})
        ↥(integralClosure ↥(Algebra.adjoin B {s'}) L)) →
      r ∈ Q.comap (algebraMap ↥(Algebra.adjoin B {s}) _) := by
    intro r k r' hr hr'
    rw [Ideal.mem_comap]
    exact (HQ (algebraMap _ _ r) k (algebraMap _ _ r') hr).mpr hr'
  have hsN : (⟨s, hsR⟩ : ↥(Algebra.adjoin B {s})) ∈
      Ideal.span {algebraMap B ↥(Algebra.adjoin B {s}) (x - algebraMap ↥W B c),
        (⟨s, hsR⟩ : ↥(Algebra.adjoin B {s}))} ⊔ (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap B ↥(Algebra.adjoin B {s})).comp (algebraMap ↥W B)) :=
    Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
  have hpN : 𝔮 ≤ (Ideal.span {algebraMap B ↥(Algebra.adjoin B {s}) (x - algebraMap ↥W B c),
        (⟨s, hsR⟩ : ↥(Algebra.adjoin B {s}))} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap B ↥(Algebra.adjoin B {s})).comp (algebraMap ↥W B))).comap
        (algebraMap B ↥(Algebra.adjoin B {s})) := by
    rw [h𝔮]
    apply sup_le
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      rw [SetLike.mem_coe, Ideal.mem_comap]
      have e1 : algebraMap B ↥(Algebra.adjoin B {s}) x =
          algebraMap B ↥(Algebra.adjoin B {s}) (x - algebraMap ↥W B c) +
          ((algebraMap B ↥(Algebra.adjoin B {s})).comp (algebraMap ↥W B)) c := by
        rw [RingHom.comp_apply, ← map_add, sub_add_cancel]
      rw [e1]
      exact add_mem (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc))
    · rw [Ideal.map_le_iff_le_comap]
      intro y hy
      rw [Ideal.mem_comap, Ideal.mem_comap]
      exact Ideal.mem_sup_right
        (Ideal.mem_map_of_mem ((algebraMap B ↥(Algebra.adjoin B {s})).comp (algebraMap ↥W B)) hy)
  have hNJ : Ideal.span {algebraMap B ↥(Algebra.adjoin B {s}) (x - algebraMap ↥W B c),
        (⟨s, hsR⟩ : ↥(Algebra.adjoin B {s}))} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap B ↥(Algebra.adjoin B {s})).comp (algebraMap ↥W B)) ≤
      Q.comap (algebraMap ↥(Algebra.adjoin B {s}) _) := by
    apply sup_le
    · rw [Ideal.span_le]
      intro y hy
      rcases hy with hy | hy
      · rw [hy]
        refine memJ _ 0 (algebraMap B ↥(Algebra.adjoin B {s'}) (x - algebraMap ↥W B c))
          (by rw [pow_zero, one_mul]; rfl) ?_
        have hxJ : x - algebraMap ↥W B c ∈ (Q'.comap (algebraMap ↥(Algebra.adjoin B {s'})
            ↥(integralClosure ↥(Algebra.adjoin B {s'}) L))).comap
            (algebraMap B ↥(Algebra.adjoin B {s'})) := by
          rw [hJ'eq]; exact hxc
        exact hxJ
      · rw [Set.mem_singleton_iff] at hy
        rw [hy]
        refine memJ _ 1 (algebraMap B ↥(Algebra.adjoin B {s'}) σ ^ 2 * ⟨s', hs'R⟩) ?_ ?_
        · rw [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap, pow_one,
            ← map_mul, I2]
        · rw [hQ'N]
          exact Ideal.mul_mem_left _ _ hs'N
    · rw [Ideal.map_le_iff_le_comap]
      intro y hy
      rw [Ideal.mem_comap]
      refine memJ _ 0 (algebraMap B ↥(Algebra.adjoin B {s'}) (algebraMap ↥W B y))
        (by rw [pow_zero, one_mul]; rfl) ?_
      rw [hQ'N]
      exact Ideal.mem_sup_right
        (Ideal.mem_map_of_mem ((algebraMap B ↥(Algebra.adjoin B {s'})).comp (algebraMap ↥W B)) hy)
  have hJ : Q.comap (algebraMap ↥(Algebra.adjoin B {s}) _) ≠ ⊤ := Ideal.comap_ne_top _ hQ.ne_top
  have hQN := s2 s _ _ hsN hpN hNJ hJ
  have hnb := hsep Q hQN
  intro hb
  apply hnb
  refine (s7 L
    ((algebraMap M L).comp ((algebraMap B M).comp (algebraMap ↥W B)))
    ↥(Algebra.adjoin B {s}) ↥(Algebra.adjoin B {s'}) Q Q' e ?_ ?_).mpr hb
  · intro y z hyz
    exact he y z hyz
  · intro y _
    exact ⟨Subalgebra.algebraMap_mem (integralClosure ↥(Algebra.adjoin B {s}) L)
        (algebraMap B ↥(Algebra.adjoin B {s}) (algebraMap ↥W B y)),
      Subalgebra.algebraMap_mem (integralClosure ↥(Algebra.adjoin B {s'}) L)
        (algebraMap B ↥(Algebra.adjoin B {s'}) (algebraMap ↥W B y))⟩

theorem wcpa_dj_llsm_smid_coord_disc_stable : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] (M : Type u) [Field M] [Algebra B M]
    [IsFractionRing B M] (L : Type u) [Field L] [Algebra M L] [Algebra B L] [IsScalarTower B M L]
    [FiniteDimensional M L] [IsGalois M L] (𝔮 : Ideal B) (t' t'' : B)
    (y' : Ideal ↥(integralClosure B L)),
    wcLlsPD W B 𝔮 (.disc t') → wcLlsPD W B 𝔮 (.disc t'') → wcLlsSolvPt W B M L 𝔮 (.disc t') y' →
    wcLlsUniq B L 𝔮 y' →
    ∀ c₃ b₃ : ↥W, c₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ≠ 0 →
    wcLlsDiscSep W B M L t' c₃ b₃ → wcLlsDiscSep W B M L t'' c₃ b₃ →
    ∀ θ' : B →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ' = 𝔮 →
    (b₃ ∣ θ' t'' - c₃ ↔ b₃ ∣ θ' t' - c₃) :=
by
  intro Ω _ _ W hW hWt B _ _ _ M _ _ _ L _ _ _ _ _ _ 𝔮 t' t'' y' hPD' hPD'' hSolv hUniq c₃ b₃
    hc₃ hb₃m hb₃0 hsep' hsep'' θ' hθ'

  have hunit : ∀ θ : B →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔮 →
      ∀ x : B, x ∉ 𝔮 → IsUnit (θ x) := by
    intro θ hθ x hx
    by_contra hnu
    apply hx
    rw [← hθ, Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact hnu
  have hmem : ∀ θ : B →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔮 →
      ∀ x : B, x ∈ 𝔮 → θ x ∈ IsLocalRing.maximalIdeal ↥W := by
    intro θ hθ x hx
    rw [← hθ] at hx
    exact hx
  have hPD'c := hPD'
  unfold wcLlsPD at hPD'c
  obtain ⟨_, _, _, _, _, ht'𝔮, _, _⟩ := hPD'c

  obtain ⟨θ₀, hθ₀t, hθ₀c⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt B 𝔮 t'' hPD'' c₃ hc₃
  have hc' : θ₀ t' ∈ IsLocalRing.maximalIdeal ↥W := hmem θ₀ hθ₀c t' ht'𝔮

  have hfactor : ∀ (τ : B) (c : ↥W), wcLlsPD W B 𝔮 (.disc τ) → c ∈ IsLocalRing.maximalIdeal ↥W →
      θ₀ τ = c → ∀ x : B, ∃ s e : B, s ∉ 𝔮 ∧
        s * (x - algebraMap ↥W B (θ₀ x)) = (τ - algebraMap ↥W B c) * e := by
    intro τ c hPDτ hc hθτ x
    obtain ⟨ev, _, _, hfac⟩ := wcLlsAS_dsbu_section Ω W hW hWt B 𝔮 τ c hPDτ hc
    obtain ⟨s, e, hs, hse⟩ := hfac x
    have hev : θ₀ x = ev x := by
      have h1 := congrArg θ₀ hse
      simp only [map_mul, map_sub, AlgHom.commutes, Algebra.algebraMap_self,
        RingHom.id_apply] at h1
      rw [hθτ, sub_self, zero_mul, (hunit θ₀ hθ₀c s hs).mul_right_eq_zero, sub_eq_zero] at h1
      exact h1
    exact ⟨s, e, hs, by rw [hev]; exact hse⟩
  have hne : ∀ (τ : B) (c : ↥W), wcLlsPD W B 𝔮 (.disc τ) → c ∈ IsLocalRing.maximalIdeal ↥W →
      τ - algebraMap ↥W B c ≠ 0 := by
    intro τ c hPDτ hc h
    obtain ⟨θ₁, hθ₁, _⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt B 𝔮 τ hPDτ (c + b₃)
      (Ideal.add_mem _ hc hb₃m)
    have h2 := congrArg θ₁ (sub_eq_zero.mp h)
    rw [AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply] at h2
    rw [h2] at hθ₁
    apply hb₃0
    linear_combination -hθ₁
  obtain ⟨s₂, e₂, hs₂, hF2⟩ := hfactor t' (θ₀ t') hPD' hc' rfl t''
  rw [hθ₀t] at hF2
  obtain ⟨s₁, e₁, hs₁, hF1⟩ := hfactor t'' c₃ hPD'' hc₃ hθ₀t t'
  have hZ'' : t'' - algebraMap ↥W B c₃ ≠ 0 := hne t'' c₃ hPD'' hc₃
  have hZ' : t' - algebraMap ↥W B (θ₀ t') ≠ 0 := hne t' (θ₀ t') hPD' hc'
  have hprod : (t'' - algebraMap ↥W B c₃) * (s₁ * s₂ - e₁ * e₂) = 0 := by
    linear_combination s₁ * hF2 + e₂ * hF1
  have hse : s₁ * s₂ = e₁ * e₂ :=
    sub_eq_zero.mp ((mul_eq_zero.mp hprod).resolve_left hZ'')
  have he₂ : e₂ ∉ 𝔮 := by
    intro h
    have h1 : s₁ * s₂ ∈ 𝔮 := by rw [hse]; exact Ideal.mul_mem_left _ _ h
    have h2 := hmem θ₀ hθ₀c _ h1
    rw [map_mul, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h2
    exact h2 ((hunit θ₀ hθ₀c s₁ hs₁).mul (hunit θ₀ hθ₀c s₂ hs₂))

  have hsepc' : wcLlsDiscSep W B M L t' (θ₀ t') b₃ :=
    wcpa_dj_llsm_smcd_coord_change_sep W B M L 𝔮 t'' t' s₂ e₂ c₃ (θ₀ t') b₃ hPD'' hPD' hc₃ hc'
      hs₂ he₂ hZ'' hZ' (by rw [hF2, mul_comm]) hsep''

  have hcc : b₃ ∣ θ₀ t' - c₃ := by
    rcases wcpa_dj_llsm_sep_chain Ω W hW hWt B M L 𝔮 t' y' hPD' hSolv.1 hSolv.2.1 hUniq
        (hSolv.2.2.2 hSolv.1 t' rfl) c₃ b₃ (θ₀ t') b₃ hc₃ hb₃m hb₃0 hc' hb₃m hb₃0 hsep'
        hsepc' with ⟨_, h⟩ | ⟨_, h⟩
    · exact h
    · exact dvd_sub_comm.mp h

  have hE : θ' s₂ * (θ' t'' - c₃) = (θ' t' - θ₀ t') * θ' e₂ := by
    have h1 := congrArg θ' hF2
    simp only [map_mul, map_sub, AlgHom.commutes, Algebra.algebraMap_self,
      RingHom.id_apply] at h1
    exact h1
  calc b₃ ∣ θ' t'' - c₃ ↔ b₃ ∣ θ' s₂ * (θ' t'' - c₃) :=
        (hunit θ' hθ' s₂ hs₂).dvd_mul_left.symm
    _ ↔ b₃ ∣ (θ' t' - θ₀ t') * θ' e₂ := by rw [hE]
    _ ↔ b₃ ∣ θ' t' - θ₀ t' := (hunit θ' hθ' e₂ he₂).dvd_mul_right
    _ ↔ b₃ ∣ θ' t' - c₃ := by
        have h3 : θ' t' - c₃ = (θ' t' - θ₀ t') + (θ₀ t' - c₃) := by ring
        rw [h3]
        exact (dvd_add_left hcc).symm

theorem wcpa_dj_llsm_smid_peel : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) (t a : A) (c : ↥W),
    wcLlsPD W A 𝔭 (.disc t) → c ∈ IsLocalRing.maximalIdeal ↥W →
    (∀ θ : A →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔭 → θ a = 0 → θ t = c) →
    ∃ (d : ℕ) (S u : A), S ∉ 𝔭 ∧ S * a = (t - algebraMap ↥W A c) ^ d * u ∧
      ∀ θ : A →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔭 → θ t = c → θ u ≠ 0 :=
by
  intro Ω _ _ W hW hWt A _ _ _ 𝔭 t a c hPD hc hZ
  classical

  have arch : ∀ (π x : ↥W), π ∈ IsLocalRing.maximalIdeal ↥W → π ≠ 0 → x ≠ 0 →
      ¬ (∀ k : ℕ, π ^ k ∣ x) := by
    intro π x hπm hπ0 hx0 hall
    have hπnu : ¬ IsUnit π := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hπm
      exact hπm
    have hnd : ∀ n : ℕ, ¬ π ^ (n + 1) ∣ π ^ n := by
      rintro n ⟨w, hw⟩
      apply hπnu
      have h1 : π ^ n * 1 = π ^ n * (π * w) := by rw [mul_one, ← mul_assoc, ← pow_succ]; exact hw
      exact IsUnit.of_mul_eq_one w (mul_left_cancel₀ (pow_ne_zero n hπ0) h1).symm
    let P : Ideal ↥W := ⨅ k : ℕ, Ideal.span {π ^ k}
    have hmemP : ∀ y, y ∈ P ↔ ∀ k : ℕ, π ^ k ∣ y := by
      intro y
      simp only [P, Ideal.mem_iInf, Ideal.mem_span_singleton]
    have hπP : π ∉ P := fun h => hnd 1 (by simpa using (hmemP π).mp h 2)
    have hPprime : P.IsPrime := by
      refine ⟨?_, ?_⟩
      · intro htop
        apply hπP
        rw [htop]
        exact Submodule.mem_top
      · intro y z hyz
        by_contra hcon
        push_neg at hcon
        obtain ⟨hy, hz⟩ := hcon
        rw [hmemP] at hy hz
        push_neg at hy hz
        obtain ⟨k1, hk1⟩ := hy
        obtain ⟨k2, hk2⟩ := hz
        have h1 : y ∣ π ^ k1 := (ValuationRing.dvd_total (π ^ k1) y).resolve_left hk1
        have h2 : z ∣ π ^ k2 := (ValuationRing.dvd_total (π ^ k2) z).resolve_left hk2
        have h3 : y * z ∣ π ^ (k1 + k2) := by rw [pow_add]; exact mul_dvd_mul h1 h2
        exact hnd (k1 + k2) (dvd_trans ((hmemP _).mp hyz _) h3)
    have hPne : P ≠ ⊥ := by
      intro h
      apply hx0
      have hxP : x ∈ P := (hmemP x).mpr hall
      rw [h] at hxP
      exact (Submodule.mem_bot _).mp hxP
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
    have hPmax : P.IsMaximal :=
      Ring.krullDimLE_one_iff_of_isPrime_bot.mp inferInstance P hPne hPprime
    apply hπP
    rw [IsLocalRing.eq_maximalIdeal hPmax]
    exact hπm

  have hPD' := hPD
  unfold wcLlsPD at hPD'
  obtain ⟨_, _, _, h𝔭max, _, _⟩ := hPD'
  have h𝔭prime : 𝔭.IsPrime := h𝔭max.isPrime
  have h1𝔭 : (1 : A) ∉ 𝔭 := fun h => h𝔭max.ne_top ((Ideal.eq_top_iff_one 𝔭).mpr h)
  have hunit : ∀ θ : A →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔭 →
      ∀ x : A, x ∉ 𝔭 → IsUnit (θ x) := by
    intro θ hθ x hx
    by_contra hu
    apply hx
    rw [← hθ, Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact hu
  obtain ⟨ev, -, -, hfac⟩ := wcLlsAS_dsbu_section Ω W hW hWt A 𝔭 t c hPD hc

  have hK : ∀ θ : A →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔭 → θ t = c →
      ∀ x : A, θ x = ev x := by
    intro θ hθ hθt x
    obtain ⟨s, e, hs, hse⟩ := hfac x
    have h1 := congrArg θ hse
    simp only [map_mul, map_sub, AlgHom.commutes, Algebra.algebraMap_self,
      RingHom.id_apply] at h1
    rw [hθt, sub_self, zero_mul, (hunit θ hθ s hs).mul_right_eq_zero, sub_eq_zero] at h1
    exact h1

  by_contra H
  have hP : ∀ k : ℕ, ∃ S u : A, S ∉ 𝔭 ∧ S * a = (t - algebraMap ↥W A c) ^ k * u := by
    intro k
    induction k with
    | zero => exact ⟨1, a, h1𝔭, by rw [pow_zero, one_mul]⟩
    | succ k ih =>
      obtain ⟨S, u, hS, hSu⟩ := ih
      have hevu : ev u = 0 := by
        by_contra hne
        exact H ⟨k, S, u, hS, hSu, fun θ hθ hθt => by rw [hK θ hθ hθt u]; exact hne⟩
      obtain ⟨s, e, hs, hse⟩ := hfac u
      rw [hevu, map_zero, sub_zero] at hse
      refine ⟨s * S, e, fun hmem => (h𝔭prime.mem_or_mem hmem).elim hs hS, ?_⟩
      linear_combination s * hSu + (t - algebraMap ↥W A c) ^ k * hse

  obtain ⟨x₀, hx₀⟩ : ∃ x₀ : Ω, x₀ ∉ W := by
    by_contra hall
    push_neg at hall
    exact hWt (ValuationSubring.ext W ⊤ fun x => ⟨fun _ => ValuationSubring.mem_top x,
      fun _ => hall x⟩)
  have hx₀0 : x₀ ≠ 0 := fun h => hx₀ (h ▸ W.zero_mem)
  have hinv : x₀⁻¹ ∈ W := (W.mem_or_inv_mem x₀).resolve_left hx₀
  obtain ⟨π, hπdef⟩ : ∃ π : ↥W, (π : Ω) = x₀⁻¹ := ⟨⟨x₀⁻¹, hinv⟩, rfl⟩
  have hπ0 : π ≠ 0 := by
    intro h
    apply inv_ne_zero hx₀0
    rw [← hπdef, h]
    rfl
  have hπm : π ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    obtain ⟨w, hw⟩ := hu.exists_right_inv
    have h2 : (x₀⁻¹ : Ω) * (w : Ω) = 1 := by
      rw [← hπdef]
      have h3 := congrArg Subtype.val hw
      exact h3
    have h3 : x₀ = w := (inv_mul_eq_one₀ hx₀0).mp h2
    exact hx₀ (h3 ▸ w.2)
  obtain ⟨θ₁, hθ₁t, hθ₁c⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt A 𝔭 t hPD (c + π)
    (Ideal.add_mem _ hc hπm)
  have hθ₁a : θ₁ a ≠ 0 := by
    intro h0
    have h1 := hZ θ₁ hθ₁c h0
    rw [hθ₁t] at h1
    exact hπ0 (by simpa using h1)
  apply arch π (θ₁ a) hπm hπ0 hθ₁a
  intro k
  obtain ⟨S, u, hS, hSu⟩ := hP k
  have h1 := congrArg θ₁ hSu
  simp only [map_mul, map_pow, map_sub, AlgHom.commutes, Algebra.algebraMap_self,
    RingHom.id_apply] at h1
  rw [hθ₁t, add_sub_cancel_left] at h1
  exact (hunit θ₁ hθ₁c S hS).dvd_mul_left.mp ⟨θ₁ u, h1⟩

theorem wcpa_dj_llsm_zfc_poly_root_or_dvd : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (P : Polynomial ↥W) (z : ↥W), P.eval 0 ≠ 0 → (P.eval 0 ∣ P.eval z ∨ ∃ ζ : ↥W, z ∣ ζ ∧ P.eval ζ = 0) :=
by
  intro Ω _ _ W P z _
  classical
  have hs : ∀ x : Ω, (P.map (algebraMap W Ω)).eval x = (P.map (algebraMap W Ω)).leadingCoeff *
      ((P.map (algebraMap W Ω)).roots.map (fun a => x - a)).prod :=
    fun x => Polynomial.Splits.eval_eq_prod_roots (IsAlgClosed.splits (P.map (algebraMap W Ω))) x
  have htr : ∀ y : W, ((P.eval y : W) : Ω) = (P.map (algebraMap W Ω)).eval (y : Ω) := by
    intro y
    rw [Polynomial.eval_map, ← ValuationSubring.algebraMap_apply, ← ValuationSubring.algebraMap_apply,
      Polynomial.eval₂_at_apply]
  by_cases H : ∃ α ∈ (P.map (algebraMap W Ω)).roots, W.valuation α ≤ W.valuation (z : Ω)
  · obtain ⟨α, hα, hle⟩ := H
    obtain ⟨c, hc⟩ := (ValuationSubring.valuation_le_iff W α z).mp hle
    right
    refine ⟨c * z, Dvd.intro_left c rfl, ?_⟩
    apply Subtype.val_injective
    have h1 : ((c * z : W) : Ω) = α := by rw [← hc]; rfl
    rw [htr, h1]
    have := (Polynomial.mem_roots'.mp hα).2
    simpa using this
  · push_neg at H
    left
    have key : W.valuation ((P.map (algebraMap W Ω)).eval (z : Ω)) =
        W.valuation ((P.map (algebraMap W Ω)).eval 0) := by
      rw [hs, hs, Valuation.map_mul, Valuation.map_mul, map_multiset_prod, map_multiset_prod,
        Multiset.map_map, Multiset.map_map]
      congr 2
      apply Multiset.map_congr rfl
      intro α hα
      simp only [Function.comp_apply, zero_sub, Valuation.map_neg]
      exact Valuation.map_sub_eq_of_lt_right _ (H α hα)
    have h0 : ((P.eval 0 : W) : Ω) = (P.map (algebraMap W Ω)).eval 0 := by
      rw [htr]; rfl
    have heq : W.valuation ((P.eval z : W) : Ω) = W.valuation ((P.eval 0 : W) : Ω) := by
      rw [htr, h0, key]
    obtain ⟨c, hc⟩ := (ValuationSubring.valuation_le_iff W _ _).mp (le_of_eq heq)
    refine ⟨c, ?_⟩
    apply Subtype.val_injective
    rw [← hc]
    show _ = ((P.eval 0 : W) : Ω) * (c : Ω)
    ring

theorem wcpa_dj_llsm_zfc_alg_relation : ∀ (V : Type u) [CommRing V] [IsDomain V] (R : Type u) [CommRing R] [IsDomain R] [Algebra V R] (τ h u : R), h ≠ 0 → u ≠ 0 → (∀ g : Polynomial V, Polynomial.aeval τ g = 0 → g = 0) → ∀ f : Polynomial V →+* Localization.Away h, f.comp Polynomial.C = (algebraMap R (Localization.Away h)).comp (algebraMap V R) → f Polynomial.X = algebraMap R (Localization.Away h) τ → f.Etale → ∃ (n : ℕ) (φ : ℕ → Polynomial V), φ 0 ≠ 0 ∧ ∑ i ∈ Finset.range (n + 1), Polynomial.aeval τ (φ i) * u ^ i = 0 :=
by
  intro V _ _ R _ _ _ τ h u hh hu hinj f hfC hfX hfet
  classical

  have key : ∀ (P : Type u) [CommRing P] [IsDomain P] (A : Type u) [CommRing A] [Algebra P A]
      [Algebra.Etale P A] (x : A), ∃ (q : Polynomial P) (g : P), q ≠ 0 ∧ g ≠ 0 ∧
        algebraMap P A g * Polynomial.aeval x q = 0 := by
    intro P _ _ A _ _ _ x
    let K := FractionRing P
    let M := Algebra.algebraMapSubmonoid A (nonZeroDivisors P)
    let L := Localization M
    haveI : IsLocalization (Submonoid.map (algebraMap P A) (nonZeroDivisors P)) L :=
      inferInstanceAs (IsLocalization (Algebra.algebraMapSubmonoid A (nonZeroDivisors P)) L)
    haveI : Algebra.FormallyUnramified K L :=
      Algebra.FormallyUnramified.localization_map (R := P) (S := A) (Rₘ := K) (Sₘ := L)
        (nonZeroDivisors P)
    haveI : Algebra.EssFiniteType K L := Algebra.EssFiniteType.of_comp P K L
    haveI : Module.Finite K L := Algebra.FormallyUnramified.finite_of_free K L
    haveI : Algebra.IsIntegral K L := Algebra.IsIntegral.of_finite K L
    have hint : IsIntegral K (algebraMap A L x) := Algebra.IsIntegral.isIntegral _
    have halg : IsAlgebraic P (algebraMap A L x) :=
      (IsFractionRing.isAlgebraic_iff P K L).mpr hint.isAlgebraic
    obtain ⟨q, hq0, hq⟩ := halg
    rw [Polynomial.aeval_algebraMap_apply] at hq
    obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff M L _).mp hq
    obtain ⟨g, hg, hgm⟩ := Submonoid.mem_map.mp m.2
    refine ⟨q, g, hq0, nonZeroDivisors.ne_zero hg, ?_⟩
    rw [hgm]
    exact hm

  have hf : f = (algebraMap R (Localization.Away h)).comp (Polynomial.aeval τ).toRingHom := by
    apply Polynomial.ringHom_ext
    · intro v
      have := RingHom.congr_fun hfC v
      simpa using this
    · simpa using hfX
  subst hf
  letI : Algebra (Polynomial V) (Localization.Away h) :=
    ((algebraMap R (Localization.Away h)).comp (Polynomial.aeval τ).toRingHom).toAlgebra
  haveI : Algebra.Etale (Polynomial V) (Localization.Away h) := hfet
  obtain ⟨q, g, hq0, hg0, hqg⟩ :=
    key (Polynomial V) (Localization.Away h) (algebraMap R (Localization.Away h) u)
  have hinjR : Function.Injective (algebraMap R (Localization.Away h)) :=
    IsLocalization.injective _ (powers_le_nonZeroDivisors_of_noZeroDivisors hh)
  have hE : Polynomial.aeval τ g * Polynomial.eval₂ (Polynomial.aeval τ).toRingHom u q = 0 := by
    apply hinjR
    rw [map_mul, map_zero, Polynomial.hom_eval₂]
    rw [Polynomial.aeval_def] at hqg
    exact hqg
  have hg' : Polynomial.aeval τ g ≠ 0 := fun h0 => hg0 (hinj g h0)
  have hEq : Polynomial.eval₂ (Polynomial.aeval τ).toRingHom u q = 0 :=
    (mul_eq_zero.mp hE).resolve_left hg'
  obtain ⟨q', hq', hndvd⟩ := Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd q hq0 0
  rw [map_zero, sub_zero] at hq' hndvd
  have hc0 : q'.coeff 0 ≠ 0 := fun h0 => hndvd (Polynomial.X_dvd_iff.mpr h0)
  rw [hq', Polynomial.eval₂_mul, Polynomial.eval₂_X_pow] at hEq
  have hEq' := (mul_eq_zero.mp hEq).resolve_left (pow_ne_zero _ hu)
  refine ⟨q'.natDegree, fun i => q'.coeff i, hc0, ?_⟩
  rw [Polynomial.eval₂_eq_sum_range] at hEq'
  exact hEq'

theorem wcpa_dj_llsm_zfc_lower_bound : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (U : ↥W → ↥W) (n : ℕ) (φ : ℕ → Polynomial ↥W), φ 0 ≠ 0 → (∀ x ∈ IsLocalRing.maximalIdeal ↥W, U x ≠ 0) → (∀ x ∈ IsLocalRing.maximalIdeal ↥W, ∀ y ∈ IsLocalRing.maximalIdeal ↥W, x - y ∣ U x - U y) → (∀ x ∈ IsLocalRing.maximalIdeal ↥W, ∑ i ∈ Finset.range (n + 1), (φ i).eval x * U x ^ i = 0) → ∃ δ : ↥W, δ ≠ 0 ∧ ∀ x ∈ IsLocalRing.maximalIdeal ↥W, U x ∣ δ :=
by
  intro Ω _ _ W U n φ hφ0 hZF hLIP hREL
  classical

  have F1 : ∀ a b : W, a ∣ b ↔ W.valuation (b : Ω) ≤ W.valuation (a : Ω) := by
    intro a b
    rw [ValuationSubring.valuation_le_iff]
    constructor
    · rintro ⟨c, rfl⟩
      exact ⟨c, by push_cast; ring⟩
    · rintro ⟨c, hc⟩
      exact ⟨c, Subtype.ext (by push_cast; rw [← hc]; ring)⟩

  have s1 : ∀ x ∈ IsLocalRing.maximalIdeal W, U x ∣ (φ 0).eval x := by
    intro x hx
    have h := hREL x hx
    rw [Finset.sum_range_succ'] at h
    simp only [pow_zero, mul_one] at h
    have hS : U x ∣ ∑ i ∈ Finset.range n, (φ (i+1)).eval x * U x ^ (i+1) :=
      Finset.dvd_sum (fun i _ => Dvd.dvd.mul_left (dvd_pow_self _ (Nat.succ_ne_zero i)) _)
    have h' : (φ 0).eval x = -∑ i ∈ Finset.range n, (φ (i+1)).eval x * U x ^ (i+1) := by
      linear_combination h
    rw [h']
    exact (dvd_neg).mpr hS

  have s2 : ∀ d e e' : W, ¬ d ∣ e → d ∣ e' - e → e' ∣ e := by
    intro d e e' hde hd
    obtain ⟨l, hl⟩ := hd
    rcases ValuationRing.dvd_total d e with h | ⟨k, hk⟩
    · exact absurd h hde
    · have hk' : k ∈ IsLocalRing.maximalIdeal W := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        apply hde
        exact ⟨↑hu.unit⁻¹, by rw [hk, mul_assoc, IsUnit.mul_val_inv, mul_one]⟩
      have hkl : k * l ∈ IsLocalRing.maximalIdeal W := Ideal.mul_mem_right l _ hk'
      have hu : IsUnit (1 + k * l) := by
        by_contra hnu
        have h1 : (1 + k * l) ∈ IsLocalRing.maximalIdeal W := hnu
        have h2 : (1 : W) ∈ IsLocalRing.maximalIdeal W := by
          have := Ideal.sub_mem _ h1 hkl
          simpa using this
        exact (IsLocalRing.maximalIdeal.isMaximal W).ne_top ((Ideal.eq_top_iff_one _).mpr h2)
      have he' : e' = e * (1 + k * l) := by linear_combination hl + l * hk
      exact ⟨↑hu.unit⁻¹, by rw [he', mul_assoc, IsUnit.mul_val_inv, mul_one]⟩

  have s3 : ∀ (x ε : W) (α : Ω), x ∈ IsLocalRing.maximalIdeal W →
      (∀ h : α ∈ W, (⟨α, h⟩ : W) ∈ IsLocalRing.maximalIdeal W → x - ⟨α, h⟩ ∣ ε) →
      W.valuation (ε : Ω) ≤ W.valuation ((x : Ω) - α) := by
    intro x ε α hx H
    have hvx : W.valuation (x : Ω) < 1 := (ValuationSubring.valuation_lt_one_iff W x).mp hx
    have hvε : W.valuation (ε : Ω) ≤ 1 := W.valuation_le_one ε
    by_cases hαW : α ∈ W
    · by_cases hαm : (⟨α, hαW⟩ : W) ∈ IsLocalRing.maximalIdeal W
      · have := (F1 _ _).mp (H hαW hαm)
        simpa using this
      · have hu : IsUnit (⟨α, hαW⟩ : W) := IsLocalRing.notMem_maximalIdeal.mp hαm
        have hv1 : W.valuation α = 1 := (ValuationSubring.valuation_eq_one_iff W _).mp hu
        rw [Valuation.map_sub_eq_of_lt_right _ (by rw [hv1]; exact hvx), hv1]
        exact hvε
    · have hv1 : 1 < W.valuation α := by
        rw [← not_le]
        intro h
        exact hαW ((ValuationSubring.valuation_le_one_iff W α).mp h)
      rw [Valuation.map_sub_eq_of_lt_right _ (hvx.trans hv1)]
      exact hvε.trans hv1.le

  have s4 : ∀ (g : Polynomial W) (x ε : W),
      (∀ α ∈ (g.map (algebraMap W Ω)).roots, W.valuation (ε : Ω) ≤ W.valuation ((x : Ω) - α)) →
      g.eval x ∣ g.leadingCoeff * ε ^ (g.map (algebraMap W Ω)).roots.card := by
    intro g x ε H
    have hιinj : Function.Injective (algebraMap W Ω) := Subtype.val_injective
    have hfac := Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C
      (IsAlgClosed.card_roots_eq_natDegree (p := g.map (algebraMap W Ω)))
    have hlc : (g.map (algebraMap W Ω)).leadingCoeff = algebraMap W Ω g.leadingCoeff :=
      Polynomial.leadingCoeff_map_of_injective hιinj g
    set ρ := (g.map (algebraMap W Ω)).roots with hρ
    have hev0 : algebraMap W Ω (g.eval x) = (g.map (algebraMap W Ω)).eval (algebraMap W Ω x) := by
      rw [Polynomial.eval_map, Polynomial.eval₂_at_apply]
    have h2 := congrArg (Polynomial.eval (algebraMap W Ω x)) hfac
    rw [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_multiset_prod, Multiset.map_map,
      hlc] at h2
    have h3 : (ρ.map ((Polynomial.eval (algebraMap W Ω x)) ∘ (fun a => Polynomial.X - Polynomial.C a)))
        = ρ.map (fun a => (x : Ω) - a) := by
      apply Multiset.map_congr rfl
      intro a _
      simp
    rw [h3] at h2
    have hev : ((g.eval x : W) : Ω) = (g.leadingCoeff : Ω) * (ρ.map (fun a => (x : Ω) - a)).prod := by
      have := hev0.trans h2.symm
      simpa using this
    have hv : W.valuation ((g.eval x : W) : Ω) = W.valuation (g.leadingCoeff : Ω) *
        (ρ.map (fun a => W.valuation ((x : Ω) - a))).prod := by
      rw [hev, map_mul, map_multiset_prod, Multiset.map_map]
      rfl
    have hle : W.valuation (ε : Ω) ^ ρ.card ≤ (ρ.map (fun a => W.valuation ((x : Ω) - a))).prod := by
      have := Multiset.pow_card_le_prod (s := ρ.map (fun a => W.valuation ((x : Ω) - a)))
        (a := W.valuation (ε : Ω)) (by
          intro y hy
          obtain ⟨a, ha, rfl⟩ := Multiset.mem_map.mp hy
          exact H a ha)
      rwa [Multiset.card_map] at this
    rw [F1]
    have hc : ((g.leadingCoeff * ε ^ ρ.card : W) : Ω) = (g.leadingCoeff : Ω) * (ε : Ω) ^ ρ.card := by
      push_cast; rfl
    rw [hc, map_mul, map_pow, hv]
    exact mul_le_mul' le_rfl hle

  set g := φ 0 with hg
  set ρ := (g.map (algebraMap W Ω)).roots with hρ
  let E : Ω → W := fun α => if h : α ∈ W then
    (if (⟨α, h⟩ : W) ∈ IsLocalRing.maximalIdeal W then U ⟨α, h⟩ else 1) else 1
  have hE0 : ∀ α, E α ≠ 0 := by
    intro α
    simp only [E]
    split_ifs with h1 h2
    · exact hZF _ h2
    · exact one_ne_zero
    · exact one_ne_zero
  have hEval : ∀ α (h : α ∈ W), (⟨α, h⟩ : W) ∈ IsLocalRing.maximalIdeal W → E α = U ⟨α, h⟩ := by
    intro α h hm
    simp only [E, dif_pos h, if_pos hm]
  set ε := (ρ.map E).prod with hε
  have hε0 : ε ≠ 0 := Multiset.prod_ne_zero (by
    intro h
    obtain ⟨a, _, ha⟩ := Multiset.mem_map.mp h
    exact hE0 a ha)
  have hEdvd : ∀ α ∈ ρ, E α ∣ ε := fun α hα => Multiset.dvd_prod (Multiset.mem_map_of_mem E hα)
  refine ⟨g.leadingCoeff * ε ^ ρ.card,
    mul_ne_zero (Polynomial.leadingCoeff_ne_zero.mpr hφ0) (pow_ne_zero _ hε0), ?_⟩
  intro x hx
  by_cases H : ∃ α ∈ ρ, ∃ h : α ∈ W, (⟨α, h⟩ : W) ∈ IsLocalRing.maximalIdeal W ∧
      ¬ (x - ⟨α, h⟩ ∣ U ⟨α, h⟩)
  · obtain ⟨α, hα, h, hm, hnd⟩ := H
    have h1 : U x ∣ U ⟨α, h⟩ := s2 _ _ _ hnd (hLIP x hx _ hm)
    have hcard : ρ.card ≠ 0 := (Multiset.card_pos_iff_exists_mem.mpr ⟨α, hα⟩).ne'
    have h2 : U ⟨α, h⟩ ∣ ε := by rw [← hEval α h hm]; exact hEdvd α hα
    exact h1.trans (h2.trans ((dvd_pow_self ε hcard).trans (dvd_mul_left _ _)))
  · push_neg at H
    have hb : ∀ α ∈ ρ, W.valuation (ε : Ω) ≤ W.valuation ((x : Ω) - α) := by
      intro α hα
      apply s3 x ε α hx
      intro h hm
      have h2 : U ⟨α, h⟩ ∣ ε := by rw [← hEval α h hm]; exact hEdvd α hα
      exact (H α hα h hm).trans h2
    exact (s1 x hx).trans (s4 g x ε hb)

theorem wcpa_dj_llsm_smid_zero_free_const : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (R : Type u) [CommRing R] [IsDomain R] [Algebra ↥W R] (𝔯 : Ideal R) (τ u : R),
    wcLlsPD W R 𝔯 (.disc τ) →
    (∀ θ : R →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔯 → θ u ≠ 0) →
    ∀ θ₁ θ₂ : R →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ₁ = 𝔯 →
      (IsLocalRing.maximalIdeal ↥W).comap θ₂ = 𝔯 → θ₁ u ∣ θ₂ u :=
by
  intro Ω _ _ W hW hWt R _ _ _ 𝔯 τ u hPD hzero θ₁ θ₂ h₁ h₂
  classical

  have hunit : ∀ θ : R →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔯 →
      ∀ x : R, x ∉ 𝔯 → IsUnit (θ x) := by
    intro θ hθ x hx
    by_contra hu
    apply hx
    rw [← hθ, Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact hu
  have hmem : ∀ θ : R →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔯 →
      ∀ x : R, x ∈ 𝔯 → θ x ∈ IsLocalRing.maximalIdeal ↥W := by
    intro θ hθ x hx
    rw [← hθ, Ideal.mem_comap] at hx
    exact hx
  have hev : ∀ (θ : R →ₐ[↥W] ↥W) (g : Polynomial ↥W),
      θ (Polynomial.aeval τ g) = g.eval (θ τ) := by
    intro θ g
    rw [← Polynomial.aeval_algHom_apply, Polynomial.coe_aeval_eq_eval]
  have hPD' := hPD
  unfold wcLlsPD at hPD'
  obtain ⟨_, _, _, h𝔯max, _, hτ𝔯, _, h, hh, f, hfC, hfX, hfet⟩ := hPD'

  have lip : ∀ θ θ' : R →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔯 →
      (IsLocalRing.maximalIdeal ↥W).comap θ' = 𝔯 → ∀ x : R, θ τ - θ' τ ∣ θ x - θ' x := by
    intro θ θ' hθ hθ' x
    obtain ⟨ev, _, _, hfac⟩ :=
      wcLlsAS_dsbu_section Ω W hW hWt R 𝔯 τ (θ' τ) hPD (hmem θ' hθ' τ hτ𝔯)
    obtain ⟨s, e, hs, hse⟩ := hfac x
    have h1 := congrArg θ' hse
    have h2 := congrArg θ hse
    simp only [map_mul, map_sub, AlgHom.commutes, Algebra.algebraMap_self,
      RingHom.id_apply] at h1 h2
    rw [sub_self, zero_mul, (hunit θ' hθ' s hs).mul_right_eq_zero, sub_eq_zero] at h1
    rw [h1, ← (hunit θ hθ s hs).dvd_mul_left, h2]
    exact dvd_mul_right _ _

  haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
  have rank1 : ∀ x π : ↥W, x ≠ 0 → π ∈ IsLocalRing.maximalIdeal ↥W → ∃ N : ℕ, x ∣ π ^ N := by
    intro x π hx hπ
    have hrad : π ∈ (Ideal.span {x}).radical := by
      rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
      rintro J ⟨hJx, hJp⟩
      have hJ0 : J ≠ ⊥ := by
        intro hJ
        apply hx
        have hxJ : x ∈ J := hJx (Ideal.mem_span_singleton_self x)
        rw [hJ] at hxJ
        exact (Submodule.mem_bot _).mp hxJ
      have hJm := Ideal.isMaximal_of_isPrime_of_ne_bot J hJ0
      rw [IsLocalRing.eq_maximalIdeal hJm]
      exact hπ
    obtain ⟨N, hN⟩ := hrad
    exact ⟨N, Ideal.mem_span_singleton.mp hN⟩

  have taylor : ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → ∀ (x : R) (J : ℕ),
      ∃ w : ℕ → ↥W, ∀ θ : R →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔯 →
        (θ τ - c) ^ J ∣ θ x - ∑ j ∈ Finset.range J, w j * (θ τ - c) ^ j := by
    intro c hc x J
    have h1 : (1 : R) ∉ 𝔯 := fun h1 => h𝔯max.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
    obtain ⟨w, a, s, hs, heq⟩ :=
      wcFrfCp_taylor Ω W hW hWt R (FractionRing R) 𝔯 τ c hPD hc x 1 h1 J
    refine ⟨w, fun θ hθ => ?_⟩
    have hs0 : s ≠ 0 := fun h0 => hs (h0 ▸ 𝔯.zero_mem)
    have hsK : algebraMap R (FractionRing R) s ≠ 0 := by
      intro h0
      apply hs0
      apply IsFractionRing.injective R (FractionRing R)
      rw [h0, map_zero]
    have key : s * x = s * ∑ j ∈ Finset.range J, algebraMap ↥W R (w j) *
        (τ - algebraMap ↥W R c) ^ j + (τ - algebraMap ↥W R c) ^ J * a := by
      apply IsFractionRing.injective R (FractionRing R)
      rw [map_one, div_one] at heq
      simp only [map_add, map_mul, map_sum, map_pow]
      rw [heq]
      field_simp
    have h2 := congrArg θ key
    simp only [map_add, map_mul, map_sum, map_pow, map_sub, AlgHom.commutes,
      Algebra.algebraMap_self, RingHom.id_apply] at h2
    rw [← (hunit θ hθ s hs).dvd_mul_left, mul_sub, h2, add_sub_cancel_left]
    exact dvd_mul_right _ _

  have trans : ∀ g : Polynomial ↥W, Polynomial.aeval τ g = 0 → g = 0 := by
    intro g hg
    have hroot : ∀ y ∈ IsLocalRing.maximalIdeal ↥W, g.IsRoot y := by
      intro y hy
      obtain ⟨θ, hθτ, -⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt R 𝔯 τ hPD y hy
      have h1 := congrArg θ hg
      rw [map_zero, hev, hθτ] at h1
      exact h1
    obtain ⟨ω, hω⟩ : ∃ ω : Ω, ω ∉ W := by
      by_contra hc
      push_neg at hc
      exact hWt (eq_top_iff.mpr fun x _ => hc x)
    have hω0 : ω ≠ 0 := fun h0 => hω (h0 ▸ W.zero_mem)
    have hωi : ω⁻¹ ∈ W := (W.mem_or_inv_mem ω).resolve_left hω
    obtain ⟨π, hπ⟩ : ∃ π : ↥W, (π : Ω) = ω⁻¹ := ⟨⟨ω⁻¹, hωi⟩, rfl⟩
    have hπ0 : π ≠ 0 := by
      intro h0
      apply hω0
      have : (π : Ω) = 0 := by rw [h0]; rfl
      rw [hπ] at this
      exact inv_eq_zero.mp this
    have hπnu : ¬ IsUnit π := by
      intro hu
      obtain ⟨κ, hκ⟩ := hu.exists_right_inv
      have h1 : (π : Ω) * (κ : Ω) = 1 := by exact_mod_cast congrArg Subtype.val hκ
      rw [hπ, inv_mul_eq_one₀ hω0] at h1
      exact hω (h1 ▸ κ.2)
    have hmemk : ∀ k : ℕ, π ^ (k + 1) ∈ IsLocalRing.maximalIdeal ↥W := by
      intro k
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      exact hπnu (isUnit_pow_succ_iff.mp hu)
    have hinj : Function.Injective (fun k : ℕ => π ^ (k + 1)) := by
      have aux : ∀ a b : ℕ, a < b → π ^ (a + 1) ≠ π ^ (b + 1) := by
        intro a b hab heq
        have h3 : π ^ (a + 1) * π ^ (b - a) = π ^ (a + 1) * 1 := by
          rw [← pow_add, mul_one, heq]
          congr 1
          omega
        have h4 := mul_left_cancel₀ (pow_ne_zero _ hπ0) h3
        obtain ⟨k, hk⟩ : ∃ k, b - a = k + 1 := ⟨b - a - 1, by omega⟩
        rw [hk, pow_succ] at h4
        exact hπnu (IsUnit.of_mul_eq_one (π ^ k) (by rw [mul_comm]; exact h4))
      intro a b hab
      by_contra hne
      rcases Nat.lt_or_gt_of_ne hne with hlt | hlt
      · exact aux a b hlt hab
      · exact aux b a hlt hab.symm
    apply Polynomial.eq_zero_of_infinite_isRoot
    exact Set.infinite_of_injective_forall_mem hinj (fun k => hroot _ (hmemk k))

  have hh0 : h ≠ 0 := fun h0 => hh (h0 ▸ 𝔯.zero_mem)
  obtain ⟨θ0, -, hθ0c⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt R 𝔯 τ hPD 0
    (IsLocalRing.maximalIdeal ↥W).zero_mem
  have hu0 : u ≠ 0 := fun hu => hzero θ0 hθ0c (by rw [hu, map_zero])
  obtain ⟨n, φ, hφ0, hrel⟩ :=
    wcpa_dj_llsm_zfc_alg_relation (↥W) R τ h u hh0 hu0 trans f hfC hfX hfet
  have hpts : ∀ y : ↥W, ∃ θ : R →ₐ[↥W] ↥W, y ∈ IsLocalRing.maximalIdeal ↥W →
      θ τ = y ∧ (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔯 := by
    intro y
    by_cases hy : y ∈ IsLocalRing.maximalIdeal ↥W
    · obtain ⟨θ, e1, e2⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt R 𝔯 τ hPD y hy
      exact ⟨θ, fun _ => ⟨e1, e2⟩⟩
    · exact ⟨θ0, fun hy' => absurd hy' hy⟩
  choose Θ hΘ using hpts
  obtain ⟨δ, hδ0, hδ⟩ := wcpa_dj_llsm_zfc_lower_bound Ω W (fun y => Θ y u) n φ hφ0
    (fun x hx => hzero (Θ x) (hΘ x hx).2)
    (fun x hx y hy => by
      have e := lip (Θ x) (Θ y) (hΘ x hx).2 (hΘ y hy).2 u
      rwa [(hΘ x hx).1, (hΘ y hy).1] at e)
    (fun x hx => by
      have e := congrArg (Θ x) hrel
      simp only [map_sum, map_mul, map_pow, map_zero, hev, (hΘ x hx).1] at e
      exact e)
  have star : ∀ θ : R →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔯 → θ u ∣ δ := by
    intro θ hθ
    have hx := hmem θ hθ τ hτ𝔯
    have e := lip θ (Θ (θ τ)) hθ (hΘ _ hx).2 u
    rw [(hΘ _ hx).1, sub_self, zero_dvd_iff, sub_eq_zero] at e
    rw [e]
    exact hδ _ hx

  have hc := hmem θ₁ h₁ τ hτ𝔯
  have hx2 := hmem θ₂ h₂ τ hτ𝔯
  have hzm : θ₂ τ - θ₁ τ ∈ IsLocalRing.maximalIdeal ↥W := Ideal.sub_mem _ hx2 hc
  by_cases hz : θ₂ τ - θ₁ τ = 0
  · have e := lip θ₂ θ₁ h₂ h₁ u
    rw [hz, zero_dvd_iff, sub_eq_zero] at e
    rw [e]
  · obtain ⟨N, hN⟩ := rank1 δ (θ₂ τ - θ₁ τ) hδ0 hzm
    obtain ⟨w, hw⟩ := taylor (θ₁ τ) hc u (N + 1)
    let P : Polynomial ↥W := ∑ j ∈ Finset.range (N + 1), Polynomial.C (w j) * Polynomial.X ^ j
    have hPe : ∀ y, P.eval y = ∑ j ∈ Finset.range (N + 1), w j * y ^ j := by
      intro y
      simp [P, Polynomial.eval_finset_sum]
    have hP0 : P.eval 0 = θ₁ u := by
      have e := hw θ₁ h₁
      rw [sub_self, zero_pow (by omega : N + 1 ≠ 0), zero_dvd_iff, sub_eq_zero] at e
      rw [hPe, e]
    have hf0 : P.eval 0 ≠ 0 := by rw [hP0]; exact hzero θ₁ h₁
    rcases wcpa_dj_llsm_zfc_poly_root_or_dvd Ω W P (θ₂ τ - θ₁ τ) hf0 with hdiv | ⟨ζ, hzζ, hζ⟩
    · rw [hP0] at hdiv
      have h3 := hw θ₂ h₂
      rw [← hPe] at h3
      have h4 : θ₁ u ∣ θ₂ u - P.eval (θ₂ τ - θ₁ τ) :=
        ((star θ₁ h₁).trans hN).trans ((pow_dvd_pow _ (Nat.le_succ N)).trans h3)
      have e := dvd_add h4 hdiv
      rwa [sub_add_cancel] at e
    · exfalso
      have hζm : ζ ∈ IsLocalRing.maximalIdeal ↥W := by
        obtain ⟨k, hk⟩ := hzζ
        rw [hk]
        exact Ideal.mul_mem_right _ _ hzm
      obtain ⟨θy, hθyτ, hθyc⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt R 𝔯 τ hPD
        (θ₁ τ + ζ) (Ideal.add_mem _ hc hζm)
      have h3 := hw θy hθyc
      rw [hθyτ, add_sub_cancel_left, ← hPe, hζ, sub_zero] at h3
      have h5 : (θ₂ τ - θ₁ τ) ^ (N + 1) ∣ (θ₂ τ - θ₁ τ) ^ N :=
        (pow_dvd_pow_of_dvd hzζ _).trans (h3.trans ((star θy hθyc).trans hN))
      obtain ⟨k, hk⟩ := h5
      rw [pow_succ, mul_assoc] at hk
      have h6 : (θ₂ τ - θ₁ τ) ^ N * 1 = (θ₂ τ - θ₁ τ) ^ N * ((θ₂ τ - θ₁ τ) * k) := by
        rw [mul_one]
        exact hk
      have h7 := mul_left_cancel₀ (pow_ne_zero N hz) h6
      have hzu : IsUnit (θ₂ τ - θ₁ τ) := IsUnit.of_mul_eq_one k h7.symm
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hzm
      exact hzm hzu

theorem wcpa_dj_llsm_sm_image_disc : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M L : Type u) [Field M] [Field L] [Algebra K M] [Algebra M L]
    [Algebra K L] [Algebra A M] [Algebra A L] [IsScalarTower A K M] [IsScalarTower K M L]
    [IsScalarTower A K L] [IsScalarTower A M L] [FiniteDimensional K L] [IsGalois K L]
    [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    [Algebra B L] [IsScalarTower B M L] [IsScalarTower A B L]
    (𝔭 : Ideal A) (t : A) (h : A) (𝔮 : Ideal B) (t' : B) (y : Ideal ↥(integralClosure A L))
    (y' : Ideal ↥(integralClosure B L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y → Group.IsSolvable (L ≃ₐ[K] L) →
    wcLlsSolvPt W B M L 𝔮 (.disc t') y' → wcLlsUniq B L 𝔮 y' →
    ∀ c₃ b₃ : ↥W, c₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ∈ IsLocalRing.maximalIdeal ↥W →
      b₃ ≠ 0 → wcLlsDiscSep W B M L t' c₃ b₃ →
      (∀ c'' b'' : ↥W, c'' ∈ IsLocalRing.maximalIdeal ↥W → b'' ∈ IsLocalRing.maximalIdeal ↥W →
        b'' ≠ 0 → wcLlsDiscSep W B M L t' c'' b'' → b₃ ∣ b'' → b₃ ∣ c'' - c₃ → b'' ∣ b₃) →
      ∃ c b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W ∧ b ∈ IsLocalRing.maximalIdeal ↥W ∧
        b ≠ 0 ∧ wcLlsSmPre W A B 𝔮 t t' c b c₃ b₃ :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M L _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ B _ _ _ _ _ _ _ _ _ _ _
    𝔭 t h 𝔮 t' y y' hPD hSmc hSolv hUniq hGsolv hSolv' hUniq' c₃ b₃ hc₃ hb₃m hb₃0 hsep₃ _hmax₃
  classical
  haveI : FiniteDimensional M L := Module.Finite.of_restrictScalars_finite K M L
  haveI : IsGalois M L := IsGalois.tower_top_of_isGalois K M L

  have hunit : ∀ (R : Type u) [CommRing R] [Algebra ↥W R] (𝔯 : Ideal R) (θ : R →ₐ[↥W] ↥W),
      (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔯 → ∀ x : R, x ∉ 𝔯 → IsUnit (θ x) := by
    intro R _ _ 𝔯 θ hθ x hx
    by_contra hu
    apply hx
    rw [← hθ, Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact hu
  have hmem : ∀ (R : Type u) [CommRing R] [Algebra ↥W R] (𝔯 : Ideal R) (θ : R →ₐ[↥W] ↥W),
      (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔯 → ∀ x : R, x ∈ 𝔯 →
      θ x ∈ IsLocalRing.maximalIdeal ↥W := by
    intro R _ _ 𝔯 θ hθ x hx
    rw [← hθ, Ideal.mem_comap] at hx
    exact hx

  have huniq : ∀ (R : Type u) [CommRing R] [IsDomain R] [Algebra ↥W R] (𝔯 : Ideal R) (τ : R),
      wcLlsPD W R 𝔯 (.disc τ) → ∀ θ₁ θ₂ : R →ₐ[↥W] ↥W,
      (IsLocalRing.maximalIdeal ↥W).comap θ₁ = 𝔯 → (IsLocalRing.maximalIdeal ↥W).comap θ₂ = 𝔯 →
      θ₁ τ = θ₂ τ → ∀ x : R, θ₁ x = θ₂ x := by
    intro R _ _ _ 𝔯 τ hPDR θ₁ θ₂ h₁ h₂ hτ x
    have hPDR' := hPDR
    unfold wcLlsPD at hPDR'
    obtain ⟨_, _, _, _, _, hτ𝔯, _, _⟩ := hPDR'
    have hc : θ₁ τ ∈ IsLocalRing.maximalIdeal ↥W := hmem R 𝔯 θ₁ h₁ τ hτ𝔯
    obtain ⟨ev, _, _, hfac⟩ := wcLlsAS_dsbu_section Ω W hW hWt R 𝔯 τ (θ₁ τ) hPDR hc
    have key : ∀ θ : R →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔯 → θ τ = θ₁ τ →
        θ x = ev x := by
      intro θ hθ hθτ
      obtain ⟨s, e, hs, hse⟩ := hfac x
      have h1 := congrArg θ hse
      simp only [map_mul, map_sub, AlgHom.commutes, Algebra.algebraMap_self,
        RingHom.id_apply] at h1
      rw [hθτ, sub_self, zero_mul, (hunit R 𝔯 θ hθ s hs).mul_right_eq_zero, sub_eq_zero] at h1
      exact h1
    rw [key θ₁ h₁ rfl, key θ₂ h₂ hτ.symm]

  have V2 : ∀ e : ℕ, 0 < e → ∀ β : ↥W, β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 →
      ∃ γ : ↥W, γ ∈ IsLocalRing.maximalIdeal ↥W ∧ γ ≠ 0 ∧ γ ^ e = β := by
    intro e he β hβm hβ0
    obtain ⟨ω, hω⟩ := IsAlgClosed.exists_pow_nat_eq (β : Ω) he
    have hβn : ¬ IsUnit β := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hβm
      exact hβm
    have hω0 : ω ≠ 0 := by
      rintro rfl
      have h0 : (β : Ω) = 0 := by rw [← hω, zero_pow he.ne']
      exact hβ0 (Subtype.ext (by rw [h0] <;> rfl))
    rcases W.mem_or_inv_mem ω with hω' | hω'
    · have hpow : (⟨ω, hω'⟩ : ↥W) ^ e = β := Subtype.ext (by simp [hω])
      refine ⟨⟨ω, hω'⟩, ?_, ?_, hpow⟩
      · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        exact hβn (hpow ▸ hu.pow e)
      · intro h0
        apply hω0
        exact congrArg Subtype.val h0
    · exfalso
      apply hβn
      refine IsUnit.of_mul_eq_one ((⟨ω⁻¹, hω'⟩ : ↥W) ^ e) ?_
      apply Subtype.ext
      have h1 : ((β * (⟨ω⁻¹, hω'⟩ : ↥W) ^ e : ↥W) : Ω) = (β : Ω) * (ω⁻¹) ^ e := by simp
      rw [h1, ← hω, ← mul_pow, mul_inv_cancel₀ hω0, one_pow] <;> rfl

  have hval : ∀ (s : Finset (M ≃ₐ[K] M)) (x : (M ≃ₐ[K] M) → ↥W) (b : ↥W), b ≠ 0 →
      s.Nonempty → (∀ i ∈ s, ¬ b ∣ x i) → ¬ b ^ s.card ∣ ∏ i ∈ s, x i := by
    intro s x b hb hs hx hdiv
    have hy : ∀ i ∈ s, ∃ yi : ↥W, b = x i * yi := fun i hi =>
      (ValuationRing.dvd_total b (x i)).resolve_left (hx i hi)
    choose! yy hyy using hy
    have hprod : b ^ s.card = (∏ i ∈ s, x i) * ∏ i ∈ s, yy i := by
      rw [← Finset.prod_mul_distrib, ← Finset.prod_const]
      exact Finset.prod_congr rfl hyy
    obtain ⟨z, hz⟩ := hdiv
    rw [hz, mul_assoc] at hprod
    have hb' : b ^ s.card ≠ 0 := pow_ne_zero _ hb
    have h1 : z * ∏ i ∈ s, yy i = 1 :=
      (mul_left_cancel₀ hb' (hprod.symm.trans (mul_one _).symm))
    have hPu : IsUnit (∏ i ∈ s, yy i) := IsUnit.of_mul_eq_one z (by rw [mul_comm]; exact h1)
    obtain ⟨i, hi⟩ := hs
    have hyu : IsUnit (yy i) := isUnit_of_dvd_unit (Finset.dvd_prod_of_mem yy hi) hPu
    have hdx : b ∣ x i * yy i := ⟨1, by rw [mul_one]; exact (hyy i hi).symm⟩
    exact hx i hi (hyu.dvd_mul_right.mp hdx)

  have hSmc' := hSmc
  unfold wcLlsSmc at hSmc'
  obtain ⟨hh𝔭, hint, hPDB, hcomap, -⟩ := hSmc'
  have hPD' := hPD
  unfold wcLlsPD at hPD'
  obtain ⟨_, _, hAic, -, -, ht𝔭, -, -⟩ := hPD'
  haveI : IsIntegrallyClosed A := hAic
  have hhB : algebraMap A B h ∉ 𝔮 := by
    intro hin
    apply hh𝔭
    rw [← hcomap]
    exact hin
  have htB : algebraMap A B t ∈ 𝔮 := by
    rw [← hcomap] at ht𝔭
    exact ht𝔭
  have hres : ∀ θ' : B →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ' = 𝔮 →
      (IsLocalRing.maximalIdeal ↥W).comap (θ'.comp (IsScalarTower.toAlgHom ↥W A B)) = 𝔭 := by
    intro θ' hθ'
    rw [← hcomap, ← hθ']
    ext x
    exact Iff.rfl

  have hgr := fun σ : M ≃ₐ[K] M =>
    wcpa_dj_llsm_smid_galois_restrict Ω W hW hWt A K M B 𝔭 t h 𝔮 t' hPD hSmc σ
  choose φ hφM hφA hφ𝔮 hφPD using hgr

  have hGS : ∀ σ : M ≃ₐ[K] M, ∀ θ' : B →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ' = 𝔮 →
      (b₃ ∣ θ' (φ σ t') - c₃ ↔ b₃ ∣ θ' t' - c₃) := by
    intro σ θ' hθ'
    have hsepσ : wcLlsDiscSep W B M L (φ σ t') c₃ b₃ :=
      (wcpa_dj_llsm_smid_discsep_transport Ω W K M L B σ (φ σ) (hφM σ) t' c₃ b₃).mpr hsep₃
    exact wcpa_dj_llsm_smid_coord_disc_stable Ω W hW hWt B M L 𝔮 t' (φ σ t') y' hPDB (hφPD σ)
      hSolv' hUniq' c₃ b₃ hc₃ hb₃m hb₃0 hsep₃ hsepσ θ' hθ'

  obtain ⟨F, hFdef⟩ : ∃ F : B, F = ∏ σ : M ≃ₐ[K] M, (φ σ t' - algebraMap ↥W B c₃) := ⟨_, rfl⟩
  have hφmul : ∀ τ σ : M ≃ₐ[K] M, ∀ x : B, φ τ (φ σ x) = φ (τ * σ) x := by
    intro τ σ x
    apply IsFractionRing.injective B M
    rw [hφM, hφM, hφM, AlgEquiv.mul_apply]
  have hφ1 : ∀ x : B, φ 1 x = x := fun x =>
    IsFractionRing.injective B M (by rw [hφM, AlgEquiv.one_apply])
  have hFfix : ∀ τ : M ≃ₐ[K] M, φ τ F = F := by
    intro τ
    rw [hFdef, map_prod]
    simp only [map_sub, AlgEquiv.commutes, hφmul]
    exact Fintype.prod_equiv (Equiv.mulLeft τ) _ _ (fun σ => rfl)
  have hFM : ∀ τ : M ≃ₐ[K] M, τ (algebraMap B M F) = algebraMap B M F := fun τ => by
    rw [← hφM, hFfix]
  obtain ⟨k, hk⟩ := (hint (algebraMap B M F)).mp ⟨F, rfl⟩
  have hfixY : ∀ τ : M ≃ₐ[K] M, τ (algebraMap A M h ^ k * algebraMap B M F) =
      algebraMap A M h ^ k * algebraMap B M F := by
    intro τ
    rw [map_mul, map_pow, IsScalarTower.algebraMap_apply A K M h, AlgEquiv.commutes, hFM τ]
  obtain ⟨κ₀, hκ₀⟩ := IntermediateField.mem_bot.mp ((IsGalois.mem_bot_iff_fixed _).mpr hfixY)
  rw [← hκ₀] at hk
  have hk' : IsIntegral A κ₀ := isIntegral_algebraMap_iff.mp hk
  obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp hk'
  have haF : algebraMap A B a = algebraMap A B h ^ k * F := by
    apply IsFractionRing.injective B M
    rw [← IsScalarTower.algebraMap_apply A B M, IsScalarTower.algebraMap_apply A K M, ha, hκ₀,
      map_mul, map_pow, ← IsScalarTower.algebraMap_apply A B M]

  have hθF : ∀ θ' : B →ₐ[↥W] ↥W, θ' F = ∏ σ : M ≃ₐ[K] M, (θ' (φ σ t') - c₃) := by
    intro θ'
    rw [hFdef, map_prod]
    simp only [map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]
  obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : ℕ, ℓ = (Finset.univ : Finset (M ≃ₐ[K] M)).card := ⟨_, rfl⟩
  have hD : ∀ θ' : B →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ' = 𝔮 →
      (b₃ ∣ θ' t' - c₃ ↔ b₃ ^ ℓ ∣ θ' F) := by
    intro θ' hθ'
    rw [hθF]
    constructor
    · intro hd
      rw [hℓ, ← Finset.prod_const]
      exact Finset.prod_dvd_prod_of_dvd _ _ (fun σ _ => (hGS σ θ' hθ').mpr hd)
    · intro hd
      by_contra hnd
      apply hval Finset.univ (fun σ => θ' (φ σ t') - c₃) b₃ hb₃0 Finset.univ_nonempty
        (fun σ _ hσ => hnd ((hGS σ θ' hθ').mp hσ))
      rw [← hℓ]
      exact hd

  obtain ⟨θ₀, hθ₀t, hθ₀c⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt B 𝔮 t' hPDB c₃ hc₃
  have hc : θ₀ (algebraMap A B t) ∈ IsLocalRing.maximalIdeal ↥W := hmem B 𝔮 θ₀ hθ₀c _ htB
  have hEdiv : ∀ θ' : B →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ' = 𝔮 → ∀ x : ↥W,
      (x ∣ (θ'.comp (IsScalarTower.toAlgHom ↥W A B)) a ↔ x ∣ θ' F) := by
    intro θ' hθ' x
    show x ∣ θ' (algebraMap A B a) ↔ _
    rw [haF, map_mul, map_pow]
    exact ((hunit B 𝔮 θ' hθ' _ hhB).pow k).dvd_mul_left

  have hF0 : ∀ θ : A →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔭 → θ a = 0 →
      θ t = θ₀ (algebraMap A B t) := by
    intro θ hθ hθa
    obtain ⟨θ', hθ'A, hθ'c⟩ :=
      wcpa_dj_llsm_sm_point_lift Ω W hW hWt A K M B 𝔭 t h 𝔮 t' hPD hSmc θ hθ
    have h1 : θ' F = 0 := by
      have h2 := hθ'A a
      rw [haF, map_mul, map_pow, hθa] at h2
      exact ((hunit B 𝔮 θ' hθ'c _ hhB).pow k).mul_right_eq_zero.mp h2
    rw [hθF, Finset.prod_eq_zero_iff] at h1
    obtain ⟨σ, -, hσ⟩ := h1
    rw [sub_eq_zero] at hσ
    have hc'' : (IsLocalRing.maximalIdeal ↥W).comap (θ'.comp (φ σ).toAlgHom) = 𝔮 := by
      ext x
      show θ' (φ σ x) ∈ IsLocalRing.maximalIdeal ↥W ↔ x ∈ 𝔮
      rw [← hφ𝔮 σ x, ← hθ'c]
      rfl
    have h3 := huniq B 𝔮 t' hPDB (θ'.comp (φ σ).toAlgHom) θ₀ hc'' hθ₀c
      (by show θ' (φ σ t') = θ₀ t'; rw [hσ, hθ₀t]) (algebraMap A B t)
    have h4 : θ' (φ σ (algebraMap A B t)) = θ₀ (algebraMap A B t) := h3
    rw [hφA] at h4
    rw [← hθ'A t]
    exact h4

  obtain ⟨d, S, u, hS𝔭, hSa, hu0⟩ :=
    wcpa_dj_llsm_smid_peel Ω W hW hWt A 𝔭 t a (θ₀ (algebraMap A B t)) hPD hc hF0
  have hunz : ∀ θ : A →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔭 → θ u ≠ 0 := by
    intro θ hθ hθu
    have h1 := congrArg θ hSa
    simp only [map_mul, map_pow, map_sub, AlgHom.commutes, Algebra.algebraMap_self,
      RingHom.id_apply] at h1
    rw [hθu, mul_zero, (hunit A 𝔭 θ hθ S hS𝔭).mul_right_eq_zero] at h1
    exact hu0 θ hθ (hF0 θ hθ h1) hθu
  obtain ⟨θ₀A, hθ₀A⟩ : ∃ θ : A →ₐ[↥W] ↥W, ∀ x : A, θ x = θ₀ (algebraMap A B x) :=
    ⟨θ₀.comp (IsScalarTower.toAlgHom ↥W A B), fun _ => rfl⟩
  have hθ₀Ac : (IsLocalRing.maximalIdeal ↥W).comap θ₀A = 𝔭 := by
    rw [← hcomap, ← hθ₀c]
    ext x
    rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, hθ₀A]
  have hγ0 : θ₀A u ≠ 0 := hunz θ₀A hθ₀Ac
  have hstar : ∀ θ : A →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔭 → ∀ x : ↥W,
      (x ∣ θ a ↔ x ∣ θ₀A u * (θ t - θ₀ (algebraMap A B t)) ^ d) := by
    intro θ hθ x
    have h1 := congrArg θ hSa
    simp only [map_mul, map_pow, map_sub, AlgHom.commutes, Algebra.algebraMap_self,
      RingHom.id_apply] at h1
    have hassoc : Associated (θ u) (θ₀A u) :=
      associated_of_dvd_dvd
        (wcpa_dj_llsm_smid_zero_free_const Ω W hW hWt A 𝔭 t u hPD hunz θ θ₀A hθ hθ₀Ac)
        (wcpa_dj_llsm_smid_zero_free_const Ω W hW hWt A 𝔭 t u hPD hunz θ₀A θ hθ₀Ac hθ)
    refine ((hunit A 𝔭 θ hθ S hS𝔭).dvd_mul_left).symm.trans ?_
    rw [h1, mul_comm (θ₀A u)]
    exact (Associated.mul_left _ hassoc).dvd_iff_dvd_right

  have hθ₀F : θ₀ F = 0 := by
    rw [hθF]
    exact Finset.prod_eq_zero (Finset.mem_univ 1) (by rw [hφ1, hθ₀t, sub_self])
  have hθ₀a : θ₀A a = 0 := by
    rw [hθ₀A, haF, map_mul, hθ₀F, mul_zero]
  have hd0 : d ≠ 0 := by
    intro hd
    have h1 := (hstar θ₀A hθ₀Ac 0).mp (by simp [hθ₀a])
    rw [hd, pow_zero, mul_one, zero_dvd_iff] at h1
    exact hγ0 h1

  obtain ⟨β, hβm, hβ0, hβ2⟩ := V2 2 two_pos b₃ hb₃m hb₃0
  have hβnu : ¬ IsUnit β := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hβm
    exact hβm
  have hnd : ¬ b₃ ∣ β := by
    rintro ⟨y₀, hy₀⟩
    rw [← hβ2, pow_two, mul_assoc] at hy₀
    have h1 : β * 1 = β * (β * y₀) := by rw [mul_one]; exact hy₀
    exact hβnu (IsUnit.of_mul_eq_one y₀ (mul_left_cancel₀ hβ0 h1).symm)
  obtain ⟨θ₂, hθ₂t, hθ₂c⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt B 𝔮 t' hPDB (c₃ + β)
    (Ideal.add_mem _ hc₃ hβm)
  have h2 : ¬ b₃ ^ ℓ ∣ θ₀A u := by
    intro hdiv
    apply hnd
    have h3 : b₃ ^ ℓ ∣ θ₂ F := by
      rw [← hEdiv θ₂ hθ₂c, hstar _ (hres θ₂ hθ₂c)]
      exact dvd_mul_of_dvd_left hdiv _
    have h4 := (hD θ₂ hθ₂c).mpr h3
    rwa [hθ₂t, add_sub_cancel_left] at h4
  obtain ⟨w, hw⟩ := (ValuationRing.dvd_total (b₃ ^ ℓ) (θ₀A u)).resolve_left h2
  have hwnu : ¬ IsUnit w := fun hwu => h2 (by rw [hw]; exact hwu.mul_right_dvd.mpr dvd_rfl)
  have hwm : w ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact hwnu
  have hw0 : w ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hw
    exact pow_ne_zero _ hb₃0 hw
  obtain ⟨b, hbm, hb0, hbd⟩ := V2 d (Nat.pos_of_ne_zero hd0) w hwm hw0

  refine ⟨θ₀ (algebraMap A B t), b, hc, hbm, hb0, ?_⟩
  unfold wcLlsSmPre
  intro θ' hθ'
  have hθ := hres θ' hθ'
  calc b ∣ θ' (algebraMap A B t) - θ₀ (algebraMap A B t)
      ↔ b ^ d ∣ (θ' (algebraMap A B t) - θ₀ (algebraMap A B t)) ^ d :=
        (IsIntegrallyClosed.pow_dvd_pow_iff hd0).symm
    _ ↔ θ₀A u * b ^ d ∣ θ₀A u * (θ' (algebraMap A B t) - θ₀ (algebraMap A B t)) ^ d :=
        (mul_dvd_mul_iff_left hγ0).symm
    _ ↔ b₃ ^ ℓ ∣ θ₀A u * (θ' (algebraMap A B t) - θ₀ (algebraMap A B t)) ^ d := by
        rw [hbd, ← hw]
    _ ↔ b₃ ^ ℓ ∣ (θ'.comp (IsScalarTower.toAlgHom ↥W A B)) a := (hstar _ hθ _).symm
    _ ↔ b₃ ^ ℓ ∣ θ' F := hEdiv θ' hθ' _
    _ ↔ b₃ ∣ θ' t' - c₃ := (hD θ' hθ').symm

theorem wcpa_dj_llsm_nss_smooth_middle : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ n : ℕ, wcLlsChartThm W (· < n) →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M L : Type u) [Field M] [Field L] [Algebra K M] [Algebra M L]
    [Algebra K L] [Algebra A M] [Algebra A L] [IsScalarTower A K M] [IsScalarTower K M L]
    [IsScalarTower A K L] [IsScalarTower A M L] [FiniteDimensional K L] [IsGalois K L]
    [FiniteDimensional K M] [IsGalois K M]
    (𝔭 : Ideal A) (t : A) (y : Ideal ↥(integralClosure A L)) (z : Ideal ↥(integralClosure A M)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y →
    Group.IsSolvable (L ≃ₐ[K] L) → Nat.card (L ≃ₐ[M] L) < n →
    ∀ (_ : z.IsPrime), z.comap (algebraMap A ↥(integralClosure A M)) = 𝔭 → wcLlsUniq A M 𝔭 z →
    wcpaDjLkDelta (wcLlsFS W ((algebraMap A M).comp (algebraMap ↥W A)) A z) = 0 →
    wcLlsLocMax W A K L (.disc t) :=
by
  intro Ω _ _ W hW hWt n IH A _ _ _ K _ _ _ M L _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ 𝔭 t y z hPD hSolv
    hUniq hGsolv hcard hzP hzc hzU hδ
  haveI : FiniteDimensional M L := Module.Finite.of_restrictScalars_finite K M L
  haveI : IsGalois M L := IsGalois.tower_top_of_isGalois K M L

  obtain ⟨τ, hτz, hRdom, hτ0, hτnu, hτgen⟩ :=
    wcpa_dj_llsm_sm_fs_uniformizer Ω W hW hWt A K M 𝔭 t z hPD hzP hzc hzU hδ

  obtain ⟨B, _, _, _, _, _, _, _, _, h, 𝔮, t', hSmc⟩ :=
    wcpa_dj_llsm_sm_chart_of_uniformizer Ω W hW hWt A K M 𝔭 t z hPD hzP hzc hzU hδ τ hτz hRdom
      hτ0 hτnu hτgen
  letI : Algebra B L := ((algebraMap M L).comp (algebraMap B M)).toAlgebra
  haveI : IsScalarTower B M L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : IsScalarTower A B L := IsScalarTower.of_algebraMap_eq (fun x => by
    show algebraMap A L x = algebraMap M L (algebraMap B M (algebraMap A B x))
    rw [← IsScalarTower.algebraMap_apply A B M x, ← IsScalarTower.algebraMap_apply A M L x])
  have hPDB : wcLlsPD W B 𝔮 (.disc t') := hSmc.2.2.1

  obtain ⟨y', hSolv', hUniq'⟩ := wcpa_dj_llsm_sm_lift_point Ω W hW hWt A K M L B 𝔭 t h 𝔮 t' y
    hPD hSmc hSolv hUniq hGsolv
  have hcard' : Nat.card ↥(wcLlsDec B M L y') < n :=
    lt_of_le_of_lt (Subgroup.card_le_card_group _) hcard

  obtain ⟨c₃, b₃, hc₃, hb₃m, hb₃0, hsep₃, hmax₃⟩ := IH B M L 𝔮 (.disc t') y' hPDB hSolv' hcard'

  obtain ⟨c, b, hc, hbm, hb0, hPre₃⟩ := wcpa_dj_llsm_sm_image_disc Ω W hW hWt A K M L B 𝔭 t h 𝔮
    t' y y' hPD hSmc hSolv hUniq hGsolv hSolv' hUniq' c₃ b₃ hc₃ hb₃m hb₃0 hsep₃ hmax₃

  have hsepA : wcLlsDiscSep W A K L t c b :=
    (wcpa_dj_llsm_sm_sep_transfer Ω W hW hWt A K M L B 𝔭 t h 𝔮 t' hPD hSmc c b c₃ b₃ hc hbm hb0
      hc₃ hb₃m hb₃0 hPre₃).mpr hsep₃
  show ∃ c b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W ∧ b ∈ IsLocalRing.maximalIdeal ↥W ∧ b ≠ 0 ∧
      wcLlsDiscSep W A K L t c b ∧
      ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
        b' ≠ 0 → wcLlsDiscSep W A K L t c' b' → b ∣ b' → b ∣ c' - c → b' ∣ b
  refine ⟨c, b, hc, hbm, hb0, hsepA, ?_⟩
  intro c'' b'' hc'' hb''m hb''0 hsep'' hbb'' hbc''

  obtain ⟨c₄, b₄, hc₄, hb₄m, hb₄0, hPre₄⟩ := wcpa_dj_llsm_sm_preimage_disc Ω W hW hWt A K M L B
    𝔭 t h 𝔮 t' y hPD hSmc hSolv hUniq hGsolv c'' b'' hc'' hb''m hb''0 hsep''
  have hsep₄ : wcLlsDiscSep W B M L t' c₄ b₄ :=
    (wcpa_dj_llsm_sm_sep_transfer Ω W hW hWt A K M L B 𝔭 t h 𝔮 t' hPD hSmc c'' b'' c₄ b₄ hc''
      hb''m hb''0 hc₄ hb₄m hb₄0 hPre₄).mp hsep''

  have hI : ∀ a ∈ IsLocalRing.maximalIdeal ↥W, b₄ ∣ a - c₄ → b₃ ∣ a - c₃ := by
    intro a ha hda
    obtain ⟨θ', hθt, hθc⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt B 𝔮 t' hPDB a ha
    have h1 : b'' ∣ θ' (algebraMap A B t) - c'' := (hPre₄ θ' hθc).mpr (by rw [hθt]; exact hda)
    have h2 : b ∣ θ' (algebraMap A B t) - c := by
      have := dvd_add (dvd_trans hbb'' h1) hbc''
      rwa [sub_add_sub_cancel] at this
    have h3 := (hPre₃ θ' hθc).mp h2
    rwa [hθt] at h3
  have hb₃c₄ : b₃ ∣ c₄ - c₃ := hI c₄ hc₄ ⟨0, by ring⟩
  have hb₃b₄ : b₃ ∣ b₄ := by
    have h1 := hI (c₄ + b₄) (Ideal.add_mem _ hc₄ hb₄m) ⟨1, by ring⟩
    have h2 := dvd_sub h1 hb₃c₄
    have e : c₄ + b₄ - c₃ - (c₄ - c₃) = b₄ := by ring
    rwa [e] at h2

  have hb₄b₃ : b₄ ∣ b₃ := hmax₃ c₄ b₄ hc₄ hb₄m hb₄0 hsep₄ hb₃b₄ hb₃c₄

  have hIII : ∀ a ∈ IsLocalRing.maximalIdeal ↥W, b ∣ a - c → b'' ∣ a - c'' := by
    intro a ha hda
    obtain ⟨θ, hθt, hθc⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt A 𝔭 t hPD a ha
    obtain ⟨θ', hθ'A, hθ'c⟩ :=
      wcpa_dj_llsm_sm_point_lift Ω W hW hWt A K M B 𝔭 t h 𝔮 t' hPD hSmc θ hθc
    have ht : θ' (algebraMap A B t) = a := by rw [hθ'A, hθt]
    have h1 : b₃ ∣ θ' t' - c₃ := (hPre₃ θ' hθ'c).mp (by rw [ht]; exact hda)
    have h2 : b₄ ∣ θ' t' - c₄ := by
      have := dvd_sub (dvd_trans hb₄b₃ h1) (dvd_trans hb₄b₃ hb₃c₄)
      rwa [sub_sub_sub_cancel_right] at this
    have h3 := (hPre₄ θ' hθ'c).mpr h2
    rwa [ht] at h3
  have hb''c : b'' ∣ c - c'' := hIII c hc ⟨0, by ring⟩
  have h1 := hIII (c + b) (Ideal.add_mem _ hc hbm) ⟨1, by ring⟩
  have h2 := dvd_sub h1 hb''c
  have e : c + b - c'' - (c - c'') = b := by ring
  rwa [e] at h2

theorem wcpa_dj_llsm_normal_series_step : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ n : ℕ, 1 < n → ¬ n.Prime → wcLlsChartThm W (· < n) → wcLlsChartThm W Nat.Prime →
    wcLlsLocThm W (· = n) :=
by
  intro Ω _ _ W hW hWt n hn1 hnp IH PR

  have V1 : ∀ e : ℕ, 0 < e → ∀ a b : ↥W, a ^ e ∣ b ^ e → a ∣ b := fun e he a b h =>
    (IsIntegrallyClosed.pow_dvd_pow_iff he.ne').mp h

  have V2 : ∀ e : ℕ, 0 < e → ∀ β : ↥W, β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 →
      ∃ γ : ↥W, γ ∈ IsLocalRing.maximalIdeal ↥W ∧ γ ≠ 0 ∧ γ ^ e = β := by
    intro e he β hβm hβ0
    obtain ⟨ω, hω⟩ := IsAlgClosed.exists_pow_nat_eq (β : Ω) he
    have hβn : ¬ IsUnit β := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hβm
      exact hβm
    have hω0 : ω ≠ 0 := by
      rintro rfl
      have h0 : (β : Ω) = 0 := by rw [← hω, zero_pow he.ne']
      exact hβ0 (Subtype.ext (by rw [h0] <;> rfl))
    rcases W.mem_or_inv_mem ω with hω' | hω'
    · have hpow : (⟨ω, hω'⟩ : ↥W) ^ e = β := Subtype.ext (by simp [hω])
      refine ⟨⟨ω, hω'⟩, ?_, ?_, hpow⟩
      · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        exact hβn (hpow ▸ hu.pow e)
      · intro h0
        apply hω0
        exact congrArg Subtype.val h0
    · exfalso
      apply hβn
      refine IsUnit.of_mul_eq_one ((⟨ω⁻¹, hω'⟩ : ↥W) ^ e) ?_
      apply Subtype.ext
      have h1 : ((β * (⟨ω⁻¹, hω'⟩ : ↥W) ^ e : ↥W) : Ω) = (β : Ω) * (ω⁻¹) ^ e := by simp
      rw [h1, ← hω, ← mul_pow, mul_inv_cancel₀ hω0, one_pow] <;> rfl
  intro A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 k y hPD hSolv hUniq hcard
  obtain ⟨hGsolv, M, _, _, _, _, _, _, _, _, _, z, hzP, hzc, hzU, hzS, hzprime, hMlt⟩ :=
    wcpa_dj_llsm_nss_middle_field W A K L 𝔭 k y n hn1 hnp hSolv hUniq hcard
  have hyP := hSolv.1
  have hyc := hSolv.2.1
  haveI : FiniteDimensional M L := Module.Finite.of_restrictScalars_finite K M L
  haveI : IsGalois M L := IsGalois.tower_top_of_isGalois K M L
  cases k with
  | disc t =>
    by_cases hδ : wcpaDjLkDelta (wcLlsFS W ((algebraMap A M).comp (algebraMap ↥W A)) A z) = 0
    ·
      exact wcpa_dj_llsm_nss_smooth_middle Ω W hW hWt n IH A K M L 𝔭 t y z hPD hSolv hUniq
        hGsolv hMlt hzP hzc hzU hδ
    ·
      have hzSolv : wcLlsSolvPt W A K M 𝔭 (.disc t) z := ⟨hzP, hzc, hzS, fun _ _ _ => hδ⟩
      obtain ⟨c₁, b₁, hc₁, hb₁m, hb₁0, hsep₁, hmax₁⟩ :=
        PR A K M 𝔭 (.disc t) z hPD hzSolv hzprime
      obtain ⟨B, _, _, _, M', _, _, _, L', _, _, _, _, _, _, 𝔮, u', v', g', y₁, e, he, hPD',
          hSolv', hcard', hg'b, hbg', hiv⟩ :=
        wcpa_dj_llsm_nss_etale_annulus_transfer Ω W hW hWt A K M L 𝔭 (.disc t) y hPD hyP hyc
          hUniq hGsolv (t - algebraMap ↥W A c₁) b₁ hb₁m hb₁0 (Or.inl ⟨t, c₁, rfl, hc₁, rfl⟩) hsep₁
      obtain ⟨b₂, hb₂m, hb₂0, hb₂g, hsep₂, hmax₂⟩ :=
        IH B M' L' 𝔮 (.ann u' v' g') y₁ hPD' hSolv' (lt_of_le_of_lt hcard' hMlt)
      have hb₂b₁ : b₂ ^ e ∣ b₁ := dvd_trans (pow_dvd_pow_of_dvd hb₂g e) hg'b
      have hsepL : wcLlsDiscSep W A K L t c₁ (b₂ ^ e) := (hiv b₂ hb₂m hb₂0 hb₂b₁).mpr hsep₂
      show ∃ c b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W ∧ b ∈ IsLocalRing.maximalIdeal ↥W ∧
        b ≠ 0 ∧ wcLlsDiscSep W A K L t c b ∧
        ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
          b' ≠ 0 → wcLlsDiscSep W A K L t c' b' → b ∣ b' → b ∣ c' - c → b' ∣ b
      refine ⟨c₁, b₂ ^ e, hc₁, Ideal.pow_mem_of_mem _ hb₂m e he, pow_ne_zero e hb₂0, hsepL, ?_⟩
      intro c' b'' hc' hb''m hb''0 hsep'' hdiv _hdivc
      have hsepM : wcLlsDiscSep W A K M t c' b'' :=
        wcpa_dj_llsm_nss_sep_descends Ω W hW hWt A K M L 𝔭 (.disc t) hPD
          (t - algebraMap ↥W A c') b'' hb''m hb''0 (Or.inl ⟨t, c', rfl, hc', rfl⟩) hsep''
      have hch := wcpa_dj_llsm_sep_chain Ω W hW hWt A K M 𝔭 t z hPD hzP hzc hzU hδ
        c₁ b₁ c' b'' hc₁ hb₁m hb₁0 hc' hb''m hb''0 hsep₁ hsepM
      have hkey : b'' ∣ b₁ ∧ b'' ∣ c' - c₁ := by
        rcases hch with ⟨h1, h2⟩ | ⟨h1, h2⟩
        · have h3 := hmax₁ c' b'' hc' hb''m hb''0 hsepM h1 h2
          exact ⟨h3, dvd_trans h3 h2⟩
        · exact ⟨h1, dvd_sub_comm.mp h2⟩
      have hsepL1 : wcLlsDiscSep W A K L t c₁ b'' :=
        (wcpa_dj_llsm_nss_recenter W A K L 𝔭 t hPD c' c₁ b'' hc' hc₁ hb''m hb''0 hkey.2).mp
          hsep''
      obtain ⟨b₃, hb₃m, hb₃0, rfl⟩ := V2 e he b'' hb''m hb''0
      have hsepB : wcLlsAnnSep W B M' L' u' b₃ := (hiv b₃ hb₃m hb₃0 hkey.1).mp hsepL1
      have hb₃g : b₃ ∣ g' := V1 e he _ _ (dvd_trans hkey.1 hbg')
      have hb₂b₃ : b₂ ∣ b₃ := V1 e he _ _ hdiv
      exact pow_dvd_pow_of_dvd (hmax₂ b₃ hb₃m hb₃0 hb₃g hb₂b₃ hsepB) e
  | ann u v g =>

    have hzSolv : wcLlsSolvPt W A K M 𝔭 (.ann u v g) z :=
      ⟨hzP, hzc, hzS, fun _ _ ht' => by cases ht'⟩
    obtain ⟨b₁, hb₁m, hb₁0, hb₁g, hsep₁, hmax₁⟩ := PR A K M 𝔭 (.ann u v g) z hPD hzSolv hzprime
    obtain ⟨B, _, _, _, M', _, _, _, L', _, _, _, _, _, _, 𝔮, u', v', g', y₁, e, he, hPD',
        hSolv', hcard', hg'b, hbg', hiv⟩ :=
      wcpa_dj_llsm_nss_etale_annulus_transfer Ω W hW hWt A K M L 𝔭 (.ann u v g) y hPD hyP hyc
        hUniq hGsolv u b₁ hb₁m hb₁0 (Or.inr ⟨u, v, g, rfl, hb₁g, rfl⟩) hsep₁
    obtain ⟨b₂, hb₂m, hb₂0, hb₂g, hsep₂, hmax₂⟩ :=
      IH B M' L' 𝔮 (.ann u' v' g') y₁ hPD' hSolv' (lt_of_le_of_lt hcard' hMlt)
    have hb₂b₁ : b₂ ^ e ∣ b₁ := dvd_trans (pow_dvd_pow_of_dvd hb₂g e) hg'b
    have hsepL : wcLlsAnnSep W A K L u (b₂ ^ e) := (hiv b₂ hb₂m hb₂0 hb₂b₁).mpr hsep₂
    show ∃ b : ↥W, b ∈ IsLocalRing.maximalIdeal ↥W ∧ b ≠ 0 ∧ b ∣ g ∧ wcLlsAnnSep W A K L u b ∧
      ∀ b' : ↥W, b' ∈ IsLocalRing.maximalIdeal ↥W → b' ≠ 0 → b' ∣ g → b ∣ b' →
        wcLlsAnnSep W A K L u b' → b' ∣ b
    refine ⟨b₂ ^ e, Ideal.pow_mem_of_mem _ hb₂m e he, pow_ne_zero e hb₂0,
      dvd_trans hb₂b₁ hb₁g, hsepL, ?_⟩
    intro b'' hb''m hb''0 hb''g hdiv hsep''
    have hsepM : wcLlsAnnSep W A K M u b'' :=
      wcpa_dj_llsm_nss_sep_descends Ω W hW hWt A K M L 𝔭 (.ann u v g) hPD
        u b'' hb''m hb''0 (Or.inr ⟨u, v, g, rfl, hb''g, rfl⟩) hsep''
    have hb''b₁ : b'' ∣ b₁ := by
      rcases ValuationRing.dvd_total b'' b₁ with h | h
      · exact h
      · exact hmax₁ b'' hb''m hb''0 hb''g h hsepM
    obtain ⟨b₃, hb₃m, hb₃0, rfl⟩ := V2 e he b'' hb''m hb''0
    have hsepB : wcLlsAnnSep W B M' L' u' b₃ := (hiv b₃ hb₃m hb₃0 hb''b₁).mp hsep''
    have hb₃g : b₃ ∣ g' := V1 e he _ _ (dvd_trans hb''b₁ hbg')
    have hb₂b₃ : b₂ ∣ b₃ := V1 e he _ _ hdiv
    exact pow_dvd_pow_of_dvd (hmax₂ b₃ hb₃m hb₃0 hb₃g hb₂b₃ hsepB) e

theorem wcpa_dj_lr1k_ll_solvable_minimal : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → wcpaDjLkGalois γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)],
    wcpaDjLkModel W uX ι →
    ∀ y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX),
      wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y₀) →
      wcpaDjLkSmAt W uX (wcpaDjLkPi W (γ ≫ ι) uX y₀) →
    wcpaDjLlSolvMin W γ uX ι y₀ :=
by
  intro Ω _ _ W hW hWt C γ hcov hgal X uX ι _ _ hM y₀ hy₀ hSm

  have mono : ∀ (P Q : ℕ → Prop), (∀ m, P m → Q m) → wcLlsLocThm W Q → wcLlsLocThm W P := by
    intro P Q hPQ hQ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 k y h1 h2 h3 h4
    exact hQ A K L 𝔭 k y h1 h2 h3 (hPQ _ h4)
  have hbase : wcLlsLocThm W (· ≤ 1) := wcpa_dj_llsm_trivial_group Ω W hW hWt
  have hprime : wcLlsLocThm W Nat.Prime := by
    intro A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 k y h1 h2 h3 h4
    have hBR : wcLlsLocThmBR W (· = Nat.card ↥(wcLlsDec A K L y)) := by
      by_cases hc : ringChar Ω = Nat.card ↥(wcLlsDec A K L y)
      · exact wcpa_dj_llsm_artin_schreier_prime Ω W hW hWt _ h4 hc
      · exact wcpa_dj_llsm_kummer_prime Ω W hW hWt _ h4 hc
    exact wcpa_dj_llsm_branch_reduction Ω W hW hWt _ h4 hbase hBR A K L 𝔭 k y h1 h2 h3 rfl
  have hall : ∀ n : ℕ, wcLlsLocThm W (· = n) := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      by_cases h1 : n ≤ 1
      · exact mono _ _ (fun m hm => by subst hm; exact h1) hbase
      · by_cases hp : n.Prime
        · exact mono _ _ (fun m hm => by subst hm; exact hp) hprime
        · have hlt : wcLlsLocThm W (· < n) := by
            intro A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 k y h1' h2 h3 h4
            exact ih _ h4 A K L 𝔭 k y h1' h2 h3 rfl
          exact wcpa_dj_llsm_normal_series_step Ω W hW hWt n (by omega) hp
            (wcpa_dj_llsm_decomposition_reduction Ω W hW hWt _ hlt)
            (wcpa_dj_llsm_decomposition_reduction Ω W hW hWt _ hprime)
  have hchart : wcLlsChartThm W (fun _ => True) := by
    apply wcpa_dj_llsm_decomposition_reduction Ω W hW hWt
    intro A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 k y h1 h2 h3 _
    exact hall _ A K L 𝔭 k y h1 h2 h3 rfl

  obtain ⟨A, _, _, _, K, _, _, _, L, _, _, _, _, _, _, 𝔭, t, τ, hPD, hτ, hExh, hSolv⟩ :=
    wcpa_dj_llsm_global_to_chart Ω W hW hWt C γ hcov hgal X uX ι hM y₀ hy₀ hSm
  obtain ⟨hτ1, hτ2, hτ3⟩ := hτ

  have hExhI : ∀ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W) (σ' : Spec (.of ↥W) ⟶ X) (a' : ↥W),
      σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a = σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' →
      wcpaDjLlExh W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a →
      wcpaDjLlExh W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ' a' := by
    intro σ a σ' a' hI h X' r ι' _ _ hbl
    rw [← hI] at hbl
    exact h X' r ι' hbl
  refine ⟨?_, ?_⟩
  ·
    intro hss
    obtain ⟨y, hy⟩ := hSolv hss
    obtain ⟨c, b, hc, hb, hb0, hsep, hmax⟩ := hchart A K L 𝔭 (.disc t) y hPD hy trivial
    obtain ⟨σ, hσu, hσx, hτσ⟩ := hτ2 c hc
    have hP : wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ b := ⟨hσu, hσx, hb0, hb⟩
    refine ⟨σ, b, hP, (hExh σ b hP).mpr (by rw [hτσ]; exact hsep), ?_⟩
    intro σ' a' hP' hle hE'
    have h1 := (hτ3 σ b σ' a' hP hP').mp hle
    have hsep' := (hExh σ' a' hP').mp hE'
    have hdiv : a' ∣ b := hmax (τ σ') a' (hτ1 σ' hP'.1 hP'.2.1) hP'.2.2.2 hP'.2.2.1 hsep' h1.1
      (by rw [← hτσ]; exact h1.2)
    apply le_antisymm hle
    apply (hτ3 σ' a' σ b hP' hP).mpr
    refine ⟨hdiv, ?_⟩
    have h2 := dvd_trans hdiv h1.2
    rw [← dvd_neg, neg_sub]
    exact h2
  ·
    intro σ₀ a₀ hP₀ X₀ r₀ ι₀ _ _ hbl hι₀ hM₀ w hw hnsm hss
    obtain ⟨A', _, _, _, K', _, _, _, L', _, _, _, _, _, _, 𝔭', u, v, y', hPD', hy', hAnn⟩ :=
      wcpa_dj_llsm_annulus_chart Ω W hW hWt C γ hcov hgal X uX ι hM y₀ hy₀ hSm σ₀ a₀ hP₀
        X₀ r₀ ι₀ hbl hι₀ hM₀ w hw hnsm hss
    obtain ⟨b, hb, hb0, hba₀, hsep, hmax⟩ :=
      hchart A' K' L' 𝔭' (.ann u v a₀) y' hPD' hy' trivial
    have hP : wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ₀ b :=
      ⟨hP₀.1, hP₀.2.1, hb0, hb⟩
    refine ⟨σ₀, b, hP, ?_, (hAnn b hb hb0 hba₀).mp hsep, ?_⟩
    · exact (hτ3 σ₀ b σ₀ a₀ hP hP₀).mpr ⟨hba₀, by rw [sub_self]; exact dvd_zero b⟩
    · intro σ' a' hP' hle₀ hle hE'
      have h0 := (hτ3 σ' a' σ₀ a₀ hP' hP₀).mp hle₀
      have h1 := (hτ3 σ₀ b σ' a' hP hP').mp hle
      have hPa : wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ₀ a' :=
        ⟨hP₀.1, hP₀.2.1, hP'.2.2.1, hP'.2.2.2⟩
      have hI : σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' =
          σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' := by
        apply le_antisymm
        · apply (hτ3 σ₀ a' σ' a' hPa hP').mpr
          refine ⟨dvd_refl a', ?_⟩
          rw [← dvd_neg, neg_sub]
          exact h0.2
        · exact (hτ3 σ' a' σ₀ a' hP' hPa).mpr ⟨dvd_refl a', h0.2⟩
      have hE0 := hExhI σ' a' σ₀ a' hI hE'
      have hsep' := (hAnn a' hP'.2.2.2 hP'.2.2.1 h0.1).mpr hE0
      have hdiv : a' ∣ b := hmax a' hP'.2.2.2 hP'.2.2.1 h0.1 h1.1 hsep'
      apply le_antisymm hle
      exact (hτ3 σ' a' σ₀ b hP' hP).mpr ⟨hdiv, h0.2⟩

theorem wcpa_dj_lr1k_nsr_decomp_solvable : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] (A : ValuationSubring L),
    IsAlgClosed (IsLocalRing.ResidueField ↥(A.comap (algebraMap K L))) →
    Group.IsSolvable ↥(ValuationSubring.decompositionSubgroup K A) :=
by
  intro K L _ _ _ _ _ A hk
  classical

  have s1 : ∀ σ ∈ ValuationSubring.decompositionSubgroup K A, ∀ x : L,
      A.valuation (σ x) ≤ 1 ↔ A.valuation x ≤ 1 := by
    intro σ hσ x
    open Pointwise in (
    have h : σ • A = A := MulAction.mem_stabilizer_iff.mp hσ
    rw [ValuationSubring.valuation_le_one_iff, ValuationSubring.valuation_le_one_iff]
    have key : ∀ y : L, y ∈ A ↔ σ⁻¹ • y ∈ A := by
      intro y
      conv_lhs => rw [← h]
      exact ValuationSubring.mem_pointwise_smul_iff_inv_smul_mem
    have hinv : σ⁻¹ • σ x = x := inv_smul_smul σ x
    rw [key (σ x), hinv])

  have hM : ∀ σ ∈ ValuationSubring.decompositionSubgroup K A, ∀ a b : L,
      A.valuation (σ a) ≤ A.valuation (σ b) ↔ A.valuation a ≤ A.valuation b := by
    intro σ hσ a b
    by_cases hb : b = 0
    · subst hb
      rw [map_zero, map_zero]
      constructor
      · intro h
        have h0 : A.valuation (σ a) = 0 := le_antisymm h zero_le
        rw [Valuation.zero_iff] at h0
        rw [(map_eq_zero_iff σ σ.injective).mp h0, map_zero]
      · intro h
        have h0 : A.valuation a = 0 := le_antisymm h zero_le
        rw [Valuation.zero_iff] at h0
        rw [h0, map_zero, map_zero]
    · have hb' : σ b ≠ 0 := (map_ne_zero_iff σ σ.injective).mpr hb
      have hvb : 0 < A.valuation b := (Valuation.pos_iff _).mpr hb
      have hvb' : 0 < A.valuation (σ b) := (Valuation.pos_iff _).mpr hb'
      rw [← div_le_one₀ hvb, ← div_le_one₀ hvb', ← map_div₀ A.valuation a b,
        ← map_div₀ A.valuation (σ a) (σ b), ← map_div₀ σ a b]
      exact s1 σ hσ (a / b)

  have h1 : ∀ σ ∈ ValuationSubring.decompositionSubgroup K A, ∀ x : L,
      A.valuation (σ x) = A.valuation x := by
    intro σ hσ x
    have hpow : ∀ k : ℕ, ∀ z : L, (σ ^ (k + 1)) z = σ ((σ ^ k) z) := by
      intro k z; rw [pow_succ', AlgEquiv.mul_apply]
    have hn : 0 < orderOf σ := orderOf_pos σ
    have hσn : σ ^ orderOf σ = 1 := pow_orderOf_eq_one σ
    have hlt : ∀ y : L, ¬ A.valuation (σ y) < A.valuation y := by
      intro y hy
      have P : ∀ k : ℕ, A.valuation ((σ ^ (k + 1)) y) < A.valuation ((σ ^ k) y) := by
        intro k
        induction k with
        | zero => simpa using hy
        | succ k ih =>
          have h : A.valuation (σ ((σ ^ (k + 1)) y)) < A.valuation (σ ((σ ^ k) y)) :=
            lt_of_not_ge (fun h => (not_le.mpr ih) ((hM σ hσ _ _).mp h))
          rwa [← hpow (k + 1), ← hpow k] at h
      have Q : ∀ k : ℕ, A.valuation ((σ ^ (k + 1)) y) < A.valuation y := by
        intro k
        induction k with
        | zero => simpa using hy
        | succ k ih => exact (P (k + 1)).trans ih
      have := Q (orderOf σ - 1)
      rw [Nat.sub_add_cancel hn, hσn, AlgEquiv.one_apply] at this
      exact lt_irrefl _ this
    have hgt : ∀ y : L, ¬ A.valuation y < A.valuation (σ y) := by
      intro y hy
      have P : ∀ k : ℕ, A.valuation ((σ ^ k) y) < A.valuation ((σ ^ (k + 1)) y) := by
        intro k
        induction k with
        | zero => simpa using hy
        | succ k ih =>
          have h : A.valuation (σ ((σ ^ k) y)) < A.valuation (σ ((σ ^ (k + 1)) y)) :=
            lt_of_not_ge (fun h => (not_le.mpr ih) ((hM σ hσ _ _).mp h))
          rwa [← hpow (k + 1), ← hpow k] at h
      have Q : ∀ k : ℕ, A.valuation y < A.valuation ((σ ^ (k + 1)) y) := by
        intro k
        induction k with
        | zero => simpa using hy
        | succ k ih => exact ih.trans (P (k + 1))
      have := Q (orderOf σ - 1)
      rw [Nat.sub_add_cancel hn, hσn, AlgEquiv.one_apply] at this
      exact lt_irrefl _ this
    exact le_antisymm (not_lt.mp (hgt x)) (not_lt.mp (hlt x))

  have hres : ∀ w : L, A.valuation w ≤ 1 → ∃ c : K, A.valuation (algebraMap K L c - w) < 1 := by
    intro w hw
    have := hk
    have hint : IsIntegral K w := IsIntegral.of_finite K w
    obtain ⟨f, hfm, hfw⟩ : ∃ f : Polynomial K, f.Monic ∧ Polynomial.aeval w f = 0 :=
      ⟨minpoly K w, minpoly.monic hint, minpoly.aeval K w⟩
    obtain ⟨j₀, -, hmax⟩ := Finset.exists_max_image (Finset.range (f.natDegree + 1))
      (fun j => A.valuation (algebraMap K L (f.coeff j)))
      ⟨f.natDegree, Finset.self_mem_range_succ _⟩
    have hc1 : 1 ≤ A.valuation (algebraMap K L (f.coeff j₀)) := by
      have := hmax f.natDegree (Finset.self_mem_range_succ _)
      rwa [hfm.coeff_natDegree, map_one, map_one] at this
    have hc0 : f.coeff j₀ ≠ 0 := by
      intro h; rw [h, map_zero, map_zero] at hc1; exact absurd hc1 (not_le.mpr zero_lt_one)
    obtain ⟨g, hgcoeff, hgj₀, hgw⟩ : ∃ g : Polynomial K,
        (∀ j, A.valuation (algebraMap K L (g.coeff j)) ≤ 1) ∧ g.coeff j₀ = 1 ∧
          Polynomial.aeval w g = 0 := by
      refine ⟨Polynomial.C (f.coeff j₀)⁻¹ * f, ?_, ?_, ?_⟩
      · intro j
        rw [Polynomial.coeff_C_mul, map_mul, map_mul, map_inv₀, map_inv₀]
        have hpos : 0 < A.valuation (algebraMap K L (f.coeff j₀)) :=
          lt_of_lt_of_le zero_lt_one hc1
        by_cases hj : j ≤ f.natDegree
        · have := hmax j (Finset.mem_range_succ_iff.mpr hj)
          rw [inv_mul_le_iff₀ hpos, mul_one]
          exact this
        · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (not_le.mp hj), map_zero, map_zero,
            mul_zero]
          exact zero_le
      · rw [Polynomial.coeff_C_mul]; exact inv_mul_cancel₀ hc0
      · rw [map_mul, hfw, mul_zero]
    set R := A.comap (algebraMap K L) with hR
    have hlift : g ∈ Polynomial.lifts R.subtype := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      exact ⟨⟨g.coeff n, ValuationSubring.mem_comap.mpr
        ((A.valuation_le_one_iff _).mp (hgcoeff n))⟩, rfl⟩
    obtain ⟨g₀, hg₀⟩ := (Polynomial.mem_lifts g).mp hlift
    have hιmem : ∀ r : R, (algebraMap K L).comp R.subtype r ∈ A :=
      fun r => ValuationSubring.mem_comap.mp r.2
    let ι : R →+* A := ((algebraMap K L).comp R.subtype).codRestrict A hιmem
    have hιloc : IsLocalHom ι := by
      refine ⟨fun r hr => ?_⟩
      obtain ⟨u, hu⟩ := hr
      have h1' : algebraMap K L (r : K) * (((u⁻¹ : Aˣ) : A) : L) = 1 := by
        have := congrArg (fun z : A => (z : L)) u.mul_inv
        push_cast at this
        rw [hu] at this
        exact this
      have hr0 : (r : K) ≠ 0 := by
        intro h; rw [h, map_zero, zero_mul] at h1'; exact zero_ne_one h1'
      have hinv : (r : K)⁻¹ ∈ R := by
        rw [ValuationSubring.mem_comap, map_inv₀, ← eq_inv_of_mul_eq_one_right h1']
        exact ((u⁻¹ : Aˣ) : A).2
      exact isUnit_iff_exists_inv.mpr ⟨⟨(r : K)⁻¹, hinv⟩,
        Subtype.ext (show (r : K) * (r : K)⁻¹ = 1 from mul_inv_cancel₀ hr0)⟩
    have := hιloc
    have hg₀j : g₀.coeff j₀ = 1 := by
      apply Subtype.ext
      have := congrArg (fun p => Polynomial.coeff p j₀) hg₀
      simp only [Polynomial.coeff_map, hgj₀] at this
      exact this
    have hgbar0 : g₀.map (IsLocalRing.residue R) ≠ 0 := by
      intro h
      have := congrArg (fun p => Polynomial.coeff p j₀) h
      simp only [Polynomial.coeff_map, hg₀j, map_one, Polynomial.coeff_zero] at this
      exact one_ne_zero this
    let wA : A := ⟨w, (A.valuation_le_one_iff w).mp hw⟩
    have hcomp : (IsLocalRing.ResidueField.map ι).comp (IsLocalRing.residue R) =
        (IsLocalRing.residue A).comp ι :=
      RingHom.ext (fun r => IsLocalRing.ResidueField.map_residue ι r)
    have hevalA : Polynomial.eval wA (g₀.map ι) = 0 := by
      apply Subtype.ext
      show A.subtype (Polynomial.eval wA (g₀.map ι)) = A.subtype 0
      rw [map_zero, ← Polynomial.eval₂_at_apply, ← Polynomial.eval_map, Polynomial.map_map]
      have hc2 : A.subtype.comp ι = (algebraMap K L).comp R.subtype := RingHom.ext fun _ => rfl
      rw [hc2, ← Polynomial.map_map, hg₀]
      show Polynomial.eval w (g.map (algebraMap K L)) = 0
      rw [Polynomial.eval_map_algebraMap, hgw]
    have hroot : ((g₀.map (IsLocalRing.residue R)).map (IsLocalRing.ResidueField.map ι)).IsRoot
        (IsLocalRing.residue A wA) := by
      rw [Polynomial.map_map, hcomp, ← Polynomial.map_map, Polynomial.IsRoot.def,
        Polynomial.eval_map, Polynomial.eval₂_at_apply, hevalA, map_zero]
    obtain ⟨y, hy⟩ := Polynomial.Splits.mem_range_of_isRoot (IsAlgClosed.splits _) hgbar0 hroot
    obtain ⟨c₀, rfl⟩ := IsLocalRing.residue_surjective y
    rw [IsLocalRing.ResidueField.map_residue] at hy
    refine ⟨(c₀ : K), ?_⟩
    have hm : ι c₀ - wA ∈ IsLocalRing.maximalIdeal A := by
      rw [← IsLocalRing.residue_eq_zero_iff, map_sub, hy, sub_self]
    exact (A.valuation_lt_one_iff _).mp hm

  have h2 : ∀ σ ∈ ValuationSubring.decompositionSubgroup K A, ∀ w : L, A.valuation w = 1 →
      A.valuation (σ w - w) < 1 := by
    intro σ hσ w hw
    obtain ⟨c, hc⟩ := hres w hw.le
    have e : σ w - w = σ (w - algebraMap K L c) - (w - algebraMap K L c) := by
      rw [map_sub, AlgEquiv.commutes]; ring
    rw [e]
    have hv : A.valuation (w - algebraMap K L c) < 1 := by rwa [Valuation.map_sub_swap]
    exact lt_of_le_of_lt (Valuation.map_sub _ _ _) (max_lt (by rw [h1 σ hσ]; exact hv) hv)

  set D := ValuationSubring.decompositionSubgroup K A with hD
  set P := A.principalUnitGroup with hP
  have hne : ∀ (σ : L ≃ₐ[K] L) (x : Lˣ), σ (x : L) / x ≠ 0 := fun σ x =>
    div_ne_zero ((map_ne_zero_iff σ σ.injective).mpr x.ne_zero) x.ne_zero
  let r : (L ≃ₐ[K] L) → Lˣ → Lˣ := fun σ x => Units.mk0 (σ (x : L) / x) (hne σ x)
  have hrP : ∀ σ τ : D, ∀ x : Lˣ,
      (QuotientGroup.mk (r ((σ * τ : D) : L ≃ₐ[K] L) x) : Lˣ ⧸ P) =
        QuotientGroup.mk (r σ x) * QuotientGroup.mk (r τ x) := by
    intro σ τ x
    rw [← QuotientGroup.mk_mul, QuotientGroup.eq, ValuationSubring.mem_principalUnitGroup_iff]
    have hval : (((r ((σ * τ : D) : L ≃ₐ[K] L) x)⁻¹ * (r σ x * r τ x) : Lˣ) : L) =
        ((x : L) / (σ : L ≃ₐ[K] L) ((τ : L ≃ₐ[K] L) x)) *
          (((σ : L ≃ₐ[K] L) x / x) * ((τ : L ≃ₐ[K] L) x / x)) := by
      simp only [r, Units.val_mul, Units.val_inv_eq_inv_val, Units.val_mk0, Subgroup.coe_mul,
        AlgEquiv.mul_apply, inv_div]
    rw [hval]
    have hx := x.ne_zero
    have hτx : (τ : L ≃ₐ[K] L) x ≠ 0 := (map_ne_zero_iff _ (τ : L ≃ₐ[K] L).injective).mpr hx
    have hσx : (σ : L ≃ₐ[K] L) x ≠ 0 := (map_ne_zero_iff _ (σ : L ≃ₐ[K] L).injective).mpr hx
    have hστx : (σ : L ≃ₐ[K] L) ((τ : L ≃ₐ[K] L) x) ≠ 0 :=
      (map_ne_zero_iff _ (σ : L ≃ₐ[K] L).injective).mpr hτx
    have iden : (x : L) / (σ : L ≃ₐ[K] L) ((τ : L ≃ₐ[K] L) x) *
        ((σ : L ≃ₐ[K] L) x / x * ((τ : L ≃ₐ[K] L) x / x)) - 1 =
        -((σ : L ≃ₐ[K] L) ((τ : L ≃ₐ[K] L) x / x) - (τ : L ≃ₐ[K] L) x / x) *
          ((σ : L ≃ₐ[K] L) x / (σ : L ≃ₐ[K] L) ((τ : L ≃ₐ[K] L) x)) := by
      rw [map_div₀]
      field_simp
      ring
    have hvx : A.valuation (x : L) ≠ 0 := (Valuation.ne_zero_iff _).mpr hx
    have hu : A.valuation ((τ : L ≃ₐ[K] L) x / x) = 1 := by
      rw [map_div₀, h1 _ τ.2, div_self hvx]
    rw [iden, map_mul, Valuation.map_neg, map_div₀ A.valuation ((σ : L ≃ₐ[K] L) x),
      h1 _ σ.2 (x : L), h1 _ σ.2 ((τ : L ≃ₐ[K] L) x), h1 _ τ.2, div_self hvx, mul_one]
    exact h2 _ σ.2 _ hu
  let χ : D →* (Lˣ → Lˣ ⧸ P) :=
    { toFun := fun σ x => (QuotientGroup.mk (r (σ : L ≃ₐ[K] L) x) : Lˣ ⧸ P)
      map_one' := by
        funext x
        show (QuotientGroup.mk (r ((1 : D) : L ≃ₐ[K] L) x) : Lˣ ⧸ P) = 1
        rw [QuotientGroup.eq_one_iff]
        have : r ((1 : D) : L ≃ₐ[K] L) x = 1 := Units.ext (by simp [r])
        rw [this]; exact P.one_mem
      map_mul' := fun σ τ => by
        funext x
        exact hrP σ τ x }
  have hker : ∀ σ : D, χ σ = 1 → ∀ x : L, x ≠ 0 →
      A.valuation ((σ : L ≃ₐ[K] L) x / x - 1) < 1 := by
    intro σ hσ x hx
    have h0 : (QuotientGroup.mk (r (σ : L ≃ₐ[K] L) (Units.mk0 x hx)) : Lˣ ⧸ P) = 1 :=
      congrFun hσ (Units.mk0 x hx)
    have h' : r (σ : L ≃ₐ[K] L) (Units.mk0 x hx) ∈ P := (QuotientGroup.eq_one_iff _).mp h0
    rw [ValuationSubring.mem_principalUnitGroup_iff] at h'
    simpa [r] using h'

  have s4 : ∀ (τ : L ≃ₐ[K] L) (m : ℕ), τ ^ m = 1 → A.valuation (m : L) = 1 →
      (∀ i : ℕ, ∀ x : L, x ≠ 0 → A.valuation ((τ ^ i) x / x - 1) < 1) → τ = 1 := by
    intro τ m hτm hm hsmall
    ext y
    rw [AlgEquiv.one_apply]
    by_contra hne'
    have hx : τ y - y ≠ 0 := sub_ne_zero.mpr hne'
    have hS : ∑ i ∈ Finset.range m, (τ ^ i) (τ y - y) = 0 := by
      have : ∀ i, (τ ^ i) (τ y - y) = (τ ^ (i + 1)) y - (τ ^ i) y := by
        intro i; rw [map_sub, pow_succ, AlgEquiv.mul_apply]
      simp only [this]
      exact (Finset.sum_range_sub (fun i => (τ ^ i) y) m).trans (by simp [hτm])
    have hS' : ∑ i ∈ Finset.range m, (τ ^ i) (τ y - y) / (τ y - y) =
        (m : L) + ∑ i ∈ Finset.range m, ((τ ^ i) (τ y - y) / (τ y - y) - 1) := by
      rw [Finset.sum_sub_distrib]; simp
    have hE : A.valuation (∑ i ∈ Finset.range m, ((τ ^ i) (τ y - y) / (τ y - y) - 1)) < 1 :=
      Valuation.map_sum_lt _ one_ne_zero (fun i _ => hsmall i _ hx)
    have hv : A.valuation (∑ i ∈ Finset.range m, (τ ^ i) (τ y - y) / (τ y - y)) = 1 := by
      rw [hS', Valuation.map_add_eq_of_lt_left _ (by rw [hm]; exact hE), hm]
    rw [← Finset.sum_div, hS, zero_div, map_zero] at hv
    exact zero_ne_one hv

  have hE : ∀ m : ℕ, ¬ ringChar (IsLocalRing.ResidueField A) ∣ m → A.valuation (m : L) = 1 := by
    intro m hm
    have e1 : ((m : A) : L) = (m : L) := map_natCast A.subtype m
    rw [← e1, ← ValuationSubring.valuation_eq_one_iff]
    by_contra hnu
    have hmax : (m : A) ∈ IsLocalRing.maximalIdeal A :=
      (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu)
    rw [← IsLocalRing.residue_eq_zero_iff, map_natCast, ringChar.spec] at hmax
    exact hm hmax

  have hVsolv : Group.IsSolvable χ.ker := by
    have hprop : ∀ g : χ.ker, ∀ m : ℕ, g ^ m = 1 →
        ¬ ringChar (IsLocalRing.ResidueField A) ∣ m → g = 1 := by
      intro g m hgm hm
      have hτ : ((g : D) : L ≃ₐ[K] L) = 1 := by
        apply s4 _ m
        · have := congrArg (fun z : χ.ker => ((z : D) : L ≃ₐ[K] L)) hgm
          simpa using this
        · exact hE m hm
        · intro i x hx
          have hχ : χ ((g : D) ^ i) = 1 := (MonoidHom.mem_ker).mp (χ.ker.pow_mem g.2 i)
          have := hker _ hχ x hx
          simpa using this
      exact Subtype.ext (Subtype.ext hτ)
    rcases CharP.char_is_prime_or_zero (IsLocalRing.ResidueField A)
        (ringChar (IsLocalRing.ResidueField A)) with hp | hp
    · have : Fact (ringChar (IsLocalRing.ResidueField A)).Prime := ⟨hp⟩
      have hpg : IsPGroup (ringChar (IsLocalRing.ResidueField A)) χ.ker := by
        intro g
        obtain ⟨e, n', hn', hn⟩ :=
          Nat.exists_eq_pow_mul_and_not_dvd (orderOf_pos g).ne' _ hp.ne_one
        refine ⟨e, hprop _ n' ?_ hn'⟩
        rw [← pow_mul, ← hn, pow_orderOf_eq_one]
      have := hpg.isNilpotent
      infer_instance
    · have htriv : ∀ g : χ.ker, g = 1 := by
        intro g
        refine hprop g (orderOf g) (pow_orderOf_eq_one g) ?_
        rw [hp, zero_dvd_iff]
        exact (orderOf_pos g).ne'
      exact Group.isSolvable_of_comm (fun a b => by rw [htriv a, htriv b])
  have : Group.IsSolvable (Lˣ → Lˣ ⧸ P) := Group.isSolvable_of_comm
    (fun a b => by funext x; exact mul_comm (a x) (b x))
  have hle : χ.ker ≤ χ.ker.subtype.range := by rw [Subgroup.range_subtype]
  exact @Group.isSolvable_of_ker_le_range D _ χ.ker (Lˣ → Lˣ ⧸ P) _ _ χ.ker.subtype χ hle hVsolv this

theorem wcpa_dj_lr1k_nsr_solvstab_of_valuation : (∀ (K L : Type u) [Field K] [Field L] [Algebra K L]
      [FiniteDimensional K L] [IsGalois K L] (A : ValuationSubring L),
      IsAlgClosed (IsLocalRing.ResidueField ↥(A.comap (algebraMap K L))) →
      Group.IsSolvable ↥(ValuationSubring.decompositionSubgroup K A)) →
    ∀ (Ω : Type u) [Field Ω] (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ →
    ∀ (P : Aut C → Prop), (∀ g, P g → g.hom ≫ γ = γ) → wcNsrInvVal γ P →
    ∀ H : Subgroup (Aut C), (∀ g, g ∈ H ↔ P g) → Group.IsSolvable ↥H :=
by
  classical

  have s1 : ∀ (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C], ∃ ρ : Aut C →* RingAut C.functionField, (∀ g : Aut C, g.hom (genericPoint ↥C) = genericPoint ↥C) ∧ (∀ (g : Aut C) (V : C.Opens) (t : Γ(C, V)) (hV : genericPoint ↥C ∈ V) (hV' : genericPoint ↥C ∈ g.inv ⁻¹ᵁ V), ρ g ((C.presheaf.germ V (genericPoint ↥C) hV).hom t) = (C.presheaf.germ (g.inv ⁻¹ᵁ V) (genericPoint ↥C) hV').hom ((g.inv.app V).hom t)) ∧ (∀ (g : Aut C) (V : C.Opens) (t : Γ(C, V)) (hV : genericPoint ↥C ∈ V) (hV' : genericPoint ↥C ∈ g.hom ⁻¹ᵁ V), (ρ g).symm ((C.presheaf.germ V (genericPoint ↥C) hV).hom t) = (C.presheaf.germ (g.hom ⁻¹ᵁ V) (genericPoint ↥C) hV').hom ((g.hom.app V).hom t)) ∧ (∀ (Y : Scheme.{u}) (F : C ⟶ Y) (g : Aut C), g.inv ≫ F = F → ∀ (U : Y.Opens) (s : Γ(Y, U)) (hU : genericPoint ↥C ∈ F ⁻¹ᵁ U), ρ g ((C.presheaf.germ (F ⁻¹ᵁ U) (genericPoint ↥C) hU).hom ((F.app U).hom s)) = (C.presheaf.germ (F ⁻¹ᵁ U) (genericPoint ↥C) hU).hom ((F.app U).hom s)) := by
    intro C _
    have eih : ∀ g : Aut C, g.inv ≫ g.hom = 𝟙 C := fun g => (g : C ≅ C).inv_hom_id
    have ehi : ∀ g : Aut C, g.hom ≫ g.inv = 𝟙 C := fun g => (g : C ≅ C).hom_inv_id
    have hfix : ∀ g : Aut C, g.hom (genericPoint ↥C) = genericPoint ↥C := by
      intro g
      have h1 : genericPoint ↥C ⤳ g.hom (genericPoint ↥C) := genericPoint_specializes _
      have h2 : g.hom (genericPoint ↥C) ⤳ genericPoint ↥C := by
        have h3 : genericPoint ↥C ⤳ g.inv (genericPoint ↥C) := genericPoint_specializes _
        have h4 := h3.map g.hom.continuous
        have h5 : g.hom (g.inv (genericPoint ↥C)) = genericPoint ↥C := by
          rw [← Scheme.Hom.comp_apply, eih]; rfl
        rwa [h5] at h4
      exact (h2.antisymm h1).eq
    have hfixi : ∀ g : Aut C, g.inv (genericPoint ↥C) = genericPoint ↥C := fun g => hfix g⁻¹
    let φ : (f : C ⟶ C) → f (genericPoint ↥C) = genericPoint ↥C →
        (C.functionField →+* C.functionField) := fun f hf =>
      (C.presheaf.stalkSpecializes (Inseparable.of_eq hf).specializes ≫
        f.stalkMap (genericPoint ↥C)).hom
    have G : ∀ (f : C ⟶ C) (hf : f (genericPoint ↥C) = genericPoint ↥C) (V : C.Opens)
        (t : Γ(C, V)) (hV : genericPoint ↥C ∈ V) (hV' : genericPoint ↥C ∈ f ⁻¹ᵁ V),
        φ f hf ((C.presheaf.germ V (genericPoint ↥C) hV).hom t) =
          (C.presheaf.germ (f ⁻¹ᵁ V) (genericPoint ↥C) hV').hom ((f.app V).hom t) := by
      intro f hf V t hV hV'
      have h1 : C.presheaf.germ V (genericPoint ↥C) hV ≫ C.presheaf.stalkSpecializes
          (show f (genericPoint ↥C) ⤳ genericPoint ↥C from (Inseparable.of_eq hf).specializes) ≫
          f.stalkMap (genericPoint ↥C) = f.app V ≫ C.presheaf.germ (f ⁻¹ᵁ V) (genericPoint ↥C) hV' := by
        rw [← Category.assoc, TopCat.Presheaf.germ_stalkSpecializes, Scheme.Hom.germ_stalkMap]
      exact congrArg (fun k => k.hom t) h1
    have T : ∀ (Y : Scheme.{u}) (F₁ F₂ : C ⟶ Y), F₁ = F₂ → ∀ (U : Y.Opens) (s : Γ(Y, U))
        (h₁ : genericPoint ↥C ∈ F₁ ⁻¹ᵁ U) (h₂ : genericPoint ↥C ∈ F₂ ⁻¹ᵁ U),
        (C.presheaf.germ (F₁ ⁻¹ᵁ U) (genericPoint ↥C) h₁).hom ((F₁.app U).hom s) =
          (C.presheaf.germ (F₂ ⁻¹ᵁ U) (genericPoint ↥C) h₂).hom ((F₂.app U).hom s) := by
      rintro Y F₁ F₂ rfl U s h₁ h₂; rfl
    have Cm : ∀ (Y : Scheme.{u}) (f : C ⟶ C) (F : C ⟶ Y) (U : Y.Opens) (s : Γ(Y, U))
        (h₁ : genericPoint ↥C ∈ f ⁻¹ᵁ (F ⁻¹ᵁ U)) (h₂ : genericPoint ↥C ∈ (f ≫ F) ⁻¹ᵁ U),
        (C.presheaf.germ (f ⁻¹ᵁ (F ⁻¹ᵁ U)) (genericPoint ↥C) h₁).hom
            ((f.app (F ⁻¹ᵁ U)).hom ((F.app U).hom s)) =
          (C.presheaf.germ ((f ≫ F) ⁻¹ᵁ U) (genericPoint ↥C) h₂).hom (((f ≫ F).app U).hom s) := by
      intro Y f F U s h₁ h₂
      rfl
    have Id : ∀ (V : C.Opens) (t : Γ(C, V)) (h₁ : genericPoint ↥C ∈ (𝟙 C : C ⟶ C) ⁻¹ᵁ V)
        (h₂ : genericPoint ↥C ∈ V),
        (C.presheaf.germ ((𝟙 C : C ⟶ C) ⁻¹ᵁ V) (genericPoint ↥C) h₁).hom
            (((𝟙 C : C ⟶ C).app V).hom t) = (C.presheaf.germ V (genericPoint ↥C) h₂).hom t := by
      intro V t h₁ h₂
      rfl
    have Comp : ∀ (f₁ f₂ : C ⟶ C) (h₁ : f₁ (genericPoint ↥C) = genericPoint ↥C)
        (h₂ : f₂ (genericPoint ↥C) = genericPoint ↥C)
        (h₁₂ : (f₁ ≫ f₂) (genericPoint ↥C) = genericPoint ↥C) (x : C.functionField),
        φ (f₁ ≫ f₂) h₁₂ x = φ f₁ h₁ (φ f₂ h₂ x) := by
      intro f₁ f₂ h₁ h₂ h₁₂ x
      obtain ⟨V, hV, t, rfl⟩ := TopCat.Presheaf.exists_germ_eq C.presheaf x
      have m2 : genericPoint ↥C ∈ f₂ ⁻¹ᵁ V := by
        show f₂ (genericPoint ↥C) ∈ V; rw [h₂]; exact hV
      have m1 : genericPoint ↥C ∈ f₁ ⁻¹ᵁ (f₂ ⁻¹ᵁ V) := by
        show f₂ (f₁ (genericPoint ↥C)) ∈ V; rw [h₁, h₂]; exact hV
      have m12 : genericPoint ↥C ∈ (f₁ ≫ f₂) ⁻¹ᵁ V := m1
      rw [G (f₁ ≫ f₂) h₁₂ V t hV m12, G f₂ h₂ V t hV m2, G f₁ h₁ _ _ m2 m1, Cm C f₁ f₂ V t m1 m12]
    have IdR : ∀ (h : (𝟙 C : C ⟶ C) (genericPoint ↥C) = genericPoint ↥C) (x : C.functionField),
        φ (𝟙 C) h x = x := by
      intro h x
      obtain ⟨V, hV, t, rfl⟩ := TopCat.Presheaf.exists_germ_eq C.presheaf x
      rw [G (𝟙 C) h V t hV hV, Id V t hV hV]
    have Eq' : ∀ (f₁ f₂ : C ⟶ C) (e : f₁ = f₂) (h₁ : f₁ (genericPoint ↥C) = genericPoint ↥C)
        (h₂ : f₂ (genericPoint ↥C) = genericPoint ↥C) (x : C.functionField),
        φ f₁ h₁ x = φ f₂ h₂ x := by
      rintro f₁ f₂ rfl h₁ h₂ x; rfl
    let ρf : Aut C → RingAut C.functionField := fun g =>
      { toFun := φ g.inv (hfixi g)
        invFun := φ g.hom (hfix g)
        left_inv := fun x => by
          show φ g.hom (hfix g) (φ g.inv (hfixi g) x) = x
          have e1 : (g.hom ≫ g.inv) (genericPoint ↥C) = genericPoint ↥C := by
            rw [Scheme.Hom.comp_apply, hfix, hfixi]
          have e2 : (𝟙 C : C ⟶ C) (genericPoint ↥C) = genericPoint ↥C := rfl
          rw [← Comp g.hom g.inv (hfix g) (hfixi g) e1, Eq' _ (𝟙 C) (ehi g) e1 e2, IdR e2]
        right_inv := fun x => by
          show φ g.inv (hfixi g) (φ g.hom (hfix g) x) = x
          have e1 : (g.inv ≫ g.hom) (genericPoint ↥C) = genericPoint ↥C := by
            rw [Scheme.Hom.comp_apply, hfixi, hfix]
          have e2 : (𝟙 C : C ⟶ C) (genericPoint ↥C) = genericPoint ↥C := rfl
          rw [← Comp g.inv g.hom (hfixi g) (hfix g) e1, Eq' _ (𝟙 C) (eih g) e1 e2, IdR e2]
        map_mul' := map_mul _
        map_add' := map_add _ }
    let ρ : Aut C →* RingAut C.functionField :=
      { toFun := ρf
        map_one' := by
          ext x
          exact IdR (hfixi 1) x
        map_mul' := fun g h => by
          ext x
          exact Comp g.inv h.inv (hfixi g) (hfixi h) (hfixi (g * h)) x }
    refine ⟨ρ, hfix, ?_, ?_, ?_⟩
    · intro g V t hV hV'
      exact G g.inv (hfixi g) V t hV hV'
    · intro g V t hV hV'
      exact G g.hom (hfix g) V t hV hV'
    · intro Y F g hF U s hU
      have m1 : genericPoint ↥C ∈ g.inv ⁻¹ᵁ (F ⁻¹ᵁ U) := by
        show F (g.inv (genericPoint ↥C)) ∈ U; rw [hfixi g]; exact hU
      show φ g.inv (hfixi g) _ = _
      rw [G g.inv (hfixi g) _ _ hU m1, Cm Y g.inv F U s m1 m1, T Y _ F hF U s m1 hU]

  have s2 : ∀ (C Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ Y) [IsSeparated γ] (g : Aut C), g.hom ≫ γ = γ → (∀ (V : C.Opens) (t : Γ(C, V)) (hV : genericPoint ↥C ∈ V) (hV' : genericPoint ↥C ∈ g.hom ⁻¹ᵁ V), (C.presheaf.germ (g.hom ⁻¹ᵁ V) (genericPoint ↥C) hV').hom ((g.hom.app V).hom t) = (C.presheaf.germ V (genericPoint ↥C) hV).hom t) → g = 1 := by
    intro C Y _ γ _ g hγ hgerm
    have eih : g.inv ≫ g.hom = 𝟙 C := (g : C ≅ C).inv_hom_id
    have hfix : g.hom (genericPoint ↥C) = genericPoint ↥C := by
      have h1 : genericPoint ↥C ⤳ g.hom (genericPoint ↥C) := genericPoint_specializes _
      have h2 : g.hom (genericPoint ↥C) ⤳ genericPoint ↥C := by
        have h3 : genericPoint ↥C ⤳ g.inv (genericPoint ↥C) := genericPoint_specializes _
        have h4 := h3.map g.hom.continuous
        have h5 : g.hom (g.inv (genericPoint ↥C)) = genericPoint ↥C := by
          rw [← Scheme.Hom.comp_apply, eih]; rfl
        rwa [h5] at h4
      exact (h2.antisymm h1).eq
    have hstalk : g.hom.stalkMap (genericPoint ↥C) =
        C.presheaf.stalkSpecializes (Inseparable.of_eq hfix.symm).specializes ≫
          (𝟙 C : C ⟶ C).stalkMap (genericPoint ↥C) := by
      rw [Scheme.Hom.stalkMap_id, Category.comp_id]
      apply TopCat.Presheaf.stalk_hom_ext
      intro V' hV'
      rw [TopCat.Presheaf.germ_stalkSpecializes]
      have hm : genericPoint ↥C ∈ g.hom ⁻¹ᵁ V' := hV'
      rw [Scheme.Hom.germ_stalkMap]
      ext t
      exact hgerm V' t _ hm
    obtain ⟨U, hU, hUeq⟩ := spread_out_unique_of_isGermInjective g.hom (𝟙 C) hfix hstalk
    haveI : IsDominant U.ι := by
      constructor
      rw [denseRange_iff_closure_range, Scheme.Opens.range_ι]
      exact (U.isOpen.dense ⟨_, hU⟩).closure_eq
    have hgid : g.hom = 𝟙 C :=
      ext_of_isDominant_of_isSeparated γ (by rw [hγ, Category.id_comp]) U.ι hUeq
    exact Iso.ext hgid

  have s3 : ∀ (C Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ Y) [IsFinite γ], FiniteDimensional ↥(Subfield.closure {x : ↥C.functionField | ∃ (U : Y.Opens) (s : Γ(Y, U)) (hU : genericPoint ↥C ∈ γ ⁻¹ᵁ U), (C.presheaf.germ (γ ⁻¹ᵁ U) (genericPoint ↥C) hU).hom ((γ.app U).hom s) = x}) ↥C.functionField := by
    intro C Y _ γ _
    set S := {x : ↥C.functionField | ∃ (U : Y.Opens) (s : Γ(Y, U)) (hU : genericPoint ↥C ∈ γ ⁻¹ᵁ U), (C.presheaf.germ (γ ⁻¹ᵁ U) (genericPoint ↥C) hU).hom ((γ.app U).hom s) = x} with hS
    set K₀ := Subfield.closure S with hK₀
    obtain ⟨U, hU, hηU, -⟩ := exists_isAffineOpen_mem_and_subset
      (x := γ (genericPoint ↥C)) (U := ⊤) trivial
    have hη : genericPoint ↥C ∈ γ ⁻¹ᵁ U := hηU
    have hV : IsAffineOpen (γ ⁻¹ᵁ U) := hU.preimage γ
    haveI : Nonempty (γ ⁻¹ᵁ U) := ⟨⟨_, hη⟩⟩
    haveI := functionField_isFractionRing_of_isAffineOpen C (γ ⁻¹ᵁ U) hV
    set φ := (γ.app U).hom with hφ
    set ι := (C.presheaf.germ (γ ⁻¹ᵁ U) (genericPoint ↥C) hη).hom with hι
    have hfin : φ.Finite := IsFinite.finite_app γ U hU
    have hmemS : ∀ r, ι (φ r) ∈ K₀ := fun r => Subfield.subset_closure ⟨U, r, hη, rfl⟩
    let ψ : Γ(Y, U) →+* K₀ := (ι.comp φ).codRestrict K₀ hmemS
    letI : Algebra Γ(Y, U) Γ(C, γ ⁻¹ᵁ U) := φ.toAlgebra
    haveI : Module.Finite Γ(Y, U) Γ(C, γ ⁻¹ᵁ U) := hfin
    obtain ⟨n, b, hb⟩ := Module.Finite.exists_fin (R := Γ(Y, U)) (M := Γ(C, γ ⁻¹ᵁ U))
    set E := IntermediateField.adjoin K₀ (Set.range (ι ∘ b)) with hE
    have hint : ∀ x ∈ Set.range (ι ∘ b), IsIntegral K₀ x := by
      rintro _ ⟨i, rfl⟩
      obtain ⟨p, hpm, hp⟩ := hfin.to_isIntegral (b i)
      refine ⟨p.map ψ, hpm.map ψ, ?_⟩
      rw [Polynomial.eval₂_map]
      have : (algebraMap K₀ C.functionField).comp ψ = ι.comp φ := by ext r; rfl
      rw [this, Function.comp_apply, ← Polynomial.hom_eval₂, hp, map_zero]
    haveI hEfin : FiniteDimensional K₀ E := IntermediateField.finiteDimensional_adjoin hint
    have hB : ∀ y : Γ(C, γ ⁻¹ᵁ U), ι y ∈ E := by
      intro y
      have hy : y ∈ Submodule.span Γ(Y, U) (Set.range b) := hb ▸ Submodule.mem_top
      induction hy using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨i, rfl⟩ := hx
        exact IntermediateField.subset_adjoin _ _ ⟨i, rfl⟩
      | zero => rw [map_zero]; exact E.zero_mem
      | add x y _ _ hx hy => rw [map_add]; exact E.add_mem hx hy
      | smul a x _ hx =>
        rw [Algebra.smul_def, map_mul]
        refine E.mul_mem ?_ hx
        have : ι (algebraMap Γ(Y, U) Γ(C, γ ⁻¹ᵁ U) a) = algebraMap K₀ C.functionField (ψ a) := rfl
        rw [this]
        exact E.algebraMap_mem _
    have htop : E = ⊤ := by
      rw [eq_top_iff]
      intro z _
      obtain ⟨x, y, hy, rfl⟩ := IsFractionRing.div_surjective (A := Γ(C, γ ⁻¹ᵁ U)) z
      exact E.div_mem (hB x) (hB y)
    have h2 : FiniteDimensional K₀ (⊤ : IntermediateField K₀ C.functionField) := htop ▸ hEfin
    exact Module.Finite.equiv IntermediateField.topEquiv.toLinearEquiv

  have s5 : (∀ (K L : Type u) [Field K] [Field L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L] (A : ValuationSubring L), IsAlgClosed (IsLocalRing.ResidueField ↥(A.comap (algebraMap K L))) → Group.IsSolvable ↥(ValuationSubring.decompositionSubgroup K A)) → ∀ (L : Type u) [Field L] (G : Subgroup (RingAut L)) [Finite ↥G] (A : ValuationSubring L), IsAlgClosed (IsLocalRing.ResidueField ↥A) → (∀ a : L, A.valuation a ≤ 1 → ∃ b : L, (∀ σ ∈ G, σ b = b) ∧ A.valuation (a - b) < 1) → (∀ σ ∈ G, ∀ x : L, x ∈ A ↔ σ x ∈ A) → Group.IsSolvable ↥G := by
    intro hdec L _ G _ A hres happ hstab
    let K' : Subfield L := FixedPoints.subfield G L
    haveI : IsGalois K' L := IsGalois.of_fixed_field L G
    let e : G ≃* (L ≃ₐ[K'] L) := FixedPoints.toAlgAutMulEquiv G L
    have he : ∀ (σ : G) (x : L), e σ x = (σ : RingAut L) x := fun σ x => rfl
    have hdecomp : ∀ σ : G, e σ ∈ ValuationSubring.decompositionSubgroup K' A := by
      intro σ
      open Pointwise in
      (unfold ValuationSubring.decompositionSubgroup
       rw [MulAction.mem_stabilizer_iff]
       ext x
       rw [ValuationSubring.mem_pointwise_smul_iff_inv_smul_mem, ← map_inv, AlgEquiv.smul_def, he]
       exact (hstab _ (G.inv_mem σ.2) x).symm)
    set B := A.comap (algebraMap K' L) with hB
    have hBmem : ∀ b : B, algebraMap K' L b.1 ∈ A := fun b => (ValuationSubring.mem_comap).1 b.2
    let incl : B →+* A :=
      { toFun := fun b => ⟨algebraMap K' L b.1, hBmem b⟩
        map_one' := by ext; simp
        map_mul' := by intros; ext; simp
        map_zero' := by ext; simp
        map_add' := by intros; ext; simp }
    have hincl : ∀ b : B, ((incl b : A) : L) = algebraMap K' L b.1 := fun b => rfl
    haveI : IsLocalHom incl := by
      constructor
      intro b hb
      obtain ⟨c, hc⟩ := isUnit_iff_exists_inv.mp hb
      have hc' : algebraMap K' L b.1 * (c : L) = 1 := by
        have := congrArg (fun z : A => (z : L)) hc
        simpa [hincl] using this
      have hb0 : b.1 ≠ 0 := by
        intro h0; rw [h0, map_zero, zero_mul] at hc'; exact zero_ne_one hc'
      have hinvmem : b.1⁻¹ ∈ B := by
        rw [ValuationSubring.mem_comap, map_inv₀]
        have : (algebraMap K' L b.1)⁻¹ = (c : L) := by
          exact inv_eq_of_mul_eq_one_right hc'
        rw [this]; exact c.2
      refine isUnit_iff_exists_inv.mpr ⟨⟨b.1⁻¹, hinvmem⟩, ?_⟩
      apply Subtype.ext
      show b.1 * b.1⁻¹ = 1
      exact mul_inv_cancel₀ hb0
    let θ := IsLocalRing.ResidueField.map incl
    have hθ : Function.Bijective θ := by
      refine ⟨θ.injective, ?_⟩
      intro y
      obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective y
      obtain ⟨b, hbfix, hab⟩ := happ a.1 (A.valuation_le_one a)
      have hbA : b ∈ A := by
        rw [← ValuationSubring.valuation_le_one_iff]
        have h1 : b = a.1 - (a.1 - b) := by ring
        rw [h1]
        exact le_trans (Valuation.map_sub _ _ _) (max_le (A.valuation_le_one a) hab.le)
      have hbK : b ∈ K' := fun σ => hbfix σ.1 σ.2
      have hbB : (⟨b, hbK⟩ : K') ∈ B := by
        rw [ValuationSubring.mem_comap]; exact hbA
      refine ⟨IsLocalRing.residue B ⟨⟨b, hbK⟩, hbB⟩, ?_⟩
      rw [IsLocalRing.ResidueField.map_residue, ← sub_eq_zero, ← map_sub,
        IsLocalRing.residue_eq_zero_iff, ValuationSubring.valuation_lt_one_iff]
      have : (((incl ⟨⟨b, hbK⟩, hbB⟩ - a : A)) : L) = -(a.1 - b) := by
        rw [AddSubgroupClass.coe_sub, hincl]; show b - a.1 = _; ring
      rw [this, Valuation.map_neg]
      exact hab
    haveI : IsAlgClosed (IsLocalRing.ResidueField B) :=
      IsAlgClosed.of_ringEquiv _ _ (RingEquiv.ofBijective θ hθ).symm
    have hsolvD := hdec K' L A this
    let ψ : G →* ValuationSubring.decompositionSubgroup K' A :=
      (e.toMonoidHom).codRestrict _ hdecomp
    have hψ : Function.Injective ψ := by
      intro σ τ h
      apply e.injective
      exact congrArg Subtype.val h
    exact Group.isSolvable_of_isSolvable_injective hψ

  intro hdec Ω _ C γ hcov P hPγ hInv H hH
  obtain ⟨hint, A, hres, happ, hstabV⟩ := hInv
  haveI := hint
  haveI : IsFinite γ := hcov.2.2.2.1
  obtain ⟨ρ, hfix, hρ, hρs, hρF⟩ := s1 C
  set S : Set C.functionField := {x : ↥C.functionField | ∃ (U : (wcProjK Ω 1).Opens)
    (s : Γ(wcProjK Ω 1, U)) (hU : genericPoint ↥C ∈ γ ⁻¹ᵁ U),
    (C.presheaf.germ (γ ⁻¹ᵁ U) (genericPoint ↥C) hU).hom ((γ.app U).hom s) = x} with hS
  set K₀ : Subfield C.functionField := Subfield.closure S with hK₀
  have hinvγ : ∀ g ∈ H, g.inv ≫ γ = γ := by
    intro g hg
    have h1 := hPγ g ((hH g).1 hg)
    calc g.inv ≫ γ = g.inv ≫ g.hom ≫ γ := by rw [h1]
      _ = γ := (g : C ≅ C).inv_hom_id_assoc γ
  set G : Subgroup (RingAut C.functionField) := H.map ρ with hG
  have hGfix : ∀ σ ∈ G, ∀ x ∈ K₀, σ x = x := by
    intro σ hσ x hx
    obtain ⟨g, hg, rfl⟩ := Subgroup.mem_map.mp hσ
    have hle : K₀ ≤ RingHom.eqLocusField ((ρ g : C.functionField ≃+* C.functionField) :
        C.functionField →+* C.functionField) (RingHom.id _) := by
      rw [hK₀, Subfield.closure_le]
      rintro y ⟨U, s, hU, rfl⟩
      exact hρF _ γ g (hinvγ g hg) U s hU
    exact hle hx
  haveI : FiniteDimensional K₀ C.functionField := s3 C (wcProjK Ω 1) γ
  haveI hGfin : Finite G := by
    let j : G → (C.functionField ≃ₐ[K₀] C.functionField) := fun σ =>
      { (σ : RingAut C.functionField) with
        commutes' := fun c => hGfix σ σ.2 c c.2 }
    apply Finite.of_injective j
    intro σ τ h
    apply Subtype.ext
    apply RingEquiv.ext
    intro x
    have := congrArg (fun e : C.functionField ≃ₐ[K₀] C.functionField => e x) h
    exact this
  have happ' : ∀ a : C.functionField, A.valuation a ≤ 1 →
      ∃ b : C.functionField, (∀ σ ∈ G, σ b = b) ∧ A.valuation (a - b) < 1 := by
    intro a ha
    obtain ⟨U, s, hU, hlt⟩ := happ a ha
    exact ⟨_, fun σ hσ => hGfix σ hσ _ (Subfield.subset_closure ⟨U, s, hU, rfl⟩), hlt⟩
  have hstab : ∀ σ ∈ G, ∀ x : C.functionField, x ∈ A ↔ σ x ∈ A := by
    intro σ hσ x
    obtain ⟨g, hg, rfl⟩ := Subgroup.mem_map.mp hσ
    obtain ⟨V, hV, t, rfl⟩ := TopCat.Presheaf.exists_germ_eq C.presheaf x
    have hgi : g.inv (genericPoint ↥C) = genericPoint ↥C := hfix g⁻¹
    have hV' : genericPoint ↥C ∈ g.inv ⁻¹ᵁ V := by
      show g.inv (genericPoint ↥C) ∈ V
      rw [hgi]; exact hV
    have h1 := hstabV g⁻¹ ((hH _).1 (H.inv_mem hg)) V t hV hV'
    rw [hρ g V t hV hV', ← ValuationSubring.valuation_le_one_iff,
      ← ValuationSubring.valuation_le_one_iff]
    exact h1
  have hGsolv : Group.IsSolvable G := s5 hdec C.functionField G A hres happ' hstab
  let f : H →* G := ρ.subgroupMap H
  have hfinj : Function.Injective f := by
    rw [injective_iff_map_eq_one]
    rintro ⟨k, hk⟩ hk1
    have hρk : ρ k = 1 := congrArg Subtype.val hk1
    apply Subtype.ext
    show k = 1
    apply s2 C (wcProjK Ω 1) γ k (hPγ k ((hH k).1 hk))
    intro V t hV hV'
    rw [← hρs k V t hV hV', hρk]
    rfl
  exact Group.isSolvable_of_isSolvable_injective hfinj

theorem wcpa_dj_lr1k_nsr_nlb_lv_generic_spec : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C]
    (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X),
    wcpaDjLkModel W uX ι → ∀ p : ↥X, (γ ≫ ι) (genericPoint ↥C) ⤳ p :=
by
  intro Ω _ _ W C _ γ hcov X uX ι hM p
  haveI : AlgebraicGeometry.IsIntegral (wcProjK Ω 1) := (wc_projK_integral_normal Ω 1).1
  haveI : IrreducibleSpace ↥(wcProjK Ω 1) := irreducibleSpace_of_isIntegral _
  haveI : IrreducibleSpace ↥C := irreducibleSpace_of_isIntegral C
  haveI : Nonempty ↥C := AlgebraicGeometry.IsIntegral.nonempty
  obtain ⟨V, hVd, hVet⟩ := hcov.2.2.2.2
  haveI := hVet
  obtain ⟨v, hv⟩ := hVd.nonempty
  have hgen : GeneralizingMap ⇑(V.ι ≫ γ) := Flat.generalizingMap (V.ι ≫ γ)
  obtain ⟨a', -, ha'⟩ := hgen (genericPoint_specializes ((V.ι ≫ γ) ⟨v, hv⟩))
  have hηξ : γ (genericPoint ↥C) ⤳ genericPoint ↥(wcProjK Ω 1) := by
    rw [← ha', Scheme.Hom.comp_apply]
    exact (genericPoint_specializes _).map γ.continuous
  let ηW : ↥(Spec (.of ↥W)) := (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum ↥W)
  haveI : Flat uX := hM.1.1
  have hW : ηW ⤳ uX p := (PrimeSpectrum.le_iff_specializes _ _).mp bot_le
  obtain ⟨q, hqp, hq⟩ := Flat.generalizingMap uX hW
  let o : ↥(Spec (.of Ω)) := (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum Ω)
  have hgo : (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) o = ηW := by
    apply PrimeSpectrum.ext
    show Ideal.comap (algebraMap ↥W Ω) ⊥ = ⊥
    exact Ideal.comap_bot_of_injective _ Subtype.val_injective
  obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback q o (hq.trans hgo.symm)
  have h := hM.2.2
  have hq' : ι (h.isoPullback.inv z) = q := by
    rw [← hz, ← h.isoPullback_inv_fst, Scheme.Hom.comp_apply]
  have h1 : γ (genericPoint ↥C) ⤳ h.isoPullback.inv z := hηξ.trans (genericPoint_specializes _)
  rw [Scheme.Hom.comp_apply]
  exact (h1.map ι.continuous).trans (by rw [hq']; exact hqp)

theorem wcpa_dj_lr1k_nsr_nlb_lv_point_chart : ∀ (X X₁ : Scheme.{u}) (I : X.IdealSheafData)
    (r₁ : X₁ ⟶ X), wcCsdIsBlowup I r₁ → (∀ U : X.affineOpens, (I.ideal U).FG) →
    ∀ (p : ↥X₁) (V : X.Opens) (hV : IsAffineOpen V), r₁ p ∈ V →
    ∃ (U₁ : X₁.Opens) (hle : U₁ ≤ r₁ ⁻¹ᵁ V) (b : Γ(X, V)) (T : Set Γ(X₁, U₁)),
      IsAffineOpen U₁ ∧ p ∈ U₁ ∧ b ∈ I.ideal ⟨V, hV⟩ ∧
      (∀ f ∈ I.ideal ⟨V, hV⟩, ∃ y : Γ(X₁, U₁),
        (r₁.appLE V U₁ hle).hom f = y * (r₁.appLE V U₁ hle).hom b) ∧
      (∀ t ∈ T, ∃ f ∈ I.ideal ⟨V, hV⟩,
        (r₁.appLE V U₁ hle).hom f = t * (r₁.appLE V U₁ hle).hom b) ∧
      ∀ s : Γ(X₁, U₁), s ∈ Subring.closure (Set.range (r₁.appLE V U₁ hle).hom ∪ T) :=
by
  intro X X₁ I r₁ hbl hFG p V hV hpV
  classical

  have alg : ∀ {A A' B C : Type u} [CommRing A] [CommRing A'] [CommRing B] [CommRing C]
      {n : ℕ} (ψ : C →+* B) (χ : B →+* C), (∀ c, χ (ψ c) = c) → (∀ b, ψ (χ b) = b) →
      ∀ (ρ : A →+* C) (ρV : A →+* A') (φ' : A' →+* B), Function.Surjective ρV →
      (∀ a, ψ (ρ a) = φ' (ρV a)) → ∀ (g₀ : Fin n → A) (l : Fin n) (t : Fin n → B),
      (∀ j, φ' (ρV (g₀ j)) = t j * φ' (ρV (g₀ l))) →
      (∀ s : B, s ∈ Subring.closure (Set.range φ' ∪ Set.range t)) →
      (∀ f ∈ Ideal.span (Set.range g₀), ∃ y : C, ρ f = y * ρ (g₀ l)) ∧
      (∀ j, ρ (g₀ j) = χ (t j) * ρ (g₀ l)) ∧
      ∀ s : C, s ∈ Subring.closure (Set.range ρ ∪ Set.range (fun j => χ (t j))) := by
    intro A A' B C _ _ _ _ n ψ χ hχψ hψχ ρ ρV φ' hρV hcomm g₀ l t hrel hgen
    have hψinj : Function.Injective ψ := fun x y h => by rw [← hχψ x, ← hχψ y, h]
    have h2 : ∀ j, ρ (g₀ j) = χ (t j) * ρ (g₀ l) := by
      intro j
      apply hψinj
      rw [map_mul, hψχ, hcomm, hcomm, hrel]
    refine ⟨?_, h2, ?_⟩
    · intro f hf
      induction hf using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨j, rfl⟩ := hx
        exact ⟨χ (t j), h2 j⟩
      | zero => exact ⟨0, by rw [map_zero, zero_mul]⟩
      | add x y _ _ hx hy =>
        obtain ⟨a, ha⟩ := hx
        obtain ⟨b, hb⟩ := hy
        exact ⟨a + b, by rw [map_add, ha, hb, add_mul]⟩
      | smul c x _ hx =>
        obtain ⟨a, ha⟩ := hx
        exact ⟨ρ c * a, by rw [smul_eq_mul, map_mul, ha, mul_assoc]⟩
    · have hle : Subring.closure (Set.range φ' ∪ Set.range t) ≤
          (Subring.closure (Set.range ρ ∪ Set.range (fun j => χ (t j)))).comap χ := by
        rw [Subring.closure_le]
        rintro y (⟨a', rfl⟩ | ⟨j, rfl⟩)
        · obtain ⟨a, rfl⟩ := hρV a'
          rw [SetLike.mem_coe, Subring.mem_comap, ← hcomm, hχψ]
          exact Subring.subset_closure (Or.inl ⟨a, rfl⟩)
        · rw [SetLike.mem_coe, Subring.mem_comap]
          exact Subring.subset_closure (Or.inr ⟨j, rfl⟩)
      intro s
      have h3 := hle (hgen (ψ s))
      rw [Subring.mem_comap, hχψ] at h3
      exact h3

  obtain ⟨n, g₀, hg₀⟩ := Submodule.fg_iff_exists_fin_generating_family.mp (hFG ⟨V, hV⟩)
  have hI : I.ideal ⟨V, hV⟩ = Ideal.span (Set.range g₀) := hg₀.symm

  have hle : (⊤ : V.toScheme.Opens) ≤ V.ι ⁻¹ᵁ V := by simp
  have hρbij : Function.Bijective (V.ι.appLE V ⊤ hle).hom := by
    rw [Scheme.Opens.ι_appLE]
    have hp : V.ι ''ᵁ ⊤ ≤ V := by rw [Scheme.Opens.ι_image_top]
    show Function.Bijective (X.presheaf.map (homOfLE hp).op).hom
    have h' : V ≤ V.ι ''ᵁ ⊤ := by rw [Scheme.Opens.ι_image_top]
    have : IsIso (homOfLE hp).op :=
      ⟨⟨(homOfLE h').op, Subsingleton.elim _ _, Subsingleton.elim _ _⟩⟩
    exact ConcreteCategory.bijective_of_isIso (X.presheaf.map (homOfLE hp).op)

  have hcomap : I.comap V.ι = Scheme.IdealSheafData.ofIdealTop (Ideal.span
      (Set.range fun j : Fin n => (V.ι.appLE V ⊤ hle).hom (g₀ j))) := by
    apply Scheme.IdealSheafData.ext
    funext W
    have eW : W.1 ≤ V.ι ⁻¹ᵁ V := by simp
    have key : ∀ a, (V.toScheme.presheaf.map (homOfLE (le_top : W.1 ≤ ⊤)).op).hom
        ((V.ι.appLE V ⊤ hle).hom a) = (V.ι.appLE V W.1 eW).hom a := by
      intro a
      have h := Scheme.Hom.appLE_map V.ι hle (homOfLE (le_top : W.1 ≤ ⊤)).op
      exact congrArg (fun φ => φ.hom a) h
    rw [wc_csd_comap_ideal_affine _ _ I V.ι ⟨V, hV⟩ W eW, Scheme.IdealSheafData.ofIdealTop_ideal,
      hI, Ideal.map_span, Ideal.map_span]
    congr 1
    ext y
    constructor
    · rintro ⟨a, ⟨j, rfl⟩, rfl⟩
      exact ⟨_, ⟨j, rfl⟩, key _⟩
    · rintro ⟨_, ⟨j, rfl⟩, rfl⟩
      exact ⟨g₀ j, ⟨j, rfl⟩, (key _).symm⟩

  obtain ⟨P, f₁, r, hof, hcond, hpre, hblr⟩ : ∃ (P : Scheme.{u}) (f₁ : P ⟶ X₁)
      (r : P ⟶ V.toScheme), IsOpenImmersion f₁ ∧ f₁ ≫ r₁ = r ≫ V.ι ∧
      (∀ z : X₁, r₁ z ∈ V → ∃ p, f₁ p = z) ∧
      wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span
        (Set.range fun j : Fin n => (V.ι.appLE V ⊤ hle).hom (g₀ j)))) r := by
    refine ⟨Limits.pullback r₁ V.ι, Limits.pullback.fst _ _, Limits.pullback.snd _ _,
      inferInstance, Limits.pullback.condition, ?_, ?_⟩
    · intro z hz
