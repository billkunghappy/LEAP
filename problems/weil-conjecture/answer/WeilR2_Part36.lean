          C.presheaf.germ ⊤ (genericPoint C) trivial :=
        TopCat.Presheaf.germ_stalkSpecializes _ _ _
      rw [hsp, hκP, wcLr1uConst, ← CommRingCat.comp_apply, Category.assoc, Category.assoc]
      exact congrArg (fun φ => (CommRingCat.Hom.hom ((Scheme.ΓSpecIso (.of Ω)).inv ≫
        sC.appTop ≫ φ)) x) hcomp

    have hconst : ∀ w : ↥W, sp (κP (w : Ω)) ∈ V := fun w =>
      (hV _).2 ⟨κP (w : Ω), w, rfl, by rw [sub_self]; exact Ideal.zero_mem _⟩

    have hinf : ∀ z ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk P), ∀ c : ↥W, c ≠ 0 →
        V.valuation (sp z) ≤ V.valuation (sp (κP (c : Ω))) := by
      intro z hz c hc
      have hc' : (c : Ω) ≠ 0 := fun h => hc (Subtype.ext h)
      have hu : κP (c : Ω) * κP ((c : Ω)⁻¹) = 1 := by
        rw [← map_mul, mul_inv_cancel₀ hc', map_one]
      have hmem : sp (z * κP ((c : Ω)⁻¹)) ∈ V := by
        refine (hV _).2 ⟨z * κP ((c : Ω)⁻¹), 0, rfl, ?_⟩
        have h0 : κP (((0 : ↥W) : Ω)) = 0 := by
          rw [show (((0 : ↥W) : Ω)) = 0 from rfl, map_zero]
        rw [h0, sub_zero]
        exact Ideal.mul_mem_right _ _ hz
      have heq : z = z * κP ((c : Ω)⁻¹) * κP (c : Ω) := by
        rw [mul_assoc, mul_comm (κP _), hu, mul_one]
      calc V.valuation (sp z)
          = V.valuation (sp (z * κP ((c : Ω)⁻¹))) * V.valuation (sp (κP (c : Ω))) := by
            conv_lhs => rw [heq]
            rw [map_mul sp, map_mul V.valuation]
