    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g : ↥W)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.ann u v g) → wcLlsSolvPt W A K L 𝔭 (.ann u v g) y → wcLlsUniq A L 𝔭 y →
    wcLlsBR W A K L 𝔭 (.ann u v g) → Module.finrank K L = ℓ →
    ∀ (α : L) (f₀ : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α →
    ∃ T : Finset ↥W, ∀ β b : ↥W, β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 →
      b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → β ∣ b → ¬ b ∣ β → b ∣ g →
