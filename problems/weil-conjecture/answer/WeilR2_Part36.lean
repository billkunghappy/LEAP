  ∀ (σ : Spec (.of ↥W) ⟶ X) (b : ↥W),
    wcpaDjLlPair W uX (Limits.pullback.fst uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) p) σ b →
  ∀ (Xb : Scheme.{u}) (rb : Xb ⟶ X), wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX b) rb →
  ∀ y y' : ↥Xb,
    rb y = Limits.pullback.fst uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) p →
    rb y' = Limits.pullback.fst uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) p →
    (∃ (V : X.Opens) (g : Γ(X, V)) (hy : y ∈ rb ⁻¹ᵁ V), (σ.app V).hom g = 0 ∧
      ¬ ∃ φ : ↥(Xb.presheaf.stalk y), (Xb.presheaf.germ (rb ⁻¹ᵁ V) y hy).hom ((rb.app V).hom g) =
        ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ (rb ≫ uX).appTop ≫ Xb.presheaf.germ ⊤ y trivial).hom b * φ) →
    (∃ (V : X.Opens) (g : Γ(X, V)) (hy : y' ∈ rb ⁻¹ᵁ V), (σ.app V).hom g = 0 ∧
      ¬ ∃ φ : ↥(Xb.presheaf.stalk y'), (Xb.presheaf.germ (rb ⁻¹ᵁ V) y' hy).hom ((rb.app V).hom g) =
        ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ (rb ≫ uX).appTop ≫ Xb.presheaf.germ ⊤ y' trivial).hom b * φ) →
    y = y' :=
by
  intro Ω _ _ W hW hWt X uX ι hM p hSm σ b hP Xb rb hbl y y' hy hy' hNDy hNDy'

  have ptw : ∀ {A B C : Scheme.{u}} {f : A ⟶ B} {g : B ⟶ C} {h : A ⟶ C}, f ≫ g = h →
      ∀ x, g (f x) = h x := by
    intro A B C f g h e x
    rw [← Scheme.Hom.comp_apply, e]
  have hgermc : ∀ {A B Z : Scheme.{u}} (f : A ⟶ B) (k : B ⟶ Z) (O : Z.Opens) (t : Γ(Z, O))
      (a : ↥A) (ha : f a ∈ k ⁻¹ᵁ O) (ha' : a ∈ (f ≫ k) ⁻¹ᵁ O),
      (f.stalkMap a).hom ((B.presheaf.germ (k ⁻¹ᵁ O) (f a) ha).hom ((k.app O).hom t)) =
        (A.presheaf.germ ((f ≫ k) ⁻¹ᵁ O) a ha').hom (((f ≫ k).app O).hom t) := by
    intro A B Z f k O t a ha ha'
    rw [Scheme.Hom.germ_stalkMap_apply]
    rfl
  have hgermT : ∀ {A B Z : Scheme.{u}} (f : A ⟶ B) (k : B ⟶ Z) (t : Γ(Z, ⊤)) (a : ↥A),
