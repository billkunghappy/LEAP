  have fixA : ∀ (τ : M ≃ₐ[K] M) (a : A), τ (algebraMap A M a) = algebraMap A M a := by
    intro τ a
    rw [IsScalarTower.algebraMap_apply A K M, AlgEquiv.commutes]
  have stab : ∀ (τ : M ≃ₐ[K] M) (x : B), ∃ y : B, algebraMap B M y = τ (algebraMap B M x) := by
    intro τ x
    obtain ⟨k, hk⟩ := (hint (algebraMap B M x)).mp ⟨x, rfl⟩
    have h1 : IsIntegral A (τ (algebraMap A M h ^ k * algebraMap B M x)) := hk.map τ
    rw [map_mul, map_pow, fixA] at h1
    exact (hint _).mpr ⟨k, h1⟩
  choose g hg using stab
  let σB : (M ≃ₐ[K] M) → B →ₐ[A] B := fun τ =>
    { toFun := g τ
      map_one' := by apply inj; rw [hg, map_one, map_one]
      map_mul' := fun x y => by apply inj; rw [hg, map_mul, map_mul, map_mul, hg, hg]
      map_zero' := by apply inj; rw [hg, map_zero, map_zero]
      map_add' := fun x y => by apply inj; rw [hg, map_add, map_add, map_add, hg, hg]
      commutes' := fun a => by
        apply inj
        rw [hg, ← IsScalarTower.algebraMap_apply A B M, fixA] }
  have hσB : ∀ τ x, algebraMap B M (σB τ x) = τ (algebraMap B M x) := fun τ x => hg τ x
  have hσBinj : ∀ τ, Function.Injective (σB τ) := by
    intro τ x y hxy
    apply inj
    apply τ.injective
    rw [← hσB, ← hσB, hxy]
  have hσBmul : ∀ τ ρ x, σB τ (σB ρ x) = σB (τ * ρ) x := by
    intro τ ρ x
    apply inj
    rw [hσB, hσB, hσB, AlgEquiv.mul_apply]
  have hσq : ∀ τ, 𝔮.comap (σB τ) = 𝔮 := by
    intro τ
    apply huniq _ inferInstance
    rw [← hcomap]
    ext x
    simp only [Ideal.mem_comap, AlgHom.commutes]
  let T : Finset B := Finset.univ.image (fun τ : M ≃ₐ[K] M => σB τ t')
  have hT : ∀ y, y ∈ T ↔ ∃ τ : M ≃ₐ[K] M, σB τ t' = y := by
    intro y
    simp [T]
  have hTstab : ∀ τ, T.image (σB τ) = T := by
    intro τ
    apply Finset.eq_of_subset_of_card_le
    · intro y hy
      obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hy
      obtain ⟨ρ, rfl⟩ := (hT z).mp hz
      exact (hT _).mpr ⟨τ * ρ, (hσBmul τ ρ t').symm⟩
    · rw [Finset.card_image_of_injective _ (hσBinj τ)]
  refine ⟨T.toList, Finset.nodup_toList T, ?_, ?_, ?_, ?_⟩
  · rw [Finset.mem_toList, hT]
    exact ⟨1, by apply inj; rw [hσB, AlgEquiv.one_apply]⟩
  · intro y hy
    rw [Finset.mem_toList, hT] at hy
    obtain ⟨τ, rfl⟩ := hy
    have : t' ∈ 𝔮.comap (σB τ) := by rw [hσq τ]; exact ht'q
    exact this
  · intro y hy
    rw [Finset.mem_toList, hT] at hy
    obtain ⟨τ, rfl⟩ := hy
    exact ⟨σB τ, rfl, hσq τ⟩
  · set p : Polynomial B := (T.toList.map (fun y => Polynomial.X - Polynomial.C y)).prod with hp
    have hpT : p = ∏ y ∈ T, (Polynomial.X - Polynomial.C y) := by
      rw [hp, Finset.prod_map_toList]
    have hpinv : ∀ τ, p.map (σB τ : B →+* B) = p := by
      intro τ
      rw [hpT, Polynomial.map_prod]
      simp only [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, AlgHom.coe_toRingHom,
        RingHom.coe_coe]
      conv_rhs => rw [← hTstab τ]
      rw [Finset.prod_image (fun x _ y _ hxy => hσBinj τ hxy)]
    have hfix : ∀ i, ∃ (k : ℕ) (a' : A), algebraMap A B h ^ k * p.coeff i = algebraMap A B a' := by
      intro i
      have hcfix : ∀ τ : M ≃ₐ[K] M, τ (algebraMap B M (p.coeff i)) = algebraMap B M (p.coeff i) := by
        intro τ
        rw [← hσB]
        congr 1
        have := congrArg (fun q => q.coeff i) (hpinv τ)
        simp only [Polynomial.coeff_map, AlgHom.coe_toRingHom, RingHom.coe_coe] at this
        exact this
      obtain ⟨z, hz⟩ := (IsGalois.mem_range_algebraMap_iff_fixed
        (algebraMap B M (p.coeff i))).mpr hcfix
      obtain ⟨k, hk⟩ := (hint (algebraMap B M (p.coeff i))).mp ⟨_, rfl⟩
      rw [← hz, IsScalarTower.algebraMap_apply A K M, ← map_pow, ← map_mul] at hk
      have hk' : IsIntegral A (algebraMap A K h ^ k * z) :=
        (isIntegral_algHom_iff (IsScalarTower.toAlgHom A K M) (algebraMap K M).injective).mp hk
      obtain ⟨a', ha'⟩ := IsIntegrallyClosed.isIntegral_iff.mp hk'
      refine ⟨k, a', inj ?_⟩
      rw [map_mul, map_pow, ← IsScalarTower.algebraMap_apply A B M,
        ← IsScalarTower.algebraMap_apply A B M, ← hz, IsScalarTower.algebraMap_apply A K M h,
        IsScalarTower.algebraMap_apply A K M a', ha', map_mul, map_pow]
    choose k' a' ha' using hfix
    refine ⟨∑ i ∈ p.support, k' i, fun i => if i ∈ p.support then
      h ^ (∑ j ∈ p.support, k' j - k' i) * a' i else 0, ?_⟩
    intro i
    by_cases hi : i ∈ p.support
    · simp only [if_pos hi]
      rw [map_mul, map_pow, ← ha' i, ← mul_assoc, ← pow_add,
        Nat.sub_add_cancel (Finset.single_le_sum (fun j _ => Nat.zero_le (k' j)) hi)]
    · simp only [if_neg hi]
      rw [Polynomial.notMem_support_iff.mp hi, mul_zero, map_zero]

theorem wcpa_dj_llsm_smw_spec_congr : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (B : Type u) [CommRing B]
    [Algebra ↥W B] [Algebra A B] [IsScalarTower ↥W A B] (𝔭 : Ideal A) (t h : A) (𝔮 : Ideal B)
    (t' : B), wcLlsPD W A 𝔭 (.disc t) → 𝔮.IsPrime → 𝔮.comap (algebraMap A B) = 𝔭 → h ∉ 𝔭 →
    ∀ (Y : List B) (k : ℕ) (a : ℕ → A), t' ∈ Y →
    (∀ i : ℕ, algebraMap A B h ^ k * ((Y.map (fun y => Polynomial.X - Polynomial.C y)).prod.coeff i) =
      algebraMap A B (a i)) →
    ∀ θ₀ : B →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ₀ = 𝔮 →
    ∃ s w : B, s ∉ 𝔮 ∧ s * (Y.map (fun y => t' - algebraMap ↥W B (θ₀ y))).prod =
      (algebraMap A B t - algebraMap ↥W B (θ₀ (algebraMap A B t))) * w :=
by
  intro Ω _ _ W hW hWt A _ _ _ B _ _ _ _ 𝔭 t h 𝔮 t' hPD hq hcomap hh Y k a ht'Y hka θ₀ hθ₀
  classical
  have htp : t ∈ 𝔭 := hPD.2.2.2.2.2.1
  have hsec := fun (c : ↥W) (hc : c ∈ IsLocalRing.maximalIdeal ↥W) =>
    wcLlsAS_dsbu_section Ω W hW hWt A 𝔭 t c hPD hc
  set φ : B →+* B := (algebraMap ↥W B).comp (θ₀ : B →+* ↥W) with hφ
  have hφapp : ∀ y, φ y = algebraMap ↥W B (θ₀ y) := fun y => rfl
  set D : B := algebraMap A B t - algebraMap ↥W B (θ₀ (algebraMap A B t)) with hD
  have hnotq : ∀ x : A, x ∉ 𝔭 → algebraMap A B x ∉ 𝔮 := by
    intro x hx hxq
    apply hx
    rw [← hcomap]
    exact hxq

  have hc : θ₀ (algebraMap A B t) ∈ IsLocalRing.maximalIdeal ↥W := by
    have h1 : algebraMap A B t ∈ 𝔮 := by
      have h2 : t ∈ 𝔮.comap (algebraMap A B) := by rw [hcomap]; exact htp
      exact h2
    rw [← hθ₀] at h1
    exact h1
  obtain ⟨ev, hevW, hevt, hevc⟩ := hsec _ hc
  have hψW : ∀ w : ↥W, θ₀ (algebraMap A B (algebraMap ↥W A w)) = w := by
    intro w
    rw [← IsScalarTower.algebraMap_apply ↥W A B w, AlgHom.commutes]
    simp
  have hpt : ∀ x : A, ∃ s e : A, s ∉ 𝔭 ∧
      algebraMap A B s * (algebraMap A B x - φ (algebraMap A B x)) = D * algebraMap A B e := by
    intro x
    obtain ⟨s, e, hs, hse⟩ := hevc x
    have hψ := congrArg (fun z => θ₀ (algebraMap A B z)) hse
    simp only [map_mul, map_sub, hψW] at hψ
    have hs0 : θ₀ (algebraMap A B s) ≠ 0 := by
      intro h0
      apply hnotq s hs
      rw [← hθ₀, Ideal.mem_comap, h0]
      exact Ideal.zero_mem _
    have hev : θ₀ (algebraMap A B x) = ev x := by
      rw [sub_self, zero_mul] at hψ
      have h3 := (mul_eq_zero.mp hψ).resolve_left hs0
      exact sub_eq_zero.mp h3
    refine ⟨s, e, hs, ?_⟩
    have hB := congrArg (algebraMap A B) hse
    simp only [map_mul, map_sub, ← IsScalarTower.algebraMap_apply ↥W A B] at hB
    rw [hφapp, hev]
    exact hB

  set μ : Polynomial B := (Y.map (fun y => Polynomial.X - Polynomial.C y)).prod with hμ
  have hμeval : μ.eval t' = 0 := by
    rw [hμ, Polynomial.eval_list_prod]
    apply List.prod_eq_zero
    rw [List.map_map, List.mem_map]
    exact ⟨t', ht'Y, by simp⟩
  have hμφeval : (μ.map φ).eval t' = (Y.map (fun y => t' - algebraMap ↥W B (θ₀ y))).prod := by
    rw [hμ, Polynomial.map_list_prod, Polynomial.eval_list_prod, List.map_map, List.map_map]
    congr 1
    apply List.map_congr_left
    intro y _
    simp [hφapp]
  set N := μ.natDegree + 1 with hN
  have hexp1 : μ.eval t' = ∑ i ∈ Finset.range N, μ.coeff i * t' ^ i :=
    Polynomial.eval_eq_sum_range' (by omega) t'
  have hexp2 : (μ.map φ).eval t' = ∑ i ∈ Finset.range N, φ (μ.coeff i) * t' ^ i := by
    rw [Polynomial.eval_eq_sum_range' (n := N)
      (lt_of_le_of_lt Polynomial.natDegree_map_le (by omega))]
    simp only [Polynomial.coeff_map]
  have hPi : (Y.map (fun y => t' - algebraMap ↥W B (θ₀ y))).prod =
      ∑ i ∈ Finset.range N, (φ (μ.coeff i) - μ.coeff i) * t' ^ i := by
    rw [← hμφeval]
    calc (μ.map φ).eval t' = (μ.map φ).eval t' - μ.eval t' := by rw [hμeval, sub_zero]
      _ = _ := by rw [hexp1, hexp2, ← Finset.sum_sub_distrib]; simp only [sub_mul]

  choose sA eA hsA hseA using hpt
  set H : B := algebraMap A B h ^ k with hH
  have hHA : H = algebraMap A B (h ^ k) := by rw [hH, map_pow]
  have hcoef : ∀ i, algebraMap A B (sA (h ^ k)) * algebraMap A B (sA (a i)) * H *
      (φ (μ.coeff i) - μ.coeff i) =
      D * (algebraMap A B (sA (a i)) * φ (μ.coeff i) * algebraMap A B (eA (h ^ k)) -
        algebraMap A B (sA (h ^ k)) * algebraMap A B (eA (a i))) := by
    intro i
    have eqh := hseA (h ^ k)
    have eqi := hseA (a i)
    have eqA := hka i
    have eqB := congrArg φ (hka i)
    rw [map_mul] at eqB
    rw [← hHA] at eqh
    linear_combination (algebraMap A B (sA (a i)) * φ (μ.coeff i)) * eqh
      - algebraMap A B (sA (h ^ k)) * eqi
      - (algebraMap A B (sA (h ^ k)) * algebraMap A B (sA (a i))) * eqA
      + (algebraMap A B (sA (h ^ k)) * algebraMap A B (sA (a i))) * eqB

  set S : B := algebraMap A B (sA (h ^ k)) *
    ∏ j ∈ Finset.range N, algebraMap A B (sA (a j)) with hS
  have hterm : ∀ i ∈ Finset.range N, D ∣ S * H * ((φ (μ.coeff i) - μ.coeff i) * t' ^ i) := by
    intro i hi
    have e : S * H * ((φ (μ.coeff i) - μ.coeff i) * t' ^ i) =
        (algebraMap A B (sA (h ^ k)) * algebraMap A B (sA (a i)) * H *
          (φ (μ.coeff i) - μ.coeff i)) *
          ((∏ j ∈ (Finset.range N).erase i, algebraMap A B (sA (a j))) * t' ^ i) := by
      rw [hS, ← Finset.mul_prod_erase _ _ hi]
      ring
    rw [e, hcoef i, mul_assoc]
    exact dvd_mul_right _ _
  have hdiv : D ∣ S * H * (Y.map (fun y => t' - algebraMap ↥W B (θ₀ y))).prod := by
    rw [hPi, Finset.mul_sum]
    exact Finset.dvd_sum hterm
  obtain ⟨w, hw⟩ := hdiv

  have hprod : ∀ T : Finset ℕ, (∏ j ∈ T, algebraMap A B (sA (a j))) ∉ 𝔮 := by
    intro T
    induction T using Finset.induction_on with
    | empty =>
      rw [Finset.prod_empty]
      exact fun h1 => hq.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
    | insert j T hj ih =>
      rw [Finset.prod_insert hj]
      exact hq.mul_notMem (hnotq _ (hsA _)) ih
  have hHq : H ∉ 𝔮 := fun hm => hnotq h hh (hq.mem_of_pow_mem k hm)
  exact ⟨S * H, w, hq.mul_notMem (hq.mul_notMem (hnotq _ (hsA _)) (hprod _)) hHq, hw⟩

theorem wcpa_dj_llsm_smw_disc_nonvanishing : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (R : Type u) [CommRing R] [IsDomain R] [Algebra ↥W R] (𝔯 : Ideal R) (τ : R),
    wcLlsPD W R 𝔯 (.disc τ) → ∀ b : R, b ≠ 0 →
    ∃ θ : R →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔯 ∧ θ b ≠ 0 :=
by
  intro Ω _ _ W hW hWt R _ _ _ 𝔯 τ hPD b hb
  classical

  have s3 : ∀ q : Polynomial ↥W, (∀ x ∈ IsLocalRing.maximalIdeal ↥W, q.eval x = 0) → q = 0 := by
    intro q hq
    obtain ⟨x₀, hx₀⟩ : ∃ x₀ : Ω, x₀ ∉ W := by
      by_contra hcon
      push_neg at hcon
      apply hWt
      ext x
      simp only [ValuationSubring.mem_top, iff_true]
      exact hcon x
    have hx0 : x₀ ≠ 0 := fun h => hx₀ (h ▸ W.zero_mem)
    have hinv : x₀⁻¹ ∈ W := (W.mem_or_inv_mem x₀).resolve_left hx₀
    let π : ↥W := ⟨x₀⁻¹, hinv⟩
    have hπc : (π : Ω) = x₀⁻¹ := rfl
    have hπ0 : π ≠ 0 := by
      intro h
      apply inv_ne_zero hx0
      rw [← hπc, h]
      rfl
    have hπu : ¬ IsUnit π := by
      rintro ⟨u, hu⟩
      apply hx₀
      have h1 : π * ((u⁻¹ : (↥W)ˣ) : ↥W) = 1 := by
        rw [← hu]; exact u.mul_inv
      have h2 : (π : Ω) * (((u⁻¹ : (↥W)ˣ) : ↥W) : Ω) = 1 := by
        have := congrArg (fun z : ↥W => (z : Ω)) h1
        exact this
      rw [hπc, inv_mul_eq_one₀ hx0] at h2
      rw [h2]
      exact (((u⁻¹ : (↥W)ˣ) : ↥W)).2
    have hπm : π ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      exact hπu
    have hinj : Function.Injective (fun k : ℕ => π ^ (k + 1)) :=
      (pow_injective_of_not_isUnit hπu hπ0).comp Nat.succ_injective
    apply Polynomial.eq_zero_of_infinite_isRoot
    apply Set.infinite_of_injective_forall_mem hinj
    intro k
    exact hq _ (Ideal.pow_mem_of_mem _ hπm _ (Nat.succ_pos k))

  have s2 : ∀ (P : Type u) [CommRing P] (φ : P →+* R) (Q : Polynomial P), Q ≠ 0 →
      Polynomial.eval₂ φ b Q = 0 → ∃ q : P, q ≠ 0 ∧ ∃ c : R, φ q = b * c := by
    intro P _ φ Q hQ hQb
    have hdvd : (Polynomial.X : Polynomial P) ^ Q.natTrailingDegree ∣ Q := by
      rw [Polynomial.X_pow_dvd_iff]
      intro d hd
      exact Polynomial.coeff_eq_zero_of_lt_natTrailingDegree hd
    obtain ⟨Q', hQ'⟩ := hdvd
    have hc0 : Q'.coeff 0 = Q.coeff Q.natTrailingDegree := by
      have := Polynomial.coeff_X_pow_mul Q' Q.natTrailingDegree 0
      rw [zero_add] at this
      rw [← this, ← hQ']
    have hq0 : Q.coeff Q.natTrailingDegree ≠ 0 :=
      Polynomial.coeff_natTrailingDegree_ne_zero.mpr hQ
    have hQ'b : Polynomial.eval₂ φ b Q' = 0 := by
      rw [hQ', Polynomial.eval₂_mul, Polynomial.eval₂_X_pow] at hQb
      exact (mul_eq_zero.mp hQb).resolve_left (pow_ne_zero _ hb)
    refine ⟨Q.coeff Q.natTrailingDegree, hq0, -(Polynomial.eval₂ φ b Q'.divX), ?_⟩
    have e := Polynomial.X_mul_divX_add Q'
    have h2 : Polynomial.eval₂ φ b Q' =
        Polynomial.eval₂ φ b Q'.divX * b + φ (Q'.coeff 0) := by
      conv_lhs => rw [← e]
      rw [Polynomial.eval₂_add, Polynomial.eval₂_X_mul, Polynomial.eval₂_C]
    rw [← hc0]
    linear_combination hQ'b - h2

  have s1 : ∀ (h : R), h ≠ 0 → ∀ f : Polynomial ↥W →+* Localization.Away h,
      f.comp Polynomial.C = (algebraMap R (Localization.Away h)).comp (algebraMap ↥W R) →
      f Polynomial.X = algebraMap R (Localization.Away h) τ →
      RingHom.Etale f → ∃ Q : Polynomial (Polynomial ↥W), Q ≠ 0 ∧
        Polynomial.eval₂ (Polynomial.aeval τ).toRingHom b Q = 0 := by
    intro h hh f hf1 hf2 hfet
    letI : Algebra (Polynomial ↥W) (Localization.Away h) := f.toAlgebra
    haveI : Algebra.Etale (Polynomial ↥W) (Localization.Away h) := hfet
    haveI : Module.Finite (FractionRing (Polynomial ↥W))
        (TensorProduct (Polynomial ↥W) (FractionRing (Polynomial ↥W)) (Localization.Away h)) :=
      Algebra.FormallyUnramified.finite_of_free (FractionRing (Polynomial ↥W))
        (TensorProduct (Polynomial ↥W) (FractionRing (Polynomial ↥W)) (Localization.Away h))
    let b' : Localization.Away h := algebraMap R (Localization.Away h) b
    let x : TensorProduct (Polynomial ↥W) (FractionRing (Polynomial ↥W)) (Localization.Away h) :=
      Algebra.TensorProduct.includeRight b'
    have hxF : IsAlgebraic (FractionRing (Polynomial ↥W)) x :=
      (IsIntegral.of_finite (FractionRing (Polynomial ↥W)) x).isAlgebraic
    have hxP : IsAlgebraic (Polynomial ↥W) x :=
      (IsFractionRing.isAlgebraic_iff (Polynomial ↥W) (FractionRing (Polynomial ↥W))
        (TensorProduct (Polynomial ↥W) (FractionRing (Polynomial ↥W)) (Localization.Away h))).mpr hxF
    obtain ⟨Q, hQ0, hQx⟩ := hxP
    refine ⟨Q, hQ0, ?_⟩
    have h1 : TensorProduct.mk (Polynomial ↥W) (FractionRing (Polynomial ↥W)) (Localization.Away h) 1
        (Polynomial.aeval b' Q) = 0 := by
      rw [TensorProduct.mk_apply, ← Algebra.TensorProduct.includeRight_apply,
        ← Polynomial.aeval_algHom_apply]
      exact hQx
    obtain ⟨s', hs'⟩ := (IsLocalizedModule.eq_zero_iff (nonZeroDivisors (Polynomial ↥W))
      (TensorProduct.mk (Polynomial ↥W) (FractionRing (Polynomial ↥W)) (Localization.Away h) 1)).mp h1
    have hreg : IsSMulRegular (Localization.Away h) (s' : Polynomial ↥W) :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors s'.2
    have h2 : Polynomial.aeval b' Q = 0 := hreg.right_eq_zero_of_smul hs'
    have hfeq : f = (algebraMap R (Localization.Away h)).comp (Polynomial.aeval τ).toRingHom := by
      apply Polynomial.ringHom_ext
      · intro a
        have := congrArg (fun g => g a) hf1
        simp only [RingHom.comp_apply] at this
        rw [this, RingHom.comp_apply]
        simp
      · rw [hf2, RingHom.comp_apply]
        simp
    have h3 : algebraMap R (Localization.Away h)
        (Polynomial.eval₂ (Polynomial.aeval τ).toRingHom b Q) = 0 := by
      rw [Polynomial.hom_eval₂, ← hfeq]
      rw [Polynomial.aeval_def] at h2
      exact h2
    have hinj := IsLocalization.injective (Localization.Away h)
      (powers_le_nonZeroDivisors_of_noZeroDivisors hh)
    exact hinj (by rw [h3, map_zero])

  have hPD' := hPD
  unfold wcLlsPD at hPD'
  obtain ⟨-, -, -, -, -, -, -, h, hh𝔯, f, hf1, hf2, hfet⟩ := hPD'
  have hh0 : h ≠ 0 := fun h0 => hh𝔯 (h0 ▸ 𝔯.zero_mem)
  obtain ⟨Q, hQ0, hQb⟩ := s1 h hh0 f hf1 hf2 hfet
  obtain ⟨q, hq0, c, hqc⟩ := s2 (Polynomial ↥W) (Polynomial.aeval τ).toRingHom Q hQ0 hQb
  by_contra hcon
  push_neg at hcon
  apply hq0
  apply s3
  intro x hx
  obtain ⟨θ, hθτ, hθ𝔯⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt R 𝔯 τ hPD x hx
  have e1 : θ (Polynomial.aeval τ q) = Polynomial.aeval (θ τ) q :=
    (Polynomial.aeval_algHom_apply θ τ q).symm
  rw [hθτ] at e1
  have e2 : (Polynomial.aeval τ).toRingHom q = Polynomial.aeval τ q := rfl
  have e3 : q.eval x = Polynomial.aeval x q := by
    rw [Polynomial.coe_aeval_eq_eval]
  rw [e3, ← e1, ← e2, hqc, map_mul, hcon θ hθ𝔯, zero_mul]

theorem wcpa_dj_llsm_smw_fibre_nzd : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (R : Type u) [CommRing R] [IsDomain R] [Algebra ↥W R] (𝔯 : Ideal R) (τ : R),
    wcLlsPD W R 𝔯 (.disc τ) → ∀ x : R,
    (∃ s : R, s ∉ 𝔯 ∧ s * τ * x ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R)) →
    ∃ s' : R, s' ∉ 𝔯 ∧ s' * x ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R) :=
by
  intro Ω _ W R _ _ _ 𝔯 τ hPD x hsx0
  obtain ⟨s, hs, hsx⟩ := hsx0
  classical
  have hmax : 𝔯.IsMaximal := hPD.2.2.2.1
  obtain ⟨hτ, h𝔯, h, hh, f, hfC, hfX, hfet⟩ := hPD.2.2.2.2.2
  have hprime : 𝔯.IsPrime := hmax.isPrime
  have hflat : f.Flat := ((RingHom.etale_iff_formallyUnramified_and_smooth f).mp hfet).2.flat

  have s1 : ∀ y : Localization.Away h,
      f Polynomial.X * y ∈ (IsLocalRing.maximalIdeal ↥W).map (f.comp Polynomial.C) →
      y ∈ (IsLocalRing.maximalIdeal ↥W).map (f.comp Polynomial.C) := by
    intro y hy
    letI : Algebra (Polynomial ↥W) (Localization.Away h) := f.toAlgebra
    haveI hF : Module.Flat (Polynomial ↥W) (Localization.Away h) := hflat
    set J : Ideal (Polynomial ↥W) := (IsLocalRing.maximalIdeal ↥W).map Polynomial.C with hJ
    have hJmap : (IsLocalRing.maximalIdeal ↥W).map (f.comp Polynomial.C) = J.map f := by
      rw [hJ, Ideal.map_map]
    rw [hJmap] at hy ⊢
    have hreg : ∀ p : Polynomial ↥W, Polynomial.X * p ∈ J → p ∈ J := by
      intro p hp
      rw [hJ, Ideal.mem_map_C_iff] at hp ⊢
      intro n
      have := hp (n + 1)
      rwa [Polynomial.coeff_X_mul] at this
    have hy' := hy
    rw [Ideal.map, Ideal.span, Submodule.mem_span_set'] at hy'
    obtain ⟨n, g, q, hq⟩ := hy'
    choose j hj hjq using fun i => (q i).2
    let a : Fin (n + 1) → Polynomial ↥W := Fin.cons Polynomial.X (fun i => -j i)
    let v : Fin (n + 1) → Localization.Away h := Fin.cons y g
    have hsum : ∑ i, f (j i) * g i = f Polynomial.X * y := by
      rw [← hq]
      exact Finset.sum_congr rfl (fun i _ => by rw [hjq i, smul_eq_mul, mul_comm])
    have hrel : ∑ i, a i • v i = 0 := by
      rw [Fin.sum_univ_succ]
      simp only [a, v, Fin.cons_zero, Fin.cons_succ, Algebra.smul_def,
        RingHom.algebraMap_toAlgebra, map_neg, neg_mul, Finset.sum_neg_distrib]
      rw [hsum]
      ring
    obtain ⟨k, a', y', hv, ha⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
      (R := Polynomial ↥W) (M := Localization.Away h) (f := a) (x := v) hrel
    have h0 : ∀ m, a' 0 m ∈ J := by
      intro m
      apply hreg
      have e := ha m
      rw [Fin.sum_univ_succ] at e
      simp only [a, Fin.cons_zero, Fin.cons_succ, neg_mul, Finset.sum_neg_distrib] at e
      have e2 : Polynomial.X * a' 0 m = ∑ i : Fin n, j i * a' i.succ m := by
        have en : ∑ x : Fin n, -j x * a' x.succ m = -∑ i : Fin n, j i * a' i.succ m := by
          rw [← Finset.sum_neg_distrib]
          exact Finset.sum_congr rfl (fun i _ => by ring)
        rw [en] at e
        linear_combination e
      rw [e2]
      exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_right _ _ (hj i))
    have e3 := hv 0
    simp only [v, Fin.cons_zero] at e3
    rw [e3]
    refine Ideal.sum_mem _ (fun m _ => ?_)
    rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (h0 m))

  have s2 : ∀ z : R, algebraMap R (Localization.Away h) z ∈
      ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R)).map
        (algebraMap R (Localization.Away h)) →
      ∃ e : R, e ∉ 𝔯 ∧ e * z ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R) := by
    intro z hz
    rw [IsLocalization.mem_map_algebraMap_iff (Submonoid.powers h)] at hz
    obtain ⟨⟨jj, ⟨d, hd⟩⟩, hjd⟩ := hz
    obtain ⟨nn, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hd
    simp only at hjd
    rw [← map_mul, IsLocalization.eq_iff_exists (Submonoid.powers h)] at hjd
    obtain ⟨⟨c, hc⟩, hcz⟩ := hjd
    obtain ⟨mm, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hc
    simp only at hcz
    refine ⟨h ^ mm * h ^ nn, ?_, ?_⟩
    · intro hmem
      rcases hprime.mem_or_mem hmem with h1 | h1
      · exact hh (hprime.mem_of_pow_mem _ h1)
      · exact hh (hprime.mem_of_pow_mem _ h1)
    · have e : h ^ mm * h ^ nn * z = h ^ mm * (jj : R) := by linear_combination hcz
      rw [e]
      exact Ideal.mul_mem_left _ _ jj.2

  have hmapeq : (IsLocalRing.maximalIdeal ↥W).map (f.comp Polynomial.C) =
      ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W R)).map
        (algebraMap R (Localization.Away h)) := by
    rw [Ideal.map_map, hfC]
  have hy : f Polynomial.X * algebraMap R (Localization.Away h) (s * x) ∈
      (IsLocalRing.maximalIdeal ↥W).map (f.comp Polynomial.C) := by
    rw [hmapeq, hfX, ← map_mul]
    have e : τ * (s * x) = s * τ * x := by ring
    rw [e]
    exact Ideal.mem_map_of_mem _ hsx
  have hy2 := s1 _ hy
  rw [hmapeq] at hy2
  obtain ⟨e, he, hex⟩ := s2 _ hy2
  refine ⟨e * s, fun hm => ?_, by rw [mul_assoc]; exact hex⟩
  rcases hprime.mem_or_mem hm with h1 | h1
  · exact he h1
  · exact hs h1

theorem wcpa_dj_llsm_smw_point_division : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (R : Type u) [CommRing R] [IsDomain R] [Algebra ↥W R] (𝔯 : Ideal R) (τ : R),
    wcLlsPD W R 𝔯 (.disc τ) → ∀ (X : List ↥W), X.Nodup →
    (∀ x ∈ X, x ∈ IsLocalRing.maximalIdeal ↥W) → ∀ b : R,
    (∀ x ∈ X, ∃ θ : R →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔯 ∧ θ τ = x ∧
      θ b = 0) →
    ∃ s u : R, s ∉ 𝔯 ∧ s * b = (X.map (fun x => τ - algebraMap ↥W R x)).prod * u :=
by
  intro Ω _ _ W hW hWt R _ _ _ 𝔯 τ hPD X hnd hXm b hwit
  have h1r : (1 : R) ∉ 𝔯 := by
    obtain ⟨_, _, _, hev0⟩ := wcLlsAS_dsbu_section Ω W hW hWt R 𝔯 τ 0 hPD
      (IsLocalRing.maximalIdeal ↥W).zero_mem
    obtain ⟨s0, _, hs0, _⟩ := hev0 0
    intro h
    exact hs0 (by rw [(Ideal.eq_top_iff_one _).mpr h]; exact Submodule.mem_top)
  have hkey : ∀ θ : R →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔯 →
      ∀ s : R, s ∉ 𝔯 → θ s ≠ 0 := by
    intro θ hθ s hs h0
    apply hs
    rw [← hθ, Ideal.mem_comap, h0]
    exact (IsLocalRing.maximalIdeal ↥W).zero_mem
  revert hnd hXm b
  induction X with
  | nil =>
    intro _ _ b _
    refine ⟨1, b, h1r, ?_⟩
    simp
  | cons x X' ih =>
    intro hnd hXm b hwit
    rw [List.nodup_cons] at hnd
    obtain ⟨hxX', hnd'⟩ := hnd
    have hxm : x ∈ IsLocalRing.maximalIdeal ↥W := hXm x List.mem_cons_self
    have hXm' : ∀ x' ∈ X', x' ∈ IsLocalRing.maximalIdeal ↥W :=
      fun x' hx' => hXm x' (List.mem_cons_of_mem _ hx')
    obtain ⟨θx, hθxq, hθxt, hθxb⟩ := hwit x List.mem_cons_self
    have hprime : 𝔯.IsPrime := by
      rw [← hθxq]; exact Ideal.comap_isPrime _ _
    obtain ⟨ev, _, _, hev⟩ := wcLlsAS_dsbu_section Ω W hW hWt R 𝔯 τ x hPD hxm
    obtain ⟨s1, e1, hs1, h1⟩ := hev b
    have hevb : ev b = 0 := by
      have h := congrArg θx h1
      simp only [map_mul, map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply,
        hθxt, hθxb, sub_self, zero_mul] at h
      rcases mul_eq_zero.mp h with h' | h'
      · exact absurd h' (hkey θx hθxq s1 hs1)
      · simpa using h'
    rw [hevb, map_zero, sub_zero] at h1
    have hwit' : ∀ x' ∈ X', ∃ θ : R →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔯 ∧
        θ τ = x' ∧ θ e1 = 0 := by
      intro x' hx'
      obtain ⟨θ', hθ'q, hθ't, hθ'b⟩ := hwit x' (List.mem_cons_of_mem _ hx')
      refine ⟨θ', hθ'q, hθ't, ?_⟩
      have h := congrArg θ' h1
      simp only [map_mul, map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply,
        hθ't, hθ'b, mul_zero] at h
      have hne : x' - x ≠ 0 := sub_ne_zero.mpr (fun he => hxX' (he ▸ hx'))
      exact (mul_eq_zero.mp h.symm).resolve_left hne
    obtain ⟨s2, u, hs2, h2⟩ := ih hnd' hXm' e1 hwit'
    refine ⟨s2 * s1, u, fun hm => (hprime.mem_or_mem hm).elim hs2 hs1, ?_⟩
    rw [List.map_cons, List.prod_cons]
    linear_combination s2 * h1 + (τ - algebraMap ↥W R x) * h2

theorem wcpa_dj_llsm_sm_weierstrass_points : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    (𝔭 : Ideal A) (t : A) (h : A) (𝔮 : Ideal B) (t' : B),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    ∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W →
    ∃ R : List ↥W, R ≠ [] ∧ (∀ r ∈ R, r ∈ IsLocalRing.maximalIdeal ↥W) ∧
      ∀ θ : B →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔮 →
        (θ (algebraMap A B t) - c ∣ (R.map (fun r => θ t' - r)).prod ∧
          (R.map (fun r => θ t' - r)).prod ∣ θ (algebraMap A B t) - c) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M _ _ _ _ _ _ B _ _ _ _ _ _ _ _ 𝔭 t h 𝔮 t' hPD hSmc c hc
  classical
  have hPDB : wcLlsPD W B 𝔮 (.disc t') := hSmc.2.2.1
  have hqmax : 𝔮.IsMaximal := hPDB.2.2.2.1
  have hqprime : 𝔮.IsPrime := hqmax.isPrime
  have hIq : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) ≤ 𝔮 := hPDB.2.2.2.2.1
  have hcomap : 𝔮.comap (algebraMap A B) = 𝔭 := hSmc.2.2.2.1
  have hh : h ∉ 𝔭 := hSmc.1
  have htp : t ∈ 𝔭 := hPD.2.2.2.2.2.1
  have htq : algebraMap A B t ∈ 𝔮 := by
    have : t ∈ 𝔮.comap (algebraMap A B) := by rw [hcomap]; exact htp
    exact this

  have hover : ∀ θ : B →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔮 →
      ∀ x ∈ 𝔮, θ x ∈ IsLocalRing.maximalIdeal ↥W := by
    intro θ hθ x hx
    rw [← hθ] at hx
    exact hx
  have hnotover : ∀ θ : B →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔮 →
      ∀ x ∉ 𝔮, IsUnit (θ x) := by
    intro θ hθ x hx
    apply IsLocalRing.notMem_maximalIdeal.mp
    intro hm
    apply hx
    rw [← hθ]
    exact hm

  obtain ⟨Y, hYnd, ht'Y, hYq, hYσ, k, a, hka⟩ :=
    wcpa_dj_llsm_smw_orbit Ω W A K M B 𝔭 t h 𝔮 t' hPD hSmc

  obtain ⟨θA, hθAt, hθAc⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt A 𝔭 t hPD c hc
  obtain ⟨θc, hθcA, hθcq⟩ :=
    wcpa_dj_llsm_sm_point_lift Ω W hW hWt A K M B 𝔭 t h 𝔮 t' hPD hSmc θA hθAc
  have hθct : θc (algebraMap A B t) = c := by rw [hθcA, hθAt]

  obtain ⟨sc, wc, hsc, hscw⟩ := wcpa_dj_llsm_smw_spec_congr Ω W hW hWt A B 𝔭 t h 𝔮 t' hPD
    hqprime hcomap hh Y k a ht'Y hka θc hθcq
  rw [hθct] at hscw

  obtain ⟨bstar, hbstar⟩ : ∃ bstar : B, bstar = (Y.toFinset.offDiag).prod (fun p => p.1 - p.2) :=
    ⟨_, rfl⟩
  have hb0 : bstar ≠ 0 := by
    rw [hbstar, Finset.prod_ne_zero_iff]
    intro p hp
    rw [Finset.mem_offDiag] at hp
    exact sub_ne_zero.mpr hp.2.2
  obtain ⟨θs, hθsq, hθsb⟩ :=
    wcpa_dj_llsm_smw_disc_nonvanishing Ω W hW hWt B 𝔮 t' hPDB bstar hb0
  have hinj : ∀ y₁ ∈ Y, ∀ y₂ ∈ Y, θs y₁ = θs y₂ → y₁ = y₂ := by
    intro y₁ h₁ y₂ h₂ he
    by_contra hne
    apply hθsb
    rw [hbstar, map_prod]
    apply Finset.prod_eq_zero (i := (y₁, y₂))
    · rw [Finset.mem_offDiag]
      exact ⟨List.mem_toFinset.mpr h₁, List.mem_toFinset.mpr h₂, hne⟩
    · rw [map_sub, he, sub_self]
  have hRsnd : (Y.map (fun y => θs y)).Nodup :=
    List.Nodup.map_on (fun x hx y hy hxy => hinj x hx y hy hxy) hYnd
  obtain ⟨cs, hcs⟩ : ∃ cs : ↥W, cs = θs (algebraMap A B t) := ⟨_, rfl⟩
  have hcsm : cs ∈ IsLocalRing.maximalIdeal ↥W := by rw [hcs]; exact hover θs hθsq _ htq

  obtain ⟨ss, us, hss, hssu⟩ := wcpa_dj_llsm_smw_point_division Ω W hW hWt B 𝔮 t' hPDB
    (Y.map (fun y => θs y)) hRsnd
    (by
      intro x hx
      obtain ⟨y, hy, rfl⟩ := List.mem_map.mp hx
      exact hover θs hθsq y (hYq y hy))
    (algebraMap A B t - algebraMap ↥W B cs)
    (by
      intro x hx
      obtain ⟨y, hy, rfl⟩ := List.mem_map.mp hx
      obtain ⟨σ, hσt, hσq⟩ := hYσ y hy
      refine ⟨θs.comp (σ.restrictScalars ↥W), ?_, ?_, ?_⟩
      · ext x
        rw [Ideal.mem_comap, ← hσq, Ideal.mem_comap, ← hθsq, Ideal.mem_comap]
        rfl
      · show θs (σ t') = θs y
        rw [hσt]
      · show θs (σ (algebraMap A B t - algebraMap ↥W B cs)) = 0
        rw [map_sub, AlgHom.commutes, IsScalarTower.algebraMap_apply ↥W A B cs, AlgHom.commutes,
          ← IsScalarTower.algebraMap_apply ↥W A B cs, map_sub, AlgHom.commutes, ← hcs]
        simp)

  set I : Ideal B := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) with hI
  have hmI : ∀ r ∈ IsLocalRing.maximalIdeal ↥W, algebraMap ↥W B r ∈ I :=
    fun r hr => Ideal.mem_map_of_mem _ hr
  have hprodI : ∀ (f : B → ↥W), (∀ y ∈ Y, f y ∈ IsLocalRing.maximalIdeal ↥W) →
      Ideal.Quotient.mk I (Y.map (fun y => t' - algebraMap ↥W B (f y))).prod =
        Ideal.Quotient.mk I t' ^ Y.length := by
    intro f hf
    rw [map_list_prod, List.map_map]
    have hc : ∀ y ∈ Y, ((Ideal.Quotient.mk I) ∘ (fun y => t' - algebraMap ↥W B (f y))) y =
        Ideal.Quotient.mk I t' := by
      intro y hy
      simp only [Function.comp_apply, map_sub]
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr (hmI _ (hf y hy)), sub_zero]
    rw [List.map_congr_left hc, List.map_const', List.prod_replicate]
  have hP1 : Ideal.Quotient.mk I ((Y.map (fun y => θs y)).map
      (fun x => t' - algebraMap ↥W B x)).prod = Ideal.Quotient.mk I t' ^ Y.length := by
    rw [List.map_map]
    exact hprodI (fun y => θs y) (fun y hy => hover θs hθsq y (hYq y hy))
  have hP2 : Ideal.Quotient.mk I (Y.map (fun y => t' - algebraMap ↥W B (θc y))).prod =
      Ideal.Quotient.mk I t' ^ Y.length :=
    hprodI (fun y => θc y) (fun y hy => hover θc hθcq y (hYq y hy))
  have e1 : Ideal.Quotient.mk I ss * Ideal.Quotient.mk I (algebraMap A B t) =
      Ideal.Quotient.mk I t' ^ Y.length * Ideal.Quotient.mk I us := by
    have := congrArg (Ideal.Quotient.mk I) hssu
    rw [map_mul, map_mul, map_sub, Ideal.Quotient.eq_zero_iff_mem.mpr (hmI cs hcsm), sub_zero,
      hP1] at this
    exact this
  have e2 : Ideal.Quotient.mk I sc * Ideal.Quotient.mk I t' ^ Y.length =
      Ideal.Quotient.mk I (algebraMap A B t) * Ideal.Quotient.mk I wc := by
    have := congrArg (Ideal.Quotient.mk I) hscw
    rw [map_mul, map_mul, map_sub, Ideal.Quotient.eq_zero_iff_mem.mpr (hmI c hc), sub_zero,
      hP2] at this
    exact this
  have hz : Ideal.Quotient.mk I (t' ^ Y.length * (ss * sc - us * wc)) = 0 := by
    rw [map_mul, map_pow, map_sub, map_mul, map_mul]
    linear_combination (Ideal.Quotient.mk I ss) * e2 + (Ideal.Quotient.mk I wc) * e1
  have hzI : t' ^ Y.length * (ss * sc - us * wc) ∈ I := Ideal.Quotient.eq_zero_iff_mem.mp hz
  have h1q : (1 : B) ∉ 𝔮 := fun h1 => hqprime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  have hs5 := wcpa_dj_llsm_smw_fibre_nzd Ω W B 𝔮 t' hPDB
  have hcancel : ∀ (j : ℕ) (z : B), t' ^ j * z ∈ I → ∃ s, s ∉ 𝔮 ∧ s * z ∈ I := by
    intro j
    induction j with
    | zero =>
      intro z hz
      exact ⟨1, h1q, by simpa using hz⟩
    | succ j ih =>
      intro z hz
      obtain ⟨s', hs', hs'z⟩ := hs5 (t' ^ j * z) ⟨1, h1q, by
        have e : (1 : B) * t' * (t' ^ j * z) = t' ^ (j + 1) * z := by ring
        rw [e]; exact hz⟩
      obtain ⟨s'', hs'', hs''z⟩ := ih (s' * z) (by
        have e : t' ^ j * (s' * z) = s' * (t' ^ j * z) := by ring
        rw [e]; exact hs'z)
      refine ⟨s'' * s', fun hm => (hqprime.mem_or_mem hm).elim hs'' hs', ?_⟩
      have e : s'' * s' * z = s'' * (s' * z) := by ring
      rw [e]; exact hs''z
  obtain ⟨s0, hs0, hs0z⟩ := hcancel _ _ hzI
  have hwc : wc ∉ 𝔮 := by
    intro hw
    have hmem : s0 * (ss * sc) ∈ 𝔮 := by
      have h2 := 𝔮.add_mem (hIq hs0z) (𝔮.mul_mem_left (s0 * us) hw)
      have e : s0 * (ss * sc - us * wc) + s0 * us * wc = s0 * (ss * sc) := by ring
      rw [e] at h2
      exact h2
    rcases hqprime.mem_or_mem hmem with h3 | h3
    · exact hs0 h3
    · rcases hqprime.mem_or_mem h3 with h4 | h4
      · exact hss h4
      · exact hsc h4

  refine ⟨Y.map (fun y => θc y), ?_, ?_, ?_⟩
  · intro hnil
    rw [List.map_eq_nil_iff] at hnil
    rw [hnil] at ht'Y
    exact List.not_mem_nil ht'Y
  · intro r hr
    obtain ⟨y, hy, rfl⟩ := List.mem_map.mp hr
    exact hover θc hθcq y (hYq y hy)
  · intro θ hθ
    have hθP : θ ((Y.map (fun y => t' - algebraMap ↥W B (θc y))).prod) =
        ((Y.map (fun y => θc y)).map (fun r => θ t' - r)).prod := by
      rw [map_list_prod, List.map_map, List.map_map]
      apply congrArg
      apply List.map_congr_left
      intro y _
      simp
    have key := congrArg θ hscw
    rw [map_mul, map_mul, hθP, map_sub, AlgHom.commutes] at key
    simp only [Algebra.algebraMap_self, RingHom.id_apply] at key
    have hu1 := hnotover θ hθ sc hsc
    have hu2 := hnotover θ hθ wc hwc
    constructor
    · rw [← hu1.dvd_mul_left, key]
      exact dvd_mul_right _ _
    · rw [← hu2.dvd_mul_right, ← key]
      exact dvd_mul_left _ _

theorem wcpa_dj_llsm_smpcgb_outer_branch : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A
        {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M)),
      Q.IsPrime →
      Q.comap (algebraMap ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})
          ↥(integralClosure ↥(Algebra.adjoin A
            {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M)) =
        Ideal.span {algebraMap A ↥(Algebra.adjoin A
            {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})
            (t - algebraMap ↥W A c),
          ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c),
            Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A
            {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})).comp
            (algebraMap ↥W A)) →
      ∃ P ∈ (Ideal.span {x : ↥(integralClosure ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (x : M) =
            ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}).minimalPrimes,
        P ≤ Q ∧
        algebraMap ↥(Algebra.adjoin A
            {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})
          ↥(integralClosure ↥(Algebra.adjoin A
            {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M)
          ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c),
