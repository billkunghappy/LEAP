  classical

  have key : ∀ m : N, wcNsrCentred t m A →
      ∃ a : Spec (.of ↥A) ⟶ N, a (IsLocalRing.closedPoint ↥A) = m ∧
        Spec.map (CommRingCat.ofHom (algebraMap ↥A C.functionField)) ≫ a =
          C.fromSpecStalk (genericPoint C) ≫ t := by
    intro m ⟨h, hdom⟩
    set g := (wcLr1uGerm t m h).hom with hg
    let φ : N.presheaf.stalk m →+* ↥A := g.codRestrict A hdom.1
    have hloc : IsLocalHom φ := by
      constructor
      intro a ha
      obtain ⟨v, hv⟩ := isUnit_iff_exists_inv.mp ha
      have hv' : g a * (v : C.functionField) = 1 := congrArg Subtype.val hv
      exact hdom.2 a (v : C.functionField) v.2 hv'
    haveI : IsLocalHom (CommRingCat.ofHom φ).hom := hloc
    refine ⟨Spec.map (CommRingCat.ofHom φ) ≫ N.fromSpecStalk m, ?_, ?_⟩
    · show N.fromSpecStalk m (Spec.map (CommRingCat.ofHom φ) (IsLocalRing.closedPoint ↥A)) = m
      rw [Spec_closedPoint, Scheme.fromSpecStalk_closedPoint]
    · have hring : CommRingCat.ofHom φ ≫ CommRingCat.ofHom (algebraMap ↥A C.functionField) =
          N.presheaf.stalkSpecializes h ≫ t.stalkMap (genericPoint C) := by
        ext x
        rfl
      rw [← Category.assoc, ← Spec.map_comp, hring, Spec.map_comp, Category.assoc,
        Scheme.SpecMap_stalkSpecializes_fromSpecStalk, Scheme.SpecMap_stalkMap_fromSpecStalk]
  obtain ⟨a, ha, hga⟩ := key n hn
  obtain ⟨a', ha', hga'⟩ := key n' hn'
  haveI : IsSeparated q := hq
  let f := q ≫ Limits.terminal.from (Spec R)
  have hfsep : IsSeparated f := inferInstance
  let Sq : ValuativeCommSq f :=
    { R := ↥A
      K := C.functionField
      i₁ := C.fromSpecStalk (genericPoint C) ≫ t
      i₂ := a ≫ f
      commSq := ⟨by rw [← hga, Category.assoc]⟩ }
  have huniq := IsSeparated.valuativeCriterion f Sq
  let l1 : Sq.commSq.LiftStruct := ⟨a, hga, rfl⟩
  let l2 : Sq.commSq.LiftStruct := ⟨a', hga', Limits.terminal.hom_ext _ _⟩
  have he : a = a' := congrArg CommSq.LiftStruct.l (Subsingleton.elim l1 l2)
  rw [← ha, ← ha', he]

theorem wcpa_dj_lr1k_nsr_esp_coarsen : ∀ (L R : Type u) [Field L] [CommRing R] [IsLocalRing R] (A : ValuationSubring L) (φ : R →+* L), (∀ m ∈ IsLocalRing.maximalIdeal R, A.valuation (φ m) < 1) → ∃ ν : ValuationSubring L, A ≤ ν ∧ (∀ r, φ r ∈ ν) ∧ ∀ m ∈ IsLocalRing.maximalIdeal R, ν.valuation (φ m) < 1 :=
by
  intro L R _ _ _ A φ hloc
  let S : Subring L :=
    { carrier := {x | ∃ u : Rˣ, A.valuation x ≤ A.valuation (φ ↑u)}
      mul_mem' := by
        rintro x y ⟨u, hu⟩ ⟨u', hu'⟩
        refine ⟨u * u', ?_⟩
        rw [Units.val_mul, map_mul, map_mul, map_mul]
        exact mul_le_mul' hu hu'
      one_mem' := ⟨1, by simp⟩
      add_mem' := by
        rintro x y ⟨u, hu⟩ ⟨u', hu'⟩
        rcases le_total (A.valuation (φ ↑u)) (A.valuation (φ ↑u')) with h | h
        · exact ⟨u', (Valuation.map_add A.valuation x y).trans (max_le (hu.trans h) hu')⟩
        · exact ⟨u, (Valuation.map_add A.valuation x y).trans (max_le hu (hu'.trans h))⟩
      zero_mem' := ⟨1, by simp⟩
      neg_mem' := by
        rintro x ⟨u, hu⟩
        exact ⟨u, by rw [Valuation.map_neg]; exact hu⟩ }
  have hAS : ∀ x ∈ A, x ∈ S := by
    intro x hx
    refine ⟨1, ?_⟩
    rw [Units.val_one, map_one, map_one]
    exact (A.valuation_le_one_iff x).mpr hx
  let ν : ValuationSubring L :=
    ValuationSubring.ofSubring S (fun x => (A.mem_or_inv_mem x).imp (hAS x) (hAS x⁻¹))
  have hmem : ∀ x, x ∈ ν ↔ ∃ u : Rˣ, A.valuation x ≤ A.valuation (φ ↑u) := fun x => Iff.rfl
  refine ⟨ν, fun x hx => (hmem x).mpr (hAS x hx), ?_, ?_⟩
  · intro r
    rw [hmem]
    by_cases hr : r ∈ IsLocalRing.maximalIdeal R
    · refine ⟨1, ?_⟩
      rw [Units.val_one, map_one, map_one]
      exact (hloc r hr).le
    · obtain ⟨u, rfl⟩ := (IsLocalRing.notMem_maximalIdeal.mp hr)
      exact ⟨u, le_rfl⟩
  · intro m hm
    by_cases hx : φ m = 0
    · rw [hx, map_zero]
      exact zero_lt_one
    have hninv : (φ m)⁻¹ ∉ ν := by
      intro h
      obtain ⟨u, hu⟩ := (hmem _).mp h
      have h1 : (1 : A.ValueGroup) ≤ A.valuation (φ (m * ↑u)) := by
        calc (1 : A.ValueGroup) = A.valuation (φ m * (φ m)⁻¹) := by
              rw [mul_inv_cancel₀ hx, map_one]
          _ = A.valuation (φ m) * A.valuation (φ m)⁻¹ := map_mul _ _ _
          _ ≤ A.valuation (φ m) * A.valuation (φ ↑u) := mul_le_mul' le_rfl hu
          _ = A.valuation (φ (m * ↑u)) := by rw [map_mul φ, map_mul]
      have h2 := hloc _ (Ideal.mul_mem_right (↑u) _ hm)
      exact lt_irrefl _ (h1.trans_lt h2)
    have h3 : 1 < ν.valuation (φ m)⁻¹ := by
      rw [← not_le]
      exact fun h => hninv ((ν.valuation_le_one_iff _).mp h)
    have h4 := (Valuation.one_lt_val_iff ν.valuation (inv_ne_zero hx)).mp h3
    rwa [inv_inv] at h4

theorem wcpa_dj_lr1k_nsr_esp_generize : ∀ (C N : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (t : C ⟶ N) (n : N) (A ν : ValuationSubring C.functionField), A ≤ ν → wcNsrCentred t n A → ∃ n' : N, n' ⤳ n ∧ wcNsrCentred t n' ν :=
by
  intro C N _ t n A ν hAν hcA
  obtain ⟨hn, hdomA⟩ := hcA

  have factV : ∀ x y : C.functionField, x ∈ ν → y ∈ ν → x * y = 1 → ¬ ν.valuation x < 1 := by
    intro x y _ hy hxy hlt
    have h1 : ν.valuation y ≤ 1 := (ν.valuation_le_one_iff y).mpr hy
    have h2 : ν.valuation x * ν.valuation y < 1 := lt_of_le_of_lt (mul_le_of_le_one_right' h1) hlt
    rw [← map_mul, hxy, map_one] at h2
    exact lt_irrefl _ h2

  obtain ⟨U, hU, hnU, -⟩ := exists_isAffineOpen_mem_and_subset (x := n) (U := ⊤) trivial
  have hgU : t (genericPoint C) ∈ U := hn.mem_open U.isOpen hnU
  set ψ : Γ(N, U) →+* C.functionField :=
    (N.presheaf.germ U (t (genericPoint C)) hgU ≫ t.stalkMap (genericPoint C)).hom with hψ

  have gfac : ∀ (z : N) (hzU : z ∈ U) (hz : t (genericPoint C) ⤳ z) (r : Γ(N, U)),
      (wcLr1uGerm t z hz).hom ((N.presheaf.germ U z hzU).hom r) = ψ r := by
    intro z hzU hz r
    have e : N.presheaf.germ U z hzU ≫ wcLr1uGerm t z hz =
        N.presheaf.germ U (t (genericPoint C)) hgU ≫ t.stalkMap (genericPoint C) := by
      unfold wcLr1uGerm
      rw [← Category.assoc, TopCat.Presheaf.germ_stalkSpecializes]
    exact congrArg (fun f => f.hom r) e

  have hψν : ∀ r, ψ r ∈ ν := fun r => by
    rw [← gfac n hnU hn r]; exact hAν (hdomA.1 _)
  let ψ' : Γ(N, U) →+* ν := ψ.codRestrict ν hψν
  let P' : PrimeSpectrum Γ(N, U) :=
    ⟨Ideal.comap ψ' (IsLocalRing.maximalIdeal ν), Ideal.IsPrime.comap ψ'⟩
  have hP' : ∀ r, r ∈ P'.asIdeal ↔ ν.valuation (ψ r) < 1 := by
    intro r
    show ψ' r ∈ IsLocalRing.maximalIdeal ν ↔ _
    rw [ValuationSubring.valuation_lt_one_iff]
    exact Iff.rfl

  have hle1 : hU.primeIdealOf ⟨t (genericPoint C), hgU⟩ ≤ P' := by
    show (hU.primeIdealOf ⟨t (genericPoint C), hgU⟩).asIdeal ≤ P'.asIdeal
    intro r hr
    rw [hP']
    letI : Algebra Γ(N, U) (N.presheaf.stalk ((⟨t (genericPoint C), hgU⟩ : U) : N)) :=
      TopCat.Presheaf.algebra_section_stalk N.presheaf ⟨t (genericPoint C), hgU⟩
    haveI := hU.isLocalization_stalk ⟨t (genericPoint C), hgU⟩
    have h1 := (IsLocalization.AtPrime.to_map_mem_maximal_iff
      (N.presheaf.stalk ((⟨t (genericPoint C), hgU⟩ : U) : N))
      (hU.primeIdealOf ⟨t (genericPoint C), hgU⟩).asIdeal r).mpr hr
    change (N.presheaf.germ U (t (genericPoint C)) hgU).hom r ∈ _ at h1
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h1
    have h2 : ψ r = 0 := by
      by_contra hne
      apply h1
      exact isUnit_of_map_unit (t.stalkMap (genericPoint C)).hom _ (Ne.isUnit hne)
    rw [h2, map_zero]
    exact zero_lt_one
  have hle2 : P' ≤ hU.primeIdealOf ⟨n, hnU⟩ := by
    show P'.asIdeal ≤ (hU.primeIdealOf ⟨n, hnU⟩).asIdeal
    intro r hr
    by_contra hrq
    letI : Algebra Γ(N, U) (N.presheaf.stalk ((⟨n, hnU⟩ : U) : N)) :=
      TopCat.Presheaf.algebra_section_stalk N.presheaf ⟨n, hnU⟩
    haveI := hU.isLocalization_stalk ⟨n, hnU⟩
    have hunit : IsUnit ((N.presheaf.germ U n hnU).hom r) :=
      (IsLocalization.AtPrime.isUnit_to_map_iff (N.presheaf.stalk ((⟨n, hnU⟩ : U) : N))
        (hU.primeIdealOf ⟨n, hnU⟩).asIdeal r).mpr hrq
    obtain ⟨w, hw⟩ := hunit.exists_right_inv
    have e1 : ψ r * (wcLr1uGerm t n hn).hom w = 1 := by
      rw [← gfac n hnU hn r, ← map_mul, hw, map_one]
    exact factV _ _ (hψν r) (hAν (hdomA.1 w)) e1 ((hP' r).mp hr)

  set n' := hU.fromSpec P' with hn'
  have hspec1 : t (genericPoint C) ⤳ n' := by
    have := ((PrimeSpectrum.le_iff_specializes _ _).mp hle1).map hU.fromSpec.continuous
    rw [IsAffineOpen.fromSpec_primeIdealOf] at this
    exact this
  have hspec2 : n' ⤳ n := by
    have := ((PrimeSpectrum.le_iff_specializes _ _).mp hle2).map hU.fromSpec.continuous
    rw [IsAffineOpen.fromSpec_primeIdealOf] at this
    exact this
  have hn'U : n' ∈ U := by
    have : n' ∈ Set.range hU.fromSpec := ⟨P', rfl⟩
    rw [hU.range_fromSpec] at this
    exact this
  refine ⟨n', hspec2, hspec1, ?_⟩

  letI : Algebra Γ(N, U) (N.presheaf.stalk n') :=
    TopCat.Presheaf.algebra_section_stalk N.presheaf ⟨n', hn'U⟩
  haveI : IsLocalization.AtPrime (N.presheaf.stalk n') P'.asIdeal := hU.isLocalization_stalk' P' hn'U
  set g := (wcLr1uGerm t n' hspec1).hom with hg
  have halg : ∀ r, g (algebraMap Γ(N, U) (N.presheaf.stalk n') r) = ψ r :=
    fun r => gfac n' hn'U hspec1 r
  have hb : ∀ b : Γ(N, U), b ∉ P'.asIdeal → ν.valuation (ψ b) = 1 := by
    intro b hb
    have h1 : ν.valuation (ψ b) ≤ 1 := (ν.valuation_le_one_iff _).mpr (hψν b)
    have h2 : ¬ ν.valuation (ψ b) < 1 := fun h => hb ((hP' b).mpr h)
    exact le_antisymm h1 (not_lt.mp h2)
  constructor
  · intro e
    obtain ⟨⟨r, b⟩, rfl⟩ := IsLocalization.mk'_surjective P'.asIdeal.primeCompl e
    have hspec := IsLocalization.mk'_spec (N.presheaf.stalk n') r b
    have key : g (IsLocalization.mk' (N.presheaf.stalk n') r b) * ψ b = ψ r := by
      rw [← halg, ← halg, ← map_mul, hspec]
    have hb1 := hb b b.2
    have hψb0 : ψ b ≠ 0 := by
      intro h0
      rw [h0, map_zero] at hb1
      exact zero_ne_one hb1
    have hex : g (IsLocalization.mk' (N.presheaf.stalk n') r b) = ψ r * (ψ b)⁻¹ := by
      rw [← key, mul_assoc, mul_inv_cancel₀ hψb0, mul_one]
    show g (IsLocalization.mk' (N.presheaf.stalk n') r b) ∈ ν
    rw [← ν.valuation_le_one_iff, hex, map_mul, map_inv₀, hb1, inv_one, mul_one]
    exact (ν.valuation_le_one_iff _).mpr (hψν r)
  · intro e y hy hey
    obtain ⟨⟨r, b⟩, rfl⟩ := IsLocalization.mk'_surjective P'.asIdeal.primeCompl e
    have hspec := IsLocalization.mk'_spec (N.presheaf.stalk n') r b
    have key : g (IsLocalization.mk' (N.presheaf.stalk n') r b) * ψ b = ψ r := by
      rw [← halg, ← halg, ← map_mul, hspec]
    have e2 : ψ r * y = ψ b := by
      rw [← key, mul_right_comm, hey, one_mul]
    have hr : r ∉ P'.asIdeal := by
      intro hr
      have hb1 := hb b b.2
      have hlt := (hP' r).mp hr
      have hy1 : ν.valuation y ≤ 1 := (ν.valuation_le_one_iff _).mpr hy
      have h3 : ν.valuation (ψ r * y) < 1 := by
        rw [map_mul]
        exact lt_of_le_of_lt (mul_le_of_le_one_right' hy1) hlt
      rw [e2, hb1] at h3
      exact lt_irrefl _ h3
    have hru : IsUnit (algebraMap Γ(N, U) (N.presheaf.stalk n') r) :=
      (IsLocalization.AtPrime.isUnit_to_map_iff _ P'.asIdeal r).mpr hr
    rw [← hspec] at hru
    exact isUnit_of_mul_isUnit_left hru

theorem wcpa_dj_lr1k_nsr_esp_strict_point : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1),
      wcpaDjLkCov Ω γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)],
    wcpaDjLkModel W uX ι →
    ∀ y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX),
      wcpaDjLkSmAt W uX (wcpaDjLkPi W (γ ≫ ι) uX y₀) →
    ∀ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W),
      wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a →
    ∀ (X₁ : Scheme.{u}) (r₁ : X₁ ⟶ X) (ι₁ : wcProjK Ω 1 ⟶ X₁)
      [QuasiCompact (γ ≫ ι₁)] [QuasiSeparated (γ ≫ ι₁)],
      wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a) r₁ → ι₁ ≫ r₁ = ι →
      wcpaDjLkModel W (r₁ ≫ uX) ι₁ →
    ∀ w : ↥(wcpaDjLkFib W (γ ≫ ι₁) (r₁ ≫ uX)),
      r₁ (wcpaDjLkImg W (γ ≫ ι₁) (r₁ ≫ uX) w) = wcpaDjLkImg W (γ ≫ ι) uX y₀ →
    ∀ A : ValuationSubring C.functionField,
      wcNsrBdry W (γ ≫ ι) uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) A →
      wcNsrCentred (γ ≫ ι₁).toNormalization (wcNdPt W (γ ≫ ι₁) (r₁ ≫ uX) w) A →
    ∃ (ζ : ↥(wcpaDjLkFib W (γ ≫ ι₁) (r₁ ≫ uX))) (_ : ζ ⤳ w),
      closure {ζ} ∈ irreducibleComponents ↥(wcpaDjLkFib W (γ ≫ ι₁) (r₁ ≫ uX)) ∧
      r₁ (wcpaDjLkImg W (γ ≫ ι₁) (r₁ ≫ uX) ζ) ≠ wcpaDjLkImg W (γ ≫ ι) uX y₀ ∧
      ∃ ν : ValuationSubring C.functionField, A ≤ ν ∧
        wcNsrCentred (γ ≫ ι₁).toNormalization (wcNdPt W (γ ≫ ι₁) (r₁ ≫ uX) ζ) ν :=
by
  intro Ω _ _ W hW hWt C _ γ hcov X uX ι _ _ hM y₀ hSm σ a hP X₁ r₁ ι₁ _ _ hbl hι₁ hM₁ w hwx
    A hA hcA
  classical
  unfold wcNsrBdry at hA
  obtain ⟨-, η, hη, hB1, hB2, hB3, hB4, hB5⟩ := hA

  have hcl : ∀ p : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) p =
        IsLocalRing.closedPoint ↥W := by
    intro p
    have hp : p = IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W) := by
      exact Subsingleton.elim _ _
    rw [hp]
    haveI : IsLocalHom (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))).hom :=
      (inferInstance : IsLocalHom (IsLocalRing.residue ↥W))
    exact Spec_closedPoint

  haveI hκci : IsClosedImmersion
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI hjci : IsClosedImmersion (Limits.pullback.fst ((γ ≫ ι₁).fromNormalization ≫ r₁ ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    inferInstance
  have hjemb := (Limits.pullback.fst ((γ ≫ ι₁).fromNormalization ≫ r₁ ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).isClosedEmbedding

  have hImg : ∀ y : ↥(wcpaDjLkFib W (γ ≫ ι₁) (r₁ ≫ uX)),
      wcpaDjLkImg W (γ ≫ ι₁) (r₁ ≫ uX) y =
        (γ ≫ ι₁).fromNormalization (wcNdPt W (γ ≫ ι₁) (r₁ ≫ uX) y) := by
    intro y
    have e1 := Scheme.Hom.comp_apply
      (Limits.pullback.map ((γ ≫ ι₁).fromNormalization ≫ r₁ ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) (r₁ ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
        (γ ≫ ι₁).fromNormalization (𝟙 _) (𝟙 _) (by simp) (by simp))
      (Limits.pullback.fst (r₁ ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) y
    simp only [Limits.pullback.lift_fst, Scheme.Hom.comp_apply] at e1
    exact e1.symm

  have hover : ∀ y : ↥(wcpaDjLkFib W (γ ≫ ι₁) (r₁ ≫ uX)),
      uX (r₁ ((γ ≫ ι₁).fromNormalization (wcNdPt W (γ ≫ ι₁) (r₁ ≫ uX) y))) =
        IsLocalRing.closedPoint ↥W := by
    intro y
    have e := congrArg (fun m => m y) (Limits.pullback.condition
      (f := (γ ≫ ι₁).fromNormalization ≫ r₁ ≫ uX)
      (g := Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
    simp only [Scheme.Hom.comp_apply] at e
    rw [hcl] at e
    exact e

  have hxcl : IsClosed ({wcpaDjLkImg W (γ ≫ ι) uX y₀} : Set X) := by
    haveI : IsProper uX := hM.1.2.1
    haveI : IsClosedImmersion (σ ≫ uX) := by rw [hP.1]; infer_instance
    haveI : IsClosedImmersion σ := IsClosedImmersion.of_comp σ uX
    have h1 := σ.isClosedEmbedding.isClosedMap _ (IsLocalRing.isClosed_singleton_closedPoint ↥W)
    have e : (⇑σ '' {IsLocalRing.closedPoint ↥W}) = {wcpaDjLkImg W (γ ≫ ι) uX y₀} := by
      ext z
      constructor
      · rintro ⟨p, hp, rfl⟩
        rw [Set.mem_singleton_iff.mp hp]
        exact hP.2.1
      · intro hz
        rw [Set.mem_singleton_iff.mp hz]
        exact ⟨_, rfl, hP.2.1⟩
    rw [← e]
    exact h1
  obtain ⟨V, hV, hiso⟩ : ∃ V : X.Opens,
      (V : Set X) = {wcpaDjLkImg W (γ ≫ ι) uX y₀}ᶜ ∧ IsIso (r₁ ∣_ V) := by
    refine ⟨⟨_, hxcl.isOpen_compl⟩, rfl, ?_⟩
    haveI : IsProper uX := hM.1.2.1
    have hfp : LocallyOfFinitePresentation uX :=
      wcpa_dj_mn_flat_fp _ _ uX hM.1.1 inferInstance
    obtain ⟨-, hsupp, -⟩ := wcpa_dj_nc_centre_props Ω W hW X uX σ a hfp inferInstance hP.1
      hP.2.2.1 hP.2.2.2
    apply wc_csd_blowup_iso_off_center X X₁ _ r₁ _ hbl
    ext z
    simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
    intro hz hzV
    apply hzV
    show z ∈ ({wcpaDjLkImg W (γ ≫ ι) uX y₀} : Set X)
    rw [Set.mem_singleton_iff, hsupp z hz, hP.2.1]

  have hinj : ∀ p q : ↥X₁, r₁ p ≠ wcpaDjLkImg W (γ ≫ ι) uX y₀ →
      r₁ q ≠ wcpaDjLkImg W (γ ≫ ι) uX y₀ → r₁ p = r₁ q → p = q := by
