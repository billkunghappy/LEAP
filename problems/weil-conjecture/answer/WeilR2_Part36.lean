    have key : (Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫
        X.presheaf.germ ⊤ (h (genericPoint C)) (Set.mem_univ _) ≫ h.stalkMap (genericPoint C) =
        CommRingCat.ofHom (algebraMap ↥W Ω) ≫ (Scheme.ΓSpecIso (.of Ω)).inv ≫
          str.appTop ≫ C.presheaf.germ ⊤ (genericPoint C) trivial := by
      rw [Scheme.Hom.germ_stalkMap h ⊤ (genericPoint C) (Set.mem_univ _),
        Scheme.ΓSpecIso_inv_naturality_assoc]
      have h1 : uX.appTop ≫ h.app ⊤ = (h ≫ uX).appTop := (Scheme.Hom.comp_appTop _ _).symm
      rw [← Category.assoc uX.appTop, h1, E, Scheme.Hom.comp_appTop]
      rfl
    have h2 := congrArg (fun f => CommRingCat.Hom.hom f a) key
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h2
    have h3 : (C.presheaf.germ (h ⁻¹ᵁ O) (genericPoint C) hη).hom ((h.app O).hom
        ((uX.appLE ⊤ O le_top).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a))) =
        (h.stalkMap (genericPoint C)).hom ((X.presheaf.germ ⊤ (h (genericPoint C)) (Set.mem_univ _)).hom
          (uX.appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a))) := by
      rw [← Scheme.Hom.germ_stalkMap_apply h O (genericPoint C) hη]
      congr 1
      rw [show uX.appLE ⊤ O le_top = uX.app ⊤ ≫ X.presheaf.map (homOfLE (le_top : O ≤ uX ⁻¹ᵁ ⊤)).op
        from rfl]
      exact TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (le_top : O ≤ uX ⁻¹ᵁ ⊤))
        (h (genericPoint C)) hη _
    rw [h3, h2]
    rfl

  have K7 : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (X X₁ : Scheme.{u}) (h : C ⟶ X) (h₁ : C ⟶ X₁) (r₁ : X₁ ⟶ X), h₁ ≫ r₁ = h → ∀ (V : X.Opens) (V₁ : X₁.Opens) (hV₁ : V₁ ≤ r₁ ⁻¹ᵁ V) (σ₁ : Spec (.of ↥W) ⟶ X₁) (e₁ : ⊤ ≤ σ₁ ⁻¹ᵁ V₁) (A : ValuationSubring C.functionField), wcNsrNaDom A h₁ (σ₁ (IsLocalRing.closedPoint ↥W)) → ∀ (f b : Γ(X, V)) (c₁ c₂ ℓ : Γ(X₁, V₁)), (r₁.appLE V V₁ hV₁).hom f = c₁ * ℓ → (r₁.appLE V V₁ hV₁).hom b = c₂ * ℓ → (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ₁.appLE V₁ ⊤ e₁).hom c₁) = 0 → IsUnit ((Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ₁.appLE V₁ ⊤ e₁).hom c₂)) → ∀ hη : genericPoint C ∈ h ⁻¹ᵁ V, (C.presheaf.germ (h ⁻¹ᵁ V) (genericPoint C) hη).hom ((h.app V).hom b) ≠ 0 → A.valuation ((C.presheaf.germ (h ⁻¹ᵁ V) (genericPoint C) hη).hom ((h.app V).hom f)) < A.valuation ((C.presheaf.germ (h ⁻¹ᵁ V) (genericPoint C) hη).hom ((h.app V).hom b)) := by
    intro Ω _ W C _ X X₁ h h₁ r₁ hh V V₁ hV₁ σ₁ e₁ A hDom f b c₁ c₂ ℓ hf hb hc₁ hc₂ hη hne
    subst hh
    obtain ⟨hy, hle1, hlt1⟩ := hDom
    have hp : σ₁ (IsLocalRing.closedPoint ↥W) ∈ V₁ :=
      e₁ (show IsLocalRing.closedPoint ↥W ∈ (⊤ : (Spec (.of ↥W)).Opens) from trivial)
    have hx : h₁ (genericPoint C) ∈ r₁ ⁻¹ᵁ V := hη
    have compatM : r₁.appLE V V₁ hV₁ ≫ X₁.presheaf.germ V₁ _ hp ≫
        wcLr1uGerm h₁ (σ₁ (IsLocalRing.closedPoint ↥W)) hy =
        (h₁ ≫ r₁).app V ≫ C.presheaf.germ ((h₁ ≫ r₁) ⁻¹ᵁ V) (genericPoint C) hη := by
      unfold wcLr1uGerm
      rw [show r₁.appLE V V₁ hV₁ = r₁.app V ≫ X₁.presheaf.map (homOfLE hV₁).op from rfl,
        Category.assoc, X₁.presheaf.germ_res_assoc, X₁.presheaf.germ_stalkSpecializes_assoc,
        Scheme.Hom.germ_stalkMap h₁ (r₁ ⁻¹ᵁ V) (genericPoint C) hx, Scheme.Hom.comp_app]
      rfl
    have compat : ∀ y : Γ(X, V), (wcLr1uGerm h₁ (σ₁ (IsLocalRing.closedPoint ↥W)) hy).hom
        ((X₁.presheaf.germ V₁ _ hp).hom ((r₁.appLE V V₁ hV₁).hom y)) =
        (C.presheaf.germ ((h₁ ≫ r₁) ⁻¹ᵁ V) (genericPoint C) hη).hom (((h₁ ≫ r₁).app V).hom y) := by
      intro y
