theorem wcpa_dj_lr1k_llfi_norm_transitive : ∀ (C Y X : Scheme.{u}) (γ : C ⟶ Y) (ι : Y ⟶ X) [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)], Finite {a : C ≅ C // a.hom ≫ γ = γ} → (∀ U : X.Opens, IsAffineOpen U → ∀ s : Γ(C, (γ ≫ ι) ⁻¹ᵁ U), ((γ ≫ ι).app U).hom.IsIntegralElem s → (∀ (a : C ≅ C) (h : a.hom ≫ γ = γ), (a.hom.appLE ((γ ≫ ι) ⁻¹ᵁ U) ((γ ≫ ι) ⁻¹ᵁ U) (by rw [← Scheme.Hom.comp_preimage, ← Category.assoc, h])).hom s = s) → ∃ r : Γ(X, U), ((γ ≫ ι).app U).hom r = s) → ∀ z z' : ↥(γ ≫ ι).normalization, (γ ≫ ι).fromNormalization z = (γ ≫ ι).fromNormalization z' → ∃ Ψ : (γ ≫ ι).normalization ⟶ (γ ≫ ι).normalization, IsIso Ψ ∧ Ψ ≫ (γ ≫ ι).fromNormalization = (γ ≫ ι).fromNormalization ∧ Ψ z = z' :=
