    intro T F Ch _ _ _ _ _ p lam ρ hlinj hu hint hcov
    let L : Localization.Away p →+* F := IsLocalization.Away.lift (S := Localization.Away p) p hu
    have hLeq : ∀ t : T, L (algebraMap T (Localization.Away p) t) = lam t :=
      fun t => IsLocalization.Away.lift_eq (S := Localization.Away p) p hu t
    refine ⟨L, ?_, hLeq, ?_⟩
    · rw [injective_iff_map_eq_zero]
      intro z hz
