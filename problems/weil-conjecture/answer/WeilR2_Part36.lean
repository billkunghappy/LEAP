              A.valuation (wcLr1uConst (γ ≫ wcProjKStr Ω 1) ((a : ↥W) : Ω)) :=
by
  have K4 : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (L : Type u) [Field L] (α : RatFunc Ω →+* L) (φ : Ω →+* L), (∀ w : ↥W, φ (w : Ω) = α (algebraMap Ω (RatFunc Ω) (w : Ω))) → ∀ b : Ω, α RatFunc.X ≠ φ b := by
    intro Ω _ W L _ α φ hφ b
