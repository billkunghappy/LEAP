  intro Ω _ _ W _ _ b x β R hbm hb0 _ hβm hβ0 _ H1 H2
  classical

  have s2 : ∀ (d : ↥W → W.ValueGroup) (δ δ' ρ : W.ValueGroup) (l : List ↥W),
      (∀ i ∈ l, d i ≤ δ ∨ δ' ≤ d i) → δ ≤ ρ → ρ ≤ δ' →
      (l.map (fun i => max ρ (d i))).prod = ρ ^ (l.filter (fun i => decide (d i ≤ δ))).length *
        ((l.filter (fun i => !decide (d i ≤ δ))).map d).prod := by
    intro d δ δ' ρ l hD h1 h2
    induction l with
    | nil => simp
    | cons i l ih =>
      have ih' := ih (fun j hj => hD j (List.mem_cons_of_mem _ hj))
      rw [List.map_cons, List.prod_cons, ih']
      by_cases hi : d i ≤ δ
      · rw [List.filter_cons_of_pos (by simpa using hi), List.filter_cons_of_neg (by simpa using hi)]
        rw [max_eq_left (hi.trans h1), List.length_cons, pow_succ]; ac_rfl
      · have h3 : δ' ≤ d i := (hD i (by simp)).resolve_left hi
        rw [List.filter_cons_of_neg (by simpa using hi), List.filter_cons_of_pos (by simpa using hi)]
        rw [max_eq_right (h2.trans h3), List.map_cons, List.prod_cons]; ac_rfl

