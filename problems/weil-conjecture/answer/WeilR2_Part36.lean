    fun h => hηβ ((Scheme.mem_basicOpen X βb η hηU).mpr h)
  have hq : (X.presheaf.germ U₁.1 η hηU).hom βb * ↑hku.unit⁻¹ ∈
      IsLocalRing.maximalIdeal (X.presheaf.stalk η) := by
    apply Ideal.mul_mem_right
    exact (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hβnu)
  have hgβ : (X.presheaf.germ U₁.1 η hηU).hom βb =
      ((X.presheaf.germ U₁.1 η hηU).hom βb * ↑hku.unit⁻¹) * (X.presheaf.germ U₁.1 η hηU).hom k := by
    rw [mul_assoc, hku.val_inv_mul, mul_one]
  have hv1 := hmη _ hq
  have hpos : 0 < A''.valuation ((wcLr1uGerm (γ ≫ ι) η hfη).hom
      ((X.presheaf.germ U₁.1 η hηU).hom k)) := by
    rw [Valuation.pos_iff]
    exact (hku.map (wcLr1uGerm (γ ≫ ι) η hfη).hom).ne_zero
  have hineq : A''.valuation ((wcLr1uGerm (γ ≫ ι) η hfη).hom ((X.presheaf.germ U₁.1 η hηU).hom βb))
      < A''.valuation ((wcLr1uGerm (γ ≫ ι) η hfη).hom ((X.presheaf.germ U₁.1 η hηU).hom k)) := by
    rw [hgβ, map_mul, Valuation.map_mul]
    exact mul_lt_of_lt_one_left hpos hv1

  have hr' : (γ ≫ ιb) ≫ rb = γ ≫ ι := by rw [Category.assoc, hιb]
  have hineq' : A''.valuation ((wcLr1uGerm (γ ≫ ιb) p hp).hom ((Xb.presheaf.germ V.1 p hpV).hom
      ((rb.appLE U₁.1 V.1 e).hom βb))) < A''.valuation ((wcLr1uGerm (γ ≫ ιb) p hp).hom
      ((Xb.presheaf.germ V.1 p hpV).hom ((rb.appLE U₁.1 V.1 e).hom k))) := by
    rw [s4 _ _ hr' U₁.1 V.1 e p hpV hp hg, s4 _ _ hr' U₁.1 V.1 e p hpV hp hg, ← hcompη, ← hcompη]
    exact hineq

  have hmap' : Ideal.map (rb.appLE U₁.1 V.1 e).hom (σ₀.ker.ideal U₁ ⊔ Ideal.span {βb}) =
      Ideal.span {(rb.appLE U₁.1 V.1 e).hom a} := by
    have h := hmap
    rw [hsup b U₁, ← hβb] at h
    exact h
  obtain ⟨j, hjJ, y, hjy, hyu⟩ := s5 Γ(X, U₁.1) Γ(Xb, V.1) (Xb.presheaf.stalk p) C.functionField A''
    (rb.appLE U₁.1 V.1 e).hom (Xb.presheaf.germ V.1 p hpV).hom (wcLr1uGerm (γ ≫ ιb) p hp).hom
    hdom.1 (σ₀.ker.ideal U₁) βb k ((rb.appLE U₁.1 V.1 e).hom a) hk hε hmap' hineq'

  have hle_b : (σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX b').ideal U₁ ≤
      (σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX b).ideal U₁ := by
    rw [hsup b' U₁, hsup b U₁]
    refine sup_le_sup_left ?_ _
    rw [Ideal.span_singleton_le_span_singleton]
    exact map_dvd _ (map_dvd _ (map_dvd _ hdvd))
  have hj' : j ∈ (σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX b').ideal U₁ := by
    rw [hsup b' U₁]; exact Ideal.mem_sup_left hjJ

  have e' : Xb.basicOpen y ≤ rb ⁻¹ᵁ U₁.1 := (Xb.basicOpen_le y).trans e
  have hform : ∀ z : Γ(X, U₁.1), (rb.appLE U₁.1 (Xb.basicOpen y) e').hom z =
      (Xb.presheaf.map (homOfLE (Xb.basicOpen_le y)).op).hom ((rb.appLE U₁.1 V.1 e).hom z) := by
    intro z
    rw [← Scheme.Hom.appLE_map rb e (homOfLE (Xb.basicOpen_le y)).op]
    rfl
  have hεres : (Xb.presheaf.map (homOfLE (Xb.basicOpen_le y)).op).hom ((rb.appLE U₁.1 V.1 e).hom a)
      ∈ nonZeroDivisors Γ(Xb, Xb.basicOpen y) :=
    @IsLocalization.map_nonZeroDivisors_le _ _ (Submonoid.powers y) _ _ _
      (V.2.isLocalization_basicOpen y) _ (Submonoid.mem_map_of_mem _ hε)
  have hyunit : IsUnit ((Xb.presheaf.map (homOfLE (Xb.basicOpen_le y)).op).hom y) :=
    @IsLocalization.Away.algebraMap_isUnit _ _ _ _ _ y (V.2.isLocalization_basicOpen y)
  have hφ'j : (rb.appLE U₁.1 (Xb.basicOpen y) e').hom j =
      (Xb.presheaf.map (homOfLE (Xb.basicOpen_le y)).op).hom y *
      (Xb.presheaf.map (homOfLE (Xb.basicOpen_le y)).op).hom ((rb.appLE U₁.1 V.1 e).hom a) := by
    rw [hform, hjy, map_mul]
  have hnzd : (rb.appLE U₁.1 (Xb.basicOpen y) e').hom j ∈ nonZeroDivisors Γ(Xb, Xb.basicOpen y) := by
    rw [hφ'j]
    exact mul_mem_nonZeroDivisors.mpr ⟨hyunit.mem_nonZeroDivisors, hεres⟩
  have hJb : Ideal.map (rb.appLE U₁.1 (Xb.basicOpen y) e').hom
      ((σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX b).ideal U₁) =
      Ideal.span {(Xb.presheaf.map (homOfLE (Xb.basicOpen_le y)).op).hom
        ((rb.appLE U₁.1 V.1 e).hom a)} := by
    have hcomp' : (rb.appLE U₁.1 (Xb.basicOpen y) e').hom =
        (Xb.presheaf.map (homOfLE (Xb.basicOpen_le y)).op).hom.comp (rb.appLE U₁.1 V.1 e).hom :=
      RingHom.ext hform
    rw [hcomp', ← Ideal.map_map, hmap, Ideal.map_span, Set.image_singleton]
  have hJb' : Ideal.map (rb.appLE U₁.1 (Xb.basicOpen y) e').hom
      ((σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX b').ideal U₁) =
      Ideal.span {(rb.appLE U₁.1 (Xb.basicOpen y) e').hom j} := by
    apply le_antisymm
    · rw [hφ'j, Ideal.span_singleton_mul_left_unit hyunit, ← hJb]
      exact Ideal.map_mono hle_b
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact Ideal.mem_map_of_mem _ hj'

  have hUaff : IsAffineOpen (Xb.basicOpen y) := V.2.basicOpen y
  have hpU : p ∈ Xb.basicOpen y := (Scheme.mem_basicOpen Xb y p hpV).mpr hyu
  refine ⟨Xb.basicOpen y, hUaff, hpU, ?_⟩
  haveI : IsAffine (Xb.basicOpen y).toScheme := hUaff
  have e₂ : (⊤ : (Xb.basicOpen y).toScheme.Opens) ≤ (Xb.basicOpen y).ι ⁻¹ᵁ (Xb.basicOpen y) := by
    rw [Scheme.Opens.ι_preimage_self]
  have hVU : (⊤ : (Xb.basicOpen y).toScheme.Opens) ≤ ((Xb.basicOpen y).ι ≫ rb) ⁻¹ᵁ U₁.1 :=
    fun t _ => e' t.2
  haveI hiso : IsIso ((Xb.basicOpen y).ι.appLE (Xb.basicOpen y) ⊤ e₂) := by
    rw [Scheme.Opens.ι_appLE]
    exact ⟨⟨Xb.presheaf.map (homOfLE (Scheme.Opens.ι_image_top (Xb.basicOpen y)).ge).op,
      by erw [← Functor.map_comp]
         exact (congrArg Xb.presheaf.map (Quiver.Hom.unop_inj (Subsingleton.elim _ _))).trans
           (Xb.presheaf.map_id _),
      by erw [← Functor.map_comp]
         exact (congrArg Xb.presheaf.map (Quiver.Hom.unop_inj (Subsingleton.elim _ _))).trans
           (Xb.presheaf.map_id _)⟩⟩
  let eψ := (asIso ((Xb.basicOpen y).ι.appLE (Xb.basicOpen y) ⊤ e₂)).commRingCatIsoToRingEquiv
  have heψ : ∀ s, eψ s = ((Xb.basicOpen y).ι.appLE (Xb.basicOpen y) ⊤ e₂).hom s := fun s => rfl
  have hcomp : ∀ z : Γ(X, U₁.1), (((Xb.basicOpen y).ι ≫ rb).appLE U₁.1 ⊤ hVU).hom z =
      eψ ((rb.appLE U₁.1 (Xb.basicOpen y) e').hom z) := by
    intro z
    rw [heψ, ← Scheme.Hom.appLE_comp_appLE (Xb.basicOpen y).ι rb U₁.1 (Xb.basicOpen y) ⊤ e' e₂]
    rfl
  intro t
  refine ⟨U₁, ⟨⊤, isAffineOpen_top _⟩, hVU, j, trivial, hj', ?_, ?_⟩
  · show (((Xb.basicOpen y).ι ≫ rb).appLE U₁.1 ⊤ hVU).hom j ∈ nonZeroDivisors _
    rw [hcomp, ← MulEquivClass.map_nonZeroDivisors eψ]
    exact Submonoid.mem_map_of_mem eψ hnzd
  · show Ideal.map (((Xb.basicOpen y).ι ≫ rb).appLE U₁.1 ⊤ hVU).hom _ =
      Ideal.span {(((Xb.basicOpen y).ι ≫ rb).appLE U₁.1 ⊤ hVU).hom j}
    have hc2 : (((Xb.basicOpen y).ι ≫ rb).appLE U₁.1 ⊤ hVU).hom =
        (eψ : Γ(Xb, Xb.basicOpen y) →+* _).comp (rb.appLE U₁.1 (Xb.basicOpen y) e').hom :=
      RingHom.ext hcomp
    rw [hc2, ← Ideal.map_map, hJb', Ideal.map_span, Set.image_singleton]
    rfl

theorem wcpa_dj_lr1k_nsr_ubn_centre_unique : ∀ (C N : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (R : CommRingCat.{u}) (t : C ⟶ N) (sN : N ⟶ Spec R), IsSeparated sN → ∀ (n₁ n₂ : N) (V : ValuationSubring C.functionField), wcNsrCentred t n₁ V → wcNsrCentred t n₂ V → n₁ = n₂ :=
by
  intro C N _ R t q hq n n' A hn hn'
  classical
  have key : ∀ m : N, wcNsrCentred t m A →
      ∃ a : Spec (.of ↥A) ⟶ N, a (IsLocalRing.closedPoint ↥A) = m ∧
        Spec.map (CommRingCat.ofHom (algebraMap ↥A C.functionField)) ≫ a =
          C.fromSpecStalk (genericPoint C) ≫ t := by
    intro m ⟨h, hdom⟩
    set g := (wcLr1uGerm t m h).hom with hg
    let φ : N.presheaf.stalk m →+* ↥A := g.codRestrict A hdom.1
    have hloc : IsLocalHom φ := by
      constructor
      intro a ha
      obtain ⟨v, hv⟩ := isUnit_iff_exists_inv.mp ha
      have hv' : g a * (v : C.functionField) = 1 := congrArg Subtype.val hv
      exact hdom.2 a (v : C.functionField) v.2 hv'
    haveI : IsLocalHom (CommRingCat.ofHom φ).hom := hloc
    refine ⟨Spec.map (CommRingCat.ofHom φ) ≫ N.fromSpecStalk m, ?_, ?_⟩
    · show N.fromSpecStalk m (Spec.map (CommRingCat.ofHom φ) (IsLocalRing.closedPoint ↥A)) = m
      rw [Spec_closedPoint, Scheme.fromSpecStalk_closedPoint]
    · have hring : CommRingCat.ofHom φ ≫ CommRingCat.ofHom (algebraMap ↥A C.functionField) =
          N.presheaf.stalkSpecializes h ≫ t.stalkMap (genericPoint C) := by
        ext x
        rfl
      rw [← Category.assoc, ← Spec.map_comp, hring, Spec.map_comp, Category.assoc,
        Scheme.SpecMap_stalkSpecializes_fromSpecStalk, Scheme.SpecMap_stalkMap_fromSpecStalk]
  obtain ⟨a, ha, hga⟩ := key n hn
  obtain ⟨a', ha', hga'⟩ := key n' hn'
  haveI : IsSeparated q := hq
  let f := q ≫ Limits.terminal.from (Spec R)
  have hfsep : IsSeparated f := inferInstance
  let Sq : ValuativeCommSq f :=
    { R := ↥A
      K := C.functionField
      i₁ := C.fromSpecStalk (genericPoint C) ≫ t
      i₂ := a ≫ f
      commSq := ⟨by rw [← hga, Category.assoc]⟩ }
  have huniq := IsSeparated.valuativeCriterion f Sq
  let l1 : Sq.commSq.LiftStruct := ⟨a, hga, rfl⟩
  let l2 : Sq.commSq.LiftStruct := ⟨a', hga', Limits.terminal.hom_ext _ _⟩
  have he : a = a' := congrArg CommSq.LiftStruct.l (Subsingleton.elim l1 l2)
  rw [← ha, ← ha', he]

theorem wcpa_dj_lr1k_nsr_ubn_centre_push : ∀ (C N₁ N₂ : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (t₁ : C ⟶ N₁) (t₂ : C ⟶ N₂) (O : N₁.Opens) (Ψ : O.toScheme ⟶ N₂), (t₁ ∣_ O) ≫ Ψ = (t₁ ⁻¹ᵁ O).ι ≫ t₂ → ∀ (n : N₁) (hn : n ∈ O) (V : ValuationSubring C.functionField), wcNsrCentred t₁ n V → wcNsrCentred t₂ (Ψ ⟨n, hn⟩) V :=
by
  intro C N₁ N₂ _ t₁ t₂ O Ψ hsq n hn V hcen
  obtain ⟨h₁, hdom⟩ := hcen

  have germ_comp : ∀ (X Y Z : Scheme.{u}) (φ : X ⟶ Z) (a : X ⟶ Y) (b : Y ⟶ Z), a ≫ b = φ →
      ∀ (x : X) (y : Y) (z : Z) (h : a x ⤳ y) (h' : b y ⤳ z) (h'' : φ x ⤳ z),
      Z.presheaf.stalkSpecializes h'' ≫ φ.stalkMap x =
        (Z.presheaf.stalkSpecializes h' ≫ b.stalkMap y) ≫
          (Y.presheaf.stalkSpecializes h ≫ a.stalkMap x) := by
    intro X Y Z φ a b hab x y z h h' h''
    subst hab
    rw [Scheme.Hom.stalkMap_comp]
    simp only [Category.assoc]
    rw [← Scheme.Hom.stalkSpecializes_stalkMap_assoc b (a x) y h,
      TopCat.Presheaf.stalkSpecializes_comp_assoc]
    rfl

  have dom_comp : ∀ {A B K : Type u} [CommRing A] [CommRing B] [CommRing K] (θ : A →+* B),
      IsLocalHom θ → ∀ (φ : B →+* K) (S : Set K), wcLr1uDom φ S → wcLr1uDom (φ.comp θ) S := by
    intro A B K _ _ _ θ hθ φ S hd
    exact ⟨fun a => hd.1 (θ a), fun a s hs h => isUnit_of_map_unit θ a (hd.2 (θ a) s hs h)⟩

  have hξO : t₁ (genericPoint C) ∈ O := h₁.mem_open O.isOpen hn
  let ξ' : (t₁ ⁻¹ᵁ O).toScheme := ⟨genericPoint C, hξO⟩
  let n' : O.toScheme := ⟨n, hn⟩
  let s := t₁ ∣_ O
  let j := (t₁ ⁻¹ᵁ O).ι
  have hι1 : s ≫ O.ι = j ≫ t₁ := morphismRestrict_ι t₁ O
  have hsξ : O.ι (s ξ') = t₁ (genericPoint C) := by
    rw [← Scheme.Hom.comp_apply, hι1]; rfl
  have h : s ξ' ⤳ n' := by
    apply (O.ι.isOpenEmbedding.isInducing.specializes_iff).mp
    rw [hsξ]; exact h₁
  have ht : t₂ (genericPoint C) = Ψ (s ξ') := by
    have := congrArg (fun f : (t₁ ⁻¹ᵁ O).toScheme ⟶ N₂ => f ξ') hsq
    simp only [Scheme.Hom.comp_apply] at this
    exact this.symm
  have h₂ : t₂ (genericPoint C) ⤳ Ψ n' := by
    rw [ht]; exact h.map Ψ.continuous
  have hA : (j ≫ t₂) ξ' ⤳ Ψ n' := by
    rw [Scheme.Hom.comp_apply]; exact h₂
  have hB : (j ≫ t₁) ξ' ⤳ n := by
    rw [Scheme.Hom.comp_apply]; exact h₁
  have hr2 : Ψ n' ⤳ Ψ n' := specializes_refl _
  have hrj : j ξ' ⤳ j ξ' := specializes_refl _
  have hrO : O.ι n' ⤳ O.ι n' := specializes_refl _
  have h₂' : t₂ (j ξ') ⤳ Ψ n' := h₂
  have h₁' : t₁ (j ξ') ⤳ O.ι n' := h₁
  have hB' : (j ≫ t₁) ξ' ⤳ O.ι n' := hB

  have G1 := germ_comp _ _ _ (j ≫ t₂) j t₂ rfl ξ' (j ξ') (Ψ n') hrj h₂' hA
  have G2 := germ_comp _ _ _ (j ≫ t₂) s Ψ hsq ξ' n' (Ψ n') h hr2 hA
  have G3 := germ_comp _ _ _ (j ≫ t₁) s O.ι hι1 ξ' n' (O.ι n') h hrO hB'
  have G4 := germ_comp _ _ _ (j ≫ t₁) j t₁ rfl ξ' (j ξ') (O.ι n') hrj h₁' hB'
  rw [TopCat.Presheaf.stalkSpecializes_refl, Category.id_comp] at G1 G2 G3 G4
  have G12 := G1.symm.trans G2
  have G34 := G3.symm.trans G4
  set M := O.toScheme.presheaf.stalkSpecializes h ≫ s.stalkMap ξ' with hMdef
  set germ₁ := N₁.presheaf.stalkSpecializes h₁' ≫ t₁.stalkMap (j ξ') with hg1
  set germ₂ := N₂.presheaf.stalkSpecializes h₂' ≫ t₂.stalkMap (j ξ') with hg2
  have hM : M = inv (O.ι.stalkMap n') ≫ germ₁ ≫ j.stalkMap ξ' :=
    (IsIso.eq_inv_comp _).mpr G34
  have key : germ₂ ≫ j.stalkMap ξ' =
      ((Ψ.stalkMap n' ≫ inv (O.ι.stalkMap n')) ≫ germ₁) ≫ j.stalkMap ξ' := by
    rw [G12, hM]; simp only [Category.assoc]
  have hfac : germ₂ = (Ψ.stalkMap n' ≫ inv (O.ι.stalkMap n')) ≫ germ₁ :=
    (cancel_mono (j.stalkMap ξ')).mp key

  have hθ : IsLocalHom (Ψ.stalkMap n' ≫ inv (O.ι.stalkMap n')).hom := by
    rw [CommRingCat.hom_comp]; infer_instance
  refine ⟨h₂, ?_⟩
  show wcLr1uDom germ₂.hom (V : Set C.functionField)
  rw [hfac, CommRingCat.hom_comp]
  exact dom_comp _ hθ _ _ hdom

theorem wcpa_dj_lr1k_nsr_ubn_norm_local_map : ∀ (C Y Y' : Scheme.{u}) (f : C ⟶ Y) (f' : C ⟶ Y') [QuasiCompact f] [QuasiSeparated f] [QuasiCompact f'] [QuasiSeparated f'] (U : Y.Opens), IsAffineOpen U → ∀ (φ : U.toScheme ⟶ Y'), (f ∣_ U) ≫ φ = (f ⁻¹ᵁ U).ι ≫ f' → ∃ Ψ : (f.fromNormalization ⁻¹ᵁ U).toScheme ⟶ f'.normalization, (f.toNormalization ∣_ (f.fromNormalization ⁻¹ᵁ U)) ≫ Ψ = (f.toNormalization ⁻¹ᵁ (f.fromNormalization ⁻¹ᵁ U)).ι ≫ f'.toNormalization :=
by
  intro C Y Y' f f' _ _ _ _ U hU φ hφ
  classical
  have : IsAffine U.toScheme := hU

  let T := Limits.pullback φ f'.fromNormalization
  let q : T ⟶ U.toScheme := Limits.pullback.fst φ f'.fromNormalization
  have hqI : IsIntegralHom q := inferInstance
  have : IsAffine T := isAffine_of_isAffineHom q
  have hqint : (q.appTop).hom.IsIntegral :=
    ((isIntegralHom_iff q).1 hqI).2 ⊤ (isAffineOpen_top _)

  have hcomm : (f ∣_ U) ≫ φ = ((f ⁻¹ᵁ U).ι ≫ f'.toNormalization) ≫ f'.fromNormalization := by
    rw [Category.assoc, Scheme.Hom.toNormalization_fromNormalization]; exact hφ
  let g' : (f ⁻¹ᵁ U).toScheme ⟶ T :=
    Limits.pullback.lift (f ∣_ U) ((f ⁻¹ᵁ U).ι ≫ f'.toNormalization) hcomm
  have hg'q : g' ≫ q = f ∣_ U := Limits.pullback.lift_fst _ _ _
  have hg's : g' ≫ Limits.pullback.snd φ f'.fromNormalization = (f ⁻¹ᵁ U).ι ≫ f'.toNormalization :=
    Limits.pullback.lift_snd _ _ _

  let ψ₀ : Γ(T, ⊤) ⟶ Γ(C, f ⁻¹ᵁ U) := g'.appTop ≫ (f ⁻¹ᵁ U).topIso.hom
  have hsq : (f ∣_ U).appTop ≫ (f ⁻¹ᵁ U).topIso.hom = U.topIso.hom ≫ f.app U := by
    simp only [morphismRestrict_appTop, Scheme.Opens.topIso_hom]
    simp only [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map]
    erw [Scheme.Hom.map_appLE]
    erw [Scheme.Hom.appLE_map]
  have hN : q.appTop ≫ ψ₀ = U.topIso.hom ≫ f.app U := by
    have : q.appTop ≫ g'.appTop = (f ∣_ U).appTop := by
      rw [← Scheme.Hom.comp_appTop, hg'q]
    rw [← hsq, ← this]
    rfl
  letI : Algebra Γ(Y, U) Γ(C, f ⁻¹ᵁ U) := (f.app U).hom.toAlgebra
  have hI : ∀ y : Γ(T, ⊤), ψ₀.hom y ∈ integralClosure Γ(Y, U) Γ(C, f ⁻¹ᵁ U) := by
    intro y
    obtain ⟨P, hPm, hP⟩ := hqint y
    refine ⟨P.map U.topIso.hom.hom, hPm.map _, ?_⟩
    rw [Polynomial.eval₂_map]
    have e1 : (algebraMap Γ(Y, U) Γ(C, f ⁻¹ᵁ U)).comp U.topIso.hom.hom
        = ψ₀.hom.comp q.appTop.hom := by
      rw [← CommRingCat.hom_comp, hN]; rfl
    rw [e1, ← Polynomial.hom_eval₂, hP, map_zero]
  let ψ : Γ(T, ⊤) →+* integralClosure Γ(Y, U) Γ(C, f ⁻¹ᵁ U) := ψ₀.hom.codRestrict _ hI

  let U' : Y.affineOpens := ⟨U, hU⟩
  let val : CommRingCat.of (integralClosure Γ(Y, U) Γ(C, f ⁻¹ᵁ U)) ⟶ Γ(C, f ⁻¹ᵁ U) :=
    CommRingCat.ofHom (integralClosure Γ(Y, U) Γ(C, f ⁻¹ᵁ U)).val.toRingHom
  let j : Spec (CommRingCat.of (integralClosure Γ(Y, U) Γ(C, f ⁻¹ᵁ U))) ⟶ f.normalization :=
    f.normalizationOpenCover.f U'
  have : IsOpenImmersion j := f.normalizationOpenCover.map_prop U'
  have hιt : (f ⁻¹ᵁ U).ι ≫ f.toNormalization = (f ⁻¹ᵁ U).toSpecΓ ≫ Spec.map val ≫ j :=
    Scheme.Hom.ι_toNormalization f U'
  have hrange : Set.range (f.fromNormalization ⁻¹ᵁ U).ι ⊆ Set.range j := by
    intro x hx
    rw [Scheme.Opens.range_ι] at hx
    have e := Scheme.Hom.fromNormalization_preimage f U'
    have hx' : x ∈ f.fromNormalization ⁻¹ᵁ U := hx
    rw [e] at hx'
    exact hx'
  let σ := IsOpenImmersion.lift j (f.fromNormalization ⁻¹ᵁ U).ι hrange
  have hσ : σ ≫ j = (f.fromNormalization ⁻¹ᵁ U).ι := IsOpenImmersion.lift_fac _ _ _
  refine ⟨σ ≫ Spec.map (CommRingCat.ofHom ψ) ≫ T.isoSpec.inv ≫
    Limits.pullback.snd φ f'.fromNormalization, ?_⟩
  have hDeq : f.toNormalization ⁻¹ᵁ (f.fromNormalization ⁻¹ᵁ U) = f ⁻¹ᵁ U := by
    rw [← Scheme.Hom.comp_preimage, Scheme.Hom.toNormalization_fromNormalization]
