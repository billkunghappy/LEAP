theorem wcpa_dj_lr1k_nsr_bv_eta : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X) [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)], wcpaDjLkModel W uX ι → ∀ y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX), wcpaDjLkSmAt W uX (wcpaDjLkPi W (γ ≫ ι) uX y₀) → ∀ τ : (Spec (.of ↥W) ⟶ X) → ↥W, wcpaDjLlDiscParam W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) τ → ∃ (η : X) (_ : (γ ≫ ι) (genericPoint C) ⤳ η), η ⤳ wcpaDjLkImg W (γ ≫ ι) uX y₀ ∧ η ≠ wcpaDjLkImg W (γ ≫ ι) uX y₀ ∧ uX η = IsLocalRing.closedPoint ↥W ∧ (∀ η' : X, uX η' = IsLocalRing.closedPoint ↥W → η' ⤳ η → η' = η) :=
by
  intro Ω _ _ W hW hWt C _ γ hcov X uX ι _ _ hM y₀ hSm τ hτ
