by
  intro Ω _ _ W A _ _ _ K _ _ _ M _ _ _ _ _ _ B _ _ _ _ _ _ _ _ 𝔭 t h 𝔮 t' hPD hSmc
  classical
  unfold wcLlsSmc at hSmc
  obtain ⟨_hh, hint, hPDB, hcomap, huniq⟩ := hSmc
  have inj : Function.Injective (algebraMap B M) := IsFractionRing.injective B M
  haveI : IsIntegrallyClosed A := hPD.2.2.1
