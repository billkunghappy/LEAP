    simp only [Scheme.Hom.comp_apply] at e ⊢
    rw [hcl] at e
    exact e
  have hnc : ¬ IsClosed ({(γ ≫ ι₁).fromNormalization (wcNdPt W (γ ≫ ι₁) (r₁ ≫ uX) ζ)} :
      Set ↥X₁) := by
    intro hcl'
    have hsp : (γ ≫ ι₁).fromNormalization (wcNdPt W (γ ≫ ι₁) (r₁ ≫ uX) ζ) ⤳
        (γ ≫ ι₁).fromNormalization (wcNdPt W (γ ≫ ι₁) (r₁ ≫ uX) w) :=
