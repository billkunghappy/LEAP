    intro g
    obtain ⟨s, rfl⟩ := hsurj g
    by_cases hg : ψ s = 0
    · left
      rw [hg]
      exact V0.zero_mem
    · have hsu : IsUnit s :=
        IsLocalRing.notMem_maximalIdeal.mp (fun hm => hg ((hker s).mpr hm))
      obtain ⟨u, rfl⟩ := hsu
      rcases A.mem_or_inv_mem (φ ↑u) with h1 | h1
      · left
        exact (hV0 _).mpr ⟨u, h1, rfl⟩
      · right
        refine (hV0 _).mpr ⟨↑u⁻¹, ?_, ?_⟩
        · rw [map_units_inv]
          exact h1
        · rw [map_units_inv]
  let V : ValuationSubring (F.residueField ζ) := { V0 with mem_or_inv_mem' := hmi }
  have hV : ∀ g, g ∈ V ↔ ∃ s, φ s ∈ A ∧ ψ s = g := fun g => hV0 g
  refine ⟨V, ?_, hV⟩

  intro r
  obtain ⟨sl, hsl⟩ := SurjectiveOnStalks.stalkMap_surjective j w r
  have hj : j ζ ⤳ j w := h.map j.continuous
  have e : j.stalkMap w ≫ F.presheaf.stalkSpecializes h ≫ F.residue ζ =
      N.presheaf.stalkSpecializes hj ≫ N.residue (j ζ) ≫ j.residueFieldMap ζ := by
    rw [Scheme.residue_residueFieldMap, ← Category.assoc,
      ← Scheme.Hom.stalkSpecializes_stalkMap, Category.assoc]
  have hρ : wcNsrEbRho F h r = ψ ((N.presheaf.stalkSpecializes hj).hom sl) := by
    rw [← hsl]
    exact congrArg (fun m => m.hom sl) e
  have e2 : N.presheaf.stalkSpecializes hj ≫ wcLr1uGerm t (j ζ) hζ = wcLr1uGerm t (j w) hw := by
    unfold wcLr1uGerm
    rw [← Category.assoc, TopCat.Presheaf.stalkSpecializes_comp]
  have hgerm : φ ((N.presheaf.stalkSpecializes hj).hom sl) = (wcLr1uGerm t (j w) hw).hom sl :=
    congrArg (fun m => m.hom sl) e2
  generalize (N.presheaf.stalkSpecializes hj).hom sl = s at hρ hgerm
  have hφA : φ s ∈ A := by
    rw [hgerm]
    exact hAw1 sl
  have hsV : wcNsrEbRho F h r ∈ V := by
    rw [hρ]
    exact (hV _).mpr ⟨s, hφA, rfl⟩
  refine ⟨hsV, fun hr => ?_⟩
  have hslm : ¬ IsUnit sl := by
    intro hu
    have hu' := hu.map (j.stalkMap w).hom
    rw [hsl] at hu'
    exact (IsLocalRing.mem_maximalIdeal r).mp hr hu'
  have hlt : A.valuation (φ s) < 1 := by
    refine lt_of_le_of_ne ((A.valuation_le_one_iff _).mpr hφA) ?_
    intro h1
    have h0 : φ s ≠ 0 := by
      intro h0
      rw [h0, map_zero] at h1
      exact zero_ne_one h1
    have hinv : (φ s)⁻¹ ∈ A := by
      rw [← A.valuation_le_one_iff, map_inv₀, h1, inv_one]
    exact hslm (hAw2 sl _ hinv (by rw [← hgerm]; exact mul_inv_cancel₀ h0))
  by_contra hn
  have hu := IsLocalRing.notMem_maximalIdeal.mp hn
  obtain ⟨b, hb⟩ := hu.exists_right_inv
  have hb' : wcNsrEbRho F h r * (b : F.residueField ζ) = 1 := congrArg Subtype.val hb
  obtain ⟨s₂, hs₂A, hs₂⟩ := (hV b).mp b.2
  rw [hρ, ← hs₂, ← map_mul] at hb'
  have hm : s * s₂ - 1 ∈ IsLocalRing.maximalIdeal (N.presheaf.stalk (j ζ)) :=
    (hker _).mp (by rw [map_sub, hb', map_one, sub_self])
  have h2 := hK2 _ hm
  have h1 : A.valuation (φ (s * s₂)) < 1 := by
    rw [map_mul, map_mul]
    exact mul_lt_one_of_lt_of_le hlt ((A.valuation_le_one_iff _).mpr hs₂A)
  have e3 : (1 : C.functionField) = φ (s * s₂) - φ (s * s₂ - 1) := by
    rw [map_sub, map_one]
    ring
  have h3 := A.valuation.map_sub (φ (s * s₂)) (φ (s * s₂ - 1))
  rw [← e3, Valuation.map_one] at h3
  exact absurd (lt_of_le_of_lt h3 (max_lt h1 h2)) (lt_irrefl 1)

theorem wcpa_dj_lr1k_nsr_eb_strict_pair : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
