  have hξ₁ne : ξ₁ ≠ y' := fun h => hζ₁ne (by rw [← hξ₁, ← hy', h])
  have hξ₂ne : ξ₂ ≠ y' := fun h => hζ₂ne (by rw [← hξ₂, ← hy', h])
  have hξ₁₂ : ξ₁ ≠ ξ₂ := fun h => hζ₁₂ (by rw [← hξ₁, ← hξ₂, h])

  have hdim1 : ∀ (F : Scheme.{u}) (y ξ : ↥F),
      ringKrullDim (F.presheaf.stalk y) ≤ ((1 : ℕ) : WithBot ℕ∞) →
      ξ ⤳ y → ξ ≠ y → closure ({ξ} : Set ↥F) ∈ irreducibleComponents ↥F := by
    intro F y ξ hdim hξy hne
    obtain ⟨E, hE, hsub⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible _
      (isIrreducible_singleton (x := ξ)).closure
    have hEcl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
    have hEirr : IsIrreducible E := hE.prop
    obtain ⟨η, hgE⟩ := QuasiSober.sober hEirr hEcl
    have hηξ : η ⤳ ξ := hgE.specializes (hsub (subset_closure rfl))
    by_cases hηeq : η = ξ
    · subst hηeq
      rw [hgE.def]
      exact hE
    · exfalso
      have hemb := IsPreimmersion.isEmbedding (F.fromSpecStalk y)
      have hrange := Scheme.range_fromSpecStalk (x := y)
      obtain ⟨pa, hpa⟩ : η ∈ Set.range (F.fromSpecStalk y) := by
        rw [hrange]; exact hηξ.trans hξy
      obtain ⟨pb, hpb⟩ : ξ ∈ Set.range (F.fromSpecStalk y) := by rw [hrange]; exact hξy
      have hpc := Scheme.fromSpecStalk_closedPoint (x := y)
      have hab : pa ⤳ pb := hemb.isInducing.specializes_iff.mp (by rw [hpa, hpb]; exact hηξ)
      have hbc : pb ⤳ IsLocalRing.closedPoint (F.presheaf.stalk y) :=
        hemb.isInducing.specializes_iff.mp (by rw [hpb, hpc]; exact hξy)
      have hab' : pa ≠ pb := fun h => hηeq (by rw [← hpa, ← hpb, h])
      have hbc' : pb ≠ IsLocalRing.closedPoint (F.presheaf.stalk y) :=
        fun h => hne (by rw [← hpb, h]; exact hpc)
      let pa' : PrimeSpectrum (F.presheaf.stalk y) := pa
      let pb' : PrimeSpectrum (F.presheaf.stalk y) := pb
      let pc' : PrimeSpectrum (F.presheaf.stalk y) := IsLocalRing.closedPoint (F.presheaf.stalk y)
      have lt1 : pa' < pb' :=
        lt_of_le_of_ne ((PrimeSpectrum.le_iff_specializes pa' pb').mpr hab) hab'
      have lt2 : pb' < pc' :=
        lt_of_le_of_ne ((PrimeSpectrum.le_iff_specializes pb' pc').mpr hbc) hbc'
      let s : LTSeries (PrimeSpectrum (F.presheaf.stalk y)) :=
        ⟨2, ![pa', pb', pc'], fun i => by
          fin_cases i <;> first | exact lt1 | exact lt2 | simpa using lt1 | simpa using lt2⟩
      have h2 := Order.LTSeries.length_le_krullDim s
      have h3 : ((2 : ℕ) : WithBot ℕ∞) ≤ ((1 : ℕ) : WithBot ℕ∞) := le_trans h2 hdim
      norm_cast at h3
  have hdimy := wcpa_dj_lr1k_gn_fibre_dim_le Ω W hW hWt C γ hcov X₁ (r₁ ≫ uX) ι₁ hM₁ y'
  have hC₁ := hdim1 _ y' ξ₁ hdimy hξ₁y hξ₁ne
  have hC₂ := hdim1 _ y' ξ₂ hdimy hξ₂y hξ₂ne

  have he' : wcNdPt W (γ ≫ ι₁) (r₁ ≫ uX) y' = t.1 := hy'
  have hy'x : r₁ (wcpaDjLkImg W (γ ≫ ι₁) (r₁ ≫ uX) y') = wcpaDjLkImg W (γ ≫ ι) uX y₀ := by
    rw [himg, he']; exact hT t.1 t.2
  have hy'ns : ¬ wcpaDjLkSmAt W (r₁ ≫ uX) (wcpaDjLkPi W (γ ≫ ι₁) (r₁ ≫ uX) y') := by
    intro hs
    apply ht
    refine ⟨wcpaDjLkPi W (γ ≫ ι₁) (r₁ ≫ uX) y', ?_, hs⟩
    show wcpaDjLkImg W (γ ≫ ι₁) (r₁ ≫ uX) y' = _
    rw [himg, he']

  obtain ⟨-, ξs, -, hCs, -, hξsy, -, hξsx⟩ := wcpa_dj_lr1k_llnc_node_lifts Ω W hW hWt C γ hcov
    X uX ι hM y₀ hSm σ a ⟨hσ, hσx, ha0, ham⟩ X₁ r₁ ι₁ hbl hι hM₁ V hV hiso y' hy'x hy'ns
  have hξix : ∀ (ξ : ↥(wcpaDjLkFib W (γ ≫ ι₁) (r₁ ≫ uX))) (ζ : ↥(γ ≫ ι₁).normalization),
      wcNdPt W (γ ≫ ι₁) (r₁ ≫ uX) ξ = ζ →
      wcUePi γ ι ι₁ r₁ hι ζ = wcNdPt W (γ ≫ ι) uX y₀ →
      r₁ (wcpaDjLkImg W (γ ≫ ι₁) (r₁ ≫ uX) ξ) = wcpaDjLkImg W (γ ≫ ι) uX y₀ := by
    intro ξ ζ hξ hζ
    rw [himg, hξ]; exact hT ζ hζ
  have hξ₁s : ξ₁ ≠ ξs := fun h => hξsx (by rw [← h]; exact hξix ξ₁ ζ₁ hξ₁ hζ₁)
  have hξ₂s : ξ₂ ≠ ξs := fun h => hξsx (by rw [← h]; exact hξix ξ₂ ζ₂ hξ₂ hζ₂)

  have hcl_inj : ∀ p q : ↥(wcpaDjLkFib W (γ ≫ ι₁) (r₁ ≫ uX)),
      closure ({p} : Set ↥(wcpaDjLkFib W (γ ≫ ι₁) (r₁ ≫ uX))) = closure {q} → p = q :=
    fun p q h => (inseparable_iff_closure_eq.mpr h).eq
  let E : Fin 3 → Set ↥(wcpaDjLkFib W (γ ≫ ι₁) (r₁ ≫ uX)) :=
    ![closure {ξ₁}, closure {ξ₂}, closure {ξs}]
  have hEinj : Function.Injective E := by
    intro i j h
    fin_cases i <;> fin_cases j
    all_goals first
      | rfl
      | exact absurd (hcl_inj _ _ h) hξ₁₂
      | exact absurd (hcl_inj _ _ h).symm hξ₁₂
      | exact absurd (hcl_inj _ _ h) hξ₁s
      | exact absurd (hcl_inj _ _ h).symm hξ₁s
      | exact absurd (hcl_inj _ _ h) hξ₂s
      | exact absurd (hcl_inj _ _ h).symm hξ₂s
  have hEcomp : ∀ i, E i ∈ irreducibleComponents ↥(wcpaDjLkFib W (γ ≫ ι₁) (r₁ ≫ uX)) := by
    intro i
    fin_cases i
    · exact hC₁
    · exact hC₂
    · exact hCs
  have hEmem : ∀ i, y' ∈ E i := by
    intro i
    fin_cases i
    · exact specializes_iff_mem_closure.mp hξ₁y
    · exact specializes_iff_mem_closure.mp hξ₂y
    · exact specializes_iff_mem_closure.mp hξsy
  obtain ⟨P, hPinj, hPmin⟩ :=
    wcpa_dj_lr1k_ll_db_components_minimal_primes _ y' 3 E hEinj hEcomp hEmem
  obtain ⟨hred, hnoeth⟩ :=
    wcpa_dj_lr1k_ll_db_fib_stalks Ω W hW hWt C γ hcov X₁ (r₁ ≫ uX) ι₁ hM₁ y'
  haveI := hred
  haveI := hnoeth
  obtain ⟨hδ, hbr⟩ := wcpa_dj_lr1k_ll_db_two_minimal_primes _ 3 P hPinj hPmin (by norm_num)
  have hBad : wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι₁) (r₁ ≫ uX)).presheaf.stalk y') := by
    unfold wcpaDjLkBad
    rintro (h | ⟨-, h⟩)
    · exact hδ h
    · rw [h] at hbr
      norm_num at hbr
  exact hy'ns (hExh X₁ r₁ ι₁ hbl hι hM₁ V hV hiso y' hBad hy'x)

theorem wcpa_dj_lr1k_nsr_nlb_ue_remove_unibranch : ∀ (T : Type u) [TopologicalSpace T],
    PreconnectedSpace T → (irreducibleComponents T).Finite → ∀ S : Set T, IsClosed S →
    (∀ s ∈ S, ∃! Z, Z ∈ irreducibleComponents T ∧ s ∈ Z) → IsPreconnected Sᶜ :=
by
  intro T _ hT hfin S hS hu
  classical
  have : Finite ↥(irreducibleComponents T) := hfin.to_subtype
  have chain : ∀ Z Z' : ↥(irreducibleComponents T), Relation.ReflTransGen
      (fun i j : ↥(irreducibleComponents T) => ((i : Set T) ∩ (j : Set T)).Nonempty) Z Z' := by
    intro Z Z'
    by_contra hZ'
    let R : Set ↥(irreducibleComponents T) := {i | Relation.ReflTransGen
      (fun i j : ↥(irreducibleComponents T) => ((i : Set T) ∩ (j : Set T)).Nonempty) Z i}
    have hA : IsClosed (⋃ i ∈ R, (i : Set T)) := (Set.toFinite R).isClosed_biUnion
      (fun i _ => isClosed_of_mem_irreducibleComponents i.1 i.2)
    have hB : IsClosed (⋃ i ∈ Rᶜ, (i : Set T)) := (Set.toFinite Rᶜ).isClosed_biUnion
      (fun i _ => isClosed_of_mem_irreducibleComponents i.1 i.2)
    have hcov : Set.univ ⊆ (⋃ i ∈ R, (i : Set T)) ∪ (⋃ i ∈ Rᶜ, (i : Set T)) := by
      intro x _
      let i₀ : ↥(irreducibleComponents T) :=
        ⟨irreducibleComponent x, irreducibleComponent_mem_irreducibleComponents x⟩
      by_cases h : i₀ ∈ R
      · exact Or.inl (Set.mem_biUnion h (mem_irreducibleComponent (x := x)))
      · exact Or.inr (Set.mem_biUnion (show i₀ ∈ Rᶜ from h) (mem_irreducibleComponent (x := x)))
    have hAne : (Set.univ ∩ (⋃ i ∈ R, (i : Set T))).Nonempty := by
      obtain ⟨x, hx⟩ := Z.2.prop.nonempty
      exact ⟨x, trivial, Set.mem_biUnion (show Z ∈ R from Relation.ReflTransGen.refl) hx⟩
    have hBne : (Set.univ ∩ (⋃ i ∈ Rᶜ, (i : Set T))).Nonempty := by
      obtain ⟨x, hx⟩ := Z'.2.prop.nonempty
      exact ⟨x, trivial, Set.mem_biUnion (show Z' ∈ Rᶜ from hZ') hx⟩
    obtain ⟨x, -, hxA, hxB⟩ :=
      isPreconnected_closed_iff.mp hT.isPreconnected_univ _ _ hA hB hcov hAne hBne
    obtain ⟨i, hiR, hxi⟩ := Set.mem_iUnion₂.mp hxA
    obtain ⟨j, hjR, hxj⟩ := Set.mem_iUnion₂.mp hxB
    exact hjR (Relation.ReflTransGen.tail hiR ⟨x, hxi, hxj⟩)
  have slice : ∀ i : ↥(irreducibleComponents T), IsPreconnected ((i : Set T) ∩ Sᶜ) := by
    intro i
    have hp : IsPreirreducible ((i : Set T) ∩ Sᶜ) := by
      intro u v hu' hv' hiu hiv
      obtain ⟨x, hx, hxuv⟩ := i.2.prop.isPreirreducible (Sᶜ ∩ u) (Sᶜ ∩ v)
        (hS.isOpen_compl.inter hu') (hS.isOpen_compl.inter hv')
        (by obtain ⟨x, ⟨h1, h2⟩, h3⟩ := hiu; exact ⟨x, h1, h2, h3⟩)
