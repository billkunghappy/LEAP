  have GC : ∀ (X T : Scheme.{u}) (I : X.IdealSheafData) (h : T ⟶ X), wcCsdInvPull I h → ∀ (U : X.affineOpens) (n : ℕ) (b : Fin n → Γ(X, U.1)), Ideal.span (Set.range b) = I.ideal U → ∀ t : T, h t ∈ U.1 → ∃ j : Fin n, wcCsdChartAt I h U (b j) t := by
    intro X T I h hP U n b hb t hU
    classical

    have LC : ∀ (U' : X.Opens) (V : T.Opens) (hV : IsAffineOpen V) (e : V ≤ h ⁻¹ᵁ U')
