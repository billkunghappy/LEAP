    rw [← Ideal.comap_comap, hcomapw, h𝔮Q]
  have hιwF : ((algebraMap B (Localization.Away w)).comp ι)
      (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
        (algebraMap A ↥(Algebra.adjoin A {s}) z0)) =
