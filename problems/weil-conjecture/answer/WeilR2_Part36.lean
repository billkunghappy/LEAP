    rw [← map_mul, Ideal.Quotient.eq]
    exact Ideal.subset_span rfl
  let θ₀ : MvPolynomial (Fin 1) ↥W →+* MvPolynomial (Fin 2) ↥W ⧸ I :=
    MvPolynomial.eval₂Hom ((Ideal.Quotient.mk I).comp MvPolynomial.C)
