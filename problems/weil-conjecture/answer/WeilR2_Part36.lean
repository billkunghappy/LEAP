      wcLr1uDom (wcLr1uGerm (γ ≫ ι₁).toNormalization (wcNdPt W (γ ≫ ι₁) (r₁ ≫ uX) ζ) hζ).hom
        (μ : Set C.functionField) →
      B' ≤ μ' →
      wcLr1uDom (wcLr1uGerm (γ ≫ ι₁).toNormalization (wcNdPt W (γ ≫ ι₁) (r₁ ≫ uX) ζ) hζ).hom
        (μ' : Set C.functionField) →
      (∀ g, g ∈ U ↔ ∃ s, (wcLr1uGerm (γ ≫ ι₁).toNormalization
          (wcNdPt W (γ ≫ ι₁) (r₁ ≫ uX) ζ) hζ).hom s ∈ B ∧
        ((γ ≫ ι₁).normalization.residue (wcNdPt W (γ ≫ ι₁) (r₁ ≫ uX) ζ) ≫
          (Limits.pullback.fst ((γ ≫ ι₁).fromNormalization ≫ r₁ ≫ uX)
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).residueFieldMap
            ζ).hom s = g) →
      (∀ g, g ∈ U' ↔ ∃ s, (wcLr1uGerm (γ ≫ ι₁).toNormalization
          (wcNdPt W (γ ≫ ι₁) (r₁ ≫ uX) ζ) hζ).hom s ∈ B' ∧
        ((γ ≫ ι₁).normalization.residue (wcNdPt W (γ ≫ ι₁) (r₁ ≫ uX) ζ) ≫
          (Limits.pullback.fst ((γ ≫ ι₁).fromNormalization ≫ r₁ ≫ uX)
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).residueFieldMap
            ζ).hom s = g) →
