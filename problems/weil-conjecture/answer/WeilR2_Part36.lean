    have e2 := Scheme.Hom.germ_stalkMap (γ ≫ ι₁) ⊤ (genericPoint ↥C) (Set.mem_univ _)
    rw [e1, e2, Scheme.ΓSpecIso_inv_naturality_assoc]
    have h1 : (r₁ ≫ uX).appTop ≫ (γ ≫ ι₁).app ⊤ = ((γ ≫ ι₁) ≫ (r₁ ≫ uX)).appTop :=
