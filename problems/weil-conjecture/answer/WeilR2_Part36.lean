  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M _ _ _ _ _ _ 𝔭 t hPD c b hc hbm hb0 Q hQ hQc
  obtain ⟨P, hPmin, hPQ, hz0⟩ :=
    wcpa_dj_llsm_fcbu_strict_branch Ω W hW hWt A K M 𝔭 t hPD c b hc hbm hb0 Q hQ hQc
  refine ⟨P, hPmin, hPQ, ?_⟩
  have hu0 : algebraMap A K (t - algebraMap ↥W A c) ≠ 0 := by
    intro h0
    apply hz0
    have e : algebraMap ↥(Algebra.adjoin A
        {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})
        ↥(integralClosure ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M)
        (algebraMap A ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})
          (t - algebraMap ↥W A c)) = 0 := by
      apply Subtype.ext
      show algebraMap K M (algebraMap A K (t - algebraMap ↥W A c)) = 0
      rw [h0, map_zero]
    exact e ▸ P.zero_mem
  have hJ : algebraMap ↥(Algebra.adjoin A
        {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})
        ↥(integralClosure ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M)
        (algebraMap A ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})
          (t - algebraMap ↥W A c)) *
      algebraMap ↥(Algebra.adjoin A
        {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})
        ↥(integralClosure ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M)
        ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c),
          Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∈ P := by
    apply hPmin.1.2
    apply Ideal.subset_span
    refine ⟨b, hbm, ?_⟩
    show algebraMap K M (algebraMap A K (t - algebraMap ↥W A c)) *
        algebraMap K M (algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)) =
      algebraMap K M (algebraMap A K (algebraMap ↥W A b))
    rw [← map_mul, mul_div_cancel₀ _ hu0]
  exact (hPmin.1.1.mem_or_mem hJ).resolve_left hz0

theorem wcpa_dj_llsm_smpcgbti_disc_radii : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (b x β : ↥W) (R : List ↥W), b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    x ∈ IsLocalRing.maximalIdeal ↥W → β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 →
    (∀ r ∈ R, r ∈ IsLocalRing.maximalIdeal ↥W) →
    b ∣ (R.map (fun r => x - r)).prod →
    ¬ b ∣ (R.map (fun r => @ite _ (β ∣ x - r) (Classical.propDecidable _) β (x - r))).prod →
    ∃ γ : ↥W, γ ∈ IsLocalRing.maximalIdeal ↥W ∧ γ ≠ 0 ∧
      b ∣ (R.map (fun r => @ite _ (γ ∣ x - r) (Classical.propDecidable _) γ (x - r))).prod ∧
      (R.map (fun r => @ite _ (γ ∣ x - r) (Classical.propDecidable _) γ (x - r))).prod ∣ b ∧
      ¬ γ ∣ β ∧ ∃ r ∈ R, γ ∣ x - r :=
