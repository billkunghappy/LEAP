theorem wcpa_dj_llsm_smcu_kaehler_ne_zero : ∀ (W A' F : Type u) [CommRing W] [CommRing A'] [Algebra W A'] [Field F] (ρ : A' →+* F) (q : Ideal A') [q.IsPrime], (∀ a : A', ρ a = 0 ↔ a ∈ q) → ∀ D : A' →+ F, (∀ x y : A', D (x * y) = ρ x * D y + ρ y * D x) → (∀ w : W, D (algebraMap W A' w) = 0) → ∀ a : A', D a ≠ 0 → (1 : q.ResidueField) ⊗ₜ[A'] KaehlerDifferential.D W A' a ≠ 0 :=
