    obtain ⟨hUf, hUfeq⟩ := wcpa_dj_lr1k_nsr_gcn_stalk_factor (.of ↥W) U.toScheme σU T
      hker (Limits.pullback.snd rb U.ι ρ) hρ2 (U.ι ⁻¹ᵁ V) ((U.ι.app V).hom g) hprV hσgU
    have hfac : ((Limits.pullback rb U.ι).presheaf.germ ((Limits.pullback.fst rb U.ι ≫ rb) ⁻¹ᵁ V)
          ρ hρV).hom (((Limits.pullback.fst rb U.ι ≫ rb).app V).hom g) =
