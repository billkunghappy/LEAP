  rw [hz, mul_assoc] at hprod
  have hzF : z * (R.map f).prod = 1 := by
    have h0 : ϖ ^ (p.natDegree * M) ≠ 0 := pow_ne_zero _ hϖ
    exact mul_left_cancel₀ h0 (hprod.trans (mul_one _).symm)
  have hFu : IsUnit (R.map f).prod := isUnit_iff_exists_inv.mpr ⟨z, by rw [mul_comm]; exact hzF⟩
  have hR0 : R ≠ 0 := by
