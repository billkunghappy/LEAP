theorem wcpa_dj_llsm_smpcgbtige_taylor_alg : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] (𝔮 : Ideal B) (t' : B), wcLlsPD W B 𝔮 (.disc t') → ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → ∀ J : ℕ, 1 ≤ J → ∀ a : B, ∃ (P : Polynomial ↥W) (S E : B), S ∉ 𝔮 ∧ S * (a - P.eval₂ (algebraMap ↥W B) (t' - algebraMap ↥W B x)) = (t' - algebraMap ↥W B x) ^ J * E :=
