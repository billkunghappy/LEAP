    have hwu : IsUnit w := isUnit_iff_exists_inv.mpr ⟨s, hws⟩
    refine ⟨w - n * e, ?_, ?_⟩
    · by_contra hu
      have h1 : w - n * e ∈ IsLocalRing.maximalIdeal ↥W := hmem _ hu
      have h2 : n * e ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right e _ hnm
