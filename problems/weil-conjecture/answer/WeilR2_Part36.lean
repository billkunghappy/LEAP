        rw [TopCat.Presheaf.stalkSpecializes_comp_apply, Scheme.Hom.stalkMap_comp]
        erw [CommRingCat.hom_comp, RingHom.comp_apply, star _ h' c]
        exact Scheme.Hom.germ_stalkMap_apply _ ⊤ _ trivial _
      obtain ⟨k, hk⟩ := hs2 f
      obtain ⟨k', hk'⟩ := hspecsurj _ _ hspec hηN k
      have hfj : j k' = f := by
        show (((ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)) ≫ N.fromSpecStalk n).stalkMap
            (genericPoint R)).hom ((N.presheaf.stalkSpecializes hspec).hom k') = f
        rw [hk', hk]
      obtain ⟨P, hPm, hPe⟩ := hf
      have hjψ : j.comp (algebraMap _ N.functionField) =
          ((R.presheaf.germ ⊤ (genericPoint ↥R) trivial).hom.comp
            ((ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)).appTop.hom.comp
              (Scheme.ΓSpecIso (.of ↥(N.presheaf.stalk n))).inv.hom)) := RingHom.ext hcomp
      have hint' : _root_.IsIntegral (N.presheaf.stalk n) k' := by
        refine ⟨P, hPm, ?_⟩
        apply hjinj
        rw [map_zero, Polynomial.hom_eval₂, hjψ, hfj]
        exact hPe
      obtain ⟨a, ha⟩ := (IsIntegrallyClosed.isIntegral_iff (K := N.functionField)).mp hint'
      exact ⟨a, by rw [← hcomp, ha, hfj]⟩
    · intro r hr
      have e : ((ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) ≫ p) r =
          ((ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)) ≫ N.fromSpecStalk n) r := by rw [hcond]
      simp only [Scheme.Hom.comp_apply] at e hr ⊢
      rw [e, hr]
      exact Scheme.fromSpecStalk_closedPoint
    · intro y hy
      obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := p)
        (g := N.fromSpecStalk n) y (IsLocalRing.closedPoint _)
        (by rw [hy, Scheme.fromSpecStalk_closedPoint])
      obtain ⟨r, hr⟩ : z ∈ Set.range ρ := by rw [hρr]; trivial
      exact ⟨r, by rw [Scheme.Hom.comp_apply, hr, hz1], by rw [Scheme.Hom.comp_apply, hr, hz2]⟩

  intro Ω _ _ W C _ γ X uX ι _ _ y₀ τ hH σ a _hP X₁ r₁ ι₁ _ _ hι _hbl hM₁
  obtain ⟨hW, hWt, hcov, -, hM, -⟩ := hH
  obtain ⟨hss₁, hproj₁, hpb₁⟩ := hM₁
  haveI : IsProper (r₁ ≫ uX) := hss₁.2.1
  haveI : IsProper uX := hM.1.2.1
  haveI : IsProper r₁ := IsProper.of_comp r₁ uX
  haveI : IsFinite γ := hcov.2.2.2.1
  haveI : IsFinite (γ ≫ ι₁).fromNormalization :=
    wcpa_dj_lr1s_normalization_finite Ω W hW hWt C (γ ≫ wcProjKStr Ω 1) γ hcov.1 hcov.2.1
      hcov.2.2.1 hcov.2.2.2.1 rfl hcov.2.2.2.2 X₁ (r₁ ≫ uX) ι₁ hss₁ hproj₁ hpb₁
  have hπ : wcUePi γ ι ι₁ r₁ hι ≫ (γ ≫ ι).fromNormalization =
      (γ ≫ ι₁).fromNormalization ≫ r₁ := by
    unfold wcUePi
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc,
      Scheme.Hom.normalizationDesc_comp]
  haveI : IsProper (wcUePi γ ι ι₁ r₁ hι ≫ (γ ≫ ι).fromNormalization) := by
    rw [hπ]; infer_instance
  haveI hπP : IsProper (wcUePi γ ι ι₁ r₁ hι) :=
    IsProper.of_comp (wcUePi γ ι ι₁ r₁ hι) (γ ≫ ι).fromNormalization
  have htri : (γ ≫ ι₁).toNormalization ≫ wcUePi γ ι ι₁ r₁ hι = (γ ≫ ι).toNormalization := by
    unfold wcUePi
    rw [← Category.assoc, Scheme.Hom.toNormalization_normalizationDesc, Limits.pullback.lift_fst]
  haveI : IsOpenImmersion (γ ≫ ι).toNormalization :=
    (wcpa_dj_ms_generic_fibre Ω W hW C _ (γ ≫ wcProjKStr Ω 1) _ _ hcov.2.1
      (wcpa_dj_lr1s_normalization_generic_fibre Ω W C _ γ X uX ι hcov.2.2.2.1 rfl hM.2.2)).2.1
  haveI : IsOpenImmersion (γ ≫ ι₁).toNormalization :=
    (wcpa_dj_ms_generic_fibre Ω W hW C _ (γ ≫ wcProjKStr Ω 1) _ _ hcov.2.1
      (wcpa_dj_lr1s_normalization_generic_fibre Ω W C _ γ X₁ (r₁ ≫ uX) ι₁ hcov.2.2.2.1 rfl
        hpb₁)).2.1
  obtain ⟨hgen, hiso⟩ := s3 C _ _ (γ ≫ ι₁).toNormalization (γ ≫ ι).toNormalization
    (wcUePi γ ι ι₁ r₁ hι) htri
  obtain ⟨-, hic⟩ := wcpa_dj_lr1k_ebnb_norm_stalk_normal Ω W hW hWt C γ hcov X uX ι hM
    (wcNdPt W (γ ≫ ι) uX y₀)
  obtain ⟨R, hR, g, q, hgP, hint, hf1, hf2⟩ := s2 _ _ (wcUePi γ ι ι₁ r₁ hι) hgen hiso
    (wcNdPt W (γ ≫ ι) uX y₀) hic
  haveI := hR
  haveI := hgP
  have hpc := s1 _ R g hint
  have hT : ⇑(wcUePi γ ι ι₁ r₁ hι) ⁻¹' {wcNdPt W (γ ≫ ι) uX y₀} =
      ⇑q '' (⇑g ⁻¹' {IsLocalRing.closedPoint ↥((γ ≫ ι).normalization.presheaf.stalk
        (wcNdPt W (γ ≫ ι) uX y₀))}) := by
    ext y
    constructor
    · intro hy
      obtain ⟨r, hr1, hr2⟩ := hf2 y hy
      exact ⟨r, hr2, hr1⟩
    · rintro ⟨r, hr, rfl⟩
      exact hf1 r hr
  refine ⟨?_, s5 _ _ (wcUePi γ ι ι₁ r₁ hι) (wcNdPt W (γ ≫ ι) uX y₀)⟩
  rw [← isPreconnected_iff_preconnectedSpace, hT]
  exact hpc.image q q.continuous.continuousOn

theorem wcpa_dj_lsp_scd_dominating_valuation : ∀ (C : Scheme.{u}) (ξ x : C) (h : ξ ⤳ x),
    ∃ V : ValuationSubring (C.residueField ξ), ∀ s : C.presheaf.stalk x,
      ∃ hs : (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom s ∈ V,
        s ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x) →
          (⟨(C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom s, hs⟩ : V) ∈
            IsLocalRing.maximalIdeal V :=
by
  intro C ξ x h
  obtain ⟨A, hA, hloc⟩ :=
    IsLocalRing.exists_factor_valuationRing (C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom
  refine ⟨A, fun s => ⟨hA s, fun hm => ?_⟩⟩
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  intro hu
  apply mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal s).mp hm)
  obtain ⟨w, hw⟩ := hu.exists_right_inv
  have hu' : IsUnit (((C.presheaf.stalkSpecializes h ≫ C.residue ξ).hom.codRestrict
      A.toSubring hA) s) := by
    refine IsUnit.of_mul_eq_one (⟨(w : C.residueField ξ), w.2⟩ : A.toSubring) ?_
    apply Subtype.ext
    exact congrArg Subtype.val hw
  exact isUnit_of_map_unit _ s hu'

theorem wcpa_dj_lr1k_nsr_eb_exc_witness : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1),
      wcpaDjLkCov Ω γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)],
    wcpaDjLkModel W uX ι →
    ∀ y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX),
      wcpaDjLkSmAt W uX (wcpaDjLkPi W (γ ≫ ι) uX y₀) →
