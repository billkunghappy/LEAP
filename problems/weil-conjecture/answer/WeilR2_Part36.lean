  have hx'eq : U.ι (ΔU (IsLocalRing.closedPoint ↥W)) = σ₀ (IsLocalRing.closedPoint ↥W) := by
    rw [← hΔι]; rfl
  have hσU : σ₀ (IsLocalRing.closedPoint ↥W) ∈ U := by
    have h0 : U.ι (ΔU (IsLocalRing.closedPoint ↥W)) ∈ Set.range U.ι := ⟨_, rfl⟩
