    ((Zf i).filter (fun x => @decide (¬ b ∣ x) (Classical.propDecidable _)))
    ((Yf i).filter (fun x => @decide (¬ b ∣ x) (Classical.propDecidable _)))
    ((Zf i).filter (fun x => @decide (b ∣ x) (Classical.propDecidable _)))
    ((Yf i).filter (fun x => @decide (b ∣ x) (Classical.propDecidable _)))
    List.filter_sublist List.filter_sublist List.filter_sublist List.filter_sublist
