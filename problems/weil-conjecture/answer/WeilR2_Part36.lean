    constructor
    · intro hy
      by_contra hn
      exact hPDB.2.2.2.1.ne_top (Ideal.eq_top_of_isUnit_mem _ hy ((hunit y hn).map _))
    · intro hy
      exact hPDB.2.2.2.2.1 (Ideal.mem_map_of_mem _ hy)
  have hmem : ∀ α : ↥W, x + γ * α ∈ IsLocalRing.maximalIdeal ↥W := fun α =>
    Ideal.add_mem _ hxm (Ideal.mul_mem_right α _ hγm)
  have hg0 : algebraMap B M (algebraMap ↥W B γ) ≠ 0 := by
    intro h
    apply hγ0
    apply hwBinj
    apply hιinj
    rw [h, map_zero, map_zero]
  have h𝔮prime : 𝔮.IsPrime := hPDB.2.2.2.1.isPrime

  have hpts : ∀ (a : ℕ → B) (n : ℕ), ∑ k ∈ Finset.range (n + 1),
      a k * algebraMap ↥W B γ ^ (n - k) * (t' - algebraMap ↥W B x) ^ k = 0 →
