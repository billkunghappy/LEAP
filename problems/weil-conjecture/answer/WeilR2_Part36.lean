    (hrep i).2.2.2.1, fun z hz => hside _ (hmemZ i z hz), (hrep i).2.2.2.2, ?_⟩
  dsimp only
  exact hclose (k1 i) (k2 i) _ _ ρ β b _ _ (hprod (Zf i) (k1 i) (hrep i).1)
    (hprod (Yf i) (k2 i) (hrep i).2.1) hβ0 hρ0 hb0 hρβ hbρ hd hi

theorem wcLlsASmc_factored_reduced_form : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
