    haveI hRint : AlgebraicGeometry.IsIntegral R := isIntegral_of_irreducibleSpace_of_isReduced R
    have hηR : genericPoint R = r₀ := (genericPoint_spec R).eq hgp
    have hcond : (ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) ≫ p =
        (ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)) ≫ N.fromSpecStalk n := by
      simp only [Category.assoc, Limits.pullback.condition]
    refine ⟨R, hRint, ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n),
      ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n), inferInstance, ?_, ?_, ?_⟩
    · intro f hf

      have hisoY : ∀ y : Y, y = genericPoint Y → IsIso (p.stalkMap y) := by
        rintro y rfl; exact hiso
      have hηq : (ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) (genericPoint R) = genericPoint Y := by
        rw [hηR, hqr₀]
      have hs2 : ∀ x : R.presheaf.stalk (genericPoint R),
          ∃ k, (((ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)) ≫ N.fromSpecStalk n).stalkMap
            (genericPoint R)).hom k = x := by
        intro x
        obtain ⟨y, hy⟩ := Scheme.Hom.stalkMap_surjective
          (ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) (genericPoint R) x
        haveI := hisoY _ hηq
        obtain ⟨w, hw⟩ := (ConcreteCategory.bijective_of_isIso
          (p.stalkMap ((ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) (genericPoint R)))).2 y
        have e1 := Scheme.Hom.stalkMap_congr_hom _ _ hcond (genericPoint R)
        rw [Scheme.Hom.stalkMap_comp] at e1
        have e3 := congrArg (fun φ => CommRingCat.Hom.hom φ w) e1
        simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e3
        refine ⟨_, e3.symm.trans ?_⟩
        erw [hw]
