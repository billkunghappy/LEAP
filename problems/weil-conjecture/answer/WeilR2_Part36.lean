      rw [Scheme.range_fromSpecStalk]; exact (genericPoint_spec N).specializes trivial
    have hηY : genericPoint Y ∈ Set.range (Limits.pullback.fst p (N.fromSpecStalk n)) := by
      rw [Scheme.Pullback.range_fst, Set.mem_preimage, hgen]; exact hηn
    obtain ⟨z₀, hz₀⟩ := hηY
    obtain ⟨r₀, hr₀⟩ : z₀ ∈ Set.range ρ := by rw [hρr]; trivial
    have hqr₀ : (ρ ≫ Limits.pullback.fst p (N.fromSpecStalk n)) r₀ = genericPoint Y := by
