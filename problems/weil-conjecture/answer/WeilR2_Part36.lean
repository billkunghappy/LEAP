  let e := RingEquiv.ofBijective (algebraMap Ω D) hbij
  let P : C →+* Ω := e.symm.toRingHom.comp (algebraMap C D)
  have hPinj : Function.Injective P := e.symm.injective.comp hinj
  have hPW : ∀ w : ↥W, P (algebraMap (↥W) C w) = (w : Ω) := by
    intro w
