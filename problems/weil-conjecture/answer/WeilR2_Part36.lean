theorem wcpa_dj_lr1k_nsr_gub_it_rigid_const : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (sC : C ⟶ Spec (.of Ω))
    (V : ValuationSubring C.functionField), wcUbRigid W sC V →
    (∀ w : ↥W, wcLr1uConst sC (w : Ω) ∈ V) ∧
    (∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → V.valuation (wcLr1uConst sC (w : Ω)) < 1) :=
by
  intro Ω _ W C _ sC V hV
  obtain ⟨P, -, hP⟩ := hV
  have key : ∀ a : Ω,
      (C.presheaf.stalkSpecializes (genericPoint_specializes P)).hom
        (((Scheme.ΓSpecIso (.of Ω)).inv ≫ sC.appTop ≫ C.presheaf.germ ⊤ P trivial).hom a) =
      wcLr1uConst sC a := by
    intro a
    have e := congrArg (fun φ => φ.hom a)
      (congrArg (fun ψ => (Scheme.ΓSpecIso (.of Ω)).inv ≫ sC.appTop ≫ ψ)
        (TopCat.Presheaf.germ_stalkSpecializes C.presheaf (U := ⊤) (y := P) (hy := trivial)
          (h := genericPoint_specializes P)))
    exact e
  have hinj : Function.Injective
      (C.presheaf.stalkSpecializes (genericPoint_specializes P)).hom :=
    IsFractionRing.injective (C.presheaf.stalk P) C.functionField
  have hA : ∀ w : ↥W, wcLr1uConst sC (w : Ω) ∈ V := by
    intro w
    refine (hP _).mpr ⟨((Scheme.ΓSpecIso (.of Ω)).inv ≫ sC.appTop ≫
      C.presheaf.germ ⊤ P trivial).hom (w : Ω), w, key _, ?_⟩
    rw [sub_self]
    exact Ideal.zero_mem _
  refine ⟨hA, ?_⟩
  intro w hw
  refine (ValuationSubring.valuation_lt_one_iff V ⟨_, hA w⟩).mp ?_
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  intro hu
  obtain ⟨b, hb⟩ := hu.exists_right_inv
  have hb' : wcLr1uConst sC (w : Ω) * (b : C.functionField) = 1 := by
    have := congrArg Subtype.val hb
    exact this
  obtain ⟨g, c, hg, hgc⟩ := (hP b).mp b.2
  have h1 : g * ((Scheme.ΓSpecIso (.of Ω)).inv ≫ sC.appTop ≫
      C.presheaf.germ ⊤ P trivial).hom (w : Ω) = 1 := by
    apply hinj
    rw [map_mul, map_one, hg, key, mul_comm]
    exact hb'
  have h2 : ((Scheme.ΓSpecIso (.of Ω)).inv ≫ sC.appTop ≫
      C.presheaf.germ ⊤ P trivial).hom ((1 : Ω) - (w : Ω) * (c : Ω)) ∈
      IsLocalRing.maximalIdeal (C.presheaf.stalk P) := by
    have := Ideal.mul_mem_left _ (((Scheme.ΓSpecIso (.of Ω)).inv ≫ sC.appTop ≫
      C.presheaf.germ ⊤ P trivial).hom (w : Ω)) hgc
    convert this using 1
    rw [map_sub, map_one, map_mul]
    linear_combination (-1 : C.presheaf.stalk P) * h1
  have h3 : (1 : Ω) - (w : Ω) * (c : Ω) = 0 := by
    by_contra hne
    have hu' := (IsUnit.mk0 _ hne).map ((Scheme.ΓSpecIso (.of Ω)).inv ≫ sC.appTop ≫
      C.presheaf.germ ⊤ P trivial).hom
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h2
    exact h2 hu'
  have h4 : w * c = 1 := by
    apply Subtype.ext
    show (w : Ω) * (c : Ω) = 1
    linear_combination (-1 : Ω) * h3
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hw
  exact hw ⟨⟨w, c, h4, by rw [mul_comm]; exact h4⟩, rfl⟩

theorem wcpa_dj_lr1k_nsr_gub_it_box_exists : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1),
      wcpaDjLkCov Ω γ →
    ∀ (X' : Scheme.{u}) (u' : X' ⟶ Spec (.of ↥W)) (ι' : wcProjK Ω 1 ⟶ X')
      [QuasiCompact (γ ≫ ι')] [QuasiSeparated (γ ≫ ι')],
      wcpaDjLkModel W u' ι' →
    ∀ (n : ↥(γ ≫ ι').normalization) (f : Fin 2 → ((γ ≫ ι').normalization).presheaf.stalk n),
      wcTcRad W ((γ ≫ ι').fromNormalization ≫ u') n f →
    ∀ V : ValuationSubring C.functionField, wcUbRigid W (γ ≫ wcProjKStr Ω 1) V →
      wcNsrCentred (γ ≫ ι').toNormalization n V →
      ∃ c : ↥W, c ≠ 0 ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧
