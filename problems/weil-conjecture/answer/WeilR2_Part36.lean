      ((∏ z ∈ Z, u z ^ k' z : (↥(X₁.presheaf.stalk p))ˣ) : ↥(X₁.presheaf.stalk p)) =
      ∏ z ∈ Z, (1 + wcLr1uConst (γ ≫ wcProjKStr Ω 1) ((d z : ↥W) : Ω) *
        (wcLr1uGerm (γ ≫ ι₁) p hy).hom S) ^ (k' z) := by
    rw [key, map_prod, Units.coe_prod]
    refine Finset.prod_congr rfl (fun z hz => ?_)
    rw [map_zpow, Units.val_zpow_eq_zpow_val, ← key, hu z hz, map_add, map_one, map_mul, hG]
  obtain ⟨s, hs⟩ : ∃ s : ↥(X₁.presheaf.stalk p), s = wcNdSig (r₁ ≫ uX) p b *
      ((∏ z ∈ Z, u z ^ k' z : (↥(X₁.presheaf.stalk p))ˣ) : ↥(X₁.presheaf.stalk p)) *
      (S - wcNdSig (r₁ ≫ uX) p w) ^ k := ⟨_, rfl⟩
  have hGs : (wcLr1uGerm (γ ≫ ι₁) p hy).hom s = f := by
    rw [hs, map_mul, map_mul, map_pow, map_sub, hG, hG, hprod]
    exact hfeq.symm
  refine ⟨⟨hy, s, hGs⟩, fun hlt => ⟨hy, s, ?_, hGs⟩⟩
  have hbm' := hκm hpt b (hbm hlt)
  rw [hs]
  exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _ hbm')

theorem wcpa_dj_lr1k_nsr_nlb_ue_K0_finite : ∀ (Ω : Type u) [Field Ω] (C : Scheme.{u})
    [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1),
    wcpaDjLkCov Ω γ → FiniteDimensional (wcUeK0 γ) C.functionField :=
by
  intro Ω _ C _ γ hcov
  classical
  have key : ∀ (R R₁ L : Type u) [CommRing R] [CommRing R₁] [Field L] [Algebra R₁ L]
      [IsFractionRing R₁ L] (φ : R →+* R₁) (K : Subfield L), φ.Finite →
      (∀ r : R, algebraMap R₁ L (φ r) ∈ K) → FiniteDimensional K L := by
    intro R R₁ L _ _ _ _ _ φ K hφ hK
    letI := φ.toAlgebra
    have hfin : Module.Finite R R₁ := hφ
    obtain ⟨S, hS⟩ := hfin.fg_top
    let ψ : R →+* K := ((algebraMap R₁ L).comp φ).codRestrict K hK
    have hint : ∀ b : R₁, IsIntegral K (algebraMap R₁ L b) := by
      intro b
      obtain ⟨p, hpm, hp⟩ := hφ.to_isIntegral b
      refine ⟨p.map ψ, hpm.map ψ, ?_⟩
      have h1 := congrArg (algebraMap R₁ L) hp
      rw [Polynomial.hom_eval₂, map_zero] at h1
      rw [Polynomial.eval₂_map]
      exact h1
    let E := IntermediateField.adjoin K ((S : Set R₁).image (algebraMap R₁ L))
    haveI : FiniteDimensional K E := by
      haveI : Finite ((S : Set R₁).image (algebraMap R₁ L)) :=
        ((S.finite_toSet).image _).to_subtype
      exact IntermediateField.finiteDimensional_adjoin (fun x hx => by
        obtain ⟨b, -, rfl⟩ := hx; exact hint b)
    have hsub : ∀ b : R₁, algebraMap R₁ L b ∈ E := by
      intro b
      have hb : b ∈ Submodule.span R (S : Set R₁) := hS ▸ Submodule.mem_top
      induction hb using Submodule.span_induction with
      | mem x hx => exact IntermediateField.subset_adjoin _ _ ⟨x, hx, rfl⟩
      | zero => rw [map_zero]; exact zero_mem E
      | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
      | smul r x _ hx =>
        rw [Algebra.smul_def, map_mul]
        refine mul_mem ?_ hx
        have : algebraMap R₁ L (algebraMap R R₁ r) = algebraMap K L (ψ r) := rfl
        rw [this]
        exact IntermediateField.algebraMap_mem _ _
    have hall : ∀ z : L, z ∈ E := by
      intro z
      obtain ⟨x, y, -, rfl⟩ := IsFractionRing.div_surjective (A := R₁) z
      exact div_mem (hsub x) (hsub y)
    exact Module.Finite.of_surjective (E.val.toLinearMap) (fun z => ⟨⟨z, hall z⟩, rfl⟩)
  haveI : IsFinite γ := hcov.2.2.2.1
  obtain ⟨U, hUaff, hηU, -⟩ := AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
    (x := γ (genericPoint ↥C)) (U := ⊤) trivial
  have hVaff : IsAffineOpen (γ ⁻¹ᵁ U) := hUaff.preimage γ
  have hηV : genericPoint ↥C ∈ γ ⁻¹ᵁ U := hηU
  haveI : Nonempty (γ ⁻¹ᵁ U : Scheme) := ⟨⟨genericPoint ↥C, hηV⟩⟩
  haveI := functionField_isFractionRing_of_isAffineOpen C (γ ⁻¹ᵁ U) hVaff
  refine key Γ(wcProjK Ω 1, U) Γ(C, γ ⁻¹ᵁ U) C.functionField (γ.app U).hom (wcUeK0 γ)
    (γ.finite_app U hUaff) ?_
  intro r
  show (C.presheaf.germ (γ ⁻¹ᵁ U) (genericPoint ↥C) hηV).hom ((γ.app U).hom r) ∈ wcUeK0 γ
  unfold wcUeK0
  exact Subfield.subset_closure ⟨U, r, hηV, rfl⟩

theorem wcpa_dj_lr1k_nsr_nlb_ue_separating_element : ∀ (L : Type u) [Field L] (K : Subfield L)
    [FiniteDimensional K L] (A A' : ValuationSubring L),
    A.comap K.subtype = A'.comap K.subtype → A ≠ A' →
    ∃ (ε : L) (P Q : Polynomial K),
      P.Monic ∧ Polynomial.aeval ε P = 0 ∧ (∀ i, A.valuation (P.coeff i : L) ≤ 1) ∧
      Q.Monic ∧ Polynomial.aeval (ε * (1 - ε)) Q = 0 ∧
      (∀ i < Q.natDegree, A.valuation (Q.coeff i : L) < 1) ∧
      A.valuation (ε - 1) < 1 ∧ A'.valuation ε < 1 :=
by
  intro L _ K _ A A' hcomap hne
  have hlt_aux : ∀ (V : ValuationSubring L) (x : L), x ≠ 0 →
      (V.valuation x < 1 ↔ x⁻¹ ∉ V) := by
    intro V x hx
    rw [← V.valuation_le_one_iff, not_le, Valuation.one_lt_val_iff _ (inv_ne_zero hx), inv_inv]

  have s2 : ∀ (R : Type u) [CommRing R] [Algebra R L] (t : L), t ≠ 0 →
      ∀ (a : ℕ → R) (n e : ℕ), e ≤ n →
      ∑ i ∈ Finset.range (n+1), algebraMap R L (a i) * t ^ i = 0 →
      _root_.IsIntegral R (∑ i ∈ Finset.Ico (e+1) (n+1), algebraMap R L (a i) * t ^ (i - e)) := by
    intro R _ _ t ht a n e hen hrel
    rcases Nat.eq_zero_or_pos n with hn | hn
    · subst hn
      have he : e = 0 := by omega
      subst he
      simp only [zero_add, Finset.Ico_self, Finset.sum_empty]
      exact isIntegral_zero
    have hwz : ∑ i ∈ Finset.Ico (e+1) (n+1), algebraMap R L (a i) * t ^ (i - e)
        = ∑ i ∈ Finset.Ico (e+1) (n+1), algebraMap R L (a i) * t ^ ((i:ℤ) - e) := by
      refine Finset.sum_congr rfl (fun i hi => ?_)
      have hi' : e ≤ i := by have := Finset.mem_Ico.mp hi; omega
      rw [← zpow_natCast, Nat.cast_sub hi']
    have hrelz : ∑ i ∈ Finset.range (n+1), algebraMap R L (a i) * t ^ ((i:ℤ) - e) = 0 := by
      have : ∑ i ∈ Finset.range (n+1), algebraMap R L (a i) * t ^ ((i:ℤ) - e)
          = (∑ i ∈ Finset.range (n+1), algebraMap R L (a i) * t ^ i) * t ^ (-(e:ℤ)) := by
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [mul_assoc, ← zpow_natCast, ← zpow_add₀ ht, sub_eq_add_neg]
      rw [this, hrel, zero_mul]
    obtain ⟨w, hw⟩ : ∃ w, w = ∑ i ∈ Finset.Ico (e+1) (n+1), algebraMap R L (a i) * t ^ (i - e) :=
      ⟨_, rfl⟩
    rw [← hw]
    rw [hwz] at hw
    have hlow : w = -∑ i ∈ Finset.range (e+1), algebraMap R L (a i) * t ^ ((i:ℤ) - e) := by
      rw [hw, eq_neg_iff_add_eq_zero, add_comm,
        Finset.sum_range_add_sum_Ico _ (by omega : e+1 ≤ n+1)]
      exact hrelz
    let N : Submodule R L :=
      Submodule.span R ((fun k : ℤ => t ^ k) '' Set.Ico (-(e:ℤ)) ((n:ℤ) - e))
    have hmem : ∀ (k : ℤ), -(e:ℤ) ≤ k → k < (n:ℤ) - e → ∀ r : R,
        algebraMap R L r * t ^ k ∈ N := by
      intro k hk1 hk2 r
      rw [← Algebra.smul_def]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, ⟨hk1, hk2⟩, rfl⟩)
    have hfg : N.FG := Submodule.fg_span ((Set.finite_Ico _ _).image _)
    have hne : N ≠ ⊥ := by
      rw [Submodule.ne_bot_iff]
      exact ⟨t ^ (-(e:ℤ)), Submodule.subset_span ⟨-(e:ℤ), ⟨le_refl _, by omega⟩, rfl⟩,
        zpow_ne_zero _ ht⟩
    have hgen : ∀ k : ℤ, -(e:ℤ) ≤ k → k < (n:ℤ) - e → w * t ^ k ∈ N := by
      intro k hk1 hk2
      rcases lt_or_ge k 0 with hk | hk
      · rw [hw, Finset.sum_mul]
        refine Submodule.sum_mem _ (fun i hi => ?_)
        have hi' := Finset.mem_Ico.mp hi
        rw [mul_assoc, ← zpow_add₀ ht]
        exact hmem _ (by omega) (by omega) _
      · rw [hlow, neg_mul, Finset.sum_mul]
        refine Submodule.neg_mem _ (Submodule.sum_mem _ (fun i hi => ?_))
        have hi' := Finset.mem_range.mp hi
        rw [mul_assoc, ← zpow_add₀ ht]
        exact hmem _ (by omega) (by omega) _
    refine isIntegral_of_smul_mem_submodule N hne hfg w (fun x hx => ?_)
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨k, ⟨hk1, hk2⟩, rfl⟩ := hx
      rw [smul_eq_mul]; exact hgen k hk1 hk2
    | zero => rw [smul_zero]; exact N.zero_mem
    | add x y _ _ hx hy => rw [smul_add]; exact N.add_mem hx hy
    | smul r x _ hx => rw [smul_comm]; exact N.smul_mem r hx

  have s3 : ∀ (V V' : ValuationSubring L), (∀ c ∈ K, (c ∈ V ↔ c ∈ V')) →
      ∀ z : L, z ∈ V → z ∉ V' →
      ∃ (n e : ℕ) (c : ℕ → L), e ≤ n ∧ (∀ i, c i ∈ K ∧ c i ∈ V) ∧
        ∑ i ∈ Finset.range (n+1), c i * z⁻¹ ^ i = 0 ∧
        V.valuation (∑ i ∈ Finset.Ico (e+1) (n+1), c i * z⁻¹ ^ (i - e)) = 1 ∧
        V'.valuation (∑ i ∈ Finset.Ico (e+1) (n+1), c i * z⁻¹ ^ (i - e)) < 1 := by
    intro V V' hT z hzV hzV'
    classical
    have hz0 : z ≠ 0 := fun h => hzV' (h ▸ V'.zero_mem)
    have ht' : V'.valuation z⁻¹ < 1 := by
      rw [hlt_aux V' z⁻¹ (inv_ne_zero hz0), inv_inv]; exact hzV'
    have hint : _root_.IsIntegral K z⁻¹ := Algebra.IsIntegral.isIntegral z⁻¹
    obtain ⟨t, ht⟩ : ∃ t, t = z⁻¹ := ⟨_, rfl⟩
    rw [← ht] at ht' hint ⊢
    have hzt : z * t = 1 := by rw [ht]; exact mul_inv_cancel₀ hz0
    have hzv : V.valuation z ≤ 1 := (V.valuation_le_one_iff z).mpr hzV
    obtain ⟨g, hgm, hg⟩ := hint
    obtain ⟨m, hm, hmax⟩ := Finset.exists_max_image (Finset.range (g.natDegree+1))
      (fun i => V.valuation ((g.coeff i : K) : L))
      ⟨g.natDegree, Finset.mem_range.mpr (Nat.lt_succ_self _)⟩
    have hmax' : ∀ i, V.valuation ((g.coeff i : K) : L) ≤
        V.valuation ((g.coeff m : K) : L) := by
      intro i
      by_cases hi : i ≤ g.natDegree
      · exact hmax i (Finset.mem_range.mpr (by omega))
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)]
        simp
    have hgn : ((g.coeff g.natDegree : K) : L) = 1 := by rw [hgm.coeff_natDegree]; simp
    have hgm1 : 1 ≤ V.valuation ((g.coeff m : K) : L) := by
      have := hmax' g.natDegree; rw [hgn, map_one] at this; exact this
    have hgm0 : ((g.coeff m : K) : L) ≠ 0 := by
      intro h; rw [h, map_zero] at hgm1; exact absurd hgm1 (not_le.mpr zero_lt_one)
    obtain ⟨c, hc⟩ : ∃ c : ℕ → L,
        c = fun i => ((g.coeff i : K) : L) / ((g.coeff m : K) : L) := ⟨_, rfl⟩
    have hcK : ∀ i, c i ∈ K := fun i => by
      rw [hc]; exact K.div_mem (g.coeff i).2 (g.coeff m).2
    have hcv : ∀ i, V.valuation (c i) ≤ 1 := fun i => by
      rw [hc]; dsimp only; rw [map_div₀]; exact div_le_one_of_le₀ (hmax' i) zero_le'
    have hcV : ∀ i, c i ∈ V := fun i => (V.valuation_le_one_iff _).mp (hcv i)
    have hcV' : ∀ i, c i ∈ V' := fun i => (hT _ (hcK i)).mp (hcV i)
    have hcm : c m = 1 := by rw [hc]; exact div_self hgm0
    have hrel : ∑ i ∈ Finset.range (g.natDegree+1), c i * t ^ i = 0 := by
      have h1 : Polynomial.aeval t g = 0 := hg
      rw [Polynomial.aeval_eq_sum_range] at h1
      have : ∑ i ∈ Finset.range (g.natDegree+1), c i * t ^ i =
          (∑ i ∈ Finset.range (g.natDegree+1), g.coeff i • t ^ i) /
            ((g.coeff m : K) : L) := by
        rw [Finset.sum_div]; refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [Algebra.smul_def, hc]
        show ((g.coeff i : K) : L) / _ * t ^ i = ((g.coeff i : K) : L) * t ^ i / _
        ring
      rw [this, h1, zero_div]
    have hex : ∃ i, V.valuation (c i) = 1 := ⟨m, by rw [hcm, map_one]⟩
    have hce : V.valuation (c (Nat.find hex)) = 1 := Nat.find_spec hex
    have hem : Nat.find hex ≤ m := Nat.find_min' hex (by rw [hcm, map_one])
    have hmn : m ≤ g.natDegree := by have := Finset.mem_range.mp hm; omega
    have hlt_e : ∀ i < Nat.find hex, V.valuation (c i) < 1 :=
      fun i hi => lt_of_le_of_ne (hcv i) (Nat.find_min hex hi)
    obtain ⟨e, he⟩ : ∃ e, e = Nat.find hex := ⟨_, rfl⟩
    rw [← he] at hce hem hlt_e
    refine ⟨g.natDegree, e, c, by omega, fun i => ⟨hcK i, hcV i⟩, hrel, ?_, ?_⟩
    · have hsplit := Finset.sum_range_add_sum_Ico (fun i => c i * t ^ i * z ^ e)
        (by omega : e + 1 ≤ g.natDegree + 1)
      rw [Finset.sum_range_succ] at hsplit
      have htot : ∑ i ∈ Finset.range (g.natDegree+1), c i * t ^ i * z ^ e = 0 := by
        rw [← Finset.sum_mul, hrel, zero_mul]
      have hlow : ∀ i ∈ Finset.range e, c i * t ^ i * z ^ e = c i * z ^ (e - i) := by
        intro i hi
        have hi' := Finset.mem_range.mp hi
        rw [show z ^ e = z ^ (e - i) * z ^ i by rw [← pow_add, Nat.sub_add_cancel hi'.le]]
        calc c i * t ^ i * (z ^ (e - i) * z ^ i) = c i * z ^ (e - i) * (z * t) ^ i := by ring
          _ = c i * z ^ (e - i) := by rw [hzt, one_pow, mul_one]
      have hmid : c e * t ^ e * z ^ e = c e := by
        calc c e * t ^ e * z ^ e = c e * (z * t) ^ e := by ring
          _ = c e := by rw [hzt, one_pow, mul_one]
      have hup : ∀ i ∈ Finset.Ico (e+1) (g.natDegree+1),
          c i * t ^ i * z ^ e = c i * t ^ (i - e) := by
        intro i hi
        have hi' := Finset.mem_Ico.mp hi
        rw [show t ^ i = t ^ (i - e) * t ^ e by rw [← pow_add, Nat.sub_add_cancel (by omega)]]
        calc c i * (t ^ (i - e) * t ^ e) * z ^ e = c i * t ^ (i - e) * (z * t) ^ e := by ring
          _ = c i * t ^ (i - e) := by rw [hzt, one_pow, mul_one]
      rw [Finset.sum_congr rfl hlow, Finset.sum_congr rfl hup, htot, hmid] at hsplit
      have hs0 : V.valuation (∑ i ∈ Finset.range e, c i * z ^ (e - i)) < 1 := by
        apply Valuation.map_sum_lt _ one_ne_zero
        intro i hi
        rw [map_mul, map_pow]
        exact lt_of_le_of_lt (mul_le_of_le_one_right' (pow_le_one₀ zero_le' hzv))
          (hlt_e i (Finset.mem_range.mp hi))
      have hw : ∑ i ∈ Finset.Ico (e+1) (g.natDegree+1), c i * t ^ (i - e) =
          -(c e + ∑ i ∈ Finset.range e, c i * z ^ (e - i)) := by
        have hsplit' : ∑ i ∈ Finset.range e, c i * z ^ (e - i) + c e +
            ∑ i ∈ Finset.Ico (e+1) (g.natDegree+1), c i * t ^ (i - e) = 0 := hsplit
        linear_combination hsplit'
      rw [hw, Valuation.map_neg, Valuation.map_add_eq_of_lt_left _ (by rw [hce]; exact hs0), hce]
    · apply Valuation.map_sum_lt _ one_ne_zero
      intro i hi
      have hi' := Finset.mem_Ico.mp hi
      rw [map_mul, map_pow]
      have h1 : V'.valuation (c i) ≤ 1 := (V'.valuation_le_one_iff _).mpr (hcV' i)
      have h2 : V'.valuation t ^ (i - e) < 1 := pow_lt_one₀ zero_le' ht' (by omega)
      exact lt_of_le_of_lt (mul_le_of_le_one_left' h1) h2

  have pipe_aux : ∀ (V V' : ValuationSubring L), (∀ c ∈ K, (c ∈ V ↔ c ∈ V')) →
      (∀ c ∈ K, (V.valuation c < 1 ↔ V'.valuation c < 1)) →
      ∀ w : L, _root_.IsIntegral ↥(K.toSubring ⊓ V.toSubring) w →
      V.valuation w = 1 → V'.valuation w < 1 →
      ∃ (ε : L) (P P₂ Q : Polynomial K),
        P.Monic ∧ Polynomial.aeval ε P = 0 ∧ (∀ i, V.valuation (P.coeff i : L) ≤ 1) ∧
        P₂.Monic ∧ Polynomial.aeval (1 - ε) P₂ = 0 ∧ (∀ i, V.valuation (P₂.coeff i : L) ≤ 1) ∧
        Q.Monic ∧ Polynomial.aeval (ε * (1 - ε)) Q = 0 ∧
        (∀ i < Q.natDegree, V.valuation (Q.coeff i : L) < 1) ∧
        V.valuation (ε - 1) < 1 ∧ V'.valuation ε < 1 := by
    intro V V' hT hTs w hw hv hv'
    classical
    let ψ : ↥(K.toSubring ⊓ V.toSubring) →+* K :=
      { toFun := fun r => ⟨r, (Subring.mem_inf.mp r.2).1⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hψc : (algebraMap K L).comp ψ = algebraMap ↥(K.toSubring ⊓ V.toSubring) L :=
      RingHom.ext fun _ => rfl
    have hψ : ∀ (p : Polynomial ↥(K.toSubring ⊓ V.toSubring)) (x : L),
        Polynomial.aeval x (p.map ψ) = Polynomial.aeval x p := by
      intro p x
      rw [Polynomial.aeval_def, Polynomial.eval₂_map, hψc, Polynomial.aeval_def]
    have hψco : ∀ (p : Polynomial ↥(K.toSubring ⊓ V.toSubring)) (i : ℕ),
        (((p.map ψ).coeff i : K) : L) =
          algebraMap ↥(K.toSubring ⊓ V.toSubring) L (p.coeff i) := by
      intro p i
      rw [Polynomial.coeff_map]; rfl
    have hRK : ∀ r : ↥(K.toSubring ⊓ V.toSubring),
        algebraMap ↥(K.toSubring ⊓ V.toSubring) L r ∈ K := fun r => (Subring.mem_inf.mp r.2).1
    have hRV : ∀ r : ↥(K.toSubring ⊓ V.toSubring),
        algebraMap ↥(K.toSubring ⊓ V.toSubring) L r ∈ V := fun r => (Subring.mem_inf.mp r.2).2
    have hfgT := hw.fg_adjoin_singleton
    have s5a : ∀ x ∈ Algebra.adjoin ↥(K.toSubring ⊓ V.toSubring) {w},
        ∃ P : Polynomial K, P.Monic ∧ Polynomial.aeval x P = 0 ∧
          ∀ i, V.valuation (P.coeff i : L) ≤ 1 := by
      intro x hx
      obtain ⟨p, hpm, hp⟩ := _root_.IsIntegral.of_mem_of_fg _ hfgT x hx
      refine ⟨p.map ψ, hpm.map ψ, ?_, fun i => ?_⟩
      · rw [hψ]; exact hp
      · rw [hψco]; exact (V.valuation_le_one_iff _).mpr (hRV _)
    obtain ⟨p, hpm, hp⟩ := hw
    have hrel : ∑ i ∈ Finset.range (p.natDegree + 1),
        algebraMap ↥(K.toSubring ⊓ V.toSubring) L (p.coeff i) * w ^ i = 0 := by
      have h1 : Polynomial.aeval w p = 0 := hp
      rw [Polynomial.aeval_eq_sum_range] at h1
      rw [← h1]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Algebra.smul_def]
    obtain ⟨f, hf⟩ : ∃ f : ℕ → L,
        f = fun i => algebraMap ↥(K.toSubring ⊓ V.toSubring) L (p.coeff i) := ⟨_, rfl⟩
    have hrel' : ∑ i ∈ Finset.range (p.natDegree + 1), f i * w ^ i = 0 := by
      rw [hf]; exact hrel
    have hfK : ∀ i, f i ∈ K := fun i => by rw [hf]; exact hRK _
    have hfV : ∀ i, f i ∈ V := fun i => by rw [hf]; exact hRV _
    have hfV' : ∀ i, f i ∈ V' := fun i => (hT _ (hfK i)).mp (hfV i)
    have hfv : ∀ i, V.valuation (f i) ≤ 1 := fun i => (V.valuation_le_one_iff _).mpr (hfV i)
    have hfN : f p.natDegree = 1 := by
      rw [hf]; dsimp only; rw [hpm.coeff_natDegree, map_one]
    have hex : ∃ i, V.valuation (f i) = 1 := ⟨p.natDegree, by rw [hfN, map_one]⟩
    have hce : V.valuation (f (Nat.find hex)) = 1 := Nat.find_spec hex
    have heN : Nat.find hex ≤ p.natDegree := Nat.find_min' hex (by rw [hfN, map_one])
    have hlt_e : ∀ i < Nat.find hex, V.valuation (f i) < 1 :=
      fun i hi => lt_of_le_of_ne (hfv i) (Nat.find_min hex hi)
    obtain ⟨e, he⟩ : ∃ e, e = Nat.find hex := ⟨_, rfl⟩
    rw [← he] at hce heN hlt_e
    obtain ⟨N, hN⟩ : ∃ N, N = p.natDegree := ⟨_, rfl⟩
    rw [← hN] at hrel' heN
    have hwV' : w ∈ V' := (V'.valuation_le_one_iff _).mp hv'.le
    have he1 : e ≠ 0 := by
      intro he0
      rw [he0] at hce
      have hsplit := Finset.sum_range_add_sum_Ico (fun i => f i * w ^ i) (by omega : 1 ≤ N + 1)
      rw [Finset.sum_range_one, hrel', pow_zero, mul_one] at hsplit
      have h0 : f 0 = -∑ i ∈ Finset.Ico 1 (N + 1), f i * w ^ i := by linear_combination hsplit
      have h1 : V'.valuation (f 0) < 1 := by
        rw [h0, Valuation.map_neg]
        apply Valuation.map_sum_lt _ one_ne_zero
        intro i hi
        have hi' := Finset.mem_Ico.mp hi
        rw [map_mul, map_pow]
        exact lt_of_le_of_lt (mul_le_of_le_one_left' ((V'.valuation_le_one_iff _).mpr (hfV' i)))
          (pow_lt_one₀ zero_le' hv' (by omega))
      have h2 := (hTs _ (hfK 0)).mpr h1
      rw [hce] at h2
      exact lt_irrefl _ h2
    have hfe0 : f e ≠ 0 := by intro h; rw [h, map_zero] at hce; exact zero_ne_one hce
    obtain ⟨uu, huu⟩ : ∃ uu : L, uu = (f e)⁻¹ := ⟨_, rfl⟩
    have hu : uu * f e = 1 := by rw [huu]; exact inv_mul_cancel₀ hfe0
    have huv : V.valuation uu = 1 := by rw [huu, map_inv₀, hce, inv_one]
    have huK : uu ∈ K := by rw [huu]; exact K.inv_mem (hfK e)
    have huV : uu ∈ V := (V.valuation_le_one_iff _).mp huv.le
    have huV' : uu ∈ V' := (hT _ huK).mp huV
    obtain ⟨S, hS⟩ : ∃ S : L, S = ∑ i ∈ Finset.Ico (e + 1) (N + 1), f i * w ^ (i - (e + 1)) :=
      ⟨_, rfl⟩
    obtain ⟨μ, hμ⟩ : ∃ μ : L, μ = ∑ i ∈ Finset.range e, f i * w ^ i := ⟨_, rfl⟩
    obtain ⟨σ, hσ⟩ : ∃ σ : L, σ = -(uu * S) := ⟨_, rfl⟩
    obtain ⟨q, hq⟩ : ∃ q : L, q = w * σ := ⟨_, rfl⟩
    obtain ⟨G, hG⟩ : ∃ G : L, G = ∑ j ∈ Finset.range e, q ^ j := ⟨_, rfl⟩
    have I1 : μ + f e * w ^ e + w ^ (e + 1) * S = 0 := by
      have hsplit := Finset.sum_range_add_sum_Ico (fun i => f i * w ^ i)
        (by omega : e + 1 ≤ N + 1)
      rw [Finset.sum_range_succ, hrel'] at hsplit
      have hup : ∑ i ∈ Finset.Ico (e + 1) (N + 1), f i * w ^ i = w ^ (e + 1) * S := by
        rw [hS, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i hi => ?_)
        have hi' := Finset.mem_Ico.mp hi
        rw [show w ^ i = w ^ (e + 1) * w ^ (i - (e + 1)) by
          rw [← pow_add, Nat.add_sub_cancel' hi'.1]]
        ring
      rw [hup] at hsplit
      rw [hμ]; exact hsplit
    have I2 : w ^ e * (1 - q) = -(uu * μ) := by
      rw [hq, hσ]
      linear_combination uu * I1 - w ^ e * hu
    have hGeq : (1 - q) * G = 1 - q ^ e := by rw [hG]; exact mul_neg_geom_sum q e
    have I3 : q ^ e * (1 - q ^ e) = (-(uu * σ ^ e * G)) * μ := by
      rw [hq] at hGeq I2 ⊢
      linear_combination (-((w * σ) ^ e)) * hGeq + (σ ^ e * G) * I2
    have hμv : V.valuation μ < 1 := by
      rw [hμ]
      apply Valuation.map_sum_lt _ one_ne_zero
      intro i hi
      rw [map_mul, map_pow, hv, one_pow, mul_one]
      exact hlt_e i (Finset.mem_range.mp hi)
    have h1q : V.valuation (1 - q) < 1 := by
      have := congrArg V.valuation I2
      rw [map_mul, map_pow, hv, one_pow, one_mul, Valuation.map_neg, map_mul, huv,
        one_mul] at this
      rw [this]; exact hμv
    have hqv : V.valuation q ≤ 1 := by
      have : q = 1 - (1 - q) := by ring
      rw [this]
      refine le_trans (Valuation.map_sub _ _ _) (max_le ?_ h1q.le)
      rw [map_one]
    have hGv : V.valuation G ≤ 1 := by
      rw [hG]
      apply Valuation.map_sum_le
      intro j _
      rw [map_pow]; exact pow_le_one₀ zero_le' hqv
    have hε1 : V.valuation (q ^ e - 1) < 1 := by
      have : q ^ e - 1 = -((1 - q) * G) := by rw [hGeq]; ring
      rw [this, Valuation.map_neg, map_mul]
      exact lt_of_le_of_lt (mul_le_of_le_one_right' hGv) h1q
    have hσV' : σ ∈ V' := by
      rw [hσ, hS]
      refine V'.neg_mem _ (V'.mul_mem _ _ huV' (V'.sum_mem (fun i _ => ?_)))
      exact V'.mul_mem _ _ (hfV' i) (V'.pow_mem hwV' _)
    have hε0 : V'.valuation (q ^ e) < 1 := by
      rw [map_pow]
      refine pow_lt_one₀ zero_le' ?_ he1
      rw [hq, map_mul]
      exact lt_of_le_of_lt (mul_le_of_le_one_right' ((V'.valuation_le_one_iff _).mpr hσV')) hv'
    have hwT : w ∈ Algebra.adjoin ↥(K.toSubring ⊓ V.toSubring) {w} :=
      Algebra.self_mem_adjoin_singleton _ w
    have hfT : ∀ i, f i ∈ Algebra.adjoin ↥(K.toSubring ⊓ V.toSubring) {w} := fun i => by
      rw [hf]; exact Subalgebra.algebraMap_mem _ _
    have huT : uu ∈ Algebra.adjoin ↥(K.toSubring ⊓ V.toSubring) {w} :=
      Subalgebra.algebraMap_mem _ (⟨uu, Subring.mem_inf.mpr ⟨huK, huV⟩⟩ :
        ↥(K.toSubring ⊓ V.toSubring))
    have hST : S ∈ Algebra.adjoin ↥(K.toSubring ⊓ V.toSubring) {w} := by
      rw [hS]
      exact Subalgebra.sum_mem _ (fun i _ =>
        Subalgebra.mul_mem _ (hfT i) (Subalgebra.pow_mem _ hwT _))
    have hσT : σ ∈ Algebra.adjoin ↥(K.toSubring ⊓ V.toSubring) {w} := by
      rw [hσ]; exact Subalgebra.neg_mem _ (Subalgebra.mul_mem _ huT hST)
    have hqT : q ∈ Algebra.adjoin ↥(K.toSubring ⊓ V.toSubring) {w} := by
      rw [hq]; exact Subalgebra.mul_mem _ hwT hσT
    have hεT : q ^ e ∈ Algebra.adjoin ↥(K.toSubring ⊓ V.toSubring) {w} :=
      Subalgebra.pow_mem _ hqT _
    have hGT : G ∈ Algebra.adjoin ↥(K.toSubring ⊓ V.toSubring) {w} := by
      rw [hG]; exact Subalgebra.sum_mem _ (fun j _ => Subalgebra.pow_mem _ hqT _)
    have hyT : -(uu * σ ^ e * G) ∈ Algebra.adjoin ↥(K.toSubring ⊓ V.toSubring) {w} :=
      Subalgebra.neg_mem _ (Subalgebra.mul_mem _ (Subalgebra.mul_mem _ huT
        (Subalgebra.pow_mem _ hσT _)) hGT)
    obtain ⟨P, hPm, hPε, hPc⟩ := s5a _ hεT
    obtain ⟨P₂, hP₂m, hP₂ε, hP₂c⟩ := s5a _
      (Subalgebra.sub_mem _ (Subalgebra.one_mem _) hεT)
    haveI : Module.Finite ↥(K.toSubring ⊓ V.toSubring)
        ↥(Algebra.adjoin ↥(K.toSubring ⊓ V.toSubring) {w}) :=
      Algebra.finite_adjoin_simple_of_isIntegral ⟨p, hpm, hp⟩
    haveI : Algebra.IsIntegral ↥(K.toSubring ⊓ V.toSubring)
        ↥(Algebra.adjoin ↥(K.toSubring ⊓ V.toSubring) {w}) := Algebra.IsIntegral.of_finite _ _
    let 𝔪 : Ideal ↥(K.toSubring ⊓ V.toSubring) :=
      { carrier := {r | V.valuation (algebraMap ↥(K.toSubring ⊓ V.toSubring) L r) < 1}
        add_mem' := fun {a b} ha hb => by
          simp only [Set.mem_setOf_eq, map_add] at ha hb ⊢
          exact Valuation.map_add_lt _ ha hb
        zero_mem' := by simp
        smul_mem' := fun c x hx => by
          simp only [Set.mem_setOf_eq, smul_eq_mul, map_mul] at hx ⊢
          exact lt_of_le_of_lt (mul_le_of_le_one_left'
            ((V.valuation_le_one_iff _).mpr (hRV c))) hx }
    let x' : ↥(Algebra.adjoin ↥(K.toSubring ⊓ V.toSubring) {w}) :=
      ⟨-(uu * σ ^ e * G), hyT⟩ * ∑ i ∈ Finset.range e,
        algebraMap ↥(K.toSubring ⊓ V.toSubring)
          ↥(Algebra.adjoin ↥(K.toSubring ⊓ V.toSubring) {w}) (p.coeff i) * ⟨w, hwT⟩ ^ i
    have hx'mem : x' ∈ Ideal.map (algebraMap ↥(K.toSubring ⊓ V.toSubring)
        ↥(Algebra.adjoin ↥(K.toSubring ⊓ V.toSubring) {w})) 𝔪 := by
      refine Ideal.mul_mem_left _ _ (Ideal.sum_mem _ (fun i hi => Ideal.mul_mem_right _ _
        (Ideal.mem_map_of_mem _ ?_)))
      show V.valuation (algebraMap ↥(K.toSubring ⊓ V.toSubring) L (p.coeff i)) < 1
      have := hlt_e i (Finset.mem_range.mp hi)
      rw [hf] at this
      exact this
    have hx'coe : (Algebra.adjoin ↥(K.toSubring ⊓ V.toSubring) {w}).val x' =
        q ^ e * (1 - q ^ e) := by
      rw [I3, hμ]
      simp only [x', map_mul, map_sum, map_pow, AlgHom.commutes]
      rw [hf]
      rfl
    obtain ⟨p', hp'm, hp', hp'c⟩ :=
      Polynomial.exists_monic_aeval_eq_zero_forall_mem_of_mem_map hx'mem
    refine ⟨q ^ e, P, P₂, p'.map ψ, hPm, hPε, hPc, hP₂m, hP₂ε, hP₂c, hp'm.map ψ, ?_, ?_,
      hε1, hε0⟩
    · rw [hψ, ← hx'coe, Polynomial.aeval_algHom_apply, hp', map_zero]
    · intro i hi
      rw [hp'm.natDegree_map] at hi
      rw [hψco]
      exact hp'c i (Nat.ne_of_lt hi)

  have hT : ∀ c ∈ K, (c ∈ A ↔ c ∈ A') := by
    intro c hc
    have h := congrArg (fun B : ValuationSubring K => (⟨c, hc⟩ : K) ∈ B) hcomap
    simpa [ValuationSubring.mem_comap] using h
  have hTs : ∀ c ∈ K, (A.valuation c < 1 ↔ A'.valuation c < 1) := by
    intro c hc
    by_cases hc0 : c = 0
    · subst hc0; simp
    rw [hlt_aux A c hc0, hlt_aux A' c hc0, hT _ (K.inv_mem hc)]

  have pipe : ∀ (V V' : ValuationSubring L), (∀ c ∈ K, (c ∈ V ↔ c ∈ V')) →
      (∀ c ∈ K, (V.valuation c < 1 ↔ V'.valuation c < 1)) → ∀ z, z ∈ V → z ∉ V' →
      ∃ (ε : L) (P P₂ Q : Polynomial K),
        P.Monic ∧ Polynomial.aeval ε P = 0 ∧ (∀ i, V.valuation (P.coeff i : L) ≤ 1) ∧
        P₂.Monic ∧ Polynomial.aeval (1 - ε) P₂ = 0 ∧ (∀ i, V.valuation (P₂.coeff i : L) ≤ 1) ∧
        Q.Monic ∧ Polynomial.aeval (ε * (1 - ε)) Q = 0 ∧
        (∀ i < Q.natDegree, V.valuation (Q.coeff i : L) < 1) ∧
        V.valuation (ε - 1) < 1 ∧ V'.valuation ε < 1 := by
    intro V V' hT1 hTs1 z hzV hzV'
    have hz0 : z ≠ 0 := fun h => hzV' (h ▸ V'.zero_mem)
    obtain ⟨n, e, c, hen, hc, hrel, hv, hv'⟩ := s3 V V' hT1 z hzV hzV'
    let a : ℕ → ↥(K.toSubring ⊓ V.toSubring) := fun i => ⟨c i, Subring.mem_inf.mpr (hc i)⟩
    have hint := s2 ↥(K.toSubring ⊓ V.toSubring) z⁻¹ (inv_ne_zero hz0) a n e hen hrel
    exact pipe_aux V V' hT1 hTs1 _ hint hv hv'
  have hz : ∃ z, (z ∈ A ∧ z ∉ A') ∨ (z ∈ A' ∧ z ∉ A) := by
    by_contra hcon
    push_neg at hcon
    apply hne
    ext z
    exact ⟨fun h => (hcon z).1 h, fun h => (hcon z).2 h⟩
  obtain ⟨z, ⟨hzA, hzA'⟩ | ⟨hzA', hzA⟩⟩ := hz
  · obtain ⟨ε, P, _, Q, hPm, hPε, hPc, _, _, _, hQm, hQε, hQc, h1, h2⟩ :=
      pipe A A' hT hTs z hzA hzA'
    exact ⟨ε, P, Q, hPm, hPε, hPc, hQm, hQε, hQc, h1, h2⟩
  · obtain ⟨ε, _, P₂, Q, _, _, _, hP₂m, hP₂ε, hP₂c, hQm, hQε, hQc, h1, h2⟩ :=
      pipe A' A (fun c hc => (hT c hc).symm) (fun c hc => (hTs c hc).symm) z hzA' hzA
    refine ⟨1 - ε, P₂, Q, hP₂m, hP₂ε, fun i => ?_, hQm, ?_, fun i hi => ?_, ?_, ?_⟩
    · exact (A.valuation_le_one_iff _).mpr ((hT _ (P₂.coeff i).2).mpr
        ((A'.valuation_le_one_iff _).mp (hP₂c i)))
    · rw [show (1 - ε) * (1 - (1 - ε)) = ε * (1 - ε) by ring]; exact hQε
    · exact (hTs _ (Q.coeff i).2).mpr (hQc i hi)
    · rw [show 1 - ε - 1 = -ε by ring, Valuation.map_neg]; exact h2
    · rw [Valuation.map_sub_swap]; exact h1

theorem wcpa_dj_lr1k_nsr_nlb_ue_centre_lift : ∀ (C Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral C]
    (f : C ⟶ Y) [QuasiCompact f] [QuasiSeparated f] (p : ↥Y)
    (B : ValuationSubring C.functionField),
    wcNsrNaDom B f p →
    ∃ q : ↥f.normalization, f.fromNormalization q = p ∧ wcNsrNaDom B f.toNormalization q :=
by
  intro C Y _ f _ _ p B hD
  classical
  obtain ⟨hy, h1, h2⟩ := hD
  have hmem : ∀ s, (wcLr1uGerm f p hy).hom s ∈ B := fun s =>
    (B.valuation_le_one_iff _).mp (h1 s)
  let ψ : Y.presheaf.stalk p ⟶ CommRingCat.of ↥B :=
    CommRingCat.ofHom ((wcLr1uGerm f p hy).hom.codRestrict B hmem)
  have hψφ : ψ ≫ CommRingCat.ofHom (algebraMap ↥B C.functionField) = wcLr1uGerm f p hy := by
    ext s; rfl
  haveI hψloc : IsLocalHom ψ.hom := by
    constructor
    intro a ha
    by_contra hna
    have hm : a ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk p) :=
      (IsLocalRing.mem_maximalIdeal a).mpr hna
    have hlt := h2 a hm
    have hmB : ψ.hom a ∈ IsLocalRing.maximalIdeal ↥B := (B.valuation_lt_one_iff _).mpr hlt
    exact (IsLocalRing.mem_maximalIdeal _).mp hmB ha
  let i₂ : Spec (.of ↥B) ⟶ Y := Spec.map ψ ≫ Y.fromSpecStalk p
  have hc : Spec.map (CommRingCat.ofHom (algebraMap ↥B C.functionField)) ≫ i₂ =
      C.fromSpecStalk (genericPoint C) ≫ f := by
    simp only [i₂]
    rw [← Category.assoc, ← Spec.map_comp, hψφ]
    unfold wcLr1uGerm
    rw [Spec.map_comp, Category.assoc, Scheme.SpecMap_stalkSpecializes_fromSpecStalk,
      Scheme.SpecMap_stalkMap_fromSpecStalk]
  let pt0 : ↥(Spec (CommRingCat.of ↥B)) := IsLocalRing.closedPoint ↥B
  have hp : i₂ pt0 = p :=
    (Scheme.Hom.comp_apply (Spec.map ψ) (Y.fromSpecStalk p) pt0).trans
      ((congrArg (Y.fromSpecStalk p) (Spec_closedPoint (f := ψ))).trans
        (Scheme.fromSpecStalk_closedPoint (X := Y) (x := p)))
  have hsq : CommSq (C.fromSpecStalk (genericPoint C) ≫ f.toNormalization)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥B C.functionField))) f.fromNormalization i₂ :=
    ⟨by rw [Category.assoc, Scheme.Hom.toNormalization_fromNormalization]; exact hc.symm⟩
  have hUC : UniversallyClosed f.fromNormalization :=
    (IsIntegralHom.iff_universallyClosed_and_isAffineHom.mp inferInstance).1
  have hE : ValuativeCriterion.Existence f.fromNormalization := by
    rw [UniversallyClosed.eq_valuativeCriterion] at hUC
    exact hUC.1
  let S : ValuativeCommSq f.fromNormalization :=
    { R := ↥B, K := C.functionField, i₁ := _, i₂ := i₂, commSq := hsq }
  haveI hL : S.commSq.HasLift := hE S
  let l : Spec (.of ↥B) ⟶ f.normalization := S.commSq.lift
  have hfl : Spec.map (CommRingCat.ofHom (algebraMap ↥B C.functionField)) ≫ l =
      C.fromSpecStalk (genericPoint C) ≫ f.toNormalization := S.commSq.fac_left
  have hfr : l ≫ f.fromNormalization = i₂ := S.commSq.fac_right
  refine ⟨l pt0, ?_, ?_⟩
  · exact ((Scheme.Hom.comp_apply l f.fromNormalization pt0).symm.trans
      (congrArg (fun g : Spec (CommRingCat.of ↥B) ⟶ Y => g pt0) hfr)).trans hp
  · let ptK : ↥(Spec (C.presheaf.stalk (genericPoint C))) :=
      IsLocalRing.closedPoint (C.presheaf.stalk (genericPoint C))
    have hspec : f.toNormalization (genericPoint C) ⤳ l pt0 := by
      have h0 : (Spec.map (CommRingCat.ofHom (algebraMap ↥B C.functionField))) ptK ⤳ pt0 :=
        IsLocalRing.specializes_closedPoint _
      have h1 := h0.map l.continuous
      have h3 := congrArg (fun g : Spec (C.presheaf.stalk (genericPoint C)) ⟶ f.normalization =>
        g ptK) hfl
      have h2 : l ((Spec.map (CommRingCat.ofHom (algebraMap ↥B C.functionField))) ptK) =
          f.toNormalization (genericPoint C) :=
        (Scheme.Hom.comp_apply _ l ptK).symm.trans (h3.trans
          ((Scheme.Hom.comp_apply (C.fromSpecStalk (genericPoint C)) f.toNormalization ptK).trans
            (congrArg f.toNormalization
              (Scheme.fromSpecStalk_closedPoint (X := C) (x := genericPoint C)))))
      exact h2 ▸ h1
    have hgerm : wcLr1uGerm f.toNormalization (l pt0) hspec =
        Scheme.stalkClosedPointTo l ≫ CommRingCat.ofHom (algebraMap ↥B C.functionField) := by
      apply Spec.map_injective
      rw [← cancel_mono (f.normalization.fromSpecStalk (l pt0))]
      unfold wcLr1uGerm
      rw [Spec.map_comp, Category.assoc, Scheme.SpecMap_stalkSpecializes_fromSpecStalk,
        Scheme.SpecMap_stalkMap_fromSpecStalk, Spec.map_comp, Category.assoc,
        Scheme.Spec_stalkClosedPointTo_fromSpecStalk]
      exact hfl.symm
    haveI : IsLocalHom (Scheme.stalkClosedPointTo l).hom := Scheme.isLocalHom_stalkClosedPointTo l
    refine ⟨hspec, ?_, ?_⟩
    · intro s
      rw [hgerm]
      exact B.valuation_le_one ((Scheme.stalkClosedPointTo l).hom s)
    · intro s hs
      rw [hgerm]
      have hmB : (Scheme.stalkClosedPointTo l).hom s ∈ IsLocalRing.maximalIdeal ↥B := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        exact (IsLocalRing.mem_maximalIdeal _).mp hs
          (isUnit_of_map_unit (Scheme.stalkClosedPointTo l).hom s hu)
      exact (B.valuation_lt_one_iff _).mp hmB

theorem wcpa_dj_lr1k_nsr_nlb_ue_centre_descend : ∀ (Ω : Type u) [Field Ω]
    (W : ValuationSubring Ω) (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C]
    (γ : C ⟶ wcProjK Ω 1) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
    [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)]
    (X₁ : Scheme.{u}) (r₁ : X₁ ⟶ X) (ι₁ : wcProjK Ω 1 ⟶ X₁)
    [QuasiCompact (γ ≫ ι₁)] [QuasiSeparated (γ ≫ ι₁)] (hι : ι₁ ≫ r₁ = ι),
    wcpaDjLkModel W uX ι →
    ∀ (B : ValuationSubring C.functionField) (q : ↥(γ ≫ ι₁).normalization)
      (n : ↥(γ ≫ ι).normalization),
      wcNsrNaDom B (γ ≫ ι₁).toNormalization q → wcNsrNaDom B (γ ≫ ι).toNormalization n →
      wcUePi γ ι ι₁ r₁ hι q = n :=
by
  intro Ω _ W C _ γ X uX ι _ _ X₁ r₁ ι₁ _ _ hι hM B q n hq hn

  have s1 : ∀ (Y : Scheme.{u}) (h : C ⟶ Y) (y : ↥Y), wcNsrNaDom B h y →
      ∃ l : Spec (.of ↥B) ⟶ Y, l (IsLocalRing.closedPoint ↥B) = y ∧
        Spec.map (CommRingCat.ofHom (algebraMap ↥B C.functionField)) ≫ l =
          C.fromSpecStalk (genericPoint ↥C) ≫ h := by
    intro Y h y hD
    obtain ⟨hy, H1, H2⟩ := hD
    have H1' : ∀ s, (wcLr1uGerm h y hy).hom s ∈ B := fun s =>
      (B.valuation_le_one_iff _).mp (H1 s)
    let φ' : Y.presheaf.stalk y →+* ↥B := RingHom.codRestrict (wcLr1uGerm h y hy).hom B H1'
    haveI hloc : IsLocalHom φ' := by
      refine ⟨fun a ha => ?_⟩
      by_contra hna
      have hm : a ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk y) :=
        (IsLocalRing.mem_maximalIdeal a).mpr hna
      have h2 := H2 a hm
      have h3 : φ' a ∈ IsLocalRing.maximalIdeal ↥B := (B.valuation_lt_one_iff (φ' a)).mpr h2
      exact (IsLocalRing.mem_maximalIdeal _).mp h3 ha
    haveI : IsLocalHom (CommRingCat.ofHom φ').hom := hloc
    refine ⟨Spec.map (CommRingCat.ofHom φ') ≫ Y.fromSpecStalk y, ?_, ?_⟩
    · have e1 := Spec_closedPoint (f := CommRingCat.ofHom φ')
      exact (Scheme.Hom.comp_apply _ _ _).trans
        ((congrArg (fun z => Y.fromSpecStalk y z) e1).trans Scheme.fromSpecStalk_closedPoint)
    · have hcomp : CommRingCat.ofHom φ' ≫ CommRingCat.ofHom (algebraMap ↥B C.functionField) =
          wcLr1uGerm h y hy := by
        ext s; rfl
      rw [← Category.assoc, ← Spec.map_comp, hcomp]
      unfold wcLr1uGerm
      rw [Spec.map_comp, Category.assoc, Scheme.SpecMap_stalkSpecializes_fromSpecStalk,
        Scheme.SpecMap_stalkMap_fromSpecStalk]

  have s2 : ∀ (Z : Scheme.{u}), IsSeparated (Limits.terminal.from Z) →
      ∀ l₁ l₂ : Spec (.of ↥B) ⟶ Z,
        Spec.map (CommRingCat.ofHom (algebraMap ↥B C.functionField)) ≫ l₁ =
          Spec.map (CommRingCat.ofHom (algebraMap ↥B C.functionField)) ≫ l₂ → l₁ = l₂ := by
    intro Z hZ l₁ l₂ hl
    let S : ValuativeCommSq (Limits.terminal.from Z) :=
      ValuativeCommSq.mk ↥B C.functionField
        (Spec.map (CommRingCat.ofHom (algebraMap ↥B C.functionField)) ≫ l₁)
        (Limits.terminal.from _) ⟨Limits.terminal.hom_ext _ _⟩
    have hsub : Subsingleton S.commSq.LiftStruct :=
      IsSeparated.valuativeCriterion (Limits.terminal.from Z) S
    let L₁ : S.commSq.LiftStruct := ⟨l₁, rfl, Limits.terminal.hom_ext _ _⟩
    let L₂ : S.commSq.LiftStruct := ⟨l₂, hl.symm, Limits.terminal.hom_ext _ _⟩
    exact congrArg CommSq.LiftStruct.l (Subsingleton.elim L₁ L₂)

  have s3 : (γ ≫ ι₁).toNormalization ≫ wcUePi γ ι ι₁ r₁ hι = (γ ≫ ι).toNormalization := by
    unfold wcUePi
    rw [← Category.assoc, Scheme.Hom.toNormalization_normalizationDesc, Limits.pullback.lift_fst]

  haveI : IsProper uX := hM.1.2.1
  have s4 : IsSeparated (Limits.terminal.from (γ ≫ ι).normalization) := by
    rw [Limits.terminal.hom_ext (Limits.terminal.from _)
      ((γ ≫ ι).fromNormalization ≫ uX ≫ Limits.terminal.from _)]
    infer_instance

  obtain ⟨lq, hlq1, hlq2⟩ := s1 _ (γ ≫ ι₁).toNormalization q hq
  obtain ⟨ln, hln1, hln2⟩ := s1 _ (γ ≫ ι).toNormalization n hn
  have heq : lq ≫ wcUePi γ ι ι₁ r₁ hι = ln := by
    apply s2 _ s4
    rw [← Category.assoc, hlq2, Category.assoc, s3, hln2]
  rw [← hlq1]
  exact ((Scheme.Hom.comp_apply lq _ _).symm.trans
    (congrArg (fun φ : Spec (.of ↥B) ⟶ _ => φ (IsLocalRing.closedPoint ↥B)) heq)).trans hln1

theorem wcpa_dj_lr1k_nsr_nlb_ue_normal_integral : ∀ (C Y : Scheme.{u})
    [AlgebraicGeometry.IsIntegral C] (f : C ⟶ Y) [QuasiCompact f] [QuasiSeparated f]
    [IsAffineHom f] (K₀ : Type u) [Field K₀] (sC : C ⟶ Spec (.of K₀))
    [SmoothOfRelativeDimension 1 sC]
    (q : ↥f.normalization) (K : Subfield C.functionField) (ε : C.functionField)
    (P Q : Polynomial K),
    P.Monic → Polynomial.aeval ε P = 0 →
    (∀ i < P.natDegree, wcUeReg f (f.fromNormalization q) (P.coeff i : C.functionField)) →
    Q.Monic → Polynomial.aeval (ε * (1 - ε)) Q = 0 →
    (∀ i < Q.natDegree, wcUeMax f (f.fromNormalization q) (Q.coeff i : C.functionField)) →
    wcUeReg f.toNormalization q ε ∧ wcUeMax f.toNormalization q (ε * (1 - ε)) :=
by
  intro C Y _ f _ _ _ K₀ _ sC _ q K ε P Q hPm hPε hPc hQm hQε hQc

  have s5 : ∀ (R S L : Type u) [CommRing R] [CommRing S] [CommRing L] [Algebra R S]
      (M : Submonoid R) [IsLocalization M S] (j : R →+* L) (g : S →+* L),
      g.comp (algebraMap R S) = j → (∀ x : L, j.IsIntegralElem x → ∃ r : R, j r = x) →
      ∀ x : L, g.IsIntegralElem x → ∃ s : S, g s = x := by
    intro R S L _ _ _ _ M _ j g hgj hR x hx
    letI : Algebra R L := j.toAlgebra
    letI : Algebra S L := g.toAlgebra
    have e : ∀ a, g (algebraMap R S a) = j a := fun a => by rw [← hgj]; rfl
    haveI : IsScalarTower R S L := IsScalarTower.of_algebraMap_eq (fun r => (e r).symm)
    obtain ⟨m, hm⟩ := IsIntegral.exists_multiple_integral_of_isLocalization M x hx
    obtain ⟨r, hr⟩ := hR _ hm
    refine ⟨IsLocalization.mk' S r m, ?_⟩
    have hu : IsUnit (g (algebraMap R S m)) := (IsLocalization.map_units S m).map g
    have h1 : g (IsLocalization.mk' S r m) * g (algebraMap R S m) = g (algebraMap R S r) := by
      rw [← map_mul, IsLocalization.mk'_spec]
    rw [Submonoid.smul_def, Algebra.smul_def] at hr
    apply hu.mul_right_cancel
    rw [h1, e, e]
    exact hr.trans (mul_comm _ _)

  have s4 : ∀ (V : C.Opens) [Nonempty V], IsAffineOpen V →
      (∀ c : C, IsIntegrallyClosed (C.presheaf.stalk c)) → IsIntegrallyClosed Γ(C, V) := by
    intro V _ hV hCn
    haveI : IsDomain Γ(C, V) := IsIntegral.component_integral V
    apply IsIntegrallyClosed.of_localization_maximal
    intro p _ hp
    let y : PrimeSpectrum Γ(C, V) := ⟨p, hp.isPrime⟩
    have hy : hV.fromSpec y ∈ V := by
      show hV.fromSpec y ∈ (V : Set C)
      rw [← hV.range_fromSpec]; exact ⟨y, rfl⟩
    letI : Algebra Γ(C, V) (C.presheaf.stalk (hV.fromSpec y)) :=
      TopCat.Presheaf.algebra_section_stalk C.presheaf ⟨hV.fromSpec y, hy⟩
    haveI : IsLocalization.AtPrime (C.presheaf.stalk (hV.fromSpec y)) p :=
      hV.isLocalization_stalk' y hy
    haveI := hCn (hV.fromSpec y)
    exact IsIntegrallyClosed.of_equiv (IsLocalization.algEquiv p.primeCompl
      (C.presheaf.stalk (hV.fromSpec y)) (Localization.AtPrime p)).toRingEquiv

  have hq : f.toNormalization (genericPoint C) ⤳ q := by
    have hd : DenseRange f.toNormalization := f.toNormalization.denseRange
    have hsub : Set.range f.toNormalization ⊆ closure {f.toNormalization (genericPoint C)} := by
      rintro _ ⟨c, rfl⟩
      exact specializes_iff_mem_closure.mp
        (((genericPoint_spec C).specializes (Set.mem_univ c)).map f.toNormalization.continuous)
    rw [specializes_iff_mem_closure]
    exact closure_minimal hsub isClosed_closure (by rw [hd.closure_range]; trivial)

  have s6 : ∀ (U : Y.Opens), IsAffineOpen U → IsIntegrallyClosed Γ(C, f ⁻¹ᵁ U) →
      ∀ (hW : f.toNormalization (genericPoint C) ∈ f.fromNormalization ⁻¹ᵁ U) (x : C.functionField),
      ((f.normalization.presheaf.germ (f.fromNormalization ⁻¹ᵁ U)
        (f.toNormalization (genericPoint C)) hW ≫
          f.toNormalization.stalkMap (genericPoint C)).hom).IsIntegralElem x →
      ∃ r : Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U),
        (f.normalization.presheaf.germ (f.fromNormalization ⁻¹ᵁ U)
          (f.toNormalization (genericPoint C)) hW ≫
          f.toNormalization.stalkMap (genericPoint C)).hom r = x := by
    intro U hU hB hW x hx
    have hηV : genericPoint C ∈ f ⁻¹ᵁ U := by
      have : f.fromNormalization (f.toNormalization (genericPoint C)) = f (genericPoint C) := by
        rw [← Scheme.Hom.comp_apply, Scheme.Hom.toNormalization_fromNormalization]
      rw [Scheme.Hom.mem_preimage, ← this]; exact hW
    haveI : Nonempty (f ⁻¹ᵁ U) := ⟨⟨_, hηV⟩⟩
    have hV : IsAffineOpen (f ⁻¹ᵁ U) := hU.preimage f
    haveI := functionField_isFractionRing_of_isAffineOpen C (f ⁻¹ᵁ U) hV
    have hφg : algebraMap Γ(C, f ⁻¹ᵁ U) C.functionField =
        (C.presheaf.germ (f ⁻¹ᵁ U) (genericPoint C) hηV).hom := rfl
    have hφinj : Function.Injective (algebraMap Γ(C, f ⁻¹ᵁ U) C.functionField) := by
      rw [hφg]; exact germ_injective_of_isIntegral C _ hηV
    have hle : f ⁻¹ᵁ U ≤ f.toNormalization ⁻¹ᵁ (f.fromNormalization ⁻¹ᵁ U) := by
      intro c hc
      have : f.fromNormalization (f.toNormalization c) = f c := by
        rw [← Scheme.Hom.comp_apply, Scheme.Hom.toNormalization_fromNormalization]
      show f.fromNormalization (f.toNormalization c) ∈ U
      rw [this]; exact hc
    set ρ := f.toNormalization.appLE (f.fromNormalization ⁻¹ᵁ U) (f ⁻¹ᵁ U) hle with hρ
    have hmor : ρ ≫ C.presheaf.germ (f ⁻¹ᵁ U) (genericPoint C) hηV =
        f.normalization.presheaf.germ _ _ hW ≫ f.toNormalization.stalkMap (genericPoint C) := by
      rw [Scheme.Hom.germ_stalkMap, hρ, Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
    set j := (f.normalization.presheaf.germ (f.fromNormalization ⁻¹ᵁ U)
        (f.toNormalization (genericPoint C)) hW ≫
          f.toNormalization.stalkMap (genericPoint C)).hom with hj
    have hjφ : (algebraMap Γ(C, f ⁻¹ᵁ U) C.functionField).comp ρ.hom = j := by
      rw [hφg, hj, ← hmor]; rfl
    letI : Algebra Γ(Y, U) Γ(C, f ⁻¹ᵁ U) := (f.app U).hom.toAlgebra
    have hfac := f.normalizationObjIso_hom_val hU
    set ψ := f.normalizationObjIso hU with hψ
    have hρψ : (algebraMap (integralClosure Γ(Y, U) Γ(C, f ⁻¹ᵁ U)) Γ(C, f ⁻¹ᵁ U)).comp
        ψ.hom.hom = ρ.hom := by
      rw [hρ, ← hfac]; rfl
    obtain ⟨p, hpm, hp⟩ := hx
    have hxB : IsIntegral Γ(C, f ⁻¹ᵁ U) x := by
      refine ⟨p.map ρ.hom, hpm.map _, ?_⟩
      rw [Polynomial.eval₂_map, hjφ]; exact hp
    obtain ⟨c, hc⟩ := (IsIntegrallyClosed.isIntegral_iff (R := Γ(C, f ⁻¹ᵁ U))).mp hxB
    have hcS : IsIntegral (integralClosure Γ(Y, U) Γ(C, f ⁻¹ᵁ U)) c := by
      refine ⟨p.map ψ.hom.hom, hpm.map _, ?_⟩
      apply hφinj
      rw [Polynomial.hom_eval₂, Polynomial.eval₂_map, hc, map_zero, RingHom.comp_assoc, hρψ, hjφ]
      exact hp
    have hcA : IsIntegral Γ(Y, U) c := isIntegral_trans c hcS
    refine ⟨ψ.inv.hom ⟨c, hcA⟩, ?_⟩
    rw [← hjφ, RingHom.comp_apply, ← hρψ, RingHom.comp_apply]
    have : ψ.hom.hom (ψ.inv.hom ⟨c, hcA⟩) = ⟨c, hcA⟩ := by
      rw [← CommRingCat.comp_apply, ψ.inv_hom_id, CommRingCat.id_apply]
    rw [this]
    exact hc

  have s8 : ∀ (S : Type u) [CommRing S] (G : S →+* C.functionField) (P : Polynomial K)
      (t : ℕ → S) (x : C.functionField), P.Monic → Polynomial.aeval x P = 0 →
      (∀ i < P.natDegree, G (t i) = (P.coeff i : C.functionField)) →
      G.IsIntegralElem x ∧ ∀ y : S, G y = x →
        G (y ^ P.natDegree + ∑ i ∈ Finset.range P.natDegree, t i * y ^ i) = 0 := by
    intro S _ G P t x hPm hPx ht
    have hev : x ^ P.natDegree + ∑ i ∈ Finset.range P.natDegree,
        (P.coeff i : C.functionField) * x ^ i = 0 := by
      have h := hPx
      rw [hPm.as_sum, map_add, map_sum, Polynomial.aeval_X_pow] at h
      simp only [map_mul, Polynomial.aeval_C, Polynomial.aeval_X_pow] at h
      exact h
    have hev' : x ^ P.natDegree + ∑ i ∈ Finset.range P.natDegree, G (t i) * x ^ i = 0 := by
      rw [← hev]
      congr 1
      exact Finset.sum_congr rfl (fun i hi => by rw [ht i (Finset.mem_range.mp hi)])
    refine ⟨?_, ?_⟩
    · refine ⟨Polynomial.X ^ P.natDegree + ∑ i ∈ Finset.range P.natDegree,
        Polynomial.C (t i) * Polynomial.X ^ i, ?_, ?_⟩
      · apply Polynomial.monic_X_pow_add
        refine lt_of_le_of_lt (Polynomial.degree_sum_le _ _) ?_
        rw [Finset.sup_lt_iff (WithBot.bot_lt_coe _)]
        intro i hi
        exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_pow_le _ _)
          (by exact_mod_cast Finset.mem_range.mp hi)
      · simp only [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finset_sum,
          Polynomial.eval₂_mul, Polynomial.eval₂_C]
        exact hev'
    · intro y hy
      simp only [map_add, map_sum, map_mul, map_pow, hy]
      exact hev'

  have s9 : ∀ (S : Type u) [CommRing S] [IsLocalRing S] (G : S →+* C.functionField) (w : S)
      (m : ℕ) (t : ℕ → S), (∀ i < m, t i ∈ IsLocalRing.maximalIdeal S) →
      G (w ^ m + ∑ i ∈ Finset.range m, t i * w ^ i) = 0 → w ∈ IsLocalRing.maximalIdeal S := by
    intro S _ _ G w m t ht hz
    by_contra hw
    have hu : IsUnit w := IsLocalRing.notMem_maximalIdeal.mp hw
    set winv : S := ↑hu.unit⁻¹ with hwinv_def
    have hwinv : w * winv = 1 := hu.mul_val_inv
    set s : S := ∑ i ∈ Finset.range m, t i * (w ^ i * winv ^ m) with hs_def
    have hs : s ∈ IsLocalRing.maximalIdeal S := by
      apply Ideal.sum_mem
      intro i hi
      exact Ideal.mul_mem_right _ _ (ht i (Finset.mem_range.mp hi))
    have hzs : w ^ m + ∑ i ∈ Finset.range m, t i * w ^ i = w ^ m * (1 + s) := by
      rw [hs_def, mul_add, mul_one, Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [show w ^ m * (t i * (w ^ i * winv ^ m)) = t i * w ^ i * (w * winv) ^ m by ring,
        hwinv, one_pow, mul_one]
    have h1s : IsUnit (1 + s) := by
      have := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits (-s)
        ((IsLocalRing.mem_maximalIdeal _).mp (neg_mem hs))
      rwa [sub_neg_eq_add] at this
    have hzu : IsUnit (w ^ m + ∑ i ∈ Finset.range m, t i * w ^ i) := by
      rw [hzs]; exact (hu.pow m).mul h1s
    have := hzu.map G
    rw [hz] at this
    exact not_isUnit_zero this

  have hCn : ∀ c : C, IsIntegrallyClosed (C.presheaf.stalk c) := fun c =>
    (wcpa_dj_lus_cvs_ct_fcn_smooth_stalk_normal K₀ C sC 1 c).2

  set G : f.normalization.presheaf.stalk q →+* C.functionField :=
    (f.normalization.presheaf.stalkSpecializes hq ≫
      f.toNormalization.stalkMap (genericPoint C)).hom with hG
  have hfη : f.fromNormalization (f.toNormalization (genericPoint C)) = f (genericPoint C) := by
    rw [← Scheme.Hom.comp_apply, Scheme.Hom.toNormalization_fromNormalization]
  have hp : f (genericPoint C) ⤳ f.fromNormalization q :=
    hfη ▸ hq.map f.fromNormalization.continuous

  have hlift : ∀ x : C.functionField, G.IsIntegralElem x → ∃ e, G e = x := by
    intro x hx
    obtain ⟨U, hU, hpU, -⟩ :=
      exists_isAffineOpen_mem_and_subset (x := f.fromNormalization q) (U := ⊤) trivial
    haveI : IsAffineHom f.fromNormalization :=
      (IsIntegralHom.iff_universallyClosed_and_isAffineHom.mp inferInstance).2
    have hWn : IsAffineOpen (f.fromNormalization ⁻¹ᵁ U) := hU.preimage f.fromNormalization
    have hqW : q ∈ f.fromNormalization ⁻¹ᵁ U := hpU
    have hW : f.toNormalization (genericPoint C) ∈ f.fromNormalization ⁻¹ᵁ U :=
      hq.mem_open (f.fromNormalization ⁻¹ᵁ U).isOpen hqW
    have hηV : genericPoint C ∈ f ⁻¹ᵁ U := by
      show f (genericPoint C) ∈ U
      rw [← hfη]; exact hW
    haveI : Nonempty (f ⁻¹ᵁ U) := ⟨⟨_, hηV⟩⟩
    have hB := s4 (f ⁻¹ᵁ U) (hU.preimage f) hCn
    have hR := s6 U hU hB hW
    letI : Algebra Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U)
        (f.normalization.presheaf.stalk q) :=
      TopCat.Presheaf.algebra_section_stalk f.normalization.presheaf ⟨q, hqW⟩
    haveI : IsLocalization.AtPrime (f.normalization.presheaf.stalk q)
        (hWn.primeIdealOf ⟨q, hqW⟩).asIdeal := hWn.isLocalization_stalk ⟨q, hqW⟩
    refine s5 _ _ _ (hWn.primeIdealOf ⟨q, hqW⟩).asIdeal.primeCompl _ G ?_ hR x hx
    rw [hG]
    apply RingHom.ext
    intro r
    change (f.normalization.presheaf.germ _ q hqW ≫ f.normalization.presheaf.stalkSpecializes hq ≫
      f.toNormalization.stalkMap (genericPoint C)).hom r = _
    rw [← Category.assoc, TopCat.Presheaf.germ_stalkSpecializes]

  have htex : ∀ i, ∃ s : Y.presheaf.stalk (f.fromNormalization q), i < P.natDegree →
      (wcLr1uGerm f (f.fromNormalization q) hp).hom s = (P.coeff i : C.functionField) := by
    intro i
    by_cases hi : i < P.natDegree
    · obtain ⟨_, s, hs⟩ := hPc i hi
      exact ⟨s, fun _ => hs⟩
    · exact ⟨0, fun h => absurd h hi⟩
  choose t ht using htex
  have huex : ∀ i, ∃ s : Y.presheaf.stalk (f.fromNormalization q), i < Q.natDegree →
      s ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk (f.fromNormalization q)) ∧
      (wcLr1uGerm f (f.fromNormalization q) hp).hom s = (Q.coeff i : C.functionField) := by
    intro i
    by_cases hi : i < Q.natDegree
    · obtain ⟨_, s, hsm, hs⟩ := hQc i hi
      exact ⟨s, fun _ => ⟨hsm, hs⟩⟩
    · exact ⟨0, fun h => absurd h hi⟩
  choose u hu using huex

  have s3 : ∀ (h : C ⟶ Y) (he : f.toNormalization ≫ f.fromNormalization = h)
      (hy : h (genericPoint C) ⤳ f.fromNormalization q)
      (s : Y.presheaf.stalk (f.fromNormalization q)),
      (Y.presheaf.stalkSpecializes hy ≫ h.stalkMap (genericPoint C)).hom s =
        (f.normalization.presheaf.stalkSpecializes hq ≫
          f.toNormalization.stalkMap (genericPoint C)).hom
            ((f.fromNormalization.stalkMap q).hom s) := by
    intro h he hy s
    subst he
    have key := congrArg (fun φ => (φ ≫ f.toNormalization.stalkMap (genericPoint C)).hom s)
      (Scheme.Hom.stalkSpecializes_stalkMap f.fromNormalization
        (f.toNormalization (genericPoint C)) q hq)
    rw [Scheme.Hom.stalkMap_comp]
    exact key
  have hsq : ∀ s : Y.presheaf.stalk (f.fromNormalization q),
      G ((f.fromNormalization.stalkMap q).hom s) =
        (wcLr1uGerm f (f.fromNormalization q) hp).hom s :=
    fun s => (s3 f (Scheme.Hom.toNormalization_fromNormalization f) hp s).symm

  obtain ⟨hint, -⟩ := s8 _ G P (fun i => (f.fromNormalization.stalkMap q).hom (t i)) ε hPm hPε
    (fun i hi => (hsq _).trans (ht i hi))
  obtain ⟨e, he⟩ := hlift ε hint
  refine ⟨⟨hq, e, he⟩, ?_⟩

  have hw : G (e * (1 - e)) = ε * (1 - ε) := by rw [map_mul, map_sub, map_one, he]
  obtain ⟨-, h2⟩ := s8 _ G Q (fun i => (f.fromNormalization.stalkMap q).hom (u i)) (ε * (1 - ε))
    hQm hQε (fun i hi => (hsq _).trans (hu i hi).2)
  have hwm := s9 _ G (e * (1 - e)) Q.natDegree
    (fun i => (f.fromNormalization.stalkMap q).hom (u i))
    (fun i hi => (IsLocalRing.mem_maximalIdeal _).mpr ((map_mem_nonunits_iff _ _).mpr
      ((IsLocalRing.mem_maximalIdeal _).mp (hu i hi).1)))
    (h2 _ hw)
  exact ⟨hq, e * (1 - e), hwm, hw⟩

theorem wcpa_dj_lr1k_nsr_nlb_ue_fibre_connected : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C]
    (γ : C ⟶ wcProjK Ω 1) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
    [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)]
    (y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX)) (τ : (Spec (.of ↥W) ⟶ X) → ↥W),
    wcNsrNlbHyp W γ uX ι y₀ τ →
    ∀ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W),
      wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a →
    ∀ (X₁ : Scheme.{u}) (r₁ : X₁ ⟶ X) (ι₁ : wcProjK Ω 1 ⟶ X₁)
      [QuasiCompact (γ ≫ ι₁)] [QuasiSeparated (γ ≫ ι₁)] (hι : ι₁ ≫ r₁ = ι),
      wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a) r₁ →
      wcpaDjLkModel W (r₁ ≫ uX) ι₁ →
      PreconnectedSpace ↥(⇑(wcUePi γ ι ι₁ r₁ hι) ⁻¹' {wcNdPt W (γ ≫ ι) uX y₀}) ∧
        (irreducibleComponents
          ↥(⇑(wcUePi γ ι ι₁ r₁ hι) ⁻¹' {wcNdPt W (γ ≫ ι) uX y₀})).Finite :=
by
  have s1 (A : Type u) [CommRing A] [IsLocalRing A] (R : Scheme.{u})
      [AlgebraicGeometry.IsIntegral R] (g : R ⟶ Spec (.of A)) [IsProper g]
      (hint : ∀ f : ↥(R.presheaf.stalk (genericPoint ↥R)),
        ((R.presheaf.germ ⊤ (genericPoint ↥R) trivial).hom.comp
          (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)).IsIntegralElem f →
        ∃ a : A, ((R.presheaf.germ ⊤ (genericPoint ↥R) trivial).hom.comp
          (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) a = f) :
      _root_.IsPreconnected (g ⁻¹' {IsLocalRing.closedPoint A}) := by
    have hunit : ∀ x : R, g x = IsLocalRing.closedPoint A → ∀ c : A,
        x ∈ R.basicOpen ((g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom) c) ↔ IsUnit c := by
      intro x hx c
      have h1 := Scheme.preimage_basicOpen_top g ((Scheme.ΓSpecIso (.of A)).inv.hom c)
      rw [RingHom.comp_apply]
      change x ∈ R.basicOpen ((ConcreteCategory.hom g.appTop) _) ↔ _
      rw [← h1, Scheme.Hom.mem_preimage, hx]
      change IsLocalRing.closedPoint A ∈ (Spec (CommRingCat.of A)).basicOpen
        ((ConcreteCategory.hom (Scheme.ΓSpecIso (CommRingCat.of A)).inv) c) ↔ _
      rw [basicOpen_eq_of_affine]
      exact (PrimeSpectrum.mem_basicOpen c (IsLocalRing.closedPoint A)).trans
        IsLocalRing.notMem_maximalIdeal
    have hFcl : IsClosed (g ⁻¹' {IsLocalRing.closedPoint A}) :=
      (IsLocalRing.isClosed_singleton_closedPoint A).preimage g.continuous
    rw [isPreconnected_closed_iff]
    intro t t' ht ht' hsub hne hne'
    by_contra hdisj
    obtain ⟨β, hB1, hB2⟩ := wc_proper_local_closed_fibre_clopen_lift A R g
      (g ⁻¹' {IsLocalRing.closedPoint A} ∩ t) (g ⁻¹' {IsLocalRing.closedPoint A} ∩ t')
      (hFcl.inter ht) (hFcl.inter ht')
      (Set.disjoint_left.mpr fun x hx hx' => hdisj ⟨x, hx.1, hx.2, hx'.2⟩)
      (by rw [← Set.inter_union_distrib_left]; exact Set.inter_eq_left.mpr hsub)
    have hsurj : Function.Surjective (Scheme.ΓSpecIso (.of A)).inv.hom := by
      intro y
      exact ⟨(Scheme.ΓSpecIso (.of A)).hom.hom y, by simp⟩
    have hφint : (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom).IsIntegral :=
      RingHom.IsIntegral.trans _ _ (RingHom.isIntegral_of_surjective _ hsurj)
        (isIntegral_appTop_of_universallyClosed g)
    have hβ := (hφint β).map (R.presheaf.germ ⊤ (genericPoint ↥R) trivial).hom
    obtain ⟨a, ha⟩ := hint _ hβ
    have hφa : (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom) a = β :=
      germ_injective_of_isIntegral R (U := ⊤) (genericPoint R) trivial ha
    obtain ⟨x₁, hx₁F, hx₁t⟩ := hne
    obtain ⟨x₂, hx₂F, hx₂t⟩ := hne'
    have n1 := hB1 x₁ ⟨hx₁F, hx₁t⟩
    have n2 := hB2 x₂ ⟨hx₂F, hx₂t⟩
    have e1 : (1 : Γ(R, ⊤)) - β = (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom) (1 - a) := by
      rw [map_sub, map_one, hφa]
    rw [e1, hunit x₁ hx₁F] at n1
    rw [← hφa, hunit x₂ hx₂F] at n2
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self a with h | h
    · exact n2 h
    · exact n1 h
  have s3 (C Y N : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] [AlgebraicGeometry.IsIntegral Y]
      [AlgebraicGeometry.IsIntegral N] (t₁ : C ⟶ Y) (t : C ⟶ N) (p : Y ⟶ N) [IsOpenImmersion t₁]
      [IsOpenImmersion t] (h : t₁ ≫ p = t) :
      p (genericPoint ↥Y) = genericPoint ↥N ∧ IsIso (p.stalkMap (genericPoint ↥Y)) := by
    have e₁ := genericPoint_eq_of_isOpenImmersion t₁
    have e := genericPoint_eq_of_isOpenImmersion t
    have hgen : p (genericPoint ↥Y) = genericPoint ↥N := by
      rw [← e₁, ← Scheme.Hom.comp_apply, h, e]
    refine ⟨hgen, ?_⟩
    have h1 : IsIso ((t₁ ≫ p).stalkMap (genericPoint C)) := by
      rw [Scheme.Hom.stalkMap_congr_hom (t₁ ≫ p) t h]; infer_instance
    rw [Scheme.Hom.stalkMap_comp] at h1
    have h2 : IsIso (p.stalkMap (t₁ (genericPoint C))) :=
      @IsIso.of_isIso_comp_right _ _ _ _ _ _ _ _ h1
    have key : ∀ y : Y, y = genericPoint Y → IsIso (p.stalkMap y) →
        IsIso (p.stalkMap (genericPoint Y)) := by
      rintro y rfl hy; exact hy
