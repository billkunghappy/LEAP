        (A.presheaf.germ ⊤ a trivial).hom ((f ≫ k).appTop.hom t) := by
    intro A B Z f k t a
    exact hgermc f k ⊤ t a trivial trivial
  have hcong : ∀ {A Z : Scheme.{u}} (F F' : A ⟶ Z), F = F' → ∀ (O : Z.Opens) (t : Γ(Z, O))
