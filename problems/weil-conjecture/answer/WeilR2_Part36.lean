          have h1 : A.valuation (φ μ₂) = A.valuation (φ μ₁) * A.valuation ε ^ (j + 1) := by
            apply mul_right_cancel₀ (pow_ne_zero k₂ he)
            rw [← heq, mul_assoc, ← pow_add, show j + 1 + k₂ = k₂ + j + 1 by omega]
