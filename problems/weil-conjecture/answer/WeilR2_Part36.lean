        rw [← hcond, Scheme.Hom.comp_apply, hηq, hgen]
      have hspec : ((ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)) ≫ N.fromSpecStalk n)
          (genericPoint R) ⤳ genericPoint N := by rw [hηN]
      let j : N.functionField →+* R.presheaf.stalk (genericPoint R) :=
        ((N.presheaf.stalkSpecializes hspec) ≫
          ((ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)) ≫ N.fromSpecStalk n).stalkMap
            (genericPoint R)).hom
