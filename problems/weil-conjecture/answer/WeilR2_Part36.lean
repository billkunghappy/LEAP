  have s1 : ∀ (A B G : Type u) [CommRing A] [CommRing B] [Group G] [Finite G] (φ : A →+* B)
      (ψ : G → B →+* B), (∀ b, ψ 1 b = b) → (∀ g h b, ψ (g * h) b = ψ h (ψ g b)) →
      (∀ g a, ψ g (φ a) = φ a) → (∀ b, (∀ g, ψ g b = b) → ∃ a, φ a = b) →
      ∀ P P' : Ideal B, P.IsPrime → P'.IsPrime → P.comap φ = P'.comap φ →
      ∃ g, P' = P.comap (ψ g) := by
    intro A B G _ _ _ _ φ ψ h1 h2 h3 h4 P P' hP hP' hc
    letI : Algebra A B := φ.toAlgebra
    letI : MulSemiringAction G B :=
      { smul := fun g b => ψ g⁻¹ b
        one_smul := fun b => by show ψ 1⁻¹ b = b; rw [inv_one, h1]
        mul_smul := fun g h b => by
          show ψ (g * h)⁻¹ b = ψ g⁻¹ (ψ h⁻¹ b); rw [mul_inv_rev, h2]
        smul_zero := fun g => map_zero (ψ g⁻¹)
        smul_add := fun g x y => map_add (ψ g⁻¹) x y
        smul_one := fun g => map_one (ψ g⁻¹)
        smul_mul := fun g x y => map_mul (ψ g⁻¹) x y }
    haveI : SMulCommClass G A B := ⟨fun g a b => by
      show ψ g⁻¹ (φ a * b) = φ a * ψ g⁻¹ b
