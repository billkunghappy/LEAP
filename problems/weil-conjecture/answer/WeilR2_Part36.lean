      obtain ⟨c, hc⟩ := hresv z0
      rw [hσ c] at hc
      refine ⟨Ideal.Quotient.mk 𝔭 (q (Ideal.Quotient.mk _ (MvPolynomial.C c))), ?_⟩
      show Ideal.Quotient.mk Jv z0 - Ideal.Quotient.mk Jv (θ _) ∈ _
      rw [hθC, ← map_sub]
      obtain ⟨y, hy, t, ht, hyt⟩ := Submodule.mem_sup.mp hc
      obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp ht
      refine Ideal.mem_span_singleton'.mpr ⟨Ideal.Quotient.mk Jv r, ?_⟩
      rw [← hyt, map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hy, zero_add, ← hr, map_mul])
  obtain ⟨c', hc'⟩ := hdvd1 u
  have hXv : X * v ∈ (IsLocalRing.maximalIdeal ↥W).map σ := by
    rw [hX_def, hc', mul_comm u c', mul_assoc, huv]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem σ hgm)
  have hσθ : (IsLocalRing.maximalIdeal ↥W).map σ ≤ Ideal.map θ 𝔭 := by
    have e : σ = θ.comp (q.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) :=
      RingHom.ext fun c => (hθC c).symm
    rw [e, ← Ideal.map_map]
    exact Ideal.map_mono le_sup_left
  have hXJ : ∀ t ∈ Jv, X * t ∈ Ideal.map θ 𝔭 := by
    intro t ht
    obtain ⟨y, hy, s, hs, hys⟩ := Submodule.mem_sup.mp ht
    obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp hs
    rw [← hys, ← hr, mul_add]
    refine Ideal.add_mem _ (hσθ (Ideal.mul_mem_left _ _ hy)) ?_
    have e : X * (r * v) = r * (X * v) := by ring
    rw [e]
    exact hσθ (Ideal.mul_mem_left _ _ hXv)
  have hrank := wcNd_rank_le_of_fibre_span Q P θ hθfin 𝔭 h𝔭P (Fintype.card ↥I)
    (fun i => X * u ^ (i : ℕ)) (q (Ideal.Quotient.mk _ (MvPolynomial.X 0))) hx𝔭
    (fun z => by
      obtain ⟨a, ha⟩ := hspan (Ideal.Quotient.mk Jv z)
      let b : Fin (Fintype.card ↥I) → Q := fun i => (Ideal.Quotient.mk_surjective (a i)).choose
      have hb : ∀ i, Ideal.Quotient.mk 𝔭 (b i) = a i := fun i =>
        (Ideal.Quotient.mk_surjective (a i)).choose_spec
      refine ⟨b, ?_⟩
      have hmem : z - ∑ i, θ (b i) * u ^ (i : ℕ) ∈ Jv := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, ha, map_sum]
        rw [sub_eq_zero]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [map_mul, map_pow, ← hb i]
        rfl
      have e : θ (q (Ideal.Quotient.mk _ (MvPolynomial.X 0))) * z -
          ∑ i, θ (b i) * (X * u ^ (i : ℕ)) = X * (z - ∑ i, θ (b i) * u ^ (i : ℕ)) := by
        rw [hθX0, mul_sub, Finset.mul_sum]
        congr 1
        exact Finset.sum_congr rfl (fun i _ => by ring)
      rw [e]
      exact hXJ _ hmem)
  exact ⟨hθinj, RingHom.IsIntegral.of_finite hθfin, hrank⟩

theorem wcNd_swap_norm_element : ∀ (P : Type u) [CommRing P] (I : Subgroup (P ≃+* P)) [Fintype ↥I] (Ju Jv : Ideal P) (u v : P) [IsDomain (P ⧸ Jv)] [IsDiscreteValuationRing (P ⧸ Jv)] [IsDomain (P ⧸ Ju)] [IsDiscreteValuationRing (P ⧸ Ju)], u ∈ Ju → v ∈ Jv → Irreducible (Ideal.Quotient.mk Jv u) → Irreducible (Ideal.Quotient.mk Ju v) → (∀ τ ∈ I, (Ideal.map τ Jv = Jv ∧ Ideal.map τ Ju = Ju) ∨ (Ideal.map τ Jv = Ju ∧ Ideal.map τ Ju = Jv)) → (∃ τ ∈ I, Ideal.map τ Jv = Ju) → ∃ (k : ℕ) (y y' : P), 0 < k ∧ 2 * k = Fintype.card ↥I ∧ (∀ τ ∈ I, τ (y + y') = y + y') ∧ y ∈ Ju ∧ y' ∈ Jv ∧ Associated (Ideal.Quotient.mk Jv y) (Ideal.Quotient.mk Jv u ^ k) ∧ Associated (Ideal.Quotient.mk Ju y') (Ideal.Quotient.mk Ju v ^ k) :=
by
  intro P _ I _ Ju Jv u v _ _ _ _ hu hv hirru hirrv hperm hex
  classical
  obtain ⟨τ0, hτ0I, hτ0J⟩ := hex
  have hne : Ju ≠ Jv := by
    intro h
    have hu' : u ∈ Jv := h ▸ hu
    exact hirru.ne_zero (Ideal.Quotient.eq_zero_iff_mem.mpr hu')
  have hmapmul : ∀ (a b : P ≃+* P) (J : Ideal P),
      Ideal.map (a * b) J = Ideal.map a (Ideal.map b J) := by
    intro a b J
    rw [← Ideal.map_coe, ← Ideal.map_coe a, ← Ideal.map_coe b, Ideal.map_map]; rfl
  have hperm' : ∀ τ : ↥I, (Ideal.map (τ : P ≃+* P) Jv = Jv ∧ Ideal.map (τ : P ≃+* P) Ju = Ju) ∨
      (Ideal.map (τ : P ≃+* P) Jv = Ju ∧ Ideal.map (τ : P ≃+* P) Ju = Jv) :=
    fun τ => hperm τ τ.2
  let q : ↥I → Prop := fun τ => Ideal.map (τ : P ≃+* P) Jv = Jv
  have hsign : ∀ g τ : ↥I, q (g * τ) ↔ (q g ↔ q τ) := by
    intro g τ
    show Ideal.map ((g : P ≃+* P) * (τ : P ≃+* P)) Jv = Jv ↔
      (Ideal.map (g : P ≃+* P) Jv = Jv ↔ Ideal.map (τ : P ≃+* P) Jv = Jv)
    rw [hmapmul]
    rcases hperm' τ with ⟨h1, _⟩ | ⟨h1, _⟩
    · rw [h1]; simp
    · rw [h1]
      rcases hperm' g with ⟨h3, h4⟩ | ⟨h3, h4⟩
      · rw [h4, h3]; simp
      · rw [h4, h3]; simp
  have hq1 : q 1 := by
    have h := hsign 1 1
    rw [mul_one] at h
    exact h.mpr Iff.rfl
  set H : Finset ↥I := Finset.univ.filter q with hH
  set S : Finset ↥I := Finset.univ.filter (fun τ => ¬ q τ) with hS
  set t0 : ↥I := ⟨τ0, hτ0I⟩ with ht0
  have hqt0 : ¬ q t0 := by
    intro h
    apply hne
    have h' : Ideal.map τ0 Jv = Jv := h
    rw [← hτ0J, h']
  have hcardHS : H.card = S.card := by
    apply Finset.card_nbij' (t0 * ·) (t0⁻¹ * ·)
    · intro a ha
      have ha' := (Finset.mem_filter.mp ha).2
      refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩
      rw [hsign]; tauto
    · intro a ha
      have ha' := (Finset.mem_filter.mp ha).2
      refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩
      have hinv := hsign t0 (t0⁻¹ * a)
      rw [mul_inv_cancel_left] at hinv
      tauto
    · intro a _
      exact inv_mul_cancel_left t0 a
    · intro a _
      exact mul_inv_cancel_left t0 a
  have hsum : H.card + S.card = Fintype.card ↥I := by
    rw [hH, hS, Finset.card_filter_add_card_filter_not, Finset.card_univ]
  have h1H : (1 : ↥I) ∈ H := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hq1⟩
  have ht0S : t0 ∈ S := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hqt0⟩
  have hHpos : 0 < H.card := Finset.card_pos.mpr ⟨1, h1H⟩
  have hHmem : ∀ τ ∈ H, Ideal.map (τ : P ≃+* P) Ju = Ju := by
    intro τ hτ
    have hq : Ideal.map (τ : P ≃+* P) Jv = Jv := (Finset.mem_filter.mp hτ).2
    rcases hperm' τ with ⟨_, h2⟩ | ⟨h1, _⟩
    · exact h2
    · exact absurd (h1.symm.trans hq) hne
  have hSmem : ∀ τ ∈ S, Ideal.map (τ : P ≃+* P) Jv = Ju ∧ Ideal.map (τ : P ≃+* P) Ju = Jv := by
    intro τ hτ
    have hq : ¬ Ideal.map (τ : P ≃+* P) Jv = Jv := (Finset.mem_filter.mp hτ).2
    rcases hperm' τ with ⟨h1, _⟩ | h
    · exact absurd h1 hq
    · exact h
  have htrans : ∀ (J J' : Ideal P) [IsDomain (P ⧸ J')] [IsDiscreteValuationRing (P ⧸ J')]
      (τ : P ≃+* P) (a b : P), Ideal.map τ J = J' → Irreducible (Ideal.Quotient.mk J a) →
      Irreducible (Ideal.Quotient.mk J' b) →
      Associated (Ideal.Quotient.mk J' (τ a)) (Ideal.Quotient.mk J' b) := by
    intro J J' _ _ τ a b h ha hb
    let e : P ⧸ J ≃+* P ⧸ J' := Ideal.quotientEquiv J J' τ (by rw [← h]; rfl)
    have he : e (Ideal.Quotient.mk J a) = Ideal.Quotient.mk J' (τ a) :=
      Ideal.quotientEquiv_mk _ _ _ _ a
    have h1 : Irreducible (Ideal.Quotient.mk J' (τ a)) := by
      rw [← he]; exact (MulEquiv.irreducible_iff e).mpr ha
    exact IsDiscreteValuationRing.associated_of_irreducible _ h1 hb
  have hreindex : ∀ (g : ↥I) (A B : Finset ↥I), (∀ τ, τ ∈ A ↔ g * τ ∈ B) →
      ∏ τ ∈ A, ((g * τ : ↥I) : P ≃+* P) u = ∏ τ ∈ B, (τ : P ≃+* P) u := by
    intro g A B hAB
    apply Finset.prod_nbij' (g * ·) (g⁻¹ * ·)
    · intro a ha; exact (hAB a).mp ha
    · intro a ha
      apply (hAB _).mpr
      rw [mul_inv_cancel_left]; exact ha
    · intro a _; exact inv_mul_cancel_left g a
    · intro a _; exact mul_inv_cancel_left g a
    · intro a _; rfl
  refine ⟨H.card, ∏ τ ∈ H, (τ : P ≃+* P) u, ∏ τ ∈ S, (τ : P ≃+* P) u, hHpos, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · omega
  · intro g hg
    set g' : ↥I := ⟨g, hg⟩ with hg'
    have hyg : ∀ A : Finset ↥I, g (∏ τ ∈ A, (τ : P ≃+* P) u) =
        ∏ τ ∈ A, ((g' * τ : ↥I) : P ≃+* P) u := by
      intro A
      rw [map_prod]
      rfl
    rw [map_add, hyg, hyg]
    by_cases hqg : q g'
    · rw [hreindex g' H H, hreindex g' S S]
      · intro τ
        simp only [hS, Finset.mem_filter, Finset.mem_univ, true_and]
        rw [hsign]; tauto
      · intro τ
        simp only [hH, Finset.mem_filter, Finset.mem_univ, true_and]
        rw [hsign]; tauto
    · rw [hreindex g' H S, hreindex g' S H, add_comm]
      · intro τ
        simp only [hH, hS, Finset.mem_filter, Finset.mem_univ, true_and]
        rw [hsign]; tauto
      · intro τ
        simp only [hH, hS, Finset.mem_filter, Finset.mem_univ, true_and]
        rw [hsign]; tauto
  · refine Ideal.prod_mem Ju h1H ?_
    rw [← hHmem 1 h1H]
    exact Ideal.mem_map_of_mem _ hu
  · refine Ideal.prod_mem Jv ht0S ?_
    rw [← (hSmem t0 ht0S).2]
    exact Ideal.mem_map_of_mem _ hu
  · rw [map_prod]
    have h := Associated.prod H (fun τ : ↥I => Ideal.Quotient.mk Jv ((τ : P ≃+* P) u))
      (fun _ => Ideal.Quotient.mk Jv u)
      (fun τ hτ => htrans Jv Jv τ u u (Finset.mem_filter.mp hτ).2 hirru hirru)
    rwa [Finset.prod_const] at h
  · rw [map_prod, hcardHS]
    have h := Associated.prod S (fun τ : ↥I => Ideal.Quotient.mk Ju ((τ : P ≃+* P) u))
      (fun _ => Ideal.Quotient.mk Ju v)
      (fun τ hτ => htrans Jv Ju τ u v (hSmem τ hτ).1 hirru hirrv)
    rwa [Finset.prod_const] at h

theorem wcNd_radical_map_maxIdeal : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (P : Type u) [CommRing P] [IsDomain P] [IsIntegrallyClosed P] (σ : ↥W →+* P) (z : P) (n : ℕ), z ^ (n + 1) ∈ (IsLocalRing.maximalIdeal ↥W).map σ → z ∈ (IsLocalRing.maximalIdeal ↥W).map σ :=
by
  intro Ω _ _ W P _ _ _ σ z n hz

  let J : Ideal P :=
    { carrier := {x | ∃ a : ↥W, a ∈ IsLocalRing.maximalIdeal ↥W ∧ ∃ p : P, x = σ a * p}
      zero_mem' := ⟨0, Ideal.zero_mem _, 0, by rw [mul_zero]⟩
      add_mem' := by
        rintro x y ⟨a, ha, p, rfl⟩ ⟨b, hb, q, rfl⟩
        rcases ValuationRing.dvd_total a b with ⟨t, rfl⟩ | ⟨t, rfl⟩
        · exact ⟨a, ha, p + σ t * q, by rw [map_mul]; ring⟩
        · exact ⟨b, hb, σ t * p + q, by rw [map_mul]; ring⟩
      smul_mem' := by
        rintro r x ⟨a, ha, p, rfl⟩
        exact ⟨a, ha, r * p, by rw [smul_eq_mul]; ring⟩ }
  have hle : (IsLocalRing.maximalIdeal ↥W).map σ ≤ J := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    exact ⟨a, ha, 1, by rw [mul_one]⟩
  obtain ⟨a, ha, p, hp⟩ := hle hz

  obtain ⟨c₀, hc₀⟩ := IsAlgClosed.exists_pow_nat_eq (a : Ω) (by omega : 0 < n + 1)
  have hc₀W : c₀ ∈ W := by
    by_cases h0 : c₀ = 0
    · rw [h0]; exact W.zero_mem
    · rcases W.mem_or_inv_mem c₀ with h | h
      · exact h
      · have e : (a : Ω) * c₀⁻¹ ^ n = c₀ := by
          rw [← hc₀, pow_succ', mul_assoc, ← mul_pow, mul_inv_cancel₀ h0, one_pow, mul_one]
        rw [← e]
        exact mul_mem a.2 (pow_mem h n)
  let c : ↥W := ⟨c₀, hc₀W⟩
  have hca : c ^ (n + 1) = a := by
    apply Subtype.ext
    rw [SubmonoidClass.coe_pow]
    exact hc₀
  have hc : c ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at ha
    exact ha (hca ▸ hu.pow (n + 1))

  have hdvd : σ c ^ (n + 1) ∣ z ^ (n + 1) := ⟨p, by rw [hp, ← map_pow, hca]⟩
  obtain ⟨r, hr⟩ := (IsIntegrallyClosed.pow_dvd_pow_iff (Nat.succ_ne_zero n)).mp hdvd
  rw [hr]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem σ hc)

theorem wcNd_model_norm_finite_injective : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (P : Type u) [CommRing P] (σ : ↥W →+* P), (wcNdModelA W P σ ∨ wcNdModelB W P σ) → ∀ (Q : Type u) [CommRing Q] (q : Polynomial ↥W →+* Q), wcNdIsHens (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C) Q q → ∀ θ : Q →+* P, IsLocalHom θ → (∀ c, θ (q (Polynomial.C c)) = σ c) → (∀ 𝔓 : Ideal P, 𝔓.IsPrime → (IsLocalRing.maximalIdeal ↥W).map σ ≤ 𝔓 → θ (q Polynomial.X) ∈ 𝔓 → ∀ z : P, ¬ IsUnit z → z ∈ 𝔓) → Function.Injective θ ∧ θ.Finite :=
by
  intro Ω _ _ W _hW _hWt P _ σ hP Q _ q hQ θ hθ hθC hH
  classical
  haveI hQh : HenselianLocalRing Q := hQ.1

  have Hprime : ∀ {A : Type u} [CommRing A] {p : Ideal A} {R : Type u} [CommRing R] {e : A →+* R},
      wcNdIsHens p R e → p.IsPrime := by
    intro A _ p R _ e he
    haveI : HenselianLocalRing R := he.1
    have hp : p = Ideal.comap e (IsLocalRing.maximalIdeal R) := by
      ext a
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, he.2.1 a, not_not]
    rw [hp]; exact Ideal.comap_isPrime _ _
  have hpA := Hprime hQ

  obtain ⟨hPh, hPdom, hσinj, J, hJp, hMJ, w, hw, hwJ, hres, A, iA, c₀, p, e, hc₀, hp, he, hec⟩ :
      HenselianLocalRing P ∧ IsDomain P ∧ Function.Injective σ ∧
      ∃ J : Ideal P, J.IsPrime ∧ (IsLocalRing.maximalIdeal ↥W).map σ ≤ J ∧
      ∃ w : P, ¬ IsUnit w ∧ w ∉ J ∧ (∀ z : P, ∃ c : ↥W, ¬ IsUnit (z - σ c)) ∧
      ∃ (A : Type u) (_ : CommRing A) (c₀ : ↥W →+* A) (p : Ideal A) (e : A →+* P),
        c₀.FiniteType ∧ p.IsPrime ∧ wcNdIsHens p P e ∧ e.comp c₀ = σ := by
    rcases hP with ⟨f, hfC, hf⟩ | ⟨g, hgm, hg0, f, hfC, hf⟩
    ·
      subst hfC
      haveI : HenselianLocalRing P := hf.1
      have hPd := (wcNd_hens_normal_domain (Polynomial ↥W) _ hpA P f hf).1
      obtain ⟨hdom, _hdvr, hirr, hres0⟩ := wcNd_typeA_special_fibre Ω W P f hf
      refine ⟨hf.1, hPd, ?_, _, (Ideal.Quotient.isDomain_iff_prime _).mp hdom, le_rfl,
        f Polynomial.X, ?_, ?_, ?_, Polynomial ↥W, inferInstance, Polynomial.C, _, f, ?_, hpA, hf, rfl⟩
      · obtain ⟨V, iV, hV, g₀, hg₀inj, hg₀u⟩ := wcNd_hne_valuation_witness (Polynomial ↥W) _ hpA
        obtain ⟨h, ⟨hhf, _⟩, _⟩ := hf.2.2 V hV g₀ hg₀u
        have e1 : ∀ c, g₀ (Polynomial.C c) = h ((f.comp Polynomial.C) c) := fun c => by
          rw [← hhf]; rfl
        intro a b hab
        exact Polynomial.C_injective (hg₀inj (by rw [e1, e1, hab]))
      · exact fun h => (hf.2.1 _).mp h (Ideal.mem_sup_left (Ideal.mem_span_singleton_self _))
      · exact fun h => hirr.ne_zero (Ideal.Quotient.eq_zero_iff_mem.mpr h)
      · intro z
        obtain ⟨c, hc⟩ := hres0 z
        exact ⟨c, hc⟩
      · rw [← Polynomial.algebraMap_eq]
        exact RingHom.finiteType_algebraMap.mpr inferInstance
    ·
      subst hfC
      haveI : HenselianLocalRing P := hf.1
      haveI := (wcNd_nodal_poly_normal Ω W g hg0).1
      haveI := (wcNd_nodal_poly_normal Ω W g hg0).2
      have hpB := Hprime hf
      have hPd := (wcNd_hens_normal_domain _ _ hpB P f hf).1
      obtain ⟨hJp0, _hdom, _hdvr, hirr, hres0⟩ := wcNd_nodal_branch_dvr Ω W g hgm P f hf 0 1 (by decide)
      have hu : ¬ IsUnit (f (Ideal.Quotient.mk _ (MvPolynomial.X 0))) := fun h =>
        ((hf.2.1 _).mp h) (Ideal.mem_map_of_mem _ (Ideal.mem_sup_left
          (Ideal.subset_span (Set.mem_insert _ _))))
      refine ⟨hf.1, hPd, ?_, _, hJp0, le_sup_left, f (Ideal.Quotient.mk _ (MvPolynomial.X 0)), hu,
        fun h => hirr.ne_zero (Ideal.Quotient.eq_zero_iff_mem.mpr h), ?_,
        _, inferInstance, ((Ideal.Quotient.mk _).comp MvPolynomial.C), _, f, ?_, hpB, hf, rfl⟩
      · obtain ⟨V, iV, hV, g₀, hg₀inj, hg₀u⟩ := wcNd_hne_valuation_witness _ _ hpB
        obtain ⟨h, ⟨hhf, _⟩, _⟩ := hf.2.2 V hV g₀ hg₀u
        have H₁ : ∀ a ∈ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g},
            MvPolynomial.eval₂Hom (RingHom.id ↥W) (![1, g] : Fin 2 → ↥W) a = 0 := by
          intro a ha
          obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp ha
          rw [map_mul, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
            MvPolynomial.eval₂Hom_C]
          simp
        let ev₁ := Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom (RingHom.id ↥W) (![1, g] : Fin 2 → ↥W)) H₁
        have hev : ∀ c, ev₁ (Ideal.Quotient.mk _ (MvPolynomial.C c)) = c := fun c => by
          simp only [ev₁, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C, RingHom.id_apply]
        have e1 : ∀ c, g₀ (Ideal.Quotient.mk _ (MvPolynomial.C c)) =
            h ((f.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) c) := fun c => by
          rw [← hhf]; rfl
        intro a b hab
        have h2 := congrArg ev₁ (hg₀inj (show g₀ (Ideal.Quotient.mk _ (MvPolynomial.C a)) =
          g₀ (Ideal.Quotient.mk _ (MvPolynomial.C b)) by rw [e1, e1, hab]))
        rwa [hev, hev] at h2
      · intro z
        obtain ⟨c, hc⟩ := hres0 z
        refine ⟨c, ?_⟩
        have hle : (IsLocalRing.maximalIdeal ↥W).map (f.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ⊔
            Ideal.span {f (Ideal.Quotient.mk _ (MvPolynomial.X 1))} ⊔
            Ideal.span {f (Ideal.Quotient.mk _ (MvPolynomial.X 0))} ≤ IsLocalRing.maximalIdeal P :=
          sup_le (IsLocalRing.le_maximalIdeal hJp0.ne_top)
            ((Ideal.span_singleton_le_iff_mem _).mpr
              ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hu)))
        have h3 := hle hc
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h3
        exact h3
      · exact RingHom.FiniteType.comp (RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective)
          (by rw [← MvPolynomial.algebraMap_eq]; exact RingHom.finiteType_algebraMap.mpr inferInstance)
  haveI := hPh
  haveI := hPdom
  obtain ⟨x, hx⟩ : ∃ x, θ (q Polynomial.X) = x := ⟨_, rfl⟩
  have hqX : ¬ IsUnit (q Polynomial.X) := fun h =>
    (hQ.2.1 _).mp h (Ideal.mem_sup_left (Ideal.mem_span_singleton_self _))
  have hqC : ∀ c ∈ IsLocalRing.maximalIdeal ↥W, ¬ IsUnit (q (Polynomial.C c)) := fun c hc h =>
    (hQ.2.1 _).mp h (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc))
  have hxm : ¬ IsUnit x := fun h => hqX (isUnit_of_map_unit θ _ (hx ▸ h))
  have hxJ : x ∉ J := fun h => hwJ (hH J hJp hMJ (by rw [hx]; exact h) w hw)
  have hJm : ∀ z ∈ J, ¬ IsUnit z := fun z hz hu => hJp.ne_top (Ideal.eq_top_of_isUnit_mem _ hz hu)

  have hcoef : ∀ n : ℕ, ∀ h : Polynomial ↥W, Polynomial.eval₂ σ x h ∈ J →
      h.coeff n ∈ IsLocalRing.maximalIdeal ↥W := by
    have h0 : ∀ h : Polynomial ↥W, Polynomial.eval₂ σ x h ∈ J →
        h.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W ∧ Polynomial.eval₂ σ x h.divX ∈ J := by
      intro h hJ
      have e : Polynomial.eval₂ σ x h = x * Polynomial.eval₂ σ x h.divX + σ (h.coeff 0) := by
        conv_lhs => rw [← Polynomial.X_mul_divX_add h]
        rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X, Polynomial.eval₂_C]
      have hc0 : h.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W := by
        by_contra hc
        have hu : IsUnit (σ (h.coeff 0)) := (IsLocalRing.notMem_maximalIdeal.mp hc).map σ
        apply hJm _ hJ
        rw [e]
        by_contra hnu
        have hxm' : x * Polynomial.eval₂ σ x h.divX ∈ IsLocalRing.maximalIdeal P :=
          Ideal.mul_mem_right _ _ ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hxm))
        have h1 : x * Polynomial.eval₂ σ x h.divX + σ (h.coeff 0) ∈ IsLocalRing.maximalIdeal P :=
          (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu)
        have h2 : σ (h.coeff 0) ∈ IsLocalRing.maximalIdeal P := by
          have h3 := Ideal.sub_mem _ h1 hxm'
          rwa [add_sub_cancel_left] at h3
        exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h2)) hu
      refine ⟨hc0, ?_⟩
      have hσJ : σ (h.coeff 0) ∈ J := hMJ (Ideal.mem_map_of_mem σ hc0)
      have h4 : x * Polynomial.eval₂ σ x h.divX ∈ J := by
        have h5 := Ideal.sub_mem _ hJ hσJ
        rwa [e, add_sub_cancel_right] at h5
      exact (hJp.mem_or_mem h4).resolve_left hxJ
    intro n
    induction n with
    | zero => intro h hJ; exact (h0 h hJ).1
    | succ n ih => intro h hJ; rw [← Polynomial.coeff_divX]; exact ih _ (h0 h hJ).2

  have hev_inj : Function.Injective (Polynomial.eval₂RingHom σ x) := by
    rw [injective_iff_map_eq_zero]
    intro h hh
    have hh2 : Polynomial.eval₂ σ x h = 0 := hh
    by_contra hne
    have key : ∀ s : Finset ℕ, s.Nonempty → ∃ i ∈ s, ∀ j ∈ s, h.coeff i ∣ h.coeff j := by
      intro s hs
      induction hs using Finset.Nonempty.cons_induction with
      | singleton a =>
        exact ⟨a, Finset.mem_singleton_self a, fun j hj => by rw [Finset.mem_singleton.mp hj]⟩
      | cons a s ha hs ih =>
        obtain ⟨i, hi, hdi⟩ := ih
        rcases ValuationRing.dvd_total (h.coeff a) (h.coeff i) with hai | hia
        · refine ⟨a, Finset.mem_cons_self a s, fun j hj => ?_⟩
          rcases Finset.mem_cons.mp hj with rfl | hj
          · exact dvd_rfl
          · exact hai.trans (hdi j hj)
        · refine ⟨i, Finset.mem_cons_of_mem hi, fun j hj => ?_⟩
          rcases Finset.mem_cons.mp hj with rfl | hj
          · exact hia
          · exact hdi j hj
    obtain ⟨i₁, hi₁, hdiv⟩ := key h.support (Polynomial.support_nonempty.mpr hne)
    have hc0 : h.coeff i₁ ≠ 0 := Polynomial.mem_support_iff.mp hi₁
    have hCdvd : Polynomial.C (h.coeff i₁) ∣ h := by
      rw [Polynomial.C_dvd_iff_dvd_coeff]
      intro j
      by_cases hj : j ∈ h.support
      · exact hdiv j hj
      · rw [Polynomial.notMem_support_iff.mp hj]; exact dvd_zero _
    obtain ⟨h', hh'⟩ := hCdvd
    have h1 : h'.coeff i₁ = 1 := by
      have h6 := congrArg (fun p => Polynomial.coeff p i₁) hh'
      simp only [Polynomial.coeff_C_mul] at h6
      apply mul_left_cancel₀ hc0
      rw [mul_one]; exact h6.symm
    have hev' : Polynomial.eval₂ σ x h' = 0 := by
      have h7 : Polynomial.eval₂ σ x h = σ (h.coeff i₁) * Polynomial.eval₂ σ x h' := by
        conv_lhs => rw [hh']
        rw [Polynomial.eval₂_mul, Polynomial.eval₂_C]
      rw [hh2] at h7
      have hσc : σ (h.coeff i₁) ≠ 0 := fun h0 => hc0 (hσinj (h0.trans (map_zero σ).symm))
      exact (mul_eq_zero.mp h7.symm).resolve_left hσc
    have h8 := hcoef i₁ h' (by rw [hev']; exact J.zero_mem)
    rw [h1] at h8
    exact (IsLocalRing.maximalIdeal.isMaximal ↥W).ne_top ((Ideal.eq_top_iff_one _).mpr h8)
  have hθq : θ.comp q = Polynomial.eval₂RingHom σ x := by
    apply Polynomial.ringHom_ext
    · intro c
      rw [RingHom.comp_apply, hθC, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
    · rw [RingHom.comp_apply, hx, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]

  have hinj : Function.Injective θ := by
    have hker : RingHom.ker θ = ⊥ := by
      apply wcNd_hens_generic_fibre (Polynomial ↥W) _ hpA Q q hQ (RingHom.ker θ) (RingHom.ker_isPrime θ)
      rw [RingHom.comap_ker, hθq]
      exact (RingHom.injective_iff_ker_eq_bot _).mp hev_inj
    exact (RingHom.injective_iff_ker_eq_bot θ).mpr hker
  refine ⟨hinj, ?_⟩

  obtain ⟨E, iE, iAE, iEt, j, hje, hjx, hjh⟩ := wcNd_hens_etale_chart A p hp P e he {x}
  obtain ⟨ξ, hξ⟩ := hjx x (Finset.mem_singleton_self x)
  let ρ : Polynomial ↥W →+* E := Polynomial.eval₂RingHom ((algebraMap A E).comp c₀) ξ
  have hjρ : j.comp ρ = θ.comp q := by
    apply Polynomial.ringHom_ext
    · intro c
      rw [RingHom.comp_apply, RingHom.comp_apply, hθC]
      show j (Polynomial.eval₂ ((algebraMap A E).comp c₀) ξ (Polynomial.C c)) = σ c
      rw [Polynomial.eval₂_C, ← RingHom.comp_apply j, ← RingHom.comp_assoc, hje, hec]
    · rw [RingHom.comp_apply, RingHom.comp_apply, hx]
      show j (Polynomial.eval₂ ((algebraMap A E).comp c₀) ξ Polynomial.X) = x
      rw [Polynomial.eval₂_X, hξ]
  have hρft : ρ.FiniteType := by
    have h1 : (ρ.comp Polynomial.C).FiniteType := by
      have h2 : ρ.comp Polynomial.C = (algebraMap A E).comp c₀ := by
        refine RingHom.ext fun c => ?_
        show Polynomial.eval₂ ((algebraMap A E).comp c₀) ξ (Polynomial.C c) = _
        rw [Polynomial.eval₂_C]
      rw [h2]
      exact RingHom.FiniteType.comp (RingHom.finiteType_algebraMap.mpr inferInstance) hc₀
    exact RingHom.FiniteType.of_comp_finiteType h1
  have huniq : ∀ (B : Type u) [CommRing B], HenselianLocalRing B → ∀ h h' : Q →+* B,
      IsLocalHom h → IsLocalHom h' → h.comp q = h'.comp q → h = h' := by
    intro B _ hB h h' hh hh' hhq
    haveI := hh
    have hg : ∀ a, IsUnit ((h.comp q) a) ↔
        a ∉ (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C) := by
      intro a; rw [RingHom.comp_apply, isUnit_map_iff h, hQ.2.1]
    obtain ⟨k, _, hk⟩ := hQ.2.2 B hB (h.comp q) hg
    exact (hk h ⟨rfl, hh⟩).trans (hk h' ⟨hhq.symm, hh'⟩).symm
  obtain ⟨S, iS, iQS, iSft, jS, hjS, hjSh⟩ :=
    wcNd_hens_tensor_chart (Polynomial ↥W) Q E P q ρ θ j huniq hjh hθ hjρ hρft
  have hfin := wcNd_hens_zmt_finite Q S P jS hjSh (by rw [hjS]; exact hθ) ?_ ?_
  · rwa [hjS] at hfin
  · intro z
    obtain ⟨c, hc⟩ := hres z
    refine ⟨q (Polynomial.C c), ?_⟩
    have h1 : jS (algebraMap Q S (q (Polynomial.C c))) = σ c := by
      rw [← RingHom.comp_apply jS, hjS, hθC]
    rw [h1, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact hc
  · intro 𝔓 h𝔓 hle
    rw [hjS] at hle
    have hM : (IsLocalRing.maximalIdeal ↥W).map σ ≤ 𝔓 := by
      rw [Ideal.map_le_iff_le_comap]
      intro c hc
      rw [Ideal.mem_comap, ← hθC]
      exact hle (Ideal.mem_map_of_mem θ
        ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr (hqC c hc))))
    have hx𝔓 : θ (q Polynomial.X) ∈ 𝔓 :=
      hle (Ideal.mem_map_of_mem θ ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hqX)))
    have hall := hH 𝔓 h𝔓 hM hx𝔓
    exact (Ideal.IsMaximal.eq_of_le (IsLocalRing.maximalIdeal.isMaximal P) h𝔓.ne_top
      (fun z hz => hall z (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hz)))).symm

theorem wcNd_normB2_core : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (P : Type u) [CommRing P] (σ : ↥W →+* P) (g : ↥W), g ∈ IsLocalRing.maximalIdeal ↥W → g ≠ 0 →
    ∀ (f : (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+* P),
    f.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = σ →
    wcNdIsHens ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
        (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map (Ideal.Quotient.mk _)) P f →
    ∀ (I : Subgroup (P ≃+* P)) [Fintype ↥I], (∀ c, σ c ∈ wcNdFix I) →
    ¬ (∀ τ ∈ I, Ideal.map τ ((IsLocalRing.maximalIdeal ↥W).map σ ⊔
        Ideal.span {f (Ideal.Quotient.mk _ (MvPolynomial.X 1))}) =
      (IsLocalRing.maximalIdeal ↥W).map σ ⊔ Ideal.span {f (Ideal.Quotient.mk _ (MvPolynomial.X 1))}) →
    ∃ x : P, (∀ τ ∈ I, τ x = x) ∧ ¬ IsUnit x ∧
      ∀ (Q : Type u) [CommRing Q] (q : Polynomial ↥W →+* Q),
      wcNdIsHens (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C) Q q →
      ∀ θ : Q →+* P, IsLocalHom θ → (∀ c, θ (q (Polynomial.C c)) = σ c) → θ (q Polynomial.X) = x →
      Function.Injective θ ∧ θ.IsIntegral ∧
        ∀ p : Fin (Fintype.card ↥I + 1) → P, ∃ c : Fin (Fintype.card ↥I + 1) → Q, c ≠ 0 ∧
          ∑ i, θ (c i) * p i = 0 :=
by
  intro Ω _ _ W hW hWt P _ σ g hgm hg0 f hfC hf I _ hIσ hJ
  classical
  subst hfC
  haveI hPh : HenselianLocalRing P := hf.1

  have hpB := (fun (p : Ideal (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}))
      (he : ∀ a, IsUnit (f a) ↔ a ∉ p) => (show p.IsPrime by
        have hp : p = Ideal.comap f (IsLocalRing.maximalIdeal P) := by
          ext a
          rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, he a, not_not]
        rw [hp]
        exact Ideal.comap_isPrime _ _)) _ hf.2.1
  haveI := (wcNd_nodal_poly_normal Ω W g hg0).1
  haveI := (wcNd_nodal_poly_normal Ω W g hg0).2
  obtain ⟨hPdom, hPic⟩ := wcNd_hens_normal_domain _ _ hpB P f hf

  obtain ⟨hJvP, hDv, hDVRv, hirrv, hresv⟩ :=
    wcNd_nodal_branch_dvr Ω W g hgm P f hf 0 1 (by decide)
  obtain ⟨hJuP, hDu, hDVRu, hirru, hresu⟩ :=
    wcNd_nodal_branch_dvr Ω W g hgm P f hf 1 0 (by decide)
  have huv : f (Ideal.Quotient.mk _ (MvPolynomial.X 0)) * f (Ideal.Quotient.mk _ (MvPolynomial.X 1))
      = (f.comp ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g})).comp MvPolynomial.C)) g := by
    rw [← map_mul, ← map_mul, RingHom.comp_apply, RingHom.comp_apply]
    congr 1
    rw [Ideal.Quotient.eq]
    exact Ideal.subset_span rfl
  have hu_nu : ¬ IsUnit (f (Ideal.Quotient.mk _ (MvPolynomial.X 0))) := fun h =>
    ((hf.2.1 _).mp h) (Ideal.mem_map_of_mem _ (Ideal.mem_sup_left
      (Ideal.subset_span (Set.mem_insert _ _))))
  have hv_nu : ¬ IsUnit (f (Ideal.Quotient.mk _ (MvPolynomial.X 1))) := fun h =>
    ((hf.2.1 _).mp h) (Ideal.mem_map_of_mem _ (Ideal.mem_sup_left
      (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))))
  have hIc : ∀ c, ∀ τ ∈ I, τ ((f.comp ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 *
      MvPolynomial.X 1 - MvPolynomial.C g})).comp MvPolynomial.C)) c) =
      (f.comp ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 *
      MvPolynomial.X 1 - MvPolynomial.C g})).comp MvPolynomial.C)) c := fun c => hIσ c
  set σ := f.comp ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
    MvPolynomial.C g})).comp MvPolynomial.C) with hσ
  set M := (IsLocalRing.maximalIdeal ↥W).map σ with hM
  set u := f (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
    MvPolynomial.C g}) (MvPolynomial.X 0)) with hu
  set v := f (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
    MvPolynomial.C g}) (MvPolynomial.X 1)) with hv
  set Jv := M ⊔ Ideal.span {v} with hJv
  set Ju := M ⊔ Ideal.span {u} with hJu

  have hσg : σ g ∈ M := Ideal.mem_map_of_mem σ hgm
  have hMJv : M ≤ Jv := le_sup_left
  have hMJu : M ≤ Ju := le_sup_left
  have hu_mem : u ∈ Ju := Ideal.mem_sup_right (Ideal.mem_span_singleton_self u)
  have hv_mem : v ∈ Jv := Ideal.mem_sup_right (Ideal.mem_span_singleton_self v)
  have hu_nJv : u ∉ Jv := fun h => hirrv.ne_zero (Ideal.Quotient.eq_zero_iff_mem.mpr h)
  have hv_nJu : v ∉ Ju := fun h => hirru.ne_zero (Ideal.Quotient.eq_zero_iff_mem.mpr h)
  have hneq : Ju ≠ Jv := fun h => hu_nJv (h ▸ hu_mem)

  have dich : ∀ (J : Ideal P) [J.IsPrime] [IsDomain (P ⧸ J)] [IsDiscreteValuationRing (P ⧸ J)]
      (𝔔 : Ideal P), 𝔔.IsPrime → J ≤ 𝔔 → 𝔔 = J ∨ 𝔔 = IsLocalRing.maximalIdeal P := by
    intro J _ _ _ 𝔔 h𝔔 hJ𝔔
    by_cases hEq : 𝔔 = J
    · exact Or.inl hEq
    right
    have hker : RingHom.ker (Ideal.Quotient.mk J) ≤ 𝔔 := by rw [Ideal.mk_ker]; exact hJ𝔔
    haveI := h𝔔
    have hprime : (𝔔.map (Ideal.Quotient.mk J)).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker
    have hcm : Ideal.comap (Ideal.Quotient.mk J) (𝔔.map (Ideal.Quotient.mk J)) = 𝔔 := by
      rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot,
        Ideal.mk_ker, sup_eq_left.mpr hJ𝔔]
    have hne : 𝔔.map (Ideal.Quotient.mk J) ≠ ⊥ := by
      intro hb
      apply hEq
      apply le_antisymm _ hJ𝔔
      rw [← hcm, hb, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
    haveI hmax := hprime.isMaximal hne
    have hc := Ideal.comap_isMaximal_of_surjective (Ideal.Quotient.mk J)
      Ideal.Quotient.mk_surjective (K := 𝔔.map (Ideal.Quotient.mk J)) (H := hmax)
    rw [hcm] at hc
    exact IsLocalRing.eq_maximalIdeal hc
  have twoBr : ∀ 𝔓 : Ideal P, 𝔓.IsPrime → M ≤ 𝔓 → Ju ≤ 𝔓 ∨ Jv ≤ 𝔓 := by
    intro 𝔓 h𝔓 hM𝔓
    have h1 : u * v ∈ 𝔓 := by rw [huv]; exact hM𝔓 hσg
    rcases h𝔓.mem_or_mem h1 with h | h
    · left; exact sup_le hM𝔓 ((Ideal.span_singleton_le_iff_mem _).mpr h)
    · right; exact sup_le hM𝔓 ((Ideal.span_singleton_le_iff_mem _).mpr h)
  have tri : ∀ 𝔓 : Ideal P, 𝔓.IsPrime → M ≤ 𝔓 →
      𝔓 = Ju ∨ 𝔓 = Jv ∨ 𝔓 = IsLocalRing.maximalIdeal P := by
    intro 𝔓 h𝔓 hM𝔓
    rcases twoBr 𝔓 h𝔓 hM𝔓 with h | h
    · rcases dich Ju 𝔓 h𝔓 h with h' | h'
      · exact Or.inl h'
      · exact Or.inr (Or.inr h')
    · rcases dich Jv 𝔓 h𝔓 h with h' | h'
      · exact Or.inr (Or.inl h')
      · exact Or.inr (Or.inr h')

  have hτM : ∀ τ ∈ I, Ideal.map τ M = M := by
    intro τ hτ
    show Ideal.map (τ : P →+* P) (Ideal.map σ _) = _
    rw [Ideal.map_map]
    congr 1
    ext c
    exact hIc c τ hτ
  have himg : ∀ τ ∈ I, ∀ (J : Ideal P) [J.IsPrime] (w : P), M ≤ J → ¬ IsUnit w → w ∉ J →
      Ideal.map τ J = Ju ∨ Ideal.map τ J = Jv := by
    intro τ hτ J _ w hMJ hw hwJ
    have hpr : (Ideal.map τ J).IsPrime := Ideal.map_isPrime_of_equiv τ
    have hMτ : M ≤ Ideal.map τ J := by
      calc M = Ideal.map τ M := (hτM τ hτ).symm
        _ ≤ Ideal.map τ J := Ideal.map_mono hMJ
    rcases tri _ hpr hMτ with h | h | h
    · exact Or.inl h
    · exact Or.inr h
    · exfalso
      apply hwJ
      have hτw : τ w ∈ Ideal.map τ J := by
        rw [h, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu'
        apply hw
        have h2 := hu'.map τ.symm
        rwa [RingEquiv.symm_apply_apply] at h2
      have h3 : w ∈ Ideal.comap τ (Ideal.map τ J) := hτw
      rwa [Ideal.comap_map_of_bijective τ τ.bijective] at h3
  have hperm : ∀ τ ∈ I, (Ideal.map τ Jv = Jv ∧ Ideal.map τ Ju = Ju) ∨
      (Ideal.map τ Jv = Ju ∧ Ideal.map τ Ju = Jv) := by
    intro τ hτ
    have hinj : Ideal.map τ Jv ≠ Ideal.map τ Ju := by
      intro h
      apply hneq
      have h2 := congrArg (Ideal.comap τ) h
      rwa [Ideal.comap_map_of_bijective τ τ.bijective, Ideal.comap_map_of_bijective τ τ.bijective,
        eq_comm] at h2
    rcases himg τ hτ Jv u hMJv hu_nu hu_nJv with h1 | h1 <;>
    rcases himg τ hτ Ju v hMJu hv_nu hv_nJu with h2 | h2
    · exact absurd (h1.trans h2.symm) hinj
    · exact Or.inr ⟨h1, h2⟩
    · exact Or.inl ⟨h1, h2⟩
    · exact absurd (h1.trans h2.symm) hinj
  push_neg at hJ
  obtain ⟨τ0, hτ0, hτ0J⟩ := hJ
  have hτ0' : Ideal.map τ0 Jv = Ju := by
    rcases hperm τ0 hτ0 with h | h
    · exact absurd h.1 hτ0J
    · exact h.1

  obtain ⟨k, y, y', hk0, hk2, hyI, hyJu, hy'Jv, hassv, hassu⟩ :=
    wcNd_swap_norm_element P I Ju Jv u v hu_mem hv_mem hirrv hirru hperm ⟨τ0, hτ0, hτ0'⟩
  set x := y + y' with hx
  have hxv : Ideal.Quotient.mk Jv x = Ideal.Quotient.mk Jv y := by
    rw [Ideal.Quotient.eq, hx, add_sub_cancel_left]; exact hy'Jv
  have hxu : Ideal.Quotient.mk Ju x = Ideal.Quotient.mk Ju y' := by
    rw [Ideal.Quotient.eq, hx, add_sub_cancel_right]; exact hyJu
  have hassvx : Associated (Ideal.Quotient.mk Jv x) (Ideal.Quotient.mk Jv u ^ k) := by
    rw [hxv]; exact hassv
  have hassux : Associated (Ideal.Quotient.mk Ju x) (Ideal.Quotient.mk Ju v ^ k) := by
    rw [hxu]; exact hassu
  have hx_nu : ¬ IsUnit x := fun h =>
    hirrv.not_isUnit ((isUnit_pow_iff hk0.ne').mp (hassvx.isUnit_iff.mp (h.map _)))
  have hxnJv : ∀ n : ℕ, x ^ n ∉ Jv := by
    intro n h
    have h1 : Ideal.Quotient.mk Jv (x ^ n) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr h
    rw [map_pow] at h1
    exact pow_ne_zero n (hassvx.ne_zero_iff.mpr (pow_ne_zero k hirrv.ne_zero)) h1
  have hxnJu : x ∉ Ju := by
    intro h
    have h1 : Ideal.Quotient.mk Ju x = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr h
    exact hassux.ne_zero_iff.mpr (pow_ne_zero k hirru.ne_zero) h1
  have hprim : ∀ 𝔓 : Ideal P, 𝔓.IsPrime → M ≤ 𝔓 → x ∈ 𝔓 → ∀ z : P, ¬ IsUnit z → z ∈ 𝔓 := by
    intro 𝔓 h𝔓 hM𝔓 hx𝔓 z hz
    rcases tri 𝔓 h𝔓 hM𝔓 with h | h | h
    · exact absurd (h ▸ hx𝔓) hxnJu
    · exact absurd (by rw [pow_one]; exact h ▸ hx𝔓) (hxnJv 1)
    · rw [h, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact hz

  have hint : ∀ z, z ∈ Ju → z ∈ Jv → z ∈ M := by
    intro z hzu hzv
    obtain ⟨a, ha, s1, hs1, rfl⟩ := Submodule.mem_sup.mp hzu
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hs1
    obtain ⟨b, hb, s2, hs2, hbz⟩ := Submodule.mem_sup.mp hzv
    obtain ⟨s, rfl⟩ := Ideal.mem_span_singleton'.mp hs2
    apply wcNd_radical_map_maxIdeal Ω W P σ _ 1
    have e : (a + r * u) ^ (1 + 1) = a * (a + r * u) + (r * u) * b + (r * s) * (u * v) := by
      linear_combination (-(r * u)) * hbz
    rw [e]
    refine Ideal.add_mem _ (Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha)
      (Ideal.mul_mem_left _ _ hb)) (Ideal.mul_mem_left _ _ ?_)
    rw [huv]; exact hσg
  refine ⟨x, hyI, hx_nu, ?_⟩
  intro Q _ q hQ θ hθl hθC hθX
  have hB : wcNdModelA W P σ ∨ wcNdModelB W P σ := by
    right
    unfold wcNdModelB
    exact ⟨g, hgm, hg0, f, rfl, hf⟩
  obtain ⟨hinj, hfin⟩ := wcNd_model_norm_finite_injective Ω W hW hWt P σ hB Q q hQ θ hθl hθC
    (fun 𝔓 h1 h2 h3 => hprim 𝔓 h1 h2 (by rwa [hθX] at h3))
  refine ⟨hinj, hfin.to_isIntegral, ?_⟩
  haveI : IsDomain Q := Function.Injective.isDomain θ hinj
  haveI hQh : HenselianLocalRing Q := hQ.1
  have hqX : q Polynomial.X ∈ IsLocalRing.maximalIdeal Q :=
    (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr (fun h =>
      ((hQ.2.1 _).mp h) (Ideal.mem_sup_left (Ideal.mem_span_singleton_self _))))

  have hexpv : ∀ p : P, ∃ α : Fin k → Q, p - ∑ i, θ (α i) * u ^ (i : ℕ) ∈ Jv := by
    have hφ : ((Ideal.Quotient.mk Jv).comp θ).Finite :=
      (RingHom.Finite.of_surjective _ Ideal.Quotient.mk_surjective).comp hfin
    obtain ⟨cv, hcv⟩ := hassvx.symm
    have hres : ∀ z : P ⧸ Jv, ∃ a : Q, z - ((Ideal.Quotient.mk Jv).comp θ) a ∈
        Ideal.span {Ideal.Quotient.mk Jv u} := by
      intro z
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨c, hc⟩ := hresv p
      refine ⟨q (Polynomial.C c), ?_⟩
      obtain ⟨j, hj, s, hs, hjs⟩ := Submodule.mem_sup.mp hc
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hs
      rw [RingHom.comp_apply, hθC c, ← map_sub]
      have e : p - σ c = j + r * u := hjs.symm
      rw [e, map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hj, zero_add, map_mul]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    have hspan := wcNd_finite_span_pow Q (P ⧸ Jv) ((Ideal.Quotient.mk Jv).comp θ) hφ
      (q Polynomial.X) hqX (Ideal.Quotient.mk Jv u) cv k cv.isUnit
      (by rw [RingHom.comp_apply, hθX, ← hcv, mul_comm]) hres
    intro p
    obtain ⟨α, hα⟩ := hspan (Ideal.Quotient.mk Jv p)
    refine ⟨α, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hα, map_sum]
    simp only [map_mul, map_pow, RingHom.comp_apply, sub_self]

  have hexpu : ∀ p : P, ∃ β : Fin k → Q, p - ∑ i, θ (β i) * v ^ (i : ℕ) ∈ Ju := by
    have hφ : ((Ideal.Quotient.mk Ju).comp θ).Finite :=
      (RingHom.Finite.of_surjective _ Ideal.Quotient.mk_surjective).comp hfin
    obtain ⟨cu, hcu⟩ := hassux.symm
    have hres : ∀ z : P ⧸ Ju, ∃ a : Q, z - ((Ideal.Quotient.mk Ju).comp θ) a ∈
        Ideal.span {Ideal.Quotient.mk Ju v} := by
      intro z
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨c, hc⟩ := hresu p
      refine ⟨q (Polynomial.C c), ?_⟩
      obtain ⟨j, hj, s, hs, hjs⟩ := Submodule.mem_sup.mp hc
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hs
      rw [RingHom.comp_apply, hθC c, ← map_sub]
      have e : p - σ c = j + r * v := hjs.symm
      rw [e, map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hj, zero_add, map_mul]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    have hspan := wcNd_finite_span_pow Q (P ⧸ Ju) ((Ideal.Quotient.mk Ju).comp θ) hφ
      (q Polynomial.X) hqX (Ideal.Quotient.mk Ju v) cu k cu.isUnit
      (by rw [RingHom.comp_apply, hθX, ← hcu, mul_comm]) hres
    intro p
    obtain ⟨β, hβ⟩ := hspan (Ideal.Quotient.mk Ju p)
    refine ⟨β, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hβ, map_sum]
    simp only [map_mul, map_pow, RingHom.comp_apply, sub_self]

  have hθ𝔞 : Ideal.map θ ((IsLocalRing.maximalIdeal ↥W).map (q.comp Polynomial.C)) = M := by
    rw [Ideal.map_map, hM]
    congr 1
    exact RingHom.ext hθC
  have hd : Disjoint (((IsLocalRing.maximalIdeal ↥W).map (q.comp Polynomial.C) : Ideal Q) : Set Q)
      (Submonoid.powers (q Polynomial.X) : Set Q) := by
    rw [Set.disjoint_left]
    intro t ht htp
    obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp htp
    apply hxnJv n
    rw [← hθX, ← map_pow]
    apply hMJv
    rw [← hθ𝔞]
    exact Ideal.mem_map_of_mem θ ht
  obtain ⟨𝔭, h𝔭p, h𝔞𝔭, hdisj⟩ := Ideal.exists_le_prime_disjoint _ _ hd
  have hs𝔭 : q Polynomial.X ∉ 𝔭 := fun h =>
    Set.disjoint_left.mp hdisj h (Submonoid.mem_powers _)
  have hle : M ≤ Ideal.map θ 𝔭 := by
    rw [← hθ𝔞]; exact Ideal.map_mono h𝔞𝔭
  have hkk : Fintype.card ↥I = k + k := by omega
  rw [hkk]
  refine wcNd_rank_le_of_fibre_span Q P θ hfin 𝔭 h𝔭p (k + k)
    (Fin.append (fun i : Fin k => y * u ^ (i : ℕ)) (fun i : Fin k => y' * v ^ (i : ℕ)))
    (q Polynomial.X) hs𝔭 ?_
  intro z
  obtain ⟨α, hα⟩ := hexpv z
  obtain ⟨β, hβ⟩ := hexpu z
  refine ⟨Fin.append α β, hle ?_⟩
  have h1 : ∑ i : Fin k, θ (α i) * (y * u ^ (i : ℕ)) = y * ∑ i, θ (α i) * u ^ (i : ℕ) := by
    rw [Finset.mul_sum]; exact Finset.sum_congr rfl (fun i _ => by ring)
  have h2 : ∑ i : Fin k, θ (β i) * (y' * v ^ (i : ℕ)) = y' * ∑ i, θ (β i) * v ^ (i : ℕ) := by
    rw [Finset.mul_sum]; exact Finset.sum_congr rfl (fun i _ => by ring)
  have e : θ (q Polynomial.X) * z - ∑ i, θ (Fin.append α β i) *
      Fin.append (fun i : Fin k => y * u ^ (i : ℕ)) (fun i : Fin k => y' * v ^ (i : ℕ)) i =
      y * (z - ∑ i, θ (α i) * u ^ (i : ℕ)) + y' * (z - ∑ i, θ (β i) * v ^ (i : ℕ)) := by
    rw [Fin.sum_univ_add, hθX]
    simp only [Fin.append_left, Fin.append_right]
    rw [h1, h2, hx]
    ring
  rw [e]
  exact Ideal.add_mem _ (hint _ (Ideal.mul_mem_right _ _ hyJu) (Ideal.mul_mem_left _ _ hα))
    (hint _ (Ideal.mul_mem_left _ _ hβ) (Ideal.mul_mem_right _ _ hy'Jv))

theorem wcpa_dj_lr1k_nd_dejong_invariants : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (P : Type u) [CommRing P] (σ : ↥W →+* P), (wcNdModelA W P σ ∨ wcNdModelB W P σ) →
    ∀ (I : Subgroup (P ≃+* P)) (hI : ∀ c, σ c ∈ wcNdFix I), Finite ↥I →
      wcNdModelA W ↥(wcNdFix I) (σ.codRestrict (wcNdFix I) hI) ∨
      wcNdModelB W ↥(wcNdFix I) (σ.codRestrict (wcNdFix I) hI) :=
by
  intro Ω _ _ W hW hWt P _ σ hP I hI hIf
  classical
  haveI : Fintype ↥I := Fintype.ofFinite ↥I
  have hIc : ∀ c, ∀ τ ∈ I, τ (σ c) = σ c := fun c => hI c

  have Hprime : ∀ {A : Type u} [CommRing A] (p : Ideal A) (R : Type u) [CommRing R] [IsLocalRing R]
      (e : A →+* R), (∀ a, IsUnit (e a) ↔ a ∉ p) → p.IsPrime := by
    intro A _ p R _ _ e he
    have hp : p = Ideal.comap e (IsLocalRing.maximalIdeal R) := by
      ext a
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, he a, not_not]
    rw [hp]
    exact Ideal.comap_isPrime _ _

  have Htrans : ∀ {A : Type u} [CommRing A] (p : Ideal A) (Q Q' : Type u) [CommRing Q]
      [CommRing Q'] (q : A →+* Q) (ψ : Q ≃+* Q'), wcNdIsHens p Q q →
      wcNdIsHens p Q' ((ψ : Q →+* Q').comp q) := by
    intro A _ p Q Q' _ _ q ψ hq
    haveI : HenselianLocalRing Q := hq.1
    haveI : IsLocalRing Q' := ψ.isLocalRing
    have hunit : ∀ x : Q, IsUnit (ψ x) ↔ IsUnit x := fun x => isUnit_map_iff ψ x
    have hunit' : ∀ x : Q', IsUnit (ψ.symm x) ↔ IsUnit x := fun x => isUnit_map_iff ψ.symm x
    refine ⟨?_, ?_, ?_⟩
    · refine HenselianLocalRing.mk ?_
      intro F hF a₀ ha₀ hda₀
      have hev : ∀ (H : Polynomial Q') (b : Q'),
          Polynomial.eval (ψ.symm b) (H.map (ψ.symm : Q' →+* Q)) = ψ.symm (Polynomial.eval b H) := by
        intro H b
        rw [Polynomial.eval_map]
        exact Polynomial.eval₂_at_apply (ψ.symm : Q' →+* Q) b
      have hGm : (F.map (ψ.symm : Q' →+* Q)).Monic := hF.map _
      have h1 : Polynomial.eval (ψ.symm a₀) (F.map (ψ.symm : Q' →+* Q)) ∈
          IsLocalRing.maximalIdeal Q := by
        rw [hev, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hunit']
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at ha₀
        exact ha₀
      have h2 : IsUnit (Polynomial.eval (ψ.symm a₀)
          (Polynomial.derivative (F.map (ψ.symm : Q' →+* Q)))) := by
        rw [Polynomial.derivative_map, hev, hunit']
        exact hda₀
      obtain ⟨a, ha, hae⟩ := HenselianLocalRing.is_henselian _ hGm (ψ.symm a₀) h1 h2
      refine ⟨ψ a, ?_, ?_⟩
      · rw [Polynomial.IsRoot.def]
        have h3 := hev F (ψ a)
        rw [RingEquiv.symm_apply_apply] at h3
        rw [Polynomial.IsRoot.def] at ha
        rw [ha] at h3
        exact (map_eq_zero_iff ψ.symm ψ.symm.injective).mp h3.symm
      · have e : ψ a - a₀ = ψ (a - ψ.symm a₀) := by
          rw [map_sub, RingEquiv.apply_symm_apply]
        rw [e, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hunit]
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hae
        exact hae
    · intro a
      show IsUnit (ψ (q a)) ↔ a ∉ p
      rw [hunit]
      exact hq.2.1 a
    · intro B _ hB g hg
      obtain ⟨h, ⟨hh, hloc⟩, huniq⟩ := hq.2.2 B hB g hg
      refine ⟨h.comp (ψ.symm : Q' →+* Q), ⟨?_, ?_⟩, ?_⟩
      · rw [← hh]
        ext a
        simp
      · haveI := hloc
        infer_instance
      · rintro h' ⟨hh', hloc'⟩
        haveI := hloc'
        have e : h'.comp (ψ : Q →+* Q') = h :=
          huniq _ ⟨by rw [RingHom.comp_assoc, hh'], inferInstance⟩
        ext x
        rw [← e]
        simp

  have Hcong : ∀ {R : Type u} [CommRing R] [IsLocalRing R] (s t : R),
      s - t ∈ IsLocalRing.maximalIdeal R → (IsUnit s ↔ IsUnit t) := by
    intro R _ _ s t hst
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit, ← IsLocalRing.residue_ne_zero_iff_isUnit]
    rw [← IsLocalRing.residue_eq_zero_iff, map_sub, sub_eq_zero] at hst
    rw [hst]

  have charA : ∀ a : Polynomial ↥W,
      a ∈ (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C) ↔
        a.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W := by
    intro a
    constructor
    · intro ha
      have hle : (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map
          (Polynomial.C : ↥W →+* Polynomial ↥W)) ≤
          Ideal.comap Polynomial.constantCoeff (IsLocalRing.maximalIdeal ↥W) := by
        refine sup_le ?_ ?_
        · rw [Ideal.span_le, Set.singleton_subset_iff]
          show Polynomial.constantCoeff Polynomial.X ∈ IsLocalRing.maximalIdeal ↥W
          rw [Polynomial.constantCoeff_apply, Polynomial.coeff_X_zero]
          exact Ideal.zero_mem _
        · rw [Ideal.map_le_iff_le_comap]
          intro c hc
          rw [Ideal.mem_comap, Ideal.mem_comap, Polynomial.constantCoeff_apply,
            Polynomial.coeff_C_zero]
          exact hc
      have := hle ha
      rwa [Ideal.mem_comap, Polynomial.constantCoeff_apply] at this
    · intro ha
      rw [← Polynomial.X_mul_divX_add a]
      exact Ideal.add_mem _
        (Ideal.mem_sup_left (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)))
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ ha))

  have spanX : ∀ b : MvPolynomial (Fin 2) ↥W,
      b - MvPolynomial.C (MvPolynomial.constantCoeff b) ∈
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W)) := by
    intro b
    refine MvPolynomial.induction_on (motive := fun b => b - MvPolynomial.C
      (MvPolynomial.constantCoeff b) ∈
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W))) b
      ?_ ?_ ?_
    · intro a
      rw [MvPolynomial.constantCoeff_C, sub_self]
      exact Ideal.zero_mem _
    · intro p q hp hq
      have e : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
          (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
            (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
        rw [map_add, map_add]
        ring
      rw [e]
      exact Ideal.add_mem _ hp hq
    · intro p n _
      rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero, sub_zero]
      apply Ideal.mul_mem_left
      apply Ideal.subset_span
      fin_cases n
      · exact Set.mem_insert _ _
      · exact Set.mem_insert_of_mem _ (Set.mem_singleton _)
  have charB : ∀ g' : ↥W, g' ∈ IsLocalRing.maximalIdeal ↥W → ∀ b : MvPolynomial (Fin 2) ↥W,
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g'}) b ∈
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
          (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map (Ideal.Quotient.mk
            (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g'})) ↔
        MvPolynomial.constantCoeff b ∈ IsLocalRing.maximalIdeal ↥W := by
    intro g' hg' b
    rw [Ideal.mem_quotient_iff_mem_sup]
    constructor
    · intro hb
      have hle : (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
          (IsLocalRing.maximalIdeal ↥W).map (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 2) ↥W)) ⊔
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g'} ≤
          Ideal.comap MvPolynomial.constantCoeff (IsLocalRing.maximalIdeal ↥W) := by
        refine sup_le (sup_le ?_ ?_) ?_
        · rw [Ideal.span_le]
          intro z hz
          simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
          rcases hz with rfl | rfl
          · show MvPolynomial.constantCoeff (MvPolynomial.X 0) ∈ IsLocalRing.maximalIdeal ↥W
            rw [MvPolynomial.constantCoeff_X]
            exact Ideal.zero_mem _
          · show MvPolynomial.constantCoeff (MvPolynomial.X 1) ∈ IsLocalRing.maximalIdeal ↥W
            rw [MvPolynomial.constantCoeff_X]
            exact Ideal.zero_mem _
        · rw [Ideal.map_le_iff_le_comap]
          intro c hc
          rw [Ideal.mem_comap, Ideal.mem_comap, MvPolynomial.constantCoeff_C]
          exact hc
        · rw [Ideal.span_le, Set.singleton_subset_iff]
          show MvPolynomial.constantCoeff (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g') ∈
            IsLocalRing.maximalIdeal ↥W
          rw [map_sub, map_mul, MvPolynomial.constantCoeff_X, MvPolynomial.constantCoeff_X, mul_zero,
            MvPolynomial.constantCoeff_C, zero_sub, Ideal.neg_mem_iff]
          exact hg'
      exact hle hb
    · intro hb
      apply Ideal.mem_sup_left
      have e : b = (b - MvPolynomial.C (MvPolynomial.constantCoeff b)) +
          MvPolynomial.C (MvPolynomial.constantCoeff b) := by ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.mem_sup_left (spanX b))
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hb))

  have hPh : HenselianLocalRing P := by
    rcases hP with ⟨f, -, h⟩ | ⟨g, -, -, f, -, h⟩
    · exact h.1
    · exact h.1
  haveI := hPh

  have unitA : ∀ (x : P), x ∈ IsLocalRing.maximalIdeal P →
      (∀ c, IsUnit (σ c) ↔ c ∉ IsLocalRing.maximalIdeal ↥W) →
      ∀ a : Polynomial ↥W, IsUnit (Polynomial.eval₂RingHom σ x a) ↔
        a ∉ (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C) := by
    intro x hx hσ a
    rw [charA, ← hσ]
    apply Hcong
    have e : Polynomial.eval₂RingHom σ x a =
        x * Polynomial.eval₂ σ x a.divX + σ (a.coeff 0) := by
      rw [Polynomial.coe_eval₂RingHom]
      conv_lhs => rw [← Polynomial.X_mul_divX_add a]
      rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X, Polynomial.eval₂_C]
    rw [e, add_sub_cancel_right]
    exact Ideal.mul_mem_right _ _ hx
  have unitB : ∀ (g' : ↥W), g' ∈ IsLocalRing.maximalIdeal ↥W → ∀ (z0 z1 : P),
      z0 ∈ IsLocalRing.maximalIdeal P → z1 ∈ IsLocalRing.maximalIdeal P →
      ∀ (H : ∀ a ∈ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g'},
        MvPolynomial.eval₂Hom σ (![z0, z1] : Fin 2 → P) a = 0),
      (∀ c, IsUnit (σ c) ↔ c ∉ IsLocalRing.maximalIdeal ↥W) →
      ∀ a, IsUnit (Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom σ (![z0, z1] : Fin 2 → P)) H a) ↔
        a ∉ (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
          (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map (Ideal.Quotient.mk
            (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g'})) := by
    intro g' hg' z0 z1 hz0 hz1 H hσ a
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective a
    rw [Ideal.Quotient.lift_mk, charB g' hg' b, ← hσ]
    apply Hcong
    have hz : ∀ n : Fin 2, (![z0, z1] : Fin 2 → P) n ∈ IsLocalRing.maximalIdeal P := by
      intro n
      fin_cases n
      · exact hz0
      · exact hz1
    refine MvPolynomial.induction_on (motive := fun b => MvPolynomial.eval₂Hom σ (![z0, z1] : Fin 2 → P) b -
      σ (MvPolynomial.constantCoeff b) ∈ IsLocalRing.maximalIdeal P) b ?_ ?_ ?_
    · intro c
      rw [MvPolynomial.eval₂Hom_C, MvPolynomial.constantCoeff_C, sub_self]
      exact Ideal.zero_mem _
    · intro p q hp hq
      have e : MvPolynomial.eval₂Hom σ (![z0, z1] : Fin 2 → P) (p + q) - σ (MvPolynomial.constantCoeff (p + q)) =
          (MvPolynomial.eval₂Hom σ (![z0, z1] : Fin 2 → P) p - σ (MvPolynomial.constantCoeff p)) +
            (MvPolynomial.eval₂Hom σ (![z0, z1] : Fin 2 → P) q - σ (MvPolynomial.constantCoeff q)) := by
        rw [map_add, map_add, map_add]
        ring
      rw [e]
      exact Ideal.add_mem _ hp hq
    · intro p n _
      rw [map_mul, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.constantCoeff_X, mul_zero,
        map_zero, sub_zero]
      exact Ideal.mul_mem_left _ _ (hz n)

  have hNfix : ∀ z : P, ∀ ρ ∈ I, ρ (∏ τ : ↥I, (τ : P ≃+* P) z) = ∏ τ : ↥I, (τ : P ≃+* P) z := by
    intro z ρ hρ
    rw [map_prod]
    exact Fintype.prod_equiv (Equiv.mulLeft (⟨ρ, hρ⟩ : ↥I)) _ _ (fun τ => rfl)
  have hNmax : ∀ z : P, z ∈ IsLocalRing.maximalIdeal P →
      ∏ τ : ↥I, (τ : P ≃+* P) z ∈ IsLocalRing.maximalIdeal P := by
    intro z hz
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hz ⊢
    intro hu
    apply hz
    exact isUnit_of_dvd_unit
      (Finset.dvd_prod_of_mem (fun τ : ↥I => (τ : P ≃+* P) z) (Finset.mem_univ 1)) hu

  have Hfix : ∀ {A : Type u} [CommRing A] (p : Ideal A) (Q : Type u) [CommRing Q] (q : A →+* Q),
      wcNdIsHens p Q q → ∀ (g₀ : A →+* P), (∀ a, IsUnit (g₀ a) ↔ a ∉ p) →
      (∀ τ ∈ I, (τ : P →+* P).comp g₀ = g₀) →
      ∃ θ : Q →+* P, θ.comp q = g₀ ∧ IsLocalHom θ ∧ ∀ a, θ a ∈ wcNdFix I := by
    intro A _ p Q _ q hQ g₀ hg₀ hinv
    obtain ⟨θ, ⟨hθq, hθl⟩, huniq⟩ := hQ.2.2 P hPh g₀ hg₀
    refine ⟨θ, hθq, hθl, fun a => ?_⟩
    show ∀ τ ∈ I, τ (θ a) = θ a
    intro τ hτ
    haveI := hθl
    have e : (τ : P →+* P).comp θ = θ :=
      huniq _ ⟨by rw [RingHom.comp_assoc, hθq, hinv τ hτ], inferInstance⟩
    exact RingHom.congr_fun e a

  have finishA : ∀ x : P, (∀ τ ∈ I, τ x = x) → x ∈ IsLocalRing.maximalIdeal P → IsDomain P →
      (∀ c, IsUnit (σ c) ↔ c ∉ IsLocalRing.maximalIdeal ↥W) →
      (∀ (Q : Type u) [CommRing Q] (q : Polynomial ↥W →+* Q),
        wcNdIsHens (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C) Q q →
        ∀ θ : Q →+* P, IsLocalHom θ → (∀ c, θ (q (Polynomial.C c)) = σ c) →
        θ (q Polynomial.X) = x →
        Function.Injective θ ∧ θ.IsIntegral ∧
          ∀ p : Fin (Fintype.card ↥I + 1) → P, ∃ c : Fin (Fintype.card ↥I + 1) → Q, c ≠ 0 ∧
            ∑ i, θ (c i) * p i = 0) →
      wcNdModelA W ↥(wcNdFix I) (σ.codRestrict (wcNdFix I) hI) := by
    intro x hxI hxm hPdom hσ hcore
    have hg₀ := unitA x hxm hσ
    have hpA := @Hprime _ _ _ P _ _ _ hg₀
    obtain ⟨Q, iQ, q, hQ⟩ := wcNd_hens_exists (Polynomial ↥W) _ hpA
    obtain ⟨hQdom, hQic⟩ := wcNd_hens_normal_domain (Polynomial ↥W) _ hpA Q q hQ
    have hinv : ∀ τ ∈ I, (τ : P →+* P).comp (Polynomial.eval₂RingHom σ x) =
        Polynomial.eval₂RingHom σ x := by
      intro τ hτ
      apply Polynomial.ringHom_ext
      · intro c
        simp [hIc c τ hτ]
      · simp [hxI τ hτ]
    obtain ⟨θ, hθq, hθl, hθI⟩ := Hfix _ Q q hQ _ hg₀ hinv
    have hθC : ∀ c, θ (q (Polynomial.C c)) = σ c := fun c => by
      rw [← RingHom.comp_apply θ q, hθq]
      simp
    have hθX : θ (q Polynomial.X) = x := by
      rw [← RingHom.comp_apply θ q, hθq]
      simp
    obtain ⟨hinj, hint, hdep⟩ := hcore Q q hQ θ hθl hθC hθX
    haveI := hPdom
    haveI := hQdom
    haveI := hQic
    have hsurj := wcNd_galois_normal_criterion P Q I θ hinj hθI hint hdep
    let ψ : Q ≃+* ↥(wcNdFix I) := RingEquiv.ofBijective (θ.codRestrict (wcNdFix I) hθI)
      ⟨fun a b h => hinj (congrArg Subtype.val h), fun z => by
        obtain ⟨a, ha⟩ := hsurj z.1 z.2
        exact ⟨a, Subtype.ext ha⟩⟩
    refine ⟨(ψ : Q →+* ↥(wcNdFix I)).comp q, ?_, Htrans _ Q _ q ψ hQ⟩
    apply RingHom.ext
    intro c
    apply Subtype.ext
    exact hθC c

  rcases hP with ⟨f, hfC, hf⟩ | ⟨g, hgm, hg0, f, hfC, hf⟩
  ·
    have hσ : ∀ c, IsUnit (σ c) ↔ c ∉ IsLocalRing.maximalIdeal ↥W := by
      intro c
      rw [← hfC, RingHom.comp_apply, hf.2.1, charA, Polynomial.coeff_C_zero]
    have hpA := @Hprime _ _ _ P _ _ f hf.2.1
    have hfX : f Polynomial.X ∈ IsLocalRing.maximalIdeal P := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hf.2.1, not_not, charA,
        Polynomial.coeff_X_zero]
      exact Ideal.zero_mem _
    obtain ⟨hPdom, -⟩ := wcNd_hens_normal_domain (Polynomial ↥W) _ hpA P f hf
    left
    exact finishA _ (hNfix _) (hNmax _ hfX) hPdom hσ
      (fun Q _ q hQ θ hθl hθC hθX =>
        wcNd_normA_core Ω W hW hWt P σ f hfC hf I hI Q q hQ θ hθl hθC hθX)
  ·
    have hσ : ∀ c, IsUnit (σ c) ↔ c ∉ IsLocalRing.maximalIdeal ↥W := by
      intro c
      rw [← hfC, RingHom.comp_apply, RingHom.comp_apply, hf.2.1, charB g hgm,
        MvPolynomial.constantCoeff_C]
    have hpB := @Hprime (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) _ _ P _ _ _ hf.2.1
    haveI := (wcNd_nodal_poly_normal Ω W g hg0).1
    haveI := (wcNd_nodal_poly_normal Ω W g hg0).2
    obtain ⟨hPdom, -⟩ := wcNd_hens_normal_domain (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) _ hpB P _ hf
    have hu : f (Ideal.Quotient.mk _ (MvPolynomial.X 0)) ∈ IsLocalRing.maximalIdeal P := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hf.2.1, not_not, charB g hgm,
        MvPolynomial.constantCoeff_X]
      exact Ideal.zero_mem _
    have hv : f (Ideal.Quotient.mk _ (MvPolynomial.X 1)) ∈ IsLocalRing.maximalIdeal P := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hf.2.1, not_not, charB g hgm,
        MvPolynomial.constantCoeff_X]
      exact Ideal.zero_mem _
    have huv : f (Ideal.Quotient.mk _ (MvPolynomial.X 0)) * f (Ideal.Quotient.mk _ (MvPolynomial.X 1))
        = σ g := by
      rw [← map_mul, ← map_mul, ← hfC, RingHom.comp_apply, RingHom.comp_apply]
      congr 1
      rw [Ideal.Quotient.eq]
      exact Ideal.subset_span rfl
    by_cases hJ : ∀ τ ∈ I, Ideal.map τ ((IsLocalRing.maximalIdeal ↥W).map σ ⊔
        Ideal.span {f (Ideal.Quotient.mk _ (MvPolynomial.X 1))}) =
      (IsLocalRing.maximalIdeal ↥W).map σ ⊔ Ideal.span {f (Ideal.Quotient.mk _ (MvPolynomial.X 1))}
    ·
      right
      have hd : 0 < Fintype.card ↥I := Fintype.card_pos
      have hgd : g ^ Fintype.card ↥I ∈ IsLocalRing.maximalIdeal ↥W :=
        Ideal.pow_mem_of_mem _ hgm _ hd
      have hgd0 : g ^ Fintype.card ↥I ≠ 0 := pow_ne_zero _ hg0
      obtain ⟨x, hx⟩ : ∃ x : P, x = ∏ τ : ↥I, (τ : P ≃+* P) (f (Ideal.Quotient.mk _ (MvPolynomial.X 0))) :=
        ⟨_, rfl⟩
      obtain ⟨y, hy⟩ : ∃ y : P, y = ∏ τ : ↥I, (τ : P ≃+* P) (f (Ideal.Quotient.mk _ (MvPolynomial.X 1))) :=
        ⟨_, rfl⟩
      have hxI : ∀ τ ∈ I, τ x = x := fun τ hτ => by rw [hx]; exact hNfix _ τ hτ
      have hyI : ∀ τ ∈ I, τ y = y := fun τ hτ => by rw [hy]; exact hNfix _ τ hτ
      have hxm : x ∈ IsLocalRing.maximalIdeal P := by rw [hx]; exact hNmax _ hu
      have hym : y ∈ IsLocalRing.maximalIdeal P := by rw [hy]; exact hNmax _ hv
      have hxy : x * y = σ (g ^ Fintype.card ↥I) := by
        rw [hx, hy, ← Finset.prod_mul_distrib, map_pow]
        have e : ∀ τ : ↥I, (τ : P ≃+* P) (f (Ideal.Quotient.mk _ (MvPolynomial.X 0))) *
            (τ : P ≃+* P) (f (Ideal.Quotient.mk _ (MvPolynomial.X 1))) = σ g := by
          intro τ
          rw [← map_mul, huv, hIc g τ τ.2]
        simp only [e, Finset.prod_const, Finset.card_univ]
      have H : ∀ a ∈ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C (g ^ Fintype.card ↥I)}, MvPolynomial.eval₂Hom σ (![x, y] : Fin 2 → P) a = 0 := by
        intro a ha
        obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
        rw [map_mul, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
          MvPolynomial.eval₂Hom_C]
        simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
        rw [hxy, sub_self, mul_zero]
      have hg₀ := unitB _ hgd x y hxm hym H hσ
      have hpB' := @Hprime (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (g ^ Fintype.card ↥I)}) _ _ P _ _ _ hg₀
      have hinv : ∀ τ ∈ I, (τ : P →+* P).comp
          (Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom σ (![x, y] : Fin 2 → P)) H) =
          Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom σ (![x, y] : Fin 2 → P)) H := by
        intro τ hτ
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro c
          simp [hIc c τ hτ]
        · intro i
          fin_cases i
          · simp [hxI τ hτ]
          · simp [hyI τ hτ]
      obtain ⟨Q, iQ, q, hQ⟩ := wcNd_hens_exists (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (g ^ Fintype.card ↥I)}) _ hpB'
      haveI := (wcNd_nodal_poly_normal Ω W _ hgd0).1
      haveI := (wcNd_nodal_poly_normal Ω W _ hgd0).2
      obtain ⟨hQdom, hQic⟩ := wcNd_hens_normal_domain (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (g ^ Fintype.card ↥I)}) _ hpB' Q q hQ
      obtain ⟨θ, hθq, hθl, hθI⟩ := Hfix _ Q q hQ _ hg₀ hinv
      have hθC : ∀ c, θ (q (Ideal.Quotient.mk _ (MvPolynomial.C c))) = σ c := fun c => by
        rw [← RingHom.comp_apply θ q, hθq]
        simp
      have hθX0 : θ (q (Ideal.Quotient.mk _ (MvPolynomial.X 0))) =
          ∏ τ : ↥I, (τ : P ≃+* P) (f (Ideal.Quotient.mk _ (MvPolynomial.X 0))) := by
        rw [← RingHom.comp_apply θ q, hθq, ← hx]
        simp
      have hθX1 : θ (q (Ideal.Quotient.mk _ (MvPolynomial.X 1))) =
          ∏ τ : ↥I, (τ : P ≃+* P) (f (Ideal.Quotient.mk _ (MvPolynomial.X 1))) := by
        rw [← RingHom.comp_apply θ q, hθq, ← hy]
        simp
      obtain ⟨hinj, hint, hdep⟩ := wcNd_normB1_core Ω W hW hWt P σ g hgm hg0 f hfC hf I hI hJ
        Q q hQ θ hθl hθC hθX0 hθX1
      haveI := hPdom
      have hsurj := wcNd_galois_normal_criterion P Q I θ hinj hθI hint hdep
      let ψ : Q ≃+* ↥(wcNdFix I) := RingEquiv.ofBijective (θ.codRestrict (wcNdFix I) hθI)
        ⟨fun a b h => hinj (congrArg Subtype.val h), fun z => by
          obtain ⟨a, ha⟩ := hsurj z.1 z.2
          exact ⟨a, Subtype.ext ha⟩⟩
      refine ⟨g ^ Fintype.card ↥I, hgd, hgd0, (ψ : Q →+* ↥(wcNdFix I)).comp q, ?_,
        Htrans _ Q _ q ψ hQ⟩
      apply RingHom.ext
      intro c
      apply Subtype.ext
      exact hθC c
    ·
      left
      obtain ⟨x, hxI, hxu, hcore⟩ :=
        wcNd_normB2_core Ω W hW hWt P σ g hgm hg0 f hfC hf I hI hJ
      have hxm : x ∈ IsLocalRing.maximalIdeal P := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        exact hxu
      exact finishA x hxI hxm hPdom hσ hcore

theorem wcpa_dj_llsm_sd_invariant_pair : ∀ (K : Type u) [Field K] (M L : Type u) [Field M]
    [Field L] [Algebra K M] [Algebra M L] [Algebra K L] [IsScalarTower K M L]
    [FiniteDimensional K L] [IsGalois K L] (R : Type u) [CommRing R] [Algebra R K]
    (D : Subalgebra R K),
    ∃ (i : ↥(integralClosure ↥D M) →+* ↥(integralClosure ↥D L))
      (H₀ : Subgroup (↥(integralClosure ↥D L) ≃+* ↥(integralClosure ↥D L))),
      Function.Injective i ∧ (Module.Finite ↥D ↥(integralClosure ↥D L) → i.Finite) ∧
      Finite ↥H₀ ∧ (∀ h ∈ H₀, ∀ a, h (i a) = i a) ∧
      (∀ b, (∀ h ∈ H₀, h b = b) → ∃ a, i a = b) ∧
      ∀ d : ↥D, i (algebraMap ↥D ↥(integralClosure ↥D M) d) =
        algebraMap ↥D ↥(integralClosure ↥D L) d :=
by
  intro K _ M L _ _ _ _ _ _ _ _ R _ _ D
  haveI hFD : FiniteDimensional M L := Module.Finite.of_restrictScalars_finite K M L
  haveI hGal : IsGalois M L := IsGalois.tower_top_of_isGalois K M L
  let ι : M →ₐ[↥D] L := IsScalarTower.toAlgHom ↥D M L
  have hιinj : Function.Injective ι := (algebraMap M L).injective
  let i : ↥(integralClosure ↥D M) →+* ↥(integralClosure ↥D L) :=
    { toFun := fun a => ⟨algebraMap M L a, a.2.map ι⟩
      map_one' := Subtype.ext (map_one (algebraMap M L))
      map_mul' := fun a b => Subtype.ext (map_mul (algebraMap M L) _ _)
      map_zero' := Subtype.ext (map_zero (algebraMap M L))
      map_add' := fun a b => Subtype.ext (map_add (algebraMap M L) _ _) }
  have hi : ∀ a, ((i a : ↥(integralClosure ↥D L)) : L) = algebraMap M L (a : M) := fun a => rfl
  let Φf : (L ≃ₐ[M] L) → (↥(integralClosure ↥D L) ≃+* ↥(integralClosure ↥D L)) := fun σ =>
    { toFun := fun b => ⟨σ b, b.2.map ((σ.restrictScalars ↥D : L ≃ₐ[↥D] L) : L →ₐ[↥D] L)⟩
      invFun := fun b =>
        ⟨σ.symm b, b.2.map ((σ.symm.restrictScalars ↥D : L ≃ₐ[↥D] L) : L →ₐ[↥D] L)⟩
      left_inv := fun b => Subtype.ext (σ.symm_apply_apply _)
      right_inv := fun b => Subtype.ext (σ.apply_symm_apply _)
      map_mul' := fun a b => Subtype.ext (map_mul σ _ _)
      map_add' := fun a b => Subtype.ext (map_add σ _ _) }
  have hΦf : ∀ σ b, ((Φf σ b : ↥(integralClosure ↥D L)) : L) = σ (b : L) := fun _ _ => rfl
  let Φ : (L ≃ₐ[M] L) →* (↥(integralClosure ↥D L) ≃+* ↥(integralClosure ↥D L)) :=
    MonoidHom.mk' Φf (fun σ τ => by
      apply RingEquiv.ext
      intro b
      apply Subtype.ext
      rw [RingAut.mul_apply, hΦf, hΦf, hΦf, AlgEquiv.mul_apply])
  have hcompat : ∀ d : ↥D, i (algebraMap ↥D ↥(integralClosure ↥D M) d) =
      algebraMap ↥D ↥(integralClosure ↥D L) d := by
    intro d
    apply Subtype.ext
    rw [hi]
    exact (IsScalarTower.algebraMap_apply (↥D) M L d).symm
  refine ⟨i, Φ.range, ?_, ?_, ?_, ?_, ?_, hcompat⟩
  · intro a a' h
    apply Subtype.ext
    apply (algebraMap M L).injective
    rw [← hi, ← hi, h]
  · intro hfin
    have h1 : (algebraMap ↥D ↥(integralClosure ↥D L)).Finite := RingHom.finite_algebraMap.mpr hfin
    have h2 : algebraMap ↥D ↥(integralClosure ↥D L) =
        i.comp (algebraMap ↥D ↥(integralClosure ↥D M)) :=
      RingHom.ext (fun d => (hcompat d).symm)
    rw [h2] at h1
    exact RingHom.Finite.of_comp_finite h1
  · exact Finite.of_surjective _ (MonoidHom.rangeRestrict_surjective Φ)
  · rintro h ⟨σ, rfl⟩ a
    apply Subtype.ext
    show σ (algebraMap M L (a : M)) = algebraMap M L (a : M)
    exact σ.commutes _
  · intro b hb
    have hfix : ∀ σ : L ≃ₐ[M] L, σ (b : L) = (b : L) := by
      intro σ
      have h1 := hb (Φ σ) ⟨σ, rfl⟩
      exact congrArg Subtype.val h1
    obtain ⟨x, hx⟩ := (IsGalois.mem_range_algebraMap_iff_fixed (F := M) (E := L) (b : L)).mpr hfix
    have hxint : IsIntegral ↥D x := by
      have hb2 : IsIntegral ↥D (ι x) := by
        show IsIntegral ↥D (algebraMap M L x)
        rw [hx]; exact b.2
      exact (isIntegral_algHom_iff ι hιinj).mp hb2
    refine ⟨⟨x, hxint⟩, ?_⟩
    apply Subtype.ext
    rw [hi]
    exact hx

theorem wcpa_dj_llsm_nss_sep_descends : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M L : Type u) [Field M] [Field L] [Algebra K M] [Algebra M L]
    [Algebra K L] [IsScalarTower K M L] [FiniteDimensional K L] [IsGalois K L]
    (𝔭 : Ideal A) (k : wcLlsKind W A), wcLlsPD W A 𝔭 k →
    ∀ (z0 : A) (b : ↥W), b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    ((∃ (t : A) (c : ↥W), k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧
        z0 = t - algebraMap ↥W A c) ∨
      (∃ (u v : A) (g : ↥W), k = .ann u v g ∧ b ∣ g ∧ z0 = u)) →
    wcLlsSepAt W A K L z0 (algebraMap A K (algebraMap ↥W A b) / algebraMap A K z0) →
    wcLlsSepAt W A K M z0 (algebraMap A K (algebraMap ↥W A b) / algebraMap A K z0) :=
by
