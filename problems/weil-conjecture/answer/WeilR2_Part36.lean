  haveI : Flat uX := hM.1.1
  haveI : IrreducibleSpace ↥(wcProjK Ω 1) := wc_proj_space_irreducible Ω 1
  haveI : Nonempty C := IsIntegral.nonempty

  have s1 : γ (genericPoint ↥C) = genericPoint ↥(wcProjK Ω 1) := by
    obtain ⟨V, hVd, hVe⟩ := hcov.2.2.2.2
    haveI := hVe
    have hne : (V : Set C).Nonempty := hVd.nonempty
    have hmem : genericPoint ↥C ∈ (V : Set C) :=
      ((genericPoint_spec ↥C).mem_open_set_iff V.isOpen).mpr (by simpa using hne)
    have hsp : genericPoint ↥(wcProjK Ω 1) ⤳ (V.ι ≫ γ) (⟨genericPoint ↥C, hmem⟩ : V) :=
      (genericPoint_spec _).specializes (Set.mem_univ _)
    obtain ⟨a', ha', ha'e⟩ := Flat.generalizingMap (V.ι ≫ γ) hsp
    have e1 : V.ι a' ⤳ genericPoint ↥C := by
      first
        | exact ha'.map V.ι.continuous
        | simpa using ha'.map V.ι.continuous
    have e2 : genericPoint ↥C ⤳ V.ι a' := (genericPoint_spec ↥C).specializes (Set.mem_univ _)
    have h1 : V.ι a' = genericPoint ↥C := (e1.antisymm e2).eq
    rw [← h1, ← Scheme.Hom.comp_apply, ha'e]

  have s2 : ∀ z : X, ι (genericPoint ↥(wcProjK Ω 1)) ⤳ z := by
    intro z
    have hpb := hM.2.2
    let pt : ↥(Spec (.of Ω)) := IsLocalRing.closedPoint Ω
    have h0 : PrimeSpectrum.asIdeal ((Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) pt) = ⊥ := by
      show Ideal.comap (algebraMap ↥W Ω) (PrimeSpectrum.asIdeal pt) = ⊥
      haveI : (PrimeSpectrum.asIdeal pt).IsPrime := pt.2
      rw [Ideal.eq_bot_of_prime (PrimeSpectrum.asIdeal pt)]
      exact Ideal.comap_bot_of_injective _ (fun a b h => Subtype.ext h)
    have hgen : (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) pt ⤳ uX z := by
      have hle : PrimeSpectrum.asIdeal ((Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) pt) ≤
          PrimeSpectrum.asIdeal (uX z) := by rw [h0]; exact bot_le
      exact (PrimeSpectrum.le_iff_specializes _ _).mp ((PrimeSpectrum.asIdeal_le_asIdeal _ _).mp hle)
    obtain ⟨z', hz', hz'e⟩ := Flat.generalizingMap uX hgen
    obtain ⟨t, ht, -⟩ := Scheme.Pullback.exists_preimage_pullback z' pt hz'e
    have hp : ι (hpb.isoPullback.inv t) = z' := by
      rw [← Scheme.Hom.comp_apply, hpb.isoPullback_inv_fst, ht]
    have hg : genericPoint ↥(wcProjK Ω 1) ⤳ hpb.isoPullback.inv t :=
      (genericPoint_spec _).specializes (Set.mem_univ _)
    exact (hp ▸ hg.map ι.continuous).trans hz'

  have s3 : ∀ σ : Spec (.of ↥W) ⟶ X, σ ≫ uX = 𝟙 _ →
      IsClosed ({σ (IsLocalRing.closedPoint ↥W)} : Set X) := by
    intro σ hσ
    haveI : IsClosedImmersion (σ ≫ uX) := by rw [hσ]; infer_instance
    haveI : IsClosedImmersion σ := IsClosedImmersion.of_comp σ uX
    have := (Scheme.Hom.isClosedEmbedding σ).isClosedMap
      ({(IsLocalRing.closedPoint ↥W : ↥(Spec (.of ↥W)))} : Set ↥(Spec (.of ↥W)))
      (IsLocalRing.isClosed_singleton_closedPoint ↥W)
    convert this using 1
    ext y
    constructor
    · intro hy
      change y = σ (IsLocalRing.closedPoint ↥W) at hy
      exact ⟨IsLocalRing.closedPoint ↥W, rfl, hy.symm⟩
    · rintro ⟨a, ha, rfl⟩
      change a = IsLocalRing.closedPoint ↥W at ha
      change σ a = σ (IsLocalRing.closedPoint ↥W)
      rw [ha]

  have s4 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (Y : Scheme.{u}) (uY : Y ⟶ Spec (.of R)),
      Topology.IsClosedEmbedding ⇑(Limits.pullback.fst uY
        (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))) ∧
      ∀ z : Y, (uY z = IsLocalRing.closedPoint R ↔ ∃ w, (Limits.pullback.fst uY
        (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))) w = z) := by
    intro R _ _ Y uY
    have hF : ∀ p : ↥(Spec (.of (IsLocalRing.ResidueField R))),
        (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))) p =
          IsLocalRing.closedPoint R := by
      intro p
      apply PrimeSpectrum.ext
      show Ideal.comap (algebraMap R (IsLocalRing.ResidueField R)) p.asIdeal =
        IsLocalRing.maximalIdeal R
      haveI : p.asIdeal.IsPrime := p.2
      rw [Ideal.eq_bot_of_prime p.asIdeal, ← RingHom.ker_eq_comap_bot,
        IsLocalRing.ResidueField.algebraMap_eq, IsLocalRing.ker_residue]
    haveI : IsClosedImmersion
        (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))) := by
      apply IsClosedImmersion.spec_of_surjective
      show Function.Surjective (algebraMap R (IsLocalRing.ResidueField R))
      rw [IsLocalRing.ResidueField.algebraMap_eq]
      exact IsLocalRing.residue_surjective
    refine ⟨Scheme.Hom.isClosedEmbedding _, fun z => ⟨fun hz => ?_, ?_⟩⟩
    · obtain ⟨t, ht, -⟩ := Scheme.Pullback.exists_preimage_pullback z
        (IsLocalRing.closedPoint (IsLocalRing.ResidueField R)) (hz.trans (hF _).symm)
      exact ⟨t, ht⟩
    · rintro ⟨w, rfl⟩
      rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply, hF]

  have s6 : ∀ (Y : Scheme.{u}) (w : Y),
      ringKrullDim (Y.presheaf.stalk w) = ((1 : ℕ) : WithBot ℕ∞) →
      ∃ η' : Y, η' ⤳ w ∧ η' ≠ w ∧ ∀ w'' : Y, w'' ⤳ η' → w'' = η' := by
    intro Y w hdim
    obtain ⟨P, hPmin, -⟩ := Ideal.exists_minimalPrimes_le
      (I := (⊥ : Ideal (Y.presheaf.stalk w))) (J := IsLocalRing.maximalIdeal _) bot_le
    have hPmin' : Minimal (fun q : Ideal (Y.presheaf.stalk w) => q.IsPrime ∧ ⊥ ≤ q) P := hPmin
    haveI hPp : P.IsPrime := Ideal.minimalPrimes_isPrime hPmin
    let P₀ : ↥(Spec (Y.presheaf.stalk w)) := (⟨P, hPp⟩ : PrimeSpectrum (Y.presheaf.stalk w))
    have hemb := Scheme.Hom.isEmbedding (Y.fromSpecStalk w)
    have hη : Y.fromSpecStalk w P₀ ⤳ w := by
      have : Y.fromSpecStalk w P₀ ∈ Set.range (Y.fromSpecStalk w) := ⟨P₀, rfl⟩
      rw [Scheme.range_fromSpecStalk] at this
      exact this
    refine ⟨Y.fromSpecStalk w P₀, hη, ?_, ?_⟩
    · intro heq
      have heq' := heq.trans (Scheme.fromSpecStalk_closedPoint (x := w)).symm
      have hP : P₀ = IsLocalRing.closedPoint _ := hemb.injective heq'
      have hPm : P = IsLocalRing.maximalIdeal _ := congrArg PrimeSpectrum.asIdeal hP
      have h0 : Ring.KrullDimLE 0 (Y.presheaf.stalk w) := by
        rw [Ring.krullDimLE_zero_iff]
        intro I hI
        have h1 : I ≤ IsLocalRing.maximalIdeal _ := IsLocalRing.le_maximalIdeal hI.ne_top
        have h2 : P ≤ I := Minimal.le_of_le hPmin' ⟨hI, bot_le⟩ (by rw [hPm]; exact h1)
        rw [hPm] at h2
        rw [le_antisymm h1 h2]
        infer_instance
      have h3 := Ring.krullDimLE_iff.mp h0
      rw [hdim] at h3
      have h4 : (1 : ℕ) ≤ 0 := by exact_mod_cast h3
      omega
    · intro w'' hw''
      have hw : w'' ∈ Set.range (Y.fromSpecStalk w) := by
        rw [Scheme.range_fromSpecStalk]; exact hw''.trans hη
      obtain ⟨Q, rfl⟩ := hw
      have hQ : Q ⤳ P₀ := hemb.isInducing.specializes_iff.mp hw''
      have hQ' : PrimeSpectrum.asIdeal Q ≤ P :=
        (PrimeSpectrum.asIdeal_le_asIdeal Q P₀).mpr ((PrimeSpectrum.le_iff_specializes Q P₀).mpr hQ)
      have hPQ : P ≤ PrimeSpectrum.asIdeal Q :=
        Minimal.le_of_le hPmin' ⟨Q.isPrime, bot_le⟩ hQ'
      have hQP : Q = P₀ := PrimeSpectrum.ext (le_antisymm hQ' hPQ)
      rw [hQP]

  have main : ∀ (Y : Scheme.{u}) (j : Y ⟶ X) (w : Y), Topology.IsClosedEmbedding ⇑j →
      (∀ z : X, (uX z = IsLocalRing.closedPoint ↥W ↔ ∃ w, j w = z)) →
      ringKrullDim (Y.presheaf.stalk w) = ((1 : ℕ) : WithBot ℕ∞) →
      ∃ (η : X) (_ : (γ ≫ ι) (genericPoint C) ⤳ η), η ⤳ j w ∧ η ≠ j w ∧
        uX η = IsLocalRing.closedPoint ↥W ∧
        (∀ η' : X, uX η' = IsLocalRing.closedPoint ↥W → η' ⤳ η → η' = η) := by
    intro Y j w hj hfib hdim
    obtain ⟨η₀, h1, h2, h3⟩ := s6 Y w hdim
    refine ⟨j η₀, ?_, h1.map j.continuous, fun h => h2 (hj.isEmbedding.injective h),
      (hfib _).mpr ⟨η₀, rfl⟩, ?_⟩
    · rw [Scheme.Hom.comp_apply, s1]
      exact s2 (j η₀)
    · intro η' hη' hsp
      obtain ⟨w'', rfl⟩ := (hfib η').mp hη'
      rw [hj.isInducing.specializes_iff] at hsp
      rw [h3 w'' hsp]

  obtain ⟨σ, hσ, hσx, -⟩ := hτ.2.1 0 (Ideal.zero_mem _)
  have hxcl : IsClosed ({wcpaDjLkImg W (γ ≫ ι) uX y₀} : Set X) := by
    rw [← hσx]; exact s3 σ hσ
  obtain ⟨hj, hfib⟩ := s4 ↥W X uX
  obtain ⟨U, hwU, hsm⟩ := hSm
  haveI := hsm
  have hwcl : IsClosed ({wcpaDjLkPi W (γ ≫ ι) uX y₀} : Set ↥(Limits.pullback uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) := by
    have e : ({wcpaDjLkPi W (γ ≫ ι) uX y₀} : Set ↥(Limits.pullback uX
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) =
        (Limits.pullback.fst uX (Spec.map (CommRingCat.ofHom
          (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ⁻¹' {wcpaDjLkImg W (γ ≫ ι) uX y₀} := by
      ext a
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl; rfl
      · intro h; exact hj.isEmbedding.injective h
    rw [e]; exact hxcl.preimage (Scheme.Hom.continuous _)
  have hz : IsClosed ({(⟨wcpaDjLkPi W (γ ≫ ι) uX y₀, hwU⟩ : U)} : Set U.toScheme) := by
    have e : ({(⟨wcpaDjLkPi W (γ ≫ ι) uX y₀, hwU⟩ : U)} : Set U.toScheme) =
        U.ι ⁻¹' {wcpaDjLkPi W (γ ≫ ι) uX y₀} := by
      ext a
      simp only [Set.mem_singleton_iff, Set.mem_preimage, Scheme.Opens.ι_apply]
      constructor
      · rintro rfl; rfl
      · intro h; exact Subtype.ext h
    rw [e]; exact hwcl.preimage (Scheme.Hom.continuous _)
  have hU := wc_lfi_smooth_stalk_dim (IsLocalRing.ResidueField ↥W) U.toScheme
    (U.ι ≫ Limits.pullback.snd uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) 1
    ⟨wcpaDjLkPi W (γ ≫ ι) uX y₀, hwU⟩ hz
  have hdim : ringKrullDim ((Limits.pullback uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk
        (wcpaDjLkPi W (γ ≫ ι) uX y₀)) = ((1 : ℕ) : WithBot ℕ∞) :=
    (ringKrullDim_eq_of_ringEquiv
      (U.stalkIso ⟨wcpaDjLkPi W (γ ≫ ι) uX y₀, hwU⟩).commRingCatIsoToRingEquiv).symm.trans hU
  exact main _ (Limits.pullback.fst uX
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
    (wcpaDjLkPi W (γ ≫ ι) uX y₀) hj hfib hdim

theorem wcpa_dj_lr1k_nsr_bv_composite : ∀ (Rx Rη L : Type u) [CommRing Rx] [IsLocalRing Rx] [CommRing Rη] [IsLocalRing Rη] [Field L] (sp : Rx →+* Rη) (g : Rη →+* L), ∃ A : ValuationSubring L, (∀ s : Rx, g (sp s) ∈ A) ∧ (∀ s : Rx, ∀ a : L, a ∈ A → g (sp s) * a = 1 → IsUnit s) ∧ (∀ s ∈ IsLocalRing.maximalIdeal Rη, A.valuation (g s) < 1) :=
by
  intro Rx Rη L _ _ _ _ _ sp g
  classical
  set res := IsLocalRing.residue Rη with hres
  set D : Subring Rη := Subring.comap res (res.comp sp).range with hD
  have memD : ∀ d : Rη, d ∈ D ↔ ∃ r : Rx, res (sp r) = res d := fun d => Iff.rfl
  have spD : ∀ s : Rx, sp s ∈ D := fun s => (memD _).mpr ⟨s, rfl⟩

  have s2 : ∀ (s r : Rx) (d d' : Rη), s ∈ IsLocalRing.maximalIdeal Rx → res d = res (sp s) →
      res d' = res (sp r) → IsUnit (1 - d * d') := by
    intro s r d d' hs hd hd'
    have hsr : s * r ∈ IsLocalRing.maximalIdeal Rx := Ideal.mul_mem_right r _ hs
    have hu : IsUnit (1 - s * r) := by
      by_contra h
      have h1 : 1 - s * r ∈ IsLocalRing.maximalIdeal Rx := (IsLocalRing.mem_maximalIdeal _).mpr h
      have h2 := Ideal.add_mem _ h1 hsr
      rw [sub_add_cancel] at h2
      exact (IsLocalRing.maximalIdeal.isMaximal Rx).ne_top ((Ideal.eq_top_iff_one _).mpr h2)
    have hu' : IsUnit (res (sp (1 - s * r))) := (hu.map sp).map res
    have heq : res (1 - d * d') = res (sp (1 - s * r)) := by
      simp only [map_sub, map_one, map_mul, hd, hd']
    rw [← heq] at hu'
    exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mp hu'.ne_zero

  have unitD : ∀ (d : Rη) (hd : d ∈ D) (r : Rx), res (sp r) = res d → IsUnit r →
      IsUnit (⟨d, hd⟩ : D) := by
    intro d hd r hr hu
    have hres0 : res d ≠ 0 := by rw [← hr]; exact ((hu.map sp).map res).ne_zero
    have hdu : IsUnit d := (IsLocalRing.residue_ne_zero_iff_isUnit _).mp hres0
    obtain ⟨e, he⟩ : ∃ e, d * e = 1 := hdu.exists_right_inv
    obtain ⟨r', hr'⟩ : ∃ r', r * r' = 1 := hu.exists_right_inv
    have heD : e ∈ D := by
      rw [memD]
      refine ⟨r', ?_⟩
      have h1 : res d * res e = 1 := by rw [← map_mul, he, map_one]
      have h2 : res d * res (sp r') = 1 := by rw [← hr, ← map_mul, ← map_mul, hr', map_one, map_one]
      exact mul_left_cancel₀ hres0 (h2.trans h1.symm)
    exact IsUnit.of_mul_eq_one (⟨e, heD⟩ : D) (Subtype.ext he)

  have hDloc : IsLocalRing D := by
    apply IsLocalRing.of_isUnit_or_isUnit_one_sub_self
    rintro ⟨d, hd⟩
    obtain ⟨r, hr⟩ := (memD d).mp hd
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self r with h | h
    · exact Or.inl (unitD d hd r hr h)
    · right
      have hd1 : 1 - d ∈ D := D.sub_mem D.one_mem hd
      have h' := unitD (1 - d) hd1 (1 - r) (by simp only [map_sub, map_one, hr]) h
      have e : (1 - ⟨d, hd⟩ : D) = ⟨1 - d, hd1⟩ := rfl
      rw [e]
      exact h'
  haveI := hDloc

  let S : Subring L := D.map g
  haveI hSloc : IsLocalRing S := inferInstance
  obtain ⟨A, hA⟩ := LocalSubring.exists_le_valuationSubring (LocalSubring.mk S)
  obtain ⟨hSA, hloc⟩ := (LocalSubring.le_def).mp hA
  have hgA : ∀ d ∈ D, g d ∈ A := fun d hd => hSA (Subring.mem_map.mpr ⟨d, hd, rfl⟩)

  have key : ∀ (d : Rη) (hd : d ∈ D) (s : Rx), s ∈ IsLocalRing.maximalIdeal Rx →
      res d = res (sp s) → ¬ IsUnit (⟨g d, hgA d hd⟩ : A) := by
    intro d hd s hs hds hu
    have hmS : g d ∈ S := Subring.mem_map.mpr ⟨d, hd, rfl⟩
    have hu' : IsUnit (Subring.inclusion hSA ⟨g d, hmS⟩) := hu
    have huS : IsUnit (⟨g d, hmS⟩ : S) := isUnit_of_map_unit (Subring.inclusion hSA) _ hu'
    obtain ⟨v, hv⟩ : ∃ v : S, (⟨g d, hmS⟩ : S) * v = 1 := huS.exists_right_inv
    obtain ⟨d', hd', hgd'⟩ := Subring.mem_map.mp v.2
    obtain ⟨r, hr⟩ := (memD d').mp hd'
    have h1 : g d * g d' = 1 := by
      rw [hgd']; exact congrArg Subtype.val hv
    have h2 := s2 s r d d' hs hds hr.symm
    have h3 : g (1 - d * d') = 0 := by rw [map_sub, map_one, map_mul, h1, sub_self]
    exact (h2.map g).ne_zero h3

  refine ⟨A, fun s => hgA (sp s) (spD s), ?_, ?_⟩
  · intro s a ha h
    by_contra hns
    have hs : s ∈ IsLocalRing.maximalIdeal Rx := (IsLocalRing.mem_maximalIdeal _).mpr hns
    exact key (sp s) (spD s) s hs rfl (IsUnit.of_mul_eq_one (⟨a, ha⟩ : A) (Subtype.ext h))
  · intro s hs
    have hs0 : res s = 0 := (IsLocalRing.residue_eq_zero_iff s).mpr hs
    have hsD : s ∈ D := (memD s).mpr ⟨0, by rw [map_zero, map_zero, hs0]⟩
    have hnu := key s hsD 0 (Ideal.zero_mem _) (by rw [map_zero, map_zero, hs0])
    have hm : (⟨g s, hgA s hsD⟩ : A) ∈ IsLocalRing.maximalIdeal A :=
      (IsLocalRing.mem_maximalIdeal _).mpr hnu
    exact (ValuationSubring.valuation_lt_one_iff A _).mp hm

theorem wcpa_dj_lr1k_nsr_bv_u_element : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X), wcpaDjLkModel W uX ι → ∀ (x : X) (A : ValuationSubring C.functionField), wcNsrBdry W (γ ≫ ι) uX x A → (∀ ω : ↥W, wcLr1uConst (γ ≫ wcProjKStr Ω 1) (ω : Ω) ∈ A) ∧ (∀ ω : ↥W, ω ∈ IsLocalRing.maximalIdeal ↥W → A.valuation (wcLr1uConst (γ ≫ wcProjKStr Ω 1) (ω : Ω)) < 1) ∧ ∃ u : C.functionField, u ≠ 0 ∧ A.valuation u < 1 ∧ ∀ c : ↥W, c ≠ 0 → c ∈ IsLocalRing.maximalIdeal ↥W → ∀ n : ℕ, A.valuation (wcLr1uConst (γ ≫ wcProjKStr Ω 1) (c : Ω)) < A.valuation u ^ n :=
by
  intro Ω _ _ W _hW _hWt C _ γ _hcov X uX ι hM x A hA
  classical
  unfold wcNsrBdry wcNsrCentred wcLr1uDom at hA
  obtain ⟨⟨hx, hB1a, hB1b⟩, η, hη, hηx, hne, hcl, -, hB3⟩ := hA

  have hsq : (γ ≫ ι) ≫ uX =
      (γ ≫ wcProjKStr Ω 1) ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) :=
    (Category.assoc _ _ _).trans ((congrArg (γ ≫ ·) hM.2.2.w).trans (Category.assoc _ _ _).symm)

  have e1 : uX.appTop ≫ (γ ≫ ι).app ⊤ =
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))).appTop ≫ (γ ≫ wcProjKStr Ω 1).appTop := by
    have h0 := Scheme.Hom.comp_appTop (γ ≫ ι) uX
    rw [hsq, Scheme.Hom.comp_appTop (γ ≫ wcProjKStr Ω 1)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))] at h0
    exact h0.symm
  have hstarM : ∀ (y : X) (h : (γ ≫ ι) (genericPoint C) ⤳ y),
      (Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫ X.presheaf.germ ⊤ y trivial ≫
        wcLr1uGerm (γ ≫ ι) y h =
      CommRingCat.ofHom (algebraMap ↥W Ω) ≫ (Scheme.ΓSpecIso (.of Ω)).inv ≫
        (γ ≫ wcProjKStr Ω 1).appTop ≫ C.presheaf.germ ⊤ (genericPoint C) trivial := by
    intro y h
    have hg : X.presheaf.germ ⊤ y trivial ≫ X.presheaf.stalkSpecializes h =
        X.presheaf.germ ⊤ ((γ ≫ ι) (genericPoint C)) trivial :=
      TopCat.Presheaf.germ_stalkSpecializes _ _ _
    have hm := Scheme.Hom.germ_stalkMap (γ ≫ ι) ⊤ (genericPoint C) trivial
    have key : X.presheaf.germ ⊤ y trivial ≫ X.presheaf.stalkSpecializes h ≫
        (γ ≫ ι).stalkMap (genericPoint C) =
        (γ ≫ ι).app ⊤ ≫ C.presheaf.germ ⊤ (genericPoint C) trivial := by
      rw [← Category.assoc, hg, hm]
      rfl
    unfold wcLr1uGerm
    rw [key, ← Category.assoc (CommRingCat.ofHom (algebraMap ↥W Ω)),
      Scheme.ΓSpecIso_inv_naturality, Category.assoc]
    have h5 := congrArg (fun k => (Scheme.ΓSpecIso (.of ↥W)).inv ≫ k ≫
      C.presheaf.germ ⊤ (genericPoint C) trivial) e1
    simp only [Category.assoc] at h5
    exact h5
  have hstar : ∀ (y : X) (h : (γ ≫ ι) (genericPoint C) ⤳ y) (c : ↥W),
      (wcLr1uGerm (γ ≫ ι) y h).hom ((X.presheaf.germ ⊤ y trivial).hom
        (uX.appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom c))) =
      wcLr1uConst (γ ≫ wcProjKStr Ω 1) (c : Ω) := by
    intro y h c
    exact congrArg (fun φ => φ.hom c) (hstarM y h)

  have hclosed : ∀ (y : X), uX y = IsLocalRing.closedPoint ↥W → ∀ c : ↥W,
      c ∈ IsLocalRing.maximalIdeal ↥W →
      (X.presheaf.germ ⊤ y trivial).hom (uX.appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom c)) ∈
        IsLocalRing.maximalIdeal ↑(X.presheaf.stalk y) := by
    intro y hy c hc
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have h1 : y ∈ X.basicOpen (uX.appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom c)) :=
      (X.mem_basicOpen_top _ y).mpr hu
    have h2 : y ∈ uX ⁻¹ᵁ (Spec (.of ↥W)).basicOpen ((Scheme.ΓSpecIso (.of ↥W)).inv.hom c) := by
      rw [Scheme.preimage_basicOpen]
      exact h1
    have h3 : uX y ∈ (Spec (.of ↥W)).basicOpen
        ((ConcreteCategory.hom (Scheme.ΓSpecIso (.of ↥W)).inv) c) := h2
    rw [basicOpen_eq_of_affine, hy] at h3
    exact ((PrimeSpectrum.mem_basicOpen _ _).mp h3) hc

  have hnot : ¬ x ⤳ η := by
    intro h
    exact hne (hηx.antisymm h).eq
  obtain ⟨O, hOopen, hηO, hxO⟩ : ∃ O : Set X, IsOpen O ∧ η ∈ O ∧ x ∉ O := by
    by_contra hcon
    apply hnot
    rw [specializes_iff_forall_open]
    intro s hs hηs
    by_contra hxs
    exact hcon ⟨s, hs, hηs, hxs⟩
  obtain ⟨V, hVaff, hxV, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens)
    (show x ∈ (⊤ : X.Opens) from trivial)
  have hηV : η ∈ V := hηx.mem_open V.isOpen hxV
  obtain ⟨g, hgle, hηg⟩ := (show IsAffineOpen V from hVaff).exists_basicOpen_le
    (V := ⟨O, hOopen⟩ ⊓ V) ⟨η, ⟨hηO, hηV⟩⟩ hηV
  have hu1 : IsUnit ((X.presheaf.germ V η hηV).hom g) := (X.mem_basicOpen g η hηV).mp hηg
  have hu2 : ¬ IsUnit ((X.presheaf.germ V x hxV).hom g) := fun h =>
    hxO (hgle ((X.mem_basicOpen g x hxV).mpr h)).1
  have hgx : X.presheaf.germ V x hxV ≫ wcLr1uGerm (γ ≫ ι) x hx =
      X.presheaf.germ V η hηV ≫ wcLr1uGerm (γ ≫ ι) η hη := by
    unfold wcLr1uGerm
    rw [← Category.assoc, TopCat.Presheaf.germ_stalkSpecializes, ← Category.assoc,
      TopCat.Presheaf.germ_stalkSpecializes]
  set u : C.functionField := (wcLr1uGerm (γ ≫ ι) η hη).hom ((X.presheaf.germ V η hηV).hom g)
    with hu_def
  have hgxe : (wcLr1uGerm (γ ≫ ι) x hx).hom ((X.presheaf.germ V x hxV).hom g) = u :=
    congrArg (fun φ => φ.hom g) hgx
  have hu0 : u ≠ 0 := (hu1.map (wcLr1uGerm (γ ≫ ι) η hη).hom).ne_zero
  have hmem : u ∈ A := by
    rw [← hgxe]
    exact hB1a _
  have hvu_le : A.valuation u ≤ 1 := (A.valuation_le_one_iff u).mpr hmem
  have hvu_lt : A.valuation u < 1 := by
    refine lt_of_le_of_ne hvu_le ?_
    intro h1
    apply hu2
    have hinv : u⁻¹ ∈ A := by
      rw [← A.valuation_le_one_iff, map_inv₀, h1, inv_one]
    exact hB1b _ u⁻¹ hinv (by rw [hgxe]; exact mul_inv_cancel₀ hu0)
  have hvu0 : A.valuation u ≠ 0 := (Valuation.ne_zero_iff _).mpr hu0
  refine ⟨?_, ?_, u, hu0, hvu_lt, ?_⟩
  · intro ω
    have h := hB1a ((X.presheaf.germ ⊤ x trivial).hom
      (uX.appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom ω)))
    rw [hstar x hx ω] at h
    exact h
  · intro ω hω
    have h := hB3 _ (hclosed η hcl ω hω)
    rw [hstar η hη ω] at h
    exact h
  · intro c _hc0 hcm n
    have hm := hclosed η hcl c hcm
    have he := Ideal.mul_mem_right
      (((hu1.unit⁻¹ : (X.presheaf.stalk η)ˣ) : X.presheaf.stalk η) ^ n) _ hm
    have h3 := hB3 _ he
    have hinvu : (wcLr1uGerm (γ ≫ ι) η hη).hom
        ((hu1.unit⁻¹ : (X.presheaf.stalk η)ˣ) : X.presheaf.stalk η) = u⁻¹ := by
      apply eq_inv_of_mul_eq_one_left
      rw [hu_def, ← map_mul, hu1.val_inv_mul, map_one]
    rw [map_mul, map_pow, hinvu, hstar η hη c, Valuation.map_mul, Valuation.map_pow, map_inv₀,
      inv_pow] at h3
    have hpos : 0 < A.valuation u ^ n := zero_lt_iff.mpr (pow_ne_zero n hvu0)
    have h4 := (mul_inv_lt_iff₀ hpos).mp h3
    rwa [one_mul] at h4

theorem wcpa_dj_lr1k_nsr_bv_alg_indep : ∀ (Ω L : Type u) [Field Ω] [Field L] (W : ValuationSubring Ω) (φ : Ω →+* L) (A : ValuationSubring L), (∀ ω : ↥W, φ (ω : Ω) ∈ A) → (∀ ω : ↥W, ω ∈ IsLocalRing.maximalIdeal ↥W → A.valuation (φ (ω : Ω)) < 1) → ∀ u : L, u ≠ 0 → A.valuation u < 1 → (∀ c : ↥W, c ≠ 0 → c ∈ IsLocalRing.maximalIdeal ↥W → ∀ n : ℕ, A.valuation (φ (c : Ω)) < A.valuation u ^ n) → ∀ y : L, (∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) → A.valuation (q.eval₂ (φ.comp W.subtype) y) = 1) → ∀ P : MvPolynomial (Fin 2) Ω, MvPolynomial.eval₂ φ ![u, y] P = 0 → P = 0 :=
by
  intro Ω L _ _ W φ A h1 _h2 u hu0 hu1 hinf y hy P hP
  classical
  by_contra hP0

  have hy1 : A.valuation y = 1 := by
    have := hy Polynomial.X ⟨1, by rw [Polynomial.coeff_X_one]; exact isUnit_one⟩
    rwa [Polynomial.eval₂_X] at this

  have hSne : P.support.Nonempty := MvPolynomial.support_nonempty.mpr hP0
  obtain ⟨dstar, hdstar, hmax⟩ :=
    Finset.exists_max_image P.support (fun d => W.valuation (P.coeff d)) hSne
  obtain ⟨a, ha⟩ : ∃ a, a = P.coeff dstar := ⟨_, rfl⟩
  have ha0 : a ≠ 0 := ha ▸ MvPolynomial.mem_support_iff.mp hdstar
  have hbW : ∀ d, P.coeff d / a ∈ W := by
    intro d
    rw [← ValuationSubring.valuation_le_one_iff]
    by_cases hd : d ∈ P.support
    · rw [Valuation.map_div]
      have hapos : 0 < W.valuation a := (Valuation.pos_iff _).mpr ha0
      rw [div_le_one₀ hapos, ha]
      exact hmax d hd
    · rw [MvPolynomial.notMem_support_iff.mp hd, zero_div, Valuation.map_zero]
      exact zero_le'
  let b : (Fin 2 →₀ ℕ) → W := fun d => ⟨P.coeff d / a, hbW d⟩
  have hcoef : ∀ d, P.coeff d = a * (b d : Ω) := fun d => by
    show P.coeff d = a * (P.coeff d / a)
    rw [mul_div_cancel₀ _ ha0]
  have hbstar : IsUnit (b dstar) := by
    have : b dstar = 1 := Subtype.ext (by
      show P.coeff dstar / a = 1
      rw [← ha, div_self ha0])
    rw [this]; exact isUnit_one

  have hexp : MvPolynomial.eval₂ φ ![u, y] P
      = ∑ d ∈ P.support, φ (P.coeff d) * u ^ (d 0) * y ^ (d 1) := by
    rw [MvPolynomial.eval₂_eq']
    refine Finset.sum_congr rfl (fun d _ => ?_)
    rw [Fin.prod_univ_two]
    simp [mul_assoc]
  have hPE : MvPolynomial.eval₂ φ ![u, y] P
      = φ a * ∑ d ∈ P.support, φ (b d : Ω) * u ^ (d 0) * y ^ (d 1) := by
    rw [hexp, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun d _ => ?_)
    rw [hcoef d, map_mul]
    ring

  have hUne : ((P.support.filter (fun d => IsUnit (b d))).image (fun d => d 0)).Nonempty :=
    ⟨dstar 0, Finset.mem_image.mpr ⟨dstar, Finset.mem_filter.mpr ⟨hdstar, hbstar⟩, rfl⟩⟩
  obtain ⟨d₀, hd₀U, hd₀i⟩ := Finset.mem_image.mp (Finset.min'_mem _ hUne)
  obtain ⟨hd₀S, hd₀unit⟩ := Finset.mem_filter.mp hd₀U
  have hmin : ∀ d ∈ P.support, d 0 < d₀ 0 → ¬ IsUnit (b d) := by
    intro d hd hlt hunit
    have := Finset.min'_le ((P.support.filter (fun d => IsUnit (b d))).image (fun d => d 0)) (d 0)
      (Finset.mem_image.mpr ⟨d, Finset.mem_filter.mpr ⟨hd, hunit⟩, rfl⟩)
    rw [← hd₀i] at this
    omega

  have hsplit : ∑ d ∈ P.support, φ (b d : Ω) * u ^ (d 0) * y ^ (d 1)
      = ∑ d ∈ P.support.filter (fun d => d 0 = d₀ 0), φ (b d : Ω) * u ^ (d 0) * y ^ (d 1)
        + ∑ d ∈ P.support.filter (fun d => ¬ d 0 = d₀ 0), φ (b d : Ω) * u ^ (d 0) * y ^ (d 1) :=
    (Finset.sum_filter_add_sum_filter_not _ _ _).symm
  have hE1 : ∑ d ∈ P.support.filter (fun d => d 0 = d₀ 0), φ (b d : Ω) * u ^ (d 0) * y ^ (d 1)
      = u ^ (d₀ 0) * ∑ d ∈ P.support.filter (fun d => d 0 = d₀ 0), φ (b d : Ω) * y ^ (d 1) := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun d hd => ?_)
    rw [(Finset.mem_filter.mp hd).2]
    ring

  have hlead : A.valuation
      (∑ d ∈ P.support.filter (fun d => d 0 = d₀ 0), φ (b d : Ω) * y ^ (d 1)) = 1 := by
    have hq := hy (∑ d ∈ P.support.filter (fun d => d 0 = d₀ 0), Polynomial.monomial (d 1) (b d))
      ⟨d₀ 1, ?_⟩
    · rw [Polynomial.eval₂_finsetSum] at hq
      simpa [Polynomial.eval₂_monomial] using hq
    · have hd₀T : d₀ ∈ P.support.filter (fun d => d 0 = d₀ 0) :=
        Finset.mem_filter.mpr ⟨hd₀S, rfl⟩
      rw [Polynomial.finsetSum_coeff, Finset.sum_eq_single_of_mem d₀ hd₀T]
      · rw [Polynomial.coeff_monomial, if_pos rfl]
        exact hd₀unit
      · intro d hd hne
        rw [Polynomial.coeff_monomial, if_neg]
        intro hd1
        apply hne
        exact Finsupp.ext (Fin.forall_fin_two.mpr ⟨(Finset.mem_filter.mp hd).2, hd1⟩)

  have hvu0 : A.valuation u ≠ 0 := (Valuation.ne_zero_iff _).mpr hu0
  have hg0 : A.valuation u ^ (d₀ 0) ≠ 0 := pow_ne_zero _ hvu0
  have htail : A.valuation
      (∑ d ∈ P.support.filter (fun d => ¬ d 0 = d₀ 0), φ (b d : Ω) * u ^ (d 0) * y ^ (d 1))
        < A.valuation u ^ (d₀ 0) := by
    apply Valuation.map_sum_lt _ hg0
    intro d hd
    obtain ⟨hdS, hne⟩ := Finset.mem_filter.mp hd
    have hb1 : A.valuation (φ (b d : Ω)) ≤ 1 :=
      (ValuationSubring.valuation_le_one_iff _ _).mpr (h1 (b d))
    rw [Valuation.map_mul, Valuation.map_mul, Valuation.map_pow, Valuation.map_pow, hy1, one_pow,
      mul_one]
    rcases lt_or_gt_of_ne hne with hlt | hgt
    · by_cases hbz : b d = 0
      · rw [hbz]
        simp only [ZeroMemClass.coe_zero, map_zero, zero_mul]
        exact zero_lt_iff.mpr hg0
      · have hm : b d ∈ IsLocalRing.maximalIdeal W :=
          (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr (hmin d hdS hlt))
        calc A.valuation (φ (b d : Ω)) * A.valuation u ^ (d 0) ≤ A.valuation (φ (b d : Ω)) :=
              mul_le_of_le_one_right' (pow_le_one₀ zero_le' hu1.le)
          _ < A.valuation u ^ (d₀ 0) := hinf (b d) hbz hm (d₀ 0)
    · calc A.valuation (φ (b d : Ω)) * A.valuation u ^ (d 0) ≤ A.valuation u ^ (d 0) :=
            mul_le_of_le_one_left' hb1
        _ < A.valuation u ^ (d₀ 0) :=
            pow_lt_pow_right_of_lt_one₀ (zero_lt_iff.mpr hvu0) hu1 hgt

  have hE1v : A.valuation
      (∑ d ∈ P.support.filter (fun d => d 0 = d₀ 0), φ (b d : Ω) * u ^ (d 0) * y ^ (d 1))
        = A.valuation u ^ (d₀ 0) := by
    rw [hE1, Valuation.map_mul, Valuation.map_pow, hlead, mul_one]
  have hEv : A.valuation (∑ d ∈ P.support, φ (b d : Ω) * u ^ (d 0) * y ^ (d 1))
      = A.valuation u ^ (d₀ 0) := by
    rw [hsplit, Valuation.map_add_eq_of_lt_left _ (by rw [hE1v]; exact htail), hE1v]
  have hEne : ∑ d ∈ P.support, φ (b d : Ω) * u ^ (d 0) * y ^ (d 1) ≠ 0 := by
    intro h0
    rw [h0, Valuation.map_zero] at hEv
    exact hg0 hEv.symm
  have hφa : φ a ≠ 0 := (map_ne_zero_iff φ φ.injective).mpr ha0
  exact mul_ne_zero hφa hEne (hPE ▸ hP)

theorem wcpa_dj_lr1k_nsr_bv_residue_surj : ∀ (Ω L : Type u) [Field Ω] [Field L] (W : ValuationSubring Ω) (φ : Ω →+* L) (A : ValuationSubring L), IsAlgClosed (IsLocalRing.ResidueField ↥W) → (∀ ω : ↥W, φ (ω : Ω) ∈ A) → (∀ ω : ↥W, ω ∈ IsLocalRing.maximalIdeal ↥W → A.valuation (φ (ω : Ω)) < 1) → (∀ z : L, A.valuation z ≤ 1 → ∃ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) ∧ A.valuation (q.eval₂ (φ.comp W.subtype) z) ≠ 1) → IsAlgClosed (IsLocalRing.ResidueField ↥A) ∧ ∀ z : L, A.valuation z ≤ 1 → ∃ c : ↥W, A.valuation (z - φ (c : Ω)) < 1 :=
by
  intro Ω L _ _ W φ A hW H2 H3 H4
  classical
  let ψ : ↥W →+* ↥A := (φ.comp W.subtype).codRestrict A.toSubring H2
  have hψ : ∀ w : ↥W, ((ψ w : ↥A) : L) = φ (w : Ω) := fun w => rfl
  haveI : IsLocalHom ψ := by
    refine ⟨fun w hw => ?_⟩
    by_contra hnu
    have hm : w ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal w).mpr hnu
    have h1 := H3 w hm
    have h2 : A.valuation ((ψ w : ↥A) : L) = 1 := (A.valuation_eq_one_iff (ψ w)).mp hw
    rw [hψ] at h2
    rw [h2] at h1
    exact lt_irrefl _ h1
  let ψb := IsLocalRing.ResidueField.map ψ
  have hcomp : (IsLocalRing.residue ↥A).comp ψ = ψb.comp (IsLocalRing.residue ↥W) := by
    ext r
    exact (IsLocalRing.ResidueField.map_residue ψ r).symm
  have hsub : A.subtype.comp ψ = φ.comp W.subtype := RingHom.ext fun _ => rfl
  have hsurj : Function.Surjective ψb := by
    intro ξ
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective ξ
    obtain ⟨q, ⟨i, hi⟩, hq⟩ := H4 (a : L) (A.valuation_le_one a)
    have hcoe : ((q.eval₂ ψ a : ↥A) : L) = q.eval₂ (φ.comp W.subtype) (a : L) := by
      have := Polynomial.hom_eval₂ q ψ A.subtype a
      rw [hsub] at this
      exact this
    have hlt : A.valuation ((q.eval₂ ψ a : ↥A) : L) < 1 := by
      refine lt_of_le_of_ne (A.valuation_le_one _) ?_
      rw [hcoe]
      exact hq
    have hmem : q.eval₂ ψ a ∈ IsLocalRing.maximalIdeal ↥A :=
      (A.valuation_lt_one_iff _).mpr hlt
    set qb : Polynomial (IsLocalRing.ResidueField ↥W) := q.map (IsLocalRing.residue ↥W) with hqb
    have hqb0 : qb ≠ 0 := by
      intro h0
      have hc : qb.coeff i = 0 := by rw [h0, Polynomial.coeff_zero]
      rw [hqb, Polynomial.coeff_map] at hc
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hi hc
    have hev : qb.eval₂ ψb (IsLocalRing.residue ↥A a) = 0 := by
      rw [hqb, Polynomial.eval₂_map, ← hcomp, ← Polynomial.hom_eval₂]
      exact (IsLocalRing.residue_eq_zero_iff _).mpr hmem
    have hroot : IsLocalRing.residue ↥A a ∈ (qb.map ψb).roots :=
      (Polynomial.mem_roots_map hqb0).mpr hev
    rw [Polynomial.Splits.roots_map (IsAlgClosed.splits qb) ψb, Multiset.mem_map] at hroot
    obtain ⟨r, _, hr⟩ := hroot
    exact ⟨r, hr⟩
  have hinj : Function.Injective ψb := ψb.injective
  let e := RingEquiv.ofBijective ψb ⟨hinj, hsurj⟩
  refine ⟨IsAlgClosed.of_ringEquiv _ _ e, ?_⟩
  intro z hz
  let a : ↥A := ⟨z, A.mem_of_valuation_le_one z hz⟩
  obtain ⟨r, hr⟩ := hsurj (IsLocalRing.residue ↥A a)
  obtain ⟨c, rfl⟩ := IsLocalRing.residue_surjective r
  refine ⟨c, ?_⟩
  have h1 : IsLocalRing.residue ↥A (a - ψ c) = 0 := by
    rw [map_sub, ← hr, IsLocalRing.ResidueField.map_residue, sub_self]
  have h2 : a - ψ c ∈ IsLocalRing.maximalIdeal ↥A := (IsLocalRing.residue_eq_zero_iff _).mp h1
  have h3 := (A.valuation_lt_one_iff _).mp h2
  exact h3

theorem wcpa_dj_lr1k_nsr_bv_trdeg : ∀ (Ω : Type u) [Field Ω] (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → ∀ a b : C.functionField, ∃ P : MvPolynomial (Fin 2) Ω, P ≠ 0 ∧ MvPolynomial.eval₂ (wcLr1uConst (γ ≫ wcProjKStr Ω 1)) ![a, b] P = 0 :=
by
  intro Ω _ C _ γ hcov a b
  classical


  have key : ∀ (K L : Type u) [Field K] [Field L] (φK : Ω →+* K) (g : K →+* L) (t : K),
      (∀ f : K, ∃ p q : Polynomial Ω, q.eval₂ φK t ≠ 0 ∧ f * q.eval₂ φK t = p.eval₂ φK t) →
      (letI : Algebra K L := g.toAlgebra; FiniteDimensional K L) →
      ∀ a b : L, ∃ P : MvPolynomial (Fin 2) Ω, P ≠ 0 ∧
        MvPolynomial.eval₂ (g.comp φK) ![a, b] P = 0 := by
    intro K L _ _ φK g t ht hfin a b
    letI : Algebra Ω K := φK.toAlgebra
    letI : Algebra K L := g.toAlgebra
    letI : Algebra Ω L := (g.comp φK).toAlgebra
    haveI : IsScalarTower Ω K L := IsScalarTower.of_algebraMap_eq (fun x => rfl)
    haveI : FaithfulSMul Ω K := (faithfulSMul_iff_algebraMap_injective Ω K).mpr φK.injective
    haveI : FaithfulSMul K L := (faithfulSMul_iff_algebraMap_injective K L).mpr g.injective
    haveI : FiniteDimensional K L := hfin
    haveI : Algebra.IsAlgebraic (Algebra.adjoin Ω ({t} : Set K)) K := by
      constructor
      intro f
      obtain ⟨p, q, hq, hf⟩ := ht f
      have e1 : Polynomial.aeval t q = q.eval₂ φK t := Polynomial.aeval_def t q
      have e2 : Polynomial.aeval t p = p.eval₂ φK t := Polynomial.aeval_def t p
      let qt : Algebra.adjoin Ω ({t} : Set K) :=
        ⟨Polynomial.aeval t q, Polynomial.aeval_mem_adjoin_singleton Ω t⟩
      let pt : Algebra.adjoin Ω ({t} : Set K) :=
        ⟨Polynomial.aeval t p, Polynomial.aeval_mem_adjoin_singleton Ω t⟩
      refine ⟨Polynomial.C qt * Polynomial.X - Polynomial.C pt, ?_, ?_⟩
      · intro h0
        apply hq
        have h1 := congrArg (fun P => P.coeff 1) h0
        simp only [Polynomial.coeff_sub, Polynomial.coeff_C_mul_X, Polynomial.coeff_C,
          Polynomial.coeff_zero, if_true, one_ne_zero, if_false, sub_zero] at h1
        have h2 := congrArg Subtype.val h1
        rw [← e1]
        exact h2
      · rw [Polynomial.aeval_sub, Polynomial.aeval_mul, Polynomial.aeval_C, Polynomial.aeval_C,
          Polynomial.aeval_X]
        show Polynomial.aeval t q * f - Polynomial.aeval t p = 0
        rw [e1, e2, ← hf]
        ring
    have h1 : Algebra.trdeg Ω K ≤ 1 := by
      have := Algebra.IsAlgebraic.trdeg_le_cardinalMk Ω ({t} : Set K)
      rwa [Cardinal.mk_singleton] at this
    have h2 : Algebra.trdeg K L = 0 := trdeg_eq_zero
    have h3 : Algebra.trdeg Ω L ≤ 1 := by
      rw [← trdeg_add_eq Ω K, h2, add_zero]
      exact h1
    by_contra hcon
    push_neg at hcon
    have hind : AlgebraicIndependent Ω ![a, b] := by
      rw [algebraicIndependent_iff]
      intro p hp
      by_contra hp0
      rw [MvPolynomial.aeval_def] at hp
      exact hcon p hp0 hp
    have h4 := hind.lift_cardinalMk_le_trdeg
    have h5 := h4.trans (Cardinal.lift_le.mpr h3)
    rw [Cardinal.mk_fin, Cardinal.lift_natCast, Cardinal.lift_one] at h5
    have h6 : (2 : ℕ) ≤ 1 := by exact_mod_cast h5
    omega

