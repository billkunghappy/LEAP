  let V : X.Opens := ⟨{wcpaDjLkImg W (γ ≫ ι) uX y₀}ᶜ, hxcl.isOpen_compl⟩
  have hV : (V : Set X) = {wcpaDjLkImg W (γ ≫ ι) uX y₀}ᶜ := rfl
  have hiso : IsIso (r₁ ∣_ V) := by
    apply wc_csd_blowup_iso_off_center X X₁ _ r₁ V hbl
    apply Set.eq_empty_iff_forall_notMem.mpr
    rintro z ⟨hz, hzV⟩
    exact hzV (Set.mem_singleton_iff.mpr (by rw [hsupp z hz, hσx]))

  have hemb1 : Topology.IsEmbedding (Limits.pullback.fst (r₁ ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    (Scheme.Hom.isClosedEmbedding (Limits.pullback.fst (r₁ ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))).isEmbedding
  have hSmOpen : IsOpen {w : ↥(Limits.pullback (r₁ ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) |
        wcpaDjLkSmAt W (r₁ ≫ uX) w} := by
    rw [isOpen_iff_forall_mem_open]
    intro w hw
    obtain ⟨U, hwU, hU⟩ := hw
