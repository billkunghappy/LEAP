    wcLlsDiscSep W A K M t c b →
    ∀ θ₁ θ₂ θ₃ : B →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ₁ = 𝔮 →
      (IsLocalRing.maximalIdeal ↥W).comap θ₂ = 𝔮 → (IsLocalRing.maximalIdeal ↥W).comap θ₃ = 𝔮 →
      b ∣ θ₁ (algebraMap A B t) - c → b ∣ θ₂ (algebraMap A B t) - c →
      θ₂ t' - θ₁ t' ∣ θ₃ t' - θ₁ t' → b ∣ θ₃ (algebraMap A B t) - c :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M _ _ _ _ _ _ B _ _ _ _ _ _ _ _ 𝔭 t h 𝔮 t' hPD hSmc
    c b hc hbm hb0 hsep θ₁ θ₂ θ₃ hθ₁ hθ₂ hθ₃ h1 h2 hd

  have s5 : ∀ (S : Type u) [CommRing S] [IsLocalRing S] (I : Ideal S),
      3 ≤ wcpaDjLkBranches (S ⧸ I) → wcpaDjLkBad (S ⧸ I) := by
    intro S _ _ I h3
    rintro (hδ | ⟨_, hb⟩)
    · have hsub : Subsingleton (↥(integralClosure (S ⧸ I) (FractionRing (S ⧸ I))) ⧸
          (Algebra.linearMap (S ⧸ I) ↥(integralClosure (S ⧸ I) (FractionRing (S ⧸ I)))).range) :=
        (Module.length_eq_zero_iff).mp hδ
      have htop : (Algebra.linearMap (S ⧸ I)
          ↥(integralClosure (S ⧸ I) (FractionRing (S ⧸ I)))).range = ⊤ :=
        Submodule.Quotient.subsingleton_iff.mp hsub
      have hsurj : Function.Surjective
          (algebraMap (S ⧸ I) ↥(integralClosure (S ⧸ I) (FractionRing (S ⧸ I)))) := by
        intro x
        have hx : x ∈ (Algebra.linearMap (S ⧸ I)
            ↥(integralClosure (S ⧸ I) (FractionRing (S ⧸ I)))).range := by
          rw [htop]; exact Submodule.mem_top
        obtain ⟨r, hr⟩ := hx
        exact ⟨r, hr⟩
      have hφs : Function.Surjective ((algebraMap (S ⧸ I)
          ↥(integralClosure (S ⧸ I) (FractionRing (S ⧸ I)))).comp (Ideal.Quotient.mk I)) :=
        hsurj.comp Ideal.Quotient.mk_surjective
      have hss : Subsingleton
          (MaximalSpectrum ↥(integralClosure (S ⧸ I) (FractionRing (S ⧸ I)))) := by
        constructor
        intro P P'
        have e1 : Ideal.comap ((algebraMap (S ⧸ I)
            ↥(integralClosure (S ⧸ I) (FractionRing (S ⧸ I)))).comp (Ideal.Quotient.mk I))
            P.asIdeal = IsLocalRing.maximalIdeal S := by
          have := P.isMaximal
          exact IsLocalRing.eq_maximalIdeal (Ideal.comap_isMaximal_of_surjective _ hφs)
        have e2 : Ideal.comap ((algebraMap (S ⧸ I)
            ↥(integralClosure (S ⧸ I) (FractionRing (S ⧸ I)))).comp (Ideal.Quotient.mk I))
            P'.asIdeal = IsLocalRing.maximalIdeal S := by
          have := P'.isMaximal
          exact IsLocalRing.eq_maximalIdeal (Ideal.comap_isMaximal_of_surjective _ hφs)
        ext1
        exact Ideal.comap_injective_of_surjective _ hφs (e1.trans e2.symm)
      have hle : wcpaDjLkBranches (S ⧸ I) ≤ 1 := by
        unfold wcpaDjLkBranches
        exact (ENat.card_le_one_iff_subsingleton _).mpr hss
      have := h3.trans hle
      norm_num at this
    · rw [hb] at h3
      norm_num at h3

  obtain ⟨R, _hRne, hRm, hR⟩ :=
    wcpa_dj_llsm_sm_weierstrass_points Ω W hW hWt A K M B 𝔭 t h 𝔮 t' hPD hSmc c hc

  have ht'q : t' ∈ 𝔮 := hSmc.2.2.1.2.2.2.2.2.1
  have hx : ∀ θ : B →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔮 →
      θ t' ∈ IsLocalRing.maximalIdeal ↥W := by
    intro θ hθ
    have h0 := ht'q
    rw [← hθ, Ideal.mem_comap] at h0
    exact h0

  by_contra hn
  have hP1 : b ∣ (R.map (fun r => θ₁ t' - r)).prod := dvd_trans h1 (hR θ₁ hθ₁).1
  have hP3 : ¬ b ∣ (R.map (fun r => θ₃ t' - r)).prod :=
    fun hb3 => hn (dvd_trans hb3 (hR θ₃ hθ₃).2)
  have hP2 : b ∣ (R.map (fun r => θ₁ t' + (θ₂ t' - θ₁ t') - r)).prod := by
    rw [add_sub_cancel]
    exact dvd_trans h2 (hR θ₂ hθ₂).1

  have hβ0 : θ₂ t' - θ₁ t' ≠ 0 := by
    intro h0
    rw [h0, zero_dvd_iff, sub_eq_zero] at hd
    rw [hd] at hP3
    exact hP3 hP1
  have hG : ¬ b ∣ (R.map (fun r => @ite _ ((θ₂ t' - θ₁ t') ∣ θ₁ t' - r)
      (Classical.propDecidable _) (θ₂ t' - θ₁ t') (θ₁ t' - r))).prod := by
    intro hb
    apply hP3
    refine dvd_trans hb ?_
    have hg : ∀ r : ↥W, @ite _ ((θ₂ t' - θ₁ t') ∣ θ₁ t' - r)
        (Classical.propDecidable _) (θ₂ t' - θ₁ t') (θ₁ t' - r) ∣ θ₃ t' - r := by
      intro r
      have e : θ₃ t' - r = (θ₃ t' - θ₁ t') + (θ₁ t' - r) := by ring
      rw [e]
      split_ifs with hβ
      · exact dvd_add hd hβ
      · have h' : (θ₁ t' - r) ∣ (θ₂ t' - θ₁ t') :=
          (ValuationRing.dvd_total (θ₂ t' - θ₁ t') (θ₁ t' - r)).resolve_left hβ
        exact dvd_add (dvd_trans h' hd) (dvd_refl _)
    clear hb hP1 hP2 hP3 hRm hR _hRne
    induction R with
    | nil => simp
    | cons a R ih =>
      simp only [List.map_cons, List.prod_cons]
      exact mul_dvd_mul (hg a) ih

  obtain ⟨Q, hQ, hQc, hQ3⟩ := wcpa_dj_llsm_smpc_gauss_branches Ω W hW hWt A K M B 𝔭 t h 𝔮 t'
    hPD hSmc c b hc hbm hb0 R hRm hR (θ₁ t') (θ₂ t' - θ₁ t') (hx θ₁ hθ₁)
    (Ideal.sub_mem _ (hx θ₂ hθ₂) (hx θ₁ hθ₁)) hβ0 hP1 hP2 hG

  have hbad : wcpaDjLkBad (wcLlsFS W ((algebraMap K M).comp ((algebraMap A K).comp
      (algebraMap ↥W A))) ↥(Algebra.adjoin A
        {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) Q) :=
    s5 (Localization.AtPrime Q) _ hQ3
  exact hsep Q hQc hbad

theorem wcpa_dj_llsm_sm_convex_level_disc : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (R : List ↥W) (r₁ b : ↥W), r₁ ∈ R →
    (∀ r ∈ R, r ∈ IsLocalRing.maximalIdeal ↥W) → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    (∀ x₁ x₂ x₃ : ↥W, x₁ ∈ IsLocalRing.maximalIdeal ↥W → x₂ ∈ IsLocalRing.maximalIdeal ↥W →
      x₃ ∈ IsLocalRing.maximalIdeal ↥W →
      b ∣ (R.map (fun r => x₁ - r)).prod → b ∣ (R.map (fun r => x₂ - r)).prod →
      x₂ - x₁ ∣ x₃ - x₁ → b ∣ (R.map (fun r => x₃ - r)).prod) →
    ∃ b₄ : ↥W, b₄ ∈ IsLocalRing.maximalIdeal ↥W ∧ b₄ ≠ 0 ∧
      ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W →
        (b ∣ (R.map (fun r => x - r)).prod ↔ b₄ ∣ x - r₁) :=
by
  intro Ω _ _ W R r₁ b hr₁ hRm hbm hb0 hconv
  classical

  have s1 : ∀ (R : List ↥W) (b : ↥W), R ≠ [] →
      ∃ A : List ↥W, ∀ x : ↥W, (R.map (fun r => x - r)).prod - b =
        (A.map (fun a => x - a)).prod := by
    intro R b hR
    set P : Polynomial ↥W :=
      (R.map (fun r => Polynomial.X - Polynomial.C r)).prod - Polynomial.C b with hP
    have hprod : (R.map (fun r => Polynomial.X - Polynomial.C r)).prod =
        ((R : Multiset ↥W).map (fun r => Polynomial.X - Polynomial.C r)).prod := by
      rw [Multiset.map_coe, Multiset.prod_coe]
    have hmon0 : ((R : Multiset ↥W).map (fun r => Polynomial.X - Polynomial.C r)).prod.Monic :=
      Polynomial.monic_multiset_prod_of_monic _ _ (fun r _ => Polynomial.monic_X_sub_C r)
    have hdeg : ((R : Multiset ↥W).map
        (fun r => Polynomial.X - Polynomial.C r)).prod.natDegree = R.length := by
      rw [Polynomial.natDegree_multiset_prod_X_sub_C_eq_card]; simp
    have hlen : 0 < R.length := List.length_pos_of_ne_nil hR
    have hPm : P.Monic := by
      rw [hP, hprod]
      apply Polynomial.Monic.sub_of_left hmon0
      calc Polynomial.degree (Polynomial.C b) ≤ 0 := Polynomial.degree_C_le
        _ < Polynomial.degree ((R : Multiset ↥W).map
            (fun r => Polynomial.X - Polynomial.C r)).prod := by
          rw [Polynomial.degree_eq_natDegree hmon0.ne_zero, hdeg]
          exact_mod_cast hlen
    set ι := algebraMap ↥W Ω with hι
    have hιinj : Function.Injective ι := fun a c h => Subtype.ext h
    set Q : Polynomial Ω := P.map ι with hQ
    have hQm : Q.Monic := hPm.map ι
    have hQ0 : Q ≠ 0 := hQm.ne_zero
    have hcard : Q.roots.card = Q.natDegree := IsAlgClosed.card_roots_eq_natDegree
    have hQsplit : (Q.roots.map (fun α => Polynomial.X - Polynomial.C α)).prod = Q :=
      Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hQm hcard
    have hroots : ∀ α ∈ Q.roots, ∃ y : ↥W, ι y = α := by
      intro α hα
      have hint : IsIntegral (↥W) α := by
        refine ⟨P, hPm, ?_⟩
        have := (Polynomial.mem_roots hQ0).mp hα
        rw [Polynomial.IsRoot, hQ, Polynomial.eval_map] at this
        exact this
      exact (IsIntegrallyClosed.isIntegral_iff (R := ↥W) (K := Ω)).mp hint
    have key : ∀ s : Multiset Ω, (∀ α ∈ s, ∃ y : ↥W, ι y = α) →
        ∃ A : List ↥W, ((A.map ι : List Ω) : Multiset Ω) = s := by
      intro s
      induction s using Multiset.induction_on with
      | empty => intro _; exact ⟨[], rfl⟩
      | cons α s ih =>
        intro h
        obtain ⟨A, hA⟩ := ih (fun β hβ => h β (Multiset.mem_cons_of_mem hβ))
        obtain ⟨y, hy⟩ := h α (Multiset.mem_cons_self α s)
        refine ⟨y :: A, ?_⟩
        rw [List.map_cons, ← Multiset.cons_coe, hA, hy]
    obtain ⟨A, hA⟩ := key Q.roots hroots
    refine ⟨A, fun x => hιinj ?_⟩
    have e1 : ι ((R.map (fun r => x - r)).prod - b) = Q.eval (ι x) := by
      rw [hQ, Polynomial.eval_map, Polynomial.eval₂_at_apply, hP, Polynomial.eval_sub,
        Polynomial.eval_list_prod, Polynomial.eval_C, List.map_map]
      congr 2
      exact congrArg List.prod (List.map_congr_left (fun r _ => by simp))
    have e2 : Q.eval (ι x) = ι ((A.map (fun a => x - a)).prod) := by
      rw [← hQsplit, Polynomial.eval_multiset_prod, Multiset.map_map, ← hA, Multiset.map_coe,
        Multiset.prod_coe, List.map_map, map_list_prod, List.map_map]
      exact congrArg List.prod (List.map_congr_left (fun a _ => by simp))
    rw [e1, e2]

  have s2 : ∀ D : List ↥W, D ≠ [] → ∃ d ∈ D, ∀ e ∈ D, d ∣ e := by
    intro D hD
    induction D with
    | nil => exact absurd rfl hD
    | cons h t ih =>
      by_cases ht : t = []
      · subst ht
        refine ⟨h, List.mem_cons_self, fun e he => ?_⟩
        rw [List.mem_singleton] at he
        rw [he]
      · obtain ⟨d₀, hd₀, hd₀'⟩ := ih ht
        rcases ValuationRing.dvd_total h d₀ with hh | hh
        · refine ⟨h, List.mem_cons_self, fun e he => ?_⟩
          rcases List.mem_cons.mp he with rfl | he
          · exact dvd_rfl
          · exact hh.trans (hd₀' e he)
        · refine ⟨d₀, List.mem_cons_of_mem _ hd₀, fun e he => ?_⟩
          rcases List.mem_cons.mp he with rfl | he
          · exact hh
          · exact hd₀' e he

  have s3 : ∀ (x r₁ : ↥W) (A : List ↥W), A ≠ [] → (∀ a ∈ A, ¬ (a - r₁) ∣ (x - r₁)) →
      ¬ (A.map (fun a => r₁ - a)).prod ∣ (A.map (fun a => x - a)).prod := by
    intro x r₁ A hA hall
    have aux : ∀ B : List ↥W, (∀ a ∈ B, ¬ (a - r₁) ∣ (x - r₁)) → ∃ U V : ↥W,
        (B.map (fun a => r₁ - a)).prod = (x - r₁) ^ B.length * U ∧
        (B.map (fun a => x - a)).prod = (x - r₁) ^ B.length * V ∧ IsUnit V ∧
        (B ≠ [] → ¬ IsUnit U) := by
      intro B
      induction B with
      | nil => intro _; exact ⟨1, 1, by simp, by simp, isUnit_one, fun h => absurd rfl h⟩
      | cons a t ih =>
        intro hB
        obtain ⟨U, V, hU, hV, hVu, _⟩ := ih (fun c hc => hB c (List.mem_cons_of_mem _ hc))
        have ha := hB a List.mem_cons_self
        rcases ValuationRing.dvd_total (x - r₁) (a - r₁) with hd | hd
        · obtain ⟨u, hu⟩ := hd
          have hun : ¬ IsUnit u := by
            intro hu'
            apply ha
            rw [hu]
            exact hu'.mul_right_dvd.mpr dvd_rfl
          have h1u : IsUnit (1 - u) := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits u hun
          refine ⟨-u * U, (1 - u) * V, ?_, ?_, h1u.mul hVu, fun _ hU' => ?_⟩
          · rw [List.map_cons, List.prod_cons, hU, List.length_cons, pow_succ]
            linear_combination (-(x - r₁) ^ t.length * U) * hu
          · rw [List.map_cons, List.prod_cons, hV, List.length_cons, pow_succ]
            linear_combination (-(x - r₁) ^ t.length * V) * hu
          · apply hun
            have := (isUnit_of_mul_isUnit_left hU').neg
            simpa using this
        · exact absurd hd ha
    obtain ⟨U, V, hU, hV, hVu, hUn⟩ := aux A hall
    obtain ⟨a, ha⟩ := List.exists_mem_of_ne_nil A hA
    have hy : x - r₁ ≠ 0 := by
      intro h
      apply hall a ha
      rw [h]
      exact dvd_zero _
    intro hdvd
    rw [hU, hV, mul_dvd_mul_iff_left (pow_ne_zero _ hy)] at hdvd
    exact hUn hA (isUnit_of_dvd_unit hdvd hVu)

  have hR : R ≠ [] := List.ne_nil_of_mem hr₁
  obtain ⟨A, hA⟩ := s1 R b hR
  have hf0 : (R.map (fun r => r₁ - r)).prod = 0 :=
    List.prod_eq_zero (List.mem_map.mpr ⟨r₁, hr₁, sub_self _⟩)
  have hA1 : (A.map (fun a => r₁ - a)).prod = -b := by rw [← hA r₁, hf0, zero_sub]
  have hA2 : ∀ a ∈ A, (R.map (fun r => a - r)).prod = b := by
    intro a ha
    have h := hA a
    rw [List.prod_eq_zero (List.mem_map.mpr ⟨a, ha, sub_self _⟩)] at h
    exact sub_eq_zero.mp h
  have hbnu : ¬ IsUnit b := mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hbm)
  have hAne : A ≠ [] := by
    rintro rfl
    rw [List.map_nil, List.prod_nil] at hA1
    apply hbnu
    have hb1 : b = -1 := by linear_combination hA1
    rw [hb1]
    exact isUnit_one.neg
  have hAm : ∀ a ∈ A, a ∈ IsLocalRing.maximalIdeal ↥W := by
    intro a ha
    by_contra hna
    have hu : ∀ r ∈ R, IsUnit (a - r) := by
      intro r hr
      by_contra h
      apply hna
      have h1 : a - r ∈ IsLocalRing.maximalIdeal ↥W :=
        (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr h)
      have h2 := Ideal.add_mem _ h1 (hRm r hr)
      rwa [sub_add_cancel] at h2
    have hpu : IsUnit (R.map (fun r => a - r)).prod := by
      apply List.prod_isUnit
      intro y hy
      obtain ⟨r, hr, rfl⟩ := List.mem_map.mp hy
      exact hu r hr
    rw [hA2 a ha] at hpu
    exact hbnu hpu
  obtain ⟨d, hdD, hdmin⟩ := s2 (A.map (fun a => a - r₁))
    (fun h => hAne (List.map_eq_nil_iff.mp h))
  obtain ⟨a', ha', rfl⟩ := List.mem_map.mp hdD
  have hmin : ∀ a ∈ A, (a' - r₁) ∣ (a - r₁) :=
    fun a ha => hdmin _ (List.mem_map.mpr ⟨a, ha, rfl⟩)
  refine ⟨a' - r₁, Ideal.sub_mem _ (hAm a' ha') (hRm r₁ hr₁), ?_, ?_⟩
  · intro h
    apply hb0
    have h0 : (A.map (fun a => r₁ - a)).prod = 0 := by
      apply List.prod_eq_zero
      refine List.mem_map.mpr ⟨a', ha', ?_⟩
      rw [sub_eq_zero] at h ⊢
      exact h.symm
    rw [hA1] at h0
    exact neg_eq_zero.mp h0
  · intro x hx
    constructor
    · intro hbx
      by_contra hn
      have hall : ∀ a ∈ A, ¬ (a - r₁) ∣ (x - r₁) := fun a ha h => hn ((hmin a ha).trans h)
      apply s3 x r₁ A hAne hall
      rw [hA1, ← hA x]
      exact neg_dvd.mpr (dvd_sub hbx dvd_rfl)
    · intro h
      exact hconv r₁ a' x (hRm r₁ hr₁) (hAm a' ha') hx (by rw [hf0]; exact dvd_zero _)
        (by rw [hA2 a' ha']) h

theorem wcpa_dj_llsm_sm_preimage_disc : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M L : Type u) [Field M] [Field L] [Algebra K M] [Algebra M L]
    [Algebra K L] [Algebra A M] [Algebra A L] [IsScalarTower A K M] [IsScalarTower K M L]
    [IsScalarTower A K L] [IsScalarTower A M L] [FiniteDimensional K L] [IsGalois K L]
    [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    (𝔭 : Ideal A) (t : A) (h : A) (𝔮 : Ideal B) (t' : B) (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y → Group.IsSolvable (L ≃ₐ[K] L) →
    ∀ c b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
      wcLlsDiscSep W A K L t c b →
      ∃ c₄ b₄ : ↥W, c₄ ∈ IsLocalRing.maximalIdeal ↥W ∧ b₄ ∈ IsLocalRing.maximalIdeal ↥W ∧
        b₄ ≠ 0 ∧ wcLlsSmPre W A B 𝔮 t t' c b c₄ b₄ :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M L _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ B _ _ _ _ _ _ _ _ 𝔭 t h 𝔮 t' y hPD hSmc hSolv hUniq hGsolv c b hc hbm hb0 hsep

  have hsepM : wcLlsDiscSep W A K M t c b :=
    wcpa_dj_llsm_nss_sep_descends Ω W hW hWt A K M L 𝔭 (.disc t) hPD
      (t - algebraMap ↥W A c) b hbm hb0 (Or.inl ⟨t, c, rfl, hc, rfl⟩) hsep
  have hPDB : wcLlsPD W B 𝔮 (.disc t') := hSmc.2.2.1

  obtain ⟨R, hRne, hRm, hR⟩ :=
    wcpa_dj_llsm_sm_weierstrass_points Ω W hW hWt A K M B 𝔭 t h 𝔮 t' hPD hSmc c hc
  have hkey : ∀ θ : B →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔮 →
      (b ∣ θ (algebraMap A B t) - c ↔ b ∣ (R.map (fun r => θ t' - r)).prod) := by
    intro θ hθ
    exact ⟨fun hd => dvd_trans hd (hR θ hθ).1, fun hd => dvd_trans hd (hR θ hθ).2⟩

  have ht'q : t' ∈ 𝔮 := by
    obtain ⟨θ₀, hθ₀t, hθ₀c⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt B 𝔮 t' hPDB 0
      (Ideal.zero_mem _)
    rw [← hθ₀c, Ideal.mem_comap, hθ₀t]
    exact Ideal.zero_mem _
  have hx : ∀ θ : B →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔮 →
      θ t' ∈ IsLocalRing.maximalIdeal ↥W := by
    intro θ hθ
    rw [← hθ, Ideal.mem_comap] at ht'q
    exact ht'q

  have hconv : ∀ x₁ x₂ x₃ : ↥W, x₁ ∈ IsLocalRing.maximalIdeal ↥W →
      x₂ ∈ IsLocalRing.maximalIdeal ↥W → x₃ ∈ IsLocalRing.maximalIdeal ↥W →
      b ∣ (R.map (fun r => x₁ - r)).prod → b ∣ (R.map (fun r => x₂ - r)).prod →
      x₂ - x₁ ∣ x₃ - x₁ → b ∣ (R.map (fun r => x₃ - r)).prod := by
    intro x₁ x₂ x₃ h1 h2 h3 hb1 hb2 hd
    obtain ⟨θ₁, ht1, hc1⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt B 𝔮 t' hPDB x₁ h1
    obtain ⟨θ₂, ht2, hc2⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt B 𝔮 t' hPDB x₂ h2
    obtain ⟨θ₃, ht3, hc3⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt B 𝔮 t' hPDB x₃ h3
    have e1 : b ∣ θ₁ (algebraMap A B t) - c := (hkey θ₁ hc1).mpr (by rw [ht1]; exact hb1)
    have e2 : b ∣ θ₂ (algebraMap A B t) - c := (hkey θ₂ hc2).mpr (by rw [ht2]; exact hb2)
    have e3 : θ₂ t' - θ₁ t' ∣ θ₃ t' - θ₁ t' := by rw [ht1, ht2, ht3]; exact hd
    have e4 := wcpa_dj_llsm_sm_preimage_convex Ω W hW hWt A K M B 𝔭 t h 𝔮 t' hPD hSmc c b hc
      hbm hb0 hsepM θ₁ θ₂ θ₃ hc1 hc2 hc3 e1 e2 e3
    have e5 := (hkey θ₃ hc3).mp e4
    rw [ht3] at e5
    exact e5

  have hr₁ : R.head hRne ∈ R := List.head_mem hRne
  obtain ⟨b₄, hb₄m, hb₄0, hlev⟩ :=
    wcpa_dj_llsm_sm_convex_level_disc Ω W R (R.head hRne) b hr₁ hRm hbm hb0 hconv
  refine ⟨R.head hRne, b₄, hRm _ hr₁, hb₄m, hb₄0, ?_⟩
  intro θ hθ
  exact (hkey θ hθ).trans (hlev _ (hx θ hθ))

theorem wcpa_dj_llsm_smid_galois_restrict : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    (𝔭 : Ideal A) (t h : A) (𝔮 : Ideal B) (t' : B),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    ∀ σ : M ≃ₐ[K] M, ∃ φ : B ≃ₐ[↥W] B, (∀ x : B, algebraMap B M (φ x) = σ (algebraMap B M x)) ∧
      (∀ x : A, φ (algebraMap A B x) = algebraMap A B x) ∧ (∀ x : B, φ x ∈ 𝔮 ↔ x ∈ 𝔮) ∧
      wcLlsPD W B 𝔮 (.disc (φ t')) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M _ _ _ _ _ _ B _ _ _ _ _ _ _ _ 𝔭 t h 𝔮 t' hPD hSmc σ
  classical
  unfold wcLlsSmc at hSmc
  obtain ⟨_hh𝔭, hint, hPDB, hcomap, huniq⟩ := hSmc
  have inj : Function.Injective (algebraMap B M) := IsFractionRing.injective B M

  have fixA : ∀ (τ : M ≃ₐ[K] M) (a : A), τ (algebraMap A M a) = algebraMap A M a := by
    intro τ a
    rw [IsScalarTower.algebraMap_apply A K M, AlgEquiv.commutes]

  have stab : ∀ (τ : M ≃ₐ[K] M) (x : B), ∃ y : B, algebraMap B M y = τ (algebraMap B M x) := by
    intro τ x
    obtain ⟨k, hk⟩ := (hint (algebraMap B M x)).mp ⟨x, rfl⟩
    have h1 : IsIntegral A (τ (algebraMap A M h ^ k * algebraMap B M x)) := hk.map τ
    rw [map_mul, map_pow, fixA] at h1
    exact (hint _).mpr ⟨k, h1⟩

  have gdef : ∀ τ : M ≃ₐ[K] M, ∃ g : B →ₐ[↥W] B,
      ∀ x, algebraMap B M (g x) = τ (algebraMap B M x) := by
    intro τ
    choose g hg using stab τ
    refine ⟨{ toFun := g
              map_one' := ?_
              map_mul' := ?_
              map_zero' := ?_
              map_add' := ?_
              commutes' := ?_ }, hg⟩
    · show g 1 = 1
      apply inj; rw [hg, map_one, map_one]
    · intro x y
      show g (x * y) = g x * g y
      apply inj; rw [hg, map_mul, map_mul, map_mul, hg, hg]
    · show g 0 = 0
      apply inj; rw [hg, map_zero, map_zero]
    · intro x y
      show g (x + y) = g x + g y
      apply inj; rw [hg, map_add, map_add, map_add, hg, hg]
    · intro w
      show g (algebraMap ↥W B w) = algebraMap ↥W B w
      apply inj
      rw [hg, IsScalarTower.algebraMap_apply ↥W A B, ← IsScalarTower.algebraMap_apply A B M, fixA]
  obtain ⟨g₁, hg₁⟩ := gdef σ
  obtain ⟨g₂, hg₂⟩ := gdef σ.symm
  have h12 : g₁.comp g₂ = AlgHom.id ↥W B := by
    ext x
    apply inj
    simp only [AlgHom.comp_apply, AlgHom.id_apply]
    rw [hg₁, hg₂, AlgEquiv.apply_symm_apply]
  have h21 : g₂.comp g₁ = AlgHom.id ↥W B := by
    ext x
    apply inj
    simp only [AlgHom.comp_apply, AlgHom.id_apply]
    rw [hg₂, hg₁, AlgEquiv.symm_apply_apply]
  obtain ⟨φ, hφ⟩ : ∃ φ : B ≃ₐ[↥W] B, ∀ x, φ x = g₁ x :=
    ⟨AlgEquiv.ofAlgHom g₁ g₂ h12 h21, fun _ => rfl⟩
  have hφM : ∀ x : B, algebraMap B M (φ x) = σ (algebraMap B M x) := by
    intro x
    rw [hφ]
    exact hg₁ x
  have hφA : ∀ x : A, φ (algebraMap A B x) = algebraMap A B x := by
    intro x
    apply inj
    rw [hφM, ← IsScalarTower.algebraMap_apply A B M, fixA]

  have h𝔮max : 𝔮.IsMaximal := hPDB.2.2.2.1
  haveI : 𝔮.IsPrime := h𝔮max.isPrime
  have hφ𝔮 : ∀ x : B, φ x ∈ 𝔮 ↔ x ∈ 𝔮 := by
    have hprime : (Ideal.comap φ 𝔮).IsPrime := inferInstance
    have hlie : (Ideal.comap φ 𝔮).comap (algebraMap A B) = 𝔭 := by
      rw [← hcomap]
      ext x
      simp only [Ideal.mem_comap, hφA]
    have hEq := huniq _ hprime hlie
    intro x
    have e : x ∈ Ideal.comap φ 𝔮 ↔ x ∈ 𝔮 := by rw [hEq]
    exact e

  have hPDφ : wcLlsPD W B 𝔮 (.disc (φ t')) := by
    unfold wcLlsPD at hPDB
    obtain ⟨h1, h2, h3, h4, h5, h6, h7, h₀, hh₀, f, hfC, hfX, hfE⟩ := hPDB
    unfold wcLlsPD
    dsimp only
    refine ⟨h1, h2, h3, h4, h5, (hφ𝔮 t').mpr h6, ?_, ?_⟩
    · apply le_antisymm
      · intro x hx
        have hy : φ.symm x ∈ 𝔮 := (hφ𝔮 _).mp (by rwa [AlgEquiv.apply_symm_apply])
        rw [h7] at hy
        have hx' : x ∈ Ideal.map φ (Ideal.span {t'} ⊔
            Ideal.map (algebraMap ↥W B) (IsLocalRing.maximalIdeal ↥W)) := by
          have := Ideal.mem_map_of_mem φ hy
          rwa [AlgEquiv.apply_symm_apply] at this
        rw [Ideal.map_sup, Ideal.map_span, Set.image_singleton] at hx'
        have hJ : Ideal.map φ (Ideal.map (algebraMap ↥W B) (IsLocalRing.maximalIdeal ↥W)) ≤
            Ideal.map (algebraMap ↥W B) (IsLocalRing.maximalIdeal ↥W) := by
          rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
          intro w hw
          rw [Ideal.mem_comap, Ideal.mem_comap, AlgEquiv.commutes]
          exact Ideal.mem_map_of_mem _ hw
        exact (sup_le_sup_left hJ _) hx'
      · exact sup_le ((Ideal.span_singleton_le_iff_mem _).mpr ((hφ𝔮 t').mpr h6)) h5
    · refine ⟨φ h₀, fun hm => hh₀ ((hφ𝔮 h₀).mp hm), ?_⟩
      let ι : Localization.Away h₀ ≃+* Localization.Away (φ h₀) :=
        IsLocalization.ringEquivOfRingEquiv (M := Submonoid.powers h₀)
          (T := Submonoid.powers (φ h₀)) (Localization.Away h₀) (Localization.Away (φ h₀))
          (φ : B ≃+* B) (by rw [Submonoid.map_powers]; rfl)
      have hι : ∀ x : B, ι (algebraMap B _ x) = algebraMap B _ (φ x) := fun x =>
        IsLocalization.ringEquivOfRingEquiv_eq _ x
      refine ⟨ι.toRingHom.comp f, ?_, ?_, ?_⟩
      · apply RingHom.ext
        intro w
        have hw := RingHom.congr_fun hfC w
        change f (Polynomial.C w) = algebraMap B _ (algebraMap ↥W B w) at hw
        change ι (f (Polynomial.C w)) = algebraMap B _ (algebraMap ↥W B w)
        rw [hw, hι, AlgEquiv.commutes]
      · change ι (f Polynomial.X) = algebraMap B _ (φ t')
        rw [hfX, hι]
      · exact RingHom.Etale.stableUnderComposition f ι.toRingHom hfE
          (RingHom.Etale.of_bijective (f := ι.toRingHom) ι.bijective)
  exact ⟨φ, hφM, hφA, hφ𝔮, hPDφ⟩

theorem wcpa_dj_llsm_smid_discsep_transport : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (K : Type u) [Field K] (M L : Type u) [Field M] [Field L] [Algebra K M] [Algebra M L]
    [Algebra K L] [IsScalarTower K M L] [FiniteDimensional K L] [IsGalois K L]
    (B : Type u) [CommRing B] [Algebra ↥W B] [Algebra B M] (σ : M ≃ₐ[K] M) (φ : B ≃ₐ[↥W] B),
    (∀ x : B, algebraMap B M (φ x) = σ (algebraMap B M x)) → ∀ (z : B) (c b : ↥W),
    (wcLlsDiscSep W B M L (φ z) c b ↔ wcLlsDiscSep W B M L z c b) :=
by
  intro Ω _ W K _ M L _ _ _ _ _ _ _ _ B _ _ _ σ φ hH z c b


  have hRE : ∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) →
      wcpaDjLkDelta R = wcpaDjLkDelta S ∧ wcpaDjLkBranches R = wcpaDjLkBranches S := by
    intro R S _ _ e
    classical
    let eF : FractionRing R ≃+* FractionRing S := IsFractionRing.ringEquivOfRingEquiv e
    have H1 : ∀ r : R, eF (algebraMap R (FractionRing R) r) =
        algebraMap S (FractionRing S) (e r) :=
      fun r => IsFractionRing.ringEquivOfRingEquiv_algebraMap e r
    have H2 : ∀ s : S, eF.symm (algebraMap S (FractionRing S) s) =
        algebraMap R (FractionRing R) (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, H1, RingEquiv.apply_symm_apply]
    have C1 : (algebraMap S (FractionRing S)).comp (e : R →+* S) =
        (eF : FractionRing R →+* FractionRing S).comp (algebraMap R (FractionRing R)) := by
      ext r
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H1 r).symm
    have C2 : (algebraMap R (FractionRing R)).comp (e.symm : S →+* R) =
        (eF.symm : FractionRing S →+* FractionRing R).comp (algebraMap S (FractionRing S)) := by
      ext s
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H2 s).symm
    have I1 : ∀ x : FractionRing R, _root_.IsIntegral R x → _root_.IsIntegral S (eF x) :=
      fun x hx => hx.map_of_comp_eq (e : R →+* S) (eF : FractionRing R →+* FractionRing S) C1
    have I2 : ∀ y : FractionRing S, _root_.IsIntegral S y → _root_.IsIntegral R (eF.symm y) :=
      fun y hy =>
        hy.map_of_comp_eq (e.symm : S →+* R) (eF.symm : FractionRing S →+* FractionRing R) C2
    let eI : ↥(integralClosure R (FractionRing R)) ≃+* ↥(integralClosure S (FractionRing S)) :=
      { toFun := fun x => ⟨eF x, I1 x x.2⟩
        invFun := fun y => ⟨eF.symm y, I2 y y.2⟩
        left_inv := fun x => Subtype.ext (eF.symm_apply_apply x)
        right_inv := fun y => Subtype.ext (eF.apply_symm_apply y)
        map_mul' := fun x y => Subtype.ext (map_mul eF (x : FractionRing R) y)
        map_add' := fun x y => Subtype.ext (map_add eF (x : FractionRing R) y) }
    have heI : ∀ r : R, eI (algebraMap R _ r) = algebraMap S _ (e r) :=
      fun r => Subtype.ext (H1 r)
    have heI' : ∀ s : S, eI.symm (algebraMap S _ s) = algebraMap R _ (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, heI, RingEquiv.apply_symm_apply]
    constructor
    · letI : RingHomInvPair (e : R →+* S) (e.symm : S →+* R) := RingHomInvPair.of_ringEquiv e
      letI : RingHomInvPair (e.symm : S →+* R) (e : R →+* S) := RingHomInvPair.symm _ _
      let LeI : ↥(integralClosure R (FractionRing R)) →ₛₗ[(e : R →+* S)]
          ↥(integralClosure S (FractionRing S)) :=
        { toFun := eI
          map_add' := map_add eI
          map_smul' := fun r a => by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI]
            rfl }
      let LeI' : ↥(integralClosure S (FractionRing S)) →ₛₗ[(e.symm : S →+* R)]
          ↥(integralClosure R (FractionRing R)) :=
        { toFun := eI.symm
          map_add' := map_add eI.symm
          map_smul' := fun s b => by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI']
            rfl }
      let p := LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))
      let q := LinearMap.range (Algebra.linearMap S ↥(integralClosure S (FractionRing S)))
      have h1 : p ≤ q.comap LeI := by
        rintro _ ⟨r, rfl⟩
        exact ⟨e r, (heI r).symm⟩
      have h2 : q ≤ p.comap LeI' := by
        rintro _ ⟨s, rfl⟩
        exact ⟨e.symm s, (heI' s).symm⟩
      let Φ := p.mapQ q LeI h1
      let Φ' := q.mapQ p LeI' h2
      let Φe : (↥(integralClosure R (FractionRing R)) ⧸ p) ≃ₛₗ[(e : R →+* S)]
          (↥(integralClosure S (FractionRing S)) ⧸ q) :=
        { Φ with
          invFun := Φ'
          left_inv := fun x => by
            induction x using Submodule.Quotient.induction_on with
            | H a =>
              show Φ' (Φ (Submodule.Quotient.mk a)) = Submodule.Quotient.mk a
              rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
              exact congrArg _ (eI.symm_apply_apply a)
          right_inv := fun x => by
            induction x using Submodule.Quotient.induction_on with
            | H b =>
              show Φ (Φ' (Submodule.Quotient.mk b)) = Submodule.Quotient.mk b
              rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
              exact congrArg _ (eI.apply_symm_apply b) }
      let O := Submodule.orderIsoMapComap Φe
      unfold wcpaDjLkDelta
      rw [Module.length_eq_height, Module.length_eq_height, ← Order.height_orderIso O ⊤,
        OrderIso.map_top]
    · unfold wcpaDjLkBranches
      apply ENat.card_congr
      exact
        { toFun := fun M => ⟨M.asIdeal.comap (eI.symm : _ →+* _), by
            haveI := M.isMaximal
            exact Ideal.comap_isMaximal_of_surjective _ eI.symm.surjective⟩
          invFun := fun N => ⟨N.asIdeal.comap (eI : _ →+* _), by
            haveI := N.isMaximal
            exact Ideal.comap_isMaximal_of_surjective _ eI.surjective⟩
          left_inv := fun M => by
            ext x
            show eI.symm (eI x) ∈ M.asIdeal ↔ x ∈ M.asIdeal
            rw [RingEquiv.symm_apply_apply]
          right_inv := fun N => by
            ext x
            show eI (eI.symm x) ∈ N.asIdeal ↔ x ∈ N.asIdeal
            rw [RingEquiv.apply_symm_apply] }

  have hT : ∀ (σ₀ : M ≃+* M) (φ₀ : B ≃+* B) (τ₀ : L ≃+* L),
      (∀ x : B, algebraMap B M (φ₀ x) = σ₀ (algebraMap B M x)) →
      (∀ m : M, τ₀ (algebraMap M L m) = algebraMap M L (σ₀ m)) →
      (∀ w : ↥W, φ₀ (algebraMap ↥W B w) = algebraMap ↥W B w) →
      ∀ (y : B) (s : M), wcLlsSepAt W B M L y s → wcLlsSepAt W B M L (φ₀ y) (σ₀ s) := by
    intro σ₀ φ₀ τ₀ H₀ T₀ W₀ y s hSep
    have H₀' : ∀ x : B, algebraMap B M (φ₀.symm x) = σ₀.symm (algebraMap B M x) := by
      intro x
      apply σ₀.injective
      rw [RingEquiv.apply_symm_apply, ← H₀, RingEquiv.apply_symm_apply]

    have fwd : ∀ m ∈ Algebra.adjoin B {s}, σ₀ m ∈ Algebra.adjoin B {σ₀ s} := by
      intro m hm
      induction hm using Algebra.adjoin_induction with
      | mem x hx =>
        rw [Set.mem_singleton_iff.mp hx]
        exact Algebra.subset_adjoin (Set.mem_singleton _)
      | algebraMap r =>
        rw [← H₀]
        exact Subalgebra.algebraMap_mem _ _
      | add a a' _ _ ha ha' =>
        rw [map_add]
        exact add_mem ha ha'
      | mul a a' _ _ ha ha' =>
        rw [map_mul]
        exact mul_mem ha ha'
    have bwd : ∀ m ∈ Algebra.adjoin B {σ₀ s}, σ₀.symm m ∈ Algebra.adjoin B {s} := by
      intro m hm
      induction hm using Algebra.adjoin_induction with
      | mem x hx =>
        rw [Set.mem_singleton_iff.mp hx, RingEquiv.symm_apply_apply]
        exact Algebra.subset_adjoin (Set.mem_singleton _)
      | algebraMap r =>
        rw [← H₀']
        exact Subalgebra.algebraMap_mem _ _
      | add a a' _ _ ha ha' =>
        rw [map_add]
        exact add_mem ha ha'
      | mul a a' _ _ ha ha' =>
        rw [map_mul]
        exact mul_mem ha ha'
    let e : ↥(Algebra.adjoin B {s}) ≃+* ↥(Algebra.adjoin B {σ₀ s}) :=
      { toFun := fun x => ⟨σ₀ x, fwd x x.2⟩
        invFun := fun x => ⟨σ₀.symm x, bwd x x.2⟩
        left_inv := fun x => Subtype.ext (σ₀.symm_apply_apply (x : M))
        right_inv := fun x => Subtype.ext (σ₀.apply_symm_apply (x : M))
        map_mul' := fun x x' => Subtype.ext (map_mul σ₀ (x : M) (x' : M))
        map_add' := fun x x' => Subtype.ext (map_add σ₀ (x : M) (x' : M)) }

    have hcomp : ∀ x : ↥(Algebra.adjoin B {s}),
        algebraMap (↥(Algebra.adjoin B {σ₀ s})) L (e x) =
          τ₀ (algebraMap (↥(Algebra.adjoin B {s})) L x) := by
      intro x
      show algebraMap M L (σ₀ (x : M)) = τ₀ (algebraMap M L (x : M))
      rw [T₀]
    have hcomp' : ∀ x : ↥(Algebra.adjoin B {σ₀ s}),
        algebraMap (↥(Algebra.adjoin B {s})) L (e.symm x) =
          τ₀.symm (algebraMap (↥(Algebra.adjoin B {σ₀ s})) L x) := by
      intro x
      apply τ₀.injective
      rw [RingEquiv.apply_symm_apply, ← hcomp, RingEquiv.apply_symm_apply]
    have ifwd : ∀ a : L, a ∈ integralClosure (↥(Algebra.adjoin B {s})) L →
        τ₀ a ∈ integralClosure (↥(Algebra.adjoin B {σ₀ s})) L := by
      intro a ha
      rw [mem_integralClosure_iff] at ha ⊢
      exact ha.map_of_comp_eq (e : ↥(Algebra.adjoin B {s}) →+* ↥(Algebra.adjoin B {σ₀ s}))
        (τ₀ : L →+* L) (RingHom.ext fun x => hcomp x)
    have ibwd : ∀ a : L, a ∈ integralClosure (↥(Algebra.adjoin B {σ₀ s})) L →
        τ₀.symm a ∈ integralClosure (↥(Algebra.adjoin B {s})) L := by
      intro a ha
      rw [mem_integralClosure_iff] at ha ⊢
      exact ha.map_of_comp_eq (e.symm : ↥(Algebra.adjoin B {σ₀ s}) →+* ↥(Algebra.adjoin B {s}))
        (τ₀.symm : L →+* L) (RingHom.ext fun x => hcomp' x)
    let E : ↥(integralClosure (↥(Algebra.adjoin B {s})) L) ≃+*
        ↥(integralClosure (↥(Algebra.adjoin B {σ₀ s})) L) :=
      { toFun := fun x => ⟨τ₀ x, ifwd x x.2⟩
        invFun := fun x => ⟨τ₀.symm x, ibwd x x.2⟩
        left_inv := fun x => Subtype.ext (τ₀.symm_apply_apply (x : L))
        right_inv := fun x => Subtype.ext (τ₀.apply_symm_apply (x : L))
        map_mul' := fun x x' => Subtype.ext (map_mul τ₀ (x : L) (x' : L))
        map_add' := fun x x' => Subtype.ext (map_add τ₀ (x : L) (x' : L)) }
    have hτw : ∀ w : ↥W, τ₀ (((algebraMap M L).comp ((algebraMap B M).comp (algebraMap ↥W B))) w) =
        ((algebraMap M L).comp ((algebraMap B M).comp (algebraMap ↥W B))) w := by
      intro w
      show τ₀ (algebraMap M L (algebraMap B M (algebraMap ↥W B w))) =
        algebraMap M L (algebraMap B M (algebraMap ↥W B w))
