    · exact absurd hl hnot1

  have hrat := hU.2.2.1
  have hnzd := hU.2.2.2.1
  set I : Ideal (MvPolynomial (Fin 2) ↥W) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c} with hIdef
  have h00 : (rM.appLE ⊤ (U 0) (by simp)).hom
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) =
      t 0 0 * (rM.appLE ⊤ (U 0) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) :=
    hrat 0 0
  have h01 : (rM.appLE ⊤ (U 0) (by simp)).hom
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)) =
      t 0 1 * (rM.appLE ⊤ (U 0) (by simp)).hom
