  obtain ⟨ζE, hEw, hEc, hEx, VE, hVE⟩ := wcpa_dj_lr1k_nsr_eb_exc_witness Ω W hW hWt C γ hcov
    X uX ι hM y₀ hSm σ a hP X₁ r₁ ι₁ hbl hι₁ hM₁ w hwx hwns

