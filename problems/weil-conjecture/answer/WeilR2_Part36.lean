    have hB : ((Limits.pullback rb U.ι).presheaf.germ ⊤ ρ trivial).hom
          ((Limits.pullback.snd rb U.ι).appTop.hom
            ((U.ι ≫ uX).appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom b))) =
