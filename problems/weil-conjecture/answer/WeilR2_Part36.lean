      μ ∉ Set.range (algebraMap V (FractionRing V)) := by
    by_contra hcon
    push_neg at hcon
    apply hbadval
    have := s4 V (FractionRing V) (algebraMap V _) _ hP'm hcon i
    rwa [Polynomial.coeff_map] at this
