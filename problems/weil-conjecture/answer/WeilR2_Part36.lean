      map_smul' := fun w x => by
        rw [Algebra.smul_def, hD1, hW, mul_zero, add_zero, RingHom.id_apply, Algebra.smul_def]
        rfl }
  let D' : Derivation W A' F := Derivation.mk' L (fun x y => by
    show D (x * y) = x • D y + y • D x
    rw [Algebra.smul_def, Algebra.smul_def, hD1]
    rfl)
  have hD' : ∀ x, D' x = D x := fun x => rfl
  let ℓ := D'.liftKaehlerDifferential
  have h₁ : q ≤ RingHom.ker ρ := fun x hx => (RingHom.mem_ker).mpr ((hρ x).mpr hx)
  have h₂ : q.primeCompl ≤ Submonoid.comap ρ (IsUnit.submonoid F) := by
    intro x hx
    rw [Submonoid.mem_comap, IsUnit.mem_submonoid_iff]
    exact isUnit_iff_ne_zero.mpr (fun h => hx ((hρ x).mp h))
  let ρbar := Ideal.ResidueField.lift q ρ h₁ h₂
  letI iK : Algebra q.ResidueField F := ρbar.toAlgebra
  haveI : IsScalarTower A' q.ResidueField F := IsScalarTower.of_algebraMap_eq
    (fun r => (Ideal.ResidueField.lift_algebraMap q ρ h₁ h₂ r).symm)
  let Φ := ℓ.liftBaseChange q.ResidueField
  intro h0
  apply hDa
  have := congrArg Φ h0
  rw [LinearMap.liftBaseChange_one_tmul, map_zero] at this
  rw [← hD', ← Derivation.liftKaehlerDifferential_comp_D D']
  exact this

