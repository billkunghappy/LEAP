  have s0 : ∀ p q : ↥W, p ∣ q ↔ W.valuation ((q : ↥W) : Ω) ≤ W.valuation ((p : ↥W) : Ω) := by
    intro p q
    rw [ValuationSubring.valuation_le_iff]
    constructor
    · rintro ⟨c, rfl⟩
      exact ⟨c, by push_cast; ring⟩
    · rintro ⟨a, ha⟩
      exact ⟨a, Subtype.ext (by push_cast; rw [← ha]; ring)⟩

  have vprod : ∀ l : List ↥W, W.valuation (((l.prod : ↥W)) : Ω) =
      (l.map (fun y : ↥W => W.valuation ((y : ↥W) : Ω))).prod := by
    intro l
    induction l with
    | nil => simp
    | cons a l ih => rw [List.prod_cons, List.map_cons, List.prod_cons, ← ih, ← map_mul]; push_cast; rfl

  have factor : ∀ γ y : ↥W, W.valuation (((@ite _ (γ ∣ y) (Classical.propDecidable _) γ y : ↥W)) : Ω) =
      max (W.valuation ((γ : ↥W) : Ω)) (W.valuation ((y : ↥W) : Ω)) := by
    intro γ y
    split_ifs with h
    · exact (max_eq_left ((s0 γ y).mp h)).symm
    · exact (max_eq_right (le_of_lt (not_le.mp (fun h' => h ((s0 γ y).mpr h'))))).symm
  set v := W.valuation with hv
  set d : ↥W → W.ValueGroup := fun r => v ((x - r : ↥W) : Ω) with hd
