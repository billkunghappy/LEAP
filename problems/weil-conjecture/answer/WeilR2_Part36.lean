          b ∣ (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ₁.appLE V ⊤ e₁).hom i) := by
      intro σ₁ b h₁ e₁ i
      rw [wcpa_dj_lr1k_ll_dp_centre_ideal Ω W X uX σ₁ h₁ V hV hle e₁ b]
      exact Ideal.mem_span_singleton
    have hCst : ∀ (σ₁ : Spec (.of ↥W) ⟶ X), σ₁ ≫ uX = 𝟙 _ → ∀ (e₁ : ⊤ ≤ σ₁ ⁻¹ᵁ V) (b : ↥W),
