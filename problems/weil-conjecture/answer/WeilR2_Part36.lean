    have h4 : MvPolynomial.X 0 ∈ (m η').asIdeal := by
      have h4' : η' ∉ m ⁻¹ᵁ (Spec (.of (MvPolynomial (Fin 1) ↥W))).basicOpen
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) := by
        rw [Scheme.preimage_basicOpen]; exact h3
