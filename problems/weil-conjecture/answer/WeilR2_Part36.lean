        (A.presheaf.germ ⊤ a trivial).hom (F'.appTop.hom s) := by
    intro A Z F F' hF s a
    subst hF
    rfl
  have hqA : ∀ {Z : Scheme.{u}} (F : Z ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))),
      (F ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))).appTop.hom
