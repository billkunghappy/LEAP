      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_left _ _ ha')
  have hres : ∀ x : ↥(wcLlsASmS W A K u β (β * t)), x ∉ wcLlsASmN W A K u β (β * t) →
      ∃ y : ↥(wcLlsASmS W A K u β (β * t)), x * y - 1 ∈ wcLlsASmN W A K u β (β * t) := by
    intro x hx
    obtain ⟨a, ha⟩ := hcong x
    have ha𝔭 : a ∉ 𝔭 := by
      intro ha𝔭
      apply hx
      have h1 : algebraMap A ↥(wcLlsASmS W A K u β (β * t)) a ∈ wcLlsASmN W A K u β (β * t) :=
