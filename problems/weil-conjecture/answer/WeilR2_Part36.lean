      exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h3)) hq
    have hid : (v - v') * q.eval c = (p.eval c - p.eval c') - v' * (q.eval c - q.eval c') := by
      rw [← hv, ← hv']; ring
    have hd : c - c' ∣ (v - v') * q.eval c := by
      rw [hid]
      exact dvd_sub (Polynomial.sub_dvd_eval_sub c c' p)
        (Dvd.dvd.mul_left (Polynomial.sub_dvd_eval_sub c c' q) _)
    exact hU.dvd_mul_right.mp hd
  have heσ : ∀ σ : Spec (.of ↥W) ⟶ X, σ (IsLocalRing.closedPoint ↥W) = x → ⊤ ≤ σ ⁻¹ᵁ V :=
    fun σ h => (Scheme.preimage_eq_top_of_closedPoint_mem σ (by rw [h]; exact hxV)).ge
  have hτv : ∀ (σ : Spec (.of ↥W) ⟶ X) (e : ⊤ ≤ σ ⁻¹ᵁ V), wcUrTau W V g σ =
      (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ.appLE V ⊤ e).hom g) := by
    intro σ e; unfold wcUrTau; rw [dif_pos e]
  have pkg : ∀ σ : Spec (.of ↥W) ⟶ X, σ ≫ uX = 𝟙 _ → σ (IsLocalRing.closedPoint ↥W) = x →
      ∃ ε : ↥(X.presheaf.stalk x) →+* ↥W, IsLocalHom ε ∧ (∀ w, ε (κ w) = w) ∧
        (∀ (e' : ⊤ ≤ σ ⁻¹ᵁ V) (h : Γ(X, V)), ε ((X.presheaf.germ V x hxV).hom h) =
          (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ.appLE V ⊤ e').hom h)) ∧
        wcUrTau W V g σ = ε s₀ := by
    intro σ hσ hσx
    obtain ⟨ε, hεl, hεk, hεg⟩ :=
      wcpa_dj_lr1k_nsr_nlb_ue_ur_dp_eval ↥W X uX x V hxV σ hσ hσx
    exact ⟨ε, hεl, hεk, hεg, (hτv σ (heσ σ hσx)).trans (hεg (heσ σ hσx) g).symm⟩
  have hD1 : ∀ σ : Spec (.of ↥W) ⟶ X, σ ≫ uX = 𝟙 _ → σ (IsLocalRing.closedPoint ↥W) = x →
      wcUrTau W V g σ ∈ IsLocalRing.maximalIdeal ↥W := by
    intro σ hσ hσx
    obtain ⟨ε, hεl, -, -, hτσ⟩ := pkg σ hσ hσx
    haveI := hεl
    rw [hτσ]
    by_contra hn
    have hu : IsUnit (ε s₀) := by
      by_contra hn'
      exact hn ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hn'))
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hgm))
      (isUnit_of_map_unit ε _ hu)
  refine ⟨hD1, ?_, ?_⟩
  ·
    intro c hc
    obtain ⟨ψ, hψl, hψ⟩ := wcpa_dj_lr1k_nsr_nlb_ue_ur_dp_ev_hom ↥W ↥(X.presheaf.stalk x)
      C.functionField G φW t htrW hdict c hc
    have hψk : ∀ w, ψ (κ w) = w := by
      intro w
      have h := hψ (κ w) (Polynomial.C w) 1 (by rw [Polynomial.coeff_one_zero]; exact isUnit_one)
        (by rw [Polynomial.eval₂_one, mul_one, Polynomial.eval₂_C]; exact hGκ w)
      rwa [Polynomial.eval_one, mul_one, Polynomial.eval_C] at h
    have hψs : ψ s₀ = c := by
      have h := hψ s₀ Polynomial.X 1 (by rw [Polynomial.coeff_one_zero]; exact isUnit_one)
        (by rw [Polynomial.eval₂_one, mul_one, Polynomial.eval₂_X]; exact hgt)
      rwa [Polynomial.eval_one, mul_one, Polynomial.eval_X] at h
    obtain ⟨σ, hσ, hσx, hθ⟩ :=
      wcpa_dj_lr1k_nsr_nlb_ue_ur_dp_section ↥W X uX x V hxV ψ hψl hψk
    exact ⟨σ, hσ, hσx, (hτv σ (heσ σ hσx)).trans ((hθ (heσ σ hσx) g).trans hψs)⟩
  ·
    intro σ a σ' a' hP hP'
    obtain ⟨hσ, hσx, ha0, ham⟩ := hP
    obtain ⟨hσ', hσx', -, -⟩ := hP'
    have e := heσ σ hσx
    have e' := heσ σ' hσx'
    obtain ⟨ε, -, hεk, hεg, hτσ⟩ := pkg σ hσ hσx
    obtain ⟨ε', -, hεk', hεg', hτσ'⟩ := pkg σ' hσ' hσx'
    have hI : ∀ (σ₁ : Spec (.of ↥W) ⟶ X) (b : ↥W), σ₁ ≫ uX = 𝟙 _ →
        ∀ (e₁ : ⊤ ≤ σ₁ ⁻¹ᵁ V) (i : Γ(X, V)),
