    have hsp : η' ⤳ ΔU (IsLocalRing.closedPoint ↥W) := by
      rw [← U.ι.isOpenEmbedding.isInducing.specializes_iff, hη'eq, hx'eq]; exact hηx
    have h3 : η' ∉ U.toScheme.basicOpen (m.appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))) := by
      rw [← hgT, Scheme.basicOpen_appLE]
