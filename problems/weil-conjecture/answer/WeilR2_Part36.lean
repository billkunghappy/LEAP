    Set.range (fun j => (f₁.appIso (U' l)).inv.hom (t l j)),
    (H2 l).image_of_isOpenImmersion f₁, hmem p' l hl, ?_, ?_, ?_, c3⟩
  · rw [hI]; exact Ideal.subset_span ⟨l, rfl⟩
  · intro f hf
    rw [hI] at hf
