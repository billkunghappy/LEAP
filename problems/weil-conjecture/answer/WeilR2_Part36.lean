  haveI : Normal K L := IsGalois.to_normal
  let τ : L ≃+* L := (σ.liftNormal L).toRingEquiv
  have hTτ : ∀ m : M, τ (algebraMap M L m) = algebraMap M L (σ m) := fun m =>
    AlgEquiv.liftNormal_commutes σ L m
  have hW : ∀ w : ↥W, φ (algebraMap ↥W B w) = algebraMap ↥W B w := fun w => φ.commutes w
  have hb : σ (algebraMap B M (algebraMap ↥W B b)) = algebraMap B M (algebraMap ↥W B b) := by
    rw [← hH, hW]
  have key1 : φ z - algebraMap ↥W B c = φ (z - algebraMap ↥W B c) := by
    rw [map_sub, hW]
  have key2 : algebraMap B M (algebraMap ↥W B b) / algebraMap B M (φ (z - algebraMap ↥W B c)) =
      σ (algebraMap B M (algebraMap ↥W B b) / algebraMap B M (z - algebraMap ↥W B c)) := by
    rw [map_div₀, hH, hb]
  unfold wcLlsDiscSep
  rw [key1, key2]
  constructor
  · intro h
    have H' : ∀ x : B, algebraMap B M (φ.symm.toRingEquiv x) =
        σ.symm.toRingEquiv (algebraMap B M x) := by
      intro x
      show algebraMap B M (φ.symm x) = σ.symm (algebraMap B M x)
      apply σ.injective
      rw [AlgEquiv.apply_symm_apply, ← hH, AlgEquiv.apply_symm_apply]
    have T' : ∀ m : M, τ.symm (algebraMap M L m) = algebraMap M L (σ.symm.toRingEquiv m) := by
      intro m
      apply τ.injective
      rw [RingEquiv.apply_symm_apply]
      show algebraMap M L m = τ (algebraMap M L (σ.symm m))
      rw [hTτ, AlgEquiv.apply_symm_apply]
    have W' : ∀ w : ↥W, φ.symm.toRingEquiv (algebraMap ↥W B w) = algebraMap ↥W B w := fun w =>
      φ.symm.commutes w
    have h' := hT σ.symm.toRingEquiv φ.symm.toRingEquiv τ.symm H' T' W' _ _ h
    have e1 : φ.symm.toRingEquiv (φ (z - algebraMap ↥W B c)) = z - algebraMap ↥W B c :=
