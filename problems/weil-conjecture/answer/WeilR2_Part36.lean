    haveI : Finite H := Finite.of_equiv {a : C ≅ C // a.hom ≫ γ = γ}
      ⟨fun x => ⟨x.1, (hHmem x.1).2 x.2⟩, fun x => ⟨x.1, (hHmem x.1).1 x.2⟩,
        fun _ => rfl, fun _ => rfl⟩
    have hH : ∀ a : Aut C, a ∈ H → a.hom ≫ (γ ≫ ι) = γ ≫ ι := by
      intro a ha
      rw [← Category.assoc, (hHmem a).1 ha]
    obtain ⟨ρ, hρν, hρτ⟩ : ∃ ρ : H → ((γ ≫ ι).normalization ⟶ (γ ≫ ι).normalization),
        (∀ g, ρ g ≫ (γ ≫ ι).fromNormalization = (γ ≫ ι).fromNormalization) ∧
        (∀ g, (γ ≫ ι).toNormalization ≫ ρ g = (g : Aut C).hom ≫ (γ ≫ ι).toNormalization) :=
      ⟨fun g => (γ ≫ ι).normalizationDesc ((g : Aut C).hom ≫ (γ ≫ ι).toNormalization)
          (γ ≫ ι).fromNormalization (by
            rw [Category.assoc, Scheme.Hom.toNormalization_fromNormalization, hH g g.2]),
        fun g => Scheme.Hom.normalizationDesc_comp _ _ _ _,
        fun g => Scheme.Hom.toNormalization_normalizationDesc _ _ _ _⟩
    have hρ1 : ρ 1 = 𝟙 _ := by
      apply Scheme.Hom.normalization.hom_ext (γ ≫ ι) _ _ (γ ≫ ι).fromNormalization
      · rw [hρτ 1, Category.comp_id]
        exact Category.id_comp _
      · exact hρν 1
      · exact Category.id_comp _
    have hρmul : ∀ g h, ρ (g * h) = ρ h ≫ ρ g := by
      intro g h
      apply Scheme.Hom.normalization.hom_ext (γ ≫ ι) _ _ (γ ≫ ι).fromNormalization
      · rw [hρτ (g * h), ← Category.assoc, hρτ h, Category.assoc, hρτ g, ← Category.assoc]
        rfl
      · exact hρν _
      · rw [Category.assoc, hρν g, hρν h]
    obtain ⟨U, hUmem, hzU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens X)) (show (γ ≫ ι).fromNormalization z ∈ (⊤ : X.Opens) from trivial)
    have hU : IsAffineOpen U := hUmem
    have hV : IsAffineOpen ((γ ≫ ι).fromNormalization ⁻¹ᵁ U) := hU.preimage _
    have hz : z ∈ (γ ≫ ι).fromNormalization ⁻¹ᵁ U := hzU
    have hz' : z' ∈ (γ ≫ ι).fromNormalization ⁻¹ᵁ U := by
      show (γ ≫ ι).fromNormalization z' ∈ U
      rw [← hzz]; exact hzU
    have hle : ∀ g, (γ ≫ ι).fromNormalization ⁻¹ᵁ U ≤
        ρ g ⁻¹ᵁ ((γ ≫ ι).fromNormalization ⁻¹ᵁ U) := by
      intro g
      rw [← Scheme.Hom.comp_preimage, hρν g]
    have h1 : ∀ b, ((ρ 1).appLE _ _ (hle 1)).hom b = b := by
      intro b
      rw [hcongr (ρ 1) (𝟙 _) _ _ (hle 1) (hρ1 ▸ hle 1) hρ1]
      exact hid _ _ b
    have h2 : ∀ g h b, ((ρ (g * h)).appLE _ _ (hle (g * h))).hom b =
        ((ρ h).appLE _ _ (hle h)).hom (((ρ g).appLE _ _ (hle g)).hom b) := by
      intro g h b
      rw [hcongr (ρ (g * h)) (ρ h ≫ ρ g) _ _ (hle (g * h)) (hρmul g h ▸ hle (g * h)) (hρmul g h)]
      exact hcomp _ _ _ _ _ _ b
    have h3 : ∀ g a, ((ρ g).appLE _ _ (hle g)).hom (((γ ≫ ι).fromNormalization.app U).hom a) =
        ((γ ≫ ι).fromNormalization.app U).hom a := fun g a => hfix (ρ g) U (hle g) (hρν g) a
    have e : (γ ≫ ι) ⁻¹ᵁ U ≤ (γ ≫ ι).toNormalization ⁻¹ᵁ ((γ ≫ ι).fromNormalization ⁻¹ᵁ U) := by
      rw [← Scheme.Hom.comp_preimage, Scheme.Hom.toNormalization_fromNormalization]
    have hfact : (γ ≫ ι).fromNormalization.app U ≫
        (γ ≫ ι).toNormalization.appLE ((γ ≫ ι).fromNormalization ⁻¹ᵁ U) ((γ ≫ ι) ⁻¹ᵁ U) e =
        (γ ≫ ι).app U := by
      rw [Scheme.Hom.app_eq_appLE (γ ≫ ι).fromNormalization, Scheme.Hom.appLE_comp_appLE,
        Scheme.Hom.app_eq_appLE (γ ≫ ι)]
      exact hcongr _ _ _ _ _ _ (Scheme.Hom.toNormalization_fromNormalization (γ ≫ ι))
    have tinj := htinj C X (γ ≫ ι) U hU e
    have h4 : ∀ b, (∀ g, ((ρ g).appLE _ _ (hle g)).hom b = b) →
        ∃ a, ((γ ≫ ι).fromNormalization.app U).hom a = b := by
      intro b hb
      have hbint : ((γ ≫ ι).fromNormalization.app U).hom.IsIntegralElem b :=
        IsIntegralHom.isIntegral_app _ U hU b
      have hsint : ((γ ≫ ι).app U).hom.IsIntegralElem
          (((γ ≫ ι).toNormalization.appLE ((γ ≫ ι).fromNormalization ⁻¹ᵁ U)
            ((γ ≫ ι) ⁻¹ᵁ U) e).hom b) := by
        obtain ⟨p, hpm, hp⟩ := hbint
        refine ⟨p, hpm, ?_⟩
        rw [← hfact, CommRingCat.hom_comp, ← Polynomial.hom_eval₂, hp, map_zero]
      have hσle : ∀ g : H, (γ ≫ ι) ⁻¹ᵁ U ≤ (g : Aut C).hom ⁻¹ᵁ ((γ ≫ ι) ⁻¹ᵁ U) := by
        intro g
        rw [← Scheme.Hom.comp_preimage, hH g g.2]
      have hsfix : ∀ g : H, ((g : Aut C).hom.appLE ((γ ≫ ι) ⁻¹ᵁ U) ((γ ≫ ι) ⁻¹ᵁ U) (hσle g)).hom
          (((γ ≫ ι).toNormalization.appLE ((γ ≫ ι).fromNormalization ⁻¹ᵁ U)
            ((γ ≫ ι) ⁻¹ᵁ U) e).hom b) =
          ((γ ≫ ι).toNormalization.appLE ((γ ≫ ι).fromNormalization ⁻¹ᵁ U)
            ((γ ≫ ι) ⁻¹ᵁ U) e).hom b := by
        intro g
        have e2 : (γ ≫ ι).toNormalization.appLE ((γ ≫ ι).fromNormalization ⁻¹ᵁ U)
              ((γ ≫ ι) ⁻¹ᵁ U) e ≫
              (g : Aut C).hom.appLE ((γ ≫ ι) ⁻¹ᵁ U) ((γ ≫ ι) ⁻¹ᵁ U) (hσle g) =
            (ρ g).appLE _ _ (hle g) ≫
              (γ ≫ ι).toNormalization.appLE ((γ ≫ ι).fromNormalization ⁻¹ᵁ U)
                ((γ ≫ ι) ⁻¹ᵁ U) e := by
          rw [Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_comp_appLE]
          exact hcongr _ _ _ _ _ _ (hρτ g).symm
        have e3 := congrArg (fun φ => φ.hom b) e2
        simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e3
        rw [e3, hb g]
      obtain ⟨r, hr⟩ := hinv U hU _ hsint (fun a h => hsfix ⟨a, (hHmem a).2 h⟩)
      refine ⟨r, tinj ?_⟩
      rw [← hr, ← hfact]
      rfl
    have hcontr : (hV.primeIdealOf ⟨z, hz⟩).asIdeal.comap ((γ ≫ ι).fromNormalization.app U).hom =
        (hV.primeIdealOf ⟨z', hz'⟩).asIdeal.comap ((γ ≫ ι).fromNormalization.app U).hom := by
      have hinj : Function.Injective hU.fromSpec :=
        hU.fromSpec.isOpenEmbedding.isEmbedding.injective
      have heq := hinj ((hgen _ _ (γ ≫ ι).fromNormalization U hU _ hV le_rfl z hz).trans
        (hzz.trans (hgen _ _ (γ ≫ ι).fromNormalization U hU _ hV le_rfl z' hz').symm))
      have := congrArg PrimeSpectrum.asIdeal heq
      rw [Scheme.Hom.app_eq_appLE]
      exact this
    obtain ⟨g, hg⟩ := s1 _ _ H _ (fun g => ((ρ g).appLE _ _ (hle g)).hom) h1 h2 h3 h4
      (hV.primeIdealOf ⟨z, hz⟩).asIdeal (hV.primeIdealOf ⟨z', hz'⟩).asIdeal
      (PrimeSpectrum.isPrime _) (PrimeSpectrum.isPrime _) hcontr
    have hp : (Spec.map ((ρ g).appLE _ _ (hle g))) (hV.primeIdealOf ⟨z, hz⟩) =
        hV.primeIdealOf ⟨z', hz'⟩ :=
      (Spec.map_apply _ _).trans (PrimeSpectrum.ext hg.symm)
    have hpt : (ρ g) z = z' :=
      (hgen _ _ (ρ g) _ hV _ hV (hle g) z hz).symm.trans
        ((congrArg (fun p => hV.fromSpec p) hp).trans (hV.fromSpec_primeIdealOf ⟨z', hz'⟩))
    exact ⟨(g : Aut C), ρ g, (hHmem _).1 g.2, hρτ g, hpt⟩
  obtain ⟨g, Ψ, hg, hΨt, hΨn⟩ := hmove n₁ (wcNdPt W (γ ≫ ι) uX y₀) (hn₁x.trans himg)

  have Hpre : ∀ (g1 : C ⟶ C) (h₀ : g1 (genericPoint C) ⤳ genericPoint C) {N : Scheme.{u}}
      (t1 : C ⟶ N) (n : N) (h : t1 (genericPoint C) ⤳ n) (h' : (g1 ≫ t1) (genericPoint C) ⤳ n),
      wcLr1uGerm t1 n h ≫ wcLr1uGerm g1 (genericPoint C) h₀ = wcLr1uGerm (g1 ≫ t1) n h' := by
    intro g1 h₀ N t1 n h h'
    unfold wcLr1uGerm
    rw [Scheme.Hom.stalkMap_comp]
    simp only [Category.assoc]
    rw [← Scheme.Hom.stalkSpecializes_stalkMap_assoc, TopCat.Presheaf.stalkSpecializes_comp_assoc]
    rfl
  have Hcongr : ∀ {N : Scheme.{u}} (t1 t2 : C ⟶ N), t1 = t2 → ∀ (n : N)
      (h1 : t1 (genericPoint C) ⤳ n) (h2 : t2 (genericPoint C) ⤳ n),
      wcLr1uGerm t1 n h1 = wcLr1uGerm t2 n h2 := by
    intro N t1 t2 e n h1 h2
    subst e
    rfl
  have Hlt : ∀ (ψ : C.functionField →+* C.functionField) (z : C.functionField),
      (A₁.comap ψ).valuation z < 1 ↔ A₁.valuation (ψ z) < 1 := by
    intro ψ z
    by_cases hz : z = 0
    · subst hz; simp
    · have hz' : ψ z ≠ 0 := (map_ne_zero ψ).mpr hz
      rw [← not_le, ← not_le, Valuation.one_le_val_iff _ hz, Valuation.one_le_val_iff _ hz',
        ValuationSubring.valuation_le_one_iff, ValuationSubring.valuation_le_one_iff,
        ValuationSubring.mem_comap, map_inv₀]
  have hgen : genericPoint C ⤳ g.inv (genericPoint C) :=
    (genericPoint_spec C).specializes trivial
  have hginv : g.hom (g.inv (genericPoint C)) = genericPoint C := by
    have e : g.inv ≫ g.hom = 𝟙 C := Iso.inv_hom_id g
    rw [← Scheme.Hom.comp_apply, e]
    rfl
