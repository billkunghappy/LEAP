      P = ((R.filter (fun i => !decide (d i ≤ δ))).map (fun r => x - r)).prod := ⟨_, rfl⟩
  have hvPU : v ((PU : ↥W) : Ω) = C := by rw [hPUdef, hvP, hCdef]
  obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq ((b : Ω) / (PU : Ω)) (Nat.pos_of_ne_zero hk0)
  have hρ : v z ^ k * C = v ((b : ↥W) : Ω) := by
    rw [← map_pow, hz, map_div₀, hvPU, div_mul_cancel₀ _ hC0]
  have hδρ : δ ≤ v z := by
    have h1 : δ ^ k * C ≤ v z ^ k * C := by rw [hρ, ← eδ]; exact hfδ
    exact (pow_le_pow_iff_left₀ zero_le zero_le hk0).mp
      ((mul_le_mul_iff_left₀ (zero_lt_iff.mpr hC0)).mp h1)
  have hρδ' : v z < δ' := by
    have h1 : v z ^ k * C < δ' ^ k * C := by rw [hρ, ← eδ']; exact hfδ'
    exact lt_of_pow_lt_pow_left' k (lt_of_mul_lt_mul_right' h1)
  have hz1 : v z < 1 := lt_of_lt_of_le hρδ' (hδ'e.trans he1.le)
  have hzW : z ∈ W := (ValuationSubring.valuation_le_one_iff W z).mp hz1.le
  have hGγ : v (((R.map (fun r => @ite _ ((⟨z, hzW⟩ : ↥W) ∣ x - r) (Classical.propDecidable _)
      (⟨z, hzW⟩ : ↥W) (x - r))).prod : ↥W) : Ω) = v ((b : ↥W) : Ω) := by
    rw [hvG]
    show (R.map (fun r => max (v z) (d r))).prod = _
    rw [s2 d δ δ' (v z) R hD hδρ hρδ'.le, hk, hCdef]
    exact hρ
  refine ⟨⟨z, hzW⟩, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact (ValuationSubring.valuation_lt_one_iff W _).mpr hz1
  · intro h
    have h1 : z = 0 := congrArg Subtype.val h
    rw [h1, map_zero, zero_pow hk0, zero_mul] at hρ
    exact hB0 hρ.symm
  · exact (s0 b _).mpr hGγ.le
  · exact (s0 _ b).mpr hGγ.ge
