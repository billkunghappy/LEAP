        𝔮.comap (algebraMap ↥S ↥(integralClosure ↥S L)) = I →
        ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
          (algebraMap ↥W A))) ↥S 𝔮)) := by
    intro S T hST
    subst hST
