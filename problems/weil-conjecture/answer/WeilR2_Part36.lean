    have h3 : Z.fromSpecStalk z (p i) ⤳ Z.fromSpecStalk z q := by
      rw [hp i]; exact (hgen i).specializes hmem
    have h4 : p i ⤳ q := hemb.isInducing.specializes_iff.mp h3
    exact (PrimeSpectrum.le_iff_specializes (p i) q).mpr h4

