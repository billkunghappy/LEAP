  set w : M := (algebraMap B M t' - algebraMap B M (algebraMap ↥W B x)) /
    algebraMap B M (algebraMap ↥W B γ) with hw
  have hwg : algebraMap B M (algebraMap ↥W B γ) * w =
      algebraMap B M t' - algebraMap B M (algebraMap ↥W B x) := by
    rw [hw, mul_div_assoc', mul_div_cancel_left₀ _ hg0]
  have hker : ∀ F : Polynomial B, F.eval₂ (algebraMap B M) w = 0 →
      F ∈ Ideal.map Polynomial.C 𝔮 := by
