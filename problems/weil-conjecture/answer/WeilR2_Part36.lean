  refine ⟨fun P hP => ?_, fun P₁ P₂ h₂ hle => ?_⟩
  · obtain ⟨c, hPU, _⟩ := hmark
    obtain ⟨μ, k, u, hμ, hu, _, he⟩ := NF c hPU P hP
