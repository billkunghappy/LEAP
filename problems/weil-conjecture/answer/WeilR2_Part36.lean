    have hρV : ρ ∈ (Limits.pullback.fst rb U.ι ≫ rb) ⁻¹ᵁ V := hzV
    have hρV' : ρ ∈ (Limits.pullback.snd rb U.ι ≫ U.ι) ⁻¹ᵁ V := hprV
    have hσgU : (σU.app (U.ι ⁻¹ᵁ V)).hom ((U.ι.app V).hom g) = 0 := by
