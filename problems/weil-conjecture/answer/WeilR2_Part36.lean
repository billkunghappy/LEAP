          ((N.fromSpecStalk n).stalkMap s).hom ((N.presheaf.stalkSpecializes hs).hom c) =
            ((Spec (N.presheaf.stalk n)).presheaf.germ ⊤ s trivial).hom
              ((Scheme.ΓSpecIso (N.presheaf.stalk n)).inv.hom c) := by
        intro s hs c
        obtain ⟨U, hnU, f₀, rfl⟩ := N.presheaf.exists_germ_eq c
        rw [TopCat.Presheaf.germ_stalkSpecializes_apply, Scheme.Hom.germ_stalkMap_apply,
          Scheme.fromSpecStalk_app hnU]
        simp only [CategoryTheory.comp_apply]
        exact TopCat.Presheaf.germ_res_apply _ _ _ _ _
      have hcomp : ∀ c : N.presheaf.stalk n, j (algebraMap _ N.functionField c) =
          ((R.presheaf.germ ⊤ (genericPoint ↥R) trivial).hom.comp
            ((ρ ≫ Limits.pullback.snd p (N.fromSpecStalk n)).appTop.hom.comp
