        V.valuation ((C.presheaf.germ (f ⁻¹ᵁ U) (genericPoint C) hgen).hom ((f.app U).hom g)) →
      z ∉ U₀.1 := by
    intro z V hc hv hz0
    unfold wcNsrCentred wcLr1uDom at hc
