  generalize hCdef : ((R.filter (fun i => !decide (d i ≤ δ))).map d).prod = C at eδ eδ'
  have hC0 : C ≠ 0 := by
    intro h
    rw [← hCdef, List.prod_eq_zero_iff, List.mem_map] at h
