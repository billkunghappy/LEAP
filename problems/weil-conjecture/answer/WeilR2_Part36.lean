        | add x y hx hy ihx ihy =>
          obtain ⟨a, ha⟩ := ihx
          obtain ⟨a', ha'⟩ := ihy
          refine ⟨a + a', ?_⟩
          have e1 : (⟨x + y, add_mem hx hy⟩ : ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t))) -
              algebraMap A ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t)) (a + a') =
              ((⟨x, hx⟩ : ↥(wcLlsASmS W A K u₁ β₁ (β₁ * t))) -
