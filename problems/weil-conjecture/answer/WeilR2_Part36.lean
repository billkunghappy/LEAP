  have s5 (Y N : Scheme.{u}) (p : Y ⟶ N) [LocallyOfFiniteType p] [QuasiCompact p] (n : ↥N) :
      (irreducibleComponents ↥(⇑p ⁻¹' {n})).Finite := by
    haveI : LocallyOfFiniteType (p.fiberToSpecResidueField n) :=
      MorphismProperty.of_isPullback (P := @LocallyOfFiniteType)
        (IsPullback.of_hasPullback p (N.fromSpecResidueField n)) inferInstance
    haveI : QuasiCompact (p.fiberToSpecResidueField n) :=
      MorphismProperty.of_isPullback (P := @QuasiCompact)
        (IsPullback.of_hasPullback p (N.fromSpecResidueField n)) inferInstance
    haveI : IsLocallyNoetherian (p.fiber n) :=
      LocallyOfFiniteType.isLocallyNoetherian (p.fiberToSpecResidueField n)
    haveI : CompactSpace (p.fiber n) :=
      QuasiCompact.compactSpace_of_compactSpace (p.fiberToSpecResidueField n)
    haveI : AlgebraicGeometry.IsNoetherian (p.fiber n) := AlgebraicGeometry.IsNoetherian.mk
    haveI : TopologicalSpace.NoetherianSpace ↥(⇑p ⁻¹' {n}) :=
