theorem wcpa_dj_lr1k_nsr_na_er_residue_closure : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    [IsAlgClosed (IsLocalRing.ResidueField ↥W)] (L : Type u) [Field L] (A : ValuationSubring L)
    (φ : Ω →+* L), (∀ c : ↥W, A.valuation (φ c) ≤ 1) →
    (∀ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → A.valuation (φ c) < 1) →
    (∀ f : L, A.valuation f ≤ 1 → ∃ (n : ℕ) (a : Fin (n + 1) → L), (∃ i, a i ≠ 0) ∧
      (∀ i j, a j ≠ 0 → A.valuation (a i) ≤ A.valuation (a j) →
        ∃ b : ↥W, A.valuation (a i - φ b * a j) < A.valuation (a j)) ∧
      ∑ i, a i * f ^ (i : ℕ) = 0) →
    IsAlgClosed (IsLocalRing.ResidueField ↥A) ∧
      ∀ f : L, A.valuation f ≤ 1 → ∃ b : ↥W, A.valuation (f - φ b) < 1 :=
by
  intro Ω _ W _ L _ A φ h1 h2 H
  classical

  have s1 : ∀ (f : L), A.valuation f ≤ 1 → ∀ (n : ℕ) (a : Fin (n + 1) → L), (∃ i, a i ≠ 0) →
      (∀ i j, a j ≠ 0 → A.valuation (a i) ≤ A.valuation (a j) →
        ∃ b : ↥W, A.valuation (a i - φ b * a j) < A.valuation (a j)) →
      ∑ i, a i * f ^ (i : ℕ) = 0 →
      ∃ (b : Fin (n + 1) → ↥W) (j : Fin (n + 1)), b j = 1 ∧
        A.valuation (∑ i, φ (b i) * f ^ (i : ℕ)) < 1 := by
    intro f hf n a ⟨i₀, hi₀⟩ hrel hsum
    obtain ⟨j, -, hj⟩ := Finset.exists_max_image Finset.univ (fun i => A.valuation (a i))
      Finset.univ_nonempty
    have hvj : A.valuation (a j) ≠ 0 := by
      have h0 : 0 < A.valuation (a i₀) := (Valuation.pos_iff _).mpr hi₀
      exact (lt_of_lt_of_le h0 (hj i₀ (Finset.mem_univ _))).ne'
    have haj : a j ≠ 0 := fun h => hvj (by rw [h, map_zero])
    let b : Fin (n + 1) → ↥W := fun i =>
      if h : i = j then 1 else Classical.choose (hrel i j haj (hj i (Finset.mem_univ _)))
    have hb : ∀ i, A.valuation (a i - φ (b i) * a j) < A.valuation (a j) := by
      intro i
      by_cases h : i = j
      · have hbi : b i = 1 := by simp only [b, dif_pos h]
        rw [hbi, h, OneMemClass.coe_one, map_one, one_mul, sub_self, map_zero]
        exact (Valuation.pos_iff _).mpr haj
      · have hbi : b i = Classical.choose (hrel i j haj (hj i (Finset.mem_univ _))) := by
          simp only [b, dif_neg h]
        rw [hbi]
        exact Classical.choose_spec (hrel i j haj (hj i (Finset.mem_univ _)))
    refine ⟨b, j, by simp [b], ?_⟩
    have hid : a j * ∑ i, φ (b i) * f ^ (i : ℕ) =
        ∑ i, (φ (b i) * a j - a i) * f ^ (i : ℕ) := by
      have e : ∑ i, (φ (b i) * a j - a i) * f ^ (i : ℕ) =
          ∑ i, a j * (φ (b i) * f ^ (i : ℕ)) - ∑ i, a i * f ^ (i : ℕ) := by
        rw [← Finset.sum_sub_distrib]
        exact Finset.sum_congr rfl (fun i _ => by ring)
      rw [e, hsum, sub_zero, Finset.mul_sum]
    have hlt : A.valuation (a j * ∑ i, φ (b i) * f ^ (i : ℕ)) < A.valuation (a j) := by
      rw [hid]
      apply Valuation.map_sum_lt _ hvj
      intro i _
      rw [map_mul, map_pow, Valuation.map_sub_swap]
      calc A.valuation (a i - φ (b i) * a j) * A.valuation f ^ (i : ℕ)
          ≤ A.valuation (a i - φ (b i) * a j) := mul_le_of_le_one_right' (pow_le_one' hf _)
        _ < A.valuation (a j) := hb i
    by_contra hge
    push_neg at hge
    rw [map_mul] at hlt
    exact absurd (le_mul_of_one_le_right' hge) (not_le.mpr hlt)

  let ψ : W →+* A := (φ.comp W.subtype).codRestrict A
    (fun c => (A.valuation_le_one_iff _).1 (h1 c))
  haveI : IsLocalHom ψ := by
    refine ⟨fun c hc => ?_⟩
    by_contra hnu
    have hm : c ∈ IsLocalRing.maximalIdeal W :=
      (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu)
    have hmA : ψ c ∈ IsLocalRing.maximalIdeal A := (A.valuation_lt_one_iff (ψ c)).mpr (h2 c hm)
