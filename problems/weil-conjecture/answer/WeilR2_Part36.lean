    ⟨_, rfl⟩
  have hJ : J = (IsLocalRing.maximalIdeal ↥W).map
      ((algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)).comp
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) := by
