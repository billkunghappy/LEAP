            algebraMap C' (Localization.AtPrime Q') y := by
    intro C C' L _ _ _ _ _ i i' hi hi' υ υ' hυυ' H H' Q hQ Q' hQ' hυ' HQ
    have HQr : ∀ (x' : C') (k : ℕ) (y : C), i y = i υ ^ k * i' x' → (y ∈ Q ↔ x' ∈ Q') := by
      intro x' k y hy
      obtain ⟨j, w, hw⟩ := H y
      have e : w = υ' ^ (j + k) * x' :=
        hi' (by rw [hw, hy, hυυ', map_mul, map_pow, pow_add]; ring)
      rw [HQ y j w hw, e]
      constructor
      · intro h
        rcases hQ'.mem_or_mem h with h | h
        · exact absurd (hQ'.mem_of_pow_mem _ h) hυ'
        · exact h
      · intro h
        exact Q'.mul_mem_left _ h
    have hυ : υ ∉ Q := by
      intro h
      have h1 : i' υ' = i' υ' ^ 0 * i υ := by rw [pow_zero, one_mul, hυυ']
      exact hυ' ((HQ υ 0 υ' h1).mp h)
    have hne : ∀ d : C, d ∉ Q → i d ≠ 0 := by
      intro d hd h0
