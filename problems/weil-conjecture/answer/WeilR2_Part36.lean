      r₁ (wcpaDjLkImg W (γ ≫ ι₁) (r₁ ≫ uX) ζ') ≠ wcpaDjLkImg W (γ ≫ ι) uX y₀ ∧
      ∃ (V : ValuationSubring ((wcpaDjLkFib W (γ ≫ ι₁) (r₁ ≫ uX)).residueField ζ))
        (V' : ValuationSubring ((wcpaDjLkFib W (γ ≫ ι₁) (r₁ ≫ uX)).residueField ζ')),
        wcNsrEbDom (wcpaDjLkFib W (γ ≫ ι₁) (r₁ ≫ uX)) h V ∧
