  have hgood := hsepM Q hQ'
  obtain ⟨hδ0, 𝔠₀, 𝔠₁, h0p, h1p, h0Q, h1Q, h0m, h1m, hz0c0, hsc0, hsc1, hz0c1⟩ :=
