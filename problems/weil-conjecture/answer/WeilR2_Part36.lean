  have hsq : t ≫ ((γ ≫ ι').fromNormalization ≫ u') =
      (γ ≫ wcProjKStr Ω 1) ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) := by
    rw [← Category.assoc, ht_def, Scheme.Hom.toNormalization_fromNormalization, Category.assoc,
      hM.2.2.w]
    exact (Category.assoc _ _ _).symm
  have hconst : ∀ w : ↥W, (wcLr1uGerm t n hn₀).hom
